hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"12601","12567  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عُزَيْزٍ الْمَوْصِلِيُّ ،  ثَنَا  غَسَّانُ بْنُ الرَّبِيعِ ،  ثَنَا  ثَابِتُ بْنُ يَزِيدَ ،  عَنْ  عَاصِمٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قُمْتُ لَيْلَةً أُصَلِّي مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقُمْتُ عَنْ يَسَارِهِ  ، فَقَالَ بِيَدِهِ مِنْ وَرَائِهِ ، فَأَخَذَ  بِيَدِي ، أَوْ بِعَضُدِي  حَتَّى أَقَامَنِي عَنْ يَمِينِهِ  .","","Al-Mu'jam al-Kabir 12567","","عبد الله بن عباس عن الشعبي عن عاصم بن سليمان الأحول عن ثابت بن يزيد الأحول العطار عن غسان بن الربيع الأزدي عن عبد الله بن محمد بن عزيز التميمي عن الطبراني","الشعبي عن ابن عباس"
"12602","12568  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ، وَأَحْمَدُ بْنُ إِسْحَاقَ بْنِ وَاضِحٍ الْعَسَّالُ الْمِصْرِيَّانِ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الشَّعْبِيِّ قَالَ :  سَأَلْتُ  عَبْدَ اللهِ بْنَ عَبَّاسٍ ، وَعَبْدَ اللهِ بْنَ عُمَرَ  كَيْفَ كَانَ صَلَاةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِاللَّيْلِ  ؟ ، فَقَالَا : "" ثَلَاثَ عَشْرَةَ : ثَمَانٍ ، وَيُوتِرُ بِثَلَاثٍ ، وَرَكْعَتَيْنِ بَعْدَ الْفَجْرِ  .","","Al-Mu'jam al-Kabir 12568","","عبد الله بن عمر بن الخطاب عن الشعبي عن أبو إسحاق السبيعي عن موسى بن عقبة عن محمد بن جعفر بن أبي كثير الزرقي عن سعيد بن الحكم الجمحي عن أحمد بن إسحاق العسال عن الطبراني","الشعبي عن ابن عباس"
"12603","12569  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي قَوْلِهِ :         {      قُلْ لا أَسْأَلُكُمْ عَلَيْهِ أَجْرًا إِلا الْمَوَدَّةَ فِي الْقُرْبَى         }      قَالَ :  تَصِلُوا قَرَابَتِي وَلَا تُكَذِّبُونِي  "" .","","Al-Mu'jam al-Kabir 12569","","عبد الله بن عباس عن الشعبي عن داود بن أبي هند عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","الشعبي عن ابن عباس"
"12604","12570  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  جَابِرٍ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ ،         [12/92]      وَابْنِ عُمَرَ ، قَالَ :  سَنَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْوِتْرَ  ، وَرَكْعَتَيِ السَّفَرِ  .","","Al-Mu'jam al-Kabir 12570","","عبد الله بن عمر بن الخطاب عن الشعبي عن جابر الجعفي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","الشعبي عن ابن عباس"
"12605","12571  -  حَدَّثَنَا  عَلِيُّ بْنُ الْعَبَّاسِ الْبَجَلِيُّ الْكُوفِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُمَارَةَ بْنِ صُبَيْحٍ ،  ثَنَا  نَصْرُ بْنُ مُزَاحِمٍ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  قِيلَ :  يَا رَسُولَ اللهِ مَتَى كُتِبْتَ نَبِيًّا ؟ قَالَ : ""  وَآدَمُ  بَيْنَ الرُّوحِ وَالْجَسَدِ  .","","Al-Mu'jam al-Kabir 12571","","عبد الله بن عباس عن الشعبي عن جابر الجعفي عن قيس بن الربيع الأسدي عن نصر بن مزاحم العطار عن محمد بن عمارة الكوفي عن المقانعي علي بن العباس بن الوليد عن الطبراني","الشعبي عن ابن عباس"
"12606","12572  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ الْجُنْدَيْسَابُورِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحَسَنِ بْنِ شَقِيقٍ الْمَرْوَزِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَبُو حَمْزَةَ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  أُتِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِكَتِفِ شَاةٍ فِي الْمَسْجِدِ فَأَكَلَهَا  ، ثُمَّ قَامَ إِلَى الصَّلَاةِ ، وَلَمْ يَمَسَّ مَاءً  .","","Al-Mu'jam al-Kabir 12572","","عبد الله بن عباس عن الشعبي عن جابر الجعفي عن محمد بن ميمون أبو حمزة السكري عن علي بن الحسن بن شقيق عن محمد بن علي بن الحسن بن شقيق المطوعي عن محمد بن جابان الجند يسابوري عن الطبراني","الشعبي عن ابن عباس"
"12607","12573  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  سَالِمُ بْنُ نُوحٍ ،  ثَنَا  عُمَرُ بْنُ عَامِرٍ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  نَهَى أَنْ نَتَّخِذَ شَيْئًا فِيهِ الرُّوحُ غَرَضًا  .","","Al-Mu'jam al-Kabir 12573","","عبد الله بن عباس عن الشعبي عن جابر الجعفي عن عمر بن عامر الأحول عن سالم بن نوح العطار عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","الشعبي عن ابن عباس"
"12608","12574  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  خَلَّادُ بْنُ يَحْيَى (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى         [12/93]      اللهُ عَلَيْهِ وَسَلَّمَ "" يَشْرَبُ قَائِمًا مِنْ  زَمْزَمَ  ،  وَاللَّفْظُ لِحَدِيثِ  أَبِي نُعَيْمٍ  .","","Al-Mu'jam al-Kabir 12574","","عبد الله بن عباس عن الشعبي عن عاصم بن سليمان الأحول عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","الشعبي عن ابن عباس"
"12609","12575  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَاصِمٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  اسْتَسْقَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَقَيْنَاهُ مِنْ  زَمْزَمَ  ، فَشَرِبَ وَهُوَ قَائِمٌ  .","","Al-Mu'jam al-Kabir 12575","","عبد الله بن عباس عن الشعبي عن عاصم بن سليمان الأحول عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","الشعبي عن ابن عباس"
"12610","12576  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَاصِمٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  نَاوَلْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دَلْوًا مِنْ  زَمْزَمَ  فَشَرِبَ وَهُوَ قَائِمٌ  .","","Al-Mu'jam al-Kabir 12576","","عبد الله بن عباس عن الشعبي عن عاصم بن سليمان الأحول عن شريك بن عبد الله بن أبي نمر الكناني عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","الشعبي عن ابن عباس"
"12611","12577  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ،  ثَنَا  سُرَيْجُ بْنُ النُّعْمَانِ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" اسْتَسْقَى فَأُتِيَ بِدَلْوٍ مِنْ  زَمْزَمَ  فَشَرِبَ وَهُوَ قَائِمٌ  .","","Al-Mu'jam al-Kabir 12577","","عبد الله بن عباس عن الشعبي عن عاصم بن سليمان الأحول عن هشيم بن بشير عن سريج بن النعمان الجوهري عن لحية الليف محمد بن العباس عن الطبراني","الشعبي عن ابن عباس"
"12612","12578  -  حَدَّثَنَا  أَبُو عَرُوبَةَ الْحُصَيْنُ بْنُ مُحَمَّدٍ الْحَرَّانِيُّ ،  ثَنَا  هَاشِمُ بْنُ الْقَاسِمِ الْحَرَّانِيُّ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  صَاعِدِ بْنِ مُسْلِمٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  سَقَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ  زَمْزَمَ  فَشَرِبَ وَهُوَ قَائِمٌ  .","","Al-Mu'jam al-Kabir 12578","","عبد الله بن عباس عن الشعبي عن صاعد بن مسلم مولى الشعبي عن عيسى بن يونس بن أبي إسحاق عن هاشم بن القاسم بن شيبة الحراني عن الحسين بن محمد بن أبي معشر الجزري عن الطبراني","الشعبي عن ابن عباس"
"12613","12579  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  ابْنُ الْأَصْبَهَانِيِّ (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَعُبَيْدُ بْنُ غَنَّامٍ قَالَا :  ثَنَا  عَلِيُّ بْنُ حَكِيمٍ الْأَوْدِيُّ ، قَالَا :  ثَنَا  شَرِيكٌ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنِ  الشَّعْبِيِّ ،         [12/94]      عَنِ  ابْنِ عَبَّاسٍ قَالَ :  أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِدَلْوٍ مِنْ  زَمْزَمَ  فَشَرِبَ وَهُوَ قَائِمٌ  .","","Al-Mu'jam al-Kabir 12579","","عبد الله بن عباس عن الشعبي عن سليمان بن فيروز الشيباني عن شريك بن عبد الله النخعي عن علي بن حكيم بن ذبيان عن عبد الله بن أحمد بن حنبل عن الطبراني","الشعبي عن ابن عباس"
"12614","12580  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  سُلَيْمَانَ الشَّيْبَانِيِّ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" صَلَّى عَلَى جِنَازَةٍ بَعْدَ مَا دُفِنَتْ  .","","Al-Mu'jam al-Kabir 12580","","عبد الله بن عباس عن الشعبي عن سليمان بن فيروز الشيباني عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","الشعبي عن ابن عباس"
"12615","12581  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سُلَيْمَانَ الشَّيْبَانِيِّ ،  عَنِ  الشَّعْبِيِّ قَالَ :  أَخْبَرَنِي  مَنْ شَهِدَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَتَى عَلَى قَبْرٍ  مَنْبُوذٍ  فَصَفَّهُمْ وَكَبَّرَ أَرْبَعًا  قَالَ  سُلَيْمَانُ  : قُلْتُ  لِلشَّعْبِيِّ  : يَا  أَبَا عَمْرٍو  مَنْ حَدَّثَكَ بِهَذَا ؟ قَالَ : ابْنُ عَبَّاسٍ .","","Al-Mu'jam al-Kabir 12581","","عبد الله بن عباس عن الشعبي عن سليمان بن فيروز الشيباني عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","الشعبي عن ابن عباس"
"12616","12582  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  أَبُو إِسْحَاقَ الشَّيْبَانِيُّ ،  عَنْ  عَامِرٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  أَتَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَبْرًا  ، فَقَالَ : "" مَا هَذَا ؟ "" فَقَالُوا :  دُفِنَ أَوْ دُفِنَتِ  الْبَارِحَةَ ، قَالَ  ابْنُ عَبَّاسٍ  : "" فَصَفَّنَا خَلْفَهُ ، ثُمَّ صَلَّى عَلَيْهَا  .","","Al-Mu'jam al-Kabir 12582","","عبد الله بن عباس عن الشعبي عن سليمان بن فيروز الشيباني عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","الشعبي عن ابن عباس"
"12617","12583  -  حَدَّثَنَا  أَحْمَدُ بْنُ زِيَادِ بْنِ زَكَرِيَّا الْإِيَادِيُّ ،  ثَنَا  يَزِيدُ         [12/95]      بْنُ قَيْسٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  حَدَّثَنِي  جَعْفَرُ بْنُ الْحَارِثِ ،  عَنْ  أَبِي إِسْحَاقَ الشَّيْبَانِيِّ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  أَتَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَبْرًا ، فَقَالَ : "" مَا هَذَا  ؟ "" فَقَالُوا : دُفِنَ الْبَارِحَةَ ، قَالَ  ابْنُ عَبَّاسٍ  : "" فَصَفَفْنَا خَلْفَهُ ، ثُمَّ صَلَّى عَلَيْهِ  .","","Al-Mu'jam al-Kabir 12583","","عبد الله بن عباس عن الشعبي عن سليمان بن فيروز الشيباني عن جعفر بن الحارث الواسطي عن إسماعيل بن عياش الأحول عن يزيد بن قبيس السيلحيني عن أحمد بن زياد الإيادي عن الطبراني","الشعبي عن ابن عباس"
"12618","12584  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  الْأَخْدَعَيْنِ  ، وَأَعْطَى  الْحَجَّامَ  أَجْرَهُ ، وَلَوْ كَانَ حَرَامًا لَمْ يُعْطِهِ  .","","Al-Mu'jam al-Kabir 12584","","عبد الله بن عباس عن الشعبي عن جابر الجعفي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","الشعبي عن ابن عباس"
"12619","12585  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعَثَ إِلَى  أَبِي طَيْبَةَ  فَحَجَمَهُ  وَوَضَعَ عَنْهُ مِنْ خَرَاجِهِ نِصْفَ صَاعٍ ، أَوْ أَكْثَرَ  .","","Al-Mu'jam al-Kabir 12585","","عبد الله بن عباس عن الشعبي عن جابر الجعفي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن أبو مسلم الكجي عن الطبراني","الشعبي عن ابن عباس"
"12620","12586  -  حَدَّثَنَا  أَبُو حَصِينٍ مُحَمَّدُ بْنُ الْحُسَيْنِ الْقَاضِي ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  زُهَيْرٌ ،  عَنْ  جَابِرٍ ،  عَنْ  عَامِرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَحْتَجِمُ ثَلَاثًا فِي  الْأَخْدَعَيْنِ  ، وَبَيْنَ الْكَتِفَيْنِ يَحْجُمُهُ غُلَامٌ لَهُ مِنْ  بَيَاضَةَ  يُقَالُ لَهُ  أَبُو هِنْدٍ  ، وَكَانَ يُؤَدِّي إِلَى أَهْلِهِ كُلَّ يَوْمٍ مُدًّا وَنِصْفًا ، فَشَفَعَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَوَضَعُوا عَنْهُ نِصْفَ مُدٍّ وَكَانَ رَسُولُ         [12/96]      اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعْدُ يُعْطِي الْحَجَّامَ أَجْرَهُ ، وَلَوْ كَانَ حَرَامًا لَمْ يُعْطِهِ  .","","Al-Mu'jam al-Kabir 12586","","عبد الله بن عباس عن الشعبي عن جابر الجعفي عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","الشعبي عن ابن عباس"
"12621","12587  -  حَدَّثَنَا  إِدْرِيسُ بْنُ عَبْدِ الْكَرِيمِ الْحَدَّادُ ،  ثَنَا  خَلَفُ بْنُ هِشَامٍ الْبَزَّارُ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ احْتَجَمَ فِي  الْأَخْدَعَيْنِ  ، وَالْكَاهِلِ  .","","Al-Mu'jam al-Kabir 12587","","عبد الله بن عباس عن الشعبي عن جابر الجعفي عن الوضاح بن عبد الله اليشكري عن خلف بن هشام البزار عن إدريس بن عبد الكريم البغدادي عن الطبراني","الشعبي عن ابن عباس"
"12622","12588  -  حَدَّثَنَا  طَالِبُ بْنُ قُرَّةَ الْأَذَنِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ،  ثَنَا  شَرِيكٌ ، وَأَبُو عَوَانَةَ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَحْتَجِمُ فِي  الْأَخْدَعَيْنِ  ، وَالْكَاهِلِ  .","","Al-Mu'jam al-Kabir 12588","","عبد الله بن عباس عن الشعبي عن جابر الجعفي عن الوضاح بن عبد الله اليشكري عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن طالب بن قرة الأذني عن الطبراني","الشعبي عن ابن عباس"
"12623","12589  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  مَخْلَدُ بْنُ خَالِدٍ الشَّعِيرِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ خَلَفٍ [  ثَنَا  ]  رَبَاحُ بْنُ زَيْدٍ ،  عَنْ  مَعْمَرٍ ،  عَنْ  عَاصِمٍ عَنْ سُلَيْمَانَ  ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، حَجَمَهُ  مَوْلًى لِبَنِي بَيَاضَةَ  ، وَأَعْطَاهُ أَجْرَهُ ، وَلَوْ كَانَ حَرَامًا لَمْ يُعْطِهِ إِيَّاهُ  .  سقط من طبعة مكتبة ابن تيمية والمثبت من النسخ الخطية .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عاصم بن سليمان )","","Al-Mu'jam al-Kabir 12589","","عبد الله بن عباس عن الشعبي عن عاصم بن سليمان الأحول عن معمر بن راشد عن رباح بن زيد الصنعاني عن إبراهيم بن خالد الصنعاني عن مخلد بن خالد بن يزيد الشعيري عن محمد بن عبدوس السراج عن الطبراني","الشعبي عن ابن عباس"
"12624","[  سُمَيْعٌ الزَّيَّاتُ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12590  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  سُمَيْعٍ الزَّيَّاتِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قُمْتُ إِلَى جَنْبِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى شِمَالِهِ فَأَدَارَنِي فَجَعَلَنِي عَنْ يَمِينِهِ  .","","Al-Mu'jam al-Kabir 12590","","عبد الله بن عباس عن سميع الزيات الحنفي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سميع الزيات عن ابن عباس"
"12625","[12/97]      [  حُصَيْنٌ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12591  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  خَالِدُ بْنُ طَهْمَانَ أَبُو الْعَلَاءِ الْخَفَّافُ ،  عَنْ  حُصَيْنٍ قَالَ :  سَأَلَ  سَائِلٌ  وَابْنُ عَبَّاسٍ فِي الصَّلَاةِ ، فَقَالَ لَهُ  ابْنُ عَبَّاسٍ  : يَا سَائِلُ ، قَالَ : لَبَّيْكَ . قَالَ : تَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ؟ قَالَ : نَعَمْ . قَالَ : وَتُصَلِّي الْخَمْسَ ؟ قَالَ : نَعَمْ . قَالَ : وَتَصُومُ رَمَضَانَ ؟ قَالَ : نَعَمْ . قَالَ : حَقٌّ عَلَيْنَا أَنْ نَصِلَكَ ، فَنَزَعَ ثَوْبًا عَلَيْهِ فَكَسَاهُ إِيَّاهُ ، ثُمَّ قَالَ عِنْدَ ذَلِكَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  أَيُّمَا مُسْلِمٍ كَسَا مُسْلِمًا ثَوْبًا كَانَ فِي حِفْظِ اللهِ مَا بَقِيَتْ عَلَيْهِ مِنْهُ رُقْعَةٌ  .","","Al-Mu'jam al-Kabir 12591","","عبد الله بن عباس عن حصين بن مالك الجعفي عن خالد بن طهمان السلولي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حصين عن ابن عباس"
"12626","12592  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَوْفٍ الْحِمْصِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  كَامِلٍ أَبِي الْعَلَاءِ ،  عَنْ  حُصَيْنٍ ،  عَنِ  ابْنِ عَبَّاسٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ  .","","Al-Mu'jam al-Kabir 12592","","عبد الله بن عباس عن حصين بن مالك الجعفي عن كامل بن العلاء التميمي عن سفيان الثوري عن محمد بن يوسف الفريابي عن محمد بن عوف بن سفيان عن عبد الله بن أحمد بن حنبل عن الطبراني","حصين عن ابن عباس"
"12627","[  عَمْرُو بْنُ مَيْمُونٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12593  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  كَثِيرُ بْنُ يَحْيَى ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بَلْجٍ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ قَالَ :  كُنَّا         [12/98]      عِنْدَ ابْنِ عَبَّاسٍ ، فَجَاءَهُ سَبْعَةُ نَفَرٍ وَهُوَ يَوْمَئِذٍ صَحِيحٌ ، قَبْلَ أَنْ يَعْمَى ، فَقَالُوا : يَا ابْنَ عَبَّاسٍ  قُمْ مَعَنَا أَوْ قَالَ : اخْلُوا يَا هَؤُلَاءِ  .  قَالَ  : بَلْ أَقُومُ مَعَكُمْ ، فَقَامَ مَعَهُمْ فَمَا نَدْرِي مَا قَالُوا ، فَرَجَعَ يَنْفُضُ ثَوْبَهُ ، وَيَقُولُ :  أُفٍّ  أُفٍّ  ، وَقَعُوا فِي رَجُلٍ قِيلَ فِيهِ مَا أَقُولُ لَكُمُ الْآنَ ، وَقَعُوا فِي  عَلِيِّ بْنِ أَبِي طَالِبٍ  ، وَقَدْ قَالَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَأَبْعَثَنَّ رَجُلًا لَا يُخْزِيهِ اللهُ  فَبَعَثَ إِلَى  عَلِيٍّ  وَهُوَ فِي الرَّحَى يَطْحَنُ ، وَمَا كَانَ أَحَدُكُمْ لِيَطْحَنَ ، فَجَاءُوا بِهِ أَرْمَدَ ، فَقَالَ : يَا نَبِيَّ اللهِ مَا أَكَادُ أُبْصِرُ ، فَنَفَثَ فِي عَيْنَيْهِ وَهَزَّ  الرَّايَةَ  ثَلَاثَ مَرَّاتٍ ، ثُمَّ دَفَعَهَا إِلَيْهِ فَفُتِحَ لَهُ ، فَجَاءَ  بِصَفِيَّةَ بِنْتِ حُيَيٍّ  ، ثُمَّ قَالَ لِبَنِي عَمِّهِ : أَيُّكُمْ يَتَوَلَّانِي فِي الدُّنْيَا وَالْآخِرَةِ ثَلَاثًا حَتَّى مَرَّ عَلَى آخِرِهِمْ ، فَقَالَ  عَلِيٌّ  : يَا نَبِيَّ اللهِ أَنَا وَلِيُّكَ فِي الدُّنْيَا وَفِي الْآخِرَةِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَنْتَ وَلِيِّي فِي الدُّنْيَا وَالْآخِرَةِ "" قَالَ : وَبَعَثَ  أَبَا بَكْرٍ  بِسُورَةِ التَّوْبَةِ ، وَبَعَثَ  عَلِيًّا  عَلَى أَثَرِهِ ، فَقَالَ  أَبُو بَكْرٍ  : يَا  عَلِيُّ  لَعَلَّ اللهَ وَنَبِيَّهُ سَخِطَا عَلَيَّ ، فَقَالَ  عَلِيٌّ  : لَا ، وَلَكِنَّ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : "" لَا يَنْبَغِي أَنْ يُبَلِّغَ عَنِّي إِلَّا رَجُلٌ مِنِّي ، وَأَنَا مِنْهُ "" قَالَ : وَوَضَعَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَوْبَهُ عَلَى  عَلِيٍّ  وَفَاطِمَةَ  ،  وَالْحَسَنِ  ،  وَالْحُسَيْنِ  ، وَقَالَ :         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      ، وَكَانَ أَوَّلَ مَنْ أَسْلَمَ بَعْدَ  خَدِيجَةَ  مِنَ النَّاسِ ، قَالَ وَشَرَى  عَلِيٌّ  نَفْسَهُ ، لَبِسَ ثَوْبَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ قَامَ مَكَانَهُ ، قَالَ وَكَانَ الْمُشْرِكُونَ يَرْمُونَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَاءَ  أَبُو بَكْرٍ  ، فَقَالَ : إِلَيَّ يَا رَسُولَ اللهِ ،  وَأَبُو بَكْرٍ  يَحْسَبُهُ نَبِيَّ اللهِ ، فَقَالَ  عَلِيٌّ  : إِنَّ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدِ انْطَلَقَ نَحْوَ  بِئْرِ مَيْمُونٍ  فَأَدْرِكْهُ ، فَانْطَلَقَ  أَبُو بَكْرٍ  فَدَخَلَ مَعَهُ الْغَارَ ، وَجَعَلَ  عَلِيٌّ  يَرْمِي بِالْحِجَارَةِ         [12/99]      كَمَا كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَرْمِي وَهُوَ يَتَضَوَّرُ قَدْ لَفَّ رَأْسَهُ فِي الثَّوْبِ لَا يُخْرِجُهُ حَتَّى أَصْبَحَ ، ثُمَّ كَشَفَ عَنْ رَأْسِهِ حِينَ أَصْبَحَ ، فَقَالُوا : إِنَّكَ لَلَئِيمٌ كَانَ صَاحِبُكَ نَرْمِيهِ بِالْحِجَارَةِ ، فَلَا يَتَضَوَّرُ ، وَأَنْتَ تَضَوَّرُ ، وَقَدِ اسْتَنْكَرْنَا ذَلِكَ . قَالَ : ثُمَّ خَرَجَ بِالنَّاسِ فِي  غَزَاةِ تَبُوكَ  ، فَقَالَ لَهُ  عَلِيٌّ  أَخْرُجُ مَعَكَ ؟ فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَا "" فَبَكَى  عَلِيٌّ  ، فَقَالَ لَهُ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَمَا تَرْضَى أَنْ تَكُونَ مِنِّي بِمَنْزِلَةِ  هَارُونَ  مِنْ  مُوسَى  إِلَّا أَنَّكَ لَسْتَ بِنَبِيٍّ  . إِنَّهُ لَا يَنْبَغِي أَنْ أَذْهَبَ إِلَّا وَأَنْتَ خَلِيفَتِي "" قَالَ : وَقَالَ لَهُ : "" أَنْتَ وَلِيُّ كُلِّ مُؤْمِنٍ بَعْدِي "" قَالَ : وَسَدَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَبْوَابَ الْمَسْجِدِ غَيْرَ بَابِ  عَلِيٍّ  ، فَيَدْخُلُ الْمَسْجِدَ  جُنُبًا  وَهُوَ طَرِيقُهُ لَيْسَ لَهُ طَرِيقٌ غَيْرُهُ ، قَالَ وَقَالَ :  مَنْ كُنْتُ  مَوْلَاهُ  فَعَلِيٌّ  مَوْلَاهُ  ، قَالَ  ابْنُ عَبَّاسٍ  : فَأَخْبَرَنَا اللهُ فِي الْقُرْآنِ أَنَّهُ قَدْ رَضِيَ عَنْهُمْ عَنْ أَصْحَابِ الشَّجَرَةِ يَعْلَمُ مَا فِي قُلُوبِهِمْ ، فَهَلْ حَدَّثَنَا أَنَّهُ  سَخِطَ  عَلَيْهِمْ بَعْدَهُ ؟ وَقَالَ : إِنَّ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِعُمَرَ  حِينَ قَالَ : أَتَأْذَنُ لِي فَأَضْرِبَ عُنُقَهُ يَعْنِي  حَاطِبًا  ، فَقَالَ :  أَفَكُنْتَ فَاعِلًا ؟ وَمَا يُدْرِيكَ لَعَلَّ اللهَ اطَّلَعَ عَلَى  أَهْلِ بَدْرٍ  ،  فَقَالَ : اعْمَلُوا مَا شِئْتُمْ ؟ "" .","","Al-Mu'jam al-Kabir 12593","","عبد الله بن عباس عن عمرو بن ميمون الأودي عن أبو بلج يحيى بن سليم الفزاري عن الوضاح بن عبد الله اليشكري عن كثير بن يحيى بن كثير الشيعي عن إبراهيم بن هاشم البغوي عن الطبراني","عمرو بن ميمون عن ابن عباس"
"12628","12594  -  حَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ ،  ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  مِسْكِينُ بْنُ بُكَيْرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي بَلْجٍ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَمَرَ بِالْأَبْوَابِ كُلِّهَا فَسُدَّتْ  إِلَّا بَابَ  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  .  سقط من طبعة مكتبة ابن تيمية ، والمثبت من النسخ الخطية .","","Al-Mu'jam al-Kabir 12594","","عبد الله بن عباس عن عمرو بن ميمون الأودي عن أبو بلج يحيى بن سليم الفزاري عن شعبة بن الحجاج عن مسكين بن بكير الحراني عن عبد الله بن محمد النفيلي عن أبو شعيب الحراني عن الطبراني","عمرو بن ميمون عن ابن عباس"
"12629","[12/100]      [  سَالِمُ بْنُ أَبِي الْجَعْدِ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12595  -  حَدَّثَنَا  خَلَفُ بْنُ عَمْرٍو الْعُكْبَرِيُّ ، وَمُحَمَّدُ بْنُ يُوسُفَ التُّرْكِيُّ ، قَالَا :  ثَنَا  عُبَيْدُ اللهِ بْنُ عَائِشَةَ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  ثَنَا  الْأَعْمَشُ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  جَاءَ  رَجُلٌ مِنْ بَنِي عَامِرٍ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَكَانَ يُدَاوِي ،  وَيُعَالِجُ  ، فَقَالَ : يَا  مُحَمَّدُ  إِنَّكَ تَقُولُ أَشْيَاءَ فَهَلْ لَكَ أَنْ أُدَاوِيَكَ ؟ قَالَ : فَدَعَاهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى اللهِ عَزَّ وَجَلَّ ثُمَّ قَالَ :  هَلْ لَكَ أَنْ أُرِيَكَ آيَةً  ؟ "" وَعِنْدَهُ نَخْلٌ وَشَجَرَةٌ ، فَدَعَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عِذْقًا  مِنْهَا فَأَقْبَلَ إِلَيْهِ ، وَهُوَ يَسْجُدُ وَيَرْفَعُ رَأْسَهُ حَتَّى انْتَهَى إِلَيْهِ ، فَقَامَ بَيْنَ يَدَيْهِ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" ارْجِعْ إِلَى مَكَانِكَ "" ، فَرَجَعَ إِلَى مَكَانِهِ ، قَالَ الْعَامِرِيُّ : وَاللهِ لَا أُكَذِّبُكَ بِقَوْلٍ أَبَدًا ، ثُمَّ قَالَ : يَا  آلَ بَنِي صَعْصَعَةَ  وَاللهِ لَا أُكَذِّبُهُ بِشَيْءٍ يَقُولُهُ أَبَدًا  .","","Al-Mu'jam al-Kabir 12595","","عبد الله بن عباس عن سالم بن أبي الجعد الغطفاني عن الأعمش عن عبد الواحد بن زياد عن ابن عائشة عن ابن التركي محمد بن يوسف عن الطبراني","سالم بن أبي الجعد عن ابن عباس"
"12630","12596  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَرَجِ الْأَصْبَهَانِيُّ قَالَ :  وَجَدْتُ  فِي كِتَابِي ، عَنْ  إِسْمَاعِيلَ بْنِ عَمْرٍو الْبَجَلِيِّ ،  عَنِ  الصَّبَّاحِ بْنِ يَحْيَى الْمُزَنِيِّ ،  عَنْ  عَمَّارٍ الدُّهْنِيِّ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  بَيْنَمَا نَحْنُ نُغَسِّلُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَاءَ  رَجُلٌ  فَدَقَّ الْبَابَ ، فَقَالَ :  أُذَكِّرُكُمُ اللهَ إِلَّا أَعْطَيْتُمُونِي الْيَوْمَ نَصِيبًا مِنْ         [12/101]      رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، فَقَالَ  عَلِيٌّ  : أَدْخِلُوهُ ، وَاجْعَلُوهُ مِنْ وَرَاءِ السِّتْرِ يُنَاوِلُنَا الْمَاءَ ، فَأَدْخَلْنَاهُ ، فَكَانَ يُنَاوِلُنَا الْمَاءَ ، وَقَالَ  عَلِيٌّ  : وَاللهِ مَا كُنْتُ أُقَلِّبُهُ إِلَّا كَانَ مَعِي  آخَرُ  يُقَلِّبُهُ . قَالَ : وَسَمِعْتُ فِي الْبَيْتِ لَا تَنْزِعُوا عَنْهُ الْقَمِيصَ  .","","Al-Mu'jam al-Kabir 12596","","عبد الله بن عباس عن سالم بن أبي الجعد الغطفاني عن عمار بن معاوية الدهني عن صباح بن يحيى المزني عن إسماعيل بن عمرو البجلي عن محمد بن الفرج الأصبهاني عن الطبراني","سالم بن أبي الجعد عن ابن عباس"
"12631","12597  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَرْوَزِيُّ ،  ثَنَا  مُطَهَّرُ بْنُ الْحَكَمِ الْمَرْوَزِيُّ ،  ثَنَا  عَلِيُّ بْنُ الْحُسَيْنِ بْنِ وَاقِدٍ ،  عَنْ  أَبِيهِ  قَالَ :  أَخْبَرَنِي  لَيْثُ بْنُ أَبِي سُلَيْمٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ قَالَ :  كُنْتُ جَالِسًا عِنْدَ عَبْدِ اللهِ بْنِ عَبَّاسٍ إِذْ جَاءَهُ  رَجُلٌ  ، فَقَالَ : أَرَأَيْتَ مَنْ قَتَلَ مُؤْمِنًا مُتَعَمِّدًا ثُمَّ تَابَ وَآمَنَ وَعَمِلَ عَمَلًا صَالِحًا ثُمَّ اهْتَدَى ، قَالَ : وَأَنَّى لَهُ التَّوْبَةُ ، وَقَدْ سَمِعْتُ نَبِيَّكُمْ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ أَقْرَبَ الْخَلَائِقِ مِنْ عَرْشِ الرَّحْمَنِ يَوْمَ الْقِيَامَةِ الْمُؤْمِنُ الَّذِي قُتِلَ مَظْلُومًا  : رَأْسُهُ عَنْ يَمِينِهِ ، وَقَاتِلُهُ عَنْ شِمَالِهِ ،  وَأَوْدَاجُهُ  يَشْخَبُ  يَقُولُ : رَبِّ سَلْ هَذَا فِيمَ قَتَلَنِي ؟ فِيمَ حَالَ بَيْنِي وَبَيْنَ الصَّلَاةِ ؟  .","","Al-Mu'jam al-Kabir 12597","","عبد الله بن عباس عن سالم بن أبي الجعد الغطفاني عن ليث بن أبي سليم عن الحسين بن واقد المروزي عن علي بن الحسين بن واقد عن مطهر بن الحكم الأنقلقاني عن محمد بن علي بن محمد المروزي عن الطبراني","سالم بن أبي الجعد عن ابن عباس"
"12632","[  قَيْسُ بْنُ حَبْتَرٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12598  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  عَلِيِّ بْنِ بَذِيمَةَ ،  عَنْ  قَيْسِ بْنِ حَبْتَرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّهُ سُئِلَ عَنِ  الْجَرِّ  ، فَقَالَ : إِنَّ أَوَّلَ مَنْ سَأَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ النَّبِيذِ  عَبْدُ الْقَيْسِ  أَتَوْهُ فَقَالُوا  : يَا رَسُولَ اللهِ ، إِنَّا بِأَرْضٍ  رِيفٍ  ، وَإِنَّا نُصِيبُ مِنَ الْبَقْلِ فَأْمُرْنَا بِشَرَابٍ ، فَقَالَ :         [12/102]      انْتَبِذُوا فِي الْأَسْقِيَةِ ، وَلَا تَنْبِذُوا فِي  الْجَرِّ  ، وَلَا  الدُّبَّاءِ  وَلَا  الْمُزَفَّتِ  وَلَا  النَّقِيرِ  ، فَإِنِّي نُهِيتُ عَنِ الْخَمْرِ ، وَالْمَيْسِرِ ،  وَالْكُوبَةِ  -  وَهِيَ الطَّبْلُ  - وَكُلُّ مُسْكِرٍ حَرَامٌ "" قَالُوا : يَا رَسُولَ اللهِ ، فَإِذَا اشْتَدَّ ، قَالَ : "" صُبُّوا عَلَيْهِ الْمَاءَ "" ، قَالُوا : يَا رَسُولَ اللهِ ، فَإِذَا اشْتَدَّ ، قَالَ : "" صُبُّوا عَلَيْهِ الْمَاءَ "" ، قَالَ فِي  الثَّالِثَةِ أَوْ فِي الرَّابِعَةِ  : "" فَإِذَا اشْتَدَّ فَأَهْرِقُوهُ  .  تصحفت في طبعة مكتبة ابن تيمية إلى ( فقال ) وهي على الصواب في النسخ الخطية.","","Al-Mu'jam al-Kabir 12598","","عبد الله بن عباس عن قيس بن حبتر التميمي عن علي بن بذيمة السوائي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن عثمان بن حفص الضبي عن الطبراني","قيس بن حبتر عن ابن عباس"
"12633","12599  -  حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  عَلِيِّ بْنِ بَذِيمَةَ ،  عَنْ  قَيْسِ بْنِ حَبْتَرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ،  مِثْلَ حَدِيثِ  إِسْرَائِيلَ  .","","Al-Mu'jam al-Kabir 12599","","عبد الله بن عباس عن قيس بن حبتر التميمي عن علي بن بذيمة السوائي عن قيس بن الربيع الأسدي عن أبو بلال الأشعري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","قيس بن حبتر عن ابن عباس"
"12634","12600  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  عَلِيِّ بْنِ بَذِيمَةَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنْ  قَيْسِ بْنِ حَبْتَرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ مُسْكِرٍ حَرَامٌ  .","","Al-Mu'jam al-Kabir 12600","","عبد الله بن عباس عن قيس بن حبتر التميمي عن سعيد بن جبير الأسدي عن علي بن بذيمة السوائي عن موسى بن أعين الجزري عن علي بن معبد العبدي عن يوسف بن يزيد القراطيسي عن الطبراني","قيس بن حبتر عن ابن عباس"
"12635","12601  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ ،  ثَنَا  سَعِيدُ بْنُ حَفْصٍ النُّفَيْلِيُّ ، قَالَ :  قَرَأْنَا عَلَى  عُبَيْدِ اللهِ بْنِ مَعْقِلٍ  ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  قَيْسِ بْنِ حَبْتَرٍ الرَّبَعِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ثَمَنُ الْخَمْرِ حَرَامٌ  ، وَمَهْرُ  الْبَغِيِّ  حَرَامٌ ، وَثَمَنُ الْكَلْبِ حَرَامٌ ،  وَالْكُوبَةُ  حَرَامٌ ، وَإِنْ أَتَاكَ صَاحِبُ الْكَلْبِ فَامْلَأْ يَدَيْهِ  تُرَابًا  ، وَالْخَمْرُ وَالْمَيْسِرُ وَكُلُّ مُسْكِرٍ حَرَامٌ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب (معقل بن عبيد الله) .","","Al-Mu'jam al-Kabir 12601","","عبد الله بن عباس عن قيس بن حبتر التميمي عن عبد الكريم الاصطخري عن معقل بن عبيد الله الجزري عن سعيد بن حفص بن عمر الهذلي عن أحمد بن النضر بن بحر العسكري عن الطبراني","قيس بن حبتر عن ابن عباس"
"12636","[12/103]      [  زِرٌّ  عَنِ  ابْنِ عَبَّاسٍ  ]  12602  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  ثَنَا  سُفْيَانُ بْنُ بِشْرٍ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ قَالَ :  قَالَ لِي  ابْنُ عَبَّاسٍ :  أَيُّ الْقِرَاءَتَيْنِ تَقْرَأُ ؟ قُلْتُ : الْآخِرَةَ  قَالَ : "" فَإِنَّ  جِبْرِيلَ  عَلَيْهِ السَّلَامُ ، كَانَ يَعْرِضُ الْقُرْآنَ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كُلَّ عَامٍ فِي رَمَضَانَ . قَالَ : فَعَرَضَ عَلَيْهِ الْقُرْآنَ فِي الْعَامِ الَّذِي قُبِضَ فِيهِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّتَيْنِ "" ، فَشَهِدَ  عَبْدُ اللهِ  مَا نُسِخَ مِنْهُ ، وَمَا بُدِّلَ ، فَقَرَأَهُ  عَبْدُ اللهِ  الْآخِرَةَ  .","","Al-Mu'jam al-Kabir 12602","","عبد الله بن عباس عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن شريك بن عبد الله النخعي عن سفيان بن بشر عن روح بن الفرج القطان عن الطبراني","زر عن ابن عباس"
"12637","12603  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ أَبِي عَبَّادٍ الْمَكِّيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنِ  ابْنِ عَبَّاسٍ  فِي قَوْلِهِ :         {      فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَى         }      قَالَ :  الْقَابُ  : الْقَيْدُ ، وَالْقَوْسَيْنِ : الذِّرَاعَيْنِ  "" .","","Al-Mu'jam al-Kabir 12603","","عبد الله بن عباس عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن إبراهيم بن طهمان عن يعقوب بن إسحاق القلزمي عن يوسف بن يزيد القراطيسي عن الطبراني","زر عن ابن عباس"
"12638","[  عَبَايَةُ بْنُ رِبْعِيٍّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12604  -  حَدَّثَنَا  الْحَضْرَمِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ         [12/104]      عَبَايَةَ بْنِ رِبْعِيٍّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ قَسَمَ الْخَلَائِقَ قِسْمَيْنِ ، فَجَعَلَنِي فِي خَيْرِهِمَا قِسْمًا أَصْحَابِ الْيَمِينِ  ، وَأَنَا خَيْرُ أَصْحَابِ الْيَمِينِ ، ثُمَّ جَعَلَ الْقِسْمَيْنِ بُيُوتًا ، فَجَعَلَنِي فِي خَيْرِهِمَا بَيْتًا ، فَذَلِكَ قَوْلُهُ :         {      فَأَصْحَابُ الْمَيْمَنَةِ مَا أَصْحَابُ الْمَيْمَنَةِ             *          وَأَصْحَابُ الْمَشْأَمَةِ مَا أَصْحَابُ الْمَشْأَمَةِ             *          وَالسَّابِقُونَ السَّابِقُونَ         }      ، فَأَنَا مِنْ خَيْرِ السَّابِقِينَ ، ثُمَّ جَعَلَ الْبَيْتَ قَبَائِلَ ، فَجَعَلَنِي فِي خَيْرِهَا قَبِيلَةً ، فَذَلِكَ قَوْلُهُ :         {      شُعُوبًا وَقَبَائِلَ         }      الْآيَةَ ، فَأَنَا أَتْقَى وَلَدِ آدَمَ ، وَأَكْرَمُهُمْ عَلَى اللهِ وَلَا  فَخْرَ ،  ثُمَّ جَعَلَ الْقَبَائِلَ بُيُوتًا ، فَجَعَلَنِي فِي خَيْرِهَا بَيْتًا "" ، فَذَلِكَ قَوْلُهُ :         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      .","","Al-Mu'jam al-Kabir 12604","","عبد الله بن عباس عن عباية بن ربعي الأسدي عن الأعمش عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عباية بن ربعي عن ابن عباس"
"12639","[  سَعِيدٌ الْقُرَشِيُّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12605  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ سَعِيدِ بْنُ  عَمْرِو بْنِ سَعِيدٍ الْقُرَشِيِّ ،  حَدَّثَنِي  أَبِي ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَجُلٌ  ، فَقَالَ : مَا عَمَلٌ إِنْ عَمِلْتُ بِهِ دَخَلْتُ الْجَنَّةَ ؟ قَالَ :  أَنْتَ بِبَلَدٍ يُجْلَبُ بِهِ الْمَاءُ  ؟ "" قَالَ : نَعَمْ . قَالَ : "" فَاشْتَرِ بِهَا سِقَاءً جَدِيدًا ثُمَّ اسْتَقِ فِيهَا حَتَّى تَخْرِقَهَا ، فَإِنَّكَ لَنْ تَخْرِقَهَا حَتَّى تَبْلُغَ بِهَا عَمَلَ الْجَنَّةِ  .  في طبعة مكتبة ابن تيمية : (عن) والمثبت من نسخة الظاهرية (1) .","","Al-Mu'jam al-Kabir 12605","","عبد الله بن عباس عن سعيد بن عمرو بن سعيد بن العاص العذري عن إسحاق بن سعيد بن عمرو السعيدي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","سعيد القرشي عن ابن عباس"
"12640","[12/105]      [  زَاذَانُ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12606  -  حَدَّثَنَا  طَالِبُ بْنُ قُرَّةَ الْأَذَنِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ (  ح  ) .  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ أَحْمَدَ الْوَكِيعِيُّ ،  ثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ، قَالَا :  ثَنَا  عِيسَى بْنُ سَوَادَةَ أَبُو الصَّبَّاحِ النَّخَعِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  زَاذَانَ قَالَ :  مَرِضَ ابْنُ عَبَّاسٍ مَرْضَةً ثَقُلَ مِنْهَا ، فَجَمَعَ إِلَيْهِ بَنِيهِ وَأَهْلَهُ ، فَقَالَ لَهُمْ : إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ حَجَّ مِنْ  مَكَّةَ  مَاشِيًا حَتَّى يَرْجِعَ إِلَيْهَا فَلَهُ بِكُلِّ خُطْوَةٍ سَبْعُمِائَةِ حَسَنَةٍ مِنْ حَسَنَاتِ الْحَرَمِ  ، فَقَالَ بَعْضُهُمْ : وَمَا حَسَنَاتُ  الْحَرَمِ  ؟ قَالَ : "" كُلُّ حَسَنَةٍ بِهَا أَلْفُ حَسَنَةٍ  .","","Al-Mu'jam al-Kabir 12606","","عبد الله بن عباس عن زاذان الكندي عن إسماعيل بن أبي خالد عن عيسى بن سوادة النخعي عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن طالب بن قرة الأذني عن الطبراني","زاذان عن ابن عباس"
"12641","[  أَبُو مَالِكٍ الْغِفَارِيُّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12607  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حَاتِمٍ الزِّمِّيُّ ،  ثَنَا  الْقَاسِمُ بْنُ مَالِكٍ الْمُزَنِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ سُمَيْعٍ الْحَنَفِيِّ ،  عَنْ  أَبِي مَالِكٍ الْغِفَارِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  نَزَلَتْ هَذِهِ الْآيَةُ         {      وَلا تَنْكِحُوا الْمُشْرِكَاتِ حَتَّى يُؤْمِنَّ         }      ، فَحَجَزَ النَّاسُ عَنْهُنَّ  حَتَّى نَزَلَتِ الَّتِي بَعْدَهَا         {      الْيَوْمَ أُحِلَّ لَكُمُ الطَّيِّبَاتُ وَطَعَامُ الَّذِينَ أُوتُوا الْكِتَابَ حِلٌّ لَكُمْ وَطَعَامُكُمْ حِلٌّ لَهُمْ وَالْمُحْصَنَاتُ مِنَ الْمُؤْمِنَاتِ وَالْمُحْصَنَاتُ مِنَ الَّذِينَ أُوتُوا الْكِتَابَ         }      فَنَكَحَ النَّاسُ نِسَاءَ أَهْلِ الْكِتَابِ  . ""","","Al-Mu'jam al-Kabir 12607","","عبد الله بن عباس عن غزوان الغفاري عن إسماعيل بن سميع عن القاسم بن مالك المزني عن محمد بن حاتم الخراساني عن عبيد العجل عن الطبراني","أبو مالك الغفاري عن ابن عباس"
"12642","[12/106]      [  أَبُو ظِبْيَانَ  عَنِ  ابْنِ عَبَّاسٍ  ]  12608  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  قَابُوسُ بْنُ أَبِي ظِبْيَانَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ  الْهَدْيَ  الصَّالِحَ ،  وَالسَّمْتَ  الصَّالِحَ  جُزْءٌ  مِنْ سَبْعِينَ  جُزْءًا  مِنَ النُّبُوَّةِ  .","","Al-Mu'jam al-Kabir 12608","","عبد الله بن عباس عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو ظبيان عن ابن عباس"
"12643","12609  -  حَدَّثَنَا  أَبُو عَامِرٍ مُحَمَّدُ بْنُ إِبْرَاهِيمَ النَّحْوِيُّ الصُّورِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  عُثْمَانُ بْنُ فَائِدٍ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  قَابُوسَ بْنِ أَبِي ظِبْيَانَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْهَدْيُ  الصَّالِحُ ،  وَالسَّمْتُ  الصَّالِحُ  ، وَالِاقْتِصَادُ  جُزْءٌ  مِنْ خَمْسَةٍ وَأَرْبَعِينَ  جُزْءًا  مِنَ النُّبُوَّةِ  .","","Al-Mu'jam al-Kabir 12609","","عبد الله بن عباس عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن سفيان الثوري عن عثمان بن فائد القرشي عن سليمان بن عبد الرحمن التميمي عن محمد بن إبراهيم الصوري عن الطبراني","أبو ظبيان عن ابن عباس"
"12644","12610  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  أَحْمَدُ بْنُ عَبْدِ الْمَلِكِ بْنِ وَاقِدٍ الْحَرَّانِيُّ (  ح  ) .         [12/107]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ، قَالُوا :  ثَنَا  زُهَيْرٌ ،  ثَنَا  قَابُوسُ أَنَّ أَبَاهُ  حَدَّثَهُ  قَالَ :  قُلْنَا لِابْنِ عَبَّاسٍ : أَرَأَيْتَ قَوْلَ اللهِ عَزَّ وَجَلَّ :         {      مَا جَعَلَ اللهُ لِرَجُلٍ مِنْ قَلْبَيْنِ فِي جَوْفِهِ         }      ،  فَقَالَ  : "" قَامَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا يُصَلِّي  فَخَطَرَ  خَطْرَةً "" ، فَقَالَ الْمُنَافِقُونُ الَّذِينَ يُصَلُّونَ مَعَهُ :  أَلَا تَرَوْنَ أَنَّ لَهُ قَلْبَيْنِ قَلْبًا مَعَكُمْ ، وَقَلْبًا مَعَهُمْ  ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      مَا جَعَلَ اللهُ لِرَجُلٍ مِنْ قَلْبَيْنِ فِي جَوْفِهِ         }      .","","Al-Mu'jam al-Kabir 12610","","عبد الله بن عباس عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو ظبيان عن ابن عباس"
"12645","12611  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  أَحْمَدُ بْنُ عَبْدِ الْمَلِكِ بْنِ وَاقِدٍ الْحَرَّانِيُّ ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  قَابُوسُ بْنُ أَبِي ظِبْيَانَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  جَاءَ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَجُلَانِ حَاجَتُهُمَا وَاحِدَةٌ فَسَلَّمَ أَحَدُهُمَا ، فَوَجَدَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ فِيهِ أَخْلَافًا ، فَقَالَ لَهُ :  أَمَا تَسْتَاكُ  ؟ "" قَالَ : إِنِّي لَأَفْعَلُ ، وَلَكِنْ لَمْ أَطْعَمْ طَعَامًا مُنْذُ ثَلَاثٍ ، "" فَأَمَرَ بِهِ  رَجُلًا  فَأَقْرَاهُ وَقَضَى حَاجَتَهُ  .","","Al-Mu'jam al-Kabir 12611","","عبد الله بن عباس عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن زهير بن معاوية بن حديج عن أحمد بن عبد الملك بن واقد الحراني عن محمد بن أحمد بن النضر النضري عن الطبراني","أبو ظبيان عن ابن عباس"
"12646","12612  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ الْجَوْهَرِيُّ ،  ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  ثَنَا  أَبُو كُدَيْنَةَ ،  عَنْ  قَابُوسَ بْنِ أَبِي ظِبْيَانَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَّا مَنِ انْتَهَبَ أَوْ سَلَبَ  ، أَوْ أَشَارَ بِالسَّلَبِ  "" .","","Al-Mu'jam al-Kabir 12612","","عبد الله بن عباس عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن يحيى بن المهلب البجلي عن عفان بن مسلم الصفار عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","أبو ظبيان عن ابن عباس"
"12647","12613  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ ،  ثَنَا  عَفَّانُ ،  نَا  ، أَبُو كُدَيْنَةَ ،  عَنْ  قَابُوسَ بْنِ أَبِي ظِبْيَانَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنْ         [12/108]      رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ مَرَّ عَلَى الْقُبُورِ  بِالْمَدِينَةِ  ، فَقَالَ :  السَّلَامُ عَلَيْكُمْ يَا أَهْلَ الْقُبُورِ الْمُؤْمِنِينَ  ، وَالْمُسْلِمِينَ أَسْتَغْفِرُ اللهَ لَنَا وَلَكُمْ ، أَنْتُمْ  سَلَفُنَا  ، وَنَحْنُ عَلَى الْأَثَرِ  .  سقط من طبعة مكتبة ابن تيمية ، والمثبت من الظاهرية (1) .","","Al-Mu'jam al-Kabir 12613","","عبد الله بن عباس عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن يحيى بن المهلب البجلي عن عفان بن مسلم الصفار عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","أبو ظبيان عن ابن عباس"
"12648","12614  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الصَّلْتِ الْكُوفِيُّ ،  ثَنَا  أَبُو كُدَيْنَةَ ،  عَنْ  قَابُوسَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قُلْنَ النِّسَاءُ :  يَا رَسُولَ اللهِ ، مَا بَالُهُ يَذْكُرُ الْمُؤْمِنِينَ ، وَلَا يَذْكُرُ الْمُؤْمِنَاتِ  ؟ "" فَنَزَلَتْ         {      إِنَّ الْمُسْلِمِينَ وَالْمُسْلِمَاتِ وَالْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ         }      .","","Al-Mu'jam al-Kabir 12614","","عبد الله بن عباس عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن يحيى بن المهلب البجلي عن محمد بن الصلت الأصم عن حفص بن عمر سنجة ألف عن الطبراني","أبو ظبيان عن ابن عباس"
"12649","12615  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْفَسَوِيُّ  ، ثَنَا  خَالِدُ بْنُ يَزِيدَ الْبَصْرِيُّ ،  ثَنَا  جَرِيرٌ ،  عَنْ  قَابُوسَ بْنِ أَبِي ظِبْيَانَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَرَّجَ فَخِذَيِ  الْحُسَيْنِ  وَقَبَّلَ زَبِيبَتَهُ  .","","Al-Mu'jam al-Kabir 12615","","عبد الله بن عباس عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن جرير بن عبد الحميد عن خالد بن يزيد البصري عن الحسن بن علي بن الوليد الفسوي عن الطبراني","أبو ظبيان عن ابن عباس"
"12650","12616  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ،  ثَنَا  حَرْمَلَةُ بْنُ يَحْيَى ،  ثَنَا  ابْنُ وَهْبٍ ،  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  قَابُوسَ بْنِ أَبِي ظِبْيَانَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ يَعْلَمُ صَاحِبُ الْمَسْأَلَةِ مَا لَهُ فِيهَا لَمْ يَسْأَلْ  .","","Al-Mu'jam al-Kabir 12616","","عبد الله بن عباس عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن جرير بن حازم عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن أحمد بن داود بن موسى السدوسي عن الطبراني","أبو ظبيان عن ابن عباس"
"12651","[12/109]      12617  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ  بْنُ حَنْبَلٍ  ، ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي اللَّيْثِ ،  ثَنَا  الْأَشْجَعِيُّ ،  عَنْ  سُفْيَانَ ،  عَنْ  قَابُوسَ بْنِ أَبِي ظِبْيَانَ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عَبَّاسٍ :         {      وَلَوْ أَنَّ قُرْآنًا سُيِّرَتْ بِهِ الْجِبَالُ أَوْ قُطِّعَتْ بِهِ الأَرْضُ أَوْ كُلِّمَ بِهِ الْمَوْتَى         }      قَالَ : "" قَالُوا لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ كَانَ كَمَا تَقُولُ فَأَرِنَا أَشْيَاخَنَا الْأُوَلَ مِنَ الْمَوْتَى نُكَلِّمْهُمْ  ، وَافْتَحْ لَنَا هَذِهِ الْجِبَالَ جِبَالَ  مَكَّةَ  الَّتِي قَدْ ضَمَّتْنَا "" ، فَنَزَلَتْ :         {      وَلَوْ أَنَّ قُرْآنًا سُيِّرَتْ بِهِ الْجِبَالُ أَوْ قُطِّعَتْ بِهِ الأَرْضُ أَوْ كُلِّمَ بِهِ الْمَوْتَى         }      .  سقط من طبعة مكتبة ابن تيمية ، والمثبت من النسخ الخطية.","","Al-Mu'jam al-Kabir 12617","","عبد الله بن عباس عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن سفيان الثوري عن عبيد الله بن عبيد الرحمن الأشجعي عن إبراهيم بن أبي الليث الترمذي عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو ظبيان عن ابن عباس"
"12652","12618  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي اللَّيْثِ ،  ثَنَا  الْأَشْجَعِيُّ ،  عَنْ  سُفْيَانَ ،  عَنْ  قَابُوسَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ،         {      أَدْخِلْنِي مُدْخَلَ صِدْقٍ وَأَخْرِجْنِي مُخْرَجَ صِدْقٍ         }      قَالَ :  مَكَثَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَشْرَ سِنِينَ  بِمَكَّةَ  ، فَنَزَلَتْ :         {      وَقُلْ رَبِّ أَدْخِلْنِي مُدْخَلَ صِدْقٍ وَأَخْرِجْنِي مُخْرَجَ صِدْقٍ         }      ، فَهَاجَرَ إِلَى  الْمَدِينَةِ  .","","Al-Mu'jam al-Kabir 12618","","عبد الله بن عباس عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن سفيان الثوري عن عبيد الله بن عبيد الرحمن الأشجعي عن إبراهيم بن أبي الليث الترمذي عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو ظبيان عن ابن عباس"
"12653","12619  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  ثَنَا  قَابُوسُ بْنُ أَبِي ظِبْيَانَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الرَّجُلُ الَّذِي لَيْسَ فِي جَوْفِهِ شَيْءٌ مِنَ الْقُرْآنِ كَالْبَيْتِ الْخَرِبِ  .","","Al-Mu'jam al-Kabir 12619","","عبد الله بن عباس عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن جرير بن عبد الحميد عن يحيى بن معين عن معاذ بن المثنى العنبري عن الطبراني","أبو ظبيان عن ابن عباس"
"12654","[12/110]      12620  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  جَرِيرٌ ،  عَنْ  قَابُوسَ بْنِ أَبِي ظِبْيَانَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنْكُمْ مِنْ أَحَدٍ إِلَّا وَقَدْ وُكِّلَ بِهِ  قَرِينُهُ  مِنَ الشَّيَاطِينِ  . قَالُوا : وَأَنْتَ يَا رَسُولَ اللهِ ؟ قَالَ : "" نَعَمْ ، وَلَكِنَّ اللهَ أَعَانَنِي عَلَيْهِ  فَأَسْلَمَ  .","","Al-Mu'jam al-Kabir 12620","","عبد الله بن عباس عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن جرير بن عبد الحميد عن يحيى بن معين عن معاذ بن المثنى العنبري عن الطبراني","أبو ظبيان عن ابن عباس"
"12655","12621  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  جَرِيرٌ ،  عَنْ  قَابُوسَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  أَقْبَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُسْرِعًا وَنَحْنُ قُعُودٌ فَأَفْزَعَنَا سُرْعَتُهُ ، فَلَمَّا انْتَهَى إِلَيْنَا سَلَّمَ ، ثُمَّ قَالَ :  لَقَدْ أَقْبَلْتُ إِلَيْكُمْ مُسْرِعًا لِأُخْبِرَكُمْ بِلَيْلَةِ الْقَدْرِ  ، فَنَسِيتُهَا فِيمَا بَيْنِي وَبَيْنَكُمْ ، فَالْتَمِسُوهَا فِي الْعَشْرِ الْآوَاخِرِ  .","","Al-Mu'jam al-Kabir 12621","","عبد الله بن عباس عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن جرير بن عبد الحميد عن يحيى بن معين عن معاذ بن المثنى العنبري عن الطبراني","أبو ظبيان عن ابن عباس"
"12656","12622  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَمُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ، قَالَا :  ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  أَبِي ظِبْيَانَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  جَاءَ  أَعْرَابِيٌّ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : بِمَ أَعْرِفُ أَنَّكَ رَسُولُ اللهِ ؟ قَالَ :  إِنْ دَعَوْتُ هَذَا  الْعِذْقَ  مِنْ هَذِهِ النَّخْلَةِ أَتَشْهَدُ أَنِّي رَسُولُ اللهِ  ؟ "" قَالَ : نَعَمْ ، فَجَاءَ  الْعِذْقُ  يَنْزِلُ مِنَ النَّخْلَةِ حَتَّى سَقَطَ فِي الْأَرْضِ فَجَعَلَ يَنْقُرُ حَتَّى أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ قَالَ لَهُ :         [12/111]      "" ارْجِعْ "" فَرَجَعَ حَتَّى عَادَ إِلَى مَكَانِهِ ، فَقَالَ : أَشْهَدُ أَنَّكَ رَسُولُ اللهِ ، وَآمَنَ  .","","Al-Mu'jam al-Kabir 12622","","عبد الله بن عباس عن حصين بن جندب الجنبي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن محمد بن سعيد حمدان عن محمد بن أحمد بن النضر النضري عن الطبراني","أبو ظبيان عن ابن عباس"
"12657","[  أَبُو عُمَرَ يَحْيَى بْنُ عُبَيْدٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12623  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ ،  ثَنَا  عَمِّي عَمْرُو بْنُ عُثْمَانَ ،  ثَنَا  أَبُو مُسْلِمٍ قَائِدُ الْأَعْمَشِ ،  عَنْ  يَحْيَى أَبِي عُمَرَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ يُنْبَذُ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الزَّبِيبُ مِنَ اللَّيْلِ فَيَشْرَبُهُ الْغَدَ وَلَيْلَتَهُ  ، وَالْغَدَ وَلَيْلَتَهُ ، وَالْغَدَ حَتَّى إِذَا أَمْسَى شَرِبَهُ ، وَسَقَاهُ أَوْ أَمَرَ بِهِ فَأُهْرِيقَ  .","","Al-Mu'jam al-Kabir 12623","","عبد الله بن عباس عن يحيى بن عبيد البهراني عن عبيد الله بن سعيد بن مسلم الجعفي عن عمرو بن عثمان بن سعيد الجعفي عن يحيى بن سليمان بن يحيى عن روح بن الفرج القطان عن الطبراني","أبو عمر يحيى بن عبيد عن ابن عباس"
"12658","12624  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي عُمَرَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُنْقَعُ لَهُ الزَّبِيبُ فَيَشْرَبُهُ الْيَوْمَ وَالْغَدَ  ، وَبَعْدَ الْغَدِ إِلَى مَسَاءِ لَيْلَتِهِ ، ثُمَّ يَأْمُرُ بِهِ يُسْقَى أَوْ يُهَرَاقُ  .","","Al-Mu'jam al-Kabir 12624","","عبد الله بن عباس عن يحيى بن عبيد البهراني عن الأعمش عن أبو معاوية الضرير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو عمر يحيى بن عبيد عن ابن عباس"
"12659","12625  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَنَا  الْحَجَّاجُ بْنُ أَرْطَاةَ ،  عَنْ  يَحْيَى بْنِ عُبَيْدٍ الْبَهْرَانِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُنْبَذُ لَهُ فَيَشْرَبُهُ الْغَدَ وَبَعْدَ الْغَدِ  ، فَإِذَا كَانَ يَوْمُ الثَّالِثِ أَمَرَ بِهِ فَأُهْرِيقَ  .         [12/112]","","Al-Mu'jam al-Kabir 12625","","عبد الله بن عباس عن يحيى بن عبيد البهراني عن حجاج بن أرطاة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن الطبراني","أبو عمر يحيى بن عبيد عن ابن عباس"
"12660","12626  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  عُمَرُ بْنُ عَلِيٍّ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  يَحْيَى بْنِ عُبَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، مِثْلَهُ  .","","Al-Mu'jam al-Kabir 12626","","عبد الله بن عباس عن يحيى بن عبيد البهراني عن حجاج بن أرطاة عن عمر بن علي بن عطاء عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","أبو عمر يحيى بن عبيد عن ابن عباس"
"12661","12627  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ أَيُّوبَ الْمَخْزُومِيُّ ،  ثَنَا  سَعِيدُ بْنُ مُحَمَّدٍ الْجَرْمِيُّ ،  ثَنَا  أَبُو تُمَيْلَةَ يَحْيَى بْنُ وَاضِحٍ ،  عَنْ  أَبِي حَمْزَةَ ،  عَنْ  جَابِرٍ ،  عَنْ  يَحْيَى بْنِ عُبَيْدٍ أَبِي عُمَرَ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُنْبَذُ لَهُ الزَّبِيبُ فِي سِقَاءٍ  ، فَيَشْرَبُهُ مِنَ الْمَسَاءِ ، وَمِنَ الْغَدِ وَبَعْدَ الْغَدِ ، فَإِنْ فَضَلَتْ أَمَرَ بِهَا فَأُهْرِيقَ أَوْ شُرِبَتْ  .","","Al-Mu'jam al-Kabir 12627","","عبد الله بن عباس عن يحيى بن عبيد البهراني عن جابر الجعفي عن محمد بن ميمون أبو حمزة السكري عن يحيى بن واضح الأنصاري عن سعيد بن محمد الجرمي عن المخرمي إبراهيم بن عبد الله البغدادي عن الطبراني","أبو عمر يحيى بن عبيد عن ابن عباس"
"12662","12628  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ مَنْصُورٍ الرُّمَّانِيُّ الْمِصِّيصِيُّ ،  ثَنَا  دَاوُدُ بْنُ مُعَاذٍ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  أَبِي عَمْرِو بْنِ الْعَلَاءِ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي لَيْلَى ،  عَنْ  يَحْيَى بْنِ عُبَيْدٍ الْبَهْرَانِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ يُنْبَذُ لَهُ فَيَشْرَبُهُ فِي الْيَوْمِ وَلَيْلَتِهِ  ، وَالْغَدِ وَلَيْلَتِهِ ، فَإِذَا كَانَ الْيَوْمُ الثَّالِثُ أَمَرَ أَنْ يُهَرَاقَ ، أَوْ يُسْقَى الْخَدَمَ  .","","Al-Mu'jam al-Kabir 12628","","عبد الله بن عباس عن يحيى بن عبيد البهراني عن محمد بن عبد الرحمن بن أبي ليلى عن أبو عمرو بن العلاء عن عبد الوارث بن سعيد بن ذكوان عن داود بن معاذ العتكي عن الحسين بن منصور الرماني عن الطبراني","أبو عمر يحيى بن عبيد عن ابن عباس"
"12663","12629  -  حَدَّثَنَا  مَحْمُودُ بْنُ الْفَرَجِ الْأَصْبَهَانِيُّ ،  ثَنَا  الْحَسَنُ  بْنُ الْفَرَجِ ،  ثَنَا  جَعْفَرُ بْنُ عَوْنٍ ،  عَنْ  مُطِيعٍ الْغَزَّالِ ،  عَنْ  يَحْيَى بْنِ عُبَيْدٍ الْبَهْرَانِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ يُنْبَذُ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فِي سِقَاءٍ فَيَشْرَبُهُ الْغَدَ وَلَيْلَتَهُ  ، وَالْغَدَ وَلَيْلَتَهُ ، فَإِذَا كَانَ الثَّالِثُ أَمَرَ فَأُهْرِيقَ ، أَوْ سَقَاهُ الْخَدَمَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب (الحسين) .","","Al-Mu'jam al-Kabir 12629","","عبد الله بن عباس عن يحيى بن عبيد البهراني عن مطيع بن عبد الله الغزال عن جعفر بن عون المخزومي عن ابن الخياط الحسين بن الفرج عن محمود بن الفرج الأصبهاني عن الطبراني","أبو عمر يحيى بن عبيد عن ابن عباس"
"12664","12630  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الطُّفَيْلِ النَّخَعِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  يَحْيَى بْنِ عُبَيْدٍ الْبَهْرَانِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانُ يُنْقَعُ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ         [12/113]      وَسَلَّمَ فَيَشْرَبُهُ يَوْمَهُ  ، وَمِنَ الْغَدِ ، وَالْيَوْمِ الثَّالِثِ ، فَإِذَا كَانَ الْعَشِيُّ أَهَرَاقَهُ ، أَوْ سَقَاهُ الْخَدَمَ ، وَلَمْ يَسْقِ الْخَدَمَ حَرَامًا  .","","Al-Mu'jam al-Kabir 12630","","عبد الله بن عباس عن يحيى بن عبيد البهراني عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن محمد بن الطفيل بن مالك النخعي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","أبو عمر يحيى بن عبيد عن ابن عباس"
"12665","12631  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حَيَّانَ الْمَازِنِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  أَبُو إِسْرَائِيلَ الْمُلَائِيُّ ،  عَنْ  أَبِي عُمَرَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ يُنْبَذُ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَيَشْرَبُهُ مِنَ الْغَدِ ، وَبَعْدَ الْغَدِ  ، فَإِذَا أَمْسَى يَوْمُ الثَّالِثِ أَهَرَاقَهُ ، أَوْ أَمَرَ فَأُهْرِيقَ  .","","Al-Mu'jam al-Kabir 12631","","عبد الله بن عباس عن يحيى بن عبيد البهراني عن إسماعيل بن خليفة الملائي عن أبو الوليد الطيالسي عن محمد بن حيان المازني عن الطبراني","أبو عمر يحيى بن عبيد عن ابن عباس"
"12666","12632  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ (  ح  ) .  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  يَحْيَى بْنِ عُبَيْدٍ قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الدُّبَّاءِ ،  وَالْحَنْتَمِ  ،  وَالنَّقِيرِ  .","","Al-Mu'jam al-Kabir 12632","","عبد الله بن عباس عن يحيى بن عبيد البهراني عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","أبو عمر يحيى بن عبيد عن ابن عباس"
"12667","12633  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَحْمَدُ بْنُ حَوَّاسٍ الْحَنَفِيُّ ،  ثَنَا  عَبْثَرُ بْنُ الْقَاسِمِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  يَحْيَى أَبِي عُمَرَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  حُرِّمَتِ الْخَمْرُ بِعَيْنِهَا  ، قَلِيلُهَا وَكَثِيرُهَا ،  وَالسَّكَرُ  مِنْ كُلِّ شَرَابٍ  "" .","","Al-Mu'jam al-Kabir 12633","","عبد الله بن عباس عن يحيى بن عبيد البهراني عن الأعمش عن عبثر بن القاسم الزبيدي عن أحمد بن جواس الحنفي عن الحسين بن إسحاق التستري عن الطبراني","أبو عمر يحيى بن عبيد عن ابن عباس"
"12668","12634  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْأَرْقَمِ بْنِ شُرَحْبِيلَ قَالَ :  سَافَرْتُ         [12/114]      مَعَ ابْنِ عَبَّاسٍ مِنَ  الْمَدِينَةِ  إِلَى  الشَّامِ  فَسَأَلْتُهُ  : أَوْصَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ : إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لَمَّا مَرِضَ مَرَضَهُ الَّذِي مَاتَ فِيهِ  كَانَ فِي بَيْتِ  عَائِشَةَ  ، فَقَالَ : "" ادْعُوا لِي  عَلِيًّا  "" ، فَقَالَتْ : أَلَا نَدْعُو  أَبَا بَكْرٍ  يَا رَسُولَ اللهِ ؟ قَالَ : "" ادْعُوهُ "" ثُمَّ قَالَتْ  حَفْصَةُ  : أَلَا نَدْعُو  عُمَرَ  ؟ قَالَ : "" ادْعُوهُ "" ثُمَّ قَالَتْ  أُمُّ الْفَضْلِ  : أَلَا نَدْعُو  الْعَبَّاسَ  عَمَّكَ ؟ قَالَ : "" ادْعُوهُ "" فَلَمَّا حَضَرُوهُ رَفَعَ رَأْسَهُ ، فَلَمْ يَرَ  عَلِيًّا  ، فَسَكَتَ وَلَمْ يَتَكَلَّمْ ، فَقَالَ  عُمَرُ  : قُومُوا عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَوْ كَانَتْ لَهُ إِلَيْنَا حَاجَةٌ ذَكَرَهَا حَتَّى فَعَلَ ذَلِكَ ثَلَاثَ مَرَّاتٍ ، ثُمَّ قَالَ :  لِيُصَلِّ بِالنَّاسِ  أَبُو بَكْرٍ  قَالَتْ  عَائِشَةُ  : إِنَّ  أَبَا بَكْرٍ  حَضَرَ ، فَتَقَدَّمَ  أَبُو بَكْرٍ  يُصَلِّي بِالنَّاسِ ، فَرَأَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ نَفْسِهِ خِفَّةً ، فَانْطَلَقَ  يُهَادَى  بَيْنَ رَجُلَيْنِ ، فَلَمَّا  أَحَسَّ  النَّاسُ سَبَّحُوا ، فَذَهَبَ  أَبُو بَكْرٍ  لِيَتَأَخَّرَ ، فَأَشَارَ إِلَيْهِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَكَانَكَ ، وَاسْتَفْتَحَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِنْ حَيْثُ انْتَهَى  أَبُو بَكْرٍ  مِنَ الْقِرَاءَةِ ،  وَأَبُو بَكْرٍ  قَائِمٌ وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَالِسٌ ، فَائْتَمَّ  أَبُو بَكْرٍ  بِالنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَائْتَمَّ النَّاسُ  بِأَبِي بَكْرٍ  ، فَمَا قَضَى رَسُولُ اللهِ الصَّلَاةَ حَتَّى ثَقُلَ جِدًّا ، فَخَرَجَ  يُهَادَى  بَيْنَ رَجُلَيْنِ ، وَإِنَّ رِجْلَيْهِ لَتَخُطَّانِ فِي الْأَرْضِ ، فَمَاتَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَلَمْ يُوصِ  .","","Al-Mu'jam al-Kabir 12634","","عبد الله بن عباس عن أرقم بن شرحبيل حطام الصفوف عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","أبو عمر يحيى بن عبيد عن ابن عباس"
"12669","[  الضَّحَّاكُ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12635  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  عُمَرُ بْنُ عَلِيٍّ ،  عَنْ  أَبِي جَنَابٍ الْكَلْبِيِّ ،  عَنِ  الضَّحَّاكِ ،  عَنِ         [12/115]      ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَانَ عِنْدَهُ مَا يَبْلُغُ حَجَّ  بَيْتِ اللهِ الْحَرَامِ  ، فَلَمْ يَحُجَّ  ، وَمَنْ كَانَ لَهُ مَالٌ يَبْلُغُ الزَّكَاةَ ، وَلَمْ يُزَكِّهِ سَأَلَ  الرَّجْعَةَ  عِنْدَ الْمَوْتِ "" ، فَقَالَ لَهُ  رَجُلٌ  : اتَّقِ اللهَ يَا  أَبَا عَبَّاسٍ  إِنَّمَا يَسْأَلُ الْكَافِرُ الرَّجْعَةَ ، فَقَالَ : "" أَنَا أَقْرَأُ بِهِ عَلَيْكَ قُرْآنًا         {      يَا أَيُّهَا الَّذِينَ آمَنُوا             *          وَأَنْفِقُوا مِنْ مَا رَزَقْنَاكُمْ مِنْ قَبْلِ أَنْ يَأْتِيَ أَحَدَكُمُ الْمَوْتُ فَيَقُولَ رَبِّ لَوْلا أَخَّرْتَنِي إِلَى أَجَلٍ قَرِيبٍ         }      .","","Al-Mu'jam al-Kabir 12635","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن يحيى بن أبي حية عن عمر بن علي بن عطاء عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","الضحاك عن ابن عباس"
"12670","12636  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي حَيَّةَ أَبِي جَنَابٍ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَانَ عِنْدَهُ مَا يَحُجُّ فَلَمْ يَحُجَّ  ، أَوْ مَا يُزَكِّهِ فَلَمْ يُزَكِّهِ سَأَلَ  الرَّجْعَةَ  عِنْدَ الْمَوْتِ "" ، فَقَالَ لَهُ  رَجُلٌ  : اتَّقِ اللهَ يَا  أَبَا عَبَّاسٍ  إِنَّمَا يَسْأَلُ الرَّجْعَةَ الْكَافِرُ ، فَقَالَ : "" أَنَا أَقْرَأُ عَلَيْكَ قُرْآنًا         {      يَا أَيُّهَا الَّذِينَ آمَنُوا             *          وَأَنْفِقُوا مِنْ مَا رَزَقْنَاكُمْ مِنْ قَبْلِ أَنْ يَأْتِيَ أَحَدَكُمُ الْمَوْتُ فَيَقُولَ رَبِّ لَوْلا أَخَّرْتَنِي إِلَى أَجَلٍ قَرِيبٍ فَأَصَّدَّقَ وَأَكُنْ مِنَ الصَّالِحِينَ         }      "" .","","Al-Mu'jam al-Kabir 12636","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن يحيى بن أبي حية عن سفيان الثوري عن مؤمل بن إسماعيل العدوي عن أبو موسى الزمن عن محمد بن صالح النرسي عن الطبراني","الضحاك عن ابن عباس"
"12671","12637  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ مُحَمَّدٍ الْبَصْرِيُّ الْمِصْرِيُّ ،  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  يَحْيَى بْنُ حَسَّانَ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمِ بْنِ أَبِي الْوَضَّاحِ ،  عَنْ  سَالِمٍ الْأَفْطَسِ ،  حَدَّثَنِي  رَزِينٌ الْجُرْجَانِيُّ قَالَ :  سَأَلْتُ         [12/116]      سَعِيدَ بْنَ جُبَيْرٍ عَنْ هَذِهِ الْآيَةِ :         {      وَالْمُحْصَنَاتُ مِنَ النِّسَاءِ         }      قَالَ : لَا عِلْمَ لِي بِهَا ،  فَسَأَلْتُ  الضَّحَّاكَ بْنَ مُزَاحِمٍ وَذَكَرْتُ قَوْلَ  سَعِيدِ بْنِ جُبَيْرٍ  ، فَقَالَ : أَشْهَدُ لَسَمِعْتُهُ يَسْأَلُ عَنْهَا  ابْنَ عَبَّاسٍ  ،  فَقَالَ  ابْنُ عَبَّاسٍ :  نَزَلَتْ  يَوْمَ خَيْبَرَ  لَمَّا فَتَحَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَصَابَ الْمُسْلِمُونَ مِنْ نِسَاءِ أَهْلِ الْكِتَابِ لَهُنَّ أَزْوَاجٌ ،  فَكَانَ الرَّجُلُ إِذَا أَرَادَ أَنْ يَأْتِيَ امْرَأَةً مِنْهُنَّ قَالَتْ : إِنَّ لِي زَوْجًا ، فَسُئِلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ هَذِهِ الْآيَةَ :         {      وَالْمُحْصَنَاتُ مِنَ النِّسَاءِ         }      الْآيَةَ يَعْنِي السَّبِيَّةَ مِنَ الْمُشْرِكِينَ تُصَابُ لَا بَأْسَ بِذَلِكَ "" فَذَكَرْتُ ذَلِكَ  لِسَعِيدِ بْنِ جُبَيْرٍ  ، فَقَالَ : صَدَقَ .","","Al-Mu'jam al-Kabir 12637","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن الضحاك بن مزاحم الهلالي عن رزين الجرجاني عن سالم بن عجلان الأفطس عن محمد بن مسلم بن أبي الوضاح القضاعي عن يحيى بن حسان بن حيان التنيسي عن أحمد بن صالح المصري عن البصري العباس بن محمد الحافظ عن الطبراني","الضحاك عن ابن عباس"
"12672","12638  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِيُّ ،  عَنْ  عَبْدِ السَّلَامِ بْنِ نَهْشَلٍ ،  حَدَّثَنِي  رَجُلٌ يُكْنَى أَبَا عَبْدِ اللهِ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَلْخَيْرُ أَسْرَعُ إِلَى الْبَيْتِ الَّذِي يُطْعَمُ فِيهِ الطَّعَامُ مِنَ الشَّفْرَةِ فِي سَنَامِ الْبَعِيرِ  .","","Al-Mu'jam al-Kabir 12638","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن رجل يكنى أبا عبد الله عن عبد السلام بن نهشل النيسابوري عن عبد الرحمن بن محمد المحاربي عن محمد بن سعيد حمدان عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","الضحاك عن ابن عباس"
"12673","12639  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي         [12/117]      أَمْلَى عَلَيَّ مِنْ كِتَابِهِ الْأَصْلِ  ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ الْوَاسِطِيُّ ،  عَنْ  عُمَرَ أَبِي يَحْيَى ،  عَنْ  جُوَيْبِرٍ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ قَتْلِ كُلِّ ذِي رُوحٍ  إِلَّا أَنْ يُؤْذِيَ  .","","Al-Mu'jam al-Kabir 12639","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن عمر أبي يحيى عن محمد بن يزيد الكلاعي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","الضحاك عن ابن عباس"
"12674","12640  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  أَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي سِنَانٍ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنِ  ابْنِ عَبَّاسٍ  فِي قَوْلِ اللهِ عَزَّ وَجَلَّ :         {      وَإِذْ أَسَرَّ النَّبِيُّ إِلَى بَعْضِ أَزْوَاجِهِ حَدِيثًا         }      قَالَ : دَخَلَتْ  حَفْصَةُ  عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي بَيْتِهَا وَهُوَ يَطَأُ  مَارِيَةَ  ، فَقَالَ لَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُخْبِرِي  عَائِشَةَ  حَتَّى أُبَشِّرَكِ بِشَارَةً  ، فَإِنَّ أَبَاكِ يَلِي مِنْ بَعْدِ  أَبِي بَكْرٍ  إِذَا أَنَا مُتُّ "" ، فَذَهَبَتْ  حَفْصَةُ  ، فَأَخْبَرَتْ  عَائِشَةَ  أَنَّهَا رَأَتِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَطَأُ  مَارِيَةَ  وَأَخْبَرَتْهَا أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَخْبَرَهَا أَنَّ  أَبَا بَكْرٍ  يَلِي بَعْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَيَلِي  عُمَرُ  مِنْ بَعْدِهِ ، فَقَالَتْ  عَائِشَةُ  لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مَنْ أَنْبَأَكَ هَذَا ؟ قَالَ :         {      نَبَّأَنِيَ الْعَلِيمُ الْخَبِيرُ         }      فَقَالَتْ  عَائِشَةُ  : لَا أَنْظُرُ إِلَيْكَ حَتَّى تُحَرِّمَ  مَارِيَةَ  ، فَحَرَّمَهَا ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      يَا أَيُّهَا النَّبِيُّ لِمَ تُحَرِّمُ         }      .","","Al-Mu'jam al-Kabir 12640","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن سعيد بن سنان البرجمي عن الوضاح بن عبد الله اليشكري عن إسماعيل بن عمرو البجلي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","الضحاك عن ابن عباس"
"12675","12641  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدٍ         [12/118]      الشَّافِعِيُّ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  جُوَيْبِرٍ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْمَقْتُولُ دُونَ مَالِهِ شَهِيدٌ  ، وَالْمَقْتُولُ دُونَ أَهْلِهِ شَهِيدٌ ، وَالْمَقْتُولُ دُونَ نَفْسِهِ شَهِيدٌ  .","","Al-Mu'jam al-Kabir 12641","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن حماد بن زيد عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","الضحاك عن ابن عباس"
"12676","12642  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عِقَالٍ الْحَرَّانِيُّ ،  ثَنَا  النُّفَيْلِيُّ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  جُوَيْبِرٍ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مِثْلَهُ سَوَاءً  .","","Al-Mu'jam al-Kabir 12642","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن هشيم بن بشير عن عبد الله بن محمد النفيلي عن أحمد بن عبد الرحمن بن يزيد الحراني عن الطبراني","الضحاك عن ابن عباس"
"12677","12643  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  سَعِيدٍ أَبِي سَعْدٍ الْبَقَّالِ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَحْسِنُوا الْأَصْوَاتَ بِالْقُرْآنِ  .","","Al-Mu'jam al-Kabir 12643","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن سعيد بن المرزبان عن عبدة بن سليمان الكلابي عن نعيم بن حماد الخزاعي عن يوسف بن يزيد القراطيسي عن الطبراني","الضحاك عن ابن عباس"
"12678","12644  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ قَالَا :  ثَنَا  مُحَمَّدُ بْنُ مِرْدَاسٍ الْأَنْصَارِيُّ ،  ثَنَا  جَارِيَةُ بْنُ هَرِمٍ ،  ثَنَا  قُرَّةُ بْنُ خَالِدٍ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَمَعَ بَيْنَ الظُّهْرِ وَالْعَصْرِ  ، وَالْمَغْرِبِ وَالْعِشَاءِ  بِالْمَدِينَةِ  مِنْ غَيْرِ عِلَّةٍ "" ، فَقِيلَ  لِابْنِ عَبَّاسٍ  : مَا أَرَادَ بِذَلِكَ ؟ قَالَ : "" التَّوَسُّعَ عَلَى أُمَّتِهِ  .","","Al-Mu'jam al-Kabir 12644","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن قرة بن خالد السدوسي عن جارية بن هرم الفقيمي عن محمد بن مرداس الأنصاري عن عبد الله بن أحمد الجواليقي عن الطبراني","الضحاك عن ابن عباس"
"12679","12645  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْمَرْوَزِيُّ ،  ثَنَا  أَحْمَدُ بْنُ حَفْصِ بْنِ إِبْرَاهِيمَ الْأَنْصَارِيُّ الْبَلْخِيُّ ،  ثَنَا  أَصْرَمُ بْنُ حَوْشَبٍ ،  عَنْ         [12/119]      قُرَّةَ بْنِ خَالِدٍ ، وَأَبِي عَبْدِ اللهِ الْقُشَيْرِيِّ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْيَوْمَ الرِّهَانُ ، وَغَدًا السِّبَاقُ  ، وَالْغَايَةُ الْجَنَّةُ أَوِ النَّارُ ، أَنَا الْأَوَّلُ  وَأَبُو بَكْرٍ  الْمُصَلِّي  وَعُمَرُ  الثَّالِثُ ، وَالنَّاسُ بَعْدُ عَلَى السَّبْقِ الْأَوَّلُ فَالْأَوَّلُ  .","","Al-Mu'jam al-Kabir 12645","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن أبو عبد الله القشيري عن أصرم بن حوشب الهمذاني عن أحمد بن حفص بن إبراهيم الأنصاري البلخي عن محمود بن محمد بن عبد العزيز المروزي عن الطبراني","الضحاك عن ابن عباس"
"12680","12646  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  يَحْيَى بْنُ كَثِيرٍ أَبُو النَّضْرِ ،  عَنْ  جُوَيْبِرٍ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، مَتَى أُخِذَ مِيثَاقُكَ ؟ قَالَ :  وَآدَمُ  بَيْنَ الرُّوحِ وَالْجَسَدِ  .","","Al-Mu'jam al-Kabir 12646","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن يحيى بن كثير البصري عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","الضحاك عن ابن عباس"
"12681","12647  -  حَدَّثَنَا  عُبَيْدُ بْنُ كَثِيرٍ التَّمَّارُ ،  ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  عَنْ  نَهْشَلِ بْنِ سَعِيدٍ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ أَحَدٍ أَمَنَّ عَلَيَّ فِي يَدِهِ مِنْ  أَبِي بَكْرٍ  زَوَّجَنِي ابْنَتَهُ  ، وَأَخْرَجَنِي إِلَى دَارِ الْهِجْرَةِ ، وَلَوْ كُنْتُ مُتَّخِذًا  خَلِيلًا  لَاتَّخَذْتُ  أَبَا بَكْرٍ  خَلِيلًا ،  وَلَكِنْ إِخَاءُ مَوَدَّةٍ إِلَى يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 12647","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن نهشل بن سعيد بن وردان الورداني عن عبد الله بن عبد الله الحضرمي عن عقبة بن مكرم عن عبيد بن كثير العامري عن الطبراني","الضحاك عن ابن عباس"
"12682","[12/120]      12648  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  عَلِيُّ بْنُ حَكِيمٍ الْأَوْدِيُّ ،  ثَنَا  أَبُو مَالِكٍ الْجَنْبِيُّ ،  عَنْ  جُوَيْبِرٍ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كُنْتُ رِدْفَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى حِمَارٍ  يُقَالُ لَهُ  يَعْفُورٌ  فَعَرِقْتُ "" فَأَمَرَنِي أَنْ أَغْتَسِلَ  .","","Al-Mu'jam al-Kabir 12648","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن عمرو بن هاشم الجنبي عن علي بن حكيم بن ذبيان عن عبيد بن غنام النخعي عن الطبراني","الضحاك عن ابن عباس"
"12683","12649  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  عَلِيُّ بْنُ حَكِيمٍ الْأَوْدِيُّ ،  ثَنَا  أَبُو مَالِكٍ الْجَنْبِيُّ ،  عَنْ  جُوَيْبِرٍ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا أَتَاهُ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ بِالْوَحْيِ لَمْ يَفْرُغْ حَتَّى يُزَمَّلَ مِنَ الْوَحْيِ ،  يَتَكَلَّمُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَأَوَّلِهِ مَخَافَةَ أَنْ يُغْشَى عَلَيْهِ ، فَقَالَ لَهُ  جِبْرِيلُ  : لِمَ تَفْعَلُ ذَلِكَ ؟ قَالَ : "" مَخَافَةَ أَنْ أَنْسَى "" ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      سَنُقْرِئُكَ فَلا تَنْسَى         }      .","","Al-Mu'jam al-Kabir 12649","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن عمرو بن هاشم الجنبي عن علي بن حكيم بن ذبيان عن محمد بن عثمان بن أبي شيبة عن الطبراني","الضحاك عن ابن عباس"
"12684","12650  -  حَدَّثَنَا  الْمُنْتَصِرُ بْنُ مُحَمَّدِ بْنِ الْمُنْتَصِرِ ،  ثَنَا  الْحَسَنُ بْنُ حَمَّادٍ سَجَّادَةُ ،  ثَنَا  أَبُو مَالِكٍ الْجَنْبِيُّ ،  عَنْ  جُوَيْبِرٍ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ عَزَّ وَجَلَّ : نَاجَى  مُوسَى  بِمِائَةِ أَلْفٍ ، وَأَرْبَعِينَ أَلْفَ كَلِمَةٍ فِي ثَلَاثَةِ أَيَّامٍ  ، فَلَمَّا سَمِعَ  مُوسَى  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَلَامَ الْآدَمِيِّينَ مَقَتَهُمْ لِمَا وَقَعَ فِي  مَسَامِعِهِ  مِنْ كَلَامِ الرَّبِّ عَزَّ وَجَلَّ ، وَكَانَ فِيمَا نَاجَاهُ بِهِ أَنْ قَالَ : يَا  مُوسَى  إِنَّهُ لَمْ يَتَصَنَّعِ الْمُتَصَنِّعُونَ بِمِثْلِ الزُّهْدِ فِي الدُّنْيَا ،         [12/121]      وَلَمْ يَتَقَرَّبْ إِلَيَّ الْمُتَقَرِّبُونَ بِمِثْلِ  الْوَرَعِ  عَمَّا حَرَّمْتُ عَلَيْهِمْ ، وَلَمْ يَتَعَبَّدِ الْمُتَعَبِّدُونَ بِمِثْلِ الْبُكَاءِ مِنْ خَشْيَتِي ، قَالَ  مُوسَى  : يَا رَبَّ الْبَرِيَّةِ كُلِّهَا ، وَيَا مَالِكَ يَوْمِ الدِّينِ ، وَيَا ذَا  الْجَلَالِ  وَالْإِكْرَامِ ، مَاذَا أَعْدَدْتَ لَهُمْ ؟ وَمَاذَا جَزَيْتَهُمْ ؟ قَالَ : أَمَّا الزُّهَّادُ فِي الدُّنْيَا فَإِنِّي أُبِيحُهُمْ جَنَّتِي  يَتَبَوَّءُونَ  مِنْهَا حَيْثُ شَاءُوا ، وَأَمَّا الْوَرِعُونَ عَمَّا حَرَّمْتُ عَلَيْهِمْ ، فَإِنَّهُ إِذَا كَانَ يَوْمُ الْقِيَامَةِ لَمْ يَبْقَ عَبْدٌ إِلَّا نَاقَشْتُهُ الْحِسَابَ وَنَقَشْتُهُ إِلَّا الْوَرِعِينَ ، فَإِنِّي أَسْتَحْيِيهِمْ وَأُجِلُّهُمْ وَأُكْرِمُهُمْ ، وَأُدْخِلُهُمُ الْجَنَّةَ بِغَيْرِ حِسَابٍ ، وَأَمَّا الْبَكَّاءُونَ مِنْ خَشْيَتِي فَأُولَئِكَ لَهُمُ الرَّفِيعُ الْأَعْلَى لَا يُشَارَكُونَ فِيهِ  .","","Al-Mu'jam al-Kabir 12650","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن عمرو بن هاشم الجنبي عن الحسن بن حماد سجادة عن منتصر بن محمد بن منتصر البغدادي عن الطبراني","الضحاك عن ابن عباس"
"12685","12651  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى بْنِ حَمَّادٍ الْبَرْبَرِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ الْأَزْدِيُّ ،  ثَنَا  أَبُو مَالِكٍ الْجَنْبِيُّ ،  عَنْ  جُوَيْبِرٍ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يَسْبِقُ الْمَقْتُولُ فِي  سَبِيلِ  اللهِ مُقْبِلًا غَيْرَ مُدْبِرٍ الْمَقْتُولَ الْمُدْبِرَ إِلَى الْجَنَّةِ بِسَبْعِينَ  خَرِيفًا  ، وَمَرْضَى أُمَّتِي قَبْلَ  أَصِحَّائِهِمْ  بِسَبْعِينَ  خَرِيفًا  ، وَالْأَنْبِيَاءُ قَبْلَ  سُلَيْمَانَ بْنِ دَاوُدَ  بِأَرْبَعِينَ  خَرِيفًا  لِمَا كَانَ فِيهِ مِنَ الْمُلْكِ  .  تصحفت في طبعة مكتبة ابن تيمية إلى ( من ) وهي على الصواب في النسخ الخطية.  تصحفت في طبعة مكتبة ابن تيمية إلى ( أصحابهم ) وهي على في النسخ الخطية دون نقط فتحتمل اللفظين ، والمثبت هو الموافق للسياق . والله أعلم .","","Al-Mu'jam al-Kabir 12651","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن عمرو بن هاشم الجنبي عن عبد الرحمن بن صالح العتكي عن محمد بن موسى بن حماد البربري عن الطبراني","الضحاك عن ابن عباس"
"12686","12652  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يُوسُفُ بْنُ مُحَمَّدِ بْنِ سَابِقٍ ،  ثَنَا  أَبُو مَالِكٍ الْجَنْبِيُّ ،  عَنْ  جُوَيْبِرٍ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُسَافِرِ الْمَرْأَةُ ثَلَاثَةَ أَمْيَالٍ إِلَّا مَعَ زَوْجٍ أَوْ مَعَ ذِي  مَحْرَمٍ  فَقِيلَ  لِابْنِ عَبَّاسٍ  : النَّاسُ يَقُولُونُ : ثَلَاثَةَ أَيَّامِ . قَالَ : "" إِنَّمَا هُوَ وَهْمٌ مِنْهُمْ  .","","Al-Mu'jam al-Kabir 12652","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن عمرو بن هاشم الجنبي عن يوسف بن محمد بن سابق القرشي عن الحسين بن إسحاق التستري عن الطبراني","الضحاك عن ابن عباس"
"12687","[12/122]      12653  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يُوسُفُ بْنُ مُحَمَّدِ بْنِ سَابِقٍ ،  ثَنَا  أَبُو مَالِكٍ الْجَنْبِيُّ ،  عَنْ  جُوَيْبِرٍ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  لَمَّا عَقَدَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ اللِّوَاءَ  لِعَلِيٍّ  يَوْمَ خَيْبَرَ  دَعَا لَهُ هُنَيْهَةً ، فَقَالَ :  اللَّهُمَّ أَعِنْهُ ، وَأَعِزَّ بِهِ ، وَارْحَمْهُ وَارْحَمْ بِهِ ، وَانْصُرْهُ وَانْصُرْ بِهِ  . اللَّهُمَّ وَالِ مَنْ وَالَاهُ ، وَعَادِ مَنْ عَادَاهُ  .","","Al-Mu'jam al-Kabir 12653","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن عمرو بن هاشم الجنبي عن يوسف بن محمد بن سابق القرشي عن الحسين بن إسحاق التستري عن الطبراني","الضحاك عن ابن عباس"
"12688","12654  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  بِشْرُ بْنُ عُمَارَةَ ،  عَنْ  أَبِي رَوْقٍ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  لَمَّا أَرَادَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَخْرُجَ إِلَى  غَزْوَةِ تَبُوكَ  قَالَ  لِلْجَدِّ بْنِ قَيْسٍ  :  يَا  جَدُّ بْنَ قَيْسٍ  مَا تَقُولُ فِي مُجَاهَدَةِ  بَنِي الْأَصْفَرِ  ؟ "" قَالَ : يَا رَسُولَ اللهِ ، إِنِّي امْرُؤٌ صَاحِبُ نِسَاءٍ ، وَمَتَى أَرَى نِسَاءَ  بَنِي الْأَصْفَرِ  أُفْتَتَنُ فَائْذَنْ لِي فِي الْجُلُوسِ ، وَلَا تَفْتِنِّي ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      وَمِنْهُمْ مَنْ يَقُولُ ائْذَنْ لِي وَلا تَفْتِنِّي أَلا فِي الْفِتْنَةِ سَقَطُوا         }      .","","Al-Mu'jam al-Kabir 12654","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن عطية بن الحارث الهمداني عن بشر بن عمارة الخثعمي عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","الضحاك عن ابن عباس"
"12689","12655  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَوْنُ بْنُ سَلَّامٍ ،  ثَنَا  بِشْرُ بْنُ عُمَارَةَ ،  عَنْ  أَبِي رَوْقٍ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ عَبَّاسٍ  فِي قَوْلِهِ :         {      سَيَجْعَلُ لَهُمُ الرَّحْمَنُ وُدًّا         }      قَالَ :  الْمَحَبَّةُ فِي صُدُورِ الْمُؤْمِنِينَ ، نَزَلَتْ فِي  عَلِيِّ بْنِ أَبِي طَالِبٍ  كَرَّمَ اللهِ وَجْهَهُ  "" .","","Al-Mu'jam al-Kabir 12655","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن عطية بن الحارث الهمداني عن بشر بن عمارة الخثعمي عن عون بن سلام الهاشمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","الضحاك عن ابن عباس"
"12690","[12/123]      12656  -  حَدَّثَنَا  أَحْمَدُ بْنُ زَكَرِيَّا شَاذَانُ الْبَصْرِيُّ  ، ثَنَا  كَثِيرُ بْنُ عُبَيْدٍ ،  ثَنَا  خَالِدُ بْنُ يَزِيدَ ،  عَنْ  أَبِي رَوْقٍ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا  عَالَ  مُقْتَصِدٌ  قَطُّ  .","","Al-Mu'jam al-Kabir 12656","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن عطية بن الحارث الهمداني عن خالد بن يزيد الهمداني عن كثير بن عبيد المذحجي عن أحمد بن زكريا شاذان البصري عن الطبراني","الضحاك عن ابن عباس"
"12691","12657  -  حَدَّثَنَا  أَحْمَدُ بْنُ زَكَرِيَّا شَاذَانُ  ، ثَنَا  كَثِيرُ بْنُ عُبَيْدٍ ،  ثَنَا  خَالِدُ بْنُ يَزِيدَ الْقَسْرِيُّ ،  عَنْ  أَبِي رَوْقٍ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هُمَا سِتْرَانِ : الزَّوْجُ ، وَالْقَبْرُ  .","","Al-Mu'jam al-Kabir 12657","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن عطية بن الحارث الهمداني عن خالد بن يزيد القسري عن كثير بن عبيد المذحجي عن أحمد بن زكريا شاذان عن الطبراني","الضحاك عن ابن عباس"
"12692","12658  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  بِشْرُ بْنُ عُمَارَةَ ،  عَنْ  أَبِي رَوْقٍ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ عَبَّاسٍ  فِي قَوْلِهِ : (         {      فَإِنَّهُمْ لا يُكَذِّبُونَكَ         }      ) مُخَفَّفَةً وَكَذَلِكَ كَانَ يَقْرَؤُهَا قَالَ :  لَا يَقْدِرُونَ عَلَى أَنْ لَا يَكُونَ رَسُولًا ، وَلَا عَلَى أَنْ لَا يَكُونَ الْقُرْآنُ قُرْآنًا ،  فَأَمَّا أَنْ يُكَذِّبُونَكَ بِأَلْسِنَتِهِمْ فَهُمْ يُكَذِّبُونَكَ ، وَذَلِكَ إِلَّا كَذَّابٌ ، وَذَاكَ التَّكْذِيبُ  "" .","","Al-Mu'jam al-Kabir 12658","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن عطية بن الحارث الهمداني عن بشر بن عمارة الخثعمي عن منجاب بن الحارث التميمي عن محمد بن عثمان بن أبي شيبة عن الطبراني","الضحاك عن ابن عباس"
"12693","12659  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  بِشْرُ بْنُ عُمَارَةَ ،  عَنْ  أَبِي رَوْقٍ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ عَبَّاسٍ  فِي قَوْلِهِ :         {      لا تَقُولُوا رَاعِنَا         }      قَالَ : "" كَانُوا يَقُولُونَ لِلنَّبِيِّ         [12/124]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ارْعَنَا سَمْعَكَ  ، وَإِنَّمَا رَاعِنَا كَقَوْلِكِ : عَاطِنَا "" ،         {      وَاسْمَعْ غَيْرَ مُسْمَعٍ         }      لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : "" يَقُولُونَ : لَا سَمِعْتَ وَاسْمَعْ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا سَمِعْتَ "" قَالَ :         {      وَلَوْ أَنَّهُمْ قَالُوا سَمِعْنَا وَأَطَعْنَا وَاسْمَعْ وَانْظُرْنَا لَكَانَ خَيْرًا لَهُمْ         }      .","","Al-Mu'jam al-Kabir 12659","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن عطية بن الحارث الهمداني عن بشر بن عمارة الخثعمي عن منجاب بن الحارث التميمي عن محمد بن عثمان بن أبي شيبة عن الطبراني","الضحاك عن ابن عباس"
"12694","12660  -  حَدَّثَنَا  أَبُو عُمَرَ الضَّرِيرُ مُحَمَّدُ بْنُ عُثْمَانَ بْنِ سَعِيدٍ الْأُمَوِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  أَبُو شِهَابٍ ،  عَنْ  وَرْقَاءَ ،  عَنْ  نَهْشَلِ بْنِ سَعِيدٍ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" إِذَا بَعَثَ سَرِيَّةً فَغَنِمُوا  خَمَّسَ  الْغَنِيمَةَ  ، فَضَرَبَ ذَلِكَ الْخُمُسَ فِي خَمْسَةٍ ، ثُمَّ قَرَأَ :         {      وَاعْلَمُوا أَنَّمَا غَنِمْتُمْ مِنْ شَيْءٍ فَأَنَّ لِلهِ خُمُسَهُ         }      إِلَى قَوْلِهِ : لِلهِ مِفْتَاحُ كَلَامٍ         {      لِلهِ مَا فِي السَّمَاوَاتِ وَالأَرْضِ         }      فَجَعَلَ  سَهْمَ  اللهِ وَسَهْمَ الرَّسُولِ وَاحِدًا ،         {      وَلِذِي الْقُرْبَى         }      فَجَعَلَ هَذَيْنِ السَّهْمَيْنِ قُوَّةً فِي الْخَيْلِ وَالسِّلَاحِ ، وَجَعَلَ  سَهْمَ  الْيَتَامَى وَالْمَسَاكِينِ وَابْنِ السَّبِيلِ إِلَّا يُعْطِيهِ غَيْرَهَمْ ، وَجَعَلَ الْأَرْبَعَةَ الْأَسْهُمَ الْبَاقِيَةَ لِلْفَرَسِ سَهْمَيْنِ ، وَلِرَاكِبِهِ  سَهْمٌ  ، وَلِلرَّاجِلِ  سَهْمٌ  .","","Al-Mu'jam al-Kabir 12660","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن نهشل بن سعيد بن وردان الورداني عن ورقاء بن عمر عن عبد ربه بن نافع الحناط عن أحمد بن عبد الله اليربوعي عن محمد بن عثمان بن سعيد الضرير عن الطبراني","الضحاك عن ابن عباس"
"12695","12661  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ (  ح  ) .  وَحَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مُوسَى الْحَرَشِيُّ ، قَالَا :  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ الْحَسَنِ الْهِلَالِيُّ ،  عَنْ  نَهْشَلِ بْنِ سَعِيدٍ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَمَانٌ لِأُمَّتِي مِنَ الْغَرَقِ إِذَا رَكِبُوا السُّفُنَ         [12/125]      أَنْ يَقُولُوا : بِسْمِ اللهِ الْمَلِكِ         {      وَمَا قَدَرُوا اللهَ حَقَّ قَدْرِهِ وَالأَرْضُ جَمِيعًا قَبْضَتُهُ يَوْمَ الْقِيَامَةِ وَالسَّمَاوَاتُ مَطْوِيَّاتٌ بِيَمِينِهِ سُبْحَانَهُ وَتَعَالَى عَمَّا يُشْرِكُونَ         }      ،         {      بِسْمِ اللهِ مَجْرَاهَا وَمُرْسَاهَا إِنَّ رَبِّي لَغَفُورٌ رَحِيمٌ         }      .","","Al-Mu'jam al-Kabir 12661","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن نهشل بن سعيد بن وردان الورداني عن عبد الحميد بن الحسن الهلالي عن محمد بن موسى الحرشي عن زكريا بن يحيى السجزي عن الطبراني","الضحاك عن ابن عباس"
"12696","12662  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَكْرٍ السَّرَّاجُ الْعَسْكَرِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ التَّرْجُمَانِيُّ ،  ثَنَا  سَعْدُ بْنُ سَعِيدٍ الْجُرْجَانِيُّ ،  عَنْ  نَهْشَلٍ أَبِي عَبْدِ اللهِ الرَّاسِبِيِّ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَشْرَافُ أُمَّتِي حَمَلَةُ الْقُرْآنِ  .","","Al-Mu'jam al-Kabir 12662","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن نهشل بن سعيد بن وردان الورداني عن سعدويه سعيد بن سعيد عن إسماعيل بن إبراهيم الترجماني عن محمد بن عبد الله بن بكر السراج عن الطبراني","الضحاك عن ابن عباس"
"12697","[  زَائِدَةُ بْنُ عُمَيْرٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12663  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  ثَنَا  زَائِدَةُ بْنُ عُمَيْرٍ الطَّائِيُّ قَالَ :  قُلْتُ  لِابْنِ عَبَّاسٍ : كَيْفَ تَرَى فِي  الْعَزْلِ  ؟ قَالَ : "" إِنْ كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ فِيهِ شَيْئًا فَهُوَ كَمَا قَالَ ، وَإِلَّا فَإِنِّي أَقُولُ فِيهِ :         {      نِسَاؤُكُمْ حَرْثٌ لَكُمْ فَأْتُوا حَرْثَكُمْ أَنَّى شِئْتُمْ         }      مَنْ شَاءَ عَزَلَ ، وَمَنْ شَاءَ تَرَكَ  .","","Al-Mu'jam al-Kabir 12663","","عبد الله بن عباس عن زائدة بن عمير الطائي عن يونس بن أبي إسحاق عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","زائدة بن عمير عن ابن عباس"
"12698","12664  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو الْآمِدِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  ثَنَا  أَبُو إِسْحَاقَ الْهَمْدَانِيُّ ،  عَنْ  زَائِدَةَ بْنِ عُمَيْرٍ قَالَ :  سَأَلْتُ  ابْنَ عَبَّاسٍ ، عَنِ الصَّلَاةِ فِي السَّفَرِ ، فَقَالَ : "" رَكْعَتَيْنِ رَكْعَتَيْنِ سُنَّةُ نَبِيِّكُمْ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ""  .","","Al-Mu'jam al-Kabir 12664","","عبد الله بن عباس عن زائدة بن عمير الطائي عن أبو إسحاق السبيعي عن محمد بن جابر بن سيار عن عبيد الله بن عمرو الآمدي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","زائدة بن عمير عن ابن عباس"
"12699","[12/126]      [  أَبُو نَصْرٍ الْأَسَدِيُّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12665  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، قَالَا :  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  ثَنَا  الْأَغَرُّ بْنُ الصَّبَّاحِ ،  عَنْ  خَلِيفَةَ بْنِ حُصَيْنٍ ،  عَنْ  أَبِي نَصْرٍ الْأَسَدِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  تَرَدَّدَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي آيَةٍ فِي صَلَاةِ الصُّبْحِ ، فَلَمَّا قَضَى الصَّلَاةَ أَقْبَلَ عَلَى  الْقَوْمِ  بِوَجْهِهِ ، فَقَالَ :  أَشَهِدَ الصَّلَاةَ مَعَكُمْ  أُبَيُّ بْنُ كَعْبٍ  ؟ "" قَالُوا : لَا . قَالَ : فَرَأَى  الْقَوْمُ  أَنَّهُ إِنَّمَا فَقَدَهُ لِيَفْتَحَ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 12665","","عبد الله بن عباس عن أبو نصر الأسدي عن خليفة بن حصين المنقري عن الأغر بن الصباح التميمي عن قيس بن الربيع الأسدي عن أبو الوليد الطيالسي عن محمد بن محمد بن حيان التمار عن الطبراني","أبو نصر الأسدي عن ابن عباس"
"12700","12666  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنِ  الْأَغَرِّ بْنِ الصَّبَّاحِ ،  عَنْ  خَلِيفَةَ بْنِ حُصَيْنٍ ،  عَنْ  أَبِي نَصْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَتِ  الْأَوْسُ  وَالْخَزْرَجُ  فِي الْجَاهِلِيَّةِ بَيْنَهُمْ شَرٌّ ،  فَبَيْنَمَا هُمْ يَوْمًا جُلُوسٌ ذَكَرُوا مَا بَيْنَهُمْ حَتَّى غَضِبُوا ، فَقَامَ بَعْضُهُمْ إِلَى بَعْضٍ بِالسِّلَاحِ "" فَنَزَلَتْ :         {      وَكَيْفَ تَكْفُرُونَ وَأَنْتُمْ تُتْلَى عَلَيْكُمْ آيَاتُ اللهِ وَفِيكُمْ رَسُولُهُ         }      الْآيَةَ كُلَّهَا ، وَالْآيَتَانِ بَعْدَهَا إِلَى         {      وَاذْكُرُوا نِعْمَتَ اللهِ عَلَيْكُمْ إِذْ كُنْتُمْ أَعْدَاءً فَأَلَّفَ بَيْنَ قُلُوبِكُمْ         }      .","","Al-Mu'jam al-Kabir 12666","","عبد الله بن عباس عن أبو نصر الأسدي عن خليفة بن حصين المنقري عن الأغر بن الصباح التميمي عن قيس بن الربيع الأسدي عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","أبو نصر الأسدي عن ابن عباس"
"12701","[12/127]      12667  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  إِبْرَاهِيمُ بْنُ أَبِي اللَّيْثِ ،  ثَنَا  الْأَشْجَعِيُّ ،  عَنْ  سُفْيَانَ ،  عَنِ  الْأَغَرِّ بْنِ الصَّبَّاحِ ،  عَنْ  خَلِيفَةَ بْنِ حُصَيْنٍ ،  عَنْ  أَبِي نَصْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ :         {      وَكَيْفَ تَكْفُرُونَ وَأَنْتُمْ تُتْلَى عَلَيْكُمْ آيَاتُ اللهِ وَفِيكُمْ رَسُولُهُ         }      قَالَ :  كَانَ  الْأَوْسُ  يَتَحَدَّثُونَ إِذْ ذَكَرُوا أَمْرَ الْجَاهِلِيَّةِ ، فَغَضِبُوا حَتَّى كَانَ بَيْنَهُمْ حَرْبٌ ،  فَأَخَذُوا السِّلَاحَ ، وَمَشَى بَعْضُهُمْ إِلَى بَعْضٍ "" ، فَنَزَلَتْ :         {      وَكَيْفَ تَكْفُرُونَ وَأَنْتُمْ تُتْلَى عَلَيْكُمْ آيَاتُ اللهِ         }      إِلَى قَوْلِهِ :         {      فَأَنْقَذَكُمْ مِنْهَا         }      .","","Al-Mu'jam al-Kabir 12667","","عبد الله بن عباس عن أبو نصر الأسدي عن خليفة بن حصين المنقري عن الأغر بن الصباح التميمي عن سفيان الثوري عن عبيد الله بن عبيد الرحمن الأشجعي عن إبراهيم بن أبي الليث الترمذي عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو نصر الأسدي عن ابن عباس"
"12702","12668  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنِ  الْأَغَرِّ بْنِ الصَّبَّاحِ ،  عَنْ  خَلِيفَةَ بْنِ حُصَيْنٍ ،  عَنْ  أَبِي نَصْرٍ قَالَ :  سُئِلَ ابْنُ عَبَّاسٍ كَيْفَ كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَمْتَحِنُ النِّسَاءَ ؟ قَالَ :  كَانَ إِذَا أَتَتْهُ الْمَرْأَةُ لِتُسْلِمَ حَلَّفَهَا بِاللهِ مَا خَرَجَتْ لِبُغْضِ زَوْجٍ ، وَبِاللهِ مَا خَرَجَتْ لِاكْتِسَابِ دِينَارٍ  ، وَبِاللهِ مَا خَرَجَتْ رَغْبَةً عَنْ أَرْضٍ إِلَى أَرْضٍ ، وَبِاللهِ مَا خَرَجَتْ إِلَّا حُبًّا لِلهِ وَلِرَسُولِهِ  .","","Al-Mu'jam al-Kabir 12668","","عبد الله بن عباس عن أبو نصر الأسدي عن خليفة بن حصين المنقري عن الأغر بن الصباح التميمي عن قيس بن الربيع الأسدي عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","أبو نصر الأسدي عن ابن عباس"
"12703","12669  -  حَدَّثَنَا  عَلِيُّ بْنُ الْعَبَّاسِ الْبَجَلِيُّ الْكُوفِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ وَلِيدٍ الْكِنْدِيُّ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنِ  الْأَغَرِّ بْنِ الصَّبَّاحِ ،  عَنْ  خَلِيفَةَ بْنِ حُصَيْنٍ ،  عَنْ  أَبِي نَصْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  اعْتَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَلَاثَ عُمَرٍ فِي ذِي الْقَعْدَةِ  .","","Al-Mu'jam al-Kabir 12669","","عبد الله بن عباس عن أبو نصر الأسدي عن خليفة بن حصين المنقري عن الأغر بن الصباح التميمي عن قيس بن الربيع الأسدي عن يحيى بن آدم عن محمد بن عمر بن الوليد الكندي عن المقانعي علي بن العباس بن الوليد عن الطبراني","أبو نصر الأسدي عن ابن عباس"
"12704","[12/128]      [  عَطِيَّةُ الْعَوْفِيُّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12670  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مُطَرِّفِ بْنِ طَرِيفٍ ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كَيْفَ  أَنْعَمُ  وَقَدِ الْتَقَمَ صَاحِبُ الْقَرْنِ الْقَرْنَ  ؟ "" وَحَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَبْهَتَهُ "" يَنْتَظِرُ مَتَى يُؤْمَرُ فَيَنْفُخُ "" ، قَالُوا : يَا رَسُولَ اللهِ ، فَكَيْفَ نَقُولُ ؟ قَالَ : "" حَسْبُنَا اللهُ وَنِعْمَ الْوَكِيلُ "" ثُمَّ قَرَأَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         {      فَإِذَا نُقِرَ فِي النَّاقُورِ         }      .","","Al-Mu'jam al-Kabir 12670","","عبد الله بن عباس عن عطية بن سعد العوفي عن مطرف بن طريف عن الوضاح بن عبد الله اليشكري عن أبو الوليد الطيالسي عن محمد بن محمد بن حيان التمار عن الطبراني","عطية العوفي عن ابن عباس"
"12705","12671  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَسْبَاطٌ ،  عَنْ  مُطَرِّفِ بْنِ طَرِيفٍ ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عَبَّاسٍ  فِي قَوْلِهِ :         {      فَإِذَا نُقِرَ فِي النَّاقُورِ         }      قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَيْفَ  أَنْعَمُ  وَصَاحِبُ الْقَرْنِ قَدِ الْتَقَمَ الْقَرْنَ  ؟ "" وَحَنَا جَبْهَتَهُ ، "" يَسْتَمِعُ مَتَى يُؤْمَرُ ؟ "" ، فَقَالَ أَصْحَابُهُ : فَكَيْفَ نَقُولُ ؟ قَالَ : "" قُولُوا حَسْبُنَا اللهُ وَنِعْمَ الْوَكِيلُ  .","","Al-Mu'jam al-Kabir 12671","","عبد الله بن عباس عن عطية بن سعد العوفي عن مطرف بن طريف عن أسباط بن محمد بن ميسرة القرشي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عطية العوفي عن ابن عباس"
"12706","12672  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سَلَمَةُ بْنُ سَابُورَ ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،         {      وَلا تَمْنُنْ تَسْتَكْثِرُ         }      قَالَ : "" لَا تُعْطِي الرَّجُلَ عَطَاءً رَجَاءَ أَنْ يُعْطِيَكَ أَكْثَرَ مِنْهُ  .","","Al-Mu'jam al-Kabir 12672","","عبد الله بن عباس عن عطية بن سعد العوفي عن سلمة بن سابور عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عطية العوفي عن ابن عباس"
"12707","[12/129]      12673  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  صَالِحُ بْنُ مَالِكٍ الْخُوَارَزْمِيُّ ،  ثَنَا  سَوَّارُ بْنُ مُصْعَبٍ ،  عَنْ  عَطِيَّةَ الْعَوْفِيِّ قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ  كَسْبِ  الْإِمَاءِ  قُلْتُ  لِابْنِ عَبَّاسٍ  : وَلِمَ نَهَى عَنْهُ ؟ قَالَ : "" مَخَافَةَ أَنْ يَعْجِزْنَ فَتُعْجَزْنَ  .","","Al-Mu'jam al-Kabir 12673","","عبد الله بن عباس عن عطية بن سعد العوفي عن سوار بن مصعب المؤذن عن صالح بن مالك الخوارزمي عن محمد بن الفضل بن جابر السقطى عن الطبراني","عطية العوفي عن ابن عباس"
"12708","12674  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْبَاقِي الْمِصِّيصِيُّ  ، ثَنَا  عَمْرُو بْنُ عُثْمَانَ الْحِمْصِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  مُبَشِّرِ بْنِ عُبَيْدٍ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَطِيَّةَ الْعَوْفِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَرْكَعُ قَبْلَ الْجُمُعَةِ أَرْبَعًا ،  وَبَعْدَهَا أَرْبَعًا لَا يَفْصِلُ بَيْنَهُنَّ  .","","Al-Mu'jam al-Kabir 12674","","عبد الله بن عباس عن عطية بن سعد العوفي عن حجاج بن أرطاة عن مبشر بن عبيد الحمصي عن بقية بن الوليد عن عمرو بن عثمان بن سعيد الحمصي عن يحيى بن عبد الباقي الثغري عن الطبراني","عطية العوفي عن ابن عباس"
"12709","12675  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  أَحْمَدُ بْنُ طَارِقٍ الْوَابِشِيُّ ،  ثَنَا  عَمْرُو بْنُ عَطِيَّةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَخْرَجَهُ إِلَى  بَدْرٍ  :  إِنَّ اللهَ عَزَّ وَجَلَّ قَدْ وَعَدَنِي  بَدْرًا  ، وَأَنْ يُغْنِمَنِي عَسْكَرَهُمْ  ، وَمَنْ قَتَلَ قَتِيلًا فَلَهُ كَذَا وَكَذَا مِنْ غَنَائِمِهِمْ إِنْ شَاءَ اللهُ ، وَمَنْ أَسَرَ أَسِيرًا فَلَهُ كَذَا وَكَذَا مِنْ غَنَائِمِهِمْ إِنْ شَاءَ اللهُ "" ، فَلَمَّا تَوَافَقُوا قَذَفَ اللهُ فِي قُلُوبِ الْمُشْرِكِينَ الرُّعْبَ ، فَلَمَّا اقْتَتَلُوا هَزَمَهُمُ اللهُ ، فَاتَّبَعَهُمْ  سَرَعَانُ  النَّاسِ فَقَتَلُوا سَبْعِينَ ، وَأَسَرُوا سَبْعِينَ  .","","Al-Mu'jam al-Kabir 12675","","عبد الله بن عباس عن عطية بن سعد العوفي عن عمرو بن جميع العوفي عن أحمد بن طارق الوابشي عن محمد بن عثمان بن أبي شيبة عن الطبراني","عطية العوفي عن ابن عباس"
"12710","[12/130]      [  حَبِيبُ بْنُ أَبِي ثَابِتٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12676  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ عِيسَى الرَّمْلِيُّ ،  عَنْ  عُبَيْدَةَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا صَامَ مَنْ صَامَ الْأَبَدَ  .","","Al-Mu'jam al-Kabir 12676","","عبد الله بن عباس عن حبيب بن أبي ثابت الكاهلي عن عبيدة بن معتب الضبي عن يحيى بن عيسى النهشلي عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","حبيب بن أبي ثابت عن ابن عباس"
"12711","12677  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُصَرِّفُ بْنُ عَمْرٍو الْيَامِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  حُصَيْنٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  جَاءَ  أَعْرَابِيٌّ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ، وَاللهِ لَقَدْ جِئْتُكَ مِنْ عِنْدِ قَوْمٍ مَا يَتَزَوَّدُ لَهُمْ رَاعٍ ، وَلَا  يَخْطِرُ  لَهُمْ فَحْلٌ ، فَصَعِدَ الْمِنْبَرَ ، فَحَمِدَ اللهَ ، ثُمَّ قَالَ :  اللَّهُمَّ اسْقِنَا غَيْثًا مُغِيثًا  مَرِيعًا  غَدَقًا  طَبَقًا  عَاجِلًا غَيْرَ  رَائِثٍ  ثُمَّ نَزَلَ فَمَا يَأْتِينَا أَحَدٌ مِنْ وَجْهٍ مِنَ الْوُجُوهِ إِلَّا قَالَ : قَدْ أُحْيِينَا  .","","Al-Mu'jam al-Kabir 12677","","عبد الله بن عباس عن حبيب بن أبي ثابت الكاهلي عن حصين بن عبد الرحمن السلمي عن عبد الله بن إدريس الأودي عن مصرف بن عمرو بن السري الهمداني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","حبيب بن أبي ثابت عن ابن عباس"
"12712","12678  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ بْنِ أَبِي إِسْرَائِيلَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَكَّةُ  حَرَمُ اللهِ الْمُحَرَّمُ لَا يُخْتَلَى  خَلَاهَا ،  وَلَا  يُعْضَدُ  شَجَرُهَا  ، وَلَا يُخَافُ وَحْشُهَا "" قَالَ  الْعَبَّاسُ  : يَا رَسُولَ اللهِ ، إِلَّا  الْإِذْخِرَ  فَإِنَّهُ لِقَيْنِنَا ، وَلِظُهُورِ بُيُوتِنَا ، قَالَ : "" إِلَّا  الْإِذْخِرَ  .","","Al-Mu'jam al-Kabir 12678","","عبد الله بن عباس عن حبيب بن أبي ثابت الكاهلي عن محمد بن جابر بن سيار عن إسحاق بن أبي إسرائيل عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","حبيب بن أبي ثابت عن ابن عباس"
"12713","[12/131]      12679  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  عَطَاءُ بْنُ مُسْلِمٍ الْحَلَبِيُّ ،  ثَنَا  الْعَلَاءُ بْنُ الْمُسَيِّبِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  أَهْدَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى أَبِي بَكَارَةً فَاسْتَصْغَرَهَا ، ثُمَّ قَالَ لِي : انْطَلِقْ بِهَا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَا بُنَيَّ ، فَقُلْ : إِنَّا قَوْمٌ نَعْمَلُ فَإِنْ كَانَ عِنْدَكَ أَسَنُّ مِنْهَا فَابْعَثْ بِهَا إِلَيْنَا ، فَأَتَيْتُ بِهَا ، فَقَالَ : "" ابْنَ عَمِّي ، وَجِّهْهَا إِلَى إِبِلِ الصَّدَقَةِ "" ، ثُمَّ أَتَيْتُهُ فِي الْمَسْجِدِ فَصَلَّيْتُ مَعَهُ الْعِشَاءَ ، فَقَالَ : "" مَا تُرِيدُ أَنْ تَبِيتَ عِنْدَ خَالَتِكَ اللَّيْلَةَ ؟ قَدْ أَمْسَيْتَ "" فَوَافَقْتُ لَيْلَتَهَا مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَتَيْتُهَا فَعَشَّتْنِي وَوَطَّأَتْ لِي عَبَاءَةً بِأَرْبَعَةٍ ، فَافْتَرَشْتُهَا ، فَقُلْتُ : لَأَعْلَمَنَّ مَا يَعْمَلُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ اللَّيْلَةَ ، فَدَخَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" يَا  مَيْمُونَةُ  "" ، قَالَتْ : لَبَّيْكَ يَا رَسُولَ اللهِ ، قَالَ : "" مَا أَتَاكِ ابْنُ أُخْتِكِ ؟ "" قَالَتْ : بَلَى ، هُوَ هَذَا ، قَالَ : "" أَفَلَا عَشَّيْتِيهِ إِنْ كَانَ عِنْدَكِ شَيْءٌ ؟ "" قَالَتْ : قَدْ فَعَلْتُ . قَالَ : "" فَوَطِئْتِ لَهُ ؟ "" قَالَتْ : نَعَمْ ، فَمَالَ إِلَى فِرَاشِهِ فَلَمْ يَضْطَجِعْ عَلَيْهِ ، وَاضْطَجَعَ حَوْلَهُ ، وَوَضَعَ رَأْسَهُ عَلَى الْفِرَاشِ فَمَكَثَ سَاعَةً ، فَسَمِعْتُهُ قَدْ نَفَخَ فِي النَّوْمِ ، فَقُلْتُ : نَامَ وَلَيْسَ بِالْمُسْتَيْقِظِ ، وَلَيْسَ بِقَائِمٍ اللَّيْلَةَ ، ثُمَّ قَامَ حَيْثُ قُلْتُ ذَهَبَ الرُّبُعُ الثُّلُثُ مِنَ اللَّيْلِ ، فَأَتَى سِوَاكًا لَهُ وَمَطْهَرَةً فَاسْتَاكَ حَتَّى سَمِعْتُ صَرِيرَ ثَنَايَاهُ تَحْتَ السِّوَاكِ ، وَهُوَ يَتْلُو هَؤُلَاءِ الْآيَاتِ         {      إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالأَرْضِ         }             [12/132]      ثُمَّ وَضَعَ السِّوَاكَ ، ثُمَّ قَامَ إِلَى قِرْبَةٍ ، فَحَلَّ  شِنَاقَهَا  ، فَأَرَدْتُ أَنْ أَقُومَ فَأَصُبَّ عَلَيْهِ ، فَخَشِيتُ أَنْ يَذَرَ شَيْئًا مِنْ عَمَلِهِ ، فَلَمَّا تَوَضَّأَ دَخَلَ مَسْجِدَهُ فَصَلَّى أَرْبَعَ رَكَعَاتٍ ، فَقَرَأَ فِي كُلِّ رَكْعَةٍ مِقْدَارَ خَمْسِينَ آيَةً يُطِيلُ فِيهَا الرُّكُوعَ وَالسُّجُودَ ، ثُمَّ جَاءَ إِلَى مَكَانِهِ الَّذِي كَانَ عَلَيْهِ فَاضْطَجَعَ هَوِيًّا فَنَفَخَ وَهُوَ نَائِمٌ ، فَقُلْتُ : لَيْسَ بِقَائِمٍ اللَّيْلَةَ حَتَّى يُصْبِحَ ، فَلَمَّا ذَهَبَ ثُلُثَا اللَّيْلِ أَوْ نِصْفُهُ أَوْ قَدْرُ ذَلِكَ قَامَ فَصَنَعَ مِثْلَ ذَلِكَ ، فَدَخَلَ مَسْجِدَهُ فَصَلَّى أَرْبَعَ رَكَعَاتٍ عَلَى قَدْرِ ذَلِكَ ، ثُمَّ جَاءَ إِلَى مَضْجَعِهِ فَاتَّكَأَ عَلَيْهِ فَنَفَخَ ، فَقُلْتُ : ذَهَبَ بِهِ النَّوْمُ لَيْسَ بِقَائِمٍ حَتَّى يُصْبِحَ ، ثُمَّ قَامَ حِينَ بَقِيَ سُدُسُ اللَّيْلِ أَوْ أَقَلُّ فَاسْتَاكَ ، ثُمَّ تَوَضَّأَ ثُمَّ دَخَلَ مَسْجِدَهُ فَكَبَّرَ فَافْتَتَحَ بِفَاتِحَةِ الْكِتَابِ ثُمَّ قَرَأَ :         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      ثُمَّ رَكَعَ وَسَجَدَ ، ثُمَّ قَامَ فَقَرَأَ بِفَاتِحَةِ الْكِتَابِ ، ثُمَّ قَرَأَ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      ثُمَّ رَكَعَ وَسَجَدَ ، ثُمَّ قَامَ فَقَرَأَ بِفَاتِحَةِ الْكِتَابِ ، وَ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ، ثُمَّ رَكَعَ وَسَجَدَ ، ثُمَّ قَامَ بِفَاتِحَةِ الْكِتَابِ ،         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ثُمَّ رَكَعَ وَسَجَدَ ، ثُمَّ قَامَ فَقَرَأَ بِفَاتِحَةِ اَلْكِتَابِ وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      ، ثُمَّ قَنَتَ فَرَكَعَ وَسَجَدَ ، فَلَمَّا فَرَغَ قَعَدَ حَتَّى إِذَا مَا طَلَعَ الْفَجْرُ نَادَانِي قُلْتُ : لَبَّيْكَ يَا رَسُولَ اللهِ ، قَالَ : قُمْ ، فَوَاللهِ مَا كُنْتَ بِنَائِمٍ ، فَقُمْتُ وَتَوَضَّأْتُ ، وَصَلَّيْتُ خَلْفَهُ فَقَرَأَ بِفَاتِحَةِ الْكِتَابِ ، وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      ، ثُمَّ رَكَعَ وَسَجَدَ ، ثُمَّ قَامَ فِي الثَّانِيَةِ فَقَرَأَ بِفَاتِحَةِ الْكِتَابِ ، وَ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      فَلَمَّا سَلَّمَ سَمِعْتُهُ يَقُولُ :  اللَّهُمَّ اجْعَلْ فِي قَلْبِي  نُورًا  ، وَفِي سَمْعِي  نُورًا  ، وَفِي بَصَرِي  نُورًا  ، وَمِنْ بَيْنِ يَدَيَّ  نُورًا  ، وَمِنْ خَلْفِي  نُورًا  ، وَعَنْ يَمِينِي  نُورًا  ، وَعَنْ شِمَالِي  نُورًا  ، وَمِنْ فَوْقِي نُورًا ، وَمِنْ تَحْتِي نُورًا ، وَأَعْظِمْ لِي نُورًا يَا رَبَّ الْعَالَمِينَ  .","","Al-Mu'jam al-Kabir 12679","","عبد الله بن عباس عن حبيب بن أبي ثابت الكاهلي عن علاء بن المسيب عن عطاء بن مسلم عن هشام بن عمار عن الحسن بن علي بن شبيب المعمري عن الطبراني","حبيب بن أبي ثابت عن ابن عباس"
"12714","[12/133]      12680  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ الْأَنْمَاطِيُّ  ، ثَنَا  عُبَيْدُ بْنُ جَنَّادٍ الْحَلَبِيُّ ،  ثَنَا  عَطَاءُ بْنُ مُسْلِمٍ ،  عَنِ  الْعَلَاءِ بْنِ الْمُسَيِّبِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا صَلَّى عَلَى الْمَيِّتِ قَالَ :  اللَّهُمَّ اغْفِرْ لِحَيِّنَا وَمَيِّتِنَا ، وَشَاهِدِنَا وَغَائِبِنَا ، وَلِإِنَاثِنَا وَلِذُكُورِنَا  ، مَنْ أَحْيَيْتَهُ مِنَّا فَأَحْيِهِ عَلَى الْإِسْلَامِ ، وَمَنْ تَوَفَّيْتَهُ مِنَّا فَتَوَفَّهُ عَلَى الْإِيمَانِ ، اللَّهُمَّ  عَفْوَكَ  عَفْوَكَ  .","","Al-Mu'jam al-Kabir 12680","","عبد الله بن عباس عن حبيب بن أبي ثابت الكاهلي عن علاء بن المسيب عن عطاء بن مسلم عن عبيد بن جناد الرقي عن محمد بن الحسين الأنماطي عن الطبراني","حبيب بن أبي ثابت عن ابن عباس"
"12715","12681  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مِهْرَانَ الْحَمَّالُ ،  ثَنَا  عَطَاءُ بْنُ مُسْلِمٍ الْخَفَّافُ ،  عَنِ  الْعَلَاءِ بْنِ الْمُسَيِّبِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قُتِلَ  قَتِيلٌ  عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يُعْلَمُ قَاتِلُهُ ، فَصَعِدَ مِنْبَرَهُ ، فَقَالَ :  يَا أَيُّهَا النَّاسُ أَيُقْتَلُ قَتِيلٌ وَأَنَا بَيْنَ أَظْهُرِكُمْ لَا يُعْلَمُ مَنْ قَتَلَهُ  ، لَوْ أَنَّ أَهْلَ السَّمَاءِ وَالْأَرْضِ اجْتَمَعُوا عَلَى قَتْلِ امْرِئٍ مُسْلِمٍ لَعَذَّبَهُمُ اللهُ بِلَا عَدَدٍ ، وَلَا حِسَابٍ  .","","Al-Mu'jam al-Kabir 12681","","عبد الله بن عباس عن حبيب بن أبي ثابت الكاهلي عن علاء بن المسيب عن عطاء بن مسلم عن محمد بن مهران الجمال عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","حبيب بن أبي ثابت عن ابن عباس"
"12716","12682  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَوْنُ بْنُ سَلَّامٍ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عَبَّاسٍ :         {      وَهُمْ يَنْهَوْنَ عَنْهُ وَيَنْأَوْنَ عَنْهُ         }      نَزَلَتْ فِي  أَبِي طَالِبٍ  كَانَ يَنْهَى عَنْ أَذَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، وَيَنْأَى عَنِ اتِّبَاعِهِ  ""  .","","Al-Mu'jam al-Kabir 12682","","عبد الله بن عباس عن حبيب بن أبي ثابت الكاهلي عن قيس بن الربيع الأسدي عن عون بن سلام الهاشمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","حبيب بن أبي ثابت عن ابن عباس"
"12717","12683  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  الْقَاسِمُ بْنُ         [12/134]      دِينَارٍ ،  ثَنَا  عُبَيْدُ بْنُ سَعِيدٍ الْقُرَشِيُّ ،  عَنْ  سُفْيَانَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قَالَ  رَجُلٌ  :  يَا رَسُولَ اللهِ ، إِنَّ أَبِي مَاتَ  أَفَأَعْتِقُ  عَنْهُ ؟ قَالَ : "" نَعَمْ  .","","Al-Mu'jam al-Kabir 12683","","عبد الله بن عباس عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن عبيد بن سعيد بن أبان القرشي عن القاسم بن زكريا الطحان عن الحسين بن إسحاق التستري عن الطبراني","حبيب بن أبي ثابت عن ابن عباس"
"12718","12684  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ خَالِدٍ الرَّقِّيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  بَعَثَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَيْشًا فَرُدَّتْ رَايَتُهُ  ، ثُمَّ بَعَثَ فَرُدَّتْ بِغُلُولِ رَأْسِ غَزَالٍ مِنْ ذَهَبٍ "" فَنَزَلَتْ :         {      وَمَا كَانَ لِنَبِيٍّ أَنْ يَغُلَّ         }      .","","Al-Mu'jam al-Kabir 12684","","عبد الله بن عباس عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن معاوية بن هشام القصار عن عبد الرحمن بن خالد القطان عن عبد الله بن أحمد الجواليقي عن الطبراني","حبيب بن أبي ثابت عن ابن عباس"
"12719","12685  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  رِزْقُ اللهِ بْنُ مُوسَى ،  ثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ نُصَيْرٍ الْعَبِيرِيُّ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  إِنَّمَا  نَهَى عَنِ  الْمُصْمَتِ  حَرِيرًا  .","","Al-Mu'jam al-Kabir 12685","","عبد الله بن عباس عن حبيب بن أبي ثابت الكاهلي عن أبو نصير محمد بن نصير عن يعقوب بن إسحاق بن زيد الحضرمي عن رزق الله بن موسى الناجي عن الحسن بن علي بن شبيب المعمري عن الطبراني","حبيب بن أبي ثابت عن ابن عباس"
"12720","12686  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْجَارُودِيُّ الْأَصْبَهَانِيُّ  ، ثَنَا  أَسِيدُ بْنُ عَاصِمٍ ،  ثَنَا  عَامِرُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  يَعْقُوبُ ،  عَنْ  عَنْبَسَةَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  إِنَّ لِلهِ جُلَسَاءَ يَوْمَ الْقِيَامَةِ ، عَنْ يَمِينِ الْعَرْشِ ،  وَكِلْتَا يَدَيِ اللهِ يَمِينٌ ، عَلَى مَنَابِرَ مِنْ نُورٍ ، وُجُوهُهُمْ مِنْ نُورٍ لَيْسُوا بِأَنْبِيَاءَ ، وَلَا شُهَدَاءَ ، وَلَا صِدِّيقِينَ "" قِيلَ : يَا رَسُولَ اللهِ ، مَنْ هُمْ ؟ قَالَ : "" الْمُتَحَابُّونَ بِجَلَالِ اللهِ تَعَالَى  .","","Al-Mu'jam al-Kabir 12686","","عبد الله بن عباس عن حبيب بن أبي ثابت الكاهلي عن عنبسة بن سعيد بن الضريس عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن عامر بن إبراهيم الأصبهاني عن أسيد بن عاصم الأصبهاني عن الجارودي أحمد بن علي الأصبهاني عن الطبراني","حبيب بن أبي ثابت عن ابن عباس"
"12721","[  أَبُو الْبَخْتَرِيِّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12687  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،         [12/135]      ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  حُصَيْنٍ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي الْبَخْتَرِيِّ قَالَ :  خَرَجْنَا حُجَّاجًا ، فَلَمَّا نَزَلْنَا  بِبَطْنِ نَخْلٍ  رَأَيْنَا الْهِلَالَ ، فَقَالَ  بَعْضُ الْقَوْمِ  : هُوَ ابْنُ ثَلَاثٍ ، وَقَالَ بَعْضُهُمْ : هُوَ ابْنُ لَيْلَتَيْنِ ،  فَأَتَيْنَا  ابْنَ عَبَّاسٍ فَقُلْنَا : إِنَّا رَأَيْنَا الْهِلَالَ ، فَقَالَ بَعْضُ  الْقَوْمِ  : هُوَ ابْنُ ثَلَاثٍ ، وَقَالَ بَعْضُ  الْقَوْمِ  : هُوَ ابْنُ لَيْلَتَيْنِ ، فَقَالَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَدَّهُ لِرُؤْيَتِهِ فَهُوَ لَيْلَةَ رَأَيْتُمُوهُ  .","","Al-Mu'jam al-Kabir 12687","","عبد الله بن عباس عن سعيد بن فيروز الطائي عن عمرو بن مرة المرادي عن حصين بن عبد الرحمن السلمي عن محمد بن فضيل بن غزوان عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو البختري عن ابن عباس"
"12722","12688  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، وَسُلَيْمَانُ بْنُ حَرْبٍ ، قَالَا :  ثَنَا  شُعْبَةُ ،  أَخْبَرَنِي  عَمْرُو بْنُ مُرَّةَ ،  عَنْ  أَبِي الْبَخْتَرِيِّ قَالَ :  سَأَلْتُ  ابْنَ عَبَّاسٍ عَنِ  السَّلَمِ  فِي النَّخْلِ ، فَقَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ النَّخْلِ حَتَّى يُؤْكَلَ مِنْهُ ، وَحَتَّى يُؤْوَى  قُلْتُ : مَا يُؤْوَى ؟ فَقَالَ رَجُلٌ مِنَ  الْقَوْمِ  : "" حَتَّى يُجْرَزَ أَوْ يُحْرَزَ  ""  .","","Al-Mu'jam al-Kabir 12688","","عبد الله بن عباس عن سعيد بن فيروز الطائي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","أبو البختري عن ابن عباس"
"12723","[  طَرِيفُ بْنُ مَيْمُونٍ  عَنِ  ابْنِ عَبَّاسٍ  ]  12689  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ  ، ثَنَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ ،  ثَنَا  الْمُحَارِبِيُّ  أَنَّهُ سَمِعَ  الْأَعْمَشَ  ذَكَرَ عَنْ  طَرِيفِ بْنِ مَيْمُونٍ ،  عَنِ  ابْنِ عَبَّاسٍ  يَرْفَعُهُ  قَالَ :  مَا مِنْ رَجُلٍ وَلِيَ عَشَرَةً إِلَّا أُتِيَ بِهِ يَوْمَ الْقِيَامَةِ مَغْلُولَةً يَدُهُ إِلَى عُنُقِهِ  حَتَّى يُقْضَى بَيْنَهُ وَبَيْنَهُمْ  "" .","","Al-Mu'jam al-Kabir 12689","","عبد الله بن عباس عن طريف بن ميمون عن الأعمش عن عبد الرحمن بن محمد المحاربي عن يحيى بن سليمان بن يحيى عن أحمد بن محمد بن الحجاج المصري عن الطبراني","طريف بن ميمون عن ابن عباس"
"12724","[12/136]      [  يَحْيَى بْنُ وَثَّابٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12690  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ،  ثَنَا  أَبُو بَكْرٍ النَّهْشَلِيُّ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  يَحْيَى بْنِ وَثَّابٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يُصَلِّي مِنَ اللَّيْلِ ثَمَانَ رَكَعَاتٍ ، وَيُوتِرُ بِثَلَاثٍ  .","","Al-Mu'jam al-Kabir 12690","","عبد الله بن عباس عن يحيى بن وثاب الأصبهاني عن حبيب بن أبي ثابت الكاهلي عن أبو بكر النهشلي عن أبو بلال الأشعري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","يحيى بن وثاب عن ابن عباس"
"12725","12691  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ،  ثَنَا  يَحْيَى بْنُ الْعَلَاءِ ،  عَنْ  عُمَرَ بْنِ الصُّبْحِ ،  عَنْ  مُقَاتِلِ بْنِ حَيَّانَ ،  عَنْ  يَحْيَى بْنِ وَثَّابٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سَمِعَ صَوْتَ نَاقُوسٍ ، أَوْ دَخَلَ كَنِيسَةً أَوْ بَيْعَةً أَوْ بَيْتَ نَارٍ أَوْ أَصْنَامٍ  ، فَقَالَ : لَا إِلَهَ إِلَّا اللهُ ، وَلَا نَعْبُدُ إِلَّا اللهَ ، كَتَبَ اللهُ لَهُ مِنَ الْأَجْرِ عَدَدَ مَنْ لَمْ يَقُلْهَا أَوْ كُتِبَ عِنْدَ اللهِ صَدِّيقًا  .","","Al-Mu'jam al-Kabir 12691","","عبد الله بن عباس عن يحيى بن وثاب الأصبهاني عن مقاتل بن حيان عن عمر بن الصبح السمرقندي عن يحيى بن العلاء الفوراردي عن أبو بلال الأشعري عن عمر بن حفص السدوسي عن الطبراني","يحيى بن وثاب عن ابن عباس"
"12726","[  الْعَيْزَارُ بْنُ حُرَيْثٍ  عَنِ  ابْنِ عَبَّاسٍ  ]  12692  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ، وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَا :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ قَالَ :  ثَنَا  أَبِي  ، قَالَا :  ثَنَا  حُبَيْبُ بْنُ حَبِيبٍ أَخُو حَمْزَةَ الزَّيَّاتِ  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْعَيْزَارِ بْنِ         [12/137]      حُرَيْثٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَقَامَ الصَّلَاةَ ، وَآتَى الزَّكَاةَ ، وَحَجَّ  الْبَيْتَ  ،  وَصَامَ رَمَضَانَ ، وَقَرَى الضَّيْفَ دَخَلَ الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 12692","","عبد الله بن عباس عن العيزار بن حريث العبدي عن أبو إسحاق السبيعي عن حبيب بن حبيب الكوفي عن أبو بكر ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","العيزار بن حريث عن ابن عباس"
"12727","12693  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ الْقَاضِي  ، ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ الْعَمِّيُّ ،  ثَنَا  سَلْمُ بْنُ قُتَيْبَةَ ،  عَنْ  يُونُسَ بْنِ أَبِي إِسْحَاقَ ،  عَنِ  الْوَلِيدِ بْنِ الْعَيْزَارِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قَالَ  أَبُو جَهْلٍ  : لَئِنْ عَادَ  مُحَمَّدٌ  يُصَلِّي خَلْفَ  الْمَقَامِ  لَأَسْطُوَنَّ بِهِ ، فَقِيلَ : هُوَ ذَاكَ يُصَلِّي خَلْفَ  الْمَقَامِ  ، فَانْطَلَقَ نَحْوَهُ ، ثُمَّ رَجَعَ ، فَقَالَ :  وَاللَّاتِ  وَالْعُزَّى لَقَدْ أَظْلَمَ بَيْنِي وَبَيْنَهُ مِنَ الْكَتَائِبِ ، قَالَ  ابْنُ عَبَّاسٍ  :  لَوْ تَحَرَّكَ لَأَخَذَتْهُ الزَّبَانِيَةُ "" ثُمَّ قَرَأَ :         {      فَلْيَدْعُ نَادِيَهُ             *          سَنَدْعُ الزَّبَانِيَةَ         }      .","","Al-Mu'jam al-Kabir 12693","","عبد الله بن عباس عن الوليد بن العيزار بن حريث العبدي عن يونس بن أبي إسحاق عن سلم بن قتيبة الشعيري عن عقبة بن مكرم عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","العيزار بن حريث عن ابن عباس"
"12728","[  أَبُو الْجُوَيْرِيَةِ الْجَرْمِيُّ  عَنِ  ابْنِ عَبَّاسٍ  ]  12694  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ  ، ثَنَا  عُبَيْدُ بْنُ إِسْحَاقَ الْعَطَّارُ ،  ثَنَا  زُهَيْرٌ ،  عَنْ  أَبِي الْجُوَيْرِيَةِ الْجَرْمِيِّ قَالَ :  سَأَلْتُ  ابْنَ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ عَنِ  الْبَاذَقِ  ، فَقَالَ :  سَبَقَ  مُحَمَّدٌ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْبَاذَقَ  مَا أَسْكَرَ فَهُوَ حَرَامٌ  .","","Al-Mu'jam al-Kabir 12694","","عبد الله بن عباس عن حطان بن خفاف الجرمي عن زهير بن معاوية بن حديج عن عبيد بن إسحاق عطار المطلقات عن لحية الليف محمد بن العباس عن الطبراني","أبو الجويرية الجرمي عن ابن عباس"
"12729","12695  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ  ، ثَنَا  عُبَيْدُ بْنُ إِسْحَاقَ الْعَطَّارُ ،  ثَنَا  زُهَيْرٌ ،  عَنْ  أَبِي الْجُوَيْرِيَةِ الْجَرْمِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  أَتَدْرِي فِيمَ نَزَلَتْ هَذِهِ الْآيَةُ         {      يَا أَيُّهَا الَّذِينَ آمَنُوا لا تَسْأَلُوا عَنْ أَشْيَاءَ إِنْ تُبْدَ لَكُمْ تَسُؤْكُمْ         }      ؟         [12/138]      كَانَ أُنَاسٌ يَسْأَلُونَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ اسْتِهْزَاءً ، يَقُولُ الرَّجُلُ : مَنْ أَبِي  ؟ وَيَقُولُ : ضَلَّتْ نَاقَتِي أَيْنَ نَاقَتِي ؟ فَأَنْزَلَ اللهُ هَذِهِ الْآيَةَ  "" .","","Al-Mu'jam al-Kabir 12695","","عبد الله بن عباس عن حطان بن خفاف الجرمي عن زهير بن معاوية بن حديج عن عبيد بن إسحاق عطار المطلقات عن لحية الليف محمد بن العباس عن الطبراني","أبو الجويرية الجرمي عن ابن عباس"
"12730","[  الْحَسَنُ الْعُرَنِيُّ  عَنِ  ابْنِ عَبَّاسٍ  ]  12696  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  يَحْيَى أَبِي الْمُعَلَّى الْعَطَّارِ ،  عَنِ  الْحَسَنِ الْعُرَنِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا يُصَلِّي ، وَذَهَبَ  جَدْيٌ  يَمُرُّ بَيْنَ يَدَيْهِ فَبَادَرَهُ  ، وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي وَحِمَارَةٌ  لِلْفَضْلِ بْنِ الْعَبَّاسِ  تَرْتَعُ يَوْمَئِذٍ بَيْنَ يَدَيْهِ  .","","Al-Mu'jam al-Kabir 12696","","عبد الله بن عباس عن الحسن بن عبد الله العرني عن يحيى بن ميمون العطار عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","الحسن العرني عن ابن عباس"
"12731","12697  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْحُسَيْنِ الْمِصِّيصِيُّ ، وَأَبُو زُرْعَةَ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ بَكَّارِ بْنِ بِلَالٍ ،  ثَنَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  مَنْصُورِ بْنِ زَاذَانَ ،  عَنِ  الْحَكَمِ ،  عَنِ  الْحَسَنِ الْعُرَنِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى الظُّهْرَ خَمْسًا  ، فَسَجَدَ سَجْدَتَيِ  الْوَهْمِ  ، وَهُوَ جَالِسٌ  .","","Al-Mu'jam al-Kabir 12697","","عبد الله بن عباس عن الحسن بن عبد الله العرني عن الحكم بن عتيبة الكندي عن منصور بن زاذان الثقفي عن سعيد بن بشير الأزدي عن محمد بن بكار العاملي عن أبو زرعة الدمشقي عن الطبراني","الحسن العرني عن ابن عباس"
"12732","12698  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  يَحْيَى بْنُ سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْحَسَنِ الْعُرَنِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  أَرْدَفَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [12/139]      أُسَامَةَ بْنَ زَيْدٍ  يَوْمَ عَرَفَةَ  حَتَّى بَلَغَ  جَمْعًا  ثُمَّ أَرْدَفَ  الْفَضْلَ  حَتَّى بَلَغَ جَمْرَةَ الْعَقَبَةِ فَلَمْ يَزَلْ يُلَبِّي حَتَّى رَمَى جَمْرَةَ الْعَقَبَةِ  .","","Al-Mu'jam al-Kabir 12698","","عبد الله بن عباس عن الحسن بن عبد الله العرني عن سلمة بن كهيل الحضرمي عن يحيى بن سلمة بن كهيل عن إسماعيل بن عمرو البجلي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","الحسن العرني عن ابن عباس"
"12733","12699  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنِ  الْحَسَنِ الْعُرَنِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قَدَّمَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لَيْلَةَ الْمُزْدَلِفَةِ  أُغَيْلِمَةَ  بَنِي عَبْدِ الْمُطَّلِبِ  عَلَى  حُمُرَاتٍ  فَجَعَلَ يَلْطَخُ أَفْخَاذَنَا وَيَقُولُ :  أَبَنِيَّ لَا تَرْمُوا  الْجَمْرَةَ  حَتَّى تَطْلُعَ الشَّمْسُ  .","","Al-Mu'jam al-Kabir 12699","","عبد الله بن عباس عن الحسن بن عبد الله العرني عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","الحسن العرني عن ابن عباس"
"12734","12700  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنِ  الْحَسَنِ الْعُرَنِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  مَا أَدْرِي أَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَقْرَأُ  فِي الظُّهْرِ وَالْعَصْرِ أَمْ لَا  ؟ وَلَكِنَّا نَقْرَأُ  ""  .","","Al-Mu'jam al-Kabir 12700","","عبد الله بن عباس عن الحسن بن عبد الله العرني عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","الحسن العرني عن ابن عباس"
"12735","12701  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا  أَبُو شَيْبَةَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنِ  الْحَسَنِ الْعُرَنِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  عَجَّلَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِلَيْلٍ مِنْ  جَمْعٍ  إِلَى  مِنًى  ، وَحَمَلَنَا عَلَى الْحُمُرَاتِ ، وَجَعَلَ يَضْرِبُ أَفْخَاذَنَا ، وَيَقُولُ :  أَبَنِيَّ لَا تَرْمُوا جَمْرَةَ الْعَقَبَةِ حَتَّى تَطْلُعَ الشَّمْسُ  "" .","","Al-Mu'jam al-Kabir 12701","","عبد الله بن عباس عن الحسن بن عبد الله العرني عن سلمة بن كهيل الحضرمي عن إبراهيم بن عثمان أبو شيبة العبسي عن علي بن الجعد عن ابن الرازي محمد بن جعفر البغدادى عن الطبراني","الحسن العرني عن ابن عباس"
"12736","12702  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ، وَيَحْيَى بْنُ سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنِ  الْحَسَنِ الْعُرَنِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  قَدَّمَنَا رَسُولُ اللهِ صَلَّى         [12/140]      اللهُ عَلَيْهِ وَسَلَّمَ أُغَيْلِمَةَ  بَنِي عَبْدِ الْمُطَّلِبِ  عَلَى  حُمُرَاتٍ  يَلْطَخُ أَفْخَاذَنَا ، وَيَقُولُ :  أَبَنِيَّ لَا تَرْمُوا جَمْرَةَ الْعَقَبَةِ حَتَّى تَطْلُعَ الشَّمْسُ  "" .","","Al-Mu'jam al-Kabir 12702","","عبد الله بن عباس عن الحسن بن عبد الله العرني عن سلمة بن كهيل الحضرمي عن يحيى بن سلمة بن كهيل عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","الحسن العرني عن ابن عباس"
"12737","12703  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ كَيْسَانَ الْمِصِّيصِيُّ  ، ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنِ  الْحَسَنِ الْعُرَنِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  جِئْتُ أَنَا  وَغُلَامٌ مِنْ بَنِي عَبْدِ الْمُطَّلِبِ  عَلَى حِمَارٍ ، وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الصَّلَاةِ ،  فَأَرْسَلْنَا الْحِمَارَ ، وَدَخَلْنَا فِي الصَّفِّ ، وَجَاءَتْ جَارِيَتَانِ تَسْتَبِقَانِ فَفَرَّقَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَهُمَا  .","","Al-Mu'jam al-Kabir 12703","","عبد الله بن عباس عن الحسن بن عبد الله العرني عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن موسى بن مسعود النهدي عن محمد بن الحسن بن كيسان المصيصي عن الطبراني","الحسن العرني عن ابن عباس"
"12738","12704  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَبِي الْمُعَلَّى الْعَطَّارِ ،  عَنِ  الْحَسَنِ الْعُرَنِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّهُ ذُكِرَ عِنْدَهُ مَا يَقْطَعُ الصَّلَاةَ ، فَقَالَ : مَا تَقُولُونَ فِي  الْجَدْيِ  ؟ فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ يُصَلِّي فَمَرَّ  جَدْيٌ  بَيْنَ يَدَيْهِ ، فَبَادَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْقِبْلَةَ  ، وَلَقَدْ صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا ، وَإِنَّ حِمَارَةً  لِلْفَضْلِ بْنِ عَبَّاسٍ  تَرْعَى بَيْنَ يَدَيْهِ  .","","Al-Mu'jam al-Kabir 12704","","عبد الله بن عباس عن الحسن بن عبد الله العرني عن يحيى بن ميمون العطار عن حماد بن زيد عن محمد بن أبي بكر المقدمي عن عبد الله بن أحمد بن حنبل عن الطبراني","الحسن العرني عن ابن عباس"
"12739","12705  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنِ  الْحَسَنِ الْعُرَنِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  إِذَا رَمَيْتُمُ  الْجَمْرَةَ  فَقَدْ حَلَّ لَكُمْ كُلُّ شَيْءٍ إِلَّا النِّسَاءَ "" قَالَ :  وَأَمَّا أَنَا فَقَدْ رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يُضَمِّخُ  رَأْسَهُ بِالْمِسْكِ  ، أَفَطِيبٌ ذَاكَ أَمْ لَا ؟  "" .","","Al-Mu'jam al-Kabir 12705","","عبد الله بن عباس عن الحسن بن عبد الله العرني عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن محمد بن كثير العبدي عن معاذ بن المثنى العنبري عن الطبراني","الحسن العرني عن ابن عباس"
"12740","[12/141]      12706  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  سَعِيدُ بْنُ عَمْرٍو الْأَشْعَثِيُّ ،  ثَنَا  حَمَّادُ بْنُ شُعَيْبٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  الْحَسَنِ الْعُرَنِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  أَهْدَى  الصَّعْبُ بْنُ جَثَّامَةَ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ شِقَّةَ حِمَارِ وَحْشٍ ، فَرَدَّهَا عَلَيْهِ وَقَالَ :  إِنَّا حُرُمٌ  .","","Al-Mu'jam al-Kabir 12706","","عبد الله بن عباس عن الحسن بن عبد الله العرني عن حبيب بن أبي ثابت الكاهلي عن حماد بن شعيب الحماني عن سعيد بن عمرو بن سهل الأشعثي عن محمد بن عثمان بن أبي شيبة عن الطبراني","الحسن العرني عن ابن عباس"
"12741","[  مَطِيرٌ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12707  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  سَلْمُ بْنُ قُتَيْبَةَ ،  ثَنَا  مُوسَى بْنُ مُطَيْرٍ ،  حَدَّثَنِي  أَبِي  قَالَ :  شَهِدْتُ  ابْنَ عَبَّاسٍ يَقُولُ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْتَاكُ مِنَ اللَّيْلِ  مَرَّتَيْنِ أَوْ ثَلَاثًا  .","","Al-Mu'jam al-Kabir 12707","","عبد الله بن عباس عن مطير بن أبي خالد الكوفي عن موسى بن مطير الكوفي عن سلم بن قتيبة الشعيري عن محمد بن أبي بكر المقدمي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","مطير عن ابن عباس"
"12742","[  إِبْرَاهِيمُ التَّيْمِيُّ  عَنِ  ابْنِ عَبَّاسٍ  ]  12708  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ الْجَرْجَرَائِيُّ ،  ثَنَا  عَلِيُّ بْنُ ثَابِتٍ الْجَزَرِيُّ ،  عَنِ  الْمُخْتَارِ بْنِ نَافِعٍ ،  عَنْ  عَبْدِ الْأَعْلَى التَّيْمِيِّ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  جَاءَ  مَلَكُ الْمَوْتِ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فِي مَرَضِهِ الَّذِي قُبِضَ فِيهِ  ، فَاسْتَأْذَنَ وَرَأْسُهُ فِي حِجْرِ  عَلِيٍّ  ، فَقَالَ : السَّلَامُ عَلَيْكُمْ         [12/142]      وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ ، فَقَالَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ : ارْجِعْ فَإِنَّا مَشَاغِيلُ عَنْكَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَتَدْرِي مَنْ هَذَا يَا  أَبَا حَسَنٍ  ؟ هَذَا  مَلَكُ الْمَوْتِ  ادْخُلْ رَاشِدًا  فَلَمَّا دَخَلَ قَالَ : إِنَّ رَبَّكَ عَزَّ وَجَلَّ  يُقْرِئُكَ  السَّلَامَ قَالَ : "" أَيْنَ  جِبْرِيلُ  ؟ "" قَالَ : لَيْسَ هُوَ قَرِيبٌ مِنِّي الْآنَ يَأْتِي ، فَخَرَجَ  مَلَكُ الْمَوْتِ  حَتَّى نَزَلَ عَلَيْهِ  جِبْرِيلُ  ، فَقَالَ لَهُ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ وَهُوَ قَائِمٌ بِالْبَابِ : مَا أَخْرَجَكَ يَا  مَلَكَ الْمَوْتِ  ؟ قَالَ : الْتَمَسَكَ  مُحَمَّدٌ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا أَنْ جَلَسَا ، قَالَ  جِبْرِيلُ  : سَلَامٌ عَلَيْكَ يَا  أَبَا الْقَاسِمِ  هَذَا وَدَاعٌ مِنِّي وَمِنْكَ "" ، فَبَلَغَنِي أَنَّهُ لَمْ يُسَلِّمْ  مَلَكُ الْمَوْتِ  عَلَى أَهْلِ بَيْتٍ قَبْلَهُ ، وَلَا يُسَلِّمُ بَعْدَهُ  .","","Al-Mu'jam al-Kabir 12708","","عبد الله بن عباس عن إبراهيم بن يزيد بن شريك التيمي عن عبد الأعلى التيمي عن المختار بن نافع العكلي عن علي بن ثابت الجزري عن محمد بن الصباح الجرجرائي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","إبراهيم التيمي عن ابن عباس"
"12743","[  عَبْدُ اللهِ بْنُ أَبِي الْهُزَيْلِ  عَنِ  ابْنِ عَبَّاسٍ  ]  12709  -  حَدَّثَنِي  عِيسَى بْنُ الْقَاسِمِ الصَّيْدَلَانِيُّ الْبَغْدَادِيُّ  ، ثَنَا  الْحَسَنُ بْنُ قَزَعَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي الْهُزَيْلِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سَبَّ أَصْحَابِي فَعَلَيْهِ لَعْنَةُ اللهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ  .  كذا في طبعة مكتبة ابن تيمية ، وفي ثلاثة مواضع أخر عند المصنف ومن طريقه الضياء في المختارة ، ويروي في هذه المواضع عن ( عبد الرحمن بن بشر ، والحسن بن قزعة ) ، وفي الأوسط والصغير ورد في موضع : ( عيسى بن محمد ) وما في الأوسط أصله عيسى بن القاسم ، وغيره من الصغير ، ويروي فيهما عن ( محمد بن عقبة ) وقد ترجم الخطيب لـ ( عيسى بن محمد الصيدلاني ) يروي عن ( محمد بن عقبة ) ويروي عنه المصنف ولم يزد ولكنه ترجم أيضا لـ ( عيسى بن القاسم أبو موسى الصيدلاني ) يروي عن النضر بن طاهر البصري ، ويروي عنه ابن عدي ، فالله أعلم","","Al-Mu'jam al-Kabir 12709","","عبد الله بن عباس عن عبد الله بن أبي الهذيل الغنوي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن الحسن بن قزعة الخلقاني عن عيسى بن محمد الصيدلاني عن الطبراني","عبد الله بن أبي الهذيل عن ابن عباس"
"12744","12710  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي         [12/143]      الْهُزَيْلِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِيَأْكُلْ كُلُّ رَجُلٍ مِنْ أُضْحِيَّتِهِ  .","","Al-Mu'jam al-Kabir 12710","","عبد الله بن عباس عن عبد الله بن أبي الهذيل الغنوي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","عبد الله بن أبي الهذيل عن ابن عباس"
"12745","[  سَعِيدُ بْنُ شَفِيٍّ  عَنِ  ابْنِ عَبَّاسٍ  ]  12711  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي السَّفَرِ ،  عَنْ  سَعِيدِ بْنِ شَفِيٍّ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ إِذَا خَرَجَ مِنْ بَيْتِهِ صَلَّى رَكْعَتَيْنِ رَكْعَتَيْنِ حَتَّى يَرْجِعَ  .","","Al-Mu'jam al-Kabir 12711","","عبد الله بن عباس عن سعيد بن شفي الهمداني عن سعيد بن يحمد الهمداني عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سعيد بن شفي عن ابن عباس"
"12746","12712  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  يَاسِينُ بْنُ حَمَّادٍ الْمَخْزُومِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي السَّفَرِ (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدٍ أَنَّ عَبْدَ الْغَفَّارِ بْنَ الْقَاسِمِ  كَتَبَ إِلَيْهِ  أَنَّ أَبَا إِسْحَاقَ  حَدَّثَهُ  عَنْ  سَعِيدِ بْنِ شَفِيٍّ الْهَمْدَانِيِّ  قَالَ :  سَأَلْتُ  ابْنَ عَبَّاسٍ عَنِ الصَّلَاةِ فِي السَّفَرِ ، فَقَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" إِذَا خَرَجَ مِنْ أَهْلِهِ مُسَافِرًا صَلَّى رَكْعَتَيْنِ حَتَّى يَرْجِعَ إِلَى أَهْلِهِ  "" .  تصحفت في طبعة مكتبة ابن تيمية : ( الحهمداني ) وهي على الصواب في النسخ الخطية .","","Al-Mu'jam al-Kabir 12712","","عبد الله بن عباس عن سعيد بن شفي الهمداني عن أبو إسحاق السبيعي عن عبد الغفار بن القاسم الأنصاري عن عبد ربه بن سعيد النجاري عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","سعيد بن شفي عن ابن عباس"
"12747","[  عَابِسٌ  عَنِ  ابْنِ عَبَّاسٍ  ]  12713  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  حَجَّاجٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَابِسٍ ،  عَنْ         [12/144]      أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُخْرِجُ أَهْلَهُ فِي الْعِيدَيْنِ  .","","Al-Mu'jam al-Kabir 12713","","عبد الله بن عباس عن عابس بن ربيعة الغطيفي عن عبد الرحمن بن عابس النخعي عن حجاج بن أرطاة عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عابس عن ابن عباس"
"12748","12714  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  حَجَّاجٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَابِسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُخْرِجُ نِسَاءَهُ فِي الْعِيدَيْنِ  ""  .","","Al-Mu'jam al-Kabir 12714","","عبد الله بن عباس عن عابس بن ربيعة الغطيفي عن عبد الرحمن بن عابس النخعي عن حجاج بن أرطاة عن حفص بن غياث النخعي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عابس عن ابن عباس"
"12749","12715  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  حَجَّاجٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَابِسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُخْرِجُ نِسَاءَهُ فِي الْعِيدَيْنِ  .","","Al-Mu'jam al-Kabir 12715","","عبد الله بن عباس عن عابس بن ربيعة الغطيفي عن عبد الرحمن بن عابس النخعي عن حجاج بن أرطاة عن حفص بن غياث النخعي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عابس عن ابن عباس"
"12750","12716  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْخَضِرِ الْخُزَاعِيُّ الْمَرْوَزِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدَةَ الْمَرْوَزِيُّ ،  ثَنَا  أَبِي  ثَنَا  أَبُو حَمْزَةَ السُّكَّرِيُّ ،  عَنْ  رَقَبَةَ بْنِ مَصْقَلَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَابِسِ بْنِ رَبِيعَةَ النَّخَعِيِّ قَالَ :  سَأَلَ  رَجُلٌ  ابْنَ عَبَّاسٍ أَدْرَكْتَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ :  نَعَمْ أَدْرَكْتُهُ وَأَنَا غُلَامٌ ، وَكَانَ بُغْيَتُهُ أَنْ يَحْضُرَ عِيدًا ،  فَخَرَجَ ، فَأَمَرَ  بِعَنَزَةٍ  ، فَرُكِزَتْ لَهُ عِنْدَ دَارِ  كَثِيرِ بْنِ الصَّلْتِ  وَوَعَظَهُنَّ فَذَكَّرَهُنَّ بِآيٍ مِنَ الْقُرْآنِ ،         [12/145]      وَحَثَّهُنَّ عَلَى الصَّدَقَةِ ، فَرَأَيْتُهُنَّ يَهْوِينَ إِلَى آذَانِهِنَّ ، وَحُلُوقِهِنَّ لِيَدْفَعْنَ الصَّدَقَةَ إِلَى  بِلَالٍ  ثُمَّ رَجَعَ إِلَى أَهْلِهِ  .","","Al-Mu'jam al-Kabir 12716","","عبد الله بن عباس عن عبد الرحمن بن عابس النخعي عن رقبة بن مصقلة عن محمد بن ميمون أبو حمزة السكري عن عبدة بن الحكم المروزي عن محمد بن عبدة المروزي عن أحمد بن الخضر المروزي عن الطبراني","عابس عن ابن عباس"
"12751","[  عَبْدُ اللهِ الْبَهِيُّ  عَنِ  ابْنِ عَبَّاسٍ  ]  12717  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ،  ثَنَا  الْمُفَضَّلُ بْنُ صَدَقَةَ  ،  عَنْ  وَائِلِ بْنِ دَاوُدَ ،  عَنِ  الْبَهِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يُعْطِ الْكَوْدَنَ شَيْئًا  ، وَأَعْطَاهُ دُونَ  سَهْمِ  الْعُزَّابِ فِي الْقُوَّةِ وَالْجَوْدَةِ ،  وَالْكَوْدَنُ الْبِرْذَوْنُ الْبَطِيءُ  .  في طبعة مكتبة ابن تيمية : ( الفضل ) والمثبت من النسخ الخطية .","","Al-Mu'jam al-Kabir 12717","","عبد الله بن عباس عن عبد الله البهي مولى مصعب بن الزبير عن وائل بن داود التيمي عن المفضل بن صدقة الحنفي عن أبو بلال الأشعري عن محمد بن عثمان بن أبي شيبة عن الطبراني","عبد الله البهي عن ابن عباس"
"12752","[  أَبُو خَالِدٍ  عَنِ  ابْنِ عَبَّاسٍ  ]  12718  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ (  ح  ) .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  إِسْمَاعِيلَ بْنِ حَمَّادِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  أَبِي خَالِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ يَفْتَتِحُ الصَّلَاةَ بِـ         {      الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ         }      "" .","","Al-Mu'jam al-Kabir 12718","","عبد الله بن عباس عن أبو خالد الوالبي عن إسماعيل بن حماد بن أبي سليمان عن معتمر بن سليمان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو خالد عن ابن عباس"
"12753","[  عَمْرُو بْنُ عَبْدِ اللهِ بْنِ هِنْدٍ الْجَمَلِيُّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12719  -  حَدَّثَنَا  عُبَيْدُ بْنُ كَثِيرٍ التَّمَّارُ  ، ثَنَا  مُحَمَّدُ بْنُ الْجُنَيْدِ ،         [12/146]      ثَنَا  عِيَاضُ بْنُ سَعِيدٍ الثُّمَالِيُّ ،  عَنْ  عِيسَى بْنِ مُسْلِمٍ الْقُرَشِيِّ ،  عَنْ  عَمْرِو بْنِ عَبْدِ اللهِ بْنِ هِنْدٍ الْجَمَلِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَقُولُ اللهُ عَزَّ وَجَلَّ :  مَنْ عَادَى لِي وَلِيًّا فَقَدْ نَاصَبَنِي بِالْمُحَارَبَةِ  ، وَمَا تَرَدَّدْتُ عَنْ شَيْءٍ أَنَا فَاعِلُهُ كَتَرَدُّدِي عَنْ مَوْتِ الْمُؤْمِنِ يَكْرَهُ الْمَوْتَ وَأَكْرَهُ مَسَاءَتَهُ ، وَرُبَّمَا سَأَلَنِي وَلِيِّي الْمُؤْمِنُ الْغِنَى فَأَصْرِفُهُ مِنَ الْغِنَى إِلَى الْفَقْرِ ، وَلَوْ صَرَفْتُهُ إِلَى الْغِنَى لَكَانَ شَرًّا لَهُ ؛ إِنَّ اللهَ عَزَّ وَجَلَّ قَالَ : وَعِزَّتِي وَجَلَالِي وَعُلُوِّي وَبَهَائِي وَجَمَالِي وَارْتِفَاعِ مَكَانِي لَا يُؤْثِرُ عَبْدٌ هَوَايَ عَلَى هَوَى نَفْسِهِ إِلَّا أَثْبَتُّ أَجَلَهُ عِنْدَ بَصَرِهِ ، وَضَمِنَتِ السَّمَاءُ وَالْأَرْضُ رِزْقَهُ ، وَكُنْتُ لَهُ مِنْ وَرَاءِ تِجَارَةِ كُلِّ تَاجِرٍ  .","","Al-Mu'jam al-Kabir 12719","","عبد الله بن عباس عن عبد الله بن عمرو بن هند المرادي عن عيسى بن مسلم الطهوي عن عياض بن سعيد الثمالي عن محمد بن الجنيد عن عبيد بن كثير العامري عن الطبراني","عمرو بن عبد الله بن هند الجملي عن ابن عباس"
"12754","[  عَنْتَرَةُ  عَنِ  ابْنِ عَبَّاسٍ  ]  12720  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يُوسُفُ بْنُ قَيْسٍ  الْبَغْدَادِيُّ ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ هَارُونَ بْنِ عَنْتَرَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا أَفْطَرَ قَالَ : "" لَكَ صُمْتُ  ، وَعَلَى رِزْقِكَ أَفْطَرْتُ فَتَقَبَّلْ مِنِّي إِنَّكَ أَنْتَ السَّمِيعُ الْعَلِيمُ  "" .  كذا في طبعة مكتبة ابن تيمية والنسخ الخطية ، وإن كانت غير واضحة بصورة جيدة ، ولعل الصواب : (موسى) وهي محتملة في بعض النسخ ، وينظر مصادر التخريج ، والله أعلم .","","Al-Mu'jam al-Kabir 12720","","عبد الله بن عباس عن عنترة بن عبد الرحمن الشيباني عن هارون بن عنترة الشيباني عن عبد الملك بن هارون بن عنترة عن يوسف بن موسى بن راشد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عنترة عن ابن عباس"
"12755","12721  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  سَعِيدُ بْنُ         [12/147]      سُلَيْمَانَ ،  ثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  عَنْ  هَارُونَ بْنِ عَنْتَرَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  مَا أَوْرَثَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَفْرَاءَ فِي بَيْضَاءَ إِلَّا مَا بَيْنَ دَفَّتَيْهِ فَقُمْتُ إِلَى قَائِمِ سَيْفِهِ ، فَوَجَدْتُ فِي حَمَائِلِ سَيْفِهِ صَحِيفَةً مَكْتُوبٌ فِيهَا :  مَنْ  أَحْدَثَ  حَدَثًا أَوْ آوَى مُحْدِثًا أَوِ  انْتَمَى  إِلَى غَيْرِ أَبِيهِ  ، أَوْ مَوْلًى غَيْرِ مَوَالِيهِ ، فَعَلَيْهِ لَعْنَةُ اللهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ  "" .","","Al-Mu'jam al-Kabir 12721","","عبد الله بن عباس عن عنترة بن عبد الرحمن الشيباني عن هارون بن عنترة الشيباني عن عباد بن العوام الكلابي عن سعيد بن سليمان سعدويه عن محمد بن الفضل بن جابر السقطى عن الطبراني","عنترة عن ابن عباس"
"12756","[  مَيْمُونٌ أَبُو عَبْدِ اللهِ  عَنِ  ابْنِ عَبَّاسٍ  ]  12722  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ زَيْدَانَ الْبَجَلِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ حَمَّادِ بْنِ عَمْرٍو الْأَزْدِيُّ ،  ثَنَا  حُسَيْنٌ الْأَشْقَرُ ،  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمَسْعُودِيُّ ،  عَنْ  كَثِيرٍ النَّوَّاءِ ،  عَنْ  مَيْمُونٍ أَبِي عَبْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  لَمَّا أُخْرِجَ أَهْلُ الْمَسْجِدِ ، وَتُرِكَ  عَلِيٌّ  قَالَ النَّاسُ فِي ذَلِكَ ، فَبَلَغَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  مَا أَنَا أَخَرَجْتُكُمْ مِنْ قِبَلِ نَفْسِي ، وَلَا أَنَا تَرَكْتُهُ ، وَلَكِنَّ اللهَ أَخْرَجَكُمْ وَتَرَكَهُ  ، إِنَّمَا أَنَا عَبْدٌ مَأْمُورٌ مَا أُمِرْتُ بِهِ فَعَلْتُ         {      إِنْ أَتَّبِعُ إِلا مَا يُوحَى إِلَيَّ         }      .","","Al-Mu'jam al-Kabir 12722","","عبد الله بن عباس عن ميمون الكندي مولى عبد الرحمن بن سمرة عن كثير بن إسماعيل النواء عن القاسم بن عبد الرحمن المسعودي عن الحسين بن الحسن الأشقر عن محمد بن حماد بن عمرو الأزدي عن عبد الله بن زيدان البلخي عن الطبراني","ميمون أبو عبد الله عن ابن عباس"
"12757","[  أَبُو صَالِحٍ  عَنِ  ابْنِ عَبَّاسٍ  ]  12723  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  حَمَّادُ بْنُ عِيسَى الْعَبْسِيُّ ،  عَنْ  إِسْمَاعِيلَ السُّدِّيِّ ،  عَنْ  أَبِي صَالِحٍ ،  عَنِ  ابْنِ عَبَّاسٍ  يَرْفَعُهُ  قَالَ :  خَلَقَ اللهُ جَنَّةَ عَدْنٍ بِيَدِهِ ، وَدَلَّى فِيهَا ثِمَارَهَا  ، وَشَقَّ فِيهَا أَنْهَارَهَا ، ثُمَّ نَظَرَ فِيهَا ، فَقَالَ :         {      قَدْ أَفْلَحَ الْمُؤْمِنُونَ         }      ، قَالَ : وَعِزَّتِي لَا يُجَاوِرُنِي فِيكِ بِخَيْلٌ  "" .","","Al-Mu'jam al-Kabir 12723","","عبد الله بن عباس عن باذام عن السدي الكبير عن حماد بن عيسى العبسي عن منجاب بن الحارث التميمي عن محمد بن عثمان بن أبي شيبة عن الطبراني","أبو صالح عن ابن عباس"
"12758","[12/148]      12724  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  عُبَادَةُ بْنُ زِيَادٍ الْأَسَدِيُّ ،  ثَنَا  مُدْرِكُ بْنُ سُلَيْمَانَ الطَّائِيُّ ،  عَنِ  الْأَجْلَحِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  إِنَّمَا كَانَ نَفْيُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْحَكَمَ بْنَ أَبِي الْعَاصِ  مِنَ  الْمَدِينَةِ  إِلَى  الطَّائِفِ  ، بَيْنَمَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي حُجْرَتِهِ فَإِذَا هُوَ إِنْسَانٌ يَطَّلِعُ عَلَيْهِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  الْوَزَغَ  ،  الْوَزَغَ  "" فَنَظَرَ فَإِذَا هُوَ  الْحَكَمُ  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اخْرُجْ لَا تُسَاكِنِّي  بِالْمَدِينَةِ  مَا بَقِيتُ  فَنَفَاهُ إِلَى  الطَّائِفِ  .","","Al-Mu'jam al-Kabir 12724","","عبد الله بن عباس عن باذام عن أجلح بن عبد الله الكندي عن مدرك بن سليمان الطائي عن عباد بن زياد  بن موسى الساجي عن محمد بن عثمان بن أبي شيبة عن الطبراني","أبو صالح عن ابن عباس"
"12759","12725  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنْ  أَبِي صَالِحٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّهُ لَعَنَ زَائِرَاتِ  الْقُبُورِ  ، وَالْمُتَّخِذِينَ عَلَيْهَا الْمَسَاجِدَ ، وَالسُّرُجَ  .","","Al-Mu'jam al-Kabir 12725","","عبد الله بن عباس عن باذام عن محمد بن جحادة الأودي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن أبو مسلم الكجي عن الطبراني","أبو صالح عن ابن عباس"
"12760","12726  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نَاجِيَةَ  ، ثَنَا  الْمُنْذِرُ بْنُ الْوَلِيدِ الْجَارُودِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،         [12/149]      عَنْ  أَبِي صَالِحٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَيْرُ الصَّدَقَةِ مَا أَبْقَتْ  غِنًى  ، وَالْيَدُ  الْعُلْيَا  خَيْرٌ مِنَ  الْيَدِ  السُّفْلَى ، وَابْدَأْ بِمَنْ  تَعُولُ  .","","Al-Mu'jam al-Kabir 12726","","عبد الله بن عباس عن ذكوان السمان عن محمد بن جحادة الأودي عن الحسن بن أبي جعفر الجفري عن الوليد بن عبد الرحمن بن حبيب الجارودي عن المنذر بن الوليد بن عبد الرحمن الجارودي عن عبد الله بن محمد بن ناجية البربري عن الطبراني","أبو صالح عن ابن عباس"
"12761","[  حَبِيبُ بْنُ يَسَارٍ  عَنِ  ابْنِ عَبَّاسٍ  ]  12727  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ جَامِعٍ الْعَطَّارُ ،  ثَنَا  دَاوُدُ بْنُ عَبْدِ الْحَمِيدِ  أَبُو سُلَيْمَانَ الْكُوفِيُّ ،  ثَنَا  أَبُو الْجَارُودِ ،  عَنْ  حَبِيبِ بْنِ يَسَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَأْكُلُ الْعِنَبَ  خَرْطًا  "" .  كذا في طبعة مكتبة ابن تيمية والنسخ الخطية ، ولعل الصواب عبد الجبار .","","Al-Mu'jam al-Kabir 12727","","عبد الله بن عباس عن حبيب بن يسار الكندي عن زياد بن المنذر الهمداني عن داود بن عبد الجبار الأودي عن محمد بن جامع العطار عن أحمد بن عمرو بن حفص القريعي عن الطبراني","حبيب بن يسار عن ابن عباس"
"12762","[  يَحْيَى بْنُ الْجَزَّارِ  عَنِ  ابْنِ عَبَّاسٍ  ]  12728  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  عَبْدُ الْحَمِيدِ بْنُ صَالِحٍ ،  ثَنَا  أَبُو شِهَابٍ ،  عَنِ  الْحَجَّاجِ ،  عَنِ  الْحَكَمِ ،  عَنْ  يَحْيَى بْنِ الْجَزَّارِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي فَضَاءٍ مِنَ الْأَرْضِ  لَيْسَ بَيْنَ يَدَيْهِ شَيْءٌ  "" .","","Al-Mu'jam al-Kabir 12728","","عبد الله بن عباس عن يحيى بن الجزار العرني عن الحكم بن عتيبة الكندي عن حجاج بن أرطاة عن عبد ربه بن نافع الحناط عن عبد الحميد بن صالح البرجمي عن محمد بن عثمان بن أبي شيبة عن الطبراني","يحيى بن الجزار عن ابن عباس"
"12763","12729  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ مَيْمُونٍ ،  ثَنَا  الْمُطَّلِبُ بْنُ زِيَادٍ ،  عَنْ  لَيْثٍ ،  عَنِ  الْحَكَمِ ،  عَنْ         [12/150]      يَحْيَى بْنِ الْجَزَّارِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  سَهْمُ  النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الَّذِي أَطْعَمَهُ اللهُ إِيَّاهُ خُمُسُ الْخُمُسِ  "" .","","Al-Mu'jam al-Kabir 12729","","عبد الله بن عباس عن يحيى بن الجزار العرني عن الحكم بن عتيبة الكندي عن ليث بن أبي سليم عن المطلب بن زياد الثقفي عن إبراهيم بن محمد بن ميمون الكندي عن محمد بن عثمان بن أبي شيبة عن الطبراني","يحيى بن الجزار عن ابن عباس"
"12764","12730  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ  ، ثَنَا  عَوْنُ بْنُ سَلَّامٍ ،  ثَنَا  أَبُو بَكْرٍ النَّهْشَلِيُّ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  يَحْيَى بْنِ الْجَزَّارِ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُوتِرُ بِثَلَاثٍ  .","","Al-Mu'jam al-Kabir 12730","","عبد الله بن عباس عن يحيى بن الجزار العرني عن حبيب بن أبي ثابت الكاهلي عن أبو بكر النهشلي عن عون بن سلام الهاشمي عن لحية الليف محمد بن العباس عن الطبراني","يحيى بن الجزار عن ابن عباس"
"12765","[  عَبْدُ اللهِ بْنُ الْحَارِثِ  عَنِ  ابْنِ عَبَّاسٍ  ]  12731  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  عَنْ  يَزِيدَ أَبِي خَالِدٍ - هُوَ الدَّالَانِيُّ الْوَاسِطِيُّ -  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ دَخَلَ عَلَى مَرِيضٍ ، فَقَالَ : أَسْأَلُ اللهَ الْعَظِيمَ رَبَّ الْعَرْشِ الْعَظِيمِ أَنْ يَشْفِيَكَ  ، إِلَّا بَرَأَ مَا لَمْ يَحْضُرْ أَجَلُهُ  .  قَالَ  شُعْبَةُ  رَفَعَهُ  مَرَّةً ،  وَلَمْ يَرْفَعْهُ  مَرَّتَيْنِ  .","","Al-Mu'jam al-Kabir 12731","","عبد الله بن عباس عن عبد الله بن الحارث الأنصاري عن المنهال بن عمرو الأسدي عن أبو خالد الدالاني عن حجاج بن نصير الفساطيطي عن أبو مسلم الكجي عن الطبراني","عبد الله بن الحارث عن ابن عباس"
"12766","12732  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  ثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ دَخَلَ عَلَى مَرِيضٍ ، فَقَالَ : أَسْأَلُ اللهَ الْعَظِيمَ رَبَّ الْعَرْشِ الْعَظِيمِ  ، إِلَّا بَرَأَ مَا لَمْ يَكُنْ حَضَرَ أَجَلُهُ  .         [12/151]","","Al-Mu'jam al-Kabir 12732","","عبد الله بن عباس عن عبد الله بن الحارث الأنصاري عن المنهال بن عمرو الأسدي عن حجاج بن أرطاة عن هشام الدستوائي عن حجاج بن نصير الفساطيطي عن أبو مسلم الكجي عن الطبراني","عبد الله بن الحارث عن ابن عباس"
"12767","12733  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنِ  ابْنِ عَبَّاسٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 12733","","عبد الله بن عباس عن عبد الله بن الحارث الأنصاري عن المنهال بن عمرو الأسدي عن حجاج بن أرطاة عن عبد الرحيم بن سليمان الأشل عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن الحارث عن ابن عباس"
"12768","12734  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  يَحْيَى بْنُ آدَمَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي سِنَانٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" صَلَّى عَلَى مَيِّتٍ بَعْدَمَا دُفِنَ  "" .","","Al-Mu'jam al-Kabir 12734","","عبد الله بن عباس عن عبد الله بن الحارث الأنصاري عن ضرار بن مرة الشيباني عن سفيان الثوري عن يحيى بن آدم عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن الحارث عن ابن عباس"
"12769","12735  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ دَاوُدَ السُّكَّرِيُّ الْجُنْدَيْسَابُورِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ خُلَيْدٍ الْحَنَفِيُّ ،  ثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  شَكَى نَبِيٌّ مِنَ الْأَنْبِيَاءِ إِلَى رَبِّهِ عَزَّ وَجَلَّ ، قَالَ : يَا رَبِّ ، يَكُونُ الْعَبْدُ مِنْ عَبِيدِكَ يُؤْمِنُ بِكَ  ، وَيَعْمَلُ بِطَاعَتِكَ فَتُزْوِي عَنْهُ الدُّنْيَا ، وَتَعْرِضُ لَهُ الْبَلَاءَ ، وَيَكُونُ الْعَبْدُ مِنْ عَبِيدِكَ يَكْفُرُ بِكَ ، وَيَعْمَلُ بِمَعَاصِيكَ فَتُزْوِي عَنْهُ الْبَلَاءَ ، وَتَعْرِضُ لَهُ الدُّنْيَا ، فَأَوْحَى اللهُ عَزَّ وَجَلَّ إِلَيْهِ أَنَّ الْبَلَاءَ وَالْعِبَادَ لِي ، وَأَنَّهُ لَيْسَ مِنْ شَيْءٍ إِلَّا         [12/152]      يُسَبِّحُنِي ، وَيُهَلِّلُنِي وَيُكَبِّرُنِي ، وَأَمَّا عَبْدِيَ الْمُؤْمِنُ فَلَهُ سَيِّئَاتٌ فَأَزْوِي عَنْهُ الدُّنْيَا ، وَأَعْرِضُ لَهُ الْبَلَاءَ حَتَّى يَأْتِيَنِي فَأَجْزِيهِ بِحَسَنَاتٍ ، وَأَمَّا عَبْدِيَ الْكَافِرُ فَلَهُ حَسَنَاتٌ فَأَزْوِي عَنْهُ الْبَلَاءَ ، وَأَعْرِضُ لَهُ الدُّنْيَا حَتَّى يَأْتِيَنِي فَأَجْزِيهِ بِسَيِّئَاتِهِ  .","","Al-Mu'jam al-Kabir 12735","","عبد الله بن عباس عن عبد الله بن الحارث الأنصاري عن سعيد بن جبير الأسدي عن المنهال بن عمرو الأسدي عن الأعمش عن الفضيل بن عياض عن محمد بن خليد بن عمرو الكرماني عن أحمد بن محمد بن داود السكري الجنديسابوري عن الطبراني","عبد الله بن الحارث عن ابن عباس"
"12770","[  عِمْرَانُ السُّلَمِيُّ أَبُو الْحَكَمِ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12736  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  عِمْرَانَ السُّلَمِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قَالَتْ  قُرَيْشٌ  لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" ادْعُ لَنَا رَبَّكَ يَجْعَلْ لَنَا  الصَّفَا  ذَهَبًا  فَإِنْ أَصْبَحَ لَنَا ذَهَبًا اتَّبَعْنَاكَ ، فَدَعَا رَبَّهُ عَزَّ وَجَلَّ ، فَأَتَاهُ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، فَقَالَ : إِنَّ رَبَّكَ  يُقْرِئُكَ  السَّلَامَ ، وَيَقُولُ لَكَ : إِنْ شِئْتَ أَصْبَحَ لَهُمُ الصَّفَا ذَهَبًا ، فَمَنْ كَفَرَ مِنْهُمْ عَذَّبْتُهُ عَذَابًا لَمْ أُعَذِّبْهُ أَحَدًا مِنَ الْعَالَمِينَ ، وَإِنْ شِئْتَ فَتَحْتُ لَهُمْ بَابَ التَّوْبَةِ وَالرَّحْمَةِ . قَالَ : بَلْ بَابُ التَّوْبَةِ وَالرَّحْمَةِ  "" .","","Al-Mu'jam al-Kabir 12736","","عبد الله بن عباس عن عمران بن الحارث السلمي عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمران السلمي أبو الحكم عن ابن عباس"
"12771","12737  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، وَيُوسُفُ الْقَاضِي قَالَا :  ثَنَا  عُمَرُ بْنُ مَرْزُوقٍ  ،  أَنَا  شُعْبَةُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ قَالَ :  سَمِعْتُ  أَبَا الْحَكَمِ السُّلَمِيَّ  يُحَدِّثُ عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَالَ لِي  جِبْرِيلُ  : تَمَّ  الشَّهْرُ  تِسْعٌ وَعِشْرُونَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب: (عمرو بن مرزوق ) .","","Al-Mu'jam al-Kabir 12737","","عبد الله بن عباس عن عمران بن الحارث السلمي عن سلمة بن كهيل الحضرمي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمران السلمي أبو الحكم عن ابن عباس"
"12772","12738  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، وَيُوسُفُ الْقَاضِي ، قَالَا :         [12/153]      ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي الْحَكَمِ السُّلَمِيِّ قَالَ :  سَأَلْتُ  ابْنَ عَبَّاسٍ عَنْ نَبِيذِ  الْجَرِّ  ، فَقَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْجَرِّ  ،  وَالدُّبَّاءِ  .  وَقَالَ  ابْنُ عَبَّاسٍ : ""  مَنْ كَانَ مُحَرِّمًا مَا حَرَّمَ اللهُ وَرَسُولُهُ ، فَلْيُحَرِّمِ النَّبِيذَ  ،  يَعْنِي نَبِيذَ  الْجَرِّ  .","","Al-Mu'jam al-Kabir 12738","","عبد الله بن عباس عن عمران بن الحارث السلمي عن سلمة بن كهيل الحضرمي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمران السلمي أبو الحكم عن ابن عباس"
"12773","[  أَبُو رَزِينٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12739  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  عَنْ  أَبِي بَكْرِ بْنِ عَيَّاشٍ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  أَبِي رَزِينٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  لَمَّا نَزَلَتْ :         {      إِنَّكُمْ وَمَا تَعْبُدُونَ مِنْ دُونِ اللهِ حَصَبُ جَهَنَّمَ أَنْتُمْ لَهَا وَارِدُونَ         }      ، قَالَ  عَبْدُ اللهِ بْنُ الزِّبَعْرَى  : أَنَا أَخْصِمُ لَكُمْ  مُحَمَّدًا  ، فَقَالَ : يَا  مُحَمَّدُ  أَلَيْسَ فِيمَا أَنْزَلَ اللهُ عَلَيْكَ :         {      إِنَّكُمْ وَمَا تَعْبُدُونَ مِنْ دُونِ اللهِ حَصَبُ جَهَنَّمَ أَنْتُمْ لَهَا وَارِدُونَ         }      قَالَ : "" نَعَمْ "" قَالَ : فَهَذِهِ النَّصَارَى تَعْبُدُ  عِيسَى  ، وَهَذِهِ الْيَهُودُ تَعْبُدُ  عُزَيْرًا  ، وَهَذِهِ  بَنُو تَمِيمٍ  تَعْبُدُ الْمَلَائِكَةَ ، فَهَؤُلَاءِ فِي النَّارِ ؟ فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      إِنَّ الَّذِينَ سَبَقَتْ لَهُمْ مِنَّا الْحُسْنَى أُولَئِكَ عَنْهَا مُبْعَدُونَ         }      .","","Al-Mu'jam al-Kabir 12739","","عبد الله بن عباس عن مسعود بن مالك الأسدي عن عاصم بن بهدلة عن أبو بكر بن عياش عن يحيى بن آدم عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","أبو رزين عن ابن عباس"
"12774","[  أَبُو يَحْيَى  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12740  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ أَبِي حَسَّانَ         [12/154]      الْأَنْمَاطِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ، وَشَيْبَانُ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  أَبِي رَزِينٍ ،  عَنْ  أَبِي يَحْيَى ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِقُرَيْشٍ  :  يَا مَعْشَرَ  قُرَيْشٍ  لَا خَيْرَ فِي أَحَدٍ يُعْبَدُ مِنْ دُونِ اللهِ  ، فَقَالُوا : أَلَسْتَ تَزْعُمُ أَنَّ  عِيسَى  كَانَ نَبِيًّا ، وَكَانَ عَبْدًا صَالِحًا إِنْ كُنْتَ صَادِقًا إِنَّهُ لَكَآلِهَتِهِمْ ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      وَلَمَّا ضُرِبَ ابْنُ مَرْيَمَ مَثَلا إِذَا قَوْمُكَ مِنْهُ يَصِدُّونَ         }      يَضِجُّونَ ،         {      وَإِنَّهُ لَعِلْمٌ لِلسَّاعَةِ         }      خُرُوجُ  عِيسَى  قَبْلَ يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 12740","","عبد الله بن عباس عن مصدع المعرقب عن مسعود بن مالك الأسدي عن عاصم بن بهدلة عن شيبان بن عبد الرحمن المؤدب عن الوليد بن مسلم القرشي عن هشام بن عمار عن إسحاق بن إبراهيم بن أبي حسان الأنماطي عن الطبراني","أبو يحيى عن ابن عباس"
"12775","[  عُبَيْدُ اللهِ بْنُ الْمُسَاوِرِ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12741  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي بَشِيرٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ الْمُسَاوِرِ  قَالَ :  قَالَ  ابْنُ عَبَّاسٍ : وَهُوَ يَنْحَلُ  ابْنَ الزُّبَيْرِ  : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ الْمُؤْمِنُ بِالَّذِي يَشْبَعُ ، وَجَارُهُ جَائِعٌ  .  كذا في طبعة مكتبة ابن تيمية وهو تصحيف صوابه : ( عبد الله) .","","Al-Mu'jam al-Kabir 12741","","عبد الله بن عباس عن عبد الله بن المساور الهاشمي عن عبد الملك بن أبي بشير البصري عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبيد الله بن المساور عن ابن عباس"
"12776","[  أَبُو دَاوُدَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12742  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  أَبُو بَكْرِ         [12/155]      بْنُ عَيَّاشٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي دَاوُدَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  مَا بَعَثَ اللهُ نَبِيًّا إِلَّا كَانَتْ بَعْدَهُ وَقْفَةٌ يَمْلَأُ بِهِمْ  جَهَنَّمَ  "" .","","Al-Mu'jam al-Kabir 12742","","عبد الله بن عباس عن نفيع بن الحارث الأعمى عن الأعمش عن أبو بكر بن عياش عن أبو كريب محمد بن العلاء عن عبيد العجل عن الطبراني","أبو داود عن ابن عباس"
"12777","[  الْحَسَنُ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12743  -  حَدَّثَنَا  سَعِيدُ بْنُ الْمُغِيرَةِ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ الْوَاسِطِيُّ ،  ثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  عَنِ  الْعَلَاءِ بْنِ الْمُسَيِّبِ ،  عَنْ  رَجُلٍ يُقَالُ لَهُ الْحَسَنُ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : سُئِلَ عَنْ مَنْ قَدَّمَ مِنَ الْمَنَاسِكِ شَيْئًا أَوْ أَخَّرَهُ بِجَهَالَةٍ لَهُ غَيْرَ مُتَعَمِّدٍ  ، فَقَالَ : "" لَا بَأْسَ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 12743","","عبد الله بن عباس عن رجل يقال له الحسن عن علاء بن المسيب عن عباد بن العوام الكلابي عن سعيد بن سليمان سعدويه عن سعيد بن محمد بن المغيرة المصري عن الطبراني","الحسن عن ابن عباس"
"12778","[  الذَّيَّالُ بْنُ حَرْمَلَةَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12744  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  يَزِيدُ بْنُ مِهْرَانَ أَبُو خَالِدٍ الْخَبَّازُ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنِ  الْأَجْلَحِ ،  عَنِ  الذَّيَّالِ بْنِ حَرْمَلَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  جَاءَ قَوْمٌ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا : يَا رَسُولَ اللهِ ، إِنَّ بَعِيرًا لَنَا قَطَّ فِي حَائِطٍ فَجَاءَ إِلَيْهِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" تَعَالَ "" فَجَاءَ مُطَأْطِئًا رَأْسَهُ حَتَّى  خَطَمَهُ  ، وَأَعْطَاهُ أَصْحَابَهُ ، فَقَالَ لَهُ  أَبُو بَكْرٍ  : يَا رَسُولَ اللهِ ، كَأَنَّهُ عَلِمَ أَنَّكَ نَبِيٌّ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا بَيْنَ  لَابَتَيْهَا  أَحَدٌ إِلَّا يَعْلَمُ أَنِّي نَبِيٌّ إِلَّا كَفَرَةُ الْجِنِّ وَالْإِنْسِ  .  تصحفت في طبعة مكتبة ابن تيمية : ( لابيتها ) وهي على الصواب في النسخ الخطية .","","Al-Mu'jam al-Kabir 12744","","عبد الله بن عباس عن الذيال بن حرملة الأسدي عن أجلح بن عبد الله الكندي عن أبو بكر بن عياش عن يزيد بن مهران الخباز عن بشر بن موسى بن صالح الأسدي عن الطبراني","الذيال بن حرملة عن ابن عباس"
"12779","[12/156]      [  عَمْرُو بْنُ سُفْيَانَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12745  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  سَوَّارُ بْنُ مُصْعَبٍ ،  عَنِ  الْأَسْوَدِ بْنِ قَيْسٍ ،  عَنْ  عَمْرِو بْنِ سُفْيَانَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا هَلَكَ  سَدُومُ  ، وَمَا حَوْلَهَا مِنَ الْقُرَى حَتَّى اسْتَاكُوا بِالْمَسَاوِيكِ  ، وَمَضَغُوا  الْعِلْكَ  فِي الْمَجَالِسِ  .","","Al-Mu'jam al-Kabir 12745","","عبد الله بن عباس عن عمرو بن سفيان الثقفي عن الأسود بن قيس العبدي عن سوار بن مصعب المؤذن عن زكريا بن يحيى زحمويه عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن سفيان عن ابن عباس"
"12780","[  أَبُو الْعَالِيَةِ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12746  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زِيَادِ بْنِ حُصَيْنٍ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مَرَّ بِنَفَرٍ يَرْمُونَ ، فَقَالَ :  رَمْيًا  بَنِي إِسْمَاعِيلَ  فَإِنَّ أَبَاكُمْ كَانَ رَامِيًا  .","","Al-Mu'jam al-Kabir 12746","","عبد الله بن عباس عن رفيع بن مهران عن زياد بن الحصين اليربوعي عن الأعمش عن سفيان الثوري عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو العالية عن ابن عباس"
"12781","12747  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  هَوْذَةُ بْنُ خَلِيفَةَ ،  ثَنَا  عَوْفٌ ،  عَنْ  زِيَادِ بْنِ حُصَيْنٍ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  غَدَاةَ الْعَقَبَةِ  ، وَهُوَ عَلَى رَاحِلَتِهِ : "" هَاتِ الْتَقِطْ  فَالْتَقَطْتُ لَهُ حَصَيَاتٍ مِنْ حَصَى الْحَذْفِ فَلَمَّا وَضَعَهُنَّ فِي يَدِهِ قَالَ : "" نَعَمْ بِأَمْثَالِ هَؤُلَاءِ "" ثَلَاثَ مِرَارٍ "" وَإِيَّاكُمْ  وَالْغُلُوَّ  فَإِنَّمَا أَهْلَكَ مَنْ كَانَ قَبْلَكُمُ  الْغُلُوُّ  فِي الدِّينِ  .         [12/157]","","Al-Mu'jam al-Kabir 12747","","عبد الله بن عباس عن رفيع بن مهران عن زياد بن الحصين اليربوعي عن عوف بن أبي جميلة عن هوذة بن خليفة البكراوي عن بشر بن موسى بن صالح الأسدي عن الطبراني","أبو العالية عن ابن عباس"
"12782","12747  / 2  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ،  ثَنَا  قَبِيصَةُ بْنُ عُقْبَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَوْفٍ ،  عَنْ  زِيَادِ بْنِ حُصَيْنٍ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 12747","","عبد الله بن عباس عن رفيع بن مهران عن زياد بن الحصين اليربوعي عن عوف بن أبي جميلة عن سفيان الثوري عن قبيصة بن عقبة السوائي عن حفص بن عمر سنجة ألف عن الطبراني","أبو العالية عن ابن عباس"
"12783","12748  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ سَعِيدٍ الْأَصْبَهَانِيُّ ، قَالُوا :  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  أَبِي خَالِدٍ الدَّالَانِيِّ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى رَكْعَتَيْنِ قَبْلَ الْفَجْرِ ، ثُمَّ نَامَ حَتَّى غَطَّ ، وَنَفَخَ وَهُوَ  سَاجِدٌ أَوْ جَالِسٌ  ، ثُمَّ قَامَ فَصَلَّى ، فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنَّكَ قَدْ نِمْتَ قَالَ :  إِنَّمَا يَجِبُ الْوُضُوءُ عَلَى مَنْ نَامَ مُضْطَجِعًا  فَإِذَا اضْطَجَعَ اسْتَرْخَتْ مَفَاصِلُهُ  .","","Al-Mu'jam al-Kabir 12748","","عبد الله بن عباس عن رفيع بن مهران عن قتادة بن دعامة عن أبو خالد الدالاني عن عبد السلام بن حرب الملائي عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو العالية عن ابن عباس"
"12784","12749  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الرَّقَاشِيُّ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْعَالِيَةِ قَالَ :  حَدَّثَنِي  ابْنُ عَمِّ نَبِيِّكُمْ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَعْنِي ابْنَ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  رَأَيْتُ لَيْلَةَ أُسْرِيَ بِي  مُوسَى بْنَ عِمْرَانَ  عَلَيْهِ السَّلَامُ رَجُلًا آدَمَ طُوَالً  جَعْدً  كَأَنَّهُ مِنْ رِجَالِ  شَنُوَّةَ  ، وَرَأَيْتُ  عِيسَى ابْنَ مَرْيَمَ  رَجُلٌ  مَرْبُوعٌ  إِلَى الْحُمْرَةِ وَالْبَيَاضِ سَبِطُ الرَّأْسِ ، وَرَأَيْتُ  مَالِكًا         [12/158]      خَازِنَ النَّارِ ، وَرَأَيْتُ  الدَّجَّالَ  فِي آيَاتٍ أَرَانِيهِنَّ اللهُ عَزَّ وَجَلَّ  .","","Al-Mu'jam al-Kabir 12749","","عبد الله بن عباس عن رفيع بن مهران عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن محمد بن عبد الله بن محمد بن عبد الملك الرقاشي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو العالية عن ابن عباس"
"12785","12750  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ  ، ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ (  ح  ) .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ كِلَاهُمَا ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَدْعُو عِنْدَ الْكَرْبِ : "" لَا إِلَهَ إِلَّا اللهُ الْعَظِيمُ الْحَكِيمُ  ، لَا إِلَهَ إِلَّا اللهُ رَبُّ الْعَرْشِ  الْكَرِيمِ ، لَا إِلَهَ إِلَّا اللهُ رَبُّ السَّمَاوَاتِ ، وَرَبُّ الْعَرْشِ الْعَظِيمِ  .  تصحفت في طبعة مكتبة ابن تيمية : ( العرب ) وهي على الصواب في النسخ الخطية .","","Al-Mu'jam al-Kabir 12750","","عبد الله بن عباس عن رفيع بن مهران عن قتادة بن دعامة عن هشام الدستوائي عن مسلم بن إبراهيم الشحام عن أبو مسلم الكجي عن الطبراني","أبو العالية عن ابن عباس"
"12786","12751  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 12751","","عبد الله بن عباس عن رفيع بن مهران عن يوسف بن عبد الله بن الحارث البصري عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أحمد بن داود بن موسى السدوسي عن الطبراني","أبو العالية عن ابن عباس"
"12787","12752  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْحُسَيْنِ الْمِصِّيصِيُّ ، وَأَبُو زُرْعَةُ قَالَا :  ثَنَا  مُحَمَّدُ بْنُ بَكَّارِ بْنِ بِلَالٍ ،  ثَنَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْلَا ضَعْفُ الضَّعِيفِ ، وَسَقَمُ السَّقِيمِ لَأَخَّرْتُ صَلَاةَ الْعِشَاءِ  الْآخِرَةِ  .","","Al-Mu'jam al-Kabir 12752","","عبد الله بن عباس عن رفيع بن مهران عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن محمد بن بكار العاملي عن أبو زرعة الدمشقي عن الطبراني","أبو العالية عن ابن عباس"
"12788","12753  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :         [12/159]      قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا يَنْبَغِي لِعَبْدٍ أَنْ يَقُولَ : أَنَا خَيْرٌ مِنْ  يُونُسَ بْنِ مَتَّى  .","","Al-Mu'jam al-Kabir 12753","","عبد الله بن عباس عن رفيع بن مهران عن قتادة بن دعامة عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن عثمان بن عمر الضبي عن الطبراني","أبو العالية عن ابن عباس"
"12789","12754  -  حَدَّثَنَا  أَبُو حَنِيفَةَ مُحَمَّدُ بْنُ حَنِيفَةَ الْوَاسِطِيُّ  ، ثَنَا  عَبْدُ الْقُدُّوسِ بْنُ مُحَمَّدٍ الْحَبْحَابِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُوَيْدٍ الْمَغُولِيُّ  ،  ثَنَا  عِمْرَانُ الْقَطَّانُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  شَرُّ الطَّعَامِ طَعَامُ الْوَلِيمَةِ يُدْعَى إِلَيْهِ الشَّبْعَانُ  ، وَيُحْبَسُ عَنْهُ الْجَائِعُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( المعولي) .","","Al-Mu'jam al-Kabir 12754","","عبد الله بن عباس عن رفيع بن مهران عن قتادة بن دعامة عن عمران بن داور القطان عن سعيد بن سويد المعولي عن عبد القدوس بن محمد الحبحابي عن محمد بن حنيفة القصبى عن الطبراني","أبو العالية عن ابن عباس"
"12790","12755  -  حَدَّثَنَا  الْعَبَّاسِ  بْنِ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُبَارَكِ الْعَيْشِيُّ ،  ثَنَا  عُلَيْلَةُ بْنُ بَدْرٍ ،  ثَنَا  سَيَّارُ بْنُ سَلَامَةَ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ يُعَلِّمُنَا الرُّكُوعَ كَمَا كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : يُعَلِّمُهُمْ  ، ثُمَّ يَسْتَوِي لَنَا رَاكِعًا حَتَّى لَوْ قُطِرَتْ بَيْنَ كَتِفَيْهِ قَطْرَةٌ مِنْ مَاءٍ مَا تَقَدَّمَتْ ، وَلَا تَأَخَّرَتْ  .  في طبعة مكتبة ابن تيمية : (ابن العباس) والمثبت من الظاهرية (1) .","","Al-Mu'jam al-Kabir 12755","","عبد الله بن عباس عن رفيع بن مهران عن سيار بن سلامة الرياحي عن الربيع بن بدر عليلة عن عبد الرحمن بن المبارك الخلقاني عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","أبو العالية عن ابن عباس"
"12791","12756  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  رُفَيْعٍ أَبِي الْعَالِيَةِ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَتَى عَلَى  وَادِي ابْنِ الْأَزْرَقِ  ، فَقَالَ : "" مَا هَذَا الْوَادِي ؟ "" قَالُوا :  وَادِي ابْنِ         [12/160]      الْأَزْرَقِ  قَالَ :  كَأَنِّي أَنْظُرُ إِلَى  مُوسَى  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُنْهَبِطًا ، وَلَهُ حُوَارٌ إِلَى رَبِّهِ بِالتَّلْبِيَةِ  ثُمَّ أَتَى عَلَى ثَنِيَّةٍ ، فَقَالَ : "" مَا هَذِهِ الثَّنِيَّةُ ؟ "" قِيلَ : ثَنِيَّةُ كَذَا وَكَذَا قَالَ : "" كَأَنِّي أَنْظُرُ إِلَى  يُونُسَ بْنِ مَتَّى  عَلَى نَاقَةٍ حَمْرَاءَ  جَعْدَةٍ  خِطَامُهَا لِيفٌ عَلَيْهِ جُبَّةٌ مِنْ صُوفٍ ، وَهُوَ يُلَبِّي  . قَالَ أَبُو الْقَاسِمِ : ""  قَالَ  حَمَّادُ بْنُ سَلَمَةَ  : ابْنُ الْأَزْرَقِ ، وَإِنَّمَا هُوَ الْأَزْرَقُ  "" .","","Al-Mu'jam al-Kabir 12756","","عبد الله بن عباس عن رفيع بن مهران عن داود بن أبي هند عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو العالية عن ابن عباس"
"12792","12757  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  زَيْدُ بْنُ أَخْزَمَ ،  ثَنَا  بِشْرُ بْنُ عُمَرَ الزَّهْرَانِيُّ ،  ثَنَا  أَبَانُ بْنُ يَزِيدَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ  إِنْسَانًا  لَعَنَ الرِّيحَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَلْعَنْهَا فَإِنَّهَا مَأْمُورَةٌ  ، وَإِنَّهُ مَنْ لَعَنَ شَيْئًا لَيْسَ لَهُ بِأَهْلٍ ، وَقَعَتْ عَلَيْهِ اللَّعْنَةُ  .","","Al-Mu'jam al-Kabir 12757","","عبد الله بن عباس عن رفيع بن مهران عن قتادة بن دعامة عن أبان بن يزيد العطار عن بشر بن عمر الزهراني عن زيد بن أخزم الطائي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أبو العالية عن ابن عباس"
"12793","12758  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فِي قَوْلِهِ :         {      وَجَعَلْنَاهُ هُدًى لِبَنِي إِسْرَائِيلَ         }      قَالَ : "" جُعِلَ  مُوسَى  هُدًى  لِبَنِي إِسْرَائِيلَ  وَفِي قَوْلِهِ :         {      فَلا تَكُنْ فِي مِرْيَةٍ مِنْ لِقَائِهِ         }      قَالَ : "" مِنْ  لِقَاءِ  مُوسَى  رَبَّهُ عَزَّ وَجَلَّ  .  سقط من طبعة مكتبة ابن تيمية ، والمثبت من النسخ الخطية .","","Al-Mu'jam al-Kabir 12758","","عبد الله بن عباس عن رفيع بن مهران عن قتادة بن دعامة عن سعيد بن أبي عروبة عن روح بن عبادة القيسي عن الحسن بن علي الريحاني عن محمد بن عثمان بن أبي شيبة عن الطبراني","أبو العالية عن ابن عباس"
"12794","[  أَبُو رَجَاءٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12759  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ،         [12/161]      قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنِ  الْجَعْدِ أَبِي عُثْمَانَ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، يَرْوِيهِ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ رَأَى مِنْ أَمِيرِهِ شَيْئًا يُنْكِرُهُ فَلْيَصْبِرْ  ، فَإِنَّهُ لَيْسَ أَحَدٌ يُفَارِقُ الْجَمَاعَةَ فَيَمُوتُ إِلَّا  مِيتَةً  جَاهِلِيَّةً  .","","Al-Mu'jam al-Kabir 12759","","عبد الله بن عباس عن أبو رجاء العطاردي عن الجعد بن دينار اليشكري عن حماد بن زيد عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن الطبراني","أبو رجاء عن ابن عباس"
"12795","12760  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الرَّقَاشِيُّ ،  ثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ ،  ثَنَا  الْجَعْدُ أَبُو عُثْمَانَ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ رَبَّكُمْ رَحِيمٌ ، مَنْ هَمَّ بِحَسَنَةٍ فَلَمْ يَعْمَلْهَا كُتِبَ لَهُ عَشْرُ أَضْعَافٍ  إِلَى سَبْعِمِائَةِ ضِعْفٍ إِلَى أَضْعَافٍ كَثِيرَةٍ ، وَمَنْ هَمَّ بِسَيِّئَةٍ فَلَمْ يَعْمَلْهَا كُتِبَتْ لَهُ حَسَنَةٌ فَإِنْ عَمِلَهَا كُتِبَتْ عَلَيْهِ سَيِّئَةٌ وَاحِدَةٌ أَوْ مَحَاهَا ، وَلَا يَهْلِكُ عَلَى اللهِ إِلَّا هَالِكٌ  .","","Al-Mu'jam al-Kabir 12760","","عبد الله بن عباس عن أبو رجاء العطاردي عن الجعد بن دينار اليشكري عن جعفر بن سليمان الضبعي عن محمد بن عبد الله بن محمد بن عبد الملك الرقاشي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو رجاء عن ابن عباس"
"12796","12761  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ  الْحَسَنِ بْنِ ذَكْوَانَ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 12761","","عبد الله بن عباس عن أبو رجاء العطاردي عن الحسن بن ذكوان البصري عن يحيى القطان عن محمد بن أبي بكر المقدمي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","أبو رجاء عن ابن عباس"
"12797","12762  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ،  ثَنَا  عَبْدُ الْحَكِيمِ بْنُ ذَكْوَانَ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّهُ قَالَ فِي يَوْمٍ مَطِيرٍ : "" الصَّلَاةُ فِي  الرِّحَالِ  ثُمَّ قَالَ : أَتَعْجَبُونَ ؟ "" قَدْ فَعَلَهُ مَنْ هُوَ خَيْرٌ مِنَّا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 12762","","عبد الله بن عباس عن أبو رجاء العطاردي عن عبد الحكم بن ذكوان السدوسي عن حفص بن عمر الحوضى عن أحمد بن داود بن موسى السدوسي عن الطبراني","أبو رجاء عن ابن عباس"
"12798","12763  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ بْنِ سَوْرَةَ الْبَغْدَادِيُّ ،         [12/162]      وَمُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ بُكَيْرٍ الطَّيَالِسِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  سَلْمُ بْنُ زُرَيْرٍ قَالَ :  سَمِعْتُ  أَبَا رَجَاءٍ قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِابْنِ صَائِدٍ  :  إِنِّي قَدْ خَبَأْتُ لَكَ  خَبْئًا  فَمَا هُوَ ؟  قَالَ :  دُخٌّ  ، قَالَ : "" اخْسَ  "" .","","Al-Mu'jam al-Kabir 12763","","عبد الله بن عباس عن أبو رجاء العطاردي عن سلم بن زرير العطاردي عن أبو الوليد الطيالسي عن محمد بن إبراهيم بن بكير الطيالسي عن الطبراني","أبو رجاء عن ابن عباس"
"12799","12764  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ ، وَعَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْوَاسِطِيُّ ،  ثَنَا  جَرِيرُ بْنُ حَازِمٍ قَالَ :  سَمِعْتُ  أَبَا رَجَاءٍ الْعُطَارِدِيَّ ، يَقُولُ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يُحَدِّثُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ أَمْرَ هَذِهِ الْأُمَّةِ لَا يَزَالُ مُقَارِبًا أَوْ  مُؤَامًّا  حَتَّى يَتَكَلَّمُوا  فِي الْوِلْدَانِ وَالْقَدَرِ  .  في طبعة مكتبة ابن تيمية : ( مواتيا ) والمثبت من النسخ الخطية ، وقال الخطابي في غريب الحديث : ""قوله مؤاما مثقلة الميم أي مقاربا من قولك أمر أمم أي قصد قريب ونظرت إليه من أمم أي من قرب""  تصحفت في طبعة مكتبة ابن تيمية : ( يكملوا ) والمثبت من نسخة خطية","","Al-Mu'jam al-Kabir 12764","","عبد الله بن عباس عن أبو رجاء العطاردي عن جرير بن حازم عن محمد بن أبان بن عمران السلمي عن علي بن سعيد بن بشير عليك عن الطبراني","أبو رجاء عن ابن عباس"
"12800","12765  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَخْبَرَنِي  صَخْرُ بْنُ جُوَيْرِيَةَ قَالَ :  سَمِعْتُ  أَبَا رَجَاءٍ ،  ثَنَا  ابْنُ عَبَّاسٍ قَالَ : قَالَ  مُحَمَّدٌ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اطَّلَعْتُ فِي الْجَنَّةِ فَرَأَيْتُ أَكْثَرَ أَهْلِهَا الْفُقَرَاءَ وَالْمَسَاكِينَ  ، وَإِلَى النَّارِ فَرَأَيْتُ أَكْثَرَ أَهْلِهَا النِّسَاءَ  .","","Al-Mu'jam al-Kabir 12765","","عبد الله بن عباس عن أبو رجاء العطاردي عن صخر بن جويرية الهلالي عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","أبو رجاء عن ابن عباس"
"12801","12766  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَإِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ، قَالَا :  ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  أَبُو الْأَشْهَبِ ،  ثَنَا  أَبُو رَجَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اطَّلَعْتُ فِي الْجَنَّةِ فَرَأَيْتُ أَكْثَرَ أَهْلِهَا الْفُقَرَاءَ  ، وَاطَّلَعْتُ فِي النَّارِ فَرَأَيْتُ أَكْثَرَ أَهْلِهَا النِّسَاءَ  .","","Al-Mu'jam al-Kabir 12766","","عبد الله بن عباس عن أبو رجاء العطاردي عن جعفر بن حيان العطاردي عن شيبان بن فروخ الحبطي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","أبو رجاء عن ابن عباس"
"12802","[12/163]      12767  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عُلَيَّةَ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ  مُحَمَّدٌ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اطَّلَعْتُ فِي الْجَنَّةِ فَرَأَيْتُ أَكْثَرَ أَهْلِهَا الْفُقَرَاءَ  ، وَاطَّلَعْتُ فِي النَّارِ فَرَأَيْتُ أَكْثَرَ أَهْلِهَا النِّسَاءَ  .","","Al-Mu'jam al-Kabir 12767","","عبد الله بن عباس عن أبو رجاء العطاردي عن أيوب السختياني عن إسماعيل ابن علية عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو رجاء عن ابن عباس"
"12803","12768  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ ،  ثَنَا  أَيُّوبُ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اطَّلَعْتُ فِي الْجَنَّةِ فَرَأَيْتُ أَكْثَرَ أَهْلِهَا الْفُقَرَاءَ  ، وَاطَّلَعْتُ فِي النَّارِ فَرَأَيْتُ أَكْثَرَ أَهْلِهَا النِّسَاءَ  .","","Al-Mu'jam al-Kabir 12768","","عبد الله بن عباس عن أبو رجاء العطاردي عن أيوب السختياني عن عبد الوهاب بن عبد المجيد الثقفي عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","أبو رجاء عن ابن عباس"
"12804","12769  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ  ، ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  دَاوُدُ بْنُ الزِّبْرِقَانِ ،  عَنْ  أَيُّوبَ ، وَمَطَرٍ الْوَرَّاقِ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اطَّلَعْتُ فِي الْجَنَّةِ فَرَأَيْتُ أَكْثَرَ أَهْلِهَا الْفُقَرَاءَ  ، وَاطَّلَعْتُ فِي النَّارِ فَرَأَيْتُ أَكْثَرَ أَهْلِهَا النِّسَاءَ  .","","Al-Mu'jam al-Kabir 12769","","عبد الله بن عباس عن أبو رجاء العطاردي عن أيوب السختياني عن داود بن الزبرقان عن زكريا بن يحيى زحمويه عن بحشل عن الطبراني","أبو رجاء عن ابن عباس"
"12805","12770  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ الْمُحَارِبِيُّ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى بْنِ الْحَارِثِ ،  عَنْ  أَبِيهِ  ،  عَنْ  بَكْرِ بْنِ وَائِلٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  تَسَمَّوْا بِاسْمِي ، وَلَا تَكَنَّوْا بِكُنْيَتِي  .","","Al-Mu'jam al-Kabir 12770","","عبد الله بن عباس عن أبو رجاء العطاردي عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن بكر بن وائل التيمي عن يعلى بن الحارث بن حرب المحاربي عن يحيى بن يعلى بن الحارث المحاربي عن محمد بن جابر بن بجير المحاربي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أبو رجاء عن ابن عباس"
"12806","12771  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  ثَنَا  أَبُو بَحْرٍ الْبَكْرَاوِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنْ  أَبِي         [12/164]      رَجَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اتَّقُوا النَّارَ وَلَوْ  بِشِقِّ  تَمْرَةٍ  .","","Al-Mu'jam al-Kabir 12771","","عبد الله بن عباس عن أبو رجاء العطاردي عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن أبو بحر البكراوي عن محمد بن بشار بندار عن الحسين بن إسحاق التستري عن الطبراني","أبو رجاء عن ابن عباس"
"12807","[  سَعِيدُ بْنُ أَبِي الْحَسَنِ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12772  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  هَوْذَةُ بْنُ خَلِيفَةَ ،  ثَنَا  عَوْفٌ ،  عَنْ  سَعِيدِ بْنِ أَبِي الْحَسَنِ قَالَ :  كُنْتُ عِنْدَ ابْنِ عَبَّاسٍ إِذْ أَتَاهُ  رَجُلٌ  ، فَقَالَ : إِنِّي إِنْسَانٌ إِنَّمَا مَعِيشَتِي مِنْ صَنْعَةِ يَدِي ، وَأَنَا أَصْنَعُ هَذِهِ التَّصَاوِيرَ ، فَقَالَ  ابْنُ عَبَّاسَ  : لَا أَجِدُ لَكَ إِلَّا مَا سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ صَوَّرَ صُورَةً فَإِنَّ اللهَ يُعَذِّبُهُ يَوْمَ الْقِيَامَةِ حَتَّى يَنْفُخَ  ، وَلَيْسَ بِنَافِخٍ فِيهَا أَبَدًا "" قَالَ : فَرَبَا لَهَا الرَّجُلُ رَبْوَةً شَدِيدَةً ، وَاصْفَرَّ وَجْهُهُ ، ثُمَّ قَالَ : "" وَيْحَكَ إِنْ أَبَيْتَ إِلَّا أَنْ تَصْنَعَ فَعَلَيْكَ بِهَذَا الشَّجَرِ وَكُلِّ شَيْءٍ لَيْسَ فِيهِ رُوحٌ  .","","Al-Mu'jam al-Kabir 12772","","عبد الله بن عباس عن سعيد بن أبي الحسن الأنصاري عن عوف بن أبي جميلة عن هوذة بن خليفة البكراوي عن بشر بن موسى بن صالح الأسدي عن الطبراني","سعيد بن أبي الحسن عن ابن عباس"
"12808","12773  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ،  ثَنَا  قَبِيصَةُ بْنُ عُقْبَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَوْفٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي الْحَسَنِ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 12773","","عبد الله بن عباس عن سعيد بن أبي الحسن الأنصاري عن عوف بن أبي جميلة عن سفيان الثوري عن قبيصة بن عقبة السوائي عن حفص بن عمر سنجة ألف عن الطبراني","سعيد بن أبي الحسن عن ابن عباس"
"12809","[  أَبُو عُثْمَانَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12774  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ  ، ثَنَا  سُرَيْجُ بْنُ         [12/165]      النُّعْمَانِ الْجَوْهَرِيُّ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  ثَنَا  عَاصِمٌ الْأَحْوَلُ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ  الزُّبَيْرَ  حَمَلَ عَلَى فَرَسٍ فِي  سَبِيلِ  اللهِ فَوَجَدَ فَرَسًا مِنْ ضِئْضِئِهَا تُبَاعُ  ، فَنُهِيَ أَنْ يَشْتَرِيَهَا  "" .","","Al-Mu'jam al-Kabir 12774","","عبد الله بن عباس عن أبو عثمان النهدي عن عاصم بن سليمان الأحول عن حماد بن سلمة عن سريج بن النعمان الجوهري عن لحية الليف محمد بن العباس عن الطبراني","أبو عثمان عن ابن عباس"
"12810","[  أَبُو نَضْرَةَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12775  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  يَاسِينُ بْنُ حَمَّادٍ الْمَخْزُومِيُّ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، قَالَا :  ثَنَا  أَبُو عَقِيلٍ الدَّوْرَقِيُّ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ  فِي قَوْلِ اللهِ عَزَّ وَجَلَّ :         {      لا يَسْتَوِي الْقَاعِدُونَ مِنَ الْمُؤْمِنِينَ غَيْرُ أُولِي الضَّرَرِ         }      قَالَ : "" هُمْ قَوْمٌ كَانُوا عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، لَا يَغْزُونَ مَعَهُ لِأَسْقَامٍ ، وَأَمْرَاضٍ ، وَأَوْجَاعٍ ، وَآخَرُونَ أَصِحَّاءُ لَا يَغْزُونَ مَعَهُ ، وَكَانَ الْمَرْضَى فِي عُذْرٍ مِنَ الْأَصِحَّاءِ  "" .","","Al-Mu'jam al-Kabir 12775","","عبد الله بن عباس عن المنذر بن مالك العوقي عن بشير بن عقبة الناجي عن أبو الوليد الطيالسي عن محمد بن محمد بن حيان التمار عن الطبراني","أبو نضرة عن ابن عباس"
"12811","12776  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ، قَالَا :  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شَدَّادُ بْنُ سَعِيدٍ الرَّاسِبِيُّ ،  عَنْ  سَعِيدٍ الْجُرَيْرِيِّ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا مَعْشَرَ شَبَابِ  قُرَيْشٍ  لَا تَزْنُوا  ، مَنْ حَفِظَ فَرْجَهُ فَلَهُ الْجَنَّةُ  .","","Al-Mu'jam al-Kabir 12776","","عبد الله بن عباس عن المنذر بن مالك العوقي عن سعيد بن إياس الجريري عن شداد بن سعيد الراسبي عن مسلم بن إبراهيم الشحام عن أحمد بن داود بن موسى السدوسي عن الطبراني","أبو نضرة عن ابن عباس"
"12812","[12/166]      12777  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَنَا أَوَّلُ مَنْ تَنْشَقُّ لَهُ الْأَرْضُ ، وَلَا  فَخْرَ  "" .","","Al-Mu'jam al-Kabir 12777","","عبد الله بن عباس عن المنذر بن مالك العوقي عن علي بن زيد بن جدعان عن حماد بن سلمة عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","أبو نضرة عن ابن عباس"
"12813","12778  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، وَعَلِيُّ بْنُ بَحْرٍ ، قَالَا :  ثَنَا  غَسَّانُ بْنُ مُضَرَ ،  عَنْ  سَعِيدِ بْنِ يَزِيدَ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  مَنْ سَرَّهُ أَنْ يُحَرِّمَ مَا حَرَّمَ اللهُ وَرَسُولُهُ فَلْيُحَرِّمْ نَبِيذَ  الْجَرِّ  .","","Al-Mu'jam al-Kabir 12778","","عبد الله بن عباس عن المنذر بن مالك العوقي عن سعيد بن يزيد الطاحي عن غسان بن مضر عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","أبو نضرة عن ابن عباس"
"12814","12779  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ (  ح  ) .  وَحَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ  ، ثَنَا  عَبْدُ الْغَفَّارِ بْنُ دَاوُدَ أَبُو صَالِحٍ الْحَرَّانِيُّ ، قَالَا :  ثَنَا  الْبَرَاءُ بْنُ عَبْدِ اللهِ الْغَنَوِيُّ قَالَ :  سَمِعْتُ  أَبَا نَضْرَةَ يَقُولُ :  قَالَ  ابْنُ عَبَّاسٍ إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَتَعَوَّذُ فِي دُبُرِ صَلَاتِهِ مِنْ أَرْبَعٍ يَقُولُ : "" أَعُوذُ بِاللهِ مِنْ عَذَابِ الْقَبْرِ  أَعُوذُ بِاللهِ مِنْ عَذَابِ النَّارِ أَعُوذُ بِاللهِ مِنَ الْفِتَنِ مَا ظَهَرَ مِنْهَا وَمَا بَطَنَ ، أَعُوذُ بِاللهِ مِنْ فِتْنَةِ  الْأَعْوَرِ  الْكَذَّابِ  .","","Al-Mu'jam al-Kabir 12779","","عبد الله بن عباس عن المنذر بن مالك العوقي عن البراء بن عبد الله بن يزيد الغنوي عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","أبو نضرة عن ابن عباس"
"12815","12780  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  بِشْرُ بْنُ         [12/167]      الْمُفَضَّلِ ،  ثَنَا  أَبُو مَسْلَمَةَ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  زُرْتُ خَالَتِي فَوَافَقْتُ لَيْلَةَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِهَا  ، فَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِسَحَرٍ طَوِيلٍ فَأَسْبَغَ الْوُضُوءَ ثُمَّ قَامَ يُصَلِّي ، فَقُمْتُ فَتَوَضَّأْتُ فَجِئْتُ إِلَى جَنْبِهِ فَلَمَّا عَلِمَ أَنِّي أُرِيدُ الصَّلَاةَ أَخَذَ بِيَدِي فَأَقَامَنِي عَنْ يَمِينِهِ ، فَصَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَوْتَرَ  بِسَبْعٍ أَوْ بِتِسْعٍ  ، ثُمَّ رَكَعَ رَكْعَتَيْنِ ، ثُمَّ وَضَعَ جَنْبَهُ حَتَّى سَمِعْتُ  صَفِيرَهُ  ، ثُمَّ أُقِيمَتِ الصَّلَاةُ فَخَرَجَ إِلَى الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 12780","","عبد الله بن عباس عن المنذر بن مالك العوقي عن سعيد بن يزيد الطاحي عن بشر بن المفضل عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو نضرة عن ابن عباس"
"12816","12781  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  سَلَّامٌ الطَّوِيلُ ،  عَنْ  زَيْدٍ الْعَمِّيِّ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" إِذَا رَكَعَ اسْتَوَى  فَلَوْ صُبَّ عَلَى ظَهْرِهِ الْمَاءُ لَاسْتَقَرَّ  .","","Al-Mu'jam al-Kabir 12781","","عبد الله بن عباس عن المنذر بن مالك العوقي عن زيد بن الحواري العمي عن سلام بن سلم الطويل عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","أبو نضرة عن ابن عباس"
"12817","[  زُرَارَةُ بْنُ أَوْفَى  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12782  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  هَوْذَةُ بْنُ خَلِيفَةَ ،  ثَنَا  عَوْفٌ (  ح  ) .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عُثْمَانُ بْنُ الْهَيْثَمِ الْمُؤَذِّنُ ،  عَنْ  عَوْفٍ ،  عَنْ  زُرَارَةَ بْنِ أَوْفَى ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  لَمَّا أُسْرِيَ بِنَبِيِّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَصْبَحَ  بِمَكَّةَ  جَلَسَ مُعْتَزِلًا حَزِينًا ، فَأَتَى عَلَيْهِ عَدُوُّ اللهِ  أَبُو جَهْلٍ  ، فَقَالَ كَالْمُسْتَهْزِئِ : هَلْ كَانَ مِنْ شَيْءٍ ؟ قَالَ : "" نَعَمْ "" قَالَ :  إِنَّهُ أُسْرِيَ بِيَ اللَّيْلَةَ إِلَى  بَيْتِ الْمَقْدِسِ  قَالَ : ثُمَّ         [12/168]      أَصْبَحْتَ بَيْنَ أَظْهُرِنَا ؟ قَالَ : "" نَعَمْ "" فَلَمْ يُرِهِ أَنَّهُ يُكَذِّبُهُ مَخَافَةَ إِنْ دَعَا إِلَيْهِ قَوْمَهُ أَنْ يَجْحَدُوهُ الْحَدِيثَ ، فَقَالَ : أَرَأَيْتَ إِنْ دَعَوْتُ إِلَيْكَ قَوْمَكَ أَتُحَدِّثُهُمْ بِمَا حَدَّثْتَنِي ؟ قَالَ : "" نَعَمْ "" ، فَقَالَ  أَبُو جَهْلٍ  : يَا  بَنِي كَعْبِ بْنِ لُؤَيٍّ  هَلُمَّ فَانَتَقَصَتِ الْمَجَالِسُ حَتَّى جَلَسُوا إِلَيْهِمَا ، فَقَالَ  أَبُو جَهْلٍ  : حَدِّثْ قَوْمَكَ بِمَا حَدَّثْتَنِي ، فَقَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّهُ أُسْرِيَ بِيَ اللَّيْلَةَ "" ، فَقَالَ : إِلَى أَيْنَ ؟ قَالَ : "" إِلَى  بَيْتِ الْمَقْدِسِ  "" ، قَالُوا : ثُمَّ أَصْبَحْتَ بَيْنَ أَظْهُرِنَا ؟ قَالَ : "" نَعَمْ "" فَمِنْ مُصَفِّقٍ ، وَمِنْ وَاضِعٍ يَدَهُ عَلَى رَأْسِهِ مُسْتَعْجِبًا لِلْكَذِبِ زَعَمَ وَفِي  الْقَوْمِ  مَنْ قَدْ سَافَرَ إِلَى ذَلِكَ الْمَسْجِدِ وَرَآهُ ، فَقَالُوا : أَتَسْتَطِيعُ أَنْ تَنْعَتَ لَنَا الْمَسْجِدَ ؟ قَالَ : "" نَعَمْ "" قَالَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" فَنَعَتُّهُ لَهُمْ حَتَّى الْتَبَسَ عَلَيَّ بَعْضُ النَّعْتِ "" قَالَ : "" فَجِيءَ بِالْمَسْجِدِ وَأَنَا أَنْظُرُ إِلَيْهِ حَتَّى وُضِعَ دُونَ  دَارِ عَقِيلٍ  أَوْ  دَارِ عِقَالٍ  ، فَجَعَلْتُ أَنْعَتُهُ وَأَنَا أَنْظُرُ إِلَيْهِ "" ، فَقَالَ  الْقَوْمُ  : أَمَّا النَّعْتُ فَوَاللهِ قَدْ أَصَابَ  .","","Al-Mu'jam al-Kabir 12782","","عبد الله بن عباس عن زرارة بن أوفى عن عوف بن أبي جميلة عن عثمان بن الهيثم بن جهم الأشج عن أبو مسلم الكجي عن الطبراني","زرارة بن أوفى عن ابن عباس"
"12818","12783  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي سُوَيْدٍ الذَّارِعُ ،  ثَنَا  صَالِحٌ الْمُرِّيُّ ،  عَنْ  قَتَادَةَ ،  عَنْ  زُرَارَةَ بْنِ أَوْفَى ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  سَأَلَ  رَجُلٌ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : أَيُّ الْكَلَامِ أَحَبُّ إِلَى اللهِ ؟ قَالَ : ""  الْحَالُّ  الْمُرْتَحِلُ "" قَالَ : يَا رَسُولَ اللهِ ، مَا  الْحَالُّ  الْمُرْتَحِلُ ؟ قَالَ :  صَاحِبُ الْقُرْآنِ يَضْرِبُ فِي أَوَّلِهِ حَتَّى يَبْلُغَ آخِرَهُ  ، وَفِي آخِرِهِ حَتَّى يَبْلُغَ أَوَّلَهُ  .","","Al-Mu'jam al-Kabir 12783","","عبد الله بن عباس عن زرارة بن أوفى عن قتادة بن دعامة عن صالح بن بشير المري عن إبراهيم بن الفضل بن أبي سويد الذارع عن معاذ بن المثنى العنبري عن الطبراني","زرارة بن أوفى عن ابن عباس"
"12819","[12/169]      12784  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  شَبَابٌ الْعُصْفُرِيُّ ،  ثَنَا  عَمْرُو بْنُ عَاصِمٍ ،  ثَنَا  صَالِحٌ الْمُرِّيُّ ،  عَنْ  قَتَادَةَ ،  عَنْ  زُرَارَةَ بْنِ أَوْفَى ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، يَنْفَعُ الدَّوَاءُ مِنَ الْقَدَرِ ؟ قَالَ :  الدَّوَاءُ مِنَ الْقَدَرِ ، وَقَدْ يَنْفَعُ بِإِذْنِ اللهِ  "" .","","Al-Mu'jam al-Kabir 12784","","عبد الله بن عباس عن زرارة بن أوفى عن قتادة بن دعامة عن صالح بن بشير المري عن عمرو بن عاصم الكلابي عن خليفة بن خياط عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","زرارة بن أوفى عن ابن عباس"
"12820","[  يَحْيَى بْنُ يَعْمَرَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12785  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ (  ح  ) .  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ قَالَا :  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  يَحْيَى بْنِ يَعْمَرَ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" انْتَهَشَ مِنْ كَتِفٍ ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ  "" .","","Al-Mu'jam al-Kabir 12785","","عبد الله بن عباس عن يحيى بن يعمر الجدلي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن حفص بن عمر الحوضى عن عثمان بن عمر الضبي عن الطبراني","يحيى بن يعمر عن ابن عباس"
"12821","[  أَبُو الْجَوْزَاءِ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12786  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ  ، ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ الْعَمِّيُّ ،  ثَنَا  سَعِيدُ بْنُ سُفْيَانَ الْجَحْدَرِيُّ ،  ثَنَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  عَنْ  عُقْبَةَ بْنِ أَبِي ثُبَيْتٍ الرَّاسِبِيِّ ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اذْكُرُوا اللهَ ذِكْرًا يَقُولُ الْمُنَافِقُونَ إِنَّكُمْ تُرَاءُونَ  .","","Al-Mu'jam al-Kabir 12786","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عقبة بن أبي ثبيت الراسبي عن الحسن بن أبي جعفر الجفري عن سعيد بن سفيان الجحدري عن عقبة بن مكرم عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو الجوزاء عن ابن عباس"
"12822","[12/170]      12787  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  أَبُو هِلَالٍ الرَّاسِبِيُّ ،  ثَنَا  عُقْبَةُ بْنُ أَبِي ثُبَيْتٍ الرَّاسِبِيُّ ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَهْلُ الْجَنَّةِ مَنْ مَلَأَ أُذُنَيْهِ مِنْ ثَنَاءِ النَّاسِ خَيْرًا وَهُوَ يَسْمَعُ  ، وَأَهْلُ النَّارِ مَنْ مَلَأَ أُذُنَيْهِ مِنْ ثَنَاءِ النَّاسِ شَرًّا وَهُوَ يَسْمَعُ  .","","Al-Mu'jam al-Kabir 12787","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عقبة بن أبي ثبيت الراسبي عن محمد بن سليم الراسبي عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو الجوزاء عن ابن عباس"
"12823","12788  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ مُحَمَّدٍ التَّيْمِيُّ ،  ثَنَا  صَالِحُ بْنُ عَبْدِ اللهِ أَبُو يَحْيَى ،  عَنْ  عَمْرِو بْنِ مَالِكٍ النُّكْرِيِّ ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَخَذَ بِعِضَادَتَيِ الْبَابِ ، وَنَحْنُ فِي الْبَيْتِ ، فَقَالَ :  يَا  بَنِي عَبْدِ الْمُطَّلِبِ  هَلْ فِيكُمْ أَحَدٌ مِنْ غَيْرِكُمْ ؟  قَالُوا : ابْنُ أُخْتٍ لَنَا ، فَقَالَ : "" ابْنُ أُخْتِ  الْقَوْمِ  مِنْهُمْ "" ، ثُمَّ قَالَ : "" يَا  بَنِي عَبْدِ الْمُطَّلِبِ  إِذَا نَزَلَ بِكُمْ كَرْبٌ أَوْ حُمَةٌ أَوْ  جَهْدٌ  أَوْ  لَأْوَاءٌ  فَقُولُوا اللهُ اللهُ رَبُّنَا لَا شَرِيكَ لَهُ  .","","Al-Mu'jam al-Kabir 12788","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن صالح بن عبد الله البصري عن ابن عائشة عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو الجوزاء عن ابن عباس"
"12824","12789  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ الضُّبَعِيُّ ،  ثَنَا  عَمْرُو بْنُ مَالِكٍ ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ  فِي قَوْلِهِ :         {      لَهُ مُعَقِّبَاتٌ مِنْ بَيْنِ يَدَيْهِ وَمِنْ خَلْفِهِ         }      قَالَ "" لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .","","Al-Mu'jam al-Kabir 12789","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن جعفر بن سليمان الضبعي عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو الجوزاء عن ابن عباس"
"12825","12790  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  يَحْيَى بْنُ عَمْرِو بْنِ مَالِكٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ         [12/171]      عَبَّاسٍ  فِي قَوْلِهِ :         {      يَوْمَ نَطْوِي السَّمَاءَ كَطَيِّ السِّجِلِّ لِلْكُتُبِ         }      قَالَ : "" كَانَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَاتِبٌ يُدْعَى  السِّجِلَّ  "" .","","Al-Mu'jam al-Kabir 12790","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن يحيى بن عمرو النكري عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو الجوزاء عن ابن عباس"
"12826","12791  -  حَدَّثَنَا  مُحَمَّدُ بْنُ التَّمَّارِ الْبَصْرِيُّ  ، ثَنَا  بِشْرُ بْنُ حُجْرٍ السَّامِيُّ (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  عَفَّانُ ، قَالَا :  ثَنَا  نُوحُ بْنُ قَيْسٍ ،  عَنْ  عَمْرِو بْنِ مَالِكٍ النُّكْرِيِّ ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَتِ  امْرَأَةٌ  جَمِيلَةٌ تُصَلِّي خَلْفَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، فَكَانَ نَاسٌ يَتَقَدَّمُونَ ، وَنَاسٌ يَتَأَخَّرُونَ لِيَنْظُرُوا إِلَيْهَا "" فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      وَلَقَدْ عَلِمْنَا الْمُسْتَقْدِمِينَ مِنْكُمْ وَلَقَدْ عَلِمْنَا الْمُسْتَأْخِرِينَ         }      .","","Al-Mu'jam al-Kabir 12791","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن نوح بن قيس بن رباح الحداني عن عفان بن مسلم الصفار عن أحمد بن محمد بن أحمد الجواربي عن الطبراني","أبو الجوزاء عن ابن عباس"
"12827","12792  -  حَدَّثَنَا  مُحَمَّدُ بْنُ زَكَرِيَّا الْغَلَّابِيُّ  ، ثَنَا  جَعْفَرُ بْنُ جَسْرِ بْنِ فَرْقَدٍ ،  ثَنَا  أَبِي  ،  عَنْ  عَمْرِو بْنِ مَالِكٍ ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ         [12/172]      عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اسْمُ اللهِ الْأَعْظَمُ الَّذِي إِذَا دُعِيَ بِهِ أَجَابَ فِي هَذِهِ الْآيَةِ  مِنْ  آلِ عِمْرَانَ  :         {      قُلِ اللَّهُمَّ مَالِكَ الْمُلْكِ تُؤْتِي الْمُلْكَ مَنْ تَشَاءُ         }      إِلَى آخِرِهِ  .","","Al-Mu'jam al-Kabir 12792","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن جسر بن فرقد القصاب عن جعفر بن جسر بن فرقد عن محمد بن زكريا بن دينار الإخباري عن الطبراني","أبو الجوزاء عن ابن عباس"
"12828","12793  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ التُّسْتَرِيُّ  ، ثَنَا  الْمُنْذِرُ بْنُ الْوَلِيدِ الْجَارُودِيُّ ،  عَنْ  أَبِيهِ  ،  ثَنَا  مَالِكُ بْنُ يَحْيَى بْنِ عَمْرِو بْنِ مَالِكٍ النُّكْرِيُّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ عَمْرِو بْنِ مَالِكٍ النُّكْرِيُّ  ، عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ  حَلَفَ  عَلَى يَمِينٍ فَرَأَى غَيْرَهَا خَيْرًا مِنْهَا فَلْيَأْتِهَا  ، فَإِنَّهَا كَفَّارَتُهَا إِلَّا طَلَاقٍ أَوْ عَتَاقٍ  .","","Al-Mu'jam al-Kabir 12793","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن يحيى بن عمرو النكري عن مالك بن يحيى بن عمرو النكري عن الوليد بن عبد الرحمن بن حبيب الجارودي عن المنذر بن الوليد بن عبد الرحمن الجارودي عن سعيد بن عبد الرحمن التستري عن الطبراني","أبو الجوزاء عن ابن عباس"
"12829","12794  -  حَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ  ، ثَنَا  أَحْمَدُ بْنُ عَبْدِ الْمَلِكِ بْنِ وَاقِدٍ الْحَرَّانِيُّ ،  ثَنَا  يَحْيَى بْنُ عَمْرِو بْنِ مَالِكٍ النُّكْرِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ لَمْ تُذْنِبُوا لَجَاءَ اللهُ بِقَوْمٍ يُذْنِبُونَ فَيَغْفِرُ لَهُمْ  .","","Al-Mu'jam al-Kabir 12794","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن يحيى بن عمرو النكري عن أحمد بن عبد الملك بن واقد الحراني عن أبو شعيب الحراني عن الطبراني","أبو الجوزاء عن ابن عباس"
"12830","12795  -  حَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ  ، ثَنَا  أَحْمَدُ بْنُ عَبْدِ الْمَلِكِ بْنِ وَاقِدٍ الْحَرَّانِيُّ ،  ثَنَا  يَحْيَى بْنُ عَمْرِو بْنِ مَالِكٍ النُّكْرِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَفَّارَةُ الذَّنْبِ النَّدَامَةُ  .","","Al-Mu'jam al-Kabir 12795","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن يحيى بن عمرو النكري عن أحمد بن عبد الملك بن واقد الحراني عن أبو شعيب الحراني عن الطبراني","أبو الجوزاء عن ابن عباس"
"12831","[12/173]      12796  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْخُزَاعِيُّ الْأَصْبَهَانِيُّ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ (  ح  ) .  وَحَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْوَهَّابِ الْحَجَبِيُّ ، قَالَا :  ثَنَا  يَحْيَى بْنُ عَمْرِو بْنِ مَالِكٍ النُّكْرِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِذَا انْصَرَفَ مِنَ الصَّلَاةِ قَالَ : "" لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ لَهُ الْمُلْكُ  ، وَلَهُ الْحَمْدُ يُحْيِي وَيُمِيتُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٍ ، اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 12796","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن يحيى بن عمرو النكري عن عبد الله بن عبد الوهاب الحجبي عن الفضل بن الحباب الجمحي عن الطبراني","أبو الجوزاء عن ابن عباس"
"12832","12797  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  أَحْمَدُ بْنُ سَلْمٍ الْعُمَيْرِيُّ ،  ثَنَا  مَالِكُ بْنُ يَحْيَى بْنِ عَمْرِو بْنِ مَالِكٍ النُّكْرِيُّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ عَمْرِو بْنِ مَالِكٍ  ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : "" إِنَّ اللهَ قَالَ :  أَنَا خَلَقْتُ الْخَيْرَ وَالشَّرَّ فَطُوبَى لِمَنْ قَدَرْتُ عَلَى يَدِهِ الْخَيْرَ  ، وَوَيْلٌ لِمَنْ قَدَرْتُ عَلَى يَدِهِ الشَّرَّ  .","","Al-Mu'jam al-Kabir 12797","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن يحيى بن عمرو النكري عن مالك بن يحيى بن عمرو النكري عن أحمد بن سلم العميري عن الساجي عن الطبراني","أبو الجوزاء عن ابن عباس"
"12833","12798  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  أَحْمَدُ بْنُ         [12/174]      سَلْمٍ الْعُمَيْرِيُّ ،  ثَنَا  مَالِكُ بْنُ يَحْيَى ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ عَمْرِو بْنِ مَالِكٍ  ، عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَمْ أَرَ شَيْئًا أَحْسَنَ طَلَبًا ، وَلَا أَسْرَعَ إِدْرَاكًا مِنْ حَسَنَةٍ حَدِيثَةٍ  لِذَنْبٍ قَدِيمٍ         {      إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ ذَلِكَ ذِكْرَى لِلذَّاكِرِينَ         }      .","","Al-Mu'jam al-Kabir 12798","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن يحيى بن عمرو النكري عن مالك بن يحيى بن عمرو النكري عن أحمد بن سلم العميري عن الساجي عن الطبراني","أبو الجوزاء عن ابن عباس"
"12834","12799  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عَقِيلٍ ،  ثَنَا  مَالِكُ بْنُ يَحْيَى بْنِ عَمْرِو بْنِ مَالِكٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَمْرِو بْنِ مَالِكٍ  ، عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ  رَفَعَ  الْحَدِيثَ أَنَّهُ قَالَ :  مَنْ قَالَ : "" سُبْحَانَ اللهِ وَبِحَمْدِهِ أَسْتَغْفِرُ اللهَ وَأَتُوبُ إِلَيْهِ  ، إِلَّا كُتِبَتْ كَمَا قَالَهَا ، ثُمَّ عُلِّقَتْ بِالْعَرْشِ ، وَلَا يَمْحُوهَا ذَنْبٌ عَمِلَهُ صَاحِبُهَا حَتَّى يَلْقَى اللهَ ، وَهِيَ مَخْتُومَةٌ كَمَا قَالَهَا  .","","Al-Mu'jam al-Kabir 12799","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن يحيى بن عمرو النكري عن مالك بن يحيى بن عمرو النكري عن محمد بن عبد الله بن عبيد بن عقيل الهلالي عن سعيد بن عبد الرحمن التستري عن الطبراني","أبو الجوزاء عن ابن عباس"
"12835","12800  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ ،  عَنْ  حَمَّادِ بْنِ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ مَالِكٍ ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، وَلَا نَعْلَمُهُ إِلَّا  رَفَعَهُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  بُنِيَ الْإِسْلَامُ عَلَى خَمْسٍ  : شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَالصَّلَاةِ ، وَصِيَامِ رَمَضَانَ فَمَنْ تَرَكَ وَاحِدَةً مِنْهُنَّ كَانَ كَافِرًا حَلَالَ الدَّمِ  .","","Al-Mu'jam al-Kabir 12800","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن حماد بن زيد عن مؤمل بن إسماعيل العدوي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","أبو الجوزاء عن ابن عباس"
"12836","12801  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَإِبْرَاهِيمُ بْنُ         [12/175]      مَتُّوَيْهِ ، قَالَا :  حَدَّثَنِي  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي الشَّوَارِبِ ،  ثَنَا  يَحْيَى بْنُ عَمْرِو بْنِ مَالِكٍ النُّكْرِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  ضَرَبَ بَعْضُ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خِبَاءً عَلَى قَبْرٍ ، وَلَا يَحْسَبُ أَنَّهُ قَبْرٌ فَإِذَا هُوَ  إِنْسَانٌ  يَقْرَأُ :         {      تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ         }      حَتَّى خَتَمَهَا فَأَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ضَرَبْتُ خِبَائِي عَلَى قَبْرٍ ، وَأَنَا لَا أَحْسَبُ أَنَّهُ قَبْرٌ فَإِذَا إِنْسَانٌ يَقْرَأُ تَبَارَكَ حَتَّى خَتَمَهَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هِيَ الْمَانِعَةُ هِيَ الْمُنْجِيَةُ تُنْجِيهِ مِنْ عَذَابِ الْقَبْرِ  .","","Al-Mu'jam al-Kabir 12801","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن يحيى بن عمرو النكري عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن إبراهيم بن محمد الطيان عن الطبراني","أبو الجوزاء عن ابن عباس"
"12837","12802  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ الْجُنْدَيْسَابُورِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ لُوَيْنٌ ،  ثَنَا  رَوْحُ بْنُ الْمُسَيِّبِ ،  عَنْ  عَمْرِو بْنِ مَالِكٍ النُّكْرِيِّ ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ :         {      وَإِذَا ذَكَرْتَ رَبَّكَ فِي الْقُرْآنِ وَحْدَهُ وَلَّوْا عَلَى أَدْبَارِهِمْ نُفُورًا         }      قَالَ : "" الشَّيَاطِينُ  "" .","","Al-Mu'jam al-Kabir 12802","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن روح بن المسيب الكلبي عن محمد بن سليمان لوين عن محمد بن جابان الجند يسابوري عن الطبراني","أبو الجوزاء عن ابن عباس"
"12838","[  الْحَسَنُ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12803  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ بْنِ عَبْدَوَيْهِ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ عَطَاءٍ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ فِي  جَهَنَّمَ  لَوَادِيًا تَسْتَعِيذُ  جَهَنَّمُ  مِنْ ذَلِكَ الْوَادِي فِي كُلِّ يَوْمٍ أَرْبَعَمِائَةِ مَرَّةٍ  أُعِدَّ ذَلِكَ الْوَادِي         [12/176]      لِلْمُرَائِينَ مِنْ أُمَّةِ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لِحَامِلِ كِتَابِ اللهِ ، وَلِلْمُصَّدِّقِ فِي غَيْرِ ذَاتِ اللهِ ، وَلِلْحُجَّاجِ إِلَى  بَيْتِ اللهِ  ، وَلِلْخَارِجِ فِي  سَبِيلِ  اللهِ  .","","Al-Mu'jam al-Kabir 12803","","عبد الله بن عباس عن الحسن البصري عن يونس بن عبيد عن عبد الوهاب بن عطاء الخفاف عن عبد الله بن عبدويه الصفار عن يحيى بن عبد الله بن عبدويه عن الطبراني","الحسن عن ابن عباس"
"12839","12804  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ بْنِ عَبْدَوَيْهِ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ عَطَاءٍ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  عَبْدٌ أَطَاعَ اللهَ ، وَأَطَاعَ مَوَالِيَهُ أَدْخَلَهُ اللهُ الْجَنَّةَ قَبْلَ مَوَالِيهِ بِسَبْعِينَ  خَرِيفًا  ، فَيَقُولُ السَّيِّدُ : يَا رَبِّ هَذَا كَانَ عَبْدِي  فِي الدُّنْيَا قَالَ : جَازَيْتُهُ بِعَمَلِهِ وَجَازَيْتُكَ بِعَمَلِكَ  .  تصحفت في طبعة مكتبة ابن تيمية : ( عندي ) وهي على الصواب في النسخ الخطية.","","Al-Mu'jam al-Kabir 12804","","عبد الله بن عباس عن الحسن البصري عن يونس بن عبيد عن عبد الوهاب بن عطاء الخفاف عن عبد الله بن عبدويه الصفار عن يحيى بن عبد الله بن عبدويه عن الطبراني","الحسن عن ابن عباس"
"12840","[  أَبُو الشَّعْثَاءِ جَابِرُ بْنُ زَيْدٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12805  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  أَبِي الشَّعْثَاءِ ، أَنَّ ابْنَ عَبَّاسٍ  أَخْبَرَهُ  قَالَ :  صَلَّيْتُ وَرَاءَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَمَانِيًا جَمِيعًا  ، وَسَبْعًا جَمِيعًا  .","","Al-Mu'jam al-Kabir 12805","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو الشعثاء جابر بن زيد عن ابن عباس"
"12841","12806  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  ثَنَا         [12/177]      يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  رَوْحُ بْنُ الْقَاسِمِ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَمَانِيًا  ، وَسَبْعًا جَمِيعًا  .","","Al-Mu'jam al-Kabir 12806","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن روح بن القاسم العنبري عن يزيد بن زريع العيشي عن محمد بن المنهال عن معاذ بن المثنى العنبري عن الطبراني","أبو الشعثاء جابر بن زيد عن ابن عباس"
"12842","12807  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ الطَّائِفِيُّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثَمَانِ رَكَعَاتٍ جَمِيعًا  ، وَسَبْعَ رَكَعَاتٍ جَمِيعًا مِنْ غَيْرِ مَرَضٍ ، وَلَا عِلَّةٍ  .","","Al-Mu'jam al-Kabir 12807","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن داود بن عمرو المسيبي عن موسى بن هارون الحمال عن الطبراني","أبو الشعثاء جابر بن زيد عن ابن عباس"
"12843","12808  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" صَلَّى  بِالْمَدِينَةِ  سَبْعًا وَثَمَانِيًا  ، الظُّهْرَ وَالْعَصْرَ ، وَالْمَغْرِبَ وَالْعِشَاءَ  .","","Al-Mu'jam al-Kabir 12808","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو الشعثاء جابر بن زيد عن ابن عباس"
"12844","بَابٌ  12809  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ لَمْ يَجِدْ إِزَارًا لَبِسَ سَرَاوِيلَ  ، وَمَنْ لَمْ يَجِدْ نَعْلَيْنِ لَبِسَ خُفَّيْنِ  .","","Al-Mu'jam al-Kabir 12809","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"12845","12810  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،         [12/178]      عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  السَّرَاوِيلُ لِمَنْ لَمْ يَجِدِ الْإِزَارَ  ، وَالْخِفَافُ لِمَنْ لَمْ يَجِدِ النَّعْلَيْنِ  يَعْنِي الْمُحْرِمَ  .","","Al-Mu'jam al-Kabir 12810","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"12846","12811  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  صَالِحُ بْنُ حَاتِمِ بْنِ وَرْدَانَ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  أَيُّوبُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُحْرِمُ إِذَا لَمْ يَجِدِ الْإِزَارَ فَلْيَلْبَسِ السَّرَاوِيلَ  ، وَإِذَا لَمْ يَجِدِ النَّعْلَيْنِ فَلْيَلْبَسِ الْخُفَّيْنِ  .","","Al-Mu'jam al-Kabir 12811","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن أيوب السختياني عن يزيد بن زريع العيشي عن صالح بن حاتم بن وردان البصري عن الحسين بن إسحاق التستري عن الطبراني","باب"
"12847","12812  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سُهَيْلُ بْنُ عُثْمَانَ  ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  أَبِي الشَّعْثَاءِ جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَطَبَهُمْ ، فَقَالَ :  إِذَا لَمْ يَجِدِ الْمُحْرِمُ إِزَارًا فَلْيَلْبَسْ سَرَاوِيلَ  ، وَإِذَا لَمْ يَجِدْ نَعْلَيْنِ فَخُفَّيْنِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( سهل بن عثمان )","","Al-Mu'jam al-Kabir 12812","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن أشعث بن سوار عن محمد بن فضيل بن غزوان عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","باب"
"12848","12813  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ ،  ثَنَا  سَعِيدُ بْنُ زَيْدٍ ،  ثَنَا  عَمْرُو بْنُ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَطَبَ النَّاسَ  بِعَرَفَةَ  فَقَالَ :  مَنْ لَمْ يَجِدْ نَعْلَيْنِ فَلْيَلْبَسْ خُفَّيْنِ  ، وَمَنْ لَمْ يَجِدْ إِزَارًا فَلْيَلْبَسْ سَرَاوِيلَ  .","","Al-Mu'jam al-Kabir 12813","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن سعيد بن زيد الجهضمي عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"12849","12814  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ  ، ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ حَيَّانَ الْمَازِنِيُّ  ، ثَنَا  أَبُو ظَفَرٍ عَبْدُ السَّلَامِ         [12/179]      بْنُ مُطَهَّرٍ ، قَالُوا :  ثَنَا  شُعْبَةُ ،  أَخْبَرَنِي  عَمْرُو بْنُ دِينَارٍ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ زَيْدٍ ، يَقُولُ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ :  سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ  بِعَرَفَاتٍ  وَهُوَ يَقُولُ :  مَنْ لَمْ يَجِدِ النَّعْلَيْنِ فَلْيَلْبَسِ الْخُفَّيْنِ  ، وَمَنْ لَمْ يَجِدْ إِزَارًا فَلْيَلْبَسْ سَرَاوِيلَ  .","","Al-Mu'jam al-Kabir 12814","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن عبد السلام بن مطهر الأزدي عن محمد بن حيان المازني عن الطبراني","باب"
"12850","12815  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ أَنَّ أَبَا الشَّعْثَاءِ جَابِرَ بْنَ زَيْدٍ  أَخْبَرَهُ  أَنَّ ابْنَ عَبَّاسٍ  أَخْبَرَهُ  أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ لَمْ يَجِدِ الْإِزَارَ ، وَوَجَدَ سَرَاوِيلَ فَلْيَلْبَسْهُ  ، وَمَنْ لَمْ يَجِدْ نَعْلَيْنِ ، وَوَجَدَ خُفَّيْنِ فَلْيَلْبَسْهُمَا  .","","Al-Mu'jam al-Kabir 12815","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن ابن جريج عن يحيى القطان عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","باب"
"12851","12816  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  عَبَّادِ بْنِ الْعَوَّامِ ،  عَنْ  سُفْيَانَ بْنِ حُسَيْنٍ ،  عَنْ  يَعْلَى بْنِ مُسْلِمٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ آخَا بَيْنَ  الزُّبَيْرِ  ،  وَابْنِ مَسْعُودٍ  .","","Al-Mu'jam al-Kabir 12816","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن يعلى بن مسلم بن هرمز المكي عن سفيان بن حسين المعلم عن عباد بن العوام الكلابي عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","باب"
"12852","12817  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  عَبَّادِ بْنِ الْعَوَّامِ ،  عَنْ  سُفْيَانَ بْنِ حُسَيْنٍ ،  عَنْ  يَعْلَى بْنِ مُسْلِمٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ :         {      وَلا تَقُولَنَّ لِشَيْءٍ إِنِّي فَاعِلٌ ذَلِكَ غَدًا             *          إِلا أَنْ يَشَاءَ اللهُ وَاذْكُرْ رَبَّكَ إِذَا نَسِيتَ         }      أَنْ تَقُولَ : إِنْ شَاءَ اللهُ  "" .","","Al-Mu'jam al-Kabir 12817","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن يعلى بن مسلم بن هرمز المكي عن سفيان بن حسين المعلم عن عباد بن العوام الكلابي عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","باب"
"12853","12818  -  حَدَّثَنَا  أَحْمَدُ بْنُ شُعَيْبٍ أَبُو عَبْدِ الرَّحْمَنِ النَّسَائِيُّ  ، أَخْبَرَنِي  الْحُسَيْنُ بْنُ مَنْصُورٍ ،  ثَنَا  مُبَشِّرُ بْنُ عَبْدِ اللهِ ،  ثَنَا  سُفْيَانُ بْنُ         [12/180]      حُسَيْنٍ ،  عَنْ  يَعْلَى بْنِ مُسْلِمٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  وَأَبَا بَكْرٍ  ،  وَعُمَرَ  ، وَأَصْحَابَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانُوا مُهَاجِرِينَ  لِأَنَّهُمْ هَجَرُوا الْمُشْرِكِينَ ، وَكَانَ مِنَ  الْأَنْصَارِ  مُهَاجِرُونَ لِأَنَّ  الْمَدِينَةَ  كَانَتْ دَارًا تُنْزَلُ فَجَاءُوا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيْلَةَ  الْعَقَبَةِ  .","","Al-Mu'jam al-Kabir 12818","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن يعلى بن مسلم بن هرمز المكي عن سفيان بن حسين المعلم عن مبشر بن عبد الله بن رزين القهندزي عن الحسين بن منصور النيسابوري عن النسائي عن الطبراني","باب"
"12854","12819  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  جُبَارَةُ بْنُ مُغَلِّسٍ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ نَسِيَ الصَّلَاةَ عَلَيَّ خَطِئَ طَرِيقَ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 12819","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن حماد بن زيد عن جبارة بن المغلس عن عبد الله بن أحمد الجواليقي عن الطبراني","باب"
"12855","12820  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ الْمُحَارِبِيُّ ،  ثَنَا  عُمَرُ بْنُ عُبَيْدٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، عَنْ لُحُومِ الْحُمُرِ  ، وَأَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِلُحُومِ الْخَيْلِ أَنْ تُؤْكَلَ  .","","Al-Mu'jam al-Kabir 12820","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن سماك بن حرب البكري عن عمر بن عبيد الطنافسي عن محمد بن عبيد بن محمد بن واقد النحاس عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"12856","12821  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُرِيدَ عَلَى  بِنْتِ حَمْزَةَ  فَقَالَ :  إِنَّهَا         [12/181]      لَا تَصْلُحُ لِي ، إِنَّهَا ابْنَةُ أَخِي مِنَ الرَّضَاعَةِ  ، وَيَحْرُمُ مِنَ الرَّضَاعَةِ مَا يَحْرُمُ مِنَ النَّسَبِ  .","","Al-Mu'jam al-Kabir 12821","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"12857","12822  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُرِيدَ عَلَى  بِنْتِ حَمْزَةَ  فَقَالَ :  إِنَّهَا بِنْتُ أَخِي مِنَ الرَّضَاعَةِ  ، وَإِنَّهُ يَحْرُمُ مِنَ الرَّضَاعَةِ مَا يَحْرُمُ مِنَ النَّسَبِ  .","","Al-Mu'jam al-Kabir 12822","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن محمد بن المنهال عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","باب"
"12858","12823  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قِيلَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَلَا تَزَوَّجُ  بِنْتَ حَمْزَةَ  ؟ قَالَ :  إِنَّهَا بِنْتُ أَخِي مِنَ الرَّضَاعَةِ  .","","Al-Mu'jam al-Kabir 12823","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن قتادة بن دعامة عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب"
"12859","12824  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ  رَفَعَهُ  شُعْبَةُ  قَالَ :  يَقْطَعُ الصَّلَاةَ الْكَلْبُ الْأَسْوَدُ  ، وَالْمَرْأَةُ الْحَائِضُ  .","","Al-Mu'jam al-Kabir 12824","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن قتادة بن دعامة عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب"
"12860","12825  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْحُسَيْنِ الْمِصِّيصِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  ثَنَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  جَمَعَ بَيْنَ الصَّلَاتَيْنِ فِي  غَزْوَةِ بَنِي الْمُصْطَلِقِ  .","","Al-Mu'jam al-Kabir 12825","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن محمد بن بكار العاملي عن عبد الله بن الحسين بن جابر المصيصي عن الطبراني","باب"
"12861","12826  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  مُحَمَّدُ بْنُ         [12/182]      عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ  ، عَنِ  ابْنِ عَبَّاسٍ قَالَ :  مِنَ السُّنَّةِ الْجَمْعُ بَيْنَ الصَّلَاتَيْنِ فِي السَّفَرِ  "" .","","Al-Mu'jam al-Kabir 12826","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبدة بن سليمان الكلابي عن محمد بن عبد الله بن نمير عن محمد بن عبدوس السراج عن الطبراني","باب"
"12862","12827  -  حَدَّثَنَا  الْقَاسِمُ بْنُ زَكَرِيَّا ، وَالْحُسَيْنُ بْنُ أَحْمَدَ بْنِ بِسْطَامٍ الزَّعْفَرَانِيُّ قَالَا :  ثَنَا  يُوسُفُ بْنُ حَمَّادٍ الْمَعْنِيُّ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْبَغَايَا اللَّاتِي يُنْكِحْنَ أَنْفُسَهُنَّ بِغَيْرِ بَيِّنَةٍ  .","","Al-Mu'jam al-Kabir 12827","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الأعلى بن عبد الأعلى القرشي عن يوسف بن حماد البصري عن الحسين بن أحمد بن بسطام الزعفراني عن الطبراني","باب"
"12863","12828  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  عَمْرُو بْنُ عَبْدِ اللهِ الْأَوْدِيُّ ،  ثَنَا  وَكِيعٌ ،  عَنْ  سَعِيدِ بْنِ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ  ، عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  الْخِتَانُ سُنَّةٌ لِلرِّجَالِ  مَكْرُمَةٌ لِلنِّسَاءِ  "" .","","Al-Mu'jam al-Kabir 12828","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن وكيع بن الجراح عن عمرو بن عبد الله بن حنش عن أحمد بن يحيى بن زهير التستري عن الطبراني","باب"
"12864","12829  -  حَدَّثَنَا  السَّرِيُّ بْنُ سَهْلٍ الْجُنْدَيْسَابُورِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ رُشَيْدٍ ،  ثَنَا  مُجَّاعَةُ بْنُ الزُّبَيْرِ ،  عَنْ  قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يُؤْتَى بِالشَّهِيدِ يَوْمَ الْقِيَامَةِ فَيُنْصَبُ لِلْحِسَابِ  ، وَيُؤْتَى بِالْمُتَصَدِّقِ فَيُنْصَبُ لِلْحِسَابِ ، ثُمَّ يُؤْتَى بِأَهْلِ الْبَلَاءِ ، وَلَا يُنْصَبُ لَهُمْ مِيزَانٌ ، وَلَا يُنْشَرُ لَهُمْ دِيوَانٌ ، فَيُصَبُّ عَلَيْهِمُ الْأَجْرُ صَبًّا حَتَّى إِنَّ أَهْلَ الْعَافِيَةِ         [12/183]      لَيَتَمَنَّوْنَ فِي الْمَوْقِفِ أَنَّ أَجْسَادَهُمْ قُرِضَتْ بِالْمَقَارِيضِ ؛ مِنْ حُسْنِ ثَوَابِ اللهِ لَهُمْ  .","","Al-Mu'jam al-Kabir 12829","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن قتادة بن دعامة عن مجاعة بن الزبير عن عبد الله بن رشيد الجند يسابوري عن السري بن سهل الجند يسابوري عن الطبراني","باب"
"12865","12830  -  حَدَّثَنَا  أَحْمَدُ عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،  ثَنَا  عَمْرُو بْنُ يَحْيَى بْنِ أَبِي حَبِيبٍ ،  ثَنَا  حَبِيبُ بْنُ أَبِي حَبِيبٍ ،  عَنْ  عَمْرِو بْنِ هَرِمٍ ، قَالَ :  سُئِلَ  جَابِرُ بْنُ زَيْدٍ عَنِ الصَّلَاةِ ، وَمَوَاقِيتِهَا ، فَقَالَ :  قَالَ  ابْنُ عَبَّاسٍ :  إِنَّ صَلَاةَ الْفَجْرِ مَا بَيْنَ طُلُوعِ الْفَجْرِ إِلَى طُلُوعِ شُعَاعِ الشَّمْسِ  ، وَيَذْهَبُ وَقْتُهَا ، وَقَدْ أَدْلَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ  عَرَّسَ  ، فَلَمْ يَسْتَيْقِظْ حَتَّى طَلَعَتِ الشَّمْسُ أَوْ بَعْضُهَا ، فَلَمْ يُصَلِّ حَتَّى ارْتَفَعَتْ فَصَلَّى ، وَهِيَ صَلَاةُ الْوُسْطَى  .","","Al-Mu'jam al-Kabir 12830","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن هرم الأزدي عن حبيب بن أبي حبيب الأنماطي عن عمرو بن يحيى بن أبي حبيب عن فضيل بن حسين الجحدري عن عبد الله بن أحمد الجواليقي عن الطبراني","باب"
"12866","12831  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  ثَنَا  سُفْيَانُ بْنُ حَبِيبٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  أَبِي الْعَنْبَسِ ،  عَنْ  أَبِي الشَّعْثَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" جَعَلَ فِدَاءَ  أَهْلِ بَدْرٍ  أَرْبَعَمِائَةٍ  .","","Al-Mu'jam al-Kabir 12831","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن أبو العنبس الكوفي عن شعبة بن الحجاج عن سفيان بن حبيب البصري عن عبيد الله بن عمر القواريري عن الحسين بن إسحاق التستري عن الطبراني","باب"
"12867","12832  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الرَّقَاشِيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنِ  الْحَكَمِ بْنِ أَبَانَ ،  عَنِ  الْغِطْرِيفِ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" عَنِ  الرُّوحِ الْأَمِينِ  قَالَ : قَالَ الرَّبُّ عَزَّ وَجَلَّ :  يُؤْتَى بِحَسَنَاتِ الْعَبْدِ ، وَسَيِّئَاتِهِ يَوْمَ الْقِيَامَةِ  يَنْقُصُ بَعْضُهَا بِبَعْضٍ فَإِنْ بَقِيَ حَسَنَةٌ وَاحِدَةٌ أَدْخَلَهُ اللهُ الْجَنَّةَ ، قَالَ : قُلْتُ : فَإِنْ لَمْ تَبْقَ حَسَنَةٌ قَالَ :         {      أُولَئِكَ الَّذِينَ نَتَقَبَّلُ عَنْهُمْ أَحْسَنَ مَا عَمِلُوا وَنَتَجَاوَزُ عَنْ سَيِّئَاتِهِمْ فِي أَصْحَابِ الْجَنَّةِ         }             [12/184]      قَالَ : قُلْتُ : أَرَأَيْتَ قَوْلَهُ :         {      فَلا تَعْلَمُ نَفْسٌ مَا أُخْفِيَ لَهُمْ مِنْ قُرَّةِ أَعْيُنٍ         }      قَالَ : هُوَ الْعَبْدُ يَعْمَلُ الْعَمَلَ السِّرَّ أَسَرَّهُ اللهُ لَهُ يَوْمَ الْقِيَامَةِ فَيُرَى قُرَّةَ أَعْيُنٍ  .","","Al-Mu'jam al-Kabir 12832","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن غطريف اليماني عن الحكم بن أبان العدني عن معتمر بن سليمان عن محمد بن عبد الله بن محمد بن عبد الملك الرقاشي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"12868","12833  -  حَدَّثَنَا  مُحَمَّدُ بْنُ زَكَرِيَّا الْغَلَّابِيُّ ، وَمُحَمَّدُ بْنُ كَيْسَانَ ، قَالَا :  ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  دُوَيْدٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ ثَوْبَانَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْعَيْنُ  حَقٌّ  الْعَيْنُ  حَقٌّ يَسْتَنْزِلُ الْحَالِقَ  .","","Al-Mu'jam al-Kabir 12833","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن إسماعيل بن ثوبان الأسدي عن دويد البصري عن سفيان الثوري عن موسى بن مسعود النهدي عن محمد بن كيسان عن الطبراني","باب"
"12869","12834  -  حَدَّثَنَا  أَبُو زَكَرِيَّا الدِّينَوَرِيُّ الْبَصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ مُحَمَّدِ بْنِ ثَوَابٍ الْحُصْرِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ اللهِ الْقُرَشِيُّ ،  ثَنَا  خَالِدٌ الْحَذَّاءُ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَيْرُ أَبْوَابِ  الْبِرِّ  الصَّدَقَةُ  .","","Al-Mu'jam al-Kabir 12834","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن خالد الحذاء عن عبد العزيز بن عبد الله الأويسي عن الحصرى سعيد بن محمد بن ثواب البصري عن أبو زكريا الدينوري البصري عن الطبراني","باب"
"12870","[  عَمَّارُ بْنُ أَبِي عَمَّارٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12835  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ  أَنَّ  ابْنَ عَبَّاسٍ قَرَأَ هَذِهِ الْآيَةَ :         {      الْيَوْمَ أَكْمَلْتُ لَكُمْ دِينَكُمْ وَأَتْمَمْتُ عَلَيْكُمْ نِعْمَتِي         }      إِلَى آخِرِ الْآيَةِ  ، وَعِنْدَهُ  يَهُودِيٌّ  ، فَقَالَ : لَوْ أُنْزِلَتْ عَلَيْنَا هَذِهِ الْآيَةُ لَاتَّخَذْنَا         [12/185]      يَوْمَهَا عِيدًا ، فَقَالَ  ابْنُ عَبَّاسٍ  : "" فَإِنَّهَا نَزَلَتْ فِي يَوْمِ عِيدَيْنِ : جُمُعَةٍ ، وَيَوْمِ  عَرَفَةَ  "" .","","Al-Mu'jam al-Kabir 12835","","عبد الله بن عباس عن عمار بن أبي عمار الحارثي عن حماد بن سلمة عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمار بن أبي عمار عن ابن عباس"
"12871","12836  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كُنْتُ مَعَ أَبِي عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَعِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَجُلٌ يُنَاجِيهِ ، وَكَانَ كَالْمُعْرِضِ عَنْ أَبِي فَخَرَجْنَا مِنْ عِنْدِهِ فَقَالَ لِي : أَلَمْ تَرَ إِلَى ابْنِ عَمِّكَ كَانَ كَالْمُعْرِضِ عَنِّي ، فَقُلْتُ لَهُ : يَا أَبَهْ كَانَ عِنْدَهُ رَجُلٌ يُنَاجِيهِ ، فَقَالَ : وَكَانَ عِنْدَهُ أَحَدٌ ؟ فَقُلْتُ : نَعَمْ ، فَرَجَعْنَا فَقَالَ : يَا رَسُولَ اللهِ إِنِّي قُلْتُ  لِعَبْدِ اللهِ  كَذَا وَكَذَا ، فَقَالَ لِي كَذَا وَكَذَا وَكَانَ عِنْدَكَ أَحَدٌ ؟ فَقَالَ : "" نَعَمْ وَرَأَيْتَهُ يَا  عَبْدَ اللهِ  ؟ "" قُلْتُ : نَعَمْ ، قَالَ :  ذَاكَ  جِبْرِيلُ  هُوَ الَّذِي شَغَلَنِي عَنْكَ  .","","Al-Mu'jam al-Kabir 12836","","عبد الله بن عباس عن عمار بن أبي عمار الحارثي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن الطبراني","عمار بن أبي عمار عن ابن عباس"
"12872","12837  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ (  ح  ) .  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيمَا يَرَى النَّائِمُ ذَاتَ يَوْمٍ نِصْفَ النَّهَارِ  أَشْعَثَ  أَغْبَرَ فِي يَدِهِ قَارُورَةٌ فِيهَا دَمٌ ، فَقُلْتُ : بِأَبِي أَنْتَ وَأُمِّي يَا رَسُولَ اللهِ مَا هَذِهِ ؟ قَالَ : "" هَذَا دَمُ  الْحُسَيْنِ  وَأَصْحَابِهِ لَمْ أَزَلْ أَلْتَقِطُهُ مُنْذُ الْيَوْمَ "" ، فَأُحْصِيَ ذَلِكَ فَوُجِدَ قُتِلَ ذَلِكَ الْيَوْمَ  .","","Al-Mu'jam al-Kabir 12837","","عبد الله بن عباس عن عمار بن أبي عمار الحارثي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن الطبراني","عمار بن أبي عمار عن ابن عباس"
"12873","[12/186]      12838  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  سُلَيْمَانُ بْنُ جَرِيرٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِيمَا يَحْسَبُ  أَبُو سَلَمَةَ  -  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" ذَكَرَ  خَدِيجَةَ بِنْتَ خُوَيْلِدٍ  وَكَانَ أَبُوهَا يَرْغَبُ أَنْ يُزَوِّجَهُ  ، فَصَنَعَتْ طَعَامًا وَشَرَابًا وَدَعَتْ أَبَاهَا وَأُنَاسًا مِنْ  قُرَيْشٍ  ، فَطَعِمُوا وَشَرِبُوا ، فَقَالَتْ  خَدِيجَةُ  لِأَبِيهَا : إِنَّ  مُحَمَّدَ بْنَ عَبْدِ اللهِ  يَخْطُبُنِي قُمْ فَزَوِّجْهَا إِيَّاهُ ، فَخَلَّقَتْهُ ، وَأَلْبَسَتْهُ  حُلَّةً  ، وَكَذَلِكَ كَانُوا يَفْعَلُونَ بِالْآبَاءِ إِذَا زَوَّجُوا بَنَاتِهِمْ ، فَلَمَّا  سُرِّيَ  عَنْهُ السُّكْرُ نَظَرَ فَإِذَا هُوَ مُخَلَّقٌ وَعَلَيْهِ  حُلَّةٌ  ، فَقَالَ مَا شَأْنِي ؟ فَقَالَتْ : زَوَّجْتَنِي مِنْ  مُحَمَّدٍ  ، فَقَالَ : أَنَا زَوَّجْتُكِ يَتِيمَ  أَبِي طَالِبٍ  لَا لَعَمْرِي ، فَقَالَتْ  خَدِيجَةُ  : أَمَا تَسْتَحِي أَتُرِيدُ أَنْ تُسَفِّهَ نَفْسَكَ ، تُخْبِرُ  قُرَيْشًا  وَالنَّاسَ أَنَّكَ كُنْتَ سَكْرَانًا فَلَمْ تَزَلْ بِهِ حَتَّى رَضِيَ  .","","Al-Mu'jam al-Kabir 12838","","عبد الله بن عباس عن عمار بن أبي عمار الحارثي عن حماد بن سلمة عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمار بن أبي عمار عن ابن عباس"
"12874","12839  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِيمَا يَحْسَبُ  حَمَّادٌ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِخَدِيجَةَ  :  إِنِّي أَسْمَعُ صَوْتًا ، وَأَرَى ضَوْءًا ، وَإِنِّي أَخْشَى أَنْ يَكُونَ بِي  خَبَلٌ  ، فَقَالَتْ  خَدِيجَةُ  : لَمْ يَكُنِ اللهُ لِيَفْعَلَ بِكَ ذَلِكَ يَا  ابْنَ عَبْدِ اللهِ  . ثُمَّ أَتَتْ  وَرَقَةَ بْنَ نَوْفَلٍ  فَذَكَرَتْ ذَلِكَ لَهُ ، فَقَالَ : إِنْ يَكُنْ صَادِقًا فَإِنَّ هَذَا  نَامُوسٌ  مِثْلُ  نَامُوسِ  مُوسَى  ، وَإِنْ يُبْعَثْ ، وَأَنَا حَيٌّ  سَأُعَزِّرُهُ  ، وَأَنْصُرُهُ ، وَأُعِينُهُ  .","","Al-Mu'jam al-Kabir 12839","","عبد الله بن عباس عن عمار بن أبي عمار الحارثي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمار بن أبي عمار عن ابن عباس"
"12875","[12/187]      12840  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، - فِيمَا أَحْسَبُ  شَكَّ  حَمَّادٌ  - قَالَ :  أَقَامَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  بِمَكَّةَ  خَمْسَ عَشْرَةَ سَنَةً  :  سَبْعًا أَوْ ثَمَانِيًا  يَرَى  الضَّوْءَ  ، وَيَسْمَعُ الصَّوْتَ ، وَثَمَانِيًا يُوحَى إِلَيْهِ ، وَأَقَامَ  بِالْمَدِينَةِ  عَشْرًا  .","","Al-Mu'jam al-Kabir 12840","","عبد الله بن عباس عن عمار بن أبي عمار الحارثي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمار بن أبي عمار عن ابن عباس"
"12876","12841  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ يَخْطُبُ إِلَى جِذْعٍ قَبْلَ أَنْ يَتَّخِذَ الْمِنْبَرَ ، فَلَمَّا اتَّخَذَ الْمِنْبَرَ ، وَتَحَوَّلَ إِلَيْهِ  حَنَّ  الْجِذْعُ فَاحْتَضَنَهُ فَسَكَنَ "" ، وَقَالَ :  لَوْ لَمْ أَحْتَضِنْهُ لَحَنَّ إِلَى يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 12841","","عبد الله بن عباس عن عمار بن أبي عمار الحارثي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمار بن أبي عمار عن ابن عباس"
"12877","12842  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ ، مَوْلَى بَنِي هَاشِمٍ ، قَالَ :  قُلْتُ  لِابْنِ عَبَّاسٍ كَمْ أَتَى لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ مَاتَ ؟  قَالَ : مَا كُنْتُ أُرَى مِثْلَكَ مِنْ قَوْمِهِ يَخْفَى عَلَيْكَ ذَلِكَ ، قَالَ : قُلْتُ : إِنِّي قَدْ سَأَلْتُ فَاخْتُلِفَ  عَلَيَّ ، فَأَحْبَبْتُ أَنْ أَعْلَمَ قَوْلَكَ فِيهِ ، قَالَ : أَتَحْسُبُ ؟ قُلْتُ : نَعَمْ ، قَالَ : "" خُذْ أَرْبَعِينَ بُعِثَ لَهَا ، وَخَمْسَ عَشْرَةَ مُقَامُهُ  بِمَكَّةَ  يَأْمَنُ وَيَخَافُ ، وَعَشْرًا مُهَاجَرُهُ  بِالْمَدِينَةِ  "" .  تصحفت في طبعة مكتبة ابن تيمية : ( فاختلق ) وهي على الصواب في النسخ الخطية .","","Al-Mu'jam al-Kabir 12842","","عبد الله بن عباس عن عمار بن أبي عمار الحارثي عن يونس بن عبيد عن يزيد بن زريع العيشي عن إبراهيم بن الحجاج السامي عن أحمد بن داود بن موسى السدوسي عن الطبراني","عمار بن أبي عمار عن ابن عباس"
"12878","[12/188]      12843  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  وُهَيْبُ بْنُ خَالِدٍ ،  عَنْ  يُونُسَ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ :  تُوُفِّيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ ابْنُ خَمْسٍ وَسِتِّينَ  وَكَانَ الْحَسَنُ يَقُولُ : "" تُوُفِّيَ وَهُوَ ابْنُ سِتِّينَ  .","","Al-Mu'jam al-Kabir 12843","","عبد الله بن عباس عن عمار بن أبي عمار الحارثي عن يونس بن عبيد عن وهيب بن خالد الكرابيسي عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","عمار بن أبي عمار عن ابن عباس"
"12879","12844  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  تُوُفِّيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ ابْنُ خَمْسٍ وَسِتِّينَ  .","","Al-Mu'jam al-Kabir 12844","","عبد الله بن عباس عن عمار بن أبي عمار الحارثي عن خالد الحذاء عن بشر بن المفضل عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمار بن أبي عمار عن ابن عباس"
"12880","[  يُوسُفُ بْنُ مِهْرَانَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12845  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قُبِضَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَهُوَ ابْنُ خَمْسٍ وَسِتِّينَ  .","","Al-Mu'jam al-Kabir 12845","","عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن هشيم بن بشير عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","يوسف بن مهران عن ابن عباس"
"12881","[  مُحَمَّدُ بْنُ سِيرِينَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  بَابٌ  12846  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ  ، ثَنَا  هَوْذَةُ بْنُ خَلِيفَةَ ،  ثَنَا  عَوْفٌ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، وَأَعْطَى الْحَجَّامَ أَجْرَهُ ، وَلَوْ كَانَ حَرَامًا لَمْ يُعْطِهِ  .","","Al-Mu'jam al-Kabir 12846","","عبد الله بن عباس عن محمد بن سيرين عن عوف بن أبي جميلة عن هوذة بن خليفة البكراوي عن لحية الليف محمد بن العباس عن الطبراني","محمد بن سيرين عن ابن عباس"
"12882","[12/189]      12847  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  أَبُو هِلَالٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَآجَرَهُ  ، وَلَوْ كَانَ خَبِيثًا لَمْ يَأْجُرْهُ  .","","Al-Mu'jam al-Kabir 12847","","عبد الله بن عباس عن محمد بن سيرين عن محمد بن سليم الراسبي عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محمد بن سيرين عن ابن عباس"
"12883","12848  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ حَمَّادٍ الشُّعَيْثِيُّ ،  ثَنَا  ابْنُ عَوْفٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  احْتَجَمَ ، وَآجَرَهُ ، وَلَوْ عَلِمَهُ خَبِيثًا لَمْ يُعْطِهِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب :""ابن عون"" كما في الأوسط للطبراني .","","Al-Mu'jam al-Kabir 12848","","عبد الله بن عباس عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن عبد الرحمن بن حماد الشعيثي عن أبو مسلم الكجي عن الطبراني","محمد بن سيرين عن ابن عباس"
"12884","12849  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَعْطَى الْحَجَّامَ أَجْرَهُ  ، وَلَوْ كَانَ  سُحْتًا  لَمْ يُعْطِهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .","","Al-Mu'jam al-Kabir 12849","","عبد الله بن عباس عن محمد بن سيرين عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","محمد بن سيرين عن ابن عباس"
"12885","12850  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" احْتَجَمَ ، وَآجَرَهُ  ، وَلَوْ كَانَ خَبِيثًا لَمْ يُعْطِهِ  .","","Al-Mu'jam al-Kabir 12850","","عبد الله بن عباس عن محمد بن سيرين عن أيوب السختياني عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محمد بن سيرين عن ابن عباس"
"12886","12851  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  أَبُو الشَّعْثَاءِ عَلِيُّ بْنُ الْحَسَنِ ،  ثَنَا  وَكِيعٌ ،  عَنْ  زَيْدِ بْنِ إِبْرَاهِيمَ  ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، وَكَانَ لَا يَظْلِمُ أَجِيرًا أَجْرَهُ  .         [12/190]      كذا في طبعة مكتبة ابن تيمية ، والصواب : ( يزيد )","","Al-Mu'jam al-Kabir 12851","","عبد الله بن عباس عن محمد بن سيرين عن يزيد بن إبراهيم التستري عن وكيع بن الجراح عن علي بن الحسن بن سليمان الحضرمي عن محمود بن محمد بن منويه المفيد عن الطبراني","محمد بن سيرين عن ابن عباس"
"12887","12852  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  يَزِيدُ بْنُ إِبْرَاهِيمَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ، قَالَ :  نُبِّئْتُ أَنَّ  ابْنَ عَبَّاسٍ ، قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَآجَرَهُ  ، وَلَوْ عَلِمَ أَنَّ بِهِ بَأْسًا لَمْ يُعْطِهِ  .","","Al-Mu'jam al-Kabir 12852","","عبد الله بن عباس عن محمد بن سيرين عن يزيد بن إبراهيم التستري عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","محمد بن سيرين عن ابن عباس"
"12888","12853  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  أَسْبَاطُ بْنُ مُحَمَّدٍ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَآجَرَ  الْحَجَّامَ  أَجْرَهُ  ، وَلَوْ كَانَ حَرَامًا لَمْ يُعْطِهِ  .","","Al-Mu'jam al-Kabir 12853","","عبد الله بن عباس عن محمد بن سيرين عن أشعث بن سوار عن أسباط بن محمد بن ميسرة القرشي عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","محمد بن سيرين عن ابن عباس"
"12889","12854  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْأَجْلَحِ ،  عَنْ  أَبِي بَكْرٍ الْهُذَلِيِّ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَآجَرَهُ  ، وَلَوْ كَانَ حَرَامًا لَمْ يُعْطِهِ  .","","Al-Mu'jam al-Kabir 12854","","عبد الله بن عباس عن محمد بن سيرين عن أبو بكر الهذلي عن عبد الله بن الأجلح عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن سيرين عن ابن عباس"
"12890","12854  / 2  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  مَعْمَرُ بْنُ سَهْلٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ تَمَّامٍ ،  ثَنَا  يُونُسُ بْنُ عُبَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَعْطَى  الْحَجَّامَ  أَجْرَهُ  ، وَلَوْ كَانَ خَبِيثًا لَمْ يُعْطِهِ  .","","Al-Mu'jam al-Kabir 12854","","عبد الله بن عباس عن محمد بن سيرين عن يونس بن عبيد عن عبيد الله بن تمام السلمي عن معمر بن سهل بن معمر الأهوازي عن عبد الله بن أحمد الجواليقي عن الطبراني","محمد بن سيرين عن ابن عباس"
"12891","بَابٌ  12855  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ حَمَّادٍ الشُّعَيْثِيُّ ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ : "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقْصُرُ الصَّلَاةَ فِيمَا بَيْنَ  الْمَدِينَةِ  وَمَكَّةَ  لَا يَخَافُ إِلَّا اللهَ  .         [12/191]","","Al-Mu'jam al-Kabir 12855","","عبد الله بن عباس عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن عبد الرحمن بن حماد الشعيثي عن أبو مسلم الكجي عن الطبراني","محمد بن سيرين عن ابن عباس"
"12892","12856  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ ، أَخُو أَبِي حُرَّةَ ،  ثَنَا  مُحَمَّدُ بْنُ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْصُرُ الصَّلَاةَ بَيْنَ  مَكَّةَ  وَالْمَدِينَةِ  ، وَلَا يَخَافُ إِلَّا اللهَ  .","","Al-Mu'jam al-Kabir 12856","","عبد الله بن عباس عن محمد بن سيرين عن سعيد بن عبد الرحمن الرقاشي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محمد بن سيرين عن ابن عباس"
"12893","12857  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  قُرَّةُ بْنُ خَالِدٍ ، وَسَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَافَرَ مِنْ  مَكَّةَ  إِلَى  الْمَدِينَةِ  فَصَلَّى رَكْعَتَيْنِ  لَا يَخَافُ إِلَّا اللهَ  .","","Al-Mu'jam al-Kabir 12857","","عبد الله بن عباس عن محمد بن سيرين عن سعيد بن عبد الرحمن الرقاشي عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محمد بن سيرين عن ابن عباس"
"12894","12858  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ (  ح  ) .  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ مَسْلَمَةَ بْنِ قَعْنَبٍ ،  ثَنَا  أَبُو هِلَالٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  سَافَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ  مَكَّةَ  وَالْمَدِينَةِ  لَا يَخَافُ إِلَّا اللهَ "" أَوْ قَالَ : "" لَا يَخْشَى إِلَّا اللهَ  فَصَلَّى رَكْعَتَيْنِ  .","","Al-Mu'jam al-Kabir 12858","","عبد الله بن عباس عن محمد بن سيرين عن محمد بن سليم الراسبي عن إسماعيل بن مسلمة بن قعنب القعنبي عن يوسف بن يزيد القراطيسي عن الطبراني","محمد بن سيرين عن ابن عباس"
"12895","12859  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُسَافِرُ مِنَ  الْمَدِينَةِ  إِلَى  مَكَّةَ  لَا يَخَافُ إِلَّا اللهَ فَيُصَلِّي رَكْعَتَيْنِ رَكْعَتَيْنِ  .","","Al-Mu'jam al-Kabir 12859","","عبد الله بن عباس عن محمد بن سيرين عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","محمد بن سيرين عن ابن عباس"
"12896","12860  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  هِشَامٍ ،  عَنِ  ابْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 12860","","عبد الله بن عباس عن محمد بن سيرين عن هشام بن حسان العتكي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","محمد بن سيرين عن ابن عباس"
"12897","[12/192]      12861  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بَيْنَ  مَكَّةَ  وَالْمَدِينَةِ  رَكْعَتَيْنِ  ، لَا يَخَافُ إِلَّا اللهَ  .","","Al-Mu'jam al-Kabir 12861","","عبد الله بن عباس عن محمد بن سيرين عن هشام بن حسان العتكي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","محمد بن سيرين عن ابن عباس"
"12898","12863  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  حَجَّاجُ بْنُ إِبْرَاهِيمَ الْأَزْرَقُ (  ح  ) .  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ  ، أَنَا  خَلَفُ بْنُ هِشَامٍ الْبَزَّارُ ، قَالُوا :  ثَنَا  هُشَيْمٌ ،  ثَنَا  مَنْصُورُ بْنُ زَاذَانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ  الْمَدِينَةِ  إِلَى  مَكَّةَ  لَا يَخَافُ إِلَّا اللهَ فَصَلَّى رَكْعَتَيْنِ حَتَّى خَرَجَ  .","","Al-Mu'jam al-Kabir 12863","","عبد الله بن عباس عن محمد بن سيرين عن منصور بن زاذان الثقفي عن هشيم بن بشير عن خلف بن هشام البزار عن محمد بن الفضل بن جابر السقطى عن الطبراني","محمد بن سيرين عن ابن عباس"
"12899","12864  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  أَسْبَاطُ بْنُ مُحَمَّدٍ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَكْعَتَيْنِ بَيْنَ  مَكَّةَ  وَالْمَدِينَةِ  لَا يَخَافُ إِلَّا اللهَ  .","","Al-Mu'jam al-Kabir 12864","","عبد الله بن عباس عن محمد بن سيرين عن أشعث بن سوار عن أسباط بن محمد بن ميسرة القرشي عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","محمد بن سيرين عن ابن عباس"
"12900","بَابٌ  12865  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ (  ح  ) .         [12/193]      وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، وَيُوسُفُ الْقَاضِي ، قَالَا :  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَعَرَّقَ كَتِفًا ثُمَّ قَامَ فَصَلَّى  ، وَلَمْ يَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 12865","","عبد الله بن عباس عن محمد بن سيرين عن أيوب السختياني عن حماد بن زيد عن سليمان بن حرب الواشحي عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محمد بن سيرين عن ابن عباس"
"12901","12866  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ ،  ثَنَا  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ مَسْلَمَةَ  (  ح  ) .  وَحَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ (  ح  ) .  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  عَبْدُ الْأَعْلَى ، كُلُّهُمْ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَعَرَّقَ عَظْمًا  ثُمَّ صَلَّى وَلَمْ يَمَسَّ مَاءً  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( محمد بن سلمة).","","Al-Mu'jam al-Kabir 12866","","عبد الله بن عباس عن محمد بن سيرين عن هشام بن حسان العتكي عن عبد الأعلى بن عبد الأعلى القرشي عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","محمد بن سيرين عن ابن عباس"
"12902","12867  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  الْمُحَارِبِيُّ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنِ  ابْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَعَرَّقَ كَتِفًا  ، ثُمَّ قَامَ فَصَلَّى وَلَمْ يَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 12867","","عبد الله بن عباس عن محمد بن سيرين عن أشعث بن سوار عن عبد الرحمن بن محمد المحاربي عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","محمد بن سيرين عن ابن عباس"
"12903","12868  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  عَوْنُ بْنُ الْحَكَمِ بْنِ سِنَانٍ الْبَاهِلِيُّ ،  ثَنَا  يَزِيدُ بْنُ إِبْرَاهِيمَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كُنْتُ فِيمَنْ تَعَجَّلَ فِي  ثَقَلِ  النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مِنْ  جَمْعٍ  إِلَى  مِنًى  .","","Al-Mu'jam al-Kabir 12868","","عبد الله بن عباس عن محمد بن سيرين عن يزيد بن إبراهيم التستري عن عون بن الحكم بن سنان القربي عن أحمد بن داود بن موسى السدوسي عن الطبراني","محمد بن سيرين عن ابن عباس"
"12904","[12/194]      12869  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  الْهَيْثَمُ بْنُ عُبَيْدِ اللهِ الْقُرَشِيُّ الْفَقِيهُ ،  ثَنَا  مُحَمَّدُ بْنُ عَمْرٍو أَبُو سَهْلٍ الْأَنْصَارِيُّ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  وَقَّتَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِأَهْلِ الْمَدِينَةِ  ذَا الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  الْجُحْفَةَ  ،  وَلِأَهْلِ الْيَمَنِ  يَلَمْلَمَ  ،  وَلِأَهْلِ نَجْدٍ  قَرْنَ  .","","Al-Mu'jam al-Kabir 12869","","عبد الله بن عباس عن محمد بن سيرين عن محمد بن عمرو بن عبيد الواقفي عن الهيثم بن عبيد الله الكوفي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن سيرين عن ابن عباس"
"12905","12870  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَبْدِ اللهِ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أُنْزِلَ الْوَحْيُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَهُوَ ابْنُ أَرْبَعِينَ  ، وَأَقَامَ  بِمَكَّةَ  ثَلَاثَ عَشْرَةَ ،  وَبِالْمَدِينَةِ  عَشْرًا ، وَتُوُفِّيَ وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  .","","Al-Mu'jam al-Kabir 12870","","عبد الله بن عباس عن محمد بن سيرين عن هشام بن حسان العتكي عن إسماعيل بن عبد الله بن الحارث الأزدي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","محمد بن سيرين عن ابن عباس"
"12906","12871  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  الْحُسَيْنُ بْنُ حُرَيْثٍ الْمَرْوَزِيُّ ،  ثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَدَّ يَدَهُ إِلَى  حُذَيْفَةَ  وَكَانَ  حُذَيْفَةُ  تَقَاعَسَ  حَتَّى ذَهَبَ فَاغْتَسَلَ ، وَجَاءَ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي كُنْتُ  جُنُبًا  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الْمُسْلِمَ لَا يَنْجُسُ  .","","Al-Mu'jam al-Kabir 12871","","عبد الله بن عباس عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن النضر بن شميل عن الحسين بن حريث الخزاعي عن الحسين بن إسحاق التستري عن الطبراني","محمد بن سيرين عن ابن عباس"
"12907","12872  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  الْحَسَنُ  بْنُ حُرَيْثٍ ،  ثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مُنَادِيًا  فَنَادَى فِي يَوْمٍ مَطِيرٍ :  صَلُّوا فِي رِحَالِكُمْ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب (الحسين) .","","Al-Mu'jam al-Kabir 12872","","عبد الله بن عباس عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن النضر بن شميل عن الحسين بن حريث الخزاعي عن الحسين بن إسحاق التستري عن الطبراني","محمد بن سيرين عن ابن عباس"
"12908","[12/195]      12873  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ، قَالَ :  مَرَّتْ جِنَازَةٌ بِابْنِ عَبَّاسٍ ، وَالْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُمْ ، فَقَامَ  الْحَسَنُ  ، وَقَعَدَ  ابْنُ عَبَّاسٍ  ، فَقَالَ  الْحَسَنُ  : "" قَدْ قَامَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، لِجِنَازَةِ  يَهُودِيٍّ أَوْ يَهُودِيَّةٍ  مَرَّتْ بِهِ ؟ فَقَالَ  ابْنُ عَبَّاسٍ  : بَلَى ، وَجَلَسَ  .","","Al-Mu'jam al-Kabir 12873","","عبد الله بن عباس عن محمد بن سيرين عن أيوب السختياني عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محمد بن سيرين عن ابن عباس"
"12909","12874  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ  أَنَّ  ابْنَ عَبَّاسٍ ، وَالْحَسَنَ بْنَ عَلِيٍّ مَرَّتْ بِهِمَا جِنَازَةٌ فَقَامَ أَحَدُهُمَا ، وَجَلَسَ الْآخَرُ  ، فَقَالَ الَّذِي قَامَ : "" أَمَا تَعْلَمُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَامَ ؟ قَالَ الْآخَرُ : بَلَى ، وَقَعَدَ  .","","Al-Mu'jam al-Kabir 12874","","عبد الله بن عباس عن محمد بن سيرين عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","محمد بن سيرين عن ابن عباس"
"12910","12875  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ  عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ  أَنَّ ابْنَ عَبَّاسٍ  قَالَ  "" فِي هَذِهِ الْآيَةِ :         {      وَعَلَى الَّذِينَ يُطِيقُونَهُ فِدْيَةٌ طَعَامُ مِسْكِينٍ         }      ، ثُمَّ نَسَخَتْهَا الْآيَةُ الْأُخْرَى         {      فَمَنْ شَهِدَ مِنْكُمُ الشَّهْرَ فَلْيَصُمْهُ         }      .","","Al-Mu'jam al-Kabir 12875","","عبد الله بن عباس عن محمد بن سيرين عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","محمد بن سيرين عن ابن عباس"
"12911","12876  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  وَاصِلٍ مَوْلَى أَبِي عُيَيْنَةَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ  أَبَا أَيُّوبَ  رَضِيَ اللهُ عَنْهُ طَلَّقَ امْرَأَتَهُ ،         [12/196]      فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ طَلَاقَ  أُمِّ أَيُّوبَ  كَانَ  حُوبًا  قَالَ  ابْنُ سِيرِينَ  :  الْحُوبُ  : الْإِثْمُ  .","","Al-Mu'jam al-Kabir 12876","","عبد الله بن عباس عن محمد بن سيرين عن واصل الأزدي مولى أبي عيينة بن المهلب عن حماد بن زيد عن يحيى بن عبد الحميد عن محمد بن عثمان بن أبي شيبة عن الطبراني","محمد بن سيرين عن ابن عباس"
"12912","[  سِمَاكٌ الْحَنَفِيُّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12877  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  سِمَاكٍ الْحَنَفِيِّ ، قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ :  لَمَّا نَزَلَتْ أَوَّلُ الْمُزَّمِّلِ كَانَ قِيَامُهُمْ مِثْلَ قِيَامِهِمْ فِي رَمَضَانَ  أَوْ نَحْوَ قِيَامِهِمْ فِي رَمَضَانَ ، وَكَانَ بَيْنَ أَوَّلِهَا وَآخِرِهَا سَنَةٌ  "" .","","Al-Mu'jam al-Kabir 12877","","عبد الله بن عباس عن سماك بن الوليد اليمامي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سماك الحنفي عن ابن عباس"
"12913","12878  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  عِكْرِمَةَ بْنِ عَمَّارٍ ،  عَنْ  أَبِي زُمَيْلٍ الْحَنَفِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  رَأَيْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بُرْدًا مِنْ أَحْسَنِ  الْيُمْنَةِ  .","","Al-Mu'jam al-Kabir 12878","","عبد الله بن عباس عن سماك بن الوليد اليمامي عن عكرمة بن عمار عن عبد الله بن المبارك عن نعيم بن حماد الخزاعي عن يحيى بن عثمان بن صالح عن الطبراني","سماك الحنفي عن ابن عباس"
"12914","12879  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ الْجُنْدَيْسَابُورِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ لُوَيْنٌ ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  سِمَاكٍ أَبِي زُمَيْلٍ الْحَنَفِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : سَمِعْتُهُ يَقُولُ :  أَصَابَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ حُنَيْنٍ  غَنَائِمَ فَقَسَمَ لِلنَّاسٍ ، فَقَالَتِ  الْأَنْصَارُ  : نَلِي الْقِتَالَ ، وَالْغَنَائِمُ لِغَيْرِنَا ، فَبَلَغَ ذَلِكَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَبَعَثَ         [12/197]      إِلَيْهِمْ أَنِ اجْتَمِعُوا فَأَتَاهُمْ ، فَقَالَ :  يَا مَعْشَرَ  الْأَنْصَارِ  هَلْ فِيكُمْ أَحَدٌ مِنْ غَيْرِكُمْ ؟  ، قَالُوا : لَا إِلَّا ابْنُ أُخْتٍ لَنَا ، وَمَوْلًى لَنَا ، فَقَالَ : "" ابْنُ أُخْتِ  الْقَوْمِ  مِنْهُمْ ، وَمَوْلَى  الْقَوْمِ  مِنْهُمْ "" قَالَ : "" يَا مَعْشَرَ  الْأَنْصَارِ  أَمَا تَرْضَوْنَ أَنْ يَذْهَبَ النَّاسُ بِالشَّاءِ وَالْبَقَرِ ، وَتَذْهَبُونَ أَنْتُمْ  بِمُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ "" قَالُوا : قَدْ رَضِينَا  .","","Al-Mu'jam al-Kabir 12879","","عبد الله بن عباس عن سماك بن الوليد اليمامي عن محمد بن جابر بن سيار عن محمد بن سليمان لوين عن محمد بن جابان الجند يسابوري عن الطبراني","سماك الحنفي عن ابن عباس"
"12915","12880  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ  ، ثَنَا  زَيْدُ بْنُ الْمُبَارَكِ ، قَالُوا :  ثَنَا  عَبْدُ رَبِّهِ بْنُ بَارِقٍ الْحَنَفِيُّ ،  حَدَّثَنِي  سِمَاكٌ الْحَنَفِيُّ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ مَاتَ لَهُ  فَرَطَانِ  مِنْ أُمَّتِي أَدْخَلَهُ اللهُ الْجَنَّةَ  ، قَالَتْ  عَائِشَةُ  : وَمَنْ مَاتَ لَهُ  فَرَطٌ  ؟ قَالَ : "" وَمَنْ مَاتَ لَهُ  فَرَطٌ  يَا مُوَفَّقَةُ "" ، قَالَتْ : فَمَنْ لَمْ يَكُنْ لَهُ  فَرَطٌ  ؟ قَالَ : "" فَأَنَا  فَرَطُ  أُمَّتِي لَمْ يُصَابُوا بِمِثْلِي  .","","Al-Mu'jam al-Kabir 12880","","عبد الله بن عباس عن سماك بن الوليد اليمامي عن عبد ربه بن بارق الكوسج عن زيد بن المبارك الصنعاني عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","سماك الحنفي عن ابن عباس"
"12916","12881  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ الْقَاضِي  ، ثَنَا  الْعَبَّاسُ بْنُ عَبْدِ الْعَظِيمِ الْعَنْبَرِيُّ ،  ثَنَا  النَّضْرُ بْنُ مُحَمَّدٍ الْجُرَشِيُّ ،  ثَنَا  عِكْرِمَةُ بْنُ عَمَّارٍ ،  ثَنَا  أَبُو زُمَيْلٍ ،  ثَنَا  ابْنُ عَبَّاسٍ ، قَالَ :  اسْتَسْقَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَمُطِرَ النَّاسُ حَتَّى سَالَتْ قَنَاةٌ أَرْبَعِينَ يَوْمًا  فَأَصْبَحَ النَّاسُ يَقُولُونُ : "" لَقَدْ صَدَقَ  نَوْءُ  كَذَا وَكَذَا ، وَمِنْهُمْ مَنْ يَقُولُ : هَذِهِ رَحْمَةٌ وَضَعَهَا اللهُ  .","","Al-Mu'jam al-Kabir 12881","","عبد الله بن عباس عن سماك بن الوليد اليمامي عن عكرمة بن عمار عن النضر بن محمد بن موسى الجرشي عن عباس بن عبد العظيم العنبري عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","سماك الحنفي عن ابن عباس"
"12917","[12/198]      12882  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْجَمَّالُ  الْأَصْبَهَانِيُّ  ، ثَنَا  حَمْدَانُ بْنُ يُوسُفَ السُّلَمِيُّ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ الْقَاضِي  ، ثَنَا  الْعَبَّاسُ بْنُ عَبْدِ الْعَظِيمِ الْعَنْبَرِيُّ ، قَالَا :  ثَنَا  النَّضْرُ بْنُ مُحَمَّدٍ الْجُرَشِيُّ ،  ثَنَا  عِكْرِمَةُ بْنُ عَمَّارٍ ،  ثَنَا  أَبُو زُمَيْلٍ ،  ثَنَا  ابْنُ عَبَّاسٍ ، قَالَ :  مُطِرَ النَّاسُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَصْبَحَ مِنَ النَّاسِ شَاكِرٌ ، وَمِنْهُمْ كَافِرٌ  ، قَالُوا : هَذِهِ رَحْمَةٌ وَضَعَهَا اللهُ ، وَقَالَ بَعْضُهُمْ : لَقَدْ صَدَقَ  نَوْءُ  كَذَا وَكَذَا "" فَأُنْزِلَتْ هَذِهِ الْآيَةُ :         {      فَلا أُقْسِمُ بِمَوَاقِعِ النُّجُومِ         }      حَتَّى         {      وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ         }      .  في طبعة مكتبة ابن تيمية : (الحمال) وينظر مصادر الترجمة .","","Al-Mu'jam al-Kabir 12882","","عبد الله بن عباس عن سماك بن الوليد اليمامي عن عكرمة بن عمار عن النضر بن محمد بن موسى الجرشي عن عباس بن عبد العظيم العنبري عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","سماك الحنفي عن ابن عباس"
"12918","12883  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْجَمَّالُ  ، ثَنَا  حَمْدَانُ بْنُ يُوسُفَ السُّلَمِيُّ ،  ثَنَا  النَّضْرُ بْنُ مُحَمَّدٍ ،  ثَنَا  عِكْرِمَةُ بْنُ عَمَّارٍ ،  ثَنَا  أَبُو زُمَيْلٍ الْحَنَفِيُّ ،  حَدَّثَنِي  ابْنُ عَبَّاسٍ ، قَالَ :  كَانَ الْمُشْرِكُونَ يَقُولُونَ : لَبَّيْكَ لَا شَرِيكَ لَكَ ، فَيَقُولُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  وَيْلَكُمْ قَدْ قَدْ  ، فَيَقُولُونَ : إِلَّا  شَرِيكٌ  هُوَ لَكَ تَمْلِكُهُ وَمَا مَلَكَ ، يَقُولُونَ هَذَا وَهُمْ يَطُوفُونَ  بِالْبَيْتِ  .  في طبعة مكتبة ابن تيمية : (الحمال) وينظر مصادر الترجمة .","","Al-Mu'jam al-Kabir 12883","","عبد الله بن عباس عن سماك بن الوليد اليمامي عن عكرمة بن عمار عن النضر بن محمد بن موسى الجرشي عن أحمد بن يوسف المهلبي عن أحمد بن محمد بن عبد الله الجمال عن الطبراني","سماك الحنفي عن ابن عباس"
"12919","12884  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْجَمَّالُ  ، ثَنَا  حَمْدَانُ بْنُ يُوسُفَ السُّلَمِيُّ ،  ثَنَا  النَّضْرُ بْنُ مُحَمَّدٍ الْجُرَشِيُّ ،  ثَنَا  عِكْرِمَةُ بْنُ عَمَّارٍ ،  حَدَّثَنِي  أَبُو زُمَيْلٍ ،  حَدَّثَنِي  ابْنُ عَبَّاسٍ ، قَالَ :  لَقَدْ رَأَيْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحْسَنَ مَا يَكُونُ مِنَ الثِّيَابِ  الْيَمَنِيَّةِ  .  في طبعة مكتبة ابن تيمية : (الحمال) وينظر مصادر الترجمة .","","Al-Mu'jam al-Kabir 12884","","عبد الله بن عباس عن سماك بن الوليد اليمامي عن عكرمة بن عمار عن النضر بن محمد بن موسى الجرشي عن أحمد بن يوسف المهلبي عن أحمد بن محمد بن عبد الله الجمال عن الطبراني","سماك الحنفي عن ابن عباس"
"12920","[12/199]      12885  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ  ، ثَنَا  الْعَبَّاسُ بْنُ عَبْدِ الْعَظِيمِ الْعَنْبَرِيُّ ،  ثَنَا  النَّضْرُ بْنُ مُحَمَّدٍ الْجُرَشِيُّ ،  ثَنَا  عِكْرِمَةُ بْنُ عَمَّارٍ ،  ثَنَا  أَبُو زُمَيْلٍ ،  حَدَّثَنِي  ابْنُ عَبَّاسٍ ، قَالَ :  كَانَ النَّاسُ لَا يَنْظُرُونَ إِلَى  أَبِي سُفْيَانَ  ، وَلَا يُقَاعِدُونَهُ ،  فَقَالَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ثَلَاثٌ أُعْطِيكَهُنَّ ، قَالَ : "" نَعَمْ "" ، قَالَ : عِنْدِي أَحْسَنُ الْعَرَبِ ، وَأَجْمَلُهُ  أُمُّ حَبِيبَةَ بِنْتُ أَبِي سُفْيَانَ  أُزَوِّجُكَهَا ، قَالَ : "" نَعَمْ "" ، قَالَ :  وَمُعَاوِيَةُ  تَجْعَلُهُ كَاتِبًا تَجْعَلُهُ بَيْنَ يَدَيْكَ . قَالَ : "" نَعَمْ "" ، قَالَ : وَتُؤَمِّرُنِي أَنْ أُقَاتِلَ الْكُفَّارَ كَمَا كُنْتُ أُقَاتِلُ الْمُسْلِمِينَ ، قَالَ : "" نَعَمْ  .","","Al-Mu'jam al-Kabir 12885","","عبد الله بن عباس عن سماك بن الوليد اليمامي عن عكرمة بن عمار عن النضر بن محمد بن موسى الجرشي عن عباس بن عبد العظيم العنبري عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","سماك الحنفي عن ابن عباس"
"12921","12886  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  عُمَرُ بْنُ خَلَفِ بْنِ إِسْحَاقَ بْنِ مِرْسَالٍ الْخَثْعَمِيُّ  ،  حَدَّثَنِي  عَمِّي إِسْمَاعِيلُ بْنُ مِرْسَالٍ ،  عَنْ  أَبِي زُمَيْلٍ الْحَنَفِيِّ ،  حَدَّثَنِي  ابْنُ عَبَّاسٍ ، قَالَ :  كَانَ الْمُسْلِمُونَ لَا         [12/200]      يَنْظُرُونَ إِلَى  أَبِي سُفْيَانَ  وَلَا يُفَاتِحُونَهُ  ، فَقَالَ : يَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ثَلَاثٌ أُعْطِيكَهُنَّ : عِنْدِي أَحْسَنُ الْعَرَبِ وَأَجْمَلُهُ  أُمُّ حَبِيبَةَ  أُزَوِّجُكَهَا ، قَالَ : "" نَعَمْ "" ، قَالَ : وَتَجْعَلُ  مُعَاوِيَةَ  كَاتِبًا بَيْنَ يَدَيْكَ ، قَالَ : "" نَعَمْ "" ، قَالَ : وَتُؤَمِّرُنِي أَنْ أُقَاتِلَ الْكُفَّارَ كَمَا كُنْتُ أُقَاتِلُ الْمُسْلِمِينَ ، قَالَ : "" نَعَمْ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عمرو بن خليف )","","Al-Mu'jam al-Kabir 12886","","عبد الله بن عباس عن سماك بن الوليد اليمامي عن إسماعيل بن مرسال عن عمرو بن خليف الحتاوي عن علي بن سعيد بن بشير عليك عن الطبراني","سماك الحنفي عن ابن عباس"
"12922","[  بَرَكَةُ بْنُ الْوَلِيدِ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12887  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَمْرُو بْنُ عَوْفٍ الْوَاسِطِيُّ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  بَرَكَةَ بْنِ الْوَلِيدِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَعَنَ اللهُ الْيَهُودَ حُرِّمَتْ عَلَيْهِمُ  الشُّحُومُ  فَبَاعُوهَا  ، وَأَكَلُوا أَثْمَانَهَا ، وَإِنَّ اللهَ عَزَّ وَجَلَّ إِذَا حَرَّمَ أَكْلَ شَيْءٍ حَرَّمَ ثَمَنَهُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( بركة أبي الوليد ) ، كما في بقية طرق الحديث.  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( بركة أبي الوليد ) ، كما في بقية طرق الحديث.","","Al-Mu'jam al-Kabir 12887","","عبد الله بن عباس عن بركة المجاشعي عن خالد الحذاء عن هشيم بن بشير عن عمرو بن عون الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بركة بن الوليد عن ابن عباس"
"12923","[  أَبُو يَزِيدَ الْمَدِينِيُّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12888  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مَخْلَدٍ الْوَاسِطِيُّ ، قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي  ،  ثَنَا  سَلَّامٌ أَبُو الْمُنْذِرِ ،  عَنْ  مَطَرٍ الْوَرَّاقِ ،  عَنْ  أَبِي يَزِيدَ الْمَدِينِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ مِنَ الشِّعْرِ  حُكْمًا  ، وَإِنَّ مِنَ  الْبَيَانِ  سِحْرًا  .","","Al-Mu'jam al-Kabir 12888","","عبد الله بن عباس عن أبو يزيد المديني عن مطر بن طهمان الوراق عن سلام بن سليمان المزني عن عثمان بن مخلد الواسطي عن محمد بن عثمان بن مخلد الواسطي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أبو يزيد المديني عن ابن عباس"
"12924","12889  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  ثَنَا  أَبُو عَامِرٍ الْخَزَّازُ ،  عَنْ  أَبِي يَزِيدَ الْمَدِينِيِّ  ، عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كُنَّا نَقْرَأُ هَذِهِ         {      تَكَادُ السَّمَاوَاتُ يَتَفَطَّرْنَ مِنْ فَوْقِهِنَّ         }      "" .","","Al-Mu'jam al-Kabir 12889","","عبد الله بن عباس عن أبو يزيد المديني عن صالح بن رستم الخزاز عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو يزيد المديني عن ابن عباس"
"12925","[12/201]      [  عَبْدُ اللهِ بْنُ فَرُّوخَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12890  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  رَوْحُ بْنُ عَبْدِ الْمُؤْمِنِ ،  ثَنَا  سَلَمَةُ بْنُ رَجَاءٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ فَرُّوخَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُؤَخِّرُ  الْعَتَمَةَ  إِلَى ثُلُثِ اللَّيْلِ  فَلِذَلِكَ سُمِّيَتِ  الْعَتَمَةَ  لِأَنَّهُ كَانَ يُعْتِمُ بِهَا  .","","Al-Mu'jam al-Kabir 12890","","عبد الله بن عباس عن عبد الله بن فروخ مولى آل طلحة بن عبيد الله عن إبراهيم بن عبد الله بن فروخ عن سلمة بن رجاء التميمي عن روح بن عبد المؤمن عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","عبد الله بن فروخ عن ابن عباس"
"12926","[  أَبُو الصَّهْبَاءِ صُهَيْبٌ  رَجُلٌ مِنْ  أَهْلِ الْبَصْرَةِ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12891  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  يَحْيَى بْنِ الْجَزَّارِ ،  عَنْ  صُهَيْبٍ رَجُلٍ مِنْ أَهْلِ الْبَصْرَةِ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  مَرَرْتُ أَنَا  وَغُلَامٌ ، مِنْ قُرَيْشٍ  عَلَى حِمَارٍ بَيْنَ يَدَيْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَهُوَ يُصَلِّي فَلَمْ يَنْصَرِفْ ، وَجَاءَتْ جَارِيَتَانِ مِنْ  بَنِي عَبْدِ الْمُطَّلِبِ  فَأَخَذَتَا بِرُكْبَتَيْهِ ،  فَفَرَعَ  بَيْنَهُمَا ، وَلَمْ يَنْصَرِفْ  .  هَكَذَا رَوَاهُ  شُعْبَةُ  عَنِ  الْحَكَمِ  ، عَنْ  يَحْيَى بْنِ الْجَزَّارِ  ، عَنْ  صُهَيْبٍ  ، وَخَالَفَهُ  مَنْصُورٌ  .","","Al-Mu'jam al-Kabir 12891","","عبد الله بن عباس عن صهيب البكري عن يحيى بن الجزار العرني عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","أبو الصهباء صهيب رجل من أهل البصرة عن ابن عباس"
"12927","12892  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الْحَكَمِ ،  عَنْ  يَحْيَى بْنِ الْجَزَّارِ ،  عَنْ  أَبِي الصَّهْبَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَقْبَلْتُ عَلَى حِمَارٍ ، وَمَعِي رِدْفٌ مِنْ  بَنِي عَبْدِ الْمُطَّلِبِ  ، وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي فِي أَرْضٍ         [12/202]      خَلَاءٍ فَنَزَلْنَا ، ثُمَّ جِئْنَا حَتَّى دَخَلْنَا فِي الصَّلَاةِ ، وَتَرَكْنَا الْحِمَارَ قُدَّامَهُمْ فَمَا بَالَى ذَلِكَ ، وَأَقْبَلَتْ جَارِيَتَانِ مِنْ  بَنِي عَبْدِ الْمُطَّلِبِ  يَشْتَدَّانِ يَتْبَعُ إِحْدَاهُمَا الْأُخْرَى حَتَّى انْتَهَتَا إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الصَّلَاةِ وَهُوَ يُصَلِّي ، فَفَرَّقَ بَيْنَهُمَا فَمَا بَالَى ذَلِكَ  .","","Al-Mu'jam al-Kabir 12892","","عبد الله بن عباس عن صهيب البكري عن يحيى بن الجزار العرني عن الحكم بن عتيبة الكندي عن منصور بن المعتمر عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","أبو الصهباء صهيب رجل من أهل البصرة عن ابن عباس"
"12928","[  أَبُو رَافِعٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12893  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ حِسَابٍ ،  ثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  أَبِي رَافِعٍ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّهُ قَالَ  لِعُمَرَ  :  صَحِبْتَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهَوَ عَنْكَ رَاضٍ  .","","Al-Mu'jam al-Kabir 12893","","عبد الله بن عباس عن نفيع بن رافع الصائغ عن ثابت البناني عن جعفر بن سليمان الضبعي عن محمد بن عبيد بن حساب الغبري عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","أبو رافع عن ابن عباس"
"12929","[  مُوسَى بْنُ سَلَمَةَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12894  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُوسَى بْنِ سَلَمَةَ ، قَالَ :  سَأَلْتُ  ابْنَ عَبَّاسٍ قُلْتُ : أَكُونُ  بِمَكَّةَ  كَيْفَ أُصَلِّي ؟  قَالَ : "" رَكْعَتَيْنِ سُنَّةَ  أَبِي الْقَاسِمِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .","","Al-Mu'jam al-Kabir 12894","","عبد الله بن عباس عن موسى بن سلمة بن المحبق الهذلي عن قتادة بن دعامة عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن معاذ بن المثنى العنبري عن الطبراني","موسى بن سلمة عن ابن عباس"
"12930","12895  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  أَبِي  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الطُّفَاوِيُّ ،  ثَنَا  أَيُّوبُ السَّخْتِيَانِيُّ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُوسَى بْنِ سَلَمَةَ ، قَالَ :  كُنَّا مَعَ ابْنِ عَبَّاسٍ  بِمَكَّةَ  ، فَقُلْنَا : إِنَّا إِذَا كُنَّا         [12/203]      مَعَكُمْ صَلَّيْنَا أَرْبَعًا  ، فَإِذَا رَجَعْنَا إِلَى رِحَالِنَا صَلَّيْنَا رَكْعَتَيْنِ ،  فَقَالَ  : "" تِلْكَ سُنَّةُ  أَبِي الْقَاسِمِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَإِنْ رَغِمْتُمْ  "" .","","Al-Mu'jam al-Kabir 12895","","عبد الله بن عباس عن موسى بن سلمة بن المحبق الهذلي عن قتادة بن دعامة عن أيوب السختياني عن محمد بن عبد الرحمن الطفاوي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","موسى بن سلمة عن ابن عباس"
"12931","12896  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ، وَطَالُوتُ بْنُ عَبَّادٍ ، قَالَا :  ثَنَا  سُوَيْدُ بْنُ حَاتِمٍ  ،  عَنْ  قَتَادَةَ ،  عَنْ  مُوسَى بْنِ سَلَمَةَ ، قَالَ :  سَأَلْتُ  ابْنَ عَبَّاسٍ عَنِ الصَّلَاةِ  بِالْأَبْطَحِ  فَقَالَ : "" رَكْعَتَانِ سُنَّةُ  أَبِي الْقَاسِمِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .  كذا في طبعة مكتبة ابن تيمية والنسخ الخطية ، ولعل الصواب : (سويد أبو حاتم) والله أعلم .","","Al-Mu'jam al-Kabir 12896","","عبد الله بن عباس عن موسى بن سلمة بن المحبق الهذلي عن قتادة بن دعامة عن سويد بن إبراهيم الجحدري عن طالوت بن عباد الجحدري عن موسى بن هارون الحمال عن الطبراني","موسى بن سلمة عن ابن عباس"
"12932","12897  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  ثَنَا  أَبُو التَّيَّاحِ ،  عَنْ  مُوسَى بْنِ سَلَمَةَ ، قَالَ :  خَرَجْتُ أَنَا  وَسِنَانُ بْنُ سَلَمَةَ  عَلَى بَدَنَتَيْنِ فَإِنْ خِفْنَا عَلَيْنَا فَعَيِينَا بِشَأْنِهِمَا ، فَقَالَ  سِنَانٌ  : لَوْ قَدِمْنَا الْبَلَدَ بَحَثْنَا عَنْ عِلْمِ هَذَا ، فَلَمَّا قَدِمْنَا قُلْتُ : هَلْ لَكَ فِي ابْنِ عَبَّاسٍ عِنْدَ السِّقَايَةِ نَتَحَدَّثُ إِلَيْهِ ؟ فَسَأَلَهُ  سِنَانٌ  عَنْ أَمْرِ بَدَنَتَيْهِ ، فَقَالَ : عَلَى الْخَبِيرِ  سَقَطْتَ  ، بَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فُلَانًا الْأَسْلَمِيَّ  ، وَبَعَثَ مَعَهُ بِثَمَانِ عَشْرَةَ بَدَنَةً ، فَقَالَ : يَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَرَأَيْتَ إِنْ  أَزْحَفَ  عَلَيَّ مِنْهُنَّ ؟ قَالَ :  تَنْحَرُهَا ثُمَّ تَغْمِسُ نَعْلَهَا فِي دَمِهَا ، ثُمَّ تَضْرِبُ بِهِ عَلَى صَفْحَتِهَا  ، وَلَا تَأْكُلْ مِنْهَا أَنْتَ وَلَا أَحَدٌ  مِنْ أَهْلِ رُفْقَتِكَ أَوْ مِنْ أَصْحَابِكَ  .","","Al-Mu'jam al-Kabir 12897","","عبد الله بن عباس عن موسى بن سلمة بن المحبق الهذلي عن يزيد بن حميد الضبعي عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","موسى بن سلمة عن ابن عباس"
"12933","12898  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجٌ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي التَّيَّاحِ ،  عَنْ  مُوسَى بْنِ سَلَمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 12898","","عبد الله بن عباس عن موسى بن سلمة بن المحبق الهذلي عن يزيد بن حميد الضبعي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","موسى بن سلمة عن ابن عباس"
"12934","12899  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ الْوَارِثِ ،         [12/204]      عَنْ  أَبِي التَّيَّاحِ ،  عَنْ  مُوسَى بْنِ سَلَمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 12899","","عبد الله بن عباس عن موسى بن سلمة بن المحبق الهذلي عن يزيد بن حميد الضبعي عن عبد الوارث بن سعيد بن ذكوان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","موسى بن سلمة عن ابن عباس"
"12935","[  النَّضْرُ بْنُ أَنَسٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12900  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي عَدِيٍّ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  النَّضْرِ بْنِ أَنَسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ صَوَّرَ صُورَةً فِي الدُّنْيَا  كُلِّفَ  يَوْمَ الْقِيَامَةِ  أَنْ يَنْفُخَ فِيهَا الرُّوحَ وَلَيْسَ بِنَافِخٍ  .","","Al-Mu'jam al-Kabir 12900","","عبد الله بن عباس عن النضر بن أنس بن مالك الأنصاري عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن إبراهيم بن أبي عدي القسملي عن محمد بن أبي بكر المقدمي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","النضر بن أنس عن ابن عباس"
"12936","[  أَبُو حَسَّانَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12901  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ (  ح  ) .  وَحَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ (  ح  ) .  وَحَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ  ، ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ  (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا         [12/205]      شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي حَسَّانَ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" صَلَّى  بِذِي الْحُلَيْفَةِ  ثُمَّ دَعَا بِبَدَنَةٍ فَأَشْعَرَ صَفْحَةَ سَنَامِهَا الْأَيْمَنِ ، ثُمَّ  سَلَتَ  الدَّمَ عَنْهَا وَقَلَّدَهَا بِنَعْلَيْنِ ، ثُمَّ أَتَى بِرَاحِلَتِهِ ، فَلَمَّا قَعَدَ عَلَيْهَا اسْتَوَتْ بِهِ عَلَى الْبَيْدَاءِ أَهَلَّ  .  في طبعة مكتبة ابن تيمية : (عمر بن حفص الحوضي) والمثبت من الظاهرية (1) .","","Al-Mu'jam al-Kabir 12901","","عبد الله بن عباس عن مسلم بن عبد الله الأحرد عن قتادة بن دعامة عن شعبة بن الحجاج عن علي بن الجعد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أبو حسان عن ابن عباس"
"12937","12902  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ  ، ثَنَا  الْقَاسِمُ بْنُ عِيسَى الطَّائِيُّ ،  ثَنَا  طَلْحَةُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي حَسَّانَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" أَهَلَّ دُبُرَ صَلَاةِ الظُّهْرِ  مِنَ  الْبَيْدَاءِ  .","","Al-Mu'jam al-Kabir 12902","","عبد الله بن عباس عن مسلم بن عبد الله الأحرد عن قتادة بن دعامة عن طلحة بن عبد الرحمن القناد عن القاسم بن عيسى بن إبراهيم الطائي عن بحشل عن الطبراني","أبو حسان عن ابن عباس"
"12938","12903  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ  ، ثَنَا  عُمَرُ بْنُ حَفْصٍ الْحَوْضِيُّ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي حَسَّانَ ،  أَنَّ  ابْنَ عَبَّاسٍ ،  سُئِلَ عَنِ  السَّلَفِ  ، فَقَالَ : "" أَشْهَدُ أَنَّ اللهَ أَحَلَّهُ  ، وَأَنْزَلَ فِيهِ أَطْوَلَ آيَةٍ فِي كِتَابِ اللهِ "" :         {      يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا تَدَايَنْتُمْ بِدَيْنٍ إِلَى أَجَلٍ مُسَمًّى فَاكْتُبُوهُ         }      "" .","","Al-Mu'jam al-Kabir 12903","","عبد الله بن عباس عن مسلم بن عبد الله الأحرد عن قتادة بن دعامة عن همام بن يحيى بن دينار عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","أبو حسان عن ابن عباس"
"12939","12904  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عَرْعَرَةَ ،  ثَنَا  مُعَاذُ بْنُ هِشَامٍ ، قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي حَسَّانَ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَزُورُ  الْبَيْتَ  كُلَّ لَيْلَةٍ مِنْ لَيَالِي  مِنًى  .","","Al-Mu'jam al-Kabir 12904","","عبد الله بن عباس عن مسلم بن عبد الله الأحرد عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن إبراهيم بن محمد بن عرعرة عن الحسن بن علي بن شبيب المعمري عن الطبراني","أبو حسان عن ابن عباس"
"12940","[  أَبُو مِجْلَزٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12905  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ         [12/206]      سَعِيدٍ ،  عَنْ  شُعْبَةَ ،  حَدَّثَنِي  قَتَادَةُ ،  عَنْ  أَبِي مِجْلَزٍ ، قَالَ :  سَأَلْتُ  ابْنَ عَبَّاسٍ عَنِ  الْوِتْرِ  ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  رَكْعَةٌ مِنْ آخِرِ اللَّيْلِ  .","","Al-Mu'jam al-Kabir 12905","","عبد الله بن عباس عن لاحق بن حميد عن قتادة بن دعامة عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو مجلز عن ابن عباس"
"12941","12906  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  أَبُو بَكْرِ بْنُ خَلَّادٍ الْبَاهِلِيُّ ،  ثَنَا  خَالِدُ بْنُ الْحَارِثِ ،  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي مِجْلَزٍ ، قَالَ :  سَأَلْتُ  ابْنَ عَبَّاسٍ عَنْ شَيْءٍ مِنْ أَمْرِ الْحَصَا  فَقَالَ : "" مَا أَدْرِي رَمَاهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  بِسِتٍّ أَوْ بِسَبْعٍ  .","","Al-Mu'jam al-Kabir 12906","","عبد الله بن عباس عن لاحق بن حميد عن قتادة بن دعامة عن شعبة بن الحجاج عن خالد الصدق عن محمد بن خلاد الباهلي عن عبد الله بن أحمد الجواليقي عن الطبراني","أبو مجلز عن ابن عباس"
"12942","12907  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ التَّسْنِيمِيُّ  ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ، قَالَ :  بَلَغَنَا أَنَّ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمَّا نَزَلَتْ هَذِهِ الْآيَةُ قَالَ :  إِنَّ اللهَ يُقَدِّمُ فِي تَحْرِيمِ الْخَمْرِ  ، فَكَانُوا يَشْرَبُونَهَا مَا لَمْ يَحْضُرُوا الصَّلَاةَ ، وَكَانُوا إِذَا حَضَرَتِ الصَّلَاةُ كَفُّوا عَنْهَا ، وَكَانَ السُّكْرُ مِنْهَا عَلَيْهِمْ حَرَامٌ ، ثُمَّ أَنْزَلَ اللهُ عَزَّ وَجَلَّ تَحْرِيمَهَا فِي سُورَةِ الْمَائِدَةِ فَهِيَ حَرَامٌ قَلِيلُهَا وَكَثِيرُهَا ، مَا أَسْكَرَ مِنْهَا وَمَا لَمْ يُسْكِرْ .         {      وَلا جُنُبًا إِلا عَابِرِي سَبِيلٍ         }      ، "" فَرَخَّصَ لِلْمُسَافِرِ إِذَا كَانَ مُسَافِرًا ، وَهُوَ  جُنُبٌ  لَا يَجِدُ مَاءً أَنْ يَتَيَمَّمَ ، وَيُصَلِّيَ  .  تصحفت في طبعة مكتبة ابن تيمية : ( السنيمي ) وهي على الصواب في النسخ الخطية.","","Al-Mu'jam al-Kabir 12907","","قتادة بن دعامة عن سعيد بن أبي عروبة عن روح بن عبادة القيسي عن محمد بن الحسن بن تسنيم الوراق عن عبد الله بن أحمد الجواليقي عن الطبراني","أبو مجلز عن ابن عباس"
"12943","12908  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ التَّسْنِيمِيُّ ،  ثَنَا  رَوْحٌ ،  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  لَاحِقِ بْنِ حُمَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، بِهَذَا الْحَدِيثِ .","","Al-Mu'jam al-Kabir 12908","","عبد الله بن عباس عن لاحق بن حميد عن قتادة بن دعامة عن شعبة بن الحجاج عن روح بن عبادة القيسي عن محمد بن الحسن بن تسنيم الوراق عن عبد الله بن أحمد الجواليقي عن الطبراني","أبو مجلز عن ابن عباس"
"12944","[12/207]      12909  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ ، وَمُوسَى بْنُ هَارُونَ ، قَالَا :  ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  ثَنَا  حِبَّانُ بْنُ عُبَيْدِ اللهِ أَبُو زُهَيْرٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  .  وَحَدَّثَنَا  أَبُو مِجْلَزٍ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ رَايَةَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَتْ سَوْدَاءَ  ، وَلِوَاؤُهُ أَبْيَضُ  .","","Al-Mu'jam al-Kabir 12909","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن حيان بن عبيد الله بن حيان البصري عن إبراهيم بن الحجاج السامي عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو مجلز عن ابن عباس"
"12945","[  بَكْرُ بْنُ عَبْدِ اللهِ الْمُزَنِيُّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12910  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  حُمَيْدٍ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ  أَنَّ  أَعْرَابِيًّا  قَالَ لِابْنِ عَبَّاسٍ ، وَأَشَارَ إِلَى  مُعَاوِيَةَ  : يَسْقُونَ الْمَاءَ وَالْعَسَلَ  ، وَآلُ فُلَانٍ يَسْقُونَ اللَّبَنَ ، وَأَنْتُمْ تَسْقُونَ النَّبِيذَ أَمِنْ بُخْلٍ بِكُمْ ، أَمْ مِنْ حَاجَةٍ ؟  فَقَالَ  : مَا بِنَا بُخْلٌ ، وَلَا حَاجَةٌ ، وَلَكِنْ جَاءَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَرَدِيفُهُ  أُسَامَةُ بْنُ زَيْدٍ  فَسَقَيْنَاهُ مِنْ هَذَا النَّبِيذِ فَشَرِبَ مِنْهُ ، وَقَالَ : "" هَكَذَا فَاصْنَعُوا  .","","Al-Mu'jam al-Kabir 12910","","عبد الله بن عباس عن بكر بن عبد الله المزني عن حميد الطويل عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن الطبراني","بكر بن عبد الله المزني عن ابن عباس"
"12946","12911  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ الْوَارِثِ بْنُ سَعِيدٍ ،  عَنْ  عَامِرٍ الْأَحْوَلِ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَرَادَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْحَجَّ  ، فَقَالَتِ  امْرَأَةٌ  لِزَوْجِهَا : أَحْجِجْنِي مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ لَهَا : مَا عِنْدِي مَا أُحِجُّكِ بِهِ عَلَيْهِ . قَالَتْ : أَحْجِجْنِي عَلَى جَمَلِكَ فُلَانٍ ،         [12/208]      فَقَالَ : ذَاكَ  حَبِيسٌ  فِي  سَبِيلِ  اللهِ ، قَالَتْ : أَحْجِجْنِي عَلَى  نَاضِحِكَ  . قَالَ : ذَاكَ  نَعْتَقِبُهُ  أَنَا وَأَنْتِ ، قَالَتْ : فَبِعْ  ثَمَرَتَكَ  ، قَالَ : ذَاكَ قُوتِي وَقُوتُكِ ، فَلَمَّا قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَرْسَلَتْ زَوْجَهَا إِلَيْهِ ، فَقَالَتْ : أَقْرِئْهُ السَّلَامَ وَرَحْمَةَ اللهِ ، وَسَلْهُ مَا يَعْدِلُ حَجَّةً مَعَكَ ، فَأَتَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ امْرَأَتِي تَقْرَأُ عَلَيْكَ السَّلَامَ وَرَحْمَةَ اللهِ ، وَإِنَّهَا كَانَتْ سَأَلَتْنِي  الْحَجَّ  مَعَكَ ، فَقُلْتُ : مَا عِنْدِي مَا أُحِجُّكِ عَلَيْهِ ، فَقَالَتْ : أَحْجِجْنِي عَلَى جَمَلِكَ فُلَانٍ ، فَقُلْتُ : ذَاكَ  حَبِيسٌ  فِي  سَبِيلِ  اللهِ ، قَالَ : أَمَا إِنَّكَ لَوْ أَحْجَجْتَهَا عَلَيْهِ كَانَتْ فِي  سَبِيلِ  اللهِ ، قَالَتْ : فَأَحْجِجْنِي عَلَى  نَاضِحِكَ  . فَقُلْتُ : ذَاكَ  نَعْتَقِبُهُ  أَنَا وَأَنْتِ ، قَالَتْ : فَبِعْ  ثَمَرَتَكَ  ، قُلْتُ : ذَاكَ قُوتِي وَقُوتُكِ ، فَضَحِكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ حِرْصِهَا عَلَى  الْحَجِّ  ، قَالَ : فَإِنَّهَا أَمَرَتْنِي أَنْ أَسْأَلَكَ مَا يُجْزِي حَجَّةً مَعَكَ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَقْرِئْهَا السَّلَامَ وَرَحْمَةَ اللهِ ، وَأَخْبِرْهَا أَنَّهُ يَعْدِلُ حَجَّةً مَعِي عُمْرَةٌ فِي رَمَضَانَ  .","","Al-Mu'jam al-Kabir 12911","","عبد الله بن عباس عن بكر بن عبد الله المزني عن عامر بن عبد الواحد الأحول عن عبد الوارث بن سعيد بن ذكوان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","بكر بن عبد الله المزني عن ابن عباس"
"12947","[  عَبْدُ اللهِ بْنُ الْحَارِثِ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12912  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، أَنَا  عَارِمٌ أَبُو النُّعْمَانِ (  ح  ) .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ، وَعَاصِمٍ ، وَعَبْدِ الْحَمِيدِ صَاحِبِ الزِّيَادِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ، قَالَ :  خَطَبَنَا ابْنُ عَبَّاسٍ فِي يَوْمٍ ذِي رَدْعٍ فَلَمَّا بَلَغَ  الْمُؤَذِّنُ  حَيَّ عَلَى         [12/209]      الصَّلَاةِ  ، أَمَرَهُ أَنْ يُنَادِيَ : الصَّلَاةُ فِي  الرِّحَالِ  ، فَنَظَرَ بَعْضُهُمْ إِلَى بَعْضٍ ، فَقَالَ : "" كَأَنَّكُمْ أَنْكَرْتُمْ هَذَا ؟ قَدْ فَعَلَ هَذَا خَيْرٌ مِنِّي ، وَإِنَّهَا  عَزْمَةٌ  .","","Al-Mu'jam al-Kabir 12912","","عبد الله بن عباس عن عبد الله بن الحارث الأنصاري عن عبد الحميد بن دينار صاحب الزيادي عن حماد بن زيد عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عبد الله بن الحارث عن ابن عباس"
"12948","12913  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  عَاصِمِ بْنِ سُلَيْمَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  أَنَّ ابْنَ عَبَّاسٍ أَمَرَ مُنَادِيَهُ فِي يَوْمٍ مَطِيرٍ  فَقَالَ  : "" إِذَا بَلَغْتَ حَيَّ عَلَى  الْفَلَاحِ  ، فَقُلْ : أَلَا صَلُّوا فِي  الرِّحَالِ  ، فَقِيلَ : مَا هَذَا ؟ فَقَالَ : فِعْلُ مَنْ هُوَ خَيْرٌ مِنِّي  .","","Al-Mu'jam al-Kabir 12913","","عبد الله بن عباس عن عبد الله بن الحارث الأنصاري عن عاصم بن سليمان الأحول عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبد الله بن الحارث عن ابن عباس"
"12949","12914  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو  ، ثَنَا  أَبُو الْجُمَاهِرِ مُحَمَّدُ بْنُ عُثْمَانَ ،  ثَنَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ عَلَى الْمِنْبَرِ يَقُولُ :  إِنَّمَا سُمِّيَ  الْخَضِرَ  لِأَنَّهُ قَعَدَ عَلَى  فَرْوَةٍ  بَيْضَاءَ فَاهْتَزَّتْ خَضْرَاءَ  .  قَالَ  سَعِيدُ بْنُ بَشِيرٍ :  وَحَدَّثَنِي  سُوَيْدٌ أَبُو حَاتِمٍ  أَنَّ  قَتَادَةَ كَانَ  يَرْفَعُ  هَذَا الْحَدِيثَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Al-Mu'jam al-Kabir 12914","","عبد الله بن عباس عن عبد الله بن الحارث الأنصاري عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن محمد بن عثمان الكفرسوسي عن أبو زرعة الدمشقي عن الطبراني","عبد الله بن الحارث عن ابن عباس"
"12950","[  عَبْدُ اللهِ بْنُ شَقِيقٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12915  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عِمْرَانَ بْنِ حُدَيْرٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ شَقِيقٍ قَالَ :  كَانَ ابْنُ عَبَّاسٍ يَخْطُبُ عَشِيَّةً فَقَالَ  رَجُلٌ  : الصَّلَاةَ  ،  فَقَالَ  : "" لَا أُمَّ لَكَ تُعْلِمُنَا بِوَقْتِهَا كُنَّا نَجْمَعُ بَيْنَهُمَا عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .","","Al-Mu'jam al-Kabir 12915","","عبد الله بن عباس عن عبد الله بن شقيق العقيلي عن عمران بن حدير عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عبد الله بن شقيق عن ابن عباس"
"12951","12916  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،         [12/210]      ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنِ  الزُّبَيْرِ بْنِ الْخِرِّيتِ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ قَالَ :  خَطَبَنَا  ابْنُ عَبَّاسٍ  يَوْمًا بَعْدَ الْعَصْرِ حَتَّى غَابَتِ الشَّمْسُ  ، وَبَدَتِ النُّجُومُ ، وَعَلِقَ النَّاسُ يُنَادُونَهُ الصَّلَاةَ ، وَفِي  الْقَوْمِ  رَجُلٌ مِنْ تَمِيمٍ  يُنَادِي ،  فَقَالَ  ابْنُ عَبَّاسٍ : تُعْلِمُنِي بِالسُّنَّةِ لَا أُمَّ لَكَ ، "" إِنِّي شَهِدْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : جَمَعَ بَيْنَ الْعَصْرِ وَالظُّهْرِ ، وَالْمَغْرِبِ وَالْعِشَاءِ "" فَلَقِيتُ أَبَا هُرَيْرَةَ فَوَافَقَهُ  .","","Al-Mu'jam al-Kabir 12916","","عبد الله بن عباس عن عبد الله بن شقيق العقيلي عن الزبير بن الخريت عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن شقيق عن ابن عباس"
"12952","[  أَبُو نَهِيكٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12917  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ الْجُنْدَيْسَابُورِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْبَلْخِيُّ ،  ثَنَا  صَفْوَانُ بْنُ عِيسَى الزُّهْرِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ هَارُونَ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  أَبِي نَهِيكٍ  ، عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  مِنَ السُّنَّةِ إِذَا جَلَسَ الرَّجُلُ أَنْ يَخْلَعَ نَعْلَيْهِ فَيَضَعَهُمَا بِجَنْبِهِ  "" .","","Al-Mu'jam al-Kabir 12917","","عبد الله بن عباس عن عثمان بن نهيك الفراهيدي عن زياد بن سعد الخراساني عن عبد الله بن هارون الصوفي عن صفوان بن عيسى عباية عن محمد بن أبى إبراهيم حمدويه عن محمد بن جابان الجند يسابوري عن الطبراني","أبو نهيك عن ابن عباس"
"12953","[  عُبَادَةُ بْنُ نَشِيطٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12918  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  صَدَقَةُ بْنُ عُبَادَةَ بْنِ نَشِيطٍ ، قَالَ :  سَمِعْتُ  أَبِي عُبَادَةَ بْنَ نَشِيطٍ  ، يَقُولُ :  سَمِعْتُ  ابْنَ عَبَّاسٍ  يُسْأَلُ عَنِ الطِّلَاءِ ؟ فَقَالَ  ابْنُ عَبَّاسٍ  :  مَا أَدْرِي مَا طِلَاؤُكُمْ هَذَا الَّذِي تَجِيئُونَ بِهِ ؟  وَلَكِنَّا كُنَّا نُؤْتَى بِشَيْءٍ كَأَنَّهُ هِنَاءُ الْإِبِلِ ، فَكُنَّا نَشْرَبُهُ فَلَا نَرَى بِهِ بَأْسًا  "" .","","Al-Mu'jam al-Kabir 12918","","عبد الله بن عباس عن عبادة بن نشيط الأسدي عن صدقة بن عبادة الأسدي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","عبادة بن نشيط عن ابن عباس"
"12954","[12/211]      [  أَبُو حَاضِرٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12919  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْمَرْوَزِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  عَبَّادِ بْنِ الْعَوَّامِ ،  عَنْ  أَبِي السَّوَّارِ السُّلَمِيِّ ،  عَنْ  أَبِي حَاضِرٍ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" احْتَجَمَ  بِالْقَاحَةِ  ، وَهُوَ مُحْرِمٌ  .","","Al-Mu'jam al-Kabir 12919","","عبد الله بن عباس عن عثمان بن حاضر الحميري عن أبو السوار السلمي عن عباد بن العوام الكلابي عن سعيد بن سليمان سعدويه عن محمد بن يحيى بن سليمان الوراق عن الطبراني","أبو حاضر عن ابن عباس"
"12955","[  الْمُغِيرَةُ بْنُ سُوَيْدٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12920  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْمَرْوَزِيُّ  ، ثَنَا  عَلِيُّ بْنُ حُجْرٍ ،  ثَنَا  يُوسُفُ بْنُ الْغَرِقِ ،  عَنْ  سُكَيْنِ بْنِ أَبِي سِرَاجٍ ،  عَنِ  الْمُغِيرَةِ بْنِ سُوَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مِنْ سَعَادَةِ الْمَرْءِ خِفَّةُ لَحْيَيْهِ  .","","Al-Mu'jam al-Kabir 12920","","عبد الله بن عباس عن مغيرة بن سويد عن سكين بن أبي سراج عن يوسف بن الغرق الباهلي عن علي بن حجر بن إياس عن محمود بن محمد بن عبد العزيز المروزي عن الطبراني","المغيرة بن سويد عن ابن عباس"
"12956","[  مُعَاوِيَةُ بْنُ قُرَّةَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12921  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  عُمَرُ بْنُ صَالِحِ بْنِ جَنْزَةَ  الْوَاسِطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ بْنِ عَطِيَّةَ ،  عَنْ  زَيْدٍ         [12/212]      الْعَمِّيِّ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَخَذَ شِبْرًا مِنْ  مَكَّةَ  بِغَيْرِ حَقِّهِ فَكَأَنَّمَا أَخَذَهُ مِنْ تَحْتِ قَدَمِ الرَّحْمَنِ  ، وَمَنْ أَخَذَ شَيْئًا مِنْ سَائِرِ الْأَرْضِ بِغَيْرِ حَقِّهِ جَاءَ يَوْمَ الْقِيَامَةِ مُطَوَّقًا فِي عُنُقِهِ مِنْ سَبْعِ أَرَضِينَ  .  في طبعة مكتبة ابن تيمية : ( حنزة ) وفي ( 7420 ، 10504 ) : ( جبيرة ) وكذا هي في تاريخ واسط ( ص : 202 ) ، وقال : ""عمر بن صالح بن زياد كان يعرف بابن جبيرة توفي سنة ثمان وثلاثين ومائتين""أ.هـ ، وفي ( 11366 ، 11367 ) : ( خيرة ) وكذا هي في الكامل في ترجمتي ( محمد بن فضاء ) و ( محمد بن الفضل بن عطية ) والذي في النسخ الخطية ( حنزة ) كذا دون نقط على الحاء أو غير منقوط بمرة ، وقال محقق تهذيب الكمال 26 / 282 : ""بفتج الجيم وسكون النون ، والزاي المعجمة كذا جوده ابن المهندس في نسخته""أ.هـ","","Al-Mu'jam al-Kabir 12921","","عبد الله بن عباس عن معاوية بن قرة عن زيد بن الحواري العمي عن محمد بن الفضل بن عطية العبسي عن عمر بن صالح بن جنزة الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","معاوية بن قرة عن ابن عباس"
"12957","12922  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ الْجَوْهَرِيُّ  ، ثَنَا  عِصْمَةُ بْنُ سُلَيْمَانَ الْخَزَّازُ ،  ثَنَا  سَلَّامٌ الطَّوِيلُ ،  عَنْ  زَيْدٍ الْعَمِّيِّ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَقُولُ اللهُ عَزَّ وَجَلَّ :  لَسْتُ بِنَاظِرٍ فِي حَقِّ عَبْدِي حَتَّى يَنْظُرَ عَبْدِي فِي حَقِّي  .","","Al-Mu'jam al-Kabir 12922","","عبد الله بن عباس عن معاوية بن قرة عن زيد بن الحواري العمي عن سلام بن سلم الطويل عن عصمة بن سليمان الخزاز عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","معاوية بن قرة عن ابن عباس"
"12958","[  عَبْدُ الرَّحْمَنِ بْنُ جَوْشَنٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12923  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عُيَيْنَةَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ جَوْشَنٍ ،  حَدَّثَنِي  أَبِي  أَنَّ  ابْنَ عَبَّاسٍ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ نَبِيذِ  الْجَرِّ  .","","Al-Mu'jam al-Kabir 12923","","عبد الله بن عباس عن عبد الرحمن بن جوشن الغطفاني عن عيينة بن عبد الرحمن الغطفاني عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عبد الرحمن بن جوشن عن ابن عباس"
"12959","[  شِهَابٌ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12924  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدِ  عَنِ  حَبِيبِ بْنِ شِهَابٍ ،  حَدَّثَنِي  أَبِي  قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا فِي النَّاسِ مِثْلُ رَجُلٍ أَخَذَ         [12/213]      بِرَأْسِ فَرَسِهِ يُجَاهِدُ فِي  سَبِيلِ  اللهِ  ، وَيَحْبِسُ شَرَّهُ عَنِ النَّاسِ ، وَمِثْلُ رَجُلٍ بَادٍ فِي نِعْمَةٍ يَقْرِي بِضَيْفِهِ ، وَيُعْطِي حَقَّهُ  .","","Al-Mu'jam al-Kabir 12924","","عبد الله بن عباس عن شهاب بن مدلج المدلجي عن حبيب بن شهاب العنبري عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","شهاب عن ابن عباس"
"12960","[  الْحَكَمُ بْنُ الْأَعْرَجِ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12925  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  مُعَاوِيَةَ بْنِ غَلَّابٍ ،  عَنِ  الْحَكَمِ بْنِ الْأَعْرَجِ أَنَّهُ :  أَتَى ابْنَ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ وَهُوَ مُتَوَسِّدٌ رِدَاءَهُ فِي  الْمَسْجِدِ الْحَرَامِ  فَسَأَلَهُ عَنْ صِيَامِ يَوْمِ عَاشُورَاءَ  فَقَالَ  : "" إِذَا رَأَيْتَ هِلَالَ الْمُحَرَّمِ فَاعْدُدْ فَإِذَا كَانَ يَوْمُ التَّاسِعِ فَأَصْبِحْ صَائِمًا ، فَقُلْتُ : أَكَذَلِكَ كَانَ  مُحَمَّدٌ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَصُومُ ؟ قَالَ : كَذَلِكَ كَانَ  مُحَمَّدٌ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَصُومُ  .","","Al-Mu'jam al-Kabir 12925","","عبد الله بن عباس عن الحكم بن عبد الله بن إسحاق الأعرج عن معاوية بن عمرو بن غلاب النصري عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","الحكم بن الأعرج عن ابن عباس"
"12961","[  أَبُو جَهْضَمٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12926  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  لَيْثٍ ،  عَنْ  أَبِي جَهْضَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ رَآنِي فِي الْمَنَامِ فَقَدْ رَآنِي  فَإِنَّ الشَّيْطَانَ لَا يَتَمَثَّلُ بِي  .","","Al-Mu'jam al-Kabir 12926","","عبد الله بن عباس عن موسى بن سالم مولى العباس بن عبد المطلب عن ليث بن أبي سليم عن سفيان الثوري عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أبو جهضم عن ابن عباس"
"12962","12927  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا         [12/214]      شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي حَسَّانَ ،  عَنْ  أَنَسِ بْنِ سُلَيْمٍ الْجَهْضَمِيِّ ، قَالَ :  قُلْتُ  لِابْنِ عَبَّاسٍ : مَا أَخْبَارٌ قَدْ تَفَشَّتْ فِي النَّاسِ تَقُولُ : "" مَنْ طَافَ  بِالْبَيْتِ  فَقَدْ  حَلَّ  ؟ فَقَالَ : "" تِلْكَ سُنَّةُ نَبِيِّكُمْ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَإِنْ رَغِمْتُمْ  "" .","","Al-Mu'jam al-Kabir 12927","","عبد الله بن عباس عن أنس بن سليم الهجيمي عن مسلم بن عبد الله الأحرد عن قتادة بن دعامة عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","أبو جهضم عن ابن عباس"
"12963","[  يُوسُفُ بْنُ مِهْرَانَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12928  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ وَغَيْرِ وَاحِدٍ ،  عَنِ  الْحَسَنِ ، قَالَ :  لَمَّا نَزَلَتْ آيَةُ الدَّيْنِ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ أَوَّلَ مَنْ جَحَدَ  آدَمُ  ، إِنَّ أَوَّلَ مَنْ جَحَدَ  آدَمُ  ، إِنَّ أَوَّلَ مَنْ جَحَدَ  آدَمُ  ، إِنَّ اللهَ عَزَّ وَجَلَّ لَمَّا خَلَقَهُ مَسَحَ ظَهْرَهُ ، فَأَخْرَجَ ذُرِّيَّتَهُ ، وَكُلَّ مَا هُوَ ذَارٍ إِلَى يَوْمِ الْقِيَامَةِ ، فَجَعَلَ يَعْرِضُهُمْ عَلَيْهِ ، فَرَأَى فِيهِمْ رَجُلًا  أَزْهَرَ  ، فَقَالَ : يَا رَبِّ ، أَيُّ بَنِيَّ هَذَا ؟ قَالَ : هَذَا ابْنُكَ  دَاوُدُ  ، قَالَ : أَيْ رَبِّ ، كَمْ عُمْرُهُ ؟ قَالَ : سِتُّونَ سَنَةً ، قَالَ : أَيْ رَبِّ ، زِدْ فِي عُمُرِهِ ، قَالَ : لَا إِلَّا أَنْ تَزِيدَهُ مِنْ عُمْرِكَ ، وَكَانَ  آدَمُ  عُمْرُهُ أَلْفَ عَامٍ فَوَهَبَ مِنْ عُمْرِهِ أَرْبَعِينَ عَامًا ، قَالَ : فَكَتَبَ عَلَيْهِ بِذَلِكَ كِتَابًا ، وَأَشْهَدَ عَلَيْهِ الْمَلَائِكَةَ ، فَلَمَّا احْتُضِرَ  آدَمُ  أَتَتْهُ الْمَلَائِكَةُ لِتَقْبِضَهُ ، قَالَ : إِنَّهُ قَدْ بَقِيَ مِنْ عُمْرِي أَرْبَعُونَ سَنَةً ، فَقَالَ : إِنَّكَ قَدْ وَهَبْتَهَا لِابْنِكَ  دَاوُدَ  ، فَقَالَ : مَا فَعَلْتُ ، مَا وَهَبْتُ لَهُ شَيْئًا ، فَأَنْزَلَ اللهُ الْكِتَابَ ، وَشَهِدَتْ عَلَيْهِ الْمَلَائِكَةُ ، فَكَمَّلَ اللهُ  لِآدَمَ  أَلْفَ سَنَةٍ ، وَأَكْمَلَ  لِدَاوُدَ  مِائَةَ عَامٍ  .","","Al-Mu'jam al-Kabir 12928","","عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","يوسف بن مهران عن ابن عباس"
"12964","[12/215]      12929  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  قَالَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ : قَدْ حُبِّبَتْ إِلَيْكَ الصَّلَاةُ  فَخُذْ مِنْهَا مَا شِئْتَ  .","","Al-Mu'jam al-Kabir 12929","","عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","يوسف بن مهران عن ابن عباس"
"12965","12930  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  نَزَلَتْ سُورَةُ الْأَنْعَامِ جُمْلَةً  بِمَكَّةَ  لَيْلًا وَحَوْلَهَا  سَبْعُونَ أَلْفَ مَلَكٍ يَجْرُونَ بِالتَّسْبِيحِ  "" .","","Al-Mu'jam al-Kabir 12930","","عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","يوسف بن مهران عن ابن عباس"
"12966","12931  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ  رَجُلًا  أَتَى  عُمَرَ بْنَ الْخَطَّابِ  فَقَالَ : إِنَّ  امْرَأَةً  أَتَتْنِي أُبَايِعُهَا فَأَدْخَلْتُهَا  الدَّوْلَجَ  فَضَرَبْتُ بِيَدِي إِلَيْهَا ، وَرَاوَدْتُهَا ، وَصَنَعْتُ بِهَا كُلَّ شَيْءٍ غَيْرَ الْجِمَاعِ ، فَقَالَ لَهُ  عُمَرُ  : وَيْحَكَ لَعَلَّهَا  مُغِيبٌ  ، قَالَ : نَعَمْ ، قَالَ : ائْتِ  أَبَا بَكْرٍ  فَسَلْهُ ، فَأَتَاهُ ، فَقَالَ لَهُ مَا قَالَ  لِعُمَرَ  ، فَقَالَ : وَيْحَكَ لَعَلَّهَا  مُغِيبٌ  ، فَأَتَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ لَهُ مِثْلَ مَا قَالَ  لِأَبِي بَكْرٍ  وَعُمَرَ  ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  وَيْحَكَ لَعَلَّهَا  مُغِيبٌ  فِي  سَبِيلِ  اللهِ  ، قَالَ : أَجَلْ فَسَكَتَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَنَزَلَ الْقُرْآنُ :         {      وَأَقِمِ الصَّلاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ         }             [12/216]      إِلَى آخِرِ الْآيَةِ ، فَقَالَ الرَّجُلُ : يَا رَسُولَ اللهِ لِي خَاصَّةً أَمْ لِلنَّاسِ عَامَّةً ؟ فَرَفَعَ  عُمَرُ  يَدَهُ فَضَرَبَ صَدْرَهُ ، فَقَالَ : لَا وَاللهِ ، وَلَا كَرَامَةَ ، وَلَكِنْ لِلنَّاسِ عَامَّةً ، فَضَحِكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقَالَ : "" صَدَقَ  عُمَرُ  .","","Al-Mu'jam al-Kabir 12931","","عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","يوسف بن مهران عن ابن عباس"
"12967","12932  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَمَّا أَغْرَقَ اللهُ  فِرْعَوْنَ  قَالَ : آمَنْتُ أَنَّهُ لَا إِلَهَ إِلَّا الَّذِي آمَنَتْ بِهِ  بَنُو إِسْرَائِيلَ  ، فَقَالَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ : يَا  مُحَمَّدُ  لَوْ رَأَيْتَنِي ، وَأَنَا آخُذُ مِنْ  حَالِ  الْبَحْرِ فَأَدُسُّهُ فِي فِيهِ مَخَافَةَ أَنْ تُدْرِكَهُ الرَّحْمَةُ  .","","Al-Mu'jam al-Kabir 12932","","عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","يوسف بن مهران عن ابن عباس"
"12968","12933  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا أَحَدٌ مِنْ بَنِي آدَمَ إِلَّا وَقَدْ أَخْطَأَ  أَوْ هَمَّ بِخَطِيئَةٍ ،  لَيْسَ  يَحْيَى بْنَ زَكَرِيَّا  .","","Al-Mu'jam al-Kabir 12933","","عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","يوسف بن مهران عن ابن عباس"
"12969","12934  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ (  ح  ) .  وَحَدَّثَنَا  زَكَرِيَّا بْنُ حَمْدَوَيْهِ الصَّفَّارُ  ، ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ         [12/217]      عَبَّاسٍ ، قَالَ :  جَاءَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَرَدِيفُهُ  أُسَامَةُ بْنُ زَيْدٍ  فَسَقَيْنَاهُ مِنْ هَذَا الشَّرَابِ -  يَعْنِي شَرَابَ السِّقَايَةِ  - فَقَالَ :  أَحْسَنْتُمْ هَكَذَا فَاصْنَعُوا  .","","Al-Mu'jam al-Kabir 12934","","عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن عفان بن مسلم الصفار عن زكريا بن حمدويه الصفار عن الطبراني","يوسف بن مهران عن ابن عباس"
"12970","12935  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدٍ الشَّافِعِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  قَرَأْنَاهَا عَلَى عَهْدِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَنَتَيْنِ         {      وَالَّذِينَ لا يَدْعُونَ مَعَ اللهِ إِلَهًا آخَرَ وَلا يَقْتُلُونَ النَّفْسَ الَّتِي حَرَّمَ اللهُ إِلا بِالْحَقِّ وَلا يَزْنُونَ         }      الْآيَةَ ، ثُمَّ نَزَلَتْ :         {      إِلا مَنْ تَابَ         }      ، "" فَمَا رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَرِحَ فَرَحًا قَطُّ أَشَدَّ مِنْهُ بِهَا ، وَبِـ         {      إِنَّا فَتَحْنَا لَكَ فَتْحًا مُبِينًا         }      .","","Al-Mu'jam al-Kabir 12935","","عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن عبيد الله بن عمر العمري عن عبد الله بن رجاء البصري عن إبراهيم بن محمد بن العباس المطلبي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","يوسف بن مهران عن ابن عباس"
"12971","12936  -  حَدَّثَنَا  زَكَرِيَّا بْنُ حَمْدَوَيْهِ الصَّفَّارُ ،  ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : لَمَّا مَاتَ  عُثْمَانُ بْنُ مَظْعُونٍ  ، فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 12936","","عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن زكريا بن حمدويه الصفار عن الطبراني","يوسف بن مهران عن ابن عباس"
"12972","12937  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  سُلَيْمَانُ بْنُ عُبَيْدِ اللهِ الْغَيْلَانِيُّ ،  ثَنَا  سَلْمُ بْنُ قُتَيْبَةَ ،  ثَنَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" طَافَ  بِالْبَيْتِ  عَلَى رَاحِلَتِهِ يَسْتَلِمُ  الرُّكْنَ  بِمِحْجَنِهِ  .","","Al-Mu'jam al-Kabir 12937","","عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن الحسن بن أبي جعفر الجفري عن سلم بن قتيبة الشعيري عن سليمان بن عبيد الله الغيلاني عن البزار عن الطبراني","يوسف بن مهران عن ابن عباس"
"12973","[12/218]      12938  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عِمْرَانَ  ، ثَنَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ ،  ثَنَا  أَبُو عَاصِمٍ الْعَبَّادَانِيُّ ،  ثَنَا  عَلِيُّ بْنُ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كُنَّا فِي حَلْقَةٍ فِي الْمَسْجِدِ نَتَذَاكَرُ فَضَائِلَ الْأَنْبِيَاءِ ، أَيُّهُمْ أَفْضَلُ ؟ فَذَكَرْنَا  نُوحًا  وَطُولَ عِبَادَتِهِ رَبَّهُ ، وَذَكَرْنَا  إِبْرَاهِيمَ  خَلِيلَ  الرَّحْمَنِ ، وَذَكَرْنَا  مُوسَى  كَلِيمَ اللهِ ، وَذَكَرْنَا  عِيسَى ابْنَ مَرْيَمَ  ، وَذَكَرْنَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَبَيْنَا نَحْنُ كَذَلِكَ إِذْ خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" مَا تَذَّاكَرُونَ بَيْنَكُمْ ؟ "" قُلْنَا : يَا رَسُولَ اللهِ ، تَذَاكَرْنَا فَضَائِلَ الْأَنْبِيَاءِ ، أَيُّهُمْ أَفْضَلُ ؟ ذَكَرْنَا  نُوحًا  وَطُولَ عِبَادَتِهِ ، وَذَكَرْنَا  إِبْرَاهِيمَ  خَلِيلَ  الرَّحْمَنِ ، وَذَكَرْنَا  مُوسَى  كَلِيمَ الرَّحْمَنِ ، وَذَكَرْنَا  عِيسَى ابْنَ مَرْيَمَ  ، وَذَكَرْنَاكَ يَا رَسُولَ اللهِ ، قَالَ : فَمَنْ فَضَّلْتُمْ ؟ قُلْنَا : فَضَلَّنَاكَ يَا رَسُولَ اللهِ ، بَعَثَكَ اللهُ إِلَى النَّاسِ كَافَّةً ، وَغَفَرَ لَكَ مَا تَقَدَّمَ مِنْ ذَنْبِكَ وَمَا تَأَخَّرَ ، وَأَنْتَ خَاتَمُ الْأَنْبِيَاءِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَمَا إِنَّهُ لَا يَنْبَغِي لِأَحَدٍ أَنْ يَقُولَ : أَنَا خَيْرٌ مِنْ  يَحْيَى بْنِ زَكَرِيَّا  قُلْنَا : يَا رَسُولَ اللهِ ، وَمِنْ أَيْنَ ذَاكَ ؟ قَالَ : "" أَمَا سَمِعْتُمُ اللهَ كَيْفَ وَصَفَهُ فِي الْقُرْآنِ ؟ فَقَالَ :         {      يَا يَحْيَى خُذِ الْكِتَابَ بِقُوَّةٍ وَآتَيْنَاهُ الْحُكْمَ صَبِيًّا         }      ، فَقَرَأَ حَتَّى بَلَغَ         {      وَسَيِّدًا وَحَصُورًا وَنَبِيًّا مِنَ الصَّالِحِينَ         }      لَمْ يَعْمَلْ سَيِّئَةً قَطُّ ، وَلَمْ يَهُمَّ بِهَا  .","","Al-Mu'jam al-Kabir 12938","","عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن عبد الله بن عبيد الله العباداني عن الفلاس عن عبد الله بن محمد بن عمران الأصبهاني عن الطبراني","يوسف بن مهران عن ابن عباس"
"12974","12939  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ الْبُخَارِيُّ ،  ثَنَا  عَلِيُّ بْنُ الْحَكَمِ بْنِ ظِبْيَانَ الْأَنْصَارِيُّ ،         [12/219]      ثَنَا  سَلَّامٌ أَبُو الْمُنْذِرِ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا مِنْ آدَمِيٍّ إِلَّا فِي رَأْسِهِ  حِكْمَةٌ  بِيَدِ مَلَكٍ  ، فَإِذَا تَوَاضَعَ قِيلَ لِلْمَلَكِ : ارْفَعْ  حِكْمَتَهُ  ، وَإِذَا تَكَبَّرَ قِيلَ لِلْمَلَكِ : ضَعْ حِكْمَتَهُ  .","","Al-Mu'jam al-Kabir 12939","","عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن سلام بن سليمان المزني عن علي بن الحكم بن ظبيان المؤدب عن البخاري عن محمد بن صالح النرسي عن الطبراني","يوسف بن مهران عن ابن عباس"
"12975","12940  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلُّوَيْهِ الْقَطَّانُ  ، ثَنَا  أَبُو نَصْرٍ التَّمَّارُ (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" أَتَاهُ فِيمَا يَرَى النَّائِمُ الْمَلَكَانِ ، فَقَعَدَ أَحَدُهُمَا عِنْدَ رِجْلَيْهِ ، وَالْآخَرُ عِنْدَ رَأْسِهِ  ، فَقَالَ الَّذِي عِنْدَ رِجْلَيْهِ لِلَّذِي عِنْدَ رَأْسِهِ : اضْرِبْ مَثَلَ هَذَا وَمَثَلَ أُمَّتِهِ ، قَالَ : إِنَّ مَثَلَ هَذَا وَمَثَلَ أُمَّتِهِ كَمَثَلِ قَوْمٍ  سَفْرٍ  انْتَهَوْا إِلَى رَأْسِ مَفَازَةٍ فَلَمْ يَكُنْ مَعَهُمْ مِنَ الزَّادِ مَا يَقْطَعُونَ بِهِ الْمَفَازَةَ وَلَا مَا يَرْجِعُونَ بِهِ ، فَبَيْنَمَا هُمْ كَذَلِكَ إِذْ أَتَاهُمْ رَجُلٌ عَلَيْهِ  حُلَّةٌ  حَبَرَةٍ ، فَقَالَ : أَرَأَيْتُمْ إِنْ وَرَدْتُ بِكُمْ رِيَاضًا مُعْشِبَةً وَحِيَاضًا رُوَاءً أَتَتَّبِعُونِي ؟ قَالُوا : نَعَمْ ، فَانْطَلَقَ بِهِمْ فَأَوْرَدَهُمْ رِيَاضًا مُعْشِبَةً وَحِيَاضًا رُوَاءً ، فَأَكَلُوا ، وَشَرِبُوا ، وَأَسْمَنُوا ، فَقَالَ لَهُمْ : أَلَمْ أَلْفَكُمْ عَلَى تِلْكَ الْحَالِ ؟ قَالُوا : بَلَى ، فَجَعَلْتُمْ إِنْ وَرَدْتُ بِكُمْ رِيَاضًا مُعْشِبَةً وَحِيَاضًا رُوَاءً أَنْ تَتَّبِعُونِي ؟ قَالُوا : نَعَمْ ، فَقَالَتْ طَائِفَةٌ مِنْهُمْ : صَدَقَ ، وَاللهِ لَنَتَّبِعَهُ ، وَقَالَتْ طَائِفَةٌ مِنْهُمْ : قَدْ رَضِينَاهَا نُقِيمُ عَلَيْهَا  .","","Al-Mu'jam al-Kabir 12940","","عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","يوسف بن مهران عن ابن عباس"
"12976","12941  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ ، وَأَبُو زُرْعَةَ         [12/220]      الدِّمَشْقِيُّ ، قَالَا :  ثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ ،  ثَنَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ،         {      مَا كَذَبَ الْفُؤَادُ مَا رَأَى         }      ، قَالَ : "" رَأَى رَبَّهُ عَزَّ وَجَلَّ بِفُؤَادِهِ  .","","Al-Mu'jam al-Kabir 12941","","عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن مبارك بن فضالة عن آدم بن أبي إياس عن أبو زرعة الدمشقي عن الطبراني","يوسف بن مهران عن ابن عباس"
"12977","12942  -  حَدَّثَنَا  سَهْلُ بْنُ مُوسَى  ، ثَنَا  عُمَرُ بْنُ يَحْيَى الْأُبُلِّيُّ ،  ثَنَا  عِيسَى بْنُ شُعَيْبٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَادَ أَعْمَى حَتَّى يُبْلِغَهُ مَأْمَنَهُ غَفَرَ اللهُ تَعَالَى لَهُ أَرْبَعِينَ كَبِيرَةً  ، وَأَرْبَعَ كَبَائِرَ تُوجِبُ النَّارَ  .","","Al-Mu'jam al-Kabir 12942","","عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن عيسى بن شعيب بن إبراهيم النحوي عن عمر بن يحيى الأبلي عن شيران سهل بن موسى الرامهرمزي عن الطبراني","يوسف بن مهران عن ابن عباس"
"12978","[  أَبُو حَاضِرٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12943  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْمَرْوَزِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ الْوَاسِطِيُّ ،  ثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  عَنْ  أَبِي السَّوَّارِ السُّلَمِيِّ ،  عَنْ  أَبِي حَاضِرٍ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" احْتَجَمَ  بِالْقَاحَةِ  ، وَهُوَ مُحْرِمٌ  .","","Al-Mu'jam al-Kabir 12943","","عبد الله بن عباس عن عثمان بن حاضر الحميري عن أبو السوار السلمي عن عباد بن العوام الكلابي عن سعيد بن سليمان سعدويه عن محمد بن يحيى بن سليمان الوراق عن الطبراني","أبو حاضر عن ابن عباس"
"12979","[  أَبُو جَمْرَةَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12944  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،         [12/221]      ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  بِمَكَّةَ  ثَلَاثَ عَشْرَةَ سَنَةً يُوحَى إِلَيْهِ  ،  وَبِالْمَدِينَةِ  عَشْرًا ، وَمَاتَ وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  .","","Al-Mu'jam al-Kabir 12944","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو جمرة عن ابن عباس"
"12980","12945  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ مِهْرَانَ ،  ثَنَا  عِمْرَانُ بْنُ تَمَّامٍ ،  ثَنَا  أَبُو جَمْرَةَ نَصْرُ بْنُ عِمْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَقُولُ :  مِنْ إِكْفَاءِ الدِّينِ تَصَفُّحُ النَّبَطِ  ، وَاتِّخَاذُهُمُ الْقُصُورَ فِي الْأَمْصَارِ  .","","Al-Mu'jam al-Kabir 12945","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن عمران بن تمام عن ابن النطاح محمد بن صالح بن مهران عن بحشل عن الطبراني","أبو جمرة عن ابن عباس"
"12981","12946  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ  ، ثَنَا  هِلَالُ بْنُ بِشْرٍ ،  ثَنَا  عِمْرَانُ بْنُ تَمَّامٍ ،  عَنْ  أَبِي جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اعْتَمُّوا تَزْدَادُوا حِلْمًا  .","","Al-Mu'jam al-Kabir 12946","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن عمران بن تمام عن هلال بن بشر بن محبوب الأحدب عن محمد بن صالح النرسي عن الطبراني","أبو جمرة عن ابن عباس"
"12982","12947  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ         [12/222]      عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  عُمَرُ بْنُ صَالِحٍ الْأَزْدِيُّ ،  ثَنَا  أَبُو جَمْرَةَ نَصْرُ بْنُ عِمْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَتَبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى حَيٍّ مِنَ الْعَرَبِ يَدْعُوهُمْ إِلَى الْإِسْلَامِ فَلَمْ يَقْبَلُوا الْكِتَابَ وَرَجَعُوا إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَخْبَرُوهُ ، فَقَالَ :  أَمَا إِنِّي لَوْ بَعَثْتُ بِهِ إِلَى قَوْمٍ بِشَطِّ  عُمَانَ  مِنْ  أَزْدِ شَنُوءَةَ  وَأَسْلَمَ  لَقَبِلُوهُ  ثُمَّ بَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  الْجُلَنْدَى  يَدْعُوهُ إِلَى الْإِسْلَامِ فَقَبِلَهُ ، وَأَسْلَمَ ، وَبَعَثَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِهَدِيَّةٍ ، فَقَدِمَتْ وَقَدْ قُبِضَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَعَلَ  أَبُو بَكْرٍ  الْهَدِيَّةَ مَوْرِثًا فَقَسَمَهَا بَيْنَ  فَاطِمَةَ  وَبَيْنَ النَّاسِ  .","","Al-Mu'jam al-Kabir 12947","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن عمر بن صالح بن أبي الزاهرية الأوقص عن سليمان بن عبد الرحمن التميمي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","أبو جمرة عن ابن عباس"
"12983","12948  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ قِيرَاطٍ الدِّمَشْقِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  عُمَرُ بْنُ صَالِحٍ الْأَزْدِيُّ ،  ثَنَا  أَبُو جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قَدِمَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَرْبَعُمِائَةٍ مِنْ  دَوْسٍ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَرْحَبًا أَحْسَنَ النَّاسِ وُجُوهًا ، وَأَطْيَبَهُمْ أَفْوَاهًا ، وَأَعْظَمَهُمْ أَمَانَةً  .","","Al-Mu'jam al-Kabir 12948","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن عمر بن صالح بن أبي الزاهرية الأوقص عن سليمان بن عبد الرحمن التميمي عن إسماعيل بن محمد بن عبيد الله العذري عن الطبراني","أبو جمرة عن ابن عباس"
"12984","12949  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي وَمُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ، قَالَا :  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ (  ح  ) .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَمْرُو بْنُ حَكَّامٍ ، قَالَ  عَمْرُو بْنُ مَرْزُوقٍ  : وَأَخْبَرَنَا  شُعْبَةُ ، وَقَالَ  عَمْرُو بْنُ حَكَّامٍ  : ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي جَمْرَةَ ،         [12/223]      عَنِ  ابْنِ عَبَّاسٍ  أَنَّ وَفْدَ  عَبْدِ الْقَيْسِ  لَمَّا قَدِمُوا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : "" مَنِ  الْقَوْمُ  ؟ "" قَالُوا :  رَبِيعَةُ  ، قَالَ : "" مَرْحَبًا بِالْوَفْدِ غَيْرِ الْخَزَايَا ، وَلَا النَّادِمِينَ "" ، قَالُوا : يَا رَسُولَ اللهِ ، إِنَّا حَيٌّ مِنْ  رَبِيعَةَ  ، وَإِنَّا نَأْتِيكَ مِنْ  شُقَّةٍ  بَعِيدَةٍ ، وَإِنَّهُ يَحُولُ بَيْنَنَا وَبَيْنَكَ هَذَا الْحَيُّ مِنْ كُفَّارِ  مُضَرَ  ، وَإِنَّا لَا نَصِلُ إِلَيْكَ إِلَّا فِي شَهْرٍ حَرَامٍ ، فَمُرْنَا بِأَمْرٍ  فَصْلٍ  تَدْعُو إِلَيْهِ ، وَنَدْعُو إِلَيْهِ مَنْ وَرَاءَنَا ، وَنَدْخُلُ بِهِ الْجَنَّةَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  آمُرُكُمْ بِأَرْبَعٍ ، وَأَنْهَاكُمْ عَنْ أَرْبَعٍ  ، آمُرُكُمْ بِالْإِيمَانِ بِاللهِ شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، أَتَدْرُونَ مَا الْإِيمَانُ ؟ شَهَادَةُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَإِقَامُ الصَّلَاةِ ، وَإِيتَاءُ الزَّكَاةِ ، وَصَوْمُ رَمَضَانَ ، وَأَنْ تُعْطُوا مِنَ الْغَنَائِمِ الْخُمُسَ ، وَأَنْهَاكُمْ عَنْ أَرْبَعٍ : عَنِ  الدُّبَّاءِ  ،  وَالْحَنْتَمِ  ،  وَالنَّقِيرِ  ،  وَالْمُزَفَّتِ  - قَالَ  : وَرُبَّمَا قَالَ وَالْمُقَيَّرِ  - احْفَظُوهُنَّ ، وَادْعُوا إِلَيْهِنَّ مَنْ وَرَاءَكُمْ  .","","Al-Mu'jam al-Kabir 12949","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن شعبة بن الحجاج عن عمرو بن حكام الزنجبيلي عن أبو مسلم الكجي عن الطبراني","أبو جمرة عن ابن عباس"
"12985","12950  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، وَعَارِمٌ أَبُو النُّعْمَانِ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  شِهَابُ بْنُ عَبَّادٍ الْعَبْدِيُّ ، قَالُوا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَبِي جَمْرَةَ ، قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ :  قَدِمَ وَفْدُ  عَبْدِ الْقَيْسِ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ إِنَّ هَذَا الْحَيَّ مِنْ  رَبِيعَةَ  قَدْ حَالَ بَيْنَنَا وَبَيْنَكَ كُفَّارُ  مُضَرَ  ، فَلَسْنَا نَخْلُصُ إِلَيْكَ إِلَّا فِي شَهْرٍ حَرَامٍ ، فَمُرْنَا بِأَمْرٍ نَأْخُذُ بِهِ وَنَدْعُو إِلَيْهِ مَنْ وَرَاءَنَا ، قَالَ :  آمُرُكُمْ بِأَرْبَعٍ ، وَأَنْهَاكُمْ عَنْ أَرْبَعٍ  : الْإِيمَانِ بِاللهِ : شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ - وَعَقَدَ بِيَدِهِ - وَإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَصَوْمِ رَمَضَانَ ، وَأَنْ تُؤَدُّوا خُمُسَ مَا غَنِمْتُمْ ، وَأَنْهَاكُمْ عَنِ  الدُّبَّاءِ  ،  وَالنَّقِيرِ  ،  وَالْحَنْتَمِ  ،  وَالْمُزَفَّتِ  .","","Al-Mu'jam al-Kabir 12950","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن حماد بن زيد عن شهاب بن عباد الرواس عن محمد بن أحمد بن النضر النضري عن الطبراني","أبو جمرة عن ابن عباس"
"12986","12951  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :         [12/224]      ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  نَهَى عَنِ  الدُّبَّاءِ ،  وَالْمُزَفَّتِ  ،  وَالنَّقِيرِ  ،  وَالْحَنْتَمِ  .","","Al-Mu'jam al-Kabir 12951","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو جمرة عن ابن عباس"
"12987","12952  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حَيَّانَ الْمَازِنِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  أَبُو مَعْشَرٍ الْبَرَّاءُ ،  ثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  أَبُو جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  قَدِمَ وَفْدُ  عَبْدِ الْقَيْسِ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا : يَا رَسُولَ اللهِ إِنَّ بَيْنَنَا وَبَيْنَكَ كُفَّارَ  مُضَرَ  ، وَإِنَّا لَا نَصِلُ إِلَيْكَ إِلَّا فِي أَشْهُرِ الْحُرُمِ ، فَمُرْنَا بِأَمْرٍ نَنْتَهِي إِلَيْهِ ، وَنَدْعُو إِلَيْهِ مَنْ وَرَاءَنَا ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَرْبَعٌ وَأَرْبَعٌ ؛ شَهَادَةُ أَنْ لَا إِلَهَ إِلَّا اللهُ  ، وَأَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ ، وَإِقَامُ الصَّلَاةِ ، وَإِيتَاءُ الزَّكَاةِ ، وَصَوْمُ رَمَضَانَ ، وَخُمُسُ مَا غَنِمْتُمْ ، وَأَنْهَاكُمْ عَنْ نَبِيذِ  الدُّبَّاءِ  ،  وَالْحَنْتَمِ  ،  وَالنَّقِيرِ  ،  وَالْمُزَفَّتِ  .","","Al-Mu'jam al-Kabir 12952","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن سعيد بن عبد الرحمن الرقاشي عن يوسف بن يزيد البراء عن محمد بن أبي بكر المقدمي عن محمد بن حيان المازني عن الطبراني","أبو جمرة عن ابن عباس"
"12988","12953  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبَّادُ بْنُ عَبَّادٍ ،  ثَنَا  أَبُو جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  قَدِمَ وَفْدُ  عَبْدِ الْقَيْسِ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا : يَا رَسُولَ اللهِ إِنَّا هَذَا الْحَيَّ مِنْ  رَبِيعَةَ  قَدْ حَالَ بَيْنَنَا وَبَيْنَكَ كُفَّارُ  مُضَرَ  ، وَلَا نَخْلُصُ إِلَيْكَ إِلَّا فِي شَهْرٍ حَرَامٍ ، فَمُرْنَا بِأَمْرٍ نَعْمَلُ بِهِ ، وَنَدْعُو إِلَيْهِ مَنْ وَرَاءَنَا ، قَالَ :  آمُرُكُمْ بِأَرْبَعٍ ، وَأَنْهَاكُمْ عَنْ أَرْبَعٍ  : الْإِيمَانِ - وَفَسَّرَهَا لَهُمْ - شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، وَإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَأَنْ تُؤَدُّوا خُمُسَ مَا غَنِمْتُمْ ، وَأَنْهَاكُمْ عَنِ  الدُّبَّاءِ  ،  وَالْحَنْتَمِ  ،  وَالنَّقِيرِ  ، وَالْمُقَيَّرِ  .","","Al-Mu'jam al-Kabir 12953","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن عباد بن عباد بن حبيب عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو جمرة عن ابن عباس"
"12989","12954  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصِ بْنِ الصَّبَّاحِ  الرَّقِّيُّ  ، ثَنَا  أَبُو         [12/225]      مَعْمَرٍ الْمُقْعَدُ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  أَبِي التَّيَّاحِ ،  عَنْ  أَبِي جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ وَفْدَ  عَبْدِ الْقَيْسِ  قَدِمُوا عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : "" مَرْحَبًا بِالْوَفْدِ "" ، قَالُوا : يَا رَسُولَ اللهِ إِنَّا حَيٌّ مِنْ  رَبِيعَةَ  ، وَإِنَّ بَيْنَنَا وَبَيْنَكَ كُفَّارَ  مُضَرَ  ، وَلَا نَخْلُصُ إِلَيْكَ إِلَّا فِي شَهْرٍ حَرَامٍ ، فَمُرْنَا بِأَمْرٍ نَأْخُذُ بِهِ ، وَنَدْعُو إِلَيْهِ مَنْ وَرَاءَنَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  آمُرُكُمْ بِأَمْرٍ ، وَأَنْهَاكُمْ عَنْ أَرْبَعٍ : الْإِيمَانِ بِاللهِ شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ  ، وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، وَإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَأَنْ تُؤَدُّوا خُمُسَ مَا غَنِمْتُمْ ، وَأَنْهَاكُمْ عَنِ  الدُّبَّاءِ  ،  وَالنَّقِيرِ  ،  وَالْحَنْتَمِ  ،  وَالْمُزَفَّتِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب (حفص بن عمر بن الصباح) .","","Al-Mu'jam al-Kabir 12954","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن يزيد بن حميد الضبعي عن عبد الوارث بن سعيد بن ذكوان عن عبد الله بن عمرو المقعد عن حفص بن عمر سنجة ألف عن الطبراني","أبو جمرة عن ابن عباس"
"12990","12955  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ بْنِ عَنْبَرٍ الْبَصْرِيُّ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  بِسْطَامُ بْنُ مُسْلِمٍ ،  عَنْ  أَبِي جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ وَفْدَ  عَبْدِ الْقَيْسِ  أَتَوُا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا : يَا رَسُولَ اللهِ إِنَّ بَيْنَنَا وَبَيْنَكَ كُفَّارَ  مُضَرَ  ، وَإِنَّا لَا نَسْتَطِيعُ أَنْ نَأْتِيَكَ كُلَّمَا شِئْنَا ، فَأَنْبِئْنَا مَا يَحِلُّ لَنَا مِمَّا يَحْرُمُ عَلَيْنَا ، قَالَ :  آمُرُكُمْ بِأَرْبَعٍ ، وَأَنْهَاكُمْ عَنْ أَرْبَعٍ  : أَنْ تُقِيمُوا الصَّلَاةَ ، وَتُؤْتُوا الزَّكَاةَ ، وَتَصُومُوا رَمَضَانَ ، وَتُعْطُوا الْخُمُسَ مِنَ الْغَنَائِمِ ، وَأَنْهَاكُمْ عَنِ  الدُّبَّاءِ  ،  وَالْحَنْتَمِ  ،  وَالنَّقِيرِ  ،  وَالْمُزَفَّتِ  .","","Al-Mu'jam al-Kabir 12955","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن بسطام بن مسلم العوذي عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن أحمد بن ابراهيم بن عنبر البصري عن الطبراني","أبو جمرة عن ابن عباس"
"12991","12956  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ (  ح  ) .  وَحَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الزِّيَادِيُّ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، قَالَا :  ثَنَا  أَبُو هِلَالٍ ،  عَنْ  أَبِي جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ وَفْدَ  عَبْدِ الْقَيْسِ  قَدِمُوا عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا : يَا رَسُولَ اللهِ إِنَّ بَيْنَنَا وَبَيْنَكَ كُفَّارَ  مُضَرَ  ، وَإِنَّا لَا نَصِلُ إِلَيْكَ إِلَّا فِي شَهْرٍ حَرَامٍ ، فَمُرْنَا بِمَا يَحِلُّ لَنَا مِمَّا يَحْرُمُ عَلَيْنَا ، قَالَ :  آمُرُكُمْ بِأَمْرٍ ، وَأَنْهَاكُمْ عَنْ         [12/226]      أَرْبَعٍ  ، آمُرُكُمْ بِشَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَصَوْمِ رَمَضَانَ ، وَأَنْ تُعْطُوا الْخُمُسَ مِمَّا غَنِمْتُمْ ، وَأَنْهَاكُمْ عَنِ  الدُّبَّاءِ  ،  وَالْحَنْتَمِ  ،  وَالنَّقِيرِ  ،  وَالْمُزَفَّتِ  .","","Al-Mu'jam al-Kabir 12956","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن محمد بن سليم الراسبي عن مسلم بن إبراهيم الشحام عن جعفر بن محمد بن الليث الزيادي عن الطبراني","أبو جمرة عن ابن عباس"
"12992","12957  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  الْحُسَيْنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ  ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  ثَنَا  يَزِيدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُحَمَّدِ بْنِ سَلَمَةَ بْنِ أَبِي حَفْصَةَ ،  عَنْ  أَبِي جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَوَّلُ جُمُعَةٍ  جُمِّعَتْ  بَعْدَ جُمُعَةٍ  بِالْمَدِينَةِ  جُمُعَةٌ  بِالْبَحْرَيْنِ  فِي قَرْيَةٍ  لِعَبْدِ الْقَيْسِ  يُقَالُ لَهَا  جُوَاثَى  ""  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( الحسن )","","Al-Mu'jam al-Kabir 12957","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن محمد بن أبي حفصة البصري عن يزيد بن عبد العزيز بن سياه الحماني عن يحيى بن آدم عن الحسن بن علي الريحاني عن الحسين بن إسحاق التستري عن الطبراني","أبو جمرة عن ابن عباس"
"12993","12958  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  أَبِي جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَوَّلُ جُمُعَةٍ  جُمِّعَتْ  بِالْمَدِينَةِ  ثُمَّ جُمُعَةُ  جُوَاثَى  ""  .","","Al-Mu'jam al-Kabir 12958","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن إبراهيم بن طهمان عن زيد بن الحباب العكلي عن محمد بن أبي بكر المقدمي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","أبو جمرة عن ابن عباس"
"12994","12959  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  الْمُثَنَّى بْنُ سَعِيدٍ الْقَصِيرُ ،  ثَنَا  أَبُو جَمْرَةَ  أَنَّ ابْنَ عَبَّاسٍ  أَخْبَرَهُمْ  عَنْ بُدُوِّ إِسْلَامِ  أَبِي ذَرٍّ  قَالَ : لَمَّا بَلَغَهُ أَنَّ رَجُلًا خَرَجَ  بِمَكَّةَ  يَزْعُمُ أَنَّهُ نَبِيٌّ بَعَثَ أَخَاهُ ، فَقَالَ : ائْتِ  مَكَّةَ  حَتَّى تَسْمَعَ مِنْهُ ، وَتَأْتِيَنِي بِخَبَرِهِ ، فَانْطَلَقَ أَخُوهُ إِلَى  مَكَّةَ  ، فَسَمِعَ مِنْ نَبَأِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَانْصَرَفَ إِلَى  أَبِي ذَرٍّ  ، فَأَخْبَرَهُ أَنَّهُ يَأْمُرُ بِالْمَعْرُوفِ ، وَيَنْهَى عَنِ الْمُنْكَرِ ، وَيَأْمُرُ بِمَكَارِمِ  الْأَخْلَاقِ  ، فَقَالَ : مَا شَفَيْتَنِي ، ثُمَّ أَخَذَ شَنَّةً فِيهَا مَاءٌ ،  وَإِدَاوَةٌ  ثُمَّ انْطَلَقَ حَتَّى أَتَى  مَكَّةَ  فَفَرِقَ أَنْ يَسْأَلَ أَحَدًا عَنْ شَيْءٍ ، وَلَمْ يَلْقَ         [12/227]      رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى  جَنَّهُ  اللَّيْلُ ، فَلَمَّا أَعْتَمَ مَرَّ بِهِ  عَلِيُّ بْنُ أَبِي طَالِبٍ  فَقَالَ : مَنِ الرَّجُلُ ؟ قَالَ : رَجُلٌ مِنْ  غِفَارٍ  ، فَانْطَلِقْ إِلَى مَنْزِلِكَ ، فَانْطَلَقَ بِهِ إِلَى مَنْزِلِهِ لَا يَسْأَلُ وَاحِدٌ مِنْهُمَا صَاحِبَهُ عَنْ شَيْءٍ ، فَلَمَّا أَصْبَحَ غَدَا فَلَمْ يَلْقَهُ ، فَقَامَ نَاحِيَةً فِي الْمَسْجِدِ ، فَمَرَّ بِهِ  عَلِيُّ بْنُ أَبِي طَالِبٍ  ، فَقَالَ : أَمَا  آنَ  لِلرَّجُلِ أَنْ يَعْرِفَ مَنْزِلَهُ ، فَانْطَلَقَ بِهِ لَا يَسْأَلُ أَحَدُهُمَا صَاحِبَهُ عَنْ شَيْءٍ ، فَلَمَّا كَانَ الْيَوْمُ الثَّالِثُ أَخَذَ عَلَى  عَلِيٍّ  لَئِنْ أَخْبَرَهُ بِالَّذِي يُرِيدُ لَيَكْتُمَنَّ عَلَيْهِ وَلَيَسْتُرَنَّ عَنْهُ ، فَفَعَلَ ، فَقَالَ : إِنَّهُ بَلَغَنِي أَنَّ رَجُلًا خَرَجَ  بِمَكَّةَ  لَيَزْعُمُ أَنَّهُ نَبِيٌّ ، فَبَعَثْتُ بِأَخِي فَلَمْ يَأْتِنِي بِمَا يَشْفِينِي ، فَجِئْتُ بِنَفْسِي لِأَخْبُرَ خَبَرَهُ ، فَقَالَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  : فَاتَّبِعْ أَثَرِي ، فَإِنِّي إِنْ رَأَيْتُ مَا أَخَافُ عَلَيْكَ مِنْهُ قُمْتُ كَأَنِّي أَبُولُ ، وَرَجَعْتُ إِلَيْكَ ، وَإِنْ لَمْ أَرَ شَيْئًا فَاتَّبِعْ أَثَرِي ، فَغَدَا  عَلِيٌّ  ، وَغَدَا  أَبُو ذَرٍّ  عَلَى أَثَرِهِ حَتَّى دَخَلَا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَخْبَرَهُ خَبَرَهُ ، وَسَمِعَ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، مُرْنِي بِأَمْرِكَ ، قَالَ :  ارْجِعْ إِلَى قَوْمِكَ حَتَّى يَبْلُغَكَ خَبَرِي  ، فَقَالَ : لَا وَاللهِ لَا رَجَعْتُ حَتَّى أَصْرُخَ بِالْإِسْلَامِ ، فَخَرَجَ إِلَى الْمَسْجِدِ فَنَادَى بِالصَّلَاةِ ، وَقَالَ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، فَقَالَ الْمُشْرِكُونَ :  صَبَأَ  الرَّجُلُ  صَبَأَ  الرَّجُلُ ، فَضَرَبُوهُ حَتَّى سَقَطَ ، فَمَرَّ بِهِ  الْعَبَّاسُ بْنُ عَبْدِ الْمُطَّلِبِ  فَانْكَبَّ عَلَيْهِ ، ثُمَّ قَالَ : يَا مَعْشَرَ  قُرَيْشٍ  أَنْتُمْ تُجَّارٌ ، وَطَرِيقُكُمْ عَلَى  غِفَارٍ  ، تُرِيدُونَ أَنْ تُقْطَعَ الطَّرِيقُ عَنْكُمْ ، فَأَمْسَكُوا عَنْهُ ، فَلَمَّا كَانَ الْيَوْمُ الثَّانِي عَادَ لِمِثْلِ مَقَالَتِهِ فَضَرَبُوهُ ، فَمَرَّ عَلَيْهِ  الْعَبَّاسُ  ، فَقَالَ لَهُمْ مِثْلَ ذَلِكَ ، فَأَمْسَكُوا عَنْهُ ، فَهَذَا كَانُ بُدُوُّ الْإِسْلَامِ  لِأَبِي ذَرٍّ  رَضِيَ اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 12959","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن المثنى بن سعيد القسام عن أبو مسلم الكجي عن الطبراني","أبو جمرة عن ابن عباس"
"12995","[12/228]      12960  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ الْمِصْرِيُّ  ، ثَنَا  يُوسُفُ بْنُ عَدِيٍّ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنْ  مَطَرِ بْنِ طَهْمَانَ الْوَرَّاقِ ،  عَنْ  أَبِي جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  دَخَلَتِ  الْعُمْرَةُ فِي  الْحَجِّ  إِلَى يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 12960","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن مطر بن طهمان الوراق عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن عبد الرحيم بن سليمان الأشل عن يوسف بن عدي بن رزق الكوفي عن عمرو بن أبي الطاهر المصري عن الطبراني","أبو جمرة عن ابن عباس"
"12996","12961  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ الْأَنْمَاطِيُّ  ، ثَنَا  عُبَيْدُ بْنُ جَنَّادٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  عَمْرِو بْنِ عُبَيْدٍ ،  عَنْ  أَبِي جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَتَانِي  جِبْرِيلُ  عَلَيْهِ السَّلَامُ فِي ثَلَاثٍ بَقِينَ مِنْ ذِي الْقِعْدَةِ ، فَقَالَ :  دَخَلَتِ  الْعُمْرَةُ فِي  الْحَجِّ  إِلَى يَوْمِ الْقِيَامَةِ "" فَعِنْدَ ذَلِكَ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوِ  اسْتَقْبَلْتُ  مِنْ أَمْرِي مَا اسْتَدْبَرْتُ مَا سُقْتُ الْهَدْيَ  .","","Al-Mu'jam al-Kabir 12961","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن عمرو بن عبيد عن عبيد الله بن عمرو بن أبي الوليد عن عبيد بن جناد الرقي عن محمد بن الحسين الأنماطي عن الطبراني","أبو جمرة عن ابن عباس"
"12997","12962  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَنَا  شُعْبَةُ ،  عَنْ  أَبِي جَمْرَةَ ، قَالَ :  تَمَتَّعْتُ فَنَهَانِي نَاسٌ ،  فَسَأَلْتُ  ابْنَ عَبَّاسٍ  ، فَأَمَرَنِي بِهَا ، فَرَأَيْتُ فِي الْمَنَامِ كَأَنَّ قَائِلًا يَقُولُ : حَجٌّ  مَبْرُورٌ  ، وَعُمْرَةٌ مُتَقَبَّلَةٌ  ، فَحَدَّثْتُ بِهِ ابْنَ عَبَّاسٍ فَقَالَ : "" اللهُ أَكْبَرُ سُنَّةُ  أَبِي الْقَاسِمِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" أَوْ قَالَ : "" سُنَّةُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 12962","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن شعبة بن الحجاج عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","أبو جمرة عن ابن عباس"
"12998","12963  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  شُعْبَةُ ،         [12/229]      عَنْ  أَبِي جَمْرَةَ ، قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ ، يَقُولُ :  أُدْخِلَ قَبْرَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَطِيفَةٌ حَمْرَاءُ  .","","Al-Mu'jam al-Kabir 12963","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن شعبة بن الحجاج عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو جمرة عن ابن عباس"
"12999","12964  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَمْرُو بْنُ حَكَّامٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي جَمْرَةَ ، قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يُصَلِّي مِنَ اللَّيْلِ ثَلَاثَ عَشْرَةَ رَكْعَةً  .","","Al-Mu'jam al-Kabir 12964","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن شعبة بن الحجاج عن عمرو بن حكام الزنجبيلي عن أبو مسلم الكجي عن الطبراني","أبو جمرة عن ابن عباس"
"13000","12965  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَمْرُو بْنُ حَكَّامٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي جَمْرَةَ ، قَالَ :  قُلْتُ لَهُ : هَلْ سَمِعْتَ ابْنَ عَبَّاسٍ يَقُولُ فِي مُتْعَةِ النِّسَاءِ شَيْئًا ؟  قَالَ :  سَمِعْتُهُ  يُرَخِّصُ فِيهَا ، فَقَالَ لَهُ مَوْلًى لَهُ : "" إِنَّمَا كَانَتِ  الْمُتْعَةُ  وَبِالنَّاسِ حَاجَةٌ وَفِي النِّسَاءِ قِلَّةٌ "" فَقَالَ لَهُ  ابْنُ عَبَّاسٍ  : صَدَقْتَ  .","","Al-Mu'jam al-Kabir 12965","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن شعبة بن الحجاج عن عمرو بن حكام الزنجبيلي عن أبو مسلم الكجي عن الطبراني","أبو جمرة عن ابن عباس"
"13001","12966  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُعَلَّى بْنُ أَسَدٍ الْعَمِّيُّ ،  ثَنَا  عَمْرُو بْنُ الْمُسَاوِرِ الْعَتَكِيُّ ،  ثَنَا  أَبُو جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَا تَطْلُبَنَّ حَاجَةً إِلَى أَعْمَى ، وَلَا تَطْلُبَنَّهَا لَيْلًا ، وَإِذَا طَلَبْتَ الْحَاجَةَ فَاسْتَقْبِلِ الرَّجُلَ بِوَجْهِكَ ، فَإِنَّ الْحَيَاءَ فِي الْعَيْنَيْنِ ، وَبَاكِرْ حَاجَتَكَ فَإِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اللَّهُمَّ بَارِكْ لِأُمَّتِي فِي بُكُورِهَا  .","","Al-Mu'jam al-Kabir 12966","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن عمرو بن المساور العتكي عن معلى بن أسد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو جمرة عن ابن عباس"
"13002","12967  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ ، وَمُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ، وَأَبُو شُعَيْبِ بْنُ الْحَسَنِ الْحَرَّانِيُّ ، قَالُوا :  ثَنَا  عَفَّانُ بْنُ         [12/230]      مُسْلِمٍ ،  ثَنَا  هَمَّامٌ ،  عَنْ  أَبِي جَمْرَةَ ، قَالَ :  كُنْتُ أَدْفَعُ الزِّحَامَ عَنِ ابْنِ عَبَّاسٍ ، فَاحْتَبَسْتُ عَنْهُ أَيَّامًا ،  فَقَالَ لِي  : مَا حَبَسَكَ ؟ قُلْتُ : الْحُمَّى ، قَالَ : فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْحُمَّى مِنْ  فَيْحِ  جَهَنَّمَ  فَأَبْرِدُوهَا بِمَاءِ زَمْزَمَ  .","","Al-Mu'jam al-Kabir 12967","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن همام بن يحيى بن دينار عن عفان بن مسلم الصفار عن أبو شعيب الحراني عن الطبراني","أبو جمرة عن ابن عباس"
"13003","12968  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  ثَوَّابُ بْنُ عُتْبَةَ ،  عَنْ  أَبِي جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَعْطَى  مُحَمَّدَ بْنَ مَسْلَمَةَ  سَيْفًا فَقَالَ :  قَاتِلِ الْمُشْرِكِينَ مَا قُوتِلُوا  ، فَإِذَا رَأَيْتَ سَيْفَيْنِ اخْتَلَفَا بَيْنَ الْمُسْلِمِينَ فَاضْرِبْ حَتَّى يَنْثَلِمَ وَاقْعُدْ فِي بَيْتِكِ حَتَّى تَأْتِيَكَ مَنِيَّةٌ قَاضِيَةٌ أَوْ يَدٌ خَاطِئَةٌ "" ثُمَّ أَتَيْتُ ابْنَ عُمَرَ فَحَذَا لِي عَلَى مِثْلِهِ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 12968","","عبد الله بن عمر بن الخطاب عن نصر بن عمران بن عصام الضبعي عن ثواب بن عتبة المهري عن أبو الوليد الطيالسي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","أبو جمرة عن ابن عباس"
"13004","12969  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْوَهَّابِ الْحَجَبِيُّ ،  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  ثَنَا  قُرَّةُ بْنُ خَالِدٍ ،  عَنْ  أَبِي جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِأَشَجِّ عَبْدِ الْقَيْسِ  :  إِنَّ فِيكَ  خَصْلَتَيْنِ  يُحِبُّهُمَا اللهُ : الْحِلْمُ ، وَالْأَنَاةُ  .","","Al-Mu'jam al-Kabir 12969","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن قرة بن خالد السدوسي عن بشر بن المفضل عن عبد الله بن عبد الوهاب الحجبي عن أبو مسلم الكجي عن الطبراني","أبو جمرة عن ابن عباس"
"13005","12970  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ  ، ثَنَا  وَهْبُ بْنُ يَحْيَى بْنِ زِمَامٍ الْعَلَّافُ ،  ثَنَا  مُحَمَّدُ بْنُ سَوَاءٍ ،  ثَنَا  شُبَيْلُ بْنُ         [12/231]      عَزْرَةَ ،  عَنْ  أَبِي جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَيْرُ أَهْلِ الْمَشْرِقِ  عَبْدُ الْقَيْسِ  .","","Al-Mu'jam al-Kabir 12970","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن شبيل بن عزرة الضبعي عن محمد بن سواء السدوسي عن وهب بن يحيى بن زمام العلاف عن محمد بن صالح النرسي عن الطبراني","أبو جمرة عن ابن عباس"
"13006","12971  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مُوسَى بْنُ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ النَّضْرِ ،  عَنْ  حَجَّاجٍ الْعَائِشِيِّ ،  عَنْ  أَبِي جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَنَا  حَجِيجُ  مَنْ ظَلَمَ  عَبْدَ الْقَيْسِ  .","","Al-Mu'jam al-Kabir 12971","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن حجاج العائشي عن إبراهيم بن النضر العجلي عن محمد بن بشر بن الفرافصة عن موسى بن عبد الرحمن بن سعيد المسروقي عن أحمد بن يحيى بن زهير التستري عن الطبراني","أبو جمرة عن ابن عباس"
"13007","12972  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مُوسَى بْنُ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ النَّضْرِ ،  عَنْ  إِبْرَاهِيمَ الْعَائِشِيِّ ،  عَنْ  أَبِي  جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اللَّهُمَّ اغْفِرْ  لِعَبْدِ الْقَيْسِ  "" ثَلَاثًا  .  تصحفت في طبعة مكتبة ابن تيمية : ( ابن ) .","","Al-Mu'jam al-Kabir 12972","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن حجاج العائشي عن إبراهيم بن النضر العجلي عن محمد بن بشر بن الفرافصة عن موسى بن عبد الرحمن بن سعيد المسروقي عن أحمد بن يحيى بن زهير التستري عن الطبراني","أبو جمرة عن ابن عباس"
"13008","[12/232]      12973  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الرَّقَاشِيُّ ،  ثَنَا  يَزِيدُ بْنُ زَيْدٍ أَبُو خَالِدٍ ،  عَنْ  أَبِي جَمْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اللَّهُمَّ اغْفِرْ  لِعَبْدِ الْقَيْسِ  "" ثَلَاثًا  .","","Al-Mu'jam al-Kabir 12973","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن يزيد بن زيد البصري عن محمد بن عبد الله بن محمد بن عبد الملك الرقاشي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو جمرة عن ابن عباس"
"13009","[  عَبْدُ الْعَزِيزِ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12974  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ  ، ثَنَا  خَالِدُ بْنُ خِدَاشٍ ،  ثَنَا  سُكَيْنُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَبَّاسٍ ، قَالَ :  كَانَ  الْفَضْلُ بْنُ الْعَبَّاسِ  رَدِيفَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ هَذَا يَوْمٌ مَنْ مَلَكَ فِيهِ سَمْعَهُ ، وَبَصَرَهُ ، وَلِسَانَهُ غُفِرَ لَهُ  .","","Al-Mu'jam al-Kabir 12974","","عبد الله بن عباس عن عبد العزيز بن قيس العبدي عن سكين بن عبد العزيز بن قيس المجاشعي عن خالد المهلبي عن محمد بن علي بن شعيب السمسار عن الطبراني","عبد العزيز عن ابن عباس"
"13010","[  زِيَادٌ مَوْلَى ابْنِ عَيَّاشٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12975  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  حَسَّانُ بْنُ غَالِبٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي النَّضْرِ الْمَدِينِيِّ ،  عَنْ  زِيَادٍ مَوْلَى ابْنِ عَبَّاسٍ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ تُوُفِّيَ  سَعْدُ بْنُ مُعَاذٍ  وَقَفَ عَلَى قَبْرِهِ ، ثُمَّ  اسْتَرْجَعَ  ، ثُمَّ قَالَ :  لَوْ نَجَا مِنْ ضَغْطَةِ الْقَبْرِ أَحَدٌ لَنَجَا  سَعْدٌ  ، لَقَدْ ضَغَطَهُ ، ثُمَّ رُخِيَ عَنْهُ  "" .  في طبعة مكتبة ابن تيمية ( عباس ) ، والصواب المثبت وينظر ترجمته في التهذيبين ، وقد تقدم عند المصنف على الصواب  كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب ( عياش ) كذا أخرجه الفسوي في المعرفة ومن طريقه ابن عساكر . والله أعلم","","Al-Mu'jam al-Kabir 12975","","عبد الله بن عباس عن زياد بن أبي زياد المخزومي عن سالم بن أبي أمية التيمي عن عبد الله بن لهيعة عن حسان بن غالب المصري عن يحيى بن عثمان بن صالح عن الطبراني","زياد مولى ابن عباس عن ابن عباس"
"13011","[12/233]      [  مَالِكُ بْنُ سَعْدٍ التُّجِيبِيُّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12976  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِي ،  عَنْ  حَيْوَةَ بْنِ شُرَيْحٍ ،  ثَنَا  مَالِكُ بْنُ الْخَيْرِ الزِّيَادِيُّ  أَنَّ مَالِكَ بْنَ سَعْدٍ التُّجِيبِيَّ  حَدَّثَهُ  أَنَّهُ : سَمِعَ  ابْنَ عَبَّاسٍ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  أَتَانِي  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، فَقَالَ : يَا  مُحَمَّدُ  إِنَّ اللهَ لَعَنَ الْخَمْرَ  وَعَاصِرَهَا وَمُعْتَصِرَهَا وَشَارِبَهَا وَحَامِلَهَا وَالْمَحْمُولَةَ إِلَيْهِ وَبَائِعَهَا وَمُبْتَاعَهَا وَسَاقِيَهَا وَمُسْقِيَهَا  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( الزبادي ) .","","Al-Mu'jam al-Kabir 12976","","عبد الله بن عباس عن مالك بن سعد التجيبي عن مالك بن الخير الزبادي عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","مالك بن سعد التجيبي عن ابن عباس"
"13012","[  ثَابِتُ بْنُ يَزِيدَ الْخَوْلَانِيُّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12977  -  حَدَّثَنَا  طَاهِرُ بْنُ عِيسَى بْنِ قَيْرَسٍ الْمِصْرِيُّ  ، ثَنَا  أَصْبَغُ بْنُ الْفَرَجِ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَبْدُ الرَّحْمَنِ بْنُ شُرَيْحٍ ، وَاللَّيْثُ بْنُ سَعْدٍ ، وَابْنُ لَهِيعَةَ  عَنْ  خَالِدِ بْنِ يَزِيدَ ،  عَنْ  ثَابِتِ بْنِ يَزِيدَ الْخَوْلَانِيِّ ،  أَخْبَرَهُ أَنَّهُ قَدِمَ  الْمَدِينَةَ  فَلَقِيَ ابْنَ عَبَّاسٍ فَسَأَلَهُ عَنِ الْخَمْرِ ، فَقَالَ : سَأُخْبِرُكَ عَنِ الْخَمْرِ ، إِنِّي كُنْتُ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْمَسْجِدِ ، فَبَيْنَمَا هُوَ مُحْتَبٍ حَلَّ حَبْوَتَهُ ، ثُمَّ قَالَ : "" مَنْ كَانَ عِنْدَهُ مِنَ الْخَمْرِ شَيْءٌ فَلْيُؤْذِنِّي بِهِ "" ، فَجَعَلَ النَّاسُ يَأْتُونَهُ فَيَقُولُ أَحَدُهُمْ : عِنْدِي رَاوِيَةٌ ، وَيَقُولُ الْآخَرُ : عِنْدِي رَاوِيَةٌ ، وَيَقُولُ الْآخَرُ : عِنْدِي زُقَاقٌ وَمَا شَاءَ اللهُ أَنْ يَكُونَ عِنْدَهُ ، فَقَالَ         [12/234]      رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اجْمَعُوهُ بِبَقِيعِ كَذَا وَكَذَا ، ثُمَّ آذِنُونِي "" ، فَقَامَ وَقُمْتُ مَعَهُ ، فَمَشَيْتُ عَنْ يَمِينِهِ وَهُوَ مُتَّكِئٌ عَلَيَّ ، فَلَحِقَنَا  أَبُو بَكْرٍ  ، فَأَخَذَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَعَلَنِي عَنْ يَسَارِهِ ، وَجَعَلَ  أَبَا بَكْرٍ  مَكَانِي ، ثُمَّ لَحِقَنَا  عُمَرُ بْنُ الْخَطَّابِ  ، فَأَخَذَهُ ، فَجَعَلَهُ عَنْ يَسَارِهِ ، فَمَشَى بَيْنَهُمَا حَتَّى إِذَا وَقَفَ عَلَى الْخَمْرِ قَالَ لِلنَّاسِ : "" أَتَعْرِفُونَ هَذِهِ ؟ "" قَالُوا : نَعَمْ يَا رَسُولَ اللهِ هَذِهِ الْخَمْرُ ، قَالَ :  صَدَقْتُمْ إِنَّ اللهَ لَعَنَ الْخَمْرَ وَعَاصِرَهَا وَمُعْتَصِرَهَا وَشَارِبَهَا وَسَاقِيَهَا وَآكِلَ ثَمَنِهَا  ثُمَّ دَعَا  بِسِكِّينٍ  ، فَقَالَ : ""  اشْحَذُوهَا  "" فَفَعَلُوا ، ثُمَّ أَخَذَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَخَرَقَ الْأَزْقَاقَ ، فَقَالَ النَّاسُ : إِنَّ فِي هَذِهِ الْأَزْقَاقِ مَنْفَعَةً ، فَقَالَ : "" أَجَلْ ، وَلَكِنِّي إِنَّمَا أَفْعَلُ ذَلِكَ غَضَبًا لِلهِ لِمَا فِيهَا مِنْ  سَخْطَةٍ  قَالَ : وَبَعْضُهُمْ يَزِيدُ عَلَى بَعْضٍ فِي الْحَدِيثِ  .","","Al-Mu'jam al-Kabir 12977","","عبد الله بن عباس عن ثابت بن يزيد الخولاني عن خالد بن يزيد الجمحي عن عبد الرحمن بن شريح المعافري عن عبد الله بن وهب المصري عن أصبغ بن الفرج مولى عمر بن عبد العزيز عن طاهر بن عيسى بن قيرس المؤدب عن الطبراني","ثابت بن يزيد الخولاني عن ابن عباس"
"13013","[  عَبْدُ الرَّحْمَنِ وَعْلَةَ السَّبَئِيُّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12978  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  بَكْرِ بْنِ مُضَرَ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنْ  أَبِي الْخَيْرِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ وَعْلَةَ السَّبَئِيِّ  أَنَّهُ قَالَ لِعَبْدِ اللهِ بْنِ عَبَّاسٍ :  نَغْزُو  الْمَغْرِبَ  فَكَيْفَ تَرَى فِي قِرَبِهِمْ ؟ فَقَالَ  ابْنُ عَبَّاسٍ  : "" لَا بَأْسَ بِهَا  ، فَقُلْتُ : أَمِنْ رَأْيِكَ أَوْ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : "" بَلْ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 12978","","عبد الله بن عباس عن عبد الرحمن بن وعلة السبائي عن مرثد بن عبد الله اليزني عن جعفر بن ربيعة الكندي عن بكر بن مضر المصري عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عبد الرحمن بن وعلة السبئي عن ابن عباس"
"13014","[12/235]      12979  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  بَكْرُ بْنُ مُضَرَ ،  ثَنَا  جَعْفَرُ بْنُ رَبِيعَةَ  أَنَّهُ : سَمِعَ  أَبَا الْخَيْرِ ،  يُخْبِرُ عَنِ  ابْنِ وَعْلَةَ ،  أَنَّهُ سَأَلَ  ابْنَ عَبَّاسٍ ، فَقَالَ :  إِنَّا نَغْزُو هَذَا  الْمَغْرِبَ  ، وَهُمْ أَهْلُ وَثَنٍ وَلَهُمْ قِرَبٌ يَكُونُ فِيهَا اللَّبَنُ وَالْمَاءُ ، فَقَالَ  ابْنُ عَبَّاسٍ  :  الدِّبَاغُ طَهُورٌ  ، فَقَالَ  ابْنُ وَعْلَةَ  : عَنْ رَأْيِكَ أَوْ شَيْئًا سَمِعْتَهُ ؟ قَالَ : "" بَلْ شَيْءٌ سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 12979","","عبد الله بن عباس عن عبد الرحمن بن وعلة السبائي عن مرثد بن عبد الله اليزني عن جعفر بن ربيعة الكندي عن بكر بن مضر المصري عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","عبد الرحمن بن وعلة السبئي عن ابن عباس"
"13015","[  أَبُو حَمْزَةَ الْخَوْلَانِيُّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12980  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  الْحَارِثُ بْنُ يَزِيدَ ،  عَنْ  أَبِي حَمْزَةَ الْخَوْلَانِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ  قَالَ  لِلْعَبَّاسِ  ،  وَلِلْفَضْلِ بْنِ عَبَّاسِ  : اذْكُرَا لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَأْمُرَ لَكُمَا مِنَ الصَّدَقَاتِ ، وَإِنِّي سَأُحْضِرُ لَكُمَا ، فَذَكَرَ ذَلِكَ  الْفَضْلُ  لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  اصْبِرُوا عَلَى أَنْفُسِكُمْ يَا  بَنِي هَاشِمٍ  فَإِنَّمَا الصَّدَقَاتُ غُسَالَاتُ النَّاسِ  .  [  عَمْرُو بْنُ حُرَيْثٍ  ، عَنِ  ابْنِ عَبَّاسٍ .  ]","","Al-Mu'jam al-Kabir 12980","","عبد الله بن عباس عن أبو حمزة الخولاني عن الحارث بن سعيد العتقي عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","أبو حمزة الخولاني عن ابن عباس"
"13016","12981  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  ثَنَا  سَعِيدُ عُفَيْرٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنِ  ابْنِ هُبَيْرَةَ ،  عَنْ  عَمْرِو بْنِ حُرَيْثٍ  أَنَّ  ابْنَ عَبَّاسٍ فَذَكَرَهُ .","","Al-Mu'jam al-Kabir 12981","","عبد الله بن عباس عن عمرو بن حريث بن عمرو المخزومي عن عبد الله بن هبيرة السبئي عن عبد الله بن لهيعة عن سعيد بن كثير بن عفير عن روح بن الفرج القطان عن الطبراني","أبو حمزة الخولاني عن ابن عباس"
"13017","[12/236]      [  ابْنُ مَوْهَبٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12982  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ  ، ثَنَا  مُحَمَّدُ بْنُ سُفْيَانَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي قَبِيلٍ أَنَّ ابْنَ مَوْهَبٍ  أَخْبَرَهُ  أَنَّهُ  كَانَ عِنْدَ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ  ، فَدَخَلَ عَلَيْهِ  مَرْوَانُ  فَكَلَّمَهُ فِي حَوَائِجِهِ ، فَقَالَ : اقْضِ حَاجَتِي يَا أَمِيرَ الْمُؤْمِنِينَ ، فَوَاللهِ إِنَّ مُؤْنَتِي لَعَظِيمَةٌ ، إِنِّي أَصْبَحْتُ أَبَا عَشَرَةٍ ، وَأَخَا عَشَرَةٍ ، وَعَمَّ عَشَرَةٍ ، فَلَمَّا أَدْبَرَ  مَرْوَانُ  ،  وَابْنُ عَبَّاسٍ  جَالِسٌ مَعَ  مُعَاوِيَةَ  عَلَى سَرِيرِهِ ، فَقَالَ مُعَاوِيَةُ  أَنْشُدُكَ  اللهَ يَا ابْنَ عَبَّاسٍ أَمَا تَعْلَمُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا بَلَغَ  بَنُو الْحَكَمِ  ثَلَاثِينَ رَجُلًا اتَّخَذُوا آيَاتِ اللهِ بَيْنَهُمْ دُوَلًا ، وَعِبَادَهُ  خَوَلًا  ، وَكِتَابَهُ  دَغَلًا  ، فَإِذَا بَلَغُوا تِسْعَةً وَتِسْعِينَ وَأَرْبَعَمِائَةٍ كَانَ هَلَاكُهُمْ أَسْرَعَ مِنَ  الثَّمَرَةِ  "" ؟ قَالَ  ابْنُ عَبَّاسٍ  : اللَّهُمَّ نَعَمْ ، فَذَكَرَ  مَرْوَانُ  حَاجَةً لَهُ فَرَدَّ  مَرْوَانُ عَبْدِ الْمَلِكِ  إِلَى  مُعَاوِيَةَ  فَكَلَّمَهُ فِيهَا ، فَلَمَّا أَدْبَرَ قَالَ  مُعَاوِيَةُ  :  أَنْشُدُكَ  اللهَ يَا  ابْنَ عَبَّاسٍ  أَمَا تَعْلَمُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَكَرَ هَذَا . فَقَالَ :  أَبُو الْجَبَابِرَةِ الْأَرْبَعَةِ  ، قَالَ  ابْنُ عَبَّاسٍ  : اللَّهُمَّ نَعَمْ ، فَلِذَلِكَ ادَّعَى  مُعَاوِيَةُ  زِيَادًا  .","","Al-Mu'jam al-Kabir 12982","","عبد الله بن عباس عن عبد الله بن موهب الهمداني عن حيي بن هانئ السريعي عن عبد الله بن لهيعة عن محمد بن سفيان عن أحمد بن محمد بن الحجاج المصري عن الطبراني","ابن موهب عن ابن عباس"
"13018","[  حَنَشٌ الصَّنْعَانِيُّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12983  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ حَبِيبٍ  ،  عَنْ  عَامِرِ بْنِ يَحْيَى ،  عَنْ  حَنَشٍ الصَّنْعَانِيِّ ،         [12/237]      عَنِ  ابْنِ عَبَّاسٍ  أَنَّ أُنَاسًا مِنْ  حِمْيَرَ  أَتَوُا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْأَلُونَهُ عَنْ أَشْيَاءَ ، فَقَالَ  رَجُلٌ  مِنْهُمْ : إِنِّي أُحِبُّ النِّسَاءَ ، وَأُحِبُّ أَنْ آتِيَ امْرَأَتِي  مُجَبِّيَةً  فَكَيْفَ تَرَى فِي ذَلِكَ ؟ فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      نِسَاؤُكُمْ حَرْثٌ لَكُمْ فَأْتُوا حَرْثَكُمْ أَنَّى شِئْتُمْ         }      ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ائْتِهَا مُقْبِلَةً ، وَمُدْبِرَةً إِذَا كَانَ ذَلِكَ فِي الْفَرْجِ  "" .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( يزيد بن أبي حبيب )","","Al-Mu'jam al-Kabir 12983","","عبد الله بن عباس عن حنش بن عبد الله السبائي عن عامر بن يحيى الشرعبي عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","حنش الصنعاني عن ابن عباس"
"13019","12984  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ، وَعَمْرُو بْنُ خَالِدٍ ، قَالَا :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  خَالِدِ بْنِ أَبِي عِمْرَانَ ،  عَنْ  حَنَشِ بْنِ عَبْدِ اللهِ الصَّنْعَانِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  وُلِدَ نَبِيُّكُمْ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ الِاثْنَيْنِ  ، وَيَوْمَ الِاثْنَيْنِ خَرَجَ مِنْ  مَكَّةَ  ، وَدَخَلَ  الْمَدِينَةَ  يَوْمَ الِاثْنَيْنِ ، وَفَتَحَ  بَدْرًا  يَوْمَ الِاثْنَيْنِ ، وَنَزَلَتْ سُورَةُ الْمَائِدَةِ يَوْمَ الِاثْنَيْنِ         {      الْيَوْمَ أَكْمَلْتُ لَكُمْ دِينَكُمْ         }      وَرَفَعَ الرُّكْنَ يَوْمَ الِاثْنَيْنِ ، وَتُوُفِّيَ فِي يَوْمِ الِاثْنَيْنِ  .","","Al-Mu'jam al-Kabir 12984","","عبد الله بن عباس عن حنش بن عبد الله السبائي عن خالد التجيبي عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن روح بن الفرج القطان عن الطبراني","حنش الصنعاني عن ابن عباس"
"13020","12985  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ زَحْرٍ ،  عَنْ  خَالِدِ بْنِ أَبِي عِمْرَانَ ،  عَنْ  حَنَشٍ الصَّنْعَانِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْإِسْلَامُ ثَلَاثُمِائَةِ شَرِيعَةٍ  ، وَثَلَاثَ عَشْرَةَ شَرِيعَةً لَيْسَ فِيهَا شَرِيعَةٌ يَلْقَى اللهَ بِهَا صَاحِبُهَا إِلَّا وَهُوَ يَدْخُلُ بِهَا الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 12985","","عبد الله بن عباس عن حنش بن عبد الله السبائي عن خالد التجيبي عن عبيد الله بن زحر الضمري عن يحيى بن أيوب الغافقي عن عبد الله بن صالح المصري عن يحيى بن عثمان بن صالح عن الطبراني","حنش الصنعاني عن ابن عباس"
"13021","[12/238]      12986  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ هُبَيْرَةَ ،  عَنْ  حَنَشٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فِي أَبْوَالِ الْإِبِلِ وَأَلْبَانِهَا شِفَاءٌ  لِلذَّرِبَةِ  بُطُونُهُمْ  .","","Al-Mu'jam al-Kabir 12986","","عبد الله بن عباس عن حنش بن عبد الله السبائي عن عبد الله بن هبيرة السبئي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","حنش الصنعاني عن ابن عباس"
"13022","12987  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  يَحْيَى بْنُ إِسْحَاقَ السَّيْلَحِينِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ هُبَيْرَةَ ،  عَنِ  الْأَعْرَجِ ،  عَنْ  حَنَشٍ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ يَخْرُجُ فَيُهَرِيقُ الْمَاءَ فَيَتَمَسَّحُ بِالتُّرَابِ  فَأَقُولُ : يَا رَسُولَ اللهِ إِنَّ الْمَاءَ مِنْكَ قَرِيبٌ ، فَيَقُولُ : "" لَعَلِّي لَا أَبْلُغُهُ  .","","Al-Mu'jam al-Kabir 12987","","عبد الله بن عباس عن حنش بن عبد الله السبائي عن الأعرج عن عبد الله بن هبيرة السبئي عن عبد الله بن لهيعة عن يحيى بن إسحاق السيلحيني عن بشر بن موسى بن صالح الأسدي عن الطبراني","حنش الصنعاني عن ابن عباس"
"13023","12988  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  قَيْسِ بْنِ الْحَجَّاجِ ،  عَنْ  حَنَشٍ الصَّنْعَانِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّهُ :  كَانَ خَلْفَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ لِي وَأَنَا رَدِيفٌ خَلْفَهُ :  يَا غُلَامُ إِنِّي مُعَلِّمُكَ كَلِمَاتٍ فَاحْفَظْهُنَّ ، احْفَظِ اللهَ يَحْفَظْكَ  احْفَظِ اللهَ تَجِدْهُ تُجَاهَكَ ، وَإِذَا سَأَلْتَ فَاسْأَلِ اللهَ ، وَإِذَا اسْتَعَنْتَ فَاسْتَعِنْ بِاللهِ ، وَاعْلَمْ أَنَّ الْأُمَّةَ لَوِ اجْتَمَعُوا عَلَى أَنْ يَنْفَعُوكَ لَمْ يَنْفَعُوكَ إِلَّا بِشَيْءٍ قَدْ كَتَبَهُ اللهُ لَكَ ،  جَفَّتِ  الْأَقْلَامُ ، وَطُوِيَتِ الصُّحُفُ  .","","Al-Mu'jam al-Kabir 12988","","عبد الله بن عباس عن حنش بن عبد الله السبائي عن قيس بن الحجاج الحميري عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","حنش الصنعاني عن ابن عباس"
"13024","12989  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ،  ثَنَا  أَبُو صَدَقَةَ الْقَرَاطِيسِيُّ مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى ،  أَنَا  نَافِعُ بْنُ يَزِيدَ ،  أَخْبَرَنِي  قَيْسُ         [12/239]      بْنُ الْحَجَّاجِ ،  عَنْ  حَنَشٍ الصَّنْعَانِيِّ  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عَبَّاسٍ يَقُولُ : كُنْتُ رَدِيفَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَذَكَرَ مِثْلَ حَدِيثِ  اللَّيْثِ بْنِ سَعْدٍ  .","","Al-Mu'jam al-Kabir 12989","","عبد الله بن عباس عن حنش بن عبد الله السبائي عن قيس بن الحجاج الحميري عن نافع بن يزيد الكلاعي عن محمد بن عبد الأعلى بن موسى القراطيسي عن يحيى بن أيوب العلاف عن الطبراني","حنش الصنعاني عن ابن عباس"
"13025","[  عَبْدُ الرَّحْمَنِ الْبَيْلَمَانِيُّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12990  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ بْنِ الْمِصْرِيِّ  ، ثَنَا  أَبُو صَالِحٍ الْحَرَّانِيُّ ،  ثَنَا  صَالِحُ بْنُ عَبْدِ الْجَبَّارِ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الْبَيْلَمَانِيِّ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَنْكِحُوا الْأَيَامَى  - ثَلَاثًا - عَلَى مَا تَرَاضَى بِهِ الْأَهْلُونَ ، وَلَوْ قَبْضَةً مِنْ أَرَاكٍ  .","","Al-Mu'jam al-Kabir 12990","","عبد الله بن عباس عن عبد الرحمن بن البيلماني المدني عن محمد بن عبد الرحمن ابن البيلماني الكوفي عن صالح بن عبد الجبار عن عبد الغفار بن داود الحراني عن أحمد بن محمد بن الحجاج المصري عن الطبراني","عبد الرحمن البيلماني عن ابن عباس"
"13026","12991  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ بْنُ سَعْدٍ  عَنْ  سَعِيدِ بْنِ بَشِيرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الْبَيْلَمَانِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ قَالَ حِينَ يُصْبِحُ         {      فَسُبْحَانَ اللهِ حِينَ تُمْسُونَ وَحِينَ تُصْبِحُونَ             *          وَلَهُ الْحَمْدُ فِي السَّمَاوَاتِ وَالأَرْضِ وَعَشِيًّا وَحِينَ تُظْهِرُونَ         }      الْآيَةَ كُلَّهَا أَدْرَكَ مَا فَاتَهُ فِي يَوْمِهِ  ، وَمَنْ قَالَهَا حِينَ يُمْسِي أَدْرَكَ مَا فَاتَهُ لَيْلَتَهُ  .","","Al-Mu'jam al-Kabir 12991","","عبد الله بن عباس عن عبد الرحمن بن البيلماني المدني عن محمد بن عبد الرحمن ابن البيلماني الكوفي عن سعيد بن بشير الأنصاري عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عبد الرحمن البيلماني عن ابن عباس"
"13027","[12/240]      [  عَلْقَمَةُ بْنُ وَعْلَةَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12992  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ  ، ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنِ  ابْنِ هُبَيْرَةَ ،  عَنْ  عَلْقَمَةَ بْنِ وَعْلَةَ [  عَنِ  ابْنِ عَبَّاسٍ ]  قَالَ :  سُئِلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  سَبَأٌ  مَا هُوَ ؟  أَرَجُلٌ أَوِ امْرَأَةٌ أَمْ أَرْضٌ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" رَجُلٌ وَلَدَ عَشَرَةً فَسَكَنَ  الْيَمَنَ  سِتَّةٌ ،  وَالشَّامَ  أَرْبَعَةٌ ، فَأَمَّا الْيَمَانِيُّونَ  فَمَذْحِجٌ  ،  وَكِنْدَةُ  ،  وَالْأَزْدُ  ،  وَالْأَشْعَرِيُّونَ  ،  وَأَنْمَارٌ  ،  وَحِمْيَرُ  ، وَأَمَّا الشَّامِيُّونَ ،  فَلَخْمٌ  ،  وَجُذَامُ  ،  وَعَامِلَةُ  ،  وَغَسَّانُ  .  سقط من طبعة مكتبة ابن تيمية ، والمثبت من نسخة الظاهرية (1) .","","Al-Mu'jam al-Kabir 12992","","عبد الله بن عباس عن علقمة بن وعلة عن عبد الله بن هبيرة السبئي عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن أحمد بن محمد بن الحجاج المصري عن الطبراني","علقمة بن وعلة عن ابن عباس"
"13028","[12/241]      [  مَيْمُونُ بْنُ مِهْرَانَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  12993  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  جُبَارَةُ بْنُ مُغَلِّسٍ ،  ثَنَا  الْحَجَّاجُ بْنُ تَمِيمٍ الْجَزَرِيُّ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَا أَدُلُّكُمْ عَلَى كَلِمَةٍ تُنْجِيكُمْ مِنَ الْإِشْرَاكِ بِاللهِ ؟         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      عِنْدَ مَنَامِكُمْ  .","","Al-Mu'jam al-Kabir 12993","","عبد الله بن عباس عن ميمون بن مهران الرقي عن حجاج بن تميم الجزري عن جبارة بن المغلس عن الحسين بن إسحاق التستري عن الطبراني","ميمون بن مهران عن ابن عباس"
"13029","12994  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عَلِيُّ بْنُ بَحْرٍ ،  ثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  سُفْيَانُ بْنُ حُسَيْنٍ ،  عَنِ  الْحَكَمِ بْنِ عُتَيْبَةَ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ كُلِّ ذِي مِخْلَبٍ مِنَ الطَّيْرِ  ، وَعَنْ كُلِّ ذِي نَابٍ مِنَ السَّبُعِ  .","","Al-Mu'jam al-Kabir 12994","","عبد الله بن عباس عن ميمون بن مهران الرقي عن الحكم بن عتيبة الكندي عن سفيان بن حسين المعلم عن سويد بن عبد العزيز السلمي عن علي بن بحر بن بري القطان عن الحسين بن إسحاق التستري عن الطبراني","ميمون بن مهران عن ابن عباس"
"13030","12995  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ كُلِّ ذِي نَابٍ مِنَ السَّبُعِ  ، وَعَنْ كُلِّ ذِي مِخْلَبٍ مِنَ الطَّيْرِ  .","","Al-Mu'jam al-Kabir 12995","","عبد الله بن عباس عن ميمون بن مهران الرقي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ميمون بن مهران عن ابن عباس"
"13031","12996  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ بْنِ مُكْرَمٍ  ، ثَنَا  سُلَيْمَانُ بْنُ عُبَيْدِ اللهِ الْغَيْلَانِيُّ ،  ثَنَا  أَبُو قُتَيْبَةَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ         [12/242]      مَيْمُونِ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ كُلِّ سَبُعٍ ذِي نَابٍ  .","","Al-Mu'jam al-Kabir 12996","","عبد الله بن عباس عن ميمون بن مهران الرقي عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن سلم بن قتيبة الشعيري عن سليمان بن عبيد الله الغيلاني عن محمد بن الحسين بن مكرم البارع عن الطبراني","ميمون بن مهران عن ابن عباس"
"13032","12997  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  عِمْرَانُ بْنُ زَيْدٍ ،  ثَنَا  الْحَجَّاجُ بْنُ تَمِيمٍ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يَكُونُ قَوْمٌ فِي آخِرِ الزَّمَانِ يُسَمَّوْنَ الرَّافِضَةَ يَرْفُضُونَ الْإِسْلَامَ  وَيَلْفِظُونَهُ  ، فَاقْتُلُوهُمْ فَإِنَّهُمْ مُشْرِكُونَ  .","","Al-Mu'jam al-Kabir 12997","","عبد الله بن عباس عن ميمون بن مهران الرقي عن حجاج بن تميم الجزري عن عمران بن زيد الطويل عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ميمون بن مهران عن ابن عباس"
"13033","12998  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ، وَعَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ ، قَالَا :  ثَنَا  يُوسُفُ بْنُ عَدِيٍّ ،  ثَنَا  الْحَجَّاجُ بْنُ تَمِيمٍ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كُنْتُ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَعِنْدَهُ  عَلِيٌّ  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  عَلِيُّ  سَيَكُونُ فِي أُمَّتِي قَوْمٌ يَنْتَحِلُونَ حُبَّنَا  أَهْلَ الْبَيْتِ  لَهُمْ نَبَزٌ يُسَمَّوْنَ الرَّافِضَةَ  ، فَاقْتُلُوهُمْ فَإِنَّهُمْ مُشْرِكُونَ  .","","Al-Mu'jam al-Kabir 12998","","عبد الله بن عباس عن ميمون بن مهران الرقي عن حجاج بن تميم الجزري عن يوسف بن عدي بن رزق الكوفي عن عمرو بن أبي الطاهر المصري عن الطبراني","ميمون بن مهران عن ابن عباس"
"13034","12999  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مُعَاوِيَةَ النَّيْسَابُورِيُّ ،  ثَنَا  أَبُو الْمَلِيحِ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : رُبَّمَا يَغْتَسِلُ يَوْمَ الْجُمُعَةِ وَرُبَّمَا تَرَكَهُ أَحْيَانًا  .","","Al-Mu'jam al-Kabir 12999","","عبد الله بن عباس عن ميمون بن مهران الرقي عن الحسن بن عمر الفزاري عن محمد بن معاوية بن أعين النيسابوري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ميمون بن مهران عن ابن عباس"
"13035","[12/243]      [  يَزِيدُ بْنُ الْأَصَمِّ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  13000  -  حَدَّثَنَا  جَعْفَرُ بْنُ أَحْمَدَ الشَّامِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  عُبَيْدُ بْنُ مُحَمَّدٍ ،  عَنْ  صَبَاحِ بْنِ يَحْيَى الْمُزَنِيِّ ،  عَنْ  أَبِي فَزَارَةَ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَمْ أُومَرْ بِتَشْيِيدِ الْمَسَاجِدِ  .","","Al-Mu'jam al-Kabir 13000","","عبد الله بن عباس عن يزيد بن الأصم بن عبيد البكائي عن راشد بن كيسان العبسي عن صباح بن يحيى المزني عن عبيد بن محمد المحاربي عن أبو كريب محمد بن العلاء عن جعفر بن أحمد بن سنان الواسطي عن الطبراني","يزيد بن الأصم عن ابن عباس"
"13036","13001  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  لَيْثٍ ،  عَنْ  أَبِي فَزَارَةَ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَمْ أُومَرْ بِتَشْيِيدِ الْمَسَاجِدِ  .","","Al-Mu'jam al-Kabir 13001","","عبد الله بن عباس عن يزيد بن الأصم بن عبيد البكائي عن راشد بن كيسان العبسي عن ليث بن أبي سليم عن معتمر بن سليمان عن نعيم بن حماد الخزاعي عن يوسف بن يزيد القراطيسي عن الطبراني","يزيد بن الأصم عن ابن عباس"
"13037","13002  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى بْنِ حَمَّادٍ الْبَرْبَرِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِيُّ ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  لَيْثٍ ،  عَنْ  أَبِي فَزَارَةَ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ،  عَنِ  ابْنِ عَبَّاسٍ ،  رَفَعَهُ  قَالَ :  لَمْ أُومَرْ بِتَشْيِيدِ الْمَسَاجِدِ  .","","Al-Mu'jam al-Kabir 13002","","عبد الله بن عباس عن يزيد بن الأصم بن عبيد البكائي عن راشد بن كيسان العبسي عن ليث بن أبي سليم عن سفيان الثوري عن عبد الرحمن بن محمد المحاربي عن عبد الرحمن بن صالح العتكي عن محمد بن موسى بن حماد البربري عن الطبراني","يزيد بن الأصم عن ابن عباس"
"13038","13003  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ ،  ثَنَا  أَبِي  ، ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  أَبِي فَزَارَةَ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَمْ أُومَرْ بِتَشْيِيدِ الْمَسَاجِدِ  وَلَمْ يَذْكُرْ  لَيْثًا  .","","Al-Mu'jam al-Kabir 13003","","عبد الله بن عباس عن يزيد بن الأصم بن عبيد البكائي عن راشد بن كيسان العبسي عن سفيان الثوري عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن محمد بن عبدوس السراج عن الطبراني","يزيد بن الأصم عن ابن عباس"
"13039","13004  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ  ، ثَنَا  سَعِيدُ بْنُ         [12/244]      سُلَيْمَانَ ،  عَنْ  أَبِي شِهَابٍ الْحَنَّاطِ ،  عَنْ  لَيْثٍ ،  عَنْ  أَبِي فَزَارَةَ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ثَلَاثٌ مَنْ لَمْ يَكُنْ فِيهِ وَاحِدَةٌ مِنْهُنَّ فَإِنَّ اللهَ يَغْفِرُ لَهُ  مَا سِوَى ذَلِكَ لِمَنْ يَشَاءُ : مَنْ مَاتَ لَا يُشْرِكُ بِاللهِ شَيْئًا ، وَلَمْ يَكُنْ سَاحِرًا يَتَّبِعُ السَّحَرَةَ ، وَلَمْ يَحْقِدْ عَلَى أَخِيهِ  .","","Al-Mu'jam al-Kabir 13004","","عبد الله بن عباس عن يزيد بن الأصم بن عبيد البكائي عن راشد بن كيسان العبسي عن ليث بن أبي سليم عن عبد ربه بن نافع الحناط عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","يزيد بن الأصم عن ابن عباس"
"13040","13005  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الْأَجْلَحِ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قَالَ  رَجُلٌ  لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مَا  شَاءَ  اللهُ وَشِئْتَ . قَالَ :  جَعَلْتَ لِلهِ  نِدًّا  ، بَلْ مَا شَاءَ اللهُ وَحْدَهُ  .","","Al-Mu'jam al-Kabir 13005","","عبد الله بن عباس عن يزيد بن الأصم بن عبيد البكائي عن أجلح بن عبد الله الكندي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","يزيد بن الأصم عن ابن عباس"
"13041","13006  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَجْلَحِ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : مَا  شَاءَ  اللهُ ، وَشِئْتَ ، قَالَ :  جَعَلْتَنِي عِدْلًا قُلْ مَا شَاءَ اللهُ  .","","Al-Mu'jam al-Kabir 13006","","عبد الله بن عباس عن يزيد بن الأصم بن عبيد البكائي عن أجلح بن عبد الله الكندي عن علي بن مسهر القرشي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","يزيد بن الأصم عن ابن عباس"
"13042","13007  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  جَعْفَرُ بْنُ بُرْقَانَ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ،  أَنَّ الضَّبَّ ذُكِرَ عِنْدَ عَبْدِ اللهِ بْنِ عَبَّاسٍ فَقَالَ بَعْضُ جُلَسَائِهِ : أُتِيَ بِهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمْ يُحِلَّهُ ، وَلَمْ يُحَرِّمْهُ ، فَقَالَ  ابْنُ عَبَّاسٍ  : بِئْسَمَا تَقُولُونُ إِنَّمَا جَاءَتْ أُمُّ حُفَيْدٍ بِنْتُ الْحَارِثِ تَزُورُ أُخْتَهَا مَيْمُونَةَ بِنْتَ الْحَارِثِ ، وَمَعَهَا طَعَامٌ فِيهِ لَحْمُ ضَبٍّ ، فَجَاءَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بَعْدَمَا  أَغْسَقَ  -  يَعْنِي أَظْلَمَ  - فَقَالَتْ  مَيْمُونَةُ  : يَا رَسُولَ اللهِ إِنَّهُ لَحْمُ ضَبٍّ فَأَمْسَكَ عَنْهُ فَأَمْسَكَتْ عَنْهُ         [12/245]      مَيْمُونَةُ  ، قَالَ  ابْنُ عَبَّاسٍ  : وَأَكَلَهُ مَنْ كَانَ عِنْدَهُ وَلَوْ كَانَ حَرَامًا نَهَاهُمْ عَنْهُ ، وَقَالَ :  إِنَّهُ لَيْسَ بِأَرْضِنَا ، وَنَحْنُ نَعَافُهُ  .","","Al-Mu'jam al-Kabir 13007","","عبد الله بن عباس عن يزيد بن الأصم بن عبيد البكائي عن جعفر بن برقان الكلابي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","يزيد بن الأصم عن ابن عباس"
"13043","13008  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  سُلَيْمَانُ الشَّيْبَانِيُّ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ، قَالَ :  دَعَانَا  رَجُلٌ  وَأَتَانَا بِثَلَاثَةَ عَشَرَ ضَبًّا فَلَمَّا أَصْبَحْتُ  أَتَيْتُ  ابْنَ عَبَّاسٍ فَذَكَرْتُ ذَلِكَ لَهُ فَأَكْثَرَ جُلَسَاؤُهُ فِي ذَلِكَ الْقَوْلَ حَتَّى قَالَ بَعْضُهُمْ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : "" لَا أُحِلُّهُ وَلَا أُحَرِّمُهُ "" ، فَقَالَ  ابْنُ عَبَّاسٍ  : بِئْسَمَا قُلْتُمْ إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِنَّمَا بُعِثَ مُحِلًّا وَمُحَرِّمًا ، إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ عِنْدَ  مَيْمُونَةَ  وَمَعَهُ  الْفَضْلُ بْنُ الْعَبَّاسِ  ،  وَخَالِدُ بْنُ الْوَلِيدِ  ،  وَامْرَأَةٌ  ،  وَمَيْمُونَةُ  ، فَأُتِيَ  بِخِوَانٍ  عَلَيْهِ خُبْزٌ وَلَحْمُ ضَبٍّ فَأَمْسَكَ يَدَهُ وَقَالَ :  هَذَا لَحْمٌ لَمْ آكُلْهُ ، وَلَكِنْ كُلُوا  فَأَكَلَ  خَالِدُ بْنُ الْوَلِيدِ  ،  وَالْفَضْلُ بْنُ الْعَبَّاسِ  وَالْمَرْأَةُ ، فَقَالَتْ  مَيْمُونَةُ  : لَا آكُلُ طَعَامًا لَمْ يَأْكُلْ مِنْهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمْ تَأْكُلْ  مَيْمُونَةُ  .","","Al-Mu'jam al-Kabir 13008","","عبد الله بن عباس عن يزيد بن الأصم بن عبيد البكائي عن سليمان بن فيروز الشيباني عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","يزيد بن الأصم عن ابن عباس"
"13044","13009  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ  رَجُلًا  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، أَحُجُّ عَنْ أَبِي ؟ فَقَالَ :  نَعَمْ إِنْ لَمْ تَزِدْهُ خَيْرًا لَمْ تَزِدْهُ شَرًّا  .","","Al-Mu'jam al-Kabir 13009","","عبد الله بن عباس عن يزيد بن الأصم بن عبيد البكائي عن سليمان بن فيروز الشيباني عن سفيان الثوري عن عبد الرزاق الصنعاني عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","يزيد بن الأصم عن ابن عباس"
"13045","[  شَهْرُ بْنُ حَوْشَبٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  13010  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ         [12/246]      بْنُ عَوْنٍ الْخَرَّازُ ،  ثَنَا  أَبُو عُبَيْدَةَ الْحَدَّادُ ،  ثَنَا  عَبْدُ الْجَلِيلِ بْنُ عَطِيَّةَ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْكَمْأَةُ  مِنَ  الْمَنِّ ،  وَمَاؤُهَا شِفَاءٌ لِلْعَيْنِ  .","","Al-Mu'jam al-Kabir 13010","","عبد الله بن عباس عن شهر بن حوشب عن عبد الجليل بن عطية القيسي عن عبد الواحد بن واصل عن عبد الله بن عون الهلالي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","شهر بن حوشب عن ابن عباس"
"13046","13011  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الرَّبِيعِ بْنِ شَاهِينَ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، قَالَا :  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ بَهْرَامَ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ، قَالَ :  قَالَ  ابْنُ عَبَّاسٍ :  أَيُّمَا رَجُلٍ ادَّعَى إِلَى غَيْرِ وَالِدَيْهِ أَوْ  تَوَلَّى  غَيْرَ مَوَالِيهِ الَّذِينَ أَعْتَقُوهُ فَإِنَّ عَلَيْهِ لَعْنَةَ اللهِ  وَالْمَلَائِكَةِ إِلَى يَوْمِ الْقِيَامَةِ لَا يُقْبَلُ مِنْهُ  صَرْفٌ  وَلَا عَدْلٌ  "" .","","Al-Mu'jam al-Kabir 13011","","عبد الله بن عباس عن شهر بن حوشب عن عبد الحميد بن بهرام الفزاري عن أبو الوليد الطيالسي عن محمد بن الربيع بن شاهين البصري عن الطبراني","شهر بن حوشب عن ابن عباس"
"13047","13012  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ بَهْرَامَ ،  ثَنَا  شَهْرُ بْنُ حَوْشَبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبَّاسٍ ، قَالَ :  حَضَرَتْ عِصَابَةٌ مِنَ الْيَهُودِ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا ، فَقَالُوا : يَا  أَبَا الْقَاسِمِ  حَدِّثْنَا عَنْ خِلَالٍ نَسْأَلُكَ عَنْهُنَّ لَا يَعْلَمُهُنَّ إِلَّا نَبِيٌّ . قَالَ :  سَلُونِي عَمَّا شِئْتُمْ ، وَلَكِنِ اجْعَلُوا لِي ذِمَّةَ اللهِ وَمَا أَخَذَ  يَعْقُوبُ  عَلَى بَنِيهِ لَئِنْ أَنَا حَدَّثْتُكُمْ شَيْئًا فَعَرَفْتُمُوهُ لَتُتَابِعُنِّي  ، قَالَ : فَذَلِكَ لَكَ ، قَالَ : أَرْبَعُ خِلَالٍ نَسْأَلُكَ عَنْهَا أَخْبِرْنَا : أَيُّ الطَّعَامِ حَرَّمَ  إِسْرَائِيلُ  عَلَى نَفْسِهِ مِنْ قَبْلِ أَنْ تُنَزَّلَ         [12/247]      التَّوْرَاةُ ، وَأَخْبِرْنَا كَيْفَ مَاءُ الْمَرْأَةِ مِنْ مَاءِ الرَّجُلِ ؟ وَكَيْفَ يَكُونُ الْأُنْثَى مِنْهُ وَالذَّكَرُ ؟ وَأَخْبِرْنَا كَيْفَ هَذَا النَّبِيُّ الْأُمِّيُّ فِي  الْقَوْمِ  ؟ وَمَنْ وَلِيُّهُ مِنَ الْمَلَائِكَةِ ؟ قَالَ : "" فَعَلَيْكُمْ عَهْدُ اللهِ لَئِنْ أَنَا أَخْبَرْتُكُمْ لَتُتَابِعُنِّي ، فَأَعْطَوْهُ مَا شَاءَ مِنْ عَهْدٍ وَمِيثَاقٍ ، قَالَ : فَأَنْشُدُكُمْ بِالَّذِي أَنْزَلَ التَّوْرَاةَ عَلَى  مُوسَى  ، هَلْ تَعْلَمُونَ أَنَّ  إِسْرَائِيلَ  مَرِضَ مَرَضًا شَدِيدًا فَطَالَ سَقَمُهُ فَنَذَرَ نَذْرًا ، لَئِنْ عَافَاهُ اللهُ مِنْ سَقَمِهِ لَيُحَرِّمَنَّ أَحَبَّ الشَّرَابِ إِلَيْهِ ، وَأَحَبَّ الطَّعَامِ إِلَيْهِ ، وَكَانَ أَحَبَّ الطَّعَامِ إِلَيْهِ لُحْمَانُ الْإِبِلِ ، وَأَحَبُّ الشَّرَابِ إِلَيْهِ أَلْبَانُهَا ؟ "" قَالُوا : اللَّهُمَّ نَعَمْ ، قَالَ : "" اللَّهُمَّ اشْهَدْ عَلَيْهِمْ "" ، قَالَ : ""  فَأَنْشُدُكُمْ  بِاللهِ الَّذِي لَا إِلَهَ إِلَّا هُوَ هَلْ تَعْلَمُونَ أَنَّ مَاءَ الرَّجُلِ غَلِيظٌ ، وَأَنَّ مَاءَ الْمَرْأَةِ أَصْفَرُ رَقِيقٌ فَأَيُّهُمَا عَلَا كَانَ الْوَلَدُ ، وَالشَّبَهُ بِإِذْنِ اللهِ ، إِنْ عَلَا مَاءُ الرَّجُلِ كَانَ ذَكَرًا بِإِذْنِ اللهِ ، وَإِنْ عَلَا مَاءُ الْمَرْأَةِ كَانَ أُنْثَى بِإِذْنِ اللهِ "" قَالُوا : اللَّهُمَّ نَعَمْ ، قَالَ : "" اللَّهُمَّ اشْهَدْ عَلَيْهِمْ ، قَالَ :  فَأَنْشُدُكُمْ  بِالَّذِي أَنْزَلَ التَّوْرَاةَ عَلَى  مُوسَى  هَلْ تَعْلَمُونَ أَنَّ النَّبِيَّ الْأُمِّيَّ هَذَا تَنَامَ عَيْنَاهُ وَلَا يَنَامُ قَلْبُهُ ؟ "" قَالُوا : اللَّهُمَّ نَعَمْ ، قَالَ : "" اللَّهُمَّ اشْهَدْ عَلَيْهِمْ "" ، قَالُوا : أَنْتَ الْآنَ ، فَحَدِّثْنَا مَنْ وَلِيُّكَ مِنَ الْمَلَائِكَةِ فَعِنْدَهَا نُجَامِعُكُ أَوْ نُفَارِقُكَ ، قَالَ : "" فَإِنَّ وَلِيِّي  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، وَلَمْ يَبْعَثِ اللهُ عَزَّ وَجَلَّ نَبِيًّا قَطُّ إِلَّا وَهُوَ وَلِيُّهُ "" ، قَالُوا : فَعِنْدَهَا نُفَارِقُكَ لَوْ كَانَ وَلِيُّكَ سِوَاهُ مِنَ الْمَلَائِكَةِ لَاتَّبَعْنَاكَ وَصَدَّقْنَاكَ ، قَالَ : "" فَمَا يَمْنَعُكُمْ أَنْ تُصَدِّقُوهُ ؟ "" قَالُوا : هُوَ عَدُوُّنَا فَعِنْدَ ذَلِكَ قَالَ اللهُ عَزَّ وَجَلَّ :         {      مَنْ كَانَ عَدُوًّا لِجِبْرِيلَ فَإِنَّهُ نَـزَّلَهُ عَلَى قَلْبِكَ بِإِذْنِ اللهِ مُصَدِّقًا لِمَا بَيْنَ يَدَيْهِ وَهُدًى وَبُشْرَى لِلْمُؤْمِنِينَ             *          مَنْ كَانَ عَدُوًّا لِلهِ         }      إِلَى         {      وَرَاءَ ظُهُورِهِمْ كَأَنَّهُمْ لا يَعْلَمُونَ         }      فَعِنْدَ ذَلِكَ بَاءُوا بِغَضَبٍ عَلَى غَضَبٍ  .","","Al-Mu'jam al-Kabir 13012","","عبد الله بن عباس عن شهر بن حوشب عن عبد الحميد بن بهرام الفزاري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","شهر بن حوشب عن ابن عباس"
"13048","[12/248]      13013  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ بَهْرَامَ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ، قَالَ :  قَالَ  ابْنُ عَبَّاسٍ :  نُهِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ النِّسَاءِ إِلَّا مَا كَانَ مِنَ الْمُؤْمِنَاتِ الْمُهَاجِرَاتِ  قَالَ :         {      لا يَحِلُّ لَكَ النِّسَاءُ مِنْ بَعْدُ         }      الْآيَةَ إِلَى قَوْلِهِ :         {      وَامْرَأَةً مُؤْمِنَةً إِنْ وَهَبَتْ نَفْسَهَا لِلنَّبِيِّ         }      وَحَرَّمَ كُلَّ ذَاتِ دِينٍ غَيْرِ الْإِسْلَامِ ، قَالَ         {      وَمَنْ يَكْفُرْ بِالإِيمَانِ فَقَدْ حَبِطَ عَمَلُهُ         }      الْآيَةَ :         {      يَا أَيُّهَا النَّبِيُّ إِنَّا أَحْلَلْنَا لَكَ أَزْوَاجَكَ         }      إِلَى قَوْلِهِ : الْمُؤْمِنِينَ وَحَرَّمَ مَا سِوَى ذَلِكَ مِنْ أَصْنَافِ النِّسَاءِ ، وَقَدْ نَكَحَ  طَلْحَةُ بْنُ عُبَيْدِ اللهِ  يَهُودِيَّةً ، وَنَكَحَ  حُذَيْفَةُ بْنُ الْيَمَانِ  نَصْرَانِيَّةً ، فَغَضِبَ  عُمَرُ  غَضَبًا شَدِيدًا حَتَّى هَمَّ أَنْ يَسْطُوَ عَلَيْهِمَا ، فَقَالُوا : نَحْنُ نُطَلِّقُ ، وَلَا تَغْضَبْ ، فَقَالَ  عُمَرُ  : لَئِنْ حَلَّ طَلَاقُهُنَّ لَقَدْ حَلَّ نِكَاحُهُنَّ ، وَلَكِنْ لَنَنْزِعُهُنَّ صُفْرَةً قِمَاةً  .","","Al-Mu'jam al-Kabir 13013","","عبد الله بن عباس عن شهر بن حوشب عن عبد الحميد بن بهرام الفزاري عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","شهر بن حوشب عن ابن عباس"
"13049","قَالَ  ابْنُ عَبَّاسٍ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، عَنِ الذَّبِيحَةِ أَنْ تُفْرَسَ قَبْلَ أَنْ تَمُوتَ  .","","Al-Mu'jam al-Kabir 13049","","عبد الله بن عباس عن شهر بن حوشب عن عبد الحميد بن بهرام الفزاري عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","شهر بن حوشب عن ابن عباس"
"13050","13014  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  أَبُو الْوَلِيدِ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ بَهْرَامَ ،  ثَنَا  شَهْرُ بْنُ حَوْشَبٍ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عَبَّاسٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَطَبَ امْرَأَةً مِنْ قَوْمِهِ يُقَالُ لَهَا  سَوْدَةُ  وَكَانَتْ  مُصْبِيَةً  وَكَانَتْ لَهَا  خَمْسَةُ صِبْيَةٍ أَوْ سِتَّةٌ  مِنْ  بَعْلٍ  لَهَا مَاتَ ، فَقَالَ لَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا يَمْنَعُكِ مِنِّي ؟ "" قَالَتْ : وَاللهِ يَا نَبِيَّ اللهِ مَا يَمْنَعُنِي مِنْكَ إِلَّا أَنْ تَكُونَ أَحَبَّ الْبَرِيَّةِ إِلَيَّ         [12/249]      وَلَكِنِّي أُكْرِمُكَ أَنْ تَصْغُوَ هَؤُلَاءِ الصِّبْيَةَ عِنْدَ رَأْسِكَ بُكْرَةً وَعَشِيَّةً ، قَالَ : "" أَمَا يَمْنَعُكِ مِنِّي شَيْءٌ غَيْرُ ذَلِكَ ؟ "" قَالَتْ : لَا وَاللهِ ، فَقَالَ لَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَرْحَمُكِ اللهُ إِنَّ خَيْرَ نِسَاءٍ رَكِبْنَ أَعْجَازَ الْإِبِلِ صَالِحُ نِسَاءِ  قُرَيْشٍ  أَحْنَاهُ  عَلَى وَلَدٍ فِي صِغَرِهِ ، وَأَرْعَاهُ عَلَى  بَعْلٍ  فِي ذَاتِ يَدِهِ  .","","Al-Mu'jam al-Kabir 13014","","عبد الله بن عباس عن شهر بن حوشب عن عبد الحميد بن بهرام الفزاري عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","شهر بن حوشب عن ابن عباس"
"13051","13015  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عَمْرُو بْنُ عُثْمَانَ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  حَدَّثَنِي  عُتْبَةُ بْنُ أَبِي حَكِيمٍ ،  حَدَّثَنِي  شَهْرُ بْنُ حَوْشَبٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ  شَرِبَ  الْخَمْرَ كَانَ نَجِسًا أَرْبَعِينَ يَوْمًا  ، فَإِنْ تَابَ مِنْهَا تَابَ اللهُ عَلَيْهِ ، فَإِنْ عَادَ عَادَ نَجِسًا ، فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ ، فَإِنْ عَادَ عَادَ نَجِسًا أَرْبَعِينَ يَوْمًا ، فَإِنْ تَابَ مِنْهَا تَابَ اللهُ عَلَيْهِ ، فَإِنْ رَبَعَ مِنْهَا كَانَ حَقًّا عَلَى اللهِ أَنْ يَسْقِيَهُ مِنْ  رَدْغَةِ  الْخَبَالِ  قَالُوا :  يَا  أَبَا الْعَبَّاسِ  وَمَا  رَدْغَةُ  الْخَبَالِ  ؟ قَالَ : ""  شُحُومُ  أَهْلِ النَّارِ  وَصَدِيدُهُمْ  ""  .","","Al-Mu'jam al-Kabir 13015","","عبد الله بن عباس عن شهر بن حوشب عن عتبة بن أبي حكيم عن بقية بن الوليد عن عمرو بن عثمان بن سعيد الحمصي عن عبد الله بن أحمد الجواليقي عن الطبراني","شهر بن حوشب عن ابن عباس"
"13052","13016  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  مُحَمَّدُ بْنُ طَرِيفٍ ،  ثَنَا  الْقَاسِمُ بْنُ مَالِكٍ ،  عَنْ  حَنْظَلَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَكْعَتَيْنِ قَرَأَ فِيهِمَا بِأُمِّ الْكِتَابِ لَمْ يَزِدْ عَلَيْهِمَا شَيْئًا  .","","Al-Mu'jam al-Kabir 13016","","عبد الله بن عباس عن شهر بن حوشب عن حنظلة بن عبد الله السدوسي عن القاسم بن مالك المزني عن محمد بن طريف البجلي عن محمد بن عثمان بن أبي شيبة عن الطبراني","شهر بن حوشب عن ابن عباس"
"13053","[12/250]      [  مُسْلِمُ بْنُ الْمُحْرِزِ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  13017  -  حَدَّثَنَا  أَبُو زَيْدٍ الْحَوْطِيُّ  ، ثَنَا  أَبُو الْيَمَانِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  ثَعْلَبَةَ بْنِ مُسْلِمٍ الْخَثْعَمِيِّ ،  عَنْ  مُسْلِمِ بْنِ أَبِي الْمُحْرِزِ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَمَرَ بِخَمْسٍ ، وَنَهَى عَنْ عَشْرٍ  : أَمَرَ بِفَرْقِ الرَّأْسِ ، وَالسِّوَاكِ ، وَقَصِّ الشَّارِبِ ، وَالِاسْتِنْشَاقِ ، وَالْمَضْمَضَةِ ، وَنَهَى أَنْ تُنْكَحَ الْمَرْأَةُ عَلَى عَمَّتِهَا أَوْ خَالَتِهَا ، أَوْ أَنْ يَجْتَمِعَ امْرَأَتَانِ فِي ثَوْبٍ وَاحِدٍ ، وَعَنِ  الشِّغَارِ  ، وَعَنْ بَيْعِ الْكَلْبِ ، وَمَهْرِ  الْبَغِيِّ  ، وَكَسْبِ الْحَجَّامِ ، وَجُلُودِ  السِّبَاعِ  ، وَلُبْسِ  الْقَسِّيِّ  ، وَعَنْ  عَسْبِ  الْفَحْلِ  .","","Al-Mu'jam al-Kabir 13017","","عبد الله بن عباس عن مسلم بن أبي المحرز عن ثعلبة بن مسلم الخثعمي عن إسماعيل بن عياش الأحول عن أبو اليمان الحكم بن نافع عن أحمد بن عبد الرحيم بن يزيد الحوطي عن الطبراني","مسلم بن المحرز عن ابن عباس"
"13054","[  أُمُّ عُثْمَانَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  13018  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُسْلِمُ بْنُ سَلَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ ،  عَنْ  صَفِيَّةَ بِنْتِ شَيْبَةَ ،  عَنْ  أُمِّ عُثْمَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَيْسَ عَلَى النِّسَاءِ حَلْقٌ إِنَّمَا عَلَى النِّسَاءِ التَّقْصِيرُ  .","","Al-Mu'jam al-Kabir 13018","","عبد الله بن عباس عن أم عثمان بنت سفيان عن صفية بنت شيبة الحجبية عن يعقوب بن عطاء بن أبي رباح المكي عن أبو بكر بن عياش عن مسلم بن سلام الكوفي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أم عثمان عن ابن عباس"
"13055","13019  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرٍ الصَّائِغُ  ، ثَنَا  إِبْرَاهِيمُ بْنُ حَمْزَةَ الزُّبَيْرِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ الْهَادِ ،  حَدَّثَتْنِي  هِنْدُ بِنْتُ الْحَارِثِ الْخَثْعَمِيَّةُ ، امْرَأَةُ عَبْدِ اللهِ بْنِ         [12/251]      شَدَّادٍ ،  عَنْ  أُمِّ الْفَضْلِ وَعَبْدِ اللهِ بْنِ عَبَّاسِ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ : قَامَ لَيْلَةً  بِمَكَّةَ  مِنَ اللَّيْلِ فَقَالَ : "" اللَّهُمَّ هَلْ بَلَّغْتُ "" ثَلَاثَ مِرَارٍ ، فَقَامَ  عُمَرُ بْنُ الْخَطَّابِ  وَكَانَ  أَوَّاهًا  ، فَقَالَ : اللَّهُمَّ نَعَمْ ، فَحَرَصْتَ ، وَجَهَدْتَ ، وَنَصَحْتَ اللَّهُمَّ نَعَمْ ، فَحَرَصْتَ وَجَهَدْتَ وَنَصَحْتَ ، فَأَصْبَحَ ، فَقَالَ :  لَيَظْهَرَنَّ الْإِيمَانُ حَتَّى يَرُدَّ الْكُفْرَ إِلَى مَوَاطِنِهِ وَلَيُخَاضُ الْبِحَارُ بِالْإِسْلَامِ  ، وَلَيَأْتِيَنَّ عَلَى النَّاسِ زَمَانٌ يَتَعَلَّمُونَ فِيهِ الْقُرْآنَ فَيُعَلِّمُونَهُ وَيَقْرَءُونَهُ ، ثُمَّ يَقُولُونَ قَدْ قَرَأْنَا وَعَلِمْنَا فَمَنَ ذَا الَّذِي هُوَ خَيْرٌ مِنَّا ؟ فَهَلْ فِي أُولَئِكَ مِنْ خَيْرٍ ؟ "" قَالُوا : لَا ، يَا رَسُولَ اللهِ . وَمَنْ أُولَئِكَ ؟ قَالَ : "" أُولَئِكَ مِنْكُمْ ، وَأُولَئِكَ هُمْ وَقُودُ النَّارِ  .","","Al-Mu'jam al-Kabir 13019","","عبد الله بن عباس عن هند بنت الحارث الخثعمية عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن أبي حازم المخزومي عن إبراهيم بن حمزة الزبيري عن محمد بن نصر بن منصور الصائغ عن الطبراني","هند بنت الحارث الخثعمية عن ابن عباس"
"13056","[  عَلِيُّ بْنُ أَبِي طَلْحَةَ  ، عَنِ  ابْنِ عَبَّاسٍ  ]  13020  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  عَلِيِّ بْنِ طَلْحَةَ  ،  عَنِ  ابْنِ عَبَّاسٍ  فِي قَوْلِهِ :         {      وَيَسْأَلُونَكَ عَنِ الْيَتَامَى قُلْ إِصْلاحٌ لَهُمْ خَيْرٌ         }      وَذَلِكَ قَبْلَ أَنْ يَنْزِلَ :         {      إِنَّ الَّذِينَ يَأْكُلُونَ أَمْوَالَ الْيَتَامَى ظُلْمًا إِنَّمَا يَأْكُلُونَ فِي بُطُونِهِمْ نَارًا وَسَيَصْلَوْنَ سَعِيرًا         }      كَرِهَ الْمُسْلِمُونَ مُؤَاكَلَةَ الْيَتَامَى  وَتَحَرَّجُوا  إِنْ خَالَطُوهُمْ فِي شَيْءٍ  ،  فَسَأَلُوا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      قُلْ إِصْلاحٌ لَهُمْ خَيْرٌ وَإِنْ تُخَالِطُوهُمْ فَإِخْوَانُكُمْ وَاللهُ يَعْلَمُ الْمُفْسِدَ مِنَ الْمُصْلِحِ وَلَوْ شَاءَ اللهُ لأَعْنَتَكُمْ         }      يَقُولُ : لَضَيَّقَ عَلَيْكُمْ ، وَلَكِنَّهُ وَسَّعَ وَيَسَّرَ ، فَقَالَ :         {      وَمَنْ كَانَ غَنِيًّا فَلْيَسْتَعْفِفْ وَمَنْ كَانَ فَقِيرًا فَلْيَأْكُلْ بِالْمَعْرُوفِ         }             [12/252]      يَقُولُ : يَأْكُلُ الْفَقِيرُ إِذَا وَلِيَ مَالَ الْيَتِيمِ بِقَدْرِ قِيَامِهِ عَلَى مَالِهِ وَمَنْفَعَتِهِ مَا لَمْ يُسْرِفْ  .  كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب: ( ابن أبي طلحة ) .","","Al-Mu'jam al-Kabir 13020","","عبد الله بن عباس عن علي بن أبي طلحة العباسي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","علي بن أبي طلحة عن ابن عباس"
"13057","13021  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ ،  عَنِ  ابْنِ عَبَّاسٍ  فِي قَوْلِهِ :         {      وَإِذَا كُنْتَ فِيهِمْ فَأَقَمْتَ لَهُمُ الصَّلاةَ فَلْتَقُمْ طَائِفَةٌ مِنْهُمْ مَعَكَ         }      فَهَذَا الصَّلَاةُ عِنْدَ الْخَوْفِ يَقُومُ الْإِمَامُ ، وَيَقُومُ مَعَهُ طَائِفَةٌ مِنْهُمْ  ، وَطَائِفَةٌ يَأْخُذُونَ أَسْلِحَتَهُمْ ، وَيَقِفُونَ بِإِزَاءِ الْعَدُوِّ ، فَيُصَلِّي الْإِمَامُ بِمَنْ مَعَهُ رَكْعَةً ، ثُمَّ يَجْلِسُ عَلَى هَيْئَتِهِ فَيَقُومُونَ ، فَيُصَلُّونَ لِأَنْفُسِهِمُ الرَّكْعَةَ الثَّانِيَةَ وَالْإِمَامُ جَالِسٌ ، ثُمَّ يَنْصَرِفُونَ حَتَّى يَأْتُوا أَصْحَابَهُمْ فَيَقِفُونَ مَوْقِفَهُمْ ، ثُمَّ يُقْبِلُ الْآخَرُونَ فَيُصَلِّي لَهُمُ الْإِمَامُ الرَّكْعَةَ الثَّانِيَةَ ، فَهَكَذَا صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالنَّاسِ يَوْمَ  بَطْنِ نَخْلَةَ  .","","Al-Mu'jam al-Kabir 13021","","عبد الله بن عباس عن علي بن أبي طلحة العباسي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","علي بن أبي طلحة عن ابن عباس"
"13058","13022  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ ،  عَنِ  ابْنِ عَبَّاسٍ  فِي قَوْلِهِ :         {      لَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَبْتَغُوا فَضْلا مِنْ رَبِّكُمْ         }      فَهُوَ لَا حَرَجَ عَلَيْكُمْ فِي الشِّرَى وَالْبَيْعِ قَبْلَ الْإِحْرَامِ وَبَعْدَهُ ،  فَأَمَّا الْإِحْرَامُ فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى أَنْ يَتَزَوَّجَ أَوْ يُزَوِّجَ أَوْ يَنْحَرَ حَتَّى يَفْرُغَ مِنْ إِحْرَامِهِ  .","","Al-Mu'jam al-Kabir 13022","","عبد الله بن عباس عن علي بن أبي طلحة العباسي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","علي بن أبي طلحة عن ابن عباس"
"13059","13023  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي قَوْلِهِ :         {      الَّذِينَ يَجْتَنِبُونَ كَبَائِرَ الإِثْمِ وَالْفَوَاحِشَ         }      ، قَالَ :  أَكْبَرُ         [12/253]      الْكَبَائِرِ الْإِشْرَاكُ بِاللهِ  ، لِأَنَّ اللهَ قَالَ :         {      مَنْ يُشْرِكْ بِاللهِ فَقَدْ حَرَّمَ اللهُ عَلَيْهِ الْجَنَّةَ         }      ، وَالْيَأْسُ مِنْ رَوْحِ اللهِ قَالَ اللهُ :         {      لا يَيْأَسُ مِنْ رَوْحِ اللهِ إِلا الْقَوْمُ الْكَافِرُونَ         }      ، وَالْآخِرَةُ مِنْ مَكْرِ اللهِ لِأَنَّ اللهَ عَزَّ وَجَلَّ يَقُولُ :         {      فَلا يَأْمَنُ مَكْرَ اللهِ إِلا الْقَوْمُ الْخَاسِرُونَ         }      ، وَمِنْهَا  عُقُوقُ  الْوَالِدَيْنِ لِأَنَّ اللهَ عَزَّ وَجَلَّ جَعَلَ الْعَاقَّ جَبَّارًا شَقِيًّا ، وَقَتْلُ النَّفْسِ الَّتِي حَرَّمَ اللهُ إِلَّا بِالْحَقِّ لِأَنَّ اللهَ تَبَارَكَ وَتَعَالَى يَقُولُ :         {      فَجَزَاؤُهُ جَهَنَّمُ         }      الْآيَةَ ، وَقَذْفُ الْمُحْصَنَاتِ ، لِأَنَّ اللهَ جَلَّ ذِكْرُهُ يَقُولُ :         {      لُعِنُوا فِي الدُّنْيَا وَالآخِرَةِ وَلَهُمْ عَذَابٌ عَظِيمٌ         }      ، وَأَكْلُ مَالِ الْيَتِيمِ ، لِأَنَّ اللهَ عَزَّ وَجَلَّ يَقُولُ :         {      إِنَّمَا يَأْكُلُونَ فِي بُطُونِهِمْ نَارًا وَسَيَصْلَوْنَ سَعِيرًا         }      وَالْفِرَارُ مِنَ  الزَّحْفِ  ، لِأَنَّ اللهَ تَعَالَى يَقُولُ :         {      وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ إِلا مُتَحَرِّفًا لِقِتَالٍ أَوْ مُتَحَيِّزًا إِلَى فِئَةٍ فَقَدْ بَاءَ بِغَضَبٍ مِنَ اللهِ وَمَأْوَاهُ جَهَنَّمُ وَبِئْسَ الْمَصِيرُ         }      وَأَكْلُ الرِّبَا ، لِأَنَّ اللهَ تَعَالَى يَقُولُ :         {      الَّذِينَ يَأْكُلُونَ الرِّبَا لا يَقُومُونَ إِلا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ         }      وَالسِّحْرُ ، لِأَنَّ اللهَ تَعَالَى يَقُولُ :         {      وَلَقَدْ عَلِمُوا لَمَنِ اشْتَرَاهُ مَا لَهُ فِي الآخِرَةِ مِنْ خَلاقٍ         }      وَالزِّنَا لِأَنَّ اللهَ يَقُولُ :         {      يَلْقَ أَثَامًا             *          يُضَاعَفْ لَهُ الْعَذَابُ يَوْمَ الْقِيَامَةِ وَيَخْلُدْ فِيهِ مُهَانًا         }      ، وَالْيَمِينُ  الْغَمُوسُ  الْفَاجِرَةُ ، لِأَنَّ اللهَ يَقُولُ :         {      إِنَّ الَّذِينَ يَشْتَرُونَ بِعَهْدِ اللهِ وَأَيْمَانِهِمْ ثَمَنًا قَلِيلا         }      الْآيَةَ ، وَالْغُلُولُ ، لِأَنَّ اللهَ تَعَالَى يَقُولُ :         {      وَمَنْ يَغْلُلْ يَأْتِ بِمَا غَلَّ يَوْمَ الْقِيَامَةِ         }      ، وَمَنْعُ الزَّكَاةِ الْمَفْرُوضَةِ ، لِأَنَّ اللهَ تَعَالَى قَالَ :         {      فَتُكْوَى بِهَا جِبَاهُهُمْ وَجُنُوبُهُمْ وَظُهُورُهُمْ         }      وَشَهَادَةُ  الزُّورِ  ، لِأَنَّ اللهَ عَزَّ وَجَلَّ يَقُولُ :         {      وَمَنْ يَكْتُمْهَا فَإِنَّهُ آثِمٌ قَلْبُهُ         }      وَشُرْبُ الْخَمْرِ ، لِأَنَّ اللهَ عَزَّ وَجَلَّ عَدَلَ بِهَا الْأَوْثَانَ ، وَتَرْكُ الصَّلَاةِ مُتَعَمِّدًا أَوْ شَيْئًا مِمَّا  فَرَضَ  اللهُ ، لِأَنَّ الرَّسُولَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : "" مَنْ تَرَكَ         [12/254]      الصَّلَاةَ مُتَعَمِّدًا فَقَدْ بَرِئَتْ مِنْهُ ذِمَّةُ اللهِ وَذِمَّةُ رَسُولِهِ "" وَنَقْضُ الْعَهْدِ ، وَقَطِيعَةُ الرَّحِمِ  .","","Al-Mu'jam al-Kabir 13023","","عبد الله بن عباس عن علي بن أبي طلحة العباسي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","علي بن أبي طلحة عن ابن عباس"
"13060","13024  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَقِّنُوا مَوْتَاكُمْ شَهَادَةَ أَنْ لَا إِلَهَ إِلَّا اللهُ  فَمَنْ قَالَهَا عِنْدَ مَوْتِهِ وَجَبَتْ لَهُ الْجَنَّةُ "" ، قَالُوا : يَا رَسُولَ اللهِ فَمَنْ قَالَهَا فِي صِحَّةٍ ؟ قَالَ : "" تِلْكَ أَوْجَبُ ، وَأَوْجَبُ "" ثُمَّ قَالَ : "" وَالَّذِي نَفْسِي بِيَدِهِ لَوْ جِيءَ بِالسَّمَاوَاتِ وَالْأَرَضِينَ ، وَمَنْ فِيهِنَّ وَمَا بَيْنَهُنَّ ، وَمَا تَحْتَهُنَّ فَوُضِعَتْ فِي كِفَّةِ الْمِيزَانِ وَوُضِعَتْ شَهَادَةُ أَنْ لَا إِلَهَ إِلَّا اللهُ فِي الْكِفَّةِ الْأُخْرَى لَرَجَحَتْ بِهِنَّ  .","","Al-Mu'jam al-Kabir 13024","","عبد الله بن عباس عن علي بن أبي طلحة العباسي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","علي بن أبي طلحة عن ابن عباس"
"13061","13025  -  حَدَّثَنَا  بَكْرٌ  ، ثَنَا  عَبْدُ اللهِ ،  ثَنَا  مُعَاوِيَةُ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ ،  عَنِ  ابْنِ عَبَّاسٍ :         {      فَمِنْهُمْ شَقِيٌّ وَسَعِيدٌ         }      ، وَنَحْوُ هَذَا مِنَ الْقُرْآنِ قَالَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : كَانَ يَحْرِصُ أَنْ يُؤْمِنَ جَمِيعُ النَّاسِ ، وَيُتَابِعُوهُ عَلَى الْهُدَى  ، فَأَخْبَرَهُ اللهُ أَنَّهُ لَا يُؤْمِنُ إِلَّا مَنْ سَبَقَ لَهُ مِنَ السَّعَادَةِ فِي الذِّكْرِ الْأَوَّلِ ، وَلَا يَضِلُّ إِلَّا مَنْ سَبَقَ لَهُ مِنَ الشَّقَاءِ فِي الذِّكْرِ الْأَوَّلِ ، ثُمَّ قَالَ عَزَّ وَجَلَّ لِنَبِيِّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         {      لَعَلَّكَ بَاخِعٌ نَفْسَكَ أَلا يَكُونُوا مُؤْمِنِينَ         }      ، يَقُولُ :         {      إِنْ نَشَأْ نُنَـزِّلْ عَلَيْهِمْ مِنَ السَّمَاءِ آيَةً فَظَلَّتْ أَعْنَاقُهُمْ لَهَا خَاضِعِينَ         }      "" .","","Al-Mu'jam al-Kabir 13025","","عبد الله بن عباس عن علي بن أبي طلحة العباسي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","علي بن أبي طلحة عن ابن عباس"
"13062","13026  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ ،  عَنِ  ابْنِ عَبَّاسٍ         [12/255]      فِي قَوْلِهِ :         {      قُلْ لا أَسْأَلُكُمْ عَلَيْهِ أَجْرًا إِلا الْمَوَدَّةَ فِي الْقُرْبَى         }      ، قَالَ : كَانَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَرَابَةٌ فِي جَمِيعِ  قُرَيْشٍ  ، فَلَمَّا كَذَّبُوهُ فَأَبَوْا أَنْ يُتَابِعُوهُ قَالَ :  يَا قَوْمِ ، أَرَأَيْتُمْ إِذَا أَبَيْتُمْ أَنْ تُتَابِعُونِي فَاحْفَظُوا قَرَابَتِي فِيكُمْ  ، وَلَا يَكُونُ غَيْرُكُمْ مِنَ الْعَرَبِ أَوْلَى بِحِفْظِي وَنُصْرَتِي عَنْكُمْ  .","","Al-Mu'jam al-Kabir 13026","","عبد الله بن عباس عن علي بن أبي طلحة العباسي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","علي بن أبي طلحة عن ابن عباس"
"13063","13027  -  حَدَّثَنَا  بَكْرٌ  ، ثَنَا  عَبْدُ اللهِ ،  حَدَّثَنِي  مُعَاوِيَةُ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي قَوْلِهِ :         {      الَّذِينَ إِذَا أَصَابَتْهُمْ مُصِيبَةٌ قَالُوا إِنَّا لِلهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ             *          أُولَئِكَ عَلَيْهِمْ صَلَوَاتٌ مِنْ رَبِّهِمْ وَرَحْمَةٌ وَأُولَئِكَ هُمُ الْمُهْتَدُونَ         }      ، قَالَ : أَخْبَرَنَا اللهُ عَزَّ وَجَلَّ : أَنَّ الْمُؤْمِنَ إِذَا سَلَّمَ لِأَمْرِ اللهِ وَرَجَعَ ،  فَاسْتَرْجَعَ  عِنْدَ الْمُصِيبَةِ كَتَبَ ثَلَاثَ خِصَالٍ مِنَ الْخَيْرِ : الصَّلَاةُ ، وَالرَّحْمَةُ ، وَتَحْقِيقُ سَبِيلِ الْهُدَى ، وَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنِ  اسْتَرْجَعَ  عِنْدَ الْمُصِيبَةِ جَبَرَ اللهُ مُصِيبَتَهُ  ، وَأَحْسَنَ عُقْبَاهُ ، وَجَعَلَ لَهُ خَلَفًا صَالِحًا يَرْضَاهُ  .","","Al-Mu'jam al-Kabir 13027","","عبد الله بن عباس عن علي بن أبي طلحة العباسي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","علي بن أبي طلحة عن ابن عباس"
"13064","13028  -  حَدَّثَنَا  بَكْرٌ  ثَنَا  عَبْدُ اللهِ ،  حَدَّثَنِي  مُعَاوِيَةُ ،  عَنْ  عَلِيٍّ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي قَوْلِهِ :         {      لِيَزْدَادُوا إِيمَانًا مَعَ إِيمَانِهِمْ         }      ، قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ بَعَثَ نَبِيَّهُ بِشَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ  ، فَلَمَّا صَدَّقُوا زَادَهُمُ  الْحَجَّ  ، فَلَمَّا صَدَّقُوا بِهِ زَادَهُمُ  الْجِهَادَ  ، ثُمَّ أَكْمَلَ لَهُمْ دِينَهُمْ "" ، فَقَالَ :         {      الْيَوْمَ أَكْمَلْتُ لَكُمْ دِينَكُمْ وَأَتْمَمْتُ عَلَيْكُمْ نِعْمَتِي         }      قَالَ  ابْنُ عَبَّاسٍ  : "" فَأَوْثَقُ إِيمَانِ أَهْلِ السَّمَاوَاتِ وَأَهْلِ الْأَرْضِ وَأَصْدَقُهُ وَأَكْمَلُهُ شَهَادَةُ أَنْ لَا إِلَهَ إِلَّا اللهُ  ""  .","","Al-Mu'jam al-Kabir 13028","","عبد الله بن عباس عن علي بن أبي طلحة العباسي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","علي بن أبي طلحة عن ابن عباس"
"13065","[12/256]      13029  -  حَدَّثَنَا  بَكْرٌ  ، ثَنَا  عَبْدُ اللهِ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي قَوْلِهِ :         {      وَلا تَجْهَرْ بِصَلاتِكَ وَلا تُخَافِتْ بِهَا         }      يَقُولُ :  لَا يُصَلِّي مُرَائِيًا  لِلنَّاسِ ، وَلَا يَدَعُهَا مَخَافَةَ النَّاسِ  ""  .  تصحفت في طبعة مكتبة ابن تيمية : ( مرابيا ) .","","Al-Mu'jam al-Kabir 13029","","عبد الله بن عباس عن علي بن أبي طلحة العباسي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","علي بن أبي طلحة عن ابن عباس"
"13066","13030  -  حَدَّثَنَا  بَكْرٌ  ، ثَنَا  عَبْدُ اللهِ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي قَوْلِهِ :         {      وَإِنَّهُ لَذِكْرٌ لَكَ وَلِقَوْمِكَ         }      قَالَ :  شَرَفٌ لَكَ ، وَلِقَوْمِكَ  ""  .","","Al-Mu'jam al-Kabir 13030","","عبد الله بن عباس عن علي بن أبي طلحة العباسي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","علي بن أبي طلحة عن ابن عباس"
"13067","13031  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي قَوْلِهِ :         {      وَاذْكُرُوا نِعْمَةَ اللهِ عَلَيْكُمْ وَمِيثَاقَهُ الَّذِي وَاثَقَكُمْ بِهِ إِذْ قُلْتُمْ سَمِعْنَا وَأَطَعْنَا وَاتَّقُوا اللهَ إِنَّ اللهَ عَلِيمٌ بِذَاتِ الصُّدُورِ         }      يَعْنِي حَيْثُ بَعَثَ اللهُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَنْزَلَ عَلَيْهِ الْكِتَابَ  ، قَالُوا : آمَنَّا بِالنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَبِالْكِتَابِ ، وَأَقْرَرْنَا بِمَا فِي التَّوْرَاةِ ، فَذَكَّرَهُمُ اللهُ مِيثَاقَهُ الَّذِي أَقَرُّوا بِهِ عَلَى أَنْفُسِهِمْ وَأَمَرَهُمْ بِالْوَفَاءِ بِهِ  ""  .","","Al-Mu'jam al-Kabir 13031","","عبد الله بن عباس عن علي بن أبي طلحة العباسي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","علي بن أبي طلحة عن ابن عباس"
"13068","13032  -  حَدَّثَنَا  بَكْرٌ  ، ثَنَا  عَبْدُ اللهِ ،  حَدَّثَنِي  مُعَاوِيَةُ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي قَوْلِهِ :         {      إِنَّمَا جَزَاءُ الَّذِينَ يُحَارِبُونَ اللهَ وَرَسُولَهُ وَيَسْعَوْنَ فِي الأَرْضِ فَسَادًا         }      قَالَ :  قَوْمٌ مِنْ أَهْلِ الْكِتَابِ بَيْنَهُمْ وَبَيْنَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَهْدٌ وَمِيثَاقٌ فَنَقَضُوا الْعَهْدَ  ، وَفْسَدُوا فِي الْأَرْضِ فَخَيَّرَ اللهُ نَبِيَّهُ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِنْ شَاءَ أَنْ يَقْتُلَ ، وَإِنْ شَاءَ صَلَبَ وَإِنْ شَاءَ أَنْ يَقْطَعَ أَيْدِيَهُمْ وَأَرْجُلَهُمْ         [12/257]      مِنْ خِلَافٍ ، وَأَمَّا النَّفْيُ فَهُوُ الْهَرَبُ فِي الْأَرْضِ ، فَإِنْ جَاءَ تَائِبًا فَدَخَلَ فِي الْإِسْلَامِ قُبِلَ مِنْهُ وَلَمْ يُؤْخَذْ بِمَا سَلَفَ مِنْهُ  ""  .","","Al-Mu'jam al-Kabir 13032","","عبد الله بن عباس عن علي بن أبي طلحة العباسي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","علي بن أبي طلحة عن ابن عباس"
"13069","13033  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي قَوْلِهِ :         {      إِنْ أُوتِيتُمْ هَذَا فَخُذُوهُ وَإِنْ لَمْ تُؤْتَوْهُ فَاحْذَرُوا         }      ، هُمُ الْيَهُودُ زَنَتْ مِنْهُمُ امْرَأَةٌ وَقَدْ كَانَ اللهُ عَزَّ وَجَلَّ حَكَمَ فِي التَّوْرَاةِ : فِي الزِّنَا الرَّجْمُ فَنَفَسُوا أَنْ يَرْجُمُوهُمَا ، وَقَالُوا : انْطَلِقُوا إِلَى  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَعَسَى أَنْ يَكُونَ عِنْدَهُ رُخْصَةٌ فَاقْبَلُوهَا فَأَتَوْهُ ، فَقَالُوا :  يَا  أَبَا الْقَاسِمِ  إِنَّ امْرَأَةً مِنَّا زَنَتْ فَمَا تَقُولُ فِيهَا ؟ فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" كَيْفَ حَكَمَ اللهُ فِي التَّوْرَاةِ فِي الزِّنَى ؟  فَقَالُوا : دَعْنَا مِنَ التَّوْرَاةِ فَمَا عِنْدَكَ فِي ذَلِكَ ؟ فَقَالَ : "" ائْتُونِي بِأَعْلَمِكُمْ بِالتَّوْرَاةِ الَّتِي أُنْزِلَتْ عَلَى  مُوسَى  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ لَهُمْ بِالَّذِي نَجَّاكُمْ مِنْ  آلِ فِرْعَوْنَ  وَبِالَّذِي فَلَقَ الْبَحْرَ فَأَنْجَاكُمْ ، وَأَغْرَقَ  آلَ فِرْعَوْنَ  إِلَّا أَخْبَرْتُمُونِي مَا حَكَمَ اللهُ فِي التَّوْرَاةِ فِي الزِّنَى ؟ "" فَقَالُوا : حَكَمَ بِالرَّجْمِ  .","","Al-Mu'jam al-Kabir 13033","","عبد الله بن عباس عن علي بن أبي طلحة العباسي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","علي بن أبي طلحة عن ابن عباس"
"13070","774 -  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ الْخَطَّابِ  رَضِيَ اللهُ عَنْهُمَا  ذِكْرُ سِنِّهِ وَوَفَاتِهِ  13034  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ، قَالَ :  تُوُفِّيَ عَبْدُ اللهِ بْنُ عُمَرَ يُكَنَّى  أَبَا عَبْدِ الرَّحْمَنِ  بِمَكَّةَ  بَعْدَ  الْحَجِّ  وَدُفِنَ  بِالْمُحَصَّبِ  وَبَعْضُ النَّاسِ يَقُولُونُ  بِفَخٍّ         [12/258]      وَسِنُّهُ ، حِينَ أَجَازَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ الْخَنْدَقِ  فِي الْقِتَالِ هُوَ ابْنُ خَمْسَ عَشْرَةَ سَنَةً ، وَكَانَ  الْخَنْدَقُ  فِي شَوَّالٍ مِنْ سَنَةِ أَرْبَعٍ  فَسِنُّهُ  يَوْمَ تُوُفِّيَ أَرْبَعٌ وَثَمَانُونَ  ""  .","","Al-Mu'jam al-Kabir 13034","","عبد الله بن عمر بن الخطاب عن يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","ذكر سنه ووفاته"
"13071","13035  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ نَافِعٍ الطَّحَّانُ الْمِصْرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  عَنْ  مَالِكِ بْنِ أَنَسٍ ، قَالَ :  أَقَامَ ابْنُ عُمَرَ بَعْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سِتِّينَ سَنَةً  يَقْدَمُ عَلَيْهِ وُفُودُ النَّاسِ  ""  .","","Al-Mu'jam al-Kabir 13035","","عبد الله بن عمر بن الخطاب عن مالك بن أنس عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن نافع الطحاوي عن الطبراني","ذكر سنه ووفاته"
"13072","13036  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ الْمِصْرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  عَنْ  مَالِكِ بْنِ أَنَسٍ ، قَالَ :  أَقَامَ ابْنُ عُمَرَ بَعْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سِتِّينَ سَنَةً  يَقْدَمُ عَلَيْهِ وُفُودُ النَّاسِ  ""  .","","Al-Mu'jam al-Kabir 13036","","عبد الله بن عمر بن الخطاب عن مالك بن أنس عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن عمرو بن أبي الطاهر المصري عن الطبراني","ذكر سنه ووفاته"
"13073","13037  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ الْمِصْرِيُّ  ، ثَنَا  أَبُو زَيْدِ بْنُ أَبِي الْغِمْرِ ، وَاسْمُهُ عَبْدُ الرَّحْمَنِ  ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ  ، عَنْ  مَالِكِ بْنِ أَنَسٍ  ، قَالَ : ""  سِنُّ  ابْنِ عُمَرَ  يَوْمَ مَاتَ أَرْبَعٌ وَثَمَانُونَ  ""  .","","Al-Mu'jam al-Kabir 13037","","","ذكر سنه ووفاته"
"13074","13038  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْمَدِينِيِّ فُسْتُقَةُ  ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ  ،  عَنِ  الْوَاقِدِيِّ  قَالَ : ""  مَاتَ  عَبْدُ اللهِ بْنُ عُمَرَ  سَنَةَ أَرْبَعٍ وَسَبْعِينَ  ، وَدُفِنَ  بِفَخٍّ  وَهُوَ ابْنُ أَرْبَعٍ وَثَمَانِينَ سَنَةً  ""  .","","Al-Mu'jam al-Kabir 13038","","","ذكر سنه ووفاته"
"13075","13039  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  فُضَيْلُ بْنُ مَرْزُوقٍ ،  عَنْ  عَطِيَّةَ ، قَالَ :  قُلْتُ  لِمَوْلًى لِابْنِ عُمَرَ كَيْفَ كَانَ مَوْتُ ابْنِ عُمَرَ ؟ قَالَ : "" أَصَابَهُ زَجُّ  رَجُلٍ  مِنْ  أَهْلِ الشَّامِ  فِي رِجْلِهِ فَدَخَلَ عَلَيْهِ         [12/259]      الْحَجَّاجُ  يَعُودُهُ  فَقَالَ  : لَوْ أَعْلَمُ الَّذِي أَصَابَكَ لَضَرَبْتُ عُنُقَهُ ، قَالَ :  أَنْتَ الَّذِي أَصَبْتَنِي ، قَالَ : كَيْفَ ؟ قَالَ : يَوْمَ أَدْخَلْتَ حَرَمَ اللهِ السِّلَاحَ  ""  .  تصحفت في طبعة مكتبة ابن تيمية : ( رح ) .  تصحفت في طبعة مكتبة ابن تيمية : ( رحل ) .","","Al-Mu'jam al-Kabir 13039","","عبد الله بن عمر بن الخطاب عن مولى لابن عمر عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر سنه ووفاته"
"13076","13040  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ  ، ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي سُوَيْدٍ الزَّارِعُ  ،  ثَنَا  عُمَارَةُ بْنُ زَاذَانَ ،  حَدَّثَنِي  مَكْحُولٌ ،  قَالَ  :  بَيْنَمَا أَنَا مَعَ ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ وَهُوَ يَمْشِي إِذْ مَرَّ بِهِ رَجُلٌ أَسْوَدُ مَعَهُ رُمْحٌ فَوَضَعَ زَجُّ  الرُّمْحِ بَيْنَ السَّبَّابَةِ وَالْإِبْهَامِ مِنْ قَدَمِ  ابْنِ عُمَرَ  فَحُمِلَ الشَّيْخُ فَأُدْخِلَ  فَوَرِمَتْ  سَاقُهُ ، فَأَتَاهُ  الْحَجَّاجُ  يَعُودُهُ ، فَقَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  مَنْ أَصَابَكَ بِهَذَا حَتَّى آخُذَ لَكَ مِنْهُ ؟ فَقَالَ : "" آللهِ لَتَأْخُذَنَّ مِنْهُ ؟ "" قَالَ : آللهِ لَآخُذَنَّ لَكَ مِنْهُ ، قَالَ :  مَا بَالُ حَرَمِ اللهِ وَأَمْنِهِ يُحْمَلُ فِيهِ السِّلَاحُ ؟  قَالَ : فَمَاتَ فِيهِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب (الذارع) .  تصحفت في طبعة مكتبة ابن تيمية : ( رح ) .]","","Al-Mu'jam al-Kabir 13040","","عبد الله بن عمر بن الخطاب عن مكحول العتكي عن عمارة بن زاذان الصيدلاني عن إبراهيم بن الفضل بن أبي سويد الذارع عن الفضل بن الحباب الجمحي عن الطبراني","ذكر سنه ووفاته"
"13077","13041  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : ""  جَاءَ بِي أَبِي  يَوْمَ أُحُدٍ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَنَا ابْنُ أَرْبَعَ عَشْرَةَ فَلَمْ يُجِزْنِي النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، ثُمَّ جَاءَ بِي  يَوْمَ الْخَنْدَقِ  وَأَنَا ابْنُ خَمْسَ عَشْرَةَ  فَفَرَضَ  لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" قَالَ  نَافِعٌ  : "" فَحَدَّثَ بِهِ  عُمَرَ بْنَ عَبْدِ الْعَزِيزِ  فَأَمَرَ بِأَنْ لَا يُفْرَضَ إِلَّا لِابْنِ خَمْسَ عَشْرَةَ  ""  .","","Al-Mu'jam al-Kabir 13041","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","ذكر سنه ووفاته"
"13078","13042  -  حَدَّثَنَا  إِسْحَاقُ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،         [12/260]      أَخْبَرَنِي  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  عُرِضْتُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا ابْنُ أَرْبَعَ عَشْرَةَ سَنَةً  ثُمَّ ذَكَرَ نَحْوَ حَدِيثِ  عَبْدِ اللهِ بْنِ عُمَرَ  إِلَّا أَنَّهُ قَالَ :  وَكَانَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ لَا يَفْرِضُ لِأَحَدٍ حَتَّى يَبْلُغَ الْحُلُمَ إِلَّا مِائَةَ دِرْهَمٍ  ، وَكَانَ لَا يَفْرِضُ لِمَوْلُودٍ حَتَّى يُفْطَمَ ، فَبَيْنَا هُوَ يَطُوفُ ذَاتَ لَيْلَةٍ بِالْمُصَلَّى بَكَى صَبِيٌّ ، فَقَالَ لِأُمِّهِ : أَرْضِعِيهِ ، فَقَالَتْ : إِنَّ أَمِيرَ الْمُؤْمِنِينَ لَا يَفْرِضُ لِمَوْلُودٍ حَتَّى يُفْطَمَ وَإِنِّي قَدْ فَطَمْتُهُ ، فَقَالَ  عُمَرُ  : "" إِنْ كِدْتُ لَأَقْتُلُهُ أَرْضِعِيهِ فَإِنَّ أَمِيرَ الْمُؤْمِنِينَ سَوْفَ يَفْرِضُ لَهُ ، ثُمَّ  فَرَضَ  بَعْدَ ذَلِكَ لِلْمَوْلُودِ حِينَ يُولَدُ  ""  .","","Al-Mu'jam al-Kabir 13042","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","ذكر سنه ووفاته"
"13079","13043  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنِ  ابْنِ جَابِرٍ ،  حَدَّثَنِي  سُلَيْمَانُ بْنُ مُوسَى ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ :  أَنَّهُ كَانَ يُحْيِي اللَّيْلَ صَلَاةً  ، ثُمَّ يَقُولُ : "" يَا  نَافِعُ  أَسْحَرْنَا ؟ "" فَيَقُولُ : لَا ، "" فَيُعَاوِدُ الصَّلَاةَ "" ، ثُمَّ يَقُولُ : "" يَا  نَافِعُ  أَسْحَرْنَا ؟ "" فَأَقُولُ : نَعَمْ "" فَيَقْعُدُ فَيَسْتَغْفِرُ وَيَدْعُو حَتَّى يُصْبِحَ  ""  .","","Al-Mu'jam al-Kabir 13043","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن سليمان بن موسى الأشدق عن عبد الرحمن بن يزيد الداراني عن الوليد بن مسلم القرشي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","ذكر سنه ووفاته"
"13080","13044  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرٍ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ حَمْزَةَ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  مَا شَبِعْتُ مُنْذُ أَسْلَمْتُ  ""  .","","Al-Mu'jam al-Kabir 13044","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن محمد بن نصر بن منصور الصائغ عن الطبراني","ذكر سنه ووفاته"
"13081","13045  -  حَدَّثَنَا  مُحَمَّدُ بْنُ السَّرِيِّ بْنِ مِهْرَانَ النَّاقِدُ  ، ثَنَا  الْحَكَمُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  عَنْ  بُرْدِ بْنِ سِنَانٍ ،  عَنْ  نَافِعٍ ، قَالَ :         [12/261]      إِنْ كَانَ ابْنُ عُمَرَ لَيُقْسِمُ فِي الْمَجْلِسِ الْوَاحِدِ ثَلَاثِينَ أَلْفًا  مَا يَأْتِي عَلَيْهِ شَهْرٌ مَا يَأْكُلُ فِيهِ مُرْغَةً مِنْ لَحْمٍ "" قَالَ  بُرْدٌ  : قُلْتُ  لِنَافِعٍ  : هَلْ كَانَ يَأْكُلُ اللَّحْمَ ؟ قَالَ : "" كَانَ إِذَا صَامَ أَوْ سَافَرَ فَإِنَّهُ أَكْثَرُ طَعَامِهِ  ""  .","","Al-Mu'jam al-Kabir 13045","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن برد بن سنان عن يحيى بن حمزة بن البتلهي عن الحكم بن موسى بن أبي زهير النسائي عن محمد بن السري بن مهران الناقد عن الطبراني","ذكر سنه ووفاته"
"13082","13046  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلُّوَيْهِ الْقَطَّانُ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عِيسَى الْعَطَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ حِمْيَرَ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَيَّاشٍ ،  عَنْ  جَعْفَرِ بْنِ الْحَارِثِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ، قَالَ :  جَاءَ رَجُلٌ إِلَى ابْنِ عُمَرَ فَقَالَ : مَا يَمْنَعُكَ مِنْ هَذَا الْأَمْرِ وَأَنْتَ صَاحِبُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَابْنُ أَمِيرِ الْمُؤْمِنِينَ ؟  فَقَالَ  :  مَا يَمْنَعُنِي مِنْهِ أَنَّ اللهَ عَزَّ وَجَلَّ حَرَّمَ عَلَيَّ دَمَ أَخِي الْمُسْلِمِ  ، قَالَ : فَإِنَّ اللهَ عَزَّ وَجَلَّ يَقُولُ :         {      وَقَاتِلُوهُمْ حَتَّى لا تَكُونَ فِتْنَةٌ وَيَكُونَ الدِّينُ كُلُّهُ لِلهِ         }      قَالَ : فَقَالَ  ابْنُ عُمَرَ  : "" فَقَدْ قَاتَلْنَاهُمْ حَتَّى لَمْ تَكُنْ فِتْنَةٌ وَكَانَ الدِّينُ كُلُّهُ لِلهِ ، وَأَنْتُمْ تُرِيدُونَ أَنْ أُقَاتِلَ حَتَّى تَكُونَ فِتْنَةٌ ، وَيَكُونَ الدِّينُ لِغَيْرِ اللهِ  ""  .","","Al-Mu'jam al-Kabir 13046","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن جعفر بن الحارث الواسطي عن إسماعيل بن عياش الأحول عن محمد بن حمير القضاعي عن إسماعيل بن عيسى البغدادي عن ابن علويه الحسن بن علي القطان عن الطبراني","ذكر سنه ووفاته"
"13083","13047  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى بْنِ حَمَّادٍ الْبَرْبَرِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  لَيْثٍ ،  عَنْ  نَافِعٍ ، قَالَ :  لَمَّا قُتِلَ  عُثْمَانُ  جَاءَ  عَلِيٌّ  إِلَى ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، فَقَالَ : إِنَّكَ مَحْبُوبٌ فِي النَّاسِ فَسِرْ إِلَى  الشَّامِ  ، فَقَالَ  ابْنُ عُمَرَ  :  بِقَرَابَتِي ، وَصُحْبَتِي النَّبِيَّ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَالرَّحِمِ الَّتِي بَيْنَنَا فَلَمْ يُعَاوِدْهُ  ""  .","","Al-Mu'jam al-Kabir 13047","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن ليث بن أبي سليم عن عبد الله بن إدريس الأودي عن عبد الرحمن بن صالح العتكي عن محمد بن موسى بن حماد البربري عن الطبراني","ذكر سنه ووفاته"
"13084","13048  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  الْحَكَمُ بْنُ         [12/262]      مُوسَى ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  حَدَّثَنِي  الْمُطْعِمُ بْنُ الْمِقْدَامِ الصَّنْعَانِيُّ ، قَالَ :  كَتَبَ  الْحَجَّاجُ بْنُ يُوسُفَ  إِلَى عَبْدِ اللهِ بْنِ عُمَرَ بَلَغَنِي أَنَّكَ طَلَبْتَ الْخِلَافَةَ ، وَإِنَّ الْخِلَافَةَ لَا تَصْلُحُ لِعَيِيٍّ ، وَلَا بَخِيلٍ ، وَلَا  غَيُورٍ  ،  فَكَتَبَ إِلَيْهِ  ابْنُ عُمَرَ  :  أَمَّا مَا ذَكَرْتَ مِنَ الْخِلَافَةِ أَنِّي طَلَبْتُهَا فَمَا طَلَبْتُهَا ، وَمَا هِيَ مِنْ بَالِي  ، وَأَمَّا مَا ذَكَرْتَ مِنَ الْعِيِّ ، وَالْبُخْلِ ، وَالْغَيْرَةِ ، فَإِنَّ مَنْ جَمَعَ كِتَابَ اللهِ فَلَيْسَ بِعَيِيٍّ ، وَمَنْ أَدَّى زَكَاةَ مَالِهِ فَلَيْسَ بِبَخِيلٍ ، وَأَمَّا مَا ذَكَرْتَ مِنَ الْغَيْرَةِ فَإِنَّ أَحَقَّ مَا غِرْتُ فِيهِ وَلَدِي أَنْ يُشْرِكَنِي فِيهِ غَيْرِي  ""  .","","Al-Mu'jam al-Kabir 13048","","عبد الله بن عمر بن الخطاب عن مطعم بن المقدام الصنعاني عن إسماعيل بن عياش الأحول عن الحكم بن موسى بن أبي زهير النسائي عن عبد الله بن أحمد بن حنبل عن الطبراني","ذكر سنه ووفاته"
"13085","13049  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ حَنَشٍ ،  قَالَ  :  رَأَيْتُ عَلَى عَبْدِ اللهِ بْنِ عُمَرَ ثَوْبَيْنِ مَعَافِرَيَّيْنِ ، وَكَانَ ثَوْبُهُ إِلَى نِصْفِ السَّاقِ  ""  .","","Al-Mu'jam al-Kabir 13049","","عبد الله بن عمر بن الخطاب عن عبد الله بن حنش الأودي عن الوضاح بن عبد الله اليشكري عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر سنه ووفاته"
"13086","13050  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ :  أَنَّ  ابْنَ عُمَرَ أُهْدِيَ لَهُ مَطَارِفُ خَزٍّ فِيهَا مُطْرَفٌ أَحْمَرُ فَقَسَمَهَا بَيْنَ بَنِيهِ  "" .","","Al-Mu'jam al-Kabir 13050","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن أيوب السختياني عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر سنه ووفاته"
"13087","13051  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يُونُسُ بْنُ أَبِي يَعْفُورٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ ، وَسَأَلَهُ رَجُلٌ : مَا أَلْبَسُ مِنَ الثِّيَابِ ؟ قَالَ : مَا لَا  يَزْدَرِيكَ  فِيهِ السُّفَهَاءُ وَلَا يَعِيبُكَ بِهِ الْحُكَمَاءُ  ، قَالَ : مَا هُوَ ؟ قَالَ : "" مَا بَيْنَ الْخَمْسَةِ دَرَاهِمَ إِلَى الْعِشْرِينَ دِرْهَمًا  ""  .","","Al-Mu'jam al-Kabir 13051","","عبد الله بن عمر بن الخطاب عن وقدان العبدي أبو يعفور عن يونس بن أبي يعفور العبدي عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر سنه ووفاته"
"13088","13052  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  سَمِعَ  مُجَاهِدًا  يُحَدِّثُ عَنِ  ابْنِ عُمَرَ  أَنَّهُ كَانَ إِذَا أَرَادَ         [12/263]      أَنْ يَصْحَبَهُ رَجُلٌ فِي سَفَرٍ اشْتَرَطَ عَلَيْهِ أَنْ لَا يَصْحَبَهُ عَلَى بَعِيرٍ  جَلَّالٍ  ، وَلَا تُنَازِعُنَا الْأَذَانَ ، وَلَا تَصُومَنَّ إِلَّا بِإِذْنِنَا  "" .","","Al-Mu'jam al-Kabir 13052","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن خالد الحذاء عن حماد بن زيد عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","ذكر سنه ووفاته"
"13089","13053  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ، قَالَ :  قَالَ  نَافِعٌ :  كَانَ رَجُلٌ يَصْحَبُ ابْنَ عُمَرَ فِي السَّفَرِ : "" فَأَمَرَنَا أَنْ نُوقِظَهُ ، وَأَنْ نُهِيِّئَ لَهُ سَحُورَهُ  ""  .","","Al-Mu'jam al-Kabir 13053","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن خالد الحذاء عن حماد بن زيد عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","ذكر سنه ووفاته"
"13090","13054  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرٍ الصَّائِغُ  ، ثَنَا  أَبُو مُصْعَبٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْحَارِثِ الْجُمَحِيُّ ،  ثَنَا  زَيْدُ بْنُ أَسْلَمَ ، قَالَ :  مَرَّ ابْنُ عُمَرَ بِرَاعِي غَنَمٍ فَقَالَ : يَا رَاعِيَ الْغَنَمِ هَلْ مِنْ  جَزْرَةٍ  ، قَالَ الرَّاعِي : لَيْسَ هَهُنَا رَبُّهَا ، فَقَالَ  ابْنُ عُمَرَ  : تَقُولُ : "" أَكَلَهَا الذِّئْبُ "" فَرَفَعَ الرَّاعِي رَأْسَهُ إِلَى السَّمَاءِ ، ثُمَّ قَالَ : فَأَيْنَ اللهُ ؟ فَاشْتَرَى  ابْنُ عُمَرَ  الرَّاعِي وَاشْتَرَى الْغَنَمَ فَأَعْتَقَهُ ، وَأَعْطَاهُ الْغَنَمَ  ""  .","","Al-Mu'jam al-Kabir 13054","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن عبد الله بن الحارث بن محمد بن عمر الحاطبي عن أحمد بن أبي بكر العوفى عن محمد بن نصر بن منصور الصائغ عن الطبراني","ذكر سنه ووفاته"
"13091","13055  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  ثَنَا  خَالِدٌ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  كَانَ عَبْدُ اللهِ بْنُ عُمَرَ إِذَا لَقِيَ  عَبْدَ اللهِ بْنَ جَعْفَرٍ  قَالَ : "" السَّلَامُ عَلَيْكَ يَا ابْنَ ذِي الْجَنَاحَيْنِ  ""  .","","Al-Mu'jam al-Kabir 13055","","عبد الله بن عمر بن الخطاب عن الشعبي عن إسماعيل بن أبي خالد عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن عبد الله بن أحمد الجواليقي عن الطبراني","ذكر سنه ووفاته"
"13092","13056  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  ثَنَا  أَيُّوبُ ،  عَنْ  مُحَمَّدٍ  أَنَّ  ابْنَ عُمَرَ سُئِلَ عَنِ الْمِسْكِ ، فَقَالَ : "" أَوَلَيْسَ أَطْيَبَ طِيبِكُمْ ؟  ""  .","","Al-Mu'jam al-Kabir 13056","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن أيوب السختياني عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر سنه ووفاته"
"13093","13057  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،         [12/264]      ثَنَا  أَيُّوبُ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  أَنَّ  ابْنَ عُمَرَ رَأَى رَجُلًا يَدْعُو بِأُصْبَعَيْهِ فَقَبَضَ بِإِحْدَى أُصْبَعَيْهِ ، وَقَالَ :         {      إِنَّمَا اللهُ إِلَهٌ وَاحِدٌ         }      ""  .","","Al-Mu'jam al-Kabir 13057","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن أيوب السختياني عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر سنه ووفاته"
"13094","13058  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  غَيْلَانَ بْنِ جَرِيرٍ ،  عَنْ  أَبِي مِجْلَزٍ ، قَالَ :  كُنْتُ  أَسْأَلُ  ابْنَ عُمَرَ عِنْدَ  الْبَيْتِ  عَنِ  الْوِتْرِ  ، فَجَعَلَ يَقُولُ : "" آخِرَ اللَّيْلِ  ، فَقُلْتُ : أَرَأَيْتَ أَرَأَيْتَ ؟ فَقَالَ : "" اجْعَلْ أَرَأَيْتَ عِنْدَ ذَاكَ الْكَوْكَبِ ، وَأَشَارَ إِلَى السَّمَاءِ ، صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى ،  وَالْوِتْرُ  رَكْعَةٌ مِنْ آخِرِ اللَّيْلِ  ""  .","","Al-Mu'jam al-Kabir 13058","","عبد الله بن عمر بن الخطاب عن لاحق بن حميد عن غيلان بن جرير المعولي عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر سنه ووفاته"
"13095","13059  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  يَحْيَى الْبَكَّاءِ ، قَالَ :  قَالَ رَجُلٌ لِابْنِ عُمَرَ : إِنِّي لَأُحِبُّكَ فِي اللهِ ، فَقَالَ  ابْنُ عُمَرَ  : لَكِنِّي أَبْغَضُكَ فِي اللهِ  ، قَالَ : وَلِمَ ؟ فَقَالَ : "" إِنَّكَ  تُنْقِي  فِي أَذَانِكَ ، وَتَأْخُذُ عَلَيْهِ أَجْرًا  ""  .","","Al-Mu'jam al-Kabir 13059","","عبد الله بن عمر بن الخطاب عن يحيى بن مسلم الحداني عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر سنه ووفاته"
"13096","13060  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  يَحْيَى الْبَكَّاءِ ، قَالَ :  رَأَى ابْنُ عُمَرَ قَاصًّا يَقُصُّ فِي  الْمَسْجِدِ الْحَرَامِ  ، وَمَعَهُ ابْنٌ لَهُ ، فَقَالَ لَهُ ابْنُهُ : أَيُّ شَيْءٍ يَقُولُ هَذَا ؟ قَالَ : "" هَذَا يَقُولُ : اعْرِفُونِي اعْرِفُونِي  "" .","","Al-Mu'jam al-Kabir 13060","","عبد الله بن عمر بن الخطاب عن يحيى بن مسلم الحداني عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر سنه ووفاته"
"13097","13061  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  ثَنَا  زِيَادُ بْنُ مِخْرَاقٍ ،  ثَنَا  حَمَّادٌ حِفْظِي ،  عَنْ  طَيْلَسَةَ بْنِ عَلِيٍّ ،  عَنِ         [12/265]      ابْنِ عُمَرَ ، قَالَ :  مَا تَعَاطَى النَّاسُ بَيْنَهُمْ شَيْئًا قَطُّ أَفْضَلَ مِنَ الطَّرْقِ  يَطْرُقُ  الرَّجُلُ فَرَسَهُ  فَيُجْرِي لَهُ أَجْرَهُ ، وَيَطْرُقُ الرَّجُلُ فَحْلَهُ فَيُجْرِي لَهُ أَجْرَهُ ، وَيَطْرُقُ الرَّجُلُ كَبْشَهُ فَيُجْرِي لَهُ أَجْرَهُ  "" .","","Al-Mu'jam al-Kabir 13061","","عبد الله بن عمر بن الخطاب عن طيسلة بن مياس الهذلي عن حماد حفظي عن زياد بن مخراق المزني عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر سنه ووفاته"
"13098","13062  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنِ  الْأَزْرَقِ بْنِ قَيْسٍ ، قَالَ :  كُنْتُ جَالِسًا إِلَى ابْنِ عُمَرَ ، فَسَأَلَهُ رَجُلٌ ، فَقَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  إِنِّي أَحْرَمْتُ ، وَقَدْ جَمَعْتُ شَعَرِي ، فَقَالَ : ""  أَمَا سَمِعْتَ  عُمَرَ فِي خِلَافَتِهِ قَالَ :  مَنْ  ضَفَرَ  رَأْسَهُ أَوْ  لَبَّدَهُ  فَلْيَحْلِقْ  ؟ "" قَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  إِنِّي لَمْ أُضَفِّرْهُ ، وَلَكِنِّي جَمَعْتُهُ ، فَقَالَ  ابْنُ عُمَرَ  : "" عَنْزٌ وَتَيْسٌ ، وَتَيْسُ عَنْزٍ  "" .","","Al-Mu'jam al-Kabir 13062","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن أزرق بن قيس الحارثي عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر سنه ووفاته"
"13099","13063  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  كَثِيرِ بْنِ زَيْدٍ [  عَنْ  سَالِمِ ]  ،  عَنْ  أَبِيهِ  ، قَالَ :  لَيْسَ الْمُؤْمِنُ  بِطَعَّانٍ  ، وَلَا لَعَّانٍ  "" قَالَ : ""  وَمَا سَمِعْتُ ابْنَ عُمَرَ يَلْعَنُ أَحَدًا قَطُّ  إِلَّا رَجُلًا وَاحِدًا  "" .  سقط من طبعة مكتبة ابن تيمية ، والمثبت من نسخة الظاهرية (1)","","Al-Mu'jam al-Kabir 13063","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن كثير بن زيد السهمي عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر سنه ووفاته"
"13100","13064  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  مُحَمَّدٍ ، قَالَ :  كَانَ الثُّومُ يُدَاسُ لِابْنِ عُمَرَ فَيُنْظَمُ فِي خَيْطٍ  ، يُلْقَى فِي الْمَرَقَةِ فِي خَيْطٍ ، وَيُسْتَخْرَجُ فِي خَيْطٍ فَيُلْقَى فَيَأْكُلُ  "" .","","Al-Mu'jam al-Kabir 13064","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن الفضل بن الحباب الجمحي عن الطبراني","ذكر سنه ووفاته"
"13101","13065  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  مُحَمَّدٍ ، قَالَ :  قَالَ  ابْنُ عُمَرَ :  إِنَّ أَفْضَلَ الطَّعَامِ الَّذِي يُنَقَّى مِنَ الْأَضْرَاسِ  يُوهِنُ الْأَضْرَاسَ  "" .","","Al-Mu'jam al-Kabir 13065","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن الفضل بن الحباب الجمحي عن الطبراني","ذكر سنه ووفاته"
"13102","[12/266]      13066  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  أَبُو عَاصِمٍ ،  عَنْ  قُرَّةَ ، قَالَ :  قُلْتُ  لِابْنِ سِيرِينَ : هَلْ كَانُوا يُمَازِحُونَ ؟  قَالَ  : مَا كَانُوا إِلَّا كَالنَّاسِ كَانَ ابْنُ عُمَرَ يَمْزَحُ وَيُنْشِدُ الشِّعْرَ وَيَقُولُ :","","Al-Mu'jam al-Kabir 13066","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن قرة بن خالد السدوسي عن أبو عاصم النبيل عن الحسن بن علي الريحاني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر سنه ووفاته"
"13103","13067  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدِ بْنِ زَيْدِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ  أَنَّ  ابْنَ عُمَرَ ، اشْتَكَى فَاشْتُرِيَ لَهُ عُنْقُودُ عِنَبٍ بِدِرْهَمٍ  ، فَجَاءَ مِسْكِينٌ ، فَقَالَ : "" أَعْطُوهُ إِيَّاهُ "" فَخَالَفَ إِنْسَانٌ فَاشْتَرَاهُ مِنْهُ بِدِرْهَمٍ ، ثُمَّ جَاءَ بِهِ إِلَيْهِ ، فَجَاءَهُ الْمِسْكِينُ يَسْأَلُ ، فَقَالَ : أَعْطُوهُ إِيَّاهُ ، فَخَالَفَ إِنْسَانٌ إِلَيْهِ ، فَاشْتَرَاهُ مِنْهُ بِدِرْهَمٍ ، فَأَرَادَ أَنْ يَرْجِعَ حَتَّى مُنِعَ ، وَلَوْ عَلِمَ  ابْنُ عُمَرَ  بِذَلِكَ الْعُنْقُودِ مَا ذَاقَهُ  "" .","","Al-Mu'jam al-Kabir 13067","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عبد الله بن المبارك عن نعيم بن حماد الخزاعي عن يوسف بن يزيد القراطيسي عن الطبراني","ذكر سنه ووفاته"
"13104","13068  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ،  عَنْ  عَبْدِ اللهِ بْنِ سَعِيدِ بْنِ أَبِي هِنْدٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّهُ : "" كَانَ يَدْخُلُ الْحَمَّامَ فَيُنَوِّرُهُ صَاحِبُ الْحَمَّامِ  ، فَإِذَا بَلَغَ حَقْوَهُ يَقُولُ لِصَاحِبِ الْحَمَّامِ : اخْرُجْ  "" .","","Al-Mu'jam al-Kabir 13068","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن سعيد بن أبي هند الفزاري عن عبد الله بن داود الخريبي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","ذكر سنه ووفاته"
"13105","13069  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ  ، ثَنَا  خَالِدُ بْنُ خِدَاشٍ ،  ثَنَا  سُكَيْنُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  أَبِيهِ  ، قَالَ :  دَخَلْتُ عَلَى         [12/267]      عَبْدِ اللهِ بْنِ عُمَرَ وَجَارِيَةٌ تَحْلِقُ عَنْهُ الشَّعَرَ ،  فَقَالَ  :  إِنَّ النَّوْرَةَ يَرِقُّ الْجِلْدَ  "" .","","Al-Mu'jam al-Kabir 13069","","عبد الله بن عمر بن الخطاب عن عبد العزيز بن قيس العبدي عن سكين بن عبد العزيز بن قيس المجاشعي عن خالد المهلبي عن محمد بن علي بن شعيب السمسار عن الطبراني","ذكر سنه ووفاته"
"13106","13070  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ،  عَنْ  فُضَيْلِ بْنِ غَزْوَانَ ،  عَنْ  نَافِعٍ :  أَنَّ  ابْنَ عُمَرَ ، كَانَ إِذَا اغْتَسَلَ فَتَحَ عَيْنَيْهِ  ، وَأَدْخَلَ إِصْبَعَيْهِ فِي سُرَّتِهِ  "" .","","Al-Mu'jam al-Kabir 13070","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن فضيل بن غزوان عن عبد الله بن داود الخريبي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","ذكر سنه ووفاته"
"13107","13071  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  ثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنِ  الْقَاسِمِ بْنِ أَبِي بَزَّةَ ،  عَنْ  عَطَاءِ بْنِ يَعْقُوبَ ، قَالَ :  اسْتَسْلَفَ  مِنِّي ابْنُ عُمَرَ أَلْفَ دِرْهَمٍ فَقَضَانِي أَجْوَدَ مِنْهَا  ، فَقُلْتُ لَهُ : إِنَّ دَرَاهِمَكَ أَجْوَدُ مِنْ دَرَاهِمِي ،  فَقَالَ  : "" مَا كَانَ فِيهَا مِنْ فَضْلٍ نَائِلٍ لَكَ مِنْ عِنْدِي  "" .","","Al-Mu'jam al-Kabir 13071","","عبد الله بن عمر بن الخطاب عن عطاء بن يعقوب المدني عن القاسم بن أبي بزة عن هشام الدستوائي عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","ذكر سنه ووفاته"
"13108","13072  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  يَزِيدَ بْنِ كَيْسَانَ الْيَشْكُرِيِّ ،  عَنْ  أَبِي حَازِمٍ  أَنَّ  ابْنَ عُمَرَ مَرَّ عَلَى رَجُلٍ ، وَمَعَهُ غُنَيْمَاتٌ لَهُ فَقَالَ لَهُ : بِكَمْ تَبِيعُ غَنَمَكَ هَذِهِ ؟  قَالَ : بِكَذَا وَكَذَا ، فَقَالَ  ابْنُ عُمَرَ  : آخُذُهَا بِكَذَا وَكَذَا ، فَحَلَفَ أَنْ لَا يَبِيعَهَا ، فَانْطَلَقَ  ابْنُ عُمَرَ  فَقَضَى حَاجَتَهُ فَمَرَّ عَلَيْهِ فَقَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  خُذْهَا بِالَّذِي أَعْطَيْتَنِي ، قَالَ : "" حَلَفْتَ عَلَى يَمِينٍ فَلَمْ أَكُنْ لِأُعِينَ الشَّيْطَانَ عَلَيْكَ أَنِّي أُحْنِثُكَ  "" .","","Al-Mu'jam al-Kabir 13072","","عبد الله بن عمر بن الخطاب عن سلمان الأعرج مولى عزة الأشجعية عن يزيد بن كيسان اليشكري عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","ذكر سنه ووفاته"
"13109","13073  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي حَازِمٍ ، قَالَ :  اشْتَرَيْنَا مِنِ ابْنِ عُمَرَ بَيْتًا         [12/268]      فَجَلَسَ عَلَى الْبَابِ فَكَثُرَ الْغُبَارُ  ، فَقُلْنَا : يَا  أَبَا عَبْدِ الرَّحْمَنِ  إِنَّا لَا نَأْخُذُ إِلَّا حَقًّا ، وَلَا نُخَوِّنُكَ ،  فَقَالَ  : "" إِنِّي أَخَافُ الظَّنَّ  "" .","","Al-Mu'jam al-Kabir 13073","","عبد الله بن عمر بن الخطاب عن سلمان الأعرج مولى عزة الأشجعية عن الأعمش عن عبد الله بن داود الخريبي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","ذكر سنه ووفاته"
"13110","13074  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحِيمِ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  عُمَرَ بْنِ نَافِعٍ ،  عَنْ  أَبِيهِ  :  أَنَّ  ابْنَ عُمَرَ كَانَ إِذَا صَلَّى وَحْدَهُ فِي أَيَّامِ  التَّشْرِيقِ  لَمْ يُكَبِّرْ دُبُرَ الصَّلَاةِ  "" .","","Al-Mu'jam al-Kabir 13074","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عمر بن نافع مولى ابن عمر عن زيد بن أبي أنيسة الجزري عن خالد بن يزيد الحراني عن محمد بن سلمة الباهلي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","ذكر سنه ووفاته"
"13111","13075  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الْوَرْكَانِيُّ ،  ثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  نَافِعٍ ، قَالَ :  نَزَلَ ابْنُ عُمَرَ عَلَى قَوْمٍ فَلَمَّا مَضَتْ ثَلَاثَةُ أَيَّامٍ  قَالَ  :  يَا  نَافِعُ  أَنْفِقْ عَلَيْنَا مِنْ مَالِنَا فَلَا حَاجَةَ لَنَا أَنْ يُتَصَدَّقَ عَلَيْنَا  "" .","","Al-Mu'jam al-Kabir 13075","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن الأعمش عن جرير بن حازم عن محمد بن جعفر الوركاني عن عبد الله بن أحمد بن حنبل عن الطبراني","ذكر سنه ووفاته"
"13112","13076  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سُفْيَانَ ،  عَنْ  سُلَيْمَانَ الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ مُعَاوِيَةَ ،  عَنِ  ابْنِ عُمَرَ  أَنَّهُ : "" كَانَ يَقْرَأُ هَذَا الْحَرْفَ         {      أَإِذَا كُنَّا عِظَامًا  نَاخِرَةً         }      "" .","","Al-Mu'jam al-Kabir 13076","","عبد الله بن عمر بن الخطاب عن زيد بن معاوية العبسي عن الأعمش عن سفيان الثوري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","ذكر سنه ووفاته"
"13113","13077  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  مُوسَى بْنِ ثَرْوَانَ ،  عَنْ  أَبِي الْمُتَوَكِّلِ أَنَّهُ :  رَأَى  ابْنَ عُمَرَ إِزَارُهُ إِلَى نِصْفِ سَاقِهِ  ، وَقَمِيصُهُ فَوْقَ ذَلِكَ ، وَرِدَاؤُهُ فَوْقَ الْقَمِيصِ  "" .","","Al-Mu'jam al-Kabir 13077","","عبد الله بن عمر بن الخطاب عن علي بن داود الناجي عن موسى بن ثروان العجلي عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","ذكر سنه ووفاته"
"13114","13078  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  رَأَيْتُ  ابْنَ عُمَرَ يَشْتَدُّ بَيْنَ الْعَرْضَيْنِ  وَيَقُولُ : "" أَنَا بِهَا ، أَنَا بِهَا  "" .","","Al-Mu'jam al-Kabir 13078","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن الأعمش عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","ذكر سنه ووفاته"
"13115","13079  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ         [12/269]      حُصَيْنٍ ،  عَنْ  عَبْدِ اللهِ بْنِ سَبْرَةَ ، قَالَ :  كَانَ ابْنُ عُمَرَ إِذَا أَصْبَحَ  قَالَ  : "" اللَّهُمَّ اجْعَلْنِي مِنْ أَعْظَمِ عِبَادِكَ  نَصِيبًا فِي كُلِّ خَيْرٍ تَقْسِمُهُ الْغَدَاةَ ، وَنُورًا تَهْدِي ، وَرَحْمَةً تَنْشُرُهَا ، وَرِزْقًا تَبْسُطُهُ ، وَضُرًّا تَكْشِفُهُ ، وَبَلَاءً تَرْفَعُهُ ، وَفِتْنَةً تَصْرِفُهَا  "" .","","Al-Mu'jam al-Kabir 13079","","عبد الله بن عمر بن الخطاب عن عبد الله بن سبرة الجهني عن حصين بن عبد الرحمن السلمي عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","ذكر سنه ووفاته"
"13116","13080  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ الدُّورِيُّ  ، ثَنَا  مُؤَمَّلُ بْنُ هِشَامٍ ،  ثَنَا  يَحْيَى بْنُ حَمَّادٍ ،  عَنِ  السَّرِيِّ بْنِ يَحْيَى ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ، قَالَ :  رُبَّمَا أَفْطَرَ ابْنُ عُمَرَ عَلَى الْجِمَاعِ  "" .","","Al-Mu'jam al-Kabir 13080","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن السري بن يحيى الشيباني عن يحيى بن حماد بن أبي زياد الشيباني عن مؤمل بن هشام اليشكري عن الهيثم بن خلف الدوري عن الطبراني","ذكر سنه ووفاته"
"13117","وَمِمَّا  أَسْنَدَ  عَبْدُ اللهِ بْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا  [  ابْنُ عَبَّاسٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13081  -  حَدَّثَنَا  الْحَسَنُ بْنُ الْمُتَوَكِّلِ الْبَغْدَادِيُّ  ، ثَنَا  خَالِدُ بْنُ يَزِيدَ الْقَرَنِيُّ ،  ثَنَا  أَبُو شِهَابٍ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنِ  الْحَكَمِ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كُنْتُ فِي جِنَازَةٍ وَمَعَهَا  ابْنُ عُمَرَ  ، فَسَمِعَ بُكَاءً  فَقَالَ  ابْنُ عُمَرَ رَضِيَ اللهُ عَنْهُمَا : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ الْمَيِّتَ لَيُعَذَّبُ بِبُكَاءِ أَهْلِهِ عَلَيْهِ  "" .","","Al-Mu'jam al-Kabir 13081","","عبد الله بن عمر بن الخطاب عن عبد الله بن عباس عن مقسم بن بجرة عن الحكم بن عتيبة الكندي عن محمد بن عبد الرحمن بن أبي ليلى عن عبد ربه بن نافع الحناط عن خالد بن يزيد المزرفي عن الحسن بن علي بن المتوكل البغدادي عن الطبراني","ابن عباس عن ابن عمر"
"13118","[  طَارِقُ بْنُ شِهَابٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13082  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  شَبَابٌ         [12/270]      الْعُصْفُرِيُّ ،  ثَنَا  سَهْلٌ أَبُو عَتَّابٍ ،  ثَنَا  حَفْصُ بْنُ سُلَيْمَانَ ،  عَنْ  قَيْسِ بْنِ مُسْلِمٍ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  عَادَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَجُلًا  مِنْ أَصْحَابِهِ مَرِيضًا ، وَأَنَا مَعَهُ فَدَخَلَ عَلَيْهِ وَهُوَ يُصَلِّي عَلَى عُودٍ ، فَوَضَعَ جَبْهَتَهُ عَلَى الْعُودِ ، فَأَوْمَأَ إِلَيْهِ فَطَرَحَ الْعُودَ وَأَخَذَ وِسَادَةً فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  دَعْهَا عَنْكَ إِنِ اسْتَطَعْتَ أَنْ تَسْجُدَ عَلَى الْأَرْضِ  ، وَإِلَّا فَأَوْمِئْ إِيمَاءً ، وَاجْعَلْ سُجُودَكَ أَخْفَضَ مِنْ رُكُوعِكَ  "" .","","Al-Mu'jam al-Kabir 13082","","عبد الله بن عمر بن الخطاب عن طارق بن شهاب الأحمسي عن قيس بن مسلم الجدلي عن حفيص الأسدي عن سهل بن حماد الدلال عن خليفة بن خياط عن عبد الله بن أحمد بن حنبل عن الطبراني","طارق بن شهاب عن ابن عمر"
"13119","13083  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  هِشَامُ بْنُ خَالِدٍ الدِّمَشْقِيُّ ،  ثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  عُمَرَ بْنِ ذَرٍّ ،  عَنْ  قَيْسِ بْنِ مُسْلِمٍ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ  أَنَّهُ لَقِيَ ابْنَ عُمَرَ  حَاجًّا أَوْ مُعْتَمِرًا  فَأَتَيْتُهُ  فَقُلْتُ  : يَا  أَبَا عَبْدِ الرَّحْمَنِ  إِنَّا أَهْلُ أَرْضٍ نَسْتَأْجِرُ الْأَرْضَ  الْبَيْضَاءَ  بِالدِّينَارِ وَالدِّرْهَمِ . قَالَ :  إِنَّا نَكْرَهُ ذَلِكَ ، هَذِهِ  الْمُحَاقَلَةُ  ، قُلْتُ : فَنُعْطِي الْأَرْضَ عَلَى الثُّلُثِ وَالرُّبُعِ ، قَالَ : "" لَا بَأْسَ بِذَلِكَ كُنَّا نَفْعَلُ ذَلِكَ  ""  .","","Al-Mu'jam al-Kabir 13083","","عبد الله بن عمر بن الخطاب عن طارق بن شهاب الأحمسي عن قيس بن مسلم الجدلي عن عمر بن ذر عن سويد بن عبد العزيز السلمي عن هشام بن خالد السلامي عن الحسن بن علي بن شبيب المعمري عن الطبراني","طارق بن شهاب عن ابن عمر"
"13120","[  عَبْدُ اللهِ بْنُ عَامِرِ بْنِ رَبِيعَةَ  ، عَنِ  ابْنِ عُمَرَ  ]  13084  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  دَاوُدُ بْنُ رُشَيْدٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ ،  عَنْ  مَسْلَمَةَ بْنِ أَبِي مَرْيَمَ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى         [12/271]      اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ حَالَتْ شَفَاعَتُهُ دُونَ حَدٍّ مِنْ حُدُودِ اللهِ  فَقَدْ ضَادَّ اللهَ فِي أَمْرِهِ  "" .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( مسلم )","","Al-Mu'jam al-Kabir 13084","","عبد الله بن عمر بن الخطاب عن عبد الله بن عامر بن ربيعة العنزي عن مسلم بن أبي مريم الأنصاري عن عبد الله بن جعفر بن نجيح عن داود بن رشيد الخوارزمي عن عبد الله بن أحمد بن حنبل عن الطبراني","عبد الله بن عامر بن ربيعة عن ابن عمر"
"13121","[  سَعِيدُ بْنُ الْمُسَيِّبِ  ، عَنِ  ابْنِ عُمَرَ  ]  13085  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنَّا إِذَا فَقَدْنَا الرَّجُلَ فِي الْفَجْرِ وَالْعِشَاءِ أَسَأْنَا بِهِ الظَّنَّ  "" .","","Al-Mu'jam al-Kabir 13085","","عبد الله بن عمر بن الخطاب عن سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","سعيد بن المسيب عن ابن عمر"
"13122","13086  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  (  ح  ) .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ، قَالَ :  سَمِعْتُ  سَالِمَ بْنَ رَزِينٍ  يُحَدِّثُ عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فِي الرَّجُلِ تَكُونُ لَهُ الْمَرْأَةُ ثُمَّ يُطَلِّقُهَا ، ثُمَّ يَتَزَوَّجُهَا رَجُلٌ فَيُطَلِّقُهَا قَبْلَ أَنْ يَدْخُلَ بِهَا تَحِلُّ لِلْأَوَّلِ ؟ قَالَ :  لَا ، حَتَّى تَذُوقَ  الْعُسَيْلَةَ  "" .  قَالَ أَبُو الْقَاسِمِ :  وَهِمَ  شُعْبَةُ  فِي هَذَا الْحَدِيثِ فِي مَوْضِعَيْنِ ، قَوْلِهِ : عَنْ  سَالِمِ بْنِ رَزِينٍ  ، وَإِنَّمَا هُوَ  سُلَيْمَانُ بْنُ رَزِينٍ  ، وَزَادَ فِي  الْإِسْنَادِ  سَعِيدَ بْنَ الْمُسَيِّبِ  ، رَوَاهُ  سُفْيَانُ الثَّوْرِيُّ  ،  وَقَيْسُ بْنُ الرَّبِيعِ  ،         [12/272]      عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ  ، عَنْ  سُلَيْمَانَ بْنِ رَزِينٍ الْأَحْمَرِ  ، عَنِ  ابْنِ عُمَرَ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَهُوَ الصَّوَابُ  .","","Al-Mu'jam al-Kabir 13086","","عبد الله بن عمر بن الخطاب عن سعيد بن المسيب عن رزين بن سليمان الأحمري عن علقمة بن مرثد الحضرمي عن شعبة بن الحجاج عن غندر ربيب شعبة عن يحيى بن معين عن معاذ بن المثنى العنبري عن الطبراني","سعيد بن المسيب عن ابن عمر"
"13123","13087  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  هَمَّامُ بْنُ يَحْيَى ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الْمَيِّتَ  يُعَذَّبُ  بِمَا نِيحَ عَلَيْهِ  "" .","","Al-Mu'jam al-Kabir 13087","","عبد الله بن عمر بن الخطاب عن سعيد بن المسيب عن قتادة بن دعامة عن همام بن يحيى بن دينار عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سعيد بن المسيب عن ابن عمر"
"13124","13088  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ، وَعُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ، قَالَا :  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 13088","","عبد الله بن عمر بن الخطاب عن سعيد بن المسيب عن قتادة بن دعامة عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن عثمان بن عمر الضبي عن الطبراني","سعيد بن المسيب عن ابن عمر"
"13125","13089  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  عُثْمَانُ بْنُ عَبْدِ اللهِ بْنِ عُثْمَانَ الشَّامِيُّ ،  ثَنَا  الضَّحَّاكُ بْنُ حَمْزَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُفُّوا عَنْ أَهْلِ لَا إِلَهَ إِلَّا اللهُ لَا تُكَفِّرُوهُمْ بِذَنْبٍ  ، فَمَنْ أَكْفَرَ أَهْلَ لَا إِلَهَ إِلَّا اللهُ فَهُوَ إِلَى الْكُفْرِ أَقْرَبُ  "" .","","Al-Mu'jam al-Kabir 13089","","عبد الله بن عمر بن الخطاب عن سعيد بن المسيب عن علي بن زيد بن جدعان عن الضحاك بن حمرة الأملوكي عن عثمان بن عبد الله بن عثمان الشامي عن أحمد بن داود بن موسى السدوسي عن الطبراني","سعيد بن المسيب عن ابن عمر"
"13126","13090  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ (  ح  ) .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  الْحَارِثُ بْنُ عُبَيْدٍ أَبُو قُدَامَةَ ،  ثَنَا  هُودُ بْنُ شِهَابِ بْنِ عَبَّادٍ الْعَصَرِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  سَعِيدِ بْنِ         [12/273]      الْمُسَيِّبِ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  حَجَجْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَمَعَ  أَبِي بَكْرٍ  ، وَمَعَ  عُمَرَ  ، وَمَعَ  عُثْمَانَ  رَضِيَ اللهُ عَنْهُمْ فَكُلُّهُمْ كَانَ لَا يَصُومُهُ  -  يَعْنِي يَوْمَ عَرَفَةَ  - "" .","","Al-Mu'jam al-Kabir 13090","","عبد الله بن عمر بن الخطاب عن سعيد بن المسيب عن شهاب بن عباد العبدي عن هود بن شهاب بن عباد عن الحارث بن عبيد الإيادي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سعيد بن المسيب عن ابن عمر"
"13127","13091  -  حَدَّثَنَا  أَحْمَدُ بْنُ زِيَادٍ الْأَعْرَجُ الْإِيَادِيُّ ،  بَجِيلَةُ  ،  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  مُعَانِ بْنِ رِفَاعَةَ ،  عَنِ  الْأَصَمِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ مَثَّلَ بِأَخِيهِ فَعَلَيْهِ لَعْنَةُ اللهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ  "" .  الْأَصَمُّ  يَعْنِي  يَزِيدَ بْنَ هُرْمُزَ  ، وَاللهُ أَعْلَمُ  .","","Al-Mu'jam al-Kabir 13091","","عبد الله بن عمر بن الخطاب عن سعيد بن المسيب عن يزيد بن هرمز المدني عن معان بن رفاعة السلامي عن بقية بن الوليد عن عبد الوهاب بن نجدة عن أحمد بن زياد الإيادي عن الطبراني","سعيد بن المسيب عن ابن عمر"
"13128","13092  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  أَبُو الطَّاهِرِ بْنُ السَّرْحِ ،  ثَنَا  رِشْدِينُ بْنُ سَعْدٍ ،  عَنْ  مُحَمَّدِ بْنِ سَهْمٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنِ  ابْنِ عُمَرَ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى صَلَاةَ الْخَوْفِ  بِهَؤُلَاءِ رَكْعَةً ، وَبِهَؤُلَاءِ رَكْعَةً  "" .","","Al-Mu'jam al-Kabir 13092","","عبد الله بن عمر بن الخطاب عن سعيد بن المسيب عن محمد بن سهم عن رشدين بن سعد المهري عن أحمد بن عمرو بن بن السرح المصري عن الحسن بن علي بن شبيب المعمري عن الطبراني","سعيد بن المسيب عن ابن عمر"
"13129","13093  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  وُهَيْبٌ (  ح  ) .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ (  ح  ) .  وَحَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  أَحْمَدُ بْنُ حَنْبَلٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، كُلُّهُمْ  عَنْ  عَبْدِ الْخَالِقِ بْنِ سَلَمَةَ الشَّيْبَانِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ ، يَقُولُ :  قَدِمَ وَفْدُ  عَبْدِ الْقَيْسِ  مَعَ  الْأَشَجِّ         [12/274]      فَسَأَلُوا نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الشَّرَابِ ، فَقَالَ :  لَا تَشْرَبُوا فِي  حَنْتَمَةٍ  ، وَلَا فِي  دُبَّاءٍ  ، وَلَا  نَقِيرٍ  "" .","","Al-Mu'jam al-Kabir 13093","","عبد الله بن عمر بن الخطاب عن سعيد بن المسيب عن عبد الخالق بن سلمة الشيباني عن وهيب بن خالد الكرابيسي عن أبو الوليد الطيالسي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","سعيد بن المسيب عن ابن عمر"
"13130","13094  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  حَمَّادُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  إِدْرِيسُ الْأَوْدِيُّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  حَضَرْتُ ابْنَ عُمَرَ فِي جِنَازَةٍ فَلَمَّا وَضَعَهَا فِي اللَّحْدِ ،  قَالَ  :  بِاسْمِ اللهِ وَفِي  سَبِيلِ  اللهِ وَعَلَى مِلَّةِ رَسُولِ اللهِ  ، فَلَمَّا أُخِذَ فِي اللَّبِنِ عَلَى اللَّحْدِ ، قَالَ : "" اللَّهُمَّ أَجِرْهَا مِنَ الشَّيْطَانِ ، وَمِنْ عَذَابِ الْقَبْرِ "" ، فَلَمَّا سَوَّوُا الْكَثِيبَ عَلَيْهَا قَامَ إِلَى جَانِبِ الْقَبْرِ ، ثُمَّ قَالَ : "" اللَّهُمَّ جَافِ الْأَرْضَ عَنْ جَنْبَيْهَا ، وَصَعِّدْ رُوحَهَا ، وَلَقِّهَا مِنْكَ رِضْوَانًا "" ، فَقُلْتُ : أَشْيَاءُ سَمِعْتَهَا مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَمْ أَشْيَاءُ قُلْتَ مِنْ رَأْيِكَ ؟ قَالَ : "" إِنِّي  إِذًا لَقَادِرٌ عَلَى الْقَوْلِ ، بَلْ سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .  سقطت من طبعة مكتبة ابن تيمية والمثبت من نسخة خطية","","Al-Mu'jam al-Kabir 13094","","عبد الله بن عمر بن الخطاب عن سعيد بن المسيب عن إدريس بن صبيح الأودي عن حماد بن عبد الرحمن القنسريني عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","سعيد بن المسيب عن ابن عمر"
"13131","[  الْقَاسِمُ بْنُ مُحَمَّدٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13095  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ  ، ثَنَا  خَالِدُ بْنُ خِدَاشٍ (  ح  ) .  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  حَجَّاجُ بْنُ إِبْرَاهِيمَ الْأَزْرَقُ ،  ثَنَا  ابْنُ وَهْبٍ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ أَنَّ  عَبْدَ الرَّحْمَنِ بْنَ الْقَاسِمِ         [12/275]      حَدَّثَهُ  ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ أَنَّهُ كَانَ يُخْبِرُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الشَّمْسَ وَالْقَمَرَ لَا  يَنْخَسِفَانِ  لِمَوْتِ أَحَدٍ  وَلَا لِحَيَاتِهِ ، وَلَكِنَّهُمَا آيَتَانِ مِنْ آيَاتِ اللهِ ، فَإِذَا رَأَيْتُمُوهَا فَصَلُّوا  "" .","","Al-Mu'jam al-Kabir 13095","","عبد الله بن عمر بن الخطاب عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن حجاج بن إبراهيم الأبناوي عن يوسف بن يزيد القراطيسي عن الطبراني","القاسم بن محمد عن ابن عمر"
"13132","13096  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ أَنَّ عَبْدَ الرَّحْمَنِ بْنَ الْقَاسِمِ  حَدَّثَهُ  ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ، فَإِذَا أَرَدْتَ أَنْ تَنْصَرِفَ فَارْكَعْ وَاحِدَةً تُوتِرُ لَكَ مَا صَلَّيْتَ  "" .","","Al-Mu'jam al-Kabir 13096","","عبد الله بن عمر بن الخطاب عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","القاسم بن محمد عن ابن عمر"
"13133","13097  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَبُو الْأَسْوَدِ النَّضْرُ بْنُ عَبْدِ الْجَبَّارِ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنِ اشْتَرَى طَعَامًا فَلَا يَبِيعُهُ حَتَّى يَسْتَوْفِيَهُ  "" .","","Al-Mu'jam al-Kabir 13097","","عبد الله بن عمر بن الخطاب عن القاسم بن محمد بن أبي بكر الصديق عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن النضر بن عبد الجبار المرادي عن المقدام بن داود الرعيني عن الطبراني","القاسم بن محمد عن ابن عمر"
"13134","13098  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنِ  الْمُنْذِرِ بْنِ عُبَيْدٍ الْمَدِينِيِّ أَنَّ الْقَاسِمَ بْنَ مُحَمَّدٍ  حَدَّثَهُ  ، أَنَّ عَبْدَ اللهِ بْنَ عُمَرَ  حَدَّثَهُ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى أَنْ يَبِيعَ طَعَامًا اشْتَرَاهُ بِكَيْلٍ حَتَّى يَسْتَوْفِيَهُ  "" .","","Al-Mu'jam al-Kabir 13098","","عبد الله بن عمر بن الخطاب عن القاسم بن محمد بن أبي بكر الصديق عن المنذر بن عبيد المدني عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","القاسم بن محمد عن ابن عمر"
"13135","13099  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَبُو الْأَسْوَدِ النَّضْرُ بْنُ عَبْدِ الْجَبَّارِ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنِ         [12/276]      ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَلْبَسُ الْمُحْرِمُ الْقَمِيصَ وَلَا الْقَبَاسَ وَلَا السَّرَاوِيلَ  وَلَا الْعِمَامَةَ وَلَا الْبَرَانِسَ وَلَا شَيْئًا مَسَّهُ الزَّعْفَرَانُ وَالْوَرْسُ  "" .","","Al-Mu'jam al-Kabir 13099","","عبد الله بن عمر بن الخطاب عن القاسم بن محمد بن أبي بكر الصديق عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن النضر بن عبد الجبار المرادي عن المقدام بن داود الرعيني عن الطبراني","القاسم بن محمد عن ابن عمر"
"13136","13100  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْأَبَّارُ  ، ثَنَا  عَلِيُّ بْنُ حُجْرٍ الْمَرْوَزِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ مُحَمَّدٍ الْمُوَقَّرِيُّ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  عَلَيْكُمْ بِثِيَابِ الْبَيَاضِ فَالْبَسُوهَا  ، وَكَفِّنُوا فِيهَا مَوْتَاكُمْ  "" .","","Al-Mu'jam al-Kabir 13100","","عبد الله بن عمر بن الخطاب عن القاسم بن محمد بن أبي بكر الصديق عن الزهري عن الوليد بن محمد الموقرى عن علي بن حجر بن إياس عن أحمد بن علي بن مسلم النخشبي عن الطبراني","القاسم بن محمد عن ابن عمر"
"13137","13101  -  حَدَّثَنَا  أَبُو حَنِيفَةَ مُحَمَّدُ بْنُ حَنِيفَةَ الْوَاسِطِيُّ  ، ثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ ،  ثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْبَيِّعَانِ  بِالْخِيَارِ  مَا لَمْ  يَتَفَرَّقَا  "" .","","Al-Mu'jam al-Kabir 13101","","عبد الله بن عمر بن الخطاب عن القاسم بن محمد بن أبي بكر الصديق عن يحيى بن سعيد الأنصاري عن أنس بن عياض الليثي عن الزبير بن بكار عن محمد بن حنيفة القصبى عن الطبراني","القاسم بن محمد عن ابن عمر"
"13138","13102  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ فَكَانَتْ لَيْلَةٌ ظَلْمَاءُ أَذَّنَ مُؤَذِّنُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَصَلَّى ثُمَّ أَمَرَ  مُنَادِيًا  أَنْ يُنَادِيَ :  أَنْ صَلُّوا فِي رِحَالِكُمْ  "" .","","Al-Mu'jam al-Kabir 13102","","عبد الله بن عمر بن الخطاب عن القاسم بن محمد بن أبي بكر الصديق عن يحيى بن سعيد الأنصاري عن سلام بن سليم الحنفي عن جعفر بن حميد زنبقة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","القاسم بن محمد عن ابن عمر"
"13139","13103  -  وَبِإِسْنَادِهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كُنْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ ، وَكَانَتْ لَيْلَةٌ ظَلْمَاءُ أَذَّنَ مُؤَذِّنُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَصَلَّى ثُمَّ أَمَرَ  مُنَادِيًا  أَنْ يُنَادِيَ :  أَنْ صَلُّوا فِي رِحَالِكُمْ  "" .","","Al-Mu'jam al-Kabir 13103","","عبد الله بن عمر بن الخطاب عن القاسم بن محمد بن أبي بكر الصديق عن يحيى بن سعيد الأنصاري عن سلام بن سليم الحنفي عن جعفر بن حميد زنبقة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","القاسم بن محمد عن ابن عمر"
"13140","[12/277]      13104  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  حَامِدُ بْنُ يَحْيَى ،  ثَنَا  سُفْيَانُ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  يَتَنَاجَى  اثْنَانِ دُونَ الثَّالِثِ  "" .","","Al-Mu'jam al-Kabir 13104","","عبد الله بن عمر بن الخطاب عن القاسم بن محمد بن أبي بكر الصديق عن يحيى بن سعيد الأنصاري عن سفيان بن عيينة عن حامد بن يحيى البلخي عن روح بن الفرج القطان عن الطبراني","القاسم بن محمد عن ابن عمر"
"13141","[  سَالِمٌ  عَنِ  ابْنِ عُمَرَ  ]  13105  -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُحَمَّدٍ الْعُمَرِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  أَخِي  ،  عَنْ  سُلَيْمَانَ بْنِ بِلَالٍ ،  عَنِ  ابْنِ أَبِي عَتِيقٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ  أَنَّ  عَبْدَ اللهِ بْنَ عُمَرَ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّمَا النَّاسُ  كَالْإِبِلِ  الْمِائَةِ لَا يَكَادُ يَجِدُ فِيهَا  رَاحِلَةً  "" .","","Al-Mu'jam al-Kabir 13105","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن عبد الله بن أبي عتيق القرشي عن سليمان بن بلال القرشي عن عبد الحميد بن أبي أويس الأعشى عن إسماعيل بن أبي أويس عن عبيد الله بن محمد بن عبد العزيز العمري عن الطبراني","سالم عن ابن عمر"
"13142","13106  -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُحَمَّدٍ الْعُمَرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ أَبِي بَكْرِ  السَّالِمِيِّ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي أُوَيْسٍ الْأَعْشَى ،  عَنْ  سُلَيْمَانَ بْنِ بِلَالٍ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي عَتِيقٍ ، وَمُوسَى بْنِ عُقْبَةَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ  بِلَالًا  يُؤَذِّنُ بِلَيْلٍ  ، فَكُلُوا وَاشْرَبُوا حَتَّى يُنَادِيَ  ابْنُ أُمِّ مَكْتُومٍ  "" .  سقط من طبعة مكتبة ابن تيمية ، والمثبت من النسخة الخطية .","","Al-Mu'jam al-Kabir 13106","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن موسى بن عقبة عن سليمان بن بلال القرشي عن عبد الحميد بن أبي أويس الأعشى عن أحمد بن محمد بن أبي بكر السالمي عن عبيد الله بن محمد بن عبد العزيز العمري عن الطبراني","سالم عن ابن عمر"
"13143","[12/278]      13107  -  حَدَّثَنَا  سَلَمَةُ بْنُ أَحْمَدَ الْفَوْزِيُّ الْحِمْصِيُّ ،  ثَنَا  جَدِّي خَطَّابُ بْنُ عُثْمَانَ الْفَوْزِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ حِمْيَرَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي عَبْلَةَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  إِذَا  جَدَّ  بِهِ السَّيْرُ فِي السَّفَرِ أَخَّرَ الْمَغْرِبَ حَتَّى جَمَعَ بَيْنَهَا  وَبَيْنَ صَلَاةِ الْعِشَاءِ  "" .","","Al-Mu'jam al-Kabir 13107","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إبراهيم بن أبي عبلة عن محمد بن حمير القضاعي عن خطاب الفوزي عن سلمة بن أحمد الفوزي عن الطبراني","سالم عن ابن عمر"
"13144","13108  -  حَدَّثَنَا  سَلَمَةُ بْنُ أَحْمَدَ الْفَوْزِيُّ الْحِمْصِيُّ ،  ثَنَا  جَدِّي خَطَّابُ بْنُ عُثْمَانَ الْفَوْزِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ حِمْيَرَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي عَبْلَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ فَاتَتْهُ صَلَاةُ الْعَصْرِ فَكَأَنَّمَا  وُتِرَ  أَهْلَهُ وَمَالَهُ  "" .","","Al-Mu'jam al-Kabir 13108","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إبراهيم بن أبي عبلة عن محمد بن حمير القضاعي عن خطاب الفوزي عن سلمة بن أحمد الفوزي عن الطبراني","سالم عن ابن عمر"
"13145","13109  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  فَرَضَ  فِي  الْبَعْلِ  وَفِيمَا سَقَتِ الْأَنْهَارُ  الْعُشُورَ  ، وَمَا سُقِيَ  بِالنَّضْحِ  نِصْفَ الْعُشْرِ  "" .","","Al-Mu'jam al-Kabir 13109","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","سالم عن ابن عمر"
"13146","13110  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  حَجَّاجُ بْنُ إِبْرَاهِيمَ         [12/279]      الْأَزْرَقُ ،  ثَنَا  عَتَّابُ بْنُ بَشِيرٍ ،  عَنْ  إِسْحَاقَ بْنِ رَاشِدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ، وَأَبِي بَكْرِ بْنِ سُلَيْمَانَ  أَنَّ  عَبْدَ اللهِ بْنَ عُمَرَ  قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْعِشَاءَ فِي آخِرِ حَيَاتِهِ فَلَمَّا سَلَّمَ قَالَ :  أَرَأَيْتَكُمْ لَيْلَتَكُمْ هَذِهِ ، فَإِنَّ رَأْسَ مِائَةٍ لَا يَبْقَى مِمَّنْ هُوَ عَلَى الْأَرْضِ أَحَدٌ  "" .","","Al-Mu'jam al-Kabir 13110","","عبد الله بن عمر بن الخطاب عن أبو بكر بن سليمان بن أبي حثمة العدوي عن الزهري عن إسحاق بن راشد الجزري عن عتاب بن بشير عن حجاج بن إبراهيم الأبناوي عن يوسف بن يزيد القراطيسي عن الطبراني","سالم عن ابن عمر"
"13147","13111  -  حَدَّثَنَا  سَلَمَةُ بْنُ أَحْمَدَ الْفَوْزِيُّ الْحِمْصِيُّ ،  ثَنَا  جَدِّي خَطَّابُ بْنُ عُثْمَانَ الْفَوْزِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حِمْيَرَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي عَبْلَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ افْتَتَحَ التَّكْبِيرَ فِي الصَّلَاةِ  ، فَرَفَعَ يَدَيْهِ حَتَّى جَعَلَهُمَا  حَذْوَ  مَنْكِبَيْهِ ، ثُمَّ إِذَا كَبَّرَ لِلرُّكُوعِ فَعَلَ مِثْلَ ذَلِكَ "" ، ثُمَّ قَالَ : ""  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ "" فَفَعَلَ مِثْلَ ذَلِكَ ، ثُمَّ قَالَ : "" رَبَّنَا لَكَ الْحَمْدُ "" فَفَعَلَ مِثْلَ ذَلِكَ  .","","Al-Mu'jam al-Kabir 13111","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إبراهيم بن أبي عبلة عن محمد بن حمير القضاعي عن خطاب الفوزي عن سلمة بن أحمد الفوزي عن الطبراني","سالم عن ابن عمر"
"13148","13112  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  النَّضْرُ بْنُ عَبْدِ الْجَبَّارِ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  قُرَّةَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَيْوِيلٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ إِذَا كَبَّرَ فِي الصَّلَاةِ رَفَعَ يَدَيْهِ حِذَاءَ مَنْكِبَيْهِ  ، وَإِذَا رَكَعَ فَعَلَ مِثْلَ ذَلِكَ ، وَإِذَا رَفَعَ رَأْسَهُ فَعَلَ مِثْلَ ذَلِكَ ، وَإِذَا قَالَ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، قَالَ : رَبَّنَا لَكَ الْحَمْدُ ، وَفَعَلَ مِثْلَ ذَلِكَ ، وَلَا يَفْعَلُ فِي السُّجُودِ  . ""         [12/280]","","Al-Mu'jam al-Kabir 13112","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن قرة بن عبد الرحمن المعافري عن عبد الله بن لهيعة عن النضر بن عبد الجبار المرادي عن يوسف بن يزيد القراطيسي عن الطبراني","سالم عن ابن عمر"
"13149","13113  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ سُفْيَانَ الرَّقِّيُّ  ، ثَنَا  عَمْرُو بْنُ قُسْطٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  إِسْحَاقَ بْنِ رَاشِدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ رَبَّنَا وَلَكَ الْحَمْدُ  ، ثُمَّ يَقُولُ قَبْلَ أَنْ يَسْجُدَ : "" اللَّهُمَّ الْعَنْ فُلَانًا وَفُلَانًا ، ثُمَّ يُكَبِّرُ ، وَيَسْجُدُ ، حَتَّى أَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      لَيْسَ لَكَ مِنَ الأَمْرِ شَيْءٌ         }      .","","Al-Mu'jam al-Kabir 13113","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إسحاق بن راشد الجزري عن عبيد الله بن عمرو بن أبي الوليد عن عمرو بن قسط الرقي عن محمد بن جعفر بن سفيان عن الطبراني","سالم عن ابن عمر"
"13150","13114  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ سُفْيَانَ الرَّقِّيُّ  ، ثَنَا  عَمْرُو بْنُ قُسْطٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  إِسْحَاقَ بْنِ رَاشِدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاةَ الْخَوْفِ  بِإِحْدَى الطَّائِفَتَيْنِ رَكْعَةً ، وَالطَّائِفَةُ الْأُخْرَى مُوَاجِهَةُ الْعَدُوِّ ، ثُمَّ انْصَرَفُوا وَقَامُوا فِي مَقَامِ أَصْحَابِهِمْ مُقْبِلِينَ عَلَى الْعَدُوِّ ، وَجَاءَ أُولَئِكَ فَصَلَّى بِهِمُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَكْعَةً ، ثُمَّ سَلَّمَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثُمَّ قَضَى هَؤُلَاءِ رَكْعَةً وَهَؤُلَاءِ رَكْعَةً  "" .","","Al-Mu'jam al-Kabir 13114","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إسحاق بن راشد الجزري عن عبيد الله بن عمرو بن أبي الوليد عن عمرو بن قسط الرقي عن محمد بن جعفر بن سفيان عن الطبراني","سالم عن ابن عمر"
"13151","13115  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 13115","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سالم عن ابن عمر"
"13152","13116  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّهُ صَلَّاهَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 13116","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سالم عن ابن عمر"
"13153","[12/281]      13117  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  الْعَلَاءُ بْنُ سُلَيْمَانَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَوَضَّئُوا مِمَّا مَسَّتِ النَّارُ  "" .","","Al-Mu'jam al-Kabir 13117","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن العلاء بن سليمان الرقي عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","سالم عن ابن عمر"
"13154","13118  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  الْعَلَاءُ بْنُ سُلَيْمَانَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ مَسَّ ذَكَرَهُ فَلْيَتَوَضَّأْ  "" .","","Al-Mu'jam al-Kabir 13118","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن العلاء بن سليمان الرقي عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","سالم عن ابن عمر"
"13155","13119  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ الزُّبَيْرِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَنْظُرَ الرَّجُلُ إِلَى  عَوْرَةِ  أَخِيهِ  "" .","","Al-Mu'jam al-Kabir 13119","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن الزبير الحنظلي عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","سالم عن ابن عمر"
"13156","13120  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  قُرَّةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  نَهَى أَنْ يُصَلَّى عَلَى  قَارِعَةِ  الطَّرِيقِ  أَوْ يُضْرَبَ فِيهَا الْخَلَاءُ أَوْ يُبَالَ فِيهَا  "" .         [12/282]","","Al-Mu'jam al-Kabir 13120","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن قرة بن عبد الرحمن المعافري عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن روح بن الفرج القطان عن الطبراني","سالم عن ابن عمر"
"13157","13121  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  عَبْدُ الْقَاهِرِ بْنُ رِشْدِينَ بْنِ سَعْدٍ ،  ثَنَا  أَبِي  ،  عَنْ  قُرَّةَ ، وَعُقَيْلٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا تَرْجِعُوا بَعْدِي  كُفَّارًا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  "" .","","Al-Mu'jam al-Kabir 13121","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن قرة بن عبد الرحمن المعافري عن رشدين بن سعد المهري عن عبد القاهر بن رشدين بن سعد عن يحيى بن عثمان بن صالح عن الطبراني","سالم عن ابن عمر"
"13158","13122  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  أَبُو صَالِحٍ الْحَرَّانِيُّ ،  ثَنَا  عَبْدُ الرَّزَّاقِ بْنُ عُمَرَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَلَاةُ الْقَاعِدِ مِثْلُ نِصْفِ صَلَاةِ الْقَائِمِ  "" .","","Al-Mu'jam al-Kabir 13122","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عبد الرزاق بن عمر الثقفي عن عبد الغفار بن داود الحراني عن يحيى بن عثمان بن صالح عن الطبراني","سالم عن ابن عمر"
"13159","13123  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ نَافِعٍ الْمِصْرِيُّ ، وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَعَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالُوا :  ثَنَا  أَبُو مُصْعَبٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ ،  عَنِ  ابْنِ أَخِي الزُّهْرِيِّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ يَقْرَأُ فِي رَكْعَتَيِ الْفَجْرِ :         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ، وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .","","Al-Mu'jam al-Kabir 13123","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن أحمد بن أبي بكر العوفى عن عبد الله بن أحمد بن حنبل عن الطبراني","سالم عن ابن عمر"
"13160","13124  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  ، قَالَ :  لَمْ يَكُنْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَلَا  أَبُو بَكْرٍ  ،         [12/283]      وَلَا  عُمَرُ  يَلْبَسُونَ الْخَوَاتِمَ  ، وَلَا يَطْبَعُونَ كِتَابًا "" حَتَّى كَتَبَهُ  زِيَادُ بْنُ أَبِي سُفْيَانَ  إِلَى  عُمَرَ بْنِ الْخَطَّابِ  ، إِنَّكَ تَكْتُبُ إِلَيْنَا بِأَشْيَاءَ لَيْسَتْ لَهَا طَوَابِعُ ، فَاتَّخَذَ عِنْدَ ذَلِكَ خَاتَمًا فَطُبِعَ بِهِ  .  في طبعة مكتبة ابن تيمية : (سهل) والمثبت من النسخة الخطية ، والله أعلم .","","Al-Mu'jam al-Kabir 13124","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن جعفر بن ربيعة الكندي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","سالم عن ابن عمر"
"13161","13125  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  حَبِيبٌ كَاتِبُ مَالِكٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ ابْنُ أَخِي الزُّهْرِيِّ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ حَفِظَنِي فِي أَصْحَابِي وَرَدَ عَلَيَّ حَوْضِي  ، وَمَنْ لَمْ يَحْفَظْنِي فِي أَصْحَابِي لَمْ يَرَنِي يَوْمَ الْقِيَامَةِ إِلَّا مِنْ بَعِيدٍ  "" .","","Al-Mu'jam al-Kabir 13125","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن حبيب بن أبي حبيب الحنفي عن أحمد بن داود بن موسى السدوسي عن الطبراني","سالم عن ابن عمر"
"13162","13126  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عُقَيْلٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، عَنْ بَيْعِ الثِّمَارِ حَتَّى يَبْدُوَ يَصْفَرَّ أَوْ يَحْمَرَّ  "" .","","Al-Mu'jam al-Kabir 13126","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عقيل بن خالد الأيلي عن عبد الله بن لهيعة عن عثمان بن صالح بن صفوان عن يحيى بن عثمان بن صالح عن الطبراني","سالم عن ابن عمر"
"13163","13127  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ         [12/284]      الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأَى عَلَى  عُمَرَ  قَمِيصًا أَبْيَضَ ، فَقَالَ : "" أَجَدِيدٌ قَمِيصُكَ هَذَا أَمْ غَسِيلٌ ؟ "" قَالَ : بَلْ غَسِيلٌ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْبَسْ جَدِيدًا ، وَعِشْ حَمِيدًا ، وَمُتْ شَهِيدًا  ، وَيَرْزُقُكَ اللهُ قُرَّةَ عَيْنٍ فِي الدُّنْيَا وَالْآخِرَةِ "" قَالَ : وَإِيَّاكَ يَا رَسُولَ اللهِ  .","","Al-Mu'jam al-Kabir 13127","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سالم عن ابن عمر"
"13164","13128  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ  ، ثَنَا  أَبُو الْمُغِيرَةِ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ بْنِ تَمِيمٍ السُّلَمِيُّ ،  حَدَّثَنِي  الزُّهْرِيُّ ،  عَنْ  سَالِمٍ  أَنَّ  عَبْدَ اللهِ بْنَ عُمَرَ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا أَعْجَلَهُ السَّيْرُ فِي السَّفَرِ  يُؤَخِّرُ صَلَاةَ الْمَغْرِبِ حَتَّى يَجْمَعَ بَيْنَهَا ، وَبَيْنَ صَلَاةِ الْعِشَاءِ  .","","Al-Mu'jam al-Kabir 13128","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عبد الرحمن بن يزيد بن تميم السلمي عن عبد القدوس بن الحجاج عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","سالم عن ابن عمر"
"13165","13129  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ  ، ثَنَا  أَبُو الْمُغِيرَةِ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ بْنِ تَمِيمٍ ،  ثَنَا  الزُّهْرِيُّ ،  حَدَّثَنِي  سَالِمٌ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  : "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُسَبِّحُ وَهُوَ عَلَى دَابَّتِهِ لَا  يُبَالِي  حَيْثُ كَانَ وَجْهُهُ  "" .","","Al-Mu'jam al-Kabir 13129","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عبد الرحمن بن يزيد بن تميم السلمي عن عبد القدوس بن الحجاج عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","سالم عن ابن عمر"
"13166","13130  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  عَلِيُّ بْنُ         [12/285]      مَعْبَدٍ ،  ثَنَا  خَالِدُ بْنُ سِنَانٍ ،  ثَنَا  سُلَيْمَانُ بْنُ أَبِي دَاوُدَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ بَاعَ نَخْلًا بَعْدَ أَنْ  يُؤَبَّرَ  فَثَمَرَتُهَا  لِلَّذِي بَاعَهُ إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ ، وَمَنْ بَاعَ عَبْدًا ، وَلَهُ مَالٌ فَمَالُهُ لِلَّذِي بَاعَهُ إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ  "" .","","Al-Mu'jam al-Kabir 13130","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سليمان بن أبي داود الحراني بومة عن خالد بن سنان العبسي عن علي بن معبد العبدي عن يحيى بن عثمان بن صالح عن الطبراني","سالم عن ابن عمر"
"13167","13131  -  حَدَّثَنَا  أَحْمَدُ بْنُ شُعَيْبٍ أَبُو عَبْدِ الرَّحْمَنِ النَّسَائِيُّ  ، أَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنَّا نَقُولُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَبُو بَكْرٍ  ،  وَعُمَرُ  ،  وَعُثْمَانُ  "" .","","Al-Mu'jam al-Kabir 13131","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن ثور بن يزيد الكلاعي عن الوليد بن مسلم القرشي عن إسحاق ابن راهويه عن النسائي عن الطبراني","سالم عن ابن عمر"
"13168","13132  -  حَدَّثَنَا  عَمْرُو بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ الْعَلَاءِ ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  عُمَارَةُ بْنُ وَثِيمَةَ بْنِ مُوسَى بْنِ الْفُرَاتِ أَبُو رِفَاعَةَ الْمِصْرِيُّ ، قَالَ :  ثَنَا  إِسْحَاقُ بْنُ زِبْرِيقَ الْحِمْصِيُّ ،  ثَنَا  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ سَالِمٍ ،  عَنِ  الزُّبَيْدِيِّ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ مُسْلِمٍ الزُّهْرِيُّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  كُنَّا نَقُولُ وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَيٌّ : أَفْضَلُ هَذِهِ الْأُمَّةِ بَعْدَ نَبِيِّهَا  أَبُو بَكْرٍ  وَعُمَرُ  وَعُثْمَانُ  ،         [12/286]      وَيَسْمَعُ ذَلِكَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَلَا يُنْكِرُهُ . مَا نَعْلَمُ  عُثْمَانَ  جَاءَ بِشَيْءٍ مِنَ الْكَبَائِرِ ، وَلَا قَتَلَ نَفْسًا بِغَيْرِ حِلِّهَا ، وَلَكِنَّهُ هَذَا الْمَالُ إِنْ أَعْطَاكُمُوهُ رَضِيتُمْ ، وَإِنْ أَعْطَى  قُرَيْشًا  سَخِطْتُمْ ، إِنَّمَا تُرِيدُونَ أَنْ تَكُونُوا  كَفَارِسَ  أَوِ  الرُّومِ  لَا يَتْرُكُونَ لَهُمْ أَمِيرًا إِلَّا قَتَلُوهُ  "" .","","Al-Mu'jam al-Kabir 13132","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن الوليد بن عامر الزبيدي عن عبد الله بن سالم الوحاظي عن عمرو بن الحارث الزبيدي عن إسحاق بن إبراهيم بن العلاء عن عمارة بن وثيمة المصري عن الطبراني","سالم عن ابن عمر"
"13169","13133  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ، قَالَ :  قَرَأْتُ عَلَى  ابْنِ جُرَيْجٍ ،  ثَنَا  زِيَادُ بْنُ سَعْدٍ أَنَّ ابْنَ شِهَابٍ  حَدَّثَهُ  ،  حَدَّثَنِي  سَالِمٌ ،  عَنِ  ابْنِ عُمَرَ  أَنَّهُ : "" كَانَ يَمْشِي بَيْنَ يَدَيِ الْجِنَازَةِ ،  وَقَدْ كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَأَبُو بَكْرٍ  وَعُمَرُ  وَعُثْمَانُ  يَمْشُونَ أَمَامَهَا  .  قَالَ  أَبِي  هَذَا الْحَدِيثَ ، وَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِنَّمَا هُوَ عَنِ  الزُّهْرِيِّ  مُرْسَلٌ  ، وَحَدِيثُ  سَالِمٍ  فَعَلَ  ابْنُ عُمَرَ  ، وَحَدِيثُ  ابْنُ عُيَيْنَةَ  كَأَنَّهُ  وَهِمَ  "" .","","Al-Mu'jam al-Kabir 13133","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن زياد بن سعد الخراساني عن ابن جريج عن حجاج بن محمد الأعور عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سالم عن ابن عمر"
"13170","13134  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  الْعَبَّاسُ بْنُ الْحَسَنِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  وَأَبَا بَكْرٍ  ،  وَعُمَرَ  كَانُوا يَمْشُونَ أَمَامَ الْجِنَازَةِ  "" .","","Al-Mu'jam al-Kabir 13134","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن العباس بن الحسن الجزري عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","سالم عن ابن عمر"
"13171","13135  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عُقَيْلٍ وَيُونُسَ  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  وَأَبَا بَكْرٍ  ،  وَعُمَرَ  يَمْشُونَ أَمَامَ الْجِنَازَةِ  "" .","","Al-Mu'jam al-Kabir 13135","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","سالم عن ابن عمر"
"13172","13136  -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُحَمَّدٍ الْعُمَرِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  أَخِي  ،  عَنْ  سُلَيْمَانَ بْنِ بِلَالٍ ،  عَنْ  أَبِي عَتِيقٍ ، وَمُوسَى بْنِ عُقْبَةَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  أَنَّ  عَبْدَ اللهِ بْنَ عُمَرَ  كَانَ يَمْشِي أَمَامَ الْجِنَازَةِ ، وَقَالَ :  قَدْ كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَمْشِي بَيْنَ يَدَيْهَا  وَأَبُو بَكْرٍ  وَعُمَرُ  وَعُثْمَانُ  "" .","","Al-Mu'jam al-Kabir 13136","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن عبد الله بن أبي عتيق القرشي عن سليمان بن بلال القرشي عن عبد الحميد بن أبي أويس الأعشى عن إسماعيل بن أبي أويس عن عبيد الله بن محمد بن عبد العزيز العمري عن الطبراني","سالم عن ابن عمر"
"13173","[12/287]      13137  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ (  ح  ) .  وَحَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَا :  ثَنَا  اللَّيْثُ بْنُ سَعْدٍ ،  عَنْ  عُقَيْلٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْمُسْلِمُ أَخُو الْمُسْلِمِ لَا يَظْلِمُهُ  ، وَلَا  يُسْلِمُهُ ،  مَنْ كَانَ فِي حَاجَةِ أَخِيهِ كَانَ اللهُ فِي حَاجَتِهِ ، وَمَنْ فَرَّجَ عَنْ مُسْلِمٍ كُرْبَةً فِي الدُّنْيَا ، فَرَّجَ اللهُ عَنْهُ بِهَا كُرْبَةً مِنْ كُرَبِ يَوْمِ الْقِيَامَةِ ، وَمَنْ سَتَرَ مُسْلِمًا سَتَرَهُ اللهُ يَوْمَ الْقِيَامَةِ  "" .","","Al-Mu'jam al-Kabir 13137","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عقيل بن خالد الأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","سالم عن ابن عمر"
"13174","13138  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  زَمْعَةُ بْنُ صَالِحٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يُلْدَغُ الْمُؤْمِنُ مِنْ جُحْرٍ مَرَّتَيْنِ  "" .","","Al-Mu'jam al-Kabir 13138","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن زمعة بن صالح الجندي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سالم عن ابن عمر"
"13175","13139  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرٍ الصَّائِغُ  ، ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  يُونُسَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَرْفَعُوا أَبْصَارَكُمْ إِلَى السَّمَاءِ فَتَلْتَمِعَ  يَعْنِي فِي الصَّلَاةِ .","","Al-Mu'jam al-Kabir 13139","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن يونس بن يزيدالأيلي عن سليمان بن بلال القرشي عن إسماعيل بن أبي أويس عن محمد بن نصر بن منصور الصائغ عن الطبراني","سالم عن ابن عمر"
"13176","13140  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  ثَنَا         [12/288]      خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ اسْتَشَارَ الْمُسْلِمِينَ فِيمَا يَجْمَعُهُمْ فِي الصَّلَاةِ  ، فَقَالُوا : الْبُوقُ ، فَكَرِهَهُ مِنْ أَجْلِ الْيَهُودِ ، ثُمَّ ذُكِرَ النَّاقُوسُ ، فَكَرِهَهُ مِنْ أَجْلِ النَّصَارَى ، فَأُرِيَ تِلْكَ اللَّيْلَةَ  النِّدَاءَ  عَبْدُ اللهِ بْنُ زَيْدٍ  رَجُلٌ مِنَ  الْأَنْصَارِ  وَعُمَرُ بْنُ الْخَطَّابِ  فَطَرَقَ الْأَنْصَارِيُّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيْلًا ، فَأَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِلَالًا  فَأَذَّنَ بِهِ  "" .","","Al-Mu'jam al-Kabir 13140","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سالم عن ابن عمر"
"13177","13141  -  حَدَّثَنَا  أَبُو شُبَيْلٍ عُبَيْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ وَاقِدٍ ،  ثَنَا  أَبِي  ،  ثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ ،  عَنْ  سُلَيْمَانَ بْنِ أَرْقَمَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  قَرَأَ رَجُلَانِ مِنَ  الْأَنْصَارِ  سُورَةً ، أَقْرَأَهُمَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَكَانَا يَقْرَآنِ بِهَا ، فَقَامَا ذَاتَ لَيْلَةٍ يُصَلِّيَانِ فَلَمْ يَقْدِرَا مِنْهَا عَلَى حَرْفٍ ، فَأَصْبَحَا غَادِيَيْنِ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَا لَهُ ذَلِكَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّهَا مِمَّا نُسِخَ وَأُنْسِيَ ، فَالْهَوْا عَنْهَا  فَكَانَ  الزُّهْرِيُّ  يَقْرَؤُهَا ،         {      مَا نَنْسَخْ مِنْ آيَةٍ أَوْ نُنْسِهَا         }      بِضَمِّ النُّونِ خَفِيفَةً  .","","Al-Mu'jam al-Kabir 13141","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سليمان بن أرقم الانصارى عن عباس بن الفضل الواقفي عن عبد الرحمن بن واقد الواقدي عن عبيد الله بن أبي مسلم الواقدي عن الطبراني","سالم عن ابن عمر"
"13178","13142  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  بِشْرُ بْنُ مَنْصُورٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  كَانَتْ أَكْثَرُ أَيْمَانِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا ، وَمُصَرِّفِ الْقُلُوبِ  "" .","","Al-Mu'jam al-Kabir 13142","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عبد الرحمن بن إسحاق العامري عن بشر بن منصور السليمي عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سالم عن ابن عمر"
"13179","[12/289]      13143  -  حَدَّثَنَا  جَعْفَرُ بْنُ أَحْمَدَ بْنِ سِنَانٍ الْوَاسِطِيُّ  ، ثَنَا  أَزْهَرُ بْنُ جَمِيلٍ ،  ثَنَا  إِسْحَاقُ بْنُ عِيسَى ابْنُ بِنْتِ دَاوُدَ أَبِي هِنْدٍ ،  ثَنَا  زَمْعَةُ بْنُ صَالِحٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  مَا حُمِلَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأْسٌ قَطُّ  ، وَلَا  يَوْمَ بَدْرٍ  إِلَى  الْمَدِينَةِ  "" .","","Al-Mu'jam al-Kabir 13143","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن زمعة بن صالح الجندي عن إسحاق بن عيسى القشيري عن أزهر بن جميل الشطي عن جعفر بن أحمد بن سنان الواسطي عن الطبراني","سالم عن ابن عمر"
"13180","13144  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُعَاوِيَةَ النَّيْسَابُورِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عُقَيْلٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَمَرَ بِحَدِّ الشِّفَارِ  ، وَأَنْ يُوَارَى عَنِ الْبَهَائِمِ  "" .","","Al-Mu'jam al-Kabir 13144","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عقيل بن خالد الأيلي عن عبد الله بن لهيعة عن محمد بن معاوية بن أعين النيسابوري عن محمد بن علي بن زيد الصائغ عن الطبراني","سالم عن ابن عمر"
"13181","13145  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ  ، ثَنَا  وَهْبُ بْنُ يَحْيَى بْنِ زِمَامٍ الْعَلَّافُ ،  ثَنَا  مَيْمُونُ بْنُ زَيْدٍ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدٍ ،  عَنْ  مَنْصُورِ بْنِ دِينَارٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّهُ : سُئِلَ عَنِ  الْمُتْعَةِ  فَقَالَ : حَرَامٌ فَقِيلَ : إِنَّ  ابْنَ عَبَّاسٍ  لَا يَرَى بِهَا بَأْسًا فَقَالَ : أَمَا وَاللهِ لَقَدْ عَلِمَ  ابْنُ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْهَا  يَوْمَ حُنَيْنٍ  وَمَا كُنَّا مُسَافِحِينَ  "" .","","Al-Mu'jam al-Kabir 13145","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن منصور بن دينار التميمي عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن ميمون بن زيد الحارثي عن وهب بن يحيى بن زمام العلاف عن محمد بن صالح النرسي عن الطبراني","سالم عن ابن عمر"
"13182","13146  -  حَدَّثَنَا  عَمْرُو بْنُ الطَّاهِرِ بْنِ أَبِي السَّرْحِ ، وَإِسْحَاقُ         [12/290]      بْنُ إِبْرَاهِيمَ الْقَطَّانُ الْمِصْرِيَّانِ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  الْمُغِيرَةُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنِ  الضَّحَّاكِ ،  عَنْ  نَافِعٍ ،  عَنْ  سَالِمٍ  أَنَّهُ ، سَمِعَ  عَبْدَ اللهِ بْنَ عُمَرَ  قَالَ :  مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  بِابْنِ صَيَّادٍ  وَهُوَ يَلْعَبُ مَعَ الصِّبْيَانِ فَضَرَبَهُ بِقَدَمِهِ فَقَالَ :  أَتَشْهَدُ أَنِّي رَسُولُ اللهِ ؟  فَقَالَ  ابْنُ صَيَّادٍ  : أَشْهَدُ أَنَّكَ رَسُولُ الْأُمِّيِّينَ ، قَالَ : أَفَتَشْهَدُ أَنِّي رَسُولُ اللهِ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" آمَنْتُ بِاللهِ وَرَسُولِهِ  "" .","","Al-Mu'jam al-Kabir 13146","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن الضحاك بن عثمان الحزامي عن المغيرة بن عبد الرحمن بن عبد الله الحزامي عن يحيى بن عبد الله بن بكير المخزومي عن إسحاق بن إبراهيم بن جابر التجيبي عن الطبراني","سالم عن ابن عمر"
"13183","13147  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  جُنَادَةُ بْنُ سَلْمٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  رَأَيْتُ امْرَأَةً سَوْدَاءَ  ثَائِرَةَ  الرَّأْسِ خَرَجَتْ مِنَ  الْمَدِينَةِ  حَتَّى قَامَتْ  بِمَهْيَعَةَ  وَهِيَ  الْجُحْفَةُ  "" فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" تَأَوَّلْتُ أَنَّ  وَبَاءَ  الْمَدِينَةِ  نُقِلَ إِلَى  الْجُحْفَةِ  "" .","","Al-Mu'jam al-Kabir 13147","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن جنادة بن سلم العامري عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","سالم عن ابن عمر"
"13184","13148  -  وَبِإِسْنَادِهِ  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَنَّهُ مَرَّ  بِابْنِ صَيَّادٍ  وَهُوَ يَلْعَبُ مَعَ الصِّبْيَانِ ، فَضَرَبَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِقَدَمِهِ ، فَقَالَ :  أَتَشْهَدُ أَنِّي رَسُولُ اللهِ ؟  قَالَ  ابْنُ صَيَّادٍ  : أَشْهَدُ أَنَّكَ رَسُولُ الْأُمِّيِّينَ ، فَقَالَ لَهُ  ابْنُ صَيَّادٍ  : أَتَشْهَدُ أَنِّي رَسُولُ اللهِ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" آمَنْتُ بِاللهِ وَرُسُلِهِ  "" .","","Al-Mu'jam al-Kabir 13148","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن جنادة بن سلم العامري عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","سالم عن ابن عمر"
"13185","[12/291]      13149  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ الْعَبَّادِيُّ الْبَصْرِيُّ ،  ثَنَا  مُسْلِمُ بْنُ سَالِمٍ الْجُهَنِيُّ ،  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ جَاءَنِي زَائِرًا لَا يَعْلَمُهُ حَاجَةً إِلَّا زِيَارَتِي  كَانَ حَقًّا عَلَيَّ أَنْ أَكُونَ لَهُ شَفِيعًا يَوْمَ الْقِيَامَةِ  "" .","","Al-Mu'jam al-Kabir 13149","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن مسلم بن سالم الجهني عن عبد الله بن محمد العبادي البصري عن عبد الله بن أحمد الجواليقي عن الطبراني","سالم عن ابن عمر"
"13186","13150  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ         [12/292]      الْعَبَّادِيُّ ،  ثَنَا  مُسْلِمُ بْنُ سَالِمٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحِجَامَةُ فِي الرَّأْسِ مِنَ الْجُنُونِ  ، وَالْجُذَامِ ، وَالْبَرَصِ ، وَالنُّعَاسِ ، وَالضَّرَسِ  "" .","","Al-Mu'jam al-Kabir 13150","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن مسلم بن سالم الجهني عن عبد الله بن محمد العبادي عن عبد الله بن أحمد الجواليقي عن الطبراني","سالم عن ابن عمر"
"13187","13151  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  الْحَسَنُ بْنُ يَحْيَى الرُّزِّيُّ ،  ثَنَا  عَاصِمُ بْنُ مِهْجَعٍ ،  ثَنَا  مَسْلَمَةُ بْنُ سَالِمٍ ،  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنِي  نَافِعٌ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  جَاءَ  غُلَامٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنِّي أُرِيدُ هَذِهِ النَّاحِيَةَ  الْحَجَّ  قَالَ : فَمَشَى مَعَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَالَ :  يَا غُلَامُ  زَوَّدَكَ  اللهُ التَّقْوَى  ، وَوَجَّهَكَ فِي الْخَيْرِ ، وَكَفَاكَ الْهَمَّ "" ، فَلَمَّا رَجَعَ الْغُلَامُ سَلَّمَ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَرَفَعَ رَأْسَهُ إِلَيْهِ ، وَقَالَ : "" يَا غُلَامُ ، قَبِلَ حَجَّكَ ، وَكَفَّرَ ذَنْبَكَ ، وَأَخْلَفَ نَفَقَتَكَ  "" .","","Al-Mu'jam al-Kabir 13151","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن مسلم بن سالم الجهني عن عاصم بن مهجع الأسدي عن الحسن بن يحيى الرزي عن عبد الله بن أحمد الجواليقي عن الطبراني","سالم عن ابن عمر"
"13188","13152  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ نَافِعٍ الْمِصْرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  قَرَأْتُ عَلَى  عَبْدِ اللهِ بْنِ نَافِعٍ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ أَنَّ  سَالِمًا  أَخْبَرَهُ  أَنَّ أَبَاهُ  أَخْبَرَهُ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قِيلَ لَهُ وَهُوَ  بِالْمُعَرَّسِ مُعَرَّسِ الشَّجَرَةِ  :  سَلْ فَإِنَّهَا بَطْحَاءُ  مَكَّةَ  مُبَارَكَةٌ  "" .","","Al-Mu'jam al-Kabir 13152","","عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن عاصم بن عمر بن حفص بن عاصم بن عمر بن الخطاب عن عبد الله بن نافع الصائغ عن أحمد بن صالح المصري عن أحمد بن محمد بن نافع الطحاوي عن الطبراني","سالم عن ابن عمر"
"13189","[12/293]      13153  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ،  ثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِي بَكْرِ بْنِ سَالِمٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا بَنَى اللهُ لَهُ بَيْتًا فِي النَّارِ  "" .","","Al-Mu'jam al-Kabir 13153","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن أبو بكر بن سالم بن عبد الله بن عمر بن الخطاب عن عبيد الله بن عمر العمري عن الفضيل بن عياض عن قتيبة بن سعيد عن موسى بن هارون الحمال عن الطبراني","سالم عن ابن عمر"
"13190","13154  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ، وَأَبُو أُسَامَةَ ، قَالَا :  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  أَبِي بَكْرِ بْنِ سَالِمٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  : أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  "" .","","Al-Mu'jam al-Kabir 13154","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن أبو بكر بن سالم بن عبد الله بن عمر بن الخطاب عن عبيد الله بن عمر العمري عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سالم عن ابن عمر"
"13191","13155  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَمْرُو بْنُ عَوْنٍ الْوَاسِطِيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  سَمِعْتُ  عُبَيْدَ اللهِ بْنَ عُمَرَ ،  يُحَدِّثُ عَنْ  أَبِي بَكْرِ بْنِ سَالِمٍ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  رَأَيْتُ فِي النَّوْمِ أَنِّي أُعْطِيتُ  عُسًّا  مَمْلُوءًا لَبَنًا  فَشَرِبْتُ مِنْهُ حَتَّى تَمَلَّأْتُ حَتَّى رَأَيْتُهُ يَجْرِي فِي عُرُوقِي بَيْنَ الْجِلْدِ وَاللَّحْمِ ، فَفَضَلَتْ فَضْلَةٌ وَأَعْطَيْتُهَا  عُمَرَ بْنَ الْخَطَّابِ  ، فَأَوِّلُوهَا "" ، قَالُوا : يَا نَبِيَّ اللهِ ، هَذَا عِلْمٌ أَعْطَاكَ اللهُ فَمَلَأَكَ مِنْهُ ، فَفَضَلَتْ         [12/294]      فَضْلَةٌ فَأَعْطَيْتَهَا  عُمَرَ بْنَ الْخَطَّابِ  ، فَقَالَ : "" أَصَبْتُمْ  "" .","","Al-Mu'jam al-Kabir 13155","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن أبو بكر بن سالم بن عبد الله بن عمر بن الخطاب عن عبيد الله بن عمر العمري عن معتمر بن سليمان عن عمرو بن عون الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سالم عن ابن عمر"
"13192","13156  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ ، قَالَ :  قُلْتُ  لِإِدْرِيسَ بْنِ عِيسَى الْقَطَّانِ ،  حَدَّثَكُمْ  مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ  عَنْ  أَبِي بَكْرِ بْنِ سَالِمٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا بَيْنَ قَبْرِي وَمِنْبَرِي رَوْضَةٌ مِنْ رِيَاضِ الْجَنَّةِ  ، وَمِنْبَرِي عَلَى حَوْضِي  فَأَخْرَجَ أَصْلَهُ وَقَالَ : قَدْ كَتَبْتُهُ عَنْ  مُحَمَّدِ بْنِ بِشْرٍ  .","","Al-Mu'jam al-Kabir 13156","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن أبو بكر بن سالم بن عبد الله بن عمر بن الخطاب عن عبيد الله بن عمر العمري عن محمد بن بشر بن الفرافصة عن إدريس بن عيسى القطان عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","سالم عن ابن عمر"
"13193","13157  -  حَدَّثَنَا  سَلَامَةُ بْنُ نَاهِضٍ الْمَقْدِسِيُّ  ، ثَنَا  الْوَلِيدُ بْنُ عُتْبَةَ الدِّمَشْقِيُّ (  ح  ) .  وَحَدَّثَنَا  مَحْمُودُ بْنُ عَلِيٍّ الْأَصْبَهَانِيُّ  ، ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ أَبِي بَكْرٍ السَّالِمِيُّ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ نَافِعٍ ،  حَدَّثَنِي  عَاصِمُ بْنُ عُمَرَ ،  عَنْ  بِلَالِ بْنِ أَبِي بَكْرٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ مُسْكِرٍ خَمْرٌ  وَكُلُّ مُسْكِرٍ حَرَامٌ  "" .","","Al-Mu'jam al-Kabir 13157","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن بلال بن أبى بكر عن عاصم بن عمر بن حفص بن عاصم بن عمر بن الخطاب عن عبد الله بن نافع الصائغ عن أحمد بن محمد بن أبي بكر السالمي عن محمود بن علي بن مالك الشيباني عن الطبراني","سالم عن ابن عمر"
"13194","[12/295]      13158  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  شُعَيْبُ بْنُ يَحْيَى التُّجِيبِيُّ ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  سَالِمٍ أَبِي النَّضْرِ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الْكَلْبَ لَيُنْقِصُ كُلَّ يَوْمٍ قِيرَاطَيْنِ  إِلَّا كَلْبَ  ضَارٍ  يَصِيدُ أَوْ كَلْبَ غَنَمٍ  "" .  قَالَ أَبُو الْقَاسِمِ :  يُنْقِصُ يَعْنِي مِنْ أَجْرِ صَاحِبِهِ  .","","Al-Mu'jam al-Kabir 13158","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن سالم بن أبي أمية التيمي عن عبد الله بن لهيعة عن شعيب بن يحيى التجيبي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","سالم عن ابن عمر"
"13195","13159  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  أَبُو النَّضْرِ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ مِنَ الْعِنَبِ خَمْرًا  ، وَمِنَ الزَّبِيبِ خَمْرًا ، وَمِنَ التَّمْرِ خَمْرًا ، وَمِنَ الْحِنْطَةِ خَمْرًا ، وَأَنَا أَنْهَى عَنْ كُلِّ مُسْكِرٍ  "" .","","Al-Mu'jam al-Kabir 13159","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن سالم بن أبي أمية التيمي عن عبد الله بن لهيعة عن عثمان بن صالح بن صفوان عن يحيى بن عثمان بن صالح عن الطبراني","سالم عن ابن عمر"
"13196","13160  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ الْحَجَّاجِ بْنِ رِشْدِينَ بْنِ سَعْدٍ الْمِصْرِيُّ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ مَرْوَانَ ،  عَنْ  مُوسَى بْنِ عُمَرَ بْنِ قُدَامَةَ  ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا مَاتَ مَيِّتٌ قَالَ :  قَدِّمُوهُ عَلَى  فَرَطِنَا  ، نِعْمَ  الْفَرَطُ  لِأُمَّتِي  عُثْمَانُ بْنُ مَظْعُونٍ  "" .  كذا في طبعة مكتبة ابن تيمية والنسخ الخطية ، ولعل الصواب : (قدامة بن موسى بن عمر بن قدامة) والله أعلم .","","Al-Mu'jam al-Kabir 13160","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن قدامة بن موسى الجمحي عن عبد الملك بن مروان بن الحكم عن عمرو بن الحارث بن يعقوب عن رشدين بن سعد المهري عن حجاج بن رشدين المصري عن محمد بن الحجاج بن رشدين المهري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","سالم عن ابن عمر"
"13197","[12/296]      13161  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ أَنَّ بُكَيْرَ بْنَ عَبْدِ اللهِ بْنِ الْأَشَجِّ ،  حَدَّثَهُ  أَنَّ عَبْدَ الْمَلِكِ بْنَ عَبْدِ الرَّحْمَنِ ،  حَدَّثَهُ  ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اقْتُلُوا الْحَيَّاتِ  ، فَمَنْ وَجَدَ ذَا  الطُّفْيَتَيْنِ  وَالْأَبْتَرَ فَلَمْ يَقْتُلْهُمَا فَلَيْسَ مِنَّا ، فَإِنَّهُمَا اللَّذَانِ يَخْطِفَانِ الْبَصَرَ وَيُسْقِطَانِ مَا فِي بُطُونِ النِّسَاءِ  "" .","","Al-Mu'jam al-Kabir 13161","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبد الملك بن عبد الرحمن عن بكير بن عبد الله بن الأشج القرشي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","سالم عن ابن عمر"
"13198","13162  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ أَحْمَدَ بْنِ عُمَرَ الْوَكِيعِيُّ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  يَزِيدُ بْنُ عِيَاضٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُحَمَّدِ بْنِ سَعْدٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا  حَسَدَ  إِلَّا فِي اثْنَتَيْنِ :  رَجُلٌ عَلَّمَهُ اللهُ الْقُرْآنَ وَهُوَ يَقُومُ بِهِ آنَاءَ اللَّيْلِ ، وَآنَاءَ النَّهَارِ ، وَرَجُلٌ أَعْطَاهُ اللهُ مَالًا فَهُوَ يُنْفِقُهُ آنَاءَ اللَّيْلِ ، وَآنَاءَ النَّهَارِ  "" .","","Al-Mu'jam al-Kabir 13162","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن إسماعيل بن محمد بن سعد عن يزيد بن عياض بن جعدبة الليثي عن شيبان بن فروخ الحبطي عن إبراهيم بن أحمد بن عمر الوكيعي عن الطبراني","سالم عن ابن عمر"
"13199","13163  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  خَلَفُ بْنُ سَالِمٍ ، وَزُهَيْرُ بْنُ حَرْبٍ ، قَالَا :  ثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  كَانَتْ يَمِينُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا وَمُقَلِّبِ الْقُلُوبِ  "" .","","Al-Mu'jam al-Kabir 13163","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن الحسن بن علي بن شبيب المعمري عن الطبراني","سالم عن ابن عمر"
"13200","13164  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْمُخَرِّمِيُّ  ، ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  ثَنَا  وُهَيْبٌ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :         [12/297]      كَانَتْ يَمِينُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا وَمُقَلِّبِ الْقُلُوبِ  "" .","","Al-Mu'jam al-Kabir 13164","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن وهيب بن خالد الكرابيسي عن عفان بن مسلم الصفار عن يعقوب بن إسحاق البيهسي عن الطبراني","سالم عن ابن عمر"
