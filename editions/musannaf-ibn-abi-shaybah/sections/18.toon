"17284","(۱۷۲۸۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ {وَلاَ یُبْدِینَ زِینَتَہُنَّ} قَالَ : مَا فَوْقَ الدِّرْعِ إلاَّ مَا ظَہَرَ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 17284","","","كتاب النكاح"
"17285","(۱۷۲۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ إبْرَاہِیمَ قَالَ : الثِّیَابُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17285","","","كتاب النكاح"
"17286","(۱۷۲۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ قَالَ ، الْکُحْلُ وَالثِّیَابُ۔","","Musannaf Ibn Abi Shaybah 17286","","","كتاب النكاح"
"17287","(۱۷۲۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أُمِّ شَبِیبٍ ، عَنْ عَائِشَۃَ قَالَتْ : الْقُلْبُ وَالْفَتْخَۃُ۔",": Sahih","Musannaf Ibn Abi Shaybah 17287","","","كتاب النكاح"
"17288","(۱۷۲۸۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ مَاہَانَ : إلاَّ مَا ظَہَرَ مِنْہَا ، قَالَ : الثِّیَابُ۔","","Musannaf Ibn Abi Shaybah 17288","","","كتاب النكاح"
"17289","(۱۷۲۸۹) حَدَّثَنَا مُعْتَمر ، عَنْ یُونُسَ ، عَنِ ابْنِ شِہَابٍ ، عَنِ الْحَسَنِ قَالَ : الْوَجْہُ وَالثِّیَابُ۔","","Musannaf Ibn Abi Shaybah 17289","","","كتاب النكاح"
"17290","(۱۷۲۹۰) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ قَالَ : حدَّثَنَا ہِشَامُ بْنُ الْغَازِ قَالَ : حدَّثَنَا نَافِعٌ عن ابْنِ عُمَرَ قَالَ : الزِّینَۃُ الظَّاہِرَۃُ: الْوَجْہُ وَالْکَفَّانِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17290","","","كتاب النكاح"
"17291","(۱۷۲۹۱) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ قَالَ : حدَّثَنَا ہِشَامُ بْنُ الْغَازِ ، قَالَ : سَمِعْتُ عَطَائً یَقُولُ : الزِّینَۃُ الظَّاہِرَۃُ : الْخِضَابُ وَالْکُحْلُ۔","","Musannaf Ibn Abi Shaybah 17291","","","كتاب النكاح"
"17292","(۱۷۲۹۲) حَدَّثَنَا شَبَابَۃُ ، عَنْ ہِشَامٍ ، قَالَ : سَمِعْتُ مَکْحُولاً یَقُولُ : الزِّینَۃُ الظَّاہِرَۃُ : الْوَجْہُ وَالْکَفَّانِ۔","","Musannaf Ibn Abi Shaybah 17292","","","كتاب النكاح"
"17293","(۱۷۲۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ قَالَ : الثِّیَابُ۔","","Musannaf Ibn Abi Shaybah 17293","","","كتاب النكاح"
"17294","(۱۷۲۹۴) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا سَعِیدُ بْنُ زَیْدٍ قَالَ : حدَّثَنَا عَطَائُ بْنُ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ : {وَلاَ یُبْدِینَ زِینَتَہُنَّ إلاَّ مَا ظَہَرَ مِنْہَا} الْخَاتَمُ وَالْخِضَابُ وَالْکُحْلُ۔","","Musannaf Ibn Abi Shaybah 17294","","","كتاب النكاح"
"17295","(۱۷۲۹۵) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا سَعِیدُ بْنُ زَیْدٍ قَالَ : حدَّثَنَا لَیْثٌ ، عَنْ مُجَاہِدٍ قَالَ : الْخِضَابُ وَالْکُحْلُ۔","","Musannaf Ibn Abi Shaybah 17295","","","كتاب النكاح"
"17296","(۱۷۲۹۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ قَالَ: الزِّینَۃُ زِینَتَانِ : زِینَۃٌ ظَاہِرَۃٌ وَزِینَۃٌ بَاطِنَۃٌ لاَ یَرَاہَا إلاَّ الزَّوْجُ ، وَأَمَّا الزِّینَۃُ الظَّاہِرَۃُ فَالثِّیَابُ ، وَأَمَّا الزِّینَۃُ الْبَاطِنَۃُ فَالْکُحْلُ وَالسِّوَارُ وَالْخَاتَمُ۔","","Musannaf Ibn Abi Shaybah 17296","","","كتاب النكاح"
"17297","(۱۷۲۹۷) حَدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ : {وَلاَ یُبْدِینَ زِینَتَہُنَّ إلاَّ مَا ظَہَرَ مِنْہَا} قَالَ : وَجْہُہَا وَکَفُّہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17297","","","كتاب النكاح"
"17298","(۱۷۲۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلم ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : کَفُّہَا وَوَجْہُہَا۔","","Musannaf Ibn Abi Shaybah 17298","","","كتاب النكاح"
"17299","(۱۷۲۹۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَا سَلَمَۃُ بْنُ سَابُورَ ، عَنْ عَبْدِ الْوَارِثِ : {وَلاَ یُبْدِینَ زِینَتَہُنَّ إلاَّ مَا ظَہَرَ مِنْہَا} قَالَ : الْکَفُّ وَالْخَاتَمُ۔","","Musannaf Ibn Abi Shaybah 17299","","","كتاب النكاح"
"17300","(۱۷۳۰۰) حَدَّثَنَا أَحْمَدُ بْنُ بَشِیرٍ ، عَنِ ابْنِ شُبْرُمَۃَ ، عَنْ عِکْرِمَۃَ قَالَ : {مَا ظَہَرَ مِنْہَا} قَالَ : الْوَجْہُ وَثُغْرَۃُ النَّحْرِ۔","","Musannaf Ibn Abi Shaybah 17300","","","كتاب النكاح"
"17301","(۱۷۳۰۱) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی الْخَلِیلِ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ أُمِّ الْفَضْلِ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُحَرِّمُ الرَّضْعَۃُ وَالرَّضْعَتَانِ وَالْمَصَّۃُ وَالْمَصَّتَانِ۔\n(مسلم ۱۸۔ احمد ۶/۳۳۹)",": Sahih","Musannaf Ibn Abi Shaybah 17301","","","كتاب النكاح"
"17302","(۱۷۳۰۲) حَدَّثَنَا عَبْدَۃُ ، وَابْنُ نُمَیْرٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ الزُّبَیْرِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُحَرِّمُ الْمَصَّۃُ وَالْمَصَّتَانِ۔ (ابن حبان ۴۲۲۵۔ احمد ۴/۴)",": Sahih","Musannaf Ibn Abi Shaybah 17302","","","كتاب النكاح"
"17303","(۱۷۳۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ أَبِیہِ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّمَا الرَّضَاعَۃُ مِنَ الْمَجَاعَۃِ۔ (بخاری ۵۱۰۲۔ مسلم ۳۲)",": Sahih","Musannaf Ibn Abi Shaybah 17303","","","كتاب النكاح"
"17304","(۱۷۳۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ قَالَ : لاَ تُحَرِّمُ الغبقۃ وَلاَ الْغَبْقَتَانِ۔\n(بیہقی ۴۵۷)",": Sahih","Musannaf Ibn Abi Shaybah 17304","","","كتاب النكاح"
"17305","(۱۷۳۰۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ قَالَ : سَأَلْتُ ابْنَ الزُّبَیْرِ ، عَنِ الرَّضَاعِ ، فَقَالَ : لاَ تُحَرِّمُ الرَّضْعَۃُ وَلاَ الرَّضْعَتَانِ وَلاَ الثَّلاَثُ۔","","Musannaf Ibn Abi Shaybah 17305","","","كتاب النكاح"
"17306","(۱۷۳۰۶) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ حَنْظَلَۃَ ، عَنْ سَالِمٍ ، عَنْ زَیْدٍ قَالَ : لاَ تُحَرِّمُ الرَّضْعَۃُ وَلاَ الرَّضْعَتَانِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17306","","","كتاب النكاح"
"17307","(۱۷۳۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرِ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ قَالَ : یُحَرِّمُ مِنْہُ مَا فَتَقَ الأَمْعَائَ۔","","Musannaf Ibn Abi Shaybah 17307","","","كتاب النكاح"
"17308","(۱۷۳۰۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، قَالَ : قَالَ عَبْدُ اللہِ : إنَّمَا یُحَرِّمُ مِنَ الرَّضَاعِ مَا أَنْبَتَ اللَّحْمَ وَأَنْشَزَ الْعَظْمَ۔",": Sahih","Musannaf Ibn Abi Shaybah 17308","","","كتاب النكاح"
"17309","(۱۷۳۰۹) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ، قَالَ: قَالَ أَبُو مُوسَی: لاَ یُحَرِّمُ الرَّضَاعُ إلاَّ مَا أَنْبَتَ اللَّحْمَ وَالدَّمَ۔",": Da'if","Musannaf Ibn Abi Shaybah 17309","","","كتاب النكاح"
"17310","(۱۷۳۱۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ قَالَ : کَانَتْ عَائِشَۃُ إذَا أَرَادَتْ أَنْ یَدْخُلَ عَلَیْہَا أَحَدٌ أَمَرَتْ بِہِ فَأُرْضِعَ فَأَمَرَتْ أُمَّ کُلْثُومٍ أَنْ تُرْضِعَ سَالِمًا عَشْرَ رَضَعَاتٍ فَأَرْضَعَتْہُ ثَلاَثًا فَمَرِضَتْ ، فَکَانَ لاَ یَدْخُلُ عَلَیْہَا وَأَمَرَتْ فَاطِمَۃَ بِنْتَ عُمَرَ أَنْ تُرْضِعَ عَاصِمَ بْنَ سَعْدٍ مَوْلًی لَہُمْ عَشْرَ رَضَعَاتٍ ، فَأَرْضَعَتْہُ فَکَانَ یَدْخُلُ عَلَیْہَا۔ (عبدالرزاق ۱۳۹۲۹)",": Sahih","Musannaf Ibn Abi Shaybah 17310","","","كتاب النكاح"
"17311","(۱۷۳۱۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ قَتَادَۃَ قَالَ : کَتَبْتُ إلَی إبْرَاہِیمَ أَسْأَلُہُ ، عَنِ الرَّضَاعِ فَکَتَبَ إلَیَّ أَنَّ عَلِیًّا ، وَعَبْدَ اللہِ کَانَا یَقُولاَنِ : قَلِیلُہُ وَکَثِیرُہُ حَرَامٌ۔","","Musannaf Ibn Abi Shaybah 17311","","","كتاب النكاح"
"17312","(۱۷۳۱۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ ابْنُ مَسْعُودٍ : یُحَرِّمُ قَلِیلُ الرَّضَاعِ کَمَا یُحَرِّمُ کَثِیرُہُ ، وَقَالَ مُجَاہِدٌ : قَوْلُ ابْنِ مَسْعُودٍ أَحَبُّ إلَیَّ۔",": Da'if","Musannaf Ibn Abi Shaybah 17312","","","كتاب النكاح"
"17313","(۱۷۳۱۳) حَدَّثَنَا وَکِیعٌ عن سفیان ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَابِسٍ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ وسُئِلَ عَنِ المرأۃ تُرْضِعُ الصَّبِیَّ الرَّضْعَۃَ ، فَقَالَ : إذَا عقا الصَّبِیُّ حَرُمَتْ عَلَیْہِ ، وَمَا وَلَدَتْ۔",": Sahih","Musannaf Ibn Abi Shaybah 17313","","","كتاب النكاح"
"17314","(۱۷۳۱۴) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ حَنْظَلَۃَ ، عَنْ طَاوُوسٍ قَالَ : اشْتَرَطَ عَشْرَ رَضَعَاتٍ ثُمَّ قِیلَ : إنَّ الرَّضْعَۃَ الْوَاحِدَۃَ تُحَرِّمُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17314","","","كتاب النكاح"
"17315","(۱۷۳۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ قَالَ : الْحَکَمُ وَحَمَّادٌ قَالاَ : الْمَصَّۃُ تُحَرِّمُ۔","","Musannaf Ibn Abi Shaybah 17315","","","كتاب النكاح"
"17316","(۱۷۳۱۶) حَدَّثَنَا أَبُو خَالِدٍ الأحمر ، عَنْ حَجَّاجٍ ، عَنْ حَبِیبٍ ، عَنْ طَاوُوسٍ قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ ، فَقَالَ : الْمَرَّۃُ الْوَاحِدَۃُ تُحَرِّمُ۔","","Musannaf Ibn Abi Shaybah 17316","","","كتاب النكاح"
"17317","(۱۷۳۱۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ قَالَ : سَأَلْتُ ابن عمر ، فَقَالَ الْمَصَّۃُ الْوَاحِدَۃُ تُحَرِّمُ۔","","Musannaf Ibn Abi Shaybah 17317","","","كتاب النكاح"
"17318","(۱۷۳۱۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ ??َٔبِیہِ وَعن حُمَیْدٍ الأَعْرَجِ ، عَنْ مُجَاہِدٍ وعَمَّنْ سَمِعَ عَطَائً ، قَالَ زَمْعَۃُ : وَسَمِعْتُ عَمْرَو بْنَ دِینَارٍ یَقُولُ : قَالُوا : یُحَرِّمُ قَلِیلُ الرَّضَاعِ وَکَثِیرُہُ۔","","Musannaf Ibn Abi Shaybah 17318","","","كتاب النكاح"
"17319","(۱۷۳۱۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُرِیدَ عَلَی ابْنَۃِ حَمْزَۃَ بْنِ عَبْدِ الْمُطَّلِبِ ، فَقَالَ : إنَّہَا ابْنَۃُ أَخِی مِنَ الرَّضَاعَۃِ وَإِنَّہُ یَحْرُمُ مِنَ الرَّضَاعَۃِ مَا یَحْرُمُ مِنَ النَّسَبِ۔ (بخاری ۲۶۴۵۔ مسلم ۱۳ )",": Sahih","Musannaf Ibn Abi Shaybah 17319","","","كتاب النكاح"
"17320","(۱۷۳۲۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَلِیٍّ قَالَ : قُلْتُ : یَا رَسُولَ اللہِ مَا لَکَ تَنوَّقُ فِی قُرَیْشٍ وَتَدَعُنَا قَالَ : عِنْدَکُمْ شَیْئٌ ؟ قُلْتُ : نَعَمْ ، ابنْۃ حَمْزَۃَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّہَا لاَ تَحِلُّ لِی ، إنَّہَا بِنْتُ أَخِی مِنَ الرَّضَاعَۃِ۔ (مسلم ۱۱۔ احمد ۱/۸۲)",": Sahih","Musannaf Ibn Abi Shaybah 17320","","","كتاب النكاح"
"17321","(۱۷۳۲۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : أَتَانِی عَمِّی مِنَ الرَّضَاعَۃِ أَفْلَحُ بن أَبِی الْقُعَیْسِ یَسْتَأْذِنُ عَلَیَّ بَعْدَ مَا ضُرِبَ الْحِجَابُ فَأَبَیْتُ أَنْ آذَنَ لَہُ حَتَّی دَخَلَ عَلَیَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّہُ عَمُّک فَأْذَنِی لَہُ قالت : إنَّمَا أَرْضَعْتنِی الْمَرْأَۃُ وَلَمْ یُرْضِعْنِی الرَّجُلُ قَالَ : تَرِبَتْ یَدَاک، أَوْ یَمِینُک۔ (مسلم ۱۰۶۹۔ ابن ماجہ ۱۹۴۸)",": Sahih","Musannaf Ibn Abi Shaybah 17321","","","كتاب النكاح"
"17322","(۱۷۳۲۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ زَیْنَبَ بِنْتِ أُمِّ سَلَمَۃَ ، عَنْ أُمِّ سَلَمَۃَ أن أُمَّ حَبِیبَۃَ قَالَتْ : یَا رَسُولَ اللہِ ، ہَلْ لَکَ فِی أُخْتِی ابْنَۃِ أَبِی سُفْیَانَ ؟ قَالَ : إنَّہَا لاَ تَحِلُّ لِی قَالَتْ : فَإِنَّہُ قَدْ بَلَغَنِی أَنَّک تَخْطُبُ دُرَّۃَ بِنْتَ أَبِی سَلَمَۃَ قَالَ : بِنْتُ أَبِی سَلَمَۃَ ؟ قَالَتْ : نَعَمْ ، قَالَ : وَاللَّہِ إِنْ لَمْ تَکُنْ رَبِیبَتِی فِی حِجْرِی مَا حَلَّتْ لِی ، إنَّہَا ابْنَۃُ أَخِی مِنَ الرَّضَاعَۃِ ، أَرْضَعَتْنِی وَأَبَاہَا ثُوَیْبَۃُ فَلاَ تَعْرِضْنَ عَلَیَّ بَنَاتِکُنَّ وَلاَ أَخَوَاتِکُنَّ۔\n(بخاری ۵۱۰۶۔ مسلم ۱۰۷۲)","","Musannaf Ibn Abi Shaybah 17322","","","كتاب النكاح"
"17323","(۱۷۳۲۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ قَالَ : کَانَتْ عَائِشَۃُ تُحَرِّمُ مِنَ الرَّضَاعَۃِ مَا تُحَرِّمُ مِنَ الْوِلاَدَۃِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17323","","","كتاب النكاح"
"17324","(۱۷۳۲۴) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مُوسَی بْنِ أَیُّوبَ قَالَ : حدَّثَنِی عَمِّی إیَاسُ بْنُ عَامِرٍ ، قَالَ : قَالَ عَلِیٌّ : لاَ تَنْکِحْ مَنْ أَرْضَعَتْہُ امْرَأَۃُ أَخِیک وَلاَ امْرَأَۃُ أَبِیک وَلاَ امْرَأَۃُ ابْنِک۔",": Hasan","Musannaf Ibn Abi Shaybah 17324","","","كتاب النكاح"
"17325","(۱۷۳۲۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَحْرُمُ مِنَ الرَّضَاعَۃِ مَا یَحْرُمُ مِنَ النَّسَبِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17325","","","كتاب النكاح"
"17326","(۱۷۳۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ دَاوُدَ، عَنْ أَبِی مَعْشَرٍ، عَنْ إبْرَاہِیمَ قَالَ: یَحْرُمُ مِنَ الرَّضَاعَۃِ مَا یَحْرُمُ مِنَ النَّسَبِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17326","","","كتاب النكاح"
"17327","(۱۷۳۲۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبْدِ اللہِ بْنِ عُتْبَۃَ قَالَ : أُرَاہُ ، عَنْ عَبْدِ اللہِ قَالَ : یَحْرُمُ مِنَ الرَّضَاعَۃِ مَا یَحْرُمُ مِنَ النَّسَبِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17327","","","كتاب النكاح"
"17328","(۱۷۳۲۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ عِرَاکِ بْنِ مَالِکٍ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَحْرُمُ مِنَ الرَّضَاعَۃِ مَا یَحْرُمُ مِنَ النَّسَبِ۔ (مسلم ۹۔ ابن ماجہ ۱۹۳۷)",": Hasan","Musannaf Ibn Abi Shaybah 17328","","","كتاب النكاح"
"17329","(۱۷۳۲۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنْ إِبْرَاہِیمَ بن عَبْدِ الأَعْلَی ، قَالَ : سَمِعْتُ سُوَیْد بْنَ غَفَلَۃَ یَقُولُ : یَحْرُمُ مِنَ الرَّضَاعَۃِ مَا یَحْرُمُ مِنَ النَّسَبِ۔","","Musannaf Ibn Abi Shaybah 17329","","","كتاب النكاح"
"17330","(۱۷۳۳۰) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ أَنَّہُ قِیلَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ہَلْ لَکَ فِی بِنْتِ حَمْزَۃَ ؟ فَقَالَ : إنَّہَا لاَ تَحِلُّ لِی ، إنَّہَا ابْنَۃُ أَخِی مِنَ الرَّضَاعَۃِ۔ (بخاری ۴۲۵۱)",": Sahih","Musannaf Ibn Abi Shaybah 17330","","","كتاب النكاح"
"17331","(۱۷۳۳۱) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی الضُّحَی ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ مَسْعُودٍ قَالَ : لاَ رَضَاعَ إلاَّ مَا کَانَ فِی الْحَوْلَیْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17331","","","كتاب النكاح"
"17332","(۱۷۳۳۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ قَالَ عَبْدُ اللہِ لاَ رَضَاعَ إلاَّ مَا کَانَ فِی الْحَوْلَیْنِ۔","","Musannaf Ibn Abi Shaybah 17332","","","كتاب النكاح"
"17333","(۱۷۳۳۳) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ زُبَیْدٍ قَالَ قَالَ عَلِیٌّ : لاَ یُحَرِّمُ مِنَ الرَّضَاعِ إلاَّ مَا کَانَ فِی الْحَوْلَیْنِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17333","","","كتاب النكاح"
"17334","(۱۷۳۳۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ رَضَاعَ إلاَّ مَا کَانَ فِی الْحَوْلَیْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17334","","","كتاب النكاح"
"17335","(۱۷۳۳۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ رَضَاعَ بَعْدَ الْفِصَالِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17335","","","كتاب النكاح"
"17336","(۱۷۳۳۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ، عَنِ ابْنِ عُمَرَ، عَنْ عُمَرَ، قَالَ لاَ رَضَاعَ إلاَّ مَا کَانَ فِی الصِّغَرِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17336","","","كتاب النكاح"
"17337","(۱۷۳۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ عُمَرُ : لاَ رَضَاعَ بَعْدَ الْفِصَالِ۔",": Hasan","Musannaf Ibn Abi Shaybah 17337","","","كتاب النكاح"
"17338","(۱۷۳۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَنَابٍ ، عَنْ إسْمَاعِیلَ بْنِ رَجَائٍ ، عَنِ النَّزَّالِ بْنِ سَبْرَۃَ ، عَنْ عَلِیٍّ قَالَ : لاَ رَضَاعَ بَعْدَ الْفِصَالِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17338","","","كتاب النكاح"
"17339","(۱۷۳۳۹) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ یَحْیَی بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ، عَنْ جَدِّہِ أَنَّہُ سَأَلَ أُمَّ سَلَمَۃَ ، عَنِ الرَّضَاعِ ، فَقَالَتْ : لاَ رَضَاعَ إلاَّ مَا کَانَ فِی الْمَہْدِ قَبْلَ الْفِطَامِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17339","","","كتاب النكاح"
"17340","(۱۷۳۴۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ أَنَّ أَبَا ہُرَیْرَۃَ سُئِلَ عَنِ الرَّضَاعِ ، فَقَالَ : لاَ یُحَرِّمُ مِنَ الرَّضَاعِ إلاَّ مَا فَتَقَ الأَمْعَائَ ، وَکَانَ فِی الثَّدْیِ قَبْلَ الْفِطَامِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17340","","","كتاب النكاح"
"17341","(۱۷۳۴۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ حَجَّاج بْنِ حَجَّاج ، عَنْ أَبِی ہُرَیْرَۃَ بِمِثْلِہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17341","","","كتاب النكاح"
"17342","(۱۷۳۴۲) حَدَّثَنَا ابْنُ نُمَیْرٍ قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ حَجَّاج بْنِ حَجَّاج ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ بِمِثْلِہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17342","","","كتاب النكاح"
"17343","(۱۷۳۴۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، وَأَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ أَنَّ عَلْقَمَۃَ مَرَّ بِامْرَأَۃٍ وَہِیَ تُرْضِعُ صَبِیًّا لَہَا بَعْدَ الْحَوْلَیْنِ ، فَقَالَ : لاَ تسقیہ داء ک۔","","Musannaf Ibn Abi Shaybah 17343","","","كتاب النكاح"
"17344","(۱۷۳۴۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ قَالَ : إذَا فُطِمَ الصَّبِیُّ فَلاَ رَضَاعَ بَعْدَ الْفِطَامِ۔","","Musannaf Ibn Abi Shaybah 17344","","","كتاب النكاح"
"17345","(۱۷۳۴۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : لاَ یُحَرِّمُ مِنَ الرَّضَاعِ إلاَّ مَا کَانَ فِی الصِّغَرِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17345","","","كتاب النكاح"
"17346","(۱۷۳۴۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : لاَ رَضَاعَ إلاَّ مَا کَانَ فِی الْمَہْدِ ، وَإِلاَّ مَا أَنْبَتَ اللَّحْمَ وَالدَّمَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17346","","","كتاب النكاح"
"17347","(۱۷۳۴۷) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : مَا کَانَ مِنْ رضاع ، أَوْ سَعُوطٍ فِی السَّنَتَیْنِ فَہُوَ رَضَاعٌ ، وَمَا کَانَ بَعْدُ فَلَیْسَ بِرَضَاعٍ۔","","Musannaf Ibn Abi Shaybah 17347","","","كتاب النكاح"
"17348","(۱۷۳۴۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنِ عَبْدِ اللہِ وَحَسَنٍ ابْنَی مُحَمَّدٍ ، عَنْ أَبِیہِمَا أَنَّ عَلِیًّا قَالَ لابْنِ عَبَّاسٍ : أَمَا عَلِمْتَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی ، عَنِ الْمُتْعَۃِ وَعَنْ لُحُومِ الْحُمُرِ الأَہْلِیَّۃِ ؟۔\n(بخاری ۴۲۱۶۔ مسلم ۲۹)",": Sahih","Musannaf Ibn Abi Shaybah 17348","","","كتاب النكاح"
"17349","(۱۷۳۴۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنِ الرَّبِیعِ بْنِ سَبْرَۃَ الْجُہَنِیِّ ، عَنْ أَبِیہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی یَوْمَ الْفَتْحِ ، عَنْ مُتْعَۃِ النِّسَائِ۔ (مسلم ۲۶۔ ابوداؤد ۲۰۶۶)",": Sahih","Musannaf Ibn Abi Shaybah 17349","","","كتاب النكاح"
"17350","(۱۷۳۵۰) حَدَّثَنَا عَبْدَۃُ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُمَرَ ، عَنِ الرَّبِیعِ بْنِ سَبْرَۃَ ، عَنْ أَبِیہِ قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَائِمًا بَیْنَ الرُّکْنِ وَالْبَابِ وَہُوَ یَقُولُ : أَیُّہَا النَّاسُ ، إنِّی کُنْتُ قد أَذِنْتُ لَکُمْ فِی الاِسْتِمْتَاعِ، أَلاَ وَإِنَّ اللَّہَ حَرَّمَہَا إلَی یَوْمِ الْقِیَامَۃِ فَمَنْ کَانَ عِنْدَہُ مِنْہُنَّ شَیْئٌ فَلْیُخَلِّ سَبِیلَہُ وَلاَ تَأْخُذُوا مِمَّا آتَیْتُمُوہُنَّ شَیْئًا۔\n(مسلم ۲۵۔ ابن ماجہ ۱۹۶۲)",": Sahih","Musannaf Ibn Abi Shaybah 17350","","","كتاب النكاح"
"17351","(۱۷۳۵۱) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ زِیَادٍ قَالَ : حدَّثَنَا أَبُو الْعُمَیْسِ ، عَنْ إیَاسِ بْنِ سَلَمَۃَ ، عَنْ أَبِیہِ قَالَ : رَخَّصَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَامَ أَوْطَاسٍ فِی الْمُتْعَۃِ ثَلاَثًا ثُمَّ نَہَی عَنْہَا۔\n(مسلم ۱۸۔ احمد ۴/۵۵)",": Sahih","Musannaf Ibn Abi Shaybah 17351","","","كتاب النكاح"
"17352","(۱۷۳۵۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ عُمَرُ : لَوْ تَقَدَّمْتُ فِیہَا لَرَجَمْتُ یَعْنِی الْمُتْعَۃَ۔",": Sahih","Musannaf Ibn Abi Shaybah 17352","","","كتاب النكاح"
"17353","(۱۷۳۵۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : نَہَی عُمَرَ ، عَنْ مُتْعَتَیْنِ مُتْعَۃِ النِّسَائِ وَمُتْعَۃِ الْحَجِّ۔",": Sahih","Musannaf Ibn Abi Shaybah 17353","","","كتاب النكاح"
"17354","(۱۷۳۵۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ قَالَ : سُئِلَ عَنْ مُتْعَۃِ النِّسَائِ ، فَقَالَ : لاَ نَعْلَمُہَا إلاَّ السِّفَاحَ۔",": Sahih","Musannaf Ibn Abi Shaybah 17354","","","كتاب النكاح"
"17355","(۱۷۳۵۵) حَدَّثَنَا عَبدَۃ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ سُئِلَ عَنِ الْمُتْعَۃِ ، فَقَالَ : حرَامٌ فَقِیلَ لَہُ : إنَّ ابْنَ عَبَّاسٍ یُفْتِی بِہَا ، فَقَالَ : فَہَلاَّ تَزَمْزَمَ بِہَا فِی زَمَانِ عُمَرَ۔",": Sahih","Musannaf Ibn Abi Shaybah 17355","","","كتاب النكاح"
"17356","(۱۷۳۵۶) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّہُ قَالَ : رَحِمَ اللَّہُ عُمَرَ ، لَوْلاَ إِنَّہُ نَہَی ، عَنِ الْمُتْعَۃِ صَارَ الزِّنَا جِہَارًا۔",": Sahih","Musannaf Ibn Abi Shaybah 17356","","","كتاب النكاح"
"17357","(۱۷۳۵۷) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ قَالَ : وَاللَّہِ مَا کَانَتِ الْمُتْعَۃُ إلاَّ ثَلاَثَۃَ أَیَّامٍ أَذِنَ لَہُمْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِیہَا ، مَا کَانَتْ قَبْلَ ذَلِکَ وَلاَ بَعْدُ۔ (عبدالرزاق ۱۴۰۴۰)",": Hasan","Musannaf Ibn Abi Shaybah 17357","","","كتاب النكاح"
"17358","(۱۷۳۵۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حَدَّثَنِی عَبْدُ اللہِ بْنُ الْوَلِیدِ ، قَالَ : قَالَ لِی ابْنُ ذُؤَیبٍ : سَمِعْتُ ابْنَ الزُّبَیْرِ یَخْطُبُ وَہُوَ یَقُولُ : إنَّ الذِّئْبَ یُکَنَّی أَبَا جَعْدَۃَ ، أَلاَ وَإِنَّ الْمُتْعَۃَ ہِیَ الزِّنَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17358","","","كتاب النكاح"
"17359","(۱۷۳۵۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُمَرَ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ ، عَنِ طَاوُوسٍ قَالَ : کَانَتْ سُنَّۃُ الْمُتْعَۃِ سُنَّۃَ النِّکَاحِ إلاَّ أَنَّ الأَجَلَ کَانَ فِی أَیْدِیہِنَّ۔","","Musannaf Ibn Abi Shaybah 17359","","","كتاب النكاح"
"17360","(۱۷۳۶۰) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ : لَوْ أُتِیتُ بِرَجُلٍ تَمَتَّعَ بِامْرَأَۃٍ لَرَجَمْتُہُ إِنْ کَانَ أُحْصِنَ فَإِنْ کَانَ لَمْ یَکُنْ أُحْصِنَ ضَرَبْتُہُ۔","","Musannaf Ibn Abi Shaybah 17360","","","كتاب النكاح"
"17361","(۱۷۳۶۱) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ ہِشَامِ بْنِ الْغَازِ ، قَالَ : سَمِعْتُ مَکْحُولاً یَقُولُ فِی الرَّجُلِ یَتَزَوَّجُ الْمَرْأَۃَ إلَی أَجَلٍ قَالَ : ذَلِکَ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17361","","","كتاب النكاح"
"17362","(۱۷۳۶۲) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنْ قَیْسٍ ، عَنْ عَبْدِ اللہِ قَالَ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَنَحْنُ شَبَابٌ قَالَ فَقُلْنَا : یَا رَسُولَ اللہِ ، أَلاَ نَسْتَخْصِی ؟ قَالَ : لاَ ثُمَّ رَخَّصَ لَنَا أَنْ نَنْکِحَ الْمَرْأَۃَ بِالثَّوْبِ إلَی الأَجَلِ ثُمَّ قَرَأَ عَبْدُ اللہِ : {یَا أَیُّہَا الَّذِینَ آمَنُوا لاَ تُحَرِّمُوا طَیِّبَاتِ مَا أَحَلَّ اللَّہُ لَکُمْ}۔",": Sahih","Musannaf Ibn Abi Shaybah 17362","","","كتاب النكاح"
"17363","(۱۷۳۶۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ قَبِیصَۃَ بْنِ جَابِرٍ ، عَنْ عُمَرَ ، قَالَ : لاَ أُوتَی بِمُحِلٍّ وَلاَ مُحَلَّلٍ لَہُ إلاَّ رَجَمْتُہُمَا۔",": Sahih","Musannaf Ibn Abi Shaybah 17363","","","كتاب النكاح"
"17364","(۱۷۳۶۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عُمَرَ أَنَّہُ قَالَ : لَعَنَ اللَّہُ الْمُحِلَّ وَالْمُحَلَّلَ لَہُ وَالْمُحَلَّلَۃَ۔",": Da'if","Musannaf Ibn Abi Shaybah 17364","","","كتاب النكاح"
"17365","(۱۷۳۶۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ الْمُغِیرَۃِ بْنِ نَوْفَلٍ أَنَّ ابْنَ عُمَرَ سُئِلَ عَنْ تَحْلِیلِ الْمَرْأَۃِ لِزَوْجِہَا قَالَ : ذَلِکَ السِّفَاحُ ، لَوْ أَدْرَکَکُمْ عُمَرُ لَنَکَّلَکُمْ۔",": Sahih","Musannaf Ibn Abi Shaybah 17365","","","كتاب النكاح"
"17366","(۱۷۳۶۶) حَدَّثَنَا وَکِیعٌ ، عَنِ أَبِی شِہَابٍ ، عَنْ جَبَلَۃَ بْنِ دَعْلَجٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : الْمُحَلِّلُ مَلْعُونٌ۔","","Musannaf Ibn Abi Shaybah 17366","","","كتاب النكاح"
"17367","(۱۷۳۶۷) حَدَّثَنَا ہُشَیْمٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ وَعَنْ یُونُسَ، عَنِ الْحَسَنِ قَالاَ: إذَا ہَمَّ أَحَدُ الثَّلاَثَۃِ فَسَدَ النِّکَاحُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17367","","","كتاب النكاح"
"17368","(۱۷۳۶۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا ، عَنْ رَجُلٍ تَزَوَّجَ امْرَأَۃً لِیُحِلَّہَا لِزَوْجِہَا ، فَقَالَ الْحَکَمُ : یُمْسِکُہَا وَقَالَ حَمَّادٌ : أَحَبُّ إلَیَّ أَنْ یُفَارِقَہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17368","","","كتاب النكاح"
"17369","(۱۷۳۶۹) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً لِیُحِلَّہَا لِزَوْجِہَا وَہُوَ لاَ یَعْلَمُ قَالَ : لاَ یَصْلُحُ ذَلِکَ إذَا کَانَ تَزَوَّجَہَا لَیُحِلَّہَا۔","","Musannaf Ibn Abi Shaybah 17369","","","كتاب النكاح"
"17370","(۱۷۳۷۰) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ قَالَ : لُعِنَ الْمُحِلُّ وَالْمُحَلَّلُ لَہُ۔","","Musannaf Ibn Abi Shaybah 17370","","","كتاب النكاح"
"17371","(۱۷۳۷۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُزَیْلٍ ، عَنْ عَبْدِ اللہِ قَالَ : لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمُحِلَّ وَالْمُحَلَّلَ لَہُ۔ (ترمذی ۱۸۲۰۔ احمد ۱/۴۶۲)",": Sahih","Musannaf Ibn Abi Shaybah 17371","","","كتاب النكاح"
"17372","(۱۷۳۷۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ ، عَنِ جابر بْنِ عَبْدِ اللہِ ، عَنْ عَلِیٍّ قَالَ لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمُحِلَّ وَالْمُحَلَّلَ لَہُ۔ (ابوداؤد ۲۰۷۰۔ احمد ۱/۸۳)",": Da'if","Musannaf Ibn Abi Shaybah 17372","","","كتاب النكاح"
"17373","(۱۷۳۷۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مُوسَی بْنِ أَبِی الْفُرَاتِ ، عَنْ عَمْرِو بْنِ دِینَارٍ أنَّہُ سُئِلَ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَہُ فَجَائَ رَجُلٌ مِنْ أَہْلِ الْقَرْیَۃِ بِغَیْرِ عِلْمِہِ وَلاَ عِلْمِہَا فَأَخْرَجَ شَیْئًا مِنْ مَالِہِ فَتَزَوَّجَہَا بہ لِیُحِلَّہَا لَہُ ، فَقَالَ : لاَ ، ثُمَّ ذَکَرَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُئِلَ عَنْ مِثْلِ ذَلِکَ ، فَقَالَ : لاَ حَتَّی یَنْکِحَہَا مُرْتَغِِبًا لِنَفْسِہِ ، حَتَّی یَتَزَوَّجَہَا مُرْتَغِِبًا لِنَفْسِہِ ، فَإِذَا فَعَلَ ذَلِکَ لَمْ تَحِلَّ لَہُ حَتَّی یذُوقَ الْعُسَیْلَۃَ۔",": Da'if","Musannaf Ibn Abi Shaybah 17373","","","كتاب النكاح"
"17374","(۱۷۳۷۴) حَدَّثَنَا مُعَاذٌ قَالَ : حدَّثَنَا عَبَّادُ بْنُ مَنْصُورٍ قَالَ : جَائَ رَجُلٌ إلَی الْحَسَنِ ، فَقَالَ : إنَّ رَجُلاً مِنْ قَوْمِی طَلَّقَ امْرَأَتَہُ ثَلاَثًا فَنَدِمَ وَنَدِمَتْ ، فَأَرَدْتُ أَنْ أَنْطَلِقَ فَأَتَزَوَّجَہَا وَأَصْدُقَہَا صَدَاقًا ثُمَّ أَدْخُلَ بِہَا کَمَا یَدْخُلُ الرَّجُلُ بِامْرَأَتِہِ ، ثُمَّ أُطَلِّقَہَا حَتَّی تَحِلَّ لِزَوْجِہَا ، قَالَ ، فَقَالَ لَہُ الْحَسَنُ : اتَّقِ اللَّہَ یَا فَتَی وَلاَ تَکُونَنَّ مِسْمَارَ نَارٍ لِحُدُودِ اللہِ۔","","Musannaf Ibn Abi Shaybah 17374","","","كتاب النكاح"
"17375","(۱۷۳۷۵) حَدَّثَنَا الْمُعَلَّی بْنُ مَنْصُورٍ قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ جَعْفَرٍ ، عَنْ عُثْمَانَ بْنِ مُحَمَّدٍ الأَخْنَسِیِّ ، عَنِ الْمَقْبُرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمُحِلَّ وَالْمُحَلَّلَ لَہُ۔\n(ترمذی ۴۳۷۔ احمد ۲/۳۲۳)",": Hasan","Musannaf Ibn Abi Shaybah 17375","","","كتاب النكاح"
"17376","(۱۷۳۷۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ أَبِی السَّنَابِلِ قَالَ : وَضَعَتْ سُبَیْعَۃُ بِنْتُ الْحَارِثِ حَمْلَہَا بَعْدَ وَفَاۃِ زَوْجِہَا بِبِضْعٍ وَعِشْرِینَ لَیْلَۃً فَلَمَّا تَعَلَّتْ مِنْ نِفَاسِہَا تَشَوَّفَتْ فَعِیبَ ذَلِکَ عَلَیْہَا وَذُکِرَ أَمْرُہَا لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إِنْ تَفْعَلْ فَقَدْ مَضَی أَجَلُہَا۔\n(طبرانی ۸۹۶۔ دارمی ۲۲۸۱)","","Musannaf Ibn Abi Shaybah 17376","","","كتاب النكاح"
"17377","(۱۷۳۷۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یحیی بْنِ سَعِیدٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ أَبِی سَلَمَۃَ قَالَ : کُنْتُ أَنَا ، وَابْنُ عَبَّاسٍ ، وَأَبُو ہُرَیْرَۃَ فَتَذَاکَرْنَا : الرَّجُلُ یَمُوتُ ، عَنِ الْمَرْأَۃِ فَتَضَعُ بَعْدَ وَفَاتِہِ بِیَسِیرٍ فَقُلْتُ : إذَا وَضَعَتْ فَقَدْ حَلَّتْ وَقَالَ ابْنُ عَبَّاسٍ : أَجَلُہَا آخِرُ الأَجَلَیْنِ فَتَرَاجَعَا بِذَلِکَ ، فَقَالَ أَبُو ہُرَیْرَۃَ : أَنَا مَعَ ابْنِ أَخِی یَعْنِی أَبَا سَلَمَۃَ فَبَعَثُوا کُرَیْبًا مَوْلَی ابْنِ عَبَّاسٍ إلَی أُمِّ سَلَمَۃَ ، فَقَالَتْ : إنَّ سُبَیْعَۃَ الأَسْلَمِیَّۃَ وَضَعَتْ بَعْدَ وَفَاۃِ زَوْجِہَا بِأَرْبَعِینَ لَیْلَۃً ، وَإِنَّ رَجُلاً مِنْ بَنِی عَبْدِ الدَّارِ یُکَنَّی أَبَا السَّنَابِلِ خَطَبَہَا وَأَخْبَرَہَا أَنَّہَا قَدْ حَلَّتْ فَأَرَادَتْ أَنْ تَتَزَوَّجَ غَیْرَہُ ، فَقَالَ لَہَا أَبُو السَّنَابِلِ : إنَّک لَمْ تَحِلِّینَ فَذَکَرَتْ ذَلِکَ سُبَیْعَۃُ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَمَرَہَا أَنْ تَتَزَوَّجَ۔ (مسلم ۱۲۲۔ ترمذی ۱۱۲۳)",": Sahih","Musannaf Ibn Abi Shaybah 17377","","","كتاب النكاح"
"17378","(۱۷۳۷۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنِ الْمِسْوَرِ أَنَّ سُبَیْعَۃَ وَضَعَتْ بَعْدَ وَفَاۃِ زَوْجِہَا بِشَہْرٍ فَأَتَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَمَرَہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تَزَوَّجَ۔ (بخاری ۵۳۲۰۔ احمد ۴/۳۲۷)",": Sahih","Musannaf Ibn Abi Shaybah 17378","","","كتاب النكاح"
"17379","(۱۷۳۷۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، قَالَ : قَالَ : سَمِعْتُ رَجُلاً مِنَ الأَنْصَارِ یُحَدِّثُ ابْنَ عُمَرَ یَقُولُ : سَمِعْتُ أَبَاک یَقُولُ : لَوْ وَضَعَتِ الْمُتَوَفَّی عَنْہَا زَوْجُہَا ذَا بَطْنِہَا وَہُوَ عَلَی السَّرِیرِ فَقَدْ حَلَّتْ۔",": Sahih","Musannaf Ibn Abi Shaybah 17379","","","كتاب النكاح"
"17380","(۱۷۳۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ مَوْہَبٍ ، عَنْ صَالِحِ بْنِ کَیْسَانَ ، عَنْ عُمَرَ وَعُثْمَانَ قَالاَ : إذَا وَضَعَتْ وَہُوَ فِی جَانِبِ الْبَیْتِ فِی أَکْفَانِہِ فَقَدْ حَلَّتْ۔",": Da'if","Musannaf Ibn Abi Shaybah 17380","","","كتاب النكاح"
"17381","(۱۷۳۸۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّ عُمَرَ اسْتَشَارَ عَلِیَّ بْنَ أَبِی طَالِبٍ رضی اللہ عنہ وَزَیْدَ بْنَ ثَابِتٍ قَالَ زَیْدٌ : قدْ حَلَّتْ وَقَالَ عَلِیٌّ : أَرْبَعَۃَ أَشْہُرٍ وَعَشْرًا قَالَ زَیْدٌ: أَرَأَیْتَ إِنْ کَانَتْ یَئیسًا قَالَ عَلِیٌّ : فَآخِرُ الأَجَلَیْنِ قَالَ عُمَرُ : لَوْ وَضَعَتْ ذَا بَطْنِہَا وَزَوْجُہَا عَلَی نَعْشِہِ لَمْ یَدْخُلْ حُفْرَتَہُ لَکَانَتْ قَدْ حَلَّتْ۔","","Musannaf Ibn Abi Shaybah 17381","","","كتاب النكاح"
"17382","(۱۷۳۸۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ، عَنْ مُسْلِمٍ، عَنْ مَسْرُوقٍ، قَالَ: قَالَ عَبْدُ اللہِ: وَاللَّہِ مَنْ شَائَ لَقَاسَمْتُہُ لَنَزَلَتْ سُورَۃُ النِّسَائِ الْقُصْرَی بَعْدَ أَرْبَعَۃِ أَشْہُرٍ وَعَشْرًا۔ (ابوداؤد ۲۳۰۱۔ ابن ماجہ ۲۰۳۰)",": Sahih","Musannaf Ibn Abi Shaybah 17382","","","كتاب النكاح"
"17383","(۱۷۳۸۳) حَدَّثَنَا عبد الوہاب الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ أَنَّہُ قَالَ فِی الْمُتَوَفَّی عَنْہَا زَوْجُہَا وَہِیَ حَامِلٌ : إذَا وَضَعَتْ حَلَّتْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17383","","","كتاب النكاح"
"17384","(۱۷۳۸۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ : إذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ وَہِیَ حَامِلٌ ، أَوْ تُوُفِّیَ عَنْہَا فَإِنَّ أَجَلَہَا أَنْ تَضَعَ حَمْلَہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17384","","","كتاب النكاح"
"17385","(۱۷۳۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عَبْدُ اللہِ : أَجَلُ کُلِّ حَامِلٍ أَنْ تَضَعَ حَمْلَہَا قَالَ : وَکَانَ عَلِیٌّ یَقُولُ : آخِرُ الأَجَلَیْنِ۔","","Musannaf Ibn Abi Shaybah 17385","","","كتاب النكاح"
"17386","(۱۷۳۸۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ مُسْلِمٍ وَلَمْ یُذْکَرْ فِیہِ مَسْرُوقٌ ، عَنْ عَلِیٍّ أَنَّہُ کَانَ یَقُولُ : آخِرُ الأَجَلَیْنِ۔","","Musannaf Ibn Abi Shaybah 17386","","","كتاب النكاح"
"17387","(۱۷۳۸۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُطَرِّفٍ ، عَنْ عَمْرِو بْنِ سَالِمٍ قَالَ : قَالَ أُبَیُّ بْنُ کَعْبٍ : یَا رَسُولَ اللہِ ، إنَّ عِدَدًا مِنْ عِدَدِ النِّسَائِ لَمْ یُذْکَرْ فِی کِتَابِ اللہِ ، الصِّغَارُ وَالْکِبَارُ وَأُولاَتُ الأَحْمَالِ فَأَنْزَلَ اللَّہُ تَعَالَی : {وَاللاَّئِی یَئِسْنَ مِنَ الْمَحِیضِ مِنْ نِسَائِکُمْ إنِ ارْتَبْتُمْ فَعِدَّتُہُنَّ ثَلاَثَۃُ أَشْہُرٍ وَاللاَّئِی لَمْ یَحِضْنَ وَأُولاَتُ الأَحْمَالِ أَجَلُہُنَّ أَنْ یَضَعْنَ حَمْلَہُنَّ}۔ (حاکم ۴۹۲۔ ابن جریر ۱۴۱)","","Musannaf Ibn Abi Shaybah 17387","","","كتاب النكاح"
"17388","(۱۷۳۸۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ قَالَ : کُنْتُ فِی حَلْقَۃٍ فِیہَا عَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی قَالَ : فَقَالَ : آخِرُ الأَجَلَیْنِ قَالَ : فَذَکَرْتُ حَدِیثَ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، عَنْ سُبَیْعَۃَ قَالَ فَضمَزَ لِی أَصْحَابُہُ قَالَ: فَقُلْتُ : إنِّی لَجَرِیئٌ عَلَی عَبْدِ اللہِ بْنِ عُتْبَۃَ إِنْ کَذَبْتُ عَلَیْہِ وَہُوَ فِی نَاحِیَۃِ المَسْجِد۔\n(بخاری ۴۵۳۲۔ نسائی ۵۷۱۵)",": Da'if","Musannaf Ibn Abi Shaybah 17388","","","كتاب النكاح"
"17389","(۱۷۳۸۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ فِی الْحَامِلِ الْمُتَوَفَّی عَنْہَا زَوْجُہَا : عِدَّتُہَا آخِرُ الأَجَلَیْنِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17389","","","كتاب النكاح"
"17390","(۱۷۳۹۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنِ الزُّہْرِیِّ، عَنْ عُبَیْدِ اللہِ، عَنْ أَبِیہِ قَالَ: وَضَعَتْ سُبَیْعَۃُ بَعْدَ وَفَاۃِ زَوْجِہَا بِعِشْرِینَ، أَوْ بِشَہْرٍ ، أَوْ نَحْوِ ذَلِکَ فَمَرَّ بِہَا أَبُو السَّنَابِلِ بْنُ بَعْکَکٍ ، فَقَالَ : قَدْ تَصَنَّعْتِ لِلأَزْوَاجِ ؟ لاَ ، حَتَّی یَأْتِیَ عَلَیْک أَرْبَعَۃَ أَشْہُرٍ وَعَشْرًا فَأَتَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرَتْ ذَلِکَ لَہُ، فَقَالَ: قَدْ حَلَلْتِ لِلأَزْوَاجِ۔\n(بخاری ۵۳۱۹۔ بیہقی ۴۱۹)","","Musannaf Ibn Abi Shaybah 17390","","","كتاب النكاح"
"17391","(۱۷۳۹۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ وَعَمْرِو بْنِ عُتْبَۃَ أَنَّہُمَا کَتَبَا إلَی سُبَیْعَۃَ بِنْتِ الْحَارِثِ یَسْأَلاَنِہَا عَنْ أَمْرِہَا فَکَتَبَتْ إلَیْہِمَا أَنَّہَا وَضَعَتْ بَعْدَ وَفَاۃِ زَوْجِہَا بِخَمْسَۃٍ وَعِشْرِینَ لَیْلَۃً فَتَہَیَّأَتْ تَطْلُبُ الْخَیْرَ فَمَرَّ بِہَا أَبُو السَّنَابِلِ بْنُ بَعْکَکٍ ، فَقَالَ : قدْ أَسْرَعْتِ ، اعْتَدِّی آخِرَ الأَجَلَیْنِ أَرْبَعَۃَ أَشْہُرٍ وَعَشْرًا فَأَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقُلْتُ : یَا رَسُولَ اللہِ ، اسْتَغْفِرْ لِی ، فَقَالَ : وَمَا ذَاکِ ؟ فَأَخْبَرَتْہُ الْخَبَرَ ، فَقَالَ : إِنْ وَجَدْتِ زَوْجًا صَالِحًا فَتَزَوَّجِی۔ (بخاری ۵۳۱۹۔ مسلم ۱۱۲۲)",": Sahih","Musannaf Ibn Abi Shaybah 17391","","","كتاب النكاح"
"17392","(۱۷۳۹۲) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ عُبَیْدِ بْنِ الْحَسَنِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ مَعْقِلٍ قَالَ : شَہِدْتُ عَلِیًّا وَسَأَلَہُ رَجُلٌ عَنِ امْرَأَۃٍ تُوُفِّیَ عَنْہَا زَوْجُہَا وَہِیَ حَامِلٌ قَالَ : تَتَرَبَّصُ أَبْعَدَ الأَجَلَیْنِ ، فَقَالَ رَجُل إِنَّ ابْنَ مَسْعُودٍ: یَقُولُ تَسْفِی نَفْسَہَا ؟ فَقَالَ عَلِیٌّ : إنَّ فَرُّوخَ لاَ یَعْلَمُ۔",": Sahih","Musannaf Ibn Abi Shaybah 17392","","","كتاب النكاح"
"17393","(۱۷۳۹۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ أَنَّہُ سُئِلَ عَنْ رَجُلٍ تَزَوَّجَ امْرَأَۃً فَمَاتَ عَنْہَا وَلَمْ یَدْخُلْ بِہَا وَلَمْ یَفْرِضْ لَہَا صَدَاقًا ، فَقَالَ عَبْدُ اللہِ : لَہَا الصَّدَاقُ وَلَہَا الْمِیرَاثُ وَعَلَیْہَا الْعِدَّۃُ ، فَقَالَ مَعْقِلُ بْنُ یَسَارٍ : شَہِدْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی بِرْوَعَ بِنْتِ وَاشِقٍ مِثْلَ ذَلِکَ۔ (ابن ماجہ ۱۸۹۱۔ احمد ۴/۲۸۰)",": Sahih","Musannaf Ibn Abi Shaybah 17393","","","كتاب النكاح"
"17394","(۱۷۳۹۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ : مِثْلَہُ۔\n(ابوداؤد ۲۱۰۸۔ ابن ماجہ ۱۸۹۱)",": Sahih","Musannaf Ibn Abi Shaybah 17394","","","كتاب النكاح"
"17395","(۱۷۳۹۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ بِنَحْوٍ مِنْ حَدِیثِ ابْنِ مَہْدِیٍّ ، عَنْ فِرَاسٍ۔ (ترمذی ۱۱۴۵۔ ابوداؤد ۲۱۰۸)",": Sahih","Musannaf Ibn Abi Shaybah 17395","","","كتاب النكاح"
"17396","(۱۷۳۹۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ أن ابْنَ عُمَرَ زَوَّجَ ابْنًا لَہُ امْرَأَۃً مِنْ أَہْلِہِ ، فَتُوُفِّیَ قَبْلَ أَنْ یَدْخُلَ بِہَا ، وَلَمْ یُسَمِّ لَہَا صَدَاقًا ، فَطَلَبُوا إلَی ابْنِ عُمَرَ الصَّدَاقَ ، فَقَالَ : لَیْسَ لَہَا صَدَاقٌ ، فَأَبَوْا أَنْ یَرْضَوْا بِذَلِکَ، فَجَعَلُوا بَیْنَہُمْ زَیْدَ بْنَ ثَابِتٍ ، فَأَتَوْہُ فَقَالَ : لَیْسَ لَہَا صَدَاقٌ۔",": Sahih","Musannaf Ibn Abi Shaybah 17396","","","كتاب النكاح"
"17397","(۱۷۳۹۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ قَالَ قَالَ زَیْدُ بْنُ ثَابِتٍ تَرِثُ وَتَعْتَدُّ۔","","Musannaf Ibn Abi Shaybah 17397","","","كتاب النكاح"
"17398","(۱۷۳۹۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی الشَّعْثَائِ ، وَعَطَائٍ فِی الَّذِی یُفَوَّضُ إلَیْہِ فَیَمُوتُ قَبْلَ أَنْ یَفْرِضَ قَالاَ : لَہَا الْمِیرَاثُ وَلَیْسَ لَہَا صَدَاقٌ۔","","Musannaf Ibn Abi Shaybah 17398","","","كتاب النكاح"
"17399","(۱۷۳۹۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرو وَعَطَائِ بْنِ السَّائِبِ ، عَنْ عَبْدِ خَیْرٍ یُرَی أَنَّہُ عَنْ عَلِیٍّ قَالَ : لَہَا الْمِیرَاثُ وَلاَ صَدَاقَ لَہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17399","","","كتاب النكاح"
"17400","(۱۷۴۰۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ أَنَّ رَجُلاً بِالْمَدِینَۃِ تَزَوَّجَ امْرَأَۃً فَلَمْ یَفْرِضْ لَہَا وَلَمْ یَدْخُلْ بِہَا قَالُوا : لَہَا الْمِیرَاثُ وَلاَ مَہْرَ لَہَا وَقَالَ مَسْرُوقٌ : لاَ یَکُونُ مِیرَاثٌ حَتَّی یَکُونَ قَبْلَہُ مَہْرٌ۔","","Musannaf Ibn Abi Shaybah 17400","","","كتاب النكاح"
"17401","(۱۷۴۰۱) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَہَا نِصْفُ الصَّدَاقِ ، أَوِ الصَّدَاقُ ، شَکَّ أَبُو بَکْرٍ۔","","Musannaf Ibn Abi Shaybah 17401","","","كتاب النكاح"
"17402","(۱۷۴۰۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلْقَمَۃَ قَالَ : جَائَ رَجُلٌ إلَی ابْنِ مَسْعُودٍ ، فَقَالَ : إنَّ رَجُلاً مِنَّا تَزَوَّجَ امْرَأَۃً وَلَمْ یَفْرِضْ لَہَا وَلَمْ یُجَامِعْہَا حَتَّی مَاتَ ، فَقَالَ ابْنُ مَسْعُودٍ : مَا سُئِلْت عَنْ شَیْئٍ مُنْذُ فَارَقْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَشَدَّ عَلَیَّ مِنْ ہَذَا، سَلُوا غَیْرِی فَتَرَدَّدُوا فِیہَا شَہْرًا قَالَ: فَقَالَ: مَنْ أَسْأَلُ وَأَنْتُمْ أَخِیَّۃُ أَصْحَابِ مُحَمَّدٍ بِہَذَا الْبَلَدِ؟ فَقَالَ: سَأَقُولُ فِیہَا بِرَأْیِی فَإِنْ یَکُنْ صَوَابًا فَمِنَ اللہِ ، وَإِنْ یَکُنْ خَطَأً فَمِنِّی وَمِنَ الشَّیْطَانِ ، أَرَی أَنَّ لَہَا مَہْرَ نِسَائِہَا لاَ وَکْسَ وَلاَ شَطَطَ وَلَہَا الْمِیرَاثُ وَعَلَیْہَا عِدَّۃُ الْمُتَوَفَّی عَنْہَا زَوْجُہَا ، فَقَالَ: نَاسٌ مِنْ أَشْجَعَ : نَشْہَدُ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی مِثْلَ الَّذِی قَضَیْت فِی امْرَأَۃٍ مِنَّا یُقَالُ لَہَا بِرْوَعُ ابْنَۃُ وَاشِقٍ قَالَ : فَمَا رَأَیْتُ ابْنَ مَسْعُودٍ فَرِحَ بِشَیْئٍ مَا فَرِحَ یَوْمَئِذٍ بِہِ۔(ابن حبان ۴۱۰۱۔ حاکم ۱۸۰)",": Sahih","Musannaf Ibn Abi Shaybah 17402","","","كتاب النكاح"
"17403","(۱۷۴۰۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ قَالَ : تَزَوَّجَ ابْنٌ لِعَبْدِ اللہِ بْنِ عُمَرَ بِنْتًا لِعُبَیْدِ اللہِ بْنِ عُمَرَ کَانَتْ أُمُّہَا أَسْمَائَ بِنْتَ زَیْدِ بْنِ الْخَطَّابِ فَتُوُفِّیَ وَلَمْ یَکُنْ فَرَضَ لَہَا صَدَاقًا فَطَلَبُوا مِنْہُ الصَّدَاقَ وَالْمِیرَاثَ ، فَقَالَ ابْنُ عُمَرَ : لَہَا الْمِیرَاثُ وَلاَ صَدَاقَ لَہَا فَأَبَوْا ذَلِکَ عَلَی ابْنِ عُمَرَ فَجَعَلُوا بَیْنَہُمْ زَیْدَ بْنَ ثَابِتٍ ، فَقَالَ زَیْدٌ : لَہَا الْمِیرَاثُ وَلاَ صَدَاقَ لَہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 17403","","","كتاب النكاح"
"17404","(۱۷۴۰۴) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ عَبْدِ خَیْرٍ ، عَنْ عَلِیٍّ قَالَ : لَہَا الْمِیرَاثُ وَلاَ صَدَاقَ لَہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17404","","","كتاب النكاح"
"17405","(۱۷۴۰۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الَّتِی یُتَوَفَّی عَنْہَا زَوْجُہَا قَبْلَ أَنْ یَفْرِضَ لَہَا وَقَبْلَ أَنْ یَدْخُلَ بِہَا : أَنَّ لَہَا صَدَاقَ نِسَائِہَا وَیُحَدِّثُ بِذَلِکَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَعِدَّۃَ الْمُتَوَفَّی وَلَہَا الْمِیرَاثُ۔ (سعید بن منصور ۹۳۳۔ عبدالرزاق ۱۰۹۰۰)",": Hasan","Musannaf Ibn Abi Shaybah 17405","","","كتاب النكاح"
"17406","(۱۷۴۰۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَمَّنْ أَخْبَرَہُ ، عَنْ عَلِیٍّ قَالَ : لَہَا الْمِیرَاثُ وَلاَ صَدَاقَ لَہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17406","","","كتاب النكاح"
"17407","حدثنا أبو عبد الرحمن بقی بن مخلد ، قَالَ : حدثنا أبو بکر عبد اللہ بن محمد بن أبی شیبۃ ، قال:\n(۱۷۴۰۷) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ قَالَ : أَخْبَرَنَا رَبِیعَۃُ بن عُثْمَانَ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، عَنْ نَہَارٍ الْعَبْدِیِّ، وَکَانَ مِنْ أَصْحَابِ أَبِی سَعِیدٍ الْخُدْرِیِّ ، عَنْ أَبِی سَعِیدٍ أَنَّ رَجُلاً أَتَی بِابْنَۃٍ لَہُ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّ ابْنَتِی ہَذِہِ أَبَتْ أَنْ تَتَزَوَّجَ قَالَ ، فَقَالَ لَہَا : أَطِیعِی أَبَاک قَالَ ، قَالَتْ : لاَ حَتَّی تُخْبِرَنِی مَا حَقُّ الزَّوْجِ عَلَی زَوْجَتِہِ ؟ فَرَدَّدَتْ عَلَیْہِ مَقَالَتَہَا قَالَ ، فَقَالَ : حَقُّ الزَّوْجِ عَلَی زَوْجَتِہِ أَنْ لَوْ کَانَ بِہِ قُرْحَۃٌ فَلَحَسَتْہَا ، أَوِ ابْتَدَرَ مَنْخِرَاہُ صَدِیدًا ، أَوْ دَمًا ثُمَّ لَحَسَتْہُ مَا أَدَّتْ حَقَّہُ قَالَ ، فَقَالَتْ : وَالَّذِی بَعَثَک بِالْحَقِّ لاَ أَتَزَوَّجُ أَبَدًا قَالَ ، فَقَالَ : لاَ تُنْکِحُوہُنَّ إلاَّ بِإِذْنِہِنَّ۔ (ابن حبان ۴۱۶۴۔ حاکم ۱۸۸)",": Hasan","Musannaf Ibn Abi Shaybah 17407","","","كتاب النكاح"
"17408","(۱۷۴۰۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی نَصْرٍ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ مُسَاوِرٍ الْحِمْیَرِیِّ ، عَنْ أُمہِ قَالَت : سَمِعْتُ أُمَّ سَلَمَۃَ تَقُولُ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : أَیُّمَا امْرَأَۃٍ مَاتَتْ وَزَوْجُہَا عَنْہَا رَاضٍ دَخَلَتِ الْجَنَّۃَ۔ (ترمذی ۱۱۶۱۔ طبرانی ۸۸۴)",": Da'if","Musannaf Ibn Abi Shaybah 17408","","","كتاب النكاح"
"17409","(۱۷۴۰۹) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عُمَرَ قَالَ : أَتَتِ امْرَأَۃٌ نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، مَا حَقُّ الزَّوْجِ عَلَی زوجتہ ؟ قَالَ : لاَ تَمْنَعُہُ نَفْسَہَا وَلَوْ کَانَتْ عَلَی ظَہْرِ قَتَبٍ قَالَتْ : یَا رَسُولَ اللہِ ، مَا حَقُّ الزَّوْجِ عَلَی زَوْجَتِہِ ؟ قَالَ : لاَ تَصَدَّقُ بِشَیْئٍ مِنْ بَیْتِہِ إلاَّ بِإِذْنِہِ فَإِنْ فَعَلَتْ کَانَ لَہُ الأَجْرُ وَعَلَیْہَا الْوِزْرُ ، قَالَتْ : یَا نَبِی اللہ مَا حَقُّ الزَّوْجِ عَلَی امرأتہ قَالَ : لاَ تَخْرُجَ مِنْ بَیْتِہِ إِلا بِإِذْنِہِ فَإِنْ فَعَلَتْ لَعَنَتْہَا مَلاَئِکَۃُ اللہِ وَمَلاَئِکَۃُ الرَّحْمَۃِ وَمَلاَئِکَۃُ الْغَضَبِ حَتَّی تَتُوبَ ، أَوْ تراجع قَالَتْ : یَا نَبِیَّ اللہِ : فَإِنْ کَانَ لَہَا ظَالِمًا ؟ قَالَ : وَإِنْ کَانَ لَہَا ظَالِمًا ، قَالَتْ : وَالَّذِی بَعَثَک بِالْحَقِّ لاَ یَمْلِکُ عَلَیَّ أَمْرِی أَحَدٌ بَعْدَ ہَذَا أَبَدًا مَا بَقِیتُ۔",": Da'if","Musannaf Ibn Abi Shaybah 17409","","","كتاب النكاح"
"17410","(۱۷۴۱۰) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ بُشَیرِ بْنِ یَسَارٍ ، عَنْ حُصَیْنِ بْنِ مِحْصَنٍ أَنَّ عَمَّۃً لَہُ أَتَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَطْلُبُ حَاجَۃً فَلَمَّا قَضَتْ حَاجَتَہَا قَالَ : أَلَکِ زَوْجٌ ؟ قَالَتْ : نَعَمْ ، قَالَ : فَأَیْنَ أَنْتِ مِنْہُ ؟ قَالَتْ : مَا آلُوہُ خَیْرًا إلاَّ مَا عَجَزْتُ عَنْہُ قَالَ : انْظُرِی ، فَإِنَّہُ جَنَّتُکِ وَنَارُکِ۔\n(احمد ۴/۳۴۱۔ حاکم ۱۸۹)",": Da'if","Musannaf Ibn Abi Shaybah 17410","","","كتاب النكاح"
"17411","(۱۷۴۱۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ أَبِی ظَبْیَانَ قَالَ : لَمَّا قَدِمَ مُعَاذٌ مِنَ الْیَمَنِ قَالَ : یَا رَسُولَ اللہِ ، رَأَیْنَا قَوْمًا یَسْجُدُ بَعْضُہُمْ لِبَعْضٍ أَفَلاَ نَسْجُدُ لَکَ ؟ فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ ، إنَّہُ لاَ یَسْجُدُ أَحَدٌ لأَحَدٍ دون اللہ وَلَوْ کُنْتُ آمِرًا أَحَدًا یَسْجُدُ لأَحَدٍ لأَمَرْتُ النِّسَائَ یَسْجُدْنَ لأَزْوَاجِہِنَّ۔","","Musannaf Ibn Abi Shaybah 17411","","","كتاب النكاح"
"17412","(۱۷۴۱۲) حَدَّثَنَا عبد اللہ بْنُ نُمَیْرٍ قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی ظَبْیَانَ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ ، عَنْ مُعَاذِ بْنِ جَبَلٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِ حَدِیثِ أَبِی مُعَاوِیَۃَ۔ (ابن ماجہ ۱۸۵۳۔ حارث ۴۹۸)",": Da'if","Musannaf Ibn Abi Shaybah 17412","","","كتاب النكاح"
"17413","(۱۷۴۱۳) حَدَّثَنَا عبد اللہ بْنُ إدْرِیسَ ، عَنِ الأَعْمَشِِ ، عَنِ الْمِنْہَالِ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ قَالَ : ثَلاَثَۃٌ لاَ تُجَاوِزُ صَلاَۃُ أَحَدِہِمْ رَأْسَہُ ، إمَامٌ أَمَّ قَوْمًا وَہُمْ لَہُ کَارِہُونَ ، وَامْرَأَۃٌ تَعْصِی زَوْجَہَا ، وَعَبْدٌ آبِقٌ مِنْ سَیِّدِہِ۔","","Musannaf Ibn Abi Shaybah 17413","","","كتاب النكاح"
"17414","(۱۷۴۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ قُرَّۃَ بْنِ خَالِدٍ ، عَنِ امْرَأَۃٍ مِنْ بَنِی عُطَارِدٍ یُقَالُ لَہَا رَبِیعَۃُ قَالَتْ : قالَتْ عَائِشَۃُ : یَا مَعاشِرَ النِّسَائِ ، لَوْ تَعْلَمْنَ حَقَّ أَزْوَاجِکُنَّ عَلَیْکُنَّ لَجَعَلَتِ الْمَرْأَۃُ مِنْکُنَّ تَمْسَحُ الْغُبَارَ ، عَنْ وَجْہِ زَوْجِہَا بِحُرِّ وَجْہِہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17414","","","كتاب النكاح"
"17415","(۱۷۴۱۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ زِیَادِ بْنِ أَبِی الْجَعْدِ ، عَنْ عَمْرِو بْنِ الْحَارِثِ بْن الْمُصْطَلِقِ قَالَ : کَانَ یُقَالُ : أَشَدُّ النَّاسِ عَذَابًا اثْنَانِ : امْرَأَۃٌ تَعْصِی زَوْجَہَا وَإِمَامُ قوْمٍ وَہُمْ لَہُ کَارِہُونَ۔","","Musannaf Ibn Abi Shaybah 17415","","","كتاب النكاح"
"17416","(۱۷۴۱۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنْ حُمَیْدٍ، عَنْ أُمِّہِ قَالَتْ: کُنَّ نِسَائُ أَہْلِ الْمَدِینَۃِ إذَا أَرَدْنَ أَنْ یَبْنِینَ بِامْرَأَۃٍ عَلَی زَوْجِہَا بَدَأْنَ بِعَائِشَۃَ فَأَدْخَلْنَہَا عَلَیْہَا فَتَضَعُ یَدَہَا عَلَی رَأْسِہَا تَدْعُو لَہَا وَتَأْمُرُہَا بِتَقْوَی اللہِ وَحَقِّ الزَّوْجِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17416","","","كتاب النكاح"
"17417","(۱۷۴۱۷) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لاَ یَنْبَغِی لِشَیْئٍ أَنْ یَسْجُدَ لِشَیْئٍ وَلَوْ کَانَ ذَلِکَ لَکَانَ النِّسَائُ لأَزْوَاجِہِنَّ۔",": Da'if","Musannaf Ibn Abi Shaybah 17417","","","كتاب النكاح"
"17418","(۱۷۴۱۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا دَعَا الرَّجُلُ امْرَأَتَہُ إلَی فِرَاشِہِ فَأَبَتْ فَبَاتَ غَضْبَانَ عَلَیْہَا لَعَنَتْہَا الْمَلاَئِکَۃُ حَتَّی تُصْبِحَ۔\n(بخاری ۵۱۹۳۔ مسلم ۱۲۲)",": Sahih","Musannaf Ibn Abi Shaybah 17418","","","كتاب النكاح"
"17419","(۱۷۴۱۹) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ قَالَ : أَخْبَرَنَا عَلِیُّ بْنُ زَیْدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عَائِشَۃَ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ کُنْتُ آمِرًا أَحَدًا أَنْ یَسْجُدَ لأَحَدٍ لأَمَرْتُ الْمَرْأَۃَ أَنْ تَسْجُدَ لِزَوْجِہَا وَلَوْ أَنَّ رَجُلاً أَمَرَ امْرَأَتَہُ أَنْ تَنْتَقِلَ مِنْ جَبَلٍ أَحْمَرَ إلَی جَبَلٍ أَسْوَدَ ، أَوْ مِنْ جَبَلٍ أَسْوَدَ إلَی جَبَلٍ أَحْمَرَ کَانَ نَوْلَہَا أَنْ تَفْعَلَ۔",": Da'if","Musannaf Ibn Abi Shaybah 17419","","","كتاب النكاح"
"17420","(۱۷۴۲۰) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرو ، عَنْ عَبْدِ اللہِ بْنِ بَدْرٍ ، عَنْ قَیْسِ بْنِ طَلْقٍ ، عَنْ أَبِیہِ طَلْقِ بْنِ عَلِیٍّ قَالَ : جَلَسْنا عِنْدَ نَبِیِّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَمِعْتُ نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إذَا دَعَا الرَّجُلُ زَوْجَتَہُ لِحَاجَتِہِ فَلْتَأْتِہِ ، وَإِنْ کَانَتْ عَلَی التَّنُّورِ۔ (ترمذی ۱۱۶۰۔ احمد ۴/۲۳)",": Hasan","Musannaf Ibn Abi Shaybah 17420","","","كتاب النكاح"
"17421","(۱۷۴۲۱) حَدَّثَنَا ابْنُ نُمَیْرٍ قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ قَالَ : کَانُوا یَقُولُونَ : لَوْ أَنَّ امْرَأَۃً مَصَّتْ أَنْفَ زَوْجِہَا مِنَ الْجُذَامِ حَتَّی تَمُوتَ مَا أَدَّتْ حَقَّہُ۔","","Musannaf Ibn Abi Shaybah 17421","","","كتاب النكاح"
"17422","(۱۷۴۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، قَالَ : سَمِعْتُ الْقَاسِمَ بْنَ مُخَیْمِرَۃَ یَذْکُرُ أَنَّ سَلْمَانَ قَدَّمَہُ قَوْمٌ لِیُصَلِّیَ بِہِمْ فَأَبَی عَلَیْہِمْ حَتَّی دَفَعُوہُ ، فَلَمَّا صَلَّی بِہِمْ قَالَ : أَکُلُّکُمْ رَاضٍ ؟ قَالُوا : نَعَمْ ، قَالَ : الْحَمْدُ لِلَّہِ ، إنِّی سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : ثَلاَثَۃٌ لاَ تُقْبَلُ صَلاَتُہُمْ : الْمَرْأَۃُ تَخْرُجُ مِنْ بَیْتِ زَوْجِہَا بِغَیْرِ إذْنِہِ وَالْعَبْدُ الآبِقُ وَالرَّجُلُ یَؤُمُّ قَوْمًا وَہُمْ لَہُ کَارِہُونَ۔",": Da'if","Musannaf Ibn Abi Shaybah 17422","","","كتاب النكاح"
"17423","(۱۷۴۲۳) حَدَّثَنَا عَلِیُّ بْنُ حَسَنِ بْنِ شَقِیقٍ ، قَالَ : حَدَّثَنِی حُسَیْنُ بْنُ وَاقِدٍ قَالَ : حدَّثَنَا أَبُو غَالِبٍ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ثَلاَثَۃٌ لاَ تُجَاوِزُ صَلاَتُہُمْ آذَانَہُمْ حَتَّی یَرْجِعُوا : الْعَبْدُ الآبِقُ وَامْرَأَۃٌ بَاتتْ وَزَوْجُہَا عَلَیْہَا سَاخِطٌ وَإِمَامُ قَوْمٍ وَہُمْ لَہُ کَارِہُونَ۔",": Da'if","Musannaf Ibn Abi Shaybah 17423","","","كتاب النكاح"
"17424","(۱۷۴۲۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ زَیْدِ بْنِ وَہْبٍ قَالَ : کَتَبَ إلَیْنَا عُمَرُ : إنَّ الْمَرْأَۃَ لاَ تَصُومُ تَطَوُّعًا إلاَّ بِإِذْنِہِ یَعْنِی زَوْجَہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17424","","","كتاب النكاح"
"17425","(۱۷۴۲۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تَصُومُ تَطَوُّعًا وَہُوَ شَاہِدٌ إلاَّ بِإِذْنِہِ یَعْنِی زَوْجَہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17425","","","كتاب النكاح"
"17426","(۱۷۴۲۶) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو عن یَحْیَی بْنِ جَعْدَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : خَیْرُ فَائِدَۃٍ اسْتَفَادَہَا الْمُسْلِمُ بَعْدَ الإِسْلاَمِ امْرَأَۃٌ جَمِیلَۃٌ ، تَسُرُّہُ إذَا نَظَرَ إلَیْہَا وَتُطِیعُہُ إذَا أَمَرَہَا وَتَحْفَظُہُ إذَا غَابَ عَنْہَا فِی مَالِہِ وَنَفْسِہَا۔ (ابوداؤد ۱۶۶۱۔ سعید بن منصور ۵۰۱)","","Musannaf Ibn Abi Shaybah 17426","","","كتاب النكاح"
"17427","(۱۷۴۲۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ : مَا اسْتَفَادَ رَجُلٌ ، أَوْ قَالَ عَبْدٌ بَعْدَ إیمَانٍ بِاللَّہِ خَیْرًا مِنِ امْرَأَۃٍ حَسَنَۃِ الْخُلُقِ وَدُودٍ وَلُودٍ ، وَمَا اسْتَفَادَ رَجُلٌ بَعْدَ الْکُفْرِ بِاللَّہِ شَرًّا مِنِ امْرَأَۃٍ سَیِّئَۃِ الْخُلُقِ حَدِیدَۃِ اللِّسَانِ ثُمَّ قَالَ : إنَّ مِنْہُنَّ غُنْمًا لاَ یُحْذَی مِنْہُ وَإِنَّ مِنْہُنَّ غُلاً یُفْدَی مِنْہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 17427","","","كتاب النكاح"
"17428","(۱۷۴۲۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی قَالَ : مَثَلُ الْمَرْأَۃِ الصَّالِحَۃِ عِنْدَ الرَّجُلِ کَمَثَلِ التَّاجِ الْمَخُوصِ بِالذَّہَبِ عَلَی رَأْسِ الْمَلِکِ وَمَثَلُ الْمَرْأَۃِ السَّوْئِ عِنْدَ الرَّجُلِ الصَّالِحِ مَثَلُ الْحِمْلِ الثَّقِیلِ عَلَی الشَّیْخِ الْکَبِیرِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17428","","","كتاب النكاح"
"17429","(۱۷۴۲۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی قَالَ : ثَلاَثَۃٌ یَدْعُونَ فَلاَ یُسْتَجَابُ لَہُمْ : رَجُلٌ آتی سَفِیہًا مَالَہُ وَقَالَ اللَّہُ تَبَارَکَ وَتَعَالَی : {وَلاَ تُؤْتُوا السُّفَہَائَ أَمْوَالَکُم} وَرَجُلٌ کَانَتْ عِنْدَہُ امْرَأَۃٌ سَیِّئَۃُ الْخُلُقِ فَلَمْ یُطَلِّقْہَا ، أَوْ لَمْ یُفَارِقْہَا وَرَجُلٌ کَانَ لَہُ عَلَی رَجُلٍ حَقٌّ فَلَمْ یُشْہِدْ عَلَیْہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17429","","","كتاب النكاح"
"17430","(۱۷۴۳۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی نَصْرٍ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : أَلاَ أُخْبِرُکُمْ بِالثَّلاَثِ الْفَوَاقِرِ ، قَالَ : وَمَا ہُنَّ ؟ قَالَ : إمَامٌ جَائِرٌ ، إِنْ أَحْسَنْتَ لَمْ یَشْکُرْ ، وَإِنْ أَسَأْتَ لَمْ یَغْفِرْ وَجَارُ سَوْئٍ إِنْ رَأَی حَسَنَۃً غَطَّاہَا ، وَإِنْ رَأَی سَیِّئَۃً أَفْشَاہَا وَامْرَأَۃُ السَّوْئِ إِنْ شَہِدْتَہَا غَاظَتکَ ، وَإِنْ غِبْتَ عَنْہَا خَانَتْکَ۔",": Sahih","Musannaf Ibn Abi Shaybah 17430","","","كتاب النكاح"
"17431","(۱۷۴۳۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ جَعْدَۃَ بْنِ ہُبَیْرَۃَ أنہ کَانَ إذَا زَوَّجَ شَیْئًا مِنْ بَنَاتِہِ خَلاَ بِہَا فَنَہَاہَا ، عَنْ سَیِّئِ الأَخْلاَقِ وَأَمَرَہَا بِأَحْسَنِہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17431","","","كتاب النكاح"
"17432","(۱۷۴۳۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا شَیْبَانُ قَالَ أَخْبَرَنَا عَبْدُ الْمَلِکِ بْنُ عُمَیْرٍ ، عَنْ زَیْدِ بْنِ عُقْبَۃَ ، عَنْ سَمُرَۃَ بْنِ جُنْدُبٍ ، قَالَ : سَمِعْتُ عُمَرَ بْنَ الْخَطَّابِ یَقُولُ : النِّسَائُ ثَلاَثَۃٌ : امْرَأَۃٌ ہَیِّنَۃٌ لَیِّنَۃٌ عَفِیفَۃٌ مُسْلِمَۃٌ وَدُودٌ وَلُودٌ تُعِینُ أَہْلَہَا عَلَی الدَّہْرِ ، وَلاَ تُعِینُ الدَّہْرَ عَلَی أَہْلِہَا ، وَقَلَّ مَا تَجِدُہَا ، ثَانِیَۃٌ : امْرَأَۃٌ عَفِیفَۃٌ مُسْلِمَۃٌ إنَّمَا ہِیَ وِعَائٌ لِلْوَلَدِ لَیْسَ عِنْدَہَا غَیْرُ ذَلِکَ ، ثَالِثَۃٌ : غُلٌّ قَمِلٌ یَجْعَلُہَا اللَّہُ فِی عُنُقِ مَنْ یَشَائُ وَلاَ یَنْزِعُہَا غَیْرُہُ ، الرِّجَالُ ثَلاَثَۃٌ : رَجُلٌ عَفِیفٌ مُسْلِمٌ عَاقِلٌ یَأْتَمِرُ فِی الأُمُورِ إذَا أَقْبَلَتْ وَتَشَبَّہت ، فَإِذَا وَقَعَتْ خَرَجَ مِنْہَا بِرَأْیِہِ وَرَجُلٌ عَفِیفٌ مُسْلِمٌ لَیْسَ لَہُ رَأْیٌ فَإِذَا وَقَعَ الأَمْرُ أَتَی ذَا الرَّأْیِ وَالْمَشْورَۃِ فَشَاوَرَہُ وَاسْتَأْمَرَہُ ثُمَّ نَزَلَ عِنْدَ أَمْرِہِ، وَرَجُلٌ حَائِرٌ بَائِرٌ لاَ یَأْتَمِرُ رُشْدًا وَلاَ یُطِیعُ مُرْشِدًا۔",": Sahih","Musannaf Ibn Abi Shaybah 17432","","","كتاب النكاح"
"17433","(۱۷۴۳۳) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ عَطَائٍ ، عَنْ جَابِرِ بن عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إنَّ الْمَرْأَۃَ تُنْکَحُ عَلَی دِینِہَا وَمَالِہَا وَجَمَالِہَا فَعَلَیْکَ بِذَاتِ الدِّینِ تَرِبَتْ یَدَاک۔ (مسلم ۱۰۸۷۔ ترمذی ۱۰۸۶)",": Sahih","Musannaf Ibn Abi Shaybah 17433","","","كتاب النكاح"
"17434","(۱۷۴۳۴) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حَدَّثَنِی مُحَمَّدُ بْنُ مُوسَی الْمَدَنِیُّ قَالَ : أَخْبَرَنِی سَعْدُ بْنُ إِسْحَاقَ ، عَنْ عَمَّتِہِ، عَنْ أَبِی سَعِیدٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: تُنْکَحُ الْمَرْأَۃُ عَلَی إحْدَی خِصَالٍ ثَلاَثٍ: تُنْکَحُ الْمَرْأَۃُ عَلَی مَالِہَا ، عَلَی جَمَالِہَا ، تُنْکَحُ عَلَی دِینِہَا ، عَلَیْک بِذَاتِ الدِّینِ وَالْخُلُقِ تَرِبَتْ یَمِینُکَ۔\n(حاکم ۱۶۱۔ احمد ۳/۸۰)",": Hasan","Musannaf Ibn Abi Shaybah 17434","","","كتاب النكاح"
"17435","(۱۷۴۳۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ یَحْیَی بْنِ جَعْدَۃَ رَفَعَہُ قَالَ : تُنْکَحُ الْمَرْأَۃُ عَلَی دِینِہَا وَخُلُقِہَا وَمَالِہَا وَجَمَالِہَا ، أَیْنَ بِکَ ، عَنْ ذَاتِ الْخُلُقِ وَالدِّینِ ، تَرِبَتْ یَمِینُکَ۔ (سعید بن منصور ۵۰۲)","","Musannaf Ibn Abi Shaybah 17435","","","كتاب النكاح"
"17436","(۱۷۴۳۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ یَحْیَی بْنِ جَعْدَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: تُنْکَحُ الْمَرْأَۃُ عَلَی مَالِہَا وَعَلَی حَسَبِہَا وَعَلَی جَمَالِہَا وَعَلَی دِینِہَا فَعَلَیْکَ بِذَاتِ الدِّینِ، تَرِبَتْ یَمِینُکَ۔","","Musannaf Ibn Abi Shaybah 17436","","","كتاب النكاح"
"17437","(۱۷۴۳۷) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمٍ ، عَنْ کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ أَنَّ أَحَدَکُمْ إذَا أَرَادَ أَنْ یَأْتِیَ أَہْلَہُ قَالَ : بِسْمِ اللہِ اللَّہُمَّ جَنِّبْنَا الشَّیْطَانَ وَجَنِّبِ الشَّیْطَانَ مَا رَزَقْتنَا ، فَإِنَّہُ إِنْ یُقْدَرْ بَیْنَہُمَا وَلَدٌ فِی ذَلِکَ لَمْ یَضُرَّہُ شَیْطَانٌ أَبَدًا۔ (بخاری ۳۲۷۱۔ مسلم ۱۱۶)",": Sahih","Musannaf Ibn Abi Shaybah 17437","","","كتاب النكاح"
"17438","(۱۷۴۳۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ دَاوُدَ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ مَوْلَی أَبِی أُسَیْدٍ قَالَ : تَزَوَّجْتُ وَأَنَا مَمْلُوکٌ فَدَعَوْتُ نَفَرًا مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِیہِمُ ابْنُ مَسْعُودٍ ، وَأَبُو ذَرٍّ وَحُذَیْفَۃُ قَالَ : وَأُقِیمَتِ الصَّلاَۃُ قَالَ : فَذَہَبَ أَبُو ذَرٍّ لِیَتَقَدَّمَ فَقَالُوا : إلَیْکَ ، قَالَ : أَوَ کَذَلِکَ ؟ قَالُوا : نَعَمْ ، قَالَ : فَتَقَدَّمْتُ إلَیْہِمْ وَأَنَا عَبْدٌ مَمْلُوکٌ وَعَلَّمُونِی فَقَالُوا : إذَا أُدْخِلَ عَلَیْکَ أَہْلُکَ فَصَلِّ عَلَیْکَ رَکْعَتَیْنِ ثُمَّ سَلِ اللَّہَ تَعَالَی مِنْ خَیْرِ مَا دَخَلَ عَلَیْکَ وَتَعَوَّذْ بِہِ مِنْ شَرِّہِ ثُمَّ شَأْنَکَ وَشَأْنَ أَہْلِکَ۔",": Da'if","Musannaf Ibn Abi Shaybah 17438","","","كتاب النكاح"
"17439","(۱۷۴۳۹) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنِ ابْنِ أَخِی عَلْقَمَۃَ بن قَیس، عَنْ عَلْقَمَۃَ أَنَّ ابْنَ مَسْعُودٍ کَانَ إذا غَشِیَ أَہْلَہُ فَأَنْزَلَ قَالَ: اللَّہُمَّ لاَ تَجْعَلْ لِلشَّیْطَانِ فِیمَا رَزَقْتنَا نَصِیبًا۔",": Da'if","Musannaf Ibn Abi Shaybah 17439","","","كتاب النكاح"
"17440","(۱۷۴۴۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أُمِّ سَلَمَۃَ قَالَتْ : کَانَتْ لاَ تُزَفُّ بِالْمَدِینَۃِ جَارِیَۃٌ إلَی زَوْجِہَا حَتَّی یُمَرَّ بِہَا فِی الْمَسْجِدِ فَتُصَلِّیَ فِیہِ قَالَ أَبُو بَکْرٍ : قَالَ : أُرَاہُ قَالَ : رَکْعَتَیْنِ وَحَتَّی یُمَرَّ بِہَا عَلَی أَزْوَاجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَیَدْعُونَ لَہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17440","","","كتاب النكاح"
"17441","(۱۷۴۴۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ قَالَ : جَائَ رَجُلٌ إلَی عَبْدِ اللہِ یُقَالُ لَہُ أَبُو جَرِیرٍ ، فَقَالَ : إنِّی تَزَوَّجْتُ جَارِیَۃً شَابَّۃً وَإِنِّی أَخَافُ أَنْ تَفْرَکَنِی قَالَ ، فَقَالَ عَبْدُ اللہِ : إنَّ الإِلْفَ مِنَ اللہِ وَالْفَرْکَ مِنَ الشَّیْطَانِ، یُرِیدُ أَنْ یُکَرِّہَ إلَیْکُمْ مَا أَحَلَّ اللَّہُ لَکُمْ ، فَإِذَا أَتَتْک فَمُرْہَا فَلْتُصَلِّ خلفک رَکْعَتَیْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17441","","","كتاب النكاح"
"17442","(۱۷۴۴۲) حدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ خُصَیْفٍ ، عَنْ مُجَاہِدٍ فِی قَوْلِہِ : {وَلاَ تُمْسِکُوا بِعِصَمِ الْکَوَافِرِ} قَالَ : إذَا لَحِقَتِ امْرَأَۃُ الْمُسْلِمِ بِالْمُشْرِکِینَ لَمْ یُعْتَدَّ بِہَا مِنْ نِسَائِہِ۔","","Musannaf Ibn Abi Shaybah 17442","","","كتاب النكاح"
"17443","(۱۷۴۴۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 17443","","","كتاب النكاح"
"17444","(۱۷۴۴۴) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لِعَبْدِ الرَّحْمَنِ بن عوف : أَوْلِمْ وَلَوْ بِشَاۃٍ یَعْنِی ، حِینَ تَزَوَّجَ۔ (بخاری ۲۰۴۹۔ ابوداؤد ۲۱۰۲)",": Sahih","Musannaf Ibn Abi Shaybah 17444","","","كتاب النكاح"
"17445","(۱۷۴۴۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ زُہَیْرٍ ، عَنْ بَیَانٍ ، قَالَ : سَمِعْتُ أَنَسًا یَقُولُ : بَنَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِامْرَأَۃٍ فَأَرْسَلَنِی فَدَعَوْتُ رِجَالاً إلَی الطَّعَامِ۔ (بخاری ۵۱۷۰۔ ترمذی ۳۲۱۹)",": Sahih","Musannaf Ibn Abi Shaybah 17445","","","كتاب النكاح"
"17446","(۱۷۴۴۶) حَدَّثَنَا جَرِیرٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْحَکَمِ قَالَ : لَمَّا تَزَوَّجَ بِلاَلٌ أَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِذَہَبٍ، قَالَ لِبِلاَلٍ : سُقْ ہَذَا ، ثُمَّ قَالَ : أَعِینُوا أَخَاکُمْ فِی وَلِیمَتِہِ۔ (ابوداؤد ۲۲۶۔ سعید بن منصور ۵۸۸)","","Musannaf Ibn Abi Shaybah 17446","","","كتاب النكاح"
"17447","(۱۷۴۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورِ بن صَفِیَّۃَ ، عَنْ أُمِّہِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَوْلَمَ عَلَی بَعْضِ نِسَائِہِ بِمُدَّیْنِ مِنْ شَعِیرٍ۔ (نسائی ۶۶۰۷۔ احمد ۶/۱۱۳)",": Sahih","Musannaf Ibn Abi Shaybah 17447","","","كتاب النكاح"
"17448","(۱۷۴۴۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ حَفْصَۃَ قَالَتْ : لَمَّا تَزَوَّجَ أَبِی : سِیرِینُ دَعَا أَصْحَابَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَبْعَۃَ أَیَّامٍ فَلَمَّا کَانَ یَوْمُ الأَنْصَارِ دَعَاہُمْ وَدَعَا أُبَیَّ بْنَ کَعْبٍ وَزَیْدَ بْنَ ثَابِتٍ قالَ ہِشَامٌ : وَأَظُنُّہُ قَالَ وَمُعَاذًا قَالَ : فَکَانَ أُبَیٌّ صَائِمًا فَلَمَّا طَعِمُوا دَعَا أُبَیّ بْنُ کَعْبٍ وَأَمَّنَ الْقَوْمُ۔","","Musannaf Ibn Abi Shaybah 17448","","","كتاب النكاح"
"17449","(۱۷۴۴۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسِ بْنِ مَالِکٍ قَالَ : أَوْلَمَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِزَیْنَبَ فَأَشْبَعَ الْمُسْلِمِینَ خُبْزًا وَلَحْمًا۔ (بخاری ۴۷۹۳۔ مسلم ۱۰۴۸)",": Sahih","Musannaf Ibn Abi Shaybah 17449","","","كتاب النكاح"
"17450","(۱۷۴۵۰) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : حَدَّثَنِی مَالِکُ بْنَ دِینَارٍ قَالَ حَدَّثَتْنِی عَجُوزٌ مِنَ الْحَیِّ قَالَتْ : زَوَّجَ أَبُو مُوسَی الأَشْعَرِیُّ بَعْضَ بَنِیہِ قَالَتْ : فَأَوْلَمَ عَلَیْہِ فَدَعَا نَاسًا۔",": Da'if","Musannaf Ibn Abi Shaybah 17450","","","كتاب النكاح"
"17451","(۱۷۴۵۱) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ قَالَ : کَانَ ابْنُ عُمَرَ یُطْعِمُ عَلَی خِتَانِ الصِّبْیَانِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17451","","","كتاب النكاح"
"17452","(۱۷۴۵۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنْ أَبِی إسْرَائِیلَ، عَنِ الأَعْمَشِ أن أَبَا وَائِلٍ: أَوْلَمَ بِرَأْسِ بَقَرَۃٍ وَأَرْبَعَۃِ أَرْغِفَۃٍ۔","","Musannaf Ibn Abi Shaybah 17452","","","كتاب النكاح"
"17453","(۱۷۴۵۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ قَالَ : عَرَّسْتُ فِی عَہْدِ أَبِی فَآذَنَ أَبِی النَّاسَ ، وَکَانَ فِیمَنْ آذَنَ لأَبِی أَیُّوبَ۔",": Hasan","Musannaf Ibn Abi Shaybah 17453","","","كتاب النكاح"
"17454","(۱۷۴۵۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ یُونُسَ الأَیْلِیِّ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ أَنَّ حَمْزَۃَ بْنَ عَبْدِ اللہِ بْنِ عُمَرَ نَحَرَ جَزُورًا۔","","Musannaf Ibn Abi Shaybah 17454","","","كتاب النكاح"
"17455","(۱۷۴۵۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَرَ بْنِ حَمْزَۃَ قَالَ : أَخْبَرَنِی سَالِمُ بْنُ عَبْدِ اللہِ قَالَ : خَتَنَنِی أَبِی أَنَا وَنُعَیْمَ بْنَ عَبْدِ اللہِ فَذَبَحَ عَلَیْنَا کَبْشًا وَلَقَدْ رَأَیْتُنَا نَجْدِلُ بِہِ عَلَی الْغِلْمَانِ۔","","Musannaf Ibn Abi Shaybah 17455","","","كتاب النكاح"
"17456","(۱۷۴۵۶) حدَّثَنَا حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ قَالَ : کَانَ یقال : إِنَّ خَوْلَۃَ بِنْتَ حَکِیمٍ مِنَ اللاَّتِی وَہَبْنَ أَنْفُسَہُنَّ لِلنَّبِیِّ علیہ السلام۔ (بخاری ۵۱۱۳۔ مسلم ۵۰)","","Musannaf Ibn Abi Shaybah 17456","","","كتاب النكاح"
"17457","(۱۷۴۵۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ : {وَامْرَأَۃً مُؤْمِنَۃً إِنْ وَہَبَتْ نَفْسَہَا لِلنَّبِیِّ} قَالَ : لم تَہَبْ نَفْسَہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17457","","","كتاب النكاح"
"17458","(۱۷۴۵۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ قَالَ : کَتَبَ عَبْدُ الْمَلِکِ إلَی أَہْلِ الْمَدِینَۃِ یَسْأَلُہُمْ قَالَ : فَکَتَبَ إلَیْہِ عَلِیٌّ قَالَ شُعْبَۃُ : وَظَنِّی أَنَّہُ ابْنُ حُسَیْنٍ قَالَ : وَأَخْبَرَنِی أَبَانُ بْنُ تَغْلِبَ ، عَنِ الْحَکَمِ أَنَّہُ عَلِیُّ بْنُ حُسَیْنٍ قَالَ : ہِیَ امْرَأَۃٌ مِنَ الأَزْدِ یُقَالُ لَہَا أَمُّ شَرِیکٍ وَہَبَتْ نَفْسَہَا لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔\n(نسائی ۸۹۲۸۔ احمد ۶/۴۶۲)","","Musannaf Ibn Abi Shaybah 17458","","","كتاب النكاح"
"17459","(۱۷۴۵۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : حَدَّثَنِی عَبْدُ اللہِ بْنُ أَبِی السَّفَرِ ، عَنِ الشَّعْبِیِّ أَنَّہَا امْرَأَۃٌ مِنَ الأَنْصَارِ وَہَبَتْ نَفْسَہَا لِلنَّبِیِّ وَہِیَ مِمَّنْ أَرْجَأَ۔","","Musannaf Ibn Abi Shaybah 17459","","","كتاب النكاح"
"17460","(۱۷۴۶۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ قَالَ : وَحَدَّثَنِی أَہْلُ الْمَدِینَۃِ أَنَّہُمْ کَانُوا یَقُولُونَ لِلشَّیْئِ : لَہُوَ أَعْظَمُ نَحِیًّا مِنْ نَحِیِّ أُمِّ شَرِیکٍ۔","","Musannaf Ibn Abi Shaybah 17460","","","كتاب النكاح"
"17461","(۱۷۴۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ وَعُمَرَ بْنِ الْحَکَمِ ، وَعَبْدِ اللہِ بْنِ عُبَیدۃَ قَالُوا : الَّتِی وَہَبَتْ نَفْسَہَا لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَیْمُونَۃُ۔ (طبری ۲۳۔ بیہقی ۵۵)",": Da'if","Musannaf Ibn Abi Shaybah 17461","","","كتاب النكاح"
"17462","(۱۷۴۶۲) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ وَرْقَائَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : {وَامْرَأَۃً مُؤْمِنَۃً إِنْ وَہَبَتْ نَفْسَہَا لِلنَّبِیِّ} قَالَ : بِغَیْرِ صَدَاقٍ۔","","Musannaf Ibn Abi Shaybah 17462","","","كتاب النكاح"
"17463","(۱۷۴۶۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ : (وَامْرَأَۃً مُؤْمِنَۃً إِنْ وَہَبَتْ نَفْسَہَا لِلنَّبِیِّ) قَالَ : فَعَلَتْ وَلَمْ یَفْعَلْ۔","","Musannaf Ibn Abi Shaybah 17463","","","كتاب النكاح"
"17464","(۱۷۴۶۴) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَوْفٍ قَالَ : حدَّثَنَا أَشْیَاخُ عُمَرِیِین مِنْ جُلَسَائِ قَسَامَۃَ بْنِ زُہَیْرٍ أَنَّ ہَمَّامَ بْنَ عُمَیْرٍ رَجُلٌ مِنْ بَنِی تَیْمِ اللہِ کَانَ جَمَعَ بَیْنَ أُخْتَیْنِ فِی الْجَاہِلِیَّۃِ فَلَمْ یُفَرِّقْ بَیْنَ وَاحِدَۃٍ مِنْہُمَا حَتَّی کَانَ فِی خِلاَفَۃِ عُمَرَ وَأَنَّہُ رُفِعَ شَأْنُہُ إلَی عُمَرَ فَأَرْسَلَ إلَیْہِ ، فَقَالَ : اخْتَرْ إحْدَاہُمَا وَاللَّہِ لَئِنْ قَرَبْتِ الأُخْرَی لأَضْرِبَنَّ رَأْسَکَ۔",": Da'if","Musannaf Ibn Abi Shaybah 17464","","","كتاب النكاح"
"17465","(۱۷۴۶۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : إذَا أَسْلَمَ وَعِنْدَہُ أُخْتَانِ حَبَسَ الأُولَی مِنْہُمَا إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 17465","","","كتاب النكاح"
"17466","(۱۷۴۶۶) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللہِ بْنِ أَبِی فَرْوَۃَ ، عَنْ أَبِی وَہْبٍ الْجَیْشَانِیِّ ، عَنْ أَبِی خِرَاشٍ الرُّعَیْنِیِّ ، عَنِ الدَّیْلَمِیِّ قَالَ : قدِمْتُ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَعِنْدِی أُخْتَانِ تَزَوَّجْتُہُمَا فِی الْجَاہِلِیَّۃِ ، فَقَالَ : إذَا رَجَعْت فَطَلِّقْ إحْدَاہُمَا۔ (ترمذی ۱۱۲۹۔ احمد ۴/۲۳۲)",": Da'if","Musannaf Ibn Abi Shaybah 17466","","","كتاب النكاح"
"17467","(۱۷۴۶۷) حدَّثَنَا ابْنُ عُلَیَّۃَ وَمَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ قَالَ : أَسْلَمَ غَیْلاَنُ بْنُ سَلَمَۃ الثَّقَفِیُّ وَتَحْتَہُ عَشْرُ نِسْوَۃٍ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خُذْ مِنْہُنَّ أَرْبَعًا۔\n(دار قطنی ۲۷۱۔ بیہقی ۱۸۳)","","Musannaf Ibn Abi Shaybah 17467","","","كتاب النكاح"
"17468","(۱۷۴۶۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُسْلِمُ وَعِنْدَہُ عَشْرُ ، أَوْ سِتُّ نِسْوَۃٍ قَالَ : یُمْسِکُ مِنْہُنَّ أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 17468","","","كتاب النكاح"
"17469","(۱۷۴۶۹) حَدَّثَنَا بَکْرُ بْنُ عَبْدِ الرَّحْمَنِ قَالَ : حدَّثَنَا عِیسَی بْنُ الْمُخْتَارِ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ حُمَیْضَۃَ بْنِ الشَّمَرْدَلِ ، عَنْ قَیْسِ بْنِ الْحَارِثِ الأَسَدِیِّ أَنَّہُ أَسْلَمَ وَعِنْدَہُ ثَمَانِ نِسْوَۃٍ فَأَمَرَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَخْتَارَ مِنْہُنَّ أَرْبَعًا۔ (ابوداؤد ۲۲۳۶۔ ابن ماجہ ۱۹۵۲)",": Da'if","Musannaf Ibn Abi Shaybah 17469","","","كتاب النكاح"
"17470","(۱۷۴۷۰) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ فِی قَوْلِہِ : {غَیْرِ أُولِی الإِرْبَۃِ} قَالَ : الَّذِی لَمْ یَبْلُغْ أرْبُہُ أَنْ یَطَّلِعَ عَلَی عَوْرَۃِ النِّسَائِ۔","","Musannaf Ibn Abi Shaybah 17470","","","كتاب النكاح"
"17471","(۱۷۴۷۱) حَدَّثَنَا ابْنُ إدْرِیسَ أَظُنُّہُ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ فِی قَوْلِہِ : {غَیْرِ أُولِی الإِرْبَۃِ} قَالَ : ہو الأَبْلَہُ الَّذِی لاَ یَعْرِفُ أَمْرَ النِّسَائِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17471","","","كتاب النكاح"
"17472","(۱۷۴۷۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ فِی قَوْلِہِ : {غَیْرِ أُولِی الإِرْبَۃِ مِنَ الرِّجَالِ} قَالَ : الَّذِی لاَ أرب لہ بِالنِّسَائِ۔","","Musannaf Ibn Abi Shaybah 17472","","","كتاب النكاح"
"17473","(۱۷۴۷۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : الْمَعْتُوہُ۔","","Musannaf Ibn Abi Shaybah 17473","","","كتاب النكاح"
"17474","(۱۷۴۷۴) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّد ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ قَالَ : ہُوَ الَّذِی یَقُولُونَ : أَحْمَقُ","","Musannaf Ibn Abi Shaybah 17474","","","كتاب النكاح"
"17475","(۱۷۴۷۵) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ہُوَ الَّذِی لاَ تَسْتَحْیِی مِنْہُ النِّسَائُ۔",": Da'if","Musannaf Ibn Abi Shaybah 17475","","","كتاب النكاح"
"17476","(۱۷۴۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَوْنٍ ، عَنْ عِکْرِمَۃَ قَالَ : ہُوَ الَّذِی لاَ یَقُومُ إرْبُہُ۔","","Musannaf Ibn Abi Shaybah 17476","","","كتاب النكاح"
"17477","(۱۷۴۷۷) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ قَالَ : فَرَّقَ عُمَرُ بْنُ الْخَطَّابِ بَیْنَہُمَا وَجَعَلَ صَدَاقَہَا فِی بَیْتِ الْمَالِ وَقَالَ الزُّہْرِیُّ : لَمْ یَکُنْ صَدَاقُہَا فِی بَیْتِ الْمَالِ ، ہُوَ بِمَا أَصَابَ مِنْ فَرْجِہَا۔","","Musannaf Ibn Abi Shaybah 17477","","","كتاب النكاح"
"17478","(۱۷۴۷۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ صَالِحِ بْنِ مُسْلِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عُمَرُ : یُفَرَّقُ بَیْنَہُمَا وَیُجعَلُ صَدَاقَہَا فِی بَیْتِ الْمَالِ وَقَالَ عَلِی : یُفَرَّقُ بَیْنَہُمَا وَلَہَا الصَّدَاقُ بِمَا اسْتَحَلَّ مِنْ فَرْجِہَا۔","","Musannaf Ibn Abi Shaybah 17478","","","كتاب النكاح"
"17479","(۱۷۴۷۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیِّبِ قَالَ : یُفَرَّقُ بَیْنَہُمَا وَلَہَا الصَّدَاقُ بِمَا اسْتَحَلَّ مِنْ فَرْجِہَا۔","","Musannaf Ibn Abi Shaybah 17479","","","كتاب النكاح"
"17480","(۱۷۴۸۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ قَالَ : یُفَرَّقُ بَیْنَہُمَا وَیُلْقَی الصَّدَاقُ فِی بَیْتِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 17480","","","كتاب النكاح"
"17481","(۱۷۴۸۱) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : کُلُّ نِکَاحٍ فَاسِدٍ نَحْوَ الَّذِی تُزَوَّجُ فِی عِدَّتِہَا وَأَشْبَاہِہِ ، ہَذَا مِنَ النِّکَاحِ الْفَاسِدِ إذَا کَانَ قَدْ دَخَلَ بِہَا فَلَہَا الصَّدَاقُ وَیُفَرَّقُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17481","","","كتاب النكاح"
"17482","(۱۷۴۸۲) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ أَنَّہُ قَالَ : یُفَرَّقُ بَیْنَہَا وَبَیْنَ زَوْجِہَا وَیَکُونُ لَہَا الْمَہْرُ بِمَا اسْتَحَلَّ مِنْ فَرْجِہَا۔","","Musannaf Ibn Abi Shaybah 17482","","","كتاب النكاح"
"17483","(۱۷۴۸۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ قَالَ : قضَی عُمَرُ فِی امْرَأَۃٍ تَزَوَّجَتْ فِی عِدَّتِہَا أَنْ یُفَرَّقَ بَیْنَہُمَا مَا عَاشَا وَیُجْعَلُ صَدَاقُہَا فِی بَیْتِ الْمَالِ وَقَالَ : کَانَ نِکَاحُہَا حَرَامًا فَصَدَاقُہَا حَرَامًا ، وَقَضَی فِیہَا عَلِیٌّ أَنْ یُفَرَّقَ بَیْنَہُمَا وَتُوَفِّیَ عِدَّۃَ مَا بَقِیَ مِنَ الزَّوْجِ الأَوَّلِ ثُمَّ تَعْتَدُّ ثَلاَثَۃَ قُرُوئٍ وَلَہَا الصَّدَاقُ بِمَا اسْتَحَلَّ مِنْ فَرْجِہَا ثُمَّ إِنْ شَائَ خَطَبَہَا بَعْدَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17483","","","كتاب النكاح"
"17484","(۱۷۴۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ عَبْدِ اللہِ بْنِ حَبِیبٍ قَالَ : خَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلَقِیَ امْرَأَۃً فَأَعْجَبَتْہُ فَرَجَعَ إلَی أُمِّ سَلَمَۃَ وَعِنْدَہَا نِسْوَۃٌ یَدُفن طِیبًا قَالَ : فَعَرَفْنَ فِی وَجْہِہِ فَأَخْلَیْنَہُ فَقَضَی حَاجَتَہُ فَخَرَجَ ، فَقَالَ : مَنْ رَأَی مِنْکُمُ امْرَأَۃً فَأَعْجَبَتْہُ فَلِیَأْتِ أَہْلَہُ فَلْیُوَاقِعْہَا فَإِنَّ مَعَہَا مِثْلُ الَّذِی مَعَہَا۔ (مسلم ۹)","","Musannaf Ibn Abi Shaybah 17484","","","كتاب النكاح"
"17485","(۱۷۴۸۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ عَبْدِ اللہِ بْنِ حَبِیبٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِ حَدِیثِ أَبِی حَصِینٍ إلاَّ إِنَّہُ لَمْ یَذْکُرْ : یَدُفْنَ طِیبًا۔","","Musannaf Ibn Abi Shaybah 17485","","","كتاب النكاح"
"17486","(۱۷۴۸۶) حَدَّثَنَا وَکِیعٌ ، وَابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ حُلاَّمٍ قَالَ قَالَ عَبْدُ اللہِ : مَنْ رَأَی مِنْکُمُ امْرَأَۃً فَأَعْجَبَتْہُ فَلْیُوَاقِع أَہْلَہُ فَإِنَّ مَعَہُنَّ مِثْلَ الَّذِی مَعَہُنَّ۔ (دارمی ۲۲۱۵)",": Da'if","Musannaf Ibn Abi Shaybah 17486","","","كتاب النكاح"
"17487","(۱۷۴۸۷) حَدَّثَنَا عَبِیدَۃُ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی امْرَأَۃً ، فَأَتَی أُمَّ سَلَمَۃَ فَوَاقَعَہَا وَقَالَ : إذَا رَأَی أحدکم امْرَأَۃً تُعْجِبُہُ فَلْیَأْتِ أَہْلَہُ فَإِنَّ مَعَہُنَّ مِثْلَ الَّذِی مَعَہُنَّ۔","","Musannaf Ibn Abi Shaybah 17487","","","كتاب النكاح"
"17488","(۱۷۴۸۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیرِ ، عَنْ جَابِرٍ بِنَحْوِ حَدِیثِ عَبْدِ اللہِ۔\n(مسلم۹۔ ابوداؤد ۲۱۴۴)",": Da'if","Musannaf Ibn Abi Shaybah 17488","","","كتاب النكاح"
"17489","(۱۷۴۸۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ مُطَرِّفٍ فِی الرَّجُلِ یَرَی الْمَرْأَۃَ تُعْجِبُہُ قَالَ : یَذْکُرُ أَخْسَائَ الْبَقَرِ۔","","Musannaf Ibn Abi Shaybah 17489","","","كتاب النكاح"
"17490","(۱۷۴۹۰) حَدَّثَنَا زید بْنُ حُبَابٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ إبْرَاہِیمَ فِی الرَّجُلِ یَرَی الْمَرْأَۃَ فتعجبہ قَالَ : یَذْکُرُ مَنَاتِنہَا۔","","Musannaf Ibn Abi Shaybah 17490","","","كتاب النكاح"
"17491","(۱۷۴۹۱) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَلِیِّ بْنِ مُدْرِکٍ ، قَالَ : سَمِعْتُ النَّخَعِیّ قَالَ : تَزَوَّجَ الأَشْعَثُ امْرَأَۃً عَلَی حُکْمِہَا فَرُفِعَ إلَی عُمَرَ بْنِ الْخَطَّابِ ، فَقَالَ : أَرْضِہَا أَرْضِہَا۔","","Musannaf Ibn Abi Shaybah 17491","","","كتاب النكاح"
"17492","(۱۷۴۹۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : إذا تَزَوَّجَ الرَّجُلُ الْمَرْأَۃَ عَلَی حُکْمِہَا ، أَوْ حُکْمِہِ فَجَارٍ فِی الصَّدَاقِ أو جَارُوا رُدَّ ذَاکَ إلَی صَدَاقِ مِثْلِہَا لاَ وَکْسَ وَلاَ شَطَطَ وَالنِّکَاحُ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 17492","","","كتاب النكاح"
"17493","(۱۷۴۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ قَالَ : خَطَبَ عَمْرُو بْنُ حُرَیْثٍ إلَی عَدِیِّ بْنِ حَاتِمٍ ابْنَتَہُ فَأَبَی إلاَّ عَلَی حُکْمِہِ فَرَجَعَ عَمْرٌو فَاسْتَشَارَ أَصْحَابَہُ فَقَالُوا : أَتُرِیدُ أَنْ تُحَکِّمَ رَجُلاً مِنْ طیئٍ فِی عَقْدِکَ فَأَبَتْ نَفْسُہُ فَتَزَوَّجَہَا عَلَی حُکْمِہِ ثُمَّ انْصَرَفَ فَحَکَّمَ عَدِیٌّ سُنَّۃَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَمَانِینَ وَأَرْبَعِ مِئَۃٍ ، فَبَعَثَ إلَیْہِ عَمْرٌو بِعَشَرَۃِ آلاَفٍ وَقَالَ : جَہِّزْہَا۔","","Musannaf Ibn Abi Shaybah 17493","","","كتاب النكاح"
"17494","(۱۷۴۹۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ أَنَّ الأَشْعَثَ تَزَوَّجَ امْرَأَۃً عَلَی حُکْمِہَا فَسَأَلَہُ عُمَرُ عَنْہَا ، فَقَالَ : بِتُّ لَیْلَۃً لاَ یَعْلَمُہَا إلاَّ اللَّہُ مَخَافَۃَ أَنْ تَحْکُمَ عَلَیَّ فِی مَالِ قَیْسٍ ، فَقَالَ : لَیْسَ ذَلِکَ لَہَا إنَّمَا لَہَا مَہْرُ نِسَائِہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17494","","","كتاب النكاح"
"17495","(۱۷۴۹۵) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً عَلَی حُکْمِہِ فَمَاتَتِ الْمَرْأَۃُ قَبْلَ أَنْ یَحْکُمَ الرَّجُلُ قَالَ : لَہَا صَدَاقُ نِسَائِہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17495","","","كتاب النكاح"
"17496","(۱۷۴۹۶) حَدَّثَنَا یَعْلَی ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً عَلَی حُکْمِہِ فَحَکَمَ عَشَرَۃَ دَرَاہِمَ قَالَ : یَجُوزُ ، قَدْ کَانَ الْمُسْلِمُونَ یَتَزَوَّجُونَ عَلَی أَقَلَّ مِنْ ذَلِکَ وَأَکْثَرَ۔","","Musannaf Ibn Abi Shaybah 17496","","","كتاب النكاح"
"17497","(۱۷۴۹۷) حَدَّثَنَا حُمَیْدُ بنُ عَبْدِ الرَّحْمَنِ ، عَنِ السَّرِیِّ بْنِ یَحْیَی ، عَنِ الْحَسَنِ قَالَ : قَالَ رَجُلٌ لآخَرَ : بِالرِّفَائِ والبَنِیْنَ، فَقَالَ رَسُوْلَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَقُوْلُوْا ہَکَذَا قُوْلُوْا : بَارَکَ اللَّہُ فِیْکَ وَبَارَکَ عَلَیْکَ۔",": Hasan","Musannaf Ibn Abi Shaybah 17497","","","كتاب النكاح"
"17498","(۱۷۴۹۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّ عَقِیلَ بْنَ أَبِی طَالِبٍ تَزَوَّجَ امْرَأَۃً مِنْ بَنِی جُشَمٍ فَدَعَاہُمْ فَقَالُوا : بِالرِّفَائِ وَالبَنِیْنَ ، فَقَالَ : لاَ تَقُوْلُوْا ذَاکَ : قَالُوا : کَیْفَ نَقُوْلُ یَا أَبَا یَزِیْدٍ ؟ قَالَ : تَقُوْلُوْنَ : بَارَکَ اللَّہُ لَکَ وَبَارَکَ عَلَیْکَ فَإنَّا کُنَّا نَقُوْلُ ، أَوْ نُؤْمَرُ بِذَلِکَ۔ (ابن ماجہ ۱۹۰۶۔ احمد ۱/۴۵۱)",": Hasan","Musannaf Ibn Abi Shaybah 17498","","","كتاب النكاح"
"17499","(۱۷۴۹۹) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ بْنِ عُبَیْدٍ ، عَنْ عَمْرِو بْنِ سَعِیدٍ ، عَنْ أَبِی زُرْعَۃَ بْنِ عَمْرٍو ، عَنْ جَرِیرٍ قَالَ: سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ نَظْرَۃِ الْفُجَائَۃِ فَأَمَرَنِی أَنْ أَصْرِفَ بَصَرِی۔\n(مسلم ۱۶۹۹۔ ابوداؤد ۲۱۴۱)",": Sahih","Musannaf Ibn Abi Shaybah 17499","","","كتاب النكاح"
"17500","(۱۷۵۰۰) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ إِسْحَاقَ بْنِ سُوَیْد ، عَنِ الْعَلاَئِ بْنِ زِیَادٍ قَالَ : کَانَ یُقَالُ : لاَ تُتْبِعَنَّ نَظَرَکَ حُسْنَ رِدَائِ امْرَأَۃٍ فَإِنَّ النَّظَرَ یَجْعَلُ شَہْوَۃً فِی الْقَلْبِ۔","","Musannaf Ibn Abi Shaybah 17500","","","كتاب النكاح"
"17501","(۱۷۵۰۱) حَدَّثَنَا جَرِیرٌ ، عَنْ عَاصِمٍ الأَحْوَلِ ، عَنِ الشَّعْبِیِّ قَالَ : (قُلْ لِلْمُؤْمِنِینَ یَغُضُّوا مِنْ أَبْصَارِہِمْ) قُلْتُ لِلشَّعْبِیِّ : الرَّجُلُ یَنْظُرُ الْمَرْأَۃَ لاَ یَرَی مِنْہَا مُحَرَّمًا قَالَ : مَا لَکَ أَنْ تثقبہا بِعَیْنِکَ ؟۔","","Musannaf Ibn Abi Shaybah 17501","","","كتاب النكاح"
"17502","(۱۷۵۰۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ قَالَ : نَظْرَۃٌ یَہْوَاہَا الْقَلْبُ فَلاَ خَیْرَ فِیہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17502","","","كتاب النكاح"
"17503","(۱۷۵۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ أَبِی رَبِیعَۃَ الإِیَادِیِّ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لِعَلِیٍّ : لاَ تُتْبِعِ النَّظْرَۃَ النَّظْرَۃَ فَإِنَّمَا لَکَ الأُولَی وَلَیْسَ لَکَ الآخِرَۃُ۔(ترمذی ۲۷۷۷۔ ابوداؤد ۲۱۴۲)",": Da'if","Musannaf Ibn Abi Shaybah 17503","","","كتاب النكاح"
"17504","(۱۷۵۰۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ مُوسَی الْجُہَنِیِّ قَالَ : کُنْتُ مَعَ سَعِیدِ بْنِ جُبَیْرٍ فِی طَرِیقٍ فَاسْتَقْبَلَتْنَا امْرَأَۃٌ أو جاریۃ قَالَ : فَنَظَرْنَا إلَیْہَا جَمِیعًا قَالَ ثُمَّ إنَّ سَعِیدًا غَضَّ بَصَرَہُ فَنَظَرْتُ أنا ، قَالَ : فَقَالَ لِی سَعِیدٌ : الأُولَی لَکَ وَالثَّانِیَۃُ عَلَیْکَ۔","","Musannaf Ibn Abi Shaybah 17504","","","كتاب النكاح"
"17505","(۱۷۵۰۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ قَالَ : کَانَ یُقَالُ : النَّظْرَۃُ الأُولَی لاَ یَمْلِکُہَا أَحَدٌ وَلَکِنِ الَّذِی یَدُسُّ النَّظَرَ دَسًّا۔","","Musannaf Ibn Abi Shaybah 17505","","","كتاب النكاح"
"17506","(۱۷۵۰۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ دَاوُدَ أَبِی الہیثم قَالَ قَالَ رَجُلٌ لاِِبْنِ سِیرِینَ : أَسْتَقْبِلُ الْقِبْلَۃَ فِی الطَّرِیقِ أَلَیْسَ لِی النَّظْرَۃُ الأُولَی ثُمَّ أَصْرِفُ عَنْہَا بَصَرِی ؟ قَالَ : أَمَا تَقْرَأُ الْقُرْآنَ : {یَغُضُّوا مِنْ أَبْصَارِہِمْ} {یَعْلَمُ خَائِنَۃَ الأَعْیُنِ، وَمَا تُخْفِی الصُّدُورُ}۔","","Musannaf Ibn Abi Shaybah 17506","","","كتاب النكاح"
"17507","(۱۷۵۰۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ خَالِدِ بْنِ مَحدُوجٍ ، قَالَ : سَمِعْتُ أَنَسًا یَقُولُ : إذَا لَقِیتَ الْمَرْأَۃَ فَغُضَّ عَیْنَیکَ حَتَّی تَمْضِیَ۔",": Da'if","Musannaf Ibn Abi Shaybah 17507","","","كتاب النكاح"
"17508","(۱۷۵۰۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ قَالَ : لاَ یَضُرُّک حُسْنُ امْرَأَۃٍ مَا لَمْ تَعْرِفْہَا۔","","Musannaf Ibn Abi Shaybah 17508","","","كتاب النكاح"
"17509","(۱۷۵۰۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنْ عَمْرِو بْنِ سَعِیدٍ ، قَالَ : قَالَ سَعْدُ بْنُ أَبِی وَقَّاصٍ : بَیْنَا أَنَا أَطُوفُ بِالْبَیْتِ إذْ رَأَیْتُ امْرَأَۃً فَأَعْجَبَنِی دَلُّہَا فَأَرَدْتُ أَنْ أَسْأَلَ عَنْہَا فَوَجَدْتُہَا مَشْغُولَۃً وَلاَ یَضُرُّکَ حُسْنُ امْرَأَۃٍ مَا لَمْ تَعْرِفْہَا۔","","Musannaf Ibn Abi Shaybah 17509","","","كتاب النكاح"
"17510","(۱۷۵۱۰) حَدَّثَنَا إسْمَاعِیلُ بْنُ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ طَاوُوسٍ أَنَّہُ کَرِہَ أَنْ یَنْظُرَ الرَّجُلُ إلَی الْمَرْأَۃِ إلاَّ أَنْ یَکُونَ زَوْجًا ، أَوْ ذَا مَحْرَمٍ۔","","Musannaf Ibn Abi Shaybah 17510","","","كتاب النكاح"
"17511","(۱۷۵۱۱) حَدَّثَنَا أَبُو أُسَامَۃَ قَالَ : أَخْبَرَنِی أَبُو عُمَیْرٍ ، عَنْ أَیُّوبَ قَالَ : کَانَ طَاوُوسٌ لاَ یَصْحَبُ رُفْقَۃً فِیہَا امْرَأَۃٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17511","","","كتاب النكاح"
"17512","(۱۷۵۱۲) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ ، عَنْ سَلَمَۃَ بْنِ أَبِی طُفَیْلٍ ، عَنْ عَلِیٍّ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : یَا عَلِیُّ ، إنَّ لَکَ کَنْزًا فِی الْجَنَّۃِ وَإِنَّکَ ذُو قَرْنَیْہَا فَلاَ تُتْبِعِ النَّظْرَۃَ النَّظْرَۃَ فَإِنَّمَا لَکَ الأُولَی وَلَیْسَتْ لَکَ الآخِرَۃُ۔ (احمد ۱/۱۵۹۔ دارمی ۲۷۰۹)",": Da'if","Musannaf Ibn Abi Shaybah 17512","","","كتاب النكاح"
"17513","(۱۷۵۱۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : {یَعْلَمُ خَائِنَۃَ الأَعْیُنِ ، وَمَا تُخْفِی الصُّدُورُ} قَالَ : الرَّجُلُ یَکُونُ فِی الْقَوْمِ فَتَمُرُّ بِہِمُ الْمَرْأَۃُ فَیُرِیہِمْ أَنَّہُ یَغُضُّ بَصَرَہُ عَنْہَا فَإِنْ رَأَی مِنْہُمْ غَفَلَۃً نَظَرَ إلَیْہَا فَإِنْ خَافَ أَنْ یَفْطَنُوا بِہِ غَضَّ بَصَرَہُ وَقَدِ اطَّلَعَ اللَّہُ مِنْ قَلْبِہِ أَنَّہُ وَدَّ أَنَّہُ نَظَرَ إلَی عَوْرَتِہَا۔","","Musannaf Ibn Abi Shaybah 17513","","","كتاب النكاح"
"17514","(۱۷۵۱۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، قَالَ : قَالَ أَبُو مُوسَی : لأَنْ تَمْتَلِئَ مَنْخِرَیَّ مِنْ رِیحِ جِیفَۃٍ أَحَبُّ إلَیَّ مِنْ أَنْ تَمْتَلِئَا مِنْ رِیحِ امْرَأَۃٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 17514","","","كتاب النكاح"
"17515","(۱۷۵۱۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : لأَنْ أُزَاحِمَ بَعِیرًا مَطْلِیًّا بِقَطِرَانٍ أَحَبُّ إلَیَّ مِنْ أَنْ أُزَاحِمَ امْرَأَۃً۔","","Musannaf Ibn Abi Shaybah 17515","","","كتاب النكاح"
"17516","(۱۷۵۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ثَابِتِ بْنِ عُمَارَۃَ ، عَنْ غُنَیْمِ بْنِ قَیْسٍ ، عَنْ أَبِی مُوسَی قَالَ : کُلُّ عَیْنٍ فَاعِلَۃٌ یَعْنِی زَانِیَۃً۔",": Hasan","Musannaf Ibn Abi Shaybah 17516","","","كتاب النكاح"
"17517","(۱۷۵۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُطَلِّقُ امْرَأَتَہُ تَطْلِیقَۃً ، أَوْ تَطْلِیقَتَیْنِ قَبْلَ أَنْ یَدْخُلَ بِہَا ثُمَّ غَشِیَہَا وَہُوَ یَرَی أَنَّ لَہُ عَلَیْہَا رَجْعَۃً قَالَ : لَہَا الصَّدَاقُ وَیُفَرَّقُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17517","","","كتاب النكاح"
"17518","(۱۷۵۱۸) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ؛ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ ، ثُمَّ غَشِیَہَا وَہُوَ یَرَی أَنَّ لَہُ عَلَیْہَا رَجْعَۃً قَالَ : لَہَا الصَّدَاقُ کَامِلاً لِغِشْیَانِہِ إیَّاہَا۔","","Musannaf Ibn Abi Shaybah 17518","","","كتاب النكاح"
"17519","(۱۷۵۱۹) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ عن مَطَرٍ ، عَنِ الْحَکَمِ قَالَ : لَہَا الصَّدَاقُ کَامِلاً۔","","Musannaf Ibn Abi Shaybah 17519","","","كتاب النكاح"
"17520","(۱۷۵۲۰) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : لَہَا الصَّدَاقُ کَامِلاً۔","","Musannaf Ibn Abi Shaybah 17520","","","كتاب النكاح"
"17521","(۱۷۵۲۱) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : لَہَا صَدَاقٌ وَنِصْفُ۔","","Musannaf Ibn Abi Shaybah 17521","","","كتاب النكاح"
"17522","(۱۷۵۲۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ قَبْلَ أَنْ یَدْخُلَ بِہَا وَاحِدَۃً ثُمَّ غَشِیَہَا وَہُوَ یَرَی أَنَّ لَہُ عَلَیْہَا الرَّجْعَۃَ قَالَ : یُفَرَّقُ بَیْنَہُمَا وَلَہَا الصَّدَاقُ کَامِلاً۔",": No Data Available","Musannaf Ibn Abi Shaybah 17522","","","كتاب النكاح"
"17523","(۱۷۵۲۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ: لَہَا صَدَاقٌ وَنِصْفٌ وَقَالَ الْحَکَمُ: لَہَا الصَّدَاقُ۔","","Musannaf Ibn Abi Shaybah 17523","","","كتاب النكاح"
"17524","(۱۷۵۲۴) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ الْمُثَنَّی ، عَنْ عَطَائٍ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ ثَلاَثًا وَجَہِلَ فَأَصَابَہَا قَالَ : لَہَا الصَّدَاقُ کَامِلاً۔","","Musannaf Ibn Abi Shaybah 17524","","","كتاب النكاح"
"17525","(۱۷۵۲۵) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَطَائٍ قَالَ : لَہَا صَدَاقٌ وَنِصْفٌ۔","","Musannaf Ibn Abi Shaybah 17525","","","كتاب النكاح"
"17526","(۱۷۵۲۶) حَدَّثَنَا حَفْصٌ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ قَالَ : صَدَاقٌ وَنِصْفُ۔","","Musannaf Ibn Abi Shaybah 17526","","","كتاب النكاح"
"17527","(۱۷۵۲۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : سُئِلَ عَمَّنْ تَزَوَّجَ امْرَأَۃً فَطَلَّقَہَا قَبْلَ أَنْ یَمَسَّہَا ثُمَّ قِیلَ لَہُ : إنَّہَا لَمْ تَحْرُمْ عَلَیْکَ فَدَخَلَ بِہَا بِالنِّکَاحِ الأَوَّلِ فَمَکَثَتْ عِنْدَہُ سَنَتَیْنِ فَوَلَدَتْ لَہُ أَوْلاَدًا فَعَلِمَ بِذَلِکَ أَنَّہَا عَلَیْہِ حَرَامٌ قَالَ : یُفَرَّقُ بَیْنَہُمَا وَیُعْطِی الْمَرْأَۃَ بِنِکَاحِہَا الأَوَّلِ نِصْفَ مَہْرِہَا ومن دُخُولِہِ بِہَا وَمُجَامَعَتِہِ إیَّاہَا مَہْرًا کَامِلاً۔","","Musannaf Ibn Abi Shaybah 17527","","","كتاب النكاح"
"17528","(۱۷۵۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : لَہَا الصَّدَاقُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17528","","","كتاب النكاح"
"17529","(۱۷۵۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : لَہَا صَدَاقٌ وَنِصْفُ۔","","Musannaf Ibn Abi Shaybah 17529","","","كتاب النكاح"
"17530","(۱۷۵۳۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ وَمِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ أَنَّ أَمَۃً أُعْتِقَتْ فَاخْتَارَتْ نَفْسَہَا قَبْلَ أَنْ یُدْخَلَ بِہَا قَالَ : لاَ شَیْئَ لَہَا ، لاَ یُجْمَعُ عَلَیْہِ أَمْرٌ یَذْہَبُ بِنَفْسِہَا وَمَالِہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17530","","","كتاب النكاح"
"17531","(۱۷۵۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ : إذَا أُعْتِقَتِ الأَمَۃُ وَہِیَ تَحْتَ الْعَبْدِ فَخُیِّرَتْ فَاخْتَارَتْ نَفْسَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا فَلاَ صَدَاقَ لَہَا وَہِیَ تَطْلِیقَۃٌ بَائِنَۃٌ۔","","Musannaf Ibn Abi Shaybah 17531","","","كتاب النكاح"
"17532","(۱۷۵۳۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ تزَوَّجَ أَمَتَہُ عَلَی مَہْرٍ مُسَمًّی ثُمَّ أَعْتَقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا زَوْجُہَا فَتُخَیَّرُ فَتَخْتَارُ نَفْسَہَا قَالَ : یَبْطُلُ النِّکَاحُ وَیُرَدُّ عَلَی الزَّوْجِ مَہْرُہُ۔","","Musannaf Ibn Abi Shaybah 17532","","","كتاب النكاح"
"17533","(۱۷۵۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا اخْتَارَتْ نَفْسَہَا وَقَدْ أُعْتِقَتْ قَبْلَ أَنْ یَدْخُلَ بِہَا فَلاَ صَدَاقَ لَہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17533","","","كتاب النكاح"
"17534","(۱۷۵۳۴) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ ہِشَامٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ قَالَ : لاَ شَیْئَ لَہَا۔","","Musannaf Ibn Abi Shaybah 17534","","","كتاب النكاح"
"17535","(۱۷۵۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ قَالَ : لاَ یَسَعُہَا أَنْ تَقَارَّہُ حَتَّی تُرَافِعَہُ إلَی السُّلْطَانِ فَإِمَّا حَدٌّ وَإِمَّا مُلاَعَنَۃٌ۔","","Musannaf Ibn Abi Shaybah 17535","","","كتاب النكاح"
"17536","(۱۷۵۳۶) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا أکْذَبَ نَفْسَہُ عِنْدَ رَہْطٍ تَسَاکَنَا وَاسْتَغْفَرَ رَبَّہُ وَلاَ یَعُودُ لِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17536","","","كتاب النكاح"
"17537","(۱۷۵۳۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : إذَا قَذَفَہَا بِالزِّنَا إِنْ شَائَ أَکْذَبَ نَفْسَہُ وَجُلِدَ وَرُدَّتْ إلَیْہِ امْرَأَتُہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17537","","","كتاب النكاح"
"17538","(۱۷۵۳۸) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، عَنِ الشَّعْبِیِّ فِی الرَّجُلِ یَقْذِفُ امْرَأَتَہُ بِالزِّنَا ثُمَّ لاَ تُرَافِعُہُ قَالَ : یُکَذِّبُ نَفْسَہُ وَہُمَا عَلَی نِکَاحِہِمَا۔","","Musannaf Ibn Abi Shaybah 17538","","","كتاب النكاح"
"17539","(۱۷۵۳۹) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ قَالَ لَہَا نِصْفُ الصَّدَاقِ وَلاَ مِیرَاثَ لَہَا ، وَلاَ عِدَّۃَ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 17539","","","كتاب النكاح"
"17540","(۱۷۵۴۰) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 17540","","","كتاب النكاح"
"17541","(۱۷۵۴۱) حَدَّثَنَا عَبْدَۃُ وَمُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : لَہَا نِصْفُ الصَّدَاقِ وَلاَ مِیرَاثَ لَہَا وَلاَ عِدَّۃَ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 17541","","","كتاب النكاح"
"17542","(۱۷۵۴۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ أَنَّہُ کَانَ یَقُولُ : إذَا طَلَّقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا وَہُوَ مَرِیضٌ فَإِنَّہَا لاَ تَرِثُہُ وَلاَ عِدَّۃَ عَلَیْہَا وَلَہَا نِصْفُ الصَّدَاقِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17542","","","كتاب النكاح"
"17543","(۱۷۵۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ أَنَّہُ قَالَ : لَہَا الصَّدَاقُ کَامِلاً وَلاَ مِیرَاثَ لَہَا وَلاَ عِدَّۃَ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 17543","","","كتاب النكاح"
"17544","(۱۷۵۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ أَنَّہُ کَانَ یَقُولُہُ۔","","Musannaf Ibn Abi Shaybah 17544","","","كتاب النكاح"
"17545","(۱۷۵۴۵) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ قَالَ : لَہَا الصَّدَاقُ کَامِلاً وَلَہَا الْمِیرَاثُ وَعَلَیْہَا الْعِدَّۃُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17545","","","كتاب النكاح"
"17546","(۱۷۵۴۶) حَدَّثَنَا جَرِیرٌ ، عَنِ الْمُغِیرَۃِ ، عَنِ الْحَارِثِ قَالَ : إذَا طَلَّقَ امْرَأَتَہُ فِی مَرَضِہِ ثَلاَثًا ، أَوْ تَطْلِیقَۃً قَبْلَ أَنْ یَدْخُلَ بِہَا فَلاَ مِیرَاثَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17546","","","كتاب النكاح"
"17547","(۱۷۵۴۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ قَالَ : إذَا طَلَّقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا فَلاَ مِیرَاثَ لَہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17547","","","كتاب النكاح"
"17548","(۱۷۵۴۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سَیْفٍ ، عَنِ ابْنِ أَبِی نُجَیْحٍ ، عَنْ مُجَاہِدٍ أَنَّہُ کَرِہَ أَنْ یَتَزَوَّجَ الرَّجُلُ امْرَاَۃَ زَوْجِ أُمِّہِ قَالَ : وَکَانَ طَاوُوْسٌ وَعَطَاء لاَ یَرَیَانِ بِہِ بَأْسًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17548","","","كتاب النكاح"
"17549","(۱۷۵۴۹) حَدَّثَنَا وَکِیْعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ : لاَ بَأسَ أَنْ یَتَزَوَّجَ الرَّجُلُ امْرَاَۃَ زَوْجِ أُمِّہِ۔","","Musannaf Ibn Abi Shaybah 17549","","","كتاب النكاح"
"17550","(۱۷۵۵۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَبِیبِ بْنُ أَبِی حَبِیبٍ ، عَنْ عَمْرِو بنِ ہَرِمٍ ، عَنْ جَابِرٍ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ : لاَ تُزَاحِمْ مَنْ زَاحَمَ أَبُوکَ ، زَوْجَ أُمِّکَ۔",": Hasan","Musannaf Ibn Abi Shaybah 17550","","","كتاب النكاح"
"17551","(۱۷۵۵۱) حدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الْمَرْأَۃِ تَزَوَّج وَلَہَا زَوْجٌ قَالَ : إِنْ جَائَتْ بِہِ وَہُوَ یَشُکُّ فِیْہِ فَہُوَ للأَوَّلِ ، وَإِنْ جَائَتْ بِہِ وَہُوَ لاَ یَشُکُّ فِیْہِ فَہُوَ لِلآخَرِ۔","","Musannaf Ibn Abi Shaybah 17551","","","كتاب النكاح"
"17552","(۱۷۵۵۲) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ وَتَزَوَّجَہَا آخَرٌ فی عدتہا وَقَدْ حَاضَتْ حَیْضَۃً : الوَلَدُ لِلآخَرِ۔","","Musannaf Ibn Abi Shaybah 17552","","","كتاب النكاح"
"17553","(۱۷۵۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ مُجَاہِدٍ قَالَ : إذَا قَبَّلَہَا ، أَوْ لَمَسَہَا ، أَوْ نَظَرَ إلَی فَرْجِہَا حَرُمَتْ عَلَیْہِ ابْنَتُہَا۔","","Musannaf Ibn Abi Shaybah 17553","","","كتاب النكاح"
"17554","(۱۷۵۵۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا قَبَّلَ الأُمَّ لَمْ تَحِلَّ لَہُ ابْنَتُہَا وَإِذَا قَبَّلَ ابْنَتَہَا لَمْ تَحِلَّ لَہُ أُمُّہَا۔","","Musannaf Ibn Abi Shaybah 17554","","","كتاب النكاح"
"17555","(۱۷۵۵۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُقَبِّلُ الْمَرْأَۃَ ، أَوْ یَلْمِسُہَا ، أَوْ یَأْتِیہَا فِی غَیْرِ فَرْجِہَا ، إِنْ شَائَ تَزَوَّجَہَا ، وَإِنْ شَائَ تَزَوَّجَ ابْنَتَہَا ، وَإِنْ کَانَتِ الْبِنْتَ ، تَزَوَّجَ الأُمَّ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 17555","","","كتاب النكاح"
"17556","(۱۷۵۵۶) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ وَأَبِی ہَاشِمٍ قَالاَ : فِی الرَّجُلِ یُقَبِّلُ أم امْرَأتہ ، أَوِ ابْنَتَہَا ، قَالاَ : حَرُمَتْ عَلَیْہِ امرأتہ۔","","Musannaf Ibn Abi Shaybah 17556","","","كتاب النكاح"
"17557","(۱۷۵۵۷) حَدَّثَنَا شَرِیکٌ ، عَنِ السُّدِّیِّ ، عَنْ أَبِی مَالِکٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ أَنْ یَنْظُرَ الْمَمْلُوکُ إلَی شَعْرِ مَوْلاَتِہِ۔",": Hasan","Musannaf Ibn Abi Shaybah 17557","","","كتاب النكاح"
"17558","(۱۷۵۵۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ تَضَعَ الْمَرْأَۃُ ثَوْبَہَا عِنْدَ مَمْلُوکِہَا ، وَإِنْ کَانَ یُکْرَہُ أَنْ یَرَی شَعْرَہَا۔","","Musannaf Ibn Abi Shaybah 17558","","","كتاب النكاح"
"17559","(۱۷۵۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ أَنَّہُمَا کَرِہَا أَنْ یَرَی الْعَبْدُ شَعْرَ مَوْلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 17559","","","كتاب النكاح"
"17560","(۱۷۵۶۰) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : تَسْتَتِرُ الْمَرْأَۃُ مِنْ غُلاَمِہَا۔","","Musannaf Ibn Abi Shaybah 17560","","","كتاب النكاح"
"17561","(۱۷۵۶۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، عَنْ طَارِقٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : لاَ تَغُرَّنَّکُمْ ہَذِہِ الآیَۃُ : {إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} إنَّمَا عَنَی بِہَا الإِمَائَ وَلَمْ یَعْنِ بِہَا الْعَبِیدَ۔","","Musannaf Ibn Abi Shaybah 17561","","","كتاب النكاح"
"17562","(۱۷۵۶۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ أَنَّہُ کَرِہَ أَنْ یَدْخُلَ الْمَمْلُوکُ عَلَی مَوْلاَتِہِ بِغَیْرِ إذْنِہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17562","","","كتاب النكاح"
"17563","(۱۷۵۶۳) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ جُوِیبرٍ ، عَنِ الضَّحَّاکِ أَنَّہُ کَرِہَ أَنْ یَنْظُرَ الْمَمْلُوکُ إلَی شَعْرِ مَوْلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 17563","","","كتاب النكاح"
"17564","(۱۷۵۶۴) حَدَّثَنَا جَرَیْرٌ ، عَنْ مُغِیْرَۃُ ، عَنِ الشَّعْبِیِّ أَنَّہُ کَرِہَ أَنْ یُسِفَّ الرَّجُلُ النَّظَرَ إِلَی أُخْتِہِ أَو ابْنَتِہِ۔","","Musannaf Ibn Abi Shaybah 17564","","","كتاب النكاح"
"17565","(۱۷۵۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ أَنَّہُ کَرِہَ أَنْ یَنْظُرَ الرَّجُلُ إلَی شَعْرِ ابْنَتِہِ ، أَوْ أُخْتِہِ۔","","Musannaf Ibn Abi Shaybah 17565","","","كتاب النكاح"
"17566","(۱۷۵۶۶) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی الرَّجُلِ یَرَی مِنَ النِّسَائِ مَا یُحَرِّمُ عَلَیْہِ نِکَاحَہُ رُؤُوسُہُنَّ یَسْتَتِرْنَ أَحَبُّ إلَیَّ ، وَإِنْ رَأَی فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 17566","","","كتاب النكاح"
"17567","(۱۷۵۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی الْبَخْتَرِیِّ ، عَنْ أَبِی صَالِحٍ أَنَّ الْحَسَنَ وَالْحُسَیْنَ کَانَا یَدْخُلاَنِ عَلَی أُخْتِہِمَا أُمِّ کُلْثُومٍ وَہِیَ تمتشط۔",": Sahih","Musannaf Ibn Abi Shaybah 17567","","","كتاب النكاح"
"17568","(۱۷۵۶۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الْمَرْأَۃِ تَضَعُ خِمَارَہَا عِنْدَ أَخِیہَا قَالَ وَاللَّہِ مَا لَہَا ذَاکَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17568","","","كتاب النكاح"
"17569","(۱۷۵۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ أَنَّہُ کَرِہَ أَنْ یَنْظُرَ إلَی شَعَرِ کُلِّ ذِی مَحْرَمٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17569","","","كتاب النكاح"
"17570","(۱۷۵۷۰) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَنْ مُوَرِّقٍ أَنَّہُ کَانَ یُفَلِّی أُمَّہُ۔","","Musannaf Ibn Abi Shaybah 17570","","","كتاب النكاح"
"17571","(۱۷۵۷۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ أَنَّ طَلْقًا کَانَ یُذَوِّبُ أُمَّہُ۔","","Musannaf Ibn Abi Shaybah 17571","","","كتاب النكاح"
"17572","(۱۷۵۷۲) حَدَّثَنَا وکیع عن شریک عن رجل عن الضحاک أنہ کان یمشط أمہ۔","","Musannaf Ibn Abi Shaybah 17572","","","كتاب النكاح"
"17573","(۱۷۵۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ أَنَّہُ قَالَ : لاَ بَأْسَ أَنْ یَنْظُرَ إلَی شَعْرِ أُمِّہِ وَأَنْ تَسْتَتِرَ أَحَبُّ إلَیَّ۔","","Musannaf Ibn Abi Shaybah 17573","","","كتاب النكاح"
"17574","(۱۷۵۷۴) حَدَّثَنَا یَعْلَی ، عَنْ سُفْیَانَ ، عَنْ مُزَاحِمِ بْنِ زُفَرَ ، عَنِ الضَّحَّاکِ قَالَ : لَوْ دَخَلْتُ عَلَی أُمِّی لَقُلْت : أَیَّتُہَا الْعَجُوزُ ، غَطِّی رَأْسَک۔","","Musannaf Ibn Abi Shaybah 17574","","","كتاب النكاح"
"17575","(۱۷۵۷۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ سُفْیَانَ ، عَنْ سَالِمِ بْنِ أَبِی حَفْصَۃَ ، عَنْ مُنْذِرٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ أَنَّہُ کَانَ یُذَوِّبُ أُمَّہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17575","","","كتاب النكاح"
"17576","(۱۷۵۷۶) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ ، عَنْ مُزَاحِمٍ ، عَنِ الضَّحَّاکِ قَالَ: لَوْ دَخَلْتُ عَلَی أُمِّی لَقُلْت : غَطِّی رَأْسَکِ۔","","Musannaf Ibn Abi Shaybah 17576","","","كتاب النكاح"
"17577","(۱۷۵۷۷) حَدَّثَنَا وَکِیعٌ ، وَابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزَّعْرَائِ ، عَنْ عِکْرِمَۃَ قَالَ : مُبَاشَرَۃُ الرَّجُلِ أُخْتَہُ أو أُمَّہُ شُعْبَۃٌ مِنَ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17577","","","كتاب النكاح"
"17578","(۱۷۵۷۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ قَالَ : کَانَ الْحَسَنُ وَالْحُسَیْنُ لاَ یَرَیَانِ أُمَّہَاتِ الْمُؤْمِنِینَ ، وَکَانَ ابْنُ عَبَّاسٍ یَرَی أَنَّ رُؤْیَتَہُنَّ لَہُمَا حِلٌّ۔",": Hasan","Musannaf Ibn Abi Shaybah 17578","","","كتاب النكاح"
"17579","(۱۷۵۷۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ قَالَ : قُلْتُ لِسَعِیدِ بْنِ جُبَیْرٍ أَیَرَی الرَّجُلُ رَأْسَ خَتَِنَتِہِ قَالَ : فَتَلاَ عَلَیَّ الآیَۃَ: {وَلاَ یُبْدِینَ زِینَتَہُنَّ إلاَّ لِبُعُولَتِہِنَّ ، أَوْ آبَائِہِنَّ ، أَوْ آبَائِ بُعُولَتِہِنَّ ، أَوْ أَبْنَائِہِنَّ ، أَوْ أَبْنَائِ بُعُولَتِہِنَّ ، أَوْ إخْوَانِہِنَّ ، أَوْ بَنِی إخْوَانِہِنَّ ، أَوْ بَنِی أَخَوَاتِہِنَّ} الآیَۃَ ، فَقَالَ : أَرَاہَا فِیہِنَّ۔",": Sahih","Musannaf Ibn Abi Shaybah 17579","","","كتاب النكاح"
"17580","(۱۷۵۸۰) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ قَالَ : أَخْبَرَنَا دَاوُد ، عَنِ الشَّعْبِیِّ ، وَعِکْرِمَۃَ فِی ہَذِہِ : {وَلاَ یُبْدِینَ زِینَتَہُنَّ إلاَّ لِبُعُولَتِہِنَّ ، أَوْ آبَائِہِنَّ ، أَوْ آبَائِ بُعُولَتِہِنَّ} حَتَّی فَرَغَ مِنْہَا قَالاَ : لَمْ یُذْکَرَ الْعَمُّ وَالْخَالُ لأَنَّہُمَا ینعتان لأَبْنَائِہِمَا وَقَالاَ : لاَ تَضَعُ خِمَارَہَا عِنْدَ الْعَمِّ وَالْخَالِ۔","","Musannaf Ibn Abi Shaybah 17580","","","كتاب النكاح"
"17581","(۱۷۵۸۱) حَدَّثَنَا عَبَّادُ بْنُ العَوَّامِ ، عَنْ صَخْرِ بْنُ جُوَیْرِیَۃَ ، عَنْ نَافِعٍ أَنَّ ابْنَ عُمَرَ سُئِلَ عَنِ امْرَأَۃٍ أَحَلَّتْ جَارِیَتَہَا لِزَوْجِہَا ، فَقَالَ ابْنُ عُمَرَ لاَ أَدْرِی ، لَعَلَّ ہَذَا لَوْ کَانَ عَلَی عَہْدِ عُمَرَ لَرَجَمَہُ ، إنَّہَا لاَ تَحِلُّ لَکَ جَارِیَۃٌ إلاَّ جَارِیَۃً إِنْ شِئْتَ بِعْتہَا ، وَإِنْ شِئْتَ أَعْتَقْتہَا ، وَإِنْ شِئْتَ وَہَبْتہَا ، وَإِنْ شِئْتَ أَنْکَحْتہَا مَنْ شِئْت۔",": Sahih","Musannaf Ibn Abi Shaybah 17581","","","كتاب النكاح"
"17582","(۱۷۵۸۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : لاَ یَحِلُّ فَرْجٌ إلاَّ بِمِلْکٍ ، أَوْ نِکَاحٍ ، إِنْ طَلَّقَ جَازَ ، وَإِنْ أَعْتَقَ جَازَ ، وَإِنْ وَہَبَ جَازَ۔",": Hasan","Musannaf Ibn Abi Shaybah 17582","","","كتاب النكاح"
"17583","(۱۷۵۸۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : سَأَلْتُہ عَنِ امْرَأَۃٍ تُحِلُّ وَلِیدَتَہَا لابْنِہَا قَالَ : لاَ تَحِلُّ لَہُ إلاَّ بِنِکَاحٍ ، أَوْ بِہِبَۃٍ ، أَوْ بِشِرَائٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17583","","","كتاب النكاح"
"17584","(۱۷۵۸۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ قَالَ : لاَ یُعَارُ الْفَرْجُ ، وَإِنْ وَقَعَ عَلَیْہَا فَہِیَ لَہُ۔","","Musannaf Ibn Abi Shaybah 17584","","","كتاب النكاح"
"17585","(۱۷۵۸۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی الرَّجُلِ قَالَ لآخَرَ : جَارِیَتِی لَکَ تَطَؤُہَا فَإِنْ حَمَلَتْ فَہِیَ لَکَ ، وَإِنْ لَمْ تَحْمِلْ رَدَدْتہَا عَلَیَّ ، قَالَ : إذَا وَطِئَہَا فَہِیَ لَہُ۔","","Musannaf Ibn Abi Shaybah 17585","","","كتاب النكاح"
"17586","(۱۷۵۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ وَعَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالاَ : إذَا أُحِلَّ لَہُ فَرْجُہَا فَہِیَ لَہُ۔","","Musannaf Ibn Abi Shaybah 17586","","","كتاب النكاح"
"17587","(۱۷۵۸۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ مُطَرِّفٍ ، عَنْ رَجُلٍ ، عَنْ إبْرَاہِیمَ فِی امْرَأَۃٍ أَحَلَّتْ لِرَجُلٍ جَارِیَتَہَا فَوَلَدَتْ مِنْہُ ، فَقَالَ إبْرَاہِیمُ : ہَذَا فَرْجٌ أَتَاہُ بِجَہَالَۃٍ فَأُلْحِقْ بِہِ الْوَلَدَ وَادْفَعْ إلَی ہَذِہِ وَلِیدَتَہَا۔","","Musannaf Ibn Abi Shaybah 17587","","","كتاب النكاح"
"17588","(۱۷۵۸۸) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ قَالَ : الْفَرْجُ لاَ یُعَارُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17588","","","كتاب النكاح"
"17589","(۱۷۵۸۹) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ قَالَ : حدَّثَنِی مُوسَی بْنُ خَیْشُومٍ قَالَ سَأَلَ عِکْرِمَۃَ رَجُلٌ قَالَ : أَمَۃٌ لِصَاحِبَتِی أَحَلَّتْہَا لِی قَالَ : لاَ تَحِلُّ لَکَ إلاَّ أَنْ تَمْلِکَ رَقَبَتَہَا۔","","Musannaf Ibn Abi Shaybah 17589","","","كتاب النكاح"
"17590","(۱۷۵۹۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَقَعُ عَلَی مُکَاتَبَتِہِ قَالَ یَحسبُ لَہَا صَدَاقُ مِثْلِہَا۔",": Hasan","Musannaf Ibn Abi Shaybah 17590","","","كتاب النكاح"
"17591","(۱۷۵۹۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ قَالَ : إذَا غَشِیَ مُکَاتَبَتَہُ فَہِیَ أُمُّ وَلَدِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17591","","","كتاب النكاح"
"17592","(۱۷۵۹۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنِ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ فِی رَجُل وَطِیئَ مُکَاتَبَتَہُ قَالَ إِنْ کَانَ اسْتَکْرَہَہَا فَعَلَیْہِ الْعُقْرُ وَالْحَدُّ ، وَإِنْ کَانَتْ طَاوَعَتْہُ فَعَلَیْہِ الْحَدُّ وَلَیْسَ عَلَیْہِ الْعُقْرُ۔","","Musannaf Ibn Abi Shaybah 17592","","","كتاب النكاح"
"17593","(۱۷۵۹۳) حَدَّثَنَا ابْنُ إدْرِیسَ قَالَ: کَانَ ابْنُ أَبِی لَیْلَی یَقُولُ: تَعُودُ الْمُکَاتَبَۃُ فَتَکُونُ أُمَّ وَلَدٍ یَعْنِی إذَا وَطِئَہَا فَوَلَدَتْ۔","","Musannaf Ibn Abi Shaybah 17593","","","كتاب النكاح"
"17594","(۱۷۵۹۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ فِی الرَّجُلِ یُکَاتِبُ امْرَأَتَہُ وَیَشْتَرِطُ عَلَیْہَا فِی الْمُکَاتَبَۃِ أَنْ یَطَأَہَا قَالَ : لاَ بَأْسَ بِہِ ، لَہُ شَرْطُہُ وَلَہُ أَنْ یَطَأَہَا۔","","Musannaf Ibn Abi Shaybah 17594","","","كتاب النكاح"
"17595","(۱۷۵۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْن أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ فِی رَجُلٍ وَطِیئَ مُکَاتَبَتَہُ ، فَقَالَ : مَا رَقَّ مِنْہَا مہر لِمَا أُعْتِقَ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 17595","","","كتاب النكاح"
"17596","(۱۷۵۹۶) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ قَالَ : لَیْسَ عَلَی زَانٍ عُقْرٌ۔","","Musannaf Ibn Abi Shaybah 17596","","","كتاب النكاح"
"17597","(۱۷۵۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا ، عَنْ عَبْدِ رَجُلٍ اسْتَکْرَہَ حُرَّۃً قَالاَ: لاَ عُقْرَ عَلَیْہِ، لاَ یَضُرُّک حُرَّۃً کَانَتْ ، أَوْ أَمَۃً۔",": No Data Available","Musannaf Ibn Abi Shaybah 17597","","","كتاب النكاح"
"17598","(۱۷۵۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ وَعَنْ رَجُلٍ ، عَنِ الزُّہْرِیِّ قَالاَ : إِنْ کَانَتْ بِکْرًا فَالْعُقْرُ وَالْحَدُّ ، وَإِنْ کَانَتْ ثَیِّبًا فَالْحَدُّ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17598","","","كتاب النكاح"
"17599","(۱۷۵۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ یَجْتَمِعُ حَدٌّ وَلاَ صَدَاقٌ عَلَی زَانٍ۔","","Musannaf Ibn Abi Shaybah 17599","","","كتاب النكاح"
"17600","(۱۷۶۰۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا أَوْقَعْتُ عَلَیْہِ الْحَدَّ لَمْ آخُذْ مِنْہُ الْعُقْرَ۔","","Musannaf Ibn Abi Shaybah 17600","","","كتاب النكاح"
"17601","(۱۷۶۰۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ یَزِیْدَ بْنِ مُعْنِق قَالَ : قَالَ ابْنُ عُمَرَ : لأَنْ یجعل فِی رَأْسِی مِخْیَطٌ حَتَّی یخبو أَحَبُّ إلَیَّ مِنْ أَنْ تُقَبِّلَ رَأْسِی امْرَأَۃٌ لَیْسَتْ بِمَحْرَمٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 17601","","","كتاب النكاح"
"17602","(۱۷۶۰۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : لأَنْ یثقب القمل دِمَاغ رَجُلٍ خَیْرٌ لَہُ مِنْ أَنْ تُفَلیہ امْرَأَۃٌ یَحِلُّ لَہُ نِکَاحُہَا ، قَالَ : وَذَکَرَ أَنَّ امْرَأَۃً کَانَتْ تُفَلِّی مَرَّۃ رَجُلاً فَقَبَّلَتْہُ۔","","Musannaf Ibn Abi Shaybah 17602","","","كتاب النكاح"
"17603","(۱۷۶۰۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : لاَ یَحِلُّ لِأَمْرَأَۃٍ تَغْسِلُ رَأْسَ رَجُلٍ لَیْسَ بَیْنَہَا وَبَیْنَہُ مَحْرَمٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17603","","","كتاب النكاح"
"17604","(۱۷۶۰۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ بَشِیرِ بْنِ عُقْبَۃَ قَالَ : حدَّثَنِی یَزِیدُ بْنُ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، عَنْ مَعْقِلِ بْنِ یَسَارٍ قَالَ : لأَنْ یَعْمِدَ أَحَدُکُمْ إلَی مِخْیَطٍ فَیَغْرِزُ بِہِ فِی رَأْسِی أَحَبُّ إلَیَّ مِنْ أَنْ تَغْسِلَ رَأْسِی امْرَأَۃٌ لَیْسَتْ مِنِّی ذَاتَ مَحْرَمٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 17604","","","كتاب النكاح"
"17605","(۱۷۶۰۵) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، قَالَ : سَمِعْتُ قَتَادَۃَ یَقُولُ : سَافَرْت مَعَ امْرَأَۃٍ إلَی مَکَّۃَ نَصَفَ وَإِنَّ فِیہَا لَبَقیۃً فَکَانَتْ تَغْسِلُ رَأْسِی ، أَوْ تُفَلِّی رَأْسِی۔","","Musannaf Ibn Abi Shaybah 17605","","","كتاب النكاح"
"17606","(۱۷۶۰۶) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ سُفْیَانَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، عَنْ أَبِی مُوسَی قَالَ : أَتَیْتُ امْرَأَۃً مِنْ قَوْمِی فَغَسَلَتْ ثِیَابِی وَمَشَطَتْ رَأْسِی۔",": Sahih","Musannaf Ibn Abi Shaybah 17606","","","كتاب النكاح"
"17607","(۱۷۶۰۷) حدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ عَنِ الْحَسَنِ فِی الرَّجُلِ یَتَزَوَّجُ الأَمَۃَ قَالَ : لَیْسَ لَہُ أَنْ یُخْرِجَہَا مِنَ المِصْرِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17607","","","كتاب النكاح"
"17608","(۱۷۶۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عَطَائٍ وَمَکْحُولٍ قَالاَ : لَیْسَ لَہُمْ بُدٌّ من أَنْ یَسْتَخْدِمُوہَا۔","","Musannaf Ibn Abi Shaybah 17608","","","كتاب النكاح"
"17609","(۱۷۶۰۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ بْنِ مُوسَی ، عَنِ ابْنِ قُسَیْطٍ أَنَّ سعِیدَ بْنَ الْمُسَیَّبِ سُئِلَ عَنْ رَجُلٍ بُشِّرَ بِجَارِیَۃٍ ، فَقَالَ بَعْضُ الْقَوْمِ : ہَبْہَا لِی ، فَقَالَ سَعِیدُ بْنُ الْمُسَیَّبِ ، لَمْ تَحِلَّ الْمَوْہُوبَۃُ لأَحَدٍ بَعْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَلَوْ أَصْدَقَہَا سَوْطًا حَلَّتْ لَہُ۔","","Musannaf Ibn Abi Shaybah 17609","","","كتاب النكاح"
"17610","(۱۷۶۱۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ قَالَ : لاَ یَحِلُّ لأَحَدٍ أَنْ یَہَبَ ابْنَتَہُ بِغَیْرِ مَہْرٍ إلاَّ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17610","","","كتاب النكاح"
"17611","(۱۷۶۱۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا ، عَنْ رَجُلٍ وَہَبَ ابْنَتَہُ لِرَجُلٍ فَقَالاَ : لاَ یَجُوزُ إلاَّ بِصَدَاقٍ۔","","Musannaf Ibn Abi Shaybah 17611","","","كتاب النكاح"
"17612","(۱۷۶۱۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عُبیدِ اللہِ بْنِ عُبَیْدٍ قَالَ : سُئِلَ مَکْحُولٌ ، عَنِ الرَّجُلِ یَہَبُ أُخْتَہُ ، أَوِ ابْنَتَہُ لِلرَّجُل وَلاَ یَفْرِضُ لَہَا صَدَاقًا ، فَقَالَ مَکْحُولٌ وَالزُّہْرِیُّ : لَمْ تَحِلَّ الْمَوْہُوبَۃُ لأَحَدٍ بَعْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 17612","","","كتاب النكاح"
"17613","(۱۷۶۱۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : أَیُّمَا امْرَأَۃٍ وَہَبَہَا أَبُوہَا لِرَجُلٍ ، أَوْ وَہَبَتْ نَفْسَہَا لِرَجُلٍ فَلَہَا مہر مِثْلُہَا إِنْ دَخَلَ بِہَا ، وَإِلاَّ فَإِنَّمَا عَلَیْہِ الْمُتْعَۃُ إِنْ طَلَّقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا۔","","Musannaf Ibn Abi Shaybah 17613","","","كتاب النكاح"
"17614","(۱۷۶۱۴) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ قَالَ : سُئِلَ عَطَائٌ ، عَنِ امْرَأَۃٍ وَہَبَتْ نَفْسَہَا لِرَجُلٍ قَالَ : لاَ یَکُونُ إلاَّ بِصَدَاقٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 17614","","","كتاب النكاح"
"17615","(۱۷۶۱۵) حَدَّثَنَا عَبدَۃ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ أَنَّہَا قَالَتْ : مَا تَسْتَحِی امْرَأَۃٌ أَنْ تَہَبَ نَفْسَہَا لِرَجُلٍ حَتَّی أَنْزَلَ اللَّہُ تَعَالَی : {تُرْجِی مَنْ تَشَائُ مِنْہُنَّ وَتُؤْوِی إلَیْک مَنْ تَشَائُ} قَالَتْ : فَقُلْتُ: إنَّ رَبَّک لَیُسَارِعُ لَکَ فِی ہَوَاک۔ (بخاری ۵۱۱۳۔ مسلم ۵۰)","","Musannaf Ibn Abi Shaybah 17615","","","كتاب النكاح"
"17616","(۱۷۶۱۶) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی امْرَأَۃٍ وَہَبَتْ نَفْسَہَا لِرجُلٍ ، فَقَالَ : لاَ یَصْلُحُ إلاَّ بِصَدَاقٍ ، لَمْ یَکُنْ ذَلِکَ إلاَّ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 17616","","","كتاب النكاح"
"17617","(۱۷۶۱۷) حَدَّثَنَا ہُشَیْم ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِیْمَنْ تَزَوَّجَ ذَاتَ مَحْرَمٍ مِنْہُ فَدَخَلَ بَہَا قَالَ : لَہَا الصَّدَاقُ۔","","Musannaf Ibn Abi Shaybah 17617","","","كتاب النكاح"
"17618","(۱۷۶۱۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أنہ قَالَ : لَہَا مَا أَخَذَتْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17618","","","كتاب النكاح"
"17619","(۱۷۶۱۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ مِثْلَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17619","","","كتاب النكاح"
"17620","(۱۷۶۲۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ قَالَ : لاَ صَدَاقَ لَہَا دَخَلَ بِہَا ، أَوْ لَمْ یَدْخُلْ بِہَا ، أَیَصْدُقُ الرَّجُلُ أُخْتَہُ ، أَوْ أُمَّہُ ؟۔","","Musannaf Ibn Abi Shaybah 17620","","","كتاب النكاح"
"17621","(۱۷۶۲۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ تَزَوَّجَ أُخْتَہُ فِی الرَّضَاعَۃِ وَہُوَ لاَ یَعْلَمُ ثُمَّ عَلِمَ بَعْدَ ذَلِکَ قَالَ : بَطَلَ النِّکَاحُ فَإِنْ دَخَلَ بِہَا فَلَہَا الصَّدَاقُ بِمَا اسْتَحَلَّ مِنْ فَرْجِہَا ، وَإِنْ لَمْ یَکُنْ دَخَلَ بِہَا فُرِّقَ بَیْنَہُمَا وَلاَ صَدَاقَ۔","","Musannaf Ibn Abi Shaybah 17621","","","كتاب النكاح"
"17622","(۱۷۶۲۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ مَطَرٍ ، عَنِ الْحَکَمِ فِی رَجُلٍ تَزَوَّجَ أُخْتَہُ ، أَوْ أُخْتَ امْرَأَتِہِ مِنَ الرَّضَاعَۃِ فَدَخَلَ بِہَا وَہُوَ لاَ یَشْعُرُ قَالَ : لَہَا الصَّدَاقُ کَامِلاً۔",": No Data Available","Musannaf Ibn Abi Shaybah 17622","","","كتاب النكاح"
"17623","(۱۷۶۲۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ مَطَرٍ ، عَنِ الْحَسَنِ قَالَ : لَہَا الصَّدَاقُ بما أحدث۔","","Musannaf Ibn Abi Shaybah 17623","","","كتاب النكاح"
"17624","(۱۷۶۲۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ قَالَ : کُلُّ جِمَاعٍ دُرِئَ فِیہِ الْحَدُّ فَفِیہِ الصَّدَاقُ کَامِلاً۔","","Musannaf Ibn Abi Shaybah 17624","","","كتاب النكاح"
"17625","(۱۷۶۲۵) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً فَإِذَا ہِیَ أُخْتُہُ مِنَ الرَّضَاعَۃِ فَأَصَابَہَا وَلَمْ یَشْعُرْ بِہَا قَالَ : یُفَرَّقُ بَیْنَہُمَا وَلَیْسَ لَہَا الصَّدَاقُ کُلُّہُ ، لَہَا بَعْضُہُ۔","","Musannaf Ibn Abi Shaybah 17625","","","كتاب النكاح"
"17626","(۱۷۶۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیْمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَزَوَّجَہَا وَہِیَ ابْنَۃُ تِسْعٍ وَمَاتَ عَنْہَا وَہِیَ ابْنَۃُ ثَمَانَ عَشَرَۃَ۔ (مسلم ۷۲۔ احمد ۴۲)",": Sahih","Musannaf Ibn Abi Shaybah 17626","","","كتاب النكاح"
"17627","(۱۷۶۲۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ أَنَّ الزُّبَیْرَ زَوَّجَ ابْنَۃً لَہُ صَغِیرَۃً حِینَ نُفِسَتْ یَعْنِی حِینَ وُلِدَتْ۔",": Sahih","Musannaf Ibn Abi Shaybah 17627","","","كتاب النكاح"
"17628","(۱۷۶۲۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ أَنَّہُ زَوَّجَ ابْنًا لَہُ ابْنَۃً لِمُصْعَبٍ صَغِیرَۃً۔","","Musannaf Ibn Abi Shaybah 17628","","","كتاب النكاح"
"17629","(۱۷۶۲۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّ عُمَرَ خَطَبَ إلَی عَلِیٍّ ابْنَتَہُ أُمَّ کُلْثُومٍ ، فَقَالَ عَلِیٌّ : إنَّہَا صَغِیرَۃٌ فَانْظُرْ إلَیْہَا ، فَأَرْسَلَہَا إلَیْہِ بِرِسَالَۃٍ فَمَازَحَہَا ، فَقَالَتْ : لَوْلاَ أَنَّک شَیْخٌ ، أَوْ لَوْلاَ أَنَّک أَمِیرُ الْمُؤْمِنِینَ فَأَعْجَبَ عُمَرَ مُصَاہَرَتُہُ فَخَطَبَہَا فَأَنْکَحَہَا إیَّاہُ۔",": Hasan","Musannaf Ibn Abi Shaybah 17629","","","كتاب النكاح"
"17630","(۱۷۶۳۰) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ، عَنِ ابْنِ جُرَیْجٍ، عَنِ ابْنِ طَاوُوسٍ، عَنْ أَبِیہِ أَنَّہُ کَانَ یَکْرَہُ نِکَاحَ الصَّغِیرَیْنِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17630","","","كتاب النكاح"
"17631","(۱۷۶۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ قَالَ : کَانَ الحسن لاَ یُعْجِبُہُ نِکَاحُ الصِّغَارِ۔","","Musannaf Ibn Abi Shaybah 17631","","","كتاب النكاح"
"17632","(۱۷۶۳۲) حَدَّثَنَا مُحَمَّدُ بِنُ فُضَیْلٍ ، عَنْ یَزِیْدَ بِنْ أَبِی زِیَادٍ ، عَنْ زَیْدٍ بِنْ وَہْبٍ قَالَ : کَتَبَ إلَیْنَا عُمَرُ إِنَّ الأَعْرَابِیَّ لاَ یَنْکِحُ الْمُہَاجِرَۃَ ، یُخْرِجَہَا مِنْ دَارِ الْہِجْرَۃِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17632","","","كتاب النكاح"
"17633","(۱۷۶۳۳) حَدَّثَنَا عَبَّادُ بِنَ العَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ الحَسَنِ أَنَّہُ کَرِہَ أَنْ یَتَزَوَّجَ الأَعْرَابِیُّ المُہَاجِرَۃَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17633","","","كتاب النكاح"
"17634","(۱۷۶۳۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ مُحَمَّدٍ بِنْ سَالِمٍ ، عَنِ الشَّعْبِیِّ أَنَّہُ کَرِہَ أَنْ یَتَزَوَّجَ الأَعْرَابِیُّ المُہَاجِرَۃَ لِیُخْرِجَہَا مِنَ المِصْرِ۔","","Musannaf Ibn Abi Shaybah 17634","","","كتاب النكاح"
"17635","(۱۷۶۳۵) حَدَّثَنَا عَبِیْدَۃُ بِنْ حُمَیْدٍ ، عَنِ الرَّکِیْنِ ، عَنْ أَبِیہِ قَالَ : خَطَبَ مَنْظُوْرُ بِنْ زَبَّان إِلَی خَالِہِ وَکَانَا حَاجَّیْنِ ، أَوْ مُعْتَمِرَیْنِ فَقَالَ : نَعَمْ إَذَا رَجَعْتُ أَنْکَحْتُکَ ، فَخَرَجَ إِلَیْہَا أَخُوْہَاَ ابْنُ أُمِّہَا وَأَبِیْہَا فَأَنْکَحَہَا ابْنَ خَالِہَا فَقَدِمَ وَقَد أنکحت ، فَغَضِبَ أَبُوہَا غَضَبًا شَدِیْدًا وَقَالَ : إِنِّی أبرأ إِلَی اللہِ مِنْ ہَذَا النِّکَاحِ ، إِنِّی سَمِعْتُ عُمَرَ یَقُوْلُ : لاَ یُنْکَحُ المُہَاجِرَاتُ الأَعْرَابَ۔",": Da'if","Musannaf Ibn Abi Shaybah 17635","","","كتاب النكاح"
"17636","(۱۷۶۳۶) حَدَّثَنَا ابْنُ إدْرِیس ، عَنِ ابْنِ جُرَیْجٍ ، عن الزہری ، عَنْ عَمْرِو بْنِ الشَّرِیدِ قَالَ : سُئِلَ ابْنُ عَبَّاسٍ ، عَنْ رَجُلٍ لَہُ امْرَأَۃٌ وَسُرِّیَّۃٌ ولدت إحْدَاہُمَا غُلاَمًا وَأَرْضَعَتْ إحْدَاہُمَا جَارِیَۃً ہَلْ یَصْلُحُ لِلْغُلاَمِ أَنْ یَتَزَوَّجَ الْجَارِیَۃَ ؟ قَالَ : لاَ ، اللِّقَاحُ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 17636","","","كتاب النكاح"
"17637","(۱۷۶۳۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ أَنَّہُ کَرِہَ لَبَنَ الْفَحْلِ وَکَرِہَ قَوْلَ إبْرَاہِیمَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 17637","","","كتاب النكاح"
"17638","(۱۷۶۳۸) حَدَّثَنَا ہُشَیْمٌ ، وَابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَرِہَہُ یَعْنِی لَبَنَ الْفَحْلِ۔","","Musannaf Ibn Abi Shaybah 17638","","","كتاب النكاح"
"17639","(۱۷۶۳۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبْدِ اللہِ بْنِ سَبْرَۃَ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 17639","","","كتاب النكاح"
"17640","(۱۷۶۴۰) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : کَانَ یَرَی لَبَنَ الْفَحْلِ یُحَرِّم۔",": No Data Available","Musannaf Ibn Abi Shaybah 17640","","","كتاب النكاح"
"17641","(۱۷۶۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سفیان ، عَنْ خُصَیْفٍ ، عَنْ سَالِمٍ أنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 17641","","","كتاب النكاح"
"17642","(۱۷۶۴۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ قَالَ : سَأَلْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ : قُلْتُ امْرَأَۃ أَبِی أَرْضَعَتْ جَارِیَۃً مِنْ عَرَضِ النَّاسِ بِلِبَانِ إخْوَتِی مِنْ أَبِی ، تَحِلُّ لِی ؟ قَالَ : لاَ ، أَبُوک أَبُوہَا ، وَسَأَلْت طَاوُوسًا ، فَقَالَ مِثْلَ ذَلِکَ وَسَأَلْت الْحَسَنَ ، فَقَالَ مِثْلَ ذَلِکَ وَسَأَلْت مُجَاہِدًا ، فَقَالَ : اخْتَلَفَ فِیہِ النَّاسُ وَلاَ أَقُولُ فِیہَا شَیْئًا وَسَأَلْت ابْنَ سِیرِینَ ، فَقَالَ مِثْلَ قَوْلِ مُجَاہِدٍ۔","","Musannaf Ibn Abi Shaybah 17642","","","كتاب النكاح"
"17643","(۱۷۶۴۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ قَالَ : ذَکَرْت ذَلِکَ لِمُحَمَّدِ بْنِ سِیرِینَ ، فَقَالَ نُبِّئْت أَنَّ أُنَاسًا مِنْ أَہْلِ الْمَدِینَۃِ اخْتَلَفُوا فِیہِ فَمِنْہُمْ مَنْ کَرِہَہُ وَمِنْہُمْ مَنْ لَمْ یَکْرَہْہُ وَمَنْ کَرِہَ أَفْضَلُ فِی أَنْفُسِنَا مِمَّنْ لَمْ یَکْرَہْہُ ، وَکَانَ الْقَاسِمُ بْنُ مُحَمَّدٍ فِیمَنْ یَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 17643","","","كتاب النكاح"
"17644","(۱۷۶۴۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو قَالَ : قدِمَ الزُّہْرِیُّ المدینۃ فِی أَوَّلِ خِلاَفَۃِ ہِشَامٍ فَذَکَرَ أَنَّ عُرْوَۃَ کَانَ یُحَدِّثُ ، عَنْ عَائِشَۃَ أَنَّ أَبَا الْقُعَیْسِ جَائَ یَسْتَأْذِنُ عَلَی عَائِشَۃَ وَقَدْ أَرْضَعَتْہُمَا امْرَأَۃُ أَخِیہِ فَأَبَتْ أَنْ تَأْذَنَ لَہُ فَزَعَمَ عُرْوَۃُ أَنَّ عَائِشَۃَ ذَکَرَتْ ذَلِکَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : فَہَلاَّ أَذِنْت لَہُ ؟ فَإِنَّ الرَّضَاعَۃَ تُحَرِّمُ مَا تُحَرِّمُ الْوِلاَدَۃُ فَفَزِعَ أَہْلُ الْمَدِینَۃِ لِذَلِکَ فَطَلَّقَ عَبْدُ اللہِ بْنُ أَبِی حَبِیبَۃَ مَوْلَی الزُّبَیْرِ امْرَأَتَہُ عِنْدَ ذَلِکَ۔",": Hasan","Musannaf Ibn Abi Shaybah 17644","","","كتاب النكاح"
"17645","(۱۷۶۴۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : ذُکِرَ لَبَنُ الْفَحْلِ ، فَقَالَ وَقَدْ کَرِہَہُ أُنَاسٌ وَرَخَّصَ فِیہِ أُنَاسٌ ، فَکَانَ مَنْ کَرِہَہُ عِنْدَ النَّاسِ أَفْضَلُ ، وَکَانَ الْقَاسِمُ بْنُ مُحَمَّدٍ مِمَّنْ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 17645","","","كتاب النكاح"
"17646","(۱۷۶۴۶) حَدَّثَنَا مَالِکٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ ہِشَامٍ أَنَّ أَبَاہُ کَرِہَ لَبَنَ الْفَحْلِ۔","","Musannaf Ibn Abi Shaybah 17646","","","كتاب النكاح"
"17647","(۱۷۶۴۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی عُبَیدَۃَ بْنِ عَبْدِ اللہِ بْنِ زَمْعَۃَ عَن أُمِہ زَینَب ابنَۃ أَبِی سَلَمَۃَ قَالَت : کَانَتْ أَسْمَائُ أَرْضَعَتْنِی ، وَکَانَ الزُّبَیْرُ یَدْخُلُ عَلَیَّ وَأَنَا أَمْتَشِطُ وَیَأْخُذُ الْقَرْنَ مِنْ قُرُونِی وَیَقُولُ : أَقْبِلِی عَلیَّ فحدثنی بربی أنَّہُ أَبِی وَأن مَا وَلَدَ إخْوَتِی ، فَلَمَّا کَانَ یوم الْحَرَّۃِ أَرْسَلَ عَبْدُ اللہِ بْنُ الزُّبَیْرِ یَخْطُبُ ابْنَتِی عَلَی حَمْزَۃَ بن الزُّبَیْر وَحَمْزَۃُ وَمُصْعَبٌ لِلْکَلْبِیَّۃِ فَأَرْسَلْت إلَیْہِ : ہَلْ تَصْلُحُ لَہُ ؟ فَأَرْسَلَ إلَیَّ : إنَّمَا تُرِیدِینَ مَنْعِی بِنْتَکِ وَأَنَا أَخُوک ، وَمَا وَلَدَتْ أَسْمَائُ فَہُمْ إخْوَتُک وما وَلَدُ الزُّبَیْرِ لِغَیْرِ أَسْمَائَ فَلَیْسَ لَکَ بِإِخْوَۃٍ فَأَرْسِلِی فَسَلِی فَأَرْسَلْتُ فَسَأَلْتُ وَأَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُتَوَافِرُونَ وَأُمَّہَاتُ الْمُؤْمِنِینَ فَقَالُوا : إنَّ الرَّضَاعَۃَ مِنْ قِبَلِ الرِّجَالِ لاَ تُحَرِّمُ شَیْئًا۔",": Hasan","Musannaf Ibn Abi Shaybah 17647","","","كتاب النكاح"
"17648","(۱۷۶۴۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْطٍ قَالَ : سَأَلْتُ أَبَا سَلَمَۃَ بْنَ عَبْدِ الرَّحْمَنِ وَسَعِیدَ بْنَ الْمُسَیَّبِ وَعَطَائً وَسُلَیْمَانَ ابْنَی یَسَارٍ ، عَنِ الرَّضَاعَۃِ مِنْ قِبَلِ الرِّجَالِ فَقَالُوا : لاَ تُحَرِّمُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 17648","","","كتاب النكاح"
"17649","(۱۷۶۴۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو قَالَ : حدَّثَنِی آل رَافِعِ بْنِ خَدِیجٍ أَنَّ رَافِعَ بْنَ خَدِیجٍ زَوَّجَ ابْنَتَہُ ابْنَ أَخِیہِ رِفَاعَۃَ بْنِ خَدِیجٍ وَقَدْ أَرْضَعَتْہَا أُمُّ وَلَدٍ لَہُ سِوَی أُمِّ ابنہِ الَّذِی أَنْکَحَہَا إیَّاہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 17649","","","كتاب النكاح"
"17650","(۱۷۶۵۰) حَدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ وَعَنْ جَابِرٍ ، عَنْ عَامِرٍ أَنَّہُمَا کَانَا لاَ یَرَیَانِ لَبَنَ الْفَحْلِ شَیْئًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17650","","","كتاب النكاح"
"17651","(۱۷۶۵۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ أَنَّہُ لَمْ یَرَ بِلَبَنِ الْفَحْلِ بَأْسًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17651","","","كتاب النكاح"
"17652","(۱۷۶۵۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ قَالَ : أَوَّلُ مَا سَمِعْت بِلَبَنِ الْفَحْلِ وَنَحْنُ بِمَکَّۃَ فَجَعَلَ إیَاسُ بْنُ مُعَاوِیَۃَ یَقُولُ : وَمَا بَأْسُ ہَذَا وَمَنْ یَکْرَہُ ہَذَا ؟۔","","Musannaf Ibn Abi Shaybah 17652","","","كتاب النكاح"
"17653","(۱۷۶۵۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ لاَ یَرَی لَبَنَ الْفَحْلِ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 17653","","","كتاب النكاح"
"17654","(۱۷۶۵۴) حَدَّثَنَا عُبَید اللہِ بْنُ مُوسَی ، عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَکْحُولٍ أَنَّہُ کَانَ لاَ یَرَی بِلَبَنِ الْفَحْلِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 17654","","","كتاب النكاح"
"17655","(۱۷۶۵۵) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَہْلِ بْنِ سَعْدٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَرَّقَ بَیْنَ الْمُتَلاَعِنَیْنِ وَقَالَ حسَابُکُمَا عَلَی اللہِ۔ (بخاری ۶۸۵۴۔ ابوداؤد ۲۲۴۵)",": Sahih","Musannaf Ibn Abi Shaybah 17655","","","كتاب النكاح"
"17656","(۱۷۶۵۶) حَدَّثَنَا یَزِیدُ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَرَّقَ بَیْنَہُمَا وَقَضَی أَنْ لاَ قُوتَ لَہا عَلَیہ وَلاَ نَفَقَۃَ۔ (ابوداؤد ۲۲۵۰۔ طیالسی ۲۶۶۷)",": Da'if","Musannaf Ibn Abi Shaybah 17656","","","كتاب النكاح"
"17657","(۱۷۶۵۷) حَدَّثَنَا حَفْصٌ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ، عَنْ عُمَرَ، قَالَ: الْمُتَلاَعِنَانِ یُفَرَّقُ بَیْنَہُمَا وَلاَ یَجْتَمِعَانِ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 17657","","","كتاب النكاح"
"17658","(۱۷۶۵۸) حَدَّثَنَا وَکِیعٌ، عَنْ قَیْسٍ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَلِیٍّ وعَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ قَالاَ: لاَ یَجْتَمِعَا الْمُتَلاَعِنَانِ أَبَدًا۔",": Da'if","Musannaf Ibn Abi Shaybah 17658","","","كتاب النكاح"
"17659","(۱۷۶۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : الْمُتَلاَعِنَانِ لاَ یَجْتَمِعَا فِی مِصْرٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 17659","","","كتاب النكاح"
"17660","(۱۷۶۶۰) حَدَّثَنَا حَفْصٌ قَالَ : سَأَلْتُ عَمرًا ، فَقَالَ : کَانَ الْحَسَنُ یُفَرِّقُ بَیْنَہُمَا فَلاَ یَجْتَمِعَانِ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 17660","","","كتاب النكاح"
"17661","(۱۷۶۶۱) حَدَّثَنَا جَرِیرٌ عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا لاَعَنَ الرَّجُلُ امْرَأَتَہُ فُرِّقَ بَیْنَہُمَا فَلاَ یَجْتَمِعَانِ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 17661","","","كتاب النكاح"
"17662","(۱۷۶۶۲) حَدَّثَنَا یَزِیدُ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : لاَ یَجْتَمِعَانِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17662","","","كتاب النكاح"
"17663","(۱۷۶۶۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ قَالَ : لاَ یَجْتَمِعَانِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17663","","","كتاب النكاح"
"17664","(۱۷۶۶۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ قَالَ : لاَ یَجْتَمِعَانِ۔","","Musannaf Ibn Abi Shaybah 17664","","","كتاب النكاح"
"17665","(۱۷۶۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ قَالَ : الْمُتَلاَعِنَانِ لاَ یَجْتَمِعَانِ۔","","Musannaf Ibn Abi Shaybah 17665","","","كتاب النكاح"
"17666","(۱۷۶۶۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ إِسْحَاقَ ، عَنِ ابْنِ شِہَابٍ قَالَ : مَضَتِ السُّنَّۃُ أَنَّہُمَا إذَا فُرِّقَ بَیْنَہُمَا لَمْ یَجْتَمِعَا أَبَدًا۔","","Musannaf Ibn Abi Shaybah 17666","","","كتاب النكاح"
"17667","(۱۷۶۶۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : فِی رَجُلٍ لاَعَنَ ثُمَّ أَکْذَبَ نَفْسَہُ فِی الْعِدَّۃِ قَالَ : إذَا لاَعَنَ انْقَطَعَ مَا بَیْنَہُمَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17667","","","كتاب النكاح"
"17668","(۱۷۶۶۸) حدَّثَنَا حَفْصٌ، عَنْ دَاوُدَ، عَنِ سَعِیدِ بْنِ الْمُسَیَّبِ فِیَ المُلاَعِنِ یُکَذِّبُ نَفْسَہُ قَالَ: یُضْرَبُ وَہُوَ خَاطِب۔","","Musannaf Ibn Abi Shaybah 17668","","","كتاب النكاح"
"17669","(۱۷۶۶۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِنْ أَکْذَبَ نَفْسَہُ جُلِدَ وَأُلْزِقَ بِہِ الْوَلَدُ وَرُدَّتْ إلَیْہِ امْرَأَتُہُ۔","","Musannaf Ibn Abi Shaybah 17669","","","كتاب النكاح"
"17670","(۱۷۶۷۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ أَنہ سُئِلَ عَنِ الْمُتَلاَعِنَیْنِ ، فَقَالَ : یَتَزَوَّجُہَا إِنْ أَکْذَبَ نَفْسَہُ۔","","Musannaf Ibn Abi Shaybah 17670","","","كتاب النكاح"
"17671","(۱۷۶۷۱) حدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَمْرٍو، عَنْ سَعَیْدِ بِنْ جُبَیْرٍ، عَنِ ابْنِ عُمَرَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَرَّقَ بَیْنَ المُتَلاَعِنَیْنِ وَقَالَ : حِسَابُکُمَا عَلَی اللہِ ، أَحَدُکُمَا کَاذِبٌ لاَ سَبِیْلَ لَکَ عَلَیْہَا فَقَالَ : یَا رَسُوْلَ اللہِ! فَمَالِی؟ قَالَ: لاَ مَالَ لَکَ ، إِنْ کُنْتَ صَادِقَاً فَہُوَ بِمَا اسْتَحْلَلْتَ مِنْ فَرْجِہَا ، وَإِنْ کُنْتَ کَاذِبَاً فَذَلِکَ أَبْعَدُ لَکَ۔\n(بخاری ۵۳۵۰۔ مسلم ۵)",": Sahih","Musannaf Ibn Abi Shaybah 17671","","","كتاب النكاح"
"17672","(۱۷۶۷۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ سَعِیْدِ بِنِ جُبَیْرٍ أَنَّہُ فَرَّقَ بَیْنَ المُتَلاَعِنَیْنِ قَالَ : فَتَعَلَّقَ بِہَا فَقَالَ : مَالِی ، فَقُلْتُ لاَ مَالَ لَکَ ، قَالَ : فَانْطَلَقَ إِلَی أَبِی بُرْدَۃَ وَقَالَ : یَذْہَبُ مَالِی وَامْرَأَتِی جَمِیعًا ؟ قَالَ : لاَ ، قَالَ : إِنَّ الَّذِی أَمَرْتَہُ أَنْ یُلاَعِنَ بَیْنَنَا قَالَ لاَ شَیْئَ لَکَ ، قَالَ : وَفَعَلَ ذَلِکَ ؟ قَالَ : نَعَمْ! قَالَ : فَجِئْتُ قَالَ : فَقَالَ أَبُو بُرْدَۃَ : مَا یَقُوْلُ ہَذَا ؟ قَالَ : قُلْتُ : وَمَا یَقُوْلُ ؟ قَالَ : یَقُوْلُ : ذَہَبَتِ امْرَأَتُہُ وَمَالُہُ ، قَالَ : قُلْتُ : مَا یَحْمِلُ الفُسَّاقَ عَلَی أَنْ یَزْنُوا ؟ یَتَزَوَّجُ المَرْأَۃَ ثُمَّ یَقْذِفُہَا ثُمَّ یُلاَعِنُہَا ویَأْخُذُ مَالَہُ ؟ قَالَ : فَکَتَبَ بِہِ إِلَی الحَجَّاجِ قَالَ : فَقَالَ : صَدَقَ ، قَالَ : ثُمَّ إِنَّ رَجُلاً أَتَانِی ، قَالَ : فَظَنَنْتُ أَنَّ الحَجَّاجَ أَمَرَہُ ، فَقَالَ : الَّذِی قُلْتَ أَشَیْئٌ قُلْتَہُ بِرَأْیِکَ ، أَوْ شَیْئٌ بَلَغَکَ ؟ قُلْتُ : قَضَی بِہِ رَسُوْلُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی أُخْتِ بَنِی العَجْلاَن۔\n(بخاری ۵۳۴۹۔ مسلم ۴)","","Musannaf Ibn Abi Shaybah 17672","","","كتاب النكاح"
"17673","(۱۷۶۷۳) حَدَّثَنَا عِیْسَی بْنُ یُوْنُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بِنْ أَبِی کَثِیْرٍ أَنَّ عَلِیَّاً أُتِیَ فِیَ امْرَأَۃٍ تَزَوَّجَتْ رَجُلاً عَلَی أَنَّ عَلَیْہَا الصَّدَاقَ وبِیَدِہَا الفُرْقَۃُ والجِمَاعُ ، فَقَالَ عَلِیٌّ : خَالَفْتَ السُّنَّۃَ وَوَلَّیْتَ الأَمْرَ غَیْرَ أَہْلِہِ، عَلَیْکَ الصَّدَاقُ وَبِیَدِکَ الجِمَاعُ والفُرْقَۃُ ، وَلَکَ السُّنَّۃُ۔","","Musannaf Ibn Abi Shaybah 17673","","","كتاب النكاح"
"17674","(۱۷۶۷۴) حَدَّثَنَا غُنْدَرٌ عَنْ أَشْعَثَ ، عَنِ الحَسَنِ قَالَ : لَیْسَ لِلنِّسَائِ أَنْ یَصْدُقْنَ الرِّجَالَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17674","","","كتاب النكاح"
"17675","(۱۷۶۷۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَمَّادِ بْنِ أبِی الدَّرْدَائِ قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنْ رَجُلٍ زَوَّجَ أُخْتَاً لَہُ بِوَاسِطَۃٍ فَکَرِہَتْ قَالَ: ہِیَ أَحَقُّ بِنَفْسِہَا قُلْتُ: إِنَّہُ أَخُوْہَا لأَبِیْہَا وَأُمِّہَا۔ قَالَ: ہِیَ أَحَقُّ بِنَفْسِہَا مِنْ أَبِیْہَا إِذَا کَرِہَتْ۔","","Musannaf Ibn Abi Shaybah 17675","","","كتاب النكاح"
"17676","(۱۷۶۷۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الحَسَنِ فِی رَجُلٍ زَوَّجَ أُخْتَہُ وأَبُوہَا غَائِبٌ قَالَ : الأَمْرُ إِلَی أَبِیْہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17676","","","كتاب النكاح"
"17677","(۱۷۶۷۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ بَکْرٍ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ قَالَ : خَطَبْت امْرَأَۃً ، فَقَالَ لِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ہَلْ نَظَرْت إلَیْہَا ؟ قُلْتُ : لاَ ، قَالَ : فَانْظُرْ إلَیْہَا ، فَإِنَّہُ أَحْرَی أَنْ یُؤْدَمَ بَیْنَکُمَا۔\n(ترمذی ۱۰۸۷۔ ابن ماجہ ۱۸۶۵)","","Musannaf Ibn Abi Shaybah 17677","","","كتاب النكاح"
"17678","(۱۷۶۷۸) حَدَّثَنَا یُونُسُ بن مُحَمَّدٍ قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنِ زِیَاد قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ دَاوُدَ بْنِ الْحُصَیْنِ ، عَنْ وَاقِدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ سَعْدِ بْنِ مُعَاذٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا خَطَبَ أَحَدُکُمَ امْرَأَۃً فَإِنِ اسْتَطَاعَ أَنْ یَنْظُرَ مِنْہَا إلَی مَا یَدْعُوہُ إلَی نِکَاحِہَا فَلْیَفْعَلْ فَخَطَبْت جَارِیَۃً مِنْ بَنِی سَلِمَۃَ فَکُنْت أَتَخَبَّأُ تَحْتَ الْکَرَبِ حَتَّی نَظَرْت مِنْہَا إلَی مَا یَدْعُونِی إلَی نِکَاحِہَا فَتَزَوَّجْتہَا۔","","Musannaf Ibn Abi Shaybah 17678","","","كتاب النكاح"
"17679","(۱۷۶۷۹) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ مُحَمَّدِ بْنِ سُلَیْمَانَ ، عَنْ عَمِّہِ سَہْلِ بْنِ أَبِی حَثْمَۃَ ، عَنْ مُحَمَّدِ بْنِ مَسْلَمَۃَ قَالَ : خَطَبْت امْرَأَۃً فَجَعَلْتُ أَتَخَبَّأُ لَہَا حَتَّی نَظَرْت إلَیْہَا فِی نَخْلٍ لَہَا فَقِیلَ لہ: أَتَفْعَلُ ہَذَا وَأَنْتَ صَاحِبُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : فَقُلْتُ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إذَا أَلْقَی اللَّہُ فِی قَلْبِ امْرِئٍ مِنْکُمْ خِطْبَۃَ امْرَأَۃٍ فَلاَ بَأْسَ أَنْ یَنْظُرَ إلَیْہَا۔ (طبرانی ۵۰۰)",": Da'if","Musannaf Ibn Abi Shaybah 17679","","","كتاب النكاح"
"17680","(۱۷۶۸۰) حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنِ ابن طَاوُوسٍ قَالَ : أَرَدْت أَنْ أَتَزَوَّجَ امْرَأَۃً ، فَقَالَ لِی أَبِی : اذْہَبْ فَانْظُرْ إلَیْہَا قَالَ : فَلَبِسْت وَتَہَیَّأْت فَلَمَّا رَآنِی قَالَ : لاَ تَذْہَبْ۔","","Musannaf Ibn Abi Shaybah 17680","","","كتاب النكاح"
"17681","(۱۷۶۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ قَالَ : لاَ بَأْسَ أَنْ یَنْظُرَ إلَیْہَا قَبْلَ أَنْ یَتَزَوَّجَہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17681","","","كتاب النكاح"
"17682","(۱۷۶۸۲) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ زَمْعَۃَ ، عَنِ الزُّہْرِیِّ فِی الرَّجُلِ یَتَزَوَّجُ الْمَرْأَۃَ قَالَ : لاَ بَأْسَ أَنْ یَنْظُرَ إلَیْہَا قَبْلَ أَنْ یَتَزَوَّجَہَا لأَنَّ اللَّہَ عَزَّ وَجَلَّ یَقُولُ : {وَلَوْ أَعْجَبَک حُسْنُہُنَّ}۔","","Musannaf Ibn Abi Shaybah 17682","","","كتاب النكاح"
"17683","(۱۷۶۸۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عن سہل بن مُحَمَّدِ بْنِ أَبِی حَثْمَۃَ ، عَنْ عَمِّہِ سلیمان بْنِ أَبِی حَثْمَۃَ قَالَ : رَأَیْتُ مُحَمَّدَ بْنَ مَسْلَمَۃَ یُطَارِدُ نُبَیْتَۃَ بِنْتَ الضَّحَّاکِ وَہِیَ عَلَی إِنْجَارٍ مِنْ أَنَاجِیرِ الْمَدِینَۃِ بِبَصَرِہِ ، فَقُلْتُ : أَتَفْعَلُ ہَذَا ؟ قَالَ : نَعَمْ ، سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إذَا أَلْقَی اللَّہُ فِی قَلْبِ امْرِئٍ خِطْبَۃَ امْرَأَۃٍ فَلاَ بَأْسَ أَنْ یَنْظُرَ إلَیْہَا۔ (ابن حبان ۴۰۴۲)",": Da'if","Musannaf Ibn Abi Shaybah 17683","","","كتاب النكاح"
"17684","(۱۷۶۸۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ قَالَ : سَأَلْتُ عَبِیْدَۃَ ، عَنْ قَوْلِہِ : {فِی یَتَامَی النِّسَائِ اللاَّتِی لاَ تُؤْتُونَہُنَّ مَا کُتِبَ لَہُنَّ وَتَرْغَبُونَ أَنْ تَنْکِحُوہُنَّ} قَالَ : تَرْغَبُونَ فِیہِنَّ۔","","Musannaf Ibn Abi Shaybah 17684","","","كتاب النكاح"
"17685","(۱۷۶۸۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ فِی ہَذِہِ : تَرْغَبُونَ عَنْہُنَّ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17685","","","كتاب النكاح"
"17686","(۱۷۶۸۶) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ فِی قَوْلِہِ : {وَمَا یُتْلَی عَلَیْکُمْ فِی الْکِتَابِ فِی یَتَامَی النِّسَائِ اللاَّتِی لاَ تُؤْتُونَہُنَّ مَا کُتِبَ لَہُنَّ وَتَرْغَبُونَ أَنْ تَنْکِحُوہُنَّ} قَالَتْ : أُنْزِلَتْ فِی الْیَتِیمَۃِ تَکُونُ عِنْدَ الرَّجُلِ فَتَشْرَکُہُ فِی مَالِہِ فَیَرْغَبُ عَنْہا أَنْ یَتَزَوَّجَہَا وَیَکْرَہَ أَنْ یَتَزَوَّجَہَا غَیْرُہُ فَیَشْرَکَہُ فِی مَالِہِ فَیَعْضُلَہَا فَلاَ یَتَزَوَّجُہَا وَلاَ یُزَوِّجُہَا غَیْرَہُ۔ (بخاری ۵۱۳۱۔ مسلم ۲۳۱۵)",": Sahih","Musannaf Ibn Abi Shaybah 17686","","","كتاب النكاح"
"17687","(۱۷۶۸۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، عَنْ عُمَرَ ، قَالَ : مَنْ کَانَتْ عِنْدَہُ فِی حِجْرِہِ تَرَکَۃٌ بِہَا عُوَارٌ فَلْیَضُمَّہَا إلَیْہِ ، وَإِنْ کَانَتْ رَغبَۃً بِہِ فَلْیُزَوِّجْہَا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 17687","","","كتاب النكاح"
"17688","(۱۷۶۸۸) حَدَّثَنَا عُبَیْدُ اللہِ عن إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی سَلَمَۃَ : {وَتَرْغَبُونَ أَنْ تَنْکِحُوہُنَّ} قَالَ : الْمَرْأَۃُ یَکُونُ بِہَا عَرَجٌ ، أَوْ عَوَرٌ فَلاَ یَنْکِحُونَہَا حَتَّی یَرِثُوہَا۔","","Musannaf Ibn Abi Shaybah 17688","","","كتاب النكاح"
"17689","(۱۷۶۸۹) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ عَمَّارٍ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ : {وَمَا یُتْلَی عَلَیْکُمْ فِی الْکِتَابِ فِی یَتَامَی النِّسَائِ} قَالَ : مَا یُتْلَی عَلَیْکُمْ فِی أَوَّلِ السُّورَۃِ مِنَ الْمَوَارِیثِ ، وَکَانُوا لاَ یُوَرِّثُونَ امْرَأَۃً وَلاَ صَبِیًّا حَتَّی یَحْتَلِمَ۔","","Musannaf Ibn Abi Shaybah 17689","","","كتاب النكاح"
"17690","(۱۷۶۹۰) حَدَّثَنَا عُبَیْدُ اللہِ عن إسْرَائِیلَ ، عَنِ السُّدِّیِّ ، عَنْ أَبِی مَالِکٍ فِی قَوْلِ اللہِ : {وَمَا یُتْلَی عَلَیْکُمْ فِی الْکِتَابِ فِی یَتَامَی النِّسَائِ اللاَّتِی لاَ تُؤْتُونَہُنَّ مَا کُتِبَ لَہُنَّ وَتَرْغَبُونَ أَنْ تَنْکِحُوہُنَّ} ، فَقَالَ : کَانَتِ الْمَرْأَۃُ إذَا کَانَتْ عِنْدَ وَلِیٍّ رَغِبَ عَنْ حَسَبِہَا ، أَوْ حُسْنِہَا ، شَکَّ أَبُو بَکْرٍ ، ثُمَّ تَزَوَّجَہَا وَلَمْ یَتْرُکْ أَحَدًا یَتَزَوَّجُہَا : {وَالْمُسْتَضْعَفِینَ مِنَ الْوِلْدَانِ وَأَنْ تَقُومُوا لِلْیَتَامَی بِالْقِسْطِ} قَالَ : کَانُوا لاَ یُوَرِّثُونَ إلاَّ الأَکْبَرَ فَالأَکْبَرَ۔","","Musannaf Ibn Abi Shaybah 17690","","","كتاب النكاح"
"17691","(۱۷۶۹۱) حَدَّثَنَا أَبُو خَالِد الأَحْمَر، عَنْ حَجَّاجِ، عَنْ قَتَادَۃَ، عَنِ الحَسَنِ أَنَّہُ کَرِہَ ذَبَائِحَہُمْ وَنِسَائَہُمْ، یَعْنِی الصَّابِئِیْنَ۔","","Musannaf Ibn Abi Shaybah 17691","","","كتاب النكاح"
"17692","(۱۷۶۹۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی مَالِکٍ : {فَانْکِحُوا مَا طَابَ لَکُمْ مِنَ النِّسَائِ} قَالَ : مَا حَلَّ لَکُمْ مِنَ النِّسَائِ ، ذَلِکَ أَدْنَی أَلاَّ تَعُولُوا۔","","Musannaf Ibn Abi Shaybah 17692","","","كتاب النكاح"
"17693","(۱۷۶۹۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ { وَإِنْ خِفْتُمْ أَلاَّ تقْسِطُوا فِی الْیَتَامَی فَانْکِحُوا مَا طَابَ لَکُمْ مِنَ النِّسَائِ} یَقُولُ : مَا أَحْلَلْت لَکُمْ۔",": Sahih","Musannaf Ibn Abi Shaybah 17693","","","كتاب النكاح"
"17694","(۱۷۶۹۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ : { وَإِنْ خِفْتُمْ أَلاَّ تُقْسِطُوا فِی الْیَتَامَی} قَالَ : کَانَ الرَّجُلُ مِنْ قُرَیْشٍ یَکُونُ عِنْدَہُ النِّسْوَۃُ وَیَکُونُ عِنْدَہُ الأَیْتَامُ فَیَذْہَبُ مَالُہُ فَیَمِیلُ عَلَی الأَیْتَامِ فَنَزَلَتْ ہَذِہِ الآیَۃُ : {فَانْکِحُوا مَا طَابَ لَکُمْ مِنَ النِّسَائِ}۔","","Musannaf Ibn Abi Shaybah 17694","","","كتاب النكاح"
"17695","(۱۷۶۹۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ قَالَ : قَوْلُہُ : {وَالْمُحْصَنَاتُ مِنَ الَّذِینَ أُوتُوا الْکِتَابَ مِنْ قَبْلِکُمْ} قَالَ : إِحْصَانُ الیَہُوْدِیَۃِ وَالنَّصْرَانِیَۃِ أَنْ تَغْتَسِلَ مِنَ الجَنَابَۃِ وأَنْ تُحْصِنَ فَرْجَہَا۔","","Musannaf Ibn Abi Shaybah 17695","","","كتاب النكاح"
"17696","(۱۷۶۹۶) حَدَّثَنَا إدْرِیسُ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قولہ : {وَالْمُحْصَنَاتُ مِنَ الَّذِینَ أُوتُوا الْکِتَابَ مِنْ قَبْلِکُمْ} قَالَ: العَفَائِفُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17696","","","كتاب النكاح"
"17697","(۱۷۶۹۷) حدَّثَنَا ابْنُ إِدْرِیْسُ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ قَالَ: {عَلِمَ اللّہُ أَنَّکُمْ سَتَذْکُرُونَہُنَّ} قَالَ: ذِکْرُہُ إِیَّاہَا فِی نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 17697","","","كتاب النكاح"
"17698","(۱۷۶۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیْدَ ، عَنِ الحَسَنِ : {عَلِمَ اللّہُ أَنَّکُمْ سَتَذْکُرُونَہُنَّ} قَالَ : فِیَ الخِطْبَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17698","","","كتاب النكاح"
"17699","(۱۷۶۹۹) أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ إِسْمَاعِیْل بِنْ رَافِعٍ ، عَنْ زَیْدِ بِنْ أَسْلَمَ ، قَالَ : سَمِعْتُہ یَقُوْلُ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ نَکَحَ امْرَأَۃً وَہُوَ یُرِیْدُ أَنْ یَذْہَبَ بِمَہْرِہَا فَہُوَ عِنْدَ اللہِ زَانٍ یَوْمَ القِیَامَۃِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17699","","","كتاب النكاح"
"17700","(۱۷۷۰۰) حَدَّثَنَا وَکِیْعٌ ، عَنْ مَالِکِ بِنِ مِغْوَلٍ ، عَنْ أُمِّ ہَمَدَانَ ، عَنْ عَمَّتِہَا ، عَنْ عَائِشَۃَ وَأُمِّ سَلَمَۃَ قَالَتَا : لَیْسَ شَیْئٌ أَشَدُّ مِنْ مَہْرِ امْرَأَۃٍ ، أَوْ أَجْرِ أَجِیْرٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 17700","","","كتاب النكاح"
"17701","(۱۷۷۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ ، عَنِ الحَکَمِ قَالَ: لاَ بأْسَ أَنْ یَتَزَوَّجَہا عَلَی مَا بَقِیَ مِنْ کِتَابَتِہَا۔","","Musannaf Ibn Abi Shaybah 17701","","","كتاب النكاح"
"17702","(۱۷۷۰۲) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ ہُرَیْمِ ، عَنْ بَیَانٍ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ عَبَّاسٍ : {ذَلِکَ أَدْنَی أَنْ لاَ تَعُولُوا} قَالَ : تَمِیلُوا۔",": Sahih","Musannaf Ibn Abi Shaybah 17702","","","كتاب النكاح"
"17703","(۱۷۷۰۳) حَدَّثَنَا جَرِیرٌ، عَنْ مُفَضَّلِ بْنِ مُہَلْہِلٍ، عَنْ مُغِیرَۃَ، عَنْ أَبِی رَزِینٍ {ذَلِکَ أَدْنَی أَنْ لاَ تَعُولُوا} قَالَ: تَمِیلُوا۔","","Musannaf Ibn Abi Shaybah 17703","","","كتاب النكاح"
"17704","(۱۷۷۰۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یُونُسَ ، عَنْ مُجَاہِدٍ : {ذَلِکَ أَدْنَی أَنْ لاَ تَعُولُوا} قَالَ : تَمِیلُوا۔","","Musannaf Ibn Abi Shaybah 17704","","","كتاب النكاح"
"17705","(۱۷۷۰۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ قُرَّۃَ ، عَنِ الْحَسَنِ : {ذَلِکَ أَدْنَی أَنْ لاَ تَعُولُوا} قَالَ : تَمِیلُوا۔","","Musannaf Ibn Abi Shaybah 17705","","","كتاب النكاح"
"17706","(۱۷۷۰۶) حَدَّثَنَا عَثَّام بْنُ عَلِیٍّ وَمُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی مَالِکٍ : {ذَلِکَ أَدْنَی أَنْ لاَ تَعُولُوا} قَالَ : تَمِیلُوا۔","","Musannaf Ibn Abi Shaybah 17706","","","كتاب النكاح"
"17707","(۱۷۷۰۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ جُوَیْبِر ، عَنِ الضَّحَّاکِ : {ذَلِکَ أَدْنَی أَنْ لاَ تَعُولُوا} قَالَ : تَمِیلُوا۔","","Musannaf Ibn Abi Shaybah 17707","","","كتاب النكاح"
"17708","(۱۷۷۰۸) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ وَعَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالاَ : یَجُوزُ تَزْوِیجُ الْمَرِیضِ وَبَیْعُہُ وَشِرَاؤُہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17708","","","كتاب النكاح"
"17709","(۱۷۷۰۹) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ فِی الْمَرِیضِ ہُوَ یَتَزَوَّجُ؟ قَالَ: ہُوَ جَائِزٌ مِنْ غَیْرِ الثَّلاَثِ۔","","Musannaf Ibn Abi Shaybah 17709","","","كتاب النكاح"
"17710","(۱۷۷۱۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ قَالَ : أَرَادَ عَبْدُ الرَّحْمَنِ ابْنُ أُمِّ الْحَکَمِ أَنْ یَشْتَرِیَ ثُمُنَہُ مِنْ بِنْتِ جَرِیرٍ وَہُوَ مَرِیضٌ فَأَبَتْ فَتَزَوَّجَ عَلَیْہَا ثَلاَثًا وَہُوَ مَرِیضٌ فَجَازَ۔","","Musannaf Ibn Abi Shaybah 17710","","","كتاب النكاح"
"17711","(۱۷۷۱۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ قَالَ : إنَّ مُعَاوِیَۃَ أَجَازَہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 17711","","","كتاب النكاح"
"17712","(۱۷۷۱۲) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ الْبَاہِلِیِّ قَالَ : سَأَلْتُ عَطَائً عَنْ رَجُلٍ یَتَزَوَّجُ وَہُوَ مَرِیضٌ أَیَجُوزُ ذَلِکَ ؟ فَقَالَ : إنَّ النَّاسَ یَقُولُونَ إنَّہُ یَجُوزُ۔","","Musannaf Ibn Abi Shaybah 17712","","","كتاب النكاح"
"17713","(۱۷۷۱۳) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ یَتَزَوَّجُ وَہُوَ مَرِیضٌ قَالَ : إِنْ کَانَ مُضَارًّا لَمْ یَجُزْ ، وَإِنْ کَانَ إنَّمَا تَزَوَّجَہَا لِتَقُومَ عَلَیْہِ فَہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 17713","","","كتاب النكاح"
"17714","(۱۷۷۱۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الْخَالِقِ ، عَنْ حَمَّادٍ فِی الرَّجُلِ یَتَزَوَّجُ فِی مَرَضِہِ قَالَ : ہُوَ مِنْ ثُلُثہ۔","","Musannaf Ibn Abi Shaybah 17714","","","كتاب النكاح"
"17715","(۱۷۷۱۵) حَدَّثَنَا أَبُو عَاصِمٍ ، عَنِ ابْنِ جُرَیْجٍ قَالَ : سَأَلْتُ عَطَائً ، عَنِ الْمَرِیضِ یَتَزَوَّجُ ؟ قَالَ : مَا أَرَاہُ إلاَّ حَدَثًا۔","","Musannaf Ibn Abi Shaybah 17715","","","كتاب النكاح"
"17716","(۱۷۷۱۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ فِی الرَّجُلِ یَتَزَوَّجُ فِی مَرَضہ قَالَ : لاَ یَجُوزُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17716","","","كتاب النكاح"
"17717","(۱۷۷۱۷) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ خَلِیفَۃَ بْنِ غَالِبٍ قَالَ : سَأَلْتُ نَافِعًا عَنْہُ ، فَقَالَ : ہُوَ جَائِزٌ وَتَرِثُہُ وَتَأْخُذُ صَدَاقَہَا۔","","Musannaf Ibn Abi Shaybah 17717","","","كتاب النكاح"
"17718","(۱۷۷۱۸) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ خَلِیفَۃَ بْنِ غَالِبٍ ، عَنْ نَافِعٍ أَنَّ ابْنَ أَبِی رَبِیعَۃَ تَزَوَّجَ وَہُوَ مَرِیضٌ أَرَادَ أَنْ تَرِثَہُ ، وَکَانَ بَیْنَہُ وَبَیْنَہَا قَرَابَۃٌ۔","","Musannaf Ibn Abi Shaybah 17718","","","كتاب النكاح"
"17719","(۱۷۷۱۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیْدٍ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوْقٍ قَالَ : کَانَتِ المَرْأَۃُ إِذَا ذَہَبَتْ إِلَی المُشْرِکِیْنَ أَعْطَوْا زَوْجَہَا مِثْلَ مَہْرِہَا وَإِذَا ذَہَبَتْ إِلَی قَوْمٍ لَیْسَ بَیْنَہَا وَبَیْنَہُمْ عَہْدٌ مِنَ المُشْرِکِیْنَ {فَعَاقَبْتُمْ} فَأَصَبْتُمْ غَنِیْمَۃً {فَآتُوا الَّذِینَ ذَہَبَتْ أَزْوَاجُہُم مِّثْلَ مَا أَنفَقُوا} یَقُوْلُ : ٰاتُوْا زَوْجَہَا مِنَ الغَنِیْمَۃِ مِثْلَ مَہْرِہَا۔","","Musannaf Ibn Abi Shaybah 17719","","","كتاب النكاح"
"17720","(۱۷۷۲۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیْدٍ ، عَنْ سُفْیَانَ ، عَنْ خَصِیْفٍ ، عَنْ مُجَاہِدٍ مِثْلَہُ ، أَوْ نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 17720","","","كتاب النكاح"
"17721","(۱۷۷۲۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُخْتَارِ بْنِ منیح ، عَنْ قَتَادَۃَ ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَخَیَّرُوا لِنُطَفِکُمْ (ابن عدی ۲۱۸۷)",": Da'if","Musannaf Ibn Abi Shaybah 17721","","","كتاب النكاح"
"17722","(۱۷۷۲۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیم أَنَّ عَلْقَمَۃَ کَانَ إذَا تَزَوَّجَ تَزَوَّجَ إلَی أَدْنَی بَیْتَۃٍ۔","","Musannaf Ibn Abi Shaybah 17722","","","كتاب النكاح"
"17723","(۱۷۷۲۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ الرَّبَذِیِّ ، عَنْ عَبْدِ اللہِ بْنِ خِرَاشٍ قَالَ : رَأَیْتُ أَبَا ذَرٍّ بِالرَّبَذَۃِ وَعِنْدَہُ امْرَأَۃٌ لَہُ سَحْمَائُ ، أَوْ شَحْبَائُ قَالَ : وَہُوَ فِی مِظَلَّۃٍ لَہُ سَوْدَائَ قَالَ : فَقِیلَ لَہُ : یَا أَبَا ذَرٍّ ، لَوِ اتَّخَذْت امْرَأَۃً ہی أَرْفَعَ مِنْ ہَذِہِ ، فَقَالَ : وَاللَّہِ لأَنْ أَتَّخِذَ امْرَأَۃً تَضَعُنِی أَحَبُّ إلَیَّ مِنْ أَنْ أَتَّخِذَ امْرَأَۃً تَرْفَعُنِی۔",": Da'if","Musannaf Ibn Abi Shaybah 17723","","","كتاب النكاح"
"17724","(۱۷۷۲۴) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : قَالَ : عُمَرُ بْنُ الْخَطَّابِ : مَا بَقِیَ فِیَّ مِنْ أَخْلاَقِ الْجَاہِلِیَّۃِ شَیْئٌ إلاَّ أَنِّی لَسْتُ أُبَالِی أَیَّ الْمُسْلِمِینَ نَکَحْتُ وَأَیَّہُمْ أَنْکَحْتُ۔","","Musannaf Ibn Abi Shaybah 17724","","","كتاب النكاح"
"17725","(۱۷۷۲۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ قَالَ : کَانَ عَلْقَمَۃُ یَخْطُبُ إلَی مَنْ ہُوَ أَسْفَلُ مِنْہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17725","","","كتاب النكاح"
"17726","(۱۷۷۲۶) حَدَّثَنَا یَزِیدُ قَالَ : حدَّثَنَا ہِشَام ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ؛ أَنَّ رَجُلاً تَزَوَّجَ ابْنَۃَ عَبْدٍ خَیَّاطٍ فَوَلَدَتْ عِنْدَہُ غُلاَمًا فَانْتَفَی مِنْہُ ، فَقَالَ لَہُ شُرَیْحٌ : مَا الَّذِی دَلَّک عَلَی أَنْ تَزَوَّجَ بِنْتَ عَبْدٍ خَیَّاطٍ وَأَنْتَ رَجُلٌ مِنَ الْعَرَبِ فِی شَرَفٍ مِنَ الْعَطَائِ ہو الَّذِی دَعَاک إلَی أَنْ تَنْتَفِیَ مِنْہُ ۔","","Musannaf Ibn Abi Shaybah 17726","","","كتاب النكاح"
"17727","(۱۷۷۲۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ إِسْمَاعِیلَ مَوْلَی بَنِی مَخْزُوْمٍ قَالَ : سَأَلْتُ عَطَائً عَنِ امْرَأَۃٍ قَالَتْ لِعَبْدِہَا: أُعْتِقَکَ عَلَی أَنْ تَزَوَّجَنِی فَقَالَ : لَوْ أَنَّہَا بَدَأَتْ یَعْتِقُہُ ! قَالَ : وَسَأَلْتُ عَبْدَ اللہِ بْنَ عُبَیْدِ بْنِ عُمَیْرٍ فَقَالَ مِثْلَ قَوْلِ عَطَائٍ ، قَالَ : فَسَأَلْتُ مُجَاہِدًا فغَضِبَ وَقَالَ : فِی ہَذِہِ عُقُوْبَۃٌ مِنَ اللہِ وَمِنَ السُّلْطَانِ۔","","Musannaf Ibn Abi Shaybah 17727","","","كتاب النكاح"
"17728","(۱۷۷۲۸) حَدَّثَنَا وَکِیْعٌ ، عَنْ إِسْمَاعِیْلَ بَنْ مُسْلِمٍ ، عَنْ عَطَائٍ وَعبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ قَالاَ : تَعْتِقُہُ وَلاَ تُشَاطِرُہُ وَقَالَ مُجَاہِدٌ : فِی ہَذِہِ عُقُوْبَۃٌ مِنَ اللہِ وَمِنَ السُّلْطَانِ۔","","Musannaf Ibn Abi Shaybah 17728","","","كتاب النكاح"
"17729","(۱۷۷۲۹) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ فِی قَوْلِہِ : {وَأُحْضِرَتِ الأَنْفُسُ الشُّحَّ} قَالَ : فِی النَّفَقَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17729","","","كتاب النكاح"
"17730","(۱۷۷۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : نُصِیبُہَا مِنْ نَفْسِہِ وَمِنْ مَالِہِ۔","","Musannaf Ibn Abi Shaybah 17730","","","كتاب النكاح"
"17731","(۱۷۷۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : النَّفَقَۃُ وَالأَیَّامُ۔","","Musannaf Ibn Abi Shaybah 17731","","","كتاب النكاح"
"17732","(۱۷۷۳۲) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ : {أَوْ أَکْنَنتُمْ فِی أَنفُسِکُمْ} قَالَ : ذَکَرَہُ إِیَّاہُ فِی نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 17732","","","كتاب النكاح"
"17733","(۱۷۷۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الحَسَنِ : {أَوْ أَکْنَنتُمْ فِی أَنفُسِکُمْ} : الخِطْبَۃَ۔","","Musannaf Ibn Abi Shaybah 17733","","","كتاب النكاح"
"17734","(۱۷۷۳۴) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ وَحَمَّادٍ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا لِلنُّفَسَائِ أَنْ تُزَوَّجَ حَتَّی تَطْہُرَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17734","","","كتاب النكاح"
"17735","(۱۷۷۳۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ وَالْمُسَیِّبِ بْنِ رَافِعٍ أَنَّہُمَا قَالاَ فِی النُّفَسَائِ: لاَ تُزَوَّجُ حَتَّی یَذْہَبَ الدَّمُ۔","","Musannaf Ibn Abi Shaybah 17735","","","كتاب النكاح"
"17736","(۱۷۷۳۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ وَحَمَّادٍ قَالاَ : فِی النُّفَسَائِ : تُزَوَّجُ ، وَإِنْ لَمْ یَذْہَبِ الدَّمُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17736","","","كتاب النكاح"
"17737","(۱۷۷۳۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ قَالَ : کَانَ یَکْرَہُہُ فَإِنْ تَزَوَّجَتْ فَالنِّکَاحُ جَائِزٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17737","","","كتاب النكاح"
"17738","(۱۷۷۳۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الجَلْد بِنْ أَیُّوْبٍ ، عَنْ مَعَاوِیَۃ بْنِ قُرّۃ ، عَنْ عَائِذِ بْنِ عَمْروٍ رَجُلٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَکَانَ مِمَّنْ بَایَعَ تَحْتَ الشَّجَرَۃِ ؛ أَنَّ امْرَأَۃً مِنْ نِسَائِہِ نَفَسَتْ فَرَأَتِ الطُّہْرَ لِعِشْرِیَنَ لَیْلَۃً فَاغْتَسَلَتْ ثُمَّ جَائَتْ فَدَخَلَتْ مَعَہُ فِی لِحَافِہِ فَقَالَ : مَنْ ہَذِہِ ؟ فَقَالَتْ : فُلاَنَۃُ ، فَقَالَ : أَوَلَیْسَ قَدْ نَفِسْت ؟ قَالَتْ : إذًا قَدْ رَأَیْت الطُّہْرَ ، قَالَ : فَضَرَبَہَا بِرِجْلِہِ حَتَّی أَخْرَجَہَا مِنَ اللِّحَافِ وَقَالَ : لاَ تغُرنی عَنْ دِینِی حَتَّی یَمْضِیَ أَرْبَعُونَ یَوْمًا۔",": Da'if","Musannaf Ibn Abi Shaybah 17738","","","كتاب النكاح"
"17739","(۱۷۷۳۹) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، عَنْ عُثْمَانَ بْنِ أَبِی الْعَاصِ أَنَّہُ قَالَ : لِنِسَائِہِ : لاَ تَشَرَّفْنَ لِی دُونَ أَرْبَعِینَ لَیْلَۃً فِی النِّفَاسِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17739","","","كتاب النكاح"
"17740","(۱۷۷۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ اللہِ بْنِ یَسَارٍ ، عَنْ عُمَرَ ، قَالَ : تَجْلِسُ النُّفَسَائُ أَرْبَعِینَ یَوْمًا۔",": Da'if","Musannaf Ibn Abi Shaybah 17740","","","كتاب النكاح"
"17741","(۱۷۷۴۱) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ، عَنْ أَبِیہِ، عَنِ الْحَسَنِ قَالَ: تَرَبَّصُ النُّفَسَائُ أَرْبَعِینَ یَوْمًا ثُمَّ تَغْتَسِلُ وَتُصَلِّی، وَقَالَ الشَّعْبِیُّ : تَرَبَّصُ شَہْرَیْنِ ثُمَّ ہِیَ بِمَنْزِلَۃِ الْمُسْتَحَاضَۃِ۔","","Musannaf Ibn Abi Shaybah 17741","","","كتاب النكاح"
"17742","(۱۷۷۴۲) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ قَالَ : لاَ تَجْلِسُ النُّفَسَائُ أَکْثَرَ مِنْ أَرْبَعِینَ لیلۃ ، وقَالَ : عَطَائٌ : تَجْلِسُ عَادَتَہَا الَّتِی اعْتَادَتْ ، وَلاَ تَجْلِسُ أَکْثَرَ مِنْ أَرْبَعِینَ لَیْلَۃً۔","","Musannaf Ibn Abi Shaybah 17742","","","كتاب النكاح"
"17743","(۱۷۷۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ یُوسُفَ بْنِ مَاہَکٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : تَجْلِسُ النُّفَسَائُ نَحْوًا مِنْ أَرْبَعِینَ یَوْمًا۔",": Sahih","Musannaf Ibn Abi Shaybah 17743","","","كتاب النكاح"
"17744","(۱۷۷۴۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زُہَیْرٍ قَالَ : حدَّثَنَا عَلِیُّ بْنُ عَبْدِ الأَعْلَی ، عَنْ أَبِی سَہْلٍ ، عَنْ مُسَّۃَ ، عَنْ أُمِّ سَلَمَۃَ قَالَتْ : کَانَتِ النُّفَسَائُ تَقْعُدُ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَرْبَعِینَ یَوْمًا ، وَکُنَّا نُلَطِّخُ عَلَی وُجُوہِنَا الْوَرْسَ مِنَ الْکَلَفِ۔ (ترمذی ۱۳۹۔ ابوداؤد ۳۱۵)",": Da'if","Musannaf Ibn Abi Shaybah 17744","","","كتاب النكاح"
"17745","(۱۷۷۴۵) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ أَنَّہُ سَأَلَ ابْنَ عَبَّاسٍ عَنْ رَجُلٍ اشْتَرَی جَارِیَۃً وَہِیَ حَامِلٌ أَیَطَأُہَا ؟ قَالَ : لاَ ، وَقَرَأَ : (وَأُولاَتُ الأَحْمَالِ أَجَلُہُنَّ أَنْ یَضَعْنَ حَمْلَہُنَّ)۔",": Sahih","Musannaf Ibn Abi Shaybah 17745","","","كتاب النكاح"
"17746","(۱۷۷۴۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ قَالَ : قُلْتُ لَہُ : إنَّ أَبَا مُوسَی نَہَی حِینَ فَتَحَ تُسْتَرَ : أَلاَ تُوطَأُ الْحَبَالَی ، وَلاَ یُشَارِکُ الْمُشْرِکِینَ فِی أَوْلاَدِہِمْ ، فَإِنَّ الْمَائَ یَزِیدُ فِی الْوَلَدِ ، أَشَیْئٌ قَالَہُ بِرَأْیِہِ ؟ أَوْ شَیْئٌ رَوَاہُ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ أَوْطَاسٍ أَنْ تُوطَأَ حَامِلٌ حَتَّی تَضَعَ ، أَوْ حَائل حَتَّی تُسْتَبْرَأَ۔","","Musannaf Ibn Abi Shaybah 17746","","","كتاب النكاح"
"17747","(۱۷۷۴۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی قِلاَبَۃَ قَالَ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ مِنَّا مَنْ وَطِیئَ حُبْلَی۔","","Musannaf Ibn Abi Shaybah 17747","","","كتاب النكاح"
"17748","(۱۷۷۴۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلَہُ۔ (احمد ۱/۲۵۶۔ طبرانی ۱۲۰۹۰)","","Musannaf Ibn Abi Shaybah 17748","","","كتاب النكاح"
"17749","(۱۷۷۴۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ أَبِی مَرْزُوقٍ ، مَوْلَی تُجِیبَ ، قَالَ : غَزَوْنَا مَعَ رُوَیْفِعِ بْنِ ثَابِتٍ الأَنْصَارِیِّ نَحْوَ الْمَغْرِبِ فَفَتَحْنَا قَرْیَۃً یُقَالُ لَہَا جَرْبَۃُ قَالَ : فَقَامَ فِینَا خَطِیبًا ، فَقَالَ : إنِّی لاَ أَقُولُ فِیکُمْ إلاَّ مَا سَمِعْت مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ فِینَا یَوْمَ خَیْبَرَ قَالَ : مَنْ کَانَ یُؤْمِنُ بِاللَّہِ وَالْیَوْمِ الآخِرِ فَلاَ یُسْقِیَنَّ مَائَہُ زَرْعَ غَیْرِہِ۔ (احمد ۴/۱۰۸۔ طبرانی ۴۴۸۳)",": Hasan","Musannaf Ibn Abi Shaybah 17749","","","كتاب النكاح"
"17750","(۱۷۷۵۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ حَنَشٍ الصَّنْعَانِیِّ ، عَنْ أَبِی مَرْزُوقٍ ، مَوْلَی تُجِیبَ ، عَنْ رُوَیْفِعِ بْنِ ثَابِتٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 17750","","","كتاب النكاح"
"17751","(۱۷۷۵۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ عَبْدِ اللہِ بْنِ زَیْدٍ ، عَنْ عَلِیٍّ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنْ تُوطَأَ الْحَامِلُ حَتَّی تَضَعَ ، أَوِ الْحَائِضُ حَتَّی تُسْتَبْرَأَ بِحَیْضَۃٍ۔","","Musannaf Ibn Abi Shaybah 17751","","","كتاب النكاح"
"17752","(۱۷۷۵۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ صِلَۃَ وَقُثَمٍ وَنَاجِیَۃَ بْنِ کَعْبٍ قَالُوا : أَیُّمَا رَجُلٍ اشْتَرَی جَارِیَۃً حُبْلَی فَلاَ یَطَؤُہَا حَتَّی تَضَعَ حَمْلَہَا وَأَیُّمَا رَجُلٍ اشْتَرَی جَارِیَۃً فَلاَ یَقْرَبْہَا حَتَّی تَحِیضَ۔","","Musannaf Ibn Abi Shaybah 17752","","","كتاب النكاح"
"17753","(۱۷۷۵۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : نُہِیَ أَنْ یَطَأَ الرَّجُلُ وَلِیدَۃً ، أَوِ امْرَأَۃً وَفِی بَطْنِہَا جَنِینٌ لِغَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 17753","","","كتاب النكاح"
"17754","(۱۷۷۵۴) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ قَالَ: لَمَّا فُتِحَتْ تُسْتَرُ أَصَابَ أَبُو مُوسَی سَبَایَا فَکَتَبَ إلَیْہِ عُمَرُ أَنْ لاَ یَقَعَ أَحَدٌ عَلَی امْرَأَۃٍ حبلی حَتَّی تَضَعَ وَلاَ تُشَارِکُوا الْمُسْلِمِینَ فِی أَوْلاَدِہمْ فَإِنَّ الْمَائَ تَمَامُ الْوَلَدِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17754","","","كتاب النكاح"
"17755","(۱۷۷۵۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ، عَنْ مَعْمَرٍ، عَنْ عَمْرِو بْنِ مُسْلِمٍ، عَنْ طَاوُوسٍ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ مُنَادِیًا فنادی فِی غَزْوَۃٍ غَزَاہَا ؛ أَنْ لاَ یَطَأَ الرِّجَالُ حَامِلاً حَتَّی تَضَعَ ، وَلاَ حَائِلاً حَتَّی تَحِیضَ۔","","Musannaf Ibn Abi Shaybah 17755","","","كتاب النكاح"
"17756","(۱۷۷۵۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ قَالَ : حدَّثَنَا الْقَاسِمُ وَمَکْحُولٌ ، عَنْ أَبِی أُمَامَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی یَوْمَ خَیْبَرَ عن أَنْ تُوطَأَ الْحَبَالَی حَتَّی یَضَعْنَ۔",": Da'if","Musannaf Ibn Abi Shaybah 17756","","","كتاب النكاح"
"17757","(۱۷۷۵۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا شُعْبَۃُ ، عَنْ یَزِیدَ بْنِ خُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ جُبَیْرِ بْنِ نُفَیْرٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی الدَّرْدَائِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ عَلَی امْرَأَۃٍ مُجِحٍّ وَہِیَ عَلَی بَابِ خِبَائٍ ، أَوْ فُسْطَاطٍ ، فَقَالَ : لِمَنْ ہَذِہِ ؟ فَقَالُوا : لِفُلاَنٍ ، قَالَ : أَیُلِمُّ بِہَا ؟ قَالُوا : نَعَمْ ، قَالَ : لَقَدْ ہَمَمْت أَنْ أَلْعَنَہُ لَعْنَۃً تَدْخُلُ مَعَہُ قَبْرَہُ ، فَکَیْفَ یَسْتَخْدِمُہُ وَہُوَ یَغْذُوہُ فِی بَصَرِہِ وَسَمْعِہِ ، کَیْفَ یَرِثُہُ وَہُوَ لاَ یَحِلُّ لَہُ۔\n(مسلم ۱۰۶۶۔ ابوداؤد ۲۱۴۹)",": Sahih","Musannaf Ibn Abi Shaybah 17757","","","كتاب النكاح"
"17758","(۱۷۷۵۸) حَدَّثَنَا ہُشَیْم ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ أَنَّ رَجُلاً کَانَتْ عِنْدَہُ یَتِیْمَۃٌ وکَانَتْ تَحْضُرُ مَعَہُ طَعَامَہُ قَالَ : فَخَافَتِ امْرَأَتہ أَنْ یَتَزَوَّجَہَا عَلَیْہَا قَالَ : وَغَابَ الرَّجُلُ غَیْبَۃً فَاسْتَعَانَتِ امْرَأَتہ نِسْوَۃً عَلَیْہَا فَضَبَطْنَہَا لَہَا وَأَفْسَدَتْ عُذْرَتَہَا بِیَدِہَا ، وَقَدِمَ الرَّجُلُ فَجَعَلَ یَفْقِدُہَا ، عَنْ مَائِدَتِہِ ، فَقَالَ لاِمْرَأَتِہِ : مَا شَأْنُ فُلاَنَۃَ لاَ تَحْضُرُ طَعَامِی کَمَا کَانَتْ تَحْضُرُ ؟ فَقَالَتْ : دَعْ عَنْک فُلاَنَۃَ ، فَقَالَ : مَا شَأْنُہَا ؟ قَالَ : فَقَذَفَتْہَا قَالَ : فَانْطَلَقَ الرجل حَتَّی دَخَلَ عَلَیْہَا ، فَقَالَ : مَا شَأْنُک ؟ مَا أَمْرُک ؟ قَالَ : فَجَعَلَتْ لاَ تَزِیدُ عَلَی الْبُکَائِ ، فَقَالَ : أَخْبِرِینِی فَأَخْبَرَتْہُ قَالَ : فَانْطَلَقَ إلَی عَلِیٍّ رضی اللہ عنہ فَذَکَرَ ذَلِکَ لَہُ فَأَرْسَلَ إلَی امْرَأَۃِ الرَّجُلِ وَإِلَی النِّسْوَۃِ فَسَأَلَہُنَّ قَالَ : فَمَا لَبِثْنَ أَنِ اعْتَرَفْنَ قَالَ : فَقَالَ لِلْحَسَنِ : اقْضِ فِیہَا ، فَقَالَ الْحَسَنُ : أَرَی الْحَدَّ عَلَی مَنْ قَذَفَہَا وَالْعُقْرَ عَلَیْہَا وَعَلَی الْمُمْسِکَاتِ قَالَ : فَقَالَ عَلِیٌّ : لَوْ کُلِّفت إبِلٌ طَحِینًا لَطَحَنَتْ قَالَ : وَمَا یَطْحَنُ یَوْمَئِذٍ بَعِیرٌ۔",": Hasan","Musannaf Ibn Abi Shaybah 17758","","","كتاب النكاح"
"17759","(۱۷۷۵۹) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ أَنَّ جَوَارٍ أَرْبَعًا اجْتَمَعْنَ ، فَقَالَتْ إحْدَاہُنَّ : ہِیَ رَجُلٌ ، وَقَالَتِ الأُخْرَی : ہِیَ امْرَأَۃٌ وَقَالَتِ الثَّالِثَۃُ : أَنَا أَبُو الَّتِی زَعَمَتْ أَنَّہَا امْرَأَۃٌ وَقَالَتِ الرَّابِعَۃُ : أَنَا أَبُو الذی زَعَمَتْ أَنَّہَا رَجُلٌ، فَخَطَبَتِ الَّتِی زَعَمَتْ أَنَّہَا أَبُو الرَّجُلِ إلَی الَّتِی زَعَمَتْ أَنَّہَا أَبُو الْمَرْأَۃِ ، فَزَوَّجَتْہَا، فَأَفْسَدَتِ الَّتِی زَعَمَتْ أَنَّہَا رَجُلٌ الْجَارِیَۃَ الَّتِی زَوَّجَتْہَا ، فَاخْتَصَمُوا إلَی عَبْدِ الْمَلِکِ بْنِ مَرْوَانَ ، فَجَعَلَ صَدَاقَہَا عَلَی أَرْبَعَتِہِنَّ ، وَرَفَعَ حِصَّۃَ الَّتِی زَعَمَتْ أَنَّہَا امْرَأَۃٌ ، لأَنَّہَا أَمْکَنَتْ مِنْ نَفْسِہَا ، قَالَ : فَذَکَرَتْ ذَلِکَ لِعَبْدِ اللہِ بْنِ مَعقِلٍ الْمُزَنِیّ ، فَقَالَ : لَوْ أَنِّی وُلِّیتُ ذَلِکَ لَمْ أَرَ الصَّدَاقَ إلاَّ عَلَی الَّتِی أَفْسَدَتْہَا۔","","Musannaf Ibn Abi Shaybah 17759","","","كتاب النكاح"
"17760","(۱۷۷۶۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ أَنَّ امْرَأَۃً افْتَضَّتْ جَارِیَۃً بِأُصْبُعِہَا وَقَالَتْ : إنَّہَا زَنَتْ فَرَفَعَتْ إلَی عَلِیٍّ فَغَرَّمَہَا الْعُقْرَ وَضَرَبَہَا ثَمَانِینَ لِقَذْفِہَا إیَّاہَا۔","","Musannaf Ibn Abi Shaybah 17760","","","كتاب النكاح"
"17761","(۱۷۷۶۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ نِسْوَۃً کُنَّ بِالشَّامِ ، فَأَشِرْنَ وَبَطِرن وَلَعِبْنَ الْحُزُقَّۃَ ، فَرَکِبَتْ وَاحِدَۃٌ الأُخْرَی ، وَنَخَسَتِ الأُخْرَی ، فَأَذْہَبَتْ عُذْرَتَہَا ، فَرُفِعَ ذَلِکَ إلَی عَبْدِ الْمَلِکِ بْنِ مَرْوَانَ ، فَسَأَلَ عَنْ ذَلِکَ فَضَالَۃَ بْنَ عُبَیْدٍ وَقَبِیصَۃَ بْنَ ذُؤَیْبٍ ، فَقَالاَ : عَلَیْہِنَّ الدِّیَۃُ، وَیُرْفَعُ نَصِیبَ وَاحِدَۃٍ ، وَقَالَ ابْنُ مُعْقِلٍ : یَرَی مِنْ نَطَفِہَا إلَی نَاخِسَتِہَا ، وَقَالَ الشَّعْبِیُّ : وَأَنَا أَرَی ذَلِکَ وَلَہَا عُقْرُہَا۔","","Musannaf Ibn Abi Shaybah 17761","","","كتاب النكاح"
"17762","(۱۷۷۶۲) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ؛ أَنَّ جَارِیَتَیْنِ کَانَتَا بِالْحَمَّامِ ، فَدَفَعَتْ إحْدَاہُمَا الأُخْرَی فَانْتَقَضَتْ عُذْرَتُہَا ، فَقَضَی لَہَا شُرَیْحٌ : عَلَیْہَا بِمِثْلِ صَدَاقِہَا۔","","Musannaf Ibn Abi Shaybah 17762","","","كتاب النكاح"
"17763","(۱۷۷۶۳) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ أنَّہُ قَالَ فِی رَجُلَیْنِ تَزَوَّجَا أُخْتَیْنِ فَأُدْخِلَ عَلَی کُلِّ وَاحِدٍ مِنْہُمَا امْرَأَۃُ صَاحِبِہِ قَالَ لَہُمَا الصَّدَاقُ وَیَرْجِعُ الزَّوْجَانِ عَلَی مَنْ غَیَّرَہُمَا۔","","Musannaf Ibn Abi Shaybah 17763","","","كتاب النكاح"
"17764","(۱۷۷۶۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ أَنَّ عَلِیًّا قَالَ ذَلِکَ۔",": Da'if","Musannaf Ibn Abi Shaybah 17764","","","كتاب النكاح"
"17765","(۱۷۷۶۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ قَالَ ذَلِکَ أَیْضًا۔","","Musannaf Ibn Abi Shaybah 17765","","","كتاب النكاح"
"17766","(۱۷۷۶۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ قَالَ : تَزَوَّجَ أَخَوَانِ أُخْتَیْنِ ، فَأُدْخِلَتِ امْرَأَۃُ ہَذَا عَلَی ہَذَا ، وَامْرَأَۃُ ہَذَا عَلَی ہَذَا ، فَرُفِعَ ذَلِکَ إلَی عَلِیٍّ ، فَرَدَّ کُلَّ وَاحِدَۃٍ مِنْہُمَا إلَی زَوْجِہَا ، وَأَمَرَ زَوْجَہَا أَنْ لاَ یَقْرَبَہَا حَتَّی تَنْقَضِیَ عِدَّتُہَا ، وَجَعَلَ لِکُلِّ وَاحِدَۃٍ مِنْہُمَا الصَّدَاقَ عَلَی الَّذِی وَطِئَہَا لِغِشْیَانِہِ إیَّاہَا ، وَجَعَلَ جَہَازَہَا وَالْغُرْمَ عَلَی الَّذِی زَوَّجَہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17766","","","كتاب النكاح"
"17767","(۱۷۷۶۷) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی بَکْرٍ عَنَ أَبی مَسْعُوْدٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ مَہْرِ البَغِیِّ۔ (بخاری ۲۲۳۷۔ ترمذی ۱۲۷۶)",": Sahih","Musannaf Ibn Abi Shaybah 17767","","","كتاب النكاح"
"17768","(۱۷۷۶۸) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا أَبَانُ الْعَطَّارُ قَالَ : حَدَّثَنِی یَحْیَی بْنُ أَبِی کَثِیرٍ ، عَنْ إبْرَاہِیمَ بْنِ قَارِظٍ ، عَنِ السَّائِبِ بْنِ یَزِیدَ ، عَنْ رَافِعِ بْنِ خَدِیجٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : کَسْبُ الْحَجَّامِ خَبِیثٌ وَمَہْرُ الْبَغِیِّ خَبِیثٌ۔ (مسلم ۱۱۹۹۔ ابوداؤد ۳۴۱۴)",": Sahih","Musannaf Ibn Abi Shaybah 17768","","","كتاب النكاح"
"17769","(۱۷۷۶۹) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ کَسْب مَہْرِ الْبَغِیِّ۔ (احمد ۴/۳۰۸)",": Sahih","Musannaf Ibn Abi Shaybah 17769","","","كتاب النكاح"
"17770","(۱۷۷۷۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَبْدِ الْجَبَّارِ بْنِ عَبَّاسٍ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ مَہْرِ الْبَغِیِّ۔ (ابویعلی ۸۹۲۔ طبرانی ۲۷۳)",": Hasan","Musannaf Ibn Abi Shaybah 17770","","","كتاب النكاح"
"17771","(۱۷۷۷۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ فِی قَوْلِہِ : {وَمَنْ یُکْرِہْہُّنَّ فَإِنَّ اللَّہَ مِنْ بَعْدِ إکْرَاہِہِنَّ غَفُورٌ رَحِیمٌ} قَالَ : کَانَ عَبْدُ اللہِ بْنُ أُبَیِّ ابْنُ سَلُولَ یَقُولُ لِجَارِیَتِہِ : اذْہَبِی فَابْغِینَا شَیْئًا فَأَنْزَلَ اللَّہُ تَعَالَی : {وَلاَ تُکْرِہُوا فَتَیَاتِکُمْ عَلَی الْبِغَائِ إِنْ أَرَدْنَ تَحَصُّنًا لِتَبْتَغُوا عَرَضَ الْحَیَاۃِ الدُّنْیَا وَمَنْ یُکْرِہْہُّنَّ فَإِنَّ اللَّہَ مِنْ بَعْدِ إکْرَاہِہِنَّ غَفُورٌ رَحِیمٌ}۔ (مسلم ۲۶)",": Hasan","Musannaf Ibn Abi Shaybah 17771","","","كتاب النكاح"
"17772","(۱۷۷۷۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ قَالَ : کَانُوا یُکْرِہُونَ أَنْ یَتَزَوَّجُوا عَلَی الدِّرْہَمِ وَالدِّرْہَمَیْنِ مِثْلَ مَہْرِ الْبَغِیِّ۔","","Musannaf Ibn Abi Shaybah 17772","","","كتاب النكاح"
"17773","(۱۷۷۷۳) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ مَہْرِ الْبَغِیِّ۔",": Da'if","Musannaf Ibn Abi Shaybah 17773","","","كتاب النكاح"
"17774","(۱۷۷۷۴) حَدَّثَنَا مُعَاذُ بنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الحَسَنِ فِی رَجُلٍ تَزَوَّجَ أَمَۃً وَحُرَّۃً فِی عُقْدَۃٍ قَالَ : یُفَرَّقُ بَیْنَہُ وَبَیْنَ الأَمَۃِ ، أَوْ فِی رَجُلٍ تَزَوَّجَ أُخْتَیْنِ فِی عُقْدَۃٍ قَالَ : یُفَرَّقُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17774","","","كتاب النكاح"
"17775","(۱۷۷۷۵) حَدَّثَنَا حَفْصُ بنُ غِیَاثٍ ، عَنْ أَبِی حَنِیْفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إِبرَاہِیْمَ قَالَ : إِذَا تَزَوَّجَ حُرَّۃً وَأَمَۃً فِی عُقْدَۃٍ فَسَدَ نِکَاحُہُمَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17775","","","كتاب النكاح"
"17776","(۱۷۷۷۶) حَدَّثَنَا عَبْدَۃُ بنَ سُلَیْمَان ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الحَسَنِ ؛ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً ، ??ُمَّ دَخَلَ بِہَا ، ثُمَّ مَاتَ ، ثُمَّ قَامَتِ البَیِّنَۃُ أَنَّہَا أُخْتُہُ مِنَ الرَّضَاعَۃِ قَالَ : لَہَا الصَّدَاقُ وَلاَ مِیْرَاثَ لَہَا۔","","Musannaf Ibn Abi Shaybah 17776","","","كتاب النكاح"
"17777","(۱۷۷۷۷) حَدَّثَنَا حَفْصُ بنُ غِیَاثٍ ، عَنِ الحَجَّاجِ ، عَنِ الرُّکَیْنِ ؛ أَنَّ المُغِیْرَۃَ ابْنَ شُعْبَۃَ خَطَبَ امْرَأَۃً، وَہُوَ وَلِیُّہَا، ومَعَہُ أَوْلِیَائُ مِثْلَہُ ، فأَمَرَ بَعْضَ أَوْلِیَائِہَا أَنْ یُزَوِّجَہَا إِیَّاہُ۔","","Musannaf Ibn Abi Shaybah 17777","","","كتاب النكاح"
"17778","(۱۷۷۷۸) حَدَّثَنَا مُعَاذُ بنُ مَعَاذٍ ، عَنْ أشْعَثَ ، عَنِ الحَسَنِ قَالَ : إِذَا أَرَادَ وَلِیُّ المَرْأَۃِ أَنْ یُزَوَّجِہَا بإِذْنِہَا مِنْ نَفْسِہِ وَلَّی أَمْرَہَا رَجُلاً ثُمَّ تَزَوَّجَہَا بِشَہَادَۃِ العُدُوْلِ۔","","Musannaf Ibn Abi Shaybah 17778","","","كتاب النكاح"
"17779","(۱۷۷۷۹) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ أَنَّہُ کَانَ لاَ یُجِیْزُ نِکَاحَ المُضْطَہَدِ۔","","Musannaf Ibn Abi Shaybah 17779","","","كتاب النكاح"
"17780","(۱۷۷۸۰) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ : لاَ نِکَاحَ لِمُضْطَہَدٍ۔","","Musannaf Ibn Abi Shaybah 17780","","","كتاب النكاح"
"17781","(۱۷۷۸۱) حَدَّثَنَا عَبْدُ الأَعْلَی قَالَ : سُئِلَ عَنْ رَجُلٍ تَزَوَّجَ امْرَأَۃً عَلَی عَاجِلٍ أَوْ آجِلٍ فَدَخَلَ بِہَا فَادَّعَتْ أنَّہُ لَمْ یَِبَِرأ إِلِیْہَا مِنَ العَاجِلِ فَقَالَ : حَدَّثَنَا سَعِیدٍ ، عَنْ قَتَادَۃَ أَنَّہُ کَانَ یَقُوْلُ : المَخْرَجُ عَلَیْہَا فِیَ العَاجِلِ ، أَنَّہُ بَقِیَ عَلَیْہِ کَذَا وکَذَا وَدُخُوْلُہُ عَلَیْہَا أَبْرَأَہُ۔","","Musannaf Ibn Abi Shaybah 17781","","","كتاب النكاح"
"17782","(۱۷۷۸۲) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنِ الحَسَنِ ومَطَرٍ، عَنِ الحَسَنِ أَنَّہُ کَانَ یَقُوْلُ: المَخْرَجُ عَلَیْہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17782","","","كتاب النكاح"
"17783","(۱۷۷۸۳) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ أَنَّہُ شَکَّ فِی وَلَدٍ لَہُ فَأَمَرَ أَنْ یُدْعَی لَہُ الْقَافَۃُ۔",": Sahih","Musannaf Ibn Abi Shaybah 17783","","","كتاب النكاح"
"17784","(۱۷۷۸۴) حَدَّثَنَا أَبُوبَکْرِ بْنُ عَیَّاشٍ، عَنْ أَسْلَمَ الْمُنْقِرِیِّ ، عَنْ عبد اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ قَالَ : بَاعَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ جَارِیَۃً کَانَ وَقَعَ عَلَیْہَا قَبْلَ أَنْ یَسْتَبْرِئَہَا فَظَہَرَ بِہَا حَمْلٌ عِنْدَ الَّذِی اشْتَرَاہَا فَخَاصَمَہُ إلَی عُمَرَ ، فَقَالَ عُمَرُ ہَلْ کُنْت تَقَعُ عَلَیْہَا ؟ قَالَ : نَعَمْ ، قَالَ : فَبِعْتہَا قَبْلَ أَنْ تَسْتَبْرِئَہَا ؟ قَالَ : نَعَمْ ، قَالَ : مَا کُنْت لِذَلِکَ بِخَلِیقٍ ، قَالَ : فَدَعَا الْقَافَۃَ فَنَظَرُوا إلَیْہِ فَأَلْحَقُوہُ بِہِ ، قَالَ : فَوُلِدَ لَہُ مِنْہَا ولد کَثِیرٌ فَمَا عَیَّرُوہُ بِہِ۔","","Musannaf Ibn Abi Shaybah 17784","","","كتاب النكاح"
"17785","(۱۷۷۸۵) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ عَطَائٍ فِی الرَّجُلِ یَشُکُّ فِی وَلَدِہِ قَالَ : مُرْہُ فَلْیَسْتَلْحِقْہُ فَإِنَّ عُمَرَ بْنَ الْخَطَّابِ قَالَ : مَنْ أَقَرَّ أَنَّہُ أَصَابَ وَلِیدَۃً ، أَوْ غَشِیَ أَلْحَقْنَا بِہِ وَلَدَہَا ، وَسَأَلْت عِکْرِمَۃَ بْنِ خَالِدٍ ، فَقَالَ : مُرْہُ فَلْیَسْتَلْحِقْہُ۔","","Musannaf Ibn Abi Shaybah 17785","","","كتاب النكاح"
"17786","(۱۷۷۸۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ رَجَائِ بْنِ حَیْوَۃَ ، عَنْ قَبِیصَۃَ بْنِ ذُؤَیْبٍ ، قَالَ : قَالَ عُمَرُ : حَصِّنُوہُنَّ ، أَوْ لاَ تُحْصِنُوہُنَّ ، لاَ تَلِدُ امْرَأَۃٌ مِنْہُنَّ عَلَی فِرَاشِ أَحَدِکُمْ إلاَّ أَلْحَقْتہ بِہِ یَعْنِی السَّرَارِیَّ۔",": Sahih","Musannaf Ibn Abi Shaybah 17786","","","كتاب النكاح"
"17787","(۱۷۷۸۷) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمَّار ، عَنْ أَبِی مُسْلِمٍ ، عَنْ أَبِی عمْرَانَ ، عَنْ أَبِی یَحْیَی قَالَ: رَأَیْتُ رَجُلاً سَأَلَ ابْنَ عَبَّاسٍ ، فَقَالَ : یَا أبا عَبَّاسٍ إنِّی رَجُلٌ أَعْبَثُ بِذَکَرِی حَتَّی أُنْزِلَ ، قَالَ : فَقَالَ ابْنُ عَبَّاسٍ: أُفٍّ أُفٍّ ، ہُوَ خَیْرٌ مِنَ الزِّنَا وَنِکَاحُ الإِمَائِ خَیْرٌ مِنْہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 17787","","","كتاب النكاح"
"17788","(۱۷۷۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عِصَام بْنِ قُدَامَۃَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ ہُوَ الْفَاعِلُ بِنَفْسِہِ۔",": Hasan","Musannaf Ibn Abi Shaybah 17788","","","كتاب النكاح"
"17789","(۱۷۷۸۹) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ شَیْخٍ قَالَ: سُئِلَ ابْنُ عُمَرَ عَنْہَا یَعْنِی الْخَضْخَضَۃَ ، فَقَالَ: ذَاکَ الْفَاعِلُ بِنَفْسِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17789","","","كتاب النكاح"
"17790","(۱۷۷۹۰) حَدَّثَنَا وَکِیعٌ، عَنْ أَفْلَحَ، عَنِ الْقَاسِمِ قَالَ: سُئِلَ عَنِ {الَّذِینَ ہُمْ لِفُرُوجِہِمْ حَافِظُونَ إلاَّ عَلَی أَزْوَاجِہِمْ، أَوْ مَا مَلَکَتْ أَیْمَانُہُمْ فَإِنَّہُمْ غَیْرُ مَلُومِینَ فَمَنِ ابْتَغَی وَرَائَ ذَلِکَ فَأُولَئِکَ ہُمَ الْعَادُونَ}: فَمَنِ ابْتَغَی وَرَائَ ذَلِکَ فَہُوَ عَادٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17790","","","كتاب النكاح"
"17791","(۱۷۷۹۱) حدَّثَنَا ابْنُ نُمَیْرٍ وَأَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ أَبِی الزِّنَادِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الشِّغَارِ ، وَزَادَ ابْنُ نُمَیْرٍ : الشِّغَارُ أَنْ یَقُولَ الرَّجُلُ : زَوِّجْنِی ابْنَتَکَ حَتَّی أُزَوِّجَک ابْنَتِی ، أَوْ زَوِّجْنِی أُخْتَکَ حَتَّی أُزَوِّجَک أُخْتِی۔ (مسلم ۶۱۔ ابن ماجہ ۱۸۸۴)",": Sahih","Musannaf Ibn Abi Shaybah 17791","","","كتاب النكاح"
"17792","(۱۷۷۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ وَعَبْدَۃ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ: نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ الشِّغَارِ۔(بخاری ۶۹۶۰۔ مسلم ۵۸)",": Da'if","Musannaf Ibn Abi Shaybah 17792","","","كتاب النكاح"
"17793","(۱۷۷۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ معقل ، عَنْ عَطَائٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلہ۔","","Musannaf Ibn Abi Shaybah 17793","","","كتاب النكاح"
"17794","(۱۷۷۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ إِبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد بْنِ غَفَلَۃَ قَالَ : کَانُوا یَکْرَہُونَ الشِّغَارَ وَالشِّغَارُ : الرَّجُلُ یُزَوِّجُ الرَّجُلَ عَلَی أَنْ یُزَوِّجَہُ بِغَیْرِ مَہْرٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 17794","","","كتاب النكاح"
"17795","(۱۷۷۹۵) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ فِی الْمُشَاغِرَیْنِ : یُقَرَّانِ عَلَی نِکَاحِہِمَا وَیُؤْخَذُ لِکُلِّ وَاحِدٍ مِنْہُمَا صَدَاقٌ۔","","Musannaf Ibn Abi Shaybah 17795","","","كتاب النكاح"
"17796","(۱۷۷۹۶) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لاَ شِغَارَ فِی الإِسْلاَمِ۔ (ترمذی ۱۱۲۳۔ ابوداؤد ۲۵۷۴)",": Hasan","Musannaf Ibn Abi Shaybah 17796","","","كتاب النكاح"
"17797","(۱۷۷۹۷) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ الشِّغَارِ۔ (مسلم ۶۲۔ احمد ۳/۳۳۹)",": Da'if","Musannaf Ibn Abi Shaybah 17797","","","كتاب النكاح"
"17798","(۱۷۷۹۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِِ ، عَنِ الْمَسْعُودِیِّ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ قَالَ : عَلَّمَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خُطْبَۃَ الصَّلاَۃِ وَخُطْبَۃَ الْحَاجَۃِ فَأَمَّا خُطْبَۃُ الصَّلاَۃِ فَالتَّشَہُّدُ ، وَأَمَّا خُطْبَۃُ الْحَاجَۃِ ، فَـ إِنَّ : الْحَمْدَ لِلَّہِ نَسْتَعِینُہُ وَنَسْتَغْفِرُہُ وَنَعُوذُ بِاللَّہِ مِنْ شُرُورِ أَنْفُسِنَا مَنْ یَہْدِہِ اللَّہُ فَلاَ مُضِلَّ لَہُ ، وَمَنْ یُضْلِلْ فَلاَ ہَادِیَ لَہُ ، وَأَشْہَدُ أَنْ لاَ إلَہَ إلاَّ اللَّہُ وَأَشْہَدُ أنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، ثُمَّ یَقْرَأُ ثَلاَثَ آیَاتٍ مِنْ کِتَابِ اللہِ : {اتَّقُوا اللَّہَ حَقَّ تُقَاتِہِ وَلاَ تَمُوتُنَّ إلاَّ وَأَنْتُمْ مُسْلِمُونَ} {وَاتَّقُوا اللَّہَ الَّذِی تَسَائَلُونَ بِہِ وَالأَرْحَامَ إنَّ اللَّہَ کَانَ عَلَیْکُمْ رَقِیبًا} {اتَّقُوا اللَّہَ وَقُولُوا قَوْلاً سَدِیدًا یُصْلِحْ لَکُمْ أَعْمَالَکُمْ وَیَغْفِرْ لَکُمْ ذُنُوبَکُمْ} ثُمَّ تَعْمِدُ لِحَاجَتِک۔ (ابوداؤد ۲۱۱۱۔ احمد ۱/۴۳۲)","","Musannaf Ibn Abi Shaybah 17798","","","كتاب النكاح"
"17799","(۱۷۷۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ أَنَّ الْحُسَیْنَ بْنَ عَلِیٍّ کَانَ یُزَوِّجُ بَعْضَ بَنَاتِ الْحَسَنِ وَہُوَ یتعرق العرق۔","","Musannaf Ibn Abi Shaybah 17799","","","كتاب النكاح"
"17800","(۱۷۸۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ نَصْرٍ ، عَنْ عَطَائٍ أَنَّہُ قَرَأَ بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ ثُمَّ زَوَّجَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17800","","","كتاب النكاح"
"17801","(۱۷۸۰۱) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ أَنَّ مَسْرُوقًا زَوَّجَ شُرَیْحًا وَلَمْ یَخْطُبْ ثُمَّ قَالَ : قَدْ قُضِیت تِلْکَ الْحَاجَۃَ۔","","Musannaf Ibn Abi Shaybah 17801","","","كتاب النكاح"
"17802","(۱۷۸۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، قَالَ : سَمِعْتُ عُرْوَۃَ بْنَ الزُّبَیْرِ یَقُولُ : خَطَبْت إلَی ابْنِ عُمَرَ ابْنَتَہُ ، فَقَالَ : إِنَّ ابْنَ أَبِی عَبْدِ اللہِ لأَہْلٌ أَنْ یُنْکَحَ ؟ نَحْمَدُ اللَّہَ وَنُصَلِّی عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَقَدْ زَوَّجْنَاک عَلَی مَا أَمَرَ اللَّہُ: {إمْسَاکٌ بِمَعْرُوفٍ ، أَوْ تَسْرِیحٌ بِإِحْسَانٍ} قَالَ : شُعْبَۃُ : أَحْسَبُہُ قَالَ : أَنْکَحَ عُمَرُ بْنُ الْخَطَّابِ رَجُلاً وَہُوَ یَمْشِی ، قَالَ : شُعْبَۃُ : قَالَ أَبُو بَکْرِ بْنُ حَفْصٍ : لاَ أَدْرِی الَّذِی قَالَ: أَحْسَبُہُ عُرْوَۃُ بْنُ الزُّبَیْرِ أَوِ ابْنُ عُمَرَ۔ (بیہقی ۱۴۷)",": Sahih","Musannaf Ibn Abi Shaybah 17802","","","كتاب النكاح"
"17803","(۱۷۸۰۳) حَدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنْ حُمَیْدَۃَ مَوْلاَۃٍ لِعُمَرَ بْنِ عَبْدِ الْعَزِیزِ قَالَتْ : کَانَ عُمَرُ یَقُولُ : لاَ تَدَعِینَ بَنَاتِی یَنَمْنَ مُسْتَلْقِیَاتٍ عَلَی ظُہُورِہِنَّ فَإِنَّ الشَّیْطَانَ یَظَلُّ یَطْمَعُ مَا دُمْنَ کَذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17803","","","كتاب النكاح"
"17804","(۱۷۸۰۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ قَالَ : کَانَ ابْنُ سِیرِینَ یَکْرَہُ أَنْ تَکُونَ الْمَرْأَۃُ مُسْتَلْقِیَۃً۔",": No Data Available","Musannaf Ibn Abi Shaybah 17804","","","كتاب النكاح"
"17805","(۱۷۸۰۵) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : إذَا أَسْلَمَتِ الْمَرْأَۃُ وَلَہَا زَوْجٌ یَہُودِیٌّ ، أَوْ نَصْرَانِیٌّ ، أَوْ مَجُوسِیٌّ ، وَلَمْ یُسْلِمْ ہُوَ فَلاَ شَیْئَ لَہَا مَا لَمْ یَدْخُلْ بِہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17805","","","كتاب النكاح"
"17806","(۱۷۸۰۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ شَیْئَ لَہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17806","","","كتاب النكاح"
"17807","(۱۷۸۰۷) حَدَّثَنَا عَبَّادُ بن العَوام ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : یُفَرَّقُ بَیْنَہُمَا وَلَہَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 17807","","","كتاب النكاح"
"17808","(۱۷۸۰۸) حَدَّثَنَا حَرَمِیُّ بْنُ عُمَارَۃَ بْنِ أَبِی حَفْصَۃَ ، عَنْ شُعْبَۃَ ، عَنِ الْہَیْثُمِ ، عَنْ حَمَّادٍ قَالَ : لَہَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 17808","","","كتاب النكاح"
"17809","(۱۷۸۰۹) حَدَّثَنَا یَزِیدُ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ؛ سُئِلَ عَنْ رَجُلٍ کَانَتْ تَحْتَہُ نَصْرَانِیَّۃٌ فَأَسْلَمَتْ ، وَأَبَی زَوْجُہَا أَنْ یُسْلِمَ قَالَ : أَرَی أَنْ یُفَرَّقَ بَیْنَہُمَا ، فَإِنْ کَانَ دَخَلَ بِہَا فَلَہَا الْمَہْرُ کَامِلاً ، وَإِنْ لَمْ یَکُنْ دَخَلَ بِہَا رَدَّتْ إلَیْہِ مَا أَعْطَاہَا۔","","Musannaf Ibn Abi Shaybah 17809","","","كتاب النكاح"
"17810","(۱۷۸۱۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ أَنَّہُ قَالَ : لَہَا نِصْفُ الصَّدَاقِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17810","","","كتاب النكاح"
"17811","(۱۷۸۱۱) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الشَّیْبَانِیِّ ، عَمَّنْ حَدَّثَہُ عَنْ مَسْرُوقٍ أَنَّہُ قَالَ : فِی رَجُلٍ أَقَرَّ لامْرَأَتِہِ بِصَدَاقِہَا فِی مَرَضِہِ قَالَ : لاَ یَجُوزُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17811","","","كتاب النكاح"
"17812","(۱۷۸۱۲) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْعَوَّامِ أَنَّ مَسْرُوقًا أَجَازَ إقْرَارَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17812","","","كتاب النكاح"
"17813","(۱۷۸۱۳) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ قَالَ : یَجُوزُ إقْرَارُہُ لَہَا بِصَدَاقِ مِثْلِہَا۔","","Musannaf Ibn Abi Shaybah 17813","","","كتاب النكاح"
"17814","(۱۷۸۱۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یُجِیزُ ذَلِکَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17814","","","كتاب النكاح"
"17815","(۱۷۸۱۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ کَانَ لاَ یُجِیزُ إقْرَارَہُ لَہَا لأَنَّہَا وَارِثٌ ، وَلاَ یَجُوزُ وَصِیَّۃٌ لِوَارِثٍ۔","","Musannaf Ibn Abi Shaybah 17815","","","كتاب النكاح"
"17816","(۱۷۸۱۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : الْقَوْلُ قَوْلُ الرَّجُلِ وَقَالَ حَمَّادُ ، وَابْنُ ذَکْوَانَ : الْقَوْلُ قَوْلُہَا مَا بَیْنَہَا وَبَیْنَ مَہْرِ مِثْلِہَا۔","","Musannaf Ibn Abi Shaybah 17816","","","كتاب النكاح"
"17817","(۱۷۸۱۷) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ : ہُوَ قَوْلُہَا مَا بَیْنَہَا وَبَیْنَ صَدَاقِ نِسَائِہَا۔","","Musannaf Ibn Abi Shaybah 17817","","","كتاب النكاح"
"17818","(۱۷۸۱۸) حَدَّثَنَا عَبْدُالرَّحْمَنِ بْنُ مَہْدِیٍّ، عَنْ سُفْیَانَ، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ وَعَنْ إسْمَاعِیلَ بْنِ سَالِمٍ، عَنِ الشَّعْبِیِّ قَالاَ: فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً عَلَی عَاجِلٍ، أَوْ آجِلٍ فَدَخَلَ بِہَا قَالاَ: الْبَیِّنَۃُ أَنَّہُ دَفَعَہُ إلَیْہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17818","","","كتاب النكاح"
"17819","(۱۷۸۱۹) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ فِی الْمَرْأَۃِ تَدَّعِی الصَّدَاقَ بَعْدَ وَفَاۃِ زَوْجِہَا قَالَ : یَسْأَلُہَا الْبَیِّنَۃَ۔","","Musannaf Ibn Abi Shaybah 17819","","","كتاب النكاح"
"17820","(۱۷۸۲۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، عَنِ الْحَکَمِ قَالَ : بینتہا وَقَالَ حَمَّادٌ : صَدَاقُ نِسَائِہَا۔","","Musannaf Ibn Abi Shaybah 17820","","","كتاب النكاح"
"17821","(۱۷۸۲۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : الْبَیِّنَۃُ عَلَی أَہْلِ الصَّدَاقِ أَوْلِیَائِ الْمَرْأَ??ِ وَعَلَی أَہْلِ الرَّجُلِ الْمُخْرَجِ مِنْ ذَلِکَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17821","","","كتاب النكاح"
"17822","(۱۷۸۲۲) حدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنِ الْفُضَیْلِ ، عَنْ إبْرَاہِیمَ فِی الرَّجُلِ یَقْذِفُ امْرَأَتَہُ قَبْلَ أَنْ یَدْخُلَ بِہَا قَالَ : یُلاَعِنُہَا وَلَہَا نِصْفُ الصَّدَاقِ فَإِنْ ظَہَرَ بِہَا حَمْلٌ فَلَہَا الصَّدَاقُ کَامِلاً۔","","Musannaf Ibn Abi Shaybah 17822","","","كتاب النكاح"
"17823","(۱۷۸۲۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ قَالَ : إذَا قَذَفَ الرَّجُلُ امْرَأَتَہُ قَبْلَ أَنْ یَدْخُلَ بِہَا لاَعَنَہَا وَلَہَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 17823","","","كتاب النكاح"
"17824","(۱۷۸۲۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَابْنِ عُمَرَ قَالاَ : إذَا قَذَفَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا لاَعَنَہَا وَلَہَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 17824","","","كتاب النكاح"
"17825","(۱۷۸۲۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 17825","","","كتاب النكاح"
"17826","(۱۷۸۲۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ مِثْلَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17826","","","كتاب النكاح"
"17827","(۱۷۸۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : إذَا قَذَفَ الرَّجُلُ امْرَأَتَہُ قَبْلَ أَنْ یَدْخُلَ بِہَا لاَعَنَ وَلَہَا نِصْفُ الصَّدَاقِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17827","","","كتاب النكاح"
"17828","(۱۷۸۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ قَالَ : إذَا کَانَ بِہَا حَمْلٌ فَلَہَا الصَّدَاقُ کَامِلاً۔",": No Data Available","Musannaf Ibn Abi Shaybah 17828","","","كتاب النكاح"
"17829","(۱۷۸۲۹) حَدَّثَنَا أَبُو بَحْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : یُلاَعِنُ وَلَہَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 17829","","","كتاب النكاح"
"17830","(۱۷۸۳۰) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْسِمُ بَیْنَ نِسَائِہِ فَیَعْدِلُ ثُمَّ یَقُولُ : اللَّہُمَّ ہَذِہِ قِسْمَتِی فِیمَا أَمْلِکُ فَلاَ تَلُمْنِی فِیمَا تَمْلِکُ أَنْتَ وَلاَ أَمْلِکُ۔","","Musannaf Ibn Abi Shaybah 17830","","","كتاب النكاح"
"17831","(۱۷۸۳۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ: أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ، عَنْ عَائِشَۃَ قَالَتْ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْسِمُ بَیْنَ نِسَائِہِ فَیَعْدِلُ ثُمَّ یَقُولُ : اللَّہُمَّ ہَذَا فِعْلِی فِیمَا أَمْلِکُ فَلاَ تَلُمْنِی فِیمَا تَمْلِکُ وَلاَ أَمْلِکُ۔ (احمد ۶/۱۴۴۔ ابن حبان ۴۲۰۵)","","Musannaf Ibn Abi Shaybah 17831","","","كتاب النكاح"
"17832","(۱۷۸۳۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ أَنَّ مُعَاذًا کَانَتْ لَہُ امْرَأَتَانِ ، وَکَانَ یَکْرَہُ أَنْ یَتَوَضَّأَ فِی یَوْمِ ہَذِہِ عِنْدَ ہَذِہِ ، أَوْ یَکُونَ فِی یَوْمِ ہَذِہِ عِنْدَ ہَذِہِ۔","","Musannaf Ibn Abi Shaybah 17832","","","كتاب النكاح"
"17833","(۱۷۸۳۳) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہَارُونَ بْنِ إبْرَاہِیمَ ، قَالَ : سَمِعْتُ مُحَمَّدًا یَقُولُ فِی الذی لہ امْرَأَتَانِ : یُکْرَہُ أَنْ یَتَوَضَّأَ فِی بَیْتِ إحْدَاہُمَا دُونَ الأُخْرَی۔","","Musannaf Ibn Abi Shaybah 17833","","","كتاب النكاح"
"17834","(۱۷۸۳۴) حَدَّثَنَا مُحَمَّدُ بْنُ بکر ، عَنْ عُبَیْدٍ أَبِی الْحَزمِ ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : کَانَتْ لِی امْرَأَتَانِ فَکُنْت أَعْدِلُ بَیْنَہُمَا حَتَّی فِی الْقُبَلِ۔","","Musannaf Ibn Abi Shaybah 17834","","","كتاب النكاح"
"17835","(۱۷۸۳۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ شَرِیکٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ : کَانُوا یَسْتَحِبُّونَ أَنْ یَعْدِلُوا بَیْنَ النِّسَائِ حَتَّی فِی الطِّیبِ ، یَتَطَیَّبُ لِہَذِہِ کَمَا یَتَطَیَّبُ لِہَذِہِ۔","","Musannaf Ibn Abi Shaybah 17835","","","كتاب النكاح"
"17836","(۱۷۸۳۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ فِی الرَّجُلِ یَجْمَعُ بَیْنَ الضَّرَائِرِ ، فَقَالَ : إِنْ کَانُوا لَیُسَوُّونَ بَیْنَہُمْ حَتَّی تَبْقَی الْفَضْلَۃُ مِمَّا لاَ یُکَالُ مِنَ السَّوِیقِ وَالطَّعَامِ ، فَیَقْسِمُونَہُ کَفًّا کَفًّا إذَا کَانَ یَبْقَی الشَّیْئُ مِمَّا لاَ یَسْتَطِعْ کَیْلَہُ۔","","Musannaf Ibn Abi Shaybah 17836","","","كتاب النكاح"
"17837","(۱۷۸۳۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : لَمَّا مَرِضَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اسْتَحَلَّ نِسَائَہُ أَنْ یُمَرَّضَ فِی بَیْتِ عَائِشَۃَ قَالَ : فَأَحْلَلْنَ لَہُ ، فَکَانَ فِی بَیْتِ عَائِشَۃَ۔\n(بخاری ۱۹۸۔ مسلم ۹۱)","","Musannaf Ibn Abi Shaybah 17837","","","كتاب النكاح"
"17838","(۱۷۸۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامِ بْنِ یَحْیَی ، عَنْ قَتَادَۃَ ، عَنِ النَّضْرِ بْنِ أَنَسٍ ، عَنْ بَشِیرِ بْنِ نَہِیکٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَانَت لَہُ امْرَأَتَانِ ، فَکَانَ یَمِیلُ مَعَ إحْدَاہُمَا عَلَی الأُخْرَی بُعِثَ یَوْمَ الْقِیَامَۃِ وَأَحَدُ شِقَّیْہِ سَاقِطٌ۔ (ترمذی ۱۱۴۱۔ ابوداؤد ۲۱۲۶)",": Sahih","Musannaf Ibn Abi Shaybah 17838","","","كتاب النكاح"
"17839","(۱۷۸۳۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ غَالِبٍ قَالَ : سَأَلْتُ الْحَسَنَ ، أَوْ سُئِلَ عَنْ رَجُلٍ تَکُونُ لَہُ امْرَأَتَانِ فِی بَیْتٍ قَالَ : کَانُوا یَکْرَہُونَ الْوَجْسَ وَہُوَ أَنْ یَطَأَ إحْدَاہُمَا وَالأُخْرَی تری ، أَوْ تَسْمَعُ۔","","Musannaf Ibn Abi Shaybah 17839","","","كتاب النكاح"
"17840","(۱۷۸۴۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ أَبِی شَیْبَۃَ ، قَالَ : سَمِعْتُ عِکْرِمَۃَ یُحَدِّثُ عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ یَنَامُ بَیْنَ جَارِیَتَیْنِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17840","","","كتاب النكاح"
"17841","(۱۷۸۴۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ شَرِیکٍ، عَنْ لَیْثٍ، عَنْ عَطَائٍ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَنَامَ الرَّجُلُ بَیْنَ الأَمَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 17841","","","كتاب النكاح"
"17842","(۱۷۸۴۲) ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنْ عزرۃ عن شریح أَنّہ قَالَ فی رَجُلٍ أُہْدیَتْ إلَیْہِ امْرَأَتُہُ فَزَعَمَ أَنَّہُ لَمْ یَدْخُلْ بِہَا ، وَأَقَرَّتْ ہِیَ بِذَلِکَ ، فَقَضَی لَہَا بِنِصْفِ الصَّدَاقِ ، وَأَلْزَمَہَا الْعِدَّۃَ وَقَالَ : لاَ أُصدِّقُکَ عَلَی نَفْسِکَ وَلاَ أُصدِّقُکِ لِنَفْسِک۔","","Musannaf Ibn Abi Shaybah 17842","","","كتاب النكاح"
"17843","(۱۷۸۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ قَالَ : عَلَیْہِ کَامِلاً إِنْ شَائَتْ أَخَذَتْہُ ، وَإِنْ شَائَتْ تَرَکَتْہُ۔","","Musannaf Ibn Abi Shaybah 17843","","","كتاب النكاح"
"17844","(۱۷۸۴۴) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَرَ بْنِ عَامِرٍ قَالَ : سَأَلَ الشَّعْبِیَّ رَجُلٌ ، فَقَالَ رَجُلٌ قَالَ لِلرَّجُلِ : إذَا مَضَی شَوَّالٌ زَوَّجْتُک ابْنَتِی ، فَقَالَ : لَیْسَ ہَذَا بِنِکَاحٍ۔","","Musannaf Ibn Abi Shaybah 17844","","","كتاب النكاح"
"17845","(۱۷۸۴۵) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ فِی الْعَبْدِ یَتَزَوَّجُ بِإِذْنِ مَوْلاَہُ قَالَ : عَلَیْہِ النَّفَقَۃُ۔","","Musannaf Ibn Abi Shaybah 17845","","","كتاب النكاح"
"17846","(۱۷۸۴۶) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنِ الْحَسَنِ قَالَ : لاَ تَحَسَّرُ الْمَرْأَۃُ عِنْدَ وَلَدٍ وَلا وَالِدٍ وَلاَ أَخٍ إلاَّ عِنْدَ زَوْجِہَا۔",": Hasan","Musannaf Ibn Abi Shaybah 17846","","","كتاب النكاح"
"17847","(۱۷۸۴۷) حَدَّثَنَا وَکِیعٌ ، وَابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزَّعْرَائِ ، عَنْ عِکْرِمَۃَ قَالَ : مُبَاشَرَۃُ الرَّجُلِ أُمَّہُ وَأُخْتَہُ شُعْبَۃٌ مِنَ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17847","","","كتاب النكاح"
"17848","(۱۷۸۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، عَنْ سَلْمَانَ قَالَ : مَا أُبَالِی إذَا خَلَوْت بِأَہْلِی وَأَغْلَقْت بَابِی وَأَرْخَیْت سِتْرِی حَدَّثْت بِہِ النَّاسَ ، أَوْ صَنَعْت ذَلِکَ وَالنَّاسُ یَنْظُرُونَ۔",": Sahih","Musannaf Ibn Abi Shaybah 17848","","","كتاب النكاح"
"17849","(۱۷۸۴۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عُمَر بْنِ حَمْزَۃَ الْعُمَرِیِّ قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ سَعْدٍ مَوْلًی لأَبِی سُفْیَانَ ، قَالَ : سَمِعْتُ أَبَا سَعِیدٍ الْخُدْرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ مِنْ شَرِّ النَّاسِ عِنْدَ اللہِ مَنْزِلَۃً یَوْمَ الْقِیَامَۃِ الرَّجُلَ یُفْضِی إلَی امْرَأَتِہِ وَتُفْضِی إلَیْہِ ثُمَّ یَنْشُرُ سِرَّہَا۔\n(مسلم ۱۲۴۔ ابوداؤد ۴۸۳۷)","","Musannaf Ibn Abi Shaybah 17849","","","كتاب النكاح"
"17850","(۱۷۸۵۰) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنِ الطُّفَاوِیِّ ، عَنْ أَبِی ہریرۃ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عسی أَحَدُکُمْ یُخْبِرُ بِمَا صَنَعَ بِأَہْلِہِ ؟ وَعَسَی إحْدَاکُنَّ أَنْ تُخْبِرَ بِمَا یصْنَعُ بِہَا زَوْجُہَا ، فَقَامَتِ امْرَأَۃٌ سَوْدَائُ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، إنَّہُمْ لَیَفْعَلُونَ وَإِنَّہُنَّ لَیَفْعَلْنَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أَلاَ أُخْبِرُکُمْ بِمَثَلِ ذَلِکَ؟ إنما مَثَلُ ذَلِکَ کَمَثَلِ شَیْطَانٍ لَقِیَ شَیْطَانَۃً فَوَقَعَ عَلَیْہَا فِی الطَّرِیقِ وَالنَّاسُ یَنْظُرُونَ فَقَضَی حَاجَتَہُ مِنْہَا وَالنَّاسُ یَنْظُرُونَ۔(ابوداؤد ۴۰۱۵۔ احمد ۲/۵۴۰)",": Da'if","Musannaf Ibn Abi Shaybah 17850","","","كتاب النكاح"
"17851","(۱۷۸۵۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَوَّامٍ ، عَنْ مُجَاہِدٍ : {وَإِذَا مَرُّوا بِاللَّغْوِ مَرُّوا کِرَامًا} قَالَ : کانوا إذَا أَتَوْا عَلَی ذِکْرِ النِّکَاحِ کَنَوْا عَنْہُ۔","","Musannaf Ibn Abi Shaybah 17851","","","كتاب النكاح"
"17852","(۱۷۸۵۲) حَدَّثَنَا حَفْصٌ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ، عَنْ حَبِیبٍ قَالَ: کَانَ عُمَرُ لاَ یُجِیزُ النِّکَاحَ فِی عَامِ سَنَۃٍ یَعْنِی مَجَاعَۃً۔","","Musannaf Ibn Abi Shaybah 17852","","","كتاب النكاح"
"17853","(۱۷۸۵۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا أنْکَحَ الْمَرْأَۃَ الْوَلِیُّ فَلَمْ تَرْضَ ثُمَّ رَضِیَتْ بَعْدُ لَمْ یَصْلُحْ ذَلِکَ النِّکَاحُ حَتَّی یَکُونَ نِکَاحٌ جَدِیدٌ۔","","Musannaf Ibn Abi Shaybah 17853","","","كتاب النكاح"
"17854","(۱۷۸۵۴) حدَّثَنَا ہُشَیْمٌ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عُمَرَ ، قَالَ: إذَا أَقَرَّ بِوَلَدِہِ مَرَّۃً وَاحِدَۃً فَلَیْسَ لَہُ أَنْ یَنْفِیَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 17854","","","كتاب النكاح"
"17855","(۱۷۸۵۵) حَدَّثَنَا حَفْصٌ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ قَالَ : إذَا أَقَرَّ بِہِ فَلَیْسَ لَہُ أَنْ یَنْفِیَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 17855","","","كتاب النكاح"
"17856","(۱۷۸۵۶) حَدَّثَنَا حَفْصٌ، عَنْ مُجَالِدٍ، عَنْ شُرَیْحٍ قَالَ: إذَا أَقَرَّ بِہِ، أَوْ ہُنِّئَ بِہِ، أَوْ أَوْلَمَ عَلَیْہِ فَلَیْسَ لَہُ أَنْ یَنْتَفِیَ مِنْہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17856","","","كتاب النكاح"
"17857","(۱۷۸۵۷) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ وَغَیْرِہِ ، عَنْ عُمَرَ ، قَالَ : إذَا أَقَرَّ بِالْوَلَدِ طَرْفَۃَ عَیْنٍ فَلَیْسَ لَہُ أَنْ یَنْفِیَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 17857","","","كتاب النكاح"
"17858","(۱۷۸۵۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ، عَنْ مُجَالِدٍ، عَنِ الشَّعْبِیِّ قَالَ: جَائَ رَجُلٌ بِابْنٍ لَہُ قَدْ أَقَرَّ بِہِ ثُمَّ أَرَادَ أَنْ یَنْفِیَہُ فَشَہِدُوا أَنَّہُ وُلِدَ فِی بَیْتِہِ وَأَنَّہُمْ ہَنَّؤُوہُ بِہِ وَأَقَرَّ بِہِ ، فَقَالَ شُرَیْحٌ : الْزَمْ وَلَدَک قَالَ عَامِرٌ : کان عُمَرَ یَقْضِی بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17858","","","كتاب النكاح"
"17859","(۱۷۸۵۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : إذَا أَقَرَّ الرَّجُلُ بِوَلَدِہِ فَلَیْسَ لَہُ أَنْ یَنْفِیَہُ عَلَی حَالٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17859","","","كتاب النكاح"
"17860","(۱۷۸۶۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ وَعُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا أَقَرَّ بِالْوَلَدِ فَلَیْسَ لَہُ أَنْ یَنْتَفِیَ مِنْہُ ، وَقَالَ حَمَّادٌ : إذَا أَقَرَّ بِالْحَمْلِ فَلَیْسَ لَہُ أَنْ یُنْکِرَہُ ، إِنْ شَائَ یَقُولُ : أَخْطَأْت فِی الْعِدَّۃِ۔","","Musannaf Ibn Abi Shaybah 17860","","","كتاب النكاح"
"17861","(۱۷۸۶۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ قَالَ : إذَا تَبَیَّنَ حَمْلُ سُرِّیَّتِہِ فَلَہُ إنْکَارُہُ مَا لَمْ یُقِرَّ بِہِ بَعْدَ مَا تَضَعُ ، وَإِنْ کَانَ قَدْ أَقَرَّ بِالْحَمْلِ ثُمَّ أَنْکَرَہُ بَعْدَ مَا تَضَعُ فَلَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17861","","","كتاب النكاح"
"17862","(۱۷۸۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ قَالَ : إذَا أَقَرَّ بِوَلَدِہِ ثُمَّ نَفَاہُ لَزِمَہُ۔","","Musannaf Ibn Abi Shaybah 17862","","","كتاب النكاح"
"17863","(۱۷۸۶۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : إذَا انْتَفَی الرَّجُلُ مِنْ وَلَدِہِ لاَعَنَ أُمَّہُ إِنْ کَانَتْ حَیَّۃً ، وَإِنْ کَانَتْ قَدْ مَاتَتْ جُلِدَ الْحَدَّ وَأُلْزِقَ بِہِ الْوَلَدُ فَإِنْ کَانَ ابْنَ سُرِّیَّۃٍ صَارَ عَبْدًا۔","","Musannaf Ibn Abi Shaybah 17863","","","كتاب النكاح"
"17864","(۱۷۸۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ وَالْحَکَمِ قَالاَ : إذَا أَقَرَّ بِوَلَدِہِ ثُمَّ نَفَاہُ قَالَ الْحَکَمُ : یُضْرَبُ وَقَالَ حَمَّادٌ : یَلْزَمُ الْوَلَدُ بِالإِقْرَارِ وَیُلاَعِنُ وَذَکَرَ أَنَّ سُفْیَانَ کَانَ یَقُولُہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17864","","","كتاب النكاح"
"17865","(۱۷۸۶۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ سُفْیَانَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ فِی الرَّجُلِ یُقِرُّ بِوَلَدِہِ ثُمَّ یَنْتَفِی مِنْہُ قَالَ : یُلاَعِنُ بِکِتَابِ اللہِ وَیَلْزَمُ الْوَلَدُ بِقَضَائِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 17865","","","كتاب النكاح"
"17866","(۱۷۸۶۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ فِی رَجُلٍ أَقَرَّ بِوَلَدٍ لہ مِنْ جَارِیَتِہِ حَتَّی صَارَ رَجُلاً وَزَوَّجَہُ ثُمَّ أَنْکَرَہُ قَالَ : لَیْسَ إنْکَارُہُ بِشَیْئٍ ، یُلْزَقُ بِہِ۔","","Musannaf Ibn Abi Shaybah 17866","","","كتاب النكاح"
"17867","(۱۷۸۶۷) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ قَالَ لَہُ : أَنْ یَنْفِیَہُ ، وَإِنْ کَانَ رَجُلاً۔","","Musannaf Ibn Abi Shaybah 17867","","","كتاب النكاح"
"17868","(۱۷۸۶۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَاصِمٍ قَالَ : جَائَتِ امْرَأَۃٌ إلَی أَبِی مُوسَی وَأَبُوہَا وَزَوْجُہَا وَأُمُّہَا وَہِیَ حُبْلَی یَقُولُ زَوْجُہَا : ہِیَ جَارِیَۃٌ وَإِنَّمَا کُنْت أَلْعَبُ مَعَہَا فَکَلَّمَ الْجَارِیَۃَ ، فَقَالَتْ : زَوَّجَنِیہِ أَبِی وَأُمِّی ، وَکَانَ یَدْخُلُ عَلَیَّ فَیَصْنَعُ بِی مَا یَصْنَعُ الرَّجُلُ بِامْرَأَتِہِ قَالَ : فَضَرَبَ رَأْسَہُ بِالدِّرَّۃِ وَقَالَ : ہِیَ امْرَأَتُک وَالْوَلَدُ وَلَدُک۔","","Musannaf Ibn Abi Shaybah 17868","","","كتاب النكاح"
"17869","(۱۷۸۶۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ وَہُوَ قَوْلُ قَتَادَۃَ : {إذَا أُحْصِنَّ} قَالَ : إذَا أَحْصَنَتْہُنَّ الْبُعُولَۃُ۔","","Musannaf Ibn Abi Shaybah 17869","","","كتاب النكاح"
"17870","(۱۷۸۷۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَقْرَؤُہَا : {فَإِذَا أُحْصِنَّ} یَقُولُ : إذَا تَزَوَّجْنَ۔","","Musannaf Ibn Abi Shaybah 17870","","","كتاب النكاح"
"17871","(۱۷۸۷۱) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنِ الأَعْمَشِِ، عَنْ إبْرَاہِیمَ، عَنِ الأَسْوَدِ، عَنْ عَائِشَۃَ قَالَتْ: کَانَ زَوْجُ بَرِیرَۃَ حُرًّا۔","","Musannaf Ibn Abi Shaybah 17871","","","كتاب النكاح"
"17872","(۱۷۸۷۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : کَانَ زَوْجُہَا حُرًّا۔","","Musannaf Ibn Abi Shaybah 17872","","","كتاب النكاح"
"17873","(۱۷۸۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ أَبِی مَعْشَرٍ ، عَنِ النَّخَعِیِّ ، عَنِ الأَسْوَدِ أَنَّ عَائِشَۃَ حَدَّثَتْہُ : أن زَوْجَ بَرِیرَۃَ کَانَ حُرًّا حِینَ أُعْتِقَتْ۔","","Musannaf Ibn Abi Shaybah 17873","","","كتاب النكاح"
"17874","(۱۷۸۷۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، وَابْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنْ صَفِیَّۃَ ابْنَۃِ أَبِی عُبَیْدٍ قَالَتْ : کَانَ زَوْجُ بَرِیرَۃَ عَبْدًا۔","","Musannaf Ibn Abi Shaybah 17874","","","كتاب النكاح"
"17875","(۱۷۸۷۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّ زَوْجَ بَرِیرَۃَ کَانَ عَبْدًا۔",": Hasan","Musannaf Ibn Abi Shaybah 17875","","","كتاب النكاح"
"17876","(۱۷۸۷۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنْ عِکْرِمَۃَ ، أَنَّ زَوْجَ بَرِیرَۃَ کَانَ عَبْدًا أَسْوَدَ یُقَالُ لَہُ مُغِیثٌ ، عَبْدٌ لِبَنِی الْمُغِیرَۃِ مِنْ بَنِی مَخْزُومٍ۔","","Musannaf Ibn Abi Shaybah 17876","","","كتاب النكاح"
"17877","(۱۷۸۷۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ : حدَّثَنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ عَبْدًا أَسْوَدَ لِبَنِی الْمُغِیرَۃِ یُقَالُ لَہُ مُغِیثٌ کَأَنِّی أَنْظُرُ إلَیْہِ فِی طُرُقِ الْمَدِینَۃِ یَتْبَعُہَا وَدُمُوعُہُ تسیل عَلَی لِحْیَتِہِ یَتَرَضَّاہَا کَی تَخْتَارَہُ فَلَمْ تَخْتَرْہُ یَعْنِی زَوْجَ بَرِیرَۃَ۔",": Sahih","Musannaf Ibn Abi Shaybah 17877","","","كتاب النكاح"
"17878","(۱۷۸۷۸) حَدَّثَنَا حَفْصٌ، عَنْ ہِشَامٍ، عَنْ عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: کان زَوْجُ بَرِیرَۃَ عَبْدا أَسْوَدُ یُقَالُ لَہُ مُغِیثٌ۔",": Sahih","Musannaf Ibn Abi Shaybah 17878","","","كتاب النكاح"
"17879","(۱۷۸۷۹) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ أَنَّہَا أَعْتَقَتْ بَرِیرَۃَ فَخَیَّرَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَکَانَ لَہَا زَوْجٌ حُرٌّ۔",": Sahih","Musannaf Ibn Abi Shaybah 17879","","","كتاب النكاح"
"17880","(۱۷۸۸۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ سِمَاکٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَ زَوْجُ بَرِیرَۃَ عَبْدًا۔",": Hasan","Musannaf Ibn Abi Shaybah 17880","","","كتاب النكاح"
"17881","(۱۷۸۸۱) حدَّثَنَا وَکِیعٌ ، عَنْ زِیَادِ بْنِ خَیْثَمَۃَ ، عَنْ نُعَیْمِ بْنِ أَبِی ہِنْدٍ ، عَنْ عُمَرَ الأَعْوَرِ ، عَنْ عَبْدِ اللہِ بْنِ جَعْفَرٍ ، قَالَ : قَالَتْ عَائِشَۃُ : الْبَیَاضُ نِصْفُ الْحُسْنِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17881","","","كتاب النكاح"
"17882","(۱۷۸۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ قَالَ : أعْطِیَ یُوسُفُ وَأُمُّہُ ثُلُثَ الْحُسْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17882","","","كتاب النكاح"
"17883","(۱۷۸۸۳) حَدَّثَنَا عَفَّانُ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : أُعْطِیَ یُوسُفُ شَطْرَ الْحُسْنِ۔ (احمد ۳/۱۴۸۔ حاکم ۵۷۰)",": Sahih","Musannaf Ibn Abi Shaybah 17883","","","كتاب النكاح"
"17884","(۱۷۸۸۴) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الْجَرِیرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنِ الطُّفَاوِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ یُبَاشِرُ الرَّجُلُ الرَّجُلَ وَلاَ الْمَرْأَۃُ الْمَرْأَۃَ إِلاَّ الْوَالِدُ وَلَدَہُ أَوِ الْوَلَدُ وَالِدَہُ۔\n(ابوداؤد ۴۰۱۵۔ احمد ۲/۳۲۵)",": Da'if","Musannaf Ibn Abi Shaybah 17884","","","كتاب النكاح"
"17885","(۱۷۸۸۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ عبد اللہِ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُبَاشِرَ الْمَرْأَۃُ الْمَرْأَۃَ فِی ثَوْبٍ وَاحِدٍ أَجْلَ أَنْ تَصِفَہَا لِزَوْجِہَا۔ (بخاری ۵۲۴۰۔ ابوداؤد ۲۱۴۳)",": Sahih","Musannaf Ibn Abi Shaybah 17885","","","كتاب النكاح"
"17886","(۱۷۸۸۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ قَالَ : أخبرنی زَیْدُ بْنُ أَسْلَمَ ، عْن عَبْدِ الرَّحْمَنِ بْنِ أَبِی سَعِیدٍ الْخُدْرِیِّ ، عَنْ أَبِیہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لاَ تُفْضِی الْمَرْأَۃُ إلَی الْمَرْأَۃِ فِی ثَوْبٍ وَاحِدٍ وَلاَ الرَّجُلُ إلَی الرَّجُلِ فِی ثَوْبٍ وَاحِدٍ۔ (ترمذی ۲۷۹۳۔ ابوداؤد ۴۰۱۴)",": Hasan","Musannaf Ibn Abi Shaybah 17886","","","كتاب النكاح"
"17887","(۱۷۸۸۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ قَالَ : حَدَّثَنَی یَحْیَی بْنُ أَیُّوبَ الْمِصْرِیُّ قَالَ : أَخْبَرَنِی عَیَّاشُ بْنُ عَبَّاسٍ الْحِمْیَرِیُّ ، عَنْ أَبِی الْحُصَیْنِ الْحَجَرِیِّ الْہَیْثَمِ ، عَنْ عَامِرٍ الْحَجَرِیِّ ، قَالَ : سَمِعْتُ أَبَا رَیْحَانَۃَ صَاحِبَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَی عَنْ مُعَاکَمَۃِ ، أَوْ مُکَاعَمَۃِ الْمَرْأَۃِ الْمَرْأَۃَ لَیْسَ بَیْنَہُمَا شَیْئٌ ، ومُعَاکَمَۃِ أَوْ مُکَاعَمَۃِ الرَّجُلِ الرَّجُلَ فِی شِعَارٍ لَیْسَ بَیْنَہُمَا شَیْئٌ۔\n(ابوداؤد ۴۰۴۶۔ احمد ۴/۱۳۴)",": Da'if","Musannaf Ibn Abi Shaybah 17887","","","كتاب النكاح"
"17888","(۱۷۸۸۸) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللہِ ، عَنِ أبی شِہَابٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُبَاشِرَ الرَّجُلُ الرَّجُلَ وَالْمَرْأَۃُ الْمَرْأَۃَ قَالَ ابْنُ أَبِی لَیْلَی : وَأَنَا أَرَی فِی ذَلِکَ تَعْزِیرًا۔ (حاکم ۲۸۷۔ احمد ۳/۳۴۸)",": Da'if","Musannaf Ibn Abi Shaybah 17888","","","كتاب النكاح"
"17889","(۱۷۸۸۹) حَدَّثَنَا عُبَید اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُبَاشِرَ الرَّجُلُ الرَّجُلَ وَالْمَرْأَۃُ الْمَرْأَۃَ۔ (احمد ۱/۳۱۴۔ ابن حبان ۵۵۸۲)","","Musannaf Ibn Abi Shaybah 17889","","","كتاب النكاح"
"17890","(۱۷۸۹۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ أَنَّ رَجُلاً سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَسْتَأْذِنُ عَلَی أُمِّی ؟ قَالَ : نَعَمْ ، أَتُحِبُّ أَنْ تَرَاہَا عُرْیَانَۃً۔ (بیہقی ۹۷)","","Musannaf Ibn Abi Shaybah 17890","","","كتاب النكاح"
"17891","(۱۷۸۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُسْلِمِ بْنِ نذیر ، عَنْ حُذَیْفَۃَ قَالَ : إِنْ لَمْ تَفْعَلْ أَوْشَکَ أَنْ تَرَی مِنْہَا مَا یَسُوئُک۔",": Sahih","Musannaf Ibn Abi Shaybah 17891","","","كتاب النكاح"
"17892","(۱۷۸۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ رجل لِعُمَرَ : أسْتَأْذِنُ عَلَی أُمِّی ؟ قَالَ : نَعَمْ ، اسْتَأْذِنْ عَلَیْہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 17892","","","كتاب النكاح"
"17893","(۱۷۸۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ قَالَ : جَائَ إلَیْہِ رَجُلٌ ، فَقَالَ: أَسْتَأْذِنُ عَلَی أُمِّی ؟ قَالَ : نَعَمْ ، مَا عَلَی کُلِّ أَحْیَانِہَا تُحِبُّ أَنْ تَرَاہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 17893","","","كتاب النكاح"
"17894","(۱۷۸۹۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ قَالَ : کَانَ عَطَائٌ وَأَخَوَاتٌ لَہُ بِمَکَّۃَ فِی بَیْتٍ وَأَہْلُ مَکَّۃَ یَخْتَلِفُ أَحَدُہُمْ إلَی أَہْلِہِ فِی اللَّیْلِ مِرَارًا ، فَکَانَ یَأْتِیہِنَّ بِاللَّیْلِ فَسَأَلَ ابْنَ عَبَّاسٍ : أَسْتَأْذِنُ عَلَیْہِنَّ کُلَّمَا دَخَلْت؟ فَقَالَ : نَعَمْ ، وَلَمْ یُرَخِّصْ لَہُ فِی الدُّخُولِ عَلَیْہِنَّ بِغَیْرِ إذْنٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 17894","","","كتاب النكاح"
"17895","(۱۷۸۹۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ قَالَ : اسْتَأْذِنْ عَلَی أُمِّکَ ، وَإِنْ کَانَتْ عَجُوزًا۔",": Da'if","Musannaf Ibn Abi Shaybah 17895","","","كتاب النكاح"
"17896","(۱۷۸۹۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ، عَنْ ہُزَیْلٍ ، عَنْ عَبْدِ اللہِ قَالَ : عَلَیْکُمْ أَنْ تَسْتَأْذِنُوا عَلَی أُمَّہَاتِکُمْ۔",": Da'if","Musannaf Ibn Abi Shaybah 17896","","","كتاب النكاح"
"17897","(۱۷۸۹۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنْ کُرْدُوسٍ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ قَالَ : یَسْتَأْذِنُ الرَّجُلُ عَلَی أَبِیہِ وَأُمِّہِ وَعَلَی ابْنِہِ وَعَلَی أخیہ وعلی أُخْتِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17897","","","كتاب النكاح"
"17898","(۱۷۸۹۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، وعَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالاَ یَسْتَأْذِنُ عَلَیْہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17898","","","كتاب النكاح"
"17899","(۱۷۸۹۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی السَّلِیلِ ، عَنْ صِلَۃَ قَالَ یَسْتَأْذِنُ الرَّجُلُ عَلَی أُمِّہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17899","","","كتاب النكاح"
"17900","(۱۷۹۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، عن قتادۃ عَنْ أَبِی ہُرَیْرَۃَ أَنَّہُ قَالَ یستأذن علیہا یعنی علی أمہ۔","","Musannaf Ibn Abi Shaybah 17900","","","كتاب النكاح"
"17901","(۱۷۹۰۱) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ قَالَ سَأَلْتُ عِکْرِمَۃَ قَالَ : قُلْتُ أَیَسْتَأْذِنُ الرَّجُلُ عَلَی أُمِّہِ وَعَلَی أُخْتِہِ ؟ قَالَ : نَعَمْ ، اسْتَأْذِنْ عَلَیْہِمَا۔","","Musannaf Ibn Abi Shaybah 17901","","","كتاب النكاح"
"17902","(۱۷۹۰۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی الْبَخْتَرِیِّ قَالَ : سَأَلَ رَجُلٌ عِکْرِمَۃَ أَسْتَأْذِنُ عَلَی أُمِّی ؟ قَالَ : نَعَمْ ، اسْتَأْذِنْ عَلَی أُمِّک۔","","Musannaf Ibn Abi Shaybah 17902","","","كتاب النكاح"
"17903","(۱۷۹۰۳) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ مِسْعَرٍ، عَنْ عَمْرِو بْنِ مُرَّۃَ، عَنْ أَبِی الْبَخْتَرِیِّ قَالَ: وَأَخُو الْمَرْأَۃِ یَسْتَأْذِنُ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 17903","","","كتاب النكاح"
"17904","(۱۷۹۰۴) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ سَمِعَ ابْنَ عَبَّاسٍ یَقُولُ : إنَّہُ لَمْ یُؤْمَرْ بِہَا أَکْثَرُ النَّاسِ الإِذْنَ وَإِنِّی آمُرُ جَارِیَتِی ہذہ أَنْ تَسْتَأْذِنَ عَلَیَّ۔",": Sahih","Musannaf Ibn Abi Shaybah 17904","","","كتاب النكاح"
"17905","(۱۷۹۰۵) حَدَّثَنَا أَبُو خَالِدٍ، عَنْ عبدالملک، عَنْ عَطَائٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: غَلَبَ الشَّیْطَانُ النَّاسِ عَلَی الاستئذان فِی السَّاعَاتِ {الَّذِینَ مَلَکَتْ أَیْمَانُکُمْ وَالَّذِینَ لَمْ یَبْلُغُوا الْحُلُمَ مِنْکُمْ}۔","","Musannaf Ibn Abi Shaybah 17905","","","كتاب النكاح"
"17906","(۱۷۹۰۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنْ مُحَمَّدِ فی قولہ {وَالَّذِینَ لَمْ یَبْلُغُوا الْحُلُمَ مِنْکُمْ} قَالَ : کَانَ أَہْلُنا یُعَلِّمُونَا أَنْ نُسَلِّمَ قَالَ : فَکَانَ أَحَدُنَا إذَا جَائَ یَقُولُ : السَّلاَمُ عَلَیْکُمْ أَیَدْخُلُ فُلاَنٌ ؟۔","","Musannaf Ibn Abi Shaybah 17906","","","كتاب النكاح"
"17907","(۱۷۹۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ قَالَ : نَزَلَتْ فِی النِّسَائِ: {لِیَسْتَأْذِنْکُمُ الَّذِینَ مَلَکَتْ أَیْمَانُکُمْ}۔",": No Data Available","Musannaf Ibn Abi Shaybah 17907","","","كتاب النكاح"
"17908","(۱۷۹۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، عَنِ الشَّعْبِیِّ : {لِیَسْتَأْذِنْکُمُ الَّذِینَ مَلَکَتْ أَیْمَانُکُمْ} قَالَ : لَیْسَتْ بِمَنْسُوخَۃٍ قُلْتُ : فَإِنَّ النَّاسَ لاَ یَعْمَلُونَ بِہَا قَالَ : اللَّہُ الْمُسْتَعَانُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17908","","","كتاب النكاح"
"17909","(۱۷۹۰۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَنْظَلَۃَ ، قَالَ : سَمِعْتُ الْقَاسِمَ وَسُئِلَ عَنِ الإِذْنِ ، فَقَالَ : اسْتَأْذِنْ عِنْدَ کُلِّ عَوْرَۃٍ ثُمَّ ہُوَ طَوَافٌ بَعْدَہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17909","","","كتاب النكاح"
"17910","(۱۷۹۱۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ : {وَلاَ تَعْزِمُوا عُقْدَۃَ النِّکَاحِ حَتَّی یَبْلُغَ الْکِتَابُ أَجَلَہُ} قَالَ: انْقِضَائُ الْعِدَّۃِ۔","","Musannaf Ibn Abi Shaybah 17910","","","كتاب النكاح"
"17911","(۱۷۹۱۱) حَدَّثَنَا وَکِیعٌ وَالْفَضْلُ ، عَنْ سُفْیَانَ ، عَنْ لَیث ، عَنْ مُجَاہِدٍ : {وَلاَ تَعْزِمُوا عُقْدَۃَ النِّکَاحِ حَتَّی یَبْلُغَ الْکِتَابُ أَجَلَہُ} قَالَ : انْقِضَائُ الْعِدَّۃِ۔","","Musannaf Ibn Abi Shaybah 17911","","","كتاب النكاح"
"17912","(۱۷۹۱۲) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنِ السُّدِّیِّ ، عَنْ أَبِی مَالِکٍ : {وَلاَ تَعْزِمُوا عُقْدَۃَ النِّکَاحِ حَتَّی یَبْلُغَ الْکِتَابُ أَجَلَہُ} قَالَ : لاَ تُوَاعِدُوہَا فِی عِدَّتِہَا إِنِّی أَتَزَوَّجُک حین تَنْقَضِیَ عِدَّتُک۔","","Musannaf Ibn Abi Shaybah 17912","","","كتاب النكاح"
"17913","(۱۷۹۱۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ، عَنْ مَنْصُورٍ، عَنْ مُجَاہِدٍ : {وَاہْجُرُوہُنَّ فِی الْمَضَاجِعِ} قَالَ : لاَ تَقْرَبْہَا۔","","Musannaf Ibn Abi Shaybah 17913","","","كتاب النكاح"
"17914","(۱۷۹۱۴) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ: قوْلُہُ {وَاہْجُرُوہُنَّ فِی الْمَضَاجِعِ} قَالاَ: لاَ یُضَاجِعُہَا۔","","Musannaf Ibn Abi Shaybah 17914","","","كتاب النكاح"
"17915","(۱۷۹۱۵) حَدَّثَنَا حَفْصٌ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ، عَنْ أَبِی الضُّحَی، عَنِ ابْنِ عَبَّاسٍ: {وَاہْجُرُوہُنَّ فِی الْمَضَاجِعِ} قَالَ: إذَا أَطَاعَتْہُ فِی الْمَضْجَعِ فَلَیْسَ لَہُ أَنْ یَضْرِبَہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 17915","","","كتاب النكاح"
"17916","(۱۷۹۱۶) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ حُصَیْنٍ ، عَنْ عِکْرِمَۃَ وَمِقْسَمٍ : قَوْلُہُ {وَاہْجُرُوہُنَّ فِی الْمَضَاجِعِ وَاضْرِبُوہُنَّ} قَالَ : مِقْسَمٌ : وَلاَ تَقْرَبُ فِرَاشَہَا وَقَالَ عِکْرِمَۃُ : ہُوَ الْکَلاَمُ وَقَالاَ جَمِیعًا : {واضْرِبُوہُنَّ} ضَرْبٌ غَیْرُ مُبَرِّحٍ۔","","Musannaf Ibn Abi Shaybah 17916","","","كتاب النكاح"
"17917","(۱۷۹۱۷) حَدَّثَنَا عَفَّانُ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ : {واضْرِبُوہُنَّ} قَالَ : ضَرْبًا غَیْرُ مُبَرِّحٍ غَیْرُ مُؤَثِّرٍ۔","","Musannaf Ibn Abi Shaybah 17917","","","كتاب النكاح"
"17918","(۱۷۹۱۸) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ أَبِی سَلاَّمٍ الْفِہْرِیِّ ، قَالَ : سَمِعْتُ عَلِیَّ بْنَ عَبْدِ اللہِ بْنِ عَبَّاسٍ یَقُولُ : إذَا جَامَعْتَ فَاسْتَتِرْ۔","","Musannaf Ibn Abi Shaybah 17918","","","كتاب النكاح"
"17919","(۱۷۹۱۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا جَامَعَ أَحَدُکُمْ فَلْیَسْتَتِرْ وَلاَ یَتَجَرَّدَانِ تَجَرُّدَ الْعَیْرَیْنِ۔ (طبرانی ۷۶۸۳۔ بزار ۱۴۴۸)","","Musannaf Ibn Abi Shaybah 17919","","","كتاب النكاح"
"17920","(۱۷۹۲۰) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ أَبِی سَلاَّمٍ الفہری ، قَالَ : سَمِعْتُ عَلِیَّ بْنَ عَبْدِ اللہِ بْنِ عَبَّاسٍ یَنْہَی مُسْلِمًا أَنْ یُرَاضِعَ نَصْرَانِیًّا۔","","Musannaf Ibn Abi Shaybah 17920","","","كتاب النكاح"
"17921","(۱۷۹۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ غَالِبٍ أَبِی الْہُذَیْلِ ، عَنْ أَبِی جَعْفَرٍ أَنَّہُ کَرِہَ أَنْ تُرْضِعَ الْیَہُودِیَّۃُ وَالنَّصْرَانِیَّۃ الصَّبِیَّ وَقَالَ : إنَّہَا تَشْرَبُ الْخَمْرَ۔","","Musannaf Ibn Abi Shaybah 17921","","","كتاب النكاح"
"17922","(۱۷۹۲۲) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرب ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ : کَانَ یَکْرَہُ أَنْ تُرْضِعَ امْرَأَتہ بِلَبَنِ الْفُجُورِ۔","","Musannaf Ibn Abi Shaybah 17922","","","كتاب النكاح"
"17923","(۱۷۹۲۳) حَدَّثَنَا شَرِیکٌ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ بَأْسَ بِرَضَاعِ الزَّانِیَۃِ ، أَوْ لَبَنِ الْمَجُوسِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 17923","","","كتاب النكاح"
"17924","(۱۷۹۲۴) حَدَّثَنَا ہُشَیْمٌ قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَائِشَۃَ أَنَّہَا کَانَتْ تَقُولُ لِلنِّسَائِ : لاَ تَصِفننی لأَزْوَاجِکُنَّ۔","","Musannaf Ibn Abi Shaybah 17924","","","كتاب النكاح"
"17925","(۱۷۹۲۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ الْمَکِّیِّ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا تَزَوَّجَ الرجل أَمَۃً وَقَعَ عَلَیْہَا وَلَمْ یَسْتَبْرِئْہَا۔","","Musannaf Ibn Abi Shaybah 17925","","","كتاب النكاح"
"17926","(۱۷۹۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ قَالَ إِذَا تَزَوَّجَہَا لَمْ یَسْتَبْرِئْہَا۔","","Musannaf Ibn Abi Shaybah 17926","","","كتاب النكاح"
"17927","(۱۷۹۲۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ قَالَ : إذَا تَزَوَّجَ الأَمَۃَ تَزَوُّجًا لَمْ یَسْتَبْرِئْہَا۔","","Musannaf Ibn Abi Shaybah 17927","","","كتاب النكاح"
"17928","(۱۷۹۲۸) حَدَّثَنَا ابْنُ مُسْہِرٍ ، وَأَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَخْطُبُ الرَّجُلُ عَلَی خِطْبَۃِ أَخِیہِ وَلاَ یَبِع عَلَی بَیْعِ أَخِیہِ إلاَّ أَنْ یَأْذَنَ لَہُ۔\n(مسلم ۵۰۔ ابوداؤد ۲۰۷۴)",": Sahih","Musannaf Ibn Abi Shaybah 17928","","","كتاب النكاح"
"17929","(۱۷۹۲۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَخْطُب عَلَی خِطْبَۃِ أَخِیہِ۔ (مسلم ۵۲۰۔ ترمذی ۱۱۳۴)",": Sahih","Musannaf Ibn Abi Shaybah 17929","","","كتاب النكاح"
"17930","(۱۷۹۳۰) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُدْرِکٍ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَزْنِی حِینَ یَزْنِی وَہُوَ مُؤْمِنٌ۔",": Da'if","Musannaf Ibn Abi Shaybah 17930","","","كتاب النكاح"
"17931","(۱۷۹۳۱) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، عَنْ شُعْبَۃَ ، عَنْ فِرَاسٍ ، عَنْ مُدْرِکٍ ، عَنِ ابْنِ أَبِی أَوْفَی ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلَہُ۔ (طیالسی ۸۲۳۔ احمد ۴/۳۵۲)",": Hasan","Musannaf Ibn Abi Shaybah 17931","","","كتاب النكاح"
"17932","(۱۷۹۳۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ عَبَّادٍ ، عَنْ أَبَانَ بْنِ عُثْمَانَ قَالَ : یُعْرَفُ الزُّنَاۃُ بِنَتْنِ فُرُوجِہِمْ یَوْمَ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 17932","","","كتاب النكاح"
"17933","(۱۷۹۳۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ قَالَ : إنَّ أَکْبَرَ مَا یُصِیبُ النَّاسَ مِنَ الذُّنُوبِ الزِّنَا ، ہُوَ شَہْوَۃٌ وَلَیْسَ لَہُ رِیحٌ فَیُؤخَذ وَلاَ یَکَادُ تُقَامُ حُدُودُہُ۔","","Musannaf Ibn Abi Shaybah 17933","","","كتاب النكاح"
"17934","(۱۷۹۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، عَنْ زَکَرِیَّا بْنِ صُہَیْبٍ ، عَنْ أَبِی صَالِحٍ قَالَ : بَلَغَنِی أَنَّ أَکْثَرَ ذُنُوبِ أَہْلِ الْجَنَّۃِ فِی النِّسَائِ۔","","Musannaf Ibn Abi Shaybah 17934","","","كتاب النكاح"
"17935","(۱۷۹۳۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ قَالَ لِغِلْمَانِہِ : مَنْ أَرَادَ مِنْکُمُ الْبَائَۃَ زَوَّجْنَاہُ ، لاَ یَزْنِی مِنْکُمُ الزَّانِی إلاَّ نَزَعَ اللَّہُ نُورَ الإِیمَانِ مِنْ قَلْبِہِ فَإِنْ شَائَ أَنْ یَرُدَّہُ رَدَّہُ ، وَإِنْ شَائَ أَنْ یَمْنَعَہُ مَنَعَہُ۔",": Hasan","Musannaf Ibn Abi Shaybah 17935","","","كتاب النكاح"
"17936","(۱۷۹۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، عَنْ عَلِیِّ بْنِ مُدْرِکٍ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : الإِیمَانُ نزہٌ فَمَنْ زَنَی فَارَقَہُ الإِیمَانُ فَمَنْ لاَمَ نَفْسَہُ وَرَاجَعَ رَاجَعَہُ الإِیمَانُ۔",": Sahih","Musannaf Ibn Abi Shaybah 17936","","","كتاب النكاح"
"17937","(۱۷۹۳۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، عَنْ أُسَامَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا تَرَکْت بَعْدِی عَلَی أُمَّتِی فِتْنَۃً أَضَرَّ عَلَی الرِّجَالِ مِنَ النِّسَائِ۔\n(بخاری ۵۰۹۶۔ مسلم ۲۰۹۷)",": Hasan","Musannaf Ibn Abi Shaybah 17937","","","كتاب النكاح"
"17938","(۱۷۹۳۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَمْ یَکُنْ کُفْرُ مَنْ مَضَی إلاَّ مِنْ قِبَلِ النِّسَائِ وَہُوَ کَائِنٌ کُفْرُ مَنْ بَقِیَ مِنْ قِبَلِ النِّسَائِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17938","","","كتاب النكاح"
"17939","(۱۷۹۳۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَحْیَی بْنِ عَبَّادِ بن عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ قَالَتْ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لاَ یَزْنِی الزَّانِی حِینَ یَزْنِی وَہُوَ مُؤْمِنٌ۔","","Musannaf Ibn Abi Shaybah 17939","","","كتاب النكاح"
"17940","(۱۷۹۴۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ بَعْجَۃَ الْجُہَنِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔ (بخاری ۲۴۷۵۔ مسلم ۱۰۰)","","Musannaf Ibn Abi Shaybah 17940","","","كتاب النكاح"
"17941","(۱۷۹۴۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ قَالَ : حدَّثَنِی یَحْیَی بْنُ أَیُّوبَ الْمِصْرِیُّ قَالَ : حَدَّثَنِی یَزِیدُ بْنُ أَبِی حَبِیبٍ ، عَنْ بُکَیْرِ بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ أَنَّ عُمَرَ بْنَ الْخَطَّابِ رُفِعَ إلَیْہِ خَصِیٌّ تَزَوَّجَ امْرَأَۃً وَلَمْ یُعْلِمْہَا فَفَرَّقَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17941","","","كتاب النكاح"
"17942","(۱۷۹۴۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ سَعِیدِ بْنِ یُوسُفَ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ أَنَّ عَلِیَّ بْنَ أَبِی طَالِبٍ کان یقُول : لاَ یَنْکِحُ الْخَصِیُّ حُرَّۃً مُسْلِمَۃً۔",": Da'if","Musannaf Ibn Abi Shaybah 17942","","","كتاب النكاح"
"17943","(۱۷۹۴۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ قَالَ : سَأَلْتُ حَمَّادًا ، عَنْ رَجُلٍ زَوَّجَ ابْنَتَہُ ثُمَّ مَاتَ الزَّوْجُ وَلَمْ تَعْلَمِ الابْنَۃُ بِذَلِکَ ، فَقَالَ : لاَ تَرِثُ وَسَأَلْت الْحَکَمَ ، فَقَالَ : تَرِثُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17943","","","كتاب النكاح"
"17944","(۱۷۹۴۴) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ دَاوُدَ بْنِ جُبَیْرٍ قَالَ : زَفَّ سَعِیدُ بْنُ جُبَیْرٍ ابْنَتَہُ إلَی زَوْجِہَا۔","","Musannaf Ibn Abi Shaybah 17944","","","كتاب النكاح"
"17945","(۱۷۹۴۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ رَجُلٍ حَدَّثَہُ أَنَّ امْرَأَۃً سَأَلَتِ ابْنَہَا أَنْ یُزَوِّجَہَا فَکَرِہَ ذَلِکَ ، وَذَہَبَ إلَی عُمَرَ فَذَکَر ذَلِکَ لَہُ ، فَقَالَ عمر : اذْہَبْ فَإِذَا کَانَ غَدًا أَتَیْتُکُمْ قَالَ : فَجَائَ عُمَرُ فَکَلَّمَہَا وَلَمْ یُکْثِرْ ثُمَّ أَخَذَ بِیَدِ ابْنِہَا ، فَقَالَ لَہُ : زَوِّجْہَا فَوَالَّذِی نَفْسُ عُمَرَ بِیَدِہِ لَوْ أَنَّ حَنْتَمَۃَ بِنْتَ ہِشَامٍ یَعْنِی عُمَرُ أُمَّ نَفْسِہِ سَأَلَتْنِی أَنْ أُزَوِّجَہَا لَزَوَّجْتہَا ، فَزَوَّجَ الرَّجُلُ أُمَّہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 17945","","","كتاب النكاح"
"17946","(۱۷۹۴۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ وَإِسْمَاعِیلَ بْنِ عَبْدِ اللہِ بْنِ أَبِی طَلْحَۃَ أَنَّ أَبَا طَلْحَۃَ خَطَبَ أُمَّ سُلَیْمٍ ، فَقَالَتْ : یَا أَبَا طَلْحَۃَ أَلَسْتَ تَعْلَمُ أَنَّ آلَہَتِکَ الَّتِی تَعْبُدُ خَشَبَۃً تنبت مِنَ الأَرْضِ ، نَجَرَہَا حَبَشِیُّ بَنِی فُلاَنٍ قَالَ : بَلَی ، قَالَتْ : فَلاَ تَسْتَحْیِی مِنْ ذَلِکَ أسلم فَإِنَّک إِنْ أَسْلَمْتَ لَمْ أُرِدْ مِنْک صَدَاقًا غَیْرَہُ قَالَ حَتَّی أَنْظُرَ قَالَ : فَذَہَبَ ثُمَّ جَائَ ، فَقَالَ : أَشْہَدُ أَنْ لاَ إلَہَ إلاَّ اللَّہُ وَأَنَّ مُحَمَّدًا رَسُولُ اللہِ قَالَتْ : یَا أَنَسُ ، قُمْ فَزَوِّجْ أَبَا طَلْحَۃَ ، فَزَوَّجَہَا۔","","Musannaf Ibn Abi Shaybah 17946","","","كتاب النكاح"
"17947","(۱۷۹۴۷) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حَدَّثَنا حُسَیْنُ بْنُ وَاقِدٍ قَالَ : حدَّثَنِی یَزِیدُ النَّحْوِیُّ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا قَدِمَ مِنْ مَغَازِیہِ قَبَّلَ فَاطِمَۃَ۔ (بخاری ۳۶۲۳۔ مسلم ۹۷)","","Musannaf Ibn Abi Shaybah 17947","","","كتاب النكاح"
"17948","(۱۷۹۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ مُجَاہِدٍ أَنَّ أَبَا بَکْرٍ قَبَّلَ رَأْسَ عَائِشَۃَ۔","","Musannaf Ibn Abi Shaybah 17948","","","كتاب النكاح"
"17949","(۱۷۹۴۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ أیمن ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ أَنَّ خَالِدَ بْنَ الْوَلِیدِ اسْتَشَارَ أُخْتَہُ فِی شَیْئٍ فَأَشَارَتْ علیہ فَقَبَّلَ رَأْسَہَا۔ (ترمذی ۱۱۷۲۔ دارمی ۲۷۸۲)","","Musannaf Ibn Abi Shaybah 17949","","","كتاب النكاح"
"17950","(۱۷۹۵۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ جَابِرٍ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُدْخلَ عَلَی الْمُغِیبَاتِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17950","","","كتاب النكاح"
"17951","(۱۷۹۵۱) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ وَمِسْعَرٍ ، عَنْ سَعِیدِ بْنِ إبْرَاہِیمَ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ، قَالَ: قَالَ عُمَرُ: أَلاَ لاَ یَلِجُ رَجُلٌ عَلَی امْرَأَۃٍ إلاَّ وَہِیَ ذَاتُ مَحْرَمٍ مِنْہُ ، وَإِنْ قِیلَ : حَمْوُہَا ؟ أَلاَ إنَّ حَمْوَہَا الْمَوْتُ۔","","Musannaf Ibn Abi Shaybah 17951","","","كتاب النكاح"
"17952","(۱۷۹۵۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی مَعْبَدٍ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ یَقُولُ : سَمِعْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : أَلاَ لاَ یَخْلُوَنَّ رَجُلٌ بِامْرَأَۃٍ إلاَّ وَمَعَہَا ذُو مَحْرَمٍ۔ (بخاری ۳۰۰۶۔ مسلم ۴۲۴)",": Sahih","Musannaf Ibn Abi Shaybah 17952","","","كتاب النكاح"
"17953","(۱۷۹۵۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی زُبَیْرٍ ، عَنْ جَابِرٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : أَلاَ لاَ یَبِیتَنَّ رَجُلٌ عِنْدَ امْرَأَۃٍ إلاَّ أَنْ یَکُونَ نَاکِحًا ، أَوْ ذَا مَحْرَمٍ۔ (مسلم ۱۹۔ ابن حبان ۵۵۸۷)",": Sahih","Musannaf Ibn Abi Shaybah 17953","","","كتاب النكاح"
"17954","(۱۷۹۵۴) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ أَبِی الْخَیْرِ ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إیَّاکُمْ وَالدُّخُولَ عَلَی النِّسَائِ ، فَقَالَ رَجُلٌ مِنَ الأَنْصَارِ : یَا رَسُولَ اللہِ ، إلاَّ الْحَمْوَ ؟ فَقَالَ : الْحَمْوُ الْمَوْتُ۔ (بخاری ۵۲۳۲۔ مسلم ۲۱)",": Sahih","Musannaf Ibn Abi Shaybah 17954","","","كتاب النكاح"
"17955","(۱۷۹۵۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : سَمِعْتُ ذَکْوَانَ یُحَدِّثُ عَنْ مَوْلًی لِعَمْرِو بْنِ الْعَاصِ أنَّہُ أَرْسَلَہُ إلَی عَلِیٍّ یَسْتَأْذِنُ عَلَی أَسْمَائَ ابْنَۃِ عُمَیْسٍ فَأَذِنَ لَہُ حَتَّی إذَا فَرَغَ مِنْ حَاجَتِہِ سَأَلَ الْمَوْلَی عَمْرًا عَنْ ذَلِکَ ، فَقَالَ إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَانَا أَنْ نَدْخُلَ عَلَی النِّسَائِ بِغَیْرِ إذْنِ أَزْوَاجِہِنَّ۔\n(ترمذی ۲۷۷۹۔ احمد ۴/۲۰۳)",": Da'if","Musannaf Ibn Abi Shaybah 17955","","","كتاب النكاح"
"17956","(۱۷۹۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ زِیَادِ بْنِ فَیَّاضٍ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ قَالَ : قَالَ عَمْرُو بْنُ الْعَاصِ : نُہِینَا أَنْ نَدْخُلَ عَلَی الْمُغِیبَاتِ إلاَّ بِإِذْنِ أَزْوَاجِہِنَّ۔",": Sahih","Musannaf Ibn Abi Shaybah 17956","","","كتاب النكاح"
"17957","(۱۷۹۵۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا أَنْ یَتَزَوَّجَ الرَّجُلُ عَلَی کَذَا وَکَذَا وَصِیفًا۔","","Musannaf Ibn Abi Shaybah 17957","","","كتاب النكاح"
"17958","(۱۷۹۵۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ بَأْسَ أَنْ یَتَزَوَّجَ الرَّجُلُ عَلَی بِنْتٍ وَخَادِمٍ وَعَلَی الْوُصَفَائِ وَالْوَصَائِفِ۔","","Musannaf Ibn Abi Shaybah 17958","","","كتاب النكاح"
"17959","(۱۷۹۵۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعَلاَئِ بْنِ عَبْدِ الْکَرِیمِ الْیَامِیِّ ، عَنْ عَمَّارِ بْنِ عِمْرَانَ رَجُلٍ مِنْ زَیْدِ اللہِ ، عَنِ امْرَأَۃٍ مِنْہُمْ ، عَنْ عَائِشَۃَ أَنَّہَا شَوَّفَتْ جَارِیَۃً وَطَافَتْ بِہَا وَقَالَتْ : لَعَلَّنَا نَتَصَید بِہَا شَبَابَ قُرَیْشٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 17959","","","كتاب النكاح"
"17960","(۱۷۹۶۰) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا أُسَامَۃُ بْنُ زَیْدٍ ، عَنْ أَبِی حَازِمٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ السَّاعِدِیِّ أَنَّہُمْ مَرُّوا عَلَیْہِ بِجَارِیَۃٍ قَدْ زُیِّنَتْ قَالَ : فَدَعَا بِہَا وَنَظَرَ إلَیْہَا وَأَجْلَسَہَا فِی حِجْرِہِ ، وَمَسَحَ عَلَی رَأْسِہَا وَدَعَا لَہَا بِالْبَرَکَۃِ۔",": Hasan","Musannaf Ibn Abi Shaybah 17960","","","كتاب النكاح"
"17961","(۱۷۹۶۱) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا أُسَامَۃُ بْنُ زَیْدٍ ، عَنْ بَعْضِ أَشْیَاخِہِ قَالَ قَالَ : عُمَرُ : إذَا أَرَادَ أحَدٌ مِنْکُمْ أَنْ یُحَسِّنَ الْجَارِیَۃَ فَلْیُزَیِّنْہَا وَلْیَطَّوَّفْ بِہَا یَتَعَرَّضُ بِہَا رِزْقَ اللہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17961","","","كتاب النكاح"
"17962","(۱۷۹۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ : لاَ تُکْرِہُوا فَتَیَاتِکُمْ عَلَی الرجل الدَّمِیمِ مِنَ الرِّجَالِ فَإِنَّہُنَّ یُحْبِبْنَ مِنْ ذَلِکَ مَا تُحِبُّونَ۔","","Musannaf Ibn Abi Shaybah 17962","","","كتاب النكاح"
"17963","(۱۷۹۶۳) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَتَزَوَّجَ الرَّجُلُ فِی أَرْضِ الْحَرْبِ وَیَدَعُ وَلَدَہُ فِیہِمْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17963","","","كتاب النكاح"
"17964","(۱۷۹۶۴) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ أَنَّہُ کَرِہَ نِکَاحَ نَصَارَی أَہْلِ الرُّومِ مِنْ غَیْرِ أَہْلِ الْعَہْدِ قَالَ : فَوَصَفَ مُحَمَّدٌ الرَّجُلَ یَکُونُ أَسِیرًا فَیُرِیدُ أَنْ یَتَزَوَّجَ فَیَکْرَہُ ذَلِکَ لَہُ۔","","Musannaf Ibn Abi Shaybah 17964","","","كتاب النكاح"
"17965","(۱۷۹۶۵) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : لاَ یُحْصِنُ الرَّجُلَ نِکَاحُ الْحَرَامِ۔","","Musannaf Ibn Abi Shaybah 17965","","","كتاب النكاح"
"17966","(۱۷۹۶۶) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ، عَنْ عَبْدِالْعَزِیزِ بْنِ عُبَیْدِاللہِ عن الشعبی قَالَ لاَ یُحْصِنُ الرَّجُلَ نِکَاحُ الْحَرَامِ۔","","Musannaf Ibn Abi Shaybah 17966","","","كتاب النكاح"
"17967","(۱۷۹۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ بُدَیل بْنِ مَیْسَرَۃَ ، عَنْ أَبِی عَطِیَّۃَ ، عَنِ امْرَأَۃٍ مِنْہُمْ قَالَت : سَمِعْتُ عُمَرَ یَنْہَی عَنِ النَّقْشِ وَالتَّطَارِیفِ فِی الْخِضَابِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17967","","","كتاب النكاح"
"17968","(۱۷۹۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا قَالَ حَدَّثَتْنِی أُمَیَّۃُ قَالَتْ : کُنْت أُقین الْعَرَائِسَ بِالْمَدِینَۃِ فَسَأَلْت عَائِشَۃَ عَنِ الْخِضَابِ ، فَقَالَتْ : لاَ بَأْسَ بِہِ مَا لَمْ یَکُنْ فِیہِ نَقْشٌ۔",": Da'if","Musannaf Ibn Abi Shaybah 17968","","","كتاب النكاح"
"17969","(۱۷۹۶۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ خَالِد ، عَنْ شَیْخٍ أَنَّ عُمَرَ نَہَی عَنْ نَقْشٍ فِی الْخِضَابِ وَالتَّطَارِیفِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17969","","","كتاب النكاح"
"17970","(۱۷۹۷۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ عَبْدِ اللہِ بْنِ حَفْصٍ ، عَنْ یَعْلَی بْنِ مُرَّۃَ قَالَ : مَرَرْت عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا مُتَخَلِّقٌ بِالزَّعْفَرَانِ ، فَقَالَ لِی : یَا یَعْلَی ، ہَلْ لَکَ امْرَأَۃٌ ؟ فَقُلْتُ : لاَ ، قَالَ : فَاذْہَبْ فَاغْسِلْہُ ثُمَّ اغْسِلْہُ ثُمَّ لاَ تَعُدْ ، قَالَ : فَغَسَلْتہ ثُمَّ غَسَلْتہ ثُمَّ لَمْ أَعُدْ۔\n(ترمذی ۲۸۱۶۔ احمد ۴/۱۷۱)",": Da'if","Musannaf Ibn Abi Shaybah 17970","","","كتاب النكاح"
"17971","(۱۷۹۷۱) حَدَّثَنَا مُعْتَمِرٌ وَجَرِیرٌ ، عَنِ الرُّکَیْنِ ، عَنِ الْقَاسِمِ بْنِ حَسَّانَ ، عَنْ عَمِّہِ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، عَنْ عَبْدِ اللہِ أَنَّ نَبِیَّ اللہِ کَرِہَ الصُّفْرَۃَ یَعْنِی الْخَلُوقَ۔ (ابوداؤد ۴۲۱۹۔ ابویعلی ۵۰۷۴)",": Da'if","Musannaf Ibn Abi Shaybah 17971","","","كتاب النكاح"
"17972","(۱۷۹۷۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، عَنْ أَنَسٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ التَّزَعْفُرِ۔ (مسلم ۱۶۶۳۔ ابوداؤد ۴۱۷۶)",": Sahih","Musannaf Ibn Abi Shaybah 17972","","","كتاب النكاح"
"17973","(۱۷۹۷۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ الْحَسَنِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی سَوَّادَ بْنَ عَمْرٍو مُتَخَلِّقًا، فَقَالَ : خطْ خطْ ، وَرْسْ وَرْسْ۔ (عبدالرزاق ۱۸۰۳۸)","","Musannaf Ibn Abi Shaybah 17973","","","كتاب النكاح"
"17974","(۱۷۹۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ ، عَنْ کَثِیرٍ مَوْلَی ابْنِ سَمُرَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تَقْرَبُ الْمَلاَئِکَۃُ مُتَضَمِّخًا بِخَلُوقٍ۔",": Hasan","Musannaf Ibn Abi Shaybah 17974","","","كتاب النكاح"
"17975","(۱۷۹۷۵) حَدَّثَنَا أَبُو دَاوُدَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ أَنَّ الأَشْعَرِیَّ لَمَّا قَدِمَ الْبَصْرَۃَ رَأَی قَیْسَ بْنَ عُبَادٍ وَعَلَیْہِ أَثَرُ صُفْرَۃٍ، أَوْ قَالَ: خَلُوقٍ قَالَ: فَنَظَرَ إلَیْہِ فَانْطَلَقَ فغَسَلُہُ ثُمَّ جَائَ، فَقَالَ الأَشْعَرِیُّ: مَا أَسْرَعُ مَا أعتب ہَذَا۔",": Sahih","Musannaf Ibn Abi Shaybah 17975","","","كتاب النكاح"
"17976","(۱۷۹۷۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی أنَّہُ دُعِیَ إلَی عُرْسٍ بِلَیْلٍ فَادَّہَنَ بِدُہْنٍ فِیہِ صُفْرَۃٌ فَأَصْبَحَ وَفِی لِحْیَتِہِ صُفْرَۃٌ فَغَسَلَہَا فَلَمْ یَذْہَبْ فَغَسَلَہَا بِصَابُونٍ۔","","Musannaf Ibn Abi Shaybah 17976","","","كتاب النكاح"
"17977","(۱۷۹۷۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ ، عَنْ یَحْیَی بْنِ یَعْمَُرَ ، عَنْ عَمَّارٍ قَالَ : قَدِمْت مِنَ سَفَرٍ فَمَسَّحَنِی أَہْلِی بِشَیْئٍ مِنَ صُفْرَۃٍ فَأَتَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَلَّمْت عَلَیْہِ فَلَمْ یَرُدَّ عَلَیَّ وَلَمْ یُرَحِّبْ بِی وَقَالَ : انْطَلِقْ فَاغْسِلْ عَنْک ہَذَا ، فَذَہَبْتُ فَغَسَلْتُہُ فَبَقِیَ مِنْ أَثَرِہِ شَیْئٌ فَأَتَیْتُہُ فَسَلَّمْت عَلَیْہِ فَلَمْ یَرُدَّ عَلَیَّ وَلَمْ یُرَحِّبْ بِی ، فَقَالَ : انْطَلِقْ فَاغْسِلْ عَنْک ہَذَا ، فَذَہَبْتُ فَغَسَلْتہ ثُمَّ جِئْت فَسَلَّمْت عَلَیْہِ فَرَحَّبَ بِی وَقَالَ : إنَّ الْمَلاَئِکَۃَ لاَ تَقْرَبُ جِنَازَۃَ کَافِرٍ وَلاَ جُنُبٍ وَلاَ مُتَضَمِّخٍ بِخَلُوقٍ۔ (مسندہ ۴۴۱)","","Musannaf Ibn Abi Shaybah 17977","","","كتاب النكاح"
"17978","(۱۷۹۷۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ النُّعْمَانِ بْنِ سَعْدٍ قَالَ : رَأَیْتُ الْمُغِیرَۃَ بْنَ شُعْبَۃَ مُضَمَّخًا بِالْخَلُوقِ کَأَنَّہُ عُرْجُونٌ۔",": Da'if","Musannaf Ibn Abi Shaybah 17978","","","كتاب النكاح"
"17979","(۱۷۹۷۹) حَدَّثَنَا ہُشَیْمُ بْنُ أَبِی سَاسَانَ ، عَنْ أَبَانَ بْنِ کَثِیرٍ النَّہْشَلِیِّ قَالَ : رَأَیْتُ أَنَسًا قَدْ مَسَحَ ذِرَاعَیْہِ بِشَیْئٍ مِنْ خَلُوقٍ مِنْ وَضَحٍ کَانَ بِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17979","","","كتاب النكاح"
"17980","(۱۷۹۸۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ: الْوَلَدُ لِلْفِرَاشِ۔ (بخاری ۲۴۲۱۔ مسلم ۱۰۸۱)",": Sahih","Musannaf Ibn Abi Shaybah 17980","","","كتاب النكاح"
"17981","(۱۷۹۸۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، عَنْ أَبِیہِ ، عَنْ عُمَرَ ، قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْوَلَدِ لِلْفِرَاشِ۔ (احمد ۲۵۔ ابویعلی ۱۹۹)",": Da'if","Musannaf Ibn Abi Shaybah 17981","","","كتاب النكاح"
"17982","(۱۷۹۸۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ وَأَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : الْوَلَدُ لِلْفِرَاشِ۔ (مسلم ۱۰۸۱۔ ترمذی ۱۱۵۷)",": Sahih","Musannaf Ibn Abi Shaybah 17982","","","كتاب النكاح"
"17983","(۱۷۹۸۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا حُسَیْنُ الْمُعَلِّمُ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : الْوَلَدُ لِلْفِرَاشِ وَلِلْعَاہِرِ الأَثْلَبُ قِیلَ : وَمَا الأَثْلَبُ ؟ قَالَ : الْحَجَرُ۔\n(ابوداؤد ۲۲۶۸۔ احمد ۲/۱۷۹)",": Hasan","Musannaf Ibn Abi Shaybah 17983","","","كتاب النكاح"
"17984","(۱۷۹۸۴) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ شُرَحْبِیلَ بْنِ مُسْلِمٍ ، قَالَ : سَمِعْتُ أَبَا أُمَامَۃَ الْبَاہِلِیَّ یَقُولُ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الْوَلَدُ لِلْفِرَاشِ۔ (ترمذی ۲۱۲۰۔ ابوداؤد ۲۲۶۹)",": Hasan","Musannaf Ibn Abi Shaybah 17984","","","كتاب النكاح"
"17985","(۱۷۹۸۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا مَہْدِیُّ بْنُ مَیْمُونٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی یَعْقُوبَ ، عَنِ الْحَسَنِ بْنِ سَعْدٍ قَالَ: حَدَّثَنِی رَبَاحٌ الْحَبَشِیُّ، عَنْ عُثْمَانَ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِالْوَلَدِ لِلْفِرَاشِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17985","","","كتاب النكاح"
"17986","(۱۷۹۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ مُحَمَّدِ بْنِ زِیَادٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْوَلَدُ لِلْفِرَاشِ وَلِلْعَاہِرِ الْحَجَرُ۔ (بخاری ۶۷۵۰۔ احمد ۲/۳۸۶)",": Sahih","Musannaf Ibn Abi Shaybah 17986","","","كتاب النكاح"
"17987","(۱۷۹۸۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ ، عَنْ عَمْرِو بْنِ خَارِجَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : الْوَلَدُ لِلْفِرَاشِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17987","","","كتاب النكاح"
"17988","(۱۷۹۸۸) حُدِّثْتُ عن جَرِیر ، عَنْ مُغِیرَۃَ ، عَن أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ قَالَ: الْوَلَدُ لِلْفِرَاشِ۔ (ابویعلی ۵۱۲۶۔ ابن حبان ۴۱۰۴)","","Musannaf Ibn Abi Shaybah 17988","","","كتاب النكاح"
"17989","(۱۷۹۸۹) حَدَّثَنَا أَبُو أُسَامَۃَ قَالَ : حدَّثَنِی شُعْبَۃُ قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا ، عَنِ الرَّجُلِ یَلْحَقُ بِأَرْضِ الْعَدُوِّ أَتَتَزَوَّجُ امْرَأَتُہُ ؟ قَالَ : أَحَدُہُمَا : لاَ ، وَقَالَ : الآخَرُ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 17989","","","كتاب النكاح"
"17990","(۱۷۹۹۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حَمَّادِ بْنِ زَیْدٍ قَالَ : حدَّثَنَا عَاصِمٌ قَالَ عُمَرُ بْنُ الْخَطَّابِ : عَلَیْکُمْ بِالأَبْکَارِ مِنَ النِّسَائِ فَإِنَّہُنَّ أَعْذَبُ أَفْوَاہًا وَأَصَحُّ أَرْحَامًا وَأَرْضَی بِالْیَسِیرِ۔","","Musannaf Ibn Abi Shaybah 17990","","","كتاب النكاح"
"17991","(۱۷۹۹۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : أَخْبَرَنَا سُفْیَانُ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ مَسْعُودٍ قَالَ : تَزَوَّجُوا الأَبْکَارَ فَإِنَّہُنَّ أَقَلُّ خِبًّا وَأَشَدُّ وُدًّا۔",": Da'if","Musannaf Ibn Abi Shaybah 17991","","","كتاب النكاح"
"17992","(۱۷۹۹۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ بْنِ خُثَیْمٍ ، عَنْ مَکْحُولٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَلَیْکُمْ بِالْجَوَارِی الشَّوَابِّ فَانْکِحُوہُنَّ فَإِنَّہُنَّ أَطْیَبُ أَفْوَاہًا وَأَعَزُّ أَخْلاَقًا أفیح أَرْحَامًا۔ (سعید بن منصور ۵۱۴۔ عبدالرزاق ۱۹۳۴۲)","","Musannaf Ibn Abi Shaybah 17992","","","كتاب النكاح"
"17993","(۱۷۹۹۳) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الأَعْمَشِِ ، عَنْ سَالِمٍ ، عَنْ جَابِرٍ ، قَالَ : سَأَلَنِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : بِکْرًا تَزَوَّجْت أَمْ ثَیِّبًا ؟ قَالَ : قُلْتُ : لاَ بَلْ ثَیِّبًا قَالَ : فَہَلاَّ جَارِیَۃً تُلاَعِبُہَا وَتُلاَعِبُک۔\n(ابوداؤد ۲۰۴۱۔ بیہقی ۳۵۱)",": Sahih","Musannaf Ibn Abi Shaybah 17993","","","كتاب النكاح"
"17994","(۱۷۹۹۴) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ الْعَبْدِیِّ، عَنْ نُبَیْحِ بْنِ عَبْدِ اللہِ الْعَنَزِیِّ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ قَالَ: مَشَیْت مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ: أَلَک امْرَأَۃٌ یَا جَابِرُ؟ قُلْتُ: نَعَمْ ، فَقَالَ : ثَیِّبًا نَکَحْت أَمْ بِکْرًا ؟ قُلْتُ: تَزَوَّجْتہَا وَہِیَ ثَیِّبٌ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلَوْلاَ تَزَوَّجْتہا جَارِیَۃً تُلاَعِبُہَا قَالَ : قُلْتُ لَہُ : قتل أبی مَعَک یَوْم کَذَا وَکَذَا وَترَکَ جَوَارِیًا لہ فَکَرِہْت أَنْ أَضُمَّ إلَیْہِنَّ جَارِیَۃً ، فَتَزَوَّجْت ثَیِّبًا تَقْصَعُ قَمْلَ إحْدَاہُنَّ ، وَتَخِیطُ دِرْعَ إحْدَاہُنَّ إذَا تَخَرَّقَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فَإِنَّک نِعِمَّا رَأَیْت۔ (مسلم ۵۵۔ احمد ۳/۳۵۸)",": Sahih","Musannaf Ibn Abi Shaybah 17994","","","كتاب النكاح"
"17995","(۱۷۹۹۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : مَا بَقِیَ فِی شَیْئٍ مِنْ أَخْلاَقِ الْجَاہِلِیَّۃِ ، إلاَّ أَنِّی لاَ أُبَالِی إلی أَیِٔ الْمُسْلِمِینَ نَکَحْتُ وَأَیَّہُمْ أَنْکَحْتُ۔","","Musannaf Ibn Abi Shaybah 17995","","","كتاب النكاح"
"17996","(۱۷۹۹۶) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عُمَرَ ، أَنَّہُ نَہَی أَنْ یَتَزَوَّجَ الْعَرَبِیُّ الأَمَۃَ۔",": Sahih","Musannaf Ibn Abi Shaybah 17996","","","كتاب النكاح"
"17997","(۱۷۹۹۷) حَدَّثَنَا سُوَیْد بْنُ عَمْرٍو الْکَلْبِیُّ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ أَبِی سَلَمَۃَ قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ بْنِ کَثِیرِ بْنِ الصَّلْتِ قَالَ نَکَحَ مَوْلًی لَنَا عَرَبِیَّۃً فَأُوتِیَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ لیستعدی عَلَیْہِ ، فَقَالَ : وَاللَّہِ لَقَدْ عَدَا مَوْلَی أَلِ کَثِیرٍ طَوْرَہُ۔","","Musannaf Ibn Abi Shaybah 17997","","","كتاب النكاح"
"17998","(۱۷۹۹۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَبِیبٍ ، عَنْ إبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ طَلْحَۃَ ، قَالَ : قَالَ عُمَرُ : لأَمْنَعَنَّ فُرُوجَ ذَوَاتِ الأَحْسَابِ مِنَ النِّسَائِ إلاَّ مِنَ الأَکْفَائِ۔","","Musannaf Ibn Abi Shaybah 17998","","","كتاب النكاح"
"17999","(۱۷۹۹۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حَدَّثَنِی مِسْعَر ، قَالَ : حَدَّثَنِی عُمَرُ بْنُ قَیْسٍ ، عَنْ عَمْرِو بْنِ أَبِی قُرَّۃَ الْکِنْدِیِّ قَالَ : عَرَضَ أَبِی عَلَی سَلْمَانَ أُخْتًا لہ فَأَبَی وَتَزَوَّجَ مَوْلاَۃً لَہُ یُقَالُ لَہَا بُقَیْرَۃُ۔",": Sahih","Musannaf Ibn Abi Shaybah 17999","","","كتاب النكاح"
"18000","(۱۸۰۰۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الْکِنْدِیِّ ، عَنْ سَلْمَانَ قَالَ : لاَ نَؤُمُّہُمْ وَلاَ نَنْکِحُ نِسَائَہُمْ۔",": Sahih","Musannaf Ibn Abi Shaybah 18000","","","كتاب النكاح"
"18001","(۱۸۰۰۱) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنِ ابْنِ أَبِی ذِئْبٍ قَالَ قَالَ ابْنُ شِہَابٍ فِی الْعَرَبِیِّ وَالْمَوْلَی : لاَ یَسْتَوِیَانِ فِی النَّسَبِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 18001","","","كتاب النكاح"
"18002","(۱۸۰۰۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ : حدَّثَنَا حَسَنٌ ، قَالَ : سَأَلْتُ ابْنَ أَبِی لَیْلَی ، عَنِ الْکُفُؤِ فِی النِّکَاحِ ، فَقَالَ : فِی الدِّینِ وَالْمَنْصِبِ قَالَ : قُلْتُ : فِی الْمَالِ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 18002","","","كتاب النكاح"
"18003","(۱۸۰۰۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ شَقِیقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ أَحَدَ أَغْیَرُ مِنَ اللہِ وَلِذَلِکَ حَرَّمَ الْفَوَاحِشَ مَا ظَہَرَ مِنْہَا ، وَمَا بَطَنَ۔\n(مسلم ۳۳۔ بخاری ۷۴۰۳)",": Sahih","Musannaf Ibn Abi Shaybah 18003","","","كتاب النكاح"
"18004","(۱۸۰۰۴) حَدَّثَنَا الْحُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ وَرَّادٍ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ أَتَعْجَبُونَ مِنْ غَیْرَۃِ سَعْدٍ ؟ فَوَاللَّہِ لأَنَا أَغْیَرُ مِنْ سَعْدٍ وَاللَّہُ أَغْیَرُ مِنِّی وَمن ا??َجْلِ غَیْرَۃِ اللہِ حَرَّمَ الْفَوَاحِشَ مَا ظَہَرَ مِنْہَا ، وَمَا بَطَنَ۔ (بخاری ۷۴۱۶۔ مسلم ۱۷)",": Sahih","Musannaf Ibn Abi Shaybah 18004","","","كتاب النكاح"
"18005","(۱۸۰۰۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ : حدَّثَنَا الْحَجَّاجُ بْنُ أَبِی عُثْمَانَ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ ، عَنِ ابْنِ عَتِیکٍ الأَنْصَارِیِّ ، عَنْ أَبِیہِ ، قَالَ : قَالَ : نَبِیُّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مِنَ الْغَیْرَۃِ مَا یُحِبُّ اللَّہُ وَمِنْہَا مَا یُبْغِضُ اللَّہُ فَأَمَّا الْغَیْرَۃُ الَّتِی یُحِبُّ اللَّہُ فَالْغَیْرَۃُ فِی الرِّیبَۃِ ، وَأَمَّا الْغَیْرَۃُ الَّتِی یُبْغِضُ اللَّہُ فَالْغَیْرَۃُ فِی غَیْرِ رِیبَۃٍ۔ (احمد ۵/۴۴۵۔ دارمی ۲۲۲۶)",": Da'if","Musannaf Ibn Abi Shaybah 18005","","","كتاب النكاح"
"18006","(۱۸۰۰۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ : قَالَ عَبْدُ اللہِ : احْبِسُوا النِّسَائَ فِی الْبُیُوتِ فَإِنَّ النِّسَائَ عَوْرَۃٌ وَإِنَّ الْمَرْأَۃَ إذَا خَرَجَتْ مِنْ بَیْتِہَا اسْتَشْرَفَہَا الشَّیْطَانُ وَقَالَ : لَہَا : إنَّک لاَ تَمُرِّینَ بِأَحَدٍ إلاَّ أُعْجِبَ بِک۔ (ترمذی ۱۱۷۳۔ ابن حبان ۵۵۹۸)",": Sahih","Musannaf Ibn Abi Shaybah 18006","","","كتاب النكاح"
"18007","(۱۸۰۰۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حَارِثَۃَ بْنِ مُضَرِّبٍ ، قَالَ : قَالَ عُمَرُ : اسْتَعِینُوا عَلَی النِّسَائِ بِالْعُرْیِ إنَّ إحْدَاہُنَّ إذَا کَثُرَتْ ثِیَابُہَا وَحَسُنَتْ زِینَتُہَا أَعْجَبَہَا الْخُرُوجُ۔",": Sahih","Musannaf Ibn Abi Shaybah 18007","","","كتاب النكاح"
"18008","(۱۸۰۰۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ رَجَائٍ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ سُمَیٍّ ، عَنْ أَبِی بَکْرٍ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ قَالَ : کُلُّ شَیْئٍ مِنَ الْمَرْأَۃِ عَوْرَۃٌ حَتَّی ظُفُرُہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 18008","","","كتاب النكاح"
"18009","(۱۸۰۰۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی غَیُورٌ وَإِنَّ إبْرَاہِیمَ کَانَ غَیُورًا ، وَمَا مِنَ امْرِئٍ لاَ یَغَارُ إلاَّ مَنْکُوسُ الْقَلْبِ۔",": Da'if","Musannaf Ibn Abi Shaybah 18009","","","كتاب النكاح"
"18010","(۱۸۰۱۰) حَدَّثَنَا یَحْیَی بْنُ الْیَمَانِ، عَنْ سُفْیَانَ، عَنْ جَابِرٍ وَمُطَرِّفٍ، عَنِ الشَّعْبِیِّ قَال: إذَا دُرِأَ اللِّعَانَ أُلْزِقَ بِہِ الْوَلَدُ۔","","Musannaf Ibn Abi Shaybah 18010","","","كتاب النكاح"
"18011","(۱۸۰۱۱) حَدَّثَنَا یَحْیَی بْنُ الْیَمَانِ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ َمُجَاہِدٍ ، وَعَطَائٍ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 18011","","","كتاب النكاح"
"18012","(۱۸۰۱۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ: حدَّثَنَا زُہَیْرٌ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ قَالَ : إذَا لَمْ یَکُنْ لِعَانٌ أُلْحِقَ الْوَلَدُ بِالْوَالِدِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 18012","","","كتاب النكاح"
"18013","(۱۸۰۱۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ قَالاَ : إذَا زَنَی الرَّجُلُ بِالْمَرْأَۃِ فَلَیْسَ لَہُ أَنْ یَتَزَوَّجَ ابْنَتَہَا وَلاَ أُمَّہَا۔","","Musannaf Ibn Abi Shaybah 18013","","","كتاب النكاح"
"18014","(۱۸۰۱۴) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَطَائٍ قَالَ : إذَا أَتَی الرَّجُلُ الْمَرْأَۃَ حَرَامًا حَرُمَتْ عَلَیْہِ ابْنَتُہَا وَإِذَا أَتَی ابْنَتَہَا حَرُمَتْ عَلَیْہِ أُمُّہَا۔","","Musannaf Ibn Abi Shaybah 18014","","","كتاب النكاح"
"18015","(۱۸۰۱۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ فِی الرَّجُلِ یَفْجُرُ بِالْمَرْأَۃِ قَالاَ : لاَ یَحِلُّ لَہُ شَیْئٌ مِنْ بَنَاتِہَا۔","","Musannaf Ibn Abi Shaybah 18015","","","كتاب النكاح"
"18016","(۱۸۰۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ مُسَبِّحٍ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ ، عَنْ رَجُلٍ فَجَرَ بِأَمَۃٍ ثُمَّ أَرَادَ أَنْ یَتَزَوَّجَ أُمَّہَا قَالَ : لاَ یَتَزَوَّجُہَا۔","","Musannaf Ibn Abi Shaybah 18016","","","كتاب النكاح"
"18017","(۱۸۰۱۷) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَا سَیْفٌ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ طَاوُوسٍ ، أَنَّہُ کَانَ یَقُولُ : لو أنَّ رَجُلاً تَزَوَّجَ امْرَأَۃً فَطَلَّقَہَا ، أَوْ مَاتَ عَنْہَا وَلَہَا ابْنَۃٌ ، یَحِلُّ لابْنِ الرَّجُلِ أَنْ یَتَزَوَّجَہَا۔","","Musannaf Ibn Abi Shaybah 18017","","","كتاب النكاح"
"18018","(۱۸۰۱۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَا سَیْفٌ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عَطَائٍ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 18018","","","كتاب النكاح"
"18019","(۱۸۰۱۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَا سَیْفٌ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 18019","","","كتاب النكاح"
"18020","(۱۸۰۲۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سَیْفٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عِکْرِمَۃَ مَوْلَی ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَرِہَہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 18020","","","كتاب النكاح"
"18021","(۱۸۰۲۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، وَوَکِیعٌ ، وَحَفْصٌ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ ؛ {فَطَلِّقُوہُنَّ لِعِدَّتِہِنَّ} قَالَ : فِی غَیْرِ جِمَاعٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 18021","","","كتاب الجنة"
"18022","(۱۸۰۲۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا أَرَادَ الرَّجُلُ أَنْ یُطَلِّقَ امْرَأَتَہُ ، فَلْیُطَلِّقْہَا طَاہِرًا فِی غَیْرِ جِمَاعٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 18022","","","كتاب الجنة"
"18023","(۱۸۰۲۳) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ یَزِیدَ الدَّالاَنِیِّ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ الْحِمْیَرِیِّ ، قَالَ : بَلَغَ أَبَا مُوسَی أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَجَدَ عَلَیْہِمْ ، فَأَتَاہُ فَذَکَرَ ذَلِکَ لَہُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَقُولُ أَحَدُکُمْ : قَدْ تَزَوَّجْتُ ، قَدْ طَلَّقْتُ وَلَیْسَ کَذَا عِدَّۃُ الْمُسْلِمِینَ ، طَلِّقُوا الْمَرْأَۃَ فِی قُبُلِ عِدَّتِہَا۔ (ابن ماجہ ۲۰۱۷۔ ابن حبان ۴۲۶۵)","","Musannaf Ibn Abi Shaybah 18023","","","كتاب الجنة"
"18024","(۱۸۰۲۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : سَمِعْتُ مُجَاہِدًا یُحَدِّثُ عَنِ ابْنِ عَبَّاسٍ ؛ فِی ہَذَا الْحَرْفِ : {یَا أَیُّہَا النَّبِیُّ إذَا طَلَّقْتُمُ النِّسَائَ فَطَلِّقُوہُنَّ لِعِدَّتِہِنَّ} قَالَ : فِی قُبُلِ عِدَّتِہِنَّ۔",": Sahih","Musannaf Ibn Abi Shaybah 18024","","","كتاب الجنة"
"18025","(۱۸۰۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ ، عَنِ ابْنِ سِیرِینَ قَالَ : قَالَ رَجُلٌ ، یَعْنِی عَلِیًّا ، لَوْ أَنَّ النَّاسَ أَصَابُوا حَدَّ الطَّلاَقِ مَا نَدِمَ رَجُلٌ عَلَی امْرَأَۃٍ ، یُطَلِّقُہَا وَہِیَ حَامِلٌ قَدْ تَبَیَّنَ حَمْلُہَا ، أَوْ طَاہِرٌ لَمْ یُجَامِعْہَا مُنْذُ طَہُرَت ، یَنْتَظِرُ حَتَّی إذَا کَانَ فِی قُبُلِ عِدَّتِہَا طَلَّقَہَا ، فَإِنْ بَدَا لَہُ أَنْ یُرَاجِعَہَا رَاجَعَہَا ، وَإِنْ بَدَا لَہُ أَنْ یُخَلِّیَ سَبِیلَہَا خَلَّی سَبِیلَہَا۔","","Musannaf Ibn Abi Shaybah 18025","","","كتاب الجنة"
"18026","(۱۸۰۲۶) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ أَنَّہُمَا قَالاَ : طَلاَقُ السُّنَّۃِ فِی قُبُلِ الْعِدَّۃِ ، یُطَلِّقُہَا طَاہِرًا فِی غَیْرِ جِمَاعٍ ، وَإِنْ کَانَ بِہَا حَمْلٌ طَلَّقَہَا مَتَی شَائَ۔","","Musannaf Ibn Abi Shaybah 18026","","","كتاب الجنة"
"18027","(۱۸۰۲۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : طَلَّقْتُ امْرَأَتِی وَہِیَ حَائِضٌ ، فَذَکَرَ ذَلِکَ عُمَرُ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : مُرْہُ فَلْیُرَاجِعْہَا حَتَّی تَطْہُرَ ، ثُمَّ تَحِیضَ ، ثُمَّ تَطْہُرَ ، ثُمَّ إِنْ شَائَ طَلَّقَہَا قَبْلَ أَنْ یُجَامِعَہَا ، وَإِنْ شَائَ أَمْسَکَہَا ، فَإِنَّہَا الْعِدَّۃُ الَّتِی قَالَ اللَّہُ۔\n(مسلم ۱۰۹۴۔ مالک ۵۳)",": Sahih","Musannaf Ibn Abi Shaybah 18027","","","كتاب الجنة"
"18028","(۱۸۰۲۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ قَالَ : طَلَّقَ ابْنُ عُمَرَ امْرَأَتَہُ وَہِیَ حَائِضٌ ، فَأَتَی عُمَرُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرَہُ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مُرْہُ فَلْیُرَاجِعْہَا ، ثُمَّ لِیُطَلِّقْہَا طَاہِرًا فِی غَیْرِ جِمَاعٍ۔","","Musannaf Ibn Abi Shaybah 18028","","","كتاب الجنة"
"18029","(۱۸۰۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، مَوْلَی آلِ طَلْحَۃَ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ طَلَّقَ امْرَأَتَہُ وَہِیَ حَائِضٌ ، فَذَکَرَ ذَلِکَ عُمَرُ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : مُرْہُ فَلْیُرَاجِعْہَا ثُمَّ لِیُطَلِّقْہَا طَاہِرًا ، أَوْ حَامِلاً۔ (مسلم ۵۔ ابوداؤد ۲۱۷۴)",": Sahih","Musannaf Ibn Abi Shaybah 18029","","","كتاب الجنة"
"18030","(۱۸۰۳۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ قَالَ : إذَا طَلَّقَہَا فِی طُہْرٍ قَدْ جَامَعَہَا فِیہِ ، لَمْ تَعْتَدَّ فِیہِ بِتِلْکَ الْحَیْضَۃِ۔","","Musannaf Ibn Abi Shaybah 18030","","","كتاب الجنة"
"18031","(۱۸۰۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ بَیَانٍ ، عَنِ الشَّعْبِیِّ قَالَ : إذَا طَلَّقَہَا وَہِیَ طَاہِرٌ فَقَدْ طَلَّقَہَا لِلسُّنَّۃِ ، وَإِنْ کَانَ قَدْ جَامَعَہَا۔","","Musannaf Ibn Abi Shaybah 18031","","","كتاب الجنة"
"18032","(۱۸۰۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عِکْرِمَۃَ ، وَمُجَاہِدٍ ؛ (فَطَلِّقُوہُنَّ لِعِدَّتِہِنَّ) قَالاَ : طَاہِرًا فِی غَیْرِ جِمَاعٍ۔","","Musannaf Ibn Abi Shaybah 18032","","","كتاب الجنة"
"18033","(۱۸۰۳۳) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدِ ، عَنْ مُحَمَّدٍ ؛ (فَطَلِّقُوہُنَّ لِعِدَّتِہِنَّ) قَالَ : طَاہِرًا ، أَوْ حَامِلاً۔","","Musannaf Ibn Abi Shaybah 18033","","","كتاب الجنة"
"18034","(۱۸۰۳۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبِیدَۃَ ، عَنْ عَلِیٍّ قَالَ : مَا طَلَّقَ رَجُلٌ طَلاَقَ السُّنَّۃِ فَنَدِمَ۔",": Sahih","Musannaf Ibn Abi Shaybah 18034","","","كتاب الجنة"
"18035","(۱۸۰۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ ، عَنْ عَبْدِ اللہِ قَالَ : طَلاَقُ السُّنَّۃِ فِی قُبُلِ الطُّہْرِ مِنْ غَیْرِ جِمَاعٍ","","Musannaf Ibn Abi Shaybah 18035","","","كتاب الجنة"
"18036","(۱۸۰۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ قَالَ : مَنْ أَرَادَ الطَّلاَقَ الَّذِی ہُوَ الطَّلاَقُ فَلْیُطَلِّقْہَا تَطْلِیقَۃً ، ثُمَّ یَدَعَہَا حَتَّی تَحِیضَ ثَلاَثَ حِیَضٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 18036","","","كتاب الجنة"
