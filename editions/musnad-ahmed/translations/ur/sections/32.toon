hadiths[2195]{hadithnumber,text}:
"11963","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مدینہ منورہ کی ایک عام باندی بھی نبی ﷽ کا دست مبارک پکڑ کر اپنے کام کاج کے لئے نبی ﷽ کو لے جایا کرتی تھی ۔"
"11964","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص میری طرف جان بوجھ کر کسی جھوٹی بات کی نسبت کرے ، اسے اپنا ٹھکانہ جہنم میں بنا لینا چاہئے ۔"
"11965","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت زینب بنت جحش رضی اللہ عنہما سے نکاح کے بعد ولیمہ کیا اور ہمیں روٹی اور گوشت کھلایا ۔"
"11966","حضرت انس رضی اللہ عنہ سے مرفوعاَ مروی ہے کہ قیامت اس وقت تک قائم نہیں ہو گی جب تک علم اٹھا نہ لیا جائے ، اس وقت جہالت کا غلبہ ہو گا ، مردوں کی تعداد کم ہو جائے گی اور عورتوں کی تعداد بڑھ جائے گی حتیٰ کہ پچاس عورتوں کا ذمہ دار صرف ایک آدمی ہو گا ۔"
"11967","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے ایک یمنی چادر میں نماز پڑھی اور غالباَ اس کے دونوں پلواں میں گرہ لگا لی تھی ۔"
"11968","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کبھی کبھار اپنی تمام ازواج مطہرات کے پاس ایک ہی رات میں ایک ہی غسل سے چلے جایا کرتے تھے ۔"
"11969","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب بیت الخلاء میں داخل ہوتے تو یہ دعاء پڑھتے کہ اے اللہ ! میں خبیث جنات مردوں اور عورتوں سے آپ کی پناہ میں آتا ہوں ۔"
"11970","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب اہل کتاب تمہیں سلام کیا کریں تو تم صرف """" وعلیکم """" کہہ دیا کرو ۔"
"11971","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اپنے بھائی کی مدد کیا کرو ، خواہ وہ ظالم ہو یا مظلوم ، کسی نے پوچھا یا رسول اللہ ﷽ ! مظلوم کی مدد کرنا تو سمجھ میں آتا ہے ، ظالم کی کیسے مدد کریں آ فرمایا اسے ظلم کرنے سے روکو ، یہی اس کی مدد ہے ۔"
"11972","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا سحری کھایا کرو ، کیوں کہ سحری میں برکت ہوتی ہے ۔"
"11973","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کی چاندی کی انگوٹھی دیکھی ہے ۔"
"11974","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے جب حضرت صفیہ رضی اللہ عنہا سے نکاح کیا تو ان کے یہاں تین راتیں قیام فرمایا ، وہ پہلے سے شوہر دیدہ تھیں ۔"
"11975","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نبی ﷽ کی ازواج مطہرات میں سے دو کے ولیمے میں شریک ہوا ہوں ، نبی ﷽ نے ہمیں اس میں روٹی کھلائی اور نہ ہی گوشت ، راوی نے پوچھا کہ پھر کیا کھلایا آ فرمایا کھجور اور پنیر کا گھی میں بنا ہوا حلوہ ۔"
"11976","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا مشرکین کی آگ سے روشنی حاصل نہ کیا کرو اور اپنی انگوٹھیوں میں """" عربی """" نقش نہ کروایا کرو ۔"
"11977","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا میں جنت میں داخل ہوا تو اپنے آگے کسی کی آہٹ سنی ، دیکھا تو وہ غمیصاء بنت ملحان تھیں جو کہ حضرت انس رضی اللہ عنہ کی والدہ تھیں ۔"
"11978","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ احد کے دن نبی ﷽ کے اگلے چار دانت ٹوٹ گئے تھے اور آپ ﷽ کی پیشانی پر بھی زخم آیا تھا ، حتیٰ کہ اس کا خون آپ ﷽ کے چہرہ مبارک پر بہنے لگا ، اس پر نبی ﷽ نے فرمایا وہ قوم کیسے فلاح پائے گی جو اپنے نبی کے ساتھ یہ سلوک کرے جب کہ وہ انہیں ان کے رب کی طرف بلا رہا ہو آ اس پر یہ آیت نازل ہوئی کہ """" آپ کو کسی قسم کا کوئی اختیار نہیں ہے کہ اللہ ان پر متوجہ ہو جائے ، یا انہیں سزا دے کہ وہ ظالم ہیں ۔"""""
"11979","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت صفیہ رضی اللہ عنہا بنت حیی کو آزاد کر دیا اور ان کی آزادی ہی کو ان کا مہر قرار دے دیا ۔"
"11980","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو حج و عمرہ کا تلبیہ اکٹھے پڑھتے ہوئے سنا ہے کہ آپ ﷽ یوں فرما رہے تھے """" ®لبیک عمرۃ و حجا¾ """""
"11981","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کا گذر ایک آدمی پر ہوا جو قربانی کا جانور ہانکتے ہوئے چلا جا رہا تھا ، نبی ﷽ نے اس سے سوار ہونے کے لئے فرمایا ، اس نے کہا کہ یہ قربانی کا جانور ہے ، نبی ﷽ نے دو تین مرتبہ اس سے فرمایا کہ سوار ہو جاا ۔"
"11982","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دو چتکبرے سینگ دار مینڈھے قربانی میں پیش کیا کرتے تھے ، اور اللہ کا نام لے کر تکبیر کہتے تھے ، میں نے دیکھا ہے کہ نبی ﷽ انہیں اپنے ہاتھ سے ذبح کرتے تھے اور ان کے پہلو پر اپنا پااں رکھتے تھے ۔"
"11983","بکر بن عبداللہ مزنی رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ کو یہ حدیث بیان کرتے ہوئے سنا کہ میں نے نبی ﷽ کو حج اور عمرہ کا تلبیہ اکٹھے پڑھتے ہوئے سنا ہے ، تو میں نے یہ حدیث حضرت ابن عمر رضی اللہ عنہ سے بیان کی ، وہ کہنے لگے کہ نبی ﷽ نے تو صرف حج کا تلبیہ پڑھا تھا ، جب میری ملاقات حضرت انس رضی اللہ عنہ سے ہوئی تو میں نے انہیں حضرت ابن عمر رضی اللہ عنہ کی بات بتائی ، وہ کہنے لگے کہ تم لوگ ہمیں بچہ سمجھتے ہو آ میں نے خود نبی ﷽ کو """" ®لبیک عمرۃ وحجا¾ """" کہتے ہوئے سنا ہے ۔"
"11984","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کی مجلس میں دو آدمیوں کو چھینک آئی ، نبی ﷽ نے ان میں سے ایک کو اس کا جواب + یرحمک اللہ کہہ کر , دے دیا اور دوسرے کو چھوڑ دیا ، کسی نے پوچھا کہ دو آدمیوں کو چھینک آئی ، آپ نے ان میں سے ایک کو جواب دیا ، دوسرے کو کیوں نہ دیا آ فرمایا کہ اس نے الحمدوللہ کہا تھا ۔"
"11985","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اس بات کو پسند فرماتے تھے کہ نماز میں مہاجرین اور انصار مل کر کھڑے ہوں ۔"
"11986","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب تم میں سے کسی کے ہاتھ سے لقمہ گر جائے تو وہ اس پر لگنے والی چیز کو ہٹا دے اور اسے شیطان کے لئے نہ چھوڑے ۔"
"11987","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی مبارک ڈاڑھی میں بیس بال بھی سفید نہ تھے ، حضرت ابوبکر صدیق رضی اللہ عنہ مہندی اور وسمہ کا خضاب لگاتے تھے جبکہ حضرت عمر رضی اللہ عنہ صرف مہندی کا خضاب لگاتے تھے ۔"
"11988","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ابوطیبہ نے نبی ﷽ کی سینگی لگائی ، نبی ﷽ نے اسے ایک صاع گندم دی اور اس کے مالک سے بات کی تو انہوں نے اس پر تخفیف کر دی ۔"
"11989","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ لوگوں میں سب سے زیادہ نماز کو مکمل اور مختصر کرنے والے تھے ۔"
"11990","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے بولی لگا کر ایک پیالہ اور ایک ٹاٹ بیچا تھا ۔"
"11991","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"11992","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم لوگ سخت گرمی میں بھی نبی ﷽ کے ساتھ نماز پڑھا کرتے تھے ، اگر ہم میں سے کسی میں زمین پر اپنا چہرہ رکھنے کی ہمت نہ ہوتی تو وہ اپنا کپڑا بچھا کر اس پر سجدہ کر لیتا تھا ۔"
"11993","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب رات کا کھانا سامنے آ جائے اور نماز کھڑی ہو جائے تو پہلے کھانا کھا لو ۔"
"11994","اور نبی ﷽ نے فرمایا جب تم میں سے کسی کو نماز پڑھتے ہوئے اونگھ آنے لگے تو اسے چاہئے کہ واپس جا کر سو جائے ۔"
"11995","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جو شخص نماز پڑھنا بھول جائے یا سو جائے ، تو اس کا کفارہ یہی ہے کہ جب یاد آئے ، اسے پڑھ لے ۔"
"11996","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اللہ تعالیٰ بندے سے صرف اتنی بات پر بھی راضی ہو جاتے ہیں کہ وہ کوئی لقمہ کھا کر یا پانی کا گھونٹ پی کر اللہ کا شکر ادا کر دے ۔"
"11997","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کی خدمت نو سال تک کی ہے ، مجھے یاد نہیں کہ نبی ﷽ نے کبھی مجھ سے یہ فرمایا ہو کہ تم نے فلاں کام کیوں نہیں کیا آ اور نہ ہی آپ ﷽ نے کبھی مجھ میں کوئی عیب نکالا ۔"
"11998","عبدالعزیز بن رفیع رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ نبی ﷽ کے حوالے سے اگر آپ کو یہ بات معلوم ہو کہ آپ ﷽ نے آٹھ ذی الحجہ کے دن ظہر کی نماز کہاں پڑھی تھی تو مجھے بتا دیجئے آ انہوں نے فرمایا منیٰ میں ، میں نے پوچھا کہ کوچ کے دن عصر کی نماز کہاں پڑھی تھی آ فرمایا مقام ابطح میں ، پھر فرمایا کہ تم اسی طرح کرو جیسے تمہارے امراء کرتے ہیں ۔"
"11999","سعید بن یزید رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ کیا نبی ﷽ اپنے جوتوں میں نماز پڑھ لیتے تھے آ انہوں نے فرمایا جی ہاں !"
"12000","حضرت انس رضی اللہ عنہ فرمایا کرتے تھے کہ نبی ﷽ کے دور باسعادت میں ہم جو کچھ کرتے تھے ، آج مجھے ان میں سے کچھ بھی نظر نہیں آتا ، لوگوں نے کہا کہ نماز کہاں گئی آ + ہم نماز تو پڑھتے ہیں , فرمایا کہ یہ تم بھی جانتے ہو کہ تم نماز میں کیا کرتے ہو ۔"
"12001","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے مرد کو زعفران کی خوشبو لگانے سے منع فرمایا ہے ۔"
"12002","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا تم میں سے کوئی شخص اپنے اوپر آنے والی کسی تکلیف کی وجہ سے موت کی تمنا نہ کرے ، اگر موت کی تمنا کرنا ہی ضروری ہو تو اسے یوں کہنا چاہئے کہ اے اللہ ! جب تک میرے لیے زندگی میں کوئی خیر ہے ، مجھے اس وقت تک زندہ رکھ ، اور جب میرے لیے موت میں بہتری ہو تو مجھے موت عطاء فرما دینا ۔"
"12003","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب تم میں سے کوئی شخص دعا کرے تو یقین اور پختگی کے ساتھ دعاء کرے اور یہ نہ کہے کہ اے اللہ ! اگر آپ چاہیں تو مجھے یہ عطاء فرما دیں ، کیونکہ اللہ تعالیٰ پر کوئی زبردستی کرنے والا نہیں ہے ۔"
"12004","ایک مرتبہ قتادہ نے حضرت انس رضی اللہ عنہ سے پوچھا کہ نبی ﷽ کثرت کے ساتھ کون سی دعاء مانگتے تھے آ انہوں نے فرمایا کہ نبی ﷽ اکثر یہ دعاء مانگا کرتے تھے اے اللہ ! اے ہمارے رب ! ہمیں دنیا میں بھی بھلائی عطاء فرما اور آخرت میں بھی بھلائی عطاء فرما ، اور ہمیں عذاب جہنم سے محفوظ فرما ، خود حضرت انس رضی اللہ عنہ بھی یہی دعاء مانگا کرتے تھے ۔"
"12005","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت معاذ بن جبل رضی اللہ عنہ اپنی قوم کی امامت فرماتے تھے ، ایک مرتبہ وہ نماز پڑھا رہے تھے کہ حضرت حرام رضی اللہ عنہ """" جو اپنے باغ کو پانی لگانے جا رہے تھے """" نماز پڑھنے کے لئے مسجد میں داخل ہوئے ، جب انہوں نے دیکھا کہ حضرت معاذ رضی اللہ عنہ تو نماز لمبی کر رہے ہیں تو وہ اپنی نماز مختصر کر کے اپنے باغ کو پانی لگانے کے لئے چلے گئے ، ادھر حضرت معاذ رضی اللہ عنہ نے نماز مکمل کی تو انہیں کسی نے بتایا کہ حضرت حرام رضی اللہ عنہ مسجد میں آئے تھے ۔ فائدہ = یہ مکمل حدیث عنقریب آ رہی ہے ، ملاحظہ کیجئے حدیث نمبر 455:5 ۔"
"12006","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب بیت الخلاء میں داخل ہوتے تو یہ دعاء پڑھتے کہ اے اللہ ! میں خبیث جنات مردوں اور عورتوں سے آپ کی پناہ میں آتا ہوں ۔"
"12007","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دو مینڈھے قربانی میں پیش کیا کرتے تھے ، اور میں بھی یہی کرتا ہوں ۔"
"12008","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا جو شخص دنیا میں ریشم پہنتا ہے ، وہ آخرت میں اسے ہرگز نہیں پہن سکے گا ۔"
"12009","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ ایک مرتبہ مسجد میں داخل ہوئے تو دیکھا کہ دو ستونوں کے درمیان ایک رسی لٹک رہی ہے ، پوچھا یہ کیسی رسی ہے آ لوگوں نے بتایا کہ یہ زینب کی رسی ہے ، نماز پڑھتے ہوئے جب انہیں سستی یا تھکاوٹ محسوس ہوتی ہے تو وہ اس کے ساتھ اپنے آپ کو باندھ لیتی ہیں ، نبی ﷽ نے فرمایا اسے کھول دو ، پھر فرمایا جب تم میں سے کوئی شخص نماز پڑھے تو نشاط کی کیفیت برقرار رہنے تک پڑھے اور جب سستی یا تھکاوٹ محسوس ہو تو رک جائے ۔"
"12010","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کا وقت ہو گیا ، نبی ﷽ ایک آدمی کے ساتھ مسجد میں تنہائی میں گفتگو فرما رہے تھے ، جس وقت آپ ﷽ نماز کے لئے اٹھے تو لوگ سو چکے تھے ۔"
"12011","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب نبی ﷽ مدینہ منورہ تشریف لائے تو حضرت ابوطلحہ رضی اللہ عنہ میرا ہاتھ پکڑ کر مجھے نبی ﷽ کے پاس لے گئے اور عرض کیا یا رسول اللہ ﷽ ! انس سمجھدار لڑکا ہے ، یہ آپ کی خدمت کیا کرے گا ، چنانچہ میں نے سفر و حضر میں نبی ﷽ کی خدمت کا شرف حاصل کیا ہے ، بخدا ! میں نے اگر کوئی کام کیا تو نبی ﷽ نے مجھ سے کبھی یہ نہیں فرمایا کہ تم نے یہ کام اس طرح کیوں کیا آ اور اگر کوئی کام نہیں کیا تو کبھی یہ نہیں فرمایا کہ یہ کام تم نے کیوں نہیں کیا آ"
"12012","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے اپنے لیے ایک انگوٹھی بنوائی اور فرمایا کہ ہم نے ایک انگوٹھی بنوائی ہے اور اس پر ایک عبارت + محمد رسول اللہ , نقش کروائی ہے ، لہٰذا کوئی شخص اپنی انگوٹھی پر یہ عبارت نقش نہ کروائے ۔"
"12013","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نماز کو مکمل اور مختصر کرتے تھے ۔"
"12014","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور خلفاء ثلاثہ رضی اللہ عنہم نماز میں قراءت کا آغاز """" ®الحمدللہ رب العلمین¾ """" سے کرتے تھے ۔"
"12015","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ غزوہ خیبر کے لئے تشریف لے گئے ، ہم نے خیبر میں فجر کی نماز منہ اندھیرے پڑھی ، نماز کے بعد نبی ﷽ اپنی سواری پر سوار ہوئے اور حضرت ابوطلحہ رضی اللہ عنہ اپنی سواری پر ، میں حضرت ابوطلحہ رضی اللہ عنہ کے پیچھے بیٹھ گیا ، نبی ﷽ خیبر کی گلیوں میں چکر لگانے لگے ، بعض اوقات میرا گھٹنا نبی ﷽ کی ران مبارک سے چھو جاتا تھا ، اور بعض اوقات نبی ﷽ کی ران مبارک سے ذرا سا تہبند کھسک جاتا تو مجھے نبی ﷽ کے جسم کی سفیدی نظر آ جاتی ۔ الغرض ! جب نبی ﷽ شہر میں داخل ہوئے ، تو اللہ اکبر کہہ کر فرمایا خیبر برباد ہو گیا ، جب ہم کسی قوم کے صحن میں اترتے ہیں تو ڈرائے ہوئے لوگوں کی صبح بڑی بدترین ہوتی ہے ، یہ جملے آپ ﷽ نے تین مرتبہ دہرائے ، لوگ اس وقت کام پر نکلے ہوئے تھے ، وہ کہنے لگے کہ محمد اور لشکر آ گئے ، پھر ہم نے خیبر کو بزور شمشیر فتح کر لیا ، اور قیدی اکٹھے کیے جانے لگے ، اسی اثناء میں حضرت دحیہ رضی اللہ عنہ آئے اور کہنے لگے کہ اے اللہ کے نبی ! مجھے قیدیوں میں سے کوئی باندی عطاء فرما دیجئے ، نبی ﷽ نے فرمایا کہ جا کر ایک باندی لے لو ، چنانچہ انہوں نے حضرت صفیہ بنت حیی کو لے لیا ۔ یہ دیکھ کر ایک آدمی نبی ﷽ کے پاس آیا اور کہنے لگا یا رسول اللہ ﷽ ! آپ نے بنو قریظہ اور بنو نضیر کی سردار صفیہ کو دحیہ کے حوالے کر دیا ، بخدا ! وہ تو صرف آپ ہی کے لائق ہیں ، نبی ﷽ نے فرمایا کہ دحیہ کو صفیہ کے ساتھ بلاا ، چنانچہ وہ انہیں لے کر آ گئے ، نبی ﷽ نے حضرت صفیہ رضی اللہ عنہا پر ایک نظر ڈالی اور حضرت دحیہ رضی اللہ عنہ سے فرمایا کہ آپ قیدیوں میں سے کوئی اور باندی لے لو ، پھر نبی ﷽ نے انہیں آزاد کر کے ان سے نکاح کر لیا ۔ راوی نے حضرت انس رضی اللہ عنہ سے پوچھا اے ابوحمزہ ! نبی ﷽ نے انہیں کتنا مہر دیا تھا آ انہوں نے فرمایا کہ نبی ﷽ نے ان کی آزادی ہی کو ان کا مہر قرار دے کر ان سے نکاح کیا تھا ، حتیٰ کہ راستے میں حضرت ام سلیم رضی اللہ عنہا نے حضرت صفیہ رضی اللہ عنہا کو دلہن بنا کر تیار کیا اور رات کو نبی ﷽ کے سامنے پیش کیا ، نبی ﷽ کی وہ صبح دولہا ہونے کی حالت میں ہوئی ، پھر نبی ﷽ نے فرمایا جس کے پاس جو کچھ ہے وہ ہمارے پاس لے آئے ، اور ایک دسترخوان بچھا دیا ، چنانچہ کوئی پنیر لایا ، کوئی کھجور لایا اور کوئی گھی لایا ، لوگوں نے اس کا حلوہ بنا لیا ، یہی نبی ﷽ کا ولیمہ تھا ۔"
"12016","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی زرہ گروی کے طور پر رکھی ہوئی تھی ، اتنے پیسے بھی نہ تھے کہ اسے چھڑوا سکتے ، حتیٰ کہ اسی حال میں آپ ﷽ دنیا سے رخصت ہو گئے ۔"
"12017","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا """" کوثر """" جنت کی ایک نہر ہے جس کا مجھ سے میرے رب نے وعدہ کیا ہے ۔"
"12018","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اللہ تعالیٰ نے مجھ سے فرمایا ہے آپ کی امت کے لوگ آپس میں ایک دوسرے سے سوال کریں گے ، حتیٰ کہ یہ بھی کہنے لگیں گے کہ یہ تو اللہ نے لوگوں کو پیدا کیا ہے ، پھر اللہ کو کس نے پیدا کیا ہے آ"
"12019","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ پر بیٹھے بیٹھے اونگھ کی کیفیت طاری ہوئی ، پھر آپ ﷽ نے مسکراتے ہوئے سر اٹھایا ، لوگوں نے مسکرانے کی وجہ پوچھی تو فرمایا کہ مجھ پر ابھی ابھی ایک سورت نازل ہوئی ہے ، پھر آپ ﷽ نے """" بسم اللہ """" پڑھ کر پوری سورہ کوثر پڑھ کر سنائی اور فرمایا کہ تم جانتے ہو کوثر کیا چیز ہے آ صحابہ رضی اللہ عنہم نے عرض کیا کہ اللہ اور اس کے رسول ہی زیادہ جانتے ہیں ، فرمایا یہ جنت کی ایک نہر ہے جس کا مجھ سے میرے رب نے وعدہ کر رکھا ہے ، اس پر خیر کثیر ہو گی ، اور قیامت کے دن میرے امتی وہاں آئیں گے ، اور اس نہر کے برتن ستاروں کی تعداد کے برابر ہوں گے ، ان میں سے ایک بندے کو کھینچ کر نکالا جائے گا تو میں کہوں گا کہ پروردگار ! یہ تو میرا امتی ہے ، مجھ سے کہا جائے گا کہ آپ نہیں جانتے کہ انہوں نے آپ کے پیچھے کیا کیا بدعات ایجاد کر لی تھیں ۔"
"12020","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نبی ﷽ نماز سے فارغ ہو کر ہماری طرف متوجہ ہوئے اور فرمایا لوگو ! میں تمہارا امام ہوں ، لہٰذا رکوع ، سجدہ ، قیام ، قعود اور اختتام میں مجھ سے آگے نہ بڑھا کرو ، کیونکہ میں تمہیں اپنے آگے سے بھی دیکھتا ہوں اور پیچھے سے بھی ، اور اس ذات کی قسم جس کے دست قدرت میں میری جان ہے ، جو میں دیکھ چکا ہوں اگر تم نے وہ دیکھا ہوتا تو تم بہت تھوڑا ہنستے اور کثرت سے رویا کرتے ، صحابہ رضی اللہ عنہم نے پوچھا یا رسول اللہ ﷽ ! آپ نے کیا دیکھا ہے آ فرمایا میں نے اپنی آنکھوں سے جنت اور جہنم کو دیکھا ہے ۔"
"12021","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جو شخص مجھ پر ایک مرتبہ درود پڑھے گا ، اللہ اس پر دس رحمتیں نازل فرمائے گا اور اس کے دس گناہ معاف فرمائے گا ۔"
"12022","علاء ابن عبدالرحمن رحمۃ اللہ کہتے ہیں کہ ایک دفعہ میں ایک انصاری آدمی کے ساتھ ظہر کی نماز پڑھ کر حضرت انس رضی اللہ عنہ کی خدمت میں حاضر ہوا ، کچھ ہی دیر بعد انہوں نے باندی سے وضو کا پانی منگوایا ، ہم نے ان سے پوچھا کہ اس وقت کون سی نماز پڑھ رہے ہیں آ انہوں نے فرمایا نماز عصر ، ہم نے کہا کہ ہم تو ابھی ظہر کی نماز پڑھ کر آئے ہیں + عصر کی نماز اتنی جلدی آ , انہوں نے فرمایا کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے وہ منافق کی نماز ہے کہ منافق نماز کو چھوڑے رکھتا ہے ، حتیٰ کہ جب سورج شیطان کے دو سینگوں کے درمیان آ جاتا ہے تو وہ نماز پڑھنے کھڑا ہوتا ہے اور اس میں اللہ کو بہت تھوڑا یاد کرتا ہے ۔"
"12023","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ حضرت ام سلیم رضی اللہ عنہا کے یہاں تشریف لے جایا کرتے تھے ، وہ ان کے لئے چٹائی بچھاتیں اور نبی ﷽ اس پر قیلولہ فرماتے ، وہ نبی ﷽ کا پسینہ لے کر اپنی خوشبو میں شامل کر لیتیں اور نبی ﷽ کے لئے جائے نماز بچھا دیتیں ، جس پر آپ ﷽ نماز پڑھتے تھے ۔"
"12024","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ حضرت بلال رضی اللہ عنہ کو یہ حکم تھا کہ اذان کے کلمات جفت عدد میں اور اقامت کے کلمات طاق عدد میں کہا کریں ۔"
"12025","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا تین چیزیں جس شخص میں بھی ہوں گی ، وہ ایمان کی حلاوت محسوس کرے گا ، ایک تو یہ کہ اسے اللہ اور اس کے رسول دوسروں سے سب سے زیادہ محبوب ہوں ، دوسرا یہ کہ انسان کسی سے محبت کرے تو صرف اللہ کی رضاء کے لئے ، کہ اور تیسرا یہ کہ انسان کفر سے نجات ملنے کے بعد اس میں واپس جانے کو اسی طرح ناپسند کرے جیسے آگ میں چھلانگ لگانے کو ناپسند کرتا ہے ۔"
"12026","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جنت میں داخل ہونے والا کوئی شخص بھی جنت سے نکلنا کبھی پسند نہیں کرے گا سوائے شہید کے کہ جس کی خواہش یہ ہو گی کہ وہ جنت سے نکلے اور پھر اللہ کی راہ میں شہید ہو ، کیونکہ اسے اس کی عزت نظر آ رہی ہو گی ۔"
"12027","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضور نبی مکرم ﷽ نے ارشاد فرمایا دنیا میں جو نبی بھی مبعوث ہو کر آئے ، انہوں نے اپنی امت کو کانے کذاب سے ضرور ڈرایا ، یاد رکھو ! دجال کانا ہو گا اور تمہارا رب کانا نہیں ہے ، اور اس کی دونوں آنکھوں کے درمیان کافر لکھا ہو گا ۔"
"12028","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ ایک مرتبہ رات کے وقت اپنے حجرے میں نماز پڑھ رہے تھے ، کچھ لوگ آئے اور وہ نبی ﷽ کی نماز میں شریک ہو گئے ، نبی ﷽ نماز مختصر کر کے اپنے گھر میں تشریف لے گئے ، ایسا کئی مرتبہ ہوا حتیٰ کہ صبح ہو گئی ، تب لوگوں نے عرض کیا یا رسول اللہ ﷽ ! آپ نماز پڑھ رہے تھے ، ہماری خواہش تھی کہ آپ اسے لمبا کر دیتے ، نبی ﷽ نے فرمایا مجھے تمہاری موجودگی کا علم تھا لیکن میں نے جان بوجھ کر ہی ایسا کیا تھا ۔"
"12029","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب مدینہ منورہ تشریف لائے تو پتہ چلا کہ دو دن ایسے ہیں جن میں لوگ زمانہ جاہلیت سے جشن مناتے آ رہے ہیں ، نبی ﷽ نے فرمایا اللہ نے ان دو دونوں کے بدلے میں تمہیں اس سے بہتر دن یوم الفطر اور یوم الاضحی عطاء فرمائے ہیں ۔"
"12030","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ مدینہ منورہ میں بنو نجار کے کسی باغ میں تشریف لے گئے ، وہاں کسی قبر سے آواز سنائی دی ، نبی ﷽ نے اس کے متعلق دریافت فرمایا کہ اس قبر میں مردے کو کب دفن کیا گیا تھا لوگوں نے بتایا کہ یا رسول اللہ ﷽ ! یہ شخص زمانہ جاہلیت میں دفن ہوا تھا ، نبی ﷽ کو اس پر تعجب ہوا اور فرمایا اگر تم لوگ اپنے مردوں کو دفن کرنا چھوڑ نہ دیتے تو میں اللہ سے یہ دعاء کرتا کہ وہ تمہیں بھی عذاب قبر کی آواز سنا دے ۔"
"12031","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا میں جنت میں داخل ہوا تو اچانک ایک نہر پر نظر پڑی ، جس کے دونوں کناروں پر موتیوں کے خیمے لگے ہوئے تھے ، میں نے اس میں ہاتھ ڈال کر پانی میں بہنے والی چیز کو پکڑا تو وہ مہکتی ہوئی مشک تھی ، میں نے جبریل علیہ السلام سے پوچھا کہ یہ کیا ہے آ تو انہوں نے بتایا کہ یہ نہر کوثر ہے جو اللہ نے آپ کو عطاء فرمائی ہے ۔"
"12032","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب غزوہ تبوک سے واپسی پر مدینہ منورہ کے قریب پہنچے تو فرمایا کہ مدینہ منورہ میں کچھ لوگ ایسے بھی ہیں کہ تم جس راستے پر بھی چلے اور جس وادی کو بھی طے کیا ، وہ اس میں تمہارے ساتھ رہے ، صحابہ رضی اللہ عنہم نے عرض کیا یا رسول اللہ ﷽ ! کیا وہ مدینہ میں ہونے کے باوجود ہمارے ساتھ تھے آ فرمایا ہاں ! مدینہ میں ہونے کے باوجود ، کیونکہ انہیں کسی عذر نے روک رکھا ہے ۔"
"12033","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی ایک اونٹنی """" جس کا نام عضباء تھا """" کبھی کسی سے پیچھے نہیں رہی تھی ، ایک مرتبہ ایک دیہاتی اپنی اونٹنی پر آیا اور وہ اس سے آگے نکل گیا ، مسلمانوں پر یہ بات بڑی گراں گزری ، نبی ﷽ نے ان کے چہروں کا اندازہ لگا لیا ، پھر لوگوں نے خود بھی کہا کہ یا رسول اللہ ﷽ ! عضباء پیچھے رہ گئی ، نبی ﷽ نے فرمایا اللہ پر حق ہے کہ دنیا میں جس چیز کو وہ بلندی دیتا ہے پست بھی کرتا ہے ۔"
"12034","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نماز کھڑی ہوئی تو نبی ﷽ ہماری طرف متوجہ ہوئے اور فرمایا صفیں سیدھی کر لو اور جڑ کر کھڑے ہو کیونکہ میں تمہیں اپنے پیچھے سے بھی دیکھتا ہوں ۔"
"12035","حمید کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے نبی ﷽ کی رات کی نماز کے متعلق پوچھا تو انہوں نے فرمایا کہ ہم رات کے جس وقت نبی ﷽ کو نماز پڑھتے ہوئے دیکھنا چاہتے تھے ، دیکھ سکتے تھے اور جس وقت سوتا ہوا دیکھنے کا ارادہ ہوتا تو وہ بھی دیکھ لیتے تھے ، اسی طرح نبی ﷽ کسی مہینے میں اس تسلسل کے ساتھ روزے رکھتے کہ ہم یہ سوچنے لگتے کہ اب نبی ﷽ کوئی روزہ نہیں چھوڑیں گے اور بعض اوقات روزے چھوڑتے تو ہم کہتے کہ شاید اب نبی ﷽ کوئی روزہ نہیں رکھیں گے ۔"
"12036","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہمیں اس بات سے بڑی خوشی ہوتی تھی کہ کوئی دیہاتی آ کر نبی ﷽ سے سوال کرے ، چنانچہ ایک مرتبہ ایک دیہاتی آیا اور کہنے لگا یا رسول اللہ ﷽ ! قیامت کب قائم ہو گی آ اس وقت اقامت ہو چکی تھی اس لئے نبی ﷽ نماز پڑھانے لگے ، نماز سے فارغ ہو کر فرمایا کہ قیامت کے متعلق سوال کرنے والا آدمی کہاں ہے آ اس نے کہا یا رسول اللہ ﷽ ! میں یہاں ہوں ، نبی ﷽ نے فرمایا تم نے قیامت کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کہ میں نے کوئی بہت زیادہ اعمال ، نماز ، روزہ تو مہیا نہیں کر رکھے ، البتہ اتنی بات ضرور ہے کہ میں اللہ اور اس کے رسول سے محبت کرتا ہوں ، نبی ﷽ نے فرمایا کہ انسان قیامت کے دن اس شخص کے ساتھ ہو گا جس کے ساتھ وہ محبت کرتا ہے ، حضرت انس رضی اللہ عنہ فرماتے ہیں کہ میں نے مسلمانوں کو اسلام قبول کرنے کے بعد اس دن جتنا خوش دیکھا ، اس سے پہلے کبھی نہیں دیکھا ۔"
"12037","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کا وقت قریب آ گیا ، اس وقت نبی ﷽ اور ازواج مطہرات کے درمیان کچھ تلخی ہو رہی تھیں ، اور ازواج مطہرات ایک دوسرے کا دفاع کر رہی تھیں ، اسی اثناء میں حضرت ابوبکر صدیق رضی اللہ عنہ تشریف لے آئے اور کہنے لگے یا رسول اللہ ﷽ ! ان کے منہ میں مٹی ڈالیے اور نماز کے لیے باہر چلیے ۔"
"12038","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا تم میں سے کوئی شخص اپنے اوپر آنے والی کسی تکلیف کی وجہ سے موت کی تمنا نہ کرے ، اگر موت کی تمنا کرنا ہی ضروری ہو تو اسے یوں کہنا چاہئے کہ اے اللہ ! جب تک میرے لیے زندگی میں کوئی خیر ہے ، مجھے اس وقت تک زندہ رکھ ، اور جب میرے لیے موت میں بہتری ہو تو مجھے موت عطاء فرما دینا ۔"
"12039","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوطلحہ رضی اللہ عنہ ، نبی ﷽ کے دور باسعادت میں تو کچھ زیادہ نفلی روزے نہ رکھتے تھے ، لیکن نبی ﷽ کے انتقال کے بعد وہ سوائے سفر یا بیماری کے کسی حال میں روزہ نہ چھوڑتے تھے ۔"
"12040","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب مقیم ہوتے تو ماہ رمضان کے عشرہ اخیرہ کا اعتکاف کر لیتے اور مسافر ہوتے تو اگلے سال بیس دنوں کا اعتکاف فرماتے تھے ۔"
"12041","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ اپنے چند صحابہ رضی اللہ عنہم کے ساتھ کہیں جا رہے تھے ، راستے میں ایک بچہ پڑا ہوا تھا ، اس کی ماں نے جب لوگوں کو دیکھا تو اسے خطرہ ہوا کہ کہیں بچہ لوگوں کے پااں میں روندا نہ جائے ، چنانچہ وہ دوڑتی ہوئی """" میرا بیٹا ، میرا بیٹا """" پکارتی ہوئی آئی اور اسے اٹھا لیا ، لوگ کہنے لگے یا رسول اللہ ﷽ ! یہ عورت اپنے بیٹے کو کبھی آگ میں نہیں ڈال سکتی ، نبی ﷽ نے انہیں خاموش کروایا اور فرمایا اللہ بھی اپنے دوست کو آگ میں نہیں ڈالے گا ۔"
"12042","حمید رحمۃ اللہ کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے دریافت کیا کہ کیا نبی ﷽ دعاء میں ہاتھ اٹھاتے تھے آ تو انہوں نے فرمایا کہ ایک مرتبہ جمعہ کے دن نبی ﷽ سے لوگوں نے عرض کیا کہ یا رسول اللہ ﷽ ! بارش رکی ہوئی ہے ، زمینیں خشک پڑی ہیں اور مال تباہ ہو رہیں ہے آ نبی ﷽ نے یہ سن کر اپنے ہاتھ اتنے بلند کیے کہ مجھے آپ ﷽ کی مبارک بغلوں کی سفیدی نظر آنے لگی ، اور نبی ﷽ نے طلب باراں کے حوالے سے دعاء فرمائی ، جس وقت آپ ﷽ نے اپنے دست مبارک بلند کیے تھے ، اس وقت ہمیں آسمان پر کوئی بادل نظر نہیں آ رہا تھا ، اور جب نماز سے فارغ ہوئے تو قریب کے گھر میں رہنے والے نوجوانوں کو اپنے گھر واپس پہنچنے میں دشواری ہو رہی تھی ، جب اگلا جمعہ ہوا تو لوگوں نے عرض کیا یا رسول اللہ ﷽ ! گھروں کی عمارتیں گر گئیں اور سوار مدینہ سے باہر ہی رکنے پر مجبور ہو گئے ، یہ سن کر نبی ﷽ ابن آدم کی اکتاہٹ پر مسکرا پڑے اور اللہ سے دعا کی کہ اے اللہ ! یہ بارش ہمارے اردگرد فرما ، ہم پر نہ برسا ، چنانچہ مدینہ سے بارش چھٹ گئی ۔"
"12043","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ مسلمانوں نے نبی ﷽ کو بدر کے کنوئیں پر یہ آواز لگاتے ہوئے سنا اے ابوجہل بن ہشام ! اے عتبہ بن ربیعہ ! اے شیبہ بن ربیعہ ! اے امیہ بن خلف ! کیا تم سے تمہارے رب نے جو وعدہ کیا تھا ، اسے تم نے سچا پایا آ مجھ سے تو میرے رب نے جو وعدہ کیا تھا ، میں نے اسے سچا پایا ۔ صحابہ رضی اللہ عنہم نے عرض کیا یا رسول اللہ ﷽ ! آپ ان لوگوں کو آواز دے رہے ہیں جو مردہ ہو چکے آ نبی ﷽ نے فرمایا میں جو بات کہہ رہا ہوں ، تم ان سے زیادہ نہیں سن رہے ، البتہ وہ اس کا جواب نہیں دے سکتے ۔"
"12044","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک مرتبہ انصار سے مخاطب ہو کر فرمایا اے گروہ انصار ! کیا ایسا نہیں ہے کہ جب میں تمہارے پاس آیا تو تم بے راہ تھے ، اللہ نے میرے ذریعے تمہیں ہدایت عطاء فرمائی آ کیا ایسا نہیں ہے کہ جب میں تمہارے پاس آیا تو تم آپس میں متفرق تھے ، اللہ نے میرے ذریعے تمہیں اکٹھا کیا آ کیا ایسا نہیں ہے کہ جب میں تمہارے پاس آیا تو تم ایک دوسرے کے دشمن تھے ، اللہ نے میرے ذریعے تمہارے دلوں میں ایک دوسرے کی الفت پیدا کر دی آ انہوں نے عرض کیا کیوں نہیں یا رسول اللہ ﷽ ! نبی ﷽ نے فرمایا تم یہ کیوں نہیں کہتے کہ آپ ہمارے پاس خوف کی حالت میں آئے تھے ، ہم نے آپ کو امن دیا ، آپ کو آپ کی قوم نے نکال دیا تھا ، ہم نے آپ کو ٹھکانہ دیا ، اور آپ بے یارو مددگار ہو چکے تھے ، ہم نے آپ کی مدد کی آ انہوں نے عرض کیا کہ نہیں ہم پر اللہ اور اس کے رسول کا ہی احسان ہے ۔"
"12045","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب بدر کی طرف روانہ ہو گئے تو لوگوں سے مشورہ کیا ، اس کے جواب میں حضرت ابوبکر صدیق رضی اللہ عنہ نے ایک مشورہ دیا ، پھر دوبارہ مشورہ مانگا تو حضرت عمر رضی اللہ عنہ نے ایک مشورہ دے دیا ، یہ دیکھ کر نبی ﷽ خاموش ہو گئے ، ایک انصاری نے کہا کہ نبی ﷽ تم سے مشورہ لینا چاہ رہے ہیں ، اس پر انصاری صحابہ رضی اللہ عنہم کہنے لگے یا رسول اللہ ! بخدا ! ہم اس طرح نہ کہیں گے جیسے بنی اسرائیل نے حضرت موسیٰ علیہ السلام سے کہا تھا کہ تم اور تمہارا رب جا کر لڑو ، ہم یہاں بیٹھے ہیں ، بلکہ اگر آپ اونٹوں کے جگر مارتے ہوئے برک الغماد تک جائیں گے ، تب بھی ہم آپ کے ساتھ ہوں گے ۔"
"12046","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جس پہلی رات نبی ﷽ حضرت زینب بنت جحش رضی اللہ عنہا کے یہاں رہے ، اس کی صبح کو میں نے مسلمانوں کو نبی ﷽ کی طرف سے دعوت ولیمہ دی ، نبی ﷽ نے مسلمانوں کو خوب پیٹ بھر کر روٹی اور گوشت کھلایا ، پھر حسب معمول واپس تشریف لے گئے اور ازواج مطہرات کے گھر میں جا کر انہیں سلام کیا اور انہوں نے نبی ﷽ کے لئے دعائیں کیں ، پھر واپس تشریف لائے ، جب گھر پہنچے تو دیکھا کہ دو آدمیوں کے درمیان گھر کے ایک کونے میں باہم گفتگو جاری ہے ، نبی ﷽ ان دونوں کو دیکھ کر پھر واپس چلے گئے ، جب ان دونوں نے نبی ﷽ کو اپنے گھر سے پلٹتے ہوئے دیکھا تو وہ جلدی سے اٹھ کھڑے ہوئے ، اب مجھے یاد نہیں کہ نبی ﷽ کو ان کے جانے کی خبر میں نے دی یا کسی اور نے ، بہرحال ! نبی ﷽ نے گھر واپس آ کر میرے اور اپنے درمیان پردہ لٹکا لیا اور آیت حجاب نازل ہو گئی ۔"
"12047","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوطلحہ رضی اللہ عنہ ، نبی ﷽ کے آگے کھڑے ہوئے تیر اندازی کر رہے تھے ، بعض اوقات نبی ﷽ تیروں کی بوچھاڑ دیکھنے کے لئے پیچھے سے سر اٹھاتے تو حضرت ابوطلحہ رضی اللہ عنہ سینہ سپر ہو جاتے تاکہ نبی ﷽ کی حفاظت کر سکیں ، اور عرض کیا کرتے یا رسول اللہ ﷽ ! آپ کے سینے کے سامنے میرا سینہ پہلے ہے ۔"
"12048","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا کیا میں تمہیں یہ نہ بتااں کہ انصار کے گھروں میں سب سے بہترین گھر کون سا ہے آ بنو نجار کا گھر ، پھر بنو عبدالاشہل کا ، پھر بنو حارث بن خزرج کا اور پھر بنی ساعدہ کا اور یوں بھی انصار کے ہر گھر میں خیر ہے ۔"
"12049","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا تمہارے پاس ایسی قومیں آئیں گی جن کے دل تم سے بھی زیادہ نرم ہوں گے ، چنانچہ ایک مرتبہ اشعریین آئے ، ان میں حضرت ابوموسی اشعری رضی اللہ عنہ بھی شامل تھے ، جب وہ مدینہ منورہ کے قریب پہنچے تو یہ رجزیہ شعر پڑھنے لگے کہ کل ہم اپنے دوستوں یعنی محمد + ﷽ , اور ان کے ساتھیوں سے ملاقات کریں گے ۔"
"12050","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ اپنی کسی اہلیہ غالباَ حضرت عائشہ رضی اللہ عنہا کے پاس تھے ، دوسری اہلیہ نے نبی ﷽ کے پاس اپنے خادم کے ہاتھ ایک پیالہ بھجوایا جس میں کھانے کی کوئی چیز تھی ، حضرت عائشہ رضی اللہ عنہا نے اس خادم کے ہاتھ پر مارا ، جس سے اس کے ہاتھ سے پیالہ نیچے گر کر ٹوٹ گیا اور دو ٹکڑے ہو گیا ، نبی ﷽ نے یہ دیکھ کر فرمایا کہ تمہاری ماں نے اسے برباد کر دیا ، پھر برتن کے دونوں ٹکڑے لے کر انہیں جوڑا اور ایک دوسرے کے ساتھ ملا کر کھانا اس میں سمیٹا اور فرمایا اسے کھاا ، اور فارغ ہونے تک اس خادم کو روکے رکھا ، اس کے بعد خادم کو دوسرا پیالہ دے دیا اور ٹوٹا ہوا پیالہ اسی گھر میں چھوڑ دیا ۔"
"12051","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوطلحہ رضی اللہ عنہ کا ایک بیٹا بیمار تھا ، حضرت ابوطلحہ رضی اللہ عنہ مسجد کے لئے نکلے تو ان کے پیچھے ان کا بیٹا فوت ہو گیا ، ان کی زوجہ حضرت ام سلیم رضی اللہ عنہا نے اسے کپڑا اوڑھا دیا اور گھر والوں سے کہہ دیا کہ تم میں سے کوئی بھی ابوطلحہ کو ان کے بیٹے کی موت کی خبر نہ دے ، چنانچہ جب حضرت ابوطلحہ رضی اللہ عنہ واپس آئے تو ان کے ساتھ مسجد سے ان کے کچھ دوست بھی آئے ، حضرت ابوطلحہ رضی اللہ عنہ نے بچے کے بارے پوچھا ، انہوں نے بتایا کہ پہلے سے بہتر ہے ، پھر ان کے سامنے رات کا کھانا لا کر رکھا ، سب نے کھانا کھایا ، لوگ چلے گئے تو وہ ان کاموں میں لگ گئیں جو عورتوں کے کرنے کے ہوتے ہیں ۔ جب رات کا آخری پہر ہوا تو انہوں نے حضرت ابوطلحہ رضی اللہ عنہ سے کہا کہ اے ابوطلحہ ! دیکھیں تو سہی ، فلاں لوگوں نے عاریۃَ کوئی چیز لی ، اس سے فائدہ اٹھاتے رہے ، جب ان سے واپسی کا مطالبہ ہوا تو وہ اس پر ناگواری ظاہر کرنے لگے آ حضرت ابوطلحہ رضی اللہ عنہ نے کہا یہ لوگ انصاف نہیں کر رہے ، ام سلیم رضی اللہ عنہا نے کہا کہ پھر تمہارا بیٹا بھی اللہ کی طرف سے عاریت تھا ، جسے اللہ نے واپس لے لیا ہے ، اس پر انہوں نے """" ®انا للہ وانا الیہ راجعون¾ """" کہا اور اللہ کا شکر ادا کیا ۔ صبح ہوئی تو وہ نبی ﷽ کی خدمت میں حاضر ہوئے ، نبی ﷽ نے انہیں دیکھ کر فرمایا اللہ تم دونوں میاں بیوی کے لئے اس رات کو مبارک فرمائے ، چنانچہ وہ امید سے ہو گئیں ، جب ان کے یہاں بچے کی ولادت ہوئی تو وہ رات کا وقت تھا ، انہوں نے اس وقت بچے کو گھٹی دینا اچھا نہ سمجھا اور یہ چاہا کہ اسے نبی ﷽ خود گھٹی دیں ، چنانچہ صبح کو میں اس بچے کو اٹھا کر اپنے ساتھ کچھ عجوہ کھجوریں لے کر نبی ﷽ کی خدمت میں حاضر ہوا ، میں نے دیکھا کہ نبی ﷽ اپنے اونٹوں کو قطران مل رہے ہیں ، میں نے عرض کیا یا رسول اللہ ﷽ ! آج رات ام سلیم رضی اللہ عنہا کے یہاں بچہ پیدا ہوا ، انہوں نے خود اسے گھٹی دینا مناسب نہ سمجھا اور چاہا کہ اسے آپ گھٹی دیں ، نبی ﷽ نے فرمایا کیا تمہارے پاس کچھ ہے آ میں نے عرض کیا عجوہ کھجوریں ہیں ، نبی ﷽ نے ایک کھجور لے کر اسے منہ میں چبا کر نرم کیا ، اور تھوک جمع کر کے اس کے منہ میں ٹپکا دیا جسے وہ چاٹنے لگا ، نبی ﷽ نے فرمایا کھجور انصار کی محبوب چیز ہے ، میں نے عرض کیا یا رسول اللہ ﷽ ! اس کا نام رکھ دیجئے ، فرمایا اس کا نام عبداللہ ہے ۔"
"12052","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"12053","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"12054","[Darussalam 12031] حضرت انس (رض) سے مروی ہے حضرت ابوطلحہ (رض) کا ایک بیٹا بیمار تھا، حضرت ابوطلحہ (رض) مسجد کے لئے نکلے تو ان کے پیچھے ان کا بیٹا فوت ہوگیا، ان کی زوجہ حضرت ام سلیم (رض) نے اسے کپڑا اوڑھا دیا اور گھر والوں سے کہا کہ تم میں سے کوئی بھی ابوطلحہ (رض) کو ان کے بیٹے کی موت کی خبر نہ دے، چناچہ جب حضرت ابوطلحہ (رض) واپس آئے تو ان کے ساتھ مسجد سے ان کے کچھ دوست بھی آئے، حضرت ابوطلحہ (رض) نے بچے کے بارے پوچھا، انہوں نے بتایا کہ پہلے سے بہتر ہے، پھر ان کے سامنے رات کا کھانا لا کر رکھا سب نے کھانا کھایا، لوگ چلے گئے تو وہ ان کاموں میں لگ گئیں جو عورتوں کے کرنے کے ہوتے ہیں۔ جب رات کا آخری پہر ہوا تو انہوں نے حضرت ابوطلحہ (رض) سے کہا کہ اے ابوطلحہ ! دیکھیں تو سہی فلاں لوگوں نے عاریۃً کوئی چیز لی، اس سے فائدہ اٹھاتے رہے جب ان سے واپسی کا مطالبہ ہوا تو وہ اس پر ناگواری ظاہر کرنے لگے، حضرت ابوطلحہ (رض) نے کہا یہ لوگ انصاف نہیں کر رہے، ام سلیم (رض) نے کہا کہ پھر تمہارا بیٹا بھی اللہ کی طرف سے عاریت تھا، جسے اللہ نے واپس لے لیا ہے اس پر انہوں نے |"" انا للہ وانا الیہ راجعون |"" کہا اور اللہ کا شکر ادا کیا۔ صبح ہوئی تو وہ نبی (صلی اللہ علیہ وآلہ وسلم) کی خدمت میں حاضر ہوئے، نبی (صلی اللہ علیہ وآلہ وسلم) نے انہیں دیکھ کر فرمایا اللہ تم دونوں میاں بیوی کے لئے اس رات کو مبارک فرمائے، چناچہ وہ امید سے ہوگئیں، جب ان کے یہاں بچے کی ولادت ہوئی تو وہ رات کا وقت تھا۔ انہوں نے اس وقت بچے کو گھٹی دینا اچھا نہ سمجھا اور یہ چاہا کہ اسے خود نبی (صلی اللہ علیہ وآلہ وسلم) گھٹی دیں، چناچہ صبح کو میں اس بچے کو اٹھا کر اپنے ساتھ کچھ عجوہ کھجوریں لے کر نبی (صلی اللہ علیہ وآلہ وسلم) کی خدمت میں حاضر ہوا، میں نے دیکھا کہ نبی (صلی اللہ علیہ وآلہ وسلم) اپنے اونٹوں کو قطران مل رہے ہیں، میں نے عرض کیا یا رسول اللہ (صلی اللہ علیہ وآلہ وسلم) ! آج رات ام سلیم کے یہاں بچہ پیدا ہوا، انہوں نے خود اسے گھٹی دینا مناسب نہ سمجھا اور چاہا کہ اسے آپ گھٹی دیں، نبی (صلی اللہ علیہ وآلہ وسلم) نے فرمایا کیا تمہارے پاس کچھ ہے ؟ میں نے عرض کیا عجوہ کھجوریں ہیں، نبی (صلی اللہ علیہ وآلہ وسلم) نے ایک کھجور لے کر اسے منہ میں چبا کر نرم کیا اور تھوک جمع کر کے اس کے منہ میں ٹپکا دیا جسے وہ چاٹنے لگا، نبی (صلی اللہ علیہ وآلہ وسلم) نے فرمایا کھجور انصار کی محبوب چیز ہے، میں نے عرض کیا یا رسول اللہ (صلی اللہ علیہ وآلہ وسلم) ! اس کا نام رکھ دیجئے، فرمایا اس کا نام عبداللہ ہے۔ -r-n گذشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12055","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کے لئے اذان ہوئی ، مسجد کے قریب جتنے لوگوں کے گھر تھے وہ سب آ گئے ، اور دور والے نہ آ سکے ، نبی ﷽ کے پاس پتھر کا ایک پیالہ لایا گیا جس میں آپ ﷽ کی ہتھیلی بھی مشکل سے کھلتی تھی ، نبی ﷽ نے اپنی انگلیوں کو جوڑ لیا اور اس میں سے اتنا پانی نکلا کہ سب نے وضو کر لیا ، کسی نے حضرت انس رضی اللہ عنہ سے پوچھا کہ اس وقت آپ کتنے لوگ تھے آ انہوں نے بتایا کہ اسی یا کچھ زیادہ ۔"
"12056","حضرت انس رضی اللہ عنہ سے مروی ہے کہ بنو سلمہ نے ایک مرتبہ یہ ارادہ کیا کہ اپنی پرانی رہائش گاہ سے منتقل ہو کر مسجد کے قریب آ کر سکونت پذیر ہو جائیں ، نبی ﷽ کو یہ بات معلوم ہوئی تو آپ ﷽ کو مدینہ منورہ کا خالی ہونا اچھا نہ لگا ، اس لئے فرمایا اے بنو سلمہ ! کیا تم مسجد کی طرف اٹھنے والے قدموں کا ثواب حاصل کرنا نہیں چاہتے آ وہ کہنے لگے کیوں نہیں یا رسول اللہ ﷽ ! پھر وہ یہیں اقامت پذیر رہے ۔"
"12057","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کھڑی ہوئی تو ایک آدمی تیزی سے آیا ، اس کا سانس پھولا ہوا تھا ، صف تک پہنچ کر وہ کہنے لگا """" ®الحمدللہ حمدا کثیرا طیبا مبارکا فیہ¾ """" نبی ﷽ نے نماز سے فارغ ہو کر پوچھا کہ تم میں سے کون بولا تھا آ اس نے اچھی بات کہی تھی ، چنانچہ وہ آدمی کہنے لگا یا رسول اللہ ﷽ ! میں بولا تھا ، میں تیزی سے آ رہا تھا ، اور صف کے قریب پہنچ کر میں نے یہ جملہ کہا تھا ، نبی ﷽ نے فرمایا میں نے بارہ فرشتوں کو اس کی طرف تیزی سے بڑھتے ہوئے دیکھا کہ کون اس جملے کو پہلے اٹھاتا ہے ، پھر فرمایا جب تم میں سے کوئی شخص نماز کے لئے آئے تو سکون سے چلے ، جتنی نماز مل جائے سو پڑھ لے اور جو رہ جائے اسے قضاء کر لے ۔"
"12058","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا میں جنت میں داخل ہوا تو اپنے آگے کسی کی آہٹ سنی ، دیکھا تو وہ غمیصاء بنت ملحان تھیں + جو کہ حضرت انس رضی اللہ عنہ کی والدہ تھیں ,"
"12059","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ تعالیٰ جب کسی بندے کے ساتھ خیر کا ارادہ فرماتے ہیں تو اسے استعمال فرماتے ہیں ، صحابہ رضی اللہ عنہم نے پوچھا کہ کیسے استعمال فرماتے ہیں آ نبی ﷽ نے فرمایا اسے مرنے سے پہلے عمل صالح کی توفیق عطاء فرما دیتے ہیں ۔"
"12060","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا مسلمان کا خواب اجزاء نبوت میں سے چھیالیسواں جزء ہوتا ہے ۔"
"12061","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ایک آدمی کو اپنے دو بیٹوں کے کندھوں کا سہارا لے کر چلتے ہوئے دیکھا تو پوچھا یہ کیا ماجرا ہے آ انہوں نے بتایا کہ انہوں نے پیدل چل کر حج کرنے کی منت مانی تھی ، نبی ﷽ نے فرمایا اللہ اس بات سے غنی ہے کہ یہ شخص اپنے آپ کو تکلیف میں مبتلا کرے ، پھر آپ ﷽ نے اسے سوار ہونے کا حکم دیا ، چنانچہ وہ سوار ہو گیا ۔"
"12062","[Darussalam 12039] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12063","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے ایک آدمی کو دیکھا جو اونٹ ہانکتے ہوئے چلا جا رہا تھا اور چلنے سے عاجز آ گیا تھا ، نبی ﷽ نے اس سے سوار ہونے کے لئے فرمایا ، اس نے کہا کہ یہ قربانی کا جانور ہے ۔ نبی ﷽ نے اس سے فرمایا کہ سوار ہو جاا اگرچہ یہ قربانی ہی کا ہو ۔"
"12064","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی """" جس کا نام انجشہ تھا """" امہات المومنین کی سواریوں کو ہانک رہا تھا ، اس نے جانوروں کو تیزی سے ہانکنا شروع کر دیا ، اس پر نبی ﷽ نے فرمایا انجشہ ! ان آبگینوں کو آہستہ لے کر چلو ۔"
"12065","حضرت انس رضی اللہ عنہ سے مروی ہے کہ قبیلہ عرینہ کے کچھ لوگ مسلمان ہو گئے ، لیکن انہیں مدینہ منورہ کی آب و ہوا موافق نہ آئی ، نبی ﷽ نے ان سے فرمایا کہ اگر تم ہمارے اونٹوں کے پاس جا کر ان کا دودھ پیو تو شاید تندرست ہو جاا ، چنانچہ انہوں نے ایسا ہی کیا ، لیکن جب وہ صحیح ہو گئے تو دوبارہ مرتد ہو کر کفر کی طرف لوٹ گئے ، نبی ﷽ کے مسلمان چرواہے کو قتل کر دیا ، اور نبی ﷽ کے اونٹوں کو بھگا کر لے گئے ، نبی ﷽ نے ان کے پیچھے صحابہ رضی اللہ عنہم کو بھیجا ، انہیں پکڑ کر نبی ﷽ کے سامنے پیش کیا گیا ، نبی ﷽ نے ان کے ہاتھ پااں مخالف سمت سے کٹوا دیئے ، ان کی آنکھوں میں سلائیاں پھروا دیں اور انہیں پتھریلے علاقوں میں چھوڑ دیا یہاں تک کہ وہ مر گئے ۔"
"12066","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا قیامت اس وقت تک قائم نہیں ہو گی جب تک زمین میں اللہ اللہ کہنے والا کوئی شخص باقی ہے ۔"
"12067","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا قیامت تک ہونے والی کسی چیز کے متعلق تم مجھ سے اس وقت تک سوال نہ کیا کرو جب تک میں تم سے خود بیان نہ کر دوں ، اس کے باوجود عبداللہ بن حذافہ رضی اللہ عنہ نے پوچھ لیا یا رسول اللہ ﷽ ! میرا باپ کون ہے آ نبی ﷽ نے فرمایا تمہارا باپ حذافہ ہے ، ان کی والدہ نے ان سے کہا کہ تمہارا اس سے کیا مقصد تھا آ انہوں نے کہا کہ میں لوگوں کی باتوں سے چھٹکارا حاصل کرنا چاہتا تھا ، دراصل ان کے متعلق کچھ باتیں مشہور تھیں ۔ بہرحال ! ان کے سوال پر نبی ﷽ اور ناراض ہو گئے ، اس پر حضرت عمر رضی اللہ عنہ کہنے لگے کہ ہم اللہ کو اپنا رب مان کر ، اسلام کو اپنا دین قرار دے کر اور محمد ﷽ کو اپنا نبی مان کر خوش اور مطمئن ہیں ، اور ہم اللہ اور اس کے رسول کی ناراضگی سے اللہ کی پناہ میں آتے ہیں ۔"
"12068","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا بہترین علاج سینگی لگوانا اور قسط بحری کا استعمال ہے ، اور تم اپنے بچوں کے گلے میں انگلیاں ڈال کر انہیں تکلیف نہ دیا کرو ۔"
"12069","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ایک مرتبہ میں جنت میں داخل ہوا تو وہاں سونے کا ایک محل نظر آیا ، میں نے پوچھا یہ محل کس کا ہے آ لوگوں نے بتایا کہ یہ ایک قریشی نوجوان کا ہے ، میں نے پوچھا وہ کون ہے آ لوگوں نے بتایا عمر بن خطاب رضی اللہ عنہ ، مجھے اگر تمہاری غیرت کے بارے معلوم نہ ہوتا تو میں ضرور اس میں داخل ہو جاتا ، حضرت عمر رضی اللہ عنہ کہنے لگے یا رسول اللہ ﷽ ! کیا میں آپ پر غیرت کا اظہار کروں گا آ"
"12070","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص اللہ سے ملنے کو پسند کرتا ہے ، اللہ بھی اس سے ملنے کو پسند کرتا ہے ، اور جو اللہ سے ملنے کو ناپسند کرتا ہے ، اللہ بھی اس سے ملنے کو ناپسند کرتا ہے ، یہ سن کر ہم نے عرض کیا یا رسول اللہ ﷽ ! ہم میں سے تو ہر ایک موت کو ناپسند کرتا ہے آ نبی ﷽ نے فرمایا اس سے موت کی ناپسندیدگی مراد نہیں ہے ، بلکہ مومن کے پاس جب اللہ کی طرف سے ایک فرشتہ اس کے بہترین انجام کی خوش خبری لے کر آتا ہے تو اس کے نزدیک اللہ کی ملاقات سے بڑھ کر کوئی چیز محبوب نہیں ہوتی ، پھر اللہ بھی اس سے ملنے کو پسند کرتا ہے ، اور جب کافر کے پاس اللہ کی طرف سے ایک فرشتہ اس کے بدترین انجام کی خبر لے کر آتا ہے تو وہ اللہ سے ملاقات کو ناپسند کرتا ہے ، پھر اللہ بھی اس سے ملنے کو ناپسند کرتا ہے ۔"
"12071","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کی ہتھیلی سے زیادہ نرم کوئی ریشم بھی نہیں چھوا ، اور نبی ﷽ کی مہک سے عمدہ کوئی مہک نہیں سونگھی ۔"
"12072","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کسی مسلمان کی عیادت کے لئے تشریف لے گئے ، وہ چوزے کی طرح ہو چکا تھا ، نبی ﷽ نے اس سے پوچھا کیا تم کوئی دعاء مانگتے تھے آ اس نے کہا جی ہاں ! میں یہ دعاء مانگتا تھا کہ اے اللہ ! تو نے مجھے آخرت میں جو سزا دینی ہے ، وہ دنیا ہی میں دے دے ، نبی ﷽ نے فرمایا سبحان اللہ ! تمہارے اندر اس کی ہمت ہے اور نہ طاقت ، تم نے یہ دعاء کیوں نہ کی کہ اے اللہ ! مجھے دنیا میں بھی بھلائی عطاء فرما اور آخرت میں بھی بھلائی عطاء فرما اور ہمیں عذاب جہنم سے محفوظ فرما ، راوی کہتے ہیں کہ اس نے اللہ سے یہ دعاء مانگی اور اللہ نے اسے شفاء عطاء فرما دی ۔"
"12073","حضرت انس رضی اللہ عنہ سے مروی ہے کہ بعض اوقات نبی ﷽ کی خدمت میں کوئی شخص آ کر اسلام قبول کرتا کہ نبی ﷽ اسے دنیا کا مال و دولت عطاء فرمائیں گے اور شام تک اس کے نزدیک اسلام دنیا و مافیہا سے زیادہ محبوب اور معزز ہو چکا ہوتا ۔"
"12074","حضرت انس رضی اللہ عنہ سے مروی ہے کہ قبول اسلام پر جو آدمی نبی ﷽ سے جس چیز کا بھی سوال کرتا ، نبی ﷽ اسے عطاء فرما دیتے ، اسی تناظر میں ایک آدمی آیا اور اس نے نبی ﷽ سے کچھ مانگا ، نبی ﷽ نے اسے صدقہ کی بکریوں میں سے بہت سی بکریاں """" جو دو پہاڑوں کے درمیان آ سکیں """" دینے کا حکم دے دیا ، وہ آدمی اپنی قوم کے پاس آ کر کہنے لگا لوگو ! اسلام قبول کر لو ، کیونکہ محمد ﷽ اتنی بخشش دیتے ہیں کہ انسان کو فقر و فاقہ کا کوئی اندیشہ نہیں رہتا ۔"
"12075","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ام سلیم رضی اللہ عنہا نے میرے ہاتھ ایک تھیلی میں تر کھجوریں بھر کر نبی ﷽ کی خدمت میں بھیجیں ، میں نے نبی ﷽ کو گھر میں نہ پایا ، کیونکہ نبی ﷽ قریب ہی اپنے ایک آزاد کردہ غلام کے یہاں گئے ہوئے تھے جس نے نبی ﷽ کی دعوت کی تھی ، میں وہاں پہنچا تو نبی ﷽ کھانا تناول فرما رہے تھے ، نبی ﷽ نے مجھے بھی کھانے کے لئے بلا لیا ، دعوت میں صاحب خانہ نے گوشت اور کدو کا ثرید تیار کر رکھا تھا ، نبی ﷽ کو کدو بہت پسند تھا ، اس لئے میں اسے الگ کر کے نبی ﷽ کے سامنے کرتا رہا ، جب کھانے سے فارغ ہو کر نبی ﷽ اپنے گھر واپس تشریف لائے تو میں نے وہ تھیلی نبی ﷽ کے سامنے رکھ دی ، نبی ﷽ اسے کھاتے گئے اور تقسیم کرتے گئے یہاں تک کہ تھیلی خالی ہو گئی ۔"
"12076","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ حضرت ام سلیم رضی اللہ عنہا کے یہاں تشریف لائے ، انہوں نے نبی ﷽ کے سامنے کھجوریں اور گھی پیش کیا ، نبی ﷽ اس دن روزے سے تھے اس لئے فرمایا کہ کھجوریں اس کے برتن میں اور گھی اس کی بالٹی میں واپس ڈال دو ، پھر گھر کے ایک کونے میں کھڑے ہو کر آپ ﷽ نے دو رکعت نماز پڑھی ، ہم نے بھی نبی ﷽ کے ساتھ نماز پڑھی ، پھر نبی ﷽ نے حضرت ام سلیم رضی اللہ عنہا اور ان کے اہل خانہ کے لئے دعاء فرمائی ، حضرت ام سلیم رضی اللہ عنہا نے عرض کیا یا رسول اللہ ﷽ ! میری ایک خاص چیز بھی ہے ، نبی ﷽ نے پوچھا وہ کیا ہے آ عرض کیا آپ کا خادم انس ، اسی پر نبی ﷽ نے دنیا و آخرت کی کوئی خیر ایسی نہ چھوڑی جو میرے لیے نہ مانگی ہو ، اور فرمایا اے اللہ ! اسے مال اور اولاد عطاء فرما اور ان میں برکت عطاء فرما ، چنانچہ اس کے بعد انصار میں سے کوئی شخص مجھ سے زیادہ مالدار نہ تھا ، حالانکہ قبل ازیں وہ اپنی انگوٹھی کے علاوہ کسی سونا چاندی کے مالک نہ تھے ، اور خود کہتے ہیں کہ مجھے میری بڑی بیٹی امینہ نے بتایا ہے کہ حجاج بن یوسف کے آنے تک میری نسل میں سے ایک سو بیس سے زائد آدمی فوت ہو کر دفن ہو چکے ہیں ۔"
"12077","حمید کہتے ہیں کسی شخص نے حضرت انس رضی اللہ عنہ سے پوچھا کہ کیا نبی ﷽ خضاب لگاتے تھے آ انہوں نے فرمایا کہ نبی ﷽ کی مبارک ڈاڑھی کے اگلے حصے میں صرف سترہ یا بیس بال سفید تھے ، اور ان پر بڑھاپے کا عیب نہیں آیا ، کسی نے پوچھا کہ کیا بڑھاپا عیب ہے آ انہوں نے فرمایا تم میں سے ہر شخص اسے ناپسند سمجھتا ہے ، البتہ حضرت ابوبکر صدیق رضی اللہ عنہ مہندی اور وسمہ کا خضاب لگاتے تھے جب کہ حضرت عمر رضی اللہ عنہ صرف مہندی کا خضاب لگاتے تھے ۔"
"12078","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ اپنے گھر میں بیٹھے ہوئے تھے کہ ایک آدمی آ کر کسی سوراخ سے اندر جھانکنے لگا ، نبی ﷽ نے اپنے ہاتھ میں پکڑی ہوئی کنگھی سے اشارہ کیا تو وہ آدمی پیچھے ہٹ گیا ۔"
"12079","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ابوموسیٰ اشعری رضی اللہ عنہ نے نبی ﷽ سے سواری کے لئے کوئی جانور مانگا ، نبی ﷽ اس وقت کسی کام میں مصروف تھے ، اس لئے فرما دیا کہ بخدا ! میں تمہیں کوئی سواری نہیں دوں گا ، لیکن جب وہ پلٹ کر جانے لگے تو انہیں واپس بلایا اور ایک سواری مرحمت فرما دی ، وہ کہنے لگے یا رسول اللہ ﷽ ! آپ نے تو قسم کھائی تھی کہ مجھے کوئی سواری نہیں دیں گے آ فرمایا اب قسم کھا لیتا ہوں کہ تمہیں سواری ضرور دوں گا ۔"
"12080","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی مدینہ منورہ تشریف آوری کے بعد حضرت عبداللہ بن سلام رضی اللہ عنہ بارگاہ رسالت میں حاضر ہوئے اور کہنے لگے یا رسول اللہ ﷽ ! میں آپ سے تین باتیں پوچھتا ہوں جنہیں کسی نبی کے علاوہ کوئی نہیں جانتا ، نبی ﷽ نے فرمایا پوچھو ، انہوں نے کہا کہ قیامت کی سب سے پہلی علامت کیا ہے آ اہل جنت کا سب سے پہلا کھانا کیا چیز ہو گی آ اور بچہ اپنے ماں باپ کے مشابہہ کیسے ہوتا ہے آ نبی ﷽ نے فرمایا ان سوالوں کا جواب مجھے ابھی ابھی حضرت جبریل علیہ السلام نے بتایا ہے ، عبداللہ کہنے لگے کہ وہ تو فرشتوں میں یہودیوں کا دشمن ہے ۔ نبی ﷽ نے فرمایا قیامت کی سب سے پہلی علامت تو وہ آگ ہو گی جو مشرق سے نکل کر تمام لوگوں کو مغرب میں جمع کر لے گی ، اور اہل جنت کا سب سے پہلا کھانا مچھلی کا جگر ہو گا ، اور بچے کے اپنے ماں باپ کے ساتھ مشابہہ ہونے کی وجہ یہ ہے کہ اگر مرد کا """" پانی """" عورت کے پانی پر غالب آ جائے تو وہ بچے کو اپنی طرف کھینچ لیتا ہے ، اور اگر عورت کا """" پانی """" مرد کے پانی پر غالب آ جائے تو وہ بچے کو اپنی طرف کھینچ لیتی ہے ، یہ سن کر عبداللہ کہنے لگے کہ میں اس بات کی گواہی دیتا ہوں کہ اللہ کے علاوہ کوئی معبود نہیں اور آپ اللہ کے رسول ہیں ، پھر کہنے لگے یا رسول اللہ ﷽ ! یہودی بہتان باندھنے والی قوم ہیں ، اگر انہیں میرے اسلام کا پتہ چل گیا تو وہ آپ کے سامنے مجھ پر طرح طرح کے الزام لگائیں گے ، اس لئے آپ ان کے پاس پیغام بھیج کر انہیں بلائیے اور میرے متعلق ان سے پوچھئے کہ تم میں ابن سلام کیسا آدمی ہے آ چنانچہ نبی ﷽ نے انہیں بلا بھیجا ، اور ان سے پوچھا کہ عبداللہ بن سلام تم میں کیسا آدمی ہے آ انہوں نے جواب دیا کہ ہم میں سب سے بہتر ہے اور سب سے بہتر کا بیٹا ہے ، ہمارا عالم اور عالم کا بیٹا ہے ، ہم میں سب سے بڑا فقیہہ ہے اور سب سے بڑے فقیہہ کا بیٹا ہے ، نبی ﷽ نے فرمایا یہ بتاا ، اگر وہ اسلام قبول کر لے تو کیا تم بھی اسلام قبول کر لو گے آ وہ کہنے لگے اللہ اسے بچا کر رکھے ، اس پر حضرت عبداللہ بن سلام رضی اللہ عنہ باہر نکل آئے اور ان کے سامنے کلمہ پڑھا ، یہ سن کر وہ کہنے لگے کہ یہ ہم میں سب سے بدتر ہے اور سب سے بدتر کا بیٹا ہے اور ہم میں جاہل اور جاہل کا بیٹا ہے ، حضرت عبداللہ بن سلام رضی اللہ عنہ نے فرمایا اسی چیز کا مجھے اندیشہ تھا ۔"
"12081","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب غزوہ حنین کے دن مسلمان ابتدائی طور پر شکست خوردہ ہو کر بھاگنے لگے ، تو حضرت ام سلیم رضی اللہ عنہا نے پکار کر عرض کیا یا رسول اللہ ﷽ ! جو لوگ ہمیں چھوڑ کر بھاگ گئے ہیں ، انہیں قتل کروا دیں ، نبی ﷽ نے فرمایا اے ام سلیم ! اللہ تعالیٰ کافی ہے ، تھوڑی دیر بعد حضرت ابوطلحہ رضی اللہ عنہ ان کے پاس آئے تو ام سلیم رضی اللہ عنہ کے ہاتھ میں ایک کدال تھی ، انہوں نے پوچھا ام سلیم ! یہ کیا ہے آ انہوں نے کہا کہ اگر کوئی مشرک میرے قریب آیا تو میں اس سے اس کا پیٹ پھاڑ دوں گی ، یہ سن کر وہ کہنے لگے یا رسول اللہ ﷽ ! دیکھیں تو سہی کہ ام سلیم کیا کہہ رہی ہیں ۔"
"12082","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی مدینہ منورہ تشریف آوری کے بعد حضرت عبداللہ بن سلام رضی اللہ عنہ بارگاہ رسالت میں حاضر ہوئے اور کہنے لگے یا رسول اللہ ﷽ ! میں آپ سے تین باتیں پوچھتا ہوں ۔۔۔۔۔۔ پھر راوی نے پوری حدیث ذکر کی ۔"
"12083","حضرت انس رضی اللہ عنہ فرماتے ہیں کہ ایک مرتبہ میں بچوں کے ساتھ کھیل رہا تھا ، اسی دوران نبی ﷽ تشریف لے آئے اور ہمیں سلام کیا ، پھر میرا ہاتھ پکڑ کر مجھے کسی کام سے بھیج دیا اور خود ایک دیوار کے سائے میں بیٹھ گئے ، یہاں تک کہ میں واپس آ گیا اور وہ پیغام پہنچا دیا جو نبی ﷽ نے دے کر مجھے بھیجا تھا ، جب میں گھر واپس پہنچا تو حضرت ام سلیم رضی اللہ عنہا + میری والدہ , کہنے لگیں کہ اتنی دیر کیوں لگا دی آ میں نے بتایا کہ نبی ﷽ نے اپنے کسی کام سے بھیجا تھا ، انہوں نے پوچھا کیا کام تھا آ میں نے کہا کہ یہ ایک راز ہے ، انہوں نے کہا کہ پھر نبی ﷽ کے راز کی حفاظت کرنا ، چنانچہ اس کے بعد میں نے کبھی وہ کسی کے سامنے بیان نہیں کیا ۔"
"12084","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک آدمی سے اسلام قبول کرنے کے لئے فرمایا ، اس نے کہا کہ مجھے پسند نہیں ہے ، نبی ﷽ نے فرمایا پسند نہ بھی ہو تب بھی اسلام قبول کر لو ۔"
"12085","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا مسجد میں تھوکنا گناہ ہے اور اس کا کفارہ اسے دفن کر دینا ہے ۔"
"12086","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جب تم میں سے کوئی شخص نماز پڑھ رہا ہوتا ہے تو وہ اپنے رب سے مناجات کر رہا ہوتا ہے ، اس لئے اس حالت میں تم میں سے کوئی شخص اپنے دائیں جانب نہ تھوکا کرے بلکہ بائیں جانب یا اپنے پااں کے نیچے تھوکا کرے ۔"
"12087","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے پاس قبیلہ رعل ، ذکوان ، عصیہ اور بنو لحیان کے کچھ لوگ آئے اور یہ ظاہر کیا کہ وہ اسلام قبول کر چکے ہیں ، اور نبی ﷽ سے اپنی قوم پر تعاون کا مطالبہ کیا ، نبی ﷽ نے ان کے ساتھ ستر انصاری صحابہ رضی اللہ عنہم تعاون کے لئے بھیج دیئے ، حضرت انس رضی اللہ عنہ کہتے ہیں کہ ہم انہیں """" قراء """" کہا کرتے تھے ، یہ لوگ دن کو لکڑیاں کاٹتے اور رات کو نماز میں گزار دیتے تھے ، وہ لوگ ان تمام حضرات کو لے کر روانہ ہو گئے ، راستے میں جب وہ """" بیر معونہ """" کے پاس پہنچے تو انہوں نے صحابہ کرام رضی اللہ عنہم کے ساتھ دھوکہ کیا اور انہیں شہید کر دیا ، نبی ﷽ کو پتہ چلا تو آپ ﷽ نے ایک مہینے تک فجر کی نماز میں قنوت نازلہ پڑھی اور رعل ، ذکوان ، عصیہ اور بنولحیان کے قبائل پر بددعاء کرتے رہے ۔ حضرت انس رضی اللہ عنہ کہتے ہیں کہ ان صحابہ رضی اللہ عنہم کے یہ جملے کہ """" ہماری قوم کو ہماری طرف سے یہ پیغام پہنچا دو کہ ہم اپنے رب سے مل چکے ، وہ ہم سے راضی ہو گیا اور ہمیں بھی راضی کر دیا """" ایک عرصے تک قرآن کریم میں پڑھتے رہے ، بعد میں ان کی تلاوت منسوخ ہو گئی ۔"
"12088","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا لوگوں کو کیا ہو گیا ہے کہ دوران نماز آسمان کی طرف نگاہیں اٹھا کر دیکھتے ہیں آ نبی ﷽ نے شدت سے اس کی ممانعت کرتے ہوئے فرمایا کہ لوگ اس سے باز آ جائیں ورنہ ان کی بصارت اچک لی جائے گی ۔"
"12089","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا سجدوں میں اعتدال برقرار رکھا کرو ، اور تم میں سے کوئی شخص کتے کی طرح اپنے ہاتھ نہ بچھائے ۔"
"12090","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا بعض اوقات میں نماز شروع کرتا ہوں اور ارادہ ہوتا ہے کہ لمبی نماز پڑھااں ، لیکن پھر کسی بچے کے رونے کی آواز آتی ہے تو میں اپنی نماز کو مختصر کر دیتا ہوں ، کیونکہ میں جانتا ہوں کہ اس کی ماں اس کے رونے کی وجہ سے کتنی پریشان ہو رہی ہو گی آ"
"12091","حضرت انس رضی اللہ عنہ سے مروی ہے کہ فتح مکہ کے دن نبی ﷽ جب مکہ مکرمہ میں داخل ہوئے تو آپ ﷽ نے خود پہن رکھا تھا ، کسی شخص نے آ کر بتایا کہ ابن خطل خانہ کعبہ کے پردوں کے ساتھ چمٹا ہوا ہے ، نبی ﷽ نے فرمایا پھر بھی اسے قتل کر دو ۔"
"12092","عبدالرحمن کہتے ہیں کہ میں نے امام مالک رحمۃ اللہ کے سامنے جو حدیث پڑھی تھی ، اس میں یہ بھی تھا کہ اس دن نبی ﷽ حالت احرام میں نہ تھے ، واللہ اعلم ۔"
"12093","محمد بن ابی بکر کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ عرفہ کے دن آپ لوگ کیا کر رہے تھے آ انہوں نے فرمایا کہ نبی ﷽ کے ساتھ ہم میں سے کچھ لوگ تہلیل کہہ رہے تھے ، ان پر بھی کوئی نکیر نہ ہوتی تھی اور بعض تکبیر کہہ رہے تھے اور ان پر بھی کوئی نکیر نہ کی گئی ۔"
"12094","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جنت میں ایک درخت ایسا ہے جس کے سائے میں اگر کوئی سوار سو سال تک چلتا رہے تب بھی اس کا سایہ ختم نہ ہو ۔"
"12095","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے دباء اور مزفت سے اور اس میں نبیذ پینے سے منع فرمایا ہے ۔"
"12096","حضرت انس رضی اللہ عنہ سے مروی ہے کہ وہ آخری نظر جو میں نے نبی ﷽ پر پیر کے دن ڈالی ، وہ اس طرح تھی کہ نبی ﷽ نے اپنے حجرہ مبارکہ کا پردہ ہٹایا ، لوگ اس وقت حضرت ابوبکر صدیق رضی اللہ عنہ کی امامت میں نماز ادا کر رہے تھے ، میں نے نبی ﷽ کے چہرہ مبارک کو دیکھا تو وہ قرآن کا ایک کھلا ہوا صفحہ محسوس ہو رہا تھا ، لوگوں نے اپنی جگہ سے حرکت کرنا چاہی ، لیکن نبی ﷽ نے انہیں اشارے سے اپنی جگہ رہنے کا حکم دیا ، اور پردہ لٹکا لیا اور اسی دن آپ ﷽ دنیا سے رخصت ہو گئے ۔"
"12097","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا آپس میں قطع تعلقی ، بغض ، پشت پھیرنا اور حسد نہ کیا کرو اور اللہ کے بندو ! بھائی بھائی بن کر رہا کرو ، اور کسی مسلمان کے لئے اپنے بھائی سے تین دن سے زیادہ قطع کلامی کرنا حلال نہیں ہے ۔"
"12098","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ گھوڑے سے گر پڑے جس سے دائیں حصے پر زخم آ گیا ، ہم لوگ عیادت کے لئے نبی ﷽ کے پاس آئے ، اسی دوران نماز کا وقت آ گیا ، نبی ﷽ نے بیٹھ کر نماز پڑھائی اور ہم نے بھی بیٹھ کر نماز پڑھی ، نماز سے فارغ ہو کر نبی ﷽ نے فرمایا امام تو ہوتا ہی اس لئے ہے کہ اس کی اقتداء کی جائے ، اس لئے جب وہ تکبیر کہے تو تم بھی تکبیر کہو ، جب وہ رکوع کرے تو تم بھی رکوع کرو ، + جب وہ سجدہ کرے تو تم بھی سجدہ کرو , جب وہ ®سمع اللہ لمن حمدہ¾ کہے تو تم ®ربنا ولک الحمد¾ کہو ، اور جب وہ بیٹھ کر نماز پڑھے تو تم سب بھی بیٹھ کر نماز پڑھو ۔"
"12099","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک دیہاتی آیا اور کہنے لگا یا رسول اللہ ﷽ ! قیامت کب قائم ہو گی آ نبی ﷽ نے فرمایا تم نے قیامت کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کہ میں نے کوئی بہت زیادہ اعمال تو مہیا نہیں کر رکھے ، البتہ اتنی بات ضرور ہے کہ میں اللہ اور اس کے رسول ﷽ سے محبت کرتا ہوں ، نبی ﷽ نے فرمایا کہ انسان قیامت کے دن اس شخص کے ساتھ ہو گا جس کے ساتھ وہ محبت کرتا ہے ۔"
"12100","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب رات کا کھانا سامنے آ جائے اور نماز کھڑی ہو جائے تو پہلے کھانا کھا لو ۔"
"12101","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب مدینہ منورہ تشریف لائے تو میں دس سال کا تھا ، جب دنیا سے رخصت ہوئے تو بیس سال کا تھا ، میری والدہ مجھے نبی ﷽ کی خدمت کی ترغیب دیا کرتی تھیں ، ایک مرتبہ نبی ﷽ ہمارے گھر تشریف لائے ، ہم نے ایک پالتو بکری کا دودھ دوہا اور گھر کے کنوئیں میں سے پانی لے کر اس میں ملایا اور نبی ﷽ کی خدمت میں پیش کر دیا ، نبی ﷽ کی دائیں جانب ایک دیہاتی تھا ، اور بائیں جانب حضرت ابوبکر صدیق رضی اللہ عنہ تھے ، حضرت عمر رضی اللہ عنہ بھی ایک کونے میں تھے ، نبی ﷽ جب اسے نوش فرما چکے تو حضرت عمر رضی اللہ عنہ نے عرض کیا کہ یہ ابوبکر کو دے دیجئے ، لیکن نبی ﷽ نے دودھ کا وہ برتن دیہاتی کو دے دیا اور فرمایا پہلے دائیں ہاتھ والے کو ، پھر اس کے بعد والے کو ۔"
"12102","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت صفیہ رضی اللہ عنہا کا ولیمہ کھجوروں اور ستو سے کیا ۔"
"12103","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کے ساتھ مدینہ منورہ میں چار رکعتیں اور ذوالحلیفہ میں دو رکعتیں پڑھی ہیں ۔"
"12104","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا میت کے ساتھ تین چیزیں جاتی ہیں اس کے اہل خانہ ، مال اور اعمال ، دو چیزیں واپس آ جاتی ہیں اور ایک چیز اس کے ساتھ رہ جاتی ہیں ، اہل خانہ اور مال واپس آ جاتا ہے اور اعمال باقی رہ جاتے ہیں ۔"
"12105","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نے ایک یتیم بچے کے ساتھ """" جو ہمارے گھر میں تھا """" نبی ﷽ کے پیچھے نماز پڑھی ، اس وقت نبی ﷽ ہمارے گھر تشریف لائے تھے ، اور حضرت ام سلیم رضی اللہ عنہا نے ہمارے پیچھے کھڑے ہو کر نماز پڑھی ۔"
"12106","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک دیہاتی نے آ کر مسجد نبوی میں پیشاب کر دیا ، نبی ﷽ نے فرمایا اس پر پانی کا ایک ڈول بہا دو ۔"
"12107","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کے ساتھ مدینہ منورہ میں ظہر کی چار رکعتیں اور ذوالحلیفہ میں عصر کی دو رکعتیں پڑھی ہیں ۔"
"12108","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ اور خلفاء ثلاثہ رضی اللہ عنہم کے ساتھ نماز پڑھی ہے ، یہ حضرات نماز میں قراءت کا آغاز """" ®الحمدللہ رب العالمین¾ """" سے کرتے تھے ۔"
"12109","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے انصار کو بلایا تاکہ بحرین سے آئے ہوئے مال کا حصہ انہیں تقسیم کر دیں ، لیکن وہ کہنے لگے کہ پہلے ہمارے مہاجر بھائیوں کا ہمارے برابر حصہ الگ کیجئے ، نبی ﷽ نے ان کے جذبہ ایثار کو دیکھ کر فرمایا میرے بعد تمہیں ترجیحات کا سامنا کرنا پڑے گا ، لیکن تم صبر کرنا تاآنکہ مجھ سے آ ملو ۔"
"12110","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ غزوہ خیبر کے لئے صبح کے وقت تشریف لے گئے ، لوگ اس وقت کام پر نکلے ہوئے تھے ، وہ کہنے لگے کہ محمد اور لشکر آ گئے ، پھر وہ اپنے قلعے کی طرف بھاگنے لگے ، نبی ﷽ نے اپنے ہاتھ بلند کر کے تین مرتبہ اللہ اکبر کہا اور فرمایا خیبر برباد ہو گیا جب ہم کسی قوم کے صحن میں اترتے ہیں تو ڈرائے ہوئے لوگوں کی صبح بڑی بدترین ہوتی ہے ، وہاں بستی سے باہر ہمیں گدھے ہاتھ لگے ، ہم نے انہیں پکا لیا ، لیکن نبی ﷽ نے فرمایا اللہ اور اس کا رسول تمہیں پالتو گدھوں سے روکتے ہیں ، کیونکہ یہ ناپاک اور شیطانی عمل ہے ۔"
"12111","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کو کسی لشکر کا اتنا دکھ نہیں ہوا ، جتنا بیر معونہ والے لشکر پر ہوا ، اس لشکر کے لوگوں کا نام ہی """" قراء """" پڑ گیا تھا ، اور ان ہی کے بارے میں یہ آیت نازل ہوئی تھی کہ ہماری قوم کو ہماری طرف سے یہ پیغام پہنچا دو کہ ہم اپنے پروردگار سے راضی ہو گئے اور اس نے ہمیں خوش کر دیا ۔"
"12112","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کو کسی لشکر کا اتنا دکھ نہیں ہوا ، جتنا بیر معونہ والے لشکر پر ہوا ۔"
"12113","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے مہاجرین و انصار کے درمیان مواخات ہمارے گھر میں فرمائی تھی ۔"
"12114","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ ایک سفر میں تھے ، نبی ﷽ کا ایک حدی خوان تھا """" جس کا نام انجشہ تھا """" وہ امہات المومنین کی سواریوں کو ہانک رہا تھا ، حضرت انس رضی اللہ عنہ کی والدہ بھی ان کے ساتھ تھیں ، نبی ﷽ نے فرمایا انجشہ ! ان آبگینوں کو آہستہ لے کر چلو ۔"
"12115","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو مقام بیداء میں حج و عمرہ کا تلبیہ اکٹھے پڑھتے ہوئے سنا ہے کہ آپ ﷽ یوں فرما رہے تھے ®لبیک بعمرۃ وحجۃ معاَ¾ ۔"
"12116","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب جمرہ عقبہ کی رمی اور جانور کی قربانی کر چکے تو سینگی لگوائی اور بال کاٹنے والے کے سامنے پہلے سر کا داہنا حصہ کیا ، اس نے اس حصے کے بال تراشے ، نبی ﷽ نے وہ بال حضرت ابوطلحہ رضی اللہ عنہ کو دے دیئے ، پھر بائیں جانب کے بال منڈوائے تو وہ عام لوگوں کو دے دیئے ۔"
"12117","حضرت انس رضی اللہ عنہ سے مروی ہے کہ اکیدر دومہ نے نبی ﷽ کی خدمت میں ایک جوڑا ہدیہ کے طور پر بھیجا ، لوگ اس کی خوبصورتی پر تعجب کرنے لگے ، نبی ﷽ نے فرمایا سعد کے رومال """" جو انہیں جنت میں دیئے گئے ہیں """" وہ اس سے بہتر اور عمدہ ہیں ۔"
"12118","ابن جدعان رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ ثابت رحمۃ اللہ نے حضرت انس رضی اللہ عنہ سے عرض کیا کہ اے انس ! کیا آپ نے نبی ﷽ کے دست مبارک کو اپنے ہاتھ سے چھوا ہے آ انہوں نے اثبات میں جواب دیا تو ثابت رحمۃ اللہ نے کہا کہ مجھے وہ ہاتھ دکھائیے کہ میں اسے بوسہ دوں ۔"
"12119","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا لشکر میں ابوطلحہ رضی اللہ عنہ کی آواز ہی کئی لوگوں سے بہتر ہے ۔"
"12120","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ مدینہ منورہ میں بنو نجار کے کسی ویرانے میں تشریف لے گئے ، وہاں نبی ﷽ قضاء حاجت کے لئے جایا کرتے تھے ، تھوڑی دیر بعد نبی ﷽ گھبرائے ہوئے ہمارے پاس آئے اور فرمایا اگر تم لوگ اپنے مردوں کو دفن کرنا چھوڑ نہ دیتے تو میں اللہ سے یہ دعاء کرتا کہ وہ تمہیں بھی عذاب قبر کی آواز سنا دے ۔"
"12121","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کبھی کبھار اپنی تمام ازواج مطہرات کے پاس ایک ہی رات میں ایک ہی غسل سے چلے جایا کرتے تھے ۔"
"12122","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کے ساتھ مدینہ منورہ میں چار رکعتیں اور ذوالحلیفہ میں دو رکعتیں پڑھی ہیں ۔"
"12123","مختار بن فلفل رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ برتنوں میں پینے کا کیا حکم ہے آ انہوں نے جواب دیا کہ نبی ﷽ نے """" مزفت """" سے منع کرتے ہوئے فرمایا ہے کہ ہر نشہ آور چیز حرام ہے ، میں نے پوچھا کہ """" مزفت """" سے کیا مراد ہے آ انہوں نے فرمایا لک لگایا ہوا برتن ، میں نے پوچھا کہ شیشی اور بوتل کا کیا حکم ہے آ انہوں نے فرمایا کہ ان دونوں میں کوئی حرج نہیں ، میں نے کہا کہ لوگ تو انہیں اچھا نہیں سمجھتے آ انہوں نے فرمایا کہ پھر جس چیز میں تمہیں شک ہو ، اسے چھوڑ کر وہ چیز اختیار کر لو جس میں تمہیں کوئی شک نہ ہو ، کیونکہ ہر نشہ آور چیز حرام ہے ، میں نے عرض کیا کہ آپ نے بجا فرمایا کہ نشہ حرام ہے ، لیکن کھانے کے بعد ایک دو گھونٹ پی لینے کا کیا حکم ہے آ فرمایا نشہ آور چیز خواہ تھوڑی ہو یا زیادہ ، حرام ہے ، اور فرمایا کہ شراب انگور سے بھی بنتی ہے ، کھجور ، شہد ، گندم ، جو اور مکئی سے بھی بنتی ہے ، ان میں سے جس چیز سے بھی بنے ، وہ بہر حال شراب ہے ۔"
"12124","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب قضاء حاجت کے لئے جاتے تو میں پانی پیش کرتا تھا اور نبی ﷽ اس سے استنجاء فرماتے تھے ۔"
"12125","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا لشکر میں ابوطلحہ رضی اللہ عنہ کی آواز ہی کئی لوگوں سے بہتر ہے ۔"
"12126","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے اپنے اہل و عیال پر نبی ﷽ سے بڑھ کر کسی کو شفیق نہیں پایا ، حضرت ابراہیم رضی اللہ عنہ عوالی مدینہ میں دودھ پیتے بچے تھے ، نبی ﷽ انہیں ملنے جایا کرتے تھے ، ہم بھی نبی ﷽ کے ساتھ ہوتے ، نبی ﷽ جب اس گھر میں داخل ہوتے تو وہ دھوئیں سے بھرا ہوتا تھا کیونکہ خاتون خانہ کا شوہر لوہار تھا ، نبی ﷽ انہیں پکڑ کر پیار کرتے اور کچھ دیر بعد واپس آ جاتے ، جب حضرت ابراہیم رضی اللہ عنہ کی وفات ہو گئی تو نبی ﷽ نے فرمایا ابراہیم میرا بیٹا تھا ، جو بچپن میں ہی فوت ہو گیا ، اس کے لئے دو دائیاں مقرر کی گئی ہیں جو جنت میں اس کی مدت رضاعت کی تکمیل کریں گی ۔"
"12127","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میرے ایک چچا نے ایک مرتبہ نبی ﷽ کی کھانے پر دعوت کی ، اور عرض کیا یا رسول اللہ ﷽ ! میری خواہش ہے کہ آپ میرے گھر میں کھانا کھائیں اور اس میں نماز بھی پڑھیں ، چنانچہ نبی ﷽ تشریف لائے ، وہاں گھر میں ایک چٹائی پڑی ہوئی تھی جو پرانی ہو کر کالی ہو چکی تھی ، نبی ﷽ نے اسے ایک کونے میں رکھنے کا حکم دیا ، اسے جھاڑا گیا اور اس پر پانی چھڑک دیا گیا ، پھر نبی ﷽ نے وہاں نماز پڑھی اور ہم نے بھی نبی ﷽ کے ساتھ نماز پڑھی ۔"
"12128","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا لوگوں کو کیا ہو گیا ہے کہ دورانْ نماز آسمان کی طرف نگاہیں اٹھا کر دیکھتے ہیں آ نبی ﷽ نے شدت سے اس کی ممانعت کرتے ہوئے فرمایا کہ لوگ اس سے باز آ جائیں ورنہ ان کی بصارت اچک لی جائے گی ۔"
"12129","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور ان کی اہلیہ محترمہ ایک ہی برتن سے غسل کر لیا کرتے تھے ، نبی ﷽ پانچ مکوک پانی سے غسل اور ایک مکوک پانی سے وضو فرما لیا کرتے تھے ۔"
"12130","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ احد پہاڑ پر چڑھے ، آپ ﷽ کے پیچھے پیچھے حضرت ابوبکر و عمر و عثمان رضی اللہ عنہم بھی تھے ، ایک دم پہاڑ ہلنے لگا ، نبی ﷽ نے اسے فرمایا اے پہاڑ ! تھم جا کہ تجھ پر ایک نبی ، ایک صدیق اور دو شہید ہیں ۔"
"12131","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ بکثرت یہ دعاء مانگا کرتے تھے کہ اے دلوں کو پھیرنے والے ، میرے دل کو اپنے دین پر ثابت قدمی عطاء فرما ، ایک مرتبہ ہم نے عرض کیا یا رسول اللہ ﷽ ! ہم آپ پر اور آپ کی تعلیمات پر ایمان لائے ہیں ، کیا آپ کو ہمارے متعلق کسی چیز سے خطرہ ہے آ نبی ﷽ نے فرمایا ہاں ! کیونکہ دل اللہ کی انگلیوں میں سے صرف دو انگلیوں کے درمیان ہیں ، وہ جیسے چاہتا ہے انہیں بدل دیتا ہے ۔"
"12132","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ حنین کے دن حضرت ابوطلحہ رضی اللہ عنہ نبی ﷽ کو ہنسانے کے لئے آئے اور عرض کیا یا رسول اللہ ! ام سلیم کو تو دیکھیں کہ ان کے پاس خنجر ہے ، نبی ﷽ نے ان سے پوچھا کہ اے ام سلیم ! تم اس کا کیا کرو گی آ انہوں نے کہا کہ اگر کوئی مشرک میرے قریب آیا تو میں اس سے اس کا پیٹ پھاڑ دوں گی ۔"
"12133","بشیر بن یسار رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ ہم نے حضرت انس رضی اللہ عنہ سے عرض کیا کہ آپ کو دور نبوت کے حالات سے ہمارے حالات میں کیا تبدیلی محسوس ہوتی ہے آ انہوں نے فرمایا کہ مجھے یہ چیز بہت عجیب لگتی ہے کہ تم لوگ صفیں سیدھی نہیں رکھتے ۔"
"12134","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص میری طرف جان بوجھ کر کسی جھوٹی بات کی نسبت کرے ، اسے اپنا ٹھکانہ جہنم میں بنا لینا چاہئے ۔"
"12135","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم لوگ جب نبی ﷽ کے ساتھ کسی سفر میں ہوتے تو کہتے تھے کہ زوال شمس ہو گیا یا نہیں ، نبی ﷽ ظہر پڑھ کر کوچ فرماتے تھے ۔"
"12136","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک دن حضرت جبریل علیہ السلام ، نبی ﷽ کی خدمت میں حاضر ہوئے ، نبی ﷽ اس وقت غمگین بیٹھے تھے اور خون میں لت پت تھے ، کچھ اہل مکہ نے آپ ﷽ کو مارا تھا ، حضرت جبریل علیہ السلام نے پوچھا کہ آپ کو کیا ہوا آ نبی ﷽ نے فرمایا ان لوگوں نے میرے ساتھ یہ سلوک کیا ہے ، حضرت جبریل علیہ السلام نے عرض کیا کہ کیا آپ چاہیں گے کہ میں آپ کو ایک معجزہ دکھااں آ نبی ﷽ نے اثبات میں جواب دیا ، حضرت جبریل علیہ السلام نے وادی کے پیچھے ایک درخت کی طرف دیکھا اور کہا کہ اس درخت کو بلائیے ، نبی ﷽ نے اسے آواز دی تو وہ چلتا ہوا آیا اور نبی ﷽ کے سامنے کھڑا ہو گیا ، حضرت جبریل علیہ السلام نے عرض کیا کہ اب اسے واپس جانے کا حکم دیجئے ، نبی ﷽ نے اسے حکم دیا تو وہ واپس چلا گیا ، یہ دیکھ کر نبی ﷽ نے فرمایا میرے لیے یہی کافی ہے ۔"
"12137","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ یہ دعاء کیا کرتے تھے کہ اے اللہ ! میں لاچاری ، سستی ، بزدلی ، بڑھاپے ، بخل اور عذاب قبر سے آپ کی پناہ میں آتا ہوں اور زندگی اور موت کی آزمائش سے آپ کی پناہ میں آتا ہوں ۔"
"12138","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے خطبہ دیتے ہوئے ہمیں خبر دی کہ زید نے جھنڈا پکڑا لیکن شہید ہو گئے ، پھر جعفر نے پکڑا لیکن وہ بھی شہید ہو گئے ، پھر عبداللہ بن رواحہ نے اسے پکڑا لیکن وہ بھی شہید ہو گئے ، پھر خالد نے کسی سالاری کے بغیر جھنڈا پکڑا اور اللہ نے ان کے ہاتھ پر مسلمانوں کو فتح عطاء فرمائی ، اور مجھے اس بات کی خوشی نہیں ہے کہ وہ ہمارے پاس ہی رہتے ۔"
"12139","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ہمیں حکم دیا ہے کہ اہل کتاب کے سلام کے جواب میں """" وعلیکم """" سے زیادہ کچھ نہ کہیں ۔"
"12140","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی ساری نمازیں قریب قریب برابر ہوتی تھیں ، اسی طرح حضرت ابوبکر صدیق رضی اللہ عنہ کی نمازیں بھی ، لیکن حضرت عمر رضی اللہ عنہ نے فجر کی نماز طویل کرنا شروع فرمائی ۔"
"12141","ابن سیرین رحمۃ اللہ کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے پوچھا کہ نبی ﷽ نے قنوت نازلہ پڑھی ہے آ انہوں نے فرمایا ہاں ! رکوع کے بعد ، دوبارہ یہی سوال ہوا کہ نماز فجر میں قنوت نازلہ پڑھی ہے آ تو فرمایا ہاں ! کچھ عرصے کے لئے رکوع کے بعد پڑھی ہے ۔"
"12142","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے بال نصف کان تک ہوتے تھے ۔"
"12143","حضرت انس رضی اللہ عنہ سے مروی ہے کسی شخص نے نبی ﷽ سے نماز فجر کا وقت پوچھا تو نبی ﷽ نے حضرت بلال رضی اللہ عنہ کو طلوع فجر کے وقت حکم دیا اور نماز کھڑی کر دی ، پھر اگلے دن خوب روشنی میں کر کے نماز پڑھائی ، اور فرمایا نماز فجر کا وقت پوچھنے والا کہاں ہے آ ان دو وقتوں کے درمیان نماز فجر کا وقت ہے ۔"
"12144","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے عیدالاضحی کے دن فرمایا کہ جس شخص نے نماز سے پہلے قربانی کر لی ہو ، اسے دوبارہ قربانی کرنی چاہئے ، ایک آدمی یہ سن کر کھڑا ہوا اور کہنے لگا یا رسول اللہ ﷽ ! یہ دن ایسا ہے جس میں لوگوں کو عام طور پر گوشت کی خواہش ہوتی ہے ، پھر اس نے اپنے کسی پڑوسی کے اس معاملے کا تذکرہ کیا تو ایسا محسوس ہوا کہ نبی ﷽ اس کی تصدیق کر رہے ہیں ، پھر اس نے کہا کہ میرے پاس ایک چھ ماہ کا بچہ ہے ، جو مجھے دو بکریوں کے گوشت سے بھی زیادہ محبوب ہے ، نبی ﷽ نے اسے اس ہی کی قربانی کرنے کی اجازت دے دی ، اب مجھے نہیں معلوم کہ یہ اجازت دوسروں کے لئے بھی ہے یا نہیں ، پھر نبی ﷽ اپنے دو مینڈھوں کی طرف متوجہ ہوئے اور انہیں ذبح فرمایا ، لوگ """" مال غنیمت """" کے انتظار میں کھڑے تھے ، سو انہوں نے اسے تقسیم کر لیا ۔"
"12145","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے دودھ نوش فرمایا ، نبی ﷽ کے دائیں جانب ایک دیہاتی تھا ، اور بائیں جانب حضرت ابوبکر صدیق رضی اللہ عنہ تھے ، نبی ﷽ نے دودھ کا وہ برتن دیہاتی کو دے دیا اور فرمایا پہلے دائیں ہاتھ والے کو ، پھر اس کے بعد والے کو ۔"
"12146","نوفل بن مسعود رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ ہم لوگ حضرت انس رضی اللہ عنہ کی خدمت میں حاضر ہوئے اور ان سے عرض کیا کہ ہمیں کوئی ایسی حدیث سنائیے ، جو آپ نے نبی ﷽ سے خود سنی ہو ، انہوں نے کہا کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے تین چیزیں چیزیں ایسی ہیں کہ جس آدمی میں ہوں ، وہ جہنم کی آگ پر حرام ہو گا اور جہنم کی آگ اس پر حرام ہو گی ، اللہ پر ایمان ، اللہ سے محبت اور آگ میں گر کر جل جانا کفر کی طرف لوٹ کر جانے سے زیادہ محبوب ہو ۔"
"12147","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ مدینہ منورہ میں بنو نجار کے کسی باغ میں تشریف لے گئے ، وہاں کسی قبر سے آواز سنائی دی ، نبی ﷽ نے اس کے متعلق دریافت فرمایا کہ اس قبر میں مردے کو کب دفن کیا گیا تھا لوگوں نے بتایا کہ یا رسول اللہ ﷽ ! یہ شخص زمانہ جاہلیت میں دفن ہوا تھا ، نبی ﷽ نے فرمایا اگر تم لوگ اپنے مردوں کو دفن کرنا چھوڑ نہ دیتے تو میں اللہ سے یہ دعاء کرتا کہ وہ تمہیں بھی عذاب قبر کی آواز سنا دے ۔"
"12148","بشیر بن یسار رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ ہم نے حضرت انس رضی اللہ عنہ سے عرض کیا کہ آپ کو دور نبوت کے حالات سے ہمارے حالات میں کیا تبدیلی محسوس ہوتی ہے آ انہوں نے فرمایا کہ مجھے یہ چیز بہت عجیب لگتی ہے کہ تم لوگ صفیں سیدھی نہیں رکھتے ۔"
"12149","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا گھوڑوں کی پیشانیوں میں برکت رکھ دی گئی ہے ۔"
"12150","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا بات سنتے اور مانتے رہو ، خواہ تم پر ایک حبشی """" جس کا سر کشمش کی طرح ہو """" گورنر بنا دیا جائے ۔"
"12151","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ایک آدمی کو اپنے دو بیٹوں کے کندھوں کا سہارا لے کر چلتے ہوئے دیکھا تو پوچھا یہ کیا ماجرا ہے آ انہوں نے بتایا کہ انہوں نے پیدل چل کر حج کرنے کی منت مانی تھی ، نبی ﷽ نے فرمایا اللہ اس بات سے غنی ہے کہ یہ شخص اپنے آپ کو تکلیف میں مبتلاء کرے ، پھر آپ ﷽ نے اسے سوار ہونے کا حکم دیا ، چنانچہ وہ سوار ہو گیا ۔"
"12152","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کا وقت ہو گیا ، نبی ﷽ ایک آدمی کے ساتھ مسجد میں تنہائی میں گفتگو فرما رہے تھے ، حتیٰ کہ کچھ لوگ اونگھنے لگے ۔"
"12153","حمید کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے نبی ﷽ کی رات کی نماز کے متعلق پوچھا تو انہوں نے فرمایا کہ ہم رات کے جس وقت نبی ﷽ کو نماز پڑھتے ہوئے دیکھنا چاہتے تھے ، دیکھ سکتے تھے اور جس وقت سوتا ہوا دیکھنے کا ارادہ ہوتا تو وہ بھی دیکھ لیتے تھے ۔"
"12154","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ جنت البقیع میں تھے ، کہ ایک آدمی نے """" ابوالقاسم """" کہہ کر کسی کو آواز دی ، نبی ﷽ نے پیچھے مڑ کر دیکھا تو اس نے کہا کہ میں آپ کو نہیں مراد لے رہا ، اس پر نبی ﷽ نے فرمایا میرے نام پر تو اپنا نام رکھ لیا کرو ، لیکن میری کنیت پر اپنی کنیت نہ رکھا کرو ۔"
"12155","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے غزوہ حنین کے دن اعلان فرما دیا کہ جو شخص کسی کافر کو قتل کرے گا ، اس کا ساز و سامان اسی کو ملے گا ، چنانچہ حضرت ابوطلحہ رضی اللہ عنہ نے بیس آدمیوں کو قتل کیا ۔"
"12156","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ دور نبوت میں ایک دیہاتی نے آ کر مسجد نبوی میں پیشاب کر دیا ، لوگوں نے اسے روکا تو نبی ﷽ نے فرمایا اسے چھوڑ دو ، اور حکم دیا کہ اس پر پانی کا ایک ڈول بہا دو ۔"
"12157","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ تین سانسوں میں پانی پیا کرتے تھے ، خود حضرت انس رضی اللہ عنہ بھی تین سانس لیتے تھے ۔"
"12158","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک انصاری ، نبی ﷽ کی خدمت میں حاضر ہوا اور اپنی تنگدستی کی شکایت کی ، نبی ﷽ نے اس سے فرمایا کہ تمہارے پاس کچھ ہے آ وہ ایک پیالہ اور ایک ٹاٹ لے آیا ، نبی ﷽ نے فرمایا یہ کون خریدے گا آ ایک آدمی نے کہا کہ میں ایک درہم میں یہ دونوں چیزیں خریدتا ہوں ، نبی ﷽ نے فرمایا ایک درہم سے زیادہ کون دے گا آ لوگ خاموش رہے ، نبی ﷽ نے پھر اپنا اعلان دہرایا ، اس پر ایک آدمی کہنے لگا کہ میں دو درہم میں یہ دونوں چیزیں خریدتا ہوں ، نبی ﷽ نے فرمایا یہ دونوں چیزیں تمہاری ہوئیں ، پھر فرمایا سوال کرنا صرف تین میں سے کسی ایک صورت میں حلال ہے ، وہ آدمی جو مرنے کے قریب ہو ، وہ قرض جو ہلا دینے والا ہو اور وہ فقر و فاقہ جو خاک نشین کر دے ۔"
"12159","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور خلفاء ثلاثہ رضی اللہ عنہم نماز میں قراءت کا آغاز """" ®الحمدللہ رب العلمین¾ """" سے کرتے تھے ۔"
"12160","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم لوگ نبی ﷽ کے ساتھ مغرب کی نماز پڑھتے تھے ، پھر ہم میں سے کوئی شخص بنو سلمہ کے پاس جاتا تو اس وقت بھی وہ اپنا تیر گرنے کی جگہ کو بخوبی دیکھ سکتا تھا ۔"
"12161","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوطلحہ رضی اللہ عنہ کا ایک بیٹا """" جس کا نام ابوعمیر تھا """" نبی ﷽ اس کے ساتھ ہنسی مذاق کیا کرتے تھے ، ایک دن نبی ﷽ نے اسے غمگین دیکھا تو فرمایا اے ابوعمیر ! کیا کیا نغیر + چڑیا ، جو مر گئی تھی ,"
"12162","حمید رحمۃ اللہ کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے پھلوں کی بیع کے متعلق پوچھا تو انہوں نے جواب دیا کہ نبی ﷽ نے پھل پکنے سے پہلے ان کی بیع سے منع فرمایا ہے ۔"
"12163","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے شراب نوشی کی سزا میں ٹہنیوں اور جوتوں سے مارا ہے ، حضرت ابوبکر صدیق رضی اللہ عنہ نے + چالیس کوڑے , مارے ہیں ، لیکن جب حضرت عمر فاروق رضی اللہ عنہ کے دور خلافت میں لوگ مختلف شہروں اور بستیوں کے قریب ہوئے + اور ان میں وہاں کے اثرات آنے لگے , تو حضرت عمر رضی اللہ عنہ نے اپنے ساتھیوں سے پوچھا کہ اس کے متعلق تمہاری کیا رائے ہے آ حضرت عبدالرحمن بن عوف رضی اللہ عنہ نے یہ رائے دی کہ سب سے کم درجے کی حد کے برابر اس کی سزا مقرر کر دیجئے ، چنانچہ حضرت عمر رضی اللہ عنہ نے شراب نوشی کی سزا اسی کوڑے مقرر کر دی ۔"
"12164","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نبی ﷽ کے پاس خیبر میں آیا اور دو مرتبہ کہا کہ میں نے گدھوں کا گوشت کھایا ہے ، پھر آیا تو کہنے لگا کہ میں نے گدھے ختم کر دیئے ہیں ، اس پر نبی ﷽ نے منادی کرا دی کہ اللہ اور اس کے رسول تمہیں گدھوں کے گوشت سے منع کرتے ہیں کیونکہ ان کا گوشت ناپاک ہے ۔"
"12165","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ صحابہ کرام رضی اللہ عنہم نے نبی ﷽ سے یہ مسئلہ پوچھا کہ اہل کتاب ہمیں سلام کرتے ہیں ، ہم انہیں کیا جواب دیں آ نبی ﷽ نے فرمایا صرف """" وعلیکم """" کہہ دیا کرو ۔"
"12166","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا انسان تو بوڑھا ہو جاتا ہے لیکن دو چیزیں اس میں ہمیشہ رہتی ہیں ، ایک حرص اور ایک امید ۔"
"12167","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ بدر کے دن نبی ﷽ نے ارشاد فرمایا کون جا کر دیکھے گا کہ ابوجہل کا کیا بنا آ حضرت ابن مسعود رضی اللہ عنہ اس خدمت کے لئے چلے گئے ، انہوں نے دیکھا کہ عفراء کے دونوں بیٹوں نے اسے مار مار کر ٹھنڈا کر دیا ہے ، حضرت ابن مسعود رضی اللہ عنہ نے ابوجہل کی ڈاڑھی پکڑ کر فرمایا کیا تو ہی ابوجہل ہے آ اس نے کہا کیا تم نے مجھ سے بڑے بھی کسی آدمی کو قتل کیا ہے آ"
"12168","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب یہ آیت نازل ہوئی کہ """" تم نیکی کے اعلیٰ درجے کو اس وقت تک حاصل نہیں کر سکتے جب تک اپنی پسندیدہ چیز خرچ نہ کرو """" اور یہ آیت کہ """" کون ہے جو اللہ کو قرض حسنہ دیتا ہے """" تو حضرت ابوطلحہ رضی اللہ عنہ کہنے لگے یا رسول اللہ ! میرا فلاں باغ جو فلاں جگہ پر ہے ، وہ اللہ کے نام پر دیتا ہوں اور بخدا ! اگر یہ ممکن ہوتا کہ میں اسے مخفی رکھوں تو کبھی اس کا پتہ بھی نہ لگنے دیتا ، نبی ﷽ نے فرمایا اسے اپنے خاندان کے فقراء میں تقسیم کر دو ۔"
"12169","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا دجال کی بائیں آنکھ کانی ہو گی ، اس پر موٹی پھلی ہو گی ، اور اس کی دونوں آنکھوں کے درمیان """" کافر """" لکھا ہو گا ۔"
"12170","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا لوگوں کو کیا ہو گیا ہے کہ دوران نماز آسمان کی طرف نگاہیں اٹھا کر دیکھتے ہیں آ نبی ﷽ نے شدت سے اس کی ممانعت کرتے ہوئے فرمایا کہ لوگ اس سے باز آ جائیں ورنہ ان کی بصارت اچک لی جائے گی ۔"
"12171","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دو چتکبرے سینگ دار مینڈھے قربانی میں پیش کیا کرتے تھے ، اور اللہ کا نام لے کر تکبیر کہتے تھے ، میں نے دیکھا ہے کہ نبی ﷽ انہیں اپنے ہاتھ سے ذبح کرتے تھے اور ان کے پہلو پر اپنا پااں رکھتے تھے ۔"
"12172","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا رکوع و سجود کو مکمل کیا کرو ، کیونکہ میں بخدا تمہیں اپنی پشت کے پیچھے سے بھی دیکھ رہا ہوتا ہوں ۔"
"12173","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا سجدوں میں اعتدال برقرار رکھا کرو ، اور تم میں سے کوئی شخص کتے کی طرح اپنے ہاتھ نہ بچھائے ۔"
"12174","حضرت انس رضی اللہ عنہ سے مروی ہے کہ آپ ﷽ نے ایک مہینے تک فجر کی نماز میں رکوع کے بعد قنوت نازلہ پڑھی اور عرب کے کچھ قبائل پر بددعاء کرتے رہے پھر اسے ترک کر دیا ۔"
"12175","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا میں جنت میں داخل ہوا تو اچانک ایک نہر پر نظر پڑی جس کے دونوں کناروں پر موتیوں کے خیمے لگے ہوئے تھے ، میں نے اس میں ہاتھ ڈال کر پانی میں بہنے والی چیز کو پکڑا تو وہ مہکتی ہوئی مشک تھی ، میں نے جبریل علیہ السلام سے پوچھا کہ یہ کیا ہے آ تو انہوں نے بتایا کہ یہ نہر کوثر ہے جو اللہ نے آپ کو عطاء فرمائی ہے ۔"
"12176","حضرت انس رضی اللہ عنہ سے مروی ہے کہ آپ ﷽ نے ایک مہینے تک فجر کی نماز میں رکوع کے بعد قنوت نازلہ پڑھی اور رعل ، ذکوان کے قبائل پر بددعاء کرتے رہے اور فرمایا کہ عصیہ نے اللہ اور اس کے رسول کی نافرمانی کی ہے ۔"
"12177","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قیامت کے دن سارے مسلمان اکٹھے ہوں گے ، ان کے دل میں یہ بات ڈالی جائے گی اور وہ کہیں گے کہ اگر ہم اپنے پروردگار کے سامنے کسی کی سفارش لے کر جائیں تو شاید وہ ہمیں اس جگہ سے راحت عطاء فرما دے ، چنانچہ وہ حضرت آدم علیہ السلام کے پاس جائیں اور ان سے کہیں گے کہ اے آدم ! آپ ابوالبشر ہیں ، اللہ تعالیٰ نے آپ کو اپنے ہاتھ سے پیدا کیا ، اپنے فرشتوں سے آپ کو سجدہ کروایا ، اور آپ کو تمام چیزوں کے نام سکھائے ، لہٰذا آپ ہمارے رب سے سفارش کر دیں کہ وہ ہمیں اس جگہ سے نجات دے دے ۔ حضرت آدم علیہ السلام جواب دیں گے کہ میں تو اس کا اہل نہیں ہوں اور انہیں اپنی لغزش یاد آ جائے گی اور وہ اپنے رب سے حیاء کریں گے اور فرمائیں گے کہ تم حضرت نوح علیہ السلام کے پاس چلے جاا ، کیونکہ وہ پہلے رسول ہیں جنہیں اللہ نے اہل زمین کی طرف بھیجا تھا ، چنانچہ وہ سب لوگ حضرت نوح علیہ السلام کے پاس جائیں گے اور ان سے کہیں گے کہ آپ اپنے پروردگار سے ہماری سفارش کر دیجئے ، وہ جواب دیں گے کہ تمہارا گوہر مقصود میرے پاس نہیں ہے ، تم حضرت ابراہیم علیہ السلام کے پاس چلے جاا ، کیونکہ اللہ نے انہیں اپنا خلیل قرار دیا ہے ۔ چنانچہ وہ سب لوگ حضرت ابراہیم علیہ السلام کے پاس جائیں گے ، لیکن وہ بھی یہی کہیں گے کہ تمہارا گوہر مقصود میرے پاس نہیں ہے ، البتہ تم حضرت موسیٰ علیہ السلام کے پاس چلے جاا ، کیونکہ اللہ نے ان سے براہ راست کلام فرمایا ہے ، اور انہیں تورات دی تھی ، حضرت موسیٰ علیہ السلام بھی معذرت کر لیں گے کہ میں نے ایک شخص کو ناحق قتل کر دیا تھا البتہ تم حضرت عیسیٰ علیہ السلام کے پاس چلے جاا ، وہ اللہ کے بندے ، اس کے رسول اور اس کا کلمہ اور روح تھے لیکن حضرت عیسیٰ علیہ السلام بھی معذرت کر لیں گے اور فرمائیں گے کہ تم محمد ﷽ کے پاس جاا ، وہ تمہاری سفارش کریں گے ، جن کی اگلی پچھلی لغزشیں اللہ نے معاف فرما دی ہیں ۔ نبی ﷽ فرماتے ہیں کہ میں اپنے پروردگار کے پاس حاضری کی اجازت چاہوں گا جو مجھے مل جائے گی ، میں اپنے رب کو دیکھ کر سجدہ ریز ہو جااں گا ، اللہ جب تک چاہے گا مجھے سجدے ہی کی حالت میں رہنے دے گا ، پھر مجھ سے کہا جائے گا کہ اے محمد ! ﷽ ! سر تو اٹھائیے ، آپ جو کہیں گے اس کی شنوائی ہو گی ، جو مانگیں گے وہ ملے گا اور جس کی سفارش کریں گے قبول کر لی جائے گی ، چنانچہ میں اپنا سر اٹھا کر اللہ کی ایسی تعریف کروں گا جو وہ خود مجھے سکھائے گا ، پھر میں سفارش کروں گا تو اللہ میرے لیے ایک حد مقرر فرما دے گا اور میں انہیں جنت میں داخل کروا کر دوبارہ آاں گا ، تین مرتبہ اسی طرح ہو گا ، چوتھی مرتبہ میں کہوں گا کہ پروردگار ! اب صرف وہی لوگ باقی بچے ہیں جنہیں قرآن نے روک رکھا ہے ۔ چنانچہ جہنم سے ہر اس شخص کو نکال لیا جائے گا جو لا الہ الا اللہ کہتا ہو اور اس کے دل میں جو کے دانے کے برابر بھی خیر موجود ہو ، پھر جہنم سے ہر اس شخص کو نکال لیا جائے گا جو لا الہ الا اللہ کہتا ہو اور اس کے دل میں گندم کے دانے کے برابر بھی خیر موجود ہو ، نیز جہنم سے ہر اس شخص کو نکال لیا جائے گا جو لا الہ الا اللہ کہتا ہو اور اس کے دل میں ایک ذرے کے برابر بھی خیر موجود ہو ۔"
"12178","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص میری طرف جان بوجھ کر کسی جھوٹی بات کی نسبت کرے ، اسے اپنا ٹھکانہ جہنم میں بنا لینا چاہئے یہ بات دو مرتبہ فرمائی ۔"
"12179","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا لوگوں کو کیا ہو گیا ہے کہ دورانْ نماز آسمان کی طرف نگاہیں اٹھا کر دیکھتے ہیں آ نبی ﷽ نے شدت سے اس کی ممانعت کرتے ہوئے فرمایا کہ لوگ اس سے باز آ جائیں ورنہ ان کی بصارت اچک لی جائے گی ۔"
"12180","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور ان کی اہلیہ محترمہ ایک ہی برتن سے غسل کر لیا کرتے تھے ۔ اور نبی ﷽ پانچ مکوک پانی سے غسل اور ایک مکوک پانی سے وضو فرما لیا کرتے تھے ۔"
"12181","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ تعالیٰ نے ماں کے رحم پر ایک فرشتہ مقرر کر رکھا ہے ، جو اپنے اپنے وقت پر یہ کہتا رہتا ہے کہ پروردگار ! اب نطفہ بن گیا ، پروردگار ! اب گوشت کی بوٹی بن گیا ، پھر جب اللہ اسے پیدا کرنے کا ارادہ کرتا ہے تو وہ پوچھتا ہے کہ پروردگار ! یہ شقی ہو گا یا سعید آ مذکر ہو گا یا مونث آ رزق کتنا ہو گا آ اور عمر کتنی ہو گی آ یہ سب چیزیں ماں کے پیٹ میں ہی لکھ لی جاتی ہیں ۔"
"12182","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"12183","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ + حضرت عائشہ رضی اللہ عنہا کی باندی , بریرہ کے پاس صدقہ کی کوئی چیز آئی ، تو نبی ﷽ نے فرمایا یہ اس کے لئے صدقہ ہے اور ہمارے لئے ہدیہ ہے ۔"
"12184","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ مجھے تو مسلمان پر تعجب ہوتا ہے کہ اللہ اس کے لئے جو فیصلہ بھی فرماتا ہے وہ اس کے حق میں بہتر ہی ہوتا ہے ۔"
"12185","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے جانور کو باندھ کر اس پر نشانہ درست کرنے سے منع فرمایا ہے ۔"
"12186","حضرت انس رضی اللہ عنہ سے مروی ہے کہ تم پر جو وقت بھی آئے گا ، وہ پہلے سے بدترین ہی ہو گا ، ہم نے تمہارے پیغمبر ﷽ سے یوں ہی سنا ہے ۔"
"12187","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا قیامت کے دن ہر فقیر اور مالدار کی تمنا یہی ہو گی کہ اسے دنیا میں بقدر گذارہ دیا گیا ہوتا ۔"
"12188","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے مجھے """" اے دو کانوں والے """" کہہ کر مخاطب فرمایا تھا ۔"
"12189","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ام سلیم رضی اللہ عنہا دوران سفر ازواج مطہرات کے ساتھ تھیں ، ایک آدمی """" جس کا نام انجشہ تھا """" ان کی سواریوں کو ہانک رہا تھا ، ان کے پاس آ کر نبی ﷽ نے فرمایا انجشہ ! ان آبگینوں کو آہستہ لے کر چلو ۔"
"12190","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ یہ دعاء کیا کرتے تھے کہ اے اللہ ! میں لاچاری ، سستی ، بزدلی ، بڑھاپے ، بخل اور عذاب قبر سے آپ کی پناہ میں آتا ہوں اور زندگی اور موت کی آزمائش سے آپ کی پناہ میں آتا ہوں ۔"
"12191","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کی مجلس میں دو آدمیوں کو چھینک آئی ، نبی ﷽ نے ان میں سے ایک کو اس کا جواب + یرحمک اللہ کہہ کر , دے دیا اور دوسرے کو چھوڑ دیا ، کسی نے پوچھا کہ دو آدمیوں کو چھینک آئی ، آپ نے ان میں سے ایک کو جواب دیا ، دوسرے کو کیوں نہ دیا آ فرمایا کہ اس نے ®الحمدللہ¾ کہا تھا اور دوسرے نے نہیں کہا تھا ۔"
"12192","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اللہ تعالیٰ بندے سے صرف اتنی بات پر بھی راضی ہو جاتے ہیں کہ وہ کوئی لقمہ کھا کر یا پانی کا گھونٹ پی کر اللہ کا شکر ادا کر دے ۔"
"12193","حضرت انس رضی اللہ عنہ سے مروی ہے کہ دنیا سے رخصتی کے وقت نبی ﷽ کی عمومی وصیت نماز اور غلاموں کا خیال رکھنے سے متعلق ہی تھی ، حتیٰ کہ جب غرغرہ کی کیفیت طاری ہوئی تب بھی آپ ﷽ کی زبان مبارک پر یہی الفاظ جاری تھے ۔"
"12194","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص تین مرتبہ جہنم سے پناہ مانگ لے ، جہنم خود کہتی ہے کہ اے اللہ ! اس بندے کو مجھ سے بچا لے ، اور جو شخص تین مرتبہ جنت کا سوال کر لے تو جنت خود کہتی ہے کہ اے اللہ ! اس بندے کو مجھ میں داخلہ عطاء فرما ۔"
"12195","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے عیدالاضحی کے دن فرمایا کہ جس شخص نے نماز سے پہلے قربانی کر لی ہو ، اسے دوبارہ قربانی کرنی چاہئے ، ایک آدمی یہ سن کر کھڑا ہوا اور کہنے لگا یا رسول اللہ ﷽ ! یہ دن ایسا ہے جس میں لوگوں کو عام طور پر گوشت کی خواہش ہوتی ہے ، پھر اس نے اپنے کسی پڑوسی کے اس معاملے کا تذکرہ کیا تو ایسا محسوس ہوا کہ نبی ﷽ اس کی تصدیق کر رہے ہیں ، پھر اس نے کہا کہ میرے پاس ایک چھ ماہ کا بچہ ہے جو مجھے دو بکریوں کے گوشت سے بھی زیادہ محبوب ہے ، نبی ﷽ نے اسے اس ہی کی قربانی کرنے کی اجازت دے دی ، اب مجھے نہیں معلوم کہ یہ اجازت دوسروں کے لئے بھی ہے یا نہیں ، پھر نبی ﷽ اپنے دو مینڈھوں کی طرف متوجہ ہوئے اور انہیں ذبح فرمایا ، لوگ """" مال غنیمت """" کے انتظار میں کھڑے تھے ، سو انہوں نے اسے تقسیم کر لیا ۔"
"12196","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے خطبہ دیتے ہوئے ہمیں خبر دی کہ زید نے جھنڈا پکڑا لیکن شہید ہو گئے ، پھر جعفر نے پکڑا لیکن وہ بھی شہید ہو گئے ، پھر عبداللہ بن رواحہ نے اسے پکڑا لیکن وہ بھی شہید ہو گئے ، پھر خالد نے کسی سالاری کے بغیر جھنڈا پکڑا اور اللہ نے ان کے ہاتھ پر مسلمانوں کو فتح عطاء فرمائی ، اور انہیں اس بات کی خوشی نہیں ہے کہ وہ ہمارے پاس ہی رہتے اس وقت نبی ﷽ کی آنکھوں سے آنسو بہہ رہے تھے ۔"
"12197","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے نظر بد ، ڈنک اور نملہ + جس بیماری میں پسلی دانوں سے بھر جاتی ہے , کے لئے جھاڑ پھونک کی اجازت دی ہے ۔"
"12198","[Darussalam 12174] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12199","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے بال کندھوں تک آتے تھے ۔"
"12200","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی خدمت میں جب خوشبو پیش کی جاتی تو آپ ﷽ اسے رد نہ فرماتے تھے ۔"
"12201","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب کسی کے یہاں روزہ افطار کرتے تو فرماتے تمہارے یہاں روزہ داروں نے روزہ کھولا ، نیکوں نے تمہارا کھانا کھایا اور رحمت کے فرشتوں نے تم پر نزول کیا ۔"
"12202","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مسجد نبوی ﷽ کی جگہ دراصل بنونجار کی تھی ، یہاں ایک درخت اور مشرکین کی چند قبریں ہوا کرتی تھیں ، نبی ﷽ نے بنو نجار سے فرمایا کہ میرے ساتھ اس کی قیمت طے کر لو ، انہوں نے عرض کیا کہ ہم اس کی قیمت نہیں لیں گے ، مسجد نبوی کی تعمیر میں نبی ﷽ خود بھی شریک تھے ، لوگ نبی ﷽ کو اینٹیں پکڑاتے تھے ، اور نبی ﷽ فرماتے جا رہے تھے کہ اصل زندگی تو آخرت کی ہے ، اے اللہ ! انصار اور مہاجرین کی مغفرت فرما اور مسجد نبوی کی تعمیر سے پہلے جہاں بھی نماز کا وقت ہو جاتا ، نبی ﷽ ویہیں نماز پڑھ لیتے ۔"
"12203","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا بدشگونی کی کوئی حیثیت نہیں ، البتہ مجھے فال یعنی اچھا اور پاکیزہ کلمہ اچھا لگتا ہے ۔"
"12204","مروی ہے کہ ایک مرتبہ حضرت انس رضی اللہ عنہ کے سامنے ایک مرد کا جنازہ لایا گیا ، وہ اس کی چارپائی کے سرہانے کھڑے ہوئے اور عورت کا جنازہ لایا گیا تو چارپائی کے سامنے اس سے نیچے ہٹ کر کھڑے ہوئے ، نماز جنازہ سے جب فارغ ہوئے تو علاء بن زیاد رحمۃ اللہ کہنے لگے کہ اے ابوحمزہ ! جس طرح کرتے ہوئے میں نے آپ کو دیکھا ہے کیا نبی ﷽ بھی مرد و عورت کے جنازے میں اسی طرح کھڑے ہوتے تھے آ انہوں نے فرمایا ہاں ! تو علاء نے ہماری طرف متوجہ ہو کر کہا کہ اسے محفوظ کر لو ۔"
"12205","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے اپنے صحابہ رضی اللہ عنہم سے پوچھا کہ آج تم میں سے کسی جنازے میں کس نے شرکت کی ہے آ حضرت عمر رضی اللہ عنہ نے اپنے آپ کو پیش کیا ، پھر نبی ﷽ نے پوچھا تم میں سے کسی نے کسی مریض کی عیادت کی ہے آ حضرت عمر رضی اللہ عنہ نے عرض کیا میں نے کی ہے ، پھر فرمایا کسی نے صدقہ کیا ہے آ حضرت عمر رضی اللہ عنہ نے پھر اپنے آپ کو پیش کیا ، پھر پوچھا کہ کسی نے روزہ رکھا ہے آ حضرت عمر رضی اللہ عنہ نے عرض کیا کہ میں نے رکھا ہے ، نبی ﷽ نے دو مرتبہ فرمایا واجب ہو گئی ۔"
"12206","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مرالظہران نامی جگہ پر اچانک ہمارے سامنے ایک خرگوش آ گیا ، بچے اس کی طرف دوڑے ، لیکن اسے پکڑ نہ سکے یہاں تک کہ تھک گئے ، میں نے اسے پکڑ لیا اور حضرت ابوطلحہ رضی اللہ عنہ کے پاس لے آیا ، انہوں نے اسے ذبح کیا اور اس کا ایک پہلو نبی ﷽ کی خدمت میں میرے ہاتھ بھیج دیا اور نبی ﷽ نے اسے قبول فرما لیا ۔"
"12207","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے دیکھا ہے کہ نبی ﷽ اپنی قربانی کا جانور اپنے ہاتھ سے ذبح کرتے تھے ۔"
"12208","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جو شخص عہدہ قضاء کو طلب کرتا ہے ، اسے اس کے حوالے کر دیا جاتا ہے اور جسے زبردستی عہدہ قضاء دے دیا جائے ، اس پر ایک فرشتہ نازل ہوتا ہے جو اسے سیدھی راہ پر گامزن رکھتا ہے ۔"
"12209","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے اس بات سے منع فرمایا ہے کہ کوئی شخص کھڑے ہو کر پانی پیے ۔"
"12210","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ تین سانسوں میں پانی پیتے تھے اور فرماتے تھے کہ یہ طریقہ زیادہ آسان ، خوشگوار اور مفید ہے ۔"
"12211","شعبہ رحمۃ اللہ کہتے ہیں کہ میں نے معاویہ بن قرہ رحمۃ اللہ سے پوچھا کہ کیا آپ نے حضرت انس رضی اللہ عنہ کو یہ فرماتے ہوئے سنا ہے کہ نبی ﷽ نے حضرت نعمان بن مقرن رضی اللہ عنہ کے متعلق فرمایا تھا کہ قوم کا بھانجا ان ہی میں شمار ہوتا ہے آ انہوں نے جواب دیا ہاں !"
"12212","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ حضرت ام سلیم رضی اللہ عنہا کے یہاں تشریف لائے ، گھر میں ایک مشکیزہ لٹکا ہوا تھا ، نبی ﷽ نے کھڑے کھڑے اس کے منہ سے منہ لگا کر پانی نوش فرمایا ، ام سلیم رضی اللہ عنہا نے مشکیزے کا منہ کاٹ کر + تبرک کے طور پر , اپنے پاس رکھ لیا اور وہ آج بھی ہمارے پاس موجود ہے ۔"
"12213","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوطلحہ رضی اللہ عنہ نے نبی ﷽ سے پوچھا کہ اگر یتیم بچوں کو وراثت میں شراب ملے تو کیا حکم ہے آ فرمایا اسے بہا دو ، انہوں نے عرض کیا کہ کیا ہم اسے سرکہ نہیں بنا سکتے آ فرمایا نہیں ۔"
"12214","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کو ایک جگہ راستے میں ایک کھجور پڑی ہوئی ملی ، نبی ﷽ نے فرمایا اگر تو صدقہ کی نہ ہوتی تو میں تجھے کھا لیتا ۔"
"12215","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے اخد عین اور کاہل نامی کندھوں کے درمیان مخصوص جگہوں پر سینگی لگوائی ہے ۔"
"12216","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے نبی ﷽ سے پوچھا کہ میرے والد کہاں ہوں گے آ نبی ﷽ نے فرمایا جہنم میں ، پھر جب اس کے چہرے پر ناگواری کے آثار دیکھے تو فرمایا کہ میرا اور تیرا باپ دونوں جہنم میں ہوں گے ۔"
"12217","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ تین سانسوں میں پانی پیا کرتے تھے ۔"
"12218","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے نظر بد ، ڈنک اور نملہ + جس بیماری میں پسلی دانوں سے بھر جاتی ہے , کے لئے جھاڑ پھونک کی اجازت دی ہے ۔"
"12219","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوبکر و عمر و عثمان رضی اللہ عنہم تکبیر مکمل کیا کرتے تھے ، جب سجدے میں جاتے یا سر اٹھاتے تب بھی تکبیر کہا کرتے تھے ۔"
"12220","مختار بن فلفل رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ برتنوں میں پینے کا کیا حکم ہے آ انہوں نے جواب دیا کہ نبی ﷽ نے """" مزفت """" سے منع کرتے ہوئے فرمایا ہے کہ ہر نشہ آور چیز حرام ہے ۔"
"12221","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مدینہ منورہ کے کسی راستے میں نبی ﷽ کو ایک خاتون ملی اور کہنے لگی یا رسول اللہ ﷽ ! مجھے آپ سے ایک کام ہے ، نبی ﷽ نے اس سے فرمایا کہ تم جس گلی میں چاہو بیٹھ جاا ، میں تمہارے ساتھ بیٹھ جااں گا چنانچہ وہ ایک جگہ بیٹھ گئی اور نبی ﷽ بھی اس کے ساتھ بیٹھ گئے اور اس کا کام کر دیا ۔"
"12222","قتادہ رحمۃ اللہ کہتے ہیں کہ میں نے ایک مرتبہ حضرت انس رضی اللہ عنہ سے نبی ﷽ کی قراءت کی کیفیت کے متعلق پوچھا تو انہوں نے فرمایا کہ نبی ﷽ اپنی آواز کو کھینچا کرتے تھے ۔"
"12223","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ ہمارے یہاں آتے تھے اور میرے چھوٹے بھائی کے ساتھ ہنسی مذاق کیا کرتے تھے ، ایک دن نبی ﷽ نے اسے غمگین دیکھا تو فرمایا اے ابوعمیر ! کیا کیا نغیر آ یہ ایک چڑیا تھی ، جو مر گئی تھی اور ہمارے لیے ایک چادر بچھائی گئی جس پر نبی ﷽ نے نماز پڑھائی اور ہم نے ان کے پیچھے کھڑے ہو کر صف بنا لی ۔"
"12224","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اذان اور اقامت کے درمیانی وقت میں کی جانے والی دعاء رد نہیں ہوتی ۔"
"12225","حضرت انس رضی اللہ عنہ سے مروی ہے کہ بعض اوقات نبی ﷽ جمعہ کے دن منبر سے نیچے اتر رہے ہوتے تھے اور کوئی آدمی اپنے کسی کام کے حوالے سے نبی ﷽ سے کوئی بات کرنا چاہتا تو نبی ﷽ اس سے بات کر لیتے تھے ، پھر بڑھ کر مصلیٰ پر چلے جاتے اور لوگوں کو نماز پڑھا دیتے ۔"
"12226","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا انسان تو بوڑھا ہو جاتا ہے لیکن دو چیزیں اس میں ہمیشہ رہتی ہیں ، ایک حرص اور ایک امید ۔"
"12227","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم نے نبی ﷽ کی بیعت بات سننے اور ماننے کی شرط پر کی تھی اور نبی ﷽ نے اس میں """" حسب طاقت """" کی قید لگا دی تھی ۔"
"12228","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب کسی منزل پر پڑاا کرتے تو ظہر کی نماز پڑھنے سے پہلے وہاں سے کوچ نہیں کرتے تھے ، محمد بن عمر رحمۃ اللہ نے حضرت انس رضی اللہ عنہ سے پوچھا اے ابوحمزہ ! اگرچہ نصف النہار کے وقت میں ہو آ انہوں نے فرمایا ہاں ! اگرچہ نصف النہار کے وقت ہی ہو ۔"
"12229","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے ایک آدمی کو اس طرح دعاء کرتے ہوئے سنا کہ """" اے اللہ ! میں تجھ سے سوال کرتا ہوں کیونکہ تمام تعریفیں تیرے لیے ہی ہیں ، تیرے علاوہ کوئی معبود نہیں ، تو اکیلا ہے ، تیرا کوئی شریک نہیں ، نہایت احسان کرنے والا ہے ، آسمان و زمین کو بغیر نمونے کے پیدا کرنے والا ہے اور بڑے جلال اور عزت والا ہے ۔"""" نبی ﷽ نے فرمایا تو نے اللہ سے اس کے اس اسم اعظم کے ذریعے دعا مانگی ہے کہ جب اس کے ذریعے دعاء مانگی جائے تو اللہ اسے ضرور قبول کرتا ہے اور جب اس کے ذریعے سوال کیا جائے تو وہ ضرور عطاء کرتا ہے ۔"
"12230","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے سینگی لگوائی اور آپ ﷽ کسی کی مزدوری کے معاملے میں اس پر ظلم نہیں فرماتے تھے ۔"
"12231","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ام سلیم رضی اللہ عنہا ، نبی ﷽ کی خدمت میں حاضر ہوئیں اور کہنے لگیں کہ یا رسول اللہ ﷽ ! مجھے کچھ ایسے کلمات سکھا دیجئے جن کے ذریعے میں دعاء کر لیا کروں آ نبی ﷽ نے فرمایا دس مرتبہ سبحان اللہ ، دس مرتبہ الحمدللہ اور دس مرتبہ اللہ اکبر کہہ کر اپنی ضرورت کا اللہ سے سوال کرو ، اللہ فرمائے گا کہ میں نے تمہارا کام کر دیا ، میں نے تمہارا کام کر دیا ۔"
"12232","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا بنی اسرائیل بہتر فرقوں میں تقسیم ہو گئے تھے اور تم بھی اتنے ہی فرقوں میں تقسیم ہو جاا گے ، اور سوائے ایک فرقے کے سب جہنم میں جائیں گے ۔"
"12233","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں تمہیں نبی ﷽ سے سنی ہوئی ایک ایسی حدیث سناتا ہوں جو میرے بعد تم سے کوئی بیان نہیں کرے گا ، میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ قیامت اس وقت تک قائم نہیں ہو گی جب تک مردوں کی تعداد کم اور عورتوں کی تعداد بڑھ نہ جائے ، حتیٰ کہ پچاس عورتوں کا ذمہ دار صرف ایک آدمی ہو گا ۔"
"12234","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا شب معراج میں حضرت موسیٰ علیہ السلام کے پاس سے گزرا تو دیکھا کہ وہ اپنی قبر میں کھڑے نماز پڑھ رہے ہیں ۔"
"12235","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا شب معراج میں ایسے لوگوں کے پاس سے گزرا جن کے منہ آگ کی قینچیوں سے کاٹے جا رہے تھے ، میں نے پوچھا یہ کون لوگ ہیں آ بتایا گیا کہ یہ دنیا کے خطباء ہیں جو لوگوں کو نیکی کا حکم دیتے تھے اور اپنے آپ کو بھول جاتے تھے اور کتاب کی تلاوت کرتے تھے ، کیا یہ سمجھتے نہ تھے ۔"
"12236","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا اللہ کی راہ میں جتنا مجھے ستایا گیا ، کسی کو اتنا نہیں ستایا گیا اور اللہ کی راہ میں جتنا مجھے ڈرایا گیا ، کسی کو اتنا نہیں ڈرایا گیا اور مجھ پر ایسا وقت بھی آیا ہے کہ تین دن اور تین راتیں گذر گئیں اور میرے پاس اپنے لیے اور اپنے اہل خانہ کے لئے اتنا کھانا بھی نہ تھا کہ جسے کوئی جگر رکھنے والا جاندار کھا سکے ، سوائے اس کے جو بلال کی بغل میں ہوتا تھا ۔"
"12237","[Darussalam 12213] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے، البتہ اس میں تیس دن رات کا ذکر ہے۔"
"12238","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا کسی شخص پر اس وقت تک تعجب نہ کیا کرو جب تک یہ نہ دیکھ لو کہ اس کا خاتمہ کس عمل پر ہو رہا ہے آ کیونکہ بعض اوقات ایک شخص ساری زندگی یا ایک طویل عرصہ اپنے نیک اعمال پر گزار دیتا ہے کہ اگر اسی حال میں فوت ہو جائے تو جنت میں داخل ہو جائے لیکن پھر اس میں تبدیلی پیدا ہوتی ہے اور وہ گناہوں میں مبتلاء ہو جاتا ہے ، اسی طرح ایک آدمی ایک طویل عرصے تک ایسے گناہوں میں مبتلاء رہتا ہے کہ اگر اسی حال میں مر جائے تو جہنم میں داخل ہو ، لیکن پھر اس میں تبدیلی پیدا ہو جاتی ہے اور وہ نیک اعمال میں مصروف ہو جاتا ہے ۔ اور اللہ تعالیٰ جب کسی بندے کے ساتھ خیر کا ارادہ فرماتے ہیں تو اسے اس کی موت سے پہلے استعمال فرماتے ہیں ، صحابہ رضی اللہ عنہم نے پوچھا کہ کیسے استعمال فرماتے ہیں آ نبی ﷽ نے فرمایا اسے مرنے سے پہلے عمل صالح کی توفیق عطاء فرما دیتے ہیں ۔ پھر اس کی روح قبض کرتے ہیں ۔"
"12239","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نبی ﷽ کا کاتب تھا ، اس نے سورہ بقرہ اور آل عمران بھی پڑھ رکھی تھی ، وہ آدمی جب بھی سورہ بقرہ اور آل عمران کی تلاوت کرتا تو ہم میں بہت آگے بڑھ جاتا ، نبی ﷽ اسے """" ®غفوراَ الرحیما¾ """" لکھواتے اور وہ اس کی جگہ """" ®علیما حکیما¾ """" لکھ دیتا ، نبی ﷽ فرماتے اس اس طرح لکھو ، لیکن وہ کہتا کہ میں جیسے چاہوں لکھوں ، اسی طرح نبی ﷽ اسے """" ®علیما حکیما¾ """" لکھواتے تو وہ اس کی جگہ """" ®سمیعا بصیرا¾ """" لکھ دیتا اور کہتا کہ میں جیسے چاہوں لکھوں ، کچھ عرصے بعد وہ آدمی مرتد ہو کر مشرکین سے جا کر مل گیا ، اور کہنے لگا کہ میں تم سب میں محمد + ﷽ , سے بڑا عالم ہوں ، میں ان کے پاس جو چاہتا تھا لکھ دیتا تھا ، جب وہ آدمی مرا تو نبی ﷽ نے فرمایا کہ زمین اسے قبول نہیں کرے گی ۔ حضرت انس رضی اللہ عنہ کہتے ہیں کہ مجھ سے حضرت ابوطلحہ رضی اللہ عنہ نے بیان کیا کہ وہ اس جگہ پر گئے تھے جہاں وہ آدمی مرا تھا ، انہوں نے اسے باہر پڑا ہوا پایا ، لوگوں سے پوچھا کہ اس شخص کا کیا ماجرا کیا ہے آ لوگوں نے بتایا کہ ہم نے اسے کئی مرتبہ دفن کیا ہے لیکن زمین اسے قبول نہیں کرتی ۔"
"12240","[Darussalam 12216] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12241","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے غزوہ خیبر میں حضرت طلحہ رضی اللہ عنہ کو یہ منادی کرنے کا حکم دیا کہ اللہ اور اس کے رسول تمہیں گدھوں کے گوشت سے منع کرتے ہیں ، کیونکہ ان کا گوشت ناپاک ہے ، چنانچہ ہانڈیاں الٹا دی گئیں ۔"
"12242","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ جنت البقیع میں تھے ، کہ ایک آدمی نے """" ابوالقاسم """" کہہ کر کسی کو آواز دی ، نبی ﷽ نے پیچھے مڑ کر دیکھا تو اس نے کہا کہ یا رسول اللہ ! میں آپ کو نہیں مراد لے رہا ، اس پر نبی ﷽ نے فرمایا میرے نام پر تو اپنا نام رکھ لیا کرو ، لیکن میری کنیت پر اپنی کنیت نہ رکھا کرو ۔"
"12243","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"12244","حضرت انس رضی اللہ عنہ سے مروی ہے کسی شخص نے نبی ﷽ سے نماز فجر کا وقت پوچھا تو نبی ﷽ نے حضرت بلال رضی اللہ عنہ کو طلوع فجر کے وقت حکم دیا ، انہوں نے اذان دی ، اقامت کہی اور نبی ﷽ نے نماز پڑھا دی ، پھر اگلے دن خوب روشنی کر کے نماز پڑھائی ، اور فرمایا نماز فجر کا وقت پوچھنے والا کہاں ہے آ ان دو وقتوں کے درمیان نماز فجر کا وقت ہے ۔"
"12245","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ حنین کے دن نبی ﷽ کی دعاء یہ تھی کہ اے اللہ ! کیا تو یہ چاہتا ہے کہ آج کے بعد تیری عبادت نہ کی جائے ۔"
"12246","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ایک مرتبہ میں بچپن میں دوسرے بچوں کے ساتھ کھیل رہا تھا ، اچانک ایک شخص آیا اور اس نے مجھے پکڑ کر میرا پیٹ چاک کیا ، اور اس میں سے خون کا جما ہوا ایک ٹکڑا نکالا اور اسے پھینک کر کہنے لگا کہ یہ آپ کے جسم میں شیطان کا حصہ تھا ، پھر اس نے سونے کی طشتری میں رکھے ہوئے آب زم زم سے پیٹ کو دھویا اور پھر اسے سی کر ٹانکے لگا دیئے ، یہ دیکھ کر سب بچے دوڑتے ہوئے اپنی والدہ کے پاس گئے اور کہنے لگے کہ محمد + ﷽ , قتل ہو گئے ، والدہ دوڑتی ہوئی آئیں تو دیکھا کہ نبی ﷽ کے چہرہ انور کا رنگ متغیر ہو رہا ہے ، حضرت انس رضی اللہ عنہ کہتے ہیں کہ ہم نبی ﷽ کے سینہ مبارک پر سلائی کے نشان دیکھا کرتے تھے ۔"
"12247","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ام سلیم رضی اللہ عنہا نے نبی ﷽ سے پوچھا کہ اگر عورت بھی اسی طرح """" خواب دیکھے """" جسے مرد دیکھتا ہے تو کیا حکم ہے آ نبی ﷽ نے فرمایا جو عورت ایسا """" خواب دیکھے """" اور اسے انزال ہو جائے تو اسے غسل کرنا چاہئے ، ام المومنین حضرت ام سلمہ رضی اللہ عنہا نے عرض کیا یا رسول اللہ ﷽ ! کیا ایسا بھی ہو سکتا ہے آ نبی ﷽ نے فرمایا ہاں ! مرد کا پانی گاڑھا اور سفید ہوتا ہے اور عورت کا پانی پیلا اور پتلا ہوتا ہے ، دونوں میں سے جو غالب آ جائے بچہ اسی کے مشابہہ ہوتا ہے ۔"
"12248","واقد بن عمرو بن سعد رحمۃ اللہ + جو بڑے خوبصورت اور ڈیل ڈول والے آدمی تھے , کہتے ہیں کہ ایک مرتبہ میں حضرت انس رضی اللہ عنہ کے گھر گیا ، انہوں نے مجھ سے پوچھا کہ آپ کون ہیں آ میں نے بتایا کہ میرا نام واقد ہے اور میں حضرت سعد بن معاذ رضی اللہ عنہ کا پوتا ہوں ، انہوں نے فرمایا کہ تم سعد کے بہت ہی مشابہہ ہو ، پھر ان پر گریہ طاری ہو گیا اور وہ کافی دیر تک روتے رہے ، پھر کہنے لگے کہ سعد پر اللہ کی رحمتیں نازل ہوں ، وہ لوگوں میں بڑے عظیم اور طویل القامت تھے ۔ پھر فرمایا کہ ایک مرتبہ نبی ﷽ نے اکیدر دومہ کی طرف ایک لشکر روانہ فرمایا ، اس نے نبی ﷽ کی خدمت میں ایک ریشمی جبہ """" جس پر سونے کا کام ہوا تھا """" بھجوایا ، نبی ﷽ اسے پہن کر منبر پر تشریف لے گئے ، کھڑے رہے یا بیٹھ گئے ، لیکن کوئی بات نہیں کہی ، تھوڑی دیر بعد نیچے اترے تو لوگ اس جبے کو ہاتھ لگاتے اور دیکھتے جاتے تھے ، نبی ﷽ نے فرمایا کیا تمہیں اس پر تعجب ہو رہا ہے آ لوگوں نے کہا کہ ہم نے قبل ازیں اس سے بہتر لباس نہیں دیکھا ، نبی ﷽ نے فرمایا تم جو دیکھ رہے ہو ، جنت میں سعد بن معاذ رضی اللہ عنہ کے صرف رومال ہی اس سے بہت بہتر ہیں ۔"
"12249","حضرت انس رضی اللہ عنہ سے مروی ہے کہ اکیدر نے نبی ﷽ کی خدمت میں """" من """" کا ایک مٹکا بھجوایا تھا ، نبی ﷽ نے نماز سے فارغ ہو کر ایک جماعت پر سے گزرتے ہوئے ان میں سے ہر آدمی کو ایک ایک حصہ دینا شروع کر دیا ، ان میں حضرت جابر رضی اللہ عنہ بھی تھے ، نبی ﷽ نے انہیں بھی ایک حصہ دے دیا ، پھر ان کے پاس کچھ دیر بعد واپس آ کر ایک اور حصہ دیا ، وہ کہنے لگے کہ ایک مرتبہ تو آپ مجھے دے چکے ہیں ، نبی ﷽ نے فرمایا یہ عبداللہ کی بچیوں + تمہاری بہنوں , کا حصہ ہے ۔"
"12250","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ آٹھ چیزوں سے پناہ مانگا کرتے تھے ، غم ، پریشانی ، لاچاری ، سستی ، بخل ، بزدلی ، قرضہ کا غلبہ اور دشمن کا غلبہ ۔"
"12251","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب حدیبیہ سے واپس آ رہے تھے تو آپ ﷽ پر یہ آیت نازل ہوئی ®انا فتحنا لک فتحا مبینا لیغفرلک اللہ ما تقدم من ذنبک وما تاخر ویتم نعمتہ علیک ویھدیک صراطا مستقیما¾ """" مسلمانوں نے یہ سن کر کہا یا رسول اللہ ﷽ ! آپ کو مبارک ہو کہ اللہ نے آپ کو یہ دولت عطاء فرمائی ، ہمارے لیے کیا حکم ہے آ اس پر یہ آیت نازل ہوئی ®لیدخل المومنین والمومنات جنات تجری من تحتھا الانھار خالدین فیھا ویکفر عنھم سیئاتھم وکان ذلک عند اللہ فوزا عظیما¾ ۔"
"12252","حضرت انس رضی اللہ عنہ سے مروی ہے کہ صلح حدیبیہ کے دن جبل تنعیم کی جانب سے اسلحہ سے لیس اسی اہل مکہ نبی ﷽ اور صحابہ رضی اللہ عنہم کی طرف بڑھنے لگے ، نبی ﷽ نے ان کے لئے بددعاء فرمائی اور انہیں پکڑ لیا گیا ، اس موقع پر یہ آیت نازل ہوئی ®وھو الذی کف ایدیھم عنکم ۔۔۔۔۔۔۔۔۔ """"¾ اور اس میں بطن مکہ سے مراد جبل تنعیم ہے ۔"
"12253","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نبی ﷽ کو یہ کہتے ہوئے سنتا تھا ، مجھے معلوم نہیں کہ یہ قرآن کی آیت تھی یا نبی ﷽ کا فرمان ، کہ اگر ابن آدم کے پاس مال سے بھری ہوئی دو وادیاں بھی ہوتیں تو وہ تیسری کی تمنا کرتا اور ابن آدم کا پیٹ صرف قبر کی مٹی ہی بھر سکتی ہے ، اور جو توبہ کرتا ہے ، اللہ اس کی توبہ قبول فرما لیتا ہے ۔"
"12254","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے مبارک جوتوں کے دو تسمے تھے ۔"
"12255","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت زبیر رضی اللہ عنہ اور عبدالرحمن بن عوف رضی اللہ عنہ نے نبی ﷽ سے جواں کی شکایت کی ، نبی ﷽ نے انہیں ریشمی کپڑے پہننے کی اجازت مرحمت فرما دی ، چنانچہ میں نے ان میں سے ہر ایک کو ریشمی قمیص پہنے ہوئے دیکھا ہے ۔"
"12256","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا صفوں کی درستگی نماز کا حسن ہے ۔"
"12257","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ہمارے لیے مونچھیں کاٹنے ، ناخن تراشنے اور زیر ناف بال صاف کرنے کی مدت چالیس دن مقرر فرمائی تھی ۔"
"12258","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اللہ تعالیٰ فرماتے ہیں اگر میرا بندہ بالشت برابر میرے قریب ہوتا ہے تو میں ایک گز کے برابر اس کے قریب ہو جاتا ہوں اور اگر وہ ایک گز کے برابر میرے قریب ہوتا ہے تو میں ایک ہاتھ کے برابر اس کے قریب ہوتا جاتا ہوں ، اور اگر وہ میرے پاس چل کر آتا ہے تو میں اس کے پاس دوڑ کر آتا ہوں ۔"
"12259","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب نبی ﷽ نے ہجرت فرمائی تو نبی ﷽ سواری پر آگے بیٹھے ہوئے تھے اور حضرت ابوبکر صدیق رضی اللہ عنہ پیچھے ، حضرت ابوبکر صدیق رضی اللہ عنہ کو راستوں کا علم تھا کیونکہ وہ شام آتے جاتے رہتے تھے ، جب بھی کسی جماعت پر ان کا گذر ہوتا اور وہ لوگ پوچھتے کہ ابوبکر ! یہ آپ کے آگے کون بیٹھے ہیں آ تو وہ فرماتے کہ یہ رہبر ہیں جو میری رہنمائی کر رہے ہیں ، مدینہ منورہ کے قریب پہنچ کر انہوں نے مسلمان ہونے والے انصاری صحابہ حضرت ابوامامہ رضی اللہ عنہ اور ان کے ساتھیوں کے پاس پیغام بھیجا ، وہ لوگ ان دونوں کی خدمت میں حاضر ہوئے اور عرض کیا کہ آپ دونوں امن و امان کے ساتھ مدینہ میں داخل ہو جائیے ، آپ کی اطاعت کی جائے گی ، چنانچہ وہ دونوں مدینہ منورہ میں داخل ہو گئے ۔ حضرت انس رضی اللہ عنہ کہتے ہیں کہ میں نے اس دن سے زیادہ روشن اور حسین دن کوئی نہیں دیکھا جب نبی ﷽ اور حضرت ابوبکر صدیق رضی اللہ عنہ مدینہ منورہ میں داخل ہوئے تھے اور میں نے نبی ﷽ کی دنیا سے رخصتی کا دن بھی پایا ہے ، اور اس دن سے زیادہ تاریک اور قبیح دن کوئی نہیں دیکھا ۔"
"12260","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ احد کے دن نبی ﷽ نے ایک تلوار پکڑی اور فرمایا یہ تلوار کون لے گا آ کچھ لوگ اسے لے کر دیکھنے لگے ، نبی ﷽ نے فرمایا اس کا حق ادا کرنے کے لئے اسے کون لے گا آ یہ سن کر لوگ پیچھے ہٹ گئے ، حضرت ابودجانہ رضی اللہ عنہ """" جن کا نام سماک تھا """" کہنے لگے کہ میں اس کا حق ادا کرنے کے لئے لیتا ہوں ، چنانچہ انہوں نے اسے تھام لیا اور مشرکین کی کھوپڑیاں اڑانے لگے ۔"
"12261","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے غزوہ حنین کے دن اعلان فرما دیا کہ جو شخص کسی کافر کو قتل کرے گا ، اس کا ساز و سامان اسی کو ملے گا ، چنانچہ حضرت ابوطلحہ رضی اللہ عنہ نے بیس آدمیوں کو قتل کیا اور ان کا ساز و سامان حاصل کر لیا ۔"
"12262","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ کسی مسلمان کی نیکی ضائع نہیں کرتا ، دنیا میں بھی اس پر عطاء فرماتا ہے اور آخرت میں بھی ثواب دیتا ہے ، اور کافر کی نیکیوں کا بدلہ دنیا میں ہی دے دیا جاتا ہے ، یہی وجہ ہے کہ جب وہ آخرت میں پہنچے گا تو وہاں اس کی کوئی نیکی نہیں ہو گی جس کا اسے بدلہ دیا جائے ۔"
"12263","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے زمین پر اپنی انگلیاں رکھ کر فرمایا یہ ابن آدم ہے ، پھر انہیں اٹھا کر تھوڑا سا پیچھے رکھا اور فرمایا کہ یہ اس کی موت ہے ، پھر اپنا ہاتھ آگے کر کے فرمایا کہ یہ اس کی امیدیں ہیں ۔"
"12264","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب دعاء کرتے تو ہتھیلیوں کا اوپر والا حصہ چہرہ کی جانب کر لیتے اور نچلا حصہ زمین کی طرف ۔"
"12265","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت صفیہ رضی اللہ عنہا حضرت دحیہ کلبی رضی اللہ عنہ کے حصے میں آئی تھیں ، کسی شخص نے عرض کیا یا رسول اللہ ﷽ ! دحیہ کے حصے میں ایک نہایت خوبصورت باندی آئی ہے ، نبی ﷽ نے سات افراد کے عوض انہیں خرید لیا ، اور خرید کر انہیں حضرت ام سلیم رضی اللہ عنہا کے پاس بھیج دیا ، تاکہ وہ انہیں بنا سنوار کر دلہن بنائیں ، اس دوران لوگ یہ سوچنے لگے کہ نبی ﷽ ان سے نکاح فرمائیں گے یا انہیں باندی بنائیں گے آ لیکن جب نبی ﷽ نے انہیں سواری پر بٹھا کر پردہ کرایا اور انہیں اپنے پیچھے بٹھا لیا تو لوگ سمجھ گئے کہ نبی ﷽ نے ان سے نکاح فرما لیا ہے ۔ مدینہ منورہ کے قریب پہنچ کر لوگ اپنے رواج کے مطابق سواریوں سے کود کر اترنے لگے ، نبی ﷽ بھی اسی طرح اترنے لگے لیکن اونٹنی پھسل گئی اور نبی ﷽ زمین پر گر گئے ، حضرت صفیہ رضی اللہ عنہ بھی گر گئیں ، دیگر ازواج مطہرات دیکھ رہی تھیں ، وہ کہنے لگیں کہ اللہ اس یہودیہ کو دور کرے اور اس کے ساتھ ایسا ایسا کرے ، ادھر نبی ﷽ کھڑے ہوئے اور انہیں پردہ کرایا ، پھر اپنے پیچھے بٹھا لیا ۔"
"12266","[Darussalam 12241] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12267","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مسجد نبوی ﷽ کی جگہ دراصل بنو نجار کی تھی ، یہاں ایک درخت ، کھیت اور مشرکین کی چند قبریں ہوا کرتی تھیں ، نبی ﷽ نے بنو نجار سے فرمایا کہ میرے ساتھ اس کی قیمت طے کر لو ، انہوں نے عرض کیا کہ ہم اس کی قیمت نہیں لیں گے ، چنانچہ نبی ﷽ کے حکم پر درختوں کو کاٹ دیا گیا ، کھیت کو اجاڑ دیا گیا اور قبروں کو اکھاڑ دیا گیا ، اور مسجد نبوی کی تعمیر سے پہلے جہاں بھی نماز کا وقت ہو جاتا ، نبی ﷽ وہیں نماز پڑھ لیتے اور بکریوں کے باڑے میں بھی نماز پڑھ لیتے تھے ۔"
"12268","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کا ایک پڑوسی فارس کا رہنے والا تھا ، وہ سالن بڑا اچھا پکاتا تھا ، ایک دن اس نے نبی ﷽ کے لئے کھانا پکایا اور نبی ﷽ کو دعوت دینے کے لئے آیا ، نبی ﷽ نے حضرت عائشہ رضی اللہ عنہا کی طرف اشارہ کر کے فرمایا کہ یہ بھی میرے ساتھ ہوں گی ، اس نے انکار کر دیا ، نبی ﷽ نے بھی اس کے ساتھ جانے سے انکار کر دیا ، اور وہ چلا گیا ، پھر تین مرتبہ اسی طرح چکر لگائے ، بالآخر اس نے حضرت عائشہ رضی اللہ عنہا کو بھی ساتھ لانے کے لئے حامی بھر لی ، چنانچہ وہ دونوں آگے پیچھے چلتے ہوئے اس کے گھر چلے گئے ۔"
"12269","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضور نبی مکرم سرور دو عالم ﷽ نے فرمایا ، دجال مدینہ منورہ کی طرف آئے گا لیکن وہاں فرشتوں کو اس کا پہرہ دیتے ہوئے پائے گا ، انشاء اللہ مدینہ میں دجال داخل ہو سکے گا اور نہ ہی طاعون کی وبا ۔"
"12270","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا میں اور قیامت ان دو انگلیوں کی طرح اکٹھے بھیجے گئے ہیں ، یہ کہہ کر نبی ﷽ نے شہادت والی انگلی اور درمیانی انگلی کی طرف اشارہ فرمایا ۔"
"12271","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا مشرکین کے ساتھ اپنی جان ، مال اور زبان کے ذریعے جہاد کرو ۔"
"12272","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت معاذ بن جبل رضی اللہ عنہ اپنی قوم کی امامت فرماتے تھے ، ایک مرتبہ وہ نماز پڑھا رہے تھے کہ حضرت حرام رضی اللہ عنہ """" جو اپنے باغ کو پانی لگانے جا رہے تھے """" نماز پڑھنے کے لئے مسجد میں داخل ہوئے ، جب انہوں نے دیکھا کہ حضرت معاذ رضی اللہ عنہ تو نماز لمبی کر رہے ہیں تو وہ اپنی نماز مختصر کر کے اپنے باغ کو پانی لگانے کے لیے چلے گئے ، ادھر حضرت معاذ رضی اللہ عنہ نے نماز مکمل کی تو انہیں کسی نے بتایا کہ حضرت حرام رضی اللہ عنہ مسجد میں آئے تھے ، جب انہوں نے دیکھا کہ آپ نماز کو لمبا کر رہے ہیں تو وہ مختصر نماز پڑھ کر اپنے باغ کو پانی لگانے چلے گئے ، حضرت معاذ رضی اللہ عنہ کے منہ سے نکل گیا کہ وہ منافق ہے ، اپنے باغ کو سیراب کرنے کے لیے نماز سے جلدی کرتا ہے ۔ اتفاق سے حضرت حرام رضی اللہ عنہ بارگاہ نبوت میں حاضر ہوئے تو وہاں حضرت معاذ بن جبل رضی اللہ عنہ بھی موجود تھے ، حضرت حرام رضی اللہ عنہ کہنے لگے کہ اے اللہ کے نبی ! میں اپنے باغ کو پانی لگانے کے لیے جا رہا تھا ، باجماعت نماز پڑھنے کے لیے مسجد میں داخل ہوا ، لیکن جب انہوں نے نماز بہت زیادہ ہی لمبی کر دی تو میں مختصر نماز پڑھ کر اپنے باغ کو پانی لگانے چلا گیا ، اب ان کا خیال یہ ہے کہ میں منافق ہوں آ نبی ﷽ نے حضرت معاذ رضی اللہ عنہ کی طرف متوجہ ہو کر دو مرتبہ فرمایا کیا تم لوگوں کو امتحان ڈالتے ہو آ انہیں لمبی نماز نہ پڑھایا کرو ، سورہ اعلی اور سورہ شمس وغیرہ سورتیں پڑھ لیا کرو ۔"
"12273","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے کسی مہینے کے آخر میں صوم وصال فرمایا ، کچھ لوگوں نے بھی ایسا ہی کیا ، نبی ﷽ کو خبر ہوئی تو فرمایا کہ اگر یہ مہینہ لمبا ہو جاتا تو میں اتنے دن مسلسل روزہ رکھتا کہ دین میں تعمق کرنے والے اپنا تعمق چھوڑ دیتے ، میں تمہاری طرح نہیں ہوں ، مجھے تو میرا رب کھلاتا پلاتا رہتا ہے ۔"
"12274","حضرت ابن عمر رضی اللہ عنہما سے مروی ہے کہ نبی ﷽ اگر کسی سفر یا غزوہ میں ہوتے اور رات کا وقت آ جاتا تو یہ دعاء فرماتے کہ اے زمین ! میرا اور تیرا رب اللہ ہے ، میں تیرے شر ، تجھ میں موجود شر ، تیرے اندر پیدا کی گئی چیزوں کے شر اور تجھ پر چلنے والوں کے شر سے اللہ کی پناہ میں آتا ہوں ، میں ہر شیر اور کالی چیز سے ، سانپ اور بچھو سے ، اہلیان شہر کے شر سے اور والد اور اولاد کے شر سے اللہ کی پناہ میں آتا ہوں ۔"
"12275","حمید رحمۃ اللہ کہتے ہیں کہ حضرت انس رضی اللہ عنہ کی عمر مبارک ایک کم سو سال تھی ۔"
"12276","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی مدینہ منورہ تشریف آوری پر حضرت ام سلیم رضی اللہ عنہا میرا ہاتھ پکڑ کر نبی ﷽ کے پاس آئیں اور کہنے لگیں یا رسول اللہ ﷽ ! یہ میرا بیٹا ہے اور لکھنا جانتا ہے ، چنانچہ میں نے نو سال تک نبی ﷽ کی خدمت کی ، میں نے جس کام کو کر لیا ہو ، نبی ﷽ نے کبھی مجھ سے یہ نہیں فرمایا کہ تم نے بہت برا کیا ، یا غلط کیا ۔"
"12277","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت حارثہ رضی اللہ عنہ سیر پر نکلے ، راستے میں کہیں سے ناگہانی تیر ان کے آ کر لگا اور وہ شہید ہو گئے ، ان کی والدہ نے بارگاہ رسالت میں عرض کیا یا رسول اللہ ﷽ ! آپ جانتے ہیں کہ مجھے حارثہ سے کتنی محبت تھی ، اگر تو وہ جنت میں ہے تو میں صبر کر لوں گی ، ورنہ پھر جو میں جو کروں گی وہ آپ بھی دیکھ لیں گے ، نبی ﷽ نے فرمایا اے ام حارثہ ! جنت صرف ایک تو نہیں ہے ، وہ تو بہت سی جنتیں ہیں اور حارثہ ان میں سب سے افضل جنت میں ہے ۔"
"12278","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب اللہ نے زمین کو پیدا کیا تو وہ ڈانواں ڈول ہونے لگی ، اللہ نے پہاڑوں کو پیدا کر کے اس پر رکھ دیا تو وہ اپنی جگہ ٹھہر گئی ، ملائکہ کو پہاڑوں کی تخلیق پر تعجب ہوا ، اور وہ کہنے لگے کہ پروردگار کیا آپ نے پہاڑوں سے بھی زیادہ سخت کوئی چیز پیدا کی ہے آ اللہ نے فرمایا ہاں ! لوہا ، انہوں نے پوچھا کہ پروردگار کیا لوہے سے بھی زیادہ کوئی سخت چیز آپ نے پیدا کی ہے آ فرمایا ہاں ! آگ ، فرشتوں نے پوچھا کہ کیا آپ نے آگ سے بھی زیادہ کوئی سخت چیز پیدا کی ہے آ فرمایا ہاں ! پانی ، فرشتوں نے پوچھا کہ پروردگار ! کیا آپ نے پانی سے بھی زیادہ کوئی سخت چیز پیدا کی ہے آ فرمایا ہاں ! ہوا ، فرشتوں نے پوچھا کہ پروردگار ! کیا آپ نے ہوا سے بھی زیادہ کوئی سخت چیز پیدا کی ہے آ فرمایا ہاں ! ابن آدم ، جو دائیں ہاتھ سے خرچ کرتا ہے تو بائیں ہاتھ کو پتہ بھی نہیں چلتا ۔"
"12279","حضرت انس رضی اللہ عنہ سے مروی ہے کہ صلح حدیبیہ کے دن جبل تنعیم کی جانب سے اسلحہ سے لیس اسی اہل مکہ نبی ﷽ اور صحابہ کی طرف بڑھنے لگے ، وہ دھوکے سے نبی ﷽ اور صحابہ پر حملہ کرنا چاہتے تھے ، لیکن انہیں بڑی آسانی سے پکڑ لیا گیا تاہم نبی ﷽ نے انہیں چھوڑ دیا ، اس موقع پر یہ آیت نازل ہوئی ®وھوالذی کف ایدیھم عنکم وایدیکم عنھم ببطن مکۃ من بعد ان اظفرکم علیھم¾ ۔"
"12280","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نماز کھڑی ہوئی تو نبی ﷽ ہماری طرف متوجہ ہوئے اور فرمایا صفیں سیدھی کر لو اور جڑ کر کھڑے ہو کیونکہ میں تمہیں اپنے پیچھے سے بھی دیکھتا ہوں ۔"
"12281","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا میں جنت میں داخل ہوا تو اپنے آگے کسی کی آہٹ سنی ، پوچھا تو وہ غمیصاء بنت ملحان تھیں جو کہ حضرت انس رضی اللہ عنہ کی والدہ تھیں ۔"
"12282","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ اپنے گھر میں بیٹھے ہوئے تھے کہ ایک آدمی آ کر کسی سوراخ سے اندر جھانکنے لگا ، نبی ﷽ نے اپنے ہاتھ میں پکڑی ہوئی کنگھی اسے مارنے کے لیے سیدھی کی + تو وہ آدمی پیچھے ہٹ گیا , ۔"
"12283","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا میری امت کے کچھ لوگ جہنم میں داخل کیے جائیں گے ، جب وہ جل کر کوئلہ ہو جائیں گے تو انہیں جنت میں داخل کر دیا جائے گا ، اہل جنت پوچھیں گے کہ یہ کون لوگ ہیں آ انہیں بتایا جائے گا کہ یہ جہنمی ہیں ۔"
"12284","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوبکر و عمر و عثمان رضی اللہ عنہم تکبیر مکمل کیا کرتے تھے ، جب سجدے میں جاتے یا سر اٹھاتے تب بھی تکبیر کہا کرتے تھے ۔"
"12285","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد ربانی """" جب اس کے رب نے اپنی تجلی ظاہر فرمائی """" کی تفسیر میں فرمایا ہے کہ چھنگلیا کے ایک کنارے کے برابر تجلی ظاہر ہوئی ۔ امام احمد رحمۃ اللہ فرماتے ہیں کہ ہمیں معاذ نے انگلی کی کیفیت دکھائی ، تو حمید الطویل ، ان سے کہنے لگے کہ اے ابومحمد ! اس سے آپ کا کیا مقصد ہے آ انہوں نے ان کے سینے پر زور سے ایک ہاتھ مارا اور کہنے لگے کہ حمید ! تم کون ہو اور کیا ہو آ مجھ سے یہ بات حضرت انس رضی اللہ عنہ نے نبی ﷽ کے حوالے سے بیان کی ہے اور تم کہہ رہے ہو کہ اس سے آپ کا مقصد کیا ہے آ"
"12286","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب اہل یمن نبی ﷽ کی خدمت میں حاضر ہوئے تو انہوں نے نبی ﷽ سے درخواست کی کہ ان کے ساتھ ایک آدمی کو بھیج دیں جو انہیں دین کی تعلیم دے ، نبی ﷽ نے ان کے ساتھ حضرت ابوعبیدہ رضی اللہ عنہ کو بھیج دیا اور فرمایا یہ اس امت کے امین ہیں ۔"
"12287","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نبی ﷽ کے پاس سے گزرا ، اس وقت نبی ﷽ کے پاس ان کی کوئی زوجہ محترمہ تھیں ، نبی ﷽ نے انہیں ان کا نام لے کر پکارا تاکہ وہ آدمی سمجھ لے کہ یہ نبی ﷽ کی زوجہ محترمہ ہیں ، وہ آدمی کہنے لگا یا رسول اللہ ﷽ ! کیا آپ مجھے ایسا سمجھتے ہیں آ نبی ﷽ نے فرمایا مجھے اس بات سے اندیشہ ہوا کہ کہیں شیطان تمہارے دماغ میں نہ گھس جائے ۔"
"12288","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ رات کو بلا اطلاع سفر سے واپسی پر اپنے گھر نہیں آتے تھے ، بلکہ صبح یا دوپہر کو تشریف لاتے تھے ۔"
"12289","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ کسی مسلمان کی نیکی ضائع نہیں کرتا ، دنیا میں بھی اس پر عطاء فرماتا ہے اور آخرت میں بھی ثواب دیتا ہے ، اور کافر کی نیکیوں کا بدلہ دنیا میں ہی دے دیا جاتا ہے ، یہی وجہ ہے کہ جب وہ آخرت میں پہنچے گا تو وہاں اس کی کوئی نیکی نہیں ہو گی جس کا اسے بدلہ دیا جائے ۔"
"12290","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے بال کندھوں تک آتے تھے ۔"
"12291","حضرت انس رضی اللہ عنہ یا ابوہریرہ رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے پااں اور ہتھیلیاں بھری ہوئی اور چہرہ حسین و جمیل تھا ، میں نے آپ کے بعد آپ جیسا کوئی نہیں دیکھا ۔ ﷽ ۔"
"12292","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ام سلیم رضی اللہ عنہا نے ایک تھالی میں کھجوریں رکھ کر نبی ﷽ کے پاس بھیجیں ، نبی ﷽ نے اس میں سے ایک مٹھی بھر کر اپنی ایک زوجہ محترمہ کو بھجوا دیں ، پھر ایک مٹھی بھر کر دوسری زوجہ کو بھجوا دیں ، پھر جو باقی بچ گئیں ، وہ بیٹھ کر خود اس طرح تناول فرما لیں ، جیسے وہ آدمی کھاتا ہے جسے کھانے کی خواہش ہو اور وہ اس کے کھانے سے معلوم ہو رہی ہو ۔"
"12293","حضرت انس رضی اللہ عنہ سے مروی ہے کہ عیدالفطر کے دن نبی ﷽ عید گاہ کی طرف اس وقت تک نہیں نکلتے تھے جب تک ایک ایک کر کے چند کھجوریں نہ کھا لیتے ۔"
"12294","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ماہ رمضان میں نبی ﷽ سفر پر تھے ، نبی ﷽ کے سامنے ایک برتن لایا گیا ، آپ ﷽ نے اسے اپنے ہاتھ پر رکھا ، نبی ﷽ کو دیکھ کر لوگوں نے بھی روزہ ختم کر دیا ۔"
"12295","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا + میری امت کے کچھ لوگ جہنم میں داخل کیے جائیں گے ، جب وہ جل کر کوئلہ ہو جائیں گے تو انہیں جنت میں داخل کر دیا جائے گا , ، اہل جنت پوچھیں گے کہ یہ کون لوگ ہیں آ انہیں بتایا جائے گا کہ یہ جہنمی ہیں ۔"
"12296","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب انسان کو دفن کر کے اس کے ساتھی چلے جاتے ہیں ، تو مردہ ان کے جوتوں کی آہٹ تک سنتا ہے ، پھر دو فرشتے آ کر اسے بٹھاتے ہیں ، اور اس سے نبی ﷽ کے متعلق پوچھتے ہیں کہ تم اس آدمی کے متعلق کیا کہتے ہو آ اگر وہ مومن ہو تو کہہ دیتا ہے کہ میں اس بات کی گواہی دیتا ہوں کہ محمد ﷽ اللہ کے بندے اور رسول ہیں ، پھر اسے جہنم کا ایک دروازہ کھول کر دکھایا جاتا ہے اور اس سے کہا جاتا ہے کہ اگر تم اپنے رب کے ساتھ کفر کرتے تو تمہارا ٹھکانا یہاں ہوتا ، لیکن چونکہ تم اس پر ایمان رکھتے ہو اس لیے تمہارا ٹھکانا دوسرا ہے ، یہ کہہ کر اس کے لیے جنت کا ایک دروازہ کھول دیا جاتا ہے ، اور اس کی قبر ستر گز کشادہ کر دی جاتی ہے اور اس پر شادابی انڈیل دی جاتی ہے ۔ اور اگر وہ کافر یا منافق ہو تو فرشتہ جب اس سے پوچھتا ہے کہ تم اس آدمی کے متعلق کیا کہتے ہو آ وہ جواب دیتا ہے کہ مجھے تو کچھ معلوم نہیں ، البتہ میں نے لوگوں کو کچھ کہتے ہوئے سنا ضرور تھا ، فرشتہ اس سے کہتا ہے کہ تم نے کچھ جانا ، نہ پیچھے چلے اور نہ ہدایت پائی ، پھر وہ فرشتہ اپنے گرز سے اس پر اتنی زور کی ضرب لگاتا ہے جس کی آواز جن و انس کے علاوہ اللہ کی ساری مخلوق سنتی ہے ، بعض راوی یہ بھی کہتے ہیں کہ اس کی قبر اتنی تنگ کر دی جاتی ہے کہ اس کی پسلیاں ایک دوسرے میں گھس جاتی ہیں ۔"
"12297","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا نیک مسلمان کا اچھا خواب اجزاء نبوت میں سے چھیالیسواں جزو ہوتا ہے ۔"
"12298","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جنت میں داخل ہونے والا کوئی شخص بھی جنت سے نکلنا کبھی پسند نہیں کرے گا سوائے شہید کے کہ جس کی خواہش یہ ہو گی کہ وہ جنت سے نکلے اور پھر اللہ کی راہ میں شہید ہو ، کیونکہ اسے اس کی فضیلت نظر آ رہی ہو گی ۔"
"12299","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ گالیاں دینے والے ، لعنت ملامت کرنے والے یا بے ہودہ باتیں کرنے والے نہ تھے ، عتاب کے وقت بھی صرف اتنا فرماتے تھے کہ اسے کیا ہو گیا ، اس کی پیشانی خاک آلود ہو ۔"
"12300","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم لوگ نبی ﷽ کی صاحبزادی کے جنازے میں شریک تھے ، نبی ﷽ قبر پر بیٹھے ہوئے تھے ، میں نے نبی ﷽ کی آنکھوں کو جھلملاتے ہوئے دیکھا ، نبی ﷽ نے فرمایا کیا تم میں سے کوئی آدمی ایسا بھی ہے جو رات کو اپنی بیوی کے قریب نہ گیا ہو آ حضرت ابوطلحہ رضی اللہ عنہ نے عرض کیا جی ہاں ! میں ہوں ، نبی ﷽ نے فرمایا قبر میں تم اترو ، چنانچہ وہ قبر میں اترے ۔"
"12301","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نبی ﷽ نے فرمایا کہ پیچھے سے بھی ، اس ذات کی قسم جس کے دست قدرت میں محمد + ﷽ , کی جان ہے ، جو میں دیکھ چکا ہوں ، اگر تم نے وہ دیکھا ہوتا تو تم بہت تھوڑا ہنستے اور کثرت سے رویا کرتے ، صحابہ رضی اللہ عنہم نے پوچھا یا رسول اللہ ﷽ ! آپ نے کیا دیکھا ہے آ فرمایا میں نے اپنی آنکھوں سے جنت اور جہنم کو دیکھا ہے نیز نبی ﷽ نے انہیں نماز کی ترغیب دی ہے اور انہیں رکوع و سجود میں اپنے سے آگے بڑھنے ، نیز نبی ﷽ کے فارغ ہونے سے پہلے نماز سے نکل جانے کی ممانعت کرتے ہوئے فرمایا کہ میں تمہیں اپنے آگے سے بھی دیکھتا ہوں اور پیچھے سے بھی دیکھتا ہوں ۔"
"12302","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اپنی اونٹنی پر دوران سفر قبلہ کی تعیین کے بغیر بھی نوافل پڑھ لیا کرتے تھے ۔"
"12303","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا سوال کرنا صرف تین میں سے کسی ایک صورت میں حلال ہے ، وہ آدمی جو مرنے کے قریب ہو ، وہ قرض جو ہلا دینے والا ہو اور وہ فقر و فاقہ جو خاک نشین کر دے ۔"
"12304","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا لوگوں میں سے کچھ اہل اللہ ہوتے ہیں ، صحابہ رضی اللہ عنہم نے پوچھا یا رسول اللہ ﷽ ! وہ کون لوگ ہوتے ہیں آ فرمایا قرآن والے ، اللہ کے خاص لوگ اور اہل اللہ ہوتے ہیں ۔"
"12305","ابراہیم بن ابی ربیعہ رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ ہم لوگ حضرت انس رضی اللہ عنہ کی خدمت میں حاضر ہوئے ، وہ اس وقت ایک کپڑے میں لپٹ کر نماز پڑھ رہے تھے ، حالانکہ ان کی چادر پاس ہی پڑی ہوئی تھی ، میں نے ان سے عرض کیا کہ آپ ایک کپڑے میں نماز پڑھ رہے تھے آ انہوں نے فرمایا کہ میں نے نبی ﷽ کو بھی اسی طرح نماز پڑھتے ہوئے دیکھا ہے ۔"
"12306","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب کسی ٹیلے پر یا بلند جگہ پر چڑھتے تو یوں کہتے کہ اے اللہ ! ہر بلندی پر تیری بلندی ہے اور ہر تعریف پر تیری تعریف ہے ۔"
"12307","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے نظر بد ، ڈنک اور نملہ + جس بیماری میں پسلی دانوں سے بھر جاتی ہے , کے لئے جھاڑ پھونک کی اجازت دی ہے ۔"
"12308","حضرت انس رضی اللہ عنہ سے نبی ﷽ کی قراءت کی کیفیت کے متعلق مروی ہے کہ نبی ﷽ اپنی آواز کو کھینچا کرتے تھے ۔"
"12309","حضرت انس رضی اللہ عنہ سے مروی ہے کہ بعض اوقات نبی ﷽ جمعہ کے دن منبر سے نیچے اتر رہے ہوتے تھے اور کوئی آدمی اپنے کسی کام کے حوالے سے نبی ﷽ سے کوئی بات کرنا چاہتا تو نبی ﷽ اس سے بات کر لیتے تھے ۔"
"12310","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے مجھے """" اے دو کانوں والے """" کہہ کر مخاطب فرمایا تھا ۔"
"12311","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے میری کنیت اس سبزی کے نام پر رکھی تھی جو میں چنتا تھا ۔"
"12312","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اللہ تعالی فرماتے ہیں اگر میرا بندہ بالشت برابر میرے قریب ہوتا ہے تو میں ایک گز کے برابر اس کے قریب ہو جاتا ہوں اور اگر وہ ایک گز کے برابر میرے قریب ہوتا ہے تو میں ایک ہاتھ کے برابر اس کے قریب ہو جاتا ہوں ، اور اگر وہ میرے پاس چل کر آتا ہے تو میں اس کے پاس دوڑ کر آتا ہوں ۔"
"12313","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے حضرت عبدالرحمن بن عوف رضی اللہ عنہ اور حضرت زبیر بن عوام رضی اللہ عنہ کو خارش کی وجہ سے ریشمی کپڑے پہننے کی اجازت مرحمت فرما دی ۔"
"12314","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا قیامت کے دن ایک جہنمی سے کہا جائے گا کہ یہ بتا ، اگر تیرے پاس روئے زمین کی ہر چیز موجود ہو تو کیا تو وہ سب کچھ اپنے فدیے میں دے دے گا آ وہ کہے گا ہاں ! اللہ فرمائے گا کہ میں نے تو تجھ سے دنیا میں اس سے بھی ہلکی چیز کا مطالبہ کیا تھا ، میں نے آدم کی پشت میں تجھ سے وعدہ لیا تھا کہ میرے ساتھ کسی کو شریک نہ ٹھہرائے گا لیکن تو شرک کیے بغیر نہ مانا ۔"
"12315","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا گھوڑوں کی پیشانیوں میں برکت رکھ دی گئی ہے ۔"
"12316","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نبی ﷽ کی خدمت میں تین مرتبہ آیا اور تین مرتبہ یہ سوال پوچھا کہ یا رسول اللہ ﷽ ! کون سی دعاء سب سے افضل ہے آ اور نبی ﷽ نے تینوں مرتبہ یہی جواب دیا کہ اپنے رب سے دنیا میں درگذر اور عافیت کا سوال کیا کرو ، اور آخری مرتبہ فرمایا کہ اگر تمہیں دنیا و آخرت میں یہ دونوں چیزیں مل جائیں تو تم کامیاب ہو گئے ۔"
"12317","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا لوگوں میں سے کچھ اہل اللہ ہوتے ہیں ، صحابہ رضی اللہ عنہم نے پوچھا یا رسول اللہ ﷽ ! وہ کون لوگ ہوتے ہیں آ فرمایا قرآن والے ، اللہ کے خاص لوگ اور اہل اللہ ہوتے ہیں ۔"
"12318","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا دنیا میں سے میرے نزدیک صرف عورت اور خوشبو کی محبت ڈالی گئی ہے اور میری آنکھوں کی ٹھنڈک نماز میں رکھی گئی ہے ۔"
"12319","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا دنیا میں سے میرے نزدیک صرف عورت اور خوشبو کی محبت ڈالی گئی ہے اور میری آنکھوں کی ٹھنڈک نماز میں رکھی گئی ہے ۔"
"12320","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دو تین سانسوں میں پانی پیا کرتے تھے ، خود حضرت انس رضی اللہ عنہ بھی تین سانس لیتے تھے ۔"
"12321","قتادہ رحمۃ اللہ کہتے ہیں کہ ہم لوگ حضرت انس رضی اللہ عنہ کی خدمت میں حاضر ہوا کرتے تھے ، ان کے یہاں نانبائی مقرر تھا ، ایک دن وہ ہم سے فرمانے لگے کھاا ، البتہ میرے علم میں نہیں ہے کہ نبی ﷽ نے کبھی اپنی آنکھوں سے باریک روٹی کو دیکھا بھی ہو ، یا کبھی سالم بھنی ہوئی بکری کھائی ہو ۔"
"12322","ابراہیم بن ابی ربیعہ رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ ہم لوگ حضرت انس رضی اللہ عنہ کی خدمت میں حاضر ہوئے ، وہ اس وقت ایک کپڑے میں لپٹ کر نماز پڑھ رہے تھے ، حالانکہ ان کی چادر پاس ہی پڑی ہوئی تھی ، جب وہ نماز سے فارغ ہوئے تو ہم نے ان سے عرض کیا کہ آپ ایک کپڑے میں نماز پڑھ رہے تھے آ انہوں نے فرمایا کہ میں نے نبی ﷽ کو بھی اس طرح نماز پڑھتے ہوئے دیکھا ہے ۔"
"12323","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم لوگ نبی ﷽ کے ساتھ خیبر روانہ ہوئے ، ہمارا ایک ساتھی وہاں ایک ویرانے میں قضاء حاجت کے لئے گیا ، اس نے استنجاء کرنے کے لئے ایک اینٹ اٹھائی تو وہاں سے چاندی کا ایک ٹکڑا گرا ، اس نے وہ اٹھا لیا اور نبی ﷽ کے پاس لایا اور سارا واقعہ بتایا ، نبی ﷽ نے فرمایا اسے تولو ، اس نے وزن کیا تو وہ دو سو درہم کے برابر بنا ، نبی ﷽ نے فرمایا یہ رکاز ہے اور اس میں پانچواں حصہ واجب ہے ۔"
"12324","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جمعہ کی نماز زوال کے وقت ہی پڑھ لیا کرتے تھے اور جب مکہ مکرمہ کے لئے نکلتے تو ظہر کی دو رکعتیں ایک درخت کے نیچے پڑھ لیتے ۔"
"12325","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ حضرت حمزہ رضی اللہ عنہ کی نعش مبارک کے پاس آ کر کھڑے ہو گئے ، دیکھا تو ان کی لاش کا مشرکین نے مثلہ کر دیا تھا ، نبی ﷽ نے فرمایا اگر صفیہ اپنے دل میں بوجھ نہ بناتیں تو میں انہیں یونہی چھوڑ دیتا تاکہ پرندے ان کا گوشت کھا لیتے اور قیامت کے دن یہ پرندوں کے پیٹوں سے نکلتے ، پھر نبی ﷽ نے ایک چادر منگوا کر اس میں انہیں کفنایا ، جب اس چادر کو سر پر ڈالا جاتا تو پااں کھل جاتے اور پااں پر ڈالا جاتا تو سر کھل جاتا ۔ غزوہ احد کے موقع پر شہداء کی تعداد زیادہ اور کفن کم پڑ گئے تھے ، جس کی وجہ سے ایک ایک کفن میں دو دو تین تین آدمیوں کو لپیٹ دیا جاتا تھا ، البتہ نبی ﷽ یہ پوچھتے جاتے تھے کہ ان میں سے قرآن کسے زیادہ آتا تھا آ پھر پہلے اس ہی کو قبلہ رخ فرماتے تھے ، نبی ﷽ نے اس طرح ان سب کو دفنا دیا اور ان کی نماز جنازہ نہیں پڑھی ۔"
"12326","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا میں سدرۃ المنتہیٰ پہنچا تو دیکھا کہ اس کے پھل مٹکے برابر اور پتے ہاتھی کے کان برابر ہیں ، جب اسے اللہ کے حکم سے اس چیز نے ڈھانپ لیا جس نے ڈھانپا تو وہ یاقوت اور زمرد میں تبدیل ہو گیا ۔"
"12327","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ربیع """" جو حضرت انس رضی اللہ عنہ کی پھوپھی ہیں """" نے ایک لڑکی کا دانت توڑ دیا ، پھر ان کے اہل خانہ نے لڑکی والوں سے معافی مانگی لیکن انہوں نے معاف کرنے سے انکار کر دیا ، اور نبی ﷽ کے پاس آ کر قصاص کا مطالبہ کرنے لگے ، انس بن نضر رضی اللہ عنہ کہنے لگے یا رسول اللہ ﷽ ! کیا فلاں + میری بہن , کا دانت توڑ دیا جائے گا آ نبی ﷽ نے فرمایا انس ! کتاب اللہ کا فیصلہ قصاص ہی کا ہے ، وہ کہنے لگے کہ اس ذات کی قسم جس نے آپ کو حق کے ساتھ بھیجا ہے ، فلاں عورت کا دانت نہیں توڑا جائے گا ، اسی اثناء میں وہ لوگ راضی ہو گئے اور انہوں نے انہیں معاف کر دیا اور قصاص کا مطالبہ ترک کر دیا ، اس پر نبی ﷽ نے فرمایا اللہ کے بعض بندے ایسے ہوتے ہیں جو اگر کسی کام پر اللہ کی قسم کھا لیں تو اللہ انہیں ان کی قسم میں ضرور سچا کرتا ہے ۔"
"12328","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میرے ایک چچا نے ایک مرتبہ نبی ﷽ کی کھانے پر دعوت کی ، اور عرض کیا یا رسول اللہ ﷽ ! میری خواہش ہے کہ آپ میرے گھر میں کھانا کھائیں اور اس میں نماز بھی پڑھیں ، چنانچہ نبی ﷽ تشریف لائے ، وہاں گھر میں ایک چٹائی پڑی ہوئی تھی جو پرانی ہو کر کالی ہو چکی تھی ، نبی ﷽ نے اسے ایک کونے میں رکھنے کا حکم دیا ، اسے جھاڑا گیا اور اس پر پانی چھڑک دیا گیا ، پھر نبی ﷽ نے وہاں نماز پڑھی اور ہم نے بھی نبی ﷽ کے ساتھ نماز پڑھی ۔"
"12329","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ بدر کے دن نبی ﷽ نے ارشاد فرمایا کون جا کر دیکھے گا کہ ابوجہل کا کیا بنا آ حضرت ابن مسعود رضی اللہ عنہ اس خدمت کے لئے چلے گئے ، انہوں نے دیکھا کہ عفراء کے دونوں بیٹوں نے اسے مار مار کر ٹھنڈا کر دیا ہے ، حضرت ابن مسعود رضی اللہ عنہ نے ابوجہل کی ڈاڑھی پکڑ کر فرمایا کیا تو ہی ابوجہل ہے آ اس نے کہا کیا تم نے مجھ سے بڑے بھی کسی آدمی کو قتل کیا ہے آ"
"12330","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک انصاری عورت + اپنے بچے کے ساتھ , نبی ﷽ کی خدمت میں حاضر ہوئی ، نبی ﷽ نے اس سے تخلیہ میں فرمایا اس ذات کی قسم جس کے دست قدرت میں میری جان ہے ، تم لوگ مجھے تمام لوگوں میں سب سے زیادہ محبوب ہو ، یہ جملہ تین مرتبہ فرمایا ۔"
"12331","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے انصار کے متعلق فرمایا تم لوگ مجھے تمام لوگوں میں سب سے زیادہ محبوب ہو ۔"
"12332","بکیر بن وہب رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ مجھ سے حضرت انس رضی اللہ عنہ نے فرمایا کہ میں تم سے ایک ایسی حدیث بیان کرتا ہوں جو میں ہر ایک سے بیان نہیں کرتا ، اور وہ یہ کہ ایک مرتبہ نبی ﷽ ایک گھر کے دروازے پر کھڑے ہوئے ، ہم اس کے اندر تھے اور فرمایا امراء قریش میں سے ہوں گے ، اور ان کا تم پر حق بنتا ہے ، اور ان پر تمہارا بھی اسی طرح حق بنتا ہے ، جب ان سے لوگ رحم کی درخواست کریں تو رحم کا معاملہ کریں ، وعدہ کریں تو پورا کریں ، فیصلہ کریں تو انصاف کریں ، جو شخص ایسا نہ کرے اس پر اللہ کی ، فرشتوں اور تمام لوگوں کی لعنت ہے ۔"
"12333","حمزہ رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ حضرت انس رضی اللہ عنہ نے ان سے فرمایا کیا میں تم سے ایک حدیث نہ بیان کروں کہ اللہ تمہیں اس سے فائدہ پہنچائے اور وہ یہ کہ نبی ﷽ جب کسی منزل پر پڑاا کرتے تو ظہر کی نماز پڑھنے سے پہلے وہاں سے کوچ نہیں کرتے تھے ، محمد بن عمر رضی اللہ عنہ نے حضرت انس رضی اللہ عنہ سے پوچھا اگرچہ نصف النہار کے وقت میں ہو آ انہوں نے فرمایا ہاں ! اگرچہ نصف النہار کے وقت ہی ہو ۔"
"12334","حمزہ رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ دریائے نیل کے کنارے حضرت انس رضی اللہ عنہ سے میری ملاقات ہو گئی ، میرے اور ان کے درمیان محمد بن عمرو تھے ، پھر راوی نے مکمل حدیث ذکر کی ۔"
"12335","ابوفزارہ رحمۃ اللہ کہتے ہیں کہ میں نے ایک مرتبہ حضرت انس رضی اللہ عنہ سے مغرب سے پہلے دو رکعتوں کے متعلق پوچھا تو انہوں نے فرمایا کہ ہم نبی ﷽ کے دور باسعادت میں ان کی طرف سبقت کیا کرتے تھے ، اس کے بعد دوبارہ پوچھا تو انہوں نے نبی ﷽ کے دور باسعادت کا تذکرہ نہیں کیا ۔"
"12336","ابوصدقہ """" جو حضرت انس رضی اللہ عنہ کے آزاد کردہ غلام ہیں """" کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے نبی ﷽ کی نماز کے متعلق پوچھا تو انہوں نے فرمایا کہ نبی ﷽ ظہر کی نماز زوال کے بعد پڑھتے تھے ، عصر ان دو نمازوں کے درمیان پڑھتے تھے ، مغرب غروب آفتاب کے وقت پڑھتے تھے اور نماز عشاء شفق غائب ہو جانے کے بعد پڑھتے تھے اور نماز فجر اس وقت پڑھتے تھے جب طلوع فجر ہو جائے یہاں تک کہ نگاہیں کھل جائیں ۔"
"12337","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا قیامت کے دن ایک جہنمی سے """" جسے سب سے ہلکا عذاب ہو گا """" کہا جائے گا کہ یہ بتا ، اگر تیرے پاس روئے زمین کی ہر چیز موجود ہو تو کیا تو وہ سب کچھ اپنے فدیے میں دے دے گا آ وہ کہے گا ہاں ! اللہ فرمائے گا کہ میں نے تو تجھ سے دنیا میں اس سے بھی ہلکی چیز کا مطالبہ کیا تھا ، میں نے آدم کی پشت میں تجھ سے وعدہ لیا تھا کہ میرے ساتھ کسی کو شریک نہ ٹھہرائے گا لیکن تو شرک کیے بغیر نہ مانا ۔"
"12338","یحیی بن یزید رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے قصر نماز کے متعلق دریافت کیا تو انہوں نے فرمایا کہ جب میں کوفہ کی طرف نکلتا تھا تو واپسی تک دو رکعتیں ہی پڑھتا تھا ، اور نبی ﷽ جب تین میل یا تین فرسخ کی مسافت پر نکلتے تو دو رکعتیں پڑھتے تھے ۔"
"12339","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کا وقت ہو گیا ، نبی ﷽ ایک آدمی کے ساتھ مسجد میں تنہائی میں گفتگو فرما رہے تھے ، یہاں تک کہ لوگ سو گئے ، پھر نبی ﷽ نے اپنے صحابہ کو نماز پڑھائی ۔"
"12340","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور ان کی اہلیہ محترمہ ایک ہی برتن سے غسل کر لیا کرتے تھے ۔"
"12341","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا ایمان کی علامت انصار سے محبت کرنا ہے اور نفاق کی علامت انصار سے بغض رکھنا ہے ۔"
"12342","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا صبر تو صدمہ کے آغاز میں ہی ہوتا ہے + اس کے بعد تو سب ہی کو صبر آ جاتا ہے ,"
"12343","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ایک عورت کی قبر پر نماز جنازہ پڑھی جو دفن ہو چکی تھی ۔"
"12344","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اللہ تعالی فرماتے ہیں اگر میرا بندہ بالشت برابر میرے قریب ہوتا ہے تو میں ایک گز کے برابر اس کے قریب ہو جاتا ہوں اور اگر وہ ایک گز کے برابر میرے قریب ہوتا ہے تو میں ایک ہاتھ کے برابر اس کے قریب ہو جاتا ہوں ، اور اگر وہ میرے پاس چل کر آتا ہے تو میں اس کے پاس دوڑ کر آتا ہوں ۔"
"12345","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک مرتبہ حضرت ابی بن کعب رضی اللہ عنہ سے فرمایا کہ اللہ نے مجھے حکم دیا ہے کہ """" ®الم یکن الذین کفروا¾ """" والی سورت تمہیں پڑھ کر سنااں ، حضرت ابی بن کعب رضی اللہ عنہ نے عرض کیا کہ کیا اللہ نے میرا نام لے کر کہا ہے آ نبی ﷽ نے فرمایا ہاں ! یہ سن کر ابی بن کعب رضی اللہ عنہ رو پڑے ۔"
"12346","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا رکوع و سجود کو مکمل کیا کرو ، کیونکہ میں بخدا تمہیں اپنی پشت کے پیچھے سے بھی دیکھ رہا ہوتا ہوں ۔"
"12347","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا میں اور قیامت ان دو انگلیوں کی طرح اکٹھے بھیجے گئے ہیں ، + یہ کہہ کر نبی ﷽ نے شہادت والی انگلی اور درمیانی انگلی کی طرف اشارہ فرمایا , ۔"
"12348","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا بدشگونی کی کوئی حیثیت نہیں ، البتہ مجھے فال یعنی اچھا اور پاکیزہ کلمہ اچھا لگتا ہے ۔"
"12349","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کے پاس گوشت لایا گیا اور بتایا گیا کہ یہ + حضرت عائشہ رضی اللہ عنہا کی باندی , بریرہ کے پاس صدقہ میں آیا ہے ، تو نبی ﷽ نے فرمایا یہ اس کے لیے صدقہ ہے اور ہمارے لیے ہدیہ ہے ۔"
"12350","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے کبھی میز پر یا چھوٹی پیالیوں میں کھانا نہیں کھایا اور نہ ہی کبھی آپ ﷽ کے لیے باریک روٹی پکائی گئی ، راوی نے پوچھا کہ پھر وہ کس چیز پر رکھ کر کھانا کھاتے تھے آ انہوں نے بتایا کہ دسترخوانوں پر ۔"
"12351","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کا وصال ساٹھ سال کی عمر میں ہوا ہے ، اس وقت نبی ﷽ کی مبارک ڈاڑھی میں بیس بال بھی سفید نہ تھے ۔"
"12352","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا میری امت کی مثال بارش کی سی ہے کہ کچھ معلوم نہیں اس کا آغاز بہتر ہے یا انجام ۔"
"12353","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے میری کنیت اس سبزی کے نام پر رکھی تھی جو میں چنتا تھا ۔"
"12354","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی بڑا بھاری بھر کم تھا ، وہ نبی ﷽ کے ساتھ نماز پڑھنے کے لئے بار بار نہیں آ سکتا تھا ، اس نے نبی ﷽ سے عرض کیا کہ میں بار بار آپ کے ساتھ آ کر نماز پڑھنے کی طاقت نہیں رکھتا ، اگر آپ کسی دن میرے گھر تشریف لا کر کسی جگہ نماز پڑھ دیں تو میں وہیں پر نماز پڑھ لیا کروں گا ، چنانچہ اس نے ایک مرتبہ دعوت کا اہتمام کر کے نبی ﷽ کو بلایا ، اور ایک چٹائی کے کونے پر پانی چھڑک دیا ، نبی ﷽ نے وہاں دو رکعتیں پڑھ دیں ، آل جارود میں سے ایک آدمی نے یہ سن کر حضرت انس رضی اللہ عنہ سے پوچھا کیا نبی ﷽ چاشت کی نماز پڑھتے تھے آ انہوں نے فرمایا کہ میں نے نبی ﷽ کو وہ نماز صرف اسی دن پڑھتے ہوئے دیکھا تھا ۔"
"12355","[Darussalam 12330] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12356","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ عصر کی نماز اس وقت پڑھتے تھے جب سورج روشن اور اپنے حلقے کی شکل میں ہوتا تھا ۔"
"12357","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت معاذ بن جبل رضی اللہ عنہ سے فرمایا یاد رکھو ! جو شخص ®لا الہ الا اللہ¾ کی گواہی دیتا ہوا فوت ہو جائے ، وہ جنت میں داخل ہو گا ۔"
"12358","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا آسانیاں پیدا کیا کرو ، مشکلات پیدا نہ کرو ، سکون دلایا کرو ، نفرت نہ پھیلایا کرو ۔"
"12359","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا میں اور قیامت ان دو انگلیوں کی طرح اکٹھے بھیجے گئے ہیں ، یہ کہہ کر نبی ﷽ نے شہادت والی انگلی اور درمیانی انگلی کی طرف اشارہ فرمایا ۔"
"12360","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مسجد نبوی کی تعمیر سے پہلے نبی ﷽ بکریوں کے باڑے میں بھی نماز پڑھ لیا کرتے تھے ۔"
"12361","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے کبیرہ گناہوں کا تذکرہ کرتے ہوئے فرمایا کہ وہ یہ ہیں ، اللہ کے ساتھ کسی کو شریک ٹھہرانا ، ناحق قتل کرنا ، والدین کی نافرمانی کرنا ، اور فرمایا کہ کیا میں تمہیں سب سے بڑا کبیرہ گناہ نہ بتااں آ وہ ہے جھوٹی بات یا جھوٹی گواہی ۔"
"12362","سیار کہتے ہیں کہ میں ثابت بنانی رحمۃ اللہ کے ساتھ چلا جا رہا تھا ، راستے میں ان کا گذر کچھ بچوں پر ہوا ، انہوں نے انہیں سلام کیا اور بتایا کہ میں حضرت انس رضی اللہ عنہ کے ساتھ چلا جا رہا تھا ، راستے میں ان کا گذر کچھ بچوں پر ہوا ، انہوں نے انہیں سلام کیا اور بتایا کہ میں نبی ﷽ کے ساتھ چلا جا رہا تھا ، راستے میں ان کا گذر کچھ بچوں پر ہوا ، انہوں نے انہیں سلام کیا ۔"
"12363","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے کھڑے ہو کر پانی پینے سے منع فرمایا ہے ، ہم نے حضرت انس رضی اللہ عنہ سے کھانے کا حکم پوچھا تو انہوں نے فرمایا کہ یہ تو اور بھی سخت ہے ۔"
"12364","عبدالحمید بن محمود کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ کے ساتھ ایک مرتبہ جمعہ کی نماز پڑھی ، ہمیں ستونوں کی طرف جگہ ملی جس کی بناء پر ہم آگے پیچھے ہو گئے ، حضرت انس رضی اللہ عنہ نے فرمایا ہم نبی ﷽ کے دور باسعادت میں اس سے بچا کرتے تھے ۔"
"12365","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ان کی دادی حضرت ملیکہ نے ایک مرتبہ نبی ﷽ کی کھانے پر دعوت کی ، نبی ﷽ نے کھانا تناول فرمانے کے بعد فرمایا اٹھو ، میں تمہارے لیے نماز پڑھ دوں ، حضرت انس رضی اللہ عنہ کہتے ہیں کہ میں اٹھ کر ایک چٹائی لے آیا جو طویل عرصہ استعمال ہونے کی وجہ سے سیاہ ہو چکی تھی ، میں نے اس پر پانی چھڑک دیا ، نبی ﷽ اس پر کھڑے ہو گئے ، میں اور ایک یتیم بچہ نبی ﷽ کے پیچھے کھڑے ہو گئے اور بڑی بی ہمارے پیچھے کھڑی ہو گئیں ، پھر نبی ﷽ نے ہمیں دو رکعتیں پڑھائیں اور واپس تشریف لے گئے ۔"
"12366","قتادہ رحمۃ اللہ کہتے ہیں کہ میں نے ایک مرتبہ حضرت انس رضی اللہ عنہ سے نبی ﷽ کی قراءت کی کیفیت کے متعلق پوچھا تو انہوں نے فرمایا کہ نبی ﷽ اپنی آواز کو کھینچا کرتے تھے ۔"
"12367","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قیامت کے دن اہل جنت میں سے ایک آدمی کو لایا جائے گا ، اللہ تعالیٰ اس سے پوچھے گا کہ اے ابن آدم ! تو نے اپنا ٹھکانہ کیسا پایا آ وہ جواب دے گا پروردگار ! بہترین ٹھکانہ پایا ، اللہ تعالیٰ فرمائے گا کہ مانگ اور تمنا ظاہر کر ، وہ عرض کرے گا کہ میری درخواست اور تمنا تو صرف اتنی ہی ہے کہ آپ مجھے دنیا میں واپس بھیج دیں اور میں دسیوں مرتبہ آپ کی راہ میں شہید ہو جااں ، کیونکہ وہ شہادت کی فضیلت دیکھ چکا ہو گا ۔"
"12368","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کو راستے میں کھجور پڑی ہوئی ملتی اور انہیں یہ اندیشہ نہ ہوتا کہ یہ صدقہ کی ہو گی تو وہ اسے کھا لیتے تھے ۔"
"12369","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت ابن ام مکتوم رضی اللہ عنہ کو مدینہ منورہ میں اپنا جانشین دو مرتبہ بنایا تھا اور میں نے حضرت ابن ام مکتوم رضی اللہ عنہ کو جنگ قادسیہ کے دن سیاہ رنگ کا جھنڈا تھامے ہوئے دیکھا ۔"
"12370","حضرت انس رضی اللہ عنہ سے مروی ہے کہ صحابہ کرام رضی اللہ عنہم کی نگاہوں میں نبی ﷽ سے زیادہ محبوب کوئی شخص نہ تھا ، لیکن وہ نبی ﷽ کو دیکھ کر کھڑے نہ ہوتے تھے کیونکہ وہ جانتے تھے کہ نبی ﷽ اسے اچھا نہیں سمجھتے ۔"
"12371","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ ہر نماز کے وقت نیا وضو فرماتے تھے ، راوی نے حضرت انس رضی اللہ عنہ سے پوچھا کہ آپ لوگ کیا کرتے تھے آ انہوں نے جواب دیا کہ ہم بے وضو ہونے تک ایک ہی وضو سے کئی کئی نمازیں بھی پڑھ لیا کرتے تھے ۔"
"12372","زبیر بن عدی رحمۃ اللہ کہتے ہیں کہ ہم نے حضرت انس رضی اللہ عنہ سے حجاج بن یوسف کے مظالم کی شکایت کی ، انہوں نے فرمایا صبر کرو ، کیونکہ ہر سال یا دن کے بعد آنے والا سال اور دن اس سے بدتر ہو گا ، یہاں تک کہ تم اپنے رب سے جا ملو ، میں نے یہ بات تمہارے نبی ﷽ سے سنی ہے ۔"
"12373","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز عصر کا وقت قریب آ گیا ، لوگوں نے وضو کے لئے پانی تلاش کیا لیکن پانی نہیں ملا ، نبی ﷽ کے پاس وضو کا جو پانی لایا گیا ، نبی ﷽ نے اس کے برتن میں اپنا دست مبارک رکھ دیا اور لوگوں کو اس پانی سے وضو کرنے کا حکم دے دیا ، میں نے دیکھا کہ نبی ﷽ کی انگلیوں کے نیچے سے پانی ابل رہا ہے ، اور لوگ اس سے وضو کرتے رہے یہاں تک کہ سب لوگوں نے وضو کر لیا ۔"
"12374","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوبکر و عمر و عثمان رضی اللہ عنہ تکبیر مکمل کیا کرتے تھے ، جب سجدے میں جاتے یا سر اٹھاتے تب بھی تکبیر کہا کرتے تھے ۔"
"12375","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ کے راستے میں ایک صبح یا شام جہاد کرنا دنیا و مافیھا سے بہتر ہے ۔"
"12376","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دشمن پر طلوع فجر کے وقت حملے کی تیاری کرتے تھے ، اور کان لگا کر سنتے تھے ، اگر وہاں سے اذان کی آواز سنائی دیتی تو رک جاتے ورنہ حملہ کر دیتے ، ایک دن اسی طرح نبی ﷽ نے کان لگا کر سنا تو ایک آدمی کے ®اللہ اکبر¾ ، ®اللہ اکبر¾ کہنے کی آواز سنائی دی ، نبی ﷽ نے فرمایا فطرت سلیمہ پر ہے ، پھر جب اس نے اشھد ان ®لا الہ الا اللہ¾ کہا تو فرمایا کہ تو جہنم کی آگ سے نکل گیا ۔"
"12377","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا پہلے اگلی پھر اس کے بعد والی صفوں کو مکمل کیا کرو اور کوئی کمی ہو تو وہ آخری صف میں ہونی چاہئے ۔"
"12378","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو چاشت کی نماز پڑھتے ہوئے نہیں دیکھا الاِ یہ کہ آپ ﷽ سفر پر جا رہے ہوں یا سفر سے واپس آ رہے ہوں ۔"
"12379","حضرت انس رضی اللہ عنہ سے مروی ہے کہ یہودیوں میں جب کسی عورت کو """" ایام """" آتے تو وہ لوگ ان کے ساتھ نہ کھاتے پیتے تھے اور نہ ایک گھر میں اکٹھے ہوتے تھے ، صحابہ کرام رضی اللہ عنہم نے اس کے متعلق نبی ﷽ سے دریافت کیا تو اللہ تعالیٰ نے یہ آیت نازل فرما دی کہ """" یہ لوگ آپ سے ایام والی عورت کے متعلق سوال کرتے ہیں ، آپ فرما دیجئے کہ """" ایام """" بذات خود بیماری ہے ، اس لئے ان ایام میں عورتوں سے الگ رہو اور پاک ہونے تک ان سے قربت نہ کرو """" یہ آیت مکمل پڑھنے کے بعد نبی ﷽ نے فرمایا صحبت کے علاوہ سب کچھ کر سکتے ہو ، یہودیوں کو جب یہ بات معلوم ہوئی تو وہ کہنے لگے کہ یہ آدمی تو ہر بات میں ہماری مخالفت ہی کرتا ہے ۔ پھر حضرت اسید بن حضیر رضی اللہ عنہ اور عباد بن بشیر رضی اللہ عنہ ، نبی ﷽ کی خدمت میں حاضر ہوئے اور کہنے لگے یا رسول اللہ ﷽ ! یہودی ایسے ایسے کہہ رہے ہیں ، کیا ہم اپنی بیویوں سے قربت بھی نہ کر لیا کریں آ + تاکہ یہودیوں کی مکمل مخالفت ہو جائے , یہ سن کر نبی ﷽ کے روئے انور کا رنگ بدل گیا ، اور ہم یہ سمجھنے لگے کہ نبی ﷽ ان سے ناراض ہو گئے ہیں ، وہ دونوں بھی وہاں سے چلے گئے ، لیکن کچھ ہی دیر بعد نبی ﷽ کے پاس کہیں سے دودھ کا ہدیہ آیا تو نبی ﷽ نے ان دونوں کو بلا بھیجا اور انہیں وہ پلا دیا ، اس طرح وہ سمجھ گئے کہ نبی ﷽ ان سے ناراض نہیں ہیں ۔ امام احمد رحمۃ اللہ فرماتے ہیں کہ حماد بن سلمہ رحمۃ اللہ اپنی احادیث میں سے کسی حدیث کی سند کی تعریف نہیں کرتے تھے ، لیکن اس حدیث کی سند کی عمدگی کی بناء پر اس کی بہت تعریف کرتے تھے ۔"
"12380","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے کسریٰ ، قیصر اور دومۃ الجندل کے بادشاہ اکیدر کو الگ الگ خط لکھا جس میں انہیں اللہ کی طرف بلایا گیا تھا ۔"
"12381","ثمامہ بن عبداللہ سے مروی ہے کہ حضرت انس رضی اللہ عنہ خوشبو رد نہیں کرتے تھے اور فرماتے تھے کہ نبی ﷽ کی خدمت میں جب خوشبو پیش کی جاتی تو آپ ﷽ اسے رد نہ فرماتے تھے ۔"
"12382","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا ہر امت کا ایک امین ہوتا ہے اور ابوعبیدہ اس امت کے امین ہیں ۔"
"12383","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ کے صاحبزادے حضرت ابراہیم رضی اللہ عنہ اگر زندہ رہتے تو صدیق اور نبی ہوتے ۔"
"12384","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نماز پڑھ کر دائیں جانب سے واپس گئے تھے ۔"
"12385","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ کے پاس ایک مرتبہ وہ جو کی روٹی اور پرانا روغن لے کر آئے تھے ۔"
"12386","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ کی زرہ ایک یہودی کے پاس مدینہ منورہ میں گروی رکھی ہوئی تھی ، نبی ﷽ نے اس سے اپنے اہل خانہ کے لیے جو لیے تھے ۔"
"12387","اور میں نے ایک دن انہیں یہ فرماتے ہوئے سنا کہ آج شام کو آل محمد + ﷽ , کے پاس غلے یا گندم کا ایک صاع بھی نہیں ہے ، اس وقت نبی ﷽ کی نو ازواج مطہرات تھیں ۔"
"12388","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا کچھ لوگ اپنے گناہوں کی وجہ سے جہنم میں داخل کیے جائیں گے ، جب وہ جل کر کوئلہ ہو جائیں گے تو اللہ تعالی اپنے فضل و کرم سے انہیں جنت میں داخل کر دے گا ، + اہل جنت پوچھیں گے کہ یہ کون لوگ ہیں آ انہیں , بتایا جائے گا کہ یہ جہنمی ہیں ۔"
"12389","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا میرے حوض کے دونوں کناروں کا درمیانی فاصلہ اتنا ہے جتنا مدینہ اور صنعاء یا مدینہ اور عمان کے درمیان ہے ۔"
"12390","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ کو میں نے دیکھا کہ حلاق آپ کے بال کاٹ رہا ہے ، اور صحابہ کرام رضی اللہ عنہم اردگرد کھڑے ہیں اور ان کی خواہش ہے کہ نبی ﷽ کا جو بال بھی گرے وہ کسی آدمی کے ہاتھ پر ہی گرے ۔ + زمین پر نہ گرے ,"
"12391","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ ہر نماز کے وقت نیا وضو فرماتے تھے ، راوی نے حضرت انس رضی اللہ عنہ سے پوچھا کہ آپ لوگ کیا کرتے تھے آ انہوں نے جواب دیا کہ ہم بے وضو ہونے تک ایک ہی وضو سے کئی کئی نمازیں بھی پڑھ لیا کرتے تھے ۔"
"12392","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کے دور باسعادت میں بارش ہوئی ، نبی ﷽ نے باہر نکل کر اپنے کپڑے جسم کے اوپر والے حصے سے ہٹا دیئے تاکہ بارش کا پانی جسم تک بھی پہنچ جائے ، کسی نے پوچھا یا رسول اللہ ﷽ ! آپ نے ایسا کیوں کیا آ فرمایا کہ یہ بارش اپنے رب کے پاس سے تازہ تازہ آئی ہے ۔"
"12393","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب آیت حجاب نازل ہو گئی تب بھی میں حسب سابق ایک مرتبہ نبی ﷽ کے گھر میں داخل ہونے لگا ، تو نبی ﷽ نے فرمایا بیٹا ! پیچھے رہو + اجازت لے کر اندر آا ,"
"12394","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک آدمی کے چہرے پر پیلا رنگ لگا ہوا دیکھا تو اس پر ناگواری ظاہر فرمائی اور فرمایا کہ اگر تم اس شخص کو یہ رنگ دھو دینے کا حکم دیتے تو کیا ہی اچھا ہوتا آ اور نبی ﷽ کی یہ عادت مبارکہ تھی کہ کسی کے سامنے اس طرح کا چہرہ لے کر نہ آتے تھے جس سے ناگواری کا اظہار ہوتا ہو ۔"
"12395","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور ان کی اہلیہ محترمہ ایک ہی برتن سے غسل کر لیا کرتے تھے ۔"
"12396","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا نفاق کی علامت انصار سے بغض رکھنا ہے اور ایمان کی علامت انصار سے محبت کرنا ہے ۔"
"12397","حضرت انس رضی اللہ عنہ سے مروی ہے کہ صحابہ کرام رضی اللہ عنہم کی نگاہوں میں نبی ﷽ سے زیادہ محبوب کوئی شخص نہ تھا ، لیکن وہ نبی ﷽ کو دیکھ کر کھڑے نہ ہوتے تھے کیونکہ وہ جانتے تھے کہ نبی ﷽ اسے اچھا نہیں سمجھتے ۔"
"12398","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ سے کبیرہ گناہوں کے متعلق پوچھا گیا تو نبی ﷽ نے فرمایا کہ وہ یہ ہیں ، اللہ کے ساتھ کسی کو شریک ٹھہرانا ، ناحق قتل کرنا ، والدین کی نافرمانی کرنا ، اور جھوٹی بات یا جھوٹی گواہی دینا ۔"
"12399","قتادہ رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ نبی ﷽ نے کتنے حج کیے تھے آ انہوں نے فرمایا کہ ایک مرتبہ حج کیا تھا اور چار مرتبہ عمرہ ، ایک عمرہ تو حدیبیہ کے زمانے میں ، دوسرا ذیقعدہ کے مہینے میں مدینہ سے ، تیسرا عمرہ ذیقعدہ ہی کے مہینے میں جعرانہ سے جب کہ آپ ﷽ نے غزوہ حنین کا مال غنیمت تقسیم کیا تھا اور چوتھا عمرہ حج کے ساتھ کیا تھا ۔"
"12400","قتادہ رحمۃ اللہ کہتے ہیں کہ ہم لوگ حضرت انس رضی اللہ عنہ کی خدمت میں حاضر ہوا کرتے تھے ، ان کے یہاں نانبائی مقرر تھا ، ایک دن وہ ہم سے فرمانے لگے کھاا ، البتہ میرے علم میں نہیں ہے کہ نبی ﷽ نے کبھی اپنی آنکھوں سے باریک روٹی کو دیکھا بھی ہو ، یا کبھی سالم بھنی ہوئی بکری کھائی ہو ۔"
"12401","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب حدیبیہ سے واپس آ رہے تھے تو صحابہ کرام رضی اللہ عنہم پر غم اور پریشانی کے آثار تھے کیونکہ انہیں عمرہ ادا کرنے سے روک دیا گیا تھا اور انہیں حدیبیہ میں ہی اپنے جانور قربان کرنے پڑے تھے ، اس موقع پر آپ ﷽ پر یہ آیت نازل ہوئی ®انا فتحنا لک فتحا مبینا ۔۔۔۔۔۔ ۔ صراطا مستقیما¾ نبی ﷽ نے فرمایا مجھ پر دو آیتیں ایسی نازل ہوئی ہیں جو مجھے ساری دنیا سے زیادہ محبوب ہیں ، پھر نبی ﷽ نے ان کی تلاوت فرمائی ، تو ایک مسلمان نے یہ سن کر کہا یا رسول اللہ ﷽ ! آپ کو مبارک ہو کہ اللہ نے آپ کو یہ دولت عطاء فرمائی ، ہمارے لیے کیا حکم ہے آ اس پر یہ آیت نازل ہوئی ®لیدخل المومنین والمومنات جنات ۔۔۔۔۔۔ ۔ فوزا عظیما¾ ۔"
"12402","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا کچھ لوگ جہنم میں داخل کیے جائیں گے ، جب وہ جل کر کوئلہ ہو جائیں گے تو انہیں جنت میں داخل کر دیا جائے گا ، اہل جنت ان کا نام رکھ دیں گے کہ یہ جہنمی ہیں ۔"
"12403","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا ہر نبی کی ایک دعاء ایسی ضرور تھی جو انہوں نے مانگی اور قبول ہو گئی ، جب کہ میں نے اپنی دعاء اپنی امت کی سفارش کرنے کی خاطر قیامت کے دن کے لئے محفوظ کر رکھی ہے ۔"
"12404","قتادہ رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ نبی ﷽ کو کون سا لباس پسند تھا آ انہوں نے فرمایا دھاری دار یمنی چادر ۔"
"12405","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے کچی اور پکی کھجور کو اکٹھا کر کے + نبیذ بنانے سے , منع فرمایا ہے ۔"
"12406","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قیامت اس وقت تک قائم نہ ہو گی جب تک لوگ مساجد کے بارے میں ایک دوسرے پر فخر نہ کرنے لگیں ۔"
"12407","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جہنم مسلسل یہ کہتی رہے گی کہ کوئی اور بھی ہے تو لے آا ، یہاں تک کہ پروردگار عالم اس میں اپنا پااں لٹکا دے گا اس وقت اس کے حصے ایک دوسرے کے ساتھ مل کر سکڑ جائیں گے اور وہ کہے گی کہ تیری عزت کی قسم ! بس ، بس ، اسی طرح جنت میں بھی جگہ زائد بچ جائے گی ، حتیٰ کہ اللہ اس کے لئے ایک اور مخلوق کو پیدا کر کے جنت کے باقی ماندہ حصے میں اسے آباد کر دے گا ۔"
"12408","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ فرمایا کرتے تھے اسلام ظاہر کا نام ہے اور ایمان دل میں ہوتا ہے ، پھر اپنے سینے کی طرف تین مرتبہ اشارہ کر کے فرمایا کہ تقویٰ یہاں ہوتا ہے ۔"
"12409","قتادہ رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے نبی ﷽ کے بالوں کے متعلق دریافت کیا تو انہوں نے فرمایا کہ نبی ﷽ کے بال ہلکے گھنگریالے تھے ، نہ بہت زیادہ گھنگریالے اور نہ بہت زیادہ سیدھے ، اور وہ کانوں اور کندھوں کے درمیان تک ہوتے تھے ۔"
"12410","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ہمیں کوئی خطبہ ایسا نہیں دیا جس میں یہ نہ فرمایا ہو کہ اس شخص کا ایمان نہیں جس کے پاس امانت داری نہ ہو اور اس شخص کا دین نہیں جس کے پاس وعدہ کی پاسداری نہ ہو ۔"
"12411","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت عتبان رضی اللہ عنہ کی آنکھیں شکایت کرنے لگیں ، انہوں نے نبی ﷽ کے پاس پیغام بھیج کر اپنی مصیبت کا ذکر کیا ، اور عرض کیا یا رسول اللہ ﷽ ! میرے گھر تشریف لا کر نماز پڑھ دیجئے تاکہ میں اسی جگہ کو اپنی جائے نماز بنا لوں ، چنانچہ ایک دن نبی ﷽ اپنے کچھ صحابہ رضی اللہ عنہم کے ساتھ ان کے یہاں تشریف لے گئے ، نبی ﷽ نماز پڑھنے کھڑے ہو گئے اور صحابہ کرام رضی اللہ عنہم آپس میں باتیں کرنے لگے ، اور منافقین کی طرف سے پہنچنے والی تکالیف کا ذکر کرنے لگے ، اور اس میں سب سے زیادہ حصہ دار مالک بن دخیشم کو قرار دینے لگے ، نبی ﷽ نے نماز سے فارغ ہو کر فرمایا کیا وہ اس بات کی گواہی نہیں دیتا کہ اللہ کے علاوہ کوئی معبود نہیں اور میں اللہ کا رسول ہوں آ ایک آدمی نے کہا کیوں نہیں ، لیکن یہ دل سے نہیں ہے ، نبی ﷽ نے فرمایا جو شخص اس بات کی گواہی دے کہ اللہ کے علاوہ کوئی معبود نہیں اور یہ کہ میں اللہ کا رسول ہوں تو جہنم کی آگ اسے ہرگز نہیں کھا سکے گی ۔"
"12412","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اچھے خوابوں سے خوش ہوتے تھے اور بعض اوقات پوچھتے تھے کہ تم میں سے کسی نے کوئی خواب دیکھا ہے آ اگر کسی نے کوئی خواب دیکھا ہوتا تو وہ نبی ﷽ سے اس کی تعبیر دریافت کر لیتا ، اگر اس میں کوئی پریشانی کی بات نہ ہوتی تو نبی ﷽ اس سے بھی خوش ہوتے ، اسی تناظر میں ایک عورت آئی اور کہنے لگی یا رسول اللہ ﷽ ! میں نے خواب میں دیکھا کہ گویا میں جنت میں داخل ہوئی ہوں ، میں نے وہاں ایک آواز سنی جس سے جنت بھی ہلنے لگی ، اچانک میں نے دیکھا کہ فلاں بن فلاں اور فلاں بن فلاں کو لایا جا رہا ہے ، یہ کہتے ہوئے اس نے بارہ آدمیوں کے نام گنوائے جنہیں نبی ﷽ نے اس سے پہلے ایک سریہ میں روانہ فرمایا تھا ۔ اس خاتون نے بیان کیا کہ جب انہیں وہاں لایا گیا تو ان کے جسم پر جو کپڑے تھے ، وہ کالے ہو چکے تھے اور ان کی رگیں پھولی ہوئی تھیں ، کسی نے ان سے کہا کہ ان لوگوں کو نہر سدخ یا نہر بیدخ میں لے جاا ، چنانچہ انہوں نے اس میں غوطہ لگایا اور جب باہر نکلے تو ان کے چہرے چودہویں رات کے چاند کی طرح چمک رہے تھے ، پھر سونے کی کرسیاں لائی گئیں ، وہ ان پر بیٹھ گئے ، پھر ایک تھالی لائی گئی جس میں کچی کھجوریں تھیں ، وہ ان کھجوروں کو کھانے لگے ، اس دوران وہ جس کھجور کو پلٹتے تھے تو حسب منشاء میوہ کھانے کو ملتا تھا ، اور میں بھی ان کے ساتھ کھاتی رہی ۔ کچھ عرصے بعد اس لشکر سے ایک آدمی فتح کی خوشخبری لے کر آیا ، اور کہنے لگا یا رسول اللہ ﷽ ! ہمارے ساتھ ایسا ایسا معاملہ پیش آیا اور فلاں فلاں آدمی شہید ہو گئے ، یہ کہتے ہوئے اس نے انہی بارہ آدمیوں کے نام گنوا دئیے جو عورت نے بتائے تھے ، نبی ﷽ نے فرمایا اس عورت کو میرے پاس دوبارہ بلا کر لاا ، وہ آئی تو نبی ﷽ نے اس سے فرمایا کہ اپنا خواب اس آدمی کے سامنے بیان کرو ، اس نے بیان کیا تو وہ کہنے لگا کہ اس نے نبی ﷽ سے جس طرح بیان کیا ہے ، حقیقت بھی اسی طرح ہے ۔"
"12413","[Darussalam 12386] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12414","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے زمین پر اپنی انگلیاں رکھ کر فرمایا یہ ابن آدم ہے ، پھر انہیں اٹھا کر تھوڑا سا پیچھے رکھا اور فرمایا کہ یہ اس کی موت ہے ، پھر اپنا ہاتھ آگے کر کے تین مرتبہ فرمایا کہ یہ اس کی امیدیں ہیں ۔"
"12415","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ سردی کے ایام میں نماز پڑھاتے تھے تو ہمیں کچھ پتہ نہ چلتا تھا کہ دن کا اکثر حصہ گذر گیا ہے یا باقی ہے ۔"
"12416","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے بال کانوں سے آگے نہ بڑھتے تھے ۔"
"12417","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جنت میں ایک درخت ایسا بھی ہے جس کے سائے میں اگر کوئی سوار سو سال تک چلتا رہے تب بھی اس کا سایہ ختم نہ ہو ۔"
"12418","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا دنیا کی عورتوں میں حضرت مریم بنت عمران علیہا السلام ، خدیجہ بنت خویلد رضی اللہ عنہا ، فاطمہ بنت محمد + ﷽ , اور فرعون کی بیوی آسیہ ہی کافی ہیں ۔"
"12419","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت صفیہ رضی اللہ عنہا کو پتہ چلا کہ حضرت حفصہ رضی اللہ عنہا نے ان کے متعلق کہا ہے کہ وہ یہودی کی بیٹی ہے ، اس پر وہ رونے لگیں ، اتفاقاَ نبی ﷽ تشریف لائے تو وہ رو رہی تھیں ، نبی ﷽ نے پوچھا کیا ہوا آ انہوں نے بتایا کہ حفصہ نے میرے متعلق کہا ہے کہ میں ایک یہودی کی بیٹی ہوں ، نبی ﷽ نے فرمایا تم ایک نبی کی نسل میں بیٹی ہو ، تمہارے چچا بھی اگلی نسل میں نبی تھے اور تم خود ایک نبی کے نکاح میں ہو ، اور تم کس چیز پر فخر کرنا چاہتی ہو ، اور حضرت حفصہ رضی اللہ عنہا سے فرمایا کہ حفصہ ! اللہ سے ڈرا کرو ۔"
"12420","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت جلیبیب رضی اللہ عنہ کے لئے ایک انصاری عورت سے نکاح کا پیغام اس کے والد کے پاس بھیجا ، اس نے کہا کہ میں پہلے لڑکی کی والدہ سے مشورہ کر لوں ، نبی ﷽ نے فرمایا بہت اچھا ، وہ آدمی اپنی بیوی کے پاس گیا اور اس سے اس بات کا تذکرہ کیا ، اس نے فوراَ انکار کرتے ہوئے کہہ دیا بخدا ! کسی صورت میں نہیں ، نبی ﷽ کو جلیبیب کے علاوہ اور کوئی نہیں ملا ، ہم نے تو فلاں فلاں رشتے سے انکار کر دیا تھا ، ادھر وہ لڑکی اپنے پردے میں سے سن رہی تھی ۔ باہم صلاح و مشورے کے بعد جب وہ آدمی نبی ﷽ کو اس سے مطلع کرنے کے لئے روانہ ہونے لگا تو وہ لڑکی کہنے لگی کہ کیا آپ لوگ نبی ﷽ کی بات کو رد کریں گے ، اگر نبی ﷽ کی رضا مندی اس میں شامل ہے تو آپ نکاح کر دیں ، یہ کہہ کر اس نے اپنے والدین کی آنکھیں کھول دیں اور وہ کہنے لگے کہ تم سچ کہہ رہی ہو ، چنانچہ اس کا باپ نبی ﷽ کی خدمت میں حاضر ہوا اور کہنے لگا کہ اگر آپ اس رشتے سے راضی ہیں تو ہم بھی راضی ہیں ، نبی ﷽ نے فرمایا کہ میں راضی ہوں ، چنانچہ نبی ﷽ نے جلیبیب سے اس لڑکی کا نکاح کر دیا ، کچھ ہی عرصے بعد اہل مدینہ پر حملہ ہوا ، جلیبیب بھی سوار ہو کر نکلے ، فراغت کے بعد لوگوں نے دیکھا کہ وہ شہید ہو چکے ہیں اور ان کے اردگرد مشرکیں کی کئی لاشیں پڑی ہیں جنہیں انہوں نے تنہا قتل کیا تھا ۔ حضرت انس رضی اللہ عنہ کہتے ہیں کہ میں نے اس لڑکی کو دیکھا ہے کہ وہ مدینہ منورہ میں سب سے زیادہ خرچ کرنے والے گھر کی خاتون تھی ۔"
"12421","حضرت انس رضی اللہ عنہ سے مروی ہے کہ بنی تمیم کا ایک آدمی نبی ﷽ کی خدمت میں حاضر ہوا اور کہنے لگا یا رسول اللہ ﷽ ! میں بہت مالدار ، اہل و عیال اور خاندان والا آدمی ہوں ، آپ مجھے یہ بتائیے کہ میں کیسے خرچ کروں اور کس کام پر کروں آ نبی ﷽ نے فرمایا اپنے مال کی زکوٰۃ نکالا کرو کہ اس سے تمہارا مال پاکیزہ ہو جائے گا ، اپنے قریبی رشتہ داروں سے صلہ رحمی کیا کرو ، سائل ، پڑوسی اور مسکینوں کا حق پہنچایا کرو ، اس نے کہا یا رسول اللہ ﷽ ! کچھ کم کر دیجیئے نبی ﷽ نے فرمایا پھر قریبی رشتہ داروں ، مسکینوں اور مسافروں کو ان کا حق دیا کرو اور فضول خرچی نہ کیا کرو ، وہ کہنے لگا یا رسول اللہ ﷽ ! بس یہ میرے لیے کافی ہے ، جب میں اپنے مال کی زکوٰۃ آپ کے قاصد کے حوالے کر دوں تو اللہ اور اس کے رسول کی نگاہوں میں میں بری ہو جااں گا آ نبی ﷽ نے فرمایا ہاں ! جب تم میرے قاصد کو زکوٰۃ ادا کر دو تو تم اس سے عہدہ برآ ہو گئے اور تمہیں اس کا اجر ملے گا اور گناہ اس کے ذمے ہو گا جو اس میں تبدیلی کر دے ۔"
"12422","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب مدینہ منورہ تشریف لائے تو وہاں کی آب و ہوا گرم تھی جس کی وجہ سے لوگ بخار میں مبتلاء ہو گئے ، ایک دن نبی ﷽ مسجد میں داخل ہوئے تو دیکھا کہ لوگ بیٹھ کر نماز پڑھ رہے ہیں ، نبی ﷽ نے فرمایا بیٹھ کر نماز پڑھنے کا ثواب کھڑے ہو کر پڑھنے سے آدھا ہے ، اس پر لوگ لپک کر کھڑے ہو کر نماز پڑھنے لگے ۔"
"12423","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ ہمارے یہاں تشریف لائے اور قیلولہ کے لئے لیٹ گئے ، + گرمی کی وجہ سے , آپ ﷽ کو پسینہ آنے لگا ، میری والدہ یہ دیکھ کر ایک شیشی لائیں اور وہ پسینہ اس میں ٹپکانے لگیں ، نبی ﷽ بیدار ہوئے تو پوچھا کہ ام سلیم ! یہ کیا کر رہی ہو آ انہوں نے کہا کہ آپ کے اس پسینے کو ہم اپنی خوشبو میں شامل کریں گے اور یہ سب سے بہترین خوشبو ہو گی ۔"
"12424","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا قیامت کے دن میں جنت کے دروازے پر آ کر اسے کھلوااں گا ، داروغہ جنت پوچھے گا کون آ میں کہوں گا محمد + ﷽ , وہ کہے گا کہ مجھے یہی حکم دیا گیا ہے کہ آپ سے پہلے کسی کے لئے دروازہ نہ کھولوں ۔"
"12425","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت بسیسہ رضی اللہ عنہ کو ابوسفیان کے لشکر کی خبر لانے کے لئے جاسوس بنا کر بھیجا ، وہ واپس آئے تو گھر میں میرے اور نبی ﷽ کے علاوہ کوئی نہ تھا ، نبی ﷽ باہر نکلے اور لوگوں سے اس حوالے سے بات کی اور فرمایا کہ ہم قافلے کی تلاش میں نکل رہے ہیں جس کے پاس سواری موجود ہو ، وہ ہمارے ساتھ چلے ، کچھ لوگوں نے اجازت چاہی کہ مدینہ کے بالائی حصے سے اپنی سواری لے آئیں ، لیکن نبی ﷽ نے فرمایا کہ نہیں ، جس کی سواری موجود ہو وہ چلے + انتظار نہیں کریں گے , چنانچہ نبی ﷽ اپنے صحابہ رضی اللہ عنہم کے ساتھ روانہ ہوئے اور مشرکین سے پہلے بدر کے کنویں پر پہنچ گئے ۔ وہاں پہنچ کر نبی ﷽ نے فرمایا تم میں سے کوئی شخص بھی میری اجازت کے بغیر کسی چیز کی طرف قدم آگے نہ بڑھائے ، جب مشرکین قریب آئے تو نبی ﷽ نے فرمایا کہ اس جنت کی طرف لپکو جس کی صرف چوڑائی ہی زمین و آسمان کے برابر ہے ، یہ سن کر عمیر بن حمام انصاری کہنے لگے یا رسول اللہ ﷽ ! کیا جنت کی چوڑائی زمین و آسمان کے برابر ہے آ نبی ﷽ نے فرمایا ہاں ! اس پر وہ کہنے لگے واہ واہ ! نبی ﷽ نے پوچھا کہ کس بات پر واہ واہ کہہ رہے ہو آ انہوں نے کہا یا رسول اللہ ﷽ ! خدا کی قسم صرف اس امید پر کہ میں اس کا اہل بن جااں ، نبی ﷽ نے فرمایا کہ تم اہل جنت میں سے ہو ، پھر عمیر اپنے ترکش سے کچھ کھجوریں نکال کر کھانے لگے ، پھر اچانک ان کے دل میں خیال آیا کہ اگر میں ان کھجوروں کو کھانے تک زندہ رہا تو یہ بڑی لمبی زندگی ہو گی ، چنانچہ وہ کھجوریں ایک طرف رکھ کر میدان کارزار میں گھس پڑے اور اتنا لڑے کہ بالآخر شہید ہو گئے ۔"
"12426","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب یہ آیت نازل ہوئی کہ """" اے اہل ایمان ! نبی کی آواز پر اپنی آواز کو اونچا نہ کیا کرو """" تو حضرت ثابت بن قیس رضی اللہ عنہ """" جن کی آواز قدرتی طور پر اونچی تھی """" کہنے لگے کہ میری ہی آواز نبی ﷽ کی آواز سے اونچی ہوتی ہے ، اس لئے میرے سارے اعمال ضائع ہو گئے ، اور میں جہنمی بن گیا ، اور یہ سوچ کر اپنے گھر میں ہی غمگین ہو کر بیٹھ رہے ، ایک دن نبی ﷽ نے ان کی غیر حاضری کے متعلق دریافت کیا تو کچھ لوگ ان کے پاس آئے اور کہنے لگے کہ نبی ﷽ تمہاری غیر حاضری کے متعلق پوچھ رہے تھے ، کیا بات ہے آ وہ کہنے لگے کہ میں ہی تو وہ ہوں جس کی آواز نبی ﷽ کی آواز سے اونچی ہوتی ہے اور میں بات کرتے ہوئے اونچا بولتا ہوں ، اس لئے میرے سارے اعمال ضائع ہو گئے اور میں جہنمی ہو گیا ، لوگوں نے یہی بات نبی ﷽ سے آ کر ذکر کر دی ، نبی ﷽ نے فرمایا نہیں بلکہ وہ تو جنتی ہے ۔ حضرت انس رضی اللہ عنہ کہتے ہیں کہ وہ ہمارے درمیان چلتے تھے اور ہمیں یقین تھا کہ وہ جنتی ہیں ، جنگ یمامہ کے دن ہماری صفوں میں کچھ انتشار پیدا ہوا تو حضرت ثابت بن قیس رضی اللہ عنہ آئے ، اس وقت انہوں نے اپنے جسم پر حنوط مل رکھی تھی اور کفن پہنا ہوا تھا اور فرمانے لگے تم اپنے ہم نشینوں کی طرف برا لوٹے ہو ، یہ کہہ کر وہ لڑتے لڑتے اتنا آگے بڑھ گئے کہ بالآخر شہید ہو گئے ۔"
"12427","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ کو میں نے دیکھا کہ حلاق آپ ﷽ کے بال کاٹ رہا ہے ، اور صحابہ کرام رضی اللہ عنہم اردگرد کھڑے ہیں اور ان کی خواہش ہے کہ نبی ﷽ کا جو بال بھی گرے وہ کسی آدمی کے ہاتھ پر ہی گرے ۔ + زمین پر نہ گرے ,"
"12428","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب فجر کی نماز پڑھ چکتے تو اہل مدینہ کے خدام اپنے اپنے برتن پانی سے بھر کر لاتے ، نبی ﷽ ہر برتن میں اپنا ہاتھ ڈال دیتے تھے ، بعض اوقات سردی کا موسم ہوتا تب بھی نبی ﷽ اپنے اس معمول کو پورا فرماتے تھے ۔"
"12429","ثابت کہتے ہیں کہ ایک مرتبہ ہم لوگ حضرت انس رضی اللہ عنہ کے پاس بیٹھے ہوئے تھے ، انہوں نے اپنے اہل خانہ کے لئے ایک خط لکھا ، اور فرمایا اے گروہ قراء ! تم اس پر گواہ رہو ، مجھے یہ بات اچھی نہ لگی ، میں نے عرض کیا کہ اے ابوحمزہ ! اگر آپ ان کے نام بتا دیں تو کیا ہی اچھا ہو آ انہوں نے فرمایا کہ اگر میں نے تمہیں قراء کہہ دیا تو اس میں کوئی حرج تو نہیں ہے ، کیا میں تمہیں اپنے ان بھائیوں کا واقعہ نہ سنااں جنہیں ہم نبی ﷽ کے دور باسعادت میں قراء کہتے تھے ۔ وہ سترا افراد تھے ، جو رات ہونے پر مدینہ منورہ میں اپنے ایک استاذ کے پاس چلے جاتے اور صبح ہونے تک ساری رات پڑھتے رہتے ، صبح ہونے کے بعد جس میں ہمت ہوتی وہ میٹھا پانی پی کر لکڑیاں کاٹنے چلا جاتا ، جن لوگوں کے پاس گنجائش ہوتی وہ اکٹھے ہو کر بکری خرید کر اسے کاٹ کر صاف ستھرا کرتے اور صبح ہی کے وقت نبی ﷽ کے حجروں کے پاس اسے لٹکا دیتے ۔ جب حضرت خبیب رضی اللہ عنہ شہید ہو گئے ، تو نبی ﷽ نے انہیں روانہ فرمایا ، یہ لوگ بنی سلیم کے ایک قبیلے میں پہنچے ، ان میں میرے ایک ماموں """" حرام """" بھی تھے ، انہوں نے اپنے امیر سے کہا کہ مجھے اجازت دیجئے کہ میں انہیں جا کر بتا دوں کہ ہم ان سے کوئی تعرض نہیں کرنا چاہتے تاکہ یہ ہمارا راستہ چھوڑ دیں اور اجازت لے کر ان لوگوں سے یہی کہا ، ابھی وہ یہ پیغام دے ہی رہے تھے کہ سامنے سے ایک آدمی ایک نیزہ لے کر آیا اور ان کے آر پار کر دیا ، جب وہ نیزہ ان کے پیٹ میں گھونپا گیا تو وہ یہ کہتے ہوئے گر پڑے اللہ اکبر ، رب کعبہ کی قسم ! میں کامیاب ہو گیا ، پھر ان پر حملہ ہوا اور ان میں سے ایک آدمی بھی باقی نہ بچا ۔ نبی ﷽ کو میں نے اس واقعے پر جتنا غمگین دیکھا ، کسی اور واقعے پر اتنا غمگین نہیں دیکھا ، اور میں نے دیکھا کہ نبی ﷽ فجر کی نماز میں ہاتھ اٹھا کر ان کے خلاف بددعاء فرماتے تھے ، کچھ عرصے بعد حضرت ابوطلحہ رضی اللہ عنہ نے مجھ سے فرمایا کہ کیا میں تمہیں """" حرام """" کے قاتل کا پتہ بتااں آ میں نے کہا ضرور بتائیے ، اللہ اس کے ساتھ ایسا ایسا کرے ، انہوں نے فرمایا رکو ، کیونکہ وہ مسلمان ہو گیا ہے ۔"
"12430","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک مرتبہ حضرت ابی بن کعب رضی اللہ عنہ سے فرمایا کہ اللہ نے مجھے حکم دیا ہے کہ تمہیں قرآن پڑھ کر سنااں ، حضرت ابی بن کعب رضی اللہ عنہ نے عرض کیا کہ کیا اللہ نے میرا نام لے کر کہا ہے آ نبی ﷽ نے فرمایا ہاں ! یہ سن کر حضرت ابی بن کعب رضی اللہ عنہ رو پڑے ۔"
"12431","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ رات کے وقت حضرت اسید بن حضیر رضی اللہ عنہ اور ایک دوسرے صاحب اپنے کسی کام سے نبی ﷽ کے پاس بیٹھے گفتگو کر رہے تھے ، اس دوران رات کا کافی حصہ بیت گیا اور وہ رات بہت تاریک تھی ، جب وہ نبی ﷽ سے رخصت ہو کر نکلے تو ان کے ہاتھ میں ایک ایک لاٹھی تھی ، ان میں سے ایک آدمی کی لاٹھی روشن ہو گئی اور وہ اس کی روشنی میں چلنے لگے ، جب دونوں اپنے اپنے راستے پر جدا ہونے لگے تو دوسرے کی لاٹھی بھی روشن ہو گئی اور ہر آدمی اپنی اپنی لاٹھی کی روشنی میں چلتا ہوا اپنے گھر پہنچ گیا ۔"
"12432","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اللہ تعالیٰ فرماتے ہیں اے ابن آدم ! اگر تو مجھے اپنے دل میں یاد کرے گا تو میں تجھے اپنے دل میں یاد کروں گا ، اگر تو کسی مجلس میں میرا تذکرہ کرے گا تو میں اس سے بہتر ، فرشتوں کی مجلس میں تیرا تذکرہ کروں گا ، اگر تو بالشت برابر میرے قریب آئے گا تو میں ایک گز کے برابر تیرے قریب ہو جااں گا اور اگر تو ایک گز کے برابر میرے قریب آئے گا تو میں ایک ہاتھ کے برابر تیرے قریب ہو جااں گا اور اگر تو میرے پاس چل کر آئے گا تو میں تیرے پاس دوڑ کر آاں گا ۔"
"12433","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ حضرت سعد بن عبادہ رضی اللہ عنہ کے یہاں تشریف لے گئے اور اجازت لے کر """" السلام علیکم ورحمۃ اللہ """" کہا ، حضرت سعد رضی اللہ عنہ نے آہستہ آواز سے """" جو نبی ﷽ کے کانوں تک نہ پہنچی """" اس کا جواب دیا ، حتیٰ کہ نبی ﷽ نے تین مرتبہ سلام کیا اور تینوں مرتبہ انہوں نے اس طرح جواب دیا کہ نبی ﷽ نہ سن سکے ، چنانچہ نبی ﷽ واپس لوٹ گئے ، حضرت سعد رضی اللہ عنہ بھی پیچھے دوڑے اور کہنے لگے یا رسول اللہ ﷽ ! میرے ماں باپ آپ پر قربان ہوں ، آپ نے جتنی مرتبہ بھی سلام کیا ، میں نے اپنے کانوں سے سنا اور میں نے اس کا جواب دیا لیکن آپ کو نہیں سنایا + آواز آہستہ رکھی , میں چاہتا تھا کہ آپ کی سلامتی اور برکت کی دعاء کثرت سے حاصل کروں ، پھر وہ نبی ﷽ کو اپنے گھر لے گئے اور کشمش پیش کی ، نبی ﷽ نے اسے تناول کرنے کے بعد فرمایا تمہارا کھانا نیک لوگ کھاتے رہیں ، تم پر ملائکہ رحمت کی دعائیں کرتے رہیں اور روزہ دار تمہارے یہاں افطار کرتے رہیں ۔"
"12434","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نماز میں اشارہ کر دیتے تھے ۔"
"12435","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ سفر میں نماز ظہر اور عصر اور نماز مغرب و عشاء اکٹھی پڑھ لیتے تھے ۔"
"12436","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب خیبر کو فتح کر چکے تو حجاج بن علاط رضی اللہ عنہ کہنے لگے یا رسول اللہ ﷽ ! مکہ مکرمہ میں میرا کچھ مال و دولت اور اہل خانہ ہیں ، میں ان کے پاس جانے کا ارادہ رکھتا ہوں + تاکہ انہیں یہاں لے آاں , کیا مجھے آپ کی طرف سے اس بات کی اجازت ہے کہ میں آپ کے حوالے سے یونہی کوئی بات اڑا دوں آ نبی ﷽ نے انہیں اجازت دے دی کہ جو چاہیں کہیں ، چنانچہ وہ مکہ مکرمہ پہنچ کر اپنی بیوی کے پاس آئے اور اس سے کہنے لگے کہ تمہارے پاس جو کچھ ہے ، سب اکٹھا کر کے مجھے دے دو ، میں چاہتا ہوں کہ محمد + ﷽ , اور ان کے ساتھیوں کا مال غنیمت خرید لوں کیونکہ ان کا خوب قتل عام ہوا ہے اور ان کا سب مال و دولت لوٹ لیا گیا ہے ، یہ خبر پورے مکہ میں پھیل گئی ، مسلمانوں کی کمر ٹوٹ گئی اور مشرکین خوشی کے شادیانے بجانے لگے ، حضرت عباس رضی اللہ عنہ کو بھی یہ خبر معلوم ہوئی تو وہ گر پڑے اور ان کے اندر کھڑا ہونے کی ہمت نہ رہی ، پھر انہوں نے ایک بیٹے """" قثم """" کو بلایا ، اور چت لیٹ کر اسے اپنے سینے پر بٹھا کر یہ شعر پڑھنے لگے کہ میرا پیارا بیٹا قثم خوشبودار ناک والے کا ہم شکل ہے ، جو ناز و نعمت میں پلنے والوں کا بیٹا ہے اگرچہ کسی کی ناک ہی خاک آلود ہوتی ہو ۔ پھر انہوں نے ایک غلام حجاج بن علاط رضی اللہ عنہ کے پاس بھیجا اور فرمایا کہ افسوس ! یہ تم کیسی خبر لائے ہو اور کیا کہہ رہے ہو آ اللہ نے تو جو وعدہ کیا ہے وہ تمہاری اس خبر سے بہت بہتر ہے ، حجاج نے اس غلام سے کہا کہ ابوالفضل + حضرت عباس رضی اللہ عنہ کو میرا سلام کہنا اور یہ پیغام پہنچانا کہ اپنے کسی گھر میں میرے لیے تخلیہ کا موقع فراہم کریں تاکہ میں ان کے پاس آ سکوں کیونکہ خبر ہی ایسی ہے کہ وہ خوش ہو جائیں گے ، وہ غلام واپس پہنچ کر جب گھر کے دروازے تک پہنچا تو کہنے لگا کہ اے ابوالفضل ! خوش ہو جائیے ، یہ سن کر حضرت عباس رضی اللہ عنہ خوشی سے اچھل پڑے اور اس کی دونوں آنکھوں کے درمیان بوسہ دیا ، غلام نے انہیں حجاج کی بات بتائی تو انہوں نے اسے آزاد کر دیا ۔ تھوڑی دیر بعد حجاج ان کے پاس آئے اور انہیں بتایا کہ نبی ﷽ خیبر کو فتح کر چکے ہیں ، ان کے مال کو غنیمت بنا چکے ، اللہ کا مقرر کردہ حصہ ان میں جاری ہو چکا ، اور نبی ﷽ نے صفیہ بنت حیی کو اپنے لیے منتخب کر لیا ، اور انہیں اختیار دے دیا کہ نبی ﷽ انہیں آزاد کر دیں اور وہ ان کی بیوی بن جائیں یا اپنے اہل خانہ کے پاس واپس چلی جائیں ، انہوں نے اس بات کو ترجیح دی کہ نبی ﷽ انہیں آزاد کر دیں اور وہ ان کی بیوی بن جائیں ، لیکن میں اپنے اس مال کی وجہ سے """" جو یہاں پر تھا """" آیا تھا تاکہ اسے جمع کر کے لے جااں ، میں نے نبی ﷽ سے اجازت لے لی تھی اور آپ ﷽ نے مجھے اس بات کی اجازت دے دی تھی کہ میں جو چاہوں کہہ سکتا ہوں ، اب آپ یہ خبر تین دن تک مخفی رکھئے ، اس کے بعد مناسب سمجھیں تو ذکر کر دیں ۔ اس کے بعد انہوں نے اپنی بیوی کے پاس جو کچھ زیورات اور سازو سامان تھا اور جو اس نے جمع کر رکھا تھا ، اس نے وہ سب ان کے حوالے کیا اور وہ اسے لے کر روانہ ہو گئے ، تین دن گزرنے کے بعد حضرت عباس رضی اللہ عنہ حجاج کی بیوی کے پاس آئے اور اس سے پوچھا کہ تمہارے شوہر کا کیا بنا آ اس نے بتایا کہ وہ فلاں دن چلے گئے اور کہنے لگی کہ اے ابوالفضل ! اللہ آپ کو شرمندہ نہ کرے ، آپ کی پریشانی ہم پر بھی بڑی شاق گزری ہے ، انہوں نے فرمایا ہاں ! اللہ مجھے شرمندہ نہ کرے ، اور الحمدللہ ! ہوا وہی کچھ ہے جو ہم چاہتے تھے ، اللہ نے اپنے نبی کے ہاتھ پر خیبر کو فتح کروا دیا ، مال غنیمت کی تقسیم ہو چکی اور نبی ﷽ نے صفیہ بنت حیی کو اپنے لیے منتخب فرما لیا ، اب اگر تمہیں اپنے خاوند کی ضرورت ہو تو اس کے پاس چلی جاا ، وہ کہنے لگی کہ بخدا ! میں آپ کو سچا ہی سمجھتی ہوں ، انہوں نے فرمایا کہ میں نے تمہیں جو کچھ بتایا ہے وہ سب سچ ہے ۔ پھر حضرت عباس رضی اللہ عنہ وہاں سے چلے گئے اور قریش کی مجلسوں کے پاس سے گذرے ، وہ کہنے لگے ابوالفضل ! تمہیں ہمیشہ خیر ہی حاصل ہو ، انہوں نے فرمایا الحمدللہ ! مجھے خیر ہی حاصل ہوئی ہے ، مجھے حجاج بن علاط نے بتایا ہے کہ خیبر کو اللہ نے اپنے پیغمبر کے ہاتھوں فتح کروا دیا ہے ، مال غنیمت تقسیم ہو چکا ، نبی ﷽ نے صفیہ کو اپنے لیے منتخب کر لیا ، اور حجاج نے مجھ سے درخواست کی تھی کہ تین دن تک میں یہ خبر مخفی رکھوں ، وہ تو صرف اپنا مال اور ساز و سامان یہاں سے لینے کے لئے آئے تھے ، پھر واپس چلے گئے ، اس طرح مسلمانوں پر غم کی جو کیفیت تھی ، وہ اللہ نے مشرکین پر الٹا دی ، اور مسلمان اور وہ تمام لوگ جو اپنے گھروں میں غمگین ہو کر پڑ گئے تھے ، اپنے اپنے گھروں سے نکل آئے اور حضرت عباس رضی اللہ عنہ کے پاس پہنچے ، انہوں نے انہیں سارا واقعہ سنایا ، جس پر مسلمان بہت خوش ہوئے اور اللہ نے وہ غم و غصہ مشرکین پر لوٹا دیا ۔"
"12437","عاصم رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ کے پاس نبی ﷽ کا ایک پیالہ دیکھا جس میں چاندی کا حلقہ لگا ہوا تھا ۔"
"12438","حمید رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ کے پاس نبی ﷽ کا ایک پیالہ دیکھا جس میں چاندی کا حلقہ لگا ہوا تھا ۔"
"12439","ثابت رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ میں نے حضرت انس رضی اللہ عنہ سے عرض کیا کہ اے ابوحمزہ ! ہمیں کوئی ایسا عجیب واقعہ بتائیے جس میں آپ خود موجود ہوں اور آپ کسی کے حوالے سے اسے بیان نہ کرتے ہوں آ انہوں نے فرمایا کہ ایک مرتبہ نبی ﷽ نے ظہر کی نماز پڑھائی ، اور جا کر اس جگہ پر بیٹھ گئے جہاں حضرت جبریل علیہ السلام ان کے پاس آیا کرتے تھے ، پھر حضرت بلال رضی اللہ عنہ نے آ کر عصر کی اذان دی ، ہر وہ آدمی جس کا مدینہ منورہ میں گھر تھا وہ اٹھ کر قضاء حاجت اور وضو کے لئے چلا گیا ، کچھ مہاجرین رہ گئے جن کا مدینہ میں کوئی گھر نہ تھا ، نبی ﷽ کی خدمت میں ایک کشادہ برتن پانی کا لایا گیا ، نبی ﷽ نے اپنی ہتھیلیاں اس میں رکھ دیں لیکن اس برتن میں اتنی گنجائش نہ تھی ، لہٰذا نبی ﷽ نے چار انگلیاں ہی رکھ کر فرمایا قریب آ کر اس سے وضو کرو ، اس وقت نبی ﷽ کا دست مبارک برتن میں ہی تھا ، چنانچہ ان سب نے اس سے وضو کر لیا ، اور ایک آدمی بھی ایسا نہ رہا جس نے وضو نہ کیا ہو ۔ میں نے پوچھا کہ اے ابوحمزہ ! آپ کی رائے میں وہ کتنے لوگ تھے آ انہوں نے فرمایا ستر سے اسی کے درمیان ۔"
"12440","[Darussalam 12413] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12441","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ انصار میں کچھ کھیت تقسیم ہوئے ، وہ لوگ اکٹھے ہو کر نبی ﷽ کے پاس یہ درخواست لے کر آئے کہ انہیں ایک جاری نہر میں سے پانی لینے کی اجازت دی جائے ، وہ اس کا کرایہ ادا کر دیں گے ، نبی ﷽ نے فرمایا انصار کو خوش آمدید ! بخدا ! آج تم مجھ سے جو مانگو گے میں تمہیں دوں گا اور میں اللہ سے تمہارے لیے جس چیز کا سوال کروں گا ، اللہ وہ مجھے ضرور عطاء فرمائے گا ، یہ سن کر وہ ایک دوسرے سے کہنے لگے موقع غنیمت سمجھو اور اپنے گناہوں کی معافی کا مطالبہ کر لو ، چنانچہ وہ کہنے لگے یا رسول اللہ ﷽ ! ہمارے لیے اللہ سے بخشش کی دعاء کر دیجئے ، نبی ﷽ نے فرمایا اے اللہ ! انصار کی انصار کے بچوں کی اور انصار کے بچوں کے بچوں کی مغفرت فرما ۔"
"12442","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب نبی ﷽ دنیا سے رخصت ہو گئے تو اس وقت مدینہ میں ایک صاحب بغلی قبر بناتے تھے اور دوسرے صاحب صندوقی قبر ، لوگوں نے سوچا کہ ہم اپنے رب سے خیر طلب کرتے ہیں اور دونوں کے پاس ایک ایک آدمی بھیج دیتے ہیں ، جو نہ مل سکا اسے چھوڑ دیں گے ، چنانچہ انہوں نے دونوں کے پاس ایک ایک آدمی بھیج دیا ، لحد بنانے والے صاحب مل گئے اور انہوں نے نبی ﷽ کے لئے لحد کھودی ۔"
"12443","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مجھے حضرت ابوطلحہ رضی اللہ عنہ نے نبی ﷽ کی موجودگی میں داغا لیکن نبی ﷽ نے مجھے اس سے منع نہیں فرمایا ۔"
"12444","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نبی ﷽ کی خدمت میں حاضر ہوا تو آپ ﷽ اپنی چارپائی پر لیٹے ہوئے تھے جسے کھجور کی بٹی ہوئی رسی سے باندھا گیا تھا ، اور آپ ﷽ کے سر مبارک کے نیچے چمڑے کا ایک تکیہ تھا جس میں چھال بھری ہوئی تھی ، اسی اثناء میں چند صحابہ کرام رضی اللہ عنہم بھی آ گئے جن میں حضرت عمر رضی اللہ عنہ بھی تھے ، نبی ﷽ پلٹ کر اٹھے تو حضرت عمر رضی اللہ عنہ کو نبی ﷽ کے پہلو اور رسی کے درمیان کوئی کپڑا نظر نہ آیا اسی وجہ سے اس کے نشانات نبی ﷽ کے مبارک پہلو پر پڑ گئے تھے ، یہ دیکھ کر حضرت عمر رضی اللہ عنہ رونے لگے ، نبی ﷽ نے فرمایا عمر ! کیوں روتے ہو آ انہوں نے عرض کیا بخدا ! میں صرف اس لئے روتا ہوں کہ میں جانتا ہوں کہ اللہ کی نگاہوں میں آپ قیصر و کسریٰ سے کہیں زیادہ معزز ہیں اور وہ دنیا میں عیاشی کر رہے ہیں ، جب کہ آپ یا رسول اللہ ﷽ ! اس جگہ پر ہیں جو میں دیکھ رہا ہوں ، نبی ﷽ نے فرمایا کیا تم اس بات پر راضی نہیں ہو کہ ان کے لئے دنیا ہو اور ہمارے لیے آخرت آ انہوں نے عرض کیا کیوں نہیں ، نبی ﷽ نے فرمایا تو پھر اسی طرح ہو گا ۔"
"12445","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا میرے پاس حوض کوثر پر دو ایسے آدمی بھی آئیں گے جنہوں نے میری ہم نشینی پائی ہو گی ، لیکن جب میں انہیں دیکھوں گا کہ وہ میرے سامنے پیش ہوئے ہیں تو انہیں اچک لیا جائے گا ۔"
"12446","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا میں جنت کے متعلق سب سے پہلا سفارش کرنے والا ہوں گا ۔"
"12447","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نبی ﷽ کے پاس آیا اور عزل کے متعلق سوال کرنے لگا ، نبی ﷽ نے فرمایا """" پانی """" کا وہ قطرہ جس سے بچہ پیدا ہوتا ہو ، اگر کسی چٹان پر بھی بہا دیا جائے تو اللہ اس سے بھی بچہ پیدا کر سکتا ہے ، اور اللہ اس شخص کو پیدا کر کے رہتا ہے جسے وہ پیدا کرنا چاہتا ہے ۔"
"12448","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے احد پہاڑ کا تذکرہ کرتے ہوئے فرمایا کہ اس پہاڑ سے ہم محبت کرتے ہیں اور یہ ہم سے محبت کرتا ہے ۔"
"12449","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے لوٹ مار کرنے سے منع کرتے ہوئے فرمایا ہے کہ جو شخص لوٹ مار کرتا ہے ، وہ ہم میں سے نہیں ہے ۔"
"12450","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے کجھور اور کشمش یا کچی اور پکی کھجور کو اکٹھا کر کے نبیذ بنانے سے منع فرمایا ہے ۔"
"12451","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا تہبند نصف پنڈلی تک یا ٹخنوں تک ہونا چاہئے ، اس سے نیچے ہونے میں کوئی خیر نہیں ہے ۔"
"12452","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ اپنے گھر میں بیٹھے ہوئے تھے کہ ایک آدمی آ کر کسی سوراخ سے اندر جھانکنے لگا ، نبی ﷽ نے اپنے ہاتھ میں پکڑی ہوئی کنگھی اسے دے ماری تو وہ آدمی پیچھے ہٹ گیا ۔"
"12453","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا لوگوں کو کیا ہو گیا ہے کہ دورانْ نماز آسمان کی طرف نگاہیں اٹھا کر دیکھتے ہیں آ نبی ﷽ نے شدت سے اس کی ممانعت کرتے ہوئے فرمایا کہ لوگ اس سے باز آ جائیں ، ورنہ ان کی بصارت اچک لی جائے گی ۔"
"12454","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک یہودی نے نبی ﷽ کو سلام کرتے ہوئے ®السام علیک¾ کہا ، نبی ﷽ نے صحابہ رضی اللہ عنہم سے فرمایا اسے میرے پاس بلا کر لاا ، اور اس سے پوچھا کہ کیا تم نے ®السام علیک¾ کہا تھا آ اس نے اقرار کیا تو نبی ﷽ نے + اپنے صحابہ رضی اللہ عنہم سے , فرمایا جب تمہیں کوئی """" کتابی """" سلام کرے تو صرف """" وعلیک """" کہا کرو ۔"
"12455","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا بلال کی اذان تمہیں سحری کھانے سے نہ روکا کرے کیونکہ ان کی بصارت میں کچھ ہے ۔"
"12456","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قیامت اس وقت تک قائم نہ ہو گی جب تک بارشیں خوب کثرت سے نہ ہوں ، لیکن زمین سے پیداوار بالکل نہ ہو گی ۔"
"12457","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نبی ﷽ کی مجلس میں بیٹھا ہوا تھا کہ وہاں سے ایک آدمی کا گذر ہوا ، بیٹھے ہوئے لوگوں میں سے کسی نے کہا یا رسول اللہ ﷽ ! میں اس شخص سے محبت کرتا ہوں ، نبی ﷽ نے اس سے فرمایا کیا تم نے اسے یہ بات بتائی بھی ہے آ اس نے کہا نہیں ، نبی ﷽ نے فرمایا پھر جا کر اسے بتا دو ، اس پر وہ آدمی کھڑا ہوا اور جا کر اس سے کہنے لگا کہ بھائی ! میں اللہ کی رضا کے لئے آپ سے محبت کرتا ہوں ، اس نے جواب دیا کہ جس ذات کی خاطر تم مجھ سے محبت کرتے ہو ، وہ تم سے محبت کرے ۔"
"12458","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے ایک آدمی حضرت حفصہ بنت عمر رضی اللہ عنہا کے حوالے کیا اور فرمایا اس کی نگرانی کرنا ، حضرت حفصہ رضی اللہ عنہا غافل ہوئیں تو وہ آدمی کھسک گیا ، نبی ﷽ واپس تشریف لائے تو پوچھا حفصہ ! وہ آدمی کیا ہوا آ انہوں نے کہا یا رسول اللہ ﷽ ! میں غافل ہو گئی اور وہ بھاگ گیا ، نبی ﷽ نے فرمایا اللہ کرے تمہارے ہاتھ ٹوٹ جائیں ، نبی ﷽ کے جانے کے بعد انہوں نے اپنے ہاتھ اونچے کر لیے ، تھوڑی دیر بعد نبی ﷽ دوبارہ آئے تو پوچھا حفصہ ! تمہیں کیا ہوا آ انہوں نے کہا یا رسول اللہ ﷽ ! آپ نے کچھ دیر پہلے مجھے ایسے ایسے کہا تھا ، نبی ﷽ نے فرمایا اپنے ہاتھ کھول لو ، میں نے اللہ سے یہ کہہ رکھا ہے کہ میں اپنی امت میں سے جس شخص کو کوئی بددعا دوں ، وہ اسے اس کے حق میں مغفرت کا سبب بنا دے ۔"
"12459","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نبی ﷽ کے پاس آیا اور کہنے لگا کہ میں سورہ اخلاص سے محبت رکھتا ہوں ، نبی ﷽ نے فرمایا تمہارا اس سورت سے محبت کرنا تمہیں جنت میں داخل کروا دے گا ۔"
"12460","[Darussalam 12433] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12461","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب نبی ﷽ پر موت کی شدت طاری ہوئی تو حضرت فاطمہ رضی اللہ عنہا نبی ﷽ کی اس کیفیت کو دیکھ کر کہنے لگیں ، ہائے تکلیف ! نبی ﷽ نے اس پر فرمایا بیٹا ! تمہارے باپ پر جو کیفیت طاری ہو رہی ہے ، قیامت تک آنے والے کسی انسان سے اللہ اسے معاف کرنے والا نہیں ہے ۔"
"12462","[Darussalam 12435] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12463","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ کے راستے میں ایک صبح یا شام کو جہاد کے لیے نکلنا دنیا و مافیھا سے بہتر ہے ، اور تم میں سے کسی کے کمان یا کوڑا رکھنے کی جنت میں جو جگہ ہو گی ، وہ دنیا و مافیہا سے بہتر ہے ، اور اگر کوئی جنتی عورت زمین کی طرف جھانک کر دیکھ لے تو ان دونوں کی درمیانی جگہ خوشبو سے بھر جائے ، اور مہک پھیل جائے اور اس کے سر کا دوپٹہ دنیا و مافیہا سے بہتر ہے ۔"
"12464","[Darussalam 12437] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12465","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مدینہ منورہ میں حضرت ابوطلحہ رضی اللہ عنہ سب سے زیادہ مالدار انصاری تھے ، اور انہیں اپنے سارے مال میں """" بیرحاء """" نامی باغ """" جو مسجد کے سامنے تھا ، اور نبی ﷽ بھی اس میں تشریف لے جاتے اور وہاں کا عمدہ پانی نوش فرماتے تھے """" سب سے زیادہ محبوب تھا ، جب یہ آیت نازل ہوئی کہ """" تم نیکی کا اعلیٰ درجہ اس وقت تک حاصل نہیں کر سکتے جب تک کہ اپنی محبوب چیز نہ خرچ کر دو """" تو حضرت ابوطلحہ رضی اللہ عنہ نے بارگاہ رسالت میں عرض کیا یا رسول اللہ ﷽ ! اللہ تعالیٰ یہ فرماتا ہے اور مجھے اپنے سارے مال میں """" بیرحاء """" سب سے زیادہ محبوب ہے ، میں اسے اللہ کے نام پر صدقہ کرتا ہوں اور اللہ کے یہاں اس کی نیکی اور ثواب کی امید رکھتا ہوں ، یا رسول اللہ ﷽ ! آپ اسے جہاں مناسب سمجھیں خرچ فرما دیں ، نبی ﷽ نے فرمایا واہ ! یہ تو بڑا نفع بخش مال ہے ، یہ تو بڑا نفع بخش مال ہے ، میں نے تمہاری بات سن لی ہے ، میری رائے یہ ہے کہ تم اسے اپنے قریبی رشتہ داروں میں تقسیم کر دو ، حضرت ابوطلحہ رضی اللہ عنہ نے عرض کیا یا رسول اللہ ﷽ ! میں ایسا ہی کروں گا ، پھر انہوں نے وہ باغ اپنے قریبی رشتہ داروں اور چچا زاد بھائیوں میں تقسیم کر دیا ۔"
"12466","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص تین مرتبہ جنت کا سوال کر لے تو جنت خود کہتی ہے کہ اے اللہ ! اس بندے کو مجھ میں داخلہ عطاء فرما اور جو شخص تین مرتبہ جہنم سے پناہ مانگ لے ، جہنم خود کہتی ہے کہ اے اللہ ! اس بندے کو مجھ سے بچا لے ۔"
"12467","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جہنم مسلسل یہ کہتی رہے گی کہ کوئی اور بھی ہے تو لے آا ، یہاں تک کہ پروردگار عالم اس میں اپنا پااں لٹکا دے گا اس وقت اس کے حصے ایک دوسرے کے ساتھ مل کر سکڑ جائیں گے اور وہ کہے گی کہ تیری عزت کی قسم ! بس ، بس ، اسی طرح جنت میں بھی جگہ زائد بچ جائے گی ، حتیٰ کہ اللہ اس کے لئے ایک اور مخلوق کو پیدا کر کے جنت کے باقی ماندہ حصے میں اسے آباد کر دے گا ۔"
"12468","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے حضرت عمر رضی اللہ عنہ کے پاس ایک ریشمی جبہ بھیجا ، حضرت عمر رضی اللہ عنہ سے ملاقات ہوئی تو وہ کہنے لگے کہ آپ نے مجھے ریشمی جبہ بھجوایا ہے حالانکہ اس کے متعلق آپ نے جو فرمایا ہے وہ فرمایا ہے آ نبی ﷽ نے فرمایا میں نے وہ تمہارے پاس پہننے کے لئے نہیں بھیجا ، میں نے تو صرف اس لئے بھیجا تھا کہ تم اسے بیچ دو یا اس سے کسی اور طرح نفع حاصل کر لو ۔"
"12469","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے یہ آیت ®ھو اھل التقوی واھل المغفرۃ¾ تلاوت فرمائی اور فرمایا کہ تمہارے رب نے فرمایا ہے ، میں اس بات کا اہل ہوں کہ مجھ سے ڈرا جائے اور میرے ساتھ کسی کو معبود نہ بنایا جائے ، جو میرے ساتھ کسی کو معبود بنانے سے ڈرتا ہے وہ اس بات کا اہل ہے کہ میں اس کی مغفرت کر دوں ۔"
"12470","حضرت انس رضی اللہ عنہ سے مروی ہے جناب رسول اللہ ﷽ نے ارشاد فرمایا قیامت کے دن ہر دھوکے باز کے لئے ایک جھنڈا ہو گا جس سے وہ پہچانا جائے گا ۔"
"12471","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے زمین پر اپنی انگلیاں رکھ کر فرمایا یہ ابن آدم ہے ، یہ اس کی موت ہے ، اور یہ اس کی امیدیں ہیں ۔"
"12472","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے بال کانوں سے آگے نہ بڑھتے تھے ۔"
"12473","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب تم میں سے کسی کو نماز پڑھتے ہوئے اونگھ آنے لگے تو اسے چاہئے کہ واپس جا کر سو جائے یہاں تک کہ اسے پتہ چلنے لگے کہ وہ کیا کہہ رہا ہے آ"
"12474","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اپنے صحابہ رضی اللہ عنہم کے ساتھ مکہ مکرمہ آئے تو حج اور عمرہ دونوں کا تلبیہ پڑھا ہوا تھا ، نبی ﷽ نے بیت اللہ کا طواف اور صفا مروہ کے درمیان سعی کرنے کے بعد انہیں یہ حکم دیا کہ وہ اسے عمرہ بنا کر احرام کھول لیں ، لیکن ایسا محسوس ہوا کہ لوگوں کو یہ بات بہت بڑی معلوم ہوئی ، نبی ﷽ نے فرمایا اگر میں ہدی کا جانور نہ لایا ہوتا تو میں بھی احرام کھول لیتا ، چنانچہ لوگ حلال ہو گئے اور انہوں نے حج تمتع کیا ۔"
"12475","ابوواقد حنفی رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ نبی ﷽ نے کس چیز کا تلبیہ پڑھا تھا آ انہوں نے فرمایا کہ میں نے نبی ﷽ کو سات مرتبہ یہ کہتے ہوئے سنا ®لبیک عمرۃ و حجۃ¾ ۔"
"12476","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو کجھور کے ساتھ خربوزہ کھاتے ہوئے دیکھا ہے ۔"
"12477","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ہلال بن امیہ رضی اللہ عنہ نے اپنی بیوی پر شریک بن سحماء کے ساتھ بدکاری میں ملوث ہونے کا الزام لگایا ، نبی ﷽ نے فرمایا اس عورت کا خیال رکھنا ، اگر اس کے یہاں گھنگریالے بالوں ، سرمگیں آنکھوں اور پتلی پنڈلیوں والا بچہ پیدا ہو تو وہ شریک بن سحماء کا بچہ ہو گا ، اور اگر گورے رنگ کا ، سیدھے بالوں والا اور دھنسی ہوئی آنکھوں والا بچہ پیدا ہو تو وہ ہلال بن امیہ کا ہو گا ، چنانچہ اس عورت کے یہاں بچہ پیدا ہوا تو وہ پہلی صفات کے مطابق تھا + شریک بن سحماء کا ,"
"12478","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب دو مسلمان آپس میں ملتے ہیں اور ان میں سے ایک دوسرے کے ہاتھوں کو پکڑتا ہے تو اللہ پر حق ہے کہ ان کی دعااں کے وقت موجود رہے اور ان دونوں کے ہاتھوں کے جدا ہونے سے پہلے ان کی مغفرت کر دے ۔"
"12479","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اے اللہ ! مکہ میں جتنی برکتیں ہیں ، مدینہ میں اس سے دوگنی برکتیں عطاء فرما ۔"
"12480","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جب کوئی جماعت اکٹھی ہو کر اللہ کا ذکر کرتی ہے اور اس سے اس کا مقصد صرف اللہ کی رضاء ہوتی ہے تو آسمان سے ایک منادی آواز لگاتا ہے کہ تم اس حال میں کھڑے ہو کہ تمہارے گناہ معاف ہو چکے ، اور تمہارے گناہوں کو نیکیوں سے بدل دیا گیا ہے ۔"
"12481","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضور اقدس ﷽ نے ارشاد فرمایا گزشتہ زمانہ میں تین آدمی جا رہے تھے راستہ میں بارش شروع ہو گئی یہ تینوں پہاڑ کے ایک غار میں پناہ گزین ہوئے ، اوپر سے ایک پتھر آ کر دروازہ پر گرا اور غار کا دروازہ بند ہو گیا ، یہ لوگ آپس میں ایک دوسرے سے کہنے لگے پتھر آ گرا ، نشانات قدم مٹ گئے اور یہاں تمہاری موجودگی کا اللہ کے علاوہ کسی کو علم نہیں ہے ، لہذا جس شخص نے اپنی دانست میں جو کوئی سچائی کا کام کیا ہو اس کو پیش کر کے خدا سے دعا کرے ۔ ایک شخص کہنے لگا الٰہی ! تو واقف ہے کہ میرے والدین بہت بوڑھے تھے ، میں ان کو روزانہ شام کو اپنی بکریوں کا دودھ + دوھ کر , دیا کرتا تھا ، ایک روز مجھے + جنگل سے آنے میں , دیر ہو گئی ، جس وقت میں آیا تو وہ سو چکے تھے اور میرے بیوی بچے بھوک کی وجہ سے چلا رہے تھے ، لیکن میرا قاعدہ تھا کہ جب تک میرے ماں باپ نہ پی لیتے تھے میں ان کو نہ پلاتا تھا + اس لئے بڑا حیران ہوا , نہ تو ان کو بیدار کرنا مناسب معلوم ہوا نہ کچھ اچھا معلوم ہوا کہ ان کو ایسے ہی چھوڑ دوں کہ + نہ کھانے سے , ان کو کمزوری ہو جائے ، اور صبح تک میں ان کی + آنکھ کھلنے کے , انتظار میں + کھڑا , رہا ، الٰہی ! اگر تیری دانست میں میرا یہ فعل تیرے خوف کی وجہ سے تھا تو ہم سے اس مصیبت کو دور فرما دے ، پتھر ایک تہائی کے قریب کھل گیا ۔ دوسرا شخص بولا الٰہی ! تو واقف ہے کہ میرے پاس ایک مزدور نے آٹھ سیر چاول مزدوری پر کام کیا تھا لیکن کام کرنے کے بعد وہ مزدوری چھوڑ کر چلا گیا میں نے وہ + پیمانہ بھر , چاول لے کر بو دیئے ، نتیجہ یہ ہوا کہ اسی کے حاصل سے میں نے گائے بیل خریدے ، کچھ دنوں کے بعد وہ شخص اپنی مزدوری مانگتا ہوا میرے پاس آیا ، میں نے کہا یہ گائے بیل لے جا ، وہ کہنے لگا میرے تو تیرے ذمہ ایک پیمانہ بھر چاول ہیں ، میں نے جواب دیا یہ گائے بیل لے جا ، یہ انہی چاولوں کے ذریعہ سے حاصل ہوئے ہیں ، الٰہی ! اگر تیری دانست میں میں نے یہ فعل صرف تیری رحمت کی امید اور تیرے خوف سے کیا ہے تو ہم سے یہ مصیبت دور فرما دے ، چنانچہ اس کی دعا کی برکت سے پتھر دو تہائی کے قریب کھل گیا ۔ تیسرا شخص بولا الٰہی ! تو واقف ہے کہ ایک عورت تھی جو میری نظر میں سب سے زیادہ محبوب تھی ، جب اس نے اپنے نفس کو میرے قبضے میں دے دیا ، میں فوراَ اٹھ کھڑا ہوا اور سو دینار بھی چھوڑ دیئے ، الٰہی ! اگر میرا یہ فعل صرف تیری رحمت کی امید اور تیرے خوف کی وجہ سے تھا تو یہ مصیبت ہم سے دور کر دے چنانچہ وہ پتھر ہٹ گیا اور وہ باہر نکل کر چلنے پھرنے لگے ۔"
"12482","گذشتہ حدیث اس دوسرے سند سے بھی مروی ہے ۔"
"12483","گذشتہ حدیث اس دوسرے سند سے بھی مروی ہے ۔"
"12484","حضرت انس رضی اللہ عنہ کہتے ہیں کہ + چونکہ , رسول اللہ ﷽ سے بکثرت سوال کرنے سے ہمیں قرآن میں ممانعت کر دی گئی تھی ، اس لئے ہم دل سے خواہش مند ہوتے تھے کہ کوئی عقل مند بدوی آ کر حضور ﷽ سے کوئی مسئلہ دریافت کرے اور ہم سنیں چنانچہ + ایک مرتبہ , بدوی نے حاضر ہو کر + حضور ﷽ سے عرض کیا کہ آپ کا قاصد ہمارے پاس آیا تھا اور کہتا تھا کہ آپ فرماتے ہیں کہ خدا نے مجھ کو پیغمبر بنایا ہے آ آپ ﷽ نے فرمایا وہ ٹھیک کہتا تھا ، بدوی بولا آسمانوں ، زمینوں اور پہاڑوں کو کس نے پیدا کیا آ آپ نے فرمایا خدا نے ، بدوی بولا آپ کو قسم ہے اس ذات پاک کی جس نے آسمانوں اور زمینوں کو پیدا کیا ، پہاڑوں کو قائم کیا + یہ بتائیے کہ , کیا واقعی اللہ تعالیٰ نے آپ کو رسول بنا کر بھیجا ہے آ حضور ﷽ نے فرمایا ہاں ! بدوی بولا آپ کا قاصد کہتا تھا کہ ہم پر دان رات میں پانچ نمازیں فرض ہیں ، حضور ﷽ نے فرمایا اس نے ٹھیک کہا ، بدوی بولا آپ کو اس اللہ کی قسم ! جس نے آپ کو رسول بنا کر بھیجا ہے + بتایئے , کیا آپ کو اللہ نے اس کا حکم دیا ہے آ حضور ﷽ نے فرمایا ہاں ! بدوی بولا آپ کے قاصد نے کہا تھا کہ ہم پر اپنے مال کی زکوٰۃ نکالنا فرض ہے آ نبی ﷽ نے فرمایا اس نے سچ کہا ، اس نے کہا کہ اس اللہ کی قسم جس نے آپ کو بھیجا ہے کیا اس نے آپ کو اس کا حکم دیا ہے آ نبی ﷽ فرمایا ہاں ! اس نے کہا کہ آپ کے قاصد کا یہ بھی کہنا تھا کہ ہم پر سال میں ایک ماہ کے روزے فرض ہیں آ حضور ﷽ نے فرمایا اس نے سچ کہا ، بدوی بولا آپ کو اس اللہ کی قسم ! جس نے آپ کو پیغمبر بنایا ہے + یہ بتائیے کہ , کیا آپ کو اللہ نے اس کا حکم دیا ہے آ حضور ﷽ نے فرمایا ہاں ! بدوی بولا آپ کے قاصد نے یہ بھی کہا تھا کہ ہم میں سے صاحب استطاعت پر کعبہ کا حج فرض ہے آ حضور ﷽ نے فرمایا اس نے سچ کہا آخرکار وہ بدوی پیٹھ پھیر کر جاتے ہوئے کہنے لگا کہ اس اللہ کی قسم ! جس نے آپ کو سچائی کے ساتھ مبعوث فرمایا میں اس میں ذرا بھی کمی بیشی نہیں کروں گا ، حضور ﷽ نے فرمایا اگر یہ سچا رہا تو جنت میں داخل ہو گا ۔"
"12485","ایک مرتبہ حضرت انس رضی اللہ عنہ نے اپنے گھر کی کسی خاتون سے فرمایا کہ تم فلاں عورت کو جانتی ہو آ ایک مرتبہ نبی ﷽ اس کے پاس سے گزرے ، اس وقت وہ ایک قبر پر رو رہی تھی ، نبی ﷽ نے اس سے فرمایا اللہ سے ڈرو اور صبر کرو ، وہ کہنے لگی کہ مجھ سے پیچھے ہی رہو ، تمہیں میری مصیبت کا کیا پتہ ، وہ نبی ﷽ کو پہچان نہ سکی ، کسی نے بعد میں اسے بتایا کہ یہ تو نبی ﷽ تھے ، یہ سن کر اس پر موت طاری ہو گئی اور وہ فوراَ نبی ﷽ کے پاس آئی ، وہاں اسے کوئی دربان نظر نہ آیا ، اور کہنے لگی یا رسول اللہ ﷽ ! میں آپ کو پہچان نہیں پائی تھی ، نبی ﷽ نے فرمایا صبر تو صدمہ کے آغاز میں ہوتا ہے ۔"
"12486","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا میں نے تمہیں مسواک کرنے کا حکم کثرت سے دیا ہے ۔"
"12487","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو کھجور کے ساتھ خربوزہ کھاتے ہوئے دیکھا ۔"
"12488","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا میری امت کی مثال بارش کی سی ہے کہ کچھ معلوم نہیں اس کا آغاز بہتر ہے یا انجام ۔"
"12489","[Darussalam 12462] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12490","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ گالیاں دینے والے ، لعنت ملامت کرنے والے یا بیہودہ باتیں کرنے والے نہ تھے ، عتاب کے وقت بھی صرف اتنا فرماتے تھے کہ اسے کیا ہو گیا ، اس کی پیشانی خاک آلود ہو ۔"
"12491","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے میدان منیٰ میں نبی ﷽ کے ساتھ دو رکعتیں پڑھی ہیں ، حضرت ابوبکر صدیق رضی اللہ عنہ اور حضرت عمر رضی اللہ عنہ کے ساتھ بھی اور حضرت عثمان رضی اللہ عنہ کے ابتدائی دور خلافت میں بھی دو رکعتیں ہی پڑھی ہیں ۔"
"12492","حضرت انس رضی اللہ عنہ ، حضرت عمر بن عبدالعزیز رحمۃ اللہ کے متعلق """" جبکہ وہ مدینہ منورہ میں تھے """" فرماتے تھے کہ میں نے تمہارے اس امام سے زیادہ نبی ﷽ کے ساتھ مشابہت رکھنے والی نماز پڑھتے ہوئے کسی کو نہیں دیکھا ، حضرت عمر بن عبدالعزیز رحمۃ اللہ طویل قراءت نہ کرتے تھے ۔"
"12493","حضرت انس رضی اللہ عنہ سے مروی ہے کہ انہوں نے دیکھا ہے کہ نبی ﷽ قربانی کا جانور اپنے ہاتھ سے ذبح کرتے تھے اور اس پر تکبیر پڑھتے تھے ۔"
"12494","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اپنے صحابہ رضی اللہ عنہم کے ساتھ بیٹھے ہوئے تھے کہ ایک یہودی نے نبی ﷽ کو سلام کرتے ہوئے """" السام علیک """" کہا ، نبی ﷽ نے صحابہ رضی اللہ عنہم سے فرمایا اسے میرے پاس بلا کر لاا ، اور اس سے پوچھا کہ کیا تم نے """" السام علیک """" کہا تھا آ اس نے اقرار کیا تو نبی ﷽ نے فرمایا جب تمہیں کوئی """" کتابی """" سلام کرے تو صرف """" وعلیک """" کہا کرو یعنی تو نے جو کہا وہ تجھ پر ہی ہو ۔"
"12495","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ اللہ تعالیٰ فرماتا ہے جب کسی شخص کو آنکھوں کے معاملے میں امتحان میں مبتلاء کیا جائے اور وہ اس پر صبر کرے تو میں اس کا عوض جنت عطاء کروں گا ۔"
"12496","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ قیامت کے دن سب سے پہلے میری قبر کھلے گی اور میں اس پر فخر نہیں کرتا ، مجھے لواء حمد دیا جائے گا ، میں اس پر بھی فخر نہیں کرتا ، میں قیامت کے دن تمام لوگوں کا سردار ہوں گا اور میں اس پر بھی فخر نہیں کرتا ، میں جنت کے دروازے پر پہنچ کر اس کا حلقہ پکڑوں گا ، اندر سے پوچھا جائے گا کہ کون آ میں کہوں گا محمد + ﷽ , چنانچہ دروازہ کھل جائے گا اور میں جنت میں داخل ہو جااں گا ، اچانک میں پروردگار کے سامنے پہنچ جااں گا اور اسے دیکھتے ہی سجدہ ریز ہو جااں گا ، اللہ تعالیٰ فرمائے گا کہ اے محمد ! ﷽ ، سر اٹھائیے ، بات تو کیجئے ، سنی جائے گی ، کہیے تو سہی ، قبول ہو گا ، سفارش کیجئے آپ کی سفارش قبول کی جائے گی ، چنانچہ میں اپنا سر اٹھا کر کہوں گا پروردگار ! میری امت ، میری امت ، اللہ تعالیٰ فرمائے گا کہ آپ اپنی امت کے پاس جائیے اور جس کے دل میں جو کے دانے کے برابر بھی ایمان ہو ، اسے جنت میں داخل کر دیجئے ، چنانچہ میں ایسا ہی کروں گا اور جس کے دل میں اتنا ایمان محسوس ہو گا ، اسے جنت میں داخل کر دوں گا ۔ دوسری مرتبہ اسی تمام تفصیل کے ساتھ جو کے نصف دانے کے برابر ایمان رکھنے والوں کو جنت میں داخل کرنے کا حکم ہو گا اور میں ایسا ہی کروں گا ، تیسری مرتبہ اسی تمام تفصیل کے ساتھ رائی کے ایک دانے کے برابر ایمان رکھنے والوں کو جنت میں داخل کرنے کا حکم ہو گا اور میں ایسا ہی کروں گا ، پھر اللہ لوگوں کے حساب کتاب سے فارغ ہو جائے گا اور میری باقی امت کو اہل جہنم کے ساتھ جہنم میں داخل کر دے گا ، جہنمی ان سے کہیں گے کہ تم تو اللہ کی عبادت کرتے تھے اور اس کے ساتھ کسی کو شریک نہیں ٹھہراتے تھے ، تمہیں اس کا کیا فائدہ ہوا آ اس پر اللہ تعالیٰ فرمائے گا مجھے اپنی عزت کی قسم ! میں ان لوگوں کو جہنم سے ضرور آزاد کروں گا ، چنانچہ اللہ انہیں جہنم سے نکال لے گا ، اس وقت وہ جل کر کوئلہ ہو چکے ہوں گے ، پھر انہیں نہر حیات میں غوطہ دلوایا جائے گا اور وہ ایسے اگ آئیں گے جیسے سیلاب کے کوڑے پر دانے اگ آتے ہیں ، اور ان کی آنکھوں کے درمیان لکھ دیا جائے گا کہ یہ اللہ کے آزاد کردہ لوگ ہیں ، جب یہ لوگ جنت میں داخل ہوں گے تو اہل جنت کہیں گے کہ یہ جہنمی ہیں ، لیکن اللہ فرمائے گا نہیں ، بلکہ یہ پروردگار کے آزاد کردہ لوگ ہیں ۔"
"12497","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"12498","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے بیس سے کچھ زائد سرداران قریش کے متعلق حکم فرمایا کہ انہیں کھینچ کر بدر کے ایک کنویں میں ان کی تمام تر خباثتوں کے ساتھ پھینک دیا جائے ، چنانچہ ایسا ہی ہوا ، نبی ﷽ کا معمول تھا کہ کسی قوم پر فتح حاصل ہونے کے بعد وہاں تین راتیں رکتے تھے ، اہل بدر پر فتح پانے کے بعد نبی ﷽ وہاں بھی تین راتیں رکے رہے ، تیسرے دن آپ ﷽ نے سواری تیار کرنے کا حکم دیا ، سواری تیار ہو گئی تو نبی ﷽ ایک طرف کو چل پڑے ، صحابہ رضی اللہ عنہم آپ کے پیچھے تھے ، ہمارا خیال تھا کہ نبی ﷽ قضاء حاجت کے لئے جا رہے ہیں ، لیکن نبی ﷽ اس کنویں کے دہانے پر پہنچ کر رک گئے ، اور انہیں ان کے اور ان کے باپوں کے نام سے پکار پکار کر آوازیں دینے لگے ، اور فرمانے لگے کہ کیا اب تمہیں یہ بات اچھی لگ رہی ہے کہ کاش ! تم نے اللہ اور اس کے رسول کی اطاعت کی ہوتی آ کیا تم سے تمہارے رب نے جو وعدہ کیا تھا ، تم نے اسے سچ پایا آ حضرت عمر رضی اللہ عنہ نے عرض کیا اے اللہ کے نبی ! آپ ایسے جسموں سے بات کر رہے ہیں جن میں روح نہیں ہے ، نبی ﷽ نے فرمایا اس ذات کی قسم جس کے دست قدرت میں محمد + ﷽ , کی جان ہے ، میں ان سے جو کہہ رہا ہوں ، تم ان سے زیادہ نہیں سن رہے ۔ قتادہ رحمۃ اللہ کہتے ہیں کہ اللہ نے انہیں نبی ﷽ کی بات سننے کے لئے دوبارہ زندگی عطاء فرمائی تھی اور اس کا مقصد زجر و توبیخ ، ان کی تحقیر اور سزا تھی ۔"
"12499","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے مہاجرین و انصار کے درمیان مواخات ہمارے مدینہ منورہ والے گھر میں فرمائی تھی ۔"
"12500","ابوعبدالرحمن کہتے ہیں کہ ہم سے یہ حدیث ابوابراہیم معقب نے بیان کی تھی جو کہ بہترین انسان تھے اور ابوعبدالرحمن نے ان کی بڑی تعریف بیان کی ۔"
"12501","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قیامت اس وقت تک قائم نہ ہو گی جب تک لوگ مساجد کے بارے میں ایک دوسرے پر فخر نہ کرنے لگیں ۔"
"12502","ثابت رضی اللہ عنہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کیا نبی ﷽ کے بال سفید ہو گئے تھے آ انہوں نے جواب دیا کہ جس وقت اللہ نے نبی ﷽ کو اپنے پاس بلایا ، اس وقت تک انہیں بالوں کی سفیدی سے شرمندہ نہیں ہونے دیا ، وصال کے دن آپ ﷽ کے سر اور ڈاڑھی میں تیس بال بھی سفید نہ تھے ، کسی نے پوچھا کہ بالوں کا سفید ہونا باعث شرمندگی ہے آ تو حضرت انس رضی اللہ عنہ نے فرمایا تم لوگ اسے شرمندگی کا سبب سمجھتے ہو ، ہم تو اسے سبب زینت سمجھتے تھے ۔"
"12503","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت ام سلیم رضی اللہ عنہا کے گھر میں ایک پرانی چٹائی پر """" جس کا رنگ بھی پرانا ہونے کی وجہ سے بدل چکا تھا """" نماز پڑھی ، انہوں نے اس پر پانی کا چھڑکاا کر دیا تھا ۔"
"12504","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے فرمایا کیا میں تمہیں اہل جہنم اور اہل جنت کے بارے نہ بتااں آ جنتی تو ہر وہ کمزور ، پسا ہوا ، پراگندہ حال اور فقر و فاقہ کا شکار شخص ہو گا جو اگر اللہ کے نام پر کوئی قسم کھا لے تو اللہ اس کی قسم کو ضرور پورا کرے اور جہنمی ہر وہ بداخلاق ، متکبر ، مال کو جمع کرنے والا اور دوسروں کو نہ دینے والا شخص ہے جس کی دنیا میں اتباع کی جاتی ہے ۔"
"12505","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے انسان کو اپنا نر گھوڑا بیچنے سے منع فرمایا ہے ۔"
"12506","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میدان منیٰ میں نبی ﷽ نے دو رکعتیں پڑھی ہیں ، حضرت ابوبکر صدیق رضی اللہ عنہ اور حضرت عمر رضی اللہ عنہ اور حضرت عثمان رضی اللہ عنہ نے بھی ابتدائی دور خلافت میں چار سال تک دو رکعتیں ہی پڑھی ہیں پھر وہ انہیں مکمل کرنے لگے تھے ۔"
"12507","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا کہ بنی اسرائیل اکہتر فرقوں میں تقسیم ہو گئے تھے جن میں سے ستر فرقے ہلاک ہو گئے تھے اور صرف ایک بچا تھا جب کہ میری امت بہتر فرقوں میں تقسیم ہو جائے گی جن میں سے اکہتر فرقے ہلاک ہو جائیں گے اور صرف ایک فرقہ بچے گا ، صحابہ رضی اللہ عنہم نے پوچھا یا رسول اللہ ! وہ ایک فرقہ کون سا ہو گا آ نبی ﷽ نے فرمایا جو جماعت کے ساتھ چمٹا ہوا ہو گا ۔"
"12508","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب یہ آیت نازل ہوئی کہ """" اے اہل ایمان ! نبی کی آواز پر اپنی آواز کو اونچا نہ کیا کرو """" تو حضرت ثابت بن قیس رضی اللہ عنہ """" جن کی آواز قدرتی طور پر اونچی تھی """" کہنے لگے کہ میں جہنمی بن گیا ، اور یہ سوچ کر اپنے گھر میں ہی غمگین ہو کر بیٹھ رہے ، ایک دن نبی ﷽ نے حضرت سعد بن معاذ رضی اللہ عنہ سے پوچھا کہ اے ابوعمرو ! ثابت کا کیا معاملہ ہے ، کیا وہ بیمار ہیں آ حضرت سعد رضی اللہ عنہ نے عرض کیا کہ وہ تو میرے پڑوسی ہیں لیکن میں نہیں جانتا کہ وہ بیمار ہیں ، حضرت سعد رضی اللہ عنہ ان کے پاس آئے اور کہنے لگے کہ نبی ﷽ تمہاری غیر حاضری کے متعلق پوچھ رہے تھے ، کیا بات ہے آ وہ کہنے لگے کہ میں ہی تو وہ ہوں جس کی آواز نبی ﷽ کی آواز سے اونچی ہوتی ہے اور میں بات کرتے ہوئے اونچا بولتا ہوں ، اس لیے میرے سارے اعمال ضائع ہو گئے اور میں جہنمی ہو گیا ، حضرت سعد رضی اللہ عنہ نے یہی بات نبی ﷽ سے آ کر ذکر کر دی ، نبی ﷽ نے فرمایا نہیں بلکہ وہ تو جنتی ہے ۔"
"12509","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب اہل یمن نبی ﷽ کی خدمت میں حاضر ہوئے تو انہوں نے نبی ﷽ سے درخواست کی کہ ان کے ساتھ ایک آدمی کو بھیج دیں جو انہیں دین کی تعلیم دے ، نبی ﷽ نے حضرت ابوعبیدہ بن جراح رضی اللہ عنہ کا ہاتھ پکڑا اور انہیں ان کے ساتھ بھیج دیا اور فرمایا یہ اس امت کے امین ہیں ۔"
"12510","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نبی ﷽ کی خدمت میں حاضر ہوا اور کہنے لگا یا رسول اللہ ! فلاں آدمی کا ایک باغ ہے ، میں وہاں اپنی دیوار قائم کرنا چاہتا ہوں ، آپ اسے حکم دے دیجئے کہ وہ مجھے یہ جگہ دے دے تاکہ میں اپنی دیوار کھڑی کر لوں ، نبی ﷽ نے متعلقہ آدمی سے کہہ دیا کہ جنت میں ایک درخت کے بدلے تم اسے یہ جگہ دے دو ، لیکن اس نے انکار کر دیا ، حضرت ابوالدحداح رضی اللہ عنہ کو پتہ چلا تو وہ اس کے پاس گئے اور کہنے لگے کہ اپنا باغ میرے باغ کے عوض فروخت کر دو ، اس نے بیچ دیا ، وہ اسے خریدنے کے بعد نبی ﷽ کے پاس آئے اور کہنے لگے کہ میں نے وہ باغ اپنے باغ کے بدلے خرید لیا ہے ، آپ یہ اس شخص کو دے دیجئے ، کہ میں نے یہ باغ آپ کو دے دیا ، نبی ﷽ نے یہ سن کر کئی مرتبہ فرمایا کہ ابوالدحداح کے لئے جنت میں کتنے بہترین گچھے ہیں ، اس کے بعد وہ اپنی بیوی کے پاس پہنچے اور اس سے فرمایا کہ اے ام دحداح ! اس باغ سے نکل چلو کہ میں نے اسے جنت کے باغ کے عوض فروخت کر دیا ہے ، ان کی بیوی نے کہا کہ کامیاب تجارت کی ۔"
"12511","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے + حجۃ الوداع کے موقع پر , جب حلاق سے سر منڈوانے کا ارادہ کیا تو حضرت ابوطلحہ رضی اللہ عنہ نے سر کے ایک حصے کے بال اپنے ہاتھوں میں لے لیے ، پھر وہ بال ام سلیم اپنے ساتھ لے گئیں اور وہ انہیں اپنی خوشبو میں ڈال کر ہلا لیا کرتی تھیں ۔"
"12512","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ہم لوگ قرآن کریم کی تلاوت کر رہے تھے ، ہم میں عربی ، عجمی اور کالے گورے ، ہر طرح کے لوگ موجود تھے ، اسی دوران نبی ﷽ تشریف لے آئے اور فرمانے لگے کہ تم بھلائی پر ہو + اور بہترین زمانے میں ہو , کہ تم کتاب اللہ کی تلاوت کر رہے ہو اور رسول اللہ ﷽ تمہارے درمیان موجود ہیں ، عنقریب لوگوں پر ایک زمانہ ایسا بھی آئے گا جس میں لوگ ایسے کھڑکھڑائیں گے جیسے برتن کھڑکھڑاتے ہیں ، وہ اپنا اجر فوری وصول کر لیں گے ، آگے کے لئے کچھ نہ رکھیں گے ۔"
"12513","مروی ہے کہ حضرت انس رضی اللہ عنہ ، عمر بن عبدالعزیز رحمۃ اللہ کے خلاف کیا کرتے تھے ، ایک مرتبہ عمر بن عبدالعزیز رحمۃ اللہ نے ان سے اس کی وجہ پوچھی تو انہوں نے فرمایا کہ میں نے نبی ﷽ کو جو نماز پڑھتے ہوئے دیکھا ، اگر تم اس کی موافقت کرو گے تو میں تمہارے ساتھ نماز پڑھوں گا اور اگر تم اس کے خلاف کرو گے تو میں اپنی نماز اکیلے پڑھ کر گھر چلا جااں گا ۔"
"12514","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو سفر میں چاشت کی آٹھ رکعتیں پڑھتے ہوئے دیکھا ہے ، اور نماز سے فارغ ہو کر نبی ﷽ نے فرمایا میں نے شوق اور خوف والی نماز پڑھی ، میں نے اپنے پروردگار سے تین چیزوں کی درخواست کی ، اس نے مجھے دو چیزیں عطاء فرما دیں اور ایک سے روک دیا ، میں نے یہ درخواست کی کہ میری امت قحط سالی میں مبتلاء ہو کر ہلاک نہ ہو ، اللہ نے منظور کر لیا ، میں نے دوسری درخواست کی کہ دشمن کو ان پر مکمل غلبہ نہ دیا جائے ، اللہ نے اسے بھی منظور کر لیا ، پھر میں نے تیسری درخواست یہ پیش کی کہ انہیں مختلف فرقوں میں تقسیم نہ ہونے دے لیکن اللہ نے اسے منظور نہیں کیا ۔"
"12515","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نبی ﷽ کے پاس آیا ، اس نے وضو کر رکھا تھا لیکن پااں پر ناخن برابر جگہ چھوٹ گئی تھی ، نبی ﷽ نے اس سے فرمایا واپس جا کر اچھی طرح وضو کرو ۔"
"12516","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا سورہ کافرون چوتھائی قرآن کے برابر ہے ، سورہ زلزال چوتھائی قرآن کے برابر ہے اور سورہ نصر بھی چوتھائی قرآن کے برابر ہے ۔"
"12517","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا کچھ لوگ اپنے گناہوں کی وجہ سے جہنم میں داخل کیے جائیں گے ، جب وہ جل کر کوئلہ ہو جائیں گے تو اللہ تعالی اپنے فضل سے انہیں جنت میں داخل کر دے گا ، + اہل جنت پوچھیں گے کہ یہ کون لوگ ہیں آ انہیں , بتایا جائے گا کہ یہ جہنمی ہیں ۔"
"12518","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے کھڑے ہو کر پانی پینے سے منع فرمایا ہے ۔"
"12519","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ام سلیم رضی اللہ عنہا نے نصف مد کے برابر جو پیسے ، پھر گھی کا ڈبہ اٹھایا ، اس میں سے تھوڑا سا جو گھی تھا وہ نکالا اور ان دونوں چیزوں کو ملا کر """" خطیفہ """" + ایک قسم کا کھانا , تیار کیا اور مجھے نبی ﷽ کو بلانے کے لئے بھیج دیا ، میں نبی ﷽ کے پاس پہنچا تو آپ ﷽ صحابہ کرام رضی اللہ عنہم کے درمیان رونق افروز تھے ، میں نے نبی ﷽ سے عرض کیا کہ مجھے حضرت ام سلیم رضی اللہ عنہا نے آپ کے پاس کھانے کی دعوت دے کر بھیجا ہے ، نبی ﷽ نے فرمایا مجھے اور میرے ساتھیوں کو بھی آ یہ کہہ کر نبی ﷽ اپنے ساتھیوں کو لے کر روانہ ہو گئے ۔ میں نے جلدی سے گھر پہنچ کر حضرت ابوطلحہ رضی اللہ عنہ سے کہا کہ نبی ﷽ تو اپنے ساتھیوں کو بھی لے آئے ، یہ سن کر حضرت ابوطلحہ رضی اللہ عنہ نبی ﷽ کی طرف چلے گئے اور آپ ﷽ کے پہلو میں چلتے چلتے کہہ دیا کہ یا رسول اللہ ﷽ ! یہاں تو تھوڑا سا """" خطیفہ """" ہے جو ام سلیم نے نصف مد کے برابر جو سے بنایا ہے آ نبی ﷽ جب ان کے گھر پہنچے تو وہ کھانا نبی ﷽ کے پاس لایا گیا ، نبی ﷽ نے اس پر اپنا دست مبارک رکھا ، اور فرمایا دس آدمیوں کو بلاا ، چنانچہ دس آدمی اندر آئے اور انہوں نے خوب سیر ہو کر کھانا کھایا ، پھر دس دس کر کے چالیس آدمیوں نے وہ کھانا کھا لیا اور خوب سیراب ہو کر سب نے کھایا اور وہ کھانا جیسے تھا ، ویسے ہی باقی رہا اور ہم نے بھی اسے کھایا ۔"
"12520","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اس ذات کی قسم جس کے دست قدرت میں میری جان ہے ، اگر کوئی جنتی عورت زمین کی طرف جھانک کر دیکھ لے تو ان دونوں کی درمیانی جگہ روشن ہو جائے اور خوشبو سے بھر جائے ، اور اس کے سر کا دوپٹہ دنیا و مافیہا سے بہتر ہے ۔"
"12521","حضرت انس رضی اللہ عنہ سے مروی ہے کہ عرفہ کے دن نبی ﷽ کے ساتھ ہم میں سے کچھ لوگ تہلیل کہہ رہے تھے ، اور بعض تکبیر کہہ رہے تھے اور ان میں سے کوئی کسی پر عیب نہیں لگاتا تھا ۔"
"12522","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ تمام لوگوں میں سب سے زیادہ خوبصورت ، سخی اور بہادر تھے ، ایک مرتبہ رات کے وقت اہل مدینہ دشمن کے خوف سے گھبرا اٹھے ، اور اس آواز کے رخ پر چل پڑے ، دیکھا تو نبی ﷽ واپس چلے آ رہے ہیں اور حضرت ابوطلحہ رضی اللہ عنہ کے بے زین گھوڑے پر سوار ہیں ، گردن میں تلوار لٹکا رکھی ہے اور لوگوں سے کہتے جا رہے ہیں کہ گھبرانے کی کوئی بات نہیں ، مت گھبراا اور گھوڑے کے متعلق فرمایا کہ ہم نے اسے سمندر جیسا رواں پایا ، حالانکہ پہلے وہ گھوڑا سست تھا لیکن اس کے بعد اس سے کوئی گھوڑا آگے نہ بڑھ سکا ۔"
"12523","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو مسلمان کوئی کھیت اگاتا ہے ، یا کوئی پودا اگاتا ہے اور اس سے کسی پرندے ، انسان یا درندے کو رزق ملتا ہے تو وہ اس کے لیے صدقہ کا درجہ رکھتا ہے ۔"
"12524","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے حضرت عمر رضی اللہ عنہ کے پاس ایک ریشمی جبہ بھیجا ، حضرت عمر رضی اللہ عنہ سے ملاقات ہوئی تو وہ کہنے لگے کہ آپ نے مجھے ریشمی جبہ بھجوایا ہے حالانکہ اس کے متعلق آپ نے جو فرمایا ہے وہ فرمایا ہے آ نبی ﷽ نے فرمایا میں نے وہ تمہارے پاس پہننے کے لئے نہیں بھیجا ، میں نے تو صرف اس لئے بھیجا تھا کہ تم اسے بیچ دو یا اس سے کسی اور طرح نفع حاصل کر لو ۔"
"12525","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے ایک کشادہ پیالے میں پانی منگوایا ، اور اپنی انگلیاں اس پیالے میں رکھ دیں ، میں نے دیکھا کہ نبی ﷽ کی انگلیوں کے نیچے سے پانی ابل رہا ہے ، اور لوگ اس سے وضو کرتے رہے میں نے اندازہ کیا تو لوگوں کی تعداد ستر سے اسی کے درمیان تھی ۔"
"12526","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص دو یا تین بیٹیوں یا بہنوں کا ذمہ دار بنا + اور ذمہ داری نبھائی , یہاں تک کہ وہ فوت ہو گئیں ، یا وہ شخص خود فوت ہو گیا تو میں اور وہ ان دو انگلیوں کی طرح ساتھ ہوں گے ، یہ کہہ کر نبی ﷽ نے شہادت والی اور درمیانی انگلی کی طرف اشارہ فرمایا ۔"
"12527","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ تعالیٰ نے ماں کے رحم پر ایک فرشتہ مقرر کر رکھا ہے ، جو اپنے اپنے وقت پر یہ کہتا رہتا ہے کہ پروردگار ! اب نطفہ بن گیا ، پروردگار ! اب جما ہوا خون بن گیا ، پروردگار ! اب گوشت کی بوٹی بن گیا ، پھر جب اللہ اسے پیدا کرنے کا ارادہ کرتا ہے تو وہ پوچھتا ہے کہ پروردگار ! یہ شقی ہو گا یا سعید آ مذکر ہو گا یا مونث آ رزق کتنا ہو گا آ اور عمر کتنی ہو گی آ یہ سب چیزیں ماں کے پیٹ میں ہی لکھ لی جاتی ہیں ۔"
"12528","[Darussalam 12500] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12529","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے وصال کے وقت ان کی مبارک ڈاڑھی اور سر میں بیس بال بھی سفید نہ تھے ۔"
"12530","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم لوگ حج کا تلبیہ پڑھتے ہوئے نکلے ، مکہ مکرمہ پہنچنے کے بعد نبی ﷽ نے ہمیں یہ حکم دیا کہ اسے عمرہ بنا کر احرام کھول لیں ، اور فرمایا اگر وہ بات جو بعد میں میرے سامنے آئی ، پہلے آ جاتی تو میں بھی اسے عمرہ بنا لیتا لیکن میں ہدی کا جانور اپنے ساتھ لایا ہوں ، اور حج و عمرہ دونوں کا تلبیہ پڑھا ہوا ہے ۔"
"12531","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ تعالیٰ جب کسی بندہ مسلم کو جسمانی طور پر کسی بیماری میں مبتلاء کرتا ہے تو فرشتوں سے کہہ دیتا ہے کہ یہ جتنے نیک کام کرتا ہے ان کا ثواب برابر لکھتے رہو ، پھر اگر اسے شفاء مل جائے تو اللہ اسے دھو کر پاک صاف کر چکا ہوتا ہے اور اگر اسے اپنے پاس واپس بلا لے تو اس کی مغفرت کر دیتا ہے اور اس پر رحم فرماتا ہے ۔"
"12532","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا شب معراج میں حضرت موسیٰ علیہ السلام کے پاس سے سرخ ٹیلے کے قریب گزرا تو دیکھا کہ وہ اپنی قبر میں کھڑے نماز پڑھ رہے ہیں ۔"
"12533","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا شب معراج میرے پاس براق لایا گیا جو گدھے سے بڑا اور خچر سے چھوٹا جانور تھا ، وہ اپنا قدم وہاں رکھتا تھا جہاں تک اس کی نگاہ پڑتی تھی ، میں اس پر سوار ہوا ، پھر روانہ ہو کر بیت المقدس پہنچا اور اس حلقے سے اپنی سواری باندھی جس سے دیگر انبیاء + علیہم السلام , باندھتے چلے آئے تھے ، پھر وہاں داخل ہو کر دو رکعتیں پڑھیں ، پھر وہاں سے نکلا تو جبریل علیہ السلام میرے پاس ایک برتن شراب کا اور ایک دودھ کا برتن لائے ، میں نے دودھ والا برتن منتخب کر لیا ، حضرت جبریل علیہ السلام کہنے لگے آپ نے فطرت کو پا لیا ۔ پھر آسمان دنیا کی طرف لے کر چلے اور اس کے دروازہ کو کھٹکھٹایا ، اہل آسمان نے کہا کہ کون ہے آ انہوں نے کہا جبریل ! انہوں نے کہا کہ تمہارے ہمراہ کون ہے آ انہوں نے کہا کہ میرے ساتھ + حضرت , محمد ﷽ ہیں ! انہوں نے کہا کیا وہ بلائے گئے ہیں آ انہوں نے کہا ہاں ، انہوں نے دروازہ کھول دیا اور پہلے ہی آسمان میں حضور ﷽ نے حضرت آدم علیہ السلام سے ملاقات کی ، انہوں نے خوش آمدید کہا اور دعاء دی ۔ پھر آپ ﷽ کو جبریل لے کر دوسرے آسمان پر چڑھے اس کے دروازے پر بھی فرشتوں نے پہلے آسمان کی طرح سوال کیا کہ کون ہے آ انہوں نے کہا جبریل ، انہوں نے کہا کہ تمہارے ساتھ کون ہیں آ انہوں نے کہا حضرت رسول کریم ﷽ ! انہوں نے کہا وہ بلائے گئے ہیں آ انہوں نے دروازہ کھول دیا ، وہاں حضرت یحیٰ علیہ السلام اور عیسیٰ علیہ السلام سے ملاقات ہوئی ، انہوں نے مجھے خوش آمدید کہا اور دعاء دی ۔ پھر تیسرے آسمان پر تشریف لے گئے اور وہاں بھی یہی گفتگو ہوئی جو دوسرے میں ہوئی تھی ، پھر چوتھے پر چڑھے اور وہاں بھی یہی گفتگو ہوئی ، پھر پانچویں آسمان پر پہنچے وہاں بھی یہی گفتگو ہوئی ، پھر چھٹے آسمان پر چڑھے وہاں کے فرشتوں نے بھی یہی گفتگو کی ، پھر ساتویں آسمان پر پہنچے وہاں کے فرشتوں نے بھی یہی کیا ۔ تیسرے آسمان پر حضرت یوسف علیہ السلام سے ملاقات ہوئی جنہیں آدھا حسن دیا گیا تھا ، انہوں نے بھی مجھے خوش آمدید کہا اور دعاء دی ، چوتھے آسمان پر حضرت ادریس علیہ السلام سے ملاقات ہوئی جنہیں اللہ نے بلند جگہ اٹھا لیا تھا ، انہوں نے بھی مجھے خوش آمدید کہا اور دعا دی ، پانچویں آسمان پر حضرت ہارون علیہ السلام سے ملاقات ہوئی ، انہوں نے بھی مجھے خوش آمدید کہا اور دعا دی ، چھٹے آسمان پر حضرت موسیٰ علیہ السلام سے ملاقات ہوئی ، انہوں نے بھی مجھے خوش آمدید کہا اور دعاء دی ، ساتویں آسمان پر حضرت ابراہیم علیہ السلام سے ملاقات ہوئی ، انہوں نے بھی مجھے خوش آمدید کہا اور دعاء دی ، وہ بیت المعمور سے ٹیک لگا کر بیٹھے ہوئے تھے جہاں روزانہ ستر ہزار فرشتے داخل ہوتے ہیں اور دوبارہ ان کی باری نہیں آتی ۔ پھر مجھے سدرۃ المنتہیٰ لے جایا گیا جس کے پتے ہاتھی کے کان کے برابر اور پھل ہجر کے مٹکے برابر تھے ، جب اللہ کے حکم سے اس چیز نے اسے ڈھانپ لیا جس نے ڈھانپا تو وہ بدل گیا اور اب کسی انسان کے بس کی بات نہیں ہے کہ اس کا حسن بیان کر سکے ۔ پھر اللہ تعالیٰ نے جو وحی کرنا تھی وہ وحی کی ، منجملہ اس کے یہ بھی وحی کی کہ تمہاری امت پر پچاس نمازیں ہر روز و شب میں فرض ہیں ۔ پھر میں وہاں سے نیچے آیا ، یہاں تک کہ جب حضرت موسیٰ علیہ السلام کے پاس پہنچا تو انہوں نے آپ ﷽ کو روک لیا اور کہا کہ آپ کے پروردگار نے آپ کی امت پر کیا چیز فرض کی ہے آ رسول اکرم ﷽ نے فرمایا ہر روز و شب میں پچاس نمازیں فرض کی ہیں ، حضرت موسیٰ علیہ السلام نے کہا اے محمد ﷽ آپ کی امت اس کی طاقت نہیں رکھتی ، اپنے رب کے پاس واپس جا کر اس سے تخفیف کی درخواست کیجئے ، کیونکہ میں بنی اسرائیل کو آزما چکا ہوں ، حضور ﷽ جناب باری میں گئے اور اسی اپنی جگہ میں پہنچ کر عرض کیا کہ اے پروردگار ! ہم پر تخفیف فرما ، اللہ تعالیٰ نے پانچ نمازیں معاف فرما دیں اور آپ ﷽ موسیٰ علیہ السلام کے پاس آئے انہوں نے پھر آپ ﷽ کو روک لیا اور پھر حضور ﷽ کو پروردگار کے حضور میں بھیجا ۔ غرض کہ اسی طرح حضرت موسیٰ علیہ السلام رسول انور ﷽ کو بھیجتے رہے حتیٰ کہ اللہ تعالیٰ نے فرما دیا اے محمد ! ﷽ ، روزانہ دن رات میں پانچ نمازیں ہیں اور ہر نماز پر دس کا ثواب ہے لہٰذا یہ پچاس نمازیں ہو گئیں ، جو شخص نیکی کا ارادہ کرے لیکن اس پر عمل نہ کر سکے اس کے لئے ایک نیکی لکھی جائے گی ، اور اگر عمل کر لیا تو دس نیکیاں لکھ دوں گا ، اور جو شخص گناہ کا ارادہ کر لے لیکن اس پر عمل نہ کرے تو کچھ نہیں لکھا جائے گا اور اگر اس پر عمل بھی کر لے تو صرف ایک گناہ لکھا جائے گا ، میں نے واپس آ کر حضرت موسیٰ علیہ السلام کو بتایا تو انہوں نے پھر تخفیف کا مشورہ دیا ، نبی ﷽ نے فرمایا کہ میں اپنے پروردگار کے پاس اتنی مرتبہ جا چکا ہوں کہ اب مجھے شرم آ رہی ہے ۔"
"12534","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ایک مرتبہ میں بچپن وہ دوسرے بچوں کے ساتھ کھیل رہا تھے ، اچانک ایک شخص آیا اور اس نے انہیں پکڑ کر پیٹ چاک کیا ، اور اس میں خون کا جما ہوا ایک ٹکڑا نکالا اور اسے پھینک کر کہنے لگا کہ یہ آپ کے جسم میں شیطان کا حصہ تھا ، پھر اس نے سونے کی طشتری میں رکھے ہوئے آب زم زم سے پیٹ کو دھویا اور پھر اسے سی کر ٹانکے لگا دیئے ، یہ دیکھ کر سب بچے دوڑتے ہوئے اپنی والدہ کے پاس گئے اور کہنے لگے کہ محمد + ﷽ , قتل ہو گئے ، والدہ دوڑتی ہوئی آئیں تو دیکھا کہ نبی ﷽ کے چہرہ انور کا رنگ متغیر ہو رہا ہے ، حضرت انس رضی اللہ عنہ کہتے ہیں کہ میں نبی ﷽ کے سینہ مبارک پر سلائی کے نشان دیکھا کرتا تھا ۔"
"12535","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ان کی دادی حضرت ملیکہ نے ایک مرتبہ نبی ﷽ کی کھانے پر دعوت کی ، نبی ﷽ نے کھانا تناول فرمانے کے بعد فرمایا اٹھو ، میں تمہارے لیے نماز پڑھ دوں ، حضرت انس رضی اللہ عنہ کہتے ہیں کہ میں اٹھ کر ایک چٹائی لے آیا جو طویل عرصہ تک استعمال ہونے کی وجہ سے سیاہ ہو چکی تھی ، میں نے اس پر پانی چھڑک دیا ، نبی ﷽ اس پر کھڑے ہو گئے ، میں اور ایک یتیم بچہ نبی ﷽ کے پیچھے کھڑے ہو گئے اور بڑی بی ہمارے پیچھے کھڑی ہو گئیں ، پھر نبی ﷽ نے ہمیں دو رکعتیں پڑھائیں اور واپس تشریف لے گئے ۔"
"12536","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا نیک مسلمان کا اچھا خواب اجزاء نبوت میں سے چھیالیسواں جزء ہوتا ہے ۔"
"12537","علاء ابن عبدالرحمن رحمۃ اللہ کہتے ہیں کہ ایک دفعہ ہم ظہر کی نماز پڑھ کر حضرت انس رضی اللہ عنہ کی خدمت میں حاضر ہوئے ، کچھ ہی دیر بعد وہ عصر کی نماز پڑھنے کھڑے ہو گئے ، جب وہ نماز سے فارغ ہوئے تو ہم نے ان سے کہا کہ عصر کی نماز اتنی جلدی آ انہوں نے فرمایا کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے وہ منافق کی نماز ہے کہ منافق نماز کو چھوڑے رکھتا ہے ، حتیٰ کہ جب سورج شیطان کے دو سینگوں کے درمیان آ جاتا ہے تو وہ نماز پڑھنے کھڑا ہوتا ہے اور چار ٹھونگیں مار کر اس میں اللہ کو بہت تھوڑا یاد کرتا ہے ۔"
"12538","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ جب نبی ﷽ نے احد پہاڑ کو دیکھا تو فرمایا کہ اس پہاڑ سے ہم محبت کرتے ہیں اور یہ ہم سے محبت کرتا ہے ، اے اللہ ! حضرت ابراہیم علیہ السلام نے مکہ مکرمہ کو حرم قرار دیا تھا اور میں مدینہ منورہ کے دونوں کونوں کے درمیان والی جگہ کو حرم قرار دیتا ہوں ۔"
"12539","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ حضرت زید بن حارثہ رضی اللہ عنہ کے گھر تشریف لے گئے ، وہاں صرف ان کی اہلیہ حضرت زینب رضی اللہ عنہا نظر آئیں ، تھوڑی دیر بعد حضرت زید رضی اللہ عنہ اپنی اہلیہ کی شکایت لے کر نبی ﷽ کے پاس آئے ، نبی ﷽ نے ان سے فرمایا کہ اپنی بیوی کو اپنے پاس رکھو اور اللہ سے ڈرو ، اس پر یہ آیت نازل ہوئی ®واتق اللہ وتخفی فی نفسک¾ ۔"
"12540","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نبی ﷽ کے پاس آیا اور کہنے لگا کہ میں سورہ اخلاص سے محبت رکھتا ہوں ، نبی ﷽ نے فرمایا تمہارا اس سورت سے محبت کرنا تمہیں جنت میں داخل کروا دے گا ۔"
"12541","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو برتن میں کدو کے ٹکڑے تلاش کرتے ہوئے دیکھا تو میں اس وقت سے اسے پسند کرنے لگا ۔"
"12542","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک شخص نے نبی ﷽ سے عرض کیا یا رسول اللہ ﷽ ! میں فلاں شخص سے محبت کرتا ہوں ، نبی ﷽ نے اس سے فرمایا کیا تم نے اسے یہ بات بتائی بھی ہے آ اس نے کہا نہیں ، نبی ﷽ نے فرمایا پھر جا کر اسے بتا دو ، چنانچہ اس نے اس آدمی سے مل کر اسے بتا دیا کہ میں اللہ کی رضا کے لیے آپ سے محبت کرتا ہوں ، اس نے جواب دیا کہ جس ذات کی خاطر تم مجھ سے محبت کرتے ہو ، وہ تم سے محبت کرے ۔"
"12543","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ ہمیں جمعہ کی نماز زوال کے وقت ہی پڑھا دیا کرتے تھے ۔"
"12544","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ مسجد میں آتے تو وہاں انصار و مہاجرین سب ہی موجود ہوتے ، لیکن سوائے حضرت ابوبکر رضی اللہ عنہ و عمر رضی اللہ عنہ کے کوئی اپنا سر نہ اٹھاتا تھا ، نبی ﷽ انہیں دیکھ کر مسکراتے اور وہ دونوں نبی ﷽ کو دیکھ کر مسکراتے ۔"
"12545","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک حبشی مسجد کی صفائی ستھرائی کرتا تھا ، ایک دن وہ فوت ہو گیا اور لوگوں نے راتوں رات اسے دفن کر دیا ، نبی ﷽ کو پتہ چلا تو آپ ﷽ نے صحابہ رضی اللہ عنہم سے فرمایا اس کی قبر پر چلو ، چنانچہ وہ اس کی قبر پر گئے ، نبی ﷽ نے فرمایا ان قبروں میں رہنے والوں پر ظلمت چھائی ہوئی ہے ، میری نماز کی برکت سے اللہ انہیں منور کر دے گا ، چنانچہ نبی ﷽ نے اس کی قبر پر جا کر نماز جنازہ پڑھی ، اس پر ایک انصاری کہنے لگا یا رسول اللہ ! میرا بھائی بھی فوت ہوا تھا لیکن آپ نے اس کی قبر پر نماز جنازہ نہیں پڑھی تھی آ نبی ﷽ نے فرمایا اس کی قبر کہاں ہے آ انصاری نے اس کی نشاندہی کی تو نبی ﷽ اس کے ساتھ بھی چلے گئے ۔"
"12546","حضرت انس رضی اللہ عنہ سے مروی ہے جناب رسول اللہ ﷽ نے ارشاد فرمایا قیامت کے دن ہر دھوکے باز کے لئے ایک جھنڈا ہو گا ۔"
"12547","حضرت حفصہ رضی اللہ عنہا کہتی ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ ابن ابی عمرہ کیسے فوت ہوئے آ انہوں نے بتایا کہ طاعون کی بیماری سے ، پھر حضرت انس رضی اللہ عنہ نے فرمایا کہ نبی ﷽ نے ارشاد فرمایا طاعون ہر مسلمان کے لئے شہادت ہے ۔"
"12548","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب تم میں سے کسی کو نماز پڑھتے ہوئے اونگھ آنے لگے تو اسے چاہئے کہ واپس جا کر سو جائے یہاں تک کہ اسے پتہ چلنے لگے کہ وہ کیا کہہ رہا ہے آ"
"12549","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت ابوطلحہ رضی اللہ عنہ سے فرمایا کہ اپنی قوم کو میرا سلام کہنا ، کیونکہ میں ایسے عفیف اور صابر لوگ نہیں جانتا ۔"
"12550","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کے سامنے انصار کی کچھ عورتیں ، بچے اور خادم ایک شادی سے آتے ہوئے گذرے ، نبی ﷽ نے انہیں سلام کیا اور فرمایا اللہ کی قسم ! میں تم لوگوں سے محبت کرتا ہوں ۔"
"12551","حضرت انس رضی اللہ عنہ سے مروی ہے نبی ﷽ نے ارشاد فرمایا جب تم جنت کے باغات سے گزرو تو اس کا پھل کھایا کرو ، صحابہ رضی اللہ عنہم نے پوچھا جنت کے باغات سے کیا مراد ہے آ نبی ﷽ نے فرمایا ذکر کے حلقے ۔"
"12552","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت بلال رضی اللہ عنہ نے نماز فجر میں کچھ تاخیر کر دی ، نبی ﷽ نے ان سے پوچھا کہ تمہیں کس چیز نے روکے رکھا آ انہوں نے فرمایا کہ میں حضرت فاطمہ رضی اللہ عنہا کے پاس سے گزرا ، وہ آٹا پیس رہی تھیں اور بچہ رو رہا تھا ، میں نے ان سے کہا کہ اگر آپ چاہیں تو میں آٹا پیس دیتا ہوں اور آپ بچے کو سنبھال لیں ، اور اگر چاہیں تو میں بچے کو سنبھال لیتا ہوں اور آپ آٹا پیس لیں آ انہوں نے فرمایا کہ اپنے بچے پر میں زیادہ نرمی کر سکتی ہوں ، اس وجہ سے مجھے دیر ہو گئی ، نبی ﷽ نے فرمایا تم نے اس پر رحم کھایا ، اللہ تم پر رحم فرمائے ۔"
"12553","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ سفر میں نماز مغرب و عشاء اکٹھی پڑھ لیتے تھے ۔"
"12554","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہماری نگاہوں میں نبی ﷽ سے زیادہ محبوب کوئی شخص نہ تھا ، لیکن ہم نبی ﷽ کو دیکھ کر کھڑے نہ ہوتے تھے کیونکہ ہم جانتے تھے کہ نبی ﷽ اسے اچھا نہیں سمجھتے ۔"
"12555","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا علامات قیامت میں یہ بات بھی شامل ہے کہ علم اٹھا لیا جائے گا ، جہالت چھا جائے گی ، شرابیں پی جائیں گی اور بدکاری کا دور دورہ ہو گا ۔"
"12556","حضرت انس رضی اللہ عنہ سے مروی ہے صحابہ کرام رضی اللہ عنہم نے نبی ﷽ سے عرض کیا یا رسول اللہ ﷽ ! آپ کا فلاں غلام شہید ہو گیا آ نبی ﷽ نے فرمایا ہرگز نہیں ، میں نے اس پر ایک عباء دیکھی تھی جو اس نے فلاں دن مال غنیمت میں سے خیانت کر کے حاصل کی تھی ۔"
"12557","ایک مرتبہ علاء بن زیاد رحمۃ اللہ نے حضرت انس رضی اللہ عنہ سے پوچھا اے ابوحمزہ ! نبی ﷽ کتنے سال کے تھے جب آپ ﷽ مبعوث ہوئے آ انہوں نے فرمایا چالیس سال کے ، علاء نے پوچھا اس کے بعد کیا ہوا آ انہوں نے فرمایا کہ دس سال آپ ﷽ مکہ مکرمہ میں رہے ، دس سال مدینہ منورہ میں رہے ، اس طرح ساٹھ سال پورے ہو گئے ، اس کے بعد اللہ نے نبی ﷽ کو اپنے پاس بلا لیا ، علاء نے پوچھا کہ اس وقت نبی ﷽ کس عمر کے آدمی محسوس ہوتے تھے آ انہوں نے فرمایا جیسے ایک حسین و جمیل اور بھرے جسم والا نوجوان ہوتا ہے ، علاء بن زیاد رحمۃ اللہ نے پھر پوچھا کہ ابوحمزہ ! کیا آپ نے حضرت رسول کریم ﷽ کے ساتھ جہاد کیا ہے آ انہوں نے کہا ہاں میں آپ ﷽ کے ہمراہ غزوہ حنین میں موجود تھا ، مشرکین کثرت سے باہر نکلے اور ہم پر حملہ کر دیا ، یہاں تک کہ ہم نے اپنے گھوڑوں کو اپنی پشت کے پیچھے دیکھا اور کفار میں ایک شخص تھا جو کہ ہم لوگوں پر حملہ کرتا تھا اور تلوار سے زخمی کر دیتا تھا اور مارتا تھا یہ دیکھ کر نبی ﷽ سواری سے اتر پڑے ، پھر اللہ تعالیٰ نے ان کو شکست دے دی ، اور وہ پیٹھ پھیر کر بھاگنے لگے ، فتح حاصل ہوتے ہوئے دیکھ کر نبی ﷽ کھڑے ہو گئے اور ایک ایک کر کے اسیران جنگ لائے جانے لگے اور وہ آ کر آنحضرت ﷽ سے اسلام پر بیعت کرنے لگے ۔ ایک شخص نے جو کہ آپ کے صحابہ کرام رضی اللہ عنہم میں سے تھا اس بات کی نذر مانی کہ اگر اس شخص کو قیدی بنا کر لایا گیا جس نے اس دن ہم لوگوں کو زخمی کر دیا تھا تو اس کو قتل کر دوں گا ۔ یہ بات سن کر آنحضرت ﷽ خاموش ہو گئے اور وہ شخص لایا گیا جب اس شخص نے آپ ﷽ کو دیکھا تو عرض کیا یا رسول اللہ ﷽ میں نے اللہ سے توبہ کر لی + یہ سن کر , آپ ﷽ نے بیعت کرنے میں توقف فرمایا اس خیال سے کہ وہ صحابی رضی اللہ عنہ اپنی نذر مکمل کر لے + یعنی اس شخص کو جلد از جلد قتل کر ڈالے , لیکن وہ صحابی اس بات کے انتظار میں تھے کہ آپ اس شخص کو قتل کرنے کا حکم فرمائیں گے تو میں اس شخص کو قتل کروں اور وہ اس بات سے ڈرتا تھا کہ ایسا نہ ہو کہ میں اس شخص کو قتل کر دوں اور آپ مجھ سے ناراض ہو جائیں ، جب آپ ﷽ نے دیکھا کہ وہ صحابی کچھ نہیں کر رہے یعنی کسی طریقہ پر اس شخص کو قتل نہیں کرتے تو بالآخر مجبوراَ آپ ﷽ نے اس کو بیعت فرما لیا ۔ اس پر صحابی نے عرض کیا یا رسول اللہ ﷽ میری نذر کس طریقہ پر مکمل ہو گی آ آپ ﷽ نے ارشاد فرمایا کہ میں اس وقت تک جو رکا رہا اور میں نے اس شخص کو بیعت نہیں کیا تو اس خیال سے کہ تم اپنی نذر مکمل کر لو ، انہوں نے عرض کیا یا رسول اللہ ﷽ ! آپ نے مجھے اشارہ کیوں نہیں کیا آ آپ ﷽ نے فرمایا پیغمبر کے لیے آنکھ سے خفیہ اشارہ کرنا مناسب نہیں ہے ۔"
"12558","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ حضرت ابوطلحہ رضی اللہ عنہ کے باغات میں قضاء حاجت کے لئے جا رہے تھے ، حضرت بلال رضی اللہ عنہ نبی ﷽ کے پیچھے چل رہے تھے ، اور وہ نبی ﷽ کے پہلو میں چلنا بے ادبی سمجھتے تھے ، چلتے چلتے نبی ﷽ کا گذر ایک قبر کے پاس سے ہوا ، نبی ﷽ وہاں کھڑے ہو گئے یہاں تک کہ حضرت بلال رضی اللہ عنہ بھی آ پہنچے ، نبی ﷽ نے فرمایا ہائے بلال ! کیا تمہیں بھی وہ آواز سنائی دے رہی ہے جو میں سن رہا ہوں آ انہوں نے عرض کیا کہ مجھے تو کوئی آواز سنائی نہیں دے رہی ، نبی ﷽ نے فرمایا اس قبر والے کو عذاب ہو رہا ہے ، پوچھنے پر معلوم ہوا کہ وہ یہودی تھا ۔"
"12559","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت عائشہ رضی اللہ عنہا کے پاس ایک پردہ تھا جو انہوں نے اپنے گھر کے ایک کونے میں لٹکا دیا ، نبی ﷽ نے ان سے فرمایا یہ پردہ یہاں سے ہٹا دو ، کیونکہ اس کی تصاویر مسلسل نماز میں میرے سامنے آتی رہیں ۔"
"12560","عبدالعزیز رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ ہم لوگ حضرت انس رضی اللہ عنہ کے پاس ثابت کے ساتھ گئے ، ثابت نے اپنی بیماری کے متعلق بتایا ، انہوں نے فرمایا کیا میں تمہیں وہ منتر نہ بتااں جو نبی ﷽ کرتے تھے آ انہوں نے کہا کیوں نہیں ، فرمایا یوں کہو اے اللہ ! لوگوں کے رب ! تکالیف کو دور کرنے والے ! شفاء عطاء فرما کہ تو ہی شفاء دینے والا ہے ، تیرے علاوہ کوئی شفاء دینے والا نہیں ہے ، ایسی شفاء عطاء فرما جو بیماری کا نام و نشان بھی نہ چھوڑے ۔"
"12561","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اگر نماز عشاء اور نماز فجر سے پیچھے رہ جانے والوں کو یہ معلوم ہو جائے کہ ان دونوں نمازوں کا کیا ثواب ہے تو وہ ان میں ضرور شرکت کریں اگرچہ گھٹنوں کے بل ہی آنا پڑے ۔"
"12562","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے کسی درخت کی ٹہنی کو پکڑ کر ہلایا لیکن اس کے پتے نہیں جھڑے دوبارہ ہلانے پر بھی نہ جھڑے ، البتہ تیسری مرتبہ ہلانے پر اس کے پتے جھڑنے لگے ، نبی ﷽ نے فرمایا کہ ®سبحان اللہ والحمدللہ ولا الہ الا اللہ¾ اور ®اللہ اکبر¾ سے گناہ اسی طرح جھڑ جاتے ہیں جیسے درخت سے اس کے پتے جھڑ جاتے ہیں ۔"
"12563","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا وہ مسلمان آدمی جس کے تین نابالغ بچے فوت ہو گئے ہوں ، اللہ ان بچوں کے ماں باپ کو اپنے فضل و کرم سے جنت میں داخلہ عطاء فرمائے گا ۔"
"12564","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جہنم کا لباس سب سے پہلے ابلیس کو پہنایا جائے گا اور وہ اسے اپنی ابرواں پر رکھے گا ، اس کے پیچھے اس کی ذریت گھستی چلی آ رہی ہو گی ، شیطان ہائے ہلاکت کی آواز لگا رہا ہو گا اور اس کی ذریت بھی ہائے ہلاکت کہہ رہی ہو گی ، یہی کہتے کہتے وہ جہنم کے پاس پہنچ کر رک جائیں گے ، شیطان پھر یہی کہے گا ہائے ہلاکت اور اس کی ذریت بھی یہی کہے گی ، اس موقع پر ان سے کہا جائے گا کہ آج ایک ہلاکت کو نہ پکارو ، کئی ہلاکتوں کو پکارو ۔"
"12565","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قیامت اس وقت تک قائم نہ ہو گی جب تک لوگ مساجد کے بارے میں ایک دوسرے پر فخر نہ کرنے لگیں ۔"
"12566","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ احد کے دن نبی ﷽ کی دعاء یہ تھی کہ اے اللہ ! کیا تو یہ چاہتا ہے کہ آج کے بعد تیری عبادت نہ کی جائے ۔"
"12567","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جب اللہ نے حضرت آدم علیہ السلام کا پتلا تیار کیا تو کچھ عرصے تک اسے یونہی رہنے دیا ، شیطان اس پتلے کے اردگرد چکر لگاتا تھا اور اس پر غور کرتا تھا ، جب اس نے دیکھا کہ اس مخلوق کے جسم کے درمیان میں پیٹ ہے تو وہ سمجھ گیا کہ یہ مخلوق اپنے اوپر قابو نہ رکھ سکے گی ۔"
"12568","حضرت انس رضی اللہ عنہ سے مروی ہے کہ کچھ حبشی نبی ﷽ کے سامنے رقص کرتے ہوئے یہ گانا گا رہے تھے کہ محمد + ﷽ , نیک آدمی ہیں ، نبی ﷽ نے پوچھا یہ لوگ کیا کہہ رہے ہیں آ لوگوں نے بتایا کہ یہ کہہ رہے ہیں محمد + ﷽ , نیک آدمی ہیں ۔"
"12569","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا کہ جنتی جنت میں داخل ہو جائیں گے تو جنت میں کچھ جگہ زائد بچ جائے گی ، اللہ اس کے لئے ایک اور مخلوق کو پیدا کر کے جنت کو بھر دے گا ۔"
"12570","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا مجھے کوثر عطاء کی گئی ہے ، وہ ایک نہر ہے جو سطح زمین پر بھی بہتی ہے ، اس کے دونوں کناروں پر موتیوں کے خیمے لگے ہوئے ہیں ، جنہیں توڑا نہیں گیا ، میں نے ہاتھ لگا کر اس کی مٹی کو دیکھا تو وہ مشک خالص تھی ، اور اس کی کنکریاں موتی تھے ۔"
"12571","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ بنو نجار کے ایک آدمی کے پاس اس کی عیادت کے لئے تشریف لے گئے اور اس سے فرمایا ماموں جان ! ®لا الہ الا اللہ¾ کا اقرار کر لیجئے ، اس نے کہا ماموں یا چچا آ نبی ﷽ نے فرمایا نہیں ، ماموں ! ®لا الہ الا اللہ¾ کہہ لیجئے ، اس نے پوچھا کہ کیا یہ میرے حق میں بہتر ہے آ نبی ﷽ نے فرمایا ہاں ۔"
"12572","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کے کانوں میں کچھ آوازیں پڑیں ، نبی ﷽ نے پوچھا کہ یہ کیسی آوازیں ہیں آ لوگوں نے بتایا کہ کھجور کی پیوند کاری ہو رہی ہے ، نبی ﷽ نے فرمایا اگر یہ لوگ پیوند کاری نہ کریں تو شاید ان کے حق میں بہتر ہو ، چنانچہ لوگوں نے اس سال پیوند کاری نہیں کی ، جس کی وجہ سے اس سال کھجور کی فصل اچھی نہ ہوئی ، نبی ﷽ نے وجہ پوچھی تو صحابہ رضی اللہ عنہم نے عرض کیا کہ آپ کے کہنے پر لوگوں نے پیوند کاری نہیں کی ، نبی ﷽ نے فرمایا اگر تمہارا کوئی دنیوی معاملہ ہو تو وہ تم مجھ سے بہتر جانتے ہو اور اگر دین کا معاملہ ہو تو اسے لے کر میرے پاس آیا کرو ۔"
"12573","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت ابوعبیدہ بن الجراح رضی اللہ عنہ اور حضرت ابوطلحہ رضی اللہ عنہ کے درمیان مواخات کا رشتہ قائم فرمایا تھا ۔"
"12574","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کو حنا کی کلی بہت پسند تھی اور کھانوں میں سب سے زیادہ پسندیدہ کھانا کدو تھا ۔"
"12575","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ بعض اوقات نماز میں ہوتے تھے لیکن کسی بچے کے رونے کی وجہ سے اس کی ماں کی خاطر نماز مختصر کر دیتے تھے ۔"
"12576","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نبی ﷽ کے ساتھ چلا جا رہا تھا ، آپ ﷽ نے موٹے کنارے والی ایک نجرانی چادر اوڑھ رکھی تھی ، راستے میں ایک دیہاتی مل گیا اور اس نے نبی ﷽ کی چادر کو ایسے گھسیٹا کہ اس کے نشانات نبی ﷽ کی گردن مبارک پر پڑ گئے اور کہنے لگا کہ اے محمد ! ﷽ ، اللہ کا جو مال آپ کے پاس ہے اس میں سے مجھے بھی دیجئے ، نبی ﷽ نے اس کی طرف دیکھا اور صرف مسکرا دیئے ، پھر اسے کچھ دینے کا حکم دیا ۔"
"12577","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا مظلوم کی بددعاء سے بچا کرو ، اگرچہ وہ کافر ہی ہو ، کیونکہ اس کی دعاء میں کوئی چیز حائل نہیں ہوتی ۔"
"12578","اور نبی ﷽ نے فرمایا جس چیز میں تمہیں شک ہو ، اسے چھوڑ کر وہ چیز اختیار کر لو جس میں تمہیں کوئی شک نہ ہو ۔"
"12579","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک شخص نے نبی ﷽ کو مخاطب کر کے کہا اے محمد ! ﷽ ، اے ہمارے سردار ابن سردار ، اے ہمارے خیر ابن خیر ! نبی ﷽ نے فرمایا لوگو ! تقویٰ کو اپنے اوپر لازم کر لو ، شیطان تم پر حملہ نہ کر دے ، میں صرف محمد بن عبداللہ ہوں ، اللہ کا بندہ اور اس کا پیغمبر ہوں ، بخدا ! مجھے یہ چیز پسند نہیں ہے کہ تم مجھے میرے مرتبے سے """" جو اللہ کے یہاں ہے """" بڑھا چڑھا کر بیان کرو ۔"
"12580","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب اپنے بستر پر تشریف لاتے تو یوں کہتے کہ اس اللہ کا شکر ہے جس نے ہمیں کھلایا پلایا ، ہماری کفایت کی اور ٹھکانہ دیا ، کتنے ہی لوگ ایسے ہیں جن کی کوئی کفایت کرنے والا یا انہیں ٹھکانہ دینے والا کوئی نہیں ہے ۔"
"12581","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ اپنے سفید خچر پر سوار مدینہ منورہ میں بنو نجار کے کسی باغ سے گذرے ، وہاں کسی قبر میں عذاب ہو رہا تھا ، چنانچہ خچر بدک گیا ، نبی ﷽ نے فرمایا اگر تم لوگ اپنے مردوں کو دفن کرنا چھوڑ نہ دیتے تو میں اللہ سے یہ دعاء کرتا کہ وہ تمہیں بھی عذاب قبر کی آواز سنا دے ۔"
"12582","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے بارش کی دعاء کی تو ہتھیلیوں کا اوپر والا حصہ آسمان کی جانب کر لیا ۔"
"12583","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا مشرکین کے ساتھ اپنی جان ، مال اور زبان اور ہاتھ کے ذریعے جہاد کرو ۔"
"12584","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ کے راستے میں ایک صبح یا شام جہاد کرنا دنیا و مافیہا سے بہتر ہے اور جنت میں ایک کمان رکھنے کی جگہ دنیا و مافیہا سے بہتر ہے ۔"
"12585","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جنت میں داخل ہونے والا کوئی شخص بھی جنت سے نکلنا کبھی پسند نہیں کرے گا سوائے شہید کے کہ جس کی خواہش یہ ہو گی کہ وہ جنت سے نکلے اور پھر اللہ کی راہ میں شہید ہو ، کیونکہ اسے اس کی فضیلت نظر آ رہی ہو گی ۔"
"12586","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا بیت المعمور ساتویں آسمان پر ہے ، جس میں روزانہ ستر ہزار فرشتے داخل ہوتے ہیں ، اور دوبارہ ان کی باری نہیں آتی ۔"
"12587","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جنت کو مشقتوں سے اور جہنم کو خواہشات سے ڈھانپ دیا گیا ہے ۔"
"12588","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جہنم کا لباس سب سے پہلے ابلیس کو پہنایا جائے گا اور وہ اسے اپنی ابرواں پر رکھے گا ، اس کے پیچھے اس کی ذریت گھستی چلی آ رہی ہو گی ، شیطان ہائے ہلاکت کی آواز لگا رہا ہو گا اور اس کی ذریت بھی ہائے ہلاکت کہہ رہی ہو گی ، یہی کہتے کہتے وہ جہنم کے پاس پہنچ کر رک جائیں گے ، شیطان پھر یہی کہے گا ہائے ہلاکت اور اس کی ذریت بھی یہی کہے گی ، اس موقع پر ان سے کہا جائے گا کہ آج ایک ہلاکت کو نہ پکارو ، کئی ہلاکتوں کو پکارو ۔"
"12589","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا مومن وہ ہوتا ہے جس سے لوگ مامون ہوں ، مسلمان وہ ہوتا ہے جس کی زبان اور ہاتھ سے دوسرے مسلمان سلامت رہیں ، مہاجر وہ ہوتا ہے جو گناہوں سے ہجرت کر لے ، اور اس ذات کی قسم جس کے دست قدرت میں میری جان ہے ، کوئی شخص اس وقت تک جنت میں داخل نہ ہو گا جب تک اس کے پڑوسی اس کی ایذاء رسانی سے محفوظ نہ ہوں ۔"
"12590","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"12591","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ انصار کے ایک آدمی کے پاس اس کی عیادت کے لئے تشریف لے گئے اور اس سے فرمایا ماموں جان ! ®لا الہ الا اللہ¾ کا اقرار کر لیجئے ، اس نے کہا ماموں یا چچا آ نبی ﷽ نے فرمایا نہیں ، ماموں ! ®لا الہ الا اللہ¾ کہہ لیجئے ، اس نے پوچھا کہ کیا یہ میرے حق میں بہتر ہے آ نبی ﷽ نے فرمایا ہاں ۔"
"12592","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا کوئی بیماری متعدی نہیں ہوتی اور بدشگونی کی کوئی حیثیت نہیں ، البتہ مجھے فال یعنی اچھا اور پاکیزہ کلمہ اچھا لگتا ہے ۔"
"12593","عمرو بن عامر نے حضرت انس رضی اللہ عنہ سے ہر نماز کے وقت وضو کے متعلق پوچھا تو انہوں نے جواب دیا کہ نبی ﷽ تو ہر نماز کے وقت نیا وضو فرماتے تھے اور ہم بے وضو ہونے تک ایک ہی وضو سے کئی کئی نمازیں بھی پڑھ لیا کرتے تھے ۔"
"12594","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا ابن آدم کو جب سے اللہ نے پیدا کیا ہے ، اس نے موت سے زیادہ سخت کوئی چیز نہیں دیکھی ، لیکن اس کے بعد یہی موت اس کے لئے انتہائی آسان ہو جائے گی ۔"
"12595","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے بہت کم ہمیں کوئی خطبہ ایسا دیا ہے جس میں یہ نہ فرمایا ہو کہ اس شخص کا ایمان نہیں جس کے پاس امانت داری نہ ہو اور اس شخص کا دین نہیں جس کے پاس وعدہ کی پاسداری نہ ہو ۔"
"12596","مختار بن فلفل رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ برتنوں میں پینے کا کیا حکم ہے آ انہوں نے جواب دیا کہ نبی ﷽ نے """" مزفت """" سے منع فرمایا ہے ، میں نے پوچھا کہ """" مزفت """" سے کیا مراد ہے آ انہوں نے فرمایا لک لگا ہوا برتن ۔"
"12597","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نبی ﷽ نے فرمایا میں تمہارا امام ہوں ، لہذا رکوع ، سجدہ ، قیام ، میں مجھ سے آگے نہ بڑھا کرو ، کیونکہ میں تمہیں اپنے آگے سے بھی دیکھتا ہوں اور پیچھے سے بھی ، اور اس ذات کی قسم جس کے دست قدرت میں محمد ﷽ کی جان ہے ، جو میں دیکھ چکا ہوں ، اگر تم نے وہ دیکھا ہوتا تو تم بہت تھوڑا ہنستے اور کثرت سے رویا کرتے ، صحابہ رضی اللہ عنہم نے پوچھا یا رسول اللہ ﷽ ! آپ نے کیا دیکھا ہے آ فرمایا میں نے اپنی آنکھوں سے جنت اور جہنم کو دیکھا ہے ۔"
"12598","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ماہ رمضان میں نبی ﷽ باہر تشریف لائے ، اور مختصر سی نماز پڑھا کر چلے گئے ، کافی دیر گذرنے کے بعد دوبارہ آئے اور مختصر سی نماز پڑھا کر دوبارہ واپس چلے گئے اور کافی دیر تک اندر رہے ، جب صبح ہوئی تو ہم نے عرض کیا اے اللہ کے نبی ! ہم آج رات بیٹھے ہوئے تھے ، آپ تشریف لائے اور مختصر سی نماز پڑھائی اور کافی دیر تک کے لئے گھر میں چلے گئے آ نبی ﷽ نے فرمایا میں نے تمہاری وجہ سے ہی ایسا کیا تھا ۔"
"12599","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک درخت سے راستے میں گذرنے والوں کو اذیت ہوتی تھی ، ایک آدمی نے اسے آ کر ہٹا دیا ، نبی ﷽ نے فرمایا میں نے جنت میں اسے درختوں کے سائے میں پھرتے ہوئے دیکھا ہے ۔"
"12600","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا صفوں کو پر کیا کرو ، کیونکہ درمیان کی خالی جگہ میں شیاطین گھس جاتے ہیں ۔"
"12601","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے یہاں ایک آدمی آیا ، اس پر پیلا رنگ لگا ہوا دیکھا تو اس پر ناگواری ظاہر فرمائی جب وہ چلا گیا تو کسی صحابی سے دو تین فرمایا کہ اگر تم اس شخص کو یہ رنگ دھو دینے کا حکم دیتے تو کیا ہی اچھا ہوتا آ اور نبی ﷽ کی یہ عادت مبارکہ تھی کہ کسی کے سامنے اس طرح کا چہرہ لے کر نہ آتے تھے جس سے ناگواری کا اظہار ہوتا ہو ۔"
"12602","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے پاس ایک سائل آیا ، نبی ﷽ نے اسے کھجوریں دینے کا حکم دیا ، لیکن اس نے انہیں ہاتھ نہ لگایا ، دوسرا آیا تو نبی ﷽ نے اسے کھجوریں دینے کا حکم دیا ، اس نے خوش ہو کر انہیں قبول کر لیا اور کہنے لگا سبحان اللہ ! نبی ﷽ کی طرف سے کھجوریں ، اس پر نبی ﷽ نے اپنی باندی سے فرمایا کہ ام سلمہ رضی اللہ عنہا کے پاس جاا اور اسے ان کے پاس رکھے ہوئے چالیس درہم دلوا دو ۔"
"12603","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا یاد رکھو ! مزات + یعنی کچی اور پکی کھجوروں کو ملا کر بنائی ہوئی نبیذ , حرام ہے ۔"
"12604","حمید رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ کے پاس نبی ﷽ کا ایک پیالہ دیکھا جس میں چاندی کا حلقہ لگا ہوا تھا ۔"
"12605","[Darussalam 12577] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12606","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ایک مرتبہ طوبی + خوشخبری , ہے ان لوگوں کے لئے جنہوں نے مجھے دیکھا اور مجھ پر ایمان لائے ، اور سات مرتبہ طوبی ہے ان لوگوں کے لئے جو مجھ پر بن دیکھے ایمان لائیں گے ۔"
"12607","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا کاش ! میں اپنے بھائیوں سے مل پاتا ، صحابہ کرام رضی اللہ عنہم نے عرض کیا کہ کیا ہم آپ کے بھائی نہیں ہیں آ نبی ﷽ نے فرمایا تم میرے صحابہ ہو ، میرے بھائی وہ لوگ ہیں جو مجھ پر ایمان لائے ہوں گے لیکن میری زیارت نہ کر سکے ہوں گے ۔"
"12608","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک خاتون نبی ﷽ کی خدمت میں حاضر ہوئی اور اپنی بیٹی کے حسن و جمال کی تعریف کر کے کہنے لگی کہ وہ میں نے آپ کی نذر کی ، نبی ﷽ نے فرمایا مجھے قبول ہے ، تعریف کرتے کرتے اس کے منہ سے یہ نکل گیا کہ کبھی اس کے سر میں درد ہوا اور نہ کبھی وہ بیمار ہوئی ، نبی ﷽ نے فرمایا پھر مجھے تمہاری بیٹی کی ضرورت نہیں ۔"
"12609","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ تشریف لے آئے اور فرمانے لگے کہ تمہارے درمیان ایک ذات + خود نبی ﷽ , تم سے بہتر موجود ہے کہ تم کتاب اللہ کی تلاوت کر رہے ہو اور سرخ و سفید عربی و عجمی سب تمہارے درمیان موجود ہیں ، عنقریب لوگوں پر ایک زمانہ ایسا بھی آئے گا جس میں لوگ ایسے کھڑکھڑائیں گے جیسے برتن کھڑکھڑاتے ہیں ، وہ اپنا اجر فوری وصول کر لیں گے ، آگے کے لئے کچھ نہ رکھیں گے ۔"
"12610","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا کل تمہارے پاس ایسی قومیں آئیں گی جن کے دل تم سے بھی زیادہ نرم ہوں گے ، چنانچہ ایک مرتبہ اشعریین آئے ، ان میں حضرت ابوموسیٰ اشعری رضی اللہ عنہ بھی شامل تھے ، جب وہ مدینہ منورہ کے قریب پہنچے تو یہ رجزیہ شعر پڑھنے لگے کہ کل ہم اپنے دوستوں یعنی محمد + ﷽ , اور ان کے ساتھیوں سے ملاقات کریں گے ، وہاں پہنچ کر انہوں نے مصافحہ کیا ، اور سب سے پہلے مصافحہ کی بنیاد ڈالنے والے یہی لوگ تھے ۔"
"12611","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جو شخص میری مسجد میں چالیس نمازیں اس طرح پڑھ لے کہ اس سے کوئی نماز چھوٹ نہ جائے ، اس کے لئے جہنم سے براءت ، عذاب سے نجات اور نفاق سے برئت لکھ دی جاتی ہے ۔"
"12612","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اذان اور اقامت کے درمیانی وقت میں کی جانے والی دعاء رد نہیں ہوتی لہٰذا اس وقت دعاء کیا کرو ۔"
"12613","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص تین مرتبہ جنت کا سوال کر لے تو جنت خود کہتی ہے کہ اے اللہ ! اس بندے کو مجھ میں داخلہ عطاء فرما ، اور جو شخص تین مرتبہ جہنم سے پناہ مانگ لے ، جہنم خود کہتی ہے کہ اے اللہ ! اس بندے کو مجھ سے بچا لے ۔"
"12614","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نبی ﷽ کے ساتھ حضرت زید بن ارقم رضی اللہ عنہ کی عیادت کے لئے گیا ، ان کی آنکھوں کی بصارت ختم ہو گئی تھی ، نبی ﷽ نے ان سے فرمایا زید ! یہ بتاا کہ اگر تمہاری آنکھیں وہاں چلی جائیں جہاں کے لیے ہیں تو تم کیا کرو گے آ انہوں نے عرض کیا کہ میں صبر کروں گا اور ثواب کی امید رکھوں گا ، نبی ﷽ نے فرمایا اگر تمہاری بینائی ختم ہو گئی اور تم نے اس پر صبر کیا اور ثواب کی امید رکھی ، تو تم اللہ سے اس طرح ملو گے کہ تم پر کوئی گناہ نہیں ہو گا ۔"
"12615","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ بعض اوقات نماز میں ہوتے تھے لیکن کسی بچے کے رونے کی وجہ سے اس کی ماں کی خاطر نماز مختصر کر دیتے تھے ۔"
"12616","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص یہ چاہتا ہے کہ اللہ اس کے رزق میں اضافہ کر دے اور اس کی عمر بڑھا دے تو اسے صلہ رحمی کرنی چاہیے ۔"
"12617","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو سفر میں چاشت کی آٹھ رکعتیں پڑھتے ہوئے دیکھا ہے ، اور نماز سے فارغ ہو کر نبی ﷽ نے فرمایا میں نے شوق اور خوف والی نماز پڑھی ، میں نے اپنے پروردگار سے تین چیزوں کی درخواست کی ، اس نے مجھے دو چیزیں عطاء فرما دیں اور ایک سے روک دیا ، میں نے یہ درخواست کی کہ میری امت قحط سالی میں مبتلاء ہو کر ہلاک نہ ہو ، اور دشمن کو ان پر مکمل غلبہ نہ دیا جائے ، اللہ نے اسے منظور کر لیا ، پھر میں نے تیسری درخواست یہ پیش کی کہ انہیں مختلف فرقوں میں تقسیم نہ ہونے دے لیکن اللہ نے اسے منظور نہیں کیا ۔"
"12618","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نبی ﷽ کی مجلس میں بیٹھا ہوا تھا کہ وہاں سے ایک آدمی کا گذر ہوا ، بیٹھے ہوئے لوگوں میں سے کسی نے کہا کہ یا رسول اللہ ﷽ ! میں اس شخص سے محبت کرتا ہوں ، نبی ﷽ نے اس سے فرمایا کیا تم نے اسے یہ بات بتائی ہے آ اس نے کہا نہیں ، نبی ﷽ نے فرمایا پھر جا کر اسے بتا دو ، اس پر وہ آدمی کھڑا ہوا اور جا کر اس سے کہنے لگا بھائی ! میں اللہ کی رضا کے لئے آپ سے محبت کرتا ہوں ، اس نے جواب دیا کہ جس ذات کی خاطر تم مجھ سے محبت کرتے ہو وہ تم سے محبت کرے ۔"
"12619","حضرت ابوسعید خدری رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کے دور باسعادت میں مہنگائی بڑھ گئی تو صحابہ رضی اللہ عنہم نے عرض کیا کہ آپ ہمارے لیے نرخ مقرر فرما دیجئے ، نبی ﷽ نے فرمایا انسان کو پیدا کرنے والا ، رزق کو تنگ اور کشادہ کرنے والا ، رزق عطا فرمانے والا ، قیمت مقرر کرنے اور نرخ مقرر کرنے والا اللہ ہی ہے ، میں چاہتا ہوں کہ جب میں تم سے جدا ہو کر جااں تو تم میں سے کوئی اپنے مال یا جان پر کسی ظلم کا مجھ سے مطالبہ کرنے والا نہ ہو ۔"
"12620","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نبی ﷽ کے پاس سے گزرا ، اس وقت نبی ﷽ کے پاس ان کی کوئی زوجہ محترمہ تھیں ، نبی ﷽ نے اس آدمی کو اس کا نام لے کر پکارا کہ اے فلاں ! یہ میری بیوی ہے ، وہ آدمی کہنے لگا یا رسول اللہ ﷽ ! میں جس شخص کے ساتھ بھی ایسا گمان کروں ، آپ کے ساتھ نہیں کر سکتا ، نبی ﷽ نے فرمایا شیطان انسان کے اندر خون کی طرح دوڑتا ہے ۔"
"12621","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جس شخص کی تین بیٹیاں یا بہنیں ہوں ، وہ ان کا ذمہ دار بنا اور ان کے معاملے میں اللہ سے ڈرتا رہا ، وہ میرے ساتھ جنت میں ہو گا ، یہ کہہ کر نبی ﷽ نے چار انگلیوں سے اشارہ فرمایا ۔"
"12622","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اے اللہ ! انصار ، انصار کے بچوں ، انصار کی بیویوں اور انصار کی اولاد کی مغفرت فرما ، انصار میرا گروہ اور میرا پردہ ہیں ، اگر لوگ ایک راستے پر چل رہے ہوں اور انصار دوسرے راستے پر تو میں انصار کا راستہ اختیار کروں گا اور اگر ہجرت نہ ہوتی تو میں انصار ہی کا ایک فرد ہوتا ۔"
"12623","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا کہ اللہ تعالیٰ فرماتا ہے جب میں کسی شخص کی بینائی واپس لے لوں اور وہ اس پر صبر کرے تو میں اس کا عوض جنت عطاء کروں گا ۔"
"12624","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ نے جب بیماری کو پیدا کیا تو اس کا علاج بھی پیدا کیا ، اس لئے علاج کیا کرو ۔"
"12625","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا عائشہ رضی اللہ عنہا کو دیگر عورتوں پر ایسی ہی فضیلت ہے جیسے ثرید کو دوسرے کھانوں پر ۔"
"12626","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے لوٹ مار کرنے سے منع کرتے ہوئے فرمایا ہے کہ جو شخص لوٹ مار کرتا ہے ، وہ ہم میں سے نہیں ہے ۔ حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے کھجور اور کشمش یا کچی اور پکی کھجور کو اکٹھا کر کے + نبیذ بنانے سے , منع فرمایا ہے ۔"
"12627","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا زمین میں علماء کی مثال ایسے ہے جیسے آسمان میں ستارے کہ جن کے ذریعے بر و بحر کی تاریکیوں میں راستہ کی رہنمائی حاصل کی جاتی ہے ، اگر ستارے بے نور ہو جائیں تو راستے پر چلنے والے بھٹک جائیں ۔"
"12628","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے بال کانوں سے آگے نہ بڑھتے تھے ۔"
"12629","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ کے راستے میں ایک صبح یا شام کو جہاد کے لئے نکلنا دنیا و مافیہا سے بہتر ہے ۔"
"12630","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا تم میں سے کسی کے کمان یا کوڑا رکھنے کی جنت میں جو جگہ ہو گی ، وہ دنیا و مافیھا سے بہتر ہے ، اور اگر کوئی جنتی عورت زمین کی طرف جھانک کر دیکھ لے تو ان دونوں کی درمیانی جگہ خوشبو سے بھر جائے ، اور مہک پھیل جائے اور اس کے سر کا دوپٹہ دنیا و مافیہا سے بہتر ہے ۔"
"12631","حضرت انس رضی اللہ عنہ سے مروی ہے کہ تم لوگ ایسے اعمال کرتے ہو جن کی تمہاری نظروں میں پرکاہ سے بھی کم حیثیت ہوتی ہے ، لیکن ہم انہیں نبی ﷽ کے دور باسعادت میں مہلک چیزوں میں شمار کرتے تھے ۔"
"12632","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے حضرت عمر رضی اللہ عنہ کے پاس ایک ریشمی جبہ بھیجا ، حضرت عمر رضی اللہ عنہ سے ملاقات ہوئی تو وہ کہنے لگے کہ آپ نے مجھے ریشمی جبہ بھجوایا ہے حالانکہ اس کے متعلق آپ نے جو فرمایا ہے وہ فرمایا ہے آ نبی ﷽ نے فرمایا میں نے وہ تمہارے پاس پہننے کے لئے نہیں بھیجا ، میں نے تو صرف اس لئے بھیجا تھا کہ تم اسے بیچ دو یا اس سے کسی اور طرح نفع حاصل کر لو ۔"
"12633","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت معاذ رضی اللہ عنہ سے فرمایا جو شخص اللہ سے اس حال میں ملاقات کرے کہ وہ اس کے ساتھ کسی کو شریک نہ ٹھہراتا ہو تو وہ جنت میں داخل ہو گا ، انہوں نے عرض کیا اے اللہ کے نبی ! کیا میں لوگوں کو یہ خوشخبری نہ سنا دوں آ نبی ﷽ نے فرمایا نہیں ، مجھے اندیشہ ہے کہ وہ اسی پر بھروسہ کر کے بیٹھ جائیں گے ۔"
"12634","حضرت انس رضی اللہ عنہ سے مروی ہے کہ کسی شخص نے نبی ﷽ کو + رئیس المنافقین , عبداللہ بن ابی کے پاس جانے کا مشورہ دیا ، نبی ﷽ اپنے گدھے پر سوار ہو کر چلے گئے ، مسلمان بھی نبی ﷽ کے ساتھ پیدل روانہ ہو گئے ، زمین کچی تھی ، نبی ﷽ اس کے پاس پہنچے تو وہ کہنے لگا کہ آپ مجھ سے دور ہی رہیں ، آپ کے گدھے کی بدبو سے مجھے تکلیف ہو رہی ہے ، اس پر ایک انصاری نے کہا کہ بخدا ! نبی ﷽ کا گدھا تجھ سے زیادہ خوشبودار ہے ، ادھر عبداللہ بن ابی کی قوم کا ایک آدمی اس کی طرف سے غضب ناک ہو گیا ، پھر دونوں کے ساتھیوں میں غم و غصہ کی لہر دوڑ گئی ، اور شاخوں ، ہاتھوں اور جوتوں سے لڑائی کی نوبت آ گئی ، ہمیں معلوم ہوا ہے کہ یہ آیت انہی کے بارے میں نازل ہوئی کہ """" اگر مسلمانوں کے دو گروہ آپس میں لڑ پڑیں تو آپ ان کے درمیان صلح کرا دیں ۔"""""
"12635","حضرت انس بن مالک رضی اللہ عنہ سے روایت ہے کہ ہم نے مکہ فتح کر لیا پھر ہم نے حنین کا جہاد کیا ، مشرکین اچھی صف بندی کر کے آئے جو میں نے دیکھیں ۔ پہلے گھڑسواروں نے صف باندھی پھر پیدل لڑنے والوں نے اس کے پیچھے عورتوں نے صف بندی کی پھر بکریوں کی صف باندھی گئی ۔ پھر اونٹوں کی صف بندی کی گئی اور ہم بہت لوگ تھے اور ہماری تعداد چھ ہزار کو پہنچ چکی تھی اور ایک جانب کے سواروں پر حضرت خالد بن ولید رضی اللہ عنہ سالار تھے ۔ ہمارے سوار ہماری پشتوں کے پیچھے پناہ گزیں ہونا شروع ہوئے اور زیادہ دیر نہ گزری تھی کہ ہمارے گھوڑے ننگے ہوئے اور دیہاتی بھاگے اور وہ لوگ جن کو ہم جانتے ہیں ۔ تو رسول اللہ ﷽ نے پکارا اے مہاجرین ! اے مہاجرین ! پھر فرمایا اے انصار ، اے انصار ۔ ہم نے کہا لبیک اے اللہ کے رسول پھر آپ ﷽ آگے بڑھے پس اللہ کی قسم ہم پہنچنے بھی نہ پائے تھے کہ اللہ نے ان کو شکست دے دی ۔ پھر ہم نے وہ مال قبضہ میں لے لیا پھر ہم طائف کی طرف چلے تو ہم نے اس کا چالیس روز محاصرہ کیا پھر ہم مکہ کی طرف لوٹے اور اترے اور رسول اللہ ﷽ نے ایک ایک کو سو سو اونٹ دینے شروع کر دیئے ۔ یہ دیکھ کر انصار آپس میں باتیں کرنے لگے کہ نبی ﷽ انہی لوگوں کو عطاء فرما رہے ہیں جنہوں نے آپ سے قتال کیا تھا اور جنہوں نے آپ ﷽ سے قتال نہیں کیا ، انہیں کچھ نہیں دے رہے ، نبی ﷽ کو یہ بات پہنچی تو آپ ﷽ نے ان کو ایک خیمہ میں جمع کر کے فرمایا ، اے انصار کی جماعت مجھے تم سے کیا بات پہنچی ہے ، وہ کہنے لگے یا رسول اللہ ! آپ کو کیا بات معلوم ہوئی ہے آ دو مرتبہ یہی بات ہوئی ، پھر نبی ﷽ نے فرمایا اے جماعت انصار کیا تم خوش نہیں ہو کہ لوگ تو دنیا لے جائیں اور تم محمد ﷽ کو گھیرے ہوئے اپنے گھروں کو جاا ، انہوں نے عرض کیا اے اللہ کے رسول ہم خوش ہیں نبی ﷽ نے فرمایا اگر لوگ ایک وادی میں چلیں اور انصار ایک گھاٹی میں چلیں تو میں انصار کی گھاٹی کو اختیار کروں گا وہ کہنے لگے یا رسول اللہ ! ہم راضی ہیں ، نبی ﷽ نے فرمایا خوش رہو ۔"
"12636","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ گالیاں دینے والے ، لعنت ملامت کرنے والے یا بے ہودہ باتیں کرنے والے نہ تھے ، عتاب کے وقت بھی صرف اتنا فرماتے تھے کہ اسے کیا ہو گیا ، اس کی پیشانی خاک آلود ہو ۔"
"12637","حضرت انس رضی اللہ عنہ فرماتے تھے کہ ہم نے نبی ﷽ کے ساتھ نماز اس طرح پڑھی ہے کہ اگر آج تم میں سے کوئی شخص اس طرح پڑھنے لگے تو تم اسے مطعون کرو گے ، یہ سن کر شریک اور مسلم بن ابی نمر ان سے کہنے لگے کہ آپ یہ بات ہمارے گورنر کو کیوں نہیں بتاتے آ اس وقت حضرت عمر بن عبدالعزیز رحمۃ اللہ مدینہ کے گورنر تھے ، انہوں نے فرمایا کہ میں یہ بھی کر چکا ہوں ۔"
"12638","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نبی ﷽ کے ساتھ حلقے میں بیٹھا ہوا تھا اور ایک آدمی کھڑا نماز پڑھ رہا تھا ، رکوع و سجود کے بعد جب وہ بیٹھا تو تشہد میں اس نے یہ دعاء پڑھی """" اے اللہ ! میں تجھ سے سوال کرتا ہوں کیونکہ تمام تعریفیں تیرے لیے ہی ہیں ، تیرے علاوہ کوئی معبود نہیں ، نہایت احسان کرنے والا ہے ، آسمان و زمین کو بغیر نمونے کے پیدا کرنے والا ہے اور بڑے جلال اور عزت والا ہے ، اے زندگی دینے والے اے قائم رکھنے والے ! میں تجھ ہی سے سوال کرتا ہوں ۔"""" نبی ﷽ نے فرمایا تم جانتے ہو کہ اس نے کیا دعاء کی ہے آ صحابہ رضی اللہ عنہم نے عرض کیا اللہ اور اس کے رسول ﷽ ہی زیادہ جانتے ہیں ، نبی ﷽ نے فرمایا اس ذات کی قسم جس کے دست قدرت میں میری جان ہے اس نے اللہ سے اس کے اس اسم اعظم کے ذریعے دعاء مانگی ہے کہ جب اس کے ذریعے سے دعاء مانگی جائے تو اللہ اسے ضرور قبول کرتا ہے اور جب اس کے ذریعے سوال کیا جائے تو وہ ضرور عطاء کرتا ہے ۔"
"12639","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نبی ﷽ کے ساتھ حلقے میں بیٹھا ہوا تھا کہ ایک آدمی نے آ کر نبی ﷽ کو اور دوسرے لوگوں کو سلام کیا ، سب نے اسے جواب دیا ، جب وہ بیٹھ گیا تو کہنے لگا ®الحمدللہ حمدا کثیرا طیبا مبارکا فیہ کما یحب ربنا ان یحمد وینبغی لہ¾ نبی ﷽ نے اس سے پوچھا کہ تم نے کیا کہا آ اس نے ان کلمات کو دہرا دیا ، نبی ﷽ نے فرمایا اس ذات کی قسم جس کے دست قدرت میں میری جان ہے ، میں نے دس فرشتوں کو اس کی طرف تیزی سے بڑھتے ہوئے دیکھا کہ کون اس جملے کو پہلے لکھتا ہے ، لیکن انہیں سمجھ نہیں آئی کہ ان کلمات کا ثواب کتنا لکھیں آ چنانچہ انہوں نے اللہ سے پوچھا تو اللہ نے فرمایا کہ انہیں اسی طرح لکھ لو جیسے میرے بندے نے کہا ہے ۔"
"12640","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نکاح کرنے کا حکم دیتے اور اس سے اعراض کرنے کی شدید ممانعت فرماتے اور ارشاد فرماتے کہ محبت کرنے والی اور بچوں کی ماں بننے والی عورت سے شادی کیا کرو کہ میں قیامت کے دن دیگر انبیاء + علیہم السلام , پر تمہاری کثرت سے فخر کروں گا ۔"
"12641","حضرت انس رضی اللہ عنہ سے مروی ہے کہ انصار کا ایک گھرانا تھا جس کے پاس پانی لادنے والا ایک اونٹ تھا ، ایک دن وہ اونٹ سخت بدک گیا اور کسی کو اپنے اوپر سوار نہیں ہونے دیا ، وہ لوگ نبی ﷽ کے پاس آ کر کہنے لگے کہ ہمارا ایک اونٹ تھا جس پر ہم پانی بھر کر لایا کرتے تھے ، آج وہ اس قدر بدکا ہوا ہے کہ ہمیں اپنے اوپر سوار ہی نہیں ہونے دیتا ۔ اور کھیت اور باغات خشک پڑے ہوئے ہیں ۔ نبی ﷽ نے صحابہ رضی اللہ عنہم سے فرمایا اٹھو ، اور چل پڑے ، وہاں پہنچ کر باغ میں داخل ہوئے تو دیکھا کہ وہ اونٹ ایک کونے میں ہے ، نبی ﷽ اس کی طرف چل پڑے ، یہ دیکھ کر انصار کہنے لگے یا رسول اللہ ﷽ ! یہ تو وحشی کتے کی طرح ہو چکا ہے ، ہمیں خطرہ ہے کہ کہیں یہ آپ پر حملہ ہی نہ کر دے ، نبی ﷽ نے فرمایا مجھے اس سے کوئی نقصان نہیں پہنچے گا ۔ جب اونٹ نے نبی ﷽ کو دیکھا تو وہ نبی ﷽ کے پاس آ کر آپ ﷽ کے سامنے گر پڑا ، نبی ﷽ نے اسے اس کی پیشانی سے پکڑا اور وہ پہلے سے بھی زیادہ فرمانبردار ہو گیا اور نبی ﷽ نے اسے کام پر لگا دیا ، یہ دیکھ کر صحابہ کرام رضی اللہ عنہم کہنے لگے یا رسول اللہ ﷽ ! یہ ناسمجھ جاندار آپ کو سجدہ کر سکتے ہیں تو ہم تو پھر عقلمند ہیں ، ہم آپ کو سجدہ کرنے کا زیادہ حق رکھتے ہیں آ نبی ﷽ نے فرمایا کسی انسان کے لئے دوسرے انسان کو سجدہ کرنا جائز نہیں ہے ، اگر ایسا کرنا جائز ہوتا تو میں عورت کو حکم دیتا کہ اپنے شوہر کو سجدہ کرے کہ اس کا حق اس پر زیادہ ہے ، اس ذات کی قسم جس کے دست قدرت میں میری جان ہے ، اگر مرد کے پااں سے لے کر سر کی مانگ تک سارا جسم پھوڑا بن جائے اور خون پیپ بہنے لگے اور بیوی آ کر اسے چاٹنے لگے تب بھی اس کا حق ادا نہیں کر سکتی ۔"
"12642","حضرت انس رضی اللہ عنہ فرماتے ہیں کہ ایک مرتبہ ہمیں چالیس انصاری حضرات کے ساتھ شام میں عبدالملک کے پاس لے جایا گیا ، تاکہ وہ ہمارا وظیفہ مقرر کر دے ، واپسی پر جب ہم """" فج الناقہ """" میں پہنچے تو اس نے ہمیں عصر کی دو رکعتیں پڑھائیں ، پھر سلام پھیر کر اپنے خیمے میں چلا گیا ، لوگ کھڑے ہو کر مزید دو رکعتیں پڑھنے لگے ، حضرت انس رضی اللہ عنہ نے یہ دیکھ کر فرمایا اللہ ان چہروں کو بدنما کرے ، بخدا ! انہوں نے سنت پر عمل کیا اور نہ رخصت قبول کی ، میں گواہی دیتا ہوں کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کچھ لوگ دین میں خوب تعمق کریں گے اور دین سے اس طرح نکل جائیں گے جیسے تیر شکار سے نکل جاتا ہے ۔"
"12643","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت ابوطلحہ رضی اللہ عنہ سے فرمایا اپنے بچوں میں سے کوئی بچہ ہمارے لیے منتخب کرو جو میری خدمت کیا کرے ، حضرت ابوطلحہ رضی اللہ عنہ مجھے اپنے پیچھے بٹھا کر روانہ ہوئے ، اور میں نبی ﷽ کا خادم بن گیا ، خواہ نبی ﷽ کہیں بھی منزل کرتے ، میں آپ ﷽ کو کثرت سے یہ کہتے ہوئے سنتا تھا کہ اے اللہ ! میری پریشانی ، غم ، لاچاری ، سستی ، بخل ، بزدلی ، قرضوں کے بوجھ اور لوگوں کے غلبے سے آپ کی پناہ میں آتا ہوں ۔ میں مستقل نبی ﷽ کا خادم رہا ، ایک موقع پر جب ہم خیبر سے واپس آ رہے تھے ، نبی ﷽ کے ساتھ اس وقت حضرت صفیہ رضی اللہ عنہا بھی تھیں جنہیں نبی ﷽ نے منتخب فرمایا تھا ، تو میں نے دیکھا کہ نبی ﷽ اپنے پیچھے کسی چادر یا عباء سے پردہ کرتے پھر انہیں اپنے پیچھے بٹھا لیتے ، جب ہم مقام صہباء میں پہنچے تو نبی ﷽ نے حلوہ بنایا اور دسترخوان پر چن دیا ، پھر مجھے بھیجا اور میں بہت سے لوگوں کو بلا لایا ، ان سب نے وہ حلوہ کھایا ، جو دراصل نبی ﷽ کا ولیمہ تھا ، پھر نبی ﷽ روانہ ہوئے اور جب احد پہاڑ نظر آیا تو فرمایا کہ یہ پہاڑ ہم سے محبت کرتا ہے اور ہم اس سے محبت کرتے ہیں ، پھر جب مدینہ کے قریب پہنچے تو فرمایا اے اللہ ! میں اس کے دونوں پہاڑوں کے درمیانی جگہ کو حرام قرار دیتا ہوں جیسے حضرت ابراہیم علیہ السلام نے مکہ کو حرم قرار دیا تھا ، اے اللہ ! ان کے صاع اور مد میں برکت عطاء فرما ۔"
"12644","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی وہ آخری نماز جو آپ ﷽ نے لوگوں کے ساتھ پڑھی ، وہ ایک کپڑے میں لپٹ کر حضرت ابوبکر صدیق رضی اللہ عنہ کے پیچھے پڑھی تھی ۔"
"12645","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب کسی قوم پر حملے کا ارادہ کرتے تو رات کو حملہ نہ کرتے بلکہ صبح ہونے کا انتظار کرتے ، اگر وہاں سے اذان کی آواز سنائی دیتی تو رک جاتے ، ورنہ حملہ کر دیتے ۔"
"12646","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب کسی سفر سے واپس آتے ، اور مدینہ کی دیواروں پر نظر پڑتی تو سواری سے کود پڑتے ، اور اگر سواری پر رہتے تو اس کی رفتار مدینہ کی محبت میں تیز کر دیتے تھے ۔"
"12647","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب آندھی چلتی تو نبی ﷽ کے چہرہ انور پر خوف کے آثار واضح طور پر محسوس کیے جا سکتے تھے ۔"
"12648","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب آندھی چلتی تو نبی ﷽ کے چہرہ انور پر خوف کے آثار واضح طور پر محسوس کیے جا سکتے تھے ۔"
"12649","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو چاشت کی نماز پڑھتے ہوئے نہیں دیکھا الاِ یہ کہ آپ ﷽ سفر پر جا رہے ہوں یا سفر سے واپس آ رہے ہوں ۔"
"12650","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب کسی سفر سے واپس آتے ، اور مدینہ کی دیواروں پر نظر پڑتی تو سواری سے کود پڑتے ، اور اگر سواری پر رہتے تو اس کی رفتار مدینہ کی محبت میں تیز کر دیتے تھے ۔"
"12651","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب تسلسل کے ساتھ روزہ رکھتے تو لوگ کہتے کہ نبی ﷽ روزہ رکھتے رہیں گے اور جب افطاری کرتے تب بھی لوگ کہتے کہ نبی ﷽ ناغہ کرتے رہیں گے ۔"
"12652","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے بارگاہ رسالت میں عرض کیا یا رسول اللہ ﷽ ! ایک آدمی کسی قوم سے محبت کرتا ہے لیکن ان کے اعمال تک نہیں پہنچتا ، تو کیا حکم ہے آ نبی ﷽ نے فرمایا انسان اسی کے ساتھ ہو گا جس کے ساتھ وہ محبت کرتا ہے ۔"
"12653","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے ہمیں نفلی نماز پڑھائی ، حضرت ام سلیم رضی اللہ عنہا اور ام حرام رضی اللہ عنہا نے ہمارے پیچھے ہیچھے ہو کر نماز پڑھی اور نبی ﷽ نے مجھے اپنی دائیں جانب کھڑا کر لیا ، یوں ہم نے ایک ہی چادر میں نماز پڑھ لی ۔"
"12654","ابولبید رحمۃ اللہ نے مازہ بن زیار رحمۃ اللہ سے بیان کیا کہ میں نے حجاج بن یوسف کے زمانے میں اپنے گھوڑے کو بھیجا اور سوچا کہ ہم بھی گھڑ دوڑ کی شرط میں حصہ لیتے ہیں ، پھر ہم نے سوچا کہ پہلے حضرت انس رضی اللہ عنہ سے جا کر پوچھ لیتے ہیں کہ کیا آپ لوگ بھی نبی ﷽ کے زمانے میں گھڑ دوڑ پر شرط لگایا کرتے تھے آ چنانچہ ہم نے ان کے پاس آ کر ان سے پوچھا تو انہوں نے جواب دیا ہاں ! ایک مرتبہ انہوں نے اپنے ایک گھوڑے پر """" جس کا نام سبحہ تھا """" گھڑ دوڑ میں حصہ لیا تھا اور وہ سب سے آگے نکل گیا تھا ، جس سے انہیں تعجب ہوا تھا ۔"
"12655","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک آدمی پر پیلا رنگ لگا ہوا دیکھا تو اس پر ناگواری ظاہر فرمائی اور فرمایا کہ اگر تم اس شخص کو یہ رنگ دھو دینے کا حکم دیتے تو کیا ہی اچھا ہوتا آ اور نبی ﷽ کی یہ عادت مبارکہ تھی کہ کسی کے سامنے اس طرح کا چہرہ لے کر نہ آتے تھے جس سے ناگواری کا اظہار ہوتا ہو ۔"
"12656","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ + جب غزوہ تبوک سے واپسی پر مدینہ منورہ کے قریب پہنچے تو , فرمایا کہ مدینہ منورہ میں کچھ لوگ ایسے بھی ہیں کہ تم جس راستے پر بھی چلے اور جس وادی کو بھی طے کیا ، وہ اس میں تمہارے ساتھ رہے ، صحابہ رضی اللہ عنہم نے عرض کیا یا رسول اللہ ﷽ ! کیا وہ مدینہ میں ہونے کے باوجود ہمارے ساتھ تھے آ فرمایا ہاں ! مدینہ میں ہونے کے باوجود ، کیونکہ انہیں کسی عذر نے روک رکھا ہے ۔"
"12657","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں ایک پیالے میں کدو لے کر نبی ﷽ کی خدمت میں حاضر ہوا ، نبی ﷽ کو کدو بہت پسند تھا ، اس لئے اسے اپنی انگلیوں سے تلاش کرنے لگے ۔"
"12658","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک دن انہوں نے نبی ﷽ کے ہاتھ میں چاندی کی ایک انگوٹھی دیکھی ، نبی ﷽ کو دیکھ کر لوگوں نے بھی چاندی کی انگوٹھیاں بنوا لیں ، اس پر نبی ﷽ نے اپنی انگوٹھی اتار کر پھینک دی ، اور لوگوں نے بھی اپنی اپنی انگوٹھیاں اتار پھینکیں ۔"
"12659","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کبھی کبھار اپنی تمام ازواج مطہرات کے پاس ایک ہی رات میں ایک ہی غسل سے چلے جایا کرتے تھے ۔"
"12660","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز عشاء کا وقت ہو گیا ، ایک آدمی آیا اور کہنے لگا یا رسول اللہ ! مجھے آپ سے ایک کام ہے ، نبی ﷽ اس کے ساتھ مسجد میں تنہائی میں گفتگو کرنے لگے یہاں تک کہ لوگ اونگھنے لگے ، پھر نبی ﷽ نے نماز پڑھائی اور راوی نے وضو کا ذکر نہیں کیا ۔"
"12661","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ سردی کے ایام میں نماز پڑھاتے تھے تو ہمیں کچھ پتہ نہ چلتا تھا کہ دن کا اکثر حصہ گذر گیا ہے یا باقی ہے ۔"
"12662","حضرت انس رضی اللہ عنہ سے نبی ﷽ کے خضاب کے متعلق پوچھا گیا تو انہوں نے فرمایا کہ نبی ﷽ کی مبارک ڈاڑھی میں تھوڑے سے بال ہی سفید تھے ، البتہ حضرت ابوبکر صدیق رضی اللہ عنہ اور حضرت عمر رضی اللہ عنہ مہندی اور وسمہ کا خضاب لگاتے تھے ۔"
"12663","حضرت انس رضی اللہ عنہ فرماتے ہیں کہ حضرت ابوبکر صدیق رضی اللہ عنہ فتح مکہ کے دن اپنے والد ابوقحافہ رضی اللہ عنہ کو اپنی پیٹھ پر بٹھا کر نبی ﷽ کی خدمت میں لے کر آئے ، اور نبی ﷽ کے پاس پہنچ کر انہیں اتار دیا ، نبی ﷽ نے حضرت ابوبکر صدیق رضی اللہ عنہ کے اعزاز کا خیال رکھتے ہوئے فرمایا کہ اگر بزرگوں کو گھر میں ہی رہنے دیتے تو ہم خود ان کے پاس چلے جاتے ، الغرض ! ابوقحافہ رضی اللہ عنہ نے اسلام قبول کر لیا ، اس وقت ان کے سر اور ڈاڑھی کے بال """" ثغامہ """" نامی بوٹی کی طرح سفید ہو چکے تھے ، نبی ﷽ نے فرمایا ان کا رنگ بدل دو ، لیکن کالا رنگ کرنے سے پرہیز کرنا ۔"
"12664","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ حضرت زید بن ارقم رضی اللہ عنہ کی عیادت کے لئے گئے ، ان کی آنکھوں کی بصارت ختم ہو گئی تھی ، نبی ﷽ نے ان سے فرمایا زید ! یہ بتاا اگر تمہاری آنکھیں وہاں چلی جائیں جہاں کے لیے ہیں تو تم کیا کرو گے آ انہوں نے عرض کیا کہ میں صبر کروں گا اور ثواب کی امید رکھوں گا ، نبی ﷽ نے فرمایا اگر تمہاری بینائی ختم ہو گئی اور تم نے اس پر صبر کیا اور ثواب کی امید رکھی ، تو تم اللہ سے اس طرح ملو گے کہ تم پر کوئی گناہ نہیں ہو گا ۔"
"12665","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے میری کنیت اس سبزی کے نام پر رکھی تھی جو میں چنتا تھا ۔"
"12666","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے خوشہ بننے سے پہلے کھجور اور چھلنے سے پہلے دانے اور پھل پکنے سے پہلے ان کی بیع سے منع فرمایا ہے ۔"
"12667","حضرت انس رضی اللہ عنہ سے مروی ہے کہ قبیلہ عرینہ کے کچھ لوگ نبی ﷽ کے پاس آئے لیکن انہیں مدینہ منورہ کی آب و ہوا موافق نہ آئی ، نبی ﷽ نے ان سے فرمایا کہ اگر تم ہمارے اونٹوں کے پاس جا کر ان کا دودھ اور پیشاب پیو تو شاید تندرست ہو جاا ۔"
"12668","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کبھی کبھار اپنی تمام ازواج مطہرات کے پاس ایک ہی رات میں ایک ہی غسل سے چلے جایا کرتے تھے ۔"
"12669","حضرت انس رضی اللہ عنہ سے مروی ہے کہ شب معراج نبی ﷽ پر پچاس نمازیں فرض ہوئی تھیں ، کم ہوتے ہوتے پانچ رہ گئیں ، اور پھر نداء لگائی گئی کہ اے محمد ! ﷽ ، ہمارے یہاں بات بدلتی نہیں ، آپ کو ان پانچ پر پچاس ہی کا ثواب ملے گا ۔"
"12670","حضرت انس رضی اللہ عنہ سے مروی ہے کہ بعض اوقات نماز کا وقت ہو جاتا تو ایک آدمی آ کر اپنی کسی ضرورت کے حوالے سے نبی ﷽ کے ساتھ باتیں کرنے لگتا اور ان کے اور قبلہ کے درمیان کھڑا ہو جاتا ، اور وہ مسلسل باتیں کرتا رہتا یہاں تک کہ اس کی خاطر نبی ﷽ کے زیادہ دیر کھڑے رہنے کی صورت میں بعض لوگ اونگھنے بھی لگ جاتے تھے ۔"
"12671","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ ظہر کی نماز زوال شمس کے وقت پڑھتے تھے ۔"
"12672","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ عصر کی نماز اس وقت پڑھتے تھے کہ نماز کے بعد کوئی جانے والا عوالی جانا چاہتا تو سورج بلند ہوتا تھا ۔"
"12673","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب رات کا کھانا سامنے آ جائے اور نماز کھڑی ہو جائے تو پہلے کھانا کھا لو پھر نماز پڑھو ۔"
"12674","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نبی ﷽ نے فرمایا صفوں کی درستگی کا خیال رکھا کرو ، کیونکہ میں تمہیں اپنے پیچھے سے بھی دیکھتا ہوں ۔"
"12675","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے اپنے لیے ایک انگوٹھی بنوائی اور اس پر محمد رسول اللہ نقش کروایا اور فرمایا کوئی شخص اپنی انگوٹھی پر یہ عبارت نقش نہ کروائے ۔"
"12676","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک دیہاتی آدمی """" جس کا نام زاہر تھا """" دیہات سے آتے ہوئے نبی ﷽ کے لئے کوئی نہ کوئی ہدیہ لے کر آتا تھا ، اور جب واپس جانے لگتا تو نبی ﷽ اسے بہت کچھ دے کر رخصت فرماتے تھے ، اور ارشاد فرماتے تھے کہ زاہر ہمارا دیہات ہے اور ہم اس کا شہر ہیں ، نبی ﷽ اس سے محبت فرماتے تھے گو کہ رنگت کے اعتبار سے وہ قبول صورت نہ تھا ۔ ایک دن زاہر اپنے سامان کے پاس کھڑے اسے بیچ رہے تھے کہ نبی ﷽ پیچھے سے آئے اور انہیں لپٹ کر ان کی آنکھوں پر ہاتھ رکھ دیئے ، وہ کہنے لگے کہ کون ہے ، مجھے چھوڑو ، انہوں نے ذرا غور کیا تو نبی ﷽ کو پہچان گئے اور اپنی پشت نبی ﷽ کے سینے کے اور قریب کرنے لگے ، نبی ﷽ آواز لگانے لگے کہ اس غلام کو کون خریدے گا آ انہوں نے عرض کیا یا رسول اللہ ﷽ ! آپ مجھے کھوٹا سکہ پائیں گے ، نبی ﷽ نے فرمایا لیکن تم اللہ کے نزدیک کھوٹا سکہ نہیں ہو ، بلکہ تمہاری بڑی قیمت ہے ۔"
"12677","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی مدینہ منورہ تشریف آوری کی خوشی میں حبشیوں نے نیزے کے کرتب دکھائے ۔"
"12678","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا انصار میرا پردہ ہیں جن کے پاس میں نے آ کر ٹھکانہ حاصل کر لیا ، اس لئے تم انصار کے نیکوں کی نیکی قبول کرو ، اور ان کے گناہگار سے تجاوز اور درگذر کرو ، کیونکہ انہوں نے اپنا فرض نبھا دیا اور ان کا حق باقی رہ گیا ۔"
"12679","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے فرمایا اے اللہ ! انصار کی ، انصار کے بچوں کی اور انصار کے بچوں کے بچوں کی مغفرت فرما ۔"
"12680","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"12681","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ جب امام ®سَمْعَ اللَِيْ لْمَنُ حَمْدَيْ¾ کہے تو تم ®رَبَِنَا وَلَنَ الُحَمُدْ¾ کہو ۔"
"12682","حضرت انس رضی اللہ عنہ سے مروی ہے کہ بعض اوقات نبی ﷽ سجدہ یا رکوع سے سر اٹھاتے اور ان دونوں کے درمیان اتنا لمبا وقفہ فرماتے کہ ہمیں یہ خیال ہونے لگتا کہ کہیں نبی ﷽ بھول تو نہیں گئے ۔"
"12683","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کے بعد ان جیسی خفیف اور مکمل رکوع سجدے والی نماز کسی کے پیچھے نہیں پڑھی ۔"
"12684","حضرت انس رضی اللہ عنہ سے مروی ہے کہ آپ ﷽ نے ایک مہینے تک فجر کی نماز میں قنوت نازلہ پڑھی اور رعل ، ذکوان ، عصیہ اور بنو لحیان کے قبائل پر بددعاء کرتے رہے ۔"
"12685","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ گھوڑے سے گر پڑے جس سے دائیں حصے پر زخم آ گیا ، ہم لوگ عیادت کے لئے نبی ﷽ کے پاس آئے ، اس دوران نماز کا وقت آ گیا ، نبی ﷽ نے بیٹھ کر نماز پڑھائی اور ہم نے بھی بیٹھ کر نماز پڑھی ، نماز سے فارغ ہو کر نبی ﷽ نے فرمایا امام تو ہوتا ہی اس لئے ہے کہ اس کی اقتداء کی جائے ، اس لئے جب وہ تکبیر کہے تو تم بھی تکبیر کہو ، جب وہ رکوع کرے تو تم بھی رکوع کرو ، جب وہ سجدہ کرے تو تم بھی سجدہ کرو ، جب وہ ®سمع اللہ لم حمدہ¾ کہے تو تم ®ربنا ولک الحمد¾ کہو ، اور جب وہ بیٹھ کر نماز پڑھے تو تم سب بھی بیٹھ کر نماز پڑھو ۔"
"12686","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دنیا سے رخصت ہونے تک ہمیشہ نماز فجر میں ہی قنوت نازلہ پڑھا کرتے تھے ۔"
"12687","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اسلام میں وٹے سٹے کے نکاح کی """" جس میں کوئی مہر مقرر نہ کیا گیا ہو """" کوئی حیثیت نہیں ہے ، اسلام میں فرضی محبوبااں کے نام لے کر اشعار میں تشبیہات دینے کی کوئی حیثیت نہیں ، اسلام میں کسی قبیلے کا حلیف بننے کی کوئی حیثیت نہیں ، زکوٰۃ وصول کرنے والے کا اچھا مال چھانٹ لینا یا لوگوں کا زکوٰۃ سے بچنے کے حیلے اختیار کرنا بھی صحیح نہیں ہے ۔"
"12688","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ جناب رسول اللہ ﷽ زوال کے بعد باہر آئے ، ظہر کی نماز پڑھائی اور سلام پھیر کر منبر پر کھڑے ہو گئے اور قیامت کا ذکر فرمایا ، نیز یہ کہ اس سے پہلے بڑے اہم امور پیش آئیں گے ، پھر فرمایا کہ جو شخص کوئی سوال پوچھنا چاہتا ہے وہ پوچھ لے ، بخدا تم مجھ سے جس چیز کے متعلق بھی """" جب تک میں یہاں کھڑا ہوں """" سوال کرو گے ، میں تمہیں ضرور جواب دوں گا ، یہ سن کر لوگ کثرت سے آہ و بکاء کرنے لگے ، اور نبی ﷽ بار بار یہی فرماتے رہے کہ مجھ سے پوچھو ، چنانچہ ایک آدمی نے کھڑے ہو کر پوچھا یا رسول اللہ ! میں کہاں داخل ہوں گا آ فرمایا جہنم میں ، عبداللہ بن حذافہ رضی اللہ عنہ نے پوچھ لیا یا رسول اللہ ﷽ ! میرا باپ کون ہے آ نبی ﷽ نے فرمایا تمہارا باپ حذافہ ہے ۔ اس پر حضرت عمر رضی اللہ عنہ گھٹنوں کے بل جھک کر کہنے لگے کہ ہم اللہ کو اپنا رب مان کر ، اسلام کو اپنا دین قرار دے کر اور محمد ﷽ کو اپنا نبی مان کر خوش اور مطمئن ہیں ، حضرت عمر رضی اللہ عنہ کی یہ بات سن کر نبی ﷽ خاموش ہو گئے ، تھوڑی دیر بعد فرمایا اس ذات کی قسم جس کے دست قدرت میں میری جان ہے اس دیوار کی چوڑائی میں ابھی میرے سامنے جنت اور جہنم کو پیش کیا گیا تھا ، جب کہ میں نماز پڑھ رہا تھا ، میں نے خیر اور شر میں آج کے دن جیسا کوئی دن نہیں دیکھا ۔"
"12689","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا قیامت اس وقت تک قائم نہیں ہو گی جب تک زمین میں اللہ اللہ کہنے والا کوئی شخص باقی ہے ۔"
"12690","حضرت انس رضی اللہ عنہ ، حضرت عمر بن عبدالعزیز رضی اللہ عنہ کے متعلق """" جب کہ وہ مدینہ منورہ میں تھے """" فرماتے تھے کہ میں نے اس نوجوان سے زیادہ نبی ﷽ کے ساتھ مشابہت رکھنے والی نماز پڑھتے ہوئے کسی کو نہیں دیکھا ، راوی کہتے ہیں کہ ہم نے اندازہ لگایا تو وہ رکوع و سجود میں دس دس مرتبہ تسبیح پڑھتے تھے ۔"
"12691","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا کچھ لوگ اپنے گناہوں کی وجہ سے جہنم میں داخل کیے جائیں گے ، جب وہ جل کر کوئلہ ہو جائیں گے تو انہیں جنت میں داخل کر دیا جائے گا ، + اہل جنت پوچھیں گے کہ یہ کون لوگ ہیں آ انہیں , بتایا جائے گا کہ یہ جہنمی ہیں ۔"
"12692","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ رات کے وقت اہل مدینہ دشمن کے خوف سے گھبرا اٹھے ، نبی ﷽ ایک بے زین گھوڑے پر سوار ہو کر آواز کے رخ پر چل پڑے اور واپس آ کر گھوڑے کے متعلق فرمایا کہ ہم نے اسے سمندر جیسا رواں پایا ۔"
"12693","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا تم میں سے کوئی شخص اپنے اوپر آنے والی کسی تکلیف کی وجہ سے موت کی تمنا نہ کرے ۔"
"12694","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا لوگوں کی امامت وہ شخص کروائے جو ان میں سب سے زیادہ قرآن پڑھنے والا ہو ۔"
"12695","حضرت انس رضی اللہ عنہ سے مروی ہے کہ وہ آخری نظر جو میں نے نبی ﷽ پر پیر کے دن ڈالی ، وہ اس طرح تھی کہ نبی ﷽ نے اپنے حجرہ مبارکہ کا پردہ ہٹایا ، لوگ اس وقت حضرت ابوبکر صدیق رضی اللہ عنہ کی امامت میں نماز ادا کر رہے تھے ، میں نے نبی ﷽ کے چہرہ مبارک کو دیکھا تو وہ قرآن کا ایک کھلا ہوا صفحہ محسوس ہو رہا تھا ، حضرت ابوبکر صدیق رضی اللہ عنہ نے صف میں شامل ہونے کے لئے پیچھے ہٹنا چاہا اور وہ یہ سمجھے کہ نبی ﷽ لوگوں کو نماز پڑھانے کے لئے آنا چاہتے ہیں ، لیکن نبی ﷽ نے انہیں صفوں میں کھڑا ہوا دیکھ کر تبسم فرمایا اور انہیں اشارے سے اپنی جگہ رہنے اور نماز مکمل کرنے کا حکم دیا ، اور پردہ لٹکا لیا اور اسی دن آپ ﷽ دنیا سے رخصت ہو گئے ۔"
"12696","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک یہودی نے ایک انصاری بچی کو اس زیور کی خاطر قتل کر دیا جو اس نے پہن رکھا تھا ، قتل کر کے اس نے اس بچی کو ایک کنویں میں ڈالا اور پتھر مار مار کر اس کا سر کچل دیا ، اس یہودی کو پکڑ کر نبی ﷽ کے سامنے لایا گیا ، نبی ﷽ نے حکم دیا کہ اسے اتنے پتھر مارے جائیں کہ یہ مر جائے ، چنانچہ ایسا ہی کیا گیا اور وہ مر گیا ۔"
"12697","حضرت انس رضی اللہ عنہ سے مروی ہے کہ قبیلہ عکل اور عرینہ کے کچھ لوگ مسلمان ہو گئے ، لیکن انہیں مدینہ منورہ کی آب و ہوا موافق نہ آئی ، چنانچہ انہوں نے نبی ﷽ سے مدینہ منورہ کے نجار کی شکایت کی ، نبی ﷽ نے ان سے فرمایا کہ اگر تم ہمارے اونٹوں کے پاس جا کر ان کا دودھ اور پیشاب پیو تو شاید تندرست ہو جاا ، چنانچہ انہوں نے ایسا ہی کیا ، لیکن جب وہ صحیح ہو گئے تو دوبارہ مرتد ہو کر کفر کی طرف لوٹ گئے ، نبی ﷽ کے مسلمان چرواہے کو قتل کر دیا ، اور نبی ﷽ کے اونٹوں کو بھگا کر لے گئے ، نبی ﷽ کو خبر ملی تو ان کے پیچھے صحابہ رضی اللہ عنہ کو بھیجا ، انہیں پکڑ کر نبی ﷽ کے سامنے پیش کیا گیا ، نبی ﷽ نے ان کے ہاتھ پااں مخالف سمت سے کٹوا دیئے ، ان کی آنکھوں میں سلائیاں پھروا دیں اور انہیں پتھریلے علاقوں میں چھوڑ دیا جس کے پتھر وہ چاٹتے تھے یہاں تک کہ وہ مر گئے ۔"
"12698","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب نبی ﷽ نے حضرت زینب رضی اللہ عنہا سے نکاح فرمایا تو حضرت ام سلیم رضی اللہ عنہا نے پتھر کے ایک برتن میں حلوہ بنا کر نبی ﷽ کے لئے ہدیہ کے طور پر بھیجا ، نبی ﷽ نے مجھ سے فرمایا جاا اور راستے میں جو بھی ملے ، اسے دعوت دے دو ، میں نے ایسا ہی کیا اور لوگ آتے ، کھاتے اور نکلتے گئے ، نبی ﷽ نے کھانے پر اپنا ہاتھ رکھ کر دعاء کی اور اللہ کو جو منظور ہوا ، وہ کہا ، ادھر میں نے ایک آدمی بھی ایسا نہ چھوڑا جو مجھے ملا ہو اور میں نے اسے دعوت نہ دی ہو ، اور سب لوگ کھا پی کر سیراب ہوئے اور چلے گئے ، لیکن کچھ لوگ وہیں پر بیٹھ گئے اور خوب لمبی گفتگو کرنے لگے ، نبی ﷽ کو انہیں کچھ کہتے ہوئے حجاب محسوس ہوا ، اس لئے آپ ﷽ نے انہیں گھر میں بیٹھا ہوا چھوڑا اور خود ہی باہر چلے گئے ، اس پر اللہ نے یہ آیت نازل فرما دی کہ اے اہل ایمان ! پیغمبر ﷽ کے گھر میں اس وقت تک داخل نہ ہو جب تک تمہیں کھانے کی اجازت نہ مل جائے ۔"
"12699","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ غزوہ خیبر کے لئے صبح کے وقت تشریف لے گئے ، لوگ اس وقت کام پر نکلے ہوئے تھے ، نبی ﷽ کو دیکھ کر وہ کہنے لگے کہ محمد اور لشکر آ گئے ، پھر وہ اپنے قلعے کی طرف بھاگنے لگے ، نبی ﷽ نے اپنے ہاتھ بلند کر کے تین مرتبہ اللہ اکبر کہا اور فرمایا خیبر برباد ہو گیا جب ہم کسی قوم کے صحن میں اترتے ہیں تو ڈرائے ہوئے لوگوں کی صبح بڑی بدترین ہوتی ہے ۔"
"12700","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ غزوہ خیبر کے لئے صبح کے وقت تشریف لے گئے ، لوگ اس وقت کام پر نکلے ہوئے تھے ، نبی ﷽ اور ان کے ہمراہ لشکر کو دیکھ کر وہ کہنے لگے کہ محمد اور لشکر آ گئے ، پھر وہ اپنے قلعے کی طرف بھاگنے لگے ، نبی ﷽ نے اپنے ہاتھ بلند کر کے تین مرتبہ اللہ اکبر کہا اور فرمایا خیبر برباد ہو گیا جب ہم کسی قوم کے صحن میں اترتے ہیں تو ڈرائے ہوئے لوگوں کی صبح بڑی بدترین ہوتی ہے ۔"
"12701","حضرت انس رضی اللہ عنہ سے مروی ہے کہ شب معراج نبی ﷽ کی خدمت میں زین اور لگام کسا ہوا براق پیش کیا گیا ، تاکہ آپ ﷽ اس پر سوار ہو جائیں ، لیکن وہ ایک دم بدکنے لگا ، حضرت جبریل علیہ السلام نے اس سے فرمایا یہ کیا کر رہے ہو آ بخدا ! تم پر ان سے زیادہ کوئی معزز شخص کبھی سوار نہیں ہوا ، اس پر وہ شرم سے پانی پانی ہو گیا ۔"
"12702","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا میرے سامنے ساتویں آسمان پر سدرۃ المنتہیٰ کو پیش کیا گیا ، اس کے پھل """" ہجر """" نامی مقام کے مٹکوں کے برابر اور پتے ہاتھی کے کانوں کے برابر تھے ، اس کی جڑ میں سے دو ظاہری اور دو باطنی نہریں جاری تھیں ، میں نے جبریل علیہ السلام سے پوچھا یہ کیا چیزیں ہیں آ انہوں نے بتایا کہ باطنی نہریں جنت میں ہیں اور ظاہری نہریں نیل اور فرات ہیں ۔"
"12703","حضرت انس رضی اللہ عنہ سے مروی ہے کہ صحابہ کرام رضی اللہ عنہم میں سے حضرت امام حسن رضی اللہ عنہ اور حضرت فاطمہ رضی اللہ عنہا سے بڑھ کر نبی ﷽ کے مشابہہ کوئی نہ تھا ۔"
"12704","حضرت انس رضی اللہ عنہ سے سورہ کوثر کی تفسیر میں مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا وہ جنت کی ایک نہر ہے اور فرمایا میری اس پر نظر پڑی تو اس کے دونوں کناروں پر موتیوں کے خیمے لگے ہوئے تھے ، میں نے جبریل علیہ السلام سے پوچھا کہ یہ کیا ہے آ تو انہوں نے بتایا کہ یہ نہر کوثر ہے جو اللہ نے آپ کو عطاء فرمائی ہے ۔"
"12705","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نماز عیدالفطر سے قبل کچھ تر کھجوریں تناول فرماتے تھے ، وہ نہ ملتیں تو چھوہارے ہی کھا لیتے ، اور اگر وہ بھی نہ ملتے تو چند گھونٹ پانی ہی پی لیتے ۔"
"12706","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جنت میں ایک درخت ایسا بھی ہے جس کے سائے میں اگر کوئی سوار سو سال تک چلتا رہے تب بھی اس کا سایہ ختم نہ ہو ۔"
"12707","گذشتہ حدیث حضرت ابوہریرہ رضی اللہ عنہ سے بھی مروی ہے اور حضرت ابوہریرہ رضی اللہ عنہ فرماتے تھے کہ اگر تم چاہو تو یہ آیت پڑھ لو ®وظل ممدود¾ ۔"
"12708","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں حضرت ابوطلحہ رضی اللہ عنہ کے پیچھے سواری پر بیٹھا ہوا تھا ، وہ نبی ﷽ کے ساتھ گفتگو کر رہے تھے ، وہ کہتے ہیں کہ میرے پااں نبی ﷽ کی رکاب سے لگ جاتے تھے اور میں نے نبی ﷽ کو حج و عمرہ کا تلبیہ اکٹھے پڑھتے ہوئے سنا ۔"
"12709","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے یہ منادی کروا دی کہ اللہ اور اس کے رسول تمہیں گدھوں کے گوشت سے منع کرتے ہیں کیونکہ ان کا گوشت ناپاک ہے ۔"
"12710","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ان کی دادی حضرت ملیکہ نے ایک مرتبہ نبی ﷽ کی کھانے پر دعوت کی ، نبی ﷽ نے کھانا تناول فرمانے کے بعد فرمایا اٹھو ، میں تمہارے لیے نماز پڑھ دوں ، حضرت انس رضی اللہ عنہ کہتے ہیں کہ میں اٹھ کر ایک چٹائی لے آیا جو طویل عرصہ استعمال ہونے کی وجہ سے سیاہ ہو چکی تھی ، میں نے اس پر پانی چھڑک دیا ، نبی ﷽ اس پر کھڑے ہو گئے ، میں اور ایک یتیم بچہ نبی ﷽ کے پیچھے کھڑے ہو گئے اور بڑی بی ہمارے پیچھے کھڑی ہو گئیں ، پھر نبی ﷽ نے ہمیں دو رکعتیں پڑھائیں اور واپس تشریف لے گئے ۔"
"12711","حضرت انس رضی اللہ عنہ سے مروی ہے کہ فتح مکہ کے دن نبی ﷽ جب مکہ مکرمہ میں داخل ہوئے تو آپ ﷽ نے خود پہن رکھا تھا ، کسی شخص نے آ کر بتایا کہ ابن خطل خانہ کعبہ کے پردوں کے ساتھ چمٹا ہوا ہے ، نبی ﷽ نے فرمایا پھر بھی اسے قتل کر دو ۔"
"12712","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حالت احرام میں پااں کے اوپر والے حصے پر درد کی وجہ سے سینگی لگوائی ۔"
"12713","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا تمہارے اعمال تمہارے فوت شدہ قریبی رشتہ داروں اور خاندان والوں کے سامنے بھی رکھے جاتے ہیں ، اگر اچھے اعمال ہوں تو وہ خوش ہوتے ہیں ، اگر دوسری صورت ہو تو وہ کہتے ہیں کہ اے اللہ ! انہیں اس وقت تک موت نہ دیجئے گا جب تک انہیں ہدایت نہ دے دیں ۔ جیسے ہمیں عطاء فرمائی ۔"
"12714","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے دباء اور مزفت میں نبیذ پینے سے منع فرمایا ہے ۔"
"12715","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کی ملاقات حضرت عبدالرحمن بن عوف رضی اللہ عنہ سے ہوئی ، تو ان کے اوپر """" خلوق """" نامی خوشبو کے اثرات دکھائی دیئے ، نبی ﷽ نے فرمایا عبدالرحمن ! یہ کیا ہے آ انہوں نے عرض کہا کہ میں نے ایک انصاری خاتون سے شادی کر لی ہے ، نبی ﷽ نے پوچھا کہ مہر کتنا دیا آ انہوں نے عرض کیا کہ میں نے ایک انصاری خاتون سے شادی کر لی ہے ، نبی ﷽ نے پوچھا کہ مہر کتنا دیا آ انہوں نے بتایا کہ کھجور کی گٹھلی کے برابر سونا ، نبی ﷽ نے فرمایا پھر ولیمہ کرو ، اگرچہ ایک بکری سے ہی ہو ۔ حضرت انس رضی اللہ عنہ کہتے ہیں کہ میں نے اپنی آنکھوں سے دیکھا کہ حضرت عبدالرحمن رضی اللہ عنہ کے انتقال کے بعد ان کی ہر بیوی کو وراثت کے حصے میں سے ایک ایک لاکھ دینار ملے ۔"
"12716","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اسلام میں وٹے سٹے کے نکاح کی """" جس میں کوئی مہر مقرر نہ کیا گیا ہو """" کوئی حیثیت نہیں ہے ۔"
"12717","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت صفیہ رضی اللہ عنہا بنت حیی کو آزاد کر دیا اور ان کی آزادی ہی کو ان کا مہر قرار دے دیا ۔"
"12718","حضرت انس رضی اللہ عنہ سے مروی ہے کہ اہل مکہ نے نبی ﷽ سے کوئی معجزہ دکھانے کی فرمائش کی تو نبی ﷽ نے انہیں دو مرتبہ شق قمر کا معجزہ دکھایا اور اس پر یہ آیت نازل ہوئی کہ قیامت قریب آ گئی اور چاند شق ہو گیا ۔"
"12719","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جس چیز میں بے حیائی پائی جاتی ہو ، وہ اسے عیب دار کر دیتی ہے اور جس چیز میں بھی حیاء پائی جاتی ہو ، وہ اسے زینت بخش دیتی ہے ۔"
"12720","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کی ڈاڑھی اور سر میں صرف چودہ بال ہی سفید گنے ہیں ۔"
"12721","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا آپس میں قطع تعلقی ، پشت پھیرنا اور حسد نہ کیا کرو اور اللہ کے بندو ! بھائی بھائی بن کر رہا کرو ، اور کسی مسلمان کے لئے اپنے بھائی سے تین دن سے زیادہ قطع کلامی کرنا حلال نہیں ہے ۔"
"12722","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک دیہاتی آیا اور کہنے لگا یا رسول اللہ ﷽ ! قیامت کب قائم ہو گی آ نبی ﷽ نے فرمایا تم نے قیامت کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کہ میں نے کوئی بہت زیادہ اعمال تو مہیا نہیں کر رکھے ، البتہ اتنی بات ضرور ہے کہ میں اللہ اور اس کے رسول ﷽ سے محبت کرتا ہوں ، نبی ﷽ نے فرمایا کہ انسان قیامت کے دن اس شخص کے ساتھ ہو گا جس کے ساتھ وہ محبت کرتا ہے ۔ حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نبی ﷽ کی مجلس میں بیٹھا ہوا تھا کہ وہاں سے ایک آدمی کا گذر ہوا ، بیٹھے ہوئے لوگوں میں سے کسی نے کہا یا رسول اللہ ﷽ ! میں اس شخص سے محبت کرتا ہوں ، نبی ﷽ نے اس سے فرمایا کیا تم نے اسے یہ بات بتائی بھی ہے آ اس نے کہا نہیں ، نبی ﷽ نے فرمایا پھر جا کر اسے بتا دو ، اس پر وہ آدمی کھڑا ہوا اور جا کر اس سے کہنے لگا کہ بھائی ! میں اللہ کی رضا کے لیے آپ سے محبت کرتا ہوں ، اس نے جواب دیا کہ جس ذات کی خاطر تم مجھ سے محبت کرتے ہو ، وہ تم سے محبت کرے پھر وہ شخص واپس آیا تو نبی ﷽ نے اس سے پوچھا ، اس نے اس کا جواب بتا دیا ، نبی ﷽ نے فرمایا تم اسی کے ساتھ ہو گے جس کے ساتھ تم محبت کرتے ہو اور تمہیں وہی ملے گا جو تم کماتے ہو ۔"
"12723","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے بال نصف کان تک ہوتے تھے ۔"
"12724","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ بعض صحابہ رضی اللہ عنہم نے وضو کے لئے پانی تلاش کیا لیکن وہ انہیں مل نہ سکا ، نبی ﷽ نے ان سے پوچھا کیا یہاں تھوڑا سا پانی ہے آ میں نے دیکھا کہ نبی ﷽ نے اس برتن میں اپنا ہاتھ ڈالا اور فرمایا اللہ کا نام لے کر وضو کرو ، میں نے دیکھا کہ نبی ﷽ کی انگلیوں کے درمیان پانی ابل رہا تھا ، لوگ اس سے وضو کرنے لگے حتیٰ کہ سب نے وضو کر لیا ، ثابت نے حضرت انس رضی اللہ عنہ سے پوچھا کہ اس وقت آپ کتنے لوگ تھے آ انہوں نے بتایا کہ ستر کے قریب ۔"
"12725","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ تعالیٰ نے مجھ سے یہ وعدہ فرمایا ہے کہ وہ میری امت کے چار لاکھ آدمیوں کو جنت میں داخل فرمائے گا ، حضرت ابوبکر رضی اللہ عنہ نے عرض کیا یا رسول اللہ ﷽ ! اس تعداد میں اضافہ کیجئے ، نبی ﷽ نے اپنی ہتھیلی جمع کر کے فرمایا کہ اتنے افراد مزید ہوں گے ، حضرت ابوبکر رضی اللہ عنہ نے پھر عرض کیا یا رسول اللہ ﷽ ! اس تعداد میں اضافہ کیجئے ، نبی ﷽ نے پھر اپنی ہتھیلی جمع کر کے فرمایا کہ اتنے افراد مزید ہوں گے ، اس پر حضرت عمر رضی اللہ عنہ کہنے لگے کہ ابوبکر ! بس کیجئے ، حضرت ابوبکر رضی اللہ عنہ نے فرمایا عمر ! پیچھے ہٹو ، اگر اللہ تعالیٰ ہم سب ہی کو جنت میں کلی طور پر داخل فرما دے تو تمہارا اس میں کوئی حرج نہیں ہے ، حضرت عمر رضی اللہ عنہ نے کہا کہ اگر اللہ چاہے تو ایک ہی ہاتھ میں ساری مخلوق کو جنت میں داخل کر دے ، نبی ﷽ نے فرمایا عمر سچ کہتے ہیں ۔"
"12726","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ حنین کے موقع پر اللہ نے جب بنو ہوازن کا مال غنیمت نبی ﷽ کو عطاء فرمایا اور نبی ﷽ قریش کے ایک ایک آدمی کو سو سو اونٹ دینے لگے تو انصار کے کچھ لوگ کہنے لگے اللہ تعالیٰ نبی ﷽ کی بخشش فرمائے ، کہ وہ قریش کو دیئے جا رہے ہیں اور ہمیں نظر انداز کر رہے ہیں جب کہ ہماری تلواروں سے ابھی تک خون کے قطرے ٹپک رہے ہیں ۔ نبی ﷽ کو یہ بات معلوم ہوئی تو آپ ﷽ نے انصاری صحابہ رضی اللہ عنہم کو بلا بھیجا اور انہیں چمڑے سے بنے ہوئے ایک خیمے میں جمع کیا اور ان کے علاوہ کسی اور کو آنے کی اجازت نہ دی ، جب وہ سب جمع ہو گئے تو نبی ﷽ تشریف لائے اور فرمایا کہ آپ کے حوالے سے مجھے کیا باتیں معلوم ہو رہی ہیں آ انہوں نے بتایا کہ ہمارے صاحب الرائے حضرات نے تو کچھ بھی نہیں کہا ، باقی کچھ نوعمر لوگوں نے ایسی ایسی بات کہی ہیں ، نبی ﷽ نے فرمایا کہ میں ان لوگوں کو مال دیتا ہوں جن کا زمانہ کفر قریب ہی ہے اور اس کے ذریعے میں ان کی تالیف قلب کرتا ہوں ، کیا تم لوگ اس بات پر خوش نہیں ہو کہ لوگ مال و دولت لے کر چلے جائیں اور تم پیغمبر خدا کو اپنے خیموں میں لے جاا ، بخدا ! جس چیز کو لے کر تم لوٹو گے ، وہ اس چیز سے بہت بہتر ہے جو وہ لوگ لے کر واپس جائیں گے ، تمام انصاری صحابہ رضی اللہ عنہم نے عرض کیا یا رسول اللہ ﷽ ! ہم راضی ہیں ، پھر نبی ﷽ نے فرمایا عنقریب تم میرے بعد بہت زیادہ ترجیحات دیکھو گے لیکن تم صبر کرنا یہاں تک کہ اللہ اور اس کے رسول سے آ ملو ، کیونکہ میں اپنے حوض پر تمہارا انتظار کروں گا ، حضرت انس رضی اللہ عنہ کہتے ہیں کہ ہم صبر نہیں کر سکے ۔"
"12727","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ہم لوگ نبی ﷽ کے پاس بیٹھے ہوئے تھے ، نبی ﷽ نے فرمایا ابھی تھوڑی دیر کے بعد تمہارے پاس ایک جنتی آدمی آئے گا ، دیکھا تو ایک انصاری صحابی چلے آ رہے ہیں جن کی ڈاڑھی سے وضو کے پانی کے قطرات ٹپک رہے ہیں ، انہوں نے اپنے بائیں ہاتھ میں اپنی جوتی اٹھا رکھی ہے ، دوسرے دن بھی نبی ﷽ نے یہی اعلان کیا اور وہی صحابی آئے ، تیسرے دن اعلان کیا تب بھی وہی صحابی رضی اللہ عنہ آئے ، تیسرے دن جب نبی ﷽ چلے گئے تو حضرت عبداللہ بن عمرو بن عاص رضی اللہ عنہ ان صحابی رضی اللہ عنہ کے پیچھے چلے گئے اور ان سے کہنے لگے کہ میں نے اپنے والد صاحب کو قسمیں دے کر اور بہت اصرار کے بعد اس بات پر آمادہ کیا ہے کہ میں تین دن تک گھر نہیں جااں گا ، اگر آپ مجھے اپنے یہاں ٹھہرا سکتے ہیں تو آپ جو عمل کریں گے ، میں بھی وہی عمل کروں گا ، انہوں نے حضرت عبداللہ بن عمرو رضی اللہ عنہ کو اجازت دے دی ۔ حضرت عبداللہ رضی اللہ عنہ بتاتے ہیں کہ وہ ان تین راتوں میں ان کے ساتھ رہے ، لیکن کسی رات انہیں قیام کرتے ہوئے نہیں دیکھا ، البتہ اتنا ضرور ہوتا تھا کہ جب وہ سو کر بیدار ہوتے اور بستر سے اٹھتے تو اللہ کا ذکر کرتے ہوئے نماز فجر کے لئے اٹھ جاتے ، نیز میں نے انہیں ہمیشہ خیر ہی کی بات کرتے ہوئے دیکھا ، جب تین راتیں گذر گئیں اور میں اپنی ساری محنت کو حقیر سمجھنے لگا ، تو میں نے ان سے کہا کہ بندہ خدا ! میرے اور والد صاحب کے درمیان کوئی ناراضگی یا قطع تعلقی نہیں ہے + جس کی وجہ سے میں یہاں رہ پڑا ہوں , لیکن میں نے نبی ﷽ کو تین مرتبہ یہ فرماتے ہوئے سنا کہ ابھی تمہارے پاس ایک جنتی آدمی آئے گا اور تینوں مرتبہ آپ ہی آئے تو مجھے یہ خواہش پیدا ہوئی کہ میں آپ کے پاس کچھ وقت گزار کر آپ کے اعمال دیکھوں اور خود بھی اس کی اقتداء کروں ، لیکن میں نے آپ کو اس دوران کوئی بہت زیادہ عمل کرتے ہوئے نہیں دیکھا ، پھر آپ اس مقام تک کیسے پہنچ گئے کہ نبی ﷽ نے آپ کے متعلق اتنی بڑی بات فرمائی آ انہوں نے جواب دیا کہ عمل تو وہی ہے جو آپ نے دیکھا ، پھر جب میں پلٹ کر واپس جانے لگا تو انہوں نے مجھے آواز دے کر بلایا تو کہنے لگے کہ عمل تو وہی ہیں جو آپ نے دیکھے ، البتہ میں اپنے دل میں کسی مسلمان کے متعلق کوئی کینہ نہیں رکھتا اور کسی مسلمان کو ملنے والی نعمتوں اور خیر پر اس سے حسد نہیں کرتا ، حضرت عبداللہ رضی اللہ عنہ نے فرمایا یہی وہ چیز ہے جس نے آپ کو اس درجے تک پہنچایا اور جس کی ہم میں طاقت نہیں ہے ۔"
"12728","امام ابن سیرین رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ کیا حضرت عمر رضی اللہ عنہ قنوت نازلہ پڑھتے تھے آ انہوں نے فرمایا کہ حضرت عمر رضی اللہ عنہ سے بہتر ذات یعنی نبی ﷽ بھی قنوت نازلہ رکوع کے بعد پڑھتے تھے ۔"
"12729","ابومسلمہ رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ کیا نبی ﷽ اپنے جوتوں میں نماز پڑھ لیتے تھے آ انہوں نے فرمایا جی ہاں !"
"12730","ابومسلمہ رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ نبی ﷽ قراءت کا آغاز بسم اللہ سے کرتے تھے یا الحمدللہ سے آ انہوں نے فرمایا کہ تم نے مجھ سے ایسا سوال پوچھا ہے جس کے متعلق مجھے ابھی کچھ یاد نہیں ہے ۔"
"12731","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کبھی کبھار اپنی تمام ازواج مطہرات کے پاس ایک ہی رات میں ایک ہی غسل سے چلے جایا کرتے تھے ۔"
"12732","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص میری طرف جان بوجھ کر کسی جھوٹی بات کی نسبت کرے ، اسے اپنا ٹھکانہ جہنم میں بنا لینا چاہئے ۔"
"12733","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے کھڑے ہو کر لوگوں کو ڈرایا ، اسی اثناء میں ایک آدمی نے کھڑے ہو کر پوچھا یا رسول اللہ ! قیامت کب آئے گی آ نبی ﷽ کے روئے انور پر ناگواری کے آثار نظر آئے تو ہم نے اس سے کہا کہ بیٹھ جاا ، تم نے نبی ﷽ سے ایسا سوال پوچھا ہے جو انہیں اچھا نہیں لگا ، تین مرتبہ اسی طرح ہوا ، بالآخر نبی ﷽ نے اس سے پوچھا اے بھئی ! تم نے قیامت کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کہ میں نے یہ تیاری کی ہے کہ میں اللہ اور اس کے رسول سے محبت کرتا ہوں ، نبی ﷽ نے فرمایا کہ تم قیامت کے دن اس شخص کے ساتھ ہو گے جس کے ساتھ تم محبت کرتے ہو ۔"
"12734","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ربیع """" جو حضرت انس رضی اللہ عنہ کی پھوپھی تھیں """" نے ایک لڑکی کا دانت توڑ دیا ، پھر ان کے اہل خانہ نے لڑکی والوں کو تاوان کی پیشکش کی لیکن انہوں نے انکار کر دیا ، پھر انہوں نے ان سے معافی مانگی لیکن انہوں نے معاف کرنے سے بھی انکار کر دیا ، اور نبی ﷽ کے پاس آ کر قصاص کا مطالبہ کرنے لگے ، نبی ﷽ نے قصاص کا حکم دے دیا ، اسی اثناء میں ان کے بھائی اور حضرت انس رضی اللہ عنہ کے چچا انس بن نضر آ گئے اور وہ کہنے لگے یا رسول اللہ ﷽ ! کیا ربیع کا دانت توڑ دیا جائے گا آ اس ذات کی قسم جس نے آپ کو حق کے ساتھ بھیجا ہے ، اس کا دانت نہیں توڑا جائے گا ، نبی ﷽ نے فرمایا انس ! کتاب اللہ کا فیصلہ قصاص ہی کا ہے ، اسی اثناء میں وہ لوگ راضی ہو گئے اور انہوں نے انہیں معاف کر دیا اور قصاص کا مطالبہ ترک کر دیا ، اس پر نبی ﷽ نے فرمایا اللہ کے بعض بندے ایسے ہوتے ہیں جو اگر کسی کام پر اللہ کی قسم کھا لیں تو اللہ انہیں ان کی قسم میں ضرور سچا کرتا ہے ۔"
"12735","عاصم احول رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ قنوت رکوع سے پہلے ہے یا رکوع کے بعد آ انہوں نے فرمایا رکوع سے پہلے ، میں نے کہا کہ بعض لوگ یہ سمجھتے ہیں کہ نبی ﷽ نے رکوع کے بعد قنوت پڑھی ہے آ انہوں نے فرمایا وہ غلط کہتے ہیں ، وہ تو نبی ﷽ نے صرف ایک ماہ تک پڑھی تھی ، جس میں نبی ﷽ اپنے قراء صحابہ کو شہید کرنے والے لوگوں کے خلاف بددعا فرماتے تھے ۔"
"12736","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے ہمیں بلایا تاکہ بحرین سے آئے ہوئے مال کا حصہ ہمیں تقسیم کر دیں ، لیکن ہم لوگ کہنے لگے کہ پہلے ہمارے مہاجر بھائیوں کا ہمارے برابر کا حصہ الگ کیجئے ، نبی ﷽ نے ان کے جذبہ ایثار کو دیکھ کر فرمایا میرے بعد تمہیں ترجیحات کا سامنا کرنا پڑے گا ، لیکن تم صبر کرنا تاآنکہ مجھ سے آ ملو ، صحابہ رضی اللہ عنہم نے عرض کیا کہ ہم صبر کریں گے ۔"
"12737","عمار بن عاصم رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ میں کوفہ میں حضرت انس رضی اللہ عنہ کی خدمت میں حاضر ہوا اور ان سے نبیذ کے متعلق پوچھا تو انہوں نے فرمایا کہ نبی ﷽ نے دباء اور مزفت سے منع فرمایا ہے ۔"
"12738","حضرت انس رضی اللہ عنہ سے مروی ہے کہ کسی شخص نے عرض کیا یا رسول اللہ ﷽ ! لوگوں کو ان کے چہروں کے بل کیسے اٹھایا جائے گا آ نبی ﷽ نے فرمایا جو ذات انہیں پااں کے بل چلانے پر قادر ہے ، وہ انہیں چہروں کے بل چلانے پر بھی قادر ہے ۔"
"12739","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ دور نبوت میں ایک دیہاتی نے آ کر مسجد نبوی میں پیشاب کر دیا ، لوگوں نے اسے روکا تو نبی ﷽ نے فرمایا اسے چھوڑ دو ، اور حکم دیا کہ اس پر پانی کا ایک ڈول بہا دو ۔"
"12740","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا قیامت کے دن ہر فقیر اور مالدار کی تمنا یہی ہو گی کہ اسے دنیا میں بقدر گزارہ دیا گیا ہوتا ۔"
"12741","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کے پاس سے ایک آدمی گذرا جو قربانی کا جانور ہانکتے ہوئے چلا جا رہا تھا ، نبی ﷽ نے اس سے سوار ہونے کے لئے فرمایا ، اس نے کہا کہ یہ قربانی کا جانور ہے ، نبی ﷽ نے فرمایا کہ اگرچہ قربانی کا جانور ہی ہو ۔"
"12742","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب اپنے بستر پر تشریف لاتے تو یوں کہتے کہ اس اللہ کا شکر ہے جس نے ہمیں کھلایا پلایا ، ہماری کفایت کی اور ٹھکانہ دیا ، کتنے ہی لوگ ایسے ہیں جن کی کوئی کفایت کرنے والا یا انہیں ٹھکانہ دینے والا کوئی نہیں ہے ۔"
"12743","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کھڑی ہوئی تو ایک آدمی تیزی سے آیا ، اس کا سانس پھولا ہوا تھا ، صف تک پہنچ کر وہ کہنے لگا ®الحمدللہ حمدا کثیر طیبا مبارکا فیہ¾ نبی ﷽ نے نماز سے فارغ ہو کر پوچھا کہ تم میں سے کون بولا تھا آ اس نے اچھی بات کہی تھی ، چنانچہ وہ آدمی کہنے لگا یا رسول اللہ ﷽ ! میں بولا تھا ، میں تیزی سے آ رہا تھا ، اور صف کے قریب پہنچ کر میں نے یہ جملہ کہا تھا ، نبی ﷽ نے فرمایا میں نے بارہ فرشتوں کو اس کی طرف تیزی سے بڑھتے ہوئے دیکھا کہ کون اس جملے کو پہلے اٹھاتا ہے ۔"
"12744","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور خلفاء ثلاثہ رضی اللہ عنہم نماز میں قراءت کا آغاز ®الحمدللہ رب العالمین¾ سے کرتے تھے ۔"
"12745","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے پوچھا یا رسول اللہ ﷽ ! قیامت کب قائم ہو گی آ اس وقت اقامت ہو چکی تھی اس لئے نبی ﷽ نماز پڑھانے لگے ، نماز سے فارغ ہو کر فرمایا کہ قیامت کے متعلق سوال کرنے والا آدمی کہاں ہے آ اس نے کہا یا رسول اللہ ﷽ ! میں یہاں ہوں ، نبی ﷽ نے فرمایا تم نے قیامت کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کہ میں نے کوئی بہت زیادہ اعمال تو مہیا نہیں کر رکھے ، البتہ اتنی بات ضرور ہے کہ میں اللہ اور اس کے رسول سے محبت کرتا ہوں ، نبی ﷽ نے فرمایا کہ انسان قیامت کے دن اس شخص کے ساتھ ہو گا جس کے ساتھ وہ محبت کرتا ہے ، حضرت انس رضی اللہ عنہ فرماتے ہیں کہ میں نے مسلمانوں کو اسلام قبول کرنے کے بعد اس دن جتنا خوش دیکھا ، اس سے پہلے کبھی نہیں دیکھا ۔"
"12746","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی مدینہ منورہ تشریف آوری کے وقت ان کی عمر دس سال تھی ، وہ فرماتے ہیں کہ میری والدہ مجھے نبی ﷽ کی خدمت کی ترغیب دیا کرتی تھیں ، اس لئے پردہ کا حکم جب نازل ہوا ، اس وقت کی کیفیت تمام لوگوں میں سب سے زیادہ مجھے معلوم ہے ، اس رات نبی ﷽ نے حضرت زینب رضی اللہ عنہا کے ساتھ خلوت فرمائی تھی ، اور صبح کے وقت نبی ﷽ دولہا تھے ، اس کے بعد نبی ﷽ نے لوگوں کو دعوت دی ، انہوں نے آ کر کھانا کھایا اور چلے گئے ، لیکن کچھ لوگ وہیں بیٹھ رہے اور کافی دیر تک بیٹھے رہے ، حتیٰ کہ نبی ﷽ خود ہی اٹھ کر باہر چلے گئے ، میں بھی باہر چلا گیا تاکہ وہ بھی چلے جائیں ، نبی ﷽ اور میں چلتے ہوئے حضرت عائشہ رضی اللہ عنہا کے حجرے کی چوکھٹ پر جا کر رک گئے ، نبی ﷽ کا خیال تھا کہ شاید اب وہ لوگ چلے گئے ہوں گے ، چنانچہ نبی ﷽ واپس آ گئے ، میں بھی ہمراہ تھا ، دیکھا تو واقعی وہ لوگ جا چکے تھے ، پھر نبی ﷽ نے اندر داخل ہو کر پردہ لٹکا لیا اور اللہ نے آیت حجاب نازل فرما دی ۔"
"12747","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اگر ابن آدم کے پاس سونے سے بھری ہوئی وادی بھی ہوتی تو وہ ایک اور کی تمنا کرتا اور ابن آدم کا منہ صرف قبر کی مٹی ہی بھر سکتی ہے ، اور جو توبہ کرتا ہے ، اللہ اس کی توبہ قبول فرما لیتا ہے ۔"
"12748","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے میدان منیٰ میں نبی ﷽ کے ساتھ دو رکعتیں پڑھی ہیں ، حضرت ابوبکر صدیق رضی اللہ عنہ اور حضرت عمر رضی اللہ عنہ کے ساتھ بھی اور حضرت عثمان رضی اللہ عنہ کے ابتدائی دور خلافت میں بھی دو رکعتیں ہی پڑھی ہیں ۔"
"12749","حضرت انس رضی اللہ عنہ فرماتے ہیں کہ ایک دن ہم رسول اللہ ﷽ کے ساتھ مسجد میں بیٹھے ہوئے تھے ، اتنے میں ایک شخص اونٹ پر سوار آیا ، آ کر مسجد میں اونٹ بٹھایا اور + اتر کر , اونٹ کو رسی سے باندھا ، پھر پوچھنے لگا تم میں محمد ﷽ کون ہیں آ اس وقت رسول اللہ ﷽ تکیہ لگائے ہوئے درمیان میں بیٹھے ہوئے تھے ، ہم نے جواب دیا کہ یہ گورے آدمی تکیہ لگائے ہوئے جو بیٹھے ہیں یہی محمد ﷽ ہیں ۔ وہ شخص آپ ﷽ کی طرف متوجہ ہو کر کہنے لگا اے عبدالمطلب کے بیٹے ! آپ ﷽ نے فرمایا ہاں سن رہا ہوں + مدعا کہو , اس شخص نے کہا میں آپ سے کچھ پوچھنا چاہتا ہوں اور پوچھنے میں ذرا سختی سے کام لوں گا ، آپ مجھ سے ناراض نہ ہوں آپ ﷽ نے فرمایا جو چاہتے ہو دریافت کرو ، وہ بولا میں آپ کے اور گزشتہ لوگوں کے پروردگار کی قسم دے کر دریافت کرتا ہوں کہ کیا اللہ نے آپ کو سب لوگوں کے لیے پیغمبر بنا کر بھیجا ہے آ آپ ﷽ نے فرمایا ہاں اللہ کی قسم ! + سب کے لیے اسی نے مجھے پیغمبر بنا کر بھیجا ہے , وہ بولا میں آپ کو اللہ کی قسم دے کر پوچھتا ہوں کہ کیا خدا نے آپ کو شبانہ روز میں پانچ نمازیں پڑھنے کا حکم دیا ہے آ آپ ﷽ نے فرمایا ہاں ! اللہ کی قسم ، وہ بولا میں آپ کو اللہ کی قسم دیتا ہوں بتائے کہ کیا اللہ نے آپ کو ہر سال ماہ رمضان میں روزے رکھنے کا حکم دیا ہے آ آپ ﷽ نے فرمایا ہاں ! اللہ کی قسم ، وہ بولا میں آپ کو اللہ کی قسم دیتا ہوں بتائے کہ کیا اللہ نے آپ کو یہ حکم دیا ہے کہ آپ ہمارے مال داروں سے زکوٰۃ وصول کر کے غرباء میں تقسیم کریں آ آپ ﷽ نے فرمایا ہاں اللہ کی قسم ! یہ سن کر وہ شخص بولا آپ جو کچھ + اللہ کی طرف سے , لائے ہیں میں سب پر ایمان لایا اور میں اپنی قوم کا نمائندہ ہوں اور میرا نام ضمام بن ثعلبہ ہے ۔"
"12750","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب نبی ﷽ نے رومیوں کو خط لکھنے کا ارادہ کیا تو صحابہ کرام رضی اللہ عنہم نے عرض کیا کہ وہ لوگ صرف مہر شدہ خطوط ہی پڑھتے ہیں ، چنانچہ نبی ﷽ نے چاندی کی انگوٹھی بنوا لی ، اس کی سفیدی اب تک میری نگاہوں کے سامنے ہے ، اس پر یہ عبارت نقش تھی """" محمد رسول اللہ """" ﷽ ۔"
"12751","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا انسان تو بوڑھا ہو جاتا ہے لیکن دو چیزیں اس میں ہمیشہ رہتی ہیں ، ایک حرص اور ایک امید ۔"
"12752","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ فرمایا کرتے تھے اصل خیر آخرت ہی کی خیر ہے ، یا یہ فرماتے کہ اے اللہ ! آخرت کی خیر کے علاوہ کوئی خیر نہیں ، پس انصار اور مہاجرین کو معاف فرما ۔"
"12753","ابوصدقہ """" جو حضرت انس رضی اللہ عنہ کے آزاد کردہ غلام ہیں """" کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے نبی ﷽ کی نماز کے متعلق پوچھا تو انہوں نے فرمایا کہ نبی ﷽ ظہر کی نماز زوال کے بعد پڑھتے تھے ، عصر ان دو نمازوں کے درمیان پڑھتے تھے ، مغرب غروب آفتاب کے وقت پڑھتے تھے اور نماز عشاء شفق غائب ہو جانے کے بعد پڑھتے تھے اور نماز فجر اس وقت پڑھتے تھے جب طلوع فجر ہو جائے یہاں تک کہ نگاہیں کھل جائیں ۔"
"12754","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کا گذر کچھ بچوں پر ہوا ، جو کھیل رہے تھے ، نبی ﷽ نے انہیں سلام کیا ۔"
"12755","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نبی ﷽ کی خدمت میں حاضر ہوا تو دیکھا کہ آپ ﷽ بکری کے کان پر داغ رہے ہیں ۔"
"12756","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ عصر کی نماز اس وقت پڑھتے تھے جب سورج روشن اور اپنے حلقے کی شکل میں ہوتا تھا ۔"
"12757","ثابت رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ میں نے حضرت انس رضی اللہ عنہ سے عرض کیا کہ اے ابوحمزہ ! ہمیں کوئی ایسا عجیب واقعہ بتائیے جس میں آپ خود موجود ہوں اور آپ کسی کے حوالے سے اسے بیان نہ کرتے ہوں آ انہوں نے فرمایا کہ ایک مرتبہ نبی ﷽ نے ظہر کی نماز پڑھائی ، اور جا کر اس جگہ پر بیٹھ گئے جہاں حضرت جبریل علیہ السلام ان کے پاس آیا کرتے تھے ، پھر حضرت بلال رضی اللہ عنہ نے آ کر عصر کی اذان دی ، ہر وہ آدمی جس کا مدینہ منورہ میں گھر تھا وہ اٹھ کر قضاء حاجت اور وضو کے لئے چلا گیا ، کچھ مہاجرین رہ گئے جن کا مدینہ میں کوئی گھر نہ تھا ، نبی ﷽ کی خدمت میں ایک کشادہ برتن پانی کا لایا گیا ، نبی ﷽ نے اپنی ہتھیلیاں اس میں رکھ دیں لیکن اس برتن میں اتنی گنجائش نہ تھی ، لہٰذا نبی ﷽ نے چار انگلیاں ہی رکھ کر فرمایا قریب آ کر اس سے وضو کرو ، اس وقت نبی ﷽ کا دست مبارک برتن میں ہی تھا ، چنانچہ ان سب نے اس سے وضو کر لیا ، اور ایک آدمی بھی ایسا نہ رہا جس نے وضو نہ کیا ہو ۔ میں نے پوچھا کہ اے ابوحمزہ ! آپ کی رائے میں وہ کتنے لوگ تھے آ انہوں نے فرمایا ستر سے اسی کے درمیان ۔"
"12758","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کو کدو بہت پسند تھا ۔"
"12759","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قیامت کے دن سب سے زیادہ لمبی گردنوں والے لوگ ماذن ہوں گے ۔"
"12760","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب مکہ مکرمہ فتح ہو گیا اور نبی ﷽ قریش میں مال غنیمت تقسیم کرنے لگے تو انصار کے کچھ لوگ کہنے لگے تعجب ہے کہ وہ قریش کو دیئے جا رہے ہیں اور ہمیں نظر انداز کر رہے ہیں جب کہ ہماری تلواروں سے ابھی تک خون کے قطرے ٹپک رہے ہیں ۔ نبی ﷽ کو یہ بات معلوم ہوئی تو آپ ﷽ نے انصاری صحابہ رضی اللہ عنہم کو بلا بھیجا اور فرمایا کہ آپ کے حوالے سے مجھے کیا باتیں معلوم ہو رہی ہیں آ انہوں نے بتایا کہ یہ بات ٹھیک ہے اور وہ لوگ جھوٹ نہیں بولتے تھے ، نبی ﷽ نے فرمایا کیا تم لوگ اس بات پر خوش نہیں ہو کہ لوگ مال و دولت لے کر چلے جائیں اور تم پیغمبر خدا کو اپنے گھروں میں لے جاا ، اگر سارے لوگ ایک وادی یا گھاٹی میں چل رہے ہوں اور انصار دوسری جانب ، تو میں انصار کی وادی اور گھاٹی کو اختیار کروں گا ۔"
"12761","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ بازار میں ایک آدمی نے """" ابوالقاسم """" کہہ کر کسی کو آواز دی ، نبی ﷽ نے پیچھے مڑ کر دیکھا تو اس نے کہا کہ میں نے کسی اور کو آواز دی ہے ، اس پر نبی ﷽ نے فرمایا میرے نام پر تو اپنا نام رکھ لیا کرو ، لیکن میری کنیت پر اپنی کنیت نہ رکھا کرو ۔"
"12762","حضرت انس رضی اللہ عنہ سے مروی ہے کہ انصار کہا کرتے تھے کہ ہم ہی وہ لوگ ہیں جنہوں نے محمد ﷽ سے جہاد پر بیعت کی ہے جب تک ہم زندہ ہیں ، اور نبی ﷽ جواباَ فرمایا کرتے تھے اے اللہ ! آخرت کی خیر ہی اصل خیر ہے ، پس انصار اور مہاجرین کو معاف فرما ۔"
"12763","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا رکوع و سجود کو مکمل کیا کرو ، کیونکہ میں بخدا تمہیں اپنی پشت کے پیچھے سے بھی دیکھ رہا ہوتا ہوں ۔"
"12764","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی نماز سب سے زیادہ خفیف اور مکمل ہوتی تھی ۔"
"12765","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے دیکھا کہ ایک آدمی جو قربانی کا جانور ہانکتے ہوئے چلا جا رہا ہے ، نبی ﷽ نے اس سے سوار ہونے کے لئے فرمایا ، اس نے کہا کہ یہ قربانی کا جانور ہے ، نبی ﷽ نے دو تین مرتبہ اس سے فرمایا کہ سوار ہو جاا ۔"
"12766","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دو چتکبرے سینگ دار مینڈھے قربانی میں پیش کرتے تھے ، اور اللہ کا نام لے کر تکبیر کہتے تھے ، میں نے دیکھا ہے کہ نبی ﷽ انہیں اپنے ہاتھ سے ذبح کرتے تھے اور ان کے پہلو پر اپنا پااں رکھتے تھے ۔"
"12767","حضرت انس رضی اللہ عنہ سے مروی ہے کہ قبیلہ عکل اور عرینہ کے کچھ لوگ مسلمان ہو گئے ، لیکن انہیں مدینہ منورہ کی آب و ہوا موافق نہ آئی ، نبی ﷽ نے ان سے فرمایا کہ اگر تم ہمارے اونٹوں کے پاس جا کر ان کا دودھ اور پیشاب پیو تو شاید تندرست ہو جاا ، چنانچہ انہوں نے ایسا ہی کیا ، لیکن جب وہ صحیح ہو گئے تو دوبارہ مرتد ہو کر کفر کی طرف لوٹ گئے ، نبی ﷽ کے مسلمان چرواہے کو قتل کر دیا ، اور نبی ﷽ کے اونٹوں کو بھگا کر لے گئے ، نبی ﷽ نے ان کے پیچھے صحابہ رضی اللہ عنہ کو بھیجا ، انہیں پکڑ کر نبی ﷽ کے سامنے پیش کیا گیا ، نبی ﷽ نے ان کے ہاتھ پااں مخالف سمت سے کٹوا دیئے ، ان کی آنکھوں میں سلائیاں پھروا دیں اور انہیں پتھریلے علاقوں میں چھوڑ دیا یہاں تک کہ وہ مر گئے ۔"
"12768","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب نبی ﷽ نے عجمیوں کو خط لکھنے کا ارادہ کیا تو صحابہ کرام رضی اللہ عنہم نے عرض کیا کہ وہ لوگ صرف مہر شدہ خطوط ہی پڑھتے ہیں ، چنانچہ نبی ﷽ نے چاندی کی انگوٹھی بنوا لی ، اس کی سفیدی اب تک میری نگاہوں کے سامنے ہے ، اس پر یہ عبارت نقش تھی """" محمد رسول اللہ """" ﷽ ۔"
"12769","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ اور حضرت زید بن ثابت رضی اللہ عنہ نے اکٹھے سحری کی ، سحری سے فارغ ہو کر نبی ﷽ نماز کے لئے کھڑے ہوئے ، اور نماز پڑھائی ، ہم لوگ حضرت انس رضی اللہ عنہ سے پوچھنے لگے کہ سحری سے فراغت اور نماز کھڑی ہونے کے درمیان کتنا وقفہ تھا آ انہوں نے بتایا کہ جتنی دیر میں ایک آدمی پچاس آیات پڑھ سکے ۔"
"12770","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ایک ہی سحری سے مسلسل کئی روزے نہ رکھا کرو ، کسی نے عرض کیا یا رسول اللہ ! آپ تو اس طرح کرتے ہیں آ نبی ﷽ نے فرمایا میں اس معاملے میں تمہاری طرح نہیں ہوں ، میرا رب مجھے کھلا پلا دیتا ہے ۔"
"12771","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک یہودی نے ایک انصاری بچی کو اس زیور کی خاطر قتل کر دیا جو اس نے پہن رکھا تھا ، نبی ﷽ نے قصاصاَ اسے بھی قتل کروا دیا ۔"
"12772","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ مقام زوراء میں تھے ، نبی ﷽ کے پاس پانی کا ایک پیالہ لایا گیا جس میں آپ کی انگلی بھی مشکل سے کھلتی تھی ، نبی ﷽ نے اپنی انگلیوں کو جوڑ لیا اور اس میں سے اتنا پانی نکلا کہ سب نے وضو کر لیا ، کسی نے حضرت انس رضی اللہ عنہ سے پوچھا کہ اس وقت آپ کتنے لوگ تھے آ انہوں نے بتایا کہ ہم لوگ تین سو تھے ۔"
"12773","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت صفیہ رضی اللہ عنہا بنت حیی کو آزاد کر دیا اور ان کی آزادی ہی کو ان کا مہر قرار دے دیا ۔"
"12774","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ رات کے وقت اہل مدینہ دشمن کے خوف سے گھبرا اٹھے ، نبی ﷽ نے ہمارا ایک گھوڑا """" جس کا نام مندوب تھا """" عاریۃَ لیا اور فرمایا گھبرانے کی کوئی بات نہیں اور گھوڑے کے متعلق فرمایا کہ ہم نے اسے سمندر جیسا رواں پایا ۔"
"12775","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں حضرت ابوطلحہ رضی اللہ عنہ کے پیچھے بیٹھا ہوا تھا ، قریب تھا کہ حضرت ابوطلحہ رضی اللہ عنہ کا گھٹنا نبی ﷽ کے گھٹنے سے مل جاتا اور نبی ﷽ حج اور عمرہ دونوں کا تلبیہ پڑھتے ہوئے چلے جا رہے تھے ۔"
"12776","ہشام بن زید کہتے ہیں کہ ایک مرتبہ میں اپنے دادا حضرت انس رضی اللہ عنہ کے ساتھ دار حکم بن ایوب میں داخل ہوا ، وہاں کچھ لوگ ایک مرغی کو باندھ کر اس پر نشانہ بازی کر رہے تھے ، یہ دیکھ کر حضرت انس رضی اللہ عنہ نے فرمایا کہ نبی ﷽ نے جانور کو باندھ کر اس پر نشانہ درست کرنے سے منع فرمایا ہے ۔"
"12777","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مرالظہران نامی جگہ پر اچانک ہمارے سامنے ایک خرگوش آ گیا ، بچے اس کی طرف دوڑے ، لیکن اسے پکڑ نہ سکے یہاں تک کہ تھک گئے ، میں نے اسے پکڑ لیا ، اور حضرت ابوطلحہ رضی اللہ عنہ کے پاس لے آیا ، انہوں نے اسے ذبح کیا اور اس کا ایک پہلو نبی ﷽ کی خدمت میں میرے ہاتھ بھیج دیا اور نبی ﷽ نے اسے قبول فرما لیا ۔"
"12778","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک یہودی نے ایک انصاری بچی کو اس زیور کی خاطر قتل کر دیا جو اس نے پہن رکھا تھا اور پتھر مار مار کر اس کا سر کچل دیا ، جب اس بچی کو نبی ﷽ کے پاس لایا گیا تو اس میں زندگی کی تھوڑی سی رمق باقی تھی ، نبی ﷽ نے ایک آدمی کا نام لے کر اس سے پوچھا کہ تمہیں فلاں آدمی نے مارا ہے آ اس نے سر کے اشارے سے کہا نہیں ، دوسری مرتبہ بھی یہی ہوا ، تیسری مرتبہ اس نے کہا ہاں ! تو نبی ﷽ نے اس یہودی کو دو پتھروں کے درمیان قتل کروا دیا ۔"
"12779","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے انصار سے فرمایا عنقریب تم میرے بعد بہت زیادہ ترجیحات دیکھو گے لیکن تم صبر کرنا یہاں تک کہ مجھ سے آ ملو ، کیونکہ میں اپنے حوض پر تمہارا انتظار کروں گا ۔"
"12780","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں ایک بچے کو لے کر """" جو میری والدہ کے یہاں ہوا تھا """" نبی ﷽ کی خدمت میں حاضر ہوا ، کہ وہ اسے گھٹی دیں ، تو دیکھا کہ آپ ﷽ باڑے میں بکری کے کان پر داغ رہے ہیں ۔"
"12781","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا گھوڑوں کی پیشانیوں میں برکت رکھ دی گئی ہے ۔"
"12782","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت ابوذر رضی اللہ عنہ سے ارشاد فرمایا بات سنتے اور مانتے رہو ، خواہ تم پر ایک حبشی """" جس کا سر کشمش کی طرح ہو """" گورنر بنا دیا جائے ۔"
"12783","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ ہمارے یہاں آتے تھے اور میرے چھوٹے بھائی کے ساتھ ہنسی مذاق کیا کرتے تھے ، ایک دن نبی ﷽ نے اسے غمگین دیکھا تو فرمایا اے ابوعمیر ! کیا کیا نغیر آ چڑیا ، جو مر گئی تھی اور ہمارے لیے ایک چادر بچھائی گئی جس پر نبی ﷽ نے نماز پڑھائی اور ہم نے ان کے پیچھے کھڑے ہو کر صف بنا لی ۔"
"12784","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب قضاء حاجت کے لئے جاتے تو میں اور میرے جیسا ایک لڑکا پانی کا برتن اور نیزہ اٹھاتے تھے اور نبی ﷽ پانی سے استنجاء فرماتے تھے ۔"
"12785","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا تم میں سے کوئی شخص اپنے اوپر آنے والی کسی تکلیف کی وجہ سے موت کی تمنا نہ کرے ، اگر موت کی تمنا کرنا ہی ضروری ہو تو اسے یوں کہنا چاہئے کہ اے اللہ ! جب تک میرے لیے زندگی میں کوئی خیر ہے ، مجھے اس وقت تک زندہ رکھ ، اور جب میرے لیے موت میں بہتری ہو تو مجھے موت عطاء فرما دینا ۔"
"12786","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قوم کا بھانجا ان ہی میں شمار ہوتا ہے ۔"
"12787","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ فرمایا کرتے تھے اصل خیر آخرت ہی کی خیر ہے ، یا یہ فرماتے کہ اے اللہ ! آخرت کی خیر کے علاوہ کوئی خیر نہیں ، پس انصار اور مہاجرین کی اصلاح فرما ۔"
"12788","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب نبی ﷽ سجدے میں جاتے تھے تو میری نظر آپ ﷽ کی مبارک بغل کی سفیدی پر پڑ جاتی تھی ۔"
"12789","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت زینب رضی اللہ عنہا کے موقع پر جو ولیمہ فرمایا ، اس سے زیادہ بہتر ولیمہ اپنی کسی اہلیہ سے شادی کے موقع پر نہیں فرمایا ، ثابت بنانی رحمۃ اللہ نے حضرت انس رضی اللہ عنہ سے پوچھا کہ نبی ﷽ نے کیا ولیمہ فرمایا آ انہوں نے جواب دیا کہ نبی ﷽ نے انہیں روٹی گوشت کھلایا اور اتنا کھلایا کہ لوگوں نے خود ہی چھوڑا ۔"
"12790","حضرت انس رضی اللہ عنہ سے مروی ہے کہ بعض اوقات نبی ﷽ سجدہ یا رکوع سے سر اٹھاتے اور ان دونوں کے درمیان اتنا لمبا وقفہ فرماتے کہ ہمیں یہ خیال ہونے لگتا کہ کہیں نبی ﷽ بھول تو نہیں گئے ۔"
"12791","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ سفر پر تھے اور حدی خوان امہات المومنین کی سواریوں کو ہانک رہا تھا ، اس نے جانوروں کو تیزی سے ہانکنا شروع کر دیا ، اس پر نبی ﷽ نے ہنستے ہوئے فرمایا انجشہ ! ان آبگینوں کو آہستہ لے کر چلو ۔"
"12792","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے نبی ﷽ سے پوچھا کہ قیامت کب قائم ہو گی آ نبی ﷽ نے فرمایا تم نے قیامت کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کہ میں نے کوئی بہت زیادہ اعمال ، نماز روزہ تو مہیا نہیں کر رکھے ، البتہ اتنی بات ضرور ہے کہ میں اللہ اور اس کے رسول سے محبت کرتا ہوں ، نبی ﷽ نے فرمایا کہ تم قیامت کے دن اس شخص کے ساتھ ہو گے جس کے ساتھ تم محبت کرتے ہو ۔"
"12793","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے اپنے اس دائیں ہاتھ سے نبی ﷽ کی بیعت بات سننے اور ماننے کی شرط پر کی تھی اور نبی ﷽ نے اس میں """" حسب طاقت """" کی قید لگا دی تھی ۔"
"12794","حضرت انس رضی اللہ عنہ سے مروی ہے کہ اگر مجھے غلطی کا اندیشہ نہ ہوتا تو میں تم سے نبی ﷽ کی بہت سی احادیث بیان کرتا لیکن نبی ﷽ نے ارشاد فرمایا ہے کہ جو شخص میری طرف جان بوجھ کر کسی جھوٹی بات کی نسبت کرے ، اسے اپنا ٹھکانہ جہنم میں بنا لینا چاہئے ۔"
"12795","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا تین چیزیں جس شخص میں بھی ہوں گی ، وہ ایمان کی حلاوت محسوس کرے گا ، ایک تو یہ کہ اللہ اور اس کے رسول اسے دوسروں سے سب سے زیادہ محبوب ہوں ، دوسرا یہ کہ انسان کسی سے محبت کرے تو صرف اللہ کی رضاء کے لئے ، اور تیسرا یہ کہ انسان کفر سے نجات ملنے کے بعد اس میں واپس جانے کو اسی طرح ناپسند کرے جیسے آگ میں چھلانگ لگانے کو ناپسند کرتا ہے ۔"
"12796","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ آپ ﷽ نے انصاری صحابہ رضی اللہ عنہم کو جمع کیا اور ان سے پوچھا کہ تم میں انصار کے علاوہ تو کوئی نہیں ہے آ انہوں نے عرض کیا نہیں ، البتہ ہمارا ایک بھانجا ہے ، نبی ﷽ نے فرمایا کسی قوم کا بھانجا ان ہی میں شمار ہوتا ہے ، پھر فرمایا قریش کا زمانہ جاہلیت اور مصیبت قریب ہی ہے اور اس کے ذریعے میں ان کی تالیف قلب کرتا ہوں ، کیا تم لوگ اس بات پر خوش نہیں ہو کہ لوگ مال و دولت لے کر چلے جائیں اور تم پیغمبر خدا کو اپنے گھروں میں لے جاا اگر لوگ ایک راستے پر چل رہے ہوں اور انصار دوسرے راستے پر تو میں انصار کے راستے پر چلوں گا ۔"
"12797","[Darussalam 12767] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12798","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ فرمایا کرتے تھے اصل خیر آخرت ہی کی خیر ہے ، یا یہ فرماتے کہ اے اللہ ! آخرت کی خیر کے علاوہ کوئی خیر نہیں ، پس انصار اور مہاجرین کو معزز فرما ۔"
"12799","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک دیہاتی آیا اور کہنے لگا یا رسول اللہ ﷽ ! قیامت کب قائم ہو گی آ نبی ﷽ نے فرمایا تم نے قیامت کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کہ اللہ اور اس کے رسول سے محبت ، نبی ﷽ نے فرمایا کہ تم اس کے ساتھ ہو گے جس سے تم محبت کرتے ہو ۔"
"12800","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضور نبی مکرم ﷽ نے ارشاد فرمایا دنیا میں جو نبی بھی مبعوث ہو کر آئے ، انہوں نے اپنی امت کو کانے کذاب سے ضرور ڈرایا ، یاد رکھو ! دجال کانا ہو گا اور تمہارا رب کانا نہیں ہے ، اور اس کی دونوں آنکھوں کے درمیان کافر لکھا ہو گا ۔"
"12801","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جنت میں داخل ہونے والا کوئی شخص بھی جنت سے نکلنا کبھی پسند نہیں کرے گا سوائے شہید کے کہ جس کی خواہش یہ ہو گی کہ وہ جنت سے نکلے اور پھر دس مرتبہ اللہ کی راہ میں شہید ہو ، کیونکہ اسے اس کی عزت نظر آ رہی ہو گی ۔"
"12802","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قیامت کے دن اللہ تعالیٰ فرمائے گا کہ ہر اس شخص کو جہنم سے نکال لو جو ®لا الہ الا اللہ¾ کا اقرار کرتا تھا اور اس کے دل میں جو کے دانے کے برابر بھی خیر موجود ہو ، پھر اللہ تعالیٰ فرمائے گا کہ ہر اس شخص کو جہنم سے نکال لو جو ®لا الہ الا اللہ¾ کا اقرار کرتا تھا اور اس کے دل میں ذرے کے برابر بھی خیر موجود ہو ، پھر اللہ تعالی فرمائے گا کہ ہر اس شخص کو جہنم سے نکال لو جو ®لا الہ الا اللہ¾ کا اقرار کرتا تھا اور اس کے دل میں گندم کے دانے کے برابر بھی خیر موجود ہو ۔"
"12803","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی نماز سب سے زیادہ خفیف اور مکمل ہوتی تھی ۔"
"12804","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کا گذر ایک آدمی پر ہوا جو قربانی کا جانور ہانکتے ہوئے چلا جا رہا تھا ، نبی ﷽ نے اس سے سوار ہونے کے لئے فرمایا ، اس نے کہا کہ یہ قربانی کا جانور ہے ، نبی ﷽ نے دو تین مرتبہ اس سے فرمایا کہ سوار ہو جاا ۔"
"12805","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا مسجد میں تھوکنا گناہ ہے اور اس کا کفارہ اسے دفن کر دینا ہے ۔"
"12806","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ایک ہی سحری سے مسلسل کئی روزے نہ رکھا کرو ، کسی نے عرض کیا یا رسول اللہ ! آپ تو اس طرح کرتے ہیں آ نبی ﷽ نے فرمایا میں اس معاملے میں تمہاری طرح نہیں ہوں ، میرا رب مجھے کھلا پلا دیتا ہے ۔"
"12807","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے جب انصار کو جمع کیا تو فرمایا کیا تم میں انصار کے علاوہ کوئی اور بھی ہے آ انہوں نے کہا نہیں ، سوائے ایک بھانجے کے ، نبی ﷽ نے فرمایا بھانجا بھی قوم ہی میں شمار ہوتا ہے ۔"
"12808","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"12809","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا بیماری متعدی ہونے اور بدشگونی کی کوئی حیثیت نہیں ، البتہ مجھے فال یعنی اچھا اور پاکیزہ کلمہ اچھا لگتا ہے ، میں نے پوچھا فال سے کیا مراد ہے آ تو فرمایا اچھا کلمہ ۔"
"12810","حضرت انس رضی اللہ عنہ سے مروی ہے کہ + نبی ﷽ جب حدیبیہ سے واپس آ رہے تھے تو , آپ ﷽ پر یہ آیت نازل ہوئی """" ®انا فتحنا لک فتحا مبینا ۔۔۔۔۔۔ صراطا مستقیما¾ """" مسلمانوں نے یہ سن کر کہا یا رسول اللہ ﷽ ! آپ کو مبارک ہو کہ اللہ نے آپ کو یہ دولت عطاء فرمائی ، ہمارے لئے کیا حکم ہے آ اس پر یہ آیت نازل ہوئی """" ®لیدخل المومنین والمومنات جنات ۔۔۔۔۔۔ ۔ فوزا عظیما¾ """""
"12811","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مدینہ منورہ کی ایک عام باندی بھی نبی ﷽ کا دست مبارک پکڑ کر اپنے کام کاج کے لئے نبی ﷽ کو لے جایا کرتی تھی اور نبی ﷽ اس سے اپنا ہاتھ نہ چھڑاتے تھے ۔"
"12812","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب یہ آیت نازل ہوئی کہ """" تم نیکی کے اعلیٰ درجے کو اس وقت تک حاصل نہیں کر سکتے جب تک اپنی پسندیدہ چیز خرچ نہ کرو """" اور یہ آیت کہ """" کون ہے جو اللہ کو قرض حسنہ دیتا ہے """" تو حضرت ابوطلحہ رضی اللہ عنہ کہنے لگے یا رسول اللہ ! میرا فلاں باغ جو فلاں جگہ پر ہے ، وہ اللہ کے نام پر دیتا ہوں اور بخدا ! اگر یہ ممکن ہوتا کہ میں اسے مخفی رکھوں تو کبھی اس کا پتہ بھی نہ لگنے دیتا ، نبی ﷽ نے فرمایا اسے اپنے خاندان کے فقراء میں تقسیم کر دو ۔"
"12813","ہارون بن ابی دااد رحمۃ اللہ کہتے ہیں کہ میں ایک مرتبہ حضرت انس رضی اللہ عنہ کے پاس آیا اور عرض کیا کہ اے ابوحمزہ ! جگہ دور کی ہے لیکن ہمارا دل چاہتا ہے کہ آپ کی عیادت کو آیا کریں ، اس پر انہوں نے اپنا سر اٹھا کر کہا کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ جو شخص کسی بیمار کی عیادت کرتا ہے ، وہ رحمت الہٰیہ کے سمندر میں غوطے لگاتا ہے ، اور جب مریض کے پاس بیٹھتا ہے تو اللہ کی رحمت اسے ڈھانپ لیتی ہے ، میں نے عرض کیا یا رسول اللہ ﷽ ! یہ تو اس تندرست آدمی کا حکم ہے جو مریض کی عیادت کرتا ہے ، مریض کا کیا حکم ہے آ نبی ﷽ نے فرمایا اس کے گناہ معاف کر دیئے جاتے ہیں ۔"
"12814","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا تین چیزیں جس شخص میں بھی ہوں گی ، وہ ایمان کی حلاوت محسوس کرے گا ، ایک تو یہ کہ اللہ اور اس کے رسول اسے دوسروں سے سب سے زیادہ محبوب ہوں ، دوسرا یہ کہ انسان کسی سے محبت کرے تو صرف اللہ کی رضاء کے لئے ، اور تیسرا یہ کہ انسان کفر سے نجات ملنے کے بعد اس میں واپس جانے کو اسی طرح ناپسند کرے جیسے آگ میں چھلانگ لگانے کو ناپسند کرتا ہے ۔"
"12815","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ مدینہ منورہ تشریف لائے تو اس وقت میری عمر نو سال تھی ، ام سلیم رضی اللہ عنہا مجھے لے کر نبی ﷽ کی خدمت میں حاضر ہوئیں اور عرض کیا یا رسول اللہ ! یہ میرا بیٹا ہے آپ اسے اپنی خدمت کے لئے قبول فرما لیجئے ، میں نے نبی ﷽ کی خدمت نو سال تک کی ، نبی ﷽ نے کبھی مجھ سے یہ نہیں فرمایا کہ تم نے فلاں کام کیوں کیا ، نہ ہی یہ فرمایا کہ تم نے فلاں کام کیوں نہیں کیا آ ایک مرتبہ میں بچوں کے ساتھ کھیل رہا تھا ، اسی دوران نبی ﷽ تشریف لے آئے اور ہمیں سلام کیا ، پھر میرا ہاتھ پکڑ کر مجھے کسی کام سے بھیج دیا جب میں واپس آ گیا ، تو نبی ﷽ نے فرمایا یہ کسی کو نہ بتانا ، ادھر مجھے گھر پہنچنے میں دیر ہو گئی تھی چنانچہ جب میں گھر واپس پہنچا تو حضرت ام سلیم رضی اللہ عنہا + میری والدہ , کہنے لگیں کہ اتنی دیر کیوں لگا دی آ میں نے بتایا کہ نبی ﷽ نے اپنے کسی کام سے بھیجا تھا ، انہوں نے پوچھا کیا کام تھا آ میں نے کہا کہ نبی ﷽ نے مجھے کسی کو بتانے سے منع کیا ہے ، انہوں نے کہا کہ پھر نبی ﷽ کے راز کی حفاظت کرنا ۔"
"12816","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ابوطیبہ نے نبی ﷽ کے سینگی لگائی ، نبی ﷽ نے اسے ایک صاع کھجور دینے کا حکم دیا اور اس کے مالک سے بات کی تو انہوں نے اس پر تخفیف کر دی ۔"
"12817","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا قیامت تک ہونے والی کسی چیز کے متعلق تم مجھ سے سوال کر سکتے ہو ، ایک آدمی نے پوچھ لیا یا رسول اللہ ﷽ ! میرا باپ کون ہے آ نبی ﷽ نے فرمایا تمہارا باپ حذافہ ہے ، ان کی والدہ نے ان سے کہا کہ تمہارا اس سے کیا مقصد تھا آ انہوں نے کہا کہ میں لوگوں کی باتوں سے چھٹکارا حاصل کرنا چاہتا تھا ، دراصل ان کے متعلق کچھ باتیں مشہور تھیں ۔"
"12818","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کو کدو بہت پسند تھا ، اس لیے جب بھی کدو کا سالن آتا تو میں اسے الگ کر کے نبی ﷽ کے سامنے کرتا تھا ۔"
"12819","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت عتبان رضی اللہ عنہ کی بینائی چلی گئی ، انہوں نے نبی ﷽ کے پاس پیغام بھیج کر اپنی مصیبت کا ذکر کیا ، اور عرض کیا یا رسول اللہ ﷽ ! میرے گھر تشریف لا کر نماز پڑھ دیجئے تاکہ میں اسی جگہ کو اپنی جائے نماز بنا لوں ، چنانچہ ایک دن نبی ﷽ ان کے یہاں تشریف لے گئے ، نبی ﷽ نماز پڑھنے کھڑے ہو گئے ، لوگ جمع ہو گئے اور مالک بن دخشم کو منافق قرار دینے لگے ، نبی ﷽ نے فرمایا کیا وہ اس بات کی گواہی نہیں دیتا کہ اللہ کے علاوہ کوئی معبود نہیں اور میں اللہ کا رسول ہوں آ لوگوں نے کہا کیوں نہیں ، نبی ﷽ نے فرمایا اس ذات کی قسم جس کے دست قدرت میں میری جان ہے جو شخص اس بات کی صدق دل سے گواہی دے تو جہنم کی آگ اس پر حرام کر دی جاتی ہے ۔"
"12820","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب اہل یمن نبی ﷽ کی خدمت میں حاضر ہوئے تو انہوں نے نبی ﷽ سے درخواست کی کہ ان کے ساتھ ایک آدمی کو بھیج دیں جو انہیں دین کی تعلیم دے ، نبی ﷽ نے فرمایا میں تمہارے ساتھ اس امت کے امین کو بھیجوں گا ، پھر نبی ﷽ نے ان کے ساتھ حضرت ابوعبیدہ رضی اللہ عنہ کو بھیج دیا ۔"
"12821","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی آیا اور اس نے نبی ﷽ سے کچھ مانگا ، نبی ﷽ نے اسے صدقہ کی بکریوں میں سے بہت سی بکریاں """" جو دو پہاڑوں کے درمیان آ سکیں """" دینے کا حکم دے دیا ، وہ آدمی اپنی قوم کے پاس آ کر کہنے لگا لوگو ! اسلام قبول کر لو ، کیونکہ محمد ﷽ اتنی بخشش دیتے ہیں کہ انسان کو فقر و فاقہ کا کوئی اندیشہ نہیں رہتا ، دوسری سند سے اس میں یہ اضافہ بھی ہے کہ بعض اوقات نبی ﷽ کے پاس ایک آدمی آ کر صرف دنیا کا ساز و سامان حاصل کرنے کے لئے اسلام قبول کر لیتا ، لیکن اس دن کی شام تک دین اس کی نگاہوں میں سب سے زیادہ محبوب ہو چکا ہوتا تھا ۔"
"12822","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ اپنے سفید خچر پر سوار مدینہ منورہ میں بنو نجار کے کسی باغ سے گذرے ، وہاں کسی قبر میں عذاب ہو رہا تھا ، چنانچہ خچر بدک گیا ، نبی ﷽ نے فرمایا اگر تم لوگ اپنے مردوں کو دفن کرنا چھوڑ نہ دیتے تو میں اللہ سے یہ دعاء کرتا کہ وہ تمہیں بھی عذاب قبر کی آواز سنا دے ۔"
"12823","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک یہودی لڑکا نبی ﷽ کے لئے وضو کا پانی رکھتا تھا اور جوتے پکڑاتا تھا ، ایک مرتبہ وہ بیمار ہو گیا ، نبی ﷽ اس کے پاس تشریف لے گئے ، وہاں اس کا باپ اس کے سرہانے بیٹھا ہوا تھا ، نبی ﷽ نے اسے کلمہ پڑھنے کی تلقین کی ، اس نے اپنے باپ کو دیکھا ، وہ خاموش رہا ، نبی ﷽ نے اپنی بات دوبارہ دہرائی اور اس نے دوبارہ اپنے باپ کو دیکھا ، اس نے کہا کہ ابوالقاسم ﷽ کی بات مانو ، چنانچہ اس لڑکے نے کلمہ پڑھ لیا ، نبی ﷽ جب وہاں سے نکلے تو آپ ﷽ یہ فرما رہے تھے کہ اس اللہ کا شکر ہے جس نے اسے میری وجہ سے جہنم سے بچا لیا ۔"
"12824","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"12825","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کا وقت آیا تو ہر وہ آدمی جس کا مدینہ منورہ میں گھر تھا وہ اٹھ کر قضاء حاجت اور وضو کے لئے چلا گیا ، کچھ مہاجرین رہ گئے جن کا مدینہ میں کوئی گھر نہ تھا اور وہ ستر ، اسی کے درمیان تھے ، نبی ﷽ کی خدمت میں ایک کشادہ برتن پانی کا لایا گیا ، نبی ﷽ نے اپنی ہتھیلیاں اس میں رکھ دیں لیکن اس برتن میں اتنی گنجائش نہ تھی ، لہٰذا نبی ﷽ نے چار انگلیاں ہی رکھ کر فرمایا قریب آ کر اس سے وضو کرو ، اس وقت نبی ﷽ کا دست مبارک برتن میں ہی تھا ، چنانچہ ان سب نے اس سے وضو کر لیا ، اور ایک آدمی بھی ایسا نہ رہا جس نے وضو نہ کیا ہو اور پھر بھی اس میں اتنا ہی پانی بچ گیا ۔"
"12826","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب حضرت ابوطلحہ رضی اللہ عنہ کے یہاں ان کا بیٹا عبداللہ پیدا ہوا تو میں اس بچے کو لے کر نبی ﷽ کی خدمت میں حاضر ہوا ، میں نے دیکھا کہ نبی ﷽ اپنے اونٹوں کو قطران مل رہے ہیں ، نبی ﷽ نے فرمایا کیا تمہارے پاس کھجور ہے آ میں نے عرض کیا جی ہاں ! نبی ﷽ نے ایک کھجور لے کر اسے منہ میں چبا کر نرم کیا ، اور تھوک جمع کر کے اس کے منہ میں ٹپکا دیا ، جسے وہ چاٹنے لگا ، نبی ﷽ نے فرمایا کھجور انصار کی محبوب چیز ہے ، اور نبی ﷽ نے اس کا نام عبداللہ رکھ دیا 1"
"12827","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ صحابہ کرام رضی اللہ عنہم نے بارگاہ نبوت میں عرض کیا کہ جب ہم آپ کی خدمت میں ہوتے ہیں ، آپ ہم سے احادیث بیان فرماتے ہیں تو ہمارے دلوں پر رقت طاری ہو جاتی ہے اور جب ہم آپ کی مجلس سے نکل کر جاتے ہیں تو اپنے بیوی بچوں میں مگن ہو جاتے ہیں اور اپنے کاموں میں لگ جاتے ہیں آ نبی ﷽ نے فرمایا اگر ہمیشہ ہی تمہاری یہ کیفیت رہنے لگے تو فرشتے تم سے مصافحہ کرنے لگیں ۔"
"12828","حضرت انس رضی اللہ عنہ سے مروی ہے نبی ﷽ کے سامنے انصار کی کچھ عورتیں اور بچے ایک شادی سے آتے ہوئے گذرے ، نبی ﷽ نے کھڑے کھڑے تین مرتبہ فرمایا اللہ کی قسم ! تم لوگ میرے نزدیک سب سے زیادہ محبوب ہو ۔"
"12829","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کی مجلس میں دو آدمیوں کو چھینک آئی ، نبی ﷽ نے ان میں سے ایک کو اس کا جواب + یرحمک اللہ کہہ کر , دے دیا اور دوسرے کو چھوڑ دیا ، کسی نے پوچھا کہ دو آدمیوں کو چھینک آئی ، آپ نے ان میں سے ایک کو جواب دیا ، دوسرے کو کیوں نہ دیا آ فرمایا کہ اس نے الحمدللہ کہا تھا اور دوسرے نے نہیں کہا تھا ۔"
"12830","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ام سلیم رضی اللہ عنہا ازواج مطہرات کے ہمراہ تھیں ، نبی ﷽ کا ایک حدی خوان + تھا """" جس کا نام انجشہ تھا """" وہ , امہات المومنین کی سواریوں کو ہانک رہا تھا ، نبی ﷽ نے ان سے فرمایا انجشہ ! ان آبگینوں کو آہستہ لے کر چلو ۔"
"12831","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص میری طرف جان بوجھ کر کسی جھوٹی بات کی نسبت کرے ، اسے اپنا ٹھکانہ جہنم میں بنا لینا چاہئے ۔"
"12832","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا تم میں سے کوئی شخص اس وقت تک مومن نہیں ہو سکتا جب تک اپنے بھائی یا پڑوسی کے لئے وہی پسند نہ کرنے لگے جو اپنے لئے پسند کرتا ہے ۔"
"12833","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا انصار میرا پردہ ہیں لوگ بڑھتے جائیں گے اور انصار کم ہوتے جائیں گے ، اس لئے تم انصار کے نیکوں کی نیکی قبول کرو ، اور ان کے گناہگار سے تجاوز اور درگذر کرو ۔"
"12834","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نبی ﷽ کو یہ کہتے ہوئے سنتا تھا ، مجھے معلوم نہیں کہ یہ قرآن کی آیت تھی یا نبی ﷽ کا فرمان ، کہ اگر ابن آدم کے پاس مال سے بھری ہوئی دو وادیاں بھی ہوتیں تو وہ تیسری کی تمنا کرتا اور ابن آدم کا پیٹ صرف قبر کی مٹی ہی بھر سکتی ہے ، اور جو توبہ کرتا ہے ، اللہ اس کی توبہ قبول فرما لیتا ہے ۔"
"12835","[Darussalam 12804] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12836","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے پاس ایک آدمی کو لایا گیا جس نے شراب پی تھی ، نبی ﷽ نے اسے تقریباَ چالیس مرتبہ دو ٹہنیوں سے مارا ، حضرت ابوبکر صدیق رضی اللہ عنہ نے بھی ایسا ہی کیا لیکن جب حضرت عمر فاروق رضی اللہ عنہ کا دور خلافت آیا تو حضرت عمر رضی اللہ عنہ نے اس کے متعلق مشورہ کیا ، حضرت عبدالرحمن بن عوف رضی اللہ عنہ نے یہ رائے دی کہ سب سے کم درجے کی حد اسی کوڑے ہے ، چنانچہ حضرت عمر رضی اللہ عنہ نے شراب نوشی کی سزا اسی کوڑے مقرر کر دی ۔"
"12837","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں تمہیں نبی ﷽ سے سنی ہوئی ایک ایسی حدیث سناتا ہوں جو میرے بعد کوئی تم سے بیان نہ کرے گا ، میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ قیامت کی علامات میں یہ بات بھی ہے کہ علم اٹھا لیا جائے گا ، اس وقت جہالت کا غلبہ ہو گا ، بدکاری عام ہو گی ، اور شراب نوشی بکثرت ہو گی ، مردوں کی تعداد کم ہو جائے گی اور عورتوں کی تعداد بڑھ جائے گی حتیٰ کہ پچاس عورتوں کا ذمہ دار صرف ایک آدمی ہو گا ۔"
"12838","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"12839","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے فرمایا اگر تم لوگ اپنے مردوں کو دفن کرنا چھوڑ نہ دیتے تو میں اللہ سے یہ دعاء کرتا کہ وہ تمہیں بھی عذاب قبر کی آواز سنا دے ۔"
"12840","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جب تم میں سے کوئی شخص نماز پڑھ رہا ہوتا ہے تو وہ اپنے رب سے مناجات کر رہا ہوتا ہے ، اس لئے اس حالت میں تم میں سے کوئی شخص اپنی دائیں جانب نہ تھوکا کرے بلکہ بائیں جانب یا اپنے پااں کے نیچے تھوکا کرے ۔"
"12841","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کے ساتھ اور حضرات خلفاء ثلاثہ رضی اللہ عنہ کے ساتھ نماز پڑھی ہے ، میں نے ان میں سے کسی ایک کو بھی بلند آواز سے """" بسم اللہ """" پڑھتے ہوئے نہیں سنا ۔ قتادہ رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا نبی ﷽ کس چیز سے قراءت کا آغاز فرماتے تھے آ انہوں نے فرمایا کہ تم نے مجھ سے ایسی چیز کے متعلق سوال پوچھا ہے کہ اس سے پہلے کسی نے ایسا سوال نہیں کیا ۔"
"12842","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کو کدو بہت پسند تھا ، ایک مرتبہ نبی ﷽ کی خدمت میں کھانا پیش کیا گیا یا کسی نے دعوت کی تو چونکہ مجھے معلوم تھا کہ نبی ﷽ کو کدو مرغوب ہے لہٰذا میں اسے الگ کر کے نبی ﷽ کے سامنے کرتا رہا ۔"
"12843","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا سجدوں میں اعتدال برقرار رکھا کرو ، اور تم میں سے کوئی شخص کتے کی طرح اپنے ہاتھ نہ بچھائے ۔"
"12844","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا صفیں سیدھی رکھا کرو کیونکہ صفوں کی درستگی نماز کا حسن ہے ۔"
"12845","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا تم میں سے کوئی شخص اس وقت تک مومن نہیں ہو سکتا جب تک کہ میں اس کی نگاہوں میں اس کے والد ، اولاد اور تمام لوگوں سے زیادہ محبوب نہ ہو جااں ۔"
"12846","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کھانا کھا کر اپنی تین انگلیوں کو چاٹ لیتے تھے اور فرماتے تھے کہ جب تم میں سے کسی کے ہاتھ سے لقمہ گر جائے تو وہ اس پر لگنے والی چیز کو ہٹا دے اور اسے شیطان کے لئے نہ چھوڑے اور پیالہ اچھی طرح صاف کر لیا کرو کیونکہ تمہیں معلوم نہیں کہ کھانے کے کس حصے میں برکت ہوتی ہے ۔"
"12847","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے سینگی لگوائی اور آپ ﷽ کسی کی مزدوری کے معاملے میں اس پر ظلم نہیں فرماتے تھے ۔"
"12848","زبیر بن عدی رحمۃ اللہ کہتے ہیں کہ ہم نے حضرت انس رضی اللہ عنہ سے حجاج بن یوسف کے مظالم کی شکایت کی ، انہوں نے فرمایا صبر کرو ، کیونکہ ہر سال یا دن کے بعد آنے والا سال اور دن اس سے بدتر ہو گا ، یہاں تک کہ تم اپنے رب سے جا ملو ، میں نے یہ بات تمہارے نبی ﷽ سے سنی ہے ۔"
"12849","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے مدینہ منورہ میں ظہر کی چار رکعتیں اور ذوالحلیفہ میں عصر کی دو رکعتیں پڑھی ہیں ۔"
"12850","حضرت انس رضی اللہ عنہ سے مروی ہے کہ کچھ لوگ مسلمان ہو کر مدینہ منورہ آ گئے ، لیکن انہیں مدینہ منورہ کی آب و ہوا موافق نہ آئی ، نبی ﷽ نے ان سے فرمایا کہ اگر تم ہمارے اونٹوں کے پاس جا کر ان کا دودھ پیو تو شاید تندرست ہو جاا ، چنانچہ انہوں نے ایسا ہی کیا ، لیکن جب وہ صحیح ہو گئے تو دوبارہ مرتد ہو کر کفر کی طرف لوٹ گئے ، نبی ﷽ کے مسلمان چرواہے کو قتل کر دیا ، اور نبی ﷽ کے اونٹوں کو بھگا کر لے گئے ، نبی ﷽ نے ان کے پیچھے صحابہ رضی اللہ عنہم کو بھیجا ، انہیں پکڑ کر نبی ﷽ کے سامنے پیش کیا گیا ، نبی ﷽ نے ان کے ہاتھ پااں مخالف سمت سے کٹوا دیئے ، ان کی آنکھوں میں سلائیاں پھروا دیں اور انہیں پتھریلے علاقوں میں چھوڑ دیا یہاں تک کہ وہ مر گئے ۔"
"12851","حضرت انس رضی اللہ عنہ سے مروی ہے کہ لوگوں نے نبی ﷽ سے اتنے سوال پوچھے کہ انہیں پریشان کر دیا ، حتی کہ ایک دن نبی ﷽ منبر پر چڑھے اور فرمایا کہ جو شخص کوئی سوال پوچھنا چاہتا ہے وہ پوچھ لے ، بخدا تم مجھ سے جس چیز کے متعلق بھی """" جب تک میں یہاں کھڑا ہوں """" سوال کرو گے ، میں تمہیں ضرور جواب دوں گا ، میں نے دائیں بائیں دیکھا تو ہر شخص ہی اپنے سر پر کپڑا لپیٹ کر رو رہا تھا ، اور نبی ﷽ بار بار یہی فرماتے رہے کہ مجھ سے پوچھو ، چنانچہ ایک آدمی نے کھڑے ہو کر پوچھا یا رسول اللہ ! میں کہاں داخل ہوں گا آ فرمایا جہنم میں ، عبداللہ بن حذافہ رضی اللہ عنہ نے پوچھ لیا یا رسول اللہ ﷽ ! میرا باپ کون ہے آ نبی ﷽ نے فرمایا تمہارا باپ حذافہ ہے ۔ اس پر حضرت عمر رضی اللہ عنہ گھٹنوں کے بل جھک کر کہنے لگے کہ ہم اللہ کو اپنا رب مان کر ، اسلام کو اپنا دین قرار دے کر اور محمد ﷽ کو اپنا نبی مان کر خوش اور مطمئن ہیں ، حضرت عمر رضی اللہ عنہ کی یہ بات سن کر نبی ﷽ خاموش ہو گئے ، تھوڑی دیر بعد فرمایا اس ذات کی قسم جس کے دست قدرت میں میری جان ہے اس دیوار کی چوڑائی میں ابھی میرے سامنے جنت اور جہنم کو پیش کیا گیا تھا ، جب کہ میں نماز پڑھ رہا تھا ، میں نے خیر اور شر میں آج کے دن جیسا کوئی دن نہیں دیکھا ۔"
"12852","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا رکوع و سجود کو مکمل کیا کرو ، کیونکہ میں بخدا تمہیں اپنی پشت کے پیچھے سے بھی دیکھ رہا ہوتا ہوں ۔"
"12853","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا بیماری متعدی ہونے کی اور بدشگونی کی کوئی حیثیت نہیں ، البتہ مجھے فال لینا اچھا لگتا ہے ، کسی نے پوچھا اے اللہ کے نبی ! فال سے کیا مراد ہے آ نبی ﷽ نے فرمایا اچھی بات ۔"
"12854","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک دیہاتی آیا اور کہنے لگا یا رسول اللہ ﷽ ! قیامت کب قائم ہو گی آ نبی ﷽ نے فرمایا تم نے قیامت کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کہ اللہ اور اس کے رسول سے محبت ، نبی ﷽ نے فرمایا کہ تم اس کے ساتھ ہو گے جس سے تم محبت کرتے ہو ، حضرت انس رضی اللہ عنہ کہتے ہیں کہ مسلمان ہونے کے بعد میں نے لوگوں کا اتنا خوش کبھی نہیں دیکھا تھا جتنا اس دن دیکھا ۔"
"12855","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے مجھ سے بیان فرمایا کہ قیامت کے دن میں کھڑا اپنی امت کا انتظار کر رہا ہوں گا تاکہ وہ پل صراط کو عبور کر لے ، کہ اسی اثناء میں میرے پاس حضرت عیسیٰ علیہ السلام آئیں گے اور کہیں گے کہ اے محمد ! ﷽ ، یہ سارے انبیاء + علیہم السلام , اکٹھے ہو کر آپ کے پاس آئے ہیں تاکہ آپ اللہ سے دعاء کر دیں کہ امتوں کی اس بھیڑ کو جہاں چاہے متفرق کر کے ان کے ٹھکانوں میں پہنچا دے کیونکہ لوگ بہت پریشان ہو رہے ہیں ، اس وقت سب لوگ پیسنے کی لگام منہ میں ڈالے ہوں گے ۔ مسلمان پر تو وہ زکام کی طرح ہو گا اور کافر پر موت جیسی کیفیت طاری ہو جائے گی ، نبی ﷽ ان سے فرمائیں گے کہ آپ یہاں میرا انتظار کیجئے ، میں ابھی آپ کے پاس واپس آتا ہوں ، چنانچہ نبی ﷽ جا کر عرش کے نیچے کھڑے ہو جائیں گے ، اور وہ رتبہ آپ کو ملے گا جو کسی منتخب فرشتے اور نبی مرسل کو عطاء نہ ہو گا ، پھر اللہ تعالیٰ حضرت جبریل علیہ السلام کو پیغام دیں گے کہ محمد + ﷽ , کے پاس جاا اور ان سے کہو کہ سر تو اٹھائیے ، سوال تو کیجئے ، عطاء ہو گا ، اور سفارش کیجئے ، قبول ہو گی ، چنانچہ میری امت کے متعلق یہ سفارش قبول ہو گی کہ ہر ننانوے میں سے ایک آدمی جہنم سے نکال لوں ، لیکن میں اپنے رب سے مسلسل اصرار کرتا رہوں گا اور اس وقت تک وہاں سے نہ ہٹوں گا جب تک میری سفارش قبول نہ ہو جائے ، حتیٰ کہ اللہ تعالیٰ مجھے اس سفارش کی قبولیت عطاء فرماتے ہوئے کہے گا کہ اے محمد ! ﷽ ، اللہ نے آپ کی امت میں جتنے لوگ پیدا کیے ہیں ، ان میں سے ہر اس شخص کو جہنم سے نکال لیجئے جس نے ایک دن بھی اخلاص کے ساتھ ®لا الہ الا اللہ¾ کی گواہی دی ہو اور اسی پر فوت ہو گیا ہو ۔"
"12856","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نے نبی ﷽ سے درخواست کی کہ قیامت کے دن میری سفارش فرمائیں ، نبی ﷽ نے فرمایا میں کر دوں گا ، میں نے پوچھا کہ میں قیامت کے دن آپ کو کہاں تلاش کروں آ نبی ﷽ نے فرمایا سب سے پہلے تو مجھے پل صراط پر تلاش کرنا ، میں نے عرض کیا کہ اگر میں آپ کو وہاں نہ پااں تو آ فرمایا پھر میں میزان عمل کے پاس موجود ہوں گا ، میں نے عرض کیا اگر آپ وہاں بھی نہ ملیں تو آ فرمایا پھر میں حوض کوثر پر ہوں گا ، اور قیامت کے دن ان تینوں جگہوں سے آگے پیچھے کہیں نہ جااں گا ۔"
"12857","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے نبی ﷽ کو مخاطب کرتے ہوئے ®یا خیر البریہ¾ کہہ دیا ، نبی ﷽ نے فرمایا کہ وہ تو حضرت ابراہیم علیہ السلام تھے ۔"
"12858","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب مدینہ منورہ تشریف لائے تو پتہ چلا کہ دو دن ایسے ہیں جن میں لوگ زمانہ جاہلیت سے جشن مناتے آ رہے ہیں ، نبی ﷽ نے فرمایا اللہ نے ان دو دنوں کے بدلے میں تمہیں اس سے بہتر دن یوم الفطر اور یوم الاضحی عطاء فرمائے ہیں ۔"
"12859","حمید کہتے ہیں کسی شخص نے حضرت انس رضی اللہ عنہ سے پوچھا کہ کیا نبی ﷽ خضاب لگاتے تھے آ انہوں نے فرمایا کہ نبی ﷽ کی مبارک ڈاڑھی کے اگلے حصے میں صرف سترہ یا بیس بال سفید تھے ، اور ان پر بڑھاپے کا عیب نہیں آیا ، کسی نے پوچھا کہ کیا بڑھاپا عیب ہے آ انہوں نے فرمایا تم میں سے ہر شخص اسے ناپسند سمجھتا ہے ، البتہ حضرت ابوبکر صدیق رضی اللہ عنہ مہندی اور وسمہ کا خضاب لگاتے تھے ، جب کہ حضرت عمر رضی اللہ عنہ صرف مہندی کا خضاب لگاتے تھے ۔"
"12860","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ اپنے گھر میں بیٹھے ہوئے تھے کہ ایک آدمی آ کر کسی سوراخ سے اندر جھانکنے لگا ، نبی ﷽ نے اپنے ہاتھ میں پکڑی ہوئی کنگھی سیدھی کی تو اس نے اپنا سر نکال لیا ۔"
"12861","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دو چتکبرے سینگ دار مینڈھے قربانی میں پیش کیا کرتے تھے ۔"
"12862","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ احد کے دن نبی ﷽ کے اگلے چار دانت ٹوٹ گئے تھے اور آپ ﷽ کی پیشانی پر بھی زخم آیا تھا ، حتیٰ کہ اس کا خون آپ ﷽ کے چہرہ مبارک پر بہنے لگا ، اس پر نبی ﷽ نے فرمایا وہ قوم کیسے فلاح پائے گی جس نے اپنے نبی کے چہرے کو خون سے رنگین کر دیا ، جب کہ وہ انہیں ان کے رب کی طرف بلا رہا ہو آ اس پر یہ آیت نازل ہوئی کہ """" آپ کو کسی قسم کا کوئی اختیار نہیں ہے کہ اللہ ان پر متوجہ ہو جائے ، یا انہیں سزا دے کہ وہ ظالم ہیں ۔"""""
"12863","حمید کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے نبی ﷽ کے نفلی روزوں کے متعلق پوچھا تو انہوں نے فرمایا کہ نبی ﷽ کسی مہینے میں اس تسلسل کے ساتھ روزے رکھتے کہ ہم یہ سوچنے لگتے کہ اب نبی ﷽ کوئی روزہ نہیں چھوڑیں گے اور بعض اوقات روزے چھوڑتے تو ہم کہتے کہ شاید اب نبی ﷽ کوئی روزہ نہیں رکھیں گے ۔"
"12864","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ یہ دعاء فرمایا کرتے تھے اے اللہ ! میں سستی ، بخل اور عذاب قبر سے آپ کی پناہ میں آتا ہوں ۔"
"12865","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ایک مرتبہ میں جنت میں داخل ہوا تو وہاں سونے کا ایک محل نظر آیا ، میں نے پوچھا یہ محل کس کا ہے آ لوگوں نے بتایا کہ یہ ایک قریشی نوجوان کا ہے ، میں سمجھا کہ وہ میں ہی ہوں لیکن لوگوں نے بتایا کہ یہ عمر بن خطاب رضی اللہ عنہ کا ہے ۔"
"12866","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ابوموسیٰ اشعری رضی اللہ عنہ نے نبی ﷽ سے سواری کے لئے کوئی جانور مانگا ، نبی ﷽ اس وقت کسی کام میں مصروف تھے ، اس لئے فرما دیا کہ بخدا ! میں تمہیں کوئی سواری نہیں دوں گا ، لیکن جب وہ پلٹ کر جانے لگے تو انہیں واپس بلایا اور ایک سواری مرحمت فرما دی ، وہ کہنے لگے یا رسول اللہ ﷽ ! آپ نے تو قسم کھائی تھی کہ مجھے کوئی سواری نہیں دیں گے آ فرمایا اب قسم کھا لیتا ہوں کہ تمہیں سواری ضرور دوں گا ۔"
"12867","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ابوموسیٰ اشعری رضی اللہ عنہ نے نبی ﷽ سے سواری کے لئے کوئی جانور مانگا ، نبی ﷽ اس وقت کسی کام میں مصروف تھے ، اس لئے فرما دیا کہ بخدا ! میں تمہیں کوئی سواری نہیں دوں گا ، لیکن جب وہ پلٹ کر جانے لگے تو انہیں واپس بلایا اور ایک سواری مرحمت فرما دی ، وہ کہنے لگے یا رسول اللہ ﷽ ! آپ نے تو قسم کھائی تھی کہ مجھے کوئی سواری نہیں دیں گے آ فرمایا اب قسم کھا لیتا ہوں کہ تمہیں سواری ضرور دوں گا ۔"
"12868","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے سامنے سے ایک جنازہ گزرا ، کسی شخص نے اس کی تعریف کی ، پھر کئی لوگوں نے اس کی تعریف کی ، نبی ﷽ نے فرمایا واجب ہو گئی ، پھر دوسرا جنازہ گزرا اور لوگوں نے اس کی مذمت کی ، ان کی دیکھا دیکھی بہت سے لوگوں نے اس کی مذمت کی ، نبی ﷽ نے فرمایا واجب ہو گئی ، تم لوگ زمین میں اللہ کے گواہ ہو ۔"
"12869","زبیر بن عدی رحمۃ اللہ کہتے ہیں کہ ہم نے حضرت انس رضی اللہ عنہ سے حجاج بن یوسف کے مظالم کی شکایت کی ، انہوں نے فرمایا صبر کرو ، کیونکہ ہر سال یا دن کے بعد آنے والا سال اور دن اس سے بدتر ہو گا ، یہاں تک کہ تم اپنے رب سے جا ملو ، میں نے یہ بات تمہارے نبی ﷽ سے سنی ہے ۔"
"12870","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا وضو کے لئے دو رطل پانی ہی کافی ہے ۔"
"12871","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا سجدوں میں اعتدال برقرار رکھا کرو ، اور تم میں سے کوئی شخص کتے کی طرح اپنے ہاتھ نہ بچھائے ۔"
"12872","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا صفیں سیدھی رکھا کرو کیونکہ صفوں کی درستگی نماز کا حسن ہے ۔"
"12873","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی نماز سب سے زیادہ خفیف اور مکمل ہوتی تھی ۔"
"12874","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اس برتن سے وضو فرما لیتے تھے جس میں دو رطل پانی ہوتا ، اور ایک صاع پانی سے غسل فرما لیتے ۔"
"12875","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے چٹائی پر نماز پڑھی ہے ۔"
"12876","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کے ساتھ اور حضرات خلفاء ثلاثہ رضی اللہ عنہ کے ساتھ نماز پڑھی ہے ، یہ حضرات بلند آواز سے """" بسم اللہ """" نہیں پڑھتے تھے ۔"
"12877","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نماز پڑھ کر دائیں جانب سے واپس جاتے تھے ۔"
"12878","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے منبر پر خطبہ دیا ہے ۔"
"12879","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور حضرت ابوبکر و عمر و عثمان رضی اللہ عنہم تکبیر مکمل کیا کرتے تھے ۔"
"12880","حضرت انس رضی اللہ عنہ سے مروی ہے کہ آپ ﷽ نے ایک مہینے تک فجر کی نماز میں رکوع کے بعد قنوت نازلہ پڑھی اور عرب کے کچھ قبائل پر بددعاء کرتے رہے ۔"
"12881","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مسجد نبوی کی تعمیر کے دوران نبی ﷽ اپنے صحابہ رضی اللہ عنہم کو اینٹیں پکڑاتے جا رہے تھے اور فرماتے جا رہے تھے کہ اصل زندگی تو آخرت کی ہے ، اے اللہ ! انصار اور مہاجرین کی مغفرت فرما ۔"
"12882","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ رات کے وقت اہل مدینہ دشمن کے خوف سے گھبرا اٹھے ، نبی ﷽ نے حضرت ابوطلہ رضی اللہ عنہ کا ایک گھوڑا """" جس کا نام مندوب تھا """" عاریۃَ لیا اور اس پر سوار ہو کر چلے گئے ، تھوڑی دیر بعد واپس آ کر فرمایا گھبرانے کی کوئی بات نہیں اور گھوڑے کے متعلق فرمایا کہ ہم نے اسے سمندر جیسا رواں پایا ۔"
"12883","حضرت انس رضی اللہ عنہ سے مروی ہے کہ فتح مکہ کے دن نبی ﷽ جب مکہ مکرمہ میں داخل ہوئے تو آپ ﷽ نے خود پہن رکھا تھا ۔"
"12884","حضرت انس رضی اللہ عنہ سے مروی ہے صحابہ کرام رضی اللہ عنہم نے نبی ﷽ سے عرض کیا یا رسول اللہ ﷽ ! آپ کا فلاں غلام شہید ہو گیا آ نبی ﷽ نے فرمایا ہرگز نہیں ، میں نے اس پر ایک عباء دیکھی تھی جو اس نے فلاں دن مال غنیمت میں سے خیانت کر کے حاصل کی تھی ۔"
"12885","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوطلحہ رضی اللہ عنہ نے نبی ﷽ سے پوچھا کہ اگر یتیم بچوں کو وراثت میں شراب ملے تو کیا اس کا سرکہ بنایا جا سکتا ہے آ نبی ﷽ نے اس پر ناپسندیدگی کا اظہار فرمایا ۔"
"12886","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے شراب نوشی کی سزا میں ٹہنیوں اور جوتوں سے مارا ہے ، حضرت ابوبکر صدیق رضی اللہ عنہ نے + چالیس کوڑے , مارے ہیں ، لیکن جب حضرت عمر فاروق رضی اللہ عنہ کے دور خلافت میں لوگ مختلف شہروں اور بستیوں کے قریب ہوئے + اور ان میں وہاں کے اثرات آنے لگے , تو حضرت عمر رضی اللہ عنہ نے اپنے ساتھیوں سے پوچھا کہ اس کے متعلق تمہاری کیا رائے ہے آ حضرت عبدالرحمن بن عوف رضی اللہ عنہ نے یہ رائے دی کہ سب سے کم درجے کی حد کے برابر اس کی سزا مقرر کر دیجئے ، چنانچہ حضرت عمر رضی اللہ عنہ نے شراب نوشی کی سزا اسی کوڑے مقرر کر دی ۔"
"12887","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا شب معراج میں ایسے لوگوں کے پاس سے گزرا جن کے منہ آگ کی قینچیوں سے کاٹے جا رہے تھے ، میں نے پوچھا یہ کون لوگ ہیں آ بتایا گیا کہ یہ آپ کی امت کے خطباء ہیں ، جو لوگوں کو نیکی کا حکم دیتے تھے اور اپنے آپ کو بھول جاتے تھے اور کتاب کی تلاوت کرتے تھے ، کیا یہ سمجھتے نہ تھے ۔"
"12888","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قوم کا بھانجا ان ہی میں شمار ہوتا ہے ۔"
"12889","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کے پاس گوشت لایا گیا اور بتایا گیا کہ یہ + حضرت عائشہ رضی اللہ عنہا کی باندی , بریرہ کے پاس صدقہ میں آیا ہے ، تو نبی ﷽ نے فرمایا یہ اس کے لئے صدقہ ہے اور ہمارے لئے ہدیہ ہے ۔"
"12890","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نبی ﷽ نے فرمایا جو میں جانتا ہوں ، اگر تم وہ جانتے ہوتے تو تم بہت تھوڑا ہنستے اور کثرت سے رویا کرتے ۔"
"12891","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے مجھے اپنے کسی کام سے بھیجا ، میں جب واپس آیا تو نبی ﷽ اکڑوں بیٹھ کر کھجوریں تناول فرما رہے تھے ۔"
"12892","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک درزی نے کھانے پر نبی ﷽ کو بلایا ، وہ کھانا لے کر حاضر ہوا تو اس میں پرانا روغن اور کدو تھا ، میں نے دیکھا کہ نبی ﷽ پیالے میں سے کدو تلاش کر رہے ہیں ، اس وقت سے مجھے بھی کدو پسند آنے لگا ۔"
"12893","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے جانور کو باندھ کر اس پر نشانہ درست کرنے سے منع فرمایا ہے ۔"
"12894","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے حضرت عبدالرحمن بن عوف رضی اللہ عنہ اور حضرت زبیر بن عوام رضی اللہ عنہ کو خارش کی وجہ سے ریشمی کپڑے پہننے کی اجازت مرحمت فرما دی ۔"
"12895","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب نبی ﷽ نے رومیوں کو خط لکھنے کا ارادہ کیا تو صحابہ کرام رضی اللہ عنہم نے عرض کیا کہ وہ لوگ صرف مہر شدہ خطوط ہی پڑھتے ہیں ، چنانچہ نبی ﷽ نے چاندی کی انگوٹھی بنوا لی ، اس کی سفیدی اب تک میری نگاہوں کے سامنے ہے ، اس پر یہ عبارت نقش تھی """" محمد رسول اللہ """" ﷽ ۔"
"12896","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوطلحہ رضی اللہ عنہ نے ام سلیم رضی اللہ عنہا سے """" جو کہ حضرت انس رضی اللہ عنہ اور حضرت براء کی والدہ تھیں """" شادی کر لی ، ان کے یہاں ایک بیٹا پیدا ہوا ، حضرت ابوطلحہ رضی اللہ عنہ کو اس سے بڑی محبت تھی ، ایک دن وہ بچہ انتہائی شدید بیمار ہو گیا ، حضرت ابوطلحہ رضی اللہ عنہ کا معمول تھا کہ وہ فجر کی نماز پڑھنے کے لئے اٹھتے تو وضو کر کے بارگاہ نبوت میں حاضر ہوتے اور نبی ﷽ کے ہمراہ نماز ادا کرتے ، نصف النہار کے قریب تک وہیں رہتے ، پھر گھر آ کر قیلولہ کرتے ، کھانا کھاتے اور ظہر کی نماز کے بعد تیار ہو کر چلے جاتے پھر عشاء کے وقت ہی واپس آتے ، ایک دن وہ دوپہر کو گئے ، تو ان کے پیچھے ان کا بیٹا فوت ہو گیا ، ان کی زوجہ حضرت ام سلیم رضی اللہ عنہا نے اسے کپڑا اوڑھا دیا جب حضرت ابوطلحہ رضی اللہ عنہ واپس آئے تو انہوں نے بچے کے بارے پوچھا ، انہوں نے بتایا کہ پہلے سے بہتر ہے ، پھر ان کے سامنے رات کا کھانا لا کر رکھا ، انہوں نے کھانا کھایا ، حضرت ام سلیم رضی اللہ عنہا نے بناا سنگھار کیا ، حضرت ابوطلحہ رضی اللہ عنہ اپنے بستر پر سر رکھ کر لیٹ گئے ، وہ کہتی ہیں کہ میں کھڑی ہو گئی اور خوشبو لگا کر آئی اور ان کے ساتھ بستر پر لیٹ گئی ، جب انہیں خوشبو کی مہک پہنچی تو انہیں وہی خواہش پیدا ہوئی جو ہر مرد کو اپنی بیوی سے ہوتی ہے ، صبح ہوئی تو وہ حسب معمول تیاری کرنے لگے ، حضرت ام سلیم رضی اللہ عنہا نے حضرت ابوطلحہ رضی اللہ عنہ سے کہا کہ اے ابوطلحہ ! اگر کوئی آدمی آپ کے پاس کوئی چیز امانت رکھوائے ، آپ اس سے فائدہ اٹھائیں پھر وہ آپ سے اس کا مطالبہ کرے اور وہ چیز آپ سے لے لے تو کیا اس پر آپ جزع فزع کریں گے ، انہوں نے کہا نہیں ، انہوں نے کہا پھر آپ کا بیٹا فوت ہو گیا ہے ، اس پر وہ سخت ناراض ہوئے اور نبی ﷽ کی خدمت میں حاضر ہوئے ، اور کھانے کا ، خوشبو لگانے کا اور خلوت کا سارا واقعہ بیان کیا ، نبی ﷽ نے فرمایا تعجب ہے کہ وہ بچہ تمہارے پہلو میں پڑا رہا اور تم دونوں نے ایک دوسرے سے خلوت کی ، انہوں نے عرض کیا یا رسول اللہ ! ایسا ہی ہوا ہے ، نبی ﷽ نے فرمایا اللہ تمہاری رات کو مبارک فرمائے ، چنانچہ حضرت ام سلیم رضی اللہ عنہا اسی رات امید سے ہو گئیں ، اور ان کے یہاں لڑکا پیدا ہوا ، صبح ہوئی تو حضرت ابوطلحہ رضی اللہ عنہ نے مجھ سے کہا کہ اسے ایک کپڑے میں لپیٹ کر نبی ﷽ کے پاس لے جاا اور اپنے ساتھ کچھ عجوہ کھجوریں بھی لے جانا ، انہوں نے خود اسے گھٹی دی اور نہ ہی کچھ چکھایا ، میں نے اسے اٹھا کر ایک کپڑے میں لپیٹا اور نبی ﷽ کی خدمت میں حاضر ہو کر عرض کیا یا رسول اللہ ! حضرت ام سلیم رضی اللہ عنہا کے یہاں بچہ پیدا ہوا ہے ، نبی ﷽ نے اللہ اکبر کہہ کر پوچھا کیا پیدا ہوا آ میں نے عرض کیا لڑکا ، نبی ﷽ نے الحمدللہ کہہ کر فرمایا اسے میرے پاس لاا ، میں نے وہ نبی ﷽ کو پکڑا دیا نبی ﷽ نے اسے گھٹی دینے کے لئے پوچھا کہ تمہارے پاس عجوہ کھجوریں ہیں آ میں نے عرض کیا جی ہاں ! اور کجھوریں نکال لیں ، نبی ﷽ نے ایک کھجور لے کر اپنے منہ میں رکھی اور اسے چباتے رہے ، جب وہ لعاب دہن میں مل گئی تو نبی ﷽ نے بچے کو اس سے گھٹی دی ، اسے کھجور کا مزہ آنے لگا اور وہ اسے چوسنے لگا ، گویا اس کی انتڑیوں میں سب سے پہلی چیز جو گئی وہ نبی ﷽ کا لعاب دہن تھا ، اور نبی ﷽ نے فرمایا انصار کو کجھور سے بڑی محبت ہے ، پھر اس کا نام عبداللہ بن ابی طلحہ رکھا ، اس کی نسل خوب چلی اور وہ ایران میں شہید ہوا ۔"
"12897","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت صفیہ رضی اللہ عنہا بنت حیی کو آزاد کر دیا اور ان کی آزادی ہی کو ان کا مہر قرار دے دیا ۔"
"12898","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کسی دعاء میں ہاتھ نہ اٹھاتے تھے ، سوائے استسقاء کے موقع پر کہ اس وقت آپ ﷽ اپنے ہاتھ اتنے بلند فرماتے تھے کہ آپ ﷽ کی مبارک بغلوں کی سفیدی تک دکھائی دیتی ۔"
"12899","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک آدمی سے اسلام قبول کرنے کے لئے فرمایا ، اس نے کہا کہ مجھے پسند نہیں ہے ، نبی ﷽ نے فرمایا پسند نہ بھی ہو تب بھی اسلام قبول کر لو ۔"
"12900","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں حضرت ابوطلحہ رضی اللہ عنہ کے یہاں حضرت ابوعبیدہ بن الجراح رضی اللہ عنہ ، ابی بن کعب رضی اللہ عنہ ، سہیل بن بیضاء رضی اللہ عنہ اور کچھ دیگر صحابہ رضی اللہ عنہم کو حرمت خمر کا حکم نازل ہونے سے پہلے پلایا کرتا تھا ، اور اتنی پلاتا تھا کہ اس کا اثر ان پر نظر آتا تھا ، ایک دن ایک مسلمان آیا اور کہنے لگا کہ کیا آپ لوگوں کو خبر نہیں ہوئی کہ شراب حرام ہو گئی ، انہوں نے یہ سن کر یہ نہیں کہا کہ ٹھہرو ، پہلے تحقیق کرتے ہیں ، بلکہ کہنے لگے انس ! تمہارے برتن میں جتنی شراب ہے سب انڈیل دو ، بخدا ! اس کے بعد وہ کبھی اس کے قریب نہیں گئے ، اور وہ بھی صرف کچی اور پکی کھجور ملا کر بنائی گئی نبیذ تھی ، یہی اس وقت شراب تھی ۔"
"12901","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو حج و عمرہ کا تلبیہ اکٹھے پڑھتے ہوئے سنا ہے کہ آپ ﷽ یوں فرما رہے تھے ®لبیک عمرۃ و حج¾"
"12902","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے اس بات سے منع فرمایا ہے کہ کوئی شخص کھڑے ہو کر پیے میں نے کھانے کا حکم پوچھا تو فرمایا یہ اس سے بھی زیادہ سخت ہے ۔"
"12903","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا تمہارے پاس ایسی قومیں آئیں گی جن کے دل تم سے بھی زیادہ نرم ہوں گے ، چنانچہ ایک مرتبہ اشعریین آئے ، ان میں حضرت ابوموسیٰ اشعری رضی اللہ عنہ بھی شامل تھے ، جب وہ مدینہ منورہ کے قریب پہنچے تو یہ رجزیہ شعر پڑھنے لگے کہ کل ہم اپنے دوستوں یعنی محمد + ﷽ , اور ان کے ساتھیوں سے ملاقات کریں گے ۔"
"12904","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ مسلمانوں نے نبی ﷽ کو بدر کے کنوئیں پر یہ آواز لگاتے ہوئے سنا اے ابوجہل بن ہشام ! اے عتبہ بن ربیعہ ! اے شیبہ بن ربیعہ ! اور اے امیہ بن خلف ! کیا تم سے تمہارے رب نے جو وعدہ کیا تھا ، اسے تم نے سچا پایا آ مجھ سے تو میرے رب نے جو وعدہ کیا تھا ، میں نے اسے سچا پایا ۔ صحابہ رضی اللہ عنہم نے عرض کیا یا رسول اللہ ﷽ ! آپ ان لوگوں کو آواز دے رہے ہیں جو مردہ ہو چکے آ نبی ﷽ نے فرمایا میں جو بات کہہ رہا ہوں ، تم ان سے زیادہ نہیں سن رہے ۔"
"12905","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم لوگ جب غزوہ تبوک سے واپسی پر مدینہ منورہ کے قریب پہنچے تو نبی ﷽ نے فرمایا کہ مدینہ منورہ میں کچھ لوگ ایسے بھی ہیں کہ تم جس راستے پر بھی چلے اور جس وادی کو بھی طے کیا ، وہ اس میں تمہارے ساتھ رہے ، صحابہ رضی اللہ عنہم نے عرض کیا یا رسول اللہ ﷽ ! کیا وہ مدینہ میں ہونے کے باوجود ہمارے ساتھ تھے آ فرمایا ہاں ! مدینہ میں ہونے کے باوجود ، کیونکہ انہیں کسی عذر نے روک رکھا ہے ۔"
"12906","حضرت انس رضی اللہ عنہ سے مروی ہے کہ کسی شخص نے نبی ﷽ سے نماز فجر کا وقت پوچھا تو نبی ﷽ نے حضرت بلال رضی اللہ عنہ کو طلوع فجر کے وقت حکم دیا اور نماز کھڑی کر دی ، پھر اگلے دن خوب روشنی میں کر کے نماز پڑھائی ، اور فرمایا نماز فجر کا وقت پوچھنے والا کہاں ہے آ ان دو وقتوں کے درمیان نماز فجر کا وقت ہے ۔"
"12907","حضرت انس رضی اللہ عنہ سے مروی ہے کہ بنو سلمہ نے ایک مرتبہ یہ ارادہ کیا کہ اپنی پرانی رہائش گاہ سے منتقل ہو کر مسجد کے قریب آ کر سکونت پذیر ہو جائیں ، نبی ﷽ کو یہ بات معلوم ہوئی تو آپ ﷽ کو مدینہ منورہ کا خالی ہونا اچھا نہ لگا ، اس لئے فرمایا اے بنو سلمہ ! کیا تم مسجد کے طرف اٹھنے والے قدموں کا ثواب حاصل کرنا نہیں چاہتے آ"
"12908","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے نماز پڑھاتے ہوئے کسی بچے کے رونے کی آواز سنی اور نماز ہلکی کر دی ، ہم لوگ سمجھ گئے کہ نبی ﷽ نے اس کی ماں کی وجہ سے نماز کو ہلکا کر دیا ہے ، یہ اس بچے پر شفقت کا اظہار تھا ۔"
"12909","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ سے زیادہ کسی کو نماز مکمل اور مختصر کرتے ہوئے نہیں دیکھا ۔"
"12910","[Darussalam 12879] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12911","حمید رحمۃ اللہ کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے پوچھا کیا نبی ﷽ نے انگوٹھی بنوائی تھی آ انہوں نے فرمایا ہاں ! ایک مرتبہ نبی ﷽ نے نماز عشاء کو نصف رات تک موخر کر دیا ، اور فرمایا لوگ نماز پڑھ کر سو گئے لیکن تم نے جتنی دیر تک نماز کا انتظار کیا ، تم نماز ہی میں شمار ہوئے ، اس وقت نبی ﷽ کی انگوٹھی کی سفیدی اب تک میری نگاہوں کے سامنے ہے ۔"
"12912","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کا وقت ہو گیا ، نبی ﷽ ایک آدمی کے ساتھ مسجد میں تنہائی میں گفتگو فرما رہے تھے ، جس وقت آپ ﷽ نماز کے لئے اٹھے تو بعض لوگ اونگھنے لگے تھے ۔"
"12913","حمید کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے نبی ﷽ کی رات کی نماز کے متعلق پوچھا تو انہوں نے فرمایا کہ ہم رات کے جس وقت نبی ﷽ کو نماز پڑھتے ہوئے دیکھنا چاہتے تھے ، دیکھ سکتے تھے اور جس وقت سوتا ہوا دیکھنے کا ارادہ ہوتا تو وہ بھی دیکھ لیتے تھے ۔"
"12914","حضرت انس رضی اللہ عنہ سے کسی شخص نے سینگی لگانے کی اجرت کے متعلق پوچھا تو انہوں نے فرمایا کہ ابوطیبہ نے نبی ﷽ کے سینگی لگائی ، نبی ﷽ نے اسے دو صاع جو دینے کا حکم دیا اور اس کے مالک سے بات کی تو انہوں نے اس پر تخفیف کر دی ۔ اور فرمایا بہترین علاج سینگی لگوانا اور قسط بحری کا استعمال ہے ۔"
"12915","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نماز کھڑی ہوئی تو نبی ﷽ صحابہ کرام رضی اللہ عنہم کی طرف متوجہ ہوئے اور فرمایا صفیں سیدھی کر لو اور جڑ کر کھڑے ہو کیونکہ میں تمہیں اپنے پیچھے سے بھی دیکھتا ہوں ۔"
"12916","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے انصار کو بلایا تاکہ بحرین سے آئے ہوئے مال کا حصہ انہیں تقسیم کر دیں ، لیکن وہ کہنے لگے کہ پہلے ہمارے مہاجر بھائیوں کا ہمارے برابر کا حصہ الگ کیجئے ، نبی ﷽ نے ان کے جذبہ ایثار کو دیکھ کر فرمایا میرے بعد تمہیں ترجیحات کا سامنا کرنا پڑے گا ، لیکن تم صبر کرنا تاآنکہ مجھ سے آ ملو ۔"
"12917","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مجھ سے نبی ﷽ کا یہ فرمان بیان کیا گیا ہے لیکن میں نے اسے خود نہیں سنا کہ تم میں ایک قوم ایسی آئے گی جو عبادت کرے گی اور دینداری پر ہو گی ، حتیٰ کہ لوگ ان کی کثرت عبادت پر تعجب کیا کریں گے اور وہ خود بھی خود پسندی میں مبتلا ہوں گے ، وہ لوگ دین سے اس طرح نکل جائیں گے جیسے تیر شکار سے نکل جاتا ہے ۔"
"12918","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور خلفاء ثلاثہ رضی اللہ عنہم نماز میں قراءت کا آغاز ®الحمدللہ رب العلمین¾ سے کرتے تھے ۔"
"12919","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں ایک دن کھڑا لوگوں کو فصیخ پلا رہا تھا کہ ایک شخص آیا اور کہنے لگا کہ شراب حرام ہو گئی ، وہ کہنے لگے انس ! تمہارے برتن میں جتنی شراب ہے سب انڈیل دو ، راوی نے ان سے شراب کی تفتیش کی تو فرمایا کہ وہ تو صرف کچی اور پکی کھجور ملا کر بنائی گئی نبیذ تھی ۔"
"12920","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ایک آدمی کو اپنے دو بیٹوں کے کندھوں کا سہارا لے کر چلتے ہوئے دیکھا تو پوچھا یہ کیا ماجرا ہے آ انہوں نے بتایا کہ انہوں نے پیدل چل کر حج کرنے کی منت مانی تھی ، نبی ﷽ نے فرمایا اللہ اس بات سے غنی ہے کہ یہ شخص اپنے آپ کو تکلیف میں مبتلا کرے ، پھر آپ ﷽ نے اسے سوار ہونے کا حکم دیا ، چنانچہ وہ سوار ہو گیا ۔"
"12921","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا مسجد میں تھوکنا گناہ ہے اور اس کا کفارہ اسے دفن کر دینا ہے ۔"
"12922","[Darussalam 12891] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12923","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کا گذر ایک آدمی پر ہوا جو قربانی کا جانور ہانکتے ہوئے چلا جا رہا تھا ، نبی ﷽ نے اس سے سوار ہونے کے لئے فرمایا ، اس نے کہا کہ یہ قربانی کا جانور ہے ، نبی ﷽ نے فرمایا کہ اگرچہ قربانی کا جانور ہی ہو ۔"
"12924","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے قربانی کرتے ہوئے اللہ کا نام لے کر تکبیر کہی ۔"
"12925","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دو چتکبرے سینگ دار مینڈھے قربانی میں پیش کیا کرتے تھے ، اور اللہ کا نام لے کر تکبیر کہتے تھے ، میں نے دیکھا ہے کہ نبی ﷽ انہیں اپنے ہاتھ سے ذبح کرتے تھے اور ان کے پہلو پر اپنا پااں رکھتے تھے ۔"
"12926","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک یہودی نے ایک انصاری بچی کو اس زیور کی خاطر قتل کر دیا جو اس نے پہن رکھا تھا ، اور پتھر مار مار کر اس کا سر کچل دیا ، نبی ﷽ نے بھی قصاصاَ اس کا سر دو پتھروں کے درمیان کچل دیا ۔"
"12927","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کا گذر ہم بچوں پر ہوا ، جو کھیل رہے تھے ، نبی ﷽ نے فرمایا بچو ! """" السلام علیکم """" ۔"
"12928","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا میری امت کے کچھ لوگ جہنم میں داخل کیے جائیں گے ، جب وہ جل کر کوئلہ ہو جائیں گے تو انہیں جنت میں داخل کر دیا جائے گا ، اور اہل جنت کہیں گے کہ یہ جہنمی ہیں ۔"
"12929","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حج و عمرہ کا تلبیہ اکٹھے پڑھتے ہوئے یوں فرمایا ®لبیک بحجۃ و عمرۃ معا¾ ۔"
"12930","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حج و عمرہ کا تلبیہ اکٹھا پڑھا ۔"
"12931","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم لوگ ایک انصاری کے گھر میں تھے ، نبی ﷽ آئے اور کھڑے ہو کر دروازے کے کواڑ پکڑ لیے ، اور فرمایا امراء قریش میں سے ہوں گے ، اور ان کا تم پر حق بنتا ہے ، اور ان پر تمہارا بھی اسی طرح حق بنتا ہے ، جب لوگ ان سے رحم کی درخواست کریں تو وہ ان سے رحم کا معاملہ کریں ، وعدہ کریں تو پورا کریں ، فیصلہ کریں تو انصاف کریں ، جو شخص ایسا نہ کرے اس پر اللہ کی ، فرشتوں اور تمام لوگوں کی لعنت ہے ۔"
"12932","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کا گذر حضرت سعد رضی اللہ عنہ پر ہوا ، وہ دو انگلیوں سے اشارہ کرتے ہوئے دعاء کر رہے تھے ، نبی ﷽ نے فرمایا سعد ! ایک انگلی رکھو ۔"
"12933","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اگر تم میں سے کسی پر قیامت قائم ہو جائے اور اس کے ہاتھ میں کھجور کا پودا ہو ، تب بھی اسے چاہئے کہ اسے گاڑ دے ۔"
"12934","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اپنے ہاتھ اتنے بلند فرماتے کہ آپ ﷽ کی مبارک بغلوں کی سفیدی تک دکھائی دیتی ۔"
"12935","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا میری امت میں سے میری امت پر سب سے زیادہ مہربان ابوبکر رضی اللہ عنہ ہیں ، دین کے معاملے میں سب سے زیادہ سخت عمر رضی اللہ عنہ ہیں ، سب سے زیادہ سچی حیاء والے عثمان رضی اللہ عنہ ہیں ، حلال و حرام کے سب سے بڑے عالم معاذ بن جبل رضی اللہ عنہ ہیں ، کتاب اللہ کے سب سے بڑے قاری ابی بن کعب رضی اللہ عنہ ہیں ، علم وراثت کے سب سے بڑے عالم زید بن ثابت رضی اللہ عنہ ہیں ، اور ہر امت کا امین ہوتا ہے ، اس امت کے امین ابوعبیدہ بن الجراح رضی اللہ عنہ ہیں ۔"
"12936","قتادہ رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ نبی ﷽ کو کون سا لباس پسند تھا آ انہوں نے فرمایا دھاری دار یمنی چادر ۔"
"12937","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا مجھے تو مسلمان پر تعجب ہوتا ہے کہ اللہ اس کے لئے جو فیصلہ بھی فرماتا ہے وہ اس کے حق میں بہتر ہی ہوتا ہے ۔"
"12938","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے نبی ﷽ کو مخاطب کرتے ہوئے ®یا خیر البریہ¾ کہہ دیا ، نبی ﷽ نے فرمایا کہ وہ تو حضرت ابراہیم علیہ السلام تھے ۔"
"12939","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے نبی ﷽ کو مخاطب کرتے ہوئے ®یا خیر البریہ¾ کہہ دیا ، نبی ﷽ نے فرمایا کہ وہ تو حضرت ابراہیم علیہ السلام تھے ۔"
"12940","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جو شخص نماز پڑھنا بھول جائے یا سو جائے ، تو اس کا کفارہ یہی ہے کہ جب یاد آئے ، اسے پڑھ لے کیونکہ اللہ تعالیٰ فرماتا ہے """" میری یاد کے لئے نماز قائم کیجئے """"۔ اور فرمایا کہ نبی ﷽ جب کسی غزوے پر روانہ ہوتے تو فرماتے اے اللہ ! تو ہی میرا بازو ہے ، تو ہی میرا مددگار ہے ، اور تیرے ذریعے ہی میں قتال کرتا ہوں ۔"
"12941","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے لئے ایک چٹائی کے کونے پر پانی چھڑک دیا گیا ، نبی ﷽ نے وہاں دو رکعتیں پڑھ دیں ، ایک آدمی نے یہ سن کر حضرت انس رضی اللہ عنہ سے پوچھا کیا نبی ﷽ چاشت کی نماز پڑھتے تھے آ انہوں نے فرمایا کہ میں نے نبی ﷽ کو وہ نماز صرف اسی دن پڑھتے ہوئے دیکھا تھا ۔"
"12942","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک مہینہ تک رکوع کے بعد قنوت نازلہ پڑھی ہے ۔"
"12943","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ عصر کی نماز اس وقت پڑھتے تھے جب سورج روشن اور اپنے حلقے کی شکل میں ہوتا تھا ، میں مدینہ منورہ کے ایک کونے میں واقع اپنے محلے اور گھر میں پہنچتا اور ان سے کہتا کہ نبی ﷽ نماز پڑھ چکے ہیں ، لہٰذا تم بھی اٹھ کر نماز پڑھ لو ۔"
"12944","حضرت انس رضی اللہ عنہ سے مروی ہے کہ بعض اوقات نبی ﷽ کو راستے میں ایک کجھور پڑی ہوئی ملتی تو نبی ﷽ فرماتے اگر مجھے یہ اندیشہ نہ ہوتا کہ یہ صدقہ کی ہو گی تو میں اسے کھا لیتا ۔"
"12945","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت ام حرام رضی اللہ عنہا کے گھر میں بستر پر نماز پڑھی ۔"
"12946","حضرت عبدالرحمن بن ابی لیلی رضی اللہ عنہ سے مروی ہے کہ رسول اللہ ﷽ ایک مرتبہ مسجد میں داخل ہوئے تو دیکھا کہ دو ستونوں کے درمیان ایک رسی لٹک رہی ہے ، پوچھا یہ کیسی رسی ہے آ لوگوں نے بتایا کہ یہ حمنہ بنت حجش کی رسی ہے ، نماز پڑھتے ہوئے جب انہیں سستی یا تھکاوٹ محسوس ہوتی ہے تو وہ اس کے ساتھ اپنے آپ کو باندھ لیتی ہیں ، نبی ﷽ نے فرمایا جب تم میں سے کوئی شخص نماز پڑھے تو نشاط کی کیفیت برقرار رہنے تک پڑھے اور جب سستی یا تھکاوٹ محسوس ہو تو رک جائے ۔"
"12947","[Darussalam 12916] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12948","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک انصاری آدمی بڑا بھاری بھرکم تھا ، وہ نبی ﷽ کے ساتھ نماز پڑھنے کے لئے بار بار نہیں آ سکتا تھا ، اس نے نبی ﷽ سے عرض کیا کہ میں بار بار آپ کے ساتھ آ کر نماز پڑھنے کی طاقت نہیں رکھتا ، اگر آپ کسی دن میرے گھر تشریف لا کر کسی جگہ نماز پڑھ دیں تو میں وہیں پر نماز پڑھ لیا کروں گا ، چنانچہ اس نے ایک مرتبہ دعوت کا اہتمام کر کے نبی ﷽ کو بلایا ، اور ایک چٹائی کے کونے پر پانی چھڑک دیا ، نبی ﷽ نے وہاں دو رکعتیں پڑھ دیں ، آل جارود میں سے ایک آدمی نے یہ سن کر حضرت انس رضی اللہ عنہ سے پوچھا کیا نبی ﷽ چاشت کی نماز پڑھتے تھے آ انہوں نے فرمایا کہ میں نے نبی ﷽ کو وہ نماز صرف اسی دن پڑھتے ہوئے دیکھا تھا ۔"
"12949","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کے پاس رات کو صحابہ رضی اللہ عنہم حاضر ہوئے ، نبی ﷽ باہر تشریف لائے ، اور مختصر سی نماز پڑھا کر چلے گئے ، کافی دیر گزرنے کے بعد دوبارہ آئے اور مختصر سی نماز پڑھا کر دوبارہ واپس چلے گئے اور کافی دیر تک اندر رہے ، جب صبح ہوئی تو صحابہ رضی اللہ عنہم نے عرض کیا اے اللہ کے نبی ! ہم آج رات بیٹھے ہوئے تھے ، آپ تشریف لائے اور مختصر سی نماز پڑھائی اور کافی دیر تک کے لئے گھر میں چلے گئے آ نبی ﷽ نے فرمایا میں نے تمہاری وجہ سے ہی ایسا کیا تھا ۔"
"12950","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک مرتبہ حضرت ابی بن کعب رضی اللہ عنہ سے فرمایا کہ اللہ نے مجھے حکم دیا ہے کہ تمہیں قرآن پڑھ کر سنااں ، حضرت ابی بن کعب رضی اللہ عنہ نے عرض کیا کہ کیا اللہ نے میرا نام لے کر کہا ہے آ نبی ﷽ نے فرمایا ہاں ! یہ سن کر حضرت ابی بن کعب رضی اللہ عنہ رو پڑے ۔"
"12951","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی مبارک ڈاڑھی میں بیس بال بھی سفید نہ تھے ۔"
"12952","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کی بیعت بات سننے اور ماننے کی شرط پر کی تھی اور نبی ﷽ نے اس میں """" حسب طاقت """" کی قید لگا دی تھی ۔"
"12953","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ تمام لوگوں میں سب سے زیادہ خوبصورت ، سخی اور بہادر تھے ، ایک مرتبہ رات کے وقت اہل مدینہ دشمن کے خوف سے گھبرا اٹھے ، اور اس آواز کے رخ پر چل پڑے ، دیکھا تو نبی ﷽ واپس چلے آ رہے ہیں اور حضرت ابوطلحہ رضی اللہ عنہ کے بے زین گھوڑے پر سوار ہیں ، گردن میں تلوار لٹکا رکھی ہے اور لوگوں سے کہتے جا رہے ہیں کہ گھبرانے کی کوئی بات نہیں ، مت گھبراا اور گھوڑے کے متعلق فرمایا کہ ہم نے اسے سمندر جیسا رواں پایا ۔"
"12954","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ تین سانسوں میں پانی پیتے تھے اور فرماتے تھے کہ یہ طریقہ زیادہ آسان ، خوشگوار اور مفید ہے ۔"
"12955","حضرت انس رضی اللہ عنہ کے حوالے سے مروی ہے کہ حضرت انس رضی اللہ عنہ تین سانس میں پانی پیتے تھے ۔"
"12956","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کبھی کبھار اپنی تمام ازواج مطہرات کے پاس ایک ہی رات میں ایک ہی غسل سے چلے جایا کرتے تھے ۔"
"12957","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کبھی کبھار اپنی تمام ازواج مطہرات کے پاس ایک ہی رات میں ایک ہی غسل سے چلے جایا کرتے تھے ۔"
"12958","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت علی کرم اللہ وجہ جب یمن سے واپس آئے تو نبی ﷽ نے ان سے پوچھا کہ تم نے کس نیت سے احرام باندھا آ انہوں نے عرض کیا اس نیت سے احرام باندھا کہ نبی ﷽ نے جس کی نیت کی ہو ، میرا بھی وہی احرام ہے ، نبی ﷽ نے فرمایا اگر میں اپنے ساتھ ہدی کا جانور نہ لایا ہوتا تو حلال ہو چکا ہوتا ۔"
"12959","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جنت میں ایک درخت ایسا بھی ہے جس کے سائے میں اگر کوئی سوار سو سال تک چلتا رہے تب بھی اس کا سایہ ختم نہ ہو ۔"
"12960","علاء ابن عبدالرحمن رحمۃ اللہ کہتے ہیں کہ ایک دفعہ ہم ظہر کی نماز پڑھ کر حضرت انس رضی اللہ عنہ کی خدمت میں حاضر ہوئے ، کچھ ہی دیر بعد وہ عصر کی نماز پڑھنے کھڑے ہو گئے ، جب وہ نماز سے فارغ ہوئے تو ہم نے ان سے کہا کہ عصر کی نماز اتنی جلدی آ انہوں نے فرمایا کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے وہ منافق کی نماز ہے کہ منافق نماز کو چھوڑے رکھتا ہے ، حتیٰ کہ جب سورج شیطان کے دو سینگوں کے درمیان آ جاتا ہے تو وہ نماز پڑھنے کھڑا ہوتا ہے اور چار ٹھونگیں مار کر اس میں اللہ کو بہت تھوڑا یاد کرتا ہے ۔"
"12961","حضرت انس رضی اللہ عنہ سے بحوالہ عبادہ بن صامت رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا مسلمان کا خواب اجزاء نبوت میں سے چھیالیسواں جزو ہوتا ہے ۔"
"12962","[Darussalam 12931] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"12963","حضرت انس رضی اللہ عنہ سے مروی ہے کہ فتح مکہ کے دن نبی ﷽ جب مکہ مکرمہ میں داخل ہوئے تو آپ ﷽ نے خود پہن رکھا تھا ، کسی شخص نے آ کر بتایا کہ ابن خطل خانہ کعبہ کے پردوں کے ساتھ چمٹا ہوا ہے ، نبی ﷽ نے فرمایا پھر بھی اسے قتل کر دو ، ام مالک رحمۃ اللہ فرماتے ہیں کہ اس دن نبی ﷽ حالت احرام میں نہ تھے ۔"
"12964","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت صفیہ رضی اللہ عنہا کو آزاد کر کے ان سے نکاح کر لیا ۔ راوی نے حضرت انس رضی اللہ عنہ سے پوچھا اے ابوحمزہ ! نبی ﷽ نے انہیں کتنا مہر دیا تھا آ انہوں نے فرمایا کہ نبی ﷽ نے ان کی آزادی ہی کو ان کا مہر قرار دے کر ان سے نکاح کیا تھا ۔"
"12965","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے مدینہ منورہ میں ظہر کی چار رکعتیں اور ذوالحلیفہ میں عصر کی دو رکعتیں پڑھی ہیں ۔"
"12966","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی """" جس کا نام انجشہ تھا """" امہات المومنین کی سواریوں کو ہانک رہا تھا ، نبی ﷽ اپنی ازواج مطہرات کے پاس آئے تو فرمایا انجشہ ! ان آبگینوں کو آہستہ لے کر چلو ۔"
"12967","حضرت انس رضی اللہ عنہ سے مروی ہے کہ قبیلہ عکل کے آٹھ آدمی نبی ﷽ کے پاس آ کر مسلمان ہو گئے ، لیکن انہیں مدینہ منورہ کی آب و ہوا موافق نہ آئی ، نبی ﷽ نے ان سے فرمایا کہ اگر تم ہمارے اونٹوں کے پاس جا کر ان کا دودھ اور پیشاب پیو تو شاید تندرست ہو جاا ، چنانچہ انہوں نے ایسا ہی کیا ، لیکن جب وہ صحیح ہو گئے تو دوبارہ مرتد ہو کر کفر کی طرف لوٹ گئے ، نبی ﷽ کے مسلمان چرواہے کو قتل کر دیا ، اور نبی ﷽ کے اونٹوں کو بھگا کر لے گئے ، نبی ﷽ نے ان کے پیچھے صحابہ رضی اللہ عنہم کو بھیجا ، انہیں پکڑ کر نبی ﷽ کے سامنے پیش کیا گیا ، نبی ﷽ نے ان کے ہاتھ پااں مخالف سمت سے کٹوا دیئے ، ان کی آنکھوں میں سلائیاں پھروا دیں اور انہیں پتھریلے علاقوں میں چھوڑ دیا یہاں تک کہ وہ مر گئے ۔"
"12968","حضرت انس رضی اللہ عنہ سے ایک مرتبہ کسی نے لہسن کے متعلق دریافت کیا تو انہوں نے جواب دیا کہ نبی ﷽ نے فرمایا جو شخص اس درخت میں سے کچھ کھائے ، وہ ہمارے قریب نہ آئے ، یا ہمارے ساتھ نماز نہ پڑھے ۔"
"12969","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ کچھ لوگ ایک جنازہ لے کر گذرے ، لوگوں نے اس کی تعریف کی ، نبی ﷽ نے تین مرتبہ فرمایا واجب ہو گئی ، تھوڑی دیر بعد ایک دوسرا جنازہ گذرا اور لوگوں نے اس کی مذمت بیان کی ، نبی ﷽ نے پھر تین مرتبہ فرمایا واجب ہو گئی ، حضرت عمر رضی اللہ عنہ نے عرض کیا کہ میرے ماں باپ آپ پر قربان ہوں ، پہلا جنازہ گذرا اور لوگوں نے اس کی تعریف کی تب بھی آپ نے تینوں مرتبہ فرمایا واجب ہو گئی اور جب دوسرا جنازہ گذرا اور لوگوں نے اس کی مذمت بیان کی تب بھی آپ نے تین مرتبہ فرمایا واجب ہو گئی آ نبی ﷽ نے ارشاد فرمایا تم لوگ جس کی تعریف کر دو ، اس کے لئے جنت واجب ہو گئی اور جس کی مذمت بیان کر دو ، اس کے لئے جہنم واجب ہو گئی ، پھر تین مرتبہ فرمایا کہ تم لوگ زمین میں اللہ کے گواہ ہو ۔"
"12970","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے سامنے سے ایک جنازہ گذرا ، لوگوں نے اس کی تعریف کی ، نبی ﷽ نے فرمایا واجب ہو گئی ، پھر دوسرا جنازہ گذرا اور لوگوں نے اس کی مذمت کی ، نبی ﷽ نے فرمایا واجب ہو گئی ، لوگوں نے عرض کیا کہ آپ نے دونوں کے لئے """" واجب ہو گئی """" فرمایا ، اس کی کیا وجہ ہے آ نبی ﷽ نے فرمایا یہ قوم کی گواہی ہے اور مسلمان زمین میں اللہ کے گواہ ہیں ۔"
"12971","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے خیبر میں فجر کی نماز منہ اندھیرے پڑھی ، اور اللہ اکبر کہہ کر فرمایا خیبر برباد ہو گیا ، جب ہم کسی قوم کے صحن میں اترتے ہیں تو ڈرائے ہوئے لوگوں کی صبح بڑی بدترین ہوتی ہے ، لوگ اس وقت کام پر نکلے ہوئے تھے ، وہ کہنے لگے کہ محمد اور لشکر آ گئے ، پھر نبی ﷽ نے خیبر کو فتح کر لیا ، ان کے لڑاکا افراد کو قتل اور بچوں کو قیدی بنا لیا ، حضرت صفیہ رضی اللہ عنہ ، حضرت دحیہ رضی اللہ عنہا کے حصے میں آ گئیں ، بعد میں وہ نبی ﷽ کے پاس آ گئیں اور نبی ﷽ نے انہیں آزاد کر کے ان سے نکاح کر لیا اور ان کی آزادی ہی کو ان کا مہر قرار دے دیا ۔"
"12972","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے اپنے لیے چاندی کی ایک انگوٹھی بنوائی اور فرمایا کہ ہم نے ایک انگوٹھی بنوائی ہے اور اس پر ایک عبارت محمد رسول اللہ نقش کروائی ہے ، لہٰذا کوئی شخص اپنی انگوٹھی پر یہ عبارت نقش نہ کروائے ۔"
"12973","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے مردوں کو زعفران کی خوشبو لگانے سے منع فرمایا ہے ۔"
"12974","حضرت انس رضی اللہ عنہ سے مروی ہے کہ کسی شخص نے بارگاہ نبوت میں عرض کیا یا رسول اللہ ﷽ ! ہم لوگ امر بالمعروف اور نہی عن المنکر کب چھوڑیں گے آ فرمایا جب تم میں وہ چیزیں ظاہر ہو جائیں جو بنی اسرائیل میں در آئی تھیں ، جب بے حیائی بڑوں میں اور حکومت چھوٹوں میں اور علم کمینوں میں آ جائے ۔"
"12975","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ سفر پر تھے اور حدی خوان امہات المومنین کی سواریوں کو ہانک رہا تھا ، اس نے جانوروں کو تیزی سے ہانکنا شروع کر دیا ، اس پر نبی ﷽ نے ہنستے ہوئے فرمایا انجشہ ! ان آبگینوں کو آہستہ لے کر چلو ۔"
"12976","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ہم لوگ نبی ﷽ کے ساتھ مدینہ منورہ سے نکلے ، نبی ﷽ واپسی تک دو دو رکعتیں پڑھتے رہے ، راوی کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ نبی ﷽ نے اس سفر میں کتنے دن قیام فرمایا تھا آ انہوں نے بتایا دس دن ۔"
"12977","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم لوگ نبی ﷽ کے ساتھ مکہ مکرمہ روانہ ہوئے ، میں نے نبی ﷽ کو حج و عمرہ کا تلبیہ اکٹھے پڑھتے ہوئے سنا کہ آپ ﷽ یوں فرما رہے تھے ®لبیک عمرۃ و حجا¾"
"12978","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں اور حضرت ابوطلحہ رضی اللہ عنہ خیبر سے واپس آ رہے تھے ، نبی ﷽ کے پیچھے حضرت صفیہ رضی اللہ عنہا سوار تھیں ، ایک مقام پر نبی ﷽ کی اونٹنی پھسل گئی ، نبی ﷽ اور حضرت صفیہ رضی اللہ عنہا گر گئے ، حضرت ابوطلحہ رضی اللہ عنہ تیزی سے وہاں پہنچے اور کہنے لگے یا رسول اللہ ﷽ ! اللہ مجھے آپ پر قربان کرے ، کوئی چوٹ تو نہیں آئی آ نبی ﷽ نے فرمایا نہیں ، خاتون کی خبر لو ، چنانچہ حضرت ابوطلحہ رضی اللہ عنہ اپنے چہرے پر کپڑا ڈال کر ان کے پاس پہنچے اور حضرت صفیہ رضی اللہ عنہا پر کپڑا ڈال دیا ، اس کے بعد سواری کو دوبارہ تیار کیا ، پھر ہم سب سوار ہو گئے اور ہم میں سے ایک نے دائیں جانب سے اور دوسرے نے بائیں جانب سے اسے اپنے گھیرے میں لے لیا ، جب ہم لوگ مدینہ منورہ کے قریب پہنچے یا پتھریلے علاقوں کی پشت پر پہنچے تو نبی ﷽ نے فرمایا ہم اللہ کی عبادت کرتے ہوئے ، توبہ کرتے ہوئے ، اور اپنے رب کی تعریف کرتے ہوئے واپس آئے ہیں ، نبی ﷽ مسلسل یہ جملے کہتے رہے تاآنکہ ہم مدینہ منورہ میں داخل ہو گئے ۔"
"12979","حجاج بن حسان رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ ہم لوگ حضرت انس رضی اللہ عنہ کے پاس بیٹھے ہوئے تھے ، اسی اثناء میں انہوں نے ایک برتن منگوایا جس میں لوہے کے تین ٹکڑے اور ایک حلقہ لگا ہوا تھا ، انہوں نے وہ برتن ایک کالے غلاف سے نکالا تھا ، جو چوتھائی سے کم اور نصف چوتھائی سے کچھ زیادہ تھا ، حضرت انس رضی اللہ عنہ کے حکم پر اس میں ہمارے لیے پانی ڈالا گیا ، ہم نے وہ پانی نوش کیا اور اپنے سر اور چہروں پر ڈالا ، اور نبی ﷽ پر درود و سلام پڑھا ۔"
"12980","حمید رحمۃ اللہ کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے دریافت کیا کہ کیا نبی ﷽ دعاء میں ہاتھ اٹھاتے تھے آ تو انہوں نے فرمایا کہ ایک مرتبہ جمعہ کے دن نبی ﷽ سے لوگوں نے عرض کیا کہ یا رسول اللہ ﷽ ! بارش رکی ہوئی ہے ، زمینیں خشک پڑی ہیں اور مال تباہ ہو رہے ہیں آ نبی ﷽ نے یہ سن کر اپنے ہاتھ اتنے بلند کیے کہ مجھے آپ ﷽ کی مبارک بغلوں کی سفیدی نظر آنے لگی ، اور نبی ﷽ نے طلب باراں کے حوالے سے دعاء فرمائی ، جس وقت آپ ﷽ نے اپنے دست مبارک بلند کیے تھے ، اس وقت ہمیں آسمان پر کوئی بادل نظر نہیں آ رہا تھا ، اور جب نماز سے فارغ ہوئے تو قریب کے گھر میں رہنے والے نوجوانوں کو اپنے گھر واپس پہنچنے میں دشواری ہو رہی تھی ، جب اگلا جمعہ ہوا تو لوگوں نے عرض کیا یا رسول اللہ ﷽ ! گھروں کی عمارتیں گر گئیں اور سوار مدینہ سے باہر ہی رکنے پر مجبور ہو گئے ، یہ سن کر نبی ﷽ نے اللہ سے دعاء کی کہ اے اللہ ! یہ بارش ہمارے اردگرد فرما ، ہم پر نہ برسا ، چنانچہ مدینہ سے بارش چھٹ گئی ۔"
"12981","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ باہر نکلے تو انصار سے ملاقات ہو گئی ، نبی ﷽ نے فرمایا اس ذات کی قسم جس کے دست قدرت میں محمد ﷽ کی جان ہے ، میں تم سے محبت کرتا ہوں ، تم انصار کے نیکوں کی نیکی قبول کرو ، اور ان کے گناہگار سے تجاوز اور درگذر کرو ، کیونکہ انہوں نے اپنا فرض نبھا دیا اور ان کا حق باقی رہ گیا ۔"
"12982","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ سردی کے ایک دن باہر نکلے تو دیکھا کہ مہاجرین و انصار خندق کھود رہے ہیں ، نبی ﷽ نے فرمایا اے اللہ ! اصل خیر آخرت ہی کی خیر ہے ، پس انصار اور مہاجرین کو معاف فرما ، صحابہ رضی اللہ عنہم نے جواباَ یہ شعر پڑھا کہ """" ہم ہی وہ لوگ ہیں جنہوں نے محمد ﷽ سے جہاد پر بیعت کی ہے جب تک ہم زندہ ہیں """"۔"
"12983","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ حنین کے موقع پر اللہ نے جب بنو ہوازن کا مال غنیمت نبی ﷽ کو عطاء فرمایا اور نبی ﷽ عیینہ اور اقرع وغیرہ ایک ایک آدمی کو سو سو اونٹ دینے لگے تو انصار کے کچھ لوگ کہنے لگے نبی ﷽ قریش کو دیئے جا رہے ہیں اور ہمیں نظر انداز کر رہے ہیں جب کہ ہماری تلواروں سے ابھی تک خون کے قطرے ٹپک رہے ہیں ۔ نبی ﷽ کو یہ بات معلوم ہوئی تو آپ ﷽ نے انصاری صحابہ رضی اللہ عنہم کو بلا بھیجا اور فرمایا اے گروہ انصار ! کیا تم لوگ اس بات پر خوش نہیں ہو کہ لوگ مال و دولت لے کر چلے جائیں اور تم پیغمبر خدا کو اپنے خیموں میں لے جاا ، وہ کہنے لگے کیوں نہیں یا رسول اللہ ، پھر نبی ﷽ نے فرمایا اس ذات کی قسم جس کے دست قدرت میں محمد ﷽ کی جان ہے ، اگر لوگ ایک وادی میں چل رہے ہوں اور انصار دوسری گھاٹی میں تو میں انصار کے راستے کو اختیار کروں گا ، انصار میرا پردہ ہیں ، اور اگر ہجرت نہ ہوتی تو میں انصار ہی کا ایک فرد ہوتا ۔"
"12984","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ حضرت ام سلیم رضی اللہ عنہا کے یہاں تشریف لائے ، انہوں نے نبی ﷽ کے سامنے کھجوریں اور گھی پیش کیا ، نبی ﷽ اس دن روزے سے تھے اس لئے فرمایا کہ کھجوریں اس کے برتن میں اور گھی اس کی بالٹی میں ڈال دو ، پھر گھر کے ایک کونے میں کھڑے ہو کر آپ ﷽ نے دو رکعت نماز پڑھی ، ہم نے بھی نبی ﷽ کے ساتھ نماز پڑھی ، پھر نبی ﷽ نے حضرت ام سلیم رضی اللہ عنہا اور ان کے اہل خانہ کے لئے دعاء فرمائی ، حضرت ام سلیم رضی اللہ عنہا نے عرض کیا یا رسول اللہ ﷽ ! میری ایک خاص چیز بھی ہے ، نبی ﷽ نے پوچھا وہ کیا ہے آ عرض کیا آپ کا خادم انس ، اس پر نبی ﷽ نے دنیا و آخرت کی کوئی خیر ایسی نہ چھوڑی جو میرے لیے نہ مانگی ہو ، اور فرمایا اے اللہ ! اسے مال اور اولاد عطاء فرما اور ان میں برکت عطاء فرما ، وہ خود کہتے ہیں کہ مجھے میری بیٹی نے بتایا ہے کہ میری نسل میں سے ایک سو بیس سے زائد آدمی فوت ہو کر دفن ہو چکے ہیں اور میں مال و دولت میں تمام انصار سے بڑھ کر ہوں ۔"
"12985","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب بدر کی طرف روانہ ہو گئے تو لوگوں سے مشورہ کیا ، اس کے جواب میں حضرت ابوبکر صدیق رضی اللہ عنہ نے ایک مشورہ دیا ، پھر دوبارہ مشورہ مانگا تو حضرت عمر رضی اللہ عنہ نے ایک مشورہ دے دیا ، یہ دیکھ کر نبی ﷽ خاموش ہو گئے ، ایک انصاری نے کہا کہ نبی ﷽ تم سے مشورہ لینا چاہ رہے ہیں ، اس پر انصاری صحابہ رضی اللہ عنہم کہنے لگے یا رسول اللہ ! بخدا ! ہم اس طرح نہ کہیں گے جیسے بنی اسرائیل نے حضرت موسیٰ علیہ السلام سے کہا تھا کہ تم اور تمہارا رب جا کر لڑو ، ہم یہاں بیٹھے ہیں ، بلکہ اگر آپ اونٹوں کے جگر مارتے ہوئے برک الغماد تک جائیں گے ، تب بھی ہم آپ کے ساتھ ہوں گے ۔"
"12986","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے نماز پڑھاتے ہوئے کسی بچے کے رونے کی آواز سنی اور نماز ہلکی کر دی ، ہم لوگ سمجھ گئے کہ نبی ﷽ نے اس کی ماں کی وجہ سے نماز کو ہلکا کر دیا ہے ، یہ اس بچے پر شفقت کا اظہار تھا ۔"
"12987","حمید کہتے ہیں کسی شخص نے حضرت انس رضی اللہ عنہ سے پوچھا کہ کیا نبی ﷽ خضاب لگاتے تھے آ انہوں نے فرمایا کہ نبی ﷽ پر بڑھاپے کا عیب نہیں آیا ۔"
"12988","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ حضرت ام سلیم رضی اللہ عنہا کے یہاں جایا کرتے تھے ، حضرت ابوطلحہ رضی اللہ عنہ سے ان کا ایک بیٹا تھا """" جس کا نام ابوعمیر تھا """" نبی ﷽ اس کے ساتھ ہنسی مذاق کیا کرتے تھے ، ایک دن نبی ﷽ نے اسے غمگین دیکھا تو فرمایا کیا بات ہے ابوعمیر غمگین دکھائی دے رہا ہے آ گھر والوں نے بتایا کہ اس کی ایک چڑیا مر گئی ہے جس کے ساتھ یہ کھیلتا تھا ، اس پر نبی ﷽ کہنے لگے اے ابوعمیر ! کیا کیا نغیر آ + چڑیا ، جو مر گئی تھی ,"
"12989","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ام سلیم رضی اللہ عنہا کے یہاں حضرت ابوطلحہ رضی اللہ عنہ کا بچہ پیدا ہوا ، انہوں نے اپنے بیٹے انس کے ساتھ اسے نبی ﷽ کے پاس بھیجا اور نبی ﷽ نے اسے گھٹی دی ۔"
"12990","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کو قبلہ مسجد کی طرف تھوک لگا ہوا نظر آیا ، نبی ﷽ کی طبیعت پر یہ چیز اتنی شاق گزری کہ چہرہ مبارک پر ناگواری کے آثار واضح ہو گئے ، نبی ﷽ نے اسے صاف کر کے فرمایا کہ انسان جب نماز پڑھنے کے لئے کھڑا ہوتا ہے تو اپنے رب سے مناجات کرتا ہے ، اس لئے اسے چاہئے کہ اپنی بائیں جانب یا پااں کے نیچے تھوکے ، اور اس طرح اشارہ کیا کہ اسے کپڑے میں لے کر مل لے ۔"
"12991","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کھڑی ہوئی تو ایک آدمی تیزی سے آیا ، اس کا سانس پھولا ہوا تھا ، صف تک پہنچ کر وہ کہنے لگا ®الحمدللہ حمدا کثیرا طیبا مبارکا فیہ¾ نبی ﷽ نے نماز سے فارغ ہو کر پوچھا کہ تم میں سے کون بولا تھا آ لوگ خاموش رہے ، نبی ﷽ نے پھر پوچھا اور تسلی دی کہ اس نے اچھی بات کہی تھی ، چنانچہ وہ آدمی کہنے لگا یا رسول اللہ ﷽ ! میں بولا تھا ، میں تیزی سے آ رہا تھا ، اور صف کے قریب پہنچ کر میں نے یہ جملہ کہا تھا ، نبی ﷽ نے فرمایا میں نے بارہ فرشتوں کو اس کی طرف تیزی سے بڑھتے ہوئے دیکھا کہ کون اس جملے کو پہلے اٹھاتا ہے ، پھر فرمایا جب تم میں سے کوئی شخص نماز کے لئے آئے تو سکون سے چلے ، جتنی نماز مل جائے سو پڑھ لے اور جو رہ جائے اسے قضاء کر لے ۔"
"12992","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ جنت البقیع میں تھے ، کہ ایک آدمی نے """" ابوالقاسم """" کہہ کر کسی کو آواز دی ، نبی ﷽ نے پیچھے مڑ کر دیکھا تو اس نے کہا کہ میں آپ کو مراد نہیں لے رہا ، اس پر نبی ﷽ نے فرمایا میرے نام پر تو اپنا نام رکھ لیا کرو ، لیکن میری کنیت پر اپنی کنیت نہ رکھا کرو ۔"
"12993","حمید رحمۃ کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے پوچھا کیا نبی ﷽ نے انگوٹھی بنوائی تھی آ انہوں نے فرمایا ہاں ! ایک مرتبہ نبی ﷽ نے نماز عشاء کو نصف رات تک ماخر کر دیا ، اور نماز کے بعد ہماری طرف متوجہ ہو کر فرمایا لوگ نماز پڑھ کر سو گئے لیکن تم نے جتنی دیر تک نماز کا انتظار کیا ، تم نماز ہی میں شمار ہوئے ، اس وقت نبی ﷽ کی انگوٹھی کی سفیدی اب تک میری نگاہوں کے سامنے ہے ۔"
"12994","حضرت انس رضی اللہ عنہ سے مروی ہے کہ کسی شخص نے نبی ﷽ سے نماز فجر کا وقت پوچھا تو نبی ﷽ نے حضرت بلال رضی اللہ عنہ کو طلوع فجر کے وقت حکم دیا اور نماز کھڑی کر دی ، پھر اگلے دن خوب روشنی میں کر کے نماز پڑھائی ، اور فرمایا نماز فجر کا وقت پوچھنے والا کہاں ہے آ ان دو وقتوں کے درمیان نماز فجر کا وقت ہے ۔"
"12995","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم لوگ نبی ﷽ کے ساتھ مغرب کی نماز پڑھتے تھے ، پھر ہم میں سے کوئی شخص بنو سلمہ کے پاس جاتا تو اس وقت بھی وہ اپنا تیر گرنے کی جگہ کو بخوبی دیکھ سکتا تھا ۔"
"12996","سعید بن یزید رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ کیا نبی ﷽ اپنے جوتوں میں نماز پڑھ لیتے تھے آ انہوں نے فرمایا جی ہاں !"
"12997","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا ہر امت کا ایک امین ہوتا ہے اور ابوعبیدہ اس امت کے امین ہیں ۔"
"12998","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کبھی کبھار اپنی تمام ازواج مطہرات کے پاس ایک ہی رات میں ایک ہی غسل سے چلے جایا کرتے تھے ۔"
"12999","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دو چتکبرے سینگ دار مینڈھے قربانی میں پیش کیا کرتے تھے ، اور اللہ کا نام لے کر تکبیر کہتے تھے ، انہیں اپنے ہاتھ سے ذبح کرتے تھے اور ان کے پہلو پر اپنا پااں رکھتے تھے ۔"
"13000","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں اور حضرت ابوطلحہ رضی اللہ عنہ خیبر سے واپس آ رہے تھے ، نبی ﷽ کے پیچھے حضرت صفیہ رضی اللہ عنہ سوار تھیں ، ایک مقام پر نبی ﷽ کی اونٹنی پھسل گئی ، نبی ﷽ اور حضرت صفیہ رضی اللہ عنہا گر گئے ، حضرت ابوطلحہ رضی اللہ عنہ تیزی سے وہاں پہنچے اور کہنے لگے یا رسول اللہ ﷽ ! اللہ مجھے آپ پر قربان کرے ، کوئی چوٹ تو نہیں آئی آ نبی ﷽ نے فرمایا نہیں ، خاتون کی خبر لو ، چنانچہ حضرت ابوطلحہ رضی اللہ عنہ اپنے چہرے پر کپڑا ڈال کر ان کے پاس پہنچے اور حضرت صفیہ رضی اللہ عنہ پر کپڑا ڈال دیا ، اس کے بعد سواری کو دوبارہ تیار کیا ، پھر ہم سب سوار ہو گئے اور ہم میں سے ایک نے دائیں جانب سے اور دوسرے نے بائیں جانب سے اسے اپنے گھیرے میں لے لیا ، جب ہم لوگ مدینہ منورہ کے قریب پہنچے یا پتھریلے علاقوں کی پشت پر پہنچے تو نبی ﷽ نے فرمایا ہم اللہ کی عبادت کرتے ہوئے ، توبہ کرتے ہوئے ، اور اپنے رب کی تعریف کرتے ہوئے واپس آئے ہیں ، نبی ﷽ مسلسل یہ جملے کہتے رہے تاآنکہ ہم مدینہ منورہ میں داخل ہو گئے ۔"
"13001","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی مدینہ منورہ تشریف آوری کے بعد حضرت عبداللہ بن سلام رضی اللہ عنہ بارگاہ رسالت میں حاضر ہوئے اور کہنے لگے یا رسول اللہ ﷽ ! میں آپ سے چند باتیں پوچھتا ہوں جنہیں کسی نبی کے علاوہ کوئی نہیں جانتا ، قیامت کی سب سے پہلی علامت کیا ہے آ اہل جنت کا سب سے پہلا کھانا کیا چیز ہو گی آ اور بچہ اپنے ماں باپ کے مشابہہ کیسے ہوتا ہے آ نبی ﷽ نے فرمایا ان کا جواب مجھے ابھی ابھی حضرت جبریل علیہ السلام نے بتایا ہے ، عبداللہ کہنے لگے کہ وہ تو فرشتوں میں یہودیوں کا دشمن ہے ۔ نبی ﷽ نے فرمایا قیامت کی سب سے پہلی علامت تو وہ آگ ہو گی جو مشرق سے نکل کر تمام لوگوں کو مغرب میں جمع کر لے گی اور اہل جنت کا سب سے پہلا کھانا مچھلی کا جگر ہو گا ، اور بچے کے اپنے ماں باپ کے ساتھ مشابہہ ہونے کی وجہ یہ ہے کہ اگر مرد کا """" پانی """" عورت کے پانی پر غالب آ جائے تو وہ بچے کو اپنی طرف کھینچ لیتا ہے ، اور اگر عورت کا """" پانی """" مرد کے پانی پر غالب آ جائے تو وہ بچے کو اپنی طرف کھینچ لیتی ہے ۔"
"13002","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ حضرت بلال رضی اللہ عنہ کو یہ حکم تھا کہ اذان کے کلمات جفت عدد میں اور اقامت کے کلمات طاق عدد میں کہا کریں ۔"
"13003","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مجھ سے نبی ﷽ کا یہ فرمان بیان کیا گیا ہے لیکن میں نے اسے خود نہیں سنا کہ تم میں ایک قوم ایسی آئے گی جو عبادت کرے گی اور دینداری پر ہو گی ، حتیٰ کہ لوگ ان کی کثرت عبادت پر تعجب کیا کریں گے اور وہ خود بھی خود پسندی میں مبتلا ہوں گے ، وہ لوگ دین سے اس طرح نکل جائیں گے جیسے تیر شکار سے نکل جاتا ہے ۔"
"13004","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں ایک دن کھڑا لوگوں کو فصیخ پلا رہا تھا کہ ایک شخص آیا اور کہنے لگا کہ شراب حرام ہو گئی ، وہ کہنے لگے انس ! تمہارے برتن میں جتنی شراب ہے سب انڈیل دو ، راوی نے ان سے شراب کی تفتیش کی تو فرمایا کہ وہ تو صرف کچی اور پکی کھجور ملا کر بنائی گئی نبیذ تھی ۔"
"13005","سعید بن یزید رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ کیا نبی ﷽ قراءت کا آغاز بسم اللہ سے کرتے تھے یا الحمدللہ سے آ انہوں نے فرمایا کہ تم نے مجھ سے ایسا سوال پوچھا ہے جس کے متعلق مجھ سے کسی نے نہیں پوچھا ۔"
"13006","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ہم لوگ نبی ﷽ کے ساتھ مدینہ منورہ سے نکلے ، نبی ﷽ واپسی تک دو دو رکعتیں پڑھتے رہے ، راوی کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ نبی ﷽ نے اس سفر میں کتنے دن قیام فرمایا تھا آ انہوں نے بتایا دس دن ۔"
"13007","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب حضرت عبدالرحمن بن عوف رضی اللہ عنہ مدینہ منورہ آئے تو نبی ﷽ نے ان کے اور حضرت سعد بن ربیع رضی اللہ عنہ کے درمیان بھائی چارہ قائم کر دیا ، حضرت سعد رضی اللہ عنہ نے ان سے فرمایا کہ میں اپنا سارا مال دو حصوں میں تقسیم کرتا ہوں ، نیز میری دو بیویاں ہیں ، میں ان میں سے ایک کو طلاق دے دیتا ہوں ، جب اس کی عدت گذر جائے تو آپ اس سے نکاح کر لیجئے گا ، حضرت عبدالرحمن رضی اللہ عنہ نے فرمایا اللہ تعالیٰ آپ کے مال اور اہل خانہ کو آپ کے لیے باعث برکت بنائے ، مجھے بازار کا راستہ دکھا دیجئے ، چنانچہ انہوں نے حضرت ابن عوف رضی اللہ عنہ کو راستہ بتا دیا ، اور وہ چلے گئے ، واپس آئے تو ان کے پاس کچھ پنیر اور گھی تھا جو وہ منافع میں بچا کر لائے تھے ۔ کچھ عرصے بعد نبی ﷽ نے حضرت عبدالرحمن رضی اللہ عنہ کو دیکھا تو ان پر زرد رنگ کے نشانات پڑے ہوئے تھے ، نبی ﷽ نے ان سے فرمایا یہ نشان کیسے ہیں آ انہوں نے بتایا کہ میں نے ایک انصاری خاتون سے شادی کر لی ہے ، نبی ﷽ نے پوچھا مہر کتنا دیا آ انہوں نے بتایا کہ کجھور کی گٹھلی کے برابر سونا ، نبی ﷽ نے فرمایا ولیمہ کرو ، اگرچہ صرف ایک بکری ہی سے ہو ۔"
"13008","حضرت انس رضی اللہ عنہ سے مروی ہے کہ بنو ہوازن کے لوگ غزوہ حنین میں بچے ، عورتیں ، اونٹ اور بکریاں تک لے کر آئے تھے ، انہوں نے اپنی کثرت ظاہر کرنے کے لئے ان سب کو بھی مختلف صفوں میں کھڑا کر دیا ، جب جنگ چھڑی تو مسلمان پیٹھ پھیر کر بھاگ گئے جیسا کہ اللہ تعالیٰ نے فرمایا ہے ، اس پر نبی ﷽ نے مسلمانوں کو آواز دی کہ اے اللہ کے بندو ! میں اللہ کا بندہ اور رسول + یہاں , ہوں ، اے گروہ انصار ! میں اللہ کا بندہ اور رسول + یہاں , ہوں ، اس کے بعد اللہ نے مسلمانوں کو فتح اور , کافروں کو شکست سے دوچار کر دیا ۔ نبی ﷽ نے اس دن یہ اعلان بھی فرمایا تھا کہ جو شخص کسی کافر کو قتل کرے گا ، اس کا سارا ساز و سامان قتل کرنے والے کو ملے گا ، چنانچہ حضرت ابوطلحہ رضی اللہ عنہ نے تنہا اس دن بیس کافروں کو قتل کیا تھا اور ان کا ساز و سامان لے لیا تھا ۔ اسی طرح حضرت ابوقتادہ رضی اللہ عنہ نے بارگاہ نبوت میں عرض کیا یا رسول اللہ ﷽ ! میں نے ایک آدمی کو کندھے کی رسی پر مارا ، اس نے زرہ پہن رکھی تھی ، میں نے اسے بڑی مشکل سے قابو کر کے اپنی جان بچائی ، آپ معلوم کر لیجئے کہ اس کا سامان کس نے لیا ہے آ ایک آدمی نے کھڑے ہو کر عرض کیا کہ وہ سامان میں نے لے لیا ہے ، یا رسول اللہ ﷽ ! آپ انہیں میری طرف سے اس پر راضی کر لیجئے اور یہ سامان مجھ ہی کو دے دیجئے ، نبی ﷽ کی عادت مبارکہ یہ تھی کہ اگر کوئی شخص کسی چیز کا سوال کرتا تو یا اسے عطاء فرما دیتے یا پھر سکوت فرما لیتے ، اس موقع پر بھی آپ ﷽ خاموش ہو گئے ، لیکن حضرت عمر رضی اللہ عنہ کہنے لگے بخدا ! ایسا نہیں ہو سکتا کہ اللہ اپنے ایک شیر کو مال غنیمت عطاء کر دے اور نبی ﷽ وہ تمہیں دے دیں آ نبی ﷽ نے مسکرا کر فرمایا کہ عمر سچ کہہ رہے ہیں ۔ غزوہ حنین ہی میں حضرت ام سلیم رضی اللہ عنہا کے پاس ایک خنجر تھا ، حضرت ابوطلحہ رضی اللہ عنہ نے ان سے پوچھا کہ یہ تمہارے پاس کیا ہے آ انہوں نے کہا کہ یہ میں نے اپنے پاس اس لئے رکھا ہے کہ اگر کوئی مشرک میرے قریب آیا تو میں اسی سے اس کا پیٹ پھاڑ دوں گی ، حضرت ابوطلحہ رضی اللہ عنہ نے بارگاہ رسالت میں عرض کیا یا رسول اللہ ﷽ ! آپ نے ام سلیم کی بات سنی آ پھر وہ کہنے لگیں یا رسول اللہ ﷽ ! جو لوگ آپ کو چھوڑ کر بھاگ گئے تھے ، انہیں قتل کروا دیجئے ، نبی ﷽ نے فرمایا ام سلیم ! اللہ نے ہماری کفایت خود ہی فرمائی اور ہمارے ساتھ اچھا معاملہ کیا ۔"
"13009","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"13010","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ حضرت ام سلیم رضی اللہ عنہا کے یہاں تشریف لے جایا کرتے تھے ، ان کا ایک چھوٹا بیٹا تھا جس کا نام ابوعمیر تھا ، نبی ﷽ نے اس سے فرمایا اے ابوعمیر ! کیا ہوا نغیر آ یہ ایک چڑیا تھی جس سے وہ کھیلا کرتے تھے ، بعض اوقات نماز کا وقت آ جاتا تو حضرت ام سلیم رضی اللہ عنہا نبی ﷽ کے لئے جائے نماز بچھا دیتیں جس پر آپ ﷽ پانی چھڑک کر نماز پڑھتے تھے ۔"
"13011","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ رات کے وقت حضرت اسید بن حضیر رضی اللہ عنہ اور عباد بن بشر رضی اللہ عنہ اپنے کسی کام سے نبی ﷽ کے پاس بیٹھے گفتگو کر رہے تھے ، اس دوران رات کا کافی حصہ بیت گیا اور وہ رات بہت تاریک تھی ، جب وہ نبی ﷽ سے رخصت ہو کر نکلے تو ان کے ہاتھ میں ایک لاٹھی تھی ، ان میں سے ایک آدمی کی لاٹھی روشن ہو گئی اور وہ اس کی روشنی میں چلنے لگے ، جب دونوں اپنے اپنے راستے پر جدا ہونے لگے تو دوسرے کی لاٹھی بھی روشن ہو گئی ۔"
"13012","حضرت انس رضی اللہ عنہ سے مری ہے کہ نبی ﷽ نے فرمایا اگر تم میں سے کسی پر قیامت قائم ہو جائے اور اس کے ہاتھ میں کھجور کا پودا ہو ، تب بھی اگر ممکن ہو تو اسے چاہیے کہ اسے گاڑ دے ۔"
"13013","ہشام بن زید کہتے ہیں کہ ایک مرتبہ میں اپنے دادا کے ساتھ دارالامارۃ میں داخل ہوا ، وہاں ایک مرغی کو باندھ کر اس پر نشانہ بازی کی جا رہی تھی ، اسے جب بھی تیر لگتا تو وہ چیخ مارتی ، انہوں نے یہ دیکھ کر فرمایا کہ نبی ﷽ نے جانور کو باندھ کر اس پر نشانہ درست کرنے سے منع فرمایا ہے ۔"
"13014","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ایک مرتبہ میں جنت میں داخل ہوا تو وہاں سونے کا ایک محل نظر آیا ، میں نے پوچھا یہ محل کس کا ہے آ لوگوں نے بتایا کہ یہ ایک قریشی نوجوان کا ہے ، میں سمجھا کہ شاید میرا ہے لیکن پتہ چلا کہ یہ عمر بن خطاب رضی اللہ عنہ کا ہے ، مجھے اگر تمہاری غیرت کے بارے معلوم نہ ہوتا تو میں ضرور اس میں داخل ہو جاتا ، حضرت عمر رضی اللہ عنہ کہنے لگے یا رسول اللہ ﷽ ! میں جس مرضی کے سامنے غیرت کا اظہار کروں ، آپ کے سامنے نہیں کر سکتا ۔"
"13015","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ مسجد میں اپنے صحابہ رضی اللہ عنہم کے ساتھ تشریف فرما تھے ، کہ ایک دیہاتی آیا اور مسجد میں پیشاب کرنے لگا ، صحابہ کرام رضی اللہ عنہم نے اسے خبردار کرنے کے لئے روکا ، نبی ﷽ نے فرمایا اسے مت روکو ، اسے چھوڑ دو ، پھر اس کے فارغ ہونے کے بعد اسے بلا کر فرمایا کہ ان مساجد میں کسی قسم کی گندگی ، پیشاب اور پاخانہ کرنا مناسب نہیں ہے ، یہ مساجد تو قرآن کریم کی تلاوت ، ذکر اللہ اور نماز کے لئے ہوتی ہیں ، پھر نبی ﷽ نے ایک آدمی سے فرمایا جا کر پانی کا ایک ڈول لے کر آا اور اس پر بہا دو ، چنانچہ اس نے پانی کا ڈول لا کر اس پیشاب پر بہا دیا ۔"
"13016","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ اپنے گھر میں کھڑے نماز پڑھ رہے تھے کہ ایک آدمی آ کر کسی سوراخ سے اندر جھانکنے لگا ، نبی ﷽ نے اپنے ترکش سے ایک تیر نکال کر اس کی طرف سیدھا کیا تو وہ آدمی پیچھے ہٹ گیا ۔"
"13017","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا دجال آئے گا تو مکہ اور مدینہ کے علاوہ ساری زمین کو اپنے پیروں سے روند ڈالے گا ، وہ مدینہ آنے کی کوشش بھی کرے گا لیکن اس کے ہر دروازے پر فرشتوں کی صفیں پائے گا ، پھر وہ """" جرف """" کے ویرانے میں پہنچ کر اپنا خیمہ لگائے گا ، اس وقت مدینہ منورہ میں تین زلزلے آئیں گے اور ہر منافق مرد و عورت مدینہ سے نکل کر دجال سے جا ملے گا ۔"
"13018","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اگر ہجرت نہ ہوتی تو میں انصار ہی کا ایک فرد ہوتا ۔"
"13019","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کھڑی ہوئی تو ایک آدمی آیا ، صف تک پہنچ کر وہ کہنے لگا ®الحمدللہ حمدا کثیر طیبا مبارکا فیہ¾ نبی ﷽ نے نماز سے فارغ ہو کر پوچھا کہ تم میں سے کون بولا تھا آ لوگ خاموش رہے ، نبی ﷽ نے تین مرتبہ پوچھا ، بالآخر وہ آدمی کہنے لگا یا رسول اللہ ﷽ ! میں بولا تھا ، اور میرا ارادہ تو خیر ہی کا تھا ، نبی ﷽ نے فرمایا میں نے بارہ فرشتوں کو اس کی طرف تیزی سے بڑھتے ہوئے دیکھا کہ کون اس جملے کو پہلے اٹھاتا ہے ، لیکن انہیں سمجھ نہ آئی کہ اس کا کتنا ثواب لکھیں چنانچہ انہوں نے اللہ تعالی سے پوچھا ، اللہ تعالی نے فرمایا یہ کلمات اسی طرح لکھ لو جیسے میرے بندے نے کہے ہیں ۔"
"13020","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا میں جنت میں داخل ہوا تو اچانک ایک نہر پر نظر پڑی جس کے دونوں کناروں پر موتیوں کے خیمے لگے ہوئے تھے ، میں نے اس میں ہاتھ ڈال کر پانی میں بہنے والی چیز کو پکڑا تو وہ مہکتی ہوئی مشک تھی ، میں نے جبریل علیہ السلام سے پوچھا کہ یہ کیا ہے آ تو انہوں نے بتایا کہ یہ نہر کوثر ہے جو اللہ نے آپ کو عطاء فرمائی ہے ۔"
"13021","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک مہینہ تک رکوع کے بعد قنوت نازلہ پڑھی ہے پھر اسے ترک فرما دیا تھا ۔"
"13022","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا سجدوں میں اعتدال برقرار رکھا کرو ، اور تم میں سے کوئی شخص کتے کی طرح اپنے ہاتھ نہ بچھائے ۔ اور جب تم میں سے کوئی شخص نماز پڑھ رہا ہوتا ہے تو وہ اپنے رب سے مناجات کر رہا ہوتا ہے ، اس لئے اس حالت میں تم میں سے کوئی شخص اپنی دائیں جانب نہ تھوکا کرے بلکہ بائیں جانب یا اپنے پااں کے نیچے تھوکا کرے ۔"
"13023","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت زبیر رضی اللہ عنہ اور عبدالرحمن بن عوف رضی اللہ عنہ نے نبی ﷽ سے جواں کی شکایت کی ، نبی ﷽ نے انہیں ریشمی کپڑے پہننے کی اجازت مرحمت فرما دی ، چنانچہ میں نے ان میں سے ہر ایک کو ریشمی قمیص پہنے ہوئے دیکھا ہے ۔"
"13024","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک دیہاتی آیا اور کہنے لگا یا رسول اللہ ﷽ ! قیامت کب قائم ہو گی آ نبی ﷽ نے فرمایا تم نے قیامت کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کہ میں نے کوئی بہت زیادہ اعمال تو مہیا نہیں کر رکھے ، البتہ اتنی بات ضرور ہے کہ میں اللہ اور اس کے رسول سے محبت کرتا ہوں ، نبی ﷽ نے فرمایا کہ تم اس کے ساتھ ہو گے جس کے ساتھ تم محبت کرتے ہو ، حضرت انس رضی اللہ عنہ فرماتے ہیں کہ صحابہ رضی اللہ عنہم نے پوچھا ہمارا بھی یہی حکم ہے آ نبی ﷽ نے فرمایا ہاں ! تمہارا بھی یہی حکم ہے ، چنانچہ میں نے مسلمانوں کو اسلام قبول کرنے کے بعد اس دن جتنا خوش دیکھا ، اس سے پہلے کبھی نہیں دیکھا ، اسی دوران حضرت مغیرہ بن شعبہ رضی اللہ عنہ کا ایک غلام """" جو میرا ہم عمر تھا """" تھا ، وہاں سے گذرا تو نبی ﷽ نے فرمایا اگر اس کی زندگی ہوئی تو یہ بڑھاپے کو نہیں پہنچے گا کہ قیامت قائم ہو جائے گی ۔"
"13025","قتادہ رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ کیا نبی ﷽ نے خضاب لگایا ہے آ انہوں نے فرمایا یہاں تک نوبت ہی نہیں آئی ، نبی ﷽ کی کنپٹیوں میں چند بال سفید تھے ، البتہ حضرت ابوبکر صدیق رضی اللہ عنہ مہندی اور وسمہ کا خضاب لگاتے تھے ۔"
"13026","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک یہودی نے نبی ﷽ اور صحابہ رضی اللہ عنہم کو سلام کرتے ہوئے ®السام علیکم¾ کہا ، صحابہ رضی اللہ عنہم نے اسے جواب دیا ، نبی ﷽ نے صحابہ رضی اللہ عنہم سے فرمایا اس نے ®السام علیک¾ کہا ہے ، یہودی کو پکڑ کر لایا گیا تو اس نے اس کا اقرار کیا ، نبی ﷽ نے فرمایا جب تمہیں کوئی """" کتابی """" سلام کرے تو اسے اسی کا جملہ لوٹا دیا کرو ۔"
"13027","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ فرماتے تھے کہ اگر ابن آدم کے پاس مال سے بھری ہوئی دو وادیاں بھی ہوتیں تو وہ تیسری کی تمنا کرتا اور ابن آدم کا پیٹ صرف قبر کی مٹی ہی بھر سکتی ہے ، اور جو توبہ کرتا ہے ، اللہ اس کی توبہ قبول فرما لیتا ہے ۔"
"13028","[Darussalam 12997] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13029","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا انسان تو بوڑھا ہو جاتا ہے لیکن دو چیزیں اس میں جوان ہو جاتی ہیں ، مال کی حرص اور لمبی عمر کی امید ۔"
"13030","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ ام مبشر نامی انصاری خاتون کے باغ میں تشریف لے گئے اور فرمایا کہ یہ باغ کسی مسلمان نے لگایا ہے یا کافر نے آ لوگوں نے بتایا مسلمان نے ، نبی ﷽ نے ارشاد فرمایا جو مسلمان کوئی پودا اگاتا ہے اور اس سے کسی پرندے ، انسان یا درندے کو رزق ملتا ہے تو وہ اس کے لیے صدقہ کا درجہ رکھتا ہے ۔"
"13031","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت ابن ام مکتوم رضی اللہ عنہ کو مدینہ منورہ میں اپنا جانشین دو مرتبہ بنایا تھا وہ نابینا تھے اور لوگوں کو نماز پڑھایا کرتے تھے ۔"
"13032","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دو مرتبہ اخدعین اور ایک مرتبہ کاہل نامی کندھوں کے درمیان مخصوص جگہوں پر سینگی لگواتے تھے ۔"
"13033","قتادہ رحمۃ اللہ کہتے ہیں کہ میں نے ایک مرتبہ حضرت انس رضی اللہ عنہ سے نبی ﷽ کی قراءت کی کیفیت کے متعلق پوچھا تو انہوں نے فرمایا کہ نبی ﷽ اپنی آواز کو کھینچا کرتے تھے ۔"
"13034","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ یہ دعاء فرمایا کرتے تھے اے اللہ ! میں نہ سنی جانے والی بات ، نہ بلند ہونے والے عمل ، خشوع سے خالی دل ، اور غیر نافع علم سے آپ کی پناہ میں آتا ہوں ۔"
"13035","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ یہ دعاء فرمایا کرتے تھے کہ اے اللہ ! میں برص ، جنون ، کوڑھ اور ہر بدترین بیماری سے آپ کی پناہ مانگتا ہوں ۔"
"13036","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کو راستے میں کھجور پڑی ہوئی ملتی اور انہیں یہ اندیشہ نہ ہوتا کہ یہ صدقہ کی ہو گی تو وہ اسے کھا لیتے تھے ۔"
"13037","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک یہودی نے ایک انصاری بچی کو پتھر مار مار کر اس کا سر کچل دیا ، اس بچی سے پوچھا کہ کیا تمہارے ساتھ یہ سلوک فلاں نے کیا ہے ، فلاں نے کیا ہے یہاں تک کہ جب اس یہودی کا نام آیا تو اس نے سر کے اشارے سے ہاں کہہ دیا ، اس یہودی کو پکڑ کر نبی ﷽ کے سامنے لایا گیا ، اس نے اپنے جرم کا اعتراف کر لیا ، نبی ﷽ نے حکم دیا اور اس کا سر بھی پتھروں سے کچل دیا گیا ۔"
"13038","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ تعالیٰ نے مجھ سے یہ وعدہ فرمایا ہے کہ وہ میری امت کے ایک لاکھ آدمیوں کو جنت میں داخل فرمائے گا ، حضرت ابوبکر رضی اللہ عنہ نے عرض کیا یا رسول اللہ ﷽ ! اس تعداد میں اضافہ کیجئے ، نبی ﷽ نے اپنی ہتھیلی جمع کر کے فرمایا کہ اتنے افراد مزید ہوں گے ، حضرت ابوبکر رضی اللہ عنہ نے پھر عرض کیا یا رسول اللہ ﷽ ! اس تعداد میں اضافہ کیجئے ، نبی ﷽ نے پھر اپنی ہتھیلی جمع کر کے فرمایا کہ اتنے افراد مزید ہوں گے ، اس پر حضرت عمر رضی اللہ عنہ کہنے لگے کہ ابوبکر ! بس کیجئے ، حضرت ابوبکر رضی اللہ عنہ نے فرمایا عمر ! پیچھے ہٹو ، حضرت عمر رضی اللہ عنہ نے کہا کہ اگر اللہ چاہے تو ایک ہی ہاتھ میں ساری مخلوق کو جنت میں داخل کر دے ، نبی ﷽ نے فرمایا عمر سچ کہتے ہیں ۔"
"13039","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا بندہ اس وقت تک خیر پر رہتا ہے جب تک وہ جلد بازی سے کام نہ لے ، صحابہ رضی اللہ عنہم نے پوچھا یا رسول اللہ ﷽ ! جلدی سے کیا مراد ہے آ فرمایا بندہ یوں کہنا شروع کر دے کہ میں نے اپنے پروردگار سے اتنی دعائیں کیں لیکن اس نے قبول ہی نہیں کی ۔"
"13040","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نبی ﷽ نے فرمایا جو میں جانتا ہوں ، اگر تم وہ جانتے ہوتے تو تم بہت تھوڑا ہنستے اور کثرت سے رویا کرتے ۔"
"13041","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا میں اور قیامت ان دو انگلیوں کی طرح اکٹھے بھیجے گئے ہیں ، یہ کہہ کر نبی ﷽ نے شہادت والی انگلی اور درمیانی انگلی کی طرف اشارہ فرمایا ۔"
"13042","حضرت انس رضی اللہ عنہ کہتے ہیں کہ + چونکہ , رسول اللہ ﷽ سے بکثرت سوال کرنے سے ہمیں قرآن میں ممانعت کر دی گئی تھی ، اس لئے ہم دل سے خواہش مند ہوتے تھے کہ کوئی عقل مند بدوی آ کر حضور ﷽ سے کوئی مسئلہ دریافت کرے اور ہم سنیں چنانچہ + ایک مرتبہ , بدوی نے حاضر ہو کر + حضور ﷽ , سے عرض کیا کہ آپ کا قاصد ہمارے پاس آیا تھا اور کہتا تھا کہ آپ فرماتے ہیں کہ خدا نے مجھ کو پیغمبر بنایا ہے آ آپ ﷽ نے فرمایا وہ ٹھیک کہتا تھا ، بدوی بولا آسمانوں ، زمینوں اور پہاڑوں کو کس نے پیدا کیا آ آپ نے فرمایا خدا نے ، بدوی بولا آپ کو قسم ہے اس ذات پاک کی جس نے آسمانوں اور زمینوں کو پیدا کیا ، پہاڑوں کو قائم کیا ، + یہ بتائیے کہ , کیا واقعی اللہ تعالیٰ نے آپ کو رسول بنا کر بھیجا ہے آ حضور ﷽ نے فرمایا ہاں ! بدوی بولا آپ کا قاصد کہتا تھا کہ ہم پر دن رات میں پانچ نمازیں فرض ہیں ، حضور ﷽ نے فرمایا اس نے ٹھیک کہا ، بدوی بولا آپ کو اس اللہ کی قسم ! جس نے آپ کو رسول بنا کر بھیجا ہے + بتائیے , کیا آپ کو اللہ نے اس کا حکم دیا ہے آ حضور ﷽ نے فرمایا ہاں ! بدوی بولا آپ کے قاصد نے کہا تھا کہ ہم پر اپنے مال کی زکوٰۃ نکالنا فرض ہے آ نبی ﷽ نے فرمایا اس نے سچ کہا ، اس نے کہا کہ اس اللہ کی قسم جس نے آپ کو بھیجا ہے کیا اس نے آپ کو اس کا حکم دیا ہے آ نبی ﷽ نے فرمایا ہاں ! اس نے کہا کہ آپ کے قاصد کا یہ بھی کہنا تھا کہ ہم پر سال میں ایک ماہ کے روزے فرض ہیں آ حضور ﷽ نے فرمایا اس نے سچ کہا ، بدوی بولا آپ کو اس اللہ کی قسم ! جس نے آپ کو پیغمبر بنایا ہے + یہ بتائیے کہ , کیا آپ کو اللہ نے اس کا حکم دیا ہے آ حضور ﷽ نے فرمایا ہاں ! بدوی بولا آپ کے قاصد نے یہ بھی کہا تھا کہ ہم میں سے صاحب استطاعت پر کعبہ کا حج فرض ہے آ حضور ﷽ نے فرمایا اس نے سچ کہا آخرکار وہ بدوی پیٹھ پھیر کر جاتے ہوئے کہنے لگا کہ اس اللہ کی قسم ! جس نے آپ کو سچائی کے ساتھ مبعوث فرمایا میں اس میں ذرا بھی کمی بیشی نہیں کروں گا ، حضور ﷽ نے فرمایا اگر یہ سچا ہے تو جنت میں داخل ہو گیا ۔"
"13043","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ماہ رمضان میں نبی ﷽ نماز پڑھ رہے تھے ، میں آ کر ان کے پیچھے کھڑا ہو گیا ، ایک اور آدمی آ کر میرے ساتھ کھڑا ہو گیا ، اسی طرح ہوتے ہوتے ایک جماعت بن گئی ، نبی ﷽ کو جب اپنے پیچھے میری موجودگی کا احساس ہوا تو نماز مختصر کر کے اپنے گھر چلے گئے ، اور وہاں ویسی نماز پڑھی جو ہمارے سامنے نہ پڑھی تھی ، صبح ہوئی تو ہم نے عرض کیا یا رسول اللہ ! رات کو آپ نے ہماری موجودگی کو بھانپ لیا تھا آ نبی ﷽ نے فرمایا ہاں اور اسی وجہ سے میں نے ایسا کیا تھا ، پھر نبی ﷽ نے مہینے کے آخر میں صوم وصال فرمایا ، کچھ لوگوں نے بھی ایسا ہی کیا ، نبی ﷽ کو خبر ہوئی تو فرمایا کہ لوگوں کو کیا ہو گیا ہے کہ وہ وصال کرتے ہیں ، اگر یہ مہینہ لمبا ہو جاتا تو میں اتنے دن مسلسل روزہ رکھتا کہ دین میں تعمق کرنے والے اپنا تعمق چھوڑ دیتے ، میں تمہاری طرح نہیں ہوں ، + مجھے تو میرا رب کھلاتا پلاتا رہتا ہے , ۔"
"13044","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ ہمارے یہاں تشریف لائے ، اس وقت گھر میں میرے ، والدہ اور میری خالہ ام حرام کے علاوہ کوئی نہ تھا ، نماز کا وقت نہ تھا لیکن نبی ﷽ نے فرمایا اٹھو میں تمہارے لیے نماز پڑھ دوں + چنانچہ نبی ﷽ نے ہمیں نماز پڑھائی , راوی نے ثابت سے پوچھا کہ نبی ﷽ نے حضرت انس رضی اللہ عنہ کو کہاں کھڑا کیا آ انہوں نے کہا دائیں جانب ، بہرحال ! نبی ﷽ نے ہمارے اہل خانہ کے لئے دنیا و آخرت کی تمام بھلائیاں مانگیں ، پھر میری والدہ نے عرض کیا یا رسول اللہ ! اپنے خادم انس کے لئے دعاء کر دیجئے ، اس پر نبی ﷽ نے دنیا و آخرت کی ہر خیر میرے لیے مانگی ، اور فرمایا اے اللہ ! اسے مال اور اولاد عطاء فرما اور ان میں برکت عطاء فرما ۔"
"13045","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے فرمایا کہ آج رات میرے یہاں بچہ پیدا ہوا ہے ، میں نے اس کا نام اپنے جد امجد حضرت ابراہیم علیہ السلام کے نام پر رکھا ہے ، پھر نبی ﷽ نے حضرت ابراہیم رضی اللہ عنہ کو دودھ پلانے کے لئے مدینہ کے ایک لوہار """" جس کا نام ابوسیف تھا """" کی بیوی ام سیف کے حوالے کر دیا ، نبی ﷽ بچے سے ملنے کے لئے وہاں جایا کرتے تھے ، میں بھی نبی ﷽ کے ساتھ گیا ہوں ، وہاں پہنچے تو ابوسیف بھٹی پھونک رہے تھے اور پورا گھر دھوئیں سے بھرا ہوا تھا ، میں نبی ﷽ کے آگے تیزی سے چلتا ہوا ابوسیف کے پاس پہنچا اور ان سے کہا کہ ابوسیف ! نبی ﷽ تشریف لائے ہیں ، چنانچہ وہ رک گئے ۔ نبی ﷽ نے وہاں پہنچ کر بچے کو بلایا اور انہیں اپنے سینے سے چمٹا لیا ، میں نے دیکھا کہ وہ بچہ نبی ﷽ کے سامنے موت و حیات کی کشمکش میں تھا ، یہ کیفیت دیکھ کر نبی ﷽ کی آنکھوں سے آنسو رواں ہو گئے اور فرمایا آنکھیں روتی ہیں ، دل غم سے بوجھل ہوتا ہے لیکن ہم وہی بات کہیں گے جس سے ہمارا رب راضی ہو ، بخدا ! ابراہیم ! ہم تمہاری جدائی سے غمگین ہیں ۔"
"13046","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میرا نام میرے چچا انس بن نضر کے نام پر رکھا گیا تھا ، جو غزوہ بدر میں نبی ﷽ کے ساتھ شریک نہیں ہو سکے تھے ، اور اس کا انہیں افسوس تھا اور وہ کہا کرتے تھے کہ میں نبی ﷽ کے ساتھ سب سے پہلے غزوہ میں شریک نہیں ہو سکا ، اگر اب اللہ نے نبی ﷽ کے ساتھ کسی غزوے کا موقع عطاء کیا تو اللہ دیکھے گا کہ میں کیا کرتا ہوں ، چنانچہ وہ غزوہ احد میں نبی ﷽ کے ساتھ شریک ہوئے ۔ میدان کار زار میں انہیں اپنے سامنے سے حضرت سعد بن معاذ رضی اللہ عنہ آتے ہوئے دکھائی دیئے ، وہ ان سے کہنے لگے کہ ابوعمرو ! کہاں جا رہے ہو آ بخدا ! مجھے تو احد کے پیچھے سے جنت کی خوشبو آ رہی ہے ، یہ کہہ کر اس بے جگری سے لڑے کہ بالآخر شہید ہو گئے اور ان کے جسم پر نیزوں ، تلواروں اور تیروں کے اسی سے زیادہ نشانات پائے گئے ، ان کی بہن اور میری پھوپھی حضرت ربیع بنت نضر کہتی ہیں کہ میں بھی اپنے بھائی کو صرف انگلی کے پوروں سے پہچان سکی ہوں ، اور اسی مناسبت سے یہ آیت نازل ہوئی تھی کہ """" کچھ لوگ وہ ہیں جنہوں نے اللہ سے کیا ہوا وعدہ سچ کر دکھایا ، ان میں سے بعض تو اپنی امید پوری کر چکے اور بعض منتظر ہیں """" ۔۔۔۔۔۔۔ صحابہ کرام رضی اللہ عنہم سمجھتے تھے کہ یہ آیت حضرت انس رضی اللہ عنہ اور ان جیسے دوسرے صحابہ رضی اللہ عنہم کے بارے نازل ہوئی ہے ۔"
"13047","حضرت انس رضی اللہ عنہ سے دریافت کیا کہ ایک مرتبہ میں جمعہ کے دن منبر کے پاس بیٹھا ہوا تھا ، نبی ﷽ خطبہ ارشاد فرما رہے تھے کہ کچھ لوگوں نے عرض کیا کہ یا رسول اللہ ﷽ ! بارش رکی ہوئی ہے ، زمینیں خشک پڑی ہیں اور مال تباہ ہو رہے ہیں آ نبی ﷽ نے یہ سن کر اپنے ہاتھ اتنے بلند کیے کہ مجھے آپ کی مبارک بغلوں کی سفیدی نظر آنے لگی ، اور نبی ﷽ نے طلب باراں کے حوالے سے دعاء فرمائی ، جس وقت آپ ﷽ نے اپنے دست مبارک بلند کیے تھے ، اس وقت ہمیں آسمان پر کوئی بادل نظر نہیں آ رہا تھا ، اور جب نماز سے فارغ ہوئے تو قریب کے گھر میں رہنے والے نوجوانوں کو اپنے گھر واپس پہنچنے میں دشواری ہو رہی تھی ، جب اگلا جمعہ ہوا تو لوگوں نے عرض کیا یا رسول اللہ ﷽ ! گھروں کی عمارتیں گر گئیں اور سوار مدینہ سے باہر ہی رکنے پر مجبور ہو گئے ، یہ سن کر نبی ﷽ نے اللہ سے دعا کی کہ اے اللہ ! یہ بارش ہمارے اردگرد فرما ، ہم پر نہ برسا ، چنانچہ مدینہ سے بارش چھٹ گئی ۔"
"13048","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے پاس وضو کے لئے پانی کا برتن لایا گیا اور نبی ﷽ نے اس سے وضو فرمایا ، راوی کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کیا نبی ﷽ ہر نماز کے وقت نیا وضو فرماتے تھے آ انہوں نے فرمایا ہاں ! راوی نے حضرت انس رضی اللہ عنہ سے پوچھا کہ آپ لوگ کیا کرتے تھے آ انہوں نے جواب دیا کہ ہم بے وضو ہونے تک ایک ہی وضو سے کئی کئی نمازیں بھی پڑھ لیا کرتے تھے ۔"
"13049","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مسجد نبوی کی تعمیر سے پہلے نبی ﷽ بکریوں کے باڑے میں بھی نماز پڑھ لیا کرتے تھے ۔"
"13050","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ وہ تھے ، نبی ﷽ ، ان کی والدہ اور خالہ تھیں ، نبی ﷽ نے ان سب کو نماز پڑھائی ، انس رضی اللہ عنہ کو دائیں جانب اور ان کی والدہ اور خالہ کو ان کے پیچھے کھڑا کر دیا ۔"
"13051","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا تم میں سے کوئی شخص اپنے اوپر آنے والی کسی تکلیف کی وجہ سے موت کی تمنا نہ کرے ، اگر موت کی تمنا کرنا ہی ضروری ہو تو اسے یوں کہنا چاہئے کہ اے اللہ ! جب تک میرے لیے زندگی میں کوئی خیر ہے ، مجھے اس وقت تک زندہ رکھ ، اور جب میرے لیے موت میں بہتری ہو تو مجھے موت عطاء فرما دینا ۔"
"13052","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے دس سال سفر و حضر میں نبی ﷽ کی خدمت کا شرف حاصل کیا ہے ، یہ ضروری نہیں ہے کہ میرا ہر کام نبی ﷽ کو پسند ہی ہو ، لیکن نبی ﷽ نے مجھے کبھی اف تک نہیں کہا ، نبی ﷽ نے مجھ سے کبھی یہ نہیں فرمایا کہ تم نے یہ کام کیوں کیا آ یا یہ کام تم نے کیوں نہیں کیا آ"
"13053","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک دن میں نبی ﷽ کی خدمت سے جب فارغ ہوا تو میں نے سوچا کہ اب نبی ﷽ قیلولہ کریں گے ، چنانچہ میں بچوں کے ساتھ کھیلنے نکل گیا ، میں ابھی ان کا کھیل دیکھ ہی رہا تھا کہ نبی ﷽ آ گئے اور بچوں کو """" جو کھیل رہے تھے """" سلام کیا ، اور مجھے بلا کر اپنے کسی کام سے بھیج دیا اور خود ایک دیوار کے سائے میں بیٹھ گئے ، یہاں تک کہ میں واپس آ گیا ، جب میں گھر واپس پہنچا تو حضرت ام سلیم رضی اللہ عنہا + میری والدہ , کہنے لگیں کہ اتنی دیر کیوں لگا دی آ میں نے بتایا کہ نبی ﷽ نے اپنے کسی کام سے بھیجا تھا ، انہوں نے پوچھا کیا کام تھا آ میں نے کہا کہ یہ ایک راز ہے ، انہوں نے کہا کہ پھر نبی ﷽ کے راز کی حفاظت کرنا ، ثابت ! اگر وہ راز میں کسی سے بیان کرتا تو تم سے بیان کرتا ۔"
"13054","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت صفیہ رضی اللہ عنہا ، حضرت دحیہ کلبی رضی اللہ عنہ کے حصے میں آئی تھیں ، کسی شخص نے عرض کیا یا رسول اللہ ﷽ ! دحیہ کے حصے میں ایک نہایت خوبصورت باندی آئی ہے ، نبی ﷽ نے ان کی تمنا کے عوض انہیں خرید لیا ، اور خرید لیا ، اور خرید کر انہیں حضرت ام سلیم رضی اللہ عنہا کے پاس بھیج دیا ، تاکہ وہ انہیں بنا سنوار کر دلہن بنائیں ، پھر نبی ﷽ خیبر سے نکلے تو انہیں سواری پر بٹھا کر پردہ کرایا اور انہیں اپنے پیچھے بٹھا لیا صبح ہوئی تو نبی ﷽ نے فرمایا جس شخص کے پاس زائد توشہ ہو وہ اسے ہمارے پاس لے آئے ، چنانچہ لوگ زائد کھجوریں ، ستو اور گھی لانے لگے ، پھر انہوں نے اس کا حلوہ بنایا ، اور وہ حلوہ کھایا اور قریب کے حوض سے پانی پیا جس میں بارش کا پانی جمع تھا ، یہ نبی ﷽ کا ولیمہ تھا ، پھر ہم روانہ ہو گئے اور مدینہ منورہ کے قریب پہنچ کر لوگ اپنے رواج کے مطابق سواریوں سے کود کر اترنے لگے ، نبی ﷽ بھی اسی طرح اترنے لگے لیکن اونٹنی پھسل گئی اور نبی ﷽ زمین پر گر گئے ، کسی شخص نے بھی نبی ﷽ یا حضرت صفیہ رضی اللہ عنہا کو نہیں دیکھا ، ادھر نبی ﷽ کھڑے ہوئے اور انہیں پردہ کرایا ، پھر اپنے پیچھے بٹھا لیا ہم نبی ﷽ کے پاس پہنچے تو فرمایا کوئی نقصان نہیں ہوا ، اور نبی ﷽ مدینہ میں داخل ہو گئے ، بچیاں نکل نکل کر حضرت صفیہ رضی اللہ عنہا کو دیکھنے لگیں اور ان کے گرنے پر ہنسنے لگیں ۔"
"13055","[Darussalam 13024] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13056","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب حضرت زینب بنت جحش رضی اللہ عنہا کی عدت پوری ہو گئی تو نبی ﷽ نے حضرت زید بن حارثہ رضی اللہ عنہ سے فرمایا کہ زینب کے پاس جا کر میرا ذکر کرو ، وہ چلے گئے ، جب ان کے پاس پہنچے تو خود کہتے ہیں کہ وہ آٹا گوندھ رہی تھیں ، جب میں نے انہیں دیکھا تو میرے دل میں ان کی اتنی عظمت پیدا ہوئی کہ میں ان کی طرف نظر اٹھا کر دیکھ بھی نہ سکا ، کیونکہ نبی ﷽ نے ان کا تذکرہ کیا تھا ، چنانچہ میں نے اپنی پشت پھیری اور الٹے پااں لوٹ گیا اور ان سے کہہ دیا کہ زینب ! خوشخبری ہے ، نبی ﷽ نے مجھے تمہارے پاس بھیجا ہے ، وہ تمہارا ذکر کر رہے تھے ، انہوں نے جواب دیا کہ میں جب تک اپنے رب سے مشورہ نہ کر لوں ، کچھ نہ کروں گی ، یہ کہہ کر وہ اپنی جائے نماز کی طرف بڑھ گئیں ، اور اسی دوران قرآن کریم کی آیت نازل ہو گئی ۔ پھر نبی ﷽ ان کے یہاں تشریف لائے اور ان سے اجازت لئے بغیر اندر تشریف لے گئے ، اور اس نکاح کے ولیمے میں نبی ﷽ نے ہمیں روٹی اور گوشت کھلایا ، باقی تو سب لوگ کھا پی کر چلے گئے ، لیکن کچھ لوگ کھانے کے بعد وہیں بیٹھ کر باتیں کرنے لگے ، یہ دیکھ کر نبی ﷽ خود ہی گھر سے باہر چلے گئے ، آپ ﷽ کے پیچھے پیچھے میں بھی نکل آیا ، نبی ﷽ وقت گذارنے کے لئے باری باری اپنی ازواج مطہرات کے حجروں میں جاتے اور انہیں سلام کرتے ، وہ پوچھتیں کہ یا رسول اللہ ﷽ ! آپ نے اپنی بیوی کو کیسا پایا آ اب مجھے یاد نہیں کہ میں نے نبی ﷽ کو لوگوں کے جانے کی خبر دی یا کسی اور نے بہرحال ! نبی ﷽ وہاں سے چلتے ہوئے اپنے گھر میں داخل ہو گئے ، میں نے بھی داخل ہونا چاہا تو آپ ﷽ نے پردہ لٹکا لیا اور آیت حجاب نازل ہو گئی ، اور لوگوں کو اس کے ذریعے نصیحت کی گئی ۔"
"13057","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوطلحہ رضی اللہ عنہ کا ایک بیٹا بیمار تھا ، وہ فوت ہو گیا ، ان کی زوجہ حضرت ام سلیم رضی اللہ عنہا نے گھر والوں سے کہہ دیا کہ تم میں سے کوئی بھی ابوطلحہ کو ان کے بیٹے کی موت کی خبر نہ دے ، چنانچہ جب حضرت ابوطلحہ رضی اللہ عنہ واپس آئے تو انہوں نے ان کے سامنے رات کا کھانا لا کر رکھا ، انہوں نے کھانا کھایا ، اور پانی پیا ، پھر حضرت ام سلیم رضی اللہ عنہا نے خوب اچھی طرح بناا سنگھار کیا ، حضرت ابوطلحہ رضی اللہ عنہ نے ان کے ساتھ """" خلوت """" کی ، جب انہوں نے دیکھا کہ وہ اچھی طرح سیراب ہو چکے ہیں تو انہوں نے حضرت ابوطلحہ رضی اللہ عنہ سے کہا کہ اے ابوطلحہ ! دیکھیں تو سہی ، فلاں لوگوں نے عاریۃَ کوئی چیز لی ، اس سے فائدہ اٹھاتے رہے ، جب ان سے واپسی کا مطالبہ ہو ، کیا وہ انکار کر سکتے ہیں آ انہوں نے کہا نہیں ، انہوں نے کہا کہ پھر اپنے بیٹے پر صبر کیجئے ۔ صبح ہوئی تو وہ نبی ﷽ کی خدمت میں حاضر ہوئے اور سارا واقعہ ذکر کیا ، نبی ﷽ نے فرمایا اللہ تم دونوں میاں بیوی کے لئے اس رات کو مبارک فرمائے ، چنانچہ وہ امید سے ہو گئیں ، نبی ﷽ ایک مرتبہ سفر میں تھے ، حضرت ام سلیم رضی اللہ عنہا بھی ان کے ہمراہ تھیں ، نبی ﷽ کا معمول تھا کہ سفر سے واپس آنے کے بعد رات کے وقت مدینہ میں داخل نہیں ہوتے تھے ، وہ مدینہ منورہ کے قریب پہنچے تو حضرت ام سلیم رضی اللہ عنہا کو درد کی شدت نے ستایا ، حضرت ابوطلحہ رضی اللہ عنہ ان کے ساتھ رک گئے اور نبی ﷽ چلے گئے ، حضرت ابوطلحہ رضی اللہ عنہ کہنے لگے کہ اے اللہ ! تو جانتا ہے کہ مجھے یہ بات بڑی محبوب ہے کہ تیرے رسول جب مدینہ سے نکلیں تو میں بھی ان کے ساتھ نکلوں اور جب داخل ہوں تو میں بھی داخل ہوں اور اب تو دیکھ رہا ہے کہ میں کیسے رک گیا ہوں ، حضرت ام سلیم رضی اللہ عنہا نے کہا کہ اے ابوطلحہ ! اب مجھے درد کی شدت محسوس نہیں ہو رہی ، لہٰذا ہم روانہ ہو گئے ، اور مدینہ پہنچ کر ان کی تکلیف دوبارہ بڑھ گئی ، اور بالآخر ان کے یہاں ایک لڑکا پیدا ہوا ، انہوں نے مجھ سے کہا کہ انس ! اسے کوئی عورت دودھ نہ پلائے ، بلکہ تم پہلے اسے نبی ﷽ کے پاس لے کر جاا ، چنانچہ صبح کو میں اس بچے کو اٹھا کر نبی ﷽ کی خدمت میں حاضر ہوا ، میں نے دیکھا کہ نبی ﷽ اپنے اونٹوں کو قطران مل رہے ہیں ، نبی ﷽ نے مجھے دیکھتے ہی فرمایا شاید ام سلیم کے یہاں بچہ پیدا ہوا ہے ، میں نے عرض کیا جی ہاں ! اور اس بچے کو نبی ﷽ کی گود میں رکھ دیا ، نبی ﷽ نے عجوہ کھجوریں منگوائیں ، ایک کجھور لے کر اسے منہ میں چبا کر نرم کیا ، اور تھوک جمع کر کے اس کے منہ میں ٹپکا دیا جسے وہ چاٹنے لگا ، نبی ﷽ نے فرمایا کھجور انصار کی محبوب چیز ہے ، اور اس کا نام عبداللہ رکھ دیا ۔"
"13058","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کو کسی لشکر کا اتنا دکھ نہیں ہوا ، جتنا بیر معونہ والے لشکر پر ہوا ، آپ ﷽ نے ایک مہینے تک فجر کی نماز میں قنوت نازلہ پڑھی اور رعل ، ذکوان ، عصیہ اور بنو لحیان کے قبائل پر بددعاء کرتے رہے ، جنہوں نے انہیں شہید کر دیا تھا ۔"
"13059","حضرت انس رضی اللہ عنہ سے مروی ہے کہ پیر کے دن نبی ﷽ نے اپنے حجرہ مبارکہ کا پردہ ہٹایا ، لوگ اس وقت حضرت ابوبکر صدیق رضی اللہ عنہ کی امامت میں نماز ادا کر رہے تھے ، میں نے نبی ﷽ کے چہرہ مبارک کو دیکھا تو وہ قرآن کا ایک کھلا ہوا صفحہ محسوس ہو رہا تھا ، نبی ﷽ کو دیکھ کر ہمیں اتنی خوشی ہوئی ، قریب تھا کہ ہم آزمائش میں پڑ جاتے ، حضرت ابوبکر صدیق رضی اللہ عنہ نے اپنی جگہ سے حرکت کرنا چاہی ، لیکن نبی ﷽ نے انہیں اشارے سے اپنی جگہ رہنے کا حکم دیا ، اور پردہ لٹکا لیا اور اسی دن آپ ﷽ دنیا سے رخصت ہو گئے ، حضرت عمر رضی اللہ عنہ کھڑے ہو گئے اور کہنے لگے کہ نبی ﷽ کا وصال نہیں ہوا ہے ، ان کے پاس ان کے رب نے ویسا ہی پیغام بھیجا ہے جیسے حضرت موسیٰ علیہ السلام کے پاس بھیجا تھا اور وہ چالیس راتوں تک اپنی قوم سے دور رہے تھے ، بخدا ! مجھے امید ہے کہ نبی ﷽ دوبارہ جسمانی حیات پائیں گے تاکہ ان منافقین کے ہاتھ اور زبانیں کاٹ دیں جو یہ کہتے ہیں کہ نبی ﷽ کا وصال ہو گیا ہے ۔"
"13060","[Darussalam 13029] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13061","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"13062","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے مرض الوفات میں حضرت فاطمہ رضی اللہ عنہا رونے لگیں اور کہنے لگیں ہائے ابا جان ! آپ اپنے رب کے کتنے قریب ہو گئے ، ہائے ابا جان ! جبریل کو میں آپ کی رخصتی کی خبر دیتی ہوں ، ہائے ابا جان ! آپ کا ٹھکانہ جنت الفردوس ہے ۔"
"13063","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے عورتوں سے بیعت لیتے ہوئے ارشاد فرمایا کہ وہ نوحہ نہیں کریں گی ، اس پر عورتوں نے کہا کہ یا رسول اللہ ! زمانہ جاہلیت میں کچھ عورتوں نے ہمیں پرسہ دیا تھا ، کیا ہم انہیں اسلام میں پرسہ دے سکتے ہیں آ نبی ﷽ نے فرمایا اسلام میں اس کی کوئی حیثیت نہیں ، نیز اسلام میں وٹے سٹے کے نکاح کی """" جس میں کوئی مہر مقرر نہ کیا گیا ہو """" کوئی حیثیت نہیں ہے ، اسلام میں فرضی محبوبااں کے نام لے کر اشعار میں تشبیہات دینے کی کوئی حیثیت نہیں ، اسلام میں کسی قبیلے کا حلیف بننے کی کوئی حیثیت نہیں ، زکوٰۃ وصول کرنے والے کا اچھا مال چھانٹ لینا یا لوگوں کا زکوٰۃ سے بچنے کے حیلے اختیار کرنا بھی صحیح نہیں ہے اور جو شخص لوٹ مار کرے وہ ہم میں سے نہیں ہے ۔"
"13064","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے مجھ سے سحری کے وقت فرمایا کہ انس ! میں روزہ رکھنا چاہتا ہوں ، مجھے کچھ کھلا ہی دو ، میں کچھ کھجوریں اور ایک برتن میں پانی لے کر حاضر ہوا ، اس وقت تک حضرت بلال رضی اللہ عنہ اذان دے چکے تھے ، نبی ﷽ نے فرمایا انس ! کوئی آدمی تلاش کر کے لاا جو میرے ساتھ کھانے میں شریک ہو سکے ، چنانچہ میں حضرت زید بن ثابت رضی اللہ عنہ کو بلا کر لے آیا ، وہ کہنے لگے یا رسول اللہ ﷽ ! میں نے ستواں کا شربت پیا ہے ، اور میرا ارادہ روزہ رکھنے کا ہے ، نبی ﷽ نے فرمایا میرا ارادہ بھی روزہ رکھنے کا ہی ہے ، پھر دونوں نے اکٹھے سحری کی ، اس کے بعد نبی ﷽ نے دو رکعتیں پڑھیں اور باہر نکل آئے اور نماز کھڑی ہو گئی ۔"
"13065","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے دس سال سفر و حضر میں نبی ﷽ کی خدمت کا شرف حاصل کیا ہے ، نبی ﷽ نے مجھے کبھی برا بھلا نہیں کہا ، نبی ﷽ نے مجھے کبھی اف تک نہیں کہا ، نبی ﷽ نے مجھ سے کبھی یہ نہیں فرمایا کہ تم نے یہ کام کیوں کیا آ یا یہ کام تم نے کیوں نہیں کیا آ"
"13066","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب حدیبیہ سے واپس آ رہے تھے تو اس موقع پر آپ ﷽ پر یہ آیت نازل ہوئی """" انا فتحنا لک فتحا مبینا ۔۔۔۔۔۔ صراطا مستقیما """" نبی ﷽ نے فرمایا مجھ پر دو ایک آیت ایسی نازل ہوئی ہے جو مجھے ساری دنیا سے زیادہ محبوب ہے ، پھر نبی ﷽ نے اس کی تلاوت فرمائی ، تو ایک مسلمان نے یہ سن کر کہا یا رسول اللہ ﷽ ! آپ کو مبارک ہو کہ اللہ نے آپ کو یہ دولت عطاء فرمائی ، ہمارے لیے کیا حکم ہے آ اس پر یہ آیت نازل ہوئی """" لیدخل المومنین والمومنات جنات ۔۔۔۔۔۔ فوزا عظیما """""
"13067","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا عنقریب میری امت میں اختلاف اور تفرقہ بازی ہو گی ، اور ان میں سے ایک قوم ایسی نکلے گی جو قرآن پڑھتی ہو گی لیکن وہ اس کے حلق سے نیچے نہیں اترے گا ، ان کا شعار سر منڈوانا اور چھوٹے بالوں کو جڑ سے اکھیڑنا ہو گا ، تم انہیں جب دیکھو تو قتل کر دو ۔"
"13068","حضرت انس رضی اللہ عنہ نے ایک مرتبہ لوگوں سے فرمایا کہ کیا میں تمہیں نبی ﷽ جیسی نماز نہ پڑھااں آ پھر انہوں نے عمدہ طریقے سے نماز پڑھائی اور اسے زیادہ لمبا نہیں کیا ۔"
"13069","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ ہمارے گھر تشریف لائے ، ہم نے ایک پالتو بکری کا دودھ دوہا اور گھر کے کنویں میں سے پانی لے کر اس میں ملایا اور نبی ﷽ کی خدمت میں پیش کر دیا ، نبی ﷽ کی دائیں جانب ایک دیہاتی تھا ، اور بائیں جانب حضرت ابوبکر صدیق رضی اللہ عنہ تھے ، نبی ﷽ جب اسے نوش فرما چکے تو حضرت عمر رضی اللہ عنہ نے عرض کیا کہ یہ ابوبکر کو دے دیجئے ، لیکن نبی ﷽ نے دودھ کا وہ برتن دیہاتی کو دے دیا اور فرمایا پہلے دائیں ہاتھ والے کو ، پھر اس کے بعد والے کو ۔"
"13070","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے سامنے سے ایک جنازہ گذرا ، کسی شخص نے اس کی تعریف کی ، پھر کئی لوگوں نے اس کی تعریف کی اور کہنے لگے کہ ہمارے علم کے مطابق یہ شخص اللہ اور اس کے رسول ﷽ سے محبت کرتا تھا ، نبی ﷽ نے فرمایا واجب ہو گئی ، پھر دوسرا جنازہ گذرا اور لوگوں نے اس کی مذمت کی ، ان کی دیکھا دیکھی بہت سے لوگوں نے اس کی مذمت بیان کی اور کہنے لگے کہ اللہ کے دین کے حوالے سے یہ بدترین آدمی تھا ، نبی ﷽ نے فرمایا واجب ہو گئی ، تم لوگ زمین میں اللہ کے گواہ ہو ۔"
"13071","مروان """" جو کہ ہند بنت مہلب کے آزاد کردہ غلام تھے """" کہتے ہیں کہ مجھے ہند نے حضرت انس رضی اللہ عنہ کے پاس اپنے کسی کام سے بھیجا تو ، میں نے انہیں اپنے ساتھیوں کو یہ حدیث سناتے ہوئے سنا کہ نبی ﷽ نے صوم وصال + بغیر افطاری کے مسلسل کئی دن تک روزہ رکھنے , سے منع فرمایا ہے ۔"
"13072","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے غزوہ حنین کے دن اعلان فرما دیا کہ جو شخص کسی کافر کو قتل کرے گا ، اس کا ساز و سامان اسی کو ملے گا ، چنانچہ حضرت ابوطلحہ رضی اللہ عنہ نے اکیس آدمیوں کو قتل کر کے ان کا سامان حاصل کیا ۔"
"13073","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ حنین کے دن حضرت ابوطلحہ رضی اللہ عنہ نبی ﷽ کو ہنسانے کے لئے آئے اور عرض کیا یا رسول اللہ ! ام سلیم کو تو دیکھیں کہ ان کے پاس خنجر ہے ، نبی ﷽ نے ان سے پوچھا کہ اے ام سلیم ! تم اس کا کیا کرو گی آ انہوں نے کہا کہ اگر کوئی مشرک میرے قریب آیا تو میں اس سے اس کا پیٹ پھاڑ دوں گی ۔"
"13074","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کے پاس ہدیہ کے طور پر تین پرندے آئے ، نبی ﷽ نے ان میں سے ایک پرندہ اپنی ایک خادمہ کو دے دیا ، اگلے دن اس نے وہی پرندہ نبی ﷽ کی خدمت میں پیش کیا تو نبی ﷽ نے فرمایا کیا میں نے تمہیں اگلے دن کے لئے کوئی چیز اٹھا رکھنے سے منع نہیں کیا تھا آ ہر دن کا رزق اللہ خود دیتا ہے ۔"
"13075","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے بارگاہ نبوت میں عرض کیا یا رسول اللہ ﷽ ! ہم میں سے جب کوئی اپنے دوست سے ملے تو کیا اس سے جھک کر مل سکتا ہے آ نبی ﷽ نے فرمایا نہیں ، سائل نے پوچھا کیا اس سے چمٹ کر اسے بوسہ دے سکتا ہے آ نبی ﷽ نے فرمایا نہیں ، سائل نے پوچھا کہ مصافحہ کر سکتا ہے آ نبی ﷽ نے فرمایا ہاں ! اگر چاہے تو مصافحہ کر سکتا ہے ۔"
"13076","حضرت انس رضی اللہ عنہ سے مروی ہے کہ قبیلہ عکل کے آٹھ آدمی نبی ﷽ کے پاس آ کر مسلمان ہو گئے ، لیکن انہیں مدینہ منورہ کی آب و ہوا موافق نہ آئی ، نبی ﷽ نے ان سے فرمایا کہ اگر تم ہمارے اونٹوں کے پاس جا کر ان کا دودھ اور پیشاب پیو تو شاید تندرست ہو جاا ، چنانچہ انہوں نے ایسا ہی کیا ، لیکن جب وہ صحیح ہو گئے تو دوبارہ مرتد ہو کر کفر کی طرف لوٹ گئے ، نبی ﷽ کے مسلمان چرواہے کو قتل کر دیا ، اور نبی ﷽ کے اونٹوں کو بھگا کر لے گئے ، نبی ﷽ نے ان کے پیچھے صحابہ رضی اللہ عنہ کو بھیجا ، انہیں پکڑ کر نبی ﷽ کے سامنے پیش کیا گیا ، نبی ﷽ نے ان کے ہاتھ پااں مخالف سمت سے کٹوا دئیے ، ان کی آنکھوں میں سلائیاں پھروا دیں اور انہیں پتھریلے علاقوں میں چھوڑ دیا یہاں تک کہ وہ مر گئے ۔"
"13077","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب نبی ﷽ نے عجمیوں کو خط لکھنے کا ارادہ کیا تو صحابہ کرام رضی اللہ عنہم نے عرض کیا کہ وہ لوگ صرف مہر شدہ خطوط ہی پڑھتے ہیں ، چنانچہ نبی ﷽ نے چاندی کی انگوٹھی بنوا لی ، اس کی سفیدی اب تک میری نگاہوں کے سامنے ہے ، اس پر یہ عبارت نقش تھی """" محمد رسول اللہ """" ﷽ ۔"
"13078","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک دیہاتی آیا اور کہنے لگا یا رسول اللہ ﷽ ! قیامت کب قائم ہو گی آ نبی ﷽ نے فرمایا تم نے قیامت کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کہ اللہ اور اس کے رسول ﷽ کی محبت ، نبی ﷽ نے فرمایا کہ تم اس کے ساتھ ہو گے جس سے تم محبت کرتے ہو ۔"
"13079","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا کسی شخص کا ایمان اس وقت تک مستقیم نہیں ہو سکتا جب تک اس کا دل مستقیم نہ ہو ، اور دل اس وقت تک مستقیم نہیں ہو سکتا جب تک زبان مستقیم نہ ہو ، اور کوئی ایسا شخص جنت میں داخل نہیں ہو گا جس کا پڑوسی اس کی ایذاء رسانی سے محفوظ نہ ہو ۔"
"13080","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ہر انسان خطاکار ہے اور بہترین خطاکار وہ لوگ ہیں جو توبہ کرنے والے ہوں اور اگر ابن آدم کے پاس مال سے بھری ہوئی دو وادیاں بھی ہوتیں تو وہ تیسری کی تمنا کرتا اور ابن آدم کا پیٹ صرف قبر کی مٹی ہی بھر سکتی ہے ۔"
"13081","حضرت انس رضی اللہ عنہ سے نبی ﷽ کی قراءت کی کیفیت کے متعلق مروی ہے کہ نبی ﷽ اپنی آواز کو کھینچا کرتے تھے ۔"
"13082","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ بڑھاپے کی اس عمر کو پہنچے ہی نہیں کہ خضاب لگانے کی نوبت آتی ، البتہ حضرت صدیق اکبر رضی اللہ عنہ مہندی اور وسمہ کا خضاب لگاتے تھے ۔"
"13083","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا یہ دین بڑا سنجیدہ اور مضبوط ہے ، لہٰذا اس میں نرمی کو شامل رکھا کرو ۔"
"13084","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا آپس میں قطع تعلقی ، بغض ، پشت پھیرنا اور حسد نہ کیا کرو اور اللہ کے بندو ! بھائی بھائی بن کر رہا کرو ، اور کسی مسلمان کے لئے اپنے بھائی سے تین دن سے زیادہ قطع کلامی کرنا حلال نہیں ہے ۔"
"13085","حضرت انس رضی اللہ عنہ سے مروی ہے کہ صحابہ کرام رضی اللہ عنہم میں سے حضرت امام حسن رضی اللہ عنہ سب سے بڑھ کر نبی ﷽ کے مشابہہ تھے ۔"
"13086","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ام سلیم رضی اللہ عنہا نے نبی ﷽ سے پوچھا کہ اگر عورت بھی اسی طرح """" خواب دیکھے """" جسے مرد دیکھتا ہے تو کیا حکم ہے آ نبی ﷽ نے فرمایا جو عورت ایسا """" خواب دیکھے """" اور اسے انزال ہو جائے تو اسے غسل کرنا چاہئے ۔ ام المومنین حضرت ام سلمہ رضی اللہ عنہا نے عرض کیا یا رسول اللہ ﷽ ! کیا ایسا بھی ہو سکتا ہے آ نبی ﷽ نے فرمایا ہاں ! مرد کا پانی گاڑھا اور سفید ہوتا ہے اور عورت کا پانی پیلا اور پتلا ہوتا ہے ، دونوں میں سے جو غالب آ جائے بچہ اسی کے مشابہہ ہوتا ہے ۔"
"13087","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا مجھے اس بات کا حکم دیا گیا ہے کہ لوگوں سے اس وقت تک قتال کرتا رہوں جب تک وہ اس بات کی گواہی نہ دینے لگیں کہ اللہ کے علاوہ کوئی معبود نہیں اور محمد ﷽ اللہ کے رسول ہیں ، جب وہ اس بات کی گواہی دینے لگیں ، ہمارے قبلے کا رخ کرنے لگیں ، ہمارا ذبیحہ کھانے لگیں اور ہماری طرح نماز پڑھنے لگیں تو ہم پر ان کی جان و مال کا احترام واجب ہو گیا ، سوائے اس کلمے کے حق کے ، ان کے حقوق بھی عام مسلمانوں کی طرح ہوں گے اور ان کے فرائض بھی دیگر مسلمانوں کی طرح ہوں گے ۔"
"13088","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا دنیا میں سے میرے نزدیک صرف عورت اور خوشبو کی محبت ڈالی گئی ہے اور میری آنکھوں کی ٹھنڈک نماز میں رکھی گئی ہے ۔"
"13089","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مسجد نبوی میں جب ماذن کھڑا ہو کر اذان مغرب دیتا تھا تو اس کے بعد جو چاہتا وہ نماز پڑھتا رہتا تھا ، یہاں تک کہ نماز کھڑی ہو جاتی اور جو چاہتا وہ دو رکعتیں پڑھ کر بیٹھ جاتا اور یہ سب کچھ نبی ﷽ کی نگاہوں کے سامنے ہوتا تھا ۔"
"13090","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم لوگ نبی ﷽ کے ساتھ مغرب کی نماز پڑھتے تھے ، پھر ہم میں سے کوئی شخص بنو سلمہ کے پاس جاتا تو اس وقت بھی وہ اپنا تیر گرنے کی جگہ کو بخوبی دیکھ سکتا تھا ۔"
"13091","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کا وقت ہو گیا ، نبی ﷽ ایک آدمی کے ساتھ مسجد میں تنہائی میں گفتگو فرما رہے تھے ، جس وقت آپ ﷽ نماز کے لئے اٹھے تو بعض لوگ اونگھنے لگے تھے ۔"
"13092","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے مجھے """" اے میرے پیارے بیٹے ! """" کہہ کر مخاطب کیا تھا ۔"
"13093","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے اس بات سے منع فرمایا ہے کہ کوئی شخص کھڑے ہو کر پیے میں نے کھانے کا حکم پوچھا تو فرمایا یہ اس سے بھی زیادہ سخت ہے ۔"
"13094","عاصم رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ کیا نبی ﷽ نے مدینہ منورہ کو حرم قرار دیا تھا آ انہوں نے فرمایا ہاں ! یہ حرم ہے ، اللہ اور اس کے رسول نے اسے حرم قرار دیا ہے ، اس کی گھاس تک نہیں کاٹی جا سکتی ، جو شخص ایسا کرتا ہے اس پر اللہ ، فرشتوں اور تمام لوگوں کی لعنت ہے ۔"
"13095","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اس بات کو پسند فرماتے تھے کہ نماز میں مہاجرین اور انصار مل کر ان کے قریب کھڑے ہوں تاکہ مسائل نماز سیکھ لیں ۔"
"13096","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ ایک مرتبہ رات کے وقت اپنے حجرے میں نماز پڑھ رہے تھے ، کچھ لوگ آئے اور وہ نبی ﷽ کی نماز میں شریک ہو گئے ، نبی ﷽ نماز مختصر کر کے اپنے گھر میں تشریف لے گئے ، ایسا کئی مرتبہ ہوا حتیٰ کہ صبح ہو گئی ، تب لوگوں نے عرض کیا یا رسول اللہ ﷽ ! آپ نماز پڑھ رہے تھے ، ہماری خواہش تھی کہ آپ اسے لمبا کر دیتے ، نبی ﷽ نے فرمایا مجھے تمہاری موجودگی کا علم تھا لیکن میں نے جان بوجھ کر ہی ایسا کیا تھا ۔"
"13097","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کو قبلہ مسجد کی طرف تھوک لگا ہوا نظر آیا ، نبی ﷽ کی طبیعت پر یہ چیز اتنی شاق گزری کہ چہرہ مبارک پر ناگواری کے آثار واضح ہو گئے ، نبی ﷽ نے اسے صاف کر کے فرمایا کہ انسان جب نماز پڑھنے کے لئے کھڑا ہوتا ہے تو اپنے رب سے مناجات کرتا ہے ، اس لئے اسے چاہئے کہ اپنی بائیں جانب یا پااں کے نیچے تھوکے ، اور اس طرح اشارہ کیا کہ اسے کپڑے میں لے کر مل لے ۔"
"13098","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی مدینہ منورہ تشریف آوری پر حضرت ام سلیم رضی اللہ عنہا میرا ہاتھ پکڑ کر نبی ﷽ کے پاس آئیں اور کہنے لگیں یا رسول اللہ ﷽ ! یہ میرا بیٹا ہے اور لکھنا جانتا ہے ، چنانچہ میں نے نو سال تک نبی ﷽ کی خدمت کی ، میں نے جس کام کو کر لیا ہو ، نبی ﷽ نے کبھی مجھ سے یہ نہیں فرمایا کہ تم نے بہت برا کیا ، یا غلط کیا ۔"
"13099","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہمیں اس بات سے بڑی خوشی ہوتی تھی کہ کوئی دیہاتی آ کر نبی ﷽ سے سوال کرے ، چنانچہ ایک مرتبہ ایک دیہاتی آیا اور کہنے لگا یا رسول اللہ ﷽ ! قیامت کب قائم ہو گی آ اس وقت اقامت ہو چکی تھی اس لئے نبی ﷽ نماز پڑھانے لگے ، نماز سے فارغ ہو کر فرمایا کہ قیامت کے متعلق سوال کرنے والا آدمی کہاں ہے آ اس نے کہا یا رسول اللہ ﷽ ! میں یہاں ہوں ، نبی ﷽ نے فرمایا تم نے قیامت کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کہ میں نے کوئی بہت زیادہ اعمال ، نماز ، روزہ تو مہیا نہیں کر رکھے ، البتہ اتنی بات ضرور ہے کہ میں اللہ اور اس کے رسول سے محبت کرتا ہوں ، نبی ﷽ نے فرمایا کہ انسان قیامت کے دن اس شخص کے ساتھ ہو گا جس کے ساتھ وہ محبت کرتا ہے ، حضرت انس رضی اللہ عنہ فرماتے ہیں کہ میں نے مسلمانوں کو اسلام قبول کرنے کے بعد اس دن جتنا خوش دیکھا ، اس سے پہلے کبھی نہیں دیکھا ۔"
"13100","حمید رحمۃ اللہ کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے پوچھا کیا نبی ﷽ نے انگوٹھی بنوائی تھی آ انہوں نے فرمایا ہاں ! ایک مرتبہ نبی ﷽ نے نماز عشاء کو نصف رات تک موخر کر دیا ، اور نماز کے بعد ہماری طرف متوجہ ہو کر فرمایا لوگ نماز پڑھ کر سو گئے لیکن تم نے جتنی دیر تک نماز کا انتظار کیا ، تم نماز ہی میں شمار ہوئے ، اس وقت نبی ﷽ کی انگوٹھی کی سفیدی اب تک میری نگاہوں کے سامنے ہے ۔"
"13101","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے کسی مہینے کے آخر میں صوم وصال فرمایا ، کچھ لوگوں نے بھی ایسا ہی کیا ، نبی ﷽ کو خبر ہوئی تو فرمایا کہ اگر یہ مہینہ لمبا ہو جاتا تو میں اتنے دن مسلسل روزہ رکھتا کہ دین میں تعمق کرنے والے اپنا تعمق چھوڑ دیتے ، میں تمہاری طرح نہیں ہوں ، مجھے تو میرا رب کھلاتا پلاتا رہتا ہے ۔"
"13102","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کے پااں میں موچ آ گئی اور آپ ﷽ اپنے بالا خانے میں فروکش ہو گئے ، جس کی سیڑھیاں لکڑی کی تھیں ، اور ازواج مطہرات سے ایک مہینے کے لئے ایلاء کر لیا ، صحابہ کرام رضی اللہ عنہم نبی ﷽ کی عیادت کے لئے آئے تو نبی ﷽ نے انہیں بیٹھ کر نماز پڑھائی جب کہ صحابہ کرام رضی اللہ عنہم کھڑے رہے ، جب اگلی نماز کا وقت ہوا تو نبی ﷽ نے ان سے فرمایا کہ اپنے امام کی اقتداء کیا کرو ، اگر وہ کھڑے ہو کر نماز پڑھے تو تم بھی کھڑے ہو کر نماز پڑھو ، اور اگر وہ بیٹھ کر نماز پڑھے تو تم بھی اس کے ساتھ بیٹھ کر نماز پڑھو ، الغرض ! 5< دن گذرنے کے بعد نبی ﷽ نیچے اتر آئے ، لوگوں نے پوچھا یا رسول اللہ ﷽ ! آپ نے تو ایک مہینے کے لئے ایلاء فرمایا تھا آ نبی ﷽ نے فرمایا مہینہ بعض اوقات 5< دن کا بھی ہوتا ہے ۔"
"13103","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت زینب رضی اللہ عنہا کے ولیمے میں مسلمانوں کو خوب پیٹ بھر کر روٹی اور گوشت کھلایا ، پھر حسب معمول واپس تشریف لے گئے اور ازواج مطہرات کے گھر میں جا کر انہیں سلام کیا اور انہوں نے نبی ﷽ کے لئے دعائیں کیں ، پھر واپس تشریف لائے ، جب گھر پہنچے تو دیکھا کہ دو آدمیوں کے درمیان گھر کے ایک کونے میں باہم گفتگو جاری ہے ، نبی ﷽ ان دونوں کو دیکھ کر پھر واپس چلے گئے ، جب ان دونوں نے نبی ﷽ کو اپنے گھر سے پلٹتے ہوئے دیکھا تو وہ جلدی سے اٹھ کھڑے ہوئے ، اب مجھے یاد نہیں کہ نبی ﷽ کو ان کے جانے کی خبر میں نے دی یا کسی اور نے ، بہرحال ! نبی ﷽ گھر واپس آ گئے ۔"
"13104","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی ساری نمازیں قریب قریب برابر ہوتی تھیں ، اسی طرح حضرت ابوبکر صدیق رضی اللہ عنہ کی نمازیں بھی ، لیکن حضرت عمر رضی اللہ عنہ نے فجر کی نماز طویل کرنا شروع فرمائی ۔"
"13105","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کی مہک سے عمدہ مشک و عنبر کی کوئی مہک نہیں سونگھی اور نبی ﷽ کی ہتھیلی سے زیادہ نرم کوئی ریشم بھی نہیں چھوا ۔"
"13106","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ مہاجرین صحابہ رضی اللہ عنہم نے بارگاہ نبوت میں عرض کیا یا رسول اللہ ﷽ ! جس قوم کے پاس ہم آئے ہیں + انصار , ہم نے تھوڑے میں ان جیسا بہترین غمخوار اور زیادہ میں ان جیسا بہترین خرچ کرنے والا کسی قوم کو نہیں پایا ، انہوں نے ہمارا بوجھ اٹھایا اور اپنی ہر چیز میں ہمیں شریک کیا ، حتیٰ کہ ہم تو یہ سمجھنے لگے ہیں کہ سارا اجر و ثواب تو یہی لوگ لے جائیں گے ، نبی ﷽ نے فرمایا نہیں ، جب تک تم ان کا شکریہ ادا کرتے رہو گے اور اللہ تعالیٰ سے ان کے لئے دعاء کرتے رہو گے ۔"
"13107","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ یہ دعاء فرمایا کرتے تھے اے اللہ ! میں سستی ، بڑھاپے ، بزدلی ، بخل ، فتنہ دجال اور عذاب قبر سے آپ کی پناہ میں آتا ہوں ۔"
"13108","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ام سلیم رضی اللہ عنہما کا ایک چھوٹا بیٹا """" جس کا نام ابوعمیر تھا """" نبی ﷽ اس کے ساتھ ہنسی مذاق کیا کرتے تھے ، ایک دن نبی ﷽ نے اسے غمگین دیکھا تو فرمایا کیا بات ہے ابوعمیر غمگین دکھائی دے رہا ہے آ گھر والوں نے بتایا کہ اس کی ایک چڑیا مر گئی ہے جس کے ساتھ یہ کھیلتا تھا ، اس پر نبی ﷽ کہنے لگے اے ابوعمیر ! کیا کیا نغیر آ + چڑیا ، جو مر گئی تھی ,"
"13109","حمید کہتے ہیں کسی شخص نے حضرت انس رضی اللہ عنہ سے پوچھا کہ کیا نبی ﷽ خضاب لگاتے تھے آ انہوں نے فرمایا کہ نبی ﷽ کی مبارک ڈاڑھی کے اگلے حصے میں صرف تھوڑے سے بال سفید تھے ، اور ان پر بڑھاپے کا عیب نہیں آیا ، کسی نے پوچھا کہ کیا بڑھاپا عیب ہے آ انہوں نے فرمایا تم میں سے ہر شخص اسے ناپسند سمجھتا ہے ۔"
"13110","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اپنے بھائی کی مدد کیا کرو ، خواہ وہ ظالم ہو یا مظلوم ، کسی نے پوچھا یا رسول اللہ ﷽ ! مظلوم کی مدد کرنا تو سمجھ میں آتا ہے ، ظالم کی کیسے مدد کریں آ فرمایا اسے ظلم کرنے سے روکو ، یہی اس کی مدد ہے ۔"
"13111","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ مدینہ منورہ میں بنو نجار کے کسی باغ سے گذرے ، وہاں کسی قبر سے آواز سنائی دی ، نبی ﷽ نے اس کے متعلق دریافت فرمایا کہ اس قبر میں مردے کو کب دفن کیا گیا تھا لوگوں نے بتایا کہ یا رسول اللہ ﷽ ! یہ شخص زمانہ جاہلیت میں دفن ہوا تھا ، نبی ﷽ نے فرمایا اگر تم لوگ اپنے مردوں کو دفن کرنا چھوڑ نہ دیتے تو میں اللہ سے یہ دعاء کرتا کہ وہ تمہیں بھی عذاب قبر کی آواز سنا دے ۔"
"13112","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا دجال کی بائیں آنکھ پونچھ دی گئی ہو گی ، اس پر موٹی پھلی ہو گی ، اور اس کی دونوں آنکھوں کے درمیان """" کافر """" لکھا ہو گا ۔"
"13113","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا قیامت اس وقت تک قائم نہیں ہو گی جب تک زمین میں اللہ اللہ کہنے والا کوئی شخص باقی ہے ۔"
"13114","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ احد کے دن نبی ﷽ کے اگلے چار دانت ٹوٹ گئے تھے اور آپ ﷽ کی پیشانی پر بھی زخم آیا تھا ، اور کندھے پر تیر لگا تھا ، حتیٰ کہ اس کا خون آپ ﷽ کے چہرہ مبارک پر بہنے لگا ، اس پر نبی ﷽ نے اپنے چہرے سے خون پونچھتے ہوئے فرمایا وہ قوم کیسے فلاح پائے گی جو اپنے نبی کے ساتھ یہ سلوک کرے جب کہ وہ انہیں ان کے رب کی طرف بلا رہا ہو آ اس پر یہ آیت نازل ہوئی کہ """" آپ کو کسی قسم کا کوئی اختیار نہیں ہے کہ اللہ ان پر متوجہ ہو جائے ، یا انہیں سزا دے کہ وہ ظالم ہیں ۔"""""
"13115","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ حنین کے موقع پر اللہ نے جب بنو ہوازن کا مال غنیمت نبی ﷽ کو عطاء فرمایا اور نبی ﷽ عیینہ اور اقرع وغیرہ ایک ایک آدمی کو سو سو اونٹ دینے لگے تو انصار کے کچھ لوگ کہنے لگے نبی ﷽ ان لوگوں کو دیئے جا رہے ہیں اور ہمیں نظر انداز کر رہے ہیں جب کہ ہماری تلواروں سے ابھی تک تک ان کے خون کے قطرے ٹپک رہے ہیں ۔ نبی ﷽ کو یہ بات معلوم ہوئی تو آپ ﷽ نے انصاری صحابہ رضی اللہ عنہم کو بلا بھیجا اور فرمایا کیا تمہارے درمیان تمہارے علاوہ کوئی اور بھی ہے آ انہوں نے عرض کیا کہ نہیں ، البتہ ہمارا ایک بھانجا ہے ، نبی ﷽ نے فرمایا قوم کا بھانجا ان ہی میں شمار ہوتا ہے ، کیا تم نے ایسی ایسی بات کہی ہے آ کیا تم لوگ اس بات پر خوش نہیں ہو کہ لوگ مال و دولت لے کر چلے جائیں اور تم پیغمبر خدا کو اپنے خیموں میں لے جاا ، وہ کہنے لگے کیوں نہیں یا رسول اللہ ، پھر نبی ﷽ نے فرمایا اس ذات کی قسم جس کے دست قدرت میں محمد ﷽ کی جان ہے ، اگر لوگ ایک وادی میں چل رہے ہوں اور انصار دوسری گھاٹی میں تو میں انصار کے راستے کو اختیار کروں گا ، انصار میرا پردہ ہیں ، اور اگر ہجرت نہ ہوتی تو میں انصار ہی کا ایک فرد ہوتا ۔"
"13116","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میرے چچا انس بن نضر جو غزوہ بدر میں نبی ﷽ کے ساتھ شریک نہیں ہو سکے تھے ، اور اس کا انہیں افسوس تھا اور وہ کہا کرتے تھے کہ میں نبی ﷽ کے ساتھ سب سے پہلے غزوہ میں شریک نہیں ہو سکا ، اگر اب اللہ نے نبی ﷽ کے ساتھ کسی غزوے کا موقع عطاء کیا تو اللہ دیکھے گا کہ میں کیا کرتا ہوں ، چنانچہ وہ غزوہ احد میں نبی ﷽ کے ساتھ شریک ہوئے ، اس موقع پر مسلمان منتشر ہو گئے تو وہ کہنے لگے یا اللہ ! میں اپنے ساتھیوں کی اس حرکت پر آپ سے عذر کرتا ہوں اور مشرکین کے اس حملے سے بیزاری ظاہر کرتا ہوں ، پھر وہ آگے بڑھے تو انہیں اپنے سامنے سے حضرت سعد بن معاذ رضی اللہ عنہ آتے ہوئے دکھائی دیئے ، وہ ان سے کہنے لگے کہ ابوعمرو ! کہاں جا رہے ہو آ بخدا ! مجھے تو احد کے پیچھے سے جنت کی خوشبو آ رہی ہے ، حضرت سعد رضی اللہ عنہ نے کہا میں آپ کے ساتھ ہوں ، لیکن بعد میں وہ کہتے تھے کہ جو کام انس نے کر دیا وہ میں نہ کر سکا ، اور ان کے جسم پر نیزوں ، تلواروں اور تیروں کے اسی سے زیادہ نشانات پائے گئے ، ہم سمجھتے تھے کہ یہ آیت حضرت انس رضی اللہ عنہ اور ان جیسے دوسرے صحابہ رضی اللہ عنہم کے بارے نازل ہوئی ہے ۔ """" کچھ لوگ وہ ہیں جنہوں نے اللہ سے کیا ہوا وعدہ سچ کر دکھایا ، ان میں سے بعض تو اپنی امید پوری کر چکے اور بعض منتظر ہیں """"۔"
"13117","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب کسی کے یہاں روزہ افطار کرتے تو فرماتے تمہارے یہاں روزہ داروں نے روزہ کھولا ، نیکوں نے تمہارا کھانا کھایا اور رحمت کے فرشتوں نے تم پر نزول کیا 1"
"13118","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ صحابہ کرام رضی اللہ عنہم نے نبی ﷽ سے یہ مسئلہ پوچھا کہ اہل کتاب ہمیں سلام کرتے ہیں ، ہم انہیں کیا جواب دیں آ نبی ﷽ نے فرمایا صرف """" وعلیکم """" کہہ دیا کرو ۔"
"13119","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ایک ہی سحری سے مسلسل کئی روزے نہ رکھا کرو ، کسی نے عرض کیا یا رسول اللہ ! آپ تو اس طرح کرتے ہیں آ نبی ﷽ نے فرمایا میں اس معاملے میں تمہاری طرح نہیں ہوں ، میرا رب مجھے کھلا پلا دیتا ہے ۔"
"13120","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضور نبی مکرم سرور دو عالم ﷽ نے فرمایا دجال مدینہ منورہ کی طرف آئے گا لیکن وہاں فرشتوں کو اس کا پہرہ دیتے ہوئے پائے گا ، انشاء اللہ مدینہ میں دجال داخل ہو سکے گا اور نہ ہی طاعون کی وباء ۔"
"13121","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کا گذر ایک آدمی پر ہوا جو قربانی کا جانور ہانکتے ہوئے چلا جا رہا تھا ، نبی ﷽ نے اس سے سوار ہونے کے لئے فرمایا ، اس نے کہا کہ یہ قربانی کا جانور ہے ۔ نبی ﷽ نے پھر اس سے فرمایا کہ سوار ہو جاا ۔"
"13122","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا سجدوں میں اعتدال برقرار رکھا کرو ، اور تم میں سے کوئی شخص کتے کی طرح اپنے ہاتھ نہ بچھائے ۔"
"13123","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک دیہاتی دوران خطبہ آیا اور کہنے لگا یا رسول اللہ ﷽ قیامت کب قائم ہو گی آ نبی ﷽ نے فرمایا تم نے قیامت کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کہ اللہ اور اس کے رسول کی محبت نبی ﷽ نے فرمایا کہ تم اس کے ساتھ ہو گے جس سے تم محبت کرتے ہو ۔"
"13124","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب مرض الوفات میں مبتلا ہوئے تو ایک موقع پر حضرت بلال رضی اللہ عنہ نبی ﷽ کو نماز کی اطلاع دینے کے لئے حاضر ہوئے ، دو مرتبہ کے بعد نبی ﷽ نے ان سے فرمایا بلال ! تم نے پیغام پہنچا دیا ، جو چاہے نماز پڑھ لے اور جو چاہے چھوڑ دے ، حضرت بلال رضی اللہ عنہ نے پلٹ کر پوچھا یا رسول اللہ ﷽ ! آپ پر میرے ماں باپ قربان ہوں لوگوں کو نماز کون پڑھائے گا آ نبی ﷽ نے فرمایا ابوبکر سے جا کر کہو کہ وہ لوگوں کو نماز پڑھا دیں ، جب حضرت ابوبکر رضی اللہ عنہ نماز پڑھانے کے لئے آگے بڑھے تو نبی ﷽ نے گھر کا پردہ ہٹایا ، ایسا محسوس ہوتا تھا جیسے سفید کاغذ ہو اور نبی ﷽ کے جسم پر چادر تھی ، حضرت ابوبکر صدیق رضی اللہ عنہ پیچھے ہٹنے لگے اور یہ سمجھے کہ نبی ﷽ نماز کے لئے تشریف لانا چاہتے ہیں ، لیکن نبی ﷽ نے انہیں اشارے سے فرمایا کہ کھڑے رہیں اور نماز مکمل کریں ، چنانچہ حضرت ابوبکر رضی اللہ عنہ ہی نے لوگوں کو نماز پڑھائی اور اس کے بعد ہم نے نبی ﷽ کو نہیں دیکھا ۔"
"13125","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا کیا میں تمہیں یہ نہ بتااں کہ انصار کے گھروں میں سب سے بہترین گھر کون سا ہے آ لوگوں نے کہا کیوں نہیں ، فرمایا بنو نجار کا گھر ، پھر فرمایا اس کے بعد جو لوگ سب سے بہتر ہیں ان کے بارے بتااں آ لوگوں نے کہا کیوں نہیں فرمایا بنو عبدالاشہل ، پھر فرمایا اس کے بعد جو لوگ سب سے بہتر ہیں ان کے بارے بتااں آ لوگوں نے کہا کیوں نہیں فرمایا بنو حارث بن خزرج پھر فرمایا اس کے بعد جو لوگ سب سے بہتر ہیں ان کے بارے بتااں آ لوگوں نے کہا کیوں نہیں فرمایا بنی ساعدہ پھر آواز بلند کر کے فرمایا انصار کے ہر گھر میں خیر ہے ۔"
"13126","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں تمہیں نبی ﷽ سے سنی ہوئی ایک ایسی حدیث سناتا ہوں جو میرے بعد کوئی تم سے بیان نہ کرے گا ، میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ قیامت کی علامات میں یہ بات بھی ہے کہ علم اٹھا لیا جائے گا ، اس وقت جہالت کا غلبہ ہو گا ، بدکاری عام ہو گی ، اور شراب نوشی بکثرت ہو گی ، مردوں کی تعداد کم ہو جائے گی اور عورتوں کی تعداد بڑھ جائے گی حتیٰ کہ پچاس عورتوں کا ذمہ دار صرف ایک آدمی ہو گا ۔"
"13127","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ سفر پر تھے اور حدی خوان امہات المومنین کی سواریوں کو ہانک رہا تھا ، اس نے جانوروں کو تیزی سے ہانکنا شروع کر دیا ، اس پر نبی ﷽ نے فرمایا انجشہ ! ان آبگینوں کو آہستہ لے کر چلو ۔"
"13128","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے انسان کو بائیں ہاتھ سے کھانے پینے سے منع فرمایا ہے ۔"
"13129","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے انسان کو بائیں ہاتھ سے کھانے پینے سے منع فرمایا ہے ۔"
"13130","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت صفیہ رضی اللہ عنہا بنت حیی کو آزاد کر دیا اور ان کی آزادی ہی کو ان کا مہر قرار دے دیا ۔"
"13131","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ابوالقاسم ﷽ نے ارشاد فرمایا جو شخص میری طرف جان بوجھ کر کسی جھوٹی بات کی نسبت کرے ، اسے اپنا ٹھکانہ جہنم میں بنا لینا چاہئے ۔"
"13132","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کی خدمت میں کہیں سے ہدیۃَ کجھوریں آئیں ، نبی ﷽ اسے ایک تھیلی سے تقسیم کرنے لگے ، میں اس میں نبی ﷽ کا قاصد تھا ، یہاں تک کہ نبی ﷽ فارغ ہو گئے اور خود اکڑوں بیٹھ کر جلدی جلدی کھجوریں تناول فرمانے لگے جس سے مجھے نبی ﷽ کی بھوک کا اندازہ ہوا ۔"
"13133","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے مبارک جوتوں کے دو تسمے تھے ۔"
"13134","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور خلفاء ثلاثہ رضی اللہ عنہم نماز میں قراءت کا آغاز ®الحمدللہ رب العلمین¾ سے کرتے تھے ۔"
"13135","حضرت انس رضی اللہ عنہ سے مروی ہے کہ بعض اوقات نبی ﷽ سجدہ یا رکوع سے سر اٹھاتے اور ان دونوں کے درمیان اتنا لمبا وقفہ فرماتے کہ ہمیں یہ خیال ہونے لگتا کہ کہیں نبی ﷽ بھول تو نہیں گئے ۔"
"13136","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا لشکر میں ابوطلحہ رضی اللہ عنہ کی آواز ہی مشرکین پر کئی لوگوں سے بھاری ہے ۔"
"13137","قتادہ رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے نبی ﷽ کے بالوں کے متعلق دریافت کیا تو انہوں نے فرمایا کہ نبی ﷽ کے بال ہلکے گھنگریالے تھے ، نہ بہت زیادہ گھنگریالے اور نہ بہت زیادہ سیدھے ، اور وہ کانوں اور کندھوں کے درمیان تک ہوتے تھے ۔"
"13138","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک بچی زیورات پہن کر اپنے گھر سے نکلی ایک یہودی نے اس بچی کو پکڑ لیا اور اسے اس زیور کی خاطر قتل کر دیا جو اس نے پہن رکھا تھا ، اور پتھر مار مار کر اس کا سر کچل دیا ، جب اس بچی کو نبی ﷽ کے پاس لایا گیا تو اس میں زندگی کی تھوڑی سی رمق باقی تھی ، نبی ﷽ نے ایک آدمی کا نام لے کر اس سے پوچھا کہ تمہیں فلاں آدمی نے مارا ہے آ اس نے سر کے اشارے سے کہا نہیں ، دوسری مرتبہ بھی یہی ہوا ، تیسری مرتبہ اس نے کہا ہاں ! تو نبی ﷽ نے اس یہودی کا سر دو پتھروں کے درمیان کچلنے کا حکم دے دیا ۔"
"13139","[Darussalam 13108] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13140","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب اپنی اونٹنی پر دوران سفر نوافل پڑھنا چاہتے تو قبلہ رخ ہو کر تکبیر کہتے ، پھر اسے چھوڑ دیتے اور اس کا رخ جس سمت میں بھی ہوتا ، نماز پڑھتے رہتے تھے ۔"
"13141","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب قضاء حاجت کے لئے جاتے تو میں اور ایک لڑکا پانی کا ایک برتن اور ایک نیزہ لے کر جاتے تھے اور نبی ﷽ پانی سے استنجاء فرماتے تھے ۔"
"13142","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ہمارے لیے مونچھیں کاٹنے ، ناخن تراشنے اور زیر ناف بال صاف کرنے کی مدت چالیس دن مقرر فرمائی تھی ۔"
"13143","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا قیامت کے دن اہل جہنم میں سے ایک آدمی کو لایا جائے گا جو دنیا میں بڑی نعمتوں میں رہا ہو گا ، اسے جہنم کا ایک چکر لگوایا جائے گا پھر پوچھا جائے گا کہ اے ابن آدم ! کیا تو نے کبھی کوئی خیر دیکھی ہے آ کیا تجھ پر سے کبھی نعمتوں کا گذر ہوا ہے آ وہ کہے گا کہ پروردگار ! قسم کھا کر کہتا ہوں کہ کبھی نہیں ، اس کے بعد اہل جنت میں سے ایک آدمی کو لایا جائے گا جو دنیا میں بڑی مصیبتوں میں رہا ہو گا ، اسے جنت کا ایک چکر لگوایا جائے گا اور پھر پوچھا جائے گا کہ اے ابن آدم ! کیا تو نے کبھی کوئی پریشانی دیکھی ہے آ کیا کبھی تجھ پر کسی سختی کا گذر ہوا ہے آ وہ کہے گا کہ پروردگار ! قسم کھا کر کہتا ہوں کہ کبھی نہیں ، مجھ پر کوئی پریشانی نہیں آئی اور میں نے کوئی تکلیف نہیں دیکھی ۔"
"13144","انس بن سیرین رحمۃ اللہ کہتے ہیں کہ حضرت انس رضی اللہ عنہ جب شام سے واپس آئے تو ہماری ان سے ملاقات ہوئی ، عین التمر نامی جگہ میں ہمارا آمنا سامنا ہوا ، اس وقت وہ اپنی سواری پر قبلہ کی جانب رخ کیے بغیر ہی نماز پڑھ رہے تھے ، ہم نے ان سے کہا کہ آپ قبلہ کی طرف رخ کیے بغیر نماز پڑھ رہے ہیں آ انہوں نے فرمایا کہ اگر میں نے نبی ﷽ کو + نوافل میں , اس طرح کرتے ہوئے نہ دیکھا ہوتا تو میں بھی + نوافل میں , ایسا نہ کرتا ۔"
"13145","مروی ہے کہ ایک مرتبہ حضرت انس رضی اللہ عنہ کے سامنے ایک مرد کا جنازہ لایا گیا ، وہ اس کی چارپائی کے سرہانے کھڑے ہوئے اور عورت کا جنازہ لایا گیا تو چارپائی کے سامنے اس سے نیچے ہٹ کر کھڑے ہوئے ، نماز جنازہ سے جب فارغ ہوئے تو علاء بن زیاد رحمۃ اللہ کہنے لگے کہ اے ابوحمزہ ! جس طرح کرتے ہوئے میں نے آپ کو دیکھا ہے کیا نبی ﷽ بھی مرد و عورت کے جنازے میں اسی طرح کھڑے ہوتے تھے آ انہوں نے فرمایا ہاں ! تو علاء نے ہماری طرف متوجہ ہو کر کہا کہ اسے محفوظ کر لو ۔"
"13146","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں ایک پیالے میں کدو لے کر نبی ﷽ کی خدمت میں حاضر ہوا ، نبی ﷽ کو کدو بہت پسند تھا ، اس لئے اسے اپنی انگلیوں سے تلاش کرنے لگے ۔"
"13147","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے اپنے اس ہاتھ سے نبی ﷽ کی بیعت بات سننے اور ماننے کی شرط پر کی تھی اور نبی ﷽ نے اس میں """" حسب طاقت """" کی قید لگا دی تھی ۔"
"13148","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب ہم لوگ نبی ﷽ کی تدفین سے فارغ ہو کر واپس آئے تو حضرت فاطمہ رضی اللہ عنہا فرمانے لگیں کہ اے انس ! کیا تمہارے دلوں نے اس بات کو گوارا کر لیا کہ تم نبی ﷽ کو مٹی تلے دفن کر دو اور خود واپس آ جاا ۔"
"13149","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کے ساتھ حضرت ام حرام رضی اللہ عنہا کے گھر میں نماز پڑھی ، نبی ﷽ نے مجھے اپنی دائیں جانب اور حضرت ام حرام رضی اللہ عنہا کو ہمارے پیچھے کھڑا کیا ۔"
"13150","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ رات کو بلا اطلاع سفر سے واپسی پر اپنے گھر نہیں آتے تھے ، بلکہ صبح یا دوپہر تشریف لاتے تھے ۔"
"13151","حضرت انس رضی اللہ عنہ سے مروی ہے کہ آپ ﷽ نے ایک مہینے تک فجر کی نماز میں رکوع کے بعد قنوت نازلہ پڑھی اور رعل ، ذکوان اور عصیہ کے قبائل پر بددعا کرتے رہے ۔"
"13152","حضرت انس رضی اللہ عنہ سے مروی ہے کہ رسول اللہ ﷽ ایک مرتبہ مسجد میں داخل ہوئے تو دیکھا کہ دو ستونوں کے درمیان ایک رسی لٹک رہی ہے ، پوچھا یہ کیسی رسی ہے آ لوگوں نے بتایا کہ یہ فلاں خاتون کی رسی ہے ، نماز پڑھتے ہوئے جب انہیں سستی یا تھکاوٹ محسوس ہوتی ہے تو وہ اس کے ساتھ اپنے آپ کو باندھ لیتی ہیں ، نبی ﷽ نے فرمایا اسے کھول دو ، پھر فرمایا جب تم میں سے کوئی شخص نماز پڑھے تو نشاط کی کیفیت برقرار رہنے تک پڑھے اور جب سستی یا تھکاوٹ محسوس ہو تو رک جائے ۔"
"13153","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ مہاجرین صحابہ رضی اللہ عنہم نے بارگاہ نبوت میں عرض کیا یا رسول اللہ ﷽ ! جس قوم کے پاس ہم آئے ہیں + انصار , ہم نے تھوڑے میں ان جیسا بہترین غمخوار اور زیادہ میں ان جیسا بہترین خرچ کرنے والا کسی قوم کو نہیں پایا ، انہوں نے ہمارا بوجھ اٹھایا اور اپنی ہر چیز میں ہمیں شریک کیا ، حتیٰ کہ ہم تو یہ سمجھنے لگے ہیں کہ سارا اجر و ثواب تو یہی لوگ لے جائیں گے ، نبی ﷽ نے فرمایا نہیں ، جب تک تم ان کا شکریہ ادا کرتے رہو گے اور اللہ تعالیٰ سے ان کے لئے دعاء کرتے رہو گے ۔"
"13154","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب حضرت عبدالرحمن بن عوف رضی اللہ عنہ مدینہ منورہ آئے تو نبی ﷽ نے ان کے اور حضرت سعد بن ربیع رضی اللہ عنہ کے درمیان بھائی چارہ قائم کر دیا ، حضرت سعد رضی اللہ عنہ نے ان سے فرمایا کہ میں اپنا سارا مال دو حصوں میں تقسیم کرتا ہوں ، نیز میری دو بیویاں ہیں ، آپ کو ان میں سے جو زیادہ پسند ہو میں اسے طلاق دے دیتا ہوں ، جب اس کی عدت گذر جائے تو آپ اس سے نکاح کر لیجئے گا ، حضرت عبدالرحمن رضی اللہ عنہ نے فرمایا اللہ تعالیٰ آپ کے مال اور اہل خانہ کو آپ کے لئے باعث برکت بنائے ، مجھے بازار کا راستہ دکھا دیجئے ، چنانچہ انہوں نے حضرت ابن عوف رضی اللہ عنہ کو راستہ بتا دیا ، وہ چلے گئے ، واپس آئے تو ان کے پاس کچھ پنیر اور گھی تھا جو وہ منافع میں بچا کر لائے تھے ۔ کچھ عرصے بعد نبی ﷽ نے حضرت عبدالرحمن رضی اللہ عنہ کو دیکھا تو ان پر زرد رنگ کے نشانات پڑے ہوئے تھے ، نبی ﷽ نے ان سے فرمایا یہ نشان کیسے ہیں آ انہوں نے بتایا کہ میں نے ایک انصاری خاتون سے شادی کر لی ہے ، نبی ﷽ نے پوچھا مہر کتنا دیا آ انہوں نے بتایا کہ کجھور کی گٹھلی کے برابر سونا ، نبی ﷽ نے فرمایا ولیمہ کرو ، اگرچہ صرف ایک بکری ہی سے ہو ۔"
"13155","محمد رحمۃ اللہ کہتے ہیں کہ حضرت انس رضی اللہ عنہ جب نبی ﷽ کے حوالے سے کوئی حدیث بیان کرتے تو آخر میں یہ فرماتے """" یا جیسے نبی ﷽ نے ارشاد فرمایا """""
"13156","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور خلفاء ثلاثہ رضی اللہ عنہم نماز میں قراءت کا آغاز ®الحمدللہ رب العالمین¾ سے کرتے تھے ۔"
"13157","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ لوگوں میں سب سے زیادہ نماز کو مکمل اور مختصر کرنے والے تھے ۔"
"13158","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ سردی کے ایک دن باہر نکلے تو دیکھا کہ مہاجرین و انصار خندق کھود رہے ہیں ، نبی ﷽ نے فرمایا اے اللہ ! اصل خیر آخرت ہی کی خیر ہے ، پس انصار اور مہاجرین کو معاف فرما ، صحابہ رضی اللہ عنہم نے جواباَ یہ شعر پڑھا کہ """" ہم ہی وہ لوگ ہیں جنہوں نے محمد ﷽ سے جہاد پر بیعت کی ہے جب تک ہم زندہ ہیں """" اور ہم کبھی فرار نہیں ہوں گے ۔"
"13159","حضرت انس رضی اللہ عنہ سے مروی ہے کہ قبیلہ عرینہ کے کچھ لوگ مسلمان ہو گئے ، لیکن انہیں مدینہ منورہ کی آب و ہوا موافق نہ آئی ، نبی ﷽ نے ان سے فرمایا کہ اگر تم ہمارے اونٹوں کے پاس جا کر ان کا دودھ پیو تو شاید تندرست ہو جاا ، چنانچہ انہوں نے ایسا ہی کیا ، لیکن جب وہ صحیح ہو گئے تو دوبارہ مرتد ہو کر کفر کی طرف لوٹ گئے ، نبی ﷽ کے مسلمان چرواہے کو قتل کر دیا ، اور نبی ﷽ کے اونٹوں کو بھگا کر لے گئے ، نبی ﷽ نے ان کے پیچھے صحابہ رضی اللہ عنہم کو بھیجا ، انہیں پکڑ کر نبی ﷽ کے سامنے پیش کیا گیا ، نبی ﷽ نے ان کے ہاتھ پااں مخالف سمت سے کٹوا دئیے ، ان کی آنکھوں میں سلائیاں پھروا دیں اور انہیں پتھریلے علاقوں میں چھوڑ دیا یہاں تک کہ وہ مر گئے ۔"
"13160","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"13161","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی ساری نمازیں قریب قریب برابر ہوتی تھیں ، اسی طرح حضرت ابوبکر صدیق رضی اللہ عنہ کی نمازیں بھی ، لیکن حضرت عمر رضی اللہ عنہ نے فجر کی نماز طویل کرنا شروع فرمائی ۔"
"13162","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم لوگ نبی ﷽ کے ساتھ مغرب کی نماز پڑھتے تھے ، پھر ہم میں سے کوئی شخص بنو سلمہ کے پاس جاتا تو اس وقت بھی وہ اپنا تیر گرنے کی جگہ کو بخوبی دیکھ سکتا تھا ۔"
"13163","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے نماز پڑھاتے ہوئے کسی بچے کے رونے کی آواز سنی اور نماز ہلکی کر دی ، ہم لوگ سمجھ گئے کہ نبی ﷽ نے اس کی ماں کی وجہ سے نماز کو ہلکا کر دیا ہے ، یہ اس بچے پر شفقت کا اظہار تھا ۔"
"13164","حمید رحمۃ اللہ کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے عذاب قبر کے متعلق سوال کیا تو انہوں نے فرمایا کہ نبی ﷽ اللہ کی پناہ مانگتے ہوئے کہتے تھے اے اللہ ! میں سستی ، بڑھاپے ، بزدلی ، بخل ، فتنہ دجال اور عذاب قبر سے آپ کی پناہ میں آتا ہوں ۔"
"13165","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کا وقت ہو گیا ، نبی ﷽ ایک آدمی کے ساتھ مسجد میں تنہائی میں گفتگو فرما رہے تھے ، جس وقت آپ ﷽ نماز کے لئے اٹھے تو بعض لوگ اونگھنے لگے تھے ۔"
"13166","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اس بات کو پسند فرماتے تھے کہ نماز میں مہاجرین اور انصار مل کر ان کے قریب کھڑے ہوں تاکہ مسائل نماز سیکھ لیں ۔"
"13167","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کا وقت قریب آ گیا ، اس وقت نبی ﷽ اور ازواجْ مطہرات کے درمیان کچھ تلخی ہو رہی تھی ، اور ازواج مطہرات ایک دوسرے کا دفاع کر رہی تھیں ، اسی اثناء میں حضرت ابوبکر صدیق رضی اللہ عنہ تشریف لے آئے اور کہنے لگے یا رسول اللہ ﷽ ! ان کے منہ میں مٹی ڈالیے اور نماز کے لیے باہر چلیے ۔"
"13168","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ سر پر پٹی باندھے ہوئے باہر نکلے تو انصار سے ، ان کی عورتوں اور بچوں سے ملاقات ہو گئی ، نبی ﷽ نے فرمایا اس ذات کی قسم جس کے دست قدرت میں محمد ﷽ کی جان ہے ، میں تم سے محبت کرتا ہوں ، تم انصار کے نیکوں کی نیکی قبول کرو ، اور ان کے گناہگار سے تجاوز اور درگذر کرو ، کیونکہ انہوں نے اپنا فرض نبھا دیا ہے اور ان کا حق باقی رہ گیا ۔"
"13169","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ احد کے دن نبی ﷽ کے اگلے چار دانت ٹوٹ گئے تھے اور آپ ﷽ کی پیشانی پر بھی زخم آیا تھا ، حتیٰ کہ اس کا خون آپ ﷽ کے چہرہ مبارک پر بہنے لگا ، اس پر نبی ﷽ نے فرمایا وہ قوم کیسے فلاح پائے گی جس نے اپنے نبی کے چہرے کو خون سے رنگین کر دیا ، جبکہ وہ انہیں ان کے رب کی طرف بلا رہا ہو آ اس پر یہ آیت نازل ہوئی کہ """" آپ کو کسی قسم کا کوئی اختیار نہیں ہے کہ اللہ ان پر متوجہ ہو جائے ، یا انہیں سزا دے کہ وہ ظالم ہیں ۔"""""
"13170","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوطلحہ رضی اللہ عنہ ، نبی ﷽ کے آگے کھڑے ہوئے تیر اندازی کر رہے تھے ، بعض اوقات نبی ﷽ تیروں کی بوچھاڑ دیکھنے کے لئے پیچھے سے سر اٹھاتے تو حضرت ابوطلحہ رضی اللہ عنہ سینہ سپر ہو جاتے تاکہ نبی ﷽ کی حفاظت کر سکیں ، اور عرض کرتے یا رسول اللہ ﷽ ! آپ کے سینے کے سامنے میرا سینہ پہلے ہے ۔"
"13171","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب کسی قوم پر حملے کا ارادہ کرتے تو رات کو حملہ نہ کرتے بلکہ صبح ہونے کا انتظار کرتے ، اگر وہاں سے اذان کی آواز سنائی دیتی تو رک جاتے ، ورنہ حملہ کر دیتے ۔ نبی ﷽ غزوہ خیبر کے لئے تشریف لے گئے ، تو رات کو خیبر پہنچے ، صبح ہوئی تو نبی ﷽ اپنی سواری پر سوار ہوئے اور مسلمان اپنی سواری پر ، الغرض ! جب نبی ﷽ شہر میں داخل ہوئے ، تو اللہ اکبر کہہ کر فرمایا خیبر برباد ہو گیا ، جب ہم کسی قوم کے صحن میں اترتے ہیں تو ڈرائے ہوئے لوگوں کی صبح بڑی بدترین ہوتی ہے ، لوگ اس وقت اپنے اوزار لے کر کام پر نکلے ہوئے تھے ، وہ نبی ﷽ اور مسلمانوں کو دیکھ کر کہنے لگے کہ محمد اور لشکر آ گئے ، حضرت انس رضی اللہ عنہ کہتے ہیں کہ میں حضرت ابوطلحہ رضی اللہ عنہ کے پیچھے بیٹھا ہوا تھا اور میرے پااں نبی ﷽ کے پااں سے لگ جاتے تھے ۔"
"13172","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک دن انہوں نے نبی ﷽ کے ہاتھ میں چاندی کی ایک انگوٹھی دیکھی ، نبی ﷽ کو دیکھ کر لوگوں نے بھی چاندی کی انگوٹھیاں بنوا لیں ، اس پر نبی ﷽ نے اپنی انگوٹھی اتار کر پھینک دی ، اور لوگوں نے بھی اپنی اپنی انگوٹھیاں اتار پھینکیں ۔"
"13173","حضرت انس رضی اللہ عنہا سے مروی ہے کہ میں نے نبی ﷽ کو کھانا کھاتے ہوئے دیکھا ، آپ ﷽ کے سامنے جو شوربہ تھا اس میں کدو تھا ، اور نبی ﷽ اسے تلاش کر کے کھا رہے تھے ۔"
"13174","محمد کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ کیا نبی ﷽ خضاب لگاتے تھے آ انہوں نے فرمایا کہ نبی ﷽ کی مبارک ڈاڑھی کے اگلے حصے میں صرف تھوڑے ہی بال سفید تھے ، اور ان پر بڑھاپے کا عیب نہیں آیا ، البتہ حضرت ابوبکر صدیق رضی اللہ عنہ اور فاروق اعظم رضی اللہ عنہ مہندی اور وسمہ کا خضاب لگاتے تھے ۔"
"13175","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا انجشہ ! ان آبگینوں کو آہستہ لے کر چلو ۔"
"13176","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے پوچھا یا رسول اللہ ! کیا دجال مدینہ منورہ میں داخل ہو سکے گا آ حضور نبی مکرم سرور دو عالم ﷽ نے فرمایا دجال مدینہ منورہ کی طرف آئے گا لیکن وہاں فرشتوں کو اس کا پہرہ دیتے ہوئے پائے گا ، جو کہ دجال سے مدینہ منورہ کی حفاظت کریں گے ۔"
"13177","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضور نبی مکرم ﷽ نے ارشاد فرمایا دجال کی دونوں آنکھوں کے درمیان کافر لکھا ہو گا جسے ہر مسلمان پڑھ لے گا خواہ وہ ان پڑھ ہو یا پڑھا لکھا ۔"
"13178","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا اس ذات کی قسم جس کے دست قدرت میں میری جان ہے ، کوئی شخص اس وقت تک مومن نہیں ہو سکتا جب تک اپنے بھائی کے لئے وہی پسند نہ کرنے لگے جو اپنے لئے پسند کرتا ہے ۔"
"13179","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے بارگاہ نبوت میں عرض کیا یا رسول اللہ ﷽ ! میرا باپ کون ہے آ نبی ﷽ نے فرمایا تمہارا باپ فلاں شخص ہے ، اس پر یہ آیت مکمل نازل ہوئی کہ اے اہل ایمان ! ایسی چیزوں کے متعلق سوال مت کیا کرو جو اگر تمہارے سامنے ظاہر ہو جائیں تو تمہیں بری لگیں ۔"
"13180","حضرت انس رضی اللہ عنہ سے مروی ہے کہ اکیدر دومہ نے نبی ﷽ کی خدمت میں ایک ریشمی جوڑا ہدیہ کے طور پر بھیجا ، نبی ﷽ نے اسے زیب تن فرما لیا ، یہ ریشم کی ممانعت سے پہلے کی بات ہے ، لوگ اس کی خوبصورتی پر تعجب کرنے لگے ، نبی ﷽ نے فرمایا اس ذات کی قسم جس کے دست قدرت میں محمد ﷽ کی جان ہے ، سعد کے رومال """" جو انہیں جنت میں دیئے گئے ہیں """" وہ اس سے بہتر اور عمدہ ہیں ۔"
"13181","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضور نبی مکرم ﷽ نے ارشاد فرمایا دجال کی دونوں آنکھوں کے درمیان کافر لکھا ہو گا جسے ہر مسلمان پڑھ لے گا خواہ وہ ان پڑھ ہو یا پڑھا لکھا ۔"
"13182","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ سے زیادہ کسی کو نماز مکمل اور مختصر کرتے ہوئے نہیں دیکھا ۔"
"13183","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا تم میں سے کوئی اس وقت تک مومن نہیں ہو سکتا جب تک اسے اللہ اور اس کے رسول اسے دوسروں سے سب سے زیادہ محبوب نہ ہوں ، اور انسان کفر سے نجات ملنے کے بعد اس میں واپس جانے کو اسی طرح ناپسند کرے جیسے آگ میں چھلانگ لگانے کو ناپسند کرتا ہے ۔ اور تم میں سے کوئی شخص اس وقت تک مومن نہیں ہو سکتا جب تک کہ میں اس کی نگاہوں میں اس کے والد ، اولاد اور تمام لوگوں سے زیادہ محبوب نہ ہو جااں ۔"
"13184","[Darussalam 13152] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13185","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ ظہر کی نماز پڑھ کر اپنی سواری پر سوار ہوئے اور جب جبل بیداء پر چڑھے تو تلبیہ پڑھ لیا ۔"
"13186","حضرت انس رضی اللہ عنہ سے مروی ہے کہ اہل مکہ نے نبی ﷽ سے کوئی معجزہ دکھانے کی فرمائش کی تو نبی ﷽ نے انہیں دو مرتبہ شق قمر کا معجزہ دکھایا ۔"
"13187","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جنت میں ایک درخت ایسا بھی ہے جس کے سائے میں اگر کوئی سوار سو سال تک چلتا رہے تب بھی اس کا سایہ ختم نہ ہو ۔"
"13188","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا میں جنت میں داخل ہوا تو اچانک ایک نہر پر نظر پڑی ، جس کے دونوں کناروں پر موتیوں کے خیمے لگے ہوئے تھے ، میں نے اس میں ہاتھ ڈال کر پانی میں بہنے والی چیز کو پکڑا تو وہ مہکتی ہوئی مشک تھی ، میں نے جبریل علیہ السلام سے پوچھا کہ یہ کیا ہے آ تو انہوں نے بتایا کہ یہ نہر کوثر ہے جو اللہ نے آپ کو عطاء فرمائی ہے ۔"
"13189","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ پیدل چلتے ہوئے آ رہے تھے ، جب مسجد کے قریب پہنچے تو ایک آدمی نے نبی ﷽ سے پوچھا کہ قیامت کب قائم ہو گی آ نبی ﷽ نے فرمایا تم نے قیامت کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کہ اس ذات کی قسم جس نے آپ کو حق کے ساتھ بھیجا ہے میں نے کوئی بہت زیادہ اعمال ، نماز ، روزہ تو مہیا نہیں کر رکھے ، البتہ اتنی بات ضرور ہے کہ میں اللہ اور اس کے رسول سے محبت کرتا ہوں ، نبی ﷽ نے فرمایا کہ تم قیامت کے دن اس شخص کے ساتھ ہو گے جس کے ساتھ تم محبت کرتے ہو ۔"
"13190","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے بیس دن تک نماز فجر میں قنوت نازلہ پڑھی ہے ۔"
"13191","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حج اور عمرہ دونوں کا تلبیہ پڑھا تھا ۔"
"13192","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک انصاری نوجوان نے آ کر بارگاہ رسالت میں عرض کیا یا رسول اللہ ﷽ ! میں جہاد میں شرکت کرنا چاہتا ہوں لیکن اتنے پیسے نہیں کہ اس کے لئے سامانْ سفر تیار کر سکوں آ نبی ﷽ نے فرمایا کہ فلاں انصاری کے پاس چلے جاا کہ انہوں نے تیاری کی تھی لیکن وہ بیمار ہو گئے ، ان سے جا کر کہو کہ نبی ﷽ تمہیں سلام کہہ رہے ہیں ، اور فرما رہے ہیں کہ تم نے جو سامانْ سفر تیار کیا تھا ، وہ مجھے دے دو ، اس انصاری نے جا کر متعلقہ صحابی کو پیغام پہنچا دیا ، انہوں نے اپنی بیوی سے کہہ دیا کہ تم نے میرے لیے جو سامانْ سفر تیار کیا تھا ، وہ سب انہیں دے دو ، اور کچھ بھی نہ روکنا ، کیونکہ خدا کی قسم ! اگر تم نے اس میں سے کچھ بھی روکا تو اس میں برکت نہیں ہو گی ۔"
"13193","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ کے راستے میں ایک صبح یا شام جہاد کرنا دنیا و مافیہا سے بہتر ہے اور جنت میں ایک کمان رکھنے کی جگہ دنیا و مافیہا سے بہتر ہے ۔"
"13194","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قیامت کے دن اہل جنت میں سے ایک آدمی کو لایا جائے گا ، اللہ تعالیٰ اس سے پوچھے گا کہ اے ابن آدم ! تو نے اپنا ٹھکانہ کیسا پایا آ وہ جواب دے گا پروردگار ! بہترین ٹھکانہ پایا ، اللہ تعالیٰ فرمائے گا کہ مانگ اور تمنا ظاہر کر ، وہ عرض کرے گا کہ میری درخواست اور تمنا تو صرف اتنی ہی ہے کہ آپ مجھے دنیا میں واپس بھیج دیں اور میں دسیوں مرتبہ آپ کی راہ میں شہید ہو جااں ، کیونکہ وہ شہادت کی فضیلت دیکھ چکا ہو گا ۔ ایک جہنمی کو لایا جائے گا اور اللہ اس سے پوچھے گا کہ اے ابن آدم ! تو نے اپنا ٹھکانہ کیسا پایا آ وہ کہے گا پروردگار ! بدترین ٹھکانہ ، اللہ فرمائے گا اگر تیرے پاس روئے زمین کی ہر چیز موجود ہو تو کیا تو وہ سب کچھ اپنے فدیے میں دے دے گا آ وہ کہے گا ہاں ! اللہ فرمائے گا کہ تو جھوٹ بولتا ہے ، میں نے تو تجھ سے دنیا میں اس سے بھی ہلکی چیز کا مطالبہ کیا تھا ، لیکن تو نے اسے پورا نہ کیا چنانچہ اسے جہنم میں لوٹا دیا جائے گا ۔"
"13195","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ بکثرت یہ دعاء فرماتے تھے کہ اے اللہ ! ہمیں دنیا میں بھی بھلائی عطاء فرما اور آخرت میں بھی بھلائی عطاء فرما اور ہمیں عذاب جہنم سے محفوظ فرما ۔"
"13196","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب جمرہ عقبہ کی رمی اور جانور کی قربانی کر چکے تو بال کٹوائے اور بال کاٹنے والے کے سامنے پہلے سر کا داہنا حصہ کیا ، اس نے اس حصے کے بال تراشے ، نبی ﷽ نے وہ بال حضرت ابوطلحہ رضی اللہ عنہ کو دے دیئے ، پھر بائیں جانب کے بال منڈوائے تو وہ عام لوگوں کو دے دیئے ۔"
"13197","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا تم میں سے کوئی شخص اپنے اوپر آنے والی کسی تکلیف کی وجہ سے موت کی تمنا نہ کرے ، اگر موت کی تمنا کرنا ہی ضروری ہو تو اسے یوں کہنا چاہئے کہ اے اللہ ! جب تک میرے لیے زندگی میں کوئی خیر ہے ، مجھے اس وقت تک زندہ رکھ ، اور جب میرے لیے موت میں بہتری ہو تو مجھے موت عطاء فرما دینا ۔"
"13198","[Darussalam 13166] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13199","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے نبی ﷽ سے پوچھا کہ قیامت کب قائم ہو گی آ نبی ﷽ نے فرمایا تم نے قیامت کے لیے کیا تیاری کر رکھی ہے آ اس نے کہا کہ میں نے کوئی بہت زیادہ اعمال ، نماز ، روزہ اور صدقہ و خیرات تو مہیا نہیں کر رکھے ، البتہ اتنی بات ضرور ہے کہ میں اللہ اور اس کے رسول سے محبت کرتا ہوں ، نبی ﷽ نے فرمایا کہ تم قیامت کے دن اس شخص کے ساتھ ہو گے جس کے ساتھ تم محبت کرتے ہو ۔"
"13200","حضرت انس رضی اللہ عنہ فرمایا کرتے تھے کہ میں نے نبی ﷽ کا جو دور باسعادت پایا ہے ، آج اس میں سے کوئی چیز مجھے نظر نہیں آتی ، ابورافع نے پوچھا کہ اے ابوحمزہ ! نماز بھی نہیں آ فرمایا کیا تم نہیں جانتے کہ حجاج نے نماز میں کیا کچھ کر دیا ہے ۔"
"13201","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ کے پاس ایک مرتبہ وہ جو کی روٹی اور پرانا روغن لے کر آئے تھے ۔ اور جناب رسول اللہ ﷽ کی زرہ ایک یہودی کے پاس مدینہ منورہ میں گروی رکھی ہوئی تھی ، نبی ﷽ نے اس سے اپنے اہل خانہ کے لیے جو لیے تھے ۔ اور میں نے ایک دن انہیں یہ فرماتے ہوئے سنا کہ آج شام کو آل محمد + ﷽ , کے پاس غلے یا گندم کا ایک صاع بھی نہیں ہے ، اس وقت نبی ﷽ کی نو ازواج مطہرات تھیں ۔"
"13202","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا ہر نبی کی ایک دعاء ایسی ضرور تھی جو انہوں نے اپنی امت کے لیے مانگی اور قبول ہو گئی ، جب کہ میں نے اپنی دعاء اپنی امت کی سفارش کرنے کی خاطر قیامت کے دن کے لئے محفوظ کر رکھی ہے ۔"
"13203","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا کچھ لوگ اپنے گناہوں کی وجہ سے جہنم میں داخل کیے جائیں گے ، جب وہ جل کر کوئلہ ہو جائیں گے تو اللہ تعالی اپنے فضل و کرم سے انہیں جنت میں داخل کر دے گا ، + اہل جنت پوچھیں گے کہ یہ کون لوگ ہیں آ انہیں , بتایا جائے گا کہ یہ جہنمی ہیں ۔"
"13204","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ یہ دعاء فرمایا کرتے تھے اے اللہ ! میں سستی ، بڑھاپے ، بزدلی ، بخل ، فتنہ اور عذاب قبر سے آپ کی پناہ میں آتا ہوں اور میں زندگی اور موت کی آزمائش سے آپ کی پناہ میں آتا ہوں ۔"
"13205","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص تین مرتبہ جنت کا سوال کر لے تو جنت خود کہتی ہے کہ اے اللہ ! اس بندے کو مجھ میں داخلہ عطاء فرما اور جو شخص تین مرتبہ جہنم سے پناہ مانگ لے ، جہنم خود کہتی ہے کہ اے اللہ ! اس بندے کو مجھ سے بچا لے ۔"
"13206","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب تسلسل کے ساتھ روزہ رکھتے تو لوگ کہتے کہ نبی ﷽ روزہ رکھتے رہیں گے اور جب افطاری کرتے تب بھی لوگ کہتے کہ نبی ﷽ ناغہ کرتے رہیں گے ۔"
"13207","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا آسانیاں پیدا کیا کرو ، مشکلات پیدا نہ کرو ، سکون دلایا کرو ، نفرت نہ پھیلایا کرو ۔"
"13208","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نبی ﷽ کی خدمت کیا کرتا تھا ، اور بغیر اجازت لیے بھی نبی ﷽ کے گھر میں چلا جایا کرتا تھا ، ایک دن حسب معمول میں نبی ﷽ کے گھر میں داخل ہوا تو آپ ﷽ نے فرمایا بیٹا ! اللہ کی طرف سے نیا حکم آ گیا ہے ، اس لئے اب اجازت لئے بغیر اندر نہ آیا کرو ۔"
"13209","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا اگر مجھے کہیں سے ہدیہ میں بکری کا ایک کھر آئے تب بھی قبول کر لوں گا ، اور اگر صرف اسی کی دعوت دی جائے تب بھی قبول کر لوں گا ۔"
"13210","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد ربانی """" جب اس کے رب نے اپنی تجلی ظاہر فرمائی """" کی تفسیر میں فرمایا ہے کہ چھنگلیا کے ایک کنارے کے برابر تجلی ظاہر ہوئی ۔"
"13211","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا آپس میں قطع تعلقی ، بغض اور حسد نہ کیا کرو اور اللہ کے بندو ! بھائی بھائی بن کر رہا کرو ۔"
"13212","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا آپس میں قطع تعلقی ، بغض اور پشت مت پھیرا کرو اور کسی مسلمان کے لیے اپنے بھائی سے تین دن سے زیادہ قطع کلامی کرنا حلال نہیں ہے ۔"
"13213","عبدالرحمن بن وردان رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ ہم لوگ اہل مدینہ کے ایک وفد کے ساتھ حضرت انس رضی اللہ عنہ کی خدمت میں حاضر ہوئے ، انہوں نے پوچھا کہ آپ لوگوں نے عصر کی نماز پڑھ لی آ ہم نے اثبات میں جواب دیا اور پوچھا کہ یہ بتائیے """" اللہ تعالیٰ آپ کے ساتھ عمدہ سلوک کرے """" کہ نبی ﷽ یہ نماز کب پڑھتے تھے آ انہوں نے جواب دیا کہ نبی ﷽ یہ نماز اس وقت پڑھتے تھے جب کہ سورج روشن اور صاف ہوتا تھا ۔"
"13214","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا مسجد میں تھوکنا گناہ ہے اور اس کا کفارہ اسے دفن کر دینا ہے ۔"
"13215","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے چاندی کی ایک انگوٹھی بنوا لی ، جس کا نگینہ حبشی تھا اور اس پر یہ عبارت نقش تھی """" محمد رسول اللہ """" ﷽ ۔"
"13216","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور ان کی اہلیہ محترمہ ایک ہی برتن سے غسل کر لیا کرتے تھے ۔"
"13217","ابن سیرین رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ حضرت عمر رضی اللہ عنہ نے قنوت نازلہ پڑھی ہے آ انہوں نے فرمایا ہاں ! حضرت عمر رضی اللہ عنہ سے بہتر ذات یعنی نبی ﷽ نے خود پڑھی ہے ، رکوع کے بعد ۔"
"13218","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ بکثرت یہ دعاء فرماتے تھے کہ اے اللہ ! ہمیں دنیا میں بھی بھلائی عطاء فرما اور آخرت میں بھی بھلائی عطاء فرما اور ہمیں عذاب جہنم سے محفوظ فرما ۔"
"13219","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اپنے ہاتھ اتنے بلند فرماتے کہ آپ ﷽ کی مبارک بغلوں کی سفیدی تک دکھائی دیتی ۔"
"13220","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی خدمت میں ایک ریشمی جوڑا ہدیہ کے طور پر کہیں سے آیا لوگ اسے چھونے اور دیکھنے لگے ، نبی ﷽ نے فرمایا تم اس پر تعجب کر رہے ہو ، سعد کے رومال """" جو انہیں جنت میں دیئے گئے ہیں """" وہ اس سے بہتر اور عمدہ ہیں ۔"
"13221","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص میری طرف جان بوجھ کر کسی جھوٹی بات کی نسبت کرے ، اسے اپنا ٹھکانہ جہنم میں بنا لینا چاہئے ۔"
"13222","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نبی ﷽ نے فرمایا جو میں جانتا ہوں ، اگر تم وہ جانتے ہوتے تو تم بہت تھوڑا ہنستے اور کثرت سے رویا کرتے ۔"
"13223","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب صحابہ رضی اللہ عنہ خندق کھود رہے تھے تو نبی ﷽ فرمایا کرتے تھے کہ اے اللہ ! آخرت کی خیر کے علاوہ کوئی خیر نہیں ، پس انصار اور مہاجرین کی اصلاح فرما ۔"
"13224","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ تعالیٰ فرماتے ہیں کہ میں اپنے بندے کے گمان """" جو وہ میرے ساتھ کرتا ہے """" کے قریب ہوتا ہوں ، اور جب وہ مجھے پکارتا ہے تو میں اس کے ساتھ ہی ہوتا ہوں ۔"
"13225","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک کتابی آدمی بارگاہ نبوت میں حاضر ہوا اور نبی ﷽ کو سلام کرتے ہوئے اس نے ®السام علیکم¾ کہا ، یہ سن کر حضرت عمر رضی اللہ عنہ کہنے لگے یا رسول اللہ ﷽ ! کیا میں اس کی گردن نہ اڑا دوں آ نبی ﷽ نے فرمایا نہیں ، البتہ جب اہل کتاب تمہیں سلام کیا کریں تو تم صرف ®وعلیکم¾ کہا کرو ۔"
"13226","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نبی ﷽ کے ساتھ چلا جا رہا تھا ، آپ ﷽ نے موٹے کنارے والی ایک نجرانی چادر اوڑھ رکھی تھی ، راستے میں ایک دیہاتی مل گیا اور اس نے نبی ﷽ کی چادر کو ایسے گھسیٹا کہ وہ پھٹ گئی اور اس کے نشانات نبی ﷽ کی گردن مبارک پر پڑ گئے ، نبی ﷽ میں صرف یہی تبدیلی ہوئی کہ اسے کچھ دینے کا حکم دیا جو اسے دے دیا گیا ۔"
"13227","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ان کے ماموں حضرت حرام رضی اللہ عنہ کو """" جو حضرت ام سلیم رضی اللہ عنہا کے بھائی تھے """" ان ستر صحابہ رضی اللہ عنہم کے ساتھ بھیجا تھا جو بئر معونہ کے موقع پر شہید کر دیئے گئے تھے ، اس وقت مشرکین کا سردار عامر بن طفیل تھا ، وہ ایک مرتبہ نبی ﷽ کے پاس آیا تھا اور کہا تھا کہ میرے متعلق تین میں سے کوئی ایک بات قبول کر لیجئے ، یا تو شہری لوگ آپ کے اور دیہاتی لوگ میرے ہو جائیں ، یا میں آپ کے بعد خلیفہ نامزد کیا جااں ، ورنہ پھر میں آپ کے ساتھ بنو غطفان کے ایک ہزار سرخ و زرد گھوڑوں اور ایک ہزار سرخ و زرد اونٹوں کو لے کر جنگ کروں گا ، اسے کسی قبیلے کی عورت کے گھر میں بعد ازاں کسی نے نیزے سے زخمی کر دیا اور وہ کہنے لگا کہ فلاں قبیلے کی عورت کے گھر میں ایسا پھوڑا ملا جیسے اونٹ میں ہوتا ہے ، میرا گھوڑا لے کر آا ، گھوڑے پر سوار ہوا اور اس کی پشت سے اترنا نصیب نہ ہوا ، راستے ہی میں مر گیا ۔ حضرت حرام رضی اللہ عنہ اپنے ساتھ دو آدمیوں کو لے کر چلے ، ان میں سے ایک کا تعلق بنو امیہ سے تھا اور دوسرا لنگڑا تھا ، انہوں نے ان دونوں سے فرمایا کہ تم میرے قریب ہی رہنا تاآنکہ میں واپس آ جااں ، اگر تم مجھے حالت امن میں پاا تو بہت بہتر ، ورنہ اگر وہ مجھے قتل کر دیں تو تم میرے قریب تو ہو گے ، باقی ساتھیوں کو جا کر مطلع کر دینا ، یہ کہہ کر حضرت حرام رضی اللہ عنہ روانہ ہو گئے ۔ متعلقہ قبیلے میں پہنچ کر انہوں نے فرمایا کیا مجھے اس بات کی اجازت ہے کہ نبی ﷽ کا پیغام آپ لوگوں تک پہنچا سکوں آ انہوں نے اجازت دے دی ، حضرت حرام رضی اللہ عنہ ان کے سامنے پیغام ذکر کرنے لگے ، اور دشمنوں نے پیچھے سے ایک آدمی کو اشارہ کر دیا جس نے پیچھے سے آ کر ان کے ایسا نیزہ گھونپا کہ جسم کے آر پار ہو گیا ، حضرت حرام رضی اللہ عنہ یہ کہتے ہوئے """" اللہ اکبر ، رب کعبہ کی قسم ! میں کامیاب ہو گیا """" گر گئے ، پھر انہوں نے تمام صحابہ رضی اللہ عنہم کو شہید کر دیا ، صرف وہ لنگڑا آدمی بچ گیا کہ وہ پہاڑ کی چوٹی پر چڑھ گیا تھا ، اسی مناسبت سے یہ وحی نازل ہوئی """" جس کی پہلے تلاوت بھی ہوتی تھی ، بعد میں منسوخ ہو گئی """" کہ ہماری قوم کو یہ پیغام پہنچا دو کہ ہم اپنے رب سے جا ملے ہیں ، وہ ہم سے راضی ہو گیا اور اس نے ہمیں راضی کر دیا ، ادھر نبی ﷽ چالیس دن تک قبیلہ رعل ، ذکوان ، بنو لحیان اور عصیہ """" جنہوں نے اللہ اور اس کے رسول ﷽ کی نافرمانی کی تھی """" کے خلاف بددعاء فرماتے رہے ۔"
"13228","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے کچی اور پکی کھجور کو اکٹھا کر کے نبیذ بنانے سے منع فرمایا ہے ۔"
"13229","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نبی ﷽ نے فرمایا جو میں جانتا ہوں ، اگر تم وہ جانتے ہوتے تو تم بہت تھوڑا ہنستے اور کثرت سے رویا کرتے ۔"
"13230","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا بندہ اس وقت تک خیر پر رہتا ہے جب تک وہ جلد بازی سے کام نہ لے ، صحابہ رضی اللہ عنہم نے پوچھا یا رسول اللہ ﷽ ! جلدی سے کیا مراد ہے آ فرمایا بندہ یوں کہنا شروع کر دے کہ میں نے اپنے پروردگار سے اتنی دعائیں کیں لیکن اس نے قبول ہی نہیں کی ۔"
"13231","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ہمیں کوئی خطبہ ایسا نہیں دیا جس میں یہ نہ فرمایا ہو کہ اس شخص کا ایمان نہیں جس کے پاس امانت داری نہ ہو اور اس شخص کا دین نہیں جس کے پاس وعدہ کی پاسداری نہ ہو ۔"
"13232","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت حارثہ رضی اللہ عنہ کی والدہ نے بارگاہ رسالت میں عرض کیا یا رسول اللہ ﷽ ! اگر تو حارثہ جنت میں ہے تو میں صبر کر لوں گی ، ورنہ پھر میں کثرت سے آہ و بکا کروں گی ، نبی ﷽ نے فرمایا اے ام حارثہ ! جنت صرف ایک تو نہیں ہے ، وہ تو بہت سی جنتیں ہیں اور حارثہ ان میں سے جنت الفردوس میں ہے ۔"
"13233","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ کو ایک مرتبہ ایک یہودی نے جو کی روٹی اور پرانے روغن کی دعوت دی جو نبی ﷽ نے قبول فرما لی ۔"
"13234","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دو چتکبرے سینگ دار مینڈھے قربانی میں پیش کیا کرتے تھے ، اور اللہ کا نام لے کر تکبیر کہتے تھے ، میں نے دیکھا ہے کہ نبی ﷽ انہیں اپنے ہاتھ سے ذبح کرتے تھے اور ان کے پہلو پر اپنا پااں رکھتے تھے ۔"
"13235","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے سامنے سے ایک جنازہ گذرا ، لوگوں نے اس کی تعریف کی ، نبی ﷽ نے فرمایا واجب ہو گئی ، پھر دوسرا جنازہ گذرا اور لوگوں نے اس کی مذمت کی ، نبی ﷽ نے فرمایا واجب ہو گئی ۔"
"13236","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب مرض الوفات میں مبتلا ہوئے تو تین دن تک باہر نہیں آئے ، ایک مرتبہ نماز کھڑی ہوئی حضرت ابوبکر رضی اللہ عنہ نماز پڑھانے کے لئے آگے بڑھے تو نبی ﷽ نے گھر کا پردہ ہٹایا ، ہم نے ایسا منظر کبھی نہیں دیکھا تھا جیسے نبی ﷽ کا رخ تاباں اس وقت نبی ﷽ نے حضرت ابوبکر رضی اللہ عنہ کو اشارے سے فرمایا کہ آگے بڑھ کر نماز مکمل کریں ، اور نبی ﷽ نے پردہ لٹکا لیا ، پھر وصال تک نبی ﷽ نماز کے لئے نہ آ سکے ۔"
"13237","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب مدینہ منورہ تشریف لائے تو حضرت ابوبکر صدیق رضی اللہ عنہ کو اپنے پیچھے بٹھائے ہوئے تھے ، حضرت ابوبکر صدیق رضی اللہ عنہ بوڑھے اور جانے پہچانے تھے ، جب کہ نبی ﷽ جوان اور غیر معروف تھے ، اس لئے راستے میں اگر کوئی آدمی ملتا اور یہ پوچھتا کہ ابوبکر ! آپ کے آگے یہ کون صاحب ہیں آ تو وہ جواب دیتے کہ یہ مجھے راستہ دکھا رہے ہیں ، سمجھنے والا یہ سمجھتا کہ نبی ﷽ انہیں راستہ دکھا رہے ہیں اور حضرت ابوبکر صدیق رضی اللہ عنہ اس سے خیر کا راستہ مراد لے رہے تھے ۔ ایک مرتبہ راستہ میں حضرت ابوبکر صدیق رضی اللہ عنہ نے پیچھے مڑ کر دیکھا تو ایک شہسوار ان کے انتہائی قریب پہنچ چکا تھا ، وہ نبی ﷽ سے کہنے لگے اے اللہ کے نبی ! یہ سوار تو ہم تک پہنچ چکا ہے ، نبی ﷽ نے اس کی طرف متوجہ ہو کر فرمایا اے اللہ ! اسے گرا دے ، اسی لمحے اس کے گھوڑے نے اسے اپنی پشت سے گرا دیا اور ہنہناتا ہوا کھڑا ہو گیا ، وہ شہسوار کہنے لگا کہ اے اللہ کے نبی ! مجھے کوئی حکم دیجئے ، نبی ﷽ نے فرمایا اپنی جگہ پر ہی جا کر رکو اور کسی کو ہمارے پاس پہنچنے نہ دو ، دن کے ابتدائی حصے میں جو شخص نبی ﷽ کے خلاف کوششیں کر رہا تھا ، اس طرح دن کے آخری حصے میں وہی نبی ﷽ کا ہتھیار بن گیا ۔ اس طرح سفر کرتے کرتے نبی ﷽ نے پتھریلے علاقے کی جانب پہنچ کر پڑاا کیا اور انصار کو بلا بھیجا ، وہ لوگ آئے اور دونوں حضرات کو سلام کیا اور کہنے لگے کہ امن و اطمینان کے ساتھ سوار ہو کر تشریف لے آئیے ، چنانچہ نبی ﷽ اور حضرت ابوبکر صدیق رضی اللہ عنہ سوار ہوئے اور انصار نے ان دونوں کے گرد مسلح سپاہیوں سے حفاظتی حصار کر لیا ، ادھر مدینہ منورہ میں اعلان ہو گیا کہ نبی ﷽ تشریف لے آئے ہیں ، چنانچہ لوگ جھانک جھانک کر نبی ﷽ کو دیکھنے اور """" اللہ کے نبی آ گئے """" کے نعرے لگانے لگے ، نبی ﷽ چلتے چلتے حضرت ابوایوب انصاری رضی اللہ عنہ کے گھر کے پاس پہنچ کر اتر گئے ۔ نبی ﷽ اہل خانہ سے باتیں کر ہی رہے تھے کہ عبداللہ بن سلام کو یہ خبر سننے کو ملی ، اس وقت وہ اپنے کھجور کے باغ میں اپنے اہل خانہ کے لئے کھجوریں کاٹ رہے تھے ، انہوں نے جلدی جلدی کھجوریں کاٹیں اور اپنے ساتھ ہی لے کر نبی ﷽ کی خدمت میں حاضر ہو گئے ، نبی ﷽ کی باتیں سنیں اور واپس گھر چلے گئے ، ادھر نبی ﷽ نے لوگوں سے پوچھا کہ ہمارے رشتہ داروں میں سب سے زیادہ قریب کس کا گھر ہے آ حضرت ابوایوب انصاری رضی اللہ عنہ نے اپنے آپ کو پیش کیا اور عرض کیا کہ یہ میرا مکان ہے اور یہ میرا دروازہ ہے ، نبی ﷽ نے فرمایا کہ پھر جا کر ہمارے لیے آرام کرنے کا انتظام کرو ، حضرت ابوایوب رضی اللہ عنہ نے جا کر انتظام کیا اور واپس آ کر کہنے لگے کہ اے اللہ کے نبی ! آرام کا انتظام ہو گیا ہے ، آپ دونوں چل کر """" اللہ کی برکت پر """" آرام کر لیجئے ۔ جب نبی ﷽ تشریف لائے تو ان کی خدمت میں عبداللہ بن سلام بھی حاضر ہوئے اور کہنے لگے کہ میں اس بات کی گواہی دیتا ہوں کہ آپ اللہ کے سچے رسول ہیں اور حق لے کر آئے ہیں ، یہودی جانتے ہیں کہ میں ان کا سردار ابن سردار اور عالم بن عالم ہوں ، آپ انہیں بلا کر ان سے پوچھئے چنانچہ جب وہ آئے تو نبی ﷽ نے ان سے فرمایا اے گروہ یہود ! اللہ سے ڈرو ، اس اللہ کی قسم جس کے علاوہ کوئی معبود نہیں ، تم جانتے ہو کہ میں اللہ کا سچا رسول ہوں ، اور میں تمہارے پاس حق لے کر آیا ہوں ، اس لئے تم اسلام قبول کر لو ، انہوں نے کہا کہ ہمیں کچھ معلوم نہیں ۔"
"13238","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضور نبی مکرم ﷽ نے ارشاد فرمایا دجال کی ایک آنکھ پونچھ دی گئی ہو گی ، اور اس کی دونوں آنکھوں کے درمیان حروف تہجی کی شکل میں کافر لکھا ہو گا جسے ہر مسلمان پڑھ لے گا + خواہ وہ ان پڑھ ہو یا پڑھا لکھا , ۔"
"13239","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ تین سانسوں میں پانی پیتے تھے اور فرماتے تھے کہ یہ طریقہ زیادہ آسان ، خوشگوار اور مفید ہے ۔"
"13240","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب مدینہ منورہ تشریف لائے تو مدینہ کے بالائی حصے میں بنو عمرو بن عوف کے محلے میں پڑاا کیا اور وہاں چودہ راتیں مقیم رہے ، پھر نبو نجار کے سرداروں کو بلا بھیجا ، وہ اپنی تلواریں لٹکائے ہوئے آئے ، وہ منظر اب بھی میرے سامنے ہے کہ نبی ﷽ اپنی سواری پر سوار تھے ، حضرت ابوبکر صدیق رضی اللہ عنہ ان کے پیچھے تھے اور بنو نجار ان کے اردگرد تھے ، یہاں تک کہ نبی ﷽ حضرت ابوایوب انصاری رضی اللہ عنہ کے صحن میں پہنچ گئے ، ابتدا جہاں بھی نماز کا وقت ہو جاتا نبی ﷽ وہیں نماز پڑھ لیتے ، اور بکریوں کے باڑے میں بھی نماز پڑھ لیتے تھے ، پھر نبی ﷽ نے ایک مسجد تعمیر کرنے کا حکم دے دیا ، اور بنو نجار کے لوگوں کو بلا کر ان سے فرمایا اے بنو نجار ! اپنے اس باغ کی قیمت کا معاملہ میرے ساتھ طے کر لو ، وہ کہنے لگے کہ ہم تو اس کی قیمت اللہ ہی سے لیں گے ، اس وقت وہاں مشرکین کی کچھ قبریں ، ویرانہ اور ایک درخت تھا ، نبی ﷽ کے حکم پر مشرکین کی قبروں کو اکھیڑ دیا گیا ، ویرانہ کو برابر کر دیا گیا ، اور درخت کو کاٹ دیا گیا ، لوگوں نے قبلہ مسجد کی جانب درخت لگا دیا اور اس کے دروازوں کے کواڑ پتھر کے بنا دیئے ، لوگ نبی ﷽ کو اینٹیں پکڑاتے تھے ، اور نبی ﷽ فرماتے جا رہے تھے کہ اے اللہ ! اصل خیر تو آخرت کی ہے ، اے اللہ ! انصار اور مہاجرین کی نصرت فرما ۔"
"13241","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ تمام لوگوں میں سب سے اچھے اخلاق والے تھے ، میرا ایک بھائی تھا جس کا نام ابوعمیر تھا ، غالباَ یہ بھی فرمایا کہ اس کا دودھ چھڑا دیا گیا تھا ، نبی ﷽ جب تشریف لاتے تو اس سے فرماتے ابوعمیر ! کیا ہوا نغیر ، یہ ایک پرندہ تھا جس سے وہ کھیلتا تھا ، بعض اوقات ہمارے گھر ہی میں نماز کا وقت ہو جاتا تو نبی ﷽ اپنے نیچے بستر کو صاف کرتے اور اس پر پانی چھڑک دینے کا حکم دیتے اور نماز کے لئے کھڑے ہو جاتے ، ہم لوگ پیچھے کھڑے ہو جاتے اور نبی ﷽ ہمیں نماز پڑھا دیتے ، یاد رہے کہ ہمارا بستر کھجور کی شاخوں سے بنا ہوا تھا ۔"
"13242","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں حضرت ابوطلحہ رضی اللہ عنہ کے بیٹے عبداللہ کو لے کر نبی ﷽ کی خدمت میں حاضر ہوا ، میں نے دیکھا کہ نبی ﷽ اپنے اونٹوں کو قطران مل رہے ہیں ، نبی ﷽ نے فرمایا کیا تمہارے پاس کچھ ہے آ میں نے عرض کیا عجوہ کھجوریں ہیں ، نبی ﷽ نے ایک کھجور لے کر اسے منہ میں چبا کر نرم کیا ، اور تھوک جمع کر کے اس کے منہ میں ٹپکا دیا جسے وہ چاٹنے لگا ، نبی ﷽ نے فرمایا کھجور انصار کی محبوب چیز ہے ، پھر نبی ﷽ نے اس کا نام عبداللہ رکھ دیا ۔"
"13243","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب تمہیں کوئی """" کتابی """" سلام کرے تو صرف """" علیکم """" کہا کرو ۔"
"13244","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا تمہارے پاس یمن کے لوگ آئے ہیں جو تم سے بھی زیادہ رقیق القلب ہیں ، اور یہی وہ پہلے لوگ ہیں جو مصافحہ کا رواج اپنے ساتھ لے کر آئے ۔"
"13245","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ صحابہ کرام رضی اللہ عنہم ماہ رمضان کی کسی شب میں بارگاہ نبوت میں حاضر ہوئے نبی ﷽ باہر تشریف لائے ، اور مختصر سی نماز پڑھا کر چلے گئے ، کافی دیر گذرنے کے بعد دوبارہ آئے اور مختصر سی نماز پڑھا کر دوبارہ واپس چلے گئے اور کافی دیر تک اندر رہے ، جب صبح ہوئی تو ہم نے عرض کیا اے اللہ کے نبی ! ہم آج رات حاضر ہوئے تھے ، آپ تشریف لائے اور مختصر سی نماز پڑھائی اور کافی دیر تک کے لئے گھر میں چلے گئے آ نبی ﷽ نے فرمایا میں نے تمہاری وجہ سے ایسا ہی کیا تھا ۔"
"13246","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت ابوبکر صدیق رضی اللہ عنہ کو سورہ برئءت کے ساتھ مکہ مکرمہ کی طرف بھیجا ، لیکن جب وہ ذوالحلیفہ کے قریب پہنچے تو نبی ﷽ نے انہیں کہلوایا کہ عرب کے دستور کے مطابق یہ پیغام صرف میں یا میرے اہل خانہ کا کوئی فرد ہی پہنچا سکتا ہے ۔ چنانچہ نبی ﷽ نے حضرت علی رضی اللہ عنہ کو وہ پیغام دے کر بھیجا ۔"
"13247","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی وفات پر حضرت ام ایمن رضی اللہ عنہا رونے لگیں ، کسی نے پوچھا کہ تم نبی ﷽ پر کیوں رو رہی ہو آ انہوں نے جواب دیا میں جانتی ہوں کہ نبی ﷽ دنیا سے رخصت ہو گئے ہیں ، میں تو اس وحی پر رو رہی ہوں جو منقطع ہو گئی ۔"
"13248","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے مسجد میں قبلہ کی جانب ناک کی ریزش لگی ہوئی دیکھی تو اسے اپنے ہاتھ سے صاف کر دیا ۔"
"13249","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب اہل یمن نبی ﷽ کی خدمت میں حاضر ہوئے تو انہوں نے نبی ﷽ سے درخواست کی کہ ان کے ساتھ ایک آدمی کو بھیج دیں جو انہیں کتاب و سنت کی تعلیم دے ، نبی ﷽ نے حضرت ابوعبیدہ رضی اللہ عنہ کا ہاتھ پکڑ کر ان کے ساتھ بھیج دیا اور فرمایا یہ اس امت کے امین ہیں ۔"
"13250","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے + حجۃ الوداع کے موقع پر , جب حلاق سے سر منڈوانے کا ارادہ کیا تو حضرت ابوطلحہ رضی اللہ عنہ نے سر کے ایک حصے کے بال اپنے ہاتھوں میں لے لیے ، پھر وہ بال ام سلیم اپنے ساتھ لے گئیں اور وہ انہیں اپنی خوشبو میں ڈال لیا کرتی تھیں ۔"
"13251","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے ارشاد فرمایا آج رات میں نے یہ خواب دیکھا کہ گویا میں رافع بن عقبہ کے گھر میں ہوں ، اور وہاں """" ابن طاب """" نامی کھجوریں ہمارے سامنے پیش کی گئیں ، میں نے اس کی تعبیر یہ لی کہ + رافع کے لفظ سے , دنیا میں رفعت + عقبہ کے لفظ سے , آخرت کا بہترین انجام ہمارے لیے ہی ہے اور + طاب کے لفظ سے , ہمارا دین پاکیزہ ہے ۔"
"13252","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے سامنے جب بھی قصاص کا کوئی معاملہ پیش ہوا تو آپ ﷽ نے اس میں معاف کرنے کی ترغیب ہی دی ۔"
"13253","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب کوئی بات کہتے تو تین مرتبہ اسے دہراتے تھے اور جب کسی قوم کے پاس جاتے تو انہیں تین مرتبہ سلام فرماتے ۔"
"13254","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا میری امت میں سے میری شفاعت کے مستحق کبیرہ گناہوں کا ارتکاب کرنے والے ہوں گے ۔"
"13255","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت فاطمہ رضی اللہ عنہا نے نبی ﷽ کے سامنے جو کی روٹی کا ایک ٹکڑا پیش کیا ، نبی ﷽ نے فرمایا یہ پہلا کھانا ہے جو تمہارا باپ تین دن بعد کھا رہا ہے ۔"
"13256","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک دیہاتی آیا اور کہنے لگا یا رسول اللہ ﷽ ! قیامت کب قائم ہو گی آ نبی ﷽ نے فرمایا تم نے قیامت کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کہ میں نے کوئی بہت زیادہ اعمال تو مہیا نہیں کر رکھے ، البتہ اتنی بات ضرور ہے کہ میں اللہ اور اس کے رسول سے محبت کرتا ہوں ، نبی ﷽ نے فرمایا کہ تم اس کے ساتھ ہو گے جس کے ساتھ تم محبت کرتے ہو ، حضرت انس رضی اللہ عنہ فرماتے ہیں کہ اسی دوران حضرت مغیرہ بن شعبہ رضی اللہ عنہ کا ایک غلام """" جو میرا ہم عمر تھا """" وہاں سے گذرا تو نبی ﷽ نے فرمایا اگر اس کی زندگی ہوئی تو یہ بڑھاپے کو نہیں پہنچے گا کہ قیامت قائم ہو جائے گی ۔"
"13257","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت معاذ بن جبل رضی اللہ عنہ نے بارگاہ رسالت میں عرض کیا یا رسول اللہ ﷽ ! یہ بتائیے کہ اگر ہمارے حکمران ایسے لوگ بن جائیں جو آپ کی سنت پر عمل نہ کریں اور آپ کے حکم پر عمل نہ کریں تو ان کے متعلق آپ کیا فرماتے ہیں آ نبی ﷽ نے فرمایا جو اللہ کی اطاعت نہیں کرتا ، اس کی اطاعت نہ کی جائے ۔"
"13258","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ انصار میں پانی کا معاملہ بہت پیچیدہ ہو گیا ، وہ لوگ اکٹھے ہو کر نبی ﷽ کے پاس یہ درخواست لے کر آئے کہ انہیں ایک جاری نہر میں سے پانی لینے کی اجازت دی جائے ، وہ اس کا کرایہ ادا کر دیں گے ، یا ان کے لئے دعاء کر دیں ، نبی ﷽ نے فرمایا انصار کو خوش آمدید ! بخدا ! آج تم مجھ سے جو مانگو گے میں تمہیں دوں گا ، یہ سن کر وہ کہنے لگے یا رسول اللہ ﷽ ! ہمارے لیے اللہ سے بخشش کی دعاء کر دیجئے ، نبی ﷽ نے فرمایا اے اللہ ! انصار کی انصار کے بچوں کی اور انصار کے بچوں کے بچوں کی مغفرت فرما ۔"
"13259","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ تعالیٰ کو اپنے بندے کے توبہ کرنے پر اس شخص سے زیادہ خوشی ہوتی ہے جس کا اونٹ کسی جنگل میں گم ہو جائے اور کچھ عرصے بعد دوبارہ مل جائے ۔"
"13260","یہ حدیث شہر بن حوشب نے حضرت ابوہریرہ رضی اللہ عنہ کے حوالے سے بھی بیان کی ہے ۔"
"13261","حضرت انس رضی اللہ عنہ سے مروی ہے کہ بعض اوقات نبی ﷽ جمعہ کے دن منبر سے نیچے اتر رہے ہوتے تھے اور کوئی آدمی اپنے کسی کام کے حوالے سے نبی ﷽ سے کوئی بات کرنا چاہتا تو نبی ﷽ اس سے بات کر لیتے تھے ، پھر بڑھ کر مصلیٰ پر چلے جاتے اور لوگوں کو نماز پڑھا دیتے ۔"
"13262","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت جبریل علیہ السلام کی سواری کی ٹاپ سے اڑنے والا وہ گردو غبار ابھی تک میری نگاہوں کے سامنے ہے جو بنو غنم کی گلیوں میں بنو قریظہ کی طرف جاتے ہوئے ان کی ایڑ لگانے سے پیدا ہوا تھا ۔"
"13263","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں تمہیں نبی ﷽ سے سنی ہوئی ایک ایسی حدیث سناتا ہوں جو میرے بعد کوئی تم سے بیان نہ کرے گا ، میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ قیامت کی علامات میں یہ بات بھی ہے کہ علم اٹھا لیا جائے گا ، اس وقت جہالت کا غلبہ ہو گا ، بدکاری عام ہو گی ، اور شراب نوشی بکثرت ہو گی ، مردوں کی تعداد کم ہو جائے گی اور عورتوں کی تعداد بڑھ جائے گی حتیٰ کہ پچاس عورتوں کا ذمہ دار صرف ایک آدمی ہو گا ۔"
"13264","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے اس بات سے منع فرمایا ہے کہ کوئی شخص کھڑے ہو کر پانی پیے ۔"
"13265","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا سجدوں میں اعتدال برقرار رکھا کرو ، اور تم میں سے کوئی شخص کتے کی طرح اپنے ہاتھ نہ بچھائے ۔"
"13266","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ یہ دعاء فرمایا کرتے تھے اے اللہ ! میں سستی ، بڑھاپے ، بزدلی ، بخل ، فتنہ دجال اور عذاب قبر اور زندگی اور موت کی آزمائش سے آپ کی پناہ میں آتا ہوں ۔"
"13267","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دو چتکبرے سینگ دار مینڈھے قربانی میں پیش کیا کرتے تھے ، اور اللہ کا نام لے کر تکبیر کہتے تھے ، نبی ﷽ انہیں اپنے ہاتھ سے ذبح کرتے تھے اور ان کے پہلو پر اپنا پااں رکھتے تھے ۔"
"13268","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ عصر کی نماز اس وقت پڑھتے تھے کہ نماز کے بعد کوئی جانے والا عوالی جانا چاہتا تو وہ جا کر واپس آ جاتا ، پھر بھی سورج بلند ہوتا تھا ۔"
"13269","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک دن نبی ﷽ مسجد میں داخل ہوئے تو دیکھا کہ لوگ بیماری کی وجہ سے بیٹھ کر نماز پڑھ رہے ہیں ، نبی ﷽ نے فرمایا بیٹھ کر نماز پڑھنے کا ثواب کھڑے ہو کر پڑھنے سے آدھا ہے ۔"
"13270","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب غزوہ تبوک سے واپسی پر مدینہ منورہ کے قریب پہنچے تو فرمایا کہ مدینہ منورہ میں کچھ لوگ ایسے بھی ہیں کہ تم جس راستے پر بھی چلے اور جس وادی کو بھی طے کیا ، وہ اس میں تمہارے ساتھ رہے ، صحابہ رضی اللہ عنہم نے عرض کیا یا رسول اللہ ﷽ ! کیا وہ مدینہ میں ہونے کے باوجود ہمارے ساتھ تھے آ فرمایا ہاں ! مدینہ میں ہونے کے باوجود ، کیونکہ انہیں کسی عذر نے روک رکھا ہے ۔"
"13271","حمید رحمۃ اللہ کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے نبی ﷽ کے بالوں کے متعلق دریافت کیا تو انہوں نے فرمایا کہ میں نے نبی ﷽ کے بالوں کے ساتھ قتادہ کے بالوں سے زیادہ مشابہہ کسی کے بال نہیں دیکھے ، اس دن قتادہ رحمۃ اللہ یہ سن کر بہت خوش ہوئے تھے ۔"
"13272","عبداللہ رحمۃ اللہ کہتے ہیں کہ ہم لوگ خارجہ بن زید رحمۃ اللہ کے ساتھ ظہر کی نماز سے فارغ ہو کر حضرت انس رضی اللہ عنہ کے پاس پہنچے ، انہوں نے اپنی باندی سے فرمایا کہ دیکھو ! نماز کا وقت ہو گیا آ اس نے کہا جی ہاں ! ہم نے ان سے کہا کہ ہم تو ابھی امام کے ساتھ ظہر کی نماز پڑھ کر آ رہے ہیں آ + اور آپ عصر کی نماز پڑھ رہے ہیں , آ لیکن وہ کھڑے ہو گئے اور نماز عصر پڑھ لی ، اس کے بعد فرمایا کہ ہم نبی ﷽ کے ساتھ اسی طرح نماز پڑھتے تھے ۔"
"13273","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک یہودی نے نبی ﷽ کو سلام کرتے ہوئے ®السام علیک¾ کہا ، صحابہ رضی اللہ عنہم نے اسے جواب دیا ، نبی ﷽ نے فرمایا کیا تم جانتے ہو کہ اس نے کیا کہا ہے آ اس نے ®السام علیک¾ کہا ہے ۔ نبی ﷽ نے صحابہ رضی اللہ عنہم سے فرمایا اسے میرے پاس بلا کر لاا ، اور اس سے پوچھا کہ کیا تم نے ®السام علیک¾ کہا تھا آ اس نے اقرار کیا تو نبی ﷽ نے + اپنے صحابہ رضی اللہ عنہم سے , فرمایا جب تمہیں کوئی """" کتابی """" سلام کرے تو صرف """" وعلیک """" کہا کرو ۔"
"13274","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مدینہ منورہ کے کسی راستے میں نبی ﷽ اپنے صحابہ رضی اللہ عنہم کے ہمراہ چلے جا رہے تھے کہ ایک خاتون ملی اور کہنے لگی یا رسول اللہ ﷽ ! مجھے آپ سے ایک کام ہے ، نبی ﷽ نے اس سے فرمایا کہ تم جس گلی میں چاہو بیٹھ جاا ، میں تمہارے ساتھ بیٹھ جااں گا چنانچہ وہ ایک جگہ بیٹھ گئی اور نبی ﷽ بھی اس کے ساتھ بیٹھ گئے اور اس کا کام کر دیا ۔"
"13275","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے جب حلق کروایا تو بال کاٹنے والے کے سامنے پہلے سر کا داہنا حصہ کیا ، اس نے اس حصے کے بال تراشے ، نبی ﷽ نے وہ بال حضرت ابوطلحہ رضی اللہ عنہ کو دے دیئے ، پھر بائیں جانب کے بال منڈوائے تو وہ عام لوگوں کو دے دیئے ۔"
"13276","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جب تم میں سے کوئی شخص نماز پڑھ رہا ہوتا ہے تو وہ اپنے رب سے مناجات کر رہا ہوتا ہے ، اس لئے اس حالت میں تم میں سے کوئی شخص اپنی دائیں جانب نہ تھوکا کرے بلکہ بائیں جانب یا اپنے پااں کے نیچے تھوکا کرے ۔"
"13277","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کے پاس پانی کا ایک پیالہ لایا گیا جس میں آپ کی انگلی بھی مشکل سے کھلتی تھی ، نبی ﷽ نے اپنی انگلیوں کو جوڑ لیا اور اس میں سے اتنا پانی نکلا کہ سب نے وضو کر لیا ، کسی نے حضرت انس رضی اللہ عنہ سے پوچھا کہ اس وقت آپ کتنے لوگ تھے آ انہوں نے بتایا کہ ہم لوگ تین سو تھے ۔"
"13278","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا سحری کھایا کرو ، کیوں کہ سحری میں برکت ہوتی ہے ۔"
"13279","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب حدیبیہ سے واپس آ رہے تھے تو صحابہ کرام رضی اللہ عنہم پر غم اور پریشانی کے آثار تھے کیونکہ انہیں عمرہ ادا کرنے سے روک دیا گیا تھا اور انہیں حدیبیہ میں ہی اپنے جانور قربان کرنے پڑے تھے ، اس موقع پر آپ ﷽ پر یہ آیت نازل ہوئی ®انا فتحنا لک فتحا مبینا ۔۔۔۔۔۔ ۔ صراطا مستقیما¾ نبی ﷽ نے فرمایا مجھ پر ایک آیت ایسی نازل ہوئی ہے جو مجھے ساری دنیا سے زیادہ محبوب ہیں ، پھر نبی ﷽ نے اس کی تلاوت فرمائی ، تو ایک مسلمان نے یہ سن کر کہا یا رسول اللہ ﷽ ! آپ کو مبارک ہو کہ اللہ نے آپ کو یہ دولت عطاء فرمائی ، ہمارے لیے کیا حکم ہے آ اس پر یہ آیت نازل ہوئی ®لیدخل المومنین والمومنات جنات ۔۔۔۔۔۔ ۔ فوزا عظیما¾"
"13280","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا پہلے اگلی پھر اس کے بعد والی صفوں کو مکمل کیا کرو اور کوئی کمی ہو تو وہ آخری صف میں ہونی چاہئے ۔"
"13281","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے حضرت عبدالرحمن بن عوف رضی اللہ عنہ اور حضرت زبیر بن عوام رضی اللہ عنہ کو خارش کی وجہ سے ریشمی کپڑے پہننے کی اجازت مرحمت فرما دی ۔"
"13282","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے آیت قرآنی ®وکتبنا علیھم فیھا ان النفس بالنفس والعین بالعین¾ میں """" ®نفس¾ """" کے لفظ کو منصوب اور """" ®عین¾ """" کے لفظ کو مرفوع پڑھا ہے ۔"
"13283","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت حارثہ رضی اللہ عنہ سیر پر نکلے ، راستے میں کہیں سے ناگہانی تیر ان کے آ کر لگا اور وہ شہید ہو گئے ، ان کی والدہ نے بارگاہ رسالت میں عرض کیا یا رسول اللہ ﷽ ! آپ جانتے ہیں کہ مجھے حارثہ سے کتنی محبت تھی ، اگر تو وہ جنت میں ہے تو میں صبر کر لوں گی ، نبی ﷽ نے فرمایا اے ام حارثہ ! جنت صرف ایک تو نہیں ہے ، وہ تو بہت سی جنتیں ہیں اور حارثہ ان میں سب سے افضل جنت میں ہے ۔"
"13284","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص اپنے ورثاء کے لئے مال چھوڑ جائے ، وہ اس کے اہل خانہ کا ہے ، اور جو قرض چھوڑ جائے ، اس کی ادائیگی اللہ اور اس کے رسول ﷽ کے ذمے ہے ۔"
"13285","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے حضرت عبدالرحمن بن عوف رضی اللہ عنہ اور حضرت زبیر بن عوام رضی اللہ عنہ کو خارش کی وجہ سے ریشمی کپڑے پہننے کی اجازت مرحمت فرما دی ۔"
"13286","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے سینگی لگوائی اور آپ ﷽ کسی کی مزدوری کے معاملے میں اس پر ظلم نہیں فرماتے تھے ۔"
"13287","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ ایک عرصے تک """" جب تک اللہ کو منظور ہوا """" سر کے بال کنگھی کے بغیر رکھتے ، پھر آپ ﷽ نے مانگ نکالنا شروع کر دی ۔"
"13288","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ تیس دن تک قبیلہ رعل ، ذکوان ، بنولحیان اور عصیہ """" جنہوں نے اللہ اور اس کے رسول ﷽ کی نافرمانی کی تھی """" کے خلاف بددعاء فرماتے رہے ، ان لوگوں نے بئر معونہ پر صحابہ کو شہید کر دیا تھا ، اور اس سلسلے میں قرآن کریم کی ایک آیت بھی نازل ہوئی تھی جو ہم پہلے پڑھتے تھے + پھر تلاوت منسوخ ہو گئی , کہ ہماری طرف سے ہماری قوم کو یہ پیغام پہنچا دو کہ ہم اپنے رب سے مل چکے ، وہ ہم سے راضی ہو گیا اور ہمیں بھی راضی کر دیا ۔"
"13289","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مدینہ منورہ کی ایک عام باندی بھی نبی ﷽ کا دست مبارک پکڑ کر اپنے کام کاج کے لئے نبی ﷽ کو لے جایا کرتی تھی اور نبی ﷽ اس سے اپنا ہاتھ نہ چھڑاتے تھے ۔"
"13290","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اپنے ہاتھ اتنے بلند فرماتے کہ آپ ﷽ کی مبارک بغلوں کی سفیدی تک دکھائی دیتی ۔"
"13291","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اپنے خیمے میں فرمایا کرتے تھے اے اللہ ! میں حاضر ہوں آخرت کی زندگی کے علاوہ کوئی زندگی نہیں ، پس انصار اور مہاجرین کو معاف فرما ۔"
"13292","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور حضرات شیخین رضی اللہ عنہم بلند آواز سے بسم اللہ نہ پڑھتے تھے ۔"
"13293","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی وہ آخری نماز جو آپ ﷽ نے لوگوں کے ساتھ پڑھی ، وہ ایک کپڑے میں لپٹ کر بیٹھ کر پڑھی تھی ۔"
"13294","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا میرے حوض کے دونوں کناروں کا درمیانی فاصلہ اتنا ہے جتنا مدینہ اور صنعاء یا مدینہ اور عمان کے درمیان ہے ۔"
"13295","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے نبی ﷽ سے پوچھا کہ جو شخص نماز پڑھنا بھول جائے یا سو جائے ، تو اس کا کیا حکم ہے آ نبی ﷽ نے فرمایا جب یاد آئے ، اسے پڑھ لے ۔"
"13296","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے کبھی خضاب نہیں لگایا ، آپ ﷽ کی ڈاڑھی کے اگلے حصے میں ، تھوڑی کے اوپر بالوں میں ، سر میں اور کنپٹیوں پر چند بال سفید تھے ، جو بہت زیادہ محسوس نہ ہوتے تھے ، البتہ حضرت ابوبکر صدیق رضی اللہ عنہ مہندی کا خضاب کیا کرتے تھے ۔"
"13297","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب ہم لوگ نبی ﷽ سے بیعت کرتے تھے تو نبی ﷽ اس میں """" حسبْ طاقت """" کی قید لگا دیتے تھے ۔"
"13298","حضرت انس رضی اللہ عنہ سے مروی ہے کہ آپ ﷽ نے ایک مہینے تک فجر کی نماز میں قنوت نازلہ پڑھی اور رعل ، ذکوان ، عصیہ اور بنو لحیان کے قبائل پر بددعاء کرتے رہے ۔"
"13299","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کسی سفر پر روانہ ہوئے ، کچھ صحابہ رضی اللہ عنہم بھی ہمراہ تھے ، نماز کا وقت قریب آ گیا ، لوگوں نے وضو کے لئے پانی تلاش کیا لیکن پانی نہیں ملا ، انہوں نے نبی ﷽ سے عرض کیا یا رسول اللہ ! ہمیں وضو کے لئے پانی نہیں مل رہا ، نبی ﷽ نے ان کے چہروں پر پریشانی کے آثار دیکھے ، ایک آدمی گیا اور ایک پیالے میں تھوڑا سا پانی لے آیا ، نبی ﷽ اسے لے کر وضو فرمانے لگے پھر اپنی چار انگلیاں اس پیالے میں ڈال دیں ، لوگوں کو اس پانی سے وضو کرنے کا حکم دے دیا ، لوگ اس سے وضو کرتے رہے یہاں تک کہ سب لوگوں نے وضو کر لیا ، کسی نے حضرت انس رضی اللہ عنہ سے لوگوں کی تعداد پوچھی تو انہوں نے فرمایا ستر یا اس کے قریب ۔"
"13300","حضرت انس رضی اللہ عنہ فرمایا کرتے تھے کہ بہت کم کوئی رات ایسی گذرتی ہے جس میں مجھے اپنے خلیل ﷽ کی زیارت نصیب نہ ہوتی ہو ، یہ کہتے ہوئے حضرت انس رضی اللہ عنہ کی آنکھوں سے آنسو رواں ہوتے تھے ۔"
"13301","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ انصار اکٹھے ہو کر نبی ﷽ کے پاس آئے اور کہنے لگے کہ ہم کب تک کنواں سے پانی کھینچ کر لاتے رہیں گے ، نبی ﷽ کے پاس چلتے ہیں کہ وہ اللہ سے ہمارے لیے دعاء کر دیں کہ ان پہاڑوں سے چشمے جاری کر دے ، نبی ﷽ نے انہیں دیکھ کر فرمایا انصار کو خوش آمدید ! بخدا ! آج تم مجھ سے جو مانگو گے میں تمہیں دوں گا اور میں اللہ سے تمہارے لیے جس چیز کا سوال کروں گا ، اللہ وہ مجھے ضرور عطاء فرمائے گا ، یہ سن کر وہ ایک دوسرے سے کہنے لگے موقع غنیمت سمجھو اور اپنے گناہوں کی معافی کا مطالبہ کر لو ، چنانچہ وہ کہنے لگے یا رسول اللہ ﷽ ! ہمارے لیے اللہ سے بخشش کی دعاء کر دیجئے ، نبی ﷽ نے فرمایا اے اللہ ! انصار کی انصار کے بچوں کی اور انصار کے بچوں کے بچوں کی مغفرت فرما وہ کہنے لگے یا رسول اللہ ! ہماری دوسری اولاد کیا ہم میں شامل نہیں ہے آ نبی ﷽ نے انہیں بھی دعاء میں شامل کر لیا ، پھر انہوں نے اپنے موالی کا ذکر کیا تو نبی ﷽ نے انہیں بھی شامل کر لیا ۔ گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"13302","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ ہمارے یہاں تشریف لائے ، اس وقت گھر میں میرے ، والدہ اور میری خالہ ام حرام کے علاوہ کوئی نہ تھا ، نماز کا وقت نہ تھا لیکن نبی ﷽ نے فرمایا اٹھو میں تمہارے لیے نماز پڑھ دوں + چنانچہ نبی ﷽ نے ہمیں نماز پڑھائی , راوی نے ثابت سے پوچھا کہ نبی ﷽ نے حضرت انس رضی اللہ عنہ کو کہاں کھڑا کیا آ انہوں نے کہا دائیں جانب ، اور عورتوں کو ان کے پیچھے ۔"
"13303","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوطلحہ رضی اللہ عنہ کا ایک بیٹا فوت ہو گیا ، نبی ﷽ نے اس کی نماز جنازہ پڑھائی ، حضرت ابوطلحہ رضی اللہ عنہ نبی ﷽ کے پیچھے کھڑے ہوئے ، اور حضرت ام سلیم رضی اللہ عنہا ، ابوطلحہ رضی اللہ عنہ کے پیچھے کھڑی ہوئیں ، ایسا محسوس ہوتا تھا کہ جیسے وہ سب مرغ کی کلغی ہوں ۔"
"13304","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے ہمیں نماز پڑھائی ، میں اور ام سلیم ان کے ہمراہ تھے ، نبی ﷽ نے مجھے اپنی دائیں جانب اور ام سلیم کو ہمارے پیچھے کھڑا کر دیا ۔"
"13305","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ عصر کی نماز اس وقت پڑھتے تھے کہ نماز کے بعد کوئی جانے والا عوالی جانا چاہتا تو وہ جا کر واپس آ جاتا ، پھر بھی سورج بلند ہوتا تھا ۔"
"13306","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا صبر تو صدمہ کے آغاز میں ہوتا ہے ۔"
"13307","حضرت انس رضی اللہ عنہ سے مروی ہے کہ آپ ﷽ نے ایک مہینے تک فجر کی نماز میں رکوع کے بعد قنوت نازلہ پڑھی اور عرب کے قبائل پر بددعاء کرتے رہے ، پھر اسے ترک فرما دیا ۔"
"13308","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جس دن شراب حرام ہوئی میں اس دن اکیلا گیارہ آدمیوں کو پلا رہا تھا ، جب اس کی حرمت معلوم ہوئی تو انہوں نے مجھے حکم دیا کہ تمہارے برتن میں جتنی شراب ہے سب انڈیل دو ، بخدا ! دوسرے لوگوں نے بھی اپنے برتنوں کی شراب انڈیل دی ، حتیٰ کہ مدینہ کی گلیوں سے شراب کی بدبو آنے لگی ، اور ان کی اس وقت شراب بھی صرف کچی اور پکی کھجور ملا کر بنائی گئی نبیذ تھی ۔ حضرت انس رضی اللہ عنہ کہتے ہیں کہ ایک آدمی بارگاہ نبوت میں حاضر ہو کر کہنے لگا کہ میرے پاس ایک یتیم کا مال تھا ، میں نے اس سے شراب خرید لی تھی ، کیا آپ مجھے اس بات کی اجازت دیتے ہیں کہ میں اسے بیچ کر اس یتیم کو اس کا مال لوٹا دوں آ نبی ﷽ نے فرمایا اللہ تعالیٰ کی مار ہو یہودیوں پر کہ ان پر چربی کو حرام قرار دیا گیا تو وہ اسے بیچ کر اس کی قیمت کھانے لگے ، اور نبی ﷽ نے شراب کو بیچنے کی اجازت نہیں دی ۔"
"13309","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے دور باسعادت میں ایک آدمی """" جس کی عقل میں کچھ کمزوری تھی """" خرید و فروخت کیا کرتا تھا + اور دھوکہ کھاتا تھا , اس کے اہل خانہ نبی ﷽ کی خدمت میں حاضر ہوئے اور کہنے لگے اے اللہ کے نبی ! فلاں شخص پر خرید و فروخت کی پابندی لگا دیں کیونکہ اس کی عقل کمزور ہے ، نبی ﷽ نے اسے بلا کر اسے خرید و فروخت کرنے سے منع کر دیا ، وہ کہنے لگا کہ اے اللہ کے نبی ! میں اس کام سے نہیں رک سکتا ، نبی ﷽ نے فرمایا اگر تم خرید و فروخت کو نہیں چھوڑ سکتے تو پھر معاملہ کرتے وقت یہ کہہ دیا کرو کہ اس معاملے میں کوئی دھوکہ نہیں ہے ۔"
"13310","سعدی کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ نبی ﷽ کس طرف سے واپس جاتے تھے آ انہوں نے فرمایا کہ میں نے جناب رسول اللہ ﷽ کو دیکھا کہ وہ نماز پڑھ کر دائیں جانب سے واپس گئے تھے ۔"
"13311","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نبی ﷽ نے فرمایا اس ذات کی قسم جس کے دست قدرت میں محمد ﷽ کی جان ہے ، جو میں دیکھ چکا ہوں ، اگر تم نے وہ دیکھا ہوتا تو تم بہت تھوڑا ہنستے اور کثرت سے رویا کرتے ، صحابہ رضی اللہ عنہم نے پوچھا یا رسول اللہ ﷽ ! آپ نے کیا دیکھا ہے آ فرمایا میں نے اپنی آنکھوں سے جنت اور جہنم کو دیکھا ہے اور لوگو ! میں تمہارا امام ہوں ، لہٰذا رکوع ، سجدہ ، قیام ، قعود اور اختتام میں مجھ سے آگے نہ بڑھا کرو ، کیونکہ میں تمہیں اپنے آگے سے بھی دیکھتا ہوں اور پیچھے سے بھی ۔"
"13312","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جس شخص کو اسلام کی حالت میں چالیس برس کی عمر مل جائے ، اللہ اس سے تین قسم کی بیماریاں جنون ، کوڑھ ، چیچک کو دور فرما دیتے ہیں ، جب وہ پچاس سال کی عمر کو پہنچ جائے تو اللہ اس پر حساب کتاب میں آسانی فرما دیتا ہے ، جب ساٹھ سال کی عمر کو پہنچ جائے تو اللہ اسے اپنی طرف رجوع کی توفیق عطاء فرماتا ہے جو اسے محبوب ہے ، جب وہ ستر سال کی عمر کو پہنچ جائے تو اللہ تعالیٰ اور سارے آسمان والے اس سے محبت کرنے لگتے ہیں ، اور جب وہ اسی سال کی عمر کو پہنچ جائے تو اللہ تعالیٰ اس کی نیکیاں قبول فرما لیتا ہے اور اس کے گناہوں سے درگذر فرماتا ہے ، اور جب نوے سال کی عمر کو پہنچ جائے تو اللہ اس کے اگلے پچھلے سارے گناہ معاف فرما دیتا ہے ، اور اسے زمین میں """" اسیر اللہ """" کا نام دیا جاتا ہے اور اس کے اہل خانہ کے حق میں اس کی سفارش قبول ہوتی ہے ۔ فائدہ = محدثین نے اس حدیث کو """" موضوع """" قرار دیا ہے ۔"
"13313","حضرت انس رضی اللہ عنہ سے مروی ہے کہ آپ ﷽ نے ایک مہینے تک فجر کی نماز میں + رکوع کے بعد , قنوت نازلہ پڑھی ۔"
"13314","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا ہر نبی کی ایک دعاء ایسی ضرور تھی جو انہوں نے مانگی اور قبول ہو گئی ، جب کہ میں نے اپنی دعاء اپنی امت کی سفارش کرنے کی خاطر قیامت کے دن کے لئے محفوظ کر رکھی ہے ۔"
"13315","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ایک ہی سحری سے مسلسل کئی روزے نہ رکھا کرو ، کسی نے عرض کیا یا رسول اللہ ! آپ تو اس طرح کرتے ہیں آ نبی ﷽ نے فرمایا میں اس معاملے میں تمہاری طرح نہیں ہوں ، میرا رب مجھے کھلا پلا دیتا ہے ۔"
"13316","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ابوطلحہ رضی اللہ عنہ نے مجھے نبی ﷽ کو کھانے پر بلانے کے لئے بھیج دیا ، انہوں نے نبی ﷽ کے لیے کھانے کا انتظام کیا تھا ، میں نبی ﷽ کے پاس پہنچا تو آپ ﷽ صحابہ کرام رضی اللہ عنہم کے درمیان رونق افروز تھے ، نبی ﷽ نے میری طرف دیکھا تو مجھے شرم آ گئی ، میں نے نبی ﷽ سے عرض کیا کہ مجھے حضرت ابوطلحہ رضی اللہ عنہ نے آپ کے پاس کھانے کی دعوت دے کر بھیجا ہے ، نبی ﷽ نے لوگوں سے فرمایا اٹھو ، حضرت ابوطلحہ رضی اللہ عنہ نے نبی ﷽ کے پہلو میں چلتے چلتے کہہ دیا کہ یا رسول اللہ ﷽ ! میں نے تو صرف آپ کے لئے کھانا تیار کیا تھا ، نبی ﷽ جب ان کے گھر پہنچے تو وہ کھانا نبی ﷽ کے پاس لایا گیا ، نبی ﷽ نے اس پر اپنا دست مبارک رکھا ، اور برکت کی دعا کر کے فرمایا دس آدمیوں کو بلاا ، چنانچہ دس آدمی اندر آئے اور انہوں نے خوب سیر ہو کر کھانا کھایا ، پھر دس دس کر کے سب آدمیوں نے وہ کھانا کھا لیا اور خوب سیراب ہو کر سب نے کھایا اور وہ کھانا جیسے تھا ، ویسے ہی باقی رہا اور ہم نے بھی اسے کھایا ۔"
"13317","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک یہودی آدمی بارگاہ نبوت کے قریب سے گذرا اور نبی ﷽ کو سلام کرتے ہوئے اس نے ®السام علیک¾ کہا ، نبی ﷽ نے فرمایا ®وعلیک¾ پھر صحابہ رضی اللہ عنہم سے فرمایا تم جانتے ہو کہ اس نے کیا کہا ہے آ یہ کہہ رہا ہے ®السام علیک¾ یہ سن کر صحابہ رضی اللہ عنہم کہنے لگے یا رسول اللہ ﷽ ! کیا ہم اس کی گردن نہ اڑا دیں آ نبی ﷽ نے فرمایا نہیں ، البتہ جب اہل کتاب تمہیں سلام کیا کریں تو تم صرف ®وعلیکم¾ کہا کرو ۔"
"13318","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک یہودیہ عورت نے گوشت میں زہر ملایا اور نبی ﷽ کی خدمت میں لے آئی ، نبی ﷽ نے ابھی اس میں سے ایک لقمہ ہی کھایا تھا کہ فرمانے لگے اس عورت نے اس میں زہر ملایا ہے ، صحابہ کرام رضی اللہ عنہم کہنے لگے یا رسول اللہ ﷽ ! کیا ہم اسے قتل نہ کر دیں آ نبی ﷽ نے فرمایا نہیں ، راوی کہتے ہیں کہ میں نبی ﷽ کے تالو میں اس زہر کا اثر دیکھ رہا تھا ۔"
"13319","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک مرتبہ حضرت ابی بن کعب رضی اللہ عنہ سے فرمایا کہ اللہ نے مجھے حکم دیا ہے کہ تمہیں قرآن پڑھ کر سنااں ، حضرت ابی بن کعب رضی اللہ عنہ نے عرض کیا کہ کیا اللہ نے میرا نام لے کر کہا ہے آ نبی ﷽ نے فرمایا ہاں ! یہ سن کر حضرت ابی بن کعب رضی اللہ عنہ رو پڑے ۔"
"13320","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا میں اور قیامت ان دو انگلیوں کی طرح اکٹھے بھیجے گئے ہیں ، یہ کہہ کر نبی ﷽ نے شہادت والی انگلی اور درمیانی انگلی کی طرف اشارہ فرمایا ۔"
"13321","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا قیامت کے دن ایک کافر کو لا کر اس سے کہا جائے گا کہ یہ بتا ، اگر تیرے پاس روئے زمین کے برابر سونا موجود ہو تو کیا تو وہ سب اپنے فدیے میں دے دے گا آ وہ کہے گا ہاں ! اللہ فرمائے گا کہ میں نے تو تجھ سے دنیا میں اس سے بھی ہلکی چیز کا مطالبہ کیا تھا ، یہی مراد ہے اس ارشاد ربانی کی """" بیشک وہ لوگ جنہوں نے کفر کیا اور مر گئے جب کہ وہ کافر ہی تھے ، ان میں کسی سے زمین بھر کر بھی سونا قبول نہیں کیا جائے گا گو کہ وہ اسے فدیے میں پیش کر دے ۔"""""
"13322","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے فرمایا میں نے جنت اور جہنم کو دیکھا کہ وہ اس دیوار میں میرے سامنے پیش کی گئی ہیں ، میں نے آج جیسا بہترین اور سخت ترین دن نہیں دیکھا ۔"
"13323","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا ہر نبی کی ایک دعاء ایسی ضرور تھی جو انہوں نے مانگی اور قبول ہو گئی ، جب کہ میں نے اپنی دعاء اپنی امت کی سفارش کرنے کی خاطر قیامت کے دن کے لئے محفوظ کر رکھی ہے ۔"
"13324","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی مدینہ تشریف آوری کے بعد لوگ اپنے مال میں سے کھجور کے درخت وغیرہ نبی ﷽ کو دے دیتے تھے + اور نبی ﷽ لوگوں میں تقسیم کر دیتے , حتیٰ کہ جب بنو قریظہ اور بنو نضیر مفتوح ہو گئے تو نبی ﷽ نے وہ درخت ان کے مالکان کو واپس لوٹانا شروع کر دیئے ، یہ دیکھ کر میرے گھر والوں نے مجھے حکم دیا کہ میں بھی نبی ﷽ کی خدمت میں حاضری دوں اور درخواست کروں کہ ان کے اہل خانہ نے دو درخت دیئے تھے ، وہ دونوں یا ان میں سے ایک واپس کر دیئے جائیں ، نبی ﷽ نے وہ درخت حضرت ام ایمن رضی اللہ عنہا کو دے دیئے تھے ، بہرحال ! میری درخواست پر نبی ﷽ نے وہ مجھے واپس دے دیئے ، اسی اثناء میں حضرت ام ایمن رضی اللہ عنہا بھی آ گئیں اور میرے گلے میں کپڑا ڈال کر کہنے لگیں اس خدا کی قسم جس کے علاوہ کوئی معبود نہیں ، نبی ﷽ تمہیں یہ درخت ہرگز نہیں دے سکتے جب کہ یہ تو انہوں نے مجھے دیئے ہیں ، نبی ﷽ نے ان سے فرمایا کہ آپ اس کے بدلے میں اتنے اتنے درخت لے لیں لیکن وہ برابر انکار کرتی رہیں اور نبی ﷽ برابر درختوں کی تعداد میں اضافہ کرتے رہے ، حتیٰ کہ دس گنا زائد درختوں پر وہ راضی ہو گئیں اور نبی ﷽ نے وہ انہیں عطاء کر دیئے ۔"
"13325","حضرت انس رضی اللہ عنہ سے مروی ہے کہ کسی شخص نے نبی ﷽ کو + رئیس المنافقین , عبداللہ بن ابی کے پاس جانے کا مشورہ دیا ، نبی ﷽ اپنے گدھے پر سوار ہو کر چلے گئے ، مسلمان بھی نبی ﷽ کے ساتھ پیدل روانہ ہو گئے ، زمین کچی تھی ، نبی ﷽ اس کے پاس پہنچے تو وہ کہنے لگا کہ آپ مجھ سے دور ہی رہیں ، آپ کے گدھے کی بدبو سے مجھے تکلیف ہو رہی ہے ، اس پر ایک انصاری نے کہا کہ بخدا ! نبی ﷽ کا گدھا تجھ سے زیادہ خوشبودار ہے ، ادھر عبداللہ بن ابی کی قوم کا ایک آدمی اس کی طرف سے غضب ناک ہو گیا ، پھر دونوں کے ساتھیوں میں غم و غصہ کی لہر دوڑ گئی ، اور شاخوں ، ہاتھوں اور جوتوں سے لڑائی کی نوبت آ گئی ، ہمیں معلوم ہوا کہ یہ آیت انہی کے بارے نازل ہوئی کہ """" اگر مسلمانوں کے دو گروہ آپس میں لڑ پڑیں تو آپ ان کے درمیان صلح کرا دیں ۔"""""
"13326","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے مجھ سے راز کی ایک بات فرمائی تھی ، میں نے وہ بات آج تک کسی کو نہیں بتائی ، حتیٰ کہ میری والدہ حضرت ام سلیم رضی اللہ عنہا نے بھی مجھ سے وہ بات پوچھی تو میں نے انہیں بھی نہیں بتائی ۔"
"13327","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا میرے حوض کے دونوں کناروں کا درمیانی فاصلہ اتنا ہے جتنا مدینہ اور صنعاء یا مدینہ اور عمان کے درمیان ہے ۔"
"13328","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ عرق النساء نامی مرض کے لئے سیاہ عربی مینڈھے کی چکی کی تشخیص فرماتے تھے جو بہت بڑا بھی نہ ہو اور بہت چھوٹا بھی نہ ہو ، اس کے تین حصے کر کے اسے پگھلا لیا جائے اور روزانہ ایک حصہ پی لیا جائے ۔"
"13329","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب بدر کی طرف روانہ ہو گئے تو لوگوں سے مشورہ کیا ، اس کے جواب میں حضرت ابوبکر صدیق رضی اللہ عنہ نے ایک مشورہ دیا ، پھر دوبارہ مشورہ مانگا تو حضرت عمر رضی اللہ عنہ نے ایک مشورہ دے دیا ، یہ دیکھ کر نبی ﷽ خاموش ہو گئے ، انصار نے کہا کہ یا رسول اللہ ! شاید آپ کی مراد ہم ہیں آ حضرت مقداد رضی اللہ عنہ نے عرض کیا یا رسول اللہ ! اس ذات کی قسم جس کے دست قدرت میں میری جان ہے اگر آپ ہمیں حکم دیں تو سمندروں میں گھس پڑیں ، اور اگر آپ حکم دیں تو ہم برک الغماد تک اونٹوں کے جگر مارتے ہوئے چلے جائیں ، لہٰذا یا رسول اللہ ! معاملہ آپ کے ہاتھ میں ہے ، نبی ﷽ اپنے صحابہ رضی اللہ عنہم کو تیار کر کے روانہ ہو گئے اور بدر میں پڑاا کیا ، قریش کے کچھ جاسوس آئے تو ان میں بنو حجاج کا ایک سیاہ فام غلام بھی تھا ، صحابہ رضی اللہ عنہم نے اسے گرفتار کر لیا ، اور اس سے ابوسفیان اور اس کے ساتھیوں کے متعلق پوچھا ، وہ کہنے لگا کہ ابوسفیان کا تو مجھے کوئی علم نہیں ہے البتہ قریش ، ابوجہل اور امیہ بن خلف آ گئے ہیں ، وہ لوگ جب اسے مارتے تو وہ ابوسفیان کے بارے بتانے لگتا اور جب چھوڑتے تو وہ کہتا کہ مجھے ابوسفیان کا کیا پتہ آ البتہ قریش آ گئے ہیں ، اس وقت نبی ﷽ نماز پڑھ رہے تھے ۔ نماز سے فارغ ہو کر نبی ﷽ نے فرمایا یہ جب تم سے سچ بیان کرتا ہے تو تم اسے مارتے ہو اور جب یہ جھوٹ بولتا ہے تو تم اسے چھوڑ دیتے ہو ، پھر نبی ﷽ نے اپنے ہاتھ سے اشارہ کرتے ہوئے فرمایا انشاء اللہ کل فلاں شخص یہاں گرے گا اور فلاں شخص یہاں ، چنانچہ آمنا سامنا ہونے پر مشرکین کو اللہ نے شکست سے دوچار کر دیا اور بخدا ایک آدمی بھی نبی ﷽ کی بتائی ہوئی جگہ سے نہیں ہلا تھا ۔ تین دن کے بعد نبی ﷽ ان کی لاشوں کے پاس گئے اور فرمایا اے ابوجہل بن ہشام ! اے عتبہ بن ربیعہ ! اے شیبہ بن ربیعہ ! اور اے امیہ بن خلف ! کیا تم سے تمہارے رب نے جو وعدہ کیا تھا ، اسے تم نے سچا پایا آ مجھ سے تو میرے رب نے جو وعدہ کیا تھا ، میں نے اسے سچا پایا ، حضرت عمر رضی اللہ عنہ نے عرض کیا یا رسول اللہ ﷽ ! آپ ان لوگوں کو تین دن کے بعد آواز دے رہے ہیں جو مردہ ہو چکے آ نبی ﷽ نے فرمایا میں جو بات کہہ رہا ہوں ، تم ان سے زیادہ نہیں سن رہے ، البتہ وہ اس کا جواب نہیں دے سکتے پھر نبی ﷽ کے حکم پر انہیں پااں سے گھسیٹ کر بدر کے کنویں میں پھینک دیا گیا ۔"
"13330","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب بدر کی طرف روانہ ہو گئے تو لوگوں سے مشورہ کیا ، اس کے جواب میں حضرت ابوبکر صدیق رضی اللہ عنہ نے ایک مشورہ دیا ، پھر دوبارہ مشورہ مانگا تو حضرت عمر رضی اللہ عنہ نے ایک مشورہ دے دیا ، یہ دیکھ کر نبی ﷽ خاموش ہو گئے ، حضرت سعد بن عبادہ رضی اللہ عنہ نے کہا کہ یا رسول اللہ ! شاید آپ کی مراد ہم ہیں آ اس ذات کی قسم جس کے دست قدرت میں میری جان ہے اگر آپ ہمیں حکم دیں تو سمندروں میں گھس پڑیں ، اور اگر آپ حکم دیں تو ہم برک الغماد تک اونٹوں کے جگر مارتے ہوئے چلے جائیں ۔۔۔۔۔۔ پھر راوی نے پوری حدیث ذکر کی ۔"
"13331","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا خروج دجال سے پہلے کچھ سال دھوکے والے ہوں گے ، جن میں سچے کو جھوٹا اور جھوٹے کو سچا قرار دیا جائے گا ، امین کو خائن اور خائن کو امین سمجھا جائے گا ، اور اس میں """" رویبضہ """" بڑھ چڑھ کر بولے گا ، کسی نے پوچھا کہ رویبضہ سے کیا مراد ہے آ نبی ﷽ نے فرمایا فاسق آدمی امور عامہ میں دخل اندازی کرنے لگے گا ۔"
"13332","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کو کھرچھن بہت پسند تھی ۔"
"13333","حدیث نمبر + 46664 , اس دوسری سند سے بھی مروی ہے ۔"
"13334","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نبی ﷽ کے ساتھ مدینہ منورہ کے کسی راستے سے گذر رہا تھا ، نبی ﷽ کو وہاں اینٹوں سے بنا ہوا ایک مکان نظر آیا ، نبی ﷽ نے پوچھا یہ کس کا ہے آ میں نے عرض کیا فلاں صاحب کا ، نبی ﷽ نے فرمایا یاد رکھو ! مسجد کے علاوہ ہر تعمیر قیامت کے دن انسان پر بوجھ ہو گی ، کچھ عرصے کے بعد نبی ﷽ کا دوبارہ وہاں سے گذر ہوا ، تو وہاں وہ مکان نظر نہ آیا ، نبی ﷽ نے پوچھا کہ اس مکان کا کیا بنا آ میں نے عرض کیا کہ اس کے مالک کو آپ کی بات معلوم ہوئی تو اس نے اسے منہدم کر دیا ، نبی ﷽ نے اسے دعاء دی کہ اللہ اس پر رحم فرمائے ۔"
"13335","بلال بن ابی موسیٰ کہتے ہیں کہ ایک مرتبہ حجاج نے حضرت انس رضی اللہ عنہ کے بیٹے کو بصرہ کا قاضی مقرر کرنا چاہا تو حضرت انس رضی اللہ عنہ نے اس سے فرمایا کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ جو شخص عہدہ قضا کو طلب کرتا ہے ، اسے اس کے حوالے کر دیا جاتا ہے اور جسے زبردستی عہدہ قضاء دے دیا جائے ، اس پر ایک فرشتہ نازل ہوتا ہے جو اسے سیدھی راہ پر گامزن رکھتا ہے ۔"
"13336","حضرت انس رضی اللہ عنہ سے مروی ہے کہ اہل مکہ نے نبی ﷽ سے کوئی معجزہ دکھانے کی فرمائش کی تو نبی ﷽ نے انہیں دو مرتبہ شق قمر کا معجزہ دکھایا ۔"
"13337","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں آپ ﷽ کو کثرت سے یہ کہتے ہوئے سنتا تھا کہ اے اللہ ! میں پریشانی ، غم ، لاچاری ، سستی ، بخل ، بزدلی ، قرضوں کے بوجھ اور لوگوں کے غلبے سے آپ کی پناہ میں آتا ہوں ۔"
"13338","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا طاعون ہر مسلمان کے لئے شہادت ہے ۔"
"13339","حضرت انس رضی اللہ عنہ سے مروی ہے کہ کسی شخص نے نبی ﷽ سے """" کوثر """" کے متعلق پوچھا ، نبی ﷽ نے فرمایا کہ یہ ایک نہر کا نام ہے جو میرے رب نے مجھے عطاء فرمائی ہے ، اس کا پانی دودھ سے زیادہ سفید اور شہد سے زیادہ میٹھا ہو گا ، اور اس میں اونٹوں کی گردنوں کے برابر پرندے ہوں گے ، حضرت عمر رضی اللہ عنہ نے عرض کیا کہ یا رسول اللہ ﷽ ! پھر تو وہ پرندے خوب صحت مند ہوں گے ، نبی ﷽ نے فرمایا عمر ! انہیں کھانے والے ان سے بھی زیادہ صحت مند ہوں گے ۔"
"13340","حضرت انس رضی اللہ عنہ ، حضرت عمر بن عبدالعزیز رضی اللہ عنہ کے متعلق """" جب کہ وہ مدینہ منورہ میں تھے """" فرماتے تھے کہ میں نے تمہارے اس امام سے زیادہ نبی ﷽ کے ساتھ مشابہت رکھنے والی نماز پڑھتے ہوئے کسی کو نہیں دیکھا ، حضرت عمر بن عبدالعزیز رحمۃ اللہ طویل قراءت نہ کرتے تھے ۔"
"13341","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب کوئی بات کہتے تو تین مرتبہ اسے دہراتے تھے اور جب کسی قوم کے پاس جاتے تو تین مرتبہ اجازت لیتے تھے ۔"
"13342","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے اپنے صحابہ رضی اللہ عنہم میں سے کسی شخص سے پوچھا کہ کیا تم نے شادی کر لی ہے آ انہوں نے عرض کیا نہیں ، میرے پاس کچھ ہے ہی نہیں کہ جس کی وجہ سے میں شادی کر سکوں ، نبی ﷽ نے ان سے پوچھا کیا تمہارے پاس """" ®قل ھو اللہ احد¾ """" نہیں ہے آ انہوں نے عرض کیا کیوں نہیں ، فرمایا یہ چوتھائی قرآن ہے ، پھر نبی ﷽ نے ان سے پوچھا کیا تمہارے پاس سورہ کافرون نہیں ہے آ انہوں نے عرض کیا کیوں نہیں ، فرمایا یہ چوتھائی قرآن ہے ، پھر نبی ﷽ نے ان سے پوچھا کیا تمہارے پاس سورہ زلزال نہیں ہے آ انہوں نے عرض کیا کیوں نہیں ، فرمایا یہ چوتھائی قرآن ہے ، پھر نبی ﷽ نے ان سے پوچھا کیا تمہارے پاس سورہ نصر نہیں ہے آ انہوں نے عرض کیا کیوں نہیں ، فرمایا یہ چوتھائی قرآن ہے ، پھر نبی ﷽ نے ان سے پوچھا کیا تمہارے پاس آیت الکرسی نہیں ہے آ انہوں نے عرض کیا کیوں نہیں ، فرمایا یہ چوتھائی قرآن ہے ، نبی ﷽ نے تین مرتبہ فرمایا پھر شادی کر لو ۔"
"13343","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ حضرت ام سلیم رضی اللہ عنہا کے گھر تشریف لا کر ان کے بستر پر سو جاتے تھے اور وہ وہاں نہ ہوتی تھیں ، ایک دن نبی ﷽ حسب معمول آئے اور ان کے بستر پر سو گئے ، کسی نے انہیں جا کر بتایا کہ نبی ﷽ تمہارے گھر میں تمہارے بستر پر سو رہے ہیں ، چنانچہ وہ گھر آئیں تو دیکھا کہ نبی ﷽ پسینے میں بھیگے ہوئے ہیں اور وہ پسینہ بستر پر بچھے ہوئے چمڑے کے ایک ٹکڑے پر گر رہا ہے ، انہوں نے اپنا دوپٹہ کھولا اور اس پسینے کو اس میں جذب کر کے ایک شیشی میں نچوڑنے لگیں ، نبی ﷽ گھبرا کر اٹھ بیٹھے اور فرمایا ام سلیم ! یہ کیا کر رہی ہو آ انہوں نے عرض کیا یا رسول اللہ ﷽ ! ہم اس سے اپنے بچوں کے لئے برکت کی امید رکھتے ہیں ، نبی ﷽ نے فرمایا تم نے صحیح کیا ۔"
"13344","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جنت میں اونٹوں کی گردنوں کے برابر پرندے ہوں گے ، جو درختوں میں چرتے پھریں گے ، حضرت ابوبکر رضی اللہ عنہ نے عرض کیا کہ یا رسول اللہ ﷽ ! پھر تو وہ پرندے خوب صحت مند ہوں گے ، نبی ﷽ نے فرمایا انہیں کھانے والے ان سے بھی زیادہ صحت مند ہوں گے اور ابوبکر ! مجھے امید ہے کہ آپ بھی انہیں کھانے والوں میں سے ہوں گے ۔"
"13345","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب نبی ﷽ مدینہ منورہ میں داخل ہوئے تھے ، تو مدینہ کی ہر چیز روشن ہو گئی تھی اور جب دنیا سے رخصت ہوئے تو مدینہ کی ہر چیز تاریک ہو گئی اور ابھی ہم تدفین سے فارغ نہیں ہوئے تھے کہ ہم نے اپنے دلوں کی حالت کو تبدیل پایا ۔"
"13346","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جہنم سے چار آدمیوں کو نکالا جائے گا ، انہیں اللہ تعالیٰ کے سامنے پیش کیا جائے گا ، اللہ تعالیٰ دوبارہ انہیں جہنم میں بھیجنے کا حکم دے دے گا ، ان میں سے ایک شخص اللہ تعالیٰ کی طرف متوجہ ہو کر کہے گا کہ پروردگار ! مجھے تو یہ امید ہو گئی تھی کہ اگر تو مجھے جہنم سے نکال رہا ہے تو اس میں دوبارہ واپس نہ لوٹائے گا آ اللہ تعالیٰ فرمائے گا کہ پھر ہم تجھے اس میں واپس نہ لوٹائیں گے ۔"
"13347","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے اس بات سے منع کیا ہے کہ پھل پکنے سے پہلے ، کشمش + انگور , سیاہ ہونے سے پہلے اور گندم کا دانہ سخت ہونے سے پہلے بیچا جائے ۔"
"13348","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ذی یزن کے بادشاہ نے نبی ﷽ کی خدمت میں ایک جوڑا بھیجا جو اس نے 66 اونٹ یا اونٹنیوں کے عوض لیا تھا ۔"
"13349","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے بارگاہ رسالت میں عرض کیا یا رسول اللہ ﷽ ! ایک آدمی کسی شخص سے محبت کرتا ہے لیکن اس کے اعمال تک نہیں پہنچتا ، تو کیا حکم ہے آ نبی ﷽ نے فرمایا انسان اسی کے ساتھ ہو گا جس کے ساتھ وہ محبت کرتا ہے ، حضرت انس رضی اللہ عنہ فرماتے ہیں کہ اسلام کے بعد میں نے صحابہ رضی اللہ عنہم کو اس بات سے زیادہ کسی بات پر خوش ہوتے ہوئے نہیں دیکھا ، ہم نبی ﷽ سے محبت کرتے ہیں ، اگرچہ ان جیسے اعمال کی طاقت نہیں رکھتے ، جب ہم ان کے ساتھ ہوں گے تو یہی ہمارے لیے کافی ہے ۔"
"13350","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے کوئی عنبر اور مشک یا کوئی دوسری خوشبو نبی ﷽ کی مہک سے زیادہ عمدہ نہیں سونگھی ، اور میں نے کوئی ریشم و دیبا ، یا کوئی دوسری چیز نبی ﷽ سے زیادہ نرم نہیں چھوئی ، + ثابت کہتے ہیں کہ میں نے عرض کیا اے ابوحمزہ ! کیا آپ نے نبی ﷽ کو نہیں دیکھا یا ان کی آواز نہیں سنی آ انہوں نے کہا کیوں نہیں ، بخدا ! مجھے امید ہے کہ قیمت کے دن میں ان سے ملوں گا اور عرض کروں گا کہ یا رسول اللہ ﷽ ! + آپ کا چھوٹا سا خادم حاضر ہے , ، میں نے مدینہ منورہ میں نبی ﷽ کی دس سال خدمت کی ہے ، میں اس وقت لڑکا تھا ، یہ ممکن نہیں ہے کہ میرا ہر کام دوسرے کی خواہش کے مطابق ہی ہو ، لیکن نبی ﷽ نے مجھے کبھی بھی """" اف """" تک نہیں کہا ، اور نہ ہی کبھی یہ فرمایا کہ تم نے یہ کام کیوں کیا آ یا یہ کام کیوں نہیں کیا آ"
"13351","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں بچوں کے ساتھ دوڑ رہا تھا ، جب بچے یہ کہتے کہ محمد ﷽ آ گئے تو میں اتنا تیز دوڑتا کہ کچھ نہ دیکھتا ، دوبارہ بچے یہی جملے کہتے تو میں پھر اتنا تیز دوڑنے لگتا کہ کچھ نہ دیکھتا تھا ، حتیٰ کہ نبی ﷽ اور آپ کے رفیق محترم حضرت ابوبکر صدیق رضی اللہ عنہ تشریف لے آئے ، ہم اس وقت مدینہ کے کسی علاقے میں تھے ، ہم نے ایک دیہاتی آدمی کو انصار کے پاس یہ خبر دے کر بھیجا ، اور پانچ سو کے قریب انصاری صحابہ رضی اللہ عنہم نبی ﷽ کا استقبال کرنے کے لئے نکل پڑے ، وہ لوگ جب نبی ﷽ اور حضرت ابوبکر صدیق رضی اللہ عنہ کے پاس پہنچے تو کہنے لگے کہ آپ دونوں حضرات امن و امان کے ساتھ مطاع بن کر داخل ہو جائیے ، نبی ﷽ اور حضرت ابوبکر صدیق رضی اللہ عنہ ان کے آگے آگے چلتے رہے اور سارے اہل مدینہ نکل آئے حتیٰ کہ خواتین بھی اپنے گھروں کی چھتوں پر چڑھ کر نبی ﷽ کو دیکھنے اور آپس میں پوچھنے لگیں کہ نبی ﷽ کون سے ہیں آ ہم نے اس دن جیسا منظر کبھی نہیں دیکھا ، میں نے یہ دن بھی دیکھا کہ جب نبی ﷽ مدینہ منورہ میں داخل ہوئے اور وہ دن بھی دیکھا جب آپ ﷽ دنیا سے رخصت ہوئے ، ان دونوں دنوں جیسا منظر میں نے کبھی نہیں دیکھا ۔"
"13352","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا میں اور قیامت ان دو انگلیوں کی طرح اکٹھے بھیجے گئے ہیں ، یہ کہہ کر نبی ﷽ نے شہادت والی انگلی اور درمیانی انگلی کی طرف اشارہ فرمایا ۔"
"13353","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ صحابہ کرام رضی اللہ عنہم نے نبی ﷽ سے یہ مسئلہ پوچھا کہ اہل کتاب ہمیں سلام کرتے ہیں ، ہم انہیں کیا جواب دیں آ نبی ﷽ نے فرمایا صرف """" وعلیکم """" کہہ دیا کرو ۔"
"13354","شعبہ رحمۃ اللہ کہتے ہیں کہ میں نے معاویہ بن قرہ رحمۃ اللہ سے پوچھا کہ کیا آپ نے حضرت انس رضی اللہ عنہ کو یہ فرماتے ہوئے سنا ہے کہ نبی ﷽ نے حضرت نعمان بن مقرن رضی اللہ عنہ کے متعلق فرمایا تھا کہ قوم کا بھانجا ان ہی میں شمار ہوتا ہے آ انہوں نے جواب دیا ہاں !"
"13355","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے انصار سے فرمایا کیا تم میں تمہارے علاوہ بھی کوئی ہے آ انہوں نے کہا کہ ہمارا ایک بھانجا ہے ، نبی ﷽ نے فرمایا قوم کا بھانجا ان ہی میں شمار ہوتا ہے ۔"
"13356","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دو چتکبرے سینگ دار مینڈھے قربانی میں پیش کیا کرتے تھے ، اور اللہ کا نام لے کر تکبیر کہتے تھے ، میں نے دیکھا ہے کہ نبی ﷽ انہیں اپنے ہاتھ سے ذبح کرتے تھے اور ان کے پہلو پر اپنا پااں رکھتے تھے ۔"
"13357","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم بنو نجار میں سے ایک آدمی نبی ﷽ کا کاتب تھا ، اس نے سورہ بقرہ اور آل عمران بھی پڑھ رکھی تھی ، کچھ عرصے بعد وہ آدمی مرتد ہو کر مشرکین سے جا کر مل گیا ، مشرکین نے اسے بڑا اچھالا اور کہنے لگے کہ محمد ﷽ کو یہی لکھ لکھ کر دیا کرتا تھا ، کچھ ہی عرصے بعد اللہ نے اس کی گردن توڑ دی اور وہ مر گیا ، لوگوں نے اس کے لئے قبر کھودی اور اسے قبر میں اتار دیا لیکن اگلا دن ہوا تو دیکھا کہ زمین نے اسے باہر نکال پھینکا ہے ، انہوں نے کئی مرتبہ اسے دفن کیا ، ہر مرتبہ زمین نے اسے نکال باہر پھینکا حتیٰ کہ لوگوں نے اسے یہیں پڑا چھوڑ دیا ۔"
"13358","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوطلحہ رضی اللہ عنہ کا ایک بیٹا """" جس کا نام ابوعمیر تھا """" اس کے پاس ایک چڑیا تھی جس سے وہ کھیلتا تھا ، ایک دن نبی ﷽ نے فرمایا اے ابوعمیر ! کیا کیا نغیر آ + چڑیا ، جو مر گئی تھی ,"
"13359","حضرت انس رضی اللہ عنہ سے مروی ہے کہ بعض اوقات نبی ﷽ سجدہ یا رکوع سے سر اٹھاتے اور ان دونوں کے درمیان اتنا لمبا وقفہ فرماتے کہ ہمیں یہ خیال ہونے لگتا کہ کہیں نبی ﷽ بھول تو نہیں گئے ۔"
"13360","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب نبی ﷽ نے رومیوں کو خط لکھنے کا ارادہ کیا تو صحابہ کرام رضی اللہ عنہم نے عرض کیا کہ وہ لوگ صرف مہر شدہ خطوط ہی پڑھتے ہیں ، چنانچہ نبی ﷽ نے چاندی کی انگوٹھی بنوا لی ، اس کی سفیدی اب تک میری نگاہوں کے سامنے ہے ، اس پر یہ عبارت نقش تھی ، """" محمد رسول اللہ """" ﷽ ۔"
"13361","[Darussalam 13328] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13362","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی مبارک ڈاڑھی میں اتنے بال سفید نہ تھے جنہیں خضاب لگانے کی ضرورت پڑتی ، البتہ حضرت ابوبکر صدیق رضی اللہ عنہ اپنے سر اور ڈاڑھی پر مہندی اور وسمہ کا خضاب لگاتے تھے ۔"
"13363","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک دن انہوں نے نبی ﷽ کے ہاتھ میں چاندی کی ایک انگوٹھی دیکھی ، نبی ﷽ کو دیکھ کر لوگوں نے بھی چاندی کی انگوٹھیاں بنوا لیں ، اس پر نبی ﷽ نے اپنی انگوٹھی اتار کر پھینک دی ، اور لوگوں نے بھی اپنی اپنی انگوٹھیاں اتار پھینکیں ۔"
"13364","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ عصر کی نماز اس وقت پڑھتے تھے کہ نماز کے بعد کوئی جانے والا عوالی جانا چاہتا تو وہ جا کر واپس آ جاتا ، پھر بھی سورج بلند ہوتا تھا ۔"
"13365","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص میری طرف جان بوجھ کر کسی جھوٹی بات کی نسبت کرے ، اسے اپنا ٹھکانہ جہنم میں بنا لینا چاہئے ۔"
"13366","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ایک آدمی ایک طویل عرصے تک ایسے گناہوں میں مبتلا رہتا ہے کہ اگر اسی حال میں مر جائے تو جہنم میں داخل ہو ، لیکن پھر اس میں تبدیلی پیدا ہو جاتی ہے اور وہ نیک اعمال میں مصروف ہو جاتا ہے ، اسی طرح بعض اوقات ایک شخص ساری زندگی یا ایک طویل عرصہ اپنے نیک اعمال پر گذار دیتا ہے کہ اگر اسی حال میں فوت ہو جائے تو جنت میں داخل ہو جائے لیکن پھر اس میں تبدیلی پیدا ہوتی ہے اور وہ گناہوں میں مبتلا ہو جاتا ہے اور اسی پر اس کا خاتمہ ہو جاتا ہے ۔"
"13367","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا تمہارے پاس ایسی قومیں آئیں گی جن کے دل تم سے بھی زیادہ نرم ہوں گے ، چنانچہ ایک مرتبہ اشعریین آئے ، ان میں حضرت ابوموسیٰ اشعری رضی اللہ عنہ بھی شامل تھے ، جب وہ مدینہ منورہ کے قریب پہنچے تو یہ رجزیہ شعر پڑھنے لگے کہ کل ہم اپنے دوستوں یعنی محمد + ﷽ , اور ان کے ساتھیوں سے ملاقات کریں گے اور یہی وہ پہلے لوگ تھے جنہوں نے مصافحہ کا رواج ڈالا ۔"
"13368","حضرت حفصہ رضی اللہ عنہا کہتی ہیں کہ حضرت انس رضی اللہ عنہ نے مجھ سے پوچھا کہ ابن ابی عمرہ کیسے فوت ہوئے آ میں نے بتایا کہ طاعون کی بیماری سے ، انہوں نے فرمایا کہ نبی ﷽ نے ارشاد فرمایا طاعون ہر مسلمان کے لئے شہادت ہے ۔"
"13369","ایک مرتبہ حضرت انس رضی اللہ عنہ ولید بن عبدالملک کے پاس تشریف لے گئے ، اس نے ان سے پوچھا کہ آپ نے قیامت کے متعلق نبی ﷽ کو کیا فرماتے ہوئے سنا ہے آ انہوں نے جواب دیا کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ تم اور قیامت ان دو انگلیوں کی طرح ہو ۔"
"13370","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ اور خلفاء ثلاثہ رضی اللہ عنہم کے پیچھے نماز پڑھی ہے ، وہ نماز میں قراءت کا آغاز ®الحمدللہ رب العلمین¾ سے کرتے تھے اور وہ قراءت کے آغاز یا اختتام پر بسم اللہ کا ذکر نہیں کرتے تھے ۔"
"13371","حضرت انس رضی اللہ عنہ اور ابوسعید خدری رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا عنقریب میری امت میں اختلاف اور تفرقہ بازی ہو گی ، اور ان میں سے ایک قوم ایسی نکلے گی جو بات اچھی اور عمل برا کرے گی ، وہ قرآن پڑھتی ہو گی لیکن وہ اس کے حلق سے نیچے نہیں اترے گا ، تم ان کی نمازوں کے آگے اپنی نمازوں کو اور ان کے روزوں کے آگے اپنے روزوں کو حقیر سمجھو گے ، وہ لوگ دین سے اسی طرح نکل جائیں گے جیسے تیر شکار سے نکل جاتا ہے ، جس طرح تیر اپنی کمان میں کبھی واپس نہیں آ سکتا یہ لوگ بھی دین میں کبھی واپس نہ آئیں گے ، یہ لوگ بدترین مخلوق ہوں گے ، اس شخص کے لئے خوشخبری ہے جو انہیں قتل کرے اور وہ اسے قتل کریں ، وہ کتاب اللہ کی دعوت دیتے ہوں گے لیکن ان کا اس سے کوئی تعلق نہیں ہو گا ، جو ان سے قتال کرے گا وہ اللہ کے اتنا ہی قریب ہو گا ، صحابہ رضی اللہ عنہم نے پوچھا یا رسول اللہ ! ان کی علامت کیا ہو گی آ نبی ﷽ نے فرمایا ان کی علامت سر منڈوانا ہو گا ۔"
"13372","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ مسجد میں داخل ہوئے ، آپ ﷽ نے موٹے کنارے والی ایک نجرانی چادر اوڑھ رکھی تھی ، پیچھے سے ایک دیہاتی آیا اور اس نے نبی ﷽ کی چادر کو ایسے گھسیٹا کہ اس کے نشانات نبی ﷽ کی گردن مبارک پر پڑ گئے اور کہنے لگا کہ اے محمد ! ﷽ ، اللہ کا جو مال آپ کے پاس ہے اس میں سے مجھے بھی دیجئے نبی ﷽ نے اس کی طرف دیکھا اور صرف مسکرا دیئے ، پھر اسے کچھ دینے کا حکم دیا ۔"
"13373","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جب مجھے پروردگار عالم نے معراج پر بلایا تو میرا گذر ایک ایسی قوم پر ہوا جن کے ناخن تانبے کے تھے اور وہ ان سے اپنے چہرے اور سینے نوچ رہے تھے ، میں نے پوچھا جبریل ! یہ کون لوگ ہیں آ انہوں نے بتایا کہ یہ لوگوں کا گوشت کھانے والے + غیبت کرنے والے , اور لوگوں کی عزت پر انگلیاں اٹھانے والے لوگ ہیں ۔"
"13374","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا جنگ تو چال کا نام ہے ۔"
"13375","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا جنگ تو چال کا نام ہے ۔"
"13376","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے حضرت جبریل علیہ السلام سے پوچھا کہ کیا بات ہے ، میں نے میکائیل کو کبھی ہنستے ہوئے نہیں دیکھا آ انہوں نے جواب دیا کہ جب سے جہنم کو پیدا کیا گیا ہے ، میکائیل کبھی نہیں ہنسے ۔"
"13377","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا دجال اصفہان کے شہر """" یہودیہ """" سے خروج کرے گا ، اس کے ساتھ ستر ہزار یہودی ہوں گے ، جن پر سبز چادریں ہوں گی ۔"
"13378","حضرت انس رضی اللہ عنہ سے مروی ہے کہ فتح مکہ کے دن نبی ﷽ جب مکہ مکرمہ میں داخل ہوئے تو آپ ﷽ نے خود پہن رکھا تھا ۔"
"13379","عروہ بن رویم کہتے ہیں کہ ایک مرتبہ حضرت انس رضی اللہ عنہ ، حضرت امیر معاویہ رضی اللہ عنہ کے پاس تشریف لائے جب کہ وہ دمشق میں تھے ، جب وہاں پہنچے تو حضرت امیر معاویہ رضی اللہ عنہ نے ان سے فرمائش کی کہ کوئی ایسی حدیث سنائیے جو آپ نے نبی ﷽ سے خود سنی ہو اور اس میں آپ کے اور نبی ﷽ کے درمیان کوئی واسطہ نہ ہو ، انہوں نے جواب دیا کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ ایمان یمنی ہے ، اسی طرح لخم اور جذام تک ۔"
"13380","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے انصار سے فرمایا عنقریب تم میرے بعد بہت زیادہ ترجیحات دیکھو گے لیکن تم صبر کرنا یہاں تک کہ اللہ اور اس کے رسول سے آ ملو ، کیونکہ میں اپنے حوض پر تمہارا انتظار کروں گا ، انہوں نے عرض کیا کہ انشاءاللہ ہم صبر کریں گے ۔"
"13381","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا مجھے اس بات کا حکم دیا گیا ہے کہ لوگوں سے اس وقت تک قتال کرتا رہوں جب تک وہ اس بات کی گواہی نہ دینے لگیں کہ اللہ کے علاوہ کوئی معبود نہیں اور محمد ﷽ اللہ کے رسول ہیں ، جب وہ اس بات کی گواہی دینے لگیں ، ہمارے قبلے کا رخ کرنے لگیں ، ہمارا ذبیحہ کھانے لگیں اور ہماری طرح نماز پڑھنے لگیں تو ہم پر ان کی جان و مال کا احترام واجب ہو گیا ، سوائے اس کلمے کے حق کے ، ان کے حقوق بھی عام مسلمانوں کی طرح ہوں گے اور ان کے فرائض بھی دیگر مسلمانوں کی طرح ہوں گے ۔"
"13382","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جس وقت حجۃ الوداع کے موقع پر نبی ﷽ نے حج و عمرے کا تلبیہ اکٹھا پڑھا ، میں نبی ﷽ کی اونٹنی کے گھٹنے کے قریب تھا ۔"
"13383","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ تعالیٰ اس شخص کو """" جو میری باتیں سنے اور اٹھا کر آگے پھیلا دے """" تروتازہ رکھے ، کیونکہ بہت سے فقہ اٹھانے والے لوگ فقیہہ نہیں ہوتے ، اور بہت سے حامل فقہ لوگوں سے دوسرے لوگ زیادہ بڑے فقیہہ ہوتے ہیں ، تین چیزیں ایسی ہیں کہ مسلمان کے دل میں ان کے متعلق خیانت نہیں ہونی چاہئے ، ایک تو یہ کہ عمل خالص اللہ کی رضا کے لئے کیا جائے ، دوسرا یہ کہ حکمرانوں کے ساتھ خیر خواہی کی جائے ، اور تیسرا یہ کہ مسلمانوں کی اکثریت کے تابع رہے کیونکہ ان کی دعا سب کو شامل ہوتی ہے ۔"
"13384","زید بن اسلم رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ ہم نے ظہر کی نماز حضرت عمر بن عبدالعزیز رحمۃ اللہ کے ساتھ پڑھی ، نماز کے بعد ہم لوگ حضرت انس رضی اللہ عنہ کو پوچھنے کے لئے """" کہ وہ بیمار ہو گئے تھے """" نکلے ، ان کے گھر پہنچ کر ہم نے انہیں سلام کیا ، انہوں نے پوچھا کہ کیا تم نے نماز پڑھ لی آ ہم نے اثبات میں جواب دیا ، انہوں نے اپنی باندی سے وضو کے لئے پانی منگوایا اور فرمایا کہ میں نے نبی ﷽ کے بعد ان سے سب سے زیادہ مشابہت رکھنے والی نماز تمہارے اس امام سے زیادہ کسی کی نہیں دیکھی ، دراصل حضرت عمر بن عبدالعزیز رحمۃ اللہ رکوع و سجدہ مکمل کرتے تھے لیکن جلسہ اور قیام مختصر کرتے تھے ۔"
"13385","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک دن انہوں نے نبی ﷽ کے ہاتھ میں چاندی کی ایک انگوٹھی دیکھی ، نبی ﷽ کو دیکھ کر لوگوں نے بھی چاندی کی انگوٹھیاں بنوا لیں ، اس پر نبی ﷽ نے اپنی انگوٹھی اتار کر پھینک دی ، اور لوگوں نے بھی اپنی اپنی انگوٹھیاں اتار پھینکیں ۔"
"13386","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے فرمایا میرے حوض کے برتن آسمان کے ستاروں کی تعداد کے برابر ہوں گے ۔"
"13387","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا آپس میں قطع تعلقی ، بغض ، پشت پھیرنا اور حسد نہ کیا کرو اور اللہ کے بندو ! بھائی بھائی بن کر رہا کرو ، اور کسی مسلمان کے لئے اپنے بھائی سے تین دن سے زیادہ قطع کلامی کرنا حلال نہیں ہے کہ دونوں آمنے سامنے ہوں تو ایک اپنا چہرہ ادھر پھیر لے اور دوسرا ادھر ، اور ان دونوں میں سے بہترین وہ ہے جو سلام میں پہل کرے ۔"
"13388","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کبھی کبھار اپنی تمام ازواج مطہرات کے پاس ایک ہی رات میں ایک ہی غسل سے چلے جایا کرتے تھے ۔"
"13389","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا شہر عسقلان عروس البلاد میں سے ایک ہے ، اس شہر سے قیامت کے دن ستر ہزار ایسے آدمی اٹھیں گے جن کا کوئی حساب کتاب نہ ہو گا ، اور پچاس ہزار شہداء اٹھائے جائیں گے جو اللہ کے مہمان ہوں گے ، یہاں شہداء کی صفیں ہوں گی جن کے کٹے ہوئے سر ان کے ہاتھوں میں ہوں گے اور ان کی رگوں سے تازہ خون بہہ رہا ہو گا ، اور وہ کہتے ہوں گے کہ پروردگار ! تو نے ہم سے اپنے رسولوں کی زبانی جو وعدہ فرمایا تھا اسے پورا فرما ، بیشک تو وعدے کی خلاف ورزی نہیں کرتا ، اللہ تعالیٰ فرمائے گا کہ میرے بندوں نے سچ کہا ، انہیں نہر بیضہ میں غسل دلاا ، چنانچہ وہ اس نہر سے صاف ستھرے اور گورے ہو کر نکلیں گے اور جنت میں جہاں چاہیں گے ، سیر و تفریح کرتے پھریں گے ۔ فائدہ = ۔ محدثین نے اس حدیث کو """" موضوع """" قرار دیا ہے ۔"
"13390","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اذان اور اقامت کے درمیانی وقت میں کی جانے والی دعاء رد نہیں ہوتی ، لہٰذا اس وقت دعاء کیا کرو ۔"
"13391","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے پاس چاندی کی ایک انگوٹھی تھی جس کا نگینہ حبشی تھا ۔"
"13392","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک آدمی نے نبی ﷽ کی دعوت کی تھی ، میں بھی وہاں چلا گیا ، شوربہ آیا تو اس میں کدو تھا ، نبی ﷽ کو کدو بہت پسند تھا ، اس لئے میں اسے الگ کر کے نبی ﷽ کے سامنے کرتا رہا ، البتہ خود نہیں کھایا اور میں اس وقت سے کدو کو پسند کرنے لگا ۔"
"13393","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا باغات جنت میں عادی شراب خور ، والدین کا نافرمان اور احسان کر کے جتانے والا کوئی شخص داخل نہ ہو گا ۔"
"13394","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت زینب بنت جحش رضی اللہ عنہا دیگر ازواج مطہرات پر فخر کرتے ہوئے فرماتی تھیں کہ اللہ نے آسمان پر میرا نکاح نبی ﷽ سے کیا ہے ، نبی ﷽ نے ان کے ولیمے میں روٹی اور گوشت کھلایا تھا ، کچھ لوگ کھانا کھانے کے بعد نبی ﷽ کے گھر ہی میں بیٹھے رہے تھے ، نبی ﷽ اٹھ کر چلے گئے ، کچھ دیر انتظار کرنے کے بعد واپس آئے تو لوگ پھر بھی بیٹھے ہوئے تھے ، یہ چیز نبی ﷽ کو بڑی ناگوار گذری اور چہرہ مبارک پر اس کے آثار ظاہر ہو گئے اور اس موقع پر آیت حجاب نازل ہو گئی ۔"
"13395","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نبی ﷽ کے یہاں ان کے گھر میں تھا ، کہ ایک آدمی نے یہ سوال پوچھا یا رسول اللہ ﷽ ! قیامت کب قائم ہو گی آ نبی ﷽ نے فرمایا تم نے قیامت کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کہ میں نے کوئی بہت زیادہ اعمال تو مہیا نہیں کر رکھے ، البتہ اتنی بات ضرور ہے کہ میں اللہ اور اس کے رسول سے محبت کرتا ہوں ، نبی ﷽ نے فرمایا کہ تم اسی کے ساتھ ہو گے جس سے تم محبت کرتے ہو اور تمہیں وہی ملے گا جو تم نے کمایا ۔"
"13396","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب جمعہ کا خطبہ ارشاد فرماتے تھے تو لکڑی کے ایک ستون کے ساتھ اپنی پشت مبارک کو سہارا دیتے تھے ، لوگوں کی تعداد جب بڑھ گئی تو نبی ﷽ نے فرمایا کہ میرے لیے منبر بناا ، مقصد یہ تھا کہ سب تک آواز پہنچ جائے ، چنانچہ صحابہ رضی اللہ عنہم نے دو سیڑھیوں کا منبر بنا دیا ، نبی ﷽ اس ستون سے منبر پر منتقل ہو گئے ، حضرت انس رضی اللہ عنہ فرماتے ہیں کہ انہوں نے خود اپنے کانوں سے اس تنے کے رونے کی ایسی آواز سنی جیسے گمشدہ بچہ بلک بلک کر روتا ہے ، اور وہ مسلسل روتا ہی رہا ، یہاں تک کہ نبی ﷽ منبر سے نیچے اترے اور اس کی طرف چل کر گئے ، اسے سینے سے لگایا تب جا کر وہ خاموش ہوا ۔"
"13397","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی خدمت میں جب خوشبو پیش کی جاتی تو آپ ﷽ اسے کبھی رد نہ فرماتے تھے ۔"
"13398","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کثرت سے یہ دعا فرماتے تھے کہ اے اللہ ! میں پریشانی ، غم ، لاچاری ، سستی ، بخل ، بزدلی ، قرضوں کے بوجھ اور لوگوں کے غلبے سے آپ کی پناہ میں آتا ہوں ۔"
"13399","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ حضرت ام سلیم رضی اللہ عنہا کے گھر تشریف لا کر ان کے بستر پر سو جاتے تھے ، اور وہ وہاں نہ ہوتی تھیں ، ایک دن نبی ﷽ حسب معمول آئے اور ان کے بستر پر سو گئے ، کسی نے انہیں جا کر بتایا کہ نبی ﷽ تمہارے گھر میں تمہارے بستر پر سو رہے ہیں ، چنانچہ وہ گھر آئیں تو دیکھا کہ نبی ﷽ پسینے میں بھیگے ہوئے ہیں اور وہ پسینہ بستر پر بچھے ہوئے چمڑے کے ایک ٹکڑے پر گر رہا ہے ، انہوں نے اپنا دوپٹہ کھولا اور اس پسینے کو اس میں جذب کر کے ایک شیشی میں نچوڑنے لگیں ، نبی ﷽ گھبرا کر اٹھ بیٹھے اور فرمایا ام سلیم ! یہ کیا کر رہی ہو آ انہوں نے عرض کیا یا رسول اللہ ﷽ ! ہم اس سے اپنے بچوں کے لئے برکت کی امید رکھتے ہیں ، نبی ﷽ نے فرمایا تم نے صحیح کیا ۔"
"13400","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت ام سلیم رضی اللہ عنہا کے گھر میں ایک پرانی چٹائی پر """" جس کا رنگ بھی پرانا ہونے کی وجہ سے بدل چکا تھا """" ہمیں نماز پڑھائی ، میں نے اس پر پانی کا چھڑکاا کر دیا تھا پھر نبی ﷽ نے اس پر سجدہ کیا ۔"
"13401","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک دیہاتی آیا اور مسجد میں پیشاب کرنے لگا ، صحابہ کرام رضی اللہ عنہم نے اسے خبردار کرنے کے لئے روکا ، نبی ﷽ نے فرمایا اسے مت روکو ، اسے چھوڑ دو ، پھر اس کے فارغ ہونے کے بعد پانی منگوا کر اس پیشاب پر بہا دیا ۔"
"13402","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جس طرح نبی ﷽ ہمیں نماز پڑھاتے تھے میں تمہیں اس طرح نماز پڑھانے میں کوئی کوتاہی نہیں کرتا ، راوی کہتے ہیں کہ حضرت انس رضی اللہ عنہ جس طرح کرتے تھے میں تمہیں اس طرح کرتے ہوئے نہیں دیکھتا ، بعض اوقات نبی ﷽ سجدہ یا رکوع سے سر اٹھاتے اور ان دونوں کے درمیان اتنا لمبا وقفہ فرماتے کہ ہمیں یہ خیال ہونے لگتا کہ کہیں نبی ﷽ بھول تو نہیں گئے ۔"
"13403","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کی ملاقات حضرت عبدالرحمن بن عوف رضی اللہ عنہ سے ہوئی ، تو ان کے اوپر """" خلوق """" نامی خوشبو کے اثرات دکھائی دیئے ، نبی ﷽ نے فرمایا عبدالرحمن ! یہ کیا ہے آ انہوں نے عرض کیا کہ میں نے ایک انصاری خاتون سے کھجور کی گٹھلی کے برابر سونے کے عوض شادی کر لی ہے ، نبی ﷽ نے فرمایا اللہ مبارک کرے ، پھر ولیمہ کرو ، اگرچہ ایک بکری سے ہی ہو ۔"
"13404","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے بارگاہ رسالت میں عرض کیا یا رسول اللہ ﷽ ! قیامت کب آئے گی آ نبی ﷽ نے پوچھا تم نے اس کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کچھ بھی نہیں ، سوائے اس کے کہ میں اللہ اور اس کے رسول + ﷽ , سے محبت کرتا ہوں ، نبی ﷽ نے فرمایا تم اسی کے ساتھ ہو گے جس سے تم محبت کرتے ہو ، حضرت انس رضی اللہ عنہ فرماتے ہیں کہ اسلام کے بعد میں نے صحابہ رضی اللہ عنہم کو اس بات سے زیادہ کسی بات پر خوش ہوتے ہوئے نہیں دیکھا ، ہم نبی ﷽ اور حضرات ابوبکر و عمر رضی اللہ عنہا سے محبت کرتے ہیں ، اگرچہ ان جیسے اعمال کی طاقت نہیں رکھتے ، جب ہم ان کے ساتھ ہوں گے تو یہی ہمارے لیے کافی ہے ۔"
"13405","حمید کہتے ہیں کسی شخص نے حضرت انس رضی اللہ عنہ سے پوچھا کہ کیا نبی ﷽ خضاب لگاتے تھے آ انہوں نے فرمایا کہ نبی ﷽ پر بڑھاپے کا عیب نہیں آیا ، اگر میں نبی ﷽ کی ڈاڑھی میں سفید بالوں کو گننا چاہوں تو گن سکتا ہوں ، البتہ حضرت ابوبکر صدیق رضی اللہ عنہ مہندی اور وسمہ کا خضاب لگاتے تھے ، جب کہ حضرت عمر رضی اللہ عنہ صرف مہندی کا خضاب لگاتے تھے ۔"
"13406","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے دس سال سفر و حضر میں نبی ﷽ کی خدمت کا شرف حاصل کیا ہے ، نبی ﷽ نے مجھے کبھی اف تک نہیں کہا ، نبی ﷽ نے مجھ سے کبھی یہ نہیں فرمایا کہ تم نے یہ کام کیوں کیا آ یا یہ کام تم نے کیوں نہیں کیا آ"
"13407","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے کوئی عنبر اور مشک یا کوئی دوسری خوشبو نبی ﷽ کی مہک سے زیادہ عمدہ نہیں سونگھی ، اور میں نے کوئی ریشم و دیبا ، یا کوئی دوسری چیز نبی ﷽ کی ہتھیلی سے زیادہ نرم نہیں چھوئی ۔"
"13408","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک یہودی لڑکا نبی ﷽ کی خدمت کرتا تھا ، ایک مرتبہ وہ بیمار ہو گیا ، نبی ﷽ اس کے پاس تشریف لے گئے ، وہ مرنے کے قریب تھا ، وہاں اس کا باپ اس کے سرہانے بیٹھا ہوا تھا ، نبی ﷽ نے اسے کلمہ پڑھنے کی تلقین کی ، اس نے اپنے باپ کو دیکھا ، اس نے کہا کہ ابوالقاسم ﷽ کی بات مانو ، چنانچہ اس لڑکے نے کلمہ پڑھ لیا ، اور اسی وقت مر گیا ، نبی ﷽ جب وہاں سے نکلے تو آپ ﷽ یہ فرما رہے تھے کہ اس اللہ کا شکر ہے جس نے اسے میری وجہ سے جہنم سے بچا لیا ۔"
"13409","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جس دن شراب حرام ہوئی ، میں حضرت ابوطلحہ رضی اللہ عنہ کے یہاں ان کے کچھ دوستوں کو پلا رہا تھا ، ایک مسلمان آیا اور کہنے لگا کہ کیا آپ لوگوں کو خبر نہیں ہوئی کہ شراب حرام ہو گئی ، انہوں نے یہ سن کر مجھ سے کہا کہ باہر نکل کر دیکھو ، میں نے باہر نکل کر دیکھا تو ایک منادی کی یہ آواز سنائی دی کہ لوگو ! شراب حرام ہو گئی ، میں نے حضرت ابوطلحہ رضی اللہ عنہ کو بتا دیا ، وہ کہنے لگے کہ جا کر تمہارے برتن میں جتنی شراب ہے سب انڈیل دو ، چنانچہ میں نے جا کر اسے بہا دیا ، اس موقع پر بعض لوگ کہنے لگے کہ سہیل بن بیضاء مارے گئے کیونکہ ان کے پیٹ میں شراب تھی ، اس پر اللہ نے یہ آیت نازل فرمائی """" ایمان لانے والوں اور نیک اعمال کرنے والوں پر اس چیز میں کوئی گناہ نہیں جو وہ پہلے کھا پی چکے ۔۔۔۔۔۔ """" اس موقع پر صرف کچی اور پکی کجھور ملا کر بنائی گئی نبیذ تھی ، یہی اس وقت شراب تھی ۔"
"13410","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی """" جس کا نام انجشہ تھا """" امہات المومنین کی سواریوں کو ہانک رہا تھا ، نبی ﷽ اپنی ازواج مطہرات کے پاس آئے تو فرمایا انجشہ ! ان آبگینوں کو آہستہ لے کر چلو ۔"
"13411","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو اپنی کسی زوجہ محترمہ کا ایسا ولیمہ کرتے ہوئے نہیں دیکھا جیسا حضرت زینب بن جحش رضی اللہ عنہا سے نکاح کے موقع پر کیا تھا کہ اس میں نبی ﷽ نے ولیمے کے لئے بکری ذبح کروائی تھی ۔"
"13412","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب آیت حجاب نازل ہو گئی تب بھی میں حسب سابق ایک مرتبہ نبی ﷽ کے گھر میں داخل ہونے لگا ، تو نبی ﷽ نے فرمایا بیٹا ! پیچھے رہو + اجازت لے کر اندر آا ,"
"13413","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نبی ﷽ کے یہاں سے اپنے گھر جانے کے لیے نکلا ، میرا گذر کچھ بچوں پر ہوا جو کھیل رہے تھے ، مجھے ان کا کھیل اچھا لگا سو میں وہاں کھڑا ہو گیا ، میں ابھی ان کا کھیل دیکھ ہی رہا تھا کہ نبی ﷽ آ گئے اور بچوں کو سلام کیا ، اور مجھے اپنے کسی کام سے بھیج دیا اور خود ایک دیوار کے سائے میں بیٹھ گئے ، یہاں تک کہ میں واپس آ گیا ، جب میں گھر واپس پہنچا تو میری والدہ کہنے لگیں کہ اتنی دیر کیوں لگا دی آ میں نے بتایا کہ نبی ﷽ نے اپنے کسی کام سے بھیجا تھا ، انہوں نے پوچھا کیا کام تھا آ میں نے کہا کہ یہ ایک راز ہے ، انہوں نے کہا کہ پھر نبی ﷽ کے راز کی حفاظت کرنا ، ثابت ! اگر وہ راہ میں کسی سے بیان کرتا تو تم سے بیان کرتا ۔"
"13414","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کا رنگ کھلتا ہوا تھا ، پسینہ موتیوں کی طرح تھا ، جب وہ چلتے تو پوری قوت سے چلتے تھے ، میں نے کوئی عنبر اور مشک یا کوئی دوسری خوشبو نبی ﷽ کی مہک سے زیادہ عمدہ نہیں سونگھی ، اور میں نے کوئی ریشم و دیبا ، یا کوئی دوسری چیز نبی ﷽ سے زیادہ نرم نہیں چھوئی ۔"
"13415","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نبی ﷽ نماز سے فارغ ہو کر منبر پر رونق افروز ہوئے اور نماز رکوع کے متعلق فرمایا میں تمہیں اپنے آگے سے جس طرح دیکھتا ہوں پیچھے سے بھی اسی طرح دیکھتا ہوں ۔"
"13416","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم لوگ نبی ﷽ کی ایک صاحبزادی کے جنازے میں شریک تھے ، نبی ﷽ قبر پر بیٹھے ہوئے تھے ، میں نے نبی ﷽ کی آنکھوں کو جھلملاتے ہوئے دیکھا ، نبی ﷽ نے فرمایا کیا تم میں سے کوئی آدمی ایسا بھی ہے جو رات کو اپنی بیوی کے قریب نہ گیا ہو آ حضرت ابوطلحہ رضی اللہ عنہ نے عرض کیا جی ہاں ! میں ہوں ، نبی ﷽ نے فرمایا قبر میں تم اترو ، چنانچہ وہ قبر میں اترے ۔"
"13417","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ عصر کی نماز اس وقت پڑھتے تھے کہ اگر کوئی شخص بنو حارثہ بن حارث کے یہاں جاتا تو وہ غروب آفتاب سے پہلے پہلے واپس آ سکتا تھا ، اور اتنا وقت ہوتا تھا کہ اگر کوئی آدمی اونٹ کو ذبح کر لے تو غروب آفتاب تک اس کے حصے بنا لے ، اور نماز جمعہ زوال کے وقت پڑھتے تھے ، اور جب مکہ مکرمہ کے لئے نکلتے تھے تو ظہر کی دو رکعتیں پڑھتے تھے ۔"
"13418","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضور نبی مکرم ﷽ نے ارشاد فرمایا دجال کانا ہو گا اور تمہارا رب کانا نہیں ہے ، اور اس کی دونوں آنکھوں کے درمیان کافر لکھا ہو گا ، جسے ہر پڑھا لکھا اور ہر ان پڑھ مسلمان پڑھ لے گا ۔"
"13419","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک شخص نے بارگاہ نبوت میں عرض کیا یا رسول اللہ ﷽ ! قیامت کب آئے گی آ اس وقت نبی ﷽ کے پاس ایک انصاری لڑکا """" جس کا نام محمد تھا """" بھی موجود تھا ، نبی ﷽ نے فرمایا اگر یہ لڑکا زندہ رہا تو ہو سکتا ہے کہ اس پر بڑھاپا آنے سے پہلے ہی قیامت آ جائے ۔"
"13420","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے پوچھا یا رسول اللہ ﷽ ! قیامت کب قائم ہو گی آ اس وقت اقامت ہو چکی تھی اس لئے نبی ﷽ نماز پڑھانے لگے ، نماز سے فارغ ہو کر فرمایا کہ قیامت کے متعلق سوال کرنے والا آدمی کہاں ہے آ اس نے کہا یا رسول اللہ ﷽ ! میں یہاں ہوں ، نبی ﷽ نے فرمایا تم نے قیامت کے لئے کیا تیاری کر رکھی ہے آ اس نے کہا کہ میں نے کوئی بہت زیادہ اعمال تو مہیا نہیں کر رکھے ، البتہ اتنی بات ضرور ہے کہ میں اللہ اور اس کے رسول سے محبت کرتا ہوں ، نبی ﷽ نے فرمایا کہ انسان قیامت کے دن اس شخص کے ساتھ ہو گا جس کے ساتھ وہ محبت کرتا ہے ، حضرت انس رضی اللہ عنہ فرماتے ہیں کہ میں نے مسلمانوں کو اسلام قبول کرنے کے بعد اس دن جتنا خوش دیکھا ، اس سے پہلے کبھی نہیں دیکھا ۔"
"13421","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے بارگاہ رسالت میں عرض کیا یا رسول اللہ ﷽ ! ایک آدمی کسی قوم سے محبت کرتا ہے لیکن ان کے اعمال تک نہیں پہنچتا ، تو کیا حکم ہے آ نبی ﷽ نے فرمایا انسان اسی کے ساتھ ہو گا جس کے ساتھ وہ محبت کرتا ہے ، حضرت انس رضی اللہ عنہ یہ حدیث بیان کرنے کے بعد فرماتے تھے کہ اے اللہ ! ہم تجھ سے اور تیرے رسول سے محبت کرتے ہیں ۔"
"13422","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو مسلمان کوئی کھیت اگاتا ہے یا کوئی پودا اگاتا ہے اور اس سے کسی پرندے ، انسان یا درندے کو رزق ملتا ہے تو وہ اس کے لئے صدقہ کا درجہ رکھتا ہے ۔"
"13423","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا سحری کھایا کرو ، کیونکہ سحری میں برکت ہوتی ہے ۔"
"13424","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جب اللہ نے حضرت آدم علیہ السلام کا پتلا تیار کیا تو کچھ عرصے تک اسے یونہی رہنے دیا ، شیطان اس پتلے کے اردگرد چکر لگاتا تھا اور اس پر غور کرتا تھا ، جب اس نے دیکھا کہ اس مخلوق کے جسم کے درمیان میں پیٹ ہے تو وہ سمجھ گیا کہ یہ مخلوق اپنے اوپر قابو نہ رکھ سکے گی ۔"
"13425","حضرت انس رضی اللہ عنہ سے مروی ہے کہ کسی شخص نے عرض کیا یا رسول اللہ ﷽ ! لوگوں کو ان کے چہروں کے بل کیسے اٹھایا جائے گا آ نبی ﷽ نے فرمایا جو ذات انہیں پااں کے بل چلانے پر قادر ہے ، وہ انہیں چہروں کے بل چلانے پر بھی قادر ہے ۔"
"13426","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے پوچھا یا رسول اللہ ! کیا دجال مدینہ منورہ کا ارادہ نہیں کرے گا آ حضور نبی مکرم سرور دو عالم ﷽ نے فرمایا کیوں نہیں ، دجال مدینہ منورہ کی طرف آئے گا لیکن وہاں فرشتوں کو اس کا پہرہ دیتے ہوئے پائے گا ۔"
"13427","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضور نبی مکرم ﷽ نے ارشاد فرمایا دجال کی دونوں آنکھوں کے درمیان حروف تہجی کی شکل میں کافر لکھا ہو گا ، جسے ہر پڑھا لکھا اور ہر ان پڑھ مسلمان پڑھ لے گا ۔"
"13428","حضرت انس رضی اللہ عنہ سے مروی ہے کہ اکیدر دومہ نے نبی ﷽ کی خدمت میں ایک ریشمی جوڑا ہدیہ کے طور پر بھیجا ، لوگ اس پر تعجب کرنے لگے کیوں کہ نبی ﷽ ریشم کی ممانعت فرماتے تھے ، نبی ﷽ نے فرمایا اس ذات کی قسم جس کے دست قدرت میں محمد ﷽ کی جان ہے سعد کے رومال """" جو انہیں جنت میں دیئے گئے ہیں """" وہ اس سے بہتر اور عمدہ ہیں ۔"
"13429","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نماز کھڑی ہوئی تو نبی ﷽ ہماری طرف متوجہ ہوئے اور فرمایا صفیں سیدھی کر لو اور جڑ کر کھڑے ہو کیونکہ میں تمہیں اپنے پیچھے سے بھی دیکھتا ہوں ۔"
"13430","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب تم میں سے کوئی شخص نماز کے لئے آئے تو سکون سے چلے ، جتنی نماز مل جائے سو پڑھ لے اور جو رہ جائے اسے قضاء کر لے ۔"
"13431","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب نبی ﷽ کی صاحبزادی + حضرت رقیہ رضی اللہ عنہا , کا انتقال ہوا تو نبی ﷽ نے فرمایا ان کی قبر میں ایسا شخص نہیں اترے گا جو رات کو اپنی بیوی سے بے حجاب ہوا ہو ، چنانچہ حضرت عثمان غنی رضی اللہ عنہ ان کی قبر میں نہیں اترے تھے ۔"
"13432","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دشمن پر طلوع فجر کے وقت حملے کی تیاری کرتے تھے ، اور کان لگا کر سنتے تھے ، اگر وہاں سے اذان کی آواز سنائی دیتی تو رک جاتے ، ورنہ حملہ کر دیتے ، ایک دن اسی طرح نبی ﷽ نے کان لگا کر سنا تو ایک آدمی کے اللہ اکبر ، اللہ اکبر کہنے کی آواز سنائی دی ، نبی ﷽ نے فرمایا فطرت سلیمہ پر ہے ، پھر جب اس نے ®اشہد ان الا الہ الا اللہ¾ کہا تو فرمایا کہ تو جہنم کی آگ سے نکل گیا ۔"
"13433","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ روم کے بادشاہ نے نبی ﷽ کی خدمت میں ایک ریشمی جبہ """" جس میں سونے کا کام ہوا تھا """" بھجوایا ، نبی ﷽ نے اسے پہن لیا ، لمبا ہونے کی وجہ سے وہ نبی ﷽ کے ہاتھوں میں جھول رہا تھا ، لوگ کہنے لگے یا رسول اللہ ! کیا یہ آپ پر آسمان سے اترا ہے آ نبی ﷽ نے فرمایا کیا تمہیں اس پر تعجب ہو رہا ہے آ اس ذات کی قسم جس کے دست قدرت میں میری جان ہے ، جنت میں سعد بن معاذ رضی اللہ عنہ کے صرف رومال ہی اس سے بہت بہتر ہیں پھر نبی ﷽ نے وہ جبہ حضرت جعفر رضی اللہ عنہ کے پاس بھجوا دیا ، انہوں نے اسے پہن لیا ، نبی ﷽ نے فرمایا یہ میں نے تمہیں پہننے کے لئے نہیں دیا ، انہوں نے پوچھا کہ پھر میں اس کا کیا کروں آ نبی ﷽ نے فرمایا اپنے بھائی نجاشی کے پاس بھیج دو ۔"
"13434","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا جس شخص کو یہ بات پسند ہو کہ اس کی عمر میں برکت اور رزق میں اضافہ ہو جائے ، اسے چاہئے کہ اپنے والدین کے ساتھ حسن سلوک کرے اور صلہ رحمی کیا کرے ۔"
"13435","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جہنم مسلسل یہی کہتی رہے گی کہ کوئی اور بھی ہے تو لے آا ، یہاں تک کہ پروردگار عالم اس میں اپنا پااں لٹکا دے گا اس وقت اس کے حصے ایک دوسرے کے ساتھ مل کر سکڑ جائیں گے اور وہ کہے گی کہ تیری عزت کی قسم ! بس ، بس ۔"
"13436","انس بن سیرین رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ ہم لوگ جمعرات کے دن حضرت انس رضی اللہ عنہ کی خدمت میں حاضر ہوئے ، انہوں نے ہمارے لیے دسترخوان منگوایا ، اور کھانے کی دعوت دی ، کچھ لوگوں نے کھا لیا اور کچھ لوگوں نے ہاتھ روکے رکھا ، پھر پیر کے دن حاضری ہوئی تو انہوں نے پھر دسترخوان منگوایا اور حسب سابق کھانے کی دعوت دی ، اس مرتبہ بھی کچھ لوگوں نے کھا لیا اور کچھ لوگوں نے نہ کھایا ، حضرت انس رضی اللہ عنہ نے یہ دیکھ کر فرمایا شاید تم لوگ پیر والے اور جمعرات والے ہو ، نبی ﷽ بعض اوقات اتنے روزے رکھتے کہ ہم یہ سمجھنے لگتے کہ اس سال نبی ﷽ کے دل میں کوئی روزہ چھوڑنے کا ارادہ نہیں ہے ، اور بعض اوقات اتنا افطار فرماتے کہ ہم یہ سمجھنے لگتے کہ اس سال نبی ﷽ کے دل میں کوئی روزہ رکھنے کا ارادہ نہیں ہے ، اور نبی ﷽ کو ماہ شعبان میں روزہ رکھنا سب سے زیادہ پسند تھا ۔"
"13437","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قیامت اس وقت تک قائم نہ ہو گی جب تک لوگ مساجد کے بارے میں ایک دوسرے پر فخر نہ کرنے لگیں ۔"
"13438","خواجہ حسن بصری رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ عبیداللہ بن زیاد کے سامنے کچھ لوگوں نے حوض کوثر کا تذکرہ کیا ، اس نے اس کا انکار کرتے ہوئے کہا کیسا حوض آ حضرت انس رضی اللہ عنہ کو پتہ چلا تو فرمایا بخدا ! میں اسے قائل کر کے رہوں گا ، چنانچہ وہ ابن زیاد کے پاس پہنچے اور اس سے فرمایا کیا تم لوگ حوض کوثر کا تذکرہ کر رہے تھے آ ابن زیاد نے پوچھا کہ کیا آپ نے نبی ﷽ کو اس کا تذکرہ کرتے ہوئے سنا ہے آ انہوں نے فرمایا ہاں ! آپ ﷽ بیشمار مرتبہ فرماتے تھے کہ اس کے دونوں کناروں کے درمیان اتنا فاصلہ ہے جتنا ایلہ اور مکہ کے درمیان ہے + یا صنعاء اور مکہ کے درمیان ہے , اور اس کے برتن آسمان کے ستاروں کی تعداد سے بھی زیادہ ہوں گے ۔"
"13439","[Darussalam 13406] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13440","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا تین چیزیں جس شخص میں بھی ہوں گی ، وہ ایمان کی حلاوت محسوس کرے گا ، ایک تو یہ کہ اللہ اور اس کے رسول اسے دوسروں سے سب سے زیادہ محبوب ہوں ، دوسرا یہ کہ انسان کسی سے محبت کرے تو صرف اللہ کی رضا کے لئے ، اور تیسرا یہ کہ انسان یہودیت یا عیسائیت سے نجات ملنے کے بعد اس میں واپس جانے کو اسی طرح ناپسند کرے جیسے آگ میں چھلانگ لگانے کو ناپسند کرتا ہے ۔"
"13441","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ تعالیٰ جب کسی بندے کے ساتھ خیر کا ارادہ فرماتے ہیں تو اسے استعمال فرماتے ہیں ، صحابہ رضی اللہ عنہم نے پوچھا کہ کیسے استعمال فرماتے ہیں آ نبی ﷽ نے فرمایا اسے مرنے سے پہلے عمل صالح کی توفیق عطاء فرما دیتے ہیں ۔"
"13442","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ حضرت ام سلیم رضی اللہ عنہا کے گھر تشریف لا کر ان کے بستر پر سو جاتے تھے ، وہ وہاں نہیں ہوتی تھیں ، ایک دن نبی ﷽ حسب معمول آئے اور ان کے بستر پر سو گئے ، وہ گھر آئیں تو دیکھا کہ نبی ﷽ پسینے میں بھیگے ہوئے ہیں ، وہ روئی سے اس پسینے کو اس میں جذب کر کے ایک شیشی میں نچوڑنے لگیں ، اور اپنی خوشبو میں شامل کر لیا ۔"
"13443","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک درخت سے راستے میں گذرنے والوں کو اذیت ہوتی تھی ، ایک آدمی نے اسے آ کر ہٹا دیا ، نبی ﷽ نے فرمایا میں نے جنت میں اسے درختوں کے سائے میں پھرتے ہوئے دیکھا ہے ۔"
"13444","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جہنم میں ایک بندہ ایک ہزار سال تک """" یا حنان یا منان """" کہہ کر اللہ کو پکارتا رہے گا ، اللہ تعالیٰ حضرت جبریل علیہ السلام سے فرمائیں گے کہ جا کر میرے اس بندے کو لے کر آا ، جبریل چلے جائیں گے ، وہاں پہنچ کر وہ اہل جہنم کو ایک دوسرے کے اوپر اوندھا پڑا ہوا پائیں گے ، اور وہ لوگ رو رہے ہوں گے + حضرت جبریل علیہ السلام اسے پہچان نہ سکیں گے , اور واپس آ کر پروردگار کو اس کی خبر دیں گے ، اللہ تعالیٰ فرمائیں گے کہ وہ فلاں فلاں جگہ میں ہے ، اسے وہاں سے نکال کر میرے پاس لاا ، چنانچہ جبریل علیہ السلام اسے لا کر بارگاہ خداوندی میں پیش کر دیں گے ، اللہ تعالیٰ اس سے پوچھیں گے کہ بندے ! تو نے اپنا ٹھکانہ اور آرام کرنے کی جگہ کیسی پائی آ وہ کہے گا کہ پروردگار ! بدترین ٹھکانہ اور بدترین آرام گاہ ، اللہ تعالیٰ فرمائیں گے کہ میرے بندے کو واپس جہنم میں لے جاا ، وہ عرض کرے گا کہ پروردگار ! جب آپ نے مجھے جہنم سے نکلوایا تھا تو مجھے یہ امید نہیں تھی کہ آپ دوبارہ مجھے اس میں واپس لوٹا دیں گے ، اس پر اللہ تعالیٰ فرمائیں گے کہ میرے بندے کو چھوڑ دو ۔"
"13445","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب رات کا کھانا سامنے آ جائے اور نماز کھڑی ہو جائے تو پہلے کھانا کھا لو ۔"
"13446","حضرت انس رضی اللہ عنہ سے مروی ہے کہ فتح مکہ کے دن نبی ﷽ جب مکہ مکرمہ میں داخل ہوئے تو آپ ﷽ نے خود پہن رکھا تھا ، جب نبی ﷽ نے اسے اتارا تو کسی شخص نے آ کر بتایا کہ ابن خطل خانہ کعبہ کے پردوں کے ساتھ چمٹا ہوا ہے ، نبی ﷽ نے فرمایا پھر بھی اسے قتل کر دو ۔"
"13447","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی نماز سب سے زیادہ خفیف اور مکمل ہوتی تھی ۔"
"13448","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کا گذر ایک آدمی پر ہوا جو قربانی کا جانور ہانکتے ہوئے چلا جا رہا تھا ، نبی ﷽ نے اس سے سوار ہونے کے لئے فرمایا ، اس نے کہا کہ یہ قربانی کا جانور ہے ، نبی ﷽ نے دو تین مرتبہ اس سے فرمایا کہ سوار ہو جاا ۔"
"13449","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قوم کا بھانجا ان ہی میں شمار ہوتا ہے ۔"
"13450","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ یہ دعاء فرمایا کرتے تھے اے اللہ ! میں سستی ، بڑھاپے ، بزدلی ، بخل ، اور عذاب قبر سے آپ کی پناہ میں آتا ہوں ۔"
"13451","حضرت انس رضی اللہ عنہ فرماتے ہیں کہ میں نے دس سال تک نبی ﷽ کی خدمت کی ہے ، نبی ﷽ نے اس دوران اگر مجھے کسی کا حکم دیا اور مجھے اس میں تاخیر ہو گئی یا وہ کام نہ کر سکا تو نبی ﷽ نے مجھے کبھی ملامت نہ کی ، اگر اہل خانہ میں سے کوئی شخص ملامت کرتا تو آپ ﷽ فرما دیتے کہ اسے چھوڑ دو ، اگر تقدیر میں یہ کام لکھا ہوتا تو ضرور ہو جاتا ۔"
"13452","[Darussalam 13419] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13453","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا تم میں سے کوئی شخص نماز میں کتے کی طرح اپنے ہاتھ نہ بچھائے ۔"
"13454","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا شب معراج میں ایسے لوگوں کے پاس سے گذرا جن کے منہ آگ کی قینچیوں سے کاٹے جا رہے تھے ، میں نے پوچھا یہ کون لوگ ہیں آ بتایا گیا کہ یہ آپ کی امت کے خطباء ہیں ، جو لوگوں کو نیکی کا حکم دیتے تھے اور اپنے آپ کو بھول جاتے تھے اور کتاب کی تلاوت کرتے تھے ، کیا یہ سمجھتے نہ تھے ۔"
"13455","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ ہمارے گھر تشریف لائے ، ہم نے ایک پالتو بکری کا دودھ دوہا اور گھر کے کنوئیں میں سے پانی لے کر اس میں ملایا اور نبی ﷽ کی خدمت میں پیش کر دیا ، نبی ﷽ کی دائیں جانب ایک دیہاتی تھا ، اور بائیں جانب حضرت ابوبکر صدیق رضی اللہ عنہ تھے ، حضرت عمر رضی اللہ عنہ بھی ایک کونے میں تھے ، نبی ﷽ جب اسے نوش فرما چکے تو حضرت عمر رضی اللہ عنہ نے عرض کیا کہ یہ ابوبکر کو دے دیجئے ، لیکن نبی ﷽ نے دودھ کا وہ برتن دیہاتی کو دے دیا اور فرمایا پہلے دائیں ہاتھ والے کو ، پھر اس کے بعد والے کو ۔"
"13456","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ حضرت ام سلیم رضی اللہ عنہا کے یہاں قیلولہ کے لئے تشریف لاتے تھے ، اور نبی ﷽ کو پسینہ بہت آتا تھا ، حضرت ام سلیم رضی اللہ عنہا نے نبی ﷽ کے لئے چمڑے کا ایک بستر بنوا رکھا تھا ، نبی ﷽ اسی پر قیلولہ فرماتے تھے ، بعد میں وہ اس پسینے کو نچوڑ لیا کرتی تھیں ، ایک مرتبہ نبی ﷽ نے پوچھا کہ ام سلیم ! یہ کیا کر رہی ہو آ انہوں نے کہا کہ یا رسول اللہ آپ کے اس پسینے کو ہم اپنی خوشبو میں شامل کریں گے نبی ﷽ نے انہیں دعا دی ۔"
"13457","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت ام سلیم رضی اللہ عنہا کو ایک باندی دیکھنے کے لئے بھیجا اور فرمایا اس کے جسم کی خوشبو کو سونگھ کر دیکھنا اور اس کی ایڑی کے پٹھے پر غور کرنا ۔"
"13458","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول ﷽ نے ارشاد فرمایا میں جنت میں داخل ہوا تو اچانک ایک نہر پر نظر پڑی جس کے دونوں کناروں پر موتیوں کے خیمے لگے ہوئے تھے ، میں نے اس میں ہاتھ ڈال کر پانی میں بہنے والی چیز کو پکڑا تو وہ مہکتی ہوئی مشک تھی اور اس کی کنکریاں موتی تھے ، میں نے جبریل ﷽ سے پوچھا کہ یہ کیا ہے آ تو انہوں نے بتایا کہ یہ نہر کوثر ہے جو اللہ نے آپ کو عطاء فرمائی ہے ۔"
"13459","اور ایک دوسری روایت میں ہے کہ میرے ساتھی فرشتے نے کہا کہ کیا آپ کو معلوم ہے کہ یہ کیا چیز ہے آ یہ کوثر ہے جو آپ کو آپ کے رب نے عطاء فرمائی ہے ، پھر اس نے اپنا ہاتھ اس کی زمین پر مار کر اس کی مٹی میں سے مشک نکال کر دکھائی ۔"
"13460","حضرت انس رضی اللہ عنہ سے مروی ہے کہ عیدالفطر کے دن نبی ﷽ عیدگاہ کی طرف اس وقت تک نہیں نکلتے تھے جب تک ایک ایک کر کے چند کھجوریں نہ کھا لیتے ، حضرت انس رضی اللہ عنہ بھی نکلنے سے پہلے تین یا پانچ یا زیادہ ہونے کی صورت میں طاق عدد میں کھجوریں کھا لیتے تھے ۔"
"13461","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ابوطلحہ رضی اللہ عنہ دو مد جو لے کر آئے ، اور کھانا تیار کرنے کے لئے کہا ، پھر مجھ سے کہا کہ انس ! جا کر نبی ﷽ کو بلا لاا اور تمہیں معلوم ہی ہے کہ ہمارے پاس کیا ہے ، میں نبی ﷽ کے پاس پہنچا تو آپ ﷽ صحابہ کرام رضی اللہ عنہم کے درمیان رونق افروز تھے ، میں نے نبی ﷽ سے عرض کیا کہ مجھے حضرت ابوطلحہ رضی اللہ عنہ نے آپ کے پاس کھانے کی دعوت دے کر بھیجا ہے ، نبی ﷽ نے فرمایا مجھے اور میرے ساتھیوں کو بھی آ یہ کہہ کر نبی ﷽ اپنے ساتھیوں کو لے کر روانہ ہو گئے ۔ میں نے جلدی سے گھر پہنچ کر حضرت ابوطلحہ رضی اللہ عنہ سے کہا کہ نبی ﷽ تو اپنے ساتھیوں کو بھی لے آئے ، یہ سن کر حضرت ابوطلحہ رضی اللہ عنہ نے کہا کہ تو نے ہمیں رسوا کر دیا ، میں نے کہا کہ میں نبی ﷽ کی بات کو رد نہیں کر سکا ، نبی ﷽ جب ان کے گھر پہنچے تو فرمایا بیٹھ جاا ، پھر دس آدمی اندر آئے اور انہوں نے خوب سیر ہو کر کھانا کھایا ، نبی ﷽ ان کے ہمراہ تھے ، پھر دس دس کر کے سب لوگوں نے وہ کھانا کھا لیا اور خوب سیراب ہو کر سب نے کھایا راوی کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ وہ کتنے لوگ تھے آ انہوں نے بتایا اسی سے کچھ اوپر ، اور اہل خانہ کے لئے بھی اتنا بچ گیا تھا کہ جس سے وہ سیراب ہو جائیں ۔"
"13462","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کا وقت ہو گیا ، حضرت بلال رضی اللہ عنہ نے اقامت کہی ، اسی دوران نبی ﷽ کے سامنے ایک آدمی آ گیا ، جس وقت آپ ﷽ نماز کے لئے اٹھے تو بعض لوگ اونگھنے لگے تھے پھر نبی ﷽ نے آ کر لوگوں کو نماز پڑھائی ۔"
"13463","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ماہ رمضان میں نبی ﷽ سفر پر تھے ، نبی ﷽ کے سامنے ایک برتن لایا گیا ، آپ ﷽ نے اسے اپنے ہاتھ پر رکھا تاکہ لوگ دیکھ لیں اور اسے نوش فرما لیا ۔"
"13464","حضرت انس رضی اللہ عنہ سے مروی ہے کہ کسی جگہ پر اچانک ہمارے سامنے ایک خرگوش آ گیا ، بچے اس کی طرف دوڑے ، لیکن اسے پکڑ نہ سکے یہاں تک کہ تھک گئے , ، میں نے اسے پکڑ لیا ، اور حضرت ابوطلحہ رضی اللہ عنہ کے پاس لے آیا ، انہوں نے اسے ذبح کیا اور بھون کر اس کا ایک پہلو نبی ﷽ کی خدمت میں میرے ہاتھ بھیج دیا اور نبی ﷽ نے اسے قبول فرما لیا ۔"
"13465","حضرت انس رضی اللہ عنہ سے مروی ہے کہ آپ ﷽ نے ایک مہینے تک فجر کی نماز میں رکوع کے بعد قنوت نازلہ پڑھی اور رعل ، ذکوان ، عصیہ اور بنو لحیان کے قبائل پر بددعاء کرتے رہے ۔"
"13466","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے میری کنیت اس سبزی کے نام پر رکھی تھی جو میں چنتا تھا ۔"
"13467","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا مسجد میں تھوکنا گناہ ہے اور اس کا کفارہ اسے دفن کر دینا ہے ۔"
"13468","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ عصر کی نماز اس وقت پڑھتے تھے جب سورج روشن اور اپنے حلقے کی شکل میں ہوتا تھا ، میں مدینہ منورہ کے ایک کونے میں واقع اپنے محلے اور گھر میں پہنچتا اور ان سے کہتا کہ نبی ﷽ نماز پڑھ چکے ہیں لہٰذا تم بھی اٹھ کر نماز پڑھ لو ۔"
"13469","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ کے پاس ایک مرتبہ میں جو کی روٹی اور پرانا روغن لے کر آیا تھا ۔"
"13470","حضرت انس رضی اللہ عنہ سے مروی ہے کہ فتح مکہ کے دن نبی ﷽ جب مکہ مکرمہ میں داخل ہوئے تو آپ ﷽ نے خود پہن رکھا تھا ، کسی شخص نے آ کر بتایا کہ ابن خطل خانہ کعبہ کے پردوں کے ساتھ چمٹا ہوا ہے ، نبی ﷽ نے فرمایا پھر بھی اسے قتل کر دو ۔"
"13471","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے نماز میں اکڑوں بیٹھنے سے اور کولہوں پر بیٹھ کر دونوں پااں ایک طرف نکال لینے سے منع فرمایا ہے ۔ عبداللہ کہتے ہیں کہ میرے والد امام احمد رحمۃ اللہ نے یہ حدیث ترک کر دی تھی ۔"
"13472","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضور نبی مکرم ﷽ نے ارشاد فرمایا دنیا میں جو نبی بھی مبعوث ہو کر آئے ، انہوں نے اپنی امت کو کانے کذاب سے ضرور ڈرایا ، یاد رکھو ! دجال کانا ہو گا اور تمہارا رب کانا نہیں ہے ۔"
"13473","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا پہلے اگلی پھر اس کے بعد والی صفوں کو مکمل کیا کرو اور کوئی کمی ہو تو وہ آخری صف میں ہونی چاہئے ۔"
"13474","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا پہلے اگلی پھر اس کے بعد والی صفوں کو مکمل کیا کرو اور کوئی کمی ہو تو وہ آخری صف میں ہونی چاہئے ۔"
"13475","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے دور باسعادت میں چار صحابہ رضی اللہ عنہم نے پورا قرآن یاد کر لیا تھا ، اور وہ چاروں انصار سے تعلق رکھتے تھے ، حضرت ابی بن کعب رضی اللہ عنہ ، حضرت معاذ بن جبل رضی اللہ عنہ ، حضرت زید بن ثابت رضی اللہ عنہ ، حضرت ابوزید رضی اللہ عنہ ۔"
"13476","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک مرتبہ حضرت ابی بن کعب رضی اللہ عنہ سے فرمایا کہ اللہ نے مجھے حکم دیا ہے کہ تمہیں قرآن پڑھ کر سنااں ، حضرت ابی بن کعب رضی اللہ عنہ نے عرض کیا کہ کیا اللہ نے میرا نام لے کر کہا ہے آ نبی ﷽ نے فرمایا ہاں ! یہ سن کر حضرت ابی بن کعب رضی اللہ عنہ رو پڑے ۔"
"13477","حضرت انس رضی اللہ عنہ سے مروی ہے کہ قبیلہ عکل اور عرینہ کے کچھ لوگ مسلمان ہو گئے ، لیکن انہیں مدینہ منورہ کی آب و ہوا موافق نہ آئی ، انہوں نے عرض کیا یا رسول اللہ ! ہم دیہاتی لوگ ہیں ، شہری لوگ نہیں ہیں ، ہمیں مدینہ کی آب و ہوا موافق نہیں آتی ہے ، نبی ﷽ نے ان سے فرمایا کہ اگر تم ہمارے اونٹوں کے پاس جا کر ان کا دودھ اور پیشاب پیو تو شاید تندرست ہو جاا ، چنانچہ انہوں نے ایسا ہی کیا ، لیکن جب وہ صحیح ہو گئے تو دوبارہ مرتد ہو کر کفر کی طرف لوٹ گئے ، نبی ﷽ کے مسلمان چرواہے کو قتل کر دیا ، اور نبی ﷽ کے اونٹوں کو بھگا کر لے گئے ، نبی ﷽ نے ان کے پیچھے صحابہ رضی اللہ عنہم کو بھیجا ، انہیں پکڑ کر نبی ﷽ کے سامنے پیش کیا گیا ، نبی ﷽ نے ان کے ہاتھ پااں مخالف سمت سے کٹوا دیئے ، ان کی آنکھوں میں سلائیاں پھروا دیں اور انہیں پتھریلے علاقوں میں چھوڑ دیا یہاں تک کہ وہ مر گئے ۔"
"13478","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے بیٹھ کر ایک کپڑے میں لپٹ کر حضرت ابوبکر صدیق رضی اللہ عنہ کے پیچھے نماز پڑھی تھی ۔"
"13479","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ سے زیادہ ہلکی اور مکمل نماز کسی امام کے پیچھے نہیں پڑھی ، بعض اوقات نبی ﷽ کسی بچے کے رونے کی آواز سن کر نماز مختصر کر دیتے تھے ، اس اندیشے سے کہ کہیں اس کی ماں پریشان نہ ہو ۔"
"13480","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب انسان کو دفن کر کے اس کے ساتھی چلے جاتے ہیں ، تو مردہ ان کے جوتوں کی آہٹ تک سنتا ہے ، پھر دو فرشتے آ کر اسے بٹھاتے ہیں ، اور اس سے نبی ﷽ کے متعلق پوچھتے ہیں کہ تم اس آدمی کے متعلق کیا کہتے ہو آ اگر وہ مامن ہو تو کہہ دیتا ہے کہ میں اس بات کی گواہی دیتا ہوں کہ محمد ﷽ اللہ کے بندے اور اس کے رسول ہیں ، پھر اسے جہنم کا ایک دروازہ کھول کر دکھایا جاتا ہے اور اس سے کہا جاتا ہے کہ اگر تم اپنے رب کے ساتھ کفر کرتے تو تمہارا ٹھکانہ یہاں ہوتا ، لیکن چونکہ تم اس پر ایمان رکھتے ہو اس لئے تمہارا ٹھکانہ دوسرا ہے ، چنانچہ وہ ان دونوں جگہوں کو دیکھتا ہے ۔"
"13481","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ بنو نجار کے ایک باغ میں داخل ہوئے تو وہاں ایک آواز سنی ، نبی ﷽ گھبرا گئے اور فرمایا یہ کن لوگوں کی قبریں ہیں آ لوگوں نے عرض کیا اے اللہ کے نبی ! یہ کچھ لوگ تھے جو زمانہ جاہلیت میں فوت ہوئے تھے ، نبی ﷽ نے فرمایا عذاب قبر ، عذاب جہنم اور فتنہ دجال کے شر سے اللہ کی پناہ مانگو ، صحابہ رضی اللہ عنہم نے پوچھا یا رسول اللہ ! اس سے کیا مراد ہے آ نبی ﷽ نے فرمایا اس امت کی آزمائش قبروں میں ہوتی ہے ۔ جب انسان کو دفن کر کے اس کے ساتھی چلے جاتے ہیں ، تو مردہ ان کے جوتوں کی آہٹ تک سنتا ہے ، پھر ایک فرشتہ آ کر اس سے پوچھتا ہے کہ تم کس کی عبادت کرتے تھے آ اگر اللہ تعالی اسے ہدایت دے دے تو وہ کہہ لیتا ہے کہ میں اللہ کی عبادت کرتا تھا ، پھر اس سے پوچھا جاتا ہے کہ تم اس آدمی کے متعلق کیا کہتے ہو آ وہ کہہ دیتا ہے کہ میں اس بات کی گواہی دیتا ہوں کہ محمد ﷽ اللہ کے بندے اور رسول ہیں ، پھر اسے جہنم کا ایک دروازہ کھول کر دکھایا جاتا ہے اور اس سے کہا جاتا ہے کہ اگر تم اپنے رب کے ساتھ کفر کرتے تو تمہارا ٹھکانہ یہاں ہوتا ، لیکن چونکہ تم اس پر ایمان رکھتے ہو اس لیے اللہ نے تمہیں بچا لیا اور تم پر رحم فرمایا اور اب تمہارا ٹھکانا دوسرا ہے ، وہ کہتا ہے کہ مجھے اپنے گھر والوں کے پاس یہ خوشخبری سنانے کے لیے جانے دو ، لیکن اسے آرام کرنے کا حکم دیا جاتا ہے ۔ اور اگر وہ کافر یا منافق ہو تو فرشتہ جب اس سے پوچھتا ہے کہ تم اس آدمی کے متعلق کیا کہتے ہو آ وہ جواب دیتا ہے کہ مجھے تو کچھ معلوم نہیں ، البتہ میں نے لوگوں کو کچھ کہتے ہوئے سنا ضرور تھا ، وہ فرشتہ اپنے گرز سے اس پر اتنی زور کی ضرب لگاتا ہے جس کی آواز جن و انس کے علاوہ اللہ کی ساری مخلوق سنتی ہے ۔"
"13482","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی نماز سب سے زیادہ خفیف اور مکمل ہوتی تھی ۔"
"13483","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"13484","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا مسجد میں ناک صاف کرنا گناہ ہے اور اس کا کفارہ اسے دفن کر دینا ہے ۔"
"13485","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جب تم میں سے کوئی شخص نماز پڑھ رہا ہوتا ہے تو وہ اپنے رب سے مناجات کر رہا ہوتا ہے ، اس لئے اس حالت میں تم میں سے کوئی شخص اپنی دائیں جانب نہ تھوکا کرے بلکہ بائیں جانب یا اپنے پااں کے نیچے تھوکا کرے ۔"
"13486","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا شب قدر کو رمضان کے آخری عشرے کی نو ، سات اور پانچ کو تلاش کیا کرو ۔"
"13487","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا رکوع و سجود کو مکمل کیا کرو ، کیونکہ میں بخدا تمہیں اپنی پشت کے پیچھے سے بھی دیکھ رہا ہوتا ہوں ۔"
"13488","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت سعد بن معاذ رضی اللہ عنہ کا جنازہ رکھا ہوا تھا اور نبی ﷽ فرما رہے تھے کہ اس پر رحمن کا عرش بھی ہل گیا ۔"
"13489","حضرت انس رضی اللہ عنہ سے مروی ہے کہ اکیدر دومہ نے نبی ﷽ کی خدمت میں ایک ریشمی جوڑا ہدیہ کے طور پر بھیجا ، یہ بات ریشم کی ممانعت سے پہلے کی ہے ، نبی ﷽ نے اسے زیب بدن فرما لیا ، لوگ اس کی خوبصورتی پر تعجب کرنے لگے ، نبی ﷽ نے فرمایا اس ذات کی قسم ! جس کے دست قدرت میں محمد ﷽ کی جان ہے ، سعد کے رومال """" جو انہیں جنت میں دیئے گئے ہیں """" وہ اس سے بہتر اور عمدہ ہیں ۔"
"13490","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کا گذر ایک آدمی پر ہوا جو قربانی کا جانور ہانکتے ہوئے چلا جا رہا تھا ، نبی ﷽ نے اس سے سوار ہونے کے لئے فرمایا ، اس نے کہا کہ یہ قربانی کا جانور ہے ۔ نبی ﷽ نے دو تین مرتبہ اس سے فرمایا کہ سوار ہو جاا ۔"
"13491","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جہنم مسلسل یہ کہتی رہے گی کہ کوئی اور بھی ہے تو لے آا ، یہاں تک کہ پروردگار عالم اس میں اپنا پااں لٹکا دے گا اس وقت اس کے حصے ایک دوسرے کے ساتھ مل کر سکڑ جائیں گے اور وہ کہے گی کہ تیری عزت کی قسم ! بس ، بس ، اسی طرح جنت میں بھی جگہ زائد بچ جائے گی ، حتیٰ کہ اللہ اس کے لئے ایک اور مخلوق کو پیدا کر کے جنت کے باقی ماندہ حصے میں اسے آباد کر دے گا ۔"
"13492","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جنت میں ایک درخت ایسا بھی ہے جس کے سائے میں اگر کوئی سوار سو سال تک چلتا رہے تب بھی اس کا سایہ ختم نہ ہو ۔"
"13493","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک یہودی نے نبی ﷽ اور صحابہ رضی اللہ عنہم کو گذرتے ہوئے سلام کرتے ہوئے """" السام علیکم """" کہا ، نبی ﷽ نے صحابہ رضی اللہ عنہم سے فرمایا تم جانتے ہو کہ اس نے کیا کہا ہے آ انہوں نے عرض کیا کہ یا رسول اللہ ! اس نے سلام کیا ہے ، نبی ﷽ نے فرمایا نہیں ، اس نے یہ کہا ہے ، اسے میرے پاس بلا کر لاا ، اور اس سے پوچھا کہ کیا تم نے ®السام علیکم¾ کہا تھا آ اس نے اقرار کیا تو نبی ﷽ نے فرمایا جب تمہیں کوئی """" کتابی """" سلام کرے تو صرف ®وعلیک¾ کہا کرو ۔"
"13494","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ اور حضرت زید بن ثابت رضی اللہ عنہ نے اکٹھے سحری کی ، سحری سے فارغ ہو کر نبی ﷽ نماز کے لئے کھڑے ہوئے ، اور نماز پڑھائی ، ہم لوگ حضرت انس رضی اللہ عنہ سے پوچھنے لگے کہ سحری سے فراغت اور نماز کھڑی ہونے کے درمیان کتنا وقفہ تھا آ انہوں نے بتایا کہ جتنی دیر میں ایک آدمی پچاس آیات پڑھ سکے ۔"
"13495","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ایک ہی سحری سے مسلسل کئی روزے نہ رکھا کرو ، کسی نے عرض کیا یا رسول اللہ ! آپ تو اس طرح کرتے ہیں آ نبی ﷽ نے فرمایا میں اس معاملے میں تمہاری طرح نہیں ہوں ، میرا رب مجھے کھلا پلا دیتا ہے ۔"
"13496","حضرت انس رضی اللہ عنہ سے مروی ہے کہ انصار کے ستر جوان تھے جنہیں قراء کہا جاتا تھا ، وہ مسجد میں ہوتے تھے ، جب شام ہوتی تو مدینہ کے کسی کونے میں چلے جاتے ، سبق پڑھتے اور نماز پڑھتے تھے ، ان کے گھر والے یہ سمجھتے کہ وہ مسجد میں ہیں اور مسجد والے یہ سمجھتے کہ وہ گھر میں ہیں ، صبح ہونے کے بعد وہ میٹھا پانی لاتے اور لکڑیاں کاٹتے اور انہیں لا کر نبی ﷽ کے حجرے کے پاس لٹکا دیتے ، ایک مرتبہ نبی ﷽ نے ان سب کو روانہ فرمایا اور وہ بئر معونہ کے موقع پر شہید ہو گئے ، نبی ﷽ پندرہ دن تک فجر کی نماز میں ان کے قاتلوں پر بددعاء فرماتے رہے تھے ۔"
"13497","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"13498","محمد رحمۃ اللہ کہتے ہیں کہ حضرت انس رضی اللہ عنہ جب نبی ﷽ کے حوالے سے کوئی حدیث بیان کرتے تو آخر میں یہ فرماتے """" یا جیسے نبی ﷽ نے ارشاد فرمایا """" ۔"
"13499","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"13500","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی ساری نمازیں قریب قریب برابر ہوتی تھیں ، اسی طرح حضرت ابوبکر صدیق رضی اللہ عنہ کی نمازیں بھی درمیانی ہوتی تھیں ، لیکن حضرت عمر رضی اللہ عنہ نے فجر کی نماز طویل کرنا شروع فرمائی ۔"
"13501","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ اپنے چند صحابہ رضی اللہ عنہم کے ساتھ کہیں جا رہے تھے ، راستے میں ایک بچہ پڑا ہوا تھا ، اس کی ماں نے جب لوگوں کو دیکھا تو اسے خطرہ ہوا کہ کہیں بچہ لوگوں کے پااں میں روندا نہ جائے ، چنانچہ وہ دوڑتی ہوئی """" میرا بیٹا ، میرا بیٹا """" پکارتی ہوئی آئی اور اسے اٹھا لیا ، لوگ کہنے لگے یا رسول اللہ ﷽ ! یہ عورت اپنے بیٹے کو کبھی آگ میں نہیں ڈال سکتی ، نبی ﷽ نے فرمایا نہیں ، اور اللہ بھی اپنے دوست کو آگ میں نہیں ڈالے گا ۔"
"13502","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ایک آدمی کو اپنے دو بیٹوں کے کندھوں کا سہارا لے کر چلتے ہوئے دیکھا تو پوچھا یہ کیا ماجرا ہے آ انہوں نے بتایا کہ انہوں نے پیدل چل کر حج کرنے کی منت مانی تھی ، نبی ﷽ نے فرمایا اللہ اس بات سے غنی ہے کہ یہ شخص اپنے آپ کو تکلیف میں مبتلا کرے ، پھر آپ ﷽ نے اسے سوار ہونے کا حکم دیا ، چنانچہ وہ سوار ہو گیا ۔"
"13503","حضرت انس رضی اللہ عنہ فرماتے ہیں کہ ایک مرتبہ میں بچوں کے ساتھ کھیل رہا تھا ، اسی دوران نبی ﷽ تشریف لے آئے اور ہمیں سلام کیا ، پھر میرا ہاتھ پکڑ کر مجھے کسی کام سے بھیج دیا اور خود ایک دیوار کے سائے میں بیٹھ گئے ، یہاں تک کہ میں واپس آ گیا ، اور وہ پیغام پہنچا دیا جو نبی ﷽ نے دے کر مجھے بھیجا تھا ، جب میں گھر واپس پہنچا تو حضرت ام سلیم رضی اللہ عنہا + میری والدہ , کہنے لگیں کہ اتنی دیر کیوں لگا دی آ میں نے بتایا کہ نبی ﷽ نے اپنے کسی کام سے بھیجا تھا ، انہوں نے پوچھا کیا کام تھا آ میں نے کہا کہ یہ ایک راز ہے ، انہوں نے کہا کہ پھر نبی ﷽ کے راز کی حفاظت کرنا ، چنانچہ اس کے بعد میں نے کبھی وہ کسی کے سامنے بیان نہیں کیا ۔"
"13504","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب مدینہ منورہ تشریف لائے تو پتہ چلا کہ دو دن ایسے ہیں جن میں لوگ زمانہ جاہلیت سے جشن مناتے آ رہے ہیں ، نبی ﷽ نے فرمایا میں تمہارے یہاں آیا ہوں اور تمہارے یہاں تہوار کے دو دن ہیں جن میں تم تفریح کرتے ہو ، اللہ نے ان دو دونوں کے بدلے میں تمہیں اس سے بہتر دن یوم الفطر اور یوم الاضحی عطاء فرمائے ہیں ۔"
"13505","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ابوموسیٰ اشعری رضی اللہ عنہ نے نبی ﷽ سے سواری کے لئے کوئی جانور مانگا ، نبی ﷽ اس وقت کسی کام میں مصروف تھے ، اس لئے فرما دیا کہ بخدا ! میں تمہیں کوئی سواری نہیں دوں گا ، لیکن جب وہ پلٹ کر جانے لگے تو انہیں واپس بلایا اور ایک سواری مرحمت فرما دی ، وہ کہنے لگے یا رسول اللہ ﷽ ! آپ نے تو قسم کھائی تھی کہ مجھے کوئی سواری نہیں دیں گے آ فرمایا اب قسم کھا لیتا ہوں کہ تمہیں سواری ضرور دوں گا ۔"
"13506","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ یہ دعاء فرمایا کرتے تھے اے اللہ ! میں سستی ، بڑھاپے ، بزدلی ، بخل ، فتنہ دجال اور عذاب قبر سے آپ کی پناہ میں آتا ہوں ۔"
"13507","حمید کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے نبی ﷽ کی رات کی نماز اور نفلی روزوں کے متعلق پوچھا تو انہوں نے فرمایا کہ ہم رات کے جس وقت نبی ﷽ کو نماز پڑھتے ہوئے دیکھنا چاہتے تھے ، دیکھ سکتے تھے اور جس وقت سوتا ہوا دیکھنے کا ارادہ ہوتا تو وہ بھی دیکھ لیتے تھے ، اسی طرح نبی ﷽ کسی مہینے میں اس تسلسل کے ساتھ روزے رکھتے کہ ہم یہ سوچنے لگتے کہ اب نبی ﷽ کوئی روزہ نہیں چھوڑیں گے اور بعض اوقات روزے چھوڑتے تو ہم کہتے کہ شاید اب نبی ﷽ کوئی روزہ نہیں رکھیں گے ۔"
"13508","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا یہ ماہ رمضان آ گیا ہے ، اس ماہ مبارک میں جنت کے دروازے کھول دیئے جاتے ہیں ، جہنم کے دروازے بند کر دیئے جاتے ہیں اور شیاطین کو جکڑ دیا جاتا ہے ۔"
"13509","حضرت انس رضی اللہ عنہ سے مروی ہے کہ کسی شخص نے نبی ﷽ سے """" کوثر """" کے متعلق پوچھا ، نبی ﷽ نے فرمایا کہ یہ ایک نہر کا نام ہے جو میرے رب نے مجھے عطاء فرمائی ہے ، اس کی مٹی مشک ہے ، اس کا پانی دودھ سے زیادہ سفید اور شہد سے زیادہ میٹھا ہو گا ، اور اس میں اونٹوں کی گردنوں کے برابر پرندے ہوں گے ، حضرت ابوبکر رضی اللہ عنہ نے عرض کیا کہ یا رسول اللہ ﷽ ! پھر تو وہ پرندے خوب صحت مند ہوں گے ، نبی ﷽ نے فرمایا انہیں کھانے والے ان سے بھی زیادہ صحت مند ہوں گے ۔"
"13510","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اگر ابن آدم کے پاس سونے سے بھری ہوئی دو وادیاں بھی ہوتیں تو وہ تیسری کی تمنا کرتا اور ابن آدم کا منہ صرف قبر کی مٹی ہی بھر سکتی ہے ، اور جو توبہ کرتا ہے ، اللہ اس کی توبہ قبول فرما لیتا ہے ۔"
"13511","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ بدر کے دن نبی ﷽ نے ارشاد فرمایا کون جا کر دیکھے گا کہ ابوجہل کا کیا بنا آ حضرت ابن مسعود رضی اللہ عنہ اس خدمت کے لئے چلے گئے ، انہوں نے دیکھا کہ عفراء کے دونوں بیٹوں نے اسے مار مار کر ٹھنڈا کر دیا ہے ، حضرت ابن مسعود رضی اللہ عنہ نے ابوجہل کی ڈاڑھی پکڑ کر فرمایا کیا تو ہی ابوجہل ہے آ کیا تو ہی گمراہ بڈھا ہے آ اس نے کہا کیا تم نے مجھ سے بڑے بھی کسی آدمی کو قتل کیا ہے آ"
"13512","حضرت انس رضی اللہ عنہ سے مروی ہے کہ پردہ کا حکم جب نازل ہوا ، اس وقت کی کیفیت تمام لوگوں میں سب سے زیادہ مجھے معلوم ہے اور حضرت ابی بن کعب رضی اللہ عنہ بھی مجھ سے اس کے متعلق پوچھتے تھے ، اس رات نبی ﷽ نے حضرت زینب رضی اللہ عنہا کے ساتھ خلوت فرمائی تھی ، اور صبح کے وقت نبی ﷽ دولہا تھے ، اس کے بعد نبی ﷽ نے لوگوں کو دعوت دی ، نبی ﷽ کے ساتھ کچھ لوگ وہیں بیٹھ رہے اور کافی دیر تک بیٹھے رہے ، حتیٰ کہ نبی ﷽ خود ہی اٹھ کر باہر چلے گئے ، میں بھی باہر چلا گیا تاکہ وہ بھی چلے جائیں ، نبی ﷽ اور میں چلتے ہوئے حضرت عائشہ رضی اللہ عنہا کے حجرے کی چوکھٹ پر جا کر رک گئے ، نبی ﷽ کا خیال تھا کہ شاید اب وہ لوگ چلے گئے ہوں گے ، چنانچہ نبی ﷽ واپس آ گئے ، میں بھی ہمراہ تھا ، لیکن وہ لوگ ابھی تک بیٹھے ہوئے تھے ، دوبارہ اسی طرح ہوا تو اس مرتبہ واقعی وہ لوگ جا چکے تھے ، پھر نبی ﷽ نے اندر داخل ہو کر پردہ لٹکا لیا اور اللہ نے آیت حجاب نازل فرما دی ۔"
"13513","حضرت انس رضی اللہ عنہ سے مروی ہے کہ اللہ تعالیٰ نے نبی ﷽ پر آپ کی وفات سے قبل مسلسل وحی نازل فرمائی ، تاآنکہ آپ کا وصال ہو گیا ، اور سب سے زیادہ وحی اس دن نازل ہوئی جس دن آپ ﷽ کا وصال ہوا ۔"
"13514","حضرت انس رضی اللہ عنہ سے مروی ہے کہ کسی شخص نے نبی ﷽ سے """" کوثر """" کے متعلق پوچھا ، نبی ﷽ نے فرمایا کہ یہ ایک نہر کا نام ہے جو میرے رب نے مجھے عطاء فرمائی ہے ، اس کا پانی دودھ سے زیادہ سفید اور شہد سے زیادہ میٹھا ہو گا ، اور اس میں اونٹوں کی گردنوں کے برابر پرندے ہوں گے ، حضرت عمر رضی اللہ عنہ نے عرض کیا کہ یا رسول اللہ ﷽ ! پھر تو وہ پرندے خوب صحت مند ہوں گے ، نبی ﷽ نے فرمایا انہیں کھانے والے ان سے بھی زیادہ صحت مند ہوں گے ۔"
"13515","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب کسی قوم پر حملے کا ارادہ کرتے تو رات کو حملہ نہ کرتے بلکہ صبح ہونے کا انتظار کرتے ، اگر وہاں سے اذان کی آواز سنائی دیتی تو رک جاتے ، ورنہ حملہ کر دیتے ۔"
"13516","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نماز عصر نبی ﷽ سے زیادہ جلدی پڑھنے والا کوئی نہ تھا ، انصار میں سے دو آدمی ایسے تھے جن کا گھر مسجد نبوی سے سب سے زیادہ دور تھا ، ایک تو حضرت ابولبابہ بن عبدالمنذر رضی اللہ عنہ تھے جن کا تعلق بنو عمرو بن عوف سے تھا اور دوسرے حضرت ابوعبس بن جبر رضی اللہ عنہ تھے جن کا تعلق بنو حارثہ سے تھا ، حضرت ابولبابہ رضی اللہ عنہ کا گھر قباء میں تھا ، اور حضرت ابوعبس رضی اللہ عنہ کا گھر بنو حارثہ میں تھا ، یہ دونوں نبی ﷽ کے ساتھ نماز عصر پڑھتے اور جب اپنی قوم میں واپس پہنچتے تو انہوں نے اب تک نماز عصر نہ پڑھی ہوتی تھی کیونکہ نبی ﷽ اسے جلدی پڑھ لیا کرتے تھے ۔"
"13517","زیاد بن ابی زیاد رحمۃ اللہ کہتے ہیں کہ ایک دفعہ میں اور عمر ظہر کی نماز پڑھ کر فارغ ہوئے ، یہ نماز ہشام بن اسماعیل نے لوگوں کو پڑھائی تھی ، کہ اس وقت مدینے کے گورنر وہی تھے ، نماز پڑھ کر ہم عمرو بن عبداللہ کی مزاج پرسی کے لئے گئے ، وہاں ہم بیٹھے نہیں ، صرف کھڑے کھڑے ہی ان کا حال دریافت کیا ، پھر حضرت انس رضی اللہ عنہ کی خدمت میں حاضر ہوئے ، ان کا گھر حضرت ابوطلحہ رضی اللہ عنہ کے گھر کے ساتھ تھا ، ابھی ہم وہاں جا کر بیٹھے ہی تھے کہ ایک باندی ان کے پاس آئی اور کہنے لگی کہ اے ابوحمزہ ! نماز کا وقت ہو گیا ہے ، ہم نے پوچھا کہ اللہ تعالیٰ کی رحمتیں آپ پر نازل ہوں ، کون سی نماز آ انہوں نے فرمایا نماز عصر ، ہم نے عرض کیا کہ ہم تو ظہر کی نماز ابھی پڑھ کر آئے ہیں ، انہوں نے فرمایا تم نے نماز کو چھوڑ دیا یہاں تک کہ تم نے اسے بھلا دیا ، میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ مجھے اور قیامت کو ان دو انگلیوں کی طرح ایک ساتھ بھیجا گیا ہے ، یہ کہہ کر اپنی شہادت والی اور درمیان والی انگلی سے اشارہ کرتے ہوئے اسے دراز کیا ۔"
"13518","حدیث نمبر + 4683< , اس دوسری سند سے بھی مروی ہے ۔"
"13519","[Darussalam 13485] حضرت انس رضی اللہ تعالی عنہ سے مروی ہے کہ کسی شخص نے نبی صلی اللہ علیہ وآلہ وسلم سے |"" کوثر |"" کے متعلق پوچھا، آگے زہری کی حدیث بیان کی"
"13520","ہمارے پاس دستیاب نسخے میں یہاں صرف لفظ """" حدثنا """" لکھا ہوا ہے ۔"
"13521","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے قبرستان جانے ، تین دن کے بعد قربانی کا گوشت کھانے اور دباء ، نقیر ، حنتم اور مزفت میں نبیذ پینے سے منع فرمایا تھا ، پھر کچھ عرصہ گذرنے کے بعد فرمایا کہ میں نے پہلے تمہیں تین چیزوں سے منع کیا تھا ، اب ان کے بارے میں میری رائے واضح ہو گئی ہے ، میں نے تمہیں قبرستان جانے سے منع کیا تھا ، اب میری رائے یہ ہوئی ہے کہ اس سے دل نرم ہوتے ہیں ، آنکھیں آنسو بہاتی ہیں ، اور آخرت کی یاد تازہ ہوتی ہے ، اس لئے قبرستان جایا کرو ، لیکن بے ہودہ گوئی مت کرنا ، اسی طرح میں نے تمہیں تین دن کے بعد قربانی کا گوشت کھانے سے منع کیا تھا ، اب میری رائے یہ ہوئی ہے کہ لوگ اپنے مہمانوں کو یہ گوشت تحفے کے طور پر دیتے ہیں اور غائبین کے لئے محفوظ کر کے رکھتے ہیں ، اس لئے تم جب تک چاہو ، اسے رکھ سکتے ہو ، نیز میں نے تمہیں ان برتنوں میں نبیذ پینے سے منع کیا تھا ، اب تم جس برتن میں چاہو ، پی سکتے ہو ، البتہ کوئی نشہ آور چیز مت پینا ، اب جو چاہے وہ اپنے مشکیزے کا منہ گناہ کی چیز پر بند کر لے ۔"
"13522","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ظہر کی نماز مسجد نبوی میں چار رکعت کے ساتھ پڑھی اور نماز عصر ذوالحلیفہ میں پہنچ کر دو رکعتوں میں پڑھائی ، اس وقت ہر طرف امن و امان تھا ، حجۃ الوداع میں تو کسی قسم کا کوئی خوف نہ تھا ۔"
"13523","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم لوگ نبی ﷽ کے ساتھ نماز جمعہ پڑھتے اور اس کے بعد آرام گاہ میں پہنچ کر قیلولہ کرتے تھے ۔"
"13524","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کا وقت قریب آ گیا ، اس وقت نبی ﷽ اور ازواجْ مطہرات کے درمیان کچھ تلخی ہو رہی تھی ، اور ازواجْ مطہرات ایک دوسرے کا دفاع کر رہی تھیں ، اسی اثناء میں حضرت ابوبکر صدیق رضی اللہ عنہ تشریف لے آئے اور کہنے لگے یا رسول اللہ ﷽ ! ان کے منہ میں مٹی ڈالیے اور نماز کے لیے باہر چلیے ۔"
"13525","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب رات کا کھانا سامنے آ جائے اور نماز کھڑی ہو جائے تو پہلے کھانا کھا لو ۔"
"13526","حضرت انس رضی اللہ عنہ سے مروی ہے کہ اکیدر دومہ نے نبی ﷽ کی خدمت میں ایک ریشمی جوڑا ہدیہ کے طور پر بھیجا ، میں نے دیکھا ہے کہ لوگ اسے اپنے ہاتھوں سے چھونے اور اس کی خوبصورتی پر تعجب کرنے لگے ، نبی ﷽ نے فرمایا کیا تمہیں اس پر تعجب ہو رہا ہے آ اس ذات کی قسم جس کے دست قدرت میں محمد ﷽ کی جان ہے سعد کے رومال """" جو انہیں جنت میں دیئے گئے ہیں """" وہ اس سے بہتر اور عمدہ ہیں ۔"
"13527","اخشن سدوسی رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ میں حضرت انس رضی اللہ عنہ کی خدمت میں حاضر ہوا ، انہوں نے فرمایا کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے اس ذات کی قسم جس کے دست قدرت میں میری جان ہے ، اگر تم اتنے گناہ کر لو کہ تمہارے گناہوں سے زمین و آسمان کے درمیان ساری فضا بھر جائے ، پھر تم اللہ تعالیٰ سے معافی مانگو تو وہ تمہیں پھر بھی معاف کر دے گا ، اس ذات کی قسم جس کے دست قدرت میں محمد + ﷽ , کی جان ہے ، اگر تم گناہ نہ کرو تو اللہ ایک ایسی قوم کو لے آئے گا جو گناہ کرے گی ، پھر اللہ سے معافی مانگے گی اور اللہ اسے معاف کر دے گا ۔"
"13528","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب آیت حجاب نازل ہو گئی تب بھی میں حسب سابق ایک مرتبہ نبی ﷽ کے گھر میں داخل ہونے لگا ، تو نبی ﷽ نے فرمایا بیٹا ! پیچھے رہو + اجازت لے کر اندر آا ,"
"13529","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا دجال آئے گا تو مدینہ کے ایک جانب پہنچ کر اپنا خیمہ لگائے گا ، اس وقت مدینہ منورہ میں تین زلزلے آئیں گے اور ہر کافر اور منافق مرد و عورت مدینہ سے نکل کر دجال سے جا ملے گا ۔"
"13530","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا حوض کوثر پر سونے چاندی کے آبخورے آسمان کے ستاروں سے بھی زیادہ ہوں گے ۔"
"13531","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ کے پاس ایک مرتبہ وہ جو کی روٹی اور پرانا روغن لے کر آئے تھے اور میں نے ایک دن انہیں یہ فرماتے ہوئے سنا کہ آج شام کو آل محمد + ﷽ , کے پاس غلے یا گندم کا ایک صاع بھی نہیں ہے ، اس وقت نبی ﷽ کی نو ازواج مطہرات تھیں ۔ اور جناب رسول اللہ ﷽ کی زرہ ایک یہودی کے پاس مدینہ منورہ میں گروی رکھی ہوئی تھی ، نبی ﷽ نے اس سے چند مہینوں کے لئے جو لیے تھے اور اسے چھڑانے کے لئے نبی ﷽ کے پاس کچھ نہ تھا ۔"
"13532","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اگر ابن آدم کے پاس مال سے بھری ہوئی دو وادیاں بھی ہوتیں تو وہ تیسری کی تمنا کرتا اور ابن آدم کا پیٹ صرف قبر کی مٹی ہی بھر سکتی ہے ، اور جو توبہ کرتا ہے ، اللہ اس کی توبہ قبول فرما لیتا ہے ۔"
"13533","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے مدینہ منورہ کو اس جگہ سے اس جگہ تک حرم قرار دیا تھا اور فرمایا تھا جو شخص یہاں کوئی بدعت ایجاد کرے یا کسی بدعتی کو ٹھکانہ دے ، اس پر اللہ ، فرشتوں اور تمام لوگوں کی لعنت ہے یہاں کے درخت نہ کاٹے جائیں ۔"
"13534","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے مسجد میں قبلہ کی جانب ناک کی ریزش لگی ہوئی دیکھی تو اسے اپنے ہاتھ سے صاف کر دیا ۔"
"13535","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ تعالیٰ جب کسی بندہ مسلم کو جسمانی طور پر کسی بیماری میں مبتلاء کرتا ہے تو فرشتوں سے کہہ دیتا ہے کہ یہ جتنے نیک کام کرتا ہے ان کا ثواب برابر لکھتے رہو ، پھر اگر اسے شفاء مل جائے تو اللہ اسے دھو کر پاک صاف کر چکا ہوتا ہے اور اگر اسے اپنے پاس واپس بلا لے تو اس کی مغفرت کر دیتا ہے اور اس پر رحم فرماتا ہے ۔"
"13536","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک خاتون سے نکاح کیا اور لوگوں کو کھانے کی دعوت پر بلایا ۔"
"13537","حضرت انس رضی اللہ عنہ سے مروی ہے کہ بعض اوقات ماذن اقامت کہتا ، نبی ﷽ مسجد میں داخل ہوتے تو سامنے سے ایک آدمی اپنے کسی کام سے نبی ﷽ کے پاس آ جاتا ، نبی ﷽ اس کے ساتھ کھڑے ہو جاتے ، حتیٰ کہ اکثر لوگوں کے سر اونگھ سے ہلنے لگتے ۔"
"13538","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب کسی ٹیلے پر یا بلند جگہ پر چڑھتے تو یوں کہتے کہ اے اللہ ! ہر بلندی پر تیری بلندی ہے اور ہر حال میں تیری تعریف ہے ۔"
"13539","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اپنی نو ازواج مطہرات کے پاس چاشت کے وقت تشریف لے جایا کرتے تھے ۔"
"13540","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت صفیہ رضی اللہ عنہا بنت حیی کو آزاد کر دیا اور ان کی آزادی ہی کو ان کا مہر قرار دے دیا ۔"
"13541","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ اپنے گھر میں بیٹھے ہوئے تھے کہ ایک آدمی آ کر کسی سوراخ سے اندر جھانکنے لگا ، نبی ﷽ نے اپنے ہاتھ میں پکڑی ہوئی کنگھی لے کر اس کی طرف قدم بڑھائے ، تو وہ پیچھے ہٹنے لگا ، ایسا محسوس ہوتا تھا کہ نبی ﷽ وہ کنگھی اسے دے ماریں گے ۔"
"13542","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے + حجۃ الوداع کے موقع پر , جب حلاق سے سر منڈوانے کا ارادہ کیا تو حضرت ابوطلحہ رضی اللہ عنہ نے سر کے ایک حصے کے بال اپنے ہاتھوں میں لے لیے ، پھر وہ بال ام سلیم اپنے ساتھ لے گئیں اور وہ انہیں اپنے خوشبو میں ڈال کر ہلایا کرتی تھیں ۔"
"13543","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے حضرت ام سلیم رضی اللہ عنہا کے گھر میں نماز پڑھائی اور ام سلیم اور ام حرام ہمارے پیچھے کھڑی تھیں اور غالباَ یہ بھی فرمایا کہ مجھے اپنی دائیں جانب کھڑا کر لیا ۔"
"13544","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ حضرت اسامہ بن زید رضی اللہ عنہ کا سہارا لیے باہر تشریف لائے ، اس وقت آپ ﷽ کے جسم اطہر پر روئی کا کپڑا تھا ، جس کے دونوں کنارے مخالف سمت سے کندھے پر ڈال رکھے تھے ، اور پھر آپ ﷽ نے لوگوں کو نماز پڑھائی ۔"
"13545","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قیامت کے دن اہل جنت میں سے ایک آدمی کو لایا جائے گا ، اللہ تعالیٰ اس سے پوچھے گا کہ اے ابن آدم ! تو نے اپنا ٹھکانہ کیسا پایا آ وہ جواب دے گا پروردگار ! بہترین ٹھکانہ پایا ، اللہ تعالیٰ فرمائے گا کہ مانگ اور تمنا ظاہر کر ، وہ عرض کرے گا کہ میری درخواست اور تمنا تو صرف اتنی ہی ہے کہ آپ مجھے دنیا میں واپس بھیج دیں اور میں دسیوں مرتبہ آپ کی راہ میں شہید ہو جااں ، کیونکہ وہ شہادت کی فضیلت دیکھ چکا ہو گا ۔ پھر ایک جہنمی کو لایا جائے گا اور اللہ اس سے پوچھے گا کہ اے ابن آدم ! تو نے اپنا ٹھکانہ کیسا پایا آ وہ کہے گا پروردگار ! بدترین ٹھکانہ ، اللہ فرمائے گا اگر تیرے پاس روئے زمین کی ہر چیز موجود ہو تو کیا وہ سب کچھ اپنے فدیے میں دے دے گا آ وہ کہے گا ہاں ! اللہ فرمائے گا کہ تو جھوٹ بولتا ہے ، میں نے تو تجھ سے دنیا میں اس سے بھی ہلکی چیز کا مطالبہ کیا تھا ، لیکن تو نے اسے پورا نہ کیا چنانچہ اسے جہنم میں لوٹا دیا جائے گا ۔"
"13546","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ روانہ ہوئے ، ان کے ہمراہ حضرات شیخین رضی اللہ عنہم اور کچھ دیہاتی لوگ بھی تھے ، یہاں تک کہ نبی ﷽ ہمارے گھر میں داخل ہو گئے ، ہم نے ایک پالتو بکری کا دودھ دوہا اور گھر کے کنوئیں میں سے پانی لے کر اس میں ملایا اور نبی ﷽ کی خدمت میں پیش کر دیا ، نبی ﷽ کی دائیں جانب ایک دیہاتی تھا ، اور بائیں جانب حضرت صدیق اکبر رضی اللہ عنہ تھے ، حضرت عمر رضی اللہ عنہ سامنے بیٹھے ہوئے تھے ، نبی ﷽ جب اسے نوش فرما چکے تو حضرت عمر رضی اللہ عنہ نے عرض کیا کہ یہ ابوبکر کو دے دیجئے ، لیکن نبی ﷽ نے دودھ کا وہ برتن دیہاتی کو دے دیا اور فرمایا پہلے دائیں ہاتھ والے کو ، پھر اس کے بعد والے کو ، حضرت انس رضی اللہ عنہ فرماتے ہیں کہ یہی سنت ہے ۔"
"13547","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"13548","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا میں جنت میں داخل ہوا تو اپنے آگے کسی کی آہٹ سنی ، دیکھا تو وہ رمیصاء بنت ملحان تھیں جو کہ حضرت انس رضی اللہ عنہ کی والدہ تھیں ۔"
"13549","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا شب معراج میں ایسے لوگوں کے پاس سے گذرا جن کے منہ آگ کی قینچیوں سے کاٹے جا رہے تھے ، میں نے پوچھا یہ کون لوگ ہیں آ بتایا گیا کہ یہ دنیا کے خطباء ہیں ، جو لوگوں کو نیکی کا حکم دیتے تھے اور اپنے آپ کو بھول جاتے تھے اور کتاب کی تلاوت کرتے تھے ، کیا یہ سمجھتے نہ تھے ۔"
"13550","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جب اللہ نے حضرت آدم علیہ السلام کا پتلا تیار کیا تو کچھ عرصے تک اسے یونہی رہنے دیا ، شیطان اس پتلے کے اردگرد چکر لگاتا تھا اور اس پر غور کرتا تھا ، جب اس نے دیکھا کہ اس مخلوق کے جسم کے درمیان میں پیٹ ہے تو وہ سمجھ گیا کہ یہ مخلوق اپنے اوپر قابو نہ رکھ سکے گی ۔"
"13551","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا بیٹھ کر نماز پڑھنے کا ثواب کھڑے ہو کر پڑھنے سے آدھا ہے ۔"
"13552","حضرت انس رضی اللہ عنہ سے مروی ہے کہ فتح مکہ کے دن نبی ﷽ جب مکہ مکرمہ میں داخل ہوئے تو آپ ﷽ نے خود پہن رکھا تھا ، کسی شخص نے آ کر بتایا کہ ابن خطل خانہ کعبہ کے پردوں کے ساتھ چمٹا ہوا ہے ، نبی ﷽ نے فرمایا پھر بھی اسے قتل کر دو ۔"
"13553","حضرت انس رضی اللہ عنہ سے نبی ﷽ کے حلیہ مبارک کے متعلق مروی ہے کہ نبی ﷽ درمیانے قد کے تھے ، آپ ﷽ کا قد نہ بہت زیادہ چھوٹا تھا اور نہ بہت زیادہ لمبا ، آپ ﷽ کی پیشانی روشن تھی ، رنگ گندمی تھا اور نہ ہی بالکل سفید ، بال ہلکے گھنگھریالے تھے ، مکمل سیدھے تھے اور نہ بہت زیادہ گھنگھریالے ، چالیس برس کی عمر میں مبعوث ہوئے ، دس سال مکہ مکرمہ میں قیام فرمایا ، دس سال مدینہ منورہ میں رہائش پذیر رہے اور ساٹھ سال کی عمر میں دنیا سے رخصت ہو گئے ، آپ ﷽ کے سر اور ڈاڑھی میں بیس بال بھی سفید نہ تھے ۔"
"13554","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا میری امت کی ایک جماعت اس سطح سمندر پر سوار ہو کر + جہاد کے لئے , جائے گی ، وہ لوگ ایسے محسوس ہوں گے جیسے تختوں پر بادشاہ بیٹھے ہوں ۔"
"13555","محمد بن ابی بکر کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ عرفہ کے دن آپ لوگ کیا کر رہے تھے آ انہوں نے فرمایا کہ نبی ﷽ کے ساتھ ہم میں سے کچھ لوگ تہلیل کہہ رہے تھے ، ان پر بھی کوئی نکیر نہ ہوتی تھی اور بعض تکبیر کہہ رہے تھے اور ان پر بھی کوئی نکیر نہ کی گئی ۔"
"13556","حضرت انس رضی اللہ عنہ کہتے ہیں کہ میں نے اس دن سے زیادہ روشن اور حسین دن کوئی نہیں دیکھا جب نبی ﷽ مدینہ منورہ میں داخل ہوئے تھے ، اور میں نے نبی ﷽ کی دنیا سے رخصتی کا دن بھی پایا ہے ، اور اس دن سے زیادہ تاریک اور قبیح دن کوئی نہیں دیکھا ۔"
"13557","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ سے زیادہ ہلکی اور مکمل نماز کسی امام کے پیچھے نہیں پڑھی ، بعض اوقات نبی ﷽ کسی بچے کے رونے کی آواز سن کر نماز مختصر کر دیتے تھے ، اس اندیشے سے کہ کہیں اس کی ماں پریشان نہ ہو ۔"
"13558","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ یہ دعاء فرمایا کرتے تھے کہ اے اللہ ! میں غم ، پریشانی ، سستی ، بخل ، بزدلی ، بڑھاپے ، قرض ملبے اور دشمن کے غلبے سے آپ کی پناہ میں آتا ہوں ۔"
"13559","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ خیبر سے واپس آ رہے تھے ، جب احد پہاڑ نظر آیا تو فرمایا کہ یہ پہاڑ ہم سے محبت کرتا ہے اور ہم اس سے محبت کرتے ہیں ، پھر جب مدینہ کے قریب پہنچے تو فرمایا اے اللہ ! میں اس کے دونوں پہاڑوں کے درمیانی جگہ کو حرام قرار دیتا ہوں جیسے حضرت ابراہیم علیہ السلام نے مکہ کو حرم قرار دیا تھا ۔"
"13560","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ رات کو بلا اطلاع سفر سے واپسی پر اپنے گھر نہیں آتے تھے ، بلکہ صبح یا دوپہر کو تشریف لاتے تھے ۔"
"13561","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نبی ﷽ نماز سے فارغ ہو کر ہماری طرف متوجہ ہوئے اور فرمایا اس ذات کی قسم جس کے دست قدرت میں محمد ﷽ کی جان ہے ، جو میں دیکھ چکا ہوں ، اگر تم نے وہ دیکھا ہوتا تو تم بہت تھوڑا ہنستے اور کثرت سے رویا کرتے ، صحابہ رضی اللہ عنہم نے پوچھا یا رسول اللہ ﷽ ! آپ نے کیا دیکھا ہے آ فرمایا میں نے اپنی آنکھوں سے جنت اور جہنم کو دیکھا ہے اور نبی ﷽ نے انہیں نماز کی ترغیب دیتے ہوئے رکوع و سجود میں اپنے سے آگے بڑھنے ، نیز ان کے نماز سے فارغ ہونے سے قبل لوگوں کو نماز سے فارغ ہونے کی ممانعت کی اور فرمایا میں تمہیں اپنے آگے سے بھی دیکھتا ہوں اور پیچھے سے بھی ۔"
"13562","علی بن زید کہتے ہیں کہ مصعب بن زبیر کو انصار کے ایک سردار سے کوئی ایسی چیز پہنچی جس کی بناء پر مصعب نے اس سے سمجھنے کا ارادہ کر لیا ، اسی اثناء میں حضرت انس رضی اللہ عنہ وہاں تشریف لے آئے اور کہنے لگے کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ انصار سے اچھا سلوک کرنے کی وصیت پر عمل کرو ، ان کی نیکوں کی نیکی قبول کرو ، اور ان کے گناہگاروں سے درگذر کیا کرو ، یہ سن کر مصعب نے اپنے آپ کو تخت پر گرا لیا اور اپنے رخسار کو تکیے سے لگا لیا اور کہنے لگا کہ نبی ﷽ کا حکم سر آنکھوں پر ، اور اسے یہ کہہ کر چھوڑ دیا ۔"
"13563","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک شخص نے نبی ﷽ کو مخاطب کر کے کہا اے ہمارے سردار ابن سردار ، اے ہمارے خیر ابن خیر ! نبی ﷽ نے فرمایا لوگو ! تقویٰ کو اپنے اوپر لازم کر لو ، شیطان تم پر حملہ نہ کر دے ، میں صرف محمد بن عبداللہ ہوں ، اللہ کا بندہ اور اس کا پیغمبر ہوں ، بخدا ! مجھے یہ چیز پسند نہیں ہے کہ تم مجھے میرے مرتبے سے """" جو اللہ کے یہاں ہے """" بڑھا چڑھا کر بیان کرو ۔"
"13564","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"13565","حضرت انس رضی اللہ عنہ سے مروی ہے کہ کچھ یہودی ایک مرتبہ نبی ﷽ کی خدمت میں حاضر ہوئے اور سلام کرتے ہوئے ®السام علیکم¾ کہا ، نبی ﷽ نے بھی فرمایا ®السام علیکم¾ حضرت عائشہ رضی اللہ عنہا نے پیچھے سے یہودیوں کا یہ جملہ سن کر فرمایا اے بندروں اور خنزیروں کے بھائیو ! سام + موت , اور اللہ کی لعنت و غضب تم ہی پر نازل ہو ، نبی ﷽ نے حضرت عائشہ رضی اللہ عنہا کو سکون کی تلقین کی ، انہوں نے عرض کیا یا رسول اللہ ! آپ نے سنا نہیں کہ انہوں نے کیا کہا ہے آ نبی ﷽ نے فرمایا عائشہ ! میں نے انہیں جو جواب دیا ہے ، کیا تم نے نہیں سنا آ نرمی جس چیز میں بھی شامل ہو جائے ، وہ اسے باعث زینت بنا دیتی ہے اور جس چیز سے چھین لی جائے اسے عیب دار بنا دیتی ہے ۔"
"13566","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ہم نبی ﷽ کے ساتھ سفر میں تھے ، نبی ﷽ نے کان لگا کر سنا تو ایک آدمی کے اللہ اکبر ، اللہ اکبر کہنے کی آواز سنائی دی ، نبی ﷽ نے فرمایا فطرت سلیمہ پر ہے ، پھر جب اس نے اشہد ان ®الا الہ الا اللہ¾ کہا تو فرمایا کہ یہ جہنم کی آگ سے نکل گیا ۔"
"13567","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کو راستے میں کھجور پڑی ہوئی ملتی اور انہیں یہ اندیشہ نہ ہوتا کہ یہ صدقہ کی ہو گی تو وہ اسے کھا لیتے تھے ۔"
"13568","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے صحابہ رضی اللہ عنہم کے ایک گروہ میں سے ایک مرتبہ کسی نے یہ کہا کہ میں کبھی شادی نہیں کروں گا ، دوسرے نے کہہ دیا کہ میں ساری رات نماز پڑھا کروں گا اور سونے سے بچوں گا ، اور تیسرے نے کہہ دیا کہ میں ہمیشہ روزے رکھا کروں گا ، کبھی ناغہ نہیں کروں گا ، نبی ﷽ کو جب یہ بات معلوم ہوئی تو آپ ﷽ نے فرمایا لوگوں کو کیا ہو گیا ہے کہ ایسی ایسی باتیں کرتے ہیں ، میں تو روزہ بھی رکھتا ہوں اور ناغہ بھی کرتا ہوں ، نماز بھی پڑھتا ہوں اور سوتا بھی ہوں ، اور عورتوں سے شادی بھی کرتا ہوں ، اب جو شخص میری سنت سے اعراض کرتا ہے ، وہ مجھ سے نہیں ہے ۔"
"13569","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک شخص نبی ﷽ کی مجلس میں بیٹھا ہوا تھا کہ وہاں سے ایک آدمی کا گذر ہوا ، بیٹھے ہوئے آدمی نے کہا یا رسول اللہ ﷽ ! میں اس شخص سے محبت کرتا ہوں ، نبی ﷽ نے اس سے فرمایا کیا تم نے اسے یہ بات بتائی بھی ہے آ اس نے کہا نہیں ، نبی ﷽ نے فرمایا پھر جا کر اسے بتا دو ، اس پر وہ آدمی کھڑا ہوا اور جا کر اس سے کہنے لگا کہ بھائی ! میں اللہ کی رضا کے لئے آپ سے محبت کرتا ہوں ، اس نے جواب دیا کہ جس ذات کی خاطر تم مجھ سے محبت کرتے ہو ، وہ تم سے محبت کرے ۔"
"13570","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو بارش کے لئے دعاء کرتے ہوئے دیکھا کہ وہ ہتھیلیوں کا اوپر والا حصہ آسمان کی جانب کر کے ہاتھ پھیلا کر دعا کر رہے ہیں ۔"
"13571","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی جب بھی نبی ﷽ کو ملتا تو نبی ﷽ اس سے دریافت فرماتے کہ تمہارا کیا حال ہے آ اور وہ ہمیشہ یہی جواب دیتا کہ الحمدللہ ! خیریت سے ہوں ، نبی ﷽ اسے جواباَ فرما دیتے کہ اللہ تمہیں خیریت ہی سے رکھے ، ایک دن جب نبی ﷽ کی اس سے ملاقات ہوئی تو آپ ﷽ نے حسب معمول اس سے پوچھا کہ تمہارا کیا حال ہے آ اس نے جواب دیا کہ خیریت سے ہوں بشرطیکہ شکر کروں ، اس پر نبی ﷽ خاموش ہو گئے ۔ اس نے پوچھا کہ اے اللہ کے نبی ! پہلے تو جب آپ مجھ سے میرا حال دریافت کرتے تھے تو مجھے دعاء دیتے تھے کہ اللہ تمہیں خیریت سے رکھے ، آج آپ خاموش ہو گئے آ نبی ﷽ نے فرمایا کہ پہلے میں تم سے سوال کرتا تھا تو تم یہ کہتے تھے کہ الحمدللہ ! خیریت سے ہوں ، اس لئے میں جواباَ کہہ دیتا تھا کہ اللہ تمہیں خیریت سے رکھے ، لیکن آج تم نے کہا کہ """" اگر میں شکر کروں """" تو گویا تمہیں شک ہو گیا اس لئے میں خاموش ہو گیا ۔"
"13572","حضرت انس رضی اللہ عنہ سے مروی ہے کہ پردہ کا حکم جب نازل ہوا ، اس وقت کی کیفیت تمام لوگوں میں سب سے زیادہ مجھے معلوم ہے ۔ نبی ﷽ نے حضرت زینب رضی اللہ عنہا کے ساتھ نکاح فرمایا ، اس کے بعد نبی ﷽ نے بکری ذبح کر کے لوگوں کو دعوت دی ، انہوں نے آ کر کھانا کھایا اور بیٹھ کر باتیں کرتے رہے اور کافی دیر تک بیٹھے رہے ، حتی کہ نبی ﷽ خود ہی اٹھ کر باہر چلے گئے ، میں بھی باہر چلا گیا تاکہ وہ بھی چلے جائیں ، لیکن وہ بیٹھے ہی رہے بار بار ایسا ہی ہوا ، ادھر حضرت زینب رضی اللہ عنہا ایک کونے میں بیٹھی ہوئی تھیں ، نبی ﷽ کو ان سے کچھ کہتے ہوئے حجاب محسوس ہوا ، اس موقع پر یہ آیت نازل ہوئی کہ اے اہل ایمان ! پیغمبر کے گھر میں اس وقت تک داخل نہ ہوا کرو جب تک تمہیں کھانے کے لئے بلایا نہ جائے ، نیز اس کے پکنے کا انتظار نہ کیا کرو ، البتہ جب تمہیں بلایا جائے تو چلے جاا ۔۔۔۔۔۔۔۔ پھر نبی ﷽ کے حکم پر پردہ کرا دیا گیا ۔"
"13573","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ بارش کے ذمے دار فرشتے نے اللہ تعالیٰ سے نبی ﷽ کی خدمت میں حاضر ہونے کی اجازت چاہی ، اللہ تعالیٰ نے اسے اجازت دے دی ، نبی ﷽ نے اس موقع پر حضرت ام سلمہ رضی اللہ عنہا سے فرمایا کہ دروازے پر اس چیز کا خیال رکھو کہ ہمارے پاس کوئی اندر نہ آنے پائے ، تھوڑی دیر میں حضرت امام حسین رضی اللہ عنہ آئے اور گھر میں داخل ہونا چاہا ، حضرت ام سلمہ رضی اللہ عنہا نے انہیں روکا تو وہ کود کر اندر داخل ہو گئے اور جا کر نبی ﷽ کی پشت پر ، مونڈھوں اور کندھوں پر بیٹھنے لگے ، اس فرشتے نے نبی ﷽ سے پوچھا کہ کیا آپ کو اس سے محبت ہے آ نبی ﷽ نے فرمایا ہاں ! تو فرشتے نے کہا کہ یاد رکھئے ! آپ کی امت اسے قتل کر دے گی ، اگر آپ چاہیں تو میں آپ کو وہ جگہ بھی دکھا سکتا ہوں جہاں یہ شہید ہوں گے ، یہ کہہ کر فرشتے نے اپنا ہاتھ مارا تو اس کے ہاتھ میں سرخ رنگ کی مٹی آ گئی ، حضرت ام سلمہ رضی اللہ عنہا نے وہ مٹی لے کر اپنے دوپٹے میں باندھ لی ۔"
"13574","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے مدینہ منورہ کو اس جگہ سے اس جگہ تک حرم قرار دیا تھا اور فرمایا تھا جو شخص یہاں کوئی بدعت ایجاد کرے یا کسی بدعتی کو ٹھکانہ دے ، اس پر اللہ ، فرشتوں اور تمام لوگوں کی لعنت ہے اور اللہ تعالی اس کا کوئی فرض یا نفل قبول نہیں کرے گا ۔"
"13575","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص اسلام کی حالت میں فوت ہو جائے اور اس کے قریبی پڑوسیوں میں سے چار گھروں کے لوگ اس کے حق میں بہتری کی گواہی دے دیں ، تو اللہ تعالیٰ فرماتا ہے کہ میں نے اس کے متعلق تمہارے علم کو قبول کر لیا اور جو تم نہیں جانتے ، اسے معاف کر دیا ۔"
"13576","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا لوگوں میں سے کچھ اہل اللہ ہوتے ہیں ، قرآن والے ، اللہ کے خاص لوگ اور اہل اللہ ہوتے ہیں ۔"
"13577","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ اپنے گھر میں بیٹھے ہوئے تھے کہ ایک آدمی آ کر کسی سوراخ سے اندر جھانکنے لگا ، نبی ﷽ نے اپنے ہاتھ میں پکڑی ہوئی کنگھی لے کر اس کی طرف قدم بڑھائے ، تو وہ پیچھے ہٹنے لگا ، ایسا محسوس ہوتا تھا کہ نبی ﷽ وہ کنگھی اسے دے ماریں گے ۔"
"13578","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے مجھے """" اے دو کانوں والے """" کہہ کر مخاطب فرمایا تھا ۔"
"13579","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت صفیہ رضی اللہ عنہا بنت حیی کو آزاد کر دیا اور ان کی آزادی ہی کو ان کا مہر قرار دے دیا ۔"
"13580","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے ہمیں نماز پڑھائی اس وقت ام سلیم اور ام حرام ہمارے پیچھے چٹائی پر تھیں ۔"
"13581","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ام سلیم رضی اللہ عنہا نے مجھ سے فرمایا کہ نبی ﷽ کے پاس جا کر کہو کہ اگر آپ ہمارے ساتھ کھانا کھانا چاہتے ہیں تو آ جائیں ، میں نے نبی ﷽ کی خدمت میں حاضر ہو کر پیغام پہنچا دیا ، نبی ﷽ نے فرمایا کیا اپنے پاس بیٹھے ہوئے لوگوں کو بھی آ میں نے کہہ دیا جی ہاں ! نبی ﷽ نے صحابہ رضی اللہ عنہم سے فرمایا اٹھو ، ادھر میں جلدی سے گھر پہنچا اس وقت میں نبی ﷽ کے ساتھ بہت سے لوگ ہونے کی وجہ سے گھبرایا ہوا تھا ، حضرت ام سلیم رضی اللہ عنہا نے پوچھا انس ! تمہیں کیا ہوا آ اسی وقت نبی ﷽ بھی گھر میں تشریف لے آئے اور حضرت ام سلیم رضی اللہ عنہا سے پوچھا کہ تمہارے پاس گھی ہے آ انہوں نے اثبات میں جواب دیا اور کہا کہ میرے پاس گھی کا ڈبہ ہے جس میں تھوڑا سا گھی موجود ہے ، نبی ﷽ نے فرمایا وہ میرے پاس لے آا ۔ میں وہ ڈبہ لے کر نبی ﷽ کے پاس آیا ، نبی ﷽ نے اس کا ڈھکن کھولا ، اور بسم اللہ پڑھ کر یہ دعاء کی کہ اے اللہ ! اس میں خوب برکت پیدا فرما ، پھر نبی ﷽ نے حضرت ام سلیم رضی اللہ عنہا سے فرمایا کہ اسے اٹھاا ، انہوں نے اسے اٹھایا تو نبی ﷽ اس میں سے گھی نچوڑنے لگے اور اس دوران بسم اللہ پڑھتے رہے ، اور ایک ہنڈیا کے برابر گھی نکل آیا ، اس سے اسی سے بھی زائد لوگوں نے کھانا کھا لیا لیکن وہ پھر بھی بچ گیا ، جو نبی ﷽ نے حضرت ام سلیم رضی اللہ عنہا کے حوالے کر دیا اور فرمایا کہ خود بھی کھاا اور اپنے پڑوسیوں کو بھی کھلاا ۔"
"13582","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نبی ﷽ کے ہمراہ کسی سفر سے واپس آ رہا تھا ، جب احد پہاڑ نظر آیا تو نبی ﷽ نے فرمایا کہ یہ پہاڑ ہم سے محبت کرتا ہے اور ہم اس سے محبت کرتے ہیں ، پھر جب مدینہ کے قریب پہنچے تو فرمایا اے اللہ ! میں اس کے دونوں پہاڑوں کے درمیانی جگہ کو حرم قرار دیتا ہوں جیسے حضرت ابراہیم علیہ السلام نے مکہ کو حرم قرار دیا تھا ۔ اے اللہ ! ان کے صاع اور مد میں برکت عطاء فرما ۔"
"13583","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے یہ آیت ®ھو اھل التقوی واھل المغفرۃ¾ تلاوت فرمائی اور فرمایا کہ تمہارے رب نے فرمایا ہے ، میں اس بات کا اہل ہوں کہ مجھ سے ڈرا جائے اور میرے ساتھ کسی کو معبود نہ بنایا جائے جو میرے ساتھ کسی کو معبود بنانے سے ڈرتا ہے وہ اس بات کا اہل ہے کہ میں اس کی مغفرت کر دوں ۔"
"13584","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا سحری کھایا کرو ، کیوں کہ سحری میں برکت ہوتی ہے ۔"
"13585","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جو شخص نماز پڑھنا بھول جائے تو جب یاد آئے ، اسے پڑھ لے ۔"
"13586","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اگر ابن آدم کے پاس مال سے بھری ہوئی دو وادیاں بھی ہوتیں تو وہ تیسری کی تمنا کرتا اور ابن آدم کا پیٹ صرف قبر کی مٹی ہی بھر سکتی ہے ، اور جو توبہ کرتا ہے ، اللہ اس کی توبہ قبول فرما لیتا ہے ۔"
"13587","گذشتہ سند ہی سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو مسلمان کوئی کھیت اگاتا ہے ، یا کوئی کھیت اگاتا ہے یا کوئی پودا اگاتا ہے اور اس سے کسی پرندے ، انسان یا درندے کو رزق ملتا ہے تو وہ اس کے لیے صدقہ کا درجہ رکھتا ہے ۔"
"13588","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"13589","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو مسلمان کوئی کھیت اگاتا ہے یا کوئی پودا اگاتا ہے اور اس سے کسی پرندے ، انسان یا درندے کو رزق ملتا ہے تو وہ اس کے لیے صدقہ کا درجہ رکھتا ہے ۔"
"13590","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے غزوہ بدر کے قیدیوں کے متعلق لوگوں سے مشورہ کرتے ہوئے فرمایا کہ اللہ تعالیٰ نے تمہیں ان پر قدرت عطاء فرمائی ہے + اب تمہاری کیا رائے ہے آ , حضرت عمر رضی اللہ عنہ کھڑے ہو کر کہنے لگے یا رسول اللہ ! ان سب کی گردنیں اڑا دیں ، نبی ﷽ نے ان کی بات سے اعراض کر کے دوبارہ فرمایا لوگو ! اللہ نے تمہیں ان پر قدرت عطاء فرمائی ہے ، کل یہ تمہارے ہی بھائی تھے ، حضرت عمر رضی اللہ عنہ نے دوبارہ کھڑے ہو کر عرض کیا یا رسول اللہ ! ان سب کی گردنیں اڑا دیں ، نبی ﷽ نے ان کی بات سے اعراض کر کے تیسری مرتبہ پھر اپنی بات دہرائی ، اس مرتبہ حضرت ابوبکر صدیق رضی اللہ عنہ کھڑے ہوئے اور کہنے لگے یا رسول اللہ ! ہماری رائے یہ ہے کہ آپ انہیں معاف کر کے ان سے فدیہ قبول کر لیں ، یہ سن کر نبی ﷽ کے چہرے سے غم کی کیفیت دور ہو گئی ، اور انہیں معاف کر کے ان سے فدیہ قبول کر لیا ، اس موقع پر یہ آیت نازل ہوئی """" لَوُلَا نْتَابُ مْنُ اللَِيْ سَبَقَ ۔۔۔۔۔۔"""""
"13591","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک کپڑے میں لپٹ کر حضرت ابوبکر صدیق رضی اللہ عنہ کے پیچھے نماز پڑھی تھی ۔"
"13592","ثابت بنانی رحمۃ اللہ کہتے ہیں کہ ہمیں یہ بات معلوم ہوئی ہے کہ نبی ﷽ نے اپنے مرض الوفات میں اپنے جسم مبارک پر ایک کپڑا لپیٹ کر حضرت ابوبکر صدیق رضی اللہ عنہ کی اقتداء میں نماز پڑھی ہے ، پھر نبی ﷽ نے حضرت اسامہ رضی اللہ عنہ کو بلایا اور اپنی پشت کو ان کے سینے سے لگا دیا اور فرمایا اسامہ ! مجھے اٹھاا ۔ راوی یزید کہتے ہیں کہ میری کتاب میں حضرت انس رضی اللہ عنہ کا نام بھی تھا + کہ یہ روایت حضرت انس رضی اللہ عنہ سے مروی ہے , لیکن استاذ صاحب نے اسے منکر قرار دیا اور ثابت ہی کے نام سے اسے محفوظ قرار دیا ۔"
"13593","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب تم میں سے کوئی شخص نماز کے لئے آئے اور نماز کھڑی ہو چکی ہو تو سکون سے چلے ، جتنی نماز مل جائے سو پڑھ لے اور جو رہ جائے اسے قضاء کر لے ۔"
"13594","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے مجھے حلیق نصرانی کے پاس یہ پیغام دے کر بھیجا کہ نبی ﷽ کے پاس وہ کپڑے بھیج دے ، جب گنجائش ہو گی تو نبی ﷽ اس کی قیمت ادا کر دیں گے ، چنانچہ میں نے اس کے پاس جا کر اس سے یونہی کہہ دیا کہ نبی ﷽ نے مجھے تمہارے پاس بھیجا ہے تاکہ تم نبی ﷽ کے پاس کپڑے بھجوا دو جب گنجائش ہو گی تو نبی ﷽ اس کی قیمت ادا کر دیں گے ، اس نے کہا کون سی گنجائش ، کہاں کی گنجائش آ بخدا ! محمد + ﷽ , کے پاس تو ایک بھی بکری یا چرواہا نہیں ہے ، میں یہ سن کر واپس آ گیا ، نبی ﷽ نے مجھے دیکھتے ہی فرمایا دشمن خدا نے جھوٹ بولا ، میں سب سے بہترین خرید و فروخت کرنے والا ہوں ، تم میں سے کوئی شخص کپڑے کی کترنیں جمع کر کے ان کا کپڑا بنا کر پہن لے ، یہ اس سے بہت بہتر ہے کہ کسی امانت میں سے ایسی چیز پر قبضہ کر لے جس کا اسے حق نہ ہو ۔"
"13595","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے حضرت معاذ رضی اللہ عنہ سے فرمایا جو شخص اللہ سے اس حال میں ملاقات کرے کہ وہ اس کے ساتھ کسی کو شریک نہ ٹھہراتا ہو تو وہ جنت میں داخل ہو گا ۔"
"13596","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مسجد نبوی کی جگہ بنو نجار کی تھی ، اس وقت وہاں ایک کھیت ، ایک درخت اور مشرکین کی کچھ قبریں تھیں ، نبی ﷽ نے بنو نجار کے لوگوں کو بلا کر ان سے فرمایا اے بنو نجار ! اپنے اس باغ کی قیمت کا معاملہ میرے ساتھ طے کر لو ، وہ کہنے لگے کہ ہم تو اس کی قیمت اللہ ہی سے لیں گے ، نبی ﷽ کے حکم پر مشرکین کی قبروں کو اکھیڑ دیا گیا ، ویرانہ کو برابر کر دیا گیا ، اور درخت کو کاٹ دیا گیا ، تعمیر مسجد سے قبل جہاں بھی نماز کا وقت آتا ، نبی ﷽ وہیں نماز پڑھ لیتے تھے اور بکریوں کے باڑے میں بھی ، جبکہ تعمیر شروع ہونے کے بعد لوگ نبی ﷽ کو اینٹیں پکڑاتے تھے ، اور نبی ﷽ فرماتے جا رہے تھے کہ اے اللہ ! اصل خیر تو آخرت کی ہے ، اے اللہ ! انصار اور مہاجرین کی نصرت فرما ۔"
"13597","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قیامت کے دن سارے مسلمان اکٹھے ہوں گے ، ان کے دل میں یہ بات ڈالی جائے گی اور وہ کہیں گے کہ اگر ہم اپنے پروردگار کے سامنے کسی کی سفارش لے کر جائیں تو شاید وہ ہمیں اس جگہ سے راحت عطاء فرما دے ، چنانچہ وہ حضرت آدم علیہ السلام کے پاس جائیں گے ، اور ان سے کہیں گے کہ اے آدم ! آپ ابوالبشر ہیں ، اللہ تعالیٰ نے آپ کو اپنے ہاتھ سے پیدا کیا ، اپنے فرشتوں سے آپ کو سجدہ کروایا ، اور آپ کو تمام چیزوں کے نام سکھائے ، لہٰذا آپ ہمارے رب سے سفارش کر دیں کہ وہ ہمیں اس جگہ سے نجات دے دے ۔ حضرت آدم علیہ السلام جواب دیں گے کہ میں تو اس کا اہل نہیں ہوں اور انہیں اپنی لغزش یاد آ جائے گی اور وہ اپنے رب سے حیاء کریں گے اور فرمائیں گے کہ تم حضرت نوح علیہ السلام کے پاس چلے جاا ، کیونکہ وہ پہلے رسول ہیں جنہیں اللہ نے اہل زمین کی طرف بھیجا تھا ، چنانچہ وہ سب لوگ حضرت نوح علیہ السلام کے پاس جائیں گے اور ان سے کہیں گے کہ آپ اپنے پروردگار سے ہماری سفارش کر دیجئے ، وہ جواب دیں گے کہ تمہارا گوہر مقصود میرے پاس نہیں ہے ، اور وہ بغیر علم کے اللہ سے سوال کرنے کی اپنی لغزش کو یاد کر کے فرمائیں گے کہ تم حضرت ابراہیم علیہ السلام کے پاس چلے جاا کیونکہ اللہ نے انہیں اپنا خلیل قرار دیا ہے ۔ چنانچہ وہ سب لوگ حضرت ابراہیم علیہ السلام کے پاس جائیں گے ، لیکن وہ بھی یہی کہیں گے کہ تمہارا گوہر مقصود میرے پاس نہیں ہے ، اور وہ اپنی تین باتوں والی لغزش یاد کریں گے جو بظاہر خلاف حقیقت تھیں کہ میں بیمار ہوں ، ان بتوں کو ان کے سردار نے توڑا ہے ، اور اپنی بیوی کو اپنی بہن قرار دیا تھا ، اور فرمائیں گے کہ البتہ تم حضرت موسیٰ علیہ السلام کے پاس چلے جاا ، کیونکہ اللہ نے ان سے براہ راست کلام فرمایا ہے ، اور انہیں تورات دی تھی ، حضرت موسیٰ علیہ السلام بھی معذرت کر لیں گے کہ میں نے ایک شخص کو ناحق قتل کر دیا تھا البتہ تم حضرت عیسیٰ علیہ السلام کے پاس چلے جاا ، وہ اللہ کے بندے ، اس کے رسول اور اس کا کلمہ اور روح تھے لیکن حضرت عیسیٰ علیہ السلام بھی معذرت کر لیں گے اور فرمائیں گے کہ تم محمد ﷽ کے پاس جاا ، وہ تمہاری سفارش کریں گے ، جن کی اگلی پچھلی لغزشیں اللہ نے معاف فرما دی ہیں ۔ نبی ﷽ فرماتے ہیں کہ لوگ میرے پاس آئیں گے ، میں اپنے پروردگار کے پاس حاضری کی اجازت چاہوں گا جو مجھے مل جائے گی ، میں اپنے رب کو دیکھ کر سجدہ ریز ہو جااں گا ، اللہ جب تک چاہے گا مجھے سجدے ہی کی حالت میں رہنے دے گا ، پھر مجھ سے کہا جائے گا کہ اے محمد ! ﷽ ، سر تو اٹھائیے ، آپ جو کہیں گے اس کی شنوائی ہو گی ، جو مانگیں گے وہ ملے گا اور جس کی سفارش کریں گے قبول کر لی جائے گی ، چنانچہ میں اپنا سر اٹھا کر اللہ کی ایسی تعریف کروں گا جو وہ خود مجھے سکھائے گا ، پھر میں سفارش کروں گا تو اللہ میرے لیے ایک حد مقرر فرما دے گا اور میں انہیں جنت میں داخل کروا کر دوبارہ آاں گا ، تین مرتبہ اسی طرح ہو گا ، چوتھی مرتبہ میں کہوں گا کہ پروردگار ! اب صرف وہی لوگ باقی بچے ہیں جنہیں قرآن نے روک رکھا ہے ، یعنی ان کے لئے جہنم واجب ہو چکی ہے ، پھر قتادہ نے آیت مقام محمود کی تلاوت کر کے اسی کو مقام محمود قرار دیا ۔"
"13598","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا ہر امت کا ایک امین ہوتا ہے اور ابوعبیدہ اس امت کے امین ہیں ۔"
"13599","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے بال کندھوں تک آتے تھے ۔"
"13600","قتادہ رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ نبی ﷽ نے کتنے حج کیے تھے آ انہوں نے فرمایا کہ چار مرتبہ ، ایک عمرہ تو حدیبیہ کے زمانے میں ، دوسرا ذیقعدہ کے مہینے میں مدینہ سے ، تیسرا عمرہ ذیقعدہ ہی کے مہینے میں جعرانہ سے جب آپ ﷽ نے غزوہ حنین کا مال غنیمت تقسیم کیا تھا اور چوتھا عمرہ حج کے ساتھ کیا تھا ۔"
"13601","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ جمعہ کے دن نبی ﷽ سے ایک آدمی نے عرض کیا """" جبکہ نبی ﷽ منبر پر تھے """" کہ یا رسول اللہ ﷽ ! بارش کی دعا کر دیجئے ، نبی ﷽ نے طلب باراں کے حوالے سے دعاء فرمائی ، جس وقت آپ ﷽ نے اپنے دست مبارک بلند کیے تھے ، اس وقت ہمیں آسمان پر کوئی بادل نظر نہیں آ رہا تھا ، اور جب بارش شروع ہوئی تو رکتی ہوئی نظر نہ آئی ، جب اگلا جمعہ ہوا تو اسی نے عرض کیا یا رسول اللہ ﷽ ! بارش رکنے کی دعا کر دیں ، یہ سن کر نبی ﷽ نے اللہ سے دعا کی اور میں نے دیکھا کہ بادل دائیں بائیں چھٹ گئے اور مدینہ کے اندر ایک قطرہ بھی نہیں ٹپک رہا تھا ۔"
"13602","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جب تم میں سے کوئی شخص تھوکنا چاہے تو اپنی دائیں جانب نہ تھوکا کرے بلکہ بائیں جانب یا اپنے پااں کے نیچے تھوکا کرے ۔"
"13603","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے مبارک جوتوں کے دو تسمے تھے ۔"
"13604","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نکاح کرنے کا حکم دیتے اور اس سے اعراض کرنے کی شدید ممانعت فرماتے اور ارشاد فرماتے کہ محبت کرنے والی اور بچوں کی ماں بننے والی عورت سے شادی کیا کرو کہ میں قیامت کے دن دیگر انبیاء + علیہم السلام , پر تمہاری کثرت سے فخر کروں گا ۔"
"13605","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نبی ﷽ کے ساتھ حلقے میں بیٹھا ہوا تھا اور ایک آدمی کھڑا نماز پڑھ رہا تھا ، رکوع و سجود کے بعد جب وہ بیٹھا تو تشہد میں اس نے یہ دعا پڑھی """" اے اللہ ! میں تجھ سے سوال کرتا ہوں کیونکہ تمام تعریفیں تیرے لیے ہی ہیں ، تیرے علاوہ کوئی معبود نہیں ، نہایت احسان کرنے والا ہے ، آسمان و زمین کو بغیر نمونے کے پیدا کرنے والا ہے اے بڑے جلال اور عزت والے ، اے زندگی دینے والے اے قائم رکھنے والے ! میں تجھ ہی سے سوال کرتا ہوں ۔"""" نبی ﷽ نے فرمایا تم جانتے ہو کہ اس نے کیا دعا کی ہے آ صحابہ رضی اللہ عنہم نے عرض کیا اللہ اور اس کے رسول ﷽ ہی زیادہ جانتے ہیں ، نبی ﷽ نے فرمایا اس ذات کی قسم جس کے دست قدرت میں میری جان ہے اس نے اللہ سے اس کے اس اسم اعظم کے ذریعے دعا مانگی ہے کہ جب اس کے ذریعے دعاء مانگی جائے تو اللہ اسے ضرور قبول کرتا ہے اور جب اس کے ذریعے سوال کیا جائے تو وہ ضرور عطاء کرتا ہے ۔"
"13606","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نبی ﷽ نماز سے فارغ ہو کر ہماری طرف متوجہ ہوئے اور فرمایا لوگو ! میں تمہارا امام ہوں ، لہٰذا رکوع ، سجدہ ، قیام ، قعود اور اختتام میں مجھ سے آگے نہ بڑھا کرو ، کیونکہ میں تمہیں اپنے آگے سے بھی دیکھتا ہوں اور پیچھے سے بھی ، اور اس ذات کی قسم جس کے دست قدرت میں میری جان ہے ، جو میں دیکھ چکا ہوں ، اگر تم نے وہ دیکھا ہوتا تو تم بہت تھوڑا ہنستے اور کثرت سے رویا کرتے ، صحابہ رضی اللہ عنہم نے پوچھا یا رسول اللہ ﷽ ! آپ نے کیا دیکھا ہے آ فرمایا میں نے اپنی آنکھوں سے جنت اور جہنم کو دیکھا ہے ۔"
"13607","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے سامنے سے ایک جنازہ گذرا ، لوگوں نے اس کی تعریف کی ، نبی ﷽ نے فرمایا واجب ہو گئی ، پھر دوسرا جنازہ گذرا اور لوگوں نے اس کی مذمت کی ، نبی ﷽ نے فرمایا واجب ہو گئی ، پھر فرمایا تم لوگ زمین میں اللہ کے گواہ ہو ۔"
"13608","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نبی ﷽ کا کاتب تھا ، اس نے سورہ بقرہ اور آل عمران بھی پڑھ رکھی تھی ، نبی ﷽ اسے ®سمیعاَ¾ لکھواتے اور وہ اس کی جگہ ®سمیعاَ بصیراَ¾ لکھ دیتا ، نبی ﷽ فرماتے اس اس طرح لکھو ، لیکن وہ کہتا کہ میں جیسے چاہوں لکھوں ، اسی طرح نبی ﷽ اسے ®علیما¾ لکھواتے تو وہ اس کی جگہ ®علیما حکیما¾ لکھ دیتا ، کچھ عرصے بعد وہ آدمی مرتد ہو کر عیسائی ہو گیا ، اور کہنے لگا کہ میں محمد + ﷽ , کے پاس جو چاہتا تھا لکھ دیتا تھا ، جب وہ آدمی مرا اور اسے دفن کیا گیا تو زمین نے اسے باہر پھینک دیا ۔ حضرت انس رضی اللہ عنہ کہتے ہیں کہ مجھ سے حضرت ابوطلحہ رضی اللہ عنہ نے بیان کیا کہ وہ اس جگہ پر گئے تھے جہاں وہ آدمی مرا تھا ، انہوں نے اسے باہر پڑا ہوا پایا ۔"
"13609","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ حنین کے موقع پر نبی ﷽ نے ابوسفیان ، عیینہ ، اقرع اور سہیل بن عمرو وغیرہ کو مال غنیمت دینا شروع کیا تو انصار کے کچھ لوگ کہنے لگے نبی ﷽ قریش کو دیئے جا رہے ہیں اور ہمیں نظر انداز کر رہے ہیں جبکہ ہماری تلواروں سے ابھی تک ان کے خون کے قطرے ٹپک رہے ہیں ۔ نبی ﷽ کو یہ بات معلوم ہوئی تو آپ ﷽ نے انصاری صحابہ رضی اللہ عنہم کو ایک خیمے میں جمع کیا ، جب وہ بھر گیا تو پوچھا کیا تم میں تمہارے علاوہ کوئی اور بھی ہے آ انہوں نے کہا نہیں ، سوائے ہمارے بھانجے کے ، نبی ﷽ نے فرمایا کسی قوم کا بھانجا ان ہی میں شمار ہوتا ہے ، پھر فرمایا کیا تم نے ایسے ایسے کہا ہے آ انہوں نے اقرار کیا ، نبی ﷽ نے فرمایا تم لوگ جسم کے ساتھ ملا ہوا کپڑا ہو اور لوگ باہر کا کپڑا ہیں ، کیا تم لوگ اس بات پر خوش نہیں ہو کہ لوگ مال و دولت لے کر چلے جائیں اور تم پیغمر خدا کو اپنے خیموں میں لے جاا ، وہ کہنے لگے کیوں نہیں یا رسول اللہ ، پھر نبی ﷽ نے فرمایا اس ذات کی قسم جس کے دست قدرت میں محمد ﷽ کی جان ہے ، اگر لوگ ایک وادی میں چل رہے ہوں اور انصار دوسری گھاٹی میں تو میں انصار کے راستے کو اختیار کروں گا ، انصار میرا پردہ ہیں ، اور اگر ہجرت نہ ہوتی تو میں انصار ہی کا ایک فرد ہوتا ۔"
"13610","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ خیبر کے دن میں حضرت ابوطلحہ رضی اللہ عنہ کے پیچھے سواری پر بیٹھا ہوا تھا اور میرے پااں نبی ﷽ کے پااں کو چھو رہے تھے ، ہم وہاں پہنچے تو سورج نکل چکا تھا اور اہل خیبر اپنے مویشیوں کو نکال کر کلہاڑیاں اور کدالیں لے کر نکل چکے تھے ، ہمیں دیکھ کر کہنے لگے محمد + ﷽ , اور لشکر آ گئے ، نبی ﷽ نے اللہ اکبر کہہ کر فرمایا کہ خیبر برباد ہو گیا ، جب ہم کسی قوم کے صحن میں اترتے ہیں تو ڈرائے ہوئے لوگوں کی صبح بڑی بدترین ہوتی ہے ، اللہ تعالیٰ نے انہیں شکست سے دوچار کر دیا ، وہ مزید کہتے ہیں کہ حضرت صفیہ رضی اللہ عنہا ، """" جو بہت خوبصورت تھیں """" حضرت دحیہ کلبی رضی اللہ عنہ کے حصے میں آئی تھیں ، نبی ﷽ نے سات افراد کے عوض انہیں خرید لیا ، اور خرید کر انہیں حضرت ام سلیم رضی اللہ عنہا کے پاس بھیج دیا ، تاکہ وہ انہیں بنا سنوار کر دلہن بنائیں ، نبی ﷽ نے ان کے ولیمے کے لئے کھجوریں ، پنیر اور گھی جمع کیا ، اس کا حلوہ تیار کیا گیا اور دسترخوان بچھا کر اسے دسترخوان پر رکھا گیا ، لوگوں نے سیراب ہو کر اسے کھایا ، اس دوران لوگ یہ سوچنے لگے کہ نبی ﷽ ان سے نکاح فرمائیں گے یا انہیں باندی بنائیں گے آ لیکن جب نبی ﷽ نے انہیں سواری پر بٹھا کر پردہ کرایا اور انہیں اپنے پیچھے بٹھا لیا تو لوگ سمجھ گئے کہ نبی ﷽ نے ان سے نکاح فرما لیا ہے ۔ مدینہ منورہ کے قریب پہنچ کر لوگ اپنے رواج کے مطابق سواریوں سے کود کر اترنے لگے ، نبی ﷽ بھی اسی طرح اترنے لگے لیکن اونٹنی پھسل گئی اور نبی ﷽ زمین پر گر گئے ، حضرت صفیہ رضی اللہ عنہ بھی گر گئیں ، دیگر ازواج مطہرات دیکھ رہی تھیں ، وہ کہنے لگیں کہ اللہ اس یہودیہ کو دور کرے اور اس کے ساتھ ایسا ایسا کرے ، ادھر نبی ﷽ کھڑے ہوئے اور انہیں پردہ کرایا ، پھر اپنے پیچھے بٹھا لیا ، میں نے پوچھا اے ابوحمزہ ! کیا واقعی نبی ﷽ گر گئے تھے آ انہوں نے فرمایا ہاں اللہ کی قسم ! گر گئے تھے ۔ حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں حضرت زینب رضی اللہ عنہا کے ولیمے میں بھی موجود تھا ، اور اس نکاح کے ولیمے میں نبی ﷽ نے لوگوں کو خوب پیٹ بھر کر روٹی اور گوشت کھلایا ، باقی تو سب لوگ کھا پی کر چلے گئے ، لیکن دو آدمی کھانے کے بعد وہیں بیٹھ کر باتیں کرنے لگے ، یہ دیکھ کر نبی ﷽ خود ہی گھر سے باہر چلے گئے ، آپ ﷽ کے پیچھے پیچھے میں بھی نکل آیا ، نبی ﷽ وقت گذارنے کے لئے باری باری اپنی ازواج مطہرات کے حجروں میں جاتے اور انہیں سلام کرتے ، وہ پوچھتیں کہ یا رسول اللہ ﷽ ! آپ نے اپنی بیوی کو کیسا پایا آ نبی ﷽ فرماتے بہت اچھا ، پھر جب اپنے گھر کے دروازے پر پہنچے تو وہ بیٹھے ہوئے اسی طرح باتیں کر رہے تھے ، انہوں نے جب نبی ﷽ کو واپس آتے ہوئے دیکھا تو کھڑے ہو گئے اور چلے گئے ۔ اب مجھے یاد نہیں کہ میں نے نبی ﷽ کو ان کے جانے کی خبر دی یا کسی اور نے بہرحال ! نبی ﷽ وہاں سے چلتے ہوئے اپنے گھر میں داخل ہو گئے ، میں نے بھی داخل ہونا چاہا تو آپ نے پردہ لٹکا لیا اور آیت حجاب نازل ہو گئی ۔"
"13611","حضرت انس رضی اللہ عنہ سے مروی ہے کہ یہودیوں میں جب کسی عورت کو """" ایام """" آتے تو وہ لوگ ان کے ساتھ نہ کھاتے پیتے تھے اور نہ ایک گھر میں اکٹھے ہوتے تھے ، صحابہ کرام رضی اللہ عنہم نے اس کے متعلق نبی ﷽ سے دریافت کیا تو اللہ تعالیٰ نے یہ آیت نازل فرما دی کہ """" یہ لوگ آپ سے ایام والی عورت کے متعلق سوال کرتے ہیں ، آپ فرما دیجئے کہ """" ایام بذات """" خود بیماری ہے ، اس لئے ان ایام میں عورتوں سے الگ رہو اور پاک ہونے تک ان سے قربت نہ کرو """" یہ آیت مکمل پڑھنے کے بعد نبی ﷽ نے فرمایا صحبت کے علاوہ سب کچھ کر سکتے ہو ، یہودیوں کو جب یہ بات معلوم ہوئی تو وہ کہنے لگے کہ یہ آدمی تو ہر بات میں ہماری مخالفت ہی کرتا ہے ۔ پھر حضرت اسید بن حضیر رضی اللہ عنہ اور عباد بن بشیر رضی اللہ عنہ ، نبی ﷽ کی خدمت میں حاضر ہوئے اور کہنے لگے یا رسول اللہ ﷽ ! یہودی ایسے ایسے کہہ رہے ہیں ، کیا ہم اپنی بیویوں سے قربت بھی نہ کر لیا کریں آ + تاکہ یہودیوں کی مکمل مخالفت ہو جائے , یہ سن کر نبی ﷽ کے روئے انور کا رنگ بدل گیا ، اور ہم یہ سمجھنے لگے کہ نبی ﷽ ان سے ناراض ہو گئے ہیں ، وہ دونوں بھی وہاں سے چلے گئے ، لیکن کچھ ہی دیر بعد نبی ﷽ کے پاس کہیں سے دودھ کا ہدیہ آیا تو نبی ﷽ نے ان دونوں کو بلا بھیجا اور انہیں وہ پلا دیا ، اس طرح ہم سمجھ گئے کہ نبی ﷽ ان سے ناراض نہیں ہیں ۔"
"13612","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ سے زیادہ مختصر نماز کسی کے پیچھے نہیں پڑھی ، نبی ﷽ کی نماز قریب قریب برابر ہوتی تھی ، حضرت ابوبکر صدیق رضی اللہ عنہ کا بھی یہی حال تھا ، البتہ حضرت عمر رضی اللہ عنہ نے فجر کی نماز لمبی کرنا شروع کی تھی ، اور بعض اوقات نبی ﷽ سجدہ یا رکوع سے سر اٹھاتے اور ان دونوں کے درمیان اتنا لمبا وقفہ فرماتے کہ ہمیں یہ خیال ہونے لگتا کہ کہیں نبی ﷽ بھول تو نہیں گئے ۔"
"13613","حضرت انس رضی اللہ عنہ سے مروی ہے کہ انہوں نے سورہ کوثر کی پہلی آیت پڑھ کر فرمایا کہ نبی ﷽ نے ارشاد فرمایا مجھے کوثر عطاء کی گئی ہے ، وہ ایک نہر ہے جو سطح زمین پر بھی بہتی ہے ، اس کے دونوں کناروں پر موتیوں کے خیمے لگے ہوئے ہیں ، جنہیں توڑا نہیں گیا ، میں نے ہاتھ لگا کر اس کی مٹی کو دیکھا تو وہ مشک خالص تھی ، اور اس کی کنکریاں موتی تھے ۔"
"13614","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا تم میں سے کوئی شخص اپنے اوپر آنے والی کسی تکلیف کی وجہ سے موت کی تمنا نہ کرے ، اگر موت کی تمنا کرنا ہی ضروری ہو تو اسے یوں کہنا چاہئے کہ اے اللہ ! جب تک میرے لیے زندگی میں کوئی خیر ہے ، مجھے اس وقت تک زندہ رکھ ، اور جب میرے لیے موت میں بہتری ہو تو مجھے موت عطاء فرما دینا ۔"
"13615","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ بکثرت یہ دعاء فرماتے تھے اے اللہ ! ہمیں دنیا میں بھی بھلائی عطاء فرما اور آخرت میں بھی بھلائی عطاء فرما اور ہمیں عذاب جہنم سے محفوظ فرما ۔"
"13616","حضرت انس رضی اللہ عنہ سے ایک پیالے کے متعلق مروی ہے کہ میں نے اس پیالے سے نبی ﷽ کو ہر قسم کا مشروب پلایا ہے ، شہد بھی ، پانی بھی اور دودھ بھی ۔"
"13617","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ایک ہی سحری سے مسلسل کئی روزے نہ رکھا کرو ، کسی نے عرض کیا یا رسول اللہ ! آپ تو اس طرح کرتے ہیں آ نبی ﷽ نے فرمایا میں اس معاملے میں تمہاری طرح نہیں ہوں ، میرا رب مجھے کھلا پلا دیتا ہے ۔"
"13618","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کی خدمت میں ایک آدمی کو پیش کیا گیا جس نے نشہ کیا ہوا تھا ، نبی ﷽ نے تقریباَ بیس آدمیوں کو حکم دیا اور ان میں سے ہر ایک نے اسے دو دو شاخیں یا جوتے مارے ۔"
"13619","حضرت انس رضی اللہ عنہ سے مروی ہے کہ اگر نبی ﷽ زوال شمس سے قبل سفر پر روانہ ہوتے تو نماز ظہر کو نماز عصر تک ماخر کر دیتے ، پھر اتر کر دونوں نمازیں اکٹھی پڑھ لیتے اور اگر سفر پر روانہ ہونے سے پہلے زوال کا وقت ہو جاتا تو آپ ﷽ پہلے نماز ظہر پڑھتے ، پھر سوار ہوتے ۔"
"13620","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا جس شخص کو یہ بات پسند ہو کہ اس کی عمر میں برکت اور رزق میں اضافہ ہو جائے ، اسے چاہئے کہ صلہ رحمی کیا کرے ۔"
"13621","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اگر ابن آدم کے پاس سونے سے بھری ہوئی وادی بھی ہوتی تو وہ دوسری کی تمنا کرتا اور ابن آدم کا منہ صرف قبر کی مٹی ہی بھر سکتی ہے ، اور جو توبہ کرتا ہے ، اللہ اس کی توبہ قبول فرما لیتا ہے ۔"
"13622","[Darussalam 13587] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13623","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا بالوں کی سفیدی کو بدل دیا کرو ، لیکن کالے رنگ کے قریب بھی نہ جانا ۔"
"13624","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا کیا میں تمہیں منافق کی نماز کے متعلق نہ بتااں آ منافق نماز عصر کو چھوڑے رکھتا ہے ، حتیٰ کہ جب سورج شیطان کے دو سینگوں کے درمیان آ جاتا ہے تو وہ نماز پڑھنے کھڑا ہوتا ہے اور مرغ کی طرح ٹھونگیں مار کر اس میں اللہ کو بہت تھوڑا یاد کرتا ہے ۔"
"13625","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قیامت کے دن سارے مسلمان اکٹھے ہوں گے ، ان کے دل میں یہ بات ڈالی جائے گی اور وہ کہیں گے کہ اگر ہم اپنے پروردگار کے سامنے کسی کی سفارش لے کر جائیں تو شاید وہ ہمیں اس جگہ سے راحت عطاء فرما دے ، چنانچہ وہ حضرت آدم علیہ السلام کے پاس جائیں گے اور ان سے کہیں گے کہ اے آدم ! آپ ابوالبشر ہیں ، اللہ تعالیٰ نے آپ کو اپنے ہاتھ سے پیدا کیا ، اپنے فرشتوں سے آپ کو سجدہ کروایا ، اور آپ کو تمام چیزوں کے نام سکھائے ، لہٰذا آپ ہمارے رب سے سفارش کر دیں کہ وہ ہمیں اس جگہ سے نجات دے دے ۔ حضرت آدم علیہ السلام جواب دیں گے کہ میں تو اس کا اہل نہیں ہوں اور انہیں اپنی لغزش یاد آ جائے گی اور وہ اپنے رب سے حیاء کریں گے اور فرمائیں گے کہ تم حضرت نوح علیہ السلام کے پاس چلے جاا ، کیونکہ وہ پہلے رسول ہیں جنہیں اللہ نے اہل زمین کی طرف بھیجا تھا ، چنانچہ وہ سب لوگ حضرت نوح علیہ السلام کے پاس جائیں گے اور ان سے کہیں گے کہ آپ اپنے پروردگار سے ہماری سفارش کر دیجئے ، وہ جواب دیں گے کہ تمہارا گوہر مقصود میرے پاس نہیں ہے ، تم حضرت ابراہیم علیہ السلام کے پاس چلے جاا کیونکہ اللہ نے انہیں اپنا خلیل قرار دیا ہے ۔ چنانچہ وہ سب لوگ حضرت ابراہیم علیہ السلام کے پاس جائیں گے ، لیکن وہ بھی یہی کہیں گے کہ تمہارا گوہر مقصود میرے پاس نہیں ہے ، البتہ تم حضرت موسیٰ علیہ السلام کے پاس چلے جاا ، کیونکہ اللہ نے ان سے براہ راست کلام فرمایا ہے ، اور انہیں تورات دی تھی ، حضرت موسیٰ علیہ السلام بھی معذرت کر لیں گے کہ میں نے ایک شخص کو ناحق قتل کر دیا تھا البتہ تم حضرت عیسیٰ علیہ السلام کے پاس چلے جاا ، وہ اللہ کے بندے ، اس کے رسول اور اس کا کلمہ اور روح تھے لیکن حضرت عیسیٰ علیہ السلام بھی معذرت کر لیں گے اور فرمائیں گے کہ تم محمد ﷽ کے پاس جاا ، وہ تمہاری سفارش کریں گے جن کی اگلی پچھلی لغزشیں اللہ نے معاف فرما دی ہیں ۔ اور حضرت عیسی علیہ السلام یہ بھی فرمائیں گے کہ یہ بتاا ! اگر کسی مہر شدہ برتن میں کوئی سامان پڑا ہوا ہو تو کیا مہر توڑے بغیر اس برتن میں موجود چیز کو حاصل کرنا ممکن ہو گا آ لوگ کہیں گے نہیں ، حضرت عیسی علیہ السلام فرمائیں گے کہ پھر یاد رکھو ! محمد ﷽ تمام انبیاء کی مہر ہیں ۔ نبی ﷽ فرماتے ہیں کہ پھر وہ لوگ آ کر کہیں گے کہ اے محمد ﷽ ! اپنے رب سے ہماری سفارش کر دیجئے کہ وہ ہمارے متعلق فیصلہ کر دے ، میں اپنے پروردگار کے پاس حاضری کی اجازت چاہوں گا جو مجھے مل جائے گی ، میں اپنے رب کو دیکھ کر سجدہ ریز ہو جااں گا ، اللہ جب تک چاہے گا مجھے سجدے ہی کی حالت میں رہنے دے گا ، پھر مجھ سے کہا جائے گا کہ اے محمد ! ﷽ ، سر تو اٹھائیے ، آپ جو کہیں گے اس کی شنوائی ہو گی ، جو مانگیں گے وہ ملے گا اور جس کی سفارش کریں گے قبول کر لی جائے گی ، چنانچہ میں اپنا سر اٹھا کر اللہ کی ایسی تعریف کروں گا جو وہ خود مجھے سکھائے گا ، پھر میں سفارش کروں گا تو اللہ میرے لیے ایک حد مقرر فرما دے گا اور میں انہیں جنت میں داخل کروا کر دوبارہ آاں گا ، تین مرتبہ اسی طرح ہو گا ، چوتھی مرتبہ میں کہوں گا کہ پروردگار ! اب صرف وہی لوگ باقی بچے ہیں جنہیں قرآن نے روک رکھا ہے ۔ چنانچہ جہنم سے ہر اس شخص کو نکال لیا جائے گا جو ®لا الہ الا اللہ¾ کہتا ہو اور اس کے دل میں جو کے دانے کے برابر بھی خیر موجود ہو ، پھر جہنم سے ہر اس شخص کو نکال لیا جائے گا جو ®لا الہ الا اللہ¾ کہتا ہو اور اس کے دل میں گندم کے دانے کے برابر بھی خیر موجود ہو ، پھر جہنم سے ہر اس شخص کو نکال لیا جائے گا جو ®لا الہ الا اللہ¾ کہتا ہو اور اس کے دل میں ایک ذرے کے برابر بھی خیر موجود ہو ۔"
"13626","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی وفات پر حضرت ام ایمن رضی اللہ عنہا رونے لگیں ، کسی نے پوچھا کہ تم نبی ﷽ پر کیوں رو رہی ہو آ انہوں نے جواب دیا میں جانتی ہوں کہ نبی ﷽ دنیا سے رخصت ہو گئے ہیں ، میں تو اس وحی پر رو رہی ہوں جو منقطع ہو گئی ۔"
"13627","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا تین چیزیں جس شخص میں بھی ہوں گی ، وہ ایمان کی حلاوت محسوس کرے گا ، ایک تو یہ کہ اللہ اور اس کے رسول اسے دوسروں سے سب سے زیادہ محبوب ہوں ، دوسرا یہ کہ انسان کسی سے محبت کرے تو صرف اللہ کی رضاء کے لئے ، اور تیسرا یہ کہ انسان کفر سے نجات ملنے کے بعد اس میں واپس جانے کو اسی طرح ناپسند کرے جیسے آگ میں چھلانگ لگانے کو ناپسند کرتا ہے ۔"
"13628","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا شب معراج میں حضرت موسیٰ علیہ السلام کے پاس سے گذرا تو دیکھا کہ وہ سرخ ٹیلے کے پاس اپنی قبر میں کھڑے نماز پڑھ رہے ہیں ۔"
"13629","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ حضرت ام حرام رضی اللہ عنہا کے یہاں تشریف لائے ، ہم نے نبی ﷽ کے سامنے کھجوریں اور گھی پیش کیا ، نبی ﷽ اس دن روزے سے تھے اس لئے فرمایا کہ کھجوریں اس کے برتن میں اور گھی اس کی بالٹی میں واپس ڈال دو ، پھر گھر کے ایک کونے میں کھڑے ہو کر آپ ﷽ نے ہمیں دو رکعت نماز پڑھائی ، حضرت ام حرام رضی اللہ عنہا اور ام سلیم رضی اللہ عنہا کو ہمارے پیچھے پیچھے کھڑا کیا ، اور مجھے اپنی دائیں جانب کھڑا کیا ، اور ہمیں بستر پر کھڑے ہو کر نفلی نماز پڑھائی ، نماز سے فارغ ہو کر حضرت ام سلیم رضی اللہ عنہا نے عرض کیا یا رسول اللہ ﷽ ! میری ایک خاص چیز بھی ہے ، آپ کا خادم انس ، اس کے لیے دعا کر دیجے ، اس پر نبی ﷽ نے دنیا و آخرت کی کوئی خیر ایسی نہ چھوڑی جو میرے لیے نہ ماانگی ہو ، اور فرمایا اے اللہ ! اسے کثرت سے مال اور اولاد عطاء فرما اور ان میں برکت عطاء فرما ، چنانچہ اس کے بعد انصار میں سے کوئی شخص مجھ سے زیادہ مالدار نہ تھا ، حالانکہ قبل ازیں وہ اپنی انگوٹھی کے علاوہ کسی سونا چاندی کے مالک نہ تھے ، اور خود کہتے ہیں کہ مجھے میری بیٹی نے بتایا ہے کہ میری نسل میں سے نوے سے زائد آدمی فوت ہو کر دفن ہو چکے ہیں ۔"
"13630","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کا وقت آیا تو ہر وہ آدمی جس کا مدینہ منورہ میں گھر تھا وہ اٹھ کر قضاء حاجت اور وضو کے لیے چلا گیا ، کچھ مہاجرین رہ گئے جن کا گھر دور تھا اور وہ ستر ، اسی کے درمیان تھے ، نبی ﷽ کی خدمت میں ایک کشادہ برتن پانی کا لایا گیا ، نبی ﷽ نے اپنی ہتھیلیاں اس میں رکھ دیں لیکن اس برتن میں اتنی گنجائش نہ تھی ، لہذا نبی ﷽ نے چار انگلیاں ہی رکھ کر فرمایا قریب آ کر اس سے وضو کرو ، اس وقت نبی ﷽ کا دست مبارک برتن میں ہی تھا ، چنانچہ ان سب نے اس سے وضو کر لیا ، اور ایک آدمی بھی ایسا نہ رہا جس نے وضو نہ کیا ہو اور پھر بھی اس میں اتنا ہی پانی بچ گیا ۔"
"13631","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک شخص نے نبی ﷽ کو مخاطب کر کے کہا اے محمد ! ﷽ ، اے ہمارے سردار ابن سردار ، اے ہمارے خیر ابن خیر ! نبی ﷽ نے فرمایا لوگو ! تقویٰ کو اپنے اوپر لازم کر لو ، شیطان تم پر حملہ نہ کر دے ، میں صرف محمد بن عبداللہ ہوں ، اللہ کا بندہ اور اس کا پیغمبر ہوں ، بخدا ! مجھے یہ چیز پسند نہیں ہے کہ تم مجھے میرے مرتبے سے """" جو اللہ کے یہاں ہے """" بڑھا چڑھا کر بیان کرو ۔"
"13632","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور ان کی اہلیہ محترمہ ایک ہی برتن سے غسل کر لیا کرتے تھے ۔"
"13633","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا میں نے تمہیں مسواک کرنے کا حکم کثرت سے دیا ہے ۔"
"13634","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضور نبی مکرم ﷽ نے ارشاد فرمایا دجال کی ایک آنکھ پونچھ دی گئی ہو گی ، اس کی دونوں آنکھوں کے درمیان حروف تہجی کی شکل میں کافر لکھا ہو گا جسے ہر مسلمان پڑھ لے گا خواہ وہ ان پڑھ ہو یا پڑھا لکھا ۔"
"13635","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب رات کا کھانا سامنے آ جائے اور نماز کھڑی ہو جائے تو پہلے کھانا کھا لو ۔"
"13636","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک مہینے تک + رکوع کے بعد , قنوت نازلہ پڑھی ہے ، پھر اسے ترک فرما دیا تھا ۔"
"13637","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک مہینے تک رکوع کے بعد قنوت نازلہ پڑھی ہے ۔"
"13638","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جہنم کا لباس سب سے پہلے ابلیس کو پہنایا جائے گا اور وہ اسے اپنی ابرواں پر رکھے گا ، اس کے پیچھے اس کی ذریت گھستی چلی آ رہی ہو گی ، شیطان ہائے ہلاکت کی آواز لگا رہا ہو گا اور اس کی ذریت بھی ہائے ہلاکت کہہ رہی ہو گی ، یہی کہتے کہتے وہ جہنم کے پاس پہنچ کر رک جائیں گے ، شیطان پھر یہی کہے گا ہائے ہلاکت اور اس کی ذریت بھی یہی کہے گی ، اس موقع پر ان سے کہا جائے گا کہ آج ایک ہلاکت کو نہ پکارو ، کئی ہلاکتوں کو پکارو ۔"
"13639","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا لشکر میں ابوطلحہ رضی اللہ عنہ کی آواز ہی کئی لوگوں سے بھاری ہے ۔"
"13640","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا تہبند نصف پنڈلی تک ہونا چاہئے ، جب نبی ﷽ نے دیکھا کہ مسلمانوں کو اس سے پریشانی ہو رہی ہے تو فرمایا ٹخنوں تک کر لو ، اس سے نیچے ہونے میں کوئی خیر نہیں ہے ۔"
"13641","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے بال کان کی لو سے آگے نہ بڑھتے تھے ۔"
"13642","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا نفاق کی علامت انصار سے بغض رکھنا ہے اور ایمان کی علامت انصار سے محبت کرنا ہے ۔"
"13643","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب مکہ مکرمہ فتح ہو گیا اور نبی ﷽ قریش میں مال غنیمت تقسیم کرنے لگے تو انصار کے کچھ لوگ کہنے لگے تعجب ہے کہ وہ قریش کو دیئے جا رہے ہیں اور ہمیں نظر انداز کر رہے ہیں جبکہ ہماری تلواروں سے ابھی تک ان کے خون کے قطرے ٹپک رہے ہیں ۔ نبی ﷽ کو یہ بات معلوم ہوئی تو آپ ﷽ نے انصاری صحابہ رضی اللہ عنہم کو بلا بھیجا اور فرمایا کہ آپ کے حوالے سے مجھے کیا باتیں معلوم ہو رہی ہیں آ انہوں نے بتایا کہ یہ بات ٹھیک ہے اور وہ لوگ جھوٹ نہیں بولتے تھے ، نبی ﷽ نے فرمایا کیا تم لوگ اس بات پر خوش نہیں ہو کہ لوگ مال و دولت لے کر چلے جائیں اور تم پیغمبر خدا کو اپنے گھروں میں لے جاا ، اگر سارے لوگ ایک وادی یا گھاٹی میں چل رہے ہوں اور انصار دوسری جانب ، تو میں انصار کی وادی اور گھاٹی کو اختیار کروں گا ۔"
"13644","[Darussalam 13609] حضرت انس رضی اللہ تعالی عنہ سے مروی ہے کہ غزوہ حنین کے موقع پر اللہ نے جب بنو ہوازن کا مال غنیمت نبی (صلی اللہ علیہ وآلہ وسلم) کو عطاء فرمایا اور نبی (صلی اللہ علیہ وآلہ وسلم) عیینہ اور اقرع وغیرہ کے ایک ایک یہودی کو سو سو اونٹ دینے لگے تو انصار کے کچھ لوگ کہنے لگے اللہ تعالیٰ نبی (صلی اللہ علیہ وآلہ وسلم) کی بخشش فرمائے، کہ وہ قریش کو دیئے جا رہے ہیں اور ہمیں نظر انداز کر رہے ہیں جب کہ ہماری تلواروں سے ابھی تک خون کے قطرے ٹپک رہے ہیں۔ نبی (صلی اللہ علیہ وآلہ وسلم) کو یہ بات معلوم ہوئی تو آپ (صلی اللہ علیہ وآلہ وسلم) نے انصاری صحابہ (رض) کو بلا بھیجا اور فرمایا کیا تم لوگ اس بات پر خوش نہیں ہو کہ لوگ مال و دولت لے کر چلے جائیں اور تم پیغمبر اللہ کو اپنے گھروں میں لے جاؤ، وہ کہنے لگے کیوں نہیں یا رسول اللہ (صلی اللہ علیہ وآلہ وسلم) ! پھر نبی (صلی اللہ علیہ وآلہ وسلم) نے فرمایا اس ذات کی قسم جس کے دست قدرت میں محمد (صلی اللہ علیہ وآلہ وسلم) کی جان ہے، اگر لوگ ایک وادی میں چل رہے ہوں اور انصار دوسری جانب، تو میں انصار کی وادی اور گھاٹی کو اختیار کروں گا۔ انصار میرا پردہ ہیں اور اگر ہجرت نہ ہوتی تو میں انصار ہی کا ایک فرد ہوتا۔"
"13645","قتادہ رحمۃ اللہ کہتے ہیں کہ ہم لوگ حضرت انس رضی اللہ عنہ کی خدمت میں حاضر ہوا کرتے تھے ، ان کے یہاں نانبائی مقرر تھا ، ایک دن وہ ہم سے فرمانے لگے کھاا ، البتہ میرے علم میں نہیں ہے کہ نبی ﷽ نے کبھی اپنی آنکھوں سے باریک روٹی کو دیکھا بھی ہو ، یا کبھی سالم بھنی ہوئی بکری کھائی ہو ، یہاں تک کہ وہ اللہ سے جا ملے ۔"
"13646","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جب تم میں سے کسی کو نماز پڑھتے ہوئے اونگھ آنے لگے تو اسے چاہئے کہ واپس جا کر سو جائے ۔"
"13647","حضرت انس رضی اللہ عنہ سے مروی ہے جناب رسول اللہ ﷽ نے ارشاد فرمایا قیامت کے دن ہر دھوکے باز کے لئے ایک جھنڈا ہو گا ۔"
"13648","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے اس بات سے منع کیا ہے کہ پھل پکنے سے پہلے ، کشمش + انگور , سیاہ ہونے سے پہلے اور گندم کا دانہ سخت ہونے سے پہلے بیچا جائے ۔"
"13649","حمید رحمۃ اللہ کہتے ہیں کہ حضرت انس رضی اللہ عنہ جب نبی ﷽ کے حوالے سے کوئی حدیث بیان کرتے تو آخر میں یہ فرماتے """" یا جیسے نبی ﷽ نے ارشاد فرمایا """""
"13650","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے تین چیزوں یعنی قبرستان جانے ، تین دن کے بعد قربانی کا گوشت کھانے اور دباء ، نقیر ، حنتم اور مزفت میں نبیذ پینے سے منع فرمایا تھا ، پھر کچھ عرصہ گذرنے کے بعد فرمایا کہ میں نے پہلے تمہیں تین چیزوں سے منع کیا تھا ، میں نے تمہیں قبرستان جانے سے منع کیا تھا ، اب میری رائے یہ ہوئی ہے کہ اس سے دل نرم ہوتے ہیں ، آنکھیں آنسو بہاتی ہیں ، اس لئے قبرستان جایا کرو ، لیکن بے ہودہ گوئی مت کرنا ، اسی طرح میں نے تمہیں تین دن کے بعد قربانی کا گوشت کھانے سے منع کیا تھا ، اب میری رائے یہ ہوئی ہے کہ لوگ اپنے مہمانوں کو یہ گوشت تحفے کے طور پر دیتے ہیں اور غائبین کے لئے محفوظ کر کے رکھتے ہیں ، اس لئے تم جب تک چاہو ، اسے رکھ سکتے ہو ، نیز میں نے تمہیں ان برتنوں میں نبیذ پینے سے منع کیا تھا ، اب تم جس برتن میں چاہو ، پی سکتے ہو ، البتہ کوئی نشہ آور چیز مت پینا ، اب جو چاہے وہ اپنے مشکیزے کا منہ گناہ کی چیز پر بند کر لے ۔"
"13651","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کسی دیہاتی کی عیادت کے لئے اس کے پاس تشریف لے گئے """" جسے بخار چڑھ گیا تھا """" اور فرمایا کہ انشاء اللہ یہ بخار تمہارے گناہوں کا کفارہ اور باعث طہارت ہو گا ، وہ دیہاتی کہنے لگا کہ نہیں ، یہ تو جوش مارتا ہوا بخار ہے جو ایک بوڑھے آدمی پر آیا ہے اور اسے قبر دکھا کر ہی چھوڑے گا ، نبی ﷽ نے یہ سن کر اسے چھوڑا اور کھڑے ہو گئے ۔"
"13652","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی خدمت میں جب بھی خوشبو پیش کی جاتی تو آپ ﷽ اسے رد نہ فرماتے تھے ۔"
"13653","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے اس بات سے منع فرمایا ہے کہ کوئی شخص کھڑے ہو کر پیے میں نے کھانے کا حکم پوچھا تو فرمایا یہ اس سے بھی زیادہ سخت ہے ۔"
"13654","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ماہ رمضان میں نبی ﷽ سفر پر تھے ، نبی ﷽ کے سامنے ایک برتن لایا گیا ، آپ ﷽ نے اسے نوش فرما لیا اور لوگ دیکھ رہے تھے ۔"
"13655","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ابوموسیٰ اشعری رضی اللہ عنہ نے نبی ﷽ سے سواری کے لئے کوئی جانور مانگا ، نبی ﷽ اس وقت کسی کام میں مصروف تھے ، اس لئے فرما دیا کہ بخدا ! میں تمہیں کوئی سواری نہیں دوں گا ، لیکن جب وہ پلٹ کر جانے لگے تو انہیں واپس بلایا اور ایک سواری مرحمت فرما دی ، وہ کہنے لگے یا رسول اللہ ﷽ ! آپ نے تو قسم کھائی تھی کہ مجھے کوئی سواری نہیں دیں گے آ فرمایا اب قسم کھا لیتا ہوں کہ تمہیں سواری ضرور دوں گا ۔"
"13656","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضور نبی مکرم ﷽ نے ارشاد فرمایا دجال کانا ہو گا اور تمہارا رب کانا نہیں ہے ، اور اس کی دونوں آنکھوں کے درمیان کافر لکھا ہو گا ، جسے ہر مسلمان پڑھ لے گا خواہ وہ پڑھا لکھا ہو یا ان پڑھ ہو ۔"
"13657","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب مدینہ منورہ تشریف لائے تو پتہ چلا کہ دو دن ایسے ہیں جن میں لوگ زمانہ جاہلیت سے جشن مناتے آ رہے ہیں ، نبی ﷽ نے فرمایا یہ کیسے دن ہیں آ لوگوں نے عرض کیا کہ ہم زمانہ جاہلیت سے ان دنوں میں تفریح کرتے چلے آ رہے ہیں ، نبی ﷽ نے فرمایا اللہ نے ان دو دنوں کے بدلے میں تمہیں اس سے بہتر دن یوم الفطر اور یوم الاضحی عطاء فرمائے ہیں ۔"
"13658","حضرت انس رضی اللہ عنہ سے مروی ہے کہ صحابہ کرام رضی اللہ عنہم کی نگاہوں میں نبی ﷽ سے زیادہ محبوب کوئی شخص نہ تھا ، لیکن وہ نبی ﷽ کو دیکھ کر کھڑے نہ ہوتے تھے کیونکہ وہ جانتے تھے کہ نبی ﷽ اسے اچھا نہیں سمجھتے ۔"
"13659","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا تمہارے پاس یمن کے لوگ آئے ہیں جو تم سے بھی زیادہ رقیق القلب ہیں ، اور یہی وہ پہلے لوگ ہیں جو مصافحہ کا رواج اپنے ساتھ لے کر آئے ۔"
"13660","قتادہ رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ نبی ﷽ کو کون سا لباس پسند تھا ، انہوں نے فرمایا دھاری دار یمنی چادر ۔"
"13661","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ روم کے بادشاہ نے نبی ﷽ کی خدمت میں ایک ریشمی جبہ """" جس میں سونے کا کام ہوا تھا """" بھجوایا ، نبی ﷽ نے اسے پہن لیا ، لمبا ہونے کی وجہ سے وہ نبی ﷽ کے ہاتھوں میں جھول رہا تھا ، لوگ کہنے لگے یا رسول اللہ ! کیا یہ آپ پر آسمان سے اترا ہے آ نبی ﷽ نے فرمایا کیا تمہیں اس پر تعجب ہو رہا ہے آ اس ذات کی قسم جس کے دست قدرت میں میری جان ہے ، جنت میں سعد بن معاذ رضی اللہ عنہ کے صرف رومال ہی اس سے بہت بہتر ہیں پھر نبی ﷽ نے وہ جبہ حضرت جعفر رضی اللہ عنہ کے پاس بھجوا دیا ، انہوں نے اسے پہن لیا ، نبی ﷽ نے فرمایا یہ میں نے تمہیں پہننے کے لئے نہیں دیا ، انہوں نے پوچھا کہ پھر میں اس کا کیا کروں آ نبی ﷽ نے فرمایا اپنے بھائی نجاشی کے پاس بھیج دو ۔"
"13662","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے کچی اور پکی کھجور کو اکٹھا کر کے نبیذ بنانے سے منع فرمایا ہے ۔"
"13663","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جنت میں داخل ہونے والا کوئی شخص بھی جنت سے نکلنا کبھی پسند نہیں کرے گا سوائے شہید کے کہ جس کی خواہش یہ ہو گی کہ وہ جنت سے نکلے اور پھر اللہ کی راہ میں شہید ہو ، کیونکہ اسے اس کی عزت نظر آ رہی ہو گی ۔"
"13664","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا کوئی شخص اس وقت تک مومن نہیں ہو سکتا جب تک اپنے مسلمان بھائی کے لیے وہی پسند نہ کرنے لگے جو اپنے لئے پسند کرتا ہے ۔"
"13665","قتادہ رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ کیا نبی ﷽ نے خضاب لگایا ہے آ انہوں نے فرمایا یہاں تک نوبت ہی نہیں آئی ، نبی ﷽ کی کنپٹیوں میں چند بال سفید تھے ، البتہ حضرت ابوبکر صدیق رضی اللہ عنہ مہندی اور وسمہ کا خضاب لگاتے تھے ۔"
"13666","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نبی ﷽ نے فرمایا جو میں جانتا ہوں ، اگر تم وہ جانتے ہوتے تو تم بہت تھوڑا ہنستے اور کثرت سے رویا کرتے ۔"
"13667","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کا گذر ایک آدمی پر ہوا جو قربانی کا جانور ہانکتے ہوئے چلا جا رہا تھا ، نبی ﷽ نے اس سے سوار ہونے کے لئے فرمایا ، اس نے کہا کہ یہ قربانی کا جانور ہے ، نبی ﷽ نے اس سے پھر فرمایا کہ سوار ہو جاا ۔"
"13668","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا بیماری متعدی ہونے اور بدشگونی کی کوئی حیثیت نہیں ، البتہ مجھے فال یعنی اچھا اور پاکیزہ کلمہ اچھا لگتا ہے ۔"
"13669","[Darussalam 13634] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13670","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ تین سانسوں میں پانی پیتے تھے اور فرماتے تھے کہ یہ طریقہ زیادہ آسان ، خوشگوار اور مفید ہے ۔ حضرت انس رضی اللہ عنہ کہتے ہیں کہ میں بھی پیتے ہوئے تین سانس لیتا ہوں ۔"
"13671","عبدالرحمن اصم کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے نماز میں تکبیر کا حکم پوچھا تو میں نے انہیں یہ جواب دیتے ہوئے سنا کہ انسان جب رکوع سجدہ کرے ، سجدے سے سر اٹھائے اور دو رکعتوں کے درمیان کھڑا ہو تو تکبیر کہے ، حکیم نے ان سے پوچھا کہ آپ کو یہ حدیث کس کے حوالے سے یاد ہے آ انہوں نے فرمایا نبی ﷽ اور حضرات ابوبکر و عمر رضی اللہ عنہما کے حوالے سے ، پھر وہ خاموش ہو گئے ، حکیم نے ان سے پوچھا کہ حضرت عثمان رضی اللہ عنہ کے حوالے سے بھی آ انہوں نے فرمایا جی ہاں !"
"13672","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اس شخص کا ایمان نہیں جس کے پاس امانت داری نہ ہو اور اس شخص کا دین نہیں جس کے پاس وعدہ کی پاسداری نہ ہو ۔"
"13673","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا مشرکین کے ساتھ اپنی جان ، مال اور زبان کے ذریعے جہاد کرو ۔"
"13674","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب حدیبیہ سے واپس آ رہے تھے تو صحابہ کرام رضی اللہ عنہم پر غم اور پریشانی کے آثار تھے کیونکہ انہیں عمرہ ادا کرنے سے روک دیا گیا تھا اور انہیں حدیبیہ میں ہی اپنے جانور قربان کرنے پڑے تھے , ، اس موقع پر آپ ﷽ پر یہ آیت نازل ہوئی ®انا فتحنا لک فتحا مبینا ۔۔۔۔۔۔ ۔ صراطا مستقیما¾ نبی ﷽ نے فرمایا مجھ پر ایک آیت ایسی نازل ہوئی ہیں جو مجھے ساری دنیا سے زیادہ محبوب ہیں ، پھر نبی ﷽ نے اس کی تلاوت فرمائی ، تو ایک مسلمان نے یہ سن کر کہا یا رسول اللہ ﷽ ! آپ کو مبارک ہو کہ اللہ نے آپ کو یہ دولت عطاء فرمائی ، ہمارے لیے کیا حکم ہے آ اس پر یہ آیت نازل ہوئی ®لیدخل المومنین والمومنات جنات ۔۔۔۔۔۔ ۔ فوزا عظیما¾"
"13675","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت زبیر رضی اللہ عنہ اور عبدالرحمن بن عوف رضی اللہ عنہ نے ایک غزوے میں نبی ﷽ سے جواں کی شکایت کی ، نبی ﷽ نے انہیں ریشمی کپڑے پہننے کی اجازت مرحمت فرما دی ۔"
"13676","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک مہینہ تک رکوع کے بعد قنوت نازلہ پڑھی ہے پھر اسے ترک فرما دیا تھا ۔"
"13677","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی """" جس کا نام انجشہ تھا """" حدی خوان تھا ، اس کی آواز بہت اچھی تھی ، نبی ﷽ نے فرمایا انجشہ ! ان آبگینوں کو آہستہ لے کر چلو ۔"
"13678","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ ایک درزی نے کھانے پر نبی ﷽ کو بلایا ، وہ کھانا لے کر حاضر ہوا تو اس میں جو کی روٹی ، پرانا روغن اور کدو تھا ، میں نے دیکھا کہ نبی ﷽ پیالے میں سے کدو تلاش کر رہے ہیں ، اس وقت سے مجھے بھی کدو پسند آنے لگا ۔"
"13679","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے سامنے جب بھی قصاص کا کوئی معاملہ پیش ہوا تو آپ ﷽ نے اس میں معاف کرنے کی ترغیب ہی دی ۔"
"13680","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کھڑی ہوئی تو ایک آدمی تیزی سے آیا ، اس کا سانس پھولا ہوا تھا ، صف تک پہنچ کر وہ کہنے لگا ®الحمدللہ حمدا کثیر طیبا مبارکا فیہ¾ نبی ﷽ نے نماز سے فارغ ہو کر پوچھا کہ تم میں سے کون بولا تھا آ اس نے اچھی بات کہی تھی ، چنانچہ وہ آدمی کہنے لگا یا رسول اللہ ﷽ ! میں بولا تھا ، میں تیزی سے آ رہا تھا ، اور صف کے قریب پہنچ کر میں نے یہ جملہ کہا تھا ، نبی ﷽ نے فرمایا میں نے بارہ فرشتوں کو اس کی طرف تیزی سے بڑھتے ہوئے دیکھا کہ کون اس جملے کو پہلے اٹھاتا ہے ، پھر فرمایا جب تم میں سے کوئی شخص نماز کے لئے آئے تو سکون سے چلے ، جتنی نماز مل جائے سو پڑھ لے اور جو رہ جائے اسے قضاء کر لے ۔"
"13681","حضرت انس رضی اللہ عنہ سے مروی ہے کہ صحابہ کرام رضی اللہ عنہم خندق کھودتے ہوئے یہ شعر پڑھتے جاتے تھے کہ ہم ہی وہ لوگ ہیں جنہوں نے محمد + ﷽ , کے دست حق پرست پر مرتے دم تک کے لئے اسلام کی یقینی بیعت کی ہے ، اور نبی ﷽ جواباَ یہ جملہ کہتے تھے کہ اے اللہ ! اصل خیر تو آخرت کی خیر ہے ، پس تو انصار اور مہاجرین کو معاف فرما ، پھر نبی ﷽ کے پاس جو کی روٹی لائی گئی جس پر سنا ہوا روغن رکھا تھا ، صحابہ رضی اللہ عنہم نے اسی کو تناول فرما لیا اور نبی ﷽ فرمانے لگے کہ اصل بھلائی تو آخرت کی بھلائی ہے ۔"
"13682","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے مسجد میں قبلہ کی جانب ناک کی ریزش لگی ہوئی دیکھی تو اسے اپنے ہاتھ سے صاف کر دیا ۔"
"13683","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کبھی کبھار اپنی تمام ازواج مطہرات کے پاس ایک ہی رات میں ایک ہی غسل سے چلے جایا کرتے تھے ۔"
"13684","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ احد کے دن نبی ﷽ کی دعاء یہ تھی کہ اے اللہ ! کیا تو یہ چاہتا ہے کہ آج کے بعد تیری عبادت نہ کی جائے ۔"
"13685","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب تسلسل کے ساتھ روزہ رکھتے تو لوگ کہتے کہ نبی ﷽ روزہ رکھتے رہیں گے اور جب افطاری کرتے تب بھی لوگ کہتے کہ نبی ﷽ ناغہ کرتے رہیں گے ۔"
"13686","[Darussalam 13651] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13687","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دشمن پر طلوع فجر کے وقت حملے کی تیاری کرتے تھے ، اور کان لگا کر سنتے تھے ، اگر وہاں سے اذان کی آواز سنائی دیتی تو رک جاتے ورنہ حملہ کر دیتے ، ایک دن اسی طرح نبی ﷽ نے کان لگا کر سنا تو ایک آدمی کے اللہ اکبر ، اللہ اکبر کہنے کی آواز سنائی دی ، نبی ﷽ نے فرمایا فطرت سلیمہ پر ہے ، پھر جب اس نے ®اشھد ان لا الہ الا اللہ¾ کہا تو فرمایا کہ تو جہنم کی آگ سے نکل گیا ۔"
"13688","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب اپنے بستر پر تشریف لاتے تو یوں کہتے کہ اس اللہ کا شکر ہے جس نے ہمیں کھلایا پلایا ، ہماری کفایت کی اور ٹھکانہ دیا ، کتنے ہی لوگ ایسے ہیں جن کی کوئی کفایت کرنے والا یا انہیں ٹھکانہ دینے والا کوئی نہیں ہے ۔"
"13689","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں بچوں کے ساتھ کھیل رہا تھا ، اسی دوران نبی ﷽ تشریف لے آئے اور ہمیں سلام کیا ، پھر میرا ہاتھ پکڑ کر مجھے کسی کام سے بھیج دیا ، جب میں گھر واپس پہنچا تو حضرت ام سلیم رضی اللہ عنہ + میری والدہ , کہنے لگیں کہ اتنی دیر کیوں لگا دی آ میں نے بتایا کہ نبی ﷽ نے اپنے کسی کام سے بھیجا تھا ، انہوں نے پوچھا کیا کام تھا آ میں نے کہا کہ یہ ایک راز ہے ، انہوں نے کہا کہ پھر نبی ﷽ کے راز کی حفاظت کرنا ، بخدا ! اے ثابت ! اگر میں وہ کسی سے بیان کرتا تو تم سے بیان کرتا ۔"
"13690","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ایک مرتبہ انصار سے مخاطب ہو کر فرمایا اے گروہ انصار ! کیا ایسا نہیں ہے کہ جب میں تمہارے پاس آیا تو تم بے راہ تھے ، اللہ نے میرے ذریعے تمہیں ہدایت عطاء فرمائی آ کیا ایسا نہیں ہے کہ جب میں تمہارے پاس آیا تو تم ایک دوسرے کے دشمن تھے ، اللہ نے میرے ذریعے تمہارے دلوں میں ایک دوسرے کی الفت پیدا کر دی آ پھر فرمایا تم یہ کیوں نہیں کہتے کہ آپ ہمارے پاس خوف کی حالت میں آئے تھے ، ہم نے آپ کو امن دیا ، آپ کو آپ کی قوم نے نکال دیا تھا ، ہم نے آپ کو ٹھکانہ دیا ، اور آپ بے یار و مددگار ہو چکے تھے ، ہم نے آپ کی مدد کی آ انہوں نے عرض کیا کہ نہیں ہم پر اللہ اور اس کے رسول کا ہی احسان ہے ۔"
"13691","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے ماہ رمضان کے آخر میں صوم وصال فرمایا ، کچھ لوگوں نے بھی ایسا ہی کیا ، نبی ﷽ کو خبر ہوئی تو فرمایا کہ اگر یہ مہینہ لمبا ہو جاتا تو میں اتنے دن مسلسل روزہ رکھتا کہ دین میں تعمق کرنے والے اپنا تعمق چھوڑ دیتے ، میں تمہاری طرح نہیں ہوں ، مجھے تو میرا رب کھلاتا پلاتا رہتا ہے ۔"
"13692","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ احد کے دن نبی ﷽ نے اپنے چہرے سے خون پونچھتے ہوئے فرمایا وہ قوم کیسے فلاح پائے گی جو اپنے نبی کو زخمی کر دے اور ان کے دانت توڑ دے ، جب کہ وہ انہیں ان کے رب کی طرف بلا رہا ہو آ اس پر یہ آیت نازل ہوئی کہ """" آپ کو کسی قسم کا کوئی اختیار نہیں ہے کہ اللہ ان پر متوجہ ہو جائے ، یا انہیں سزا دے کہ وہ ظالم ہیں """"۔"
"13693","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میرے چچا انس بن نضر غزوہ بدر میں نبی ﷽ کے ساتھ شریک نہیں ہو سکے تھے ، اور اس کا انہیں افسوس تھا اور وہ کہا کرتے تھے کہ میں نبی ﷽ کے ساتھ سب سے پہلے غزوہ میں شریک نہیں ہو سکا ، اگر اب اللہ نے نبی ﷽ کے ساتھ کسی غزوے کا موقع عطاء کیا تو اللہ دیکھے گا کہ میں کیا کرتا ہوں ، چنانچہ وہ غزوہ احد میں نبی ﷽ کے ساتھ شریک ہوئے ۔ میدان کار زار میں جب صحابہ رضی اللہ عنہم ہزیمت کا شکار ہوئے تو انہیں اپنے سامنے سے حضرت سعد بن معاذ رضی اللہ عنہ آتے ہوئے دکھائی دیئے ، وہ ان سے کہنے لگے کہ ابوعمرو ! کہاں جا رہے ہو آ بخدا ! مجھے تو احد کے پیچھے سے جنت کی خوشبو آ رہی ہے ، یہ کہہ کر اس بے جگری سے لڑے کہ بالآخر شہید ہو گئے اور ان کے جسم پر نیزوں ، تلواروں اور تیروں کے اسی سے زیادہ نشانات پائے گئے ، ان کی بہن اور میری پھوپھی حضرت ربیع بنت نضر کہتی ہیں کہ میں بھی اپنے بھائی کو صرف انگلی کے پوروں سے پہچان سکی ہوں ، اور اسی مناسبت سے یہ آیت نازل ہوئی تھی کہ """" کچھ لوگ وہ ہیں جنہوں نے اللہ سے کیا ہوا وعدہ سچ کر دکھایا ، ان میں سے بعض تو اپنی امید پوری کر چکے اور بعض منتظر ہیں """" ۔۔۔۔۔۔۔ صحابہ کرام رضی اللہ عنہم سمجھتے تھے کہ یہ آیت حضرت انس رضی اللہ عنہ اور ان جیسے دوسرے صحابہ رضی اللہ عنہم کے بارے نازل ہوئی ہے ۔"
"13694","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی ایک اونٹنی """" جس کا نام عضباء تھا """" کبھی کسی سے پیچھے نہیں رہی تھی ، ایک مرتبہ ایک دیہاتی اپنی اونٹنی پر آیا اور وہ اس سے آگے نکل گیا ، مسلمانوں پر یہ بات بڑی گراں گزری ، نبی ﷽ نے فرمایا اللہ پر حق ہے کہ دنیا میں جس چیز کو وہ بلندی دیتا ہے ، پست بھی کرتا ہے ۔"
"13695","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا قیامت کے دن اہل جہنم میں سے ایک آدمی کو لایا جائے گا جو دنیا میں بڑی نعمتوں میں رہا ہو گا ، اسے جہنم کا ایک چکر لگوایا جائے گا پھر پوچھا جائے گا کہ اے ابن آدم ! کیا تو نے کبھی کوئی خیر دیکھی ہے آ کیا تجھ پر سے کبھی نعمتوں کا گذر ہوا ہے آ وہ کہے گا کہ پروردگار ! قسم کھا کر کہتا ہوں کہ کبھی نہیں ، اس کے بعد اہل جنت میں سے ایک آدمی کو لایا جائے گا جو دنیا میں بڑی مصیبتوں میں رہا ہو گا ، اسے جنت کا ایک چکر لگوایا جائے گا اور پھر پوچھا جائے گا کہ اے ابن آدم ! کیا تو نے کبھی کوئی پریشانی دیکھی ہے آ کیا کبھی تجھ پر کسی سختی کا گذر ہوا ہے آ وہ کہے گا کہ پروردگار ! قسم کھا کر کہتا ہوں کہ کبھی نہیں ، مجھ پر کوئی پریشانی نہیں آئی اور میں نے کوئی تکلیف نہیں دیکھی ۔"
"13696","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جب اللہ نے حضرت آدم علیہ السلام کا پتلا تیار کیا تو کچھ عرصے تک اسے یونہی رہنے دیا ، شیطان اس پتلے کے اردگرد چکر لگاتا تھا اور اس پر غور کرتا تھا ، جب اس نے دیکھا کہ اس مخلوق کے جسم کے درمیان میں پیٹ ہے تو وہ سمجھ گیا کہ یہ مخلوق اپنے اوپر قابو نہ رکھ سکے گی ۔"
"13697","ثابت رحمۃ اللہ کہتے ہیں کہ کسی نے حضرت انس رضی اللہ عنہ سے پوچھا کہ کیا نبی ﷽ کے بال مبارک سفید ہو گئے تھے آ انہوں نے فرمایا کہ اللہ تعالیٰ نے نبی ﷽ کو اس سے محفوظ رکھا ، اور آپ ﷽ کے سر اور داڑھی میں صرف سترہ یا اٹھارہ بال سفید تھے ۔"
"13698","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نبی ﷽ کی خدمت میں اپنے بھائی کو گھٹی دلوانے کے لئے حاضر ہوا تو دیکھا کہ آپ ﷽ بکری کے کان پر داغ رہے ہیں ۔"
"13699","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا صفیں سیدھی رکھا کرو کیونکہ صفوں کی درستگی نماز کا حسن ہے ۔"
"13700","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے انسان کو بائیں ہاتھ سے کھانے پینے سے منع فرمایا ہے ۔"
"13701","حضرت انس رضی اللہ عنہ سے مروی ہے کہ لوگوں نے نبی ﷽ سے اتنے سوال پوچھے کہ انہیں پریشان کر دیا ، حتی کہ ایک دن نبی ﷽ منبر پر چڑھے اور فرمایا کہ جو شخص کوئی سوال پوچھنا چاہتا ہے وہ پوچھ لے ، بخدا تم مجھ سے جس چیز کے متعلق بھی """" جب تک میں یہاں کھڑا ہوں """" سوال کرو گے ، میں تمہیں ضرور جواب دوں گا ، میں نے دائیں بائیں دیکھا تو ہر شخص ہی اپنے سر پر کپڑا لپیٹ کر رو رہا تھا ، اور نبی ﷽ بار بار یہی فرماتے رہے کہ مجھ سے پوچھو ، چنانچہ ایک آدمی نے کھڑے ہو کر پوچھا یا رسول اللہ ! میں کہاں داخل ہوں گا آ فرمایا جہنم میں ، عبداللہ بن حذافہ رضی اللہ عنہ نے پوچھ لیا یا رسول اللہ ﷽ ! میرا باپ کون ہے آ نبی ﷽ نے فرمایا تمہارا باپ حذافہ ہے ۔ اس پر حضرت عمر رضی اللہ عنہ گھٹنوں کے بل جھک کر کہنے لگے کہ ہم اللہ کو اپنا رب مان کر ، اسلام کو اپنا دین قرار دے کر اور محمد ﷽ کو اپنا نبی مان کر خوش اور مطمئن ہیں ، حضرت عمر رضی اللہ عنہ کی یہ بات سن کر نبی ﷽ خاموش ہو گئے ، تھوڑی دیر بعد فرمایا اس ذات کی قسم جس کے دست قدرت میں میری جان ہے اس دیوار کی چوڑائی میں ابھی میرے سامنے جنت اور جہنم کو پیش کیا گیا تھا ، جبکہ میں نماز پڑھ رہا تھا ، میں نے خیر اور شر میں آج کے دن جیسا کوئی دن نہیں دیکھا ۔"
"13702","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"13703","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اذان اور اقامت کے درمیانی وقت میں کی جانے والی دعاء رد نہیں ہوتی لہذا اس وقت میں دعا کیا کرو ۔"
"13704","مصعب بن ثابت رحمۃ اللہ کہتے ہیں کہ مسجد نبوی میں امام کے کھڑے ہونے کی جگہ پر ایک لکڑی تھی ، ہم نے بہت کوشش کی کہ اس کے متعلق کسی سے کچھ معلوم ہو جائے لیکن ہمیں ایک آدمی بھی ایسا نہ ملا جو ہمیں اس کے متعلق کچھ بتا سکتا ، اتفاقاَ مجھے محمد بن مسلم صاحب مقصورہ نے بتایا کہ ایک دن حضرت انس رضی اللہ عنہ میرے پاس تشریف فرما تھے ، انہوں نے فرمایا کہ کیا تم جانتے ہو کہ یہ لکڑی کیوں رکھی گئی ہے آ میں نے ان سے یہ سوال نہ پوچھا تھا ، میں نے عرض کیا بخدا ! مجھے معلوم نہیں کہ یہ کیوں رکھی گئی ہے آ انہوں نے فرمایا کہ نبی ﷽ اس پر اپنا داہنا ہاتھ رکھ کر ہماری طرف متوجہ ہوتے تھے اور فرماتے تھے سیدھے ہو جاا اور اپنی صفیں برابر کر لو ۔"
"13705","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت براء بن مالک رضی اللہ عنہ مردوں کے لئے حدی خوانی کرتے تھے اور انجشہ رضی اللہ عنہ عورتوں کے لیے ، انجشہ کی آواز بہت اچھی تھی ، جب انہوں نے حدی شروع کی تو اونٹ تیزی سے دوڑنے لگے ، اس پر نبی ﷽ نے فرمایا انجشہ ! ان آبگینوں کو آہستہ لے کر چلو ۔"
"13706","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جنت کو مشقتوں سے اور جہنم کو خواہشات سے ڈھانپ دیا گیا ہے ۔"
"13707","حضرت انس رضی اللہ عنہ ، حضرت عمر بن عبدالعزیز رضی اللہ عنہ کے متعلق """" جب کہ وہ مدینہ منورہ میں تھے """" فرماتے تھے کہ میں نے تمہارے اس امام سے زیادہ نبی ﷽ کے ساتھ مشابہت رکھنے والی نماز پڑھتے ہوئے کسی کو نہیں دیکھا ، حضرت عمر بن عبدالعزیز رحمۃ اللہ مکمل اور مختصر نماز پڑھاتے تھے ۔"
"13708","مروان بن ابی دااد رحمۃ اللہ کہتے ہیں کہ میں ایک مرتبہ حضرت انس رضی اللہ عنہ کے پاس آیا اور عرض کیا کہ اے ابوحمزہ ! جگہ دور کی ہے لیکن ہمارا دل چاہتا ہے کہ آپ کی عیادت کو آیا کریں ، اس پر انہوں نے اپنا سر اٹھا کر کہا کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ جو شخص کسی بیمار کی عیادت کرتا ہے ، وہ رحمت الہٰیہ کے سمندر میں غوطے لگاتا ہے ، اور جب مریض کے پاس بیٹھتا ہے تو اللہ کی رحمت اسے ڈھانپ لیتی ہے ، میں نے عرض کیا یا رسول اللہ ﷽ ! یہ تو اس تندرست آدمی کا حکم ہے جو مریض کی عیادت کرتا ہے ، مریض کا کیا حکم ہے آ نبی ﷽ نے فرمایا اس کے گناہ معاف کر دیئے جاتے ہیں ۔"
"13709","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ یہ دعاء فرمایا کرتے تھے اے اللہ ! میں نہ سنی جانے والی بات ، نہ بلند ہونے والے عمل ، خشوع سے خالی دل ، اور غیر نافع علم سے آپ کی پناہ میں آتا ہوں ۔"
"13710","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے دس سال سفر و حضر میں نبی ﷽ کی خدمت کا شرف حاصل کیا ہے ، یہ ضروری نہیں ہے کہ میرا ہر کام نبی ﷽ کو پسند ہی ہو ، لیکن نبی ﷽ نے مجھے کبھی اف تک نہیں کہا ، نبی ﷽ نے مجھ سے کبھی یہ نہیں فرمایا کہ تم نے یہ کام کیوں کیا آ یا یہ کام تم نے کیوں نہیں کیا آ"
"13711","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کے ایسے ولیمے میں بھی شرکت کی ہے جس میں روٹی تھی اور نہ گوشت ۔"
"13712","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ہمارے لیے مونچھیں کاٹنے ، ناخن تراشنے اور زیر ناف بال صاف کرنے کی مدت چالیس دن مقرر فرمائی تھی ۔"
"13713","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا کچھ لوگ جہنم میں داخل کیے جائیں گے ، جب وہ جل کر کوئلہ ہو جائیں گے تو انہیں جنت میں داخل کر دیا جائے گا ، اہل جنت پوچھیں گے کہ یہ کون لوگ ہیں آ انہیں بتایا جائے گا کہ یہ جہنمی ہیں ۔"
"13714","[Darussalam 13679] حضرت انس رضی اللہ تعالی عنہ سے مروی ہے کہ نبی صلی اللہ علیہ وآلہ وسلم نے فرمایا کچھ لوگ اپنے گناہوں کی وجہ سے جہنم میں داخل کئے جائیں گے جب وہ جل کو کوئلہ بن جائیں گے تو انہیں جنت میں داخل کردیا جائے گا، اہل جنت پوچھیں گے کہ یہ کون لوگ ہیں ؟ انہیں بتایا جائے گا کہ یہ جہنمی ہیں۔ -r-nحضرت انس (رض) سے مروی ہے کہ میں نے نبی (صلی اللہ علیہ وآلہ وسلم) کو یہ فرماتے ہوئے سنا ہے کہ جب جنتی انہیں دیکھیں گے تو کہیں گے کہ یہ جہنمی ہیں۔"
"13715","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور خلفاء ثلاثہ رضی اللہ عنہم نماز میں قراءت کا آغاز ®الحمدللہ رب العالمین¾ سے کرتے تھے ۔"
"13716","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دو چتکبرے سینگ دار مینڈھے قربانی میں پیش کیا کرتے تھے ، اور اللہ کا نام لے کر تکبیر کہتے تھے ، میں نے دیکھا ہے کہ نبی ﷽ انہیں اپنے ہاتھ سے ذبح کرتے تھے اور ان کے پہلو پر اپنا پااں رکھتے تھے ۔"
"13717","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے حضرت عبدالرحمن بن عوف رضی اللہ عنہ اور حضرت زبیر بن عوام رضی اللہ عنہ کو خارش کی وجہ سے ریشمی کپڑے پہننے کی اجازت مرحمت فرما دی ۔"
"13718","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے پاس قبیلہ رعل ، ذکوان ، عصیہ اور بنو لحیان کے کچھ لوگ آئے اور یہ ظاہر کیا کہ وہ اسلام قبول کر چکے ہیں ، اور نبی ﷽ سے اپنی قوم پر تعاون کا مطالبہ کیا ، نبی ﷽ نے ان کے ساتھ ستر انصاری صحابہ رضی اللہ عنہم تعاون کے لئے بھیج دیئے ، حضرت انس رضی اللہ عنہ کہتے ہیں کہ ہم انہیں """" قراء """" کہا کرتے تھے ، یہ لوگ دن کو لکڑیاں کاٹتے اور رات کو نماز میں گذار دیتے تھے ، وہ لوگ ان تمام حضرات کو لے کر روانہ ہو گئے ، راستے میں جب وہ """" بیر معونہ """" کے پاس پہنچے تو انہوں نے صحابہ کرام رضی اللہ عنہم کے ساتھ دھوکہ کیا اور انہیں شہید کر دیا ، نبی ﷽ کو پتہ چلا تو آپ ﷽ نے ایک مہینے تک فجر کی نماز میں قنوت نازلہ پڑھی اور رعل ، ذکوان ، عصیہ اور بنو لحیان کے قبائل پر بددعاء کرتے رہے ۔ حضرت انس رضی اللہ عنہ کہتے ہیں کہ ان صحابہ رضی اللہ عنہم کے یہ جملے کہ """" ہماری قوم کو ہماری طرف سے یہ پیغام پہنچا دو کہ ہم اپنے رب سے مل چکے ، وہ ہم سے راضی ہو گیا اور ہمیں بھی راضی کر دیا """" ایک عرصے تک قرآن کریم میں پڑھتے رہے ، بعد میں ان کی تلاوت منسوخ ہو گئی ۔"
"13719","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ پیدل چلتے ہوئے آ رہے تھے ، جب مسجد کے قریب پہنچے تو ایک آدمی نے نبی ﷽ سے پوچھا کہ قیامت کب قائم ہو گی آ نبی ﷽ نے فرمایا تم نے قیامت کے لیے کیا تیاری کر رکھی ہے آ اس نے کہا کہ اس ذات کی قسم جس نے آپ کو حق کے ساتھ بھیجا ہے میں نے کوئی بہت زیادہ اعمال ، نماز روزہ تو مہیا نہیں کر رکھے ، البتہ اتنی بات ضرور ہے کہ میں اللہ اور اس کے رسول سے محبت کرتا ہوں ، نبی ﷽ نے فرمایا کہ تم قیامت کے دن اس شخص کے ساتھ ہو گے جس کے ساتھ تم محبت کرتے ہو ۔"
"13720","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب نبی ﷽ نے میدان منیٰ میں سر منڈوانے کا ارادہ کیا تو پہلے سر کا داہنا حصہ آگے کیا ، اور فارغ ہو کر وہ بال مجھے دے کر فرمایا انس ! یہ ام سلیم کے پاس لے جاا ، جب لوگوں نے دیکھا کہ نبی ﷽ نے خصوصیت کے ساتھ اپنے بال حضرت ام سلیم رضی اللہ عنہا کو بھجوائے ہیں تو دوسرے حصے کے بال حاصل کرنے میں وہ ایک دوسرے سے مسابقت کرنے لگے ، کسی کے حصے میں کچھ آ گئے اور کسی کے حصے میں کچھ آ گئے ۔"
"13721","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نو سال تک نبی ﷽ کی خدمت کی ، میں نے جس کام کو کر لیا ہو ، نبی ﷽ نے کبھی مجھ سے یہ نہیں فرمایا کہ تم نے بہت برا کیا ، یا غلط کیا ۔"
"13722","قتادہ رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ نبی ﷽ نے کتنے عمرے کیے تھے آ انہوں نے فرمایا کہ چار مرتبہ ، ایک عمرہ تو حدیبیہ کے زمانے میں ، دوسرا ذیقعدہ کے مہینے میں مدینہ سے ، تیسرا عمرہ ذیقعدہ ہی کے مہینے میں جعرانہ سے جب کہ آپ ﷽ نے غزوہ حنین کا مال غنیمت تقسیم کیا تھا اور چوتھا عمرہ حج کے ساتھ کیا تھا ۔"
"13723","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ابوطلحہ رضی اللہ عنہ بارگاہ نبوت میں حاضر ہوئے اور عرض کیا کہ آپ کی کیا رائے ہے آ اللہ نے یہ آیت نازل فرمائی ہے کہ """" تم نیکی کا اعلیٰ درجہ اس وقت تک حاصل نہیں کر سکتے جب تک کہ اپنی محبوب چیز نہ خرچ کر دو """" اور مجھے اپنے سارے مال میں """" بیرحاء """" سب سے زیادہ محبوب ہے ، میں اسے اللہ کے نام پر صدقہ کرتا ہوں اور اللہ کے یہاں اس کی نیکی اور ثواب کی امید رکھتا ہوں ، نبی ﷽ نے فرمایا واہ واہ ! یہ تو بڑا نفع بخش مال ہے ، یہ تو بڑا نفع بخش مال ہے ، پھر انہوں نے وہ باغ لوگوں میں تقسیم کر دیا ۔"
"13724","ابولبید رحمۃ اللہ نے مازہ بن زیار رحمۃ اللہ سے بیان کیا کہ میں نے حجاج بن یوسف کے زمانے میں اپنے گھوڑے کو بھیجا اور سوچا کہ ہم بھی گھڑ دوڑ کی شرط میں حصہ لیتے ہیں ، پھر ہم نے سوچا کہ پہلے حضرت انس رضی اللہ عنہ سے جا کر پوچھ لیتے ہیں کہ کیا آپ لوگ بھی نبی ﷽ کے زمانے میں گھڑ دوڑ پر شرط لگایا کرتے تھے آ چنانچہ ہم نے ان کے پاس آ کر ان سے پوچھا تو انہوں نے جواب دیا ہاں ! ایک مرتبہ انہوں نے اپنے ایک گھوڑے پر """" جس کا نام سبحہ تھا """" گھڑ دوڑ میں حصہ لیا تھا اور وہ سب سے آگے نکل گیا تھا ، جس سے انہیں تعجب ہوا تھا ۔"
"13725","حضرت انس رضی اللہ عنہ سے مروی ہے کہ رسول اللہ ﷽ ایک مرتبہ مسجد میں داخل ہوئے تو دیکھا کہ دو ستونوں کے درمیان ایک رسی لٹک رہی ہے ، پوچھا یہ کیسی رسی ہے آ لوگوں نے بتایا کہ یہ حمنہ بنت حجش کی رسی ہے ، نماز پڑھتے ہوئے جب انہیں سستی یا تھکاوٹ محسوس ہوتی ہے تو وہ اس کے ساتھ اپنے آپ کو باندھ لیتی ہیں ، نبی ﷽ نے فرمایا جب تم میں سے کوئی شخص نماز پڑھے تو نشاط کی کیفیت برقرار رہنے تک پڑھے اور جب سستی یا تھکاوٹ محسوس ہو تو رک جائے ۔"
"13726","[Darussalam 13691] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13727","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا تہبند نصف پنڈلی تک ہونا چاہئے ، جب نبی ﷽ نے دیکھا کہ مسلمانوں کو اس سے پریشانی ہو رہی ہے تو فرمایا ٹخنوں تک کر لو ، اس سے نیچے ہونے میں کوئی خیر نہیں ہے ۔"
"13728","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے دور باسعادت میں ایک مرتبہ قحط سالی ہوئی ، جمعہ کے دن نبی ﷽ خطبہ دے رہے تھے کہ ایک دیہاتی کھڑا ہوا اور عرض کیا کہ یا رسول اللہ ﷽ ! مال تباہ ہو رہے ہیں اور بچے بھوکے ہیں ، اللہ سے دعا کر دیجئے کہ وہ ہمیں پانی سے سیراب کر دے ، نبی ﷽ نے یہ سن کر اپنے ہاتھ بلند کیے اور نبی ﷽ نے طلب باراں کے حوالے سے دعاء فرمائی ، جس وقت آپ ﷽ نے اپنے دست مبارک بلند کیے تھے ، اس وقت ہمیں آسمان پر کوئی بادل نظر نہیں آ رہا تھا ، اس وقت پہاڑوں جیسے بادل آئے اور نبی ﷽ منبر سے نیچے اترنے بھی نہیں پائے تھے کہ ہم نے آپ ﷽ کی ڈاڑھی پر بارش کا پانی ٹپکتے ہوئے دیکھا ۔۔۔۔۔۔ پھر راوی نے پوری حدیث ذکر کی ۔"
"13729","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا انسان تو بوڑھا ہو جاتا ہے لیکن دو چیزیں اس میں جوان ہو جاتی ہیں ، مال کی حرص اور لمبی عمر کی امید ۔"
"13730","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا بعض اوقات ایک شخص ساری زندگی یا ایک طویل عرصہ ایسے نیک اعمال پر گذار دیتا ہے کہ اگر اسی حال میں فوت ہو جائے تو جنت میں داخل ہو جائے لیکن پھر اس میں تبدیلی پیدا ہوتی ہے اور وہ گناہوں میں مبتلا ہو جاتا ہے ، اور مر کر جہنم میں داخل ہو جاتا ہے ، اسی طرح ایک آدمی ایک طویل عرصے تک ایسے گناہوں میں مبتلا رہتا ہے کہ اگر اسی حال میں مر جائے تو جہنم میں داخل ہو ، لیکن پھر اس میں تبدیلی پیدا ہو جاتی ہے اور وہ نیک اعمال میں مصروف ہو جاتا ہے اور مر کر جنت میں داخل ہو جاتا ہے ۔"
"13731","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ بکثرت یہ دعاء مانگا کرتے تھے ، کہ اے دلوں کو پھیرنے والے ، میرے دل کو اپنے دین پر ثابت قدمی عطاء فرما ، ایک مرتبہ صحابہ رضی اللہ عنہم نے عرض کیا یا رسول اللہ ﷽ ! ہم آپ پر اور آپ کی تعلیمات پر ایمان لائے ہیں ، کیا آپ کو ہمارے متعلق کسی چیز سے خطرہ ہے آ نبی ﷽ نے فرمایا دل اللہ کی انگلیوں میں سے صرف دو انگلیوں کے درمیان ہے ، وہ جیسے چاہتا ہے انہیں بدل دیتا ہے ۔"
"13732","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے زمین پر اپنی انگلیاں رکھ کر فرمایا ، یہ ابن آدم ہے ، پھر انہیں اٹھا کر تھوڑا سا پیچھے رکھا اور فرمایا کہ یہ اس کی موت ہے ، پھر اپنا ہاتھ آگے کر کے فرمایا کہ یہ اس کی امیدیں ہیں ۔"
"13733","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اچھے خوابوں سے خوش ہوتے تھے اور بعض اوقات پوچھتے تھے کہ تم میں سے کسی نے کوئی خواب دیکھا ہے آ اگر کسی نے کوئی خواب دیکھا ہوتا تو وہ نبی ﷽ سے اس کی تعبیر دریافت کر لیتا ، اگر اس میں کوئی پریشانی کی بات نہ ہوتی تو نبی ﷽ اس سے بھی خوش ہوتے ، اسی تناظر میں ایک عورت آئی اور کہنے لگی یا رسول اللہ ﷽ ! میں نے خواب میں دیکھا کہ گویا میں جنت میں داخل ہوئی ہوں ، میں نے وہاں ایک آواز سنی جس سے جنت بھی ہلنے لگی ، اچانک میں نے دیکھا کہ فلاں بن فلاں اور فلاں بن فلاں کو لایا جا رہا ہے ، یہ کہتے ہوئے اس نے بارہ آدمیوں کے نام گنوائے جنہیں نبی ﷽ نے اس سے پہلے ایک سریہ میں روانہ فرمایا تھا ۔ اس خاتون نے بیان کیا کہ جب انہیں وہاں لایا گیا تو ان کے جسم پر جو کپڑے تھے ، وہ کالے ہو چکے تھے اور ان کی رگیں پھولی ہوئی تھیں ، کسی نے ان سے کہا کہ ان لوگوں کو نہر بیدخ میں لے جاا ، چنانچہ انہوں نے اس میں غوطہ لگایا اور جب باہر نکلے تو ان کے چہرے چودہویں رات کے چاند کی طرح چمک رہے تھے ، پھر سونے کی کرسیاں لائی گئیں ، وہ ان پر بیٹھ گئے ، پھر ایک تھالی لائی گئی جس میں کچی کھجوریں تھیں ، وہ ان کھجوروں کو کھانے لگے ، اس دوران وہ جس کھجور کو پلٹتے تھے تو حسب منشاء میوہ کھانے کو ملتا تھا ۔ کچھ عرصے بعد اس لشکر سے ایک آدمی فتح کی خوشخبری لے کر آیا ، اور کہنے لگا یا رسول اللہ ﷽ ! ہمارے ساتھ ایسا ایسا معاملہ پیش آیا اور فلاں فلاں آدمی شہید ہو گئے ، یہ کہتے ہوئے اس نے انہی بارہ آدمیوں کے نام گنوا دیئے جو عورت نے بتائے تھے ، نبی ﷽ نے فرمایا اس عورت کو میرے پاس دوبارہ بلا کر لاا ، وہ آئی تو نبی ﷽ نے اس سے فرمایا کہ اپنا خواب اس آدمی کے سامنے بیان کرو ، اس نے بیان کیا تو وہ کہنے لگا کہ اس نے نبی ﷽ سے جس طرح بیان کیا ہے ، حقیقت بھی اسی طرح ہے ۔"
"13734","عبدالرحمن اصم کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے نماز میں تکبیر کا حکم پوچھا تو میں نے انہیں یہ جواب دیتے ہوئے سنا کہ انسان جب رکوع سجدہ کرے ، سجدے سے سر اٹھائے اور دو رکعتوں کے درمیان کھڑا ہو تو تکبیر کہے ، حکیم نے ان سے پوچھا کہ آپ کو یہ حدیث کس کے حوالے سے یاد ہے آ انہوں نے فرمایا نبی ﷽ اور حضرات ابوبکر و عمر رضی اللہ عنہما کے حوالے سے ، پھر وہ خاموش ہو گئے ، حکیم نے ان سے پوچھا کہ حضرت عثمان رضی اللہ عنہ کے حوالے سے بھی آ انہوں نے فرمایا ہاں !"
"13735","حدیث استسقاء اس دوسری سند سے بھی مروی ہے ۔"
"13736","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے نماز فجر پڑھاتے ہوئے نماز ہلکی کر دی ، کسی نے پوچھا یا رسول اللہ ! آپ نے نماز کیوں مختصر کر دی آ نبی ﷽ نے فرمایا میں نے ایک بچے کے رونے کی آواز سنی ، میں سمجھا کہ ہو سکتا ہے اس کی ماں ہمارے ساتھ نماز پڑھ رہی ہو ، اس لئے میں نے چاہا کہ اس کی ماں کو فارغ کر دوں ۔"
"13737","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"13738","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ حضرت اسامہ بن زید رضی اللہ عنہ کا سہارا لیے باہر تشریف لائے ، اس وقت آپ ﷽ کے جسم اطہر پر روئی کا کپڑا تھا ، جس کے دونوں کنارے مخالف سمت سے کندھے پر ڈال رکھے تھے ، اور پھر آپ ﷽ نے لوگوں کو نماز پڑھائی ۔"
"13739","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کو جب ابوسفیان کی آمد کا علم ہوا تو لوگوں سے مشورہ کیا ، اس کے جواب میں حضرت ابوبکر صدیق رضی اللہ عنہ نے ایک مشورہ دیا ، پھر دوبارہ مشورہ مانگا تو حضرت عمر رضی اللہ عنہ نے ایک مشورہ دے دیا ، یہ دیکھ کر نبی ﷽ خاموش ہو گئے ، انصار نے کہا کہ یا رسول اللہ ! شاید آپ کی مراد ہم ہیں آ حضرت سعد رضی اللہ عنہ نے عرض کیا یا رسول اللہ ! اس ذات کی قسم جس کے دست قدرت میں میری جان ہے اگر آپ ہمیں حکم دیں تو سمندروں میں گھس پڑیں ، اور اگر آپ حکم دیں تو ہم برک الغماد تک اونٹوں کے جگر مارتے ہوئے چلے جائیں ، لہٰذا یا رسول اللہ ! معاملہ آپ کے ہاتھ میں ہے ، نبی ﷽ اپنے صحابہ رضی اللہ عنہم کو تیار کر کے روانہ ہو گئے اور بدر میں پڑاا کیا ، قریش کے کچھ جاسوس آئے تو ان میں بنو حجاج کا ایک سیاہ فام غلام بھی تھا ، صحابہ رضی اللہ عنہم نے اسے گرفتار کر لیا ، اور اس سے ابوسفیان اور اس کے ساتھیوں کے متعلق پوچھا ، وہ کہنے لگا کہ ابوسفیان کا تو مجھے کوئی علم نہیں ہے البتہ ابوجہل ، عتبہ بن ربیعہ ، شیبہ اور امیہ بن خلف آ گئے ہیں ، وہ لوگ جب اسے مارتے تو وہ ابوسفیان کے بارے بتانے لگتا اور جب چھوڑتے تو وہ کہتا کہ مجھے ابوسفیان کا کیا پتہ آ البتہ قریش آ گئے ہیں ، اس وقت نبی ﷽ نماز پڑھ رہے تھے ۔ نماز سے فارغ ہو کر نبی ﷽ نے فرمایا یہ جب تم سے سچ بیان کرتا ہے تو تم اسے مارتے ہو اور جب یہ جھوٹ بولتا ہے تو تم اسے چھوڑ دیتے ہو ، پھر نبی ﷽ نے اپنے ہاتھ سے اشارہ کرتے ہوئے فرمایا انشاءاللہ کل فلاں شخص یہاں گرے گا اور فلاں شخص یہاں ، چنانچہ آمنا سامنا ہونے پر مشرکین کو اللہ نے شکست سے دو چار کر دیا اور بخدا ایک آدمی بھی نبی ﷽ کی بتائی ہوئی جگہ سے نہیں ہلا تھا ۔"
"13740","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا سحری کھایا کرو ، کیونکہ سحری میں برکت ہوتی ہے ۔"
"13741","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا ہر نبی کی ایک دعاء ایسی ضرور تھی جو انہوں نے مانگی اور قبول ہو گئی ، جب کہ میں نے اپنی دعاء اپنی امت کی سفارش کرنے کی خاطر قیامت کے دن کے لئے محفوظ کر رکھی ہے ۔"
"13742","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کو راستے میں کھجور پڑی ہوئی ملتی اور انہیں یہ اندیشہ نہ ہوتا کہ یہ صدقہ کی ہو گی تو وہ اسے کھا لیتے تھے ۔"
"13743","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے انہیں اور ان کی ایک عورت کو نماز پڑھائی ، انس رضی اللہ عنہ کو دائیں جانب اور ان کی خاتون کو ان کے پیچھے کھڑا کر دیا ۔"
"13744","حضرت انس رضی اللہ عنہ کے صاحبزادے نضر کہتے ہیں کہ اگر نبی ﷽ نے یہ نہ فرمایا ہوتا کہ تم میں سے کوئی شخص موت کی تمنا نہ کرے تو میں موت کی تمنا ضرور کرتا ، اس وقت حضرت انس رضی اللہ عنہ بھی حیات تھے ۔"
"13745","حضرت حفصہ رضی اللہ عنہا کہتی ہیں کہ حضرت انس رضی اللہ عنہ نے مجھ سے پوچھا کہ ابن ابی عمرہ کیسے فوت ہوئے آ انہوں نے بتایا کہ طاعون کی بیماری سے ، انہوں نے فرمایا کہ نبی ﷽ نے ارشاد فرمایا طاعون ہر مسلمان کے لئے شہادت ہے ۔"
"13746","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا لوگوں کو کیا ہو گیا ہے کہ دورانْ نماز آسمان کی طرف نگاہیں اٹھا کر دیکھتے ہیں آ نبی ﷽ نے شدت سے اس کی ممانعت کرتے ہوئے فرمایا کہ لوگ اس سے باز آ جائیں ورنہ ان کی بصارت اچک لی جائے گی ۔"
"13747","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک انصاری عورت اپنے بچے کے ساتھ نبی ﷽ کی خدمت میں حاضر ہوئی ، نبی ﷽ نے اس سے فرمایا اس ذات کی قسم جس کے دست قدرت میں میری جان ہے ، تم لوگ مجھے تمام لوگوں میں سب سے زیادہ محبوب ہو ، یہ جملہ تین مرتبہ فرمایا 1"
"13748","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا اللہ تعالیٰ جب کسی بندہ مسلم کو جسمانی طور پر کسی بیماری میں مبتلا کرتا ہے تو فرشتوں سے کہہ دیتا ہے کہ یہ جتنے نیک کام کرتا ہے ان کا ثواب برابر لکھتے رہو ، پھر اگر اسے شفاء مل جائے تو اللہ اسے دھو کر پاک صاف کر چکا ہوتا ہے اور اگر اسے اپنے پاس واپس بلا لے تو اس کی مغفرت کر دیتا ہے اور اس پر رحم فرماتا ہے ۔"
"13749","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ قربانی کا جانور اپنے ہاتھ سے ذبح کرتے تھے اور اس پر تکبیر پڑھتے تھے ۔"
"13750","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دو چتکبرے سینگ دار مینڈھے قربانی میں پیش کیا کرتے تھے ، اور اللہ کا نام لے کر تکبیر کہتے تھے ، میں نے دیکھا ہے کہ نبی ﷽ انہیں اپنے ہاتھ سے ذبح کرتے تھے اور ان کے پہلو پر اپنا پااں رکھتے تھے ۔"
"13751","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کا رنگ گندمی تھا ، اور میں نے نبی ﷽ کی مہک سے عمدہ کوئی مہک نہیں سونگھی خواہ وہ مشک ہو یا عنبر ۔"
"13752","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ پانچ مکوک پانی سے غسل اور ایک مکوک پانی سے وضو فرما لیا کرتے تھے ۔"
"13753","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب قضاء حاجت کے لئے جاتے تو میں اور ایک لڑکا پانی کا برتن پیش کرتے تھے ۔"
"13754","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے ہمیں نماز پڑھائی اور منبر پر بیٹھ کر قبلہ کی جانب اپنے ہاتھ سے اشارہ کر کے فرمایا لوگو ! میں نے آج تمہیں جو نماز میں پڑھائی ہے اس میں جنت اور جہنم کو اپنے سامنے دیکھا کہ وہ اس دیوار میں میرے سامنے پیش کی گئی ہیں ، میں نے آج جیسا بہترین اور سخت ترین دن نہیں دیکھا تین مرتبہ فرمایا ۔"
"13755","حضرت انس رضی اللہ عنہ سے مروی ہے کہ مجھے نبی ﷽ کے بعض ایسے صحابہ رضی اللہ عنہم نے """" جنہیں میں متہم نہیں سمجھتا """" بتایا کہ ایک دن نبی ﷽ اور حضرت بلال رضی اللہ عنہ جنت البقیع میں چلے جا رہے تھے ، نبی ﷽ نے فرمایا بلال ! جیسے میں سن رہا ہوں کیا تم بھی کوئی آواز سن رہے ہو آ انہوں نے عرض کیا یا رسول اللہ ﷽ ! بخدا ! میں تو کوئی آواز نہیں سن رہا ، نبی ﷽ نے فرمایا کیا تم نہیں سن رہے کہ اہل جاہلیت کو ان کی قبروں میں عذاب دیا جا رہا ہے ۔"
"13756","حضرت انس رضی اللہ عنہ ، حضرت عمر بن عبدالعزیز رضی اللہ عنہ کے متعلق """" جب کہ وہ مدینہ منورہ میں تھے """" فرماتے تھے کہ میں نے تمہارے اس امام سے زیادہ نبی ﷽ کے ساتھ مشابہت رکھنے والی نماز پڑھتے ہوئے کسی کو نہیں دیکھا ، حضرت عمر بن عبدالعزیز رحمۃ اللہ طویل قراءت نہ کرتے تھے ۔"
"13757","حمید رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ کے پاس نبی ﷽ کا ایک پیالہ دیکھا جس میں چاندی کا حلقہ لگا ہوا تھا ۔"
"13758","[Darussalam 13722] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13759","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ میں نبی ﷽ کی خدمت میں حاضر ہوا تو دیکھا کہ آپ ﷽ باڑے میں بکری کے کان پر داغ رہے ہیں ۔"
"13760","حضرت انس رضی اللہ عنہ سے مروی ہے کہ آپ ﷽ نے ایک مہینے تک فجر کی نماز میں قنوت نازلہ پڑھی اور رعل ، ذکوان ، اور عصیہ لحیان کے قبائل پر بددعاء کرتے رہے ، جنہوں نے اللہ اور اس کے رسول کی نافرمانی کی ۔"
"13761","حضرت انس رضی اللہ عنہ سے مروی ہے کہ آپ ﷽ نے ایک مہینے تک فجر کی نماز میں قنوت نازلہ پڑھی اور رعل ، ذکوان ، اور عصیہ لحیان کے قبائل پر بددعاء کرتے رہے ، جنہوں نے اللہ اور اس کے رسول کی نافرمانی کی ۔"
"13762","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دعاء میں ہاتھ اتنے اٹھاتے تھے کہ آپ ﷽ کی مبارک بغلوں کی سفیدی تک دکھائی دیتی ۔"
"13763","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے صحابہ رضی اللہ عنہم میں سے کچھ لوگوں نے ازواج مطہرات سے نبی ﷽ کی انفرادی عبادت کے متعلق سوال کیا ، نبی ﷽ کو جب یہ بات معلوم ہوئی تو آپ ﷽ نے اللہ کی حمد و ثناء کے بعد فرمایا لوگوں کو کیا ہو گیا ہے کہ ایسی ایسی باتیں کرتے ہیں ، میں تو روزہ بھی رکھتا ہوں اور ناغہ بھی کرتا ہوں ، نماز بھی پڑھتا ہوں اور سوتا بھی ہوں ، اور عورتوں سے شادی بھی کرتا ہوں ، اب جو شخص میری سنت سے اعراض کرتا ہے ، وہ مجھ سے نہیں ہے ۔"
"13764","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ چھ ماہ تک مسلسل جب نماز فجر کے وقت حضرت فاطمہ رضی اللہ عنہا کے گھر کے قریب سے گذرتے تھے تو فرماتے تھے اے اہل بیت ! نماز کے لئے بیدار ہو جاا ، """" اے اہل بیت ! اللہ چاہتا ہے کہ تم سے گندگی کو دور کر دے اور تمہیں خوب پاک کر دے """""
"13765","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا قیامت اس وقت تک قائم نہیں ہو گی ، جب تک زمین میں اللہ اللہ کہنے والا کوئی شخص باقی ہے ۔"
"13766","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی آیا اور اس نے نبی ﷽ سے کچھ مانگا ، نبی ﷽ نے اسے صدقہ کی بکریوں میں سے بہت سی بکریاں """" جو دو پہاڑوں کے درمیان آ سکیں """" دینے کا حکم دے دیا ، وہ آدمی اپنی قوم کے پاس آ کر کہنے لگا لوگو ! اسلام قبول کر لو ، کیونکہ محمد ﷽ اتنی بخشش دیتے ہیں کہ انسان کو فقر و فاقہ کو کوئی اندیشہ نہیں رہتا ، اور بعض اوقات نبی ﷽ کے پاس ایک آدمی آ کر صرف دنیا کا ساز و سامان حاصل کرنے کے لئے اسلام قبول کر لیتا ، لیکن اس دن کی شام تک دین اس کی نگاہوں میں سب سے زیادہ محبوب ہو چکا ہوتا تھا ۔"
"13767","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے پاس ایک سائل آیا ، نبی ﷽ نے اسے کھجوریں دینے کا حکم دیا ، لیکن اس نے انہیں ہاتھ نہ لگایا ، دوسرا آیا تو نبی ﷽ نے اسے کھجوریں دینے کا حکم دیا ، اس نے خوش ہو کر انہیں قبول کر لیا اور کہنے لگا سبحان اللہ ! نبی ﷽ کی طرف سے کھجوریں ، اس پر نبی ﷽ نے اپنی باندی سے فرمایا کہ ام سلمہ رضی اللہ عنہا کے پاس جاا اور اسے ان کے پاس رکھے ہوئے چالیس درہم دلوا دو ۔"
"13768","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوطلحہ رضی اللہ عنہ کی سرپرستی میں کچھ یتیم زیر پرورش تھے ، انہوں نے ان کے پیسوں سے شراب خرید کر رکھ لی ، جب شراب حرام ہو گئی تو انہوں نے نبی ﷽ سے پوچھا کہ اگر یتیم بچوں کے پاس شراب ہو تو کیا ہم اسے سرکہ نہیں بنا سکتے آ نبی ﷽ نے فرمایا نہیں چنانچہ انہوں نے اسے بہا دیا ۔"
"13769","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوطلحہ رضی اللہ عنہ کی سرپرستی میں کچھ یتیم زیر پرورش تھے ، انہوں نے ان کے پیسوں سے شراب خرید کر رکھ لی ، جب شراب حرام ہو گئی تو انہوں نے نبی ﷽ سے پوچھا کہ اگر یتیم بچوں کے پاس شراب ہو تو کیا ہم اسے سرکہ نہیں بنا سکتے آ نبی ﷽ نے فرمایا نہیں چنانچہ انہوں نے اسے بہا دیا ۔"
"13770","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے پاس وضو کے لئے پانی کا برتن لایا گیا اور نبی ﷽ نے اس سے وضو فرمایا ، راوی کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کیا نبی ﷽ ہر نماز کے وقت نیا وضو فرماتے تھے آ انہوں نے فرمایا ہاں ! راوی نے حضرت انس رضی اللہ عنہ سے پوچھا کہ آپ لوگ کیا کرتے تھے آ انہوں نے جواب دیا کہ ہم بے وضو ہونے تک ایک ہی وضو سے کئی کئی نمازیں بھی پڑھ لیا کرتے تھے ۔"
"13771","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا صفیں جوڑ کر اور قریب قریب ہو کر بنایا کرو ، کندھے ملا لیا کرو ، ۳ کیونکہ اس ذات کی قسم جس کے دست قدرت میں محمد ﷽ کی جان ہے ، میں دیکھتا ہوں کہ چھوٹی بھیڑوں کی طرح شیاطین صفوں کے بیچ میں گھس جاتے ہیں ۔"
"13772","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک یہودی لڑکا نبی ﷽ کی خدمت کرتا تھا ، ایک مرتبہ وہ بیمار ہو گیا ، نبی ﷽ اس کے پاس عیادت کے لیے تشریف لے گئے ، نبی ﷽ نے اسے کلمہ پڑھنے کی تلقین کی ، اس نے اپنے باپ کو دیکھا ، اس نے کہا کہ ابوالقاسم ﷽ کی بات مانو ، چنانچہ اس لڑکے نے کلمہ پڑھ لیا ، نبی ﷽ نے فرمایا اپنے بھائی کی نماز جنازہ پڑھو ۔"
"13773","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے میری کنیت اس سبزی کے نام پر رکھی تھی جو میں چنتا تھا ۔"
"13774","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے مجھے """" اے دو کانوں والے """" کہہ کر مخاطب فرمایا تھا ۔"
"13775","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا شب معراج چوتھے آسمان پر میری ملاقات حضرت ادریس علیہ السلام سے کرائی گئی ۔"
"13776","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ جب جنتی انہیں دیکھیں گے تو کہیں گے کہ یہ جہنمی ہیں ۔"
"13777","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت حارثہ رضی اللہ عنہ کو غزوہ بدر میں کہیں سے ناگہانی تیر آ کر لگا اور وہ شہید ہو گئے ، ان کی والدہ ربیع نے بارگاہ رسالت میں عرض کیا یا رسول اللہ ﷽ ! آپ مجھے حارثہ کے متعلقہ کیوں نہیں بتاتے آ آپ جانتے ہیں کہ مجھے حارثہ سے کتنی محبت تھی ، اگر تو وہ جنت میں ہے تو میں صبر کر لوں گی ، ورنہ پھر میں اس پر خوب آہ و بکا کروں گی ، نبی ﷽ نے فرمایا اے ام حارثہ ! جنت صرف ایک تو نہیں ہے ، وہ تو بہت سی جنتیں ہیں اور تمہارا بیٹا ان میں سب سے افضل جنت میں ہے ۔"
"13778","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کسی سفر میں تھے ، آپ ﷽ کے پیچھے سواری پر حضرت معاذ بن جبل رضی اللہ عنہ بیٹھے تھے ، اور ان دونوں کے درمیان کجاوے کے پچھلے حصے کے علاوہ کوئی اور چیز حائل نہ تھی ، اسی دوران نبی ﷽ نے دو مرتبہ کچھ وقفے سے حضرت معاذ رضی اللہ عنہ کو ان کا نام لے کر پکارا اور انہوں نے دونوں مرتبہ کہا """" لبیک یا رسول اللہ وسعدیک """" نبی ﷽ نے فرمایا کیا تم جانتے ہو کہ بندوں پر اللہ تعالی کا کیا حق ہے آ انہوں نے عرض کیا اللہ اور اس کے رسول ہی بہتر جانتے ہیں ، نبی ﷽ نے فرمایا بندوں پر اللہ کا حق یہ ہے کہ وہ صرف اسی کی عبادت کریں ، اور کسی کو اس کے ساتھ شریک نہ ٹھہرائیں ، کیا تم یہ جانتے ہو کہ بندے جب یہ کام کر لیں تو اللہ پر بندوں کا کیا حق ہے آ انہوں نے عرض کیا کہ اللہ اور اس کے رسول ہی بہتر جانتے ہیں ، نبی ﷽ نے فرمایا اللہ پر بندوں کا حق یہ ہے کہ انہیں عذاب نہ دے ۔"
"13779","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ جمعہ کے دن """" جبکہ نبی ﷽ مدینہ منورہ میں خطبہ ارشاد فرما رہے تھے """" نبی ﷽ سے ایک آدمی نے عرض کیا کہ یا رسول اللہ ﷽ ! بارش رک گئی ہے ، زمین بنجر ہو رہی ہے اور لوگ خشک سالی کا شکار ہیں ، بارش کی دعا کر دیجئے ، نبی ﷽ نے طلب باراں کے حوالے سے دعاء فرمائی ، جس وقت آپ ﷽ نے اپنے دست مبارک بلند کیے تھے ، اس وقت ہمیں آسمان پر کوئی بادل نظر نہیں آ رہا تھا ، اور جب بارش شروع ہوئی تو رکتی ہوئی نظر نہ آئی ، چنانچہ بادل بنے اور بارش اتنی ہوئی کہ مدینہ منورہ کی گلیاں بہنے لگیں اور راستے نہروں کا منظر پیش کرنے لگے ، جب اگلا جمعہ ہوا تو اسی شخص نے عرض کیا یا رسول اللہ ﷽ ! بارش رکنے کی دعا کر دیں ، یہ سن کر نبی ﷽ نے تبسم فرمایا اور اللہ سے دعا کی کہ اے اللہ ! یہ بارش ہمارے آس پاس برسا ، ہم پر نہ برسا اور میں نے دیکھا کہ بادل دائیں بائیں چھٹ گئے اور مدینہ کے اندر ایک قطرہ بھی نہیں ٹپک رہا تھا ۔"
"13780","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے انہیں اور ان کی ایک عورت کو نماز پڑھائی ، انس رضی اللہ عنہ کو دائیں جانب اور ان کی خاتون کو ان کے پیچھے کھڑا کر دیا ۔"
"13781","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا لشکر میں ابوطلحہ رضی اللہ عنہ کی آواز ہی کئی لوگوں سے بہتر ہے ، حضرت ابوطلحہ رضی اللہ عنہ جنگ کے موقع پر نبی ﷽ کے سامنے سینہ سپر ہو جاتے تھے اور اپنا ترکش ہلاتے ہوئے کہتے تھے کہ میرا چہرہ آپ کے چہرے کے لئے بچاا اور میری ذات آپ کی ذات پر فدا ہو ۔"
"13782","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی خدمت میں جب خوشبو پیش کی جاتی تو آپ ﷽ اسے رد نہ فرماتے تھے ۔"
"13783","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ رات کے وقت اہل مدینہ دشمن کے خوف سے گھبرا اٹھے ، نبی ﷽ حضرت ابوطلحہ رضی اللہ عنہ کے ایک سست رفتار گھوڑے پر سوار ہوئے ، اور اکیلے ہی اسے ایڑ لگا کر نکل پڑے ، لوگ بھی سوار ہو کر نبی ﷽ کے پیچھے چل پڑے ، دیکھا تو نبی ﷽ واپس چلے آ رہے ہیں اور لوگوں سے کہتے جا رہے ہیں کہ گھبرانے کی کوئی بات نہیں ، مت گھبراا اور گھوڑے کے متعلق فرمایا کہ ہم نے اسے سمندر جیسا رواں پایا ، بخدا اس کے بعد اس سے کوئی گھوڑا آگے نہ بڑھ سکا ۔"
"13784","حضرت انس رضی اللہ عنہ سے مروی ہے کہ عبیداللہ بن زیاد کے پاس حضرت امام حسین رضی اللہ عنہ کا سر لایا گیا ، اسے ایک طشتری میں رکھا گیا ، ابن زیاد اسے چھڑی سے کریدنے لگا ، اور ان کے حسن و جمال سے متعلق کچھ نازیبا بات کہی ، حضرت انس رضی اللہ عنہ نے فوراَ فرمایا کہ یہ تمام صحابہ رضی اللہ عنہم میں نبی ﷽ کے سب سے زیادہ مشابہہ تھے ، اس وقت ان پر وسمہ کا خضاب ہوا ہوا تھا ۔"
"13785","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی خدمت میں جب خوشبو پیش کی جاتی تو آپ ﷽ اسے رد نہ فرماتے تھے اس لیے حضرت انس رضی اللہ عنہ بھی اسے رد نہیں کرتے تھے ۔"
"13786","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کا گذر ایک آدمی پر ہوا جو قربانی کا جانور ہانکتے ہوئے چلا جا رہا تھا ، نبی ﷽ نے اس سے سوار ہونے کے لئے فرمایا ، اس نے کہا کہ یہ قربانی کا جانور ہے ، نبی ﷽ نے فرمایا کہ اگرچہ قربانی کا جانور ہی ہو ۔"
"13787","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے سینگی لگوائی اور آپ ﷽ کسی کی مزدوری کے معاملے میں اس پر ظلم نہیں فرماتے تھے ۔"
"13788","حضرت انس رضی اللہ عنہ سے مروی ہے کہ آپ ﷽ نے ایک مہینے تک فجر کی نماز میں قنوت نازلہ پڑھی اور عرب کے کچھ قبائل پر بددعاء کرتے رہے پھر اسے ترک فرما دیا تھا ۔"
"13789","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہر سال یا دن کے بعد آنے والا سال اور دن اس سے بدتر ہو گا ، میں نے یہ بات تمہارے نبی ﷽ سے سنی ہے ۔"
"13790","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جو شخص مجھ پر ایک مرتبہ درود پڑھے گا ، اللہ اس پر دس رحمتیں نازل فرمائے گا اور اس کے دس گناہ معاف فرمائے گا ۔"
"13791","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص تین مرتبہ جنت کا سوال کر لے تو جنت خود کہتی ہے کہ اے اللہ ! اس بندے کو مجھ میں داخلہ عطاء فرما اور جو شخص تین مرتبہ جہنم سے پناہ مانگ لے ، جہنم خود کہتی ہے کہ اے اللہ ! اس بندے کو مجھ سے بچا لے ۔"
"13792","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک یہودی نے ایک انصاری بچی کو اس زیور کی خاطر قتل کر دیا جو اس نے پہن رکھا تھا ، اور پتھر مار مار کر اس کا سر کچل دیا ، جب اس بچی کو نبی ﷽ کے پاس لایا گیا تو اس میں زندگی کی تھوڑی سی رمق باقی تھی ، نبی ﷽ نے ایک آدمی کا نام لے کر اس سے پوچھا کہ تمہیں فلاں آدمی نے مارا ہے آ اس نے سر کے اشارے سے کہا نہیں ، دوسری مرتبہ بھی یہی ہوا ، تیسری مرتبہ اس نے کہا ہاں ! تو نبی ﷽ نے اس یہودی کا سر دو پتھروں کے درمیان کچلنے کا حکم دے دیا ۔"
"13793","قتادہ رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ کیا نبی ﷽ نے خضاب لگایا ہے آ انہوں نے فرمایا یہاں تک نوبت ہی نہیں آئی ، نبی ﷽ کی کنپٹیوں میں چند بال سفید تھے ، البتہ حضرت ابوبکر صدیق رضی اللہ عنہ مہندی اور وسمہ کا خضاب لگاتے تھے ۔"
"13794","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ سے زیادہ ہلکی اور مکمل نماز کسی امام کے پیچھے نہیں پڑھی ۔"
"13795","[Darussalam 13759] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13796","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص نماز عصر پڑھے ، پھر بیٹھ کر اچھی بات املاء کروائے تاآنکہ شام ہو جائے ، تو یہ حضرت اسماعیل علیہ السلام کی اولاد میں سے آٹھ غلام آزاد کرنے سے زیادہ افضل ہے ۔"
"13797","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ حضرت اسامہ بن زید رضی اللہ عنہ کا سہارا لیے باہر تشریف لائے ، اس وقت آپ ﷽ کے جسم اطہر پر ایک کپڑا تھا ، جس کے دونوں کنارے مخالف سمت سے کندھے پر ڈال رکھے تھے ، اور پھر آپ ﷽ نے لوگوں کو نماز پڑھائی ۔"
"13798","گذشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"13799","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ حضرت اسامہ بن زید رضی اللہ عنہ کا سہارا لیے باہر تشریف لائے ، اس وقت آپ ﷽ کے جسم اطہر پر روئی کا کپڑا تھا ، جس کے دونوں کنارے مخالف سمت سے کندھے پر ڈال رکھے تھے ، اور پھر آپ ﷽ نے لوگوں کو نماز پڑھائی ۔"
"13800","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا حضرت موسیٰ علیہ السلام جب نہر کے پانی میں غوطہ لگانے کا ارادہ کرتے تو اس وقت تک کپڑے نہ اتارتے تھے جب تک پانی میں اپنا ستر چھپا نہ لیتے ۔"
"13801","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور حضرت ابوبکر و عمر و عثمان رضی اللہ عنہم تکبیر مکمل کیا کرتے تھے ، جب سجدے میں جاتے یا سر اٹھاتے + تب بھی تکبیر کہا کرتے تھے , ۔"
"13802","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ اپنے صحابہ رضی اللہ عنہم کے درمیان تشریف فرما تھے کہ ایک یہودی نے نبی ﷽ کو سلام کرتے ہوئے ®السام علیک¾ کہا ، نبی ﷽ نے صحابہ رضی اللہ عنہم سے فرمایا اسے میرے پاس بلا کر لاا ، اور اس سے پوچھا کہ کیا تم نے ®السام علیک¾ کہا تھا آ اس نے اقرار کیا تو نبی ﷽ نے + اپنے صحابہ رضی اللہ عنہم سے , فرمایا جب تمہیں کوئی """" کتابی """" سلام کرے تو صرف ®وعلیک¾ کہا کرو ۔"
"13803","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب یہ آیت نازل ہوئی کہ """" تم نیکی کے اعلیٰ درجے کو اس وقت تک حاصل نہیں کر سکتے جب تک اپنی پسندیدہ چیز خرچ نہ کرو """" اور یہ آیت کہ """" کون ہے جو اللہ کو قرض حسنہ دیتا ہے """" تو حضرت ابوطلحہ رضی اللہ عنہ کہنے لگے یا رسول اللہ ! میرا فلاں باغ جو فلاں جگہ پر ہے ، وہ اللہ کے نام پر دیتا ہوں اور بخدا ! اگر یہ ممکن ہوتا کہ میں اسے مخفی رکھوں تو کبھی اس کا پتہ بھی نہ لگنے دیتا ، نبی ﷽ نے فرمایا اسے اپنے خاندان کے فقراء میں تقسیم کر دو ۔"
"13804","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا تمہارے پاس ایسی قومیں آئیں گی جن کے دل تم سے بھی زیادہ نرم ہوں گے ، چنانچہ ایک مرتبہ اشعریین آئے ، ان میں حضرت ابوموسیٰ اشعری رضی اللہ عنہ بھی شامل تھے ، جب وہ مدینہ منورہ کے قریب پہنچے تو یہ رجزیہ شعر پڑھنے لگے کہ کل ہم اپنے دوستوں یعنی محمد + ﷽ , اور ان کے ساتھیوں سے ملاقات کریں گے ۔"
"13805","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جس پہلی رات نبی ﷽ حضرت زینب بنت جحش رضی اللہ عنہا کے یہاں رہے ، اس کی صبح نبی ﷽ نے دعوت ولیمہ دی ، اور مسلمانوں کو خوب پیٹ بھر کر روٹی اور گوشت کھلایا ، پھر حسب معمول واپس تشریف لے گئے اور ازواجْ مطہرات کے گھر میں جا کر انہیں سلام کیا اور انہوں نے نبی ﷽ کے لئے دعائیں کیں ، پھر واپس تشریف لائے ، جب گھر پہنچے تو دیکھا کہ دو آدمیوں کے درمیان گھر کے ایک کونے میں باہم گفتگو جاری ہے ، نبی ﷽ ان دونوں کو دیکھ کر پھر واپس چلے گئے ، جب ان دونوں نے نبی ﷽ کو اپنے گھر سے پلٹتے ہوئے دیکھا تو وہ جلدی سے اٹھ کھڑے ہوئے ، اب مجھے یاد نہیں کہ نبی ﷽ کو ان کے جانے کی خبر میں نے دی یا کسی اور نے ، بہرحال ! نبی ﷽ نے گھر واپس آ کر میرے اور اپنے درمیان پردہ لٹکا لیا اور آیت حجاب نازل ہو گئی ۔"
"13806","حضرت انس رضی اللہ عنہ سے مروی ہے کہ بنو سلمہ نے ایک مرتبہ یہ ارادہ کیا کہ اپنی پرانی رہائش گاہ سے منتقل ہو کر مسجد کے قریب آ کر سکونت پذیر ہو جائیں ، نبی ﷽ کو یہ بات معلوم ہوئی تو آپ ﷽ کو مدینہ منورہ کا خالی ہونا اچھا نہ لگا ، اس لئے فرمایا اے بنو سلمہ ! کیا تم مسجد کی طرف اٹھنے والے قدموں کا ثواب حاصل کرنا نہیں چاہتے ۔"
"13807","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ خیبر کے دن نبی ﷽ خیبر کی طرف روانہ ہوئے ، مسلمان سوار ہو گئے ، میں حضرت ابوطلحہ رضی اللہ عنہ کے پیچھے سواری پر بیٹھا ہوا تھا اور میرے پااں نبی ﷽ کے پااں کو چھو رہے تھے ، ہم وہاں پہنچے تو سورج نکل چکا تھا اور اہل خیبر اپنے مویشیوں کو نکال کر کلہاڑیاں اور کدالیں لے کر اپنی زمینوں اور کھیتوں کی طرف نکل چکے تھے ، ہمیں دیکھ کر وہ بھاگ کھڑے ہوئے اور کہنے لگے محمد + ﷽ , اور لشکر آ گئے ، نبی ﷽ نے اللہ اکبر کہہ کر فرمایا کہ خیبر برباد ہو گیا ، جب ہم کسی قوم کے صحن میں اترتے ہیں تو ڈرائے ہوئے لوگوں کی صبح بڑی بدترین ہوتی ہے ۔"
"13808","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ اپنی کسی اہلیہ + غالباَ حضرت عائشہ رضی اللہ عنہا + کے پاس تھے ، دوسری اہلیہ نے نبی ﷽ کے پاس اپنے خادم کے ہاتھ ایک پیالہ بھجوایا جس میں کھانے کی کوئی چیز تھی ، حضرت عائشہ رضی اللہ عنہا نے اس خادم کے ہاتھ پر مارا جس سے اس کے ہاتھ سے پیالہ نیچے گر کر ٹوٹ گیا اور دو ٹکڑے ہو گیا ، نبی ﷽ نے یہ دیکھ کر فرمایا کہ تمہاری ماں نے اسے برباد کر دیا ، پھر برتن کے دونوں ٹکڑے لے کر انہیں جوڑا اور ایک دوسرے کے ساتھ ملا کر کھانا اس میں سمیٹا اور فرمایا اسے کھاا ، اور فارغ ہونے تک اس خادم کو روکے رکھا ، اس کے بعد خادم کو دوسرا پیالہ دے دیا اور ٹوٹا ہوا پیالہ اسی گھر میں چھوڑ دیا ۔"
"13809","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ مسلمانوں نے نبی ﷽ کو بدر کے کنوئیں پر یہ آواز لگاتے ہوئے سنا اے ابوجہل بن ہشام ! اے عتبہ بن ربیعہ ! اے شیبہ بن ربیعہ ! اور اے امیہ بن خلف ! کیا تم سے تمہارے رب نے جو وعدہ کیا تھا ، اسے تم نے سچا پایا آ مجھ سے تو میرے رب نے جو وعدہ کیا تھا ، میں نے اسے سچا پایا ۔ صحابہ رضی اللہ عنہم نے عرض کیا یا رسول اللہ ﷽ ! آپ ان لوگوں کو آواز دے رہے ہیں جو مردہ ہو چکے آ نبی ﷽ نے فرمایا میں جو بات کہہ رہا ہوں ، تم ان سے زیادہ نہیں سن رہے ، البتہ وہ اس کا جواب نہیں دے سکتے ۔"
"13810","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اس بات کو پسند فرماتے تھے کہ نماز میں مہاجرین اور انصار مل کر ان کے قریب کھڑے ہوں تاکہ احکام نماز سیکھ سکیں ۔"
"13811","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ایک مرتبہ میں جنت میں داخل ہوا تو وہاں سونے کا ایک محل نظر آیا ، میں نے پوچھا یہ محل کس کا ہے آ لوگوں نے بتایا کہ یہ ایک قریشی نوجوان کا ہے ، میں سمجھا کہ شاید وہ میں ہی ہوں ، اس لئے پوچھا وہ کون ہے آ لوگوں نے بتایا عمر بن خطاب رضی اللہ عنہ ۔"
"13812","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا میں جنت میں داخل ہوا تو اچانک ایک نہر پر نظر پڑی ، جس کے دونوں کناروں پر موتیوں کے خیمے لگے ہوئے تھے ، میں نے اس میں ہاتھ ڈال کر پانی میں بہنے والی چیز کو پکڑا تو وہ مہکتی ہوئی مشک تھی ، میں نے جبریل علیہ السلام سے پوچھا کہ یہ کیا ہے آ تو انہوں نے بتایا کہ یہ نہر کوثر ہے جو اللہ نے آپ کو عطاء فرمائی ہے ۔"
"13813","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نماز کھڑی ہوئی تو نبی ﷽ ہماری طرف متوجہ ہوئے اور فرمایا صفیں سیدھی کر لو اور جڑ کر کھڑے ہو کیونکہ میں تمہیں اپنے پیچھے سے بھی دیکھتا ہوں ۔"
"13814","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نماز کھڑی ہوئی تو نبی ﷽ ہماری طرف متوجہ ہوئے اور فرمایا صفیں سیدھی کر لو اور جڑ کر کھڑے ہو کیونکہ میں تمہیں اپنے پیچھے سے بھی دیکھتا ہوں ۔"
"13815","حدیث نمبر + 45796 , اس دوسری سند سے بھی مروی ہے ۔"
"13816","[Darussalam 13780] حضرت انس رضی اللہ تعالی عنہ سے مروی ہے کہ نبی صلی اللہ علیہ وآلہ وسلم نے ارشاد فرمایا اللہ کے راستے میں ایک صبح یا شام جہاد کرنا، دنیا و مافیھا سے بہتر ہے اور تم میں سے کسی کے کمان یا کوڑا رکھنے کی جنت میں جو جگہ ہوگی وہ دنیا ومافیہا سے بہتر ہے اور اگر کوئی جنتی عورت زمین کی طرف جھانک کر دیکھ لے تو ان دونوں کے درمیانی جگہ خوشبو سے بھر جائے اور مہک پھیل جائے اور اس کے سر کا دوپٹہ دنیا ومافیہا سے بہتر ہے۔"
"13817","حمید کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے نبی ﷽ کی رات کی نماز کے متعلق پوچھا تو انہوں نے فرمایا کہ ہم رات کے جس وقت نبی ﷽ کو نماز پڑھتے ہوئے دیکھنا چاہتے تھے ، دیکھ سکتے تھے اور جس وقت سوتا ہوا دیکھنے کا ارادہ ہوتا تو وہ بھی دیکھ لیتے تھے ، اسی طرح نبی ﷽ کسی مہینے میں اس تسلسل کے ساتھ روزے رکھتے کہ ہم یہ سوچنے لگتے کہ اب نبی ﷽ کوئی روزہ نہیں چھوڑیں گے اور بعض اوقات روزے چھوڑتے تو ہم کہتے کہ شاید اب نبی ﷽ کوئی روزہ نہیں رکھیں گے ۔"
"13818","حضرت انس رضی اللہ عنہ سے کسی شخص نے عذاب قبر اور دجال کے متعلق پوچھا تو فرمایا کہ نبی ﷽ یہ دعاء فرمایا کرتے تھے اے اللہ ! میں سستی ، بزدلی ، بخل ، فتنہ دجال اور عذاب قبر سے آپ کی پناہ میں آتا ہوں ۔"
"13819","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ام سلیم رضی اللہ عنہا نے میرے ہاتھ ایک تھیلی میں تر کھجوریں بھر کر نبی ﷽ کی خدمت میں بھیجیں ، میں نے نبی ﷽ کو گھر میں نہ پایا ، کیونکہ نبی ﷽ قریب ہی اپنے ایک آزاد کردہ غلام کے یہاں گئے ہوئے تھے جس نے نبی ﷽ کی دعوت کی تھی ، میں وہاں پہنچا تو نبی ﷽ کھانا تناول فرما رہے تھے ، نبی ﷽ نے مجھے بھی کھانے کے لئے بلا لیا ، دعوت میں صاحب خانہ نے گوشت اور کدو کا ثرید تیار کر رکھا تھا ، نبی ﷽ کو کدو بہت پسند تھا ، اس لئے میں اسے الگ کر کے نبی ﷽ کے سامنے کرتا رہا ، جب کھانے سے فارغ ہو کر نبی ﷽ اپنے گھر واپس تشریف لائے تو میں نے وہ تھیلی نبی ﷽ کے سامنے رکھ دی ، نبی ﷽ اسے کھاتے گئے اور تقسیم کرتے گئے یہاں تک کہ تھیلی خالی ہو گئی ۔"
"13820","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ اور حضرات شیخین رضی اللہ عنہم کے ساتھ نماز پڑھی ہے ، یہ حضرات اونچی آواز سے بسم اللہ نہیں پڑھتے تھے ۔"
"13821","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا عائشہ رضی اللہ عنہا کو دیگر عورتوں پر ایسی ہی فضیلت ہے جیسے ثرید کو دوسرے کھانوں پر ۔"
"13822","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے خیبر اور مدینہ منورہ کے درمیان تین دن قیام فرمایا ، اور حضرت صفیہ بنت حیی رضی اللہ عنہا کے ساتھ خلوت فرمائی ، میں نے مسلمانوں کو نبی ﷽ کے ولیمے کی دعوت دی ، اس میں کوئی روٹی اور گوشت نہ تھا ، نبی ﷽ نے ہمیں دسترخوان بچھانے کا حکم دیا ، اور اس پر کھجوریں ، پنیر اور گھی لا کر رکھ دیا ، یہی نبی ﷽ کا ولیمہ تھا ، مسلمان آپس میں باتیں کرنے لگے کہ حضرت صفیہ رضی اللہ عنہا بھی امہات المومنین میں سے ہوں گی یا باندیوں میں سے آ پھر آپس میں خود ہی کہنے لگے کہ اگر نبی ﷽ نے انہیں پردہ کرایا تو یہ امہات المومنین میں سے ہوں گی ، اور اگر پردہ نہ کرایا تو یہ باندیوں میں سے ہوں گی ، چنانچہ نبی ﷽ نے جب کوچ فرمایا تو پیچھے سے ان کے لئے سواری پر چڑھنے میں مدد کی اور لوگوں اور ان کے درمیان پردہ کھینچ دیا ۔"
"13823","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت حارثہ رضی اللہ عنہ کو غزوہ بدر میں کہیں سے ناگہانی تیر آ کر لگا اور وہ شہید ہو گئے ، ان کی والدہ نے بارگاہ رسالت میں عرض کیا یا رسول اللہ ﷽ ! آپ جانتے ہیں کہ مجھے حارثہ سے کتنی محبت تھی ، اگر تو وہ جنت میں ہے تو میں صبر کر لوں گی ، ورنہ پھر میں جو کروں گی وہ آپ بھی دیکھ لیں گے آ نبی ﷽ نے فرمایا اری پگلی ! جنت صرف ایک تو نہیں ہے ، وہ تو بہت سی جنتیں ہیں اور حارثہ ان میں سب سے افضل جنت میں ہے ۔"
"13824","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا تمہارے لیے وضو میں ایک مد پانی کافی ہو جانا چاہئے ۔"
"13825","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا قیامت کے دن سب سے زیادہ لمبی گردنوں والے لوگ ماذن ہوں گے ۔"
"13826","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے بنت ملحان کے گھر میں ٹیک لگائی ، سر اٹھایا تو آپ ﷽ کے چہرے پر مسکراہٹ تھی ، انہوں نے نبی ﷽ سے مسکرانے کی وجہ پوچھی تو نبی ﷽ نے فرمایا مجھے اپنی امت کے ان لوگوں کو دیکھ کر ہنسی آئی جو اس سبز سمندر پر اللہ کے راستے میں جہاد کے لئے سوار ہو کر نکلیں گے ، اور وہ ایسے محسوس ہوں گے کہ گویا تختوں پر بادشاہ بیٹھے ہوں ، انہوں نے عرض کیا یا رسول اللہ ! اللہ سے دعاء فرما دیجئے کہ وہ مجھے بھی ان میں شامل فرما دیں ، نبی ﷽ نے ان کے حق میں دعاء فرما دی کہ اے اللہ ! اسے بھی ان میں شامل فرما ۔ پھر ان کا نکاح حضرت عبادہ بن صامت رضی اللہ عنہ سے ہو گیا ، اور وہ اپنے بیٹے قرظہ کے ساتھ سمندری سفر پر روانہ ہوئیں ، واپسی پر جب ساحل سمندر پر وہ اپنے جانور پر سوار ہوئیں تو وہ سواری بدک گئی اور وہ اس سے گر کر فوت ہو گئیں ۔"
"13827","[Darussalam 13791] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13828","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص وضو کرے اور اچھی طرح کرے ، پھر تین مرتبہ یہ کلمات کہے ®اشھد ان لا الہ الا اللہ وحدہ لاشریک لہ وان محمداَ عبدہ و رسولہ¾ تو جنت کے آٹھوں دروازے اس کے لئے کھول دیئے جائیں گے کہ جس دروازے سے چاہے ، جنت میں داخل ہو جائے ۔"
"13829","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جنت میں زائد جگہ بچ جائے گی ، تو اللہ اس کے لئے ایک اور مخلوق کو پیدا کر کے جنت کے باقی ماندہ حصے میں اسے آباد کر دے گا ۔"
"13830","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ بارش کے ذمے دار فرشتے نے اللہ تعالیٰ سے نبی ﷽ کی خدمت میں حاضر ہونے کی اجازت چاہی ، اللہ تعالیٰ نے اسے اجازت دے دی ، نبی ﷽ نے اس موقع پر حضرت ام سلمہ رضی اللہ عنہا سے فرمایا کہ دروازے پر اس چیز کا خیال رکھو کہ ہمارے پاس کوئی اندر نہ آنے پائے ، تھوڑی دیر میں حضرت امام حسین رضی اللہ عنہ آئے اور گھر میں داخل ہونا چاہا ، حضرت ام سلمہ رضی اللہ عنہا نے انہیں روکا تو وہ کود کر اندر داخل ہو گئے اور جا کر نبی ﷽ کی پشت پر ، مونڈھوں اور کندھوں پر بیٹھنے لگے ، اس فرشتے نے نبی ﷽ سے پوچھا کہ کیا آپ کو اس سے محبت ہے آ نبی ﷽ نے فرمایا ہاں ! تو فرشتے نے کہا کہ یاد رکھئے ! آپ کی امت اسے قتل کر دے گی ، اگر آپ چاہیں تو میں آپ کو وہ جگہ بھی دکھا سکتا ہوں جہاں یہ شہید ہوں گے ، یہ کہہ کر فرشتے نے اپنا ہاتھ مارا تو اس کے ہاتھ میں سرخ رنگ کی مٹی آ گئی ، حضرت ام سلمہ رضی اللہ عنہا نے وہ مٹی لے کر اپنے دوپٹے میں باندھ لی ۔"
"13831","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے تین کنکریاں لیں اور ان میں سے اسے ایک کو ، پھر دوسری کو ، پھر تیسری کو ، زمین پر رکھ کر فرمایا یہ ابن آدم ہے ، یہ اس کی موت ہے ، اور یہ اس کی امیدیں ہیں ۔"
"13832","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت عبداللہ بن رواحہ رضی اللہ عنہ کی عادت تھی کہ جب اپنے کسی ساتھی سے ان کی ملاقات ہوتی تو اس سے کہتے کہ آا ، تھوڑی دیر اپنے رب پر ایمان لے آئیں ، ایک دن انہوں نے یہی بات ایک آدمی سے کہی تو وہ غصے میں آ گیا اور نبی ﷽ کے پاس آ کر کہنے لگا کہ یا رسول اللہ ﷽ ! ابن رواحہ کو تو دیکھئے ، یہ لوگوں کو آپ پر ایمان لانے سے موڑ کر تھوڑی دیر کے لئے ایمان کی دعوت دے رہا ہے ، نبی ﷽ نے فرمایا اللہ تعالیٰ ابن رواحہ پر اپنی رحمتیں برسائے ، وہ ان مجلسوں کو پسند کرتے ہیں جن پر فرشتے فخر کرتے ہیں ۔"
"13833","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے دس سال تک نبی ﷽ کی خدمت کا شرف حاصل کیا ہے ، بخدا ! میں نے اگر کوئی کام کیا تو نبی ﷽ نے مجھ سے کبھی یہ نہیں فرمایا کہ تم نے یہ کام اس طرح کیوں کیا آ اور میں نے کوئی عنبر اور مشک یا کوئی دوسری خوشبو نبی ﷽ کی مہک سے زیادہ عمدہ نہیں سونگھی ، اور میں نے کوئی ریشم و دیبا ، یا کوئی دوسری چیز نبی ﷽ کی ہتھیلی سے زیادہ نرم نہیں چھوئی ۔"
"13834","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے ابوعیاش زید بن صامت کے پاس سے گذرتے ہوئے انہیں دورانْ نماز اس طرح دعاء کرتے ہوئے سنا کہ """" اے اللہ ! میں تجھ سے سوال کرتا ہوں کیونکہ تمام تعریفیں تیرے لیے ہی ہیں ، تیرے علاوہ کوئی معبود نہیں ، نہایت احسان کرنے والے ، آسمان و زمین کو بغیر نمونے کے پیدا کرنے والے اور بڑے جلال اور عزت والے ۔ """" نبی ﷽ نے فرمایا انہوں نے اللہ سے اس کے اس اسم اعظم کے ذریعے دعا مانگی ہے کہ جب اس کے ذریعے دعاء مانگی جائے تو اللہ اسے ضرور قبول کرتا ہے اور جب اس کے ذریعے سوال کیا جائے تو وہ ضرور عطاء کرتا ہے ۔"
"13835","حضرت انس رضی اللہ عنہ سے مروی ہے کہ اگر نبی ﷽ زوال شمس سے قبل سفر پر روانہ ہوتے تو نماز ظہر کو نماز عصر تک ماخر کر دیتے ، پھر اتر کر دونوں نمازیں اکٹھی پڑھ لیتے اور اگر سفر پر روانہ ہونے سے پہلے زوال کا وقت ہو جاتا تو آپ ﷽ پہلے نماز ظہر پڑھتے ، پھر سوار ہوتے ۔"
"13836","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت ابوطلحہ رضی اللہ عنہ ایک ہی ڈھال میں نبی ﷽ کے ساتھ حفاظت کا فریضہ سر انجام دے رہے تھے ، وہ بہترین تیر انداز تھے ، جب وہ تیر پھینکتے تو نبی ﷽ جھانک کر دیکھتے کہ وہ تیر کہاں جا کر گرا ہے ۔"
"13837","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا طاعون ہر مسلمان کے لئے شہادت ہے ۔"
"13838","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی انگوٹھی چاندی کی تھی اور اس کا نگینہ بھی چاندی ہی کا تھا ۔"
"13839","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جو شخص اپنی زبان کو سچ پر ثابت قدم رکھے جس پر اس کے بعد بھی عمل کیا جاتا رہے ، تو اللہ تعالیٰ اس کا ثواب قیامت تک اس کے لئے جاری فرما دیتے ہیں ، پھر اللہ تعالیٰ قیامت کے دن اسے پورا پورا اجر و ثواب عطاء فرما دے گا ۔"
"13840","حضرت عائشہ رضی اللہ عنہا سے مروی ہے کہ جس مسلمان میت پر سو کے قریب مسلمانوں کی ایک جماعت نماز جنازہ پڑھ لے اور اس کے حق میں سفارش کر دے ، اس کے حق میں ان لوگوں کی سفارش قبول کر لی جاتی ہے ۔"
"13841","گذشتہ حدیث اس دوسری سند سے حضرت انس رضی اللہ عنہ سے بھی مروی ہے ۔"
"13842","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کے دو ایسے ولیموں میں بھی شرکت کی ہے جس میں روٹی تھی اور نہ گوشت ، راوی کہتے ہیں کہ میں نے پوچھا اے ابوحمزہ ! پھر کیا تھا آ انہوں نے فرمایا حلوہ ۔"
"13843","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اپنے ساتھ سفر حج میں بہت سے اونٹ لے کر گئے تھے اور آپ ﷽ نے حج و عمرہ دونوں کا تلبیہ پڑھا تھا ، اور میں آپ ﷽ کی اونٹنی کی بائیں جانب ران کے قریب تھا ۔"
"13844","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا ہر نبی کی رہبانیت رہی ہے ، اس امت کی رہبانیت جہاد فی سبیل اللہ ہے ۔"
"13845","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے کبھی خضاب نہیں لگایا ، آپ ﷽ کی ڈاڑھی کے اگلے حصے میں ، ٹھوڑی کے اوپر بالوں میں ، سر میں اور کنپٹیوں پر چند بال سفید تھے ، جو بہت زیادہ محسوس نہ ہوتے تھے ۔"
"13846","گذشتہ حدیث اس سند سے بھی مروی ہے ۔"
"13847","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا جس شخص کو یہ بات پسند ہو کہ اس کی عمر میں برکت اور رزق میں اضافہ ہو جائے ، اسے چاہئے کہ اپنے والدین کے ساتھ حسن سلوک کرے اور صلہ رحمی کیا کرے ۔"
"13848","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت خالد بن ولید رضی اللہ عنہ اور حضرت عبدالرحمن بن عوف رضی اللہ عنہ کے درمیان کچھ تلخی ہو گئی تھی ، حضرت خالد رضی اللہ عنہ نے حضرت ابن عوف رضی اللہ عنہ سے کہیں فرما دیا تھا کہ آپ لوگ ہم پر ان ایام کی وجہ سے لمبے ہونا چاہتے ہیں جن میں آپ ہم پر اسلام لانے میں سبقت لے گئے آ نبی ﷽ کو یہ بات معلوم ہوئی تو فرمایا کہ میرے صحابہ رضی اللہ عنہم کو میرے لیے چھوڑ دو ، اس ذات کی قسم جس کے دست قدرت میں میری جان ہے ، اگر تم احد پہاڑ کے برابر بھی سونا خرچ کر دو تو ان کے اعمال کے برابر نہیں پہنچ سکتے ۔"
"13849","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ہم لوگ حج کا تلبیہ پڑھتے ہوئے نکلے ، مکہ مکرمہ پہنچنے کے بعد نبی ﷽ نے ہمیں یہ حکم دیا کہ اسے عمرہ بنا کر احرام کھول لیں ، اور فرمایا اگر وہ بات جو بعد میں میرے سامنے آئی ، پہلے آ جاتی تو میں بھی اسے عمرہ بنا لیتا لیکن میں ہدی کا جانور اپنے ساتھ لایا ہوں ، اور حج و عمرہ دونوں کا تلبیہ پڑھا ہوا ہے ۔"
"13850","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا قیامت کے دن لوگوں کو جب اٹھایا جائے گا تو آسمان گویا ان پر آگ برسا رہا ہو گا ۔"
"13851","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نبی ﷽ کی خدمت میں حاضر ہوا ، اور کہنے لگا یا رسول اللہ ﷽ ! مجھے یہ بتائیے کہ اللہ نے کتنی نمازیں فرض کی ہیں آ نبی ﷽ نے فرمایا اللہ نے اپنے بندوں پر پانچ نمازیں فرض کی ہیں ، اس نے پوچھا کہ ان سے پہلے یا بعد میں بھی کوئی نماز فرض ہے آ نبی ﷽ نے تین مرتبہ فرمایا کہ اللہ نے اپنے بندوں پر پانچ نمازیں فرض کی ہیں ، اس پر وہ کہنے لگا کہ اس ذات کی قسم جس نے آپ کو حق کے ساتھ بھیجا ، میں اس میں کسی قسم کی کمی بیشی نہیں کروں گا ۔ نبی ﷽ نے فرمایا اگر یہ سچا رہا تو جنت میں داخل ہو گا"
"13852","حمید رحمۃ اللہ کہتے ہیں کہ کسی نے حضرت انس رضی اللہ عنہ سے حالت احرام میں سینگی لگوانے کے متعلق دریافت کیا تو انہوں نے فرمایا کہ نبی ﷽ نے اپنی کسی تکلیف کی وجہ سے سینگی لگوائی تھی ۔"
"13853","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نبی ﷽ کی خدمت میں حاضر ہوا ، اور اس نے نبی ﷽ سے سواری کے لئے درخواست کی ، نبی ﷽ نے فرمایا ہم تمہیں اونٹنی کے بچے پر سوار کریں گے ، وہ کہنے لگا یا رسول اللہ ﷽ ! میں اونٹنی کے بچے کو لے کر کیا کروں گا آ نبی ﷽ نے فرمایا کیا اونٹنیاں اونٹوں کے علاوہ بھی کسی کو جنتی ہیں آ"
"13854","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کا رنگ گندمی تھا ، اور میں نے نبی ﷽ کی مہک سے عمدہ کوئی مہک نہیں سونگھی ۔"
"13855","حمید رحمۃ اللہ کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے پوچھا کیا نبی ﷽ نے انگوٹھی بنوائی تھی آ انہوں نے فرمایا ہاں ! ایک مرتبہ نبی ﷽ نے نماز عشاء کو نصف رات تک ماخر کر دیا ، اور فرمایا لوگ نماز پڑھ کر سو گئے لیکن تم نے جتنی دیر تک نماز کا انتظار کیا ، تم نماز ہی میں شمار ہوئے ، اس وقت نبی ﷽ کی انگوٹھی کی سفیدی اب تک میری نگاہوں کے سامنے ہے اور انہوں نے اپنا بایاں ہاتھ بلند کیا ۔"
"13856","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کے دور باسعادت میں بارش ہوئی ، نبی ﷽ نے باہر نکل کر اپنے کپڑے جسم کے اوپر والے حصے سے ہٹا دیئے تاکہ بارش کا پانی جسم تک بھی پہنچ جائے ، کسی نے پوچھا یا رسول اللہ ﷽ ! آپ نے ایسا کیوں کیا آ فرمایا کہ یہ بارش اپنے رب کے پاس سے تازہ تازہ آئی ہے ۔"
"13857","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کے پاس رات کو صحابہ رضی اللہ عنہم حاضر ہوئے ، نبی ﷽ باہر تشریف لائے ، اور مختصر سی نماز پڑھا کر چلے گئے ، کافی دیر گذرنے کے بعد دوبارہ آئے اور مختصر سی نماز پڑھا کر دوبارہ واپس چلے گئے اور کافی دیر تک اندر رہے ، جب صبح ہوئی تو صحابہ رضی اللہ عنہم نے عرض کیا اے اللہ کے نبی ! ہم آج رات بیٹھے ہوئے تھے ، آپ تشریف لائے اور مختصر سی نماز پڑھائی اور کافی دیر تک کے لیے گھر میں چلے گئے آ نبی ﷽ نے فرمایا میں نے تمہاری وجہ سے ہی ایسا کیا تھا ۔"
"13858","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جو شخص نماز پڑھنا بھول جائے یا سو جائے ، تو اس کا کفارہ یہی ہے کہ جب یاد آئے ، اسے پڑھ لے ۔"
"13859","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جب کسی مریض کی عیادت کے لئے تشریف لے جاتے تو اس کے لئے دعاء فرماتے کہ اے لوگوں کے رب ! اس تکلیف کو دور فرما ، شفاء عطاء فرما کہ تو ہی شفاء دینے والا ہے ، تیرے علاوہ کوئی شفاء دینے والا نہیں ہے ، ایسی شفاء عطاء فرما جو بیماری کا نام و نشان بھی باقی نہ چھوڑے ۔"
"13860","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا رسالت اور نبوت کا سلسلہ منقطع ہو گیا ہے ، اس لئے اب میرے بعد کوئی رسول یا نبی نہ ہو گا ، لوگوں کو یہ بات بہت بڑی معلوم ہوئی ، نبی ﷽ نے فرمایا البتہ """" مبشرات """" باقی ہیں ، لوگوں نے پوچھا یا رسول اللہ ! مبشرات سے کیا مراد ہے آ نبی ﷽ نے فرمایا مسلمان کا خواب ، جو اجزاء نبوت میں سے ایک جزو ہے ۔"
"13861","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا میں نے ایک مرتبہ خواب میں دیکھا کہ گویا میں نے اپنے پیچھے ایک مینڈھے کو بٹھا رکھا ہے ، اور گویا میری تلوار کا دستہ ٹوٹ گیا ہے ، میں نے اس کی تعبیر یہ لی کہ میں مشرکین کے علم بردار کو قتل کروں گا ، اور یہ کہ میرے اہل بیت میں سے بھی ایک آدمی شہید ہو گا ، چنانچہ نبی ﷽ نے مشرکین کے علمبردار طلحہ بن ابی طلحہ کو قتل کیا اور ادھر حضرت حمزہ رضی اللہ عنہ شہید ہوئے ,"
"13862","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ انصار کے ایک آدمی کے پاس اس کی عیادت کے لئے تشریف لے گئے اور اس سے فرمایا ماموں جان ! ®لا الہ الا اللہ¾ کا اقرار کر لیجئے ، اس نے کہا ماموں یا چچا آ نبی ﷽ نے فرمایا نہیں ، ماموں ! ®لا الہ الا اللہ¾ کہہ لیجئے ، اس نے پوچھا کہ کیا یہ میرے حق میں بہتر ہے آ نبی ﷽ نے فرمایا ہاں ۔"
"13863","حضرت انس رضی اللہ عنہ سے مروی ہے کہ قریش کے جن لوگوں نے نبی ﷽ کے ساتھ صلح نامہ تیار کیا ، ان میں سہیل بن عمرو بھی تھا ، نبی ﷽ نے حضرت علی رضی اللہ عنہ سے فرمایا کہ ®بسم اللہ الرحمن الرحیم¾ لکھو ، اس پر سہیل کہنے لگا کہ ہم ®بسم اللہ الرحمن الرحیم¾ کو نہیں جانتے ، آپ ®باسمک اللھم¾ لکھوائیے جو ہم بھی جانتے ہیں ، پھر نبی ﷽ نے فرمایا لکھو """" محمد رسول اللہ + ﷽ , کی جانب سے """" سہیل کہنے لگا کہ اگر ہم آپ کو اللہ کا پیغمبر مانتے تو آپ کی اتباع کرتے ، آپ اپنا اور اپنے والد صاحب کا نام لکھوائیے ، نبی ﷽ نے فرمایا لکھو """" محمد بن عبداللہ کی جانب سے """" اس صلح نامہ میں مشرکین نے نبی ﷽ سے یہ شرط بھی ٹھہرائی تھی کہ آپ کا جو آدمی ہمارے پاس آ جائے گا ، ہم اسے واپس نہیں لوٹائیں گے لیکن ہم میں سے جو آدمی آپ کے پاس آئے گا ، آپ اسے ہمیں لوٹا دیں گے ، حضرت علی رضی اللہ عنہ نے عرض کیا یا رسول اللہ ! کیا ہم یہ شرط بھی لکھیں آ فرمایا ہاں ! ہم میں سے جو ان کے پاس جائے ، اللہ اسے ہم سے دور ہی رکھے ۔"
"13864","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے بارگاہ رسالت میں عرض کیا یا رسول اللہ ﷽ ! ایک آدمی کسی قوم سے محبت کرتا ہے لیکن ان کے اعمال تک نہیں پہنچتا ، تو کیا حکم ہے آ نبی ﷽ نے فرمایا انسان اسی کے ساتھ ہو گا جس کے ساتھ وہ محبت کرتا ہے ۔"
"13865","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا میں جنت میں داخل ہوا تو اپنے آگے کسی کی آہٹ سنی ، دیکھا تو وہ رمیصاء بنت ملیحان تھیں ۔"
"13866","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب نبی ﷽ مدینہ منورہ میں داخل ہوئے تھے ، تو مدینہ کی ہر چیز روشن ہو گئی تھی اور جب دنیا سے رخصت ہوئے تو مدینہ کی ہر چیز تاریک ہو گئی اور ابھی ہم تدفین سے فارغ نہیں ہوئے تھے کہ ہم نے اپنے دلوں کی حالت کو تبدیل پایا ۔"
"13867","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ظہر کی نماز مدینہ منورہ میں چار رکعتوں کے ساتھ ادا کی ، اور عصر کی نماز ذوالحلیفہ میں دو رکعت کے ساتھ پڑھی ، رات وہیں پر قیام فرمایا اور نماز فجر پڑھ کر اپنی سواری پر سوار ہوئے ، اور راستے میں تسبیح و تکبیر پڑھتے رہے ، جب مقام بیداء میں پہنچے تو ظہر اور عصر کو اکٹھے ادا کیا ، جب ہم لوگ مکہ مکرمہ پہنچے تو نبی ﷽ نے صحابہ رضی اللہ عنہم کو احرام کھول لینے کا حکم دیا ، آٹھ ذی الحجہ کو انہوں نے دوبارہ حج کا احرام باندھا ، نبی ﷽ نے اپنے دست مبارک سے سات اونٹ کھڑے کھڑے ذبح کیے اور مدینہ منورہ میں آپ ﷽ دو چتکبرے سینگوں والے مینڈھوں کی قربانی فرماتے تھے ۔"
"13868","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز عشاء کا وقت ہو گیا ، ایک آدمی آیا اور کہنے لگا یا رسول اللہ ! مجھے آپ سے ایک کام ہے ، نبی ﷽ اس کے ساتھ مسجد میں تنہائی میں گفتگو کرنے لگے یہاں تک کہ لوگ اونگھنے لگے ، پھر نبی ﷽ نے نماز پڑھائی اور راوی نے وضو کا ذکر نہیں کیا ۔"
"13869","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا قیامت اس وقت تک قائم نہیں ہو گی جب تک زمین میں اللہ اللہ کہنے والا کوئی شخص باقی ہے ۔"
"13870","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک آدمی نے نبی ﷽ سے پوچھا کہ میرے والد کہاں ہوں گے آ نبی ﷽ نے فرمایا جہنم میں ، پھر جب وہ پیٹھ پھیر کر جانے لگا تو فرمایا کہ میرا اور تیرا باپ دونوں جہنم میں ہوں گے ۔"
"13871","ثابت رحمۃ اللہ کہتے ہیں کہ ایک مرتبہ میں حضرت انس رضی اللہ عنہ کے پاس بیٹھا ہوا تھا ، وہاں ان کی ایک صاحبزادی بھی موجود تھی ، حضرت انس رضی اللہ عنہ کہنے لگے کہ ایک عورت نبی ﷽ کی خدمت میں حاضر ہوئی اور کہنے لگی کہ اے اللہ کے نبی ! کیا آپ کو میری ضرورت ہے آ حضرت انس رضی اللہ عنہ کی صاحبزادی کہنے لگی کہ اس عورت میں شرم و حیاء کتنی کم تھی ، حضرت انس رضی اللہ عنہ نے فرمایا وہ تجھ سے بہتر تھی ، اسے نبی ﷽ کی طرف رغبت ہوئی اور اس نے اپنے آپ کو نبی ﷽ کے سامنے پیش کر دیا ۔"
"13872","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نبی ﷽ نے فرمایا جو میں جانتا ہوں ، اگر تم وہ جانتے ہوتے تو تم بہت تھوڑا ہنستے اور کثرت سے رویا کرتے ۔"
"13873","[Darussalam 13837] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13874","حضرت انس بن مالک رضی اللہ عنہ سے مروی ہے کہ ایک دن نماز کھڑی ہوئی تو نبی ﷽ ہماری طرف متوجہ ہوئے اور فرمایا صفیں سیدھی کر لو اور جڑ کر کھڑے ہو کیونکہ بخدا میں تمہیں اپنے پیچھے سے بھی اسی طرح دیکھتا ہوں جیسے سامنے سے دیکھتا ہوں ۔"
"13875","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا کچھ لوگ جہنم میں داخل کیے جائیں گے ، جب وہ جل کر کوئلہ ہو جائیں گے تو انہیں جنت میں داخل کر دیا جائے گا ، اہل جنت ان کا نام رکھ دیں گے کہ یہ جہنمی ہیں ۔"
"13876","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک یہودی نے ایک انصاری بچی کو پتھر مار مار کر اس کا سر کچل دیا ، اس بچی سے پوچھا گیا کہ کیا تمہارے ساتھ یہ سلوک فلاں نے کیا ہے ، فلاں نے کیا ہے یہاں تک کہ جب اس یہودی کا نام آیا تو اس نے سر کے اشارے سے ہاں کہہ دیا ، اس یہودی کو پکڑ کر نبی ﷽ کے سامنے لایا گیا ، اس نے اپنے جرم کا اعتراف کر لیا ، نبی ﷽ نے حکم دیا اور اس کا سر بھی پتھروں سے کچل دیا گیا ۔"
"13877","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے بال کندھوں تک آتے تھے ۔"
"13878","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا رکوع و سجود کو مکمل کیا کرو ، کیونکہ میں بخدا تمہیں اپنی پشت کے پیچھے سے بھی دیکھ رہا ہوتا ہوں ۔"
"13879","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ حضرت ام سلیم رضی اللہ عنہا نے ایک تھالی میں کھجوریں رکھ کر نبی ﷽ کے پاس بھیجیں ، نبی ﷽ نے اس میں سے ایک مٹھی بھر کر اپنی ایک زوجہ محترمہ کو بھجوا دیں ، پھر ایک مٹھی بھر کر دوسری زوجہ کو بھجوا دیں ، پھر جو باقی بچ گئیں ، وہ بیٹھ کر خود تناول فرما لیں ، اور اس سے معلوم ہوتا تھا کہ نبی ﷽ کو اس وقت ان کی تمنا تھی ۔"
"13880","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نماز کھڑی ہوئی تو ایک آدمی آیا ، صف تک پہنچ کر وہ کہنے لگا ®الحمدللہ حمدا کثیرا طیبا مبارکا فیہ¾ نبی ﷽ نے نماز سے فارغ ہو کر پوچھا کہ تم میں سے کون بولا تھا آ لوگ خاموش رہے ، نبی ﷽ نے تین مرتبہ پوچھا ، بالآخر وہ آدمی کہنے لگا یا رسول اللہ ﷽ ! میں بولا تھا ، اور میرا ارادہ تو خیر ہی کا تھا ، نبی ﷽ نے فرمایا میں نے بارہ فرشتوں کو اس کی طرف تیزی سے بڑھتے ہوئے دیکھا کہ کون اس جملے کو پہلے اٹھاتا ہے ، لیکن انہیں سمجھ نہ آئی کہ اس کا کتنا ثواب لکھیں چنانچہ انہوں نے اللہ تعالیٰ سے پوچھا ، اللہ تعالیٰ نے فرمایا یہ کلمات اسی طرح لکھ لو جیسے میرے بندے نے کہے ہیں ۔"
"13881","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے مبارک جوتوں کے دو تسمے تھے ۔"
"13882","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جب تم میں سے کوئی شخص تھوکنا چاہے تو اپنی دائیں جانب یا سامنے نہ تھوکا کرے بلکہ بائیں جانب یا اپنے پااں کے نیچے تھوکا کرے ۔"
"13883","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ایک مرتبہ میں جنت میں گھوم رہا تھا کہ ایک محل پر پہنچ کر رک گیا ، میں نے پوچھا جبریل ! یہ محل کس کا ہے آ میرا خیال تھا کہ ایسا محل تو میرا ہو سکتا ہے ، انہوں نے جواب دیا کہ یہ عمر کا ہے ، تھوڑی دور اور آگے چلا تو پہلے سے بھی زیادہ خوبصورت ایک اور محل آیا ، میں نے پوچھا جبریل ! یہ کس کا ہے ، اس مرتبہ بھی میرا یہی خیال تھا کہ ایسا محل تو میرا ہو سکتا ہے ، لیکن انہوں نے بتایا کہ یہ بھی عمر ہی کا ہے اور اے ابوحفص ! اس میں ایک حورعین بھی تھی ، مجھے تمہاری غیرت کے علاوہ اس میں داخل ہونے سے کسی چیز نے نہیں روکا ، حضرت عمر رضی اللہ عنہ کی آنکھیں یہ سن کر ڈبڈبا گئیں اور وہ کہنے لگے کہ آپ پر تو میں کسی طرح اپنی غیرت مندی کا اظہار نہیں کر سکتا ۔"
"13884","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جو شخص نماز پڑھنا بھول جائے تو اس کا کفارہ یہی ہے کہ جب یاد آئے ، اسے پڑھ لے ۔"
"13885","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا جو شخص خواب میں میری زیارت کرے وہ سمجھ لے کہ اس نے میری ہی زیارت کی ہے کیونکہ شیطان میری شباہت اختیار کر ہی نہیں سکتا / اور مسلمان کا خواب اجزاء نبوت میں سے چھیالیسواں جزو ہوتا ہے ۔"
"13886","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک شخص نے بارگاہ نبوت میں عرض کیا یا رسول اللہ ﷽ ! قیامت کب آئے گی آ اس وقت نبی ﷽ کے پاس ایک انصاری لڑکا """" جس کا نام محمد تھا """" بھی موجود تھا ، نبی ﷽ نے فرمایا اگر یہ لڑکا زندہ رہا تو ہو سکتا ہے کہ اس پر بڑھاپا آنے سے پہلے ہی قیامت آ جائے ۔"
"13887","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کا رنگ کھلتا ہوا تھا ، پسینہ موتیوں کی طرح تھا ، جب وہ چلتے تو پوری قوت سے چلتے تھے ، میں نے کوئی عنبر اور مشک یا کوئی دوسری خوشبو نبی ﷽ کی مہک سے زیادہ عمدہ نہیں سونگھی ، اور میں نے کوئی ریشم و دیبا ، یا کوئی دوسری چیز نبی ﷽ کی ہتھیلی سے زیادہ نرم نہیں چھوئی ۔"
"13888","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے کان لگا کر سنا تو ایک آدمی کے اللہ اکبر ، اللہ اکبر کہنے کی آواز سنائی دی ، نبی ﷽ نے فرمایا فطرت سلیمہ پر ہے ، پھر جب اس نے ®اشھد ان الا الہ الا اللہ¾ کہا تو فرمایا کہ تو جہنم کی آگ سے نکل گیا ۔"
"13889","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب نبی ﷽ کی صاحبزادی حضرت رقیہ رضی اللہ عنہا کا انتقال ہوا تو نبی ﷽ نے فرمایا ان کی قبر میں ایسا شخص نہیں اترے گا جو رات کو اپنی بیوی سے بے حجاب ہوا ہو ۔"
"13890","حضرت انس رضی اللہ عنہ سے مروی ہے کہ کچھ لوگ نبی ﷽ کی خدمت میں حاضر ہوئے اور کہنے لگے کہ ہمارے ساتھ کچھ لوگوں کو بھیج دیجئے جو ہمیں قرآن و سنت کی تعلیم دیں ۔ چنانچہ نبی ﷽ نے ان کے ساتھ ستر انصاری صحابہ کو بھیج دیا جنہیں قراء کہا جاتا تھا ، ان میں میرے ماموں حرام بھی تھے ، یہ لوگ رات کو قرآن پڑھتے تھے اور دن کو پانی لا کر مسجد میں رکھتے تھے اور لکڑیاں کاٹ کر بیچتے اور ان سے اہل صفہ اور فقراء کے لئے کھانا خرید کر لاتے تھے ، نبی ﷽ نے انہیں بھیج دیا ، لے جانے والوں نے انہیں متفرق کر کے اپنے علاقے میں پہنچنے سے پہلے ہی شہید کر دیا ، وہ کہنے لگے کہ اے اللہ ! ہمارے نبی کو ہماری طرف سے یہ پیغام پہنچا دے کہ ہم تجھ سے مل گئے ، ہم تجھ سے راضی ہو گئے اور تو ہم سے راضی ہو گیا ، اسی اثناء میں ایک آدمی حضرت حرام رضی اللہ عنہ """" میرے ماموں """" کے پاس پیچھے سے آیا اور ایسا نیزہ مارا کہ آر پار کر دیا ، وہ کہنے لگے رب کعبہ کی قسم ! میں کامیاب ہو گیا ، ادھر نبی ﷽ نے اپنے صحابہ رضی اللہ عنہم کو یہ خبر دیتے ہوئے فرمایا کہ تمہارے بھائی جو شہید ہو گئے ہیں ، انہوں نے اپنے رب سے عرض کیا کہ ہمارے نبی کو ہماری طرف سے یہ پیغام پہنچا دے کہ ہم تجھ سے مل گئے ، ہم تجھ سے راضی ہو گئے اور تو ہم سے راضی ہو گیا ۔"
"13891","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جنتی جنت میں داخل ہو جائیں گے اور اس میں جگہ زائد بچ جائے گی ، پھر اللہ اس کے لئے ایک اور مخلوق کو پیدا کر کے جنت کے باقی ماندہ حصے میں اسے آباد کر دے گا ۔"
"13892","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ تمام لوگوں میں سب سے اچھے اخلاق والے تھے ۔"
"13893","حضرت انس رضی اللہ عنہ سے مروی ہے جناب رسول اللہ ﷽ نے ارشاد فرمایا قیامت کے دن ہر دھوکے باز کے لئے ایک جھنڈا ہو گا جس سے وہ پہچانا جائے گا ۔"
"13894","حمید رحمۃ اللہ کہتے ہیں کہ کسی شخص نے حضرت انس رضی اللہ عنہ سے نبی ﷽ کے بالوں کے متعلق دریافت کیا تو انہوں نے فرمایا کہ میں نے نبی ﷽ کے بالوں کے ساتھ قتادہ کے بالوں سے زیادہ مشابہہ کسی کے بال نہیں دیکھے ، اس دن قتادہ رحمۃ اللہ یہ سن کر بہت خوش ہوئے تھے ۔"
"13895","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے پاس کسی دن دوپہر اور رات کے کھانے میں روٹی اور گوشت جمع نہیں ہوئے ، الاِ یہ کہ کبھی مہمان آ گئے ہوں ۔"
"13896","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک یہودی نے جناب رسول اللہ ﷽ کے لئے جو کی روٹی اور پرانا روغن لے کر دعوت کی تھی اور نبی ﷽ نے اسے قبول فرما لیا تھا ۔"
"13897","حضرت انس رضی اللہ عنہ فرماتے تھے کہ نبی ﷽ کے دور باسعادت میں جو چیزیں میں نے دیکھی ہیں ، آج ان میں سے ایک چیز بھی نہیں دیکھتا سوائے اس کے کہ تم ®لا الہ الا اللہ¾ کہتے ہو ، راوی کہتے ہیں کہ میں نے عرض کیا اے ابوحمزہ ! کیا ہم نماز نہیں پڑھتے آ فرمایا تم غروب آفتاب کے وقت تو نماز عصر پڑھتے ہو ، کیا یہ نبی ﷽ کی نماز تھی آ البتہ اتنی بات ضرور ہے کہ تمہارے اس زمانے سے بہتر زمانہ کسی عمل کرنے والے کے لئے میں نے نہیں دیکھا الاِ یہ کہ وہ نبی کا زمانہ ہو ۔"
"13898","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ خیبر کے دن میں حضرت ابوطلحہ رضی اللہ عنہ کے پیچھے سواری پر بیٹھا ہوا تھا اور میرے پااں نبی ﷽ کے پااں کو چھو رہے تھے ، ہم وہاں پہنچے تو سورج نکل چکا تھا اور اہل خیبر اپنے مویشیوں کو نکال کر کلہاڑیاں اور کدالیں لے کر نکل چکے تھے ، ہمیں دیکھ کر کہنے لگے محمد + ﷽ , اور لشکر آ گئے ، نبی ﷽ نے اللہ اکبر کہہ کر فرمایا کہ خیبر برباد ہو گیا ، پھر نبی ﷽ نے ان پر حملہ کر دیا اور فرمایا جب ہم کسی قوم کے صحن میں اترتے ہیں تو ڈرائے ہوئے لوگوں کی صبح بڑی بدترین ہوتی ہے ۔"
"13899","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جب حضرت عبدالرحمن بن عوف رضی اللہ عنہ مدینہ منورہ آئے تو نبی ﷽ نے ان کے اور حضرت سعد بن ربیع رضی اللہ عنہ کے درمیان بھائی چارہ قائم کر دیا ، حضرت سعد رضی اللہ عنہ نے ان سے فرمایا کہ میں اپنا سارا مال دو حصوں میں تقسیم کرتا ہوں ، نیز میری دو بیویاں ہیں ، آپ کو ان میں سے جو پسند ہو ، میں اسے طلاق دے دیتا ہوں ، جب اس کی عدت گذر جائے تو آپ اس سے نکاح کر لیجئے گا ، حضرت عبدالرحمن رضی اللہ عنہ نے فرمایا اللہ تعالیٰ آپ کے مال اور اہل خانہ کو آپ کے لیے باعث برکت بنائے ، مجھے بازار کا راستہ دکھا دیجئے ، چنانچہ انہوں نے حضرت ابن عوف رضی اللہ عنہ کو راستہ بتا دیا ، اور وہ چلے گئے ، واپس آئے تو ان کے پاس کچھ پنیر اور گھی تھا جو وہ منافع میں بچا کر لائے تھے ۔ کچھ عرصے بعد نبی ﷽ نے حضرت عبدالرحمن رضی اللہ عنہ کو دیکھا تو ان پر زرد رنگ کے نشانات پڑے ہوئے تھے ، نبی ﷽ نے ان سے فرمایا یہ نشان کیسے ہیں آ انہوں نے بتایا کہ میں نے ایک انصاری خاتون سے شادی کر لی ہے ، نبی ﷽ نے پوچھا مہر کتنا دیا آ انہوں نے بتایا کہ کجھور کی گٹھلی کے برابر سونا ، نبی ﷽ نے فرمایا ولیمہ کرو ، اگرچہ صرف ایک بکری ہی سے ہو ۔"
"13900","حضرت انس رضی اللہ عنہ سے مروی ہے کہ حضرت عبدالرحمن بن عوف رضی اللہ عنہ نے کھجور کی گٹھلی کے برابر سونے کے عوض ایک انصاری خاتون سے شادی کر لی نبی ﷽ نے اسے جائز قرار دے دیا ۔"
"13901","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ تمام لوگوں میں سب سے زیادہ خوبصورت ، سخی اور بہادر تھے ، ایک مرتبہ رات کے وقت اہل مدینہ دشمن کے خوف سے گھبرا اٹھے ، اور اس آواز کے رخ پر چل پڑے ، دیکھا تو نبی ﷽ واپس چلے آ رہے ہیں اور حضرت ابوطلحہ رضی اللہ عنہ کے بے زین گھوڑے پر سوار ہیں ، گردن میں تلوار لٹکا رکھی ہے اور لوگوں سے کہتے جا رہے ہیں کہ گھبرانے کی کوئی بات نہیں ، مت گھبراا اور گھوڑے کے متعلق فرمایا کہ ہم نے اسے سمندر جیسا رواں پایا ۔"
"13902","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ایک آدمی کو اپنے دو بیٹوں کے کندھوں کا سہارا لے کر چلتے ہوئے دیکھا تو پوچھا یہ کیا ماجرا ہے آ انہوں نے بتایا کہ انہوں نے پیدل چل کر حج کرنے کی منت مانی تھی ، نبی ﷽ نے فرمایا اللہ اس بات سے غنی ہے کہ یہ شخص اپنے آپ کو تکلیف میں مبتلا کرے ، پھر آپ ﷽ نے اسے سوار ہونے کا حکم دیا ، چنانچہ وہ سوار ہو گیا ۔"
"13903","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ جمعہ کے دن نبی ﷽ سے لوگوں نے عرض کیا کہ یا رسول اللہ ﷽ ! بارش رکی ہوئی ہے ، زمینیں خشک پڑی ہیں اور مال تباہ ہو رہے ہیں بارش کی دعا کر دیجیے ، نبی ﷽ نے یہ سن کر منبر پر ہی دعا کی اور اپنے ہاتھ اپنے سینے کے سامنے پھیلا دیئے اور ہتھیلیوں کا اندرونی حصہ زمین کی طرف کر دیا ، اس وقت ہمیں آسمان پر کوئی بادل نظر نہیں آ رہا تھا ، اور جب نماز سے فارغ ہوئے تو قریب کے گھر میں رہنے والے نوجوانوں کو اپنے گھر واپس پہنچے میں دشواری ہو رہی تھی ، جب اگلا جمعہ ہوا تو لوگوں نے عرض کیا یا رسول اللہ ﷽ ! گھروں کی عمارتیں گر گئیں اور سوار مدینہ سے باہر ہی رکنے پر مجبور ہو گئے ، یہ سن کر نبی ﷽ مسکرا پڑے اور اللہ سے دعا کی کہ اے اللہ ! یہ بارش ہمارے ارد گرد فرما ، ہم پر نہ برسا ، چنانچہ مدینہ سے بارش چھٹ گئی ۔"
"13904","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کی مدینہ منورہ تشریف آوری کے بعد حضرت عبداللہ بن سلام رضی اللہ عنہ بارگاہ رسالت میں حاضر ہوئے اور کہنے لگے یا رسول اللہ ﷽ ! میں آپ سے چند باتیں پوچھتا ہوں جنہیں کسی نبی کے علاوہ کوئی نہیں جانتا ، اگر آپ نے مجھے ان کا جواب دے دیا تو میں آپ پر ایمان لے آاں گا اور اگر آپ کو وہ باتیں معلوم نہ ہوئیں تو میں سمجھ جااں گا کہ آپ نبی نہیں ہیں ، انہوں نے کہا کہ قیامت کی سب سے پہلی علامت کیا ہے آ اہل جنت کا سب سے پہلا کھانا کیا چیز ہو گی آ اور بچہ اپنے ماں باپ کے مشابہہ کیسے ہوتا ہے آ نبی ﷽ نے فرمایا ان کا جواب مجھے ابھی ابھی حضرت جبریل علیہ السلام نے بتایا ہے ، عبداللہ کہنے لگے کہ وہ تو فرشتوں میں یہودیوں کا دشمن ہے ۔ نبی ﷽ نے فرمایا قیامت کی سب سے پہلی علامت تو وہ آگ ہو گی جو مشرق سے نکل کر تمام لوگوں کو مغرب میں جمع کر لے گی ، اور اہل جنت کا سب سے پہلا کھانا مچھلی کا جگر ہو گی ، اور بچے کے اپنے ماں باپ کے ساتھ مشابہہ ہونے کی وجہ یہ ہے کہ اگر مرد کا """" پانی """" عورت کے پانی پر غالب آ جائے تو وہ بچے کو اپنی طرف کھینچ لیتا ہے ، اور اگر عورت کا """" پانی """" مرد کے پانی پر غالب آ جائے تو وہ بچے کو اپنی طرف کھینچ لیتی ہے ، یہ سن کر عبداللہ کہنے لگے کہ میں اس بات کی گواہی دیتا ہوں کہ اللہ کے علاوہ کوئی معبود نہیں اور آپ اللہ کے رسول ہیں ، پھر کہنے لگے یا رسول اللہ ﷽ ! یہودی بہتان باندھنے والی قوم ہیں ، اگر انہیں میرے اسلام کا پتہ چل گیا تو وہ آپ کے سامنے مجھ پر طرح طرح کے الزام لگائیں گے ، اس لیے آپ ان کے پاس پیغام بھیج کر انہیں بلایئے اور میرے متعلق ان سے پوچھیئے کہ تم میں ابن سلام کیسا آدمی ہے آ چنانچہ نبی ﷽ نے انہیں بلا بھیجا ، اور ان سے پوچھا کہ عبداللہ بن سلام تم میں کیسا آدمی ہے آ انہوں نے جواب دیا کہ ہم میں سب سے بہتر ہے اور سب سے بہتر کا بیٹا ، ہمارا عالم اور عالم کا بیٹا ہے ، ہم میں سب سے بڑا فقیہہ ہے اور سب سے بڑے فقیہہ کا بیٹا ہے ، نبی ﷽ نے فرمایا یہ بتاا ، اگر وہ اسلام قبول کر لے تو کیا تم بھی اسلام قبول کر لو گے آ وہ کہنے لگے اللہ اسے بچا کر رکھے ، اس پر حضرت عبداللہ بن سلام رضی اللہ عنہ باہر نکل آئے اور ان کے سامنے کلمہ پڑھا ، یہ سن کر وہ کہنے لگے کہ یہ ہم میں سب سے بدتر ہے اور سب سے بدتر کا بیٹا ہے اور ہم میں جاہل اور جاہل کا بیٹا ہے ، حضرت عبداللہ بن سلام رضی اللہ عنہ نے فرمایا یا رسول اللہ ! میں نے تو آپ کو پہلے ہی بتا دیا تھا کہ یہودی بہتان باندھنے والی قوم ہیں ۔"
"13905","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کا ایک پڑوسی فارس کا رہنے والا تھا ، وہ سالن بڑا اچھا پکاتا تھا ، ایک دن اس نے نبی ﷽ کے لئے کھانا پکایا اور نبی ﷽ کو دعوت دینے کے لئے آیا ، نبی ﷽ نے حضرت عائشہ رضی اللہ عنہا کی طرف اشارہ کر کے فرمایا کہ یہ بھی میرے ساتھ ہوں گی ، اس نے انکار کر دیا ، نبی ﷽ نے بھی اس کے ساتھ جانے سے انکار کر دیا ، اور وہ چلا گیا ، پھر تین مرتبہ اسی طرح چکر لگائے ، بالآخر اس نے حضرت عائشہ رضی اللہ عنہا کو بھی ساتھ لانے کے لئے حامی بھر لی ، چنانچہ وہ دونوں آگے پیچھے چلتے ہوئے اس کے گھر چلے گئے ۔"
"13906","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ رات کے وقت حضرت اسید بن حضیر رضی اللہ عنہ اور عباد بن بشیر رضی اللہ عنہ اپنے کسی کام سے نبی ﷽ کے پاس بیٹھے گفتگو کر رہے تھے ، اس دوران رات کا کافی حصہ بیت گیا اور وہ رات بہت تاریک تھی ، جب وہ نبی ﷽ سے رخصت ہو کر نکلے تو ان کے ہاتھ میں ایک ایک لاٹھی تھی ، ان میں سے ایک آدمی کی لاٹھی روشن ہو گئی اور وہ اس کی روشنی میں چلنے لگے ، جب دونوں اپنے اپنے راستے پر جدا ہونے لگے تو دوسرے کی لاٹھی بھی روشن ہو گئی ۔"
"13907","حضرت انس رضی اللہ عنہ سے مروی ہے کہ غزوہ بدر کے موقع پر حضرت حارثہ رضی اللہ عنہ """" جو کہ نوعمر لڑکے تھے """" سیر پر نکلے ، راستے میں کہیں سے ناگہانی تیر ان کے آ کر لگا اور وہ شہید ہو گئے ، ان کی والدہ نے بارگاہ رسالت میں عرض کیا یا رسول اللہ ﷽ ! آپ جانتے ہیں کہ مجھے حارثہ سے کتنی محبت تھی ، اگر تو وہ جنت میں ہے تو میں صبر کر لوں گی ، ورنہ پھر میں جو کروں گی وہ آپ بھی دیکھ لیں گے ، نبی ﷽ نے فرمایا اے ام حارثہ ! جنت صرف ایک تو نہیں ہے ، وہ تو بہت سی جنتیں ہیں اور حارثہ ان میں سب سے افضل جنت میں ہے ۔"
"13908","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اللہ تعالیٰ فرماتے ہیں اگر میرا بندہ بالشت برابر میرے قریب ہوتا ہے تو میں ایک گز کے برابر اس کے قریب ہو جاتا ہوں اور اگر وہ ایک گز کے برابر میرے قریب ہوتا ہے تو میں ایک ہاتھ کے برابر اس کے قریب ہو جاتا ہوں ، اور اگر وہ میرے پاس چل کر آتا ہے تو میں اس کے پاس دوڑ کر آتا ہوں ۔"
"13909","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نبی ﷽ کو یہ کہتے ہوئے سنتا تھا ، مجھے معلوم نہیں کہ یہ قرآن کی آیت تھی یا نبی ﷽ کا فرمان ، کہ اگر ابن آدم کے پاس مال سے بھری ہوئی دو وادیاں بھی ہوتیں تو وہ تیسری کی تمنا کرتا اور ابن آدم کا پیٹ صرف قبر کی مٹی ہی بھر سکتی ہے ، اور جو توبہ کرتا ہے ، اللہ اس کی توبہ قبول فرما لیتا ہے ۔"
"13910","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا تم میں سے کوئی شخص اس وقت تک مومن نہیں ہو سکتا جب تک اپنے بھائی یا پڑوسی کے لئے وہی پسند نہ کرنے لگے جو اپنے لیے پسند کرتا ہے ۔"
"13911","حضرت انس رضی اللہ عنہ سے مروی ہے کہ جناب رسول اللہ ﷽ نے ارشاد فرمایا تم میں سے کوئی شخص اس وقت تک مومن نہیں ہو سکتا جب تک لوگوں کے لیے وہی پسند نہ کرنے لگے جو اپنے لیے پسند کرتا ہے اور کسی انسان سے اگر محبت کرے تو صرف اللہ کی رضاء کے لیے کرے ۔"
"13912","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دو چتکبرے سینگ دار مینڈھے قربانی میں پیش کیا کرتے تھے ، اور اللہ کا نام لے کر تکبیر کہتے تھے ، میں نے دیکھا ہے کہ نبی ﷽ انہیں اپنے ہاتھ سے ذبح کرتے تھے اور ان کے پہلو پر اپنا پااں رکھتے تھے ۔"
"13913","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ دو چتکبرے سینگ دار مینڈھے قربانی میں پیش کرتے تھے اور اللہ کا نام لے کر تکبیر کہتے تھے ، میں نے دیکھا کہ نبی ﷽ انہیں اپنے ہاتھ سے ذبح کرتے تھے اور ان کے پہلو پر اپنا پااں رکھتے تھے ۔"
"13914","[Darussalam 13877] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13915","[Darussalam 13878] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13916","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا انصار میرا پردہ ہیں لوگ بڑھتے جائیں گے اور انصار کم ہوتے جائیں گے ، اس لئے تم انصار کے نیکیوں کی نیکی قبول کرو ، اور ان کے گناہگار سے تجاوز اور درگذر کرو ۔"
"13917","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کے پاس ایک آدمی کو لایا گیا جس نے شراب پی تھی ، نبی ﷽ نے اسے چالیس کوڑے مارے ، حضرت ابوبکر صدیق رضی اللہ عنہ نے بھی یہی کیا ، لیکن جب حضرت عمر فاروق رضی اللہ عنہ کا دور خلافت آیا تو حضرت عمر رضی اللہ عنہ نے اپنے ساتھیوں سے مشورہ کیا کہ اس کے متعلق تمہاری کیا رائے ہے آ حضرت عبدالرحمن بن عوف رضی اللہ عنہ نے یہ رائے دی کہ سب سے کم درجے کی حد کے برابر اس کی سزا اسی کوڑے مقرر کر دیجئے ، چنانچہ حضرت عمر رضی اللہ عنہ نے شراب نوشی کی سزا اسی کوڑے مقرر کر دی ۔"
"13918","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ صحابہ کرام رضی اللہ عنہم نے نبی ﷽ سے یہ مسئلہ پوچھا کہ اہل کتاب ہمیں سلام کرتے ہیں ، ہم انہیں کیا جواب دیں آ نبی ﷽ نے فرمایا صرف """" وعلیکم """" کہہ دیا کرو ۔"
"13919","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں تمہیں نبی ﷽ سے سنی ہوئی ایک ایسی حدیث سناتا ہوں جو میرے بعد تم سے بیان نہ کرے گا ، میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ قیامت کی علامات میں یہ بات بھی ہے کہ علم اٹھا لیا جائے گا ، اس وقت جہالت کا غلبہ ہو گا ، بدکاری عام ہو گی ، اور شراب نوشی بکثرت ہو گی ، مردوں کی تعداد کم ہو جائے گی اور عورتوں کی تعداد بڑھ جائے گی ، حتیٰ کہ پچاس عورتوں کا ذمہ دار صرف ایک آدمی ہو گا ۔"
"13920","[Darussalam 12807] حضرت انس رضی اللہ عنہ سے مرفوعاً مروی ہے کہ قیامت اس وقت تک قائم نہیں ہوگی جب تک علم نہ اٹھالیا جائے، اس وقت جہالت کا غلبہ ہوگا، مردوں کی تعداد کم ہوجائے گی اور عورتوں کی تعداد بڑھ جائے گی حتیٰ کہ پچاس عورتوں کا ذمہ دار صرف ایک آدمی ہوگا۔"
"13921","[Darussalam 12807] حضرت انس رضی اللہ عنہ سے مرفوعاً مروی ہے کہ قیامت اس وقت تک قائم نہیں ہوگی جب تک علم نہ اٹھالیا جائے، اس وقت جہالت کا غلبہ ہوگا، مردوں کی تعداد کم ہوجائے گی اور عورتوں کی تعداد بڑھ جائے گی حتیٰ کہ پچاس عورتوں کا ذمہ دار صرف ایک آدمی ہوگا۔"
"13922","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے حضرت عبدالرحمن بن عوف رضی اللہ عنہ اور حضرت زبیر بن عوام رضی اللہ عنہ کو خارش کی وجہ سے ریشمی کپڑے پہننے کی اجازت مرحمت فرما دی ۔"
"13923","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے حضرت عبدالرحمن بن عوف رضی اللہ عنہ اور حضرت زبیر بن عوام رضی اللہ عنہ کو کسی خاص علت کی وجہ سے ریشمی کپڑے پہننے کی اجازت مرحمت فرما دی ۔"
"13924","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے حضرت عبدالرحمن بن عوف رضی اللہ عنہ اور حضرت زبیر بن عوام رضی اللہ عنہ کو + جواں کی وجہ سے , ریشمی کپڑے پہننے کی اجازت مرحمت فرما دی ۔"
"13925","حضرت انس رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے فرمایا اگر تم لوگ اپنے مردوں کو دفن کرنا چھوڑ نہ دیتے تو میں اللہ سے یہ دعاء کرتا کہ وہ تمہیں بھی عذاب قبر کی آواز سنا دے ۔"
"13926","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے ارشاد فرمایا جب تم میں سے کوئی شخص نماز پڑھ رہا ہوتا ہے تو وہ اپنے رب سے مناجات کر رہا ہوتا ہے ، اس لئے اس حالت میں تم میں سے کوئی شخص اپنے سامنے یا اپنی دائیں جانب نہ تھوکا کرے بلکہ بائیں جانب یا اپنے پااں کے نیچے تھوکا کرے ۔"
"13927","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ اور خلفاء ثلاثہ رضی اللہ عنہم نماز میں قراءت کا آغاز ®الحمدللہ رب العالمین¾ سے کرتے تھے ۔"
"13928","[Darussalam 13891] گزشتہ حدیث اس دوسری سند سے بھی مروی ہے۔"
"13929","حضرت انس رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کے ساتھ اور حضرات خلفاء ثلاثہ رضی اللہ عنہ کے ساتھ نماز پڑھی ہے ، میں نے ان میں سے کسی ایک کو بھی بلند آواز سے ®بسم اللہ¾ پڑھتے ہوئے نہیں سنا ۔"
"13930","قتادہ رحمۃ اللہ کہتے ہیں کہ میں نے حضرت انس رضی اللہ عنہ سے پوچھا کہ نبی ﷽ نماز میں قراءت کا آغاز کس چیز سے فرماتے تھے آ انہوں نے فرمایا کہ تم نے مجھ سے ایسا سوال پوچھا ہے جو اب تک کسی نے نہیں پوچھا ۔"
"13931","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ کو کدو بہت پسند تھا ، ایک مرتبہ نبی ﷽ کی خدمت میں کھانا پیش کیا گیا یا کسی نے دعوت کی تو چونکہ مجھے معلوم تھا کہ نبی ﷽ کو کدو مرغوب ہے لہٰذا میں اسے الگ کر کے نبی ﷽ کے سامنے کرتا رہا ۔"
"13932","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا رکوع و سجود کو مکمل کیا کرو ، کیونکہ میں بخدا تمہیں اپنی پشت کے پیچھے سے بھی دیکھ رہا ہوتا ہوں ۔"
"13933","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا سجدوں میں اعتدال برقرار رکھا کرو ، اور تم میں سے کوئی شخص کتے کی طرح اپنے ہاتھ نہ بچھائے ۔"
"13934","حضرت انس رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا سجدوں میں اعتدال برقرار رکھا کرو ، اور تم میں سے کوئی شخص کتے کی طرح اپنے ہاتھ نہ بچھائے ۔"
