hadiths[67]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3358","«داووا مرضاكم بالصدقة»","حسن","Sahih al-Jami al-Saghir 3358","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3359","«دباغ الأديم طهوره»","صحيح","Sahih al-Jami al-Saghir 3359","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3360","«دباغ جلود الميتة طهورها»","صحيح","Sahih al-Jami al-Saghir 3360","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3361","«دباغ كل إهاب طهوره»","صحيح","Sahih al-Jami al-Saghir 3361","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3362","«دحية الكلبي يشبه جبريل وعروة بن مسعود الثقفي يشبه عيسى بن مريم وعبد العزى يشبه الدجال»","صحيح","Sahih al-Jami al-Saghir 3362","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3363","«دخلت الجنة البارحة فنظرت فيها فإذا جعفر يطير مع الملائكة وإذا حمزة متكئ على سرير»","صحيح","Sahih al-Jami al-Saghir 3363","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3364","«دخلت الجنة فإذا أنا بقصر من ذهب فقلت: لمن هذا القصر؟ قالوا: لشاب من قريش فظننت أني أنا هو فقلت: ومن هو؟ قالوا: عمر بن الخطاب فلولا ما علمت من غيرتك لدخلته»","صحيح","Sahih al-Jami al-Saghir 3364","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3365","«دخلت الجنة فإذا أنا بنهر حافتاه خيام اللؤلؤ فضربت بيدي إلى ما يجري فيه الماء فإذا مسك أذفر فقلت: ما هذا يا جبريل؟ قال: هذا الكوثر الذي أعطاكه الله»","صحيح","Sahih al-Jami al-Saghir 3365","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3366","«دخلت الجنة فاستقبلتني جارية شابة فقلت: لمن أنت؟ قالت: لزيد بن حارثة»","صحيح","Sahih al-Jami al-Saghir 3366","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3367","«دخلت الجنة فرأيت لزيد بن عمرو بن نفيل درجتين»","حسن","Sahih al-Jami al-Saghir 3367","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3368","«دخلت الجنة فسمعت خشفة بين يدي فقلت: ما هذه الخشفة؟ فقيل: الغميصاء بنت ملحان»","صحيح","Sahih al-Jami al-Saghir 3368","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3369","«دخلت الجنة فسمعت خشفة بين يدي قلت: ما هذه الخشفة؟ فقيل: هذا بلال يمشي أمامك»","صحيح","Sahih al-Jami al-Saghir 3369","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3370","دخلت الجنة فسمعت خشفة فقلت: ما هذه؟ قالوا: هذا بلال ثم دخلت الجنة فسمعت خشفة فقلت: ما هذه؟ قالوا: هذه الغميصاء بنت ملحان","صحيح","Sahih al-Jami al-Saghir 3370","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3371","«دخلت الجنة فسمعت فيها قراءة فقلت: من هذا؟ قالوا: حارثة بن النعمان كذلكم البر كذلكم البر» !","صحيح","Sahih al-Jami al-Saghir 3371","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3372","«دخلت الجنة ليلة أسري بي فسمعت في جانبها وجسا فقلت: يا جبريل ما هذا؟ قال: هذا بلال المؤذن»","صحيح","Sahih al-Jami al-Saghir 3372","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3373","«دخلت العمرة في الحج إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 3373","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3374","«دخلت امرأة النار في هرة ربطتها فلم تطعمها ولم تدعها تأكل من خشاش الأرض حتى ماتت»","صحيح","Sahih al-Jami al-Saghir 3374","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3375","«درهم ربا يأكله الرجل وهو يعلم أشد عند الله من ستة وثلاثين زنية»","صحيح","Sahih al-Jami al-Saghir 3375","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3376","«دع داعي اللبن»","حسن","Sahih al-Jami al-Saghir 3376","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3377","«دع ما يريبك إلى ما لا يريبك»","صحيح","Sahih al-Jami al-Saghir 3377","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3378","«دع ما يريبك إلى ما لا يريبك فإن الصدق طمأنينة والكذب ريبة»","صحيح","Sahih al-Jami al-Saghir 3378","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3379","«دعاء الأخ لأخيه بظهر الغيب لا يرد»","صحيح","Sahih al-Jami al-Saghir 3379","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3380","«دعاء المرء المسلم مستجاب لأخيه بظهر الغيب عند رأسه ملك موكل به كلما دعا لأخيه بخير قال الملك: آمين ولك بمثل ذلك»","صحيح","Sahih al-Jami al-Saghir 3380","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3381","«دعوة الرجل لأخيه بظهر الغيب مستجابة وملك عند رأسه يقول: آمين ولك بمثل ذلك»","صحيح","Sahih al-Jami al-Saghir 3381","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3382","«دعوة المظلوم مستجابة وإن كان فاجرا ففجوره على نفسه»","حسن","Sahih al-Jami al-Saghir 3382","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3383","«دعوة ذي النون إذ دعا بها وهو في بطن الحوت لا إله إلا أنت سبحانك إني كنت من الظالمين لم يدع بها رجل مسلم في شيء قط إلا استجاب الله له»","صحيح","Sahih al-Jami al-Saghir 3383","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3384","«دعوا الحبشة ما ودعوكم واتركوا الترك ما تركوكم»","حسن","Sahih al-Jami al-Saghir 3384","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3385","«دعوا الناس يصيب بعضهم من بعض فإذا استنصح أحدكم أخاه فلينصحه»","صحيح","Sahih al-Jami al-Saghir 3385","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3386","«دعوا لي أصحابي فوالذي نفسي بيده لو أنفقتم مثل أحد ذهبا ما بلغتم أعمالهم»","صحيح","Sahih al-Jami al-Saghir 3386","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3387","«دعوه فإن لصاحب الحق مقالا»","صحيح","Sahih al-Jami al-Saghir 3387","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3388","«دعوات المكروب: اللهم رحمتك أرجو فلا تكلني إلى نفسي طرفة عين وأصلح لي شأني كله لا إله إلا أنت»","حسن","Sahih al-Jami al-Saghir 3388","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3389","«دفن بالطينة التي خلق منها»","حسن","Sahih al-Jami al-Saghir 3389","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3390","«دليل الخير كفاعله»","حسن","Sahih al-Jami al-Saghir 3390","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3391","«دم عفراء أحب إلى الله من سوداوين»","حسن","Sahih al-Jami al-Saghir 3391","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3392","«دم عفراء أزكى عند الله من دم سوداوين»","حسن","Sahih al-Jami al-Saghir 3392","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3393","«دونك فانتصري»","صحيح","Sahih al-Jami al-Saghir 3393","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3394","«دية أصابع اليدين والرجلين سواء عشر من الإبل لكل إصبع»","صحيح","Sahih al-Jami al-Saghir 3394","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3395","«دية المعاهد نصف دية الحر»","صحيح","Sahih al-Jami al-Saghir 3395","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3396","«دية المكاتب بقدر ما عتق منه دية الحر وبقدر ما رق منه دية العبد»","صحيح","Sahih al-Jami al-Saghir 3396","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3397","«دية عقل الكافر نصف عقل المؤمن»","صحيح","Sahih al-Jami al-Saghir 3397","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3398","«دينار أنفقته في سبيل الله ودينار أنفقته في رقبة ودينار تصدقت به على مسكين ودينار أنفقته على أهلك أعظمها أجرا الذي أنفقته على أهلك»","صحيح","Sahih al-Jami al-Saghir 3398","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3399","«الدال على الخير كفاعله»","صحيح","Sahih al-Jami al-Saghir 3399","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3400","«الدجال أعور العين اليسرى جفال الشعر معه جنة ونار فناره جنة وجنته نار»","صحيح","Sahih al-Jami al-Saghir 3400","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3401","«الدجال عينه خضراء»","صحيح","Sahih al-Jami al-Saghir 3401","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3402","«الدجال ممسوح العين مكتوب بين عينيه كافر يقرؤه كل مسلم»","صحيح","Sahih al-Jami al-Saghir 3402","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3403","«الدجال لا يولد له ولا يدخل المدينة ولا مكة»","صحيح","Sahih al-Jami al-Saghir 3403","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3404","«الدجال يخرج من أرض بالمشرق يقال لها خراسان يتبعه أقوام كأن وجوههم المجان المطرقة»","صحيح","Sahih al-Jami al-Saghir 3404","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3405","«الدعاء بين الأذان والإقامة مستجاب فادعوا»","صحيح","Sahih al-Jami al-Saghir 3405","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3406","«الدعاء مستجاب بين النداء والإقامة»","حسن","Sahih al-Jami al-Saghir 3406","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3407","«الدعاء هو العبادة»","صحيح","Sahih al-Jami al-Saghir 3407","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3408","«الدعاء لا يرد بين الأذان والإقامة»","صحيح","Sahih al-Jami al-Saghir 3408","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3409","«الدعاء ينفع مما نزل ومما لم ينزل فعليكم عباد الله بالدعاء»","حسن","Sahih al-Jami al-Saghir 3409","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3410","«الدنيا حلوة خضرة فمن أخذها بحقه بورك له فيها ورب متخوض فيما اشتهت نفسه ليس له يوم القيامة إلا النار»","صحيح","Sahih al-Jami al-Saghir 3410","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3411","«الدنيا خضرة حلوة»","صحيح","Sahih al-Jami al-Saghir 3411","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3412","«الدنيا سجن المؤمن وجنة الكافر»","صحيح","Sahih al-Jami al-Saghir 3412","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3413","«الدنيا كلها متاع وخير متاع الدنيا المرأة الصالحة»","صحيح","Sahih al-Jami al-Saghir 3413","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3414","الدنيا ملعونة ملعون ما فيها إلا ذكر الله وما والاه وعالما أو متعلما","حسن","Sahih al-Jami al-Saghir 3414","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3415","«الدواء من القدر وقد ينفع بإذن الله تعالى»","حسن","Sahih al-Jami al-Saghir 3415","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3416","«الدواء من القدر وهو ينفع من يشاء بما شاء»","حسن","Sahih al-Jami al-Saghir 3416","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3417","«الدين النصيحة»","صحيح","Sahih al-Jami al-Saghir 3417","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3418","«الدين دينان فمن مات وهو ينوي قضاءه فأنا وليه ومن مات ولا ينوي قضاءه فذاك الذي يؤخذ من حسناته ليس يومئذ دينار ولا درهم»","صحيح","Sahih al-Jami al-Saghir 3418","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3419","«الدين قبل الوصية وليس لوارث وصية»","حسن","Sahih al-Jami al-Saghir 3419","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3420","«الدين يسر ولن يغالب الدين أحد إلا غلبه»","صحيح","Sahih al-Jami al-Saghir 3420","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3421","«الدينار بالدينار والدرهم بالدرهم وصاع حنطة بصاع حنطة وصاع شعير بصاع شعير وصاع ملح بصاع ملح لا فضل بين شيء من ذلك»","صحيح","Sahih al-Jami al-Saghir 3421","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3422","«الدينار بالدينار لا فضل بينهما والدرهم بالدرهم لا فضل بينهما»","صحيح","Sahih al-Jami al-Saghir 3422","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3423","«الدينار بالدينار لا فضل بينهما والدرهم بالدرهم لا فضل بينهما فمن كانت له حاجة بورق فليصطرفهما بذهب ومن كان له حاجة بذهب فليصطرفها بالورق والصرف هاؤها»","صحيح","Sahih al-Jami al-Saghir 3423","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
"3424","«الدينار كنز والدرهم كنز والقيراط كنز»","صحيح","Sahih al-Jami al-Saghir 3424","","","الأحاديث المبدوءة بحرف الدال Hadith Beginning with the Letter Dal (د)"
