hadiths[493]{hadithnumber,text}:
"1009","[AI-translation] ((Salamu ni zawadi kwa umma wetu na ulinzi kwa dhimmi zetu.))"
"1010","[AI-translation] ((Yule anayesengenya na yule anayesikiliza masengenyo wote ni washirika katika dhambi.))"
"1011","[AI-translation] ((Kafara ya yule uliyemsengenya ni kwamba umwombee maghfira.))"
"1012","[AI-translation] ((Mwenye husda na msengenyaji hawana uhusiano nami.))"
"1013","[AI-translation] ((Ghadhabu inatoka kwa Shetani, na Shetani aliumbwa kutokana na moto, na moto huzimwa kwa maji, basi mmoja wenu anapoghadhibika, atawadhe [udhu].))"
"1014","[AI-translation] ((Ghadhabu ni kaa linalowaka moyoni mwa mwana wa Adam.))"
"1015","[AI-translation] ((Muumini huwa na haraka ya kughadhibika na haraka ya kuridhika.))"
"1016","[AI-translation] ((Watu bora wa umma wangu ni wale ambao, wakighadhibika, hurejea kutoka humo.))"
"1017","[AI-translation] ((Usaliti mkubwa zaidi ni kwamba useme kitu kwa ndugu yako, akakuamini, lakini unamwambia uongo.))"
"1018","[AI-translation] ((Epukeni uongo, kwani uongo humwongoza mtu mbali na imani.))"
"1019","[AI-translation] ((Msinywe kwa funda moja kama ngamia, bali nyweni kwa mafunda mawili au matatu, na mnapoanza kunywa, semeni Bismillah, na mnapomaliza na kusimama, semeni Alhamdulillah.))"
"1020","[AI-translation] ((Msimtangulie [yaani baba yako], msikae mbele yake, wala msimwite kwa jina lake.))"
"1021","[AI-translation] ((Miongoni mwa dhambi zote, Allah huchelewesha adhabu kwa atakayo hadi Siku ya Kiama, isipokuwa kumuasi mzazi; hakika Allah huwapa wanaowaasi wazazi adhabu yao duniani kabla ya kifo.))"
"1022","[AI-translation] ((Hakika kupitia sadaka na kuunganisha uhusiano wa undugu, Allah Mtukufu huongeza umri na hulinda kutokana na kifo kibaya.))"
"1023","[AI-translation] ((Allah Mtukufu, kupitia baraka ya kuunganisha uhusiano wa undugu, hustawisha mikoa ya watu na huongeza mali zao.))"
"1024","[AI-translation] ((Yule mwenye sifa tatu, Allah Mtukufu atamhesabu hisabu nyepesi na atamwingiza Peponi kwa rehma yake [nazo ni]: Mpe yule anayekunyima, unganisha uhusiano na yule anayekata uhusiano nawe, na msamehe yule anayekudhulumu.))"
"1025","[AI-translation] ((Mtu anapokutana na ndugu yake baada ya kurudi kutoka Ijumaa, aseme ((Allah atukubalie kutoka kwetu na kutoka kwako)), yaani: Allah aikubali [kutoka kwetu na kutoka kwako].))"
"1026","[AI-translation] ((Peaneni zawadi, kwani huunda mapenzi na huondoa chuki.))"
"1027","[AI-translation] ((Peaneni zawadi, hakika zawadi huondoa magonjwa na shaka moyoni.))"
"1028","[AI-translation] ((Peaneni mikono; hii itaondoa chuki na udanganyifu nyoyoni mwenu.))"
"1029","[AI-translation] ((Waislamu wawili wanapo peana mikono wanapokutana na kumhimidi Allah na kuomba maghfira yake, Allah huwaghfiria.))"
"1030","[AI-translation] ((Muumini anapo peana mkono na muumini mwingine, rehma mia moja hushuka kwao wote.))"
"1031","[AI-translation] ((Msibishane na ndugu yako Muislamu, msimdhihaki, wala msimwahidi ahadi ambayo kisha huivunja.))"
"1032","[AI-translation] ((Sifa mbili haziwezi kuchanganyika kwa muumini: ubahiri na tabia mbaya.))"
"1033","[AI-translation] ((Mdanganyifu, mbahiri, na mtu mwenye tabia mbaya hataingia Peponi.))"
"1034","[AI-translation] ((Msiba ni kutokana na hasira mbaya.))"
"1035","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akisoma [dua hii] anapotazama kiooni: ((Ee Allah, kama ulivyoifanya sura yangu kuwa nzuri, ifanye tabia yangu kuwa nzuri pia)). Yaani: Ee Allah, kama ulivyoifanya sura yangu ya kimwili kuwa nzuri, ifanye tabia yangu kuwa nzuri pia.))"
"1036","[AI-translation] ((Kijana yeyote anayemheshimu mzee kwa sababu ya umri wake, Allah Mtukufu atamwekea mtu atakayemheshimu uzeeni mwake.))"
"1037","[AI-translation] ((Siku moja Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa amekaa wakati baba yake wa kunyonyesha alikuja, basi Mtume (Swalla Allahu 'alayhi wa sallam) alitandika sehemu ya vazi lake kwake naye akakaa juu yake. Kisha mama yake wa kunyonyesha alikuja, basi Mtume (Swalla Allahu 'alayhi wa sallam) alitandika vazi lake upande mwingine naye akakaa juu yake. Kisha ndugu yake wa kunyonyesha alikuja, basi Mtume (Swalla Allahu 'alayhi wa sallam) alisimama kwa ajili yake na akamkalisha mbele yake.))"
"1038","[AI-translation] ((Punda pekee ndiye anayekataa heshima na adabu.))"
"1039","[AI-translation] ((Lau hayaa ingekuwa mtu, ingekuwa mtu mwema, na lau ukosefu wa hayaa ungekua mtu, ungekua mtu mbaya.))"
"1040","[AI-translation] ((Amelaaniwa mtu juu ya ulimi uliobarikiwa wa Mtume (Swalla Allahu 'alayhi wa sallam) anayekaa katikati ya kikao.))"
"1041","[AI-translation] ((Uzuri wa mtu ni ufasaha wa ulimi wake.))"
"1042","[AI-translation] ((Simulieni tu zile za hadithi zangu mbele ya wafuasi wangu ambazo akili zao zinaweza kuzifahamu.))"
"1043","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) aliposimulia hadithi, alitabasamu.))"
"1044","[AI-translation] ((Mimi si miongoni mwa mchezo na starehe, wala mchezo na starehe hauna uhusiano nami.))"
"1045","[AI-translation] ((Msimtishie Muislamu, kwani kumtisha Muislamu ni dhuluma kubwa.))"
"1046","[AI-translation] ((Baada ya faradhi, tendo linalopendwa zaidi na Allah Mtukufu ni kumletea furaha Muislamu.))"
"1047","[AI-translation] ((Yule anayemletea furaha kaya ya Kiislamu, Allah Mtukufu ataridhika kumpa Pepo kama malipo.))"
"1048","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) hakuwahi kupiga miayo.))"
"1049","[AI-translation] ((Allah Mtukufu huchukia kuinua sauti wakati wa kupiga chafya na kupiga miayo.))"
"1050","[AI-translation] ((Yule anayepiga chafya au kuungua, au akimsikia mtu akipiga chafya au kuungua na akasema: ((Sifa zote ni za Allah katika kila hali)), basi Allah Mtukufu ataondoa magonjwa sabini kwake, mepesi yake ni ukoma.))"
"1051","[AI-translation] ((Muislamu anapopiga chafya na kusema ((Sifa zote ni za Allah)), Allah Mtukufu humuumba malaika kutokana na chafya yake anayeendelea kumtukuza Allah hadi Siku ya Kiama.))"
"1052","[AI-translation] ((Jihadharini na kuwa uchi, kwani kuna mwenye nanyi asiyekuacheni kamwe [yaani malaika], isipokuwa wakati wa kujisaidia na mtu anapokuwa na mkewe.))"
"1053","[AI-translation] ((Watu wa Peponi watazungumza Kiarabu.))"
"1054","[AI-translation] ((Hakuna mojawapo ya mambo matatu haya kilichookolewa: shaka, ishara mbaya, na husda.))"
"1055","[AI-translation] ((Kama ni haki kujibu salamu, pia ni haki kujibu barua.))"
"1056","[AI-translation] ((Yule anayeangalia barua ya ndugu yake bila idhini, ni kana kwamba ameangalia Motoni.))"
"1057","[AI-translation] ((Dunia ni mzoga, na wanaoitafuta ni mbwa.))"
"1058","[AI-translation] ((Yule mwenye wingi wa vitu atakuwa na shughuli nyingi; yule mwenye shughuli nyingi atakuwa na tamaa kubwa; yule mwenye tamaa kubwa atakuwa na wasiwasi mkubwa; na yule mwenye wasiwasi mkubwa atakuwa mghafilika wa Bwana wake.))"
"1059","[AI-translation] ((Mkitaka kumkuta Allah Mtukufu katika hali kwamba ameridhika nanyi, basi msifiche mlichopewa, wala msizuilie mnachoombwa.))"
"1060","[AI-translation] ((Yule anayeamka asubuhi na hamu ya dunia hana uhusiano na Allah Mtukufu.))"
"1061","[AI-translation] ((Hakuna kheri kwa mtu asiyekusanya mali kwa kuunganisha uhusiano wa undugu, kutimiza amana, na kujitegemea mbali na viumbe vya Allah.))"
"1062","[AI-translation] ((Allah amlaani masikini anayejinyenyekeza mbele ya tajiri kwa sababu ya mali yake tu.))"
"1063","[AI-translation] ((Yule anayeonyesha unyenyekevu mbele ya tajiri kwa sababu ya mali yake tu, thuluthi mbili ya dini yake imepotea.))"
"1064","[AI-translation] ((Ufunguo wa kila taifa upo, na ufunguo wa Pepo ni masikini na wahitaji; watu hawa watakuwa katika kikao cha Allah Siku ya Kiama.))"
"1065","[AI-translation] ((Nikuteni kwa nia zenu, si kwa matendo yenu.))"
"1066","[AI-translation] ((Msiangalie udogo wa uasi, bali angalieni ukuu wa Yule mnayemuasi.))"
"1067","[AI-translation] ((Epukeni sehemu za shaka.))"
"1068","[AI-translation] ((Mja anapoonyesha unyenyekevu, Allah Mtukufu humwinua kuelekea mbingu ya saba.))"
"1069","[AI-translation] ((Kuweni imara na wagumu, fanyeni mazoezi ya upinde, na tembeeni bila viatu.))"
"1070","[AI-translation] ((Dua ni kiini cha ibada.))"
"1071","[AI-translation] ((Msionyeshe udhaifu katika kuomba dua, kwani hakuna anayeharibika kamwe kwa kuomba dua.))"
"1072","[AI-translation] ((Dua ni silaha ya muumini, nguzo ya dini, na nuru ya mbinguni na ardhi.))"
"1073","[AI-translation] ((Si halali kwa mtu kuwaongoza watu katika swala kisha akaomba dua kwa ajili yake peke yake, akiwaacha wengine; akifanya hivyo, hakika amewasaliti watu.))"
"1074","[AI-translation] ((Kila mmoja wenu amuombe Bwana wake haja zake zote, hata kama ukanda wa kiatu chake ukikatika, amuombe hilo pia.))"
"1075","[AI-translation] ((Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) alipoinua mikono yake kwa dua, hakuishusha hadi alipoipitisha usoni mwake.))"
"1076","[AI-translation] ((Tandazeni ndani ya viganja vyenu mnapoomba [katika dua]; msiombe kwa nje, na mnapomaliza [dua], vifuteni viganja vyenu nyusoni mwenu.))"
"1077","[AI-translation] ((Hakika Allah Mtukufu huwapenda wale wanaoendelea katika dua.))"
"1078","[AI-translation] Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) alisema: Allah anaporudisha roho kwa mja [asubuhi], kisha akasoma dua hii ((Hapana mungu isipokuwa Allah peke yake hana mshirika, ufalme ni wake na sifa ni zake naye juu ya kila kitu ni Muweza)), Allah humghfiria dhambi zake zote, hata kama ni nyingi kama povu la bahari."
"1079","[AI-translation] ((Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) alisema: Yule anayesoma dua hii anapoamka usingizini: ((Sifa zote ni za Allah ambaye aliumba usingizi na kuamka, sifa zote ni za Allah ambaye aliumba [n.k.]))))"
"1080","[AI-translation] ((Yule anayesoma dua za asubuhi na jioni daima yuko chini ya ulinzi wa Allah.))"
"1081","[AI-translation] ((Mtu anapoamka usiku na akasema ((Hapana mungu isipokuwa Allah)) mara kumi, Allah humghfiria dhambi zake zote.))"
"1082","[AI-translation] ((Yule anayesema ((Nashuhudia kwamba hakuna mungu isipokuwa Allah)) mara mia moja kila siku, uso wake utang'aa kama mwezi Siku ya Kiama.))"
"1083","[AI-translation] ((Mtu anayesema ((Subhanallah wa bihamdihi)) mara mia moja asubuhi na jioni, hakuna atakayekuja Siku ya Kiama na mema zaidi kuliko yake.))"
"1084","[AI-translation] ((Yule anayesema ((La hawla wala quwwata illa billah)) mara kumi, husafishwa kutokana na dhambi zake kama siku mama yake alimzaa.))"
"1085","[AI-translation] ((Yule anayesoma ((Qul Huwallahu Ahad)) mara kumi, Allah humjengea jumba Peponi.))"
"1086","[AI-translation] ((Mtu anayesoma Sura Al-Ikhlas mara ishirini, Allah humghfiria dhambi za miaka ishirini.))"
"1087","[AI-translation] ((Mtu anayesoma Ayat al-Kursi baada ya kila swala, hakuna kitakachomzuia kuingia Peponi isipokuwa kifo.))"
"1088","[AI-translation] ((Yule anayesoma Ayat al-Kursi na Sura Al-Ikhlas kila usiku, yuko salama kutokana na kila shari.))"
"1089","[AI-translation] ((Mtu anayesoma Sura Al-Baqarah nyumbani kwake, Shetani hatoroki humo kwa siku tatu.))"
"1090","[AI-translation] ((Yule anayesoma Sura Al-Kahf siku ya Ijumaa, nuru itamwangazia kutoka chini ya miguu yake hadi mawingu ya mbinguni.))"
"1091","[AI-translation] ((Mtu anayesoma Sura Ya-Sin asubuhi, haja zake hutimizwa.))"
"1092","[AI-translation] ((Yule anayesoma Sura Ad-Dukhan usiku wa Ijumaa ataghfiriwa.))"
"1093","[AI-translation] ((Mtu anayesoma Sura Al-Mulk kila usiku, yuko salama kutokana na adhabu ya kaburi.))"
"1094","[AI-translation] ((Yule anayesoma Sura Al-Waqi'a kila usiku kamwe hatapata umasikini.))"
"1095","[AI-translation] ((Mtu anayesoma Sura Al-Ikhlas, Sura Al-Falaq, na Sura An-Nas mara saba baada ya swala ya Ijumaa, Allah Mtukufu humlinda kutokana na shari hadi Ijumaa ijayo.))"
"1096","[AI-translation] ((Yule anayesoma Sura Al-Fatiha na Ayat al-Kursi nyumbani, jicho baya la binadamu au jini halitamdhuru siku hiyo.))"
"1097","[AI-translation] ((Mtu anayesoma ((Bismillah alladhi la yadurru ma'asmihi shay'un fil-ardi wala fis-sama')) mara tatu asubuhi na jioni, hakuna kitakachomdhuru siku hiyo.))"
"1098","[AI-translation] ((Yule anayesoma dua hii asubuhi ((Ee Allah, nakuomba afya duniani na Akhera)), Allah humkinga na kila balaa.))"
"1099","[AI-translation] ((Mtu anapoingia sokoni na kusema ((La ilaha illallah wahdahu la sharika lah...)) mara moja, Allah humwandikia mema milioni moja.))"
"1100","[AI-translation] ((Yule anayesema ((Subhanallah walhamdulillah wala ilaha illallah wallahu akbar)) mara moja, mti mmoja hupandwa kwake Peponi.))"
"1101","[AI-translation] ((Mtu anayesema ((Astaghfirullah)) mara mia moja kwa siku, dhambi zake hughfiriwa hata kama ni nyingi kama povu la bahari.))"
"1102","[AI-translation] ((Yule anayesoma salawat juu yangu mara moja, Allah humsomea salawat mara kumi.))"
"1103","[AI-translation] ((Mtu anayenisomea salawat mara mia moja siku ya Ijumaa, haja zake mia moja hutimizwa.))"
"1104","[AI-translation] ((Yule anayenisomea salawat mara mia moja asubuhi na jioni, Allah atamtimizia haja zake zote za dunia na Akhera.))"
"1105","[AI-translation] ((Mtu anayenisomea salawat mara elfu kwa siku, hatafa hadi aone sehemu yake Peponi.))"
"1106","[AI-translation] ((Yule anayesoma ((Allahumma salli 'ala Muhammad)) mara moja kwa ikhlasi, Allah humghfiria dhambi zake zote.))"
"1107","[AI-translation] ((Mtu anayenisomea salawat kaburini mwangu, humsikia.))"
"1108","[AI-translation] ((Yule anayenisomea salawat kwa sauti, malaika humwombea maghfira.))"
"1109","[AI-translation] ((Mtu anaposema Amin baada ya dua, Allah humkubalia.))"
"1110","[AI-translation] ((Yule anayeomba maghfira kwa Waislamu, Allah humwandikia mema kwa kila Muislamu.))"
"1111","[AI-translation] ((Mtu anayeomba dua kwa ndugu yake kwa ghaibu, malaika husema: Amin, nawe upate kama hayo.))"
"1112","[AI-translation] ((Yule anayeomba dua baada ya adhana, dua yake haikataliwi.))"
"1113","[AI-translation] ((Mtu anayeomba dua wakati wa mvua, dua yake haikataliwi.))"
"1114","[AI-translation] ((Yule anayeomba dua katikati ya usiku, Allah hushuka kwenye mbingu ya karibu na kusema: Nani ananiomba nipate kumpa?))"
"1115","[AI-translation] ((Mtu anayelala na udhu, malaika hulala naye nguo zake ndani, na kila anapogeuka usiku, malaika husema: Ee Allah, mghfirie mja wako, kwani alilala na twahara.))"
"1116","[AI-translation] ((Yule anayelala bila udhu, roho yake huinuliwa hadi Arshi.))"
"1117","[AI-translation] ((Mtu anapoamka usiku kwa ajili ya swala, milango ya mbinguni hufunguliwa kwake.))"
"1118","[AI-translation] ((Yule anayeswali usiku huku watu wamelala, ataingia Peponi kwa amani.))"
"1119","[AI-translation] ((Mtu anayeswali swala ya Duha mara kwa mara, dhambi zake hughfiriwa hata kama ni nyingi kama povu la bahari.))"
"1120","[AI-translation] ((Yule anayesoma Qur'an na kuifanyia kazi, wazazi wake huvishwa taji Siku ya Kiama.))"
"1121","[AI-translation] ((Mtu anayesoma herufi moja ya Qur'an, hupata mema kumi.))"
"1122","[AI-translation] ((Yule anayesoma Qur'an kwa shida, hupata ujira mara mbili.))"
"1123","[AI-translation] ((Mtu anayehifadhi Qur'an na kuifanyia kazi, ataingia Peponi na atauombea watu kumi wa familia yake.))"
"1124","[AI-translation] ((Yule anayesoma Sura Al-Baqarah na Aal-e-Imran, zitakuja kama mawingu mawili Siku ya Kiama.))"
"1125","[AI-translation] ((Mtu anayesoma Sura Al-Kahf, nuru itamwangazia hadi Ijumaa ijayo.))"
"1126","[AI-translation] ((Yule anayesoma Sura Ya-Sin kwa radhi ya Allah, Allah Mtukufu atamghfiria dhambi zake zilizotangulia.))"
"1127","[AI-translation] ((Mtu anayesoma Sura Al-Waqi'a na kuijifunza hataandikwa miongoni mwa wenye kughafilika, na kaya yake haitakuwa na haja.))"
"1128","[AI-translation] ((Yule anayesoma Sura Al-Mulk kabla ya kulala, yuko salama kutokana na adhabu ya kaburi.))"
"1129","[AI-translation] ((Mtu anayesoma Sura As-Sajdah na Sura Al-Mulk baina ya Magharibi na Isha, ni kana kwamba amekesha Laylat al-Qadr.))"
"1130","[AI-translation] ((Yule anayeamka usiku na kusoma aya kumi, hataandikwa miongoni mwa wenye kughafilika.))"
"1131","[AI-translation] ((Mtu anayesoma aya mia moja usiku, huandikiwa miongoni mwa wenye utii.))"
"1132","[AI-translation] ((Yule anayesoma Sura Al-Ikhlas mara mia mbili, Allah Mtukufu atamghfiria dhambi za miaka mia mbili.))"
"1133","[AI-translation] ((Mtu anayepita makaburini na kusoma Sura Al-Ikhlas mara kumi na moja, kisha akawazawadia thawabu maiti, atapewa ujira sawa na idadi ya maiti.))"
"1134","[AI-translation] ((Yule anayesoma ((Qul a'udhu birabbil-falaq)) na ((Qul a'udhu birabbin-nas)) mara tatu asubuhi na jioni, yuko salama kutokana na kila shari.))"
"1135","[AI-translation] ((Mtu anayesoma Ayat al-Kursi anapolala kitandani mwake, Allah humwekea mlinzi, wala Shetani hatamkaribia hadi asubuhi.))"
"1136","[AI-translation] ((Yule anayesoma maneno mawili mepesi kwa ulimi, mazito kwa mizani [Subhanallah wa bihamdihi, Subhanallahil-Adhim], Allah humpenda.))"
"1137","[AI-translation] ((Mtu anayesema ((Subhanallah)) mara thelathini na tatu, ((Alhamdulillah)) mara thelathini na tatu, na ((Allahu Akbar)) mara thelathini na nne baada ya kila swala, dhambi zake hughfiriwa hata kama ni nyingi kama povu la bahari.))"
"1138","[AI-translation] ((Yule anayesema ((La ilaha illallah)) kwa ikhlasi ataingia Peponi.))"
"1139","[AI-translation] ((Mtu anayesema ((Astaghfirullah alladhi la ilaha illa huwal-Hayyul-Qayyum wa atubu ilayh)) mara tatu kabla ya Alfajiri siku ya Ijumaa, dhambi zake zote zitaghfiriwa hata kama ni nyingi kama povu la bahari.))"
"1140","[AI-translation] ((Yule anayekula na kusema ((Alhamdulillah)), Allah humridhia.))"
"1141","[AI-translation] ((Mtu anayevua nguo zake na kusema ((Bismillah)), Shetani hawezi kumtazama.))"
"1142","[AI-translation] ((Yule anayeingia nyumbani kwake na kusalimia, Shetani huondoka nyumbani mwake.))"
"1143","[AI-translation] ((Mtu anapoingia msikitini, aseme ((A'udhu billahil-Adhim...)) na malaika humlinda hadi atoke.))"
"1144","[AI-translation] ((Yule anapotoka nyumbani kwake na kusema ((Bismillah, tawakkaltu 'alallah...)), malaika husema: Umeongozwa, umetoshelezwa, umelindwa.))"
"1145","[AI-translation] ((Mtu anapopanda kipando chake na kusema ((Bismillah)), malaika humlinda hadi ashuke.))"
"1146","[AI-translation] ((Yule anapoona kitu anachokipenda na kusema ((Mashaallah, la quwwata illa billah)), hakitadhurika na jicho baya.))"
"1147","[AI-translation] ((Mtu anapoona mwezi mpya na kusema ((Allahumma ahillahu 'alayna bil-amni wal-iman...)), Allah humbariki mwezi huo.))"
"1148","[AI-translation] ((Yule anapoona mvua ya kwanza na kusema ((Allahumma sayyiban nafi'an)), Allah humbariki mwaka huo.))"
"1149","[AI-translation] ((Mtu anaposikia radi na kusema ((Subhanalladhi yusabbihur-ra'du bihamdihi...)), hatoathirika na radi.))"
"1150","[AI-translation] ((Yule anapopiga chafya na kusema ((Alhamdulillah)), Allah humuumba malaika anayemtukuza hadi Siku ya Kiama.))"
"1151","[AI-translation] ((Mtu anapopiga miayo, aifunike mdomo wake, kwani Shetani huingia.))"
"1152","[AI-translation] ((Yule anapocheka kwa sauti katika swala, arejee udhu na swala yake.))"
"1153","[AI-translation] ((Mtu anapolia kwa kuogopa Allah, machozi yake huzima moto wa Jahannamu.))"
"1154","[AI-translation] ((Yule anapoogopa jambo na kusema ((Hasbunallah wa ni'mal-wakil)), Allah humtosheleza.))"
"1155","[AI-translation] ((Mtu anapopatwa na msiba na kusema ((Inna lillahi wa inna ilayhi raji'un)), Allah humfidia na humpa bora kuliko kilichopotea.))"
"1156","[AI-translation] ((Yule anapoona mgonjwa na kusema ((Alhamdulillahilladhi 'afani...)), yuko salama kutokana na ugonjwa huo.))"
"1157","[AI-translation] ((Mtu anapoona maiti na kusema ((Inna lillahi wa inna ilayhi raji'un)), Allah humwandikia ujira wa shahidi.))"
"1158","[AI-translation] ((Yule anapoingia sokoni na kusema ((La ilaha illallah...)), Allah humwandikia mema milioni moja.))"
"1159","[AI-translation] ((Mtu anapoona kioo na kusema ((Allahumma kama hassanta khalqi fahassin khuluqi)), Allah humfanya tabia yake kuwa nzuri.))"
"1160","[AI-translation] ((Yule anapovaa nguo mpya na kusema ((Alhamdulillahilladhi kasani...)), dhambi zake zilizotangulia hughfiriwa.))"
"1161","[AI-translation] ((Mtu anapokula chakula na kusema ((Alhamdulillahilladhi at'amani...)), dhambi zake zilizotangulia hughfiriwa.))"
"1162","[AI-translation] ((Yule anapokunywa maziwa na kusema ((Allahumma barik lana fihi wa zidna minhu)), Allah humbariki.))"
"1163","[AI-translation] ((Mtu anapoanza safari na kusema ((Subhanalladhi sakhkhara lana hadha...)), Allah humlinda hadi arudi.))"
"1164","[AI-translation] ((Yule anaporudi kutoka safari na kusema ((Ayibuna ta'ibuna...)), Allah humkubalia toba yake.))"
"1165","[AI-translation] ((Mtu anapoona mji na kusema ((Allahumma barik lana fiha...)), Allah humbariki mji huo.))"
"1166","[AI-translation] ((Yule anapoingia msikiti wa Makka na kuona Kaaba na kusema ((Allahumma zid hadhal-bayta tashrifan...)), Allah humwandikia mema ishirini.))"
"1167","[AI-translation] ((Watu hufuata dini ya wafalme wao.))"
"1168","[AI-translation] ((Katika siku za karibu, kutakuwa na watawala dhalimu katika zama za mwisho; basi yule anayeogopa fimbo yao na upanga wao, asiwamrishe [mema] wala asiwa k[ataze maovu].))"
"1169","[AI-translation] ((Dua ya aliyedhulumiwa inakubaliwa maadamu si wengi zaidi kuliko madhalimu, na wakiwa wengi zaidi kuliko wao, basi dua yao haikubaliwi.))"
"1170","[AI-translation] ((Yule anayemsaidia dhalimu, Allah Mtukufu humwekea huyo [dhalimu] juu yake.))"
"1171","[AI-translation] ((Wale wanaoonyesha haraka mbele ya mfalme, askari wa jeshi, na wasaidizi wa madhalimu ni mbwa wa Moto.))"
"1172","[AI-translation] ((Ghadhabu ya Allah huwa kali kwa yule anayemdhulumu mtu asiye na msaidizi isipokuwa Allah.))"
"1173","[AI-translation] ((Ee Abu Hurairah! Usiwalaani watawala, kwa sababu Allah Mtukufu ametuma kundi Motoni kwa sababu walikuwa wakiwalaani watawala wao.))"
"1174","[AI-translation] ((Kuna Mafirauni kumi na wawili: watano walikuwa katika umma zilizotangulia na saba watakuwa katika umma wangu.))"
"1175","[AI-translation] ((Chochote mtu anachotumia kulinda heshima yake, ni sadaka kwake.))"
"1176","[AI-translation] ((Yule anayemdhuru dhimmi, nitakuwa mpinzani wake Siku ya Kiama.))"
"1177","[AI-translation] ((Mkimkuta yule anayekusanya zaka ya biashara [ushuru], basi muueni.))"
"1178","[AI-translation] ((Allah Mtukufu anasema: Yule ambaye ameshughulishwa na Qur'an kwamba humsahaulisha dhikr yangu na kuniomba [yaani mtu anayesoma Qur'an sana kwamba hapati hata fursa ya kumwomba Allah], basi nitampa bora kuliko niwapavyo wanaoomba, na ubora wa Neno la Allah juu ya maneno mengine yote ni kama ubora wa Allah juu ya viumbe vyake.))"
"1179","[AI-translation] ((Hakuna sehemu ya Qur'an inayotosheleza kama Sura Al-Fatiha inavyotosheleza, na lau Sura Al-Fatiha ingewekwa upande mmoja wa mizani na Qur'an yote upande mwingine, Sura Al-Fatiha ingezilemea Qur'an mara saba.))"
"1180","[AI-translation] ((Kuna tiba ya sumu katika Sura Al-Fatiha.))"
"1181","[AI-translation] ((Mnapolala kitandani mwenu na kusoma Sura Al-Fatiha na 'Qul Huwallahu Ahad', basi mko salama kutokana na kila kitu isipokuwa kifo.))"
"1182","[AI-translation] ((Yule anayesoma Sura Al-Fatiha na Ayat Al-Kursi nyumbani, jicho baya la binadamu au jini halitamdhuru siku hiyo.))"
"1183","[AI-translation] ((Sura Al-Fatiha ni sawa na thuluthi mbili ya Qur'an.))"
"1184","[AI-translation] ((Aya mbili zinatoka Qur'an; zote zitauombea, Allah huzipenda, na zote ni aya za mwisho za Sura Al-Baqarah.))"
"1185","[AI-translation] ((Yule anayesoma Sura Al-Baqarah atavikwa taji Peponi.))"
"1186","[AI-translation] ((Kila kitu kina nundu [yaani sehemu ya juu], na nundu ya Qur'an ni Sura Al-Baqarah.))"
"1187","[AI-translation] ((Yule anayesoma siku ya Ijumaa sura ambayo familia ya Imran imetajwa humo, Allah Mtukufu atamteremshia rehma hadi kuchwa kwa jua, na malaika watamuombea rehma.))"
"1188","[AI-translation] ((Jina Kubwa la Allah, ambalo akiombwa nalo dua inakubaliwa, liko katika aya hii ya Sura Aal-e-Imran: ((Sema: Ee Allah, Mmiliki wa ufalme, huumpa ufalme umtakaye... n.k.)).))"
"1189","[AI-translation] ((Yule anayepanda mnyama mgumu na kusoma aya hii [kutoka Sura Al-Imran] sikioni mwake, itasimama kwa amri ya Allah. ((Je, wanatafuta dini nyingine isipokuwa dini ya Allah ilhali kwake wamesilimu waliomo mbinguni na ardhini kwa hiari na kwa lazima na kwake watarejeshwa)).))"
"1190","[AI-translation] ((Allah Mtukufu hatamnyima mja anayesimama kwa swala usiku na kuanza na Sura Al-Baqarah na Sura Aal-e-Imran. Sura Al-Baqarah na Sura Aal-e-Imran ni hazina bora ya mtu.))"
"1191","[AI-translation] ((Someni Sura Hud siku za Ijumaa.))"
"1192","[AI-translation] ((Sura Hud na sura nyingine kama hiyo [ambazo zina maelezo ya Siku ya Kiama], kama al-Waqi'ah, al-Qari'ah, al-Haqqah, Idhash-Shamsu Kuwwirat, na Sa'ala Sa'il na nyingine, zimenifanya mzee.))"
"1193","[AI-translation] ((Jina la Sura Kahf katika Taurati ni 'Ha'ilah' kwa sababu Sura hii huwa kizuizi na kizuizi baina ya msomaji wake na moto wa Jahannamu.))"
"1194","[AI-translation] ((Yule anayesoma aya tatu za mwanzo za Sura Al-Kahf atalindwa kutokana na fitna ya Dajjal.))"
"1195","[AI-translation] ((Je, nisiwaambie sura ambayo ukuu wake huujaza nafasi baina ya mbinguni na ardhi, na kwa yule anayeisoma, kuna ujira sawa, na yule anayeisoma dhambi zake zitaghfiriwa hadi Ijumaa ijayo na kwa siku tatu zaidi? Masahaba (Allah awaridhie) wakasema: Hakika, tuambie. Basi [Swalla Allahu 'alayhi wa sallam] akasema: Sura Al-Kahf.))"
"1196","[AI-translation] ((Allah Mtukufu alisoma Sura Ta-Ha na Sura Ya-Sin miaka elfu kabla ya kuumbwa mbinguni na ardhi. Malaika waliposikia Qur'an, wakasema: Bishara njema kwa taifa ambalo Qur'an hii itateremshwa kwao.))"
"1197","[AI-translation] ((Yule anayesoma Sura Yaseen kwa radhi ya Allah, Allah Mtukufu atamghfiria dhambi zake zilizotangulia.))"
"1198","[AI-translation] ((Yule anayeanza siku kwa kuisoma Sura Yaseen, haja zake hutimizwa.))"
"1199","[AI-translation] ((Yule anayesoma Sura Ad-Dukhan usiku wa Ijumaa ataghfiriwa.))"
"1200","[AI-translation] ((Yule anayesoma Sura Ad-Dukhan usiku, malaika elfu sabini huanza kumwombea maghfira.))"
"1201","[AI-translation] ((Yule anayesoma Sura Dukhan kamili, aya za mwanzo za Ha Meem Ghafir hadi ((na kwake ni marejeo)), na Ayat al-Kursi jioni, atalindwa kupitia hizo hadi asubuhi; na yule anayezisoma asubuhi atalindwa hadi jioni.))"
"1202","[AI-translation] ((Yule anayesema hivi mara tatu asubuhi: ((Najikinga kwa Allah Mwenye Kusikia, Mwenye Kujua kutokana na Shetani aliyelaaniwa)) na kusoma aya tatu za mwisho za Sura Al-Hashr, Allah Mtukufu atamwekea malaika elfu sabini watakaomuombea rehma hadi jioni, na akifa siku hiyo, atakufa kifo cha shahidi. Na yule anayesema maneno haya jioni pia atapata cheo hiki.))"
"1203","[AI-translation] ((Yule aliyesoma aya za mwisho za Sura Al-Hashr usiku au mchana, kisha akafa usiku ule ule au mchana, Pepo huwa wajibu kwake.))"
"1204","[AI-translation] ((Jina Kubwa la Allah Mtukufu liko katika aya sita za mwisho za Sura Al-Hashr.))"
"1205","[AI-translation] ((Mnapolala kitandani mwenu, someni Sura Hashr. [Kisha] mkifa, mtakufa kifo cha shahidi.))"
"1206","[AI-translation] ((Wafundisheni Sura Al-Waqi'a wanawake wenu; hakika ni Sura ya utajiri na ustawi.))"
"1207","[AI-translation] ((Yule anayesoma Sura Waqi'a na kuijifunza hataandikwa miongoni mwa wenye kughafilika, na kaya yake haitakuwa na haja.))"
"1208","[AI-translation] ((Yule anayesoma Sura Al-Waqi'a kila usiku kamwe hatapata umasikini.))"
"1209","[AI-translation] ((Sura ((Idha zulzilat)) ni sawa na nusu ya Qur'an.))"
"1210","[AI-translation] ((Yule anayesoma Sura ((Alam nashrah)) na Sura ((Alam tara kayf)) katika swala ya Alfajiri hataangamizwa.))"
"1211","[AI-translation] ((Kusoma Sura ((Inna anzalnahu)) baada ya udhu.))"
"1212","[AI-translation] ((Yule anayesoma Sura ((Inna anzalnahu fi laylatil-qadr)) mara moja baada ya udhu atakuwa miongoni mwa wakweli. Yule anayeisoma mara mbili ataandikwa miongoni mwa mashahidi, na yule anayeisoma mara tatu, Allah Mtukufu atamfufua na manabii.))"
"1213","[AI-translation] ((Yule anayesoma Sura Ikhlas wakati wa ugonjwa wake wa kufa hatajaribiwa kaburini.))"
"1214","[AI-translation] ((Yule anayesoma Sura Ikhlas mara ishirini, Allah Mtukufu atamjengea jumba Peponi.))"
"1215","[AI-translation] ((Yule anayesoma Sura Ikhlas mara mia mbili, Allah Mtukufu atamghfiria dhambi za miaka mia mbili.))"
"1216","[AI-translation] ((Yule anayesoma Sura Ikhlas mara mia mbili mchana, Allah Mtukufu humwandikia mema elfu moja na mia tano, isipokuwa ana deni.))"
"1217","[AI-translation] ((Yule anayepita makaburini na kusoma Sura Ikhlas mara kumi na moja, kisha akawazawadia thawabu maiti, atapewa ujira sawa na idadi ya maiti.))"
"1218","[AI-translation] ((Yule anayesoma Sura Al-Ikhlas, Sura Al-Falaq, na Sura An-Nas mara saba baada ya swala ya Ijumaa, Allah Mtukufu atamlinda kutokana na shari hadi Ijumaa ijayo.))"
"1219","[AI-translation] ((Siku ya Kiama, kila uhusiano na ukoo utakatwa isipokuwa uhusiano wangu na ukoo wangu.))"
"1220","[AI-translation] ((Jibril (amani iwe juu yake) alishuka kwangu na akasema kwamba Allah Mtukufu anakutumia salamu za amani na anasema: Nimeifanya Moto kuwa haramu kwa kiuno [Abdullah] ambacho ulitoka kwacho, tumbo [Amina] lililokubeba, na kifua [Abdul Muttalib] kilichokulea.))"
"1221","[AI-translation] ((Jibril (amani iwe juu yake) alishuka kwangu na akasema: Ee Muhammad! Allah Mtukufu anakutumia salamu za amani na anasema: Ee Mpenzi wangu! Nimempamba Yusuf (amani iwe juu yake) kwa uzuri kutoka nuru ya kiti cha Arshi yangu, na nimeupamba uso wako kwa uzuri kutoka nuru ya Arshi yangu.))"
"1222","[AI-translation] ((Jibril (amani iwe juu yake) alikuja kwa Mtume (Swalla Allahu 'alayhi wa sallam) na kichane cha zabibu na akasema: Allah Mtukufu anakutumia salamu za amani na amenituma na kichane hiki ili ule.))"
"1223","[AI-translation] ((Uombezi wangu umekubaliwa kwa watu hawa: baba yangu, ami yangu Abu Talib, na ndugu yangu wa kunyonyesha Ibn Sa'diyyah.))"
"1224","[AI-translation] ((Allah Mtukufu alimpa Musa (amani iwe juu yake) zawadi ya mazungumzo, lakini alinipa maono [yaani maono yake], na akanipendelea kwa Maqam-e-Mahmood na Hawd-e-Mawrood.))"
"1225","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alimpa mtu jasho kutoka mikono yake, naye akaliweka chupani hadi likajaa. Kisha alilitumia kama manukato, na watu wa Madina walinusa harufu nzuri kutoka kwalo.))"
"1226","[AI-translation] ((Aya hii ((Pindi msaada wa Allah na ushindi utakapokuja)) ilipoteremshwa, Muhammad (Swalla Allahu 'alayhi wa sallam) alisema: Ee Jibril! Khabari za kifo cha nafsi yangu zimepewa kwangu.))"
"1227","[AI-translation] (([Ee Mtume!] Yule anayekusomea salawat mara mia moja mchana na usiku, nitamteremshia rehma mara elfu mbili, na haja zake elfu moja zitatimizwa.))"
"1228","[AI-translation] ((Yule anayenisomea salawat kaburini mwangu, humsikia.))"
"1229","[AI-translation] ((Mimi ni Nabii wa kwanza kwa umbo na wa mwisho kwa kutumwa.))"
"1230","[AI-translation] ((Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) hakufariki hadi alipojifunza kusoma na kuandika.))"
"1231","[AI-translation] ((Jina langu katika Qur'an ni Muhammad, katika Injili ni Ahmad, na katika Taurati ni Ahid.))"
"1232","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikataza utupaji miezi miwili kabla ya kufa kwake.))"
"1233","[AI-translation] ((Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) alijitenga kwa ibada miezi miwili kabla ya kufa kwake na pia alijitenga na wanawake.))"
"1234","[AI-translation] ((Utambuzi ni mali yangu halisi, akili ni msingi wa dini yangu, na ukoo ni msingi wangu.))"
"1235","[AI-translation] ((Kidole cha shahada cha Mtume [Swalla Allahu 'alayhi wa sallam] [yaani kidole cha kuashiria] kilikuwa kirefu kuliko kidole cha kati.))"
"1236","[AI-translation] ((Nilizaliwa wakati wa utawala wa mfalme mwadilifu [yaani Anushirwan].))"
"1237","[AI-translation] ((Msinifanye kama kikombe cha mpandafarasi [yaani msichelewe kunitaja, kwa sababu mpandafarasi hutundika kikombe chake nyuma ya kipando chake. Al-Nihayah].))"
"1238","[AI-translation] ((Mkimtaja mtoto Muhammad, basi mheshimu na kumstahi [msimdhalilisha].))"
"1239","[AI-translation] ((Familia ya Muhammad ni mti wa Utume, familia ya rehma, na kituo cha Utume.))"
"1240","[AI-translation] ((Yule aliyeficha uadui dhidi yetu, Ahl al-Bayt, Allah Mtukufu atamfufua kama Myahudi, hata kama alikuwa na utaratibu katika swala na saumu.))"
"1241","[AI-translation] ((Kundi letu la watu litaamka makaburini mwao Siku ya Kiama, licha ya dhambi na makosa yao, na nyuso zinazong'aa kama mwezi mkamilifu.))"
"1242","[AI-translation] ((Ghadhabu ya Allah ni kali kwa yule aliyemwaga damu yangu na akawasababishia madhara familia yangu.))"
"1243","[AI-translation] ((Allah Mtukufu ameumba watoto wa kila nabii kutoka viuno vyake mwenyewe, lakini watoto wangu amewaumba kutoka viuno vya Ali.))"
"1244","[AI-translation] ((Lau Ibrahim angeishi, angelikuwa nabii.))"
"1245","[AI-translation] ((Allah Mtukufu anakuambia kwamba umwoe binti wa Abu Bakr [Aisha (Allah amridhie)].))"
"1246","[AI-translation] (([Aisha (Allah amridhie) anasimulia kwamba] Nilizaa mtoto asiyekamilika kutoka kwa Mtume Muhammad (Swalla Allahu 'alayhi wa sallam), basi alimwita Abdullah na akanipa kunya Umm Abdullah.))"
"1247","[AI-translation] ((Ee Aisha! Wewe ni bora zaidi kuliko maziwa.))"
"1248","[AI-translation] (([Aisha (Allah amridhie) alimuuliza Mtume wa Allah, Swalla Allahu 'alayhi wa sallam] Mapenzi yako kwangu yako vipi? Mtume, Swalla Allahu 'alayhi wa sallam, akajibu: Kama fundo la kamba.))"
"1249","[AI-translation] ((Jifunzeni nusu ya dini yenu kutoka kwa Humaira [yaani Aisha (Allah amridhie)].))"
"1250","[AI-translation] ((Ee Ali! Allah Mtukufu ameniamrisha kumfanya Abu Bakr kuwa baba, Umar kuwa mshauri, Uthman kuwa tegemeo, nawe, ee Ali, kuwa msaidizi.))"
"1251","[AI-translation] ((Siku ya Kiama, mpigaji atatangaza chini ya Arshi: Wako wapi masahaba wa Muhammad? Kisha Abu Bakr, Umar, Uthman, na Ali (Allah awaridhie) wataletwa.))"
"1252","[AI-translation] ((Abu Bakr ni waziri wangu na, baada yangu, mlezi wa umma wangu; Umar ni mpenzi wangu, anayezungumza kwa niaba yangu; Uthman anatoka kwangu; na Ali ni ndugu yangu na mbebaji wa bendera yangu.))"
"1253","[AI-translation] ((Siku ya Kiama, Allah Mtukufu atajidhihirisha kwa viumbe vyote kwa ujumla, na [ee Abu Bakr!] atajidhihirisha kwako kwa khususi.))"
"1254","[AI-translation] ((Ee Abu Bakr! Furahi, kwani yule aliyekutawadhisha kwa swala alikuwa Jibril (amani iwe juu yake).))"
"1255","[AI-translation] ((Allah Mtukufu alipoumba roho, alichagua roho ya Abu Bakr (Allah amridhie) miongoni mwa roho nyingine, na udongo wake ulichukuliwa Peponi.))"
"1256","[AI-translation] ((Allah Mtukufu amemjengea Abu Bakr (Allah amridhie) banda la yakuti nyeupe katika sehemu ya juu ya Illiyin.))"
"1257","[AI-translation] ((Abu Bakr (Allah amridhie) alipozaliwa, Allah Mtukufu alikaribia Pepo ya Aden na akasema: Kwa utukufu na ukuu wangu, nitamwingiza humo yule tu anayempenda mtoto huyu.))"
"1258","[AI-translation] ((Allah Mtukufu amemfanya Abu Bakr (Allah amridhie) kuwa khalifa wangu juu ya dini na wahyi, basi mnapaswa kumtii.))"
"1259","[AI-translation] ((Jibril (amani iwe juu yake) alimwambia Mtume (Swalla Allahu 'alayhi wa sallam) kuhusu Abu Bakr (Allah amridhie): Umaarufu wake duniani ni mdogo kuliko ulivyo mbinguni.))"
"1260","[AI-translation] ((Nani anaweza kuwa kama Abu Bakr (Allah amridhie), kwani watu waliponikataa, alinithibitisha na akaniamini.))"
"1261","[AI-translation] ((Siku ya Kiama, kiti kitawekwa kwa Abu Bakr (Allah amridhie) naye atakaa juu yake.))"
"1262","[AI-translation] ((Nilipandishwa mbinguni, na kila nilipopita mbinguni, nilikuta jina langu, Muhammad, Mtume wa Allah, na nyuma yake jina la Abu Bakr al-Siddiq limeandikwa.))"
"1263","[AI-translation] ((Si halali kwa watu wowote kwamba ilhali Abu Bakr yupo miongoni mwao, mtu mwingine awaongoze katika swala.))"
"1264","[AI-translation] ((Lau imani ya Abu Bakr (Allah amridhie) ingepimwa dhidi ya imani ya watu wote wa ardhi, imani yake ingezilemea zao.))"
"1265","[AI-translation] ((Chochote Allah Mtukufu alichokiweka kifuani mwangu, pia amekiweka vile vile kifuani mwa Abu Bakr.))"
"1266","[AI-translation] ((Umar (Allah amridhie) alisema kwamba Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akizungumza na Abu Bakr (Allah amridhie) nami ningekuwa kama Mwethiopia baina yao.))"
"1267","[AI-translation] ((Allah Mtukufu huchukia mbinguni kwamba Abu Bakr Siddiq afanye kosa lolote.))"
"1268","[AI-translation] ((Lau nisingetumwa miongoni mwenu, Umar angetumwa.))"
"1269","[AI-translation] ((Nilipochukuliwa katika safari ya usiku, niliona mbinguni [farasi mzuri mwenye mabawa na kichwa cha yakuti nyekundu]... Nilimuuliza Jibril (amani iwe juu yake): Ni wa nani hii? Akajibu: Kwa wale wanaowapenda Abu Bakr na Umar (Allah awaridhie).))"
"1270","[AI-translation] ((Mtu wa kwanza katika Umma huu kupewa kitabu cha matendo mkono wake wa kuume atakuwa Umar (Allah amridhie).))"
"1271","[AI-translation] ((Ee Abul-Hasan! [yaani Ali (Allah amridhie)] Wapendeni wote wawili [yaani Abu Bakr na Umar (Allah awaridhie)]. Kwa sababu ya mapenzi yako kwa wote wawili, utaingia Peponi.))"
"1272","[AI-translation] ((Kuna malaika elfu themanini katika mbingu ya dunia hii wanaowaombea maghfira wale wanaowapenda Abu Bakr na Umar (Allah awaridhie).))"
"1273","[AI-translation] ((Yule anayemtusi Umar (Allah amridhie), makao yake ni Jahannamu.))"
"1274","[AI-translation] ((Yule anayewatusi Abu Bakr na Umar (Allah awaridhie) auawe, wala toba isitafutwe kwake.))"
"1275","[AI-translation] ((Usiku wa Mi'raj, niliona tawi la kijani katika Arshi ambalo juu yake imeandikwa kwa nuru nyeupe: Hapana mungu isipokuwa Allah, Muhammad ni Mtume wa Allah, Abu Bakr ni Mkweli, na Umar ni Mbaguzi.))"
"1276","[AI-translation] (([Usiku wa Mi'raj, Mtume ﷺ alimuuliza hur:] Ni wa nani wewe? Akajibu: Kwa Uthman ibn Affan, ambaye atapata ushuhuda.))"
"1277","[AI-translation] (([Mtume ﷺ hakumuongoza swala ya jeneza mtu, basi Masahaba walipouliza sababu, alielezea:] Mtu huyu alikuwa akimchukia Uthman (Allah amridhie), basi Allah pia humchukia.))"
"1278","[AI-translation] ((Uthman (Allah amridhie) anapohamia kutoka sehemu moja hadi nyingine, Pepo humng'aria.))"
"1279","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alisimama, akamshika Uthman (Allah amridhie) imara, kisha akasema: Wewe ni rafiki yangu duniani na Akhera.))"
"1280","[AI-translation] ((Kila nabii ana rafiki wa karibu [khalil] katika umma wake, na rafiki yangu wa karibu ni Uthman (Allah amridhie).))"
"1281","[AI-translation] ((Juu ya kila jani la miti ya Pepo, [pamoja na jina langu] imeandikwa 'Uthman Dhu al-Nurayn.' ))"
"1282","[AI-translation] ((Mimi, Harun bin Imran, Yahya bin Zakariya, na Ali bin Abi Talib sote tuliumbwa kutokana na udongo mmoja.))"
"1283","[AI-translation] ((Mimi na Ali tuliumbwa kutokana na nuru moja.))"
"1284","[AI-translation] ((Ali (Allah amridhie) alisema: Mimi ni mja wa Allah, ndugu wa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam), na mkweli mkubwa zaidi [Siddiq Akbar].))"
"1285","[AI-translation] (([Ee Ali!] Wewe ni mtu wa kwanza aliyeniamini, nawe utakuwa mtu wa kwanza kupeana mikono nami Siku ya Kiama, nawe hakika ni Siddiq Akbar na Farooq.))"
"1286","[AI-translation] ((Wakimtia [yaani Ali (Allah amridhie)], basi wote wataingia Peponi.))"
"1287","[AI-translation] ((Ndugu yangu, waziri wangu, khalifa wangu miongoni mwa familia yangu, na bora ninayemwacha baada yangu kwa kulipa madeni yangu na kutimiza ahadi zangu ni Ali.))"
"1288","[AI-translation] ((Wa kwanza miongoni mwenu kuja kwangu Hodhini na wa kwanza miongoni mwenu kukubali Uislamu ni Ali ibn Abi Talib.))"
"1289","[AI-translation] ((Yule asiyemwona Ali kuwa bora miongoni mwa watu hakika amefanya ukafiri.))"
"1290","[AI-translation] ((Ali ni bora miongoni mwa viumbe.))"
"1291","[AI-translation] ((Mimi ni nyumba ya hekima na Ali ni mlango wake.))"
"1292","[AI-translation] ((Wahyi ulikuwa ukiteremshwa kwa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) na kichwa chake [Swalla Allahu 'alayhi wa sallam] kilikuwa mapajani mwa Ali (Allah amridhie). Yeye [Ali] hakuwa ameswali swala ya Alasiri hadi jua lilipochwa. Mtume (Swalla Allahu 'alayhi wa sallam) alimuuliza: Umeswali? Akajibu kwa kukataa. Baada ya hili, Mtume (Swalla Allahu 'alayhi wa sallam) alimuomba Allah, basi jua lilifanywa kuinuka tena kwa Ali (Allah amridhie) baada ya kuchwa.))"
"1293","[AI-translation] (([Ee Ali!] Nafasi yako kwangu ni kama ile ya Harun kwa Musa.))"
"1294","[AI-translation] ((Hata kumtazama Ali ni tendo la ibada.))"
"1295","[AI-translation] ((Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) aliamrisha kwamba milango yote inayofungukia msikitini ifungwe, isipokuwa mlango wa Ali (Allah amridhie).))"
"1296","[AI-translation] ((Ee Ali! Si halali kwa yeyote kuwa msikitini humu katika hali ya najisi isipokuwa mimi nawe.))"
"1297","[AI-translation] ((Mapenzi ya Ali huteketeza dhambi kama moto unavyoteketeza kuni.))"
"1298","[AI-translation] ((Yule anayetaka kuona ilmu ya Adam, ufahamu wa Nuhu, uvumilivu wa Ibrahim, kujiepusha na dunia kwa Yahya mwana wa Zakariya, na uthabiti wa Musa mwana wa Imran (amani iwe juu yao), amtazame Ali ibn Abi Talib.))"
"1299","[AI-translation] ((Jina langu katika Qur'an ni ((Na kwa Jua na mwangaza wake)) na jina la Ali ni ((Na kwa Mwezi unapoifuata)).))"
"1300","[AI-translation] ((Bora ninayemweka khalifa wangu baada yangu ni Ali.))"
"1301","[AI-translation] ((Ali (Allah amridhie) alisema: Watu wamempa bai'a Abu Bakr (Allah amridhie), ingawa, naapa kwa Allah, nilikuwa na haki zaidi kuliko wao.))"
"1302","[AI-translation] ((Mtu wa kwanza kuingia kupitia mlango huu atakuwa Kiongozi wa Waumini na Mkuu wa Mitume. [Anas (Allah amridhie) anasimulia kwamba] ghafla Ali (Allah amridhie) alikuja kupitia humo.))"
"1303","[AI-translation] ((Yule anayekufa na moyoni mwake kuna chuki kwa Ali bin Abi Talib (Allah amridhie), basi afe kama Myahudi au Mkristo.))"
"1304","[AI-translation] ((Allah Mtukufu huizuia mvua kwa Umma huu kwa sababu ya chuki dhidi ya Ali (Allah amridhie).))"
"1305","[AI-translation] ((Yule anayetaka kushika tawi lile ambalo Allah Mtukufu amelipanda kwa mkono wake mwenyewe, ashike imara mapenzi ya Ali.))"
"1306","[AI-translation] (([Ee Mtume wa Allah!] Nani atabeba bendera yako Siku ya Hukumu? Akasema: Ali.))"
"1307","[AI-translation] ((Ee Allah! Mpe Ali ubora kama ambao hujampa yeyote kabla yake wala hutampa yeyote baada yake.))"
"1308","[AI-translation] ((Aya mia tatu ziliteremshwa kuhusu Ali (Allah amridhie).))"
"1309","[AI-translation] ((Ee Ali! Allah Mtukufu amekughfiria wewe, watoto wako, wazazi wako, familia yako, Shia wako [kundi lako], na wale wanaowapenda Shia wako.))"
"1310","[AI-translation] ((Yule anayenipenda anapaswa kumpenda Ali, na yule mwenye uadui dhidi ya Ali ameficha uadui dhidi yangu.))"
"1311","[AI-translation] ((Hakika hatakufa isipokuwa atauawa shahidi; inamhusu Ali (Allah amridhie).))"
"1312","[AI-translation] ((Ali (Allah amridhie) alisema: Nilimwosha Mtume (Swalla Allahu 'alayhi wa sallam) ghuslu, na nikanywa maji yaliyotiririka kutoka mashimo ya macho yake, basi nilifanywa mrithi wa ilmu za wa kwanza na wa mwisho.))"
"1313","[AI-translation] ((Siku ya Kiama, Allah Mtukufu ataniambia mimi na Ali: Waingizeni Peponi wale waliowapenda nyote wawili, na waingizeni Motoni wale waliowachukia nyote wawili.))"
"1314","[AI-translation] ((Ee Ali! Wewe na Shia wako [kundi lako] mtakuwa Peponi.))"
"1315","[AI-translation] ((Mfano wangu ni kama ule wa mti: mimi ni mzizi wake [asili], na Ali ni tawi lake [shina, n.k.].))"
"1316","[AI-translation] ((Allah Mtukufu alimwamrisha Mtume (Swalla Allahu 'alayhi wa sallam) kula tende mbichi za Pepo kutoka sahani ambayo Jibril (amani iwe juu yake) alimletea, kisha afanye tendo na Khadijah (Allah amridhie). [Basi alifanya hivyo], na hivyo Khadijah (Allah amridhie) alibeba mimba ya Fatimah (Allah amridhie).))"
"1317","[AI-translation] ((Nilipochukuliwa katika safari ya mbinguni, Jibril (amani iwe juu yake) aliningiza Peponi na akanipa tufaha. Nilila, nalo likawa mbegu mgongoni mwangu. Niliposhuka, nilifanya tendo na Khadijah, na Fatimah anatoka mbegu hiyo.))"
"1318","[AI-translation] ((Mimi, Fatimah, na Ali tutakuwa Peponi katika hema jeupe ambalo dari yake itakuwa Arshi ya Mwingi wa Rehma.))"
"1319","[AI-translation] ((Nimeamrishwa na Allah Mtukufu kumwozesha Fatimah kwa Ali, basi nimefanya hivyo.))"
"1320","[AI-translation] ((Ee Ali! Allah Mtukufu amekuozesha Fatimah na ameweka mahari yake kuwa ardhi, kwa hiyo yule anayetembea juu yake hali anaficha chuki kwako, atatembea juu yake kwa haramu.))"
"1321","[AI-translation] ((Mtume Muhammad (Swalla Allahu 'alayhi wa sallam) alipomwozesha Fatimah kwa Ali, alitoa khutba kama ifuatavyo ((Sifa zote ni za Allah Mhimidiwa kwa neema zake, Muabudiwa kwa uwezo wake...)).))"
"1322","[AI-translation] ((Jibril (amani iwe juu yake) alitoa khutba mbinguni na kumwozesha Fatimah kwa Ali.))"
"1323","[AI-translation] ((Fatimah (Allah amridhie) alipopelekwa kwa Ali (Allah amridhie), Jibril (amani iwe juu yake) alikuwa upande wa kuume mbele ya Mtume (Swalla Allahu 'alayhi wa sallam), Mikael (amani iwe juu yake) alikuwa upande wa kushoto, na malaika elfu sabini walikuwa nyuma yao, wakimtukuza na kumtakasa Allah Mtukufu hadi mapambazuko.))"
"1324","[AI-translation] ((Binti yangu Fatimah ni hur wa kibinadamu; hajawahi kupata hedhi, na jina lake ni Fatimah [yule anayeokoa] kwa sababu Allah Mtukufu amemwacha huru yeye na wale wanaompenda kutokana na Jahannamu [yaani amewaweka huru].))"
"1325","[AI-translation] ((Fatimah (Allah amridhie) alilinda heshima yake, kwa hiyo Allah alifanya Moto wa Jahannamu kuwa haramu kwake na watoto wake.))"
"1326","[AI-translation] (([Binti yangu Fatimah atashika mguu wa Arshi na kusema: Ee Bwana Mwadilifu na Mwenye Haki! Hukumu baina yangu na muuaji wa mwanangu.] ))"
"1327","[AI-translation] ((Siku ya Kiama, mpigaji atatangaza nyuma ya pazia: Enyi watu wa mkusanyiko huu! Inamisheni macho yenu hadi Fatimah bint Muhammad (Swalla Allahu 'alayhi wa sallam) apite.))"
"1328","[AI-translation] ((Jibril (amani iwe juu yake) alikuja kwangu na akasema kwamba Allah Mtukufu humpenda Fatimah (Allah amridhie).))"
"1329","[AI-translation] ((Yule anayenipenda anapaswa kumpenda Ali, na yule anayempenda Ali anapaswa kumpenda Fatimah.))"
"1330","[AI-translation] (([Siku ya Kiama] Pepo itasema: Ee Bwana! Hukuniahidi kwamba ungenipamba kwa nguzo zako mbili? Kisha Allah Mtukufu atasema: Je, sikukupamba kwa Hasan na Husayn?))"
"1331","[AI-translation] ((Ee Jibril! Nimemtoa [mwanangu] Ibrahim kama fidia kwa Husayn.))"
"1332","[AI-translation] (([Ee Husayn!] Allah amlaani muuaji wako. Jabir (Allah amridhie) aliuliza: Nani atamuua? Mtume (Swalla Allahu 'alayhi wa sallam) akasema: Mtu kutoka umma wangu mwenyewe ambaye atawachukia watoto wangu; hatapokea uombezi wangu.))"
"1333","[AI-translation] ((Abbas bin Abdul Muttalib ni baba yangu, ami yangu, mtekelezaji wangu, na mrithi wangu.))"
"1334","[AI-translation] ((Ami yangu Abbas aliweka sehemu zake za siri safi wakati wa ujinga na katika Uislamu, kwa hiyo Allah Mtukufu amefanya mwili wake kuwa haramu kwa Moto.))"
"1335","[AI-translation] ((Nilimwona Abdur Rahman bin Awf (Allah amridhie) akiingia Peponi akibubujika kwa matako yake.))"
"1336","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alichukua kalamu kutoka mkono wa Ali na akaikabidhi kwa Muawiyah.))"
"1337","[AI-translation] ((Kundi kutoka Banu Hashim lilimuomba Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) amwondoe Muawiyah kuandika wahyi, basi wahyi uliteremshwa kuhusu uteuzi wake.))"
"1338","[AI-translation] ((Wa kwanza kubishana mbele ya Bwana kutoka Umma huu watakuwa Ali na Muawiyah (Allah awaridhie).))"
"1339","[AI-translation] (([Jibril (amani iwe juu yake) alimwambia Mtume, Swalla Allahu 'alayhi wa sallam, kwamba Allah Mtukufu anasema] Ee Mpenzi wangu! Nimetuma kalamu hii kama zawadi kwa Muawiyah kutoka juu ya Arshi yangu.))"
"1340","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alimshauri Jibril (amani iwe juu yake) kuhusu Muawiyah (Allah amridhie), basi akasema: Mwache aandike [wahyi], hakika ni mwaminifu.))"
"1341","[AI-translation] ((Kuna waaminifu watatu kwa Allah: mimi, Jibril (amani iwe juu yake), na Muawiyah (Allah amridhie).))"
"1342","[AI-translation] ((Mwiteni Muawiyah (Allah amridhie) kwangu... Hakika ni mwenye nguvu na mwaminifu.))"
"1343","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alimpa Muawiyah (Allah amridhie) mkuki na akasema: Shika hadi unikutane nami Peponi nao.))"
"1344","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alimpa Muawiyah (Allah amridhie) daftari tatu na akasema: Utanikutana nami Peponi nazo.))"
"1345","[AI-translation] ((Muawiyah (Allah amridhie) atafufuliwa Siku ya Kiama na kutakuwa na joho la nuru ya imani juu yake.))"
"1346","[AI-translation] ((Kila taifa lina Firauni, na Firauni wa taifa hili ni Muawiyah.))"
"1347","[AI-translation] ((Mnapomwona Muawiyah akitoa khutba kutoka mimbari yangu, basi muueni.))"
"1348","[AI-translation] ((Muawiyah bin Abi Sufyan (Allah amridhie) ni mpole na mkarimu zaidi miongoni mwa umma wangu.))"
"1349","[AI-translation] ((Hakika kwa umma wangu, joto la Jahannamu litakuwa kama joto la bafu.))"
"1350","[AI-translation] ((Pepo itabaki haramu kwa mataifa yote hadi mimi na umma wangu tuingie humo.))"
"1351","[AI-translation] ((Umma wangu ni umma uliobarikiwa; hakuna adhabu kwao Akhera [bali] hupewa adhabu tu duniani katika sura ya matetemeko na fitna [n.k.].))"
"1352","[AI-translation] ((Wapendeni Waarabu kwa sababu tatu: mimi ni Mwarabu, Qur'an ni Kiarabu, na lugha ya watu wa Pepo ni Kiarabu.))"
"1353","[AI-translation] ((Watu bora ni Waarabu, bora miongoni mwa Waarabu ni Quraysh, na bora miongoni mwa Quraysh ni Banu Hashim.))"
"1354","[AI-translation] ((Kuna majeshi ya Allah mbinguni na ardhini; majeshi ya mbinguni ya Allah ni malaika, ilhali majeshi ya ardhini ni watu wa Khurasan.))"
"1355","[AI-translation] ((Maneno mabaya zaidi mbele ya Allah ni Kiajemi.))"
"1356","[AI-translation] ((Allah Mtukufu anaporidhika, huteremsha kwa Kiarabu, na anapoghadhibika, huteremsha kwa Kiajemi.))"
"1357","[AI-translation] ((Yule miongoni mwenu awezaye kuzungumza Kiarabu kizuri asizungumze kamwe Kiajemi, kwa sababu Kiajemi huongoza kwenye unafiki.))"
"1358","[AI-translation] ((Ondoeni desturi za wasio Waarabu na huisheni desturi za Waarabu.))"
"1359","[AI-translation] ((Yule anayemwingiza Mwethiopia nyumbani mwake, Allah Mtukufu ataleta baraka nyumbani mwake.))"
"1360","[AI-translation] ((Mwethiopia akishiba huzini, na akiwa na njaa huiba.))"
"1361","[AI-translation] ((Jihadharini na Mayahudi na Wahindi, hata kwa matumbo sabini.))"
"1362","[AI-translation] ((Kuna baadhi ya malaika wa Allah wanaowahamisha maiti.))"
"1363","[AI-translation] ((Kuna malaika wa Allah ambaye umbali baina ya pembe za macho yake yote ni safari ya miaka mia tano.))"
"1364","[AI-translation] ((Kuna malaika wa Allah ambaye nusu yake ya juu ni ya barafu na nusu yake ya chini ni ya moto.))"
"1365","[AI-translation] ((Muadhini wa waliomo mbinguni ni Jibril (amani iwe juu yake), na imamu wao ni Mikael (amani iwe juu yake).))"
"1366","[AI-translation] ((Fungeni shuka la chini kwa namna niliyowaona malaika wakifunga mbele ya Bwana wao, hadi katikati ya miguu.))"
"1367","[AI-translation] ((Pakeni rangi ndevu zenu, kwani hakika malaika huridhika na rangi ya muumini.))"
"1368","[AI-translation] ((Mmoja wenu anapomwendea mkewe [kwa kujamiiana], ajifiche, kwani asipojificha, malaika huondoka kwa hayaa na Shetani huhudhuria. Kisha, mtoto akipangwa kwao, Shetani atakuwa na fungu humo.))"
"1369","[AI-translation] ((Allah Mtukufu anapompenda mja, huweka mapenzi yake nyoyoni mwa malaika pia.))"
"1370","[AI-translation] ((Mmoja wenu anapopiga chafya na kusema 'Alhamdulillah', malaika husema 'Bwana wa walimwengu'. Na akisema pia 'Bwana wa walimwengu', basi malaika husema 'Allah akurehemu'.))"
"1371","[AI-translation] ((Siku ya Ijumaa, mashetani huelekea masokoni asubuhi, wakitupa nyavu za udanganyifu na hila juu ya watu na kuwazuia kuhudhuria swala ya Ijumaa. Na malaika huja na kukaa milangoni mwa misikiti asubuhi [na kuandika majina ya wanaohudhuria swala ya Ijumaa].))"
"1372","[AI-translation] ((Mtu anapokufa, malaika husema: Ametanguliza nini? Na watu husema: Ameacha nini?))"
"1373","[AI-translation] ((Yule anayeomba dua kwa wingi, malaika husema: Sauti imetambuliwa, dua imekubaliwa, na haja imetimizwa.))"
"1374","[AI-translation] ((Chagueni imamu kwa uangalifu; anayekuongozeni katika swala anapaswa kuwa bora miongoni mwenu. Hakika Allah pia huchagua mitume miongoni mwa malaika na wanadamu.))"
"1375","[AI-translation] ((Aina bora ya ulinzi [yaani kukesha] ni kushikamana na swala na vikao vya dhikr, na yule ambaye, baada ya kuswali, hubaki amekaa sehemu ya swala, maadamu hajapoteza udhu wake au kusimama, malaika huendelea kumuombea rehma.))"
"1376","[AI-translation] ((Kaburi la ubavu lilitengenezwa kwa Adam (amani iwe juu yake), naye aliogeshwa kwa maji mara isiyo shufwa. Basi malaika wakasema: Hii ni Sunna kwa watoto wa Adam baada yake.))"
"1377","[AI-translation] ((Malaika walimwosha Adam (amani iwe juu yake) kwa maji na majani ya mkunazi, wakamsanda, wakamtengenezea kaburi la ubavu, na wakasema: Enyi watoto wa Adam! Hii ni desturi yenu kuhusu maiti zenu.))"
"1378","[AI-translation] ((Mtu anapokula mbele ya mfungaji, malaika humuombea rehma.))"
"1379","[AI-translation] ((Ee Bilal! Chakula kinapoliwa mbele ya mfungaji, mifupa yake hutamka tasbih na malaika humwombea maghfira.))"
"1380","[AI-translation] ((Allah Mtukufu hujivunia kwa malaika kuhusu kijana mcha Mungu na kusema: Mtazameni mja wangu; ameacha matamanio yake kwa ajili yangu.))"
"1381","[AI-translation] ((Malaika hupeana mikono na wapandao miongoni mwa mahujaji na huwakumbatia wanaotembea kwa miguu.))"
"1382","[AI-translation] ((Msimu wa baridi unapoondoka, malaika hufurahi, wakiwaonea huruma Waislamu masikini kwa sababu ya ukali wa joto la kiangazi.))"
"1383","[AI-translation] ((Maadamu mkeka wenu wa chakula unabaki umeandikwa, malaika huendelea kuwaombeeni rehma.))"
"1384","[AI-translation] ((Malaika hawashuki kwa watu ambao miongoni mwao kuna mtu anayekata uhusiano wa undugu.))"
"1385","[AI-translation] ((Siku ya Kiama, watu watafufuliwa katika sura ya makundi matatu [mojawapo ni] kundi ambalo malaika watakuwa wakiwaburuta nyuso zao.))"
"1386","[AI-translation] ((Tutakuja sokoni [Peponi] ambapo malaika watakuwa wamesimama safu; wala macho hayajawahi kuona soko kama hilo, wala masikio hayajawahi kusikia kuhusu hilo, wala nyoyo hazijawahi kulifikiria.))"
"1387","[AI-translation] ((Niliona malaika wakimwosha Hanzala bin Abi Amir baina ya mbingu na ardhi katika chombo cha fedha kwa maji ya mawingu.))"
"1388","[AI-translation] ((Niliona malaika wakimwosha Hamza.))"
"1389","[AI-translation] ((Yule anayekuwa mlezi wa mambo ya umma wangu baada yangu atasisimamishwa juu ya Daraja la Sirat Siku ya Hukumu, na malaika watafungua kitabu chake cha matendo. Akiwa mwadilifu, Allah Mtukufu atampa wokovu kwa sababu ya uadilifu wake.))"
"1390","[AI-translation] ((Zawadi ya malaika ni kuweka misikiti na harufu nzuri.))"
"1391","[AI-translation] ((Kwa sauti tatu Allah hujivunia kwa malaika: wito wa swala [adhana], takbira katika njia ya Allah, na usomaji wa talbiya kwa sauti.))"
"1392","[AI-translation] ((Mahur wameumbwa kutokana na tasbih ya malaika.))"
"1393","[AI-translation] ((Niliona kwamba wengi wa malaika nilowaona walikuwa wamevaa vilemba.))"
"1394","[AI-translation] ((Nilimuomba Bwana wangu aifanye swala ya Duha kuwa faradhi kwa umma wangu, lakini akajibu: Hii ni swala ya malaika; yule anayetaka aifanye, na yule anayetaka aiaache.))"
"1395","[AI-translation] ((Watajeni [watoto wenu] kwa majina ya Manabii, lakini msiwataje [kwa] majina ya malaika.))"
"1396","[AI-translation] ((Wakati wa Dajjal, chakula cha waumini kitakuwa sawa na chakula cha malaika, nacho ni tasbih [utukufu] na taqdees [utakaso].))"
"1397","[AI-translation] (([Allah Mtukufu anasema] Mja wangu anapofikia umri wa miaka sabini, malaika huanza kumpenda, na anapofikia umri wa miaka tisini, malaika husema: Huyu ni mfungwa wa Allah ardhini mwake. Kisha Allah Mtukufu humghfiria dhambi zake zote zilizotangulia na zijazo na pia hukubali uombezi wake kwa niaba ya wanafamilia yake.))"
"1398","[AI-translation] ((Siku ya Vita vya Badr, alama ya malaika ilikuwa vilemba vyeusi, ilhali siku ya Vita vya Uhud, ilikuwa vilemba vyekundu.))"
"1399","[AI-translation] ((Kuna sifa tatu za swala [mojawapo ni kwamba] malaika huizunguka kutoka miguuni mwake hadi mbinguni.))"
"1400","[AI-translation] ((Malaika huhudhuria nanyi katika michezo miwili tu: mashindano ya mbio za farasi na mashindano ya upinde.))"
"1401","[AI-translation] ((Kaya zile ambazo kundi la mbuzi hurudi jioni, malaika huendelea kuwaombea rehma hadi asubuhi.))"
"1402","[AI-translation] ((Yule anayeuza kitu chenye kasoro wala haifichui kasoro yake, hubaki chini ya ghadhabu ya Allah daima, na malaika humlaani daima.))"
"1403","[AI-translation] ((Yule anayemaliza usomaji wa Qur'an mwanzoni mwa siku, malaika humuombea rehma hadi jioni; na yule anayeimaliza mwishoni mwa siku, malaika humuombea rehma hadi asubuhi.))"
"1404","[AI-translation] ((Yule anayemwita mtu bila jina lake, malaika humlaani.))"
"1405","[AI-translation] ((Muumini ana heshima zaidi mbele ya Allah kuliko baadhi ya malaika.))"
"1406","[AI-translation] ((Katika nyumba ambayo kuna kengele, malaika hawaingii.))"
"1407","[AI-translation] ((Yule anayetoka asubuhi kutafuta ilmu, malaika humuombea rehma na baraka huwekwa katika riziki yake.))"
"1408","[AI-translation] ((Ee Abu Hurairah! Wafundishe watu Qur'an na ujifunze mwenyewe pia. Kisha ukifa hali uko katika hali hii, malaika watatembelea kaburi lako kama Nyumba ya Kale [Kaaba] inavyotembelewa.))"
"1409","[AI-translation] ((Yule anayemfuturisha mfungaji katika Ramadhani kwa mapato halali, malaika humuombea rehma usiku zote za Ramadhani.))"
"1410","[AI-translation] ((Shikamaneni na matumizi ya mswaki; mswaki ni kitu bora... Malaika humsifu yule anayetumia mswaki. [Kwa kutumia mswaki] Bwana huridhika na Shetani hughadhibika.))"
"1411","[AI-translation] ((Malaika hawaombeani rehma mwanamke anayeomboleza.))"
"1412","[AI-translation] ((Asubuhi ya Idi al-Fitr, malaika husimama kando za barabara na kuita: Enyi watu! Tokeni kwa thawabu na malipo. Bwana wenu alikuwa amekuamrisheni kufunga, nanyi mmefunga; sasa pokeeni thawabu yake. Kisha, watu wanaposwali swala ya Idi, mpigaji hutangaza mbinguni: Rudini nyumbani mwenu kama walioongozwa; nimewaghfiria. Mbinguni, siku hii huitwa Siku ya Malipo.))"
"1413","[AI-translation] ((Hakuna mtoto wa Hawa (amani iwe juu yake) angeokoka. Alipobeba mimba, Ibilisi alimzunguka na akasema: Mwite Abdul Harith. Wakamwita Abdul Harith, naye akaokoka.))"
"1414","[AI-translation] ((Jihadharini na kiburi, kwani ni kiburi kilichomchochea Ibilisi kukataa kumsujudia Adam (amani iwe juu yake).))"
"1415","[AI-translation] ((Adui wa Allah, Ibilisi, alipojua kwamba Allah Mtukufu amekubali dua yangu na akawaghfiria umma wangu, alianza kutupa udongo kichwani mwake.))"
"1416","[AI-translation] ((Kitu kigumu zaidi kwa Ibilisi ni mwanachuoni wa kidini anayetoka miongoni mwa watu.))"
"1417","[AI-translation] ((Kitunguu saumu, kitunguu, na leek [mboga yenye harufu mbaya] ni harufu ya Shetani.))"
"1418","[AI-translation] ((Mmoja wenu anapotoka msikitini, jeshi la Ibilisi huelekea kwake na kukusanyika kumzunguka kama nyuki. Kwa hiyo, mtu anapokaribia kutoka msikitini, hakika ajikinge na Ibilisi na majeshi yake.))"
"1419","[AI-translation] ((Someni Kalima La ilaha illallah na ombeni maghfira kwa wingi, kwa sababu Ibilisi anasema: Niliwaangamiza watu kwa dhambi, na watu waliniangamiza kwa Kalima La ilaha illallah na kuomba maghfira.))"
"1420","[AI-translation] ((Yule anayesimamia mali yake vizuri, Shetani humtumia mwenzi wake mwenye nguvu na uwezo zaidi.))"
"1421","[AI-translation] ((Mashairi ni chombo cha Ibilisi.))"
"1422","[AI-translation] ((Jihadharini na dunia na jihadharini na wanawake. Hakika Shetani ni mwangalifu sana na anavizia, na miongoni mwa wachamungu, hakuna mtego wenye nguvu zaidi kwa mawindo yake kuliko wanawake.))"
"1423","[AI-translation] Ibilisi alimwambia Allah Mtukufu: Ee Bwana wangu! Adam ameteremshwa [duniani], nanajua kwamba hivi karibuni atapewa vitabu na mitume, basi vitabu vyake na mitume wake ni vipi? Allah Mtukufu akasema: Mitume wake ni malaika na manabii walioteuliwa miongoni mwao, na vitabu vyake ni Taurati, Injili, Zaburi, na Furqan. Akasema: Na kitabu changu ni kipi? Allah Mtukufu akasema: Kitabu chako ni majani ya matawi, Qur'an yako ni mashairi, mitume yako ni waaguzi, chakula chako ni kile ambacho jina la Allah halikutajwa juu yake, kila kileo ni kinywaji chako, ukweli wako ni uongo, nyumba yako ni mabafu, sehemu zako za kuvizia ni wanawake, waadhini wako ni ala za muziki, na msikiti wako ni soko."
"1424","[AI-translation] ((Wa kwanza kuvishwa mavazi ya Jahannamu atakuwa Ibilisi.))"
"1425","[AI-translation] ((Ibilisi alikuwa wa kwanza kuomboleza naye alikuwa wa kwanza kuimba.))"
"1433","[AI-translation] ((Mnapotawadha, msitikise mikono yenu kwa sababu [matone haya] ni mapepe ya Shetani.))"
"1434","[AI-translation] ((Wanawake ni mtego wa Shetani.))"
"1435","[AI-translation] ((Safu inayomzuia zaidi Shetani ni safu ya kwanza.))"
"1436","[AI-translation] ((Uchafu na uasherati ni kutoka kwa Shetani; matendo haya mawili humkaribisha mtu Jahannamu na kumwondoa Peponi.))"
"1437","[AI-translation] ((Shetani ni mnyanyapaa sana na mpenzi sana wa kulamba, basi jilindeni na mashambulizi yake kwa nafsi zenu. Yule anayelala usiku na kuna harufu ya mafuta mkononi mwake, kisha kitu kikamdhuru, basi ajilaumu nafsi yake tu.))"
"1438","[AI-translation] ((Shetani ni mbwa-mwitu kwa wanadamu kama mbwa-mwitu alivyo kwa mbuzi; humkamata mbuzi anayejitenga na kundi. Basi jihadharini na kujitenga, na shikamaneni na jamaa, sehemu za umma, na msikiti.))"
"1439","[AI-translation] ((Shetani huwasumbua mtu mmoja na watu wawili, lakini wanapokuwa watu watatu, hawezi kuwasumbua.))"
"1440","[AI-translation] ((Tangu Umar (Allah amridhie) aliposilimu, kila Shetani alipokutana naye, alianguka kifudifudi.))"
"1441","[AI-translation] ((Shetani huweka hatamu yake juu ya moyo wa mwana wa Adam; akimkumbuka Allah, Shetani hujiondoa, lakini akisahau, Shetani huumeza moyo wake.))"
"1442","[AI-translation] ((Shetani huipenda rangi nyekundu, basi epukeni nyekundu na kila vazi la umaarufu.))"
"1443","[AI-translation] ((Epukeni rangi nyekundu, kwani ni pambo linalopendwa zaidi na Shetani.))"
"1444","[AI-translation] ((Rangi nyekundu ni pambo la Shetani.))"
"1445","[AI-translation] ((Yule anayesogea juu na chini mbele ya Imamu, paji lake liko mkononi mwa Shetani.))"
"1446","[AI-translation] ((Kula kwa kidole kimoja ni njia ya kula ya Shetani, kula kwa vidole viwili ni njia ya kula ya waasi, na kula kwa vidole vitatu ni njia ya kula ya Manabii.))"
"1447","[AI-translation] ((Kulia ni kutokana na rehma, na kuomboleza na kulalamika ni kutoka kwa Shetani.))"
"1448","[AI-translation] ((Kupiga miayo kali na kupiga chafya kali ni kutoka kwa Shetani.))"
"1449","[AI-translation] ((Kucheka kwa sauti ni kutoka kwa Shetani na kutabasamu ni kutoka kwa Allah.))"
"1450","[AI-translation] ((Hakuna nabii aliyewahi kupata ndoto ya unajisi; hakika ndoto ya unajisi ni kutoka kwa Shetani.))"
"1451","[AI-translation] ((Kuchelewesha ni tabia ya Shetani ambayo hujaribu kuipanda nyoyoni mwa waumini.))"
"1452","[AI-translation] ((Swala huutia weusi uso wa Shetani.))"
"1453","[AI-translation] ((Daima weka kheri ulimi ni mwako; hakika kwa njia hii, utamshinda Shetani.))"
"1454","[AI-translation] ((Zungumzeni kidogo [la sivyo] Shetani anaweza kukuongozeni.))"
"1455","[AI-translation] ((Jicho baya ni kweli; huletwa na Shetani na husda ya mwana wa Adam.))"
"1456","[AI-translation] ((Mja hubaki daima katika wepesi kuhusu dini yake maadamu hanywi pombe, lakini anapokunywa pombe, Allah huvua pazia lake la hayaa, na Shetani huwa mlezi wa kusikia kwake, kuona kwake, na hatua zake. Humwongoza kuelekea kila uovu na humgeuza mbali na kila tendo jema.))"
"1457","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikataza kunywa maji yote kwa pumzi moja kama wanyama na akasema kwamba hii ni njia ya kunywa ya Shetani.))"
"1458","[AI-translation] ((Naapa kwa Allah! Shetani aliendelea kula naye hadi aliposoma Bismillah.))"
"1459","[AI-translation] ((Kila nyumba ambayo kuna jogoo mweupe, wala shetani wala mchawi haikaribii.))"
"1460","[AI-translation] ((Safisheni baina ya ndevu na kucha zenu, kwani hakika Shetani hukimbia baina ya nyama na kucha.))"
"1461","[AI-translation] (([Wakati (katika Vita vya Mu'tah) Ja'far (Allah amridhie) aliposhika bendera, Shetani alikuja kwake na akamchochea tamaa ya maisha ya dunia, akifanya kifo kionekane chukizo kwake. Akasema: Sasa unanichochea tamaa ya dunia ilhali imani imekuwa imara nyoyoni mwa waumini? Akisema hivi, aliendelea kushiriki katika vita hadi alipouawa shahidi.))"
"1462","[AI-translation] ((Baadhi ya mitego na mitego ya Shetani ni haya: kukataa neema za Allah, kiburi juu ya alichopewa na Allah, kiburi kwa waja wa Allah, na kufuata matamanio.))"
"1463","[AI-translation] ((Ubora wa mwanachuoni juu ya muabudu ni daraja sabini... na sababu ya hili ni kwamba Shetani anapozua bid'a kwa watu, mwanachuoni huitambua na huwazuia [watu] nayo [ilhali muabudu hubaki hajui].))"
"1464","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikataza kuacha takataka chumbani kwa sababu ni sehemu ambapo shetani hukaa.))"
"1465","[AI-translation] ((Kama mtu angependa kwamba Shetani asiwepo naye wakati wa kula na kulala mchana, aseme Salam anapoingia nyumbani na asome Bismillah anapokula.))"
"1466","[AI-translation] ((Mwana wa Adam anapolala, malaika [aliyeteuliwa] humwambia Shetani: Nionyeshe rekodi yako. Shetani humpa rekodi yake, kisha malaika hufuta matendo maovu kumi kutoka rekodi ya Shetani kwa kila tendo jema analokuta katika rekodi [ya mtu], na huandika matendo mema kumi badala yake. Kwa hiyo, mmoja wenu anapokaribia kulala, aseme 'Allahu Akbar' mara thelathini na tatu, 'Alhamdulillah' mara thelathini na nne, na 'Subhanallah' mara thelathini na tatu; dua hizi zitajumlisha mia moja.))"
"1467","[AI-translation] ((Tabia mbaya ni hatamu ya adhabu ya Allah puani mwa mtu mwenye tabia mbaya, na hatamu hii iko mkononi mwa Shetani, [kwa hiyo] Shetani humvuta kuelekea uovu na kutoka uovu kuelekea Jahannamu.))"
"1468","[AI-translation] ((Msinywe sehemu iliyovunjika ya chombo, kwa sababu Shetani hunywa humo.))"
"1469","[AI-translation] ((Buibui ni shetani; Allah ameiharibu sura yake, basi iueni.))"
"1470","[AI-translation] ((Msiite 'Qaws-e-Qazah' [umbo linaloonekana mawinguni kama upinde wa rangi tofauti], kwa sababu Qazah ni jina la Shetani; bali mnapaswa kuita 'upinde wa Allah.' ))"
"1471","[AI-translation] Sahaba alimtaja mwanawe Hubab. Mtume (Swalla Allahu 'alayhi wa sallam) alipojua, alisema: Usimwite Hubab, kwa sababu Hubab ni jina la Shetani."
"1472","[AI-translation] ((Hakika Shihab ni jina la Shetani.))"
"1473","[AI-translation] ((Nimepewa ubora juu ya Adam (amani iwe juu yake) kwa sifa mbili: [nazo ni kwamba] Shetani wangu alikuwa kafiri lakini Allah Mtukufu alini saidia dhidi yake hadi akasilimu, na wake zangu pia ni wasaidizi wangu, ilhali Shetani wa Adam (amani iwe juu yake) alibaki kafiri na mkewe alimsaidia katika kosa lake.))"
"1474","[AI-translation] ((Kila malaika mbinguni humheshimu Umar (Allah amridhie), na kila shetani duniani humwogopa Umar (Allah amridhie).))"
"1475","[AI-translation] ((Yatima anapokaa bakulini mwa watu, Shetani pia hukaribia bakuli lao.))"
"1476","[AI-translation] (([Kwa yule ambaye, licha ya kuwa na uwezo, hana mke au mjakazi, Mtume ﷺ alisema:] Wewe ni ndugu wa mashetani.))"
"1477","[AI-translation] ((Shetani huelekea masokoni asubuhi akiwa amebeba bendera zake; huingia na mtu wa kwanza kuingia [sokoni] na hutoka na mtu wa mwisho kutoka.))"
"1478","[AI-translation] ((Ibilisi ana mashetani waasi pamoja naye; huwaambia wawaongoze mahujaji na wapiganaji mbali na njia [nyofu].))"
"1479","[AI-translation] ((Mnapoingia vyumbani mwenu, semeni Salam [amani]; [kwa kufanya hivyo] mashetani waliomo humo wataondoka.))"
"1480","[AI-translation] ((Wekeni nyumba zenu na nuru kadri mwezavyo, na nyumba ambayo Qur'an inasomwa huwa pana kwa wakaazi wake, kheri yake huongezeka, malaika huhudhuria humo, na mashetani huitoka.))"
"1481","[AI-translation] ((Baadhi ya mashetani wa Allah wako nchi kavu; hawana mamlaka juu ya vitu vya baharini. [Vivyo hivyo, baadhi ya] mashetani wa Allah wako baharini; hawana mamlaka juu ya vitu vya nchi kavu.))"
"1482","[AI-translation] ((Mtu anaposimama kwa swala, mashetani saba husimama naye.))"
"1483","[AI-translation] ((Mnapopanda wanyama hawa, waacheni wapumzike sehemu tofauti; msiwapande kama mashetani.))"
"1484","[AI-translation] ((Allah Mtukufu atamtuma shetani pamoja naye [Dajjal] ambaye atazungumza na watu.))"
"1485","[AI-translation] ((Ee Abu Dharr! Jikinge kwa Allah na mashetani miongoni mwa majini na wanadamu.)) Nikasema: ([Ee Mtume wa Allah!] Je, kuna mashetani pia miongoni mwa wanadamu?) Akasema (Swalla Allahu 'alayhi wa sallam): Ndiyo."
"1486","[AI-translation] ((Ibilisi alikuja kwa Mtume (Swalla Allahu 'alayhi wa sallam) na akamuuliza mambo mengi, na wakati huo alikuwa msikitini na kundi la masahaba zake.))"
"1487","[AI-translation] ((Kifo cha mwanachuoni wa kidini, machoni mwa Ibilisi, ni bora kuliko kifo cha waabudu sabini.))"
"1488","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikataza dhabihu zinazotolewa kwa majini. [Hii ni dhabihu ambayo mtu huitoa baada ya kujenga nyumba kwa nia kwamba kwa kufanya hivyo, majini hawatawadhuru watu wa kaya yake.] ))"
"1489","[AI-translation] ((Jibril (amani iwe juu yake) alikuja kwangu na akasema: Jini muasi hunia uovu dhidi yako, basi unapolala kitandani mwako, soma Ayat al-Kursi.))"
"1490","[AI-translation] ((Majini Waislamu na majini washirikina walikuja kwangu na wakabishana. Waliniomba niwape sehemu ya kuishi, basi niliwapa majini Waislamu kuishi Jalas [milima na makazi] na majini washirikina kuishi Ghawr [eneo baina ya milima na bahari].))"
"1491","[AI-translation] ((Jilindeni nafsi zenu na familia zenu ndani mwanzoni mwa jioni, kwani wakati huo majini wako nje.))"
"1492","[AI-translation] ((Allah Mtukufu aliumba majini katika aina tatu: katika sura ya nyoka, nge, na wadudu wa ardhi; wale kama upepo hewani; na wale ambao hesabu itachukuliwa kwao na adhabu itatolewa.))"
"1493","[AI-translation] ((Ghilan [aina maalum ya majini] ni wachawi miongoni mwa majini.))"
"1494","[AI-translation] ((Kila kitu kinajua kwamba mimi ni Mtume wa Allah isipokuwa majini makafiri na wanadamu makafiri.))"
"1495","[AI-translation] ((Ugonjwa wa tauni ni kuumwa na ndugu zenu majini.))"
"1496","[AI-translation] ((Najisi ina sehemu sabini; sehemu moja tu iko miongoni mwa majini na wanadamu, na sehemu sitini na tisa [69] zilizobaki ziko miongoni mwa Berber [taifa la Afrika Kaskazini-Magharibi].))"
"1497","[AI-translation] ((Mwanamke anapotoka nyumbani kwake ilhali mumewe huchukia kutoka kwake, basi hadi arudi, kila malaika mbinguni na kila anachopita humlaani, isipokuwa majini na wanadamu.))"
"1498","[AI-translation] ((Lau wanadamu wote, majini, mashetani, na malaika kutoka mwanzo wa uumbaji hadi Siku ya Kiama wangesimama safu moja, hata hivyo wasingeweza kumzunguka Allah Mtukufu.))"
"1499","[AI-translation] ((Je, mnajua Khurafah [uongo] ni nini? Khurafah alikuwa mtu kutoka Banu Udhrah ambaye majini walimkamata. Alibaki miongoni mwao kwa muda mrefu, kisha wakamrudisha kwa wanadamu. Alikuwa akiwasimulia watu mambo ya ajabu ya majini ambayo aliyaona miongoni mwao, basi watu walianza kusema: Hizi ni hadithi za Khurafah [yaani anasimulia hadithi za uongo].))"
"1500","[AI-translation] ((Majini hawamdhuru mtu ambaye nyumbani mwake kuna farasi mzuri.))"
"1501","[AI-translation] ((Yule anayeingia Peponi, mahur wawili wenye macho mazuri watakaa kichwani mwake na wawili miguuni mwake, nao watamwimbia kwa sauti bora zaidi, ambayo itasikika na majini na wanadamu.))"
"1502","[AI-translation] ((Saa haitasimama hadi miongoni mwenu, kutoka wanawake wenu, idadi kubwa ya watoto wa majini wazaliwe [nao watawageuza mbali na dini yenu].))"
"1503","[AI-translation] (([Allah Mtukufu aliwalaani majini na akawageuza katika sura ya ng'ombe] Mbwa hawa weusi kwa kweli ni majini.))"
"1504","[AI-translation] ((Majini waumini pia watapokea thawabu, nao pia wataadhibiwa.))"
"1505","[AI-translation] (([Ami yako alipokusudia kumtuma mtu kwa ulinzi wa Mtume [ﷺ], alisema:] Ee ami yangu! Allah Mtukufu amenilinda na shari ya majini na wanadamu.))"
"1506","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikataza kuoa wanawake fulani.))"
"1507","[AI-translation] ((Mashetani wanadamu wana nguvu juu ya mashetani majini.))"
"1508","[AI-translation] ((Kwa ulinzi kutokana na jicho baya, kuna aya nane katika Kitabu cha Allah. Yule anayezisoma nyumbani mwake, wala wanadamu wala majini hawawezi kuwatia jicho baya watu wa nyumba hiyo siku hiyo. Aya saba zinatoka Sura Al-Fatiha, na aya moja ni Ayat al-Kursi.))"
