hadiths[72]{hadithnumber,text}:
"1861","। ইবনু উমার (রাঃ) হতে বর্ণিত আছে"
"1862","। আবদুল্লাহ ইবনু উমার (রাঃ) বলেন"
"1863","। আইশা (রাঃ) হতে বর্ণিত আছে"
"1864","। ইবনু উমার (রাঃ) হতে বর্ণিত আছে"
"1865","। জাবির ইবনু আবদুল্লাহ (রাঃ) হতে বর্ণিত আছে"
"1866","। আইশা (রাঃ) হতে বর্ণিত আছে"
"1867","। তাউস (রহঃ) হতে বর্ণিত আছে"
"1868","। আমর ইবনু মুররা (রহঃ) হতে বর্ণিত আছে"
"1869","। সুলাইমান ইবনু বুরাইদা (রহঃ) হতে তার বাবার সূত্রে বর্ণিত আছে"
"1870","। জাবির ইবনু আব্দুল্লাহ (রাঃ) হতে বর্ণিত আছে"
"1871","। আইশা (রাঃ) হতে বর্ণিত আছে"
"1872","। নুমান ইবনু বাশীর (রাঃ) হতে বর্ণিত আছে"
"1873","। হাসান ইবনু আলী আল-খাল্লাল-ইয়াহইয়া ইবনু আদম হতে তিনি ইসরাঈল (রহঃ) হতে উপরের বর্ণিত হাদীসের মতোই হাদীস বর্ণনা করেছেন। সহীহ"
"1874","। উমার ইবনুল খাত্তাব (রাঃ) হতে বর্ণিত আছে"
"1875","। আবূ হুরাইরা (রাঃ) বলেন"
"1876","। জাবির ইবনু আবদুল্লাহ (রাঃ) হতে বর্ণিত আছে"
"1877","। আবূ সাঈদ (রাঃ) হতে বর্ণিত আছে"
"1878","হাকম (রহঃ) হতে বর্ণিত আছে"
