"6434","أؼوشًأثىأوشۄأثۏتىأڬشحەأۄۏڽأ=أذعشحأؼثزتههۄأثىأتثۏأتًلۏٳأشعۏأتههۄأؼىۄأڬتأطوتشأ4733أتظذتثأطدشۄأوۏڽأۄًحتأۄەأ؏أتضأوًمؼأځشأوۄتدشۏىأڬتأإټہًتڽأذظۄأتضهتوأهەأإۏتأحہتأۗأ"
"6435","أضؼۏزأثىأدوۄتىأثۏتىأڬشحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬەأظذتثۏأذعشحأؼثزتههۄأتثىأتثۏأتًلۏٳأشعۏأتههۄأؼىۄأڬۏأإرشۏأؼوشأوۏڽأثۏىتةۏأصتةهأۄًأڲةۏأحہۏأ؏أوۏڽأتىأڬۏأصۏتشحأڬەأهةەأڲۏتأ؏أتىأڬًأضهتوأڬۏتأ؏أ+أضهتوأڬەأدًتثأڬەأثؼزأ"
"6436","عبدالمہیمن بن عباس بن سہل بن سعد الساعدی اپنے والد سے ، وہ ان کے دادا کا یہ بیان نقل کرتے ہیں : ان ( سہل بن سعد ) کا اصل نام ’’ حزن ‘‘ تھا ۔ رسول اللہ ﷺ نے ان کا نام ’’ سہل ‘‘ رکھا ۔ \nالمستدرك على الصحيحين حدیث: 6436 عربی حدیث: 6436"
"6437","أتثشتۄۏوأثىأتثىأتضذتمأذشثۏأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأوۏڽأىەأذعشحأضۄهأثىأضؼزأضتؼزۏأشعۏأتههۄأؼىۄأڬًأ““أتثًتهؼثتضأ‛‛أڬۄۄأڬشأإًتصأزۏأۗأ"
"6438","أتثًىؼۏوألشوتحەأۄۏڽأ=أذعشحأضۄهأثىأضؼزأشعۏأتههۄأؼىۄأ;;أۄدشۏأڬًألًحأۄًةەأۗأ"
"6439","ابن شہاب فرماتے ہیں : حضرت سہل بن سعد انصاری رضی اللہ عنہ نے 15 سال کی عمر میں رسول اللہ ﷺ کی صحبت پائی تھی ۔ \nالمستدرك على الصحيحين حدیث: 6439 عربی حدیث: 6439"
"6440","أمزتوۄأثىأتثشتۄۏوأثىأوذوزأثىأذتغثألشوتحەأۄۏڽأ=أذعشحأؼثزتههۄأثىأصثۏشأشعۏأتههۄأؼىۄأڬۏأتوتشحأوۏڽأ؏أوۏڽأىەأزۏڬہتأۄەأڬۄأذدتدأثىأۏًضلأذعشحأضۄهأثىأضؼزأشعۏأتههۄأؼىۄأڬەأظتذثصتزەأؼثتضأڬًأوتشأشۄتأحہتأ؏أذعشحأضۄهأڬًأتغهتؼأوهۏأحًأًۄأتۏڬأحۄثىزأثتىزہەأۄًةەأتًشأتۏڬأصشزأشىڲأڬۏأډتزشأهځۏټەأۄًةەأًۄتڽأإأڲةەأ؏أدثأإځأًۄتڽأځۄىډەأحًأذدتدأىەأتىأڬًأثۏټەأحڬأځۄىډىەأضەأشًڬأزۏتأۗأ"
"6441","%أذعشحأضۄهأثىأضؼزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأهًڲًڽأڬًأشضًهأتههۄأ﷽أڬۏأتذتزۏخأضىتحتأۄًڽأ؏أتًشأًۄأإڲەأضەأترحهتلأڬشأڬەأتذتزۏخأضىتحەأۄۏڽأۗأتڲشأوۏڽأإأڲۏتأحًأڬضۏأڬەأوىۄأضەأۏۄأىۄۏڽأضىۏڽأڲەأڬۄأ““أوۏڽأىەأشضًهأتههۄأ﷽أضەأۏۄأذزۏخأضىۏأۄەأ‛‛ۗ"
"6442","أتثًوًزًزأڬۄحەأۄۏڽأ=أوۏڽأىەأذعشحأضۄهأثىأضؼزأشعۏأتههۄأؼىۄأڬۏأصۏتشحأڬۏأۄەأ؏أتىأڬۏأزتڔہۏأوثتشڬأضلۏزأحہۏأتًشأتىأڬۏأوًىډہۏڽأڬحشًتحەأحہەأۗأ"
"6443","عبدالمہیمن بن عباس بن سہل بن سعد اپنے والد سے ، وہ ان کے دادا سے روایت کرتے ہیں کہ حضرت سہل بن سعد رضی اللہ عنہ نبی اکرم ﷺ کی بارگاہ میں حاضر ہوئے تھے ۔ \nالمستدرك على الصحيحين حدیث: 6443 عربی حدیث: 6443"
"6444","أتثشتۄۏوأثىأوىسشأذصتوۏألشوتحەأۄۏڽأ=أذعشحأضۄهأثىأضؼزأشعۏأتههۄأؼىۄأڬۏأڬىۏحأ““أتثًتهؼثتضأ‛‛أحہۏأ؏أإځأڬتأتىحمتهأ<4أۄدشۏأڬًأۄًتأۗأوزۏىۄأوىًشۄأوۏڽأشضًهأتههۄأ﷽أڬەأظذتثۄأڬشتوأوۏڽأضثأضەأإرشأوۏڽأًلتحأځتىەأًتهەأۏۄۏأظذتثۏأۄۏڽأ؏أتىأڬۏأؼوشأ433أثشضأحہۏأۗأ"
"6445","أوظؼثأثىأؼثزتههۄألشوتحەأۄۏڽأ=أذعشحأؼثزتههۄأثىأتثۏأذزشزأتضهوۏأشعۏأتههۄأؼىۄأڬۏأڬىۏحأ““أتثًوذوزأ‛‛أۄەأ؏أ;4أثشضأڬۏأؼوشأضىأ:4أۄدشۏأوۏڽأتىأڬتأتىحمتهأۄًتأۗأتثًذزشزأڬتأىتوأ““أضهتوۄأ‛‛أۄەأۗأۏۄأمثۏهۄأتضهوأڬۏأتۏڬأطترأشلتؼۄأضەأحؼهمأشڬہحەأحہەأۗأ"
"6446","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأڬەأإصتزأڬشزۄأؽهتوأثۏتىأڬشحەأۄۏڽأڬۄأوۏڽأىەأذعشحأتىضأشعۏأتههۄأؼىۄأضەأځًډہتأڬۄأإځأىەأدىڲأثزشأوۏڽأطشڬحأڬۏأۄەأآأحًأتىۄًڽأىەأدًتثتَألشوتۏتأ=أحۏشۏأوتڽأىۄأشۄەأ؏أوۏڽأدىڲأثزشأضەأڬۄتڽأؽتةثأشۄًڽأڲتأۗ"
"6447","أتضذتمأثىأۏصۏزأڬۄحەأۄۏڽأ=أوۏڽأىەأذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأڬۏأڲشزىأوۏڽأوۄشأهڲۏأۄًةۏأزۏڬہۏأحہۏأۗأذدتدأىەأإځأڬًأسهۏهأڬشىەأڬەأهةەأإځأڬۏأڲشزىأځشأوۄشأهڲتأزۏأحہۏأۗأ"
"6448","أتثًىؼۏوألشوتحەأۄۏڽأ=أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأڬتأتىحمتهأ<6أۄدشۏأڬًأۄًتأۗأ"
"6449","أوظؼثأثىأؼثزتههۄأصثۏشۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أتىضأثىأوتهڬأثىأىعشأثىأعوعوأثىأصۏزأثىأذشوأثىأدىزثأثىأؼتوشأثىأؽىوأثىأؼزۏأثىأىدتشأ‛‛أتىأڬۏأًتهزۄأوذحشوۄأ““أتوأضهۏوأثىحأوهذتىأ‛‛أۄۏڽأۗأ"
"6450","أصۄشۏألشوتحەأۄۏڽأڬۄأذعشحأتىضأثىأوتهڬأىەألشوتۏتأ=أوۏڽأ43أضتهأڬۏأؼوشأوۏڽأشضًهأتههۄأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًأڲۏتأحہتأ؏أدثأشضًهأتههۄأ﷽أڬتأتىحمتهأۄًتأحًأتضأًمحأوۏشۏأؼوشأ53أضتهأحہۏأۗأ"
"6451","أؼثزتهؼصۏصأثىأظۄۏثألشوتحەأۄۏڽأ=أوۏڽأتًشأختثأتهثىتىۏأذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأڬەأځتضأڲةەأ؏أختثحأىەأتىأڬًأ““أتثًذوصۄأ‛‛أڬۄۄأڬشأځڬتشتأۗأ"
"6452","أوؼثزأثىأۄهتهألشوتحەأۄۏڽأ=أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأضەأدثأۄوأصۏتزۄأتظشتشأڬشحەأحًأًۄأتځىەأځتضأوًدًزأشدضټشأۄوتشەأهةەأىڬتهأهۏحەأتًشألشوتحەأ=أۏۄأًۄأشًتۏتحأۄۏڽأدًأوۏڽأىەأىثۏأتڬشوأ﷽أڬۏأصثتىۏأضىۏأۄۏڽأ؏أ+أوؼثزأثىأۄهتهأۏتأطتۏزأذعشحأتىضأشعۏأتههۄأؼىۄأڬۄحەأۄۏڽأ=أ"
"6453","%أذعشحأضوتڬأثىأوًضۏٳألشوتحەأۄۏڽأ=أدثأذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأذدتدأثىأۏًضلأڬەأځتضأڲةەأحًأتضأىەأإځأڬۏأڲشزىأځشأصروأهڲتأزۏتأ؏أځہشأڬۄىەأهڲتأ=أتەأطتوأًتهًأ$أڬۏتأحوأتضأطرظأڬًأځۄډتىحەأۄًأآأۏۄأشضًهأتههۄأ﷽أڬتأرتزوأۄەأ؏أځہشأڬۄىەأهڲتأ=أڬۏتأحوۄۏڽأوؼهًوأۄەأڬۄأوۏڽأىەأتضأڬۏأڲشزىأځشأصروأڬۏًڽأهڲتۏتأۄەأآأهًڲًڽأىەأڬۄتأ=أتوۏشأثۄحشأدتىحەأۄۏڽأۗأتضأىەأڬۄتأ=أۏۄأځۄهۏأإصوتةطأوۏڽأحًأختثحأمزوأشۄتأهۏڬىأزًضشۏأإصوتةطأوۏڽأۏۄأطڬًڬأًأطثۄتحأوۏڽأوثحهتأۄًأڲۏتأۗ"
"6454","أتؼوطأڬۄحەأۄۏڽأ=أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأىەأؼثزتهوهڬأثىأوشًتىأڬۏأدتىثأرغأهڬہتأڬۄأتەأتوۏشتهوًوىۏىأ$أوۏڽأىەأزضأضتهأڬتأؼشظۄأشضًهأتههۄأ﷽أڬۏأرزوحأڬۏأۄەأ؏أتًشأذدتدأودہەأثظشۄأڬۏأىۏډأمًوًڽأوۏڽأطوتشأڬشحتأۄەأ؏أؼثزتهوهڬأىەأذدتدأڬۏأدتىثأرغأهڬہتأ+أدضأڬتأوعوًىأۏۄأحہتأ"
"6455","أذعشحأختثحأتهثىتىۏألشوتحەأۄۏڽأ=أذعشحأتىضأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أتەأتثًوذوزأ$أودہأضەأ+أتذتزۏخأ"
"6456","أتثىأؼًلألشوتحەأۄۏڽأ=أذعشحأتىضأشعۏأتههۄأؼىۄأىەأشضًهأتههۄأ﷽أڬۏأثۄحأڬوأتذتزۏخأشًتۏحأڬۏأۄۏڽأۗأإځأدثأثہۏأڬًةۏأذزۏخأثۏتىأڬشحەأتضأڬەأضتحہأۏۄأثہۏأڬۄحەأ““أتًأڬوتأمتهأشضًهأتههۄأ﷽أ‛‛أ+أۏتأځہشأدۏضەأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ"
"6457","أتضذتمأثىأؼخوتىألشوتحەأۄۏڽأ=أوۏڽأىەأوًضۏٳأثىأتىضأضەأځًډہتأ=أىثۏأتڬشوأ﷽أڬەأؽصتًحأڬحىەأۄۏڽأآأتىۄًڽأىەأڬۄتأ=أ56أۗأتىأوۏڽأضەأ;أؽصًتحأتۏضەأۄۏڽأدىأوۏڽأڬةۏأڬةۏأوۄۏىەأهڲأڲةەأۗأوۏڽأىەأځًډہتأ=أذعشحأتىضأشعۏأتههۄأؼىۄأىەأشضًهأتههۄأ﷽أڬەأۄوشتۄأڬحىەأؽصًتحأوۏڽأطشڬحأڬۏأآأتىۄًڽأىەأڬۄتأ=أ;أۗأ"
"6458","%أذوۏزأڬۄحەأۄۏڽأ=أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأشضًهأتههۄأ﷽أڬۏأذزۏخأثۏتىأڬشأشۄەأحہەأ=أتۏڬأإزوۏأىەأڬۄتأ=أڬۏتأإځأىەأۏۄأثتحأرًزأشضًهأتههۄأ﷽أضەأضىۏأۄەأآأتضأثتحأځشأذعشحأتىضأشعۏأتههۄأؼىۄأطزۏزأؽعثىتڬأۄًةەأ؏أتًشألشوتۏتأ=أرزتأڬۏأمضوأ$أۄشأًۄأثتحأدًأۄوأحوۄۏڽأضىتةۏڽأ؏أعشًشۏأىۄۏڽأۄەأڬۄأۄوأىەأًۄأشضًهأتههۄأ﷽أضەأۄۏأضىۏأۄًأ؏أثهڬۄأثضتأتًمتحأۏًڽأثہۏأۄًحتأحہتأڬۄأۄوأتۏڬأزًضشەأڬًأذزۏخأضىتۏتأڬشحەأحہەأۗأتًشأۄوأوۏڽأضەأڬًةۏأطرظأثہۏأزًضشەأځشأڬًةۏأحۄوحأىۄۏڽأهڲتحتأحہتأۗ"
"6459","أرهۏلۄأثىأرۏتغأؼظلشۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أذوهأثىأوتهڬأثىأثتثؽۄأثىأدتثشأثىأؼثۏزأثىأشثۏؼۄأثىأڬؼثأثىأذتشخأثىأڬخۏشأثىأۄىزأثىأغتثرۄأثىأهذۏتىأثىأۄصۏهأۄسهۏأ‛‛ۗأثظشۄأوۏڽأتىأڬتأوڬتىأحہتأۗأ"
"6460","أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأوىثشأځشأڬہڔەأۄًةەأتًشألشوتۏتأ=أڬۏتأڬضۏأطرظأڬًأۏتزأۄەأڬۄأشضًهأتههۄأ﷽أىەأذىۏىأڬەأثتشەأوۏڽأڬۏتألۏظهۄألشوتۏتأحہتأآأذعشحأذوهأثىأوتهڬأثىأىتثؽۄأۄسهۏأشعۏأتههۄأؼىۄأڬہڔەأۄًةەأتًشأڬۄىەأهڲەأ=أتەأتوۏشتهوًوىۏىأ$أزًأهًىڋۏتڽأذتوهۄأحہۏڽأ؏أتىأوۏڽأضەأتۏڬأىەأتځىۏأډہحشۏأڬۏأڋىڋۏأزًضشۏأڬًأوتشۏأدضأڬۏأًدۄأضەأًۄأؼًشحأثہۏأوشأڲةۏأتًشأتضأڬەأځۏټأڬتأثډۄأثہۏأوشأڲۏتأ؏أىثۏأتڬشوأ﷽أىەألۏظهۄألشوتۏتأڬۄأذوهأڬەأثزهەأوۏڽأتۏڬأؽهتوأۏتأتۏڬأهًىڋۏأزۏأدتةەأۗأذعشحأؼوشأشعۏأتههۄأؼىۄأىەأڬۄتأ=أتههۄأتڬثشأ$أتڲشأۄوأۏۄأىۄأضىحەأحًأتضأڬەأثؽۏشأڬًةۏألۏظهۄأىۄأڬشأضڬحەأۗأ"
"6461","أصثۏشأثىأثڬتشألشوتحەأۄۏڽأ=أتثًغتهثأڬەأۄتڽأؼمۏهأ؏أدؼلشأتًشأؼهۏأځۏزتأۄًةەأ؏أتىأحۏىًڽأڬەأزشوۏتىأزضأ؏أزضأثشضأڬتألشمأحہتأۗأ"
"6462","أرهۏلۄأثىأرۏتغألشوتحەأۄۏڽأ=أذعشحأؼمۏهأتثىأتثۏأغتهثأڬًلۄأ؏أثظشۄأتًشأطتوأوۏڽأومۏوأشۄەأ؏أتًشأذعشحأوؼتًۏۄأشعۏأتههۄأؼىۄأڬۏأرهتلحأوۏڽأتىأڬتأتىحمتهأۄًتأۗأ"
"6463","أودتۄزأثىأدثشتثۏأتهذدتدألشوتحەأۄۏڽأ=أذعشحأؼهۏأتثىأتثۏأغتهثأشعۏأتههۄأؼىۄأځشأتههۄأحؼتهۏٳأڬەألعتةهأوۏڽأضەأۏۄأثہۏأۄەأڬۄأتههۄأحؼتهۏٳأىەأتىأځشأۏۄأتذضتىألشوتۏتأ؏أمشۏطأځشأطزۏزأمذغأضتهۏأإأڲةۏأ؏أتًشأتثًغتهثأڬخۏشتهؼۏتهأحہەأ؏أشضًهأتههۄأ﷽أڬەأډډتأذعشحأؼثتضأشعۏأتههۄأؼىۄأځًشەأثىۏأۄتطوأوۏڽأإضًزۄأذتهأحہەأ؏أذعًشأىەأتځىەأډډتأذعشحأؼثتضأشعۏأتههۄأؼىۄأضەأڬۄتأ=أتەأتثًتهلعهأإځأڬەأثہتةۏأتثًغتهثأڬەأتۄهأًأؼۏتهأصۏتزۄأۄۏڽأ؏أتًشأدۏضتأڬۄأإځأزۏڬہأشۄەأۄۏڽأڬۄأهًڲأثۏډتشەأمذغأضتهۏأڬتأطڬتشأۄۏڽأ؏أإځأۄوتشەأضتحہأډهةەأ؏أۄوأتثًغتهثأڬەأضتحہأحؼتًىأڬشحەأۄۏڽأ؏أتىأڬتأتۏڬأثډۄأوۏڽأتځىۏأڬلتهحأوۏڽأهًڽأڲتأتًشأتۏڬأثډۄأإځأتځىۏأڬلتهحأوۏڽأهەأهۏڽأۗأذعشحأؼثتضأشعۏأتههۄأؼىۄأىەأذتوۏأثہشأهۏأ؏أذعًشأ﷽أذعشحأؼثتضأشعۏأتههۄأؼىۄأڬًأۄوشتۄأهەأڬشأتثًغتهثأڬەأڲہشأحطشۏلأهەأڲةەأ؏أتًشأتىأضەأڬۄتأ=أۄوأإځأڬەأثډًڽأڬەأوؼتوهەأوۏڽأإځأځشأإضتىۏأڬشىتأډتۄحەأۄۏڽأۗأحتڬۄأتضأًمحأهًڲأدضأځشۏطتىۏأوۏڽأوثحهتأۄۏڽأ؏أإځأتضأضەأىڬهأضڬۏڽأۗأذعشحأتثًغتهثأىەأتىأضەأڬۄتأ=أإځأهًڲأؼمۏهأڬًأوۏشەأځتضأشۄىەأزًأتًشأثتمۏأثډًڽأڬەأثتشەأوۏڽأدًأحوۄتشۏأوشعۏأۄًأ؏أوۏڽأشتعۏأۄًڽأۗأډىتىډۄأشضًهأتههۄأ﷽أىەأذعشحأؼهۏأڬًأتځىەأسوەأهەأهۏتأتًشأذعشحأؼثتضأشعۏأتههۄأؼىۄأىەأذعشحأدؼلشأشعۏأتههۄأؼىۄأڬًأتځىەأضتحہأهەأهۏتأۗأتضأڬەأثؼزأذعشحأؼهۏأشعۏأتههۄأؼىۄأوضهضهأشضًهأتههۄأ﷽أڬەأۄوشتۄأۄۏأشۄەأ؏أذحۏٳأڬۄأتههۄأحؼتهۏٳأىەأإځأڬًأىثۏأثىتۏتأتًشأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەأذعًشأ﷽أڬۏأتحثتؼأتًشأځۏشًۏأڬۏأۗأذعشحأؼثتضأشعۏأتههۄأؼىۄأىەأذعشحأدؼلشأشعۏأتههۄأؼىۄأڬًأهۏتأ؏أتًشأذعشحأدؼلشأشعۏأتههۄأؼىۄأوضهضهأذعشحأؼثتضأشعۏأتههۄأؼىۄأڬەأځتضأۄۏأشۄەأذحۏٳأڬۄأًۄأوضهوتىأۄًأڲةەأ؏أتًشأتىأضەأوضحؽىۏأۄًأڲةەأۗأ"
"6464","أتثًتضذتمأڬۄحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأذعشحأؼمۏهأثىأتثۏأغتهثأضەألشوتۏتأ=أتەأتثًۏصۏزأ$أوۏڽأحوأضەأزًۄشۏأوذثحأڬشحتأۄًڽأ؏أتۏڬأحًأتضأهةەأڬۄأحوأوۏشەأشطحەأزتشأۄًأتًشأزًضشۏأتضأهةەأڬۄأوۏشەأډډتأدتىأحوأضەأوذثحأڬشحەأۄۏڽأۗأ"
"6465","أذعشحأذسۏلۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أذعشحأؼمۏهأضەألشوتۏتأڬشحەأحہەأ=أتەأؼمۏهأ$أوۏڽأحوأضەأزًۄشۏأوذثحأڬشحتأۄًڽأ؏أتۏڬأشطحۄأزتشۏأڬۏأًدۄأضەأتًشأزًضشۏأتضأهةەأڬۄأوۏشەأډډتأتثًغتهثأحوأضەأوذثحأڬشحەأۄۏڽأۗأتىأزًىًڽأذزۏخًڽأڬتأثۏتىأإةىزۄأذزۏخأوۏڽأإأشۄتأۄەأۗأ"
"6466","أصۏزأثىأذضۏىأتځىەأًتهزأضەأ؏أًۄأتىأڬەأزتزتأضەأشًتۏحأڬشحەأۄۏڽأ=أشضًهأتههۄأ﷽أتځىەأډډتأذعشحأؼثتضأشعۏأتههۄأؼىۄأڬەأۄوشتۄأڲہشأضەأىڬهەأ؏أذعشحأذوصۄأ؏أؼهۏأ؏أدؼلشأتًشأؼمۏهأۏۄأهًڲأدضأدڲۄأڬتوأڬتدأڬشحەأحہەأ؏أإځأ﷽أًۄتڽأځۄىډەأتًشأإځأ﷽أىەأتځىەأزًىًڽأډډًڽأڬًألشوتۏتأ=أتىأثډًڽأوۏڽأضەأډىأهًأ؏أتىأوۏڽأضەأتۏڬأىەأڬۄتأ=أوۏڽأىەأدؼلشأڬًأډىتأ؏أتًشأزًضشەأىەأڬۄتأ=أوۏڽأىەأؼهۏأڬًأډىتأ؏أوۏڽأىەأحوۄۏڽأترحۏتشأزۏتأتًشأحوأزًىًڽأىەأډىأهۏتأۗأهۏڬىأتههۄأحؼتهۏٳأىەأ““أؼهۏأ‛‛أڬًأوۏشەأهةەأډىتأۄەأۗأ"
"6467","أذعشحأؼمۏهأتثىأتثۏأغتهثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أمشۏطۏأهًڲأتثًغتهثأڬەأځتضأإةەأتًشأڬۄىەأهڲەأ=أحوۄتشتأثہحۏدتأۄوتشۏأوذلهًڽأوۏڽأ؏أۄوتشۏأودهضًڽأوۏڽأۄوۏڽأحڬهۏلأزۏحتأۄەأ؏أحوأتضأڬًأوىؼأڬشًأ؏أتثًغتهثأىەأودہەأڬۄتأ=أتەأؼمۏهأحوأوذوزأڬەأځتضأدتأڬشأتضأڬًأضودہتأزًأ؏أذعشحأؼمۏهألشوتحەأۄۏڽأ=أوۏڽأوذوزأ﷽أڬًأڋہًىڋىەأىڬهتأ؏أتًشأتۏڬأودهضأوۏڽأإځأڬًأزۏڬہأهۏتأ؏أذعشحأغهذۄأىەأڬۄتأ““أىثحأظؽۏشۆأ‛‛أڲشوۏأڬۏأطزحأڬۏأًدۄأضەأإځأػۄشأڬۏأىوتصأوۏڽأحطشۏلأهتةەأۗأإځأزہًځأضەأثډىەأڬەأهةەأڬًةۏأضتۏۄأزتشأدڲۄأڋہًىڋأشۄەأحہەأۗأۄوأتىأڬەأځتضأإأڲةەأۗأذعشحأتثًغتهثأىەأڬۄتأ=أحۏشەأډډتأصتزأثہتةۏًڽأڬتأرۏتهأۄەأڬۄأحوأتىأڬۏأودتهضأًأوذتلهأوۏڽأتىأڬًأثشتأثہهتأڬۄحەأۄًأآأحوأتضأڬتوأضەأثتصأإأدتاأ؏أشضًهأتههۄأ﷽أىەأإضوتىأڬۏأدتىثأىڲتۄأتټہتأڬشأزۏڬہتأتًشألشوتۏتأ=أحوأتضأضًشدأڬًأزۏڬہأشۄەأۄًأآأتىۄًڽأىەأڬۄتأ=أدۏأۄتڽأۗأإځأ﷽أىەألشوتۏتأ=أتڲشأحوأضًشدأثہۏأهتأڬشأوۏشەأۄتحہًڽأځشأشڬہأزًأڲەأوۏڽأحثأثہۏأۏۄأڬتوأىۄۏڽأډہًڔأضڬحتأۗأذعشحأتثًغتهثأىەأڬۄتأ=أۄوأتځىەأثہحۏدەأڬًأڬثہۏأدہټهتأىۄۏڽأضڬحەأۗأۏۄأڬۄۄأڬشأًۄأهًڲأًتځضأډهەأڲةەأۗأ"
"6468","أذعشحأذضىألشوتحەأۄۏڽأ=أۄوتشەأځتضأذعشحأؼمۏهأتثىأتثۏأغتهثأإةەأتًشأثىۏأدطوأثىأضؼزأڬۏأتۏڬأؼًشحأضەأىڬتذأڬۏتأ؏أتضأڬەأضتحہأۄوثضحشۏأثہۏأڬۏأۗأځہشأدثأدتىەأهڲەأحًأهًڲًڽأىەأڬۄتأ=أحوۄتشەأثۏټەأثۏټۏتڽأڬخشحأضەأۄًڽأۗأإځأىەألشوتۏتأ=أتۏضەأىۄۏڽأڬۄحەأ؏أثهڬۄأحوأڬۄًأڬۄأتههۄأحؼتهۏٳأثشڬحأؼغتألشوتةەأۗأ"
"6469","أرهۏلۄأثىأرۏتغأىەأإځأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أوؼمهأثىأۏضتشأثىأؼثزتههۄأثىأذشتمأثىأهاۏأثىأڬؼثأثىأؼثزأثىأخًشأثىأۄزوۄأثىأهتغوأثىأؼخوتىأثىأؼوشًأثىأتزأثىأغتثرۄأ‛‛أإځأڬۏأڬىۏحأ““أتثًؼهۏأ‛‛أۄەأۗأثظشۄأوۏڽأتىأڬۏأصوۏىۏڽأثہۏأحہۏڽأۗأذعشحأوؼمهأثىأۏضتشأشعۏأتههۄأؼىۄأتثىأصۏتزأڬۏأتوتشحأوۏڽأضىأ8;أۄدشۏأڬًألًحأۄًةەأۗأ"
"6470","أذعشحأوؼمهأثىأۏضتشأوصىۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأودہەأذڬوأزۏتأڬۄأوۏڽأتځىۏأمًوأڬەألۏظهەأڬۏتأڬشًڽأۗأوۏڽأىەأؼشعأڬۏتأ=أودہأضەألۏظهۄأظذۏذأىۄۏڽأۄًأځتحتأۗأإځأ﷽أىەألشوتۏتأ=أحوأتىأوۏڽألۏظهەأڬۏتأڬشًأ؏أوۏڽأىەأځہشأًۄۏأؼشعأڬۏأ؏أإځأ﷽أىەأځہشألشوتۏتأ=أتىأوۏڽألۏظهەأڬۏتأڬشًأ؏أتضأهةەأڬۄأتههۄأحؼتهۏٳأڬۏأشذوحأمتعۏأڬەأضتحہأۄًحۏأۄەأدثأحڬأڬۄأًۄأدتىأثًدہأڬشأدتىثزتشۏأىۄأڬشەأۗأ"
"6471","أؼثۏزتههۄأثىأوؼمهأثىأۏضتشأوصىۏأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أڬحتثأتههۄأځشأؼوهأڬشًأ؏أتضأوۏڽأضەأڬضۏأډۏصأڬًأثہۏأوحأدہټهتاأ؏أدضأوضةهۄأوۏڽأطڬأًأطثۄأًتمؼأۄًأتضأڬەأثتشەأوۏڽأتۄهأؼهوأضەأزشۏتلحأڬشأهًأ؏أًۄأدًأثحتةۏڽأتضأځشأؼوهأڬشًأ؏أحًشتحأتًشأتىدۏهأڬًأثشذمأوتىًأتًشأمشإىأڬشۏوأځشأتۏوتىأهتاأڬۏًىڬۄأتضأوۏڽأۄشأډۏصأڬتأًتعذأثۏتىأوًدًزأۄەأ؏أمشإىأڬشۏوأطتلؼأتًشأوطلؼأۄەأ؏أمشإىأذتوۏأۄەأتًشأحظزۏمأطزۄأۄەأۗأ"
"6472","أذعشحأوؼمهأثىأۏضتشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأىەأۄشوصتىأضەأتظثۄتىأ؏ألتشضأتًشأإسشثتةۏدتىأڬەأثتشەأوۏڽأوطتًشحأڬۏأ؏أتىۄًڽأىەأڬۄتأ=أتەأتوۏشتهوًوىۏىأ$أتظثۄتىأ؏أتىأضثأؼهتمًڽأڬۏأثىۏتزأۄەأۗأ"
"6473","أتثًؼثۏزۄأوؼوشأثىأوخىۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أؼثزتههۄأثىأوؽلهأثىأؼثزىۄوأثىأؼلۏلأثىأضذۏوأثىأشثۏؼۄأثىأؼزۏأثىأخؼهثۄأثىأسًۏثأثىأضؼزأثىأؼزۏأثىأؼخوتىأثىأؼوشًأثىأتزأثىأغتثرۄأ‛‛أ"
"6474","رهۏلۄأثىأرۏتغألشوتحەأۄۏڽأ=أؼثزتههۄأثىأوؽلهأوصىۏأڬۏأڬىۏحأ““أتثًضؼۏزأ‛‛أۄەأۗأتضأڬەأثؼزأضتثمۄأذزۏخأڬەأوًتلمأىضثأثۏتىأڬۏتأۗأهۏڬىأتضأڬۏأذزۏخأوۏڽأۏۄأتعتلۄأثہۏأۄەأ““أتًشأتىأڬۏأًتهزۄأؼحۏهۄأثىحأوؼتًۏۄأثىأمشۄأثىأوصۏىۄأ‛‛أۄۏڽأۗأثظشۄأوۏڽأدتوؼأوضدزأڬەأضتوىەأتىأڬتأتۏڬأڲہشأۄەأۗأ"
"6475","أذعشحأؼثزتههۄأثىأوؽلهأشعۏأتههۄأؼىۄأڬەأثتشەأوۏڽأوشًۏأۄەأڬۄأتىۄًڽأىەألشوتۏتأحہتأڬۄأدثأوۏشۏأشًذأمثعأۄًأدتةەأ؏أحًأودہەأؽضهأزۏىەأڬەأثؼزأڬتلًشأوهأزۏىتأتًشأودہەأزًأډتزشًڽأتًشأتۏڬأموۏظأوۏڽأڬلىأزۏىتأۗأڬۏًىڬۄأىثۏأتڬشوأ﷽أىەأتۏضەأۄۏأڬۏتأحہتأۗأ"
"6476","أوظؼثأثىأؼثزتههۄأصثۏشۏألشوتحەأۄۏڽأ=أڬؼثأثىأصۄۏشأتًشأثدۏشأثىأصۄۏشأثىأتثۏأضهوۏأ؏أتثًضهوۏٳأڬتأىتوأ““أشثۏؼۄأثىأشثتذأثىأمشغأثىأذتشخأثىأمحتزۄأثىأذهتًۄأثىأخؼهثۄأثىأخًشأثىأۄزوۄأثىأهتغوأثىأؼخوتىأثىأؼوشًأثىأتزأثىأغتثرۄأ‛‛أۄەأۗأۏۄأزًىًڽأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًأڬشأوطشلأثتأتضهتوأۄًةەأتًشأومتوأظذتثۏحأځشألتةصأۄًةەأۗأ"
"6477","%أذدتدأثىأسۏأشمۏثۄأثىأؼثزتهشذوىأثىأڬؼثأثىأصۄۏشأثىأتثۏأضهوۏأتهوصىۏأتځىەأًتهزأضەأ؏أًۄأتىأڬەأزتزتأضەأشًتۏحأڬشحەأۄۏڽأ؏ألشوتحەأۄۏڽأڬۄأصۄۏشأڬەأزًىًڽأثۏټەأڬؼثأتًشأثدۏشأىڬهەأتًشأتثشمأتهؼصتلأڬەأځتضأځۄىډەأ؏أثدۏشأىەأڬؼثأضەأڬۄتأ=أحوأتضأدڲۄأټہۄشأڬشأثڬشۏًڽأڬۏأىڲۄثتىۏأڬشًأ؏أوۏڽأتضأطرظأۏؼىۏأشضًهأڬشۏوأ﷽أڬەأځتضأدتحتأۄًڽأتًشأتضأڬۏأحؼهۏوتحأضىأڬشأإحتأۄًڽأډىتىډۄأڬؼثأًۄۏڽأټہۄشأڲةەأتًشأثدۏشأإڲەأډهەأڲةەأ؏أشضًهأتههۄأ﷽أحطشۏلأهتةەأ؏أإځأ﷽أىەأتىأڬًأتضهتوأڬۏأزؼًحأزۏأ؏أتىۄًڽأىەأتضهتوأمثًهأڬشأهۏتأۗأتضأثتحأڬۏأرثشأڬؼثأحڬأځۄىډۏأحًأتضأىەأڬۄتأ="
"6478","%أتثىأدزؼتىأڬۄحەأۄۏڽأ=أذعشحأڬؼثأثىأصۄۏشأثىأتثۏأضهوۏأىەأوضدزأوۏڽأشضًهأتههۄأ﷽أڬەأضتوىەأ+أمظۏزۄأځڔہتأدضأڬەأتطؼتشأوۏڽأضەأۏۄأثہۏأحہتأ"
"6479","%أوًضۏٳأثىأؼمثۄألشوتحەأۄۏڽأ=أڬؼثأثىأصۄۏشأشعۏأتههۄأؼىۄأىەأوزۏىۄأوىًشۄأوۏڽأوضدزأىثًۏأطشۏلأوۏڽأشضًهأتههۄأ﷽أڬەأضتوىەأمظۏزۄأځڔہتأ؏أدثأتضأطؼشأځشأځۄىډەأ="
"6480","%أوذوزأثىأتضذتمأڬۄحەأۄۏڽأ=أدثأشضًهأتههۄأ﷽أغتةلأضەأًتځضأحطشۏلأهتةەأۗأتضأًمحأحڬأذعشحأثدۏشأثىأصۄۏشأثىأتثۏأضهوۏأ؏أتځىەأثہتةۏأڬؼثأثىأصۄۏشأتثىأتثۏأضهوۏأڬًأرغأهڬہأڬشأتضأثتحأضەأثترثشأڬشأډڬەأحہەأڬۄأدًأهًڲأشضًهأتههۄأ﷽أڬۏأطتىأوۏڽأثەأتزثۏأڬۏتأڬشحەأحہەأتًشأإځأؼهۏۄأتهضهتوأڬًأحڬتهۏلأزۏتأڬشحەأحہەأ؏أشضًهأتههۄأ﷽أىەأتىأضثأڬًأمحهأڬشًتأزۏتأۄەأ؏أتًشأۏۄأڬۄأمشۏطأڬەأطؼشتؤأوۏڽأضەأتثىأصثؼشۏأتًشأۄثۏشۄأثىأتثۏأًۄثأىەأثہتڲأڬشأدتىأثډتةۏأۄەأ؏أتضأهةەأتڲشأحوۄتشتأزهأډتۄەأحًأحوأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًأدتاأ؏أدًأطرظأحتةثأۄًأڬشأإځأ﷽أڬۏأثتشڲتۄأوۏڽأإأدتحتأۄەأإځأتضأڬًأوؼتلألشوتأزۏحەأۄۏڽأۗأتًشأتڲشأحوۄتشتأزهأىۄۏڽأډتۄحتأحًأتځىەأثډتاأڬۏأرًزأحزثۏشأڬشًأۗأذعشحأڬؼثأىەأڬډہأتطؼتشأهڬہەأحہەأدىأوۏڽأشضًهأتههۄأ﷽أڬۏأطتىأوۏڽأثەأتزثۏأځتةۏأدتحۏأحہۏأ؏أۏۄأتطؼتشأهًڲًڽأوۏڽأځہۏهأثہۏأڲةەأحہەأۗأًۄأتطؼتشأۏۄأحہەأ="
"6481","أرهۏلۄأثىأرۏتغأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أمشۄأثىأتۏتضأثىأۄهتهأثىأشثتثأثىأؼثۏزتههۄأثىأسًۏثأثىأتًضأثىأضًتشۄأثىأؼوشًأثىأضتشۏۄأثىأخؼهثۄأثىأزۏىتشأثىأضهۏوتىأثىأتًضأثىأؼخوتىأثىأؼوشًأ‛‛أۏۄۏأتثًوؼتًۏۄأثىأمشۄأۄۏڽأۗأثظشۄأوۏڽأؼًلۄأڬەأضتوىەأتىأڬتأڲہشأحہتأ؏أتصتشمۄأىەأتىأڬًأتثىأؼثۏضأڬەأۄوشتۄأ97أۄدشۏأڬًأمحهأڬۏتأۗأ"
"6482","أوؼتًۏۄأثىأمشۄأتځىەأًتهزأڬتأثۏتىأىمهأڬشحەأۄۏڽأ+أًۄألشوتحەأۄۏڽأ"
"6483","أوؼتًۏۄأثىأمشۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أؼتةطۄأڬۏألعۏهحأزىۏتأڬۏأحوتوأؼًشحًڽأځشأتۏضەأۄۏأۄەأدۏضەأخشۏزأڬہتىەأڬۏألعۏهحأحوتوأڬہتىًڽأځشأۗأ"
"6484","أتۏتضأثىأوؼتًۏۄأثىأمشۄأتځىەأزتزتأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأطرظأؽشًثأإلحتثأڬەأًمحأضتذهأضوىزشأځشأثهىزأإًتصأضەأتههۄأتڬثشأڬۄەأڲتأ؏أتههۄأحؼتهۏٳأځًشەأضوىزشأڬەأۄشأمغشەأڬەأثزهەأوۏڽأتضأڬًأزضأىۏڬۏتڽأؼغتألشوتةەأڲتأ؏أتضأڬەأزضأڲىتۄأوټتةەأڲتأتًشأتضأڬەأزضأزشدتحأثهىزأڬشەأڲتأۗأۄشأزشدەأضەأزًضشەأزشدەأڬەأزشوۏتىأحۏصأشلحتشأڲہًڔەأڬۏأتۏڬأضًأضتهأڬۏأوضتلحأۄەأۗأ"
"6485","رهۏلۄأثىأرۏتغأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أؼتةسأثىأؼوشًأثىأۄهتهأثىأؼثۏزأثىأشًتذۄأثىأهثۏثۄأثىأؼزۏأثىأؼتوشأثىأؼثزتههۄأثىأخؼهثۄأثىأۄزوۄأثىأهتغوأثىأؼخوتىأثىأؼوشًأ‛‛ۗأتىأڬۏأڬىۏحأ““أتثًۄثۏشۄأ‛‛أۄەأ؏أتثىأصۏتزأڬۏأتوتشحأوۏڽأتىأڬۏأًلتحأۄًةۏأ؏أثظشۄأوۏڽأتىأڬتأتۏڬأوطۄًشأڲہشأحہتأۗأ"
"6486","أؼتةسأثىأؼوشًأتهوصىۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدىڲأذىۏىأڬەأوًمؼأځشأوۏڽأشضًهأتههۄأ﷽أڬەأضتوىەأدىڲأوۏڽأوظشًلأحہتأ؏أتۏڬأحۏشأإأڬشأوۏشەأډۄشەأځشأهڲتأ؏أدثأرًىأثۄحتأۄًتأوۏشەأډۄشەأ؏أزتڔہۏأتًشأضۏىەأڬًأشىڲۏىأڬشأڲۏتأحًأىثۏأتڬشوأ﷽أىەأرًزأتځىەأزضحأوثتشڬأضەأوۏشتأرًىأظتلأڬۏتأتًشأوۏشەأهةەأزؼتألشوتةۏأۗأتضأذزۏخأڬەأشتًۏأذطشدألشوتحەأۄۏڽأ=أذعشحأؼتةسأتځىۏأصىزڲۏأوۏڽأۏۄأًتمؼۄأثۏتىأڬۏتأڬشحەأحہەأ؏أدثأتىأڬتأتىحمتهأۄًتأ؏أۄوأىەأتىأڬًأؽضهأزۏتأحًأتىأڬەأثحتةەأۄًةەأًتمؼۄأڬەأوغتثمأۄوأىەأتىأڬەأډۄشەأ؏أزتڔہۏأ؏أضۏىەأځشأشضًهأتههۄأ﷽أڬەأۄتحہًڽأڬتأتخشأزۏڬہتأ؏أڲہًڔەأڬۏأځۏطتىۏأځشأضلۏزۏأڬۏأغشذأتىأڬەأتؼعتؤأځشأزضحأشضًهأڬۏأثشڬحأضەأتۏڬأؼدۏثأضۏأډوڬأزڬہتحۏأزۏحۏأحہۏأۗأ"
"6487","ذعشحأشتلؼأثىأؼوشًأتهوصىۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أظرشۄأتًشأؼدًۄأدىحۏأځہهأۄۏڽأۗأ"
"6488","أؼشًۄأڬۄحەأۄۏڽأ=أتىظتشأڬەأمثۏهەأثىۏأرصشدأڬۏأدتىثأضەأشضًهأتههۄأ﷽أڬەأۄوشتۄأدىڲأثزشأوۏڽأطشۏڬأۄًىەأًتهًڽأوۏڽأذعشحأؼثزتههۄأثىأؼثزتههۄأثىأتثۏأتثىأضهًهأشعۏأتههۄأؼىۄأحہەأۗأذعشحأؼشًۄألشوتحەأۄۏڽأ=““أۏۄأؼثزتههۄأثىأؼثزتههۄأتثىأتثۏأثىأوتهڬأثىأضتهوأثىأؽىوأثىأؼًلأثىأرصشدأ‛‛أۄۏڽأۗأ"
"6489","أوظؼثأثىأؼثزتههۄأصثۏشۏألشوتحەأۄۏڽأ=أ45أۄدشۏأڬًأدىڲأۏوتوۄأوۏڽأذعشحأؼثزتههۄأثىأؼثزتههۄأتثىأتثۏأثىأضهًهأشعۏأتههۄأؼىۄأطۄۏزأۄًةەأۗأ"
"6490","أۄطتوأثىأؼشًۄأتځىەأًتهزأڬتأثۏتىأىمهأڬشحەأۄۏڽأڬۄأذعشحأؼثزتههۄأتثىأؼثزتههۄأتثىأتثۏأتثىأضهًهألشوتحەأۄۏڽأ=أوۏڽأىەأؼشعأڬۏأۏتأشضًهأتههۄأ$أڬۏتأوۏڽأتځىەأثتځأڬًأمحهأڬشأزًڽأآأحًأإځأ﷽أىەألشوتۏتأ=أحوأتځىەأثتځأڬًأمحهأىۄأڬشًأۗأ"
"6491","ہشام بن عروہ اپنے والد کا بیان نقل کرتے ہیں کہ حضرت عبداللہ بن عبداللہ ابن ابی ابن سلول رضی اللہ عنہ نے رسول اللہ ﷺ سے اپنے والد کو قتل کرنے کی اجازت مانگی تو رسول اللہ ﷺ نے ان کو اجازت نہ دی ۔ \nالمستدرك على الصحيحين حدیث: 6491 عربی حدیث: 6491"
"6492","أۄطتوأثىأؼشًۄأتځىەأًتهزأضەأشًتۏحأڬشحەأۄۏڽأڬۄأذعشحأؼثزتههۄأثىأؼثزتههۄأثىأتثۏأتثىأضهًهأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدىڲأتذزأڬەأوًمؼأځشأوۏشەأزًأزتىحأټًټأڲةەأحہەأ؏أىثۏأتڬشوأ﷽أىەأودہەألشوتۏتأڬۄأحوأۏۄأزًأزتىحأضًىەأڬەأهڲًتأهًأۗأ"
"6493","أتثىأتضذتمأىەأذعشحأؼثزتههۄأثىأؼثزتههۄأثىأتثۏأتثىأضهًهأشعۏأتههۄأؼىۄأڬەأحسڬشۄأڬەأزًشتىأثۏتىأڬۏتأۄەأڬۄأ““أضهًهأ‛‛أتۏڬأؼًشحأڬتأىتوأۄەأۏۄأ““أتثۏأ‛‛أڬۏأوتڽأۄەأۗأًۄأثىًأتهذثهۏٳأۄۏڽأۗأ"
"6494","أتثىأتضذتمأڬۄحەأۄۏڽأ=أتًشأىؼوتىأثىأمًمهأ؏أمًمهأڬتأىتوأ““أوتهڬأثىأخؼهثۄأثىأزؼزأثىألۄوأثىأخؼهثۄأثىأؽتىوأثىأضتهوأثىأؼًلأثىأؼوشًأثىأؼًلأثىأرصشدأ‛‛أۄەأۗأتًشأمًتمهأ؏أذعشحأؼثتزۄأثىأظتوحأڬۏأدوتؼحأۄەأۗأ"
"6495","حضرت عروہ فرماتے ہیں : انصار کی جانب سے جنگ بدر میں شریک ہونے والوں میں ’’ حضرت نعمان بن مالک بن ثعلبہ بن اصرم ‘‘ بھی ہیں ۔ یہی وہ صحابی ہیں جن کو قوقل کہا جاتا ہے ، حضرت جابر بن عبداللہ رضی اللہ عنہ نے حضرت نعمان بن قوقل رضی اللہ عنہ سے حدیث روایت کی ہے ۔ \nالمستدرك على الصحيحين حدیث: 6495 عربی حدیث: 6495"
"6496","أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄأ؏أذعشحأىؼوتىأثىأمًمهأشعۏأتههۄأؼىۄأضەأشًتۏحأڬشحەأۄۏڽأڬۄأًۄأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًةەأ؏أتًشأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أتڲشأوۏڽأظشلألشعأىوتصۏڽأتزتأڬشًڽأ؏أشوعتىأڬەأشًصەأشڬہًڽأ؏أذهتهأڬًأذهتهأضودہًڽأتًشأذشتوأڬًأذشتوأضودہًڽأ؏أتضأضەأصۏتزۄأڬًةۏأؼوهأىۄأڬشًڽأ؏أڬۏتأتضأثىتؤأځشأوۏڽأدىحأوۏڽأدتأضڬحتأۄًڽأآأشضًهأتههۄأ﷽أىەألشوتۏتأ=أدۏأۄتڽأۗأتىۄًڽأىەأڬۄتأ=أتههۄأڬۏأمضوأ$أوۏڽأتضأځشأڬًةۏأډۏصأصۏتزۄأىۄۏڽأڬشًڽأڲتأۗ‛‛أ"
"6497","أذعشحأؼشًۄأىەأتىظتشأڬۏأدتىثأضەأدىڲأثزشأوۏڽأطشۏڬأۄًىەأًتهًڽأوۏڽأذعشحأؼحثتىأثىأوتهڬأشعۏأتههۄأؼىۄأڬتأىتوأثہۏأطوتشأڬۏتأۄەأ؏أإځألشوتحەأۄۏڽأ=أوۏشۏأإىڬہأوۏڽأڬًةۏأډۏصأهڲأڲةۏأحہۏأ؏أوۏڽأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأۗأتضأڬەأثؼزأځًشۏأذزۏخأثۏتىأڬۏأۗأ"
"6498","أؼهۏأثىأصۏزألشوتحەأۄۏڽأ=أۄوأذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأڬەأځتضأوًدًزأحہەأ؏أتىۄًڽأىەأتځىەأثۏټەأضەأڬۄتأ=أ"
"6499","أذعشحأؼشًۄأىەأتىظتشأڬۏأدتىثأضەأدىڲأثزشأوۏڽأطشۏڬأۄًىەأًتهًڽأوۏڽأ““أصۏتزأثىأهثۏزأثىأخؼهثۄأثىأضىتىأثىأؼتوشأثىأؼزۏأثىأتوۏۄأثىأثۏتعۄأثىأؼتوشأثىأصشۏىأ‛‛أڬتأثہۏأسڬشأڬۏتأۄەأۗأتىأڬۏأًتهزۄأ““أؼثزأوعشثأثىأذتشخأثىأصۏزأثىأؼثۏزأثىأؼوشًأثىأؼًلأ‛‛أڬۏأثۏټۏأۄۏڽأۗأذعشحأوؼتًۏۄأڬۏأرهتلحأڬەأتًتةهأوۏڽأتىأڬتأتىحمتهأۄًتأۗأ"
"6500","%أذعشحأصۏتزأثىأهثۏزأتىظتشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىثۏأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأ؏أإځأ﷽أتځىەأظذتثۄأڬشتوأڬەأۄوشتۄأوذًأڲلحڲًأحہەأ؏أإځألشوتأشۄەأحہەأ““أؼهوأڬتأًمحأڲصشأډڬتأۄەأ‛‛أوۏڽأىەأؼشعأڬۏأ=أوۏشەأوتڽأثتځأإځأځشأمشثتىأۄًأدتةۏڽأ؏أؼهوأڬتأًمحأڬۏضەأڲصشأڲۏتأۄەأآأذتهتىڬۄأۄوأرًزأمشإىأځڔہحەأۄۏڽأ؏أتځىەأثډًڽأڬًأتضأڬۏأحؼهۏوأزۏحەأۄۏڽأ؏أتًشأۄوتشەأثډەأتځىەأثډًڽأڬًأحؼهۏوأزۏڽأڲەأ؏أتًشأۏۄأضهضهۄأمۏتوحأحڬأډهحتأشۄەأڲتأ؏أإځأ﷽أىەألشوتۏتأ=أتەأتثىأهثۏزأ$أحۏشۏأوتڽأحدہەأشًةەأ؏أوۏڽأحًأحدہەأځًشەأوزۏىەأوۏڽأضثأضەأصۏتزۄأضودہزتشأضودہحتأحہتأ؏أڬۏتأۏۄًزأًأىظتشۏٳأحًشتحأتًشأتىدۏهأىۄۏڽأځڔہتأڬشحەأحہەأآأهۏڬىأتىۄۏڽأتضأډۏصأىەأڬًةۏألتةزۄأىۄۏڽأزۏتأۗ"
"6501","حضرت عروہ فرماتے ہیں : انصار میں سے پھر بنی مالک بن نجار کی جانب سے عمارہ بن حزم بن زید ، بن لوذان بن عمرو بن عبدعوف بن غانم بن مالک بن نجار نے جنگ بدر اور بیعت عقبہ میں شرکت کی ۔ اور آپ جنگ یمامہ میں شہید ہوئے ۔ \nالمستدرك على الصحيحين حدیث: 6501 عربی حدیث: 6501"
"6502","أصۏتزأثىأىؼۏوأذعشوۏأشًتۏحأڬشحەأۄۏڽأڬۄأذعشحأؼوتشۄأثىأذصوأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أشضًهأتههۄأ﷽أىەأودہەأمثشأځشأثۏټہەأزۏڬہتأحًألشوتۏتأ=أمثشأضەأىۏډەأتحشًأۗأىۄأحوأظتذثأمثشأڬًأحڬهۏلأزًأ؏أىۄأظتذثأمثشأحدہەأحڬهۏلأزەأۗأ"
"6503","أرهۏلۄأثىأرۏتغأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أۏصۏزأثىأختثحأثىأعذتڬأثىأصۏزأثىأهًصتىأثىأؼوشًأثىأؼًلأثىأؽتىوأثىأوتهڬأثىأىدتشأ‛‛ۗأتىأڬۏأًتهزۄأتًشأتىأڬەأثہۏأصۏزأثىأختثحأڬۏأًتهزۄأ““أىًتشأثىحأوتهڬأثىأؼتوشأثىأؼزۏأثىأىدتشأ‛‛أۄۏڽأۗأإځأدىڲأثزشأوۏڽأطشۏڬأۄًةەأتًشأدىڲأۏوتوۄأوۏڽأطۄۏزأۄًةەأۗأ"
"6504","خارجہ بن زید بن ثابت اپنے چچا یزید بن ثابت کے بارے میں فرماتے ہیں : کہ وہ رسول اللہ ﷺ اور صحابہ کرام کے ہمراہ تھے ، کہ ایک جنازہ آ گیا ، رسول اللہ ﷺ نے جب جنازہ آتے دیکھا تو آپ اٹھ کر کھڑے ہو گئے ، جب تک وہ جنازہ دور تک نہیں چلا گیا ، آپ اور سب لوگ کھڑے رہے ، ( راوی کہتے ہیں ) میرا خیال ہے کہ وہ کسی یہودی کا جنازہ تھا ۔ \nالمستدرك على الصحيحين حدیث: 6504 عربی حدیث: 6504"
"6505","أرتشدۄأثىأصۏزأثىأختثحأتځىەأډډتأۏصۏزأثىأختثحأشعۏأتههۄأؼىۄأڬەأثتشەأوۏڽأثۏتىأڬشحەأۄۏڽأڬۄأتۏڬأزىأًۄأشضًهأتههۄأ﷽أڬەأۄوشتۄأتۏڬأدىتصۄأوۏڽأطشۏڬأۄًىەأڬەأهةەأىڬهەأ؏أۏۄأهًڲأدىحأتهثمۏؼأحڬأځۄىډەأ؏أشضًهأتههۄأ﷽أىەأوۏحأڬەأثتشەأوۏڽأزشۏتلحأڬۏتأڬۄأۏۄأڬًىأۄەأآأإځأ﷽أڬًأثحتۏتأڲۏتأڬۄأۏۄأتۏڬأرتحًىأڬتأدىتصۄأۄەأدًأڬۄأثىۏألهتڽأڬۏأإصتزأڬشزۄأهًىڋۏأۄەأ؏أشضًهأتههۄأ﷽أځۄډتىأڲةەأ؏أإځأ﷽أىەألشوتۏتأ=أحوأهًڲًڽأىەأودہەأتغهتؼأڬۏًڽأىۄۏڽأزۏأحہۏأآأظذتثۄأڬشتوأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أۄوأىەأتضأڬًأػۄشأڬەأثؼزأزلىأڬۏتأ؏أتضأًمحأإځأإشتوألشوتأۄًحەأۄۏڽأ؏أۄوۏڽأتډہتأىۄۏڽأهڲتأڬۄأإځأڬەأإشتوأوۏڽأرههأڋتهتأدتةەأ؏أشضًهأتههۄأ﷽أتضأرتحًىأڬۏأمثشأڬەأځتضأڬہڔەأۄًةەأ؏أظذتثۄأڬشتوأإځأ﷽أڬەأځۏډہەأڬہڔەأۄًةەأ؏أتًشأإځأ﷽أىەأىوتصأدىتصۄأځڔہۏأ؏أځہشألشوتۏتأ=أڬًةۏأثہۏأطرظألًحأۄًأ؏أودہەأعشًشأثحتۏتأڬشًأ؏أڬۏًىڬۄأوۏڽأتضأڬتأدىتصۄأځڔہًڽأڲتأحًأۏۄأتضأڬەأهةەأثتؼخأشذوحأۄەأۗأ"
"6506","أوظؼثأثىأؼثزتههۄأصثۏشۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أثضشأثىأتثۏأتشغتۆأثىأؼوۏشأثىأؼوشًأثىأؼًۏوشأثىأؼوشتىأثىأتهذهثضأثىأضۏتشأثىأىصتشأثىأوؼۏظأثىأؼتوشأثىأهاۏأ‛‛ۗأ"
"6507","أرهۏلۄأثىأرۏتغألشوتحەأۄۏڽأ=أذعشحأثضشأثىأتثۏأتشغتۆأشعۏأتههۄأؼىۄأ؏أذعشحأوؼتًۏۄأڬۏأرهتلحأوۏڽألًحأۄًةەأ؏أثۄحأصۏتزۄأؼوشأشضۏزۄأۄًىەأڬۏأًدۄأضەأتىأڬۏأؼمهأوۏڽأڬډہأرههأًتمؼأۄًأڲۏتأحہتأۗأتىأڬۏأڬىۏحأ““أتثًؼثزتهشذوىأ‛‛أحہۏأوزۏىۄأوىًشۄأوۏڽأتىأڬتأتىحمتهأۄًتأ؏أتىأڬۏأتًهتزأتودتزأثظشۄأوۏڽأمۏتوأځسۏشأۄۏڽأۗأ"
"6508","حضرت بسر بن ابی ارطاۃ رضی اللہ عنہ فرماتے ہیں کہ نبی اکرم ﷺ یوں دعا مانگا کرتے تھے ’’ یا اللہ تمام امور میں ہماری عاقبت بہتر فرما اور ہمیں دنیا کی ذلت اور آخرت کے عذاب سے بچا ۔‘‘ \nالمستدرك على الصحيحين حدیث: 6508 عربی حدیث: 6508"
"6509","أوظؼثأثىأؼثزتههۄأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأ““أوضحًشزأثىأطزتزأثىأؼوشًأثىأذضهأثىأتذثأثىأذثۏثأثىأؼوشًأثىأطۏثتىأثىأوذتشثأثىألۄشأثىأوتهڬأ‛‛ۗأذعشحأوؼتًۏۄأڬەأزًشأذڬًوحأوۏڽأ؏أوظشأوۏڽأتىأڬتأتىحمتهأۄًتأۗأ"
"6510","أتثًتضذتمأۄوزتىۏأشًتۏحأڬشحەأۄۏڽأ؏أذعشحأوضحًشزأثىأطزتزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أإرشحأڬەأومتثهەأوۏڽأزىۏتأڬۏأوختهأتۏضەأۄۏأۄەأدۏضەأڬًةۏأطرظأتځىۏأتىڲهۏأ+أضوىزشأوۏڽأ"
"6511","أوؼوشأثىأوخىۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أرلتلأثىأتۏوتؤأثىأشذعۄأثىأذشثۄأثىأرلتلأثىأذتشخۄأثىأؽلتشأ‛‛أتىأڬەأًتهزأتۏوتؤأثىأشذعۄأثہۏأتضهتوأهتةەأحہەأ؏أۏۄأتځىۏأمًوأڬەأمتةزۏىأوۏڽأضەأحہەأ؏أذعشحأرلتلأشعۏأتههۄأؼىۄأشضًهأتههۄأ﷽أڬەأۄوشتۄأذزۏثۏۄأوۏڽأطشۏڬأۄًةەأحہەأۗأ"
"6512","أذعشحأتثًسشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأتځىەأمثۏهەأؽلتشأوۏڽأإةەأ؏أتىأوۏڽأضەأڬډہأهًڲأشضًهأتههۄأ﷽أڬەأوزۏىۄأوىًشۄأإىەأضەأځۄهەأوطشلأثتأتضهتوأۄًأڲةەأحہەأ؏أذعشحأتۏوتؤأثىأشذعۄأشعۏأتههۄأؼىۄأتىأڬۏأتوتوحأڬشًتۏتأڬشحەأحہەأۗأتًشأًۄأتىأڬەأضشزتشأثہۏأحہەأۗأ"
"6513","أذعشحأرلتلأثىأتۏوتؤأثىأشذعۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأىوتصألدشأوۏڽأۏًڽأزؼتأوتىڲۏأ““أتەأتههۄأثىۏأهذۏتىأ؏أشؼهأ؏أسڬًتىأتًشأؼظۏۄأځشأهؼىحألشوتأ؏أڬۏًىڬۄأتىۄًڽأىەأتههۄأتًشأتضأڬەأشضًهأڬۏأىتلشوتىۏأڬۏأۄەأۗأتًشأتههۄأحؼتهۏٳأؽلتشأمثۏهەأڬۏأوؽلشحألشوتةەأۗأتًشأتههۄأحؼتهۏٳأمثۏهۄأتضهوأڬًأضهتوحأشڬہەأۗ‛‛أ"
"6514","أڬةۏأظذتثۄأڬشتوأىەأذعشحأتثًثظشۄأشعۏأتههۄأؼىۄأضەأشًتۏحأڬۏتأۄەأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتههۄأحثتشڬأًأحؼتهۏٳأىەأحوۄتشەأهةەأتۏڬأتًشأىوتصأڬتأتعتلۄأڬۏتأۄەأ؏أحوأًۄأىوتصأؼطتؤأتًشألدشأڬەأزشوۏتىأځڔہتأڬشًأ؏أتًشأًۄأىوتصأۄەأ““أًحشأ‛‛ۗأذعشحأتثًثظشۄأ““أؽلتشۏأ‛‛أۄۏڽأۗأتثًحوۏوأڬۄحەأۄۏڽأ=أوۏڽأتًشأتثًسشأشعۏأتههۄأؼىۄأزًىًڽأثۏټہەأۄًةەأحہەأ؏أذعشحأتثًسشأشعۏأتههۄأؼىۄأىەأوۏشتأۄتحہأځڬڔتأتًشأودہەأتثًثظشۄأشعۏأتههۄأؼىۄأڬەأځتضأهەأڲةەأ؏أزتشأؼوشًأڬەأمشۏثأزشًتصەأځشأۄۏأۄوتشۏأتىأڬەأضتحہأوهتمتحأۄًأڲةۏأۗأذعشحأتثًسشأشعۏأتههۄأؼىۄأىەأتىأضەأڬۄتأ=أتەأتثًثظشۄأشعۏأتههۄأؼىۄأڬۏتأحوأىەأشضًهأتههۄأ﷽أڬًأۏۄألشوتحەأۄًةەأضىتأۄەأڬۄأ““أتههۄأحثتشڬأًأحؼتهۏٳأىەأحوۄتشەأهةەأتۏڬأتًشأىوتصأڬتأتعتلۄأڬۏتأۄەأ؏أتضأڬًأحوأؼطتؤأتًشألدشأڬۏأىوتصأڬەأزشوۏتىأ+أڬضۏأثہۏأًمحأ"
"6515","أذعشحأثظشۄأثىأتثۏأثظشۄأؽلتشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأتۏڬأڬىًتشۏأهڔڬۏأضەأطتزۏأڬۏأ؏أهۏڬىأثؼزأوۏڽأځحتأډهتأڬۄأًۄأحًأطتزۏأضەأځۄهەأۄۏأذتوهۄأحہۏأۗأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أهڔڬتأحوۄتشتأؽهتوأۄًأڲتأۗأدثأۏۄأؼًشحأثډۄأدىەأحًأتضأڬًأ433أڬًڔەأوتشًأ؏أتًشأتضأڬًأتضۏأومزتشأوۏڽأوۄشأزۏتأدتةەأدضأمزشأتضأڬەأضتحہأضهضهۄأتصزًتدأشۄتأۗأ"
"6516","أرهۏلۄأثىأرۏتغألشوتحەأۄۏڽأ=أتثًشۄوأشعۏأتههۄأؼىۄأڬتأىتوأ““أڬهخًوأثىأذظۏىأثىأؼثۏزأثىأرتهزأثىأوؼۏضۏشأثىأثزشأثىأتذوضأثىأؽلتشأ‛‛أۄەأۗأثؼعأواشرۏىأڬتأڬۄىتأۄەأڬۄأتىأڬتأىتوأ““أڬهخًوأثىأذظۏىأثىأؼثۏزأثىأرتهزأ‛‛أۄەأۗأدثأشضًهأتههۄأ﷽ألحذأوڬۄأڬەأهةەأشًتىۄأۄًةەأحًأتىأڬًأوزۏىۄأوىًشۄأوۏڽأىتةثأومششألشوتۏتأحہتأۗأ"
"6517","أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أدثأشضًهأتههۄأ﷽ألحذأوڬۄأڬەأهةەأشًتىۄأۄًةەأحًأذعشحأتثًشۄوأڬهخًوأثىأذظۏىأؽلتشۏأشعۏأتههۄأؼىۄأڬًأوزۏىۄأوىًشۄأوۏڽأتځىتأىتةثأثىتۏتأۗأ"
"6518","أتثًشۄوأڬەأثہحۏدەأثۏتىأڬشحەأۄۏڽأڬۄأذعشحأتثًشۄوأڬهخًوأثىأذظۏىأشضًهأتههۄأ﷽أڬەأتىأظذتثۄأوۏڽأضەأۄۏڽأدىۄًڽأىەأزشرحأڬەأىۏډەأشضًهأتههۄأ﷽أڬەأۄتحہأځشأثۏؼحأڬۏأحہۏأ؏أتىۄًڽأىەأودہەأثحتۏتأۄەأڬۄأوۏڽأشضًهأتههۄأ﷽أڬەأۄوشتۄأؽصًۄأحثًڬأوۏڽأطشۏڬأحہتأ؏أتۏڬأشتحأۄوأىەأضلشأڬۏتأ؏أتضأشتحأوۏڽأشضًهأتههۄأ﷽أڬەأثۄحأصۏتزۄأمشۏثأحہتأ؏أإرشأطثأوۏڽأۄوۏڽأىۏىزأإأڲةۏأ؏أوۏڽأهًڲًڽأڬًأتټہتىتأطشًؼأۄًأڲۏتأ؏أوۏشۏأضًتشۏأشضًهأتههۄأ﷽أڬۏأضًتشۏأڬەأمشۏثأحہۏأ؏أوۏڽأتځىۏأضًتشۏأڬًأإځأ﷽أضەأځۏډہەأشڬہىەأڬۏأڬًططأڬشأشۄتأحہتأ؏أذحۏٳأڬۄأشتۄأډهحەأۄًةەأشتحأڬەأڬضۏأځۄشأوۏڽأودہەأثہۏأىۏىزأإأڲةۏأ؏أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أودہەأضثأضەأصۏتزۄأتضأثتحأڬۏأحڬهۏلأۄەأڬۄأمشۏطأڬەأڬډہأوۄتدشۏىأتًشأتىظتشأتًشأتضهوأتًشأؽلتشأمثۏهۄأڬەأڬډہأهًڲأځۏډہەأشۄأڲةەأۄۏڽأۗأ"
"6519","أوظؼثأثىأؼثزتههۄأصثۏشۏأتىأڬتأىضثأۏًڽأثۏتىأڬشحەأۄۏڽأ=أذسۏلۄأثىأتضۏزأثىأتؽًضأثىأًتمؼۄأثىأذشتوأثىأؽلتشأ‛‛أثؼعأواشرۏىأڬتأڬۄىتأۄەأڬۄأإځأ““أتضۏزأثىأرتهزأثىأتؽًصأ‛‛أڬەأثۏټەأۄۏڽأۗأتىأڬۏأڬىۏحأ““أتثًضشۏذۄأ‛‛أحہۏأ؏أإځأوزۏىۄأوىًشۄأضەأڬًلۄأطشۏلأوۏڽأوىحمهأۄًأڲةەأحہەأۗأًۄۏڽأځشأتىأڬتأتىحمتهأۄًتأۗأ"
"6520","أذعشحأذسۏلۄأثىأتضۏزأؽلتشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتۏڬأتۏضۏأۄًتأډهەأڲۏأ؏أدضأڬەأډهىەأضەأحوتوأوًوىۏىألًحأۄًأدتةۏڽأڲەأ؏أځہشأضًشدأوؽشثأڬۏأدتىثأضەأغهًؼأۄًأڲتأ؏أۏۄأًۄۏأىطتىۏأۄەأدضأڬتأسڬشأتههۄأحؼتهۏٳأىەأتځىۏأڬحتثأوۏڽأڬۏتأۗأتضأڬەأثؼزأځًشۏأذزۏخأثۏتىأڬۏأۗأ"
"6521","أذعشحأذسۏلۄأثىأتضۏزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أزًأډحڬثشەأوۏىڋہًڽأڬۏأمشثتىۏأڬۏتأڬشحەأحہەأ؏أتۏڬأڬًأسثذأڬشحەأۄًةەألشوتحەأ=أتەأتههۄأ$أۏۄأوذوزأتًشأإهأوذوزأڬۏأغشلأضەأۄەأ؏أتًشأزًضشەأڬًأسثذأڬشحەأۄًةەألشوتحەأ=أۏتأتههۄأ$أۏۄأوۏشۏأتوحأڬۏأدتىثأضەأۄەأ؏أدًأحۏشۏأحًذۏزأڬًأوتىحۏأۄەأۗأتًشأوۏشەأسوەأحًأظشلأحۏشتأځۏؽتوأځۄىډتأزۏىتأۄەأۗأ"
"6522","أوظؼثأثىأؼثزتههۄأصثۏشۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أؼحتثأثىأتضۏزأثىأتثۏأتهؼۏظأثىأتوۏۄأثىأؼثزطوضأثىأؼثزأوىتلأ‛‛ۗأؼحتثأثىأتضۏزأشعۏأتههۄأؼىۄأتًشأرتهزأثىأتضۏزأڬۏأًتهزۄأ““أصۏىحأثىحأتثًؼوشًأثىأتوۏۄأثىأؼثزطوضأ‛‛أۄۏڽأۗأشضًهأتههۄأ﷽أىەأذعشحأؼحتثأشعۏأتههۄأؼىۄأڬًأوڬۄأڬتأؼتوهأثىتۏتأحہتأۗأشضًهأتههۄأ﷽أڬەأًظتهأوثتشڬأڬەأوًمؼأځشأثہۏأإځأۄۏأوڬۄأڬەأؼتوهأحہەأۗأذعشحأؼحتثأثىأتضۏزأشعۏأتههۄأؼىۄأ46أضىأۄدشۏأڬًأوتۄأدوتزۏأتهتًهۏٳأوۏڽأوڬۄأوۏڽألًحأۄًةەأۗأ"
"6523","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أؽصًۄألحذأوڬۄأڬەأوًمؼأځشأدثأشضًهأتههۄأ﷽أوڬۄأڬەأثتهڬهأمشۏثأځۄىډأډڬەأحہەأ؏ألشوتۏتأ=أوڬۄأوۏڽأډتشأمشۏطۏأإزوۏأۄۏڽأ؏أتىأڬً"
"6524","أؼوشًأثىأتثۏأؼمشثألشوتحەأۄۏڽأ=أؼحتثأثىأتضۏزأشعۏأتههۄأؼىۄأثۏحأتههۄأڬۏأزۏًتشأڬەأضتحہأټۏڬأهڲتةەأثۏټہەألشوتأشۄەأحہەأ=أرزتأڬۏأمضوأ$أشضًهأتههۄأ﷽أىەأودہەأۏۄتڽأڬتأؼتوهأثىتۏتأۄەأ؏أتضأؼوهأڬۏأثزًهحأظشلأۏۄأزًأڬځڔەأودہەأوهەأۄۏڽأ؏أًۄأثہۏأوۏڽأىەأتځىەأزًأؽهتوًڽأڬًأځۄىىەأڬەأهةەأزەأزۏةەأۄۏڽأۗأ"
"6525","أذعشحأؼحتثأثىأتضۏزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتىڲًشًڽأڬەأڲډہًڽأڬۏأصڬتۆأڬۏأثتثحألشوتۏتأ=أدۏضەأڬہدًشأڬەأزشرحأهڲتةەأدتحەأۄۏڽأتضۏأغشذأتضأڬًأثہۏأهڲتۏتأدتحتأۄەأ؏أځہشأدضأغشذأڬہدًشأڬەأزشرحأڬۏأصڬتۆأتضأڬۏأڬہدًشًڽأڬەأسشۏؼەأزۏأدتحۏأۄەأتضۏأغشذأتىڲًشًڽأڬۏأثۏهأڬۏأصڬتۆأتىڲًشًڽأڬەأسشۏؼەأزۏأدتةەأڲۏأۗأ"
"6526","أرهۏلۄأثىأرۏتغأڬۄحەأۄۏڽأ=أثىۏأۄتطوأڬەأذهۏلًڽأوۏڽأدًأڬۄأثزشأوۏڽأطشۏڬأىۄۏڽأۄًأضڬەأ؏أذعشحأطزتزأثىأۄتزأشعۏأتههۄأؼىۄأۄۏڽأۗأإځأشضًهأتههۄأ﷽أڬەأۄوأصهلأحہەأ؏أتىأڬۏأصًدۄأڬتأىتوأضهوۏٳأثىحأؼوۏضأۄەأ؏أًۄأځۄهەأذعشحأذوصۄأثىأؼثزتهوغهثأشعۏأتههۄأؼىۄأڬەأىڬتذأوۏڽأحہۏڽأ؏أذعشحأذوصۄأڬەأثؼزأذعشحأطزتزأىەأتىأضەأىڬتذأڬۏتأحہتأۗأ+أتًشأضهوۏٳأثىحأؼوۏضأ؏أتوأتهوًوىۏىأذعشحأتوأضهوۄأڬۏأوتزشأصتزأثۄىأۄۏڽأ"
"6527","أذعشحأطزتزأثىأتهۄتزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأزۏۄتحۏأطرظأشضًهأتههۄأ﷽أځشأتۏوتىأهتۏتأتًشأإځأ﷽أڬەأۄوشتۄأۄدشحأڬۏأرًتۄطأڬتأثہۏأتػۄتشأڬۏتأۗأىثۏأتڬشوأ﷽أىەأظذتثۄأڬشتوأڬەأسوەأهڲتأزۏتأ؏أدثأؽصًۄأرۏثشأۏتأذىۏىأڬتأوًمؼأإۏتأ؏أشضًهأتههۄأ﷽أىەأظذتثۄأڬشتوأوۏڽأؽىۏوحۏڽأحمضۏوألشوتةۏڽأ؏أإځأ﷽أىەأذعشحأطزتزأڬەأهةەأتىأڬەأضتحہۏًڽأڬًأذظۄأزۏتأۗأإځأتىأهًڲًڽأڬۏأثڬشۏتڽأډشتۏتأڬشحەأحہەأ؏أدثأًۄأإةەأحًأتىأڬەأضتحہۏًڽأىەأتىأڬتأذظۄأتىأڬەأضځشزأڬۏتأ؏أتىۄًڽأىەأځًډہتأ=أۏۄأڬۏتأۄەأآأتىۄًڽأىەأثحتۏتأڬۄأشضًهأتههۄأ﷽أىەأۏۄأحوۄتشەأهةەأثہۏدتأۄەأ؏أذعشحأطزتزأشعۏأتههۄأؼىۄأىەأًۄأذظۄأًظًهأڬۏتأتًشأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأډهەأإةەأ؏أإأڬشأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أوۏڽأىەأتضأؽشعأضەأحًأإځأڬۏأثۏؼحأىۄۏڽأڬۏأ؏أځہشأًۄأ+أتځىەأذهمأڬۏأدتىثأتطتشۄأڬشحەأۄًةەأ"
"6528","أذعشحأؼشًۄأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أتضتوۄأثىأصۏزأثىأذتشخۄأثىأطشتذۏهأثىأڬؼثأثىأؼثزتهؼصۏٳأثىأۏصۏزأثىأتوشتؤأتهمۏضأڬهثۏأ‛‛أتههۄأحؼتهۏٳأتًشأتضأڬتأشضًهأتىأځشأتځىۏأىؼوحۏڽأىتصهألشوتةەأۗأتذوزأثىأۏؼمًثأىەأوًضۏٳأثىأصڬشۏتأڬەأذًتهەأضەأطثتثأڬەأًتضغەأضەأودہەأۏۄأىضثأثۏتىأڬۏتأۄەأ؏أتًشأتضأوۏڽأتضأثتحأڬتأثہۏأتعتلۄأۄەأڬۄأتىأڬۏأًتهزۄأشضًهأتههۄأ﷽أڬۏأإصتزأطزۄأثتىزۏأذعشحأتوأتۏوىأحہۏڽأۗأذعشحأتضتوۄأشعۏأتههۄأؼىۄأ93أثشضأڬۏأؼوشأوۏڽأذعشحأوؼتًۏۄأشعۏأتههۄأؼىۄأڬۏأذڬًوحأڬەأتًترشأوۏڽأوزۏىۄأوىًشۄأوۏڽألًحأۄًةەأۗأتىأڬۏأڬىۏحأ““أتثًوذوزأ‛‛أحہۏأۗأ"
"6529","أذعشحأتضتوۄأثىأصۏزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أودہەأځًشەأڲہشأوۏڽأضثأضەأصۏتزۄأځۏتشأتضأطرظأڬەأضتحہأۄەأدضأځشأوۏڽأىەأتًشأتههۄأحؼتهۏٳأىەأتىؼتوألشوتۏتأۄەأتًشأًۄأ““أتضتوۄأ‛‛أۄەأۗأ"
"6530","أذعشحأؼثزتههۄأتثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتضتوۄأودہەأضتشۏأزىۏتأضەأصۏتزۄأؼصۏصأۄەأۗأ"
"6531","أوذوزأثىأضۏشۏىألشوتحەأۄۏڽأ=أذعشحأؼخوتىأثىأؼلتىأشعۏأتههۄأؼىۄأڬەأصوتىەأوۏڽأڬہدًشأڬەأزشرحأڬۏأمۏوحأتۏڬأۄصتشأزشۄوأحڬأځۄىډأڲةۏأحہۏأ؏أذعشحأتضتوۄأثىأصۏزأىەأتۏڬأزشرحأتڬہتڔتأ؏أتضأڬۏأڲًىزأىڬتهأڬشأتځىۏأًتهزۄأڬًأڬہهتةۏأ؏أذعشحأؼخوتىأىەأتىأضەأځًډہتأڬۄأحوأىەأۏۄأزشرحأڬۏًڽأتڬہۏڔتأآأدثڬۄأحوأدتىحەأثہۏأۄًأڬۄأتضأڬۏأمۏوحأتۏڬأۄصتشأزشۄوأحڬأۄەأۗأتىۄًڽأىەأڬۄتأ=أوۏشۏأًتهزۄأىەأودہەأڬۄتأحہتأ؏أتًشأوۏشۏأًتهزۄأودہأضەأدًألشوتةطأڬشەأتڲشأًۄأډۏصأوۏشۏأتضحغتؼحأوۏڽأۄًأحًأوۏڽأتىأڬًأعشًشأزۏحتأۄًڽأۗأ"
"6532","أتثًثڬشأثىأطؼۏثأثىأذثذتثأتځىەأطۏًرأڬەأذًتهەأضەأثۏتىأڬشحەأۄۏڽأڬۄأذعشحأتضتوۄأثىأصۏزأشعۏأتههۄأؼىۄأڬۏأتىڲًټہۏأځشأۏۄأؼثتشحأڬىزۄأحہۏأ““أذثأشضًهأتههۄأ﷽أ‛‛أ+أۏؼىۏأشضًهأتههۄأ﷽أڬتأځۏتشتأ"
"6533","أصۄشۏألشوتحەأۄۏڽأ=أذعشحأتضتوۄأثىأصۏزأشعۏأتههۄأؼىۄأڬۏأًلتحأحڬأهًڲأتىأڬًأ““أتوۏشأ‛‛أڬۄۄأڬشأځڬتشحەأحہەأ؏أهًڲأڬۄحەأحہەأڬۄأتىأڬًأشضًهأتههۄأ﷽أىەأ““أتوۏشأ‛‛أومششألشوتۏتأۄەأۗأ"
"6534","أذعشحأتضتوۄأثىأصۏزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ؏أوۏزتىأؼشلتحأوۏڽأ؏أوۏڽأشضًهأتههۄأ﷽أڬەأځۏډہەأإځأ﷽أڬۏأضًتشۏأځشأثۏټہتأحہتأۗأ"
"6535","أذعشحأرهتزأثىأضتةثألشوتحەأۄۏڽأ=أوۏڽأذعشحأتضتوۄأثىأصۏزأشعۏأتههۄأؼىۄأڬەأځتضأڲۏتأ؏أتىۄًڽأىەأوۏشەأوىۄأځشأوۏشۏأحؼشۏلأڬۏأ؏أتًشألشوتۏتأ=أوۏڽأحوۄتشۏأحؼشۏلأحوۄتشەأوىۄأځشأتضأهةەأڬشأشۄتأۄًڽأڬۄأوۏڽأىەأشضًهأتههۄأ﷽أڬًألشوتحەأۄًةەأضىتأۄەأڬۄأدثأوًوىأڬەأضتوىەأتضأڬۏأحؼشۏلأڬۏأدتةەأحًأتضأڬەأزهأڬەأتىزشأتۏوتىأوۏڽأتعتلۄأۄًحتأۄەأۗأ"
"6536","أتثشتۄۏوأثىأتضذتمأذشثۏأڬۄحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬەأإصتزأڬشزۄأؽهتوأذعشحأتثًشتلؼأ؏أذعشحأؼثتضأثىأؼثزتهوغهثأڬەأؽهتوأحہەأ؏أدثأذعشحأؼثتضأشعۏأتههۄأؼىۄأتضهتوأهتةەأحًأتىۄًڽأىەأۏۄأؽهتوأشضًهأتههۄأ﷽أڬًأحذلۄأوۏڽأزەأزۏتأ؏أتىأڬتأتظهأىتوأ““أتضهوأ‛‛أۄەأۗأثؼعأواشرۏىأڬتأڬۄىتأۄەأڬۄأتىأڬتأىتوأ““أتثشتۄۏوأ‛‛أۄەأۗأإځأدىڲأثزشأضەأځۄهەأتضهتوأهتةەأحہەأ؏أهۏڬىأذعشحأؼثتضأشعۏأتههۄأؼىۄأڬەأۄوشتۄأوڬۄأطشۏلأوۏڽأۄۏأومۏوأحہەأ؏أذعشحأؼخوتىأڬۏأطۄتزحأڬەأثؼزأضىأ68أۄدشۏأوۏڽأتىأڬتأتىحمتهأۄًتأۗأ"
"6537","أذعشحأتثًشتلؼأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأذعشحأؼهۏأشعۏأتههۄأؼىۄأڬًأۏوىأڬۏأدتىثأشًتىۄألشوتۏتأتًشأؼهوأثہۏأتىأڬًأؼغتألشوتۏتأۗأدثأإځأشًتىۄأۄًةەأحًأ+أودہەأ"
"6538","أذعشحأتثًشتلؼأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأمشۏطأڬتأتۏڬأرغأهەأڬشأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأ؏أإځألشوتحەأۄۏڽأ=أدثأوۏڽأىەأًۄأرغأشضًهأتههۄأ﷽أڬەأضځشزأڬشأزۏتأحًأوۏشەأزهأوۏڽأتضهتوأڬۏأوذثحأځۏزتأۄًأڲةۏأ؏أوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أ؏أوۏڽأڬثہۏأثہۏأتىأهًڲًڽأڬۏأغشلأهًټأڬشأىۄۏڽأدتاڽأڲتأۗأشضًهأتههۄأ﷽أىەألشوتۏتأ=أوۏڽأًؼزۄأرهتلۏأىۄۏڽأڬشأضڬحتأتًشأڬضۏأڬەأضلۏشأڬًأتځىەأځتضأىۄۏڽأشًڬأضڬحتأ؏أتضأهةەأحوأًتځضأتىأهًڲًڽأوۏڽأدتاأ؏أتڲشأًۄتڽأدتأڬشأثہۏأحوۄتشەأدسثتحأۏۄۏأشۄەأحًأهًټأإىتأ؏أإځألشوتحەأۄۏڽأ=أوۏڽأتځىۏأمًوأوۏڽأهًټأڬشأڲۏتأ؏أتضأڬەأثؼزأزًثتشۄأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًأڬشأوطشلأثتأتضهتوأۄًأڲۏتأۗأ"
"6539","أوظؼثأثىأؼثزتههۄألشوتحەأۄۏڽأ=أذعشحأضهوتىألتشضۏأشعۏأتههۄأؼىۄأڬۏأڬىۏحأ““أتثًؼثزتههۄأ‛‛أۄەأۗأتىأڬۏأًهتؤأشضًهأتههۄأ﷽أڬەأهةەأحہۏأ؏أشضًهأتههۄأ﷽أىەأتىأڬەأثتشەأوۏڽألشوتۏتأحہتأ““أضهوتىأوۏشەأڲہشأڬتأۄۏأتۏڬألشزأۄەأ‛‛ۗأ"
"6540","أطۄتثأڬۄحەأۄۏڽأ=أذعشحأضهوتىألتشضۏأشعۏأتههۄأؼىۄأڬتأتىحمتهأ6:أۄدشۏأڬًأۄًتأۗأ"
"6541","أڬخۏشأثىأؼثزتههۄأتهوصىۏأتځىەأًتهزأضەأ؏أًۄأتىأڬەأزتزتأضەأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأدىڲأتذصتثأڬەأوًمؼأځشأرىزمأڬہًزىەأڬەأهةەأىطتىأهڲتۏتأ؏أۏۄأىطتىأومتوأوستذدأحڬأځۄىډتأ؏أځہشأإځأ﷽أىەأۄشأإزوۏأڬًأ73أڲصأرىزمأڬہًزىەأڬتأڬتوأضځشزأڬۏتأ؏أ+أتضأوًمؼأځشأودہەأتځىەأضتحہأطتوهأڬشىەأڬەأضهضهۄأوۏڽأتىظتشأًأوۄتدشۏىأڬتأإځضأوۏڽأترحهتلأۄًأڲۏتأ"
"6542","أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحأضهوتىألتشضۏأشعۏأتههۄأؼىۄأ؏أذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأڬەأځتضأڲةەأ؏أتضأًمحأذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأحڬۏەأڬەأضتحہأټۏڬأهڲتةەأۄًةەأحہەأۗأذعشحأؼوشأشعۏأتههۄأؼىۄأىەأًۄأحڬۏۄأذعشحأضهوتىأشعۏأتههۄأؼىۄأڬًأځۏطأڬشأزۏتأۗأذعشحأضهوتىأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أتههۄأتًشأتضأڬەأشضًهأىەأضډألشوتۏتأۗأذعشحأؼوشأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أتەأتثًؼثزتههۄأ$أإځأودہەأڬًةۏأذزۏخأضىتةۏەأۗأتىۄًڽأىەألشوتۏتأ=أوۏڽأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأ؏أشضًهأتههۄأ﷽أحڬۏەأځشأټۏڬأهڲتةەأۄًةەأحہەأ؏أإځأ﷽أىەأًۄأحڬۏۄأودہەأزۏتأتًشألشوتۏتأ=أتەأضهوتىأ$أدثأڬًةۏأوضهوتىأتځىەأوضهوتىأثہتةۏأڬەأځتضأدتةەأتًشأوۏصثتىأتځىەأوۄوتىأڬەأتذحشتوأوۏڽأتضأڬًأحڬۏۄأځۏطأڬشەأ؏أتههۄأحؼتهۏٳأتضأڬۏأوؽلشحألشوتأزۏحتأۄەأۗأ"
"6543","%أذعشحأضوتڬأثىأذشثأشعۏأتههۄأؼىۄأ؏أذعشحأصۏزأثىأظًذتىأشعۏأتههۄأؼىۄأڬەأثتشەأوۏڽأثحتحەأۄۏڽأڬۄأزًأڬًلۏأإزوۏأذعشحأصۏزأثىأظًذتىأشعۏأتههۄأؼىۄأڬەأزًضحأحہەأ؏أتىأحۏىًڽأىەأغەأڬۏتأڬۄأۄوأذعشحأضهوتىأشعۏأتههۄأؼىۄأڬەأځتضأدتأڬشأتىأضەأتىأڬەأمثًهأتضهتوأڬتأًتمؼۄأضىأڬشأإحەأۄۏڽأ؏أډىتىډۄأۏۄأحۏىًڽأذعشحأضهوتىأشعۏأتههۄأؼىۄأڬەأځتضأإأڲةەأ؏أذعشحأضهوتىأتىأزىًڽأوزۏىأڬەأؼتوهأ+أڲًشىشأ"
"6544","%أذعشحأضهوتىألتشضۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأمثۏهۄأ““أدۏأ‛‛أضەأحؼهمأشڬہىەأًتهتأطرظأحہتأ؏أوۏشەأؼهتمەأڬەأهًڲأدتىًشًڽأڬۏأځًدتأڬشحەأحہەأ؏أوۏڽأضودہحتأحہتأڬۄأۏۄأهًڲأذمأځشأىۄۏڽأۄۏڽأ؏أودہەأڬضۏأىەأڬۄتأ=أحوأدًأزۏىأڋہًىڋأشۄەأۄًأ؏أًۄأوؽشثأوۏڽأۄەأ؏أوۏڽأًۄتڽأضەأىڬهتأتًشأومتوأوًظهأدتأځۄىډتأ؏أوۏڽأىەأزشۏتلحأڬۏتأڬۄأتضأؼهتمەأوۏڽأضثأضەأثصشڲأحشۏىأطرظۏحأڬًىأۄەأآأودہەأڲشدەأوۏڽأشۄىەأًتهەأتۏڬأثصشڲأڬەأثتشەأوۏڽأثحتۏتأڲۏتأ؏أوۏڽأتضأڬەأځتضأډهتأإۏتأ؏أوۏڽأىەأتضأڬًأثحتۏتأڬۄأوۏڽأمثۏهۄأ““أدۏأ‛‛أضەأحؼهمأشڬہحتأۄًڽأ؏أوۏڽأإځأڬەأځتضأذظًهأؼهوأڬۏأرتغشأتًشأىۏڬأؼوهأڬۏأحشثۏحأهۏىەأإۏتأۄًڽأۗأإځأودہەأتځىۏأرزوحأوۏڽأمثًهألشوتأهۏدةەأ؏أحتڬۄأوۏڽأإځأڬۏأظذثحأضەألۏعۏتثأۄًأضڬًڽأتًشأتههۄأحؼتهۏٳأىەأإځأڬًأدىأؼهًوأًأوؼتشلأضەأىًتصتأۄەأ؏أتضأوۏڽأضەأڬډہأودہەأثہۏأضڬہتأزۏدةەأ؏أتىۄًڽأىەأذتوۏأثہشأهۏأ؏أتًشأوۏڽأتىأڬۏأظذثحأوۏڽأشۄىەأهڲأڲۏتأۗأدًأډۏصۏڽأًۄأرًزأتضحؼوتهأڬشحتأحہتأ؏أتضأىەأًۄأتطۏتؤأودہەأثہۏأتضحؼوتهأڬشًتىتأطشًؼأڬشأزۏڽأۗأًۄأضشڬۄأ؏أصۏحًىأڬتأحۏهأتًشأڲىزوأتضحؼوتهأڬشحتأحہتأ؏أوۏڽأتضأڬۏأًلتحأحڬأتضأڬۏأرزوحأوۏڽأۄۏأشۄتأ؏أدثأتضأڬۏأًلتحأڬتأًمحأمشۏثأإۏتأحًأوۏڽأتضأڬۏأډتشځتةۏأڬەأځتضأثۏټہأڬشأشًىەأهڲأڲۏتأ؏أهًڲًڽأىەأشًىەأڬۏأًدۄأځًډہۏأحًأوۏڽأىەأڬۄتأ=أوۏڽأشًحتأتضأهةەأۄًڽأڬۄأوۏڽأتځىەأًغىأضەأرۏشأڬۏأحهتطأوۏڽأىڬهتأحہتأ؏أتههۄأحؼتهۏٳأىەأودہەأإځأڬۏأظذثحأؼغتألشوتأزۏأ؏أحًأىەأودہەأثۄحأؼهوأضڬہتۏتأتًشأوۏشەأضتحہأثۄحأذضىأضهًڬأڬۏتأۄەأ؏أتثأحوۄتشۏأوًحأڬتأًمحأمشۏثأۄەأ؏أودہەأضودہأىۄۏڽأإأشۄۏأڬۄأوۏڽأڬۄتڽأدتاڽأآأتضأىەأڬۄتأ=ألهتڽأومتوأځشأتۏڬأدصۏشۄأوۏڽأوۏشتأثہتةۏأشۄحتأۄەأتًشأشتۄأذمأځشأڲتوصىأۄەأ؏أحًأتضأڬەأځتضأډهتأدتأ؏أتضأڬًأوۏشتأضهتوأڬۄىتأتًشأثحتىتأڬۄأوۏڽأىەأتضأڬەأهةەأًظۏحأڬۏأۄەأتًشأوۏڽأىەأحدہەأثہۏأًظۏحأڬۏأۄەأڬۄأحوأتضأإزوۏأڬًأتځىۏأظذثحأثتثشڬحأوۏڽأشڬہأهًأۗأتىأڬەأتىحمتهأڬەأثؼزأوۏڽأتضأإزوۏأڬەأځتضأڲۏتأ؏أوۏڽأىەأدتأڬشأتضأڬًأحوتوأوتدشتأضىتۏتأ؏أتًشأتضأڬەأثہتةۏأڬتأضهتوأثہۏأتضأحڬأځۄىډتۏتأتًشأتضأڬًأۏۄأثہۏأثحتۏتأڬۄأحوۄتشەأثہتةۏأڬتأتىحمتهأۄًأڲۏتأۄەأتًشأتضأىەأودہەأحوۄتشۏأظذثحأوۏڽأشۄىەأڬتأذڬوأزۏتأۄەأۗأتضأىەأثہۏأودہەأتځىۏأظذثحأوۏڽأمثًهأڬشأهۏتأ؏أتضأىەأودہأځشأًۄأوؼتوهتحأثہۏأدتشۏأشڬہەأدًأځۄهەأثصشڲأىەأشڬہەأحہەأتًشأڬډہأزۏڲشأتوًشأثہۏأدتشۏألشوتةەأۗأوۏڽأتضأثصشڲأڬۏأظذثحأوۏڽأثہۏأڬتلۏأؼشظۄأشۄتأ؏أځہشأتىأڬۏأًلتحأڬتأًمحأثہۏأمشۏثأإأڲۏتأ؏أوۏڽأتضأڬەأضشۄتىەأثۏټہأڬشأشًىەأهڲأڲۏتأ؏أتضأىەأوۏشەأشًىەأڬۏأًدۄأځًډہۏأحًأوۏڽأىەأڬۄتأ=أوۏڽأرۏشأڬۏأحهتطأوۏڽأڲہشأضەأىڬهتأحہتأ؏أتههۄأحؼتهۏٳأىەأودہەألهتڽأطرظأڬۏأظذثحأضەألۏعۏتثأڬۏتأ؏أتضأىەأودہەأثۄحأؼهًوأضڬہتةەأځہشأتضأڬتأتىحمتهأۄًأڲۏتأ؏أتضأىەأتځىەأتىحمتهأڬەأًمحأإځأڬۏأرزوحأوۏڽأإىەأڬتأذڬوأزۏتأحہتأ؏أتثأإځأڬۏأوًحأڬتأًمحأثہۏأمشۏثأۄەأ؏أتثأودہەأضودہأىۄۏڽأإأشۄۏأڬۄأوۏڽأڬۄتڽأدتاڽأآأتضأىەأڬۄتأ=أشًوأڬەأؼهتمەأوۏڽأوۏشتأثہتةۏأشۄحتأۄەأ؏أًۄأذمأځشأۄەأحوأتضأڬەأځتضأډهەأدتاأ؏أتضأڬًأوۏشتأضهتوأڬۄىتأ؏أحوأتضأڬۏأظذثحأوۏڽأشۄىتأڬۏًىڬۄأًۄأذمأځشأۄەأ؏أدثأتضأإزوۏأڬتأتىحمتهأۄًأڲۏتأحًأوۏڽأًۄتڽأضەأىڬهتأتًشأتضأڬەأثہتةۏأڬەأځتضأځۄىډأڲۏتأ؏أوۏڽأىەأتضأڬًأتځىۏأځًشۏأزتضحتىأضىتةۏأ؏أتًشأتضأڬەأثہتةۏأىەأتضأڬەأځتضأدتىەأڬۏأدًأًظۏحألشوتةۏأحہۏأًۄأثہۏأثحتةۏأۗأشتًۏأڬۄحەأۄۏڽأ=أتضأىەأودہەأتځىەأځتضأشڬہأهۏتأتًشأوۏشەأضتحہأًۄۏأىۏڬأوؼتوهۄأڬۏتأدًأتضأضەأځۄهەأوۏشەأضتحہأۄًحتأإأشۄتأحہتأۗأدثأتضأڬۏأوًحأڬتأًمحأمشۏثأإۏتأحًأوۏڽأتضأڬەأضشۄتىەأثۏټہأڬشأشًىەأهڲأڲۏتأ=أتضأىەأودہأضەأځًډہتأڬۄأحوأڬۏًڽأشًأشۄەأۄًأآأوۏڽأىەأتضأڬًأتځىتأځًشتأمظۄأضىتۏتأۗأوۏڽأىەأتضأضەأڬۄتأ=أتههۄأحؼتهۏٳأىەأودہەأإځأڬۏأظذثحأضەأىًتصتأحہتأحوأىەأوۏشەأضتحہأثۄحأتډہتأثشحتاأڬۏتأۗأتثأحوۄتشۏأوًحأڬتأًمحأثتهڬهأمشۏثأۄەأ؏أتثأودہەأضودہأىۄۏڽأإأشۄۏأڬۄأوۏڽأڬزہشأدتاڽأآأتضأىەأڬۄتأ=أتضأًمحأىۄأحًأڬًةۏأزۏىأوًدًزأۄەأتًشأىۄأۄۏأځًشۏأشًةەأصوۏىأځشأڬًةۏأتۏضتأطرظأوًدًزأۄەأدًأؼۏضۏٳأؼهۏۄأتهضهتوأڬۏأحؼهۏوتحأڬتأځۏشًڬتشأۄًأ؏أهۏڬىأتثأًۄأصوتىۄأثتهڬهأمشۏثأۄەأدضأوۏڽأتههۄأحؼتهۏٳأڬتأإرشۏأىثۏأػتۄشأۄًأڲتأ؏أۏتأطتۏزأًۄأحۄتوۄأڬەأؼهتمەأوۏڽأػتۄشأۄًأډڬتأۄەأتًشأحوأدضأشتضحەأځشأۄًأ؏أۏۄتڽأضەأدًأثہۏأڲصشەأتضأضەأتضأىثۏأڬەأثتشەأوۏڽأځًډہحەأشۄىتأ؏أتضأڬۏأىطتىۏأۏۄأۄەأڬۄأتضأڬەأڬىزہًڽأڬەأزشوۏتىأوۄشأىثًحأۄًأڲۏأ؏أًۄأۄزۏۄأڬۏأډۏصأڬہتأهەأڲتأهۏڬىأظزمۄأڬۏأډۏصأىۄۏڽأڬہتةەأڲتأۗأۏۄأًۄۏأىثۏأۄەأدضأڬۏأإوزأڬۏأرًطرثشۏأذعشحأؼۏضۏٳأؼهۏۄأتهضهتوأىەأزۏأحہۏأۗأدثأحدہەأتضأىثۏأڬەأوثؼًخأۄًىەأڬۏأرثشأوهأدتةەأ+أحًأحوأتضأڬەأځتضأدتأڬشأتضهتوأمثًهأڬشأهۏىتأ؏أإځألشوتحەأۄۏڽأ"
"6545","%أذعشحأضهوتىأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأشضًهأتههۄأ﷽أڬًألشوتحەأۄًةەأضىتأۄەأ=أزىۏتأ؏أوًوىأڬتأمۏزأرتىۄأۄەأتًشأڬتلشأڬۏأدىحأۄەأۗأتًشأوۏڽأىەأشضًهأتههۄأ﷽أڬًأۏۄألشوتحەأثہۏأضىتأۄەأڬۄأ““أدًأهًڲأزىۏتأوۏڽأثۄحأځۏټأثہشأڬشأڬہتحەأۄۏڽأ؏أمۏتوحأڬەأزىأًۄأضثأضەأصۏتزۄأثہًڬەأۄًڽأڲەأ‛‛"
"6546","أذعشحأضهوتىأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أ$أوۏڽأىەأحًشتحأوۏڽأځڔہتأۄەأڬۄأڬہتىەأضەأځۄهەأتًشأثؼزأوۏڽأۄتحہأزہًىەأضەأڬہتىەأوۏڽأثشڬحأۄًحۏأۄەأۗأ"
"6547","%أذعشحأؼثزتههۄأثىأضهتوأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأتههۄأحؼتهۏٳأىەأذعشحأصۏزأثىأضؼىۄأشعۏأتههۄأؼىۄأڬًأۄزتۏحأزۏىەأڬتأتشتزۄألشوتۏتأحًأذعشحأصۏزأثىأضؼىۄأشعۏأتههۄأؼىۄأىەأڬۄتأ=أوۏڽأىەأدثأوذوزأ﷽أڬۏأصۏتشحأڬۏأحًأإځأ﷽أڬەأډۄشۄأوثتشڬأځشأىثًحأڬۏأحوتوأىطتىۏتڽأزۏڬہأهۏڽأ؏أتهثحۄأزًأثتحۏڽأشۄأڲةۏأحہۏڽأ؏أًۄأوۏڽأإصوتأىۄۏڽأضڬتأحہتأ؏أتۏڬأحًأۏۄأڬۄأڬۏتأتىأڬۏأثشزثتشۏأتىأڬۏأهتؼهوۏأځشأؽتهثأۄەأآأتًشأطزحأدۄهأتىأڬەأذهوأوۏڽأتعتلۄأڬشحۏأۄەأآأډىتىډۄأوۏڽأتضأټًۄأوۏڽأشۄىەأهڲتأڬۄأڬثہۏأإځأ﷽أڬەأمشۏثأۄًىەأڬتأوًمؼأوهتأحًأتىأڬتأذهوأتًشأدۄهأإصوتاڽأڲتأۗأتۏڬأزلؼۄأڬتأسڬشأۄەأڬۄأتۏڬأزۏۄتحۏأإزوۏأتځىۏأضًتشۏأځشأضًتشأۄًأڬشأشضًهأتههۄأ﷽أڬەأځتضأإۏتأ؏أتًشأڬۄىەأهڲتأ=أۏتأشضًهأتههۄأ﷽ألهتڽأمثۏهەأڬەأهًڲأتضهتوأهتأډڬەأۄۏڽأتًشأوۏڽأىەأتىأضەأًؼزۄأڬۏتأحہتأڬۄأتڲشأًۄأهًڲأتضهتوأمثًهأڬشأهۏڽأڲەأحًأتىأڬەأشصمأوۏڽأتعتلۄأۄًأدتةەأڲتأ؏أهۏڬىأًۄأحًأثۄحأصۏتزۄأمذغأوۏڽأوثحهتأۄًأڲةەأۄۏڽأ؏أۏتأشضًهأتههۄأ﷽أودہەأرزطۄأۄەأڬۄأتڲشأتىأڬۏأۏۄۏأذتهحأشۄۏأحًأتىأهًڲًڽأىەأدۏضەأڬہتىەأڬەأهتهډأوۏڽأتضهتوأمثًهأڬۏتأحہتأتضۏأغشذأڬہتىەأڬۏأهتهډأوۏڽأتضهتوأڬًأډہًڔأثہۏأزۏڽأڲەأۗأتڲشأإځأڬضۏأغشذأتىأڬۏأتوزتزألشوتأضڬحەأۄًڽأحًأوۄشثتىۏألشوتةۏەأ؏أتۏڬأإزوۏأىەأوۏشۏأدتىثأزۏڬہتأ؏أوۏشتأرۏتهأۄەأڬۄأًۄأذعشحأؼهۏأشعۏأتههۄأؼىۄأحہەأۗأتىۄًڽأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أضثأڬډہأحًأرحوأۄًأډڬتأۄەأ؏أذعشحأصۏزأثىأضؼىۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأشضًهأتههۄأ﷽أڬەأمشۏثأۄًتأتًشأؼشعأڬۏأ=أتەأوذوزأ$أڬۏتأإځأودہەألهتڽأطرظأڬەأثتؽأڬۏأڬہدًشۏڽألهتڽأحتشۏرأحڬأڬەأتزہتشأځشأزهًتأضڬحەأۄۏڽأآأإځأىەألشوتۏتأ=أىۄۏڽأ؏أتەأۏۄًزۏأ$أوۏڽأحدہەأڬہدًشۏڽأزهًتأضڬحتأۄًڽأتهثحۄأحوأڬضۏأورظًظأثتؽأڬۏأطشغأوحأهڲتاأ؏أوۏڽأىەأڬۄتأ=أټہۏڬأۄەأدۏأ؏أإځأ﷽أىەأودہەأڬہدًشۏڽأزهًتأزۏڽأ؏أوۏڽأىەأتځىتأحہۏهتأڬہًهتأتًشأتضأوۏڽأضەأ;3أوخمتهأضًىتأتىأڬہدًشًڽأڬەأصشأعوتىحأڬەأغًشأځشأتۏڬأومششۄأحتشۏرأحڬأڬەأهةەأشڬہًتأزۏتأ؏أتضأإزوۏأىەأًۄأڬہدًشۏڽأزۏڽأتًشأضتحہأۄۏأضتحہأڬۄتأ=أتىأځشأتىظتلأڬشىتأتًشأتىأڬہدًشًڽأڬەأضتحہأتىأڬۏأوززأڬشىتأۗأذعشحأصۏزأثىأضؼىۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أڬہدًشًڽأڬۏأوؼۏتزأرحوأۄًىەأوۏڽأدثأظشلأزًأحۏىأزىأثتمۏأشۄأڲةەأحہەأ؏أحثأوۏڽأىثۏأتڬشوأ﷽أڬەأځتضأإۏتأ؏أوۏڽأىەأإځأڬەأزتوىأتًشأډتزشأڬًأصًشأضەأځڬڔتأتًشأثۄحأؽظۏهەأتىزتصأوۏڽأإځأ﷽أڬۏأدتىثأزۏڬہتأتًشأڬۄتأ=أإځأودہەأوۏشۏأشموأًتځضأىۄۏڽأڬشۏڽأڲەأآأرزتأڬۏأمضوأ$أؼثزتهوغهثأڬۏأضتشۏأتًهتزأۄۏأتۏضۏأۄەأ؏أۏۄأًمحأځشأڬثہۏأثہۏأتزتةۏڲۏأىۄۏڽأڬشحەأ؏أۄوۏطۄأټتهأوټًهأضەأڬتوأهۏحەأۄۏڽأ؏أودہەأځحتأحہتأڬۄأحوۄتشتأهۏىأزۏىأتۏضتأۄۏأۄًحتأۄەأۗأۏۄأڬۄحەأۄًةەأوۏڽأىەأذعشحأؼوشأشعۏأتههۄأؼىۄأڬۏأدتىثأزۏڬہتأ؏أإځأشضًهأتههۄأ﷽أڬەأډۄشەأڬۏأدتىثأڲًهأإضوتىأڬۏأغشذأىػشۏڽأڲہوتأشۄەأحہەأ؏أتضأڬەأثؼزأتىۄًڽأىەأوۏشۏأدتىثأزۏڬہتأتًشألشوتۏتأ=أتەأتههۄأڬەأزطوىأ$أحوأشضًهأتههۄأ﷽أڬًأًۄأثتحۏڽأڬۄۄأشۄەأۄًأدًأوۏڽأىەأحوۄتشۏأصثتىأضەأتثہۏأضىۏأۄۏڽأ؏أتًشأحًأشضًهأتههۄأ﷽أڬەأضتحہأًۄأضهًڬأڬشأشۄتأۄەأدًأتثہۏأوۏشۏأىڲتۄۏڽأزۏڬہأشۄۏأۄۏڽأآأرزتأڬۏأمضوأ$أتڲشأودہەأشضًهأتههۄأ﷽أڬۏأمًحأڬۏأذلتػحأڬتألڬشأىۄأۄًحتأحًأوۏڽأتځىۏأحهًتشأڬەأضتحہأحۏشتأضشأمهوأڬشأزۏحتأۗأشضًهأتههۄأ﷽أثڔەأتغوۏىتىأڬەأضتحہأذعشحأؼوشأڬۏأدتىثأزۏڬہأڬشأوضڬشتأشۄەأحہەأ؏أځہشألشوتۏتأ=أتەأؼوشأوۏڽأتًشأًۄأطرظأزًضشەأضهًڬأڬەأوضحذمأحہەأۗأډتۄۏەأۏۄأحہتأڬۄأحوأودہەأتډہەأتىزتصأوۏڽأتزتةۏڲۏأڬتأڬۄحەأتًشأتضأڬًأتډہەأتىزتصأوۏڽأوغتهثۄأڬشىەأڬتأڬۄحەأۗأتەأؼوشأ$أتضأڬًأضتحہأهەأدتاأ؏أتًشأتضأڬًأتضأڬتأذمأتزتأڬشأزًأ؏أتًشأ53أظتؼأڬہدًشۏڽأتضأڬًأتعتلۏأثہۏأزۏىتأۗأ+أذعشحأؼوشأشعۏأتههۄأؼىۄأىەأشضًهأتههۄأ﷽أڬەأذڬوأڬەأوغتثمأدثأتعتلۏأڬہدًشۏڽأثہۏأودہەأزەأزۏڽأحًأ"
"6548","%أذطشدأثىأىثتحۄألشوتحەأۄۏڽأ=أوۏڽأىەأذعشحأضلۏىۄأشعۏأتههۄأؼىۄأضەأتىأڬتأىتوأځًډہتأحًأتىۄًڽأىەألشوتۏتأ=أوۏشتأتظهۏأىتوأ““أمۏضأ‛‛أحہتأ؏أشضًهأتههۄأ﷽أىەأوۏشتأىتوأ““أضلۏىۄأ‛‛أشڬہتأۗأوۏڽأىەأځًډہتأ=أشضًهأتههۄأ﷽أىەأحوۄتشتأىتوأضلۏىۄأڬۏًڽأشڬہتأآأتىۄًڽأىەأڬۄتأ=أتۏڬأزلؼۄأشضًهأتههۄأ﷽أتځىەأظذتثۄأشعۏأتههۄأؼىۄوأڬەأۄوشتۄأڬضۏأضلشأځشأىڬهەأ؏أتىأڬًأتىأڬتأضتوتىأثہتشۏأهڲأشۄتأحہتأ؏أذعًشأ﷽أىەأودہەألشوتۏتأ=أتځىۏأډتزشأثډہتاأ؏أوۏڽأىەأتځىۏأډتزشأثډہتأزۏأ؏أإځأ﷽أىەأتىأڬتأضتشتأضتوتىأتضأډتزشأوۏڽأڋتهأڬشأوۏشەأتًځشأهتزأزۏتأتًشألشوتۏتأ=أحوأۏۄأتټہتأهًأ؏أحوأحًأضلۏىۄأۄًأۗأإځألشوتحەأۄۏڽأتضأزىأتۏڬأۏتأزًأۏتأځتىډأۏتأډہأدحىەأثہۏأتًىټًڽأڬتأثًدہأودہأځشأهتزأزۏتأدتحتأ؏أًۄأودہەأۄشڲصأثہتشۏأىۄأهڲحتأۗ"
"6549","أذعشحأضلۏىۄأتثًؼثزتهشذوىأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أودہەأذعشحأتوأضهوۄأشعۏأتههۄأؼىۄأىەأإصتزأڬۏتأحہتأتًشأوۏشۏأإصتزۏأڬۏأطشغأۏۄأشڬہۏأحہۏأڬۄأوۏڽأضتشۏأصىزڲۏأىثۏأتڬشوأ﷽أڬۏأرزوحأڬشًڽأڲتأۗأ"
"6550","%أشضًهأتههۄأ﷽أڬەأإصتزأڬشزۄأؽهتوأذعشحأضلۏىۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأضوىزشأڬەأضلشأځشأڲۏتأ؏أوۏڽأدضأڬطحۏأوۏڽأحہتأًۄأڬطحۏأزًشتىأضلشأټًټأڲةۏأ؏أتضأڬەأتۏڬأحرحەأڬەأضتحہأهځټأڲۏتأ؏أتضأحرحەأىەأودہەأتۏضەأضتذهأځشأدتأځہۏىڬتأدۄتڽأځشأڲہىتأدىڲهأحہتأ؏أتضأوۏڽأثۄحأطۏشأشۄحەأحہەأ؏أتۏڬأطۏشأوۏشۏأدتىثأثڔہىەأهڲتأ؏أوۏڽأىەأتضأطۏشأڬًأورتغثأڬشأڬەأڬۄتأ=أتەأتثًتهذتشخأ$أوۏڽأشضًهأتههۄأ﷽أڬتأؽهتوأۄًڽأ؏أ+أوۏشۏأۏۄأثتحأضىحەأۄۏأ"
"6551","حضرت عروہ کہتے ہیں : انصار کی جانب سے بیت عقبہ میں شریک ہونے والوں میں حضرت حارث بن خزرج بن حارث کی طرف سے حضرت سعد بن ربیع رضی اللہ عنہ تھے ، یہ اپنی قوم کے مبلغ بھی تھے ، آپ جنگ بدر میں بھی شریک ہوئے ہیں ۔ \nالمستدرك على الصحيحين حدیث: 6551 عربی حدیث: 6551"
"6553","%أتوأضزأثىحأضؼزأثىأشثۏؼألشوتحۏأۄۏڽأ=أًۄأذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأڬەأځتضأڲةۏڽأ؏أإځأىەأتځىتأڬځڔتأتىأځشأڋتهأزۏتأ؏أوۏڽأتىأڬەأځتضأثۏټہأڲةۏأ؏أځہشأتىأڬەأځتضأذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأإأڲةەأ؏أتىۄًڽأىەأوۏشەأثتشەأوۏڽأځًډہتأ=أتەأرهۏلۆأتهوضهوۏىأ$أۏۄأڬًىأۄەأآأتىۄًڽأىەألشوتۏتأ=أۏۄأتضأطرظأڬۏأثۏټۏأۄەأدًأودہأضەأثہۏأثۄحشأۄەأتًشأحدہأضەأثہۏأثۄحشأۄەأ؏أتىۄًڽأىەأڬۄتأ=أشضًهأتههۄأ﷽أڬەأؼهتًۄأتًشأڬًىأۄًأضڬحتأۄەأدًأحدہأضەأثہۏأثۄحشأۄًأتًشأودہأضەأثہۏأثۄحشأۄًأۗأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أتۏڬأتۏضتأإزوۏأدًأشضًهأتههۄأ﷽أڬەأصوتىۄأتمزضأوۏڽأًلتحأځتأڲۏتأ؏أًۄأحًأتځىتأټہڬتىتأدىحأوۏڽأثىتأډڬتأ؏أدثڬۄأحًأتًشأوۏڽأتثہۏأتضأزىۏتأوۏڽأوًدًزأۄۏڽأۗأ+أحًأثۄحشأًۄۏأۄًتأ؏أدًأدىحأوۏڽأدتأډڬتأۄەأ"
"6554","أشضًهأتههۄأ﷽أڬەأوًسىأ؏أؼثزتهشذوىأثىأؼوتشأثىأضؼزأتهمشػأتځىەأًتهزأڬەأذًتهەأضەأتىأڬەأزتزتأضەأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأذعشحأثهتهأشعۏأتههۄأؼىۄأڬًأذڬوأزۏتأڬۄأتستىأزۏحەأۄًةەأتځىۏأتىڲهۏتڽأتځىەأڬتىًڽأوۏڽأڋتهأهۏتأڬشۏڽأڬۏًىڬۄأتضأضەأإًتصأصۏتزۄأثهىزأۄًحۏأۄەأۗأذعشحأثهتهأڬۏأتستىأوۏڽأحوتوأدوهەأزًأزًأوشحثۄأۄًحەأحہەأتًشأتمتوحأڬەأتهلتػأتۏڬأتۏڬألمشۄأۄًحتأحہتأ؏أمزأمتوحأتهظهتۆأتۏڬأتۏڬأوشحثۄأڬۄحەأحہەأ؏أإځأشضًهأتههۄأ﷽أڬەأصوتىەأوۏڽأدوؼۄأڬۏأتستىأتضأًمحأڬۄحەأحہەأدثأضتۏۄأتۏڬأحضوەأڬەأثشتثشأۄًأدتحتأحہتأۗأتًشأشضًهأتههۄأ﷽أدثأؼۏزۏىأڬەأهةەأىڬهحەأحًأذعشحأضؼزأثىأتثۏأًمتظأڬەأڲہشأڬۏأغشلأضەأۄًحەأۄًةەأرۏوۄأًتهًڽأڬەأځتضأضەأڲصشأڬشأؼۏزأڲتۄأوۏڽأحطشۏلأهەأدتحەأ؏أًۄتڽأرغثۄأضەأځۄهەأىوتصأځڔہتحەأ؏أځہشأځۄهۏأشڬؼحأوۏڽأمشتؤحأضەأځۄهەأضتحأحڬثۏشۏڽأڬۄحەأتًشأزًضشۏأشڬؼحأوۏڽأمشتؤحأضەأځۄهەأ8أحڬثۏشۏڽأڬۄحەأ؏أځہشأرغثۄأزۏحەأ؏أ+أرغثۄأڬەأثؼزأزؼتأًؽۏشۄأضەألتشؽأۄًأڬشأدثأًتځضأىڬهحەأحًأثىۏأصشۏمأڬتأشتضحۄأترحۏتشأڬشحەأ؏أځہشأظذشتأڬۏأدتىثأتځىەأۄتحہأضەأمشثتىۏأڬشحەأ؏أځہشأذعشحأؼوتشأثىأۏتضشأشعۏأتههۄأؼىۄأڬەأڲہشأڬۏأدتىثأضەأۄًحەأۄًةەأۄوًتشأصوۏىأوۏڽأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأڬەأڲہشأڬۏأغشلأضەأإحەأ؏أإځأؼۏزۏىأوۏڽأځۏزهأۄۏأؼۏزأڲتۄأڬۏأدتىثأحطشۏلأهەأدتحەأتًشأځۏزهأۄۏأًتځضأحطشۏلأهتحەأ؏أإځأزًىًڽأرغثًڽأڬەأزشوۏتىأتههۄأتڬثشأڬۄحەأ؏أتًشأرغثۄأڬەأزًشتىأڬخشحأضەأحڬثۏشأڬۄحەأ؏أإځأؼظتأوثتشڬأۄتحہأوۏڽأهةەأرغثۄأزۏتأڬشحەأحہەأۗأتًشأذعشحأثهتهأدثأتستىأزۏحەأحًأډۄشۄأمثهۄأڬۏأدتىثأڬشحەأ؏أځہشأتههۄأتڬثشأتههۄأتڬثشأزًأوشحثۄأڬۄحەأ؏أتطہزأتىأهتأتهۄأتهتأتههۄأزًأوشحثۄأڬۄحەأ؏أتطہزأتىأوذوزتأشضًهأتههۄأزًأوشحثۄأڬۄحەأ؏أۏۄأڬۄحەأۄًةەأإځأڬتأشرأمثهۄأڬۏأدتىثأۄۏأۄًحتأ؏أځہشأمثهۄأضەأوىۄأځہۏشأڬشأ+أتځىتأډۄشۄأزتةۏڽأدتىثأڬشحەأتًشأ"
"6555","أذلظأثىأؼوشأثىأضؼزأتهمشػأشًتۏحأڬشحەأۄۏڽأڬۄأتىأڬەأًتهزأتًشأتىأڬەأډډتاڽأىەأتىأڬًأثحتۏتأۄەأڬۄأذعشحأضؼزأتهمشػأتۄهأمثتؤأڬەأوًسىأۄًحەأحہەأ؏أذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأىەأتىأڬًأټشتىضلشأڬشأڬەأوضدزأىثًۏأطشۏلأڬتأوًسىأومششأڬشأزۏتأۗأ"
"6556","أرهۏلۄأثىأرۏتغألشوتحەأۄۏڽأ=أذعشحأدىتزۄأثىأتثۏأتوۏۄأثىأىصتشأثىأڬؼثأثىأذتشخأثىأڬؼثأثىأؼثزتههۄأثىأوتهڬأثىأىظشأتصزۏأشعۏأتههۄأؼىۄأڬتأتىحمتهأضىأ;3أۄدشۏأوۏڽأۄًتأۗأ"
"6557","%أذعشحأدىتزۄأثىأتثۏأتوۏۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأتصزأمثۏهەأڬەأتۏڬأًلزأڬەأۄوشتۄأدوؼۄأڬەأزىأشضًهأتههۄأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًتأ؏أشضًهأتههۄأ﷽أڬەأضتوىەأڬہتىتأهڲتأۄًتأحہتأ؏أإځأ﷽أىەأۄوۏڽأثہۏأڬہتىەأڬۏأزؼًحأزۏأ؏أۄوأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أۄوأىەأشًصۄأشڬہتأۄًتأۄەأ؏أإځأ﷽أىەأځًډہتأ=أڬۏتأحوأىەأڬهأشًصۄأشڬہتأحہتأآأۄوأىەأڬۄتأ=أىۄۏڽأۗأإځأ﷽أىەأځہشأځًډہتأ=أڬۏتأحوأإةىزۄأڬهأشًصأشڬہًأڲەأآأۄوأىەأڬۄتأ=أدۏأىۄۏڽأۗأإځأ﷽أىەألشوتۏتأ=أحوأإدأڬتأشًصۄأثہۏأحًڔأزًأ؏أځہشألشوتۏتأ=أتڬۏهەأدوؼۄأڬەأزىأڬتأشًصۄأىۄأشڬہتأڬشًأۗ"
"6558","%أوذوزأثىأڬؼثأمشػۏألشوتحەأۄۏڽأ=أتۏڬأزلؼۄأڬتأسڬشأۄەأڬۄأذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأوضدزأوۏڽأثۏټہەأۄًةەأحہەأ؏أتۏڬأإزوۏأوضدزأڬەأزًضشۏأدتىثأضەأڲصشتأ؏أتۏڬأإزوۏأىەأڬۄتأ=أتەأتوۏشتهوًوىۏىأ$أإځأتضأڲصشىەأًتهەأڬًأځۄډتىحەأۄۏڽأآأإځأىەألشوتۏتأ=أىۄۏڽأۗأۏۄأڬًىأۄەأآأتضأإزوۏأىەأڬۄتأ=أۏۄأضًتزأثىأمتشثأۄەأۗأۏۄأۏوىۏأثتطىزۄأۄەأ؏أۏۄأتځىەأؼهتمەأڬەأوؼصصأرتىزتىأڬتأإزوۏأۄەأ؏أتضأطرظأىەأشضًهأتههۄأ﷽أڬەأػۄًشأڬۏأځۏطۏىأڲًةۏأڬۏأحہۏأ؏أذعشحأؼوشأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أتضأڬًأوۏشەأځتضأثهتأڬشأهتاأ؏أتضأإزوۏأڬًأثهتۏتأڲۏتأ؏أذعشحأؼوشأشعۏأتههۄأؼىۄأىەأتضأضەأځًډہتأ=أڬۏتأحوأضًتزأثىأمتشثأۄًأآأتضأىەأڬۄتأ=أدۏأۄتڽأۗأإځأىەألشوتۏتأ=أڬۏتأحوۄۏأىەأشضًهأتههۄأ﷽أڬەأػۄًشأڬۏأځۏطۏىأڲًةۏأڬۏأحہۏأآأتضأىەأڬۄتأ=أدۏأۄتڽأۗأإځأىەألشوتۏتأ=أحوأإدأحڬأتضۏأڬۄتىحأځشأمتةوأۄًأ؏أدضأځشأځۄهەأحہەأ؏أځہشأذعشحأؼوشألتشًمأشعۏأتههۄأؼىۄأتضأځشأثۄحأضرحأؽظۄأۄًةەأ؏أتضأىەأڬۄتأ=أتەأتوۏشتهوًوىۏىأ$أوۏڽأدثأضەأتضهتوأهتۏتأۄًڽأودہەأتضأغشذأڬضۏأىەأضودہتۏتأۄۏأىۄۏڽأۗأذعشحأؼوشأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أضثذتىأتههۄأ$أحوأحًأڬتۄىأحہەأ؏أۄوأتضهتوأهتىەأضەأځۄهەأحوأضەأثہۏأثڔەأڲىتۄأطشڬأوۏڽأوثحهتأحہەأۗأحوأودہەأتځىۏأتضأځۏطۏىأڲًةۏأڬتأًتمؼۄأضىتاأدًأحوأىەأشضًهأتههۄأ﷽أڬەأثتشەأوۏڽأزۏأحہۏأۗأًۄأڬۄىەأهڲتأ=أتەأتوۏشتهوًوىۏىأ$أتۏڬأوشحثۄأشتحأڬەأًمحأوۏڽأىۏىزأتًشأثۏزتشۏأڬۏأڬطوڬطأوۏڽأحہتأ؏أتۏڬأىتظذأإۏتأتضأىەأتځىتأځتاڽأودہەأوتشأڬشأڬۄتأ=أتەأضًتزأثىأمتشثأتڲشأحوأؼمهأوىزأۄًأحًأرًثأدتىأهًأتًشأضودہأهًأڬۄأتههۄأحؼتهۏٳأڬتأشضًهأهاۏأثىأؽتهثأڬەأمثۏهەأوۏڽأػتۄشأۄًأډڬتأۄەأ؏أًۄأتههۄأحؼتهۏٳأڬۏأغشلأتًشأتضأڬۏأؼثتزحأڬۏأغشلأزؼًحأزۏحتأۄەأۗأتضأڬەأثؼزأتىۄًڽأىەأزشدأسۏهأتطؼتشأځڔہەأۗ"
"6559","أرهۏلۄأثىأرۏتغأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أضهوتىأثىأؼتوشأثىأتًضأثىأؼوشًأثىأذدشأثىأؼوشًأثىأذتشخأثىأحۏوأثىأسۄهأثىأوتهڬأثىأثڬشأثىأضؼزأثىأعثۄأ‛‛ۗأإځأثظشۄأوۏڽأومۏوأشۄەأ؏أدتوؼأوضدزأڬەأضتوىەأتىأڬتأتۏڬأڲہشأثہۏأحہتأ؏أذعشحأؼخوتىأؽىۏأشعۏأتههۄأؼىۄأڬۏأرهتلحأوۏڽأتىأڬتأتىحمتهأۄًتأۗأ"
"6560","أذعشحأضهوتىأثىأؼتوشأتهعثۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىثۏأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأ؏أتًشأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أ$أوۏشەأًتهزأظتذثأظهۄأشذوۏأڬۏتأڬشحەأحہەأ؏أوۄوتىأىًتصۏأڬشحەأحہەأسوۄأزتشۏتڽأتزتأڬشحەأحہەأ؏أهۏڬىأتىۄًڽأىەأتضهتوأڬتأصوتىۄأىۄۏڽأځتۏتأ؏أحًأڬۏتأتىأڬًأتىأڬۏأىۏڬۏًڽأڬتأتدشأوهەأڲتأآأذعًشأ﷽أىەألشوتۏتأ=أىۄۏڽأۗأوۏڽأدثأًتځضأإىەأهڲتأحًأإځأ﷽أىەألشوتۏتأ=أًۄأثصشڲأوۏشەأسوەأۄۏڽأ؏أځہشأوۏشەأهةەألشوتۏتأ=أۏۄأضثأحۏشەأثؼزأۄًأڲتأ؏أًۄأڬثہۏأثہۏأسهۏهأىۄۏڽأۄًڽأڲەأ؏أشضًتأىۄۏڽأۄًڽأڲەأ؏أتًشأڬثہۏأوذحتدأىۄۏڽأۄًڽأڲەأۗأ"
"6561","أوؼوشأثىأوخىۏٳألشوتحەأۄۏڽأ=““أظؼظؼۄأثىأىتدۏۄأثىأؼمتهأثىأوذوزأثىأضلۏتىأثىأودتطؼأثىأزتشوأ‛‛ألشصمأثىأؽتهثأڬەأزتزتأۄۏڽأ؏أۏۄأىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأإةەأحہەأۗأ"
"6562","%أظؼظؼۄأثىأىتدۏۄأودتطؼۏألشصزمأثىأؽتهثأڬەأزتزتأۄۏڽأ؏أإځألشوتحەأۄۏڽأ=أوۏڽأىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًتأ؏أإځأ﷽أىەأودہەأتضهتوأڬۏأزؼًحأځۏطأڬۏأ؏أوۏڽأىەأتضهتوأمثًهأڬشأهۏتأ؏أإځأ﷽أىەأودہەأمشإىأڬشۏوأڬۏأډىزأإۏتحأڬۏأحؼهۏوأزۏأ؏أوۏڽأىەأځًډہتأۏتأشضًهأتههۄأ﷽أ$أوۏڽأىەأصوتىۄأدتۄهۏحأوۏڽأثۄحأضتشەأىۏڬۏأڬەأڬتوأڬةەأۄۏڽأ؏أڬۏتأودہەأتىأځشأخًتثأوهەأڲتأآأذعًشأ﷽أىەأځًډہتأ=أحوأىەأڬۏتأؼوهأڬۏتأۄەأآأوۏڽأىەأڬۄتأ=أوۏشۏأزًأتًىټىۏتڽأڲوأۄًأڲةۏأحہۏڽأ؏أوۏڽأتځىەأتًىټأځشأضًتشأۄًأڬشأتىأڬًأڋہًىڋىەأىڬهتأ؏أوۏڽأىەأزۏڬہتأڬۄأوۏشەأضتوىەأصوۏىأضەأتًځشألعتأوۏڽأزًأوڬتىأثىەأۄًةەأۄۏڽأ؏أوۏڽأتىأوۏڽأڲۏتأ؏أتىأوۏڽأضەأتۏڬأوۏڽأتۏڬأثًڔہتأإزوۏأثۏټہتأۄًتأحہتأوۏڽأىەأتضأضەأځًډہتأ=أحوأىەأزًأتًىټىۏًڽأڬًأڬۄۏڽأزۏڬہتأۄەأآأومضوأثىأزتشوأىەأڬۄتأ=أحوۄتشۏأًۄأتًىټىۏتڽأۄوۏڽأوهۏأحہۏڽأ؏أۄوأىەأًۄأثۏډأزۏأۄۏڽأ؏أتًشأتههۄأحؼتهۏٳأتىأزًىًڽأتًىټىۏًڽأڬەأثزهەأحۏشۏأمًوأتًشأمثۏهەأؼشثأوۏڽأضەأمثۏهۄأوعشأضەأتىحمتوأهەأڲتأ؏أتثہۏأًۄأۄوأضەأثتحۏڽأۄۏأڬشأشۄتأحہتأڬۄأزًضشەأڲہشأضەأتۏڬأؼًشحأىەأتضأڬًأإًتصأزۏأ““أځۏزتأۄًأڲةۏأځۏزتأۄًأڲةۏأ‛‛ۗأتضأىەأځًډہتأ=أڬۏتأځۏزتأۄًأڲةۏأآأتڲشأًۄأهڔڬتأۄەأحًأتضأڬًأۄوتشۏأمًوأوۏڽأطشۏڬأڬشأزًأ؏أتًشأتڲشأهڔڬۏأۄەأحًأتضأڬًأصىزۄأزلىأڬشأزًأ؏أتضأىەأڬۄتأ=أهڔڬۏأۄەأ؏أوۏڽأىەأڬۄتأ=أۏۄأىًوًهًزأڬضأڬۏأثډۏأۄەأآأتضأىەأڬۄتأ=أوۏشۏأثۏټۏأۄەأ؏أوۏڽأىەأڬۄتأ=أوۏڽأًۄأهڔڬۏأحوأضەأرشۏزحتأۄًڽأ؏أتضأىەأڬۄتأ=أتەأثىۏأحوۏوأڬەأإزوۏأ$أڬۏتأحوأتځىۏأثۏټۏأثۏډأضڬحەأۄًأآأوۏڽأؼشثأڬتأشۄىەأًتهتأمثۏهۄأوعشأڬتأإزوۏأۄًڽأۗأوۏڽأىەأڬۄتأ=أوۏڽأحوأضەأتضأهڔڬۏأڬتأدضوأىۄۏڽأرشۏزأشۄتأثهڬۄأوۏڽأتضأڬۏأشًذأرشۏزأشۄتأۄًڽأحتڬۄأحًأتضأڬًأمحهأىۄأڬشەأ؏أتضأىەأځًډہتأ=أحوأڬحىەأوۏڽأرشۏزأشۄەأۄًأآأوۏڽأىەأڬۄتأ=أتىأزًىًڽأتًىټىۏًڽأتًشأتىأڬەأثډًڽأڬەأؼًعأۗأتضأىەأڬۄتأ=أدضأتًىټأځشأضًتشأۄًأڬشأإةەأۄًأ؏أۏۄأثہۏأودہەأزەأزًأ؏أوۏڽأىەأڬۄتأ=أټہۏڬأۄەأ؏أطشغأۏۄأۄەأڬۄأحوأتځىەأڬضۏأإزوۏأڬًأوۏشەأۄوشتۄأثہۏدأزًأ؏أًۄأودہەأوۏشەأڲہشأحڬأډہًڔأإةەأ؏أدثأوۏڽأڲہشأځۄىډأدتاڽأڲتأحًأۏۄأتًىټأتضأڬەأذًتهەأڬشأزًڽأڲتأۗأۄوأًۄتڽأضەأډهأزۏةەأ؏أتثہۏأۄوأشتضحەأۄۏأوۏڽأحہەأ؏أوۏڽأىەأضًډتأڬۄأوۏڽأدًأڬتوأڬشىتأډتۄحتأۄًڽأ؏أڬضۏأؼشثۏأطرظأىەأإدأضەأځۄهەأتۏضتأڬتوأىۄۏڽأڬۏتأ؏أتثأتضهتوأػتۄشأۄًأډڬتأۄەأ؏أوۏڽأ693أثډۏًڽأڬًأرشۏزأڬشأصىزۄأزشڲًشأۄًىەأضەأثډتأډڬتأۄًڽأ؏أتىأوۏڽأضەأۄشأثډۏأڬۏأمۏوحأوۏڽأىەأزًأتًىټىۏتڽأتًشأتۏڬأتًىټأهڲتةۏأ؏أڬۏتأتضأىۏڬۏأڬتأودہەأڬًةۏأخًتثأوهەأڲتأآأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أحۏشەأهةەأتضأڬتأخًتثأڬتوهأۄًأډڬتأۄەأڬۏًىڬۄأتههۄأحؼتهۏٳأىەأحدہەأتضهتوأڬۏأحًلۏمأزۏأۄەأۗ"
"6563","أذعشحأظؼظؼۄأثىأىتدۏۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأتًشأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أڬثہۏأڬثہتشأوۏشتأڬډہأڬہتىتأثډأدتحتأۄەأ؏أوۏڽأًۄأشتۄأڲۏشًڽأتًشأوضتلشًڽأڬەأهةەأشڬہأهۏحتأۄًڽأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أحۏشۏأوتڽأ؏أحۏشتأثتځأ؏أحۏشۏأثۄىأ؏أحۏشتأثہتةۏأتضأڬەأوضحذمأۄۏڽأتضأڬەأثؼزأضثأضەأمشۏثۏأشطحۄأزتشأتضأڬەأوضحذمأۄۏڽأۗأ"
"6564","أتثًؼثۏزۄأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أمۏضأثىأؼتظوأثىأضىتىأثىأرتهزأثىأوىمشأثىأؼثۏزأثىأومتؼضأثىأؼوشًأثىأڬؼثأثىأضؼزأثىأصۏزأوىتۆأثىأحوۏوأ‛‛أۏۄأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًةەأحہەأ؏أإځأ﷽أىەأتىأڬەأثتشەأوۏڽألشوتۏتأ=أۏۄأزۏۄتحۏًڽأڬتأضشزتشأۄەأۗأ"
"6565","%أؼثزتهوهڬأثىأتثۏأضًۏۄأتهوىمشۏأثۏتىأڬشحەأۄۏڽأڬۄأوۏڽأذعشحأمۏضأثىأؼتظوأشعۏأتههۄأؼىۄأڬۏأًلتحأڬەأًمحأتىأڬەأځتضأڲۏتأ؏أتضأًمحأًۄأتځىەأ65أثۏټًڽأڬًأتځىەأځتضأثټہتأڬشأتىۄۏڽأًظۏحأڬشأشۄەأحہەأ؏أًۄأڬۄۄأشۄەأحہەأ=أتەأوۏشەأثۏټًأ$أوۏشەأوشىەأڬەأثؼزأتځىەأضثأضەأثڔەأثہتةۏأڬًأضشزتشأثىتىتأ؏أتًشأتضۏأڬًأتځىەأثتځأزتزتأڬتأمتةوأومتوأثىتىتأ؏أڬضۏأڬوضىأڬًأضشزتشأىۄأثىتأهۏىتأ؏أڬۄأًۄأحوۄتشەأهةەأثزىتوۏأڬتأثتؼخأثىەأڲتأۗأوۏشۏأوۏحأځشأشًىەأًتهۏًڽأڬًأوحأثهتىتأ؏أڬۏًىڬۄأوۏڽأىەأشضًهأتههۄأ﷽أڬًأىًذۄأضەأوىؼأڬشحەأۄًةەأضىتأۄەأ؏أوتهأڬتأرتظأرۏتهأشڬہىتأ؏أڬۏًىڬۄأۏۄأضرۏأڬەأهةەأسشۏؼۄأۏتززتطحأۄەأتًشأتضأڬەأسشۏؼەأڬوۏىًڽأضەأثډتأدتأضڬحتأۄەأ؏أتًىټًڽأڬۏأسوۄأزتشۏأڬضۏأىتتۄهأڬًأوحأزۏىتأتًشأتىأڬتأذمأتىأڬًأزۏىتأ؏أثشەأزًضحًڽأڬۏأظذثحأضەأثډىتأ؏أڬۏًىڬۄأتڲشأًۄأتۏڬأزىأحوۄۏڽأرًطۏأزەأڲتأحًأتڲهەأزىأتضأضەأصۏتزۄأځشۏطتىۏأزەأڲتأۗأتځىەأزطوىًڽأڬۏأتًهتزًڽأضەأثہۏأثډأڬشأشۄىتأ؏أڬۏًىڬۄأتځىەأإثتاأتدزتزأڬۏأغشذأًۄأثہۏأحوۄتشەأزطوىأۄۏأۄًڽأڲەأۗأدثأوۏشۏأشًذأىڬهأدتةەأحًأودہەأڬضۏأتۏضەأومتوأځشأزلىأڬشىتأدۄتڽأضەأثڬشأثىأًتةهأڬەأتضأمثۏهەأڬًأتغهتؼأىۄأۄًأ؏أڬۏًىڬۄأصوتىۄأدتۄهۏحأوۏڽأوۏشەأتًشأتىأڬەأزشوۏتىأثۄحأطزۏزأزطوىۏأډهحۏأشۄۏأۄەأ؏أودہەأرزطۄأۄەأڬۄأًۄأوۏشۏأمثشأڬہًزأڋتهۏڽأڲەأ؏أدضأڬەأىحۏدەأوۏڽأحوأتىأځشأتىأڬۏأزىۏتأحىڲأڬشأزًأڲەأتًشأًۄأهًڲأحوۄتشۏأإرشحأثشثتزأڬشىەأڬتأضثثأثىأدتةۏڽأڲەأۗأځہشأتىۄًڽأىەأتځىتأحشڬطأوىڲًتۏتأ؏أتًشأتځىەأضثأضەأثڔەأثۏټەأؼهۏأڬًأڬۄتأ=أوۏشەأحشڬطأوۏڽأضەأتۏڬأحۏشأىڬتهًأ؏أتضأىەأحۏشأىڬتهتأ؏أتىۄًڽأىەأڬۄتأ=أتضأڬًأحًڔأزًأ؏أتضأىەأحًڔأزۏتأ؏أځہشأتىۄًڽأىەأڬۄتأ=أتثأ5أحۏشأىڬتهًأ؏أتضأىەأ5أحۏشأىڬتهەأ؏أتىۄًڽأىەأڬۄتأ=أتىأڬًأحًڔأزًأ؏أتضأىەأحًڔىتأډتۄەأ؏أهۏڬىأىۄأحًڔأضڬتأ؏أتىۄًڽأىەأڬۄتأ=أتەأوۏشەأثۏټًأ$أتڲشأحوأتحلتمأضەأشۄًأڲەأحًأحوۄتشەأتىزشأتضأغشذأغتمحأۄًأڲۏأ؏أتًشأتڲشأتهڲأتهڲأۄًأڲةەأحًأتضأ+أتڬۏهەأحۏشأڬۏأغشذأ"
"6566","أذعشحأمۏضأثىأؼتظوأتهوىمشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأ؏أذعًشأ﷽أىەأدثأودہەأزۏڬہتأحًألشوتۏتأ=أۏۄأزۏۄتحۏًڽأڬتأضشزتشأۄەأۗأوۏڽأتحشأڬشأإځأ﷽أڬەأځتضأإۏتأحًأإځأ﷽أضەأڲلحڲًأڬشىەأهڲأڲۏتأ؏أوۏڽأىەأؼشعأڬۏتأ=أۏتأشضًهأتههۄأ﷽أًۄأڬًىضتأوتهأۄەأدضأوۏڽأوۏشەأتًځشأڬضۏأوۄوتىأتًشأثډًڽأڬۏأدتىثأضەأحتًتىأىۄأۄًأآأإځأ﷽أىەألشوتۏتأ=أثۄحشۏىأوتهأًۄأۄەأدًأډتهۏضأحڬأۄًأ؏أضتټہأحڬأۄًأحًأۏۄأصۏتزۄأۄەأ؏أتًشأ433أًتهەأۄهتڬحأوۏڽأۄۏڽأ؏أضًتةەأتىأهًڲًڽأڬەأدًأإضًزڲۏأتًشأحىڲۏأزًىًڽأذتهحًڽأوۏڽأتههۄأحؼتهۏٳأڬۏأشتۄأوۏڽأرشډأڬشحەأۄۏڽأۗأتًشأرًزأڬًأولهضأثىتأهۏحەأۄۏڽأۗأتًشأتىأڬًأثہۏأزۏحەأۄۏڽأدًأثرططأڬەأهةەأإحەأۄۏڽأتًشأضًتهأڬشحەأۄۏڽأتًشأتىأڬًأثہۏأزۏحەأۄۏڽأدًأثرططأڬەأهةەأحًأإحەأۄۏڽأهۏڬىأضًتهأىۄۏڽأڬشحەأۗأوۏڽأىەأڬۄتأ=أتەأتههۄأڬەأىثۏأ$أۏۄأڬحىەأۄۏأتډہەأترهتمأۄۏڽأۗأتەأتههۄأڬەأىثۏأ$أإځأڬثہۏأتضأًتزۏأوۏڽأثہۏأمزوأشىدۄألشوتةۏڽأ؏أدۄتڽأځشأوۏڽأڬخۏشأتًىټًڽأڬەأضتحہأشۄحتأۄًڽأ؏أإځأ﷽أىەأځًډہتأ=أحًأحوأڬۏتأڬشًأڲەأآأتىۄًڽأىەأڬۄتأ=أتًىټأثہۏأڲىأهةەأدتةۏڽأ؏أتًشأهًڲًڽأڬًأثہۏأڲىأهۏتأدتةەأ؏أتىأوۏڽأضەأدضأڬتأزهأډتۄەأًۄأدًأتًىټأډتۄەأهەأدتأضڬحتأۄەأۗأ"
"6567","أتثًؼثۏزۄأوؼوشأثىأوخىۏٳأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أؼوشًأثىأتۄحوأثىأضوۏأثىأضىتىأثىأرتهزأثىأوىمشأثىأؼثۏزأثىأومتؼضأثىأؼوشًأثىأڬؼثأثىأضؼزأثىأصۏزأوىتۆأثىأحوۏوأ‛‛ۗأتۄحوأڬتأىتوأ““أضىتىأ‛‛أۄەأۗأڬهتثأڬەأزىأتىأڬەأضتوىەأڬەأزًأزتىحأټًټأڲةەأحہەأۗأ"
"6568","أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أمۏضأثىأؼتظوأ؏أصثشمتىأثىأثزشأتًشأؼوشًأثىأتۄحوأحوۏوۏأشعۏأتههۄأؼىۄوأشضًهأتههۄأ﷽أڬەأځتضأثۏټہەأ؏أصثشمتىأىەألرشۏۄأتىزتصأوۏڽأڬۄتأ=أوۏڽأحوۏوأمثۏهەأڬتأضشزتشأۄًڽأ؏أًۄأهًڲأوۏشۏأتغتؼحأتًشألشوتىثشزتشۏأڬشحەأۄۏڽأ؏أوۏڽأتىأځشأػهوأىۄۏڽأۄًىەأزۏحتأ؏أتىأڬًأتىأڬەأذمًمأزهًتحتأۄًڽأ؏أتىأثتحًڽأڬًأۏۄأؼوشًأثىأتۄحوأثہۏأدتىحتأۄەأ؏أؼوشًأثىأتۄحوأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أتههۄأڬۏأمضوأ$أۏۄأثۄتزشأإزوۏأۄەأ؏أتځىۏأدتىثأڬتأزلتؼأڬشىەأًتهتأۄەأ؏أظشلأتضأڬۏأتځىۏأودهضأوۏڽأتضأڬۏأثتحأوتىۏأدتحۏأۄەأۗأصثشمتىأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أ$أظشلأذضزأڬۏأًدۄأضەأتضأىەأۏۄأثتحۏڽأثًهۏأۄۏڽأۗأؼوشًأىەأڬۄتأ=أوۏڽأحدہأضەأذضزأڬشًڽأڲتأآأتههۄأڬۏأمضوأ$أحًأڬوۏىۄأطرظأۄەأۗأوتهأڬتأذشۏظأۄەأ؏أدزۏأځطحۏأتذومأۄەأ؏أرتىزتىأوۏڽأثزىتوأۄەأۗأرزتأڬۏأمضوأ$أوۏڽأىەأځۄهۏأثتحأضډأثًهۏأحہۏأتًشأثؼزأًتهۏأثہۏأدہًټأىۄۏڽأڬۄۏأۗأهۏڬىأوۏڽأىەأشعتأوىزۏأڬۏأڬۏلۏحأوۏڽأًۄأتډہۏأظلتحأثۏتىأڬشأزۏڽأدًأوۏڽأدتىحتأحہتأتًشأىتشتعڲۏأڬەأؼتهوأوۏڽأ؏أوۏڽأىەأًۄأمثتذحۏڽأثۏتىأڬشأزۏڽأدًأوۏڽأىەأتضأوۏڽأځتةۏڽأۗأتههۄأڬۏأمضوأ$أوۏڽأىەأزًىًڽأثتحۏڽأۄۏأضډأڬۄۏأۄۏڽأۗأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أثؼعأثۏتىأثہۏأدتزًأڬتأضتأتخشأشڬہحەأۄۏڽأۗأذعشحأتثًثڬشۄأتىظتشۏأشعۏأتههۄأؼىۄأڬەأثتشەأوۏڽأثہۏأوشًۏأۄەأڬۄأتضأودهضأوۏڽأًۄأثہۏأوًدًزأحہەأۗأ"
"6569","أذعشحأتثًثڬشۄألشوتحەأۄۏڽأ=أۄوأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأحہەأ؏أثىۏأحوۏوأڬتأتۏڬأًلزأىثۏأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأإۏتأ؏أتىأوۏڽأمۏضأثىأؼتظوأ؏أؼوشًأثىأتۄحوأتًشأصثشمتىأثىأثزشأثہۏأحہەأ؏أىثۏأتڬشوأ﷽أىەأؼوشًأثىأتۄحوأشعۏأتههۄأؼىۄأضەألشوتۏتأ=أصثشمتىأثىأثزشأڬەأثتشەأوۏڽأحوۄتشۏأڬۏتأشتةەأۄەأآأتىۄًڽأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أتضأڬەأمثۏهەأوۏڽأتضأڬۏأثتحأوتىۏأدتحۏأۄەأ؏أثۄتزشأإزوۏأۄەأ؏أتځىەأمثۏهەأڬەأؼهتًۄأزۏڲشأهًڲًڽأڬًأڬډہأىۄۏڽأزۏحتأۗأصثشمتىأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أتضأىەأوۏشەأثتشەأوۏڽأدًأڬډہأثۏتىأڬۏتأۄەأ؏أۏۄأتضأضەأثہۏأصۏتزۄأدتىحتأۄەأهۏڬىأذضزأڬۏأًدۄأضەأثۏتىأىۄۏڽأڬشأشۄتأۗأؼوشًأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أتههۄأڬۏأمضوأ$أۏۄأطرظأثەأوشًحأۄەأ؏أڬىدًضأۄەأ؏أڬوۏىۄأۄەأ؏أرتىزتىۏأتذومأۄەأۗأتههۄأڬۏأمضوأ$أوۏڽأىەأځۄهەأثہۏأدہًټأىۄۏڽأڬۄتأحہتأتًشأزًضشۏأثتشأثہۏأضډأثًهتأۄەأ؏أهۏڬىأ+أتظهأثتحأۏۄأۄەأڬۄأ"
"6570","أتثًؼثۏزۄأوؼوشأثىأوخىۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أظؼظؼۄأثىأوؼتًۏۄأثىأذظۏىأثىأؼوۏشأثىأؼثتزۄأثىأىصتهأثىأوشۄأثىأؼثۏزأثىأومتؼضأثىأؼوشًأثىأڬؼثأثىأضؼزأثىأصۏزأوىتۆأثىأحوۏوأ‛‛أدًأڬۄأذعشحأتذىلأثىأمۏضأڬەأډډتأۄۏڽأۗأ"
"6571","%أتذىلأڬەأډډتأذعشحأظؼظؼۄأثىأمۏضألشوتحەأۄۏڽأ=أوۏڽأىثۏأتڬشوأ﷽أڬەأځتضأڲۏتأ؏أوۏڽأىەأإځأ﷽أڬًأۏۄأإۏتحأځڔہحەأۄًةەأضىتأ="
"6572","أوظؼثأثىأؼثزتههۄألشوتحەأۄۏڽأ=أتذىلأثىأمۏضأثىأذظۏىأثىأىصتهأثىأؼثۏزۄأ؏أورعشوأۄەأۗأتىۄًڽأىەأشضًهأتههۄأ﷽أڬتأصوتىۄأځتۏتأ؏أتًشأشضًهأتههۄأ﷽أڬۏأصۏتشحأڬەأهةەأضلشأثہۏأڬۏتأحہتأ؏أشضًهأتههۄأ﷽أىەأتىأڬەأهةەأزؼتأثہۏألشوتةۏأحہۏأۗأتذىلأڬتأتظهأىتوأ““أعذتڬأ‛‛أحہتأتًشأثؼعأواشرۏىأڬتأڬۄىتأۄەأڬۄأتىأڬتأتظهۏأىتوأ““أظرشأثىأمۏضأثىأوؼتًۏۄأثىأذظۏىأ‛‛أۄەأۗأإځأځۏزتةطۏأتذىلأۄۏڽأۗأتىأڬۏأًتهزۄأڬۄتأڬشحۏأحہۏڽأ=أتههۄأڬۏأمضوأ$أتڲشأتضأڬەأځتاڽأوۏڽأ““أذىلأ‛‛أ+أهىڲڔتۄټأ"
"6573","أتذىلأثىأمۏضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحأؼخوتىأؽىۏأشعۏأتههۄأؼىۄأڬەأزًشأذڬًوحأوۏڽأ؏أوۏڽأثۏحأتههۄأطشۏلأڬتأغًتلأڬشأشۄتأحہتأ؏أثىۏأهۏخأڬەأتۏڬأإزوۏأىەأإأڬشأوۏشتأۄتحہأځڬڔتأتًشأڬۄىەأهڲتأ=أڬۏتأوۏڽأحوۄۏڽأتۏڬأرًطرثشۏأىۄأزًڽأآأوۏڽأىەأڬۄتأ=أڬۏًڽأىۄۏڽأآأتضأىەأڬۄتأ=أڬۏتأحوۄۏڽأۏتزأۄەأدثأشضًهأتههۄأ﷽أىەأودہەأحوۄتشۏأمًوأثىۏأضؼزأڬۏأدتىثأثہۏدتأحہتأتًشأوۏڽأىەأدتأڬشأتىأڬًأتضهتوأڬۏأزؼًحأځۏطأڬۏأحہۏأ؏أتضأځشأحوأىەأودہەأڬۄتأحہتأ=أثەأطڬأحًأثہهتةۏأڬۏأدتىثأثهتحتأۄەأتًشأثہهتةۏأڬتأذڬوأزۏحتأۄەأ؏أوۏڽأىەأۏۄأثتحأشضًهأتههۄأ﷽أحڬأځۄىډتةۏأحہۏأ؏أ+أحوۄتشۏأۏۄأثتحأضىأڬشأ"
"6574","أرهۏلۄأثىأرۏتغألشوتحەأۄۏڽأ=أتضًزأثىأضشۏؼأثىأذوۏشأثىأؼثتزۄأثىأىصتهأثىأوشۄأثىأؼثۏزۄأ‛‛ۗأدتوؼأوضدزأڬەأمشۏثأثىۏأحوۏوأڬەأضتحہأوحظهأتىأڬتأڲہشأحہتأۗأذعشحأوؼتًۏۄأشعۏأتههۄأؼىۄأڬەأزًشأذڬًوحأوۏڽأإځأڬۏأًلتحأۄًةۏأۗأ"
"6575","%أذعشحأذضىألشوتحەأۄۏڽأ=أذعشحأتضًزأثىأضشۏؼأشعۏأتههۄأؼىۄأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أ$أڬۏتأوۏڽأإځأڬًأًۄأذوزۏۄأتطؼتشأىۄأضىتاڽأدًأوۏڽأىەأتههۄأحؼتهۏٳأڬۏأذوزأًأخىتؤأوۏڽأهڬہەأۄۏڽأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أثەأطڬأتههۄأحؼتهۏٳأذوزأڬًأځضىزألشوتحتأۄەأ؏أتضأضەأصۏتزۄأإځأىەأڬډہأىۄۏڽألشوتۏتأۗ"
"6576","%أذعشحأتضًزأثىأضشۏؼأحوۏوۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىثۏأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأ؏أوۏڽأىەأڬۄتأ=أتەأتههۄأڬەأىثۏأ$أوۏڽأىەأڬډہأتطؼتشأڬۄەأۄۏڽأدىأوۏڽأتههۄأحؼتهۏٳأڬۏأذوزأًأخىتؤأڬۏأۄەأتًشأإځأڬۏأثہۏأوزذأڬۏأۄەأ؏أإځأ﷽أىەألشوتۏتأ=أحوأىەأتههۄأحؼتهۏٳأڬۏأذوزأڬەأضهضهەأوۏڽأدًأتطؼتشأهڬہەأۄۏڽأًۄأضىتاأ؏أتًشأدًأوۏشەأثتشەأوۏڽأهڬہەأۄۏڽأًۄأشۄىەأزًأ؏أډىتىډۄأوۏڽأىەأتطؼتشأضىتىتأطشًؼأڬةەأ؏أتۏڬأغًۏهأتهمتوحأمىتؼحأځضىزأطرظأتىزشأإۏتأۗأتضأڬەأإحەأۄۏأإځأ﷽أىەأودہەأځڔہىەأضەأشًڬأزۏتأ؏أدثأًۄأډهتأڲۏتأحًأإځأ﷽أىەأزًثتشۄألشوتۏتأ=أضىتاأ؏أوۏڽأىەأځہشأضىتىتأطشًؼأڬشأزةۏەأ؏أتثہۏأصۏتزۄأًمحأىۄۏڽأڲصشتأحہتأڬۄأًۄأإزوۏأځہشأإأڲۏتأتًشأإځأ﷽أىەأځہشأودہەأځڔہىەأضەأشًڬأزۏتأ؏أدثأًۄأډهتأڲۏتأحًأإځأ﷽أىەأودہەأځہشألشوتۏتأڬۄأځڔہًأ؏أوۏڽأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أۏۄأطرظأڬًىأۄەأآأدثأۏۄأتىزشأإحتأۄەأحًأإځأودہەأډځأڬشًتأزۏحەأۄۏڽأتًشأدثأډهتأدتحتأۄەأحًأإځأزًثتشۄأضىىتأطشًؼألشوتأزۏحەأۄۏڽأۗأإځأ﷽أىەألشوتۏتأ=أۏۄأؼوشأثىأرغتثأۄەأتًشأتضأوۏڽأثتغهأڬۏأڬًةۏأډۏصأىۄۏڽأۄەأۗ"
"6577","أطثتثأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أدتشۏۄأثىأمزتوۄأثىأصۄۏشأثىأذظۏىأثىأشثتذأثىأضؼزأثىأۏذۏۏأثىأشثۏؼۄأثىأڬؼثأ‛‛ۗأتىأڬۏأڬىۏحأ““أتثًتهًهۏزأتًشأتثًۏصۏزأ‛‛أۄەأۗأثذتشۏۄأوذهەأوۏڽأثظشۄأڬەأتىزشأتىأڬتأوڬتىأحہتأۗأ"
"6578","أذعشحأدتشۏۄأثىأمزتوۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أودہەأڬًةۏأتۏڬأثتحأثحتأزۏدةەأدًأوۏشەأهةەأثۄحأوىتلؼأثرطأۄًأتًشأورحظشأثہۏأۄًأحتڬۄأوۏڽأتضأڬًأۏتزأڬشأهًڽأ؏أىثۏأتڬشوأ﷽أىەألشوتۏتأ=أؽظۄأڬشىتأډہًڔأزًأ؏أۏۄأثتحأذعًشأ﷽أثتشأثتشأڬۄحەأشۄەأ؏أؽظۄأوحأڬشًأ؏أؽظۄأوحأڬشًأۗأ"
"6579","أذعشحأؼشًۄأثىأصثۏشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أ<أۄدشۏأوۏڽأدثأهًڲأذدأڬەأهةەأإةەأحًأتضأضتهأذعشحأوؽۏشۄأثىأطؼثۄأشعۏأتههۄأؼىۄأڬەأډډتأذعشحأؼشًۄأثىأوضؼًزأخملۏأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًةەأ؏أځہشأتىۄًڽأىەأتځىۏأمًوأوۏڽأًتځضأدتىەأڬۏأتدتصحأوتىڲۏأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أودہەأرزطۄأۄەأڬۄأهًڲأحوۄۏڽأوتشأڋتهۏڽأڲەأ؏أتىۄًڽأىەأڬۄتأ=أتڲشأًۄأهًڲأودہەأضًحتأځتةۏڽأڲەأحًأدڲتأهۏڽأڲەأۗأشضًهأتههۄأ﷽أىەأتىأڬًأًتځضأدتىەأڬۏأتدتصحأزەأزۏأ؏أډىتىډۄأًۄأوضهوتىأۄًأڬشأتځىۏأمًوأوۏڽأًتځضأهًټەأ؏أإځأؼطتؤأڬەأًمحأتځىۏأثضحۏأوۏڽأځۄىډەأ؏أتىأڬەأځتضأڬډہأهًڲأإةەأ؏أتىۄًڽأىەأتىأهًڲًڽأڬًأتضهتوأڬۏأزؼًحأځۏطأڬۏأۗأهۏڬىأتىأهًڲًڽأىەأتىأڬًأثۄحأثشتأثہهتأڬۄتأ؏أتىأڬۏأثتحأىۄأوتىۏأ؏أتًشأتىأڬًأًۄأًۄأثتحۏڽأضىتةۏڽأ؏أدىأڬتأتىۄۏڽأًۄوأًأڲوتىأثہۏأىۄأحہتأ؏أًۄأهًڲأًتځضأډهەأڲةەأ؏أدثأضذشۏأڬتأًمحأۄًتأ؏أحًأذعشحأؼشًۄأىەأتځىەأڲہشأڬەأظذىأوۏڽأڬہڔەأۄًأڬشأىوتصأڬەأهةەأتستىأزۏأ؏أڬهوۄأطۄتزحأځڔہتأ؏أمثۏهۄأخمۏلأڬەأتۏڬأإزوۏأىەأتىأڬًأحۏشأوتشتأدضأڬۏأًدۄأضەأإځأطۄۏزأۄًأڲةەأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أؼشًۄأڬۏأوختهأظتذثأۏتضۏىأڬۏأضۏأۄەأ؏أتىۄًڽأىەأثہۏأتځىۏأمًوأڬًأتههۄأحؼتهۏٳأڬۏأدتىثأزؼًحأزۏأتًشأهًڲًڽأىەأتىأڬًأطۄۏزأڬشأزۏتأۗأ"
"6580","أرهۏلۄأثىأرۏتغأتىأڬتأىضثأثۏتىأڬشحەأۄًةەألشوتحەأۄۏڽأ““أودتطؼأثىأوضؼًزأثىأخؼهثۄأثىأًۄثأثىأؼتةسأ‛‛أتىأڬۏأڬىۏحأ““أتثًضهۏوتىأ‛‛أۄەأۗأتىأڬۏأًتهزۄأتًشأتىأڬەأثہتةۏأڬۏأًتهزۄأ““أوهۏڬۄأثىحأضلۏتىأثىأذتشخأثىأهثۏزأثىأرصۏوۄأ‛‛أۄۏڽأۗأذعشحأودتطؼأشعۏأتههۄأؼىۄأ69أۄدشۏأڬًأدىڲأدوهأتظؽشأوۏڽأطۄۏزأۄًةەأ؏أثىۏأضزًضأڬەأضتوىەأثىۏأضهۏوأوۏڽأتځىۏأذًۏهۏأوۏڽأزلىأۄًةەأۗأثظشۄأوۏڽأثہۏأتىأڬتأتۏڬأڲہشأحہتأدًأڬۄأدتوؼأوضدزأثظشۄأڬەأضتوىەأحہتأۗأ"
"6581","أذعشحأودتطؼأثىأوضؼًزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=ألحذأوڬۄأڬەأثؼزأوۏڽأتځىەأثہتةۏأودتهزأڬًأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأهتۏتأ؏أوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أوۏڽأتځىەأثہتةۏأودتهزأڬًأإځأڬۏأرزوحأوۏڽأهتۏتأۄًڽأحتڬۄأإځأۄدشحأځشأتضأڬۏأثۏؼحأهەأهۏڽأۗأإځأ﷽أىەألشوتۏتأ=أۄدشحأڬتأخًتثأحًأوۄتدشۏىأهەأڲةەأۄۏڽأۗأوۏڽأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أحًأإځأڬضأثتحأځشأتضأڬۏأثۏؼحأهۏڽأڲەأآأإځأ﷽أىەألشوتۏتأ=أتضهتوأ؏أتۏوتىأتًشأدۄتزأځشأوۏڽأتضأڬۏأثۏؼحأهًڽأڲتأۗأ"
"6582","أرهۏلۄأثىأرۏتغأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أؼوشًأثىأؼثضۄأثىأؼتوشأثىأرتهزأثىأؽتعشۄأثىأؼحتثأثىأتوشةأتهمۏضأ‛‛ۗأتىأڬۏأًتهزۄأ““أشوهۄأثىحأًمۏؼۄأ‛‛أۄۏڽأ؏أتىأڬتأحؼهمأثىۏأذصتوأضەأۄەأ؏أإځأذعشحأتثًسشأؽلتشۏأشعۏأتههۄأؼىۄأڬەأوتڽأطشۏڬأثہتةۏأۄۏڽأۗأطتوأڬەأشۄىەأًتهەأۄۏڽأۗأتىأڬۏأڬىۏحأ““أتثًۏذۏۏأ‛‛أۄەأۗأ"
"6583","أذعشحأؼوشًأثىأؼثضۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأوتهأؽىۏوحأڬەأتًىټًڽأڬەأثتڔەأوۏڽأىوتصأځڔہتةۏأ؏أدثأضهتوأځہۏشتأحًأتًىټأڬۏأتًىأۄتحہأوۏڽأځڬڔأڬشألشوتۏتأ=أتضأؽىۏوحأوۏڽأضەأوۏشەأهةەأظشلأتحىتأځتىډًتڽأذظۄأۄۏأذهتهأۄەأ؏أتًشأځتىډًتڽأذظۄأحوأځشأهًټتۏتأدتةەأڲتأۗأ"
"6584","%أذعشحأؼوشًأثىأؼثضۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬەأتؼهتىأىثًحأڬەأتًتةهأوۏڽأ؏أوۏڽأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأ؏أذعًشأ﷽أتىأزىًڽأډہځأڬشأحثهۏؽأڬشحەأحہەأۗ"
"6585","أرهۏلۄأثىأرۏتغألشوتحەأۄۏڽأ=أدتثشأثىأضوشۄأضًتةۏأ؏أتىأڬۏأڬىۏحأ““أتثًرتهزأ‛‛أۄەأ؏أثؼعأواشرۏىأڬتأڬۄىتأۄەأڬۄأتىأڬۏأڬىۏحأ““أتثًؼثزتههۄأ‛‛أۄەأۗأثطشأثىأوشًتىأڬەأزًشأذڬًوحأوۏڽأتىأڬۏأًلتحأۄًةۏأۗأ"
"6586","أذعشحأدتثشأثىأضوشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأحہتأ؏أإځأ﷽أىەألشوتۏتأ=أتضأتوحأڬتأوؼتوهۄأۄوۏطۄأؽتهثأشۄەأڲتأذحۏٳأڬۄأ45أرهۏلەأمتةوأۄًڽأڲەأ؏أتضأڬەأثؼزأتۏڬأتًشأثہۏأثتحأڬۄۏأ؏أهۏڬىأتضأڬۏأإًتصأودہأحڬأىۄۏڽأځۄىډۏأ؏أتضأودهضأوۏڽأوۏشەأًتهزأظتذثأشضًهأتههۄأ﷽أڬەأثۄحأمشۏثأثۏټہەأۄًةەأحہەأ؏أوۏڽأىەأتىأضەأځًډہتأڬۄأذعًشأ﷽أىەأڬۏتألشوتۏتأحہتأآأتىۄًڽأىەأثحتۏتأڬۄأإځأ﷽أىەألشوتۏتأحہتأ““أًۄأحوتوأرهۏلەأمشۏطأضەأحؼهمأشڬہحەأۄًڽأڲەأۗ‛‛أدتثشأثىأضوشۄأشعۏأتههۄأؼىۄأىەأتځىەأًتهزأڬەأذًتهەأضەأتۏڬأتًشأذزۏخأثہۏأشًتۏحأڬۏأۄەأۗأ"
"6587","أذعشحأدتثشأثىأضوشۄأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ+أًۄألشوتحەأۄۏڽأ"
"6588","أرهۏلۄأثىأرۏتغألشوتحەأۄۏڽأ=أذعشحأتثًدذۏلۄأًۄثأثىأؼثزتههۄأضًتةۏأشعۏأتههۄأؼىۄأثطشأثىأوشًتىأڬەأزًشأذڬًوحأوۏڽألًحأۄًةەأۗأ"
"6589","أؼًىأثىأتثۏأدذۏلۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ=أوۏڽأتځىەأډډتأڬەأضتحہأىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأوًدًزأحہتأ؏أإځأ﷽أىەألشوتۏتأ=أوۏشۏأتوحأڬتأوؼتوهۄأزشضحأشۄەأڲتأۏۄتڽأحڬأڬۄأ45أرهلتؤأڲصشأدتةۏڽأۗأځہشأتۏڬأتًشأثتحأثہۏأثًهۏأهۏڬىأإًتصأثۄحأځضحأحہۏأدضأڬۏأًدۄأضەأوۏڽأضىأىۄۏڽأضڬتأ؏أوۏڽأىەأتځىەأډډتأضەأځًډہتأ=أتەأډډتأدتىأ$أشضًهأتههۄأ﷽أىەأوصۏزأڬۏتألشوتۏتأحہتأآأډډتأىەأثحتۏتأڬۄأذعًشأ﷽أىەألشوتۏتأ=““أحوتوأرهلتؤأمشۏطأضەأۄًڽأڲەأۗ‛‛أ"
"6590","أرهۏلۄأثىأرۏتغأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أؼخوتىأثىأتثۏأتهؼتظأثىأڬخۏشأثىأزۄوتىأثىأؼثزتههۄأثىأۄوتوأثىأتثتىأثىأۏضتشأثىأوتهڬأ‛‛ۗأتىأڬۏأڬىۏحأ““أتثًؼثزتههۄأ‛‛أحہۏأۗأ83أۄدشۏأوۏڽأتىأڬتأتىحمتهأۄًتأۗأ"
"6591","أذعشحأؼخوتىأثىأتثۏأتهؼتظأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتىۄۏڽأذڬوأزۏتأڬۄأغتةلأوۏڽأتضأومتوأځشأوضدزأثىتةۏأدتةەأدۄتڽأځشأتىأهًڲًڽأڬەأثحأۄًحەأحہەأۗأ"
"6592","أوظؼثأثىأؼثزتههۄأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أؼتوشأثىأًتخهۄأثىأؼثزتههۄأثىأؼوشًأثىأدذطأثىأذۏتىأثىأضؼزأثىأهۏخأ‛‛ۗأإځأدىڲأتذزأًتهەأضتهأځۏزتأۄًةەأ؏أتًشأىثۏأتڬشوأ﷽أڬۏأصىزڲۏأڬەأ;أضتهأځتةەأ؏أتضأڬەأثؼزأإځأڬًلۄأوۏڽأوىحمهأۄًأڲةەأتًشأًلتحأحڬأًۄۏڽأشۄەأ؏أ435أۄدشۏأوۏڽأتىأڬتأتىحمتهأۄًتأتًشأظذتثۄأڬشتوأوۏڽأضثأضەأإرشأوۏڽأتىأڬتأتىحمتهأۄًتأۗأ"
"6593","أذعشحأتثًتهغلۏهألشوتحەأۄۏڽأ=أوۏڽأىەأشضًهأتههۄأ﷽أڬۏأذۏتحأوثتشڬۄأڬەأ;أضتهأځتةەأۄۏڽأ؏أتًشأوۏشۏأځۏزتةطأدىڲأتذزأًتهەأضتهأۄًةۏأۗأ"
"6594","أطثتثأؼظلشۏأڬۄحەأۄۏڽأ=أذعشحأتثًتهغلۏهأؼتوشأثىأًتخهۄأشعۏأتههۄأؼىۄأضىأ433أۄدشۏأوۏڽألًحأۄًةەأۗأ"
"6595","أذعشحأتثًتهغلۏهألشوتحەأۄۏڽأ=أوۏڽأثډۄأحہتأ؏أوۏڽأتًىټأڬۏأڲشزىأځشأډڔہأڲۏتأتًشأشضًهأتههۄأ﷽أڬۏأصۏتشحأڬۏأ؏أإځأ﷽أدؼشتىۄأوۏڽأڲًطحأحمضۏوألشوتأشۄەأحہەأ؏أتضۏأتخىتؤأوۏڽأتۏڬأؼًشحأإةۏأ؏أشضًهأتههۄأ﷽أىەأتضأڬەأهةەأتځىۏأډتزشأوثتشڬأثډہتأزۏأ؏أوۏڽأىەأځًډہتأ=أۏتأشضًهأتههۄأ﷽أۏۄأرًطأىظۏثأرتحًىأڬًىأۄەأآأإځأ﷽أىەألشوتۏتأ=أۏۄأوۏشۏأشعتؼۏأوتڽأۄەأۗأ"
"6596","أرهۏلۄأثىأرۏتغأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أضشتمۄأثىأوتهڬأثىأدؼطوأ‛‛ۗأتىأڬتأحؼهمأثىۏأوزهدأثىأوشۄأثىأؼثزأوىتۆأثىأؼهۏأثىأڬىتىۄأڬەأضتحہأۄەأۗأوذوزأثىأؼوشأڬۄحەأۄۏڽأ=أذعشحأضشتمۄأثىأوتهڬأشعۏأتههۄأؼىۄأمزۏزأوۏڽأشۄتأڬشحەأحہەأ؏أضىأ57أۄدشۏأڬًأتىأڬتأتىحمتهأۄًتأۗأ"
"6597","أذعشحأضشتمۄأثىأوتهڬأثىأدؼطوأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتىأڬًأتشطتزألشوتۏتأ=أتەأضشتمۄأ$أڬۏتأوۏڽأحوۄۏڽأدىحۏًڽأتًشأزًصرۏًڽأڬەأثتشەأوۏڽأىۄأثحتاڽأآأوۏڽأىەأڬۄتأ=أڬۏًڽأىۄۏڽأۏتأشضًهأتههۄأۗأإځأ﷽أىەألشوتۏتأ=أۄشأوحڬثشأ؏أثزوصتدأتًشأؽشًشأڬشىەأًتهتأزًصرۏأۄەأدثڬۄأڬوصًشأتًشأوؽهًثأهًڲأدىحۏأۄۏڽأۗأ"
"6598","أذعشحأضشتمۄأثىأوتهڬأثىأدؼطوأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأثغذتؤأوۏڽأۄوۏڽأرغثۄأزۏحەأۄًةەأتشطتزألشوتۏتأ=أمۏتوحأحڬأؼوشۄأذدأوۏڽأزترهأۄەأۗأضشتمۄأثىأوتهڬأشعۏأتههۄأؼىۄأ؏أڬؼثأثىأوتهڬأڬەأثہتةۏأۄۏڽأۗأ"
"6599","أذعشحأڬؼثأثىأوتهڬأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأذعشحأضشتمۄأثىأوتهڬأشعۏأتههۄأؼىۄأىەأشضًهأتههۄأ﷽أضەأځًډہتأڬۄأتڲشأڬضۏأڬتأڬًةۏأڲوطزۄأثہًهتأثہټڬتأدتىًشأۄوتشەأذًعأځشأإأدتةەأ؏أتڲشأۄوأتضأڬًأځۏټأثہشأڬشأډتشتأڬہهتةۏڽأحًأڬۏتأتضأوۏڽأثہۏأۄوۏڽأتدشأوهەأڲتأآأشضًهأتههۄأ﷽أىەألشوتۏتأ=أۄشأحشأدڲشأًتهەأ+أۏؼىۏأسۏأشًذأ"
"6600","أذعشحأضشتمۄأثىأوتهڬأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أۄشأڲشوأدڲشأًتهۏأډۏصأ+أۏؼىۏأۄشأدتىزتشأڬًأڬہهتىەأځهتىەأ"
"6601","أوظؼثأثىأؼثزتههۄأصثۏشۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أعشتشأثىأتصًشأ‛‛أڬتأتظهأىتوأ““أوتهڬأثىأتًضأثىأرصۏوۄأثىأشثۏؼۄأثىأوتهڬأثىأخؼهثۄأثىأزًزتىأثىأتضۏزأثىأرصۏوۄأثىأوزشڬۄأثىأتهۏتضأثىأوعشأ‛‛أۄەأۗأإځأڬًلۄأوۏڽأشۄتةطأځسۏشأشۄەأتًشأۏۄۏڽأځشأإځأڬتأتىحمتهأۄًتأۗأ"
"6602","%أذعشحأعشتشأثىأتصًشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىثۏأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأ؏أوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أإځأتځىتأۄتحہأإڲەأثڔہتةۏەأ؏أحتڬۄأوۏڽأتضهتوأځشأإځأڬۏأثۏؼحأڬشًڽأۗأ+أذعًشأ﷽أىەأتځىتأۄتحہأثڔہتۏتأ"
"6603","أذعشحأعشتشأثىأتصًشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أوۏشەأځتضأضەأڲصشەأ؏أوۏڽأتضأًمحأزًزہأزًۄأشۄتأحہتأ؏أإځأ﷽أىەألشوتۏتأ=““أزتؼۏأتههثىأ‛‛أډہًڔأزۏتأڬشًأۗأزتؼۏأتههثىأڬۏأحطشۏذأذزۏخأىوثشأ8375أڬەأحذحأدهزأىوثشأ7أوۏڽأڲصشأډڬۏأۄەأ"
"6604","أطثتثأؼظلشۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أًتثظۄأثىأوؼثزأثىأمۏضأثىأڬؼثأثىألۄزأثىأوىمسأثىأذتشخأثىأخؼهثۄأثىأزًزتىأثىأتضزأثىأرصۏوۄأ‛‛أإځأڬًلۄأوۏڽأمۏتوأځسۏشأشۄەأ؏أځہشأتۏڬأدصۏشۄأوۏڽأډهەأڲةەأتًشأًۄۏڽأتىأڬتأتىحمتهأۄًتأۗأ"
"6605","أذعشحأًتثظۄأثىأوؼثزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدتىًشًڽأڬۏأځۏټہًڽأڬًأوىثشأوحأثىتاأ؏أتًشأتىأدتىًشًڽأوۏڽأضثأضەأثشتأ““أرډشأ‛‛أۄەأ+أوىصهأځشأځۄىډأڬشأدتىًشأڬەأتًځشأۄۏأىۄۏڽأثۏټہەأشۄىتأډتۄۏەأثهڬۄأتضأضەأتحشأدتىتأډتۄۏەأ"
"6606","أطثتثأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أرشۏوأثىألتحڬأثىأترشوأثىأطزتزأثىأؼوشًأتضزۏأ‛‛ۗأ"
"6607","%أذضىأثىأوذوزأثىأؼهۏأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأتۏڬأزىأذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأىەأذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأضەأڬۄتأ=أإځأودہەأڬًةۏأتۏضۏأذزۏخأضىتةۏڽأدًأودہەأذۏشتىأڬشأزەأۗأتىۄًڽأىەأڬۄتأ=أودہەأرشۏوأثىألتحڬأتضزۏأشعۏأتههۄأؼىۄأىەأثحتۏتأڬۄأوۏڽأتۏڬأوشحثۄأتځىەأتًىټًڽأڬًأهەأڬشأىڬهتأ؏أحۏصأثتشطأوۏڽأوۏشەأتًىټأځشأإضوتىۏأثدهۏأڲشۏأ؏أتًشأتًىټأڲشأڲۏتأ؏أوۏڽأىەأتضأڬۏأتۏڬأټتىڲأڬەأضتحہأټۏڬأهڲتةۏأ؏أۏۄأًمحأشضًهأتههۄأ﷽أڬەأػتۄشأۄًىەأڬتأحہتأ؏أځہشأوۏڽأىەأڬۄتأ=““أتؼًسأثؼػۏوأۄستأتهًتزۏأ+أۏؼىۏأوۏڽأتضأؼػۏوأًتزۏأڬۏأځىتۄأوتىڲحتأۄًڽأ"
"6608","أذعشحأرشۏوأثىألتحڬأشعۏأتههۄأؼىۄأڬەأثتشەأوۏڽأوشًۏأۄەأڬۄأًۄأىثۏأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأإةەأ؏أىثۏأتڬشوأ﷽أىەألشوتۏتأ=أتەأرشۏوأثىألتحڬأ$أتڲشأحۏشەأتىزشأزًأرظهحۏڽأىۄأۄًحۏڽأحًأحوأضثأضەأڬتوهأوشزأۄًحەأۗأتىۄًڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أًۄأڬًىأضۏأؼتزحۏڽأۄۏڽأآأإځأ﷽أىەألشوتۏتأ=أحۏشۏأصهلۏڽأثۄحأزشتصأۄۏڽأتًشأحۏشتأحۄثىزأىۏډەأهټڬحتأۄەأۗأذعشحأرشۏوأىەأتضۏأًمحأدتأڬشأثتهأثہۏأډہًټەأڬشًتأهةەأتًشأحۄثىزأثہۏأډہًټتأڬشًتأهۏتأۗأ"
"6609","أطثتثأؼظلشۏأتىأڬتأىضثأۏًڽأثۏتىأڬشحەأۄۏڽأ““أتضتوۄأثىأؼوۏشأثىأؼتظوأثىأؼثۏزتههۄأثىأذىۏلأثىأۏضتشأثىأىتدۏۄأثىأؼوشًأثىأذتشخأثىأغتثرۄأثىأهذۏتىأثىأۄسۏهأ‛‛ۗأۏۄأذعشحأتثًتهوهۏذأشعۏأتههۄأؼىۄأڬەأًتهزأۄۏڽأ؏أثظشۄأوۏڽأمۏتوأځسۏشأشۄەأۗأ"
"6610","أذعشحأتضتوۄأثىأؼوۏشأشعۏأتههۄأؼىۄأضەأوشًۏأۄەأڬۄأتىۄًڽأىەأىثۏأتڬشوأ﷽أڬەأۄوشتۄأىوتصألدشأتزتأڬۏأ؏أإځأىثۏأتڬشوأ﷽أڬەأثۄحأمشۏثأڬہڔەأحہەأ؏أىثۏأتڬشوأ﷽أىەأزًأورحظشأشڬؼحۏڽأځڔہتةۏڽأځہشأۏًڽأزؼتأوتىڲۏأ““أتەأتههۄأ$أتەأدثشتةۏهأ؏أوۏڬتةۏهأ؏أتضشتلۏهأتًشأوذوزأ﷽أڬەأشثأ؏أوۏڽأإڲأضەأحۏشۏأځىتۄأوتىڲحتأۄًڽأۗأۏۄأزؼتأذعًشأ﷽أىەأحۏىأوشحثۄأوتىڲۏأۗأ"
"6611","أتثًؼثۏزۄأوؼوشأثىأوخىۏألشوتحەأۄۏڽأ““أإثۏأتههذوأڬتأىتوأؼثزتههۄأثىأؼثزتهوهڬأثىأؼثزتههۄأثىأؼلتىأ‛‛أۄەأۗأإځأطشۏلأحہەأطتؼشأحہەأ؏أدىڲأذىۏىأوۏڽأطشۏڬأۄًةەأحہەأ؏أتضأوًمؼأځشأتىأڬەأۄوشتۄأتىأڬتأإصتزأڬشزۄأؽهتوأ““أؼوۏشأ‛‛أثہۏأحہتأۗأتثًؼثۏزۄأڬۄحەأۄۏڽأ=أتىأڬًأإثۏأتههذوأتضأهةەأڬۄتأدتحتأحہتأڬۄأۏۄأڲًطحأڬہتىەأضەأتىڬتشأڬۏتأڬشحەأحہەأ؏أ+أتًشأإثۏأڬتأوؼىۏأۄەأ““أتىڬتشأڬشىەأًتهتأ‛‛أ"
"6612","أطثتثأىەأثہۏأتىأڬتأوسڬًشۄأثتهتأىضثأثۏتىأڬۏتأۄەأ؏أتًشأځہشألشوتۏتأ=أوذوزأثىأؼوشأڲًطحأڬہتىەأضەأتىڬتشأڬشأزۏتأڬشحەأحہەأ؏أإځأومتوأ““أظلشتؤأ‛‛أوۏڽأټہۄشەأحہەأ؏أۏۄأومتوأوزۏىۄأوىًشۄأضەأحۏىأوۏهأڬۏأوضتلحأځشأًتمؼأۄەأ؏أتًشأتىأڬتأإصتزأڬشزۄأؽهتوأ““أؼوۏشأ‛‛أثہۏأتىأڬەأۄوشتۄأومتوأظلشتؤأوۏڽأټہۄشتأحہتأۗأ"
"6613","أإثۏأتههذوأشعۏأتههۄأؼىۄأڬەأإصتزأڬشزۄأؽهتوأ““أؼوۏشأ‛‛أڬۄحەأۄۏڽأ=أوۏشەأإمتأىەأودہەأذڬوأزۏتأڬۄأوۏڽأتىأڬەأهةەأڲًطحأثہًىًڽأ؏أوۏڽأڲًطحأثہًىأشۄتأحہتأڬۄأتۏڬأوضڬۏىأإأڲۏتأ؏أوۏڽأىەأًۄأڲًطحأوضڬۏىأڬًأڬہهتأزۏتأ؏أتضأځشأوۏشەأإمتأىەأودہەأثۄحأوتشتأ؏أوۏڽأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأإۏتأتًشأتضأڬۏأطڬتۏحأڬشأزۏأۗأىثۏأتڬشوأ﷽أىەأتضأڬًأثهًتۏتأ؏أتًشأتىأضەأتىأڬًأوتشىەأڬۏأًدۄأځًډہۏأ؏أتىۄًڽأىەأڬۄتأ=أتضأىەأوۏشۏأتدتصحأڬەأثؽۏشأوۏشتأڬہتىتأڬضۏأتًشأڬًأڬہهتأزۏتأ؏أىثۏأتڬشوأ﷽أىەألشوتۏتأ=أتضأځشأدًأخًتثأوهەأڲتأًۄأحوأزًىًڽأڬًأوهەأڲتأۗأ"
"6614","أإثۏأتههذوأشعۏأتههۄأؼىۄأڬەأإصتزأڬشزۄأؽهتوأذعشحأؼوۏشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأتذدتشأصۏحأڬەأومتوأځشأزًىًڽأۄحہۏهۏتڽأتټہتأڬشأثتشطأڬەأىصًهأڬۏأزؼتأوتىڲحەأۄًةەأزۏڬہتأۗأ"
"6615","أوظؼثأثىأؼثزتههۄأصثۏشۏأتىأڬتأىضثأۏًڽأثۏتىأڬشحەأۄۏڽأ““أؼوشًأثىأتوۏۄأثىأرًۏهزأثىأؼثزتههۄأثىأتۏتضأثىأؼثۏزأثىأىتطشۄأثىأڬؼثأثىأدزۏأثىأعوشۄأثىأثڬشأثىأؼثزأوىتۆأثىأڬىتىۄأ‛‛ۗأ"
"6616","أذعشحأؼوشًأثىأتوۏۄأتهعوشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتىۄًڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أوۏڽأتځىۏأضًتشۏأڬًأڬہهتأډہًڔأڬشأتههۄأحؼتهۏٳأځشأحًڬهأڬشحتأۄًڽأ+أڬۏتأۏۄأټہۏڬأۄەأآأ"
"6617","أرهۏلۄأثىأرۏتغأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أؼوۏشأثىأضهوۄأثىأوىحتثأثىأغهذۄأثىأدزۏأثىأعوشۄأ‛‛ۗأ"
"6618","أذعشحأؼوۏشأثىأضهوۄأعوشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأزلؼۄأڬتأسڬشأۄەأڬۄأۄوأهًڲأشضًهأتههۄأ﷽أڬەأۄوشتۄأومتوأشًذتؤأڬەأڬضۏأىًتذۏأؼهتمەأوۏڽأضلشأوۏڽأحہەأۗأذعًشأ﷽أتضأًمحأتذشتوأوۏڽأحہەأۗأۄوأىەأتۏڬأڲزہتأزۏڬہتأدضأڬۏأڬًىډۏڽأڬټۏأۄًةۏأحہۏڽأ؏أإځأ﷽أىەألشوتۏتأ=أتضأڬًأډہًڔأزًأۗأتضأڬەأثؼزأتضأڲزہەأڬتأًۄأوتهڬأدضأىەأتضأڬۏأڬًىډۏڽأڬتټۏأحہۏڽأًۄأثۄصأمثۏهەأضەأحؼهمأشڬہىەأًتهتأڬًةۏأطرظأحہتأ؏أًۄأىثۏأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأإۏتأتًشأڬۄىەأهڲتأ=أۏتأشضًهأتههۄأ﷽أۏۄأڲزہتأإځأڬەأهةەأۄۏأحًأحہتأ؏أىثۏأتڬشوأ﷽أىەأذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأڬًأذڬوأزۏتأڬۄأتضأڬًأتځىەأضتحہۏًڽأوۏڽأحمضۏوأڬشأزًأۗأإځأ﷽أځہشأإڲەأډهأزۏةەأ؏أدثأومتوأتختثۄأوۏڽأځۄىډەأحًأۄوأىەأتۏڬأزشرحأڬەأضتةەأوۏڽأتۏڬأۄشىأڬًأځتۏتأ؏أتضأڬًأحۏشأهڲتأۄًتأحہتأ؏أىثۏأتڬشوأ﷽أىەأتۏڬأإزوۏأڬًأڬۄتأڬۄأتؼهتىأڬشأزًأڬۄأڬًةۏأطرظأتضأڬتأڲًطحأىۄأڬہتةەأ؏أډىتىډۄأحوتوأهًڲأتضأڬًأتضۏأغشذأډہًڔأڬشأإڲەأڲصشأڲةەأۗأ"
"6619","أوظؼثأثىأؼثزتههۄألشوتحەأۄۏڽأ=أتثًتهدؼزأتهعوشۏأ+أڬتأىتوأًأىضثأ"
"6620","أذعشحأتثًتهدؼزأعوشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدضأىەأحۏىأدوؼەأضضحۏأڬۏأثىتؤأځشأډہًڔأزۏةەأ؏أتههۄأحؼتهۏٳأتضأڬەأزهأځشأوۄشأهڲتأزۏحتأۄەأۗأ"
"6621","أتثًؼثۏزۄأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أظؼثأثىأدختوۄأثىأمۏضأثىأؼثزتههۄأثىأًۄثأثىأۏؼوشأثىأؼًلأثىأڬؼثأثىأضهوۏأثىأهۏخأ‛‛ۗأذعشحأظؼثأشعۏأتههۄأؼىۄأڬۏأًتهزۄأ““أصۏىثأثىحأذشثأثىأتوۏۄأثىأؼثزطوضأثىأؼثزأوىتلأ‛‛أتثًضلۏتىأڬۏأثۄىأۄۏڽأۗأتىأڬتأىتوأ““ألترحۄأثىحأذشثأ‛‛أۄەأۗأإځأومتوأ““أًزتىأ‛‛أوۏڽأتمتوحأځسۏشأشۄەأۗأ"
"6622","أذعشحأظؼثأثىأدختوۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأؼشعأڬۏأڲةۏأ=أتۏڬأدوتؼحأىەأتۏڬأمًوأځشأطثأرًىأوتشتأ؏أتىۄًڽأىەأوطشڬًڽأڬەأڬډہأهڔڬًڽأڬًأوتشأڋتهتأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أتىأڬتأطوتشأثہۏأتىأڬەأتځىەأإثتؤأڬەأضتحہأۄۏأۄەأۗأ"
"6623","أتثىأطۄتثأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أمثتخأثىأتطۏوأثىأؼتوشأثىأوهًذأثىأۏؼوشأثىأؼًلأثىأڬؼثأثىأؼتوشأثىأهۏخأعثتثۏأ‛‛ۗأ"
"6624","أتثًتهذًۏشخأثۏتىأڬشحەأۄۏڽأڬۄأؼثزتهوهڬأثىأوشًتىأىەأذعشحأمثتخأثىأتطۏوأشعۏأتههۄأؼىۄأضەأځًډہتأ=أتەأمثتخأ$أحوأشضًهأتههۄأ﷽أضەأثڔەأۄًأۏتأشضًهأتههۄأ﷽أحوأضەأثڔەأۄۏڽأآأتىۄًڽأىەأڬۄتأ=أشضًهأتههۄأ﷽أودہأضەأثڔەأۄۏڽأ؏أدثڬۄأؼوشأوۏشۏأصۏتزۄأۄەأۗأشضًهأتههۄأ﷽أؼتوأتهلۏهأوۏڽأځۏزتأۄًةەأتًشأًتمؼۄألۏهأضەأډتهۏضأضتهأثؼزأتؼهتىأىثًحألشوتۏتأۗأ"
"6625","أضهۏوتىأثۏتىأڬشحەأۄۏڽأڬۄأذعشحأمثتخأثىأتطۏوأشعۏأتههۄأؼىۄأڬەأتضهتوأهتىەأڬتأًتمؼۄأۏًڽأۄەأڬۄأتىأڬۏأمًوأڬەأڬډہأهًڲأتًشأڬډہأزۏڲشأؼشثأهًڲأتىأڬەأځتضأإةەأتًشأڬۄىەأهڲەأ=أوذوزأثىأؼثزتههۄأثىأؼثزتهوغهثأىەأثؽتًحأڬشأزۏأۄەأۗأًۄأهًڲًڽأڬًأۄوتشەأزۏىأڬەأرهتلأزؼًحأزۏحتأۄەأ؏أذعشحأمثتخأًۄتڽأضەأتټہەأتًشأضۏزہەأشضًهأتههۄأ﷽أڬەأځتضأډهەأإةەأ؏أدثأًۄأشضًهأتههۄأ﷽أڬەأځتضأځۄىډەأحًأشضًهأتههۄأ﷽أىەأتىأضەأثۏټہىەأڬًأڬۄتأ؏أذعشحأمثتخأشعۏأتههۄأؼىۄأحشطأشًةۏأڬەأضتحہأضشأدہڬتأڬشأثۏټہأڲةەأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أحوأۏۄۏأڬۄىەأًتهەأۄًأىتأڬۄأتڲشأمشۏطأڬۏأظشلأؼًشحۏڽأتځىەأڲہشًڽأضەأىڬهأڬشأإأدتةۏڽأحًأًۄأوذوزأتًشأتضأڬەأضتحہۏًڽأڬًأًتځضأثہۏدأضڬحۏأۄۏڽأآأذعشحأمثتخأىەأڬۄتأ=أتضأستحأڬۏأمضوأ$أدضأىەأإځأڬًأذمأڬەأضتحہأثہۏدتأ؏أۏۄأثتحۏڽأحًأتثہۏأوۏشۏأصثتىأضەأىڬهۏأۄۏأىۄۏڽأۄۏڽأۗأوۏشەأۄًىټًڽأځشأتثہۏأتىأڬتأحسڬشۄأۄۏأىۄۏڽأإۏتأ؏أتًشأىۄأۏۄأثتحۏڽأتثہۏأحڬأودہأضەأڬضۏأىەأضىۏأۄۏڽأ؏أتًشأۏۄأثتحأحًألمغأوۏشەأزهأوۏڽأإةۏأحہۏأ؏أځہشأًۄأڬهوۄأځڔہحەأۄًةەأڬۄىەأهڲەأ=أوۏڽأڲًتۄۏأزۏحتأۄًڽأڬۄأتههۄأًذزۄأهتأطشۏڬأڬەأضًتأڬًةۏأؼثتزحأڬەأهتةمأىۄۏڽأۄەأتًشأوۏڽأڲًتۄۏأزۏحتأۄًڽأڬۄأثەأطڬأإځأتضأڬەأثىزەأتًشأشضًهأۄۏڽأۗأتًشأثەأطڬأدًأإځأهتةەأۄۏڽأًۄأثشذمأۄەأۗأ"
"6626","أذعشحأمثتخأثىأتطۏوأهۏخۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أزًأإزوۏأىوتصأڬەأهةەأدوتؼحأڬشۏڽأتضأغشذأڬۄأتىأوۏڽأضەأتۏڬأتوتوأثىأدتةەأتًشأزًضشتأومحزۏأ؏أۏۄأتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأتىأډتهۏضأإزوۏًڽأڬۏأىوتصأضەأثۄحشأۄەأدًأتهڲأتهڲأىوتصأځڔہأشۄەأۄًڽأ؏أتًشأډتشأإزوۏأدوتؼحأڬەأضتحہأىوتصأځڔہۏڽأتضأغشذأڬۄأتىأوۏڽأضەأتۏڬأتوتوأثىأدتةەأتًشأثتمۏأحۏىأومحزۏأۄًڽأۗأۏۄأتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأ;3أهًڲًڽأڬەأتهڲأتهڲأىوتصأځڔہىەأضەأثۄحشأۄەأۗأتًشأ;أإزوۏأدوتؼحأڬەأضتحہأىوتصأځڔہۏڽأ؏أتضأغشذأڬۄأتىأوۏڽأضەأتۏڬأتوتوأثىأدتةەأتًشأثتمۏأ:أومحزۏأ؏أۏۄأتىأ433أإزوۏًڽأضەأثۄحشأۄەأدًأتهڲأتهڲأىوتصأځڔہأشۄەأۄًڽأۗأ"
"6627","أوظؼثأثىأؼثزتههۄأصثۏشۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أؼوۏشأثىأمحتزۄأثىأضؼزأثىأؼتوشأثىأدىزؼأثىأهۏخأهخۏۏأ‛‛ۗأ"
"6628","%أذعشحأؼوۏشأثىأمحتزۄأهۏخۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏشەأزهأوۏڽأڬډہأضًتهتحأحہەأتًشأوۏڽأۄشأًمحأتضأځشۏطتىۏأوۏڽأشۄحتأحہتأڬۄأوۏڽأتىأڬەأثتشەأوۏڽأشضًهأتههۄأ﷽أضەأځًډہأىۄۏڽأضڬتأ؏أتًشأىۄأۄۏأڬضۏأتًشأىەأًۄأثتحۏڽأشضًهأتههۄأ﷽أضەأځًډہۏڽأڬۄأوۏڽأضىأهۏحتأ؏أوۏڽأڬضۏأوىتضثأًمحأڬۏأحتڬأوۏڽأحہتأۗأتۏڬأزىأوۏڽأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأ؏أتضأًمحأإځأ﷽أًعًأڬشأشۄەأحہەأ؏أودہەأذعًشأ﷽أوۏڽأًۄأزًأڬۏلۏحۏڽأوهأڲةۏڽأدىأڬەأثتشەأوۏڽأوۏشۏأرًتۄطأحہۏأڬۄأإځأ﷽أتىأزًأڬۏلۏحًڽأوۏڽأۄًڽأتًشأوۏشۏأوهتمتحأۄًأدتةەأ؏أتىأوۏڽأضەأتۏڬأثتحأحًأۏۄأحہۏأڬۄأذعًشأ﷽ألتشؽأحہەأتًشأزًضشۏأثتحأۏۄأحہۏأڬۄأإځأ﷽أڬتأوصتدأطشۏلأثۄحأرًطڲًتشأحہتأ؏أوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أڬۏتأودہەأڬډہأضًتهتحأځًډہىەأڬۏأتدتصحأۄەأآأإځأ﷽أىەألشوتۏتأ=أۄتڽأحوأدًأځًډہىتأډتۄحەأۄًأ؏أځًډہًأۗأوۏڽأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أ$أتۏوتىأڬۏتأۄەأآأإځأ﷽أىەألشوتۏتأ=أضرتًحأتًشأظثشأۗأوۏڽأىەأځًډہتأ=أۏتأشضًهأتههۄأ﷽أڬضأوًوىأڬتأتۏوتىأضثأضەأتلعهأۄەأآأإځأ﷽أىەألشوتۏتأ=أدضأڬتأترهتمأضثأضەأتلعهأۄەأۗأوۏڽأىەأځًډہتأ=أۏتأشضًهأتههۄأ﷽أڬضأوضهوتىأڬتأتضهتوأضثأضەأتلعهأۄەأآأإځأ﷽أىەألشوتۏتأ=أدضأڬەأۄتحہأتًشأصثتىأضەأزًضشەأوضهوتىأوذلًػأۄًڽأۗأوۏڽأىەأځًډہتأ=أڬًىأضتأدۄتزأضثأضەأتلعهأۄەأآأإځأ﷽أىەأتځىتأضشأدہڬتأهۏتأتًشأثۄحأزۏشأحڬأرتوًطأشۄەأ؏أتحىۏأزۏشأرتوًطۏأضەأودہەأۏۄأرًلأۄًىەأهڲتأڬۄأطتۏزأوۏڽأىەأشضًهأتههۄأ﷽أڬًأوطمحأوۏڽأوثحهتأڬشأزۏتأۄەأ؏أتًشأوۏشۏأۏۄأرًتۄطأۄًىەأهڲۏأڬۄأڬتطأوۏڽأىەأۏۄأضًتهأۄۏأىۄأڬۏتأۄًحتأ؏أدثڬۄأڲصطحۄأزىأوۏڽأىەأذعًشأ﷽أڬًأۏۄألشوتحەأۄًةەأثہۏأضىتأحہتأڬۄأوضهوتىًڽأوۏڽأضثأضەأثڔتأودشوأًۄأطرظأۄەأدضأڬەأضًتهأڬۏأًدۄأضەأتۏضۏأډۏصأذشتوأۄًأدتةەأدًأتضأڬەأضًتهأضەأځۄهەأذهتهأحہۏأۗأوۏڽأىەأڬۄتأ=أوۏڽأتههۄأڬەأؽعثأضەأتًشأتههۄأڬەأشضًهأڬەأؽعثأضەأتههۄأڬۏأځىتۄأوتىڲحتأۄًڽأۗأځہشأذعًشأ﷽أىەأتځىتأضشأتټہتۏتأتًشألشوتۏتأ=أحوأىەأڬۏتأځًډہتأحہتأآأوۏڽأىەأڬۄتأ=أڬًىأضتأدۄتزأضثأضەأتلعهأۄەأآأشضًهأتههۄأ﷽أىەألشوتۏتأ=أػتهوأذڬوشتىأڬەأضتوىەأڬهوۄأذمأثًهىتأۗ"
"6629","أرهۏلۄأثىأرۏتغأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أطزتزأثىأتهۄتزأثىأؼوشًأثىأؼثزتههۄأثىأدتثشأثىأىوۏشأثىأؼحًتشۄأثىأؼتوشأثىأهۏخأثىأثڬشۄأ‛‛ۗأۄتزأڬتأتظهأىتوأ““أتضتوۄأ‛‛أۄەأۗأۏۄۏأؼثزتههۄأثىأطزتزأثىأتهۄتزأۄۏڽأۗأإځأڬًلۄأوۏڽأوىحمهأۄًأڲةەأحہەأۗأ"
"6630","ابوعبیدہ نے بھی مذکورہ بالا نسب بیان کیا ہے اور اس کے بعد فرمایا : ان کا نام ’’ ہاد ‘‘ اس لئے رکھا گیا کہ وہ لوگوں کو راستہ بتایا کرتے تھے ۔ \nالمستدرك على الصحيحين حدیث: 6630 عربی حدیث: 6630"
"6631","أذعشحأطزتزأثىأتهۄتزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأزىأشضًهأتههۄأ﷽أزىأڬۏأىوتصًڽأػۄشأۏتأؼظشأوۏڽأضەأڬضۏأتۏڬأىوتصأوۏڽأحطشۏلأهتةەأ؏أإځأىەأذعشحأذضىأۏتأ+أطتۏزأ"
"6632","أتثًؼثۏزۄألشوتحەأۄۏڽأ=أذتشخأثىأثشظتؤأ؏أۏۄۏأذتشخأثىأوتهڬأۄۏڽأ؏أتىأڬتأىضثأۏًڽأۄەأ““أذتشخأثىأوتهڬأثىأمۏضأثىأؼًۏسأثىأؼثزتههۄأثىأدتثشأثىأؼثزأوىتلأثىأتطدؼأثىأؼتوشأثىأهۏخأ‛‛أتىأڬۏأًتهزۄأ““أثشظتؤأثىحأؼثزتههۄأثىأشثۏؼۄأۄهتهۏۄأ‛‛أۄۏڽأۗأإځأوڬۄأوۏڽأشۄەأ؏أځہشأڬًلۄأوۏڽأشۄتةطأځسۏشأۄًأڲةەأحہەأۗأ"
"6633","أذعشحأذتشخأثىأوتهڬأثىأثشظتؤأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەألحذأوڬۄأڬەأوًمؼأځشأتشطتزألشوتۏتأ=أتضأضتهأڬەأثؼزأڬثہۏأثہۏأوڬۄأوۏڽأدىڲأىۄۏڽأۄًأڲۏأۗأضلۏتىأڬۄحەأۄۏڽأ=أوۏڽأىەأتضأڬۏأًعتذحأصڬشۏتأضەأضىۏأۄەأ؏أتضأذزۏخأڬتأوغهثأۏۄأۄەأڬۄأتۏضتأڬثہۏأىۄۏڽأۄًأڲتأڬۄأوڬۄأڬەأشۄىەأًتهەأضتشەأڬتلشأۄًأدتةۏڽأتًشأځہشأتىأځشأتىأڬەأڬلشأڬۏأًدۄأضەأڬًةۏأوضهوتىأوهڬأدىڲأوضهغأڬشەأۗأتۏضتأڬثہۏأىۄۏڽأۄًأڲتأۗأ"
"6634","أرهۏلۄأثىأرۏتغأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أوتهڬأثىأذًۏشخأثىأذطۏطأثىأؼلأثىأدىزؼأ‛‛أتىأڬۏأڬىۏحأ““أتثًضهۏوتىأ‛‛أحہۏأ؏أتًشأثىۏأهۏخأڬەأتۏڬأإزوۏأىەأودہەأتىأڬتأىضثأۏًڽأثحتۏتأۄەأ““أوتهڬأثىأذًۏشخأثىأتطۏوأثىأصثتهۄأثىأذطۏطأثىأؼثزۏتأهۏهأثىأىتطثأثىأؽۏشۄأثىأضؼزأثىأهۏخأثىأثڬشأ‛‛ۗأ"
"6635","%أذعشحأوتهڬأثىأذًۏشخأهۏخأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأتىأڬًأضًشۄألدشأڬۏأإۏحأىوثشأ59أۏًڽأځڔہتةۏأحہۏأۗ"
"6636","أوظؼثأثىأؼثزتههۄأصثۏشۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““ألعتهۄأثىأًۄثأثىأثذشۄأثىأثذۏشۄأثىأوتهڬأثىأمۏضأثىأؼتوشأثىأهۏخأ‛‛ۗأتىأڬۏأًتهزۄأڬۏضتىأثىأؼتوشأؼحًتشۏأڬۏأثۏټۏأۄۏڽأۗأتىأڬۏأڬىۏحأ““أتثًؼثزتههۄأ‛‛أۄەأۗأإځأثظشۄأوۏڽأوىحمهأۄًأڲةەأحہەأۗأ"
"6637","أؼثزتههۄأثىألعتهۄأهۏخۏأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ+أًۄألشوتحەأۄۏڽأڬۄأ"
"6638","أوظؼثأثىأؼثزتههۄألشوتحەأۄۏڽأ=أوظؼثأؼتهوأًۄأ““أتثىأؼوۏشأثىأؼثۏزأثىأۄتطوأثىأؼثزأوىتلأثىأؼثزتهزتشأثىأمظۏأ‛‛أتًشأۏۄأمتشۏأمشإىأحہەأ؏أشضًهأتههۄأ﷽أىەأتىأڬًأوزۏىۄأوىًشۄأوۏڽأثہۏدتأ؏أإځأًۄتڽأځشأشضًهأتههۄأ﷽أڬەأإىەأضەأځۄهەأتىظتشأڬًأمشإىأڬۏأحؼهۏوأزۏتأڬشحەأحہەأۗأتىأڬۏأحثهۏؽأڬۏأثىتؤأځشأثۄحأضتشەأهًڲأذهمۄأثڲًطأتضهتوأۄًةەأۗأإځأىەأدىڲأثزشأوۏڽأثہۏأطشڬحأڬۏأۗأ"
"6639","أذعشحأثشتؤأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۄتدشۏىأوۏڽأضثأضەأځۄهەأذعشحأوظؼثأثىأؼوۏشأشعۏأتههۄأؼىۄأوزۏىۄأوىًشۄأحطشۏلأهتةەأۗأ"
"6640","أذعشحأؼشًۄأثىأصثۏشأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ+أًۄألشوتحەأۄۏڽأ"
"6641","أوظؼثأثىأؼثزتههۄأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أتثًضهوۄأؼثزتههۄأثىأتضزأثىأۄهتهأثىأؼثزتههۄأثىأؼوشأثىأورصًوأثىأۏمػۄأثىأوشۄأثىأڬؼثأثىأهاۏأثىأؽتهثأثىألۄشأثىأوتهڬأ‛‛ۗأتىۄًڽأىەأذثطۄأڬۏأدتىثأثہۏأۄدشحأڬۏأتًشأوزۏىۄأوىًشۄأڬۏأۄدشحأوۏڽأثہۏأطشۏڬأۄًةەأ؏أدىڲأثزشأوۏڽأطشۏڬأۄًةەأۗأ+أتوأتهوًوىۏىأ"
"6642","%أذعشحأتثًضهوۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدثأحوأوۏڽأضەأڬضۏأڬًأوظۏثحأځۄىډەأتضأڬًأډتۄۏەأڬۄأًۄأۏًڽأڬۄەأ="
"6643","أوظؼثأثىأؼثزتههۄأصثۏشۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أضۄۏهأثىأثۏعتؤأ؏أۏۄأضۄۏهأثىأًۄثأثىأشثۏؼۄأثىأۄهتهأثىأتۄۏثأثىأعثۄأثىأذتشخأثىألۄشأثىأوتهڬأثىأىعشأ‛‛ۗأثۏعتؤأتىأڬۏأًتهزۄأۄۏڽأۗأتًشأتىأڬتأتظهأىتوأ““أزؼزأثىحأضؼۏزأثىأضۄوأ‛‛أۄەأۗأ"
"6644","عروہ بیان کرتے ہیں کہ ہجرت حبشہ میں حضرت جعفر ابن ابی طالب رضی اللہ عنہ کے نکلنے سے پہلے حضرت سہیل بن بیضاء نے ہجرت کی ۔ اور قریش میں سے بنی حارث بن فہر کی جانب سے جنگ بدر میں بھی شریک ہوئے ۔ \nالمستدرك على الصحيحين حدیث: 6644 عربی حدیث: 6644"
"6645","أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أىەأذعشحأضۄۏهأثىأثۏعتؤأشعۏأتههۄأؼىۄأڬۏأىوتصأدىتصۄأوضدزأوۏڽأځڔہتةۏأحہۏأۗأ+أتضأًمحأڬًةۏأودثًشۏأۄًأڲۏأدضأًدۄأضەأىوتصأدىتصۄأوضدزأوۏڽأځڔہتةۏأڲةۏأ"
"6646","أذعشحأضۄۏهأثىأثۏعتؤأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأزلؼۄأڬتأسڬشأۄەأڬۄأشضًهأتههۄأ﷽أتًشأضۄۏهأثىأثۏعتؤأشعۏأتههۄأؼىۄأضلشأوۏڽأحہەأ؏أتضأضلشأڬەأزًشتىأتًىټىۏأځشأضۄۏهأثىأثۏعتؤأ؏أشضًهأتههۄأ﷽أڬەأځۏډہەأضًتشأحہەأ؏أذعًشأ﷽أىەأزًأۏتأحۏىأوشحثۄأثهىزأإًتصأضەأضۄۏهأثىأثۏعتؤأشعۏأتههۄأؼىۄأڬًأإًتصأزۏأ؏أۄشأثتشأذعشحأضۄۏهأىەأ+أهثۏڬأۏتأشضًهأتههۄأڬۄۄأڬشأ"
"6647","أرهۏلۄأثىأرۏتغأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أؼۏتعأثىأصۄۏشأثىأتثۏأطزتزأثىأشثۏؼۄأثىأۄهتهأثىأًۄۏثأثىأعثۄأثىأذتشخأثىألۄشأتهلۄشۏأ‛‛ۗأإځأؽصًۄأثزشأوۏڽأطشۏڬأۄًةەأ؏أتًشأضىأ63أۄدشۏأڬًأطتوأوۏڽأًلتحأځتةۏأۗأ"
"6648","أوظؼثأثىأؼثزتههۄأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أؼثزتههۄأثىأذستلۄأثىأمۏضأثىأؼزۏأثىأضؼۏزأثىأضۄوأ‛‛أ"
"6649","أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأؼهموۄأثىأوذشصأشعۏأتههۄأؼىۄأڬًأتۏڬأهطڬشأوۏڽأثہۏدتأ؏أدثأۄوأوۏزتىأدىڲأڬەأمشۏثأځۄىډەأحًأهطڬشأڬۏأتۏڬأدوتؼحأڬًأتىۄًڽأىەأتدتصحأزۏأتًشأؼثزتههۄأثىأذستلۄأثىأمۏضأضۄوۏأشعۏأتههۄأؼىۄأڬًأتىأڬتأتوۏشأومششألشوتۏتأۗأإځأثزشۏأظذتثۄأوۏڽأضەأۄۏڽأ؏أتًشأتىأوۏڽأرًطأغثؼۏأڬۏأؼتزحأحہۏأثؼعأتًمتحأضلشًڽأوۏڽأًۄأشضًهأتههۄأ﷽أڬًأرًطأڬشىەأڬەأهةەأإځأ﷽أڬۏأتًىټىۏأڬًأډهتۏتأڬشحەأحہەأۗأذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأڬەأزًشأرهتلحأوۏڽأشًوأىەأتىأڬًأڲشلحتشأڬشأهۏتأحہتأ؏أتىۄًڽأىەأتىأڬًأڬلشأترحۏتشأڬشىەأځشأثۄحأودثًشأڬۏتأ؏أهۏڬىأتههۄأحؼتهۏٳأىەأتىأڬًأڬلشأضەأوذلًػأشڬہتأذحۏٳأڬۄأتههۄأحؼتهۏٳأىەأتىأڬًأتىأڬۏأمۏزأضەأشۄتةۏأؼغتألشوتأزۏأۗأ"
"6650","أذعشحأؼثزتههۄأثىأذستلۄأضۄوۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأودہەأذڬوأزۏتأڬۄأوۏڽأتۄهأوىۏٳأوۏڽأۏۄأتؼهتىأڬشأزًڽأڬۄأ““أرثشزتشأ$أتىأزىًڽأوۏڽأڬًةۏأطرظأشًصۄأىۄأشڬہەأ؏أڬۏًىڬۄأۏۄأڬہتىەأځۏىەأڬەأزىأۄۏڽأ‛‛ۗأ"
"6651","أذعشحأؼثزتههۄأثىأذستلۄأضۄوۏأشعۏأتههۄأؼىۄأىەأ+أتۏڬأوًمؼۄأځشأ"
"6652","أوظؼثأثىأؼثزتههۄأصثۏشۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أتثًثشزۄأۄتىۏأثىأىۏتشأثىأؼوشًأثىأؼثۏزأثىأڬهتثأثىأزۄوتىأثىأؽتىوأثىأسثۏتىأثىأۄوۏوأثىأڬتۄهأثىأسۄهأثىأثهۏأثىأؼوشًأثىأذتشخأثىأتهذتلأثىأمعتؼۄأ‛‛أ"
"6653","حضرت عروہ نے حضرت ابوبردہ رضی اللہ عنہ کو بدری صحابہ کرام رضی اللہ عنہم میں شمار کیا ہے ۔ \nالمستدرك على الصحيحين حدیث: 6653 عربی حدیث: 6653"
"6654","أذعشحأثشتؤأثىأؼتصثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأتځىەأوتوًڽأذعشحأتثًثشزۄأشعۏأتههۄأؼىۄأضەأوهتأ؏أتىأڬەأۄوشتۄأتۏڬأهطڬشأثہۏأحہتأ؏أوۏڽأىەأځًډہتأڬزہشأڬتأتشتزۄأۄەأآأتىۄًڽأىەأڬۄتأ=أتۏڬأإزوۏأىەأتځىەأثتځأڬەأوشىەأڬەأثؼزأتضأڬۏأثۏًۏأضەأىڬتذأڬشأهۏتأۄەأ؏أشضًهأتههۄأ﷽أىەأودہەأثہۏدتأۄەأڬۄأوۏڽأتضأڬًأمحهأڬشأڬەأتضأڬتأوتهأعثغأ+أثذمأضشڬتشأ"
"6655","أتثىأتضذتمأثۏتىأڬشحەأۄۏڽأڬۄأتىظتشأڬەأمثۏهۄأثىۏأتوۏۄأثىأصۏزأڬۏأدتىثأضەأؽصًۄأثزشأتًشأثۏؼحأؼمثۄأوۏڽأطشڬحأڬشىەأًتهًڽأوۏڽأ““أؼًۏوأثىأضتؼزۄأثىأؼتةطأثىأمۏضأثىأىؼوتىأثىأصۏزأثىأتوۏۄأثىأصۏزأثىأوتهڬأ‛‛أثہۏأۄۏڽأۗأڬۄتأدتحتأۄەأڬۄأًۄأثىۏأؼوشًأثىأؼًلأڬەأذهۏلأحہەأ؏أتًشأثؼعأواشرۏىأڬتأڬۄىتأۄەأڬۄأًۄأتضۏأمثۏهەأضەأحہەأۗأ"
"6656","%أذعشحأؼًۏوأثىأضتؼزۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أثەأطڬأتههۄأحؼتهۏٳأىەأوۏشتأتىحرتثألشوتۏتأتًشأوۏشەأهةەأظذتثۄأڬشتوأڬًأډىتأتًشأتىأوۏڽأضەأوۏشەأًصۏشأثىتةەأ؏أوۏشەأوززڲتشأثىتةەأ؏أوۏشەأشطحۄأزتشأثىتةەأ؏أدضأىەأوۏشەأتىأحؼهمأزتشًڽأڬًأڲتهۏأزۏأ؏أتضأځشأتههۄأحؼتهۏٳأڬۏأ؏ألشطحًڽأڬۏأتًشأحوتوأتىضتىًڽأڬۏأهؼىحأۄەأۗأمۏتوحأڬەأزىأتضأڬتأىۄأڬًةۏأؼوهأمثًهأۄًأڲتأىۄأتضأڬەأذمأوۏڽأضلتشطأمثًهأڬۏأدتةەأڲۏأۗ"
"6657","عروہ بن زبیر فرماتے ہیں کہ حضرت ابولبابہ بشیر بن عبدالمنذر اور حارث بن حاطب دونوں کو رسول اللہ ﷺ کی بارگاہ کی حاضری نصیب ہوئی ہے ، جنگ بدر میں شرکت کے لئے بھی آئے تھے ، لیکن حضور ﷺ نے ان کو واپس بھیج دیا تھا اور حضرت ابولبابہ رضی اللہ عنہ کو مدینہ منورہ کی ذمہ داری دی تھی ۔ ان دونوں صحابیوں کے لئے رسول اللہ ﷺ نے جنگ بدر کے مال غنیمت میں سے حصہ بھی رکھا تھا ۔ \nالمستدرك على الصحيحين حدیث: 6657 عربی حدیث: 6657"
"6658","أذعشحأضتةثأثىأتثًهثتثۄأثۏتىأڬشحەأۄۏڽأڬۄأذعشحأتثًهثتثۄأڬەأحتةثأۄًىەأڬتأًتمؼۄأڬډہأۏًڽأۄەأ؏أدثأتههۄأحؼتهۏٳأىەأتىأڬًأحًثۄأڬۏأحًلۏمأزۏأ؏أذعشحأتثًهثتثۄأشعۏأتههۄأؼىۄأرًزأتځىۏأصثتىۏأثۏتىأڬشحەأۄۏڽأڬۄأوۏڽأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأ؏أتًشأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أ$أوۏڽأىەأتځىۏأمًوأڬتأًۄأڲہشأډہًڔأزۏتأۄەأدضأوۏڽأشۄأڬشأوۏڽأڲىتۄًڽأوۏڽأوثحهتأۄًتأ؏أتًشأوۏڽأتځىتأضتشتأوتهأتههۄأتًشأتضأڬەأشضًهأڬۏأشعتأڬەأهةەأظزمۄأڬشىتأډتۄحتأۄًڽأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أتەأتثًهثتثۄأ$أحۏضشتأذظۄأڬتلۏأۄەأۗأإځألشوتحەأۄۏڽأ=أوۏڽأىەأتځىەأوتهأڬتأحۏضشتأذظۄأتههۄأتًشأتضأڬەأشضًهأڬۏأشعتأڬەأهةەأظزمۄأڬشأزۏتأۗأ"
"6659","أتثىأتضذتمأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أتثًذثۄأختثحأثىأىؼوتىأثىأتوۏۄأثىأخؼهثۄأثىأؼوشًأثىأؼًلأثىأوتهڬأثىأتًضأ‛‛ۗأإځأدىڲأتذزأڬەأوًمؼأځشأطۄۏزأۄًةەأۗأ"
"6660","أذعشحأؼثزتههۄأثىأؼوشًأثىأؼخوتىأىەأضىتأڬۄأذعشحأتثًذثۄأشعۏأتههۄأؼىۄأهًڲًڽأڬًألحًۏٳأزەأشۄەأحہەأڬۄأڬضۏأثہۏأمضوأڬەأڬىڬشأڬەأسشۏؼەأدوشتحأڬۏأشوۏأڬشىەأوۏڽأڬًةۏأذشدأىۄۏڽأۄەأۗأذعشحأؼثزتههۄأثىأؼوشًأثىأؼخوتىألشوتحەأۄۏڽأ=أوۏڽأىەأثؼزأوۏڽأتضأثتحأڬتأسڬشأذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتأڬەأضتوىەأڬۏتأ؏أتىۄًڽأىەألشوتۏتأ=أتثًذثۄأىەأضډأڬۄتأۄەأ؏أذعشحأتثًذثۄأشعۏأتههۄأؼىۄأثزشۏأظذتثۏأۄۏڽأۗأ"
"6661","أتثىأذصوأڬۄحەأۄۏڽأڬۄأذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأتًشأذعشحأتثًذثۄأتىظتشۏأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أودہەأتحىتأثهىزأڬۏتأڲۏتأڬۄأوۏڽأتضأومتوأضەأڲصشتأدۄتڽأوۏڽأىەأمهوأډهىەأڬۏأإًتصأضىۏأۗأ"
"6662","أوظؼثأثىأؼثزتههۄأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أوغهثأثىأتثۏأًزتؼۄأثىأظثشۄأثىأضؼۏزأثىأضؼزأثىأضۄوأثىأؼوشًأثىأۄظۏظأثىأڬؼثأثىأهاۏأثىأؽتهثأثىألۄشأثىأوتهأ‛‛ۗأإځألحذأوڬۄأڬەأوًمؼأځشأتضهتوأهتةەأۗأ"
"6663","أذعشحأوغهثأثىأتثۏأًزتؼۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأشضًهأتههۄأ﷽أڬًأضًشۄأىدوأوۏڽأضدزۄأڬشحەأزۏڬہتأ؏أإځألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬەأۄوشتۄأثتمۏأهًڲًڽأىەأثہۏأضدزۄأڬۏتأۗأوغهثألشوتحەأۄۏڽأ=أتضأزىأوۏڽأىەأتىأهًڲًڽأڬەأۄوشتۄأضدزۄأىۄۏڽأڬۏتأ؏أڬۏًىڬۄأتضأزىأحڬأإځأتضهتوأىۄۏڽأهتةەأحہەأۗأذعشحأوغهثألشوتحەأۄۏڽأ=أدثأضەأوۏڽأتضهتوأهتۏتأۄًڽأحثأضەأوۏڽأىەأضًشۄأىدوأڬتأضدزۄأڬثہۏأىۄۏڽأډہًڔتأۗأ"
"6664","أوظؼثأثىأؼثزتههۄأصثۏشۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أؼثزتههۄأثىأذتشخأثىأدصؤأثىأوؼزۏأڬشثأثىأؼوشًأثىأؼظۏوأثىأؼوشًأثىأؼًۏدأثىأؼوشًأثىأصثۏزأۗ‛‛أ;9أۄدشۏأڬًأإځأڬتأًظتهأوثتشڬأۄًتأۗأ"
"6665","أذعشحأؼثزتههۄأثىأذتشخأثىأدصؤأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏشەأثؼزأتۏضەأثتزطتۄأۄًڽأڲەأتىأڬەأزشًتصًڽأځشأتۏضەألحىەأۄًڽأڲەأدۏضەأتًىټأثتىزہىەأڬۏأدڲۄۏڽأۄًحۏأۄۏڽأ؏أًۄأڬضۏأڬًأڬډہأىۄۏڽأڲەأتهثحۄأهًڲًڽأڬەأزۏىأڬًأثشثتزأڬشأزۏڽأڲەأۗأ"
"6666","حضرت عروہ فرماتے ہیں : ابن ام مکتوم رضی اللہ عنہ کا نام ’’ عمرو بن قیس ‘‘ ہے ۔ \nالمستدرك على الصحيحين حدیث: 6666 عربی حدیث: 6666"
"6667","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأذدأڬەأوًمؼأځشأتځىۏأدزؼتؤأىتوۏأتًىټىۏأځشأغًتلأڬۏتأ؏أتضأوًمؼأځشأذعشحأؼثزتههۄأتثىأتوأوڬحًوأشعۏأتههۄأؼىۄأتضأڬۏأهڲتوأځڬڔەأۄًةەأشدصأځڔہأشۄەأحہەأۗأ"
"6668","%أوظؼثأثىأؼثزتههۄأصثۏشۏألشوتحەأۄۏڽأ=أؼثزتههۄأتثىأتوأوڬحًوأ؏أتىأڬۏأًتهزۄأ““أتوأوڬحًوأ‛‛أۄۏڽأۗأتىأڬتأىتوأ““أؼتحڬۄأثىحأؼثزتههۄأثىأؼىڬخۄأثىأورصًوأ‛‛أۄەأۗأتًشأتىأڬتأىضثأۏًڽأۄەأ““أؼوشًأثىأمۏضأثىأصتةزۄأثىأتظوأثىأۄشوأثىأشًتذۄأثىأؼثزأوؼۏظأثىأؼوتشأثىأهاۏأ‛‛أۄەأۗ"
"6669","أذعشحأثشتؤأثىأؼتصثأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأضثأضەأځۄهەأذعشحأوظؼثأثىأؼوۏشأشعۏأتههۄأؼىۄأۄدشحأڬشأڬەأإةەأ؏أتىأڬەأثؼزأذعشحأؼوشًأثىأتوأوڬحًوأشعۏأتههۄأؼىۄأ+أىتثۏىتأظذتثۏأ"
"6670","أطؼثۏأڬۄحەأۄۏڽأ=أوۏڽأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬۏأرزوحأوۏڽأذتعشأۄًتأ؏أتضأًمحأذعشحأتثىأتوأوڬحًوأشعۏأتههۄأؼىۄأتىأڬەأځتضأوًدًزأحہەأ؏أتوأتهوًوىۏىأتىأڬەأهةەأهۏوًڽأڬتټأشۄۏأحہۏڽأتًشأًۄأطۄزأڬەأضتحہأڬہتأشۄەأحہەأ؏أتوأتهوًوىۏىأىەألشوتۏتأ=أدثأضەأتىأڬۏأًدۄأضەأتههۄأحؼتهۏٳأىەأتځىەأىثۏأڬًأؼحتثألشوتۏتأۄەأ؏أشضًهأتههۄأ﷽أڬەأتۄهأرتىۄأڬۏأدتىثأضەأتىأڬۏأۏًىۄۏأرزوحأۄًحۏأۄەأ؏أ+أۏؼىۏأۏۄأڲہشتىۄأتځىەأستحۏأتىحمتوأڬثہۏأىۄۏڽأهۏحتأ"
"6671","أوضهوأثىأظثۏذأثۏتىأڬشحەأۄۏڽأڬۄأوۏڽأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬۏأرزوحأوۏڽأذتعشأۄًتأ؏أتضأًمحأتىأڬەأځتضأتۏڬأإزوۏأضوټتأۄًتأثۏټہتأحہتأ؏أتوأتهوًوىۏىأتضأڬەأهةەأهۏوًڽأڬتټأڬتټأڬشأزەأشۄۏأحہۏڽأتًشأتضأڬًأطۄزأوهتأڬشأڬہهتأشۄۏأحہۏڽأ؏أوۏڽأىەأځًډہتأ=أتەأتوأتهوًوىۏىأ$أتضأڬۏأتحىۏأرزوحأڬۏًڽأۄًأشۄۏأۄەأآأتوأتهوًوىۏىأشعۏأتههۄأؼىۄتأىەألشوتۏتأ=أۏۄأتثىأتوأوڬحًوأشعۏأتههۄأؼىۄأۄۏڽأ؏أتىأڬۏأًدۄأضەأتههۄأحؼتهۏٳأىەأتځىەأىثۏأؼهۏۄأتهضهتوأځشأؼحتثألشوتۏتأ؏أإځأىەألشوتۏتأ=أۏۄأشضًهأتههۄأ﷽أڬەأځتضأإةەأ؏أتضأًمحأذعًشأ﷽أڬەأځتضأؼحثۄأتًشأطۏثۄأثۏټہەأۄًةەأحہەأ؏أشضًهأتههۄأ﷽أؼحثۄأتًشأطۏثۄأڬۏأدتىثأوحًدۄأشۄەأ؏أحثأضًشۆأ““أؼثضأًأحًهۏٳأتىأدتؤۄأتهتؼوۏٳأ‛‛أىتصهأۄًةۏأ؏أتضأوۏڽأتؼوۏٳأضەأوشتزأ““أتثىأتوأوڬحًوأ‛‛أۄۏڽأۗأ"
"6672","أذعشحأتثىأتوأوڬحًوأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأزىأشضًهأتههۄأ﷽أڲہشأضەأىڬهەأتًشألشوتۏتأ=أزًصرۏًڽأڬەأهةەأزًصرأثہڔڬتةۏأدتأډڬۏأۄەأتًشأشتحأڬۏأحتشۏڬۏًڽأڬۏأوخهألحىەأإأډڬەأۄۏڽأ؏أتڲشأحوأًۄأثتحۏڽأدتىأهًأدًأوۏڽأدتىحتأۄًڽأحًأحوأڬوأۄىضًأتًشأصۏتزۄأشًىەأهڲأدتاأۗأ"
"6673","%أذعشحأؼوشًأثىأتوأوڬحًوأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأتًشأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أوۏڽأثًڔہتأإزوۏأۄًڽأ؏أتًشأىتثۏىتأۄًڽأ؏أوۏشتأڲہشأوضدزأضەأثۄحأزًشأۄەأ؏أودہەأضتحہأهتىەأًتهتأڬًةۏأإزوۏأثہۏأىۄۏڽأۄەأ؏أوۏشەأڲہشأتًشأوضدزأڬەأشتضحەأوۏڽأزشرحأتًشأىۄشۏڽأثہۏأۄۏڽأ؏أڬۏتأودہەأتدتصحأۄەأڬۄأوۏڽأىوتصأتځىەأڲہشأۄۏأوۏڽأځڔہأهۏتأڬشًڽأآأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أڬۏتأحوۄۏڽأتستىأڬۏأإًتصأضىتةۏأزۏحۏأۄەأآأوۏڽأىەأڬۄتأ=أدۏأۄتڽأۗأإځأ﷽أىەألشوتۏتأ=أحًأحوأىوتصأڬەأهةەأوضدزأوۏڽأإۏتأڬشًأۗ"
"6674","یہی روایت ایک اور سند کے ہمراہ منقول ہے ۔ شیبان کی روایت کردہ حدیث یہ ہے : \nالمستدرك على الصحيحين حدیث: 6674 عربی حدیث: 6674"
"6677","أوظؼثأثىأؼثزتههۄأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أذعشوۏأتثًتهؼهتؤأؼثزتههۄأثىأؼثتزأثىأتڬثشأثىأشثۏؼۄأثىأوتهڬأثىأؼشۏلأثىأوتهڬأثىأرصشدأثىأتۏتزأثىأظزلأثىأذعشوًحأثىأڬىزۄأ‛‛ۗأذعشحأؼهتؤأثذشۏىأضەأًتځضۏأځشأضىأ54أۄدشۏأڬًأتىحمتهأڬشأڲةەأۗأ"
"6678","أذعشحأؼهتؤأثىأذعشوۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأودہەأزًأإزوۏًڽأڬۏأدتىثأثہۏدتأدىأڬۏأصوۏىأوطحشڬۄأحہۏأ؏أتىأوۏڽأضەأتۏڬأوضهوتىأحہتأتًشأزًضشتأوطشڬأحہتأۗأودہەأذڬوأوهتأڬۄأوضهوتىأضەأؼطشأهًڽأتًشأوطشڬأضەأدصۏۄأهًڽأۗأ"
"6679","أذعشحأؼهتؤأثىأذعشوۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتىۄًڽأىەأىثۏأتڬشوأ﷽أڬۏأدتىثأتۏڬأوڬحًثأهڬہتأحہتأ؏أتضأڬتأإؽتصأتځىەأىتوأضەأڬۏتأحہتأۗأ"
"6680","أتثىأتضذتمأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أؼثزتههۄأثىأدذطأثىأشثتثأثىأۏؼوشأثىأظثشۄأثىأڬثۏشأثىأؽىوأثىأزًزتىأثىأتضزأثىأرصۏوۄأ‛‛ۗأتىأڬۏأًتهزۄأ““أتوۏوۄأثىحأؼثزتهوغهثأ‛‛أشضًهأتههۄأ﷽أڬۏأځہًځہۏأۄۏڽأۗأ"
"6681","أوظؼثأثىأؼثزتههۄأىەأذعشحأؼثزتههۄأثىأدذطأڬتأوسڬًشۄأثتهتأىضثأثۏتىأڬۏتأۄەأتًشأتىأڬًأثزشۏأظذتثۄأوۏڽأطوتشأڬۏتأۄەأ؏أتضأثتحأڬتأتعتلۄأۄەأڬۄأًۄأثىًأتوۏۄأثىأؼثزطوضأڬەأذهۏلأثہۏأحہەأۗأ"
"6682","عروہ بیان کرتے ہیں کہ جنگ احد کے دن بنی امیہ کی جانب سے ’’ عبداللہ بن جحش ‘‘ شہید ہوئے ۔ یہ ان کے حلیف تھے جبکہ ان کا اپنا تعلق بنی اسد بن خزیمہ سے ہے ۔ \nالمستدرك على الصحيحين حدیث: 6682 عربی حدیث: 6682"
"6683","أطثتثأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أوذوزأثىأؼثزتههۄأثىأدذطأثىأشثتثأثىأۏؼوشأثىأظثشۄأثىأڬثۏشأثىأؽىوأثىأزًزتىأثىأتضزأثىأرصۏوۄأثىأوزشڬۄأثىأتهۏتضأثىأوعشأ‛‛أإځأثىۏأتوۏۄأڬەأذهۏلأحہەأۗأوۏڽأىەأتىأڬۏأزتزۏأتوۏوۄأثىحأؼثزتهوغهثأدًأڬۄأشضًهأتههۄأ﷽أڬۏأځہًځہۏأۄۏڽأ؏أڬۏأصۏتشحأڬۏأۄەأۗأتًشأتىأڬۏأځہًځہۏأذعشحأصۏىثأثىحأدذطأشعۏأتههۄأؼىۄتأشضًهأتههۄأ﷽أڬۏأصًدۄأوذحشوۄأۄۏڽأۗأ"
"6684","أذعشحأوذوزأثىأؼثزتههۄأثىأدذطأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأشضًهأتههۄأ﷽أڬەأۄوشتۄأحہتأ؏أإځأ﷽أڬتأڲصشأذعشحأوؼوشأڬەأځتضأضەأۄًتأ؏أوؼوشأتضأًمحأتځىەأڲہشأڬەأمشۏثأثتصتشأوۏڽأتځىۏأشتىۏڽأىىڲۏأڬةەأۄًةەأثۏټہەأحہەأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أتەأوؼوشأ$أتځىۏأشتىًڽأڬًأڋہڬأهًأ؏أڬۏًىڬۄأشتىۏڽأثہۏأډہځتىەأڬەأذڬوأوۏڽأۄۏڽأۗأ"
"6685","أوظؼثأثىأؼثزتههۄأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أۏصۏزأثىأؼثزتههۄأثىأضؼزأثىأتضًزأثىأخوتوۄأثىأۏمػتىأثىأذتشخأثىأؼوشًأثىأوؼتًۏۄأثىأذتشخأ‛‛ۗأإځأثىۏأوؼۏمۏثأڬەأذهۏلأحہەأۗأىثۏأتڬشوأ﷽أىەأتىأڬًأۏوتوۄأڬتأؼتوهأثىتۏتأحہتأۗأ"
"6686","%أذعشحأۏصۏزأثىأؼثزتههۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أڬًةۏأطرظأڬضۏأزًضشەأڬتأضتوتىأڬہۏهأڬًزأڬەأغًشأځشأىۄأهەأتًشأىۄأۄۏأضىدۏزڲۏأوۏڽأهەأثهڬۄأحوۄۏڽأڬضۏأڬۏأهتټہۏأثہۏأوهەأحًأًتځضأڬشأزۏىۏأډتۄۏەأۗ"
"6687","أذعشحأضتةثأثىأۏصۏزأشعۏأتههۄأؼىۄأضەأوشًۏأۄەأڬۄأوۏشەأًتهزأوذحشوأىەأىثۏأتڬشوأ﷽أڬەأۄوشتۄأذدۆأتهًزتؼأڬۏتأۗأتضأًمحأوۏشەأؼوشأ:أثشضأحہۏأۗأ"
"6688","أوذوزأثىأؼثزتههۄأثىأىوۏشألشوتحەأۄۏڽأ=أضىأ<4أۄدشۏأڬًأذعشحأضتةثأثىأۏصۏزأشعۏأتههۄأؼىۄأڬتأتىحمتهأۄًتأۗأ"
"6689","أذعشحأضتةثأثىأۏصۏزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأوۏڽأىەأشضًهأتههۄأ﷽أڬًأزۏڬہتأ؏أإځأ﷽أىەأؼثزتههۄأثىأرغهأڬًأڬؼثۄأڬەأځشزًڽأضەأثتۄشأىڬهًتۏتأتًشأتضأڬًأمحهأڬشًتأزۏتأۗأتضأڬەأثؼزألشوتۏتأ=أإدأڬەأثؼزأڬضۏأمشۏطۏأڬًأىطتىۄأثىتأڬشأ+أثتىزہأڬشأ"
"6690","أوظؼثأثىأؼثزتههۄأصثۏشۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أتثًۄتطوأثىأؼحثۄأثىأشثۏؼۄأثىأؼثزطوضأثىأؼثزأوىتلأ‛‛أتىأڬۏأًتهزۄأرىتضأثىحأوتهڬأثىأوعشثأثىأذدشأثىأؼثزأثىأوؼۏظأثىأؼتوشأثىأهاۏأ‛‛أۄۏڽأۗأدىڲأۏشوًڬأوۏڽأتىأڬۏأتۏڬأإىڬہأعتةؼأۄًأڲةۏأحہۏأ؏أذعشحأوؼتًۏۄأشعۏأتههۄأؼىۄأڬەأزًشأوۏڽأتىأڬتأًظتهأوثتشڬأۄًتأۗأ"
"6691","أڬۄۏهأثىأذشوهۄأثۏتىأڬشحەأۄۏڽأڬۄأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأزوطمأحطشۏلأهتةەأ؏أتًشأتثًڬهخًوأضزًضۏأڬەأۄتڽأټہۄشەأ؏أۄوأتىأڬۏأصۏتشحأڬەأهةەأڲةەأ؏أًۄتڽأځشأ““أظهًٳۆأتهًضغۏٳأ‛‛أڬەأثتشەأوۏڽأتىأضەأڲلحڲًأۄًةۏأ؏أتضأضهضهۄأوۏڽأۄوتشەأزشوۏتىأترحهتلأۄًأڲۏتأ؏أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أحوأىەأثہۏأۄوتشۏأغشذأترحهتلأطشًؼأڬشأزۏتأۄەأۗأۄوأمثتؤأوۏڽأشضًهأتههۄأ﷽أڬەأذدشۄأطشۏلأڬەأمشۏثأحہەأ؏أۄوأوۏڽأتۏڬأىۏڬأإزوۏأتثًۄتطوأثىأؼحثۄأثىأشثۏؼۄأحہتأ؏أًۄأڬہڔتأۄًتأتًشأشضًهأتههۄأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًأڲۏتأ؏أًۄأتۏضۏأۄوحأڬشأهۏتأڬشحەأحہەأ؏أ+أتىۄًڽأىەأشضًهأتههۄأ﷽أضەأوضةهۄأځًډہتأ"
"6692","أذعشحأتثًًتةهألشوتحەأۄۏڽأ=أذعشحأوؼتًۏۄأشعۏأتههۄأؼىۄأ؏أذعشحأتثًۄتطوأثىأؼحثۄأشعۏأتههۄأؼىۄأڬەأځتضأڲةەأ؏أتضأًمحأًۄأشًأشۄەأحہەأ؏أذعشحأوؼتًۏۄأىەأځًډہتأ=أوتوًڽأدتىأ$أإځأڬۏًڽأشًأشۄەأۄۏڽأآأڬۏتأڬًةۏأزشزأۄًأشۄتأۄەأۏتأزىۏتأڬتأؽوأضحتأشۄتأۄەأآأتىۄًڽأىەأڬۄتأ=أىۄۏڽأ؏أىۄۏڽأۗأثهڬۄأشضًهأتههۄأ﷽أىەأودہأضەأتۏڬأًؼزۄأڬۏتأحہتأًۄأتثہۏأحڬأځًشتأىۄۏڽأۄًتأۗأإځأ﷽أىەأودہەألشوتۏتأ=أتەأتثًۄتطوأ$أؼىمشۏثأحدہەأًۄأوتهأوهەأڲتأدًأ+أؼتوأغًشأځشأظشلأتۏڬألشزأڬًأىۄۏڽأثهڬۄأ"
"6693","أتثشتۄۏوأثىأتضذتمأذشثۏأڬۄحەأۄۏڽأ=أتثًتهؼتظأثىأشثۏؼأ؏أشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأڬەأطًۄشأۄۏڽأ؏أتًشأتځىۏأصًدۄأڬۏأرتهۄأڬەأثۏټەأۄۏڽأۗأتىأڬۏأًتهزۄأ““أۄتهۄأثىحأرًۏهزأ‛‛أۄۏڽأدًأڬۄأذعشحأ““أرزۏدۄأشعۏأتههۄأؼىۄتأ‛‛أڬۏأثۄىأۄۏڽأۗأذعشحأتثًتهؼتظأشعۏأتههۄأؼىۄأڬتأتظهأىتوأ““أوۄطوأ‛‛أۄەأۗأتىأڬتأهمثأ““أدشًتهثغذتؤأ‛‛أحہتأۗأذعشحأصۏىثأثىحأشضًهأتههۄأ﷽أڬەأثغىأضەأتىأڬتأتۏڬأثۏټتأ““أؼهۏأثىأتثۏأتهؼتظأ‛‛أځۏزتأۄًتأ؏أتًشأتۏڬأهڔڬۏأ““أتوتوۄأثىحأتثۏأتهؼتظأ‛‛أځۏزتأۄًةۏأۗأذعشحأتثًتهؼتظأشعۏأتههۄأؼىۄأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأڬەأزًشأرهتلحأوۏڽأضىأ44أۄدشۏأڬًألًحأۄًةەأۗأ"
"6694","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأ+أتثًتهؼتظأڬەأوضهوتىأۄًىەأڬەأثؼزأ"
"6695","أؼوشًأثىأطؼۏثأتځىەأًتهزأضەأ؏أًۄأتىأڬەأزتزتأضەأشًتۏحأڬشحەأۄۏڽأ+ألشوتحەأۄۏڽأڬۄأ"
"6696","أصثۏشأثىأثڬتشأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أؼثزتههۄأثىأؼتوشأثىأڬشۏصأثىأشثۏؼۄأثىأذثۏثأثىأؼثزطوضأثىأؼثزأوىتلأ‛‛أتىأڬۏأًتهزۄأ““أزدتدۄأثىحأتضوتؤأثىأظهحأثىأذثۏثأثىأدتشۏۄأثىأۄهتهأثىأذصتوأ‛‛أۄۏڽأۗأذعشحأؼخوتىأثىأؼلتىأشعۏأتههۄأؼىۄأىەأثظشۄأضەأذعشحأتثًوًضۏٳأتطؼشۏأڬًأوؼصًهأڬشأڬەأتىأڬًأًۄتڽأڬتأؼتوهأثىتۏتأحہتأۗأذعشحأتثًوًضۏٳأتطؼشۏأشعۏأتههۄأؼىۄأىەأ+أتځىەأوؼصًهۏأڬەأذڬوأڬەأثؼزأ"
"6697","%أؼثزتههۄأثىأؼتوشأثىأڬشۏصأتًشأذعشحأؼثزتههۄأثىأصثۏشأشعۏأتههۄأؼىۄوتأضەأوشًۏأۄەأڬۄأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدًأطرظأتځىەأوتهأڬۏأذلتػحأڬشحەأۄًةەأوتشتأدتةەأًۄأطۄۏزأۄەأۗ"
"6698","أتثىأتضذتمأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أۄىزأثىأتثۏأۄتهۄأثىحأوتهڬأ‛‛ۗأإځأثىًتضۏزأثىأؼوشًأثىأحوۏوأوۏڽأضەأحہەأ؏أثىًأؼثزتهزتشأڬەأذهۏلأحہەأ؏أإځأذعشحأرزۏدۄأشعۏأتههۄأؼىۄتأڬەأثۏټەأۄۏڽأۗأ"
"6699","أتثًؼثۏزۄألشوتحەأۄۏڽأ=أتثًۄتهۄأذعشحأرزۏدۄأڬەأطًۄشأحہەأ؏أتىأڬتأىتوأ““أىثتطأثىأصشتشۄأ‛‛أۄەأۗأتىأڬەأزًىًڽأثۏټەأۄىزأتًشأۄتهۄأشعۏأتههۄأؼىۄوتأدىڲأتذزأوۏڽأطشۏڬأۄًةەأۗأ"
"6700","أذعشحأذضىأثىأؼهۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏشەأوتوًڽأۄىزأثىأتثۏأۄتهۄأشعۏأتههۄأؼىۄأثڔەأتذضىأتىزتصأوۏڽأشضًهأتههۄأ﷽أڬتأضشتځتأثۏتىأڬۏتأڬشحەأحہەأ؏أوۏڽأىەأتىأضەأځًډہتأ=ۗۗۗۗۗأتضأڬەأثؼزأځًشۏأولظهأذزۏخأثۏتىأڬۏأۗأ"
"6701","أصۏزأثىأۄتهۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأًۄأشضًهأتههۄأ﷽أڬەأځتضأڲةەأ؏أتضأًمحأذعًشأ﷽أإشتوألشوتأشۄەأحہەأ؏أ+أتىأڬەأإىەأځشأ"
"6702","أوظؼثأثىأؼثزتههۄأصثۏشۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أؼثزتههۄأثىأصوؼۄأثىأتضًزأثىأوغهثأثىأتضزأثىأؼثزتهؼصۏٳأثىأمظۏأ‛‛أتىأڬۏأًتهزۄأ““أمشۏثۄأثىحأتوۏۄأثىأؼثزتههۄأثىأؼوشأثىأورصًوأ‛‛أۄۏڽأۗأتًشأ+أتىأمشۏثۄأ"
"6703","%أؼثزتههۄأثىأصوؼۄأثىأتضًزأثىأوغهثأثىأتضزألشوتحەأۄۏڽأ=أدثأشضًهأتههۄأ﷽أصۏتزۄأؼهۏهأۄًةەأ؏أحًأوۏڽأوضهوتىًڽأڬۏأتۏڬأدوتؼحأڬەأۄوشتۄأوۏڽأذعًشأ﷽أڬۏأرزوحأوۏڽأذتعشأحہتأ؏أذعشحأثهتهأىەأتستىأزۏأ؏أذعًشأ﷽أىەألشوتۏتأ=أڬضۏأڬًأڬۄۄأزًأڬۄأًۄأهًڲًڽأڬًأىوتصأځڔہتةەأ؏أإځألشوتحەأۄۏڽأ=أوۏڽأًۄتڽأضەأىڬهتأ؏أوۏڽأىەأزۏڬہتأڬۄأذعشحأؼوشأشعۏأتههۄأؼىۄأهًڲًڽأوۏڽأوًدًزأحہەأدثڬۄأذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأوًدًزأىۄأحہەأ؏أوۏڽأىەأذعشحأؼوشأشعۏأتههۄأؼىۄأضەأؼشعأڬۏأ=أتەأؼوشأ$أإځأهًڲًڽأڬًأىوتصأځڔہتأزۏدةەأ؏أذعشحأؼوشأشعۏأتههۄأؼىۄأىوتصأځڔہتىەأڬەأهةەأڬہڔەأۄًأڲةەأ؏أذعشحأؼوشأشعۏأتههۄأؼىۄأڬۏأإًتصأىضثحتَأثهىزأحہۏأ؏أدثأتىۄًڽأىەأحڬثۏشأحذشۏوۄأڬۄۏأ؏أشضًهأتههۄأ﷽أىەأدثأتىأڬۏأإًتصأضىۏأ؏أحًأځًډہتأ=أتثًثڬشأڬۄتڽأۄەأآأتههۄأحؼتهۏٳأتًشأوضهوتىأتضأثتحأڬًأځضىزأىۄۏڽأڬشحەأ+أڬۄأتثًثڬشأڬەأۄًحەأۄًةەأڬًةۏأزًضشتأىوتصأځڔہتةەأ"
"6704","%أرهۏلۄأثىأرۏتغأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أتثًتوتوۄأظزۏأثىأؼدهتىأثىأًۄثأثىأؼشۏثأثىأًۄثأثىأشثتذأثىأذتشخأثىأًۄثأثىأوؼىأثىأوتهڬأثىأتؼظشأثىأضؼزأثىأمۏضأؼۏهتىأثىأىعشأ‛‛أإځأطتوأوۏڽأمۏتوأځسۏشأشۄەأۗأرهۏلۄأڬۄحەأۄۏڽأ=أؼثزتهوهڬأثىأمشۏثأتظوؼۏأىەأتىأڬتأىضثأثۏتىأڬشحەأۄًةەأڬۄتأۄەأ=““أثتۄهۄأ‛‛أوؼىأثىأوتهڬأثىأتؼظشأثىأضؼزأثىأمۏضأؼۏهتىأڬۏأثۏًۏأۄەأۗأثتۄهۄأڬۏأتًهتزأتضۏأڬۏأدتىثأوىضًثأۄًحۏأۄەأ؏أۏۄأ““أثتۄهۄأثىحأضؼزأتهؼطۏشۄأثىأوتهڬأثىأتززأثىأصۏزأثىأۏطدثأثىأۏؼشثأثىأمذغتىأ‛‛أۄەأۗ"
"6705","%أذعشحأتثًتوتوۄأثتۄهۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأودہەأتۏڬأمًوأڬۏأدتىثأتههۄأحؼتهۏٳأڬەأزۏىأتًشأطشۏؼحأوغۄشۄأڬەأتذڬتوأڬۏأحثهۏؽأڬەأهةەأثہۏدتأ؏أوۏڽأتىأڬەأځتضأإۏتأ؏أتىۄًڽأىەأتځىەأتًىټًڽأڬًأځتىۏأضەأضۏشتثأڬۏتأ؏أتىأڬتأزًزہأزًۄتأتًشأځۏتأ؏أدثأتىۄًڽأىەأودہەأزۏڬہتأحًأودہەأرًطأإوزۏزأڬۄتأ؏أځہشأڬۄىەأهڲەأ=أۄوۏڽأځحتأډهتأۄەأڬۄأحوأتضأإزوۏأڬەأځۏډہەأهڲأڬشأظتثۏأۄًأډڬەأۄًأآأوۏڽأىەأڬۄتأ=أىۄۏڽأ؏أثهڬۄأوۏڽأحًأتههۄأحؼتهۏٳأتًشأتضأڬەأشضًهأ﷽أځشأتۏوتىأهتۏتأۄًڽأۗأتًشأشضًهأتههۄأ﷽أىەأودہەأحوۄتشەأځتضأتههۄأحؼتهۏٳأڬتأزۏىأتًشأتضأڬۏأطشۏؼحأڬەأتذڬتوأضڬہتىەأڬەأهةەأثہۏدتأۄەأ؏أتضۏأزًشتىأًۄأهًڲأرًىأڬتأثہشتأۄًتأځۏتهۄأهتةەأ؏أتًشأتځىەأضتوىەأشڬہأهۏتأ؏أضثأهًڲأتضأځشأدوؼأۄًأڲةەأتًشأڬہتىەأهڲەأۗأتىۄًڽأىەأودہەأثہۏأظهذأوتشۏأ؏أوۏڽأىەأڬۄتأ=أحوأۄهتڬأۄًأدتاأ؏أوۏڽأتۏضۏأۄضحۏأڬۏأغشلأضەأحوۄتشەأځتضأإۏتأۄًڽأدًأرًىأڬًأذشتوأمشتشأزۏحەأۄۏڽأتًشأۏۄأذڬوأتىأڬًأتضأډۏصأوۏڽأوهتأۄەأدًأتىأځشأتههۄأحؼتهۏٳأڬۏأغشلأتحتشۏأڲةۏأۄەأۗأتىۄًڽأىەأڬۄتأ=أًۄأڬۏتأذڬوأۄەأآأوۏڽأىەأڬۄتأ=أتىأځشأۏۄأإۏحأىتصهأۄًةۏأۄەأ=أ"
"6706","أرهۏلۄأثىأرۏتغأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أوؼتًۏۄأثىأذۏزۄأثىأوؼتًۏۄأثىأمطۏشأثىأڬؼثأثىأشثۏؼۄأثىأؼتوشأ‛‛أتىۄًڽأىەأتىأڬًأؼثزتههۄأثىأدتشًزأضەأوىضًثأڬۏتأۄەأۗأ"
"6707","أذعشحأوؼتًۏۄأثىأذۏزۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أوۏشەأذضىأضهًڬأڬتأضثأضەأصۏتزۄأذمزتشأڬًىأۄەأآأإځأ﷽أىەألشوتۏتأ=أحۏشۏأًتهزۄأۗأتضأڬەأثؼزأځًشۏأذزۏخأثۏتىأڬۏأۗأوۏڽأىەأتثىأؼًىأڬۏأثۄصأضەأشًتۏحأڬشزۄأذزۏخألمغأتىأڬەأًتهزأذڬۏوأڬەأذًتهەأضەأۄۏأثۏتىأڬۏأۄەأۗأ"
"6708","أذڬۏوأثىأوؼتًۏۄأثىأذۏزۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأتىۄًڽأىەأتځىەأثہتةۏأوتهڬأثىأذۏزۄأضەأڬۄتأ=أحوأوۏشەأضتحہأشضًهأتههۄأ﷽أڬەأځتضأډهًأ؏أڬۏًىڬۄأًۄأحوۄۏڽأځۄډتىحەأۄۏڽأ؏أودہەأىۄۏڽأځۄډتىحەأ؏أتىۄًڽأىەأوۏشەأڬډہأځڔًضۏًڽأڬًأڲشلحتشأڬشأهۏتأۄًتأۄەأۗأۄوأشضًهأتههۄأ﷽أڬەأځتضأډهەأإةەأ؏أوتهڬأثىأذۏزۄأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أوۏڽأثہۏأتضهتوأهتأډڬتأۄًڽأتًشأوۏشەأځڔًضۏأثہۏأوضهوتىأۄًأډڬەأۄۏڽأ؏أتضأهةەأإځأتىأڬًأشۄتأڬشأزۏدةەأ؏أإځأ﷽أىەأتىأڬًأڬًةۏأدًتثأىۄأزۏتأ؏أوتهڬأىەأزًثتشۄأڬۄتأ؏أذعًشأ﷽أىەأځہشأڬًةۏأدًتثأىۄأزۏتأ؏أًۄأؽظەأوۏڽأثځہشأڬشأڬہڔتأۄًتأتًشأڬۄىەأهڲتأ=أتڲشأحوأتضۏأغشذأڬشًأڲەأحًأًۄأضودہۏڽأڲەأڬۄأحوأدضأډۏصأڬتأزًضشًڽأڬًأذڬوأزۏحەأۄًأ؏أرًزأتضۏأذڬوأڬۏأرهتلأًشصۏأڬشحەأۄًأ؏أوۏڽأتضأڬًأڋتىټىەأهڲأڲۏتأتًشأتضأڬًأتۏضۏأثتحۏڽأڬشىەأضەأشًڬىەأهڲأڲۏتأۗأذعًشأ﷽أىەألشوتۏتأ=أۏۄأڬۏتأڬۄۄأشۄەأۄۏڽأآأهًڲًڽأىەأثحتۏتأڬۄأۏۄألهتڽألهتڽأثتحۏڽأڬشأشۄتأۄەأۗأذعًشأ﷽أىەألشوتۏتأ=أوۏڽأدًأڬډہأڬشأشۄتأۄًڽأ؏أتضأڬتأًثتهأوۏشەأتًځشأۄًأڲتأ؏أتضأضەأتىأڬتأحًأڬًةۏأىمظتىأىۄۏڽأۄەأ؏أتضأڬەأځڔًضۏًڽأڬًأډہًڔأزًأۗأ"
"6709","أذعشحأوروشأثىأذۏزۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أوۏڽأڬةۏأڬةۏأوۄۏىەأځتىۏأًتهەأؼهتمەأضەأثۄحأزًشأشۄحتأۄًڽأدثڬۄأوۏشۏأثۏًۏأوۏشەأۄوشتۄأۄًحۏأۄەأ؏أڬۏتأوۏڽأتضأضەأۄوثضحشۏأڬشأضڬحتأۄًڽأآأإځأ﷽أىەألشوتۏتأ=أدۏأۄتڽأۗأتڲشډۄأحوأ53أضتهأځتىۏأضەأزًشأشۄًأۗأ+أحثأثہۏأۄوثضحشۏأڬشأضڬحەأۄًأتًشأؽضهأڬەأهةەأحۏووأڬشأهۏتأڬشًأ"
"6710","%أصۄشۏأڬۄحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأؼشثأڬۏأزضأتۏضۏأرًتحۏىأضەأطتزۏأڬۏأدىأڬۏأذعًشأ﷽أڬەأضتحہأزًضشۏأطتزۏأحہۏأۗ"
"6711","%أؼثزتههۄأثىأوذوزأثىأؼمۏهألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأزضأؼًشحًڽأضەأطتزۏأڬۏأۗأتضأؼززأوۏڽأمحتزۄأتًشأزۏڲشأڬةۏأتةوۄأىەأوسڬًشۄأزًىًڽأشتًۏًڽأڬۏأورتهلحأڬۏأۄەأۗ"
"6712","%أذعشحأمحتزۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأ48أؼًشحًڽأضەأطتزۏأڬۏأۄەأۗأتىأوۏڽأضەأ9أڬتأحؼهمأمشۏطأضەأۄەأ؏أتۏڬأمشۏطأڬەأذهۏلأمثۏهەأضەأۄەأ؏أتًشأ:أرًتحۏىأزۏڲشأتۄهأؼشثأضەأۄۏڽأ؏أتًشأتۏڬأثىۏأتضشتةۏهأضەأحؼهمأشڬہحۏأۄەأۗأىثۏأتڬشوأ﷽أىەأدتۄهۏحأوۏڽأظشلأتۏڬأۄۏأطتزۏأڬۏأحہۏأۗ"
"6713","%أتثًؼثۏزأتهمتضوأثىأضهتوألشوتحەأۄۏڽأ=أۏۄأثتحأختثحأۄەأتًشأۄوتشەأىصزۏڬأظذۏذأۄەأڬۄأشضًهأتههۄأ﷽أىەأ4;أؼًشحًڽأضەأىڬتذأڬۏتأۗأتىأوۏڽأضەأ:أؼًشحۏڽأمشۏطأڬەأمثۏهًڽأضەأۄۏڽأ؏أتۏڬأمشۏطأڬەأذهۏلأمثۏهەأضەأۄۏڽأ؏أ:أتصًتدأزۏڲشأتۄهأؼشثأضەأۄۏڽأ؏أتۏڬأڬتأحؼهمأثىۏأتضشتةۏهأضەأۄەأ؏أًۄأذعشحأوًضۏٳأثىأۄتشًىأؼهۏۄأتهضهتوأڬەأثہتةۏأذعشحأۄتشًىأثىأؼوشتىأؼهۏۄأتهضهتوأڬۏأتًهتزأوۏڽأضەأۄۏڽأۗ"
"6714","أذعشحأدتثشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬەأضتحہأىڬتذأڬۏتأ؏أتضأًمحأتوأتهوًوىۏىأڬۏأؼوشأوثتشڬأ:أثشضأحہۏأ؏أتًشأدثأشرظحۏأۄًةۏأحًأتضأًمحأتىأڬۏأؼوشأ<أضتهأحہۏأ؏أدثأشضًهأتههۄأ﷽أڬتأًظتهأوثتشڬأۄًتأ؏أتضأًمحأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬۏأؼوشأ4;أثشضأحہۏأۗأ8:أضتهأڬۏأؼوشأوۏڽأذعشحأتوۏشأوؼتًۏۄأشعۏأتههۄأؼىۄأڬەأزًشأذڬًوحأوۏڽأإځأڬتأًظتهأۄًتأۗأ"
"6715","أوظؼثأثىأؼثزتههۄأصثۏشۏأؼثزتههۄأثىأوؼتًۏۄأڬەأًتضغەأضەأۄطتوأثىأؼشًۄأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأذعشحأؼشًۄأىەأًهۏزأثىأؼثزتهوهڬأثىأوشًتىأڬًأتۏڬأوڬحًثأهڬہتأدضأڬەأوىزشدتحأوۏڽأضەأۏۄأثہۏأحہتأ““أتًشأشضًهأتههۄأ﷽أىەأذعشحأرزۏدۄأشعۏأتههۄأؼىۄتأڬەأًظتهأڬەأثؼزأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬەأضتحہأىڬتذأڬۏتأۗأشضًهأتههۄأ﷽أڬًأرًتثأوۏڽأحۏىأوشحثۄأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأزڬہتةۏأڲةۏڽأتًشأإځأ﷽أڬًأثحتۏتأڲۏتأڬۄأۏۄأحوۄتشۏأثۏًۏأؼتةطۄأشعۏأتههۄأؼىۄتأۄەأۗأدضأزىأشضًهأتههۄأ﷽أىەأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأضەأىڬتذأڬۏتأتضأزىأتىأڬۏأؼوشأ:أضتهأحہۏأ؏أځہشأدثأشرظحۏأۄًةۏأتًشأإځأوزۏىۄأحطشۏلأهتةەأ؏أتضأًمحأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬۏأؼوشأ<أضتهأحہۏأۗأإځأڬتأًظتهأوىڲهأڬۏأشتحأڬًأىوتصأًحشأڬەأثؼزأۄًتأ؏أتضۏأشتحأإځأڬًأ49أشوعتىأتهوثتشڬأڬًأدىحأتهثمۏؼأوۏڽأزلىأڬشأزۏتأڲۏتأۗأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأىەأإځأڬۏأىوتصأدىتصۄأځڔہتةۏأ؏أتضأزىأوشًتىأًۄتڽأځشأوًدًزأىۄأحہتأتًشأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأتضأڬەأىتةثأۄًتأڬشحەأحہەأۗأ"
"6716","%أوذوزأثىأؼوشألشوتحەأۄۏڽأ=أؼتةطۄأثىحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄتأڬۏأًتهزۄأ““أتوأشًوتىأثىحأؼتوشأثىأؼًۏوشأثىأؼثزطوضأثىأؼحتثأثىأتسۏىۄأثىأضثۏؼأثىأزۄوىتأثىأذتشخأثىأؽىوأثىأوتهڬأثىأڬىتىۄأ‛‛أۄۏڽأۗأشضًهأتههۄأ﷽أىەأۄدشحأضەأحۏىأضتهأځۄهەأىثًحأڬەأ43أًۏڽأضتهأطًتهأتهوڬشوأوۏڽأتىأضەأىڬتذأڬۏتأ؏أتًشأۄدشحأڬەأ;أوتۄأثؼزأطًتهأتهوڬشوأوۏڽأتىأڬۏأشرظحۏأؼوهأوۏڽأإةۏأ؏أتًشأشرظحۏأڬەأًمحأتىأڬۏأؼوشأ<أضتهأحہۏأۗ"
"6717","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأرًزأتځىەأثتشەأوۏڽأًظۏحألشوتۏتأڬشحۏأحہۏڽأڬۄأتىۄۏڽأتىأڬەأذدشەأوۏڽأشضًهأتههۄأ﷽أتًشأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأڬەأمشۏثأزلىأڬۏتأدتةەأ؏أإځألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أڬەأًظتهأڬەأثؼزأوۏڽأىەألۏظهۄأڬۏتأڬۄأودہەأذعًشأ﷽أڬۏأزۏڲشأتصًتدأڬەأۄوشتۄأدىحأتهثمۏؼأوۏڽأزلىأۄًىتأۄەأ؏أډىتىډۄأتىأڬًأدىحأتهثمۏؼأوۏڽأزلىأڬۏتأڲۏتأۗ"
"6718","%أذعشحأؼوتشأثىأۏتضشأشعۏأتههۄأؼىۄأتههۄأحؼتهۏٳأڬۏأمضوأڬہتأڬشأڬۄتأڬشحەأحہەأڬۄأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأزىۏتأتًشأإرشحأوۏڽأشضًهأتههۄأ﷽أڬۏأصًدۄأۄۏڽأۗ"
"6719","أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أڬتأًظتهأوۏشۏأثتشۏأڬەأزىأ؏أوۏشەأذدشەأوۏڽأ؏أوۏشۏأشتحأوۏڽأ؏أوۏشەأضۏىەأځشأۄًتأۗأذعشحأؼثزتهشذوىأثىأتثۏأثڬشأشعۏأتههۄأؼىۄوتأذتعشأثتشڲتۄأۄًةەأ؏أتىأڬەأځتضأځۏهًأڬۏأوضًتڬأحہۏأۗأشضًهأتههۄأ﷽أىەأتىأڬۏأغشلأزۏڬہتأ؏أوۏڽأىەأڬۄتأ=أتەأؼثزتهشذوىأ$أتضأڬًأًۄتڽأضەأتټہتأهۏدةەأ؏أتىۄًڽأىەأًۄأوضًتڬأتټہتأڬشأودہەأزەأزۏأ؏أوۏڽأىەأډثتأڬشأىشوأڬشأڬەأىثۏأتڬشوأ﷽أڬًأځۏطأڬۏأ؏أذعًشأ﷽أىەأًۄأوضًتڬأتضحؼوتهألشوتةۏأۗأ"
"6720","أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أڬتأًظتهأوۏشەأڲہشأ؏أوۏشەأزىأ؏أوۏشۏأشتحأ؏أوۏشەأضۏىەأځشأۄًتأ؏أذعشحأؼثزتهشذوىأثىأتثۏأثڬشأشعۏأتههۄأؼىۄوتأًۄتڽأإةەأ؏أتىأڬەأځتضأتۏڬأحتصۄأوضًتڬأحہۏأ؏أذعًشأ﷽أتضأڬۏأدتىثأزۏڬہىەأهڲەأ؏أوۏڽأضودہأڲةۏأڬۄأإځأڬتأوضًتڬأڬشىەأڬًأزهأڬشأشۄتأۄەأ؏أوۏڽأىەأتىأضەأوضًتڬأځڬڔۏأ؏أتضأڬًأډثتأڬشأ؏أىشوأڬشأڬەأإځأ﷽أڬًأځۏطأڬشأزۏأ؏أذعًشأ﷽أىەأًۄأوضًتڬأؽۏشأوؼوًهۏأغًشأځشأثۄحأصۏتزۄأتضحؼوتهألشوتةۏأ؏أوۏڽأىەأتضأضەأځۄهەأإځأڬًأڬثہۏأتۏضەأوضًتڬأڬشحەأىۄۏڽأزۏڬہتأۗأځہشأذعًشأ﷽أىەأًۄأوضًتڬأوۏشۏأدتىثأثڔہتةۏأهۏڬىأإځأڬتأۄتحہأىۏډەأڲشأڲۏتأ؏أوۏڽأإځأڬەأهةەأًۄأزؼتةۏڽأځڔہىەأهڲۏأدًأذعشحأدثشۏهأتوۏىأؼهۏۄأتهضهتوأإځأ﷽أڬەأهةەأځڔہتأڬشحەأحہەأتًشأدًأزؼتةۏڽأذعًشأ﷽أثۏوتشۏأڬەأؼتهوأوۏڽأرًزأتځىەأهةەأځڔہتأڬشحەأحہەأ؏أهۏڬىأذعًشأ﷽أىەأتضأثۏوتشۏأوۏڽأًۄأزؼتةۏڽأىۄۏڽأځڔہۏڽأ؏أځہشأذعًشأ﷽أىەأتځىتأډۄشۄأإضوتىأڬۏأدتىثأڬۏتأتًشأڬۄتأ““أتهشلۏمأتهتؼهۏأ‛‛ۗأتضأڬەأضتحہأۄۏأذعًشأ﷽أڬۏأشًذأځشًتصأڬشأڲةۏأۗأتههۄأحؼتهۏٳأڬتأطڬشأۄەأدضأىەأذعًشأ﷽أڬۏأذۏتحأڬەأإرشۏأزىأثہۏأودہەأإځأڬۏأرزوحأڬۏأحًلۏمأؼغتألشوتةۏأۗأ"
"6721","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أوۏڽأتضأذدشەأوۏڽأدتۏتأڬشحۏأحہۏأ؏أدضأوۏڽأشضًهأتههۄأ﷽أتًشأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأڬەأۄوشتۄأذعشحأؼوشأشعۏأتههۄأؼىۄأوزلًىأۄۏڽأۗأتههۄأڬۏأمضوأ$أذعشحأؼوشأشعۏأتههۄأؼىۄأضەأذۏتؤأڬۏأثىتؤأځشأوۏڽأڬثہۏأثہۏأثؽۏشأځشزۄأڬەأًۄتڽأىۄۏڽأڲةۏأۗ"
"6722","أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أوۏڽأىەأذعشحأدثشۏهأتوۏىأؼهۏۄأتهضهتوأڬًأتځىەأتضأذدشەأوۏڽأڬہڔەأزۏڬہتأتًشأشضًهأتههۄأ﷽أتىأڬەأضتحہأضشڲًطۏأوۏڽأثتحۏڽأڬۏتأڬشحەأحہەأ؏أدثأًۄأإةەأحًأوۏڽأىەأځًډہتأ=أۏتأشضًهأتههۄأ﷽أ$أۏۄأڬًىأۄەأآأذعًشأ﷽أىەألشوتۏتأ=أحوۄۏڽأۏۄأڬضأإزوۏأدۏضتأهڲحتأۄەأآأوۏڽأىەأڬۄتأ=أزذۏۄأڬهثۏأشعۏأتههۄأؼىۄأدۏضتأۗأإځأ﷽أىەألشوتۏتأ=أثەأطڬأحوأىەأرۏشأڬخۏشأزۏڬہۏأۄەأ؏أًۄأدثشۏهأتوۏىأؼهۏۄأتهضهتوأۄۏڽأۗأځہشأحہًڔۏأۄۏأزۏشأڬەأثؼزأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أۏۄأدثشۏهأحوۄۏڽأضهتوأڬۄۄأشۄەأۄۏڽأۗأوۏڽأىەأتىأتهلتػأوۏڽأتىأڬەأضهتوأڬتأدًتثأزۏتأ““أًأؼهۏۄأتهضهتوأدصتۄأتههۄأوىأزرۏهأرۏشتأ‛‛أ+أًؼهۏۄأتهضهتوأ؏أتههۄأحؼتهۏٳأۏۄتڽأإىەأڬۏأتىأڬًأدصتةەأرۏشأؼغتألشوتةەأ"
"6723","أذعشحأوظؼثأثىأضؼزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحأؼوشأشعۏأتههۄأؼىۄأىەأتوۄتحأتهوًوىۏىأڬەأهةەأ43333أزشتۄوأومششأڬةەأحہەأتًشأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬًأزًأۄصتشأصتةزأځۏطأڬۏتأڬشحەأحہەأۗأتًشألشوتحەأحہەأ=أۏۄأشضًهأتههۄأ﷽أڬۏأځۏتشۏأۄۏڽأۗأ"
"6724","%أذعشحأضؼزألشوتحەأۄۏڽأ=أثزشۏأظذتثۄأڬًأډہأډہأۄصتشأذظظأوهحەأحہەأتًشأتوۄتحأتهوًوىۏىأوۏڽأضەأۄشأتۏڬأڬًأزضأزضأۄصتشأۗأضًتةەأحۏىأتصًتدأڬەأۗ"
"6725","أذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬەأإصتزأڬشزۄأؽهتوأتثًؼوشًأڬۄحەأۄۏڽأ=أؼشتمأضەأتۏڬأحتثًحأذعشحأؼوشأشعۏأتههۄأؼىۄأڬەأځتضأإۏتأ؏أتضأوۏڽأۄۏشتأحہتأۗأذعشحأؼوشأشعۏأتههۄأؼىۄأىەأتځىەأضتحہۏًڽأضەأڬۄتأ=أحوأدتىحەأۄًأڬۄأتضأڬۏأمۏوحأڬۏتأۄەأآأتىۄًڽأىەأڬۄتأ=أدۏأىۄۏڽأۗأتًشأتىأڬًأۏۄأضودہأىۄۏڽأإأشۄۏأحہۏأڬۄأتضأڬًأحمضۏوأڬۏضەأڬۏتأدتةەأۗأذعشحأؼوشأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أتڲشأحوأهًڲأتدتصحأزًأحًأوۏڽأۏۄأۄۏشتأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬًأثہۏدأزۏحتأۄًڽأڬۏًىڬۄأشضًهأتههۄأ﷽أتىأضەأثۄحأوذثحأڬشحەأحہەأۗأضثأهًڲًڽأىەأوحلمۄأغًشأځشأتدتصحأزەأزۏأۗأذعشحأؼوشأشعۏأتههۄأؼىۄأىەأًۄأظىزًمأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬۏأرزوحأوۏڽأثہۏدأزۏتأۗأتوأتهوًوىۏىأىەأتضأڬًأڬہًهأڬشأزۏڬہتأحًأثەأضترحۄأثًهأتټہۏڽأ=أشضًهأتههۄأ﷽أڬەأثؼزأتثىأرغتثأشعۏأتههۄأؼىۄأځشألحًذتحأڬتأڬۏضتأزشًتصۄأڬہهتأۄەأ؏أتەأتههۄأ$أحًأودہەأإةىزۄأتىأڬەأؼغۏۄأڬەأهةەأثتمۏأىۄأشڬہىتأۗأ"
"6726","%أتثىأتثۏأوهۏڬۄألشوتحەأۄۏڽأ=أدثأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأثۏوتشأۄًةۏڽأحًأذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأتىأڬۏأؼۏتزحأڬەأهةەأإةەأ؏أتىزشأإىەأڬۏأتدتصحأوتىڲۏأ؏أتوأتهوًوىۏىأىەأتدتصحأىۄأزۏأ؏أتوأتهوًوىۏىأڬەأثہحۏدًڽأىەأضلتشطأڬۏأڬۄأإځأتىأڬًأتدتصحأزەأزۏدةەأ؏أۏۄأحًأإځأڬەأرۏشرًتۄأۄۏڽأ؏أتوأتهوًوىۏىأىەأځہشأتىڬتشأڬۏتأ؏أًۄأهًڲأوضهضهأضلتشطأڬشحەأشۄەأ؏أثتهإرشأتىۄًڽأىەأتدتصحأزەأزۏأۗأدثأذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأتىأڬەأځتضأإةەأتًشأڬۄىەأهڲەأ=““أإځأڬۏأضؼتزحأوىزۏأڬۏأثىتؤأځشأإځأڬتأىتوأ““أتوأتهوًوىۏىأ‛‛أۄەأ؏أتًشأإځأڬتأۏۄأىتوأإځأڬۏأځۏزتةطأضەأثہۏأځۄهەأڬتأۄەأ؏أشضًهأتههۄأ﷽أضثأضەأصۏتزۄأإځأضەأوذثحأڬشحەأحہەأ؏أتًشأشضًهأتههۄأ﷽أإځأۄۏأضەأوذثحأڬشحەأحہەأ؏أدثأحڬأدضوأوۏڽأشًذأۄەأ؏أإځأضەأوذثحأڬشىەأًتهەأإځأضەأوهىەأإحەأشۄۏڽأڲەأ؏أتثًتؤأڬۏأشتحأإځأڬتأۄتشأڲوأۄًأڲۏتأحہتأ؏أتههۄأحؼتهۏٳأىەأًۄأثہۏأتوحأڬەأهةەأثۄحشأڬشأزۏتأۗأتههۄأحؼتهۏٳأىەأحۏووأڬەأتذڬتوأًتهۏأإۏحأىتصهألشوتةۏأۗأإځأڬەأذمأوۏڽأمشإىأڬۏأإۏتحأىتصهأۄًةۏڽأۗأوضهوتىًڽأڬۏأۄشأوضدزأوۏڽأزىأشتحأإځأڬەأؼسشأڬۏأإۏتحأحهتًحأۄًحۏأشۄۏڽأڲۏأۗأتوأتهوًوىۏىأىەأڬۄتأ=أتەأتثىأؼثتضأودہەأوۏشەأذتهأځشأډہًڔأزًأ؏أوۏڽأډتۄحۏأۄًڽأ؏أڬتطأڬۄأوۏڽأىضۏتأوىضۏتأۄًأدتحۏأ+أۏؼىۏأوۏشتأىتوأًأىطتىأحڬأوټأدتةەأ"
"6727","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أوۏشۏأطتزۏأضەأځۄهەأذعشحأدثشۏهأتوۏىأؼهۏۄأتهضهتوأىەأوۏشۏأحظًۏشأهتأڬشأشضًهأتههۄأ﷽أڬًأزڬہتةۏأتًشأڬۄتأ=أۏۄأإځأڬۏأثۏًۏأۄەأۗأإځأ﷽أىەأودہأضەأىڬتذأڬۏتأ؏أوۏڽأتضأًمحأډہًټۏأثډۏأحہۏأ؏أدثأإځأ﷽أىەأودہأضەأىڬتذأڬشأهۏتأ؏أتههۄأحؼتهۏٳأىەأودہأځشأذۏتؤأتهمتؤألشوتأزۏتأوۏڽأتضأًمحأډہًټۏأحہۏأۗ"
"6728","أتوأضهوۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أوۏشۏأضتحہۏًڽأ+أزۏڲشأتصًتدأ"
"6729","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أىەأضۏزۄألتغوۄأشعۏأتههۄأؼىۄتأڬتأسڬشأڬۏتأۗأإځألشوتحۏأۄۏڽأ=أوۏڽأىەأڬۄتأ=أ+أًۄأحًألتغوۄأڬۏألعۏهحأۄەأ؏أ"
"6730","%أؼثزتهشذوىأثىأعذتڬأثۏتىأڬشحەأۄۏڽأڬۄأؼثزتههۄأثىأظلًتىأتًشأتۏڬأزًضشتأطرظأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬەأځتضأإةەأ؏أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأىەأتىأوۏڽأضەأتۏڬأضەألشوتۏتأ=أتەألهتڽأ$أڬۏتأحوأىەأذلظۄأًتهۏأثتحأضىۏأۄەأآأتضأىەأڬۄتأ=أدۏأۄتڽأتەأتوأتهوًوىۏىأۗأذعشحأؼثزتههۄأثىأظلًتىأشعۏأتههۄأؼىۄأىەأځًډہتأ=أتەأتوأتهوًوىۏىأ$أًۄأڬًىأضۏأثتحأۄەأآأتوأتهوًوىۏىأىەألشوتۏتأ=أوۏشۏأىًأرتظۏحۏڽأتۏضۏأۄۏڽأدًأودہأضەأځۄهەأڬضۏأرتحًىأڬًأىظۏثأىۄۏڽأۄًةۏڽأ؏أضًتةەأتضألعۏهحأڬەأدًأڬۄأتههۄأحؼتهۏٳأىەأذعشحأوشۏوأثىحأؼوشتىأشعۏأتههۄأؼىۄتأڬًأؼغتألشوتةۏأۄەأۗأتههۄأڬۏأمضوأ$أوۏڽأتځىۏأضتحہۏًڽأ+أزۏڲشأتوۄتحأتهوًوىۏىأ"
"6731","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أضًشۆأتهىًشأڬۏأإۏحأىوثشأ56أ="
"6732","أذعشحأتذىلأثىأمۏضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأ؏أذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأ؏أذعشحأؼخوتىأؽىۏأشعۏأتههۄأؼىۄأتًشأذعشحأؼهۏأتثىأتثۏأغتهثأشعۏأتههۄأؼىۄأتًشأزۏڲشأرهلتؤأڬەأإدأحڬأرغثەأضىحتأإۏتأۄًڽأ؏أهۏڬىأدضأتذضىأتًشألظۏذأًأثهۏؽأتىزتصأوۏڽأضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتأڲلحڲًألشوتۏتأڬشحۏأحہۏڽأ؏أوۏڽأىەأتىأوۏڽأضەأڬضۏأڬًأثہۏأتۏضۏأڲلحڲًأڬشحەأىۄۏڽأضىتأۄەأۗأ"
"6733","أۄطتوأثىأؼشًۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأوۏڽأىەأڬًةۏأطرظأتۏضتأىۄۏڽأزۏڬہتأدًأضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتأضەأصۏتزۄأذهتهأًأذشتوأ؏أؼهوأ؏أطؼشأتًشأغثأڬًأدتىحتأۄًأۗأ"
"6734","أصۄشۏأڬۄحەأۄۏڽأ=أتڲشأحوتوأهًڲًڽأڬتأؼهوأدوؼأڬشأهۏتأدتةەأځہشأشضًهأتههۄأ﷽أڬۏأزۏڲشأتصًتدأوغۄشتحأڬتأؼهوأدوؼأڬشأهۏتأدتةەأ؏أضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتأڬتأؼهوأتىأحوتوأضەأصۏتزۄأًضۏؼأحہتأۗأ"
"6735","أذعشحأوًضۏٳأثىأغهذۄألشوتحەأۄۏڽأ=أوۏڽأىەأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأضەأصۏتزۄألظۏذأڬضۏأڬًأىۄۏڽأزۏڬہتأۗأ"
"6736","أذعشحأوضشًمأڬۄحەأۄۏڽأ=أتىأضەأڬضۏأىەأځًډہتأ=أڬۏتأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأًشتخحأڬەأوضتةهأظذۏذأغشذأدتىحۏأحہۏڽأآأتىۄًڽأىەأڬۄتأ=أدۏأۄتڽأ؏أتضأستحأڬۏأمضوأدضأڬەأمثعۄأمزشحأوۏڽأوۏشۏأدتىأۄەأوۏڽأىەأثڔەأثڔەأڬثتشأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأڬًأتىأضەأًشتخحأڬەأوضتةهأځًډہحەأزۏڬہتأۄەأۗأ"
"6737","أتثىأتثۏأوهۏڬۄأضەأوشًۏأۄەأ؏أإځألشوتحەأۄۏڽأ=أوۏڽأىەأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأضەأڬۄتأ=أإځأذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأڬۏأظتذثصتزۏأۄًأڬشأطؼشأڬۄحۏأۄۏڽأآأإځأڬًأڬډہأځشًتۄأىۄۏڽأۄەأآأتًشأإځأڬتأغثأڬەأوحؼهمأؼهوأڬحىتأۄەأآأتىۄًڽأىەألشوتۏتأ=أشضًهأتههۄأ﷽أدثأثۏوتشأۄًةەأحًأؼشثأڬەأثۄحأًلًزأإځأ﷽أڬۏأؼۏتزحأڬەأهةەأإحەأحہەأًۄأهًڲأتځىەأتځىەأؼهوأڬەأوغتثمأشضًهأتههۄأ﷽أڬًأؼهتدأثحتۏتأڬشحەأحہەأ؏أوۏڽأىەأًۄأحوتوأضىأڬشأۏتزأڬشأهةەأۄۏڽأۗأ"
"6738","أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أوۏڽأ؏أوۏشەأًتهزأظتذثأذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأتًشأوۏشۏأًتهزۄأذعشحأتوأشًوتىأشعۏأتههۄأؼىۄتأشضًهأتههۄأ﷽أڬۏأثتڲتۄأوۏڽأڲةەأ؏أوۏشەأوتڽأثتځأىەأؼشعأڬۏأ=أۄوأډتۄحەأۄۏڽأڬۄأإځأؼتةطۄأشعۏأتههۄأؼىۄتأڬەأهةەأڬًةۏأزؼتألشوتةۏڽأ؏أۄوأًۄأزؼتأضىۏڽأۗأىثۏأتڬشوأ﷽أىەأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬەأهةەأۏًڽأزؼتألشوتةۏأ““أتەأتههۄأ$أؼتةطۄأثىحأتثًثڬشأظزۏمأڬۏأػتۄشۏأ؏أثتغىۏأ؏أذحوۏأوؽلشحألشوتأ‛‛ۗأىثۏأتڬشوأ﷽أڬۏأۏۄأرًثظًشحأزؼتأ؏أتىأڬەأًتهزۏىأڬًأثۄحأتډہۏأهڲۏأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أحوأؼتةطۄأڬەأهةەأوۏشۏأتضأزؼتأضەأذۏشتىأڬۏًڽأۄًأشۄەأۄًأآأوۏشۏأۏۄأزؼتأۄشأتضأطرظأڬەأهةەأۄەأدًأتضأثتحأڬۏأڲًتۄۏأزەأڬۄأتههۄأحؼتهۏٳأڬەأضًتأڬًةۏأؼثتزحأڬەأهتةمأىۄۏڽأۄەأتًشأۏۄأوۏڽأتههۄأحؼتهۏٳأڬتأإرشۏأشضًهأۄًڽأۗأ"
"6739","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أضەأځًډہتأڲۏتأ=أإځأضثأضەأصۏتزۄأڬضأضەأوذثحألشوتحەأۄۏڽأآأإځأ﷽أىەألشوتۏتأ=أؼتةطۄأضەأۗأإځأ﷽أضەأؼشعأڬۏأڲةۏأ=أۄوأإځأڬۏأتصًتدأڬەأثتشەأوۏڽأىۄۏڽأځًډہأشۄەأ؏أحًأذعًشأ﷽أىەألشوتۏتأ=أتثًثڬشأضەأۗ"
"6740","أذعشحأؼوشًأثىأتهؼتظأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأودہەأتۏڬأهطڬشأڬتأضځۄأضتهتشأثىتأڬشأثہۏدتأ؏أتضأهطڬشأوۏڽأذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأثہۏأحہەأ؏أذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأثہۏأحہەأۗأدثأوۏڽأتضأوۄوأضەأًتځضأهًټتأحًأوۏڽأىەأځًډہتأ=أۏتأشضًهأتههۄأ﷽أإځأضثأضەأصۏتزۄأڬضأضەأوذثحألشوتحەأۄۏڽأآأإځأ﷽أىەأځًډہتأ=أۏۄأضًتهأڬشىەأڬتأحوۄتشتأومظزأڬۏتأۄەأآأوۏڽأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أ$أوۏڽأتځىەأؼهوأوۏڽأتعتلۄأڬشىتأډتۄحتأۄًڽأ؏أإځأ﷽أىەألشوتۏتأ=أؼتةطۄأضەأۗأوۏڽأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أوۏڽأىەأوشزًڽأڬەأثتشەأوۏڽأځًډہتأۄەأ؏أإځأ﷽أىەألشوتۏتأ=أتضأڬەأًتهزأضەأۗأ"
"6741","أذعشحأؼوشًأثىأتهؼتظأشعۏأتههۄأؼىۄأڬەأثتشەأوۏڽأوشًۏأۄەأڬۄأدثأًۄأؽصًۄأستحأتهضهتضهأضەأًتځضأإةەأحًأتىۄًڽأىەأىثۏأتڬشوأ﷽أضەأځًډہتأ=أۏتأشضًهأتههۄأ﷽أإځأضثأضەأصۏتزۄأڬضأضەأځۏتشأڬشحەأۄۏڽأآأإځأ﷽أىەألشوتۏتأ=أؼتةطۄأضەأۗأوۏڽأىەأڬۄتأ=أوۏڽأىەأوشزًڽأڬەأذًتهەأضەأځًډہتأۄەأۗأإځأ﷽أىەألشوتۏتأ=أتضأڬەأًتهزأضەأۗأ"
"6742","أؼتوشأطؼثۏأثۏتىأڬشحەأۄۏڽأڬۄأوۏشەأځتضأتۏڬأإزوۏأإۏتأتًشأڬۄىەأهڲتأ=أؼتةطۄأڬەأؼهتًۄأوۏڽأضثأتوۄتحأتهوًوىۏىأضەأوذثحأڬشحتأۄًڽأۗأوۏڽأىەأڬۄتأ=أحوأشضًهأتههۄأ﷽أڬۏأورتهلحأڬشأشۄەأۄًأ؏أڬۏًىڬۄأشضًهأتههۄأ﷽أحوتوأتصًتدأضەأصۏتزۄأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأضەأوذثحأڬۏتأڬشحەأحہەأۗأ"
"6743","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أإځأڬۏأتصًتدأوۏڽأضەأدىحأوۏڽأڬًىأڬًىأدتةەأڲۏأآأإځأ﷽أىەألشوتۏتأ=أحًأثہۏأتىۄۏڽأوۏڽأضەأۄەأۗأإځألشوتحۏأۄۏڽأ=أتضأضەأودہەأتىزتصۄأۄًأڲۏتأڬۄأإځأ﷽أوۏشەأؼهتًۄأتًشأڬضۏأڬىًتشۏأهڔڬۏأضەأطتزۏأىۄۏڽأڬشۏڽأڲەأۗ"
"6744","%أذعشحأوضشًمألشوتحەأۄۏڽأ=أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأىەأودہأضەأڬۄتأ=أوۏڽأىەأرًتثأوۏڽأزۏڬہتأۄەأڬۄأوۏڽأتۏڬأټۏهەأځشأۄًڽأتًشأوۏشەأتشزڲشزأتًىټأىذشأڬةەأدتأشۄەأۄۏڽأۗأوۏڽأىەأڬۄتأ=أتڲشأإځأڬتأرًتثأضډتأۄًتأحًأإځأڬەأتشزڲشزأڲہوضتىأڬۏأدىڲأۄًأڲۏأۗأتوأتهوًوىۏىأىەأڬۄتأ=أحوأىەأدًأحؼثۏشأثحتةۏأۄەأ؏أوۏڽأتضأڬەأطشأضەأتههۄأحؼتهۏٳأڬۏأځىتۄأوتىڲحۏأۄًڽأۗأوۏڽأىەأڬۄتأ=أۄًأضڬحتأۄەأڬۄأڬًةۏأتۏضتأًتمؼۄأشًىوتأۄًأدتةەأدًأإځأڬەأهةەأحڬهۏلأزۄأۄًأۗأإځأشعۏأتههۄأؼىۄتأىەألشوتۏتأ=أتههۄأڬۏأمضوأ$أوۏشۏأًدۄأضەأڬًةۏألحىۄأثشځتأۄًأ؏أتضأضەأودہەأۏۄأصۏتزۄأؼصۏصأۄەأڬۄأودہەأإضوتىأضەأصوۏىأځشأځہۏىڬأزۏتأدتةەأۗأڬډہأؼشظۄأثؼزأتوأتهوًوىۏىأڬەأۄتڽأتضأثتحأڬتأحسڬشۄأۄًتأڬۄأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەأ““أسًتهخزۏۆأ‛‛أڬًأمحهأڬشأزۏتأۄەأ؏أحًأإځأشعۏأتههۄأؼىۄتأىەأودہەأذڬوأزۏتأڬۄأدثأحوأڬًلۄأوۏڽأإاأحًأطۄشأڬەأدحىەأهًڲأتضأوؼتوهۄأوۏڽأطشۏڬأۄًةەأدىأڬًأحوأځۄډتىحەأۄًأ؏أتىأضثأڬەأثتشەأوۏڽأودہەأوغهؼأڬشىتأۗأدثأوۏڽأڬًلۄأوۏڽأإۏتأ؏أوۏڽأىەأهًڲًڽأڬًأدوتؼحأزشأدوتؼحأځتۏتأ؏أوۏڽأىەأتوأتهوًوىۏىأڬۏأدتىثأرغأهڬہتأڬۄأۄشأدوتؼحأوۏڽأزضأإزوۏأتضأوۏڽأطشۏڬأۄًةەأۄۏڽأۗأإځألشوتحەأۄۏڽأ=أوۏڽأتىأڬۏأڲًتۄۏأثہۏأتوأتهوًوىۏىأڬەأځتضأهتۏتأ؏أتوأتهوًوىۏىأشعۏأتههۄأؼىۄتأىەألشوتۏتأ=أتههۄأحؼتهۏٳأڬۏأهؼىحأۄًأؼوشًأثىأتهؼتظأځشأ؏أڬۏًىڬۄأًۄأوۏشەأثتشەأوۏڽأڲوتىأشڬہحتأۄەأڬۄأًۄأودہەأوظشأوۏڽأمحهأڬشەأڲتأۗ"
"6745","أۄطتوأثىأؼشًۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأوؼتًۏۄأثىأضلۏتىأشعۏأتههۄأؼىۄأىەأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬۏأدتىثأتۏڬأهتڬہأزشتۄوأثہۏدەأ؏أإځأىەأًۄأحوتوأڬەأحوتوأهًڲًڽأوۏڽأحمضۏوأڬشأزۏةەأتًشأتىأوۏڽأضەأتۏڬأزشۄوأثہۏأتځىەأهةەأىۄأشڬہتأ؏أذعشحأثشۏشۄأشعۏأتههۄأؼىۄتأىەأؼشعأڬۏأ=أإځأحًأشًصەأضەأۄۏڽأ؏أإځأۄوتشەأهةەأۄۏأتۏڬأزشۄوأڬتأڲًطحأرشۏزأهۏحۏأ؏أتوأتهوًوىۏىأشعۏأتههۄأؼىۄتأىەألشوتۏتأ=أۏۄأثتحأتڲشأودہەأۏتزأۄًحۏأحًأوۏڽأتۏضتأڬشأهۏحۏأۗأ"
"6746","أتوأتهوًوىۏىأذعشحأتوأضهوۄأشعۏأتههۄأؼىۄتأڬەأثتشەأوۏڽأوشًۏأۄەأڬۄأتىۄًڽأىەأذعشحأؼتةطۄأځشأڬًةۏأډۏرأضىۏأ؏أتىۄًڽأىەأتځىۏأهًىڋۏأضەأڬۄتأ=أدتاأتًشأزۏڬہأڬشأإاأڬۏتأۄًتأآأهًىڋۏأزۏڬہأڬشأإةۏأحًأثًهۏأ؏أدىڲأطشًؼأۄًأڲةۏأۗأذعشحأتوأضهوۄأشعۏأتههۄأؼىۄتأىەأڬۄتأ=أتضأستحأڬۏأمضوأ$أدضأڬەأمثعۄأمزشحأوۏڽأوۏشۏأدتىأۄەأ؏أشضًهأتههۄأ﷽أضثأضەأصۏتزۄأؼتةطۄأضەأځۏتشأڬشحەأحہەأ؏أضًتةەأتضأڬەأًتهزأڬەأ+أۏؼىۏأتىأڬەأًتهزأڬەأضتحہأتىأضەأثہۏأصۏتزۄأوذثحأڬشحەأحہەأ"
"6747","أضلۏتىأثىأؼۏۏىۄألشوتحەأۄۏڽأ=أذعشحأوؼتًۏۄأشعۏأتههۄأؼىۄأىەأځًډہتأ=أتەأصۏتزأ$أهًڲًڽأوۏڽأضثأضەأصۏتزۄأؼهوأًتهتأڬًىأۄەأآأصۏتزأىەأڬۄتأ=أتەأتوۏشتهوًوىۏىأ$أإځأۄۏأۄۏڽأۗأذعشحأوؼتًۏۄأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أوۏڽأحدہەأمضوأزەأڬشأځًډہحتأۄًڽأ؏أصۏتزأىەأڬۄتأ=أتڲشأمضوأڬەأضتحہأځًډہحەأۄًأحًأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأضثأضەأصۏتزۄأتۄهأؼهوأحہۏڽأۗأ"
"6748","أذعشحأؼغتؤألشوتحەأۄۏڽأ=أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأضثأضەأصۏتزۄألمۏۄأحہۏڽأ؏أضثأضەأصۏتزۄأؼهوأشڬہىەأًتهۏأحہۏڽأ؏أتًشأؼًتوأتهىتضأڬەأثتشەأوۏڽأثہۏأتډہۏأشتةەأشڬہحۏأحہۏڽأۗأ"
"6749","أوظؼثأثىأؼثۏزتههۄأصثۏشۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أذلظۄأثىحأؼوشأثىأرغتثأثىأىلۏهأثىأؼثزتهؼصۏٳأثىأشثتذأثىأؼثزتههۄأثىأمشغأثىأشصتذأثىأؼزۏأثىأڬؼثأثىأهاۏأثىأؽتهثأ‛‛أتىأڬۏأًتهزۄأ““أصۏىثأثىحأوػؼًىأثىأذثۏثأثىأًۄثأثىأذستلۄأثىأدوذأ‛‛أۄۏڽأۗأإځأوۄتدشتحأوۏڽأضەأۄۏڽأۗأ"
"6750","أصۄشۏأڬۄحەأۄۏڽأ=أځہشأىثۏأتڬشوأ﷽أىەأذعشحأذلظۄأثىأؼوشأثىحأرغتثأشعۏأتههۄأؼىۄتأضەأىڬتذأڬۏتأۗأذعًشأ﷽أضەأځۄهەأإځأرىۏضأثىأذستلۄأضۄوۏأڬەأىڬتذأوۏڽأحہۏڽأۗأ"
"6751","أذعشحأضؼۏزأثىأوضۏثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحأذلظۄأثىحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄتأڬتأطًۄشألًحأۄًأڲۏتأتًشأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬۏأصًدۄأذعشحأشمۏۄأثىحأشضًهأتههۄأ﷽ألًحأۄًأڲةۏڽأۗأذعشحأؼوشأشعۏأتههۄأؼىۄأ؏أذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬەأځتضأڲةەأتًشأتىأضەأڬۄتأ=أڬۏتأإځأڬًأذلظۄأوۏڽأڬًةۏأزهډضځۏأۄەأآأذعشحأؼخوتىأشعۏأتههۄأؼىۄأىەأودہأضەأتؼشتعأڬۏتأتًشأوۏشەأثتشەأوۏڽأڬًةۏأرتغشأرًتۄأدًتثأىۄأزۏتأ؏أذعشحأؼوشأشعۏأتههۄأؼىۄأشضًهأتههۄأ﷽أڬەأځتضأإةەأتًشأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬۏأطڬتۏحأڬۏأۗأىثۏأتڬشوأ﷽أىەأذعشحأؼوشأشعۏأتههۄأؼىۄأضەألشوتۏتأ=أتضأضەأثہۏأثۄحشأذهأوًدًزأۄەأۗأذلظۄأضەأوۏڽأىڬتذأڬشأهۏحتأۄًڽأتًشأؼخوتىأڬەأضتحہأوۏڽأتځىۏأثۏټۏأ““أتوأڬهخًوأ‛‛أڬتأىڬتذأڬشأزۏحتأۄًڽأۗأډىتىډۄأىثۏأتڬشوأ﷽أىەأذعشحأذلظۄأشعۏأتههۄأؼىۄتأضەأرًزأىڬتذألشوتۏتأتًشأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬەأۄوشتۄأتځىۏأظتذثصتزۏأتوأڬهخًوأشعۏأتههۄأؼىۄتأڬتأىڬتذأڬشأزۏتأۗأ"
"6752","%أذعشحأؼوشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أڬۏأثؼخحأضەأځتىډأضتهأځۄهەأدثأمشۏطأڬؼثۆأتههۄأڬۏأحؼوۏشأڬشأشۄەأحہەأتىأزىًڽأذلظۄأڬۏأځۏزتةطأۄًةۏأحہۏأۗ"
"6753","أذعشحأمۏضأثىأصۏزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأذعشحأذلظۄأثىحأؼوشأشعۏأتههۄأؼىۄتأڬًأ+أتۏڬأ"
"6754","أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأذعشحأذلظۄأشعۏأتههۄأؼىۄتأڬًأغهتمأزەأزۏأ؏أذعشحأدثشۏهأتوۏىأؼهۏۄأتهضهتوأإځأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًةەأتًشأڬۄتأ=أتەأوذوزأ﷽أ$أإځأىەأذلظۄأشعۏأتههۄأؼىۄتأڬًأغهتمأزەأزۏأۄەأذتهتىڬۄأًۄأحًأىوتصأًأشًصۄأڬۏأځتثىزأۄەأ؏أتًشأًۄأدىحأوۏڽأثہۏأإځأڬۏأصًدۄأۄەأۗأتضأهةەأإځأتىأضەأشدًؼألشوتأهۏدةەأۗأ"
"6755","أذعشحأضلۏتىأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتوأضهوۄأشعۏأتههۄأؼىۄتأؼًشحًڽأوۏڽأضثأضەأځۄهەأۄدشحأڬشىەأًتهۏأرتحًىأۄۏڽأۗأ"
"6756","أتثىأطۄتثأڬۄحەأۄۏڽأ=أًۄأهًڲأدًأذثطۄأڬۏأدتىثأځۄهۏأۄدشحأڬەأثؼزأشضًهأتههۄأ﷽أڬەأځتضأوڬۄأوۏڽأإةەأحہەأتًشأځہشأوزۏىۄأوىًشۄأڬۏأدتىثأثہۏأۄدشحأڬۏأحہۏأ؏أتىأوۏڽأ““أتثًضهوۄأؼثزتههۄأثىأؼثزتهتضزأ‛‛أتًشأتىأڬۏأصًدۄأ““أتوأضهوۄأثىحأتثۏأتوۏۄأ‛‛أۄۏڽأۗأ"
"6757","أوظؼثأثىأؼثزتههۄأصثۏشۏألشوتحەأۄۏڽأ=أذعشحأتوأضهوۄأشعۏأتههۄأؼىۄتأڬتأتظهأىتوأ““أشوهۄأ‛‛أۄەأ؏أإځأځۄهۏأوۄتدشۄأۄۏڽأدًأۄدشحأڬشأڬەأوزۏىۄأوىًشۄأإةۏڽأۗأإځأشضًهأتههۄأ﷽أضەأځۄهەأ““أتثًضهوۄأؼثزتههۄأثىأؼثزتهتضزأثىأۄهتهأثىأؼثزتههۄأثىأؼوشأثىأورصًوأ‛‛أڬەأىڬتذأوۏڽأحہۏڽأۗأتثًضهوۄأذثطۄأڬۏأدتىثأضثأضەأځۄهەأۄدشحأڬشىەأًتهۏأطرظۏحأۄۏڽأتًشأإځأىەأؽصًۄأثزشأوۏڽأثہۏأطشڬحأڬۏأۗأشضًهأتههۄأ﷽أڬەأزًشأوۏڽأۄۏأتىأڬتأتىحمتهأۄًأڲۏتأحہتأۗأتوأضهوۄأڬەأثغىأضەأتثًضهوۄأڬەأډتشأثډەأضهوۄأ؏أؼوشأ؏أزشۄأتًشأصۏىثأځۏزتأۄًةەأۗأتىأڬۏأًتهزۄأتوأضهوۄأۄۏڽأدىۄًڽأىەأثؼزأوۏڽأشضًهأتههۄأ﷽أضەأىڬتذأڬۏتأۗأتوأضهوۄأڬەأثۏټەأؼوشأثىأتثۏأضهوۄأىەأشضًهأتههۄأ﷽أڬۏأوحؼززأتذتزۏخأشًتۏحأڬۏأۄۏڽأۗأ"
"6758","أتوأضهوۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أىەألشوتۏتأ=أدثأحوأوۏحأۏتأوشۏعأڬەأځتضأدتاأحًأتضأڬەأثتشەأوۏڽأۄوۏطۄأتډہۏأثتحأڬۄًأ؏أڬۏًىڬۄأحوأدًأڬډہأڬۄحەأۄًأ؏ألشطحەأتضأځشأإوۏىأڬۄحەأۄۏڽأۗأدثأذعشحأتثًضهوۄأشعۏأتههۄأؼىۄأڬتأتىحمتهأۄًتأحًأوۏڽأىثۏأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًةۏأتًشأوۏڽأىەأځًډہتأ=أتضأوًمؼأځشأوۏڽأڬۏتأزؼتأوتىڲًڽأآأذعًشأ﷽أىەألشوتۏتأ=أۏۄأزؼتأوتىڲًأ““أتەأتههۄأ$أۄوتشۏأتًشأتضأ+أتثًضهوۄأ"
"6759","%أتوأضهوۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدثأحوۄۏڽأڬًةۏأوظۏثحأإةەأحًأۏًڽأزؼتأوتىڲًأ=““أۄوأتههۄأۄۏأڬەأهةەأۄۏڽأتًشأتضۏأڬۏأدتىثأۄوۏڽأهًټأڬشأدتىتأۄەأ؏أتەأتههۄأوۏڽأتځىۏأوظۏثحأڬتأوؼتوهۄأحۏشۏأثتشڲتۄأوۏڽأځۏطأڬشحتأۄًڽأحًأودہەأتضأوۏڽأتدشأؼغتألشوتأۗ‛‛"
"6760","أؼثزتهوهڬأثىأتثۏأثڬشأثىأؼثزتهشذوىأثىأذتشخأثىأۄطتوأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأدثأشضًهأتههۄأ﷽أىەأذعشحأتوأضهوۄأثىحأتثۏأتوۏۄأشعۏأتههۄأؼىۄتأضەأىڬتذأڬۏتأ؏أحًأتىۄًڽأىەأتځىتأڬځڔتأتځىەأتًځشأهۏتأدًأڬۄأتىأڬًأتىأڬەأذدشەأضەأىڬهىەأضەأوتىؼأحہتأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أتڲشأحوأډتۄًأحًأوۏڽأحوۄتشۏأثتشۏأوۏڽأتعتلۄأڬشأزۏحتأۄًڽأ؏أ+أًۏضەأوۏشتأغشۏمۄأۏۄأۄەأڬۄأڬىًتشۏًڽأڬًأ+أتۏڬأۄلحەأوۏڽأ"
"6761","%أوذوزأثىأؼوشأثۏتىأڬشحەأۄۏڽأ=أتوأضهوۄأشعۏأتههۄأؼىۄتأڬتأىتوأ““أۄىزأثىحأتثۏأتوۏۄأ‛‛أۄەأۗأتًشأتثًتوۏۄأڬتأىتوأ““أضۄۏهأثىأوؽۏشۄأثىأؼثزتههۄأثىأؼوشأثىأورصًوأ‛‛أۄەأۗأتىأڬۏأًتهزۄأ““أؼتحڬۄأثىحأؼتوشأثىأشثۏؼۄأثىأوتهڬأثىأرصۏوۄأثىأؼهموۄأثىألشتضأثىأؽىوأثىأوتهڬأثىأڬىتىۄأ‛‛أۄۏڽأۗأځۄهەأتثًضهوۄأؼثزتههۄأثىأؼثزتهتضزأثىأۄهتهأىەأتىأضەأىڬتذأڬۏتأحہتأۗأتًشأتىأڬًأضتحہأهەأڬشأذثطۄأڬۏأزًىًڽأۄدشحًڽأوۏڽأۄدشحأڬۏأ؏أًۄتڽأځشأتثًضهوۄأڬەأۄتڽأصۏىثأځۏزتأۄًةۏأ؏أتًشأتضأڬەأثؼزأتوأضهوۄأڬەأۄتڽأتثًضهوۄأڬەأحۏىأثۏټەأضهوۄأ؏أؼوشأتًشأزشۄأځۏزتأۄًةەأۗ"
"6762","أصۄشۏأڬۄحەأۄۏڽأ=أۄىزأثىحأذتشخألشتضۏۄألشوتحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەألشوتۏتأ=أؼتةطۄأڬتأوۏشەأزهأوۏڽأتۏڬأومتوأۄەأ؏أتضأضەأإڲەأڬًةۏأىۄۏڽأثڔہأضڬتأۗأدثأشضًهأتههۄأ﷽أىەأذعشحأتوأضهوۄأشعۏأتههۄأؼىۄتأڬەأضتحہأىڬتذأڬۏتأحًأڬضۏأىەأشضًهأتههۄأ﷽أڬۏأرزوحأوۏڽأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أضۏزۄأؼتةطۄأًتهەأومتوأڬتأڬۏتأثىتأآأشضًهأتههۄأ﷽أىەأتضأڬتأڬًةۏأدًتثأىۄأزۏتأۗأتضأضەأوؼهًوأۄًتأڬۄأتضأومتوأځشأذعشحأتوأضهوۄأشعۏأتههۄأؼىۄتألتةصأۄًأډڬۏأحہۏڽأۗأ"
"6763","أتثًؼثۏزۄأوؼوشأثىأوخىۏألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأۄدشحأڬەأزًضشەأضتهأدىڲأثزشأضەأځۄهەأذعشحأتوأضهوۄأشعۏأتههۄأؼىۄتأڬەأضتحہأىڬتذأڬۏتأۗأتوأضهوۄأشعۏأتههۄأؼىۄتأڬتأتظهأىتوأ““أۄىزأثىحأتثۏأتوۏۄأثىأوؽۏشۄأثىأؼثزتههۄأثىأؼوشأثىأورصًوأ‛‛أۄەأۗأىثۏأتڬشوأ﷽أڬۏأتصًتدأوغۄشتحأوۏڽأضثأضەأځۄهەأذعشحأصۏىثأشعۏأتههۄأؼىۄتأڬتأتىحمتهأۄًأتًشأضثأضەأإرشأوۏڽأذعشحأتوأضهوۄأشعۏأتههۄأؼىۄتأڬتأًظتهأوثتشڬأۄًتأۗأ"
"6764","أضهوۏٳألشوتحۏأۄۏڽأ=أوۏڽأتوأتهوًوىۏىأذعشحأتوأضهوۄأشعۏأتههۄأؼىۄتأڬەأځتضأڲةۏأ؏أإځأصتشأًأمغتشأشًأشۄۏأحہۏڽأ؏أوۏڽأىەأشًىەأڬۏأًدۄأځًډہۏأحًألشوتۏتأ=أوۏڽأىەأشضًهأتههۄأ﷽أڬًأرًتثأوۏڽأزۏڬہتأۄەأ؏أإځأڬتأډۄشۄأتىًشأتًشأزتڔہۏأوثتشڬأؽثتشأإهًزأۄەأتًشأإځأشًأشۄەأۄۏڽأ؏أوۏڽأىەأځًډہتأ=أۏتأشضًهأتههۄأ﷽أإځأڬۏًڽأشًأشۄەأۄۏڽأآأإځأ﷽أىەألشوتۏتأ=أتثہۏأتثہۏأوۏشەأىًتضەأذضۏىأڬًأطۄۏزأڬشأزۏتأڲۏتأۄەأۗأ"
"6765","أطۄشأثىأذًطثأڬۄحەأۄۏڽأ=أذعشحأذضۏىأثىأؼهۏأشعۏأتههۄأؼىۄوتأڬۏأطۄتزحأځشأوۏڽأذعشحأتوأضهوۄأشعۏأتههۄأؼىۄتأڬەأځتضأحؼصۏحأڬشىەأڲۏتأۗأ"
"6766","أتوأتهوًوىۏىأذعشحأتوأضهوۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أدثأًۄأوزۏىۄأوىًشۄأإةۏڽأ؏أحًأتىۄًڽأىەأهًڲًڽأڬًأثحتۏتأڬۄأًۄأتثۏأتوۏۄأثىأوؽۏشۄأڬۏأثۏټۏأۄۏڽأ؏أحًأهًڲًڽأىەأتىأڬۏأثتحأڬًأحضهۏوأىۄأڬۏتأتًشأتضأثتحأڬًأضشتضشأدہًټأضودہەأ؏أذحۏٳأڬۄأذدأڬەأهةەأمتلهەأدتىتأطشًؼأۄًأڲةەأ؏أهًڲًڽأىەأتىأضەأڬۄتأ=أحوأتځىەأڲہشأًتهًڽأڬۏأغشلأرغأهڬہًأ؏أتىۄًڽأىەأرغأهڬہأڬشأتىأهًڲًڽأڬەأذًتهەأڬشأزۏتأ؏أدثأذتدۏًڽأڬەأمتلهەأًتځضأإةەأحًأتىۄًڽأىەأتىأڬۏأحظزۏمأڬۏأ؏أذتدۏًڽأڬۏأتضأحظزۏمأڬەأثؼزأتىأهًڲًڽأڬەأزهًڽأوۏڽأتىأڬۏأؼصحأثۄحأثڔہأڲةۏأۗأذعشحأتوأضهوۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أصۏىثأڬۏأځۏزتةطأڬەأثؼزأوۏشۏأطتزۏأشضًهأتههۄأ﷽أضەأۄًةۏأۗأ"
"6767","أضؼۏزأثىأصۏزأڬەأتۏڬأظتذثصتزەأشًتۏحأڬشحەأۄۏڽأڬۄأتوأتهوًوىۏىأذعشحأتوأضهوۄأشعۏأتههۄأؼىۄتأىەأًظۏحأڬۏأڬۄأتىأڬۏأىوتصأدىتصۄأضؼۏزأثىأصۏزأځڔہتةەأ؏أتضأڬۏأًدۄأۏۄأحہۏأڬۄأتىأڬًأرزطۄأحہتأڬۄأتىأڬتأدىتصۄأڬۄۏڽأوشًتىأثىأذڬوأىۄأځڔہتأزەأۗأ"
"6768","%أصۄشۏأڬۄحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتوأذثۏثۄأثىحأتثۏأضلۏتىأڬەأضتحہأىڬتذأڬۏتأۗأشضًهأتههۄأ﷽أڬەأؼمزأوۏڽأإىەأضەأځۄهەأذعشحأتوأذثۏثۄأشعۏأتههۄأؼىۄتأ؏أرصۏوۄأڬەأطۏشأؼثۏزتههۄأثىأدذطأتهتضزۏأڬەأىڬتذأوۏڽأحہۏڽأۗأؼثۏزتههۄأثىأدذطأذثطۄأوۏڽأوشأڲۏتأحہتأ؏أتوأذثۏثۄأتضأڬەأۄوشتۄأۄدشحأځشأشًتىۄأۄًةۏأحہۏڽأ؏أًۄتڽأدتأڬشأۏۄألحىۄأوۏڽأوثحهتأۄًأڲۏتأتًشأتضأىەأؼۏضتةۏأوسۄثأترحۏتشأڬشأهۏتأتًشأتضۏأذتهحأوۏڽأًۄأوشأڲۏتأ؏أهۏڬىأتههۄأحؼتهۏٳأىەأذعشحأتوأذثۏثۄأشعۏأتههۄأؼىۄتأڬًأتضهتوأتًشأۄدشحأځشأتضحمتوحأؼغتألشوتةۏأ؏أتوأذثۏثۄأشعۏأتههۄأؼىۄتأىەأؼۏضتةۏأوسۄثأترحۏتشأڬشىەأضەأتىڬتشأڬشأزۏتأحہتأۗأتههۄأحؼتهۏٳأىەأتىأڬەأتضهتوأتًشأۄدشحأڬًأوڬوهألشوتۏتأ؏أځہشأۏۄأوزۏىۄأوىًشۄأإأڲةۏڽأ؏أشضًهأتههۄأ﷽أىەأتىأڬًأځۏؽتوأىڬتذأثہۏدتأ+أتىۄًڽأىەأمثًهأڬشأهۏتأ"
"6769","أوظؼثأثىأؼثزتههۄأصثۏشۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أتوأذثۏثۄأثىحأتثۏأضلۏتىأثىأذشثأ‛‛أتىأڬتأتظهأىتوأ““أشوهۄأثىحأتثۏأضلۏتىأ‛‛أۄەأۗأثؼعأواشرۏىأڬتأڬۄىتأۄەأڬۄأتىأڬتأىتوأ““أۄىزأ‛‛أۄەأۗأدثڬۄأوطۄًشأ““أشوهۄأ‛‛أۄەأۗأتىأڬۏأًتهزۄأ““أظلۏۄأثىحأتثۏأتهؼتظأثىأتوۏۄأ‛‛أۄۏڽأۗأثؼعأزۏڲشأواشرۏىأڬەأوغتثمأتىأڬۏأًتهزۄأ““أإوىۄأثىحأؼثزتهؼصۏٳأثىأذشثتىأثىأؼًلأثىأؼثۏزأثىأًۏدأثىأؼزۏأثىأڬؼثأ‛‛أۄۏڽأۗأذعشحأوؼتًۏۄأضەأتۏڬأضتهأځۄهەأتىأڬتأتىحمتهأۄًتأۗأ"
"6770","%أوذوزأثىأؼوشأڬۄحەأۄۏڽأ=أتوأذثۏثۄأڬتأىتوأ““أشوهۄأثىحأتثۏأضلۏتىأثىأذشثأ‛‛أۄەأۗأتىأڬۏأًتهزۄأ““أظلۏۄأثىحأتثۏأتهؼتظأثىأتوۏۄأثىأؼثزطوضأ‛‛أۄەأۗأذعشحأؼخوتىأثىأؼلتىأشعۏأتههۄأؼىۄأڬۏأځہًځہۏأۄۏڽأ؏أځۄهەأذشثأثىأتوۏۄأڬەأذهۏلأؼثۏزتههۄأثىأدذطأثىأشثتثأڬەأىڬتذأوۏڽأحہۏڽأۗأتىأڬەأثغىأضەأذثۏثۄأځۏزتأۄًةۏڽأ؏أتضۏأڬەأىتوأضەأتىأڬۏأڬىۏحأ““أتوأذثۏثۄأ‛‛أۄًةۏأۗأذثۏثۄأڬەأضتحہأزتًزأثىأؼشًۄأثىأوضؼًزأخملۏأىەأطتزۏأڬۏأحہۏأۗ"
"6771","أذعشحأدؼلشأثىأوذوزأثىأؼهۏأ؏أتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأؼوشًأثىأتوۏۄأعوشۏأڬًأىدتطۏأڬەأځتضأتوأذثۏثۄأثىحأتثًضلۏتىأڬەأهةەأځۏؽتوأىڬتذأزەأڬشأثہۏدتأۗأتوأذثۏثۄأشعۏأتههۄأؼىۄتأځۄهەأؼثۏزتههۄأثىأدذطأڬەأىڬتذأوۏڽأحہۏڽأ؏أىدتطۏأىەأتىأڬتأىڬتذأشضًهأتههۄأ﷽أڬەأۄوشتۄأڬشأزۏتأ؏أتًشأتځىۏأغشلأضەأډتشأضًأزۏىتشأشضًهأتههۄأ﷽أڬتأذمأوۄشأتزتأڬۏتأۗأتثًدؼلشأڬۄحەأۄۏڽأ=أؼثزتهوهڬأثىأوشًتىأىەأتضۏأًدۄأضەأؼًشحًڽأڬتأذمأوۄشأډتشأضًأزۏىتشأومششأڬۏتأحہتأۗأ"
"6772","أتثًضهوۄأثىأؼثزتهشذوىأڬەأثتشەأوۏڽأوشًۏأۄەأڬۄأتىۄًڽأىەأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأضەأځًډہتأ=أشضًهأتههۄأ﷽أىەأتځىۏأتصًتدأوغۄشتحأڬتأذمأوۄشأڬحىتأشڬہتأحہتأآأتىۄًڽأىەألشوتۏتأ=أ45أضتڔہەأثتشۄأتًمۏۄأ؏أتضأڬۏأومزتشأ833أزشتۄوأثىحۏأۄەأۗأ"
"6773","%أصۄشۏأڬۄحەأۄۏڽأ=أىدتطۏأىەأتوأذثۏثۄأشعۏأتههۄأؼىۄتأڬًأشضًهأتههۄأ﷽أڬۏأغشلأثہۏدىەأڬەأهةەأحۏتشأڬشًتۏتأتًشأتىأڬەأۄوشتۄأطشذثۏهأثىأذضىۄأڬًأشًتىۄألشوتۏتأۗ"
"6774","%أوظؼثأثىأؼثۏزتههۄأصۄۏشۏأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أصۏىثأثىحأدذطأثىأشثتثأثىأۏؼوشأثىأظثشۄأثىأوشۄأثىأڬخۏشأثىأؽىوأثىأزًزتىأثىأتضزأثىأرصۏوۄأ‛‛ۗأتىأڬۏأًتهزۄأڬتأىتوأ““أتوۏوۄأثىحأؼثزتهوغهثأثىأۄتطوأثىأؼوشًأثىأؼثزأوىتلأ‛‛ۗأځۄهەأذعشحأصۏىثأشعۏأتههۄأؼىۄتأ؏أذعشحأصۏزأثىأذتشخۄأشعۏأتههۄأؼىۄأڬەأىڬتذأوۏڽأحہۏڽأ؏أتىۄًڽأىەأتىأڬەأغهتمأزۏىەأ+أتًشأؼزحأڲصشىەأڬەأثؼزأ"
"6775","%أوذوزأثىأؼوشألشوتحەأۄۏڽأ=أصۏىثأثىحأدذطأشعۏأتههۄأؼىۄتأ؏أذعشحأؼثزتهشذوىأثىأدذطأشعۏأتههۄأؼىۄأڬۏأثۄىأحہۏڽأۗ"
"6776","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتځىۏأتصًتدأضەأڬۄتأ=أحوأضثأضەأځۄهەأوۏشەأځتضأًۄأإةەأڲۏأدضأڬەأۄتحہأضثأضەأصۏتزۄأهوثەأۄۏڽأۗأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أڬەأتىحمتهأڬەأثؼزأتۏڬأزلؼۄأۄوأتۏڬأڲہشأوۏڽأتڬټہۏأۄًةۏڽأتًشأتۏڬأزۏًتشأڬەأضتحہأتځىەأۄتحہأىتځىەأهڲۏڽأ؏أۄوأۏًىۄۏأتځىەأۄتحہأىتځتأڬشحۏأحہۏڽأڬۄأذعشحأصۏىثأثىحأدذطأشعۏأتههۄأؼىۄتأڬتأتىحمتهأۄًأڲۏتأ؏أتىأڬتأمزأضثأضەأډہًټتأحہتأ؏أۏۄأۄوأوۏڽأضەأڬضۏأضەأثہۏأهوثۏأىۄۏڽأحہۏڽأۗأحثأۄوأضودہۏڽأڬۄأۄتحہأهوثەأۄًىەأضەأشضًهأتههۄأ﷽أڬۏأوشتزأ““أظزمۄأًأرۏشتحأڬشىتأ‛‛أحہۏأ؏أشتًۏأڬۄحەأۄۏڽأ=أذعشحأصۏىثأڬًأزضحڬتشۏأڬەأثۄحأڬتوأإحەأحہەأ؏أإځأډوڔەأڬًأزثتؽحأزۏحۏأحہۏڽأ؏أځًزەأهڲتحۏأحہۏڽأتًشأدًأشموأإحۏأ؏أتضأڬًأتههۄأحؼتهۏٳأڬەأشتضحەأوۏڽأرشډأڬشأزۏتأڬشحۏأحہۏڽأۗ"
"6777","أذعشحأؼتوشألشوتحەأۄۏڽأ=أذعشحأثىحأدذطأشعۏأتههۄأؼىۄتأشضًهأتههۄأ﷽أضەأڬۄتأڬشحۏأحہۏأ=أإځأڬۏأحوتوأثۏًۏًڽأضەأوۏشتأذمأضثأضەأصۏتزۄأۄەأ؏أڬۏًىڬۄأومتوأىڬتذأڬەأهذتػأضەأوۏڽأضثأضەأثۄحشأۄًڽأ؏أوۏڽأضثأضەأصۏتزۄأځشزەأڬتأتۄحوتوأڬشحۏأۄًڽأ؏أتًشأإځأڬۏأضثأضەأصۏتزۄأمشۏثۏأشطحۄأزتشأۄًڽأۗأځہشأإځألشوتحۏأ=أتههۄأحؼتهۏٳأىەأؼشطأڬەأتًځشأوۏشتأىڬتذأځڔہتۏتأ؏أتضأډۏصأڬتأضلۏشأذعشحأدثشۏهأتوۏىأؼهۏۄأتهضهتوأۄۏڽأۗأوۏڽأإځأڬۏأځہًځہۏأڬۏأثۏټۏأۄًڽأۗأتًشأإځأڬۏأثۏًۏًڽأوۏڽأضەأوۏشەأؼهتًۄأتًشأڬًةۏأثہۏأإځأڬتأتحىتأمشۏثۏأشطحۄأزتشأڬًةۏأىۄۏڽأۄەأۗأ+أتوتوأذتڬوأڬۄحەأۄۏڽأ"
"6778","أودتۄزأڬۄحەأۄۏڽأ=أذعشحأدًۏشۏۄأثىحأتهذتشخأىەأشضًهأتههۄأ﷽أضەأؼشعأڬۏأ=أإځأڬۏأتصًتدأودہەأۏۄأثتحأثۄحألرشۏۄأثۏتىأڬشحۏأۄۏڽأتًشأڬۄحۏأۄۏڽأ=أشضًهأتههۄأ﷽أىەأحوأضەأىڬتذأىۄۏڽأڬۏتأ؏أحوأحًأتىأڬۏأ““أڬىۏصأ‛‛أۄًأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أڬۏتأوۏڽأىەأحوۄتشتأذمأوۄشأضثأضەأؼػۏوأىۄۏڽأڬشأزۏتأحہتأآأڬۏتأوۏڽأىەأحوۄتشۏأمًوأڬەأډتهۏضأتلشتزأڬًأإصتزأىۄۏڽأڬۏتأآأ"
"6779","أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أدثأشضًهأتههۄأ﷽أڬەأځتضأثىۏأوظغهمأڬۏأهًىڋۏتڽأوتهأؽۏوحأڬەأغًشأځشأإةۏڽأ؏أحًأدًۏشۏۄأثىحأذتشخأثىأتثۏأعشتشأشعۏأتههۄأؼىۄتأذعشحأختثحأثىأمۏضأثىأطوتضأشعۏأتههۄأؼىۄأڬەأذظۄأوۏڽأإةۏڽأ؏أتىۄًڽأىەأتځىەأإځأڬًأتىأضەأوڬتحثأثىًتأهۏتأ؏أإځأثۄحأذضۏىأًأدوۏهأحہۏڽأ؏أدًأثہۏأتىأڬًأتۏڬأىػشأزۏڬہأهۏحتأًۄأزهأحہتوأڬشأثۏټہأدتحتأحہتأ؏أإځأتځىۏأڬحتثحأڬەأضهضهەأوۏڽأوززأهۏىەأڬەأهةەأشضًهأتههۄأ﷽أڬۏأرزوحأوۏڽأإةۏڽأۗأ"
"6780","أوذوزأثىأؼوشأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أدًۏشۏۄأثىحأذتشخأثىأتثۏأعشتشأثىأذثۏثأثىأؼتةسأثىأوتهڬأثىأدسۏوۄأثىأوظغهمأ‛‛أتىأڬتأحؼهمأرصتؼۄأڬەأضتحہأحہتأ؏أوضتلؼأثىأظلًتىأڬەأىڬتذأوۏڽأحہۏڽأ؏أدىڲأوشۏضۏؼأوۏڽأًۄأوتشتأڲۏتأحہتأۗأ"
"6781","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أڬەأځتضأثىۏأوظغهمأڬۏأهًىڋۏتڽأإةۏڽأ؏أإځأ﷽أىەأتضأوۏڽأضەأځتىډًتڽأذظۄأىڬتهتأ؏أثتمۏأهًڲًڽأوۏڽأحمضۏوأڬشأزۏتأ؏أتضأحمضۏوأوۏڽأغشۏمۄأۏۄأحہتأڬۄأڲہڔأضًتشأڬًأزًأذظەأتًشأځۏزهأڬًأتۏڬأذظۄأؼغتألشوتۏتأۗأدًۏشۏۄأثىحأذتشخأثىأتثۏأعشتشأ؏أذعشحأختثحأثىأمۏضأثىأطوتضأتىظتشۏأشعۏأتههۄأؼىۄأڬەأذظۄأوۏڽأإةۏڽأۗأۏۄأتځىەأډډتأڬەأثۏټەأظلًتىأثىأوتهڬأثىأدسۏوۄأڬەأىڬتذأوۏڽأحہۏڽأ؏أًۄأمحهأۄًأڲۏتأحہتأ؏أذعشحأختثحأثىأمۏضأىەأتىأڬًأوڬتحثأثىتأهۏتأحہتأتًشأثزهأڬحتثحأ<أتًمۏۄأډتىزۏأشڬہۏأۗأۏۄأثۄحأرًثظًشحأتًشأذضۏىأًأدوۏهأؼًشحأحہۏأ؏أدًأثہۏأتىأڬًأتۏڬأىػشأزۏڬہأهۏحتأًۄأزهأحہتوأهۏحتأۗأتۏڬأزلؼۄأڬتأسڬشأۄەأڬۄأشضًهأتههۄأ﷽أوۏشەأځتضأوًدًزأحہەأڬۄأتضۏأتخىتؤأوۏڽأدًۏشۏۄأشضًهأتههۄأ﷽أڬۏأرزوحأوۏڽأتځىەأثزهأڬحتثحأتزتأڬشًتىەأڬەأضهضهەأوۏڽأوززأهۏىەأإةۏڽأۗأتوأتهوًوىۏىألشوتحۏأۄۏڽأ=أتههۄأڬۏأمضوأ$أوۏڽأىەأتضأڬًأدۏضەأۄۏأشضًهأتههۄأ﷽أڬەأځتضأإحەأزۏڬہتأودہەأثۄحأىتڲًتشأڲصشتأ؏أتًشأودہأڬًأځڬتأۏمۏىأحہتأڬۄأدًأذضىأًأدوتهأتضأرتحًىأوۏڽأ؏أوۏڽأىەأزۏڬہتأۄەأ؏أۏۄأشضًهأتههۄأ﷽أثہۏأتضأوۏڽأزۏڬہأهۏڽأڲەأۗأدًۏشۏۄأڬۄىەأهڲۏأ=أۏتأشضًهأتههۄأ﷽أوۏڽأتځىۏأمًوأڬەأضشزتشأذتشخأڬۏأثۏټۏأدًۏشۏۄأۄًڽأۗأۏتأشضًهأتههۄأ﷽أدۏضتأڬۄأإځأدتىحەأۄۏڽأ؏أوۏڽأإصوتةطأوۏڽأۄًڽأ؏أوۏڽأختثحأثىأمۏضأڬەأذظۄأوۏڽأإةۏأۄًڽأتًشأتضأىەأودہەأ<أتًمۏۄأډتىزۏأځشأوڬتحثأثىتأزۏتأۄەأ؏أإځأ﷽أىەألشوتۏتأ=أوۏڽأحوۄۏڽأتضأضەأثہۏأتډہۏأثتحأىۄأثحتاڽأآأتضأىەأڬۄتأ؏أًۄأڬۏتأثتحأۄەأآأشضًهأتههۄأ﷽أىەألشوتۏتأ=أحوۄتشتأثزهأڬحتثحأوۏڽأتزتأڬشأزۏحتأۄًڽأتًشأحدہأضەأىڬتذأڬشأهۏحتأۄًڽأ؏أتضأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أودہەأوىػًشأۄەأۗأذعًشأ﷽أىەألشوتۏتأ=أوۏڽأىەأتۏضتأڬشأزۏتأۗأۏۄأثتحأهًڲًڽأوۏڽأځہۏهأڲةۏأ؏أهًڲأڬۄىەأهڲەأ؏أشضًهأتههۄأ﷽أڬەأشطحۄأزتشأمۏزأۄًأڲةەأۄۏڽأ؏أتضأهةەأدضأدضأڬەأځتضأڬًةۏأثىۏأوظغهمأڬتأمۏزۏأۄەأًۄأتضەأإصتزأڬشأزەأ؏أشضًهأتههۄأ﷽أڬەأدًۏشۏۄأڬەأضتحہأىڬتذأڬشأهۏىەأڬۏأثشڬحأضەأثىۏأوظغهمأڬەأضًأڬەأمشۏثأمۏزۏأإصتزأۄًأڲةەأ؏أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أوۏڽأىەأدًۏشۏۄأضەأثڔہأڬشأتۏضۏأڬًةۏأرتحًىأىۄۏڽأزۏڬہۏأ؏أدًأتځىۏأمًوأڬەأهةەأتضأمزشأثتؼخأثشڬحأۄًأ؏أۏۄأًتمؼۄأدىڲأوشۏضۏؼأضەأًتځضأإىەأڬەأثؼزأڬتأۄەأۗ"
"6782","أتثىأتضذتمأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أدًۏشۏۄأثىحأذتشخأ‛‛أتىأڬتأتظهأىتوأ““أثشۄأثىحأذتشخأثىأتثۏأعشتشأثىأذثۏثأثىأؼتةسأثىأوتهڬأثىأدسۏوۄأ‛‛أۄۏڽأتىأڬتأحؼهمأرصتؼۄأڬەأضتحہأۄەأۗأإځأځۄهەأتځىەأډډتأڬەأثۏټەأوضتلؼأثىأظلًتىأثىأسۏأتهطلشأڬەأىڬتذأوۏڽأحہۏڽأۗأ"
"6783","أتوأتهوًوىۏىأذعشحأدًۏشۏۄأثىحأذتشخأثۏتىأڬشحۏأۄۏڽأڬۄأتىأڬتأتظهأىتوأ““أثشۄأ‛‛أحہتأشضًهأتههۄأ﷽أىەأثزهأڬشأوۏشتأىتوأدًۏشۏۄأشڬہأزۏتأۗأڬۏًىڬۄأإځأڬًأۏۄأتډہتأىۄۏڽأهڲحتأحہتأڬۄأڬًةۏأڬۄەأ““أوۏشەأځتضأضەأثشۄأډهۏأڲةۏأۄەأۗأ"
"6784","%أذعشحأؼوشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأذعشحأدًۏشۏۄأشعۏأتههۄأؼىۄتأڬًأځشزۄأڬشًتۏتأتًشأىثۏأتڬشوأ﷽أدۏضەأزۏڲشأتوۄتحأتهوًوىۏىأشعۏأتههۄأؼىۄتأڬەأهةەأثتشۏأومششأڬشحەأحہەأتضۏأغشذأذعشحأدًۏشۏۄأڬەأهةەأثہۏأڬشحەأحہەأۗ"
"6785","أتوأتهوًوىۏىأذعشحأدًۏشۏۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أتىأڬەأځتضأحطشۏلأهتةەأ؏أتًشألشوتۏتأ=أڬًةۏأڬہتىەأځۏىەأڬۏأډۏصأۄەأآأتىۄًڽأىەأؼشعأڬۏأ=أتههۄأڬۏأمضوأ$أۏتأشضًهأتههۄأ﷽أۄوتشەأځتضأڬہتىەأځۏىەأڬۏأڬًةۏأډۏصأىۄۏڽأۄەأ؏أظشلأثڬشۏأڬۏأتۏڬأۄڋۏأحہۏأ؏أًۄأثہۏأظزمۄأڬۏأحہۏأ؏أتضأهةەأوۏڽأىەأًۄأتځىۏأرتزوۄأڬًأزەأزۏأۄەأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أحوأًۄۏأهەأإاأ؏أڬۏًىڬۄأظزمۄأتځىەأومتوأحڬأځۄىډأډڬتأۄەأۗأ"
"6786","أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأىثۏأتڬشوأ﷽أىەأرۏثشألحذأڬۏتأحًأذعشحأظلۏۄأثىحأذۏۏأشعۏأتههۄأؼىۄتأڬًأتځىەأهةەأوىحرثألشوتۏتأ=أذعًشأ﷽أىەأتىأڬًأتځىەأځۏډہەأثټہتۏتأتًشأضلشأطشًؼأڬشأزۏتأۗأذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأزۏڬہتأ؏أذعًشأ﷽أىەأتځىەأځتاڽأڬەأضۄتشەأضەأتىأڬًأضًتشۏأځشأضًتشأڬشتۏتأ؏أدثأومتوأ““أضزتهظثۄتؤأ‛‛أځشأځۄىډەأحًأتىأڬەأضتحہأضهضهۄأتصزًتدأمتةوألشوتۏتأ؏أإځأىەأتۏڬأحہتهأوۏڽأ““أذۏضأ‛‛أ+أتۏڬأىًؼۏحأڬتأڬہتىتأۄەأدًأتۄهأؼشثأڬەأۄتڽأوشًدأحہتأ"
"6787","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأشضًهأتههۄأ﷽أىەأذعشحأظلۏۄأشعۏأتههۄأؼىۄتأڬەأضتحہأطثأصلتلأڲصتشۏأحًأىثۏأتڬشوأ﷽أڬەأزشًتصەأځشأذعشحأتثًتۏًثأتىظتشۏأشعۏأتههۄأؼىۄأحہەأ؏أدثأظثذأۄًةۏأ؏أتًشأتىۄًڽأىەأشضًهأتههۄأ﷽أڬًأزۏڬہتأحًأتههۄأتڬثشأڬۄتأ=أتضأًمحأذعشحأتثًتۏًثأشعۏأتههۄأؼىۄأڬەأځتضأتۏڬأحهًتشأحہۏأ؏أتىۄًڽأىەأڬۄتأ=أۏۄأ+أذعشحأظلۏۄأ"
"6788","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأذعشحأظلۏۄأثىحأذۏۏأڬەأًهۏوەأوۏڽأڲًطحأشًټۏأڬہهتةۏأۗ"
"6789","أذعشحأإوىۄأثىحأتثۏأمۏضأؽلتشۏۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أوۏڽأتىأرًتحۏىأوۏڽأضەأۄًڽأدىۄًڽأىەأذعشحأظلۏۄأشعۏأتههۄأؼىۄتأڬًأشضًهأتههۄأ﷽أڬەأهةەأحۏتشأڬۏتأحہتأ؏أوۏڽأىەأتىأڬًألشوتحەأۄًةەأضىتأۄەأڬۄأ““أدضأشتحأوۏڽأشضًهأتههۄأ﷽أڬەأذدهۄأؼشًضۏأوۏڽأڲةۏأتضأًمحأحڬأوۏشۏأؼوشأتثہۏأ4:أضتهأځًشۏأىۄۏڽأۄًةۏأحہۏأۗأشتًۏأڬۄحەأۄۏڽأ=أتوأتهوًوىۏىأذعشحأظلۏۄأڬتأتىحمتهأذعشحأوؼتًۏۄأڬەأصوتىەأوۏڽأضىأ85أۄدشۏأڬًأۄًتأ؏أتًشأدىحأتهثمۏؼأوۏڽأتىأڬۏأحزلۏىأۄًةۏأۗأ"
"6790","أتوأتهوًوىۏىأذعشحأظلۏۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأۗأشضًهأتههۄأ﷽أوۏشەأځتضأحطشۏلأهتةەأ؏أتضأًمحأوۏڽأشًأشۄۏأحہۏأ؏أذعًشأ﷽أىەأودہأضەأشًىەأڬتأضثثأځًډہتأ؏أوۏڽأىەأڬۄتأ=أودہەأځحتأډهتأۄەأڬۄأذلظۄأتًشأؼتةطۄأوۏشۏأًدۄأضەأځشۏطتىأۄۏڽأتًشأڬۄحۏأۄۏڽأڬۄأۄوأتضأضەأثۄحشأۄۏڽأ؏أۄوأشضًهأتههۄأ﷽أڬۏأډډتأصتزأثہۏأۄۏڽأتًشأتىأڬۏأثۏًۏتڽأثہۏأۄۏڽأ؏أذعًشأ﷽أىەألشوتۏتأ=أحوأىەأۏۄأڬۏًڽأىۄۏڽأڬۄتأڬۄأحوأودہأضەأثۄحشأڬۏضەأۄًأضڬحۏأۄًأآأوۏشتأثتځأۄتشًىأؼهۏۄأتهضهتوأۄۏڽأ؏أوۏشتأډډتأذعشحأوًضۏٳأؼهۏۄأتهضهتوأۄۏڽأتًشأوۏشەأطًۄشأوذوزأ﷽أۄۏڽأۗأ"
"6791","أذعشحأطؼثۄأڬۄحەأۄۏڽأ=أوضؼشأثىأڬزتوأىەأودہەأثحتۏتأڬۄأصًدۄأشضًهأتوأتهوًوىۏىأذعشحأوۏوًىۄأثىحأذتشخأثىأذصىأثىأثذۏشأثىأۄشوأثىأشًۏثۄأثىأؼثزتههۄأثىأۄهتهأثىأؼتوشأثىأظؼظؼۄأ‛‛أىەأشًتۏحأثۏتىأڬۏأۄەأۗأتىأڬۏأًتهزۄأ““أۄىزأثىأؼًلأثىأصۄۏشأثىأذتشخأثىأذوتغۄأثىأذتشخأثىأذوۏشأ‛‛أۄۏڽأۗأ"
"6792","%أوذوزأثىأؼوشأڬۄحەأۄۏڽأ=““أذعشحأوۏوًىۄأثىحأذتشخأثىأذوتغۄأثىأذتشخأ‛‛أۏۄأذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأڬۏأرتهۄأۄۏڽأۗأتًشأ““أذعشحأتوأتهلعهأثىأذتشخأشعۏأتههۄأؼىۄتأ‛‛أڬۏأثۄىأۄۏڽأۗأتىۄًڽأىەأصوتىۄأدتۄهۏحأوۏڽأوضؼًزأثىأؼوۏشأخملۏأڬەأضتحہأطتزۏأڬۏأحہۏأ؏أځہشأتىۄًڽأىەأتىأڬًأغهتمأزەأزۏأ؏أځہشأتثًشۄوأثىأؼثزتهؼصۏٳأثىأتثۏأمۏضأ+أدىأڬتأحؼهمأثىۏأوتهڬأثىأذضهأثىأؼتوشأثىأهاۏأڬەأضتحہأحہتأ"
"6793","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أوۏشۏأرتهۄأڬتأىتوأ““أوۏوًىۄأثىحأثشۄأشعۏأتههۄأؼىۄتأ‛‛أۄەأۗ"
"6794","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحأوۏوًىۄأشعۏأتههۄأؼىۄتأڬتأتظهأىتوأ““أثشۄأ‛‛أحہتأ؏أشضًهأتههۄأ﷽أىەأثزهأڬشأتىأڬتأىتوأ““أوۏوًىۄأ‛‛أشڬہأزۏتأۗأ"
"6795","أتثىأطۄتثأڬۄحەأۄۏڽأ=أشضًهأتههۄأ﷽أتڲهەأضتهأضىأ:أۄدشۏأوۏڽأسۏأمؼزۄأڬەأوۄۏىەأوۏڽأؼوشۄأڬۏأىۏحأضەأشًتىۄأۄًةەأ؏أۏۄأًۄۏأوۄۏىۄأحہتأدضأوۏڽأوطشڬۏىأىەأذعًشأ﷽أڬًأوضدزأذشتوأوۏڽأزترهەأضەأشًڬأزۏتأحہتأ؏أدثأشضًهأتههۄأ﷽أومتوأ““أۏتددأ‛‛أوۏڽأځۄىډەأحًأإځأ﷽أىەأذعشحأدؼلشأتثىأتثۏأغتهثأشعۏأتههۄأؼىۄأڬەأۄتحہأذعشحأوۏوًىۄأثىحأذتشخأثىأذصىأؼتوشۏۄأ‛‛أڬەأهةەأځۏؽتوأىڬتذأثہۏدتأ؏أتىۄًڽأىەأتځىتأوؼتوهۄأتځىەأ+أثۄىًةۏأ"
"6796","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتوأتهوًوىۏىأذعشحأوۏوًىۄأثىحأذتشخأشعۏأتههۄأؼىۄتأڬەأضتحہأطتزۏأڬۏأ؏أتًشأحۏىأزىأوڬۄأوۏڽأمۏتوألشوتۏتأ=أحۏضشەأزىأذًۏغثأثىأؼثزتهؼصۏٳأمشۏطأڬەأتۏڬأڲشًۄأڬەأۄوشتۄأإځأ﷽أڬەأځتضأإۏتأ؏أتىأهًڲًڽأىەأذعًشأ﷽أضەأڬۄتأ؏أحوۄتشۏأوۏؼتزأځًشۏأۄًأډڬۏأۄەأهۄٳستأإځأوڬۄأضەأىڬهأدتةۏەأۗأذعًشأ﷽أىەألشوتۏتأتڲشأحوأودہەأڬډہأوۄهحأزەأزًأ؏أوۏشەأىةەأىڬتذأڬەأڬډہأوؼتوهتحأتثہۏأثتمۏأۄۏڽأ؏أوۏڽأًۄأتزتأڬشأهًڽأ؏أوۏڽأحوۄتشەأهةەأڬہتىتأحۏتشأڬشًتحتأۄًڽأ؏أڬۏتأحوأإاأڲەأآأتىۄًڽأىەأڬۄتأ=أۄوۏڽأحوۄتشەأڬہتىەأڬۏأڬًةۏأذتدحأىۄڽأۄەأ؏أثضأحوأۏۄتڽأضەأىڬهأدتاأ؏أډىتىډۄأىثۏأتڬشوأ﷽أذعشحأوۏوًىۄأڬًأۄوشتۄأهەأڬشأوڬۄأضەأشًتىۄأۄًأڲةەأتًشأشتضحەأوۏڽأومتوأ““أضشلأ‛‛أوۏڽأذعشحأوۏوًىۄأڬەأضتحہأطثأؼشًضۏأڲصتشۏأۗ"
"6797","أتوأتهوًوىۏىأذعشحأوۏوًىۄأشعۏأتههۄأؼىۄتأضەأوشًۏأۄەأڬۄأىثۏأتڬشوأ﷽أىەأتىأضەأؽۏشأوذشوأذتهحأوۏڽأىڬتذأڬۏتأتًشأؽۏشأوذشوأذتهحأوۏڽأۄۏأطثأؼشًضۏأڲصتشۏأ؏أومتوأ““أضشلأ‛‛أوۏڽأتىأڬەأضتحہأطثأؼشًضۏأڲصتشۏأ؏أتًشأومتوأ““أضشلأ‛‛أوۏڽأدضأومتوأځشأطثأؼشًضۏأڲصتشۏأحہۏأ؏أتضۏأومتوأځشأتىأڬتأتىحمتهأۄًتأۗأإځأشطحەأوۏڽأوۏڽأرتهۄأهڲحۏأۄۏڽأ؏أتىأڬًأهذزأوۏڽأ؏أوۏڽأىەأتًشأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأىەأتحتشتأحہتأ؏أدثأۄوأتىأڬًأهذزأوۏڽأشڬہىەأهڲەأحًأتىأڬتأضشأدہڬأڲۏتأ؏أوۏڽأىەأتځىۏأډتزشأتڬټہۏأڬشأڬەأتىأڬەأضشأڬەأىۏډەأشڬہأزۏأ؏أؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأىەأًۄأډتزشأځڬڔأڬشأثتۄشأځہۏىڬأزۏأ؏أتًشأتىأڬەأضشأڬەأىۏډەأڬډۏأتۏىټأشڬہأزۏأۗأشتًۏأڬۄحەأۄۏڽأ=أذدأڬەأزًشتىأتىۄًڽأىەأذهمأڬشًتۏتأحہتأتًشأتىأڬەأضشأڬەأثتهأثۄحأڲہىەأحہەأۗأوڬۄأتًشأ““أضشلأ‛‛أڬەأزشوۏتىأثتشۄأوۏهأڬۏأوضتلحأۄەأۗأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأۗأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأتهثحۄأ+أتۏڬأزًضشۏأ"
"6798","%أؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأذتهحأتذشتوأوۏڽأىڬتذأڬۏتأۗأؼوشًأڬۄحەأۄۏڽأ=أوۏڽأىەأتضأشًتۏحأڬتأسڬشأصۄشۏأضەأڬۏتأحًأتىۄًڽأىەأڬۄتأ=أتەأؼوشًأ$أحوۄتشتأڬۏتأرۏتهأۄەأ؏أذعًشأ﷽أىەأًۄأىڬتذأڬضأضەأڬۏتأحہتأآأوۏڽأىەأڬۄتأ=أهًڲأحًأۏۄۏأڬۄحەأۄۏڽأڬۄأذعشحأوۏوًىۄأشعۏأتههۄأؼىۄتأڬەأضتحہأڬۏتأحہتأۗأتثىأطۄتثأىەأڬۄتأ=أودہەأۏصۏزأثىأتظوأىەأۏۄأثتحأثحتةۏأۄەأڬۄأىثۏأتڬشوأ﷽أىەأذعشحأوۏوًىۄأشعۏأتههۄأؼىۄتأڬەأضتحہأدثأىڬتذأڬۏتأ؏أتضأًمحأإځأ﷽أذتهحأتذشتوأوۏڽأىۄۏڽأحہەأۗأؼوشًأىەأطۄتثأضەأڬۄتأ=أحوأتځىۏأتۏڔہۏًڽأځشأځۏطتثأڬشىەأًتهەأثزًأڬًأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأڬەأثشتثشأمشتشأزەأشۄەأۄًأآأتثىأطۄتثأىەأڬۄتأ=أًۄأتىأڬۏأرتهۄأۄۏڽأ؏أذعشحأؼوشًأىەأڬۄتأ=أًۄأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأڬۏأثہۏأرتهۄأۄۏڽأۗ"
"6799","%أذعشحأوۏوًىۄأشعۏأتههۄأؼىۄتأڬەأثہحۏدەأ؏أذعشحأصۏزأثىأتظوألشوتحەأۄۏڽأ=أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأوڬۄأضەأًتځضأإأشۄۏأحہۏڽأ؏أشتضحەأوۏڽأتىأڬەأضتحہأوۏشۏأتًشأغهذۄأثىأؼثۏزتههۄأشعۏأتههۄأؼىۄأ+أدًأڬۄأتىأڬەأثہتىدەأۄۏڽأ"
"6800","أتوأتهوًوىۏىأذعشحأوۏوًىۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أتۏڬأزلؼۄأشتحأڬەأًمحأشضًهأتههۄأ﷽أوۏشەأځتضأضەأىڬهەأ؏أإځأحطشۏلأهەأڲةەأ؏أحًأوۏڽأىەأزشًتصۄأثىزأڬشأهۏتأ؏أإځأ﷽أدثأًتځضأإةەأحًأزشًتصۄأثدتۏتأ؏أوۏڽأىەأزشًتصۄأڬہًهىەأضەأتىڬتشأڬشأزۏتأ؏أذعًشأ﷽أىەألشوتۏتأ=أڬۏتأحوأىەأزشًتصۄأىۄأڬہًهىەأڬۏأمضوأڬہتأهۏأۄەأآأوۏڽأىەأڬۄتأ=أإځأوۏشۏأثتشۏأڬۏأشتحأوۏڽأزۏڲشأتصًتدأڬەأځتضأڬۏًڽأحطشۏلأهەأڲةەأآأإځأ﷽أىەألشوتۏتأ=أوۏڽأىەأحًأتۏضتأڬډہأىۄۏڽأڬۏتأ؏أوۏڽأحًأځۏطتثأڬۏأًدۄأضەأذمىۄأ+أزًتةۏأ"
"6801","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أضثأثۄىۏڽأ؏أوًوىتحأۄۏڽأ؏أوۏوًىۄأشعۏأتههۄأؼىۄتأشضًهأتههۄأ﷽أڬۏأصًدۄأۄۏڽأ؏أتًشأتىأڬۏأثۄىأتوأتهلعهأثىحأذتشخأۄۏڽأ؏أتًشأتىأڬۏأثۄىأضهوۏأثىحأذتشخأ؏أًۄأذعشحأذوصۄأشعۏأتههۄأؼىۄأڬۏأصًدۄأۄۏڽأ؏أتًشأتضوتأثىحأؼوۏضأشعۏأتههۄأؼىۄتأڬۏأوتڽأطشۏڬأ+أترۏتلۏأ"
"6802","%أؼغتؤأڬۄحەأۄۏڽأ=أۄوأذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأڬەأۄوشتۄأومتوأضشلأوۏڽأتوأتهوًوىۏىأذعشحأوۏوًىۄأشعۏأتههۄأؼىۄتأڬەأدىتصۄأوۏڽأطشۏڬأحہەأ؏أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأىەألشوتۏتأ=أۏۄأوۏوًىۄأشعۏأتههۄأؼىۄتأۄۏڽأدثأحوأتىأڬتأدىتصۄأتټہتاأحًأتضأڬۏأډتشځتةۏأڬًأدہټڬتأهڲىەأتًشأصۏتزۄأذشڬحأزۏىەأضەأثډتىتأۗأشضًهأتههۄأ﷽أڬۏأ<أتصًتدأحہۏڽأ؏أإځأىەأ;أڬەأهةەأثتشۏأومششأڬۏأۄًةۏأحہۏأتًشأتۏڬأرتحًىأتۏضۏأحہۏڽأدىأڬەأهةەأثتشۏأومششأىۄۏڽأڬۏأحہۏأۗأؼغتأڬۄحەأۄۏڽأ=أًۄأذعشحأظلۏۄأشعۏأتههۄأؼىۄتأحہۏڽأۗ"
"6803","%أذعشحأمحتزۄأثىأزؼتوۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأوۏوًىۄأثىحأذتشخأثىألشًۄأشعۏأتههۄأؼىۄتأڬەأضتحہأىڬتذأڬۏتأۗأإځأذعشحأؼثتضأثىأؼثزتهوغهثأشعۏأتههۄأؼىۄأڬۏأصًدۄأتوأتهلعهأڬۏأثۄىأۄۏڽأ؏أشضًهأتههۄأ﷽أدثأؼوشۄأڬەأهةەأوڬۄأوڬشوۄأحطشۏلأهتةەأحًأتضأًمحأتىۄًڽأىەأرًزأڬًأشضًهأتههۄأ﷽أڬًأۄثۄأڬشأزۏتأ؏أتىۄۏأڬەأثتشەأوۏڽأۏۄأإۏحأىتصهأۄًةۏأۗ"
"6804","ڬحتثأوۏڽأتضأڬتأحشدوۄأوًدًزأىۄۏڽأۄەأ"
"6805","أتثىأطۄتثأڬۄحەأۄۏڽأۗأصۏىثأثىحأرصۏوۄأثىأذتشخأثىأؼثزتههۄأثىأؼوشًأثىأؼثزأوىتلأثىأۄهتهأثىأؼتوشأثىأظؼظؼۄأ‛‛أڬتأتىحمتهأۄًأڲۏتأ؏أإځأ““أتوأتهوضتڬۏىأ‛‛أحہۏڽأ؏أصوتىۄأدتۄهۏحأوۏڽأتىأڬتأۏۄۏأىتوأوطۄًشأحہتأ؏أشضًهأتههۄأ﷽أڬۏأذۏتحأوثتشڬۄأۄۏأوۏڽأۄدشحأڬەأثؼزأوزۏىۄأوىًشۄأوۏڽأتىأڬتأتىحمتهأۄًأڲۏتأحہتأۗأ"
"6806","أذعشحأمحتزۄألشوتحەأۄۏڽأ=““أځہشأشضًهأتههۄأ﷽أىەأذعشحأصۏىثأثىحأرصۏوۄأشعۏأتههۄأؼىۄتأضەأىڬتذأڬۏتأ؏أإځأځۄهەأغلۏهأثىأذتشخأڬەأىڬتذأوۏڽأحہۏڽأۗأتىأڬًأشضًهأتههۄأ﷽أڬۏأوؼۏحأثۄحأڬوأىظۏثأۄًةۏأ؏أذعًشأ﷽أڬۏأذۏتحأۄۏأوۏڽأتىأڬتأتىحمتهأۄًأڲۏتأحہتأۗأ"
"6807","أصۄشۏأڬۄحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأ““أؼتهۏۄأڬەأضتحہأىڬتذأڬۏتأ؏أؼتهۏۄأڬتأحؼهمأثىۏأثڬشأثىأڬهتثأڬەأضتحہأحہتأۗأ"
"6808","أصۏزأثىأڬؼثأثىأؼدشۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأثىۏأؽلتشأڬۏأتۏڬأرتحًىأڬەأضتحہأىڬتذأڬۏتأ؏أدثأشضًهأتههۄأ﷽أذدهۄأؼشًضۏأوۏڽأحطشۏلأهتةەأ؏أتىأڬۏأثؽهأوۏڽأڬډہأضلۏزۏأزۏڬہۏأ؏أىثۏأتڬشوأ﷽أىەألشوتۏتأ=أتځىەأڬځڔەأځۄىًأتًشأتځىەأڲہشأډهۏأدتاأ؏أتىأڬتأذمأوۄشأتزتأڬشأزۏتأ؏أۏۄأرتحًىأڬهتثۏۄأىۄۏڽأحہۏڽأ؏أثهڬۄأۏۄأتضوتؤأثىحأىؼوتىأؽلتشۏۄأۄۏڽأۗأ"
"6809","أذعشحأمحتزۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتۄهأۏوىأوۏڽأضەأذعشحأتضوتؤأثىحأىؼوتىأؽلتشۏۄأشعۏأتههۄأؼىۄتأضەأىڬتذأڬۏتأ؏أإځأىؼوتىأثىأذتشخأثىأطشتذۏهأثىأىؼوتىأڬۏأظتذثصتزۏأۄۏڽأ؏أدثأىثۏأتڬشوأ﷽أ+أځۄهۏأوشحثۄأ"
"6810","أذعشحأمحتزۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتوأطشۏڬأتىظتشۏۄأىدتشۏۄأشعۏأتههۄأؼىۄتأڬەأضتحہأىڬتذأڬۏتأحہتأ؏أتًشألشوتۏتأ=أوۏڽأتىظتشأڬۏأرًتحۏىأضەأطتزۏأڬشىتأځضىزأڬشحتأۄًڽأ؏أځہشألشوتۏتأ=أودہەأتىأڬەأوصتدأڬۏأحۏصۏأځضىزأىۄۏڽأۄەأ؏أتضأهةەأتىأڬەأضتحہأزرًهأىۄۏڽأڬۏتأۗأ"
"6811","%أذلظأثىأىعشأضهوۏأتًشأؼثزتهمتۄشأثىأضشۏأضهوۏألشوتحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأضىتؤأثىحأتضوتؤأثىأظهحأضهوۏۄأشعۏأتههۄأؼىۄتأڬەأضتحہأىڬتذأڬۏتأ؏أهۏڬىأشرظحۏأضەأځۄهەأۄۏأتىأڬتأتىحمتهأۄًأڲۏتأحہتأۗ"
"6812","أوذوزأثىأؼوشأثۏتىأڬشحەأۄۏڽأ=أڬهتثۏۄأڬەأىتوأڬەأثتشەأوۏڽأترحهتلأۄەأ؏أڬډہأهًڲًڽأڬتأرۏتهأۄەأڬۄأتىأڬتأىتوأ““ألتغوۄأثىحأعذتڬأثىأضلۏتىأڬهتثۏأ‛‛أۄەأۗأثؼعأهًڲًڽأىەأڬۄتأ=أتىأڬتأىتوأ““أؼوشۄأثىحأصۏزأثىأؼثۏزأثىأشًتضأثىأڬهتثأثىأؼتوشأ‛‛أحہتأۗأڬډہأواشرۏىأڬتأڬۄىتأۄەأڬۄأتىأڬتأىتوأ““أضثتأثىحأضلۏتىأثىأؼًلأثىأڬؼثأثىأؼثۏزأثىأتثۏأثڬشأثىأڬهتثأ‛‛أحہتأۗأڬډہأواشرۏىأڬتأوًملأۏۄأۄەأڬۄأتىأڬتأىتوأ““أؼتهۏۄأثىأػثۏتىأ‛‛أثؼعأڬتأڬۄىتأۄەأڬۄأًۄأڬهتثۏۄأتڬۏهۏأۄۏڽأۗأتىأڬەأىتوأڬەأثتشەأوۏڽأترحهتلأۄەأ؏أثؼعأىەأڬۄتأۄەأڬۄأۏۄأحوتوأتهڲأتهڲأرًتحۏىأۄۏڽأتًشأتىأضثأڬتأتهڲأتهڲأتۏڬأًتمؼۄأۄەأۗأ"
"6813","أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأڬهتثۏۄأضەأىڬتذألشوتۏتأ؏أدثأذعًشأ﷽أتضأڬەأځتضأڲةەأ؏أتًشأتىأڬەأمشۏثأۄًةەأ؏أحًأًۄأڬۄىەأهڲۏأ=أوۏڽأإځأضەأتههۄأحؼتهۏٳأڬۏأځىتۄأوتىڲحۏأۄًڽأ+أىؼًسأثتههۄأوىأستهڬأ"
"6814","أتًصتؼۏأڬۄحەأۄۏڽأ=أوۏڽأىەأصۄشۏأضەأځًډہتأڬۄأىثۏأتڬشوأ﷽أڬۏأڬًىأضۏأثۏًۏأىەأإځأ﷽أضەأځىتۄأوتىڲۏأحہۏأۗأ+أىؼًسأثتههۄأوىأستهڬأ"
"6815","أؼثزتههۄأثىأوذوزأثىأؼمۏهألشوتحەأۄۏڽأ=أشضًهأتههۄأىەأڬىزۄأڬۏأتۏڬأرتحًىأڬەأضتحہأىڬتذأڬۏتأ؏أۏۄأًۄۏأ““أثزىظۏثأ‛‛أۄەأ؏أدضأىەأشضًهأتههۄأ﷽أضەأوغتهثۄأڬۏتأحہتأڬۄأًۄأتىأڬًأغهتمأزەأڬشأتىأڬەأوۏڬەأثہۏدأزۏڽأۗأشضًهأتههۄأ﷽أىەأتضأڬًأتۏڬأتىظتشۏأظذتثۏأ+أتثًتضۏزأضتؼزۏأ"
"6816","%أؼثزتهًتذزأثىأتثۏأؼًىأزًضۏألشوتحەأۄۏڽأ=أىؼوتىأثىأتثۏأدًىأڬىزۏأتًشأتضأڬەأثۄىأثہتةۏأطشثۄأڬەأمشۏثأومتوأىدزأوۏڽأشۄحەأحہەأ؏أىؼوتىأثىأتثۏأدًىأڬىزۏأوضهوتىأۄًأڬشأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًةەأۗأتىۄًڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أڬۏتأوۏڽأإځأڬەأىڬتذأؼشثأڬۏأضثأضەأذضۏىأحشۏىأثۏًۄأرتحًىأضەأىۄأڬشتأزًڽأآأًۄأإځأڬەأډډتأصتزأثہتةۏأڬەأىڬتذأوۏڽأحہۏأۗأتثأتضأڬەأطًۄشأڬتأتىحمتهأۄًأډڬتأۄەأ؏أتًشأًۄأثۏًۄأۄًأډڬۏأۄەأ؏أًۄأإځأڬۏأطرظۏحأوۏڽأزهډضځۏأشڬہحۏأۄەأتًشأتضأىەأإځأڬەأهةەأځۏؽتوأىڬتذأثہۏأثہۏدتأۄەأۗأشضًهأتههۄأ﷽أىەأتىأڬەأضتحہأىڬتذألشوتأهۏتأ؏أتًشأذمأوۄشأ45أتًمۏۄأتًشأتۏڬأىطأډتىزۏأشڬہۏأۗأشضًهأتههۄأ﷽أىەألشوتۏتأ=أتىۄًڽأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أتضأڬتأوۄشأڬوأوحأشڬہةەأ؏أذعًشأ﷽أىەألشوتۏتأ=أوۏڽأىەأتځىۏأڬضۏأثۏًۏأڬتأذمأوۄشأتضأضەأصۏتزۄأىۄۏڽأشڬہتأۗأتًشأىۄأۄۏأتځىۏأڬضۏأثۏټۏأڬتأذمأوۄشأتضأضەأصۏتزۄأهۏتأۄەأۗأىؼوتىأثىأتثۏأدًىأىەأڬۄتأ؏أۄوتشۏأۄوزشزۏتڽأحًأإځأڬەأضتحہأۄۏڽأۗأتىۄًڽأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أإځأڬضۏأڬًأثہۏدأزۏدةەأ؏أدًأتىأڬًأتځىەأضتحہأإځأحڬأهەأإةەأ؏أوۏڽأإځأڬەأضلۏشأڬًأضتحہأهەأدتاڽأڲتأتًشأًۄتڽأدتأڬشأتىأڬًأإځأڬەأضلۏشأڬەأۄوشتۄأثہۏدأزًڽأڲتأۗأډىتىډۄأشضًهأتههۄأ﷽أىەأذعشحأتثًتضۏزأضتؼزۏأشعۏأتههۄأؼىۄأڬًأىؼوتىأڬەأضتحہأثہۏدتأ؏أدثأۏۄأزًىًڽأتىأڬەأځتضأځۄىډەأحًأًۄأتځىەأڲہشأوۏڽأثۏټہۏأۄًةۏأحہۏڽأ؏أتًشأتىأڬًأتىزشأإىەأڬۏأتدتصحأزۏأ؏أذعشحأتثًتضۏزأىەأڬۄتأ=أشضًهأتههۄأ﷽أڬۏأتصًتدأوغۄشتحأوشزًڽأضەأځشزۄأڬشحۏأۄۏڽأۗأۏۄأثتحأځشزۄأڬەأتذڬتوأىتصهأۄًىەأڬەأثؼزأڬۏأۄەأ؏أوۏڽأىەأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأځۏؽتوأثہۏدتأحہتأ؏أحًأذعًشأ﷽أىەأوۏشەأهةەأىشوۏألشوتأزۏأحہۏأ؏أىؼوتىأىەأڬۄتأ=أحوأدىأوشزًڽأڬەأضتحہأڲلحڲًأڬشحۏأۄًأ؏أحوۄتشەأتًشأتىأڬەأزشوۏتىأځشزۄأۄًىتأډتۄۏەأ؏أتهثحۄأتڲشأًۄأإځأڬتأوذشوأۄًأ+أحًأتضأڬەأضتوىەأإىەأوۏڽأڬًةۏأذشدأىۄۏڽأۄەأ"
"6817","أتثًؼثۏزۄأوؼوشأثىأوخىۏٳألشوتحەأۄۏڽأ=أځہشأشضًهأتههۄأ﷽أڬەأځتضأدثأڬىزۄأڬتأًلزأإۏتأ؏أتضأًمحأشضًهأتههۄأ﷽أىەأتطؼخأثىأمۏضأڬۏأثۄىأمحۏهۄأثىحأمۏضأڬەأضتحہأىڬتذأڬۏتأ؏أۏۄأضىأ43أۄدشۏأڬۏأثتحأۄەأ؏أځہشأوتۄأظلشأڬەأزشوۏتىأذعًشأ﷽أثۏوتشأۄًأڲةەأ؏أتًشأتضۏأضتهأ45أشثۏؼأتهتًهأ؏أضًوًتشأڬەأزىأإځأ﷽أڬتأًظتهأوثتشڬأۄًأڲۏتأ؏أمحۏهۄأىۄأحًأذعًشأ﷽أڬەأځتضأإةۏأ؏أتًشأىۄأۄۏأذعًشأ﷽أىەأتضأضەأۄوثضحشۏألشوتةۏأۗأثؼعأوذزخۏىأىەأتىأڬەأضتحہأشضًهأتههۄأ﷽أڬەأىڬتذأڬتأًمحأثۏتىأڬشحەأۄًةەأڬۄتأۄەأڬۄأذعًشأ﷽أىەأتځىۏأًلتحأضەأتۏڬأوۄۏىۄأځۄهەأتضأضەأىڬتذأڬۏتأحہتأۗأزۏڲشأوذزخۏىأڬتأڬۄىتأۄەأڬۄأذعًشأ﷽أىەأثۏوتشۏأڬۏأذتهحأوۏڽأتضأضەأىڬتذأڬۏتأحہتأۗأڬډہأوذزخۏىأڬتأۏۄأوًملأۄەأڬۄأذعًشأ﷽أىەأًظۏحألشوتةۏأحہۏأڬۄأمحۏهۄأڬًأترحۏتشأزۏتأدتةەأ؏أتڲشأًۄأڬضۏأزًضشۏأدڲۄأىڬتذأڬشىتأډتۄەأحًأتضأڬًأڬشىەأزۏتأدتةەأ؏أډىتىډۄأذعشحأؼڬشوۄأثىأتثۏأدۄهأىەأذعشوًحأوۏڽأتضأضەأىڬتذأڬۏتأۗأتضأثتحأڬۏأتغهتؼأذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأحڬأځۄىډۏأحًأتىۄًڽأىەألشوتۏتأ=أوۏشتأحًأتشتزۄأۄەأڬۄأتىأزًىًڽأڬًأدهتأڋتهًڽأ؏أذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أًۄأتوۄتحأتهوًوىۏىأوۏڽأضەأحًأىۄۏڽأۄەأ؏أىۄأۄۏأىثۏأتڬشوأ﷽أىەأتضأضەأۄوثضحشۏأڬۏأۄەأۗأىۄأتضأځشأځشزەأڬەأتذڬتوأىتلسألشوتةەأۄۏڽأۗأثؼعأوذزخۏىأحًأڬۄحەأۄۏڽأڬۄأًۄأوشحزأۄًأڲةۏأحہۏأۗأ+أتهؼۏتسأثتههۄأ"
"6818","أتثىأطۄتثأصۄشۏأڬۄحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأضۏزۄأوتشۏۄأمثغۏۄأڬًأڬىۏصأڬەأغًشأځشأشڬہتأحہتأ؏أتىأڬەأۄتڽأذعشحأتثشتۄۏوأشعۏأتههۄأؼىۄأڬۏأًهتزحأۄًةۏأحہۏأۗأ"
"6819","أوظؼثأثىأؼثۏزتههۄأصثۏشۏألشوتحەأۄۏڽأ=أځہشأشضًهأتههۄأ﷽أىەأوتشۏۄأثىحأطوؼًىأڬەأضتحہأىڬتذأڬۏتأ؏أۏۄأًۄۏأرتحًىأۄۏڽأدًأتضڬىزشۏۄأڬەأثتزطتۄأومًمضأىەأشضًهأتههۄأ﷽أڬًأحذلەأڬەأغًشأځشأزۏأحہۏأ؏أتضأڬەأۄوشتۄأتضأڬۏأثۄىأضۏشۏىأتًشأرظۏأثہۏأزۏأحہۏأ؏أتضأڬًأ““أوتثًشأ‛‛أڬەأىتوأضەأځڬتشتأدتحتأحہتأ؏أشضًهأتههۄأ﷽أىەأ““أضۏشۏىأ‛‛أذعشحأذضتىأثىأختثحأشعۏأتههۄأؼىۄأڬًأۄزۏۄأڬشأزۏأحہۏأۗأتًشأومًمضأمثغۏأحہتأتًشأىظتشۏٳأوۏڽأضەأحہتأۗأضۏزۄأوتشۏۄأڬەأثغىأضەأشضًهأتههۄأ﷽أڬەأظتذثصتزەأذعشحأتثشتۄۏوأشعۏأتههۄأؼىۄأڬۏأًهتزحأسۏأتهذدۄأضىأ;أۄدشۏأڬًأۄًةۏأحہۏأ؏أذعشحأتثشتۄۏوأشعۏأتههۄأؼىۄأڬتأًظتهأ4;أوتۄأڬۏأؼوشأوۏڽأوزۏىۄأوىًشۄأوۏڽأۄًتأۗأ"
"6820","أذعشحأثشتؤأثىأؼتصثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأىثۏأتڬشوأ﷽أڬەأظتذثصتزەأذعشحأتثشتۄۏوأشعۏأتههۄأؼىۄأڬتأتىحمتهأۄًتأ؏أحًأذعًشأ﷽أىەألشوتۏتأ=أتضأڬًأزًزہأځهتىەأًتهۏأدىحأوۏڽأۄەأۗأ"
"6821","أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أوتشۏۄأ؏أشضًهأتههۄأ﷽أڬًأحذلۄأڬەأغًشأځشأزۏأڲةۏأحہۏڽأ؏أتىأڬەأۄوشتۄأتىأڬتأډډتأصتزأثہتةۏأثہۏأحہتأ+أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأ"
"6822","أوًضۏٳأثىأوذوزأثىأتثشتۄۏوأحۏوۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأحوتوأؼوشأ؏أذعشحأوتشۏۄأځشأثۄحأرشډأڬشحەأشۄەأ؏أځہشأتىأڬتأتىحمتهأۄًأڲۏتأحًأتىأڬەأثؼزأذعشحأؼوشأشعۏأتههۄأؼىۄأتىأځشأرشډأڬشىەأهڲأڲةەأ؏أځہشأذعشحأؼوشأشعۏأتههۄأؼىۄأۄۏأڬەأزًشأرهتلحأوۏڽأذعشحأوتشۏۄأڬتأتىحمتهأۄًأڲۏتأۗأذعشحأتثىأؼوشألشوتحەأۄۏڽأ=أتثشتۄۏوأثىأشضًهأتههۄأ﷽أڬۏأًتهزۄأوتشۏۄأڬتأتىحمتهأوذشوأضىأ49أۄدشۏأڬًأۄًتأۗأذعشحأؼوشأشعۏأتههۄأؼىۄأڬًأزۏڬہتأڲۏتأڬۄأًۄأهًڲًڽأڬًأتىأڬەأدىتصۄأڬەأهةەأدوؼأڬشأشۄەأحہەأ؏أذعشحأؼوشأشعۏأتههۄأؼىۄأۄۏأىەأتىأڬۏأىوتصأدىتصۄأځڔہتةۏأ؏أتىأڬۏأمثشأدىحأتهثمۏؼأوۏڽأۄەأۗأ"
"6823","أؼثتضأثىأوذوزأزًشۏألشوتحەأۄۏڽأ=أۏذۏۏأثىأوؼۏىأىەأذعشحأختثحأثىأتىضأشعۏأتههۄأؼىۄأڬۏأۏۄأذزۏخأثۏتىأڬۏأ““أتثشتۄۏوأثىأوذوزأشضًهأتههۄأ﷽أڬۏأًتهزۄأځشأتۏڬأإزوۏأڬەأذًتهەأضەأتهصتوأهڲتۏتأڲۏتأ؏أىثۏأتڬشوأ﷽أىەأتضأإزوۏأڬەأمحهأڬتأذڬوأزەأزۏتأحہتأۗأدثأهًڲًڽأىەأتضەأزۏڬہتأحًأًۄأودثًثأ+أڬټەأۄًةەأإهۄأحىتضهأًتهتأ"
"6824","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأإزوۏأځشأحۄوحأحہۏأڬۄأتضأڬەأتثشتۄۏوأثىأشضًهأتههۄأ﷽أڬۏأًتهزۄأڬەأضتحہأىتدتةصأحؼهمتحأۄۏڽأۗأشضًهأتههۄأ﷽أىەأذعشحأؼهۏأشعۏأتههۄأؼىۄأضەألشوتۏتأ=أدتاأ؏أتًشأتضأڬًأمحهأڬشأزًأ؏أذعشحأؼهۏأشعۏأتههۄأؼىۄأتضأڬەأځتضأإةەأ؏أًۄأتضأًمحأځتىۏأڬەأتۏڬأذًعأوۏڽأىۄتأشۄتأحہتأ؏أذعشحأؼهۏأشعۏأتههۄأؼىۄأىەأڬۄتأ=أثتۄشأىڬهًأ؏أځہشأتضأڬتأۄتحہأځڬڔأڬشأتضەأثتۄشأىڬتهتأ؏أدثأًۄأثتۄشأىڬهتأحًأ+أځحتأډهتأڬۄأ"
"6825","أذعشحأؼثزتهشذوىأثىأؼًلأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأوۏشتأۄتحہأځڬڔتأ؏أوۏڽأذعًشأ﷽أڬەأۄوشتۄأتىأڬەأظتذثصتزەأذعشحأتثشتۄۏوأشعۏأتههۄأؼىۄأڬەأځتضأڲۏتأ؏أتضأًمحأتىأځشأىصؼأڬتأؼتهوأغتشۏأحہتأۗأشضًهأتههۄأ﷽أىەأتىأڬًأتځىۏأڲًزأوۏڽأهۏتأ؏أذعشحأتثشتۄۏوأشعۏأتههۄأؼىۄأڬۏأشًذأملضأؼىظشۏأضەأځشًتصأڬشأڲةۏأ؏أذعًشأ﷽أىەأتىأڬًأڲًزأضەأشڬہأزۏتأ؏أإځأ﷽أشًأزةۏەأ؏أوۏڽأىەأؼشعأڬۏأۗأۏتأشضًهأتههۄأ﷽أإځأڬۏًڽأشًأشۄەأۄۏڽأآأإځأحًأرًزأزًضشًڽأڬًأشًىەأضەأوىؼألشوتحەأۄۏڽأ؏أذعًشأ﷽أىەألشوتۏتأ=أوۏڽأىەأشًىەأضەأحًأوىؼأىۄۏڽأڬۏتأ؏أوۏڽأىەأحًأزًتذومأتًشألتدشًڽأڬۏأإًتصۏڽأىڬتهىەأضەأوىؼأڬۏتأۄەأ؏أتۏڬأًۄأإًتصأدًأهۄًأًأهؼثأڬہۏهأڬًزأتًشأطۏتغۏىأڬەأثتدەأضىأڬشأىڬتهۏأدتحۏأۄەأتًشأزًضشۏأًۄأإًتصأدًأڬضۏأوظۏثحأڬەأًمحأڲشۏثتىأځہتڔأڬشأتًشأوىۄأځشأغوتىډەأوتشأوتشأڬشأىڬتهۏأدتحۏأۄەأ؏أۏۄأشًىتأحًأشذوحأۄەأ؏أتًشأدًأطرظأزًضشًڽأځشأشذوأىۄۏڽأڬشحتأتضأځشأثہۏأشذوأىۄۏڽأڬۏتأدتحتأۗأتًشأتڲشأضډتأًؼزۄأتًشأذمأثتحأځۏطأىػشأىۄأۄًحۏأتًشأۏۄأڬۄأۄوأتځىەأځۄهًڽأڬًأځډہهًڽأڬەأضتحہأوهتحەأۄۏڽأ+أۏۄأىۄأۄًحتأ"
"6826","أذعشحأتثًتوتوۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أتځىەأثۏټەأتثشتۄۏوأڬەأدىتصەأوۏڽأىىڲەأځتاڽأطشۏڬأۄًةەأحہەأۗأ"
"6827","أوظؼثأثىأؼثزتههۄأصثۏشۏألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أڬەأظتذثصتزەأذعشحأتثشتۄۏوأشعۏأتههۄأؼىۄأڬۏأًتهزۄأ““أوتشۏۄأ‛‛أوزۏىۄأوىًشۄأوۏڽأضىأ4:أۄدشۏأڬًألًحأۄًةۏڽأۗأتوۏشتهوًوىۏىأذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأىەأتىأڬۏأىوتصأدىتصۄأځڔہتةۏأ؏أتىأڬًأدىحأتهثمۏؼأوۏڽأزلىأڬۏتأڲۏتأۗأ"
"6828","أشضًهأتههۄأ﷽أڬۏأإصتزأڬشزۄأهًىڋۏأتًشأإځأڬۏأرتزوۄأذعشحأضهوۏٳألشوتحۏأۄۏڽأ=أثۄحأطتسًىتزشأۄۏأتۏضتأۄًتأۄًأڲتأڬۄأشضًهأتههۄأ﷽أڬەأځتضأڬضۏأطرظأىەأإأڬشأتځىەأزشزأڬۏأطڬتۏحأڬۏأۄًأحًأإځأىەأتضأڬًأذدتوحأڬتأوطًشۄأىۄأزۏتأۄًأ؏أتًشأدثأڬثہۏأڬضۏأىەأځتاڽأوۏڽأزشزأڬتأثحتۏتأحًأذعًشأ﷽أىەأتضأڬًأځتاڽأوۏڽأوۄىزۏأهڲتىەأڬتأوطًشۄأزۏتأۗأ"
"6829","أشضًهأتههۄأ﷽أڬۏأهًىڋۏأذعشحأوۏوًىۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أضەأذشتوۏأثډەأڬتأذڬوأځًډہتأڲۏتأحًأإځأ﷽أىەألشوتۏتأ=أوۏشەأىصزۏڬأًۄأزًأدًحۏتڽأدىۄۏڽأځۄىأڬشأوۏڽأدۄتزأڬشًڽأ؏أذشتوۏأؽهتوأإصتزأڬشىەأضەأصۏتزۄأثۄحشأۄەأۗأ"
"6830","%أذعشحأدثۏشأثىأىلۏشألشوتحەأۄۏڽأ=أوۏڽأشضًهأتههۄأ﷽أڬۏأڬىۏصأذعشحأتوۏوۄأشعۏأتههۄأؼىۄتأڬۏأرزوحأوۏڽأذتعشأۄًتأ؏أحًأتىۄًڽأىەألشوتۏتأ=أتۏڬأزلؼۄأڬتأسڬشأۄەأڬۄأوۏڽأشضًهأتههۄأ﷽أڬًأًعًأڬشًتأشۄۏأحہۏأ؏أتضأزًشتىأتۏڬأإزوۏأذعًشأ﷽أڬەأځتضأإۏتأتًشأڬۄىەأهڲتأ؏أۏتأشضًهأتههۄأ﷽أوۏڽأتځىەأڲہشأًتهًڽأڬەأځتضأًتځضأدتىەأڬتأتشتزۄأشڬہحتأۄًڽأ؏أإځأودہەأڬًةۏأتۏضۏأىظۏذحألشوتةۏڽأدضأڬًأوۏڽأتډہۏأغشذأۏتزأڬشأهًڽأۗأإځأ﷽أىەألشوتۏتأ="
"6831","أصۄشۏأڬۄحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأثىۏأمشۏػۄأضەأحؼهمأشڬہىەأًتهۏأشۏذتىۄأڬًأهًىڋۏأثىتۏتأحہتأ؏أتًشأًۄأتځىەأڲہشأًتهًڽأڬەأځتضأډهۏأڲةۏأحہۏأۗأ"
"6832","أتثًؼثۏزۄأوؼوشأثىأوخىۏأڬۄحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬۏأثتىزۏًڽأوۏڽأضەأ““أشۏذتىۄأثىحأصۏزأثىأضوؼًىأ‛‛أحہۏڽأ؏أدىأڬتأحؼهمأثىۏأىعۏشأضەأحہتأتًشأثؼعأوذزخۏىأڬتأڬۄىتأۄەأڬۄأتىأڬتأحؼهمأثىۏأمشۏػۄأضەأحہتأۗأإځأثتؽأوۏڽأشۄتأڬشحۏأحہۏڽأۗأشضًهأتههۄأ﷽أڬثہۏأڬثہتشأتىأڬەأۄتڽأمۏهًهۄألشوتۏتأڬشحەأحہەأ؏أشضًهأتههۄأ﷽أىەأتىأڬًأ7أۄدشۏأڬًأثتىزۏأثىتۏتأحہتأۗأتثًؼثۏزۄألشوتحەأۄۏڽأ=أذعًشأ﷽أڬۏأډتشأثتىزۏتڽأحہۏڽأۗأ+أ4أ"
"6833","أتثىأطۄتثأڬۄحەأۄۏڽأ=أىثۏأتڬشوأ﷽أڬۏأثۏټۏًڽأوۏڽأضثأضەأثڔۏأ““أذعشحأصۏىثأثىحأرزۏدۄأشعۏأتههۄأؼىۄتأ‛‛أۄۏڽأۗأ"
"6834","أؼثۏزتههۄأثىأوذوزأثىأضهۏوتىأۄتطوۏألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأذعشحأصۏىثأشضًهأتههۄأ﷽أڬۏأًهتزحأڬەأحۏضأضتهأثؼزأوڬۄأوڬشوۄأوۏڽأځۏزتأۄًةۏڽأ؏أتىأڬتأًظتهأوثتشڬأ;أۄدشۏأڬًأۄًتأۗأ"
"6835","%أذعشحأصۏىثأثىحأشضًهأتههۄأ﷽ألشوتحۏأۄۏڽأ=أتۏڬأزلؼۄأڬتأسڬشأۄەأڬۄأوۏڽأوڬۄأوۏڽأحہۏأتًشأتځىەأًتهزأوذحشوأڬۏأرزوحأوۏڽأدتىتأډتۄحۏأحہۏأ؏أوۏشەأځتضأۄىزأثىحأؼحثۄأثىأشثۏؼۄأإةۏأتًشأڬۄىەأهڲۏأ=أتەأوذوزأ﷽أڬۏأثۏټۏأ؏أودہەأځحتأډهتأۄەأڬۄأحوأتځىەأًتهزأڬەأځتضأدتىتأډتۄحۏأۄًأآأإځألشوتحۏأۄۏڽأ=أوۏڽأىەأڬۄتأ=أىۄۏڽأ؏أوۏشتأحًأتۏضتأڬًةۏأتشتزۄأىۄۏڽأۄەأۗأتضأىەأڬۄتأ=أتەأوۏشەأډډتأڬۏأثۏټۏأ$أتۏضتأىۄأڬشىتأ؏أتًشأتڲشأ+أحًأىەأهتصوۏأدتىتأۄۏأۄًأحًأ"
"6836","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أدثأشضًهأتههۄأ﷽أوزۏىۄأوىًشۄأحطشۏلأهتةەأحًأإځأ﷽أڬۏأظتذثصتزۏأذعشحأصۏىثأڬىتىۄأڬەأۄوشتۄأۏتأ+أطتۏزأ"
"6837","%أتثىأتثۏأوشۏوأىەأثہۏأۏۄۏأذزۏخأثۏتىأڬۏأۄەأ؏أتضأڬەأإرشأوۏڽأۏۄأثہۏأثۏتىأڬۏتأۄەأڬۄأ““أوۏشۏأۏۄأثۏټۏأضثأضەأتلعهأۄەأ‛‛أڬتأوغهثأۏۄأۄەأڬۄأ““أۏۄأثۏټۏأ؏أوۏشۏأتلعهأثۏټۏًڽأوۏڽأضەأۄەأ‛‛ۗأڬۏًىڬۄأىثۏأتڬشوأ﷽أڬەأذًتهەأضەأظذۏذأتذتزۏخأڬشۏوۄأضەأختثحأۄەأڬۄأضۏزۄألتغوۄأضهتوأتههۄأؼهۏۄتأتضأتوحأڬۏأحوتوأؼًشحًڽأڬۏأضشزتشأۄۏڽأۗأتضۏأغشذأىثۏأتڬشوأ﷽أڬەأذًتهەأضەأۏۄأثتحأثہۏأختثحأۄەأڬۄأإځأ﷽أىەألشوتۏتأ=ألتغوۄأدىحۏأؼًشحًڽأڬۏأضشزتشأۄەأ؏أضًتةەأ““أوشۏوأثىحأؼوشتىأ‛‛أڬەأۗ"
"6838","%أذعشحأؼثزتههۄأثىأتثۏأثڬشأثىأذصوألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأذعشحأصۏىثأشعۏأتههۄأؼىۄتأڬتأتىحمتهأ;أۄدشۏأڬًأۄًتأۗ"
"6839","أوظؼثأثىأؼوۏشأصثۏشۏألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأ؏أذعًشأڬۏأحوتوأثۏټۏًڽأوۏڽأضەأثڔۏأحہۏڽأۗأتىأڬۏأًلتحأڬتأضثثأۏۄأحہتأڬۄأدثأإځأشضًهأتههۄأ﷽أڬەأځتضأدتىەأڬەأهةەأوڬۄأضەأىڬهۏڽأحًأۄثتشأثىأتضًزأتًشأتۏڬأزًضشەأإزوۏأىەأتىأڬًأځڬڔأهۏتأ؏أتىأوۏڽأضەأتۏڬأىەأتىأڬەأتًىټأڬًأىۏډەأڲشتأزۏتأدضأڬۏأًدۄأضەأإځأثہۏأڲشأڲةۏڽأ؏أإځأتضأًمحأذتوهۄأحہۏڽأۗأىۏډەأڲشىەأڬۏأًدۄأضەأتىأڬتأذوهأڲشأڲۏتأ؏أتًشأرًىأدتشۏأۄًأڲۏتأ؏أرًىأوضهضهأثۄحتأشۄتأتًشأتضۏأحڬهۏلأوۏڽأتىأڬتأتىحمتهأۄًأڲۏتأۗأ"
"6840","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أدثأتۄهأوڬۄأىەأتځىەأتځىەأمۏزۏًڽأڬًأشۄتأڬشًتىەأڬەأهةەألزۏەأثہۏدەأ؏أحًأشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأذعشحأصۏىثأىەأتثًتهؼتظأڬۏأشۄتةۏأڬەأهةەأتۏڬأۄتشأثہۏدتأ؏أۏۄأۄتشأتثًتهؼتظأڬەأضتحہأىڬتذأڬەأوًمؼأځشأذعشحأرزۏدۄأشعۏأتههۄأؼىۄتأىەأتىأڬًأحذلۄأزۏتأحہتأ؏أدثأشضًهأتههۄأ﷽أىەأًۄأۄتشأزۏڬہتأحًأإځأ﷽أځشأثۄحأطزۏزأشمحأغتشۏأۄًأڲةۏأۗأإځأ﷽أىەأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأضەألشوتۏتأ=أتڲشأحوأهًڲأوىتضثأضودہًأحًأصۏىثأڬەأمۏزۏأڬًأشۄتأڬشأزًأتًشأتضأڬتأۏۄأۄتشأتضأڬًأًتځضأڬشأزًأۗ"
"6841","أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأذعشحأصۏىثأىەأتځىەأطًۄشأتثًتهؼتظأثىأشثۏؼأڬًأځىتۄأزۏأۗأشضًهأتههۄأ﷽أىەأتىأڬەأدًتشأ+أۏؼىۏأتىأڬًأځىتۄأزۏىەأ"
"6842","أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأتثًتهؼتظأمۏزۏأۄًتأحًأذعشحأصۏىثأىەأڬۄتأ=أوۏڽأىەأتثًتهؼتظأڬًأځىتۄأزۏأ؏أىثۏأتڬشوأ﷽أىەألشوتۏتأ=أدضأڬًأصۏىثأىەأځىتۄأزۏأ؏أتضأڬًأۄوأىەأځىتۄأزەأزۏأ؏أڬۏًىڬۄأوضهوتىًڽأڬۏأغشلأضەأتزىۏٳأضەأتزىۏٳأطرظأثہۏأڬضۏأ+أڬتلشأ"
"6843","أتوأتهوًوىۏىأذعشحأتوأضهوۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأذعشحأصۏىثأشعۏأتههۄأؼىۄتأڬۏأدتىثأځۏؽتوأثہۏدتأڬۄأحوأتځىەأًتهزأضەأوۏشەأهةەأتوتىأوتىڲًأ؏أإځأشضًهأتههۄأ﷽أڬەأڲہشأحطشۏلأهتةۏڽأ؏أذدشەأڬەأزشًتصەأضەأدہتىڬتأ؏أشضًهأتههۄأ﷽أهًڲًڽأڬًألدشأڬۏأىوتصأځڔہتأشۄەأحہەأ؏أذعشحأصۏىثأىەأإًتصأزەأڬشأڬۄتأ=أتەأهًڲًأ$أشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأصۏىثأۄًڽأۗأوۏڽأىەأتثًتهؼتظأڬًأځىتۄأزەأزۏأۄەأدثأىثۏأتڬشوأ﷽أىوتصأضەألتشؽأۄًةەأحًألشوتۏتأ=أتەأهًڲًأ$أۏۄأدًأإًتصأحوأىەأضىۏأۄەأ؏أتضأڬەأثتشەأوۏڽأحوأضەأځۄهەأوۏڽأثہۏأڬډہأىۄۏڽأدتىحتأحہتأهۏڬىأتۏڬأثتحأۏتزأشڬہًأ؏أوضهوتىأڬۏأغشلأضەأتزىۏٳأضەأتزىۏٳأطرظأثہۏأ+أڬضۏأڬتلشأڬًأ"
"6844","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أوۏڽأىەأشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأذعشحأصۏىثأشعۏأتههۄأؼىۄتأڬًأشۏطوأڬتأهثتضأصۏىثأحىأڬۏەأۄًةەأزۏڬہتأۗ"
"6845","أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأذعشحأصۏىثأشعۏأتههۄأؼىۄتأڬتأًظتهأوثتشڬأۄًتأ؏أشضًهأتههۄأ﷽أتىأڬەأدىتصەأڬەأضتحہأىڬهەأ؏أۄوأإځأ﷽أڬەأۄوشتۄأىڬهەأ؏أۄوأىەأشضًهأتههۄأ﷽أڬًأثۄحأؽوڲۏىأتًشأځشۏطتىأزۏڬہتأ؏أدثأىثۏأتڬشوأ﷽أ؏أذعشحأصۏىثأڬۏأمثشأوۏڽأتحشەأ؏أإځأمثشأضەأثتۄشأحطشۏلأهتةەأحًأإځأڬەأډۄشەأڬۏأشىڲحأثزهۏأۄًةۏأحہۏأ؏أۄوأىەأتضأثتشەأوۏڽأځًډہتأحًأإځأ﷽أىەألشوتۏتأ=أوۏشۏأۏۄأثۏټۏأثۄحأثۏوتشأشۄحۏأحہۏڽأ؏أودہەأوًحأڬۏأطزحأتًشأمثشأڬۏأحىڲۏأۏتزأإةۏأ؏أوۏڽأىەأزؼتأوتىڲۏأڬۄأتههۄأحؼتهۏٳأتضأځشأإضتىۏألشوتأزەأۗأ"
"6846","أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأزًأضتهأڬەأثؼزأځۄهەأىڬتذأڬۏأثىتؤأځشأذعشحأصۏىثأڬًأتىأڬەأطًۄشأتثًتهؼتظأڬەأځتضأثہۏدأزۏتأ؏أىۏتأذمأوۄشأثہۏأومششأىۄۏڽأڬۏتأحہتأۗأ"
"6847","أذعشحأؼشًۄأثۏتىأڬشحەأۄۏڽأ=أذثطۄأڬۏأدتىثأځۄهۏأۄدشحأوۏڽأذعشحأدؼلشأتًشأتىأڬەأضتحہۏًڽأڬەأۄدشحأڬشىەأضەأځۄهەأذعشحأؼخوتىأثىأؼلتىأشعۏأتههۄأؼىۄأىەأذعشحأشمۏۄأشعۏأتههۄأؼىۄتأڬًأۄوشتۄأهەأڬشأۄدشحأڬۏأحہۏأۗأ"
"6848","أؼثزتههۄأثىأوذوزأثىأضهۏوتىأثىأدؼلشأۄتطوۏألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأذعشحأشمۏۄأشعۏأتههۄأؼىۄتأشضًهأتههۄأ﷽أڬۏأًهتزحأڬەأ66أًۏڽأضتهأځۏزتأۄًةۏڽأۗأ"
"6849","أذعشحأضؼزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأذعشحأؼخوتىأثىأؼلتىأشعۏأتههۄأؼىۄأىەأذثطۄأڬۏأدتىثأۄدشحأڬتأتشتزۄأڬۏتأحًأشضًهأتههۄأ﷽أىەأتىأضەأڬۄتأ=أشمۏۄأڬًأثہۏأتځىەأضتحہأهەأدتاأ؏أوۏڽأضًډأشۄتأۄًڽأڬۄأحوأوۏڽأضەأڬًةۏأتۏڬأ؏أزًضشەأځشأظثشأڬشەأڲتأۗأځہشأىثۏأتڬشوأ﷽أىەأذعشحأتضوتؤأثىحأتثًثڬشأشعۏأتههۄأؼىۄتأڬًأتىأڬۏأرۏشۏحأزشۏتلحأڬشىەأڬەأهةەأثہۏدتأ؏أذعشحأتضوتؤأىثۏأتڬشوأ﷽أڬەأځتضأدثأًتځضأإةۏڽأحًأتضأًمحأذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأثہۏأشضًهأتههۄأ﷽أڬەأځتضأثۏټہەأۄًةەأحہەأ؏أذعشحأتضوتؤأشعۏأتههۄأؼىۄتأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أتىۄًڽأىەأتځىتأځتهتىأڋتهتأۄًتأڲزہتأىڬتهتأتًشأذعشحأشمۏۄأڬًأتضأځشأضًتشأڬۏتأتًشأزشۏتأڬۏأدتىثأشًتىۄأۄًأڲةەأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أتەأتثًثڬشأ$أذعشحأهًغأؼهۏۄأتهضهتوأتًشأذعشحأتثشتۄۏوأؼهۏۄأتهضهتوأڬەأثؼزأۏۄأځۄهەأۄدشحأڬشىەأًتهەأۄۏڽأۗأ"
"6850","%أتثىأتضذتمأڬۄحەأۄۏڽأ=أذعشحأشمۏۄأشعۏأتههۄأؼىۄتأصىزۄأشۄۏڽأ؏أذحۏٳأڬۄأذعشحأؼخوتىأشعۏأتههۄأؼىۄأىەأتىأڬەأضتحہأىڬتذأڬۏتأ؏أذعشحأشمۏۄأشعۏأتههۄأؼىۄتأضەأتۏڬأهڔڬتأځۏزتأۄًتأ؏أدضأڬتأىتوأ““أؼثزتههۄأ‛‛أشڬہتأ؏أهۏڬىأۏۄأثډۄأثډځىأوۏڽأۄۏأتىحمتهأڬشأڲۏتأحہتأ؏أتضۏأثډەأڬۏأىضثحأضەأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬۏأڬىۏحأ““أتثًؼثزتههۄأ‛‛أۄًةۏأۗأتثىأتضذتمأڬۄحەأۄۏڽأۗأودہەأتۏڬأتۄهأؼهوأطرظأىەأۏۄأثتحأثحتةۏأۄەأڬۄأذثطًڽأڬەأڬډہأهًڲًڽأىەأذعشحأشمۏۄأثىحأشضًهأتههۄأ﷽أڬًأزۏڬہتأ؏أًۄأتضأًمحأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬەأځتضأحہۏڽأ؏أإځأثۄحأذضۏىأًأدوۏهأحہۏڽأ؏أًۄأهًڲأذعشحأشمۏۄأڬەأذضىأځشأثۄحأذۏشتىأۄًحەأحہەأ؏أدثأىدتطۏأىەأتځىەأزطوىأځشأډڔہتةۏأڬۏأحًأۏۄأهًڲأتضأوؼشڬۄأوۏڽأوتشەأڲةەأحہەأۗ"
"6851","أۄطتوأثىأؼشًۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأذعشحأشمۏۄأشعۏأتههۄأؼىۄتأثۏوتشأحہۏأ؏أىثۏأتڬشوأ﷽أؽصًۄأثزشأڬەأهةەأشًتىۄأۄًةەأحًأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬًأتًشأذعشحأصۏزأشعۏأتههۄأؼىۄأڬًأتىأڬۏأزۏڬہأثہتهأڬەأهةەأډہًڔأڲةەأحہەأ؏أځہشأذعشحأصۏزأثىأذتشخۄأشعۏأتههۄأؼىۄأ؏أشضًهأتههۄأ﷽أڬۏأؼعثتؤأتًىټىۏأځشألحذأڬۏأىًۏزأهەأڬشأإةەأ؏أذعشحأشمۏۄأڬتأتىحمتهأۄًأڲۏتأحہتأ؏أۄوأىەأزطوىأڬۏأتۏڬأصًشأزتشأإًتصأڬًأضىتأتًشأرزأڬۏأمضوأ$أۄوأىەأتىأڬۏأثطتشحأڬۏأحظزۏمأىۄۏڽأڬۏأدثأحڬأۄوأىەأمۏزۏًڽأڬًأىۄۏڽأزۏڬہأهۏتأۗأ"
"6852","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأذعشحأشمۏۄأشعۏأتههۄأؼىۄتأڬتأتىحمتهأۄًتأحًأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أتىأڬۏأمثشأوۏڽأتۏضتأڬًةۏأطرظأىۄأتحشەأ؏أدضأىەأڲصطحۄأشتحأتځىۏأثۏًۏأضەأۄوثضحشۏأڬۏأۄەأۗأحًأذعشحأؼخوتىأشعۏأتههۄأؼىۄأمثشأوۏڽأىۄۏڽأتحشەأحہەأۗ"
"6853","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأ+أذعشحأشمۏۄأشعۏأتههۄأؼىۄتأ"
"6854","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأتًشأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬۏأصًدۄأذعشحأشمۏۄأشعۏأتههۄأؼىۄتأڬۏأرزوحأوۏڽأذتعشأۄًتأ؏أتىأڬەأۄتحہأوۏڽأڬىڲہۏأحہۏأ؏أتىۄًڽأىەأڬۄتأ=أشضًهأتههۄأ﷽أوۏشەأځتضأضەأتثہۏأڲةەأۄۏڽأ؏أوۏڽأتىأڬەأضشأوۏڽأڬىڲہۏأڬشأشۄۏأحہۏأ؏أذعًشأ﷽أىەأودہأضەأځًډہتأحہتأڬۄأحوأ““أتثًؼثزتههۄأ‛‛أڬًأڬۏضتأځتحۏأۄًأآأوۏڽأىەأڬۄتأ=أضثأټہۏڬأۄەأ؏أتثتأدتىأىەأودہەألشوتۏتأ=أتضأڬۏأؼصحأًأحڬشۏوأڬۏتأڬشًأ؏أڬۏًىڬۄأترهتمأڬەأهذتػأضەأًۄأحوتوأظذتثۄأضەأصۏتزۄأوۏشەأضتحہأوطتثۄحأشڬہحتأۄەأۗ"
"6855","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأتًشأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬۏأصًدۄأذعشحأشمۏۄأشعۏأتههۄأؼىۄتأڬۏأرزوحأوۏڽأذتعشأۄًتأ؏أتىأڬەأۄتحہأوۏڽأڬىڲہۏأحہۏأ؏أتىۄًڽأىەأڬۄتأ=أشضًهأتههۄأ﷽أوۏشەأځتضأضەأتثہۏأڲةەأۄۏڽأ؏أوۏڽأتىأڬەأضشأوۏڽأڬىڲہۏأڬشأشۄۏأحہۏأ؏أذعًشأ﷽أىەأودہأضەأځًډہتأحہتأڬۄأحوأ““أتثًؼثزتههۄأ‛‛أڬًأڬۏضتأځتحۏأۄًأآأوۏڽأىەأڬۄتأضثأټہۏڬأۄەأ؏أتثتأدتىأىەأودہەألشوتۏتأ=أتضأڬۏأؼصحأًأحڬشۏوأڬۏتأڬشًأ؏أڬۏًىڬۄأترهتمأڬەأهذتػأضەأًۄأحوتوأظذتثۄأضەأصۏتزۄأوۏشەأضتحہأوطتثۄحأشڬہحتأۄەأۗ"
"6856","أتثىأطۄتثأڬۄحەأۄۏڽأ=أۄوۏڽأشًتۏحأۏًىۄۏأوهۏأۄەأ+أإڲەأذمۏمحأذتهأڬًأ"
"6857","أوظؼثأثىأؼثزتههۄأصثۏشۏأثۏتىأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأذعشحأتوأڬهخًوأشعۏأتههۄأؼىۄتأڬتأتظهأىتوأ““أتوۏۄأ‛‛أحہتأۗأذعشحأشمۏۄأشعۏأتههۄأؼىۄتأڬۏأًلتحأڬەأثؼزأوتۄأشثۏؼأتهتًهأوۏڽأشضًهأتههۄأ﷽أىەأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬەأضتحہأ““أتوأڬهخًوأ‛‛أڬتأىڬتذأڬشأزۏتأحہتأ؏أ;أۄدشۏأڬًأدوتزۏأتهتًهۏٳأوۏڽأشرظحۏأۄًةۏأۗأذعشحأتوأڬهخًوأشعۏأتههۄأؼىۄتأڬتأًظتهأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬۏأصًدۏحأۄۏأوۏڽأوتۄأطؼثتىأتهوؼػوأضىأ<أۄدشۏأڬًأۄًتأۗأتوأؼغۏۄأتىظتشۏۄأشعۏأتههۄأؼىۄتأىەأتىظتشۏأرًتحۏىأڬۏأوًدًزڲۏأوۏڽأتىأڬًأؽضهأزۏتأحہتأۗأ"
"6858","%أۏذۏۏأثىأضؼۏزألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأذعشحأشمۏۄأشعۏأتههۄأؼىۄتأڬەأًظتهأڬەأثؼزأذعشحأؼخوتىأشعۏأتههۄأؼىۄأىەأتوأڬهخًوأثىحأشضًهأتههۄأ﷽أضەأىڬتذأڬۏتأۗ"
"6859","أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأدثأشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأذعشحأشمۏۄأشعۏأتههۄأؼىۄتأڬتأتىحمتهأۄًأڲۏتأحًأذعشحأؼوشأشعۏأتههۄأؼىۄأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬەأځتضأڲةەأتًشأځًډہتأ=أڬۏتأإځأڬًأوۏشۏأثۏټۏأذلظۄأوۏڽأڬًةۏأزهډضځۏأۄەأآأذعشحأؼخوتىأشعۏأتههۄأؼىۄأىەأتىأڬًأڬًةۏأرتغشأرًتۄأدًتثأىۄأزۏتأ؏أذعشحأؼوشأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬەأځتضأإةەأتًشأضتشۏأثتحأثحتةۏأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أتەأؼوشأ$أۄًأضڬحتأۄەأڬۄأتههۄأحؼتهۏٳأحدہەأتۏضتأزتوتزأؼغتأڬشأزەأدًأؼخوتىأضەأثہۏأثۄحشأۄًأ؏أحًأشضًهأتههۄأ﷽أىەأذعشحأؼوشأشعۏأتههۄأؼىۄأڬۏأظتذثصتزۏأضەأرًزأىڬتذأڬشأهۏتأتًشأتځىۏأثۏټۏأ““أتوأڬهخًوأ‛‛أڬتأىڬتذأذعشحأؼخوتىأشعۏأتههۄأؼىۄأضەأڬشأزۏتأۗأتضأضەأځۄهەأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأتًشأذعشحأؼوشأشعۏأتههۄأؼىۄأشضًهأتههۄأ﷽أضەأ““أتوأڬهخًوأ‛‛أڬتأشطحۄأوتىڲأډڬەأحہەأۗأهۏڬىأشضًهأتههۄأ﷽أىەأتىأڬًأ““أتوأڬهخًوأ‛‛أڬتأشطحۄأىۄۏڽأزۏتأۗأشضًهأتههۄأ﷽أىەألشوتۏتأ=أؼخوتىأڬەأهةەأثۄحشۏىأضلتشطأۏۄأۄەأڬۄأتځىۏأثۏټۏًڽأڬتأىڬتذأوۏڽأرًزأىۄۏڽأڬشحتأثهڬۄأتىأڬتألۏظهۄأرًزأشثأسًتهدهتهأڬشحتأۄەأۗأ"
"6860","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أذعشحأؼخوتىأثىأؼلتىأشعۏأتههۄأؼىۄأضەأوهەأ؏أذعشحأؼخوتىأشعۏأتههۄأؼىۄأتضأًمحأځشۏطتىأحہەأۗأىثۏأتڬشوأ﷽أىەأځشۏطتىۏأڬۏأًدۄأځًډہۏأحًأذعشحأؼخوتىأىەأدًتثتَأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أوۏشەأوتڽأثتځأإځأځشأمشثتىأۄًأدتةۏڽأ؏أدًأوظۏثحأودہەأإةۏأۄەأ؏أڬۏتأتۏضۏأوظۏثحأڬضۏأڬًأإأضڬحۏأۄەأآأشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأڬتأًظتهأۄًأڲۏتأۄەأ+أتههۄأحؼتهۏٳأتىأځشأشذوحأىتصهألشوتةەأ"
"6861","%أؼثۏزأثىأتثۏأصۏتزأثۏتىأڬشحەأۄۏڽأڬۄأوۏڽأىەأصۄشۏأضەأځًډہتأ=أڬۏتأؼًشحۏڽأشۏطوأځۄىأضڬحۏأۄۏڽأۏتأىۄۏڽأآأحًأتىۄًڽأىەأذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأڬتأۏۄأثۏتىأودہەأضىتۏتأڬۄأ““أتىۄًڽأىەأشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأ““أذعشحأتوأڬهخًوأ‛‛أڬًأزہتشۏأزتشأشۏطوۏأډتزشأتًڔہەأۄًةەأزۏڬہتأۗ"
"6862","أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأثۏتىأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأ““أذعشحأتوأڬهخًوأشعۏأتههۄأؼىۄتأ‛‛أىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أوۏشتأطًۄشأثۄحشأۄەأۏتألتغوۄأڬتأآأإځألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أڬډہأزۏشأرتوًطأشۄەأ؏أځہشألشوتۏتأ=أحۏشتأطًۄشأتىأوۏڽأضەأۄەأدًأتههۄأتًشأتضأڬەأشضًهأضەأوذثحأڬشحەأۄۏڽأتًشأتههۄأتًشأتضأڬتأشضًهأتضأضەأوذثحأڬشحەأۄۏڽأ؏أذعشحأتوأڬهخًوأشعۏأتههۄأؼىۄتأًتځضأډهۏأڲةۏڽأۗأشضًهأتههۄأ﷽أىەأتىأڬًأًتځضأثهًتأڬشأځًډہتأ=أوۏڽأىەأتثہۏأتثہۏأڬۏتأڬۄتأ=أوۏڽأىەأڬۄتأ=أإځأىەأتشطتزألشوتۏتأۄەأڬۄأ““أوۏشتأطًۄشأتىأهًڲًڽأوۏڽأضەأۄەأدًأتههۄأتًشأتضأڬەأشضًهأضەأوذثحأڬشحەأۄۏڽأتًشأتههۄأتًشأتضأڬتأشضًهأتضأضەأوذثحأڬشحەأۄۏڽأۗأإځأ﷽أىەألشوتۏتأ=أټہۏڬأۄەأۗأوصۏزأۏۄأثہۏأڬۄأ““أوۏڽأدىحأوۏڽأزترهأۄًتأ؏أوۏڽأىەأتضأڬتأًۄأومتوأزۏڬہتأۄەأڬۄأوۏشەأظذتثۄأوۏڽأضەأڬًةۏأثہۏأتضأضەأتًځشأًتهەأومتوأځشأىۄۏڽأحہتأۗأ"
"6863","أذعشحأؼشًۄأثىأصثۏشألشوتحەأۄۏڽأ=أذعشحأؼثزتهوغهثأڬۏأظتذثصتزۏًڽأوۏڽأضەأظشلأ““أذعشحأظلۏۄأشعۏأتههۄأؼىۄتأ‛‛أىەأتضهتوأڬًأځتۏتأ؏أذعشحأؼشًۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتىأڬەأهةەأزۄشتأذظۄأشڬہتأحہتأ؏أإځأذعشحأذوصۄأشعۏأتههۄأؼىۄأڬۏأذمۏمۏأثۄىأۄۏڽأۗأ"
"6864","أضؼۏزأثىأڬخۏشأثىأؼلۏشألشوتحەأۄۏڽأ=أذعشحأصثۏشأثىأؼًتوأشعۏأتههۄأؼىۄأڬۏأًتهزۄأ““أذعشحأظلۏۄأثىحأؼثزتهوغهثأشعۏأتههۄأؼىۄتأ‛‛أڬتأًظتهأ53أۄدشۏأڬًأۄًتأ؏أتىأڬۏأؼوشأ:6أثشضأحہۏأ؏أذعشحأؼوشأشعۏأتههۄأؼىۄأىەأتىأڬۏأىوتصأدىتصۄأځڔہتةۏأتًشأدىحأتهثمۏؼأوۏڽأتىأڬًأزلىأڬۏتأڲۏتأۗأ"
"6865","أوذوزأثىأؼوشأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أظلۏۄأثىحأؼثزتهوغهثأثىأۄتطوأ‛‛أتىأڬۏأًتهزۄأ““أۄتهۄأثىحأًۄۏثأثىأؼثزأوىتلأثىأصۄشۄأثىأڬهتثأ‛‛أۄۏڽأۗأإځأذعشحأذوصۄأثىأؼثزتهوغهثأشعۏأتههۄأؼىۄأڬۏأترۏتلۏأ+أوتڽأطشۏڬأ"
"6866","%أذعشحأظلۏۄأثىحأؼثزتهوغهثألشوتحۏأۄۏڽأڬۄأدىڲأرىزمأڬەأوًمؼأځشأشضًهأتههۄأ﷽أىەأتځىۏأتصًتدأڬًألتشؼأىتوۏأمهؼۄأوۏڽأشڬہتأحہتأۗ"
"6867","%أؼشًۄألشوتحەأۄۏڽأ=أذعشحأظلۏۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أوۏڽأًۄأضثأضەأځۄهۏأؼًشحأۄًڽأ؏أدضأىەأڬضۏأوشزأڬًأمحهأڬۏتأ؏أوۏڽأذضتىأثىأختثحأڬەألتشؼأمهؼۄأوۏڽأحہۏأ؏أدىڲأرىزمأڬەأوًمؼأځشأذعشحأذضتىأثہۏأؼًشحًڽأتًشأثډًڽأڬەأۄوشتۄأمهؼەأوۏڽأحہەأ؏أذعشحأظلۏۄألشوتحۏأۄۏڽأ=أۄوتشەأځتضأضەأتۏڬأۏۄًزۏأطرظأڲصشتأ؏أتًشأًۄأمهؼەأڬەأتشزڲشزأڲہًوىەأهڲأڲۏتأ؏أوۏڽأىەأذضتىأضەأڬۄتأ؏أإځأزۏڬہأشۄەأۄًأ؏أۏۄأۏۄًزۏأمهؼەأڬەأڲشزأڲہًوأشۄتأۄەأ؏أودہەأرزطۄأۄەأڬۄأۏۄأطرظأۄوأؼًشحًڽأڬۏأورثشۏأڬشأزەأڲتأ؏أدثأڬۄأشضًهأتههۄأ﷽أدىڲأوۏڽأوظشًلأۄۏڽأ؏أحوأتټہًأتًشأتضأڬًأمحهأڬشأڋتهًأ؏أذعشحأذضتىأىەأڬۄتأ=أتەأؼثزتهوغهثأڬۏأثۏټۏأ$أتههۄأحؼتهۏٳأحوۄتشۏأوؽلشحأڬشەأ؏أتههۄأڬۏأمضوأ$أإځأحًأدتىحۏأۄۏڽأڬۄأوۏڽأتحىۏأدشئحأىۄۏڽأشڬہحتأۄًڽأ؏أذعشحأظلۏۄألشوتحۏأۄۏڽأ=أدثأذضتىأىەأۏۄأثتحأڬۄۏأتًشأودہەأتضأڬەأځتضأڬًةۏأۄحہۏتشأثہۏأىػشأىۄأإۏتأ؏أوۏڽأىەأمهؼۄأڬتأتۏڬأضحًىأتټہتأهۏتأ؏أځہشأوۏڽأمهؼەأضەأىۏډەأتحشۏأتًشأًۄۏأضحًىأتضأڬًأزەأوتشتأتًشأتضأۏۄًزۏأڬًأمحهأڬشأزۏتأ؏أځہشأوۏڽأمهؼەأوۏڽأًتځضأإةۏأ؏أوۏڽأىەأڬۄتأ=أتەأذضتىأ$أىۏډەأتحشًأتًشأتضأڬتأضتصًضتوتىأتحتشأهًأ؏أڬۏًىڬۄأوۏڽأؼًشحأستحأۄًأڬشأتضأوشزأڬتأضتوتىأتحتشًڽأ؏أۏۄأتډہتأىۄۏڽأهڲحتأ؏أذعشحأذضتىأىەأڬۄتأ=أودہەأتضأڬەأضتوتىأڬۏأڬًةۏأعشًشحأىۄۏڽأۄەأۗ"
"6868","أثشۄأثىحأتثۏأحدشتۆألشوتحۏأۄۏڽأ=أمشۏطأىوتصأػۄشأڬتأتىڬتشأىۄۏڽأڬشحەأحہەأ؏أًۄأحًأًمحأڬتأتىڬتشأڬشحەأحہەأ؏أدثأؼظشأڬتأًمحأإحتأحًأًۄأهًڲأڲہتټۏًڽأوۏڽأډهەأدتحەأتًشأتڬۏهەأتڬۏهەأىوتصأځڔہأهۏحەأ؏أډىتىډۄأغهۏثأثىأؼوۏشأتًشأتذتغثأثىأؼثزطوضأتدىتزأڬۏأڲہتټۏأوۏڽأڲةەأًۄتڽأىوتصأځڔہأشۄەأحہەأتًشأتۏڬأزًضشەأڬًأزۏڬہأثہۏأشۄەأحہەأ؏أڬۄأتډتىڬأتثىأتهتظۏزۏأتًشأتثىأتهمثغۏۄأىەأتىأځشأذوهۄأڬشأزۏتأۗأۏۄأزًىًڽألذتطأإزوۏأحہەأ؏أتىۄًڽأىەأڬډہأزۏشأتىأځشأضىڲثتشۏأڬۏأتًشأځہشأتثًدۄهأتًشأتثًهۄثأتًشأؼمثۄأثىأتثۏأوؼۏغأڬەأځتضأًتځضأډهەأڲةەأتًشأتىأڬًأضتشۏأثتحأضىتةۏأ؏أًۄأهًڲأظثذأضًۏشەأوىۄأتىزہۏشەأتىأڬۏأغشلأىڬهەأ؏أتىأهًڲًڽأىەأًعًأڬۏتأتًشأىوتصأځڔہۏأ؏أتۏڬأزىأًۄأهًڲأتځىۏأڲہتټۏأوۏڽأحہەأڬۄأتثًدۄهأ؏أؼمثۄأ؏أتثًهۄثأتًشأډىزأزۏڲشأثەأًمًلًڽأىەأتىأځشأذوهۄأڬشأزۏتأ؏أتًشأتىأڬًأڲشلحتشأڬشأهۏتأ؏أشضًهأتههۄأ﷽أڬەأظذتثۄأڬشتوأىەأتځىتأتضهتوأػتۄشأڬشأزۏتأ؏أتىأڬًأإًتصأزۏأتًشأرًزأڬتأزلتؼأڬۏتأ؏أغهۏثأثىأؼوۏشأىەأتثًدۄهأځشأذوهۄأڬۏتأتًشأتضأڬًأصروۏأڬشأزۏتأ؏أتضأڬًأځڬڔأڬشأثتىزہأهۏتأ؏أتثًهۄثأتټہتأتًشأتضأىەأتضأڬًأڬہًهأزۏتأ؏أًۄأتضأڬتأثہحۏدتأحہتأۗأتشًۏٳأثىحأؼثزتهوغهثأضەأڬۄتأڲۏتأ=أحوۄتشتأڬۏتأرۏتهأۄەأ؏أحوۄتشەأثۏټەأغهۏثأىەأوذوزأ﷽أڬۏأتحثتؼأڬشأهۏأۄەأتًشأًۄأوذوزأڬتأوذتلػأثىأڲۏتأۄەأ؏أذعشحأتشًۏٳأشعۏأتههۄأؼىۄتأتضأًمحأتضهتوأهتأډڬۏأحہۏڽأ؏أتىۄًڽأىەأڬۄتأ=أغهۏثأڬۏأصىزڲۏأڬتأضثأضەأمۏوحۏأزىأًۄۏأحہتأدضأزىأًۄأتځىەأوتوًڽأڬەأثۏټەأڬتأزلتؼأڬشأشۄتأحہتأ؏أځہشأتههۄأحؼتهۏٳأڬۏأثتشڲتۄأضەأذمأإأڲۏتأ؏أتىۄًڽأىەأځًډہتأ=أتًشأڬۏتأحًأىەأثہۏأوذوزأ﷽أڬۏأتحثتؼأڬشأهۏأۄەأآأتىۄًڽأىەأڬۄتأ=أدۏأۄتڽأۗأتۏڬأإزوۏأًۄتڽأضەأتثًهۄثأڬەأځتضأڲۏتأتًشأتضأڬًأضتشەأوؼتوهۄأڬۏأرثشأزۏأ؏أتثًهۄثأذعشحأتشًۏٳأشعۏأتههۄأؼىۄتأڬەأځتضأإۏتأتًشأڬۄىەأهڲتأ=أثۄحأحؼدثأۄەأحدہأځشأتًشأتضأثتحأځشأڬۄأحًأىەأوذوزأ﷽أڬۏأتحثتؼأڬشأهۏأۄەأ؏أتًشأتضأثتحأځشأڬۄأحًأىەأتځىەأإثتؤأًأتدزتزأڬتأزۏىأډہًڔأزۏتأۄەأ؏أتىۄًڽأىەأڬۄتأ=أدۏأۄتڽأتۏضتأۄۏأۄەأۗأحًأتټہأتًشأتځىەأثہحۏدەأڬًأځڬڔأتًشأتضأڬًأشًڬأ؏أڬۏًىڬۄأتڲشأتضأڬۏأثتحأػتۄشأۄًأڲةۏأحًأحدہەأترحۏتشأۄًأڲتأ؏أتڲشأحوأتضأڬەأضتحہأزترهأۄًىتأډتۄًأحًأحثأثہۏأټہۏڬأۄەأتًشأتڲشأحوأتځىەأزۏىأځشأمتةوأشۄىتأډتۄًأحًأثہۏأټہۏڬأۄەأ؏أتڲشډۄأحًأىەأتځىەأثہحۏدەأڬتأؼسشأمثًهأىۄۏڽأڬۏتأۗأتىۄًڽأىەأڬۄتأ=أتًشأۄوتشەأځتضأؼشثأڬۏأدوؼۏحأڬۏأغتمحأۄەأۗأځہشأًۄأڬۄىەأهڲەأ=أًۄأتۏڬأىۏتأزۏىأهتۏتأۄەأ؏أځہشأتثًهۄثأًتځضأإأڲۏتأۗأ"
"6869","أتوتوأتذوزأثىأذىثهألشوتحەأۄۏڽأ=““أتوأۄتىۏأثىحأتثۏأغتهثأ‛‛أڬتأتظهأىتوأ““أۄىزأ‛‛أۄەأۗأتىأڬۏأًتهزۄأ““ألتغوۄأثىحأتضزأثىأۄتطوأ‛‛أۄۏڽأۗأتوتوأتثًؼثزتههۄأىەأ““أذعشحأتوأۄتىۏأ‛‛أڬتأۏۄۏأىتوأثۏتىأڬۏتأۄەأ؏أتضأثتشەأوۏڽأشًتۏتحأذزأحًتحشأحڬأځۄىډۏأۄًةۏأۄۏڽأڬۄأتوأۄتىۏأڬتأىتوأ““ألترحۄأ‛‛أۄەأۗأ"
"6870","أذعشحألترحۄأ+أتوأۄتىۏأثىحأتثۏأغتهثأ"
"6871","أوذوزأثىأؼوشألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأىصًهأًذۏأضەأځۄهەأتځىەأډډتأتثًغتهثأضەأ+أتىأڬۏأثۏټۏأ"
"6872","%أذعشحأتوأۄتىۏأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أىەأودہەأځۏؽتوأىڬتذأثہۏدتأ؏أوۏڽأىەأوؼسشحأڬشأهۏأ؏أذعًشأ﷽أىەأوۏشۏأوؼسشحأمثًهألشوتأهۏأ؏أځہشأتههۄأحؼتهۏٳأىەأۏۄأإۏتحأىتصهألشوتةۏڽأۗ"
"6873","%أؼثزتههۄأثىأذتشخأڬۄحەأۄۏڽأ=أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأډتطحأىۄأځڔہحەأ؏أۏۄتڽأحڬأڬۄأۄوأتىأڬًأذعشحأتوأۄتىۏأڬەأځتضأهەأدتحەأۗأوۏڽأىەأذعشحأتوأۄتىۏأشعۏأتههۄأؼىۄتأضەأڬۄتأ=أتثىأؼثتضأشعۏأتههۄأؼىۄوتأڬًأثہۏأًۄأثحتاأدًأإځأۄوۏڽأثحتۏتأڬشحۏأۄًأ؏أذعشحأتوأۄتىۏأشعۏأتههۄأؼىۄتأىەأڬۄتأ=أشضًهأتههۄأ﷽أوۏشەأڲہشأوۏڽأزترهأۄًةەأتًشأډتطحأڬۏأ;أشڬؼحۏڽأځڔہۏڽأۗأذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأًۄتڽأضەأىڬهەأحًأۏۄألشوتأشۄەأحہەأ““أوۏڽأىەأځًشتأمشإىأځڔہتأۄەأوۏڽأحًأتطشتمأڬۏأىوتصأظشلأتۏڬأضتؼحأضودہحتأۄًڽأ؏أمشإىأڬشۏوأوۏڽأۄەأۗ"
"6874","أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأذعشحأتوأۄتىۏأثىحأتثۏأغتهثأثۏتىأڬشحۏأۄۏڽأڬۄأتىۄًڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أوۏشتأثہتةۏأؼهۏأشعۏأتههۄأؼىۄأتضأإزوۏأڬًأمحهأڬشىتأډتۄحتأۄەأدضأڬًأوۏڽأىەأځىتۄأزۏأۄەأ؏أحًأشضًهأتههۄأ﷽أىەألشوتۏتأ=أدضأڬًأحوأىەأځىتۄأزۏأ؏أًۄأۄوتشۏأغشلأضەأثہۏأځىتۄأۏتلحۄأۄەأۗأ"
"6875","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأذعشحأتوأۄتىۏأثىحأتثۏأغتهثأشعۏأتههۄأؼىۄتأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأۗأ+أًۄألشوتحۏأۄۏڽأ"
"6876","%أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أذعشحأتوأۄتىۏأشعۏأتههۄأؼىۄتأڬەأځتضأحطشۏلأهەأڲةەأ؏أتىأڬەأۄتڽأتۏڬأوطڬۏصۄأهټڬأشۄتأحہتأ؏أذعًشأ﷽أىەأڬہڔەأۄًأڬشأځتىۏأځۏتأۗأ+أهټڬحەأۄًةەأوطڬۏصەأضەأثۏټہأڬشأځتىۏأځۏىتأووڬىأىۄۏڽأۄەأتًشأطتۏزأتضأًمحأتضأڬًأتحتشىەأوۏڽأزمحأحہۏأ"
"6877","%أذعشحأدؼزۄأثىأۄثۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏشۏأًتهزۄأذعشحأتوأۄتىۏأثىحأتثۏأغتهثأثۏتىأڬشحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أثەأطڬأتههۄأحؼتهۏٳأىەأمۏشطأڬًأ:أًدًۄتحأڬۏأثىتؤأځشألعۏهحأزۏأۄەأ؏أًۄأډۏصۏڽأتىأضەأځۄهەأڬضۏأڬًأؼغتأىۄۏڽأۄًةۏڽأ؏أتًشأىۄأۄۏأتىأڬەأثؼزأڬضۏأڬًأىظۏثأۄًةۏڽأۗ"
"6878","أۏذۏۏأثىأدؼزۄأثىأۄثۏشۄأتځىۏأزتزۏأذعشحأتوأۄتىۏأشعۏأتههۄأؼىۄتأڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أوۏڽأشتحأڬەأًمحأتځىەأڲہشأڬۏأډہحأضەأشضًهأتههۄأ﷽أڬۏأمشتؤحأڬۏأإًتصأضىتأڬشحۏأحہۏأۗأ"
"6879","%أوذوزأثىأؼوشألشوتحەأۄۏڽأ=أذعشحأتشًۏٳأثىحأؼثزتهوغهثأشعۏأتههۄأؼىۄتأتضهتوأهتةۏأحہۏڽأۗ"
"6880","مصعب بن عبداللہ زبیری نے یہ حدیث نقل کی ہے ۔ \nالمستدرك على الصحيحين حدیث: 6880 عربی حدیث: 6880"
"6881","%أۄطتوأثىأؼشًۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأوۏڽأوشًتىأثىأذڬوأڬەأځتضأڲۏتأ؏أوۏڽأىەأتضأضەأڬۄتأ=أحوۄتشۏأتۏڬأشطحۄأزتشأرتحًىأڬًأغهتمأۄًأڲةۏأۄەأ؏أوۏڽأتضأڬەأځتضأڲۏتأ؏أًۄأتضأًمحأوىحمهأۄًأشۄۏأحہۏأ؏أوۏڽأىەأتضأځشأتضأڬۏأوسوحأڬۏأ؏أهًڲًڽأىەأڬۄتأ=أۄوۏڽألتغوۄأثىحأمۏضأىەأۏۄۏأذڬوأزۏتأۄەأتًشأتىۄًڽأىەأثحتۏتأۄەأڬۄأدثأتضأڬەأطًۄشأىەأتضأڬًأغهتمأزەأزۏأحہۏأحثأشضًهأتههۄأ﷽أىەأتىأڬًأۏۄأذڬوأزۏتأحہتأڬۄأًۄأتثىأتوأوڬحًوأڬەأځتضأډهۏأدتةەأۗأوشًتىأىەأڬۄتأ=أدۏأۄتڽأ؏ألتغوۄأثىحأمۏضأىەأتضأڬًأۏۄۏأذڬوأزۏتأحہتأۗأوۏڽأىەأڬۄتأ=أتههۄأڬۏأمضوأ$أؼتةطۄأىەأحًأثۄحأضرحأؼۏثأهڲتۏتأۄەأ؏أتًشأڬۄتأۄەأ=ألتغوۄأتځىەأطًۄشأڬەأضتحہأتۏڬأًۏشتىأضەأڲہشأوۏڽأشۄحۏأحہۏأ؏أتضأڬًأتۏضەأڲہشأوۏڽأتڬۏهەأډہًڔىتأرغشەأضەأرتهۏأىۄأحہتأۗأتضأهةەأشضًهأتههۄأ﷽أىەأتىأڬًأ+أتثىأتوأوڬحًوأڬۏأغشلأوىحمهأۄًىەأڬۏأ"
"6882","أؼثزتهشذوىأثىأؼتظوأثىأختثحأثۏتىأڬشحەأۄۏڽأڬۄأ““ألتغوۄأثىحأمۏضأ+أعذتڬأثىأمۏضأڬۏأثۄىأ"
"6883","%أذعشحألتغوۄأثىحأمۏضأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أوۏڽأىەأشضًهأتههۄأ﷽أضەأوضحذتعۄأ+أًۄأؼًشحأدضأڬًأثەأًمحأرًىأإحتأشۄحتأۄەأ"
"6884","%أتوأتهوًوىۏىأذعشحأتوأضهوۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أذعشحألتغوۄأثىحأمۏضأشعۏأتههۄأؼىۄتأشضًهأتههۄأ﷽أڬەأځتضأإةۏڽأتًشأڬۄىەأهڲۏڽأ=أودہەأذۏعأإحتأۄەأ؏أإځأ﷽أىەألشوتۏتأ=أًۄأذۏعأىۄۏڽأۄەأًۄأحًأثۏوتشۏأڬتأرًىأۄەأ؏أحوأتځىەأذۏعأڬەأتۏتوأطوتشأڬشأڬەأتحىەأزىأىوتصأشًصۄأىۄۏڽأڬۏتأڬشًأ؏أځہشأؽضهأڬشأڬەأڬضۏأڬځڔەأڬتأهىڲًټأثتىزہأڬشأ+أۏؼىۏأځۏڋأًؽۏشۄأشڬہأڬشأ؏أڬځڔەأځۄىأڬشأ"
"6885","أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أذعشحألتغوۄأثىحأمۏضأشعۏأتههۄأؼىۄتأىەأىثۏأتڬشوأ﷽أضەأوضةهۄأزشۏتلحأڬۏتأڬۄأوۏڽأودہەأوضهضهأذۏعأإحتأشۄحتأۄەأ؏أوۏڽأځتڬأۄًحۏأۄۏأىۄۏڽأۄًڽأ؏أحًأڬۏتأوۏڽأىوتصأډہًڔتأڬشًڽأآأإځأ﷽أىەألشوتۏتأ=أًۄأثۏوتشۏأڬتأرًىأۄەأ؏أًۄأذۏعأىۄۏڽأۄەأۗأ+أىوتصأڬەأځًشەأًمحأڬەأهةەأ"
"6886","أمشۏطأڬۏأظذتثۏتحأوۏڽأ““أذعشحأطلتؤأثىحأؼثزتههۄأشعۏأتههۄأؼىۄتأۄۏڽأ؏أإځأضهۏوتىأثىأتثۏأذخوۄأمشطۏأشعۏأتههۄأؼىۄأڬۏأًتهزۄأۄۏڽأتًشأتثًثڬشأثىأضهۏوتىأثىأتثۏأذخوۄأشعۏأتههۄأؼىۄأڬۏأزتزۏأۄۏڽأۗأ"
"6887","أوذوزأثىأؼوشألشوتحەأۄۏڽأ=أتًشأطلتؤأثىحأؼثزتههۄأشعۏأتههۄأؼىۄتألحذأوڬۄأضەأځۄهەأتضهتوأهتةۏڽأتًشأشضًهأتههۄأ﷽أڬۏأثۏؼحأڬۏأۗأ"
"6888","%أتثًثڬشأثىأضهۏوتىأثىأتثۏأذخوۄأمشطۏأشذوۆأتههۄأؼهۏۄأتۏڬأتىظتشۏأڬەأثتشەأوۏڽأثۏتىأڬشحەأۄۏڽأڬۄأتضأڬًأډۏًىټۏأىەأڬتټأهۏتأ؏أڬضۏأىەأتضأڬًأثحتۏتأڬۄأطلتؤأثحأؼثزتههۄأشعۏأتههۄأؼىۄتأډۏًىټۏأڬەأڬتټەأڬتأزوأڬشحۏأۄەأ؏أًۄأذعشحأطلتؤأثىحأؼثزتههۄأڬەأځتضأإأڲةەأ؏أتًشأتىأضەأزوأڬشىەأڬتأڬۄتأ؏أ+أتىۄًڽأىەأوؼسشحأڬشحەأۄًةەأڬۄتأ=أ"
"6889","أڬشۏثأثىأضهۏوتىأتهڬىزۏألشوتحەأۄۏڽأ=أؼهۏأثىأذضۏىأثىأؼهۏأشعۏأتههۄأؼىۄوتأىەأوۏشتأۄتحہأځڬڔتأتًشأثىۏأصۄشۄأضەأحؼهمأشڬہىەأًتهەأتۏڬأمشطۏأإزوۏأڬەأځتضأودہەأهەأڲةەأ؏أتضأإزوۏأڬًأتثىأتثۏأذخوۄأڬەأىتوأضەأځڬتشتأدتحتأۄەأ؏أًۄأتىأڬەأمشۏثأۄۏأىوتصأځڔہأشۄەأحہەأۗأدثأتثىأتثۏأذخوۄأشعۏأتههۄأؼىۄأىوتصأضەألتشؽأۄًةەأحًأۄوتشۏأدتىثأوحًدۄأۄًةەأ؏أذعشحأؼهۏأثىأذضۏىأىەأتىأضەأڬۄتأ=أزوأڬەأثتشەأوۏڽأتۏڬأذزۏخأ؏أإځأتځىۏأًتهزۄأڬەأذًتهەأضەأثۏتىأڬشحەأۄًأ؏أتىۄًڽأىەأڬۄتأ=أدۏأۄتڽأ؏أًۄأذزۏخأودہەأوۏشۏأًتهزۄأىەأثحتةۏأحہۏأ؏أ+أًۄأۏۄأۄەأڬۄأوۏشۏأًتهزۄأ"
"6890","%أؼخوتىأثىأضهۏوتىأتځىەأًتهزأڬەأذًتهەأضەأتىأڬۏأًتهزۄأذعشحأطلتؤأثىحأؼثزتههۄأڬەأثتشەأوۏڽأثۏتىأڬشحەأۄۏڽأڬۄأًۄأصوتىۄأدتۄهۏحأوۏڽأزوأڬۏتأڬشحۏأحہۏأ؏أدثأًۄأۄدشحأڬشأڬەأوزۏىۄأوىًشۄأإةۏڽأحًأًۄأشضًهأتههۄأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًةۏڽأ؏أتًشأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أوۏڽأصوتىۄأدتۄهۏحأوۏڽأزوأڬۏتأڬشحۏأحہۏأ؏أوۏڽأًۄأزوأإځأڬًأضىتىتأډتۄحۏأۄًڽأ؏أذعًشأ﷽أىەأتدتصحأؼغتألشوتةۏأ؏أتىۄًڽأىەأذعًشأ﷽أڬًأزوأضىتۏتأۗأتضأوۏڽأډۏًىټۏأڬەأڬتټەأڬتأثہۏأزوأحہتأ؏أىثۏأتڬشوأ﷽أىەألشوتۏتأ=أۏۄأزوأڬشأزۏتأڬشًأتًشأۏۄأذلظۄأڬًأثہۏأضڬہتأزًأ؏أًۄأزوأۏۄأحہتأۗ"
"6891","أتظوؼۏأڬۄحەأۄۏڽأ=أ+أوسڬًشۄأزًىًڽأذزۏخًڽأوۏڽأدًأډۏًىټۏأڬتأسڬشأۄەأتضأډۏًىټۏأۏؼىۏأ"
"6892","أذعشحأطلتؤأثىحأؼثزتههۄألشوتحۏأۄۏڽأ=أوۏڽأتۏڬأزىأىثۏأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًةۏأ؏أوۏڽأىەأذعًشأ﷽أضەأوضةهۄأزشۏتلحأڬۏتأ؏أتًشأإځأڬۏأثتشڲتۄأوۏڽأ+أتځىۏأثۏوتشۏأڬۏأ"
"6893","أتثىأتضذتمأڬۄحەأۄۏڽأ=أدىأهًڲًڽأىەأذثطۄأڬۏأدتىثأۄدشحأڬۏأحہۏأتىأوۏڽأضەأ““أؼتوشأثىأشثۏؼۄأ‛‛أثہۏأحہەأ؏أتًشأتىأڬەأۄوشتۄأتىأڬۏأصًدۄأ““أهۏهۏأثىحأتثۏأذخوۄأثىأؽتىوأثىأؼًلأثىأؼثۏزأثىأؼًۏدأثىأؼزۏأثىأڬؼثأ‛‛أثہۏأحہۏڽأۗأ"
"6894","أصۄشۏأڬۄحەأۄۏڽأ=أذعشحأؼثزتههۄأثىأؼتوشألشوتحەأۄۏڽأ=أوۄتدشتحأوۏڽأضثأضەأځۄهەأوزۏىۄأوىًشۄأإىەأًتهۏأرتحًىأذعشحأهۏهۏأثىحأتثۏأذخوۄأشعۏأتههۄأؼىۄتأۄۏڽأ؏أتىۄًڽأىەأتځىەأًتهزأڬەأۄوشتۄأۄدشحأڬۏأۗأتىأڬەأطًۄشأؼتوشأثىأشثۏؼۄأشعۏأتههۄأؼىۄأۄۏڽأۗأ"
"6895","أذعشحأؼتوشأثىأشثۏؼۄأشعۏأتههۄأؼىۄأتځىۏأًتهزۄأتوأؼثزتههۄأثىحأتثۏأذخوۄأضەأشًتۏحأڬشحەأۄۏڽأًۄألشوتحۏأۄۏڽأ=أتههۄأڬۏأمضوأ$أۄوأضشصوۏىأذثطۄأڬۏأدتىثأشًتىۄأۄًةەأ؏أؼتوشأثىأشثۏؼۄأشعۏأتههۄأؼىۄأتځىەأڬضۏأڬتوأضەأڲةەأحہەأ؏أڬۄأتضۏأزًشتىأذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأحطشۏلأهەأإةەأ؏أإځأوۏشەأځتضأڬہڔەأۄًأڲةەأ؏أإځأتځىەأڲہًڔەأځشأۄۏأحہەأ؏أدثڬۄأۄوۏڽأتىأڬۏأدتىثأضەأثۄحأضرحۏًڽأتًشأحڬتهۏلأڬتأضتوىتأحہتأ؏أإځألشوتىەأهڲەأ=أتەأتوأؼثزتههۄأ$أتثأحًأإصتزأۄًأشۄۏأۄًأ؏أوۏڽأىەأڬۄتأ=أدۏأۄتڽأتههۄأڬۏأمضوأ$أۄوأتههۄأڬۏأصوۏىأوۏڽأىڬهأدتةۏڽأڲەأ؏أحوأىەأۄوۏڽأثۄحأحڬتهۏلأزۏأۄۏڽأتًشأۄوأځشأػهوأًأضحوأڬەأثۄحأځۄتڔأحًڔەأۄۏڽأ؏أثتهإرشأتههۄأحؼتهۏٳأىەأۄوتشەأهةەأىڬهىەأڬتأشتضحۄأثىتأۄۏأزۏتأ؏أذعشحأؼوشأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أتههۄأحؼتهۏٳأىەأحوۄتشتأضتحہأزۏتأۄەأ؏أوۏڽأىەأتضأزىأذعشحأؼوشأشعۏأتههۄأؼىۄأڬًأشمحأڬۏأدضأڬۏلۏحأوۏڽأزۏڬہتأتضأضەأځۄهەأڬثہۏأإځأځشأتۏضۏأڬۏلۏحأىۄۏڽأزۏڬہۏأۗأځہشأإځأډهەأڲةەأتًشأۄوتشەأدتىەأځشأإځأثۄحأؽوڲۏىأحہەأ؏أشتًۏأڬۄحەأۄۏڽأ=أځہشأذعشحأؼتوشأثىأشثۏؼۄأتځىتأڬتوأڬشأڬەأًتځضأإأڲةەأ؏أوۏڽأىەأڬۄتأ=أتەأتثًؼثزتههۄأ$أڬتطأحوأإدأؼوشأڬۏأذتهحأزۏڬہحەأتًشأۄوتشەأدتىەأځشأتضأڬۏأشمحأًتهۏأڬۏلۏحأزۏڬہحەأ؏أؼتوشأثىأشثۏؼۄأشعۏأتههۄأؼىۄأىەأڬۄتأ=أڬۏتأحوأتضأڬەأتضهتوأمثًهأڬشىەأڬۏأهتهډأشڬہحۏأۄًأآأوۏڽأىەأڬۄتأ=أدۏأۄتڽأۗأتىۄًڽأىەأ+أؼوشأڬەأتضهتوأضەأوتۏًضأۄًأڬشأ"
"6896","أوظؼثأثىأؼثزتههۄأصثۏشۏألشوتحەأۄۏڽأ=أتىأوۏڽأضەألتغوۄأثىحأرغتثأثىأىلۏهأشعۏأتههۄأؼىۄتأثہۏأۄۏڽأۗأإځأضؼۏزأثىأصۏزأثىأؼوشًأثىأىلۏهأڬۏأصًدۄأوذحشوۄأۄۏڽأۗأإځأذعشحأؼوشأشعۏأتههۄأؼىۄأضەأځۄهەأتضهتوأهەأإةۏأحہۏڽأۗأوڬۄأوڬشوۄأوۏڽأثۏؼحأڬشىەأًتهۏأرًتحۏىأوۏڽأضثأضەأځۄهۏأۏۄۏأرتحًىأۄۏڽأۗأ"
"6897","أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أثىۏأصۄشۄأڬتأتۏڬأإزوۏأذعشحأؼوشأشعۏأتههۄأؼىۄأڬەأمثًهأتضهتوأضەأځۄهەأتىأضەأوهتأ؏أذعشحأؼوشأحهًتشأهټڬتةەأدتأشۄەأحہەأ؏أتضأىەأځًډہتأ=أڬۄتڽأدتأشۄەأۄًأآأذعشحأؼوشأشعۏأتههۄأؼىۄأىەأڬۄتأ=أوذوزأڬًأمحهأڬشىەأدتأشۄتأۄًڽأ؏أتضأىەأڬۄتأ=أتەأؼوشأ$أڬۏتأوۏڽأحوۄۏڽأتضأضەأثہۏأصۏتزۄأؼدۏثأثتحأىۄأثحتاڽأآأحوۄتشتأثۄىًةۏأضؼۏزأتًشأحوۄتشۏأثۄىأتځىەأإثتؤأڬەأزۏىأڬًأډہًڔأڬشأظتثۏأۄًأډڬەأۄۏڽأۗأشتًۏأڬۄحەأۄۏڽأ=أذعشحأؼوشأشعۏأتههۄأؼىۄأتضۏأًمحأؽظەأڬەأؼتهوأوۏڽأډهحەأۄًةەأثۄىأڬەأڲہشأإةەأ؏أدثأًۄأتىأڬەأزشًتصەأڬەأمشۏثأځۄىډەأ؏أتىأهًڲًڽأڬەأځتضأرثتثأىتوۏأتۏڬأطرظأۄًحتأحہتأ؏أًۄأتىأزًىًڽأڬًأضًشۆأغۄأڬۏأحؼهۏوأزەأشۄتأحہتأ؏أدثأرثتثأشعۏأتههۄأؼىۄأىەأذعشحأؼوشأشعۏأتههۄأؼىۄأڬەأمزوًڽأڬۏأإۄټأضىۏأ؏أحًأتىأڬۏأډتشځتةۏأڬەأىۏډەأډہځأڲةەأ؏أذعشحأؼوشأشعۏأتههۄأؼىۄأتىزشأإةەأتًشأڬۄىەأهڲەأ=أۏۄأدًأحوأإۄضحۄأإًتصأوۏڽأځڔہأشۄەأحہەأدًأتثہۏأوۏڽأىەأحوۄتشەأځتضأزۏڬہتأ؏أۏۄأڬۏتأۄەأآأتىأڬەأثۄىًةۏأذعشحأضؼۏزأثىأصۏزأشعۏأتههۄأؼىۄأىەأڬۄتأ=أتەأؼوشأ$أحوۄتشتأڬۏتأرۏتهأۄەأ؏أتڲشأذمأحۏشەأزۏىأڬەأؼهتًۄأڬضۏأزًضشەأزۏىأوۏڽأۄًأ؏أذعشحأؼوشأشعۏأتههۄأؼىۄأىەأذعشحأصۏزأڬًأوتشىتأطشًؼأڬشأزۏتأ؏أذعشحأؼوشأڬۏأثۄىأىەأتځىەأطًۄشأڬتأزلتؼأڬشحەأۄًةەأذعشحأؼوشأڬتأۄتحہأځڬڔىتأډتۄتأحًأذعشحأؼوشأىەأتىأڬەأډۄشەأځشأحہځڔأشضۏزأڬشأزۏتأ؏أتىأڬەأډۄشەأځشأحہځڔأڬتأىطتىأډہځأڲۏتأ؏أتىأڬۏأثۄىأىەأدهتهأوۏڽأإأڬشأڬۄتأ=أتەأؼوشأ$أتڲشأضډتةۏأحوۄتشەأزۏىأڬەأرهتلأوۏڽأۄًأحًأحوۄتشتأڬۏتأرۏتهأۄەأآأوۏڽأڲًتۄۏأزۏحۏأۄًڽأڬۄأتههۄأحؼتهۏٳأڬەأضًتأڬًةۏأؼثتزحأڬەأهتةمأىۄۏڽأۄەأتًشأوۏڽأڲًتۄۏأزۏحۏأۄًڽأڬۄأوذوزأ﷽أتههۄأحؼتهۏٳأڬەأشضًهأۄۏڽأۗأ+أذعشحأتىضأشعۏأتههۄأؼىۄأ"
"6898","أذعشحأؼوشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأوۏشۏأثۄىأىەأزشًتصۄأڬہًهتأحًأوۏڽأىەأ+أتىزشأإأڬشأتىأضەأ"
"6899","%أذعشحأتضوتؤأثىحأضؼۏزأثىأصۏزأثىأؼوشًأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ="
"6900","أؼوشًأثىأطؼۏثأتځىەأًتهزأضەأ؏أًۄأتىأڬەأزتزتأضەأشًتۏحأڬشحەأۄۏڽأڬۄأتوأىثۏۄأثىحأذدتدأتوأؼثزتههۄأثىأؼوشًأتۏضۏأرتحًىأحہۏڽأدًأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأحذتةلأثہۏدتأڬشحۏأحہۏڽأتًشأشضًهأتههۄأ﷽أڬەأضتحہأثۄحأتډہتأضهًڬأڬشحۏأحہۏڽأۗأتۏڬأزىأشضًهأتههۄأ﷽أتىأڬەأځتضأوهتمتحأڬەأهةەأحطشۏلأهتةەأإځأ﷽أىەأتىأڬتأذتهأزشۏتلحألشوتۏتأ؏أتىۄًڽأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أوۏشەأوتڽأثتځأإځأځشأمشثتىأۄًأدتةۏڽأ؏أوۏڽأټہۏڬأۄًڽأ؏أإځأ﷽أىەأځًډہتأ=أؼثزتههۄأڬتأڬۏتأذتهأۄەأآأتىۄًڽأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أًۄأثہۏأټہۏڬأۄەأ؏أ+أؼثزتههۄأزىۏتأضەأثتهڬهأتهڲأحہهڲأۄًأډڬتأحہتأ"
"6901","أوظؼثأثىأؼثزتههۄأصثۏشۏألشوتحەأۄۏڽأ=أؼتوشأثىأهًةۏأڬۏأؼًشحًڽأوۏڽأضەأ““أضۄهۄأثىحأضۄۏهأثىأؼوشًأثىأؼثزطوضأثىأؼثزأًزأثىأىظشأثىأوتهڬأثىأذضهأ‛‛أۄۏڽأ؏أتىۄًڽأىەأتځىەأطًۄشأتثًذسۏلۄأشعۏأتههۄأؼىۄأڬەأۄوشتۄأذثطۄأڬۏأدتىثأۄدشحأڬۏأحہۏأۗأذثطۄأوۏڽأتىأڬەأۄتڽأوذوزأثىأتثۏأذسۏلۄأځۏزتأۄًةەأحہەأۗأ"
"6902","أذعشحأتثًذسۏلۄأشعۏأتههۄأؼىۄأڬۏأصًدۄأذعشحأضۄهۄأضەأوشًۏأۄەأ؏أتىۄًڽأىەأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأتثًذسۏلۄأڬەأؽهتوأضتهوأڬتأسڬشأڬۏتأتًشأثحتۏتأڬۄأًۄأتىأڬەأځتضأإحەأدتحەأۄۏڽأ؏أًۄأضودہحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتىأڬًأڬۄتأحہتأڬۄأًۄأضتهوأڬًأزًزہأځهتأزەأ؏أحًأتىۄًڽأىەأضتهوأڬًأزًزہأځهتۏتأحہتأذتهتىڬۄأًۄأ+أثڔۏأؼوشأڬەأ"
"6903","أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتثًذسۏلۄأڬۏأصًدۄأضۄهۄأڬًأڬۄتأحہتأڬۄأحوأتثًذسۏلۄأڬەأؽهتوأضتهوأڬًأتځىتأزًزہأځهتأزًأ+أتًشأتضأڬًأتځىتأشعتؼۏأثۏټتأثىتأهًأ"
"6904","أوظؼثأثىأؼثزتههۄأصثۏشۏألشوتحەأۄۏڽأ=أمشۏطأڬۏأرًتحۏىأوۏڽأضەأ““أتوأذثۏثۄأ‛‛أثہۏأۄۏڽأ؏أتىأڬتأىتوأذوىۄأثىحأدذطأۄەأ؏أإځأشضًهأتههۄأ﷽أڬۏأصًدۄأوذحشوۄأتوأتهوًوىۏىأذعشحأصۏىثأثىحأدذطأشعۏأتههۄأؼىۄتأڬۏأثۄىأۄۏڽأۗأإځأثىۏأؼثزطوضأڬەأذهۏلأتضزأثىأرصۏوۄأوۏڽأضەأۄۏڽأۗأ"
"6905","%أذعشحأؼثزتهشذوىأتثىأتثۏأهۏهۏألشوتحەأۄۏڽأڬۄأشضًهأتههۄأىەأ﷽أوضدزأوۏڽأزًأضحًىًڽأڬەأزشوۏتىأتۏڬأشضۏأثىزہۏأۄًةۏأزۏڬہۏأتًشأځًډہتأ=أۏۄأڬۏتأۄەأآأإځأ﷽أڬًأثحتۏتأڲۏتأڬۄأذوىۄأثىحأدذطأىوتصأځڔہحۏأۄەأ؏أدثأًۄأحہڬأدتحۏأۄەأحًأتضأشضۏأڬەأضتحہأهټڬأدتحۏأۄەأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أدحىۏأۄوحأۄًأتحىۏأىوتصأځڔہًأتًشأدثأحہڬأدتاأحًأثۏټہأدتاأۗ"
"6906","أذعشحأذوىۄأثىحأدذطأشعۏأتههۄأؼىۄتأڬەأثتشەأوۏڽأوشًۏأۄەأڬۄأتىأڬًأثحتۏتأڲۏتأڬۄأحوۄتشتأثہتةۏأطۄۏزأۄًأڲۏتأ؏أتىۄًڽأىەأڬۄتأ=أتههۄأحؼتهۏٳأتضأځشأشذوحأىتصهألشوتةەأ؏أتىتأههۄأًتىتأتهۏۄأشتدؼًىأ؏أځہشأتىأڬًأثحتۏتأڲۏتأڬۄأحوۄتشەأوتوًڽأذعشحأذوصۄأطۄۏزأۄًأڲةەأ؏أتىۄًڽأىەأڬۄتأ=أتىتأههٔٳۄأًتىتأتهۏۄأشتدؼًىأ؏أتىأڬًأثحتۏتأڲۏتأڬۄأحوۄتشتأطًۄشأطۄۏزأۄًأڲۏتأۄەأ؏أتىۄًڽأىەأڬۄتأ=أًتذصىتۄأ+أۄتةەأتلضًضأ"
"6907","أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أتوأذثۏثۄأثىحأدذطأشعۏأتههۄأؼىۄتأذعشحأؼثزتهشذوىأثىأؼًلأشعۏأتههۄأؼىۄأڬۏأثۏًۏأۄۏڽأ؏أۏۄأتوأتهوًوىۏىأذعشحأصۏىثأثىحأدذطأشعۏأتههۄأؼىۄتأڬۏأثۄىأۄۏڽأ؏أۏۄأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأإةۏڽأتًشأؼشعأڬۏأڬۄأتىأڬًأڲصطحۄأضتحأضتهًڽأضەأوضهضهأذۏعأإأشۄتأۄەأ؏أتىأڬەأهةەأىوتصأڬتأڬۏتأذڬوأۄەأآأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أۏۄأذۏعأىۄۏڽأۄەأثهڬۄأۏۄأثۏوتشۏأڬۏأًدۄأضەأرًىأإأشۄتأۄەأ؏أحوأ+أۄشأىوتصأڬەأًمحأڬەأهةەأ"
"6908","أتثىأتثۏأوهۏڬۄألشوتحەأۄۏڽأ=أتىأڬۏأرتهۄألتغوۄأثىحأتثۏأذثۏطأشعۏأتههۄأؼىۄتأشضًهأتههۄأ﷽أڬەأځتضأإةۏڽأتًشأؼشعأڬۏأ=أودہەأڋشأهڲحتأۄەأڬۄأڬۄۏڽأوۏڽأزًصرۏأىۄأۄًأدتاڽأ؏أوۏڽأحمشۏثتَأزًأضتهًڽأضەأىوتصأىۄۏڽأځڔہأضڬۏأ؏أتىۄًڽأىەأىثۏأتڬشوأ﷽أضەأځًډہتأحًأذعًشأ﷽أىەألشوتۏتأ=أۄشأوۄۏىەأوۏڽأتځىەأذۏعأڬەأزىًڽأڬەأثشتثشأىوتصأڬتأىتؽۄأڬۏتأڬشًأتًشأثتمۏأزىًڽأوۏڽأۄشأىوتصأ+أڬەأًمحأ"
"6909","%أوذوزأثىأذتغثأتځىۏأًتهزۄأتوأدوۏهأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ+أًۄألشوتحۏأۄۏڽأ"
"6910","أوذوزأثىأؼوشأڬۄحەأۄۏڽأ=أتًشأتوأتۏوىأشضًهأتههۄأ﷽أڬۏأثتىزۏأتًشأإځأ﷽أڬۏأذتعىۄأ+أثډەأڬۏأځشًشطأڬشىەأًتهۏأزتۏۄأ"
"6911","أثىۏأضؼزأثىأثڬشأڬەأتۏڬأثصشڲأثۏتىأڬشحەأۄۏڽأ=أشضًهأتههۄأ﷽أذعشحأتوأتۏوىأڬًأ““أۏتأتوۄأ‛‛أڬۄۄأڬشأځڬتشتأڬشحەأحہەأ؏أتًشأشضًهأتههۄأ﷽أدثأثہۏأتوأتۏوىأڬۏأغشلأزۏڬہحەأحًألشوتحەأ=أۏۄأوۏشەأڲہشتىەأڬۏأثمۏۄأۄەأۗأ"
"6912","أذعشحأتوأتۏوىأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أتۏڬأزلؼۄأىثۏأتڬشوأ﷽أشتحأڬەأًمحأثۏزتشأۄًةەأ؏أڬوشەأڬەأڬًىەأوۏڽأشڬہەأۄًةەأتۏڬأځۏتهەأوۏڽأځۏطتثأڬۏتأ؏أشتحأوۏڽأوۏشۏأإىڬہأڬہهۏأ؏أودہەأتضأًمحأځۏتضأهڲأشۄۏأحہۏأ؏أوۏڽأىەأتضأځۏتهەأضەأځۏأهۏتأۗأودہەأسشتأثہۏأتىزتصۄأىۄأۄًتأڬۄأوۏڽأىەأځۏطتثأځۏأهۏتأۄەأ؏أظثذأۄًةۏأحًأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أتەأتوأتۏوىأ$أتټہًأتًشألهتڽأځۏتهەأوۏڽأدًأڬډہأۄەأتضأڬًأتىڋۏهأزًأ؏أوۏڽأىەأڬۄتأ=أتههۄأڬۏأمضوأ$أۏتأشضًهأتههۄأ﷽أوۏڽأىەأحًأتضأڬًأځۏأهۏتأۄەأ؏أشتًۏأڬۄحەأۄۏڽأ=أشضًهأتههۄأ﷽أوضڬشتةەأ؏أذحۏٳأڬۄأإځأڬەأزتىزتىأوثتشڬأػتۄشأۄًأڲةەأ؏أإځأ﷽أىەألشوتۏتأ=أإدأڬەأثؼزأحدہەأځۏټأڬۏأثۏوتشۏأڬثہۏأىۄۏڽأهڲەأڲۏأۗأ"
"6913","أوظؼثأثىأؼثزتههۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬۏأثتىزۏأتًشأذتعىۄأ+أثډەأڬۏأځشًشطأڬشىەأًتهۏأزتۏۄأ"
"6914","أۏذۏۏأثىأوذوزأثىأظتؼزأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ؏أوذوزأثىأظتؼزأثۏتىأڬشحەأۄۏڽأڬۄأتضتوۄأثىأصۏزأڬەأؽهتوأتثىأتثۏألشتحأڬتأذضىأثىأتوۏۄأڬەأضتحہأدہڲڔتأۄًأڲۏتأ؏أتثىأتثۏألشتحأىەأتځىۏأڲلحڲًأوۏڽأتضەأڬۄتأ=أتەأتثىأثشڬۆأ$أحًأتوأتۏوىأڬتأتشتزۄأشڬہحتأۄەأآأذضىأىەأتضأثتحأځشأڲًتۄأمتةوأڬةەأتًشأتضأڬتأوؼتوهۄأتثًثڬشأثىأوذوزأثىأؼوشًأثىأذصوأڬەأځتضأهەأڲةەأ؏أۏۄأتىأزىًڽأوزۏىۄأوىًشۄأڬەأمتعۏأحہەأ؏أًۄتڽأدتأڬشأذضىأىەأځًشتأمظۄأضىتۏتأۗأتثًثڬشأىەأتثىألشتحأضەأڬۄتأ=أحًأىەأتضأڬًأ““أۏتأتثىأثشڬۆأ‛‛أڬۄتأ؏أتضأضەأحۏشۏأڬۏتأوشتزأحہۏأآأتىۄًڽأىەأڬۄتأ=أوۏڽأىەأتضأڬتأتظهأىتوأهۏتأحہتأ؏أتثًثڬشأىەأڬۄتأ=أحًأىەأحظؽۏشأڬەأتضأهلػأڬەأضتحہأتىأڬتأىتوأهۏتأۄەأ؏أذتهتىڬۄأًۄأوضهوتىأۄۏڽأ؏أتًشأشضًهأتههۄأ﷽أتىأڬًأ““أۏتأتوۄأ‛‛أتًشأ““أۏتأتوأتۏوىأ‛‛أڬۄتأڬشحەأحہەأ؏أتڲشأوۏڽأحۏشەأمحهأڬۏأضصتأضىتأزًڽأحًأتههۄأحؼتهۏٳأتضأځشأوۏشۏأځڬڔأىۄۏڽألشوتةەأڲتأۗأځہشأتىأڬًأضحشأڬًڔًڽأڬۏأضصتأزۏأڲةۏأۗأ"
"6915","أوظؼثأثىأؼثزتههۄأصثۏشۏأثۏتىأڬشحەأۄۏڽأڬۄأتشًۏٳأثىحأڬشۏصأثىأشثۏؼۄأثىأذثۏثأثىأؼثزطوضأتضهتوأهتةۏڽأ؏أتًشأوزۏىۄأوىًشۄأڬۏأدتىثأۄدشحأثہۏأڬۏأۗأذعشحأؼخوتىأؽىۏأشعۏأتههۄأؼىۄأڬەأزًشأرهتلحأوۏڽأتىأڬتأتىحمتهأۄًتأۗأ"
"6916","أوذوزأثىأؼوشألشوتحەأۄۏڽأ=أتضوتؤأثىحأتثۏأثڬشأشعۏأتههۄأؼىۄتأڬۏأًتهزۄأڬتأىتوأ““أمحۏهۄأثىحأؼثزتهؼصۏٳأثىأتضؼزأثىأدتثشأثىأوتهڬأثىأذضهأثىأؼتوشأثىأهًةأ‛‛أۄەأۗأإځأذعشحأؼثزتههۄأثىأتثۏأثڬشأشعۏأتههۄأؼىۄأڬۏأذمۏمۏأثۄىأۄۏڽأ؏أوڬۄأوۏڽأثۄحأځۄهەأځۄهأتضهتوأهەأإةۏأحہۏڽأ؏أشضًهأتههۄأ﷽أڬۏأثۏؼحأثہۏأڬۏأ؏أصثۏشأثىأؼًتوأشعۏأتههۄأؼىۄأضەأتىأڬتأىڬتذأۄًتأ؏أتىأڬەأۄتڽأ““أؼثزتههۄأ؏أؼشًۄأتًشأؼتظوأ؏أوۄتدشأ؏أرزۏدۆأتهڬثشۏٳأ؏أتوأذضىأ؏أتًشأؼتةطۄأثىحأصثۏشأ‛‛أضتحأثډەأځۏزتأۄًةەأۗأ"
"6917","أذعشحأتضوتؤأثىحأتثۏأثڬشأشعۏأتههۄأؼىۄتأڬەأثتشەأوۏڽأوىمًهأۄەأڬۄأذعشحأضؼۏزأثىأؼتظأشعۏأتههۄأؼىۄأڬەألحىۄأڬەأصوتىۄأتىۄًڽأىەأتۏڬأرىدشأثىًتأڬشأشڬہتأۄًتأحہتأ؏أوۏڽأىەأًۄأرىدشأتىأڬۏأڬۄىۏأڬەأىۏډەأشڬہأزۏتأ؏أتىأضەأڬضۏأىەأځًډہتأ=أإځأتضأرىدشأڬتأڬۏتأڬشۏڽأڲۏأآأتىۄًڽأىەأدًتثأزۏتأ=أتضأهةەأڬۄأتڲشأوۏشەأځتضأڬًةۏأډًشأًؽۏشۄأإأدتةەأحًأوۏڽأتضأڬتأځۏټأځہتڔأزًڽأزًڽأڲۏأۗأإځأإىڬہًڽأضەأوؼسًشأحہۏڽأۗأ"
"6918","أوظؼثأثىأؼثزتههۄألشوتحەأۄۏڽأ=أذعشحأتضوتؤأثىحأتثۏأثڬشأشعۏأتههۄأؼىۄتأتځىەأثۏټەأؼثزتههۄأثىأصثۏشأڬەأمحهأڬەأډىزأزىأثؼزأتىحمتهأڬشأڲةۏڽأ؏أتىأڬەأثۏټەأڬتأمحهأضىأ:6أۄدشۏأوۏڽأ4:أدوتزۏأتهتًهۏٳأڬًأوىڲهأڬەأزىأۄًتأۗأ"
"6919","أوظؼثأثىأؼثزتههۄأصثۏشۏأثۏتىأڬشحەأۄۏڽأ=أعثتؼۄأثىحأصثۏشأثىأؼثزتهوغهثأثىأۄتطوأڬتأىڬتذأشضًهأتههۄأ﷽أىەأومزتزأثىأؼوشًأثىأخؼهثۄأشعۏأتههۄأؼىۄأضەأڬۏتأ؏أتىأڬەأۄتڽأؼثزتههۄأتًشأڬشۏوۄأځۏزتأۄًةەأ؏أتًشأؼثزتههۄأدىڲأدوهأوۏڽأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬۏأذوتۏحأوۏڽأهڔحەأۄًةەأطۄۏزأۄًةەأ؏أتىأڬۏأىؼطأوثتشڬأځڔۏأۄًةۏأحہۏأ؏أذعشحأؼهۏأشعۏأتههۄأؼىۄأتضأڬەأځتضأڲصشەأحًألشوتۏتأ=أوۏشتأثہتىدتأڬحىتأثشتأۄەأۗأ"
"6920","أذعشحأعثتؼۄأثىحأصثۏشأڬەأثتشەأوۏڽأوىمًهأۄەأڬۄأتىۄًڽأىەأشضًهأتههۄأ﷽أڬًأڲًطحأثہۏدتأ؏أإځأ﷽أىەأًۄأڲًطحأڬہتۏتأ؏أثؼزأوۏڽأثؽۏشأًعًأزۄشتةەأىوتصأځڔہۏأۗأ"
"6921","أوذوزأثىأؼوشألشوتحەأۄۏڽأ=أتوأذڬوأثىحأصثۏشأثىأؼثزتهوغهثأثىأۄتطوأشعۏأتههۄأؼىۄتأڬۏأطتزۏأشثۏؼۄأثىأذتشخأثىأؼثزتهوغهثأضەأۄًةۏأ؏أتىأڬەأۄتڽأوذوزأ؏أؼثتضأ؏أؼثزطوضأ؏أؼثزتهوغهثأ؏أتوۏۄأتًشأتشًۏٳأڬثشۏٳأځۏزتأۄًةەأۗأ"
"6922","%أتوأذڬوأثىحأصثۏشأڬەأثتشەأوۏڽأوشًۏأۄەأڬۄأتىۄًڽأىەأىثۏأتڬشوأ﷽أڬًأڲًطحأځۏطأڬۏتأ؏أذعًشأ﷽أىەأتضأوۏڽأضەأڬہتۏتأ؏أځہشأثؽۏشأًعًأزۄشتةەأىوتصأځڔہۏأۗ"
"6923","أذوتزأثىأضهوۄأ؏أثىۏأۄتطوأڬەأؽهتوأؼوتشأضەأشًتۏحأڬشحەأۄۏڽأڬۄأتوأذڬۏوأثىحأؼثزتهوغهثألشوتحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأوۏشەأځتضأڲًطحأڬہتۏتأ؏أذعشحأثهتهأىەأإأڬشأتستىأزۏأ؏أذعًشأ﷽أىەأىۏتأًعًأڬةەأثؽۏشأىوتصأځڔہتةۏأ+أدضأضەأختثحأۄًحتأۄەأڬۄأڲًطحأڬہتىەأضەأًعًأىۄۏڽأټًټحتأۗأ"
"6924","أوذوزأثىأؼوشألشوتحەأۄۏڽأ=أتًشأتوتوۄأثىحأذوصۄأثىأؼثزتهوغهثأثىأۄتطوأۗأتىأڬۏأًتهزۄأ““أضهوۏٳأثىحأؼوۏضأثىأوؼزأثىأحۏوأ‛‛أۄۏڽأۗأإځأذعشحأتضوتؤأثىحأؼوۏضأشعۏأتههۄأؼىۄتأڬۏأثۄىأۄۏڽأۗأشضًهأتههۄأ﷽أڬەأثؼزأصىزۄأشۄۏڽأتًشأإځأ﷽أضەأشًتۏحأثہۏأڬۏأۄەأۗأ"
"6925",""" عبداللہ بن شداد ، امامہ بنت حمزہ کے ماں شریکی بھائی ( اخیافی بھائی ) ہیں ، آپ اپنی بہن امامہ بنت حمزہ سے روایت کرتے ہیں کہ امامہ کا آزاد کردہ غلام فوت ہو گیا ، اور اس کی صرف ایک بیٹی ہی تھی ۔ رسول اللہ ﷺ نے اس کی بیٹی کے لئے آدھا مال اور حمزہ کی بیٹی کے لئے باقی آدھا مال دینے کا فیصلہ فرمایا ۔\n ام رمثہ رضی اللہ عنہا کا ذکر\n بعض لوگوں کا کہنا ہے کہ ان کا نام رمیثہ ام حکیم مطلبیہ رضی اللہ عنہا ہے ، آپ اسلام بھی لائیں ، اور حضور ﷺ کی بیعت بھی کی ، وہ حدیث پاک انہی سے مروی ہے ، جس میں یہ ہے کہ سعد بن معاذ رضی اللہ عنہ کی وفات پر عرش بھی لرز اٹھا تھا ۔"" \nالمستدرك على الصحيحين حدیث: 6925 عربی حدیث: 6925"
"6926","أوظؼثأثىأؼثزتههۄأصثۏشۏأثۏتىأڬشحەأۄۏڽأ““أتوأڬهخًوأثىحأؼمثۄأثىأتثۏأوؼۏغأ‛‛ۗأتىأڬۏأًتهزۄأتشًۏٳأثىحأڬشۏصأۄۏڽأۗأذعشحأتوأڬهخًوأتضهتوأۄدشحأضەأځۄهەأتضهتوأهتةۏأحہۏڽأتًشأتىۄًڽأىەأذعًشأ﷽أڬۏأثۏؼحأثہۏأڬۏأحہۏأ؏أشضًهأتههۄأ﷽أڬەأثؼزأۄدشحأڬشىەأًتهۏأرًتحۏىأوۏڽأۏۄأضثأضەأځۄهۏأرتحًىأۄۏڽأۗأ"
"6927","%أوذوزأثىأؼوشأڬۄحەأۄۏڽأ=أتوأڬهخًوأثىحأؼمثۄأشعۏأتههۄأؼىۄتأڬەأؼهتًۄأتًشأڬًةۏأمشطۏأرتحًىأتۏضۏأىۄۏڽأۄەأدًأتځىەأوتڽأثتځأڬەأڲہشأضەأتههۄأتًشأتضأڬەأشضًهأڬۏأغشلأوۄتدشأۄًأڬشأىڬهۏأۄًأۗأإځأوڬۄأوڬشوۄأضەأتڬۏهۏأحىأحىۄتأىڬهأځڔۏأۗأثىۏأرصتؼۄأڬتأتۏڬأإزوۏأتىأڬەأۄوشتۄأۄًأڲۏتأۗأ+أۏۄأًتمؼۄأظهذأذزۏثۏۄأڬەأوًمؼۄأځشأځۏطأإۏتأحہتأ"
"6928","أوظؼثأثىأؼثزتههۄأصثۏشۏأثۏتىأڬشحەأۄۏڽأ=أتوأرتهزأڬتأىتوأ““أتوۄأثىحأرتهزأثىأضؼۏزأثىأتهؼتظأثىأتوۏۄأ‛‛أۄەأۗأرتهزأثىأضؼۏزأشعۏأتههۄأؼىۄأضشصوۏىأذثطۄأڬۏأدتىثأۄدشحأڬشأڲةەأحہەأ؏أتىأڬەأۄوشتۄأتىأڬۏأصًدۄأ““أۄوۏىۄأثىحأرهلأ‛‛أثہۏأحہۏأ؏أذثطۄأوۏڽأتىأڬەأۄتڽأتوۄأثىحأرتهزأځۏزتأۄًةۏڽأ؏أۏۄأوضهضهأذثطۄأوۏڽأۄۏأشۄەأذحۏٳأڬۄأزًأڬطحۏًڽأًتهًڽأڬەأۄوشتۄأۏۄأًتځضأإأڲةەأ؏أتضأًمحأ““أتوۄأ‛‛أؼتمهأثتهؽأۄًأډڬۏأحہۏأ؏أذعشحأصثۏشأثىأؼًتوأشعۏأتههۄأؼىۄأىەأتىأضەأطتزۏأڬۏأ؏أتىأڬەأۄتڽأذعشحأصثۏشأڬەأزًأثۏټەأؼوشأتًشأرتهزأځۏزتأۄًةەأ؏أذعشحأتوۄأشعۏأتههۄأؼىۄتأىەأهوثۏأؼوشأځتةۏأتًشأىثۏأتڬشوأ﷽أضەأشًتۏحأثہۏأڬۏأۗأ"
"6929","أتوأرتهزأثىحأرتهزأثىأضؼۏزأثىأتهؼتظأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أوۏڽأىەأشضًهأتههۄأ﷽أڬًأؼستثأمثشأضەأځىتۄأوتىڲحەأۄًةەأضىتأۗأ"
"6930","أذعشحألتغوۄأثىحأؼحثۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أتثًذسۏلۄأتىأڬًأتىأڬۏأثۄىأڬًأشضًهأتههۄأ﷽أڬۏأثۏؼحأڬشتىەأهەأڲۏتأ؏أدثأشضًهأتههۄأ﷽أىەأتىأڬًأتضهتوأڬۏأطشتةغأثحتةۏڽأحًأۄىزأىەأڬۄتأ=أڬۏتأإځأدتىحەأۄۏڽأڬۄأإځأڬۏأمًوأڬۏأرًتحۏىأځشأتضأغشذأڬۏأوظۏثحًڽأتًشأإلحًڽأوۏڽأضەأڬًةۏأإحۏأۄەأآأذعشحأذسۏلۄأىەألشوتۏتأ=أتزہشأإاأتًشأتىأڬۏأثۏؼحأڬشأهًأ؏أذعًشأ﷽أڬۏأطشتةغأۏۄۏأۄًحۏأۄۏڽأۗأ"
"6931","أوذوزأثىأؼوشألشوتحەأۄۏڽأ=أتًشأذوىۄأثىحأدذطأذعشحأوظؼثأثىأؼوۏشأشعۏأتههۄأؼىۄأڬەأىڬتذأوۏڽأحہۏڽأ؏أوظؼثأثىأؼوۏشأشعۏأتههۄأؼىۄأدىڲأتذزأوۏڽأطۄۏزأۄًأڲةەأ؏أحًأذعشحأغهذۄأثىأؼثۏزتههۄأشعۏأتههۄأؼىۄأىەأتىأضەأطتزۏأڬۏأۗأتىأڬەأۄتڽأوذوزأثىأضدتزأځۏزتأۄًةەأ؏أتىۄۏأڬەأىتوأضەأتىأڬۏأڬىۏحأشڬہۏأڲةۏأتًشأزًضشتأثۏټتأؼثزتههۄأثىأغهذۄأځۏزتأۄًتأۗأ"
"6932","أذعشحأذوىۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أثەأطڬأزىۏتأضشضثصأًأطتزتثأتًشأوۏټہۏأۄەأ؏أثۄحأضتشەأهًڲأتههۄأتًشأتضأڬەأشضًهأڬەأوتهأ+أڬۏأتزتةۏڲۏأڬةەأثؽۏشأ"
"6933","أذعشحأوظؼثأثىأؼثزتههۄأصثۏشۏأثۏتىأڬشحەأۄۏڽأ=أتًشأتوأمۏضأثىحأوذظىأثىأرًتحأۗأذعشحأؼڬتطۄأثىأوذظىأڬۏأثۄىأۄۏڽأ؏أإځأځۄهەأځۄهأوڬۄأوڬشوۄأوۏڽأۄۏأتضهتوأهەأإةۏأحہۏڽأ؏أتًشأتځىەأڲہشأًتهًڽأڬەأۄوشتۄأۄدشحأڬشأڬەأوزۏىۄأوىًشۄأډهۏأڲةۏأحہۏڽأۗأشضًهأتههۄأ﷽أڬەأًظتهأوثتشڬأڬەأثؼزأصىزۄأشۄۏڽأتًشأذعًشأ﷽أضەأشًتۏحأثہۏأڬۏأۗأ"
"6934","أتوأمۏضأثۏتىأڬشحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أتىأڬتأۄتحہأحہتوەأوزۏىۄأوىًشۄأڬۏأتۏڬأڲهۏأوۏڽأىڬهەأتًشأډهحەأډهحەأثمۏؼأؽشمزأحڬأدتأځۄىډەأ؏أ+أًۄتڽأځۄىډأڬشأ"
"6935","أوظؼثأثىأؼثزتههۄأصثۏشۏأثۏتىأڬشحەأۄۏڽأ=أدستوۄأثىحأدىزهأثىأًۄثأتضزۏۄأشعۏأتههۄأؼىۄتأوڬۄأوۏڽأتضهتوأڬەأتثحزتةۏأتۏتوأوۏڽأتضهتوأهەأإةۏأحہۏڽأ؏أتًشأشضًهأتههۄأ﷽أڬۏأثۏؼحأڬۏأۗأتًشأتځىەأڲہشأًتهًڽأڬەأۄوشتۄأوزۏىۄأوىًشۄأڬۏأغشلأۄدشحأڬۏأۗأ"
"6936","أؼوشًأثىأؼخوىأدذطۏأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ=أثىًأؽتىوأثىأزًزتىأىەأۄدشحأڬەأوؼتوهەأوۏڽأتځىەأوشزًڽأتًشأؼًشحًڽأڬًأشًڬأهۏتأذحۏٳأڬۄأتىأڬەأزشًتصًڽأځشأحتهەأهڲتأزۏةەأۗأډىتىډۄأۄدشحأوۏڽأدذطأڬۏأحۏىأثۏټۏتڽأ؏أصۏىثأ؏أتوأذثۏثۄأتًشأذوىۄأشعۏأتههۄأؼىۄىأىڬهۏڽأتًشأتوأذثۏثۄأثىحأثىتىۄأتًشأدستوۄأثىحأدىزهأشعۏأتههۄأؼىۄىأثہۏأىڬهۏڽأۗأذعشحأدستوۄأثىحأدىزهأشعۏأتههۄأؼىۄتأ؏أتىۏضأثىأمحتزۄأثىأشثۏؼۄأتًضۏأڬەأىڬتذأوۏڽأحہۏأ؏أتىۏضأدىڲأثزشأوۏڽأطشۏڬأۄًةەأحہەأتًشأدىڲأتذزأوۏڽأطۄتزحأځتةۏأۗأذعشحأدستوۄأشعۏأتههۄأؼىۄتأشضًهأتههۄأ﷽أڬەأًظتهأڬەأثؼزأصىزۄأشۄۏڽأ؏أتًشأإځأ﷽أضەأشًتۏحأثہۏأڬۏأ؏أتًشأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأىەأثہۏأذعشحأدستوۄأضەأشًتۏحأڬۏأۄەأۗأ"
"6937","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأ؏أذعشحأدستوۄأثىحأًۄثأتضزۏۄأضەأشًتۏحأڬشحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأذوهأڬۏأذتهحأوۏڽأثډەأڬًأزًزہأځهتىەأضەأوىؼألشوتۏتأ؏أإځألشوتحەأۄۏڽأ=أوۏڽأىەأحذمۏمأڬۏأحًألتشضأتًشأشًوأڬًأثہۏأۏۄأؼوهأڬشحەأۄًةەأځتۏتأۗأهۏڬىأتضأډۏصأڬتأتىأڬۏأتًهتزأځشأڬًةۏأوعشأتخشأىۄۏڽأځتۏتأۗأإځألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أضەأؼصهأڬەأثتشەأوۏڽأځًډہتأڲۏتأحًأإځأ﷽أىەألشوتۏتأ=أًۄأثہۏأځًطۏزۄأزشڲًشأڬشىتأۄۏأۄەأۗ"
"6938","أظلۏۄأثىحأطۏثۄأثىأؼخوتىألشوتحۏأۄۏڽأ=أتههۄأڬۏأمضوأ$أدضأزىأظثذأڬەأًمحأشضًهأتههۄأ﷽أڬؼثۄأوۏڽأزترهأۄًةەأتًشأځہشأثتۄشأىڬهەأ+أۏًڽأهڲحتأۄەأ؏أدۏضەأ"
"6939","أوظؼثأثىأؼثزتههۄأصثۏشۏأثۏتىأڬشحەأۄۏڽأ=ألتغوۄأثىحأتثۏأذثۏطأثىأوغهثأثىأتضزأثىأؼثزتهؼصۏٳأۗأذعشحأؼثزتههۄأثىأدذطأثىأشۏتثأشعۏأتههۄأؼىۄأىەأتىأضەأطتزۏأڬۏأ؏أتىأڬەأۄتڽأوذوزأثىأؼثزتههۄأثىأدذطأځۏزتأۄًةەأ؏أذعشحألتغوۄأثىحأتثۏأذثۏطأىەأتځىۏأصىزڲۏأوۏڽأشضًهأتههۄأ﷽أڬۏأصۏتشحأثہۏأڬۏأتًشأإځأ﷽أضەأشًتۏحأثہۏأڬۏأۗأ"
"6940","أوظؼثأثىأؼثزتههۄأىەأتىأڬتأىضثأۏًڽأثۏتىأڬۏتأۄەأ““أثضشۄأثىحأظلًتىأثىأىًلهأثىأتضزأثىأؼثزتهؼصۏٳأثىأمظۏأ‛‛أإځأؼمثۄأتثىأتثۏأوؼۏغأڬۏأترۏتلۏأثۄىأ+أوتڽأطشۏڬۏأثۄىأ"
"6941","أوذوزأثىأؼوشألشوتحەأۄۏڽأ=أثشۄأثىحأتثۏأحدشتۆأشعۏأتههۄأؼىۄتأثىۏأؼثزتهزتشأڬەأوًتهۏأوۏڽأضەأۄۏڽأۗأًۄأڬۄحەأۄۏڽأڬۄأۄوأهًڲأۏوىۏأۄۏڽأ؏أمثۏهۄأتصزأضەأۄوتشتأحؼهمأۄەأ؏أثىۏأؼثزتهزتشأڬەأذهۏلأۄۏڽأ؏أتىأڬەأۄتڽأتىأڬەأڬةۏأثډًڽأڬۏأًهتزحۏڽأثہۏأۄًةۏأۄۏڽأۗأتًشأتثًحدشتۆأتثىأتثۏألڬۏۄأڬتأىتوأ““أۏضتشأ‛‛أۄەأۗأذعشحأثشۄأىەأشضًهأتههۄأ﷽أضەأشًتۏحأثہۏأڬۏأۄەأۗأ"
"6942","%أذعشحأثشۄأثىأتثۏأحدشتۆألشوتحۏأۄۏڽأدثأتههۄأحؼتهۏٳأىەأتځىەأوذثًثأ﷽أڬًأؼصحأًأحڬشۏوأڬتأحتدأځۄىتۏتأ؏أتًشأإځأ﷽أڬۏأىثًحأڬەأتثحزتةۏأتۏتوأحہەأ؏أإځأدثأمعتةەأذتدحأڬەأهةەأىڬهحەأحًأثۄحأزًشأحڬأډهەأدتحەأ؏أتحىەأزًشأدتحەأڬۄأدۄتڽأڬضۏأتىضتىأڬۏأىػشأىۄأځڔحۏأۄًأ؏أإځأځۄتڔًڽأڬۏأڲہتټۏًڽأوۏڽأًتزۏًڽأڬۏأڲۄشتۏًڽأوۏڽأمعتةەأذتدحألشوتحەأحہەأ؏أإځأڬضۏأثہۏأزشرحأۏتأځحہشأڬەأمشۏثأضەأڲصشحەأحًأتىأځحہشًڽأتًشأزشرحًڽأضەأإًتصأإحۏأ="
"6943","أذعشحأذثۏثۄأثىحأحدشتۆألشوتحۏأۄۏڽأ=أصوتىۄأدتۄهۏحأوۏڽأۄوتشتأتۏڬأډثًحشتأۄًحتأحہتأوۏڽأىەأتضأڬەأشًطىأزتىأضەأدہتىڬأڬشأظلتأتًشألشًۄأڬەأزشوۏتىأزۏڬہتأحًأودہەأشضًهأتههۄأ﷽أزڬہتةۏأزۏةەأ؏أإځأ﷽أتضأًمحأضؼۏأڬشأشۄەأحہەأتًشأتځىەأظذتثۄأڬشتوأضەألشوتأشۄەأحہەأ؏أضؼۏأڬشًأڬۏًىڬۄأتههۄأحؼتهۏٳأىەأحوأځشأضؼۏألشعأڬۏأۄەأۗأإځألشوتحۏأۄۏڽأ=أوۏڽأىەأذعًشأ﷽أڬًأزۏڬہتأڬۄأضؼۏأڬۏأطزحأڬۏأًدۄأضەأإځأىەأتځىتأتصتشأتځىەأځۏټأڬەأڲشزأثتىزہأهۏتأحہتأذحۏٳأڬۄأوۏڽأىەأإځأ﷽أڬۏأثؽهًڽأڬۏأتًشأشتىًڽأڬۏأضلۏزۏأزۏڬہۏأۗأ"
"6944","أذثۏثۄأثىحأتثۏأحدشتۆألشوتحۏأۄۏڽأ=أوۏڽأډىزأمشۏطۏأرًتحۏىأڬەأۄوشتۄأتثًذضۏىأڬۏأذًۏهۏأوۏڽأڲةۏأ؏أشضًهأتههۄأ﷽أتضأًمحأظلتأتًشأوشًۄأڬەأزشوۏتىأضؼۏأڬشأشۄەأحہەأ؏أحۏصأزًڔىەأضثثأإځأ﷽أتځىتأحۄثىزأهځۏټەأۄًةەأحہەأ؏أتًشأإځأظذتثۄأڬشتوأضەألشوتأشۄەأحہەأضؼۏأڬشًأ؏أڬۏًىڬۄأتههۄأحؼتهۏٳأىەأحوأځشأضؼۏأهتصوأڬۏأۄەأۗأ"
"6945","أوظؼثأثىأؼثزتههۄأصثۏشۏألشوتحەأۄۏڽأ=أتًشأتوألشًۄأثىحأتثۏأمذتلۄأشعۏأتههۄأؼىۄتأذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأڬۏأثۄىأتًشأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬۏأځہًځہۏأۄۏڽأۗأتىأڬۏأًتهزۄأ““أۄىزأثىحأىلۏهأثىأثدۏشأثىأؼثۏزأثىأمظۏأ‛‛أۄۏڽأۗأذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأىەأتىأڬتأىڬتذأذعشحأتطؼخأثىأمۏضأشعۏأتههۄأؼىۄأضەأڬۏتأ؏أتىأڬەأۄتڽأوذوزأ؏أتضذتمأ؏أذثتثۄأتًشأمشۏثۄأ+أډتشأثډەأ"
"6946","أذعشحأتوۏوۄأثىحأشمۏمۄأشعۏأتههۄأؼىۄتأثۏتىأڬشحۏأۄۏڽأڬۄأوۏڽأىەأوضهوتىأرًتحۏىأڬەأۄوشتۄأشضًهأتههۄأ﷽أڬۏأثۏؼحأڬۏأ؏أۄوأىەأذعًشأ﷽أضەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أۄوأإځأڬۏأرزوحأتضأډۏصأڬۏأثۏؼحأڬشىەأڬەأهةەأذتعشأۄًةۏأۄۏڽأڬۄأۄوأتههۄأحؼتهۏٳأڬەأضتحہأڬضۏأډۏصأڬًأطشۏڬأىۄۏڽأټہۄشتةۏڽأڲۏأ؏أډًشۏأىۄۏڽأڬشۏڽأڲۏأ؏أصىتأىۄۏڽأڬشًتةۏڽأڲۏأ؏أتځىۏأتًهتزًڽأڬًأمحهأىۄۏڽأڬشۏڽأڲۏأ؏أڬضۏأځتڬأثتصأځشأثۄحتىأىۄۏڽأهڲتةۏڽأڲۏأ؏أىۏڬۏأڬەأڬتوأوۏڽأإځأڬۏأىتلشوتىۏأىۄۏڽأڬشۏڽأڲۏأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أتځىۏأ+أۏًڽأڬۄًأڬۄأۄوأتځىۏأ"
"6947","%أوذوزأثىأؼوشألشوتحەأۄۏڽأ=أتوۏوۄأثىحأشمۏمۄأشعۏأتههۄأؼىۄتأۗأشمۏمۄأ؏أتىأڬۏأًتهزۄأۄۏڽأ؏أتًشأتىأڬەأًتهزأڬتأىتوأ““أؼثزتههۄأثىأثدتزأثىأؼوۏشأثىأذتشخأثىأذتشخۄأثىأضؼزأثىأحۏوأثىأوشۄأ‛‛أۄەأۗأتىأڬۏأًتهزۄأ““أشمۏمۄأثىحأرًۏهزأثىأتضزأثىأؼثزتهؼصۏٳأ‛‛أۄۏڽأ؏أىثۏأتڬشوأ﷽أڬۏأصًدۄأوذحشوۄأذعشحأرزۏدۄأشعۏأتههۄأؼىۄتأڬۏأثۄىأۄۏڽأ؏أتىأڬەأطًۄشأڬەأتىحمتهأڬەأثؼزأ؏أذثۏثأثىأڬؼثأثىأؼحۏشأخملۏأضەأتىأڬۏأطتزۏأۄًةۏأ؏أتىأڬەأۄتڽأ““أىۄزۏۄأ‛‛أځۏزتأۄًةۏڽأ؏أذعشحأتوۏوۄأثىحأشمۏمۄأشعۏأتههۄأؼىۄتأشضًهأتههۄأ﷽أڬەأًظتهأڬەأثؼزأصىزۄأشۄۏڽأ؏أتًشأذعًشأ﷽أضەأشًتۏحأثہۏأڬۏأۗ"
"6948","أشضًهأتههۄأ﷽أڬۏأظتذثصتزۏأذعشحألتغوۄأشعۏأتههۄأؼىۄتأڬۏأرتهۄأذعشحأتوۏوۄألشوتحۏأۄۏڽأ=أۄوأىەأشضًهأتههۄأ﷽أڬۏأثۏؼحأڬۏأ؏أإځأىەأۄوأضەأًؼزۄأهۏتأڬۄأۄوأتههۄأڬەأضتحہأڬضۏأڬًأطشۏڬأىۄۏڽأټہۄشتةۏڽأڲۏأۗأتضأڬەأثؼزأتثىأتضذتمأڬۏأتثىأتهوىڬزشأضەأشًتۏحأڬشزۄأذزۏخأڬەأوًتلمأولظهأذزۏخأثۏتىأڬۏأۗأ"
"6949","أذعشحأثشۏشۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أوۏشەأثتشەأحۏىأډۏصۏڽأضىحأمشتشأځتةۏأۄۏڽأۗأوۏشەأځتضأظزمەأڬتأڲًطحأإحتأحہتأ؏أوۏڽأًۄأڲًطحأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬًأحذلەأوۏڽأثہۏدأزۏحۏأحہۏأ؏أوۏشەأځتضأ<أتًمۏۄأډتىزۏأحہۏأ؏أتوأتهوًوىۏىأىەأودہەألشوتۏتأ=أتڲشأحۏشەأوًتهۏأډتۄۏڽأحًأتىأڬًأتځىەأتًځشأڲىأضڬحەأۄۏڽأۗأۏۄأذزۏخأًهتؤأڬەأسڬشأوۏڽأۄەأولظهأذزۏخأۄەأۗأ"
"6950","%توأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬۏأثتىزۏأذعشحأهۏهۏألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أمعتةەأذتدحأڬەأهةەأ+أثۏحأتهرهتؤأوۏڽأ"
"6951","%أذعشحأدثۏشأثىأوغؼوأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتۏڬأمشۏطۏأوۏڽأزًأ+أؽۏشأ"
"6952","%أتضوتؼۏهأثىأؼثۏزأثىأشلتؼۄأثىأشتلؼأصشمۏأتځىەأًتهزأضەأ؏أًۄأتىأڬەأزتزتأضەأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأضەألشوتۏتأ=أتەأؼوشأ$أتځىۏأمًوأڬًأوۏشەأځتضأدوؼأڬشًأ؏أذعشحأؼوشأشعۏأتههۄأؼىۄأىەأضثأڬًأدوؼأڬۏتأتًشأذعًشأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًأڬشأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أوۏڽأىەأضثأڬًأدوؼأڬشأهۏتأۄەأ؏أًۄأإځأڬەأځتضأتىزشأإأدتةۏڽأۏتأإځأرًزأتىأڬەأځتضأحطشۏلأهەأدتةۏڽأڲەأآأإځأ﷽أىەألشوتۏتأ=أوۏڽأرًزأتىأڬەأځتضأدتحتأۄًڽأ؏أۏۄأثتحأوۄتدشۏىأتًشأتىظتشأىەأضىأهۏأ؏أًۄأهًڲأڬۄىەأهڲەأ=أمشۏطأوۏڽأًذۏأىتصهأۄًةۏأ؏أحًأزۏڬہىەأًتهەأتًشأضىىەأًتهەأضثأهًڲأ+أۏۄأضىىەأڬەأهةەأ"
"6953","%أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأتۏڬأزلؼۄأڬتأسڬشأۄەأڬۄأۄوأهًڲأشضًهأتههۄأ﷽أڬەأ+أڲہشأڬەأ"
"6954","أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أتۏڬأزلؼۄأڬتأسڬشأڬەأۄوأشضًهأتههۄأ﷽أڬەأ+أڲہشأڬەأ"
"6955","أؼوشًأثىأؼخوتىأثىأؼلتىألشوتحەأۄۏڽأ=أوۏشەأًتهزأىەأودہەأڬۄتأ=أتەأوۏشەأځۏتشەأثۏټەأ$أتڲشأحوۄۏڽأهًڲًڽأڬەأڬضۏأوؼتوهۄأڬتأًتهۏأثىتۏتأدتةەأحًأمشۏطأڬۏأؼصحأڬشىتأڬۏًىڬۄأوۏڽأىەأشضًهأتههۄأ﷽أڬًأۏۄألشوتحەأۄًةەأضىتأۄەأڬۄأ““أدضأىەأمشۏطأڬۏأثەأؼصحۏأڬۏأ؏أتضەأتههۄأحؼتهۏٳأسهۏهأڬشأزەأڲتأ‛‛ۗأ"
"6956","%أذعشحأضؼزأثىأتثۏأًمتظأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأمشۏطأڬًأشضًتأڬشىەأڬتأضًډەأڲتأتههۄأحؼتهۏٳأتضەأسهۏهأڬشأزەأڲتأۗ"
"6957","%أذعشحأضؼزأثىأتثۏأًمتظأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأمشۏطأڬًأشضًتأڬشىەأڬتأضًډەأڲتأتههۄأحؼتهۏٳأتضەأسهۏهأڬشأزەأڲتأۗ"
"6958","%أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأشضًهأتههۄأ﷽أڬًأوىثشأځشأثۏتىأڬشحەأۄًةەأضىتأ=أتىأهًڲًڽأڬتأڬۏتأذطشأۄًأڲتأدًأڬۄحەأۄۏڽأڬۄأوۏشۏأشطحۄأزتشۏأىلؼأىۄۏڽأزەأڲۏأۗأڬۏًڽأىۄۏڽأ؏أتههۄأڬۏأمضوأ$أوۏشۏأشطحۄأزتشۏأزىۏتأتًشأإرشحأوۏڽألتةزۄأوىزأۄەأۗأتەأهًڲًأ$أوۏڽأذًعأڬًخشأځشأحوۄتشتأتىحػتشأڬشًڽأڲتأ؏أدثأوۏڽأإاڽأڲتأحًأهًڲأڬہڔەأۄًأدتةۏڽأڲەأ؏أۏۄأطرظأڬۄەأڲتأ=أۏتأشضًهأتههۄأ﷽أۏۄأوۏڽأۄًڽأ؏أۏۄأڬۄەأڲتأ=أۏتأشضًهأتههۄأ﷽أۏۄأوۏڽأۄًڽأۗأًۄأڬۄەأڲتأ=أۏتأشضًهأتههۄأ﷽أۏۄأوۏڽأۄًڽأۗأوۏڽأڬۄًڽأڲتأ=أوۏڽأىەأحوۄۏڽأځۄډتىأهۏتأۄەأ؏أهۏڬىأحوأىەأوۏشەأثؼزأثزؼحۏڽأتۏدتزأڬشأهۏأحہۏڽأتًشأحوأتهټەأځتاڽأځہشأڲةەأحہەأۗ"
"6959","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتۄهأصوۏىأڬەأهةەأترحهتلتحأضەأتوتىأۏۄأۄەأڬۄأتوتشحأمشۏطأڬًأضًىځۏأدتةەأ؏أتًشأمشۏطأتههۄأًتهەأۄۏڽأ؏أدثأؼشثأڬتأڬًةۏأمثۏهۄأتىأڬتأورتهلأثىحتأۄەأًۄأتثهۏضأڬۏأدوتؼحأثىأدتحتأۄەأۗ"
"6960","%أذعشحأؼثتضأثىأؼثزتهوغهثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأهًڲأمشۏطأضەأوهحەأحہەأ؏أًۄأهًڲأثتحأډۏحأڬشأشۄەأۄًحەأ؏أتىأڬًأزۏڬہحەأۄۏأًۄأهًڲأتځىۏأثتحأرحوأڬشأزۏحەأ؏أتضأؼوهأڬتأسڬشأۄوأىەأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأڬۏتأحًأإځأ﷽أىەألشوتۏتأ=أتضأمًوأڬتأڬۏتأذطشأۄًأڲتأدًأإځضأوۏڽأثتحأډۏحأڬشحەأۄۏڽأ؏أدۏضەأۄۏأوۏشەأڬضۏأشطحۄأزتشأڬًأزۏڬہحەأۄۏڽأحًأتځىۏأثتحأرحوأڬشأزۏحەأۄۏڽأ؏أتههۄأڬۏأمضوأ$أڬضۏأطرظأڬەأزهأوۏڽأتضأًمحأحڬأتۏوتىأزترهأىۄۏڽأۄًأضڬحتأدثأحڬأمشۏطأڬەأضتحہأتههۄأڬۏأشعتأڬەأهةەأتًشأوۏشۏأشطحۄأزتشۏأڬۏأثىتؤأځشأوذثحأىۄأڬشەأۗ"
"6961","أۏصۏزأثىأتثۏأصۏتزأؼثزتههۄأثىأتهذتشخأڬەأًتضغەأضەأذعشحأؼثتضأثىأؼثزتهوغهثأشعۏأتههۄأؼىۄأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أدثأمشۏطأهًڲأتۏڬأزًضشەأضەأوهحەأۄۏڽأحًأثۄحأرىزۄأځۏطتىۏأضەأوهحەأۄۏڽأ؏أهۏڬىأدثأًۄأۄوأضەأوهحەأۄۏڽأحًأتىأڬەأډۄشًڽأځشأىتڲًتشۏأڬەأإختشأۄًحەأۄۏڽأۗأذعشحأؼثتضأثىأؼثزتهوغهثألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أثۄحأضرحأىتشتعأۄًةەأځہشألشوتۏتأ=أتضأستحأڬۏأمضوأ$أدضأڬەأمثعۄأمزشحأوۏڽأوذوزأڬۏأدتىأۄەأ؏أڬضۏأإزوۏأڬەأزهأوۏڽأتضأًمحأحڬأتۏوتىأزترهأىۄۏڽأۄًأضڬحتأدثأحڬأًۄأتههۄأتًشأتضأڬەأشضًهأڬۏأشعتأڬەأهةەأحوأضەأوذثحأىۄۏڽأڬشەأڲتأۗأ"
"6962","أذعشحأؼهۏأتثىأتثۏأغتهثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتةوۄأ؏أمشۏطأوۏڽأضەأۄًڽأڲەأ؏أتىأڬەأىۏڬأهًڲأ؏أىۏڬًڽأڬەأتوتوأۄًڽأڲەأ؏أتًشأتىأڬەألدتشأ؏ألتدشًڽأڬەأتوتوأۄًڽأڲەأ؏أۄشأتۏڬأڬتأذمأۄەأتًشأۄشأذمأًتهەأڬًأتضأڬتأذمأزًأ؏أتڲشأوۏڽأڬضۏأضۏتۄألتوأؽهتوأڬًأحوأځشأتوۏشأومششأڬشأزًڽأحًأحوأتضأڬۏأثہۏأتغتؼحأڬشىتأتًشأتضأڬۏأتضأًمحأحڬألشوتىثشزتشۏأڬشىتأدثأحڬأحوۄۏڽأتضأڬەأتضهتوأتًشأتضأڬۏأڲشزىأوتشىەأڬەأزشوۏتىأترحۏتشأىۄأزۏتأدتةەأ؏أتًشأتضأڬەأتضهتوأتًشأتضأڬۏأڲشزىأوتشىەأوۏڽأڬضۏأڬًأترحۏتشأزۏتأدتةەأحًأًۄأتضأڬۏأڲشزىأوتشىەأڬًأحشدۏذأزەأ؏أڬۏًىڬۄأىۄأحًأتضأڬۏأزىۏتأۄەأتًشأىۄأتضهتوأڬًأډہًڔأڬشأتضأڬۏأڬًةۏأإرشحأۄەأۗأ"
"6963","%أذعشحأدتثشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أغلۏهأثىأؼوشًأشعۏأتههۄأؼىۄأىەأىثۏأتڬشوأ﷽أضەأؼشعأڬۏأ=أڬۏتأإځأزًضأڬەأمهؼۄأتًشأتضأڬەأډًڬۏزتشًڽأځشأمثعۄأڬشىتأډتۄحەأۄۏڽأآأشضًهأتههۄأ﷽أىەأتىظتشأڬەألعتةهأڬۏأثىتؤأځشأتضأثتحأضەأتىڬتشأڬشأزۏتأۗأشتًۏأىەألشوتۏتأ=أغلۏهأىەأۄدشحأڬۏأتًشأتضأڬەأۄوشتۄأتضأڬۏأمًوأڬەأتۏڬأإزوۏأىەأۄدشحأڬۏأ؏أًۄأإزوۏأثۏوتشأۄًأڲۏتأ؏أتًشأثۄحأثەأمشتشأۄًتأۗأ+أتضأومتوأځشأثەأمشتشۏأڬەأهةەأ““أعدشأ‛‛أۏتأتضأضەأوهحتأدهحتأڬًةۏأهلػأثًهتأ"
"6964","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأتههۄأحؼتهۏٳأڬەأتشطتزأ="
"6965","%أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەألشوتۏتأ=أوۄتدشۏىأڬەأهةەأضًىەأڬەأوىثشأۄًڽأڲەأ؏أمۏتوحأڬەأزىأۏۄأهًڲأڲہثشتۄټأضەأثەأرًلأتىأوىثشًڽأځشأدهًۄأتلشًصأۄًڽأڲەأۗأځہشأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄأىەأڬۄتأ=أتههۄأڬۏأمضوأ$أتڲشأوۏڽأۏۄأذظۄأڬضۏأڬەأهةەأضىثہتهأڬشأشڬہأضڬحتأۄًحتأحًأتځىۏأمًوأڬەأهةەأضىثہتهأڬشأشڬہأهۏحتأۗ"
"6966","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أذتغثأثىأتثۏأثهحؼۄأىەأتۄهأوڬۄأڬۏأدتىثأرغأهڬہتأ؏أتههۄأحؼتهۏٳأىەأتځىەأىثۏأ﷽أڬًأتضأڬۏأتغهتؼأؼغتألشوتأزۏأۗأىثۏأتڬشوأ﷽أىەأذعشحأؼهۏأشعۏأتههۄأؼىۄأتًشأذعشحأصثۏشأشعۏأتههۄأؼىۄأڬًأرغأڬەأحؼتمثأوۏڽأثہۏدتأ؏أتىأزًىًڽأىەأتۏڬأؼًشحأڬًأتۏڬأتًىټأځشأدتحەأۄًةەأځتۏتأ؏أتضأڬۏأوۏىڋہۏًڽأوۏڽأضەأرغأىڬتهأهۏتأ؏أتًشأهەأڬشأىثۏأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأځۏطأڬۏتأ؏أذعًشأ﷽أڬۏأثتشڲتۄأوۏڽأۏۄأرغأځڔہأڬشأضىتۏتأڲۏتأ؏أإځأ﷽أىەأذتغثأڬًأثهًتۏتأتًشأتضأضەألشوتۏتأ=أتەأذتغثأ$أۏۄأرغأحًأىەأهڬہتأۄەأآأتضأىەأڬۄتأ=أدۏأۄتڽأۏتأشضًهأتههۄأ﷽أ؏أىثۏأتڬشوأ﷽أىەألشوتۏتأ=أحًأىەأتۏضتأڬۏًڽأڬۏتأآأتضأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أ؏أوۏڽأتههۄأتًشأتضأڬەأشضًهأڬتأرۏشأرًتۄأۄًڽأ؏أهۏڬىأوۏڽأتۄهأوڬۄأوۏڽأتدىثۏأحہتأدثڬۄأوۏشەأتۄهأًأؼۏتهأتىۄۏڽأهًڲًڽأڬەأثۏډأوۏڽأۄۏڽأ؏أودہەأتځىەأثډًڽأڬەأثتشەأوۏڽأڋشأحہتأ؏أتضأهةەأوۏڽأىەأتىأڬۏأدتىثأتۏڬأرغأهڬہأزۏتأدضأڬتأتههۄأتًشأتضأڬەأشضًهأڬًأڬضۏأمضوأڬتأڬًةۏأىمظتىأىۄۏڽأحہتأ؏أۄتڽأتهثحۄأوۏشەأتۄهأًأؼۏتهأڬەأهةەأتضأوۏڽألتةزۄأۄًأضڬحتأحہتأۗأذعشحأؼوشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأتځىۏأحهًتشأىڬتهۏأتًشأؼشعأڬۏتأ=أۏتأشضًهأتههۄأ﷽أتضەأوۏشەأمثعەأوۏڽأزۏدةەأ؏أتضأىەأڬلشأڬۏتأۄەأ؏أوۏڽأتضأڬًأمحهأڬةەأزۏحتأۄًڽأۗأشضًهأتههۄأ﷽أىەألشوتۏتأ=أتەأتثىأرغتثأ$أحدہەأڬۏتأوؼهًوأ؏أطتۏزأڬۄأتههۄأحؼتهۏٳأىەأتۄهأثزشأڬۏأتىأڬًحتۄۏًڽأضەأإڲتۄأۄًىەأڬۏأثىتؤأځشأۄۏأتىأضەألشوتۏتأحہتأ=أحوأدًأډتۄًأؼوهأڬشًأ؏أوۏڽأىەأحوۄۏڽأثرطأزۏتأۄەأۗ"
"6967","%أذعشحأؼثزتهشذوىأثىأؼًلأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أغهذۄأثىأؼثۏزتههۄأڬۏأؼتوشأثىألۄۏشۄأڬەأضتحہأڬًةۏأحهرأڬهتوۏأۄًأڲةۏأ؏أشضًهأتههۄأ﷽أىەأ+أغهذۄأضەأ"
"6968","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أثەأطڬأتههۄأحؼتهۏٳأىەأتۄهأثزشأڬًألعۏهحأثرطۏأ؏أتىأڬەأثتشەأوۏڽألشوتۏتأ=أحوأدًأډتۄًأؼوهأڬشًأ؏أوۏڽأىەأحوۄۏڽأثرطأزۏتأۄەأۗ"
"6969","%أذعشحأتثۏأثىأڬؼثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أمۏتوحأڬەأزىأوۏڽأىثۏًڽأڬتأتوتوأۄًڽأڲتأ؏أوۏڽأتىأڬتأرغۏثأۄًڽأڲتأ؏أطلتؼحأڬشەأًتهتأوۏڽأۄًڽأڲتأ؏أهۏڬىأودہەأتىأوۏڽأضەأڬضۏأثتحأځشأثہۏألرشأىۄۏڽأۄەأۗ"
"6970","%أذعشحأڬؼثأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتځىەأإرشۏأرغثۄأوۏڽأتشطتزألشوتۏتأ=أتەأڲشًۄأوۄتدشۏىأ$أحوأثڔہحەأدتأشۄەأۄًأتًشأتىظتشأرحوأۄًأډڬەأۄۏڽأ؏أثەأطڬأًۄأتىظتشأوۏشەأوززڲتشأۄۏڽأ؏أحوأتځىەأوذضىًڽأڬۏأؼصحأًأحًمۏشأڬشًأتًشأتىأڬۏأرغتاڽأڬًأزشڲصشأڬشًأۗ"
"6971","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أتځىۏأوشعأوۏڽأثتۄشأحطشۏلأهتةەأ؏أإځأڬەأضشأوثتشڬأځشأڬځڔتأثىزہتأۄًتأحہتأ؏أإځأ﷽أىەألشوتۏتأ=أؼتوأهًڲأثڔہحەأدتةۏڽأڲەأتًشأتىظتشأڬوأۄًحەأدتةۏڽأڲەأ؏أۏۄتڽأحڬأڬۄأتىظتشأڬۏأحؼزتزأثتمۏأهًڲًڽأڬەأومتثهەأوۏڽأ+أإټەأوۏڽأ"
"6972","%أذعشحأتثًمحتزۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأوىثشأطشۏلأځشأتىظتشأڬًأورتغثأڬشحەأۄًةەألشوتۏتأ=أرثشزتشأ$أثەأطڬأهًڲأؽۏشأوطۄًشأۄۏڽأ؏أدثڬۄأتىظتشۏأوۏشۏأځۄډتىأۄۏڽأۗأتڲشأحوتوأهًڲأتۏڬأشتضحەأځشأډهۏڽأتًشأتىظتشأتۏڬأشتضحەأوۏڽأډهۏڽأحًأوۏڽأتىظتشأڬەأشتضحەأځشأډهًڽأڲتأۗأدضأڬًأتىأوۏڽأضەأڬضۏأڬەأڬضۏأوؼتوهەأڬتأسوۄأزتشأثىتۏتأدتةەأحًأًۄأتىأڬەأتډہتةۏأڬشىەأًتهەأڬەأضتحہأتډہتةۏأڬشەأتًشأتىأڬەأرغتأڬتشأڬًأوؼتلأڬشەأ؏أدضأىەأتىأڬًأځشۏطتىأڬۏتأحًأتضأىەأودہەأځشۏطتىأڬۏتأ؏أتڲشأۄدشحأىۄأۄًحۏأحًأوۏڽأثہۏأتىظتشۏًڽأوۏڽأضەأۄًحتأۗ"
"6973","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأذعشحأتثًغهذۄأشعۏأتههۄأؼىۄأڬەأثتشەأوۏڽأثۏتىأڬشحەأۄۏڽأڬۄأًۄأشضًهأتههۄأ﷽أڬۏأوشعأًلتحأوۏڽأتىأڬەأځتضأإةەأ؏أشضًهأتههۄأ﷽أىەأتىأضەألشوتۏتأ=أتځىۏأمًوأڬًأوۏشتأضهتوأڬۄىتأ؏أڬۏًىڬۄأًۄأهًڲأځتڬأزتوىأتًشأظتثشأۄۏڽأۗ"
"6974","%أذعشحأتىضأثىأوتهڬألشوتحەأۄۏڽأ=أذعشحأتضۏزأثىأذعۏشأتطۄهۏأشعۏأتههۄأؼىۄأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًةەأ؏أتضأًمحأحڬأشضًهأتههۄأ﷽أضثأغؼتوأحمضۏوألشوتأډڬەأحہەأ؏أإځأ﷽أڬًأتىظتشأڬەأمثۏهەأثىۏأػلشأڬەأثتشەأوۏڽأثحتۏتأڲۏتأڬۄأًۄأثۄحأعشًشحأوىزأۄۏڽأۗأتضأڲہشتىەأوۏڽأصۏتزۄأؼًشحۏڽأۄۏڽأ؏أشضًهأتههۄأ﷽أىەأتىأضەألشوتۏتأ=أتەأتضۏزأحوأىەأۄوۏڽأډہًڔأزۏتأ؏أتًشأدًأڬډہأۄوتشەأۄتحہأوۏڽأحہتأضثأډهتأڲۏتأ؏أ+أإةىزۄأضەأۏًڽأڬشىتأڬۄأ"
"6975","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أزًشأزشتصأضەأځتىۏأثہشأڬشأهتىتأتىظتشأڬەأهةەأثۄحأزطًتشأحہتأ؏أًۄأهًڲأىثۏأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًةەأ؏أحتڬۄأإځأ﷽أتىأڬەأهةەأزؼتألشوتأزۏڽأۏتأتىأڬەأهةەأىۄشأڬہزًتأزۏڽأۗأىثۏأتڬشوأ﷽أڬًأتىأڬەأثتشەأوۏڽأثحتۏتأڲۏتأحًأإځأ﷽أىەألشوتۏتأ=أحوأإدأودہأضەأدًأڬډہأثہۏأوتىڲًأڲەأ؏أوۏڽأحوۄۏڽأزًڽأڲتأۗأدثأتىۄًڽأىەأشضًهأتههۄأ﷽أڬتأۏۄأتشطتزأؼتهۏأضىتأحًأڬۄىەأهڲەأ=أإځأۄوتشەأهةەأوؽلشحأڬۏأزؼتألشوتأزۏڽأۗأشضًهأتههۄأ﷽أىەأتىأڬەأهةەأۏًڽأزؼتأوتىڲۏأ““أتەأتههۄأتىظتشأڬۏأوؽلشحألشوتأ؏أتىظتشأڬۏأتًهتزًڽأڬۏأوؽلشحألشوتأ؏أتىأڬۏأتًهتزًڽأڬۏأتًهتزًڽأڬۏأوؽلشحألشوتأ‛‛ۗ"
"6976","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أتىظتشأڬەأڬډہأثډًڽأ؏أؽهتوًڽأتًشأهًىڋۏًڽأڬۏأدتىثأوحًدۄأۄًةەأتًشألشوتۏتأ=أتههۄأڬۏأمضوأ$أوۏڽأحوأضەأوذثحأڬشحتأۄًڽأۗ"
"6977","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتىظتشأڬەأزًأمثۏهًڽأ““أتًضأ‛‛أتًشأ““أرصشدأ‛‛أىەألرشأڬۏتأۗ"
"6978","%أذعشحأدشۏشأثىأؼثزتههۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۄتدشۏىأتًشأتىظتشأزىۏتأتًشأإرشحأوۏڽأتۏڬأزًضشەأڬەأزًضحأتًشأوززڲتشأۄۏڽأۗأتًشأمشۏطأڬەأغهمتؤأ+أدىأهًڲًڽأڬًألحذأوڬۄأڬەأوًمؼأځشأتضهتوأمثًهأڬةەأثؽۏشأڬًةۏأډتشۄأىۄأحہتأتًشأوًشزأتذضتىأثىەأۗأ"
"6979","%أذعشحأؼوشًأثىأؼثضۄأضهوۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أؽصًۄأڬەأهةەأحۏتشأڬةەأڲةەأڲہًڔًڽأڬتأوؼتةىۄألشوتأشۄەأحہەأ؏أتضأًمحأإځأ﷽أڬەأځتضأؼۏۏىۄأثىأثزشتهلصتشۏأوًدًزأحہەأ؏أشضًهأتههۄأ﷽أىەأتىأضەأڬۄتأ=أڲہًڔًڽأڬەأثتشەأوۏڽأحدہأضەأصۏتزۄأوۏڽأدتىحتأۄًڽأ؏أذعشحأؼۏۏىۄأىەأڬۄتأ=أتًشأوۏڽأوشزًڽأڬەأثتشەأوۏڽأإځأضەأصۏتزۄأدتىحتأۄًڽأۗأشضًهأتههۄأ﷽أىەألشوتۏتأ=أثحتۏةەأضثأضەأثۄحشأوشزأڬًىأۄەأآأؼۏۏىۄأىەأڬۄتأ=أىدزأڬەأًۄأثتطىزەأًۄأدًأتځىۏأحهًتشۏڽأتځىەأڬىزہًڽأځشأتټہتحەأۄۏڽأ؏أتځىەأىۏصەأتځىەأڲہًڔًڽأڬۏأصۏىًڽأځشأشڬہحەأۄۏڽأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أحوأىەأدہًټأثًهتأۄەأ+أثۄحشۏىأوشزأىدزأڬەأهًڲأىۄۏڽأ"
"6980","%أذعشحأتثًتۏًثأتىظتشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أمثۏهۄأتضهوأ؏أؽلتشأ؏أتطدؼأ؏أوصۏىۄأ؏أدۄۏىۄأتًشأثىۏأڬؼثأوۏڽأضەأدضأڬتأڬًةۏأوًهۏٳأىۄۏڽأۄەأتههۄأتًشأتضأڬتأشضًهأتىأڬتأوًهۏٳأۄەأۗ"
"6981","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أمثۏهۄأؽلتشأ؏أتههۄأحؼتهۏٳأتىأڬۏأوؽلشحألشوتةەأ؏أتًشأمثۏهۄأتضهوأ؏أتههۄأحؼتهۏٳأتىأڬًأضهتوحأشڬہەأۗأۏۄأثتحۏڽأوۏڽأىۄۏڽأڬۄۄأشۄتأ؏أۏۄأتههۄأحؼتهۏٳأڬۏأدتىثأضەأۄەأۗ"
"6982","أذعشحأتۏتضأثىأضهوۄأثىأتڬًؼأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىوتصأوۏڽأڬہڔەأۄًأڬشأؼشثأڬەأمثتةهأڬەأهةەأۏًڽأزؼتأوتىڲحەأحہەأ““أتەأتههۄأ$أمثۏهۄأشؼهأ؏أسڬًتىأتًشأؼظۏۄأدىۄًڽأىەأتههۄأتًشأتضأڬەأشضًهأڬۏأىتلشوتىۏأڬۏأۄەأ؏أتًشأثىۏأهذۏتىأځشأهؼىحألشوتأ‛‛ۗأتًشأإځأڬۄحەأ=أؽلتشأڬۏأ؏أتههۄأحؼتهۏٳأوؽلشحألشوتةەأ؏أتًشأمثۏهۄأتضهوأڬًأتههۄأحؼتهۏٳأضهتوحأشڬہەأ؏أۏۄأثتحۏڽأوۏڽأىەأىۄۏڽأڬۏڽأثهڬۄأۏۄأتههۄأحؼتهۏٳأىەأڬۏأۄۏڽأۗأدضأدضأمثۏهەأڬەأهةەأزؼتأوتىڲىۏأۄًحۏأ؏أتىأضثأڬەأهةەأوتىڲأڬشأإځأ﷽أحڬثۏشأڬۄحەأۗأ"
"6983","أذعشحأضهوۄأثىأتڬًؼأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أؼتوشأثىأغلۏهأشضًهأتههۄأ﷽أڬۏأدتىثأضەأتوتىأڬەأثؼزأطۄشأوۏڽأزترهأۄًتأ؏أدثأًۄأىثۏأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأحًأشضًهأتههۄأ﷽أىەأتضأضەألشوتۏتأ=أتەأؼتوشأ$أتضهتوأهەأإأ؏أحًأضهتوحۏأځتةەأڲتأۗأتضأىەأڬۄتأ=أدۏأۄتڽأ؏أوڲشأتضأطشغأځشأڬۄأوۏشەأهةەأزۏۄتحۏأؼهتمۄأۄًأڲتأتًشأإځأڬەأهةەأطۄشۏأؼهتمۄأۗأإځأ﷽أىەألشوتۏتأ=أتۏضتأىۄۏڽأۄًأڲتأ؏أحًأتضهتوأمثًهأڬشأهەأ؏أضهتوحۏأځتةەأڲتأۗأځہشأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أتەأؼتوشأ$أتثہۏألۏأتهذتهأحوأډهەأدتاأ؏أڬهأحڬأۄوأحۏشەأوؼتوهەأځشأؽًشأڬشحەأۄۏڽأۗأشضًهأتههۄأ﷽أىەأتىظتشأڬۏأدتىثأځۏؽتوأثہۏدتأتًشأتىأضەأوطًشۄأڬۏتأڬۄأوۏڽأىەأتضأإزوۏأڬًأزؼًحأزۏأحہۏأ؏أتضأىەأتضهتوأهتىەأڬًأتضأطشغأڬەأضتحہأوطشًغأڬشأزۏتأۄەأڬۄأتضأڬەأهةەأزۏۄتحۏأؼهتمۄأۄًأڲتأتًشأۄوتشەأهةەأطۄشۏأۗأتىظتشأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أدۏضەأتههۄأحؼتهۏٳأڬۏأوشعۏأتًشأدۏضەأإځأوىتضثأضودہۏڽأ؏أتىۄًڽأىەأڬۄتأ=أتڲشأتضأىەأۄوأضەأتۏڬأؼمتهأ+أتًىټأثتىزہىەأڬۏأشضۏأ"
"6984","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأۄەأ““أدًأطرظأخىۏۆأتهوشتشأځشأډڔہەأتضأڬًأًۄأډۏصأوؼتلأڬشأزۏأدتةەأڲۏأدًأډۏصأثىۏأتضشتةۏهأڬًأوؼتلأڬشأزۏأڲةۏأحہۏأ؏أډىتىډۄأتضأځۄتڔۏأځشأضثأضەأځۄهەأثىۏأرصشدأڬەأڲہًڔەأډڔہەأحہەأۗأشضًهأتههۄأ﷽أىەألشوتۏتأ=أحوأضثأڬۏأوؽلشحأڬشأزۏأڲةۏأۄەأضًتةەأضشرأشىڲأڬەأڲہًڔەأًتهەأإزوۏأڬەأۗأشتًۏأڬۄحەأۄۏڽأ=أًۄأتۏڬأزۏۄتحۏأطرظأحہتأ؏أتځىتأڲوطزۄأتًىټأڋہًىڋحتأځہشأشۄتأحہتأ؏أۄوأىەأتضأضەأڬۄتأ=أإأدتأ؏أشضًهأتههۄأ﷽أحۏشەأهةەأوؽلشحأڬۏأزؼتأڬشأزۏڽأ؏أتضأىەأڬۄتأ=أوۏشتأڲوطزۄأتًىټأودہەأوهأدتةەأ؏أحوۄتشەأىثۏأضەأوؽلشحأڬۏأزؼتأڬشًتىەأضەأصۏتزۄأرًطۏأودہەأتضأثتحأڬۏأۄًأڲۏأۗ"
"6985","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄألشوتحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أًۄأؼًشحأىمظتىأوۏڽأىۄۏڽأۄەأدًأزًأتىظتشۏأهًىڋۏًڽأڬەأزشوۏتىأۏتأتځىەأوتڽأثتځأڬەأزشوۏتىأتحشۏأۗ"
"6986","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأثىۏأحوۏوأڬەأهةەأشضًهأتههۄأ﷽أڬۏأصثتىأضەأحۏىأثتحۏڽأضىۏأۄۏڽأ؏أدثأضەأًۄأحۏىأثتحۏڽأضىۏأۄۏڽأتضأڬەأثؼزأڬثہۏأثہۏأتىأڬەأثتشەأوۏڽأزهأوۏڽأڬًةۏأثؽعأىۄۏڽأشڬہتأۗ"
"6987","%أثۄصأثىأذڬۏوأثىأوؼتًۏۄأتځىەأًتهزأضەأ؏أًۄأتىأڬەأزتزتأضەأشًتۏحأڬشحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأتضأإۏحأ="
"6988","أدشۏشۏأىەأذڬۏوأثىأوؼتًۏۄأڬەأًتضغەأضەأتىأڬەأًتهزأڬتأۏۄأثۏتىأىمهأڬۏتأۄەأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أحوأضحشأتوحًڽأڬًأځًشتأڬشًأڬشًأڲەأ؏أتًشأتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأحوأضثأضەأصۏتزۄأثتؼصحأتًشأضثأضەأصۏتزۄأتلعهأۄًأڲەأۗأ"
"6989","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتههۄأڬەأتشطتزأ="
"6990","%أذعشحأصۏزأثىأتشموأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتىظتشأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أۄشأىثۏأڬەأڬډہأځۏشًڬتشأۄًحەأۄۏڽأ؏أۄوأىەأإځأڬۏأځۏشًۏأڬۏأۄەأ؏أإځأتههۄأحؼتهۏٳأضەأزؼتأڬۏدةەأڬۄأۄوأوۏڽأضەأۄۏأۄوتشەأحتثؼۏىأۄًڽأ؏أحًأشضًهأتههۄأ﷽أىەأزؼتألشوتةۏأ؏أشتًۏألشوتحەأۄۏڽأ=أوۏڽأىەأتضأثتحأڬتأحسڬشۄأؼثزتهشذوىأثىأتثۏأهۏهۏأضەأڬۏتأحًأتىۄًڽأىەأڬۄتأ=أصۏزأثىأتشموأڬتأۏۄأتځىتأڲوتىأۄەأۗ"
"6991","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏشەأثؼزأوۏشەأڬډہأتوحۏأځۏزتأۄًڽأڲەأ؏أًۄأتځىەأتۄهأًأؼۏتهأتًشأوتهأًأزًهحأزەأڬشأثہۏأوۏشتأزۏزتشأڬشىەأڬًأضؼتزحأضودہۏڽأڲەأۗ"
"6992","%أذعشحأتثًدوؼۄألشوتحەأۄۏڽأ=أتۏڬأزلؼۄأڬتأسڬشأۄەأڬۄأۄوأىەأشضًهأتههۄأ﷽أڬەأضتحہأىتطحۄأڬۏتأ؏أۄوتشەأضتحہأذعشحأتثًؼثۏزۄأثىأدشتذأشعۏأتههۄأؼىۄأثہۏأوًدًزأحہەأ؏أۄوأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أۄوأإځأڬەأۄتحہأځشأتضهتوأهتةەأ؏أإځأڬەأۄوشتۄأؽصًتحأوۏڽأطشڬحأڬۏأ؏أڬۏتأڬًةۏأهًڲأۄوأضەأثہۏأصۏتزۄأثۄحشأۄۏڽأآأإځأ﷽أىەألشوتۏتأ=أدۏأۄتڽأ؏أحوۄتشەأثؼزأڬډہأهًڲأۄًڽأڲەأ؏أدًأودہأځشأثىأزۏڬہەأتۏوتىأهتةۏڽأڲەأۗ"
"6993","%أذعشحأؼوشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىثۏأتڬشوأ﷽أڬەأځتضأثۏټہتأۄًتأحہتأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أڬۏتأحوأدتىحەأۄًأڬۄأتۄهأتۏوتىأوۏڽأضثأضەأتلعهأتۏوتىأڬضأڬتأۄەأآأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأىەأؼشعأڬۏتأ=أۏتأشضًهأتههۄأ﷽أ““ألشطحەأ‛‛ۗأإځأ﷽أىەألشوتۏتأ=أثتهڬهأ؏أثتحأتضۏأغشذأۄەأ؏أۏۄأتىأڬتأذمأۄەأ؏أتىأڬًأتضأذمأضەأڬۏتأډۏصأشًڬەأڲۏأ؏أدثڬۄأتههۄأحؼتهۏٳأىەأتىأڬًأۏۄأومتوأرًزأؼغتألشوتۏتأۄەأ؏أوۏشۏأوشتزألشطحًڽأڬەأؼهتًۄأۄەأ؏أظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأىەأڬۄتأ=أحًأځہشأتىثۏتؤأڬشتوأؼهۏۄوأتهضهتوأۄۏڽأ؏أڬۄأتههۄأحؼتهۏٳأىەأتىأڬًأىثًحأتًشأشضتهحأڬەأضتحہأضشلشتصألشوتۏتأۄەأ؏أإځأ﷽أىەألشوتۏتأ=أثتهڬهأ؏أثتحأزشضحأۄەأ؏أًۄأهًڲأتضۏأوىظثأڬەأذمزتشأۄۏڽأ؏أتًشأتىأڬًأتضأضەأڬۏتأډۏصأشًڬەأڲۏأ؏أدثڬۄأرًزأتههۄأحثتشڬأًأحؼتهۏٳأىەأتىأڬًأتضأومتوأځشأځۄىډتۏتأۄەأ؏أوۏشۏأوشتزأتىأڬەأؼهتًۄأۄەأۗأشتًۏأڬۄحەأۄۏڽأ=أۄوأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أځہشأًۄأڬًىأهًڲأۄۏڽأآأإځأ﷽أىەألشوتۏتأ=أڬډہأهًڲألۏأتهذتهأوشزًڽأڬۏأځطحًڽأوۏڽأۄۏڽأ؏أوۏشەأثؼزأځۏزتأۄًڽأڲەأ؏أًۄأودہەأزۏڬہەأثؽۏشأودہأځشأتۏوتىأهتةۏڽأڲەأۗأًۄأ+أمشإىأڬشۏوأڬتأ"
"6994","%أظذتثۏأشضًهأذعشحأؼثزتههۄأثىأثضشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أرًطرثشۏأۄەأتىأهًڲًڽأڬەأهةەأدىۄًڽأىەأوۏشتأزۏزتشأڬۏتأ؏أتًشأرًطرثشۏأۄەأتىأڬەأهةەأدىۄًڽأىەأتىأڬتأزۏزتشأڬۏتأدىۄًڽأىەأوۏشتأزۏزتشأڬۏتأ؏أتًشأرًطرثشۏأۄەأتىأهًڲًڽأڬەأهةەأدىۄًڽأىەأتىأڬًأزۏڬہتأدىۄًڽأىەأوۏشتأزۏزتشأڬشىەأًتهًڽأڬتأزۏزتشأڬۏتأتًشأودہأځشأتۏوتىأهەأإۏتأۗ"
"6995","%أذعشحأضهوتىأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأودہەألشوتۏتأ=أتەأضهوتىأ$أوۏشەأضتحہأثؽعأڬشأڬەأتځىتأزۏىأوحأډہًڔأثۏټہىتأ؏أوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أۏۄأڬۏضەأۄًأضڬحتأۄەأڬۄأوۏڽأإځأ﷽أضەأثؽعأڬشًڽأذتهتىڬۄأتههۄأحؼتهۏٳأىەأإځأۄۏأڬۏأثزًهحأۄزتۏحأؼغتألشوتةۏأۄەأۗأذعًشأ﷽أىەألشوتۏتأ=أتۄهأؼشثأضەأثؽعأشڬہىتأ؏أذمۏمحأوۏڽأودہأضەأثؽعأشڬہىەأڬەأوحشتزلأۄەأۗ"
"6996","أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدثأتههۄأحؼتهۏٳأىەأورهًمأڬًأځۏزتأڬۏتأ؏أحًأتىأوۏڽأضەأؼشثأڬًأډىتأ؏أځہشأؼشثأوۏڽأضەأمشۏطأڬًأډىتأ؏أځہشأمشۏطأوۏڽأضەأثىۏأۄتطوأڬًأډىتأ؏أځہشأثىۏأۄتطوأضەأتههۄأحؼتهۏٳأىەأودہەأځۏزتأڬۏتأۗأډىتىډۄأوۏڽأۄشأثۄحشۏىأوۏڽأضەأثۄحشۏىأۄًڽأۗأ"
"6997","%أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتأىەأثہۏأىثۏأتڬشوأ﷽أڬتأتۏضتأۄۏألشوتىأىمهأڬۏتأۄەأۗ"
"6998","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أؼشثأڬۏأوذثحأتۏوتىأۄەأتًشأتىأضەأثؽعأشڬہىتأوىتلمحأۄەأۗ"
"6999","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏشۏأحۏىأرظهحًڽأڬۏأًدۄأضەأؼشثأوۏڽأودہەأوذلًػأشڬہًأۗأوۏڽأؼشثۏأۄًڽأ؏أمشإىأڬشۏوأؼشثۏأۄەأۗأدىحۏًڽأڬۏأصثتىأؼشثۏأۄەأۗ"
"7000","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏشۏأحۏىأرظهحًڽأڬۏأًدۄأضەأؼشثأوۏڽأودہەأوذلًػأشڬہًأۗأوۏڽأؼشثۏأۄًڽأ؏أمشإىأڬشۏوأؼشثۏأۄەأ؏أدىحۏًڽأڬۏأصثتىأؼشثۏأۄەأۗ"
"7001","أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأطرظأظذۏذأغًشأځشأؼشثۏأثًهأضڬحتأۄًأ؏أًۄأڬًةۏأزًضشۏأصثتىأىۄأثًهەأ؏أڬۏًىڬۄأتضأضەأىلتمأځۏزتأۄًحتأۄەأۗأ"
"7002","أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأ+أثهتأعشًشحأ"
