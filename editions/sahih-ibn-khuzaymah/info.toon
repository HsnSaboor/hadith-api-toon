"1886","بَابُ الْأَمْرِ بِالتَّزَيُّنِ عِنْدَ إِرَادَةِ الطَّوَافِ بِالْبَيْتِ بِلُبْسِ الثِّيَابِ،بیت اللہ کا طواف کرتے وقت کپڑے پہن کر زیب و زینت اختیار کرنے کے حُکم","بَابُ الْأَمْرِ بِالتَّزَيُّنِ عِنْدَ إِرَادَةِ الطَّوَافِ بِالْبَيْتِ بِلُبْسِ الثِّيَابِ،بیت اللہ کا طواف کرتے وقت کپڑے پہن کر زیب و زینت اختیار کرنے کے حُکم","","","","","","","کا بیان","2701","2702","2701","2702"
"1887","بَابُ كَرَاهَةِ رَفْعِ الْيَدَيْنِ عِنْدَ رُؤْيَةِ الْبَيْتِ بِذِكْرِ خَبَرٍ مُجْمَلٍ غَيْرِ مُفَسَّرٍایک مجمل غیر مفسر روایت کے ساتھ بیت اللہ شریف کو دیکھنے پر ہاتھ اُٹھانے","بَابُ كَرَاهَةِ رَفْعِ الْيَدَيْنِ عِنْدَ رُؤْيَةِ الْبَيْتِ بِذِكْرِ خَبَرٍ مُجْمَلٍ غَيْرِ مُفَسَّرٍایک مجمل غیر مفسر روایت کے ساتھ بیت اللہ شریف کو دیکھنے پر ہاتھ اُٹھانے","","","","","","","کی کراہت کا بیان","2703","2704","2703","2704"
"1888","بَابُ ذِكْرِ الْخَبَرِ الْمُفَسِّرِ لِلَّفْظَةِ الْمُجْمَلَةِ الَّتِي ذَكَرْتُهَاگزشتہ","بَابُ ذِكْرِ الْخَبَرِ الْمُفَسِّرِ لِلَّفْظَةِ الْمُجْمَلَةِ الَّتِي ذَكَرْتُهَاگزشتہ","","","","","","","مجمل حدیث کی مفسر روایت کا بیان","2705","2705","2705","2705"
"1889","بَابُ الدُّعَاءِ عِنْدَ دُخُولِ الْمَسْجِدِمسجد","بَابُ الدُّعَاءِ عِنْدَ دُخُولِ الْمَسْجِدِمسجد","","","","","","","میں داخل ہونے کی دعا","2706","2706","2706","2706"
"1890","بَابُ الِاضْطِبَاعِ بِالرِّدَاءِ عِنْدَ طَوَافِ الْحَجِّ وَالْعُمْرَةِ أَوْ أَحَدِهِمَاحج","بَابُ الِاضْطِبَاعِ بِالرِّدَاءِ عِنْدَ طَوَافِ الْحَجِّ وَالْعُمْرَةِ أَوْ أَحَدِهِمَاحج","","","","","","","و عمرہ یا ان میں سے کسی ایک کے طواف قدوم میں چادر کو دائیں بازو کے نیچے سے نکال کر بائیں کندھے پر ڈالنے کا بیان","2707","2707","2707","2707"
"1891","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ السُّنَّةَ قَدْ كَانَ يَسُنُّهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِعِلَّةٍ حَادِثَةٍ فَتَزُولُ الْعِلَّةُاس","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ السُّنَّةَ قَدْ كَانَ يَسُنُّهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِعِلَّةٍ حَادِثَةٍ فَتَزُولُ الْعِلَّةُاس","","","","","","","بات کی دلیل کا بیان کہ کبھی نبی کریم صلی اللہ علیہ وسلم کوئی عمل کسی خالص علت کے پیش آںے پر سرانجام دیتے ہیں،","2708","2708","2708","2708"
"1892","بَابُ اسْتِلَامِ الْحَجَرِ الْأَسْوَدِ عِنْدَ ابْتِدَاءِ الطَّوَافِطواف","بَابُ اسْتِلَامِ الْحَجَرِ الْأَسْوَدِ عِنْدَ ابْتِدَاءِ الطَّوَافِطواف","","","","","","","شروع کرتے وقت حجر اسود کا استلام کرنے کا بیان","2709","2710","2709","2710"
"1893","بَابُ تَقْبِيلِ الْحَجَرِ الْأَسْوَدِ إِذَا تَمَّ تَقْبِيلُهُ مِنْ غَيْرِ إِيذَاءِ الْمُسْلِمِمسلمانوں","بَابُ تَقْبِيلِ الْحَجَرِ الْأَسْوَدِ إِذَا تَمَّ تَقْبِيلُهُ مِنْ غَيْرِ إِيذَاءِ الْمُسْلِمِمسلمانوں","","","","","","","کو تکلیف دیئے بغیر حجر اسود کو بوسہ دینا ممکن ہوتو اسے بوسہ دینا چاہیے","2711","2711","2711","2711"
"1894","بَابُ الْبُكَاءِ عِنْدَ تَقْبِيلِ الْحَجَرِ الْأَسْوَدِ، وَفِي الْقَلْبِ مِنْ مُحَمَّدِ بْنِ عَوْنٍ هَذَا،حجر","بَابُ الْبُكَاءِ عِنْدَ تَقْبِيلِ الْحَجَرِ الْأَسْوَدِ، وَفِي الْقَلْبِ مِنْ مُحَمَّدِ بْنِ عَوْنٍ هَذَا،حجر","","","","","","","اسود کو بوسہ دیتے ہوئے رونے کا بیان۔ میرا دل محمد بن عون کے بارے میں مطمئن نہیں ہے۔","2712","2713","2712","2713"
"1895","بَابُ السُّجُودِ عَلَى الْحَجَرِ الْأَسْوَدِ إِذَا وَجَدَ الطَّائِفُ السَّبِيلَ إِلَى ذَلِكَ مِنْ غَيْرِ إِيذَاءِ الْمُسْلِمِدیگر","بَابُ السُّجُودِ عَلَى الْحَجَرِ الْأَسْوَدِ إِذَا وَجَدَ الطَّائِفُ السَّبِيلَ إِلَى ذَلِكَ مِنْ غَيْرِ إِيذَاءِ الْمُسْلِمِدیگر","","","","","","","مسلمانوں کو تکلیف دیے بغیر اگر طواف کرنے والے کو حجر اسود پر سجدہ کرنے کا موقع ملے تو اسے حجر اسود پر سجدہ کرنا چاہیے","2714","2714","2714","2714"
"1896","بَابُ اسْتِلَامِ الْحَجَرِ بِالْيَدِ، وَتَقْبِيلِ الْيَدِ إِذَا لَمْ يُمْكِنْ تَقْبِيلُ الْحَجَرِ وَلَا السُّجُودُ عَلَيْهِاگر","بَابُ اسْتِلَامِ الْحَجَرِ بِالْيَدِ، وَتَقْبِيلِ الْيَدِ إِذَا لَمْ يُمْكِنْ تَقْبِيلُ الْحَجَرِ وَلَا السُّجُودُ عَلَيْهِاگر","","","","","","","حجر اسود کو بوسہ دینا اور اس پر سجدہ کرنا ممکن نہ ہو تو حجر اسود کو ہاتھ سے چھو کر ہاتھ چوم لینا چاہیے","2715","2715","2715","2715"
"1897","بَابُ التَّكْبِيرِ عِنْدَ اسْتِلَامِ الْحَجَرِ وَاسْتِقْبَالِهِ عِنْدَ افْتِتَاحِ الطَّوَافِطواف شروع کرتے وقت حجر اسود کی طرف منہ کرکے اس کا استلام کرتے وقت اللهُ أَكْبَرُ","بَابُ التَّكْبِيرِ عِنْدَ اسْتِلَامِ الْحَجَرِ وَاسْتِقْبَالِهِ عِنْدَ افْتِتَاحِ الطَّوَافِطواف شروع کرتے وقت حجر اسود کی طرف منہ کرکے اس کا استلام کرتے وقت اللهُ أَكْبَرُ","","","","","","","کہنے کا بیان","2716","2716","2716","2716"
"1898","بَابُ الرَّمَلِ فِي الْأَشْوَاطِ الثَّلَاثَةِ وَالْمَشْيِ فِي الْأَرْبَعَةِطواف کے پہلے تین چکّروں میں دلکی چال چلنا اور چار چکّروں","بَابُ الرَّمَلِ فِي الْأَشْوَاطِ الثَّلَاثَةِ وَالْمَشْيِ فِي الْأَرْبَعَةِطواف کے پہلے تین چکّروں میں دلکی چال چلنا اور چار چکّروں","","","","","","","میں عام چال چلنے کا بیان","2717","2717","2717","2717"
"1899","بَابُ الرَّمَلِ بِالْبَيْتِ مِنَ الْحَجَرِ الْأَسْوَدِ إِلَى الْحَجَرِ الْأَسْوَدِبیت","بَابُ الرَّمَلِ بِالْبَيْتِ مِنَ الْحَجَرِ الْأَسْوَدِ إِلَى الْحَجَرِ الْأَسْوَدِبیت","","","","","","","اللہ کا طواف کرتے ہوئے حجر اسود سے حجر اسود تک رمل کرنے کا بیان","2718","2718","2718","2718"
"1900","بَابُ ذِكْرِ الْعِلَّةِ الَّتِي لَهَا رَمَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الِابْتِدَاءِابتداء","بَابُ ذِكْرِ الْعِلَّةِ الَّتِي لَهَا رَمَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الِابْتِدَاءِابتداء","","","","","","","میں نبی اکرم صلی اللہ علیہ وسلم کے رمل کرنے کی علت کا بیان","2719","2720","2719","2720"
"1901","بَابُ الدُّعَاءِ بَيْنَ الرُّكْنِ الْيَمَانِي وَالْحَجَرِ الْأَسْوَدِرکن","بَابُ الدُّعَاءِ بَيْنَ الرُّكْنِ الْيَمَانِي وَالْحَجَرِ الْأَسْوَدِرکن","","","","","","","یمانی اور حجر اسود کے درمیان کی دعا کا بیان","2721","2721","2721","2721"
"1902","بَابُ التَّكْبِيرِ كُلَّمَا انْتَهَى إِلَى الْحَجَرِہر چکّر میں حجراسود پر پہنچ کر اللهُ أَكْبَرُ","بَابُ التَّكْبِيرِ كُلَّمَا انْتَهَى إِلَى الْحَجَرِہر چکّر میں حجراسود پر پہنچ کر اللهُ أَكْبَرُ","","","","","","","کہنے کا بیان","2722","2722","2722","2722"
"1903","بَابُ اسْتِلَامِ الْحَجَرِ وَالرُّكْنِ الْيَمَانِي فِي كُلِّ طَوَافٍ مِنَ السَّبْعِطواف کے ساتوں چکّروں","بَابُ اسْتِلَامِ الْحَجَرِ وَالرُّكْنِ الْيَمَانِي فِي كُلِّ طَوَافٍ مِنَ السَّبْعِطواف کے ساتوں چکّروں","","","","","","","میں حجراسود اور رکن یمانی کا استلام کرنے کا بیان","2723","2723","2723","2723"
"1904","بَابُ الْإِشَارَةِ إِلَى الرُّكْنِ عِنْدَ الِانْتِهَاءِ وَالْبَدْءِ إِذَا لَمْ يُمْكِنِ اسْتِلَامُهُجب حجر اسود کا استلام کرنا ممکن نہ ہو تو طواف کے ہر چکّر","بَابُ الْإِشَارَةِ إِلَى الرُّكْنِ عِنْدَ الِانْتِهَاءِ وَالْبَدْءِ إِذَا لَمْ يُمْكِنِ اسْتِلَامُهُجب حجر اسود کا استلام کرنا ممکن نہ ہو تو طواف کے ہر چکّر","","","","","","","کی ابتداء اور انتہا پر حجر اسود کی طرف اشارہ کرنا بھی کافی ہے","2724","2724","2724","2724"
"1905","بَابُ اسْتِلَامِ الرُّكْنَيْنِ اللَّذَيْنِ يَلِيَانِ الْحَجَرَ، رُكْنِ الْأَسْوَدِ وَالَّذِي يَلِيهِ وَهُمَا الرُّكْنَانِ الْيَمَانِيَانِحجر","بَابُ اسْتِلَامِ الرُّكْنَيْنِ اللَّذَيْنِ يَلِيَانِ الْحَجَرَ، رُكْنِ الْأَسْوَدِ وَالَّذِي يَلِيهِ وَهُمَا الرُّكْنَانِ الْيَمَانِيَانِحجر","","","","","","","اسود اور اس کے قریب والے رکن کا استلام کرنے کا بیان اور وہ دونوں رکن یمانی کہلاتے ہیں","2725","2725","2725","2725"
"1906","بَابُ ذِكْرِ الْعِلَّةِ الَّتِي نَرَى أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تَرَكَ اسْتِلَامَ الرُّكْنَيْنِ اللَّذَيْنِ يَلِيَانِ الْحَجَرَ لَهَااس","بَابُ ذِكْرِ الْعِلَّةِ الَّتِي نَرَى أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تَرَكَ اسْتِلَامَ الرُّكْنَيْنِ اللَّذَيْنِ يَلِيَانِ الْحَجَرَ لَهَااس","","","","","","","علت کا بیان جس کی بنا پر ہمارے خیال میں نبی کریم صلی اللہ علیہ وسلم حطیم کے قریبی دو ارکان کا استلام نہیں کرتے تھے","2726","2726","2726","2726"
"1907","بَابُ وَضْعِ الْخَدِّ عَلَى الرُّكْنِ الْيَمَانِي عِنْدَ تَقْبِيلِهِرکن","بَابُ وَضْعِ الْخَدِّ عَلَى الرُّكْنِ الْيَمَانِي عِنْدَ تَقْبِيلِهِرکن","","","","","","","یمانی کو بوسہ دیتے وقت اس پر رخسار رکھنے کا بیان","2727","2727","2727","2727"
"1908","بَابُ الدُّعَاءِ بَيْنَ الرُّكْنَيْنِ أَنْ يَرْزُقَ اللَّهُ الدَّاعِيَ الْقَنَاعَةَ بِمَا رَزَقَ، وَيُبَارِكَ لَهُ فِيهِ، وَيُخْلِفَ عَلَى كُلِّ غَائِبَةٍ لَهُ بِخَيْرٍحجر","بَابُ الدُّعَاءِ بَيْنَ الرُّكْنَيْنِ أَنْ يَرْزُقَ اللَّهُ الدَّاعِيَ الْقَنَاعَةَ بِمَا رَزَقَ، وَيُبَارِكَ لَهُ فِيهِ، وَيُخْلِفَ عَلَى كُلِّ غَائِبَةٍ لَهُ بِخَيْرٍحجر","","","","","","","اسود رکن یمان دونوں ارکان کے درمیان دعا کرنا کہ اللہ تعالیٰ دعا کرنے والے کو ملے ہوئے رزق میں قناعت عطا فرمائے، اور اسے اس میں برکت عطا کرے اور اس کی ہر غیر حاضر چیز کا خیر و بھلائی کے ساتھ نگہبان بن جائے","2728","2728","2728","2728"
"1909","بَابُ فَضْلِ اسْتِلَامِ الرُّكْنَيْنِ وَذِكْرِ حَطِّ الْخَطَايَا بِمَسْحِهَاحجر","بَابُ فَضْلِ اسْتِلَامِ الرُّكْنَيْنِ وَذِكْرِ حَطِّ الْخَطَايَا بِمَسْحِهَاحجر","","","","","","","اسود اور رکن یمانی کی فضیلت اور ان دونوں کے استلام سے گناہوں کی بخشش کا بیان","2729","2730","2729","2730"
"1910","بَابُ صِفَةِ الرُّكْنِ وَالْمَقَامِ وَالْبَيَانُ أَنَّهُمَا يَاقُوتَتَانِ مِنْ يَوَاقِيتِ الْجَنَّةِحجر اسود اور مقام ابراہیم کی صفت اور اس بات کا بیان کہ یہ دونوں پتھر جنحجر اسود اور مقام ابراہیم کی صفت اور اس بات کا بیان کہ یہ دونوں پتھر جنّتی","بَابُ صِفَةِ الرُّكْنِ وَالْمَقَامِ وَالْبَيَانُ أَنَّهُمَا يَاقُوتَتَانِ مِنْ يَوَاقِيتِ الْجَنَّةِحجر اسود اور مقام ابراہیم کی صفت اور اس بات کا بیان کہ یہ دونوں پتھر جنحجر اسود اور مقام ابراہیم کی صفت اور اس بات کا بیان کہ یہ دونوں پتھر جنّتی","","","","","","","یاقوتوں میں سے دو یاقوت ہیںتی یا قوتوں میں سے دو یا قوت ہیں","2731","2732","2731","2732"
"1911","بَابُ ذِكْرِ الْعِلَّةِ الَّتِي مِنْ سَبَبِهَا اسْوَدَّ الْحَجَرُ، وَصِفَةِ نُزُولِهِ مِنَ الْجَنَّةِ، وَالدَّلِيلُ عَلَى أَنَّهُ إِنَّمَا سَوَّدَتْهُ خَطَايَا بَنِي آدَمَ، إِذْ كَانَ عِنْدَ نُزُولِهِ مِنَ الْجَنَّةِ أَشَدَّ بَيَاضًا مِنَ الثَّلْجِحجر","بَابُ ذِكْرِ الْعِلَّةِ الَّتِي مِنْ سَبَبِهَا اسْوَدَّ الْحَجَرُ، وَصِفَةِ نُزُولِهِ مِنَ الْجَنَّةِ، وَالدَّلِيلُ عَلَى أَنَّهُ إِنَّمَا سَوَّدَتْهُ خَطَايَا بَنِي آدَمَ، إِذْ كَانَ عِنْدَ نُزُولِهِ مِنَ الْجَنَّةِ أَشَدَّ بَيَاضًا مِنَ الثَّلْجِحجر","","","","","","","اسود کے سیاہ ہو جانے کی علت کا بیان","2733","2733","2733","2733"
"1912","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ الْحَجَرَ إِنَّمَا سَوَّدَتْهُ خَطَايَا بَنِي آدَمَ الْمُشْرِكِينَ دُونَ خَطَايَا الْمُسْلِمِينَاس","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ الْحَجَرَ إِنَّمَا سَوَّدَتْهُ خَطَايَا بَنِي آدَمَ الْمُشْرِكِينَ دُونَ خَطَايَا الْمُسْلِمِينَاس","","","","","","","بات کی دلیل کا بیان کہ حجر اسود مشرک انسانوں کے گناہوں سے سیاہ ہوا ہے، مسلمانوں کے گناہوں سے نہیں","2734","2734","2734","2734"
"1913","بَابُ ذِكْرِ صِفَةِ الْحَجَرِ يَوْمَ الْقِيَامَةِ، وَبَعْثَةِ اللَّهِ- عَزَّ وَجَلَّ-قیامت","بَابُ ذِكْرِ صِفَةِ الْحَجَرِ يَوْمَ الْقِيَامَةِ، وَبَعْثَةِ اللَّهِ- عَزَّ وَجَلَّ-قیامت","","","","","","","کی دن حجر اسود کی صفت کا بیان","2735","2735","2735","2735"
"1914","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِنَّمَا أَرَادَ بِذِكْرِهِ الرُّكْنَ فِي هَذَا الْخَبَرِ نَفْسَ الْحَجَرِ الْأَسْوَدِ لَا غَيْرَاس","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِنَّمَا أَرَادَ بِذِكْرِهِ الرُّكْنَ فِي هَذَا الْخَبَرِ نَفْسَ الْحَجَرِ الْأَسْوَدِ لَا غَيْرَاس","","","","","","","بات کی دلیل کا بیان کہ کہ اس حدیث میں مذکور رکن سے نبی کریم صلی اللہ علیہ وسلم کی مراد صرف حجر اسود ہے، دوسرا کوئی رکن مراد نہیں ہے","2736","2736","2736","2736"
"1915","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ الْحَجَرَ إِنَّمَا يَشْهَدُ لِمَنِ اسْتَلَمَهُ بِالنِّيَّةِ دُونَ مَنِ اسْتَلَمَهُاس","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ الْحَجَرَ إِنَّمَا يَشْهَدُ لِمَنِ اسْتَلَمَهُ بِالنِّيَّةِ دُونَ مَنِ اسْتَلَمَهُاس","","","","","","","بات کی دلیل کا بیان کہ حجر اسود اس شخص کے حق میں گواہی دیگا جس نے اس کی گواہی کے حصول کی نیت کے ساتھ اس کا استلام کیا ہوگا،","2737","2737","2737","2737"
