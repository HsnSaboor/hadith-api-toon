hadiths[13]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"106","26 - [مَا جَاءَ فِي صَدَقَةِ  السَّائِمَةِ  فِي الزَّكَاةِ ]  106  -  حَدَّثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ، قَالَ :  قَالَ حَمَّادٌ :  قُلْتُ لِقَيْسِ بْنِ سَعْدٍ : خُذْ لِي كِتَابَ  مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ  ،  فَأَعْطَانِي كِتَابًا ، أَخْبَرَ أَنَّهُ أَخَذَهُ  مِنْ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَتَبَ  لِجَدِّهِ  ، فَقَرَأْتُهُ فَكَانَ فِيهِ ذِكْرُ مَا يَخْرُجُ مِنْ  فَرَائِضِ  الْإِبِلِ ، فَقَصَّ الْحَدِيثَ إِلَى أَنْ يَبْلُغَ  عِشْرِينَ وَمِائَةً ، فَإِذَا كَانَتْ أَكْثَرَ مِنْ ذَلِكَ فَعُدَّ فِي كُلِّ خَمْسِينَ حِقَّةً ، وَمَا فَضَلَ فَإِنَّهُ يُعَادُ إِلَى أَوَّلِ فَرِيضَةٍ [مِنَ]  الْإِبِلِ ، وَمَا كَانَ أَقَلَّ مِنْ خَمْسٍ وَعِشْرِينَ فَفِيهِ الْغَنَمُ ، فِي كُلِّ         [1/129]      خَمْسِ ذَوْدٍ شَاةٌ ، لَيْسَ فِيهَا ذَكَرٌ وَلَا هَرِمَةٌ وَلَا ذَاتُ  عَوَارٍ  مِنَ الْغَنَمِ  ( 19569 ) .  كذا في طبعة الرسالة ، وما بين المعقوفين في طبعة دار الصميعي: باب صدقة السائمة .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: كتبه .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: تبلغ .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .","","Al-Marasil li-Abi Dawud 106","","أبو بكر بن محمد الخزرجي عن قيس بن سعد الحبشي عن حماد بن سلمة عن موسى بن إسماعيل التبوذكي عن أبو داود السجستاني","ما جاء في صدقة السائمة في الزكاة"
"107","107  -  حَدَّثَنَا  قُتَيْبَةُ [بْنُ سَعِيدٍ]  ،  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَبْدَةَ ،  أَخْبَرَنَا  سُفْيَانُ ،  عَنْ  إِبْرَاهِيمَ بْنِ مَيْسَرَةَ .  عَنْ  طَاوُسٍ ،  أَنَّ مُعَاذَ بْنَ جَبَلٍ ، أُتِيَ [مِنَ  الْيَمَنِ]  بِوَقَصِ  الْبَقَرِ [وَالْغَنَمِ]  فَقَالَ : كِلَاهُمَا لَمْ يَأْمُرْنِي النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيهِ بِشَيْءٍ  .  ( 11314 )  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: ""قال : نا ، وحدثنا"" .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: باليمن .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: والعسل .","","Al-Marasil li-Abi Dawud 107","","معاذ بن جبل عن طاوس بن كيسان عن إبراهيم بن ميسرة الطائفي عن سفيان بن عيينة عن أحمد بن عبدة الضبي عن أبو داود السجستاني","ما جاء في صدقة السائمة في الزكاة"
"108","108  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مَسْلَمَةَ ،  عَنْ  مَالِكٍ ،  عَنْ  حُمَيْدِ بْنِ قَيْسٍ  .  عَنْ  طَاوُسٍ الْيَمَانِيِّ ،  أَنَّ مُعَاذَ بْنَ جَبَلٍ  ،  أَخَذَ مِنْ ثَلَاثِينَ بَقَرَةً  تَبِيعًا  ، وَمِنْ أَرْبَعِينَ بَقَرَةً  مُسِنَّةً  ، فَأُتِيَ  بِمَا دُونَ ذَلِكَ فَأَبَى أَنْ يَأْخُذَ مِنْهُ ، وَقَالَ : لَمْ أَسْمَعْ مِنَ [النَّبِيِّ]  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ذَلِكَ شَيْئًا ، حَتَّى أَلْقَاهُ فَأَسْأَلَهُ ، فَتُوُفِّيَ         [1/130]      [النَّبِيُّ]  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَبْلَ أَنْ يَقْدَمَ  مُعَاذُ بْنُ جَبَلٍ  .  ( 18832 )  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: المكي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: الأنصاري .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: وأتي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: رسول الله .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: رسول الله .","","Al-Marasil li-Abi Dawud 108","","معاذ بن جبل عن طاوس بن كيسان عن حميد بن قيس الأعرج عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن أبو داود السجستاني","ما جاء في صدقة السائمة في الزكاة"
"109","109  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  حَدَّثَنَا  ابْنُ ثَوْرٍ ، قَالَ :  قَالَ  مَعْمَرٌ :  أَعْطَانِي سِمَاكُ بْنُ الْفَضْلِ كِتَابًا مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِمَالِكِ بْنِ كَفَلَانِسَ  وَالْمُقَوْقِسِ  فَإِذَا فِيهِ :  فِي  الْبَقَرِ مِثْلُ مَا فِي الْإِبِلِ  ( 18796 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: وفي .","","Al-Marasil li-Abi Dawud 109","","سماك بن الفضل الخولاني عن معمر بن راشد عن محمد بن ثور الصنعاني عن محمد بن عبيد بن حساب الغبري عن أبو داود السجستاني","ما جاء في صدقة السائمة في الزكاة"
"110","110  -  [وَبِهِ  عَنْ  مَعْمَرٍ]  ،  [عَنِ  الزُّهْرِيِّ ، قَالَ :  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ]  :  فِي كُلِّ خَمْسٍ مِنَ الْبَقَرِ  وَفِي عَشْرٍ شَاتَانِ  ، وَفِي [خَمْسَةَ عَشَرَ]  ثَلَاثُ  شِيَاهٍ  ، وَفِي عِشْرِينَ أَرْبَعُ  شِيَاهٍ  قَالَ الزُّهْرِيُّ :  وَإِذَا  كَانَتْ خَمْسًا وَعِشْرِينَ فَفِيهَا بَقَرَةٌ إِلَى خَمْسٍ وَسَبْعِينَ  فَفِيهَا بَقَرَتَانِ  إِلَى عِشْرِينَ وَمِائَةٍ ، فَإِذَا زَادَتْ عَلَى عِشْرِينَ وَمِائَةٍ فَفِي كُلِّ أَرْبَعِينَ بَقَرَةً بَقَرَةٌ  ، قَالَ  مَعْمَرٌ  : قَالَ  الزُّهْرِيُّ  :  وَبَلَغَنَا أَنَّ قَوْلَهُمْ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فِي كُلِّ ثَلَاثِينَ بَقَرَةً  تَبِيعٌ  ، وَفِي كُلِّ أَرْبَعِينَ بَقَرَةً بَقَرَةٌ  ، إِنَّ ذَلِكَ         [1/131]      كَانَ تَخْفِيفًا  لِأَهْلِ الْيَمَنِ  ، ثُمَّ كَانَ هَذَا بَعْدَ ذَلِكَ  .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: حدثنا محمد بن عبيد ، نا محمد بن ثور ، عن معمر .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: عن الزهري عن جابر بن عبد الله قال .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: شاة .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: خمس عشرة .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: فإذا .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: فإذا زادت على خمس وسبعين .","","Al-Marasil li-Abi Dawud 110","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الزهري عن معمر بن راشد عن محمد بن ثور الصنعاني عن محمد بن عبيد بن حساب الغبري عن أبو داود السجستاني","ما جاء في صدقة السائمة في الزكاة"
"111","111  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  حَدَّثَنَا  ابْنُ ثَوْرٍ ،  عَنْ  مَعْمَرٍ .  عَنْ  أَيُّوبَ قَالَ  : كُنْتُ أَسْمَعُ زَمَانًا أَنَّهُمْ كَانُوا يَقُولُونَ : خُذُوا مِنَّا مَا أَخَذَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَكُنْتُ أَعْجَبُ لِمَ لَمْ يَقْبَلْ ذَلِكَ مِنْهُمْ ؟ حَتَّى  حَدَّثَنِي  الزُّهْرِيُّ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَتَبَ  هَذِهِ الْفَرَائِضَ  ، فَقُبِضَ قَبْلَ أَنْ يَكْتُبَ  إِلَى الْعُمَّالِ ، فَأَخَذَ بِهِ  أَبُو بَكْرٍ  عَلَى مَا كَتَبَ ، لَا أَعْلَمُهُ إِلَّا ذَكَرَ الْبَقَرَ أَيْضًا  ( 19339 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: كان كتب .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: يكتب به .","","Al-Marasil li-Abi Dawud 111","","الزهري عن أيوب السختياني عن معمر بن راشد عن محمد بن ثور الصنعاني عن محمد بن عبيد بن حساب الغبري عن أبو داود السجستاني","ما جاء في صدقة السائمة في الزكاة"
"112","112  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَنْصُورٍ الطُّوسِيُّ ،  حَدَّثَنَا  يَعْقُوبُ ،  حَدَّثَنَا  أَبِي  .  [عَنِ  ابْنِ إِسْحَاقَ]  ، قَالَ :  وَذَكَرَ  مُحَمَّدُ بْنُ مُسْلِمٍ الزُّهْرِيُّ  أَنَّ مِمَّا كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحْكَمَ مِنْ أَمْرِ الصَّدَقَةِ  أَنَّهُ جَعَلَ فِي الْأَوْقَاصِ مِنَ الْبَقَرِ بَعْدَ كِتَابِهِ الْأَوَّلِ مَعَ  مُعَاذِ بْنِ جَبَلٍ  ، وَالْأَوْقَاصُ : الْخَمْسُ مِنَ الْبَقَرِ فَصَاعِدًا إِلَى عَشْرٍ  ، فَجَعَلَ فِي الْعَشْرِ شَاتَيْنِ ، ثُمَّ جَعَلَ صَدَقَةَ الْبَقَرِ عَلَى نَحْوٍ مِنْ صَدَقَةِ الْإِبِلِ .  ( 19371 )  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: عن محمد بن إسحاق .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: العشر .","","Al-Marasil li-Abi Dawud 112","","الزهري عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن محمد بن منصور الطوسي عن أبو داود السجستاني","ما جاء في صدقة السائمة في الزكاة"
"113","113  -  حَدَّثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ .         [1/132]      عَنْ  عُرْوَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعَثَ  رَجُلًا  عَلَى الصَّدَقَةِ  وَأَمَرَهُ أَنْ يَأْخُذَ الْبِكْرَ  وَالشَّارِفَ  وَذَا الْعَيْبِ ، وَإِيَّاكَ  وَحَزَرَاتِ  أَنْفُسِهِمْ  ( 19032 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: نا .","","Al-Marasil li-Abi Dawud 113","","عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن موسى بن إسماعيل التبوذكي عن أبو داود السجستاني","ما جاء في صدقة السائمة في الزكاة"
"114","114  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  عَبْدُ الْوَارِثِ ،  حَدَّثَنَا         [1/133]      أَبُو سَلَمَةَ الْخُرَاسَانِيُّ ، قَالَ الْحَسَنُ : هُوَ غَالِبُ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  كَثِيرٌ أَبُو سَهْلٍ ، وَنَحْنُ  بِخُرَاسَانَ  .  عَنِ  الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ تَجَاوَزَ لَكُمْ عَنْ ثَلَاثٍ  : عَنِ  الْجَبْهَةِ  ، وَعَنِ  النَّخَّةِ  ، وَالْكُسَعِ  . قَالَ  كَثِيرٌ  :  يَرَوْنَ أَنَّ  الْجَبْهَةَ  : الْخَيْلُ ، وَالنَّخَّةَ : الْإِبِلُ  الْعَوَامِلُ  وَالنَّوَاضِحُ  ، وَالْكُسَعَ : صِغَارُ الْغَنَمِ  ( 18547 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال نا .","","Al-Marasil li-Abi Dawud 114","","الحسن البصري عن كثير بن زياد البرساني عن غالب بن سليمان الجهضمي عن عبد الوارث بن سعيد بن ذكوان عن عفان بن مسلم الصفار عن الحسن بن علي الريحاني عن أبو داود السجستاني","ما جاء في صدقة السائمة في الزكاة"
"115","115  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  حَدَّثَنَا  غَالِبُ بْنُ سُلَيْمَانَ ،  عَنْ  كَثِيرِ بْنِ زِيَادٍ .  عَنِ  الْحَسَنِ ... بِهَذَا ، وَقَالَ  :  النَّخَّةُ  : صِغَارُ الْغَنَمِ ، وَالْكُسَعُ : الْحَمِيرُ  ( 18547 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال .","","Al-Marasil li-Abi Dawud 115","","الحسن البصري عن كثير بن زياد البرساني عن غالب بن سليمان الجهضمي عن سليمان بن حرب الواشحي عن الحسن بن علي الريحاني عن أبو داود السجستاني","ما جاء في صدقة السائمة في الزكاة"
"116","116  -  حَدَّثَنَا  كَثِيرُ بْنُ عُبَيْدٍ الْمَذْحِجِيُّ ،  حَدَّثَنَا  الْوَلِيدُ ،  عَنْ  مُحَمَّدِ بْنِ رَاشِدٍ  عَنْ  مَكْحُولٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَشْتَرُوا الصَّدَقَاتِ حَتَّى تُعْقَلَ وَتُوسَمَ  ( 19479 ) .  قَالَ أَبُو دَاوُدَ :  هَذَا يُرْوَى مِنْ قَوْلِ  مَكْحُولٍ  .","","Al-Marasil li-Abi Dawud 116","","مكحول بن أبي مسلم عن محمد بن راشد المكحولي عن الوليد بن مسلم القرشي عن كثير بن عبيد المذحجي عن أبو داود السجستاني","ما جاء في صدقة السائمة في الزكاة"
"117","117  -  حَدَّثَنَا  مُحَمَّدُ بْنُ قُدَامَةَ بْنِ أَعْيَنَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،         [1/134]      عَنِ  الْحَكَمِ ، قَالَ :  كَتَبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  مُعَاذِ بْنِ جَبَلٍ  وَهُوَ  بِالْيَمَنِ  :  وَفِي  الْحَالِمِ  وَالْحَالِمَةِ  دِينَارٌ أَوْ عَدْلُهُ مِنْ قِيمَةِ الْمَعَافِرِ  ، وَلَا يُفْتَنَنَّ  يَهُودِيٌّ عَنْ يَهُودِيَّتِهِ  ( 18582 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: يفتن .","","Al-Marasil li-Abi Dawud 117","","الحكم بن عتيبة الكندي عن منصور بن المعتمر عن جرير بن عبد الحميد عن محمد بن قدامة بن أعين المصيصي عن أبو داود السجستاني","ما جاء في صدقة السائمة في الزكاة"
"118","118  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْجَرَّاحِ ،  عَنْ  وَهْبٍ ،  عَنْ  جَرِيرِ بْنِ حَازِمٍ ،  عَنْ  قَيْسِ بْنِ سَعْدٍ .  عَنْ  مَكْحُولٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَفِّفُوا  عَلَى النَّاسِ فِي  الْخَرْصِ  ، فَإِنَّ فِي الْمَالِ الْعَرِيَّةَ  ، قَالَ غَيْرُهُ : وَالْوَطِيَّةَ  ( 19475 ) .  حَدَّثَنَا  مَحْمُودُ بْنُ خَالِدٍ ،  حَدَّثَنَا  عُمَرُ ،  سَأَلْتُ  الْأَوْزَاعِيَّ قَالَ :         [1/135]      الْوَطِيَّةُ  مَنْ يَطَؤُهُ مِنَ النَّاسِ  ، [وَالْوَطِيَّةُ أَوِ الْوَطِئَةُ]  [قَالَ أَبُو دَاوُدَ :  الصَّحِيحُ الْوَطِيَّةُ ، يَعْنِي مَنْ يَغْشَى الْأَرْضَ وَيَأْكُلُ مِنْهَا]  .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: والوصية .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: ""قال أبو داود : الصحيح الوطية - يعني من يغشى الأرض ويأكل منها .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال سألت .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: الواطئة .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .  ما بين المعقوفين تقدم في طبعة دار الصميعي وتقدمت الإشارة إليه .","","Al-Marasil li-Abi Dawud 118","","مكحول بن أبي مسلم عن قيس بن سعد الحبشي عن جرير بن حازم عن وهب بن جرير بن حازم عن عبد الله بن الجراح القهستاني عن أبو داود السجستاني","ما جاء في صدقة السائمة في الزكاة"
