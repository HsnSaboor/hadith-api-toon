hadiths[241]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"6742","«ناركم هذه التي توقد بنوآدم جزء من سبعين جزءا من نار جهنم قيل: يا رسول الله! إن كانت لكافية؟ قال: فإنها فضلت عليها بتسعة وستين جزءا كلهن مثل حرها»","صحيح","Sahih al-Jami al-Saghir 6742","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6743","«ناركم هذه جزء من سبعين جزءا من نار جهنم لكل جزء منها حرها»","صحيح","Sahih al-Jami al-Saghir 6743","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6744","«ناس من أمتي عرضوا علي غزاة في سبيل الله يركبون ثبج هذا البحر ملوكا على الأسرة»","صحيح","Sahih al-Jami al-Saghir 6744","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6745","«نبدأ بما بدأ الله به»","صحيح","Sahih al-Jami al-Saghir 6745","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6746","«نجا أول هذه الأمة باليقين والزهد ويهلك آخرها بالبخل والأمل»","حسن","Sahih al-Jami al-Saghir 6746","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6747","«نح الأذى عن طريق المسلمين»","صحيح","Sahih al-Jami al-Saghir 6747","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6748","«نحرت هاهنا ومنى كلها منحر فانحروا في رحالكم ووقفت هاهنا وعرفة كلها موقف ووقفت هاهنا وجمع كلها موقف»","صحيح","Sahih al-Jami al-Saghir 6748","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6749","«نحن آخر الأمم وأول من يحاسب يقال: أين الأمة الأمية ونبيها؟ فنحن الآخرون الأولون»","صحيح","Sahih al-Jami al-Saghir 6749","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6750","«نحن أحق بالشك من إبراهيم إذ قال: {رَبِّ أَرِنِي كَيْفَ تُحْيِي الْمَوْتَى قَالَ أولَمْ تُؤْمِنْ قَالَ بَلَى وَلَكِنْ لِيَطْمَئِنَّ قَلْبِي} ويرحم الله لوطا لقد كان يأوي إلى ركن شديد ولو لبثت في السجن طول ما لبث يوسف لأجبت الداعي»","صحيح","Sahih al-Jami al-Saghir 6750","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6751","«نحن أحق وأولى بموسى منكم»","صحيح","Sahih al-Jami al-Saghir 6751","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6752","«نحن الآخرون السابقون يوم القيامة بيد أنهم أوتوا الكتاب من قبلنا وأوتيناه من بعدهم ثم هذا يومهم الذي فرض الله عليهم فاختلفوا فيه فهدانا الله له فالناس لنا فيه تبع اليهود غدا والنصارى بعد غد»","صحيح","Sahih al-Jami al-Saghir 6752","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6753","«نحن بنوالنضر بن كنانة لا نقفوأمنا ولا ننتفي من أبينا»","صحيح","Sahih al-Jami al-Saghir 6753","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6754","«نحن نازلون غدا بخيف بني كنانة حيث قاسمت قريش على الكفر»","صحيح","Sahih al-Jami al-Saghir 6754","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6755","«نزع رجل لم يعمل خيرا قط غصن شوك عن الطريق إما كان في شجرة مقطعة فألقاه وإما كان موضوعا فأماطه فشكر الله له بها فأدخله الجنة»","حسن","Sahih al-Jami al-Saghir 6755","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6756","«نزل الحجر الأسود من الجنة وهو أشد بياضا من اللبن فسودته خطايا بني آدم»","صحيح","Sahih al-Jami al-Saghir 6756","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6757","«نزل جبريل فأمني فصليت معه ثم صليت معه ثم صليت معه ثم صليت معه ثم صليت معه ثم قال: بهذا أمرت»","صحيح","Sahih al-Jami al-Saghir 6757","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6758","«نزل ملك من السماء فكذبه بما قال لك فلما انتصرت وقع الشيطان فلم أكن لأجلس إذا وقع الشيطان»","حسن","Sahih al-Jami al-Saghir 6758","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6759","""نزل نبي من الأنبياء تحت شجرة فلدغته نملة فأمر بجهازه فأخرج من تحتها ثم أمر ببيتها فأحرق بالنار فأوحى الله إليه: فهلا نملة واحدة""","صحيح","Sahih al-Jami al-Saghir 6759","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6760","«نزلت هذه الآية في أهل قباء: {فِيهِ رِجَالٌ يُحِبُّونَ أَنْ يَتَطَهَّرُوا وَاللَّهُ يُحِبُّ الْمُطَّهِّرِينَ} »","صحيح","Sahih al-Jami al-Saghir 6760","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6761","«نصبر ولا نعاقب»","صحيح","Sahih al-Jami al-Saghir 6761","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6762","«نصرت بالصبا وأهلكت عاد بالدبور»","صحيح","Sahih al-Jami al-Saghir 6762","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6763","«نضر الله امرءا سمع منا حديثا فحفظه حتى يبلغه غيره فرب حامل فقه إلى من هوأفقه ورب حامل فقه ليس بفقيه»","صحيح","Sahih al-Jami al-Saghir 6763","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6764","«نضر الله امرءا سمع منا شيئا فبلغه كما سمعه فرب مبلغ أوعى من سامع»","صحيح","Sahih al-Jami al-Saghir 6764","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6765","«نضر الله عبدا سمع مقالتي فوعاها ثم بلغها عني فرب حامل فقه غير فقيه ورب حامل فقه إلى من هو أفقه منه»","صحيح","Sahih al-Jami al-Saghir 6765","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6766",""" نضر الله عبدا سمع مقالتي فوعاها وحفظها ثم أداها إلى من لم يسمعها فرب حامل فقه غير فقيه ورب حامل فقه إلى من هوأفقه منه ثلاث لا يغل عليهن قلب امرئ مسلم: إخلاص العمل لله، والنصح لأئمة المسلمين ولزوم جماعتهم فإن دعوتهم تحوط من وراءهم ""","صحيح","Sahih al-Jami al-Saghir 6766","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6767","«نطفة الرجل بيضاء غليظة ونطفة المرأة صفراء رقيقة فأيهما غلبت صاحبتها فالشبه له،....... ... »","صحيح","Sahih al-Jami al-Saghir 6767","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6768","«نعم الإدام الخل»","صحيح","Sahih al-Jami al-Saghir 6768","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6769","«نعم الجهاد الحج»","صحيح","Sahih al-Jami al-Saghir 6769","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6770","«نعم الرجل أبو بكر نعم الرجل عمر نعم الرجل أبو عبيدة بن الجراح نعم الرجل أسيد بن حضير نعم الرجل ثابت بن قيس بن شماس نعم الرجل معاذ بن جبل نعم الرجل معاذ بن عمروبن الجموح نعم الرجل سهيل بن بيضاء»","صحيح","Sahih al-Jami al-Saghir 6770","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6771","«نعم الرجل عبد الله لوكان يصلي من الليل»","صحيح","Sahih al-Jami al-Saghir 6771","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6772","«نعم السحور التمر»","صحيح","Sahih al-Jami al-Saghir 6772","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6773","«نعم السورتان هما يقرآن في الركعتين قبل الفجر: {قُلْ يَا أَيُّهَا الْكَافِرُونَ} و {قُلْ هُوَ اللَّهُ أَحَدٌ} »","صحيح","Sahih al-Jami al-Saghir 6773","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6774","«نعم الصدقة اللقحة الصفي منحة والشاة الصفية منحة يغدو بإناء ويروح بإناء»","صحيح","Sahih al-Jami al-Saghir 6774","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6775","«نعم الميتة أن يموت الرجل دون حقه»","صحيح","Sahih al-Jami al-Saghir 6775","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6776","«نعم عبد الله خالد بن الوليد سيف من سيوف الله»","صحيح","Sahih al-Jami al-Saghir 6776","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6777","«نعما لمملوك أن يتوفى يحسن عبادة ربه وينصح لسيده نعما له»","صحيح","Sahih al-Jami al-Saghir 6777","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6778","«نعمتان مغبون فيهما كثير من الناس: الصحة والفراغ»","صحيح","Sahih al-Jami al-Saghir 6778","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6779","«نفس المؤمن معلقة بدينه حتى يقضى عنه»","صحيح","Sahih al-Jami al-Saghir 6779","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6780","«نفقة الرجل على أهله صدقة»","صحيح","Sahih al-Jami al-Saghir 6780","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6781","«نفي بعهدهم ونستعين الله عليهم»","صحيح","Sahih al-Jami al-Saghir 6781","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6782","«نهران من الجنة: النيل والفرات»","صحيح","Sahih al-Jami al-Saghir 6782","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6783","«نهيت أن أمشي عريانا»","صحيح","Sahih al-Jami al-Saghir 6783","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6784","«نهيت عن التعري»","صحيح","Sahih al-Jami al-Saghir 6784","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6785","«نهيت عن المصلين»","صحيح","Sahih al-Jami al-Saghir 6785","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6786","«نهيتكم عن الظروف وإن الظروف لا تحل شيئا ولا تحرمه وكل مسكر حرام»","صحيح","Sahih al-Jami al-Saghir 6786","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6787","«نهيتكم عن النبيذ إلا في سقاء فاشربوا في الأسقية كلها ولا تشربوا مسكرا»","صحيح","Sahih al-Jami al-Saghir 6787","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6788","«نهيتكم عن ثلاث وأنا آمركم بهن نهيتكم عن زيارة القبور فزوروها فإن في زيارتها تذكرة ونهيتكم عن الأشربة أن لا تشربوا إلا في ظروف الأدم فاشربوا في كل وعاء غير أن لا تشربوا مسكرا ونهيتكم عن لحوم الأضاحي أن تأكلوها بعد ثلاث فكلوا واستمتعوا بها في أسفاركم»","صحيح","Sahih al-Jami al-Saghir 6788","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6789","«نهيتكم عن زيارة القبور فزوروها فإن لكم فيها عبرة»","صحيح","Sahih al-Jami al-Saghir 6789","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6790","«نهيتكم عن زيارة القبور فزوروها فإنها تذكركم الموت»","صحيح","Sahih al-Jami al-Saghir 6790","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6791","«نهينا عن الكلام في الصلاة إلا بالقرآن والذكر»","صحيح","Sahih al-Jami al-Saghir 6791","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6792","«النائحة إذا لم تتب قبل موتها تقام يوم القيامة وعليها سربال من قطران ودرع من جرب»","صحيح","Sahih al-Jami al-Saghir 6792","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6793","«النار جبار»","صحيح","Sahih al-Jami al-Saghir 6793","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6794","«النار عدو فاحذروها»","صحيح","Sahih al-Jami al-Saghir 6794","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6795","«الناس تبع لقريش في الخير والشر»","صحيح","Sahih al-Jami al-Saghir 6795","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6796","«الناس معادن خيارهم في الجاهلية خيارهم في الإسلام إذا فقهوا الناس تبع لقريش في هذا الشأن مسلمهم تبع لمسلمهم وكافرهم تبع لكافرهم تجدون من خير الناس أشد الناس كراهية لهذا الشأن حتى يقع فيه»","صحيح","Sahih al-Jami al-Saghir 6796","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6797","""الناس معادن كمعادن الذهب والفضة، خيارهم في الجاهلية خيارهم في الإسلام إذا فقهوا والأرواح جنود مجندة فما تعارف منها ائتلف وما تناكر منها اختلف""","صحيح","Sahih al-Jami al-Saghir 6797","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6798","«الناس ولد آدم وآدم من تراب»","حسن","Sahih al-Jami al-Saghir 6798","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6799","«النبي لا يورث»","صحيح","Sahih al-Jami al-Saghir 6799","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6800","«النجوم أمنة للسماء فإذا ذهبت النجوم أتى السماء ما توعد وأنا أمنة لأصحابي فإذا ذهبت أتى أصحابي ما يوعدون وأصحابي أمنة لأمتي فإذا ذهب أصحابي أتى أمتي ما يوعدون»","صحيح","Sahih al-Jami al-Saghir 6800","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6801","«النخاعة في المسجد خطيئة وكفارتها دفنها»","صحيح","Sahih al-Jami al-Saghir 6801","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6802","«الندم توبة»","صحيح","Sahih al-Jami al-Saghir 6802","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6803","«الندم توبة والتائب من الذنب كمن لا ذنب له»","حسن","Sahih al-Jami al-Saghir 6803","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6804","«النذر نذران فما كان من نذر في طاعة الله فذلك لله وفيه الوفاء وما كان من نذر في معصية الله فذلك للشيطان ولا وفاء فيه ويكفره ما يكفر اليمين»","صحيح","Sahih al-Jami al-Saghir 6804","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6805","«النذر ... كفارته كفارة يمين»","صحيح","Sahih al-Jami al-Saghir 6805","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6806","«النصر مع الصبر والفرج مع الكرب: وإن مع العسر يسرا»","صحيح","Sahih al-Jami al-Saghir 6806","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6807","«النكاح سنتي فمن لم يعمل بسنتي فليس مني وتزوجوا فإني مكاثر بكم الأمم يوم القيامة ومن كان ذا طول فلينكح ومن لم يجد فعليه بالصيام فإن الصوم له وجاء»","صحيح","Sahih al-Jami al-Saghir 6807","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6808","«النوم أخو الموت ولا يموت أهل الجنة»","صحيح","Sahih al-Jami al-Saghir 6808","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6809","«النياحة على الميت من أمر الجاهلية وإن النائحة إذا لم تتب قبل أن تموت فإنها تبعث يوم القيامة عليها سرابيل من قطران ثم يغلى عليها بدروع من لهب النار»","صحيح","Sahih al-Jami al-Saghir 6809","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6810","«نهى رسول الله صلى الله عليه وسلم أن تتبع جنازة معها رانة»","حسن","Sahih al-Jami al-Saghir 6810","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6811","«نهى أن تستتر الجدر»","حسن","Sahih al-Jami al-Saghir 6811","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6812","«نهى أن تصبر البهائم»","صحيح","Sahih al-Jami al-Saghir 6812","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
"6813","«نهى أن تكلم النساء إلا بإذن أزواجهن»","صحيح","Sahih al-Jami al-Saghir 6813","","","الأحاديث المبدوءة بحرف النون Hadith Beginning with the Letter Nun (ن)"
