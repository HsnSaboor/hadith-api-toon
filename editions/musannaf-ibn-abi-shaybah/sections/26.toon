hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"25051","(۲۵۰۵۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : ذُکِرَ لِعُمَرَ جَرَادٌ بِالرَّبَذَۃِ ، فَقَالَ : لَوَدِدْتُ أَنَّ عِنْدَنَا مِنْہُ قَفْعَۃً ، أَوْ قَفْعَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 25051","","","كتاب الأطعمة"
"25052","(۲۵۰۵۲) حَدَّثَنَا حَفْصٌ، عَنِ الْحَسَنِ بْنِ عُبَیْدِاللہِ، قَالَ: سَمِعْتُ إِبْرَاہِیمَ قَالَ: کُنَّ أُمَّہَاتُ الْمُؤْمِنِینَ یَتَہَادَیْنَ الْجَرَادَ۔n(ابن ماجہ ۳۲۲۰)","","Musannaf Ibn Abi Shaybah 25052","","","كتاب الأطعمة"
"25053","(۲۵۰۵۳) حَدَّثَنَا عَبْدَۃُ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ، عَنِ الْحَسَنِ بْنِ سَعْدٍ، عَنْ أَبِیہ؛ أَنَّہُ کَانَ یُنَقِی لِعَلِیٍّ الْجَرَادَ، فَیَأْکُلُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 25053","","","كتاب الأطعمة"
"25054","(۲۵۰۵۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، وَیَزِیدُ بْنُ ہَارُونَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنِ الْجَرَادِ ؟ فَقَالَ : أَکَلَہُ عُمَرُ ، وَالْمِقْدَادُ بْنُ الأَسْوَدِ ، وَصُہَیْبٌ ، وَعَبْدُ اللہِ بْنُ عُمَرَ ، قَالَ : وَقَالَ عُمَرُ : وَدِدْت أَنَّ عِنْدِی قَفْعَۃً ، أَوْ قَفْعَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 25054","","","كتاب الأطعمة"
"25055","(۲۵۰۵۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ عُمَرَ؛ أَنَّہُ ذَکَرَ الْجَرَادَ ، فَقَالَ : وَدِدْتُ أَنَّ عِنْدِی مِنْہُ قَفْعَۃً ، أَوْ قَفْعَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 25055","","","كتاب الأطعمة"
"25056","(۲۵۰۵۶) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَن الشَّیْبَانِیِّ ، عَن حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ عُمَرَ ؛ بِنَحْوِ حَدِیثِ زَائِدَۃَ ، عَنِ الشَّیْبَانِیِّ۔","Sahih","Musannaf Ibn Abi Shaybah 25056","","","كتاب الأطعمة"
"25057","(۲۵۰۵۷) حَدَّثَنَا عُبَیْدُ اللہِ ، وَالْفَضْلُ ، عَنْ إِسْرَائِیلَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ عُمَرَ کَانَ یَأْکُلُ الْجَرَادَ۔","","Musannaf Ibn Abi Shaybah 25057","","","كتاب الأطعمة"
"25058","(۲۵۰۵۸) حَدَّثَنَا زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ عُمَرَ ، قَالَ : رَأَیْتُ عُمَرَ یَتَحَلَّبُ فُوہُ ، قَالَ : قُلْتُ : یَا أَمِیرَ الْمُؤْمِنِینَ ، قَالَ : أَشْتَہِی جَرَادًا مَقْلِیًّا۔","Sahih","Musannaf Ibn Abi Shaybah 25058","","","كتاب الأطعمة"
"25059","(۲۵۰۵۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُثَنَّی بْنِ سَعِیدٍ أَبِی غِفَارٍ ، قَالَ : سَمِعْتُ جَابِرَ بْنَ زَیْدٍ یَقُولُ : لَقَصْعَۃٌ مِنْ جَرَادٍ أَحَبَّ إِلَیَّ مِنْ قَصْعَۃٍ مِنْ ثَرِیدٍ۔","","Musannaf Ibn Abi Shaybah 25059","","","كتاب الأطعمة"
"25060","(۲۵۰۶۰) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، قَالَ : رَأَیْتُ أَبِی یَأْکُلُ الْجَرَادَ۔","","Musannaf Ibn Abi Shaybah 25060","","","كتاب الأطعمة"
"25061","(۲۵۰۶۱) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ مُحَمَّدِ بْنِ خَالِدٍ الضَّبِّیِّ ، عَنِ الأَخْضَرِ بْنِ الْعَجْلاَنِ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الْجَرَادِ ؟ فَقَالَ : کُلْہُ مَقْلِیًّا بِزَیْتٍ۔","","Musannaf Ibn Abi Shaybah 25061","","","كتاب الأطعمة"
"25062","(۲۵۰۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ الْحَارِثِ ، عَنْ أَبِیہِ ، قَالَ : سُئِلَ عَلِیٌّ عَنِ الْجَرَادِ ؟ فَقَالَ : ہُوَ طَیِّبٌ کَصَیْدِ الْبَحْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 25062","","","كتاب الأطعمة"
"25063","(۲۵۰۶۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ لاَ یَرَی بِأَکْلِ الْجَرَادِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 25063","","","كتاب الأطعمة"
"25064","(۲۵۰۶۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَعْدِ بْنِ إِسْحَاقَ ، عَنْ زَیْنَبَ امْرَأَۃِ أَبِی سَعِیدٍ ، قَالَتْ : کَانَ أَبُو سَعِیدٍ یَرَانَا وَنَحْنُ نَأْکُلُ الْجَرَادَ فَلاَ یَنْہَانَا ، وَلاَ یَأْکُلُہُ ، فَلاَ أَدْرِی تَقَذُّرًا مِنْہُ ، أَوْ یَکْرَہُہُ ؟۔","Hasan","Musannaf Ibn Abi Shaybah 25064","","","كتاب الأطعمة"
"25065","(۲۵۰۶۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، عَنْ سَعِیدِ بْنِ مَرْجَانَۃَ ، قَالَ : کَانَ ابْنُ عُمَرَ لاَ یَأْکُلُ الْجَرَادَ ، قُلْتُ : مَا یَمْنَعُک مِنْ أَکْلِہِ ؟ قَالَ : أَسْتَقْذِرہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25065","","","كتاب الأطعمة"
"25066","(۲۵۰۶۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ أَنَّہُ کَانَ لاَ یَأْکُلُ الْجَرَادَ۔","No Data Available","Musannaf Ibn Abi Shaybah 25066","","","كتاب الأطعمة"
"25067","(۲۵۰۶۷) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ لاَ یَأْکُلُ الْجَرَادَ یَتَقَذَّرُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25067","","","كتاب الأطعمة"
"25068","(۲۵۰۶۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُئِلَ عَنِ الْجَرَادِ ؟ فَقَالَ : أَکْثَرُ جُنُودِ اللہِ ، لاَ آکُلُہُ ، وَلاَ أَنْہَی عَنْہُ۔ (ابوداؤد ۳۸۰۷۔ ابن ماجہ ۳۲۱۹)","","Musannaf Ibn Abi Shaybah 25068","","","كتاب الأطعمة"
"25069","(۲۵۰۶۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ کَعْبٍ ، قَالَ : الْجَرَادُ نَثْرَۃُ حُوتٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 25069","","","كتاب الأطعمة"
"25070","(۲۵۰۷۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : ہُوَ نَثْرَۃُ حُوتٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 25070","","","كتاب الأطعمة"
"25071","(۲۵۰۷۱) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ قَالَ فِی طَیْرٍ وَقَعَ فِی قِدْرٍ فَمَاتَ فِیہَا ، قَالَ: یُصَبُّ الْمَرَقُ، وَیُؤْکَلُ اللَّحْمُ۔","","Musannaf Ibn Abi Shaybah 25071","","","كتاب الأطعمة"
"25072","(۲۵۰۷۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، قَالَ : سَأَلْتُہُ عَنْ طَیْرٍ وَقَعَ فِی قِدْرٍ وَہِیَ تَغْلِی ، فَمَاتَ ؟ فَقَالَ : یُہْرَاقُ الْمَرَقُ ، وَیُؤْکَلُ اللَّحْمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25072","","","كتاب الأطعمة"
"25073","(۲۵۰۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ شَوْذَبٍ ، عَنْ عَمْرَۃَ بِنْتِ الطَّبِیخِ ، قَالَتْ : أَرْسَلَتْنِی أُمِّی فَاشْتَرَیْتُ جَرِّیًّا فَجَعَلْتہ فِی زِنْبِیلٍ ، فَخَرَجَ رَأْسُہُ مِنْ جَانِبٍ وَذَنَبُہُ مِنْ جَانِبٍ ، فَمَرَّ بِی عَلِیٌّ أَمِیرُ الْمُؤْمِنِینَ فَرَآہُ ، فَقَالَ : ہَذَا کَثِیرٌ طَیِّبٌ یُشْبِعُ الْعِیَالَ۔","Da'if","Musannaf Ibn Abi Shaybah 25073","","","كتاب الأطعمة"
"25074","(۲۵۰۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مُجَاشِعٍ أَبِی الرَّبِیعِ ، عَنْ کُہَیْلٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ عَلِیٌّ یَمُرُّ عَلَیْنَا ، وَالْجَرِّیُّ عَلَی سَفَرِنَا وَنَحْنُ نَأْکُلُہُ ، لاَ یَرَی بِہِ بَأْسًا۔","Da'if","Musannaf Ibn Abi Shaybah 25074","","","كتاب الأطعمة"
"25075","(۲۵۰۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عِکْرِمَۃَ ، قَالَ : سُئِلَ ابْنُ عَبَّاسٍ عَنِ الْجَرِّیِّ ؟ فَقَالَ : لاَ بَأْسَ بِہِ ، إِنَّمَا تُحَرِّمُہُ الْیَہُودُ وَنَحْنُ نَأْکُلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25075","","","كتاب الأطعمة"
"25076","(۲۵۰۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ فُضَیْلٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِالْجَرِّیِّ ، إِنَّمَا ہَذَا شَیْئٌ یَرْوُونَہُ عَنْ عَلِیٍّ رَحِمَہُ اللَّہُ فِی الصُّحُفِ۔","","Musannaf Ibn Abi Shaybah 25076","","","كتاب الأطعمة"
"25077","(۲۵۰۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الْجَرِّیِّ ؟ فَقَالَ : ہُوَ مِنَ السَّمَکِ ، إِنْ أَعْجَبَک فَکُلْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25077","","","كتاب الأطعمة"
"25078","(۲۵۰۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، عَنْ مُنْذِرٍ الثَّوْرِیِّ أَبِی یَعْلَی ، قَالَ : سُئِلَ ابْنُ الْحَنَفِیَّۃِ عَنِ الْجَرِّیِّ، وَالطِّحَالِ، وَأَشْبَاہَہُمَا مِمَا یُکْرَہُ ؟ فَتَلاَ ہَذِہِ الآیَۃَ : {قُلْ لاَ أَجِدُ فِیمَا أُوحِیَ إِلَیَّ مُحَرَّمًا}۔","","Musannaf Ibn Abi Shaybah 25078","","","كتاب الأطعمة"
"25079","(۲۵۰۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی سَلَمَۃَ الصَّائِغِ ، قَالَ : سَأَلْتُ عَطَائَ بْنَ أَبِی رَبَاحٍ عَنِ الْجَرِّیِّ ؟ قَالَ : کُلْ ذنْبٍ سَمِینٍ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 25079","","","كتاب الأطعمة"
"25080","(۲۵۰۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : عَلَیْک بِأَذْنَابِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25080","","","كتاب الأطعمة"
"25081","(۲۵۰۸۱) حَدَّثَنَا وَکِیعٌ، عَنْ فُضَیْلِ بْنِ مَرْزُوقٍ، عَنْ إِبْرَاہِیمَ بْنِ عَبْدِاللہِ بْنِ الْحَسَنِ، قَالَ: الْجَرِّیُّ مِنْ صَیْدِ الْبَحْرِ۔","","Musannaf Ibn Abi Shaybah 25081","","","كتاب الأطعمة"
"25082","(۲۵۰۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیع ، عن الْحَسَنِ ، قَالَ : لاَ بَأْسَ بالْجَرِّیّ ، وَالمارماہیک۔","","Musannaf Ibn Abi Shaybah 25082","","","كتاب الأطعمة"
"25083","(۲۵۰۸۳) حَدَّثَنَا حَفْصٌ ، قَالَ : سَمِعْتُ جَعْفَرًا یَقُولُ : مَا لَیْسَ فِیہِ قِشْرٌ مِنَ السَّمَکِ فَإِنَّا نَعَافُہُ ، وَلاَ نَأْکُلُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25083","","","كتاب الأطعمة"
"25084","(۲۵۰۸۴) حَدَّثَنَا أَبو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِالْجَرِّیثِ۔","","Musannaf Ibn Abi Shaybah 25084","","","كتاب الأطعمة"
"25085","(۲۵۰۸۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بِأَکْلِ الْجِرِّیثِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 25085","","","كتاب الأطعمة"
"25086","(۲۵۰۸۶) حَدَّثَنَا وَکِیعٌ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ أَبِی جَعْفَرٍ ؛ أَنَّہُ أُتِیَ بِسُلَحْفَاۃٍ فَأَکَلَہَا۔","","Musannaf Ibn Abi Shaybah 25086","","","كتاب الأطعمة"
"25087","(۲۵۰۸۷) حَدَّثَنَا حَفْصٌ ، عَنِ أَشْعَث ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : کَانَ فُقَہَائُ الْمَدِینَۃِ یَشْتَرُونَ الرَّقَّ ، وَیُغَالُونَ بِہَا حَتَّی بَلَغَ ثَمَنُہَا دِینَارًا۔","","Musannaf Ibn Abi Shaybah 25087","","","كتاب الأطعمة"
"25088","(۲۵۰۸۸) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِأَکْلِہَا ، یَعْنِی السُّلَحْفَاۃَ۔","","Musannaf Ibn Abi Shaybah 25088","","","كتاب الأطعمة"
"25089","(۲۵۰۸۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ لاَ یَرَی بِأَکْلِ السُّلَحْفَاۃِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 25089","","","كتاب الأطعمة"
"25090","(۲۵۰۹۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِأَکْلِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 25090","","","كتاب الأطعمة"
"25091","(۲۵۰۹۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ ابْنُ عمَرَ یَأْمُرُ بِالتَّخَلُّلِ ، وَیَقُولُ : إِنَّ ذَلِکَ إِذَا تُرِکَ وَہَّنَ الأَضْرَاسَ۔","Sahih","Musannaf Ibn Abi Shaybah 25091","","","كتاب الأطعمة"
"25092","(۲۵۰۹۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ یَکْرَہُ لُحُومَ الْجَلاَّلَۃِ ، وَأَلْبَانَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 25092","","","كتاب الأطعمة"
"25093","(۲۵۰۹۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ لُحُومِ الْجَلاَّلَۃِ وَأَلْبَانِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 25093","","","كتاب الأطعمة"
"25094","(۲۵۰۹۴) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا مُغِیرَۃُ بْنُ مُسْلِمٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْجَلاَّلَۃِ أَنْ یُؤْکَلَ لَحْمُہَا ، أَوْ یُشْرَبَ لَبَنُہَا۔ (مسند ۲۳۴۷)","Da'if","Musannaf Ibn Abi Shaybah 25094","","","كتاب الأطعمة"
"25095","(۲۵۰۹۵) حَدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : کَانَ عَطَائٌ لاَ یَرَی بِالْجَلاَّلَۃِ بَأْسًا أَنْ یُحَجَّ عَلَیْہَا ، وَتُؤْکَلَ إِذَا کَانَ أَکْثَرُ عَلَفِہَا غَیْرَ الْجِلَّۃِ ، وَإِن کَانَ أَکْثَرُ عَلَفِہَا الْجِلَّۃُ ، فَإِنَّہ کَرِہَہَا۔","","Musannaf Ibn Abi Shaybah 25095","","","كتاب الأطعمة"
"25096","(۲۵۰۹۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : کَانَ لاَ یَرَی بِأَکْلِہَا بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 25096","","","كتاب الأطعمة"
"25097","(۲۵۰۹۷) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ ، قَالَ : نُہِیَ عَنْ أَلْبَانِ الْجَلاَّلَۃِ وَلُحُومِہَا ، وَأَنْ یُحَجَّ عَلَیْہَا وَأَنْ یُعْتَمَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 25097","","","كتاب الأطعمة"
"25098","(۲۵۰۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَحْبِسُ الدَّجَاجَۃَ الْجَلاَّلَۃَ ثَلاَثًا۔","Sahih","Musannaf Ibn Abi Shaybah 25098","","","كتاب الأطعمة"
"25099","(۲۵۰۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ لَبَنِ الشَّاۃِ الْجَلاَّلَۃِ۔ (ترمذی ۱۸۲۵۔ ابوداؤد ۳۷۸۰)","","Musannaf Ibn Abi Shaybah 25099","","","كتاب الأطعمة"
"25100","(۲۵۱۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ لَحْمِ الشَّاۃِ الْجَلاَلَۃِ۔","","Musannaf Ibn Abi Shaybah 25100","","","كتاب الأطعمة"
"25101","(۲۵۱۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إِبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ أَلْبَانِ الْجَلاَّلَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 25101","","","كتاب الأطعمة"
"25102","(۲۵۱۰۲) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی رَوَّادٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ عِنْدَہُ إِبِلٌ جَلاَّلَۃٌ ، فَأَصْدَرَہَا إِلَی الْحِمَی ثُمَّ رَدَّہَا ، فَحَمَلَ عَلَیْہَا الزَّوَامِلَ إِلَی مَکَّۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 25102","","","كتاب الأطعمة"
"25103","(۲۵۱۰۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَجَّاجُ بْنُ أَبِی زَیْنَبَ ، قَالَ : حَدَّثَنَا أَبُو سُفْیَانَ طَلْحَۃُ بْنُ نَافِعٍ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : نِعْمَ الإِدَامُ الْخَلُّ۔ (ترمذی ۱۸۳۹۔ ابوداؤد ۳۸۱۷)","Hasan","Musannaf Ibn Abi Shaybah 25103","","","كتاب الأطعمة"
"25104","(۲۵۱۰۴) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : نِعْمَ الإِدَامُ الْخَلُّ۔ (ابوداؤد ۳۸۱۶۔ ترمذی ۱۸۳۹)","Hasan","Musannaf Ibn Abi Shaybah 25104","","","كتاب الأطعمة"
"25105","(۲۵۱۰۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ عَبْدِ اللہِ بْنِ الْمُؤَمِّلِ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : نِعْمَ الإِدَامُ الْخَلُّ۔ (مسلم ۱۶۴۔ ابن ماجہ ۳۳۱۶)","Da'if","Musannaf Ibn Abi Shaybah 25105","","","كتاب الأطعمة"
"25106","(۲۵۱۰۶) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ أَبِی حَمْزَۃَ، عَنْ إِبْرَاہِیمَ؛ فِی الْمُضْطَرِّ إِلَی الْمَیْتَۃِ، قَالَ: یَأْکُلُ مَا یُقِیمُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25106","","","كتاب الأطعمة"
"25107","(۲۵۱۰۷) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : إِذَا اضْطُرَّ إِلَی مَا حُرِّمَ عَلَیْہِ ، فَہُوَ لَہُ حَلاَلٌ۔","","Musannaf Ibn Abi Shaybah 25107","","","كتاب الأطعمة"
"25108","(۲۵۱۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ أُکْرِہَ عَلَی لَحْمِ الْخِنْزِیرِ وَشُرْبِ الْخَمْرِ ، قَالَ : إِنْ أَکَلَ فَرُخْصَۃٌ ، وَإِنْ لَمْ یَأْکُلْ فَقُتِلَ دَخَلَ الْجَنَّۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 25108","","","كتاب الأطعمة"
"25109","(۲۵۱۰۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ سَلاَّمِ بْنِ مِسْکِینٍ ، قَالَ : دَخَلْتُ عَلَی جَابِرِ بْنِ زَیْدٍ وَہُوَ یَأْکُلُ عَلَی خِوَانٍ خَلْنَجٍ۔","","Musannaf Ibn Abi Shaybah 25109","","","كتاب الأطعمة"
"25110","(۲۵۱۱۰) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ فِی الْخَادِمِ الْمَجُوسِیَّۃِ تَکُونُ لِلرَّجُلِ الْمُسْلِم، فَتَطْبُخُ لَہُ وَتَعْمَلُ لَہُ ، فَلَمْ یَرَ بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 25110","","","كتاب الأطعمة"
"25111","(۲۵۱۱۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ سُلَیْمَانَ بْنِ مَیْسَرَۃَ ، وَالْمُغِیرَۃِ بْنِ شُبْیلٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ: دَخَلْتُ عَلَی سَلْمَانَ وَعِنْدَہُ عِلْجَۃٌ تُعَاطِیہ۔","Sahih","Musannaf Ibn Abi Shaybah 25111","","","كتاب الأطعمة"
"25112","(۲۵۱۱۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، قَالَ : دَخَلْتُ عَلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فَرَأَیْتُ عَلَی إِخْوَانِہِ أَلْوَانَ السِّبَاعِ ، أَوْ قَالَ : سِبَاعٌ مِنَ الطَّیْرِ۔","","Musannaf Ibn Abi Shaybah 25112","","","كتاب الأطعمة"
"25113","(۲۵۱۱۳) حَدَّثَنَا إِسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یَحْیَی بْنِ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ عَلَی أَنَسِ بْنِ مَالِکٍ مِطْرَفَ خَزٍّ ، وَرَأَیْتُ عَلَی الْقَاسِمِ مِطْرَفَ خَزٍّ ، وَرَأَیْتُ عَلَی عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ خَزًّا۔","Sahih","Musannaf Ibn Abi Shaybah 25113","","","كتاب اللباس"
"25114","(۲۵۱۱۴) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْعَیْزَارِ بْنِ حُرَیْثٍ ، قَالَ : رَأَیْتُ الْحُسَیْنَ بْنَ عَلِیٍّ وَعَلَیْہِ کِسَائُ خَزٍّ ، وَکَانَ یُخَضِّبُ بِالْحِنَّائِ وَالْکَتَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 25114","","","كتاب اللباس"
"25115","(۲۵۱۱۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : رَأَیْتُ عَلَی عَبْدِ اللہِ بْنِ أَبِی أَوْفَی مِطْرَفَ خَزٍّ۔","Sahih","Musannaf Ibn Abi Shaybah 25115","","","كتاب اللباس"
"25116","(۲۵۱۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عُیَیْنَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، قَالَ : کَانَ لأَبِی بَکْرَۃَ مِطْرَفُ خَزٍّ سَدَاہُ حَرِیرٌ ، فَکَانَ یَلْبَسُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25116","","","كتاب اللباس"
"25117","(۲۵۱۱۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ أَبِی بْنِ زِیَادٍ ، قَالَ : رَأَیْتُ عَلَی عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی مِطْرَفَ خَزٍّ فَلَبِسَہُ حَتَّی تَقَطَّعَ ، ثُمَّ نَقَضَہُ مَرَّۃً أُخْرَی۔","","Musannaf Ibn Abi Shaybah 25117","","","كتاب اللباس"
"25118","(۲۵۱۱۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ أَنَّہُ کَانَ لَہَا کِسَائُ خَزٍّ ، فَکَسَتْہُ ابْنَ الزُّبَیْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 25118","","","كتاب اللباس"
"25119","(۲۵۱۱۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : رَأَیْتُ الأَحْنَفَ بْنَ قَیْسٍ عَلَی بَغْلَۃٍ ، وَرَأَیْتُ عَلَیْہِ عِمَامَۃَ خَزٍّ ، وَمِطْرَفَ خَزٍّ۔","","Musannaf Ibn Abi Shaybah 25119","","","كتاب اللباس"
"25120","(۲۵۱۲۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : رَأَیْتُ عَلَی قَیْسِ بْنِ أَبِی حَازِمٍ ، وَشُبَیْلِ بْنِ عَوْفٍ ، وَالشَّعْبِیِّ ؛ مَطَارِفَ الْخَزِّ ، وَرَأَیْتُ عَلَی شُرَیْحٍ مِطْرَفَ خَزٍّ ، وَبُرْنُسَ خَزٍّ۔","","Musannaf Ibn Abi Shaybah 25120","","","كتاب اللباس"
"25121","(۲۵۱۲۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ عِمْرَانَ الْقَطَّانِ ، قَالَ : أَخْبَرَنِی عَمَّارٌ ، قَالَ : رَأَیْتُ عَلَی أَبِی قَتَادَۃَ مِطْرَفَ خَزٍّ ، وَرَأَیْتُ عَلَی أَبِی ہُرَیْرَۃَ مِطْرَفَ خَزٍّ ، وَرَأَیْتُ عَلَی ابْنِ عَبَّاسٍ مَا لاَ أُحْصِی۔","Da'if","Musannaf Ibn Abi Shaybah 25121","","","كتاب اللباس"
"25122","(۲۵۱۲۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْوَلِیدِ بْنِ جُمَیْعٍ ، قَالَ : رَأَیْتُ عَلَی أَبِی عُبَیْدَۃَ بْنِ عَبْدِ اللہِ بُرْنُسَ خَزٍّ۔","","Musannaf Ibn Abi Shaybah 25122","","","كتاب اللباس"
"25123","(۲۵۱۲۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : رَأَیْتُ عَلَی عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، وَعُرْوَۃَ بْنِ الزُّبَیْرِ ، وَعَلَی أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ أَکْسِیَۃَ خَزٍّ۔","Sahih","Musannaf Ibn Abi Shaybah 25123","","","كتاب اللباس"
"25124","(۲۵۱۲۴) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ : رَأَیْتُ عَلَی الْقَاسِمِ ، وَأَبِی جَعْفَرٍ جُبَّتَیْنِ مِنْ خَزٍّ ، وَجُبَّۃُ أَبِی جَعْفَرٍ مِنْ خَزِّ أَدْکَنَ۔","","Musannaf Ibn Abi Shaybah 25124","","","كتاب اللباس"
"25125","(۲۵۱۲۵) حَدَّثَنَا ابْنُ نُمَیْرٍ، عَنِ الأَجْلَحِ، عَنْ حَبِیبٍ، قَالَ: کَانَ لِعَلِیِّ بْنِ الْحُسَیْنِ کِسَائُ خَزٍّ ، یَلْبَسُہُ کُلَّ جُمُعَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 25125","","","كتاب اللباس"
"25126","(۲۵۱۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عُیَیْنَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، قَالَ : جَلَسْتُ إِلَی سَعِیدِ بْنِ الْمُسَیَّبِ وَعَلَیَّ جُبَّۃُ خَزٍّ ، فَأَخَذَ بِکُمِّ جُبَّتِی وَقَالَ : مَا أَجْوَدَ جُبَّتَکَ ہَذِہِ ، قَالَ : قُلْتُ : وَمَا تُغْنِی وَقَدْ أَفْسَدُوہَا عَلَیَّ ، قَالَ: وَمَنْ أَفْسَدَہَا؟ قُلْتُ: سَالِمٌ ، قَالَ: إِذَا صَلُحَ قَلْبُک فَالْبَسْ مَا بَدَا لَکَ ، قَالَ : فَذَکَرْتُ قَوْلَہُمَا لِلْحَسَنِ، فَقَالَ : إِنَّ مِنْ صَلاَحِ الْقَلْبِ تَرْکَ الْخَزِّ۔","","Musannaf Ibn Abi Shaybah 25126","","","كتاب اللباس"
"25127","(۲۵۱۲۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، سَأَلْتُہُ ، قُلْتُ : کَانُوا یَلْبَسُونَ الْخَزَّ ؟ قَالَ : کَانُوا یَلْبَسُونَہُ وَیَکْرَہُونَہُ ، وَیَرْجُونَ رَحْمَۃَ اللہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25127","","","كتاب اللباس"
"25128","(۲۵۱۲۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ، عَنِ الشَّیْبَانِیِّ، قَالَ: رَأَیْتُ مُحَمَّدَ بْنَ عَلِیٍّ بِعَرَفَاتٍ، وَعَلَیْہِ مِطْرَفٌ مِنْ خَزٍّ أَصْفَرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 25128","","","كتاب اللباس"
"25129","(۲۵۱۲۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ صَفْوَانَ بْنِ عَبْدِ اللہِ ، قَالَ : اسْتَأْذَنَ سَعْدٌ عَلَی ابْنِ عَامِرٍ ، وَتَحْتَہُ مَرَافِقُ مِنْ حَرِیرٍ ، فَأَمَرَ بِہَا فَرُفِعَتْ ، فَلَمَّا دَخَلَ سَعْدٌ دَخَلَ وَعَلَیْہِ مِطْرَفٌ مِنْ خَزٍّ ، فَقَالَ لَہُ : اسْتَأْذَنْتَ عَلَیَّ وَتَحْتِی مَرَافِقُ مِنْ حَرِیرٍ ، فَأَمَرْت بِہَا فَرُفِعَتْ ، فَقَالَ لَہُ سَعْدٌ : نِعْمَ الرَّجُلُ أَنْتَ إِنْ لَمْ تَکُنْ مِمَنْ قَالَ اللَّہُ : {أَذْہَبْتُمْ طَیِّبَاتِکُمْ فِی حَیَاتِکُمُ الدُّنْیَا} وَاللَّہ لأَنْ أَضْطَجِعَ عَلَی جَمْرِ الْغَضَی أَحَبَّ إِلَیَّ مِنْ أَنْ أَضْطَجِعَ عَلَیْہَا ، قَالَ : فَہَذَا عَلَیْک شَطْرُہُ حَرِیرٌ وَشَطْرُہُ خَزٌّ ، قَالَ : إِنَّمَا یَلِی جِلْدِی مِنْہُ الْخَزُّ۔","Sahih","Musannaf Ibn Abi Shaybah 25129","","","كتاب اللباس"
"25130","(۲۵۱۳۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنِی شُعْبَۃُ ، عَنْ مُحَمَّدِ بْنِ زِیَادٍ ، قَالَ : رَأَیْتُ عَلَی أَبِی ہُرَیْرَۃَ مِطْرَفَ خَزٍّ قَدْ ثَنَاہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25130","","","كتاب اللباس"
"25131","(۲۵۱۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ حَکِیمِ بْنِ جُبَیْرٍ ، عَنْ خَیْثَمَۃَ ؛ أَنَّ ثَلاَثَۃَ عَشَرَ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانُوا یَلْبَسُونَ خَزًّا۔","Da'if","Musannaf Ibn Abi Shaybah 25131","","","كتاب اللباس"
"25132","(۲۵۱۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عُثْمَانَ بْنِ أَبِی ہِنْدٍ ، قَالَ : رَأَیْتُ عَلَی أَبِی عُبَیْدَۃَ مِطْرَفَ خَزٍّ ، وَرَأَیْتُ عَلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ مِطْرَفَ خَزٍّ أَبْیَضَ۔","","Musannaf Ibn Abi Shaybah 25132","","","كتاب اللباس"
"25133","(۲۵۱۳۳) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ لَبِسَ الْحَرِیرَ فِی الدُّنْیَا لَمْ یَلْبَسْہُ فِی الآخِرَۃِ۔ (بخاری ۵۸۳۲۔ مسلم ۲۱)","Sahih","Musannaf Ibn Abi Shaybah 25133","","","كتاب اللباس"
"25134","(۲۵۱۳۴) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُبَیْرَۃَ ، قَالَ : أُہْدِیَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حُلَّۃٌ مِنْ حَرِیرٍ ، فَأَہْدَاہَا لِعَلِیٍّ فَلَبِسَہَا عَلِیٌّ ، فَلَمَّا رَآہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إِنِّی أَکْرَہُ لَکَ مَا أَکْرَہُ لِنَفْسِی ، اجْعَلْہَا خُمُرًا بَیْنَ النِّسَائِ۔","","Musannaf Ibn Abi Shaybah 25134","","","كتاب اللباس"
"25135","(۲۵۱۳۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، وَابْنُ نُمَیْرٍ ، وَأَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنْ سَعِیدِ بْنِ أَبِی ہِنْدٍ ، عَنْ أَبِی مُوسَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَرِیرُ وَالذَّہَبُ حَرَامٌ عَلَی ذُکُورِ أُمَّتِی ، حِلٌّ لإِنَاثِہِمْ۔ (ترمذی ۱۷۲۰۔ احمد ۴/۳۹۲)","","Musannaf Ibn Abi Shaybah 25135","","","كتاب اللباس"
"25136","(۲۵۱۳۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ مُعَاوِیَۃَ بْنِ سُوَیْد ، عَنِ الْبَرَائِ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الدِّیبَاجِ وَالْحَرِیرِ وَالإِسْتَبْرَقِ۔","Sahih","Musannaf Ibn Abi Shaybah 25136","","","كتاب اللباس"
"25137","(۲۵۱۳۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ أَبِی فَاخِتَۃَ ، قَالَ : حدَّثَنِی ہُبَیْرَۃُ بْنُ یَرِیمٍ ، عَنْ عَلِیٍّ ؛ أَنَّہُ أُہْدِیَ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حُلَّۃٌ مُسَیَّرَۃٌ بِحَرِیرٍ إِمَّا سَدَاہَا ، أَوْ لُحْمَتُہَا ، فَأَرْسَلَ بِہَا إِلَیَّ ، فَأَتَیْتُہُ فَقُلْتُ: یَا رَسُولَ اللہِ ، مَا أَصْنَعُ بِہَا، أَلْبَسُہَا؟ قَالَ: لاَ ، إِنِّی لاَ أَرْضَی لَکَ مَا أَکْرَہُ لِنَفْسِی، وَلَکِنِ اجْعَلْہَا خُمُرًا بَیْنَ الْفَوَاطِمِ۔ (ابن ماجہ ۳۵۹۶)","Da'if","Musannaf Ibn Abi Shaybah 25137","","","كتاب اللباس"
"25138","(۲۵۱۳۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ حُذَیْفَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَانَا أَنْ نَلْبَسَ الْحَرِیرَ وَالدِّیبَاجَ ، وَقَالَ : ہُوَ لَہُمْ فِی الدُّنْیَا ، وَلَکُمْ فِی الآخِرَۃِ۔n(مسلم ۱۶۳۷۔ نسائی ۹۶۱۵)","Da'if","Musannaf Ibn Abi Shaybah 25138","","","كتاب اللباس"
"25139","(۲۵۱۳۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ أَبِی فَاخِتَۃَ ، قَالَ : حدَّثَنِی جَعْدَۃُ بْنُ ہُبَیْرَۃَ ، عَنْ عَلِیٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ بِنَحْوِ حَدِیثِ عَبْدِ الرَّحِیمِ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ أَبِی فَاخِتَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 25139","","","كتاب اللباس"
"25140","(۲۵۱۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ حُذَیْفَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ لبْسِ الْحَرِیرِ وَالذَّہَبِ ، وَقَالَ : ہُوَ لَہُمْ فِی الدُّنْیَا ، وَلَنَا فِی الآخِرَۃِ۔n(بخاری ۵۸۳۱۔ مسلم ۱۶۳۷)","Sahih","Musannaf Ibn Abi Shaybah 25140","","","كتاب اللباس"
"25141","(۲۵۱۴۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ أَخْبَرَہُ ، أَنَّ عُمَرَ بْنَ الْخَطَّابَ رَأَی حُلَّۃً سِیَرَائَ مِنْ حَرِیرٍ ، فَقَالَ : یَا رَسُولَ اللہِ ، لَوِ ابْتَعْتَ ہَذِہِ الْحُلَّۃَ لِلْوَفْدِ وَلِیَوْمِ الْجُمُعَۃِ ؟ فَقَالَ : إِنَّمَا یَلْبَسُ ہَذِہِ مَنْ لاَ خَلاَقَ لَہُ فِی الآخِرَۃِ۔ (بخاری ۸۸۶۔ مسلم ۱۶۳۸)","Da'if","Musannaf Ibn Abi Shaybah 25141","","","كتاب اللباس"
"25142","(۲۵۱۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، وَیَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ مَرْثَدَ بْنِ عَبْدِ اللہِ الْیَزَنِیِّ ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ الْجُہَنِیِّ ، قَالَ : صَلَّی بِنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَغْرِبَ وَعَلَیْہِ فَرُّوجٌ ، یَعْنِی قَبَائً مِنْ حَرِیرٍ ، فَلَمَّا قَضَی صَلاَتَہُ نَزَعَہُ نَزْعًا عَنِیفًا ، فَقُلْتُ : یَا رَسُولَ اللہِ ، صَلَّیْتَ وَہُوَ عَلَیْک ، قَالَ : إِنَّ ہَذَا لاَ یَنْبَغِی لِلْمُتَّقِینَ۔ (بخاری ۳۷۵۔ مسلم ۲۳)","","Musannaf Ibn Abi Shaybah 25142","","","كتاب اللباس"
"25143","(۲۵۱۴۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، عَنْ عُمَرَ ؛ أَنَّہُ کَانَ یَنْہَی عَنِ الْحَرِیرِ وَالدِّیبَاجِ إِلاَّ مَا کَانَ ہَکَذَا ، ثُمَّ وَأَشَارَ بِإِصْبعِہِ ، ثُمَّ الثَّانِیَۃِ ، ثُمَّ الثَّالِثَۃِ ، ثُمَّ الرَّابِعَۃِ وَقَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَانَا عَنْہُ۔ (بخاری ۵۸۲۸۔ مسلم ۱۶۴۲)","Sahih","Musannaf Ibn Abi Shaybah 25143","","","كتاب اللباس"
"25144","(۲۵۱۴۴) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنِ الأَعْمَشِ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ، عَنْ أَبِی کَنَفٍ، قَالَ: انْطَلَقْتُ مَعَ عَبْدِ اللہِ حَتَّی أَتَیْتُ دَارَہُ ، فَأَتَاہُ بَنُونَ لَہُ عَلَیْہِمْ قُمُصُ حَرِیرٍ فَخَرَقَہَا ، وَقَالَ : انْطَلِقُوا إِلَی أُمِّکُمْ فَلْتُلْبِسکُمْ غَیْرَ ہَذَا۔","Da'if","Musannaf Ibn Abi Shaybah 25144","","","كتاب اللباس"
"25145","(۲۵۱۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ فُضَیْلِ بْنِ غَزْوَانَ ، عَنِ الْمُہَاجِرِ بْنِ شَمَّاسٍ ، عَنْ عَمِّہِ ، قَالَ : رَأَی ابْنُ مَسْعُودٍ ابْنًا لَہُ عَلَیْہِ قَمِیصٌ مِنْ حَرِیرٍ ، فَشَقَّہُ ، وَقَالَ : إِنَّمَا ہَذَا لِلنِّسَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 25145","","","كتاب اللباس"
"25146","(۲۵۱۴۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ سُلَیْمَانَ بْنِ أَبِی الْمُغِیرَۃِ الْعَبْسِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : قدِمَ حُذَیْفَۃُ بْنُ الْیَمَانِ مِنْ سَفَرٍ ، وَقَدْ کُسِیَ وَلَدُہُ الْحَرِیرَ ، فَنَزَعَ مِنْہُ مَا کَانَ عَلَی ذُکُورِ وَلَدِہِ ، وَتَرَکَ مِنْہُ مَا کَانَ عَلَی بَنَاتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 25146","","","كتاب اللباس"
"25147","(۲۵۱۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِیہِ ، قَالَ : دَخَلَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ وَمَعَہُ ابْنٌ لَہُ عَلَی عُمَرَ ، عَلَیْہِ قَمِیصُ حَرِیرٍ ، فَشَقَّ الْقَمِیصَ۔","Sahih","Musannaf Ibn Abi Shaybah 25147","","","كتاب اللباس"
"25148","(۲۵۱۴۸) حَدَّثَنَا عُبَیْد بْنُ سَعِیدٍ، عَنْ شُعْبَۃَ ، عَنْ خَلِیفَۃَ بْنِ کَعْبٍ؛ أَنَّہُ ، قَالَ: سَمِعْتُ عَبْدَ اللہِ بْنَ الزُّبَیْرِ یَخْطُبُ، قَالَ: قَالَ: أَلاَ لاَ تُلْبِسُوا نِسَائَ کُمُ الْحَرِیرَ، فَإِنِّی سَمِعْت عُمَرَ بْنَ الْخَطَّابِ یَقُولُ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَلْبَسُوا الْحَرِیرَ ، فَإِنَّہُ مَنْ لَبِسَہُ فِی الدُّنْیَا لَمْ یَلْبَسْہُ فِی الآخِرَۃِ۔ (بخاری ۵۸۳۴۔ مسلم ۱۶۴۱)","Sahih","Musannaf Ibn Abi Shaybah 25148","","","كتاب اللباس"
"25149","(۲۵۱۴۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ أَبِی الصَّعْبَۃِ ، عَنْ أَبِی أَفْلَحَ الْہَمْدَانِیِّ ، عَنْ عَبْدِ اللہِ بْنِ زُرَیْرٍ الْغَافِقِیِّ سَمِعْہ یَقُولُ : سَمِعْتُ عَلِیَّ بْنَ أَبِی طَالِبٍ یَقُولُ : أَخَذَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَرِیرًا بِشِمَالِہِ وَذَہَبًا بِیَمِینِہِ ، ثُمَّ رَفَعَ بِہِمَا یَدَیْہِ فَقَالَ: إِنَّ ہَذَیْنِ حَرَامٌ عَلَی ذُکُورِ أُمَّتِی ، حِلٌّ لإِنَاثِہِمْ۔ (ابوداؤد ۴۰۵۴۔ احمد ۱/۱۱۵)","Hasan","Musannaf Ibn Abi Shaybah 25149","","","كتاب اللباس"
"25150","(۲۵۱۵۰) حَدَّثَنَا عَفَّانُ ، قَالَ: أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ: أَخْبَرَنَا أَنَس بْنُ سِیرِینَ ، عَنْ أَبِی مِجْلَزٍ ، عَنْ حَفْصَۃَ؛ أَنَّ عُطَارِدَ بْنَ حَاجِبٍ جَائَ بِثَوْبِ دِیبَاجٍ کَسَاہُ إِیَّاہُ کِسْرَی ، فَقَالَ عُمَرُ : أَلاَ أَشْتَرِیہِ لَکَ یَا رَسُولَ اللہِ ؟ قَالَ : إِنَّمَا یَلْبَسُہُ مَنْ لاَ خَلاَقَ لَہُ۔ (بخاری ۸۸۶۔ احمد ۶/۲۸۸)","Sahih","Musannaf Ibn Abi Shaybah 25150","","","كتاب اللباس"
"25151","(۲۵۱۵۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی التَّیَّاحِ ، عَنْ حَفْصٍ اللَّیْثِیِّ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ الْحَنْتَمِ ، وَالتَّخَتُّمِ بِالذَّہَبِ ، وَالْحَرِیرِ۔","Da'if","Musannaf Ibn Abi Shaybah 25151","","","كتاب اللباس"
"25152","(۲۵۱۵۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنِ الإِفْرِیقِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ رَافِعٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ: خَرَجَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَفِی إِحْدَی یَدَیْہِ ثَوْبٌ مِنْ حَرِیرٍ ، وَفِی الأُخْرَی ذَہَبٌ، فَقَالَ : إِنَّ ہَذَیْنِ مُحَرَّمٌ عَلَی ذُکُورِ أُمَّتِی ، حِلٌّ لإِنَاثِہِمْ۔ (ابن ماجہ ۳۵۹۷۔ طبرانی ۱۲۶)","Da'if","Musannaf Ibn Abi Shaybah 25152","","","كتاب اللباس"
"25153","(۲۵۱۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ عُمَرَ بْنِ سَعِیدِ بْنِ أَبِی حُسَیْنٍ ، عَنْ عَلِیِّ بْنِ عَبْدِ اللہِ بْنِ عَلِیٍّ، قَالَ : أَخْبَرَنِی أَبِی ، أَنَّہُ سَمِعَ مُعَاوِیَۃَ وَہُوَ عَلَی الْمِنْبَرِ ، یَقُولُ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ لُبْسِ الْحَرِیرِ وَالذَّہَبِ۔ (احمد ۴/۹۶)","Da'if","Musannaf Ibn Abi Shaybah 25153","","","كتاب اللباس"
"25154","(۲۵۱۵۴) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ حُمَیْدٍ ، قَالَ : سُئِلَ أَنَسٌ عَنِ الْحَرِیرِ ؟ فَقَالَ : نَعُوذُ بِاللَّہِ مِنْ شَرِّہِ ، کُنَّا نَسْمَعُ أَنَّہُ مَنْ لَبِسَہُ فِی الدُّنْیَا ، لَمْ یَلْبَسْہُ فِی الآخِرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 25154","","","كتاب اللباس"
"25155","(۲۵۱۵۵) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، عَنْ طَاوُوسٍ ؛ أَنَّہُ کَانَ یَکْرَہُ لُبْسَ الْحَرِیرِ۔","","Musannaf Ibn Abi Shaybah 25155","","","كتاب اللباس"
"25156","(۲۵۱۵۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ کَانَ یَکْرَہُ قَلِیلَ الْحَرِیرِ وَکَثِیرَہُ۔","","Musannaf Ibn Abi Shaybah 25156","","","كتاب اللباس"
"25157","(۲۵۱۵۷) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حُصَیْنٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : لاَ تَلْبَسُوا مِنَ الْحَرِیرِ إِلاَّ مَا کَانَ سَدَاہُ قُطْنًا ، أَوْ کَتَّانًا۔","No Data Available","Musannaf Ibn Abi Shaybah 25157","","","كتاب اللباس"
"25158","(۲۵۱۵۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْن مَیْسَرَۃَ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ عَلِیٍّ ، قَالَ : کَسَانِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حُلَّۃً سِیَرَائَ فَرَحْتُ فِیہَا ، فَرَأَیْت الْغَضَبَ فِی وَجْہِہِ ، قَالَ : فَشَقَقْتہَا بَیْنَ نِسَائِی۔ (بخاری ۵۸۴۰۔ ۹۶۰۷)","Sahih","Musannaf Ibn Abi Shaybah 25158","","","كتاب اللباس"
"25159","(۲۵۱۵۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ دَاوُدَ السَّرَّاجِ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : مَنْ لَبِسَ الْحَرِیرَ فِی الدُّنْیَا ، لَمْ یَلْبَسْہُ فِی الآخِرَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 25159","","","كتاب اللباس"
"25160","(۲۵۱۶۰) حَدَّثَنَا رَیْحَانُ بْنُ سَعِیدٍ ، عَنْ مَرْزُوقِ بْنِ عَمْرٍو ، قَالَ : قَالَ أَبُو فَرْقَدٍ : رَأَیْتُ عَلَی تَجَافِیفِ أَبِی مُوسَی الدِّیبَاجَ وَالْحَرِیرَ۔","Da'if","Musannaf Ibn Abi Shaybah 25160","","","كتاب اللباس"
"25161","(۲۵۱۶۱) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ لأَبِی یَلْمَقُ مِنْ دِیبَاجٍ یَلْبَسُہُ فِی الْحَرْبِ۔","","Musannaf Ibn Abi Shaybah 25161","","","كتاب اللباس"
"25162","(۲۵۱۶۲) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِہِ إِذَا کَانَ جُبَّۃً ، أَوْ سِلاَحًا۔","","Musannaf Ibn Abi Shaybah 25162","","","كتاب اللباس"
"25163","(۲۵۱۶۳) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِلُبْسِ الْحَرِیرِ فِی الْحَرْبِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25163","","","كتاب اللباس"
"25164","(۲۵۱۶۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ؛ أَنَّ أَنَسَ بْنَ مَالِکٍ أَنْبَأَہُمْ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَخَّصَ لِلزُّبَیْرِ بْنِ الْعَوَّامِ ، وَلِعَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ فِی قَمِیصَیْنِ مِنْ حَرِیرٍ ، مِنْ وَجَعٍ کَانَ بِہِمَا ، حِکَّۃٍ۔ (بخاری ۲۹۱۹۔ مسلم ۱۶۴۶)","Sahih","Musannaf Ibn Abi Shaybah 25164","","","كتاب اللباس"
"25165","(۲۵۱۶۵) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الْوَلِیدِ بْنِ ہِشَامٍ ، قَالَ : کَتَبْتُ إِلَی ابْنِ مُحَیرِیز أَسْأَلُہُ عَنْ لُبْسِ الْیَلاَمِقِ وَالْحَرِیرِ فِی دَار الْحَرْبِ ؟ قَالَ : فَکَتَبَ : أَنْ کُنْ أَشَدَّ مَا کُنْتُ کَرَاہِیَۃً لِمَا تُکْرَہُ عِنْدَ الْقِتَالِ ، حِینَ تُعَرِّضُ نَفْسَک لِلشَّہَادَۃِ۔","","Musannaf Ibn Abi Shaybah 25165","","","كتاب اللباس"
"25166","(۲۵۱۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی مَکِینٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ کَرِہَہُ فِی الْحَرْبِ ، وَقَالَ : أَرْجَی مَا یَکُونُ لِلشَّہَادَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25166","","","كتاب اللباس"
"25167","(۲۵۱۶۷) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ مُحَمَّدًا عَنْ لُبْسِ الدِّیبَاجِ فِی الْحَرْبِ ؟ فَقَالَ: مِنْ أَیْنَ کَانُوا یَجِدُونَ الدِّیبَاجَ ؟","No Data Available","Musannaf Ibn Abi Shaybah 25167","","","كتاب اللباس"
"25168","(۲۵۱۶۸) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنْ سُوَیْد بْنِ غَفَلَۃً ، قَالَ : شَہِدْنَا الْیَرْمُوکَ ، قَالَ : فَاسْتَقْبَلَنَا عُمَرُ وَعَلَیْنَا الدِّیبَاجُ وَالْحَرِیرُ ، فَأَمَرَ بِرَمْیِنَا بِالْحِجَارَۃِ ، قَالَ : فَقُلْنَا : مَا بَلَغَہُ عَنَّا ؟ قَالَ : فَنَزَعْنَاہُ وَقُلْنَا : کَرِہَ زِیَّنَا ، فَلَمَّا اسْتَقْبَلْنَاہُ رَحَّبَ بِنَا ، وَقَالَ : إِنَّکُمْ جِئْتُمُونِی فِی زِیِّ أَہْلِ الشِّرْکِ ، إِنَّ اللَّہَ لَمْ یَرْضَ لِمَنْ قَبْلَکُمُ الدِّیبَاجَ ، وَلا?? الْحَرِیرَ۔","Sahih","Musannaf Ibn Abi Shaybah 25168","","","كتاب اللباس"
"25169","(۲۵۱۶۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَنَسٍ ، قَالَ : رَأَیْتُ عَلَی زَیْنَبَ بِنْتِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَمِیصَ حَرِیرٍ سِیَرَائَ۔ (ابن ماجہ ۳۵۹۸۔ نسائی ۹۵۷۶)","Sahih","Musannaf Ibn Abi Shaybah 25169","","","كتاب اللباس"
"25170","(۲۵۱۷۰) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ ثَابِتِ بْنِ زَیْدٍ ، قَالَ : حَدَّثَتْنِی حَمَادَۃُ ، عَنْ أُنَیْسَۃَ بِنْتِ زَیْدٍ ؛ أَنَّ أَبَاہَا دَخَلَ عَلَیْہَا فِی بَیْتِہَا وَعَلَیْہَا قَمِیصٌ مِنْ حَرِیرٍ ، فَخَرَجَ وَہُوَ مُغْضَبٌ۔","Da'if","Musannaf Ibn Abi Shaybah 25170","","","كتاب اللباس"
"25171","(۲۵۱۷۱) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، عَنْ عُمَرَ ؛ أَنَّہُ قَالَ : لاَ یَصْلُحُ مِنْہُ إِلاَّ ہَکَذَا ؛ إِصْبَعًا ، أَوْ إِصْبَعَیْنِ ، أَوْ ثَلاَثَۃً ، أَوْ أَرْبَعَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 25171","","","كتاب اللباس"
"25172","(۲۵۱۷۲) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ حَبِیبٍ ، عَنْ زِرٍّ ، قَالَ : قَالَ عُمَرُ : لاَ تَلْبَسُوا مِنَ الْحَرِیرِ إِلاَّ إِصْبَعَیْنِ ، أَوْ ثَلاَثۃ۔","Sahih","Musannaf Ibn Abi Shaybah 25172","","","كتاب اللباس"
"25173","(۲۵۱۷۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ لَمْ یَکُنْ یَرَی بِالأَعْلاَمِ بَأْسًا۔","Sahih","Musannaf Ibn Abi Shaybah 25173","","","كتاب اللباس"
"25174","(۲۵۱۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مُغِیرَۃَ بْنِ زِیَادٍ ، عَنْ أَبِی عُمَرَ مَوْلَی أَسْمَائَ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ اشْتَرَی عِمَامَۃً لَہَا عَلَمٌ ، فَدَعَا بِالجَمَلیْنِ فَقَصَّہُ ، فَذَکَرْتُ ذَلِکَ لَہَا ، فَقَالَتْ : بُؤْسًا لِعَبْدِ اللہِ ، یَا جَارِیَۃُ ، ہَاتِی جُبَّۃَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَجَائَتْ بِجُبَّۃٍ مَکْفُوفَۃِ الْکُمَّیْنِ وَالْجَیْبِ وَالْفَرْجَیْنِ بِالدِّیبَاجِ۔n(مسلم ۱۶۴۱۔ ابوداؤد ۴۰۵۱)","Hasan","Musannaf Ibn Abi Shaybah 25174","","","كتاب اللباس"
"25175","(۲۵۱۷۵) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : کَانَتْ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جُبَّۃٌ طَیَالِسَۃٌ ، عَلَیْہَا لَبِنَۃُ دِیبَاجٍ کِسْرَوَانِیٍّ ، کَانَ یَلْبَسُہَا۔","","Musannaf Ibn Abi Shaybah 25175","","","كتاب اللباس"
"25176","(۲۵۱۷۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَلْبِسُوا الثَّوْبَ سَدَاہُ حَرِیرٌ ، أَوْ لُحْمَتُہُ ، وَلاَ یَرَوْنَ بِالأَعْلاَمِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 25176","","","كتاب اللباس"
"25177","(۲۵۱۷۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ یَلْبَسُ طَیْلَسَانًا مُدَبَّجًا۔","","Musannaf Ibn Abi Shaybah 25177","","","كتاب اللباس"
"25178","(۲۵۱۷۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ دَاوُد ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : کَانَ لأَبِی بَرَّکَانٌ فِیہِ عَلَمُ أَرْبَعُ أَصَابِعَ دِیبَاجٍ۔","","Musannaf Ibn Abi Shaybah 25178","","","كتاب اللباس"
"25179","(۲۵۱۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی صَخْرَۃَ ، قَالَ : رَأَیْتُ عَلَی الأَسْوَدِ بْنِ ہِلاَلٍ طَیْلَسَانًا مُدَبَّجًا طُولاً۔","Sahih","Musannaf Ibn Abi Shaybah 25179","","","كتاب اللباس"
"25180","(۲۵۱۸۰) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ، قَالَ: رَأَیْتُ عَلَی عَبْدِ اللہِ بْنِ یَزِیدَ طَیْلَسَانًا مُدَبَّجًا مُدَحرجًا۔","","Musannaf Ibn Abi Shaybah 25180","","","كتاب اللباس"
"25181","(۲۵۱۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنْ إِسْمَاعِیلَ بْنِ عِمْرَانَ الْعَبْدِیِّ ، قَالَ : رَأَیْتُ عَلَی سَعِیدِ بْنِ الْمُسَیَّبِ طَیْلَسَانًا مُدَبَّجًا۔","","Musannaf Ibn Abi Shaybah 25181","","","كتاب اللباس"
"25182","(۲۵۱۸۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : رَأَیْتُ عَلَی الْقَاسِمِ عِمَامَۃً عَلَمُہَا حَرِیرٌ أَبْیَضُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25182","","","كتاب اللباس"
"25183","(۲۵۱۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : رَأَیْتُ عَلَی أَبِی جَعْفَرٍ رِدَائً سَابِرِیًّا مُعَلَّمًا۔","","Musannaf Ibn Abi Shaybah 25183","","","كتاب اللباس"
"25184","(۲۵۱۸۴) حَدَّثَنَا عَبْدُالرَّحِیمِ، عَنْ سَعِیدٍ مَوْلَی حُذَیْفَۃَ، قَالَ: رَأَیْتُ عَلَی عَبْدِاللہِ بْنِ مِعْقَلٍ طَیْلَسَانًا فِیہِ أَزْرَارُ دِیبَاجٍ۔","","Musannaf Ibn Abi Shaybah 25184","","","كتاب اللباس"
"25185","(۲۵۱۸۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، وَوَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ وَبَرَۃَ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : اجْتَنِبُوا مَا خَالَطَ الْحَرِیرُ مِنَ الثِّیَابِ۔","Sahih","Musannaf Ibn Abi Shaybah 25185","","","كتاب اللباس"
"25186","(۲۵۱۸۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَأَبُو دَاوُد الْحَفْرِی ، عَنْ مِسْعَرٍ ، عَنْ وَبَرَۃَ ، عَنِ الشَّعْبِیِّ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، عَنْ عُمَرَ ، قَالَ : لاَ یَصْلُحُ مِنَ الْحَرِیرِ إِلاَّ مَا کَانَ فِی تَکْفِیفٍ ، أَوْ تَزْرِیرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 25186","","","كتاب اللباس"
"25187","(۲۵۱۸۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ إِسْمَاعِیلَ بْنِ سُمَیْعٍ ، عَنْ مُسْلِمٍ الْبَطِینِ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، قَالَ : جَائَ شَیْخٌ فَسَلَّمَ عَلَی عَلِیٍّ ، وَعَلَیْہِ جُبَّۃٌ مِنْ طَیَالِسَۃٍ فِی مُقَدَّمِہَا دِیبَاجٌ ، فَقَالَ عَلِیٌّ : مَا ہَذَا النَّتِنُ تَحْتَ لِحْیَتِکَ ؟ فَنَظَرَ الشَّیْخُ یَمِینًا وَشِمَالاً ، فَقَالَ : مَا أَرَی شَیْئًا ، قَالَ : یَقُولُ الرَّجُلُ : إِنَّمَا یَعْنِی الدِّیبَاجَ ، قَالَ : یَقُولُ الرَّجُلُ : إِذَنْ نُلْقِیہِ ، وَلاَ نَعُودُ۔","Hasan","Musannaf Ibn Abi Shaybah 25187","","","كتاب اللباس"
"25188","(۲۵۱۸۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنْ حُذَیْفَۃَ ؛ أَنَّہُ رَأَی رَجُلاً عَلَیْہِ طَیْلَسَانٌ عَلَیْہِ أَزْرَارُ دِیبَاجٍ ، فَقَالَ : مُتَقَلِّدٌ قَلاَئِدَ الشَّیْطَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 25188","","","كتاب اللباس"
"25189","(۲۵۱۸۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَرِہَا الْعَلَمَ فِی الثَّوْبِ۔","Sahih","Musannaf Ibn Abi Shaybah 25189","","","كتاب اللباس"
"25190","(۲۵۱۹۰) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا الأَعْمَشُ ، عَنْ مُجَاہِدٍ؛ أَنَّ ابْنَ عُمَرَ اشْتَرَی عِمَامَۃً فَرَأَی فِیہَا عَلَمًا فَقَطَعَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25190","","","كتاب اللباس"
"25191","(۲۵۱۹۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، عَنِ النَّضْرِ بْنِ عَبْدِ اللہِ ؛ أَنَّ قَیْسَ بْنَ عُبَادٍ وَفَدَ إِلَی مُعَاوِیَۃَ فَکَسَاہُ رَیْطَۃً ، فَفَتَّقَ عَلَمَہَا وَارْتَدَی بِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 25191","","","كتاب اللباس"
"25192","(۲۵۱۹۲) حَدَّثَنَا وَکِیعٌ، عَنْ مُوسَی بْنِ عُبَیْدٍ، عَنْ خَالِدِ بْنِ یَسَارٍ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ، قَالَ: کُنَّا نَقْطَعُ الأَعْلاَمَ۔","Da'if","Musannaf Ibn Abi Shaybah 25192","","","كتاب اللباس"
"25193","(۲۵۱۹۳) حَدَّثَنَا حَفْصٌ، عَنْ دَاوُ??َ بْنِ أَبِی ہِنْدٍ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ یَکْسُو بَنَاتَہِ خُمْرَ الْقَزِّ وَنِسَائَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25193","","","كتاب اللباس"
"25194","(۲۵۱۹۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لِسَالِمٍ : الرَّجُلُ یَکْسُو أَہْلَہُ الْقَزَّ ، وَالْخُمُرَ ، وَالثِّیَابَ ، فَقَالَ : قَدْ کُنْتُ لاَ أَکْسُوہُنَّ إِیَّاہُ ، فَمَا زالوا بِی حَتَّی کَسَوْتُہنَّ إِیَّاہُ ، وَإِنْ لَمْ تَکْسُہُ ، فَہُوَ وَاللَّہِ خَیْرٌ۔","","Musannaf Ibn Abi Shaybah 25194","","","كتاب اللباس"
"25195","(۲۵۱۹۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَانَا یَکْرَہَانِ الْقَزَّ وَالإِبْرَیْسَمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 25195","","","كتاب اللباس"
"25196","(۲۵۱۹۶) حَدَّثَنَا مِسْعَرٌ ، عَنْ عَطِیَّۃَ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ أَخَذَ مُلاَئَۃً سَابِرِیَّۃً ، أَوْ رَقِیقَۃً ، فَجَمَعَہَا بِیَدِہِ ، ثُمَّ رَمَی بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 25196","","","كتاب اللباس"
"25197","(۲۵۱۹۷) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ؛ أَنَّہُ کَانَ یَکْرَہُ لُبْسَ الثَّوْبِ السَّابِرِیِّ الرَّقِیقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25197","","","كتاب اللباس"
"25198","(۲۵۱۹۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْد ، قَالَ : رَأَیْتُ عَلَی الْقَاسِمِ رِدَائً شَطوِیًّا لَہُ عَلَمٌ۔","","Musannaf Ibn Abi Shaybah 25198","","","كتاب اللباس"
"25199","(۲۵۱۹۹) حَدَّثَنَا أَبُو بَکر ، قَالَ : قَالَ ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أُنیَسٍ أَبِی الْعُرْیَانِ ، قَالَ : رَأَیْتُ عَلَی الْحَسَنِ بْنِ مُحَمَّدِ بْنِ عَلِیٍّ قَمِیصًا رَقِیقًا ، وَعِمَامَۃً رَقِیقَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 25199","","","كتاب اللباس"
"25200","(۲۵۲۰۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ أَبِی حَیَّانَ ، عَنْ حَبِیبٍ ، قَالَ : رَأَیْتُ عَلَی ابْنِ عَبَّاس قَمِیصًا سَابِرِیًّا رَقِیقًا ، اسْتُشِفَّ إِزَارُہُ مِنْ رِقَّتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 25200","","","كتاب اللباس"
"25201","(۲۵۲۰۱) حَدَّثَنَا الْفَضْلُ ، قَالَ : حدَّثَنَا أَبُو إِسْرَائِیلَ ، قَالَ : کَانَ الْحَکَمُ یَعْتَمُّ بِعِمَامَۃِ سَابِرِیٍّ۔","","Musannaf Ibn Abi Shaybah 25201","","","كتاب اللباس"
"25202","(۲۵۲۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ عبد المَلِکَ ، قَالَ : رَأَیْتُ عَلَی أَبِی جَعفَرٍ رِدَائً سَابِرِیًّا مُعَلَمًا۔","","Musannaf Ibn Abi Shaybah 25202","","","كتاب اللباس"
"25203","(۲۵۲۰۳) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، عَنْ شَیْبَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَکْرَہُ الثِّیَابَ الرِّقَاقَ۔","No Data Available","Musannaf Ibn Abi Shaybah 25203","","","كتاب اللباس"
"25204","(۲۵۲۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، قَالَ : رَأَیْتُ عَلَی الْقَاسِمِ رِدَائً رَقِیقًا۔","No Data Available","Musannaf Ibn Abi Shaybah 25204","","","كتاب اللباس"
"25205","(۲۵۲۰۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَطَائٍ ، قَالَ : الْحَرِیرُ أَحَبُّ إلَیَّ مِنَ السَّابِرِیِّ۔","","Musannaf Ibn Abi Shaybah 25205","","","كتاب اللباس"
"25206","(۲۵۲۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الرَّحْمَنِ الْخَیَّاطِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ لَہُ رِدَائٌ رَقِیقٌ۔","Da'if","Musannaf Ibn Abi Shaybah 25206","","","كتاب اللباس"
"25207","(۲۵۲۰۷) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ ، قَالَ : مَا رَأَیْتُ أَجْمَلَ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُرَجِّلاً فِی حُلَّۃٍ حَمْرَائَ۔ (بخاری ۳۵۵۱۔ مسلم ۹۲)","Hasan","Musannaf Ibn Abi Shaybah 25207","","","كتاب اللباس"
"25208","(۲۵۲۰۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، قَالَ : حدَّثَنِی أَبِی ، قَالَ : رَأَیْتُ نَافِعَ بْنَ جُبَیْرٍ بِالْعَرْجِ، وَعَلَیْہِ مُعَصْفَرٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 25208","","","كتاب اللباس"
"25209","(۲۵۲۰۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، قَالَ : رَأَیْتُ عَلَی إبْرَاہِیمَ التَّیْمِیِّ ، وَإِبْرَاہِیمَ النَّخَعِیِّ عَلَی کُلِّ وَاحِدٍ مِنْہُمَا مِلْحَفَۃً حَمْرَائَ۔","No Data Available","Musannaf Ibn Abi Shaybah 25209","","","كتاب اللباس"
"25210","(۲۵۲۱۰) حَدَّثَنَا عُبَیْدُاللہِ بْنُ مُوسَی، عَنْ عَمْرِو بْنِ عُثْمَانَ، عَنْ مُوسَی بْنِ طَلْحَۃَ؛ أَنَّ طَلْحَۃَ کَانَ یَلْبَسُ الْمُعَصْفَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 25210","","","كتاب اللباس"
"25211","(۲۵۲۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ عَمْرِو بْنِ عُثْمَانَ ، قَالَ : رَأَیْتُ عَلَی أَبِی جَعْفَرٍ مِلْحَفَۃً حَمْرَائَ۔","No Data Available","Musannaf Ibn Abi Shaybah 25211","","","كتاب اللباس"
"25212","(۲۵۲۱۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعَلاَئِ بْنِ عَبْدِ الْکَرِیمِ ، قَالَ : رَأَیْتُ عَلَی إِبْرَاہِیمَ ثَوْبًا مُعَصْفَرًا۔","No Data Available","Musannaf Ibn Abi Shaybah 25212","","","كتاب اللباس"
"25213","(۲۵۲۱۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ : کَانَ لاَ یَرَی بَأْسًا بِلُبْسِ الرَّجُلِ الثَّوْبَ الْمَصْبُوغَ بِالْعُصْفُرِ أَوِ الزَّعْفَرَانِ۔","","Musannaf Ibn Abi Shaybah 25213","","","كتاب اللباس"
"25214","(۲۵۲۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، قَالَ : رَأَیْتُ عَلَی الشَّعْبِیِّ مِلْحَفَۃً حَمْرَائَ۔","No Data Available","Musannaf Ibn Abi Shaybah 25214","","","كتاب اللباس"
"25215","(۲۵۲۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ عَاصِمِ بْنِ بَہْدَلَۃَ ، قَالَ : أَدْرَکْتُ أَقْوَامًا کَانُوا یَتَّخِذُونَ ہَذَا اللَّیْلَ جَمَلاً یَلْبَسُونَ الْمُعَصْفَرَ ، مِنْہُمْ ؛ زِرٌّ ، وَأَبُو وَائِلٍ۔","","Musannaf Ibn Abi Shaybah 25215","","","كتاب اللباس"
"25216","(۲۵۲۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ نَصْرِ بْنِ أَوْسٍ ، قَالَ : رَأَیْتُ عَلَی عَلِیِّ بْنِ الْحُسَیْنِ مِلْحَفَۃً حَمْرَائَ۔","","Musannaf Ibn Abi Shaybah 25216","","","كتاب اللباس"
"25217","(۲۵۲۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنٍ ، عَنْ جَابِر ، عَنْ أَبِی جَعْفَرٍ قَالَ : إِنَّا آلُ مُحَمَّدٍ نَلْبَسُ الْمُعَصْفَرَ۔","","Musannaf Ibn Abi Shaybah 25217","","","كتاب اللباس"
"25218","(۲۵۲۱۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ الْمُعَصْفَرُ لِبَاسَ الْعَرَبِ ، وَلاَ أَعْلَمُ شَیْئًا ہَدَمَہُ فِی الإِسْلاَمِ ، وَکَانَ لاَ یَرَی بِہِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 25218","","","كتاب اللباس"
"25219","(۲۵۲۱۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یُصْبَغُ لَہُ الثَّوْبُ بِدِینَارٍ فَیَلْبَسُہُ۔","","Musannaf Ibn Abi Shaybah 25219","","","كتاب اللباس"
"25220","(۲۵۲۲۰) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ الرَّازِیُّ ، عَنْ سَلَمَۃَ بْنِ بُخْتٍ ، قَالَ : رَأَیْتُ عَلَی أَبِی جَعْفَرٍ الْمُعَصْفَرَاتِ ، أَوِ الْمُعَصْفَرَ ، وَرَأَیْتُ عَلَیْہِ رَدْعًا مِنَ الْخَلُوقِ۔","","Musannaf Ibn Abi Shaybah 25220","","","كتاب اللباس"
"25221","(۲۵۲۲۱) حَدَّثَنَا مُعَاوِیَۃَ بْنُ ہِشَامٍ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ أَبِیہِ، قَالَ: رَأَیْتُ عَلَی إبْرَاہِیمَ مِلْحَفَۃً حَمْرَائَ مُشَبَّعَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 25221","","","كتاب اللباس"
"25222","(۲۵۲۲۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنِی حُسَیْنُ بْنُ وَاقِدٍ ، قَالَ : حَدَّثَنِی عَبْدُ اللہِ بْنُ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْطُبُنَا ، فَأَقْبَلَ الْحَسَنُ وَالْحُسَیْنُ عَلَیْہِمَا قَمِیصَانِ أَحْمَرَانِ۔n(ابوداؤد ۱۱۰۲۔ ترمذی ۳۷۷۴)","Hasan","Musannaf Ibn Abi Shaybah 25222","","","كتاب اللباس"
"25223","(۲۵۲۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنْ جُبَیْر بن نُفَیْر الْحَضْرَمِیِّ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : رَآنِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَعَلَیَّ ثَوْبٌ مُعَصْفَرٌ فَقَالَ : أَلْقِہَا ، فَإِنَّہَا ثِیَابُ الْکُفَّارِ۔ (مسلم ۲۷۔ احمد ۲/۲۰۷)","Sahih","Musannaf Ibn Abi Shaybah 25223","","","كتاب اللباس"
"25224","(۲۵۲۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ عَبْدِ اللہِ بْنِ حُنَیْنٍ ، قَالَ : سَمِعْتُ عَلِیًّا یَقُولُ : نَہَانِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلاَ أَقُولُ نَہَاکُمْ ، عَنْ لُبْسِ الْمُعَصْفَرِ۔ (مسلم ۱۶۴۹۔ ابوداؤد ۴۰۴۱)","Hasan","Musannaf Ibn Abi Shaybah 25224","","","كتاب اللباس"
"25225","(۲۵۲۲۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، عَن ابنِ حُنَیْنٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ تَلْبَسُوا ثَوْبًا أَحْمَرَ متَورِّدًا۔","","Musannaf Ibn Abi Shaybah 25225","","","كتاب اللباس"
"25226","(۲۵۲۲۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدٌ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : أَقْبَلْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ ثَنِیَّۃِ أَذَاخِرَ ، فَالْتَفَتَ إِلَیَّ وَعَلَیَّ رَیْطَۃٌ مُضَرَّجَۃٌ بِالْعُصْفُرِ ، فَقَالَ : مَا ہَذِہِ ؟ فَعَرَفْتُ مَا کَرِہَ ، فَأَتَیْتُ أَہْلِی وَہُمْ یَسْجُرُونَ تَنُّورَہُمْ ، فَقَذَفْتُہَا فِیہِ ، ثُمَّ أَتَیْتُہُ مِنَ الْغَدِ فَقَالَ : یَا عَبْدَ اللہِ ، مَا فَعَلَتِ الرَّیْطَۃُ ؟ فَأَخْبَرْتُہُ فَقَالَ : أَلاَ کَسَوْتَہَا بَعْضَ أَہْلِکَ ، فَإِنَّہُ لاَ بَأْسَ بِذَلِکَ لِلنِّسَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 25226","","","كتاب اللباس"
"25227","(۲۵۲۲۷) حَدَّثَنَا عَلِیٌّ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنِ الْحَسَنِ بْنِ سُہَیْلٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْقَسِّیَّۃِ وَالْمُفَدَّمِ ، قَالَ یَزِیدُ : قُلْتُ لِلْحَسَنِ : مَا الْمُفَدَّمُ ؟ قَالَ : الْمُشَبَّعُ بِالْعُصْفُرِ۔ (بزار ۴۷۶)","Da'if","Musannaf Ibn Abi Shaybah 25227","","","كتاب اللباس"
"25228","(۲۵۲۲۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ تَمِیمٍ الْخُزَاعِیِّ ، قَالَ : حدَّثَتْنَا عَجُوزٌ لَنَا ، قَالَتْ : کُنْتُ أَرَی عُمَرَ إِذَا رَأَی عَلَی رَجُلٍ ثَوْبًا مُعَصْفَرًا ضَرَبَہُ ، وَقَالَ : ذَرُوا ہَذِہِ الْبَرَّاقَاتِ لِلنِّسَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 25228","","","كتاب اللباس"
"25229","(۲۵۲۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ فُضَیْلٍ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنِ عُمَرَ رَأَی عَلَی ابْنٍ لَہُ مُعَصْفَرًا ، فَنَہَاہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25229","","","كتاب اللباس"
"25230","(۲۵۲۳۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ ؛ أَنَّہُمْ کَانُوا یَکْرَہُونَ التَّضْرِیجَ فَمَا فَوْقَہُ لِلرِّجَالِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25230","","","كتاب اللباس"
"25231","(۲۵۲۳۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّہُ کَانَ یَکْرَہُ الْمُعَصْفَرَ لِلرِّجَالِ۔","","Musannaf Ibn Abi Shaybah 25231","","","كتاب اللباس"
"25232","(۲۵۲۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ مَوْہَبٍ ، قَالَ : حدَّثَنِی عَمِّی ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنْ عُثْمَانَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمُعَصْفَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 25232","","","كتاب اللباس"
"25233","(۲۵۲۳۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَدْخُلُ مَعَ عَلْقَمَۃَ وَالأَسْوَدِ عَلَی أَزْوَاجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَیَرَاہُنَّ فِی اللُّحُفِ الْحُمْرِ ، قَالَ : وَکَانَ إِبْرَاہِیمُ لاَ یَرَی بِالْمُعَصْفَرِ بَأْسًا۔","Sahih","Musannaf Ibn Abi Shaybah 25233","","","كتاب اللباس"
"25234","(۲۵۲۳۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ لَیْثٍ، عَنْ عَطَائٍ، وَطَاوُوسٍ، وَمُجَاہِدٍ؛ أَنَّہُمْ کَانُوا لاَ یَرَوْنَ بَأْسًا بِالْحُمْرَۃِ لِلنِّسَائِ۔","","Musannaf Ibn Abi Shaybah 25234","","","كتاب اللباس"
"25235","(۲۵۲۳۵) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : رَأَیْتُ عَلَی أُمِّ سَلَمَۃَ دِرْعًا وَمِلْحَفَۃً مُشْبَعَتَیْنِ بِالْعُصْفُرِ۔","Sahih","Musannaf Ibn Abi Shaybah 25235","","","كتاب اللباس"
"25236","(۲۵۲۳۶) حَدَّثَنَا عَبْدُاللہِ بْنُ نُمَیْرٍ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنِ الْقَاسِمِ؛ أَنَّ عَائِشَۃَ کَانَتْ تَلْبَسُ الثِّیَابَ الْمُعَصْفَرَۃَ، وَہِیَ مُحْرِمَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 25236","","","كتاب اللباس"
"25237","(۲۵۲۳۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ؛ أَنَّ عَائِشَۃَ کَانَتْ تَلْبَسُ الثِّیَابَ الْمُوَرَّدَۃَ بِالْعُصْفُرِ ، وَہِیَ مُحْرِمَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 25237","","","كتاب اللباس"
"25238","(۲۵۲۳۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ تَمِیمٍ الْخُزَاعِیِّ ، قَالَ : حدَّثَتْنَا عَجُوزٌ ، قَالَتْ : قَالَ عُمَرُ : ذَرُوا ہَذِہِ الْبَرَّاقَاتِ لِلنِّسَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 25238","","","كتاب اللباس"
"25239","(۲۵۲۳۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ ہِشَامٍ ، عَنْ فَاطِمَۃَ بِنْتِ الْمُنْذِرِ ؛ أَنَّ أَسْمَائَ کَانَتْ تَلْبَسُ الْمُعَصْفَرَ وَہِیَ مُحْرِمَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 25239","","","كتاب اللباس"
"25240","(۲۵۲۴۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ رَأَی بَعْضَ أَزْوَاجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَطُوفُ بِالْبَیْتِ ، وَعَلَیْہَا ثِیَابٌ مُعَصْفَرَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 25240","","","كتاب اللباس"
"25241","(۲۵۲۴۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالْمُعَصْفَرِ لِلنِّسَائِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25241","","","كتاب اللباس"
"25242","(۲۵۲۴۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا إِسْمَاعِیلُ ، عَنْ أُخْتِہِ سُکَیْنَۃَ ، قَالَتْ : دَخَلْتُ مَعَ أُمِّی عَلَی عَائِشَۃَ ، فَرَأَیْتُ عَلَیْہَا دِرْعًا أَحْمَرَ وَخِمَارًا أَسْوَدَ۔","Da'if","Musannaf Ibn Abi Shaybah 25242","","","كتاب اللباس"
"25243","(۲۵۲۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ ، عَنْ سَعِیدٍ ، عَنْ یَحْیَی بْنِ عَبْدِ اللہِ بْنِ مَالِکٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَصْبُغُ ثِیَابَہُ بِالزَّعْفَرَانِ ، حَتَّی الْعِمَامَۃَ۔ (ابوداؤد ۴۰۶۱۔ احمد ۲/۱۲۶)","","Musannaf Ibn Abi Shaybah 25243","","","كتاب اللباس"
"25244","(۲۵۲۴۴) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ عُمَرَ بْنِ جَاوَانٍ ، عَنِ الأَحْنَفِ بْنِ قَیْسٍ ، قَالَ : جَائَ عُثْمَانُ وَعَلَیْہِ مَلِیَّۃٌ لَہُ صَفْرَائُ ، قَدْ قَنَّعَ بِہَا رَأْسَہُ۔ (حاکم ۳۶۱)","Da'if","Musannaf Ibn Abi Shaybah 25244","","","كتاب اللباس"
"25245","(۲۵۲۴۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ التَّیْمِیِّ ، عَنْ عَمْرِو بْنِ مَیْمُونَ ؛ أَنَّ عُمَرَ کَانَ عَلَیْہِ یَوْمَ أُصِیبَ ثَوْبٌ أَصْفَرُ۔","","Musannaf Ibn Abi Shaybah 25245","","","كتاب اللباس"
"25246","(۲۵۲۴۶) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، قَالَ : رَأَیْتُ عَلَی عَلِیٍّ قَمِیصًا وَإِزَارًا أَصْفَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 25246","","","كتاب اللباس"
"25247","(۲۵۲۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ رَجُلٍ مِنْ وَلَدِ الزُّبَیْ??ِ ، یُقَالَ لَہُ : عَبَّادُ بْنُ حَمْزَۃَ ؛ أَنَّ الزُّبَیْرَ بْنَ الْعَوَّامِ کَانَتْ عَلَیْہِ عِمَامَۃٌ صَفْرَائُ مُعْتَجِرًا بِہَا ، فَنَزَلَتِ الْمَلاَئِکَۃُ وَعَلَیْہِمْ عَمَائِمُ صُفْرٌ۔","","Musannaf Ibn Abi Shaybah 25247","","","كتاب اللباس"
"25248","(۲۵۲۴۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : رَأَیْتُ عَلَی ابْنِ الْحَنَفِیَّۃِ مِطْرَفًا أَصْفَرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 25248","","","كتاب اللباس"
"25249","(۲۵۲۴۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : رَأَیْتُ عَلَی مُصْعَبِ بْنِ سَعْدٍ إِزَارًا أَصْفَرَ، وَہُوَ یَجْلِسُ مَعَ الْمَسَاکِینِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25249","","","كتاب اللباس"
"25250","(۲۵۲۵۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، قَالَ : رَأَیْتُ عَلَی عَلِیٍّ إِزَارًا أَصْفَرَ ، وَخَمِیصَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 25250","","","كتاب اللباس"
"25251","(۲۵۲۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ عَمْرِو بْنِ مَرْزُوقٍ ، قَالَ : رَأَیْتُ عَلَی إِبْرَاہِیمَ إِزَارًا أَصْفَرَ۔","","Musannaf Ibn Abi Shaybah 25251","","","كتاب اللباس"
"25252","(۲۵۲۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حَنَشِ بْنِ الْحَارِثِ ، قَالَ : رَأَیْتُ عَلَی إِبْرَاہِیمَ رِدَائً أَصْفَرَ ، وَثَوْبًا أَصْفَرَ۔","","Musannaf Ibn Abi Shaybah 25252","","","كتاب اللباس"
"25253","(۲۵۲۵۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ أُکَیْلٍ ، قَالَ : مَا رَأَیْتُ إِبْرَاہِیمَ فِی صَیْفٍ قَطُّ ، إِلاَّ وَعَلَیْہِ مِلْحَفَۃٌ صَفْرَائُ ، وَإِزَارٌ أَصْفَرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25253","","","كتاب اللباس"
"25254","(۲۵۲۵۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، حَدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، قَالَ : رَأَیْتُ حَمَّادًا یُصَلِّی وَعَلَیْہِ إِزَارٌ أَصْفَرُ۔","","Musannaf Ibn Abi Shaybah 25254","","","كتاب اللباس"
"25255","(۲۵۲۵۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، قَالَ : رَأَیْتُ عَلَی عَبْدِ اللہِ بْنِ الْحَسَنِ مِلْحَفَۃً صَفْرَائَ ، یَحْتَبِی بِہَا فِی الْمَسْجِدِ الْحَرَامِ۔","","Musannaf Ibn Abi Shaybah 25255","","","كتاب اللباس"
"25256","(۲۵۲۵۶) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ مُحَمَّدِ بْنِ شُرَحْبِیلَ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، قَالَ : أَتَانَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَوَضَعْنَا لَہُ مَائً یَتَبَرَّدُ بِہِ ، فَاغْتَسَلَ ، ثُمَّ أَتَیْتُہُ بِمِلْحَفَۃٍ صَفْرَائَ ، فَرَأَیْتُ أَثَرَ الْوَرْسِ عَلَی عُکَنِہِ۔ (ابوداؤد ۵۱۴۳۔ احمد ۳/۴۲۱)","Da'if","Musannaf Ibn Abi Shaybah 25256","","","كتاب اللباس"
"25257","(۲۵۲۵۷) حَدَّثَنَا ہُشَیم ، عَنْ یَسَارٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سُئِلَ عَنِ الْفِرَائِ ؟ فَقَالَ : أَحَبَّہَا إِلَیَّ أَلْیَنُہَا۔","","Musannaf Ibn Abi Shaybah 25257","","","كتاب اللباس"
"25258","(۲۵۲۵۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : رَأَیْتُ عَلَی إِبْرَاہِیمَ مُسْتُقَۃَ فِرَائٍ۔","","Musannaf Ibn Abi Shaybah 25258","","","كتاب اللباس"
"25259","(۲۵۲۵۹) حَدَّثَنَا وَکِیعٌ ، عَنِ أَبِی کِبْرَان ، قَالَ : رَأَیْتُ عَلَی الضَّحَّاک مُسْتُقَۃَ فِرَائٍ۔","","Musannaf Ibn Abi Shaybah 25259","","","كتاب اللباس"
"25260","(۲۵۲۶۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَبْصَرَ ابْنُ عُمَرَ عَلَی رَجُلٍ فَرْوًا فَأَعْجَبَہُ لِینُہُ ، فَقَالَ : لَوْ أَعْلَمُ ہَذَا ذُکِّیَ لَسَرَّنِی أَنْ یَکُونَ لِی مِنْہُ ثَوْبٌ۔","Sahih","Musannaf Ibn Abi Shaybah 25260","","","كتاب اللباس"
"25261","(۲۵۲۶۱) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ ثَابِتٍ ، قَالَ : کُنْتُ جَالِسًا مَعَ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی، فَأَتَاہُ رَجُلٌ ذُو ضَفْرَیْنِ ضَخْمٌ ، فَقَالَ لَہُ : یَا أَبَا عِیسَی ، قَالَ لَہُ : نَعَمْ ، قَالَ لَہُ : حَدِّثْنِی مَا سَمِعْتَ فِی الْفِرَائِ ، فَقَالَ : سَمِعْتُ أَبِی یَقُولُ : کُنْتُ جَالِسًا عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَتَاہُ رَجُلٌ فَقَالَ : یَا رَسُولَ اللہِ ، أُصَلِّی فِی الْفِرَائِ ؟ قَالَ : فَأَیْنَ الدِّبَاغُ ؟۔ (احمد ۴/۳۴۸)","Da'if","Musannaf Ibn Abi Shaybah 25261","","","كتاب اللباس"
"25262","(۲۵۲۶۲) حَدَّثَنَا الثَّقَفِیُّ، عَنْ أَیُّوبَ، عَنْ مُحَمَّدٍ، وَنَافِعٍ؛ أَنَّ عَائِشَۃَ أَمَرَتْ إِنْسَانًا مِنْ أَہْلِہَا إِذَا صَلَّی أَنْ یَضَعَ فَرْوَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25262","","","كتاب اللباس"
"25263","(۲۵۲۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنِ ابْنِ جَبْرٍ ، قَالَ : رَأَیْتُ عَلَی سَعِیدِ بْنِ جُبَیْرٍ مُسْتَقَۃَ فِرَائٍ فَقَالَ : مَا لَبِسْتُہَا إلاَّ لِتُرَی عَلَیَّ ، أَوْ لأُسْأَلَ عَنْہَا۔","","Musannaf Ibn Abi Shaybah 25263","","","كتاب اللباس"
"25264","(۲۵۲۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ قَالَ فِی الْفِرَائِ مِنْ جُلُودِ الْمَیْتَۃِ : لَوَدِدْتُ أَنَّ عِنْدِی مِنْہَا فَرْوًا فَأَلْبَسُہُ۔","","Musannaf Ibn Abi Shaybah 25264","","","كتاب اللباس"
"25265","(۲۵۲۶۵) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، عَنْ سَلاَّمِ بْنِ أَبِی مُطِیعٍ ، قَالَ : حدَّثَنِی أَبُو حَصِین ، عَنِ الشَّعْبِیِّ ، قَالَ : خَرَجْتُ مَعَ أَبِی وَائِلٍ حَتَّی أَتَیْنَا الْفَرَّائِینَ ، فَاشْتَرَی فَرْوًا فَقَالَ صَاحِبُ الْفَرْوِ : أَمَا إنِّی أَزِیدُک یَا أَبَا وَائِلٍ ، إِنَّہُ ذُکِّیَ ، فَقَالَ: مَا یَسُرُّنِی أَنِّی اشْتَرَیْتُ الَّذِی قُلْتُ بِقِیرَاطٍ ۔ قَالَ أَبُو حَصِین : وَکَانَ إِبْرَاہِیمُ یَقُولُ ذَلِکَ، وَکَانَ سَعِیدُ بْنُ جُبَیْرٍ یَقُولُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 25265","","","كتاب اللباس"
"25266","(۲۵۲۶۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَبْدِ الرَّحْمَنِ بْنِ وَعْلَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : أَیُّمَا إِہَابٍ دُبِغَ ، فَقَدْ طَہُرَ۔ (مسلم ۲۷۸۔ ابوداؤد ۴۱۲۰)","Sahih","Musannaf Ibn Abi Shaybah 25266","","","كتاب اللباس"
"25267","(۲۵۲۶۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ سَلْمَانَ ، قَالَ : کَانَ لِبَعْضِ أُمَّہَاتِ الْمُؤْمِنِینَ شَاۃٌ ، فَمَاتَتْ فَمَرَّ عَلَیْہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : مَا ضَرَّ أَہْلَہَا لَوِ انْتَفَعُوا بِإِہَابِہَا۔ (ابن ماجہ ۳۶۱۱)","Da'if","Musannaf Ibn Abi Shaybah 25267","","","كتاب اللباس"
"25268","(۲۵۲۶۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ مَیْمُونَۃَ ؛ أَنَّ شَاۃً لِمَوْلاَۃِ مَیْمُونَۃَ مُرَّ بِہَا قَدْ أُعْطِیَتْہَا مِنَ الصَّدَقَۃِ مَیْتَۃً ، فَقَالَ : ہَلاَّ أَخَذُوا إِہَابَہَا فَدَبَغُوہُ ، فَانْتَفَعُوا بِہِ ؟ قَالُوا : یَا رَسُولَ اللہِ : إِنَّہَا مَیْتَۃٌ ؟ قَالَ : إِنَّمَا حُرِّمَ أَکْلُہَا۔ (مسلم ۲۷۶۔ ابوداؤد ۴۱۱۷)","Sahih","Musannaf Ibn Abi Shaybah 25268","","","كتاب اللباس"
"25269","(۲۵۲۶۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا إِسْمَاعِیلُ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَخْبَرَنَا عِکْرِمَۃُ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ شَاۃً لِسَوْدَۃَ بِنْتِ زَمْعَۃَ مَاتَتْ ، قَالَتْ : فَدَبَغْنَا جِلْدَہَا ، فَکُنَّا نَنْبِذُ فِیہِ حَتَّی صَارَ شَنًّا۔ (بخاری ۶۶۸۶)","Sahih","Musannaf Ibn Abi Shaybah 25269","","","كتاب اللباس"
"25270","(۲۵۲۷۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَنْبَأَنا أَبُو بِشْرٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ بِشَاۃٍ لِسَوْدَۃَ بِنْتِ زَمْعَۃَ ، فَقَالَ : أَلاَ انْتَفَعُوا بِإِہَابِہَا ، فَإِنَّ دَبْغَہَا طَہُورُہَا۔","","Musannaf Ibn Abi Shaybah 25270","","","كتاب اللباس"
"25271","(۲۵۲۷۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مُحَمَّدِ بْنِ إِسْمَاعِیلَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : دِبَاغُہَا طَہُورُہَا۔","","Musannaf Ibn Abi Shaybah 25271","","","كتاب اللباس"
"25272","(۲۵۲۷۲) حَدَّثَنَا خَالِدٌ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ یَزِیدَ بْنِ قُسَیْطٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أُمِّہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : أَمَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُسْتَمْتَعَ بِجُلُودِ الْمَیْتَۃِ۔n(ابوداؤد ۴۱۲۱۔ ابن ماجہ ۳۶۱۲)","Da'if","Musannaf Ibn Abi Shaybah 25272","","","كتاب اللباس"
"25273","(۲۵۲۷۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ بِشَاۃٍ لِمَوْلاَۃٍ لِمَیْمُونَۃَ مَیْتَۃٍ ، فَقَالَ : ہَلاَّ انْتَفَعُوا بِإِہَابِہَا۔ (مسلم ۱۰۴۔ احمد ۱/۲۷۷)","Sahih","Musannaf Ibn Abi Shaybah 25273","","","كتاب اللباس"
"25274","(۲۵۲۷۴) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا ابْنُ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ مَیْمُونَۃَ ، قَالَتْ : مَاتَتْ شَاۃٌ لإِحْدَی نِسَائِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلاَّ انْتَفَعْتُمْ بِإِہَابِہَا۔n(مسلم ۱۰۳۔ احمد ۱/۲۷۷)","Sahih","Musannaf Ibn Abi Shaybah 25274","","","كتاب اللباس"
"25275","(۲۵۲۷۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا إِسْمَاعِیلُ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، قَالَ : حدِّثْتُ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ بِشَاۃٍ مَیْتَۃٍ ، فَقَالَ : مَا ضَرَّ أَہْلَہَا لَوِ انْتَفَعُوا بِإِہَابِہَا۔","","Musannaf Ibn Abi Shaybah 25275","","","كتاب اللباس"
"25276","(۲۵۲۷۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ صَدَقَۃَ ، عَنْ جَدِّہِ ریَاحِ بْنِ الْحَارِثِ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ ذَکَاتُہُ دِبَاغُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25276","","","كتاب اللباس"
"25277","(۲۵۲۷۷) حَدَّثَنَا أَبُو خَالِدٍ ، وَلَیْسَ بِالأَحْمَرِ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ جَوْنِ بْنِ قَتَادَۃَ ، عَنْ سَلَمَۃَ بْنِ مُحَبِّقٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ذَکَاۃُ الْجُلُودِ دِبَاغُہَا۔n(احمد ۳/۴۷۶۔ دارقطنی ۱۲)","Da'if","Musannaf Ibn Abi Shaybah 25277","","","كتاب اللباس"
"25278","(۲۵۲۷۸) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : حدَّثَنَا ہَمَّامٌ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ جَوْنِ بْنِ قَتَادَۃَ ، عَنْ سَلَمَۃَ بْنِ مُحَبِّقٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بِمِثْلِہِ۔ (ابوداؤد ۴۱۲۲۔ احمد ۵/۶)","Da'if","Musannaf Ibn Abi Shaybah 25278","","","كتاب اللباس"
"25279","(۲۵۲۷۹) حَدَّثَنَا ہُشَیْمٌ ، عَنِ مَنْصُور ، عَنِ الْحَسَنِ ، عَنْ جَوْنِ بْنِ قَتَادَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بِمِثْلِہِ ، وَلَم یَذکُرْ مَنْصُورٌ سَلَمَۃَ بْنَ مُحَبِّقٍ۔","Da'if","Musannaf Ibn Abi Shaybah 25279","","","كتاب اللباس"
"25280","(۲۵۲۸۰) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْمُغِیرَۃِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : دِبَاغُ الْمَیْتَۃِ طَہُورُہَا۔","","Musannaf Ibn Abi Shaybah 25280","","","كتاب اللباس"
"25281","(۲۵۲۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنِ ابْنِ مَسْعُودٍ ، أَنَّہُ سُئِلَ عَنِ الْحَرِیرِ وَالذَّہَبِ لِلنِّسَائِ ؟ فَقَالَ : إِنَّمَا ہُنَّ لُعَبُکُمْ ، فَزَیِّنُوہُنَّ بِمَا شِئْتُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 25281","","","كتاب اللباس"
"25282","(۲۵۲۸۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أُرَخِّصُ لِلنِّسَائِ فِی الْحَرِیرِ وَالذَّہَبِ ، ثُمَّ قَرَأَ : (أَوَمَنْ یُنَشَّأُ فِی الْحِلْیَۃِ وَہُوَ فِی الْخِصَامِ غَیْرُ مُبِینٍ)۔","","Musannaf Ibn Abi Shaybah 25282","","","كتاب اللباس"
"25283","(۲۵۲۸۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنِ أَبِی عَوْنٍ ، عَنْ أَبِی صَالِحٍ الْحَنَفِیِّ ، عَنْ عَلِیٍّ ؛ أَنَّ أُکَیْدِرَ دُوْمَۃَ أَہْدَی إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَوْبَ حَرِیرٍ ، فَأَعْطَاہُ عَلِیًّا فَقَالَ : شَقَّقْہُ خُمُرًا بَیْنَ النِّسْوَۃِ۔n(مسلم ۱۸۔ ابوداؤد ۴۰۴۰)","Sahih","Musannaf Ibn Abi Shaybah 25283","","","كتاب اللباس"
"25284","(۲۵۲۸۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنْ سَعِیدِ بْنِ أَبِی ہِنْدٍ ، عَنْ أَبِی مُوسَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْحَرِیرِ وَالذَّہَبِ : حَرَامٌ عَلَی ذُکُورِ أُمَّتِی ، حِلٌّ لإِنَاثِہِمْ۔","","Musannaf Ibn Abi Shaybah 25284","","","كتاب اللباس"
"25285","(۲۵۲۸۵) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ مَعْمَرٍ أَخْبَرَہُ ، عَنِ الزُّہْرِیِّ ، عَنْ أَنَسٍ ، قَالَ : رَأَیْتُ عَلَی زَیْنَبَ بِنْتِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَمِیصَ حَرِیرٍ سِیَرَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 25285","","","كتاب اللباس"
"25286","(۲۵۲۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مَعْقِلُ بْنُ عُبَیْدِ اللہِ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، قَالَ : لاَ بَأْسَ بِالْحَرِیرِ وَالدِّیبَاجِ لِلنِّسَائِ ، إِنَّمَا یُکْرَہُ لَہُنَّ مَا یَصِفُ ، أَوْ یَشِفُّ۔","No Data Available","Musannaf Ibn Abi Shaybah 25286","","","كتاب اللباس"
"25287","(۲۵۲۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : إِنِّی لأَکْسُوَ بَنَاتِی الْحَرِیرَ ، وَأُحَلِّیَہُنَّ الذَّہَبَ۔","","Musannaf Ibn Abi Shaybah 25287","","","كتاب اللباس"
"25288","(۲۵۲۸۸) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَیُّوبَ ، عَنْ أَبِی یَزِیدَ الْمُزَنِیِّ ، قَالَ : کَانَ عُمَرُ یَنْہَی النِّسَائَ عَنْ لُبْسِ الْقَبَاطِیِّ ، فَقَالُوا : إِنَّہُ لاَ یَشِفُّ ، فَقَالَ : إِلاَّ یَشِفَّ فَإِنَّہُ یَصِفُ۔","","Musannaf Ibn Abi Shaybah 25288","","","كتاب اللباس"
"25289","(۲۵۲۸۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، قَالَ عُمَرُ : لاَ تُلْبِسُوا نِسَائَکُمُ الْقَبَاطِیَّ ، فَإِنَّہُ إِلاَّ یَشِفَّ یَصِفُ۔","","Musannaf Ibn Abi Shaybah 25289","","","كتاب اللباس"
"25290","(۲۵۲۹۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَکْرَہُ لِلنِّسَائِ لُبْسَ الْقَبَاطِیِّ ، وَقَالَ: إِنَّہُ إِلاَّ یَشِفَّ یَصِفُ۔","Da'if","Musannaf Ibn Abi Shaybah 25290","","","كتاب اللباس"
"25291","(۲۵۲۹۱) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ نَافِعٍ ، قَالَ : کَسَا ابْنُ عُمَرَ مَوْلًی لَہُ یَوْمًا مِنْ قَبَاطِیِّ مِصْرَ ، فَانْطَلَقَ بِہِ فَبَعَثَ ابْنُ عُمَرَ فَدَعَاہُ ، فَقَالَ : مَا تُرِیدُ أَنْ تَصْنَعَ ؟ فَقَالَ : أُرِیدُ أَنْ أَجْعَلَہُ دِرْعًا لِصَاحِبَتِیَّ ، فَقَالَ ابْنُ عُمَرَ : إِنْ لَمْ یَکُنْ یَشِفُّ فَإِنَّہُ یَصِفُ۔","","Musannaf Ibn Abi Shaybah 25291","","","كتاب اللباس"
"25292","(۲۵۲۹۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، عَنْ دِقْرۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : إِنَّا لاَ نَلْبَسُ الثِّیَابَ الَّتِی فِیہَا الصَّلِیبُ۔","Hasan","Musannaf Ibn Abi Shaybah 25292","","","كتاب اللباس"
"25293","(۲۵۲۹۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ أَبِی الْجَحَّاف?? ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ عَنْ تَابُوتٍ لِی فِیہِ تَمَاثِیلُ ؟ فَقَالَ : حَدَّثَنِی مَنْ رَأَی عُمَرَ یُحَرِّقُ ثَوْبًا فِیہِ صَلِیبٌ ، یَنْزِعُ الصَّلِیبَ مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 25293","","","كتاب اللباس"
"25294","(۲۵۲۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی عَلَی بَعْضِ أَزْوَاجِہِ سِتْرًا فِیہِ صَلِیبٌ ، فَأَمَرَ بِہِ فقضب۔","","Musannaf Ibn Abi Shaybah 25294","","","كتاب اللباس"
"25295","(۲۵۲۹۵) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ ثَابِتِ بْنِ عَدِّیٍّ ، قَالَ : مَا رَأَیْتُ ابْنَ عُمَرَ ، وَابْنَ عَبَّاسٍ زَارِّینَ عَلَیْہِمَا قَمِیصَہُمَا قَطُّ۔","Sahih","Musannaf Ibn Abi Shaybah 25295","","","كتاب اللباس"
"25296","(۲۵۲۹۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ الْعَیْزَارِ ، عَنْ سَعِیدٍ الْمَدَنِی ، قَالَ : کُنْتُ مَعَ أَبِی ہُرَیْرَۃَ فِی جِنَازَۃٍ ، فَرَأَیْتُہُ مُصْفَرَّ اللِّحْیَۃِ ، مُحَلَّلَ الأَزْرَارِ۔","Da'if","Musannaf Ibn Abi Shaybah 25296","","","كتاب اللباس"
"25297","(۲۵۲۹۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنِ ، عَنْ زُہَیْرٍ ، عَنْ عُرْوَۃَ بْنِ عَبْدِ اللہِ بْنِ قُشَیْرٍ ، قَالَ : حدَّثَنِی مُعَاوِیَۃُ بْنُ قُرَّۃَ ، عَنْ أَبِیہِ ، قَالَ : أَتَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَبَایَعْتُہُ ، وَإِنَّ قَمِیصَہُ لَمُطْلَقٌ ، قَالَ عُرْوَۃُ : فَمَا رَأَیْتُ مُعَاوِیَۃَ ، وَلاَ ابْنَہُ فِی شِتَائٍ ، وَلاَ حَرٍّ إِلاَّ مُطْلَقَۃً أَزْرَارُہُمَا۔ (ترمذی ۵۸۔ ابوداؤد ۴۰۷۹)","Sahih","Musannaf Ibn Abi Shaybah 25297","","","كتاب اللباس"
"25298","(۲۵۲۹۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ، عَنْ عَبْدِاللہِ بْنِ یَزِیدَ، قَالَ: مَا رَأَیْتُ سَعِیدَ بْنَ الْمُسَیَّبِ شَادًا عَلَیہِ إِِزارہ قَطُّ۔","","Musannaf Ibn Abi Shaybah 25298","","","كتاب اللباس"
"25299","(۲۵۲۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ ، قَالَ : مَا رَأَیْتُ سَالِمًا زَارًّا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 25299","","","كتاب اللباس"
"25300","(۲۵۳۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، قَالَ : رَأَیْتُ سَالِمًا مُحَلَّلًا أَزْرَارُہُ۔","","Musannaf Ibn Abi Shaybah 25300","","","كتاب اللباس"
"25301","(۲۵۳۰۱) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا الرَّبِیعُ بْنُ الْمُنْذِرِ ، عَنْ أَبِیہِ ؛ أَنَّہُ رَأَی عَلَی مُحَمَّدِ بْنِ الْحَنَفِیَّۃِ حَبْرَۃً مُحَلَّلَۃَ الأَزْرَارِ ، وَکَانَ لَہُ بُرْنُسُ خَزٍّ۔","","Musannaf Ibn Abi Shaybah 25301","","","كتاب اللباس"
"25302","(۲۵۳۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِلاَلِ بْنِ مَیْمُون ، قَالَ : مَا رَأَیْتُ سَعِیدَ بْنَ الْمُسَیَّبِ مُحَلَّلاً أَزْرَارُہُ۔","","Musannaf Ibn Abi Shaybah 25302","","","كتاب اللباس"
"25303","(۲۵۳۰۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، وَجَرِیرٌ ، عَنِ الرُّکَیْنِ ، عَنِ الْقَاسِمِ بْنِ حَسَّانَ ، عَنْ عَمِّہِ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ، عَنِ ابْنِ مَسْعُودٍ، أَنَّ نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ جَرِّ الإِزَارِ۔(ابویعلی ۵۱۲۹۔ احمد ۳۲۰)","Da'if","Musannaf Ibn Abi Shaybah 25303","","","كتاب اللباس"
"25304","(۲۵۳۰۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ جَبَلَۃَ ، وَمُحَارِبِ بْنِ دِثَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ جَرَّ ثَوْبَہُ مِنَ مَخِیْلۃٍ ، لَمْ یَنْظُرِ اللَّہُ إِلَیْہِ یَوْمَ الْقِیَامَۃِ۔n(بخاری ۵۷۹۱۔ مسلم ۱۶۵۲)","Sahih","Musannaf Ibn Abi Shaybah 25304","","","كتاب اللباس"
"25305","(۲۵۳۰۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إِنَّ الَّذِی یَجُرُّ ثَوْبَہُ مِنَ الْخُیَلاَئِ ، لاَ یَنْظُرُ اللَّہُ إِلَیْہِ یَوْمَ الْقِیَامَۃِ۔ (مسلم ۱۶۵۱۔ احمد ۲/۵۵)","Sahih","Musannaf Ibn Abi Shaybah 25305","","","كتاب اللباس"
"25306","(۲۵۳۰۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ جَرَّ إِزَارَہُ مِنَ الْخُیَلاَئِ ، لَمْ یَنْظُرِ اللَّہُ إِلَیْہِ یَوْمَ الْقِیَامَۃِ ، قَالَ : فَلَقِیتُ ابْنَ عُمَرَ بِالْبَلاَطِ ، قَالَ : فَذَکَرْتُ لَہُ حَدِیثَ أَبِی سَعِیدٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : فَأَشَارَ إِلَی أُذُنَیْہِ : سَمِعَتْہُ أُذُنَایَ ، وَوَعَاہُ قَلْبِی۔ (ابن ماجہ ۳۵۷۰)","Da'if","Musannaf Ibn Abi Shaybah 25306","","","كتاب اللباس"
"25307","(۲۵۳۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مَرَّ بِأَبِی ہُرَیْرَۃَ فَتًی مِنْ قُرَیْشٍ وَہُوَ یَجُرُّ سَبَلَہُ ، فَقَالَ : یَا ابْنُ أَخِی ، إِنِّی سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ جَرَّ ثَوْبَہُ مِنَ الْخُیَلاَئِ ، لَمْ یَنْظُرِ اللَّہُ إِلَیْہِ یَوْمَ الْقِیَامَۃِ۔ (ابن ماجہ ۳۵۷۱۔ احمد ۲/۵۰۳)","Hasan","Musannaf Ibn Abi Shaybah 25307","","","كتاب اللباس"
"25308","(۲۵۳۰۸) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا شَیْبَان ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، قَالَ : حَدَّثَنَا سَعِیدُ بْنُ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ اللَّہَ لاَ یَنْظُرُ إِلَی مُسْبِلٍ۔ (احمد ۱/۳۲۲۔ طبرانی ۱۲۴۱۳)","Sahih","Musannaf Ibn Abi Shaybah 25308","","","كتاب اللباس"
"25309","(۲۵۳۰۹) حَدَّثَنَا مُعَاوِیَۃَ بْنُ ہِشَامٍ ، عَنْ شَیْبَانَ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّہُ سَمِعَ عَبْدَ اللہِ بْنَ عُمَرَ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَنْظُرُ اللَّہُ إِلَی الَّذِی یَجُرُّ إِزَارَہُ خُیَلاَئَ۔n(احمد ۲/۶۹)","Hasan","Musannaf Ibn Abi Shaybah 25309","","","كتاب اللباس"
"25310","(۲۵۳۱۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَلِیِّ بْنِ مُدْرِکٍ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ خَرَشَۃَ بْنِ الْحُرِّ ، عَنْ أَبِی ذَرٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : ثَلاَثَۃٌ لاَ یُکَلِّمُہُمُ اللَّہُ یَوْمَ الْقِیَامَۃِ ، وَلاَ یَنْظُرُ إِلَیْہِمْ ، وَلاَ یُزَکِّیہِمْ ، وَلَہُمْ عَذَابٌ أَلِیمٌ ؛ الْمُسْبِلُ ، وَالْمَنَّانُ ، وَالْمُنْفِقُ سِلْعَتَہُ بِالْحَلِفِ الْکَاذِبِ۔ (مسلم ۱۰۲۔ ابوداؤد ۴۰۸۴)","Sahih","Musannaf Ibn Abi Shaybah 25310","","","كتاب اللباس"
"25311","(۲۵۳۱۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ یُقَالُ : مَنْ مَسَّ إِزَارُہُ کَعْبَیْہِ لَمْ تُقْبَلْ لَہُ صَلاَۃٌ، قَالَ : وَقَالَ ذِِرٌّ : مَنْ مَسَّ إِزَارُہُ الأَرْضَ لَمْ تُقْبَلْ لَہُ صَلاَۃٌ۔","","Musannaf Ibn Abi Shaybah 25311","","","كتاب اللباس"
"25312","(۲۵۳۱۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ إِبْرَاہِیمَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : دَخَلَ شَابٌّ عَلَی عُمَرَ ، فَجَعَلَ الشَّابُّ یُثْنِی عَلَیْہِ ، قَالَ : فَرَآہُ عُمَرُ یَجُرُّ إِزَارَہُ ، قَالَ : فَقَالَ لَہُ : یَا ابْنَ أَخِی ، ارْفَعْ إِزَارَک ، فَإِنَّہُ أَتْقَی لِرَبِّکَ وَأَنْقَی لِثَوْبِکَ ، قَالَ : فَکَانَ عَبْدُ اللہِ یَقُولُ : یَا عَجَبًا لِعُمَرَ أَنْ رَأَی حَقَّ اللہِ عَلَیْہِ ، فَلَمْ یَمْنَعْہُ مَا ہُوَ فِیہِ أَنْ تَکَلَّمَ بِہِ۔","","Musannaf Ibn Abi Shaybah 25312","","","كتاب اللباس"
"25313","(۲۵۳۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ س??فْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، عَنِ ابْنِ مَسْعُودٍ ؛ أَنَّہُ کَانَ یُسْبِلُ إِزَارَہُ ، فَقِیلَ لَہُ ، فَقَالَ : إِنِّی رَجُلٌ حَمِشُ السَّاقَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 25313","","","كتاب اللباس"
"25314","(۲۵۳۱۴) حَدَّثَنَا جَرِیرٌ، عَنْ أَبِی سِنَانٍ، عَنْ عَبْدِاللہِ بْنِ أَبِی الْہُذَیْلِ، قَالَ: سَأَلَ أَبُوبَکْرٍ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ مَوْضِعِ الإِزَارِ ؟ فَقَالَ : مُسْتَدَقَّ السَّاقِ ، لاَ خَیْرَ فِیمَا أَسْفَلَ مِنْ ذَلِکَ ، وَلاَ خَیْرَ فِیمَا فَوْقَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 25314","","","كتاب اللباس"
"25315","(۲۵۳۱۵) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُسْلِمِ بْنِ نُذَیْرٍ ، عَنْ حُذَیْفَۃَ ، قَالَ : أَخَذَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِأَسْفَلِ عَضَلَۃِ سَاقِی ، أَوْ سَاقِہِ ، فَقَالَ : ہَذَا مَوْضِعُ الإِزَارِ ، فَإِنْ أَبَیْتَ فَأَسْفَلَ ، فَإِنْ أَبَیْتَ فَأَسْفَلَ ، فَإِنْ أَبَیْتَ فَلاَ حَقَّ للإِزَارِ فِی الْکَعْبَیْنِ۔ (ترمذی ۱۷۸۳۔ ابن ماجہ ۳۵۷۲)","Hasan","Musannaf Ibn Abi Shaybah 25315","","","كتاب اللباس"
"25316","(۲۵۳۱۶) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ : سَمِعْتُ أَبَا نَبِیہٍ یَقُولُ : سَمِعْتُ عَائِشَۃَ تَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا تَحْتَ الْکَعْبِ مِنَ الإِزَارِ فِی النَّارِ۔ (احمد ۶/۵۹)","Da'if","Musannaf Ibn Abi Shaybah 25316","","","كتاب اللباس"
"25317","(۲۵۳۱۷) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی یَعْفُورَ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ وَإِنَّ إزَارَہُ إِلَی نِصْفِ سَاقَیْہِ ، أَوْ قَرِیبٍ مِنْ نِصْفِ سَاقَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 25317","","","كتاب اللباس"
"25318","(۲۵۳۱۸) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الْعَلاَئِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ یَعْقُوبَ ، عَنْ أَبِیہِ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِزْرَۃُ الْمُؤْمِنِ إِلَی نِصْفِ السَّاقِ ، فَمَا کَانَ إِلَی الْکَعْبِ فَلاَ بَأْسَ ، وَمَا کَانَ تَحْتَ الْکَعْبِ فَفِی النَّارِ۔ (ابوداؤد ۴۰۹۰۔ احمد ۳/۳۰)","","Musannaf Ibn Abi Shaybah 25318","","","كتاب اللباس"
"25319","(۲۵۳۱۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَبِی غِفَارٍ ، عَنْ أَبِی تَمِیمَۃَ الْہُجَیْمِیِّ ، عَنْ أَبِی جُرَیٍّ الْہُجَیْمِیِّ ، قَالَ : أَتَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقُلْتُ : عَلَیْکَ السَّلاَمُ یَا رَسُولَ اللہِ ، قَالَ: لاَ تَقُلْ: عَلَیْک السَّلاَمُ؟ فَإِنَّ عَلَیْک السَّلاَمُ تَحِیَّۃُ الْمَوتَی ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، زِدْنِی ، قَالَ : الإِزَارُ إِلَی نِصْفِ السَّاقِ ، فَإِن أَبَیتَ فَإِلَی الْکَعْبِین ، وَإِیَّاکَ وَالْمَخِیلَۃَ ، فَإِنَّ اللہ لاَ یُحِب الْمَخِیلَۃَ۔ (ابوداؤد ۴۰۸۱۔ ترمذی ۲۷۲۱)","Hasan","Musannaf Ibn Abi Shaybah 25319","","","كتاب اللباس"
"25320","(۲۵۳۲۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیِّ ، عن جَعْفَرٍ ، قَالَ : کَانَ مَیْمُونٌ یُشَمِّرُ إِزَارَہُ إِلَی أَنْصَافِ سَاقَیْہِ۔","","Musannaf Ibn Abi Shaybah 25320","","","كتاب اللباس"
"25321","(۲۵۳۲۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وُہَیْبٌ ، قَالَ : حَدَّثَنَا دَاوُد بْنُ أَبِی ہِنْدٍ ، عَنْ أَبِی قَزَعَۃَ ، عَنِ الأَسْقَعِ بْنِ الأَسْلَعِ ، عَنْ سَمُرَۃََ بْنِ جُنْدَبٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَا أَسْفَلَ مِنَ الْکَعْبَیْنِ مِنَ الإِزَارِ فِی النَّارِ۔ (احمد ۵/۹)","Sahih","Musannaf Ibn Abi Shaybah 25321","","","كتاب اللباس"
"25322","(۲۵۳۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی مَکِینٍ ، عَنْ خَالِدٍ ، عَنْ أَبِی أُمَیَّۃَ ؛ أَنَّ عَلِیًّا اتَّزَرَ ، فَلَحِقَ إِزَارُہُ بِرُکْبَتَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 25322","","","كتاب اللباس"
"25323","(۲۵۳۲۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : مَوْضِعُ الإِزَارِ مُسْتَدَقُّ السَّاقِ۔","","Musannaf Ibn Abi Shaybah 25323","","","كتاب اللباس"
"25324","(۲۵۳۲۴) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : الإِزَارُ إِلَی نِصْفِ السَّاقِ ، أَوْ إِلَی الْکَعْبَیْنِ ، لاَ خَیْرَ فِیمَا ہُوَ أَسْفَلُ مِنْ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 25324","","","كتاب اللباس"
"25325","(۲۵۳۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یَکْرَہُونَ الإِزَارَ فَوْقَ نِصْفِ السَّاقِ۔","","Musannaf Ibn Abi Shaybah 25325","","","كتاب اللباس"
"25326","(۲۵۳۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ سُلَیْمَانَ بْنِ مُسْہِرٍ ، عَنْ خَرَشَۃَ ؛ أَنَّ عُمَرَ دَعَا بِشَفْرَۃٍ فَرَفَعَ إِزَارَ رَجُلٍ عَنْ کَعْبَیْہِ ، ثُمَّ قَطَعَ مَا کَانَ أَسْفَلَ مِنْ ذَلِکَ ، قَالَ : فَکَأَنِّی أَنْظُرُ إِلَی ذَبَاذِبِہِ تَسِیلُ عَلَی عَقِبَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 25326","","","كتاب اللباس"
"25327","(۲۵۳۲۷) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی سِنَانٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ نَاسًا مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْتَزِرُونَ عَلَی أَنْصَافِ سُوقِہِمْ ، فَذَکَرَ أُسَامَۃَ بْنَ زَیْدٍ ، وَابْنَ عُمَرَ ، وَزَیْدَ بْنَ أَرْقَمَ ، وَالْبَرَائَ بْنَ عَازِبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 25327","","","كتاب اللباس"
"25328","(۲۵۳۲۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی یَحْیَی ، عَنْ عِکْرِمَۃَ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ یَأْتَزِرُ فَیُرْسِلُ إِزَارَہُ مِنْ بَیْنِ یَدَیْہِ ، حَتَّی تَقَعَ حَاشِیَتُہْمَا عَلَی ظَہْرِ قَدَمَیْہِ ، وَیَرْفَعُہُمَا مِنْ مُؤَخَّرِہِ۔n(ابوداؤد ۴۰۹۳۔ نسائی ۹۶۸۱)","Sahih","Musannaf Ibn Abi Shaybah 25328","","","كتاب اللباس"
"25329","(۲۵۳۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو سُلَیْمَانَ الْمُکْتِبُ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ عَلِیًّا عَلَیْہِ إِزَارٌ نَجْرَانِیٌّ إِلَی أَنْصَافِ سَاقَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 25329","","","كتاب اللباس"
"25330","(۲۵۳۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ دِہْقَانٍ ، قَالَ : رَأَیْتُ أَبَا سَعِیدٍ ، وَابْنَ عُمَرَ أُزْرُہُمَا إِلَی أَنْصَافِ سُوقِہِمَا۔","Da'if","Musannaf Ibn Abi Shaybah 25330","","","كتاب اللباس"
"25331","(۲۵۳۳۱) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ إیَاسِ بْنِ سَلَمَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ عُثْمَانَ بْنَ عَفَّانَ کَانَ إِزَارُہُ إِلَی نِصْفِ سَاقَیْہِ ، قَالَ : فَقِیلَ لَہُ فِی ذَلِکَ ؟ فَقَالَ : ہَذِہِ إِزَرَۃُ حَبِیبِی ، یَعْنِی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (ترمذی ۱۲۱۔ بزار ۳۵۳)","Da'if","Musannaf Ibn Abi Shaybah 25331","","","كتاب اللباس"
"25332","(۲۵۳۳۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا شَرِیکٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ حُصَیْنِ بْنِ قَبِیصَۃَ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا سُفْیَانُ بْنُ سَہْلٍ ، لاَ تُسْبِلْ ، فَإِنَّ اللَّہَ لاَ یُحِبُّ الْمُسْبِلِینَ۔ (احمد ۴/۲۴۶۔ ابن حبان ۵۴۴۲)","Hasan","Musannaf Ibn Abi Shaybah 25332","","","كتاب اللباس"
"25333","(۲۵۳۳۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، عَنْ أُسَیْرِ بْنِ جَابِرٍ : کَانَ یَکْرَہُ الْخِفَافَ وَالنِّعَالَ الَّتِی لَمْ تُذَکَّ۔","Sahih","Musannaf Ibn Abi Shaybah 25333","","","كتاب اللباس"
"25334","(۲۵۳۳۴) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ؛ أَنَّ عَائِشَۃَ کَانَتْ تَکْرَہُ الْفِرَائَ الَّتِی لَمْ تُذَکَّ۔","Sahih","Musannaf Ibn Abi Shaybah 25334","","","كتاب اللباس"
"25335","(۲۵۳۳۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ مِمَّنْ یَکْرَہُ الصَّلاَۃَ فِیمَا لَمْ یُذَکَّ ؛ عُمَرُ ، وَابْنُ عُمَرَ ، وَعِمْرَانُ بْنُ حُصَیْنٍ ، وَعَائِشَۃُ ، وَأُسَیْرُ بْنُ جَابِرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 25335","","","كتاب اللباس"
"25336","(۲۵۳۳۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ ، قَالَ : کَانَتْ قُمُصُ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ وَثِیَابُہُ مَا بَیْنَ الْکَعْبِ وَالشِّرَاکِ۔","","Musannaf Ibn Abi Shaybah 25336","","","كتاب اللباس"
"25337","(۲۵۳۳۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنِ ابْنِ أَبِی رَوَّادٍ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الإِسْبَالُ فِی الإِزَارِ ، وَالْقَمِیصِ ، وَالْعِمَامَۃِ ، مَنْ جَرَّ مِنْہَا شَیْئًا خُیَلاَئَ ، لَمْ یَنْظُرِ اللَّہُ إِلَیْہِ یَوْمَ الْقِیَامَۃِ۔n(ابوداؤد ۴۰۹۱۔ ابن ماجہ ۳۵۷۶)","Sahih","Musannaf Ibn Abi Shaybah 25337","","","كتاب اللباس"
"25338","(۲۵۳۳۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ سُلَیْمَانَ الأَحْوَلِ ، عَنْ مُجَاہِدٍ ، قَالَ : جَرُّ الْقَمِیصِ وَالإِزَارِ سَوَائٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 25338","","","كتاب اللباس"
"25339","(۲۵۳۳۹) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا إِسْمَاعِیلُ ، عَنْ شُعَیْبِ بْنِ یَسَارٍ ، قَالَ : ذَکَرُوا عِنْدَ عِکْرِمَۃَ جَرَّ الْقَمِیصِ وَالإِزَارِ ، فَقَالَ : ہُوَ وَاللَّہِ شَرٌّ وَأَشَرُّ۔","","Musannaf Ibn Abi Shaybah 25339","","","كتاب اللباس"
"25340","(۲۵۳۴۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ طَاوُوسٍ ، قَالَ : کَانَ قَمِیصُہُ فَوْقَ الإِزَارِ ، وَالرِّدَائُ فَوْقَ الْقَمِیصِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25340","","","كتاب اللباس"
"25341","(۲۵۳۴۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، قَالَ : رَأَیْتُ الْقَاسِمَ قَمِیصُہُ إِلَی الْکَعْبِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25341","","","كتاب اللباس"
"25342","(۲۵۳۴۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ مُغِیرَۃَ ، قَالَ : کَانَ إِبْرَاہِیمُ قَمِیصُہُ عَلَی ظَہْرِ الْقَدَمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25342","","","كتاب اللباس"
"25343","(۲۵۳۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ عُمَیْرٍ ، قَالَ : رَأَیْتُ قَمِیصَ سَالِمٍ مُشَمَّرًا فَوْقَ الْکَعْبَیْنِ ، فَقَالَ : إنِّی رَأَیْتُ ابْنَ عُمَرَ کَانَ قَمِیصُہُ ہَکَذَا۔","Hasan","Musannaf Ibn Abi Shaybah 25343","","","كتاب اللباس"
"25344","(۲۵۳۴۴) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرِ ، عَنْ عَلِیٍّ ، قَالَ : ابْتَاعَ عَلِیٌّ قَمِیصًا سُنْبُلاَنِیًّا بِأَرْبَعَۃِ دَرَاہِمَ ، وَدَعَا الْخَیَّاطَ ، فَمَدَّ کُمَّ الْقَمِیصِ ، وَأَمَرَہُ أَنْ یَقْطَعَ مَا خَلْفَ أَصَابِعِہِ۔","","Musannaf Ibn Abi Shaybah 25344","","","كتاب اللباس"
"25345","(۲۵۳۴۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا سَعِیدٌ الْجُرَیْرِیُّ ، عَنْ أَبِی عُثْمَانَ النَّہْدِیِّ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ دَعَا بِشَفْرَۃٍ لِیَقْطَعَ کُمَّ قَمِیصِ عُتْبَۃَ بْنِ فَرْقَدَ مِنْ أَطْرَافِ أَصَابِعِہِ ، وَکَانَ عَلَیْہِ قَمِیصٌ سُنْبُلاَنِیٌّ ، فَقَالَ : أَنَا أَکْفِیکَہُ یَا أَمِیرَ الْمُؤْمِنِینَ ، إِنِّی أَسْتَحِی أَنْ تَقْطَعَہُ عِنْدَ النَّاسِ ، فَتَرَکَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25345","","","كتاب اللباس"
"25346","(۲۵۳۴۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْہُذَیْلِ ، قَالَ : رَأَیْتُ عَلِیًّا عَلَیْہِ قَمِیصٌ مَدَریٌّ ، أَوْ رَازِقِیٌّ ، إِذَا أَرْسَلَہُ بَلَغَ نِصْفَ سَاقَیْہِ ، وَإِذَا مَدَّہُ لَمْ یُجَاوِزْ ظُفْرَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 25346","","","كتاب اللباس"
"25347","(۲۵۳۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْبُحْتُرِیِّ ، قَالَ : رَأَیْتُ أَنَسَ بْنَ مَالِکٍ وَکُمُّ قَمِیصِہِ إِلَی الرَّصْغِ۔","Sahih","Musannaf Ibn Abi Shaybah 25347","","","كتاب اللباس"
"25348","(۲۵۳۴۸) حَدَّثَنَا وَکِیعٌ، عَنْ مُوسَی الْمُعَلِّمِ، عَنْ بُدَیْلٍ الْعُقَیْلِیِّ، قَالَ: کَانَ کُمُّ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلَی الرَّصْغِ۔n(ابوداؤد ۴۰۲۳۔ ترمذی ۱۷۶۵)","","Musannaf Ibn Abi Shaybah 25348","","","كتاب اللباس"
"25349","(۲۵۳۴۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی یَحْیَی ، قَالَ : حدَّثَنِی أَبُو الْعَلاَئِ ، قَالَ : رَأَیْتُ عَلِیًّا یَأْتَزِرُ فَوْقَ السُّرَّۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 25349","","","كتاب اللباس"
"25350","(۲۵۳۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ قُدَامَۃَ بْنِ مُوسَی ، عَنْ أَبِیہِ ، قَالَ : صَلَّیْتُ إِلَی جَنْبِ ابْنِ عُمَرَ ، وَقَدِ اتَّزَرَ فَوْقَ السُّرَّۃِ ، فَجَذَبَہُ حَتَّی جَعَلَہُ أَسْفَلَ مِنْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 25350","","","كتاب اللباس"
"25351","(۲۵۳۵۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، وَابْنِ سِیرِینَ؛ أَنَّہُمَا کَانَا یَتَّزِرَانِ إِلَی أَسْفَلَ مِنَ السُّرَّۃِ۔","","Musannaf Ibn Abi Shaybah 25351","","","كتاب اللباس"
"25352","(۲۵۳۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، قَالَ : رَأَیْتُ عَلَی عَلِیِّ بْنِ الْحُسَیْنِ قَلَنْسُوَۃً بَیْضَائَ مضرَّبۃ۔","","Musannaf Ibn Abi Shaybah 25352","","","كتاب اللباس"
"25353","(۲۵۳۵۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، قَالَ : رَأَیْتُ عَلَی ابْنِ الزُّبَیْرِ قَلَنْسُوَۃً لَہَا رفٌّ ، کَانَ یَسْتَظِلُّ بِہَا إِذَا طَافَ بِالْبَیْتِ۔","Sahih","Musannaf Ibn Abi Shaybah 25353","","","كتاب اللباس"
"25354","(۲۵۳۵۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، قَالَ ، رَأَیْتُ عَلَی إِبْرَاہِیمَ قَلَنْسُوَۃً مَکْفُوفَۃً بِثَعَالِبَ ، أَوْ سُمُورٍ۔","","Musannaf Ibn Abi Shaybah 25354","","","كتاب اللباس"
"25355","(۲۵۳۵۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَجْلَحِ ، قَالَ : رَأَیْتُ عَلَی الضَّحَّاکِ قَلَنْسُوَۃَ ثَعَالِبَ۔","No Data Available","Musannaf Ibn Abi Shaybah 25355","","","كتاب اللباس"
"25356","(۲۵۳۵۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَشْعَثَ ، عَنْ أَبِیہِ ؛ أَنَّ أَبَا مُوسَی خَرَجَ مِنَ الْخَلاَئِ ، وَعَلَیْہِ قَلَنْسُوَۃٌ ، فَمَسَحَ عَلَیْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 25356","","","كتاب اللباس"
"25357","(۲۵۳۵۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ مِسْعَرٍ ، عَنْ عُثْمَانَ بْنِ الْمُغِیرَۃِ ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ ، قَالَ : رَأَیْتُ عَلِیًّا یَتَّزِرُ ، فَرَأَیْتُ عَلَیْہِ تُبَّانًا۔","Sahih","Musannaf Ibn Abi Shaybah 25357","","","كتاب اللباس"
"25358","(۲۵۳۵۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، قَالَ : کَانَتْ عَائِشَۃُ إِذَا خَرَجَتْ حَاجَّۃً ، أَوْ مُعْتَمِرَۃً أَخْرَجَتْ مَعَہَا عَبِیدَہَا یُرَحِّلُونَ ہَوْدَجَہَا ، فَکَانُوا یُشعرُونَ بِأَرْجُلِہِمْ إِلَی بَطْنِ الْبَغْلَۃِ ، فَأَمَرَتْہُمْ أَنْ یَلْبَسُوا التَّبَّابِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 25358","","","كتاب اللباس"
"25359","(۲۵۳۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْہَیْثُمِ قَالَ : قَالَ سَلْمَانُ : نِعْمَ الثَّوْبُ التُّبَّانُ۔","","Musannaf Ibn Abi Shaybah 25359","","","كتاب اللباس"
"25360","(۲۵۳۶۰) حَدَّثَنَا أَسْبَاطٌ ، عَنِ الْعَلاَئِ بْنِ حَبِیبٍ ، قَالَ : رُئِی عَلَی عَمَّارِ بْنِ یَاسِرٍ تُبَّانٌ وَہُوَ بِعَرَفَاتٍ۔","","Musannaf Ibn Abi Shaybah 25360","","","كتاب اللباس"
"25361","(۲۵۳۶۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، قَالَ : کَانَ أَبِی یَلْبَس تُبَّانًا تَحْتَ الإِزَار۔","","Musannaf Ibn Abi Shaybah 25361","","","كتاب اللباس"
"25362","(۲۵۳۶۲) حَدَّثَنَا أَبُو مُعَاوِیَ??َ ، عَنِ الأَعْمَشِ ، قَالَ : رَأَیْتُ أَبَا صَادِقٍ یَتَّزر ، فَرَأَیْتُ تَحْتَ إِزَارِہِ تُبَّانًا۔","","Musannaf Ibn Abi Shaybah 25362","","","كتاب اللباس"
"25363","(۲۵۳۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، قَالَ : رَأَیْتُ عَلَی عَلِیِّ بْنِ رَبِیعَۃَ الْوَالِبِی تُبَّانًا ، قَالَ : کَانَ الشَّیْخُ ، یَعْنِی عَلِیًّا ، یَلْبَسُہُ۔","","Musannaf Ibn Abi Shaybah 25363","","","كتاب اللباس"
"25364","(۲۵۳۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ تَأْمُرُ غِلْمَانَہَا بِلُبْسِ التَّبَّابِینَ وَہُمْ مُحْرِمُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 25364","","","كتاب اللباس"
"25365","(۲۵۳۶۵) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، قَالَ : کَانَ أَبُو مُوسَی إِذَا نَامَ لَبِسَ تُبَّانًا ، مَخَافَۃَ أَنْ تَبْدُوَ عَوْرَتُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25365","","","كتاب اللباس"
"25366","(۲۵۳۶۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : کَتَبَ عُمَرُ إِلَی أَبِی مُوسَی : أَنَ قَطِّعُوا الرّکُبَ، وَانْزُوا عَلَی الْخَیْلِ نَزْوًا ، وَأَلْقُوا الْخِفَافَ ، وَاحتذُوا النِّعَالَ ، وَأَلْقُوا السَّرَاوِیلاَتِ ، وَاتَّزِرُوا ، وَارْمُوا الأَغْرَاضَ، وَعَلَیْکُمْ بِاللِّبْسَۃِ الْمُعَدِّیَۃِ ، وَإِیَّاکُمْ وَہَدْیَ الْعَجَمِ ، فَإِنَّ شَرَّ الْہَدْیِ ، ہَدْیُ الْعَجَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 25366","","","كتاب اللباس"
"25367","(۲۵۳۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سِمَاکِ بْنِ حَرْبٍ ، عَنْ سُوَیْد بْنِ قَیْسٍ ، قَالَ : أَتَانَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَاوَمَنَا سَرَاوِیلَ۔","Hasan","Musannaf Ibn Abi Shaybah 25367","","","كتاب اللباس"
"25368","(۲۵۳۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مُعَاذِ بْنِ الْعَلاَئِ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : خَطَبَنَا عَلِیٌّ بِالْکُوفَۃِ وَعَلَیْہِ سَرَاوِیلُ۔","Da'if","Musannaf Ibn Abi Shaybah 25368","","","كتاب اللباس"
"25369","(۲۵۳۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ حَفْصِ بْنِ أَبِی مَنْصُورٍ ، قَالَ : رَأَیْتُ عَلَی الشَّعْبِیِّ سَرَاوِیلَ۔","","Musannaf Ibn Abi Shaybah 25369","","","كتاب اللباس"
"25370","(۲۵۳۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مَہْدِیٍّ ، قَالَ : کَانَ الْحَسَنُ إِذَا کَانَ الشِّتَائُ لَبِسَ سَرَاوِیلَ حِبَرَۃٍ ، وَقَبَائَ حِبَرَۃٍ۔","","Musannaf Ibn Abi Shaybah 25370","","","كتاب اللباس"
"25371","(۲۵۳۷۱) حَدَّثَنَا وَکِیعٌ، عَنْ عِمْرَانَ، عَنْ أَبِی مِجْلَزٍ، قَالَ: جَائَ کِتَابُ عُمَرَ: أَنْ أَلْقُوا السَّرَاوِیلاَتِ، وَالْبَسُوا الأُزُرَ۔","","Musannaf Ibn Abi Shaybah 25371","","","كتاب اللباس"
"25372","(۲۵۳۷۲) حَدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ وَاصِلٍ مَوْلَی أَبِی عُیَیْنَۃَ ، قَالَ : إِنَّ اللَّہَ تَعَالَی أَوْحَی إِلَی إِبْرَاہِیمَ : إِنَّکَ أَکْرَمُ الْخَلْقِ عَلَیَّ ، فَإِذَا صَلَّیْتَ فَلاَ تَری الأَرْضُ عَوْرَتَکَ ، وَاتَّخِذْ سَرَاوِیلاً۔","","Musannaf Ibn Abi Shaybah 25372","","","كتاب اللباس"
"25373","(۲۵۳۷۳) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَبِی خَلْدَۃَ ، قَالَ : رَأَیْتُ أَبَا الْعَالِیَۃِ عَلَیْہِ سَرَاوِیلُ ، قَالَ : فَقُلْتُ لَہُ ؟ قَالَ : إِنَّہَا مِنْ لِبَاسِ الرِّجَالِ۔","","Musannaf Ibn Abi Shaybah 25373","","","كتاب اللباس"
"25374","(۲۵۳۷۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہَمَّامٌ ، عَنْ قَتَادَۃَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کُلُوا وَاشْرَبُوا وَتَصَدَّقُوا ، وَالْبَسُوا مَا لَمْ یُخَالِطْہُ إِسْرَافٌ ، وَلاَ مَخِیلَۃٌ۔ (ابن ماجہ ۳۶۰۵۔ احمد ۲/۱۸۱)","Hasan","Musannaf Ibn Abi Shaybah 25374","","","كتاب اللباس"
"25375","(۲۵۳۷۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إِبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کُلْ مَا شِئْتَ ، وَالْبَسْ مَا شِئْتَ ، مَا أَخْطَأَتْک خُلَّتَانِ : سَرَفٌ ، أَوْ مَخِیلَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 25375","","","كتاب اللباس"
"25376","(۲۵۳۷۶) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ فِی قَوْلِہِ تَعْالَی : { وَالَّذِینَ إِذَا أَنْفَقُوا لَمْ یُسْرِفُوا وَلَمْ یَقْتُرُوا وَکَانَ بَیْنَ ذَلِکَ قَوَامًا } قَالَ : لاَ تُجِیعُہُمْ ، وَلاَ تُعَرِّیہِمْ ، وَلاَ تُنْفِقُ نَفَقَۃً یَقُولُ النَّاسُ : إِنَّک أَسْرَفْتَ فِیہَا۔","","Musannaf Ibn Abi Shaybah 25376","","","كتاب اللباس"
"25377","(۲۵۳۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ عُثْمَانَ الْحَاطِبِیِّ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی عَلَی عُثْمَانَ ثَوْبًا قُوہِیًّا۔","Da'if","Musannaf Ibn Abi Shaybah 25377","","","كتاب اللباس"
"25378","(۲۵۳۷۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ إِسْمَاعِیلَ بْنِ سُمَیْعٍ ، عَنْ أَبِی رَزِینٍ ، قَالَ : خَرَجَ عَلِیُّ بْنُ أَبِی طَالِبٍ وَعَلَیْہِ قَمِیصٌ مِنْ قَہْزٍ ، وَعَلَیْہِ بُرْدان قِطْرِیَان۔","Sahih","Musannaf Ibn Abi Shaybah 25378","","","كتاب اللباس"
"25379","(۲۵۳۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ عَطَائٍ أَبِی مُحَمَّدٍ ، قَالَ : رَأَیْتُ عَلَی عَلِیٍّ قَمِیصًا مِنْ ہَذِہِ الْکَرَابِیسِ غَیْرَ غَسِیلٍ۔","Da'if","Musannaf Ibn Abi Shaybah 25379","","","كتاب اللباس"
"25380","(۲۵۳۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مَیمُون أَبِی القَاسِم قَالَ : رَأَیْتُ عَلَی عَطَاء قَمِیصًا زُطِّیًّا۔","","Musannaf Ibn Abi Shaybah 25380","","","كتاب اللباس"
"25381","(۲۵۳۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ خَالِدٍ أَبِی الْعَلاَئِ ، قَالَ : رَأَیْتُ عَلَی الْحَسَنِ قَمِیصًا زَطِیًّا۔","","Musannaf Ibn Abi Shaybah 25381","","","كتاب اللباس"
"25382","(۲۵۳۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : رَأَیْتُ عَلَیْہِ قَمِیصًا غَلِیظًا۔","","Musannaf Ibn Abi Shaybah 25382","","","كتاب اللباس"
"25383","(۲۵۳۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ السَّائِبِ الطَّائِفِیِّ ، عَنْ مُحَمَّدِ بْنِ السَّائِبِ بْن أَبِی ہِنْدیۃَ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ عَلَی عُمَرَ ثَوْبَیْنِ قِطْرِیَّیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 25383","","","كتاب اللباس"
"25384","(۲۵۳۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مُطَیْرِ بْنِ ثَعْلَبَۃَ ، عَنْ أَبِی النَّوَارِ ، قَالَ : رَأَیْتُ عَلِیًّا اشْتَرَی قَمِیصَیْنِ غَلِیظَیْنِ خیَّر قَنْبر أَحَدَہمَا۔","Da'if","Musannaf Ibn Abi Shaybah 25384","","","كتاب اللباس"
"25385","(۲۵۳۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ عُبَیْدٍ ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ ، قَالَ : رَأَیْتُ عَلَی عَلِیٍّ ثَوْبَیْنِ قِطْرِیَّیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 25385","","","كتاب اللباس"
"25386","(۲۵۳۸۶) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاہِیمَ، قَالَ: کَانَ مَنْ قَبْلَکُمْ أَسْفَقَ ثِیَابًا، وَأَشْفَقَ قُلُوبًا۔","","Musannaf Ibn Abi Shaybah 25386","","","كتاب اللباس"
"25387","(۲۵۳۸۷) حَدَّثَنَا یَزِیدُ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی طَلْحَۃَ ، قَالَ : خَرَجَ طَلْحَۃُ بْنُ عُبَیْدِ اللہِ وَعَلَیْہِ ثَوْبَانِ مُمَصَّرَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 25387","","","كتاب اللباس"
"25388","(۲۵۳۸۸) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : سُئِلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَمْ تَجُرُّ الْمَرْأَۃُ مِنْ ذَیْلِہَا ؟ قَالَ : شِبْرًا ، قَالَتْ : إِذًا یَنْکَشِفُ عَنْہُا ؟ قَالَ : فَذِرَاعًا ، لاَ تَزِیدُ عَلَیْہِ۔ (ابوداؤد ۴۱۱۵۔ احمد ۲/۵۵)","Sahih","Musannaf Ibn Abi Shaybah 25388","","","كتاب اللباس"
"25389","(۲۵۳۸۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ زَیْدٍ الْعَمِّیِّ ، عَنْ أَبِی الصِّدِّیقِ ، عنِ ابْنِ عُمَرَ ؛ أَنَّ أَزْوَاجَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رُخِّصَ لَہُنَّ فِی الذَّیْلِ شِبْرًا ، فَکُنَّ یَأْتِینَنَا فَنَذْرَعُ لَہُنَّ بِالْقَصَبِ ذِرَاعًا۔n(ابوداؤد ۴۱۱۶۔ احمد ۲/۱۸)","Da'if","Musannaf Ibn Abi Shaybah 25389","","","كتاب اللباس"
"25390","(۲۵۳۹۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شَبَّرَ لِفَاطِمَۃَ شِبْرًا ، ثُمَّ قَالَ : ہَذَا قَدْرُ ذَیْلِکِ۔","Hasan","Musannaf Ibn Abi Shaybah 25390","","","كتاب اللباس"
"25391","(۲۵۳۹۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی الْمُہَزِّمِ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لِفَاطِمَۃَ ، أَوْ لأُمِّ سَلَمَۃَ : ذَیْلُکِ ذِرَاعٌ۔ (ابن ماجہ ۳۵۸۳۔ احمد ۲/۲۶۳)","Da'if","Musannaf Ibn Abi Shaybah 25391","","","كتاب اللباس"
"25392","(۲۵۳۹۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حَدَّثَنَا إِسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ یُونُسَ بْنِ أَبِی خَالِدٍ ، قَالَ : کَانَ یُؤْمَرُ أَنْ تَجْعَلَ الْمَرْأَۃُ ذَیْلَہَا ذِرَاعًا۔","","Musannaf Ibn Abi Shaybah 25392","","","كتاب اللباس"
"25393","(۲۵۳۹۳) حَدَّثَنَا ہُشَیْمٌ، عَنِ ابْنِ عَوْنٍ، عَنِ ابْنِ سِیرِینَ ، قَالَ: کَانُوا لاَ یَرَوْنَ بَأْسًا بِصُوفِ الْمَیْتَۃِ ، وَشَعْرِ الْوَبَرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25393","","","كتاب اللباس"
"25394","(۲۵۳۹۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الْخَالِقِ ، عَنْ حَمَّادٍ فِی صُوفِ الْمَیْتَۃِ : إِذَا غُسِلَ فَہُوَ ذَکَاتُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25394","","","كتاب اللباس"
"25395","(۲۵۳۹۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا بِصُوفِ الْمَیْتَۃِ أَنْ یُنْتَفَعَ بِہِ ، وَقَالَ الْحَسَنُ : یُغْسَلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25395","","","كتاب اللباس"
"25396","(۲۵۳۹۶) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانُوا لاَ یَرَوْنَ بِالصُّوفِ ،وَالشَّعْرِ ، وَالْمِرْعِزَّی ، وَالْوَبَرِ بَأْسًا ، إِنَّمَا کَانُوا یَکْرَہُونَ الصَّلاَۃَ فِی الْجِلْدِ۔","","Musannaf Ibn Abi Shaybah 25396","","","كتاب اللباس"
"25397","(۲۵۳۹۷) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ عِمْرَانَ الْقَطَّانِ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الرِّیشِ ، وَالْعَقِبِ ، وَالصُّوفِ ، وَالْعِظَامِ مِنَ الْمَیْتَۃِ ، قَالَ : إِذَا غُسِلَ فَہُوَ طَہُورُہُ۔","","Musannaf Ibn Abi Shaybah 25397","","","كتاب اللباس"
"25398","(۲۵۳۹۸) حَدَّثَنَا ہُشَیمٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ بَنَاتِ حُسَیْنِ بْنِ عَلِیٍّ کُنَّ یَلْبَسْنَ الْقُمُصَ ، فَإِذَا بَلَغْنَ وَتَزَوَّجْنَ ، یَلْبِسْنَ الدُّرُوعَ۔","","Musannaf Ibn Abi Shaybah 25398","","","كتاب اللباس"
"25399","(۲۵۳۹۹) حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ ، قَالَ : لاَ بَأْسَ بِرِیشِ الْمَیْتَۃِ۔","","Musannaf Ibn Abi Shaybah 25399","","","كتاب اللباس"
"25400","(۲۵۴۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ سُلَیْمَانَ بْنِ مَیْسَرَۃَ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، عَنْ رَافِعِ بْنِ أَبِی رَافِعٍ ، قَالَ : رَأَیْتُ أَبَا بَکْرٍ وَکَانَ لَہُ کِسَائٌ فَدَکِیٌّ یَخُلُّہُ عَلَیْہِ إِذَا رَکِبَ ، وَنَلْبَسُہُ أَنَا وَہُوَ إِذَا نَزَلْنَا ، وَہُوَ الْکِسَائُ الَّذِی عَیَّرَتْہُ بِہِ ہَوَازِنُ ، قَالُوا : ذَا الْخَلاَلُ نُبَایع بَعْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 25400","","","كتاب اللباس"
"25401","(۲۵۴۰۱) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إِسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : حَجَّ أَبُو مُوسَی عَلَی جَمَلٍ أَحْمَرَ مُلَبَّدًا رَأْسُہُ ، عَلَیْہِ عَبَائَۃٌ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25401","","","كتاب اللباس"
"25402","(۲۵۴۰۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَتْ لأَزْوَاجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَکْسِیَۃٌ تُسَمَّی الْمُرُوطَ غَیْرُ وَاسِعَۃٍ وَاللَّہِ ، وَلاَ لَیِّنَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 25402","","","كتاب اللباس"
"25403","(۲۵۴۰۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : أَخْبَرَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃَ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَنْ أَبِی بُرْدَۃَ ، قَالَ : دَخَلْتُ عَلَی عَائِشَۃَ فَأَخْرَجَتْ إِلَیَّ إِزَارًا غَلِیظًا مِنَ الَّتِی تُصْنَعُ بِالْیَمَنِ ، وَکِسَائً مِنْ ہَذِہِ الأَکْسِیَۃِ الَّتِی تَدْعُونَہَا الْمُلَبَّدَۃَ ، فَأَقْسَمَتْ : لَقُبِضَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِیہِمَا۔ (بخاری ۳۱۰۸۔ مسلم ۳۵)","Sahih","Musannaf Ibn Abi Shaybah 25403","","","كتاب اللباس"
"25404","(۲۵۴۰۴) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، عَنْ شَیْبَانَ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : فَقَالَ لِی : یَا بُنَیَّ ، لَوْ شَہِدْتنَا وَنَحْنُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا أَصَابَتْنَا السَّمَائُ ، لَحَسِبْتَ أَنَّ رِیِحَنَا رِیحُ الضَّأْنِ۔ (ابوداؤد ۴۰۳۰۔ ترمذی ۲۴۷۹)","Sahih","Musannaf Ibn Abi Shaybah 25404","","","كتاب اللباس"
"25405","(۲۵۴۰۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ خِرَاشٍ ، قَالَ : رَأَیْتُ أَبَا ذَرٍّ وَکَانَ یَجْلِسُ عَلَی قِطْعَۃِ الْمِسْحِ وَالْجُوَالِقِ۔","Da'if","Musannaf Ibn Abi Shaybah 25405","","","كتاب اللباس"
"25406","(۲۵۴۰۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عَبَّادٍ بْنِ عَبَّادٍ الْمَازِنِیِّ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : قرَسَ أَصْحَابَ ابْنِ مَسْعُودٍ الْبَرْدُ ، قَالَ: فَجَعَلَ الرَّجُلُ یَسْتَحْیِی أَنْ یَجِیئَ فِی الْکِسَائِ الدَّونِ، أَوِ الثَّوْبِ الدَّونِ، قَالَ فَأَصْبَحَ أَبُو عَبْدِ الرَّحْمَنِ فِی عَبَائَۃ ، ثُمَّ أَصْبَحَ فِیہَا ، ثُمَّ أَصْبَحَ فِیہَا فِی الْیَوْمِ الثَّالِثِ ، فَجَعَلَ النَّاسُ یَتَرَاجَعُونَ۔","","Musannaf Ibn Abi Shaybah 25406","","","كتاب اللباس"
"25407","(۲۵۴۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ الْغَازِ ، عَنْ عُبَادَۃَ بْنِ نُسَیٍّ ، عَنْ سَلْمَانَ ؛ أَنَّہُ کَانَ لَہُ حُبًا مِنْ عَبَائٍ، وَہُوَ أَمِیرُ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 25407","","","كتاب اللباس"
"25408","(۲۵۴۰۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : کَانَ عِیسَی بْنُ مَرْیَمَ یَلْبَسُ الشَّعْرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 25408","","","كتاب اللباس"
"25409","(۲۵۴۰۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ سَعِید ، عَنْ مُغِیرَۃَ ، قَالَ : کَانَ إِبْرَاہِیمُ لاَ یَرَی بَأْسًا أَنْ یَلْبَسَ الرَّجُلُ الثَّوْبَ بِخَمْسِینَ دِرْہَمًا ، یَعْنِی الطَّیْلَسَانَ۔","","Musannaf Ibn Abi Shaybah 25409","","","كتاب اللباس"
"25410","(۲۵۴۱۰) حَدَّثَنَا جَرِیرٌ ، عَنْ إِبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِیہِ ، عَنْ مَسْرُوقٍ ، قَالَ : کَانَ لاَ یُغَالِی بِثَوْبٍ، إِلاَّ بِطَیْلَسَانَ۔","","Musannaf Ibn Abi Shaybah 25410","","","كتاب اللباس"
"25411","(۲۵۴۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ لِتَمِیمٍ رِدَائٌ اشْتَرَاہُ بِأَلْفٍ ، یُصَلِّی فِیہِ۔","","Musannaf Ibn Abi Shaybah 25411","","","كتاب اللباس"
"25412","(۲۵۴۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عُثْمَانَ بْنِ وَاقِدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ عُمَرُ یَکْسُو الرَّجُلَ مِنْ أَصْحَابِ مُحَمَّد صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الحلۃ بِتِسْعِ مِئَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 25412","","","كتاب اللباس"
"25413","(۲۵۴۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ إِبْرَاہِیمَ بْنِ مُحَمَّدِ بْن الْمُنْتَشِرِ ، قَالَ : کَانَ مَسْرُوقٌ لاَ یُغَالِی بِثَوْبٍ ، إِلاَّ بِطَیْلَسَانَ۔","","Musannaf Ibn Abi Shaybah 25413","","","كتاب اللباس"
"25414","(۲۵۴۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ إِبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، قَالَ : کَانَ مَسْرُوقٌ یَلْبَسُ الْکَتَّانَ تَحْتَ الْقُطْنِ۔","","Musannaf Ibn Abi Shaybah 25414","","","كتاب اللباس"
"25415","(۲۵۴۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ قُرَّۃَ بْنِ خَالِدٍ ، قَالَ : قُلْتُ لاِبْنِ سِیرِینَ : مَا کَانَ لِبَاسُ أَبِی ہُرَیْرَۃَ ؟ قَالَ : مِثْلَ ثَوْبَیَّ ہَذَیْنِ ، وَعَلَیْہِ ثَوْبَانِ کَتَّانٍ مُمَشَّقَانِ ، فَتَمَخَّطَ مَرَّۃً ، فَقَالَ : بَخٍ ، بَخٍ ، یَتَمَخَّطُ أَبُو ہُرَیْرَۃَ فِی الْکَتَّانِ۔","Sahih","Musannaf Ibn Abi Shaybah 25415","","","كتاب اللباس"
"25416","(۲۵۴۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ مُحَمَّدِ بْنِ زِیَادٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِذَا انْتَعَلَ أَحَدُکُمْ فَلْیَبْدَأْ بِالْیُمْنَی ، وَإِذَا خَلَعَ فَلْیَبْدَأْ بِالْیُسْرَی۔ (مسلم ۱۶۶۰۔ احمد ۲/۲۳۳)","Sahih","Musannaf Ibn Abi Shaybah 25416","","","كتاب اللباس"
"25417","(۲۵۴۱۷) حَدَّثَنَا حَفْصٌ، عَنْ اللَّیْثِ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ إِذَا انْتَعَلَ بَدَأَ بِالْیُمْنَی، وَإِذَا خَلَعَ بَدَأَ بِالْیُسْرَی۔","Da'if","Musannaf Ibn Abi Shaybah 25417","","","كتاب اللباس"
"25418","(۲۵۴۱۸) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَانَ یَسْتَحِبُّ إِذَا لَبِسَ ، أَنْ یَبْدَأَ بِالْیُمْنَی ، وَإِذَا خَلَعَ أَنْ یَبْدَأَ بِالْیُسْرَی۔","","Musannaf Ibn Abi Shaybah 25418","","","كتاب اللباس"
"25419","(۲۵۴۱۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إِذَا لَبِسْتَ فَابْدَأْ بِالْیُمْنَی ، وَإِذَا خَلَعْتَ فَابْدَأْ بِالْیُسْرَی۔","Sahih","Musannaf Ibn Abi Shaybah 25419","","","كتاب اللباس"
"25420","(۲۵۴۲۰) حَدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ الْمَلِکِ ، عَنِ ابْنِ عَمٍّ لِعُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : کَانَ عُبَیْدُ بْنُ عُمَیْرٍ یَبْدَأُ فَیَخْلَعُ الْیُسْرَی ، ثُمَّ یَخْلَعُ الْیُمْنَی فَیَجْعَلُہَا عَلَی الْیُسْرَی۔","","Musannaf Ibn Abi Shaybah 25420","","","كتاب اللباس"
"25421","(۲۵۴۲۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَمْشِ أَحَدُکُمْ فِی نَعْلٍ وَاحِدَۃٍ ، وَلاَ فِی خُفٍّ وَاحِدَۃٍ ، لِیَخْلَعْہُمَا جَمِیعًا ، أَوْ لِیَمْشِ فِیہِمَا جَمِیعًا۔ (بخاری ۵۸۵۵۔ مسلم ۱۶۶۰)","Hasan","Musannaf Ibn Abi Shaybah 25421","","","كتاب اللباس"
"25422","(۲۵۴۲۲) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی رَزِینٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : خَرَجَ إِلَیْنَا یَضْرِبُ بِیَدِہِ عَلَی جَبْہَتِہِ ، ثُمَّ قَالَ : إِنَّکُمْ تُحَدِّثُونَ أَنِّی أَکْذِبُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَشْہَدُ لَسَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إِذَا انْقَطَعَ شِسْعُ أَحَدِکُمْ فَلاَ یَمْشِی فِی الأُخْرَی حَتَّی یُصْلِحَہَا۔n(بخاری ۹۵۶۔ مسلم ۶۹)","Sahih","Musannaf Ibn Abi Shaybah 25422","","","كتاب اللباس"
"25423","(۲۵۴۲۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ؛ فِی الَّذِی یَمْشِی فِی نَعْلٍ وَاحِدَۃٍ ، قَالَ : یَکْرَہُونَہُ ، وَیَقُولُونَ : لاَ ، وَلاَ خُطْوَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 25423","","","كتاب اللباس"
"25424","(۲۵۴۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إِبْرَاہِیمَ بن طَہْمَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : لاَ تَمْشِ فِی النَّعْلِ الْوَاحِدَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 25424","","","كتاب اللباس"
"25425","(۲۵۴۲۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : إِذَا انْقَطَعَ شِسْعُ أَحَدِکُمْ ، فَلاَ یَمْشِی فِی النَّعْلِ الْوَاحِدَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 25425","","","كتاب اللباس"
"25426","(۲۵۴۲۶) حَدَّثَنَا أَبُو دَاوُدَ الْحَفَرِی ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ انْقَطَعَ شِسْعُہُ ، فَخَلَعَ نَعْلَہُ حَتَّی أَصْلَحَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25426","","","كتاب اللباس"
"25427","(۲۵۴۲۷) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ رَجُلٍ مِنْ مُزَیْنَۃَ ، قَالَ : رَأَیْتُ عَلِیًّا یَمْشِی فِی نَعْلٍ وَاحِدَۃٍ بِالْمَدَائِنِ ، کَانَ یُصْلِحُ شِسْعَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 25427","","","كتاب اللباس"
"25428","(۲۵۴۲۸) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَمْشِیَ فِی نَعْلٍ وَاحِدَۃٍ إِذَا انْقَطَعَ شِسْعُہُ ، مَا بَیْنَہُ وَبَیْنَ أَنْ یُصْلِحَ شِسْعَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 25428","","","كتاب اللباس"
"25429","(۲۵۴۲۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ؛ أَنَّ عَائِشَۃَ کَانَتْ تَمْشِی فِی خُفٍّ وَاحِدَۃٍ ، وَتَقُولُ : لأَحنِقَنَّ أَبَا ہُرَیْرَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 25429","","","كتاب اللباس"
"25430","(۲۵۴۳۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ زَیْدِ بْنِ مُحَمَّدٍ ؛ أَنَّہُ رَأَی سَالِمَ بْنَ عَبْدِ اللہِ یَمْشِی فِی نَعْلٍ وَاحِدَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 25430","","","كتاب اللباس"
"25431","(۲۵۴۳۱) حَدَّثَنَا مُعَاذُ بن مُعَاذٌ، عَنِ ابْنِ عَوْنٍ، قَالَ: ذُکِرَ عِنْدَ مُحَمَّدٍ انْتِعَالُ الرَّجُلِ قَائِمًا، فَقَالَ: لاَ أَعْلَمُ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 25431","","","كتاب اللباس"
"25432","(۲۵۴۳۲) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُقْبَۃَ ، قَالَ : رَأَیْتُ إِبْرَاہِیمَ یُدْخِلُ رِجْلَیْہِ فِی نَعْلَیْہِ وَہُوَ قَائِمٌ۔","","Musannaf Ibn Abi Shaybah 25432","","","كتاب اللباس"
"25433","(۲۵۴۳۳) حَدَّثَنَا وَکِیعٌ ، عَنِ سُفیَان ، عَنِ الأَعْمَشِ ، قَالَ : رَأَیْتُ یَحیَی بن وَثَّاب یَنْتَعِلُ قَائِمًا۔","","Musannaf Ibn Abi Shaybah 25433","","","كتاب اللباس"
"25434","(۲۵۴۳۴) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، قَالَ : رَأَیْتُ الْحَسَنَ یَنْتَعِلُ قَائِمًا۔","","Musannaf Ibn Abi Shaybah 25434","","","كتاب اللباس"
"25435","(۲۵۴۳۵) بَلَّغَنِی عَن حَفْصٍ ، عَنِ الأَعْمَشِ ، قَالَ : بَلَغَنَا أَنَّ عَلِیًّا انْتَعَلَ قَائِمًا۔","","Musannaf Ibn Abi Shaybah 25435","","","كتاب اللباس"
"25436","(۲۵۴۳۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّہُ کُرِہَ أَنْ یَنْتَعِلَ الرَّجُلُ قَائِمًا۔ (ابن ماجہ ۳۶۱۸)","Sahih","Musannaf Ibn Abi Shaybah 25436","","","كتاب اللباس"
"25437","(۲۵۴۳۷) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ نَعْلَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ لَہَا قِبَالاَنِ ، وَنَعْلُ أَبِی بَکْرٍ ، وَعُمَرَ۔ (ترمذی ۸۶۔ بزار ۲۹۶۱)","","Musannaf Ibn Abi Shaybah 25437","","","كتاب اللباس"
"25438","(۲۵۴۳۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : کَانَ لِنَعْلِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قِبَالاَنِ۔ (ابن ماجہ ۳۶۱۵۔ احمد ۳/۱۲۲)","Sahih","Musannaf Ibn Abi Shaybah 25438","","","كتاب اللباس"
"25439","(۲۵۴۳۹) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ نَعْلَ ابْنِ عُمَرَ لَہَا قِبَالاَنِ۔","Sahih","Musannaf Ibn Abi Shaybah 25439","","","كتاب اللباس"
"25440","(۲۵۴۴۰) حَدَّثَنَا شَرِیکٌ، عَنْ جَابِر، عَنْ أَبِی جَعْفَرٍ، قَالَ: کَانَ حَذْوُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُخَصَّرَتَیْنِ مُعَقِّبَتَیْنِ۔ (ابن سعد ۴۷۸)","Da'if","Musannaf Ibn Abi Shaybah 25440","","","كتاب اللباس"
"25441","(۲۵۴۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : کَانَتْ نَعْلُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَہَا شِرَاکَانِ ، قِبَالاَنِ ، مُثْنِیٌّ شِرَاکُہُمَا۔ (ترمذی ۷۶۔ ابن سعد ۴۷۸)","","Musannaf Ibn Abi Shaybah 25441","","","كتاب اللباس"
"25442","(۲۵۴۴۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا الْحَسَنُ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، قَالَ : رَأَیْتُ نَعْلَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْمَدِینَۃِ مُخَصَّرَۃً ، مُلَسَّنَۃً ، لَہَا عَقِبٌ خَارِجٌ۔ (ابن سعد ۴۷۸)","Hasan","Musannaf Ibn Abi Shaybah 25442","","","كتاب اللباس"
"25443","(۲۵۴۴۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ؛ سَمِعَ عَامِرَ بْنَ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، قَالَ : حدَّثَتْنِی رَیْحَانَۃُ ؛ أَنَّ أَہْلَہَا أَرْسَلُوہَا وَمَعَہَا صَبِیٌّ عَلَیْہِ أَجْرَاسٌ ، فَقَالَ : أَخْبِرِی أَہْلَکِ أَنَّ ہَذَا یَتْبَعُہُ الشَّیْطَانُ۔","Da'if","Musannaf Ibn Abi Shaybah 25443","","","كتاب اللباس"
"25444","(۲۵۴۴۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَتَیْتُ عَبْدَ الرَّحْمَن بْنَ أَبِی لَیْلَی وَمَعِیَ تِبْرٌ ، فَقَالَ : أَتُرِیدُ أَنْ تُحَلِّیَ بِہِ مُصْحَفًا ؟ قُلْتُ : لاَ ، قَالَ : تُحَلِّیَ بِہِ سَیْفًا ؟ قَالَ : قُلْتُ : أُحَلِّیَ بِہِ ابْنَتِی ، قَالَ : ہَلْ عَسَیْتَ أَنْ تَجْعَلَہَا أَجْرَاسًا ؟ فَإِنَّہَا تُکْرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25444","","","كتاب اللباس"
"25445","(۲۵۴۴۵) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَنَشٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ وَأُتِیَ بِصَبِیٍّ عَلَیْہِ أَوْضَاحٌ ، فَجَعَلَ یُہَازِلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25445","","","كتاب اللباس"
"25446","(۲۵۴۴۶) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أُدْخِلَتْ عَلَی عَائِشَۃَ صَبِیَّۃٌ عَلَیْہَا جَلاَجِلُ ، فَقَالَتْ : مَا لِی أَرَاکِ مُنَفِّرَۃَ الْمَلاَئِکَۃِ ؟ أَخْرِجُوہَا عَنِّی۔","Da'if","Musannaf Ibn Abi Shaybah 25446","","","كتاب اللباس"
"25447","(۲۵۴۴۷) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : نُبِّئْتُ أَنَّ مُحَمَّدًا کَانَ یَقْطَعُ الْجَلاَجِلَ الَّتِی تَکُونُ عَلَی الصِّبْیَانِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25447","","","كتاب اللباس"
"25448","(۲۵۴۴۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : حَلَّی إِبْرَاہِیمُ بِنْتَیْنِ لَہُ صَغِیرَتَیْنِ جَلاَجِلَ مِنْ ذَہَبٍ یُصَوِّتْنَ۔","","Musannaf Ibn Abi Shaybah 25448","","","كتاب اللباس"
"25449","(۲۵۴۴۹) حَدَّثَنَا أَصْحَابُنَا ، عَنْ حَفْصٍ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، قَالَ : دَخَلْتُ عَلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فَرَأَیْتُ ابْنَتَیْنِ لَہُ ، وَعَلَیْہِمَا أَوْضَاحٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 25449","","","كتاب اللباس"
"25450","(۲۵۴۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مُسَاوِرٍ ، عَنْ جَعْفَرِ بْنِ عَمْرِو بْنِ حُرَیْثٍ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَ وَعَلَیْہِ عِمَامَۃٌ سَوْدَائُ۔ (احمد ۴/۳۰۷۔ ابن سعد ۴۵۵)","Sahih","Musannaf Ibn Abi Shaybah 25450","","","كتاب اللباس"
"25451","(۲۵۴۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ ، عَنْ أَبِی جَعْفَرٍ الأَنْصَارِیِّ ، قَالَ : رَأَیْتُ عَلَی عَلِیٍّ عِمَامَۃً سَوْدَائَ یَوْمَ قُتِلَ عُثْمَانُ۔","Sahih","Musannaf Ibn Abi Shaybah 25451","","","كتاب اللباس"
"25452","(۲۵۴۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَخَلَ مَکَّۃَ وَعَلَیْہِ عِمَامَۃٌ سَوْدَائُ۔ (ترمذی ۱۷۳۵۔ ابوداؤد ۴۰۷۳)","Sahih","Musannaf Ibn Abi Shaybah 25452","","","كتاب اللباس"
"25453","(۲۵۴۵۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو الْعَنْبَسِ عَمْرُو بْنُ مَرْوَانَ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ عَلَی عَلِیٍّ عِمَامَۃً سَوْدَائَ ، قَدْ أَرْخَی طَرَفَہَا مِنْ خَلْفِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 25453","","","كتاب اللباس"
"25454","(۲۵۴۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الْفَضْلِ ، عَنِ الْحَسَنِ ، قَالَ : کَانَتْ عِمَامَۃُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَوْدَائَ۔","Hasan","Musannaf Ibn Abi Shaybah 25454","","","كتاب اللباس"
"25455","(۲۵۴۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ بْنِ وَرْدَانَ ، قَالَ : رَأَیْتُ عَلَی أَنَسٍ عِمَامَۃً سَوْدَائَ عَلَی غَیْرِ قَلَنْسُوَۃٍ ، قَدْ أَرْخَاہَا مِنْ خَلْفِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 25455","","","كتاب اللباس"
"25456","(۲۵۴۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا عَاصِمُ بن مُحَمَّد ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ ابْنَ الزُّبَیْرِ اعْتَمَّ بِعِمَامَۃٍ سَوْدَائَ ، قَدْ أَرْخَاہَا مِنْ خَلْفِہِ نَحْوًا مِنْ ذِرَاعٍ۔","Sahih","Musannaf Ibn Abi Shaybah 25456","","","كتاب اللباس"
"25457","(۲۵۴۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُثْمَانُ بْنُ أَبِی ہِنْدٍ ، قَالَ : رَأَیْتُ عَلَی أَبِی عُبَیْدۃ عِمَامَۃً سَوْدَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 25457","","","كتاب اللباس"
"25458","(۲۵۴۵۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سِمَاکٍ ، عَنْ مِلْحَانَ بْنِ ثَرْوَانَ ، قَالَ : رَأَیْتُ عَلَی عَمَّارٍ عِمَامَۃً سَوْدَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 25458","","","كتاب اللباس"
"25459","(۲۵۴۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا دِینَارُ أَبُو عُمَر ، قَالَ : رَأَیْتُ عَلَی الْحَسَنِ عِمَامَۃً سَوْدَائَ۔","","Musannaf Ibn Abi Shaybah 25459","","","كتاب اللباس"
"25460","(۲۵۴۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْحَسَنُ بْنُ صَالِحٍ ، عَنْ جَابِرٍ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی عَلِیًّا قَدِ اعْتَمَّ بِعِمَامَۃٍ سَوْدَائَ ، قَدْ أَرْخَاہَا مِنْ بَیْنِ یَدَیْہِ وَمِنْ خَلْفِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 25460","","","كتاب اللباس"
"25461","(۲۵۴۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ أَبِی صَخْرَۃَ ، قَالَ : رَأَیْتُ عَلَی عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ عِصَابَۃً سَوْدَائَ۔","","Musannaf Ibn Abi Shaybah 25461","","","كتاب اللباس"
"25462","(۲۵۴۶۲) حَدَّثَنَا جَرِیرٌ ، عَنْ یَعْقُوبَ ، عَنْ جَعْفَرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : کَانَتْ عِمَامَۃُ جِبْرِیلَ یَوْمَ غَرِقَ فِرْعَوْنُ سَوْدَائَ۔","No Data Available","Musannaf Ibn Abi Shaybah 25462","","","كتاب اللباس"
"25463","(۲۵۴۶۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ أَیْمَنَ ، قَالَ : رَأَیْتُ عَلَی ابْنِ الْحَنَفِیَّۃِ عِمَامَۃً سَوْدَائَ۔","","Musannaf Ibn Abi Shaybah 25463","","","كتاب اللباس"
"25464","(۲۵۴۶۴) حَدَّثَنَا الْبَکْرَاوِیُّ ، عَنْ أَبِی عِیسَی ، عَنْ أَبِیہِ زِیَادٍ ، قَالَ : قَدِمَ شَیْخٌ ، یُقَالَ لَہُ : سَالِمٌ ، قَالَ : رَأَیْتُ عَلَی أَبِی الدَّرْدَائِ عِمَامَۃً سَوْدَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 25464","","","كتاب اللباس"
"25465","(۲۵۴۶۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : رَأَیْتُ عَلَی الأَسْوَدِ عِمَامَۃً سَوْدَائَ۔","","Musannaf Ibn Abi Shaybah 25465","","","كتاب اللباس"
"25466","(۲۵۴۶۶) حَدَّثَنَا عُبَیْد اللہِ ، قَالَ : أَخْبَرَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَخَلَ مَکَّۃَ یَوْمَ الْفَتْحِ وَعَلَیْہِ شِقۃ سَوْدَائَ۔ (ابن ماجہ ۳۵۸۶)","Da'if","Musannaf Ibn Abi Shaybah 25466","","","كتاب اللباس"
"25467","(۲۵۴۶۷) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا شَرِیکٌ ، قَالَ : حَدَّثَنَا حَزَنٌ الْخَثْعَمِیُّ ، قَالَ : رَأَیْتُ عَلَی الْبَرَائِ عِمَامَۃً سَوْدَائَ۔","Hasan","Musannaf Ibn Abi Shaybah 25467","","","كتاب اللباس"
"25468","(۲۵۴۶۸) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ شَرِیکٍ ، عَنْ مُخَارِقٍ ، عَنْ عَطَائٍ ، قَالَ : رَأَیْتُ عَلَی عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ عِمَامَۃً سَوْدَائَ۔","Hasan","Musannaf Ibn Abi Shaybah 25468","","","كتاب اللباس"
"25469","(۲۵۴۶۹) حَدَّثَنَا مَعَنٌ ، عَنْ حُسَیْنِ بْنِ یُونُسَ ، قَالَ : رَأَیْتُ عَلَی وَاثِلَۃَ عِمَامَۃً سَوْدَائَ۔","","Musannaf Ibn Abi Shaybah 25469","","","كتاب اللباس"
"25470","(۲۵۴۷۰) حَدَّثَنَا شَاذَانُ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ عَاصِمٍ ، عَنْ أَبِی رَزِینٍ ، قَالَ : خَطَبَنَا الْحَسَنُ بْنُ عَلِیٍّ یَوْمَ الْجُمُعَۃِ وَعَلَیْہِ عِمَامَۃٌ سَوْدَائُ۔","Hasan","Musannaf Ibn Abi Shaybah 25470","","","كتاب اللباس"
"25471","(۲۵۴۷۱) حَدَّثَنَا شَبَابَۃُ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ ، قَالَ : رَأَیْتُ أَبَا نَضْرَۃَ وَعَلَیْہِ عِمَامَۃٌ سَوْدَائُ۔","","Musannaf Ibn Abi Shaybah 25471","","","كتاب اللباس"
"25472","(۲۵۴۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْحَسَنُ بْنُ صَالِحٍ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ عَلَی الشَّعْبِیِّ عِمَامَۃً بَیْضَائَ ، قَدْ أَرْخَی طَرَفَہَا وَلَمْ یُرْسِلْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25472","","","كتاب اللباس"
"25473","(۲۵۴۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْمَاعِیلُ بْنُ عَبْدِ الْمَلِکِ ، قَالَ : رَأَیْتُ عَلَی سَعِیدِ بْنِ جُبَیْرٍ عِمَامَۃً بَیْضَائَ۔","","Musannaf Ibn Abi Shaybah 25473","","","كتاب اللباس"
"25474","(۲۵۴۷۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : رَأَیْتُ الأَحْنَفَ وَاقِفًا عَلَی بَغْلَۃٍ ، وَرَأَیْتُ عَلَیْہِ عِمَامَۃَ خَزٍّ۔","","Musannaf Ibn Abi Shaybah 25474","","","كتاب اللباس"
"25475","(۲۵۴۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ السَّلاَمِ بْنِ شَدَّادٍ أَبِی طَالُوتَ ، قَالَ : رَأَیْتُ عَلَی أَنَسِ بْنِ مَالِکٍ عِمَامَۃَ خَزٍّ۔","Sahih","Musannaf Ibn Abi Shaybah 25475","","","كتاب اللباس"
"25476","(۲۵۴۷۶) حَدَّثَنَا عَبَّادٌ ، عَنِ ابْنِ عَوْنٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 25476","","","كتاب اللباس"
"25477","(۲۵۴۷۷) حَدَّثَنَا أَبُو أُسَامَۃَ، قَالَ: أَخْبَرَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ، عَنْ نَافِعٍ، قَالَ: کَانَ ابْنُ عُمَرَ یَعْتَمُّ، وَیُرْخِیہَا بَیْنَ کَتِفَیْہِ۔n قَالَ عُبَیْدُاللہِ: أَخْبَرَنَا أَشْیَاخُنَا أَنَّہُمْ رَأَوْا أَصْحَابَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَعْتَمُّونَ وَیُرْخُونَہَا بَیْنَ أَکْتَافِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 25477","","","كتاب اللباس"
"25478","(۲۵۴۷۸) حَدَّثَنَا عَبْدَۃ ، عَنْ ہِشَامٍ ، قَالَ : رَأَیْتُ ابْنَ الزُّبَیْرِ مُعْتَمًّا ، قَدْ أَرْخَی طَرَفَیِ الْعِمَامَۃِ بَیْنَ یَدَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 25478","","","كتاب اللباس"
"25479","(۲۵۴۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعَنْبَسِ عَمْرِو بْنِ مَرْوَانَ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ عَلَی عَلِیٍّ رضی اللَّہُ عَنْہُ عِمَامَۃً قَدْ أَرْخَی طَرَفَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 25479","","","كتاب اللباس"
"25480","(۲۵۴۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ بْنِ وَرْدَانَ ، قَالَ : رَأَیْتُ عَلَی أَنَسٍ عِمَامَۃً قَدْ أَرْخَاہَا مِنْ خَلْفِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 25480","","","كتاب اللباس"
"25481","(۲۵۴۸۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُسَاوِرٍ ، قَالَ : حدَّثَنِی جَعْفَرُ بْنُ عَمْرِو بْنِ حُرَیْثٍ ، عَنْ أَبِیہِ ، قَالَ : کَأَنِّی أَنْظُرُ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَعَلَیْہِ عِمَامَۃٌ سَوْدَائُ ، قَدْ أَرْخَی طَرَفَیْہَا بَیْنَ کَتِفَیْہِ۔n(مسلم ۴۵۳۔ ابوداؤد ۴۰۷۴)","Sahih","Musannaf Ibn Abi Shaybah 25481","","","كتاب اللباس"
"25482","(۲۵۴۸۲) حَدَّثَنَا شَرِیکٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ مُعْتَمًّا قَدْ أَرْخَی الْعِمَامَۃَ مِنْ بَیْنِ یَدَیْہِ وَمِنْ خَلْفِہِ ، وَلاَ أَدْرِی أَیّہمَا أَطْوَلُ۔","Hasan","Musannaf Ibn Abi Shaybah 25482","","","كتاب اللباس"
"25483","(۲۵۴۸۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوزَعی ، عَن مَکْحُول ، قَالَ : رَأَیْتُہ یَعتَمُّ وَلاَ یَرخِی طَرْفَ العمَامَۃ۔","","Musannaf Ibn Abi Shaybah 25483","","","كتاب اللباس"
"25484","(۲۵۴۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ ، قَالَ : رَأَیْتُ عَلَی شُرَیْحٍ عِمَامَۃً قَدْ أَرْخَاہَا مِنْ خَلْفِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25484","","","كتاب اللباس"
"25485","(۲۵۴۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ سَالِمٍ ، وَالْقَاسِمِ ؛ کَانَا یُرْخِیَانِ عَمَائِمَہُمْ بَیْنَ أَکْتَافِہِمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 25485","","","كتاب اللباس"
"25486","(۲۵۴۸۶) حَدَّثَنَا شَبَابَۃُ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ ، قَالَ : رَأَیْتُ أَبَا نَضْرَۃَ یَعْتَمُّ بِعِمَامَۃٍ سَوْدَائَ قَدْ أَرْخَاہَا مِنْ تَحْت عنقِہِ۔","","Musannaf Ibn Abi Shaybah 25486","","","كتاب اللباس"
"25487","(۲۵۴۸۷) حَدَّثَنَا شَبَابَۃُ ، عَنْ سُلَیْمَانَ ، قَالَ : رَأَیْتُ الْحَسَنَ یَعْتَمُّ بِعِمَامَۃٍ سَوْدَائَ قَدْ أَرْخَی طَرَفَہَا خَلْفَہُ۔","","Musannaf Ibn Abi Shaybah 25487","","","كتاب اللباس"
"25488","(۲۵۴۸۸) حَدَّثَنَا شَرِیکٌ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : رَأَیْتُ شُرَیْحًا یَعْتَمُّ بِکَوْرٍ وَاحِدٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 25488","","","كتاب اللباس"
"25489","(۲۵۴۸۹) حَدَّثَنَا سُلَیْمَانُ بْنُ حَرْبٍ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ یَعْلَی بْنِ حَکِیمٍ ، عَنْ سُلَیْمَانَ بْنِ أَبِی عَبْدِ اللہِ ، قَالَ : أَدْرَکْتُ الْمُہَاجِرِینَ الأَوَّلِینَ یَعْتَمُّونَ بِعَمَائِمَ کَرَابِیسَ سُودٍ ، وَبِیضٍ ، وَحُمْرٍ ، وَخُضْرٍ ، وَصُفْرٍ ، یَضَعُ أَحَدُہُم الْعِمَامَۃَ عَلَی رَأْسِہِ ، وَیَضَعُ الْقَلَنْسُوَۃَ فَوْقَہَا ، ثُمَّ یُدِیرُ الْعِمَامَۃَ ہَکَذَا ، یَعْنِی عَلَی کَوْرِہِ ، لاَ یُخْرِجُہَا مِنْ تَحْتِ ذَقَنِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 25489","","","كتاب اللباس"
"25490","(۲۵۴۹۰) حَدَّثَنَا شَرِیکٌ، عَنِ الأَعْمَشِ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ، قَالَ: رَأَیْتُ زَیْدَ بْنَ ثَابِتٍ وَعَلَیْہِ إِزَارٌ، وَرِدَائٌ، وَعِمَامَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 25490","","","كتاب اللباس"
"25491","(۲۵۴۹۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أُسَامَۃَ بن زید ؛ کَانَ یَکْرَہُ أَنْ یَعْتَمَّ إِلاَّ أَنْ یَجْعَلَ تَحْتَ لِحْیَتِہِ وَحَلْقِہِ مِنَ الْعِمَامَۃِ۔","","Musannaf Ibn Abi Shaybah 25491","","","كتاب اللباس"
"25492","(۲۵۴۹۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ زَیْدِ بْنِ جُبَیْرٍ ؛ رَأَیْتُ عَلَی عَبْدِ اللہِ بْنِ الزُّبَیْرِ بُرْطَلَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 25492","","","كتاب اللباس"
"25493","(۲۵۴۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : رَأَیْتُ عَلَی ابْنِ الزُّبَیْرِ قَلَنْسُوَۃً لَہَا رَفٌّ ، یَعْنِی بُرْطَلَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 25493","","","كتاب اللباس"
"25494","(۲۵۴۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عِیسَی بْنِ طَہْمَانَ ، قَالَ : رَأَیْتُ عَلَی أَنَسِ بْنِ مَالِکٍ بُرْنُسًا۔","Sahih","Musannaf Ibn Abi Shaybah 25494","","","كتاب اللباس"
"25495","(۲۵۴۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ ، قَالَ : رَأَیْتُ عَلَی شُرَیْحٍ بُرْنُسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 25495","","","كتاب اللباس"
"25496","(۲۵۴۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی شِہَابٍ ، قَالَ : رَأَیْتُ عَلَی سَعِیدِ بْنِ جُبَیْرٍ بُرْنُسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 25496","","","كتاب اللباس"
"25497","(۲۵۴۹۷) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ حَبِیبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ (ح) وَعَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالاَ : الْبَسِ الثَّعَالِبَ ، وَلاَ تُصَلِّ فِیہَا۔","","Musannaf Ibn Abi Shaybah 25497","","","كتاب اللباس"
"25498","(۲۵۴۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَدیْرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : کَانَ لِعَلِیِّ بْنِ حُسَیْنٍ سَبَنْجُونَۃُ ثَعَالِبَ۔","","Musannaf Ibn Abi Shaybah 25498","","","كتاب اللباس"
"25499","(۲۵۴۹۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَجْلَحِ ، قَالَ : رَأَیْتُ عَلَی الضَّحَّاکِ قَلَنْسُوَۃَ ثَعَالِبَ۔","","Musannaf Ibn Abi Shaybah 25499","","","كتاب اللباس"
"25500","(۲۵۵۰۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، قَالَ : رَأَیْتُ عَلَی إِبْرَاہِیمَ قَلَنْسُوَۃً مَکْفُوفَۃً بِثَعَالِبَ ، أَوْ سُمُورٍ۔","","Musannaf Ibn Abi Shaybah 25500","","","كتاب اللباس"
"25501","(۲۵۵۰۱) حَدَّثَنَا ابْنُ عُیینۃ ، عَنِ الزُّہْرِیِّ ؛ سَمِعَ أَبَا سَلَمَۃَ ، وَسُلَیْمَانَ بْنَ یَسَارٍ یُخْبِرَانِ عَنْ أَبِی ہُرَیْرَۃَ ، یَبْلُغُ بِہِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ: إِنَّ الْیَہُودَ وَالنَّصَارَی لاَ یَصْبِغُونَ فَخَالِفُوہُمْ۔ (مسلم ۸۰۔ ابن ماجہ ۳۶۲۱)","Sahih","Musannaf Ibn Abi Shaybah 25501","","","كتاب اللباس"
"25502","(۲۵۵۰۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : جِیئَ بِأَبِی قُحَافَۃَ یَوْمَ الْفَتْحِ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَکَأَنَّ رَأْسَہُ ثَغَامَۃٌ فَقَالَ : اذْہَبُوا بِہِ إلَی بَعْضِ نِسَائِہِ فَلْیُغَیِّرُوہُ ، وَجَنِّبُوہُ السَّوَادَ۔n(مسلم ۱۶۶۳۔ ابوداؤد ۴۲۰۱)","Da'if","Musannaf Ibn Abi Shaybah 25502","","","كتاب اللباس"
"25503","(۲۵۵۰۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَجْلَحِ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، عَنْ أَبِی الأَسْوَدِ الدُّؤَلِیِّ ، عَنْ أَبِی ذَرٍّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ أَحْسَنَ مَا غَیَّرْتُمْ بِہِ الشَّیْبَ الْحِنَّائُ وَالْکَتَمُ۔n(ترمذی ۱۷۵۳۔ احمد ۵/۱۵۰)","Da'if","Musannaf Ibn Abi Shaybah 25503","","","كتاب اللباس"
"25504","(۲۵۵۰۴) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ طَلْحَۃَ ، عَنْ حُمَیْدِ بْنِ وَہْبٍ ، عَنْ طَاوُوسٍ ، أَوِ ابْنِ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَرَّ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلٌ قَدْ خَضَّبَ بِالْحِنَّائِ فَقَالَ : مَا أَحْسَنَ ہَذَا ، ثُمَّ مَرَّ عَلَیْہِ آخَرُ قَدْ خَضَّبَ بِالْحِنَّائِ وَالْکَتَمِ فَقَالَ : ہَذَا أَحْسَنُ مِنْ ہَذَا ، قَالَ : ثُمَّ مَرَّ عَلَیْہِ آخَرُ خَضَّبَ بِصُفْرَۃٍ ، قَالَ : ہَذَا أَحْسَنُ مِنْ ہَذَا کُلِّہِ ، قَالَ : وَکَانَ طَاوُوسٌ یُصَفِّرُ۔n(ابوداؤد ۴۲۰۸۔ ابن سعد ۴۴۰)","Da'if","Musannaf Ibn Abi Shaybah 25504","","","كتاب اللباس"
"25505","(۲۵۵۰۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ ، عَنْ أَبِی جَعْفَرٍ الأَنْصَارِیِّ ، قَالَ : رَأَیْتُ أَبَا بَکْرٍ لِکَأَنَّ رَأْسَہُ وَلِحْیَتَہُ کَأَنَّہُمَا جَمْرُ الْغَضَی۔","Sahih","Musannaf Ibn Abi Shaybah 25505","","","كتاب اللباس"
"25506","(۲۵۵۰۶) حَدَّثَنَا حَفْصٌ ، عَنِ الأَشْعَث ، عَنِ الْحَسَنِ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَفْضَلُ مَا غَیَّرْتُمْ بِہِ الشَّیْبَ الْحِنَّائُ وَالْکَتَمُ۔","Da'if","Musannaf Ibn Abi Shaybah 25506","","","كتاب اللباس"
"25507","(۲۵۵۰۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : رَأَیْتُ ابْنَ الْحَنَفِیَّۃِ وَإِنَّ رَأْسَہُ وَلِحْیَتَہُ قَانِیَتَانِ قَدْ خَضَّبَہُمَا بِالْحِنَّائِ وَالْکَتَمِ۔","","Musannaf Ibn Abi Shaybah 25507","","","كتاب اللباس"
"25508","(۲۵۵۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : رَأَیْتُ عَبْدَ اللہِ بْنَ أَبِی أَوْفَی لَہُ ظُفْرَانِ مَصْبُوغَانِ بِالْحِنَّائِ۔","Sahih","Musannaf Ibn Abi Shaybah 25508","","","كتاب اللباس"
"25509","(۲۵۵۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، قَالَ : رَأَیْتُ أَنَسًا یُخَضِّبُ بِالْحِنَّائِ۔","Sahih","Musannaf Ibn Abi Shaybah 25509","","","كتاب اللباس"
"25510","(۲۵۵۱۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، قَالَ : قُلْتُ لأَبِی جَعْفَرٍ : ہَلْ خَضَّبَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : قَدْ مَسَّ شَیْئًا مِنَ الْحِنَّائِ وَالْکَتَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 25510","","","كتاب اللباس"
"25511","(۲۵۵۱۱) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا سَلاَّمُ بْنُ أَبِی مُطِیعٍ ، عَنْ عثْمَانَ بْنِ مَوْہَبٍ ، قَالَ : دَخَلْتُ عَلَی أُمِّ سَلَمَۃَ فَأَخْرَجَتْ إلَیَّ شَعْرًا مِنْ شَعْرِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَخْضُوبًا بِالْحِنَّائِ وَالْکَتَمِ۔n(ابن ماجہ ۲۶۲۳۔ ابن سعد ۴۳۷)","Sahih","Musannaf Ibn Abi Shaybah 25511","","","كتاب اللباس"
"25512","(۲۵۵۱۲) حَدَّثَنَا وَکِیعٌ ، عَنِ ابن نَابِل قَالَ : رَأَیت طَاووسًا یُخَضِّبُ بِالْحِنَّائِ۔","","Musannaf Ibn Abi Shaybah 25512","","","كتاب اللباس"
"25513","(۲۵۵۱۳) حَدَّثَنَا ابْنُ فَضْلٍ ، عَنْ حُصَیْنٍ ، عَنْ مُغِیرَۃَ بْنِ شُبَیْلٍ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، قَالَ : کَانَ أَبُو بَکْرٍ یَخْرُجُ إلَیْنَا ، وَکَأَنَّ لِحْیَتَہُ ضِرَامُ عَرْفَجٍ مِنَ الْحِنَّائِ وَالْکَتَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 25513","","","كتاب اللباس"
"25514","(۲۵۵۱۴) حَدَّثَنَا شَرِیکٌ ، عَنْ سُلَیْمَانَ الْمُقْعَد ، عَنْ عَامِرٍ ، قَالَ : إنَّمَا خَضَّبَ عَلِیٌّ مَرَّۃً۔","Da'if","Musannaf Ibn Abi Shaybah 25514","","","كتاب اللباس"
"25515","(۲۵۵۱۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا إسْمَاعِیلُ ، قَالَ : رَأَیْتُ أَنَسَ بْنَ مَالِکٍ ، وَعَبْدَ اللہِ بْنَ أَبِی أَوْفَی وَخِضَابُہُمَا أَحْمَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 25515","","","كتاب اللباس"
"25516","(۲۵۵۱۶) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْعَیْزَارِ بْنِ حُرَیْثٍ ، قَالَ : کَانَ الْحُسَیْنُ بْنُ عَلِیٍّ یُخَضِّبُ بِالْحِنَّائِ وَالْکَتَمِ۔","Hasan","Musannaf Ibn Abi Shaybah 25516","","","كتاب اللباس"
"25517","(۲۵۵۱۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُثْمَانُ بْنُ حَکِیمٍ ، قَالَ : رَأَیْتُ عِنْدَ آلِ أَبِی عُبَیْدَۃَ بْنِ عَبْدِ اللہِ بْنِ زَمْعَۃَ شَعَرَاتٍ مِنْ شَعْرِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَصْبُوغًا بِالْحِنَّائِ۔ (ابن سعد ۴۳۷)","","Musannaf Ibn Abi Shaybah 25517","","","كتاب اللباس"
"25518","(۲۵۵۱۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، أَنَّ عَبْدَ الرَّحْمَن بْنِ الأَسْوَدِ بْنِ عَبْدِ یَغُوثَ وَکَانَ جَلِیسًا لَہُمْ وَکَانَ أَبْیَضَ الرَّأْسِ وَاللِّحْیَۃِ ، فَغَدَا عَلَیْہِمْ ذَاتَ یَوْمٍ وَقَدْ حَمَّرَہَا فَقَالَ لَہُ : الْقَوْمُ : ہَذَا أَحْسَنُ ، فَقَالَ : إنَّ أُمِّی عَائِشَۃَ أَرْسَلَتْ إلَیَّ الْبَارِحَۃَ جَارِیَتَہَا فَأَقْسَمَتْ عَلَیَّ لاَصْبُغَنَّ ، وَأَخْبَرَتْنِی ، أَنَّ أَبَا بَکْرٍ کَانَ یَصْبُغُ۔","Sahih","Musannaf Ibn Abi Shaybah 25518","","","كتاب اللباس"
"25519","(۲۵۵۱۹) حَدَّثَنَا عُبَیْدُ اللہِ، قَالَ: أَخْبَرَنَا حَسَنٌ، عَنْ سِمَاکٍ، عَنْ عِکْرِمَۃَ، قَالَ: رَأَیْتُ، ثُمُودَ فَرَأَیْتُ مُخَضَّبَۃً لِحَاہُمْ۔","","Musannaf Ibn Abi Shaybah 25519","","","كتاب اللباس"
"25520","(۲۵۵۲۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ قَیْسٍ مَوْلَی خَبَّابٍ ، قَالَ : دَخَلْتُ عَلَی الْحَسَنِ وَالْحُسَیْنِ وَہُمَا یُخَضِّبَانِ بِالسَّوَادِ۔","Da'if","Musannaf Ibn Abi Shaybah 25520","","","كتاب اللباس"
"25521","(۲۵۵۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ عَمْرِو بْنِ عُثْمَانَ ، قَالَ : رَأَیْتُ مُوسَی بْنَ طَلْحَۃَ یَخْتَضِبُ بِالْوَسْمَۃِ۔","","Musannaf Ibn Abi Shaybah 25521","","","كتاب اللباس"
"25522","(۲۵۵۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عُبَبْداللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ مَوْہَبٍ، قَالَ: رَأَیْتُ نَافِعَ بْنَ جُبَیْرٍ یَخْتَضِبُ بِالسَّوَادِ۔","","Musannaf Ibn Abi Shaybah 25522","","","كتاب اللباس"
"25523","(۲۵۵۲۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ یُونس ، عَنِ الحَسن أَنَّہ کَان لاَ یَرَی بَأْسًا بِالخِضَاب بِالسَّوَادِ۔","","Musannaf Ibn Abi Shaybah 25523","","","كتاب اللباس"
"25524","(۲۵۵۲۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانُوا یَسْأَلُونَ مُحَمَّدًا ، عَنِ الْخِضَابِ بِالسَّوَادِ فَقَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 25524","","","كتاب اللباس"
"25525","(۲۵۵۲۵) حَدَّثَنَا وَکِیعٌ، وَابْنُ مَہْدِیٍّ، عَنْ سُفْیَانَ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ، عَن أَبِی سَلَمَۃَ، أَنَّہُ کَانَ یُخَضِّبُ بِالسَّوَادِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25525","","","كتاب اللباس"
"25526","(۲۵۵۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِالْوَسْمَۃِ ، إنَّمَا ہِیَ بَقْلَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 25526","","","كتاب اللباس"
"25527","(۲۵۵۲۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، قَالَ : سَأَلْتُ ابْنَ الْحَنَفِیَّۃِ ، عَنِ الْخِضَابِ بِالْوَسْمَۃِ فَقَالَ : ہِیَ خِضَابُنَا أَہْلَ الْبَیْتِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25527","","","كتاب اللباس"
"25528","(۲۵۵۲۸) حَدَّثَنَا حَفْصٌ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ : کَانَ أَبُو جَعْفَرٍ یَخْتَضِبُ بِثُلُثَیْ حِنَّائٍ وَثُلُثِ وَسْمَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 25528","","","كتاب اللباس"
"25529","(۲۵۵۲۹) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، قَالَ : حَدَّثَنَا أَبُو عُشَانَۃَ الْمَعَافِرِیُّ ، قَالَ : رَأَیْتُ عُقْبَۃَ بْنَ عَامِرٍ یُخَضِّبُ بِالسَّوَادِ وَیَقُولُ : نُسَوِّدُ أَعْلاَہَا وَتَأْبَی أُصُولُہَا۔ (ابن سعد ۳۴۳)","Sahih","Musannaf Ibn Abi Shaybah 25529","","","كتاب اللباس"
"25530","(۲۵۵۳۰) حَدَّثَنَا الْمُقْرِئ، عَنْ سَعِیدِ بْنِ أَبِی أَیُّوبَ، قَالَ: حَدَّثَنِی یَزِیدَ بْنِ أَبِی حَبِیبٍ، أَنَّ أَبَا الخَیر حَدَّثَہُ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ أَنَّہُ کَانَ یَصبغ شعر رَأسہ بِشَجرۃ یُقَال لہَا : الصَبِیب کَأَشَد السواد۔ (بخاری ۱۶۶۔ مسلم ۲۵)","Sahih","Musannaf Ibn Abi Shaybah 25530","","","كتاب اللباس"
"25531","(۲۵۵۳۱) حَدَّثَنَا ابْنُ یَمَانٍ، عَنْ عَلِیِّ بْنِ صَالِحٍ، عَنْ عَبْدِ الأَعْلَی، عَنِ ابْنِ الْحَنَفِیَّۃِ، قَالَ: کَانَ یَخْتَضِبُ بِالْوَسْمَۃِ۔","","Musannaf Ibn Abi Shaybah 25531","","","كتاب اللباس"
"25532","(۲۵۵۳۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : سُئِلَ عَطَائٌ ، عَنِ الْخِضَابِ بِالْوَسْمَۃِ فَقَالَ : ہُوَ مِمَّا أَحْدَثَ النَّاسُ ، قَدْ رَأَیْت نَفَرًا مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَمَا رَأَیْت أَحَدًا مِنْہُمْ یَخْتَضِبُ بِالْوَسْمَۃِ ، مَا کَانُوا یُخَضِّبُونَ إلاَّ بِالْحِنَّائِ وَالْکَتَمِ وَہَذِہِ الصُّفْرَۃِ۔","","Musannaf Ibn Abi Shaybah 25532","","","كتاب اللباس"
"25533","(۲۵۵۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی رَبَاحٍ ، عَنْ مُجَاہِدٍ ، أَنَّہُ کَرِہَ الْخِضَابَ بِالسَّوَادِ وَقَالَ : أَوَّلُ مَنْ خَضَّبَ بِہِ فِرْعَوْنُ۔","","Musannaf Ibn Abi Shaybah 25533","","","كتاب اللباس"
"25534","(۲۵۵۳۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ مُجَاہِدٍ ، أَنَّہُ کَرِہَ الْخِضَابَ بِالسَّوَادِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25534","","","كتاب اللباس"
"25535","(۲۵۵۳۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، أَنَّہُ کَرِہَ الْخِضَابَ بِالْوَسْمَۃِ وَقَالَ : خَضَّبَ أَبُو بَکْرٍ بِالْحِنَّائِ وَالْکَتَمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25535","","","كتاب اللباس"
"25536","(۲۵۵۳۶) حَدَّثَنَا عَبِیْدَۃُ ، عَنْ صَاعِد بْنِ مُسْلِمٍ ، قَالَ : سُئِلَ الشَّعْبِیُّ ، عَنِ الْخِضَابِ بِالْوَسْمَۃِ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 25536","","","كتاب اللباس"
"25537","(۲۵۵۳۷) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرٍو، عَنْ مُوسَی بْنِ نَجْدَۃَ ، عَنْ جَدِّہِ زَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ: سَأَلْتُ أَبَا ہُرَیْرَۃَ: مَا تَرَی فِی الْخِضَابِ بِالْوَسْمَۃِ ؟ فَقَالَ : لاَ یَجِدُ الْمُخْتَضِبُ بِہَا رِیحَ الْجَنَّۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 25537","","","كتاب اللباس"
"25538","(۲۵۵۳۸) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ أَیُّوبَ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ وَسُئِلَ ، عَنِ الْخِضَابِ بِالْوَسْمَۃِ فَکَرِہَہُ فَقَالَ : یَکْسُو اللَّہُ الْعَبْدَ فِی وَجْہِہِ النُّورَ ، ثُمَّ یُطْفِئُہُ بِالسَّوَادِ۔","","Musannaf Ibn Abi Shaybah 25538","","","كتاب اللباس"
"25539","(۲۵۵۳۹) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی الْخِضَابِ بِالْوَسْمَۃِ فَقَالَ : ہُوَ مُحْدَثٌ۔","","Musannaf Ibn Abi Shaybah 25539","","","كتاب اللباس"
"25540","(۲۵۵۴۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَعْدٍ ، قَالَ : رَأَیْتُ عُثْمَانَ بْنَ عَفَّانَ وَہُوَ یَبْنِی الزَّوْرَائَ عَلَی بَغْلَۃٍ شَہْبَائَ مُصَفِّرًا لِحْیَتَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25540","","","كتاب اللباس"
"25541","(۲۵۵۴۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ الْعَیْزَارِ ، عَنْ سَعِیدٍ الْمُدَنِیّ ، قَالَ : کُنْتُ مَعَ أَبِی ہُرَیْرَۃَ فِی جِنَازَۃٍ وَکَانَ مُصَفِّرًا لِلحْیَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 25541","","","كتاب اللباس"
"25542","(۲۵۵۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِلاَلٍ ، قَالَ : حدَّثَنِی سَوَادَۃُ بْنُ حَنْظَلَۃَ ، قَالَ : رَأَیْتُ عَلِیًّا أَصْفَرَ اللِّحْیَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 25542","","","كتاب اللباس"
"25543","(۲۵۵۴۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، قَالَ : رَأَیْتُ زَیْدَ بْنَ وَہْبٍ یُصَفِّرُ لِحْیَتَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25543","","","كتاب اللباس"
"25544","(۲۵۵۴۴) حَدَّثَنَا غُنْدَرٌ مُحَمَّدِ بْنِ جَعْفَرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ ، وَابْنَ عُمَرَ یُصَفِّرَانِ لِحَاہُمَا۔","","Musannaf Ibn Abi Shaybah 25544","","","كتاب اللباس"
"25545","(۲۵۵۴۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یُصَفِّرُ لِحْیَتَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 25545","","","كتاب اللباس"
"25546","(۲۵۵۴۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حَمَّادٍ ، عَنْ أَبِی غَالِبٍ ، قَالَ : رَأَیْتُ أَبَا أُمَامَۃَ یُصَفِّرُ۔","Hasan","Musannaf Ibn Abi Shaybah 25546","","","كتاب اللباس"
"25547","(۲۵۵۴۷) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ جَرِیرٍ ، قَالَ : رَأَیْتُ عَبْدَ اللہِ بْنَ بُسْرٍ یُصَفِّرُ لِحْیَتَہُ وَرَأْسَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25547","","","كتاب اللباس"
"25548","(۲۵۵۴۸) حَدَّثَنَا أبُو خَالِدٍ ، عَنْ یَزِیدَ مَوْلَی سَلَمَۃَ ، قَالَ : رَأَیْتُ سَلَمَۃَ یُصَفِّرُ لِحْیَتَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 25548","","","كتاب اللباس"
"25549","(۲۵۵۴۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ إسْمَاعِیلَ ، قَالَ : رَأَیْتُ قَیْسًا یُصَفِّرُ لِحْیَتَہُ ، وَرَأَیْت شُبَیْلَ بْنَ عَوْفٍ یُصَفِّرُ لِحْیَتَہُ ، وَکَانَ مِنْ أَہْلِ الطَّیَالِسَۃِ۔","","Musannaf Ibn Abi Shaybah 25549","","","كتاب اللباس"
"25550","(۲۵۵۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، قَالَ : رَأَیْتُ أَنَسًا وَأَبَا الْعَالِیَۃِ وَأَبَا السِّوَارِ یُصَفِّرُونَ لِحَاہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 25550","","","كتاب اللباس"
"25551","(۲۵۵۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، قَالَ : رَأَیْتُ أَبَا وَائِلَ وَالْقَاسِمَ ، وَعَطَائً یُصَفِّرُونَ لِحَاہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 25551","","","كتاب اللباس"
"25552","(۲۵۵۵۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ دَاوُدَ أَبِی الْیَمَانِ ، قَالَ : رَأَیْتُ عَبْدَ اللہِ بْنَ أَبِی أَوْفَی یُصَفِّرُ لِحْیَتَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 25552","","","كتاب اللباس"
"25553","(۲۵۵۵۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ؛ أَنَّ ابْنَ جُرَیْجٍ سَأَلَ ابْنَ عُمَرَ ، قَالَ : رَأَیْتُکَ تُصَفِّرُ لِحْیَتَکَ بِالْوَرْسِ ؟ فَقَالَ ابْنُ عُمَرَ : أَمَّا تَصْفِیر لِحْیَتِی ، فَإِنِّی رَأَیْتُ رَ??ُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَفِّرُ لِحْیَتَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25553","","","كتاب اللباس"
"25554","(۲۵۵۵۴) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : رَأَیْتُ الْمُغِیرَۃَ بْنَ شُعْبَۃَ یُخَضِّبُ بِالصُّفْرَۃِ ، وَرَأَیْتُ جَرِیرَ بْنَ عَبْدِ اللہِ یُخَضِّبُ بِالصُّفْرَۃِ وَالزَّعْفَرَانِ۔","Hasan","Musannaf Ibn Abi Shaybah 25554","","","كتاب اللباس"
"25555","(۲۵۵۵۵) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : رَأَیْتُ الأَسْوَدَ ، وَابْن الأَسْوَدِ یُصَفِّرَانِ لِحَاہُمَا۔","No Data Available","Musannaf Ibn Abi Shaybah 25555","","","كتاب اللباس"
"25556","(۲۵۵۵۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْمُسْتَمِرِّ بْنِ الرَّیَّانِ ، عَنْ أَبِی الْجَوْزَائِ ؛ أَنَّہُ کَانَ یُصَفِّرُ لِحْیَتَہُ ، وَأَنَّ أَبَا نَضْرَۃَ کَانَ یُصَفِّرُ لِحْیَتَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25556","","","كتاب اللباس"
"25557","(۲۵۵۵۷) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ عِیسَی بْنِ طَہْمَانَ ، قَالَ : رَأَیْتُ أَنَسًا یُصَفِّرُ لِحْیَتَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25557","","","كتاب اللباس"
"25558","(۲۵۵۵۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنِ ابْنِ الْغِسِّیلِ، عَنْ عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَۃَ ، قَالَ: أَتَانَا جَابِرُ بْنُ عَبْدِ اللہِ، وَقَدْ أُصِیبَ بَصَرُہُ ، مُصَفِّرًا لِحْیَتَہُ وَرَأْسَہُ بِالْوَرْسِ۔","Sahih","Musannaf Ibn Abi Shaybah 25558","","","كتاب اللباس"
"25559","(۲۵۵۵۹) حَدَّثَنَا الْفَضْلُ ، قَالَ : حدَّثَنَا ابْنُ الْغِسِّیلِ ، قَالَ : رَأَیْتُ سَہْلَ بْنَ سَعْدٍ مُصَفِّرَ اللِّحْیَۃِ ، لَہُ جُمَیْمَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 25559","","","كتاب اللباس"
"25560","(۲۵۵۶۰) حَدَّثَنَا عَبَیْد اللہِ ، عَنْ سِمَاکٍ ، قَالَ : رَأَیْتُ جَابِرَ بْنَ سَمُرَۃَ یُصَفِّرُ لِحْیَتَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 25560","","","كتاب اللباس"
"25561","(۲۵۵۶۱) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، عَنْ عُتَیٍّ التَّمِیمِیِّ ، قَالَ : رَأَیْتُ أَبیَّ أَبْیَضَ الرَّأْسِ وَاللِّحْیَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 25561","","","كتاب اللباس"
"25562","(۲۵۵۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : رَأَیْتُ عَلِیًّا أَبْیَضَ الرَّأْسِ وَاللِّحْیَۃِ ، قَدْ مَلأَتْ مَا بَیْنَ مَنْکِبَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 25562","","","كتاب اللباس"
"25563","(۲۵۵۶۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا أَبُو عَامِرٍ صَالِحُ بْنُ رُسْتُمَ ، قَالَ : حَدَّثَنَا حُمَیْدُ بْنُ ہِلاَلٍ ، قَالَ : حَدَّثَنِی الأَحْنَفُ بْنُ قَیْسٍ ، قَالَ : قَدِمْتُ الْمَدِینَۃَ فَدَخَلْتُ مَسْجِدَہَا ، فَبَیْنَا أَنَا أُصَلِّی إِذْ دَخَلَ رَجُلٌ طَوِیلٌ آدَمَ ، أَبْیَضَ اللِّحْیَۃِ وَالرَّأْسُ مَحْلُوقٌ یُشْبِہُ بَعْضُہُ بَعْضًا ، فَخَرَجْتُ فَاتَّبَعْتہ ، قُلْتُ : مَنْ ہَذَا ؟ قَالُوا : أَبُو ذَرٍّ۔","Hasan","Musannaf Ibn Abi Shaybah 25563","","","كتاب اللباس"
"25564","(۲۵۵۶۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْمُسْتَمِرِّ ، قَالَ : رَأَیْتُ جَابِرَ بْنَ زَیْدٍ أَبْیَضَ اللِّحْیَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25564","","","كتاب اللباس"
"25565","(۲۵۵۶۵) حَدَّثَنَا الْفَضْلُ ، عَنْ فِطْرٍ ، قَالَ : رَأَیْتُ مُجَاہِدًا شَدِیدَ بَیَاضِ الرَّأْسِ وَاللِّحْیَۃِ ، وَرَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ أَبْیَضَ اللِّحْیَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25565","","","كتاب اللباس"
"25566","(۲۵۵۶۶) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ عَلِیًّا أَصْلَعَ ، أَبْیَضَ الرَّأْسِ وَاللِّحْیَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 25566","","","كتاب اللباس"
"25567","(۲۵۵۶۷) حَدَّثَنَا شَرِیکٌ ، عَنِ سَدِیر بْنِ الصَّیْرَفِیِّ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ عَلِیًّا أَبْیَضَ الرَّأْسِ وَاللِّحْیَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 25567","","","كتاب اللباس"
"25568","(۲۵۵۶۸) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ أَبِی سُلَیْمَانَ أَبِی مَوْدُودٍ ، قَالَ : رَأَیْتُ السَّائِبَ بْنَ یَزِیدَ أَبْیَضَ الرَّأْسِ وَاللِّحْیَۃِ۔","","Musannaf Ibn Abi Shaybah 25568","","","كتاب اللباس"
"25569","(۲۵۵۶۹) حَدَّثَنَا شَبَابَۃُ ، عَنْ خَالِدِ بْنِ أَبِی عُثْمَانَ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ أَبْیَضَ اللِّحْیَۃِ ، وَرَأَیْتُ طَاوُوسًا أَبْیَضَ اللِّحْیَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25569","","","كتاب اللباس"
"25570","(۲۵۵۷۰) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ حَرِیزٍ ، عَنْ عَبْدِ اللہِ بْنِ بُسْرٍ السُّلَمِیِّ ، قَالَ : أَتَیْنَاہُ وَنَحْنُ غِلْمَانٌ ، فَلَمْ نَدْرِ عَنْ أَیِّ شَیْئٍ نَسْأَلُہُ ، فَقُلْتُ لَہُ ، أَوْ قَالَ لَہُ بَعْضُنَا : رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ شَابًّا ، أَوْ شَیْخًا ؟ قَالَ : کَانَ فِی عَنْفَقَتِہِ شَعَرَاتٌ بِیضٌ۔ (بخاری ۳۵۴۶۔ احمد ۱۸۷)","Sahih","Musannaf Ibn Abi Shaybah 25570","","","كتاب اللباس"
"25571","(۲۵۵۷۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ زُہَیْرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی جُحَیْفَۃَ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ہَذِہِ مِنْہُ بَیْضَائَ ، یَعْنِی عَنْفَقَتَہُ۔ (مسلم ۱۸۲۲۔ ابن ماجہ ۳۶۲۸)","Sahih","Musannaf Ibn Abi Shaybah 25571","","","كتاب اللباس"
"25572","(۲۵۵۷۲) حَدَّثَنَا الْمُطَّلِبُ بْنُ زِیَادٍ، عَنِ السُّدِّیِّ، قَالَ: رَأَیْتُ الْحُسَیْنَ بْنَ عَلِیٍّ وَجُمَّتُہُ خَارِجَۃٌ مِنْ تَحْتِ عِمَامَتِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 25572","","","كتاب اللباس"
"25573","(۲۵۵۷۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَتْ أُمُّ ہَانِئٍ : دَخَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَکَّۃَ وَلَہُ أَرْبَعُ غَدَائِرَ ، تَعْنِی ضَفَائِرَ۔ (ترمذی ۱۷۸۱۔ ابوداؤد ۴۱۸۸)","","Musannaf Ibn Abi Shaybah 25573","","","كتاب اللباس"
"25574","(۲۵۵۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ ، وَجَابِرًا ، وَلِکُلِّ وَاحِدٍ مِنْہُمَا جُمَّۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 25574","","","كتاب اللباس"
"25575","(۲۵۵۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُبَیْرَۃَ ، قَالَ : کَانَ لِعَبْدِ اللہِ شَعْرٌ یَضَعُہُ عَلَی أُذُنَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 25575","","","كتاب اللباس"
"25576","(۲۵۵۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَفْلَحُ ، قَالَ : رَأَیْتُ لِلْقَاسِمِ جُمَّۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 25576","","","كتاب اللباس"
"25577","(۲۵۵۷۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَ لِعُبَیْدِ بْنِ عُمَیْرٍ خُصْلَتَانِ۔","","Musannaf Ibn Abi Shaybah 25577","","","كتاب اللباس"
"25578","(۲۵۵۷۸) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ یَحْیَی بْنِ عَبْدِ اللہِ بْنِ أَبِی قَتَادَۃَ ، قَالَ : مَازَحَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَبَا قَتَادَۃَ ، قَالَ : لأََجُزَّنَّ جُمَّتَکَ ، قَالَ : لَکَ مَکَانَہَا أَسِیرٌ ، فَقَالَ لَہُ بَعْدَ ذَلِکَ : أَکْرِمْہَا ، فَکَانَ یَتَّخِذُ لَہَا بَعْدَ ذَلِکَ السَّکَّ۔ (طبرانی ۶۷۵)","","Musannaf Ibn Abi Shaybah 25578","","","كتاب اللباس"
"25579","(۲۵۵۷۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الْحَسَنِ بْنِ زَیْدٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ فِی رَأْسِ الْحَسَنِ بْنِ عَلِیٍّ ذُؤَابَۃٌ ، وَأَنَّ الْحُسَیْنَ بْنِ عَلِیٍّ جَبَذَہُ بِہَا حَتَّی أَدْمَاہُ ، أَوْ أَقْرَحَہُ۔","","Musannaf Ibn Abi Shaybah 25579","","","كتاب اللباس"
"25580","(۲۵۵۸۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ ابْنِ إِسْحَاقَ ، عَنْ عُبَیْدِ اللہِ بْنِ الْمُغِیرَۃِ بْنِ مُعَیْقِیبٍ ، قَالَ : وَکَانَ تَفَقَّہ ، قَالَ : حَدَّثَنِی مَنْ لاَ أَتَّہِمُ مِنْ أَہْلِی أَنَّہُ رَأَی مُعَیْقِیبًا مُرْسِلاً نَاصِیَتَہُ بَیْنَ عَیْنَیْہِ ، وَرَأَی سَعْدَ بْنَ مَالِکٍ کَذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 25580","","","كتاب اللباس"
"25581","(۲۵۵۸۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ إِبْرَاہِیمَ بْنِ سَعْدٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ : کَانَ أَہْلُ الْکِتَابِ یَسْدُلُونَ أَشْعَارَہُمْ ، وَکَانَ الْمُشْرِکُونَ یُفَرِّقُونَ رُؤُوسَہُمْ ، وَکَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُحِبُّ مُوَافَقَۃَ أَہْلِ الْکِتَابِ فِیمَا لَمْ یُؤْمَرْ بِہِ ، قَالَ : فَسَدَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَاصِیَتَہُ ، ثُمَّ فَرَقَ بَعْدُ۔ (بخاری ۳۵۵۸۔ مسلم ۹۱)","Sahih","Musannaf Ibn Abi Shaybah 25581","","","كتاب اللباس"
"25582","(۲۵۵۸۲) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ بْنِ سَعْدٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَحْیَی بْنِ عَبَّادٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کُنْتُ أَفْرُقُ خَلْفَ یَافُوخِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ أسْدُلُ نَاصِیَتَہُ۔n(ابوداؤد ۴۱۸۶۔ ابن ماجہ ۳۶۳۳)","","Musannaf Ibn Abi Shaybah 25582","","","كتاب اللباس"
"25583","(۲۵۵۸۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : کَانَ شَعْرُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شَعْرَاً رَجِلاً بَیْنَ أُذُنَیْہِ وَمَنْکِبَیْہِ۔ (بخاری ۵۹۰۵۔ مسلم ۱۸۱۹)","Sahih","Musannaf Ibn Abi Shaybah 25583","","","كتاب اللباس"
"25584","(۲۵۵۸۴) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ ، قَالَ : مَا رَأَیْتُ أَجْمَلَ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُتَرَجِّلاً فِی حُلَّۃٍ حَمْرَائَ۔","Hasan","Musannaf Ibn Abi Shaybah 25584","","","كتاب اللباس"
"25585","(۲۵۵۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، قَالَ : حدَّثَنِی إِیَادُ بْنُ لَقِیطٍ ، عَنْ أَبِی رِمْثَۃَ ، قَالَ : أَقْبَلْتُ فَرَأَیْتُ رَجُلاً جَالِسًا فِی ظِلِّ الْکَعْبَۃِ ، فَقَالَ أَبِی : تَدْرِی مَنْ ہَذَا ؟ ہَذَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا انْتَہَیْنَا إِلَیْہِ إِذَا رَجُلٌ ذُو وَفْرَۃٍ ، وَبِہِ رَدْعٌ ، عَلَیْہِ ثَوْبَانِ أَخْضَرَانِ۔ (احمد ۴/۱۶۳)","Sahih","Musannaf Ibn Abi Shaybah 25585","","","كتاب اللباس"
"25586","(۲۵۵۸۶) حَدَّثَنَا الْفَضْلُ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ أَیْمَنَ ، قَالَ : رَأَیْتُ ابْنَ الزُّبَیْرِ وَلَہُ جُمَّۃٌ إِلَی الْعَنَقِ ، وَکَانَ یَفْرُقُ۔","Sahih","Musannaf Ibn Abi Shaybah 25586","","","كتاب اللباس"
"25587","(۲۵۵۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ أَیْمَنَ ، قَالَ : رَأَیْتُ عُبَیْدَ بْنَ عُمَیْرٍ ، وَابْنَ الْحَنَفِیَّۃِ لِکُلِّ وَاحِدٍ مِنْہُمَا جُمَّۃٌ۔","","Musannaf Ibn Abi Shaybah 25587","","","كتاب اللباس"
"25588","(۲۵۵۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، عَنْ حَبِیبٍ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ وَلَہُ جُمَّۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 25588","","","كتاب اللباس"
"25589","(۲۵۵۸۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَحْوَص بْنِ حَکِیمٍ ، عَنْ رَاشِدِ بْنِ سَعْدٍ ، قَالَ : أَمَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْفَرْقِ ، وَنَہَی عَنِ السَّکِینَۃ۔","Hasan","Musannaf Ibn Abi Shaybah 25589","","","كتاب اللباس"
"25590","(۲۵۵۹۰) حَدَّثَنَا الْفَضْلُ ، عَنْ فِطْرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُبَیْرَۃَ ، قَالَ : کُنَّا جُلُوسًا عِنْدَ عَلِیٍّ فَدَعَا ابْنًا لَہُ ، یُقَالَ لَہُ : عُثْمَانُ ، فَجَائَ غُلاَمٌ لَہُ ذُؤَابَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 25590","","","كتاب اللباس"
"25591","(۲۵۵۹۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ رَضِیِّ بْنِ أَبِی عَقِیلٍ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا عَلَی بَابِ ابْنِ الْحَنَفِیَّۃِ ، فَخَرَجَ ابْنٌ لَہُ ذُؤَابَۃٌ۔","","Musannaf Ibn Abi Shaybah 25591","","","كتاب اللباس"
"25592","(۲۵۵۹۲) حدَّثَنَا مَالِکٌ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، قَالَ : حَدَّثَنَا عُمَارَۃُ بْنُ غَزِیَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، قَالَ زُہَیْرٌ : یُرَی عُمَارَۃُ ، أَنَّہُ عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ الشَّعَرَ الْحَسَنَ ، أَوِ الْجَمِیلَ مِنْ کِسْوَۃِ اللہِ ، فَأَکْرِمُوہُ ، قَالَ : وَکَانَ یَکْرَہُ إِزَالَتَہُ ، زَعَمَ زُہَیْرٌ أَنَّہُ التَّضْییْعُ۔","","Musannaf Ibn Abi Shaybah 25592","","","كتاب اللباس"
"25593","(۲۵۵۹۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، قَالَ : رَأَیْتُ لاِبْنِ عُمَرَ جُمَّۃً مَفْرُوقَۃً ، تَضْرِبُ مَنْکِبَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 25593","","","كتاب اللباس"
"25594","(۲۵۵۹۴) حَدَّثَنَا مَالِکٌ ، عَنْ کَامِلٍ ، عَنْ حَبِیبٍ ، قَالَ : کَأَنِّی أَنْظُرُ إِلَی ابْنِ عَبَّاسٍ ، وَلَہُ جُمَّۃٌ فیْنانۃ۔","Hasan","Musannaf Ibn Abi Shaybah 25594","","","كتاب اللباس"
"25595","(۲۵۵۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَخِیہِ عِیسَی ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِذَا لَبِسَ أَحَدُکُمْ ثَوْبًا جَدِیدًا فَلْیَقُلْ : الْحَمْدُ لِلَّہِ الَّذِی کَسَانِی مَا أُوَارِی بِہِ عَوْرَتِی ، وَأَتَجَمَّلُ بِہِ فِی النَّاسِ۔","Da'if","Musannaf Ibn Abi Shaybah 25595","","","كتاب اللباس"
"25596","(۲۵۵۹۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا أَصْبَغُ بْنُ زَیْدٍ ، قَالَ : حدَّثَنَا أَبُو الْعَلاَئِ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : لَبِسَ عُمَرُ بْنُ الْخَطَّابِ ثَوْبًا جَدِیدًا ، فَقَالَ : الْحَمْدُ لِلَّہِ الَّذِی کَسَانِی مَا أُوَارِی بِہِ عَوْرَتِی ، وَأَتَجَمَّلُ بِہِ فِی حَیَاتِی ، ثُمَّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ لَبِسَ ثَوْبًا جَدِیدًا ، فَقَالَ : الْحَمْدُ لِلَّہِ الَّذِی کَسَانِی مَا أُوَارِی بِہِ عَوْرَتِی ، وَأُجَمِّلُ بِہِ فِی حَیَاتِی ، ثُمَّ عَمَدَ إِلَی الثَّوْبِ الَّذِی أَخْلَقَ ، أَوْ قَالَ : أَلْقَی فَتَصَدَّقَ بِہِ ، کَانَ فِی کَنَفِ اللہِ ، وَفِی حِفْظِ اللہِ ، وَفِی سَتْرِ اللہِ حَیًّا وَمَیِّتًا ، قَالَہَا ثَلاَثًا۔n(ترمذی ۳۵۶۰۔ حاکم ۱۹۳)","Da'if","Musannaf Ibn Abi Shaybah 25596","","","كتاب اللباس"
"25597","(۲۵۵۹۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ أَبِی الأَشْہَبِ ، عَنْ رَجُلٍ مِنْ مُزَیْنَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی عَلَی عُمَرَ ثَوْبًا غَسِیلاً ، فَقَالَ : أَجَدِیدٌ ثَوْبُک ہَذَا ؟ قَالَ : غَسِیلٌ یَا رَسُولَ اللہِ ، قَالَ : فَقَالَ لَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اِلْبَسْ جَدِیدًا ، وَعِشْ حَمِیدًا ، وَتَوَفَّ شَہِیدًا ، یُعْطِکَ اللَّہُ قُرَّۃَ عَیْنٍ فِی الدُّنْیَا وَالآخِرَۃِ۔ (ابن سعد ۳۲۹۔ مسندہ ۹۸۶)","","Musannaf Ibn Abi Shaybah 25597","","","كتاب اللباس"
"25598","(۲۵۵۹۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی وَہْبٍ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ : إِذَا لَبِسَ الإِنْسَانُ الثَّوبَ الْجَدِیدَ ، فَقَالَ : اللَّہُمَّ اجْعَلْہَا ثِیَابًا مُبَارَکَۃً نَشْکُرُ فِیہَا نِعْمَتَکَ ، وَنُحْسِن فِیہَا عِبَادَتَکَ ، وَنَعْمَلُ فِیہَا بِطَاعَتِکَ ، لَمْ یُجَاوِزْ تَرْقُوَتَہُ حَتَّی یُغْفَرَ لَہُ۔","","Musannaf Ibn Abi Shaybah 25598","","","كتاب اللباس"
"25599","(۲۵۵۹۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، قَالَ : کَانَ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا رَأَوْا عَلَی أَحَدِہِمُ الثَّوْبَ الْجَدِیدَ ، قَالُوا : تُبْلِی ، وَیُخْلِفُ اللَّہُ عَلَیْک۔","Sahih","Musannaf Ibn Abi Shaybah 25599","","","كتاب اللباس"
"25600","(۲۵۶۰۰) حَدَّثَنَا ابن عُلَیۃ ، عن الْجُرَیْرِیُّ ، عَنْ أَبِی نَضْرَۃَ ، قَالَ : إِنَّمَا نَعِیشُ فِی الْخَلَف۔","","Musannaf Ibn Abi Shaybah 25600","","","كتاب اللباس"
"25601","(۲۵۶۰۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، قَالَ : حَدَّثَنَا عَوْنُ بْنُ عَبْدِ اللہِ ، قَالَ : لَبِسَ رَجُلٌ ثَوْبًا جَدِیدًا فَحَمِدَ اللَّہَ ، فَأُدْخِلَ الْجَنَّۃَ ، أَوْ غُفِرَ لَہُ ، قَالَ : فَقَالَ رَجُلٌ : لاَ أَرْجِعُ إِلَی أَہْلِی حَتَّی أَلْبَسَ ثَوْبًا جَدِیدًا ، وَأَحْمَدَ اللَّہَ عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25601","","","كتاب اللباس"
"25602","(۲۵۶۰۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أُسَامَۃَ ، قَالَ : کَانَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إِذَا کَانَ یَوْمَ الْجُمُعَۃِ ، بَعَثَ الأَحْرَاسَ فَیَأْخُذُونَ بِأَبْوَابِ الْمَسْجِدِ ، فَلاَ یَجِدُونَ رَجُلاً مُوَفَّرَ شَیء مِنَ الشَّعْرِ إِلاَّ جَزُّوہُ۔","","Musannaf Ibn Abi Shaybah 25602","","","كتاب اللباس"
"25603","(۲۵۶۰۳) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، وَسُفْیَانُ بْنُ عُقْبَۃَ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمِ بن کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنْ وَائِلِ بْنِ حُجْرٍ ، قَالَ : رَآنِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَلِی شَعْرٌ طَوِیلٌ ، فَقَالَ : ذُبَابٌ ، ذُبَابٌ ، فَانْطَلَقْتُ فَأَخَذْتُہُ ، فَرَآنِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إِنِّی لَمْ أَعْنِکَ ، وَہَذَا أَحْسَنُ۔n(ابوداؤد ۴۱۸۷۔ ابن ماجہ ۳۶۳۶)","Hasan","Musannaf Ibn Abi Shaybah 25603","","","كتاب اللباس"
"25604","(۲۵۶۰۴) حَدَّثَنَا ابن مُبَارَکٌ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ قُدَامَۃَ ، قَالَ : دَخَلَ رَجُلٌ عَلَی ابْنِ سِیرِینَ ، وَعَلَیْہِ شَعْرٌ طَوِیلٌ، فَقَالَ : ہَذَا یُکْرَہُ ، ثُمَّ دَخَلَ عَلَیْہِ مِنَ الْغَدِ وَقَدِ اسْتَأْصَلَہُ ، فَقَالَ : ہَذَا یُکْرَہُ۔","","Musannaf Ibn Abi Shaybah 25604","","","كتاب اللباس"
"25605","(۲۵۶۰۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ أَیُّوبَ بْنِ مُوسَی، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، قَالَ: اتَّخَذَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَاتَمًا مِنْ وَرِقٍ ، ثُمَّ نَقَشَ عَلَیْہِ ؛ مُحَمَّدٌ رَسُولُ اللہِ ، ثُمَّ قَالَ : لاَ یَنْقُشْ أَحَدٌ عَلَی نَقْشِ خَاتَمِی ہَذَا۔n(بخاری ۵۸۶۶۔ مسلم ۵۵)","Sahih","Musannaf Ibn Abi Shaybah 25605","","","كتاب اللباس"
"25606","(۲۵۶۰۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، عَنْ أَنَسٍ ، قَالَ : اصْطَنَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَاتَمًا ، فَقَالَ : إِنَّا قَدِ اصْطَنَعْنَا خَاتَمًا ، وَنَقَشْنَا فِیہِ نَقْشًا ، فَلاَ یَنْقُشْ عَلَیْہِ أَحَدٌ۔n(بخاری ۵۸۷۴۔ مسلم ۲۰۹۲)","Sahih","Musannaf Ibn Abi Shaybah 25606","","","كتاب اللباس"
"25607","(۲۵۶۰۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُوسَی بْنِ عَبْدِ اللہِ بْنِ یزَیْد ، عَنْ أُمِّہِ ، عَنْ حُذَیْفَۃَ ، قَالَتْ : کَانَ فِی خَاتَمِہِ کُرْکِیَّانِ مُتَقَابِلاَنِ بَیْنَہُمَا مَکْتُوبٌ : الْحَمْدُ لِلَّہِ۔","Da'if","Musannaf Ibn Abi Shaybah 25607","","","كتاب اللباس"
"25608","(۲۵۶۰۸) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، وَالْحَسَنِ ، قَالاَ : کَانَ نَقْشُ خَاتَمِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مُحَمَّدٌ رَسُولُ اللہِ۔","","Musannaf Ibn Abi Shaybah 25608","","","كتاب اللباس"
"25609","(۲۵۶۰۹) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ نَقْشُ خَاتَمِ أَنَسٍ أَسَدٌ رَابِضٌ حَوْلَہُ فرََائسٌ۔","Sahih","Musannaf Ibn Abi Shaybah 25609","","","كتاب اللباس"
"25610","(۲۵۶۱۰) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَانَ نَقْشُ خَاتَمِ الأَشْعَرِیِّ أَسَدٌ بَیْنَ رَجُلَیْنِ۔","","Musannaf Ibn Abi Shaybah 25610","","","كتاب اللباس"
"25611","(۲۵۶۱۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا إِبْرَاہِیمُ بْنُ عَطَائٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ خَاتَمُ عِمْرَانَ بْنِ حُصَیْنٍ نَقْشُہُ تِمْثَالُ رَجُلٍ مُتَقَلِّد سَیْفًا ، قَالَ إِبْرَاہِیمُ : فَرَأَیْتہ أَنَا فِی خَاتَمٍ عِنْدَنَا فِی طِینٍ فَقَالَ أَبِی : ہَذَا خَاتَمُ عِمْرَانَ بْنِ حُصَیْنٍ۔","Hasan","Musannaf Ibn Abi Shaybah 25611","","","كتاب اللباس"
"25612","(۲۵۶۱۲) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، قَالَ : کَانَ فِی خَاتَمِ أَبِی عُبَیْدَۃَ بْنِ الْجَرَّاحِ الْخُمُس لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 25612","","","كتاب اللباس"
"25613","(۲۵۶۱۳) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ فِی خَاتَمِ أَبِی عُبَیْدَۃَ بْنِ الْجَرَّاحِ الْحَمْدُ لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 25613","","","كتاب اللباس"
"25614","(۲۵۶۱۴) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ خَاتَمُ عَبْدِ اللہِ بْنُ عُمَرَ عَبْدُ اللہِ بْنُ عُمَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 25614","","","كتاب اللباس"
"25615","(۲۵۶۱۵) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاہِیمَ قَالَ: کَانَ فِی خَاتَمِ أَبِی عُبَیْدَۃَ بْنِ الْجَرَّاحِ الْحَمْدُ لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 25615","","","كتاب اللباس"
"25616","(۲۵۶۱۶) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ نَقْشُ خَاتَمِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُحَمَّدٌ رَسُولُ اللہِ۔","","Musannaf Ibn Abi Shaybah 25616","","","كتاب اللباس"
"25617","(۲۵۶۱۷) حَدَّثَنَا جَرِیرٌ ، عَنْ إِبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِیہِ ، قَالَ : کَانَ نَقْشُ خَاتَمِ مَسْرُوقٍ بِسْمِ اللہِ الرَّحْمَن الرَّحِیمِ۔","","Musannaf Ibn Abi Shaybah 25617","","","كتاب اللباس"
"25618","(۲۵۶۱۸) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنْ مَنْصُورٍ ، قَالَ : کَانَ نَقْشُ خَاتَمِ إِبْرَاہِیمَ یَا اللہ ، وَلَہُ ذُبَابٌ۔","","Musannaf Ibn Abi Shaybah 25618","","","كتاب اللباس"
"25619","(۲۵۶۱۹) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ فِی خَاتَمِ أَبِی الْعِزَّۃُ لِلَّہِ جَمِیعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 25619","","","كتاب اللباس"
"25620","(۲۵۶۲۰) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ نَقْشُ خَاتَمِ عُبَیْدِ اللہِ بْنِ زِیَادٍ تَدْرِجَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 25620","","","كتاب اللباس"
"25621","(۲۵۶۲۱) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ نَقْشُ خَاتَمِ مُحَمَّدٍ کُنْیَتَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25621","","","كتاب اللباس"
"25622","(۲۵۶۲۲) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ نَقْشُ خَاتَمِہِ خُطُوطًا ، قَالَ ابْنُ أَبِی عَدِیٍّ : وَجَدْتُہُ مَکْتُوبًا عِنْدِی۔","No Data Available","Musannaf Ibn Abi Shaybah 25622","","","كتاب اللباس"
"25623","(۲۵۶۲۳) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ حَنْظَلَۃَ ، قَالَ : رَأَیْتُ عَلَی الْقَاسِمِ ، وَسَالِمٍ خَاتَمَیْنِ فِی خَاتَمِ الْقَاسِمِ اسْمُہُ ، وَفِی خَاتَمِ سَالِمٍ اسْمُہُ۔","","Musannaf Ibn Abi Shaybah 25623","","","كتاب اللباس"
"25624","(۲۵۶۲۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ لَمْ یَکُنْ یَرَی بَأْسًا أَنْ یَکْتُبَ الرَّجُلُ فِی خَاتَمِہِ حَسْبِی اللَّہُ ، وَنَحْوَ ہَذَا۔","No Data Available","Musannaf Ibn Abi Shaybah 25624","","","كتاب اللباس"
"25625","(۲۵۶۲۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ قَتَادَۃَ ، ع??نْ أَنَسٍ ؛ أَنَّ عُمَرَ قَالَ : لاَ تَنْقُشُوا وَلاَ تَکْتُبُوا فِی خَوَاتِمِکُمْ بِالْعَرَبِیَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 25625","","","كتاب اللباس"
"25626","(۲۵۶۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : کَانَ فِی خَاتَمِ عَلِیٍّ اللَّہُ الْمَلِکُ۔","Da'if","Musannaf Ibn Abi Shaybah 25626","","","كتاب اللباس"
"25627","(۲۵۶۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ خَاتَمُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ فِضَّۃٍ فِیہِ : مُحَمَّدٌ رَسُولُ اللہِ۔","","Musannaf Ibn Abi Shaybah 25627","","","كتاب اللباس"
"25628","(۲۵۶۲۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَکْتَبَ الآیَۃَ کُلَّہَا فِی الْخَاتَمِ ، وَلاَ یَرَی بِالْخَاتَمِ فِیہِ ذِکْرُ اللہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 25628","","","كتاب اللباس"
"25629","(۲۵۶۲۹) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یُنْقَشَ فِی الْخَاتَمِ الآیَۃُ التَّامَّۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25629","","","كتاب اللباس"
"25630","(۲۵۶۳۰) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ فِی خَاتَمِ حَسَنٍ وَحُسَیْنٍ ذِکْرُ اللہِ ، قَالَ جَعْفَرٌ : وَکَانَ فِی خَاتَمِ أَبِی الْعِزَّۃُ لِلَّہِ جَمِیعًا۔","Hasan","Musannaf Ibn Abi Shaybah 25630","","","كتاب اللباس"
"25631","(۲۵۶۳۱) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ صَدَقَۃَ بْنِ یَسَارٍ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ الْمُسَیَّبِ : مَا أَکْتُبُ فِی خَاتَمِی ؟ قَالَ : اُکْتُبْ فِیہِ ذِکْرَ اللہِ ، وَقُلْ : أَمَرَنِی بِہِ سَعِیدٌ۔","","Musannaf Ibn Abi Shaybah 25631","","","كتاب اللباس"
"25632","(۲۵۶۳۲) حَدَّثَنَا جَرِیرٌ ، عَنْ إِبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِیہِ ، قَالَ : کَانَ نَقْشُ خَاتَمِ مَسْرُوقٍ بِسْمِ اللہِ الرَّحْمَن الرَّحِیمِ۔","","Musannaf Ibn Abi Shaybah 25632","","","كتاب اللباس"
"25633","(۲۵۶۳۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إِسْرَائِیلَ ، عَنْ عَبْدِ اللہِ بْنِ الْمُخْتَارِ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : لاَ بَأْسَ أَنْ یُنْقَشَ فِی الْخَاتَمِ الآیَۃُ کُلُّہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 25633","","","كتاب اللباس"
"25634","(۲۵۶۳۴) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنْ حُرَیْثٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَرِہَ أَنْ تُنْقَشَ الآیَۃُ فِی الْخَاتَمِ۔","","Musannaf Ibn Abi Shaybah 25634","","","كتاب اللباس"
"25635","(۲۵۶۳۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ بْنِ مُوسَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : اتَّخَذَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَاتَمًا مِنْ وَرِقٍ۔","Sahih","Musannaf Ibn Abi Shaybah 25635","","","كتاب اللباس"
"25636","(۲۵۶۳۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، عَنْ طَاوُوسٍ ، قَالَ : کَانَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَاتَمٌ مِنْ فِضَّۃٍ فِی یَدِہِ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَکُمْ نَظْرَۃٌ وَلِہَذَا نَظْرَۃٌ ، لَقَدْ عَنَانِی ہَذَا الْیَوْمَ ، فَنَزَعَہُ فَأَعْطَاہُ رَجُلاً۔ (ابن سعد ۴۷۰)","","Musannaf Ibn Abi Shaybah 25636","","","كتاب اللباس"
"25637","(۲۵۶۳۷) حَدَّثَنَا عُثْمَانُ بْنُ عُمَرَ ، عَنْ یُونُسَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَنَسٍ ، قَالَ : کَانَ فِی خَاتَمِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِضَّۃٌ ، وَکَانَ فَصُّہُ حَبَشِیًّا۔ (بخاری ۵۸۶۸۔ مسلم ۶۲)","Sahih","Musannaf Ibn Abi Shaybah 25637","","","كتاب اللباس"
"25638","(۲۵۶۳۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : اتَّخَذَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَاتَمًا مِنْ وَرِقٍ ، فَکَانَ فِی یَدِہِ ، ثُمَّ کَانَ فِی یَدِ أَبِی بَکْرٍ مِنْ بَعْدِہِ ، ثُمَّ کَانَ فِی یَدِ عُمَرَ ، ثُمَّ کَانَ فِی یَدِ عُثْمَانَ ، حَتَّی وَقَعَ مِنْہُ فِی بِئْرِ أَرِیسَ ، وَکَانَ نَقْشُہُ مُحَمَّدٌ رَسُولُ اللہِ۔ (بخاری ۵۸۷۳۔ احمد ۲/۲۲)","Sahih","Musannaf Ibn Abi Shaybah 25638","","","كتاب اللباس"
"25639","(۲۵۶۳۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی عَلَی عَبْدِ اللہِ خَاتَمًا مِنْ حَدِیدٍ۔","Da'if","Musannaf Ibn Abi Shaybah 25639","","","كتاب اللباس"
"25640","(۲۵۶۴۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، قَالَ : رَأَیْتُ عَلَی إِبْرَاہِیمَ خَاتَمَ حَدِیدٍ۔","","Musannaf Ibn Abi Shaybah 25640","","","كتاب اللباس"
"25641","(۲۵۶۴۱) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ رَاشِدٍ ، قَالَ : حَدَّثَنَا مَکْحُولٌ ، قَالَ : کَانَ خَاتَمُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَدِیدًا مَلْوِیًّا ، عَلَیْہِ فِضَّۃٌ ، بَادی۔ (ابن سعد ۴۷۳)","","Musannaf Ibn Abi Shaybah 25641","","","كتاب اللباس"
"25642","(۲۵۶۴۲) حَدَّثَنَا یَزِیدُ ، عَنْ ہِشَامٍ ، قَالَ : سُئِلَ مُحَمَّدٌ عَنْ خَاتَمِ الْحَدِیدِ ؟ فَقَالَ : لاَ بَأْسَ ، إِلاَّ أَنْ یُکْرَہَ رِیحُہُ۔","","Musannaf Ibn Abi Shaybah 25642","","","كتاب اللباس"
"25643","(۲۵۶۴۳) حَدَّثَنَا شَرِیکٌ ، عَنْ مَنْصُورٍ قَالَ : رَأَیْتُ عَلَی إِبْرَاہِیمَ خَاتَمًا مِنْ حَدِیدٍ ، قَالَ : فَقُلْتُ لَہُ ، قَالَ : کَانَ خَاتَمُ عَبْدِ اللہِ مِنْ حَدِیدٍ۔","","Musannaf Ibn Abi Shaybah 25643","","","كتاب اللباس"
"25644","(۲۵۶۴۴) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ طَارِقٍ، عَنْ حَکِیمِ بْنِ جَابِرٍ؛ أَنَّ عُمَرَ رَأَی عَلَی رَجُلٍ خَاتَمَ حَدِیدٍ فَکَرِہَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25644","","","كتاب اللباس"
"25645","(۲۵۶۴۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَکِیمِ بْنِ الدَّیْلَمِ ، قَالَ : سَمِعْتُ الضَّحَّاکَ ، قَالَ : سُئِلَ عَطَائٌ عَنْ خَاتَمٍ مِنْ فِضَّۃٍ ، فَصُّہُ حَدِیدٌ ؟ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 25645","","","كتاب اللباس"
"25646","(۲۵۶۴۶) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ أَبِی سَعدٍ ، عَنْ أبِی الْکَنُودِ ، قَالَ : أُصِیبَ عَظِیمٌ مِنْ عُظَمَائِہِمْ یَوْمَ مَہْرَانَ ، فَأُصبتُ عَلَیْہِ خَاتَمًا فَلَبِسْتُہُ ، فَرَآہُ عَلَیَّ ابْنُ مَسْعُودٍ ،فَتَنَاوَلَہُ فَوَضَعَہُ بَیْنَ ضِرْسَیْنِ مِنْ أَضْرَاسِہِ فَکَسرہُ ، ثُمَّ رَمَی بِہِ إِلَیَّ ، ثُمَّ قَالَ : إِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَانَا عَنْ خَاتَمِ الذَّہَبِ۔ (طیالسی ۳۸۶۔ احمد ۱/۳۷۷)","Da'if","Musannaf Ibn Abi Shaybah 25646","","","كتاب اللباس"
"25647","(۲۵۶۴۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ یَزِید ، عَنِ الْحَسَن بن سُہَیْلٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَن خَاتَمِ الذَّہَبِ۔ (احمد ۹۹)","Da'if","Musannaf Ibn Abi Shaybah 25647","","","كتاب اللباس"
"25648","(۲۵۶۴۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ مُعَاوِیَۃَ بْنِ سُوَیْد ، عَنِ الْبَرَائِ، قَالَ : نَہَانَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ التَّخَتُّمِ بِالذَّہَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 25648","","","كتاب اللباس"
"25649","(۲۵۶۴۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَحْیَی بْنِ عَبَّادِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ أَبِیْہِ عَبَّادِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ عَائِشَۃَ أُمِّ الْمُؤْمِنِینَ ، قَالَتْ : أَہْدَی النَّجَاشِیُّ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حلیۃ فِیہَا خَاتَمٌ مِنْ ذَہَبٍ فِیہِ فَصٌّ حَبَشِیٌّ ، فَأَخَذَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِعُودٍ وَإِنَّہُ لَمُعْرِضٌ عَنْہُ ، أَوْ بِبَعْضِ أَصَابِعِہِ ، وَإِنَّہُ لَمُعْرِضٌ عَنْہُ ، ثُمَّ دَعَا ابْنَۃِ ابْنَتِہِ أُمَامَۃَ بِنْتِ أَبِی الْعَاصِ ، فَقَالَ : تَحَلِّی بِہَذَا یَا بُنَیَّۃُ۔ (ابوداؤد ۴۲۳۲۔ احمد ۶/۱۱۹)","Hasan","Musannaf Ibn Abi Shaybah 25649","","","كتاب اللباس"
"25650","(۲۵۶۵۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَنْ یَزِیدَ بْنِ الأَصَمِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ فِی إِصْبَعِی خَاتَمٌ مِنْ ذَہَبٍ فَتَنَاوَلَہُ عُمَرُ بْنُ الْخَطَّابِ ، فَرَأَیْتُ أَنَّہُ إِنَّمَا یَنْظُرُ إِلَیْہِ ، فَأَرْخَیْتُ یَدَیَّ ، فَأَخَذَہُ فَخَذَفَ بِہِ ، فَلَمْ أَسْأَلْہُ عَنْہُ وَلَمْ أَطْلُبْہُ۔","Hasan","Musannaf Ibn Abi Shaybah 25650","","","كتاب اللباس"
"25651","(۲۵۶۵۱) حَدَّثَنَا حَاتِمٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَخَتَّمُ بِخَاتَمٍ مِنْ ذَہَبٍ ، فَخَرَجَ عَلَی النَّاسِ فَطَفِقُوا یَنْظُرُونَ إِلَیْہِ ، فَوَضَعَ یَدَہُ الْیُمْنَی عَلَی خِنْصَرِہِ ، ثُمَّ رَجَعَ إِلَی الْبَیْتِ فَرَمَی بِہِ۔","","Musannaf Ibn Abi Shaybah 25651","","","كتاب اللباس"
"25652","(۲۵۶۵۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عُمَرَ بْنِ سَعِیدِ بْنِ أَبِی حُسَیْنٍ ، قَالَ : أَخْبَرَتْنِی أُمِّی ، عَنْ أَبِی ، قَالَ: دَخَلْتُ عَلَی أُمِّ سَلَمَۃَ وَأَنَا غُلاَمٌ وَعَلَیَّ خَاتَمٌ مِنْ ذَہَبٍ ، فَقَالَتْ : یَا جَارِیَۃُ ، نَاوِلِینِیہِ ، فَنَاوَلَتْہَا إِیَّاہُ ، فَقَالَتْ: اذْہَبِی بِہِ إِلَی أَہْلِہِ وَاصْنَعِی خَاتَمًا مِنْ وَرِقٍ ، فَقُلْتُ : لاَ حَاجَۃَ لأَہْلِی فِیہِ ، قَالَتْ : فَتَصَدَّقِی بِہِ ، وَاصْنَعِی لَہُ خَاتَمًا مِنْ وَرِقٍ۔","Da'if","Musannaf Ibn Abi Shaybah 25652","","","كتاب اللباس"
"25653","(۲۵۶۵۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : رَأَی عَبْدُ اللہِ فِی یَدِ خَبَّابٍ خَاتَمًا مِنْ ذَہَبٍ ، فَقَالَ : أَمَا آنَ لِہَذَا أَنْ یُطْرَحَ بَعْدُ ؟ فَقَالَ : بَلَی ، لاَ تَرَاہُ عَلَیَّ بَعْدَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 25653","","","كتاب اللباس"
"25654","(۲۵۶۵۴) حَدَّثَنَا عُبید اللہِ ، عَنْ أُسَامَۃَ ، عَنْ مَکْحُولٍ ، عَنْ عَوْفِ بْنِ مَالِکٍ ، قَالَ : أَتَیْتُ عُمَرَ وَفِی یَدِی خَاتَمٌ مِنْ ذَہَبٍ ، فَضَرَبَ یَدَیَّ بِعَصًا کَانَتْ مَعَہُ۔","","Musannaf Ibn Abi Shaybah 25654","","","كتاب اللباس"
"25655","(۲۵۶۵۵) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : رَأَی سَعِیدُ بْنُ جُبَیْرٍ عَلَی شَابٍّ مِنَ الأَنْصَارِ خَاتَمًا مِنْ ذَہَبٍ ، فَقَالَ لَہُ : أَمَا لَکَ أُخْتٌ ؟ قَالَ : بَلَی ، قَالَ : فَأَعْطِہِ إِیَّاہَا۔","","Musannaf Ibn Abi Shaybah 25655","","","كتاب اللباس"
"25656","(۲۵۶۵۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ خَاتَمَ الذَّہَبِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25656","","","كتاب اللباس"
"25657","(۲۵۶۵۷) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ عُقْبَۃَ بْنِ وَسَّاجٍ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ الذَّہَبِ ؟ قَالَ : کُنَّا نَکْرَہُہُ لِلرِّجَالِ۔","Sahih","Musannaf Ibn Abi Shaybah 25657","","","كتاب اللباس"
"25658","(۲۵۶۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکٍ بْنِ أَنَسٍ ؛ أنَّہُ کَرِہَ خَاتَمَ الذَّہَبِ۔","","Musannaf Ibn Abi Shaybah 25658","","","كتاب اللباس"
"25659","(۲۵۶۵۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ عَاصِمٍ، عَنِ ابْنِ سِیرِینَ، قَالَ: رَأَی عُمَرُ فِی یَدِ رَجُلٍ خَاتَمًا مِنْ ذَہَبٍ، فَنَہَاہُ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 25659","","","كتاب اللباس"
"25660","(۲۵۶۶۰) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ عَلَی الْبَرَائِ خَاتَمًا مِنْ ذَہَبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 25660","","","كتاب اللباس"
"25661","(۲۵۶۶۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُوسَی بْنِ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنْ أُمِّہِ ، عَنْ حُذَیْفَۃَ ، قَالَتْ : کَانَ فِی یَدِہِ خَاتَمٌ مِنْ ذَہَبٍ فِیہِ یَاقُوتَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 25661","","","كتاب اللباس"
"25662","(۲۵۶۶۲) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ إِسْرَائِیلَ ، عَنْ أَبِی حَصِینٍ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ، عَنْ سَعْدٍ؛ أَنَّہُ کَانَ یَلْبَسُ خَاتَمًا مِنْ ذَہَبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 25662","","","كتاب اللباس"
"25663","(۲۵۶۶۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُحَمَّدِ بْنِ إِسْمَاعِیلَ ، قَالَ : حَدَّثَنِی مَنْ رَأَی طَلْحَۃَ بْنَ عُبَیْدِ اللہِ ، وَسَعْدًا ، وَذَکَرَ سِتَّۃً ، أَوْ سَبْعَۃً عَلَیْہِم خَوَاتِیمَ الذَّہَبِ۔","Da'if","Musannaf Ibn Abi Shaybah 25663","","","كتاب اللباس"
"25664","(۲۵۶۶۴) حَدَّثَنَا ہُِشَیمٌ ، عَنِ الْعَوَّامِ ، عَنْ إِبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : کَانُوا یُرَخِّصُونَ لِلْغُلاَمِ فِی خَاتَمِ الذَّہَبِ ، فَإِذَا کَبُرَ أَلْقَاہُ ، أَوْ قَالَ : طَرَحَہُ۔","","Musannaf Ibn Abi Shaybah 25664","","","كتاب اللباس"
"25665","(۲۵۶۶۵) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا الْحَسَنُ بْنُ صَالِحٍ ، عَنْ سِمَاکٍ ، قَالَ : رَأَیْتُ عَلَی جَابِرِ بْنِ سَمُرَۃَ خَاتَمًا مِنْ ذَہَبٍ ، وَرَأَیْتُ عَلَی عِکْرِمَۃَ خَاتَمَ ذَہَبٍ۔","Hasan","Musannaf Ibn Abi Shaybah 25665","","","كتاب اللباس"
"25666","(۲۵۶۶۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ أَبِی السَّفَرِ ، قَالَ : رَأَیْتُ عَلَی الْبَرَائِ خَاتَمَ ذَہَبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 25666","","","كتاب اللباس"
"25667","(۲۵۶۶۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مِسْعَرٍ ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ ، قَالَ : رَأَیْتُ عَلَی عَبْدِ اللہِ بْنِ یَزِیدَ خَاتَمًا مِنْ ذَہَبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 25667","","","كتاب اللباس"
"25668","(۲۵۶۶۸) حَدَّثَنَا ابْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا ابْنُ الْغَسِیلِ ، قَالَ : حَدَّثَنَا حَمْزَۃُ بْنُ أَبِی أُسَیْدَ ، وَالزُّبَیْرُ بْنُ الْمُنْذِرِ بْنِ أَبِی أُسَیْدَ ، قَالاَ : نَزَعْنَا مِنْ یَدِ أَبِی أُسَیْدٍ خَاتَمَ ذَہَبٍ حِینَ مَاتَ ، وَکَانَ بَدْرِیًّا۔","Sahih","Musannaf Ibn Abi Shaybah 25668","","","كتاب اللباس"
"25669","(۲۵۶۶۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ أَبِی الْقَاسِمِ الأَزْدِیِّ ، قَالَ : سَأَلْتُ أنَسَ بْنَ مَالِکٍ : أَتَخَتَّمُ بِخَاتَمٍ مِنْ ذَہَبٍ ؟ فَقَالَ : نَعَمْ ، وَإِنْ شِئْتَ مِنْ فِضَّۃٍ ، لاَ یَضُرُّکَ ، وَلَکِنْ لاَ تَطْعَمْ فِی إِنَائِ ذَہَبٍ ، وَلاَ فِضَّۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 25669","","","كتاب اللباس"
"25670","(۲۵۶۷۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ یَجْعَلُ فَصَّہُ مِمَّا یَلِی کَفَّہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25670","","","كتاب اللباس"
"25671","(۲۵۶۷۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ بْنِ مُوسَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَجْعَلُ فَصَّہُ مِمَّا یَلِی بَطْنَ کَفِّہِ۔","Sahih","Musannaf Ibn Abi Shaybah 25671","","","كتاب اللباس"
"25672","(۲۵۶۷۲) حَدَّثَنَا حَفْصٌ ، عَنْ ابن أَبِی رَوَّادٍ ، قَالَ : کَانَ عِکْرِمَۃُ إِذَا دَخَلَ الْخَلاَئَ جَعَلَ فَصَّہُ مِمَّا یَلِی بَطْنَ کَفِّہِ۔","","Musannaf Ibn Abi Shaybah 25672","","","كتاب اللباس"
"25673","(۲۵۶۷۳) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ، عَنْ جَعْفَرٍ، عَنْ أَبِیہِ، قَالَ: کَانَ الْحَسَنُ وَالْحُسَیْنُ یَتَخَتَّمَانِ فِی یَسَارِہِمَا۔ (ترمذی ۱۷۴۳)","Sahih","Musannaf Ibn Abi Shaybah 25673","","","كتاب اللباس"
"25674","(۲۵۶۷۴) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ سُلَیْمَانَ بْنِ بِلاَلٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ أَنَّ أَبَا بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ تَخَتَّمُوا فِی یَسَارِہِمْ۔","Hasan","Musannaf Ibn Abi Shaybah 25674","","","كتاب اللباس"
"25675","(۲۵۶۷۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ ، قَالَ : رَأَیْتُ الْقَاسِمَ ، وَسَالِمًا یَتَخَتَّمَانِ فِی یَسَارِہِمَا۔","","Musannaf Ibn Abi Shaybah 25675","","","كتاب اللباس"
"25676","(۲۵۶۷۶) حَدَّثَنَا حَفْصٌ ، عَنْ إِسْمَاعِیلَ ، قَالَ : رَأَیْتُ عَلَی إِبْرَاہِیمَ خَاتَمًا فِی یَسَارِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25676","","","كتاب اللباس"
"25677","(۲۵۶۷۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَتَخَتَّمُ فِی یَسَارِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 25677","","","كتاب اللباس"
"25678","(۲۵۶۷۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، قَالَ : رَأَیْتُ خَاتَمَ إِبْرَاہِیمَ فِی یَسَارِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25678","","","كتاب اللباس"
"25679","(۲۵۶۷۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الصَّلْتِ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبَا بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ کَانُوا یَتَخَتَّمُونَ فِی شَمَائِلِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 25679","","","كتاب اللباس"
"25680","(۲۵۶۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ الأَزْرَقِ ، قَالَ : رَأَیْتُ خَاتَمَ عَمْرِو بْنِ حُرَیْثٍ فِی یَسَارِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 25680","","","كتاب اللباس"
"25681","(۲۵۶۸۱) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنْ جَعْفَرِ بْنِ عبْدِ اللہِ بْنِ جَعْفَرٍ ؛ أَنَّ جَعْفَرِ بْنِ أَبِی طَالِبٍ تَخَتَّمَ فِی یَمِینِہِ۔ (ابن سعد ۳۶)","","Musannaf Ibn Abi Shaybah 25681","","","كتاب اللباس"
"25682","(۲۵۶۸۲) حَدَّثَنَا مَعَنْ ، عَنِ الْمُخْتَارِ بْنِ سَعْدٍ ، قَالَ : رَأَیْتُ مُحَمَّدَ بْنَ عَلِیٍّ یَتَخَتَّمُ فِی یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 25682","","","كتاب اللباس"
"25683","(۲۵۶۸۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الصَّلْتِ بْنِ عَبْدِ اللہِ بْنِ نَوْفَلٍ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ وَخَاتَمُہُ فِی یَمِینِہِ ، وَلاَ أَحْسَبُ إِلاَ أَنَّہُ ذَکَرَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَذَلِکَ کَانَ یَلْبَسُہُ۔n(ترمذی ۱۷۴۲۔ ابوداؤد ۴۲۲۶)","Hasan","Musannaf Ibn Abi Shaybah 25683","","","كتاب اللباس"
"25684","(۲۵۶۸۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إِبْرَاہِیمَ بْنِ الْفَضْلِ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ عَبْدِ اللہِ بْنِ جَعْفَرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَتَخَتَّمُ فِی یَمِینِہِ۔ (ابن ماجہ ۳۶۴۷۔ ابویعلی ۶۷۹۴)","Da'if","Musannaf Ibn Abi Shaybah 25684","","","كتاب اللباس"
"25685","(۲۵۶۸۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنِی ابْنُ أَبِی رَافِعٍ مَوْلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّ عَبْدَ اللہِ بْنَ جَعْفَرٍ کَانَ یَتَخَتَّمُ فِی یَمِینِہِ ، وَزَعَم أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَتَخَتَّمُ فِی یَمِینِہِ۔ (ترمذی ۱۷۴۴۔ احمد ۱/۲۰۵)","Hasan","Musannaf Ibn Abi Shaybah 25685","","","كتاب اللباس"
"25686","(۲۵۶۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا دَلْہَمُ بْنُ صَالِحٍ الْکِنْدِیُّ ، عَنْ حُجَیْرِ بْنِ عَبْدِ اللہِ الْکِنْدِیِّ ، عَنِ ابْنِ بُرَیْدَۃَ، عَنْ أَبِیہِ ؛ أَنَّ النَّجَاشِیَّ أَہْدَی إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خُفَّیْنِ سَاذَجَیْنِ أَسْوَدَیْنِ ، فَلَبِسَہُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 25686","","","كتاب اللباس"
"25687","(۲۵۶۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَوَادَۃُ بْنُ أَبِی الأَسْوَدِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، قَالَ : عَلَیْکُمْ بِہَذِہِ الْخِفَافِ السُّودِ فَالْبَسُوہَا ، فَہُو أَجْدَرُ أَنْ تَمْسَحُوا عَلَیْہَا۔","Hasan","Musannaf Ibn Abi Shaybah 25687","","","كتاب اللباس"
"25688","(۲۵۶۸۸) حَدَّثَنَا شَرِیکٌ ، عَنْ عُرْوَۃَ بن عَبْدِ اللہِ بْنِ قُشِیرٍ ، قَالَ : سَمِعْتُ أَبَا جَعْفَرٍ یَقُولُ : کَانَ قَائِمُ سَیْفِ عُمَرَ فِضَّۃً ، فَقُلْتُ : أَمِیرُ الْمُؤْمِنِینَ ؟ قَالَ : أَمِیرُ الْمُؤْمِنِینَ۔","","Musannaf Ibn Abi Shaybah 25688","","","كتاب اللباس"
"25689","(۲۵۶۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ أَبِی الْحَسَنِ ، قَالَ : کَانَت قَبِیعَۃُ سَیْفِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ فِضَّۃٍ۔ (ترمذی ۱۶۹۱۔ ابوداؤد ۲۵۷۷)","","Musannaf Ibn Abi Shaybah 25689","","","كتاب اللباس"
"25690","(۲۵۶۹۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ قَالَ : کَانَ سَیْفُ الزُّبَیْرِ مُحَلًّی بِالْفِضَّۃِ۔","","Musannaf Ibn Abi Shaybah 25690","","","كتاب اللباس"
"25691","(۲۵۶۹۱) حَدَّثَنَا ابْنُ نُمَیْرٍ، قَالَ: حدَّثَنَا عُثْمَانُ بْنُ حَکِیمٍ، قَالَ: رَأَیْتُ فِی قَائِمِ سَیْفِ سَہْلِ بْنِ حُنَیْفٍ مِسْمَارَ ذَہَبٍ۔","","Musannaf Ibn Abi Shaybah 25691","","","كتاب اللباس"
"25692","(۲۵۶۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا ابْنُ مِغْوَلٍ ، عَنْ نَافِعٍ ، قَالَ: کَانَ سَیْفُ عُمَرَ مُحَلًّی ، فَقُلْتُ لَہُ : عُمَرُ حَلاَہُ؟ قَالَ : قَدْ رَأَیْتُ ابْنَ عُمَرَ یَتَقَلَّدُہُ۔","","Musannaf Ibn Abi Shaybah 25692","","","كتاب اللباس"
"25693","(۲۵۶۹۳) حَدَّثَنَا وَکِیعٌ ، حدَّثَنَا أَبُو الْعُمَیسِ ، عَنِ الْقَاسِمِ ، قَالَ : کَانَ سَیْفُ عَبْدِ اللہِ مُحَلًّی۔","","Musannaf Ibn Abi Shaybah 25693","","","كتاب اللباس"
"25694","(۲۵۶۹۴) حَدَّثَنَا أَبُو نُعَیْمٍ، عَنْ قُرَّۃَ بْنِ خَالِدٍ، عَنْ أَبِی وَحْشِیَّۃَ الصَّیْقَلِ، قَالَ: دَعَانِی مُصْعَبٌ فَأَخْرَجَ إِلَیَّ سَیْفَیْنِ، فَقَالَ: أَیُّ ہَذَیْنِ خَیْرٌ؟ فَقُلْتُ: ہَذَا ، وَعَلَی قَائِمِہِ حَبَّۃٌ مِنْ فِضَّۃٍ ، فَقَالَ النَّاسُ: ہَذَا سَیْفُ أَبِی بَکْرٍ الصِّدِّیقِ۔","Da'if","Musannaf Ibn Abi Shaybah 25694","","","كتاب اللباس"
"25695","(۲۵۶۹۵) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ اللہِ ، قَالَ : رَأَیْتُ عَلَی مَکْحُولٍ سَیْفًا مُحَلًّی۔","","Musannaf Ibn Abi Shaybah 25695","","","كتاب اللباس"
"25696","(۲۵۶۹۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ سَیْف مَسْرُوقٍ مُحَلًّی۔","","Musannaf Ibn Abi Shaybah 25696","","","كتاب اللباس"
"25697","(۲۵۶۹۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : أَخْرَجَ إِلَیْنَا عَلِیُّ بْنُ الْحُسَیْنِ سَیْفَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَإِذَا قَبِیعَتُہُ وَالْحَلَقَتَانِ اللَّتَانِ فِیہِمَا الْحَمَائِلُ فِضَّۃٌ ، قَالَ : فَسَأَلْتُہُ ، فَإِذَا ہُوَ قَدْ نُحِلَ ، کَانَ سَیْفُ مُنَبِّہِ بْنِ الْحَجَّاجِ السَّہْمِیِّ ، اتَّخَذَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِنَفْسِہِ یَوْمَ بَدْرٍ ، قَالَ : وَأَخْرَجَ إِلَیْنَا دِرْعَہُ فَإِذَا ہِیَ یَمَانِیَّۃٌ رَقِیقَۃٌ ذَاتُ زُرَافِینَ ، فَإِذَا عُلِّقَتْ بِزُرَافِینِہَا شُمِّرَتْ ، وَإِذَا أُرْسِلَتْ مَسَّتِ الأَرْضَ۔ (ابن سعد ۴۸۶)","Da'if","Musannaf Ibn Abi Shaybah 25697","","","كتاب اللباس"
"25698","(۲۵۶۹۸) قَالَ أَبُو نُعَیْمٍ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لاَ بَأْسَ أَنْ یُحَلَّی السَّیْفُ۔","","Musannaf Ibn Abi Shaybah 25698","","","كتاب اللباس"
"25699","(۲۵۶۹۹) حَدَّثَنَا وَکِیعٌ، عَنْ شَرِیکٍ ، عَنْ مُخَارِقٍ ، عَنْ طَارِقٍ، قَالَ: خَطَبَنَا عَلِیٌّ وَعَلَیْہِ سَیْفٌ حِلْیَتُہُ مِنْ حَدِیدٍ۔","Hasan","Musannaf Ibn Abi Shaybah 25699","","","كتاب اللباس"
"25700","(۲۵۷۰۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنِ ابْنِ حَبِیبٍ الْمُحَارِبِیِّ ، عَنْ أَبِی أُمَامَۃَ الْبَاہِلِیِّ صَاحِبِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَقَدِ افْتَتَحَ الْفُتُوحَ أَقْوَامٌ مَا کَانَتْ حِلْیَۃَ سُیُوفِہِمُ الذَّہَبُ ، وَلاَ الْفِضَّۃُ ، إِنَّمَا کَانَتْ حِلْیَتَہَا الْعَلاَبِیُّ ، وَالآنُکُ ، وَالْحَدِیدُ۔ (بخاری ۲۹۰۹۔ ابن ماجہ ۲۸۰۷)","Sahih","Musannaf Ibn Abi Shaybah 25700","","","كتاب اللباس"
"25701","(۲۵۷۰۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ أَبِی طَلْحَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ تَدْخُلُ الْمَلاَئِکَۃُ بَیْتًا فِیہِ کَلْبٌ ، وَلاَ صُورَۃٌ۔ (بخاری ۳۳۲۲۔ مسلم ۱۶۶۵)","Sahih","Musannaf Ibn Abi Shaybah 25701","","","كتاب اللباس"
"25702","(۲۵۷۰۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَلِیِّ بْنِ مُدْرِکٍ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ عَبْدِ اللہِ بْنِ نُجَیٍّ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْمَلاَئِکَۃُ لاَ تَدْخُلُ بَیْتًا فِیہِ کَلْبٌ ، وَلاَ صُورَۃٌ۔n(ابوداؤد ۲۲۹۔ احمد ۱/۸۰)","Da'if","Musannaf Ibn Abi Shaybah 25702","","","كتاب اللباس"
"25703","(۲۵۷۰۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : وَاعَدَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جِبْرِیلُ سَاعَۃً یَأْتِیہِ فِیہَا ، فَرَاثَ عَلَیْہِ ، فَخَرَجَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَإِذَا ہُوَ بِجِبْرِیلَ قَائِمًا عَلَی الْبَابِ ، فَقَالَ لَہُ : مَا مَنَعَک أَنْ تَدْخُلَ ؟ قَالَ : إِنَّ فِی الْبَیْتِ کَلْبًا ، وَإِنَّا لاَ نَدْخُلُ بَیْتًا فِیہِ صُورَۃٌ ، وَلاَ کَلْبٌ۔","Hasan","Musannaf Ibn Abi Shaybah 25703","","","كتاب اللباس"
"25704","(۲۵۷۰۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ أَبَانَ بْنِ صَالِحٍ ، عَنِ الْقَعْقَاعِ بْنِ حَکِیمٍ ، عَنْ سَلْمَی أُمِّ رَافِعٍ ، عَنْ أَبِی رَافِعٍ قَالَ : أَتَی جِبْرِیلُ یَسْتَأْذِنُ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَذِنَ لَہُ ، فَأَبْطَأَ عَلَیْہِ ، فَأَخَذَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رِدَائَہُ ، فَقَامَ إِلَیْہِ وَہُوَ بِالْبَابِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قَدْ أَذِنَّا لَکَ ، قَالَ : أَجَلْ ، وَلَکِنَّا لاَ نَدْخُلُ بَیْتًا فِیہِ کَلْبٌ ، وَلاَ صُورَۃٌ۔ (طبرانی ۹۷۲)","Da'if","Musannaf Ibn Abi Shaybah 25704","","","كتاب اللباس"
"25705","(۲۵۷۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَدِیٍّ ، عَنْ خَالِدِ بْنِ سَعْدٍ ، قَالَ : دُعِی أَبُو مَسْعُودٍ إِلَی طَعَامٍ ، فَرَأَی فِی الْبَیْتِ صُورَۃً ، فَلَمْ یَدْخُلْ حَتَّی کُسِرَتْ۔","Sahih","Musannaf Ibn Abi Shaybah 25705","","","كتاب اللباس"
"25706","(۲۵۷۰۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنْ أَسْلَمَ ، قَالَ : لَمَّا قَدِمَ عُمَرُ الشَّامَ أَتَاہُ رَجُلٌ مِنَ الدَّہَّاقِینَ ، فَقَالَ : إِنِّی قَدْ صَنَعْت لَکَ طَعَامًا فَأُحِبُّ أَنْ تَجِیئَ ، فَیَرَی أَہْلُ عَمَلِی کَرَامَتِی عَلَیْک ، وَمَنْزِلَتِی عِنْدَکَ ، أَوْ کَمَا قَالَ ، فَقَالَ : إِنَّا لاَ نَدْخُلُ ہَذِہِ الْکَنَائِسَ ، أَوْ قَالَ : ہَذِہِ الْبِیَعَ ، الَّتِی فِیہَا ہذہ الصُّوَرُ۔","Sahih","Musannaf Ibn Abi Shaybah 25706","","","كتاب اللباس"
"25707","(۲۵۷۰۷) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَرِہَ الصُّوَرَ فِی الْبُیُوتِ۔","","Musannaf Ibn Abi Shaybah 25707","","","كتاب اللباس"
"25708","(۲۵۷۰۸) حَدَّثَنَا أَبُو نُعَیْمٍ ، عَنْ سُفْیَانَ ، عَنْ مُسْلِمِ بْنِ أَبِی مَرْیَمَ ، عْن أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : لاَ تَدْخُلُ الْمَلاَئِکَۃُ بَیْتًا فِیہِ صُورَۃٌ۔ (مسلم ۱۶۷۲۔ احمد ۲/۳۰۵)","Sahih","Musannaf Ibn Abi Shaybah 25708","","","كتاب اللباس"
"25709","(۲۵۷۰۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنَا أُسَامَۃُ بْنُ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : حدَّثَنِی أَبِی ؛ أَنَّہُ بَنَی عَلَی أَخِیہِ ، فَدَخَلَ ابْنُ عُمَرَ فَرَأَی صُورَۃً فِی الْبَیْتِ فَمَحَاہَا ، أَوْ حَکَّہَا ، ثُمَّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لاَ تَدْخُلُ الْمَلاَئِکَۃُ بَیْتًا فِیہِ کَلْبٌ ، وَلاَ صُورَۃٌ۔ (بخاری ۳۲۲۷)","Da'if","Musannaf Ibn Abi Shaybah 25709","","","كتاب اللباس"
"25710","(۲۵۷۱۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حُسَیْنِ بْنِ وَاقِدٍ ، عَنِ ابن بُرْیدَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَدْخُلُ الْمَلاَئِکَۃُ بَیْتًا فِیہِ کَلْبٌ۔","Hasan","Musannaf Ibn Abi Shaybah 25710","","","كتاب اللباس"
"25711","(۲۵۷۱۱) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ مَکْحُولٍ ، قَالَ : کَانَ فِی تُرْسِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَبْشٌ مُصَوَّرٌ ، فَشَقَّ ذَلِکَ عَلَیْہِ ، فَأَصْبَحَ وَقَدْ ذَہَبَ اللَّہُ بِہِ۔ (ابن سعد ۴۸۹)","","Musannaf Ibn Abi Shaybah 25711","","","كتاب اللباس"
"25712","(۲۵۷۱۲) حَدَّثَنَا شَبَابَۃُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الْحَارِثِ ، عَنْ کُرَیْبٍ مَوْلَی ابْنِ عَبَّاسٍ ، عَنْ أُسَامَۃَ ، قَالَ : دَخَلَتُ وَعَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْکَآبَۃُ ، فَقُلْتُ : مَا لَکَ یَا رَسُولَ اللہِ ؟ قَالَ : إِنَّ جِبْرِیلَ وَعَدَنِی أَنْ یَأْتِیَنِی ، فَلَمْ یَأْتِنِی مُنْذُ ثَلاَثٍ ، فَجَازَ کَلْبٌ ، قَالَ أُسَامَۃُ : فَوَضَعْتُ یَدِی عَلَی رَأْسِی وَصِحْتُ ، فَجَعَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَا لَکَ یَا أُسَامَۃُ ؟ قُلْتُ : جَازَ کَلْبٌ ، فَأَمَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِقَتْلِہِ ، فَقُتِلَ ، فَأَتَاہُ جِبْرِیلُ فَہَشَّ إِلَیْہِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا لَکَ أَبْطَأْتَ وَقَدْ کُنْتَ إِذَا وَعَدْتنِی لَمْ تُخْلِفْنِی ؟ فَقَالَ : إِنَّا لاَ نَدْخُلُ بَیْتًا فِیہِ کَلْبٌ ، وَلاَ تَصَاوِیرُ۔","Hasan","Musannaf Ibn Abi Shaybah 25712","","","كتاب اللباس"
"25713","(۲۵۷۱۳) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ إِسْحَاقَ ، عَنْ أَبِی جَعْفَرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ لاَ یَدْخُلُ بَیْتًا فِیہِ صُورَۃٌ ، وَأَن عَلِیًّا کَانَ لاَ یَدْخُلُ بَیْتًا فِیہِ صُورَۃٌ۔","","Musannaf Ibn Abi Shaybah 25713","","","كتاب اللباس"
"25714","(۲۵۷۱۴) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : أَوَ لَمْ یَکُنْ أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدْخُلُونَ الْخَانَاتِ فِیہَا التَّصَاوِیرُ ؟۔","Sahih","Musannaf Ibn Abi Shaybah 25714","","","كتاب اللباس"
"25715","(۲۵۷۱۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، قَالَ : دَخَلْتُ مَعَ مَسْرُوقٍ صُفَّۃً فِیہَا تَمَاثِیلُ ، فَنَظَرَ إِلَی تِمْثَالٍ مِنْہَا فَقَالَ : مَا ہَذَا ؟ قَالُوا : تِمْثَالُ مَرْیَمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 25715","","","كتاب اللباس"
"25716","(۲۵۷۱۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : کَانَ فِی بَیْتِ إِبْرَاہِیمَ تَابُوتٌ فِیہِ تَمَاثِیلُ۔","","Musannaf Ibn Abi Shaybah 25716","","","كتاب اللباس"
"25717","(۲۵۷۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِالتِّمْثَالِ فِی حِلْیَۃِ السَّیْفِ ، وَلاَ بَأْسَ بِہَا فِی سَمَائِ الْبَیْتِ ، إِنَّمَا یُکْرَہُ مِنْہَا مَا نُصب نَصَبًا ، یَعْنِی الصُّورَۃَ۔","","Musannaf Ibn Abi Shaybah 25717","","","كتاب اللباس"
"25718","(۲۵۷۱۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ، قَالَتْ : دَخَلَ عَلَیَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقَدِ اسْتَتَرْتُ بِقِرَامٍ فِیہِ تَمَاثِیلُ ، فَلَمَّا رَآہُ تَغَیَّرَ لَوْنُہُ وَہَتَکَہُ بِیَدِہِ ، ثُمَّ قَالَ : إِنَّ أَشَدَّ النَّاسِ عَذَابًا یَوْمَ الْقِیَامَۃِ الَّذِی یُشَبِّہُونَ بِخَلْقِ اللہِ۔ (بخاری ۶۱۰۹۔ مسلم ۹۱)","Sahih","Musannaf Ibn Abi Shaybah 25718","","","كتاب اللباس"
"25719","(۲۵۷۱۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَوَکِیع ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ أَشَدَّ النَّاسِ عَذَابًا یَوْمَ الْقِیَامَۃِ الْمُصَوِّرُونَ۔ (بخاری ۵۹۵۰۔ مسلم ۹۸)","Sahih","Musannaf Ibn Abi Shaybah 25719","","","كتاب اللباس"
"25720","(۲۵۷۲۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یُعَذَّبُ الْمُصَوِّرُونَ یَوْمَ الْقِیَامَۃِ ، وَیُقَالُ لَہُمْ : أَحْیُوا مَا خَلَقْتُمْ۔ (بخاری ۵۹۵۱۔ مسلم ۹۷۸۶)","Sahih","Musannaf Ibn Abi Shaybah 25720","","","كتاب اللباس"
"25721","(۲۵۷۲۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُمَارَۃَ ، عَنْ أَبِی زُرْعَۃَ ، قَالَ : دَخَلْتُ مَعَ أَبِی ہُرَیْرَۃَ دَارَ مَرْوَانَ ، فَرَأَی فِیہَا تَصَاوِیرَ ، فَقَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : یَقُولُ اللَّہُ : وَمَنْ أَظْلَمُ مِمَّنْ ذَہَبَ یَخْلُقُ خَلْقًا کَخَلْقِی ؟ فَلْیَخْلُقُوا حَبَّۃً ، وَلْیَخْلُقُوا ذَرَّۃً ، وَلْیَخْلُقُوا شَعِیرَۃً ، قَالَ : ثُمَّ دَعَا بِوَضُوئٍ فَتَوَضَّأَ۔n(بخاری ۷۵۵۹۔ مسلم ۱۶۷۱)","Sahih","Musannaf Ibn Abi Shaybah 25721","","","كتاب اللباس"
"25722","(۲۵۷۲۲) حَدَّثَنَا شَبَابَۃُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ مِہْرَانَ ، عَنْ عُمَیْرٍ مَوْلَی ابْنِ عَبَّاسٍ ، عَنْ أُسَامَۃَ ، قَالَ : دَخَلْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْکَعْبَۃَ ، فَرَأَی فِی الْبَیْتِ صُورَۃً ، فَأَمَرَنِی فَأَتَیْتہ بِدَلْوٍ مِنَ الْمَائِ ، فَجَعَلَ یَضْرِبُ تِلْکَ الصُّورَۃَ ، وَیَقُولُ : قَاتَلَ اللَّہُ قَوْمًا یُصَوِّرُونَ مَا لاَ یَخْلُقُونَ۔ (ابوداؤد ۶۲۳)","Hasan","Musannaf Ibn Abi Shaybah 25722","","","كتاب اللباس"
"25723","(۲۵۷۲۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنِ النَّضْرِ بْنِ أَنَسِ بْنِ مَالِکٍ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ ابْنِ عَبَّاسٍ فَجَعَلَ یُفْتِی ، وَلاَ یَقُولُ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی سَأَلَہُ رَجُلٌ ،فَقَالَ : إِنِّی رَجُلٌ أُصَوِّرُ ہَذِہِ الصُّوَرَ ؟ فَقَالَ لَہُ ابْنُ عَبَّاسٍ : اُدْنُہُ ، فَدَنَا الرَّجُلُ ، فَقَالَ ابْنُ عَبَّاسٍ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ صَوَّرَ صُورَۃً فِی الدُّنْیَا کُلِّفَ أَنْ یَنْفُخَ فِیہَا الرُّوحَ یَوْمَ الْقِیَامَۃِ ، وَلَیْسَ بِنَافِخٍ۔ (بخاری ۵۹۶۳۔ مسلم ۱۶۷۱)","Sahih","Musannaf Ibn Abi Shaybah 25723","","","كتاب اللباس"
"25724","(۲۵۷۲۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَلَمَۃَ أَبِی بِشْرٍ ، عَنْ عِکْرِمَۃَ ؛ فِی قَوْلِہِ : (إِنَّ الَّذِینَ یُؤْذُونَ اللَّہَ وَرَسُولَہُ) قَالَ : أَصْحَابُ التَّصَاوِیرِ۔","","Musannaf Ibn Abi Shaybah 25724","","","كتاب اللباس"
"25725","(۲۵۷۲۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عَطَائِ بْنِ یَزِیدَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ بَیْعَتَیْنِ ، وَعَنْ لِبْسَتَیْنِ ؛ فَأَمَّا الْبَیْعَتَانِ : فَالْمُلاَمَسَۃُ ، وَالْمُنَابَذَۃُ ، وَأَمَّا اللِّبْسَتَانِ : فَاشْتِمَالُ الصَّمَّائِ، وَالاِحْتِبَائُ فِی الثَّوْبِ الْوَاحِدِ، لَیْسَ عَلَی فَرْجِہِ مِنْہُ شَیْئٌ۔(ابوداؤد ۳۳۷۰۔ بخاری ۲۱۴۷)","Sahih","Musannaf Ibn Abi Shaybah 25725","","","كتاب اللباس"
"25726","(۲۵۷۲۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَأَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ خَبِیبِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ حَفْصِ بْنِ عَاصِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ لِبْسَتَیْنِ : عَنِ اشْتِمَالِ الصَّمَّائِ ، وَعَنِ الاِحْتِبَائِ فِی ثَوْبٍ وَاحِدٍ ، مُفْضِیًا بِفَرْجِکَ إِلَی السَّمَائِ۔ (بخاری ۵۸۴۔ ابن ماجہ ۳۵۶۰)","Sahih","Musannaf Ibn Abi Shaybah 25726","","","كتاب اللباس"
"25727","(۲۵۷۲۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَأَبُو أُسَامَۃَ ، عَنْ سَعدِ بْنِ سَعِیدٍ ، عَنْ عَمْرَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ ، نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ لِبْسَتَیْنِ ؛ اشْتِمَالِ الصَّمَّائِ ، وَالاِحْتِبَائِ فِی ثَوْبٍ وَاحِدٍ وَأَنْتَ مُفْضٍ بِفَرْجِک۔n(ابن ماجہ ۳۵۶۱)","Hasan","Musannaf Ibn Abi Shaybah 25727","","","كتاب اللباس"
"25728","(۲۵۷۲۸) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : أَخْبَرَنَا عُبَیْدُ اللہِ بْنُ عَبْدِ اللہِ أَبُو الْمُنِیبِ الْعَتَکِیُّ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ نَہَی عَنْ لِبْسَتَیْنِ ،وَعَنْ مَجْلِسَیْنِ ، أَمَّا اللِّبْسَتَانِ: فَتُصَلِّی فِی السَّرَاوِیلِ لَیْسَ عَلَیْک شَیْئٌ غَیْرُہُ ، وَالرَّجُلُ یُصَلِّی فِی الثَّوْبِ الْوَاحِدِ لاَ یَتَوَشَّحُ بِہِ، وَالْمَجْلسَانِ : یَحْتَبِی بِالثَّوْبِ الْوَاحِدِ فَتُبْصَرُ عَوْرَتُہُ ، وَیَجْلِسُ بَیْنَ الظِّلِّ وَالشَّمْسِ۔ (ابوداؤد ۶۳۷)","Da'if","Musannaf Ibn Abi Shaybah 25728","","","كتاب اللباس"
"25729","(۲۵۷۲۹) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ لِبْسَتَیْنِ ؛ الصَّمَّائُ : وَہُوَ أَنْ یَلْتَحِفَ فِی الثَّوْبِ الْوَاحِدِ ، یَرْفَعُ جَانِبَہُ عَنْ مَنْکبِیہِ ، لَیْسَ عَلَیْہِ ثَوْبٌ غَیْرُہُ ، أَوْ یَحْتَبِی الرَّجُلُ بِالثَّوْبِ الْوَاحِدِ ، لَیْسَ بَیْنَ فَرْجِہِ وَبَیْنَ السَّمَائِ شَیْئٌ، یَعْنِی سِتْرًا۔ (نسائی ۹۷۴۸)","Da'if","Musannaf Ibn Abi Shaybah 25729","","","كتاب اللباس"
"25730","(۲۵۷۳۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَأَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَعَنَ الْوَاصِلَۃَ وَالْمُسْتَوْصِلَۃ ، وَالْوَاشِمَۃَ وَالْمُسْتَوْشِمَۃ۔ (بخاری ۵۹۳۷۔ مسلم ۱۱۹)","Sahih","Musannaf Ibn Abi Shaybah 25730","","","كتاب اللباس"
"25731","(۲۵۷۳۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، قَالَ: حدَّثَنَا الْقَاسِمُ، وَمَکْحُولٌ، عَنْ أَبِی أُمَامَۃَ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَعَنَ یَوْمَ خَیْبَرَ الْوَاصِلَۃَ وَالْمَوْصُولَۃَ ،وَالْوَاشِمَۃَ وَالْمَوْشُومَۃَ ، وَالْخَامِشَۃَ وَجْہَہَا ، وَالشَّاقَّۃَ جَیْبَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 25731","","","كتاب اللباس"
"25732","(۲۵۷۳۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ فَاطِمَۃَ ، عَنْ أَسْمَائَ ، قَالَتْ : جَائَتِ امْرَأَۃٌ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : إِنَّ ابْنَتِی عُرَیِّسٌ ، وَقَدْ أَصَابَتْہَا الْحَصْبَۃُ ، فَتَمَرَّقَ شَعْرُہَا ، أَفَأَصِلُ لَہَا فِیہِ ؟ فَقَالَ لَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَعَنَ اللَّہُ الْوَاصِلَۃَ وَالْمُسْتَوْصِلَۃ۔ (بخاری ۵۹۳۶۔ مسلم ۱۶۷۶)","Sahih","Musannaf Ibn Abi Shaybah 25732","","","كتاب اللباس"
"25733","(۲۵۷۳۳) حَدَّثَنَا أَبُو نُعَیْمٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُزَیْلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْوَاشِمَۃَ وَالْمَوْشُومَۃَ ، وَالْوَاصِلَۃَ وَالْمَوْصُولَۃَ۔ (ترمذی ۱۱۲۰۔ احمد ۱/۴۴۸)","Sahih","Musannaf Ibn Abi Shaybah 25733","","","كتاب اللباس"
"25734","(۲۵۷۳۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ أَبِی أُسَامَۃَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَعَنَ الْوَاشِمَۃَ وَالْمُسْتَوْشِمَۃ ، وَالْوَاصِلَۃَ وَالْمَوْصُولَۃَ۔ (احمد ۱/۲۵۱)","Sahih","Musannaf Ibn Abi Shaybah 25734","","","كتاب اللباس"
"25735","(۲۵۷۳۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا مُجَالِدٌ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ عَبْدِ اللہِ ، عَنْ عَلِیٍّ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَعَنَ الْوَاشِمَۃَ وَالْمَوْشُومَۃَ۔","Munkar","Musannaf Ibn Abi Shaybah 25735","","","كتاب اللباس"
"25736","(۲۵۷۳۶) حَدَّثَنَا حَفْصٌ ، عَنْ رَزِینٍ ، قَالَ : سَمِعْتُ فَاطِمَۃَ بِنْتَ عَلِیِّ بْنِ أَبِی طَالِبٍ تَقُولُ : لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَاصِلَۃَ الشَّعْرِ بِالشَّعْرِ۔","","Musannaf Ibn Abi Shaybah 25736","","","كتاب اللباس"
"25737","(۲۵۷۳۷) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : سَمِعْتُ الْحَسَنَ بْنَ مُسْلِمٍ یُحَدِّثُ عَنْ صَفِیَّۃَ بِنْتِ شَیْبَۃَ ، عَنْ عَائِشَۃَ ؛ أَنَّ جَارِیَۃً مِنَ الأَنْصَارِ تَزَوَّجَتْ ، وَأَنَّہَا مَرِضَتْ فَتَمَرَّطَ شَعْرُہَا ، فَأَرَادُوا أَنْ یَصِلُوہُ ، فَسَأَلُوا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ ذَلِکَ ؟ فَلَعَنَ الْوَاصِلَۃَ وَالْمُسْتَوْصِلَۃ۔n(مسلم ۱۶۷۷۔ احمد ۶/۱۱۱)","Sahih","Musannaf Ibn Abi Shaybah 25737","","","كتاب اللباس"
"25738","(۲۵۷۳۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قدِمَ مُعَاوِیَۃُ الْمَدِینَۃَ ، فَخَطَبَنَا وَأَخْرَجَ کُبَّۃً مِنْ شَعْرٍ ، فَقَالَ : مَا کُنْتُ أَرَی أَنَّ أَحَدًا یَفْعَلُہُ إِلاَّ الْیَہُودَ ، إِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَلَغَہُ فَسَمَّاہُ الزُّورَ۔ (بخاری ۳۴۸۸۔ مسلم ۱۶۸۰)","Sahih","Musannaf Ibn Abi Shaybah 25738","","","كتاب اللباس"
"25739","(۲۵۷۳۹) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ، عَنْ عِکْرِمَۃَ؛ أَنَّہُ کَرِہَ الْعِقْصَۃَ الَّتِی تَجْعَلُہَا النِّسَائُ فِی رُؤُوسِہِنَّ۔","","Musannaf Ibn Abi Shaybah 25739","","","كتاب اللباس"
"25740","(۲۵۷۴۰) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا فُلَیْحٌ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَعَنَ اللَّہُ الْوَاصِلَۃَ وَالْمُسْتَوْصِلَۃ ،وَالْوَاشِمَۃَ وَالْمُسْتَوْشِمَۃ۔n(احمد ۲/۳۳۹)","Hasan","Musannaf Ibn Abi Shaybah 25740","","","كتاب اللباس"
"25741","(۲۵۷۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِالْعَقْصَۃِ تُوضَعُ وَضْعًا۔","","Musannaf Ibn Abi Shaybah 25741","","","كتاب اللباس"
"25742","(۲۵۷۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی عَقِیلٍ ، عَنْ بُہَیَّۃَ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا نَہَتْ عَنِ الْوَصْلِ فِی الشَّعْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 25742","","","كتاب اللباس"
"25743","(۲۵۷۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی حَنِیفَۃَ ، عَنِ الْہَیْثُمَّ ، عَنْ أَبی ثَوْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ بِالْوِصَالِ إِذَا کَانَ صُوفًا۔","Da'if","Musannaf Ibn Abi Shaybah 25743","","","كتاب اللباس"
"25744","(۲۵۷۴۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ؛ رَأَی عَلَی رَحْلِ ابْنِ عُمَرَ قَطِیفَۃً قَیْصَرَانِیَّۃً۔","Sahih","Musannaf Ibn Abi Shaybah 25744","","","كتاب اللباس"
"25745","(۲۵۷۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَوْ قَبَّحَ اللَّہُ ، کُلَّ رَحْلٍ أَُحَیْمِرَ۔","","Musannaf Ibn Abi Shaybah 25745","","","كتاب اللباس"
"25746","(۲۵۷۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ وَاصِلٍ ، عَنِ الْمَعْرُورِ ، عَنْ حُذَیْفَۃَ ؛ أَنَّ عُمَرَ رَأَی امْرَأَۃً عَلَی رَحْلِہَا سُیور حُمْر ، قَالَ : فَأَمَرَنِی أَنْ أَقْطَعَہَا ، قَالَ : فَقُلْتُ : إِنَّہَا خَشَبٌ ، فَتَرَکَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 25746","","","كتاب اللباس"
"25747","(۲۵۷۴۷) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ ابْنَ مَسْعُودٍ اسْتَعَارَ دَابَّۃً ، فَأُتِیَ بِہَا عَلَیْہَا صُفَّۃُ أُرْجُوَانٍ ، فَنَزَعَہَا ثُمَّ رَکِبَ۔","Da'if","Musannaf Ibn Abi Shaybah 25747","","","كتاب اللباس"
"25748","(۲۵۷۴۸) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ ہَارُونَ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ الأَشْعَرِیَّ أُتِیَ بِدَابَّۃٍ عَلَیْہَا صُفَّۃُ أُرْجُوَانٍ ، فَأَمَرَ أَنْ تُنْزَعَ۔","","Musannaf Ibn Abi Shaybah 25748","","","كتاب اللباس"
"25749","(۲۵۷۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْوَلِیدِ بْنِ کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرو بْنِ عَطَائٍ ، عَنْ رَجُلٍ مِنْ بَنِی حَارِثَۃَ ، عَنْ رَافِعِ بْنِ خَدِیجٍ ، قَالَ : خَرَجْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَرَأَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَوَاحِلَنَا وَعَلَی إِبِلِنَا أَکْسِیَۃً فِیہَا خُیُوطُ عِہْنٍ حُمْرٌ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلاَ أَرَی ہَذِہِ الْحُمْرَۃَ قَدْ عَلَتْکُمْ ؟ فَقُمْنَا سِرَاعًا لِقَوْلِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، حَتَّی نَفَرَ بَعْضُ إِبِلِنَا، قَالَ : فَأَخَذْنَا الأَکْسِیَۃَ فَنَزَعْنَاہَا مِنْہَا۔ (ابوداؤد ۴۰۶۷۔ احمد ۳/۴۶۳)","Da'if","Musannaf Ibn Abi Shaybah 25749","","","كتاب اللباس"
"25750","(۲۵۷۵۰) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُبَیْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ خَاتَمِ الذَّہَبِ ، وَعَنِ الْمِیثَرَۃِ ، یَعْنِی الْحَمْرَائَ۔ (ترمذی ۲۸۰۸۔ ابوداؤد ۴۰۴۸)","Hasan","Musannaf Ibn Abi Shaybah 25750","","","كتاب اللباس"
"25751","(۲۵۷۵۱) حَدَّثَنَا عَلِیُّ بْنُ حُصَیْنٍ ، قَالَ : أَخْبَرَنَا الْمَاجِشُونُ عَبْدُ الْعَزِیزِ بْنُ عَبْدِ اللہِ ، عَنْ یَعْقُوبَ بْنِ عُتْبَۃَ بْنِ الْمُغِیرَۃِ بْنِ الأَخْنَسِ ، قَالَ : رَأَیْتُ السَّائِبَ ابْنَ أُخْتِ نَمِرٍ یَرْکَبُ بِالْمِیثَرَۃِ الْحَمْرَائِ۔","","Musannaf Ibn Abi Shaybah 25751","","","كتاب اللباس"
"25752","(۲۵۷۵۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنِی یَحْیَی بْنُ أَیُّوبَ ، قَالَ : أَخْبَرَنِی عَیَّاشُ بْنُ عَبَّاسٍ الْحِمْیَرِیُّ ، عَنْ أَبِی الْحُصَیْنِ الْحَجْرِیِّ الْہَیْثُم ، عَنْ عَامِرٍ الْحَجْرِیِّ ، قَالَ : سَمِعْتُ أَبَا رَیْحَانَۃَ صَاحِبَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَی عَنْ رُکُوبِ النُّمُورِ۔","Da'if","Musannaf Ibn Abi Shaybah 25752","","","كتاب اللباس"
"25753","(۲۵۷۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْمُعْتَمِرِ ، عَنِ ابْنِ سِیرِینَ ، عَنْ مُعَاوِیَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ رُکُوبِ الْخَزِّ وَالنُّمُورِ۔n قَالَ ابْنُ سِیرِینَ : وَکَانَ مُعَاوِیَۃُ لاَ یُتَّہَمُ فِی الْحَدِیثِ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔n(ابوداؤد ۴۱۲۶۔ ابن ماجہ ۳۶۵۶)","Sahih","Musannaf Ibn Abi Shaybah 25753","","","كتاب اللباس"
"25754","(۲۵۷۵۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ، عَنِ حَجَّاجِ، عَنْ أَبِی الزُّبَیْرِ، عَنْ جَابِرٍ، قَالَ: لاَ بَأْسَ بِجُلُودِ النُّمُورِ إِذَا دُبِغَتْ۔","Hasan","Musannaf Ibn Abi Shaybah 25754","","","كتاب اللباس"
"25755","(۲۵۷۵۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ؛ أَنَّ أَبَاہُ کَانَ یَکُونُ عَلَی سُرُوجِہِ النُّمُورُ ، أَوْ جُلُودُ السِّبَاعِ۔","","Musannaf Ibn Abi Shaybah 25755","","","كتاب اللباس"
"25756","(۲۵۷۵۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : ذُکِرَ عِنْدَ مُحَمَّدٍ جُلُودُ النُّمُورِ ، فَقَالَ : إِنَّمَا یُکْرَہُ أَنْ یُصَلَّی عَلَیْہَا ، وَکَانَ مُحَمَّدٌ لاَ یَرَی بَأْسًا بِالرُّکُوبِ عَلَیْہَا ، وَقَالَ : مَا أَعْلَمُ أَحَدًا تَرَکَ ہَذِہِ الْجُلُودَ تَأَثُّمًا۔","No Data Available","Musannaf Ibn Abi Shaybah 25756","","","كتاب اللباس"
"25757","(۲۵۷۵۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ عَلِیِّ بْنِ الْحَکَمِ، قَالَ: سَأَلْتُ الْحَکَمَ عْن جُلُودِ النُّمُورِ؟ فَقَالَ: تُکْرَہُ جُلُودُ السِّبَاعِ۔","","Musannaf Ibn Abi Shaybah 25757","","","كتاب اللباس"
"25758","(۲۵۷۵۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الْحَجَّاجِ ، عَنِ الْحَکَمِ ؛ أَنَّ عُمَرَ کَتَبَ إِلَی أَہْلِ الشَّامِ یَنْہَاہُمْ أَنْ یَرْکَبُوا عَلَی جُلُودِ السِّبَاعِ۔","","Musannaf Ibn Abi Shaybah 25758","","","كتاب اللباس"
"25759","(۲۵۷۵۹) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ أَشْعَثَ ، عَ??ِ ابْنِ سِیرِینَ ؛ أَنَّ ابْنَ مَسْعُودٍ اسْتَعَارَ دَابَّۃً ، فَأُتِیَ بِہَا عَلَیْہَا صُفَّۃُ نُمُورٍ ، فَنَزَعَہَا ثُمَّ رَکِبَ۔","Da'if","Musannaf Ibn Abi Shaybah 25759","","","كتاب اللباس"
"25760","(۲۵۷۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَکِیمِ بْنِ جُبَیْرٍ ، عَنْ عَلِیِّ بْنِ حُسَیْنٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُسْتَرَ الْجَدْرُ۔ (بیہقی ۲۷۲)","Hasan","Musannaf Ibn Abi Shaybah 25760","","","كتاب اللباس"
"25761","(۲۵۷۶۱) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ فُضَیْلِ بْنِ غَزْوَانَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : بَلَغَ عُمَرَ أَنَّ ابْنًا لَہُ سَتَرَ حِیطَانَہُ ، فَقَالَ : وَاللَّہِ لَئِنْ کَانَ کَذَلِکَ لأَحْرِقَنَّ بَیْتَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25761","","","كتاب اللباس"
"25762","(۲۵۷۶۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ ، قَالَ : أَعْرَسْتُ فِی عَہْدِ أَبِی فَآذَنَ أَبِی النَّاسَ ، وَکَانَ فِیمَنْ آذَنَ أَبُو أَیُّوبَ ، وَقَدْ سَتَرْتُ بَیْتِی بِجُنَادِیٍّ أَخْضَرَ ، فَجَائَ أَبُو أَیُّوبَ فَدَخَلَ وَأَبِی قَائِمٌ یَنْظُرُ ، فَإِذَا الْبَیْتُ مُسْتَر بِجُنَادِیٍّ أَخْضَرَ ، فَقَالَ : أَی عَبْدَ اللہِ ، تَسْتُرُونَ الْجُدُرَ ؟ فَقَالَ أَبِی ، وَاسْتَحْیَی : غَلَبَنَا النِّسَائُ یَا أَبَا أَیُّوبَ ، قَالَ : مَنْ أَخْشَی أَنْ یَغْلِبَہُ النِّسَائُ فَلاَ أَخْشَی أَنْ یَغْلِبَنَّکَ ، لاَ أَطْعَمُ لَکَ طَعَامًا ، وَلاَ أَدْخُلُ لَکَ بَیْتًا ، ثُمَّ خَرَجَ۔ (بیہقی ۲۷۲)","Hasan","Musannaf Ibn Abi Shaybah 25762","","","كتاب اللباس"
"25763","(۲۵۷۶۳) حَدَّثَنَا حَفْصٌ ، عَنْ مَیْمُونَ أَبِی عَبْدِ اللہِ ، عَنِ الضَّحَّاکِ بْنِ مُزَاحِمٍ ؛ أَنَّہُ کَرِہَ رُکُوبَ النِّسَائِ السُّرُوجَ۔","","Musannaf Ibn Abi Shaybah 25763","","","كتاب اللباس"
"25764","(۲۵۷۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، قَالَ : کَانُوا یَکْرَہُونَ مَرْکَبَ الرَّجُلِ لِلْمَرْأَۃِ ، وَمَرْکَبَ الْمَرْأَۃِ لِلرَّجُلِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25764","","","كتاب اللباس"
"25765","(۲۵۷۶۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یَکْرَہُونَ زِیَّ الرِّجَالِ لِلنِّسَائِ ، وَزِیَّ النِّسَائِ لِلرِّجَالِ۔","","Musannaf Ibn Abi Shaybah 25765","","","كتاب اللباس"
"25766","(۲۵۷۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أُمِّ شَبِیبٍ ، عَنْ أُمِّ عُمَرَ ؛ أَنَّ امْرَأَۃَ الزُّبَیْرِ قَالَتْ : سَمِعْتُ عُمَرَ یَقُولُ: یَا مَعْشَرَ النِّسَائِ، أخْفِینَ الْحِنَّائَ، وَارْفَعْنَ الْحُجَز، وَسَمِعْتُہُ یَقُولُ: أُنْشِدُ اللَّہَ امْرَأَۃً تُصَلِّی فِی الْحُجَزِ۔","Sahih","Musannaf Ibn Abi Shaybah 25766","","","كتاب اللباس"
"25767","(۲۵۷۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، قَالَ : سَأَلْتُ ، أَوْ سَمِعْتُ ، أَوْ سُئِلَ عَنْ شِسْعِ الْحَدِیدِ ؟فَقَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 25767","","","كتاب اللباس"
"25768","(۲۵۷۶۸) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا الْمُغِیرَۃُ بْنُ مُسْلِمٍ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، قَالَ : کَتَبَ عُمَرُ إِلَی أَبِی مُوسَی الأَشْعَرِیِّ : إِیَّاکَ وَہَذِہِ الرَّکْبَ الْحَدِیدَ۔","","Musannaf Ibn Abi Shaybah 25768","","","كتاب اللباس"
"25769","(۲۵۷۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ طُعْمَۃَ الْجَعْفَرِیِّ ، قَالَ : رَأَیْتُ مُوسَی بْنَ طَلْحَۃَ قَدْ شَدَّ أَسْنَانَہُ بِالذَّہَبِ۔","","Musannaf Ibn Abi Shaybah 25769","","","كتاب اللباس"
"25770","(۲۵۷۷۰) حَدَّثَنَا مَعْنُ بْنُ عِیسَی، عَنْ ثَابِتِ بْنِ قَیْسٍ، قَالَ: رَأَیْتُ نَافِعَ بْنَ جُبَیْرٍ مَرْبُوطَۃً أَسْنَانُہُ بِخُرْصَانِ الذَّہَب۔","","Musannaf Ibn Abi Shaybah 25770","","","كتاب اللباس"
"25771","(۲۵۷۷۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ ؛ أَنَّ الْحَسَنَ شَدَّ أَسْنَانَہُ بِذَہَبٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 25771","","","كتاب اللباس"
"25772","(۲۵۷۷۲) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ جَعْفَرِ بْنِ حَیَّانَ ، عَنْ حَمَّادٍ ، قَالَ : رَأَیْتُ الْمُغِیرَۃَ بْنَ عَبْدِ اللہِ یَرْبِطُ أَسْنَانَہُ بِذَہَبٍ ، قَالَ : فَسَأَلْتُ إِبْرَاہِیمَ ؟ فَقَالَ : لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25772","","","كتاب اللباس"
"25773","(۲۵۷۷۳) حَدَّثَنَا ابْنُ مُبَارَکٍ، عَنْ جَعْفَرِ بْنِ حَیَّانَ ، قَالَ: حدَّثَنِی ابْنُ طَرَفَۃَ بْنِ عَرْفَجَۃَ ؛ بِأنَّ جَدَّہُ أُصِیبَ أَنْفُہُ یَوْمَ الْکُلاَبِ، فَاتَّخَذَ أَنْفًا مِنْ وَرِقٍ فَأَنْتَنَ عَلَیْہِ، فَأَمَرَہ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَتَّخِذَ أَنْفًا مِنْ ذَہَبٍ۔ (ابوداؤد ۴۲۲۹۔ ترمذی ۱۷۷۰)","Hasan","Musannaf Ibn Abi Shaybah 25773","","","كتاب اللباس"
"25774","(۲۵۷۷۴) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا حَمَّادٌ ، قَالَ : رَأَیْتُ ثَابِتًا الْبُنَانِیَّ مَشْدُودَ الأَسْنَانِ بِذَہَبٍ۔","","Musannaf Ibn Abi Shaybah 25774","","","كتاب اللباس"
"25775","(۲۵۷۷۵) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن لَیْثٍ ، عَنِ الْمُہَاجِرِ ، قَالَ : قَالَ ابْنُ عُمَرَ : مَنْ لَبِسَ رِدَائَ شُہْرَۃٍ ، أَوْ ثَوْبَ شُہْرَۃٍ أَلْبَسَہُ اللَّہُ نَارًا یَوْمَ الْقِیَامَۃِ۔ (ابوداؤد ۴۰۲۵۔ ابن ماجہ ۳۶۰۷)","Da'if","Musannaf Ibn Abi Shaybah 25775","","","كتاب اللباس"
"25776","(۲۵۷۷۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الْحُصَیْنِ ، قَالَ : کَانَ زُبَیْدٌ الْیَامِیُّ یَلْبَسُ بُرْنُسًا ، قَالَ : فَسَمِعْتُ إِبْرَاہِیمَ عَابَہُ عَلَیْہِ ، قَالَ : فَقُلْتُ لَہُ : إِنَّ النَّاسَ قَدْ کَانُوا یَلْبَسُونَہَا ، قَالَ : أَجَلْ ، وَلَکِنْ قَدْ فَنِیَ مَنْ کَانَ یَلْبَسُہَا ، فَإِنْ لَبِسَہَا أَحَدٌ الْیَوْمَ شَہَرُوہُ وَأَشَارُوا إِلَیْہِ بِالأَصَابِعِ۔","","Musannaf Ibn Abi Shaybah 25776","","","كتاب اللباس"
"25777","(۲۵۷۷۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ لَیْثٍ ، عَنْ شَہْرٍ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : مَنْ رَکِبَ مَشْہُورًا مِنَ الدَّوَابِّ ، أَوْ لَبِسَ مَشْہُورًا مِنَ الثِّیَابِ ، أَعْرَضَ اللَّہُ عَنْہُ مَا دَامَ عَلَیْہِ ، وَإِنْ کَانَ عَلَیْہِ کَرِیمًا۔","Da'if","Musannaf Ibn Abi Shaybah 25777","","","كتاب اللباس"
"25778","(۲۵۷۷۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ لَیْثٍ ، عَن مُہَاجِرٍ أَبِی الْحَسَنِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ لَبِسَ شُہْرَۃً مِنَ الثِّیَابِ أَلْبَسَہُ اللَّہُ ذِلَّۃً۔","Da'if","Musannaf Ibn Abi Shaybah 25778","","","كتاب اللباس"
"25779","(۲۵۷۷۹) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْقَزَعِ۔ (بخاری ۵۹۲۱۔ ابن ماجہ ۳۶۳۸)","Sahih","Musannaf Ibn Abi Shaybah 25779","","","كتاب اللباس"
"25780","(۲۵۷۸۰) حَدَّثَنَا وَکِیعٌ ، وَابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ الْحَسَنِ ، قَالَ : سَمِعْتُ أُمِّی فَاطِمَۃَ بِنْتَ الْحُسَیْنِ تَنْہَی عَنِ الْقَزَعِ۔","Hasan","Musannaf Ibn Abi Shaybah 25780","","","كتاب اللباس"
"25781","(۲۵۷۸۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ عُمَرَ بْنِ نَافِعٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْقَزَعِ ، وَالْقَزَعُ : أَنْ یُحْلَقَ مِنْ رَأْسِ الصَّبِیِّ مَوْضِعٌ وَیُتْرَکَ مَوْضِعٌ۔n(بخاری ۵۹۲۰۔ مسلم ۱۶۷۵)","Sahih","Musannaf Ibn Abi Shaybah 25781","","","كتاب اللباس"
"25782","(۲۵۷۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ أَبِی سَلاَّمٍ ، قَالَ : دَخَلْتُ عَلَی عَائِشَۃَ وَفِی رَأْسِی قَزَعٌ ، فَأَمَرَتْ بِہِ فَجُزَّ ، أَوْ حُلِقَ۔","Da'if","Musannaf Ibn Abi Shaybah 25782","","","كتاب اللباس"
"25783","(۲۵۷۸۳) حَدَّثَنَا صَفْوَانُ بْنُ عِیسَی ، عَنْ عَبْدِ الأَعْلَی بْنِ عَبْدِ اللہِ بْنِ أَبِی فَرْوَۃَ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ ، قُلْتُ : رَجُلٌ فِی خَ??تَمِہِ مِثْلُ رَأْسِ الطَّیْرِ ؟ فَقَالَ : یَا ابْنَ أَخِی ، مَا عَلِمْنَا أَحَدًا مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَخَتَّمَ لاَ أَبُو بَکْرٍ ، وَلاَ عُمَرَ ، وَلاَ فُلاَنًا ، وَلاَ فُلاَنًا حَتَّی عَدَّ نَاسًا مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَعَدْتُ عَلَیْہِ مِرَارًا فَکَأَنَّہُ یَکْرَہُ الْخَاتَمَ۔","","Musannaf Ibn Abi Shaybah 25783","","","كتاب اللباس"
"25784","(۲۵۷۸۴) حَدَّثَنَا عَفَّانُ، قَالَ: حدَّثَنَا ہَمَّامُ، عَنْ لَیْثٍ، عَنْ عَطَائٍ، وَطَاوُوسٍ، وَمُجَاہِدٍ؛ أَنَّہُمْ کَانُوا لاَ یَتَخَتَّمُونَ۔","No Data Available","Musannaf Ibn Abi Shaybah 25784","","","كتاب اللباس"
"25785","(۲۵۷۸۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی، عَنْ عَبْدِ اللہِ بْنِ عُکَیْمٍ ، قَالَ: أَتَانَا کِتَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنْ لاَ تَنْتَفِعُوا مِنَ الْمَیْتَۃِ بِإِہَابٍ ، وَلاَ عَصَبٍ۔n(ابن ماجہ ۳۶۱۳۔ احمد ۴/۳۱۰)","Sahih","Musannaf Ibn Abi Shaybah 25785","","","كتاب اللباس"
"25786","(۲۵۷۸۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ اللہِ بْنِ عُکَیْمٍ ، قَالَ : أَتَانَا کِتَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَنَحْنُ بِجُہَیْنَۃَ : لاَ تَنْتَفِعُوا مِنَ الْمَیْتَۃِ بِإِہَابٍ ، وَلاَ عَصَبٍ۔ (ترمذی ۱۷۲۹۔ ابن ماجہ ۳۶۱۳)","Sahih","Musannaf Ibn Abi Shaybah 25786","","","كتاب اللباس"
"25787","(۲۵۷۸۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ اللہِ بْنِ عُکَیْمٍ ، قَالَ : أَتَانَا کِتَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا غُلاَمٌ : أَنْ لاَ تَنْتَفِعُوا بِإِہَابِ مَیْتَۃٍ ، وَلاَ عَصَبٍ۔n(ابوداؤد ۴۱۲۴۔ ابن ماجہ ۳۶۱۳)","Sahih","Musannaf Ibn Abi Shaybah 25787","","","كتاب اللباس"
"25788","(۲۵۷۸۸) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنْ شَعْرِ الْخِنْزِیرِ ، یُعْمَلُ بِہِ ؟ فَکَرِہَاہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25788","","","كتاب اللباس"
"25789","(۲۵۷۸۹) حَدَّثَنَا حَفْصٌ ، عَنْ أَبِی الْحَسَنِ ، عَنْ أَبِی جَعْفَرٍ (ح) وَعَنْ إِسْمَاعِیلَ ، عَنِ الْحَسَنِ ؛ أَنَّہُمَا رَخَّصَا فِی شَعْرِ الْخِنْزِیرِ یُخْرَزُ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25789","","","كتاب اللباس"
"25790","(۲۵۷۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ لاَ یَلْبَسُ خُفًّا خُرِزَ بِشَعْرِ خِنْزِیرٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 25790","","","كتاب اللباس"
"25791","(۲۵۷۹۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ شَیْخٍ مِنْ أَہْلِ وَاسِطَ ، قَالَ : سَأَلْتُ أَبَا عِیَاضٍ عَنْ شَعْرِ الْخِنْزِیرِ ، یُوضَعُ عَلَی جُرْحِ الدَّابَّۃِ ؟ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 25791","","","كتاب اللباس"
"25792","(۲۵۷۹۲) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ عَلِیٍّ ، قَالَ : نَہَانَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ نَتَخَتَّمَ فِی ہَذِہِ ، وَہَذِہِ ، یَعْنِی السَّبَّابَۃَ وَالْوُسْطَی۔ (مسلم ۶۴۔ ترمذی ۱۷۸۶)","Sahih","Musannaf Ibn Abi Shaybah 25792","","","كتاب اللباس"
"25793","(۲۵۷۹۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، قَالَ : کَانَ إِبْرَاہِیمُ یَکْرَہُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25793","","","كتاب اللباس"
"25794","(۲۵۷۹۴) حَدَّثَنَا وَکِیعٌ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عنْ أَبِیْہِ ، عَنْ عَائِشَۃَ ، قَالَتْ: سَتَرْتُ سَہْوَۃً لِی ، تعْنِی الدَّاخِلَ ، بِسِتر فِیہِ تَصَاوِیرُ ، فَلَمَّا قَدِمَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ہَتَکَہُ ، فَجَعَلْتُ مِنْہُ مِنْبَذَتَیْنِ ، فَرَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُتَّکِئًا عَلَی إِحْدَاہُمَا۔ (مسلم ۹۲۔ ابن ماجہ ۳۶۵۳)","Hasan","Musannaf Ibn Abi Shaybah 25794","","","كتاب اللباس"
"25795","(۲۵۷۹۵) حَدَّثَنَا حَفْصٌ ، عَنِ الْجَعْدِ رَجُلٍ مِنْ أَہْلِ الْمَدِینَۃِ ، قَالَ : حَدَّثَتْنِی ابْنَۃُ سَعْدٍ ؛ أَنَّ أَبَاہَا جَائَ مِنْ فَارِسَ بِوَسَائِدَ فِیہَا تَمَاثِیلُ ، فَکُنَّا نَبْسُطُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 25795","","","كتاب اللباس"
"25796","(۲۵۷۹۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، قَالَ : رَأَیْتُ سَالِمَ بْنَ عَبْدِ اللہِ مُتَّکِئًا عَلَی وِسَادَۃٍ حَمْرَائَ فِیہَا تَمَاثِیلُ ، فَقُلْتُ لَہُ ؟ فَقَالَ : إِنَّمَا یُکْرَہُ ہَذَا لِمَنْ یَنْصِبُہُ وَیَصْنَعُہُ۔","","Musannaf Ibn Abi Shaybah 25796","","","كتاب اللباس"
"25797","(۲۵۷۹۷) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَتَّکِیئُ عَلَی الْمَرَافِقِ فِیہَا التَّمَاثِیلُ ؛ الطَّیْرُ وَالرِّجَالُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25797","","","كتاب اللباس"
"25798","(۲۵۷۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَلْقَمَۃَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : نُبِّئْتُ عَنْ حِطَّانَ بْنِ عَبْدِ اللہِ ، قَالَ : أَتَی عَلَیَّ صَاحِبٌ لِی فَنَادَانِی فَأَشْرَفْت عَلَیْہِ ، فَقَالَ : قُرِئَ عَلَیْنَا کِتَابُ أَمِیرِ الْمُؤْمِنِینَ ، یَعْزِمُ عَلَی مَنْ کَانَ فِی بَیْتِہِ سِتْرٌ مَنْصُوبٌ فِیہِ تَصَاوِیرُ لِمَا وَضَعَہُ ، فَکَرِہْتُ أَنْ أَبِیْتَ عَاصِیًا ، فَقُمْنَا إِلَی قِرَامٍ لَنَا فَوَضَعْتُہُ ، قَالَ مُحَمَّدٌ : وَکَانُوا لاَ یَرَوْنَ مَا وُطِئَ وَبُسِطَ مِنَ التَّصَاوِیرِ مِثْلُ الَّذِی نُصِبَ۔","Da'if","Musannaf Ibn Abi Shaybah 25798","","","كتاب اللباس"
"25799","(۲۵۷۹۹) حَدَّثَنَا إِسْمَاعِیلُ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، قَالَ : کَانَ یُقَالُ فِی التَّصَاوِیرِِ فِی الوَسَاِئد وَالبُسُطِ التِی تُوطَأَ : ہُوَ ذل لَہَا۔","","Musannaf Ibn Abi Shaybah 25799","","","كتاب اللباس"
"25800","(۲۵۸۰۰) حَدَّثَنَا أَبُو مُعَاوِیَۃ ، عَنْ عَاصِم ، عَنْ عِکْرِمَۃَ ، قَالَ : کَانُوا یَکْرَہُونَ مَا نُصِبَ مِنَ التَّمَاثِیلِ نَصْبًا ، وَلاَ یَرَوْنَ بَأْسًا بِمَا وَطِئَتِ الأَقْدَامُ۔","","Musannaf Ibn Abi Shaybah 25800","","","كتاب اللباس"
"25801","(۲۵۸۰۱) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِمَا وُطِئَ مِنَ التَّصَاوِیرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25801","","","كتاب اللباس"
"25802","(۲۵۸۰۲) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُصَوَّرَ الشَّجَرُ الْمُثَمَّرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25802","","","كتاب اللباس"
"25803","(۲۵۸۰۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ فِی مَجْلِسِ مُحَمَّدٍ وَسَائِدُ فِیہَا تَمَاثِیلُ عَصَافِیرَ ، فَکَانَ أُنَاسٌ یَقُولُونَ فِی ذَلِکَ ، فَقَالَ مُحَمَّدٌ : إِنَّ ہَؤُلاَئِ قَدْ أَکْثَرُوا ، فَلَوْ حَوَّلْتُمُوہَا۔","","Musannaf Ibn Abi Shaybah 25803","","","كتاب اللباس"
"25804","(۲۵۸۰۴) حَدَّثَنَا ابْنُ یَمَانٍ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ، قَالَ: لاَ بَأْسَ بِالصُّورَۃِ إِذَا کَانَتْ تُوطَأُ۔","","Musannaf Ibn Abi Shaybah 25804","","","كتاب اللباس"
"25805","(۲۵۸۰۵) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنِ الرَّبِیعِ بْنِ الْمُنْذِرِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ بَأْسَ بِالصُّورَۃِ إِذَا کَانَتْ تُوطَأُ۔","","Musannaf Ibn Abi Shaybah 25805","","","كتاب اللباس"
"25806","(۲۵۸۰۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی التَّمَاثِیلِ ، مَا کَانَ مَبْسُوطًا یُوطَأُ وَیُبْسَطُ فَلاَ بَأْسَ بِہِ ، وَمَا کَانَ یُنْصَبُ فَإِنِّی أَکْرَہُہَا۔","","Musannaf Ibn Abi Shaybah 25806","","","كتاب اللباس"
"25807","(۲۵۸۰۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّہُ کَانَ یَکْرَہُ التَّصَاوِیرَ ، مَا نُصِبَ مِنْہَا وَمَا بُسِطَ۔","","Musannaf Ibn Abi Shaybah 25807","","","كتاب اللباس"
"25808","(۲۵۸۰۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، قَالَ : إِنَّمَا الصُّورَۃُ الرَّأْسُ ، فَإِذَا قُطِعَ فَلاَ بَأْسَ۔","No Data Available","Musannaf Ibn Abi Shaybah 25808","","","كتاب اللباس"
"25809","(۲۵۸۰۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَلَمَۃَ أَبِی بِشْرٍ ، عَنْ عِکْرِمَۃَ ؛ قَوْلِہِ : {الَّذِینَ یُؤْذُونَ اللَّہَ وَرَسُولَہُ} قَالَ : أَصْحَابُ التَّصَاوِیرِ۔","","Musannaf Ibn Abi Shaybah 25809","","","كتاب اللباس"
"25810","(۲۵۸۱۰) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : دَخَلْتُ عَلَی الْقَاسِمِ وَہُوَ بِأَعْلَی مَکَّۃَ فِی بَیْتِہِ ، فَرَأَیْتُ فِی بَیْتِہِ حَجَلَۃً فِیہَا تَصَاوِیرُ ؛ الْقُنْدُسِ وَالْعَنْقَائِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25810","","","كتاب اللباس"
"25811","(۲۵۸۱۱) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ ، قَالَ : کَانُوا لاَ یَرَوْنَ بِمَا وُطِئَ مِنَ التَّصَاوِیرِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 25811","","","كتاب اللباس"
"25812","حَدَّثنا أَبو بَکْر عَبْد اللہ بنُ مُحَمَّد بن أبی شَیْبۃ قَالَ :n(۲۵۸۱۲) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ ہِلاَلٍ ، عَنْ جَرِیرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ یُحْرَمُ الرِّفْقَ یُحْرَمُ الْخَیْرَ۔n(مسلم ۲۰۰۳۔ ابوداؤد ۴۷۷۶)","Sahih","Musannaf Ibn Abi Shaybah 25812","","","كتاب الأدب"
"25813","(۲۵۸۱۳) حَدَّثَنَا شَرِیکٌ ، عَنِ الْمِقْدَامِ بْنِ شُرَیْحٍ ، عَنْ أَبِیہِ ، قَالَ : سَأَلْتُ عَائِشَۃَ رضی اللہ عنہا عَنِ الْبَِدَاوَۃِ فَقَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَبْدُو إِلَی ہَذِہِ التِّلاَعِ ، وَإِنَّہُ أَرَادَ الْبَدَاوَۃَ مَرَّۃً ، فَأَرْسَلَ إلَیَّ نَاقَۃً مُحَرَّمَۃً مِنْ إبِلِ الصَّدَقَۃِ ، فَقَالَ لِی : یَا عَائِشَۃُ ، ارْفُقِی فَإِنَّ الرِّفْقَ لَمْ یَکُنْ فِی شَیْئٍ إلاَّ زَانَہُ ، وَلاَ نُزِعَ مِنْ شَیْئٍ قَطُّ إلاَّ شَانَہُ۔ (ابوداؤد ۲۴۷۰۔ احمد ۶/۵۸)","Hasan","Musannaf Ibn Abi Shaybah 25813","","","كتاب الأدب"
"25814","(۲۵۸۱۴) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ یَعْلَی بْنِ مَمْلَکٍ ، عَنْ أُمِّ الدَّرْدَائِ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أُعْطِیَ حَظَّہُ مِنَ الرِّفْقِ ، أُعْطِیَ حَظَّہُ مِنَ الْخَیْرِ ، وَمَنْ مُنِعَ حَظَّہُ مِنَ الرِّفْقِ ، مُنِعَ حَظَّہُ مِنَ الْخَیْرِ۔ (بخاری ۴۶۴۔ ترمذی ۲۰۰۲)","Da'if","Musannaf Ibn Abi Shaybah 25814","","","كتاب الأدب"
"25815","(۲۵۸۱۵) حَدَّثَنَا شَرِیکٌ ، عَنْ مُحَمَّدِ بْنِ أَبِی إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ ہِلاَلٍ ، عَنْ جَرِیرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ یُحْرَمُ الرِّفْقَ یُحْرَمُ الْخَیْرَ۔","Sahih","Musannaf Ibn Abi Shaybah 25815","","","كتاب الأدب"
"25816","(۲۵۸۱۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ ہِلاَلٍ ، عَنْ جَرِیرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 25816","","","كتاب الأدب"
"25817","(۲۵۸۱۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : بَلَغَنِی أَنَّہُ مَکْتُوبٌ فِی التَّوْرَاۃِ ، الرِّفْقُ رَأْسُ الْحِکْمَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25817","","","كتاب الأدب"
"25818","(۲۵۸۱۸) حَدَّثَنَا وَکِیعٌ، حدثنا ابن أبی خالد، عَنْ قَیْسٍ، قَالَ: کَانَ یُقَالُ: مَنْ یُؤْتَی الرِّفْقَ فِی الدُّنْیَا یَنْفَعْہُ فِی الآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 25818","","","كتاب الأدب"
"25819","(۲۵۸۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ ثَوْرٍ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ رَفِیقٌ یُحِبُّ الرِّفْقَ ، وَیُعْطِی عَلَیْہِ ، وَیُعِینُ عَلَیْہِ مَا لاَ یُعِینُ عَلَی الْعَنْفِ۔","","Musannaf Ibn Abi Shaybah 25819","","","كتاب الأدب"
"25820","(۲۵۸۲۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ یُونُسَ وَحُمَیْدٍ ، عَنِ الْحَسَنِ ، عَنْ عَبْدِ اللہِ بْنِ مُغَفَّلٍ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ رَفِیقٌ یُحِبُّ الرِّفْقَ وَیَرْضَاہُ ، وَیُعْطِی عَلَیْہِ مَا لاَ یُعْطِی عَلَی الْعَنْفِ۔ (بخاری ۶۷۲۔ ابوداؤد ۴۷۷۴)","Hasan","Musannaf Ibn Abi Shaybah 25820","","","كتاب الأدب"
"25821","(۲۵۸۲۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ سَعْدِ بْنِ سَعِیدٍ ، عَنِ الزُّہْرِیِّ ، عَنْ رَجُلٌ مِنْ بَلیّ ، قَالَ : دَخَلْت مَعَ أَبِی عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَانْتَجَاہُ دُونِی ، فَقُلْت لَہُ : یَا أَبَتِ ، أَیُّ شَیْئٍ قَالَ لَکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَ : قَالَ لِی : إذَا ہَمَمْت بِالأَمْرِ فَعَلَیْک بِالتُّؤَدَۃِ ، حَتَّی یَأْتِیَک اللَّہُ بِالْمَخْرَجِ مِنْ أَمْرِک۔n(بخاری ۸۸۸)","Hasan","Musannaf Ibn Abi Shaybah 25821","","","كتاب الأدب"
"25822","(۲۵۸۲۲) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ سِمَاکٍ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ تَعَالَی رَفِیقٌ یُحِبُّ الرِّفْقَ ، وَیُعْطِی عَلَیْہِ مَا لاَ یُعْطِی عَلَی الْعَنْفِ۔","Hasan","Musannaf Ibn Abi Shaybah 25822","","","كتاب الأدب"
"25823","(۲۵۸۲۳) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ زِیَادِ بْنِ عِلاَقَۃَ سَمِعَہُ مِنْ أُسَامَۃَ بْنِ شَرِیکٍ ، قَالَ : قَالَ رَجُلٌ : یَا رَسُولَ اللہِ ، مَا خَیْرُ مَا أُعْطِیَ الْعَبْدُ ؟ قَالَ : خُلُقٌ حَسَنٌ۔","Sahih","Musannaf Ibn Abi Shaybah 25823","","","كتاب الأدب"
"25824","(۲۵۸۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، وَمِسْعَرٍ ، عَنْ زِیَادِ بْنِ عِلاَقَۃَ ، عَنْ أُسَامَۃَ بْنِ شَرِیکٍ ، قَالُوا : یَا رَسُولَ اللہِ، مَا أَفْضَلُ مَا أُعْطِیَ الْمُسْلِمُ ؟ قَالَ : خُلُقٌ حَسَنٌ۔ (طیالسی ۱۲۳۳۔ طبرانی ۴۷۰)","Sahih","Musannaf Ibn Abi Shaybah 25824","","","كتاب الأدب"
"25825","(۲۵۸۲۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زَکَرِیَّا بْنِ سِیَاہٍ أَبِی یَحْیَی ، عَنْ عِمْرَانَ بْنِ رِیَاحٍ ، عَنْ عَلِیِّ بْنِ عُمَارَۃَ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : کُنْتُ فِی مَجْلِسٍ فِیہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبُو سَمُرَۃَ جَالِسٌ أَمَامِی ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ الْفُحْشَ وَالتَّفَحُّشَ لَیْسَا مِنَ الإِسْلاَمِ فِی شَیْئٍ ، وَإِنَّ أَحْسَنَ النَّاسِ إسْلاَمًا أَحْسَنُہُمْ خُلُقًا۔ (طبرانی ۲۰۷۲)","Da'if","Musannaf Ibn Abi Shaybah 25825","","","كتاب الأدب"
"25826","(۲۵۸۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : لَمْ یَکُنْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَاحِشًا ، وَلاَ مُتَفَحِّشًا ، وَکَانَ یَقُولُ : إنَّ مِنْ خِیَارِکُمْ مَحَاسِنُکُمْ أَخْلاَقًا۔ (بخاری ۳۵۵۹۔ مسلم ۱۸۱۰)","Sahih","Musannaf Ibn Abi Shaybah 25826","","","كتاب الأدب"
"25827","(۲۵۸۲۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَکْمَلُ النَّاسِ إیمَانًا وَأَفْضَلُ الْمُؤْمِنِینَ إیمَانًا أَحْسَنُہُمْ خُلُقًا ، وَخِیَارُکُمْ خِیَارُکُمْ لِنِسَائِہِمْ۔ (ابوداؤد ۴۶۵۱۔ احمد ۲/۲۵۰)","Hasan","Musannaf Ibn Abi Shaybah 25827","","","كتاب الأدب"
"25828","(۲۵۸۲۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَکْمَلُ الْمُؤْمِنِینَ إیمَانًا ، أَحْسَنُہُمْ خُلُقًا ، وَأَلْطَفُہُمْ بِأَہْلِہِ۔ (ترمذی ۲۶۱۲۔ حاکم ۵۳)","","Musannaf Ibn Abi Shaybah 25828","","","كتاب الأدب"
"25829","(۲۵۸۲۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ دَاوُدَ ، عَنْ مَکْحُولٍ ، عَنْ أَبِی ثَعْلَبَۃَ الْخُشَنِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ أَحَبَّکُمْ إلَیَّ وَأَقْرَبَکُمْ مِنِّی یَوْمَ الْقِیَامَۃِ ، أَحَاسِنُکُمْ أَخْلاَقًا ، وَإِنَّ أَبْعَدَکُمْ مِنِّی وَأَبْغَضَکُمْ إلَیَّ ، مَسَاوِئکُمْ أَخْلاَقًا ، الثَّرْثَارُونَ ، الْمُتَشَدِّقُونَ ، الْمُتَفَیْہِقُونَ۔(احمد ۴/۱۹۳۔ ابن حبان ۴۸۲)","Hasan","Musannaf Ibn Abi Shaybah 25829","","","كتاب الأدب"
"25830","(۲۵۸۳۰) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ، عَنْ سَعِیدِ بْنِ أَبِی أَیُّوبَ ، عَنِ ابْنِ عَجْلاَنَ ، عَنِ الْقَعْقَاعِ ، عَنْ أَبِی صَالِحٍ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أَکْمَلُ الْمُؤْمِنِینَ إیمَانًا أَحْسَنُہُمْ خُلُقًا۔n(احمد ۲/۵۲۷۔ دارمی ۲۷۹۲)","Hasan","Musannaf Ibn Abi Shaybah 25830","","","كتاب الأدب"
"25831","(۲۵۸۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَعْبَدِ بْنِ خَالِدٍ ، عَنْ حَارِثَۃَ بْنِ وَہْبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَدْخُلُ الْجَنَّۃَ الْجَوَّاظُ ، وَلاَ الْجَعْظَرِیُّ ، وَالْجَوَّاظُ : الْفَظُّ الْغَلِیظُ۔n(مسلم ۲۱۹۰۔ ابوداؤد ۴۷۶۸)","Sahih","Musannaf Ibn Abi Shaybah 25831","","","كتاب الأدب"
"25832","(۲۵۸۳۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شُعْبَۃَ ، عَنِ الْقَاسِمِ بْنِ أَبِی بَزَّۃَ ، عَنْ عَطَائٍ الْکَیْخَارَانِیِّ ، عَنْ أُمِّ الدَّرْدَائِ ، عَنْ أَبِی الدَّرْدَائِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَا مِنْ شَیْئٍ أَثْقَلُ فِی الْمِیزَانِ مِنْ خُلُقٍ حَسَنٍ۔n(ابوداؤد ۴۷۶۶۔ احمد ۶/۴۴۶)","Sahih","Musannaf Ibn Abi Shaybah 25832","","","كتاب الأدب"
"25833","(۲۵۸۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ مَیْمُونِ بْنِ أَبِی شَبِیبٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یَا مُعَاذُ ، وَقَدْ قَالَ وَکِیعٌ بِأَخَرَۃٍ : یَا أَبَا ذَرٍّ ، أَتْبِعِ السَّیِّئَۃَ الْحَسَنَۃَ تَمْحُہَا ، وَخَالِقِ النَّاسَ خُلُقًا حَسَنًا۔","Hasan","Musannaf Ibn Abi Shaybah 25833","","","كتاب الأدب"
"25834","(۲۵۸۳۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ شِرَارَ النَّاسِ یَوْمَ الْقِیَامَۃِ الَّذِی یُتَّقَی مَخَافَۃَ فُحْشِہِ۔ (بخاری ۶۰۵۴۔ ابوداؤد ۴۷۵۸)","Sahih","Musannaf Ibn Abi Shaybah 25834","","","كتاب الأدب"
"25835","(۲۵۸۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَص ، عَنْ عَبْدِ اللہِ ، قَالَ : أَلأَمُ أَخْلاَقِ الْمُؤْمِنِ : الْفُحْشُ۔","Sahih","Musannaf Ibn Abi Shaybah 25835","","","كتاب الأدب"
"25836","(۲۵۸۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ حَکِیمِ بْنِ جَابِرٍ ، قَالَ : قَالَ رَجُلٌ لِرَجُلٍ : أَوْصِنِی ، قَالَ : أَتْبِعِ السَّیِّئَۃَ الْحَسَنَۃَ تَمْحُہَا ، وَخَالِقِ النَّاسَ خُلُقًا حَسَنًا۔ (ترمذی ۱۹۸۷)","Hasan","Musannaf Ibn Abi Shaybah 25836","","","كتاب الأدب"
"25837","(۲۵۸۳۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ ، قَالَ : کَانَ زَیْدُ بْنُ ثَابِتٍ مِنْ أَفْکَہِ النَّاسِ إذَا خَلاَ مَعَ أَہْلِہِ ، وَأَزْمَتِہِ إذَا جَلَسَ مَعَ الْقَوْمِ۔","Sahih","Musannaf Ibn Abi Shaybah 25837","","","كتاب الأدب"
"25838","(۲۵۸۳۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لَہَا : یَا عَائِشَۃُ ، لاَ تَکُونِی فَاحِشَۃً۔ (مسلم ۱۱۔ احمد ۶/۲۲۹)","Sahih","Musannaf Ibn Abi Shaybah 25838","","","كتاب الأدب"
"25839","(۲۵۸۳۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْجَدَلِیِّ أَبِی عَبْدِ اللہِ ، قَالَ : قُلْتُ لِعَائِشَۃَ : کَیْفَ کَانَ خُلُقُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَتْ : کَانَ أَحْسَنَ النَّاسِ خُلُقًا ، لَمْ یَکُنْ فَاحِشًا ، وَلاَ مُتَفَحِّشًا ، وَلاَ سَخَّابًا فِی الأَسْوَاقِ۔ (احمد ۶/۲۳۶۔ ابن حبان ۶۴۴۳)","Sahih","Musannaf Ibn Abi Shaybah 25839","","","كتاب الأدب"
"25840","(۲۵۸۴۰) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ ، عَنْ رَجُلٍ مِنْ جُہَیْنَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَیْرُ مَا أُعْطِیَ الْمُؤْمِنُ خُلُقٌ حَسَنٌ ، وَشَرُّ مَا أُعْطِیَ الرَّجُلُ قَلبٌ سُوئٌ فِی صُورَۃٍ حَسَنَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 25840","","","كتاب الأدب"
"25841","(۲۵۸۴۱) حَدَّثَنَا یَزِیدُ بْنُ الْمِقْدَامِ بْنِ شُرَیْحٍ ، عَنْ أَبِیہِ الْمِقْدَامِ بْنِ شُرَیْحٍ ، عَنْ أَبِیہِ شُرَیْحٍ ، عَنْ جَدِّہِ ہَانِئِ بْنِ یَزِیدَ، قَالَ: قُلْتُ: یَا رَسُولَ اللہِ، أَخْبِرْنِی بِشَیْئٍ یُوجِبُ لِی الْجَنَّۃَ، قَالَ: عَلَیْک بِحُسْنِ الْکَلاَمِ، وَبَذْلِ الطَّعَامِ۔n(ابوداؤد ۴۹۱۶۔ نسائی ۵۹۴۰)","Hasan","Musannaf Ibn Abi Shaybah 25841","","","كتاب الأدب"
"25842","(۲۵۸۴۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، عَنْ جَدِّہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَنْ تَسَعُوا النَّاسَ بِأَمْوَالِکُمْ فَلْیَسَعْہُمْ مِنْکُمْ بَسْطُ وَجْہٍ ، وَحُسْنُ خُلُقٍ۔ (بزار ۱۹۷۷)","Da'if","Musannaf Ibn Abi Shaybah 25842","","","كتاب الأدب"
"25843","(۲۵۸۴۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عُمَرُ : حَسَبُ الرَّجُلِ : دِینُہُ ، وَمُرُوئَتُہُ : خُلُقُہُ ، وَأَصْلُہُ : عَقْلُہُ۔","","Musannaf Ibn Abi Shaybah 25843","","","كتاب الأدب"
"25844","(۲۵۸۴۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، قَالَ : أَخْبَرَنِی عَبْدُ الرَّحْمَنِ بْنُ جُبَیْرٍ ، عَنْ أَبِیہِ ، أَنَّہُ سَمِعَ النَّوَّاسَ بْنَ سَمْعَانَ الأَنْصَارِیَّ ، قَالَ : سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْبِرِّ وَالإِثْمِ قَالَ : الْبِرُّ حُسْنُ الْخُلُقِ ، وَالإِثْمُ مَا حَاکَ فِی نَفْسِکَ ، وَکَرِہْت أَنْ یَطَّلِعَ عَلَیْہِ النَّاسُ۔ (بخاری ۲۹۵۔ مسلم ۱۹۸۰)","Sahih","Musannaf Ibn Abi Shaybah 25844","","","كتاب الأدب"
"25845","(۲۵۸۴۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا عَبْدُ الْوَارِثِ ، قَالَ : حَدَّثَنَا أَبُو التَّیَّاحِ ، قَالَ : حَدَّثَنَا أَنَسٌ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَحْسَنَ النَّاسِ خُلُقًا۔ (مسلم ۲۶۷۔ احمد ۳/۲۱۲)","Sahih","Musannaf Ibn Abi Shaybah 25845","","","كتاب الأدب"
"25846","(۲۵۸۴۶) حَدَّثَنَا شَرِیکٌ ، عَنْ خَلَفِ بْنِ حَوْشَبٍ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، قَالَ : قُلْتُ لأُمِّ الدَّرْدَائِ : ما سَمِعْت مِنَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شیئا ؟ قَالَتْ : نَعَمْ ، دَخَلْت عَلَیْہِ وَہُوَ جَالِسٌ ، أَوْ قَالَتْ فِی الْمَسْجِدِ ، أَوْ ذَکَرَتْ غَیْرَہُ فَسَمِعْتہ یَقُولُ : أَوَّلُ مَا یُوضَعُ فِی الْمِیزَانِ الْخُلُقُ الْحَسَنُ۔ (طبرانی ۶۴۷)","Shadh","Musannaf Ibn Abi Shaybah 25846","","","كتاب الأدب"
"25847","(۲۵۸۴۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : مَکْتُوبٌ فِی التَّوْرَاۃِ : یَکُونُ وَجْہُک بَسْطًا وَکَلِمَتُک طَیِّبَۃً تَکُونُ أَحَبَّ إلَی النَّاسِ مِنَ الَّذِینَ یُعْطُونَہُمُ الْعَطَائَ۔","","Musannaf Ibn Abi Shaybah 25847","","","كتاب الأدب"
"25848","(۲۵۸۴۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ سُہَیْلٍ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الإِیمَانُ بِضْعٌ وَسِتُّونَ بَابًا ، أَوْ بِضْعٌ وَسَبْعُونَ بَابًا أَعْظَمُہَا لاَ إلَہَ إلاَّ اللَّہُ ، وَأَدْنَاہَا إمَاطَۃُ الأَذَی عَنِ الطَّرِیقِ، وَالْحَیَائُ شُعْبَۃٌ مِنَ الإِیمَانِ۔(بخاری ۹۔ مسلم ۵۸)","Sahih","Musannaf Ibn Abi Shaybah 25848","","","كتاب الأدب"
"25849","(۲۵۸۴۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، أنہ قَالَ :سَمِعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً یَعِظُ أَخَاہُ فِی الْحَیَائِ ، فَقَالَ : الْحَیَائُ مِنَ الإِیمَانِ۔ (مسلم ۵۹۔ احمد ۲/۹)","Sahih","Musannaf Ibn Abi Shaybah 25849","","","كتاب الأدب"
"25850","(۲۵۸۵۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَیَائُ شُعْبَۃٌ مِنَ الإِیمَانِ۔ (ابن ماجہ ۵۷۔ نسائی ۱۱۷۳۷)","Hasan","Musannaf Ibn Abi Shaybah 25850","","","كتاب الأدب"
"25851","(۲۵۸۵۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، قَالَ : ذَکَرَ عَبْدُ الرَّحْمَنِ بْنُ أَبِی بَکْرَۃَ ، قَالَ : قَالَ أَشَجُّ بَنِی عَصَرَ : قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ فِیک لَخُلُقَیْنِ یُحِبُّہُمَا اللَّہُ ، قَالَ : قُلْتُ : مَا ہُمَا ؟ قَالَ : الْحِلْمُ وَالْحَیَائُ ، قَالَ : قُلْتُ : أَقَدِیمًا کَانَ أَوْ حَدِیثًا ؟ قَالَ : لاَ بَلْ قَدِیمًا ، قُلْتُ : الْحَمْدُ لِلَّہِ الَّذِی جَبَلَنِی عَلَی خُلُقَیْنِ یُحِبُّہُمَا اللَّہُ۔ (نسائی ۷۷۴۶۔ احمد ۴/۲۰۶)","Sahih","Musannaf Ibn Abi Shaybah 25851","","","كتاب الأدب"
"25852","(۲۵۸۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ خَالِدِ بْنِ رَبَاحٍ ، عَنْ أَبِی السَّوَّارِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَیَائُ خَیْرٌ کُلُّہُ۔ (بخاری ۶۱۱۷۔ احمد ۴/۴۲۶)","Hasan","Musannaf Ibn Abi Shaybah 25852","","","كتاب الأدب"
"25853","(۲۵۸۵۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ حَبِیبٍ ، عَنْ مَیْمُونِ بْنِ أَبِی شَبِیبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إنَّ اللَّہَ یُحِبُّ الْحَیِیَّ الْحَلِیمَ المتعفف، وَیُبْغِضُ الْفَاحِشَ الْبَذِیئَ السَّائِلَ الْمُلْحِفَ۔","","Musannaf Ibn Abi Shaybah 25853","","","كتاب الأدب"
"25854","(۲۵۸۵۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَیَائُ مِنَ الإِیمَانِ ، وَالإِیمَانُ فِی الْجَنَّۃِ ، وَالْبَذَائُ مِنَ الْجَفَائِ ، وَالْجَفَائُ فِی النَّارِ۔n(ترمذی ۲۰۰۹۔ احمد ۲/۵۰۱)","Hasan","Musannaf Ibn Abi Shaybah 25854","","","كتاب الأدب"
"25855","(۲۵۸۵۵) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ قَتَادَۃَ ، عَنْ مَوْلًی لأَنَسٍ یُقَالُ لَہُ عَبْدُ اللہِ ، قَالَ : سَمِعْتُ أَبَا سَعِیدٍ الْخُدْرِیِّ یَقُولُ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَشَدَّ حَیَائً مِنْ عَذْرَاء فِی خِدْرِہَا ، وَکَانَ إذَا کَرِہَ شَیْئًا عَرَفْنَاہُ فِی وَجْہِہِ۔ (بخاری ۳۵۶۲۔ احمد ۳/۹۱)","Sahih","Musannaf Ibn Abi Shaybah 25855","","","كتاب الأدب"
"25856","(۲۵۸۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، قَالَ : دَخَلَ عُیَیْنَۃُ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَلَمْ یَسْتَأْذِنْ ، فَقَالَتْ عَائِشَۃُ : یَا رَسُولَ اللہِ ، مَنْ ہَذَا ؟ قَالَ : ہَذَا أَحْمَقُ مُطَاعٌ فِی قَوْمِہِ ، قَالَ : ثُمَّ أُتِیَ بِشَرَابٍ فَاسْتَتَرَ ، ثُمَّ شَرِبَ فَقَالَ : یَا رَسُولَ اللہِ ، مَا ہَذَا ؟ قَالَ : ہَذَا الْحَیَائُ خُلَّۃٌ فِیہِمْ أُعْطُوہَا وَمُنِعتموہا۔","","Musannaf Ibn Abi Shaybah 25856","","","كتاب الأدب"
"25857","(۲۵۸۵۷) حَدَّثَنَا شَرِیکٌ ، عَنْ مَنْصُورٍ ، عَنْ رِبْعِیٍّ ، عَنْ أَبِی مَسْعُودٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: آخِرُ مَا أَدْرَکَ النَّاسُ مِنْ کَلاَمِ النُّبُوَّۃِ: إذَا لَمْ تَسْتَحْیِ فَافْعَلْ مَا شِئْت۔(بخاری ۳۴۸۳۔ احمد ۴/۱۲۲)","Hasan","Musannaf Ibn Abi Shaybah 25857","","","كتاب الأدب"
"25858","(۲۵۸۵۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَحْوَص بْنِ حَکِیمٍ ، عَنْ أَبِی عَوْنٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قِلَّۃُ الْحَیَائِ کُفْرٌ۔","Da'if","Musannaf Ibn Abi Shaybah 25858","","","كتاب الأدب"
"25859","(۲۵۸۵۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جَرِیرٍ ، عَنْ یَعْلَی بْنِ حَکِیمٍ ، قَالَ : أَکْثَرُ ظَنِّی أَنَّہُ عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : قَالَ ابْنُ عُمَرَ : إنَّ الْحَیَائَ وَالإِیمَانَ قُرِنَا جَمِیعًا ، فَإِذَا رُفِعَ أَحَدُہُمَا رُفِعَ الآخَرُ۔ (حاکم ۲۲)","Sahih","Musannaf Ibn Abi Shaybah 25859","","","كتاب الأدب"
"25860","(۲۵۸۶۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ بَکْرٍ ، قَالَ : الْحَیَائُ مِنَ الإِیمَانِ ، وَالإِیمَانُ فِی الْجَنَّۃِ ، وَالْبَذَائُ مِنَ الْجَفَائِ ، وَالْجَفَائُ فِی النَّارِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25860","","","كتاب الأدب"
"25861","(۲۵۸۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ (وَسَیِّدًا) ، قَالَ : الْحَلِیمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25861","","","كتاب الأدب"
"25862","(۲۵۸۶۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنِی مَالِکُ بْنُ أَنَسٍ ، قَالَ : أَخْبَرَنِی سَلَمَۃُ بْنُ صَفْوَانَ ، عَنْ یَزِیدَ بْنِ طَلْحَۃَ بْنِ رُکَانَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ لِکُلِّ شَیْئٍ خُلُقًا ، وَخُلُقُ الإِیمَانِ الْحَیَائُ۔ (ابن ماجہ ۴۱۸۱)","","Musannaf Ibn Abi Shaybah 25862","","","كتاب الأدب"
"25863","(۲۵۸۶۳) حَدَّثَنَا حَفْصٌ ، عَنِ الأَشْعَث ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ مِنَ الْحَیَائِ ضَعْفًا ، وَإِنَّ مِنْہُ وَقَارًا لِلَّہِ۔","Munkar","Musannaf Ibn Abi Shaybah 25863","","","كتاب الأدب"
"25864","(۲۵۸۶۴) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ أَبِی قَابُوسَ مَوْلًی لِعَبْدِ اللہِ بْنِ عَمْرٍو ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو یَبْلُغُ بِہِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الرَّاحِمُونَ یَرْحَمُہُمُ الرَّحْمَان ، ارْحَمُوا من فی الأَرْضِ یَرْحَمُکُمْ مَنْ فِی السَّمَائِ۔ (ابوداؤد ۴۹۰۲۔ ترمذی ۱۹۲۴)","Da'if","Musannaf Ibn Abi Shaybah 25864","","","كتاب الأدب"
"25865","(۲۵۸۶۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ نَافِعِ بْنِ جُبَیْرٍ ، عَنْ جَرِیرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ ??َرْحَمُ اللَّہُ مَنْ لاَ یَرْحَمُ النَّاسَ۔ (مسلم ۱۸۰۹)","Sahih","Musannaf Ibn Abi Shaybah 25865","","","كتاب الأدب"
"25866","(۲۵۸۶۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، عَنْ جَرِیرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَرْحَمُ اللَّہُ مَنْ لاَ یَرْحَمُ النَّاسَ۔","Sahih","Musannaf Ibn Abi Shaybah 25866","","","كتاب الأدب"
"25867","(۲۵۸۶۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ جَرِیرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔ (بخاری ۷۳۷۶۔ ترمذی ۱۹۲۲)","Sahih","Musannaf Ibn Abi Shaybah 25867","","","كتاب الأدب"
"25868","(۲۵۸۶۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عَامِرٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو یَرْوِیہِ ، قَالَ : مَنْ لَمْ یَرْحَمْ صَغِیرَنَا ، وَیَعْرِفْ حَقَّ کَبِیرِنَا ، فَلَیْسَ مِنَّا۔ (ابوداؤد ۴۹۰۴۔ احمد ۲/۴۲۲)","Sahih","Musannaf Ibn Abi Shaybah 25868","","","كتاب الأدب"
"25869","(۲۵۸۶۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی عُثْمَانَ مَوْلَی الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الصَّادِقَ الْمَصْدُوقَ أَبَا الْقَاسِمِ ، صَاحِبَ ہَذِہِ الْحُجْرَۃِ : لاَ تُنْزَعُ الرَّحْمَۃُ إلاَّ مِنْ شَقِیٍّ ، قَالَ شُعْبَۃُ : وَجَدْتہ مَکْتُوبًا عِنْدِی۔ (احمد ۲/۳۰۱۔ طیالسی ۲۵۲۹)","Hasan","Musannaf Ibn Abi Shaybah 25869","","","كتاب الأدب"
"25870","(۲۵۸۷۰) حَدَّثَنَا ابْنُ عُلیَۃَ ، عَنْ زِیَادِ بْنِ مِخْرَاقٍ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، عَنْ أَبِیہِ ، أَنَّ رَجُلاً ، قَالَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی لأَذْبَحُ الشَّاۃَ وَأنا أَرْحَمُہَا ، أَوْ قَالَ : إنِّی لأَرْحَمُ الشَّاۃَ إذَا ذَبَحْتہَا ، فَقَالَ : إنَّ الشَّاۃَ إِنْ رَحِمْتہَا رَحِمَک اللَّہُ مَرَّتَیْنِ۔ (بخاری ۳۷۳۔ احمد ۳/۴۳۶)","Sahih","Musannaf Ibn Abi Shaybah 25870","","","كتاب الأدب"
"25871","(۲۵۸۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ قُرَّۃَ بْنِ خَالِدٍ السَّدُوسِیِّ ، عَنْ أَبِی الْعَلاَئِ بْنِ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، عَنْ أَخِیہِ مُطَرِّفِ بْنِ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، قَالَ : إنَّ اللَّہَ لَیَرْحَم بِرَحْمَۃِ الْعُصْفُورِ۔","","Musannaf Ibn Abi Shaybah 25871","","","كتاب الأدب"
"25872","(۲۵۸۷۲) حَدَّثَنَا وَکِیعٌ ، وَعَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، عَنْ جَرِیرٍ ، قَالَ : قَالَ رَسُول اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَرْحَمُ اللَّہُ مَنْ لاَ یَرْحَمُ النَّاسَ۔","Sahih","Musannaf Ibn Abi Shaybah 25872","","","كتاب الأدب"
"25873","(۲۵۸۷۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، قَالَ : أَخْبَرَنَا الأَعْمَشُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : ارْحَمْ مَنْ فِی الأَرْضِ یَرْحَمْکَ مَنْ فِی السَّمَائِ۔","","Musannaf Ibn Abi Shaybah 25873","","","كتاب الأدب"
"25874","(۲۵۸۷۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَنْ ہِشَامٍ، عَنْ أَبِیہِ، قَالَ: بَلَغَنِی، أَنَّہُ مَکْتُوبٌ فِی التَّوْرَاۃِ کَمَا تَرْحَمُونَ تُرْحَمُونَ۔","","Musannaf Ibn Abi Shaybah 25874","","","كتاب الأدب"
"25875","(۲۵۸۷۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّمَا یَرْحَمُ اللَّہُ مِنْ عِبَادِہِ الرُّحَمَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 25875","","","كتاب الأدب"
"25876","(۲۵۸۷۶) حَدَّثَنَا وَکِیعٌ وعلی بن ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ لاَ یَرْحَمْ لاَ یُرْحَمْ۔","Da'if","Musannaf Ibn Abi Shaybah 25876","","","كتاب الأدب"
"25877","(۲۵۸۷۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عَطَائِ بْنِ یَزِیدَ ، عَنْ أَبِی أَیُّوبَ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ : لاَ یَحِلُّ لِمُسْلِمٍ أَنْ یَہْجُرَ أَخَاہُ فَوْقَ ثَلاَثٍ ، یَلْتَقِیَانِ فیَصُدُّ ہَذَا وَیَصُدُّ ہَذَا ، وَخَیْرُہُمَا الَّذِی یَبْدَأُ بِالسَّلاَمِ۔ (مسلم ۱۹۸۴۔ ترمذی ۱۹۳۲)","Sahih","Musannaf Ibn Abi Shaybah 25877","","","كتاب الأدب"
"25878","(۲۵۸۷۸) حَدَّثَنَا یَحْیَی بْنُ آدَم ، عَنْ إسرَائیل ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ سَعْدٍ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یَحِلُّ لِمُسْلِمٍ أَنْ یَہْجُرَ أَخَاہُ فَوْقَ ثَلاَثٍ۔ (بخاری ۲۴۶۔ ابویعلی ۷۱۶)","","Musannaf Ibn Abi Shaybah 25878","","","كتاب الأدب"
"25879","(۲۵۸۷۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ بْنِ عُمَیر ، عَنْ أَبِی الأَحْوَص ، قَالَ : قَالَ عَبْدُ اللہِ : لاَ ہِجْرَۃَ بَیْنَ الْمُسْلِمَینِ فَوْقَ ثَلاَثٍ۔","Sahih","Musannaf Ibn Abi Shaybah 25879","","","كتاب الأدب"
"25880","(۲۵۸۸۰) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ، عَنْ سَعِیدِ بْنِ أَبِی أَیُّوبَ ، عَنْ خَالِدِ بْنِ یَزِیدَ ، عَنْ عَامِرِ بْنِ یَحْیَی الْمَعَافِرِیِّ ، عَنْ فَضَالَۃَ بْنِ عُبَیْدٍ صَاحِبِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ ہَاجَرَ أَخَاہُ فَوْقَ ثَلاَثٍ ، فَہُوَ فِی النَّارِ إلاَّ أَنْ یَتَدَارَکَہُ اللَّہُ مِنْہُ بِتَوْبَۃٍ۔","","Musannaf Ibn Abi Shaybah 25880","","","كتاب الأدب"
"25881","(۲۵۸۸۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنْ أَنَسٍ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ: أَلاَ لاَ تَبَاغَضُوا، وَلاَ تَحَاسَدُوا، وَلاَ تَدَابَرُوا، وَکُونُوا عِبَادَ اللہِ إخْوَانًا، وَلاَ یَہْجُرَنَّ أَحَدُکُمْ أَخَاہُ فَوْقَ ثَلاَثَۃِ أَیَّامٍ۔n(بخاری ۶۰۶۵۔ مسلم ۱۹۸۳)","Da'if","Musannaf Ibn Abi Shaybah 25881","","","كتاب الأدب"
"25882","(۲۵۸۸۲) حَدَّثَنَا عُبَیْدُ بْنُ سَعِیدٍ الْقُرَشِیُّ ، عَنْ شُعْبَۃَ ، عَنْ یَزِیدَ بْنِ خُمَیْرٍ ، قَالَ : سَمِعْتُ سُلَیْمَ بْنَ عَامِرٍ یُحَدِّثُ عَنْ أَوْسَطَ بْنِ إسْمَاعِیلَ بْنِ أَوْسَطَ ، أَنَّہُ سَمِعَ أَبَا بَکْرٍ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَحَاسَدُوا ، وَلاَ تَبَاغَضُوا ، وَلاَ تَقَاطَعُوا ، وَلاَ تَدَابَرُوا ، وَکُونُوا عِبَادَ اللہِ إخْوَانًا۔n(ابن ماجہ ۳۸۴۹۔ طیالسی ۵)","Sahih","Musannaf Ibn Abi Shaybah 25882","","","كتاب الأدب"
"25883","(۲۵۸۸۳) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ التَّیْمِیِّ ، عَنْ أَنَسٍ ، قَالَ : لاَ ہِجْرَۃَ بَیْنَ الْمُسْلِمَینِ فَوْقَ ثَلاَثٍ۔","Sahih","Musannaf Ibn Abi Shaybah 25883","","","كتاب الأدب"
"25884","(۲۵۸۸۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ دَاوُدَ بْنِ شَابُورَ ، عَنْ مُجَاہِدٍ ، قَالَ : مَرَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِقَوْمٍ یَجُرُّونَ حَجَرًا فَقَالَ : مَا ہَذِہِ ؟ قَالُوا : حَجَرُ الأَشِدَّائِ ، قَالَ : أَلاَ أُخْبِرُکُمْ بِأَشَدِّ مِنْ ہَذَا ؟ الَّذِی یَکُونُ بَیْنَہُ وَبَیْنَ أَخِیہِ فَیَغْلِبُ شَیْطَانَہُ فَیَأْتِیہِ فَیُکَلِّمُہُ۔ (بزار ۲۰۵۳)","","Musannaf Ibn Abi Shaybah 25884","","","كتاب الأدب"
"25885","(۲۵۸۸۵) حَدَّثَنَا وَکِیعٌ، عَنْ إسْمَاعِیلَ، عَنْ قَیْسٍ، قَالَ: قَالَ عُمَرُ: لاَ یَحِلُّ لِمُسْلِمٍ أَنْ یَہْجُرَ أَخَاہُ فَوْقَ ثَلاَثَۃِ أَیَّامٍ۔","Sahih","Musannaf Ibn Abi Shaybah 25885","","","كتاب الأدب"
"25886","(۲۵۸۸۶) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ مُحَمَّدِ بْنِ ہِلاَلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَحِلُّ لِمُسْلِمٍ أَنْ یَہْجُرَ أَخَاہُ فَوْقَ ثَلاَثٍ۔ (مسلم ۱۹۸۴۔ ابوداؤد ۴۸۷۸)","Da'if","Musannaf Ibn Abi Shaybah 25886","","","كتاب الأدب"
"25887","(۲۵۸۸۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنِ الْحَارِثِ بْنِ سُوَیْد ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا تَعُدُّونَ الصُّرَعَۃَ فِیکُمْ ؟ قَالَ : الَّذِی لاَ یَصْرَعُہُ الرِّجَالُ ، قَالَ : لاَ وَلَکِنَّہُ الَّذِی یَمْلِکُ نَفْسَہُ عِنْدَ الْغَضَبِ۔ (مسلم ۲۰۱۴۔ ابوداؤد ۴۷۴۶)","Sahih","Musannaf Ibn Abi Shaybah 25887","","","كتاب الأدب"
"25888","(۲۵۸۸۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَسِّرُوا ، وَلاَ تُعَسِّرُوا ، قَالَہَا ثَلاَثًا فَإِذَا غَضِبْتَ فَاسْکُتْ۔ (بزار ۱۵۲)","Da'if","Musannaf Ibn Abi Shaybah 25888","","","كتاب الأدب"
"25889","(۲۵۸۸۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنِ الأَحْنَفِ بْنِ قَیْسٍ ، عَنِ ابْنِ عَمٍّ لَہُ مِنْ تَمِیمٍ ، عَنْ جَارِیَۃَ بْنِ قُدَامَۃَ ، أَنَّہُ قَالَ : یَا رَسُولَ اللہِ ، قُلْ لِی قَوْلاً وَأَقِلَّ لَعَلِّی أَعِیہِ ، قَالَ : لاَ تَغْضَبْ ، فَأَعَادَ عَلَیْہِ مِرَارًا کُلُّ ذَلِکَ یَقُولُ : لاَ تَغْضَبْ۔ (احمد ۳/۴۸۴)","Sahih","Musannaf Ibn Abi Shaybah 25889","","","كتاب الأدب"
"25890","(۲۵۸۹۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنِ الأَحْنَفِ بْنِ قَیْسٍ ، عَنْ جَارِیَۃَ بْنِ قُدَامَۃَ ، عَنِ ابْنِ عَمٍّ لَہُ مِنْ بَنِی تَمِیمٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَہُ۔ (طبرانی ۲۱۰۴)","","Musannaf Ibn Abi Shaybah 25890","","","كتاب الأدب"
"25891","(۲۵۸۹۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ سُلَیْمَانَ بْنِ صُرَدٍ ، قَالَ : اسْتَبَّ رَجُلاَنِ عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَجَعَلَ أَحَدُہُمَا تَحْمَرُّ عَیْنَاہُ وَتَنْتَفِخُ أَوْدَاجُہُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی لأَعْرِفُ کَلِمَۃً لَوْ قَالَہَا ہَذَا لَذَہَبَ عَنْہُ الَّذِی یَجِدُ : أَعُوذُ بِاللَّہِ مِنَ الشَّیْطَانِ الرَّجِیمِ فَقَالَ : الرَّجُلُ : وَہَلْ تَرَی بِی مِنْ جُنُونٍ۔ (مسلم ۲۰۱۵۔ ابوداؤد ۴۷۴۸۱)","Sahih","Musannaf Ibn Abi Shaybah 25891","","","كتاب الأدب"
"25892","(۲۵۸۹۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ مُعَاذٍ ، قَالَ : اسْتَبَّ رَجُلاَنِ عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَغَضِبَ أَحَدُہُمَا غَضَبًا شَدِیدًا حَتَّی أَنَّہُ لَیُخَیَّلُ إلَیَّ أَنَّ أَنْفَہُ یَتَمَزَّعُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی لأَعْرِفُ کَلِمَۃً لَوْ قَالَہَا ہَذَا الْغَضْبَانُ لَذَہَبَ غَضَبُہُ : أَعُوذُ بِاللَّہِ الْعَظِیمِ مِنَ الشَّیْطَانِ الرَّجِیمِ۔ (ابوداؤد ۴۷۴۷۔ ترمذی ۳۴۵۲)","","Musannaf Ibn Abi Shaybah 25892","","","كتاب الأدب"
"25893","(۲۵۸۹۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : اتَّقُوا الْغَضَبَ فَإِنَّہَا جَمْرَۃٌ تُوقَدُ فِی قَلْبِ ابْنِ آدَمَ ، أَلَمْ تَرَ إلَی انْتِفَاخِ أَوْدَاجِہِ وَحُمْرَۃِ عَیْنَیْہِ ، فَمَنْ أَحَسَّ مِنْ ذَلِکَ شَیْئًا فَلْیَلْزِقْ بِالأَرْضِ۔ (بخاری ۲۸۴۲۔ مسلم ۱۲۱)","Da'if","Musannaf Ibn Abi Shaybah 25893","","","كتاب الأدب"
"25894","(۲۵۸۹۴) حَدَّثَنَا دَاوُد بْنُ عَبْدِ اللہِ ، قَالَ : أَخْبَرَنَا مَالِکُ بْنُ أَنَسٍ ، عَنِ ابْنِ شِہَابٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ الشَّدِیدُ بِالصُّرَعَۃِ ، إنَّمَا الشَّدِیدُ الَّذِی یَمْلِکُ نَفْسَہُ عِنْدَ الْغَضَبِ۔ (بخاری ۶۱۱۴۔ مسلم ۱۰۷)","Sahih","Musannaf Ibn Abi Shaybah 25894","","","كتاب الأدب"
"25895","(۲۵۸۹۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُل ، فَقَالَ : أَوْصِنِی بِکَلِمَۃٍ ، وَلاَ تُکْثِرْ عَلَیَّ ، قَالَ : اجْتَنِبِ الْغَضَبَ ، فَأَعَادَ عَلَیْہِ فَقَالَ : اجْتَنِبِ الْغَضَبَ ، فَأَعَادَ عَلَیْہِ فَقَالَ : اجْتَنِبِ الْغَضَبَ۔n(احمد ۵/۴۰۸۔ مالک ۹۰۶)","Sahih","Musannaf Ibn Abi Shaybah 25895","","","كتاب الأدب"
"25896","(۲۵۸۹۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ عَبْدَ الرَّحْمَن بن عوف عَادَ أَبَا الرَّدَّادِ فَقَالَ : خَیْرُہُمْ وَأَوْصَلُہُمْ أَبُو مُحَمَّدٍ یَعْنِی ابْنَ عَوْفٍ ، سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : قَالَ اللَّہُ : أَنَا اللَّہُ وَأَنَا الرَّحْمَان ، وَہِیَ الرَّحِمُ ، شَقَقْت لَہَا اسْمًا مِنِ اسْمِی ، فَمَنْ وَصَلَہَا وَصَلْتُہْ ، وَمَنْ قَطَعَہَا بَتَتُّہُ۔ (ترمذی ۱۹۰۷۔ ابوداؤد ۱۶۹۱)","","Musannaf Ibn Abi Shaybah 25896","","","كتاب الأدب"
"25897","(۲۵۸۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مُعَاوِیَۃَ بْنِ أَبِی مُزَرِّدٍ ، عَنْ یَزِیدَ بْنِ رُومَانَ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الرَّحِمُ مُعَلَّقَۃٌ بِالْعَرْشِ ، تَقُولُ : مَنْ وَصَلَنِی وَصَلَہُ اللَّہُ ، وَمَنْ قَطَعَنِی قَطَعَہُ اللَّہُ۔ (بخاری ۵۹۸۹۔ مسلم ۱۹۸۱)","Sahih","Musannaf Ibn Abi Shaybah 25897","","","كتاب الأدب"
"25898","(۲۵۸۹۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ عَبْدِ اللہِ بْنِ سَلاَمٍ ، قَالَ : لَمَّا قَدِمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَدِینَۃَ انْجَفَلَ النَّاسُ نَحْوَہُ فَأَتَیْتہ ، فَلَمَّا نَظَرْت إلَیْہِ عَرَفْت أَنَّ وَجْہَہُ لَیْسَ بوَجْہِ کَذَّابٍ ، فَکَانَ أَوَّلَ شَیْئٍ سَمِعْتہ یَقُولُ: یَا أَیُّہَا النَّاسُ ، أَفْشُوا السَّلاَمَ ، وَصِلُوا الأَرْحَامَ ، وَأَطْعِمُوا الطَّعَامَ، وَصَلُّوا بِاللَّیْلِ وَالنَّاسُ نِیَامٌ۔ (ترمذی ۲۴۸۵۔ احمد ۵/۴۵۱)","Sahih","Musannaf Ibn Abi Shaybah 25898","","","كتاب الأدب"
"25899","(۲۵۸۹۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ عَطَائِ بْنِ أَبِی مَرْوَانَ ، عَنْ أَبِیہِ ، عَنْ کَعْبٍ ، قَالَ : وَالَّذِی فَلَقَ الْبْحَر لِبَنِی إسْرَائِیلَ ، إنَّ فِی التَّوْرَاۃِ مَکْتُوبا : ابْنَ آدَمَ ، اتَّقِ رَبَّک ، وَابْرَرْ وَالِدَیْک ، وَصِلْ رَحِمَک ، أَمُدُّ لَکَ فِی عُمْرِکَ ، وَأُیَسِّرُ لَکَ یُسْرَک ، وَأَصْرِفُ عَنْک عُسْرَک۔","","Musannaf Ibn Abi Shaybah 25899","","","كتاب الأدب"
"25900","(۲۵۹۰۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مَغْرَائَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنِ اتَّقَی رَبَّہُ وَوَصَلَ رَحِمَہُ نُسِئَ لَہُ فِی عُمْرِہِ ، وَثَرَا مَالُہُ ، وَأَحَبَّہُ أَہْلُہُ۔ (بخاری ۵۹۸۵)","Hasan","Musannaf Ibn Abi Shaybah 25900","","","كتاب الأدب"
"25901","(۲۵۹۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی عَاصِمٍ الثَّقَفِیِّ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ بْنِ قَارِبٍ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ عَمْرٍو یَقُولُ بِلِسَانٍ لَہُ ذُلَقٍ : إنَّ الرَّحِمَ مُعَلَّقَۃٌ بِالْعَرْشِ تُنَادِی بِلِسَانٍ لَہَا ذُلَقٍ : اللَّہُمَّ صِلْ مَنْ وَصَلَنِی ، وَاقْطَعْ مَنْ قَطَعَنِی۔ (طیالسی ۲۲۵۰)","Hasan","Musannaf Ibn Abi Shaybah 25901","","","كتاب الأدب"
"25902","(۲۵۹۰۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا قَتَادَۃُ ، عَنْ أَبِی ثُمَامَۃَ الثَّقَفِیِّ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : تُوضَعُ الرَّحِمُ یَوْمَ الْقِیَامَۃِ ، وَلَہَا حُجْنَۃٌ کَحُجْنَۃِ الْمِغْزَلِ ، تَکَلَّمُ بِأَلْسِنَۃ طُلَقٍ ذُلَقٍ ، فَتَصِلُ مَنْ وَصَلَہَا ، وَتَقْطَعُ مَنْ قَطَعَہَا۔ (احمد ۲/۱۸۹)","Da'if","Musannaf Ibn Abi Shaybah 25902","","","كتاب الأدب"
"25903","(۲۵۹۰۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ شُعْبَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الْجَبَّارِ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ الْقُرَظِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الرَّحِمُ شُجْنَۃٌ مِنَ الرَّحْمَن ، تَجِیئُ یَوْمَ الْقِیَامَۃِ ، تَقُولُ: یَا رَبِّ قُطِعْتُ ، یَا رَبِّ ظُلِمْتُ ، یَا رَبِّ أُسِیئَ إلَیَّ۔ (بخاری ۶۵۔ احمد ۲/۲۹۵)","Da'if","Musannaf Ibn Abi Shaybah 25903","","","كتاب الأدب"
"25904","(۲۵۹۰۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃَ ، قَالَ : حَدَّثَنَا الْمُنْذِرُ بْنُ جَہْمٍ الأَسْلَمِیُّ ، عَنْ نَوْفَلِ بْنِ مُسَاحِقٍ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الرَّحِمُ شُجْنَۃٌ آخِذَۃٌ بِحُجْزَۃِ الرَّحْمَن تُنَاشِدُ حَقَّہَا فَیَقُولُ : أَلاَ تَرْضِینَ أَنْ أَصِلَ مَنْ وَصَلَکِ ، وَأَقْطَعَ مَنْ قَطَعَکِ ، مَنْ وَصَلَکِ فَقَدْ وَصَلَنِی ، وَمَنْ قَطَعَکِ فَقَدْ قَطَعَنِی۔ (طبرانی ۹۷۰)","Da'if","Musannaf Ibn Abi Shaybah 25904","","","كتاب الأدب"
"25905","(۲۵۹۰۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا فِطْرٌ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ الرَّحِمَ مُعَلَّقَۃٌ بِالْعَرْشِ وَلَیْسَ الْمُوَاصِلُ بِالْمُکَافِئِ ، وَلَکِنَّ الْمُوَاصِل الَّذِی إذَا انْقَطَعَتْ رَحِمُہُ وَصَلَہَا۔ (احمد ۲/۱۹۳۔ ابن حبان ۴۴۵)","Sahih","Musannaf Ibn Abi Shaybah 25905","","","كتاب الأدب"
"25906","(۲۵۹۰۶) حَدَّثَنَا شَرِیکٌ ، عَنْ سِمَاکٍ ، عَنْ زَوْجِ دُرَّۃَ ، عَنْ دُرَّۃَ ، قَالَتْ : قُلْتُ : یَا رَسُولَ اللہِ ، مَنْ أَتْقَی النَّاسِ ؟ قَالَ : آمِرُہُمْ بِالْمَعْرُوفِ وَأَنْہَاہُمْ عَنِ الْمُنْکَرِ ، وَأَوْصَلُہُمْ لِلرَّحِمِ۔ (طبرانی ۶۵۷۔ احمد ۶/۴۳۲)","Da'if","Musannaf Ibn Abi Shaybah 25906","","","كتاب الأدب"
"25907","(۲۵۹۰۷) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ سُہَیْلِ بْنِ أَبِی صَالِحٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَجْزِی وَلَدٌ وَالِدَہُ إلاَّ أَنْ یَجِدَہُ مَمْلُوکًا فَیَشْتَرِیَہُ فَیُعْتِقَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 25907","","","كتاب الأدب"
"25908","(۲۵۹۰۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْوَلِیدِ بْنِ الْعَیْزَارِ ، عَنْ سَعْدِ بْنِ إیَاسٍ أَبِی عَمْرٍو الشَّیْبَانِیِّ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، أَیُّ الأَعْمَالِ أَفْضَلُ ؟ قَالَ : الصَّلاَۃُ لِمِیقَاتِہَا ، قَالَ : قُلْتُ : ثُمَّ أَیُّ ؟ قَالَ : بِرُّ الْوَالِدَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 25908","","","كتاب الأدب"
"25909","(۲۵۹۰۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الْوَالِدُ أَوْسَطُ أَبْوَابِ الْجَنَّۃِ ، فَإِنْ شِئْتَ فَاحْفَظْہُ ، وَإِنْ شِئْتَ فَضَیِّعْہُ۔ (ترمذی ۱۹۰۰۔ احمد ۵/۱۹۶)","Da'if","Musannaf Ibn Abi Shaybah 25909","","","كتاب الأدب"
"25910","(۲۵۹۱۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لِلأُمِّ ثُلُثَا الْبِرِّ وَلِلأََبِ الثُّلُثُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25910","","","كتاب الأدب"
"25911","(۲۵۹۱۱) حَدَّثَنَا شَرِیکٌ ، عَنْ مَنْصُورٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عَلِیٍّ ، عَنْ أَبِی سَلاَمَۃَ السُّلامِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أُوصِی امْرَئًا بِأُمِّہِ ثَلاَثًا أُوصِی امْرَئًا بِأَبِیہِ ، أُوصِی امْرَئًا بِمَوْلاَہُ الَّذِی یَلِیہِ ، وَإِنْ کَانَ عَلَیْہِ مِنْہُ أَذًی یُؤْذِیہِ۔ (احمد ۴/۳۱۱۔ طبرانی ۴۱۸۴)","Da'if","Musannaf Ibn Abi Shaybah 25911","","","كتاب الأدب"
"25912","(۲۵۹۱۲) حَدَّثَنَا شَرِیکٌ ، عَنْ عُمَارَۃَ بْنِ الْقَعْقَاعِ ، وَابْنِ شُبْرُمَۃَ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : یَا رَسُولَ اللہِ ، نَبِّئْنِی بِأَحَقِّ النَّاسِ مِنِّی بِحُسْنِ الصُّحْبَۃِ ، فَقَالَ: نَعَمْ ، وَأَبِیک لَتُنَبَّأَنَّ ، أُمُّک ، قَالَ : ثُمَّ مَنْ ؟ قَالَ : أُمُّک ، قَالَ : ثُمَّ مَنْ ؟ قَالَ : أَبُوکَ۔n(مسلم ۱۹۷۴۔ بخاری ۵۹۷۱)","Hasan","Musannaf Ibn Abi Shaybah 25912","","","كتاب الأدب"
"25913","(۲۵۹۱۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عُمَارَۃَ أَبِی سَعِیدٍ ، قَالَ : قُلْتُ لِلْحَسَنِ : إلَی مَا یَنْتَہِی الْعُقُوقُ ؟ قَالَ : أَنْ تُحَرِّمَہُمَا وَتَہْجُرَہُمَا وَتَحُدَّ النَّظَرَ إلَی وَجْہِ وَالِدَیْک ، یَا عُمَارَۃُ ، کَیْفَ الْبِرُّ لَہُمَا۔","","Musannaf Ibn Abi Shaybah 25913","","","كتاب الأدب"
"25914","(۲۵۹۱۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَسْمَائَ بْنِ عُبَیْدٍ ، عَنْ یُونُسَ بْنِ عُبَیْدٍ ، قَالَ : یُرْجَی لِلْمُرْہَقِ بِالْبِرِّ الْجَنَّۃُ ، وَیُخَافُ عَلَی المتألہ بِالْعُقُوقِ النَّارُ۔","","Musannaf Ibn Abi Shaybah 25914","","","كتاب الأدب"
"25915","(۲۵۹۱۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : بِرُّ الْوَالِدَیْنِ یُجْزِئُ مِنَ الْجِہَادِ۔ (بخاری ۳۰۰۴۔ مسلم ۱۹۷۵)","Hasan","Musannaf Ibn Abi Shaybah 25915","","","كتاب الأدب"
"25916","(۲۵۹۱۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سُلَیْمَانُ التَّیْمِیُّ ، عَنْ سَعْدِ بْنِ مَسْعُودٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَا مِنْ مُسْلِمٍ لَہُ أَبَوَانِ فَیُصْبِحُ وَہُوَ مُحْسِنٌ إلَیْہِمَا إلاَّ فَتَحَ اللَّہُ لَہُ بَابَیْنِ مِنَ الْجَنَّۃِ ، وَلاَ یُمْسِی وَہُوَ مُسِیئٌ إلَیْہِمَا إلاَّ فَتَحَ اللَّہُ لَہُ بَابَیْنِ مِنَ النَّارِ ، وَلاَ سَخِطَ عَلَیْہِ وَاحِدٌ مِنْہُمَا فَیَرْضَی اللَّہُ عَنْہُ حَتَّی یَرْضَی عَنْہُ ، قَالَ: قُلْتُ : وَإِنْ کَانَا ظَالِمَیْنِ ؟ قَالَ : وَإِنْ کَانَا ظَالِمَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 25916","","","كتاب الأدب"
"25917","(۲۵۹۱۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، وَمُجَاہِدٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَدْخُلُ الْجَنَّۃَ عَاقٌ ، وَلاَ مُدْمِنُ خَمْرٍ ، وَلاَ مَنَّانٌ۔","Da'if","Musannaf Ibn Abi Shaybah 25917","","","كتاب الأدب"
"25918","(۲۵۹۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُعَاوِیَۃَ بْنِ إِسْحَاقَ ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ ، قَالَ : مَا بَرَّ وَالِدَہُ مَنْ شَدَّ الطَّرْفَ إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 25918","","","كتاب الأدب"
"25919","(۲۵۹۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ : {فَلاَ تَقُلْ لَہُمَا أُفٍّ} قَالَ : إذَا بَلَغَا مِنَ الْکِبَرِ مَا کَانَ یَلِیَانِ مِنْہُ فِی الصِّغَرِ فَلاَ یَقُلْ لَہُمَا أُفٍّ۔","No Data Available","Musannaf Ibn Abi Shaybah 25919","","","كتاب الأدب"
"25920","(۲۵۹۲۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ طَلْحَۃَ بْنِ مُعَاوِیَۃَ بْنِ جَاہِمۃ السُّلَمِیِّ ، عَنْ أَبِیہِ ، قَالَ : أَتَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقُلْت : یَا رَسُولَ اللہِ ، إنِّی أُرِیدُ الْجِہَادَ مَعَک فِی سَبِیلِ اللہِ ، قَالَ : فَقَالَ : أُمُّکَ حَیَّۃٌ ؟ قَالَ : قُلْتُ : نَعَمْ ، یَا رَسُولَ اللہِ ، قَالَ : الْزَمْ رِجْلَیْہَا فَثَمَّ الْجَنَّۃُ۔ (ابن ماجہ ۲۷۸۱۔ حاکم ۱۵۱)","","Musannaf Ibn Abi Shaybah 25920","","","كتاب الأدب"
"25921","(۲۵۹۲۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ {فَلاَ تَقُلْ لَہُمَا أُفٍّ} قَالَ : لاَ تَمْنَعْہُمَا شَیْئًا أَرَادَاہُ ، أَوْ قَالَ : أَحَبَّاہُ۔","","Musannaf Ibn Abi Shaybah 25921","","","كتاب الأدب"
"25922","(۲۵۹۲۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ مَیْمُونِ بْنِ أَبِی شَبِیبٍ ، قَالَ : قیلَ لِمُعَاذِ بْنِ جَبَلٍ مَا حَقُّ الْوَالِدِ عَلَی الْوَلَدِ ؟ قَالَ : لَوْ خَرَجْت مِنْ أَہْلِکَ وَمَالِکَ مَا أَدَّیْت حَقَّہُمَا قَالَ شُعْبَۃُ : وَإِنَّمَا حَدَّثَنِی بِہِ مَنْصُورُ بْنُ زَاذَانَ ، عَنِ الْحَکَمِ۔","","Musannaf Ibn Abi Shaybah 25922","","","كتاب الأدب"
"25923","(۲۵۹۲۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ نُبَیْطِ بْنِ شَرِیط ، عَنْ جَابَانَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یَدْخُلُ الْجَنَّۃَ عَاقٌ ، وَلاَ مُدْمِنُ خَمْرٍ ، وَلاَ مَنَّانٌ۔ (نسائی ۵۱۸۲۔ احمد ۲/۲۰۱)","Da'if","Musannaf Ibn Abi Shaybah 25923","","","كتاب الأدب"
"25924","(۲۵۹۲۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَحِمَ اللَّہُ وَالِدًا أَعَانَ وَلَدَہُ عَلَی بِرِّہِ۔","","Musannaf Ibn Abi Shaybah 25924","","","كتاب الأدب"
"25925","(۲۵۹۲۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، وَعَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی بَکْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، عَنْ عَمْرَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا زَالَ جِبْرِیلُ یُوصِینِی بِالْجَارِ حَتَّی ظَنَنْت أَنَّہُ سَیُوَرِّثُہُ۔ (بخاری ۶۰۱۴۔ مسلم ۲۰۲۵)","Sahih","Musannaf Ibn Abi Shaybah 25925","","","كتاب الأدب"
"25926","(۲۵۹۲۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ بَشِیر بْن سَلْمَانَ ، عَنْ مُجَاہِدٍ ، قَالَ : کُنَّا جُلُوسًا عِنْدَ عَبْدِ اللہِ بْنِ عَمْرٍو فَقَالَ : إنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُوصِی بِالْجَارِ حَتَّی حسبنا ، أَوْ رَأَیْنَا ، أَنَّہُ سَیُوَرِّثُہُ۔ (احمد ۲/۱۶۰)","Sahih","Musannaf Ibn Abi Shaybah 25926","","","كتاب الأدب"
"25927","(۲۵۹۲۷) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَانَ یُؤْمِنُ بِاللَّہِ وَالْیَوْمِ الآخِرِ فَلاَ یُؤْذِی جَارَہُ۔ (بخاری ۶۰۱۸۔ مسلم ۶۸)","Sahih","Musannaf Ibn Abi Shaybah 25927","","","كتاب الأدب"
"25928","(۲۵۹۲۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سَلاَّمُ بْنُ مِسْکِینٍ ، قَالَ : حَدَّثَنَا شَہْرُ بْنُ حَوْشَبٍ ، عَنْ مُحَمَّدِ بْنِ یُوسُف بْنِ عَبْدِ اللہِ بْنِ سَلاَمٍ أَنْ رَجُلاً أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : آذَانِی جَارِی ، فَقَالَ : اصْبِرْ ، ثُمَّ أَتَاہُ الثَّانِیَۃَ فَقَالَ : آذَانِی جَارِی ، فَقَالَ : اصْبِرْ ، ثُمَّ أَتَاہُ الثَّالِثَۃَ فَقَالَ : آذَانِی جَارِی ، فَقَالَ : اعْمَدْ إلَی مَتَاعِکَ فَاقْذِفْہُ فِی السِّکَّۃِ ، فَإِذَا مَرَّ بِکَ أَحَدٌ فَقُلْ : آذَانِی جَارِی ، فَتَحِقُّ عَلَیْہِ اللَّعْنَۃُ ، أَوْ تَجِبُ عَلَیْہِ اللَّعَنْۃُ۔ (بخاری ۱۲۵۔ طبرانی ۳۵۶)","","Musannaf Ibn Abi Shaybah 25928","","","كتاب الأدب"
"25929","(۲۵۹۲۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ دَاوُدَ بْنِ فَرَاہِیجَ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یُحَدِّثُ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَوْصَانِی جِبْرِیلُ بِالْجَارِ حَتَّی ظَنَنْت أَنَّہُ یُوَرِّثُہُ۔ (ابن ماجہ ۳۶۷۴۔ احمد ۲/۲۵۹)","Hasan","Musannaf Ibn Abi Shaybah 25929","","","كتاب الأدب"
"25930","(۲۵۹۳۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ جَارِ سُوئٍ فِی دَارِ الْمُقَامَۃِ ، فَإِنَّ جَارَ الْبَادِیَۃِ یَتَحَوَّلُ۔ (بخاری ۱۱۷۔ ابن حبان ۱۰۳۳)","Hasan","Musannaf Ibn Abi Shaybah 25930","","","كتاب الأدب"
"25931","(۲۵۹۳۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ سِنَانِ بْنِ سَعْدٍ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَا ہُوَ بِمُؤْمِنٍ مَنْ لَمْ یَأْمَنْ جَارُہُ بَوَائِقَہُ۔ (ابویعلی ۴۲۳۶)","Da'if","Musannaf Ibn Abi Shaybah 25931","","","كتاب الأدب"
"25932","(۲۵۹۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَوْزَاعِیُّ ، عَنْ عَبْدَۃَ بْنِ أَبِی لُبَابَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ قَلِیلَ مَنْ آذَی الْجَارَ۔ (طبرانی ۲۳)","","Musannaf Ibn Abi Shaybah 25932","","","كتاب الأدب"
"25933","(۲۵۹۳۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ ، عَنْ مَیْمُونَ بْنِ مِہْرَانَ ، قَالَ : کَانَ رَجُلٌ مِنَ الْمُسْلِمِینَ یَصُومُ ، فَکَانَ یَجْعَلُ لِسُحُورِہِ قُرْصًا فَجَائَتِ الشَّاۃُ فَأَخَذَتِ الْقُرْصَ ، فَقَامَتِ الْمَرْأَۃُ فَفَکَّتْ لِحْیَیَ الشَّاۃِ فَأَخَذَتِ الْقُرْصَ ، فَثَغَتِ الشَّاۃُ فَقَالَ : الرَّجُلُ : مَا یُدْرِیک مَا بَلَغَ ثِغَاہَا مِنْ أَذَی جَارِک۔","","Musannaf Ibn Abi Shaybah 25933","","","كتاب الأدب"
"25934","(۲۵۹۳۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : أَخْبَرَنِی جَارُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ کَانَ یُرْمی بِالأَرْجَامِ وَالْجِیَف فَقَالَ : یَا مَعْشَرَ قُرَیْشٍ ، أَیُّ مُجَاوَرَۃٍ ہَذِہِ ؟۔ (ابن سعد ۲۰۱)","Hasan","Musannaf Ibn Abi Shaybah 25934","","","كتاب الأدب"
"25935","(۲۵۹۳۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ رِبْعِیٍّ ، عَنْ حُذَیْفَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : کُلُّ مَعْرُوفٍ صَدَقَۃٌ۔ (احمد ۵/۳۹۷)","Sahih","Musannaf Ibn Abi Shaybah 25935","","","كتاب الأدب"
"25936","(۲۵۹۳۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : کُلُّ مَعْرُوفٍ صَدَقَۃٌ۔","","Musannaf Ibn Abi Shaybah 25936","","","كتاب الأدب"
"25937","(۲۵۹۳۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: رَأْسُ الْعَقْلِ بَعْدَ الإِیمَانِ بِاللَّہِ مُدَارَاۃُ النَّاسِ ، وَلَنْ یَہْلِکَ رَجُلٌ بَعْدَ مَشْورَۃٍ ، وَأَہْلُ الْمَعْرُوفِ فِی الدُّنْیَا ہُمْ أَہْلُ الْمَعْرُوفِ فِی الآخِرَۃِ۔ (بیہقی ۱۰۹)","Da'if","Musannaf Ibn Abi Shaybah 25937","","","كتاب الأدب"
"25938","(۲۵۹۳۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَہْلُ الْمَعْرُوفِ فِی الدُّنْیَا ہُمْ أَہْلُ الْمَعْرُوفِ فِی الآخِرَۃِ ، وَأَہْلُ الْمُنْکَرِ فِی الدُّنْیَا ہُمْ أَہْلُ الْمُنْکَرِ فِی الآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 25938","","","كتاب الأدب"
"25939","(۲۵۹۳۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ، قَالَ: مَنْ صَنَعَ مَعْرُوفًا إلَی غَنِیٍّ وَفَقِیرٍ، فَہُوَ صَدَقَۃٌ۔","","Musannaf Ibn Abi Shaybah 25939","","","كتاب الأدب"
"25940","(۲۵۹۴۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا عَبْدُ الْجَبَّارِ بْنُ عَبَّاسٍ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : کُلُّ مَعْرُوفٍ صَدَقَۃٌ۔ (بخاری ۲۳۱۔ احمد ۴/۳۰۷)","Hasan","Musannaf Ibn Abi Shaybah 25940","","","كتاب الأدب"
"25941","(۲۵۹۴۱) حَدَّثَنَا مُحَمَّدُ بْنُ حَسَنٍ الأَزْدِیُّ، قَالَ: حدَّثَنَا عَبْدُالْحَمِیدِ الْبَصْرِیُّ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کُلُّ مَعْرُوفٍ صَدَقَۃٌ۔(بخاری ۶۰۲۱۔ ترمذی ۱۹۷۰)","Da'if","Musannaf Ibn Abi Shaybah 25941","","","كتاب الأدب"
"25942","(۲۵۹۴۲) حَدَّثَنَا مَالِکٌ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ : کُلُّ مَعْرُوفٍ صَدَقَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 25942","","","كتاب الأدب"
"25943","(۲۵۹۴۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سُفْیَانُ بْنُ حُسَیْنٍ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنْ جَابِرِ بْنِ عَبْدِاللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ عَالَ ثَلاَثَ بَنَاتٍ یَکْفِیہِنَّ وَیَرْحَمُہُنَّ وَیَرْفِقُ بِہِنَّ ، فَہُوَ فِی الْجَنَّۃِ ، أَوْ قَالَ : مَعِی فِی الْجَنَّۃِ۔ (احمد ۳/۳۰۳۔ ابویعلی ۲۲۰۷)","Da'if","Musannaf Ibn Abi Shaybah 25943","","","كتاب الأدب"
"25944","(۲۵۹۴۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ زِیَادِ بْنِ حُدَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ وُلِدَتْ لَہُ ابْنَۃٌ فَلَمْ یَئِدْہَا وَلَمْ یُہِنْہَا ، وَلَمْ یُؤْثِرْ وَلَدَہُ عَلَیْہَا ، یَعْنِی الذُّکُورَ ، أَدْخَلَہُ اللَّہُ الْجَنَّۃَ۔ (ابوداؤد ۵۱۰۳۔ حاکم ۱۷۷)","Sahih","Musannaf Ibn Abi Shaybah 25944","","","كتاب الأدب"
"25945","(۲۵۹۴۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشَ ، عَنِ الرَّقَاشِیِّ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَانَ لَہُ ابْنَتَانِ ، أَوْ أُخْتَانِ فَأَحْسَنَ إلَیْہِمَا مَا صَحِبَتَاہُ کُنْت أَنَا وَہُوَ فِی الْجَنَّۃِ کَہَاتَیْنِ - یَعْنِی کالسَّبَّابَۃِ وَالْوُسْطَی۔ (مسلم ۲۰۲۷۔ ترمذی ۱۹۱۴)","Da'if","Musannaf Ibn Abi Shaybah 25945","","","كتاب الأدب"
"25946","(۲۵۹۴۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ فِطْرٍ ، عَنْ شُرَحْبِیلَ بْنِ سَعد ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَدْرَکَتْ لَہُ ابْنَتَانِ فَأَحْسَنَ إلَیْہِمَا مَا صَحِبَتَاہُ ، أَوْ صَحِبَہُمَا ، أَدْخَلَہُ اللَّہُ الْجَنَّۃَ بِہِمَا۔n(ابن ماجہ ۳۶۷۰۔ احمد ۱/۲۳۵)","Da'if","Musannaf Ibn Abi Shaybah 25946","","","كتاب الأدب"
"25947","(۲۵۹۴۷) حَدَّثَنَا دَاوُد بْنُ عَبْدِاللہِ، قَالَ: حدَّثَنَا عَبْدُالْعَزِیزِ بْنُ مُحَمَّدٍ، عَنْ سُہَیْلِ بْنِ أَبِی صَالِحٍ السَّمَّانِ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ مُکْمِلٍ ، عَنْ أَیُّوبَ بْنِ بَشِیرٍ الْمُعَاوِیِّ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یَکُونُ لأَحَدِکُمْ ثَلاَثُ بَنَاتٍ ، أَوْ ثَلاَثُ أَخَوَاتٍ فَیُحْسِنُ إلَیْہِنَّ إلاَّ دَخَلَ الْجَنَّۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 25947","","","كتاب الأدب"
"25948","(۲۵۹۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الْعَزِیزِ ، عَنْ عُبَیْدِ اللہِ بن أَبِی بَکْرٍ، عَنْ أَنَسٍ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ عَالَ جَارِیَتَیْنِ حَتَّی تَبْلُغَا جَائَ یَوْمَ الْقِیَامَۃِ أَنَا وَہُوَ ہَکَذَا وَضَمَّ إصْبَعَیْہِ۔ (مسلم ۲۰۲۷۔ ترمذی ۱۹۱۴)","Sahih","Musannaf Ibn Abi Shaybah 25948","","","كتاب الأدب"
"25949","(۲۵۹۴۹) حَدَّثَنَا مُصْعَبُ بْنُ الْمِقْدَامِ ، قَالَ : حدَّثَنَا مِنْدَلٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ عُمَرَ بْنِ نَبْہَانَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَانَ لَہُ ثَلاَثُ بَنَاتٍ فَصَبَرَ عَلَی لاَوَائِہِنَّ وَسَرَّائِہِنَّ وَضَرَّائِہِنَّ أَدْخَلْنہُ الْجَنَّۃَ بِفَضْلِ رَحْمَتِہِ إیَّاہُنَّ ، قَالَ رَجُلٌ : واثنتان ؟ قَالَ : وَاثْنَتَانِ ، قَالَ رَجُلٌ : وَوَاحِدَۃٌ ؟ قَالَ : وَوَاحِدَۃٌ۔ (احمد ۲/۳۳۵۔ حاکم ۱۷۶)","Da'if","Musannaf Ibn Abi Shaybah 25949","","","كتاب الأدب"
"25950","(۲۵۹۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : مَرَّ بِی عَمْرُو بْنُ بُلَیْلٍ وَأَنَا مُتَصَبِّحٌ فِی النَّخْلِ فَحَرَّکَنِی بِرِجْلِہِ فَقَالَ : أَتَرْقُدُ فِی السَّاعَۃِ الَّتِی یَنْتَشِرُ فِیہَا عِبَادُ اللہِ۔","","Musannaf Ibn Abi Shaybah 25950","","","كتاب الأدب"
"25951","(۲۵۹۵۱) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ الزُّبَیْرُ یَنْہَی بَنِیہِ عَنِ التَّصَبُّحِ ، قَالَ : وَقَالَ عُرْوَۃُ : إنِّی لأَسْمَعُ بِالرَّجُلِ یَتَصَبَّحُ فَأَزْہَدُ فِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 25951","","","كتاب الأدب"
"25952","(۲۵۹۵۲) حَدَّثَنَا حَفْصٌ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، عَنْ عَبْدِ اللہِ بْنِ فَرُّوخَ ، عَنْ طَلْحَۃَ بْنِ عُبَیْدِ اللہِ ، أَنَّہُ مَرَّ بِابْنٍ لَہُ قد تَصَبَّحَ ، فَذَکَرَ أَنَّہُ قَفَدہ ، وَنَہَاہُ عَنْ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 25952","","","كتاب الأدب"
"25953","(۲۵۹۵۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، قَالَ : الْتَقَی ابْنُ الزُّبَیْرِ وَعُبَیْدُ بْنُ عُمَیْرٍ فَتَذَاکَرَا شَیئًا فَقَالَ لَہُ الآخَرُ : أَمَا عَلِمْت أَنَّ الأَرْضَ تَعِجُّ إلَی رَبِّہَا مِنْ نَوْمَۃِ عُلَمَائِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 25953","","","كتاب الأدب"
"25954","(۲۵۹۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ الزُّبَیْرُ : إنِّی لأَزْہَدُ فِی الرَّجُلِ یَتَصَبَّحُ۔","Sahih","Musannaf Ibn Abi Shaybah 25954","","","كتاب الأدب"
"25955","(۲۵۹۵۵) حَدَّثَنَا مَعْنُ بْنُ عِیسَی، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ، عَنْ عُبَیْدِ اللہِ، قَالَ: کَانَ سَالِمٌ لاَ یَتَصَبَّحُ، وَکَانَ یَقِیلُ۔","","Musannaf Ibn Abi Shaybah 25955","","","كتاب الأدب"
"25956","(۲۵۹۵۶) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ مِثْلُہُ۔","","Musannaf Ibn Abi Shaybah 25956","","","كتاب الأدب"
"25957","(۲۵۹۵۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ مَکْحُولٍ مِثْلُہُ۔","","Musannaf Ibn Abi Shaybah 25957","","","كتاب الأدب"
"25958","(۲۵۹۵۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ، أَنَّہَا کَانَتْ تَصَبَّحُ۔","Sahih","Musannaf Ibn Abi Shaybah 25958","","","كتاب الأدب"
"25959","(۲۵۹۵۹) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ عَبْدِ اللہِ بْنِ الشَّمَّاسِ ، قَالَ : أَتَیْتُ أُمَّ سَلَمَۃَ فَوَجَدْتہَا نَائِمَۃً - یَعْنِی بَعْدَ الصُّبْحِ۔","Da'if","Musannaf Ibn Abi Shaybah 25959","","","كتاب الأدب"
"25960","(۲۵۹۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، أَنَّ عَائِشَۃَ کَانَتْ إذَا طَلَعَتِ الشَّمْسُ نَامَتْ نَوْمَۃَ الضُّحَی۔","Sahih","Musannaf Ibn Abi Shaybah 25960","","","كتاب الأدب"
"25961","(۲۵۹۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ، عَنْ عَبْدِ الأَعْلَی، قَالَ: أَتَیْتُ سَعِیدَ بْنَ جُبَیْرٍ فَوَجَدْتہ نَائِمًا نَوْمَۃَ الضُّحَی۔","No Data Available","Musannaf Ibn Abi Shaybah 25961","","","كتاب الأدب"
"25962","(۲۵۹۶۲) قَالَ : قَالَ : حَدَّثَنَا عَبْدُ الْوَارِثِ ، قَالَ :حَدَّثَنَا أَیُّوبُ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ کَانَ یَتَصَبَّحُ۔","","Musannaf Ibn Abi Shaybah 25962","","","كتاب الأدب"
"25963","(۲۵۹۶۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی یَزِیدَ الْمَدِینِیِّ ، قَالَ : غَدَا عُمَرُ عَلَی صُہَیْبٍ فَوَجَدَہُ مُتَصَبِّحًا ، فَقَعَدَ حَتَّی اسْتَیْقَظَ ، فَقَالَ صُہَیْبٌ : أَمِیرُ الْمُؤْمِنِینَ قَاعِدٌ عَلَی مَقْعَدَتِہِ وَصُہَیْبٌ نَاعِمٌ مُتَصَبِّحٌ ، فَقَالَ لَہُ عُمَرُ : مَا کُنْت أُحِبُّ أَنْ تَدَعَ نَوْمَۃً تَرْفُقُ بِکَ ۔","","Musannaf Ibn Abi Shaybah 25963","","","كتاب الأدب"
"25964","(۲۵۹۶۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ الزُّبَیْرُ شَدِیدًا عَلَی النِّسَائِ ، وَکَانَ یُکَسِّرُ عَلَیْہِنَّ عِیدَانَ الْمشَاحِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 25964","","","كتاب الأدب"
"25965","(۲۵۹۶۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ عُمَرُ یَضْرِبُ النِّسَائَ وَالْخَدَمَ۔","","Musannaf Ibn Abi Shaybah 25965","","","كتاب الأدب"
"25966","(۲۵۹۶۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرو ، قَالَ : لاَ تَضْرِبْ خَادِمَک وَاضْرِبِ امْرَأَتَکَ وَوَلَدَک۔","Da'if","Musannaf Ibn Abi Shaybah 25966","","","كتاب الأدب"
"25967","(۲۵۹۶۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، أَنَّ رِجَالاً نُہُوا عَنْ ضَرْبِ النِّسَائِ ، وَقِیلَ : لَنْ یَضْرِبَ خِیَارُکُمْ ، قَالَ الْقَاسِمُ : وَکَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَیْرَہُمْ کَانَ لاَ یَضْرِبُ۔n(ابوداؤد ۲۱۳۹۔ بیہقی ۳۰۴)","","Musannaf Ibn Abi Shaybah 25967","","","كتاب الأدب"
"25968","(۲۵۹۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : مَا ضَرَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَادِمًا لَہُ ، وَلاَ امْرَأَۃً ، وَلاَ ضَرَبَ شَیْئًا بِیَدِہِ۔ (مسلم ۱۸۱۴۔ ابوداؤد ۴۷۵۳)","Sahih","Musannaf Ibn Abi Shaybah 25968","","","كتاب الأدب"
"25969","(۲۵۹۶۹) حَدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ الطَّائِفِیُّ ، عَنْ إسْمَاعِیلَ بْنِ کَثِیرٍ ، عَنْ عَاصِمِ بْنِ لَقِیطِ بْنِ صَبِرَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَضْرِبَنَّ ظَعِینَتَکَ ضَرْبَک أَمَتِک۔","Sahih","Musannaf Ibn Abi Shaybah 25969","","","كتاب الأدب"
"25970","(۲۵۹۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ مَیْمُونِ بْنِ أَبِی شَبِیبٍ ، قَالَ : قَالَ عَمَّارٌ : مَنْ ضَرَبَ عَبْدَہُ ظَالِمًا أُقِیدَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 25970","","","كتاب الأدب"
"25971","(۲۵۹۷۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ زَمْعَۃَ ، قَالَ : خَطَبَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ ذَکَرَ النِّسَائَ فَوَعَظَہُمْ فِیہِنَّ فَقَالَ : إلاَمَ یَجْلِدُ أَحَدُکُمُ امْرَأَتَہُ جَلْدَ الأَمَۃِ ، ولَعَلَّہُ أَنْ یُضَاجِعَہَا مِنْ آخِرِ یَوْمِہِ۔ (بخاری ۴۹۴۲۔ مسلم ۲۱۹۱)","Sahih","Musannaf Ibn Abi Shaybah 25971","","","كتاب الأدب"
"25972","(۲۵۹۷۲) حَدَّثَنَا شَرِیکٌ ، عَنِ الرُّکَیْنِ ، عَنْ نُعَیْمِ بْنِ حَنْظَلَۃَ ، عَنْ عَمَّارٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَانَ لَہُ وَجْہَانِ فِی الدُّنْیَا کَانَ لَہُ یَوْمَ الْقِیَامَۃِ لِسَانَانِ مِنْ نَارٍ۔ (ابوداؤد ۴۸۴۰۔ دارمی ۲۷۶۴)","Hasan","Musannaf Ibn Abi Shaybah 25972","","","كتاب الأدب"
"25973","(۲۵۹۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرٍ ، عَنِ الزُّہْرِیِّ ، أَنَّ رَجُلاً سَلَّمَ عَلَی النَّبِیِّ ثَلاَثَ مَرَّاتٍ فَلَمْ یَرُدَّ عَلَیْہِ فَقِیلَ لَہُ : لِمَ ؟ فَقَالَ : إِنَّہُ ذُو وَجْہَیْنِ۔","","Musannaf Ibn Abi Shaybah 25973","","","كتاب الأدب"
"25974","(۲۵۹۷۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَجِدُ مِنْ شَرِّ النَّاسِ عِنْدَ اللہِ یَوْمَ الْقِیَامَۃِ ذُو الْوَجْہَیْنِ۔ (بخاری ۶۰۵۸۔ ترمذی ۲۰۲۵)","Sahih","Musannaf Ibn Abi Shaybah 25974","","","كتاب الأدب"
"25975","(۲۵۹۷۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِیہِ ، عَنْ عِکْرِمَۃَ ، قَالَ : قَالَ لَقَمِنٌ ذُو الْوَجْہَیْنِ لاَ یَکُونَ عِنْدَ اللہِ أَمِینًا۔ (بخاری ۳۱۳۔ احمد ۲/۳۶۵)","","Musannaf Ibn Abi Shaybah 25975","","","كتاب الأدب"
"25976","(۲۵۹۷۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنْ مَالِکِ بْنِ أَسْمَائَ بْنِ خَارِجَۃَ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ ابْنَ مَسْعُودٍ یَقُولُ : إنَّ ذَا اللِّسَانَیْنِ لَہُ لِسَانَانِ مِنْ نَارٍ یَوْمَ الْقِیَامَۃِ۔ (طبرانی ۹۱۶۸)","Da'if","Musannaf Ibn Abi Shaybah 25976","","","كتاب الأدب"
"25977","(۲۵۹۷۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، قَالَ : رَآنِی إبْرَاہِیمُ وَأَنَا أَتَمَخَّطُ بِیَمِینِی فَنَہَانِی وَقَالَ : عَلَیْک بِیَسَارِکَ ، وَلاَ تَعْتَادَنَّ تَمْتَخِطُ بِیَمِینِک۔","","Musannaf Ibn Abi Shaybah 25977","","","كتاب الأدب"
"25978","(۲۵۹۷۸) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنِ الأَعْمَشِ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ: کَانَت یَمِینُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِطَعَامِہِ وَصَلاَتِہِ، وَکَانَت شِمَالُہُ لِمَا سِوَی ذَلِکَ۔ (بخاری ۱۶۸۔ مسلم ۶۶)","Da'if","Musannaf Ibn Abi Shaybah 25978","","","كتاب الأدب"
"25979","(۲۵۹۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مُسَافِرٍ ، عَنْ رُزَیْقِ بْنِ سَوَّارٍ ، أَنَّ الْحَسَنَ بْنَ عَلِیٍّ امْتَخَطَ بِیَمِینِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 25979","","","كتاب الأدب"
"25980","(۲۵۹۸۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ الا??َعْمَشِ، عَنْ إبْرَاہِیمَ، قَالَ: کَانُوا یَکْرَہُونَ أَنْ یَمْتخِطَ الرَّجُلُ بِیَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 25980","","","كتاب الأدب"
"25981","(۲۵۹۸۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنِ الْحَکَمِ أَبِی مُعَاذٍ ، قَالَ : رَأَیْتُ الْحَسَنَ یَتَمَخَّطُ بِیَمِینِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 25981","","","كتاب الأدب"
"25982","(۲۵۹۸۲) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیلَی ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ مُحَمَّدِ بْنِ شُرَحْبِیلَ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الرَّجُلُ أَحَقُّ بِصَدْرِ دَابَّتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 25982","","","كتاب الأدب"
"25983","(۲۵۹۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ رَافِعٍ ، عَن مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، عَنْ عَمِّہ ، عَنْ أَبِی سَعِید قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الرَّجُلُ أَحَقُّ بِصَدْرِ دَابَّتِہِ وَإِذَا رَجَعَ إلَی مَجْلِسِہِ ، فَہُوَ أَحَقُّ بِہِ۔n(مسلم ۱۷۱۵۔ ابوداؤد ۴۸۱۹)","Da'if","Musannaf Ibn Abi Shaybah 25983","","","كتاب الأدب"
"25984","(۲۵۹۸۴) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ، قَالَ: کَانَ یُقَالُ: الرَّجُلُ أَحَقُّ بِصَدْرِ دَابَّتِہِ وَفِرَاشِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25984","","","كتاب الأدب"
"25985","(۲۵۹۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ الفُضَیْل ، عَنْ سُفْیَانَ الْعَطَّارِ ، قَالَ : رَأَیْتُ الشَّعْبِیَّ مُرْتَدِفًا خَلْفَ رَجُلٍ ، قَالَ : وَکَانَ یَقُولُ : صَاحِبُ الدَّابَّۃِ أَحَقُّ بِمُقَدَّمِہَا۔","","Musannaf Ibn Abi Shaybah 25985","","","كتاب الأدب"
"25986","(۲۵۹۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ عِیسَی بْنِ عَاصِمٍ ، قَالَ : قَالَ عَبْدُ اللہِ ، الرَّجُلُ أَحَقُّ بِصَدْرِ دَابَّتِہِ : وَالرَّجُلُ أَحَقُّ بِصَدْرِ فِرَاشِہِ۔","","Musannaf Ibn Abi Shaybah 25986","","","كتاب الأدب"
"25987","(۲۵۹۸۷) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حدَّثَنَا حَبِیبُ بْنُ شَہِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، أَنَّ مُعَاذَ بْنَ جَبَلٍ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِدَابَّۃٍ لِیَرْکَبَہَا ، فَقَالَ لہ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَبُّ الدَّابَّۃِ أَحَقُّ بِصَدْرِہَا ، قَالَ : فَقَالَ مُعَاذٌ : فَہِیَ لَکَ یَا نَبِیَّ اللہِ ، فَرَکِبَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَرْدَفَ مُعَاذًا۔n(ترمذی ۲۷۷۳۔ ابوداؤد ۲۵۶۵)","","Musannaf Ibn Abi Shaybah 25987","","","كتاب الأدب"
"25988","(۲۵۹۸۸) حَدَّثَنَا شَبَابَۃ ، قَالَ: حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، قَالَ: رَأَیْتُ حُمَیْدَ بْنَ ہِلاَلٍ وَالْحَسَنَ ، وَابْنَ سِیرِینَ، وَعَطَائً وَبَکْرَ بْنَ عَبْدِ اللہِ لاَ یُحْفُونَ شَوَارِبَہُمْ۔","","Musannaf Ibn Abi Shaybah 25988","","","كتاب الأدب"
"25989","(۲۵۹۸۹) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ مُحَمَّدِ بْنِ ہِلاَلٍ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ الْمُسَیَّبِ وَعُمَرَ بْنَ عَبْدِ الْعَزِیزِ وَسَالِمًا وَعُرْوَۃَ بْنَ الزُّبَیْرِ وَجَعْفَرَ بْنَ الزُّبَیْرِ وَعُبَیْدَ اللہِ بْنَ عَبْدِ اللہِ بْنِ عُتْبَۃَ وَأَبَا بَکْرِ بْنَ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ لاَ یُحْفُونَ شَوَارِبَہُمْ جِدًّا ، یَأْخُذُونَ مِنْہَا أَخْذًا حَسَنًا۔","","Musannaf Ibn Abi Shaybah 25989","","","كتاب الأدب"
"25990","(۲۵۹۹۰) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَن ثَابِتِ بْنِ قَیْسٍ ، عَنِ نَافِعَ بْنَ جُبَیْرٍ ، وَعِرَاک بن مَالِکَ : مِثْلَہ۔","","Musannaf Ibn Abi Shaybah 25990","","","كتاب الأدب"
"25991","(۲۵۹۹۱) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ سِمَاکِ بْنِ یَزِیدَ ، قَالَ : کَانَ عَلِیٌّ یَأْخُذُ مِنْ لِحْیَتِہِ مِمَّا یَلِی وَجْہَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 25991","","","كتاب الأدب"
"25992","(۲۵۹۹۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ أَیُّوبَ مِنْ وَلَدِ جَرِیرٍ ، عَنْ أَبِی زُرْعَۃَ ، قَالَ : کَانَ أَبُو ہُرَیْرَۃَ یَقْبِضُ عَلَی لِحْیَتِہِ ، ثُمَّ یَأْخُذُ مَا فَضَلَ عَنِ الْقُبْضَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 25992","","","كتاب الأدب"
"25993","(۲۵۹۹۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، قَالَ : سَمِعْتُ عَطَائَ بْنَ أَبِی رَبَاحٍ ، قَالَ : کَانُوا یُحِبُّونَ أَنْ یُعْفُوا اللِّحْیَۃَ إلاَّ فِی حَجٍّ ، أَوْ عُمْرَۃٍ ، وَکَانَ إبْرَاہِیمُ یَأْخُذُ مِنْ عَارِضِ لِحْیَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25993","","","كتاب الأدب"
"25994","(۲۵۹۹۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یَأْخُذُ مِنْ لِحْیَتِہِ ، وَلاَ یُوجِبُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 25994","","","كتاب الأدب"
"25995","(۲۵۹۹۵) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانُوا یُرَخِّصُونَ فِیمَا زَادَ عَلَی الْقُبْضَۃِ مِنَ اللِّحْیَۃِ أَنْ یُؤْخَذَ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 25995","","","كتاب الأدب"
"25996","(۲۵۹۹۶) حَدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ أَفْلَحَ ، قَالَ : کَانَ الْقَاسِمُ إذَا حَلَقَ رَأْسَہُ أَخَذَ مِنْ لِحْیَتِہِ وَشَارِبِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 25996","","","كتاب الأدب"
"25997","(۲۵۹۹۷) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، وَوَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَأْخُذُ مَا فَوْقَ الْقُبْضَۃِ ، وَقَالَ وَکِیعٌ : مَا جَازَ الْقُبْضَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 25997","","","كتاب الأدب"
"25998","(۲۵۹۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ قَتَادَۃَ ، قَالَ : قَالَ جَابِرٌ : لاَ نَأْخُذُ مِنْ طُولِہَا إلاَّ فِی حَجٍّ ، أَوْ عُمْرَۃٍ۔","","Musannaf Ibn Abi Shaybah 25998","","","كتاب الأدب"
"25999","(۲۵۹۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ أَیُّوبَ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّہُ کَانَ یَأْخُذُ مِنْ لِحْیَتِہِ مَا جَازَ الْقُبْضَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 25999","","","كتاب الأدب"
"26000","(۲۶۰۰۰) حَدَّثَنَا وَکِیعٌ، عَنْ أَبِی ہِلاَلٍ، قَالَ: سَأَلْتُ الْحَسَنَ، وَابْنَ سِیرِینَ فَقَالاَ: لاَ بَأْسَ بِہِ أَنْ تَأْخُذَ مِنْ طُولِ لِحْیَتِک۔","","Musannaf Ibn Abi Shaybah 26000","","","كتاب الأدب"
"26001","(۲۶۰۰۱) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ، قَالَ: کَانُوا یُبَطِّنُونَ لِحَاہُمْ وَیَأْخُذُونَ مِنْ عَوَارِضِہَا۔","","Musannaf Ibn Abi Shaybah 26001","","","كتاب الأدب"
"26002","(۲۶۰۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حُسَیْنٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یَتَحَذَّفَ کِلْ أو کِرد یَرْکُوش۔","","Musannaf Ibn Abi Shaybah 26002","","","كتاب الأدب"
"26003","(۲۶۰۰۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : انْہَکُوا الشَّوَارِبَ وَاعْفُوا اللِّحَی۔ (بخاری ۵۸۹۳۔ مسلم ۲۲۲)","Sahih","Musannaf Ibn Abi Shaybah 26003","","","كتاب الأدب"
"26004","(۲۶۰۰۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یُوسُفَ بْنِ صُہَیْبٍ ، عَنْ حَبِیبِ بْنِ یَسَارٍ ، عَنْ زَیْدِ بْنِ أَرْقَمَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ مِنَّا مَنْ لَمْ یَأْخُذْ مِنْ شَارِبِہِ۔ (ترمذی ۲۷۶۱)","Sahih","Musannaf Ibn Abi Shaybah 26004","","","كتاب الأدب"
"26005","(۲۶۰۰۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُثْمَانَ الْحَاطِبِیِّ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یُحْفِی شَارِبَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 26005","","","كتاب الأدب"
"26006","(۲۶۰۰۶) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ حَبِیبٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ قَدْ جَزَّ شَارِبَہُ کَأَنَّہُ قَدْ حَلَقَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 26006","","","كتاب الأدب"
"26007","(۲۶۰۰۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ أَنَّہُمَا کَانَا یُحْفِیَانِ شَوَارِبَہُمَا۔","","Musannaf Ibn Abi Shaybah 26007","","","كتاب الأدب"
"26008","(۲۶۰۰۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : رَأَیْتُ عَبْدَ اللہِ یُحْفِی شَارِبَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 26008","","","كتاب الأدب"
"26009","(۲۶۰۰۹) حَدَّثَنَا قَبِیصَۃُ بْنُ عُقْبَۃَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی رَافِعٍ ، قَالَ: رَأَیْتُ أَبَا سَعِیدٍ وَرَافِعَ بْنَ خَدِیجٍ وَسَلَمَۃَ بْنَ الأَکْوَعِ ، وَابْنَ عُمَرَ وَجَابِرَ بْنَ عَبْدِ اللہِ وَأَبَا أُسَیْدَ یُنْہِکُونَ شَوَارِبَہُمَا أَخَا الْحَلْقِ۔","Hasan","Musannaf Ibn Abi Shaybah 26009","","","كتاب الأدب"
"26010","(۲۶۰۱۰) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا ہُرَیْمٌ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ مَکْحُولٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : أُمِرْنَا أَنْ نَبْشُرَ الشَّوَارِبَ بَشْرًا۔","Hasan","Musannaf Ibn Abi Shaybah 26010","","","كتاب الأدب"
"26011","(۲۶۰۱۱) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُمَرَ ، قَالَ : سُئِلَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : مَا السُّنَّۃُ فِی قص الشَّارِبِ ؟ قَالَ : یُقَصُّ حَتَّی یَبْدُوَ الإِطَارُ وَیُقْطَعُ فَضْلُ الشَّارِبَیْنِ۔","","Musannaf Ibn Abi Shaybah 26011","","","كتاب الأدب"
"26012","(۲۶۰۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْقِلٍ ، عَنْ مَیْمُونٍ ، قَالَ : کَانَ ابْنُ عُمَرَ یَعْتَرِضُ شَارِبَہُ فَیَجُزُّہُ کَمَا یَجُزُّ الْغَنَمَ۔","","Musannaf Ibn Abi Shaybah 26012","","","كتاب الأدب"
"26013","(۲۶۰۱۳) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، قَالَ : أَخْبَرَنَا أَبُو الْعُمَیْسِ ، عَنْ عَبْدِ المجید بْنِ سُہَیْلٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عبد اللہ بن عُتْبَۃَ ، قَالَ : جَائَ رَجُلٌ مِنَ الْمَجُوسِ إلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قد حَلَقَ لِحْیَتَہُ ، وَأَطَالَ شَارِبَہُ ، فَقَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا ہَذَا ؟ قَالَ : ہَذَا فِی دِینِنَا، قَالَ: فِی دِینِنَا أَنْ نَجُزَّ الشَّارِبَ، وَأَنْ نُعْفِیَ اللِّحْیَۃَ۔ (مسلم ۲۲۲۔ احمد ۲/۳۶۶)","","Musannaf Ibn Abi Shaybah 26013","","","كتاب الأدب"
"26014","(۲۶۰۱۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَخْذُ الشَّارِبِ مِنَ الدِّینِ۔ (ترمذی ۲۷۶۰۔ احمد ۱/۳۰۱)","","Musannaf Ibn Abi Shaybah 26014","","","كتاب الأدب"
"26015","(۲۶۰۱۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ حَسَنٍ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُصُّ مِنْ شَارِبِہِ ، وَکَانَ إِبْرَاہِیمُ ، خَلِیلُ اللہِ ، یَقُصُّ شَارِبَہُ ، أَوْ مِنْ شَارِبِہِ۔","","Musannaf Ibn Abi Shaybah 26015","","","كتاب الأدب"
"26016","(۲۶۰۱۶) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : کُنَّا نُؤْمَرُ أَنْ نُوَفِّیَ السِّبَالَ ، وَنَأْخُذَ مِنَ الشَّوَارِبِ۔ (ابوداؤد ۴۱۹۸۔ احمد ۵/۲۶۵)","Da'if","Musannaf Ibn Abi Shaybah 26016","","","كتاب الأدب"
"26017","(۲۶۰۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنْ مُصْعَبِ بْنِ شَیْبَۃَ ، عَنْ طَلْقِ بْنِ حَبِیبٍ ، عَنِ ابن الزُّبَیْرِ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مِنَ الْفِطْرَۃِ قَصُّ الشَّارِبِ ، وَإِعْفَائُ اللِّحْیَۃِ۔n(بخاری ۶۲۸۷۔ مسلم ۱۶۶۳)","Hasan","Musannaf Ibn Abi Shaybah 26017","","","كتاب الأدب"
"26018","(۲۶۰۱۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عَبَّادِ بْنِ تَمِیمٍ ، عَنْ عَمِّہِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُسْتَلْقِیًا فِی الْمَسْجِد ، قَدْ وَضَعَ إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی۔","Sahih","Musannaf Ibn Abi Shaybah 26018","","","كتاب الأدب"
"26019","(۲۶۰۱۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ یَحْیَی بْنِ عَبْدِ اللہِ بْنِ مَالِکٍ ، عَنْ أَبِیہِ ، قَالَ : دَخَلَ عَلَی عُمَرَ أَو رُئِی مُسْتَلْقِیًا وَاضِعًا إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی۔","Da'if","Musannaf Ibn Abi Shaybah 26019","","","كتاب الأدب"
"26020","(۲۶۰۲۰) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ الْحَارِثِ ، أَنَّہُ رَأَی أُسَامَۃَ بْنَ زَیْدٍ جَالِسًا وَاضِعًا إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی۔","Da'if","Musannaf Ibn Abi Shaybah 26020","","","كتاب الأدب"
"26021","(۲۶۰۲۱) حَدَّثَنَا وَکِیعٌ، عَنْ أُسَامَۃَ، عَنْ نَافِعٍ، قَالَ : کَانَ ابْنُ عُمَرَ یَضْطَجِعُ فَیَضَعُ إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی۔","Hasan","Musannaf Ibn Abi Shaybah 26021","","","كتاب الأدب"
"26022","(۲۶۰۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أُسَامَۃَ ، عَنْ نَافِعٍ : قَالَ ابْنُ عُمَرَ یَسْتَلْقِی عَلَی قَفَاہُ وَیَضَعُ إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی لاَ یَرَی بِذَلِکَ بَأْسًا ، وَیَفْعَلُہُ وَہُوَ جَالِسٌ لاَ یَرَی بِذَلِکَ بَأْسًا۔","Hasan","Musannaf Ibn Abi Shaybah 26022","","","كتاب الأدب"
"26023","(۲۶۰۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : إنَّمَا یَنْہَی عَنْ ذَلِکَ أَہْلُ الْکِتَابِ ، وَقَالَ عَامِرٌ وَمُحَمَّدُ بْنُ عَلِیٍّ : لاَ بَأْسَ بہ۔","No Data Available","Musannaf Ibn Abi Shaybah 26023","","","كتاب الأدب"
"26024","(۲۶۰۲۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ الغَسِیل ، قَالَ : حدَّثَنِی عَمْرُو بْنُ أَبِی عَمْرٍو ، أَنَّ بِلاَلاً فَعَلَہُ : وَضَعَ إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی۔","","Musannaf Ibn Abi Shaybah 26024","","","كتاب الأدب"
"26025","(۲۶۰۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْعَزِیزِ الْمَاجِشُونِ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّ عُمَرَ وَعُثْمَانَ کَانَا یَفْعَلاَنِہِ۔ (بخاری ۴۷۵۔ ابوداؤد ۴۸۳۴)","Sahih","Musannaf Ibn Abi Shaybah 26025","","","كتاب الأدب"
"26026","(۲۶۰۲۶) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ عَمِّہِ، قَالَ: رَأَیْتُ ابْنَ مَسْعُودٍ فِی الأَرَاکِ مُسْتَلْقِیًا وَاضِعًا إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی وَہُوَ یَقُولُ: {رَبَّنَا لاَ تَجْعَلْنَا فِتْنَۃً لِلْقَوْمِ الظَّالِمِینَ}۔","Da'if","Musannaf Ibn Abi Shaybah 26026","","","كتاب الأدب"
"26027","(۲۶۰۲۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عِمْرَانَ - یَعْنِی ابْنَ مُسْلِمٍ - قَالَ : رَأَیْتُ أَنَسًا وَاضِعًا إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی ۔","Sahih","Musannaf Ibn Abi Shaybah 26027","","","كتاب الأدب"
"26028","(۲۶۰۲۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، عَنِ الْحَکَمِ ، قَالَ : سَأَلْتُ أَبَا مِجْلَزٍ عَنِ الرَّجُلِ یَجْلِسُ ، وَیَضَعُ إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی فَقَالَ : لاَ بَأْسَ بِہِ ، إنَّمَا ہُوَ شَیْئٌ کَرِہَتْہُ الْیَہُودُ ، قَالُوا : إِنَّہُ خَلَقَ السَّمَاوَاتِ وَالأَرْضَ فِی سِتَّۃِ أَیَّامٍ ، ثُمَّ اسْتَوَی یَوْمَ السَّبْتِ فَجَلَسَ تِلْکَ الْجِلْسَۃَ۔","","Musannaf Ibn Abi Shaybah 26028","","","كتاب الأدب"
"26029","(۲۶۰۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنِ ابْنِ سِیرِینَ ، أَنَّ ہَارُونَ بْنَ رِئَابٍ ، قَالَ لَہُ وَہُوَ جَالِسٌ عَلَی سَرِیرِہِ وَاضِعًا إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی : یُکْرَہُ ہَذَا یَا أَبَا بَکْرٍ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 26029","","","كتاب الأدب"
"26030","(۲۶۰۳۰) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنِی الرَّبِیعُ بْنُ الْمُنْذِرِ ، قَالَ : حَدَّثَنِی أَبِی ، قَالَ : رَأَیْتُ مُحَمَّدَ بْنَ الْحَنَفِیَّۃِ وَاضِعًا إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی۔","No Data Available","Musannaf Ibn Abi Shaybah 26030","","","كتاب الأدب"
"26031","(۲۶۰۳۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ إسْرَائِیلَ ، قَالَ : قیلَ لَہُ : أَرَأَیْت الشَّعْبِیَّ یَضَعُ إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 26031","","","كتاب الأدب"
"26032","(۲۶۰۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ إسْمَاعِیلَ بْنِ أبی إسْمَاعِیلَ رَاشِدٍ ، قَالَ : اسْتَلْقَیْت فَرَفَعْت إحْدَی رِجْلَیْ عَلَی رُکْبَتِی ، فَرَمَانِی سَعِیدٌ بِحَصَیَاتٍ ، ثُمَّ قَالَ : إنَّ ابْنَ عَبَّاسٍ کَانَ یَنْہَی عَنْ ہَذَا۔","Da'if","Musannaf Ibn Abi Shaybah 26032","","","كتاب الأدب"
"26033","(۲۶۰۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنِ ابْنِ سِیرِینَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَرِہَ أَنْ یَضْطَجِعَ وَیَضَعَ إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی۔","Hasan","Musannaf Ibn Abi Shaybah 26033","","","كتاب الأدب"
"26034","(۲۶۰۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیل ، عَنْ وَاصِلٍ ، أَنَّ جَرِیرًا جَلَسَ وَوََضَعَ إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی فَقَالَ لَہُ کَعْبٌ : ضَعْہَا ، فَإن ہَذَا لاَ یَصْلُحُ لِبَشَرٍ۔","","Musannaf Ibn Abi Shaybah 26034","","","كتاب الأدب"
"26035","(۲۶۰۳۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنْ عَمْرِو بْنِ عُتْبَۃَ بْنِ فَرْقَدٍ ، أَنَّ کَعْبًا ، قَالَ لَہُ : ضَعْہَا ، فَإِنَّ ہَذَا لاَ یَصْلُحُ لِبَشَرٍ۔","","Musannaf Ibn Abi Shaybah 26035","","","كتاب الأدب"
"26036","(۲۶۰۳۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ حَبِیبٍ ، قَالَ : رَآنِی مُحَمَّدٌ وَقَدْ وَضَعْت رِجْلِی ہَکَذَا وَوَضَعَ قَدَمَہُ الْیُمْنَی عَلَی فَخِذِہِ الْیُسْرَی ، قَالَ : فَقَالَ : ارْفَعْہَا ، قَدْ تَوَاطَؤُوا عَلَی الْکَرَاہِیَۃِ لَہَا ، قَالَ : فَذَکَرْت لِلْحَسَنِ ، قَالَ : کَانَتِ الْیَہُودُ یَکْرَہُونَہُ فَخَالَفَہُمُ الْمُسْلِمُونَ۔","","Musannaf Ibn Abi Shaybah 26036","","","كتاب الأدب"
"26037","(۲۶۰۳۷) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یَجْلِسَ الرَّجُلُ فَیَضَعَ عَقِبَہُ عَلَی فَخِذِہِ وقال : ہُوَ التَّوَرُّکُ۔","","Musannaf Ibn Abi Shaybah 26037","","","كتاب الأدب"
"26038","(۲۶۰۳۸) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، أَنَّہُ نَہَی عَنْہُ۔","","Musannaf Ibn Abi Shaybah 26038","","","كتاب الأدب"
"26039","(۲۶۰۳۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، أَنَّہُ کَرِہَ التَّرَبُّعَ وَقَالَ : جِلْسَۃُ مَمْلَکَۃٍ۔","","Musannaf Ibn Abi Shaybah 26039","","","كتاب الأدب"
"26040","(۲۶۰۴۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْمُجَالِدِ ، قَالَ : أَخْبَرَنِی عَامِرٌ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ الْعَبَّاسُ لابْنِہِ عَبْدِ اللہِ بن عباس : یَا بُنَیَّ ، إنِّی أَرَی أَمِیرَ الْمُؤْمِنِینَ یُقَرِّبُک ، وَیَسْتَشِیرُک مَعَ أُنَاسٍ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَیَخْلُو بِکَ ، فَاحْفَظْ عَنِّی ثَلاَثًا : اتَّقِ اللَّہَ لاَ یُجَرِّبَنَّ عَلَیْک کِذْبَۃً ، وَلاَ تُفْشِیَنَّ لَہُ سِرًّا ، وَلاَ تَغتَابنَّ عِنْدَہُ أَحَدًا ، قَالَ : فَقُلْت لابْنِ عَبَّاسٍ : یَا أَبَا عَبَّاسٍ ، کُلُّ وَاحِدَۃٍ مِنْہُنَّ خَیْرٌ مِنْ أَلْفٍ ، قَالَ : وَمِنْ عَشَرَۃِ آلاَفٍ۔","Da'if","Musannaf Ibn Abi Shaybah 26040","","","كتاب الأدب"
"26041","(۲۶۰۴۱) حَدَّثَنَا عَبْدُاللہِ بْنُ إدْرِیسَ، عَنِ ابْنِ عَجْلاَنَ، عَنْ إبْرَاہِیمَ بْنِ مُرَّۃَ، عَنْ مُحَمَّدِ بْنِ شِہَابٍ، قَالَ: قَالَ عُمَرُ: لاَ تَعْتَرِضْ فِیمَا لاَ یَعْنِیک ، وَاعْتَزِلْ عَدُوَّک ، وَاحْتَفِظْ مِنْ خَلِیلک إلاَّ الأَمِین ، فَإِنَّ الأَمِین لاَ یُعَادِلُہُ شَیْئٌ، لاَ تَصْحَبِ الْفَاجِرَ فَیُعَلِّمُک مِنْ فُجُورِہِ ، وَلاَ تُفْشِ إلَیْہِ بسِرّک ، وَاسْتَشِرْ فِی أَمْرِکَ الَّذِینَ یَخْشَوْنَ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 26041","","","كتاب الأدب"
"26042","(۲۶۰۴۲) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : لاَ تُحَدِّثْ بِالْحَدِیثِ مَنْ لاَ یَعْرِفُہُ ، فَإِنَّ مَنْ لاَ یَعْرِفُہُ یَضُرُّہُ ، وَلاَ یَنْفَعُہُ۔","","Musannaf Ibn Abi Shaybah 26042","","","كتاب الأدب"
"26043","(۲۶۰۴۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا حُمَیْدٌ الطَّوِیلُ ، عَنْ أَنَسٍ ، قَالَ : کُنْتُ مَعَ الْغِلْمَانِ فَمَرَّ عَلَیْنَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَلَّمَ عَلَیْنَا ، ثُمَّ بَعَثَنِی فِی حَاجَۃٍ وَجَلَسَ فِی جِدَارٍ ، أَوْ فِی ظِلٍّ حَتَّی أَتَیْتہ فَأَبْلَغْتہ حَاجَتَہُ ، فَلَمَّا أَتَیْتُ أُمَّ سُلَیْمٍ ، قَالَتْ : مَا حَبَسَک الْیَوْمَ ؟ قُلْتُ : بَعَثَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی حَاجَۃٍ ، قَالَتْ : مَا ہِیَ ؟ قُلْتُ : أَنَّہَا سِرٌّ ، قَالَتْ : فَاحْفَظْ سِرَّ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَمَا حَدَّثْت بِہَا أَحَدًا قَطُّ۔ (بخاری ۱۱۳۹۔ مسلم ۱۴۵)","Sahih","Musannaf Ibn Abi Shaybah 26043","","","كتاب الأدب"
"26044","(۲۶۰۴۴) حَدَّثَنَا حَفْصُ بْنِ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ أَبِی ہُبَیْرَۃَ یَحْیَی بْنِ عَبَّادٍ ، قَالَ : الْمُسْلِمُ مِرْآۃُ أَخِیہِ ، فَإِذَا أَخَذَ عَنْہُ شَیْئًا فَلْیُرِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 26044","","","كتاب الأدب"
"26045","(۲۶۰۴۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ غَالِبٍ ، قَالَ : سَأَلْتُ الْحَسَنَ أو سَأَلَہُ رَجُلٌ عَنِ الرَّجُلِ یَأْخُذُ عَنِ الرَّجُلِ الشَّیْئَ فَیَقُولُ : لاَ یَکُنْ بِکَ السُّوئُ ، أَوْ صُرِفَ عَنْک السُّوئَ ، قَالَ : فَقَالَ : یَقُولُ : لاَ یَکُنْ بِکَ السُّوئُ فَإِنَّہُ إِلاَّ یَکُنْ بہ خَیْرٌ مِنْ أَنْ یَکُونَ بِہِ ثُمَّ یُصْرَفُ۔","","Musannaf Ibn Abi Shaybah 26045","","","كتاب الأدب"
"26046","(۲۶۰۴۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : قَالَ عُمَرُ : إذَا أَخَذَ أَحَدُکُمْ عَنْ أَخِیہِ شَیْئًا فَلْیُرِہِ إِیَّاہ۔","","Musannaf Ibn Abi Shaybah 26046","","","كتاب الأدب"
"26047","(۲۶۰۴۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ یَحْیَی بْنِ عُبَیْدِ اللہِ التَّیْمِیِّ ، قَالَ : سَمِعْتُ أَبِی یَقُولُ : سَمِعْت أَبَا ہُرَیْرَۃَ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَحَدُکُمْ مِرْآۃُ أَخِیہِ ، فَإِذَا رَأَی أَذًی فَلْیُمِطْہُ عَنْہُ۔n(بخاری ۲۳۹۔ ابوداؤد ۴۸۸۲)","Da'if","Musannaf Ibn Abi Shaybah 26047","","","كتاب الأدب"
"26048","(۲۶۰۴۸) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنْ یَحْیَی بْنِ الْحُصَیْنِ، عَنْ طَارِقِ بْنِ شِہَابٍ، قَالَ: کَانَ بَیْنَ خَالِدِ بْنِ الْوَلِیدِ وَبَیْنَ سَعْدٍ کَلاَمٌ ، قَالَ : فَتَنَاوَلَ رَجُلٌ خَالِدًا عِنْدَ سَعْدٍ ، قَالَ : فَقَالَ : سَعْدٌ : مَہْ ، فَإِنَّ مَا بَیْنَنَا لَمْ یَبْلُغْ دِینَنَا۔","Sahih","Musannaf Ibn Abi Shaybah 26048","","","كتاب الأدب"
"26049","(۲۶۰۴۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ زَیْدِ بْنِ صُوحَانَ ، قَالَ : قَالَ عُمَرُ : مَا یَمْنَعُکُمْ إذَا رَأَیْتُمُ الرَّجُلَ یَخْرِقُ أَعْرَاضَ النَّاسِ أن لاَ تُغَیِّرُوا عَلَیْہِ؟ قَالُوا: نَتَّقِی لِسَانَہُ، قَالَ: ذَاکَ أَدْنَی أَنْ تَکُونُوا شُہَدَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 26049","","","كتاب الأدب"
"26050","(۲۶۰۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ قَیْسٍ ، أَنَّ عَمْرَو بْنَ الْعَاصِ مَرَّ عَلَی بَغْلٍ مَیِّتٍ فَقَالَ لأَصْحَابِہِ : إِنْ یَأْکُلْ أَحَدُکُمْ مِنْ ہَذَا حَتَّی یَمْلاَ بَطْنَہُ خَیْرٌ مِنْ أَنْ یَأْکُلَ لَحْمَ أَخِیہِ الْمُسْلِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 26050","","","كتاب الأدب"
"26051","(۲۶۰۵۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ إبْرَاہِیمَ ، قَالَ : حَدَّثَنَا الْعَلاَئُ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ لَہُ : مَا الْغِیبَۃُ یَا رَسُولَ اللہِ ؟ قَالَ : ذِکْرُک أَخَاک بِمَا یَکْرَہُ ، قَالَ : أَفَرَأَیْت إِنْ کَانَ فِی أَخِی مَا أَقُولُ یَا رَسُولَ اللہِ ؟ قَالَ : إِنْ کَانَ فِی أَخِیک مَا تَقُولُ ، فَقَدِ اغْتَبْتہ ، وَإِنْ لَمْ یَکُنْ فِیہِ مَا تَقُولُ ، فَقَدْ بَہَتَّہُ۔ (مسلم ۲۰۰۱۔ ابوداؤد ۴۸۴۱)","Hasan","Musannaf Ibn Abi Shaybah 26051","","","كتاب الأدب"
"26052","(۲۶۰۵۲) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنِ ابْنٍ لأَبِی الدَّرْدَائِ ، أَنَّ رَجُلاً وَقَعَ فِی رَجُلٍ فَرَدَّ عَنْہُ آخَرُ فَقَالَ أَبُو الدَّرْدَائِ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ ذَبَّ عَنْ عِرْضِ أَخِیہِ کَانَ لَہُ حِجَابًا مِنَ النَّارِ۔ (ترمذی ۱۹۳۱۔ احمد ۶/۴۵۰)","Da'if","Musannaf Ibn Abi Shaybah 26052","","","كتاب الأدب"
