hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"1201","977  / 2  - وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ، وَأَبُو يَاسِينَ  ، قَالَا :  حَدَّثَنَا  يُوسُفُ بِهِ .  قُلْتُ :  تَفَرَّدَ بِهِ  يُوسُفُ  ، وَهُوَ  ضَعِيفٌ جِدًّا  .         [5/701]             [5/702]      كذا في طبعة دار العاصمة ، ولعل الصواب : ( أبو ياسر )","","Al-Matalib al-Aliyah 977","","أنس بن مالك عن ثابت البناني عن يوسف بن عطية بن ثابت الصفار عن سليمان بن داود العتكي عن أبو يعلى الموصلي","باب الحث على المعروف وإعانة الملهوف وإغاثته"
"1202","[5/703]      978  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ بَحْرٍ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ زَيْدٍ الْعَمِّيُّ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْحَسَنِ ،  عَنْ  أَنَسٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ مَشَى إِلَى حَاجَةِ أَخِيهِ الْمُسْلِمِ كَتَبَ اللهُ تَعَالَى لَهُ بِكُلِّ خُطْوَةٍ يَخْطُوهَا حَسَنَةً إِلَى أَنْ يَرْجِعَ مِنْ حَيْثُ فَارَقَهُ  ، إِنْ قُضِيَتْ حَاجَتُهُ خَرَجَ مِنْ ذُنُوبِهِ كَيَوْمِ وَلَدَتْهُ أُمُّهُ ، وَإِنْ هَلَكَ فِيمَا بَيْنَ ذَلِكَ دَخَلَ الْجَنَّةَ بِغَيْرِ حِسَابٍ  .  عَبْدُ الرَّحِيمِ  ضَعِيفٌ جِدًّا  .","","Al-Matalib al-Aliyah 978","","أنس بن مالك عن الحسن البصري عن زيد بن الحواري العمي عن عبد الرحيم بن زيد بن الحواري العمي عن محمد بن بحر الهجيمي عن أبو يعلى الموصلي","باب الحث على المعروف وإعانة الملهوف وإغاثته"
"1203","[5/704]      979  / 1  -  وَقَالَ أَيْضًا :  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  الصَّلْتُ يَعْنِي ابْنَ الْحَجَّاجِ ،  عَنْ  يَزِيدَ الرَّقَاشِيِّ ،  عَنْ  أَنَسٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَعَانَ أَخَاهُ فِي حَاجَتِهِ ، وَأَلْطَفَهُ ،  كَانَ حَقًّا عَلَى اللهِ تَعَالَى أَنْ يُخْدِمَهُ مِنْ خَدَمِ الْجَنَّةِ  .","","Al-Matalib al-Aliyah 979","","أنس بن مالك عن يزيد بن أبان الرقاشي عن الصلت بن الحجاج الكوفي عن سليمان بن داود العتكي عن أبو يعلى الموصلي","باب الحث على المعروف وإعانة الملهوف وإغاثته"
"1204","979  / 2  -         [5/705]      حَدَّثَنَا  مُحَمَّدُ بْنُ بَحْرٍ ،  حَدَّثَنَا  الْمُعَلَّى بْنُ مَيْمُونٍ الْمُجَاشِعِيُّ ،  حَدَّثَنَا  يَزِيدُ الرَّقَاشِيُّ ،  عَنْ  أَنَسٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَلْطَفَ مُؤْمِنًا ، أَوْ خَوَّلَهُ فِي شَيْءٍ مِنْ حَوَائِجِهِ ، صَغُرَ ذَلِكَ أَوْ كَبُرَ  ...  فَذَكَرَ مِثْلَهُ .  قُلْتُ :  مَدَارُهُ عَلَى  يَزِيدَ  ، وَهُوَ  ضَعِيفٌ  .","","Al-Matalib al-Aliyah 979","","أنس بن مالك عن يزيد بن أبان الرقاشي عن معلى بن ميمون الخصاف عن محمد بن بحر الهجيمي عن أبو يعلى الموصلي","باب الحث على المعروف وإعانة الملهوف وإغاثته"
"1205","[5/706]      980  -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  عَبْدُ الْحَكَمِ بْنُ مَنْصُورٍ ،  حَدَّثَنَا  زِيَادُ بْنُ أَبِي حَسَّانَ ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ - رَضِيَ اللهُ عَنْهُ - يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَغَاثَ  مَلْهُوفًا  كَتَبَ اللهُ تَعَالَى لَهُ ثَلَاثًا وَسَبْعِينَ حَسَنَةً  ، وَاحِدَةً مِنْهُنَّ يُصْلِحُ اللهُ تَعَالَى بِهَا لَهُ أَمْرَ دُنْيَاهُ وَآخِرَتِهِ ، وَاثْنَتَيْنِ وَسَبْعِينَ فِي الدَّرَجَاتِ  .         [5/707]             [5/708]","","Al-Matalib al-Aliyah 980","","أنس بن مالك عن زياد بن أبي حسان النبطي عن عبد الحكيم بن منصور الخزاعي عن سليمان بن داود العتكي عن أبو يعلى الموصلي","باب الحث على المعروف وإعانة الملهوف وإغاثته"
"1206","[5/709]      981  -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ بْنِ مَيْسَرَةَ ،  حَدَّثَنَا  السَّكَنُ بْنُ إِسْمَاعِيلَ ،  حَدَّثَنَا  زِيَادُ بْنُ مَيْمُونٍ ،  عَنْ  أَنَسٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الدَّالُّ عَلَى الْخَيْرِ كَفَاعِلِهِ  ، وَاللهُ تَعَالَى يُحِبُّ إِغَاثَةَ  اللهْفَانِ  .  قُلْتُ :  زِيَادُ ابْنُ أَبِي حَسَّانَ هُوَ زِيَادُ بْنُ مَيْمُونٍ  ،  مَتْرُوكٌ  .         [5/710]             [5/711]             [5/712]","","Al-Matalib al-Aliyah 981","","أنس بن مالك عن زياد الفاكهي عن السكن بن إسماعيل البرجمي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","باب الحث على المعروف وإعانة الملهوف وإغاثته"
"1207","[5/713]      982  -  وَحَدَّثَنَا  جُبَارَةُ هُوَ ابْنُ الْمُغَلِّسِ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ بْنُ الْأَزْرَقِ ،  أَخْبَرَنِي  سُكَيْنُ بْنُ أَبِي سِرَاجٍ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ، قَالَ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَنْ خَيْرُ النَّاسِ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنْفَعُهُمْ لِلنَّاسِ  .         [5/714]","","Al-Matalib al-Aliyah 982","","ميمون بن مهران الرقي عن عبد الله بن دينار البهراني عن سكين بن أبي سراج عن عبد الصمد بن سليمان الأزرق عن جبارة بن المغلس عن أبو يعلى الموصلي","باب الحث على المعروف وإعانة الملهوف وإغاثته"
"1208","[5/715]      983  -  وَحَدَّثَنَا  مُصْعَبٌ الزُّبَيْرِيُّ ،  حَدَّثَنِي  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرٍ ،  عَنِ  الْأَعْرَجِ ،  عَنْ  أَبِي هُرَيْرَةَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ - رَضِيَ اللهُ عَنْهُمْ - قَالَ :  لَا يَزَالُ اللهُ تَعَالَى فِي حَاجَةِ الْعَبْدِ مَا دَامَ الْعَبْدُ فِي حَاجَةِ أَخِيهِ  . يُحَدِّثُ ذَلِكَ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .         [5/716]             [5/717]","","Al-Matalib al-Aliyah 983","","زيد بن ثابت الأنصاري عن أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن عبد الله بن عامر الأسلمي عن عبد العزيز بن محمد الدراوردي عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","باب الحث على المعروف وإعانة الملهوف وإغاثته"
"1209","[5/718]      36 - بَابُ ذَمِّ الْبُخْلِ  984  -  قَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  بَعْضِ أَزْوَاجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ لِفُلَانٍ نَخْلَةً فِي حَائِطِي ، فَمُرْهُ فَلْيَبِعْهَا ، أَوْ لِيَهَبْهَا لِي . قَالَ : فَأَتَى  الرَّجُلُ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : افْعَلْ ، لَكَ بِهَا نَخْلَةٌ فِي الْجَنَّةِ ، فَأَبَى ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  هَذَا أَبْخَلُ النَّاسِ  .         [5/719]","","Al-Matalib al-Aliyah 984","","أحد الصحابة عن ذكوان السمان عن الأعمش عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة","باب ذم البخل"
"1210","[5/720]      37 - بَابُ إِنْجَازِ الْوَعْدِ  985  -  قَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  عَبْدُ الْوَهَّابِ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  عَنِ  امْرَأَةٍ ، قَالَتْ :  سَأَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَيْئًا فَلَمْ يَتَيَسَّرْ ، فَقَالَتْ :  يَا رَسُولَ اللهِ ، عِدْنِي ، قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : الْعِدَةُ عَطِيَّةٌ  .         [5/721]","","Al-Matalib al-Aliyah 985","","أحد الصحابة عن الحسن البصري عن يونس بن عبيد عن عبد الوهاب بن عبد المجيد الثقفي عن ابن أبي عمر العدني","باب إنجاز الوعد"
"1211","[5/722]      38 - بَابُ  زَجْرِ  الضَّيْفِ عَنْ تَكْلِيفِ صَاحِبِ الْمَنْزِلِ  986  -  قَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ مَنْصُورٍ ،  حَدَّثَنَا  حُسَيْنُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ قَرْمٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ، قَالَ :  ذَهَبْتُ مَعَ صَاحِبٍ لِي إِلَى سَلْمَانَ - رَضِيَ اللهُ عَنْهُ - فَجَاءَ بِخُبْزٍ وَمِلْحٍ ، فَقَالَ صَاحِبِي : لَوْ كَانَ فِي مِلْحِنَا سَعْتَرٌ ، فَبَعَثَ  سَلْمَانُ  - رَضِيَ اللهُ عَنْهُ – بِمِطْهَرَتِهِ ، فَجَاءَ بِسَعْتَرٍ ، فَلَمَّا أَكَلْنَا قَالَ صَاحِبِي : الْحَمْدُ لِلهِ الَّذِي قَنَّعَنَا بِمَا رَزَقَنَا .  فَقَالَ  سَلْمَانُ  - رَضِيَ اللهُ عَنْهُ -  : لَوْ قَنِعْتَ لَمْ تَكُنْ مِطْهَرَتِي مَرْهُونَةً  .","","Al-Matalib al-Aliyah 986","","سلمان الفارسي عن شقيق بن سلمة عن الأعمش عن سليمان بن قرم الضبي عن الحسين بن محمد بن بهرام المروذي عن محمد بن منصور الطوسي عن أبو يعلى الموصلي","باب زجر الضيف عن تكليف صاحب المنزل"
"1212","[6/7]      11 - كِتَابُ الصِّيَامِ  1 - بَابُ  الشَّهْرِ  يَكُونُ تِسْعًا وَعِشْرِينَ  987  إِسْحَاقُ ،  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ وَاقِدٍ الْجَزَرِيُّ ، قَالَ :  سَمِعْتُ  الْأَوْزَاعِيَّ  يُحَدِّثُ ، عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  عُثْمَانَ بْنِ عَفَّانَ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الشَّهْرُ  تِسْعٌ وَعِشْرُونَ  .","","Al-Matalib al-Aliyah 987","","عثمان بن عفان عن عمرو بن شعيب عن أبو عمرو الأوزاعي عن عبد الله بن واقد الحراني عن إسحاق ابن راهويه","باب الشهر يكون تسعا وعشرين"
"1213","[6/8]      2 - بَابُ الصَّوْمِ لِلرُّؤْيَةِ  988  الْحَارِثُ ،  حَدَّثَنَا  دَاوُدُ ،  ثَنَا  حَمَّادٌ ،  عَنْ  حَجَّاجٍ ،  عَنِ  الْحَسَنِ ، قَالَ :  إِنَّ  عَبْدَ اللهِ بْنَ يَزِيدَ خَطَبَ النَّاسَ بِالْمَوْسِمِ ، فَقَالَ : يَا أَيُّهَا النَّاسُ ، إِنَّا قَدْ شَهِدْنَا أَصْحَابَ مُحَمَّدٍ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَسَمِعْنَا عَنْهُمْ ،  وَحَدَّثُونَا  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صُومُوا لِرُؤْيَةِ الْهِلَالِ ، وَأَفْطِرُوا لِرُؤْيَتِهِ  ، فَإِنْ خَفِيَ عَلَيْكُمْ فَأَكْمِلُوا الْعِدَّةَ ثَلَاثِينَ يَوْمًا ، وَإِنْ شَهِدَ ذَوَا عَدْلٍ فَصُومُوا لِرُؤْيَتِهِمَا ، وَأَفْطِرُوا لَهَا ، وَأَمْسِكُوا لَهَا  .         [6/9]","","Al-Matalib al-Aliyah 988","","أحد الصحابة عن عبد الله بن يزيد رضيع عائشة عن الحسن البصري عن حجاج بن أبى عثمان الصواف الكندي عن حماد بن سلمة عن داود بن المحبر البكراوي عن الحارث بن محمد بن أبي أسامة","باب الصوم للرؤية"
"1214","[6/10]      3 - بَابُ  الزَّجْرِ  عَنْ تَقْدِيمِ رَمَضَانَ بِيَوْمٍ أَوْ يَوْمَيْنِ  989  -  الْحَارِثُ ،  حَدَّثَنَا  دَاوُدُ ،  ثَنَا  حَمَّادٌ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  قَالُوا لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَلَا تَتَقَدَّمُ فَتَزِيدَ يَوْمًا أَوْ يَوْمَيْنِ ؟  فَغَضِبَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .         [6/11]","","Al-Matalib al-Aliyah 989","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن حماد بن سلمة عن داود بن المحبر البكراوي عن الحارث بن محمد بن أبي أسامة","باب الزجر عن تقديم رمضان بيوم أو يومين"
"1215","[6/12]      4 - بَابُ تَأْخِيرِ صَلَاةِ الْمَغْرِبِ  لِمُرَاقَبَةِ الْهِلَالِ لَيْلَةَ الصَّوْمِ أَوِ الْفِطْرِ  990  -  الْحَارِثُ ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  ثَنَا  حَيْوَةُ ،  عَنِ  ابْنِ شِهَابٍ ، قَالَ :  السُّنَّةُ لَيْلَةً يُنْظَرُ إِلَى هِلَالِ رَمَضَانَ لِلصِّيَامِ أَوْ لِلْفِطْرِ  : يُؤَذَّنُ لِصَلَاةِ الْمَغْرِبِ لِوَقْتِهَا ، ثُمَّ تُؤَخَّرُ الْإِقَامَةُ ، حَتَّى يُرَى الْهِلَالُ ، أَوْ يُوأَسَ مِنْهُ ، وَيَبْدُوَ بَعْضُ النُّجُومِ  .","","Al-Matalib al-Aliyah 990","","الزهري عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن الحارث بن محمد بن أبي أسامة","باب تأخير صلاة المغرب لمراقبة الهلال ليلة الصوم أو الفطر"
"1216","[6/13]      5 - بَابُ لَا يَتِمُّ شَهْرَانِ جَمِيعًا  991  -  قَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  عَنْ  أَبِي شَيْبَةَ ،  عَنْ  سَعِيدِ بْنِ زَيْدِ بْنِ عُقْبَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  سَمُرَةَ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يُتِمُّ شَهْرَانِ سِتِّينَ يَوْمًا  .  أَبُو شَيْبَةَ هُوَ إِبْرَاهِيمُ بْنُ عُثْمَانَ جَدُّ أَبِي بَكْرٍ  ،  ضَعِيفٌ  .         [6/14]             [6/15]","","Al-Matalib al-Aliyah 991","","سمرة بن جندب عن زيد بن عقبة الفزاري عن سعيد بن زيد الفزاري عن إبراهيم بن عثمان أبو شيبة العبسي عن يزيد بن هارون عن أبو بكر ابن أبي شيبة","باب لا يتم شهران جميعا"
"1217","[6/16]      992  -  وَقَالَ مُسَدَّدٌ ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  عَنِ  الرُّكَيْنِ ،  عَنْ  حُصَيْنِ بْنِ قَبِيصَةَ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، قَالَ :  الشَّهْرُ  ثَلَاثُونَ ، وَالشَّهْرُ تِسْعٌ وَعِشْرُونَ  .","","Al-Matalib al-Aliyah 992","","علي بن أبي طالب عن حصين بن قبيصة الفزاري عن ركين بن الربيع الفزاري عن سفيان الثوري عن يحيى القطان عن مسدد بن مسرهد","باب لا يتم شهران جميعا"
"1218","[6/17]      993  -  وَقَالَ الْحَارِثُ ،  حَدَّثَنَا  رَوْحٌ ،  ثَنَا  شُعْبَةُ ، قَالَ :  سَمِعْتُ  سِمَاكًا ، يَقُولُ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ شَدَّادٍ وَعِكْرِمَةَ يُحَدِّثَانِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الشَّهْرُ  تِسْعٌ وَعِشْرُونَ  .","","Al-Matalib al-Aliyah 993","","عكرمة مولى ابن عباس عن سماك بن حرب البكري عن شعبة بن الحجاج عن روح بن عبادة القيسي عن الحارث بن محمد بن أبي أسامة","باب لا يتم شهران جميعا"
"1219","[6/18]      994  -  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ ،  حَدَّثَنَا  رَوْحٌ ،  ثَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  ابْنُ أَبِي مُلَيْكَةَ ،  عَنْ  رَجُلٍ مِنْ بَنِي تَمِيمٍ لَا نُكَذِّبُهُ ، قَالَ :  أَخْبَرْتُ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، أَنَّ  ابْنَ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الشَّهْرُ  تِسْعٌ وَعِشْرُونَ ، فَأَنْكَرَتْ ذَلِكَ ، وَقَالَتْ : يَغْفِرُ اللهُ  لِأَبِي عَبْدِ الرَّحْمَنِ  ، لَيْسَ كَذَلِكَ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَلَكِنْ قَالَ :  الشَّهْرُ  يَكُونُ تِسْعًا وَعِشْرِينَ  .","","Al-Matalib al-Aliyah 994","","عائشة بنت أبي بكر الصديق عن رجل من بني تميم عن ابن أبي مليكة عن ابن جريج عن روح بن عبادة القيسي عن أحمد بن منيع البغوي","باب لا يتم شهران جميعا"
"1220","[6/19]      6 - بَابُ عَلَامَةِ كَوْنِ الْهِلَالِ لِلَيْلَتِهِ  995  -  أَبُو يَعْلَى ،  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الرَّسْعَنِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  ثَنَا  بَقِيَّةُ ،  عَنْ  عُثْمَانَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا غَابَ الْهِلَالُ قَبْلَ  الشَّفَقِ  فَهُوَ لِلَيْلَتِهِ  ، وَإِذَا غَابَ بَعْدَ  الشَّفَقِ  ، فَهُوَ لِلَيْلَتَيْنِ  .         [6/20]","","Al-Matalib al-Aliyah 995","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عثمان بن عبد الرحمن الطرائفي عن بقية بن الوليد عن عبد الله بن صالح المصري عن جعفر بن محمد بن الفضيل الرسعني عن أبو يعلى الموصلي","باب علامة كون الهلال لليلته"
"1221","[6/21]      7 - بَابُ مَا يُقَالُ عِنْدَ رُؤْيَةِ الْهِلَالِ  996  -  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  هُشَيْمٌ  عَنْ  أَبِي بِشْرٍ ،  عَنْ  عَبَّادِ بْنِ جَعْفَرٍ الْمَخْزُومِيِّ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا رَأَى الْهِلَالَ قَالَ :  آمَنْتُ بِاللهِ الَّذِي خَلَقَكَ  - ثَلَاثًا -  .","","Al-Matalib al-Aliyah 996","","عباد بن جعفر بن رفاعة عن جعفر بن إياس اليشكري عن هشيم بن بشير عن مسدد بن مسرهد","باب ما يقال عند رؤية الهلال"
"1222","[6/22]      8 - بَابُ قَبُولِ شَهَادَةِ الْأَعْرَابِ فِي الصَّوْمِ وَالْفِطْرِ  997  -  قَالَ الْحَارِثُ ،  حَدَّثَنَا  رَوْحٌ ،  ثَنَا  شُعْبَةُ قَالَ :  سَمِعْتُ  مَنْصُورًا  يُحَدِّثُ ، عَنْ  رِبْعِيِّ بْنِ حِرَاشٍ ،  أَنَّ أَعْرَابِيَّيْنِ شَهِدَا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُمَا رَأَيَا الْهِلَالَ  بِالْأَمْسِ  لِفِطْرٍ ، أَوْ أَضْحَى  ، فَأَجَازَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ شَهَادَتَهُمَا  .  هَذَا  مُرْسَلٌ  صَحِيحُ الْإِسْنَادِ  .         [6/23]","","Al-Matalib al-Aliyah 997","","ربعي بن حراش العبسي عن منصور بن المعتمر عن شعبة بن الحجاج عن روح بن عبادة القيسي عن الحارث بن محمد بن أبي أسامة","باب قبول شهادة الأعراب في الصوم والفطر"
"1223","[6/24]      9 - بَابُ فَضْلِ الصَّوْمِ  998  -  قَالَ أَبُو بَكْرٍ ،  حَدَّثَنَا  عَفَّانُ ،  ثَنَا  حَمَّادٌ ،  عَنْ  عُثْمَانَ الْبَتِّيِّ ،  عَنْ  نُعَيْمِ بْنِ أَبِي هِنْدٍ ،  عَنْ  حُذَيْفَةَ رَضِيَ اللهُ عَنْهُ ، قَالَ :  كُنْتُ مُسْنِدًا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى صَدْرِي ، فَقَالَ :  مَنْ صَامَ يَوْمًا ابْتِغَاءَ وَجْهِ اللهِ تَعَالَى ، خُتِمَ لَهُ بِهِ دَخَلَ الْجَنَّةَ  .","","Al-Matalib al-Aliyah 998","","حذيفة بن اليمان عن نعيم بن أبي هند الأشجعي عن عثمان بن مسلم عن حماد بن سلمة عن عفان بن مسلم الصفار عن أبو بكر ابن أبي شيبة","باب فضل الصوم"
"1224","[6/25]      999  -  وَقَالَ عَبْدُ بْنُ حُمَيْدٍ ،  حَدَّثَنَا  رَوْحٌ ،  ثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  عَمْرِو بْنِ عَبَسَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَامَ يَوْمًا فِي  سَبِيلِ  اللهِ بُوعِدَ مِنَ النَّارِ  مَسِيرَةَ  مِائَةِ عَامٍ  .","","Al-Matalib al-Aliyah 999","","عمرو  بن عبسة ربع الإسلام عن مكحول بن أبي مسلم عن محمد بن راشد المكحولي عن روح بن عبادة القيسي عن عبد بن حميد","باب فضل الصوم"
"1225","[6/26]      1000  وَقَالَ الْحَارِثُ ،  حَدَّثَنَا  دَاوُدُ بْنُ الْمُحَبَّرِ ،  ثَنَا  زَايِدَةُ بْنُ قُدَامَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شِمْرِ بْنِ عَطِيَّةَ ،  عَنْ  أَبِي الدَّرْدَاءِ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَامَ يَوْمًا فِي  سَبِيلِ  اللهِ عَزَّ وَجَلَّ جَعَلَ اللهُ بَيْنَهُ وَبَيْنَ النَّارِ خَنْدَقًا  ، عَرْضُهُ كَمَا بَيْنَ السَّمَاءِ وَالْأَرْضِ  .","","Al-Matalib al-Aliyah 1000","","أبو الدرداء عن شمر بن عطية الكاهلي عن الأعمش عن زائدة بن قدامة عن داود بن المحبر البكراوي عن الحارث بن محمد بن أبي أسامة","باب فضل الصوم"
"1226","[6/27]      1001  وَقَالَ الْحَارِثُ ،  حَدَّثَنَا  أَبُو الْحَسَنِ بِشْرُ بْنُ أَبِي بِشْرٍ الْبَصْرِيُّ ،  أَخْبَرَنِي  الْوَلِيدُ بْنُ عَبْدِ الْوَاحِدِ الْحَرَّانِيُّ ،  ثَنَا  حَيَّانُ الْبَصْرِيُّ ،  عَنْ  إِسْحَاقَ بْنِ نُوحٍ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  سَعِيدِ بْنِ زَيْدِ بْنِ عَمْرِو بْنِ نُفَيْلٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَقْبَلَ عَلَى  أُسَامَةَ بْنِ زَيْدٍ  رَضِيَ اللهُ عَنْهُمَا فَقَالَ :  يَا  أُسَامَةُ  عَلَيْكَ بِطَرِيقِ الْجَنَّةِ ، وَإِيَّاكَ أَنْ  تَخْتَلِجَ  دُونَهَا  . فَقَالَ : يَا رَسُولَ اللهِ ، مَا أَسْرَعُ مَا يُقْطَعُ بِهِ ذَلِكَ الطَّرِيقُ ؟ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : الظَّمَأُ فِي الْهَوَاجِرِ ، وَحَبْسُ النَّفْسِ عَنْ لَذَّةِ النِّسَاءِ . يَا  أُسَامَةُ  ، وَعَلَيْكَ بِالصَّوْمِ ; فَإِنَّهُ يُقَرِّبُ إِلَى اللهِ عَزَّ وَجَلَّ ، إِنَّهُ لَيْسَ شَيْءٌ أَحَبَّ إِلَى اللهِ تَعَالَى مِنْ رِيحِ فَمِ الصَّائِمِ ، تَرَكَ الطَّعَامَ وَالشَّرَابَ لِلهِ تَعَالَى ، فَإِنِ اسْتَطَعْتَ أَنْ يَأْتِيَكَ الْمَوْتُ وَبَطْنُكَ جَائِعٌ وَكَبِدُكَ ظَمْآنُ فَافْعَلْ ، فَإِنَّكَ تُدْرِكُ بِذَلِكَ شَرَفَ الْمَنْزِلِ فِي الْآخِرَةِ ، وَتَحُلُّ مَعَ النَّبِيِّينَ ، فَتَفْرَحُ بِقُدُومِ رُوحِكَ عَلَيْهِمْ ، وَيُصَلِّي عَلَيْكَ الْجَبَّارُ ، فَذَكَرَ الْحَدِيثَ ، وَفِيهِ : وَاعْلَمْ يَا  أُسَامَةُ  أَنَّ أَقْرَبَ النَّاسِ مِنَ اللهِ تَعَالَى يَوْمَ الْقِيَامَةِ لَمَنْ طَالَ حُزْنُهُ وَعَطَشُهُ وَجُوعُهُ فِي الدُّنْيَا  .  وَسَيَأْتِي إِنْ شَاءَ اللهُ بِتَمَامِهِ فِي الزُّهْدِ  .","","Al-Matalib al-Aliyah 1001","","سعيد بن زيد بن عمرو العدوي عن أبو جعفر الباقر عن إسحاق بن نوح الشامي عن حيان بن عبد الله الدارمي عن الوليد بن عبد الواحد التيمي عن أبو الحسن بشر بن أبي بشر البصري عن الحارث بن محمد بن أبي أسامة","باب فضل الصوم"
"1227","[6/28]      1002  وَقَالَ أَبُو يَعْلَى ،  حَدَّثَنَا  بِشْرُ بْنُ هِلَالٍ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ أَنَّ رَجُلًا صَامَ يَوْمًا تَطَوُّعًا ، ثُمَّ أُعْطِيَ مِلْءَ الْأَرْضِ ذَهَبًا  ، لَمْ يَسْتَوْفِ ثَوَابَهُ دُونَ الْحِسَابِ  .","","Al-Matalib al-Aliyah 1002","","أبو هريرة الدوسي عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن عبد الوارث بن سعيد بن ذكوان عن بشر بن هلال الصواف عن أبو يعلى الموصلي","باب فضل الصوم"
"1228","[6/29]      1003  وَقَالَ أَيْضًا :  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى ،  ثَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنِي  ابْنُ لَهِيعَةَ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ، قَالَ : إِنَّ لَهِيعَةَ  حَدَّثَهُ  عَنْ  عَمْرِو بْنِ رَبِيعَةَ ،  عَنْ  سَلَمَةَ بْنِ قَيْصَرَ ، قَالَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ صَامَ يَوْمًا ابْتِغَاءَ وَجْهِ اللهِ تَعَالَى ، بَاعَدَهُ اللهُ مِنْ  جَهَنَّمَ  ، كَبُعْدِ غُرَابٍ طَارَ وَهُوَ فَرْخٌ حَتَّى مَاتَ  هَرَمًا  .         [6/30]","","Al-Matalib al-Aliyah 1003","","سلامة بن قيصر الحضرمي عن عمرو بن ربيعة الحضرمي عن لهيعة بن عقبة الأعدولي عن زبان بن فائد الحمراوي عن عبد الله بن لهيعة عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","باب فضل الصوم"
"1229","[6/31]      1004  قَالَ أَبُو يَعْلَى ،  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَامَ يَوْمًا فِي  سَبِيلِ  اللهِ تَعَالَى مُتَطَوِّعًا فِي غَيْرِ رَمَضَانَ  ، بُعِّدَ مِنَ النَّارِ مِائَةَ عَامٍ سَيْرَ الْمُضَمَّرِ الْجَوَادِ  .","","Al-Matalib al-Aliyah 1004","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن يحيى بن أيوب الغافقي عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","باب فضل الصوم"
"1230","[6/32]      1005  قَالَ أَبُو يَعْلَى :  حَدَّثَنَا  حَفْصُ بْنُ عَبْدِ اللهِ الْحُلْوَانِيُّ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  أَبِي بَكْرِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  حَبِيبِ بْنِ عُبَيْدٍ ،  عَنْ  أَبِي الدَّرْدَاءِ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِكُلِّ شَيْءٍ بَابٌ ، وَبَابُ الْعِبَادَةِ الصِّيَامُ  .","","Al-Matalib al-Aliyah 1005","","أبو الدرداء عن حبيب بن عبيد الرحبي عن أبو بكر الغساني عن عبد الله بن المبارك عن حفص بن عبد الله الحلواني عن أبو يعلى الموصلي","باب فضل الصوم"
"1231","[6/33]      10 - بَابُ فَضْلِ رَمَضَانَ  1006  قَالَ الْحَارِثُ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ بَكْرٍ ،  حَدَّثَنِي  بَعْضُ أَصْحَابِنَا رَجُلٌ يُقَالُ لَهُ : إِيَاسٌ ،  رَفَعَ الْحَدِيثَ إِلَى  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  سَلْمَانَ الْفَارِسِيِّ ، قَالَ :  خَطَبَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ آخِرَ يَوْمٍ مِنْ شَعْبَانَ فَقَالَ :  يَا أَيُّهَا النَّاسُ ، إِنَّهُ قَدْ  أَظَلَّكُمْ  شَهْرٌ مُبَارَكٌ ، فِيهِ لَيْلَةٌ خَيْرٌ مِنْ أَلْفِ شَهْرٍ  ،  فَرَضَ  اللهُ صِيَامَهُ ، وَجَعَلَ قِيَامَ لَيْلِهِ تَطَوُّعًا ، فَمَنْ تَطَوَّعَ فِيهِ  بِخَصْلَةٍ  مِنَ الْخَيْرِ كَانَ كَمَنْ أَدَّى فَرِيضَةً فِيمَا سِوَاهُ ، وَمَنْ أَدَّى فِيهِ فَرِيضَةً كَانَ كَمَنْ أَدَّى سَبْعِينَ فَرِيضَةً ، فَهُوَ شَهْرُ الصَّبْرِ ، وَالصَّبْرُ ثَوَابُهُ الْجَنَّةُ ، وَهُوَ شَهْرُ الْمُوَاسَاةِ ، وَهُوَ شَهْرٌ يُزَادُ فِيهِ رِزْقُ الْمُؤْمِنِ ، مَنْ فَطَّرَ فِيهِ صَائِمًا كَانَ لَهُ عِتْقُ رَقَبَةٍ ، وَمَغْفِرَةٌ لِذُنُوبِهِ . قِيلَ : يَا رَسُولَ اللهِ ، لَيْسَ كُلُّنَا نَجِدُ مَا نُفَطِّرُ بِهِ الصَّائِمَ . قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : يُعْطِي اللهُ تَعَالَى هَذَا الثَّوَابَ مَنْ فَطَّرَ صَائِمًا عَلَى مَذْقَةِ لَبَنٍ ، أَوْ تَمْرَةٍ ، أَوْ شَرْبَةِ مَاءٍ ، وَمَنْ أَشْبَعَ صَائِمًا كَانَ لَهُ مَغْفِرَةٌ لِذُنُوبِهِ ، وَسَقَاهُ اللهُ عَزَّ وَجَلَّ مِنْ حَوْضِي شَرْبَةً لَا يَظْمَأُ حَتَّى يَدْخُلَ الْجَنَّةَ ، وَكَانَ لَهُ مِثْلُ أَجْرِهِ مِنْ غَيْرِ أَنْ يُنْقِصَ مِنْ أَجْرِهِ شَيْئًا . وَهُوَ شَهْرٌ أَوَّلُهُ رَحْمَةٌ ، وَأَوْسَطُهُ مَغْفِرَةٌ ، وَآخِرُهُ عِتْقٌ مِنَ النَّارِ ، وَمَنْ خَفَّفَ فِيهِ عَنْ مَمْلُوكِهِ أَعْتَقَهُ اللهُ مِنَ النَّارِ  .         [6/34]","","Al-Matalib al-Aliyah 1006","","سلمان الفارسي عن سعيد بن المسيب عن إياس بن أبي إياس عن عبد الله بن بكر بن حبيب عن الحارث بن محمد بن أبي أسامة","باب فضل رمضان"
"1232","[6/35]      1007  وَقَالَ أَبُو يَعْلَى ،  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَبَّانَ ،  ثَنَا  الْفَضْلُ بْنُ الْعَلَاءِ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنِ  الْفَضْلِ بْنِ عِيسَى ،  عَنْ  عَمِّهِ يَزِيدَ بْنِ أَبَانَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  هَذَا شَهْرُ رَمَضَانَ قَدْ جَاءَ ، تُفَتَّحُ فِيهِ أَبْوَابُ السَّمَاءِ  ، وَتُغَلَّقُ فِيهِ أَبْوَابُ النَّارِ ، وَتُغَلُّ فِيهِ الشَّيَاطِينُ ، مَنْ أَدْرَكَ رَمَضَانَ وَلَمْ يُغْفَرْ لَهُ فِيهِ فَمَتَى يُغْفَرُ لَهُ ؟  .  هَذَا حَدِيثٌ  ضَعِيفٌ  .         [6/36]","","Al-Matalib al-Aliyah 1007","","أنس بن مالك عن يزيد بن أبان الرقاشي عن الفضل بن عيسى الواعظ عن محمد بن إسحاق عن الفضل بن العلاء الكوفي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","باب فضل رمضان"
"1233","[6/37]      1008  وَقَالَ أَيْضًا :  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عَرْعَرَةَ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  عَمْرُو بْنُ حَمْزَةَ أَبُو أُسَيْدٍ ،  ثَنَا  خَلَفٌ أَبُو الرَّبِيعِ :  قَالَ  أَنَسٌ رَضِيَ اللهُ عَنْهُ ،  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ حَضَرَ رَمَضَانُ : سُبْحَانَ اللهِ ، مَاذَا تَسْتَقْبِلُونَ ، أَوْ مَاذَا يَسْتَقْبِلُ الْمَرْءُ ثَلَاثًا . فَقَالَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ : يَا رَسُولَ اللهِ ، وَحْيٌ نَزَلَ ؟ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لَا . قَالَ رَضِيَ اللهُ عَنْهُ : فَعَدُوٌّ حَضَرَ ؟ قَالَ : لَا . قَالَ : فَمَاذَا ؟ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ تَعَالَى يَغْفِرُ فِي أَوَّلِ لَيْلَةٍ مِنْ شَهْرِ رَمَضَانَ لِكُلِّ أَهْلِ الْقِبْلَةِ  . فَنَظَرَ إِلَى إِنْسَانٍ قَاعِدٍ بَيْنَ يَدَيْهِ وَهُوَ يُحَرِّكُ رَأْسَهُ وَيَقُولُ :  بَخٍ  بَخٍ  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : كَأَنَّهُ ضَاقَ صَدْرُكَ قَالَ : لَا ، وَلَكِنْ ذَكَرْتُ الْمُنَافِقِينَ ، قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّ الْمُنَافِقَ هُوَ الْكَافِرُ ، وَلَيْسَ لِلْكَافِرِ مِنْ ذَلِكَ شَيْءٌ  .  أَخْرَجَهُ  ابْنُ خُزَيْمَةَ  ، وَقَالَ : إِنْ صَحَّ الْخَبَرُ فَإِنِّي لَا أَعْرِفُ  خَلَفًا  وَلَا  عَمْرَو بْنَ حَمْزَةَ الْقَيْسِيَّ  بِعَدَالَةٍ وَلَا جَرْحٍ  .         [6/38]             [6/39]      ( 40 ) حَدِيثُ  أَبِي ذَرٍّ  رَضِيَ اللهُ عَنْهُ فِي أَوَّلِ أَحَادِيثِ الْأَنْبِيَاءِ عَلَيْهِمُ الصَّلَاةُ وَالسَّلَامُ .","","Al-Matalib al-Aliyah 1008","","أنس بن مالك عن خلف بن مهران العدوي عن عمرو بن حمزة القيني عن مسلم بن إبراهيم الشحام عن إبراهيم بن محمد بن عرعرة عن أبو يعلى الموصلي","باب فضل رمضان"
"1234","[6/40]      1009  -  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ ، وَالْحَارِثُ بْنُ أَبِي أُسَامَةَ ، جَمِيعًا :  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  هِشَامُ بْنُ أَبِي هِشَامٍ ،  عَنْ  مُحَمَّدِ بْنِ مُحَمَّدِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُعْطِيَتْ أُمَّتِي خَمْسَ خِصَالٍ فِي رَمَضَانَ لَمْ تُعْطَهَا أُمَّةٌ قَبْلَهُمْ  ،  خُلُوفُ  فَمِ الصَّائِمِ أَطْيَبُ عِنْدَ اللهِ مِنْ رِيحِ الْمِسْكِ ، وَتَسْتَغْفِرُ لَهُمُ الْمَلَائِكَةُ حَتَّى يُفْطِرُوا ، وَيُزَيِّنُ اللهُ كُلَّ يَوْمٍ جَنَّتَهُ ثُمَّ يَقُولُ :  يُوشِكُ  عِبَادِي الصَّائِمُونَ أَنْ يُلْقُوا عَنْهُمُ الْمُؤْنَةَ وَالْأَذَى ، وَيَصِيرُوا إِلَيْكِ ، وَتُصَفَّدُ فِيهِ  مَرَدَةُ  الشَّيَاطِينِ ، فَلَا يَخْلُصُونَ فِيهِ إِلَى مَا كَانُوا يَخْلُصُونَ فِي غَيْرِهِ ، وَيُغْفَرُ لَهُمْ فِي آخِرِ لَيْلَةٍ ، قِيلَ : يَا رَسُولَ اللهِ ، هِيَ لَيْلَةُ الْقَدْرِ ؟ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لَا ، وَلَكِنَّ الْعَامِلَ إِنَّمَا يُوَفَّى أَجْرَهُ إِذَا قَضَى عَمَلَهُ  .  هَذَا  إِسْنَادٌ ضَعِيفٌ  .         [6/41]","","Al-Matalib al-Aliyah 1009","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن محمد بن الأسود الزهري عن هشام بن زياد بن أبي يزيد العثماني عن يزيد بن هارون عن أحمد بن منيع البغوي","باب فضل رمضان"
"1235","[6/42]      1010  وَقَالَ أَبُو يَعْلَى ،  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ أَبِي سَمِينَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  حَدَّثَنِي  جَرِيرُ بْنُ أَيُّوبَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  نَافِعِ بْنِ بُرْدَةَ ،  عَنِ  ابْنِ مَسْعُودٍ رَضِيَ اللهُ عَنْهُ ،  أَنَّهُ سَمِعَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَقُولُ وَقَدْ أَهَلَّ شَهْرُ رَمَضَانَ :  لَوْ يَعْلَمُ الْعِبَادُ مَا فِي رَمَضَانَ لَتَمَنَّتْ أُمَّتِي أَنْ تَكُونَ السَّنَةُ كُلُّهَا رَمَضَانَ  . فَقَالَ  رَجُلٌ مِنْ خُزَاعَةَ  : حَدِّثْنَا بِهِ ، قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّ الْجَنَّةَ لَتَزَيَّنُ فِي رَمَضَانَ مِنْ رَأْسِ الْحَوْلِ إِلَى رَأْسِ الْحَوْلِ ، حَتَّى إِذَا كَانَ أَوَّلُ يَوْمٍ مِنْ رَمَضَانَ هَبَّتْ رِيحٌ مِنْ تَحْتِ الْعَرْشِ فَصَفَّقَتْ وَرَقَ الْجَنَّةِ ، فَتَنْظُرُ  الْحُورُ  الْعِينُ  إِلَى ذَلِكَ ، فَتَقُولُ : يَا رَبِّ اجْعَلْ لَنَا مِنْ عِبَادِكَ فِي هَذَا  الشَّهْرِ  الشَّرِيفِ أَزْوَاجًا تَقَرُّ أَعْيُنُنَا بِهِمْ ، وَتَقَرُّ أَعْيُنُهُمْ بِنَا . فَمَا مِنْ عَبْدٍ يَصُومُ رَمَضَانَ إِلَّا زُوِّجَ زَوْجَةً مِنَ  الْحُورِ  الْعِينِ  فِي خَيْمَةٍ مِنْ دُرَّةٍ مُجَوَّفَةٍ مِمَّا نَعَتَ اللهُ تَعَالَى :         {      حُورٌ مَقْصُورَاتٌ فِي الْخِيَامِ         }      عَلَى كُلِّ امْرَأَةٍ مِنْهُنَّ سَبْعُونَ  حُلَّةً  ، لَيْسَ فِيهَا  حُلَّةٌ  عَلَى لَوْنِ الْأُخْرَى ، وَيُعْطَى سَبْعِينَ لَوْنًا مِنَ الطِّيبِ ، لَيْسَ مِنْهَا لَوْنٌ عَلَى رِيحِ الْآخَرِ ، لِكُلِّ امْرَأَةٍ مِنْهُنَّ سَبْعُونَ سَرِيرًا مِنْ يَاقُوتَةٍ حَمْرَاءَ مُوَشَّحَةٍ بِالدُّرِّ ، عَلَى كُلِّ سَرِيرٍ سَبْعُونَ فِرَاشًا بَطَائِنُهَا مِنْ إِسْتَبْرَقٍ ، وَفَوْقَ السَّبْعِينَ فِرَاشًا سَبْعُونَ أَرِيكَةً ، لِكُلِّ امْرَأَةٍ أَلْفُ وَصِيفَةٍ لِحَاجَاتِهَا ، وَأَلْفُ وَصِيفٍ ، مَعَ كُلِّ وَصِيفٍ صَحْفَةٌ مِنْ ذَهَبٍ فِيهَا لَوْنُ طَعَامٍ ، يَجِدُ لِآخِرِ لُقْمَةٍ مِنْهَا لَذَّةً لَا يَجِدُ لِأَوَّلِهِ ، وَيُعْطَى زَوْجُهَا مِثْلَ ذَلِكَ عَلَى سَرِيرٍ مِنْ يَاقُوتَةٍ حَمْرَاءَ ، عَلَيْهِ سِوَارَانِ مِنْ ذَهَبٍ مُتَوَشَّحٍ بِيَاقُوتٍ أَحْمَرَ . هَذَا بِكُلِّ يَوْمٍ مِنْ رَمَضَانَ سِوَى مَا عَمِلَ مِنَ الْحَسَنَاتِ  .  قُلْتُ :  تَفَرَّدَ بِهِ  جَرِيرُ بْنُ أَيُّوبَ  ، وَهُوَ  ضَعِيفٌ جِدًّا  .  وَقَدْ أَخْرَجَهُ  ابْنُ خُزَيْمَةَ  فِي صَحِيحِهِ ، وَقَالَ : إِنْ صَحَّ الْخَبَرُ ، فَإِنَّ فِي الْقَلْبِ مِنْ  جَرِيرِ بْنِ أَيُّوبَ  ، وَكَأَنَّهُ تَسَاهَلَ فِيهِ لِكَوْنِهِ مِنَ  الرَّغَائِبِ  .         [6/43]      وَابْنُ مَسْعُودٍ لَيْسَ هُوَ الْهُذَلِيَّ الْمَشْهُورَ ، وَإِنَّمَا هُوَ آخَرُ غِفَارِيٌّ  .         [6/44]","","Al-Matalib al-Aliyah 1010","","عبد الله بن مسعود الغفاري عن نافع بن بردة عن الشعبي عن جرير بن أيوب بن أبي زرعة البجلي عن عبد الله بن رجاء البصري عن محمد بن يحيى بن أبي سمينة التمار عن أبو يعلى الموصلي","باب فضل رمضان"
"1236","[6/45]      1011  وَقَالَ الْحَارِثُ ،  حَدَّثَنَا  دَاوُدُ بْنُ الْمُحَبَّرِ ،  ثَنَا  مَيْسَرَةُ بْنُ عَبْدِ رَبِّهِ ،  عَنْ  أَبِي عَائِشَةَ ،  عَنْ  يَزِيدَ بْنِ عُمَرَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي هُرَيْرَةَ ، وَابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَا :  خَطَبَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَ الْحَدِيثَ ، وَفِيهِ :  وَمَنْ صَامَ رَمَضَانَ وَكَفَّ عَنِ الْغِيبَةِ ، وَالنَّمِيمَةِ ، وَالْكَذِبِ  ، وَالْخَوْضِ فِي الْبَاطِلِ ، وَأَمْسَكَ لِسَانَهُ إِلَّا عَنْ ذِكْرِ اللهِ تَعَالَى ، وَكَفَّ سَمْعَهُ وَبَصَرَهُ وَجَمِيعَ جَوَارِحِهِ عَنْ مَحَارِمِ اللهِ تَعَالَى ، وَعَنْ أَذَى الْمُسْلِمِينَ ، كَانَ لَهُ مِنَ الْقُرْبَى عِنْدَ اللهِ تَعَالَى أَنْ تَمَسَّ رُكْبَتُهُ رُكْبَةَ  إِبْرَاهِيمَ  الْخَلِيلِ  عَلَيْهِ الصَّلَاةُ وَالسَّلَامُ  .  هَذَا حَدِيثٌ  مَوْضُوعٌ  .","","Al-Matalib al-Aliyah 1011","","عبد الله بن عباس عن أبو سلمة بن عبد الرحمن عن يزيد بن عمر بن عبد العزيز بن مروان عن أبو عائشة عن ميسرة بن عبد ربه التراس عن داود بن المحبر البكراوي عن الحارث بن محمد بن أبي أسامة","باب فضل رمضان"
"1237","[6/46]      11 - بَابُ اشْتِرَاطِ النِّيَّةِ لِلصَّائِمِ مِنَ اللَّيْلِ  فِي الْفَرْضِ دُونَ التَّطَوُّعِ  1012  قَالَ الْحَارِثُ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ ،  ثَنَا  مُحَمَّدُ بْنُ هِلَالٍ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ سَمِعَ  مَيْمُونَةَ بِنْتَ سَعْدٍ رَضِيَ اللهُ عَنْهَا ، تَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ  أَجْمَعَ  الصَّوْمَ فِي اللَّيْلِ فَلْيَصُمْ  ، وَمَنْ أَصْبَحَ وَلَمْ يُجْمِعْهُ فَلَا يَصُمْ  .         [6/47]","","Al-Matalib al-Aliyah 1012","","ميمونة بنت سعد خادمة النبي عن هلال بن أبي هلال المذحجي عن محمد بن هلال بن أبي هلال المذحجي عن الواقدي عن الحارث بن محمد بن أبي أسامة","باب اشتراط النية للصائم من الليل في الفرض دون التطوع"
"1238","[6/48]      1013  وَقَالَ مُسَدَّدٌ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ ،  ثَنَا  لَيْثٌ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  بَعْضِ أَزْوَاجِ النَّبِيِّ ، صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَتْ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَجِيءُ فَيَدْعُو بِالطَّعَامِ فَلَا يَجِدُهُ ، فَيَفْرِضُ الصَّوْمَ  ، قَالَتْ : وَرُبَّمَا جَاءَ وَهُوَ صَائِمٌ وَعِنْدِي طُرْفَةٌ ، فَنَقُولُ : يَا رَسُولَ اللهِ ، لَوْلَا أَنَّكَ صَائِمٌ لَأَطْعَمْتُكَ ، فَيَدْعُو فَيَأْكُلُ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Matalib al-Aliyah 1013","","أحد الصحابة عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن عبد الواحد بن زياد عن مسدد بن مسرهد","باب اشتراط النية للصائم من الليل في الفرض دون التطوع"
"1239","[6/49]      1014  وَقَالَ مُسَدَّدٌ ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ،  عَنْ  أَبِي سُفْيَانَ ،  سَمِعْتُ  رَجُلًا سَأَلَ أَنَسَ بْنَ مَالِكٍ رَضِيَ اللهُ عَنْهُ قَالَ : تَسَحَّرْتُ ثُمَّ بَدَا لِي أَنْ أُفْطِرَ  ؟ قَالَ : أَفْطِرْ ، ثُمَّ قَالَ :  كَانَ أَبُو طَلْحَةَ رَضِيَ اللهُ عَنْهُ يَأْتِي أَهْلَهُ فَيَقُولُ : عِنْدَكُمْ شَيْءٌ ؟  فَإِذَا قَالُوا : لَا ، قَالَ : فَإِنِّي صَائِمٌ  .","","Al-Matalib al-Aliyah 1014","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن طلحة بن نافع العراقي عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد","باب اشتراط النية للصائم من الليل في الفرض دون التطوع"
"1240","[6/50]      1015  وَقَالَ مُسَدَّدٌ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ ،  حَدَّثَتْنِي  أُمُّ الدَّرْدَاءِ رَضِيَ اللهُ عَنْهَا ، قَالَتْ :  إِنَّ  أَبَا الدَّرْدَاءِ رَضِيَ اللهُ عَنْهُ كَانَ يَأْتِيهِمْ بَعْدَمَا يُصْبِحُ فَيَسْأَلُهُمُ  الْغَدَاءَ  فَلَا يَجِدُهُ ، فَيَقُولُ : فَأَنَا إِذًا صَائِمٌ  .  صَحِيحٌ مَوْقُوفٌ  .","","Al-Matalib al-Aliyah 1015","","أبو الدرداء عن هجيمة الأوصابية أم الدرداء الصغرى عن أبو قلابة الجرمي عن أيوب السختياني عن حماد بن زيد عن مسدد بن مسرهد","باب اشتراط النية للصائم من الليل في الفرض دون التطوع"
"1241","[6/51]      12 - بَابُ مَا يُجْتَنَبُ فِي الصِّيَامِ  1016  قَالَ الطَّيَالِسِيُّ ،  حَدَّثَنَا  شَيْخٌ مِنْ  أَهْلِ مَكَّةَ  يَعْنِي طَلْحَةَ بْنَ عَمْرٍو ،  عَنْ  عَطَاءٍ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَعِفُّوا الصِّيَامَ ، فَإِنَّ الصِّيَامَ لَيْسَ مِنَ الطَّعَامِ وَلَا مِنَ الشَّرَابِ  ، وَلَكِنَّ الصِّيَامَ مِنَ الْمَعَاصِي  .         [6/52]","","Al-Matalib al-Aliyah 1016","","أبو هريرة الدوسي عن عطاء بن أبي رباح عن طلحة بن عمرو الحضرمي عن أبو داود الطيالسي","باب ما يجتنب في الصيام"
"1242","[6/53]      1017  وَقَالَ مُسَدَّدٌ ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ الْعَبْدِيِّ ،  عَنْ  أَبِي الْمُتَوَكِّلِ ، قَالَ :  إِنَّ  أَبَا هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ كَانَ إِذَا صَامَ جَلَسَ فِي الْمَسْجِدِ  وَقَالَ : نُعِفُّ صِيَامَنَا  .","","Al-Matalib al-Aliyah 1017","","أبو هريرة الدوسي عن علي بن داود الناجي عن إسماعيل بن مسلم الكيشي عن يحيى القطان عن مسدد بن مسرهد","باب ما يجتنب في الصيام"
"1243","[6/54]      1018  وَقَالَ مُسَدَّدٌ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ، قَالَ : كَانَ أَصْحَابُنَا يَقُولُونَ :  أَهْوَنُ الصِّيَامِ تَرْكُ الطَّعَامِ وَالشَّرَابِ  .","","Al-Matalib al-Aliyah 1018","","أصحاب عطاء بن السائب عن عطاء بن السائب عن حماد بن زيد عن مسدد بن مسرهد","باب ما يجتنب في الصيام"
"1244","[6/55]      1019  قَالَ :  وَحَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنِ  الْحَسَنِ ، قَالَ :  إِذَا ذَرَعَهُ الْقَيْءُ لَمْ يُفْطِرْ  ، وَإِذَا  تَقَيَّأَ  أَفْطَرَ  .","","Al-Matalib al-Aliyah 1019","","الحسن البصري عن عبد الله بن عون بن أرطبان عن يزيد بن زريع العيشي عن مسدد بن مسرهد","باب ما يجتنب في الصيام"
"1245","[6/56]      13 - بَابُ مَنْ قَالَ : لَا يُفَطِّرُ إِلَّا الطَّعَامُ وَالشَّرَابُ  1020  / 1  -  قَالَ أَبُو يَعْلَى ،  حَدَّثَنَا  الْحَسَنُ بْنُ أَبِي الرَّبِيعِ ،  ثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  مَطَرَتِ السَّمَاءُ بَرَدًا ، فَقَالَ لَنَا  أَبُو طَلْحَةَ  رَضِيَ اللهُ عَنْهُ وَنَحْنُ غِلْمَانٌ : نَاوِلْنِي يَا  أَنَسُ  مِنْ ذَلِكَ الْبَرَدِ ، فَنَاوَلْتُهُ ، فَجَعَلَ يَأْكُلُ وَهُوَ صَائِمٌ ، فَقُلْتُ : أَلَسْتَ صَائِمًا ؟ قَالَ : بَلَى ، إِنَّ ذَا لَيْسَ بِطَعَامٍ وَلَا شَرَابٍ ، وَإِنَّمَا هُوَ بَرَكَةٌ مِنَ السَّمَاءِ ، نُطَهِّرُ بِهِ بُطُونَنَا . قَالَ  أَنَسٌ  رَضِيَ اللهُ عَنْهُ : فَأَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرْتُهُ ، فَقَالَ :  خُذْ عَنْ عَمِّكَ  .  هَذَا  إِسْنَادٌ  ضَعِيفٌ  .","","Al-Matalib al-Aliyah 1020","","أنس بن مالك عن علي بن زيد بن جدعان عن عبد الوارث بن سعيد بن ذكوان عن عبد الصمد بن عبد الوارث التنوري عن الحسن بن يحيى بن الجعد الجرجاني عن أبو يعلى الموصلي","باب من قال لا يفطر إلا الطعام والشراب"
"1246","1020  / 2  - قَالَ :  وَحَدَّثَنَا  عَبْدُ الْوَارِثِ بْنُ عَبْدِ الصَّمَدِ بْنِ عَبْدِ الْوَارِثِ ،  ثَنَا  أَبِي  بِهِ .","","Al-Matalib al-Aliyah 1020","","أنس بن مالك عن علي بن زيد بن جدعان عن عبد الصمد بن عبد الوارث التنوري عن عبد الوارث بن عبد الصمد التنوري عن أبو يعلى الموصلي","باب من قال لا يفطر إلا الطعام والشراب"
"1247","1020  / 3  - وَقَالَ الْبَزَّارُ :  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ، فَذَكَرَهُ .         [6/57]             [6/58]","","Al-Matalib al-Aliyah 1020","","أنس بن مالك عن علي بن زيد بن جدعان عن عبد الصمد بن عبد الوارث التنوري عن محمد بن معمر بن ربعي البحراني عن البزار","باب من قال لا يفطر إلا الطعام والشراب"
"1248","1020  / 4  - أَخْرَجَهُ الْبَزَّارُ  عَنْ  هِلَالِ بْنِ يَحْيَى ،  عَنْ  أَبِي عَوَانَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  رَأَيْتُ  أَبَا طَلْحَةَ رَضِيَ اللهُ عَنْهُ ، فَذَكَرَهُ  مَوْقُوفًا  .","","Al-Matalib al-Aliyah 1020","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن الوضاح بن عبد الله اليشكري عن هلال بن يحيى المعروف بهلال الرأي عن البزار","باب من قال لا يفطر إلا الطعام والشراب"
"1249","[6/59]      14 - بَابُ السُّنَّةِ فِي الْفِطْرِ  عَلَى التَّمْرِ ، أَوِ الرُّطَبِ ، أَوْ مَا لَمْ تَمَسَّهُ النَّارُ .  1021  قَالَ الْحَارِثُ ،  حَدَّثَنَا  رَوْحٌ ،  ثَنَا  ابْنُ جَرِيحٍ ،  حُدِّثْتُ عَنْ  أَنَسِ بْنِ مَالِكٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَصُومُ فِي الصَّيْفِ  ، لَا يُصَلِّي فِي الصَّيْفِ الْمَغْرِبَ إِذَا كَانَ صَائِمًا حَتَّى آتِيَهُ بِرُطَبٍ فَيَأْكُلَ وَيَشْرَبَ ، ثُمَّ يَقُومَ فَيُصَلِّيَ ، وَإِذَا كَانَ الشِّتَاءُ أَتَيْتُهُ بِتَمْرٍ فَيَأْكُلُ وَيَشْرَبُ ، ثُمَّ يَقُومُ يُصَلِّي  .  فِيهِ  انْقِطَاعٌ  .         [6/60]             [6/61]","","Al-Matalib al-Aliyah 1021","","أنس بن مالك عن ابن جريج عن روح بن عبادة القيسي عن الحارث بن محمد بن أبي أسامة","باب السنة في الفطرعلى التمر أو الرطب أو ما لم تمسه النار"
"1250","[6/62]      1022  وَقَالَ أَبُو يَعْلَى ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  ثَنَا  عَبْدُ الْوَاحِدِ ،  حَدَّثَنَا  ثَابِتٌ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُحِبُّ أَنْ يُفْطِرَ عَلَى ثَلَاثِ تَمَرَاتٍ  ، أَوْ شَيْءٍ لَمْ تُصِبْهُ النَّارُ  .","","Al-Matalib al-Aliyah 1022","","أنس بن مالك عن ثابت البناني عن عبد الواحد بن ثابت الباهلي عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","باب السنة في الفطرعلى التمر أو الرطب أو ما لم تمسه النار"
"1251","[6/63]      1023  وَقَالَ عَبْدُ بْنُ حُمَيْدٍ ،  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ عَمْرٍو هُوَ أَبُو عَامِرٍ الْعَقَدِيُّ ،  ثَنَا  زَمْعَةُ بْنُ صَالِحٍ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  بَعْضِ أَهْلِ جَابِرٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا كَانَ الرُّطَبُ لَمْ يُفْطِرْ إِلَّا عَلَى الرُّطَبِ  ، وَإِذَا لَمْ يَكُنِ الرُّطَبُ لَمْ يُفْطِرْ إِلَّا عَلَى التَّمْرِ  .","","Al-Matalib al-Aliyah 1023","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن بعض أهل جابر عن محمد بن أبي سليمان الأنصاري عن زمعة بن صالح الجندي عن أبو عامر العقدي عن عبد بن حميد","باب السنة في الفطرعلى التمر أو الرطب أو ما لم تمسه النار"
"1252","[6/64]      15 - بَابٌ مِنْهُ وَفِيهِ السُّنَّةُ فِي تَعْجِيلِ الْفِطْرِ وَالنَّهْيِ عَنِ  الْوِصَالِ  1024  قَالَ أَبُو يَعْلَى ،  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  طَيِّبُ بْنُ سُلَيْمَانَ  ، قَالَ :  سَمِعْتُ  عَمْرَةَ ، قَالَ :  سَمِعْتُ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، تَقُولُ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَنْهَى عَنِ  الْوِصَالِ  ، وَيَأْمُرُ بِتَبْكِيرِ الْإِفْطَارِ ، وَتَأْخِيرِ السَّحُورِ  .         [6/65]             [6/66]             [6/67]      كذا في طبعة دار العاصمة ، والصواب : ( طيب بن سلمان )","","Al-Matalib al-Aliyah 1024","","عائشة بنت أبي بكر الصديق عن عمرة عمة مقاتل بن حيان عن الطيب بن سلمان عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","باب منه وفيه السنة في تعجيل الفطر والنهي عن الوصال"
"1253","[6/68]      1025  وَقَالَ أَيْضًا :  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ ،  ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  ثَنَا  حُبَابَةُ بِنْتُ عَجْلَانَ ،  عَنْ  أُمِّهَا أُمِّ حَفْصٍ  ،  عَنْ  صَفِيَّةَ بِنْتِ جَرِيرٍ ،  عَنْ  أُمِّ حَكِيمٍ بِنْتِ وَدَاعٍ قَالَتْ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  عَجِّلُوا الْإِفْطَارَ  ، وَأَخِّرُوا السُّحُورَ  .","","Al-Matalib al-Aliyah 1025","","أم حكيم بنت وداع الخزاعية عن صفية بنت جرير عن حفصة أم حبابة بنت عجلان عن حبابة بنت عجلان البصرية عن موسى بن إسماعيل التبوذكي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","باب منه وفيه السنة في تعجيل الفطر والنهي عن الوصال"
"1254","[6/69]      1026  / 1  -  وَقَالَ الطَّيَالِسِيُّ ،  حَدَّثَنَا  خَارِجَةُ بْنُ مُصْعَبٍ ،  عَنْ  حَرَامِ بْنِ عُثْمَانَ ،  عَنْ  أَبِي عَتِيقٍ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ قَالَ : إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا  وِصَالَ  فِي الصَّوْمِ  .         [6/70]","","Al-Matalib al-Aliyah 1026","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن جابر السلمي عن حرام بن عثمان الأنصاري عن خارجة الضبعي عن أبو داود الطيالسي","باب منه وفيه السنة في تعجيل الفطر والنهي عن الوصال"
"1255","1026  / 2  - قَالَ :  وَحَدَّثَنَا  الْيَمَانُ أَبُو حُذَيْفَةَ ،  عَنْ  أَبِي عَتِيقٍ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ، بِهِ .","","Al-Matalib al-Aliyah 1026","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن جابر السلمي عن يمان بن المغيرة العنبري عن أبو داود الطيالسي","باب منه وفيه السنة في تعجيل الفطر والنهي عن الوصال"
"1256","[6/71]      1027  وَقَالَ الْحَارِثُ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ ،  ثَنَا  سَعِيدُ بْنُ مُسْلِمِ بْنِ بَابَكَ  ،  عَنِ  ابْنِ عَقِيلٍ ،  أَنَّهُ سَمِعَ  جَابِرَ بْنَ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُمَا ، يَقُولُ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُوَاصِلُ  .  كذا في طبعة دار العاصمة ، ولعل الصواب : ( بانك )","","Al-Matalib al-Aliyah 1027","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن سعيد بن مسلم بن بانك المدني عن الواقدي عن الحارث بن محمد بن أبي أسامة","باب منه وفيه السنة في تعجيل الفطر والنهي عن الوصال"
"1257","[6/72]      1028  / 1  -  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ أَبِي إِسْمَاعِيلَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ [أَبِي] عَيَّاشٍ  ،  عَنْ  حَرَامِ بْنِ عُثْمَانَ ،  عَنْ  أَبِي عَتِيقٍ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا صَمْتَ يَوْمٍ إِلَى اللَّيْلِ ، وَلَا  وِصَالَ  فِي الصِّيَامِ  ، وَلَا  تَعَرُّبَ  بَعْدَ الْهِجْرَةِ ، وَلَا  هِجْرَةَ  بَعْدَ الْفَتْحِ ... الْحَدِيثَ  . [2] وَرَوَاهُ  أَبُو قُرَّةَ  ، عَنِ  ابْنِ جُرَيْجٍ  ، قَالَ : أُخْبِرْتُ عَنْ  حَرَامِ بْنِ عُثْمَانَ  ، بِهِ .  كذا في طبعة دار العاصمة ، ولعل الصواب : ( إسماعيل بن عياش )","","Al-Matalib al-Aliyah 1028","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن جابر السلمي عن حرام بن عثمان الأنصاري عن إسماعيل بن عياش الأحول عن إسماعيل بن أبي إسماعيل المؤدب عن الحارث بن محمد بن أبي أسامة","باب منه وفيه السنة في تعجيل الفطر والنهي عن الوصال"
"1258","[6/73]      1029  / 1  -  وَقَالَ الطَّيَالِسِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  بِشْرٍ هُوَ ابْنُ حَرْبٍ ،  عَنْ  أَبِي سَعِيدٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْوِصَالِ  ، وَإِنَّ أُخْتِي هَذِهِ تُوَاصِلُ ، وَأَنَا أَنْهَاهَا  .","","Al-Matalib al-Aliyah 1029","","أبو سعيد الخدري عن بشر بن حرب عن حماد بن سلمة عن أبو داود الطيالسي","باب منه وفيه السنة في تعجيل الفطر والنهي عن الوصال"
"1259","1029  / 2  - وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  أَبُو نَصْرٍ هُوَ التَّمَّارُ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ، بِهِ .","","Al-Matalib al-Aliyah 1029","","أبو سعيد الخدري عن بشر بن حرب عن حماد بن سلمة عن عبد الملك بن عبد العزيز القشيري عن أحمد بن منيع البغوي","باب منه وفيه السنة في تعجيل الفطر والنهي عن الوصال"
"1260","[6/74]      16 - بَابُ الرُّخْصَةِ فِي قَضَاءِ رَمَضَانَ عَلَى التَّرَاخِي  1030  قَالَ مُسَدَّدٌ ،  حَدَّثَنَا  سَلَّامُ بْنُ أَبِي مُطِيعٍ ،  عَنِ  الْأَسْوَدِ بْنِ قَيْسٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  إِنَّ  رَجُلًا سَأَلَ عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ ، عَنْ قَضَاءِ رَمَضَانَ فِي عَشْرِ ذِي الْحِجَّةِ  ، قَالَ : فَمَا أَدْرِي مَا كَانَتِ الْمُرَاجَعَةُ فِيمَا بَيْنَهُمَا ، فَأَمَرَهُ بِقَضَاءِ رَمَضَانَ فِي عَشْرِ ذِي الْحِجَّةِ ، قَالَ : وَلَا تَقُلْ إِنَّ أَبَاكَ سَمِعَ ذَلِكَ مِنْ  عُمَرَ  رَضِيَ اللهُ عَنْهُ  .         [6/75]","","Al-Matalib al-Aliyah 1030","","عمر بن الخطاب عن قيس العبدي عن الأسود بن قيس العبدي عن سلام بن أبي مطيع الخزاعي عن مسدد بن مسرهد","باب الرخصة في قضاء رمضان على التراخي"
"1261","[6/76]      1031  / 1  -  وَقَالَ مُسَدَّدٌ أَيْضًا :  حَدَّثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ،  عَنْ  رَجُلٍ مِنْ وَلَدِ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  جَدَّتِهِ  ، قَالَتْ :  إِنَّ  رَافِعَ بْنَ خَدِيجٍ رَضِيَ اللهُ عَنْهُ أَمَرَهَا أَنْ تَقْضِيَ رَمَضَانَ مُفَرَّقًا  .","","Al-Matalib al-Aliyah 1031","","رافع بن خديج الأنصاري عن أم عبد الحميد بن رافع بن خديج عن عبد الحميد بن رافع بن خديج الحجازي عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد","باب الرخصة في قضاء رمضان على التراخي"
"1262","1031  / 2  -  وَقَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  ابْنُ إِدْرِيسَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ الْمَجِيدِ بْنِ رَافِعٍ ،  عَنْ  جَدَّتِهِ  ، قَالَتْ :  إِنَّ  رَافِعَ بْنَ خَدِيجٍ رَضِيَ اللهُ عَنْهُ كَانَ يَقُولُ :  أَحْصُوا الْعِدَّةَ وَصُمْ كَيْفَ شِئْتَ  .         [6/77]","","Al-Matalib al-Aliyah 1031","","رافع بن خديج الأنصاري عن أم عبد الحميد بن رافع بن خديج عن عبد الحميد بن رافع بن خديج الحجازي عن شعبة بن الحجاج عن عبد الله بن إدريس الأودي عن أبو بكر ابن أبي شيبة","باب الرخصة في قضاء رمضان على التراخي"
"1263","17 - بَابُ الْكُحْلِ لَا يُفْطِرُ الصَّائِمَ  1032  - قَالَ الْحَارِثُ ،  حَدَّثَنَا  يَحْيَى بْنُ إِسْحَاقَ ،  ثَنَا  سَعِيدُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ خَالِدٍ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ .","","Al-Matalib al-Aliyah 1032","","علي بن أبي طالب عن الحسين بن علي عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن عمرو بن خالد القرشي عن سعيد بن زيد الجهضمي عن يحيى بن إسحاق السيلحيني عن الحارث بن محمد بن أبي أسامة","باب الكحل لا يفطر الصائم"
"1264","1033  وَعَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، رَضِيَ اللهُ عَنْهُ قَالَ :  انْتَظَرْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَخْرُجَ إِلَيْنَا فِي رَمَضَانَ  ، فَخَرَجَ مِنْ بَيْتِ  أُمِّ سَلَمَةَ  رَضِيَ اللهُ عَنْهَا وَقَدْ كَحَّلَتْهُ وَمَلَأَتْ عَيْنَيْهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كُحْلًا  .         [6/78]","","Al-Matalib al-Aliyah 1033","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن حبيب بن أبي ثابت الكاهلي عن عمرو بن خالد القرشي عن سعيد بن زيد الجهضمي عن يحيى بن إسحاق السيلحيني عن الحارث بن محمد بن أبي أسامة","باب الكحل لا يفطر الصائم"
"1265","[6/80]      19 - بَابُ مَا يُصْنَعُ مِنْ جَامِعٍ أَوْ أَفْطَرَ عَامِدًا  1034  قَالَ مُسَدَّدٌ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ السَّرَّاجِ ،  عَنْ  عَطَاءٍ ، وَعَمْرِو بْنِ شُعَيْبٍ ، قَالَا :  إِنَّ  رَجُلًا  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ،  هَلَكْتُ  ، قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : وَمَا أَهْلَكَكَ ؟ قَالَ : وَقَعْتُ عَلَى امْرَأَتِي فِي رَمَضَانَ ، قَالَ : وَأُتِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِحِمَارٍ عَلَيْهِ تَمْرٌ ، فَأَمَرَ لَهُ بِبَعْضِهِ ، فَقَالَ : خُذْ هَذَا ، فَتَصَدَّقْ بِهِ . قَالَ : يَا رَسُولَ اللهِ ، مَا بَيْنَ  لَابَتَيْهَا  أَهْلُ بَيْتٍ أَفْقَرَ مِنِّي . قَالَ : فَضَحِكَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى بَدَتْ  نَوَاجِذُهُ  ، ثُمَّ قَالَ :  أَطْعِمْهُ أَهْلَكَ ، وَيَوْمٌ مَكَانَ يَوْمٍ ، وَاسْتَغْفِرِ اللهَ تَعَالَى  . قَالَ :  فَلَا أَدْرِي فِي حَدِيثِهِمَا ، أَوْ حَدِيثِ أَحَدِهِمَا : يَوْمٌ مَكَانَ يَوْمٍ ، وَاسْتَغْفِرِ اللهَ تَعَالَى  .         [6/81]","","Al-Matalib al-Aliyah 1034","","عمرو بن شعيب عن عبد الرحمن بن عبد الله السراج عن حماد بن زيد عن مسدد بن مسرهد","باب باب ما يصنع من جامع أو أفطر عامدا"
"1266","[6/82]      1035  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ عَجْلَانَ ،  عَنِ  الْمُطَّلِبِ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ قَالَ :  إِنَّ  رَجُلًا  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : إِنِّي أَفْطَرْتُ يَوْمًا فِي رَمَضَانَ . قَالَ :  تَصَدَّقْ  لِمَا صَنَعْتَ ، وَصُمْ يَوْمًا مَكَانَهُ  ، وَاسْتَغْفِرِ اللهَ تَعَالَى  .         [6/83]","","Al-Matalib al-Aliyah 1035","","سعيد بن المسيب عن المطلب بن أبي وداعة الجمحي عن محمد بن عجلان عن يحيى القطان عن مسدد بن مسرهد","باب باب ما يصنع من جامع أو أفطر عامدا"
"1267","[6/84]      1036  وَقَالَ أَبُو يَعْلَى ،  حَدَّثَنَا  سَهْلُ بْنُ زَنْجَلَةَ الرَّازِيُّ ،  ثَنَا  الصَّبَّاحُ بْنُ مُحَارِبٍ ،  عَنْ  هَارُونَ بْنِ عَنْتَرَةَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : إِنِّي أَفْطَرْتُ يَوْمًا فِي رَمَضَانَ  . قَالَ : مِنْ غَيْرِ عُذْرٍ ، وَلَا سَفَرٍ ؟ قَالَ : نَعَمْ ، قَالَ : بِئْسَ مَا صَنَعْتَ . قَالَ : فَمَا تَأْمُرُنِي ؟ قَالَ : أَعْتِقْ  رَقَبَةً  . قَالَ : وَالَّذِي بَعَثَكَ بِالْحَقِّ ، مَا مَلَكْتُ رَقَبَةً قَطُّ ، قَالَ : فَصُمْ شَهْرَيْنِ مُتَتَابِعَيْنِ . قَالَ : لَا أَسْتَطِيعُ ذَلِكَ ، قَالَ : فَأَطْعِمْ سِتِّينَ مِسْكِينًا . قَالَ : وَالَّذِي بَعَثَكَ بِالْحَقِّ ، مَا أُشْبِعُ أَهْلِي ، قَالَ : فَأُتِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِمِكْتَلٍ  فِيهِ تَمْرٌ ، فَقَالَ :  تَصَدَّقْ  بِهَذَا عَلَى سِتِّينَ مِسْكِينًا . قَالَ : إِلَى مَنْ أَدْفَعُهُ ؟ قَالَ : إِلَى أَفْقَرِ مَنْ تَعْلَمُ . قَالَ : وَالَّذِي بَعَثَكَ بِالْحَقِّ ، مَا بَيْنَ  حَرَّتَيْهَا  أَهْلُ بَيْتٍ أَحْوَجَ مِنَّا ، فَقَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَصَدَّقْ  بِهِ عَلَى عِيَالِكَ  .         [6/85]","","Al-Matalib al-Aliyah 1036","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن هارون بن عنترة الشيباني عن صباح بن محارب التيمي عن سهل بن أبي سهل الأشتر عن أبو يعلى الموصلي","باب باب ما يصنع من جامع أو أفطر عامدا"
"1268","[6/86]      20 - بَابُ الرُّخْصَةِ فِي الْفِطْرِ فِي السَّفَرِ وَصِحَّةِ صَوْمِ مَنْ صَامَ فِيهِ  1037  / 1  -  قَالَ أَبُو يَعْلَى :  حَدَّثَنَا  إِسْحَاقُ بْنُ إِسْمَاعِيلَ الطَّالْقَانِيُّ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  سَافَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي رَمَضَانَ ، فَصَامَ وَأَفْطَرَ  .","","Al-Matalib al-Aliyah 1037","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن مسلم بن كيسان البراد عن جرير بن عبد الحميد عن إسحاق بن إسماعيل الطالقاني عن أبو يعلى الموصلي","باب الرخصة في الفطر في السفر وصحة صوم من صام فيه"
"1269","1037  / 2  - قَالَ :  وَحَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  مُسْلِمٍ أَبِي عَبْدِ اللهِ ،  عَنْ  مُجَاهِدٍ ، بِهِ .         [6/87]","","Al-Matalib al-Aliyah 1037","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن مسلم بن عمران البطين عن سلام بن سليم الحنفي عن خلف بن هشام البزار عن أبو يعلى الموصلي","باب الرخصة في الفطر في السفر وصحة صوم من صام فيه"
"1270","[6/88]      1038  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  حَدَّثَنِي  أَبُو سَعِيدٍ مَوْلَى الْمَهْرِيِّ قَالَ :  أَقْبَلْتُ مَعَ صَاحِبٍ لِي مِنَ الْعُمُرَةِ ، فَوَافَيْنَا الْهِلَالَ هِلَالَ رَمَضَانَ ، فَنَزَلْنَا فِي أَرْضِ أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ فِي يَوْمٍ شَدِيدِ الْحَرِّ  ، فَأَصْبَحْنَا مُفْطِرِينَ إِلَّا رَجُلًا مِنَّا وَاحِدًا ، فَدَخَلَ عَلَيْنَا  أَبُو هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ نِصْفَ النَّهَارِ فَوَجَدَ صَاحِبَنَا يَلْتَمِسُ بَرْدَ النَّخْلِ ،  فَقَالَ  : مَا بَالُ صَاحِبِكُمْ ؟ قَالُوا : صَائِمٌ ، قَالَ : مَا حَمَلَهُ عَلَى أَنْ لَا يُفْطِرَ ؟ قَدْ رَخَّصَ اللهُ لَهُ ، لَوْ مَاتَ مَا صَلَّيْتُ عَلَيْهِ  .  مَوْقُوفٌ  صَحِيحٌ  .","","Al-Matalib al-Aliyah 1038","","أبو هريرة الدوسي عن أبو سعيد المهري عن محمد بن عجلان عن يحيى القطان عن مسدد بن مسرهد","باب الرخصة في الفطر في السفر وصحة صوم من صام فيه"
"1271","[6/89]      1039  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ ،  حَدَّثَنَا  رَوْحٌ ،  ثَنَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  الْإِفْطَارُ فِي السَّفَرِ  عَزْمَةٌ  .  مَوْقُوفٌ  صَحِيحٌ  .","","Al-Matalib al-Aliyah 1039","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن روح بن عبادة القيسي عن أحمد بن منيع البغوي","باب الرخصة في الفطر في السفر وصحة صوم من صام فيه"
"1272","[6/90]      1040  وَقَالَ أَبُو دَاوُدَ الطَّيَالِسِيُّ :  حَدَّثَنَا  سُلَيْمَانُ هُوَ ابْنُ مُعَاذٍ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ : إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَصُومُ فِي السَّفَرِ وَيُفْطِرُ  .         [6/91]","","Al-Matalib al-Aliyah 1040","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن سليمان بن قرم الضبي عن أبو داود الطيالسي","باب الرخصة في الفطر في السفر وصحة صوم من صام فيه"
"1273","[6/92]      1041  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  الْمُعْتَمِرُ ،  حَدَّثَنِي  الْحَكَمُ بْنُ أَبَانَ ،  عَنِ  الْغِطْرِيفِ أَبِي هَارُونَ ، قَالَ :  بَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَجُلَيْنِ فِي حَاجَةٍ فِي رَمَضَانَ ، فَتَقَدَّمَ إِلَى أَحَدِهِمَا أَنْ لَا يَصُومَ ، وَسَكَتَ عَنِ الْآخَرِ فَصَامَ ، فَلَمَّا قَدِمَا قَالَ : مَا صَنَعْتُمَا ؟ قَالَ أَحَدُهُمَا : صُمْتُ ، وَقَالَ الْآخَرُ : لَمْ أَصُمْ ، قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كِلَاكُمَا قَدْ أَصَابَ  .  إِسْنَادٌ حَسَنٌ  مَعَ  إِرْسَالِهِ  .         [6/93]","","Al-Matalib al-Aliyah 1041","","غطريف اليماني عن الحكم بن أبان العدني عن معتمر بن سليمان عن مسدد بن مسرهد","باب الرخصة في الفطر في السفر وصحة صوم من صام فيه"
"1274","[6/94]      1042  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ،  عَنْ  مُوسَى ،  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ رَضِيَ اللهُ عَنْهُ ، يَقُولُ :  حَاصَرْنَا  تُسْتَرَ  وَعَلَيْنَا أَبُو مُوسَى رَضِيَ اللهُ عَنْهُ ، فَصَامَ وَصُمْنَا  .","","Al-Matalib al-Aliyah 1042","","أبو موسى الأشعري عن أنس بن مالك عن موسى بن أنس بن مالك الأنصاري عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد","باب الرخصة في الفطر في السفر وصحة صوم من صام فيه"
"1275","[6/95]      1043  قَالَ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  عَنْ  عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ جَاءَ إِلَى قَوْمٍ مُحَاصِرِي حِصْنٍ فَأَمَرَهُمْ أَنْ يُفْطِرُوا  .","","Al-Matalib al-Aliyah 1043","","عمر بن الخطاب عن سعيد بن جبير الأسدي عن عبد الكريم الاصطخري عن سفيان الثوري عن يحيى القطان عن مسدد بن مسرهد","باب الرخصة في الفطر في السفر وصحة صوم من صام فيه"
"1276","[6/96]      1044  قَالَ :  وَحَدَّثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ فَتْحِ مَكَّةَ  :  أَفْطِرُوا ; فَإِنَّهُ يَوْمُ قِتَالٍ  .         [6/97]             [6/98]","","Al-Matalib al-Aliyah 1044","","عبيد بن عمير بن قتادة الجندعي عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد","باب الرخصة في الفطر في السفر وصحة صوم من صام فيه"
"1277","[6/99]      1045  قَالَ :  وَحَدَّثَنَا  يَحْيَى ،  عَنْ  عَمْرِو بْنِ الْحَجَّاجِ  ،  عَنْ  نَافِعٍ ، قَالَ :  خَرَجَ ابْنُ عُمَرَ رَضِيَ اللهُ عَنْهُمَا مُبَادِرًا لِلْفِتْنَةِ أَنْ تَقَعَ فِي  الْمَدِينَةِ  فِي رَمَضَانَ ، فَأَفْطَرَ  ، فَلَمَّا كَانَتِ اللَّيْلَةُ الَّتِي يَدْخُلُ فِيهَا ، يَعْنِي  مَكَّةَ  ، أَصْبَحَ صَائِمًا  .  كذا في طبعة دار العاصمة وهو تصحيف ، وصوابه : (ابن أبي الحجاج) .","","Al-Matalib al-Aliyah 1045","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عمرو بن أبي الحجاج المنقري عن يحيى القطان عن مسدد بن مسرهد","باب الرخصة في الفطر في السفر وصحة صوم من صام فيه"
"1278","[6/100]      21 - بَابُ الرُّخْصَةِ فِي الْفِطْرِ  لِلشَّيْخِ الْكَبِيرِ وَالْحَامِلِ وَالْمُرْضِعِ  1046  قَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  عِمْرَانُ ،  عَنْ  أَيُّوبَ بْنِ أَبِي تَمِيمَةَ ، قَالَ :  ضَعُفَ أَنَسٌ عَنِ الصَّوْمِ رَضِيَ اللهُ عَنْهُ فَصَنَعَ جَفْنَةً مِنْ ثَرِيدٍ  ، فَدَعَا ثَلَاثِينَ مِسْكِينًا فَأَطْعَمَهُمْ  .         [6/101]","","Al-Matalib al-Aliyah 1046","","أنس بن مالك عن أيوب السختياني عن عمران بن حدير عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن أبو يعلى الموصلي","باب الرخصة في الفطر للشيخ الكبير والحامل والمرضع"
"1279","[6/102]      1047  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَزْرَةَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  الْحَامِلُ وَالْمُرْضِعُ إِذَا خَافَتَا أَفْطَرَتَا وَأَطْعَمَتَا  ، وَلَا قَضَاءَ عَلَيْهِمَا  .  إِسْنَادُهُ حَسَنٌ  .  وَقَدْ أَخْرَجَهُ  أَبُو دَاوُدَ  مِنْ هَذَا الْوَجْهِ دُونَ قَوْلِهِ : وَلَا قَضَاءَ عَلَيْهِمَا  .","","Al-Matalib al-Aliyah 1047","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن عزرة بن عبد الرحمن بن زرارة عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يحيى القطان عن مسدد بن مسرهد","باب الرخصة في الفطر للشيخ الكبير والحامل والمرضع"
"1280","[6/103]      22 - بَابُ  الزَّجْرِ  عَنْ صَوْمِ الدَّهْرِ  وَتَخْصِيصِ يَوْمٍ أَوْ شَهْرٍ بِعَيْنِهِ  1048  قَالَ إِسْحَاقُ :  أَخْبَرَنَا  يَحْيَى بْنُ آدَمَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  أُمِّهِ  رَضِيَ اللهُ عَنْهَا ، قَالَتْ :  مَا رَأَيْتُ عَبْدَ اللهِ صَائِمًا إِلَّا شَهْرَ رَمَضَانَ ، وَيَوْمَيْنِ  .  هَذَا  إِسْنَادٌ صَحِيحٌ  .         [6/104]","","Al-Matalib al-Aliyah 1048","","عبد الله بن مسعود عن زينب بنت معاوية رائطة عن أبو عبيدة بن عبد الله بن مسعود عن عبد الكريم الاصطخري عن سفيان الثوري عن يحيى بن آدم عن إسحاق ابن راهويه","باب الزجر عن صوم الدهر وتخصيص يوم أو شهر بعينه"
"1281","[6/105]      1049  / 1  -  وَقَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ :  حَدَّثَنَا  أَبُو دَاوُدَ ،  عَنْ  عِيسَى بْنِ مَيْمُونٍ ، قَالَ :  سَأَلْتُ  عَطَاءً عَنْ رَجُلٍ  يَتَحَرَّى  يَوْمًا يَصُومُهُ ، فَقَالَ :  كَانَ ابْنُ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا يَكْرَهُ أَنْ  يَتَحَرَّى  شَهْرًا ، أَوْ يَوْمًا يَصُومُهُ  ،  وَيَقُولُ  : قَالَ رَسُولُ اللهِ :  مَنْ صَامَ الْأَبَدَ فَلَا صَامَ  .","","Al-Matalib al-Aliyah 1049","","عبد الله بن عباس عن عطاء بن أبي رباح عن عبيس بن ميمون التيمي عن أبو داود الطيالسي عن أبو بكر ابن أبي شيبة","باب الزجر عن صوم الدهر وتخصيص يوم أو شهر بعينه"
"1282","[6/106]      1049  / 2  -  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  أَسْبَاطُ بْنُ مُحَمَّدٍ ،  ثَنَا  هِشَامٌ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا  أَنَّهُ كَانَ يَكْرَهُ أَنْ يُوَقِّتَ يَوْمًا يَصُومُهُ  .         [6/107]","","Al-Matalib al-Aliyah 1049","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن هشام بن حسان العتكي عن أسباط بن محمد بن ميسرة القرشي عن أحمد بن منيع البغوي","باب الزجر عن صوم الدهر وتخصيص يوم أو شهر بعينه"
"1283","1049  / 3  -  حَدَّثَنَا  يَزِيدُ ،  أَنَا  هِشَامٌ نَحْوَهُ ، وَزَادَ :  وَكَانَ يَكْرَهُ صَوْمَ الِاثْنَيْنِ وَالْخَمِيسِ  .","","Al-Matalib al-Aliyah 1049","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن هشام بن حسان العتكي عن يزيد بن هارون عن أحمد بن منيع البغوي","باب الزجر عن صوم الدهر وتخصيص يوم أو شهر بعينه"
"1284","[6/108]      1050  وَقَالَ مُسَدَّدٌ :  ثَنَا  بِشْرٌ هُوَ ابْنُ الْمُفَضَّلِ ،  عَنْ  سَلَمَةَ ،  عَنِ  الْوَلِيدِ أَبِي بِشْرٍ ،  عَنْ  حُصَيْنِ بْنِ أَبِي الْحُرِّ ، قَالَ :  دَخَلْتُ عَلَى الْأَشْعَرِيِّ رَضِيَ اللهُ عَنْهُ يَوْمَ الْجُمُعَةِ وَهُوَ يَتَغَدَّى ، فَدَعَانِي ، فَقُلْتُ : إِنِّي صَائِمٌ ،  فَقَالَ  :  لَا تَصُومَنَّ يَوْمًا تَجْعَلُ صَوْمَهُ عَلَيْكَ  حَتْمًا  .","","Al-Matalib al-Aliyah 1050","","أبو موسى الأشعري عن حصين بن أبي الحر العنبري عن الوليد بن مسلم العنبري عن سلمة بن علقمة التميمي عن بشر بن المفضل عن مسدد بن مسرهد","باب الزجر عن صوم الدهر وتخصيص يوم أو شهر بعينه"
"1285","[6/109]      1051  حَدَّثَنَا عَبْدُ الْوَارِثِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، قَالَ :  نَهَانِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ أَخْتَصَّ يَوْمَ الْجُمُعَةِ بِصَوْمٍ  ، وَأَنْ أَحْتَجِمَ وَأَنَا صَائِمٌ . الْحَدِيثَ  .","","Al-Matalib al-Aliyah 1051","","علي بن أبي طالب عن الحارث الأعور عن أبو إسحاق السبيعي عن محمد بن إسحاق عن عبد الوارث بن عبد الصمد التنوري عن مسدد بن مسرهد","باب الزجر عن صوم الدهر وتخصيص يوم أو شهر بعينه"
"1286","[6/110]      23 - بَابُ السَّحُورِ  1052  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  أَخِيهِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَسَحَّرُوا ; فَإِنَّ فِي السَّحُورِ بَرَكَةً  .","","Al-Matalib al-Aliyah 1052","","أبو ليلى الأيسر الأنصاري عن عيسى بن عبد الرحمن بن أبي ليلى عن محمد بن عبد الرحمن بن أبي ليلى عن يحيى القطان عن مسدد بن مسرهد","باب السحور"
"1287","[6/111]      1053  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَحْيَى ،  عَنْ  عُلَيِّ بْنِ رَبَاحٍ ،  عَنْ  أَبِي قَيْسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَسَحَّرُوا ، وَلَوْ بِرَمْلَةٍ مِنْ تُرَابٍ  .","","Al-Matalib al-Aliyah 1053","","عبد الرحمن بن ثابت السهمي عن علي بن رباح اللخمي عن يحيى بن عبد الرحمن الكناني عن هشيم بن بشير عن مسدد بن مسرهد","باب السحور"
"1288","[6/112]      1054  قَالَ :  وَحَدَّثَنَا  عِيسَى بْنُ يُونُسَ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَبْدِ اللهِ ،  عَنْ  ضَمْرَةَ وَالْمُهَاجِرِ ابْنَيْ حَبِيبٍ ، قَالَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  عَلَيْكُمْ بِالسُّحُورِ ; فَإِنَّهُ  الْغَدَاءُ  الْمُبَارَكُ  ،  وَأَسْفِرُوا  بِهِ مَا اسْتَطَعْتُمْ ، وَتَسَحَّرُوا ، وَلَوْ  بِجَرْعَةٍ  مِنْ مَاءٍ  .","","Al-Matalib al-Aliyah 1054","","مهاجر بن حبيب الزبيدي عن أبو بكر الغساني عن عيسى بن يونس بن أبي إسحاق عن مسدد بن مسرهد","باب السحور"
"1289","[6/113]      1055  قَالَ :  وَحَدَّثَنَا  مُعَاوِيَةُ بْنُ يَحْيَى ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، قَالَتْ :  رُبَّمَا قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَرِّبِي سَحُورَكِ الْمُبَارَكَ  ، وَرُبَّمَا لَمْ يَكُنْ غَيْرَ تَمْرَتَيْنِ  .","","Al-Matalib al-Aliyah 1055","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن معاوية بن يحيى الصدفي عن مسدد بن مسرهد","باب السحور"
"1290","[6/114]      1056  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  دَاوُدُ بْنُ الْمُحَبَّرِ ،  ثَنَا  بَحْرُ بْنُ كَنِيزٍ السَّقَّا ،  عَنْ  عِمْرَانَ الْقَصِيرِ ،  عَنْ  أَبِي سَعِيدٍ الْإِسْكَنْدَرَانِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْجَمَاعَةُ بَرَكَةٌ ، وَالثَّرِيدُ بَرَكَةٌ  ، وَالسُّحُورُ بَرَكَةٌ ، تَسَحَّرُوا ; فَإِنَّهُ يَزِيدُ فِي الْقُوَّةِ ، وَهُوَ مِنَ السُّنَّةِ ، تَسَحَّرُوا وَلَوْ  بِجَرْعَةٍ  مِنْ مَاءٍ - أَوْ عَلَى  جَرْعَةٍ  مِنْ مَاءٍ -  تَسَحَّرُوا ، صَلَوَاتُ اللهِ عَلَى الْمُتَسَحِّرِينَ  .         [6/115]","","Al-Matalib al-Aliyah 1056","","أبو سعيد الإسكندراني عن عمران بن مسلم القصير عن بحر بن كنيز السقاء عن داود بن المحبر البكراوي عن الحارث بن محمد بن أبي أسامة","باب السحور"
"1291","[6/116]      1057  / 1  -  وَقَالَ أَبُو دَاوُدَ :  حَدَّثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  زُهَيْرِ بْنِ أَبِي ثَابِتٍ الْأَعْمَى ،  عَنْ  تَمِيمِ بْنِ عِيَاضٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، قَالَ :  كَانَ  عَلْقَمَةُ بْنُ عُلَاثَةَ  عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَاءَ  بِلَالٌ  رَضِيَ اللهُ عَنْهُ يُؤْذِنُهُ بِالصَّلَاةِ ، فَقَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  رُوَيْدًا  يَا  بِلَالُ  ، يَتَسَحَّرُ  عَلْقَمَةُ  قَالَ : وَهُوَ يَتَسَحَّرُ بِرَأْسٍ  .","","Al-Matalib al-Aliyah 1057","","عبد الله بن عمر بن الخطاب عن تميم بن عياض عن زهير بن أبى ثابت العبسي عن قيس بن الربيع الأسدي عن أبو داود الطيالسي","باب السحور"
"1292","[6/117]      1057  / 2  -  [2] وَقَالَ عَبْدُ بْنُ حُمَيْدٍ :  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ ،  ثَنَا  قَيْسٌ ، فَذَكَرَهُ بِلَفْظِ :  بَيْنَمَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَتَسَحَّرُ ، فَلَمَّا فَرَغَ مِنْ سُحُورِهِ جَاءَ  عَلْقَمَةُ بْنُ عُلَاثَةَ  ، فَدَعَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِرَأْسٍ ، فَبَيْنَمَا هُوَ يَأْكُلُ إِذْ جَاءَ  بِلَالٌ  رَضِيَ اللهُ عَنْهُ  ، فَذَكَرَهُ  .","","Al-Matalib al-Aliyah 1057","","عبد الله بن عمر بن الخطاب عن تميم بن عياض عن زهير بن أبى ثابت العبسي عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن عبد بن حميد","باب السحور"
"1293","[6/118]      1058  / 1  -  [1] وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  ثَنَا  حَفْصٌ هُوَ ابْنُ غِيَاثٍ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  أَبِي هُبَيْرَةَ ،  عَنْ  جَدِّهِ شَيْبَانَ  ، قَالَ :  أَتَيْتُ الْمَسْجِدَ ، فَدَخَلْتُ ، فَأَسْنَدْتُ ظَهْرِي إِلَى حُجْرَةِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَإِذَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَتَسَحَّرُ ، فَتَنَحْنَحْتُ ، فَقَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَبُو يَحْيَى  ، هَلُمَّ إِلَى  الْغَدَاءِ  ، قُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي أُرِيدُ الصِّيَامَ ، قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : وَأَنَا أُرِيدُ الصِّيَامَ ، وَلَكِنَّ مُؤَذِّنَنَا هَذَا فِي  بَصَرِهِ سُوءٌ ، أَوْ فِي بَصَرِهِ شَيْءٌ  ، فَإِنَّهُ أَذَّنَ قَبْلَ أَنْ يَطْلُعَ الْفَجْرُ  .","","Al-Matalib al-Aliyah 1058","","شيبان بن مالك السلمي عن يحيى بن عباد بن شيبان الأنصاري عن أشعث بن سوار عن حفص بن غياث النخعي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","باب السحور"
"1294","1058  / 2  - وَقَالَ الْحَسَنُ بْنُ سُفْيَانَ فِي مُسْنَدِهِ وَمُطَيَّنٌ :  حَدَّثَنَا  أَبُو الشَّعْثَاءِ عَلِيُّ بْنُ الْحَسَنِ ،  ثَنَا  حَفْصٌ ، بِهِ . [3]","","Al-Matalib al-Aliyah 1058","","شيبان بن مالك السلمي عن يحيى بن عباد بن شيبان الأنصاري عن أشعث بن سوار عن حفص بن غياث النخعي عن علي بن الحسن بن سليمان الحضرمي عن الحسن بن سفيان النسوي","باب السحور"
"1295","1058  / 3  - وَقَالَ الْحَسَنُ أَيْضًا وَالْبَغَوِيُّ :  ثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ، بِهِ .","","Al-Matalib al-Aliyah 1058","","شيبان بن مالك السلمي عن يحيى بن عباد بن شيبان الأنصاري عن أشعث بن سوار عن حفص بن غياث النخعي عن داود بن رشيد الخوارزمي عن الحسن بن سفيان النسوي","باب السحور"
"1296","1058  / 4  - وَرَوَاهُ ابْنُ أَبِي خَيْثَمَةَ ،  عَنْ  عَاصِمِ بْنِ عَلِيٍّ ،  عَنْ  قَيْسِ بْنِ الرَّبِيعِ ،  عَنْ  أَشْعَثَ بِهِ . وَسَمَّى  أَبَا هُبَيْرَةَ يَحْيَى بْنَ عَبَّادٍ  .","","Al-Matalib al-Aliyah 1058","","شيبان بن مالك السلمي عن يحيى بن عباد بن شيبان الأنصاري عن أشعث بن سوار عن قيس بن الربيع الأسدي عن عاصم بن علي الواسطي عن أحمد بن أبى خيثمة البغدادي","باب السحور"
"1297","1058  / 5  - وَقَالَ ابْنُ مَنْدَهْ :  أَخْبَرَنَا  الْحَسَنُ بْنُ مَنْصُورٍ الْإِمَامُ .  1058  / 6  - وَقَالَ ابْنُ السَّكَنِ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الطَّائِيُّ ، قَالَا :  أَنَا  الْوَلِيدُ بْنُ مَرْوَانَ ،  ثَنَا  عَمِّي  جُنَادَةُ بْنُ مَرْوَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  يَحْيَى بْنِ عَبَّادِ بْنِ شَيْبَانَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، بِهِ .  1058  / 7  -  قَالَ  ابْنُ مَنْدَهْ  : وَتَابَعَهُ  عَبْدُ الرَّحْمَنِ بْنُ شَرِيكٍ  ، عَنْ أَبِيهِ ، عَنْ  أَشْعَثَ  ، يَعْنِي مِنْ قَوْلِهِ : عَنْ أَبِيهِ ، عَنْ جَدِّهِ .  قُلْتُ : وَالْأَوَّلُ أَشْبَهُ بِالصَّوَابِ  .         [6/119]","","Al-Matalib al-Aliyah 1058","","شيبان بن مالك السلمي عن عباد بن شيبان السلمي عن يحيى بن عباد بن شيبان الأنصاري عن أشعث بن سوار عن مروان بن الحكم الأزدي عن جنادة بن مروان الحمصي عن الوليد بن مروان ابن أخي جنادة بن مروان عن الحسن بن منصور بن هاشم الحمصي عن محمد بن إسحاق ابن منده","باب السحور"
"1298","[6/120]      1059  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  شَبِيبِ بْنِ غَرْقَدَةَ ،  عَنْ  حِبَّانَ بْنِ الْحَارِثِ ، قَالَ :  أَتَيْنَا  عَلِيًّا رَضِيَ اللهُ عَنْهُ وَهُوَ بِعَسْكَرِ  أَبِي مُوسَى  ، فَوَجَدْتُهُ يَطْعَمُ ، فَقَالَ : ادْنُ فَكُلْ  ، فَقُلْتُ : إِنِّي أُرِيدُ الصِّيَامَ . فَقَالَ : وَأَنَا أُرِيدُ الصِّيَامَ ، فَأَكَلَ حَتَّى إِذَا فَرَغَ قَالَ لِمُؤَذِّنِهِ  ابْنِ النَّبَّاحِ  : أَقِمْ  .         [6/121]","","Al-Matalib al-Aliyah 1059","","علي بن أبي طالب عن حبان بن الحارث الكوفي عن شبيب بن غرقدة البارقي عن سفيان بن عيينة عن مسدد بن مسرهد","باب السحور"
"1299","[6/122]      1060  وَقَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  ثَنَا  مُطِيعُ بْنُ رَاشِدٍ ،  عَنْ  تَوْبَةَ ،  حَدَّثَنَا  أَنَسٌ رَضِيَ اللهُ عَنْهُ قَالَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لَهُ :  انْظُرْ مَنْ فِي الْمَسْجِدِ ، فَادْعُهُ  فَإِذَا  أَبُو بَكْرٍ  ،  وَعُمَرُ  رَضِيَ اللهُ عَنْهُمَا فَدَعَوْتُهُمَا ، فَطَعِمُوا ، ثُمَّ خَرَجُوا ، فَصَلَّى بِهِمُ الصُّبْحَ  .","","Al-Matalib al-Aliyah 1060","","أنس بن مالك عن توبة بن أبي الأسد العنبري عن مطيع بن راشد البصري عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة","باب السحور"
"1300","[6/123]      1061  / 1  -  وَقَالَ أَبُو دَاوُدَ الطَّيَالِسِيُّ :  حَدَّثَنَا  طَلْحَةُ بْنُ عَمْرٍو ، (  ح  )  1061  / 2  - وَقَالَ عَبْدُ بْنُ حُمَيْدٍ :  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ .  1061  / 3  - وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  أَبُو الْمُغِيرَةِ ، قَالَا :  ثَنَا  طَلْحَةُ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّا مُعَاشِرَ الْأَنْبِيَاءِ أُمِرْنَا أَنْ نُعَجِّلَ إِفْطَارَنَا  ، وَنُؤَخِّرَ سُحُورَنَا . الْحَدِيثَ  .  وَقَدْ تَقَدَّمَ فِي الصَّلَاةِ  .         [6/124]","","Al-Matalib al-Aliyah 1061","","عبد الله بن عباس عن عطاء بن أبي رباح عن طلحة بن عمرو الحضرمي عن أبو داود الطيالسي عن النضر بن إسماعيل بن حازم البجلي عن أحمد بن منيع البغوي","باب السحور"
"1301","[6/125]      24 - بَابُ كَرَاهِيَةِ الْقُبْلَةِ لِلصَّائِمِ وَغَيْرِهَا وَمَا جَاءَ  فِي الرُّخْصَةِ فِي ذَلِكَ وَفِيهِ ذِكْرُ الْكُحْلِ وَالسِّوَاكِ  1062  / 1  -  قَالَ إِسْحَاقُ :  قُلْتُ  لِأَبِي أُسَامَةَ :  أَحَدَّثَكُمْ  عُمَرُ بْنُ حَمْزَةَ ،  أَخْبَرَنِي  سَالِمٌ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  قَالَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْمَنَامِ ، فَرَأَيْتُهُ لَا يَنْظُرُ إِلَيَّ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، مَا شَأْنِي ؟  قَالَ : أَلَسْتَ الَّذِي تُقَبِّلُ وَأَنْتَ صَائِمٌ . قَالَ : فَوَالَّذِي بَعَثَكَ بِالْحَقِّ نَبِيًّا ، لَا أُقَبِّلُ بَعْدَهَا وَأَنَا صَائِمٌ ; فَأَقَرَّ بِهِ وَقَالَ : نَعَمْ  .","","Al-Matalib al-Aliyah 1062","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمر بن حمزة بن عبد الله بن عمر بن الخطاب عن حماد بن أسامة القرشي عن إسحاق ابن راهويه","باب كراهية القبلة للصائم وغيرها وما جاء في الرخصة في ذلك"
"1302","1062  / 2  - وَقَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ :  ثَنَا  أَبُو أُسَامَةَ ، مِثْلَهُ .         [6/126]","","Al-Matalib al-Aliyah 1062","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمر بن حمزة بن عبد الله بن عمر بن الخطاب عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة","باب كراهية القبلة للصائم وغيرها وما جاء في الرخصة في ذلك"
"1303","[6/127]      1063  / 1  -  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  مَرْوَانُ هُوَ ابْنُ مُعَاوِيَةَ ،  عَنْ  رَزِينٍ الْبَكْرِيِّ ،  حَدَّثَتْنَا  مَوْلَاةٌ لَنَا يُقَالُ لَهَا سَلْمَى مِنْ  بَكْرِ بْنِ وَائِلٍ  ، أَنَّهَا قَالَتْ :  سَمِعْتُ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، تَقُولُ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  يَا  عَائِشَةُ  ، هَلْ مِنْ كِسْرَةٍ  ، فَآتَيْتُهُ بِقُرْصٍ فَوَضَعَهُ عَلَى فِيهِ ، وَقَالَ : يَا  عَائِشَةُ  ، هَلْ دَخَلَ بَطْنِي مِنْهُ شَيْءٌ ، فَكَذَلِكَ قُبْلَةُ الصَّائِمِ ، إِنَّمَا الْإِفْطَارُ مِمَّا دَخَلَ ، وَلَيْسَ مِمَّا خَرَجَ  .","","Al-Matalib al-Aliyah 1063","","عائشة بنت أبي بكر الصديق عن سلمى البكرية عن رزين بن حبيب الجهني عن مروان بن معاوية الفزاري عن أحمد بن منيع البغوي","باب كراهية القبلة للصائم وغيرها وما جاء في الرخصة في ذلك"
"1304","1063  / 2  - وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَحْمَدُ بْنُ مَنِيعٍ ، بِهَذَا .         [6/128]","","Al-Matalib al-Aliyah 1063","","عائشة بنت أبي بكر الصديق عن سلمى البكرية عن رزين بن حبيب الجهني عن مروان بن معاوية الفزاري عن أحمد بن منيع البغوي عن أبو يعلى الموصلي","باب كراهية القبلة للصائم وغيرها وما جاء في الرخصة في ذلك"
"1305","[6/129]      1064  وَقَالَ أَبُو يَعْلَى أَيْضًا :  حَدَّثَنَا  أَبُو يَاسِرٍ الْمُسْتَلْمِيُّ ،  ثَنَا  سَعِيدُ بْنُ زَيْدٍ أَخُو حَمَّادٍ ،  ثَنَا  عَمْرُو بْنُ خَالِدٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ ،  وَعَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ بَيْتِ  حَفْصَةَ  رَضِيَ اللهُ عَنْهَا  وَقَدِ اكْتَحَلَ بِالْإِثْمِدِ فِي رَمَضَانَ  .","","Al-Matalib al-Aliyah 1064","","عبد الله بن عمر بن الخطاب عن أبو جعفر الباقر عن عمرو بن خالد القرشي عن سعيد بن زيد الجهضمي عن عمار بن هارون المستملي عن أبو يعلى الموصلي","باب كراهية القبلة للصائم وغيرها وما جاء في الرخصة في ذلك"
"1306","[6/130]      1065  وَقَالَ أَيْضًا :  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  ثَنَا  حِبَّانُ بْنُ عَلِيٍّ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  رَضِيَ اللهُ عَنْهُ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَكْتَحِلُ وَهُوَ صَائِمٌ  .","","Al-Matalib al-Aliyah 1065","","أبو رافع القبطي عن عبيد الله بن أبي رافع مولى رسول الله عن محمد بن عبيد الله بن أبي رافع عن حبان بن علي العنزي عن سليمان بن داود العتكي عن أبو يعلى الموصلي","باب كراهية القبلة للصائم وغيرها وما جاء في الرخصة في ذلك"
"1307","[6/131]      1066  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَارِجَةَ ،  ثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  عَنِ  النُّعْمَانِ بْنِ الْمُنْذِرِ ،  عَنْ  عَطَاءٍ ، وَطَاوُوسٍ ، وَمُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَسَوَّكَ وَهُوَ صَائِمٌ  .","","Al-Matalib al-Aliyah 1066","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن النعمان بن المنذر الغساني عن يحيى بن حمزة بن البتلهي عن الهيثم بن خارجة الخراساني عن أحمد بن منيع البغوي","باب كراهية القبلة للصائم وغيرها وما جاء في الرخصة في ذلك"
"1308","[6/132]      1067  وَقَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  مَرْوَانُ هُوَ ابْنُ مُعَاوِيَةَ ،  عَنْ  أَبَانَ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  سُئِلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ قُبْلَةِ الصَّائِمِ ؟  قَالَ : رَيْحَانَةٌ يَشُمُّهَا  .","","Al-Matalib al-Aliyah 1067","","أنس بن مالك عن أبان بن إسحاق عن مروان بن معاوية الفزاري عن ابن أبي عمر العدني","باب كراهية القبلة للصائم وغيرها وما جاء في الرخصة في ذلك"
"1309","[6/133]      1068  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ عَجْلَانَ ،  حَدَّثَنِي  سَعِيدُ بْنُ أَبِي سَعِيدٍ قَالَ :  إِنَّ رَجُلًا سَأَلَ أَبَا هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ فَقَالَ : أُقَبِّلُ امْرَأَتِي وَأَنَا صَائِمٌ ؟  قَالَ  : لَا بَأْسَ قَالَ : فَأُقَبِّلُ امْرَأَةً غَيْرَهَا ؟ قَالَ :  أُفٍّ  . قَالَ :  وَسَأَلْتُ  سَعْدَ بْنَ مَالِكٍ ، فَقَالَ : لَا بَأْسَ  .","","Al-Matalib al-Aliyah 1068","","أبو هريرة الدوسي عن سعيد المقبري عن محمد بن عجلان عن يحيى القطان عن مسدد بن مسرهد","باب كراهية القبلة للصائم وغيرها وما جاء في الرخصة في ذلك"
"1310","[6/134]      1069  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  لَيْثٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، قَالَ :  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ  .         [6/135]","","Al-Matalib al-Aliyah 1069","","علي بن أبي طالب عن الحارث الأعور عن أبو إسحاق السبيعي عن ليث بن أبي سليم عن عبد الوارث بن سعيد بن ذكوان عن مسدد بن مسرهد","باب كراهية القبلة للصائم وغيرها وما جاء في الرخصة في ذلك"
"1311","[6/136]      1070  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  مَنْصُورِ بْنِ زَاذَانَ ،  عَنْ  يَزِيدَ بْنِ سَعِيدٍ مَوْلَى صَفِيَّةَ ،  أَنَّهُ سَمِعَ  صَفِيَّةَ بِنْتَ حُيَيٍّ رَضِيَ اللهُ عَنْهَا ، تَقُولُ :  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ  .","","Al-Matalib al-Aliyah 1070","","صفية بنت حيي زوج رسول الله عن يزيد بن شعيب مولى صفية بنت حيي عن منصور بن زاذان الثقفي عن هشيم بن بشير عن مسدد بن مسرهد","باب كراهية القبلة للصائم وغيرها وما جاء في الرخصة في ذلك"
"1312","[6/137]      1071  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ هُوَ ابْنُ أَخِي الزُّهْرِيِّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ احْتَجَمَ وَهُوَ صَائِمٌ  .","","Al-Matalib al-Aliyah 1071","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن الواقدي عن الحارث بن محمد بن أبي أسامة","باب كراهية القبلة للصائم وغيرها وما جاء في الرخصة في ذلك"
"1313","[6/138]      1072  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ أَبِي إِسْمَاعِيلَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  أَبِي بَكْرِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  مُعَاوِيَةَ بْنِ عَبْدِ اللهِ بْنِ طُوَيْلِعٍ ،  عَنْ  عَائِشَةَ أُمِّ الْمُؤْمِنِينَ رَضِيَ اللهُ عَنْهَا ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كُلُّ شَيْءٍ مِنِ امْرَأَتِكَ لَكَ حَلَالٌ إِذَا كُنْتَ صَائِمًا  إِلَّا مَا بَيْنَ الرِّجْلَيْنِ  .","","Al-Matalib al-Aliyah 1072","","عائشة بنت أبي بكر الصديق عن معاوية بن طويع الحمصي عن أبو بكر الغساني عن إسماعيل بن عياش الأحول عن إسماعيل بن أبي إسماعيل المؤدب عن الحارث بن محمد بن أبي أسامة","باب كراهية القبلة للصائم وغيرها وما جاء في الرخصة في ذلك"
"1314","[6/139]      25 - بَابُ إِجَابَةِ الدُّعَاءِ عِنْدَ الْفِطْرِ  وَمَا يَقُولُهُ الصَّائِمُ عِنْدَ فِطْرِهِ  1073  قَالَ أَبُو دَاوُدَ :  حَدَّثَنَا  أَبُو مُحَمَّدٍ الْمُلَيْكِيُّ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لِلصَّائِمِ عِنْدَ إِفْطَارِهِ دَعْوَةٌ مُسْتَجَابَةٌ  ، فَكَانَ  عَبْدُ اللهِ بْنُ عَمْرٍو  رَضِيَ اللهُ عَنْهُمَا إِذَا أَفْطَرَ دَعَا أَهْلَهُ وَوَلَدَهُ وَدَعَا  .  قُلْتُ :  هَذَا فِي سُنَنِ  ابْنِ مَاجَهْ  بِإِسْنَادٍ آخَرَ عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  رَضِيَ اللهُ عَنْهُمَا  مَرْفُوعًا  وَمَوْقُوفًا  بِلَفْظٍ آخَرَ  .         [6/140]","","Al-Matalib al-Aliyah 1073","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن عمرو بن شعيب عن عبد الرحمن بن أبي بكر الجدعاني عن أبو داود الطيالسي","باب إجابة الدعاء عند الفطر وما يقوله الصائم عند فطره"
"1315","[6/141]      1074  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ وَاقِدٍ ،  ثَنَا  حَمَّادُ بْنُ عَمْرٍو ،  ثَنَا  السَّرِيُّ بْنُ خَالِدِ بْنِ شَدَّادٍ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ ، قَالَ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  عَلِيُّ  ، إِذَا كُنْتَ صَائِمًا فِي شَهْرِ رَمَضَانَ فَقُلْ بَعْدَ إِفْطَارِكَ  : اللَّهُمَّ لَكَ صُمْتُ ، وَعَلَيْكَ تَوَكَّلْتُ ، وَعَلَى رِزْقِكَ أَفْطَرْتُ ، يُكْتَبْ لَكَ مِثْلُ مَنْ كَانَ صَائِمًا مِنْ غَيْرِ أَنْ يَنْقُصَ مِنْ أُجُورِهِمْ شَيْءٌ  .         [6/142]","","Al-Matalib al-Aliyah 1074","","علي بن أبي طالب عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جعفر الصادق عن سرى بن مخلد عن حماد بن عمرو النصيبي عن عبد الرحيم بن واقد الخراساني عن الحارث بن محمد بن أبي أسامة","باب إجابة الدعاء عند الفطر وما يقوله الصائم عند فطره"
"1316","[6/143]      26 - بَابُ مَنْ أَكَلَ نَاسِيًا لَمْ يُفْطِرْ  1075  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ عَجْلَانَ ،  حَدَّثَنِي  سَعِيدٌ الْمَقْبُرِيُّ قَالَ :  إِنَّ رَجُلًا  سَأَلَ  أَبَا هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، فَقَالَ : أَكَلْتُ وَأَنَا صَائِمٌ  ؟ قَالَ : لَا شَيْءَ عَلَيْكَ . قَالَ : شَرِبْتُ وَأَنَا صَائِمٌ ؟ قَالَ : لَا شَيْءَ عَلَيْكَ ، قَالَ : فَأَكَلْتُ كَذَا وَكَذَا وَأَنَا صَائِمٌ ؟ قَالَ : يَا بُنَيَّ ، أَنْتَ لَمْ تَعْتَدِ الصِّيَامَ  .  مَوْقُوفٌ  صَحِيحٌ  .","","Al-Matalib al-Aliyah 1075","","أبو هريرة الدوسي عن سعيد المقبري عن محمد بن عجلان عن يحيى القطان عن مسدد بن مسرهد","باب من أكل ناسيا لم يفطر"
"1317","[6/144]      1076  وَقَالَ عَبْدُ بْنُ حُمَيْدٍ :  حَدَّثَنَا  أَبُو عَاصِمٍ ،  عَنْ  بَشَّارِ بْنِ عَبْدِ الْمَلِكِ ،  حَدَّثَتْنِي  أُمُّ حَكِيمٍ بِنْتُ دِينَارٍ مَوْلَاةُ أُمِّ إِسْحَاقَ ،  عَنْ  أُمِّ إِسْحَاقَ ، قَالَتْ :  دَخَلْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأُتِيَ بِخُبْزٍ وَلَحْمٍ ، قَالَتْ : وَكُنْتُ أَشْتَهِي أَنْ آكُلَ مِنْ طَعَامِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  هَلُمَّ يَا  أُمَّ إِسْحَاقَ  ، فَكُلِي  . قَالَتْ : فَأَكَلْتُ ثُمَّ نَاوَلَنِي عَرْقًا ، فَرَفَعْتُهُ إِلَى فِيَّ ، فَذَكَرْتُ أَنِّي صَائِمَةٌ ، فَبَقِيَتْ يَدِي لَا أَسْتَطِيعُ أَنْ أَرْفَعَهَا إِلَى فِيَّ ، وَلَا أَسْتَطِيعُ أَنْ أَضَعَهَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مَا لَكِ يَا  أُمَّ إِسْحَاقَ  ؟ قُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي كُنْتُ صَائِمَةً ، فَقَالَ : أَتِمِّي صَوْمَكِ ، فَقَالَ  ذُو الْيَدَيْنِ  : الْآنَ حِينَ شَبِعْتِ ؟ فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّمَا هُوَ رِزْقٌ سَاقَهُ اللهُ تَعَالَى إِلَيْهَا  .  قُلْتُ : أَخْرَجَهُ  أَحْمَدُ  ، وَفِي هَذَا زِيَادَةٌ  .         [6/145]","","Al-Matalib al-Aliyah 1076","","أم إسحاق الغنوية عن أم حكيم بنت دينار عن بشار بن عبد الملك المزني عن أبو عاصم النبيل عن عبد بن حميد","باب من أكل ناسيا لم يفطر"
"1318","[6/146]      27 - بَابُ صِيَامِ عَاشُورَاءَ  1077  قَالَ أَبُو دَاوُدَ :  حَدَّثَنَا  شُعْبَةُ ،  أَخْبَرَنِي  أَبُو إِسْحَاقَ ،  سَمِعْتُ  الْأَسْوَدَ بْنَ يَزِيدَ ، يَقُولُ :  مَا رَأَيْتُ أَحَدًا كَانَ آمَرَ بِصَوْمِ عَاشُورَاءَ مِنْ عَلِيِّ بْنِ أَبِي طَالِبٍ ، وَأَبِي مُوسَى  رَضِيَ اللهُ عَنْهُمَا  .  هَذَا  إِسْنَادٌ  صَحِيحٌ  .","","Al-Matalib al-Aliyah 1077","","أبو موسى الأشعري عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن أبو داود الطيالسي","باب صيام عاشوراء"
"1319","[6/147]      1078  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ، قَالَ :  أَمَرَهُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِصَوْمِ عَاشُورَاءَ  ، الْيَوْمِ الْعَاشِرِ  .","","Al-Matalib al-Aliyah 1078","","الحسن البصري عن يونس بن عبيد عن عبد الوارث بن سعيد بن ذكوان عن مسدد بن مسرهد","باب صيام عاشوراء"
"1320","[6/148]      1079  وَحَدَّثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ،  أَنَّهُ سَأَلَ  عَبْدَ الرَّحْمَنِ بْنَ الْقَاسِمِ عَنْ صَوْمِ عَاشُورَاءَ ،  فَقَالَ  :  كَانَ ابْنُ عُمَرَ رَضِيَ اللهُ عَنْهُمَا لَا يَصُومُهُ  .","","Al-Matalib al-Aliyah 1079","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد","باب صيام عاشوراء"
"1321","[6/149]      1080  قَالَ :  وَحَدَّثَنَا  حُصَيْنُ بْنُ نُمَيْرٍ ،  ثَنَا  أَبُو لَيْلَى ،  عَنْ  مَزِيدَةَ بْنِ جَابِرٍ ،  عَنْ  أَبِيهِ  قَالَ :  سَمِعْتُ  الْأَشْعَرِيَّ رَضِيَ اللهُ عَنْهُ ، يَقُولُ عَلَى مِنْبَرِ  الْكُوفَةِ  :  أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِصَوْمِ عَاشُورَاءَ  ، فَصُومُوا  .         [6/150]","","Al-Matalib al-Aliyah 1080","","أبو موسى الأشعري عن جابر الحداني عن مزيدة بن جابر الهجري عن عبد الله بن ميسرة الحارثي عن حصين بن نمير الأنصاري عن مسدد بن مسرهد","باب صيام عاشوراء"
"1322","[6/151]      1081  وَقَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ :  حَدَّثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  مَجْزَأَةَ بْنِ زَاهِرٍ ،  عَنْ  أَبِيهِ  ، قَالَ : إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَصُومُ يَوْمَ عَاشُورَاءَ  .         [6/152]","","Al-Matalib al-Aliyah 1081","","زاهر بن الأسود الأسلمي عن مجزأة بن زاهر الأسلمي عن شريك بن عبد الله النخعي عن محمد بن عبد الله بن الزبير عن أبو بكر ابن أبي شيبة","باب صيام عاشوراء"
"1323","[6/153]      1082  وَقَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  الْهَجَرِيِّ ،  عَنْ  أَبِي عِيَاضٍ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صُومُوا يَوْمَ عَاشُورَاءَ  ، يَوْمٌ كَانَ تَصُومُهُ الْأَنْبِيَاءُ ، فَصُومُوهُ  .","","Al-Matalib al-Aliyah 1082","","أبو هريرة الدوسي عن عمرو أو عمير بن الأسود الداراني عن إبراهيم بن مسلم الهجري عن حفص بن غياث النخعي عن أبو بكر ابن أبي شيبة","باب صيام عاشوراء"
"1324","[6/154]      1083  وَقَالَ أَبُو يَعْلَى ،  حَدَّثَنَا  إِسْحَاقُ هُوَ ابْنُ أَبِي إِسْرَائِيلَ ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  يَحْيَى بْنِ هُبَيْرَةَ ،  عَنْ  خَبَّابٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَانَ مِنْكُمْ لَمْ يَأْكُلْ فَلْيَصُمْ  ، وَمَنْ كَانَ أَكَلَ فَلْيُتِمَّ بَقِيَّةَ يَوْمِهِ  .  قَالَ أَبُو يَعْلَى :  يَعْنِي يَوْمَ عَاشُورَاءَ  .         [6/155]","","Al-Matalib al-Aliyah 1083","","خباب بن الأرت التميمي عن يحيى بن جعدة بن هبيرة المخزومي عن أبو إسحاق السبيعي عن محمد بن جابر بن سيار عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","باب صيام عاشوراء"
"1325","[6/156]      1084  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  ثَنَا  حَمَّادٌ ،  عَنْ  أَبِي هَارُونَ الْعَبْدِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ رَضِيَ اللهُ عَنْهُ قَالَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ بِصَوْمِ عَاشُورَاءَ  ، وَكَانَ لَا يَصُومُهُ  .","","Al-Matalib al-Aliyah 1084","","أبو سعيد الخدري عن عمارة بن جوين العبدي عن حماد بن زيد عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","باب صيام عاشوراء"
"1326","[6/157]      1085  / 1  - وَقَالَ الْحَارِثُ :  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبَانَ ،  عَنْ  عُلَيْلَةَ بِنْتِ فُلَانٍ الْأَزْدِيَّةِ ،  حَدَّثَتْنِي  أُمِّي  ،  عَنْ  أَمَةِ اللهِ ،  عَنْ  رَزِينَةَ خَادِمَةِ رَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ (  ح  ) .","","Al-Matalib al-Aliyah 1085","","رزينة مولاة صفية زوج النبي صلى الله عليه وسلم عن أمة الله بنت رزينة خادم النبي صلى الله عليه وسلم عن أم عليلة بنت الكميت عن عليلة بنت الكميت عن عبد العزيز بن أبان السعيدي عن الحارث بن محمد بن أبي أسامة","باب صيام عاشوراء"
"1327","[6/158]      1085  / 2  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَتْنَا  عُلَيْلَةُ ،  عَنْ  أُمِّهَا  ، قَالَتْ :  قُلْتُ  لِأَمَةِ اللهِ بِنْتِ رَزِينَةَ : يَا أَمَةَ اللهِ ،  حَدَّثَتْكِ  أُمُّكِ رَزِينَةُ  أَنَّهَا سَمِعَتْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَذْكُرُ صَوْمَ عَاشُورَاءَ ؟ قَالَتْ : نَعَمْ ، كَانَ يُعَظِّمُهُ حَتَّى يَدْعُوَ بِرُضَعَائِهِ وَرُضَعَاءِ بِنْتِهِ  فَاطِمَةَ  رَضِيَ اللهُ عَنْهَا ، فَيَتْفُلُ فِي أَفْوَاهِهِمْ وَيَقُولُ :  لَا تُرْضِعُوهُمْ إِلَى اللَّيْلِ  .  لَمْ يَذْكُرِ الْحَارِثُ السُّؤَالَ  .         [6/159]","","Al-Matalib al-Aliyah 1085","","رزينة مولاة صفية زوج النبي صلى الله عليه وسلم عن أمة الله بنت رزينة خادم النبي صلى الله عليه وسلم عن أم عليلة بنت الكميت عن عليلة بنت الكميت عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","باب صيام عاشوراء"
"1328","[6/160]      1086  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  ثَنَا  حَمَّادٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْخَلِيلِ ،  عَنْ  إِيَاسِ بْنِ حَرْمَلَةَ ،  عَنْ  أَبِي قَتَادَةَ قَالَ :  إِنَّ  أَعْرَابِيًّا  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ صَوْمِ يَوْمِ عَرَفَةَ ، وَيَوْمِ عَاشُورَاءَ فَقَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَوْمُ عَاشُورَاءَ يُكَفِّرُ الْعَامَ الَّذِي قَبْلَهُ وَالَّذِي بَعْدَهُ  ، وَصَوْمُ عَرَفَةَ يُكَفِّرُ الْعَامَ الَّذِي قَبْلَهُ  .  قُلْتُ :  هَذَا  إِسْنَادُهُ مَقْلُوبٌ  ،  وَمَتْنٌ مَقْلُوبٌ  ; أَمَّا  الْإِسْنَادُ  ، فَالصَّوَابُ :  حَرْمَلَةُ بْنُ إِيَاسٍ  ، هَكَذَا أَخْرَجَهُ  أَحْمَدُ  ، وَغَيْرُهُ  . وَأَمَّا  الْمَتْنُ  ، فَالصَّوَابُ أَنَّ يَوْمَ عَرَفَةَ هُوَ الَّذِي يُكَفِّرُ السَّنَتَيْنِ ، وَعَاشُورَاءَ يُكَفِّرُ سَنَةً  ، كَذَا أَخْرَجَهُ  مُسْلِمٌ  وَغَيْرُهُ مِنْ وَجْهٍ آخَرَ عَنْ  أَبِي قَتَادَةَ  رَضِيَ اللهُ عَنْهُ  .         [6/161]","","Al-Matalib al-Aliyah 1086","","أبو قتادة الأنصاري فارس رسول الله عن حرملة بن إياس الشيباني عن صالح بن أبي مريم الضبعي عن قتادة بن دعامة عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","باب صيام عاشوراء"
"1329","[6/162]      28 - بَابُ صَوْمِ شَعْبَانَ وَشَوَّالٍ  1087  قَالَ الْحَارِثُ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَوْنٍ ،  ثَنَا  أَبُو عُبَيْدَةَ ،  ثَنَا  أَبُو عَبْدِ اللهِ ،  ثَنَا  خَالِدُ بْنُ مَعْدَانَ ،  عَنْ  كَثِيرِ بْنِ مُرَّةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ رَبَّكُمْ يَطَّلِعُ لَيْلَةَ النِّصْفِ مِنْ شَعْبَانَ إِلَى خَلْقِهِ ، فَيَغْفِرُ لَهُمْ كُلِّهِمْ  ، إِلَّا أَنْ يَكُونَ مُشْرِكًا أَوْ مُصَارِمًا . قَالُوا : وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَصُومُ شَعْبَانَ ، فَيَدْخُلُ رَمَضَانُ وَهُوَ صَائِمٌ تَعْظِيمًا لِرَمَضَانَ  .         [6/163]             [6/164]             [6/165]","","Al-Matalib al-Aliyah 1087","","كثير بن مرة الرهاوي عن خالد بن معدان عن مرزوق الشامي عن عبد الواحد بن واصل عن عبد الله بن عون الهلالي عن الحارث بن محمد بن أبي أسامة","باب صوم شعبان وشوال"
"1330","[6/166]      1088  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنِ  ابْنِ مُحَمَّدِ بْنِ أُسَامَةَ ،  عَنْ  جَدِّهِ أُسَامَةَ  رَضِيَ اللهُ عَنْهُ ،  أَنَّهُ كَانَ إِذَا أَفْطَرَ أَصْبَحَ مِنَ الْغَدِ صَائِمًا مِنْ شَوَّالٍ  ، حَتَّى يَتِمَّ عَلَى آخِرِهِ  .         [6/167]","","Al-Matalib al-Aliyah 1088","","أسامة بن زيد بن حارثة ذو البطين عن محمد بن أسامة بن محمد عن محمد بن إسحاق عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","باب صوم شعبان وشوال"
"1331","[6/168]      1089  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحْرِزُ بْنُ عَوْنٍ ،  ثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنْ  لَيْثٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رُبَّمَا يَقْرِنُ شَعْبَانَ بِرَمَضَانَ  .","","Al-Matalib al-Aliyah 1089","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن ليث بن أبي سليم عن الفضيل بن عياض عن محرز بن عون الهلالي عن أبو يعلى الموصلي","باب صوم شعبان وشوال"
"1332","[6/169]      29 - بَابُ فَضْلِ صَوْمِ يَوْمِ عَرَفَةَ إِلَّا بِعَرَفَةَ  1090  / 1  -  قَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  أَبِي حَفْصٍ الطَّائِفِيِّ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ السَّاعِدِيِّ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَامَ يَوْمَ عَرَفَةَ غُفِرَ لَهُ سَنَتَيْنِ مُتَتَابِعَتَيْنِ  .  1090  / 2  - رَوَاهُ  الطَّبَرَانِيُّ  ،  عَنْ  عُبَيْدِ بْنِ غَنَّامٍ  ،  عَنْ  أَبِي بَكْرٍ  .  وَعَنِ  الْحُسَيْنِ بْنِ إِسْحَاقَ التُّسْتَرِيِّ  ،  وَعَبْدَانَ بْنِ أَحْمَدَ  ، قَالَا :  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ  ،  ثَنَا  مُعَاوِيَةُ  ، مِثْلَهُ .","","Al-Matalib al-Aliyah 1090","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد السلام بن حفص السلمي عن معاوية بن هشام القصار عن أبو بكر ابن أبي شيبة","باب فضل صوم يوم عرفة إلا بعرفة"
"1333","1090  / 3  - وَرَوَاهُ أَبُو يَعْلَى ، قَالَ :  ثَنَا  أَبُو بَكْرٍ .         [6/170]","","Al-Matalib al-Aliyah 1090","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد السلام بن حفص السلمي عن معاوية بن هشام القصار عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","باب فضل صوم يوم عرفة إلا بعرفة"
"1334","[6/171]      1091  وَقَالَ عَبْدُ بْنُ حُمَيْدٍ :  حَدَّثَنَا  يَحْيَى بْنُ إِسْحَاقَ ،  أَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  إِسْحَاقَ بْنِ عَبْدِ اللهِ بْنِ أَبِي فَرْوَةَ ،  عَنْ  عِيَاضٍ ،  عَنْ  أَبِي سَعِيدٍ رَضِيَ اللهُ عَنْهُ ،  رَفَعَهُ  :  مَنْ صَامَ يَوْمَ عَرَفَةَ غُفِرَ لَهُ سَنَتَيْنِ  ، سَنَةً قَبْلَهُ وَسَنَةً بَعْدَهُ  .  رَوَاهُ  ابْنُ مَاجَهْ  مِنْ هَذَا الْوَجْهِ ، فَزَادَ عَنْ  أَبِي سَعِيدٍ  ، عَنْ  قَتَادَةَ بْنِ النُّعْمَانِ  .  وَإِسْحَاقُ  ضَعِيفٌ جِدًّا  .         [6/172]","","Al-Matalib al-Aliyah 1091","","أبو سعيد الخدري عن عياض بن عبد الله بن سعد العامري عن إسحاق بن أبي فروة عن عبد الله بن لهيعة عن يحيى بن إسحاق السيلحيني عن عبد بن حميد","باب فضل صوم يوم عرفة إلا بعرفة"
"1335","[6/173]      1092  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  عِيسَى بْنُ يُونُسَ ،  ثَنَا  عُثْمَانُ بْنُ حَكِيمٍ ،  حَدَّثَتْنِي  نَدَبَةُ ، قَالَتْ :  سَمِعْتُ  ابْنَ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، يَقُولُ :  مَنْ صَحِبَنِي مِنْ ذَكَرٍ وَأُنْثَى ، فَلَا يَصُومَنَّ يَوْمَ عَرَفَةَ  ; فَإِنَّهُ يَوْمُ أَكْلٍ  وَشُرْبٍ  وَذِكْرِ اللهِ تَعَالَى  .","","Al-Matalib al-Aliyah 1092","","عبد الله بن عباس عن ندبة مولاة ميمونة أم المؤمنين عن عثمان بن حكيم الأحلافي عن عيسى بن يونس بن أبي إسحاق عن مسدد بن مسرهد","باب فضل صوم يوم عرفة إلا بعرفة"
"1336","[6/174]      1093  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  الْحَارِثُ بْنُ عُبَيْدٍ أَبُو قُدَامَةَ ،  عَنْ  هُودِ بْنِ شِهَابِ بْنِ عَبَّادٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ :  مَرَّ عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ عَلَى أَبْيَاتٍ  بِعَرَفَاتٍ  ، فَقَالَ : لِمَنْ هَذِهِ الْأَبْيَاتُ  ؟ قُلْنَا :  لِعَبْدِ الْقَيْسِ  ، فَقَالَ لَهُمْ خَيْرًا ، وَنَهَاهُمْ عَنْ صَوْمِ يَوْمِ عَرَفَةَ  .  قَالَ :  وَحَجَّ أَبِي ،  وَطَلِيقُ بْنُ مُحَمَّدٍ الْخُزَاعِيُّ  ، فَاخْتَلَفَا فِي صَوْمِ يَوْمِ عَرَفَةَ ، فَقَالَ أَبِي : بَيْنَكَ وَبَيْنِي سَعِيدُ بْنُ الْمُسَيِّبِ ، فَأَتَيَاهُ ، فَقَالَ : يَا  أَبَا مُحَمَّدٍ  ، اخْتَلَفْنَا فِي صَوْمِ يَوْمِ عَرَفَةَ ، فَجَعَلْنَاكَ بَيْنَنَا ، فَقَالَ :  أُخْبِرُكُمْ  عَمَّنْ هُوَ خَيْرٌ مِنِّي ، عَنِ ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، أَنَّهُ  كَانَ لَا يَصُومُهُ  .         [6/175]","","Al-Matalib al-Aliyah 1093","","عبد الله بن عمر بن الخطاب عن سعيد بن المسيب عن شهاب بن عباد العبدي عن هود بن شهاب بن عباد عن الحارث بن عبيد الإيادي عن مسدد بن مسرهد","باب فضل صوم يوم عرفة إلا بعرفة"
"1337","[6/176]      1094  وَقَالَ أَبُو دَاوُدَ الطَّيَالِسِيُّ :  حَدَّثَنَا  حَوْشَبُ بْنُ عَقِيلٍ ،  عَنْ  مَهْدِيٍّ الْهَجَرِيِّ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ صَوْمِ يَوْمِ عَرَفَةَ  بِعَرَفَةَ  .  خَالَفَهُ الْحُفَّاظُ عَنْ  حَوْشَبٍ  ، وَقَالُوا : عَنْ  مَهْدِيٍّ  ، عَنْ  عِكْرِمَةَ  ، عَنْ  أَبِي هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ  ، وَمِنْ هَذَا الْوَجْهِ أَخْرَجَهُ  أَبُو دَاوُدَ  ،  وَالنَّسَائِيُّ  ،  وَابْنُ مَاجَهْ  .         [6/177]","","Al-Matalib al-Aliyah 1094","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن مهدي بن حرب الهجري عن حوشب الجرمي عن أبو داود الطيالسي","باب فضل صوم يوم عرفة إلا بعرفة"
"1338","[6/178]      30 - بَابُ  الزَّجْرِ  عَنْ صَوْمِ يَوْمَيِ الْفِطْرِ وَالْأَضْحَى  1095  قَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ :  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  عَبْدِ اللهِ بْنِ سَعِيدٍ ،  عَنْ  جَدِّهِ  ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ صَوْمِ يَوْمِ الْفِطْرِ وَيَوْمِ الْأَضْحَى  ... الْحَدِيثَ .         [6/179]","","Al-Matalib al-Aliyah 1095","","أبو هريرة الدوسي عن أبو سعيد المقبري عن عبد الله بن سعيد بن أبي سعيد المقبري عن حفص بن غياث النخعي عن أبو بكر ابن أبي شيبة","باب الزجر عن صوم يومي الفطر والأضحى"
"1339","[6/180]      31 - بَابُ النَّهْيِ عَنْ صِيَامِ أَيَّامِ  التَّشْرِيقِ  1096  / 1  -  قَالَ إِسْحَاقُ :  أَخْبَرَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي حُمَيْدٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُحَمَّدِ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ سَعْدٍ  رَضِيَ اللهُ عَنْهُ ، قَالَ :  قَالَ لِي النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قُمْ ، فَصِحْ فِي النَّاسِ ، أَنَّ أَيَّامَ  التَّشْرِيقِ  أَيَّامُ أَكْلٍ ،  وَشُرْبٍ  ، لَا يُصَامُ فِيهَا  .","","Al-Matalib al-Aliyah 1096","","سعد بن أبي وقاص عن محمد بن سعد بن أبي وقاص عن إسماعيل بن محمد بن سعد عن محمد بن أبي حميد الزرقي عن أبو عامر العقدي عن إسحاق ابن راهويه","باب النهي عن صيام أيام التشريق"
"1340","1096  / 2  -  أَخْبَرَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  أَنَا  أَبُو إِبْرَاهِيمَ الْمَدَنِيُّ ،  عَنْ  إِسْمَاعِيلَ ، مِثْلَهُ .         [6/181]","","Al-Matalib al-Aliyah 1096","","سعد بن أبي وقاص عن محمد بن سعد بن أبي وقاص عن إسماعيل بن محمد بن سعد عن محمد بن أبي حميد الزرقي عن النضر بن شميل عن إسحاق ابن راهويه","باب النهي عن صيام أيام التشريق"
"1341","1096  / 3  - وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ وَالْحَارِثُ جَمِيعًا :  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي حُمَيْدٍ ، بِهِ .  مُحَمَّدٌ ضَعِيفٌ وَهُوَ أَبُو إِبْرَاهِيمَ الْمَدَنِيُّ  الَّذِي  كَنَّاهُ  النَّضْرُ  .         [6/182]             [6/183]             [6/184]","","Al-Matalib al-Aliyah 1096","","سعد بن أبي وقاص عن محمد بن سعد بن أبي وقاص عن إسماعيل بن محمد بن سعد عن محمد بن أبي حميد الزرقي عن روح بن عبادة القيسي عن أحمد بن منيع البغوي","باب النهي عن صيام أيام التشريق"
"1342","[6/185]      1097  / 1  -  [1] وَقَالَ الطَّيَالِسِيُّ :  حَدَّثَنَا  الرَّبِيعُ هُوَ ابْنُ صُبَيْحٍ ،  عَنْ  يَزِيدَ هُوَ الرَّقَاشِيُّ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ صَوْمِ سِتَّةِ أَيَّامٍ مِنَ السَّنَةِ  ، ثَلَاثَةِ أَيَّامٍ مِنَ  التَّشْرِيقِ ،  وَيَوْمِ الْفِطْرِ ، وَيَوْمِ الْأَضْحَى ، وَيَوْمِ الْجُمُعَةِ ، مُخْتَصَّةً مِنَ الْأَيَّامِ  .","","Al-Matalib al-Aliyah 1097","","أنس بن مالك عن يزيد بن أبان الرقاشي عن الربيع بن صبيح عن أبو داود الطيالسي","باب النهي عن صيام أيام التشريق"
"1343","1097  / 2  -  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ ، وَالْحَارِثُ ، جَمِيعًا :  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  الرَّبِيعُ بْنُ صُبَيْحٍ ، وَمَرْزُوقٌ أَبُو عَبْدِ اللهِ الشَّامِيُّ ، كِلَاهُمَا ،  عَنْ  يَزِيدَ الرَّقَاشِيِّ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ صَوْمِ أَيَّامِ  التَّشْرِيقِ  الثَّلَاثَةِ بَعْدَ يَوْمِ النَّحْرِ  .         [6/186]","","Al-Matalib al-Aliyah 1097","","أنس بن مالك عن يزيد بن أبان الرقاشي عن مرزوق الشامي عن روح بن عبادة القيسي عن أحمد بن منيع البغوي","باب النهي عن صيام أيام التشريق"
"1344","1097  / 3  - وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  ثَنَا  رَوْحٌ ، بِهَذَا .         [6/187]","","Al-Matalib al-Aliyah 1097","","أنس بن مالك عن يزيد بن أبان الرقاشي عن مرزوق الشامي عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","باب النهي عن صيام أيام التشريق"
"1345","1097  / 4  - قَالَ :  وَحَدَّثَنَا  مُوسَى بْنُ مُحَمَّدٍ ،  ثَنَا  كَهْمَسُ بْنُ الْمِنْهَالِ ،  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  يَزِيدَ الرَّقَاشِيِّ ، فَذَكَرَ مِثْلَ حَدِيثِ  الطَّيَالِسِيِّ  .         [6/188]","","Al-Matalib al-Aliyah 1097","","أنس بن مالك عن يزيد بن أبان الرقاشي عن سعيد بن أبي عروبة عن كهمس بن المنهال السدوسي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","باب النهي عن صيام أيام التشريق"
"1346","1097  / 5  - وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ خَالِدٍ الطَّحَّانُ ،  ثَنَا  أَبِي  ،  ثَنَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ ، فَذَكَرَهُ .  قُلْتُ :  أَخْطَأَ فِيهِ  مُحَمَّدُ بْنُ خَالِدٍ  ، وَإِنَّمَا هُوَ  يَزِيدُ الرَّقَاشِيُّ  ، لَا  قَتَادَةُ  .","","Al-Matalib al-Aliyah 1097","","أنس بن مالك عن قتادة بن دعامة عن سعيد بن أبي عروبة عن خالد بن عبد الله الطحان عن محمد بن خالد بن عبد الله الواسطي عن أبو يعلى الموصلي","باب النهي عن صيام أيام التشريق"
"1347","1097  / 6  - وَقَالَ الْحَارِثُ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَوْنٍ ،  ثَنَا  أَبُو عُبَيْدَةَ ،  ثَنَا  أَبُو عَبْدِ اللهِ ،  عَنْ  يَزِيدَ الرَّقَاشِيِّ ، فَذَكَرَ مِثْلَ رِوَايَةِ  الطَّيَالِسِيِّ  .","","Al-Matalib al-Aliyah 1097","","أنس بن مالك عن يزيد بن أبان الرقاشي عن مرزوق الشامي عن عبد الواحد بن واصل عن عبد الله بن عون الهلالي عن الحارث بن محمد بن أبي أسامة","باب النهي عن صيام أيام التشريق"
"1348","[6/189]      1098  / 1  -  وَقَالَ مُسَدَّدٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ .  1098  / 2  - وَأَحْمَدُ بْنُ مَنِيعٍ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ .  1098  / 3  - وَأَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ .  1098  / 4  - وَعَبْدُ بْنُ حُمَيْدٍ ،  ثَنَا  زَيْدُ بْنُ الْحُبَابِ .  كُلُّهُمْ  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنِ  الْمُنْذِرِ بْنِ جَهْمٍ ،  عَنْ  عُمَرَ بْنِ خَلْدَةَ الْأَنْصَارِيِّ ،  عَنْ  أُمِّهِ  رَضِيَ اللهُ عَنْهَا ، قَالَتْ :  بَعَثَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَلِيًّا  رَضِيَ اللهُ عَنْهُ أَيَّامَ  التَّشْرِيقِ  يُنَادِي :  أَيُّهَا النَّاسُ ، إِنَّهَا أَيَّامُ أَكْلٍ  وَشُرْبٍ  ،  وَبِعَالٍ  ، يَعْنِي : "" نِكَاحٍ ""  لَفْظُ  أَبِي بَكْرٍ  .","","Al-Matalib al-Aliyah 1098","","أم عمر الأنصارية عن عمر بن خلدة الزرقي عن منذر بن جهم عن موسى بن عبيدة بن نشيط الحميري عن روح بن عبادة القيسي عن أحمد بن منيع البغوي","باب النهي عن صيام أيام التشريق"
"1349","1098  / 5  - وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو بَكْرٍ ، بِهَذَا .  مُوسَى  ضَعِيفٌ  .         [6/190]             [6/191]","","Al-Matalib al-Aliyah 1098","","أم عمر الأنصارية عن عمر بن خلدة الزرقي عن منذر بن جهم عن موسى بن عبيدة بن نشيط الحميري عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","باب النهي عن صيام أيام التشريق"
"1350","[6/192]      1099  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عَمْرُو بْنُ الْحُصَيْنِ ،  ثَنَا  فُضَيْلُ بْنُ سُلَيْمَانَ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  إِسْحَاقَ بْنِ يَحْيَى ،  عَنْ  عَبْدِ اللهِ بْنِ الْفَضْلِ الْهَاشِمِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  زَيْدِ بْنِ خَالِدٍ الْجُهَنِيِّ رَضِيَ اللهُ عَنْهُ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ  رَجُلًا  يُنَادِي أَيَّامَ  التَّشْرِيقِ :  إِنَّ هَذِهِ أَيَّامُ أَكْلٍ  وَشُرْبٍ  وَنِكَاحٍ  .  قُلْتُ :  عَمْرُو بْنُ الْحُصَيْنِ  ضَعِيفٌ  .","","Al-Matalib al-Aliyah 1099","","زيد بن خالد الجهني عن عبيد الله بن عبد الله بن عتبة بن مسعود عن عبد الله بن الفضل بن العباس الهاشمي عن إسحاق بن يحيى بن الوليد بن عبادة بن الصامت عن موسى بن عقبة عن فضيل بن سليمان النميري عن عمرو بن الحصين العقيلي عن أبو يعلى الموصلي","باب النهي عن صيام أيام التشريق"
"1351","[6/193]      32 - بَابُ النَّهْيِ عَنْ صَوْمِ يَوْمِ الْجُمُعَةِ  1100  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنْ  قَيْسِ بْنِ السَّكَنِ قَالَ :  إِنَّ أُنَاسًا مِنْ أَصْحَابِ  عَبْدِ اللهِ  أَتَوْا أَبَا الدَّرْدَاءِ رَضِيَ اللهُ عَنْهُ فِي يَوْمِ الْجُمُعَةِ وَهُمْ صِيَامٌ ،  فَقَالَ  :  إِنَّ هَذَا يَوْمُ عِيدٍ ، فَأُقْسِمُ عَلَيْكُمْ أَنْ تُفْطِرُوا  .         [6/194]","","Al-Matalib al-Aliyah 1100","","أبو الدرداء عن قيس بن السكن السوائى عن عبد العزيز بن رفيع الطائفي عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد","باب النهي عن صوم يوم الجمعة"
"1352","[6/195]      1101  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  حَفْصٌ ،  عَنْ  لَيْثٍ ،  عَنْ  عُمَيْرِ بْنِ أَبِي عُمَيْرٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  مَا رُئِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُفْطِرًا يَوْمَ الْجُمُعَةِ قَطُّ  .         [6/196]","","Al-Matalib al-Aliyah 1101","","عبد الله بن عمر بن الخطاب عن عمير بن أبي عمير عن ليث بن أبي سليم عن حفص بن غياث النخعي عن مسدد بن مسرهد","باب النهي عن صوم يوم الجمعة"
"1353","[6/197]      33 - بَابُ صَوْمِ ثَلَاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ  1102  / 1  -  قَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَأَلَهُ عَنِ الصِّيَامِ ، فَشُغِلَ عَنْهُ ، فَقَالَ لَهُ  ابْنُ مَسْعُودٍ  رَضِيَ اللهُ عَنْهُ : صُمْ رَمَضَانَ ، وَثَلَاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ ، فَقَالَ الرَّجُلُ : أَعُوذُ بِاللهِ مِنْكَ يَا  عَبْدَ اللهِ  ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  وَمَا تَبْغِي ؟ صُمْ رَمَضَانَ ، وَثَلَاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ  .  هَذَا  إِسْنَادٌ حَسَنٌ  .         [6/198]","","Al-Matalib al-Aliyah 1102","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن إبراهيم بن مهاجر بن جابر البجلي عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن أبو بكر ابن أبي شيبة","باب صوم ثلاثة أيام من كل شهر"
"1354","1102  / 2  - رَوَاهُ الْبَزَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ ، بِهِ .  وَقَالَ : لَا نَعْلَمُ  أَسْنَدَ  إِبْرَاهِيمُ  ، عَنْ  أَبِي الزُّبَيْرِ  ، عَنْ  جَابِرٍ  رَضِيَ اللهُ عَنْهُ ، إِلَّا هَذَا  .","","Al-Matalib al-Aliyah 1102","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن إبراهيم بن مهاجر بن جابر البجلي عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","باب صوم ثلاثة أيام من كل شهر"
"1355","[6/199]      1103  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  حُمَيْدٍ الْأَعْرَجِ ،  عَنْ  مُجَاهِدٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَوْمُ رَمَضَانَ ، وَثَلَاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ يُذْهِبُ  وَغَرَ  الصَّدْرِ  ، قَالُوا : يَا رَسُولَ اللهِ ، وَمَا  وَغَرُ  الصَّدْرِ ؟ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَلَمُهُ وَغِلُّهُ  .","","Al-Matalib al-Aliyah 1103","","مجاهد بن جبر المخزومي عن حميد بن قيس الأعرج عن عبد الوارث بن سعيد بن ذكوان عن مسدد بن مسرهد","باب صوم ثلاثة أيام من كل شهر"
"1356","[6/200]      1104  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  يَزِيدُ ،  ثَنَا  فَرَجُ بْنُ فَضَالَةَ ،  ثَنَا  أَبُو هُبَيْرَةَ ،  عَنْ  صَدَقَةَ قَالَ :  إِنَّ  رَجُلًا  سَأَلَ ابْنَ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، عَنِ الصَّوْمِ ، فَقَالَ : إِنْ كُنْتَ تُرِيدُ صِيَامَ خَيْرِ الْبَشَرِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْأُمِّيِّ الْعَرَبِيِّ الْقُرَشِيِّ  أَبِي الْقَاسِمِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَإِنَّهُ  كَانَ يَصُومُ ثَلَاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ وَيَقُولُ : هِيَ صِيَامُ الدَّهْرِ  . صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .         [6/201]             [6/202]","","Al-Matalib al-Aliyah 1104","","عبد الله بن عباس عن صدقة الدمشقي عن أبو هرم عن فرج بن فضالة بن النعمان التنوخي عن يزيد بن هارون عن أحمد بن منيع البغوي","باب صوم ثلاثة أيام من كل شهر"
"1357","[6/203]      1105  / 1  -  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  عَبْدُ الْوَهَّابِ بْنُ عَطَاءٍ ،  ثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  يَزِيدَ بْنِ الْحَوْتَكِيَّةِ قَالَ :  إِنَّ  عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ سُئِلَ عَنِ الْأَرْنَبِ ، فَقَالَ : مَنْ شَهِدَ مِنْكُمُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ أَتَاهُ  الْأَعْرَابِيُّ  الرَّجُلُ ؟ فَقَالَ رَجُلٌ مِنَ الْقَوْمِ : جَاءَ بِهَا الْأَعْرَابِيُّ ، وَقَدْ تَطَيَّبَهَا وَصَنَعَهَا وَأَهْدَاهَا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : رَأَيْتُهَا  تَدْمَى  ، أَيْ تَحِيضُ ، ثُمَّ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِلْقَوْمِ : كُلُوا . فَلَمْ يَأْكُلِ الْأَعْرَابِيُّ ، فَقَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مَنَعَكَ أَنْ تَأْكُلَ؟ قَالَ : إِنِّي صَائِمٌ قَالَ : فَهَلَّا الْبِيضَ ؟  .  هَكَذَا رَوَاهُ  الْحَجَّاجُ  ، وَهُوَ  مُدَلِّسٌ  .         [6/204]             [6/205]      1105  / 2  - وَقَدْ رَوَاهُ  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ  ،  وَحَكِيمُ بْنُ جُبَيْرٍ  ، عَنْ  مُوسَى بْنِ طَلْحَةَ  ، عَنِ  ابْنِ الْحَوْتَكِيَّةِ  ، عَنْ  أَبِي ذَرٍّ  رَضِيَ اللهُ عَنْهُ ، وَبَيَّنَ أَنَّ الرَّجُلَ الْمَذْكُورَ الَّذِي حَدَّثَ بِهَذَا الْحَدِيثِ هُوَ  أَبُو ذَرٍّ  رَضِيَ اللهُ عَنْهُ .         [6/206]             [6/207]      1105  / 3  - وَرَوَاهُ  أَبُو حَنِيفَةَ  عَنِ  الْهَيْثَمِ الصَّوَّافِ  ، عَنْ  مُوسَى  ، عَنْ  يَزِيدَ بْنِ الْحَوْتَكِيَّةِ  ، عَنْ  عُمَرَ  .  وَرُوِيَ عَنْ  مُوسَى بْنِ طَلْحَةَ  ، عَنْ  أَبِي هُرَيْرَةَ  .","","Al-Matalib al-Aliyah 1105","","أحد الصحابة عن يزيد بن الحوتكية التميمي عن موسى بن طلحة بن عبيد الله التيمي عن حجاج بن أرطاة عن هشام الدستوائي عن عبد الوهاب بن عطاء الخفاف عن الحارث بن محمد بن أبي أسامة","باب صوم ثلاثة أيام من كل شهر"
"1358","[6/208]      1106  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ، قَالَ :  سَمِعْتُ  مُوسَى بْنَ سَلَمَةَ ، قَالَ :  سَأَلْتُ  ابْنَ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا عَنْ صِيَامِ ثَلَاثَةِ أَيَّامِ  الْبِيضِ  ؟  فَقَالَ : كَانَ عُمَرُ رَضِيَ اللهُ عَنْهُ يَصُومُهُنَّ  .","","Al-Matalib al-Aliyah 1106","","عمر بن الخطاب عن عبد الله بن عباس عن موسى بن سلمة بن المحبق الهذلي عن قتادة بن دعامة عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن الحارث بن محمد بن أبي أسامة","باب صوم ثلاثة أيام من كل شهر"
"1359","[6/209]      1107  / 1  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَوْمُ شَهْرِ الصَّبْرِ وَثَلَاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ صَوْمُ الدَّهْرِ  ، وَيُذْهِبُ  وَحَرَ  الصَّدْرِ  .","","Al-Matalib al-Aliyah 1107","","علي بن أبي طالب عن الحارث الأعور عن أبو إسحاق السبيعي عن حجاج بن أرطاة عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","باب صوم ثلاثة أيام من كل شهر"
"1360","1107  / 2  - وَقَالَ الْبَزَّارُ :  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  ثَنَا  حَمَّادٌ بِهِ .  وَحَجَّاجٌ  فِيهِ ضَعْفٌ  .  1107  / 3  - لَكِنْ  تَابَعَهُ  يُونُسُ بْنُ أَبِي إِسْحَاقَ  . أَخْرَجَهُ  الْبَزَّارُ  أَيْضًا  .         [6/210]","","Al-Matalib al-Aliyah 1107","","علي بن أبي طالب عن الحارث الأعور عن أبو إسحاق السبيعي عن حجاج بن أرطاة عن حماد بن سلمة عن عبد الواحد بن غياث عن البزار","باب صوم ثلاثة أيام من كل شهر"
"1361","[6/211]      1108  وَقَالَ أَبُو دَاوُدَ الطَّيَالِسِيُّ :  حَدَّثَنَا  حَمَّادُ بْنُ يَزِيدَ بْنِ مُسْلِمٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ قُرَّةَ الْمُزَنِيُّ ،  عَنْ  كَهْمَسٍ الْهِلَالِيِّ ، أَنَّهُ حَدَّثَهُ ، فَذَكَرَ حَدِيثًا طَوِيلًا ، وَفِيهِ قَالَ  كَهْمَسٌ  :  إِنِّي أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَخْبَرْتُهُ بِإِسْلَامِي ، ثُمَّ غِبْتُ عَنْهُ حَوْلًا ، ثُمَّ أَتَيْتُهُ ، فَقُلْتُ : يَا رَسُولَ اللهِ كَأَنَّكَ تَعْرِفُنِي ؟ قَالَ : أَجَلْ . فَقُلْتُ : يَا رَسُولَ اللهِ ، مَا أَفْطَرْتُ مُنْذُ فَارَقْتُكَ ، قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَمَرَكَ أَنْ تُعَذِّبَ نَفْسَكَ ؟ صُمْ يَوْمًا مِنَ  الشَّهْرِ  ، قُلْتُ : زِدْنِي ، قَالَ : صُمْ يَوْمَيْنِ . قُلْتُ : زِدْنِي ، قَالَ : صُمْ ثَلَاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ  .         [6/212]","","Al-Matalib al-Aliyah 1108","","كهمس الهلالي عن معاوية بن قرة عن حماد بن يزيد بن مسلم المقرئ عن أبو داود الطيالسي","باب صوم ثلاثة أيام من كل شهر"
"1362","[6/213]      34 - بَابُ تَعْيِينِ الثَّلَاثَةِ الْمَذْكُورَةِ  1109  قَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَارِجَةَ ،  ثَنَا  شِهَابُ بْنُ خِرَاشٍ ،  عَنْ  صَالِحِ بْنِ جَبَلَةَ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنْ  أَبِي أُمَامَةَ رَضِيَ اللهُ عَنْهُ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ صَامَ الْأَرْبِعَاءَ ، وَالْخَمِيسَ ، وَالْجُمُعَةَ  ، بَنَى اللهُ تَعَالَى لَهُ بَيْتًا فِي الْجَنَّةِ يُرَى ظَاهِرُهُ مِنْ بَاطِنِهِ ، وَبَاطِنُهُ مِنْ ظَاهِرِهِ  .         [6/214]             [6/215]","","Al-Matalib al-Aliyah 1109","","أبو أمامة الباهلي عن ميمون بن مهران الرقي عن صالح بن جبلة عن شهاب بن خراش الحوشبي عن الهيثم بن خارجة الخراساني عن أحمد بن منيع البغوي","باب تعيين الثلاثة المذكورة"
"1363","1110  - وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  سُوَيْدٌ ،  ثَنَا  بَقِيَّةُ ،  عَنْ  أَبِي بَكْرٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ زَيْدٍ ،  عَنْ  حَنَشٍ الصَّنْعَانِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، نَحْوَهُ .  وَسَيَأْتِي حَدِيثُ  ابْنِ عَبَّاسٍ  وَابْنِ عُمَرَ         [6/216]","","Al-Matalib al-Aliyah 1110","","عبد الله بن عباس عن حنش بن عبد الله السبائي عن محمد بن زياد الألهاني عن أبو بكر الغساني عن بقية بن الوليد عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","باب تعيين الثلاثة المذكورة"
"1364","1111  -  وَعَنْ  بَقِيَّةَ ،  عَنْ  أَبِي بَكْرٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، بِهِ .","","Al-Matalib al-Aliyah 1111","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن أبو بكر الغساني عن بقية بن الوليد عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","باب تعيين الثلاثة المذكورة"
"1365","[6/217]      35 - بَابُ صَوْمِ يَوْمٍ وَإِفْطَارِ يَوْمٍ  1112  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  بِشْرِ بْنِ حَرْبٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ رَضِيَ اللهُ عَنْهُ قَالَ :  إِنَّ  رَجُلًا  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : أَصُومُ الدَّهْرَ ؟ فَنَهَاهُ ، وَعَاوَدَهُ فَنَهَاهُ ، ثَلَاثَ مَرَّاتٍ :  وَلَكِنْ صَوْمَ  دَاوُدَ  ; صُمْ يَوْمًا ، وَأَفْطِرْ يَوْمًا  ; فَإِنَّ ذَلِكَ صَوْمُ  دَاوُدَ  عَلَيْهِ السَّلَامُ . فَمَا زَالَ ذَلِكَ الرَّجُلُ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا حَتَّى مَاتَ  .","","Al-Matalib al-Aliyah 1112","","أبو سعيد الخدري عن بشر بن حرب عن حماد بن زيد عن مسدد بن مسرهد","باب صوم يوم وإفطار يوم"
"1366","[6/218]      1113  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  يَزِيدُ ،  ثَنَا  فَرَجُ بْنُ فَضَالَةَ ،  ثَنَا  أَبُو هُبَيْرَةَ ،  عَنْ  صَدَقَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ أَفْضَلَ الصِّيَامِ صِيَامُ أَخِي  دَاوُدَ  ، كَانَ  يَصُومُ  نِصْفَ الدَّهْرِ ، يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا .","","Al-Matalib al-Aliyah 1113","","عبد الله بن عباس عن صدقة الدمشقي عن عبد الله بن هبيرة السبئي عن فرج بن فضالة بن النعمان التنوخي عن يزيد بن هارون عن أحمد بن منيع البغوي","باب صوم يوم وإفطار يوم"
"1367","[6/219]      1114  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  شَيْبَانُ ،  ثَنَا  أَبُو هِلَالٍ ،  ثَنَا  غَيْلَانُ بْنُ جَرِيرٍ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ مَعْبَدٍ الزِّمَّانِيُّ ،  عَنْ  عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ ، قَالَ :  كُنَّا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِذْ أَتَى عَلَى  رَجُلٍ  ، فَقَالُوا : مَا أَفْطَرَ مُنْذُ كَذَا وَكَذَا . فَقَالَ : لَا صَامَ وَلَا أَفْطَرَ ، فَلَمَّا رَأَى  عُمَرُ  رَضِيَ اللهُ عَنْهُ غَضَبَهُ قَالَ : يَا رَسُولَ اللهِ ، صَوْمُ يَوْمَيْنِ وَإِفْطَارُ يَوْمٍ ؟ قَالَ : أَوَ يُطِيقُ ذَلِكَ أَحَدٌ ؟ قَالَ : يَا رَسُولَ اللهِ صَوْمُ يَوْمٍ ، وَإِفْطَارُ يَوْمٍ ؟ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ذَاكَ صَوْمُ أَخِي  دَاوُدَ  ، قَالَ : يَا رَسُولَ اللهِ صَوْمُ يَوْمٍ وَإِفْطَارُ يَوْمَيْنِ ؟ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : وَمَنْ يُطِيقُ ذَلِكَ ؟ قَالَ : يَا رَسُولَ اللهِ ، صَوْمُ يَوْمِ الِاثْنَيْنِ ؟ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ذَاكَ يَوْمٌ وُلِدْتُ فِيهِ ، وَيَوْمٌ أُنْزِلَ عَلَيَّ فِيهِ النُّبُوَّةُ قَالَ : يَا رَسُولَ اللهِ ، صَوْمُ عَرَفَةَ ، وَيَوْمِ عَاشُورَاءَ ؟ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَحَدُهُمَا يُكَفِّرُ سَنَةً ، وَالْآخَرُ يُكَفِّرُ مَا قَبْلَهَا وَمَا بَعْدَهَا  .  قُلْتُ : الْمَحْفُوظُ بِهَذَا  الْإِسْنَادِ  : عَنْ  عَبْدِ اللهِ بْنِ مَعْبَدٍ  ، عَنْ  أَبِي قَتَادَةَ  بِطُولِهِ ، أَخْرَجَهُ مِنْ ذَلِكَ الْوَجْهِ  مُسْلِمٌ  وَأَصْحَابُ السُّنَنِ  .         [6/220]","","Al-Matalib al-Aliyah 1114","","عمر بن الخطاب عن عبد الله بن معبد الزماني عن غيلان بن جرير المعولي عن محمد بن سليم الراسبي عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","باب صوم يوم وإفطار يوم"
"1368","[6/221]      36 - بَابُ لَيْلَةِ الْقَدْرِ  ( 42 ) حَدِيثُ فَضْلِ شُهُودِ لَيْلَةِ الْقَدْرِ عِنْدَ  الْحَجَرِ الْأَسْوَدِ  يَأْتِي إِنْ شَاءَ اللهُ تَعَالَى فِي أَوَّلِ فَضَائِلِ  الْجِهَادِ  .  1115  / 1  -  قَالَ إِسْحَاقُ :  أَخْبَرَنَا  الْمُغِيرَةُ بْنُ سَلَمَةَ الْمَخْزُومِيُّ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  ثَنَا  عَاصِمُ بْنُ كُلَيْبٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  خَالِي الْفَلَتَانِ بْنِ عَاصِمٍ الْجَرْمِيِّ ، قَالَ :  كُنَّا قُعُودًا نَنْتَظِرُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَاءَنَا وَفِي وَجْهِهِ الْغَضَبُ حَتَّى جَلَسَ ، ثُمَّ رَأَيْنَا وَجْهَهُ يُسْفِرُ ، فَقَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّهُ بُيِّنَتْ لِي لَيْلَةُ الْقَدْرِ  وَمَسِيحُ الضَّلَالَةِ  ، فَخَرَجْتُ لِأُبَيِّنَهَا لَكُمْ ، فَلَقِيتُ  بِسُدَّةِ  الْمَسْجِدِ رَجُلَيْنِ  يَتَلَاحَيَانِ ، أَوْ قَالَ : يَقْتَتِلَانِ  ، مَعَهُمَا الشَّيْطَانُ ، فَحَجَزْتُ بَيْنَهُمَا ، فَأُنْسِيتُهَا ، وَسَأَشْدُو لَكُمْ مِنْهُمَا شَدْوًا ، أَمَّا لَيْلَةُ الْقَدْرِ ، فَالْتَمِسُوهَا فِي الْعَشْرِ الْأَوَاخِرِ  وِتْرًا  ، وَأَمَّا مَسِيحُ الضَّلَالَةِ فَرَجُلٌ  أَجْلَى  الْجَبْهَةِ ، مَمْسُوحُ الْعَيْنِ ، عَرِيضُ النَّحْرِ ،  كَأَنَّهُ  فُلَانُ بْنُ عَبْدِ الْعُزَّى  ، أَوْ  عَبْدُ الْعُزَّى بْنُ قَطَنٍ  .         [6/222]","","Al-Matalib al-Aliyah 1115","","الفلتان بن عاصم الجرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن عبد الواحد بن زياد عن المغيرة بن سلمة المخزومي عن إسحاق ابن راهويه","باب ليلة القدر"
"1369","[6/223]      1115  / 2  -  وَقَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  خَالِهِ الْفَلَتَانِ بْنِ عَاصِمٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنِّي رَأَيْتُ لَيْلَةَ الْقَدْرِ ، ثُمَّ أُنْسِيتُهَا ، وَرَأَيْتُ مَسِيحَ الضَّلَالَةِ  ، وَرَأَيْتُ رَجُلَيْنِ يَتَلَاحَيَانِ ، فَحَجَزْتُ بَيْنَهُمَا ، فَأُنْسِيتُهُمَا . فَأَمَّا لَيْلَةُ الْقَدْرِ فَاطْلُبُوهَا فِي الْعَشْرِ الْأَوَاخِرِ ، وَأَمَّا  مَسِيحُ الضَّلَالَةِ  ، فَرَجُلٌ  أَجْلَى  الْجَبْهَةِ ، مَمْسُوحُ الْعَيْنِ الْيُسْرَى ، عَرِيضُ النَّحْرِ ، فِيهِ دَمًا ،  كَأَنَّهُ  فُلَانُ بْنُ عَبْدِ الْعُزَّى  ، أَوْ  عَبْدُ الْعُزَّى بْنُ فُلَانٍ  .","","Al-Matalib al-Aliyah 1115","","الفلتان بن عاصم الجرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن عبد الله بن إدريس الأودي عن أبو بكر ابن أبي شيبة","باب ليلة القدر"
"1370","[6/224]      1115  / 3  -  حَدَّثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْفَلَتَانِ ،  مُخْتَصَرًا  :  مَنْ كَانَ مِنْكُمْ مُلْتَمِسًا لَيْلَةَ الْقَدْرِ ، فَلْيَلْتَمِسْهَا فِي الْعَشْرِ الْأَوَاخِرِ  .         [6/225]             [6/226]","","Al-Matalib al-Aliyah 1115","","الفلتان بن عاصم الجرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن زائدة بن قدامة عن الحسين بن علي الجعفي عن أبو بكر ابن أبي شيبة","باب ليلة القدر"
"1371","[6/227]      1116  قَالَ  أَبِي  :  فَحَدَّثْتُ بِهِ  ابْنَ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، فَقَالَ : وَمَا أَعْجَبَكَ مِنْ ذَلِكَ ، كَانَ عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ إِذَا دُعِيَ الْأَشْيَاخُ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دَعَانِي مَعَهُمْ ، وَقَالَ : لَا تَتَكَلَّمْ حَتَّى يَتَكَلَّمُوا ، فَدَعَانَا  ذَاتَ يَوْمٍ ، أَوْ ذَاتَ لَيْلَةٍ  ، فَقَالَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ فِي لَيْلَةِ الْقَدْرِ مَا قَدْ عَلِمْتُمُ :  الْتَمِسُوهَا فِي الْعَشْرِ الْأَوَاخِرِ  وِتْرًا  . أَيُّ  الْوِتْرِ  هِيَ ؟ فَقَالَ رَجُلٌ بِرَأْيِهِ : تَاسِعَةٌ ، سَابِعَةٌ ، خَامِسَةٌ ، ثَالِثَةٌ . فَقَالَ لِي : مَا لَكَ لَا تَتَكَلَّمُ يَا  ابْنَ عَبَّاسٍ  ؟ فَقُلْتُ : يَا أَمِيرَ الْمُؤْمِنِينَ ، إِنْ شِئْتَ تَكَلَّمْتُ ، فَقَالَ : مَا دَعَوْتُكَ إِلَّا لِتَتَكَلَّمَ . قَالَ : إِنَّمَا أَقُولُ بِرَأْيِي ، قَالَ : عَنْ رَأْيِكَ أَسْأَلُ . فَقُلْتُ : إِنِّي سَمِعْتُ اللهَ تَعَالَى أَكْثَرَ ذِكْرَ السَّبْعِ ، فَذَكَرَ السَّمَاوَاتِ سَبْعًا ، وَالْأَرَضِينَ سَبْعًا ، حَتَّى قَالَ فِيمَا قَالَ : وَمَا أَنْبَتَتِ الْأَرْضُ سَبْعًا ، فَقَالَ : كُلُّ مَا قَدْ قُلْتَ عَرَفْتُهُ غَيْرَ هَذَا ، مَا تَعْنِي بِقَوْلِكَ : وَمَا أَنْبَتَتِ الْأَرْضُ سَبْعًا ؟ فَقَالَ : إِنَّ اللهَ تَعَالَى يَقُولُ :         {      ثُمَّ شَقَقْنَا الأَرْضَ شَقًّا             *          فَأَنْبَتْنَا فِيهَا حَبًّا             *          وَعِنَبًا وَقَضْبًا             *          وَزَيْتُونًا وَنَخْلا             *          وَحَدَائِقَ غُلْبًا             *          وَفَاكِهَةً  وَأَبًّا             *          مَتَاعًا لَكُمْ         }      ، فَالْحَدَائِقُ كُلُّ مُلْتَفٍّ  حَدِيقَةٌ  ،  وَالْأَبُّ  مَا أَنْبَتَتِ الْأَرْضُ مِمَّا لَا يَأْكُلُ النَّاسُ . فَقَالَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ : أَعَجَزْتُمْ أَنْ تَقُولُوا مِثْلَ مَا قَالَ هَذَا الْغُلَامُ الَّذِي لَمْ يَسْتَوِ سِوَى رَأْسِهِ . ثُمَّ قَالَ لِي : إِنِّي كُنْتُ نَهَيْتُكَ أَنْ تَتَكَلَّمَ مَعَهُمْ ، فَإِذَا دَعَوْتُكَ ، فَتَكَلَّمْ مَعَهُمْ  .  قُلْتُ : رَوَى  أَحْمَدُ  حَدِيثَ  عُمَرَ  الْمَرْفُوعَ  مِنْهُ حَسْبُ  .         [6/228]             [6/229]","","Al-Matalib al-Aliyah 1116","","عمر بن الخطاب عن عبد الله بن عباس عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن زائدة بن قدامة عن الحسين بن علي الجعفي عن أبو بكر ابن أبي شيبة","باب ليلة القدر"
"1372","[6/230]      1117  / 1  -  وَقَالَ إِسْحَاقُ :  أَخْبَرَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  ثَنَا  عِكْرِمَةُ بْنُ عَمَّارٍ ،  عَنْ  أَبِي زُمَيْلٍ سِمَاكٍ الْحَنَفِيِّ ،  ثَنَا  مَالِكُ بْنُ مَرْثَدٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  قُلْتُ  لِأَبِي ذَرٍّ رَضِيَ اللهُ عَنْهُ :  هَلْ سَمِعْتَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَذْكُرُ لَيْلَةَ الْقَدْرِ ؟ فَقَالَ : نَعَمْ ، قُلْتُ : يَا رَسُولَ اللهِ ، أَخْبِرْنِي عَنْ لَيْلَةِ الْقَدْرِ ، أَفِي رَمَضَانَ أَمْ فِي غَيْرِ رَمَضَانَ ؟ فَقَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : بَلْ فِي رَمَضَانَ . قُلْتُ : يَا رَسُولَ اللهِ ، أَهِيَ مَعَ الْأَنْبِيَاءِ مَا كَانُوا ، فَإِذَا قُبِضَ الْأَنْبِيَاءُ رُفِعَتْ ، أَمْ هِيَ إِلَى يَوْمِ الْقِيَامَةِ ؟ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لَا بَلْ هِيَ إِلَى يَوْمِ الْقِيَامَةِ . قُلْتُ : يَا رَسُولَ اللهِ ، أَخْبِرْنِي فِي أَيِّ رَمَضَانَ هِيَ ؟ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : فِي الْعَشْرِ الْأَوَاخِرِ ، لَا تَسْأَلْنِي عَنْ شَيْءٍ بَعْدَهَا ، قُلْتُ : يَا رَسُولَ اللهِ ، أَقْسَمْتُ عَلَيْكَ بِحَقِّي ، فِي أَيِّ الْعَشْرِ هِيَ ؟ ، فَغَضِبَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَيَّ غَضَبًا مَا غَضِبَ عَلَيَّ قَبْلَهُ وَلَا بَعْدَهُ مِثْلَهُ ، وَقَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ شَاءَ اللهُ لَأَطْلَعَكَ عَلَيْهَا ، الْتَمِسُوهَا فِي السَّبْعِ الْأَوَاخِرِ  ، لَا تَسْأَلْنِي عَنْ شَيْءٍ بَعْدَهَا  .","","Al-Matalib al-Aliyah 1117","","أبو ذر الغفاري عن مرثد بن عبد الله الزماني عن مالك بن مرثد الزماني عن سماك بن الوليد اليمامي عن عكرمة بن عمار عن أبو عامر العقدي عن إسحاق ابن راهويه","باب ليلة القدر"
"1373","[6/231]      1117  / 2  -  قَالَ إِسْحَاقُ :  أَخْبَرَنَا  أَبُو دَاوُدَ الْحَفَرِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  مَرْثَدٍ أَوِ ابْنِ مَرْثَدٍ  ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنْتُ عِنْدَ أَبِي ذَرٍّ رَضِيَ اللهُ عَنْهُ ،  فَسُئِلَ  عَنْ لَيْلَةِ الْقَدْرِ ، فَذَكَرَ نَحْوَهُ إِلَى قَوْلِهِ :  الْعَشْرِ الْأَوَاخِرِ  ، وَلَمْ يَذْكُرْ مَا بَعْدَهُ  .  قُلْتُ :  هَذَا  إِسْنَادٌ حَسَنٌ صَحِيحٌ  .  وَرَوَاهُ  أَحْمَدُ  ،  وَالنَّسَائِيُّ  مِنْ حَدِيثِ  أَبِي زُمَيْلٍ  أَيْضًا ، وَلَيْسَ بِتَمَامِهِ  .         [6/232]","","Al-Matalib al-Aliyah 1117","","أبو ذر الغفاري عن مرثد بن عبد الله الزماني عن مالك بن مرثد الزماني عن أبو عمرو الأوزاعي عن سفيان الثوري عن عمر بن سعد بن عبيد الحفري عن إسحاق ابن راهويه","باب ليلة القدر"
"1374","1117  / 3  -  وَقَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  مَرْثَدِ بْنِ أَبِي مَرْثَدٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنْتُ مَعَ أَبِي ذَرٍّ رَضِيَ اللهُ عَنْهُ ، فَذَكَرَهُ ، وَزَادَ فِيهِ : قُلْتُ : يَا رَسُولَ اللهِ ، فَأَخْبِرْنَا بِهَا ؟ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ أُذِنَ لِي فِيهَا لَأَخْبَرْتُكُمْ بِهَا  .         [6/233]","","Al-Matalib al-Aliyah 1117","","أبو ذر الغفاري عن مرثد بن عبد الله الزماني عن مالك بن مرثد الزماني عن أبو عمرو الأوزاعي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة","باب ليلة القدر"
"1375","1117  / 4  - وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  عِكْرِمَةَ بْنِ عَمَّارٍ ،  حَدَّثَنِي  أَبُو زُمَيْلٍ سِمَاكٌ الْحَنَفِيُّ  ، ثَنَا  مَالِكُ بْنُ مَرْثَدٍ ،  حَدَّثَنِي  أَبِي مَرْثَدٌ قَالَ :  سَأَلْتُ  أَبَا ذَرٍّ رَضِيَ اللهُ عَنْهُ ، فَذَكَرَ نَحْوَهُ .         [6/234]","","Al-Matalib al-Aliyah 1117","","أبو ذر الغفاري عن مرثد بن عبد الله الزماني عن مالك بن مرثد الزماني عن سماك بن الوليد اليمامي عن عكرمة بن عمار عن يحيى القطان عن مسدد بن مسرهد","باب ليلة القدر"
"1376","[6/235]      1118  / 1  -  وَقَالَ إِسْحَاقُ :  أَخْبَرَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنْ  أَبِي حَازِمٍ مَوْلَى هُذَيْلٍ قَالَ :  جَاوَرْتُ فِي  مَسْجِدِ الْمَدِينَةِ  مَعَ  رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ  بَنِي بَيَاضَةَ  فِي الْعَشْرِ الْأَوَاخِرِ مِنْ رَمَضَانَ فِي  قُبَّةٍ  لَهُ يُسْتَرُ عَلَى بَابِهَا بِقِطْعَةِ حَصِيرٍ ، قَالَ : فَبَيْنَمَا نَحْنُ فِي الْمَسْجِدِ وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  قُبَّةٍ  لَهُ ، إِذْ رَفَعَ الْحَصِيرَ عَنِ الْبَابِ ، وَأَشَارَ إِلَى مَنْ فِي الْمَسْجِدِ : أَنِ اجْتَمِعُوا ، فَاجْتَمَعْنَا ، فَوَعَظَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَوْعِظَةً لَمْ أَسْمَعْ وَاعِظًا مِثْلَهَا ، فَقَالَ :  إِنَّ أَحَدَكُمْ إِذَا قَامَ يُصَلِّي ، فَإِنَّهُ يُنَاجِي رَبَّهُ تَبَارَكَ وَتَعَالَى  ، فَلْيَنْظُرْ بِمَ يُنَاجِيهِ ، وَلَا يَجْهَرْ بَعْضُكُمْ عَلَى بَعْضٍ بِالْقُرْآنِ . ثُمَّ رَدَّ الْحَصِيرَ وَرَجَعَ كُلُّ وَاحِدٍ مِنَّا إِلَى مَوْضِعِهِ . فَقَالَ بَعْضُنَا لِبَعْضٍ : إِنَّ لِهَذِهِ اللَّيْلَةِ لَشَأْنًا ، وَعَظَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيهَا ، فَإِذَا هِيَ لَيْلَةُ ثَلَاثٍ وَعِشْرِينَ  .  قُلْتُ : جَعَلَهُ  إِسْحَاقُ  مِنْ مُسْنَدِ  أَبِي حَازِمٍ مَوْلَى بَنِي هُذَيْلٍ  .  1118  / 2  - وَقَدْ رَوَاهُ  النَّسَائِيُّ  فِي الِاعْتِكَافِ مِنْ طُرُقٍ أَكْثَرُهَا مِنْ رِوَايَةِ  أَبِي حَازِمٍ  عَنِ  الْبَيَاضِيِّ  .         [6/236]             [6/237]             [6/238]      1118  / 3  - وَرَوَى  الْإِمَامُ أَحْمَدُ  قِصَّةَ النَّهْيِ عَنِ الْجَهْرِ بِالْقِرَاءَةِ مِنْ طَرِيقِ  مَالِكٍ  ، عَنْ  يَحْيَى بْنِ سَعِيدٍ  ، عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ  ، عَنْ  أَبِي حَازِمٍ  ، عَنِ  الْبَيَاضِيِّ  .  وَاخْتُلِفَ فِي  أَبِي حَازِمٍ  هَذَا ، فَفِي أَكْثَرِ الرِّوَايَاتِ أَنَّهُ  مَوْلَى بَنِي غِفَارٍ ، وَاسْمُهُ دِينَارٌ  ، وَفِي هَذِهِ الرِّوَايَةِ ، أَنَّهُ مَوْلَى  بَنِي هُذَيْلٍ  .  وَاللهُ أَعْلَمُ  .         [6/239]","","Al-Matalib al-Aliyah 1118","","دينار مولى أبي رهم الغفاري عن محمد بن إبراهيم بن الحارث التيمي عن محمد بن إسحاق عن عبدة بن سليمان الكلابي عن إسحاق ابن راهويه","باب ليلة القدر"
"1377","[6/240]      1119  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  عَبْدُ اللهِ هُوَ ابْنُ دَاوُدَ ،  عَنْ  فِطْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَرِيكٍ ،  عَنْ  سُوَيْدِ بْنِ غَفَلَةَ ، وَزِرِّ بْنِ حُبَيْشٍ ،  عَنْ  أُبَيِّ بْنِ كَعْبٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  لَيْلَةُ الْقَدْرِ لَيْلَةُ سَبْعٍ وَعِشْرِينَ  .         [6/241]","","Al-Matalib al-Aliyah 1119","","أبي بن كعب عن زر بن حبيش الثعلبي عن عبد الله بن شريك العامري عن فطر بن خليفة عن عبد الله بن داود الخريبي عن مسدد بن مسرهد","باب ليلة القدر"
"1378","[6/242]      1120  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  حُسَيْنٌ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  حَوْطٍ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ رَضِيَ اللهُ عَنْهُ ، قَالَ :  لَيْلَةُ الْقَدْرِ لَيْلَةُ سَبْعَ عَشْرَةَ : يَوْمَ الْفُرْقَانِ يَوْمَ الْتَقَى الْجَمْعَانِ  ، فَمَا أَشُكُّ ، وَلَا اسْتُثْنِيَ  .         [6/243]","","Al-Matalib al-Aliyah 1120","","زيد بن أرقم الأنصاري عن حوط العبدي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الحسين بن محمد بن بهرام المروذي عن أحمد بن منيع البغوي","باب ليلة القدر"
"1379","[6/244]      1121  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  كَثِيرُ بْنُ هِشَامٍ ،  ثَنَا  جَعْفَرُ بْنُ بُرْقَانَ ، قَالَ :  سَمِعْتُ  رَجُلًا مِنْ قُرَيْشٍ ، يَقُولُ : كَانَ عَبْدُ اللهِ بْنُ الزُّبَيْرِ رَضِيَ اللهُ عَنْهُمَا يَقُولُ :  هِيَ اللَّيْلَةُ الَّتِي لَقِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي يَوْمِهَا  أَهْلَ بَدْرٍ  . قَالَ : يَقُولُ اللهُ عَزَّ وَجَلَّ :         {      وَمَا أَنْـزَلْنَا عَلَى عَبْدِنَا يَوْمَ الْفُرْقَانِ يَوْمَ الْتَقَى الْجَمْعَانِ         }      .  قَالَ  جَعْفَرٌ :  بَلَغَنِي أَنَّهَا لَيْلَةُ سِتَّ عَشْرَةَ ، أَوْ سَبْعَ عَشْرَةَ  .","","Al-Matalib al-Aliyah 1121","","عبد الله بن الزبير عن رجل من قريش عن جعفر بن برقان الكلابي عن كثير بن هشام الكلابي عن الحارث بن محمد بن أبي أسامة","باب ليلة القدر"
"1380","[6/245]      1122  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  ثَنَا  حُدَيْجُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي حُذَيْفَةَ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  رَأَيْتُ الْقَمَرَ لَيْلَةَ الْقَدْرِ كَأَنَّهُ شِقُّ جَفْنَةٍ  .         [6/246]","","Al-Matalib al-Aliyah 1122","","علي بن أبي طالب عن سلمة بن صهيب الأرحبي عن أبو إسحاق السبيعي عن حديج بن معاوية بن حديج  الجعفي عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","باب ليلة القدر"
"1381","[6/247]      1123  وَقَالَ أَيْضًا :  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنِ  الْأَعْمَشِ ،  أُخْبِرْتُ عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ لَيْلَةٍ ، وَهُوَ يُرِيدُ أَنْ يُخْبِرَنَا بِلَيْلَةِ الْقَدْرِ  ، وَقَدْ أُخْبِرْنَا بِهِ ، فَسَمِعَ لَغَطًا فِي الْمَسْجِدِ ، فَاخْتُلِسَتْ مِنْهُ  .","","Al-Matalib al-Aliyah 1123","","أنس بن مالك عن الأعمش عن حماد بن أسامة القرشي عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","باب ليلة القدر"
"1382","[6/248]      1124  وَقَالَ :  حَدَّثَنَا  أَبُو الْوَلِيدِ الْقُرَشِيُّ ،  ثَنَا  الْوَلِيدُ هُوَ ابْنُ مُسْلِمٍ ،  أَخْبَرَنِي  سَالِمٌ ،  أَنَّهُ سَمِعَ  مُحَمَّدَ بْنَ عَمْرِو بْنِ عُثْمَانَ  يُحَدِّثُ عَنْ  أَنَسِ بْنِ مَالِكٍ رَضِيَ اللهُ عَنْهُ قَالَ :  إِنَّ  الْجُهَنِيَّ  قَالَ : يَا رَسُولَ اللهِ ، نَحْنُ غَيْبٌ قَدْ عَلِمْتَ ، وَلَا نَسْتَطِيعُ أَنْ نَحْضُرَ هَذَا  الشَّهْرَ  ، فَأَخْبِرْنَا بِلَيْلَةِ الْقَدْرِ ؟ قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، هَذِهِ لَيْلَةُ ثَلَاثٍ وَعِشْرِينَ ، وَهِيَ لِثَمَانٍ يَبْقَيْنَ ؟ قَالَ :  كَلَّا ، هَذَا  الشَّهْرُ  يَنْقُصُ ، وَهِيَ لِسَبْعٍ يَبْقَيْنَ  .","","Al-Matalib al-Aliyah 1124","","أنس بن مالك عن محمد بن عمرو بن عثمان عن سالم بن عبد الله الخياط عن الوليد بن مسلم القرشي عن أحمد بن عبد الرحمن بن بكار البسري عن أبو يعلى الموصلي","باب ليلة القدر"
"1383","[6/249]      37 - بَابُ الِاعْتِكَافِ  1125  قَالَ الْحَارِثُ :  حَدَّثَنَا  أَشْهَلُ ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  مُحَمَّدٍ ، قَالَ :  سَأَلَ رَجُلٌ  شُرَيْحًا  عَنِ امْرَأَةٍ نَذَرَتْ أَنْ تَعْتَكِفَ رَجَبَ ذَلِكَ الْعَامِ فِي الْمَسْجِدِ ، قَالَ : وَكَانَ  زِيَادٌ أَوِ ابْنُ زِيَادٍ  نَهَى النِّسَاءَ أَنْ يَعْتَكِفْنَ فِي الْمَسْجِدِ قَالَ :  فَقَالَ  شُرَيْحٌ :  إِنِّي لَا أَقُولُ إِنَّهُ فِي كِتَابٍ مُنَزَّلٍ ، وَلَا فِي سُنَّةٍ مَاضِيَةٍ ، إِنَّمَا هُوَ رَأْيٌ ; تَصُومُ رَجَبَ ذَلِكَ الْعَامِ  ، فَإِذَا أَفْطَرَتْ أَفْطَرَ مَعَهَا كُلُّ يَوْمٍ مِسْكِينٌ ، أَوْ أَطْعَمَتْ كُلَّ لَيْلَةٍ مِسْكِينًا ،  نُسُكَانِ  بِنُسُكٍ  وَاحِدٍ ، يَفْعَلُ اللهُ مَا يَشَاءُ  .  هَذَا  إِسْنَادٌ صَحِيحٌ  ، وَهُوَ  مَوْقُوفٌ  عَلَى  شُرَيْحٍ  .         [6/250]","","Al-Matalib al-Aliyah 1125","","شريح بن الحارث الكندي عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن أشهل بن حاتم عن الحارث بن محمد بن أبي أسامة","باب الاعتكاف"
"1384","[6/251]      1126  وَقَالَ إِسْحَاقُ :  أَنَا  النَّضْرُ هُوَ ابْنُ شُمَيْلٍ ،  ثَنَا  حَمَّادٌ وَهُوَ ابْنُ سَلَمَةَ ،  حَدَّثَنِي  قَتَادَةُ ،  أَنَّ  صَفِيَّةَ  اعْتَكَفَتْ ، فَمَرِضَ بَعْضُ أَهْلِهَا ، فَاسْتَأْذَنَتْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ تَعُودَهُ ، فَقَالَ :  خُذِي بِعِضَادَتَيِ الْبَابِ وَلَا تَدْخُلِي  .  هَذَا  مُرْسَلٌ  ، أَوْ  مُعْضَلٌ  ، رِجَالُهُ ثِقَاتٌ  .         [6/252]","","Al-Matalib al-Aliyah 1126","","قتادة بن دعامة عن حماد بن سلمة عن النضر بن شميل عن إسحاق ابن راهويه","باب الاعتكاف"
"1385","[6/253]      12 - كِتَابُ  الْحَجِّ  1 - بَابُ مُبْتَدَأِ فَرْضِ  الْحَجِّ  1127  قَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  قَابُوسَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  لَمَّا فَرَغَ  إِبْرَاهِيمُ  عَلَيْهِ السَّلَامُ مِنْ بِنَاءِ  الْبَيْتِ  قَالَ لَهُ : أَذِّنْ فِي النَّاسِ بِالْحَجِّ  ، قَالَ : وَمَا يَبْلُغُ صَوْتِي ؟ قِيلَ : أَذِّنْ وَعَلَيَّ  الْبَلَاغُ  ، فَنَادَى  إِبْرَاهِيمُ  ، يَا أَيُّهَا النَّاسُ ، كُتِبَ عَلَيْكُمُ  الْحَجُّ  إِلَى الْبَيْتِ الْعَتِيقِ ، فَسَمِعَهُ مَنْ بَيْنَ السَّمَاءِ وَالْأَرْضِ ، أَلَا تَرَى أَنَّ النَّاسَ يَحُجُّونَ مِنْ أَقْطَارِ الْأَرْضِ يُلَبُّونَ  .         [6/254]","","Al-Matalib al-Aliyah 1127","","عبد الله بن عباس عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن جرير بن عبد الحميد عن أحمد بن منيع البغوي","باب مبتدأ فرض الحج"
"1386","[6/257]      4 - بَابُ الْأَمْرِ بِتَعْجِيلِ  الْحَجِّ  1128  قَالَ الْحَارِثُ :  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ الْحِمَّانِيُّ ،  ثَنَا  حُصَيْنُ بْنُ عُمَرَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنِ  الْحَارِثِ بْنِ سُوَيْدٍ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، قَالَ :  حُجُّوا ، فَكَأَنِّي أَنْظُرُ إِلَى حَبَشِيٍّ  أَصْمَعَ  ، بِيَدِهِ  مِعْوَلٌ  يَنْقُضُهَا حَجَرًا حَجَرًا . قُلْنَا  لِعَلِيٍّ  رَضِيَ اللهُ عَنْهُ : أَبِرَأْيِكَ ؟ قَالَ : لَا ، وَالَّذِي  فَلَقَ  الْحَبَّةَ  وَبَرَأَ  النَّسَمَةَ ،  وَلَكِنْ سَمِعْتُهُ مِنْ نَبِيِّكُمْ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .         [6/258]             [6/259]","","Al-Matalib al-Aliyah 1128","","علي بن أبي طالب عن الحارث بن سويد الأعور عن إبراهيم بن يزيد بن شريك التيمي عن الأعمش عن حصين بن عمر بن الفرات الأحمسي عن يحيى بن عبد الحميد عن الحارث بن محمد بن أبي أسامة","باب الأمر بتعجيل الحج"
"1387","[6/260]      1129  وَقَالَ أَبُو بَكْرٍ ، وَأَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  جَرِيرٌ ،  ثَنَا  مَنْصُورٌ ،  عَنْ  كِلَابِ بْنِ عَلِيٍّ ،  عَنْ  مَنْصُورِ بْنِ سُلَيْمَانَ  ،  عَنِ  ابْنِ أَخِي جُبَيْرِ بْنِ مُطْعِمٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا صَرُورَةَ فِي الْإِسْلَامِ  .  كذا في طبعة دار العاصمة ، والذي في مصنف ابن أبي شيبة (منصور بن أبي سليمان). وهو الموافق للترجمة.","","Al-Matalib al-Aliyah 1129","","ابن أخي جبير بن مطعم عن منصور بن أبى سليمان عن كلاب بن علي الجعفري عن منصور بن المعتمر عن جرير بن عبد الحميد عن أبو بكر ابن أبي شيبة","باب الأمر بتعجيل الحج"
"1388","[6/261]      5 - بَابُ فَضْلِ مَنْ خَلَفَ الْحَاجَّ فِي أَهْلِهِ بِخَيْرٍ  1130  قَالَ الْحَارِثُ :  حَدَّثَنَا  دَاوُدُ بْنُ الْمُحَبَّرِ ،  ثَنَا  مَيْسَرَةُ بْنُ عَبْدِ رَبِّهِ ،  عَنْ  أَبِي عَائِشَةَ السَّعْدِيِّ ،  عَنْ  يَزِيدَ بْنِ عُمَرَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي هُرَيْرَةَ ، وَابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمْ ، قَالَا :  خَطَبَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ الْحَدِيثَ ، وَفِيهِ :  وَمَنَ خَلَفَ حَاجًّا أَوْ مُعْتَمِرًا فِي أَهْلِهِ بِخَيْرٍ كَانَ لَهُ مِثْلُ أَجْرِهِ كَامِلًا  مِنْ غَيْرِ أَنْ يَنْقُصَ مِنْ أَجْرِهِ شَيْءٌ  .","","Al-Matalib al-Aliyah 1130","","عبد الله بن عباس عن أبو سلمة بن عبد الرحمن عن يزيد بن عمر بن عبد العزيز بن مروان عن أبو عائشة السعدي عن ميسرة بن عبد ربه التراس عن داود بن المحبر البكراوي عن الحارث بن محمد بن أبي أسامة","باب فضل من خلف الحاج في أهله بخير"
"1389","[6/262]      6 - بَابُ فَضْلِ الْحَاجِّ  ( 45 ) حَدِيثُ  أَبِي هُرَيْرَةَ  : مَنْ خَرَجَ حَاجًّا فَمَاتَ ، يَأْتِي فِي فَضْلِ  الْجِهَادِ  إِنْ شَاءَ اللهُ تَعَالَى .  1131  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  عَطَّافُ بْنُ خَالِدٍ ،  حَدَّثَنِي  إِسْمَاعِيلُ بْنُ رَافِعٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ صَاحِبِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كُنْتُ جَالِسًا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  مَسْجِدِ الْخَيْفِ  ، فَأَتَاهُ  رَجُلٌ مِنَ الْأَنْصَارِ  ،  وَرَجُلٌ مِنْ ثَقِيفَ  ، فَلَمَّا سَلَّمَا قَالَا : جِئْنَاكَ يَا رَسُولَ اللهِ نَسْأَلُكَ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ شِئْتُمَا أَخْبَرْتُكُمَا بِمَا تَسْأَلَانِي عَنْهُ فَعَلْتُ  ، وَإِنْ شِئْتُمَا أَنْ أَسْكُتَ وَتَسْأَلَانِي فَعَلْتُ . قَالَا : أَخْبِرْنَا يَا رَسُولَ اللهِ  نَزْدَدْ إِيمَانًا ، أَوْ نَزْدَدْ يَقِينًا . شَكَّ  إِسْمَاعِيلُ  ، فَقَالَ الْأَنْصَارِيُّ لِلثَّقَفِيِّ : سَلْ ، قَالَ : بَلْ أَنْتَ فَسَلْهُ ; فَإِنِّي لَأَعْرِفُ لَكَ حَقَّكَ ، فَسَلْهُ ، فَقَالَ الْأَنْصَارِيُّ : أَخْبِرْنَا يَا رَسُولَ اللهِ ؟ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : جِئْتَنِي تَسْأَلُنِي عَنْ مَخْرَجِكَ مِنْ بَيْتِكَ تَؤُمُّ  الْبَيْتَ الْحَرَامَ  ، وَمَا لَكَ فِيهِ ؟ وَعَنْ طَوَافِكَ بِالْبَيْتِ ، وَمَا لَكَ فِيهِ ؟ وَعَنْ رَكْعَتَيْكَ بَعْدَ الطَّوَافِ وَمَا لَكَ فِيهِمَا ؟ وَعَنْ طَوَافِكَ  بِالصَّفَا  وَالْمَرْوَةِ  وَمَا لَكَ فِيهِ ؟ وَعَنْ وُقُوفِكَ  بِعَرَفَةَ  وَمَا لَكَ فِيهِ ؟ وَعَنْ رَمْيِكَ الْجِمَارَ وَمَا لَكَ فِيهِ ؟ وَعَنْ نَحْرِكَ وَمَا لَكَ فِيهِ ؟ وَعَنْ حِلَاقِكَ رَأْسَكَ وَمَا لَكَ فِيهِ ؟ وَعَنْ طَوَافِكَ بَعْدَ ذَلِكَ وَمَا لَكَ فِيهِ ؟ . قَالَ : وَالَّذِي بَعَثَكَ بِالْحَقِّ ، لَعَنْ هَذَا جِئْتُ أَسْأَلُكَ ، قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : فَإِنَّكَ إِذَا خَرَجْتَ مِنْ         [6/263]      بَيْتِكَ تَؤُمُّ  الْبَيْتَ الْحَرَامَ  ، لَمْ تَضَعْ نَاقَتُكَ خُفًّا وَلَمْ تَرْفَعْهُ إِلَّا كَتَبَ اللهُ تَعَالَى لَكَ بِهِ حَسَنَةً ، وَمَحَا عَنْكَ بِهِ خَطِيئَةً ، وَرَفَعَ لَكَ بِهَا دَرَجَةً ، وَأَمَّا طَوَافُكَ  بِالْبَيْتِ  ، وَأَمَّا رَكْعَتَاكَ بَعْدَ الطَّوَافِ فَإِنَّهَا كَعِتْقِ رَقَبَةٍ مِنْ بَنِي  إِسْمَاعِيلَ  ، وَأَمَّا طَوَافُكَ  بِالصَّفَا  وَالْمَرْوَةِ  فَكَعِتْقِ سَبْعِينَ رَقَبَةً ، وَأَمَّا وُقُوفُكَ عَشِيَّةَ عَرَفَةَ ، فَإِنَّ اللهَ تَعَالَى يَهْبِطُ إِلَى السَّمَاءِ الدُّنْيَا  فَيُبَاهِي  بِكُمُ الْمَلَائِكَةَ ، يَقُولُ : هَؤُلَاءِ عِبَادِي جَاؤُونِي شُعْثًا غُبْرًا مِنْ كُلِّ  فَجٍّ  عَمِيقٍ ، يَرْجُونَ رَحْمَتِي وَمَغْفِرَتِي ، فَلَوْ كَانَتْ ذُنُوبُكُمْ عَدَدَ الرَّمْلِ ، أَوْ كَزَبَدِ الْبَحْرِ لَغَفَرْتُهَا ، أَفِيضُوا عِبَادِي مَغْفُورًا لَكُمْ ، وَلِمَنْ شَفَعْتُمْ لَهُ ، وَأَمَّا رَمْيُكَ الْجِمَارَ فَلَكَ بِكُلِّ حَصَاةٍ رَمَيْتَهَا كَبِيرَةٌ مِنَ الْكَبَائِرِ  الْمُوبِقَاتِ  الْمُوجِبَاتِ ، وَأَمَّا نَحْرُكَ فَمَدْخُورٌ لَكَ عِنْدَ رَبِّكَ ، وَأَمَّا حِلَاقُ رَأْسِكَ فَبِكُلِّ شَعَرَةٍ حَلَقْتَهَا حَسَنَةٌ ، وَتُمْحَى عَنْكَ بِهَا خَطِيئَةٌ . قَالَ : يَا رَسُولَ اللهِ ، فَإِنْ كَانَتِ الذُّنُوبُ أَقَلَّ مِنْ ذَلِكَ ؟ قَالَ : إِذًا  تُدَّخَرُ  لَكَ فِي حَسَنَاتِكَ ، وَأَمَّا طَوَافُكَ بِالْبَيْتِ بَعْدَ ذَلِكَ ، فَإِنَّكَ تَطُوفُ وَلَا ذَنْبَ لَكَ ، يَأْتِي مَلَكٌ حَتَّى يَضَعَ يَدَهُ بَيْنَ كَتِفَيْكَ ، ثُمَّ يَقُولُ : اعْمَلْ لِمَا تُسْتَقْبَلُ فَقَدْ غُفِرَ لَكَ مَا مَضَى  . فَذَكَرَ بَقِيَّةَ الْحَدِيثِ .  ( 46 )  وَقَدْ تَقَدَّمَ فِي الصَّلَاةِ  .         [6/264]             [6/265]","","Al-Matalib al-Aliyah 1131","","أنس بن مالك عن إسماعيل بن رافع بن عويمر المزني عن عطاف بن خالد المخزومي عن مسدد بن مسرهد","باب فضل الحاج"
"1390","[6/266]      1132  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  دَاوُدُ بْنُ الْمُحَبَّرِ ،  ثَنَا  مَيْسَرَةُ بْنُ عَبْدِ رَبِّهِ ،  عَنْ  أَبِي عَائِشَةَ السَّعْدِيِّ ،  عَنْ  يَزِيدَ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، وَابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمْ ، قَالَا :  خَطَبَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَ حَدِيثًا طَوِيلًا ، وَفِيهِ :  وَمَنْ خَرَجَ حَاجًّا أَوْ مُعْتَمِرًا فَلَهُ بِكُلِّ خُطْوَةٍ حَتَّى يَرْجِعَ أَلْفُ أَلْفِ حَسَنَةٍ  ، وَمَحْوُ أَلْفِ أَلْفِ سَيِّئَةٍ ، وَرَفْعُ أَلْفِ أَلْفِ دَرَجَةٍ ، وَلَهُ عِنْدَ رَبِّهِ بِكُلِّ دِرْهَمٍ يُنْفِقُهُ أَلْفُ أَلْفِ دِرْهَمٍ ، وَبِكُلِّ دِينَارٍ أَلْفُ أَلْفِ دِينَارٍ ، وَلَهُ بِكُلِّ حَسَنَةٍ يَعْمَلُهَا أَلْفُ أَلْفِ حَسَنَةٍ ، حَتَّى يَرْجِعَ وَهُوَ فِي ضَمَانِ اللهِ تَعَالَى ، فَإِنْ تَوَفَّاهُ أَدْخَلَهُ الْجَنَّةَ ، وَإِنْ رَجَعَهُ رَجَعَهُ مَغْفُورًا لَهُ ، مُسْتَجَابًا لَهُ ، فَاغْتَنِمُوا دَعْوَتَهُ إِذَا قَدِمَ قَبْلَ أَنْ يُصِيبَ الذُّنُوبَ ; فَإِنَّهُ يَشْفَعُ فِي مِائَةِ أَلْفِ رَجُلٍ يَوْمَ الْقِيَامَةِ  .  هَذَا حَدِيثٌ مَوْضُوعٌ  .","","Al-Matalib al-Aliyah 1132","","عبد الله بن عباس عن أبو سلمة بن عبد الرحمن عن يزيد بن عمر بن عبد العزيز بن مروان عن أبو عائشة السعدي عن ميسرة بن عبد ربه التراس عن داود بن المحبر البكراوي عن الحارث بن محمد بن أبي أسامة","باب فضل الحاج"
"1391","[6/267]      7 - بَابُ حَرَمِ  مَكَّةَ  1133  قَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو عُبَيْدَةَ بْنُ فُضَيْلِ بْنِ عِيَاضٍ ،  ثَنَا  مَالِكُ بْنُ سُعَيْرٍ ،  ثَنَا  فُرَاتُ بْنُ الْأَحْنَفِ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّهُ قَامَ فِي بَابٍ دَاخِلٍ مِنْهُ إِلَى الْمَسْجِدِ  مَسْجِدِ مِنًى  ، فَحَمِدَ اللهَ تَعَالَى ، وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ : إِنْ هَؤُلَاءِ إِلَّا أَعْبُدُ الْكُفَّارِ الْفُسَّاقِ ، قَدْ عَسِرُوا عَلَى أَنْ يَأْتُوا فِي كُلِّ عَامٍ ، فَيَسْرِقُوا أَمْوَالَنَا ، وَيُوثِقُوا رِقَاقَنَا ، وَإِنَّ اللهَ تَعَالَى قَدْ أَحَلَّ دِمَاءَهُمْ وَأَمْوَالَهُمْ بِمَا اسْتَحَلُّوا مِنْ دِمَائِنَا وَأَمْوَالِنَا ، يَعْنِي  نَجْدَةَ الْخَارِجِيَّ  وَأَصْحَابَهُ ، وَإِنِّي بَعَثْتُ إِلَيْهِمْ فَأُعْطُوا مَا سُئِلُوا ، فَهَذِهِ الرِّقَاقُ ، وَهَذِهِ الرِّحَالُ ، مَيِّزُوهَا ، فَمَا عَرَفْتُمْ فَخُذُوهُ . وَلَكِنِّي لَا أَرَى مِنَ الرَّأْيِ أَنْ يُهَرَاقَ فِي حَرَمِ اللهِ تَعَالَى دَمٌ  ، إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ فِي  حَجَّةِ الْوَدَاعِ  : أَيُّ بَلَدٍ أَحْرَمُ ؟ قِيلَ :  مَكَّةُ  قَالَ : أَيُّ شَهْرٍ أَحْرَمُ ؟ قِيلَ : ذُو الْحِجَّةِ . قَالَ : أَيُّ يَوْمٍ أَحْرَمُ ؟ قِيلَ : يَوْمُ  الْحَجِّ  الْأَكْبَرِ  . قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ دِمَاءَكُمْ وَأَمْوَالَكُمْ حَرَامٌ عَلَيْكُمْ إِلَى أَنْ تَبْلُغُوا رَبَّكُمْ  ،  كَحُرْمَةِ  يَوْمِكُمْ هَذَا فِي بَلَدِكُمْ هَذَا ، فِي شَهْرِكُمْ هَذَا  .         [6/268]             [6/269]             [6/270]             [6/271]","","Al-Matalib al-Aliyah 1133","","عبد الله بن الزبير عن الأحنف أبو بحر الهلالي عن الفرات بن أحنف الهلالى عن مالك بن سعير التميمي عن أبو عبيدة بن الفضيل بن عياض عن أبو يعلى الموصلي","باب حرم مكة"
"1392","[6/272]      1134  / 1  -  وَقَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  ثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  حَدَّثَنِي  صَدَقَةُ بْنُ يَسَارٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  خَطَبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَ الْحَدِيثَ قَالَ :  أَيُّهَا النَّاسُ ، إِنَّ الزَّمَانَ قَدِ  اسْتَدَارَ  ، فَهُوَ الْيَوْمَ كَهَيْئَةِ يَوْمِ خَلَقَ اللهُ السَّمَاوَاتِ وَالْأَرْضَ ، وَإِنَّ عِدَّةَ الشُّهُورِ عِنْدَ اللهِ اثْنَا عَشَرَ شَهْرًا فِي كِتَابِ اللهِ عَزَّ وَجَلَّ مِنْهَا أَرْبَعَةٌ حُرُمٌ :  رَجَبُ  مُضَرَ بَيْنَ جُمَادَى وَشَعْبَانَ ، وَذُو الْقَعْدَةِ ، وَذُو الْحَجَّةِ ، وَالْمُحَرَّمُ ، وَإِنَّ النَّسِيءَ زِيَادَةٌ فِي الْكُفْرِ يُضَلُّ بِهِ الَّذِينَ كَفَرُوا إِلَى : مَا حَرَّمَ اللهُ ، ذَلِكَ أَنَّهُمْ كَانُوا يَجْعَلُونَ صَفَرًا عَامًا حَلَالًا وَعَامًا حَرَامًا ، وَكَذَا الْمُحَرَّمُ ، وَذَلِكَ النَّسِيءُ مِنَ الشَّيْطَانِ - الْحَدِيثَ ... وَفِيهِ : أَيُّ يَوْمٍ هَذَا ؟ قَالُوا : يَوْمٌ حَرَامٌ قَالَ : أَيُّ شَهْرٍ هَذَا ؟ قَالُوا : شَهْرٌ حَرَامٌ ؟ قَالَ : أَيُّ بَلَدٍ هَذَا ؟ قَالُوا : بَلَدٌ حَرَامٌ ، قَالَ : فَإِنَّ اللهَ تَعَالَى قَدْ حَرَّمَ عَلَيْكُمْ دِمَاءَكُمْ وَأَمْوَالَكُمْ ،  وَأَعْرَاضَكُمْ  ،  كَحُرْمَةِ  هَذَا الْيَوْمِ فِي هَذَا  الشَّهْرِ  ، أَلَا لَا نَبِيَّ بَعْدِي ، وَلَا أُمَّةَ بَعْدَكُمْ ، أَلَا فَلْيُبَلِّغْ شَاهِدُكُمْ غَائِبَكُمْ . ثُمَّ رَفَعَ يَدَيْهِ فَقَالَ : اللَّهُمَّ اشْهَدِ ، اللَّهُمَّ اشْهَدِ . ثَلَاثَ مَرَّاتٍ  .         [6/273]             [6/274]      ( 47 ) وَسَيَأْتِي ذِكْرُهُ إِنْ شَاءَ اللهُ تَعَالَى فِي بَابِ تَحْرِيمِ الدَّمِ مِنْ كِتَابِ الْحُدُودِ مَعَ بَقِيَّةٍ مِنْ طُرُقِ هَذَا الْحَدِيثِ ، وَبَعْضُهَا فِي بَابِ الْخُطْبَةِ  بِمِنًى  .","","Al-Matalib al-Aliyah 1134","","عبد الله بن عمر بن الخطاب عن صدقة بن يسار الجزري عن موسى بن عبيدة بن نشيط الحميري عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة","باب حرم مكة"
"1393","1134  / 2  - وَقَالَ عَبْدُ بْنُ حُمَيْدٍ :  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، فَذَكَرَهُ بِطُولِهِ .  1134  / 3  - وَأَخْرَجَهُ  أَبُو يَعْلَى  مِنْ وَجْهٍ آخَرَ ، عَنْ مُوسَى .","","Al-Matalib al-Aliyah 1134","","عبد الله بن عمر بن الخطاب عن صدقة بن يسار الجزري عن موسى بن عبيدة بن نشيط الحميري عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة عن عبد بن حميد","باب حرم مكة"
"1394","[6/275]      8 - بَابُ فَضْلِ  الْحَجِّ  مَاشِيًا  1135  / 1  - قَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ سُلَيْمٍ الطَّائِفِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ الطَّائِفِيُّ ،  عَنْ  مَنْ  حَدَّثَهُ ، عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  قَالَ لِبَنِيهِ :  اخْرُجُوا طَائِعِينَ مِنْ  مَكَّةَ  مُشَاةً  ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ لِلْحَاجِّ الرَّاكِبِ بِكُلِّ خُطْوَةٍ تَخْطُوهَا رَاحِلَتُهُ سَبْعِينَ حَسَنَةً  ، وَلِلْمَاشِي بِكُلِّ خُطْوَةٍ يَخْطُوهَا سَبْعَمِائَةِ حَسَنَةٍ مِنْ حَسَنَاتِ الْحَرَمِ . قِيلَ : يَا رَسُولَ اللهِ ، وَمَا حَسَنَاتُ الْحَرَمِ ؟ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : الْحَسَنَةُ بِمِائَةِ أَلْفٍ  .  1135  / 2  -  تَابَعَهُ  عِيسَى بْنُ سَوَادَةَ  ، عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ  ، عَنْ  زَاذَانَ  ، عَنِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا . أَخْرَجَهُ  ابْنُ خُزَيْمَةَ  ،  وَالْحَاكِمُ  مِنْ طَرِيقِهِ ،  وَقَالَ  الْبَيْهَقِيُّ  :  عِيسَى  مَجْهُولٌ  .         [6/276]             [6/277]             [6/278]             [6/279]             [6/280]","","Al-Matalib al-Aliyah 1135","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن من عن محمد بن مسلم بن سوسن الطائفي عن يحيى بن سليم الطائفي عن مجاهد بن موسى عن أبو يعلى الموصلي","باب فضل الحج ماشيا"
"1395","[6/281]      9 - بَابُ فَضْلِ الْمُتَابَعَةِ بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ  1136  قَالَ الْحَارِثُ :  حَدَّثَنَا  دَاوُدُ بْنُ الْمُحَبَّرِ ،  ثَنَا  عَبَّادٌ  عَنْ  سُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَابِعُوا بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ  ، فَوَالَّذِي نَفْسِي بِيَدِهِ إِنَّهُمَا يَنْفِيَانِ الْفَقْرَ وَالذُّنُوبَ ، كَمَا يَنْفِي  الْكِيرُ  خَبَثَ  الْحَدِيدِ  .         [6/282]","","Al-Matalib al-Aliyah 1136","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن عباد بن كثير الكاهلي عن داود بن المحبر البكراوي عن الحارث بن محمد بن أبي أسامة","باب فضل المتابعة بين الحج والعمرة"
"1396","[6/283]      1137  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  هَوْذَةُ ،  حَدَّثَنَا  دَاوُدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنٍ لِعَبْدِ اللهِ بْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  تَابِعُوا بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ  ، الْحَدِيثَ  .         [6/284]","","Al-Matalib al-Aliyah 1137","","ابن لعبد الله بن عمر عن عمرو بن دينار الأثرم عن داود ابن النصراني عن هوذة بن خليفة البكراوي عن الحارث بن محمد بن أبي أسامة","باب فضل المتابعة بين الحج والعمرة"
"1397","[6/285]      10 - بَابُ رُكُوبِ الْبَحْرِ لِلْحَاجِّ  1138  قَالَ الْحَارِثُ :  حَدَّثَنَا  الْخَلِيلُ بْنُ زَكَرِيَّا ،  ثَنَا  حَبِيبُ بْنُ الشَّهِيدِ ،  عَنِ  الْحَسَنِ بْنِ أَبِي الْحَسَنِ ،  عَنْ  أَبِي بَكْرَةَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَرْكَبُ الْبَحْرَ إِلَّا غَازٍ  ، أَوْ حَاجٌّ ، أَوْ مُعْتَمِرٌ  .         [6/286]","","Al-Matalib al-Aliyah 1138","","أبو بكرة الثقفي عن الحسن البصري عن حبيب بن الشهيد عن الخليل بن زكريا الشيباني عن الحارث بن محمد بن أبي أسامة","باب ركوب البحر للحاج"
"1398","[6/287]      11 - بَابُ النَّدْبِ إِلَى  الْحَجِّ  كُلَّ خَمْسَةِ أَعْوَامٍ  1139  / 1  -  قَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  خَلَفُ بْنُ خَلِيفَةَ ،  عَنِ  الْعَلَاءِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي سَعِيدٍ رَضِيَ اللهُ عَنْهُ قَالَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : إِنَّ اللهَ عَزَّ وَجَلَّ يَقُولُ :  إِنَّ عَبْدًا أَصْحَحْتُ لَهُ جِسْمَهُ  ، وَأَوْسَعْتُ عَلَيْهِ فِي الْمَعِيشَةِ ، تَمْضِي عَلَيْهِ خَمْسَةُ أَعْوَامٍ لَا يَفِدُ إِلَيَّ لَمَحْرُومٌ .","","Al-Matalib al-Aliyah 1139","","أبو سعيد الخدري عن المسيب بن رافع الكاهلي عن علاء بن المسيب عن خلف بن خليفة الأشجعي عن أبو بكر ابن أبي شيبة","باب الندب إلى الحج كل خمسة أعوام"
"1399","1139  / 2  - وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو بَكْرٍ ، بِهَذَا .         [6/288]             [6/289]      1139  / 3  - وَقَالَ عَبْدُ الرَّزَّاقِ :  أَخْبَرَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنِ  الْعَلَاءِ بْنِ الْمُسَيِّبِ  بِهِ  .  قُلْتُ : اخْتُلِفَ فِيهِ عَلَى  الْعَلَاءِ  .","","Al-Matalib al-Aliyah 1139","","أبو سعيد الخدري عن المسيب بن رافع الكاهلي عن علاء بن المسيب عن خلف بن خليفة الأشجعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","باب الندب إلى الحج كل خمسة أعوام"
"1400","[6/290]      1140  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو عُبَيْدَةَ بْنُ الْفُضَيْلِ بْنِ عِيَاضٍ ،  ثَنَا  أَبُو سَعِيدٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  يُونُسَ بْنِ خَبَّابٍ ،  عَنْ  رَجُلٍ ،  عَنْ  خَبَّابِ بْنِ الْأَرَتِّ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّ اللهَ عَزَّ وَجَلَّ يَقُولُ :  إِنَّ عَبْدًا أَصْحَحْتُ لَهُ جِسْمَهُ  ، وَأَوْسَعْتُ عَلَيْهِ فِي الرِّزْقِ ، يَأْتِي عَلَيْهِ خَمْسُ حِجَجٍ لَمْ يَأْتِ إِلَيَّ فِيهِنَّ لَمَحْرُومٌ  .","","Al-Matalib al-Aliyah 1140","","خباب بن الأرت التميمي عن رجل عن يونس بن خباب الأسيدي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن أبو سعيد عن أبو عبيدة بن الفضيل بن عياض عن أبو يعلى الموصلي","باب الندب إلى الحج كل خمسة أعوام"
"1401","[6/291]      12 - بَابُ الْأَمْرِ بِحَجِّ الذَّرَارِي وَالرَّقِيقِ  وَوُجُوبِهِ عَلَيْهِمْ إِذَا بَلَغُوا  1141  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  سَلِيمِ بْنِ حَيَّانَ ،  حَدَّثَنِي  مُوسَى بْنُ قَطَنٍ ،  عَنْ  آمِنَةَ بِنْتِ مُحْرِزٍ قَالَتْ :  سَمِعْتُ  عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ ، يَقُولُ :  أَحِجُّوا الذُّرِّيَّةَ  ، لَا تَأْكُلُوا أَرْزَاقَهَا وَتَدَعُوا آثَامَهَا فِي أَعْنَاقِهَا  .         [6/292]","","Al-Matalib al-Aliyah 1141","","عمر بن الخطاب عن آمنة بنت محرز عن موسى بن قطن عن سليم بن حيان بن بسطام الهذلي عن يحيى القطان عن مسدد بن مسرهد","باب الأمر بحج الذراري والرقيق ووجوبه عليهم إذا بلغوا"
"1402","[6/293]      1142  وَقَالَ الْحُمَيْدِيُّ وَابْنُ أَبِي عُمَرَ جَمِيعًا :  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ عُقْبَةَ ، أَخُو  مُوسَى بْنِ عُقْبَةَ  ، فَذَكَرَ حَدِيثًا  فِي حَجِّ الصَّبِيِّ  قَالَ : فَحَدَّثْتُ بِهِ ابْنَ الْمُنْكَدِرِ ، فَحَجَّ بِأَهْلِهِ كُلِّهِمْ  .","","Al-Matalib al-Aliyah 1142","","محمد بن المنكدر عن إبراهيم بن عقبة بن أبي عياش المطرقي عن سفيان بن عيينة عن الحميدي","باب الأمر بحج الذراري والرقيق ووجوبه عليهم إذا بلغوا"
"1403","[6/294]      1143  وَقَالَ الْحُمَيْدِيُّ :  حَدَّثَنَا  سُفْيَانُ ،  أَخْبَرَنِي  الْمُنْكَدِرُ بْنُ مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ قِيلَ لَهُ : أَتَحُجُّ بِالصِّبْيَانِ ؟ فَقَالَ : نَعَمْ ، أَعْرِضُهُمْ لِلهِ تَعَالَى  .","","Al-Matalib al-Aliyah 1143","","محمد بن المنكدر عن المنكدر بن محمد بن المنكدر القرشي عن سفيان بن عيينة عن الحميدي","باب الأمر بحج الذراري والرقيق ووجوبه عليهم إذا بلغوا"
"1404","[6/295]      1144  وَقَالَ الْحَارِثُ :  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي إِسْمَاعِيلَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  أَبِي عَتِيقٍ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ قَالَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَوْ أَنَّ مَمْلُوكًا حَجَّ عَشْرَ حِجَجٍ  ، كَانَتْ عَلَيْهِ حَجَّةٌ إِنِ اسْتَطَاعَ إِلَيْهِ سَبِيلًا ، وَلَوْ أَنَّ أَعْرَابِيًّا حَجَّ عَشْرَ حِجَجٍ ، كَانَتْ عَلَيْهِ حَجَّةٌ إِذَا هَاجَرَ إِنِ اسْتَطَاعَ إِلَيْهِ سَبِيلًا ، وَلَوْ أَنَّ صَغِيرًا حَجَّ عَشْرَ حِجَجٍ ، كَانَتْ عَلَيْهِ حِجَّةُ الْإِسْلَامِ إِذَا عَقَلَ ، إِنِ اسْتَطَاعَ إِلَيْهِ سَبِيلًا  .         [6/296]","","Al-Matalib al-Aliyah 1144","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن جابر السلمي عن حرام بن عثمان الأنصاري عن إسماعيل بن عياش الأحول عن إسماعيل بن أبي إسماعيل المؤدب عن الحارث بن محمد بن أبي أسامة","باب الأمر بحج الذراري والرقيق ووجوبه عليهم إذا بلغوا"
"1405","[6/297]      13 - بَابُ كَرَاهَةِ  الْحَجِّ  عَلَى الْإِبِلِ  الْجَلَّالَةِ  1145  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ ،  عَنْ  أَبِيهِ  :  قَدِمَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ  مَكَّةَ  ، فَأُخْبِرَ أَنَّ  لِمَوْلًى لِعَمْرِو بْنِ الْعَاصِ  إِبِلًا  جَلَّالَةً  ، فَأَرْسَلَ إِلَيْهَا ، فَأَخْرَجَهَا مِنْ  مَكَّةَ  ، وَقَالَ : إِبِلٌ يُحْتَطَبُ عَلَيْهَا ، وَيُنْقَلُ عَلَيْهَا الْمَاءُ .  فَقَالَ  عُمَرُ رَضِيَ اللهُ عَنْهُ : لَا يُحَجُّ عَلَيْهَا ، وَلَا يُعْتَمَرُ  .  إِسْنَادُهُ صَحِيحٌ  ، وَهُوَ  مَوْقُوفٌ  .         [6/298]","","Al-Matalib al-Aliyah 1145","","عمر بن الخطاب عن أبو يزيد مولى آل قارظ عن عبيد الله بن أبي يزيد الكناني عن سفيان بن عيينة عن مسدد بن مسرهد","باب كراهة الحج على الإبل الجلالة"
"1406","[6/299]      1146  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  عَبْدُ الْوَارِثِ ،  ثَنَا  أَيُّوبُ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  نُهِيَ عَنْ رُكُوبِ  الْجَلَّالَةِ  .         [6/300]","","Al-Matalib al-Aliyah 1146","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن عبد الوارث بن سعيد بن ذكوان عن مسدد بن مسرهد","باب كراهة الحج على الإبل الجلالة"
"1407","[6/301]      14 - بَابُ الْحَمْلِ عَلَى الرَّاحِلَةِ فِي  الْحَجِّ  يَحْسِبُ مِنْ  سَبِيلِ  اللهِ  1147  قَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي إِسْمَاعِيلَ ،  عَنْ  إِبْرَاهِيمَ بْنِ الْمُهَاجِرِ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  مَعْقِلِ بْنِ أَبِي مَعْقِلٍ :  أَنَّ أُمَّهُ أَتَتِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَتْ : يَا رَسُولَ اللهِ ، إِنَّ  أَبَا مَعْقِلٍ  كَانَ وَعَدَنِي أَنْ لَا يَحُجَّ إِلَّا وَأَنَا مَعَهُ ، فَحَجَّ عَلَى رَاحِلَتِهِ ، وَلَمْ أُطِقِ الْمَشْيَ ، فَسَأَلْتُهُ جِذَاذَ نَخْلَةٍ فَقَالَ : هُوَ قُوتُ عِيَالِهِ ، وَسَأَلْتُهُ  بَكْرًا  عِنْدَهُ ، فَقَالَ : هُوَ فِي  سَبِيلِ  اللهِ وَلَسْتُ بِمُعْطِيكِهِ ، فَقَالَ :  يَا  أَبَا مَعْقِلٍ  ، مَا تَقُولُ  أُمُّ مَعْقِلٍ  ؟  قَالَ : صَدَقَتْ ، قَالَ : فَأَعْطِهَا بَكْرَكَ ، فَإِنَّ  الْحَجَّ  مِنْ  سَبِيلِ  اللهِ تَعَالَى . فَأَعْطَاهَا بَكْرَهُ  .         [6/302]             [6/303]","","Al-Matalib al-Aliyah 1147","","معقل بن أبي معقل الأسدي عن أبو بكر بن عبد الرحمن راهب قريش عن إبراهيم بن مهاجر بن جابر البجلي عن محمد بن أبي إسماعيل السلمي عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة","باب الحمل على الراحلة في الحج يحسب من سبيل الله"
"1408","[6/304]      1148  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  عَبْدُ الرَّحِيمِ هُوَ ابْنُ سُلَيْمَانَ ،  عَنِ  الْمُخْتَارِ بْنِ فُلْفُلٍ ،  عَنْ  طَلْقِ بْنِ حَبِيبٍ ،  عَنْ  أَبِي طَلِيقٍ ، قَالَ :  إِنَّ امْرَأَتَهُ قَالَتْ لَهُ ، وَلَهُ جَمَلٌ وَنَاقَةٌ : أَعْطِنِي جَمَلَكَ أَحُجُّ عَلَيْهِ . فَقَالَ : هُوَ حَبْسٌ فِي  سَبِيلِ  اللهِ تَعَالَى . فَقَالَتْ : إِنَّهُ فِي  سَبِيلِ  اللهِ أَنْ أَحُجَّ عَلَيْهِ فَأَبَى ، فَقَالَتْ : فَأَعْطِنِي النَّاقَةَ ، وَحُجَّ عَلَى جَمَلِكَ ؟ قَالَ : لَا أُوثِرُ عَلَى نَفْسِي أَحَدًا ، قَالَتْ : فَأَعْطِنِي مِنْ نَفَقَتِكَ . قَالَ : مَا عِنْدِي فَضْلٌ عَمَّا أَخْرُجُ بِهِ ، وَلَوْ كَانَ مَعِي لَأَعْطَيْتُكِ . قَالَتْ : فَإِذَا فَعَلْتَ مَا فَعَلْتَ ، فَأَقْرِئْ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنِّي السَّلَامَ إِذَا لَقِيتَهُ ، وَقُلْ لَهُ الَّذِي قُلْتُ لَكَ . فَلَمَّا لَقِيَ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَقْرَأَهُ مِنْهَا السَّلَامَ ، وَأَخْبَرَهُ بِالَّذِي قَالَتْ لَهُ . فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَدَقَتْ  أُمُّ طَلِيقٍ  ، لَوْ أَعْطَيْتَهَا جَمَلَكَ كَانَ فِي  سَبِيلِ  اللهِ  ، وَلَوْ أَعْطَيْتَهَا نَاقَتَكَ كَانَ فِي  سَبِيلِ  اللهِ ، وَإِنْ أَعْطَيْتَهَا مِنْ نَفَقَتِكَ أَخْلَفَهَا اللهُ لَكَ ، فَقُلْتُ : يَا نَبِيَّ اللهِ ، وَمَا يَعْدِلُ  الْحَجَّ  ؟ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : عُمْرَةٌ فِي رَمَضَانَ  .         [6/305]","","Al-Matalib al-Aliyah 1148","","أبو طليق عن طلق بن حبيب العنزي عن المختار بن فلفل عن عبد الرحيم بن سليمان الأشل عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","باب الحمل على الراحلة في الحج يحسب من سبيل الله"
"1409","[6/306]      15 - بَابُ صِحَّةِ حَجِّ الْجِمَالِ  1149  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ عَطَاءٌ :  سَأَلَ  رَجُلٌ ابْنَ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : أُؤَاجِرُ نَفْسِي مِنْ هَؤُلَاءِ  الْقَوْمِ  ، فَأَنْسُكُ مَعَهُمْ أَلِي أَجْرٌ ؟ قَالَ : نَعَمْ :         {      أُولَئِكَ لَهُمْ نَصِيبٌ مِمَّا كَسَبُوا         }      . الْآيَةَ  .         [6/307]","","Al-Matalib al-Aliyah 1149","","عبد الله بن عباس عن عطاء بن أبي رباح عن ابن جريج عن يحيى القطان عن مسدد بن مسرهد","باب صحة حج الجمال"
"1410","[6/308]      1150  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  عَبْدِ اللهِ بْنِ شَبِيبٍ ،  ثَنَا  أَبُو السَّلِيلِ ،  قُلْتُ لِابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا : إِنَّ لِي رَوَاحِلَ أُكْرِيهِمْ فِي  الْحَجِّ  ، وَأَسْعَى عَلَى عِيَالِي ، فَزَعَمَ نَاسٌ أَنَّهُ لَا حَجَّ لِي ; لِأَنَّهَا تُكْرَى .  فَقَالَ  : كَذَبُوا ، لَكَ أَجْرٌ فِي حَجِّكَ ، وَأَجْرٌ فِي سَعْيِكَ عَلَى عِيَالِكَ ، فَلَكَ أَجْرَانِ  .  أَخْرَجَهُ  أَبُو دَاوُدَ  مِنْ وَجْهٍ آخَرَ بِغَيْرِ هَذَا اللَّفْظِ  .         [6/309]","","Al-Matalib al-Aliyah 1150","","عبد الله بن عمر بن الخطاب عن ضريب بن نقير القيسي عن عبد الله بن شبيب الربعي عن يحيى القطان عن مسدد بن مسرهد","باب صحة حج الجمال"
"1411","[6/310]      16 - بَابُ  الْحَجِّ  عَنِ الْغَيْرِ  1151  قَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ حَاتِمٍ الطَّوِيلُ ،  ثَنَا  هُشَيْمٌ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، قَالَتْ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَمِعَ  رَجُلًا  يُلَبِّي عَنْ  شُبْرُمَةَ  فَقَالَ : وَمَا  شُبْرُمَةُ  ؟  ، فَذَكَرَ قَرَابَةً لَهُ ، قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : حَجَجْتَ عَنْ نَفْسِكَ ؟ قَالَ : لَا ، قَالَ : فَاحْجُجْ عَنْ نَفْسِكَ ، ثُمَّ حُجَّ عَنْ  شُبْرُمَةَ  .","","Al-Matalib al-Aliyah 1151","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن محمد بن حاتم الخراساني عن أبو يعلى الموصلي","باب الحج عن الغير"
"1412","[6/311]      1152  - وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  عِيسَى بْنُ يُونُسَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ، فَذَكَرَهُ  مُرْسَلًا  .  وَالْمَحْفُوظُ  فِي هَذَا الْحَدِيثِ  ابْنُ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا  .         [6/312]","","Al-Matalib al-Aliyah 1152","","عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن عيسى بن يونس بن أبي إسحاق عن مسدد بن مسرهد","باب الحج عن الغير"
"1413","[6/313]      1153  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  قَالَ :  إِنَّ  رَجُلًا  قَالَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّ أَبِي لَا يَسْتَطِيعُ أَنْ يَحُجَّ إِلَّا مُعْتَرِضًا  ، أَفَأَحُجُّ عَنْهُ ؟ قَالَ : نَعَمْ قَالَ : إِنَّ أُمِّي مَاتَتْ وَلَمْ تُوصِ ، أَفَأَتَصَدَّقُ عَنْهَا ؟ قَالَ : نَعَمْ  .         [6/314]             [6/315]","","Al-Matalib al-Aliyah 1153","","طاوس بن كيسان عن عبد الله بن طاووس عن سفيان الثوري عن يحيى القطان عن مسدد بن مسرهد","باب الحج عن الغير"
"1414","[6/316]      1154  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  إِسْحَاقُ بْنُ بِشْرٍ ،  ثَنَا  أَبُو مَعْشَرٍ ،  عَنِ  ابْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُدْخِلُ اللهُ تَعَالَى بِالْحَجَّةِ الْوَاحِدَةِ ثَلَاثَةَ نَفَرٍ الْجَنَّةَ  : الْمَيِّتَ ، وَالْحَاجَّ ، وَالْمُنْفِذَ ذَلِكَ  .         [6/317]","","Al-Matalib al-Aliyah 1154","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن نجيح بن عبد الرحمن السندي عن إسحاق بن بشر بن مقاتل الكاهلي عن الحارث بن محمد بن أبي أسامة","باب الحج عن الغير"
"1415","[6/318]      1155  - وَقَالَ الْحَارِثُ :  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ أَبِي إِسْمَاعِيلَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ شُعَيْبٍ الْمَدَنِيِّ ،  يَرْفَعُهُ  نَحْوَهُ .","","Al-Matalib al-Aliyah 1155","","إبراهيم بن شعيث المدني عن إسماعيل بن عياش الأحول عن إسماعيل بن أبي إسماعيل المؤدب عن الحارث بن محمد بن أبي أسامة","باب الحج عن الغير"
"1416","[6/319]      17 - بَابُ الْمَوَاقِيتِ الْمَكَانِيَّةِ  1156  قَالَ إِسْحَاقُ :  حَدَّثَنَا  حَفْصٌ هُوَ ابْنُ غِيَاثٍ ،  عَنْ  حَجَّاجٍ هَذَا ابْنُ أَرْطَأَةَ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  وَقَّتَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِأَهْلِ  الْعِرَاقِ  ذَاتَ  عِرْقٍ  .  حَجَّاجٌ ضَعِيفٌ  .         [6/320]             [6/321]","","Al-Matalib al-Aliyah 1156","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن حجاج بن أرطاة عن حفص بن غياث النخعي عن إسحاق ابن راهويه","باب المواقيت المكانية"
"1417","[6/322]      1157  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ ،  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ قُسَيْطٍ ،  عَنْ  أَبِيهِ يَزِيدَ  ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ،  عَنْ  أُبَيٍّ رَضِيَ اللهُ عَنْهُ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَهَلَّ مِنْ  مَسْجِدِ ذِي الْحُلَيْفَةِ  .","","Al-Matalib al-Aliyah 1157","","أبي بن كعب عن محمد بن عبد الرحمن بن ثوبان القرشي عن يزيد بن عبد الله بن قسيط الليثي عن عبد الله بن يزيد بن عبد الله بن قسيط عن الواقدي عن الحارث بن محمد بن أبي أسامة","باب المواقيت المكانية"
"1418","[6/323]      1158  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  حَفْصَةَ بِنْتِ سِيرِينَ ،  عَنْ  يَحْيَى بْنِ سِيرِينَ ،  أَنَّهُ حَجَّ مَعَ أَنَسِ بْنِ مَالِكٍ رَضِيَ اللهُ عَنْهُ ، فَحَدَّثَهُ أَنَّهُ أَحْرَمَ مِنَ  الْعَقِيقِ  .","","Al-Matalib al-Aliyah 1158","","أنس بن مالك عن يحيى بن سيرين البصري عن حفصة بنت سيرين عن هشام بن حسان العتكي عن حماد بن زيد عن مسدد بن مسرهد","باب المواقيت المكانية"
"1419","[6/324]      18 - بَابُ كَرَاهِيَةِ الْإِحْرَامِ مِنْ غَيْرِ الْمِيقَاتِ  1159  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ قَالَ : إِنَّ الْحَسَنَ  حَدَّثَهُمْ  ،  أَنَّ  عِمْرَانَ بْنَ حُصَيْنٍ رَضِيَ اللهُ عَنْهُ ،  أَرَاهُ قَالَ : يَعْنِي أَحْرَمَ مِنَ  الْبَصْرَةِ  ، فَلَمَّا قَدِمَ عَلَى عُمَرَ رَضِيَ اللهُ عَنْهُ وَكَانَ قَدْ بَلَغَهُ ذَلِكَ ، فَأَغْلَظَ لَهُ ،  وَقَالَ  : يَتَحَدَّثُ النَّاسُ أَنَّ رَجُلًا مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحْرَمَ مِنْ مِصْرٍ مِنَ الْأَمْصَارِ  .         [6/325]","","Al-Matalib al-Aliyah 1159","","عمر بن الخطاب عن الحسن البصري عن قتادة بن دعامة عن شعبة بن الحجاج عن يزيد بن زريع العيشي عن مسدد بن مسرهد","باب كراهية الإحرام من غير الميقات"
"1420","[6/326]      19 - بَابُ الْمَوَاقِيتِ الزَّمَانِيَّةِ  1160  قَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  أَسَدُ بْنُ عَمْرٍو ،  ثَنَا  الْحَجَّاجُ ،  عَنِ  الْحَكَمِ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  مِنَ السُّنَّةِ أَنْ لَا يُحْرَمَ بِالْحَجِّ إِلَّا فِي أَشْهُرِ  الْحَجِّ  .         [6/327]","","Al-Matalib al-Aliyah 1160","","عبد الله بن عباس عن مقسم بن بجرة عن الحكم بن عتيبة الكندي عن حجاج بن أرطاة عن أسد بن عمرو بن عامر البجلي عن أحمد بن منيع البغوي","باب المواقيت الزمانية"
"1421","[6/328]      20 - بَابُ فَضْلِ الْمُحْرِمِ  1161  قَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ :  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  فُلَانٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا مِنْ رَجُلٍ يَضَعُ ثَوْبَهُ وَهُوَ مُحْرِمٌ  فَتُصِيبُهُ الشَّمْسُ حَتَّى تَغْرُبَ إِلَّا غَرُبَتْ بِخَطَايَاهُ  .         [6/329]             [6/330]","","Al-Matalib al-Aliyah 1161","","فلان عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن يزيد بن أبي زياد القرشي عن محمد بن فضيل بن غزوان عن أبو بكر ابن أبي شيبة","باب فضل المحرم"
"1422","[6/331]      1162  / 1  -  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  ثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  عَنْ  أَخِيهِ عَبْدِ اللهِ بْنِ عُبَيْدَةَ  ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَضَى  نُسُكَهُ  ، وَسَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  ، غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ وَمَا تَأَخَّرَ  .         [6/332]","","Al-Matalib al-Aliyah 1162","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن عبيدة بن نشيط الحميري عن موسى بن عبيدة بن نشيط الحميري عن مروان بن معاوية الفزاري عن أحمد بن منيع البغوي","باب فضل المحرم"
"1423","1162  / 2  - وَقَالَ عَبْدُ بْنُ حُمَيْدٍ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُوسَى  ،  ثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  بِهِ  ، وَلَمْ يَقُلْ : وَمَا تَأَخَّرَ .  كذا في طبعة دار العاصمة ، والصواب : ( عبيد الله بن موسى )","","Al-Matalib al-Aliyah 1162","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن عبيدة بن نشيط الحميري عن موسى بن عبيدة بن نشيط الحميري عن عبيد الله بن موسى عن عبد بن حميد","باب فضل المحرم"
"1424","[6/333]      1163  / 1  -  وَقَالَ إِسْحَاقُ :  أَخْبَرَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي حُمَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُمَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  وَفْدُ  اللهِ تَعَالَى ثَلَاثَةٌ  : الْحَاجُّ ، وَالْمُعْتَمِرُ ، وَالْغَازِي  .  مُحَمَّدٌ ضَعِيفٌ  .","","Al-Matalib al-Aliyah 1163","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن محمد بن أبي حميد الزرقي عن أبو عامر العقدي عن إسحاق ابن راهويه","باب فضل المحرم"
"1425","1163  / 2  - وَقَالَ الْبَزَّارُ :  عَنِ  الْوَلِيدِ بْنِ عَمْرِو بْنِ سُكَيْنٍ ،  ثَنَا  أَبُو عَاصِمٍ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي حُمَيْدٍ ،  بِهِ  .  وَقَالَ :  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ أَبِي حُمَيْدٍ  ، وَعِنْدَهُ أَحَادِيثُ لَا يُتَابَعُ عَلَيْهَا  .         [6/334]","","Al-Matalib al-Aliyah 1163","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن محمد بن أبي حميد الزرقي عن أبو عاصم النبيل عن الوليد بن عمرو بن السكين الضبعي عن البزار","باب فضل المحرم"
"1426","[6/335]      1164  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  حَدَّثَنِي  مِرْدَاسُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  دَخَلْتُ عَلَى عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ،  فَحَدَّثَنَا  قَالَ : مَا مِنْ  أَحَدٍ أَوْ رَجُلٍ  يُهِلُّ  إِلَّا قَالَ اللهُ تَعَالَى : أَبْشِرْ ، فَقَالَ  عَمُّ مِرْدَاسٍ  : يَا  أَبَا مُحَمَّدٍ  ، وَاللهِ لَا يُبَشِّرُ اللهُ تَعَالَى إِلَّا بِالْجَنَّةِ ، فَقَالَ : مَنْ أَنْتَ يَا ابْنَ أَخِي ؟ قَالَ : أَنَا  مِرْدَاسُ بْنُ شَدَّادٍ الْجُنَيْدِيُّ  ، قَالَ : يَا ابْنَ أَخِي ، كَانَ خِيَارُنَا يَتَتَابَعُونَ عَلَى ذَلِكَ  .         [6/336]","","Al-Matalib al-Aliyah 1164","","عبد الله بن عمرو بن العاص عن مرداس بن عبد الرحمن الجندعي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يحيى القطان عن مسدد بن مسرهد","باب فضل المحرم"
"1427","[6/337]      1165  وَقَالَ الْحُمَيْدِيُّ :  حَدَّثَنَا  سُفْيَانُ ،  ثَنَا  مُحَمَّدُ بْنُ سُوقَةَ ، قَالَ :  قِيلَ لِابْنِ الْمُنْكَدِرِ : أَتَحُجُّ وَعَلَيْكَ دَيْنٌ ؟  قَالَ :  الْحَجُّ  أَقْضَى لِلدَّيْنِ  .","","Al-Matalib al-Aliyah 1165","","محمد بن المنكدر عن محمد بن سوقة الغنوي عن سفيان بن عيينة عن الحميدي","باب فضل المحرم"
"1428","[6/338]      1166  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  حُمَيْدِ بْنِ طِرْخَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ طَاوُسٍ ، قَالَ :  كَانَ أَبِي إِذَا أَقْبَلْنَا إِلَى  مَكَّةَ  سَارَ بِنَا مِنْ مَكَانِهِ شَهْرًا  ، وَإِذَا رَجَعَ سَارَ بِنَا شَهْرَيْنِ ، فَذُكِرَ ذَلِكَ لَهُ ، فَقَالَ : إِنَّهُ بَلَغَنِي أَنَّ الرَّجُلَ لَا يَزَالُ فِي سَبِيلِ  الْحَجِّ  حَتَّى يَدْخُلَ فِي أَهْلِهِ  .","","Al-Matalib al-Aliyah 1166","","طاوس بن كيسان عن عبد الله بن طاووس عن حميد بن طرخان عن حماد بن زيد عن مسدد بن مسرهد","باب فضل المحرم"
"1429","[6/339]      1167  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  دَاوُدُ بْنُ الْمُحَبَّرِ ،  ثَنَا  حَمَّادٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَذَا  الْبَيْتُ  دِعَامَةُ  الْإِسْلَامِ  ، مَنْ خَرَجَ يَؤُمُّ هَذَا الْبَيْتَ مِنْ حَاجٍّ ، أَوْ مُعْتَمِرٍ ، أَوْ زَائِرٍ ، كَانَ مَضْمُونًا عَلَى اللهِ إِنْ قَبَضَهُ أَنْ يُدْخِلَهُ الْجَنَّةَ ، وَإِنْ رَدَّهُ رَدَّهُ بِغَنِيمَةٍ وَأَجْرٍ  .","","Al-Matalib al-Aliyah 1167","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حماد بن سلمة عن داود بن المحبر البكراوي عن الحارث بن محمد بن أبي أسامة","باب فضل المحرم"
"1430","[6/340]      1168  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  إِسْحَاقُ بْنُ بِشْرٍ ،  ثَنَا  أَبُو مَعْشَرٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ مَاتَ فِي طَرِيقِ  مَكَّةَ  لَمْ يَعْرِضْهُ اللهُ تَبَارَكَ وَتَعَالَى يَوْمَ الْقِيَامَةِ وَلَمْ يُحَاسِبْهُ  .         [6/341]","","Al-Matalib al-Aliyah 1168","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن نجيح بن عبد الرحمن السندي عن إسحاق بن بشر بن مقاتل الكاهلي عن الحارث بن محمد بن أبي أسامة","باب فضل المحرم"
"1431","[6/342]      1169  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ ،  ثَنَا  حُسَيْنٌ يَعْنِي الْجُعْفِيَّ ،  عَنِ  ابْنِ السَّمَّاكِ ،  عَنْ  عَايِذٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ خَرَجَ مِنْ هَذَا الْوَجْهِ لِحَجٍّ  أَوْ عُمْرَةٍ فَمَاتَ فِيهِ ، لَمْ يُعْرَضْ وَلَمْ يُحَاسَبْ ، وَقِيلَ لَهُ : ادْخُلِ الْجَنَّةَ  .  عِايِذٌ هَذَا هُوَ ابْنُ نُسَيْرٍ  ، بِنُونٍ وَمُهْمَلَةٍ مُصَغَّرٌ  ضَعِيفٌ  ،  وَابْنُ السَّمَّاكِ هُوَ مُحَمَّدُ بْنُ صُبَيْحٍ  فِيهِ ضَعْفٌ  .         [6/343]","","Al-Matalib al-Aliyah 1169","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن عائذ بن نسير عن محمد بن صبيح بن السماك الكوفي عن الحسين بن علي الجعفي عن الحسن بن حماد سجادة عن أبو يعلى الموصلي","باب فضل المحرم"
"1432","[6/344]      1170  وَقَالَ أَبُو يَعْلَى أَيْضًا :  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ زِيَادٍ سَبَلَانُ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  جَمِيلِ بْنِ أَبِي مَيْمُونَةَ ،  عَنْ  عَطَاءِ بْنِ يَزِيدَ اللَّيْثِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ خَرَجَ حَاجًّا فَمَاتَ كُتِبَ لَهُ أَجْرُ الْحَاجِّ إِلَى يَوْمِ الْقِيَامَةِ  ، وَمَنْ خَرَجَ مُعْتَمِرًا فَمَاتَ كُتِبَ لَهُ أَجْرُ الْمُعْتَمِرِ إِلَى يَوْمِ الْقِيَامَةِ ، وَمَنْ خَرَجَ غَازِيًا فِي  سَبِيلِ  اللهِ فَمَاتَ كُتِبَ لَهُ أَجْرُ الْغَازِي إِلَى يَوْمِ الْقِيَامَةِ  .         [6/345]","","Al-Matalib al-Aliyah 1170","","أبو هريرة الدوسي عن عطاء بن يزيد الجندعي عن جميل بن أبي ميمونة عن محمد بن إسحاق عن أبو معاوية الضرير عن إبراهيم بن زياد سبلان عن أبو يعلى الموصلي","باب فضل المحرم"
"1433","[6/346]      21 - بَابُ دُعَاءِ الْحَاجِّ وَالْمُعْتَمِرِ  1171  قَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الصَّمَدِ ،  ثَنَا  قَاسِمٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَاصِمٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا :  جَاءَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ يَسْتَأْذِنُ فِي الْعُمْرَةِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا أَخِي ادْعُ ، وَلَا تَنْسَنَا مِنْ صَالِحِ الدُّعَاءِ  .  أَخْرَجَهُ  أَبُو دَاوُدَ  مِنْ حَدِيثِ  عُمَرَ  رَضِيَ اللهُ عَنْهُ عَنْ نَفْسِهِ  .         [6/347]","","Al-Matalib al-Aliyah 1171","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن سفيان الثوري عن القاسم بن يزيد الجرمي عن عبد الله بن عبد الصمد عن أبو يعلى الموصلي","باب دعاء الحاج والمعتمر"
"1434","[6/348]      22 - بَابُ  فَسْخِ  الْحَجِّ  إِلَى الْعُمْرَةِ وَعَكْسِهِ وَمَا جَاءَ فِي الْقِرَانِ .  1172  قَالَ إِسْحَاقُ :  أَخْبَرَنَا  الْمُغِيرَةُ بْنُ سَلَمَةَ الْمَخْزُومِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُثْمَانَ رَضِيَ اللهُ عَنْهُ :  أَنَّهُ سُئِلَ عَنِ  الْمُتْعَةِ  فِي  الْحَجِّ  ، فَقَالَ : كَانَتْ لَنَا ، لَيْسَتْ لَكُمْ  .         [6/349]","","Al-Matalib al-Aliyah 1172","","عثمان بن عفان عن يزيد بن شريك بن طارق التيمي عن إبراهيم بن يزيد بن شريك التيمي عن معاوية بن إسحاق بن طلحة التيمي عن الوضاح بن عبد الله اليشكري عن المغيرة بن سلمة المخزومي عن إسحاق ابن راهويه","باب فسخ الحج إلى العمرة وعكسه وما جاء في القران"
"1435","[6/350]      1173  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  سُفْيَانُ هُوَ ابْنُ وَكِيعٍ ،  ثَنَا  أَبِي  ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي حُمَيْدٍ ،  عَنْ  أَبِي مَلِيحٍ ،  حَدَّثَنِي  مَعْقِلُ بْنُ يَسَارٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  حَجَجْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَوَجَدَ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا تَنْزِعُ ثِيَابَهَا ، فَقَالَ :  مَا لَكِ ؟ قَالَتْ : أُنْبِئْتُ أَنَّكَ أَحْلَلْتَ أَهْلَكَ  ، قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَجَلْ مَنْ لَيْسَ مَعَهُ بَدَنَةٌ ، فَأَمَّا نَحْنُ فَلَمْ نَحِلَّ ، إِنَّ مَعَنَا بُدْنًا ، حَتَّى نَبْلُغَ  عَرَفَاتٍ  .         [6/351]","","Al-Matalib al-Aliyah 1173","","معقل بن يسار المزني عن أبو المليح بن أسامة الهذلي عن عبيد الله بن أبي حميد الهذلي عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","باب فسخ الحج إلى العمرة وعكسه وما جاء في القران"
"1436","[6/352]      1174  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  ثَنَا  عَاصِمٌ الْأَحْوَلُ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ، قَالَ :  قَدِمَ عِمْرَانُ بْنُ حُصَيْنٍ رَضِيَ اللهُ عَنْهُ فِي أَصْحَابٍ لَهُ قَدْ جَمَعُوا بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ  ، فَقِيلَ لِعُثْمَانَ بْنِ عَفَّانَ رَضِيَ اللهُ عَنْهُ : إِنَّ  عِمْرَانَ  قَدِمَ فِي أَصْحَابٍ لَهُ بِالْحَجِّ وَالْعُمْرَةِ ، فَأَرْسَلَ إِلَيْهِ : أَنِ اخْتَرْ أَحَدَهُمَا .  فَقَالَ  عِمْرَانُ  : إِنَّ أَمِيرَ الْمُؤْمِنِينَ نَهَانَا ، وَقَدْ خَيَّرَنَا  ، فَأَنَا أَخْتَارُ  الْحَجَّ  .","","Al-Matalib al-Aliyah 1174","","عثمان بن عفان عن عمران بن حصين بن عبيد بن خلف الخزاعي عن محمد بن سيرين عن عاصم بن سليمان الأحول عن عبد الواحد بن زياد عن مسدد بن مسرهد","باب فسخ الحج إلى العمرة وعكسه وما جاء في القران"
"1437","[6/353]      1175  قَالَ :  وَحَدَّثَنَا  أَبُو عَوَانَةَ ،  ثَنَا  عُثْمَانُ بْنُ الْمُغِيرَةِ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  سَعْدٍ مَوْلَى الْحَسَنِ بْنِ عَلِيٍّ قَالَ :  خَرَجْنَا مَعَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ حَتَّى إِذَا كُنَّا  بِذِي الْحُلَيْفَةِ  قَالَ  : إِنِّي أُرِيدُ أَنْ أَجْمَعَ بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ ، فَمَنْ أَرَادَ ذَلِكَ مِنْكُمْ فَلْيَقُلْ كَمَا أَقُولُ ، ثُمَّ لَبَّى ، فَقَالَ : بِعُمْرَةٍ وَحَجَّةٍ مَعًا  .  صَحِيحٌ مَوْقُوفٌ  .","","Al-Matalib al-Aliyah 1175","","علي بن أبي طالب عن سعد بن معبد الهاشمي عن سالم بن أبي الجعد الغطفاني عن عثمان بن المغيرة الأعشى عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد","باب فسخ الحج إلى العمرة وعكسه وما جاء في القران"
"1438","[6/354]      1176  وَقَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَحْمَدُ بْنُ مَنِيعٍ مَعًا :  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  كِلَابِ بْنِ عَلِيٍّ ،  عَنْ  مَنْصُورِ بْنِ سُلَيْمَانَ  ،  عَنِ  ابْنِ أَخِي جُبَيْرِ بْنِ مُطْعِمٍ ، قَالَ :  قَامَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  الْمَرْوَةِ  وَبِيَدِهِ  مِشْقَصٌ  يُقَصِّرُ بِهِ مِنْ شَعَرِهِ  ، وَهُوَ يَقُولُ :  دَخَلَتِ  الْعُمْرَةُ فِي  الْحَجِّ  إِلَى يَوْمِ الْقِيَامَةِ  .         [6/355]      كذا في طبعة دار العاصمة ، ولعل الصواب : ( منصور بن أبي سليمان )","","Al-Matalib al-Aliyah 1176","","نافع بن جبير بن مطعم النوفلي عن منصور بن أبى سليمان عن كلاب بن علي الجعفري عن منصور بن المعتمر عن جرير بن عبد الحميد عن أبو بكر ابن أبي شيبة","باب فسخ الحج إلى العمرة وعكسه وما جاء في القران"
"1439","[6/356]      23 - بَابُ مَا يَكْفِي الْقَارِنَ مِنَ الطَّوَافِ وَالسَّعْيِ  1177  / 1  -  قَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى بْنِ الْحَارِثِ ،  عَنْ  أَبِيهِ  ،  عَنْ  غَيْلَانَ بْنِ جَامِعٍ ،  عَنْ  لَيْثٍ ،  عَنْ  عَطَاءٍ ، وَطَاوُوسٍ ، وَمُجَاهِدٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، وَابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمْ قَالُوا :  إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يَطُفْ هُوَ وَأَصْحَابُهُ  إِلَّا طَوَافًا وَاحِدًا لِحَجِّهِمْ وَعُمْرَتِهِمْ  .         [6/357]             [6/358]","","Al-Matalib al-Aliyah 1177","","عبد الله بن عباس عن عطاء بن أبي رباح عن ليث بن أبي سليم عن غيلان بن جامع المحاربي عن يعلى بن الحارث بن حرب المحاربي عن يحيى بن يعلى بن الحارث المحاربي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","باب ما يكفي القارن من الطواف والسعي"
"1440","1177  / 2  - وَقَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ :  حَدَّثَنَا  يَحْيَى بْنُ يَعْلَى ،  بِهِ  .","","Al-Matalib al-Aliyah 1177","","عبد الله بن عباس عن عطاء بن أبي رباح عن ليث بن أبي سليم عن غيلان بن جامع المحاربي عن يعلى بن الحارث بن حرب المحاربي عن يحيى بن يعلى بن الحارث المحاربي عن أبو بكر ابن أبي شيبة","باب ما يكفي القارن من الطواف والسعي"
"1441","1177  / 3  - وَقَالَ أَبُو يَعْلَى ، أَيْضًا :  حَدَّثَنَا  أَبُو بَكْرٍ ، بِهِ .  قُلْتُ :  لَيْثٌ  ضَعِيفٌ .  وَحَدِيثُ  جَابِرٍ  عِنْدَ  مُسْلِمٍ  مِنْ وَجْهٍ آخَرَ .  وَحَدِيثُ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا فِي السُّنَنِ  .         [6/359]","","Al-Matalib al-Aliyah 1177","","عبد الله بن عباس عن عطاء بن أبي رباح عن ليث بن أبي سليم عن غيلان بن جامع المحاربي عن يعلى بن الحارث بن حرب المحاربي عن يحيى بن يعلى بن الحارث المحاربي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","باب ما يكفي القارن من الطواف والسعي"
"1442","[6/360]      24 - بَابُ التَّمَتُّعِ  1178  قَالَ إِسْحَاقُ :  أَخْبَرَنَا  عَبْدُ الرَّزَّاقِ ،  ثَنَا  هِشَامٌ ،  عَنِ  الْحَسَنِ قَالَ :  إِنَّ  عُمَرَ بْنَ الْخَطَّابِ  رَضِيَ اللهُ عَنْهُ هَمَّ أَنْ يَنْهَى عَنْ مُتْعَةِ  الْحَجِّ  ، فَقَامَ إِلَيْهِ أُبَيُّ بْنُ كَعْبٍ ، فَقَالَ : لَيْسَ ذَاكَ لَكَ ، قَدْ نَزَلَ بِهَا كِتَابُ اللهِ عَزَّ وَجَلَّ ، وَاعْتَمَرْنَاهَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَتَرَكَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ  .","","Al-Matalib al-Aliyah 1178","","أبي بن كعب عن الحسن البصري عن هشام بن حسان العتكي عن عبد الرزاق الصنعاني عن إسحاق ابن راهويه","باب التمتع"
"1443","[6/361]      1179  وَقَالَ إِسْحَاقُ :  أَخْبَرَنَا  عَبْدُ الرَّزَّاقِ ، قَالَ :  قَالَ  مَعْمَرٌ ،  قَالَ  ابْنُ طَاوُوسٍ ،  عَنْ  أَبِيهِ  :  قَامَ أَبِي  وَأَبُو مُوسَى  إِلَى عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ ، فَقَالَا : أَلَا تُعْلِمُ النَّاسَ أَمْرَ هَذِهِ  الْمُتْعَةِ  ؟  فَقَالَ  : وَهَلْ بَقِيَ أَحَدٌ إِلَّا عَمِلَهَا ؟ أَمَّا أَنَا فَأَفْعَلُهَا  .","","Al-Matalib al-Aliyah 1179","","عمر بن الخطاب عن طاوس بن كيسان عن عبد الله بن طاووس عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري","باب التمتع"
"1444","[6/362]      1180  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  طَاوُوسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  سَمِعْتُ  عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ ، يَقُولُ :  لَوِ اعْتَمَرْتُ ، ثُمَّ اعْتَمَرْتُ  ، ثُمَّ حَجَجْتُ تَمَتَّعْتُ  .         [6/363]","","Al-Matalib al-Aliyah 1180","","عمر بن الخطاب عن عبد الله بن عباس عن طاوس بن كيسان عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن يحيى القطان عن مسدد بن مسرهد","باب التمتع"
"1445","[6/364]      1181  قَالَ :  وَحَدَّثَنَا  يَحْيَى ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  أَخْبَرَنِي  نَافِعٌ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا  قَالَ  عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ :  إِنْ يُفَرِّقُوا بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ تَكُونُ الْعُمْرَةُ فِي غَيْرِ أَشْهُرِ  الْحَجِّ  أَتَمَّ لِحَجِّ أَحَدِكُمْ وَلِعُمْرَتِهِ  .         [6/365]","","Al-Matalib al-Aliyah 1181","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن يحيى القطان عن مسدد بن مسرهد","باب التمتع"
"1446","[6/366]      1182  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ قَالَ :  إِنَّ  ابْنَ عُمَرَ رَضِيَ اللهُ عَنْهُمَا كَانَ إِذَا أَحْرَمَ مِنْ  مَكَّةَ  لَمْ يَسْعَ  حَتَّى يَرْجِعَ مِنْ  مِنًى  .","","Al-Matalib al-Aliyah 1182","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد الله بن المبارك عن مسدد بن مسرهد","باب التمتع"
"1447","[6/367]      1183  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  هِشَامٍ ،  عَنْ  حَفْصَةَ قَالَتْ :  أَهْلَلْنَا بِعُمْرَةٍ فِي رَمَضَانَ ، فَقَدِمْنَا  مَكَّةَ  فِي شَوَّالٍ وَالنَّاسُ يَوْمَئِذٍ مُتَوَافِرُونَ  ، فَسَأَلْنَا ، فَمَا سَأَلْنَا أَحَدًا إِلَّا قَالَ : هِيَ مُتْعَةٌ  .","","Al-Matalib al-Aliyah 1183","","حفصة بنت سيرين عن هشام بن حسان العتكي عن يحيى القطان عن مسدد بن مسرهد","باب التمتع"
"1448","[6/368]      1184  وَقَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ :  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ الزُّبَيْرِ رَضِيَ اللهُ عَنْهُمَا أَفْرِدُوا  الْحَجَّ  ، وَدَعُوا قَوْلَ أَعْمَاكُمْ هَذَا ، فَقَالَ  عَبْدُ اللهِ بْنُ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا ، إِنَّ الَّذِي أَعْمَى اللهُ قَلْبَهُ لَأَنْتَ ، سَلْ عَنْ هَذَا أُمَّكَ  .         [6/369]","","Al-Matalib al-Aliyah 1184","","عبد الله بن الزبير عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن محمد بن فضيل بن غزوان عن أبو بكر ابن أبي شيبة","باب التمتع"
"1449","[6/370]      1185  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  حَجَّاجُ بْنُ يُوسُفَ ،  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَكِيمٍ ،  حَدَّثَنِي  زَمْعَةُ بْنُ صَالِحٍ ،  عَنِ  ابْنِ شِهَابٍ ،  أَخْبَرَنِي  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ ،  عَنِ  ابْنِ مَسْعُودٍ رَضِيَ اللهُ عَنْهُ :  أَنَّهُ تَمَتَّعَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُتْعَةَ  الْحَجِّ  . وَاللهُ أَعْلَمُ .","","Al-Matalib al-Aliyah 1185","","عبد الله بن مسعود عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن زمعة بن صالح الجندي عن يزيد بن أبي حكيم الكناني عن حجاج يوسف الثقفي عن أبو يعلى الموصلي","باب التمتع"
"1450","[6/371]      25 - بَابُ جَوَازِ الِاعْتِمَارِ قَبْلَ  الْحَجِّ  1186  قَالَ إِسْحَاقُ :  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ الْمُقْرِي ،  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ ،  سَمِعْتُ  يَزِيدَ بْنَ أَبِي حَبِيبٍ ، يَقُولُ :  حَدَّثَنِي  أَبُو عِمْرَانَ التُّجِيبِيُّ ،  أَنَّهُ حَجَّ مَعَ مَوَالِيهِ قَالَ : فَلَقِيتُ أُمَّ سَلَمَةَ أُمَّ الْمُؤْمِنِينَ ، فَقُلْتُ لَهَا : إِنِّي لَمْ أَحُجَّ قَطُّ ، فَبِأَيَّتِهِمَا أَبْدَأُ ، أَبِالْحَجِّ ، أَمْ بِالْعُمْرَةِ ؟ فَقَالَتِ : ابْدَأْ بِأَيِّهِمَا شِئْتَ . فَقُلْتُ لَهَا : فَإِنَّ النَّاسَ يَقُولُونَ إِذَا لَمْ يَكُنْ حَجَّ قَطُّ ، فَلْيَبْدَأْ بِالْحَجِّ ، فَقَالَتْ لِي : ابْدَأْ بِأَيِّهِمَا شِئْتَ . فَأَتَيْتُ  صَفِيَّةَ  ، فَسَأَلْتُهَا ، فَقَالَتْ لِي مِثْلَ مَا قَالَتْ  أُمُّ سَلَمَةَ  : ابْدَأْ بِأَيِّهِمَا شِئْتَ ، ثُمَّ جِئْتُ إِلَى  أُمِّ سَلَمَةَ  ، فَأَخْبَرْتُهَا بِقَوْلِ  صَفِيَّةَ  ، فَقَالَتْ  أُمُّ سَلَمَةَ  : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَا آلَ  مُحَمَّدٍ  ، مَنْ حَجَّ مِنْكُمْ فَلْيَجْعَلْ عُمْرَةً مَعَ حَجِّهِ  ، أَوْ مَعَ حَجَّةٍ  .         [6/372]","","Al-Matalib al-Aliyah 1186","","هند بنت أبي أمية زوج رسول الله عن أسلم بن يزيد التجيبي عن يزيد بن أبي حبيب الأزدي عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن إسحاق ابن راهويه","باب جواز الاعتمار قبل الحج"
"1451","[6/373]      26 - بَابُ مَا يَجْتَنِبُهُ الْمُحْرِمُ  1187  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنْ  أَسْلَمَ مَوْلَى عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ قَالَ :  رَأَى عُمَرُ بْنُ الْخَطَّابِ عَلَى  طَلْحَةَ  ثَوْبَيْنِ مَصْبُوغَيْنِ وَهُوَ مُحْرِمٌ  فَقَالَ  : مَا هَذَا ؟ قَالَ : يَا أَمِيرَ الْمُؤْمِنِينَ ، لَيْسَ بِهِ بَأْسٌ ، إِنَّمَا هُوَ  مِشْقٌ  قَالَ : إِنَّكُمْ أَيُّهَا الرَّهْطُ أَئِمَّةٌ ، يَقْتَدِي بِكُمُ النَّاسُ ، وَلَعَلَّ الْجَاهِلَ أَنْ لَوْ رَآكَ أَنْ يَقُولَ : لَقَدْ رَأَيْتُ عَلَى  طَلْحَةَ  ثَوْبَيْنِ مَصْبُوغَيْنِ ، فَلَبِسَ الثِّيَابَ الْمَصْبُوغَةَ فِي الْإِحْرَامِ ، فَلَا أَعْرِفَنَّ مَا يَلْبَسُ أَحَدٌ مِنْكُمْ ثَوْبًا مَصْبُوغًا فِي الْإِحْرَامِ  .  هَذَا  إِسْنَادٌ  صَحِيحٌ  مَوْقُوفٌ  .  وَهُوَ أَصْلٌ فِي سَدِّ الذَّرَائِعِ  .         [6/374]","","Al-Matalib al-Aliyah 1187","","عمر بن الخطاب عن أسلم العدوي مولى عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن إسماعيل ابن علية عن مسدد بن مسرهد","باب ما يجتنبه المحرم"
"1452","[6/375]      1188  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو ،  عَنْ  أَبِي جَعْفَرٍ قَالَ :  إِنَّ  عُمَرَ رَضِيَ اللهُ عَنْهُ أَبْصَرَ عَلَى  عَبْدِ اللهِ بْنِ جَعْفَرٍ  رَضِيَ اللهُ عَنْهُمَا ثَوْبَيْنِ مَصْبُوغَيْنِ  وَهُوَ مُحْرِمٌ ،  فَقَالَ  : مَا هَذَا ؟ فَقَالَ  عَلِيٌّ  : مَا أَخَالُ أَحَدًا يُعَلِّمُنَا السُّنَّةَ  .","","Al-Matalib al-Aliyah 1188","","عمر بن الخطاب عن أبو جعفر الباقر عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن أحمد بن منيع البغوي","باب ما يجتنبه المحرم"
"1453","[6/376]      1189  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ، قَالَ :  سَأَلَتِ امْرَأَةٌ ابْنَ عُمَرَ رَضِيَ اللهُ عَنْهُمَا : أَغْسِلُ ثِيَابِي وَأَنَا مُحْرِمَةٌ ؟  فَقَالَ  : إِنَّ اللهَ تَعَالَى لَا يَصْنَعُ بِدَرَنِكِ شَيْئًا  .","","Al-Matalib al-Aliyah 1189","","عبد الله بن عمر بن الخطاب عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن سفيان الثوري عن يحيى القطان عن مسدد بن مسرهد","باب ما يجتنبه المحرم"
"1454","[6/377]      1190  قَالَ :  وَحَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  الْمُحْرِمُ يَغْتَسِلُ  ، وَيَغْسِلُ ثِيَابَهُ إِنْ شَاءَ  .  هَذَا  صَحِيحٌ  مَوْقُوفٌ  .         [6/378]","","Al-Matalib al-Aliyah 1190","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان الثوري عن يحيى القطان عن مسدد بن مسرهد","باب ما يجتنبه المحرم"
"1455","1191  - قَالَ :  وَحَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، مِثْلَهُ .","","Al-Matalib al-Aliyah 1191","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد","باب ما يجتنبه المحرم"
"1456","[6/379]      1192  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِي الزُّبَيْرِ ، أَنَّهُ  سَمِعَ  جَابِرًا رَضِيَ اللهُ عَنْهُ يَقُولُ :  لَا تَلْبَسُ الْمَرْأَةُ الْمُهِلَّةُ الثِّيَابَ الْمُطَيَّبَةَ  ، وَتَلْبَسُ الْمُعَصْفَرَةَ ، وَلَا أَرَى الصُّفْرَةَ طِيبًا  .  هَذَا صَحِيحٌ مَوْقُوفٌ  .         [6/380]","","Al-Matalib al-Aliyah 1192","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن يحيى القطان عن مسدد بن مسرهد","باب ما يجتنبه المحرم"
"1457","[6/381]      1193  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  حَدَّثَتْنِي  أُخْتِي ،  أَنَّهَا  رَأَتْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا عَشِيَّةَ  التَّرْوِيَةِ  وَعَلَيْهَا دِرْعٌ مُوَرَّدٌ وَخِمَارٌ أَسْوَدُ وَهِيَ مُحْرِمَةٌ  .","","Al-Matalib al-Aliyah 1193","","عائشة بنت أبي بكر الصديق عن سكينة بنت أبي خالد عن إسماعيل بن أبي خالد عن يحيى القطان عن مسدد بن مسرهد","باب ما يجتنبه المحرم"
"1458","[6/382]      1194  قَالَ :  وَحَدَّثَنَا  خَالِدٌ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  أُخْتِهِ ، وَأُمِّهِ  ،  أَنَّهُمَا دَخَلَتَا عَلَى عَائِشَةَ رَضِيَ اللهُ عَنْهَا وَعَلَيْهَا دِرْعٌ مُوَرَّدٌ  ، وَخِمَارٌ أَسْوَدُ ، فَقِيلَ لَهَا : أَتُغَطِّي الْمُحْرِمَةُ وَجْهَهَا ؟ فَرَفَعَتْ خِمَارَهَا هَكَذَا مِنْ قِبَلِ صَدْرِهَا إِلَى رَأْسِهَا ،  وَقَالَتْ  : لَا بَأْسَ بِهَذَا  .","","Al-Matalib al-Aliyah 1194","","عائشة بنت أبي بكر الصديق عن سكينة بنت أبي خالد عن إسماعيل بن أبي خالد عن خالد بن عبد الله الطحان عن مسدد بن مسرهد","باب ما يجتنبه المحرم"
"1459","[6/383]      1195  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ ،  ثَنَا  ابْنُ جُرَيْجٍ ،  عَنِ  الْحَسَنِ بْنِ مُسْلِمٍ ،  عَنْ  صَفِيَّةَ بِنْتِ شَيْبَةَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا :  أَنَّهَا كَانَتْ تُرَخِّصُ لِلْمُحْرِمَةِ فِي لُبْسِ  الْقُفَّازَيْنِ  .","","Al-Matalib al-Aliyah 1195","","عائشة بنت أبي بكر الصديق عن صفية بنت شيبة الحجبية عن الحسن بن مسلم بن يناق عن ابن جريج عن الواقدي عن الحارث بن محمد بن أبي أسامة","باب ما يجتنبه المحرم"
"1460","[6/384]      1196  وَقَالَ :  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ ،  ثَنَا  هَمَّامٌ ،  عَنْ  عَطَاءٍ ،  عَنْ  يَعْلَى بْنِ أُمَيَّةَ ،  عَنْ  أَبِيهِ  قَالَ :  إِنَّ  رَجُلًا  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَعَلَيْهِ جُبَّةٌ وَعَلَيْهِ أَثَرُ  الْخَلُوقِ ،  فَقَالَ : كَيْفَ أَفْعَلُ فِي عُمْرَتِي ؟ فَنَزَلَ الْوَحْيُ فَسُتِرَ بِثَوْبٍ . وَكَانَ  أُمَيَّةُ  يُحِبُّ أَنْ يَرَاهُ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقَدْ أُنْزِلَ عَلَيْهِ الْوَحْيُ ، الْحَدِيثَ  .  قُلْتُ :  وَهِمَ فِيهِ  الْعَبَّاسُ  ، وَإِنَّمَا هُوَ عَنِ  ابْنِ يَعْلَى بْنِ أُمَيَّةَ  ، عَنْ أَبِيهِ ، وَالْحَدِيثُ  لِيَعْلَى ،  لَا مِنْ حَدِيثِ أَبِيهِ  أُمَيَّةَ  .","","Al-Matalib al-Aliyah 1196","","أمية بن أبي عبيدة التميمي عن يعلى بن أمية بن أبي عبيدة الحنظلى عن عطاء بن أبي رباح عن همام بن يحيى بن دينار عن عباس بن الفضل بن العباس بن يعقوب الأزرق عن الحارث بن محمد بن أبي أسامة","باب ما يجتنبه المحرم"
"1461","[6/385]      1197  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ أَبِي عَرُوبَةَ ،  عَنْ  مَطَرٍ الْوَرَّاقِ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، قَالَ :  أَيُّمَا رَجُلٍ تَزَوَّجَ وَهُوَ مُحْرِمٌ انْتَزَعْنَا مِنْهُ امْرَأَتَهُ  ، وَلَمْ يَجُزْ نِكَاحُهُ  .         [6/386]","","Al-Matalib al-Aliyah 1197","","علي بن أبي طالب عن الحسن البصري عن مطر بن طهمان الوراق عن سعيد بن أبي عروبة عن يحيى القطان عن مسدد بن مسرهد","باب ما يجتنبه المحرم"
"1462","[6/387]      1198  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبَانَ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي عَبْدِ اللهِ ، قَالَ :  كُنْتُ مَعَ سَعِيدِ بْنِ جُبَيْرٍ ، فَرَأَى رَجُلًا يُدْخِلُ رَأْسَهُ بَيْنَ السِّتْرِ وَالْبَيْتِ ، فَنَهَاهُ وَقَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا يَقُولُ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يُدْخِلَ الْمُحْرِمُ رَأْسَهُ بَيْنَ السِّتْرِ وَالْجِدَارِ  ، أَوْ بَيْنَ السِّتْرِ وَالْبَيْتِ  .","","Al-Matalib al-Aliyah 1198","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن عمار بن معاوية الدهني عن إسرائيل بن يونس بن أبي إسحاق عن عبد العزيز بن أبان السعيدي عن الحارث بن محمد بن أبي أسامة","باب ما يجتنبه المحرم"
"1463","[6/388]      1199  وَقَالَ إِسْحَاقُ :  أَخْبَرَنَا  وَكِيعٌ ،  عَنْ  وَهْبِ بْنِ عُقْبَةَ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ،  أَنَّ  مَيْمُونَةَ حَلَقَتْ رَأْسَهَا  ،  يَعْنِي مِنْ دَاءٍ بِرَأْسِهَا  .","","Al-Matalib al-Aliyah 1199","","ميمونة بنت الحارث زوج رسول الله عن يزيد بن الأصم بن عبيد البكائي عن وهب بن عقبة البكائي عن وكيع بن الجراح عن إسحاق ابن راهويه","باب ما يجتنبه المحرم"
"1464","[6/390]      28 - بَابُ دُخُولِ  مَكَّةَ  وَفَضْلِهَا  ( 48 ) سَيَأْتِي إِنْ شَاءَ اللهُ تَعَالَى حَدِيثُ  ابْنِ أُمِّ مَكْتُومٍ  رَضِيَ اللهُ عَنْهُ فِي السَّعْيِ ، وَفِيهِ : حَبَّذَا  مَكَّةُ  .  1200  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  ثَنَا  الْحَسَنُ بْنُ يَزِيدَ أَبُو يُونُسَ هُوَ الْقَوِيُّ ، قَالَ :  سَمِعْتُ  عَبْدَ الرَّحْمَنِ بْنَ سَابِطٍ ، يَقُولُ :  لَمَّا خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  الْمَدِينَةِ  يَمْشِي ، ثُمَّ الْتَفَتَ إِلَى  الْبَيْتِ  فَقَالَ :  وَاللهِ مَا أَعْلَمُ بَيْتًا وَضَعَهُ اللهُ تَعَالَى فِي الْأَرْضِ أَحَبَّ إِلَيَّ مِنْكَ وَلَا بَلْدَةً أَحَبَّ إِلَيَّ مِنْكِ  ، وَمَا خَرَجْتُ عَنْكَ رَغْبَةً ، وَلَكِنْ أَخْرَجَنِي الَّذِينَ كَفَرُوا . ثُمَّ نَادَى : يَا  بَنِي عَبْدِ مَنَافٍ  ، لَا يَحِلُّ لِعَبْدٍ أَنْ يَمْنَعَ عَبْدًا يَطُوفُ بِهَذَا الْبَيْتِ أَيَّ سَاعَةٍ شَاءَ مِنْ لَيْلٍ أَوْ نَهَارٍ  .","","Al-Matalib al-Aliyah 1200","","عبد الرحمن بن سابط الجمحي عن الحسن بن يزيد الضمري القوي عن يحيى القطان عن مسدد بن مسرهد","باب دخول مكة وفضلها"
"1465","[6/391]      ( 49 ) وَحَدِيثُ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا فِي هَذَا يَأْتِي فِي تَفْسِيرِ سُورَةِ الْقِتَالِ .  1201  وَقَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  هِشَامٌ هُوَ ابْنُ سُلَيْمَانَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  حَدَّثَ عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  تُرْفَعُ الْأَيْدِي فِي سَبْعَةِ مَوَاطِنَ  : فِي بَدْءِ الصَّلَاةِ ، وَإِذَا رَأَيْتَ  الْبَيْتَ  ، وَعَلَى  الصَّفَا  وَالْمَرْوَةِ  ، وَعَشِيَّةَ  عَرَفَةَ  ،  وَبِجَمْعٍ  ، وَعِنْدَ الْجَمْرَتَيْنِ ، وَعَلَى الْمَيِّتِ  .         [6/392]","","Al-Matalib al-Aliyah 1201","","عبد الله بن عباس عن مقسم بن بجرة عن ابن جريج عن هشام بن سليمان بن عكرمة عن ابن أبي عمر العدني","باب دخول مكة وفضلها"
"1466","[6/393]      29 - بَابُ بَيْعِ  دُورِ  مَكَّةَ  1202  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  فُضَيْلٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  قَالَ  عُمَرُ رَضِيَ اللهُ عَنْهُ :  يَا  أَهْلَ مَكَّةَ  ، لَا تَتَّخِذُوا عَلَى  دُورِكُمْ  أَبْوَابًا  لِيَنْزِلِ الْبَادِي حَيْثُ شَاءَ  .         [6/394]","","Al-Matalib al-Aliyah 1202","","عمر بن الخطاب عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن الفضيل بن عياض عن مسدد بن مسرهد","باب بيع دور مكة"
"1467","[6/395]      30 - بَابُ الطَّوَافِ رَاكِبًا  1203  قَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  ثَنَا  رَوْحٌ ،  ثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  ثَنَا  أَخِي عَبْدُ اللهِ بْنُ عُبَيْدَةَ  ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا قَالَ :  طَافَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى رَاحِلَتِهِ  يَوْمَ فَتْحِ مَكَّةَ  ، يَسْتَلِمُ الْأَرْكَانَ  بِمِحْجَنٍ  كَانَ مَعَهُ  .         [6/396]             [6/397]","","Al-Matalib al-Aliyah 1203","","عبد الله بن عمر بن الخطاب عن عبد الله بن عبيدة بن نشيط الحميري عن موسى بن عبيدة بن نشيط الحميري عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","باب الطواف راكبا"
"1468","[6/398]      31 - بَابُ حَدِّ الْحَرَمِ  1204  قَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  هِشَامُ بْنُ سُلَيْمَانَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُثْمَانَ بْنِ خُثَيْمٍ ، عَنْ مُحَمَّدِ بْنِ الْأَسْوَدِ ،  أَنَّهُ أَخْبَرَهُ  ،  أَنَّ  إِبْرَاهِيمَ  النَّبِيَّ عَلَيْهِ السَّلَامُ هُوَ أَوَّلُ مَنْ نَصَبَ  الْأَنْصَابَ  لِلْحَرَمِ  ، أَشَارَ لَهُ  جِبْرِيلُ  إِلَى مَوَاضِعِهَا  .         [6/399]","","Al-Matalib al-Aliyah 1204","","محمد بن الأسود بن خلف الجمحي عن عبد الله بن عثمان بن خثيم عن ابن جريج عن هشام بن سليمان بن عكرمة عن ابن أبي عمر العدني","باب حد الحرم"
"1469","[6/400]      1205  قَالَ : وَأَخْبَرَنِي أَيْضًا :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ  يَوْمَ فَتْحِ مَكَّةَ  تَمِيمَ بْنَ أَسِيدٍ جَدَّ عَبْدِ الرَّحْمَنِ بْنِ الْمُطَّلِبِ بْنِ تَمِيمٍ  ، فَحَدَّدَهَا  .","","Al-Matalib al-Aliyah 1205","","محمد بن الأسود بن خلف الجمحي عن عبد الله بن عثمان بن خثيم عن ابن جريج عن هشام بن سليمان بن عكرمة عن ابن أبي عمر العدني","باب حد الحرم"
"1470","[6/401]      1206  وَقَالَ أَيْضًا : حَدَّثَنَا نَصْرُ بْنُ ثَابِتٍ ،  عَنْ  صَالِحِ بْنِ أَبِي الْأَخْضَرِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  مُحَمَّدِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  وَجَدَتْ  قُرَيْشٌ  حَجَرًا فِي الْجَاهِلِيَّةِ مِنْ  مَقَامِ إِبْرَاهِيمَ  فِيهِ كِتَابٌ  ، فَجَعَلُوا يُخْرِجُونَهُ إِلَى مَنْ أَتَاهُمْ مِنْ أَهْلِ الْكُتُبِ ، فَلَا يَعْلَمُونَ مَا فِيهِ ، حَتَّى أَتَاهُمْ حَبْرٌ مِنَ  الْيَمَنِ  ، فَقَرَأَهُ عَلَيْهِمْ ، فَإِذَا فِيهِ : أَنَا اللهُ ذُو  بَكَّةَ  صَنَعْتُهَا حِينَ صَنَعْتُ الشَّمْسَ وَالْقَمَرَ ، وَبَارَكْتُ لِأَهْلِهَا فِي اللَّحْمِ وَاللَّبَنِ وَفِي الصَّفْحِ الْآخَرِ : أَنَا اللهُ ذُو  بَكَّةَ  ، خَلَقْتُ الرَّحِمَ وَشَقَقْتُ لَهَا مِنِ اسْمِي ، فَمَنْ وَصَلَهَا وَصَلْتُهُ ، وَمَنْ قَطَعَهَا بَتَتُّهُ ، وَفِي الصَّفْحِ الْآخَرِ : أَنَا اللهُ ذُو  بَكَّةَ  ، خَلَقْتُ الْخَيْرَ وَالشَّرَّ ، فَطُوبَى لِمَنْ كَانَ الْخَيْرُ عَلَى يَدَيْهِ ، وَوَيْلٌ لِمَنْ كَانَ الشَّرُّ عَلَى يَدَيْهِ  .         [6/402]","","Al-Matalib al-Aliyah 1206","","جبير بن مطعم بن عدي النوفلي عن محمد بن جبير بن مطعم النوفلي عن الزهري عن صالح بن أبي الأخضر اليمامي عن نصر بن ثابت عن ابن أبي عمر العدني","باب حد الحرم"
"1471","[6/403]      1207  وَقَالَ أَبُو نُعَيْمٍ فِي الْمَعْرِفَةِ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ جَعْفَرٍ هُوَ أَبُو الشَّيْخِ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  ثَنَا  عَمْرُو بْنُ مَالِكٍ الرَّاسِبِيُّ ،  ثَنَا  الْفُضَيْلُ بْنُ سُلَيْمَانَ ،  ثَنَا  ابْنُ خُثَيْمٍ ،  حَدَّثَنِي  أَبُو الطُّفَيْلِ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعَثَ  تَمِيمَ بْنَ أَسِيدٍ الْخُزَاعِيَّ  يُجَدِّدُ  أَنْصَابَ  الْحَرَمِ  ، وَكَانَ  إِبْرَاهِيمُ  عَلَيْهِ السَّلَامُ وَضَعَهَا ، يُرِيهَا إِيَّاهُ  جِبْرِيلُ  عَلَيْهِ الصَّلَاةُ وَالسَّلَامُ  .","","Al-Matalib al-Aliyah 1207","","عبد الله بن عباس عن عامر بن واثلة عن عبد الله بن عثمان بن خثيم عن فضيل بن سليمان النميري عن عمرو بن مالك بن عمر الراسبي عن محمد بن عبد الله بن رسته الضبي عن أبو الشيخ الأصبهانى عن أبو نعيم الأصبهاني","باب حد الحرم"
"1472","[6/404]      1208  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عَمْرُو بْنُ الضَّحَّاكِ ،  ثَنَا  أَبِي  ،  ثَنَا  عِمْرَانُ الْقَطَّانُ ،  عَنْ  مُطَرِّفٍ ،  عَنْ  طَلْحَةَ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنِ اسْتَحَلَّ شَيْئًا مِنْ حُدُودِ  مَكَّةَ  فَعَلَيْهِ لَعْنَةُ اللهِ  . الْحَدِيثَ  .","","Al-Matalib al-Aliyah 1208","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن مطرف بن طريف عن عمران بن داور القطان عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن أبو يعلى الموصلي","باب حد الحرم"
"1473","[6/405]      32 - بَابُ كَرَاهِيَةِ كِرَاءِ  دُورِ  مَكَّةَ  أَيَّامَ الْمَوْسِمِ  1209  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  عِيسَى بْنُ يُونُسَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ أَبِي زِيَادٍ ،  سَمِعْتُ  ابْنَ جُرَيْجٍ  يُحَدِّثُ ، عَنْ  عَطَاءٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا :  أَنَّ الَّذِي يَأْكُلُ كِرَا بُيُوتِ  مَكَّةَ  ، إِنَّمَا يَأْكُلُ فِي بَطْنِهِ نَارًا  .         [6/406]","","Al-Matalib al-Aliyah 1209","","عبد الله بن عمرو بن العاص عن عطاء بن أبي رباح عن ابن جريج عن عبيد الله بن أبي زياد القداح عن عيسى بن يونس بن أبي إسحاق عن مسدد بن مسرهد","باب كراهية كراء دور مكة أيام الموسم"
"1474","[6/407]      1210  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  الْحَجَّاجُ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُ ، قَالَ :  نُهِيَ عَنْ أُجُورِ بُيُوتِ  مَكَّةَ  ، وَعَنْ بَيْعِ  رِبَاعِهَا  .         [6/408]","","Al-Matalib al-Aliyah 1210","","عبد الله بن عمرو بن العاص عن عطاء بن أبي رباح عن حجاج بن أرطاة عن هشيم بن بشير عن أحمد بن منيع البغوي","باب كراهية كراء دور مكة أيام الموسم"
"1475","[6/409]      33 - بَابُ الْكَلَامِ فِي الطَّوَافِ  1211  قَالَ إِسْحَاقُ :  أَخْبَرَنَا  قَبِيصَةُ بْنُ عُقْبَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  رَجُلٍ مِنْ أَهْلِ مَكَّةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  بَيْنَمَا أَنَا أَطُوفُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذْ وَقَفَ وَتَبَسَّمَ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، رَأَيْتُكَ وَقَفْتَ وَتَبَسَّمْتَ ؟ فَقَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَقِيَنِي  عِيسَى  يَطُوفُ مَعَهُ مَلَكَانِ  ، فَسَلَّمَ عَلَيَّ ، فَسَلَّمْتُ عَلَيْهِ  .         [6/410]","","Al-Matalib al-Aliyah 1211","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن رجل من أهل مكة عن سفيان الثوري عن قبيصة بن عقبة السوائي عن إسحاق ابن راهويه","باب الكلام في الطواف"
"1476","[6/411]      1212  / 1  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ  عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ  رَضِيَ اللهُ عَنْهُ يَطُوفُ  بِالْبَيْتِ  وَهُوَ  يَحْدُو  وَعَلَيْهِ خُفَّانِ  ، فَقَالَ لَهُ  عُمَرُ  رَضِيَ اللهُ عَنْهُ : مَا أَدْرِي أَيُّهُمَا أَعْجَبُ ، حِدَاؤُكَ حَوْلَ  الْبَيْتِ  ، أَوْ طَوَافُكَ فِي نَعْلَيْكَ ، قَالَ : قَدْ فَعَلْتُ هَذَا عَلَى عَهْدِ مَنْ هُوَ خَيْرٌ مِنْكَ ، رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمْ يَعِبْ ذَلِكَ عَلَيَّ  .","","Al-Matalib al-Aliyah 1212","","عامر بن ربيعة بن كعب العنزي عن عبد الله بن عامر بن ربيعة العنزي عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن أبو يعلى الموصلي","باب الكلام في الطواف"
"1477","1212  / 2  -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  ثَنَا  شَرِيكٌ ، فَذَكَرَهُ .","","Al-Matalib al-Aliyah 1212","","عامر بن ربيعة بن كعب العنزي عن عبد الله بن عامر بن ربيعة العنزي عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن شريك بن عبد الله النخعي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","باب الكلام في الطواف"
"1478","[6/412]      34 - بَابُ الطَّوَافِ فِي الْخُفِّ وَالنَّعْلِ  ( 50 ) تَقَدَّمَ فِي الْبَابِ قَبْلَهُ .  1213  / 1  -  وَقَالَ أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  حَدَّثَنَا  عُمَرُ بْنُ قَيْسٍ سَنْدَلٌ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الطَّوَافِ ، فَانْقَطَعَ نَعْلُهُ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، نَاوِلْنِي أُصْلِحْهُ . قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَذِهِ الْأَثَرَةُ ، وَلَا أُحِبُّ الْأَثَرَةَ  .         [6/413]","","Al-Matalib al-Aliyah 1213","","عامر بن ربيعة بن كعب العنزي عن عبد الله بن عامر بن ربيعة العنزي عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن عمر بن قيس سندل عن أبو داود الطيالسي","باب الطواف في الخف والنعل"
"1479","1213  / 2  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ، وَإِسْحَاقُ هُوَ ابْنُ أَبِي إِسْرَائِيلَ ، قَالَا :  ثَنَا  عُمَرُ بْنُ عَلِيِّ بْنِ مُقَدَّمٍ ،  ثَنَا  عُمَرُ مَوْلَى بَنِي مَنْظُورِ بْنِ سَيَّارٍ ،  ثَنَا  عَاصِمُ بْنُ عُبَيْدِ اللهِ ، فَذَكَرَهُ بِلَفْظِ :  كَانَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَطُوفُ  بِالْبَيْتِ  ، فَانْقَطَعَ  شِسْعُهُ  ، فَأَخْرَجَ  رَجُلٌ  شِسْعًا  مِنْ نَعْلِهِ ، فَذَهَبَ يَشُدُّهُ فِي نَعْلِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَانْتَزَعَهَا وَقَالَ :  هَذِهِ أَثَرَةٌ ، وَلَا أُحِبُّ الْأَثَرَةَ  .         [6/414]","","Al-Matalib al-Aliyah 1213","","عامر بن ربيعة بن كعب العنزي عن عبد الله بن عامر بن ربيعة العنزي عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن عمر بن قيس سندل عن عمر بن علي بن عطاء عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","باب الطواف في الخف والنعل"
"1480","[6/415]      35 - بَابُ مَا يَقُولُ فِي الطَّوَافِ  1214  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  حَدَّثَنِي  عَاصِمُ بْنُ بَهْدَلَةَ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  حَبِيبِ بْنِ صُهْبَانَ قَالَ :  رَأَيْتُ  عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُمَا يَطُوفُ  بِالْبَيْتِ  وَهُوَ يَقُولُ  بَيْنَ الْبَابِ وَالرُّكْنِ ، أَوْ بَيْنَ الْمَقَامِ وَالْبَابِ  :         {      رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ         }      .         [6/416]             [6/417]","","Al-Matalib al-Aliyah 1214","","عمر بن الخطاب عن حبيب بن صهبان الكاهلي عن المسيب بن رافع الكاهلي عن عاصم بن بهدلة عن سفيان الثوري عن يحيى القطان عن مسدد بن مسرهد","باب ما يقول في الطواف"
"1481","[6/418]      36 - بَابُ الطَّوَافِ لِلرَّاكِبِ  1215  قَالَ إِسْحَاقُ :  أَخْبَرَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  عَطَاءٌ ،  بَلَغَنِي  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ امْرَأَتَهُ أَنْ تَطُوفَ رَاكِبَةً فِي خِدْرِهَا مِنْ وَرَاءِ الْمُصَلِّينَ  فِي جَوْفِ الْمَسْجِدِ . فَقُلْتُ : أَلَيْلًا أَوْ نَهَارًا ؟ قَالَ : لَا أَدْرِي ، قُلْتُ : فِي أَيِّ سَبْعٍ ؟ قَالَ : لَا أَدْرِي .  قُلْتُ :  هَذَا  مُرْسَلٌ  رِجَالُهُ رِجَالُ الصَّحِيحِ  .  وَأَصْلُهُ مَوْصُولٌ عِنْدَ الشَّيْخَيْنِ فِي الصَّحِيحَيْنِ مِنْ رِوَايَةِ  عُرْوَةَ  ، عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ  ، عَنْ  أُمِّ سَلَمَةَ  ، وَفِي بَعْضِ طُرُقِهِ أَنَّهَا صَلَاةُ الصُّبْحِ ، وَأَنَّهُ طَوَافُ الْوَدَاعِ  .","","Al-Matalib al-Aliyah 1215","","عطاء بن أبي رباح عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق ابن راهويه","باب الطواف للراكب"
"1482","[6/419]      37 - بَابُ فَضْلِ الطَّوَافِ  1216  قَالَ أَبُو يَعْلَى :  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ ،  ثَنَا  الْحُسَيْنُ يَعْنِي الْجُعْفِيَّ ،  عَنِ  ابْنِ السَّمَّاكِ ،  عَنْ  عَائِذٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ تَعَالَى  يُبَاهِي  بِالطَّائِفِينَ  .  عَائِذٌ هَذَا هُوَ ابْنُ نُسَيْرٍ  ، بِنُونٍ وَمُهْمَلَةٍ مُصَغَّرٌ ،  ضَعِيفٌ  ،  وَابْنُ السَّمَّاكِ مُحَمَّدُ بْنُ صُبَيْحٍ  فِيهِ ضَعْفٌ  أَيْضًا  .         [6/420]","","Al-Matalib al-Aliyah 1216","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن عائذ بن نسير عن محمد بن صبيح بن السماك الكوفي عن الحسين بن علي الجعفي عن الحسن بن حماد سجادة عن أبو يعلى الموصلي","باب فضل الطواف"
"1483","[6/421]      1217  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ الْجَعْدِيِّ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ، أَنَّ مَوْلَاةً لِعَبْدِ اللهِ بْنِ عَمْرٍو  حَدَّثَتْهُ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، عَنْ نَبِيِّ اللهِ قَالَ :  مَنْ طَافَ  بِالْبَيْتِ  سَبْعًا ، وَصَلَّى خَلْفَ الْمَقَامِ رَكْعَتَيْنِ  ، فَهُوَ كَفَكِّ رَقَبَةٍ  .         [6/422]","","Al-Matalib al-Aliyah 1217","","عبد الله بن عمرو بن العاص عن مولاة لعبد الله بن عمرو عن عطاء بن أبي رباح عن قتادة بن دعامة عن حماد بن الجعد الهذلي عن هدبة بن خالد عن أبو يعلى الموصلي","باب فضل الطواف"
"1484","[6/423]      38 - بَابُ قَرْنِ الطَّوَافِ  1218  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  إِسْمَاعِيلُ ،  عَنْ  مُحَمَّدِ بْنِ السَّائِبِ بْنِ بَرَكَةَ ،  عَنْ  أُمِّهِ  ،  أَنَّ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا كَانَتْ تَطُوفُ ثَلَاثَةَ أَسَابِيعَ تَقْرِنُ بَيْنَهُنَّ  ، ثُمَّ تُصَلِّي لِكُلِّ  أُسْبُوعٍ  رَكْعَتَيْنِ  .         [6/424]","","Al-Matalib al-Aliyah 1218","","عائشة بنت أبي بكر الصديق عن أم محمد بن السائب بن بركة عن محمد بن السائب بن بركة الحجازي عن إسماعيل ابن علية عن مسدد بن مسرهد","باب قرن الطواف"
"1485","[6/425]      1219  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ جَامِعٍ الْعَطَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ أَبِي الْجَنُوبِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ قَالَ :  طَافَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَبْلَ الْفَجْرِ  ، ثُمَّ صَلَّى سِتَّ رَكَعَاتٍ يَلْتَفِتُ فِي كُلِّ رَكْعَتَيْنِ يَمِينًا وَشِمَالًا . قَالَ : فَظَنَنَّا أَنَّهُ لِكُلِّ أُسْبُوعٍ رَكْعَتَيْنِ ، وَلَمْ يُسَلِّمْ  .  إِسْنَادُهُ  ضَعِيفٌ  .","","Al-Matalib al-Aliyah 1219","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن عبد السلام بن أبي الجنوب المدني عن محمد بن عثمان بن صفوان الجمحي عن محمد بن جامع العطار عن أبو يعلى الموصلي","باب قرن الطواف"
"1486","[6/426]      39 - بَابُ الْمُزَاحَمَةِ عَلَى تَقْبِيلِ الْحَجَرِ الْأَسْوَدِ وَفَضْلِهِ  1220  قَالَ أَبُو يَعْلَى :  حَدَّثَنَا  شَيْبَانُ هُوَ ابْنُ فَرُّوخَ ،  ثَنَا  جَرِيرٌ هُوَ ابْنُ حَازِمٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا :  أَنَّهُ كَانَ يُزَاحِمُ عَلَى الرُّكْنِ ، فَإِذَا رَأَوْهُ أَوْسَعُوا لَهُ  . قَالَ نَافِعٌ :  فَلَقَدْ وَقَعْتُ يَوْمًا فِي زِحَامِ النَّاسِ  ، فَوَضَعَ رَجُلٌ مِرْفَقَهُ مِنْ خَلْفِي ، وَوَقَعَ الرَّجُلُ مِنْ أَمَامِهِ ، وَوَقَعْتُ مِنْ خَلْفِي ، فَمَا ظَنَنْتُ أَنْ أَنْقَلِبَ حَتَّى يَقْتُلُونِي ، وَأَبَى هُوَ إِلَّا أَنْ يَتَقَدَّمَ  .         [6/427]             [6/428]","","Al-Matalib al-Aliyah 1220","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جرير بن حازم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","باب المزاحمة على تقبيل الحجر الأسود وفضله"
"1487","[6/429]      1221  وَقَالَ أَبُو دَاوُدَ الطَّيَالِسِيُّ :  حَدَّثَنَا  الْمَسْعُودِيُّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ :  أَنَّهُ كَانَ إِذَا مَرَّ بِالْحَجَرِ الْأَسْوَدِ فَرَأَى عَلَيْهِ زِحَامًا اسْتَقْبَلَهُ وَكَبَّرَ  ، وَقَالَ : اللَّهُمَّ إِيمَانًا بِكَ وَسُنَّةِ نَبِيِّكَ  .","","Al-Matalib al-Aliyah 1221","","علي بن أبي طالب عن الحارث الأعور عن أبو إسحاق السبيعي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن أبو داود الطيالسي","باب المزاحمة على تقبيل الحجر الأسود وفضله"
"1488","[6/430]      1222  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  حَمَّادٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ،  رَفَعَهُ  :  لَوْلَا مَا مَسَّهُ مِنْ أَنْجَاسِ الْجَاهِلِيَّةِ  ، مَا مَسَّهُ ذُو عَاهَةٍ إِلَّا شُفِيَ ، وَمَا عَلَى الْأَرْضِ مِنَ الْجَنَّةِ شَيْءٌ غَيْرُهُ  .         [6/431]","","Al-Matalib al-Aliyah 1222","","عبد الله بن عمرو بن العاص عن عطاء بن أبي رباح عن ابن جريج عن حماد بن زيد عن مسدد بن مسرهد","باب المزاحمة على تقبيل الحجر الأسود وفضله"
"1489","[6/432]      1223  وَقَالَ مُحَمَّدُ بْنُ أَبِي عُمَرَ :  حَدَّثَنَا  يَحْيَى بْنُ سُلَيْمٍ ،  سَمِعْتُ  ابْنَ جُرَيْجٍ ، يَقُولُ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبَّادِ بْنِ جَعْفَرٍ ، يَقُولُ :  سَمِعْتُ  ابْنَ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا يَقُولُ :  إِنَّ هَذَا الرُّكْنَ يَمِينُ اللهِ فِي الْأَرْضِ  يُصَافِحُ بِهَا عِبَادَهُ  مُصَافَحَةَ  الرَّجُلِ أَخَاهُ  .  هَذَا  مَوْقُوفٌ  صَحِيحٌ  .         [6/433]","","Al-Matalib al-Aliyah 1223","","عبد الله بن عباس عن محمد بن عباد بن جعفر المخزومي عن ابن جريج عن يحيى بن سليم الطائفي عن ابن أبي عمر العدني","باب المزاحمة على تقبيل الحجر الأسود وفضله"
"1490","[6/434]      1224  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ بْنِ عُقْبَةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  نَزَلَ بِالْحَجَرِ الْأَسْوَدِ مَلَكٌ  .","","Al-Matalib al-Aliyah 1224","","عبد الله بن عباس عن أبو الزبير المكي عن إسماعيل بن إبراهيم بن عقبة الأسدي عن الواقدي عن الحارث بن محمد بن أبي أسامة","باب المزاحمة على تقبيل الحجر الأسود وفضله"
"1491","[6/435]      1225  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  قَالَ لِي النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَيْفَ صَنَعْتَ فِي اسْتِلَامِ الْحَجَرِ ؟  قَالَ : قُلْتُ :  اسْتَلَمْتُ  وَتَرَكْتُ . قَالَ : أَصَبْتَ  .  رُوَاتُهُ ثِقَاتٌ  ، فَإِنْ كَانَ  عُرْوَةُ  سَمِعَهُ مِنْ  عَبْدِ الرَّحْمَنِ  رَضِيَ اللهُ عَنْهُ ، فَهُوَ صَحِيحٌ ،  وَحَمَلَهُ  الشَّافِعِيُّ  عَلَى أَنَّهُ لَمْ يَسْتَلِمْ حَالَ الْمُزَاحَمَةِ ،  وَاسْتَلَمَ  فِي غَيْرِهَا  .         [6/436]","","Al-Matalib al-Aliyah 1225","","عبد الرحمن بن عوف بن عبد عوف القرشي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سفيان الثوري عن الفضل بن دكين عن الحارث بن محمد بن أبي أسامة","باب المزاحمة على تقبيل الحجر الأسود وفضله"
"1492","[6/437]      1226  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  حَدَّثَنِي  عُمَرُ بْنُ سَعِيدٍ ،  حَدَّثَنِي  مَنْبُوذٌ ،  عَنْ  أُمِّهِ  ، قَالَتْ :  كُنْتُ عِنْدَ عَائِشَةَ رَضِيَ اللهُ عَنْهَا إِذِ انْتَهَتْ مَوْلَاةٌ لَهَا  ، فَقَالَتْ : إِنِّي  اسْتَلَمْتُ  الْحَجَرَ ثَلَاثَ مَرَّاتٍ فِي سَبْعٍ طُفْتُهُ ،  فَقَالَتْ  : لَا آجَرَكِ اللهُ ، مَرَّتَيْنِ أَوْ ثَلَاثًا ، هَلَّا كَبَّرْتِ وَعَقَدْتِ ، وَمَرَرْتِ ، أَرَدْتِ أَنْ تُدَافِعِي الرِّجَالَ  .         [6/438]","","Al-Matalib al-Aliyah 1226","","عائشة بنت أبي بكر الصديق عن أم منبوذ بنت محيصة عن منبوذ بن أبي سليمان السامي عن عمر بن سعيد النوفلي عن يحيى القطان عن مسدد بن مسرهد","باب المزاحمة على تقبيل الحجر الأسود وفضله"
"1493","[6/439]      40 - بَابُ مَا يُقْرَأُ فِي رَكْعَتَيِ الطَّوَافِ  1227  - قَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  يَعْقُوبَ بْنِ زَيْدٍ قَالَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَرَأَ فِي رَكْعَتَيِ الطَّوَافِ  بِـ :         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ، وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .  هَذَا  مُرْسَلٌ  ،  وَمُوسَى  ضَعِيفٌ  .","","Al-Matalib al-Aliyah 1227","","يعقوب بن زيد بن طلحة بن عبد الله بن أبي مليكة التيمي عن موسى بن عبيدة بن نشيط الحميري عن وكيع بن الجراح عن ابن أبي عمر العدني","باب ما يقرأ في ركعتي الطواف"
"1494","[6/440]      41 - بَابُ السُّجُودِ عَلَى الْحَجَرِ الْأَسْوَدِ  1228  قَالَ إِسْحَاقُ :  أَخْبَرَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  حَنْظَلَةُ ،  عَنْ  طَاوُسٍ ، قَالَ :  كَانَ عُمَرُ رَضِيَ اللهُ عَنْهُ يُقَبِّلُ الْحَجَرَ  ، ثُمَّ يَسْجُدُ عَلَيْهِ ، ثُمَّ يُقَبِّلُهُ ، ثُمَّ يَسْجُدُ عَلَيْهِ ثَلَاثَ مَرَّاتٍ  . الْحَدِيثَ . بَاقِيَهُ أَخْرَجُوهُ  .","","Al-Matalib al-Aliyah 1228","","عمر بن الخطاب عن طاوس بن كيسان عن حنظلة الجمحي عن عبيد الله بن موسى عن إسحاق ابن راهويه","باب السجود على الحجر الأسود"
"1495","[6/441]      1229  وَقَالَ أَبُو دَاوُدَ الطَّيَالِسِيُّ :  حَدَّثَنَا  جَعْفَرُ بْنُ عَبْدِ اللهِ بْنِ عُثْمَانَ الْقُرَشِيُّ ، مِنْ  أَهْلِ مَكَّةَ  ، قَالَ :  رَأَيْتُ  مُحَمَّدَ بْنَ عَبَّادِ بْنِ جَعْفَرٍ قَبَّلَ الْحَجَرَ وَسَجَدَ عَلَيْهِ  ،  وَقَالَ  : رَأَيْتُ خَالِي ابْنَ عَبَّاسٍ قَبَّلَهُ رَضِيَ اللهُ عَنْهُمَا وَسَجَدَ عَلَيْهِ ،  وَقَالَ  : رَأَيْتُ عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ قَبَّلَ الْحَجَرَ وَسَجَدَ عَلَيْهِ  .         [6/442]             [6/443]","","Al-Matalib al-Aliyah 1229","","عمر بن الخطاب عن عبد الله بن عباس عن محمد بن عباد بن جعفر المخزومي عن جعفر بن عبد الله بن عثمان الحميدي عن أبو داود الطيالسي","باب السجود على الحجر الأسود"
"1496","[6/444]      1230  وَقَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ :  حَدَّثَنَا  خَالِدُ بْنُ مَخْلَدٍ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  شَرِيكِ بْنِ عَبْدِ اللهِ بْنِ أَبِي نَمِرٍ ،  عَنْ  عِيسَى بْنِ طَلْحَةَ ،  عَنْ  رَجُلٍ  رَأَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَفَ عِنْدَ الْحَجَرِ فَقَالَ :  إِنِّي لَأَعْلَمُ أَنَّكَ حَجَرٌ لَا تَضُرُّ وَلَا تَنْفَعُ  ، ثُمَّ قَبَّلَهُ ،  ثُمَّ حَجَّ أَبُو بَكْرٍ رَضِيَ اللهُ عَنْهُ فَوَقَفَ عِنْدَ الْحَجَرِ ، ثُمَّ  قَالَ  : إِنِّي لَأَعْلَمُ أَنَّكَ حَجَرٌ لَا تَضُرُّ وَلَا  تَنْفَعُ ، وَلَوْلَا أَنِّي رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُقَبِّلُكَ مَا قَبَّلْتُكَ  .","","Al-Matalib al-Aliyah 1230","","أبو  بكر الصديق عن أحد الصحابة عن عيسى بن طلحة التيمي عن شريك بن عبد الله بن أبي نمر الكناني عن سليمان بن بلال القرشي عن خالد بن مخلد القطواني عن أبو بكر ابن أبي شيبة","باب السجود على الحجر الأسود"
"1497","[6/445]      42 - بَابُ طَوَافِ الْمَرْأَةِ  1231  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ جُرَيْجٍ ،  ثَنَا  الْحَسَنُ بْنُ مُسْلِمٍ ،  عَنْ  صَفِيَّةَ بِنْتِ شَيْبَةَ ، قَالَتْ :  كَانَتْ عَائِشَةُ رَضِيَ اللهُ عَنْهَا تَطُوفُ بِالْبَيْتِ مُنَقَّبَةً  .  قَالَ : وَكَانَ عَطَاءٌ يَكْرَهُهُ ، حَتَّى حَدَّثْتُهُ بِهَذَا الْحَدِيثِ ، فَكَانَ بَعْدَ ذَلِكَ يُفْتِي بِهِ .","","Al-Matalib al-Aliyah 1231","","عائشة بنت أبي بكر الصديق عن صفية بنت شيبة الحجبية عن الحسن بن مسلم بن يناق عن ابن جريج عن يحيى القطان عن مسدد بن مسرهد","باب طواف المرأة"
"1498","[7/5]      43 - بَابُ الْوُقُوفِ  بِعَرَفَةَ  وَالْإِفَاضَةِ  1232  -  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  زُرَارَةَ بْنِ أَوْفَى ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  قَالَ  :  الْحَجُّ  عَرَفَةُ  ، وَالْعُمْرَةُ الطَّوَافُ  .         [7/6]","","Al-Matalib al-Aliyah 1232","","عبد الله بن عباس عن زرارة بن أوفى عن قتادة بن دعامة عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد","باب الوقوف بعرفة والإفاضة"
"1499","[7/7]      1233  وَقَالَ مُسَدَّدٌ أَيْضًا :  حَدَّثَنَا  خَالِدٌ - هُوَ الطَّحَّانُ -  ثَنَا  حُمَيْدٌ - هُوَ الطَّوِيلُ -  عَنْ  بَكْرٍ - هُوَ ابْنُ عَبْدِ اللهِ الْمُزَنِيُّ -  عَنِ  ابْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  مَنْ أَدْرَكَ  عَرَفَةَ  فَقَدْ أَدْرَكَ  الْحَجَّ  ، وَمَنْ فَاتَهُ  عَرَفَةُ  ، فَقَدْ فَاتَهُ  الْحَجُّ  .  ( صَحِيحٌ مَوْقُوفٌ ) .","","Al-Matalib al-Aliyah 1233","","عبد الله بن عمر بن الخطاب عن بكر بن عبد الله المزني عن حميد الطويل عن خالد بن عبد الله الطحان عن مسدد بن مسرهد","باب الوقوف بعرفة والإفاضة"
"1500","[7/8]      1234  إِسْحَاقُ :  أَخْبَرَنَا  جَرِيرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  رَبِيعَةَ الْقُرَشِيِّ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَاقِفًا فِي الْجَاهِلِيَّةِ  بِعَرَفَاتٍ  مَعَ الْمُشْرِكِينَ  ، وَرَأَيْتُهُ وَاقِفًا فِي الْإِسْلَامِ فِي ذَلِكَ الْمَوْقِفِ ، فَعَرَفْتُ أَنَّ اللهَ - تَبَارَكَ وَتَعَالَى - وَقَفَهُ لِذَلِكَ  .  هَذَا حَدِيثٌ  غَرِيبُ الْإِسْنَادِ  .         [7/9]","","Al-Matalib al-Aliyah 1234","","أبو ربيعة القرشي عن ربيعة القرشي عن عطاء بن السائب عن جرير بن عبد الحميد عن إسحاق ابن راهويه","باب الوقوف بعرفة والإفاضة"
"1501","[7/10]      1235  أَبُو بَكْرٍ :  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  نَافِعِ بْنِ عُمَرَ ،  عَنْ  سَعِيدِ بْنِ حَسَّانَ ،  عَنِ  ابْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْزِلُ وَادِي  نَمِرَةَ  .","","Al-Matalib al-Aliyah 1235","","عبد الله بن عمر بن الخطاب عن سعيد بن حسان الحجازي عن نافع بن عمر بن عبد الله بن جميل الجمحي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة","باب الوقوف بعرفة والإفاضة"
"1502","[7/11]      1236  / 1  -  حَدَّثَنَا  عَلِيُّ بْنُ هَاشِمٍ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَتَى  جِبْرِيلُ  إِبْرَاهِيمَ  - عَلَيْهِمَا الصَّلَاةُ وَالسَّلَامُ - فَرَاحَ بِهِ إِلَى  مِنًى  ، فَصَلَّى بِهِ الصَّلَوَاتِ جَمِيعًا ، ثُمَّ صَلَّى بِهِ الْفَجْرَ ، ثُمَّ غَدَا بِهِ إِلَى  عَرَفَةَ  ، فَنَزَلَ بِهِ حَيْثُ يَنْزِلُ النَّاسُ ، ثُمَّ صَلَّى بِهِ الصَّلَاتَيْنِ جَمِيعًا ، ثُمَّ أَتَى بِهِ الْمَوْقِفَ ، حَتَّى إِذَا كَانَ كَأَعْجَلِ مَا يُصَلِّي أَحَدٌ مِنَ النَّاسِ الْمَغْرِبَ  أَفَاضَ  فَأَتَى بِهِ جَمْعًا ، فَصَلَّى بِهِ الْعِشَاءَيْنِ جَمِيعًا ، ثُمَّ بَاتَ حَتَّى إِذَا كَانَ كَأَعْجَلِ مَا يُصَلِّي أَحَدٌ مِنَ النَّاسِ الْفَجْرَ صَلَّى بِهِ الْفَجْرَ ، ثُمَّ وَقَفَ بِهِ ، حَتَّى إِذَا كَانَ كَأَبْطَأِ مَا يُصَلِّي أَحَدٌ مِنَ النَّاسِ  أَفَاضَ  بِهِ إِلَى  مِنًى  ، فَرَمَى  الْجَمْرَةَ  ، ثُمَّ ذَبَحَ وَحَلَقَ ، ثُمَّ  أَفَاضَ  بِهِ ، ثُمَّ أَوْحَى اللهُ تَعَالَى بَعْدُ إِلَى نَبِيِّهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         {      أَنِ اتَّبِعْ مِلَّةَ إِبْرَاهِيمَ حَنِيفًا         }      .","","Al-Matalib al-Aliyah 1236","","عبد الله بن عمرو بن العاص عن ابن أبي مليكة عن محمد بن عبد الرحمن بن أبي ليلى عن علي بن هاشم العائذي عن أبو بكر ابن أبي شيبة","باب الوقوف بعرفة والإفاضة"
"1503","1236  / 2  -  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  أَيُّوبَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ، قَالَ :  إِنَّ  رَجُلًا مِنْ قُرَيْشٍ  قَالَ لِعَبْدِ اللهِ بْنِ عَمْرٍو - رَضِيَ اللهُ عَنْهُمَا - : إِنِّي ضَعِيفٌ مِنَ الْأَهْلِ  وَالْحَمُولَةِ  ، وَإِنَّمَا  حَمُولَتُنَا  هَذِهِ الْحُمُرُ الدَّبَّابَةُ ، أَلَا أُفِيضُ مِنْ  جَمْعٍ  بِلَيْلٍ ؟ فَقَالَ :  أَمَّا  إِبْرَاهِيمُ  فَإِنَّهُ بَاتَ  بِمِنًى  ، حَتَّى إِذَا أَصْبَحَ فَطَلَعَ حَاجِبُ الشَّمْسِ سَارَ إِلَى  عَرَفَةَ  ، حَتَّى نَزَلَ مَنْزِلًا مِنْهَا ، ثُمَّ رَاحَ ، ثُمَّ وَقَفَ مَوْقِفَهُ مِنْهَا ، حَتَّى إِذَا غَابَتِ الشَّمْسُ  أَفَاضَ  ، حَتَّى إِذَا أَتَى  جَمْعًا  ، فَنَزَلَ مَنْزِلَهُ مِنْهُ ، حَتَّى إِذَا كَانَ صَلَاةُ الصُّبْحِ الْمُعَجَّلَةُ وَقَفَ ، حَتَّى إِذَا كَانَ الصُّبْحُ الْمُسْفِرُ  أَفَاضَ  . فَذَلِكَ مِلَّةُ  إِبْرَاهِيمَ  - عَلَيْهِ السَّلَامُ - وَقَدْ أُمِرَ نَبِيُّكُمْ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَتَّبِعَهُ  .  [3]","","Al-Matalib al-Aliyah 1236","","عبد الله بن عمرو بن العاص عن ابن أبي مليكة عن أيوب السختياني عن إسماعيل ابن علية عن أحمد بن منيع البغوي","باب الوقوف بعرفة والإفاضة"
"1504","1236  / 3  - وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  زُهَيْرُ بْنُ حَرْبٍ ،  ثَنَا  إِسْمَاعِيلُ بِهَذَا .         [7/12]","","Al-Matalib al-Aliyah 1236","","عبد الله بن عمرو بن العاص عن ابن أبي مليكة عن أيوب السختياني عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","باب الوقوف بعرفة والإفاضة"
"1505","1236  / 4  -  وَقَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سُلَيْمَانَ بْنِ إِبْرَاهِيمَ بْنِ عَبْدِ الرَّحْمَنِ النَّوْفَلِيُّ ،  عَنْ  رَجُلٍ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  أَفَاضَ  جِبْرِيلُ  - عَلَيْهِ الصَّلَاةُ وَالسَّلَامُ - بِالنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى أَتَى  مُزْدَلِفَةَ  فَنَزَلَ بِهَا وَبَاتَ  ، ثُمَّ صَلَّى الصُّبْحَ كَأَعْجَلِ مَا يُصَلِّي أَحَدٌ مِنَ الْمُسْلِمِينَ ، ثُمَّ وَقَفَ بِهِ كَأَبْطَأِ مَا يُصَلِّي أَحَدٌ مِنَ الْمُسْلِمِينَ ، ثُمَّ دَفَعَ إِلَى  مِنًى  فَرَقَى وَذَبَحَ ، ثُمَّ أَوْحَى اللهُ - تَبَارَكَ وَتَعَالَى - إِلَى  مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         {      ثُمَّ أَوْحَيْنَا إِلَيْكَ أَنِ اتَّبِعْ مِلَّةَ إِبْرَاهِيمَ حَنِيفًا         }      الْآيَةَ  .         [7/13]","","Al-Matalib al-Aliyah 1236","","عبد الله بن عمرو بن العاص عن ابن أبي مليكة عن محمد بن عبد الرحمن بن أبي ليلى عن سفيان الثوري عن رجل عن إبراهيم بن سليمان بن إبراهيم بن عبد الرحمن النوفلي عن ابن أبي عمر العدني","باب الوقوف بعرفة والإفاضة"
"1506","[7/14]      1237  الْحَارِثُ ،  حَدَّثَنَا  يَزِيدُ - هُوَ ابْنُ هَارُونَ -  ثَنَا  الْعَوَّامُ بْنُ حَوْشَبٍ ،  حَدَّثَنِي  السَّفَّاحُ بْنُ مَطَرٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عَبْدِ اللهِ بْنِ خَالِدِ بْنِ أَسِيدٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عَرَفَةُ  يَوْمَ يُعْرَفُ النَّاسُ  .","","Al-Matalib al-Aliyah 1237","","عبد العزيز بن عبد الله بن خالد الأموي عن السفاح بن مطر الشيباني عن العوام بن حوشب عن يزيد بن هارون عن الحارث بن محمد بن أبي أسامة","باب الوقوف بعرفة والإفاضة"
"1507","[7/15]      1238  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ ،  ثَنَا  صَالِحُ بْنُ خَوَّاتٍ ،  عَنْ  يَزِيدَ بْنِ رُومَانَ ،  عَنْ  حَبِيبِ بْنِ عُمَيْرٍ ،  عَنْ  حَبِيبِ بْنِ خُمَاشَةَ الْخَطْمِيِّ - رَضِيَ اللهُ عَنْهُ - قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ  بِعَرَفَةَ  :  عَرَفَةُ  كُلُّهَا مَوْقِفٌ  ، إِلَّا بَطْنَ  عُرَنَةَ  ،  وَالْمُزْدَلِفَةُ  كُلُّهَا مَوْقِفٌ إِلَّا بَطْنَ  مُحَسِّرٍ  .         [7/16]","","Al-Matalib al-Aliyah 1238","","حبيب بن خماشة الخطمي عن حبيب بن عمير عن يزيد بن رومان الأسدي عن صالح بن خوات الأنصاري عن الواقدي عن الحارث بن محمد بن أبي أسامة","باب الوقوف بعرفة والإفاضة"
"1508","[7/17]      44 - بَابُ الدُّعَاءِ يَوْمَ عَرَفَةَ وَفَضْلِهِ  1239  إِسْحَاقُ :  أَخْبَرَنَا  وَكِيعٌ ،  ثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُبَيْدَةَ ،  عَنْ  عَلِيٍّ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَكْثَرُ  دُعَائِي  وَدُعَاءِ  الْأَنْبِيَاءِ قَبْلِي  بِعَرَفَةَ  : لَا إِلَهَ إِلَّا اللهُ  ، وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ . اللَّهُمَّ اجْعَلْ فِي سَمْعِي  نُورًا ،  وَفِي بَصَرِي  نُورًا  ، وَفِي قَلْبِي  نُورًا  . اللَّهُمَّ اشْرَحْ لِي صَدْرِي ، وَيَسِّرْ لِي أَمْرِي . وَأَعُوذُ بِكَ مِنْ وَسْوَاسِ الصُّدُورِ ، وَشَتَاتِ الْأُمُورِ . اللَّهُمَّ أَعُوذُ بِكَ مِنْ شَرِّ مَا يَلِجُ فِي اللَّيْلِ ، وَمِنْ شَرِّ مَا يَلِجُ فِي النَّهَارِ ، وَمِنْ شَرِّ مَا تَهُبُّ بِهِ الرِّيَاحُ ، وَشَرِّ  بَوَائِقِ  الدَّهْرِ  .         [7/18]","","Al-Matalib al-Aliyah 1239","","علي بن أبي طالب عن عبد الله بن عبيدة بن نشيط الحميري عن موسى بن عبيدة بن نشيط الحميري عن وكيع بن الجراح عن إسحاق ابن راهويه","باب الدعاء يوم عرفة وفضله"
"1509","[7/19]      1240  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ جَبَلَةَ ،  ثَنَا  مُحَمَّدُ بْنُ مَرْوَانَ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْ أَيَّامٍ أَفْضَلَ عِنْدَ اللهِ تَعَالَى مِنْ أَيَّامِ عَشْرِ ذِي الْحِجَّةِ  . قَالَ : فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، هُنَّ أَفْضَلُ أَمْ عِدَّتُهُنَّ  جِهَادًا  فِي  سَبِيلِ  اللهِ تَعَالَى ؟ قَالَ : هُنَّ أَفْضَلُ مِنْ عِدَّتِهِنَّ  جِهَادًا  فِي  سَبِيلِ  اللهِ ، إِلَّا عَفِيرًا  يُعَفَّرُ  فِي التُّرَابِ . وَمَا مِنْ يَوْمٍ أَفْضَلَ عِنْدَ اللهِ تَعَالَى مِنْ يَوْمِ عَرَفَةَ ، يَنْزِلُ اللهُ تَعَالَى إِلَى السَّمَاءِ الدُّنْيَا فَيَقُولُ : انْظُرُوا إِلَى عِبَادِي ، شُعْثًا غُبْرًا حَاجِّينَ ، جَاؤُوا مِنْ كُلِّ  فَجٍّ  عَمِيقٍ ، وَلَمْ يَرَوْا رَحْمَتِي وَلَا عَذَابِي ، فَلَمْ يُرَ يَوْمًا أَكْثَرَ عَتِيقًا مِنَ النَّارِ مِنْ يَوْمِ عَرَفَةَ  .         [7/20]","","Al-Matalib al-Aliyah 1240","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن هشام الدستوائي عن محمد بن مروان بن قدامة العجلي عن محمد بن عمرو بن عباد العتكي عن أبو يعلى الموصلي","باب الدعاء يوم عرفة وفضله"
"1510","[7/21]      1241  -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  ثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ ،  ثَنَا  عَزْرَةُ بْنُ قَيْسٍ ،  حَدَّثَنِي  أُمُّ الْفَيْضِ ، أَنَّهَا  سَمِعَتِ  ابْنَ مَسْعُودٍ - رَضِيَ اللهُ عَنْهُ - يَقُولُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ قَالَ لَيْلَةَ عَرَفَةَ هَذِهِ الْعَشْرَ كَلِمَاتٍ أَلْفَ مَرَّةٍ لَمْ يَسْأَلِ اللهَ تَعَالَى شَيْئًا إِلَّا أَعْطَاهُ  ، إِلَّا قَطِيعَةَ رَحِمٍ أَوْ مَأْثَمٍ : سُبْحَانَ الَّذِي فِي السَّمَاءِ عَرْشُهُ ، سُبْحَانَ الَّذِي فِي الْأَرْضِ مَوْطِئُهُ ، سُبْحَانَ الَّذِي فِي الْبَحْرِ سَبِيلُهُ ، سُبْحَانَ الَّذِي فِي النَّارِ سُلْطَانُهُ ، سُبْحَانَ الَّذِي فِي الْجَنَّةِ رَحْمَتُهُ ، سُبْحَانَ الَّذِي فِي الْقُبُورِ قَضَائُهُ ، سُبْحَانَ الَّذِي فِي الْهَوَاءِ نِعْمَتُهُ ، سُبْحَانَ الَّذِي رَفَعَ السَّمَاءَ ، سُبْحَانَ الَّذِي وَضَعَ الْأَرْضَ ، سُبْحَانَ الَّذِي لَا مَنْجَى مِنْهُ إِلَّا إِلَيْهِ  .         [7/22]","","Al-Matalib al-Aliyah 1241","","عبد الله بن مسعود عن أم الفيض عن عزرة بن قيس اليحمدي عن أحمد بن إسحاق الحضرمي عن زهير بن حرب عن أبو يعلى الموصلي","باب الدعاء يوم عرفة وفضله"
"1511","[7/23]      1242  -  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  أَبُو يُوسُفَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ مُسْلِمٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  لَقَدْ رَأَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَشِيَّةَ عَرَفَةَ  رَافِعًا يَدَيْهِ  ، فَيُرَى مَا تَحْتَ إِبْطِهِ  .","","Al-Matalib al-Aliyah 1242","","عبد الله بن عباس عن عطاء بن أبي رباح عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن يعقوب بن الوليد الأزدي عن أحمد بن منيع البغوي","باب الدعاء يوم عرفة وفضله"
"1512","[7/24]      1243  / 1  -  حَدَّثَنَا  سُرَيْجُ بْنُ النُّعْمَانِ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  بِشْرِ بْنِ حَرْبٍ ،  عَنْ  أَبِي سَعِيدٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقَفَ  بِعَرَفَةَ  فَجَعَلَ يَدْعُو هَكَذَا  ، وَجَعَلَ ظَهْرَ كَفَّيْهِ مِمَّا يَلِي صَدْرَهُ .         [7/25]      [2]","","Al-Matalib al-Aliyah 1243","","أبو سعيد الخدري عن بشر بن حرب عن حماد بن سلمة عن سريج بن النعمان الجوهري عن أحمد بن منيع البغوي","باب الدعاء يوم عرفة وفضله"
"1513","1243  / 2  -  حَدَّثَنَا  أَبُو نَصْرٍ ،  ثَنَا  حَمَّادٌ ، بِلَفْظِ :  وَقَفَ  بِعَرَفَاتٍ  ، وَقَالَ هَكَذَا  ... وَرَفَعَ يَدَيْهِ نَحْوَ  ثَنْدُوَتِهِ  .","","Al-Matalib al-Aliyah 1243","","أبو سعيد الخدري عن بشر بن حرب عن حماد بن سلمة عن عبد الملك بن عبد العزيز القشيري عن أحمد بن منيع البغوي","باب الدعاء يوم عرفة وفضله"
"1514","[7/26]      1244  -  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ،  حَدَّثَنِي  عَيَّاشٌ الْكَلْبِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ بَابَاهْ ، قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - يَقُولُ :  إِنَّ اللهَ - عَزَّ وَجَلَّ -  يُبَاهِي  بِأَهْلِ  عَرَفَةَ  الْمَلَائِكَةَ  .","","Al-Matalib al-Aliyah 1244","","عبد الله بن عباس عن عبد الله بن باباه البصري عن عياش بن عمرو العامري عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد","باب الدعاء يوم عرفة وفضله"
"1515","[7/27]      1245  -  حَدَّثَنَا  بِشْرٌ - هُوَ ابْنُ الْمُفَضَّلِ -  ثَنَا  سُلَيْمَانُ بْنُ سَالِمٍ ،  عَنْ  سَعِيدٍ ،  يَرْفَعُهُ  :  إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَ  بِلَالًا  - رَضِيَ اللهُ عَنْهُ - غَدَاةَ  جَمْعٍ  يُنَادِي فِي النَّاسِ : أَنْ  أَنْصِتُوا  ، أَوِ اصْمُتُوا ، فَفَعَلَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ تَعَالَى قَدْ تَطَاوَلَ عَلَيْكُمْ فِي جَمْعِكُمْ  ، فَوَهَبَ مُسِيئَكُمْ لِمُحْسِنِكُمْ ، وَوَهَبَ لِمُحْسِنِكُمْ مَا سَأَلَ . ادْفَعُوا بِاسْمِ اللهِ  .         [7/28]","","Al-Matalib al-Aliyah 1245","","سعيد بن المسيب عن سليمان بن سالم المدني عن بشر بن المفضل عن مسدد بن مسرهد","باب الدعاء يوم عرفة وفضله"
"1516","[7/29]      1246  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عَمْرُو بْنُ الضَّحَّاكِ بْنِ مَخْلَدٍ ،  ثَنَا  أَبِي  ،  ثَنَا  طَالِبُ بْنُ سَلْمٍ ،  حَدَّثَنِي  أَهْلُنَا ، أَنَّهُمْ  سَمِعُوا  جَدِّي ، يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَئِذٍ :  أَلَا إِنَّ اللهَ تَعَالَى نَظَرَ إِلَى هَذَا الْجَمْعِ فَقَبِلَ مِنْ مُحْسِنِهِمْ  ، وَشَفَّعَ مُحْسِنَهُمْ فِي مُسِيئِهِمْ ، فَتَجَاوَزَ عَنْهُمْ جَمِيعًا  .","","Al-Matalib al-Aliyah 1246","","جدي عن أهل طالب بن سلم بن عاصم عن طالب بن سلم بن عاصم عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن أبو يعلى الموصلي","باب الدعاء يوم عرفة وفضله"
"1517","[7/30]      1247  -  وَقَالَ عَبْدٌ :  حَدَّثَنَا  الْقَاسِمُ بْنُ الْوَلِيدِ  ،  ثَنَا  الصَّبَّاحُ بْنُ مُوسَى ،  عَنْ  أَبِي دَاوُدَ السَّبِيعِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَبْقَى أَحَدٌ يَوْمَ  عَرَفَةَ  فِي قَلْبِهِ  مِثْقَالُ  ذَرَّةٍ مِنْ إِيمَانٍ إِلَّا غَفَرَ اللهُ تَعَالَى لَهُ  . قَالَ : فَقَالَ  رَجُلٌ  : أَلِأَهْلِ  الْمُعَرَّفِ  يَا رَسُولَ اللهِ ، أَمْ لِلنَّاسِ عَامَّةً ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : بَلْ لِلنَّاسِ عَامَّةً  .  كذا في طبعة دار العاصمة ، ولعل الصواب ( الوليد بن القاسم ) وينظر مصادر التخريج ، وكتب الترجمة ، والله أعلم.","","Al-Matalib al-Aliyah 1247","","عبد الله بن عمر بن الخطاب عن نفيع بن الحارث الأعمى عن صباح بن موسى عن الوليد بن القاسم الخبذعي عن عبد بن حميد","باب الدعاء يوم عرفة وفضله"
"1518","[7/31]      1248  / 1  -  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  شُجَاعُ بْنُ أَبِي نَصْرٍ الْبَلْخِيُّ ،  ثَنَا  صَالِحٌ الْمُرِّيُّ ،  عَنْ  يَزِيدَ الرَّقَاشِيِّ ،  عَنْ  أَنَسٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ تَعَالَى  يُبَاهِي  الْمَلَائِكَةَ بِأَهْلِ  عَرَفَاتٍ  ، يَقُولُ : يَا مَلَائِكَتِي ، انْظُرُوا إِلَى عِبَادِي ، أَقْبَلُوا يَضْرِبُونَ إِلَيَّ مِنْ كُلِّ  فَجٍّ  عَمِيقٍ شُعْثًا غُبْرًا . اشْهَدُوا أَنِّي قَدْ أَجَبْتُ دُعَاءَهُمْ ، وَوَهَبْتُ مُسِيئَهُمْ لِمُحْسِنِهِمْ ، وَأَعْطَيْتُ مُحْسِنَهُمْ مَا سَأَلَ ، إِلَّا التَّبِعَاتِ الَّتِي بَيْنَهُمْ . فَلَمَّا  أَفَاضُوا  وَأَتَوْا  جَمْعًا  عَاوَدُوا اللهَ تَعَالَى فِي الْمَسْأَلَةِ ، فَيَقُولُ اللهُ تَعَالَى : يَا مَلَائِكَتِي ، عِبَادِي عَاوَدُونِي فِي الْمَسْأَلَةِ ، اشْهَدُوا أَنِّي قَدْ أَجَبْتُ دُعَاءَهُمْ ، وَوَهَبْتُ مُسِيئَهُمْ لِمُحْسِنِهِمْ ، وَأَعْطَيْتُ لِمُحْسِنِهِمْ مَا سَأَلَنِي ، وَكَفَلْتُ عَنْهُمُ التَّبِعَاتِ الَّتِي بَيْنَهُمْ  .","","Al-Matalib al-Aliyah 1248","","أنس بن مالك عن يزيد بن أبان الرقاشي عن صالح بن بشير المري عن شجاع بن أبي نصر الخراساني عن أحمد بن منيع البغوي","باب الدعاء يوم عرفة وفضله"
"1519","1248  / 2  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  ثَنَا  صَالِحٌ - هُوَ الْمُرِّيُّ - نَحْوَهُ ، وَفِيهِ :  وَأَعْطَيْتُ مُحْسِنَهُمْ جَمِيعَ مَا سَأَلُونِي  ، غَيْرَ التَّبِعَاتِ الَّتِي بَيْنَهُمْ . وَفِيهِ : مَلَائِكَتِي ، عِبَادِي وَقَفُوا فَعَادُوا إِلَى الرَّغْبَةِ وَالطَّلَبِ ، فَأُشْهِدُكُمْ أَنِّي أَجَبْتُ دُعَاءَهُمْ  . إِلَى آخِرِهِ .         [7/32]","","Al-Matalib al-Aliyah 1248","","أنس بن مالك عن يزيد بن أبان الرقاشي عن صالح بن بشير المري عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","باب الدعاء يوم عرفة وفضله"
"1520","[7/33]      45 - بَابُ الدَّفْعِ مِنَ الْمُزْدَلِفَةِ  تَقَدَّمَ قَرِيبًا مِنْهُ شَيْءٌ .  1249  - وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  عُبَيْدِ اللهِ ،  أَخْبَرَنِي  نَافِعٌ ،  أَنَّ  ابْنَ الزُّبَيْرِ - رَضِيَ اللهُ عَنْهُمَا - أَسْفَرَ بِالدَّفْعَةِ  ،  فَقَالَ  ابْنُ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - : طُلُوعُ الشَّمْسِ ، يَنْتَظِرُونَ صَنِيعَ أَهْلِ الْجَاهِلِيَّةِ ؟ فَدَفَعَ  ابْنُ عُمَرَ  - رَضِيَ اللهُ عَنْهُمَا - وَدَفَعَ النَّاسُ مَعَهُ ، وَدَفَعَ  ابْنُ الزُّبَيْرِ  - رَضِيَ اللهُ عَنْهُمَا  - .  هَذَا  مَوْقُوفٌ  صَحِيحٌ ، وَلَهُ حُكْمُ الْمَرْفُوعِ  .","","Al-Matalib al-Aliyah 1249","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن يحيى القطان عن مسدد بن مسرهد","باب الدفع من المزدلفة"
"1521","[7/34]      1250  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  ثَنَا  أَبُو عَامِرٍ هُوَ الْعَقَدِيُّ -  ثَنَا  زَمْعَةُ - هُوَ ابْنُ صَالِحٍ -  عَنْ  سَلَمَةَ - هُوَ ابْنُ وَهْرَامٍ -  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  كَانَ أَهْلُ الْجَاهِلِيَّةِ يَقِفُونَ  بِعَرَفَاتٍ  ، حَتَّى إِذَا كَانَتِ الشَّمْسُ عَلَى رُؤُوسِ الْجِبَالِ كَأَنَّهَا الْعَمَائِمُ عَلَى رُؤُوسِ الرِّجَالِ ،  أَفَاضُوا  ثُمَّ وَقَفُوا  بِالْمُزْدَلِفَةِ  ، حَتَّى إِذَا كَانَتِ الشَّمْسُ عَلَى رُؤُوسِ الْجِبَالِ دَفَعُوا ، فَلَمَّا جَاءَ الْإِسْلَامُ  أَخَّرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الدَّفْعَةَ مِنْ  عَرَفَاتٍ  حَتَّى غَرَبَتِ الشَّمْسُ  ، وَعَجَّلَ الدَّفْعَةَ مِنْ  جَمْعٍ  ، فَدَفَعَ مِنْهَا حِينَ أَسْفَرَ كُلُّ شَيْءٍ فِي الْوَقْتِ الْأَخِيرِ ، وَصَلَّى فِيهِ  بِغَلَسٍ  .  أَخْرَجَهُ  أَحْمَدُ  مُخْتَصَرًا ، عَنْ  أَبِي دَاوُدَ  ، عَنْ  زَمْعَةَ  .         [7/35]","","Al-Matalib al-Aliyah 1250","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سلمة بن وهرام اليماني عن زمعة بن صالح الجندي عن أبو عامر العقدي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","باب الدفع من المزدلفة"
"1522","[7/36]      1251  -  وَقَالَ إِسْحَاقُ :  أَخْبَرَنَا  جَرِيرٌ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَفَضْتُ  مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْإِفَاضَتَيْنِ  ، فَكَانَ يُفِيضُ وَعَلَيْهِ  السَّكِينَةُ  .         [7/37]","","Al-Matalib al-Aliyah 1251","","عبد الله بن عباس عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن جرير بن عبد الحميد عن إسحاق ابن راهويه","باب الدفع من المزدلفة"
"1523","[7/38]      46 - بَابُ النُّزُولِ بِمِنًى  1252  -  مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عُثْمَانَ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي بَكْرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا قَدِمْنَا إِنْ شَاءَ اللهُ تَعَالَى نَزَلْنَا  الْخَيْفَ  ،  وَالْخَيْفُ  مَسْجِدُ  مِنًى  .  هَذَا مُرْسَلٌ .","","Al-Matalib al-Aliyah 1252","","عبد الملك بن أبي بكر المخزومي عن عثمان بن أبي سليمان النوفلي عن ابن جريج عن يحيى القطان عن مسدد بن مسرهد","باب النزول بمنى"
"1524","[7/39]      47 - بَابُ فَضْلِ الْحَلْقِ  1253  - قَالَ الْحَارِثُ :  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ أَبِي صَعْصَعَةَ ،  عَنِ  الْحَارِثِ بْنِ عَبْدِ اللهِ بْنِ كَعْبٍ ،  عَنْ  أُمِّ عُمَارَةَ نَسِيبَةَ بِنْتِ كَعْبٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَتْ :  أَنَا أَنْظُرُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَنْحَرُ بُدْنَهُ قِيَامًا ، وَسَمِعْتُهُ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ - وَقَدْ حَلَقَ رَأْسَهُ ، ثُمَّ دَخَلَ  قُبَّةً  لَهُ حَمْرَاءَ ، فَرَأَيْتُهُ أَخْرَجَ رَأْسَهُ مِنْ  قُبَّتِهِ  ، وَهُوَ يَقُولُ - :  يَرْحَمُ اللهُ  الْمُحَلِّقِينَ  - ثَلَاثًا ، ثُمَّ قَالَ : وَالْمُقَصِّرِينَ  .","","Al-Matalib al-Aliyah 1253","","نسيبة بنت كعب الأنصارية عن الحارث بن عبد الله بن كعب عن عبد الرحمن بن عبد الله بن عبد الرحمن  بن أبي صعصعة المازني عن الواقدي عن الحارث بن محمد بن أبي أسامة","باب فضل الحلق"
"1525","[7/40]      48 - بَابُ الْمَبِيتِ بِمِنًى  1254  -  قَالَ إِسْحَاقُ :  أَخْبَرَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  ثَنَا  أَيُّوبُ بْنُ سِنَانٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَمْ يُرَخَّصْ لِأَحَدٍ أَنْ يَبِيتَ عَنْ  مِنًى  إِلَّا  لِلْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ  مِنْ أَجْلِ سِقَايَتِهِ  .         [7/41]","","Al-Matalib al-Aliyah 1254","","عبد الله بن عباس عن عطاء بن أبي رباح عن أيوب بن سيار الفيدى عن أبو عامر العقدي عن إسحاق ابن راهويه","باب المبيت بمنى"
"1526","[7/42]      49 - بَابُ رَمْيِ الْجِمَارِ  1255  -  قَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  مَحْبُوبٌ الْفَزَارِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرٍ الْأَسْلَمِيِّ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  لَمَّا بَلَغْنَا وَادِيَ  مُحَسِّرٍ  ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  خُذُوا حَصَى الْجِمَارِ مِنْ وَادِي  مُحَسِّرٍ  .         [7/43]      كذا في طبعة دار العاصمة ، والصواب : ( محبوب القواريري )","","Al-Matalib al-Aliyah 1255","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن عامر الأسلمي عن محبوب بن محرز القواريري عن أبو بكر ابن أبي شيبة","باب رمي الجمار"
"1527","[7/44]      1256  -  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ جُرَيْجٍ ،  حَدَّثَنِي  هَارُونُ بْنُ أَبِي عَائِشَةَ ،  عَنْ  عَدِيِّ بْنِ عَدِيٍّ الْكِنْدِيِّ ،  عَنْ  سَلْمَانَ بْنِ رَبِيعَةَ ، قَالَ :  نَظَرْنَا إِلَى  عُمَرَ بْنِ الْخَطَّابِ - رَضِيَ اللهُ عَنْهُ - يَوْمَ  النَّفْرِ  الْأَوَّلِ ، فَخَرَجَ عَلَيْنَا تَقْطُرُ لِحْيَتُهُ مَاءً  فِي يَدِهِ حَصَيَاتٌ ، وَفِي حُزَّتِهِ حَصَيَاتٌ ، مَاشِيًا ، يُكَبِّرُ فِي طَرِيقِهِ حَتَّى أَتَى  الْجَمْرَةَ الْأُولَى  ، فَرَمَاهَا حَتَّى انْقَطَعَ مِنَ الْحَصَى خَشْيَةَ يَنَالُهُ حَصَى مَنْ رَمَى ، ثُمَّ دَعَا سَاعَةً ، ثُمَّ مَضَى إِلَى  الْجَمْرَةِ الْوُسْطَى  ، ثُمَّ الْأُخْرَى  .","","Al-Matalib al-Aliyah 1256","","عمر بن الخطاب عن سلمان بن ربيعة الباهلي عن عدي بن عدي بن عميرة الجزري عن هارون بن أبي عائشة المدني عن ابن جريج عن يحيى القطان عن مسدد بن مسرهد","باب رمي الجمار"
"1528","[7/45]      1257  -  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  عَنْ  سُلَيْمَانَ بْنِ الْمُغِيرَةِ ،  عَنِ  ابْنِ أَبِي نُعْمٍ ،  عَنْ  أَبِي سَعِيدٍ ، قَالَ :  حَصَى الْجِمَارِ مَا يُقْبَلُ مِنْهُ رُفِعَ  ، وَمَا رُدَّ تُرِكَ ، وَلَوْلَا ذَلِكَ كَانَ أَطْوَلَ مِنْ شِبْرٍ  .         [7/46]","","Al-Matalib al-Aliyah 1257","","أبو سعيد الخدري عن عبد الرحمن بن أبي نعم البجلي عن سليمان بن المغيرة القيسي عن سفيان الثوري عن يحيى القطان عن مسدد بن مسرهد","باب رمي الجمار"
"1529","[7/47]      1258  -  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  مُحَمَّدِ بْنِ يُوسُفَ مَوْلَى آل عُثْمَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ عُثْمَانَ ، سَمِعَهُ يُخْبِرُ  أَنَّهُ سَمِعَ  أَبَا حَبَّةَ يُفْتِي النَّاسَ :  أَنَّهُ لَا بَأْسَ لِمَا رَمَى بِهِ الرَّجُلُ فِي الْجِمَارِ مِنْ حَصًى وَغَيْرِهِ  ، فَقَالَ  عَبْدُ اللهِ بْنُ عَمْرِو بْنِ عُثْمَانَ  : فَذُكِرَ ذَلِكَ لِعَبْدِ اللهِ بْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - فَقَالَ : صَدَقَ . وَكَانَ  أَبُو حَبَّةَ  - رَضِيَ اللهُ عَنْهُ - بَدْرِيًّا  .","","Al-Matalib al-Aliyah 1258","","عبد الله بن عمر بن الخطاب عن عبد الله بن عمرو بن عثمان بن عفان المطرف عن محمد بن يوسف مولى عثمان بن عفان عن ابن جريج عن يحيى القطان عن مسدد بن مسرهد","باب رمي الجمار"
"1530","[7/48]      1259  -  وَقَالَ الْحُمَيْدِيُّ :  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  حُمَيْدٍ الْأَعْرَجِ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  رَجُلٍ مِنْ قَوْمِهِ يُقَالُ لَهُ  مُعَاذٌ ، أَوِ ابْنُ مُعَاذٍ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَّمَ النَّاسَ مَنَاسِكَهُمْ  ، قَالَ : فَفَتَحَ اللهُ تَعَالَى أَسْمَاعَنَا ، فَإِنَّا لَنَسْمَعُ وَنَحْنُ فِي رِحَالِنَا ، فَكَانَ فِيمَا عَلَّمَنَا : إِذَا رَمَيْتُمُ الْجَمْرَةَ فَارْمُوهَا بِمِثْلِ حَصَى  الْخَذْفِ  .  أَخْرَجَ  أَبُو دَاوُدَ  بَعْضَهُ مِنْ رِوَايَةِ  عَبْدِ الرَّحْمَنِ بْنِ مُعَاذٍ التَّيْمِيِّ  ، عَنْ رَجُلٍ مِنَ الصَّحَابَةِ - رَضِيَ اللهُ عَنْهُ - .         [7/49]","","Al-Matalib al-Aliyah 1259","","أحد الصحابة عن محمد بن إبراهيم بن الحارث التيمي عن حميد بن قيس الأعرج عن سفيان بن عيينة عن الحميدي","باب رمي الجمار"
"1531","[7/50]      1260  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ ،  عَنْ  خَالِدِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ لِلرِّعَاءِ  ، أَنْ تَرْمِيَ الْجِمَارَ لَيْلًا  .         [7/51]","","Al-Matalib al-Aliyah 1260","","عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن محمد بن الصباح الدولابي عن أبو يعلى الموصلي","باب رمي الجمار"
"1532","[7/52]      50 - بَابُ الْهَدْيِ  1261  -  قَالَ أَبُو يَعْلَى :  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  إِسْمَاعِيلَ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَنَسٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  أَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَجُلٌ يَسُوقُ بَدَنَتَهُ حَافِيًا ، فَقَالَ : "" ارْكَبْهَا  ! "" فَرَكِبَهَا  .  قُلْتُ : هُوَ فِي الصَّحِيحِ مِنْ حَدِيثِ  أَنَسٍ  - رَضِيَ اللهُ عَنْهُ - دُونَ قَوْلِهِ : حَافِيًا .         [7/53]","","Al-Matalib al-Aliyah 1261","","أنس بن مالك عن الحسن البصري عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن علي بن مسهر القرشي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","باب الهدي"
"1533","[7/54]      1262  - وَقَالَ أَبُو دَاوُدَ :  حَدَّثَنَا  أَبُو إِسْرَائِيلَ ،  عَنِ  الْحَكَمِ ،  عَنِ  الْمُغِيرَةِ بْنِ حَذَفٍ  ،  عَنْ  عَلِيٍّ ، أَوْ حُذَيْفَةَ  - رَضِيَ اللهُ عَنْهُمَا -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَشْرَكَ  بَيْنَ الْمُسْلِمِينَ فِي هَدْيِهِمْ  : الْبَقَرَةُ عَنْ سَبْعَةٍ  .         [7/55]      في طبعة دار العاصمة : ( حرب ) والمثبت من مسند الطيالسي ، وينظر ترجمته في تعجيل المنفعة","","Al-Matalib al-Aliyah 1262","","حذيفة بن اليمان عن المغيرة بن حذف العبسي عن الحكم بن عتيبة الكندي عن إسماعيل بن خليفة الملائي عن أبو داود الطيالسي","باب الهدي"
"1534","[7/56]      1263  -  مُسَدَّدٌ :  حَدَّثَنَا  خَالِدٌ ،  عَنْ  خَالِدٍ ،  عَنْ  عَمْرِو بْنِ سَعِيدٍ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ - رَضِيَ اللهُ عَنْهُ - قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَبْعَثُ بِالْهَدْيِ  ، فَيَأْمُرُ الَّذِي يَبْعَثُهُ مَعَهُ إِنْ عَطِبَ مِنْهُ شَيْءٌ أَنْ يَنْحَرَهُ ، وَيَصْبُغَ نَعْلَهُ فِي دَمِهِ ، ثُمَّ يَضْرِبَ بِهِ صَفْحَتَهُ ، وَلْيَأْكُلْهُ مَنْ بَعْدَكَ ، وَلَا تَأْكُلْ مِنْهُ أَنْتَ شَيْئًا ، وَلَا أَحَدٌ مِنْ أَهْلِ رُفْقَتِكَ  . قَالَ :  وَكَانَ  مُحَمَّدُ بْنُ سِيرِينَ  يَفْعَلُ ذَلِكَ  .","","Al-Matalib al-Aliyah 1263","","حميد بن عبد الرحمن الحميري عن عمرو بن سعيد الخولاني عن خالد الحذاء عن خالد بن عبد الله الطحان عن مسدد بن مسرهد","باب الهدي"
"1535","[7/57]      1264  -  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - :  فِي الرَّجُلِ يَبْعَثُ بِالْهَدْيِ وَهُوَ مُقِيمٌ  ؟ قَالَ : يُوَاعِدُهُ يَوْمًا ، فَإِذَا بَلَغَ أَمْسَكَ هُوَ عَمَّا يُمْسِكُ عَنْهُ الْحَرَامُ  .  [صَحِيحٌ مَوْقُوفٌ] .","","Al-Matalib al-Aliyah 1264","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن حماد بن زيد عن مسدد بن مسرهد","باب الهدي"
"1536","[7/58]      1265  -  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ جُرَيْجٍ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ سَابِطٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَصْحَابُهُ - رَضِيَ اللهُ عَنْهُمْ - يَنْحَرُونَ الْبُدْنَ مَعْقُولَةَ الْيُسْرَى  عَلَى مَا بَقِيَ مِنْ قَوَائِمِهَا  .","","Al-Matalib al-Aliyah 1265","","عبد الرحمن بن سابط الجمحي عن ابن جريج عن يحيى القطان عن مسدد بن مسرهد","باب الهدي"
"1537","[7/59]      1266  -  قَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ بَحْرٍ ،  ثَنَا  سُلَيْمُ بْنُ مُسْلِمٍ ،  ثَنَا  ابْنُ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ،  عَنْ  أَبِي الْخَلِيلِ ،  عَنْ  أَبِي قَتَادَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي بُدْنِ التَّطَوُّعِ :  إِذَا عَطِبَ قَبْلَ أَنْ يَدْخُلَ الْحَرَمَ فَانْحَرْهَا  ، ثُمَّ اغْمِسْ يَدَكَ فِي دَمِهَا ، ثُمَّ اضْرِبْ صَفْحَتَهَا ، وَلَا تَأْكُلْ مِنْهَا ، فَإِنْ أَكَلْتَ مِنْهَا غُرِّمْتَهَا  .","","Al-Matalib al-Aliyah 1266","","أبو قتادة الأنصاري فارس رسول الله عن صالح بن أبي مريم الضبعي عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن سليم بن مسلم الخشاب عن محمد بن بحر الهجيمي عن أبو يعلى الموصلي","باب الهدي"
"1538","[7/60]      1267  -  وَحَدَّثَنَا  عَمْرُو بْنُ الْحُصَيْنِ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  ثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  قَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، وَجَبَتْ عَلَيَّ بَدَنَةٌ ، وَقَدْ نُحِرَتِ الْبُدْنُ ، فَمَا تَرَى ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اذْبَحْ مَكَانَهَا سَبْعًا مِنَ الشَّاءِ  .         [7/61]","","Al-Matalib al-Aliyah 1267","","عبد الله بن عباس عن عطاء بن أبي رباح عن ابن جريج عن حفص بن غياث النخعي عن عمرو بن الحصين العقيلي عن أبو يعلى الموصلي","باب الهدي"
"1539","[7/62]      1268  - قَالَ الْحَارِثُ :  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ ،  ثَنَا  مُحَمَّدُ بْنُ مُوسَى الْفِطْرِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عُمَرَ بْنِ عَلِيٍّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ :  إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَاقَ مِائَةَ بَدَنَةٍ  فِي حَجَّتِهِ  .","","Al-Matalib al-Aliyah 1268","","علي بن أبي طالب عن عمر بن علي بن أبي طالب الأكبر عن محمد بن عمر بن علي بن أبي طالب عن محمد بن موسى الفطري عن الواقدي عن الحارث بن محمد بن أبي أسامة","باب الهدي"
"1540","[7/63]      51 - بَابُ التَّلْبِيَةِ ، وَمَتَى تَنْقَطِعُ ، وَهَلْ يُقَالُ فِي الْأَمَاكِنِ الْمُقَدَّسَةِ ؟  1269  -  وَقَالَ إِسْحَاقُ :  أَخْبَرَنَا  يَعْلَى ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ شِهَابٍ ،  عَنْ  يَحْيَى بْنِ عَبَّادٍ ،  عَنْ  عَبَّادٍ  ، قَالَ : حُدِّثْتُ  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ - رَضِيَ اللهُ عَنْهُ - لَمَّا دَخَلَ  بَيْتَ الْمَقْدِسِ  قَالَ :  لَبَّيْكَ  اللَّهُمَّ  لَبَّيْكَ  ! .","","Al-Matalib al-Aliyah 1269","","عمر بن الخطاب عن عباد بن عبد الله بن الزبير بن العوام عن يحيى بن عباد بن عبد الله بن الزبير بن العوام عن الزهري عن محمد بن إسحاق عن يعلى بن عبيد الطنافسي عن إسحاق ابن راهويه","باب التلبية ومتى تنقطع وهل يقال في الأماكن المقدسة"
"1541","[7/64]      1270  -  قَالَ إِسْحَاقُ :  أَخْبَرَنَا  أَحْمَدُ بْنُ أَيُّوبَ ،  عَنْ  أَبِي حَمْزَةَ السُّكَّرِيِّ ،  عَنْ  جَابِرٍ - هُوَ الْجُعْفِيُّ -  عَنْ  مُجَاهِدٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  مَا سَمِعْتُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا هَؤُلَاءِ الْكَلِمَاتِ :  لَبَّيْكَ  اللَّهُمَّ  لَبَّيْكَ  ،  لَبَّيْكَ  لَا شَرِيكَ لَكَ ، إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ . وَمَا سَمِعْتُهُ يَذْكُرُ حَجًّا وَلَا عُمْرَةً .  قَالَ  مُجَاهِدٌ  : وَقَالَ فِيهِ  عُمَرُ بْنُ الْخَطَّابِ  : وَالْمُلْكَ لَا شَرِيكَ لَكَ .  قُلْتُ : هُوَ فِي الصَّحِيحِ مِنْ حَدِيثِ  عَائِشَةَ  بِالزِّيَادَةِ ، دُونَ قَوْلِهَا : يَذْكُرُ حَجًّا وَلَا عُمْرَةً .         [7/65]             [7/66]             [7/67]","","Al-Matalib al-Aliyah 1270","","عائشة بنت أبي بكر الصديق عن مجاهد بن جبر المخزومي عن جابر الجعفي عن محمد بن ميمون أبو حمزة السكري عن أحمد بن أيوب بن راشد الشعيري عن إسحاق ابن راهويه","باب التلبية ومتى تنقطع وهل يقال في الأماكن المقدسة"
"1542","[7/68]      1271  - وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  حَمَّادٌ ،  ثَنَا  هِشَامُ بْنُ حَسَّانَ ،  عَنْ  حَفْصَةَ بِنْتِ سِيرِينَ ،  عَنْ  يَحْيَى بْنِ سِيرِينَ :  أَنَّهُ حَجَّ مَعَ أَنَسِ بْنِ مَالِكٍ - رَضِيَ اللهُ عَنْهُ - فَكَانَ  يَقُولُ  فِي تَلْبِيَتِهِ :  لَبَّيْكَ حَجًّا  حَقًّا ،  تَعَبُّدًا وَرِقًّا  .         [7/69]","","Al-Matalib al-Aliyah 1271","","أنس بن مالك عن يحيى بن سيرين البصري عن حفصة بنت سيرين عن هشام بن حسان العتكي عن حماد بن زيد عن مسدد بن مسرهد","باب التلبية ومتى تنقطع وهل يقال في الأماكن المقدسة"
"1543","[7/70]      1272  -  حَدَّثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  رَجُلٍ ،  عَنْ  عُمَرَ - رَضِيَ اللهُ عَنْهُ - :  أَنَّهُ  أَفَاضَ  مِنْ  عَرَفَةَ  ، فَكَانَتْ تَلْبِيَتُهُ :  لَبَّيْكَ  اللَّهُمَّ  لَبَّيْكَ  !  .","","Al-Matalib al-Aliyah 1272","","عمر بن الخطاب عن رجل عن إبراهيم النخعي عن منصور بن المعتمر عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد","باب التلبية ومتى تنقطع وهل يقال في الأماكن المقدسة"
"1544","[7/71]      1273  / 1  -  وَقَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  أَبِي حَنِيفَةَ ،  عَنْ  قَيْسِ بْنِ مُسْلِمٍ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ،  عَنْ  عَبْدِ اللهِ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَفْضَلُ  الْحَجِّ  :  الْعَجُّ  وَالثَّجُّ  ،  فَالْعَجُّ  : الْعَجِيجُ ،  وَالثَّجُّ  : النَّحْرُ  .","","Al-Matalib al-Aliyah 1273","","عبد الله بن مسعود عن طارق بن شهاب الأحمسي عن قيس بن مسلم الجدلي عن أبو حنيفة النعمان عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة","باب التلبية ومتى تنقطع وهل يقال في الأماكن المقدسة"
"1545","1273  / 2  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  ثَنَا  أَبُو أُسَامَةَ بِهَذَا ، إِلَّا أَنَّهُ قَالَ :  فَأَمَّا  الْعَجُّ  فَالتَّلْبِيَةُ  ، وَأَمَّا  الثَّجُّ  فَنَحْرُ الْإِبِلِ  .         [7/72]","","Al-Matalib al-Aliyah 1273","","عبد الله بن مسعود عن طارق بن شهاب الأحمسي عن قيس بن مسلم الجدلي عن أبو حنيفة النعمان عن حماد بن أسامة القرشي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","باب التلبية ومتى تنقطع وهل يقال في الأماكن المقدسة"
"1546","[7/73]      1274  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  إِسْمَاعِيلَ ،  عَنِ  الْحَسَنِ وَقَتَادَةَ ،  عَنْ  أَنَسٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَقُولُ :  لَبَّيْكَ  اللَّهُمَّ  لَبَّيْكَ  ،  لَبَّيْكَ  لَا شَرِيكَ لَكَ  لَبَّيْكَ  ، إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ وَالْمُلْكَ ، لَا شَرِيكَ لَكَ !  .         [7/74]","","Al-Matalib al-Aliyah 1274","","أنس بن مالك عن الحسن البصري عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","باب التلبية ومتى تنقطع وهل يقال في الأماكن المقدسة"
"1547","[7/75]      52 - بَابُ الْخُطْبَةِ فِي يَوْمِ النَّحْرِ وَفِي ثَانِيهِ  ( 51 ) حَدِيثُ  عَمَّارِ بْنِ يَاسِرٍ  - رَضِيَ اللهُ عَنْهُ - وَغَيْرِهِ فِي ذَلِكَ ، فِي بَابِ تَحْرِيمِ الدَّمِ مِنْ كِتَابِ الْحُدُودِ .  1275  / 1  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عَمْرُو بْنُ الضَّحَّاكِ بْنِ مَخْلَدٍ ،  ثَنَا  أَبِي  ،  ثَنَا  رَبِيعَةُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ حُصَيْنٍ الْغَنَوِيُّ ،  حَدَّثَتْنِي  جَدَّتِي السَّرَّى بِنْتُ نَبْهَانَ بْنِ عَمْرٍو  - وَكَانَتْ رَبَّةَ بَيْتٍ فِي الْجَاهِلِيَّةِ - قَالَتْ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فِي حَجَّةِ الْوَدَاعِ  ، يَقُولُ :  أَتَدْرُونَ أَيُّ يَوْمٍ هَذَا ؟  قَالُوا : اللهُ وَرَسُولُهُ أَعْلَمُ . قَالَ : هَذَا أَوْسَطُ أَيَّامِ  التَّشْرِيقِ  . قَالَ : تَدْرُونَ أَيُّ بَلَدٍ هَذَا ؟ قَالُوا : اللهُ وَرَسُولُهُ أَعْلَمُ . قَالَ : هَذَا  الْمَشْعَرُ الْحَرَامُ  ، قَالَ : إِنِّي لَا أَدْرِي لَعَلِّي لَا أَلْقَاكُمْ بَعْدَ عَامِي هَذَا . أَلَا إِنَّ دِمَاءَكُمْ وَأَمْوَالَكُمْ  وَأَعْرَاضَكُمْ  بَيْنَكُمْ حَرَامٌ ، بَعْضُكُمْ عَلَى بَعْضٍ ،  كَحُرْمَةِ  يَوْمِكُمْ هَذَا فِي بَلَدِكُمْ هَذَا ، حَتَّى تَلْقَوُا اللهَ - عَزَّ وَجَلَّ - فَيَسْأَلَكُمْ عَنْ أَعْمَالِكُمْ . أَلَا فَلْيُبَلِّغْ أَدْنَاكُمْ أَقْصَاكُمْ ؟ قَالَ : ثُمَّ أَتْبَعَهَا : اللَّهُمَّ هَلْ بَلَّغْتُ ؟ اللَّهُمَّ هَلْ بَلَّغْتُ ؟ فَتُوُفِّيَ حِينَ بَلَغَ الْمَدِينَةَ  .","","Al-Matalib al-Aliyah 1275","","سراء بنت نبهان الغنوية عن ربيعة بن عبد الرحمن الغنوي عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن أبو يعلى الموصلي","باب الخطبة في يوم النحر وفي ثانيه"
"1548","1275  / 2  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عَرْعَرَةَ وَيَعْقُوبُ ، فَرَّقَهُمَا ، قَالَا :  ثَنَا  أَبُو عَاصِمٍ ، بِهِ .         [7/76]      أَخْرَجَهُ  أَبُو دَاوُدَ  مُخْتَصَرًا مِنْ حَدِيثِ  أَبِي عَاصِمٍ  ، بِهَذَا  الْإِسْنَادِ  .         [7/77]","","Al-Matalib al-Aliyah 1275","","سراء بنت نبهان الغنوية عن ربيعة بن عبد الرحمن الغنوي عن أبو عاصم النبيل عن يعقوب بن إبراهيم بن كثير عن أبو يعلى الموصلي","باب الخطبة في يوم النحر وفي ثانيه"
"1549","[7/78]      53 - بَابُ جَزَاءِ الصَّيْدِ وَتَحْرِيمِهِ عَلَى الْمُحْرِمِ  1276  - مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ خُثَيْمٍ ،  أَخْبَرَنِي  يُوسُفُ بْنُ مَاهَكَ ،  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ أَبِي عَمَّارٍ ، يَقُولُ :  أَقْبَلْتُ مَعَ مُعَاذِ بْنِ جَبَلٍ ، وَكَعْبٍ - رَضِيَ اللهُ عَنْهُمَا - مُحْرِمِينَ بِعُمْرَةٍ مِنْ  بَيْتِ الْمَقْدِسِ  ، وَأَمِيرُنَا  مُعَاذٌ  - رَضِيَ اللهُ عَنْهُ - وَأَمْرُنَا إِلَيْهِ ، وَهُوَ يَؤُمُّنَا . فَلَمَّا كَانَ بِبَعْضِ الطَّرِيقِ تَبَرَّزَ  مُعَاذٌ  - رَضِيَ اللهُ عَنْهُ - لِحَاجَتِهِ ، وَخَالَفَهُ رَجُلٌ بِحِمَارِ وَحْشٍ قَدْ عَقَرَهُ ، فَأَخَذَهُ  كَعْبٌ  ، فَأَهْدَاهُ إِلَى الرُّفْقَةِ . قَالَ : فَلَمْ يَرْجِعْ  مُعَاذٌ  إِلَّا وَقُدُورُ  الْقَوْمِ  تَغْلِي فِيهَا مِنْهُ . فَسَأَلَ ، فَأُخْبِرَ ، فَقَالَ : لَا يُطِيعُنِي أَحَدٌ إِلَّا كَفَأَ قِدْرَهُ ! . قَالَ : فَكَفَأَ  كَعْبٌ  وَالْقَوْمُ قُدُورَهُمْ . فَلَمَّا كُنَّا بِبَعْضِ الطَّرِيقِ ،  وَكَعْبٌ  يُصَلِّي عَلَى نَارٍ ، إِذْ مَرَّتْ بِهِ رِجْلٌ مِنْ جَرَادٍ ، فَأَخَذَ جَرَادَتَيْنِ فَقَتَلَهُمَا وَنَسِيَ إِحْرَامَهُ ، ثُمَّ ذَكَرَ إِحْرَامَهُ فَرَمَى بِهِمَا . فَلَمَّا قَدِمْنَا  الْمَدِينَةَ  دَخَلَ  الْقَوْمُ  عَلَى عُمَرَ - رَضِيَ اللهُ عَنْهُ - وَدَخَلْتُ مَعَهُمْ ، فَقَالَ  كَعْبٌ  : كَيْفَ تَرَى يَا أَمِيرَ الْمُؤْمِنِينَ - فَقَصَّ عَلَيْهِ قِصَّةَ الْجَرَادَتَيْنِ - ؟ قَالَ : وَمَا بَأْسٌ بِذَلِكَ ، يَا  كَعْبُ  . قَالَ : نَعَمْ . قَالَ : إِنَّ  حِمْيَرَ  تُحِبُّ الْجَرَادَ ، وَمَاذَا جَعَلْتَ فِي نَفْسِكَ ؟ قَالَ : دِرْهَمَيْنِ . قَالَ : دِرْهَمَانِ خَيْرٌ مِنْ مِائَةِ جَرَادَةٍ ، اجْعَلْ مَا جَعَلْتَ فِي نَفْسِكَ  .         [7/79]             [7/80]","","Al-Matalib al-Aliyah 1276","","عمر بن الخطاب عن عبد الرحمن بن عبد الله بن أبي عمار الجشمي عن يوسف بن ماهك الفارسي عن عبد الله بن عثمان بن خثيم عن يحيى القطان عن مسدد بن مسرهد","باب جزاء الصيد وتحريمه على المحرم"
"1550","[7/81]      1277  -  حَدَّثَنَا  يَحْيَى ،  ثَنَا  سَالِمُ بْنُ هِلَالٍ ،  حَدَّثَنِي  أَبُو الصِّدِّيقِ ،  عَنْ  أَبِي سَعِيدٍ ،  أَنَّهُ حَجَّ  وَكَعْبٌ  ، فَجَاءَ جَرَادٌ ، فَجَعَلَ كَعْبٌ يَضْرِبُ بِسَوْطٍ  ، فَقُلْتُ : يَا  أَبَا إِسْحَاقَ  ! أَلَسْتَ مُحْرِمًا ؟ قَالَ : بَلَى ، إِنَّهُ مِنْ صَيْدِ الْبَحْرِ ، وَإِنَّمَا خَرَجَ أَوَّلُهُ مِنْ  مِنْخَرِ  حُوتٍ  .         [7/82]","","Al-Matalib al-Aliyah 1277","","كعب بن مالك الأنصاري عن أبو سعيد الخدري عن بكر بن عمرو الناجي عن سالم بن هلال عن يحيى القطان عن مسدد بن مسرهد","باب جزاء الصيد وتحريمه على المحرم"
"1551","[7/83]      1278  -  وَقَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ بْنِ الْحَارِثِ ،  عَنْ  عِيسَى بْنِ طَلْحَةَ ،  عَنْ  أَبِيهِ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِصِفَاحِ الرَّوْحَاءِ  ، فَإِذَا نَحْنُ بِحِمَارٍ  عَقِيرٍ  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ هَذَا الْحِمَارَ  يُوشِكُ  صَاحِبُهُ أَنْ يَأْتِيَ  . فَمَا لَبِثَ أَنْ جَاءَ صَاحِبُهُ ، فَقَالَ : خُذُوهُ . فَأَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَبَا بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - أَنْ يُقَسِّمَهُ فِي الرِّفَاقِ . ثُمَّ خَرَجْنَا ، حَتَّى إِذَا كُنَّا  بِالْأُثَايَةِ  بِالْعَرْجِ  ، إِذَا ظَبْيٌ  حَاقِفٌ  فِيهِ  سَهْمٌ  غَائِرٌ ، فَأَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَبَا بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - أَنْ يَقِفَ عَلَيْهِ فَيَمْنَعَهُ مِنَ النَّاسِ  . قَالَ : وَصَاحِبُ الْحِمَارِ رَجُلٌ مِنْ  بَهْزٍ  .  قُلْتُ :  ظَاهِرُ هَذَا  الْإِسْنَادِ  الصِّحَّةُ ، لَكِنَّهُ  مَعْلُولٌ  . بَيَّنَ ذَلِكَ  عَلِيُّ بْنُ الْمَدِينِيِّ  فِي كِتَابِ الْعِلَلِ ، وَأَنَّهُ قَالَ  لِابْنِ عُيَيْنَةَ  : إِنَّ النَّاسَ يُخَالِفُونَكَ ، لَا يَقُولُونَ : عَنْ  عِيسَى بْنِ طَلْحَةَ  ، عَنْ أَبِيهِ ! فَقَالَ : الْحَدِيثَ قَدْ قَصَصْتُ لَكَ ، وَكُنْتُ أَظُنُّهُ عَنْ أَبِيهِ . قَالَ  عَلِيٌّ  : الصَّوَابُ عَنْ  عِيسَى بْنِ طَلْحَةَ  ، عَنِ الْبَهْزِيِّ .         [7/84]             [7/85]             [7/86]","","Al-Matalib al-Aliyah 1278","","طلحة بن عبيد الله بن عثمان الفياض عن عيسى بن طلحة التيمي عن محمد بن إبراهيم بن الحارث التيمي عن يحيى بن سعيد الأنصاري عن سفيان بن عيينة عن ابن أبي عمر العدني","باب جزاء الصيد وتحريمه على المحرم"
"1552","[7/87]      1279  - وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ،  ثَنَا  هِشَامٌ ،  عَنْ  أَبِيهِ  ، قَالَ :  إِنَّ  الزُّبَيْرَ - رَضِيَ اللهُ عَنْهُ - كَانَ يُسَافِرُ  بِصَفِيفِ  الْوَحْشِ  ، فَيَأْكُلُهُ وَهُوَ مُحْرِمٌ  .  صَحِيحٌ مَوْقُوفٌ .","","Al-Matalib al-Aliyah 1279","","الزبير بن العوام عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن داود الخريبي عن مسدد بن مسرهد","باب جزاء الصيد وتحريمه على المحرم"
"1553","[7/88]      1280  -  الْحَارِثُ :  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْحَارِثِ بْنِ الْفُضَيْلِ الْخَطْمِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ ذُؤَيْبٍ الْأَسَدِيِّ ، قَالَ :  صَحِبْتُ  الزُّبَيْرَ بْنَ الْعَوَّامِ - رَضِيَ اللهُ عَنْهُ - مِنَ  الْمَدِينَةِ  إِلَى  مَكَّةَ  وَهُوَ مُحْرِمٌ  ، وَكَانَ يَأْكُلُ لَحْمَ صَيْدِ الْبَرِّ ، فَقُلْتُ لَهُ فِي ذَلِكَ ، فَقَالَ : صَادَهُ حَلَالٌ  ،  وَقَدْ سَأَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمْ يَرَ بِهِ بَأْسًا  .","","Al-Matalib al-Aliyah 1280","","الزبير بن العوام عن عبد الرحمن بن ذؤيب الأسدي عن الحارث بن فضيل الخطمي عن عبد الله بن الحارث بن الفضيل الخطمي عن الواقدي عن الحارث بن محمد بن أبي أسامة","باب جزاء الصيد وتحريمه على المحرم"
"1554","[7/89]      1281  / 1  -  مُسَدَّدٌ :  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  إِنَّ  عُمَرَ - رَضِيَ اللهُ عَنْهُ - قَضَى فِي  الْيَرْبُوعِ  جَفْرَةً  ، وَفِي الضَّبُعِ كَبْشًا ، وَفِي الظَّبْيِ شَاةً ، وَفِي الْأَرْنَبِ  عَنَاقًا  .","","Al-Matalib al-Aliyah 1281","","عمر بن الخطاب عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان بن عيينة عن مسدد بن مسرهد","باب جزاء الصيد وتحريمه على المحرم"
"1555","1281  / 2  -  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  أَيُّوبُ ،  ثَنَا  أَبُو الزُّبَيْرِ بِهِ .  1281  / 3  - وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  سُفْيَانُ بِهِ ، مُقْتَصِرًا عَلَى  الْيَرْبُوعِ  .         [7/90]","","Al-Matalib al-Aliyah 1281","","عمر بن الخطاب عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان بن عيينة عن أحمد بن منيع البغوي","باب جزاء الصيد وتحريمه على المحرم"
"1556","1282  - أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو عُبَيْدَةَ بْنُ الْفُضَيْلِ بْنِ عِيَاضٍ ،  ثَنَا  مَالِكُ بْنُ سُعَيْرٍ ،  عَنِ  الْأَجْلَحِ ،  عَنْ  أَبِي الزُّبَيْرِ ، فَذَكَرَهُ ، لَكِنْ زَادَ : وَلَا أُرَاهُ إِلَّا قَدْ  رَفَعَهُ  .","","Al-Matalib al-Aliyah 1282","","عمر بن الخطاب عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن أجلح بن عبد الله الكندي عن مالك بن سعير التميمي عن أبو عبيدة بن الفضيل بن عياض عن أبو يعلى الموصلي","باب جزاء الصيد وتحريمه على المحرم"
"1557","[7/91]      1283  - مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ جُرَيْجٍ ،  حَدَّثَنِي  عَبْدُ الْحَمِيدِ بْنُ جُبَيْرٍ ، قَالَ : إِنَّ عِكْرِمَةَ مَوْلَى ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  قَالَ  عَلِيٌّ - رَضِيَ اللهُ عَنْهُ -  فِي بَيْضِ النَّعَامِ يُصِيبُهُ الْمُحْرِمُ  : تَحْمِلُ الْفَحْلَ عَلَى إِبِلِكَ ، فَإِذَا تَبَيَّنَ لَكَ لِقَاحُهَا سَمَّيْتَ عَدَدَ مَا أَصَبْتَ مِنَ الْبَيْضِ ، فَقُلْتُ : هَذَا هَدْيٌ لَيْسَ عَلَيْكَ ضَمَانُهَا ، فَمَا صَلَحَ مِنْ ذَلِكَ صَلَحَ ، وَمَا فَسَدَ فَلَيْسَ عَلَيْكَ ، كَالْبَيْضِ : مِنْهُ مَا يَصْلُحُ ، وَمِنْهُ مَا يَفْسُدُ . قَالَ : فَعَجِبَ  مُعَاوِيَةُ  - رَضِيَ اللهُ عَنْهُ - مِنْ قَضَاءِ  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ -  فَقَالَ  ابْنُ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - : فَلَمْ يُعْجِبْ  مُعَاوِيَةَ  مَا هُوَ ، إِلَّا مَا يُبَاعُ بِهِ الْبَيْضُ فِي السُّوقِ وَيُتَصَدَّقُ بِهِ  .","","Al-Matalib al-Aliyah 1283","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن عبد الحميد بن جبير الحجبي عن ابن جريج عن يحيى القطان عن مسدد بن مسرهد","باب جزاء الصيد وتحريمه على المحرم"
"1558","[7/92]      1284  -  حَدَّثَنَا  عَبْدُ اللهِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  رَجُلٍ ،  عَنْ  عِكْرِمَةَ :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَكَمَ فِي الضَّبُعِ كَبْشًا  ، وَجَعَلَهُ صَيْدًا  .","","Al-Matalib al-Aliyah 1284","","عكرمة مولى ابن عباس عن رجل عن ابن جريج عن عبد الله بن داود الخريبي عن مسدد بن مسرهد","باب جزاء الصيد وتحريمه على المحرم"
"1559","[7/93]      1285  - وَقَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  يُوسُفُ بْنُ خَالِدٍ ،  عَنِ  الْحَسَنِ بْنِ عُمَارَةَ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَضَى فِي كَلْبِ الصَّيْدِ  ، إِذَا أُصِيبَ أَرْبَعِينَ دِرْهَمًا ، وَفِي كَلْبِ الْمَاشِيَةِ شَاةً مِنَ الْغَنَمِ ، وَفِي كَلْبِ الزَّرْعِ فَرَقٌ مِنْ طَعَامٍ ، وَفِي كَلْبِ الدَّارِ فَرَقٌ مِنْ تُرَابٍ ، حَقٌّ عَلَى رَبِّ الْقَاتِلِ أَنْ يُؤَدِّيَهُ ، وَحَقٌّ عَلَى رَبِّ الدَّارِ أَنْ يَقْبَلَهُ  .  هَذَا إِسْنَادٌ  وَاهٍ  جِدًّا  .","","Al-Matalib al-Aliyah 1285","","عبد الله بن عمرو بن العاص عن إسماعيل السهمي مولى عبد الله بن عمرو بن العاص عن يعلى بن عطاء الطائفي عن الحسن بن عمارة عن يوسف بن خالد السمتي عن ابن أبي عمر العدني","باب جزاء الصيد وتحريمه على المحرم"
"1560","[7/94]      54 - بَابُ الْعُمْرَةِ  1286 - [1]  1286  / 1  - قَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  أَبُو بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  امْرَأَةٍ مِنَ  الْأَنْصَارِ  يُقَالُ لَهَا : أُمُّ سِنَانٍ - رَضِيَ اللهُ عَنْهَا -  أَنَّهَا أَرَادَتِ  الْحَجَّ  مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لَهَا :  اعْتَمِرِي فِي رَمَضَانَ ، فَإِنَّهَا لَكِ حَجَّةٌ  .  قَالَ  سَعِيدٌ  : وَلَا نَعْلَمُهُ إِلَّا لِهَذِهِ الْمَرْأَةِ وَحْدَهَا  .","","Al-Matalib al-Aliyah 1286","","أم سنان الأنصارية عن سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن هشيم بن بشير عن أحمد بن منيع البغوي","باب العمرة"
"1561","1286  / 2  - وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  إِسْمَاعِيلُ ،  ثَنَا  أَيُّوبُ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، بِمَعْنَاهُ .         [7/95]","","Al-Matalib al-Aliyah 1286","","أم سنان الأنصارية عن سعيد بن جبير الأسدي عن أيوب السختياني عن إسماعيل ابن علية عن أحمد بن منيع البغوي","باب العمرة"
"1562","[7/96]      55 - بَابُ الِاعْتِمَارِ فِي عَشْرِ ذِي الْحِجَّةِ  1287  - قَالَ إِسْحَاقُ :  أَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  عَنْ  حَمَّادِ بْنِ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ، قَالَ :  قَالَ  عُرْوَةُ  لِابْنِ عَبَّاسٍ : وَيْحَكَ ! أَضَلَلْتَ ؟  تَأْمُرُ بِالْعُمْرَةِ فِي الْعَشْرِ وَلَيْسَ فِيهِنَّ عُمْرَةٌ !؟  فَقَالَ  : يَا  عُرَيُّ  ، فَسَلْ أُمَّكَ ! قَالَ : إِنَّ  أَبَا بَكْرٍ  ،  وَعُمَرَ  لَمْ يَقُولَا ذَلِكَ ، وَكَانَا أَعْلَمَ بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَتْبَعَ لَهَا مِنْكَ . فَقَالَ : مِنْ هَهُنَا تُرْمَوْنَ ، نَجِيئُكُمْ بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَتَجِيئُونَ  بِأَبِي بَكْرٍ  وَعُمَرَ  !  .  سَنَدُهُ صَحِيحٌ  ، وَبَعْضُهُ مِمَّا يَتَعَلَّقُ بِالْعُمْرَةِ فِي صَحِيحِ مُسْلِمٍ ، وَإِلَيْهِ الْإِشَارَةُ بِقَوْلِ  ابْنِ عَبَّاسٍ  فِي الصَّحِيحَيْنِ : سُنَّةُ  أَبِي الْقَاسِمِ  لَمَّا قَالَ لَهُ  أَبُو جَمْرَةَ  : إِنَّهُ رَأَى فِي الْمَنَامِ مَنْ يَقُولُ لَهُ : عُمْرَةٌ مُتَقَبَّلَةٌ ، أَوْ مُتْعَةٌ مُتَقَبَّلَةٌ .         [7/97]","","Al-Matalib al-Aliyah 1287","","عبد الله بن عباس عن ابن أبي مليكة عن أيوب السختياني عن حماد بن زيد عن سليمان بن حرب الواشحي عن إسحاق ابن راهويه","باب الاعتمار في عشر ذي الحجة"
"1563","[7/98]      56 - بَابُ الِاعْتِمَارِ مِنْ  بَيْتِ الْمَقْدِسِ  1288  -  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ خُثَيْمٍ ،  أَخْبَرَنِي  يُوسُفُ بْنُ مَاهَكَ ،  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ أَبِي عَمَّارٍ ، يَقُولُ :  أَقْبَلْتُ مَعَ مُعَاذِ بْنِ جَبَلٍ ، وَكَعْبٍ - رَضِيَ اللهُ عَنْهُمَا - مُحْرِمِينَ بِعُمْرَةٍ  مِنْ  بَيْتِ الْمَقْدِسِ  ... الْحَدِيثَ  .","","Al-Matalib al-Aliyah 1288","","كعب الأحبار عن عبد الرحمن بن عبد الله بن أبي عمار الجشمي عن يوسف بن ماهك الفارسي عن عبد الله بن عثمان بن خثيم عن يحيى القطان عن مسدد بن مسرهد","باب الاعتمار من بيت المقدس"
"1564","[7/99]      57 - بَابُ طَوَافِ الْوَدَاعِ  1289  -  مُسَدَّدٌ :  حَدَّثَنَا  عِيسَى بْنُ يُونُسَ ،  ثَنَا  ابْنُ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ - رَضِيَ اللهُ عَنْهُ -  قَالَ  : إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ حَجَّ هَذَا  الْبَيْتَ  فَلْيَكُنْ آخِرَ عَهْدِهِ  الطَّوَافُ  بِالْبَيْتِ  ، وَرَخَّصَ لِلنِّسَاءِ  .","","Al-Matalib al-Aliyah 1289","","عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن عيسى بن يونس بن أبي إسحاق عن مسدد بن مسرهد","باب طواف الوداع"
"1565","[7/100]      1290  -  وَقَالَ إِسْحَاقُ :  أَنَا  وَكِيعٌ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ مَيْسَرَةَ ،  عَنْ  طَاوُسٍ ، قَالَ :  مَا رَأَيْتُ ابْنَ عَبَّاسٍ خَالَفَهُ أَحَدٌ فَسَكَتَ  حَتَّى ... فَخَالَفَهُ  جَابِرُ بْنُ عَبْدِ اللهِ  فِي الْمَرْأَةِ الْحَائِضِ بَعْدَ مَا تَطُوفُ يَوْمَ النَّحْرِ ،  فَقَالَ  ابْنُ عَبَّاسٍ  : تَنْفِرُ . فَأَرْسَلُوا إِلَى امْرَأَةٍ كَانَ أَصَابَهَا ذَلِكَ عَلَى عَهْدِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوَافَقَتِ  ابْنَ عَبَّاسٍ  .  قُلْتُ : أَصْلُهُ فِي الصَّحِيحِ بِدُونِ ذِكْرِ  جَابِرٍ  ، وَسُمِّيَتْ  أُمَّ سُلَيْمٍ  .         [7/101]","","Al-Matalib al-Aliyah 1290","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الملك بن ميسرة الهلالي عن مسعر بن كدام عن وكيع بن الجراح عن إسحاق ابن راهويه","باب طواف الوداع"
"1566","[7/102]      58 - بَابُ مَشْرُوعِيَّةِ مُلَاقَاةِ الْحَاجِّ وَالتَّبْشِيرِ بِسَلَامَتِهِ  1291  -  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنِ  الْمُهَاجِرِ ، قَالَ :  قَالَ  عُمَرُ - رَضِيَ اللهُ عَنْهُ - :  يُغْفَرُ لِلْحَاجِّ وَلِمَنِ اسْتَغْفَرَ لَهُ الْحَاجُّ بَقِيَّةَ ذِي الْحِجَّةِ  ، وَالْمُحَرَّمِ ، وَصَفَرَ ، وَعَشْرًا مِنْ رَبِيعٍ الْأَوَّلِ  .         [7/103]","","Al-Matalib al-Aliyah 1291","","عمر بن الخطاب عن مهاجر بن عمرو النبال عن ليث بن أبي سليم عن حماد بن زيد عن مسدد بن مسرهد","باب مشروعية ملاقاة الحاج والتبشير بسلامته"
"1567","[7/104]      1292  -  وَقَالَ الْحُمَيْدِيُّ :  حَدَّثَنَا  سُفْيَانُ ،  أَنَا  الْوَلِيدُ بْنُ كَثِيرٍ ،  عَنْ  وَهْبِ بْنِ كَيْسَانَ ، قَالَ :  رَأَيْتُ  أَبَا هُرَيْرَةَ - رَضِيَ اللهُ عَنْهُ - صَلَّى  بِالْمَدِينَةِ  بِالنَّاسِ مَسَاءً ، يَوْمَ  النَّفْرِ  الْآخِرِ  ، ثُمَّ قَالَ : أَلَا إِنَّ  مُحَمَّدًا أَبَا الْقَاسِمِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ سَبَقَ بِالْخَيْرَاتِ ، وَأَنَّ  ذَكْوَانَ مَوْلَى مَرْوَانَ  قَدْ سَبَقَ الْحَاجَّ ، وَأَخْبَرَ عَنِ النَّاسِ بِسَلَامَةٍ .  قَالَ  سُفْيَانُ  : وَفِي ذَلِكَ يَقُولُ  ذَكْوَانُ  :  كَلَّفْتُهَا  هَذَا  الْإِسْنَادُ  إِلَى  أَبِي هُرَيْرَةَ  - رَضِيَ اللهُ عَنْهُ - عَلَى شَرْطِ  الصَّحِيحِ  ، وَهُوَ مَوْقُوفٌ .","","Al-Matalib al-Aliyah 1292","","أبو هريرة الدوسي عن وهب بن كيسان القرشي عن الوليد بن كثير المخزومي عن سفيان بن عيينة عن الحميدي","باب مشروعية ملاقاة الحاج والتبشير بسلامته"
"1568","[7/105]      59 - بَابُ فَضَائِلِ  الْكَعْبَةِ  وَالْمَسْجِدِ الْحَرَامِ  1593  - إِسْحَاقُ :  أَخْبَرَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  ثَنَا  أَبُو هِلَالٍ الرَّاسِبِيُّ ،  عَنِ  الْحَسَنِ ، قَالَ :  إِنَّ  عُمَرَ - رَضِيَ اللهُ عَنْهُ - هَمَّ أَنْ يَأْخُذَ كَنْزَ  الْكَعْبَةِ  وَيُنْفِقَهُ فِي  سَبِيلِ  اللهِ تَعَالَى  ، فَقَالَ لَهُ أُبَيُّ بْنُ كَعْبٍ - رَضِيَ اللهُ عَنْهُ - : سَبَقَكَ صَاحِبَاكَ فَلَمْ يَفْعَلَا ، فَلَوْ كَانَ خَيْرًا لَفَعَلَاهُ ، فَتَرَكَهُ  .  هَذَا  مُنْقَطِعٌ  .         [7/106]","","Al-Matalib al-Aliyah 1593","","أبي بن كعب عن الحسن البصري عن محمد بن سليم الراسبي عن أبو عامر العقدي عن إسحاق ابن راهويه","باب فضائل الكعبة والمسجد الحرام"
"1569","[7/107]      1294  -  وَقَالَ مُعَاذُ بْنُ الْمُثَنَّى فِي زِيَادَاتِ مُسَدَّدٍ :  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  الْمُغِيرَةِ بْنِ زِيَادٍ ،  عَنْ  عَطَاءٍ ، قَالَ :  الْعَرْشُ عَلَى  الْحَرَمِ  .","","Al-Matalib al-Aliyah 1294","","عطاء بن أبي رباح عن المغيرة بن زياد البجلي عن حفص بن غياث النخعي عن داود بن رشيد الخوارزمي عن معاذ بن المثنى العنبري عن ابن حجر","باب فضائل الكعبة والمسجد الحرام"
"1570","[7/108]      1295  -  الْحَارِثُ :  حَدَّثَنَا  أَحْمَدُ بْنُ يَزِيدَ أَبُو عَبْدِ اللهِ - مِنْ أَهْلِ  كِرْمَانَ  -  ثَنَا  سَعِيدٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يُنْزِلُ اللهُ تَعَالَى كُلَّ يَوْمٍ مِائَةَ رَحْمَةٍ  ، سِتُّونَ مِنْهَا لِلطَّائِفِينَ ، وَعِشْرُونَ مِنْهَا لِأَهْلِ  مَكَّةَ  ، وَعِشْرُونَ مِنْهَا لِسَائِرِ النَّاسِ  .         [7/109]","","Al-Matalib al-Aliyah 1295","","عبد الله بن عباس عن عطاء بن أبي رباح عن ابن جريج عن سعيد بن سالم القداح عن أحمد بن يزيد أبو عبد الله عن الحارث بن محمد بن أبي أسامة","باب فضائل الكعبة والمسجد الحرام"
"1571","[7/110]      1296  -  وَقَالَ  الْفَاكِهِيُّ :  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ ،  ثَنَا  عَمْرُو بْنُ عَاصِمٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  إِنِّي لَأَعْلَمُ أَحَبَّ بُقْعَةٍ فِي الْأَرْضِ إِلَى اللهِ تَعَالَى  ، وَهِيَ  الْبَيْتُ  وَمَا حَوْلَهُ  .","","Al-Matalib al-Aliyah 1296","","علي بن أبي طالب عن عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن عمرو بن عاصم الكلابي عن الحسن بن علي الريحاني عن الفاكهي عن الحارث بن محمد بن أبي أسامة","باب فضائل الكعبة والمسجد الحرام"
"1572","[7/111]      1297  -  حَدَّثَنَا  مَيْمُونُ بْنُ الْحَكَمِ ،  ثَنَا  مُحَمَّدُ بْنُ جُعْشُمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :  سَمِعْتُ  ابْنَ أَبِي حُسَيْنٍ ، يَقُولُ :  قَالَ  عَبْدُ اللهِ بْنُ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - :  إِنَّ اللهَ - عَزَّ وَجَلَّ - اخْتَارَ الْكَلَامَ ، فَاخْتَارَ الْقُرْآنَ  ، وَاخْتَارَ الْبِلَادَ ، فَاخْتَارَ  الْحَرَمَ  ، وَاخْتَارَ  الْحَرَمَ  ، فَاخْتَارَ  الْمَسْجِدَ  ، وَاخْتَارَ  الْمَسْجِدَ  ، فَاخْتَارَ مَوْضِعَ  الْبَيْتِ  .","","Al-Matalib al-Aliyah 1297","","عبد الله بن عمر بن الخطاب عن عبد الله بن عبد الرحمن بن أبي حسين النوفلي عن ابن جريج عن ابن بوذويه محمد بن عبد الله بن جعشم عن ميمون بن الحكم عن الحارث بن محمد بن أبي أسامة","باب فضائل الكعبة والمسجد الحرام"
"1573","[7/112]      60 - بَابُ كِسْوَةِ  الْكَعْبَةِ  1298  -  الْحَارِثُ :  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ ،  ثَنَا  مَعْمَرُ بْنُ رَاشِدٍ ،  عَنْ  هَمَّامِ بْنِ مُنَبِّهٍ ،  عَنْ  أَبِي هُرَيْرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ سَبِّ  أَسْعَدَ الْحِمْيَرِيِّ  ، وَقَالَ : هُوَ أَوَّلُ مَنْ كَسَا  الْبَيْتَ  .  تَفَرَّدَ بِهِ  الْوَاقِدِيُّ  ، وَهُوَ ضَعِيفٌ  .         [7/113]","","Al-Matalib al-Aliyah 1298","","أبو هريرة الدوسي عن همام بن منبه الصنعاني عن معمر بن راشد عن الواقدي عن الحارث بن محمد بن أبي أسامة","باب كسوة الكعبة"
"1574","[7/114]      1299  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي سَبْرَةَ ،  عَنْ  خَالِدِ بْنِ رَبَاحٍ ،  عَنِ  الْمُطَّلِبِ بْنِ عَبْدِ اللهِ بْنِ حَنْطَبٍ ،  عَنْ  مِينَاءَ ، قَالَ :  سَمِعْتُ  الْعَبَّاسَ بْنَ عَبْدِ الْمُطَّلِبِ - رَضِيَ اللهُ عَنْهُ - يَقُولُ :  كَسَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْبَيْتَ  فِي حَجَّتِهِ  الْحِبَرَاتِ  .","","Al-Matalib al-Aliyah 1299","","العباس بن عبد المطلب عم رسول الله عن ميناء بن أبي ميناء الخراز عن المطلب بن عبد الله بن حنطب المخزومي عن خالد بن رباح الهذلي عن أبو بكر بن عبد الله بن محمد بن أبي سبرة عن الواقدي عن الحارث بن محمد بن أبي أسامة","باب كسوة الكعبة"
"1575","[7/115]      61 - بَابُ الصَّلَاةِ فِي  الْبَيْتِ  ( 52 ) حَدِيثُ  جَابِرٍ  - رَضِيَ اللهُ عَنْهُ - فِيهِ فِي  غَزْوَةِ الْفَتْحِ  يَأْتِي إِنْ شَاءَ اللهُ تَعَالَى .  1300  - وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  حَدَّثَنِي  أَبِي  ، قَالَ :  سُئِلَ عَلِيُّ بْنُ الْحُسَيْنِ - رَضِيَ اللهُ عَنْهُمَا - عَنِ الصَّلَاةِ فِي  الْكَعْبَةِ  ، فَقَالَ : صَلَّيْتُ مَعَ أَبِي الْحُسَيْنِ بْنِ عَلِيٍّ - رَضِيَ اللهُ عَنْهُمَا - فِي  الْكَعْبَةِ  .  هَذَا إِسْنَادٌ صَحِيحٌ مَوْقُوفٌ .         [7/116]","","Al-Matalib al-Aliyah 1300","","الحسين بن علي عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جعفر الصادق عن يحيى القطان عن مسدد بن مسرهد","باب الصلاة في البيت"
"1576","[7/117]      1301  - وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي مُلَيْكَةَ ، قَالَ :  إِنَّ  مُعَاوِيَةَ  - رَضِيَ اللهُ عَنْهُ - قَدِمَ  مَكَّةَ  ، فَدَخَلَ  الْكَعْبَةَ  ، فَأَرْسَلَ إِلَى ابْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - فَقَالَ :  أَيْنَ صَلَّى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ فَقَالَ : بَيْنَ السَّارِيَتَيْنِ  ، فَجَاءَ عَبْدُ اللهِ بْنُ الزُّبَيْرِ - رَضِيَ اللهُ عَنْهُمَا -  فَرَجَّ  الْبَابَ رَجًّا شَدِيدًا ، فَفُتِحَ لَهُ ، فَقَالَ : يَا  مُعَاوِيَةُ  ، أَمَا وَاللهِ لَقَدْ عَلِمْتَ أَنِّي كُنْتُ أَعْلَمُ مِثْلَ الَّذِي عَلِمَ  ابْنُ عُمَرَ  ، وَلَكِنَّكَ  حَسَدْتَنِي  أَنْ تَبْعَثَ إِلَيَّ  .         [7/118]","","Al-Matalib al-Aliyah 1301","","عبد الله بن الزبير عن ابن أبي مليكة عن حماد بن سلمة عن عبد الملك بن عبد العزيز القشيري عن أحمد بن منيع البغوي","باب الصلاة في البيت"
"1577","[7/119]      62 - بَابُ الْبَيَانِ بِأَنَّ دُخُولَ  الْبَيْتِ  لَيْسَ بِوَاجِبٍ  1302  - قَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  جَابِرٍ ،  عَنْ  مُحَمَّدٍ ،  عَنْ  عَائِشَةَ - رَضِيَ اللهُ عَنْهَا - قَالَتْ :  دَخَلَ عَلَيَّ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمًا ، فَقَالَ :  لَقَدْ صَنَعْتُ الْيَوْمَ شَيْئًا وَدِدْتُ أَنِّي لَمْ أَصْنَعْهُ  ، دَخَلْتُ  الْبَيْتَ  ، فَأَخْشَى أَنْ يَجِيءَ رَجُلٌ مِنْ أُفُقٍ مِنَ الْآفَاقِ فَلَا يَسْتَطِيعُ دُخُولَهُ ، فَيَرْجِعُ وَفِي نَفْسِهِ مِنْهُ شَيْءٌ  .         [7/120]","","Al-Matalib al-Aliyah 1302","","عائشة بنت أبي بكر الصديق عن أبو الزبير المكي عن جابر الجعفي عن معمر بن راشد عن عبد الرزاق الصنعاني عن ابن أبي عمر العدني","باب البيان بأن دخول البيت ليس بواجب"
"1578","[7/121]      63 - بَابُ السَّعْيِ  1303  - الْحَارِثُ :  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ ،  ثَنَا  مُوسَى بْنُ ضَمْرَةَ بْنِ سَعِيدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  زَيْدِ بْنِ خَالِدٍ - رَضِيَ اللهُ عَنْهُ -  قَالَ  :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - انْتَهَى إِلَى  الصَّفَا  ، فَبَدَأَ بِهِ نَهَارًا ، فَوَقَفَ عِنْدَهُ ، فَلَمْ يَزَلْ يَمْشِي حَتَّى انْتَهَى إِلَى بَطْنِ الْوَادِي ، فَرَمَلَ وَرَمَلَ النَّاسُ مَعَهُ ، حَتَّى جَاوَزَ الْوَادِيَ ، ثُمَّ مَشَى  .         [7/122]","","Al-Matalib al-Aliyah 1303","","زيد بن خالد الجهني عن عبيد الله بن عبد الله بن عتبة بن مسعود عن ضمرة بن سعيد بن أبي حنة المازني عن موسى بن ضمرة بن سعيد عن الواقدي عن الحارث بن محمد بن أبي أسامة","باب السعي"
"1579","[7/123]      1304  - وَقَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  وَكِيعٌ ،  ثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  بُدَيْلِ بْنِ مَيْسَرَةَ ،  عَنْ  صَفِيَّةَ بِنْتِ شَيْبَةَ ،  عَنْ  أُمِّ وَلَدٍ لِشَيْبَةَ ، قَالَتْ :  رَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسْعَى بَيْنَ الصَّفَا وَالْمَرْوَةِ ، وَيَقُولُ :  لَا يُقْطَعُ الْأَبْطَحُ إِلَّا  شَدًّا  .         [7/124]             [7/125]","","Al-Matalib al-Aliyah 1304","","أم ولد لشيبة عن صفية بنت شيبة الحجبية عن بديل بن ميسرة العقيلي عن هشام الدستوائي عن وكيع بن الجراح عن ابن أبي عمر العدني","باب السعي"
"1580","[7/126]      1305  -  حَدَّثَنَا  بِشْرٌ - هُوَ ابْنُ السَّرِيِّ -  حَدَّثَنَا  طَلْحَةُ بْنُ عُمَرَ  ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ أُمِّ مَكْتُومٍ ، قَالَ :  إِنَّهُ طَافَ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  ، فَانْحَدَرَ وَسَعَى  ابْنُ أُمِّ مَكْتُومٍ  ، ثُمَّ وَقَفَ حَتَّى أَدْرَكَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : وَحَبَّذَا هِيَ  .         [7/127]      كذا في طبعة دار العاصمة ، ولعل الصواب طلحة بن عمرو.","","Al-Matalib al-Aliyah 1305","","عمرو بن زائدة العامري عن عطاء بن أبي رباح عن طلحة بن عمرو الحضرمي عن بشر بن السري عن ابن أبي عمر العدني","باب السعي"
"1581","[7/128]      1306  / 1  -  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  ثَنَا  هِشَامٌ ،  عَنْ  بُدَيْلٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  صَفِيَّةَ بِنْتِ شَيْبَةَ ، قَالَتْ :  كُنْتُ فِي  خَوْخَةٍ  لِي ، فَرَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسْعَى بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  ، وَرَأَيْتُهُ إِذَا أَتَى عَلَى بَطْنِ الْوَادِي يَسْعَى حَتَّى تَبْدُوَ رُكْبَتَاهُ  .","","Al-Matalib al-Aliyah 1306","","صفية بنت شيبة الحجبية عن موسى بن عقبة عن بديل بن ميسرة العقيلي عن هشام الدستوائي عن عبد الرزاق الصنعاني عن ابن أبي عمر العدني","باب السعي"
"1582","1306  / 2  -  مُسَدَّدٌ :  حَدَّثَنَا  حَمَّادٌ ،  ثَنَا  بُدَيْلُ بْنُ مَيْسَرَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ حَكِيمٍ ،  عَنْ  صَفِيَّةَ بِنْتِ شَيْبَةَ ،  عَنِ  امْرَأَةٍ مِنْهُمْ ،  أَنَّهَا  رَأَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  خَوْخَةٍ  لَهَا ، وَهُوَ يَسْعَى فِي  بَطْنِ السَّيْلِ  ، وَهُوَ يَقُولُ  ... فَذَكَرَ كَالْأَوَّلِ .","","Al-Matalib al-Aliyah 1306","","أحد الصحابة عن صفية بنت شيبة الحجبية عن المغيرة بن حكيم الأبناوي عن بديل بن ميسرة العقيلي عن حماد بن زيد عن مسدد بن مسرهد","باب السعي"
"1583","[7/129]      1307  -  وَقَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  إِبْرَاهِيمَ بْنِ يَزِيدَ ،  عَنِ  الْوَلِيدِ بْنِ عَبْدِ اللهِ بْنِ أَبِي مُغِيثٍ ،  عَنْ  صَفِيَّةَ بِنْتِ شَيْبَةَ ،  عَنِ  امْرَأَةٍ مِنْ بَنِي نَوْفَلٍ ، قَالَتْ :  إِنَّهَا اطَّلَعَتْ مِنْ  خَوْخَةٍ  لَهَا ، فَرَأَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَقُولُ :  إِنَّ اللهَ تَعَالَى كَتَبَ عَلَيْكُمُ السَّعْيَ ، فَاسْعَوْا  ، وَسَمِعَتْهُ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ وَهُوَ يَسْعَى : "" رَبِّ اغْفِرْ وَارْحَمْ ، إِنَّكَ أَنْتَ الْأَعَزُّ الْأَكْرَمُ !  .","","Al-Matalib al-Aliyah 1307","","أحد الصحابة عن صفية بنت شيبة الحجبية عن الوليد بن عبد الله بن أبي مغيث العبدري عن إبراهيم بن يزيد الخوزي عن وكيع بن الجراح عن ابن أبي عمر العدني","باب السعي"
"1584","[7/130]      1308  - مُسَدَّدٌ :  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ أَبِي سُلَيْمَانَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - أَنَّهُ قَالَ :  يَا أَهْلَ مَكَّةَ إِنَّمَا طَوَافُكُمْ بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  إِذَا رَجَعْتُمْ مِنْ  مِنًى  .","","Al-Matalib al-Aliyah 1308","","عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن عبد الله بن المبارك عن مسدد بن مسرهد","باب السعي"
"1585","[7/131]      64 - بَابُ ذِكْرِ سِقَايَةِ  الْعَبَّاسِ  - رَضِيَ اللهُ عَنْهُ -  1309  / 1  -  إِسْحَاقُ :  أَخْبَرَنَا  قَبِيصَةُ بْنُ عُقْبَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مُوسَى بْنِ أَبِي عَائِشَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي رَزِينٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَلِيٍّ - رَضِيَ اللهُ عَنْهُ - قَالَ :  قُلْتُ  لِلْعَبَّاسِ  - رَضِيَ اللهُ عَنْهُ - : سَلْ لَنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْحِجَابَةَ  ، قَالَ : فَقَالَ :  أُعْطِيكُمْ مَا هُوَ خَيْرٌ مِنْهَا ، السِّقَايَةَ ، تَرْزَؤُكُمْ وَلَا تَرْزَؤُونَهَا ،  قَالَ : فَقُلْتُ لِقَبِيصَةَ : فَسَأَلَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ فَقَالَ : لَمْ يَزِدْ عَلَى هَذَا ، وَلَا يَكُونُ إِلَّا قَدَرَ سَأَلَهُ  .  هَذَا  إِسْنَادٌ حَسَنٌ  .  وَرَوَاهُ أَحْمَدُ بْنُ مَنِيعٍ وَأَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، عَنْ قَبِيصَةَ ، مِثْلَهُ .  وَرَوَاهُ الْبَزَّارُ ، عَنْ مُحَمَّدِ بْنِ مَعْمَرٍ ، عَنْ قَبِيصَةَ .","","Al-Matalib al-Aliyah 1309","","علي بن أبي طالب عن مسعود بن مالك الأسدي عن عبد الله بن أبي رزين الأسدي عن موسى بن أبي عائشة المخزومي عن سفيان الثوري عن قبيصة بن عقبة السوائي عن إسحاق ابن راهويه","باب ذكر سقاية العباس رضي الله عنه"
"1586","1309  / 2  - وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عُبَيْدُ اللهِ - هُوَ الْقَوَارِيرِيُّ -  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ الزُّبَيْرِ - هُوَ أَبُو أَحْمَدَ -  ثَنَا  سُفْيَانُ ، بِهِ نَحْوَهُ ، وَلَمْ يَقُلْ : عَنْ أَبِيهِ .         [7/132]             [7/133]","","Al-Matalib al-Aliyah 1309","","علي بن أبي طالب عن عبد الله بن أبي رزين الأسدي عن موسى بن أبي عائشة المخزومي عن سفيان الثوري عن محمد بن عبد الله بن الزبير عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","باب ذكر سقاية العباس رضي الله عنه"
"1587","[7/134]      1310  - إِسْحَاقُ :  أَخْبَرَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  الْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ - رَضِيَ اللهُ عَنْهُ - قَالَ :  أَتَانَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدَ السِّقَايَةِ ، فَذَهَبَ لِيَشْرَبَ مِنَ الْحَوْضِ الَّذِي يَشْرَبُ مِنْهُ النَّاسُ  ، فَقُلْنَا لَهُ : أَلَا نُخْرِجُ لَكَ ، فَإِنَّ هَذَا خَاضَهُ النَّاسُ بِأَيْدِيهِمْ ؟ فَقَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَا ، بَلِ اسْقُونِي مِنْ هَذَا الَّذِي قَدْ شَرِبَ النَّاسُ مِنْهُ . قَالَ : فَشَرِبَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ الَّذِي يَشْرَبُ مِنْهُ النَّاسُ  .  فِيهِ  انْقِطَاعٌ  ، وَهُوَ عِنْدَهُمْ مِنْ حَدِيثِ ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - نَحْوَهُ .         [7/135]","","Al-Matalib al-Aliyah 1310","","العباس بن عبد المطلب عم رسول الله عن الشعبي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن إسحاق ابن راهويه","باب ذكر سقاية العباس رضي الله عنه"
"1588","[7/136]      1311  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  يُونُسُ - هُوَ ابْنُ بُكَيْرٍ -  ثَنَا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ - هُوَ ابْنُ مُجَمِّعٍ -  عَنْ  زَيْدِ بْنِ عَلِيٍّ الْهَاشِمِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ ،  عَنْ  أَبِيهِ - رَضِيَ اللهُ عَنْهُ -  قَالَ  :  لَمَّا أَتَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْجَمْرَةَ  سَارَ حَتَّى أَتَى  الْبَيْتَ  ، وَطَافَ بِهِ سَبْعًا ، ثُمَّ أَتَى  زَمْزَمَ  ، فَأَتَى  بِسَجْلٍ  مِنْ مَاءٍ ، فَتَوَضَّأَ ، ثُمَّ قَالَ : انْزِعُوا عَلَى سِقَايَتِكُمْ ، يَا  بَنِي عَبْدِ الْمُطَّلِبِ  ، فَلَوْلَا أَنْ يَغْلِبَكُمُ النَّاسُ عَلَيْهَا لَنَزَعْتُ  .","","Al-Matalib al-Aliyah 1311","","أبو رافع القبطي عن عبيد الله بن أبي رافع مولى رسول الله عن زيد بن علي بن الحسين عن إبراهيم بن إسماعيل بن مجمع عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","باب ذكر سقاية العباس رضي الله عنه"
"1589","[7/137]      65 - بَابُ فَضْلِ  زَمْزَمَ  1312  / 1  -  قَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  أَبُو أُسَامَةَ ،  ثَنَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الصَّامِتِ ،  عَنْ  أَبِي ذَرٍّ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  زَمْزَمُ طَعَامُ  طُعْمٍ  ، وَشِفَاءُ سُقْمٍ  .  صَحِيحٌ  ، وَهُوَ طَرَفٌ مِنْ حَدِيثِ إِسْلَامِ  أَبِي ذَرٍّ  - رَضِيَ اللهُ عَنْهُ - وَقَدْ رَوَاهُ  مُسْلِمٌ  بِطُولِهِ سِوَى هَذَا اللَّفْظِ : "" وَشِفَاءُ سُقْمٍ "" .","","Al-Matalib al-Aliyah 1312","","أبو ذر الغفاري عن عبد الله بن الصامت الغفاري عن حميد بن هلال العدوي عن سليمان بن المغيرة القيسي عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة","باب فضل زمزم"
"1590","1312  / 2  -  وَقَالَ الطَّيَالِسِيُّ :  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ، فَذَكَرَ الْحَدِيثَ مُخْتَصَرًا ، وَفِيهِ :  شِفَاءُ سُقْمٍ  .         [7/138]","","Al-Matalib al-Aliyah 1312","","أبو ذر الغفاري عن عبد الله بن الصامت الغفاري عن حميد بن هلال العدوي عن سليمان بن المغيرة القيسي عن أبو داود الطيالسي","باب فضل زمزم"
"1591","[7/139]      66 - بَابُ حَرَمِ  الْمَدِينَةِ  وَفَضْلِهَا  1313  - إِسْحَاقُ :  أَخْبَرَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  ثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ إِبْرَاهِيمَ التَّيْمِيُّ ،  عَنْ  أَبِيهِ  ، قَالَ :  وَجَدَ سَعْدُ بْنُ أَبِي وَقَّاصٍ - رَضِيَ اللهُ عَنْهُ - عَاصِيَةً تَقْطَعُ الْحِمَى  ، فَأَخَذَ فَأْسَهَا وَعَبَاءَتَهَا ، فَاسْتَعْدَتْ عَلَيْهِ  عُمَرَ بْنَ الْخَطَّابِ  - رَضِيَ اللهُ عَنْهُ - فَقَالَ : أَدِّ إِلَيْهَا فَأْسَهَا وَعَبَاءَتَهَا ! .  فَقَالَ  : وَاللهِ لَا أُؤَدِّي ، إِنَّهَا غَنِيمَةٌ غَنَّمَنِيهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ! قَالَ : فَلَقَدِ اتَّخَذَ  سَعْدٌ  - رَضِيَ اللهُ عَنْهُ - مِنْ تِلْكَ الْفَأْسِ مِسْحَاةً فَمَا زَالَ يَعْمَلُ بِهَا حَتَّى مَاتَ  .  قُلْتُ : رَوَاهُ  مُسْلِمٌ  وَغَيْرُهُ مِنْ غَيْرِ هَذَا الْوَجْهِ بِغَيْرِ هَذَا اللَّفْظِ وَالسِّيَاقِ . وَفِي هَذَا زِيَادَةُ الِاسْتِعْدَاءِ إِلَى  عُمَرَ  - رَضِيَ اللهُ عَنْهُ - وَإِقْرَارُ  عُمَرَ  - رَضِيَ اللهُ عَنْهُ - لَهُ إِيَّاهُ عَلَى ذَلِكَ .  وَمُحَمَّدُ بْنُ إِبْرَاهِيمَ  لَمْ يَسْمَعْ مِنْ  سَعْدٍ  - رَضِيَ اللهُ عَنْهُ  - وَقَدْ رَوَى لَهُ  التِّرْمِذِيُّ  حَدِيثًا مِنْ رِوَايَتِهِ عَنْ  عَامِرِ بْنِ سَعْدٍ  ، عَنْ أَبِيهِ .         [7/140]             [7/141]","","Al-Matalib al-Aliyah 1313","","سعد بن أبي وقاص عن محمد بن إبراهيم بن الحارث التيمي عن موسى بن محمد بن إبراهيم التيمي عن عبد العزيز بن محمد الدراوردي عن إسحاق ابن راهويه","باب حرم المدينة وفضلها"
"1592","[7/142]      1314  -  إِسْحَاقُ :  أَخْبَرَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  أَخْبَرَنِي  زَيْدُ بْنُ أَسْلَمَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ وَجَدْتُمْ قَطَعَ مِنَ الْحِمَى شَيْئًا فَاضْرِبُوهُ وَاسْلُبُوهُ  .","","Al-Matalib al-Aliyah 1314","","زيد بن أسلم عن عبد العزيز بن محمد الدراوردي عن إسحاق ابن راهويه","باب حرم المدينة وفضلها"
"1593","[7/143]      1315  -  وَقَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  ثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ أَبِي قَتَادَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  لَمَّا أَقْبَلْنَا مِنْ غَزْوَةِ  تَبُوكَ  ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  هَذِهِ  طَيْبَةُ  أَسْكَنَنِيهَا رَبِّي  ،  تَنْفِي  خَبَثَ أَهْلِهَا كَمَا يَنْفِي  الْكِيرُ  خَبَثَ  الْحَدِيدِ ، فَمَنْ لَقِيَ مِنْكُمْ أَحَدًا مِنَ الْمُتَخَلِّفِينَ فَلَا يُكَلِّمَنَّهُ وَلَا يُجَالِسَنَّهُ !  .","","Al-Matalib al-Aliyah 1315","","أبو قتادة الأنصاري فارس رسول الله عن عبد الله بن أبي قتادة السلمي عن موسى بن عبيدة بن نشيط الحميري عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة","باب حرم المدينة وفضلها"
"1594","[7/144]      1316  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  زُهَيْرٌ - هُوَ ابْنُ حَرْبٍ -  ثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ - هُوَ ابْنُ زُبَالَةَ -  عَنْ  مَالِكٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  فُتِحَتِ الْمَدَائِنُ بِالسَّيْفِ  ، وَفُتِحَتِ  الْمَدِينَةُ  بِالْقُرْآنِ  .  تَفَرَّدَ  بِهِ  مُحَمَّدُ بْنُ الْحَسَنِ  وَكَانَ  ضَعِيفًا جِدًّا  ، وَإِنَّمَا هَذَا قَوْلُ  مَالِكٍ ،  فَجَعَلَهُ  مُحَمَّدُ بْنُ الْحَسَنِ  مَرْفُوعًا  ، وَأَبْرَزَ لَهُ  إِسْنَادًا  .  وَقَدْ رَوَاهُ غَيْرُ  مُحَمَّدِ بْنِ الْحَسَنِ  ، فَزَادَ فِي  الْإِسْنَادِ  عَائِشَةَ  - رَضِيَ اللهُ عَنْهَا -  .         [7/145]","","Al-Matalib al-Aliyah 1316","","عروة بن الزبير عن هشام بن عروة بن الزبير عن مالك بن أنس عن محمد بن الحسن بن زبالة المخزومي عن زهير بن حرب عن أبو يعلى الموصلي","باب حرم المدينة وفضلها"
"1595","[7/146]      1317  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُصْعَبٌ الزُّبَيْرِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عِكْرِمَةَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا -  عَنْ  أَبِيهِ  ،  عَنْ  سُبَيْعَةَ الْأَسْلَمِيَّةِ - رَضِيَ اللهُ عَنْهَا - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنِ اسْتَطَاعَ أَنْ يَمُوتَ  بِالْمَدِينَةِ  فَلْيَمُتْ  ، فَإِنَّهُ لَنْ يَمُوتَ بِهَا أَحَدٌ إِلَّا كُنْتُ لَهُ شَفِيعًا أَوْ شَهِيدًا يَوْمَ الْقِيَامَةِ  .  هَذَا حَدِيثٌ مَعْرُوفٌ مِنْ هَذَا الْوَجْهِ ، لَكِنْ عَنْ  صُمَيْتَةَ اللَّيْثِيَّةِ  بَدَلَ  سُبَيْعَةَ الْأَسْلَمِيَّةِ  ، أَخْرَجَهُ  النَّسَائِيُّ  .         [7/147]             [7/148]             [7/149]","","Al-Matalib al-Aliyah 1317","","سبيعة بنت الحارث الأسلمية عن عبد الله بن عمر بن الخطاب عن عبيد الله بن عبد الله بن عمر بن الخطاب عن عبد الله بن عكرمة بن عبد الرحمن المخزومي عن أسامة بن زيد الليثي المدني عن عبد العزيز بن محمد الدراوردي عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","باب حرم المدينة وفضلها"
"1596","1318  -  الْحَارِثُ :  حَدَّثَنَا  يَحْيَى هُوَ ابْنُ أَبِي بُكَيْرٍ -  عَنْ  شُعْبَةَ ، قَالَ :  قَالَ  عَمْرُو بْنُ مُرَّةَ :  أَخْبَرَنِي  أَبُو الْبَخْتَرِيِّ الطَّائِيُّ ، قَالَ :  إِنَّ نَاسًا كَانُوا  بِالْكُوفَةِ  ، فَذَكَرَ حَدِيثًا ، فِيهِ : فَأَتَوُا  الْمَدِينَةَ  ،  فَقَالَ  عُمَرُ - رَضِيَ اللهُ عَنْهُ - :  إِنَّ اللهَ تَعَالَى اخْتَارَ لِنَبِيِّهِ  الْمَدِينَةَ  ، وَهِيَ أَقَلُّ الْأَرْضِ طَعَامًا ، وَأَمْلَحُهُ مَاءً ، إِلَّا مَا كَانَ مِنْ هَذَا التَّمْرِ ، فَإِنَّهُ لَا يَدْخُلُهَا  الدَّجَّالُ  وَلَا الطَّاعُونُ ، إِنْ شَاءَ اللهُ تَعَالَى  .","","Al-Matalib al-Aliyah 1318","","عمر بن الخطاب عن سعيد بن فيروز الطائي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن يحيى بن أبي بكير عن الحارث بن محمد بن أبي أسامة","باب حرم المدينة وفضلها"
"1597","[7/150]      67 - بَابُ فَضْلِ أُحُدٍ  1319  -  أَخْبَرَنَا  عَبْدُ الْمُهَيْمِنِ بْنُ عَبَّاسِ بْنِ سَهْلِ بْنِ سَعْدٍ السَّاعِدِيُّ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي  - رَضِيَ اللهُ عَنْهُ - عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّهُ لَمَّا قَفَلَ مِنْ  غَزْوَةِ تَبُوكَ  ، فَاطَّلَعَ عَلَى  ثَنِيَّةِ الْمَبْرَكِ  بَدَا لَهُ  أُحُدٌ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  هَذَا جَبَلٌ  يُحِبُّنَا  وَنُحِبُّهُ  .  تَابَعَهُ  عُمَارَةُ بْنُ غَزِيَّةَ  ، عَنْ  عَبَّاسِ بْنِ سَهْلٍ  ،  عَلَّقَهُ  الْبُخَارِيُّ  مِنْ طَرِيقِهِ .         [7/151]","","Al-Matalib al-Aliyah 1319","","سهل بن سعد الساعدي عن عباس بن سهل بن سعد الساعدي عن عبد المهيمن بن عباس الساعدي عن إسحاق ابن راهويه","باب فضل أحد"
"1598","[7/152]      68 - بَابُ زِيَارَةِ قَبْرِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  1320  / 1  -  مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  إِنَّ  ابْنَ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - كَانَ إِذَا قَدِمَ مِنْ سَفَرٍ صَلَّى رَكْعَتَيْنِ فِي  مَسْجِدِ النَّبِيِّ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ أَتَى الْقَبْرَ ، فَقَالَ : السَّلَامُ عَلَيْكَ يَا رَسُولَ اللهِ ، السَّلَامُ عَلَيْكَ يَا  أَبَا بَكْرٍ  ، السَّلَامُ عَلَيْكَ يَا أَبَهْ !  .","","Al-Matalib al-Aliyah 1320","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عبيد الله بن عمر العمري عن يحيى القطان عن مسدد بن مسرهد","باب زيارة قبر النبي صلى الله عليه وسلم"
"1599","1320  / 2  -  وَقَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - :  أَنَّهُ كَانَ إِذَا قَدِمَ مِنْ سَفَرٍ بَدَأَ بِالْمَسْجِدِ  ، فَصَلَّى فِيهِ رَكْعَتَيْنِ ، ثُمَّ أَتَى الْقَبْرَ  ، فَذَكَرَ مِثْلَهُ .  صَحِيحٌ  مَوْقُوفٌ  .","","Al-Matalib al-Aliyah 1320","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن سفيان بن عيينة عن ابن أبي عمر العدني","باب زيارة قبر النبي صلى الله عليه وسلم"
"1600","[7/153]      1321  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَجْعَلُنَّ قَبْرِي وَثَنًا  .         [7/154]","","Al-Matalib al-Aliyah 1321","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","باب زيارة قبر النبي صلى الله عليه وسلم"
"1601","[7/155]      1322  -  وَقَالَ الطَّيَالِسِيُّ :  حَدَّثَنَا  سَوَّارُ بْنُ مَيْمُونٍ أَبُو الْجَرَّاحِ الْعَبْدِيُّ ،  حَدَّثَنِي  رَجُلٌ مِنْ آلِ عُمَرَ ،  عَنْ  عُمَرَ - رَضِيَ اللهُ عَنْهُ - قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ  زَارَ قَبْرِي - أَوْ قَالَ : مَنْ زَارَنِي -  كُنْتُ لَهُ  شَهِيدًا  أَوْ شَفِيعًا  . وَمَنْ مَاتَ فِي أَحَدِ الْحَرَمَيْنِ بَعَثَهُ اللهُ - عَزَّ وَجَلَّ - فِي الْآمِنِينَ يَوْمَ الْقِيَامَةِ  .         [7/156]             [7/157]","","Al-Matalib al-Aliyah 1322","","عمر بن الخطاب عن رجل من آل عمر عن سوار بن ميمون أبو الجراح العبدي عن أبو داود الطيالسي","باب زيارة قبر النبي صلى الله عليه وسلم"
"1602","[7/158]      1323  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  ثَنَا  حَفْصُ بْنُ أَبِي دَاوُدَ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ حَجَّ فَزَارَنِي بَعْدَ وَفَاتِي  كَانَ كَمَنْ زَارَنِي فِي حَيَاتِي  .         [7/159]","","Al-Matalib al-Aliyah 1323","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن حفيص الأسدي عن سليمان بن داود العتكي عن أبو يعلى الموصلي","باب زيارة قبر النبي صلى الله عليه وسلم"
"1603","1324  / 1  -  وَقَالَ ابْنُ أَبِي شَيْبَةَ :  حَدَّثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  ثَنَا  جَعْفَرُ بْنُ إِبْرَاهِيمَ - مِنْ وَلَدِ  ذِي الْجَنَاحَيْنِ  -  حَدَّثَنِي  عَلِيُّ بْنُ عُمَرَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَلِيِّ بْنِ الْحُسَيْنِ  - رَضِيَ اللهُ عَنْهُمَا -  أَنَّهُ رَأَى رَجُلًا يَجِيءُ إِلَى  خَوْخَةٍ  كَانَتْ عِنْدَ قَبْرِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَيَدْخُلُ فِيهَا فَيَدْعُو ، فَدَعَاهُ ، فَقَالَ : أَلَا أُحَدِّثُكَ  حَدِيثًا سَمِعْتُهُ  مِنْ أَبِي ،  عَنْ  جَدِّي - رَضِيَ اللهُ عَنْهُمَا - عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ :  لَا تَتَّخِذُوا قَبْرِي عِيدًا  ، وَلَا بُيُوتَكُمْ قُبُورًا ، وَصَلُّوا عَلَيَّ فَإِنَّ صَلَاتَكُمْ وَتَسْلِيمَكُمْ يَبْلُغُنِي حَيْثُمَا كُنْتُمْ  .","","Al-Matalib al-Aliyah 1324","","علي بن أبي طالب عن الحسين بن علي عن علي بن الحسين زين العابدين عن عمر بن علي بن الحسين بن علي بن أبي طالب الأصغر عن علي بن عمر بن علي بن الحسين بن علي بن أبي طالب عن جعفر بن إبراهيم بن محمد عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة","باب زيارة قبر النبي صلى الله عليه وسلم"
"1604","1324  / 2  - وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو بَكْرٍ بِهَذَا .         [7/160]","","Al-Matalib al-Aliyah 1324","","علي بن أبي طالب عن الحسين بن علي عن علي بن الحسين زين العابدين عن عمر بن علي بن الحسين بن علي بن أبي طالب الأصغر عن علي بن عمر بن علي بن الحسين بن علي بن أبي طالب عن جعفر بن إبراهيم بن محمد عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","باب زيارة قبر النبي صلى الله عليه وسلم"
"1605","[7/161]      69 - بَابُ فَضْلِ قُبَاءٍ  1325  -  قَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  أَخْبَرَنِي  يُوسُفُ بْنُ طَهْمَانَ ،  عَنْ  أَبِي أُمَامَةَ بْنِ سَهْلِ بْنِ حُنَيْفٍ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ تَوَضَّأَ فَأَحْسَنَ وُضُوءَهُ  ، ثُمَّ جَاءَ  مَسْجِدَ قُبَاءٍ  فَرَكَعَ فِيهِ أَرْبَعَ رَكَعَاتٍ ، كَانَ ذَلِكَ عَدْلَ عُمْرَةٍ  .  مُوسَى :  ضَعِيفٌ  ، وَقَدْ رَوَاهُ  النَّسَائِيُّ  وَابْنُ مَاجَهْ  مِنْ وَجْهٍ أَحْسَنَ مِنْهُ ، لَكِنْ بِغَيْرِ هَذَا السِّيَاقِ .         [7/162]             [7/163]","","Al-Matalib al-Aliyah 1325","","سهل بن حنيف الأوسي عن أسعد بن سهل بن حنيف عن يوسف بن طهمان مولى لآل معاوية عن موسى بن عبيدة بن نشيط الحميري عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة","باب فضل قباء"
"1606","[7/164]      1326  - وَقَالَ الْحَارِثُ :  ثَنَا  مُحَمَّدُ بْنُ عُمَرَ ،  نَا  الْوَلِيدُ بْنُ كَثِيرٍ ،  عَنِ  الْأَغَرِّ ،  عَنْ  أَبِي هُرَيْرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَأْتِي  قُبَاءً  رَاكِبًا وَمَاشِيًا  .","","Al-Matalib al-Aliyah 1326","","أبو هريرة الدوسي عن الأغر المديني مولى أبي هريرة وأبي سعيد الخدري عن الوليد بن كثير المخزومي عن الواقدي عن الحارث بن محمد بن أبي أسامة","باب فضل قباء"
"1607","[7/165]      1327  - وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الْوَلِيدِ بْنِ كَثِيرٍ ،  عَنْ  رَجُلٍ ، قَالَ :  أَتَى عُمَرُ - رَضِيَ اللهُ عَنْهُ -  مَسْجِدَ قُبَاءٍ  فَأَمَرَ  أَبَا لَيْلَى  ،  فَقَالَ  لَهُ :  اجْتَنِبِ  الْعَوَاهِنَ  ، وَاكْنُسِ الْمَسْجِدَ  بِسَعَفَةٍ  ، قَالَ : وَلَوْ كَانَ هَذَا الْمَسْجِدُ فِي أُفُقٍ مِنَ الْآفَاقِ ، أَوْ مِصْرٍ مِنَ الْأَمْصَارِ ، لَكَانَ يَنْبَغِي لَنَا أَنْ نَأْتِيَهُ  .         [7/166]","","Al-Matalib al-Aliyah 1327","","عمر بن الخطاب عن رجل عن الوليد بن كثير المخزومي عن سفيان بن عيينة عن مسدد بن مسرهد","باب فضل قباء"
"1608","[7/167]      70 - بَابُ فَضْلِ  الْمَسْجِدِ النَّبَوِيِّ  1328  -  الْحَارِثُ :  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ ،  ثَنَا  سَلَمَةُ بْنُ وَرْدَانَ ، قَالَ :  سَمِعْتُ  أَبَا سَعِيدِ بْنَ الْمُعَلَّى ، قَالَ :  سَمِعْتُ  عَلِيًّا - رَضِيَ اللهُ عَنْهُ - يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  صَلَاةٌ فِي مَسْجِدِي خَيْرٌ مِنْ أَلْفِ صَلَاةٍ فِيمَا سِوَاهُ مِنَ الْمَسَاجِدِ  ، إِلَّا  الْمَسْجِدَ الْحَرَامَ  .         [7/168]","","Al-Matalib al-Aliyah 1328","","علي بن أبي طالب عن أبو سعيد بن أبي المعلى المدني عن سلمة بن وردان الجندعي عن الواقدي عن الحارث بن محمد بن أبي أسامة","باب فضل المسجد النبوي"
"1609","[7/169]      1329  -  وَقَالَ الْحُمَيْدِيُّ :  حَدَّثَنَا  سُفْيَانُ ،  ثَنَا  زِيَادُ بْنُ سَعْدٍ ،  أَخْبَرَنِي  سُلَيْمَانُ بْنُ عَتِيقٍ ، قَالَ :  سَمِعْتُ  ابْنَ الزُّبَيْرِ - رَضِيَ اللهُ عَنْهُمَا - يَقُولُ :  سَمِعْتُ  عُمَرَ بْنَ الْخَطَّابِ - رَضِيَ اللهُ عَنْهُ - يَقُولُ :  صَلَاةٌ فِي  الْمَسْجِدِ الْحَرَامِ  أَفْضَلُ مِنْ مِائَةِ أَلْفِ صَلَاةٍ فِيمَا سِوَاهُ  مِنَ الْمَسَاجِدِ  ، قَالَ سُفْيَانُ :  فَيَرَوْنَ أَنَّ الصَّلَاةَ فِي  الْمَسْجِدِ الْحَرَامِ  أَفْضَلُ مِنْ مِائَةِ أَلْفِ صَلَاةٍ فِيمَا سِوَاهُ  مِنَ الْمَسَاجِدِ إِلَّا  مَسْجِدَ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَإِنَّ فَضْلَهُ عَلَيْهِ بِمِائَةِ صَلَاةٍ  .         [7/170]             [7/171]","","Al-Matalib al-Aliyah 1329","","عمر بن الخطاب عن عبد الله بن الزبير عن سليمان بن عتيق المحاربي عن زياد بن سعد الخراساني عن سفيان بن عيينة عن الحميدي","باب فضل المسجد النبوي"
"1610","[7/172]      71 - بَابُ فَضْلِ  الطَّائِفِ  1330  -  إِسْحَاقُ :  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ الْحَارِثِ الْمَخْزُومِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ إِنْسَانَ الثَّقَفِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ رَبِّهِ بْنِ الْحَكَمِ بْنِ عُثْمَانَ بْنِ بِشْرٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  عَنْ  كَعْبٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  إِنَّ  وَجًّا  مُقَدَّسٌ ، مِنْهُ عَرَجَ الرَّبُّ - تَبَارَكَ وَتَعَالَى - إِلَى السَّمَاءِ الدُّنْيَا  يَوْمَ قَضَى خَلْقَ الْأَرْضِ  .  قَالَ الْمَخْزُومِيُّ :  وَجٌّ  : وَادِي الطَّائِفِ .         [7/173]","","Al-Matalib al-Aliyah 1330","","كعب الأحبار عن أبو بكر بن عبد الرحمن راهب قريش عن عبد الله بن عبد ربه بن الحكم الثقفي عن محمد بن عبد الله بن إنسان الثقفي عن عبد الله بن الحارث بن عبد الملك المخزومي عن إسحاق ابن راهويه","باب فضل الطائف"
"1611","[7/174]      72 - بَابُ فَضْلِ  مَسْجِدِ الْخَيْفِ  1331  -  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  عَبْدِ الْمَلِكِ ،  حَدَّثَنِي  عَطَاءٌ ،  عَنْ  أَبِي هُرَيْرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  صَلَّى فِي  مَسْجِدِ الْخَيْفِ  سَبْعُونَ نَبِيًّا  ، وَبَيْنَ  حِرَاءٍ  وَثَبِيرٍ  سَبْعُونَ نَبِيًّا  .","","Al-Matalib al-Aliyah 1331","","أبو هريرة الدوسي عن عطاء بن أبي رباح عن ابن جريج عن يحيى القطان عن مسدد بن مسرهد","باب فضل مسجد الخيف"
"1612","[7/175]      1332  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  الرَّمَادِيُّ أَبُو بَكْرٍ ،  ثَنَا  أَبُو هَمَّامٍ الدَّلَّالُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَسْجِدُ الْخَيْفِ  قَبْرُ سَبْعِينَ نَبِيًّا  .","","Al-Matalib al-Aliyah 1332","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن إبراهيم بن طهمان عن محمد بن محبب الدلال عن أحمد بن منصور الرمادي عن أبو يعلى الموصلي","باب فضل مسجد الخيف"
"1613","[7/176]      73 - بَابُ فَضْلِ  الْمَسْجِدِ الْأَقْصَى  1333  -  قَالَ عَبْدُ اللهِ بْنُ أَحْمَدَ فِي الزُّهْدِ :  حَدَّثَنَا  الْحَسَنُ - هُوَ ابْنُ وَاقِعٍ -  عَنْ  ضَمْرَةَ ،  عَنْ  أَبِي عَنَانٍ اللَّخْمِيِّ ،  عَنْ  سُلَيْمَانَ بْنِ كَيْسَانَ بْنِ أَبِي عِيسَى الْخُرَاسَانِيِّ ، قَالَ :  مَنْ صَلَّى الْفَرِيضَةَ فِي  مَسْجِدِ بَيْتِ الْمَقْدِسِ  فِي جَمَاعَةٍ  ، كَانَتْ لَهُ بِخَمْسٍ وَعِشْرِينَ أَلْفَ صَلَاةٍ ، وَمَنْ صَلَّاهَا وَحْدَهُ كَانَتْ لَهُ أَلْفَ صَلَاةٍ  .","","Al-Matalib al-Aliyah 1333","","سليمان بن كيسان الخراساني عن أبو عنان اللخمي عن ضمرة بن ربيعة الفلسطيني عن الحسن بن واقع الرملي عن عبد الله بن أحمد بن حنبل","باب فضل المسجد الأقصى"
"1614","[7/177]      1334  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عَمْرُو بْنُ الْحُصَيْنِ ،  ثَنَا  يَحْيَى بْنُ الْعَلَاءِ ،  ثَنَا  ثَوْرُ بْنُ يَزِيدَ ،  عَنْ  زِيَادِ بْنِ أَبِي سَوْدَةَ ،  عَنْ  أَبِي أُمَامَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَتْ مَيْمُونَةُ بِنْتُ الْحَارِثِ - رَضِيَ اللهُ عَنْهَا - زَوْجُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا رَسُولَ اللهِ ، أَفْتِنَا فِي  بَيْتِ الْمَقْدِسِ  ؟ قَالَ : أَرْضُ الْمَحْشَرِ  وَالْمَنْشَرِ  ، إِيتُوهُ فَصَلُّوا فِيهِ ، فَإِنَّ صَلَاةً فِيهِ كَأَلْفِ صَلَاةٍ فِيمَا سِوَاهُ . قَالَتْ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ إِنْ لَمْ نُطِقْ مَحْمَلًا إِلَيْهَا ؟ قَالَ : فَلْيُهْدِ لَهُ زَيْتًا يُسْرَجُ فِيهِ ، مَنْ أَهْدَى إِلَيْهِ شَيْئًا كَانَ كَمَنْ صَلَّى لِلهِ فِيهِ  .  قُلْتُ  :  عَمْرٌو  وَشَيْخُهُ  ضَعِيفَانِ جِدًّا  ، وَهَذَا  الْإِسْنَادُ خَطَأٌ  . إِنَّمَا رَوَاهُ  زِيَادُ بْنُ أَبِي سَوْدَةَ  ، عَنْ أَخِيهِ  عُثْمَانَ  ، عَنْ  مَيْمُونَةَ  - رَضِيَ اللهُ عَنْهَا - وَلَيْسَتْ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَخَبَّطَ  يَحْيَى  أَوْ  عَمْرٌو  فِي  إِسْنَادِهِ  ، وَهُوَ عِنْدَ  أَبِي دَاوُدَ  وَابْنِ مَاجَهْ  عَلَى الصَّوَابِ .         [7/178]             [7/179]             [7/180]","","Al-Matalib al-Aliyah 1334","","ميمونة بنت الحارث زوج رسول الله عن أبو أمامة الباهلي عن زياد بن أبي سودة المقدسى عن ثور بن يزيد الكلاعي عن يحيى بن العلاء الفوراردي عن عمرو بن الحصين العقيلي عن أبو يعلى الموصلي","باب فضل المسجد الأقصى"
"1615","[7/181]      13 - كِتَابُ الْبُيُوعِ  1 - بَابُ فَضْلِ السَّمَاحَةِ فِي الْبَيْعِ وَالتَّقَاضِي  1335  أَخْبَرَنَا  شَبَابَةُ بْنُ سَوَّارٍ الْمَدَائِنِيُّ ،  ثَنَا  هِشَامٌ - وَهُوَ ابْنُ الْغَازِ -  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي حُسَيْنٍ ، قَالَ :  إِنَّ  عُثْمَانَ بْنَ عَفَّانَ - رَضِيَ اللهُ عَنْهُ - ابْتَاعَ حَائِطًا مِنْ رَجُلٍ ، فَسَاوَمَهُ حَتَّى قَامَ عَلَى الثَّمَنِ ، ثُمَّ قَالَ : أَعْطِنِي يَدَكَ ، قَالَ : وَكَانُوا لَا يَسْتَوْجِبُونَ إِلَّا بِصَفْقَةٍ ، فَلَمَّا رَأَى ذَلِكَ الْبَائِعُ ، قَالَ : لَا وَاللهِ ، لَا أَبِيعُهُ حَتَّى تَزِيدَنِي عَشَرَةَ آلَافٍ . فَالْتَفَتَ  عُثْمَانُ  إِلَى  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  - رَضِيَ اللهُ عَنْهُمَا - فَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ اللهَ تَعَالَى يُدْخِلُ الْجَنَّةَ رَجُلًا كَانَ سَمْحًا بَائِعًا  ، وَمُبْتَاعًا ، وَقَاضِيًا ، وَمُقْتَضِيًا ، ثُمَّ قَالَ : دُونَكَ الْعَشَرَةُ آلَافٍ لِأَسْتَوْجِبَ هَذِهِ الْكَلِمَةَ الَّتِي سَمِعْتُهَا مِنَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  .  هَذَا  مُرْسَلٌ  حَسَنٌ  ، يُؤَيِّدُهُ الَّذِي بَعْدَهُ  .         [7/182]","","Al-Matalib al-Aliyah 1335","","عثمان بن عفان عن عبد الله بن عبد الرحمن بن أبي حسين النوفلي عن هشام بن الغاز الجرشي عن شبابة بن سوار المدائني عن ابن حجر","باب فضل السماحة في البيع والتقاضي"
"1616","[7/183]      1336  -  أَخْبَرَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ ،  أَنَا  هِشَامُ بْنُ حَسَّانَ ،  عَنْ  مَطَرٍ الْوَرَّاقِ ، قَالَ :  إِنَّ  عُثْمَانَ بْنَ عَفَّانَ - رَضِيَ اللهُ عَنْهُ - قَدِمَ حَاجًّا ، فَلَمَّا قَضَى حَجَّهُ قَدِمَ إِلَى أَرْضٍ  بِالطَّائِفِ  ، فَإِذَا أَرْضٌ إِلَى جَنْبِ أَرْضِهِ فَطَلَبَهَا ، فَكَانَ بَيْنَهُمَا عَشَرَةُ آلَافٍ فِي الثَّمَنِ . فَلَمَّا وَضَعَ  عُثْمَانُ  - رَضِيَ اللهُ عَنْهُ - رِجْلَهُ فِي الرِّكَابِ ، قَالَ لِرَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَسَمِعْتَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  رَحِمَ اللهُ عَبْدًا سَمْحَ الْبَيْعِ ، سَمْحَ الِابْتِيَاعِ ، سَمْحَ الْقَضَاءِ  ، سَمْحَ التَّقَاضِي ؟ فَقَالَ الرَّجُلُ : نَعَمْ . فَقَالَ  عُثْمَانُ  - رَضِيَ اللهُ عَنْهُ - : رُدَّا عَلَيَّ الرَّجُلَ ، فَأَعْطَاهُ الْعَشَرَةَ آلَافٍ وَأَخَذَ الْأَرْضَ  .  هَذَا  مُرْسَلٌ  حَسَنٌ يُؤَيِّدُهُ الَّذِي قَبْلَهُ  ، فَاعْتَضَدَ كُلٌّ مِنْهُمَا بِالْآخَرِ لِاخْتِلَافِ الْمَخْرَجَيْنِ .","","Al-Matalib al-Aliyah 1336","","عثمان بن عفان عن مطر بن طهمان الوراق عن هشام بن حسان العتكي عن محمد بن بكر بن عثمان البرساني عن ابن حجر","باب فضل السماحة في البيع والتقاضي"
"1617","[7/184]      1337  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  ثَنَا  الضَّحَّاكُ بْنُ مَخْلَدٍ ،  ثَنَا  سَالِمٌ الْخَيَّاطُ ،  عَنْ  عُثْمَانَ بْنِ عَفَّانَ - رَضِيَ اللهُ عَنْهُ -  أَنَّهُ سَاوَمَ رَجُلًا بِأَرْضٍ حَتَّى  وَجَبَ  الْبَيْعُ ، أَوْ كَادَ أَنْ يَجِبَ  ، فَقَالَ الرَّجُلُ : وَاللهِ لَا أُعْطِيكَ حَتَّى تَزِيدَنِي عَشَرَةَ آلَافٍ . فَالْتَفَتَ  عُثْمَانُ  - رَضِيَ اللهُ عَنْهُ - إِلَى رَجُلٍ ، فَقَالَ : أَتَعْلَمُونَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  رَحِمَ اللهُ رَجُلًا سَمْحَ التَّقَاضِي  ، سَمْحَ الِاقْتِضَاءِ ؟ قَالُوا : نَعَمْ . فَزَادَهُ عَشَرَةَ آلَافٍ ، وَأَخَذَ الْأَرْضَ  .","","Al-Matalib al-Aliyah 1337","","عثمان بن عفان عن سالم بن عبد الله الخياط عن أبو عاصم النبيل عن زهير بن حرب عن أبو يعلى الموصلي","باب فضل السماحة في البيع والتقاضي"
"1618","[7/185]      1338  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  ثَنَا  حَرْبُ بْنُ سُرَيْجٍ ،  حَدَّثَنِي  رَجُلٌ مِنْ بَلْعَدَوِيَّةِ ،  حَدَّثَنِي  جَدِّي  ، قَالَ :  انْطَلَقْتُ إِلَى  الْمَدِينَةِ  فَنَزَلْتُ عِنْدَ الْوَادِي ، فَإِذَا رَجُلَانِ بَيْنَهُمَا عَنْزٌ وَاحِدَةٌ ، وَإِذَا الْمُشْتَرِي يَقُولُ لِلْبَائِعِ : أَحْسِنْ مُبَايَعَتِي ، فَإِذَا  رَجُلٌ  حَسَنُ الْجِسْمِ ، فَقَالَ الْمُشْتَرِي : يَا رَسُولَ اللهِ ، قُلْ لَهُ يُحْسِنْ مُبَايَعَتِي ! فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَدَّ يَدَهُ :  أَمْوَالَكُمْ تَمْلِكُونَ ، إِنِّي لَأَرْجُو أَنْ أَلْقَى اللهَ تَعَالَى يَوْمَ الْقِيَامَةِ لَا يَطْلُبُنِي أَحَدٌ بِشَيْءٍ  ، ظَلَمْتُهُ فِي مَالٍ وَلَا دَمٍ وَلَا عِرْضٍ إِلَّا بِحَقِّهِ . رَحِمَ اللهُ رَجُلًا سَهْلَ الْبَيْعِ ، سَهْلَ الشِّرَى ، سَهْلَ الْأَخْذِ ، سَهْلَ الْعَطَاءِ ، سَهْلَ التَّقَاضِي  .         [7/186]","","Al-Matalib al-Aliyah 1338","","أحد الصحابة عن رجل من بلعدوية عن حرب بن سريج المنقري عن عثمان بن عمر بن فارس عن يعقوب بن إبراهيم بن كثير عن أبو يعلى الموصلي","باب فضل السماحة في البيع والتقاضي"
"1619","[7/187]      2 - بَابُ الْبَيْعِ عَنْ تَرَاضٍ وَجَوَازِ الْمُعَاطَاةِ  1339  / 1  -  إِسْحَاقُ وَعَبْدُ بْنُ حُمَيْدٍ جَمِيعًا ، قَالَ  إِسْحَاقُ  :  أَنَا  ، وَقَالَ  عَبْدٌ  :  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  ثَنَا  الْمُخْتَارُ - هُوَ ابْنُ قَانِعٍ التَّمَّارُ -  عَنْ  أَبِي مَطَرٍ ، قَالَ :  خَرَجْتُ مِنَ الْمَسْجِدِ ، فَإِذَا رَجُلٌ يُنَادِي خَلْفِي : ارْفَعْ إِزَارَكَ  ، فَإِنَّهُ أَتْقَى لِرَبِّكَ ، وَأَنْقَى لِثَوْبِكَ ، وَخُذْ مِنْ رَأْسِكَ إِنْ كُنْتَ مُسْلِمًا ! فَمَشَيْتُ خَلْفَهُ وَهُوَ مُتَّزِرٌ بِإِزَارٍ ، وَمُرْتَدٍ بِرِدَاءٍ وَمَعَهُ الدِّرَّةُ ، فَقُلْتُ : مَنْ هَذَا ؟ فَقِيلَ : عَلِيٌّ أَمِيرُ الْمُؤْمِنِينَ ... فَذَكَرَ الْحَدِيثَ ، وَفِيهِ : ثُمَّ أَتَى دَارَ بَزَّارٍ ، فَقَالَ : يَا شَيْخُ ، أَحْسِنْ بَيْعَتِي فِي قَمِيصٍ بِثَلَاثَةِ دَرَاهِمَ ! فَلَمَّا عَرَفَهُ لَمْ يَشْتَرِ مِنْهُ شَيْئًا . ثُمَّ أَتَى آخَرَ ، فَلَمَّا عَرَفَهُ لَمْ يَشْتَرِ مِنْهُ شَيْئًا . ثُمَّ أَتَى غُلَامًا حَدَثًا فَاشْتَرَى مِنْهُ قَمِيصًا بِثَلَاثَةِ دَرَاهِمَ ، وَلَبِسَهُ مَا بَيْنَ الرُّسْغَيْنِ إِلَى  الْكَعْبَيْنِ  . فَجَاءَ صَاحِبُ الثَّوْبِ ، فَقِيلَ : إِنَّ ابْنَكَ بَاعَ مِنْ أَمِيرِ الْمُؤْمِنِينَ قَمِيصًا بِثَلَاثَةِ دَرَاهِمَ . قَالَ : فَهَلَّا أَخَذْتَ مِنْهُ دِرْهَمَيْنِ ؟ فَأَخَذَ الدِّرْهَمَ ، ثُمَّ جَاءَ بِهِ إِلَى  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - وَهُوَ جَالِسٌ مَعَ الْمُسْلِمِينَ ، فَقَالَ : أَمْسِكْ هَذَا الدِّرْهَمَ ! قَالَ : مَا شَأْنُهُ ؟ قَالَ : كَانَ قَمِيصًا ثَمَنَ دِرْهَمَيْنِ -  يَعْنِي بَاعَهُ لَكَ ابْنِي بِثَلَاثَةِ دَرَاهِمَ  قَالَ - رَضِيَ اللهُ عَنْهُ - : بَاعَنِي رِضَائِي ، وَأَخَذَ رِضَاهُ  .  [2]","","Al-Matalib al-Aliyah 1339","","علي بن أبي طالب عن أبو مطر الجهني عن المختار بن نافع العكلي عن محمد بن عبيد بن أبي أمية عن إسحاق ابن راهويه","باب البيع عن تراض وجواز المعاطاة"
"1620","1339  / 2  - وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عَمَّارٍ ،  ثَنَا  الْمُعَافَى بْنُ عِمْرَانَ ،  ثَنَا  مُخْتَارٌ التَّمَّارُ ، بِهِ         [7/188]      حَدِيثُ  طَارِقِ بْنِ عَبْدِ اللهِ الْمُحَارِبِيِّ  ، الدَّالُّ عَلَى صِحَّةِ الْمُعَاطَاةِ ، يَأْتِي ، إِنْ شَاءَ اللهُ تَعَالَى قَرِيبًا فِي بَابِ الْكَيْلِ عَلَى مَنِ اسْتَوْفَى وَصِحَّةِ الْمُعَاطَاةِ .         [7/189]","","Al-Matalib al-Aliyah 1339","","علي بن أبي طالب عن أبو مطر الجهني عن المختار بن نافع العكلي عن المعافى بن عمران عن محمد بن عبد الله بن عمار الغامدي عن أبو يعلى الموصلي","باب البيع عن تراض وجواز المعاطاة"
"1621","[7/190]      3 - بَابُ النَّدْبِ إِلَى الْيَقَظَةِ فِي التَّبَايُعِ  1340  -  أَبُو يَعْلَى :  حَدَّثَنَا  كَامِلٌ ،  ثَنَا  أَبُو هِشَامٍ الْقَنَّادُ ،  ثَنَا  الْحُسَيْنُ بْنُ عَلِيٍّ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  الْمَغْبُونُ لَا مَحْمُودٌ وَلَا مَأْجُورٌ  .         [7/191]","","Al-Matalib al-Aliyah 1340","","الحسين بن علي عن أبو هشام القناد عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","باب الندب إلى اليقظة في التبايع"
"1622","[7/192]      4 - بَابُ الصُّنَّاعِ وَكَسْبِهِمْ  1341  - قَالَ أَبُو يَعْلَى :  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ صَالِحِ بْنِ عَبْدِ الصَّمَدِ ،  ثَنَا  قَاسِمٌ ،  عَنِ  الْعَلَاءِ ،  عَنْ  رَجُلٍ ،  عَنِ  ابْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  أَعْطَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَالَتَهُ غُلَامًا  ، فَقَالَ : لَا تَجْعَلِيهِ قَصَّابًا ، وَلَا حَجَّامًا ، وَلَا صَائِغًا  .         [7/193]      كذا في طبعة دار العاصمة ، ولعل الصواب : ( عبد الله أخو صالح )","","Al-Matalib al-Aliyah 1341","","عبد الله بن عمر بن الخطاب عن رجل عن العلاء بن زهير الأزدي عن القاسم بن الحكم بن كثير عن عبد الله بن صالح بن عبد الصمد عن أبو يعلى الموصلي","باب الصناع وكسبهم"
"1623","[7/194]      1342  -  حَدَّثَنَا  جُبَارَةُ بْنُ الْمُغَلِّسِ ،  ثَنَا  أَبُو بَكْرٍ النَّهْشَلِيُّ ،  ثَنَا  الْهَيْثَمُ ،  عَنْ  جَابِرٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - احْتَجَمَ فِي  الْأَخْدَعَيْنِ  ، وَبَيْنَ الْكَتِفَيْنِ ، وَأَعْطَى الْحَجَّامَ أَجْرَهُ ، وَلَوْ كَانَ حَرَامًا لَمْ يُعْطِهِ  .         [7/195]","","Al-Matalib al-Aliyah 1342","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الهيثم بن حبيب عن أبو بكر النهشلي عن جبارة بن المغلس عن أبو يعلى الموصلي","باب الصناع وكسبهم"
"1624","[7/196]      1343  -  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْأَذْرَمِيُّ ،  ثَنَا  عَلِيُّ بْنُ يَزِيدَ الصُّدَائِيُّ ،  عَنِ  الْحَارِثِ بْنِ نَبْهَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَلِيٍّ - رَضِيَ اللهُ عَنْهُ - قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الْمُغَنِّيَاتِ  ، وَعَنِ النَّوَّاحَاتِ ، وَعَنْ شِرَائِهِنَّ وَبَيْعِهِنَّ وَالتِّجَارَةِ فِيهِنَّ . قَالَ : كَسْبُهُنَّ حَرَامٌ  .","","Al-Matalib al-Aliyah 1343","","علي بن أبي طالب عن الحارث الأعور عن أبو إسحاق السبيعي عن الحارث بن نبهان الجرمي عن علي بن يزيد بن سليم الأكفاني عن عبد الله بن محمد الأذرمي عن أبو يعلى الموصلي","باب الصناع وكسبهم"
"1625","[7/197]      1344  -  حَدَّثَنَا  مُصْعَبٌ ،  ثَنَا  بِشْرُ بْنُ السَّرِيِّ ،  عَنْ  مُصْعَبِ بْنِ ثَابِتٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ - رَضِيَ اللهُ عَنْهَا - قَالَتْ : إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ اللهَ - تَبَارَكَ وَتَعَالَى - يُحِبُّ إِذَا عَمِلَ أَحَدُكُمْ عَمَلًا أَنْ يُتْقِنَهُ  .","","Al-Matalib al-Aliyah 1344","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن بشر بن السري عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","باب الصناع وكسبهم"
"1626","[7/198]      5 - بَابُ التَّرْهِيبِ مِنْ كَسْبِ الْحَرَامِ وَالتَّرْغِيبِ فِي كَسْبِ الْحَلَالِ  1345  -  الْحَارِثُ :  حَدَّثَنَا  دَاوُدُ بْنُ الْمُحَبَّرِ ،  ثَنَا  الْمَيْسَرَةُ بْنُ عَبْدِ رَبِّهِ ،  عَنْ  أَبِي عَائِشَةَ السَّعْدِيِّ ،  عَنْ  يَزِيدَ بْنِ عُمَرَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي هُرَيْرَةَ وَابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمْ - قَالَا :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ... فَذَكَرَ حَدِيثًا طَوِيلًا ، قَالَ فِيهِ :  مَنْ يَكْسِبْ مَالًا حَرَامًا لَمْ يَقْبَلِ اللهُ لَهُ صَدَقَةً  ، وَلَا عِتْقًا ، وَلَا حَجًّا ، وَلَا عُمْرَةً ، وَكَتَبَ اللهُ - عَزَّ وَجَلَّ - بِقَدْرِ ذَلِكَ أَوْزَارًا ، وَمَا بَقِيَ عِنْدَ مَوْتِهِ كَانَ زَادَهُ إِلَى النَّارِ . وَمَنِ اشْتَرَى خِيَانَةً ، وَهُوَ يَعْلَمُ أَنَّهَا خِيَانَةٌ ، كَانَ كَمَنْ خَانَهَا فِي عَارِهَا وَإِثْمِهَا . وَمَنِ اشْتَرَى سَرِقَةً وَهُوَ يَعْلَمُ أَنَّهَا سَرِقَةٌ ، كَانَ كَمَنْ سَرَقَهَا فِي عَارِهَا وَإِثْمِهَا  ... الْحَدِيثَ .  وَهُوَ  مَوْضُوعٌ  بِهَذَا  الْإِسْنَادِ  ، وَقَدْ رُوِيَ آخِرُهُ  بِإِسْنَادٍ  آخَرَ  .         [7/199]","","Al-Matalib al-Aliyah 1345","","عبد الله بن عباس عن أبو سلمة بن عبد الرحمن عن يزيد بن عمر بن عبد العزيز بن مروان عن أبو عائشة السعدي عن ميسرة بن عبد ربه التراس عن داود بن المحبر البكراوي عن الحارث بن محمد بن أبي أسامة","باب الترهيب من كسب الحرام والترغيب في كسب الحلال"
"1627","[7/200]      1346  / 1  -  وَقَالَ مُحَمَّدُ بْنُ أَبِي عُمَرَ :  حَدَّثَنَا  وَكِيعٌ (  ح  ) .  1346  / 2  - وَقَالَ أَحْمَدُ ابْنُ مَنِيعٍ :  حَدَّثَنَا  قَبِيصَةُ ، قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  مُصْعَبِ بْنِ مُحَمَّدٍ ، وَفِي رِوَايَةٍ  قَبِيصَةُ بْنُ مِينَا  عَنْ  شَيْخٍ مِنَ الْأَنْصَارِ ، وَفِي رِوَايَةٍ  وَكِيعٌ  عَنْ  رَجُلٍ مِنْ أَهْلِ الْمَدِينَةِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنِ اشْتَرَى سَرِقَةً وَهُوَ يَعْلَمُ أَنَّهَا سَرِقَةٌ  ، فَقَدْ شَرَكَ فِي إِثْمِهَا وَعَارِهَا  .         [7/201]","","Al-Matalib al-Aliyah 1346","","شيخ من الأنصار عن مصعب بن محمد بن عبد الرحمن العبدري عن سفيان الثوري عن قبيصة بن عقبة السوائي عن أحمد بن منيع البغوي","باب الترهيب من كسب الحرام والترغيب في كسب الحلال"
"1628","[7/202]      1347  / 1  -  أَبُو يَعْلَى :  حَدَّثَنَا  زُهَيْرٌ ،  ثَنَا  حَسَنٌ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  دَرَّاجٍ ،  عَنْ  أَبِي الْهَيْثَمِ ،  عَنْ  أَبِي سَعِيدٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَيُّمَا رَجُلٍ كَسَبَ مَالًا مِنْ حَلَالٍ  ، فَأَطْعَمَ نَفْسَهُ ، أَوْ كَسَاهَا مَنْ دُونَهُ مِنْ خَلْقِ اللهِ تَعَالَى ، فَإِنَّ لَهُ بِهَا زَكَاةً  .  1347  / 2  -  تَابَعَهُ  عَمْرُو بْنُ الْحَارِثِ  ، عَنْ  دَرَّاجٍ  . أَخْرَجَهُ  ابْنُ حِبَّانَ  مِنْ طَرِيقِهِ  .         [7/203]","","Al-Matalib al-Aliyah 1347","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","باب الترهيب من كسب الحرام والترغيب في كسب الحلال"
"1629","[7/204]      1348  وَقَالَ الطَّيَالِسِيُّ :  حَدَّثَنَا  جَعْفَرٌ ،  عَنِ  النَّضْرِ بْنِ حُمَيْدٍ ،  عَنْ  أَبِي الْجَارُودِ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يُعْجِبَنَّكَ  رَحْبُ  الذِّرَاعَيْنِ  يَسْفِكُ  الدِّمَاءَ  ، فَإِنَّ لَهُ عِنْدَ اللهِ تَعَالَى قَاتِلًا لَا يَمُوتُ ، وَلَا يُعْجِبَنَّكَ امْرُؤٌ كَسَبَ مَالًا مِنْ حَرَامٍ ، فَإِنَّهُ إِنْ أَنْفَقَهُ أَوْ  تَصَدَّقَ  بِهِ لَمْ يُقْبَلْ مِنْهُ ، وَإِنْ تَرَكَهُ لَمْ يُبَارَكْ لَهُ فِيهِ ، وَإِنْ بَقِيَ مِنْهُ شَيْءٌ كَانَ زَادَهُ إِلَى النَّارِ  .         [7/205]","","Al-Matalib al-Aliyah 1348","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن زياد بن المنذر الهمداني عن النضر بن حميد عن جعفر بن سليمان الضبعي عن أبو داود الطيالسي","باب الترهيب من كسب الحرام والترغيب في كسب الحلال"
"1630","[7/206]      1349  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى ،  نَا  الْخَلِيلُ ،  ثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ الْغِنَى عَنْ كَثْرَةِ  الْعَرَضِ  ، وَلَكِنَّ الْغِنَى غِنَى النَّفْسِ  .         [7/207]             [7/208]","","Al-Matalib al-Aliyah 1349","","أنس بن مالك عن قتادة بن دعامة عن عمر بن إبراهيم العبدي عن الخليل بن عمر بن إبراهيم العبدي عن محمد بن يحيى بن أبي سمينة التمار عن أبو يعلى الموصلي","باب الترهيب من كسب الحرام والترغيب في كسب الحلال"
"1631","[7/209]      6 - بَابُ التَّرْغِيبِ فِي اجْتِنَابِ الشُّبُهَاتِ  1350  -  قَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَحْمَدُ بْنُ الْمِقْدَامِ ،  ثَنَا  عُبَيْدُ بْنُ الْقَاسِمِ ،  ثَنَا  الْعَلَاءُ بْنُ ثَعْلَبَةَ ،  عَنْ  أَبِي الْمَلِيحِ الْهُذَلِيِّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ - رَضِيَ اللهُ عَنْهُ - قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمَسْجِدِ الْخَيْفِ  ، فَقَالَ لِي أَصْحَابُهُ : إِلَيْكَ يَا  وَاثِلَةُ  - أَيْ تَنَحَّ عَنْ وَجْهِهِ - فَقَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : دَعُوهُ ، فَإِنَّمَا جَاءَ لِيَسْأَلَ ، فَدَنَوْتُ ، فَقُلْتُ : بِأَبِي أَنْتَ وَأُمِّي يَا رَسُولَ اللهِ ، لِتُفْتِنَا عَنْ أَمْرٍ نَأْخُذُهُ عَنْكَ مِنْ بَعْدِكَ . قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : اسْتَفْتِ نَفْسَكَ ، قُلْتُ : وَكَيْفَ لِي بِذَلِكَ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  دَعْ مَا  يَرِيبُكَ  إِلَى مَا لَا  يَرِيبُكَ  ، وَإِنْ أَفْتَاكَ الْمُفْتُونَ ، قُلْتُ : وَكَيْفَ لِي بِعِلْمِ ذَلِكَ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ضَعْ يَدَكَ عَلَى فُؤَادِكَ ، فَإِنَّ الْقَلْبَ يَسْكُنُ إِلَى الْحَلَالِ ، وَلَا يَسْكُنُ إِلَى الْحَرَامِ ، وَإِنَّ  وَرَعَ  الْمُسْلِمِ أَنْ يَدَعَ الصَّغِيرَ مَخَافَةَ أَنْ يَقَعَ فِي الْكَبِيرِ ، قُلْتُ : فَمَنِ الْحَرِيصُ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : الَّذِي يَطْلُبُ الْكَسْبَةَ فِي غَيْرِ حِلِّهَا ، قُلْتُ : فَمَنِ الْوَرِعُ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : الَّذِي يَقِفُ عِنْدَ الشُّبْهَةِ ، قُلْتُ : فَمَنِ الْمُؤْمِنُ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَنْ أَمِنَهُ النَّاسُ عَلَى أَمْوَالِهِمْ وَدِمَائِهِمْ ، قُلْتُ : فَمَنِ الْمُسْلِمُ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ ، قُلْتُ : فَأَيُّ  الْجِهَادِ  أَفْضَلُ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : كَلِمَةُ حَقٍّ عِنْدَ إِمَامٍ جَائِرٍ  .         [7/210]      الْعَلَاءُ بْنُ ثَعْلَبَةَ  مَجْهُولٌ ،  قَالَهُ  أَبُو حَاتِمٍ  ، لَكِنْ  لِلْمَتْنِ  شَوَاهِدُ  مُفَرَّقَةٌ  .         [7/211]             [7/212]             [7/213]","","Al-Matalib al-Aliyah 1350","","واثلة بن الأسقع الليثي عن أبو المليح بن أسامة الهذلي عن العلاء بن ثعلبة عن عبيد بن القاسم الأسدي عن أحمد بن المقدام العجلي عن أبو يعلى الموصلي","باب الترغيب في اجتناب الشبهات"
"1632","[7/214]      7 - بَابُ الْبَيْعِ إِلَى وَقْتِ خُرُوجِ الْعَطَاءِ لِلْجُنْدِ  1351  -  قَالَ إِسْحَاقُ :  أَخْبَرَنَا  وَهْبُ بْنُ جَرِيرٍ ،  ثَنَا  أَبِي  ،  سَمِعْتُ  مُحَمَّدَ بْنَ إِسْحَاقَ  يُحَدِّثُ  ، يَقُولُ :  حَدَّثَنِي  أَبُو عُبَيْدَةَ بْنُ مُحَمَّدِ بْنِ عَمَّارِ بْنِ يَاسِرٍ ، قَالَ :  حَدَّثَتْنِي  الرُّبَيِّعُ بِنْتُ مُعَوِّذِ بْنِ عَفْرَاءَ ، قَالَتْ :  دَخَلْتُ أَنَا وَنِسْوَةٌ مِنَ  الْأَنْصَارِ  عَلَى  أَسْمَاءَ بِنْتِ مَخْرَبَةَ  وَهِيَ أُمُّ  أَبِي جَهْلٍ  ، وَكَانَ ابْنُهَا  عَبْدُ اللهِ بْنُ أَبِي رَبِيعَةَ  يَبْعَثُ إِلَيْهَا الْعِطْرَ مِنَ  الْيَمَنِ  فَتَبِيعُهُ إِلَى الْأُعْطِيَةِ ، قَالَتْ :  فَاشْتَرَيْتُ مِنْهَا فَوَزَنَتْ لِي فَجَعَلْتُهُ فِي قَوَارِيرَ كَغَيْرِي ، فَقَالَتْ لِي : اكْتُبِي عَلَيْكِ حَقِّي  ، فَقُلْتُ -  يَعْنِي لِلْكَاتِبِ  - : أَكْتُبُهُ عَلَى  الرُّبَيِّعِ بِنْتِ مُعَوِّذِ بْنِ عَفْرَاءَ  ، قَالَتْ : إِنَّكِ كَبِنْتِ قَاتِلِ سَيِّدِهِ ، فَقُلْتُ : وَاللهِ مَا أَنَا بِنْتُ قَاتِلِ سَيِّدِهِ ، وَلَكِنِّي بِنْتُ قَاتِلِ عَبْدِهِ ، فَقَالَتْ : وَاللهِ لَا أَبِيعُكِ شَيْئًا أَبَدًا ، فَقُلْتُ : وَأَنَا وَاللهِ لَا أَشْتَرِي مِنْكِ شَيْئًا أَبَدًا ، فَوَاللهِ مَا هُوَ بِطِيبٍ وَلَا عَرْفٍ ثَمَّ ، ثُمَّ قَالَتْ : وَاللهِ يَا بُنَيَّ مَا شَمَمْتُ طِيبًا قَطُّ أَطْيَبَ مِنْهُ ، وَلَكِنَّهَا حِينَ قَالَتْ مَا قَالَتْ غَضِبَتْ ، فَقُلْتُ مَا قُلْتُ  .         [7/215]","","Al-Matalib al-Aliyah 1351","","الربيع بنت معوذ النجارية عن أبو عبيدة بن محمد بن عمار العنسي عن محمد بن إسحاق عن جرير بن حازم عن وهب بن جرير بن حازم عن إسحاق ابن راهويه","باب البيع إلى وقت خروج العطاء للجند"
"1633","[7/216]      8 - بَابُ التِّجَارَةِ فِي الْبَزِّ  1352  -  قَالَ أَبُو يَعْلَى :  ثَنَا  إِبْرَاهِيمُ بْنُ عَرْعَرَةَ السَّامِيُّ  بِالْبَصْرَةِ  ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ الرَّازِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ نُوحٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  أَبِي بَكْرٍ الصِّدِّيقِ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ أَهْلَ الْجَنَّةِ لَا يَتَبَايَعُونَ  ، فَلَوْ تَبَايَعُوا مَا تَبَايَعُوا إِلَّا الْبَزَّ  .         [7/217]","","Al-Matalib al-Aliyah 1352","","أبو  بكر الصديق عن جده عن أبو إسماعيل بن نوح القرشي عن إسماعيل بن نوح القرشي عن إبراهيم بن عبد الله الرازي عن إبراهيم بن محمد بن عرعرة عن أبو يعلى الموصلي","باب التجارة في البز"
"1634","[7/218]      9 - بَابُ الْبَرَكَةِ فِي الْبُكُورِ  1353  -  أَبُو يَعْلَى :  حَدَّثَنَا  عَمَّارٌ أَبُو يَاسِرٍ ،  ثَنَا  هِشَامُ بْنُ زِيَادٍ ،  ثَنَا  أَبِي  ،  عَنْ  يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  اللَّهُمَّ بَارِكْ لِأُمَّتِي فِي بُكُورِهَا  .         [7/219]","","Al-Matalib al-Aliyah 1353","","عبد الله بن سلام بن الحارث الإسرائيلي عن يوسف بن عبد الله بن سلام الإسرائيلي عن زياد القرشي مولى عثمان بن عفان عن هشام بن زياد بن أبي يزيد العثماني عن عمار بن هارون المستملي عن أبو يعلى الموصلي","باب البركة في البكور"
"1635","[7/220]      1354  -  وَحَدَّثَنَا  عَمَّارٌ أَبُو يَاسِرٍ ،  ثَنَا  عَدِيُّ بْنُ الْفَضْلِ وَمُحَمَّدُ بْنُ عَنْبَسَةَ ، قَالَا :  ثَنَا  عُبَيْدُ اللهِ بْنُ أَبِي بَكْرٍ ،  عَنْ  أَنَسٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  اللَّهُمَّ بَارِكْ لِأُمَّتِي فِي بُكُورِهَا  .         [7/221]","","Al-Matalib al-Aliyah 1354","","أنس بن مالك عن عبيد الله بن أبي بكر بن أنس بن مالك عن محمد بن عنبسة البصري عن عمار بن هارون المستملي عن أبو يعلى الموصلي","باب البركة في البكور"
"1636","[7/222]      1355  -  وَحَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى ،  ثَنَا  ابْنُ وَهْبٍ ،  عَنْ  أُسَامَةَ ،  عَنْ  عُبَيْدِ بْنِ نِسْطَاسٍ مَوْلَى كَثِيرِ بْنِ الصَّلْتِ ،  حَدَّثَهُ عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  وَلَيْسَ الْغِنَى عَنْ كَثْرَةِ  الْعَرَضِ  ، وَلَكِنَّ الْغِنَى غِنَى النَّفْسِ ، وَإِنَّ اللهَ تَعَالَى يُؤْتِي عَبْدَهُ مَا كَتَبَ لَهُ مِنَ الرِّزْقِ ، فَأَجْمِلُوا فِي الطَّلَبِ ، خُذُوا مَا حَلَّ ، وَدَعُوا مَا حَرُمَ  .         [7/223]","","Al-Matalib al-Aliyah 1355","","أبو هريرة الدوسي عن سعيد المقبري عن عبيد بن نسطاس المدني عن أسامة بن زيد الليثي المدني عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","باب البركة في البكور"
"1637","[7/224]      1356  -  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ وَاقِدٍ ،  ثَنَا  وَهْبُ بْنُ وَهْبٍ ،  ثَنَا  عَبَّادُ بْنُ كَثِيرٍ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنِ  الْأَعْرَجِ ،  عَنْ  أَبِي هُرَيْرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ تَعَالَى يُنْزِلُ الرِّزْقَ عَلَى قَدْرِ الْمُؤْنَةِ  ، وَيُنْزِلُ الصَّبْرَ عَلَى قَدْرِ الْبَلَاءِ  .  تَابَعَهُ  عَبْدُ الْعَزِيزِ  عَنْ  طَارِقٍ  عِنْدَ  الْبَزَّارِ  .         [7/225]","","Al-Matalib al-Aliyah 1356","","أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن أبو الزناد عن عباد بن كثير الكاهلي عن وهب بن وهب الزمعي عن عبد الرحيم بن واقد الخراساني عن الحارث بن محمد بن أبي أسامة","باب البركة في البكور"
"1638","[7/226]      10 - بَابُ الْمُزَارَعَةِ  1357  -  إِسْحَاقُ :  أَخْبَرَنَا  يَحْيَى بْنُ سَعِيدٍ الْقَطَّانُ ،  ثَنَا  أَبُو سَلَمَةَ ، قَالَ :  سَأَلْتُ  أَبَا جَعْفَرٍ - يَعْنِي مُحَمَّدَ بْنَ عَلِيِّ بْنِ الْحُسَيْنِ - رَضِيَ اللهُ عَنْهُمَا - مَا  الْمُخَابَرَةُ  ؟  قَالَ : الْمُقَاسَمَةُ  .","","Al-Matalib al-Aliyah 1357","","أبو جعفر الباقر عن الربيع بن حبيب اليمامى عن يحيى القطان عن إسحاق ابن راهويه","باب المزارعة"
"1639","[7/227]      1358  -  أَخْبَرَنَا  جَرِيرٌ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنْ  رِفَاعَةَ بْنِ رَافِعِ بْنِ خَدِيجٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَا :  إِنَّ  رَجُلًا  كَانَتْ لَهُ أَرْضٌ ، فَقَالَ لَهُ  رَجُلٌ  : هَلْ لَكَ أَنْ أُزَارِعَكَ ، فَمَا أَخْرَجَ اللهُ مِنْ شَيْءٍ كَانَ بَيْنِي وَبَيْنَكَ ؟ قَالَ : نَعَمْ ، حَتَّى أَسْأَلَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَتَى  أَبَا بَكْرٍ  وَعُمَرَ  - رَضِيَ اللهُ عَنْهُمَا - فَقَالَا : سَلِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَأَلَهُ فَلَمْ يَرْجِعْ إِلَيْهِ شَيْئًا ، فَقَالَ لَهُمَا : إِنَّهُ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمْ يَرْجِعْ إِلَيَّ شَيْئًا ! فَقَالَا لَهُ : انْطَلِقْ ، فَإِنَّهُ لَوْ كَانَ حَرَامًا نَهَاكَ عَنْهُ . فَزَارَعَهُ حَتَّى إِذَا اهْتَزَّ زَرْعُهُ أَوِ اخْضَرَّ ، وَكَانَ عَلَى طَرِيقِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَمَرَّ بِهِ يَوْمًا ، فَقَالَ : لِمَنْ هَذِهِ الْأَرْضُ ؟ فَقَالُوا :  لِفُلَانٍ  ، زَارَعَ بِهَا  فُلَانًا  . فَقَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ادْعُهُمَا ! . فَجَاءَا جَمِيعًا ، فَقَالَ لِصَاحِبِ الْأَرْضِ :  رُدَّ إِلَى هَذَا مَا أَنْفَقَ فِي أَرْضِكَ ، وَلَكَ مَا أَخْرَجَتْ أَرْضُكَ  ! .  لَمْ يُخْرِجُوهُ بِهَذَا السِّيَاقِ  .","","Al-Matalib al-Aliyah 1358","","رفاعة بن رافع بن خديج عن عبد العزيز بن رفيع الطائفي عن جرير بن عبد الحميد عن إسحاق ابن راهويه","باب المزارعة"
"1640","[7/228]      1359  -  وَقَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ الْقَطَّانُ ،  عَنْ  أَبِي جَعْفَرٍ الْخَطْمِيِّ ، قَالَ :  بَعَثَنِي عَمِّي مَعَ غُلَامٍ لَهُ إِلَى سَعِيدِ بْنِ الْمُسَيِّبِ ، فَقَالَ : مَا تَقُولُ فِي الْمُزَارَعَةِ ؟ فَقَالَ : كَانَ  ابْنُ عُمَرَ  - رَضِيَ اللهُ عَنْهُمَا - لَا يَرَى بِهَا بَأْسًا ، حَتَّى حَدَّثَ عَنْ رَافِعِ بْنِ خَدِيجٍ - رَضِيَ اللهُ عَنْهُ - فِيهَا حَدِيثًا :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَتَى  بَنِي حَارِثَةَ  ، فَرَأَى زَرْعًا فِي أَرْضِ  ظُهَيْرٍ  ، فَقَالَ : مَا أَحْسَنَ أَرْضَ  ظُهَيْرٍ  ؟  فَقَالُوا : إِنَّهُ لَيْسَ  لِظُهَيْرٍ  . قَالَ : أَلَيْسَتْ أَرْضَ  ظُهَيْرٍ  ؟ قَالُوا : بَلَى ، وَلَكِنَّهُ زَارَعَ  فُلَانًا  ، فَقَالَ : رُدُّوا عَلَيْهِ نَفَقَتَهُ ، وَخُذُوا زَرْعَكُمْ .  قَالَ  رَافِعٌ  - رَضِيَ اللهُ عَنْهُ - : فَأَخَذْنَا زَرْعَنَا ، وَرَدَدْنَا عَلَيْهِ نَفَقَتَهُ  .         [7/229]","","Al-Matalib al-Aliyah 1359","","رافع بن خديج الأنصاري عن سعيد بن المسيب عن عمير بن يزيد بن عمير الخطمي عن يحيى القطان عن أبو بكر ابن أبي شيبة","باب المزارعة"
"1641","[7/230]      1360  -  وَقَالَ إِسْحَاقُ :  أَخْبَرَنَا  جَرِيرٌ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنْ  رِفَاعَةَ بْنِ رَافِعِ بْنِ خَدِيجٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ كِرَاءِ الزَّرْعِ وَالْإِجَارَةِ  ، إِلَّا أَنْ يَشْتَرِيَ الرَّجُلُ أَرْضًا أَوْ تُعَارَ . قَالَ : فَأَعَارَ أَبِي أَرْضًا فَزَرَعَهَا ، وَبَنَى فِيهَا بَيْتًا ، فَرَكِبَ أَبِي يَوْمًا فَرَأَى الْبُنْيَانَ ، فَقَالَ : مَا هَذَا ؟ قَالَ : بَنَى الَّذِي أَعَرْتَهُ أَرْضَكَ ، فَقَالَ : أَعِوَضًا مِمَّا أَعَرْتُهُ ؟ فَأَمَرَ بِالْبُنْيَانِ فَهُدِمَ  .  هَذَا  إِسْنَادٌ  صَحِيحٌ بَعْضُهُ  مُرْسَلٌ  ، وَبَعْضُهُ  مَوْقُوفٌ  .","","Al-Matalib al-Aliyah 1360","","رفاعة بن رافع بن خديج عن عبد العزيز بن رفيع الطائفي عن جرير بن عبد الحميد عن إسحاق ابن راهويه","باب المزارعة"
"1642","[7/231]      1361  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنِي  هِشَامُ بْنُ عَبْدِ اللهِ بْنِ عِكْرِمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ - رَضِيَ اللهُ عَنْهَا - قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اطْلُبُوا الرِّزْقَ فِي خَبَايَا الْأَرْضِ  .  تَفَرَّدَ بِهِ  هِشَامٌ  ، عَنْ  هِشَامٍ  .         [7/232]","","Al-Matalib al-Aliyah 1361","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن هشام بن عبد الله بن عكرمة بن خالد عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","باب المزارعة"
"1643","[7/233]      1362  -  مُسَدَّدٌ :  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي مُحَمَّدٍ ، قَالَ :  إِنَّ رَجُلًا أَخَذَ مِنِ ابْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - أَرْضًا ، فَاشْتَرَطَ أَنْ لَا يَجْعَلَ فِيهَا  عَذِرَةً  ، فَقَالَ : إِنَّهُ لَا يُصْلِحُهَا إِلَّا ذَاكَ .  قَالَ  : إِنْ كَانَ لَا يُصْلِحُهَا إِلَّا ذَاكَ فَدَعْهَا  .","","Al-Matalib al-Aliyah 1362","","عبد الله بن عمر بن الخطاب عن ثابت البناني عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد","باب المزارعة"
"1644","[7/234]      11 - بَابُ السِّمْسَارِ وَأَنْ لَا يَبِيعَ حَاضِرٌ  لِبَادٍ  1363  -  أَبُو يَعْلَى :  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  ثَنَا  سَالِمٌ أَبُو النَّضْرِ ،  عَنْ  شَيْخٍ مِنْ بَنِي تَمِيمٍ ، قَالَ :  جَلَسَ إِلَيَّ وَأَنَا فِي  مَسْجِدِ الْبَصْرَةِ  فِي زَمَنِ  الْحَجَّاجِ بْنِ يُوسُفَ  ، وَفِي يَدِهِ عَصًا وَصَحِيفَةٌ يَحْمِلُهَا فِي يَدِهِ ، فَذَكَرَ حَدِيثًا فِيهِ : دَخَلْتُ  الْمَدِينَةَ  مَعَ أَبِي وَأَنَا غُلَامٌ شَابٌّ ، فِي إِبِلٍ جَلَبْنَاهَا إِلَى  الْمَدِينَةِ  لِنَبِيعَهَا ، قَالَ : وَكَانَ طَلْحَةُ بْنُ عُبَيْدِ اللهِ - رَضِيَ اللهُ عَنْهُ - صَدِيقًا لِأَبِي ، فَنَزَلْنَا عَلَيْهِ ، فَقَالَ أَبِي : يَا  أَبَا مُحَمَّدٍ  ، اخْرُجْ مَعَنَا ، فَبِعْ لَنَا  ظَهْرَنَا  ، فَإِنَّهُ لَا عِلْمَ لَنَا بِهَذِهِ السُّوقِ قَالَ : أَمَّا أَنْ أَبِيعَ لَكَ فَلَا ، إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ يَبِيعَ  حَاضِرٌ  لِبَادٍ  ، وَلَكِنْ أَخْرُجُ مَعَكُمَا إِلَى السُّوقِ ، فَإِنْ رَضِيتُ لَكُمَا رَجُلًا مِمَّنْ  يُبَايِعُكُمَا  أَمَرْتُكُمَا بِبَيْعِهِ . قَالَ : فَخَرَجَ مَعَنَا ، فَجَلَسَ فِي نَاحِيَةِ السُّوقِ ، وَسَاوَمَنَا الرِّجَالُ بِظَهْرِنَا ، حَتَّى إِذَا أَعْطَانَا رَجُلٌ مَا يُرْضِينَا أَتَيْنَاهُ ، فَاسْتَأْمَرْنَاهُ فِي بَيْعِهِ ، قَالَ : فَبَايِعُوهُ ، فَقَدْ رَضِيتُ لَكُمَا وَفَاءَهُ وَصَلَاتَهُ ، قَالَ : فَبَايَعْنَاهُ ، وَأَخَذْنَا الَّذِي لَنَا  .         [7/235]","","Al-Matalib al-Aliyah 1363","","طلحة بن عبيد الله بن عثمان الفياض عن شيخ من بني تميم عن سالم بن أبي أمية التيمي عن محمد بن إسحاق عن يزيد بن زريع العيشي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","باب السمسار وأن لا يبيع حاضر لباد"
"1645","[7/236]      12 - بَابُ الرِّبَا  1364  -  قَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  أَسْبَاطُ بْنُ مُحَمَّدٍ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  رَجُلٍ مِنْ أَهْلِ الْبَصْرَةِ ،  عَنِ  الْحَسَنِ ،  عَنْ  عُبَادَةَ بْنِ الصَّامِتِ - رَضِيَ اللهُ عَنْهُ - قَالَ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي مَجْلِسٍ مِنَ  الْأَنْصَارِ  لَيْلَةَ الْخَمِيسِ فِي رَمَضَانَ ، وَلَمْ يَصُمْ رَمَضَانَ بَعْدَهُ ، يَقُولُ :  الشَّعِيرُ بِالشَّعِيرِ ،  قَفِيزًا  بِقَفِيزٍ  ، يَدًا بِيَدٍ ، وَمَا زَادَ فَهُوَ رِبًا  . الْحَدِيثَ  .  أَصْلُهُ فِي صَحِيحِ  مُسْلِمٍ  بِغَيْرِ هَذَا السِّيَاقِ ، وَبِدُونِ هَذِهِ الزِّيَادَةِ  .         [7/237]","","Al-Matalib al-Aliyah 1364","","عبادة بن الصامت عن الحسن البصري عن رجل من أهل البصرة عن سليمان بن فيروز الشيباني عن أسباط بن محمد بن ميسرة القرشي عن أحمد بن منيع البغوي","باب الربا"
"1646","[7/238]      1365  -  أَبُو يَعْلَى :  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  ثَنَا  سُكَيْنٌ - هُوَ ابْنُ عَبْدِ الْعَزِيزِ -  عَنْ  عَبْدِ الْمُؤْمِنِ ،  عَنِ  ابْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الذَّهَبُ بِالذَّهَبِ  ، وَالْفِضَّةُ بِالْفِضَّةِ ، وَالْبُرُّ بِالْبُرِّ ، وَالشَّعِيرُ بِالشَّعِيرِ ، وَالْمِلْحُ بِالْمِلْحِ ، وَالتَّمْرُ بِالتَّمْرِ ، مِثْلًا بِمِثْلٍ ، كَيْلًا بِكَيْلٍ . مَنْ زَادَ أَوِ اسْتَزَادَ فَقَدْ  أَرْبَى  .","","Al-Matalib al-Aliyah 1365","","عبد الله بن عمر بن الخطاب عن عبد المؤمن بن أبي شراعة العبدي عن سكين بن عبد العزيز بن قيس المجاشعي عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","باب الربا"
"1647","[7/239]      1366  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  الْأَشْعَثُ ،  عَنْ  أَبِي الزُّبَيْرِ الْمَكِّيِّ ، قَالَ :  سَأَلْتُ  جَابِرَ بْنَ عَبْدِ اللهِ - رَضِيَ اللهُ عَنْهُمَا - عَنِ الْحِنْطَةِ بِالتَّمْرِ بِفَضْلٍ ، يَدًا بِيَدٍ ؟ فَقَالَ :  قَدْ كُنَّا عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَشْتَرِي الصَّاعَ الْحِنْطَةَ بِسِتَّةِ آصُعٍ مِنْ تَمْرٍ  ، يَدًا بِيَدٍ ، فَإِنْ كَانَ نَوْعًا وَاحِدًا فَلَا خَيْرَ فِيهِ ، إِلَّا مِثْلًا بِمِثْلٍ  .","","Al-Matalib al-Aliyah 1366","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن أشعث بن سوار عن عبد الرحيم بن سليمان الأشل عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","باب الربا"
"1648","[7/240]      1367  -  مُسَدَّدٌ :  حَدَّثَنَا  حَفْصٌ - هُوَ ابْنُ غِيَاثٍ -  عَنْ  أَبِي الْعَوَّامِ الْبَصْرِيِّ ،  عَنْ  عَطَاءٍ ، قَالَ :  كَانَ ابْنُ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - يَبِيعُ مِنْ غِلْمَانِهِ النَّخْلَ  ، السَّنَةَ وَالسَّنَتَيْنِ وَالثَّلَاثَ ، فَقَالَ لَهُ  جَابِرٌ  - رَضِيَ اللهُ عَنْهُ - فِي ذَلِكَ ،  فَقَالَ  : مَا عَلِمْتَ أَنْ لَيْسَ بَيْنَ الْعَبْدِ وَبَيْنَ سَيِّدِهِ رِبًا  .         [7/241]","","Al-Matalib al-Aliyah 1367","","عبد الله بن عباس عن عطاء بن أبي رباح عن جعفر بن ميمون الأنماطي عن حفص بن غياث النخعي عن مسدد بن مسرهد","باب الربا"
"1649","[7/242]      1368  -  وَحَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  أَبِي مَعْبَدٍ ، قَالَ :  إِنَّ  ابْنَ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - كَانَ يَبِيعُ مِنْ غِلْمَانِهِ  الثَّمَرَةَ  مِنْ قَبْلِ أَنْ تُطْعَمَ  ، وَكَانَ لَا يَرَى بَيْنَهُ وَبَيْنَ عَبْدِهِ رِبًا  .","","Al-Matalib al-Aliyah 1368","","عبد الله بن عباس عن نافذ المكي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن مسدد بن مسرهد","باب الربا"
"1650","[7/243]      1369  / 1  -  إِسْحَاقُ :  أَخْبَرَنَا  يَعْلَى بْنُ عُبَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ السَّائِبِ ،  أَنَّهُ حَدَّثَهُمْ  ،  عَنْ  سَلَمَةَ بْنِ السَّائِبِ ،  عَنْ  أَبِي رَافِعٍ مَوْلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  احْتَجْنَا ، فَأَخَذْتُ خَلْخَالَيِ امْرَأَتِي فِي السَّنَةِ الَّتِي اسْتُخْلِفَ فِيهَا أَبُو بَكْرٍ - رَضِيَ اللهُ عَنْهُ - فَلَقِيَنِي  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - فَقَالَ : مَا هَذَا ؟ فَقُلْتُ : احْتَاجَ الْحَيُّ إِلَى نَفَقَةٍ ، فَقَالَ : إِنَّ مَعِي وَرِقًا أُرِيدُ بِهَا فِضَّةً . فَدَعَا بِالْمِيزَانِ فَوَضَعَ الْخَلْخَالَيْنِ فِي كِفَّةٍ ، وَوَضَعَ الْوَرِقَ فِي كِفَّةٍ ،  فَشَفَّ  الْخَلْخَالَانِ نَحْوًا مِنْ  دَانَقٍ  ، فَقَرَضَهُ ، فَقُلْتُ : يَا  خَلِيفَةَ  رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - هُوَ لَكَ حَلَالٌ ! : فَقَالَ : يَا  أَبَا رَافِعٍ  ، إِنَّكَ إِنْ أَحْلَلْتَهُ فَإِنَّ اللهَ تَعَالَى لَا يُحِلُّهُ  ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الذَّهَبُ بِالذَّهَبِ وَزْنًا بِوَزْنٍ  ، وَالْفِضَّةُ بِالْفِضَّةِ وَزْنًا بِوَزْنٍ ، الزَّائِدُ وَالْمَزِيدُ فِي النَّارِ  .","","Al-Matalib al-Aliyah 1369","","أبو  بكر الصديق عن أبو رافع القبطي عن سلمة بن السائب الكلبي عن محمد بن السائب الكلبي عن يعلى بن عبيد الطنافسي عن إسحاق ابن راهويه","باب الربا"
"1651","1369  / 2  -  وَأَخْبَرَنَا  النَّضْرُ بْنُ مُحَمَّدٍ ،  عَنْ  مُحَمَّدِ بْنِ السَّائِبِ ،  عَنِ  ابْنِ السَّائِبِ  ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  أَبِي رَافِعٍ - رَضِيَ اللهُ عَنْهُ - بِهَذَا الْحَدِيثِ نَحْوَهُ .","","Al-Matalib al-Aliyah 1369","","أبو  بكر الصديق عن أبو رافع القبطي عن أسامة بن زيد بن حارثة ذو البطين عن سلمة بن السائب الكلبي عن محمد بن السائب الكلبي عن النضر بن محمد القرشي عن إسحاق ابن راهويه","باب الربا"
"1652","1369  / 3  - وَقَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  يَعْلَى بْنُ عُبَيْدٍ ، فَذَكَرَهُ .","","Al-Matalib al-Aliyah 1369","","أبو  بكر الصديق عن أبو رافع القبطي عن سلمة بن السائب الكلبي عن محمد بن السائب الكلبي عن يعلى بن عبيد الطنافسي عن أبو بكر ابن أبي شيبة","باب الربا"
"1653","1369  / 4  - وَقَالَ الْحَارِثُ :  حَدَّثَنَا  عَبْدُ الْوَهَّابِ بْنُ عَطَاءٍ ،  ثَنَا  مُحَمَّدُ بْنُ السَّائِبِ الْكَلْبِيُّ ، فَذَكَرَهُ .","","Al-Matalib al-Aliyah 1369","","أبو  بكر الصديق عن أبو رافع القبطي عن سلمة بن السائب الكلبي عن محمد بن السائب الكلبي عن عبد الوهاب بن عطاء الخفاف عن الحارث بن محمد بن أبي أسامة","باب الربا"
"1654","1369  / 5  - وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  الْكَلْبِيُّ ، بِهِ .         [7/244]             [7/245]","","Al-Matalib al-Aliyah 1369","","أبو  بكر الصديق عن أبو رافع القبطي عن سلمة بن السائب الكلبي عن محمد بن السائب الكلبي عن يزيد بن هارون عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","باب الربا"
"1655","[7/246]      1370  -  وَقَالَ إِسْحَاقُ :  أَخْبَرَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  عَنْ  مُوسَى بْنِ عُلَيِّ بْنِ رَبَاحٍ اللَّخْمِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي قَيْسٍ ، قَالَ : إِنَّ أَبَا بَكْرٍ الصِّدِّيقَ - رَضِيَ اللهُ عَنْهُ -  كَتَبَ  إِلَى أُمَرَاءِ  الْأَجْنَادِ  بِالشَّامِ  :  إِنَّكُمْ هَبَطْتُمْ أَرْضَ الرِّبَا ، فَلَا تَبْتَاعُوا الذَّهَبَ بِالذَّهَبِ إِلَّا وَزْنًا بِوَزْنٍ  ، وَلَا الْوَرِقَ بِالْوَرِقِ إِلَّا وَزْنًا بِوَزْنٍ ، وَلَا الطَّعَامَ بِالطَّعَامِ إِلَّا مِكْيَالًا بِمِكْيَالٍ  .  قُلْتُ :  مُحَمَّدُ بْنُ السَّائِبِ هُوَ ابْنُ الْكَلْبِيِّ  ،  مَتْرُوكٌ  بِمَرَّةٍ . وَكَانَ  إِسْحَاقُ  أَخْرَجَ حَدِيثَهُ ; لِأَنَّ لَهُ أَصْلًا ، وَاسْتَشْهَدَ لَهُ  بِالْمَوْقُوفِ  الَّذِي بَعْدَهُ ، وَقَالَ :  إِسْنَادُهُ  لَا بَأْسَ بِهِ ،  وَأَبُو الْقَيْسِ  أَظُنُّهُ مَوْلَى  عَمْرِو بْنِ الْعَاصِ  - رَضِيَ اللهُ عَنْهُ - وَقَدْ سَمِعَ مِنْهُ  عُلَيُّ بْنُ رَبَاحٍ  ، وَمَا أَدْرِي هَلْ سَمِعَ  أَبَا بَكْرٍ  ، أَمْ قَرَأَ ذَلِكَ فِي كِتَابِهِ ؟  .","","Al-Matalib al-Aliyah 1370","","أبو  بكر الصديق عن عبد الرحمن بن ثابت السهمي عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن أبو عامر العقدي عن إسحاق ابن راهويه","باب الربا"
"1656","[7/247]      1371  -  إِسْحَاقُ :  أَخْبَرَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  ثَنَا  زَيْدُ بْنُ مُرَّةَ أَبُو الْمُعَلَّى ،  ثَنَا  أَبُو سَعِيدٍ الرَّقَاشِيُّ ، قَالَ :  إِنَّ عِكْرِمَةَ مَوْلَى ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَدِمَ  الْبَصْرَةَ  فَجَلَسْنَا إِلَيْهِ فِي الْمَسْجِدِ الْجَامِعِ ،  فَقَالَ  : أَلَا تَنْهَوْنَ شَيْخَكُمْ هَذَا - يَعْنِي  الْحَسَنَ بْنَ أَبِي الْحَسَنِ  - يَزْعُمُ أَنَّ مَا يُبَايِعُ النَّاسُ يَدًا بِيَدٍ الْفِضَّةَ بِالْفِضَّةِ ، وَالذَّهَبَ بِالذَّهَبِ حَرَامٌ ، وَأَنَا أَشْهَدُ أَنَّ ابْنَ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - أَحَلَّهُ . قَالَ  أَبُو سَعِيدٍ  : فَقُلْتُ لَهُ : وَيْحَكَ ! مَا تَعْلَمُ أَنِّي جَالِسٌ عِنْدَ رَأْسِهِ وَأَنْتَ عِنْدَ رِجْلَيْهِ ، فَجَاءَ رَجُلٌ فَقَامَ عَلَيْكَ ، فَقُلْتُ : مَا حَاجَتُكُمْ ؟ فَقَالَ : أَرَدْتُ أَنْ أَسْأَلَ  ابْنَ عَبَّاسٍ  - رَضِيَ اللهُ عَنْهُمَا - عَنِ الذَّهَبِ بِالذَّهَبِ ، فَقُلْتُ : اذْهَبْ ، فَإِنَّهُ يَزْعُمُ أَنْ لَا بَأْسَ بِهِ ، فَكَشَفَ عِمَامَتَهُ عَنْ وَجْهِهِ ، ثُمَّ جَلَسَ  ابْنُ عَبَّاسٍ  - رَضِيَ اللهُ عَنْهُمَا -  فَقَالَ  :  أَسْتَغْفِرُ اللهَ ، وَاللهِ مَا كُنْتُ أَرَى إِلَّا أَنَّ مَا تَبَايَعَ الْمُسْلِمُونَ مِنْ شَيْءٍ يَدًا بِيَدٍ إِلَّا حَلَالٌ  ، سَمِعْتُ عَبْدَ اللهِ بْنَ عُمَرَ وَعُمَرَ بْنَ الْخَطَّابِ - رَضِيَ اللهُ عَنْهُمَا - حَفِظَا مِنْ ذَلِكَ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَا لَمْ أَحْفَظْ ، وَأَسْتَغْفِرُ اللهَ  .         [7/248]","","Al-Matalib al-Aliyah 1371","","عمر بن الخطاب عن عبد الله بن عباس عن عكرمة مولى ابن عباس عن بيان بن جندب الرقاشي عن زيد بن أبي ليلى العدوي عن عبد الصمد بن عبد الوارث التنوري عن إسحاق ابن راهويه","باب الربا"
"1657","[7/249]      1372  -  أَخْبَرَنَا  جَرِيرٌ ،  حَدَّثَنِي  سَالِمُ بْنُ أَبِي حَفْصَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي مُلَيْكَةَ ، قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَبْلَ مَوْتِهِ بِثَلَاثٍ ، يَقُولُ :  أَسْتَغْفِرُ اللهَ وَأَتُوبُ إِلَيْهِ مِنَ الصَّرْفِ  .","","Al-Matalib al-Aliyah 1372","","عبد الله بن عباس عن ابن أبي مليكة عن سالم بن أبي حفصة العجلي عن جرير بن عبد الحميد عن إسحاق ابن راهويه","باب الربا"
"1658","[7/250]      1373  -  أَخْبَرَنَا  مُحَمَّدُ بْنُ بَكْرٍ ،  أَنَا  إِسْمَاعِيلُ بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي الصُّفَيْرِ ،  حَدَّثَنِي  عَطَاءٌ ، قَالَ :  جَاءَ بِضْعَةَ عَشَرَ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى  ابْنِ عَبَّاسٍ  - رَضِيَ اللهُ عَنْهُمَا - فَقَالُوا : نَحْنُ أَقْدَمُ سِنًّا مِنْكَ ، وَأَعْلَمُ بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْكَ ،  أَرَأَيْتَ حِينَ تُحِلُّ الصَّرْفَ ؟ وَقَدْ سَمِعْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْهَى عَنْهُ  . فَذَكَرَ الْحَدِيثَ عَنْ  أُسَامَةَ  - رَضِيَ اللهُ عَنْهُ -  .  وَهُوَ فِي الصَّحِيحِ ، وَلَمْ يُخْرِجُوا هَذَا السِّيَاقَ عَنْ هَذِهِ الْعِدَّةِ مِنَ  الصَّحَابَةِ  - رَضِيَ اللهُ عَنْهُمْ -  وَإِسْمَاعِيلُ  فِيهِ كَلَامٌ  .         [7/251]             [7/252]             [7/253]","","Al-Matalib al-Aliyah 1373","","أحد الصحابة عن عطاء بن أبي رباح عن إسماعيل بن عبد الملك بن أبي الصفير الأسدي عن محمد بن بكر بن عثمان البرساني عن إسحاق ابن راهويه","باب الربا"
"1659","[7/254]      1374  -  أَخْبَرَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ ،  أَخْبَرَنَا  ابْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ، قَالَ :  سَأَلْتُ سَعِيدَ بْنَ الْمُسَيِّبِ ، عَنْ شَاةٍ بِشَاتَيْنِ إِلَى الْحَيَاةِ  ، فَقَالَ : سَأَلَ رَجُلٌ  عُمَرَ بْنَ الْخَطَّابِ  - رَضِيَ اللهُ عَنْهُ -  فَقَالَ  عُمَرُ - رَضِيَ اللهُ عَنْهُ - : إِنَّ آخِرَ مَا أَنْزَلَ اللهُ تَعَالَى آيَةُ الرِّبَا ، وَإِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قُبِضَ قَبْلَ أَنْ يُفَسِّرَهَا ، فَدَعُوا الرِّبَا وَالرِّيبَةَ  !  .  قُلْتُ :  رَوَاهُ  ابْنُ مَاجَهْ  سِوَى السُّؤَالِ  .         [7/255]","","Al-Matalib al-Aliyah 1374","","عمر بن الخطاب عن سعيد بن المسيب عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن بكر بن عثمان البرساني عن إسحاق ابن راهويه","باب الربا"
"1660","[7/256]      1375  / 1  -  وَقَالَ إِسْحَاقُ أَيْضًا :  أَخْبَرَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي وَجْزَةَ السَّعْدِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  بِلَالٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  كَانَ عِنْدِي تَمْرٌ دُونٌ ، فَابْتَعْتُ بِهِ مِنَ السُّوقِ تَمْرًا أَجْوَدَ مِنْهُ بِنِصْفِ كَيْلِهِ . فَقَدِمْتُ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَحَدَّثْتُهُ بِمَا صَنَعْتُ ، فَقَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : انْطَلِقْ فَخُذْ تَمْرَكَ وَارْدُدْ هَذَا ! فَفَعَلْتُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  التَّمْرُ بِالتَّمْرِ مِثْلًا بِمِثْلٍ  ، وَالْحِنْطَةُ بِالْحِنْطَةِ مِثْلًا بِمِثْلٍ ، وَالشَّعِيرُ بِالشَّعِيرِ مِثْلًا بِمِثْلٍ ، وَالْمِلْحُ بِالْمِلْحِ مِثْلًا بِمِثْلٍ ، وَالذَّهَبُ بِالذَّهَبِ وَزْنًا بِوَزْنٍ ، وَالْفِضَّةُ بِالْفِضَّةِ وَزْنًا بِوَزْنٍ ، فَمَا كَانَ مِنْ فَضْلٍ فَهُوَ رِبًا !  .  وَلَهُ  شَاهِدٌ  فِي الصَّحِيحِ مِنْ حَدِيثِ  عُبَادَةَ بْنِ الصَّامِتِ  - رَضِيَ اللهُ عَنْهُ - وَهَذَا  الْإِسْنَادُ  حَسَنٌ ، إِلَّا أَنَّ  سَعِيدَ بْنَ الْمُسَيِّبِ  لَمْ يَسْمَعْ مِنْ  بِلَالٍ  - رَضِيَ اللهُ عَنْهُ -  .","","Al-Matalib al-Aliyah 1375","","بلال بن رباح سابق الحبشة عن سعيد بن المسيب عن يزيد بن عبيد السعدي عن منصور بن المعتمر عن جرير بن عبد الحميد عن إسحاق ابن راهويه","باب الربا"
"1661","1375  / 2  - وَرَوَاهُ أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  ثَنَا  جَرِيرٌ ، بِهِ .         [7/257]","","Al-Matalib al-Aliyah 1375","","بلال بن رباح سابق الحبشة عن سعيد بن المسيب عن يزيد بن عبيد السعدي عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","باب الربا"
"1662","[7/258]      1376  -  حَدَّثَنَا  زُهَيْرٌ ،  ثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  بِلَالٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  كَانَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدِي تَمْرٌ ، فَوَجَدْتُ أَطْيَبَ مِنْهُ صَاعَيْنِ بِصَاعٍ فَاشْتَرَيْتُهُ  ، فَأَتَيْتُ بِهِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : مِنْ أَيْنَ لَكَ هَذَا يَا  بِلَالُ  ؟ قُلْتُ : اشْتَرَيْتُهُ صَاعًا بِصَاعَيْنِ . قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  رُدَّهُ - أَوِ ارْدُدْ  - عَلَيْنَا تَمْرَنَا  !  .","","Al-Matalib al-Aliyah 1376","","بلال بن رباح سابق الحبشة عن مسروق بن الأجدع عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عثمان بن عمر بن فارس عن زهير بن حرب عن أبو يعلى الموصلي","باب الربا"
"1663","[7/259]      1377  -  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  حَدَّثَنِي  حَمَّادٌ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  شُرَيْحٍ ، قَالَ :  قَالَ  عُمَرُ - رَضِيَ اللهُ عَنْهُ - :  الدِّرْهَمُ بِالدِّرْهَمِ  ، وَمَا فَضَلَ بَيْنَهُمَا رِبًا  .","","Al-Matalib al-Aliyah 1377","","عمر بن الخطاب عن شريح بن الحارث الكندي عن ذكوان السمان عن حماد بن أبي سليمان عن سفيان الثوري عن يحيى القطان عن مسدد بن مسرهد","باب الربا"
"1664","[7/260]      1378  -  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  دَاوُدُ بْنُ الْمُحَبَّرِ ،  ثَنَا  مَيْسَرَةُ بْنُ عَبْدِ رَبِّهِ ،  عَنْ  أَبِي عَائِشَةَ السَّعْدِيِّ ،  عَنْ  يَزِيدَ بْنِ عُمَرَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي هُرَيْرَةَ وَابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمْ - قَالَا :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرَ حَدِيثًا طَوِيلًا - وَفِيهِ :  وَمَنْ أَكَلَ الرِّبَا مَلَأَ اللهُ بَطْنَهُ نَارًا بِقَدْرِ مَا أَكَلَ  ، وَإِنْ كَسَبَ مِنْهُ مَالًا لَمْ يَقْبَلِ اللهُ شَيْئًا مِنْ عَمَلِهِ ، وَلَمْ يَزَلْ فِي لَعْنَةِ اللهِ تَعَالَى وَمَلَائِكَتِهِ مَا دَامَ عِنْدَهُ مِنْهُ قِيرَاطٌ  .","","Al-Matalib al-Aliyah 1378","","عبد الله بن عباس عن أبو سلمة بن عبد الرحمن عن يزيد بن عمر بن عبد العزيز بن مروان عن أبو عائشة السعدي عن ميسرة بن عبد ربه التراس عن داود بن المحبر البكراوي عن الحارث بن محمد بن أبي أسامة","باب الربا"
"1665","[7/261]      1379  -  حَدَّثَنَا  يَحْيَى بْنُ هَاشِمٍ ،  ثَنَا  ابْنُ أَبِي لَيْلَى ،  عَنِ  الْحَكَمِ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  كَانَ عِنْدَ  بِلَالٍ  - رَضِيَ اللهُ عَنْهُ - تَمْرٌ مُسَوَّسٌ  ، فَبَاعَ صَاعَيْنِ بِصَاعٍ  ... الْحَدِيثَ  .","","Al-Matalib al-Aliyah 1379","","إبراهيم النخعي عن الحكم بن عتيبة الكندي عن محمد بن عبد الرحمن بن أبي ليلى عن يحيى بن هاشم الكوفي عن الحارث بن محمد بن أبي أسامة","باب الربا"
"1666","[7/262]      1380  -  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  مُلَازِمٌ ،  ثَنَا  زُفَرُ بْنُ يَزِيدَ ،  عَنْ  أَبِيهِ يَزِيدَ بْنِ عَبْدِ الرَّحْمَنِ السُّحَيْمِيِّ  ، وَكَانَ مِنْ جُلَسَاءِ  أَبِي هُرَيْرَةَ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  وَسَأَلْتُهُ  - يَعْنِي أَبَا هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ - عَنْ شِرَاءِ الشَّاةِ بِالشَّاتَيْنِ إِلَى أَجَلٍ  ، فَقَالَ : لَا ، إِلَّا يَدًا بِيَدٍ  .","","Al-Matalib al-Aliyah 1380","","أبو هريرة الدوسي عن أبو كثير السحيمي عن زفر بن أبي كثير السحيمي عن ملازم بن عمرو بن السحيمي عن مسدد بن مسرهد","باب الربا"
"1667","[7/263]      1381  -  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْمُغِيرَةِ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  إِذَا لَمْ يَقْدِرْ أَنْ يُزَايِلَ الذَّهَبَ مِنَ الْفِضَّةِ  ، فَلَا بَأْسَ أَنْ يَبِيعَهُ بِذَهَبٍ أَوْ فِضَّةٍ  .","","Al-Matalib al-Aliyah 1381","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد","باب الربا"
"1668","[7/264]      1382  -  حَدَّثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  إِنَّ  عَلِيًّا ، وَعُثْمَانَ - رَضِيَ اللهُ عَنْهُمَا - نَهَيَا عَنِ الصَّرْفِ  .","","Al-Matalib al-Aliyah 1382","","عثمان بن عفان عن سعيد بن المسيب عن قتادة بن دعامة عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد","باب الربا"
"1669","[7/265]      1383  -  حَدَّثَنَا  يَحْيَى ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ، قَالَ:  إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبَا بَكْرٍ  وَعُمَرَ  - رَضِيَ اللهُ عَنْهُمَا - نَهَوْا عَنِ الصَّرْفِ  .","","Al-Matalib al-Aliyah 1383","","محمد بن سيرين عن هشام بن حسان العتكي عن يحيى القطان عن مسدد بن مسرهد","باب الربا"
"1670","[7/266]      1384  -  وَحَدَّثَنَا  يَحْيَى ،  عَنْ  رَبِيعَةَ بْنِ كُلْثُومٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي عَبْدِ اللهِ ، قَالَ :  رَأَيْتُ  ثَلَاثِينَ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كُلُّهُمْ يَنْهَى عَنِ الصَّرْفِ  ، مِنْهُمْ مُعَاذُ بْنُ جَبَلٍ - رَضِيَ اللهُ عَنْهُ  -  .","","Al-Matalib al-Aliyah 1384","","معاذ بن جبل عن علي بن أبي الوليد البارقي عن مجاهد بن جبر المخزومي عن كلثوم بن جبر الخزاعي عن ربيعة بن كلثوم عن يحيى القطان عن مسدد بن مسرهد","باب الربا"
"1671","[7/267]      1385  -  قَالَ  :  وَحَدَّثَنِي  أَوْسُ بْنُ عَبْدِ اللهِ ،  ثَنَا  بُرَيْدُ بْنُ أَبِي مَرْيَمَ : أَنَّهُ  لَقِيَ  ابْنَ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُ - فَسَأَلَهُ عَنِ الصَّرْفِ ، فَقَالَ : لَا بَأْسَ بِهِ  . ثُمَّ بَلَغَهُ أَنَّهُ رَجَعَ عَنْ ذَلِكَ الْقَوْلِ  .","","Al-Matalib al-Aliyah 1385","","عبد الله بن عباس عن بريد بن أبي مريم السلولي عن أوس بن عبد الله السلولي عن مسدد بن مسرهد","باب الربا"
"1672","[7/268]      1386  -  حَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  حَدَّثَنِي  أَشْعَثُ بْنُ سُلَيْمٍ ،  عَنْ  عُبَيْدِ بْنِ نَضْلَةَ ، قَالَ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ جُزْءِ جَزُورٍ يُبَاعُ بِنِتَاجٍ  ، فَنَهَاهُمْ عَنْهُ  .","","Al-Matalib al-Aliyah 1386","","عبيد بن نضلة الخزاعي عن أشعث بن أبي الشعثاء عن سفيان الثوري عن يحيى القطان عن مسدد بن مسرهد","باب الربا"
"1673","[7/269]      1387  -  حَدَّثَنَا  يَحْيَى ،  عَنْ  هِشَامٍ ،  حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَمَّنْ  سَمِعَ  ابْنَ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  سُئِلَ عَنْ بَعِيرٍ بِبَعِيرَيْنِ  نَسِيئَةً  ، فَقَالَ : الزِّيَادَةُ يَصْلُحُ بَعْضُهَا بِبَعْضٍ ، فَأَمَّا لَحْمٌ مَوْضُوعٌ فَلَا بَأْسَ بِهِ  .         [7/270]","","Al-Matalib al-Aliyah 1387","","عبد الله بن عباس عن عمن عن يحيى بن أبي كثير عن هشام الدستوائي عن يحيى القطان عن مسدد بن مسرهد","باب الربا"
"1674","[7/271]      1388  -  حَدَّثَنَا  يَحْيَى ،  عَنْ  مَالِكٍ ،  حَدَّثَنِي  صَالِحُ بْنُ كَيْسَانَ ،  عَنِ  الْحَسَنِ بْنِ مُحَمَّدِ بْنِ عَلِيٍّ ، قَالَ :  إِنَّ  عَلِيًّا - رَضِيَ اللهُ عَنْهُ - بَاعَ بَعِيرًا بِبَعِيرَيْنِ مَعًا إِلَى أَجَلٍ  .         [7/272]","","Al-Matalib al-Aliyah 1388","","علي بن أبي طالب عن الحسن بن محمد بن علي بن أبي طالب عن صالح بن كيسان الدوسي عن مالك بن أنس عن يحيى القطان عن مسدد بن مسرهد","باب الربا"
"1675","[7/273]      1389  -  حَدَّثَنَا  يَحْيَى ،  عَنْ  مَالِكٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ بَيْعِ الْحَيَوَانِ بِالْحَيَوَانِ  .         [7/274]             [7/275]             [7/276]             [7/277]             [7/278]","","Al-Matalib al-Aliyah 1389","","سعيد بن المسيب عن زيد بن أسلم عن مالك بن أنس عن يحيى القطان عن مسدد بن مسرهد","باب الربا"
"1676","[7/279]      1390  -  وَقَالَ الطَّيَالِسِيُّ :  حَدَّثَنَا  الرَّبِيعُ بْنُ صُبَيْحٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْوَرِقُ بِالْوَرِقِ  ، وَالذَّهَبُ بِالذَّهَبِ ، وَالتَّمْرُ بِالتَّمْرِ ، وَالْبُرُّ بِالْبُرِّ ، وَالشَّعِيرُ بِالشَّعِيرِ ، وَالْمِلْحُ بِالْمِلْحِ ، عَيْنًا بِعَيْنٍ ، أَوْ وَزْنًا بِوَزْنٍ  ... الْحَدِيثَ  .         [7/280]             [7/281]","","Al-Matalib al-Aliyah 1390","","أنس بن مالك عن محمد بن سيرين عن الربيع بن صبيح عن أبو داود الطيالسي","باب الربا"
"1677","[7/282]      1391  -  وَقَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ،  عَنْ  عُبَيْدٍ ، قَالَ :  نَحَرْتُ جَزُورًا عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - فَقَسَمْتُ أَجْزَاءً ، فَقَالَ  رَجُلٌ  : أَعْطِنِي جُزْءًا مِنَ الْأَجْزَاءِ بِشَاةٍ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَا يَصْلُحُ هَذَا  .","","Al-Matalib al-Aliyah 1391","","عبيد بن نضلة الخزاعي عن أشعث بن أبي الشعثاء عن سفيان الثوري عن وكيع بن الجراح عن ابن أبي عمر العدني","باب الربا"
"1678","[7/283]      1392  -  وَقَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  يَحْيَى بْنُ أَبِي زَائِدَةَ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  أَبِي نَضْرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  قَالَ  أَبُو سَعِيدٍ - رَضِيَ اللهُ عَنْهُ -  التَّمْرُ بِالتَّمْرِ  ، أَحَقُّ أَنْ يَكُونَ رِبًا مِنَ الْوَرِقِ بِالْوَرِقِ  .","","Al-Matalib al-Aliyah 1392","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن داود بن أبي هند عن يحيى بن زكريا بن أبي زائدة عن أبو بكر ابن أبي شيبة","باب الربا"
"1679","[7/284]      13 - بَابُ الْكَيْلِ عَلَى مَنِ اسْتَوْفَى وَصِحَّةِ الْمُعَاطَاةِ  1393  / 1  -  قَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  يَزِيدَ بْنِ زِيَادِ بْنِ أَبِي الْجَعْدِ ،  حَدَّثَنَا  أَبُو صَخْرَةَ جَامِعُ بْنُ شَدَّادٍ ،  عَنْ  طَارِقِ بْنِ عَبْدِ اللهِ الْمُحَارِبِيِّ - رَضِيَ اللهُ عَنْهُ - قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّتَيْنِ ..فَذَكَرَ الْحَدِيثَ ، قَالَ : أَقْبَلْنَا فِي رَكْبٍ مِنَ  الرَّبَذَةِ  حَتَّى نَزَلْنَا قَرِيبًا مِنَ  الْمَدِينَةِ  ، وَمَعَنَا ظَعِينَةٌ لَنَا ، قَالَ : فَبَيْنَا نَحْنُ قُعُودٌ إِذْ أَتَانَا رَجُلٌ عَلَيْهِ ثَوْبَانِ أَبْيَضَانِ ، فَسَلَّمَ فَرَدَدْنَا عَلَيْهِ ، فَقَالَ :  مِنْ أَيْنَ أَقْبَلَ  الْقَوْمُ  ؟ قُلْنَا : مِنَ  الرَّبَذَةِ  ،  وَجَنُوبِ الرَّبَذَةِ  . قَالَ : وَمَعَنَا جَمَلٌ أَحْمَرُ  . قَالَ : تَبِيعُونِي الْجَمَلَ ؟ قُلْنَا : نَعَمْ . قَالَ : بِكَمْ ؟ قُلْنَا : بِكَذَا وَكَذَا صَاعًا مِنَ التَّمْرِ . قَالَ : فَمَا اسْتَنْقَصَنَا شَيْئًا ، وَقَالَ : قَدْ أَخَذْتُهُ . ثُمَّ أَخَذَ بِرَأْسِ الْجَمَلِ حَتَّى دَخَلَ  الْمَدِينَةَ  فَتَوَارَى عَنَّا ،  فَتَلَاوَمْنَا  بَيْنَنَا ، قُلْنَا : أَعْطَيْتُمْ جَمَلَكُمْ رَجُلًا مَا تَعْرِفُونَهُ ! قَالَتِ الظَّعِينَةُ : لَا تَلُومُوا أَنْفُسَكُمْ ، فَلَقَدْ رَأَيْتُ وَجْهًا مَا كَانَ لِيَخْفِرَكُمْ ، مَا رَأَيْتُ رَجُلًا أَشْبَهَ بِالْقَمَرِ لَيْلَةَ الْبَدْرِ مِنْ وَجْهِهِ ، فَلَمَّا كَانَ الْعِشَاءُ أَتَى  رَجُلٌ  فَقَالَ : السَّلَامُ عَلَيْكُمْ ، إِنِّي رَسُولُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَيْكُمْ ، وَإِنَّهُ يَأْمُرُكُمْ أَنْ تَأْكُلُوا حَتَّى تَشْبَعُوا ، وَتَكْتَالُوا حَتَّى تَسْتَوْفُوا . فَأَكَلْنَا حَتَّى شَبِعْنَا ، وَاكْتَلْنَا حَتَّى اسْتَوْفَيْنَا . فَلَمَّا كَانَ الْغَدُ دَخَلْنَا  الْمَدِينَةَ  ، فَإِذَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَائِمٌ عَلَى الْمِنْبَرِ يَخْطُبُ النَّاسَ  .","","Al-Matalib al-Aliyah 1393","","طارق بن عبد الله المحاربي عن جامع بن شداد عن يزيد بن زياد بن أبي الجعد الغطفاني عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة","باب الكيل على من استوفى وصحة المعاطاة"
"1680","وَقَالَ أَبُو يَعْلَى  1393  / 2  - :  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى الْوَاسِطِيُّ ،  ثَنَا  سِنَانُ بْنُ هَارُونَ أَخُو سَيْفٍ ،  عَنْ  يَزِيدَ بْنِ زِيَادِ بْنِ أَبِي الْجَعْدِ ،  حَدَّثَنِي  أَبُو صَخْرَةَ ،         [7/285]      قَالَ : قَالَ رَجُلٌ مِنَّا يُقَالُ لَهُ طَارِقٌ :  رَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّتَيْنِ .  أَمَّا مَرَّةٌ فَرَأَيْتُهُ  بِسُوقِ ذِي الْمَجَازِ  وَهُوَ عَلَى دَابَّةٍ وَقَدْ دَمِيَتْ عُرْقُوبَاهُ ... فَذَكَرَ الْحَدِيثَ . قَالَ : ثُمَّ قَدِمْنَا بَعْدَ ذَلِكَ فَنَزَلْنَا  الْمَدِينَةَ  ، فَخَرَجَ عَلَيْنَا رَجُلٌ فَقَالَ :  مِنْ أَيْنَ أَقْبَلْتُمْ ؟ قُلْنَا : مِنَ  الرَّبَذَةِ  ، أَوْ مِنْ نَوَاحِيهَا . قَالَ : مَعَكُمْ شَيْءٌ تَبِيعُونَهُ ؟  قُلْنَا : نَعَمْ ، هَذَا الْبَعِيرُ . قَالَ : بِكَمْ ؟ قُلْنَا : بِكَذَا وَكَذَا وَسْقًا مِنْ تَمْرٍ .  فَأَخَذَ بِخِطَامِهِ يَجُرُّهُ ، ثُمَّ دَخَلَ بِهِ  الْمَدِينَةَ  ، فَقُلْتُ : أَيُّ شَيْءٍ صَنَعْنَا ؟ بِعْنَا بَعِيرَنَا مِنْ رَجُلٍ لَا نَعْرِفُهُ ! قَالَ : وَمَعَنَا ظَعِينَةٌ فِي جَانِبِ الْخِبَاءِ ، فَقَالَتْ : أَنَا ضَمِنَةٌ ثَمَنَ الْبَعِيرِ ، لَقَدْ رَأَيْتُ وَجْهَ رَجُلٍ مِثْلَ الْقَمَرِ لَيْلَةَ الْبَدْرِ ، لَا  يَخِيسُ  بِكُمْ . فَلَمَّا أَصْبَحْنَا أَتَى  رَجُلٌ  وَمَعَهُ تَمْرٌ ، فَقَالَ : أَنَا رَسُولُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَيْكُمْ أَنْ تَأْكُلُوا مِنْ هَذَا التَّمْرِ حَتَّى تَشْبَعُوا ، وَأَنْ تَكْتَالُوا حَتَّى تَسْتَوْفُوا . فَقَالَ : فَفَعَلْنَا  .         [7/286]","","Al-Matalib al-Aliyah 1393","","طارق بن عبد الله المحاربي عن جامع بن شداد عن يزيد بن زياد بن أبي الجعد الغطفاني عن سنان بن هارون البرجمي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","باب الكيل على من استوفى وصحة المعاطاة"
"1681","[7/287]      14 - بَابُ الشُّرُوطِ فِي الْبَيْعِ وَنَقْدِ الدَّرَاهِمِ  1394  -  مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  حَدَّثَنِي  عَاصِمُ بْنُ عُبَيْدِ اللهِ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ - رَضِيَ اللهُ عَنْهَا - :  فِي الرَّجُلِ يَشْتَرِي الْجَارِيَةَ عَلَى أَنْ لَا تَبِيعَ وَلَا تَهَبَ ؟  قَالَتْ : كَرِهْتُ ذَلِكَ وَكَرِهْتُ الشَّرْطَ  .","","Al-Matalib al-Aliyah 1394","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن سفيان الثوري عن يحيى القطان عن مسدد بن مسرهد","باب الشروط في البيع ونقد الدراهم"
"1682","[7/288]      1395  -  [1]  وَحَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  خَالِدِ بْنِ سَلَمَةَ الْمَخْزُومِيِّ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ الْحَارِثِ بْنِ أَبِي ضِرَارٍ ،  عَنْ  زَيْنَبَ امْرَأَةِ عَبْدِ اللهِ بْنِ مَسْعُودٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَتْ :  أَخْدَمَنِي عُمَرُ - رَضِيَ اللهُ عَنْهُ - خَادِمًا ،  فَقَالَ  عَبْدُ اللهِ : تَبِيعِينَهَا ؟  قَالَتْ : فَقُلْتُ : مَا كُنْتُ لِأَبِيعَكَ خَادِمًا أَخْدَمَنِيهَا أَمِيرُ الْمُؤْمِنِينَ . فَلَمْ يَزَلْ بِهَا حَتَّى اشْتَرَاهَا مِنْهَا ، وَشَرَطَ لَهَا خِدْمَتَهَا حَتَّى تَشْتَرِيَ خَادِمًا . فَسَعَى سَاعٍ فَأَخْبَرَ  عُمَرَ  - رَضِيَ اللهُ عَنْهُ - بِذَلِكَ  فَرَاحَ إِلَيْهِ أَوْ غَدَا  ، فَقَالَ لَهُ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - : بَلَغَنِي أَنَّكَ اشْتَرَيْتَ جَارِيَةَ  زَيْنَبَ  ! قَالَ : أَجَلْ ،  قَالَ  : فَلَا تَقْرَبَنَّهَا وَلِأَحَدٍ فِيهَا مَثْنَوِيَّةٌ  .  [2] رَوَاهُ  الْبَيْهَقِيُّ  مِنْ طَرِيقِ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ  ، عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ الْحَارِثِ بْنِ أَبِي الضِّرَارِ  ، قَالَ :  إِنَّ  عُمَرَ بْنَ الْخَطَّابِ  - رَضِيَ اللهُ عَنْهُ - أَعْطَى امْرَأَةَ عَبْدِ اللهِ بْنِ مَسْعُودٍ - رَضِيَ اللهُ عَنْهُمَا - جَارِيَةً مِنَ الْخُمُسِ  ... فَذَكَرَ نَحْوَهُ .         [7/289]","","Al-Matalib al-Aliyah 1395","","عبد الله بن مسعود عن زينب بنت معاوية رائطة عن محمد بن عمرو بن الحارث الخزاعي عن الفأفأ ، خالد بن سلمة بن العاص عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد","باب الشروط في البيع ونقد الدراهم"
"1683","[7/290]      1396  / 1  -  وَقَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  ثَنَا  حَجَّاجٌ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَابِسٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  اشْتَرَى حُذَيْفَةُ - رَضِيَ اللهُ عَنْهُ - نَاقَةً مِنْ رَجُلَيْنِ مِنَ  النَّخَعِ  ، وَشَرَطَ لَهُمَا رِضَاهُمَا مِنَ النَّقْدِ ، فَجَاءَ بِهِمَا إِلَى مَنْزِلِهِ ، فَأَخْرَجَ لَهُمَا كِيسًا ، فَاقْتَتَلَا عَلَيْهِ ، ثُمَّ أَخْرَجَ لَهُمَا كِيسًا ، فَاقْتَتَلَا عَلَيْهِ ،  فَقَالَ  حُذَيْفَةُ  - رَضِيَ اللهُ عَنْهُ - : أَعُوذُ بِاللهِ مِنْكُمَا  ... فَذَكَرَ الْحَدِيثَ .","","Al-Matalib al-Aliyah 1396","","حذيفة بن اليمان عن عابس بن ربيعة الغطيفي عن عبد الرحمن بن عابس النخعي عن حجاج بن أرطاة عن سليمان بن حيان الأحمر عن أبو بكر ابن أبي شيبة","باب الشروط في البيع ونقد الدراهم"
"1684","1396  / 2  -  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  حَجَّاجُ بْنُ أَرْطَأَةَ ، فَذَكَرَهُ بِلَفْظِ :  اشْتَرَى حُذَيْفَةُ - رَضِيَ اللهُ عَنْهُ - مِنْ رَجُلٍ نَاقَةً بِأَرْبَعِمِائَةِ دِرْهَمٍ  ، وَشَرَطَ لَهُ رِضَاهُ مِنَ النَّقْدِ . فَأَتَاهُ بِرَجُلٍ مِنْ  أَصْبَهَانَ  ، كَانَ أَبْصَرَ بِالْوَزْنِ مِنْهُ ، فَأَخْرَجَ لَهُ  حُذَيْفَةُ  - رَضِيَ اللهُ عَنْهُ - كِيسًا فَقَبِلَ عَامَّتَهُ ، ثُمَّ أَخْرَجَ لَهُ كِيسًا آخَرَ فَقَبِلَ عَامَّتَهُ ، ثُمَّ أَخْرَجَ لَهُ كِيسًا ثَالِثًا فَقَبِلَ عَامَّتَهُ ، فَقَالَ : أَعُوذُ بِاللهِ مِنْكُمَا  ... فَذَكَرَ الْحَدِيثَ .         [7/291]      .","","Al-Matalib al-Aliyah 1396","","حذيفة بن اليمان عن عابس بن ربيعة الغطيفي عن عبد الرحمن بن عابس النخعي عن حجاج بن أرطاة عن يزيد بن هارون عن الحارث بن محمد بن أبي أسامة","باب الشروط في البيع ونقد الدراهم"
"1685","[7/292]      15 - بَابُ مَا نَهَى عَنْهُ مِنَ الْبُيُوعِ  1397  -  إِسْحَاقُ :  أَخْبَرَنَا  عِيسَى بْنُ يُونُسَ ،  ثَنَا  الْأَحْوَصُ بْنُ حَكِيمٍ ،  عَنْ  أَبِي عَوْنٍ الْأَعْوَرِ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  أَرْسَلَ  ابْنُ عُمَرَ  - رَضِيَ اللهُ عَنْهُمَا - إِلَى  رَافِعِ بْنِ خَدِيجٍ  - رَضِيَ اللهُ عَنْهُ - يَسْأَلُهُ عَنْ قَوْلِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي أَرْضِ الْعَجَمِ وَشِرَائِهَا وَكِرَائِهَا ، فَقَالَ رَافِعُ بْنُ خَدِيجٍ - رَضِيَ اللهُ عَنْهُ - :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ بَيْعِ أَرْضِ الْعَجَمِ  وَشِرَائِهَا وَكِرَائِهَا  .  هَذَا  إِسْنَادٌ  ضَعِيفٌ  .         [7/293]","","Al-Matalib al-Aliyah 1397","","رافع بن خديج الأنصاري عن سعيد بن المسيب عن عبد الله بن أبي عبد الله الشامي الأعور عن أحوص بن حكيم عن عيسى بن يونس بن أبي إسحاق عن إسحاق ابن راهويه","باب ما نهى عنه من البيوع"
"1686","[7/294]      1398  -  قَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  لَيْثٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَتَّابِ بْنِ أَسِيدٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  لَمَّا بَعَثَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَهَاهُ عَنْ  سَلَفٍ  وَبَيْعٍ  ، وَعَنْ شَرْطٍ وَبَيْعٍ ، وَعَنْ بَيْعِ مَا لَيْسَ عِنْدَكَ  .  هَذَا  مُنْقَطِعٌ  بَيْنَ  عَطَاءٍ  وَعَتَّابٍ  ، مَعَ ضَعْفِ  لَيْثِ بْنِ أَبِي سُلَيْمٍ  .         [7/295]             [7/296]","","Al-Matalib al-Aliyah 1398","","عتاب بن أسيد بن أبي العيص الأموي عن عطاء بن أبي رباح عن ليث بن أبي سليم عن محمد بن فضيل بن غزوان عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","باب ما نهى عنه من البيوع"
"1687","[7/297]      1399  -  وَقَالَ الطَّيَالِسِيُّ :  حَدَّثَنَا  قَيْسٌ - هُوَ ابْنُ الرَّبِيعِ - وَسَلَّامٌ - هُوَ أَبُو الْأَحْوَصِ -  عَنْ  عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ،  عَنْ  رَجُلٍ مِنْ بَنِي تَمِيمٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  ثَمَنُ الْكَلْبِ وَمَهْرُ  الْبَغِيِّ  وَثَمَنُ الْخَمْرِ حَرَامٌ  .  ( 53 ) وَسَيَأْتِي إِنْ شَاءَ اللهُ تَعَالَى - فِي الْأَشْرِبَةِ بَقِيَّةُ مَا يَتَعَلَّقُ بِالنَّهْيِ عَنْ بَيْعِ الْخَمْرِ .         [7/298]","","Al-Matalib al-Aliyah 1399","","رجل من بني تميم عن عبد الكريم الاصطخري عن سلام بن سليم الحنفي عن أبو داود الطيالسي","باب ما نهى عنه من البيوع"
"1688","[7/299]      1400  -  مُسَدَّدٌ :  حَدَّثَنَا  مُلَازِمُ بْنُ عَمْرٍو ،  ثَنَا  زُفَرُ بْنُ يَزِيدَ بْنِ عَبْدِ الرَّحْمَنِ السُّحَيْمِيُّ ،  عَنْ  أَبِيهِ  ، وَكَانَ مِنْ جُلَسَاءِ  أَبِي هُرَيْرَةَ  - رَضِيَ اللهُ عَنْهُ - : أَنَّهُ  سَأَلَ  أَبَا هُرَيْرَةَ - رَضِيَ اللهُ عَنْهُ - عَنْ شِرَاءِ اللَّبَنِ فِي ضُرُوعِ الْغَنَمِ  ، فَقَالَ : لَا خَيْرَ فِيهِ  .         [7/300]","","Al-Matalib al-Aliyah 1400","","أبو هريرة الدوسي عن أبو كثير السحيمي عن زفر بن أبي كثير السحيمي عن ملازم بن عمرو بن السحيمي عن مسدد بن مسرهد","باب ما نهى عنه من البيوع"
"1689","[7/301]      1401  -  وَقَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  وَكِيعٌ ،  ثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ بَيْعِ  الْمَجْرِ  -  يَعْنِي اشْتِرَاءَ مَا فِي الْأَرْحَامِ  .","","Al-Matalib al-Aliyah 1401","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن موسى بن عبيدة بن نشيط الحميري عن وكيع بن الجراح عن ابن أبي عمر العدني","باب ما نهى عنه من البيوع"
"1690","[7/302]      1402  -  وَقَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  ثَنَا  الْقَاسِمُ ، وَمَكْحُولٌ ،  عَنْ  أَبِي أُمَامَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ تُبَاعَ  الثَّمَرَةُ  حَتَّى يَبْدُوَ صَلَاحُهَا  .","","Al-Matalib al-Aliyah 1402","","أبو أمامة الباهلي عن القاسم بن عبد الرحمن الدمشقي عن عبد الرحمن بن يزيد الداراني عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة","باب ما نهى عنه من البيوع"
"1691","[7/303]      1403  / 1  -  وَقَالَ أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ :  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ، (  ح  ) .  1403  / 2  - وَأَحْمَدُ بْنُ مَنِيعٍ :  ثَنَا  أَبُو سَعْدٍ الصَّغَانِيُّ ، قَالَا :  ثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يُبْتَاعَ كَالٌ بِكَالٍ دَيْنًا بِدَيْنٍ  . وَلَفْظُ وَكِيعٍ ، قَالَ الْآخَرُ : أَنْ يُبْتَاعَ  الْكَالِئُ  بِالْكَالِئِ  ، وَهُوَ الدَّيْنُ بِالدَّيْنِ  .  مُوسَى  ضَعِيفٌ  .         [7/304]             [7/305]             [7/306]","","Al-Matalib al-Aliyah 1403","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن موسى بن عبيدة بن نشيط الحميري عن محمد بن ميسر الصاغاني عن أحمد بن منيع البغوي","باب ما نهى عنه من البيوع"
"1692","[7/307]      1404  / 1  -  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنِ اشْتَرَى شَاةً  مُحَفَّلَةً  ، فَلَهُ أَنْ يُمْسِكَهَا ثَلَاثًا  ، فَإِنْ رَضِيَهَا أَمْسَكَهَا ، وَإِنْ رَدَّهَا رَدَّ مَعَهَا صَاعًا مِنْ تَمْرٍ  .","","Al-Matalib al-Aliyah 1404","","أنس بن مالك عن الحسن البصري عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن إسماعيل بن زكريا شقوصا عن محمد بن بكار الرصافي عن الحارث بن محمد بن أبي أسامة","باب ما نهى عنه من البيوع"
"1693","1404  / 2  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  حُمَيْدُ بْنُ مَسْعَدَةَ ،  ثَنَا  عَرْعَرَةُ بْنُ الْبِرِنْدِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ مُسْلِمٍ الْمَكِّيُّ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَنَسٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَلَامَسُوا ، وَلَا  تَنَاجَشُوا ،  وَلَا تَبَايَعُوا  الْغَرَرَ  ، وَلَا يَبِعْ  حَاضِرٌ  لِبَادٍ ،  وَمَنِ اشْتَرَى  مُحَفَّلَةً  فَلْيَحْلُبْهَا ثَلَاثَةَ أَيَّامٍ ، فَإِنْ رَدَّهَا فَلْيَرُدَّ مَعَهَا بِصَاعٍ مِنْ تَمْرٍ  .         [7/308]             [7/309]","","Al-Matalib al-Aliyah 1404","","أنس بن مالك عن الحسن البصري عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن عرعرة بن البرند عن حميد السامي عن أبو يعلى الموصلي","باب ما نهى عنه من البيوع"
"1694","[7/310]      1405  -  قَالَ أَبُو يَعْلَى :  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ  ،  ثَنَا  عَلِيُّ بْنُ هَاشِمٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ عَجْلَانَ ،  عَنْ  أَبِي يَزِيدَ الْمَدَنِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ الشَّرُودَ يُرَدُّ  ،  يَعْنِي : الْبَعِيرَ الشَّرُودَ  .  كذا في طبعة دار العاصمة ، ولعل الصواب : ( عبد الله بن عمر ) وينظر مصادر التخريج ، والله أعلم.","","Al-Matalib al-Aliyah 1405","","أبو هريرة الدوسي عن أبو يزيد المديني عن صاحب الطعام عبد السلام بن عجلان عن علي بن هاشم العائذي عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","باب ما نهى عنه من البيوع"
"1695","[7/311]      1406  -  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  لَا تُبَاعُ  الثَّمَرَةُ  حَتَّى يَبْدُوَ صَلَاحُهَا  .  وَكَانَ ابْنُ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - يَقُولُ : حَتَّى تُطْعَمَ  .         [7/312]","","Al-Matalib al-Aliyah 1406","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن مسدد بن مسرهد","باب ما نهى عنه من البيوع"
"1696","[7/313]      1407  -  حَدَّثَنَا  خَالِدٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي نُعْمٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ  قَفِيزِ  الطَّحَّانِ  .  هَذَا  مُرْسَلٌ  حَسَنٌ  ، أَخْرَجَهُ  الدَّارَقُطْنِيُّ  مَوْصُولًا  بِذِكْرِ  أَبِي سَعِيدٍ  مِنْ وَجْهٍ آخَرَ ، عَنْ  عَبْدِ الرَّحْمَنِ  .         [7/314]","","Al-Matalib al-Aliyah 1407","","عبد الرحمن بن أبي نعم البجلي عن عطاء بن السائب عن خالد بن عبد الله الطحان عن مسدد بن مسرهد","باب ما نهى عنه من البيوع"
"1697","[7/315]      1408  -  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  سُفْيَانُ ،  ثَنَا  أَبُو مُعَاذٍ ، قَالَ :  كُنْتُ تَيَّاسًا ، فَنَهَانِي الْبَرَاءُ بْنُ عَازِبٍ - رَضِيَ اللهُ عَنْهُمَا  -  فَقَالَ  : إِنَّ هَذَا لَا يَحِلُّ  .","","Al-Matalib al-Aliyah 1408","","البراء بن عازب الأوسي عن شوذب مولى البراء بن عازب عن سفيان بن عيينة عن مسدد بن مسرهد","باب ما نهى عنه من البيوع"
"1698","[7/316]      16 - بَابُ  الزَّجْرِ  عَنِ الِاحْتِكَارِ  1409  / 1  -  إِسْحَاقُ :  أَخْبَرَنَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  سَمِعْتُ  أَبِي  يَقُولُ :  ثَنَا  أَبُو نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ مَوْلَى أَبِي أُسَيْدٍ :  أَنَّ  عُثْمَانَ بْنَ عَفَّانَ - رَضِيَ اللهُ عَنْهُ - كَانَ يَنْهَى عَنِ  الْحُكْرَةِ  .  قَالَ  أَبِي  : وَكَانُوا لَا يَرَوْنَ الْحُكْرَةَ إِلَّا فِي الطَّعَامِ وَالْأُدْمِ  .","","Al-Matalib al-Aliyah 1409","","عثمان بن عفان عن أبو سعيد مولى أبي أسيد الساعدي عن المنذر بن مالك العوقي عن سليمان بن طرخان عن معتمر بن سليمان عن إسحاق ابن راهويه","باب الزجر عن الاحتكار"
"1699","1409  / 2  -  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ، بِلَفْظِ :  أَنَّ عُثْمَانَ - رَضِيَ اللهُ عَنْهُ - كَانَ يَنْهَى عَنِ  الْحُكْرَةِ  ، فَكَلَّمَهُ  الزُّبَيْرُ  - رَضِيَ اللهُ عَنْهُ - فِي مَوْلًى لَهُ أَوْ فِي إِنْسَانٍ ، فَتَرَكَهُ  .         [7/317]","","Al-Matalib al-Aliyah 1409","","عثمان بن عفان عن أبو سعيد مولى أبي أسيد الساعدي عن المنذر بن مالك العوقي عن سليمان بن طرخان عن يحيى القطان عن مسدد بن مسرهد","باب الزجر عن الاحتكار"
"1700","[7/318]      1410  -  وَقَالَ إِسْحَاقُ :  أَخْبَرَنَا  وَكِيعٌ ،  حَدَّثَنِي  ابْنُ أَبِي ذِئْبٍ ،  عَنْ  مُسْلِمٍ الْخَيَّاطِ ، قَالَ :  كُنْتُ أَشْتَرِي الْخَبَطَ وَالنَّوَى لِسَعِيدِ بْنِ الْمُسَيِّبِ فَيَحْتَكِرُهُ  .         [7/319]","","Al-Matalib al-Aliyah 1410","","سعيد بن المسيب عن مسلم بن أبي مسلم الخياط عن محمد بن عبد الرحمن بن المغيرة عن وكيع بن الجراح عن إسحاق ابن راهويه","باب الزجر عن الاحتكار"
"1701","[7/320]      1411  -  وَقَالَ أَبُو بَكْرٍ وَابْنُ أَبِي عُمَرَ جَمِيعًا :  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ بْنِ جَابِرٍ ،  ثَنَا  الْقَاسِمُ ،  عَنْ  أَبِي أُمَامَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يُحْتَكَرَ الطَّعَامُ  .","","Al-Matalib al-Aliyah 1411","","أبو أمامة الباهلي عن القاسم بن عبد الرحمن الدمشقي عن عبد الرحمن بن يزيد الداراني عن حماد بن أسامة القرشي عن ابن أبي عمر العدني","باب الزجر عن الاحتكار"
"1702","[7/321]      1412  -  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  عُبَيْدُ اللهِ - هُوَ ابْنُ مُوسَى -  عَنِ  الرَّبِيعِ بْنِ حَبِيبٍ ،  عَنْ  نَوْفَلِ بْنِ عَبْدِ الْمَلِكِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَلِيٍّ - رَضِيَ اللهُ عَنْهُ - قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ  الْحُكْرَةِ  بِالْبَلَدِ  .","","Al-Matalib al-Aliyah 1412","","علي بن أبي طالب عن عبد الملك بن المغيرة بن نوفل القرشي عن نوفل بن عبد الملك بن المغيرة الهاشمي عن الربيع بن حبيب الأحول عن عبيد الله بن موسى عن الحارث بن محمد بن أبي أسامة","باب الزجر عن الاحتكار"
"1703","[7/322]      17 - بَابُ السُّفْتَجَةِ  1413 -  قَالَ إِسْحَاقُ :  1413  أَخْبَرَنَا  وَكِيعٌ ،  ثَنَا  أَبُو الْعُمَيْسِ ،  عَنِ  ابْنِ جُعْدُبَةَ ،  عَنْ  عُبَيْدِ بْنِ السَّبَّاقِ ،  عَنْ  زَيْنَبَ امْرَأَةِ عَبْدِ اللهِ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَعْطَاهَا جُذَاذَ أَرْبَعِينَ وَسْقًا مِنْ تَمْرٍ  ، وَعِشْرِينَ وَسْقًا مِنْ شَعِيرٍ بِخَيْبَرَ ، فَأَتَاهَا  عَاصِمُ بْنُ عَدِيٍّ  ، فَقَالَ لَهَا : إِنْ شِئْتِ وَفَّيْتُهَا هَاهُنَا ، وَأَتَوَفَّاهَا مِنْكِ  بِخَيْبَرَ  ، فَقَالَتْ : حَتَّى أَسْأَلَ أَمِيرَ الْمُؤْمِنِينَ ، فَذَكَرَتْ ذَلِكَ لَهُ فَكَرِهَهُ ، وَقَالَ : كَيْفَ بِالضَّمَانِ .  قَالَ  وَكِيعٌ  :  هَذِهِ السُّفْتَجَةُ ، وَهِيَ مَكْرُوهَةٌ فِي قَوْلِ  عُمَرَ  .         [7/323]","","Al-Matalib al-Aliyah 1413","","زينب بنت معاوية رائطة عن عبيد بن السباق  العبدري عن يزيد بن عياض بن جعدبة الليثي عن عتبة بن عبد الله بن عتبة المسعودي عن وكيع بن الجراح عن إسحاق ابن راهويه","باب السفتجة"
"1704","[7/324]      18 - بَابُ السَّلَمِ  1414  -  أَبُو يَعْلَى :  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  ثَنَا  الْوَلِيدُ ،  ثَنَا  مُحَمَّدُ بْنُ حَمْزَةَ بْنِ يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  أَسْلَفَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِرَجُلٍ مِنَ الْيَهُودِ ، يُقَالُ لَهُ  يَامِينُ  ، فِي تَمْرٍ إِلَى أَجَلٍ مُسَمًّى ، فَقَالَ الْيَهُودِيُّ : مِنْ تَمْرِ حَائِطِ بَنِي فُلَانٍ ؟ فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَمَّا مِنْ تَمْرِ حَائِطِ بَنِي فُلَانٍ فَلَا  .         [7/325]             [7/326]","","Al-Matalib al-Aliyah 1414","","يوسف بن عبد الله بن سلام الإسرائيلي عن حمزة بن يوسف بن عبد الله بن سلام عن محمد بن حمزة الإسرائيلي عن الوليد بن مسلم القرشي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","باب السلم"
"1705","[7/327]      19 - بَابُ الْأُصُولِ وَالثِّمَارِ  1415  -  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  مَالِكٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ - رَضِيَ اللهُ عَنْهُ - قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ  الْمُزَابَنَةِ  ، وَالْمُحَاقَلَةِ  ... الْحَدِيثَ ، وَفِيهِ تَفْسِيرُهَا .  قَالَ : وَسَأَلْتُ  سَعِيدًا  عَنْ كِرَائِهَا بِالذَّهَبِ وَالْفِضَّةِ ، فَقَالَ : لَا بَأْسَ بِهِ  .         [7/328]","","Al-Matalib al-Aliyah 1415","","سعيد بن المسيب عن الزهري عن مالك بن أنس عن يحيى القطان عن مسدد بن مسرهد","باب الأصول والثمار"
"1706","[7/329]      1416  -  وَحَدَّثَنَا  سُفْيَانُ ،  عَنْ  مَعْمَرٍ ،  عَنِ  ابْنِ طَاوُسٍ ، قَالَ :  إِنَّ أَبَاهُ كَانَ يَكْرَهُ أَنْ يُبَاعَ الْكَلَأُ فِي مَنْبِتِهِ  .","","Al-Matalib al-Aliyah 1416","","طاوس بن كيسان عن عبد الله بن طاووس عن معمر بن راشد عن سفيان بن عيينة عن مسدد بن مسرهد","باب الأصول والثمار"
"1707","[7/330]      1417  -  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ :  أَنَّهُ كَرِهَ بَيْعَ الرُّطَبِ إِلَّا جِزَّةً جِزَّةً  .","","Al-Matalib al-Aliyah 1417","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن مسدد بن مسرهد","باب الأصول والثمار"
"1708","[7/331]      1418  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ،  عَنْ  بُرَيْدِ بْنِ أَبِي بُرْدَةَ ،  عَنْ  عَطَاءٍ :  أَنَّهُ سُئِلَ عَنْ بَيْعِ الرُّطَبِ  ، فَقَالَ : جَزَّةً لَا جَزَّتَيْنِ  .","","Al-Matalib al-Aliyah 1418","","عطاء بن أبي رباح عن بريد بن عبد الله بن أبي بردة عن عبد الله بن داود الخريبي عن مسدد بن مسرهد","باب الأصول والثمار"
"1709","[7/332]      1419  -  أَبُو يَعْلَى :  حَدَّثَنَا  عُثْمَانُ ،  ثَنَا  جَرِيرٌ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الصَّائِغِ ،  عَنْ  قَهْرَمَانٍ لِسَعْدٍ ،  عَنْ  سَعْدٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ مَنَعَ  فَضْلَ  مَاءٍ مَنَعَهُ اللهُ - تَبَارَكَ وَتَعَالَى - فَضْلَهُ يَوْمَ الْقِيَامَةِ  .","","Al-Matalib al-Aliyah 1419","","سعد بن أبي وقاص عن قهرمان لسعد عن أبو عبد الرحمن الصائغ عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","باب الأصول والثمار"
"1710","[7/333]      20 - بَابُ اجْتِنَابِ الشُّبُهَاتِ  1420  / 1  -  إِسْحَاقُ :  أَخْبَرَنَا  يَحْيَى بْنُ وَاضِحٍ الْأَنْصَارِيُّ ،  ثَنَا  مُوسَى بْنُ عُبَيْدَةَ الرَّبَذِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ عُبَيْدَةَ وَغَيْرِهِ ،  عَنْ  عَمَّارِ بْنِ يَاسِرٍ - رَضِيَ اللهُ عَنْهُ - عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْحَلَالُ بَيِّنٌ ، وَالْحَرَامُ بَيِّنٌ ، وَبَيْنَهُمَا مُشْتَبِهَاتٌ  ، فَمَنْ تَوَقَّاهُنَّ كَانَ أَتْقَى لِدِينِهِ ، وَمَنْ وَاقَعَهُنَّ أَوْشَكَ أَنْ يُوَاقِعَ الْكَبَائِرَ ، كَالْمُرْتَعِي إِلَى جَانِبِ الْحِمَى أَوْشَكَ أَنْ يُوَاقِعَهُ ، وَإِنَّ لِكُلِّ مَلِكٍ حِمًى ، وَحِمَى اللهِ تَعَالَى حُدُودُهُ  .  هَذَا  إِسْنَادٌ  ضَعِيفٌ ، لَهُ  شَاهِدٌ  فِي الصَّحِيحِ مِنْ حَدِيثِ  النُّعْمَانِ بْنِ بَشِيرٍ  - رَضِيَ اللهُ عَنْهُ -  .","","Al-Matalib al-Aliyah 1420","","عمار بن ياسر عن وغيره عن موسى بن عبيدة بن نشيط الحميري عن يحيى بن واضح الأنصاري عن إسحاق ابن راهويه","باب اجتناب الشبهات"
"1711","1420  / 2  - وَرَوَاهُ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَرَجِ ،  ثَنَا  مُحَمَّدُ بْنُ الزِّبْرِقَانِ ،  ثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  أَخْبَرَنِي  سَعْدُ بْنُ إِبْرَاهِيمَ ، عَمَّنْ  أَخْبَرَهُ  عَنْ  عَمَّارِ بْنِ يَاسِرٍ - رَضِيَ اللهُ عَنْهُ - نَحْوَهُ .         [7/334]             [7/335]","","Al-Matalib al-Aliyah 1420","","عمار بن ياسر عن عمن عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن موسى بن عبيدة بن نشيط الحميري عن محمد بن الزبرقان الأهوازي عن محمد بن الفرج الفراء عن أبو يعلى الموصلي","باب اجتناب الشبهات"
"1712","[7/336]      1421  -  مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  ثَنَا  الْحَجَّاجُ الصَّوَّافُ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ مَوْلَى سَعْدٍ  ، قَالَ :  جِئْتُ بِاللَّيْلِ أَنَا وَسَعْدٌ - رَضِيَ اللهُ عَنْهُ - إِلَى بُسْتَانٍ ذِي نَخْلٍ  ، فَطَلَبْنَا صَاحِبَ الْبُسْتَانِ فَلَمْ نَجِدْهُ ،  فَقَالَ  لِي  سَعْدٌ  - رَضِيَ اللهُ عَنْهُ - : إِنْ سَرَّكَ أَنْ تَكُونَ مُسْلِمًا حَقًّا ، فَلَا تَأْكُلْ مِنْهُ شَيْئًا . قَالَ : فَظَلَّيْنَا جَائِعَيْنِ  .  كذا في طبعة دار العاصمة ، والصواب : ( عبد الرحمن مولى سعد )","","Al-Matalib al-Aliyah 1421","","سعد بن أبي وقاص عن عبد الرحمن عن يحيى بن أبي كثير عن حجاج بن أبى عثمان الصواف الكندي عن يحيى القطان عن مسدد بن مسرهد","باب اجتناب الشبهات"
"1713","[7/337]      21 - بَابُ بَيْعِ  الْمُضْطَرِّ  1422  -  أَبُو يَعْلَى :  حَدَّثَنَا  رَوْحُ بْنُ حَاتِمٍ ،  ثَنَا  هُشَيْمٌ ،  عَنِ  الْكَوْثَرِ بْنِ حَكِيمٍ ،  عَنْ  مَكْحُولٍ ، قَالَ :  بَلَغَنِي عَنْ  حُذَيْفَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَا إِنَّ زَمَانَكُمْ هَذَا زَمَانٌ عَضُوضٌ  ، يَعَضُّ الْمُؤْمِنُ عَلَى مَا فِي يَدِهِ حَذَارَ الْإِنْفَاقِ . قَالَ اللهُ - عَزَّ وَجَلَّ - :         {      وَمَا أَنْفَقْتُمْ مِنْ شَيْءٍ فَهُوَ يُخْلِفُهُ وَهُوَ خَيْرُ الرَّازِقِينَ         }      . قَالَ - وَشَهِدَ شِرَارَ النَّاسِ يُبَايِعُونَ كُلَّ  مُضْطَرٍّ  : أَلَا إِنَّ بَيْعَ  الْمُضْطَرِّينَ  حَرَامٌ ، إِنَّ بَيْعَ  الْمُضْطَرِّينَ  حَرَامٌ ، الْمُسْلِمُ أَخُو الْمُسْلِمِ ، لَا يَظْلِمُهُ ، وَلَا  يَخْذُلُهُ  ، إِنْ كَانَ عِنْدَكَ مَعْرُوفٌ فَعُدْ بِهِ عَلَى أَخِيكَ ، وَإِلَّا فَلَا تَزِدْهُ هَلَاكًا عَلَى هَلَاكِهِ  .  الْكَوْثَرُ  مَتْرُوكٌ  ،  وَمَكْحُولٌ  عَنْ  حُذَيْفَةَ  - رَضِيَ اللهُ عَنْهُ -  مُنْقَطِعٌ  .","","Al-Matalib al-Aliyah 1422","","حذيفة بن اليمان عن مكحول بن أبي مسلم عن كوثر بن حكيم الحلبي عن هشيم بن بشير عن روح بن حاتم البصري عن أبو يعلى الموصلي","باب بيع المضطر"
"1714","[7/338]      1423  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو الْأَشْعَثِ أَحْمَدُ بْنُ الْمِقْدَامِ الْعِجْلِيُّ ،  ثَنَا  عُبَيْدُ بْنُ الْقَاسِمِ ،  ثَنَا  الْعَلَاءُ بْنُ ثَعْلَبَةَ ،  عَنْ  أَبِي الْمَلِيحِ الْهُذَلِيِّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ - رَضِيَ اللهُ عَنْهُ - قَالَ :  تَرَاءَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمَسْجِدِ الْخَيْفِ  ، فَقَالَ لِي أَصْحَابُهُ : إِلَيْكَ يَا  وَاثِلَةُ  ، أَيْ : تَنَحَّ عَنْ وَجْهِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : دَعُوهُ ، إِنَّمَا جَاءَ لِيَسْأَلَ قَالَ : فَدَنَوْتُ ، فَقُلْتُ : بِأَبِي أَنْتَ وَأُمِّي يَا رَسُولَ اللهِ ، لِتُفْتِنَا عَنْ أَمْرٍ نَأْخُذُهُ عَنْكَ مِنْ بَعْدِكَ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : فَلْيُفْتِكَ نَفْسُكَ قَالَ : قُلْتُ : وَكَيْفَ لِي بِذَلِكَ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  دَعْ مَا  يَرِيبُكَ  إِلَى مَا لَا  يَرِيبُكَ  ، وَإِنْ أَفْتَاكَ الْمُفْتُونَ  ، قُلْتُ : وَكَيْفَ لِي بِذَلِكَ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ضَعْ يَدَكَ عَلَى فُؤَادِكَ ، فَإِنَّ الْقَلْبَ يَسْكُنُ لِلْحَلَالِ وَلَا يَسْكُنُ لِلْحَرَامِ ، وَإِنَّ  وَرَعَ  الْمُسْلِمِ يَدَعُ الصَّغِيرَ مَخَافَةَ أَنْ يَقَعَ فِي الْكَبِيرِ ، قُلْتُ : بِأَبِي وَأُمِّي ، فَمَنِ الْحَرِيصُ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : الَّذِي يَطْلُبُ الْمَكْسَبَةَ مِنْ غَيْرِ حِلِّهَا ، قُلْتُ : فَمَنِ الْوَرِعُ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : الَّذِي يَقِفُ عِنْدَ الشُّبْهَةِ ، قُلْتُ : فَمَنِ الْمُؤْمِنُ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَنْ أَمِنَهُ النَّاسُ عَلَى دِمَائِهِمْ ، قُلْتُ : فَمَنِ الْمُسْلِمُ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ ، قُلْتُ : فَأَيُّ  الْجِهَادِ  أَفْضَلُ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : كَلِمَةُ حَقٍّ عِنْدَ إِمَامٍ جَائِرٍ  .","","Al-Matalib al-Aliyah 1423","","واثلة بن الأسقع الليثي عن أبو المليح بن أسامة الهذلي عن العلاء بن ثعلبة عن عبيد بن القاسم الأسدي عن أحمد بن المقدام العجلي عن أبو يعلى الموصلي","باب بيع المضطر"
"1715","[7/339]      22 - بَابُ  الزَّجْرِ  عَنِ الْغِشِّ  1424  -  إِسْحَاقُ :  أَخْبَرَنَا  بِشْرُ بْنُ عُمَرَ الزَّهْرَانِيُّ ،  حَدَّثَنِي  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ أَبِي رَبِيعَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ... فَذَكَرَ حَدِيثَ  السَّلَفِ  ، وَزَادَ : قَالَ أَبِي :  وَمَرَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى حِنْطَةٍ مَطِيرَةٍ رَأْسُهَا حِنْطَةٌ جَافَّةٌ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا حَمَلَكَ عَلَى ذَلِكَ ، أَلَا تَرَكْتَهَا حَتَّى يَشْتَرِيَ إِخْوَانُكَ مَا يَعْرِفُونَ  !  .         [7/340]","","Al-Matalib al-Aliyah 1424","","عبد الله بن أبي ربيعة المخزومي عن إبراهيم بن عبد الرحمن بن عبد الله بن أبى ربيعة ذى الرمحين عن إسماعيل بن إبراهيم بن عبد الرحمن المخزومي عن بشر بن عمر الزهراني عن إسحاق ابن راهويه","باب الزجر عن الغش"
"1716","[7/341]      1425  -  الْحَارِثُ :  حَدَّثَنَا  دَاوُدُ بْنُ الْمُحَبَّرِ ،  ثَنَا  مَيْسَرَةُ بْنُ عَبْدِ رَبِّهِ ،  عَنْ  أَبِي عَائِشَةَ السَّعْدِيِّ ،  عَنْ  يَزِيدَ بْنِ عُمَرَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي هُرَيْرَةَ - رَضِيَ اللهُ عَنْهُ - وَابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرَ الْحَدِيثَ بِطُولِهِ ، وَفِيهِ :  وَمَنْ  غَشَّ  مُسْلِمًا فِي بَيْعٍ أَوْ شِرَاءٍ فَلَيْسَ مِنَّا  ، وَيُحْشَرُ يَوْمَ الْقِيَامَةِ مَعَ الْيَهُودِ ؛ لِأَنَّهُمْ  أَغَشُّ  النَّاسِ لِلْمُسْلِمِينَ  .  هَذَا  حَدِيثٌ مَوْضُوعٌ  .","","Al-Matalib al-Aliyah 1425","","عبد الله بن عباس عن أبو سلمة بن عبد الرحمن عن يزيد بن عمر بن عبد العزيز بن مروان عن أبو عائشة السعدي عن ميسرة بن عبد ربه التراس عن داود بن المحبر البكراوي عن الحارث بن محمد بن أبي أسامة","باب الزجر عن الغش"
"1717","[7/342]      1426  -  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَأَةَ ،  عَنِ  الْحَكَمِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ  غَشَّ  فَلَيْسَ مِنَّا  .  هَذَا  مُرْسَلٌ  ، مَعَ ضَعْفِ  الْحَجَّاجِ  .","","Al-Matalib al-Aliyah 1426","","عبد الرحمن بن أبي ليلى عن الحكم بن عتيبة الكندي عن حجاج بن أرطاة عن حماد بن زيد عن مسدد بن مسرهد","باب الزجر عن الغش"
"1718","[7/343]      1427  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنِي  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُعَاوِيَةُ بْنُ مَيْسَرَةَ بْنِ شُرَيْحٍ ،  حَدَّثَنَا  الْحَكَمُ ،  عَنْ  قَيْسِ بْنِ أَبِي غَرَزَةَ ، قَالَ :  مَرَّ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِرَجُلٍ  يَبِيعُ طَعَامًا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا صَاحِبَ الطَّعَامِ ، أَسْفَلُ الطَّعَامِ مِثْلُ أَعْلَاهُ ؟  قَالَ : نَعَمْ . فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَنْ  غَشَّ  الْمُسْلِمِينَ فَلَيْسَ مِنْهُمْ !  .","","Al-Matalib al-Aliyah 1427","","قيس بن أبي غرزة الغفاري عن الحكم بن عتيبة الكندي عن معاوية بن ميسرة النخعي عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","باب الزجر عن الغش"
"1719","[7/344]      23 - بَابُ آدَابِ الْبَيْعِ  1428  / 1  -  إِسْحَاقُ ،  أَخْبَرَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  ثَنَا  الْمُخْتَارُ - هُوَ ابْنُ قَانِعٍ التَّمَّارُ -  عَنْ  أَبِي مَطَرٍ ، قَالَ :  خَرَجْتُ مِنَ الْمَسْجِدِ ، فَإِذَا رَجُلٌ يُنَادِي خَلْفِي : ارْفَعْ إِزَارَكَ ... فَذَكَرَ الْحَدِيثَ : فَإِذَا هُوَ عَلِيٌّ - رَضِيَ اللهُ عَنْهُ - قَالَ : فَانْتَهَى إِلَى سُوقِ الْإِبِلِ ،  فَقَالَ  : بِيعُوا وَلَا تَحْلِفُوا ، فَإِنَّ الْيَمِينَ تُنْفِقُ السِّلْعَةَ وَتَمْحَقُ الْبَرَكَةَ . ثُمَّ أَتَى صَاحِبَ التَّمْرِ فَإِذَا خَادِمٌ تَبْكِي . قَالَ : مَا شَأْنُكِ ؟ قَالَتْ : بَاعَنِي هَذَا تَمْرًا بِدِرْهَمٍ ، فَأَبَى مَوْلَايَ أَنْ يَقْبَلَهُ ، فَقَالَ : خُذْهُ وَأَعْطِهَا دِرْهَمَهَا ، فَإِنَّهُ لَيْسَ لَهَا أَمْرٌ . فَكَأَنَّهُ أَبَى ، فَقُلْتُ : أَلَا تَدْرِي مَنْ هَذَا ؟ قَالَ : لَا . قُلْتُ : هَذَا  عَلِيٌّ  أَمِيرُ الْمُؤْمِنِينَ ! فَصَبَّتْ تَمْرَهُ ، وَأَعْطَاهَا دِرْهَمَهَا . ثُمَّ مَرَّ - رَضِيَ اللهُ عَنْهُ - مُجْتَازًا بِأَصْحَابِ التَّمْرِ ، فَقَالَ :  أَطْعِمُوا الْمِسْكِينَ يَرْبُ كَسْبُكُمْ  .  كذا في طبعة دار العاصمة ، ولعل الصواب : ( نافع )","","Al-Matalib al-Aliyah 1428","","علي بن أبي طالب عن أبو مطر الجهني عن المختار بن نافع العكلي عن محمد بن عبيد بن أبي أمية عن إسحاق ابن راهويه","باب آداب البيع"
"1720","1428  / 2  -  وَقَالَ عَبْدُ بْنُ حُمَيْدٍ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ... فَذَكَرَ مِثْلَهُ ، وَزَادَ فِيهِ بَعْدَ قَوْلِهِ : ( وَأَعْطَاهَا دِرْهَمَهَا ) :  فَإِنِّي أُحِبُّ أَنْ تَرْضَى عَنِّي يَا أَمِيرَ الْمُؤْمِنِينَ . قَالَ - رَضِيَ اللهُ عَنْهُ - : مَا أَرْضَانِي عَنْكَ إِذَا أَوْفَيْتَهُمْ  . وَزَادَ بَعْدَهُ قَوْلَهُ : يَرْبُو كَسْبُكُمْ . ثُمَّ مَرَّ مُجْتَازًا وَمَعَهُ الْمُسْلِمُونَ ، حَتَّى انْتَهَى إِلَى أَصْحَابِ السَّمَكِ ، فَقَالَ : لَا يُبَاعُ فِي سُوقِنَا طَافٍ ، ثُمَّ أَتَى دَارَ بَزَّازٍ - وَهِيَ         [7/345]      سُوقُ الْكَرَابِيسِ - فَأَتَى شَيْخًا ، فَقَالَ : يَا شَيْخُ ، أَحْسِنْ بَيْعِي فِي قَمِيصٍ  ... فَذَكَرَ الْحَدِيثَ ،  وَتَقَدَّمَ فِي بَابِ الْبَيْعِ عَنْ تَرَاضٍ  .","","Al-Matalib al-Aliyah 1428","","علي بن أبي طالب عن أبو مطر الجهني عن المختار بن نافع العكلي عن محمد بن عبيد بن أبي أمية عن عبد بن حميد","باب آداب البيع"
"1721","[7/346]      1429  -  وَقَالَ أَبُو يَعْلَى ،  حَدَّثَنَا  زُهَيْرٌ ،  ثَنَا  مَرْوَانُ الْفَزَارِيُّ ،  ثَنَا  أَبُو بَكْرٍ الْفَضْلُ بْنُ مُبَشِّرٍ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ عَبْدِ اللهِ - رَضِيَ اللهُ عَنْهُمَا - يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ لَا يُحِبُّ  الْفَاحِشَ  الْمُتَفَحِّشَ  ، وَلَا الصَّيَّاحَ فِي الْأَسْوَاقِ !  .","","Al-Matalib al-Aliyah 1429","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الفضل بن مبشر الأنصاري عن مروان بن معاوية الفزاري عن زهير بن حرب عن أبو يعلى الموصلي","باب آداب البيع"
"1722","[7/347]      1430  -  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  يَزِيدَ الْيَشْكُرِيِّ ،  ثَنَا  أَبُو حَازِمٍ ، قَالَ :  إِنَّ  ابْنَ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - مَرَّ عَلَى رَجُلٍ يَبِيعُ غُنَيْمَاتٍ لَهُ  ، فَقَالَ : بِكَمْ تَبِيعُ غَنَمَكَ هَذِهِ ؟ قَالَ : بِكَذَا وَكَذَا ، فَقَالَ  ابْنُ عُمَرَ  - رَضِيَ اللهُ عَنْهُمَا - : أَخَذْتُهَا بِكَذَا وَكَذَا ، فَحَلَفَ أَنْ لَا يَبِيعَهَا ، فَانْطَلَقَ  ابْنُ عُمَرَ  - رَضِيَ اللهُ عَنْهُمَا - يَقْضِي حَاجَتَهُ ، ثُمَّ مَرَّ عَلَيْهِ ، فَقَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، خُذْهَا بِالَّذِي أَعْطَيْتَنِي ، فَقَالَ : حَلَفْتَ عَلَى يَمِينٍ ، فَلَمْ أَكُنْ لِأُعِينَ الشَّيْطَانَ عَلَيْكَ أَنْ أُجِيبَكَ  .  صَحِيحٌ  مَوْقُوفٌ  .","","Al-Matalib al-Aliyah 1430","","عبد الله بن عمر بن الخطاب عن سلمان الأعرج مولى عزة الأشجعية عن يزيد بن كيسان اليشكري عن يحيى القطان عن مسدد بن مسرهد","باب آداب البيع"
"1723","[7/348]      1431  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  الْأَزْرَقُ بْنُ عَلِيٍّ ،  ثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  ثَنَا  بِشْرُ بْنُ الْحُسَيْنِ ،  عَنِ  الزُّبَيْرِ بْنِ عَدِيٍّ ،  عَنْ  أَنَسٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَبْتَاعَنَّ أَحَدُكُمْ عَلَى بَيْعِ أَخِيهِ  ، وَلَا  يَخْطُبْ  عَلَى خِطْبَةِ أَخِيهِ  .","","Al-Matalib al-Aliyah 1431","","أنس بن مالك عن الزبير بن عدي الهمداني عن بشر بن الحسين الأصبهاني عن يحيى بن أبي بكير عن الأزرق بن علي بن مسلم الحنفي عن أبو يعلى الموصلي","باب آداب البيع"
"1724","[7/349]      1432  -  وَقَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  هِشَامٌ - هُوَ ابْنُ سُلَيْمَانَ -  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  مُحَمَّدُ بْنُ مِهْرَانَ ،  أَنَّهُ سَمِعَ  أَبَاهُ  ، يَقُولُ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  حَجَّةِ الْوَدَاعِ  :  يَا مَعْشَرَ التُّجَّارِ ، إِنِّي رَامٍ بَيْنَ  أَكْتَافِكُمْ  : لَا تَلَقَّوُا الرُّكْبَانَ ، وَلَا يَبِعْ  حَاضِرٌ  لِبَادٍ  .","","Al-Matalib al-Aliyah 1432","","مهران عن محمد بن مهران عن ابن جريج عن هشام بن سليمان بن عكرمة عن ابن أبي عمر العدني","باب آداب البيع"
"1725","[7/350]      1433  -  وَقَالَ الطَّيَالِسِيُّ :  حَدَّثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  رَجُلٍ مِنْ  أَهْلِ الْبَصْرَةِ  يُكَنِّيهِ  أَهْلُ الْبَصْرَةِ  أَبَا الْمُوَرِّعِ ، وَيُكَنِّيهِ أَهْلُ الْكُوفَةِ أَبَا مُحَمَّدٍ - وَكَانَ مِنْ  هُذَيْلٍ  -  عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي جِنَازَةٍ ، فَقَالَ :  أَيُّكُمْ يَأْتِي  الْمَدِينَةَ  فَلَا يَدَعُ بِهَا وَثَنًا إِلَّا كَسَرَهُ  ، وَلَا صُورَةً إِلَّا لَطَّخَهَا ، وَلَا قَبْرًا إِلَّا سَوَّاهُ ؟ فَقَامَ  رَجُلٌ  مِنَ  الْقَوْمِ  فَقَالَ : أَنَا يَا رَسُولَ اللهِ ، فَانْطَلَقَ الرَّجُلُ ، فَكَأَنَّهُ هَابَ  الْمَدِينَةَ  فَرَجَعَ ، فَانْطَلَقَ  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُ - ثُمَّ رَجَعَ ، فَقَالَ : مَا أَتَيْتُكَ يَا رَسُولَ اللهِ حَتَّى لَمْ أَدَعْ فِيهَا وَثَنًا إِلَّا كَسَرْتُهُ ، وَلَا قَبْرًا إِلَّا سَوَّيْتُهُ ، وَلَا صُورَةً إِلَّا لَطَّخْتُهَا . فَقَالَ : مَنْ عَادَ لِصَنْعَةِ شَيْءٍ مِنْهَا ... فَقَالَ فِيهِ قَوْلًا شَدِيدًا ، وَقَالَ  لِعَلِيٍّ  : يَا  عَلِيُّ  ، لَا تَكُنْ فَتَّانًا ، وَلَا مُخْتَالًا ، وَلَا تَاجِرًا ، إِلَّا تَاجِرَ خَيْرٍ ، فَإِنَّ أُولَئِكَ الْمَسْبُوقُونَ فِي الْعَمَلِ !  .  فِي صَحِيحِ مُسْلِمٍ طَرَفٌ فِيمَا يَتَعَلَّقُ بِتَسْوِيَةِ الْقُبُورِ ، وَنَحْوِهِ  .         [7/351]","","Al-Matalib al-Aliyah 1433","","علي بن أبي طالب عن أبو محمد ، وقيل عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن أبو داود الطيالسي","باب آداب البيع"
"1726","[7/352]      1434  -  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  ثَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنْ  نُعَيْمِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ :  بَلَغَنِي  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  تِسْعَةُ أَعْشَارِ الرِّزْقِ فِي التِّجَارَةِ  .  وَقَالَ  نُعَيْمٌ  :  كَسْبُ الْعُشْرِ الْبَاقِي فِي  السَّائِمَةِ  -  يَعْنِي الْغَنَمَ  .","","Al-Matalib al-Aliyah 1434","","نعيم بن عبد الرحمن الأزدي عن داود بن أبي هند عن خالد بن عبد الله الطحان عن مسدد بن مسرهد","باب آداب البيع"
"1727","[7/353]      1435  -  حَدَّثَنَا يَحْيَى ،  عَنْ  سُفْيَانَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ جُحَادَةَ ،  عَنْ  ...  عَنْ  أَبِي سَعِيدٍ ، قَالَ :  سَمِعْتُ  عَلِيًّا - رَضِيَ اللهُ عَنْهُ - يَقُولُ :  التَّاجِرُ  فَاجِرٌ ، إِلَّا مَنْ أَخَذَ الْحَقَّ وَأَعْطَاهُ  .         [7/354]","","Al-Matalib al-Aliyah 1435","","علي بن أبي طالب عن الحسن البصري عن محمد بن جحادة الأودي عن سفيان الثوري عن يحيى القطان","باب آداب البيع"
"1728","[7/355]      24 - بَابُ التَّرْهِيبِ مِنْ سُوءِ التَّقَاضِي وَمِنَ الْمَطْلِ  1436 -  الْحَارِثُ  1436  :  حَدَّثَنَا  دَاوُدُ بْنُ الْمُحَبَّرِ ،  ثَنَا  مَيْسَرَةُ بْنُ عَبْدِ رَبِّهِ ،  عَنْ  أَبِي عَائِشَةَ السَّعْدِيِّ ،  عَنْ  يَزِيدَ بْنِ عُمَرَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي هُرَيْرَةَ وَابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمْ - قَالَا :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ... فَذَكَرَ حَدِيثًا طَوِيلًا ، فِيهِ :  وَمَنْ  عَسَّرَ  أَخَاهُ الْمُسْلِمَ نَزَعَ اللهُ مِنْهُ رِزْقَهُ  ، وَأَفْسَدَ عَلَيْهِ مَعِيشَتَهُ ،  وَوَكَلَهُ  إِلَى نَفْسِهِ . وَمَنْ ضَارَّ مُسْلِمًا فَلَيْسَ مِنَّا وَلَسْتُ مِنْهُ فِي الدُّنْيَا وَالْآخِرَةِ ، وَمَنْ مَطَلَ طَالِبَهُ وَهُوَ يَقْدِرُ عَلَى قَضَائِهِ فَعَلَيْهِ خَطِيئَةُ عَشَّارٍ . فَقَامَ إِلَيْهِ  عَوْفُ بْنُ مَالِكٍ الْأَشْجَعِيُّ  ، فَقَالَ : وَمَا خَطِيئَةُ عَشَّارٍ ؟ فَقَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : خَطِيئَةُ الْعَشَّارِ أَنَّ عَلَيْهِ فِي كُلِّ يَوْمٍ لَعْنَةَ اللهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ ، وَمَنْ يَلْعَنِ اللهُ فَلَنْ تَجِدَ لَهُ  نَصِيرًا  .  هَذَا حَدِيثٌ  مَوْضُوعٌ  .","","Al-Matalib al-Aliyah 1436","","عبد الله بن عباس عن أبو سلمة بن عبد الرحمن عن يزيد بن عمر بن عبد العزيز بن مروان عن أبو عائشة السعدي عن ميسرة بن عبد ربه التراس عن داود بن المحبر البكراوي عن الحارث بن محمد بن أبي أسامة","باب الترهيب من سوء التقاضي ومن المطل"
"1729","[7/356]      1437  -  حَدَّثَنَا  الْأَسْوَدُ بْنُ عَامِرٍ شَاذَانُ ،  ثَنَا  أَبُو هِلَالٍ ،  ثَنَا  بِشْرُ بْنُ نُمَيْرٍ ،  عَنِ  الْقَاسِمِ ،  عَنْ  أَبِي أُمَامَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  مَنْ دَايَنَ النَّاسَ بِدَيْنٍ يَعْلَمُ اللهُ تَعَالَى أَنَّهُ يُرِيدُ قَضَاءَهُ  ، فَأَتَاهُ أَجَلُهُ دُونَ ذَلِكَ ، أَرْضَى اللهُ تَعَالَى هَذَا مِنْ حَقِّهِ وَتَجَاوَزَ عَنْهُ . وَمَنْ دَايَنَ النَّاسَ بِدَيْنٍ يَعْلَمُ اللهُ تَعَالَى أَنَّهُ لَا يُرِيدُ قَضَاءَهُ ، أَقَصَّ اللهُ مِنْهُ ، وَقَالَ : حَسِبْتَ أَنِّي لَمْ أَقْتَصَّ لَكَ مِنْهُ  !  .         [7/357]","","Al-Matalib al-Aliyah 1437","","أبو أمامة الباهلي عن القاسم بن عبد الرحمن الدمشقي عن بشر بن نمير عن أبو هلال عن الأسود بن عامر شاذان عن الحارث بن محمد بن أبي أسامة","باب الترهيب من سوء التقاضي ومن المطل"
"1730","[7/358]      1438  -  أَبُو يَعْلَى :  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  ثَنَا  الْوَلِيدُ ،  عَنْ  أَبِي عَبْدِ اللهِ مَوْلَى بَنِي أُمَيَّةَ ،  عَنْ  أَبِي حَازِمٍ ، وَسَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  قَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، عَلَيَّ حَجَّةُ الْإِسْلَامِ ، وَعَلَيَّ دَيْنٌ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اقْضِ دَيْنَكَ  .","","Al-Matalib al-Aliyah 1438","","أبو هريرة الدوسي عن سعيد المقبري عن ناصح مولى بني أمية عن الوليد بن مسلم القرشي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","باب الترهيب من سوء التقاضي ومن المطل"
"1731","[7/359]      25 - بَابُ فَضْلِ الْقَرْضِ  1439  -  أَبُو يَعْلَى :  حَدَّثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  مُعْتَمِرٌ ،  قَرَأْتُ عَلَى  الْفُضَيْلِ أَبِي مُعَاذٍ ،  عَنْ  أَبِي حَرِيزٍ ، أَنَّ إِبْرَاهِيمَ  حَدَّثَهُ  :  أَنَّ الْأَسْوَدَ بْنَ يَزِيدَ كَانَ يَسْتَقْرِضُ مِنْ مَوْلًى  لِلنَّخَعِ  تَاجِرٍ ، فَإِذَا خَرَجَ عَطَاؤُهُ قَضَاهُ ، وَأَنَّهُ خَرَجَ عَطَاؤُهُ ، فَقَالَ لَهُ  الْأَسْوَدُ  : إِنْ شِئْتَ أَخَّرْتَ عَنَّا ، فَإِنَّهُ كَانَ عَلَيْنَا حُقُوقٌ فِي هَذَا الْعَطَاءِ ؟ فَقَالَ التَّاجِرُ : إِنِّي لَسْتُ فَاعِلًا ، فَنَقَدَهُ  الْأَسْوَدُ  خَمْسَمِائَةِ دِرْهَمٍ ، حَتَّى إِذَا قَبَضَهَا التَّاجِرُ ، قَالَ لَهُ : دُونَكَ ، فَخُذْهَا . قَالَ  الْأَسْوَدُ  : قَدْ سَأَلْتُكَ هَذَا فَأَبَيْتَ ؟ فَقَالَ لَهُ التَّاجِرُ : إِنِّي سَمِعْتُكَ تُحَدِّثُنَا ، عَنْ عَبْدِ اللهِ بْنِ مَسْعُودٍ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ :  مَنْ أَقْرَضَ مَرَّتَيْنِ  ، كَانَ لَهُ مِثْلُ أَجْرِ أَحَدِهِمَا لَوْ  تَصَدَّقَ  بِهِ  .  صَحَّحَهُ  ابْنُ حِبَّانَ  ، وَأَخْرَجَهُ عَنْ  أَبِي يَعْلَى  بِهَذَا  الْإِسْنَادِ  .  وَقَدْ أَخْرَجَ  أَحْمَدُ  ،  وَابْنُ مَاجَهْ  مِنْ طَرِيقِ  عَلْقَمَةَ  ، عَنِ  ابْنِ مَسْعُودٍ  - رَضِيَ اللهُ عَنْهُمَا - نَحْوَهُ ، وَفِيهِ قِصَّةٌ  لِعَلْقَمَةَ  أَيْضًا ، وَالسِّيَاقُ مُخْتَلِفٌ ، فَكَأَنَّهُمَا وَاقِعَتَانِ  .         [7/360]             [7/361]","","Al-Matalib al-Aliyah 1439","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن عبد الله بن الحسين السجستاني عن فضيل بن ميسرة عن معتمر بن سليمان عن يحيى بن معين عن أبو يعلى الموصلي","باب فضل القرض"
"1732","[7/362]      26 - بَابُ  الزَّجْرِ  عَنِ الْقَرْضِ إِذَا جَرَّ مَنْفَعَةً  1440  -  الْحَارِثُ :  حَدَّثَنَا  حَفْصُ بْنُ حَمْزَةَ ،  أَنَا  سَوَّارُ بْنُ مُصْعَبٍ ،  عَنْ  عُمَارَةَ الْهَمْدَانِيِّ ، قَالَ :  سَمِعْتُ  عَلِيًّا - رَضِيَ اللهُ عَنْهُ - يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كُلُّ قَرْضٍ جَرَّ مَنْفَعَةً فَهُوَ رِبًا  .         [7/363]","","Al-Matalib al-Aliyah 1440","","علي بن أبي طالب عن عمارة الهمداني عن سوار بن مصعب المؤذن عن حفص بن حمزة البغدادي عن الحارث بن محمد بن أبي أسامة","باب الزجر عن القرض إذا جر منفعة"
"1733","[7/364]      27 - بَابُ الرُّخْصَةِ فِي الْحَطِيطَةِ مِنَ الدَّيْنِ إِذَا أَرَادَ تَعْجِيلَ الْمُؤَجَّلِ  1441  -  ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  هِشَامٌ هُوَ ابْنُ سُلَيْمَانَ -  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  مُحَمَّدُ بْنُ عَلِيِّ بْنِ يَزِيدَ بْنِ رُكَانَةَ ، أَنَّ مُحَمَّدَ بْنَ عُمَرَ بْنِ عَلِيٍّ  أَخْبَرَهُ  :  أَنَّ الْيَهُودَ حِينَ أَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِإِجْلَائِهِمْ  ، قَالُوا : إِنَّ لَنَا دُيُونًا ! قَالَ : فَخُذُوا وَضَعُوا  . قَالَ  ابْنُ جُرَيْجٍ  : وَأُخْبِرْتُ بِمِثْلِ ذَلِكَ عَنْ  دَاوُدَ بْنِ الْحُصَيْنِ  ، عَنْ  أَبِي عَبْدِ اللهِ الْأَشْهَلِيِّ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .         [7/365]","","Al-Matalib al-Aliyah 1441","","محمد بن عمر بن علي بن أبي طالب عن محمد بن علي بن يزيد بن ركانة الحجازي عن ابن جريج عن هشام بن سليمان بن عكرمة عن ابن أبي عمر العدني","باب الرخصة في الحطيطة من الدين إذا أراد تعجيل المؤجل"
"1734","[7/366]      28 - بَابُ الْقَرْضِ وَالتَّرْهِيبِ مِنَ الِاسْتِدَانَةِ وَالتَّرْغِيبِ فِي الصَّبْرِ عَلَى الْمُعْسِرِ  ( 54 ) حَدِيثُ  ابْنِ مَسْعُودٍ  - رَضِيَ اللهُ عَنْهُ - : اشْتَرُوا عَلَى اللهِ تَعَالَى ، وَاسْتَقْرِضُوا عَلَى اللهِ عَزَّ وَجَلَّ - . يَأْتِي إِنْ شَاءَ اللهُ تَعَالَى - فِي بَابِ فَضْلِ  الْجِهَادِ  .         [7/367]             [7/368]      1442  -  وَقَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  كَثِيرِ بْنِ عَبْدِ اللهِ بْنِ عَمْرِو بْنِ عَوْفٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا يُتْرَكُ  مُفْرَحٌ  فِي الْإِسْلَامِ أَوْ قَالَ :  مُفْرَجٌ  .  كَثِيرٌ  ضَعِيفٌ  ، وَالْمُرَادُ :  لَا يُتْرَكُ ذُو دَيْنٍ إِلَّا قُضِيَ ، يُقَالُ : أَفْرَحَهُ الدَّيْنُ ، إِذَا أَثْقَلَهُ ، وَيُرْوَى بِالْجِيمِ أَيْضًا  .","","Al-Matalib al-Aliyah 1442","","عمرو بن عوف بن زيد المزني عن عبد الله بن عمرو بن عوف المزني عن كثير بن عبد الله بن عمرو بن عوف اليشكري عن حفص بن غياث النخعي عن أبو بكر ابن أبي شيبة","باب القرض والترهيب من الاستدانة والترغيب في الصبر على المعسر"
"1735","[7/369]      1443  -  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  شُجَاعُ بْنُ الْوَلِيدِ ،  ثَنَا  الْإِفْرِيقِيُّ ،  عَنْ  جُرَيْجِ بْنِ صُوهِيٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْغَفْلَةُ فِي ثَلَاثَةٍ  فَذَكَرَهَا .  وَغَفْلَةُ الرَّجُلِ عَنْ نَفْسِهِ فِي الدَّيْنِ حَتَّى يَرْكَبَهُ  .","","Al-Matalib al-Aliyah 1443","","عبد الله بن عمرو بن العاص عن حديج بن صومي الحميري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن شجاع بن الوليد السكوني عن أحمد بن منيع البغوي","باب القرض والترهيب من الاستدانة والترغيب في الصبر على المعسر"
"1736","[7/370]      1444  / 1  -  حَدَّثَنَا  الْحَسَنُ بْنُ سَوَّارٍ ،  ثَنَا  لَيْثٌ ،  عَنْ  مُعَاوِيَةَ ،  عَنْ  أَبِي عُتْبَةَ ،  أَنَّهُ سَمِعَ  أَبَا أُمَامَةَ - رَضِيَ اللهُ عَنْهُ -  ذَكَرَ أَنَّ  رَجُلًا  تُوُفِّيَ فِي عَهْدِ رَسُولِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَتَرَكَ دِينَارَيْنِ دَيْنًا عَلَيْهِ ، وَلَيْسَ لَهُ وَفَاءٌ ، فَأَبَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يُصَلِّيَ عَلَيْهِ ، وَقَالَ :  صَلُّوا عَلَى صَاحِبِكُمْ  ! ، فَقَامَ إِلَيْهِ  أَبُو قَتَادَةَ  - رَضِيَ اللهُ عَنْهُ - وَقَالَ : أَنَا أَقْضِي عَنْهُ . فَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَصَلَّى عَلَيْهِ  .","","Al-Matalib al-Aliyah 1444","","أبو أمامة الباهلي عن ضمرة بن حبيب الزبيدي عن معاوية بن صالح بن حدير الحضرمي عن الليث بن سعد عن الحسن بن سوار البغوي عن أحمد بن منيع البغوي","باب القرض والترهيب من الاستدانة والترغيب في الصبر على المعسر"
"1737","1444  / 2  - وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى ،  ثَنَا  ابْنُ وَهْبٍ ،  عَنْ  مُعَاوِيَةَ ، وَلَمْ يُسَمِّ  أَبَا قَتَادَةَ  .         [7/371]","","Al-Matalib al-Aliyah 1444","","أبو أمامة الباهلي عن ضمرة بن حبيب الزبيدي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","باب القرض والترهيب من الاستدانة والترغيب في الصبر على المعسر"
"1738","[7/372]      1445  -  وَقَالَ عَبْدُ بْنُ حُمَيْدٍ :  حَدَّثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ الْوَلِيدِ الْوَصَّافِيُّ ،  حَدَّثَنِي  عَطِيَّةُ ،  عَنْ  أَبِي سَعِيدٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  حَضَرْتُ جِنَازَةً فِيهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا وُضِعَتْ سَأَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَعَلَيْهِ دَيْنٌ ؟  قَالُوا : نَعَمْ .  فَعَدَلَ عَنْهَا ، وَقَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : صَلُّوا عَلَى صَاحِبِكُمْ! ، فَلَمَّا رَآهُ  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُ - قَفَا ، قَالَ : يَا نَبِيَّ اللهِ ، بَرِئَ مِنْ دَيْنِهِ ، أَنَا ضَامِنٌ لِمَا عَلَيْهِ . فَأَقْبَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَصَلَّى عَلَيْهِ ، ثُمَّ انْصَرَفَ ، فَقَالَ : يَا  عَلِيُّ  ، جَزَاكَ اللهُ وَالْإِسْلَامُ خَيْرًا ، فَكَّ اللهُ رِهَانَكَ يَوْمَ الْقِيَامَةِ ، كَمَا فَكَكْتَ رِهَانَ أَخِيكَ الْمُسْلِمِ . لَيْسَ مِنْ عَبْدٍ يَقْضِي عَنْ أَخِيهِ دَيْنَهُ إِلَّا فَكَّ اللهُ رِهَانَهُ يَوْمَ الْقِيَامَةِ . فَقَامَ  رَجُلٌ مِنَ الْأَنْصَارِ  ، فَقَالَ : يَا رَسُولَ اللهِ ،  أَلِعَلِيٍّ  خَاصَّةً ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَا ، بَلْ لِعَامَّةِ الْمُسْلِمِينَ  .","","Al-Matalib al-Aliyah 1445","","أبو سعيد الخدري عن عطية بن سعد العوفي عن عبيد الله بن الوليد الوصافي عن الفضل بن دكين عن عبد بن حميد","باب القرض والترهيب من الاستدانة والترغيب في الصبر على المعسر"
"1739","[7/373]      1446  -  وَقَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنْ  صَدَقَةَ بْنِ عِيسَى ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ - رَضِيَ اللهُ عَنْهُ - يَقُولُ :  أُتِيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِرَجُلٍ  يُصَلِّي عَلَيْهِ ، فَقَالَ : عَلَيْهِ دَيْنٌ ؟ قَالُوا : نَعَمْ . قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنْ ضَمِنْتُمْ دَيْنَهُ ، صَلَّيْتُ عَلَيْهِ  .","","Al-Matalib al-Aliyah 1446","","أنس بن مالك عن عيسى بن صدقة الحنفي عن عبيد الله بن موسى عن أبو بكر ابن أبي شيبة","باب القرض والترهيب من الاستدانة والترغيب في الصبر على المعسر"
"1740","[7/374]      1447  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  سَعِيدُ بْنُ أَبِي الرَّبِيعِ ،  ثَنَا  عِيسَى بْنُ صَدَقَةَ بْنِ عَبَّادٍ الْيَشْكُرِيُّ ، قَالَ : دَخَلْتُ مَعَ أَبِي عَلَى أَنَسِ بْنِ مَالِكٍ - رَضِيَ اللهُ عَنْهُ - فَقُلْنَا لَهُ : حَدِّثْنَا حَدِيثًا يَنْفَعُنَا اللهُ تَعَالَى بِهِ ،  فَسَمِعْتُهُ  يَقُولُ :  مَنِ اسْتَطَاعَ مِنْكُمْ أَنْ يَمُوتَ وَلَا دَيْنَ عَلَيْهِ فَلْيَفْعَلْ ، فَإِنِّي رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأُتِيَ بِجِنَازَةِ  رَجُلٍ  ، وَعَلَيْهِ دَيْنٌ ، فَقَالَ :  لَا أُصَلِّي عَلَيْهِ حَتَّى تَضْمَنُوا دَيْنَهُ  ، فَإِنَّ صَلَاتِي عَلَيْهِ تَنْفَعُهُ . فَلَمْ يَضْمَنُوا دَيْنَهُ ، وَلَمْ يُصَلِّ عَلَيْهِ ، وَقَالَ : إِنَّهُ مُرْتَهَنٌ فِي قَبْرِهِ  .         [7/375]","","Al-Matalib al-Aliyah 1447","","أنس بن مالك عن عيسى بن صدقة الحنفي عن سعيد بن أبى الربيع السمان عن أبو يعلى الموصلي","باب القرض والترهيب من الاستدانة والترغيب في الصبر على المعسر"
"1741","[7/376]      1448  -  وَقَالَ :  حَدَّثَنَا  عَمَّارٌ ،  ثَنَا  يُوسُفُ - هُوَ ابْنُ عَطِيَّةَ -  ثَنَا  ثَابِتٌ ،  عَنْ  أَنَسٍ - رَضِيَ اللهُ عَنْهُ قَالَ :  إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أُتِيَ بِجِنَازَةٍ لِيُصَلِّيَ عَلَيْهَا ، قَالَ : هَلْ عَلَيْهِ دَيْنٌ ؟ قَالُوا : نَعَمْ . قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : فَإِنَّ  جِبْرِيلَ  - عَلَيْهِ الصَّلَاةُ وَالسَّلَامُ - نَهَانِي أَنْ أُصَلِّيَ عَلَى مَنْ عَلَيْهِ دَيْنٌ . ثُمَّ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ صَاحِبَ الدَّيْنِ مُرْتَهَنٌ فِي قَبْرِهِ حَتَّى يُقْضَى عَنْهُ  .","","Al-Matalib al-Aliyah 1448","","أنس بن مالك عن ثابت البناني عن يوسف بن عطية بن ثابت الصفار عن عمار بن نصر الخراساني عن أبو يعلى الموصلي","باب القرض والترهيب من الاستدانة والترغيب في الصبر على المعسر"
"1742","[7/377]      1449  -  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  دَاوُدُ بْنُ الْمُحَبَّرِ ،  ثَنَا  مَيْسَرَةُ بْنُ عَبْدِ رَبِّهِ ،  عَنْ  أَبِي عَائِشَةَ السَّعْدِيِّ ،  عَنْ  يَزِيدَ بْنِ عُمَرَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي هُرَيْرَةَ وَابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمْ - قَالَ :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ....فَذَكَرَ حَدِيثًا طَوِيلًا ، وَفِيهِ :  وَمَنْ أَقْرَضَ  مَلْهُوفًا  ، فَأَحْسَنَ طَلَبَهُ  ، فَلْيَسْتَأْنِفِ الْعَمَلَ ، وَلَهُ عِنْدَ اللهِ تَعَالَى بِكُلِّ دِرْهَمٍ أَلْفُ قِنْطَارٍ لَهُ فِي الْجَنَّةِ . وَمَنْ أَقْرَضَ أَخَاهُ الْمُسْلِمَ فَلَهُ بِكُلِّ دِرْهَمٍ وَزْنُ  جَبَلِ أُحُدٍ  ،  وَحِرَاءٍ  ،  وَطُورِ سَيْنَاءَ ،  حَسَنَاتٍ ، فَإِنْ رَفَقَ بِهِ فِي طَلَبِهِ بَعْدَ حِلِّهِ ، جَرَى عَلَيْهِ بِكُلِّ يَوْمٍ صَدَقَةٌ ، وَجَازَ عَلَى الصِّرَاطِ كَالْبَرْقِ اللَّامِعِ ، لَا حِسَابَ عَلَيْهِ وَلَا عَذَابَ ، وَمَنِ احْتَاجَ إِلَيْهِ أَخُوهُ الْمُسْلِمُ فِي قَرْضٍ فَلَمْ يُقْرِضْهُ وَهُوَ عِنْدَهُ حَرَّمَ اللهُ عَلَيْهِ الْجَنَّةَ يَوْمَ يَجْزِي الْمُحْسِنِينَ  .","","Al-Matalib al-Aliyah 1449","","عبد الله بن عباس عن أبو سلمة بن عبد الرحمن عن يزيد بن عمر بن عبد العزيز بن مروان عن أبو عائشة السعدي عن ميسرة بن عبد ربه التراس عن داود بن المحبر البكراوي عن الحارث بن محمد بن أبي أسامة","باب القرض والترهيب من الاستدانة والترغيب في الصبر على المعسر"
"1743","[7/378]      1450  -  وَقَالَ عَبْدُ بْنُ حُمَيْدٍ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مَسْلَمَةَ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنِ  الْعَلَاءِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي كَثِيرٍ ، قَالَ :  إِنَّ  سَعْدَ بْنَ أَبِي وَقَّاصٍ - رَضِيَ اللهُ عَنْهُ - جَاءَ يَتَقَاضَى دَيْنًا لَهُ عَلَى رَجُلٍ ، فَقَالُوا : قَدْ خَرَجَ . قَالَ : فَأَشْهَدُ أَنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَوْ أَنَّ رَجُلًا قُتِلَ فِي  سَبِيلِ  اللهِ تَعَالَى  ، ثُمَّ أُحْيِيَ ثُمَّ قُتِلَ ثُمَّ أُحْيِيَ ثُمَّ قُتِلَ لَمْ يَدْخُلِ الْجَنَّةَ حَتَّى يُقْضَى دَيْنُهُ  .","","Al-Matalib al-Aliyah 1450","","سعد بن أبي وقاص عن أبو كثير الجحشى عن العلاء بن عبد الرحمن الحرقي عن عبد العزيز بن محمد الدراوردي عن عبد الله بن مسلمة القعنبي عن عبد بن حميد","باب القرض والترهيب من الاستدانة والترغيب في الصبر على المعسر"
"1744","[7/379]      1451  -  وَقَالَ أَحْمَدُ بْنُ مَنِيعٍ :  حَدَّثَنَا  عَبِيدَةُ بْنُ حُمَيْدٍ ،  ثَنَا  أَبُو مَرْيَمَ ،  عَنْ  أَبِي جَعْفَرٍ ،  عَنْ  رَجُلٍ مِنَ الْأَنْصَارِ - وَكَانَ بَدْرِيًّا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَحَبَّ  أَنْ يَسْتَظِلَّ أَوْ يُظِلَّهُ اللهُ  مِنْ  فَيْحِ  جَهَنَّمَ  أَوْ مِنْ حَرِّ  جَهَنَّمَ  ؟  فَقَالَ  الْقَوْمُ  كُلُّهُمْ : نَحْنُ يَا رَسُولَ اللهِ ! قَالَ : مَنْ أَنْظَرَ مُعْسِرًا أَوْ  وَضَعَ  عَنْ غَرِيمِهِ  .","","Al-Matalib al-Aliyah 1451","","أحد الصحابة عن أبو جعفر عن أبو مريم عن عبيدة بن حميد بن صهيب التيمي عن أحمد بن منيع البغوي","باب القرض والترهيب من الاستدانة والترغيب في الصبر على المعسر"
"1745","[7/380]      29 - بَابٌ : لِصَاحِبِ الْحَقِّ مَقَالٌ وَفَضْلُ مَنْ أَدَّى دَيْنَهُ  1452  / 1  -  قَالَ إِسْحَاقُ :  أَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اشْتَرَى مِنْ  أَعْرَابِيٍّ  جَزُورًا أَوْ نَاقَةً  بِوَسْقِ تَمْرٍ  عَجْوَةٍ  ، وَلَيْسَ عِنْدَهُ ، فَأَتَاهُ الْأَعْرَابِيُّ يَتَقَاضَاهُ فَأَخَّرَهُ ، فَصَاحَ الْأَعْرَابِيُّ : وَاغَدْرَاهُ وَاغَدْرَاهُ ، فَنَهَرَهُ أَصْحَابُ  مُحَمَّدٍ  ، فَقَالَ : دَعُوهُ ، فَإِنَّ لِصَاحِبِ الْحَقِّ مَقَالًا . فَعَلَ ذَلِكَ مَرَّتَيْنِ أَوْ ثَلَاثًا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : انْطَلِقُوا بِهِ إِلَى  خَوْلَةَ بِنْتِ حَكِيمٍ  - وَكَانَتْ مِنَ  الْمُهَاجِرَاتِ  الْأُوَلِ -  اسْتَسْلِفْهَا  ، فَإِنَّهَا تَجْمَعُ  الْعَجْوَةَ  . فَأَتَوْهَا ، فَأَوْفَتْهُ ، فَرَجَعَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : قَدْ أَوْفَيْتَ وَأَطْيَبْتَ ، فَقَالَ : أَوَلَيْسَ أُولَاكُمْ خِيَارُكُمْ عِنْدَ اللهِ ، إِنَّ خِيَارَ الْخَلْقِ عِنْدَ اللهِ الْمُوفُونَ الْمُطَيِّبُونَ  .","","Al-Matalib al-Aliyah 1452","","عروة بن الزبير عن هشام بن عروة بن الزبير عن عبدة بن سليمان الكلابي عن إسحاق ابن راهويه","باب لصاحب الحق مقال وفضل من أدى دينه"
"1746","1452  / 2  -  أَخْبَرَنَا  وَكِيعٌ ،  ثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  اسْتَسْلَفَ  مِنْ  أَعْرَابِيٍّ  بَعِيرًا  ، فَذَكَرَ نَحْوَهُ ، وَقَالَ فِيهِ : فَانْتَهَرَهُ أَصْحَابُ  مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَلَمْ يَذْكُرْ : مِنَ الْمُهَاجِرَاتِ .         [7/381]","","Al-Matalib al-Aliyah 1452","","عروة بن الزبير عن هشام بن عروة بن الزبير عن وكيع بن الجراح عن إسحاق ابن راهويه","باب لصاحب الحق مقال وفضل من أدى دينه"
"1747","[7/382]      1453  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  عَبْدُ الْغَفَّارِ ،  عَنْ  عَلِيٍّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي دَاوُدَ ،  عَنْ  بُرَيْدَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَنْظَرَ مُعْسِرًا كَانَ لَهُ بِكُلِّ يَوْمٍ صَدَقَةٌ  ، ثُمَّ قَالَ بَعْدَ ذَلِكَ : مَنْ أَنْظَرَ مُعْسِرًا كَانَ لَهُ بِكُلِّ يَوْمٍ مِثْلُ الَّذِي أَنْظَرَهُ .  قَالَ  بُرَيْدَةُ  - رَضِيَ اللهُ عَنْهُ - : فَقُلْتُ : يَا رَسُولَ اللهِ ، مَا هَذَا ؟ قَالَ : أَنْ يُؤْتَى بِكُلِّ يَوْمٍ صَدَقَةً قَبْلَ الْأَجَلِ ، وَيُؤْتَى بِكُلِّ يَوْمٍ مِثْلَ الَّذِي أَنْظَرَهُ صَدَقَةً بَعْدَ الْأَجَلِ  .         [7/383]","","Al-Matalib al-Aliyah 1453","","بريدة بن الحصيب الأسلمي عن نفيع بن الحارث الأعمى عن الأعمش عن علي بن مسهر القرشي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","باب لصاحب الحق مقال وفضل من أدى دينه"
"1748","[7/384]      1454  -  وَقَالَ عَبْدُ بْنُ حُمَيْدٍ :  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  ثَنَا  يُوسُفُ بْنُ صُهَيْبٍ ،  عَنْ  زَيْدٍ الْعَمِّيِّ ،  عَنِ  ابْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَحَبَّ أَنْ يُسْتَجَابَ دَعْوَتُهُ  فَلْيُفَرِّجْ عَنْ مُعْسِرٍ  .","","Al-Matalib al-Aliyah 1454","","عبد الله بن عمر بن الخطاب عن زيد بن الحواري العمي عن يوسف بن صهيب الكندي عن محمد بن عبيد بن أبي أمية عن عبد بن حميد","باب لصاحب الحق مقال وفضل من أدى دينه"
"1749","[7/385]      1455  -  وَقَالَ الطَّيَالِسِيُّ :  حَدَّثَنَا  جَعْفَرُ بْنُ الزُّبَيْرِ ،  عَنِ  الْقَاسِمِ مَوْلَى يَزِيدَ ،  عَنْ  أَبِي أُمَامَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  انْطُلِقَ بِرَجُلٍ إِلَى بَابِ الْجَنَّةِ ، فَرَفَعَ رَأْسَهُ  ، فَإِذَا عَلَى بَابِ الْجَنَّةِ مَكْتُوبٌ : الصَّدَقَةُ بِعَشْرِ أَمْثَالِهَا ، وَالْقَرْضُ الْوَاحِدُ بِثَمَانِيَةَ عَشَرَ ; لِأَنَّ صَاحِبَ الْقَرْضِ لَا يَأْتِيكَ إِلَّا وَهُوَ مُحْتَاجٌ ، وَإِنَّ الصَّدَقَةَ رُبَّمَا وَقَعَتْ فِي يَدِ الْغَنِيِّ  .","","Al-Matalib al-Aliyah 1455","","أبو أمامة الباهلي عن القاسم بن عبد الرحمن الدمشقي عن جعفر بن الزبير الباهلي عن أبو داود الطيالسي","باب لصاحب الحق مقال وفضل من أدى دينه"
"1750","[7/386]      1456  -  وَقَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  زَمْعَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  ابْنِ كَعْبِ بْنِ مَالِكٍ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّ بِهِ وَهُوَ مُلَازِمٌ  رَجُلًا  فِي أُوقِيَّتَيْنِ  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - هَكَذَا  ،  أَيْ : ضَعْ عَنْهُ  الشَّطْرَ  . الْحَدِيثَ  .  قُلْتُ :  هُوَ فِي الصَّحِيحِ دُونَ قَوْلِهِ : أُوقِيَّتَيْنِ  .","","Al-Matalib al-Aliyah 1456","","كعب بن مالك الأنصاري عن عبد الله بن كعب بن مالك عن الزهري عن زمعة بن صالح الجندي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة","باب لصاحب الحق مقال وفضل من أدى دينه"
"1751","[7/387]      30 - بَابُ اسْتِحْقَاقِ الْبَائِعِ مَالَ الْعَبْدِ دُونَ مُشْتَرِيهِ  1457  -  إِسْحَاقُ :  أَخْبَرَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ الْمَدَنِيُّ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  ... عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  مَنْ بَاعَ عَبْدًا وَلَهُ مَالٌ ، فَمَالُهُ لِلْبَائِعِ  ، إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ ، وَمَنْ بَاعَ نَخْلًا قَدْ  أُبِّرَتْ  فَثَمَرَتُهَا  لِلْبَائِعِ ، إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ . قَضَى بِذَلِكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .         [7/388]","","Al-Matalib al-Aliyah 1457","","علي بن أبي طالب عن أبو جعفر الباقر عن جعفر الصادق عن حاتم بن إسماعيل الحارثي عن إسحاق ابن راهويه","باب استحقاق البائع مال العبد دون مشتريه"
"1752","[7/389]      31 - بَابُ الْعَارِيَةِ  1458  -  ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  هِشَامٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  أَبُو الْعَبَّاسِ ،  عَنْ  رَجُلٍ مِنَ الْأَنْصَارِ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الْعَارِيَةُ مَرْدُودَةٌ ،  وَالْمِنْحَةُ  مَرْدُودَةٌ  .         [7/390]","","Al-Matalib al-Aliyah 1458","","أحد الصحابة عن يحيى بن أيوب الغافقي عن ابن جريج عن هشام بن سليمان بن عكرمة عن ابن أبي عمر العدني","باب العارية"
"1753","[7/391]      32 - بَابُ  الْقِرَاضِ  1459  -  أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو الْحَكَمِ مِسْجَعُ بْنُ مُصْعَبٍ ،  ثَنَا  يُونُسُ بْنُ أَرْقَمَ ،  ثَنَا  أَبُو الْجَارُودِ ،  عَنْ  حَبِيبِ بْنِ يَسَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  كَانَ  الْعَبَّاسُ بْنُ عَبْدِ الْمُطَّلِبِ  - رَضِيَ اللهُ عَنْهُ - إِذَا دَفَعَ مَالًا  مُضَارَبَةً  اشْتَرَطَ عَلَى صَاحِبِهِ  أَلَّا يَسِيرَ بَرًّا وَلَا بَحْرًا ، وَلَا يَنْزِلَ بِهِ وَادِيًا ، وَلَا يَشْتَرِيَ بِهِ ذَاتَ كَبِدٍ رَطْبَةٍ ، فَإِذَا فَعَلَ ذَلِكَ فَهُوَ ضَامِنٌ ، فَرَفَعَ شَرْطَهُ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَجَازَهُ  .         [7/392]","","Al-Matalib al-Aliyah 1459","","عبد الله بن عباس عن حبيب بن يسار الكندي عن زياد بن المنذر الهمداني عن يونس بن أرقم الكندي عن مسجع بن مصعب البصري عن أبو يعلى الموصلي","باب القراض"
"1754","[7/393]      33 - بَابُ التَّفْلِيسِ  1460  -  قَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  هِشَامٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  عَبْدُ اللهِ بْنُ كَثِيرٍ ،  عَنْ  عَدِيِّ بْنِ عَدِيٍّ ، قَالَ :  إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَضَى فِي  إِنْسَانٍ  لَمْ يُوجَدْ لَهُ وَفَاءٌ  ، وَوَجَدَ بَعْضُ غُرَمَائِهِ سُلْفَتَهُ وَافِرَةً عِنْدَهُ ، فَقَضَى بِأَنَّهُ يَأْخُذُ مَتَاعَهُ إِنْ وَجَدَهُ  .","","Al-Matalib al-Aliyah 1460","","عدي بن عدي بن عميرة الجزري عن عبد الله بن كثير بن المطلب السهمي عن ابن جريج عن هشام بن سليمان بن عكرمة عن ابن أبي عمر العدني","باب التفليس"
"1755","[7/394]      1461  / 1  -  وَقَالَ إِسْحَاقُ :  أَخْبَرَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ كَعْبِ بْنِ مَالِكٍ ، قَالَ :  كَانَ  مُعَاذُ بْنُ جَبَلٍ  - رَضِيَ اللهُ عَنْهُ - رَجُلًا سَمْحًا شَابًّا جَمِيلًا ، مِنْ أَفْضَلِ شَبَابِ قَوْمِهِ  ، وَكَانَ لَا يُمْسِكُ شَيْئًا ، فَلَمْ يَزَلْ يَدَّانُ حَتَّى أَغْلَقَ مَالَهُ كُلَّهُ فِي الدَّيْنِ ، فَأَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَطَلَبَ إِلَيْهِ أَنْ يَسْأَلَ غُرَمَاءَهُ أَنْ يَضَعُوا لَهُ ، فَأَبَوْا - فَلَوْ تَرَكُوا لِأَحَدٍ مِنْ أَجْلِ أَحَدٍ تَرَكُوا  لِمُعَاذٍ  - رَضِيَ اللهُ عَنْهُ - مِنْ أَجْلِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَبَاعَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَالَهُ كُلَّهُ فِي دَيْنِهِ ، حَتَّى قَامَ  مُعَاذٌ  - رَضِيَ اللهُ عَنْهُ - بِغَيْرِ شَيْءٍ ، حَتَّى إِذَا كَانَ  عَامُ فَتْحِ مَكَّةَ  بَعَثَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى طَائِفَةٍ مِنْ  أَهْلِ الْيَمَنِ  أَمِيرًا لِيَجْبُرَهُ ، فَمَكَثَ  مُعَاذٌ  - رَضِيَ اللهُ عَنْهُ -  بِالْيَمَنِ  أَمِيرًا - وَكَانَ أَوَّلَ مَنِ اتَّجَرَ فِي مَالِ اللهِ تَعَالَى هُوَ - فَمَكَثَ حَتَّى أَصَابَ ، وَحَتَّى قُبِضَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا قَدِمَ قَالَ  عُمَرُ  لِأَبِي بَكْرٍ  - رَضِيَ اللهُ عَنْهُمَا - : أَرْسِلْ إِلَى هَذَا الرَّجُلِ فَدَعْ لَهُ مَا يُعَيِّشُهُ ، وَخُذْ سَائِرَهُ ، فَقَالَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - : إِنَّمَا بَعَثَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِيَجْبُرَهُ ، وَلَسْتُ آخِذًا مِنْهُ شَيْئًا إِلَّا أَنْ يُعْطِيَنِي ، فَانْطَلَقَ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - إِلَيْهِ ، إِذْ لَمْ يُطِعْهُ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - فَذَكَرَ ذَلِكَ  عُمَرُ  لِمُعَاذٍ  - رَضِيَ اللهُ عَنْهُمَا - فَقَالَ  مُعَاذٌ  - رَضِيَ اللهُ عَنْهُ - : أَنَا أَرْسَلَنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِيَجْبُرَنِي ، وَلَسْتُ بِفَاعِلٍ ، ثُمَّ لَقِيَ  مُعَاذٌ  عُمَرَ  - رَضِيَ اللهُ عَنْهُمَا - فَقَالَ : قَدْ أَطَعْتُكَ ، وَأَنَا فَاعِلٌ مَا أَمَرْتَنِي ، إِنِّي رَأَيْتُ فِي الْمَنَامِ أَنِّي فِي حَوْمَةِ مَاءٍ ، وَقَدْ خَشِيتُ الْغَرَقَ ، فَخَلَّصْتَنِي مِنْهُ يَا  عُمَرُ  ، فَأَتَى  مُعَاذٌ  أَبَا بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - فَذَكَرَ ذَلِكَ لَهُ ، وَحَلَفَ أَنَّهُ لَمْ يَكْتُمْهُ شَيْئًا ، حَتَّى تَبَيَّنَ لَهُ سَوْطُهُ ، فَقَالَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - : وَاللهِ لَا آخُذُهُ مِنْكَ ، وَقَدْ وَهَبْتُهُ لَكَ . فَقَالَ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - : هَذَا حِينَ طَابَ وَحَلَّ ، فَخَرَجَ  مُعَاذٌ  - رَضِيَ اللهُ عَنْهُ - عِنْدَ ذَلِكَ إِلَى  الشَّامِ  .  هَذَا الْحَدِيثُ  إِسْنَادُهُ صَحِيحٌ  ، وَلَكِنَّهُ  مُرْسَلٌ  ،  وَلَمْ يُخْرِجُوهُ فِي         [7/395]      كُتُبِهِمْ ، بَلْ خَرَّجَ  أَبُو دَاوُدَ  مِنْهُ فِي الْمَرَاسِيلِ الْمُفْرَدِ قِطْعَةً مِنْهُ .  وَقَدْ خَالَفَ  عَبْدَ الرَّزَّاقِ  هِشَامُ بْنُ يُوسُفَ  ، فَرَوَاهُ عَنْ  مَعْمَرٍ  مَوْصُولًا  ، قَالَ : عَنِ  ابْنِ كَعْبٍ  ، عَنْ أَبِيهِ ، وَرَوَاهُ  ابْنُ الْمُبَارَكِ  عَنْ  مَعْمَرٍ  فَأَرْسَلَهُ  .","","Al-Matalib al-Aliyah 1461","","عبد الله بن عبد الرحمن بن كعب بن مالك الأنصاري عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق ابن راهويه","باب التفليس"
"1756","1461  / 2  -  وَقَالَ الْحَارِثُ :  حَدَّثَنَا  إِسْحَاقُ بْنُ عِيسَى بْنِ الطَّبَّاعِ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  أَخْبَرَنِي  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  ابْنِ كَعْبِ بْنِ مَالِكٍ ، قَالَ :  كَانَ  مُعَاذُ بْنُ جَبَلٍ  - رَضِيَ اللهُ عَنْهُ - شَابًّا سَمْحًا  ، أَفْضَلَ فِتْيَانِ قَوْمِهِ ، فَلَمْ يَزَلْ حَتَّى أَغْرَقَ مَالَهُ فِي الدَّيْنِ ، فَكَلَّمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غُرَمَاءَهُ ، فَلَوْ تُرِكَ أَحَدٌ مِنْ أَجْلِ أَحَدٍ لَتُرِكَ  مُعَاذُ بْنُ جَبَلٍ  - رَضِيَ اللهُ عَنْهُ - مِنْ أَجْلِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - . قَالَ : فَبَقِيَ  مُعَاذٌ  - رَضِيَ اللهُ عَنْهُ - وَلَا مَالَ لَهُ  .         [7/396]             [7/397]","","Al-Matalib al-Aliyah 1461","","عبد الرحمن بن كعب بن مالك السلمي عن الزهري عن معمر بن راشد عن عبد الله بن المبارك عن إسحاق بن عيسى بن نجيح عن الحارث بن محمد بن أبي أسامة","باب التفليس"
"1757","[7/398]      34 - بَابُ الصُّلْحِ  1462  -  قَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  عُبَادَةَ بْنِ عَمْرِو بْنِ عُبَادَةَ بْنِ عَوْفٍ ،  عَنْ  أَبِي أَيُّوبَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  قَالَ لِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  أَبَا أَيُّوبَ  ، أَلَا أَدُلُّكَ عَلَى صَدَقَةٍ يُحِبُّهَا اللهُ وَرَسُولُهُ ؟  أَصْلِحْ بَيْنَ النَّاسِ إِذَا تَبَاغَضُوا وَتَفَاسَدُوا !  .","","Al-Matalib al-Aliyah 1462","","أبو أيوب الأنصاري عن عبادة بن عمرو بن عبادة بن عوف عن موسى بن عبيدة بن نشيط الحميري عن عبيد الله بن موسى عن أبو بكر ابن أبي شيبة","باب الصلح"
"1758","[7/399]      1463  -  الْحَارِثُ :  حَدَّثَنَا  دَاوُدُ ،  ثَنَا  مَيْسَرَةُ ،  عَنْ  أَبِي عَائِشَةَ ،  عَنْ  يَزِيدَ بْنِ عُمَرَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ  وَعَنِ  ابْنِ عَبَّاسٍ ، - رَضِيَ اللهُ عَنْهُمْ - قَالَا :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ..فَذَكَرَ الْحَدِيثَ ، وَفِيهِ :  وَمَنْ مَشَى فِي صُلْحٍ بَيْنَ اثْنَيْنِ ، صَلَّتْ عَلَيْهِ الْمَلَائِكَةُ حَتَّى يَرْجِعَ  ، وَأُعْطِيَ أَجْرَ لَيْلَةِ الْقَدْرِ ، وَفِيهِ : وَمَنْ خَانَ جَارَهُ شِبْرًا مِنَ الْأَرْضِ ،  طُوِّقَهُ  يَوْمَ الْقِيَامَةِ إِلَى سَبْعِ أَرَضِينَ نَارًا ، حَتَّى يَدْخُلَ  جَهَنَّمَ  .  هَذَا حَدِيثٌ  مَوْضُوعٌ  .","","Al-Matalib al-Aliyah 1463","","عبد الله بن عباس عن أبو سلمة بن عبد الرحمن عن يزيد بن عمر بن عبد العزيز بن مروان عن أبو عائشة عن ميسرة بن عبد ربه التراس عن داود بن المحبر البكراوي عن الحارث بن محمد بن أبي أسامة","باب الصلح"
"1759","[7/400]      1464  -  مُسَدَّدٌ :  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ ، وَزِيَادِ بْنِ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  حَرِيمُ  قَلِيبِ  الْبِئْرِ  الْعَادِيَّةِ  خَمْسُونَ ذِرَاعًا ، وَحَرِيمُ  قَلِيبِ  الْبَدَى خَمْسَةٌ وَعِشْرُونَ ذِرَاعًا  . قَالَ  سَعِيدٌ  مِنْ قِبَلِ نَفْسِهِ ،  وَلَمْ يَرْفَعْهُ  : وَحَرِيمُ  قَلِيبِ  الزَّرْعِ ثَلَاثُمِائَةِ ذِرَاعٍ .  رَوَاهُ  أَبُو دَاوُدَ  فِي الْمَرَاسِيلِ مِنْ طَرِيقِ  الثَّوْرِيِّ  ، عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ  وَحْدَهُ  .         [7/401]","","Al-Matalib al-Aliyah 1464","","سعيد بن المسيب عن الزهري عن زياد بن سعد الخراساني عن سفيان بن عيينة عن مسدد بن مسرهد","باب الصلح"
"1760","[7/402]      35 - بَابُ الْحَوَالَةِ  1465  -  الْحَارِثُ :  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَطْلُ الْغَنِيِّ ظُلْمٌ  ، وَمَنْ أُحِيلَ عَلَى  مَلِيءٍ  فَلْيَحْتَلْ  .  إِسْمَاعِيلُ  ضَعِيفٌ  . قَالَ  الْبَزَّارُ  :  لَمْ يُتَابَعْ عَلَيْهِ  .         [7/403]","","Al-Matalib al-Aliyah 1465","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن إسماعيل بن زكريا شقوصا عن محمد بن بكار الرصافي عن الحارث بن محمد بن أبي أسامة","باب الحوالة"
"1761","[7/404]      36 - بَابُ الْأَمْرِ بِرَدِّ الْوَدِيعَةِ  1466  -  قَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  ثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  حَدَّثَنِي  صَدَقَةُ بْنُ يَسَارٍ ،  عَنِ  ابْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَيُّهَا النَّاسُ ، مَنْ كَانَتْ عِنْدَهُ وَدِيعَةٌ  فَلْيَرُدَّهَا إِلَى مَنِ ائْتَمَنَهُ عَلَيْهَا  .","","Al-Matalib al-Aliyah 1466","","عبد الله بن عمر بن الخطاب عن صدقة بن يسار الجزري عن موسى بن عبيدة بن نشيط الحميري عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة","باب الأمر برد الوديعة"
"1762","[7/405]      1467  -  قَالَ الْحَارِثُ :  حَدَّثَنَا  دَاوُدُ بْنُ الْمُحَبَّرِ ،  ثَنَا  مَيْسَرَةُ بْنُ عَبْدِ رَبِّهِ ،  عَنْ  أَبِي عَائِشَةَ السَّعْدِيِّ ،  عَنْ  يَزِيدَ بْنِ عُمَرَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي هُرَيْرَةَ وَابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمْ - قَالَا :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ... فَذَكَرَ حَدِيثًا طَوِيلًا ، فِيهِ :  وَمَنْ خَانَ أَمَانَتَهُ فِي الدُّنْيَا  ، وَلَمْ يَرُدَّهَا إِلَى أَرْبَابِهَا ، مَاتَ عَلَى غَيْرِ دِينِ الْإِسْلَامِ ، وَلَقِيَ اللهَ وَهُوَ عَلَيْهِ غَضْبَانُ ، ثُمَّ يُؤْمَرُ بِهِ إِلَى النَّارِ ، فَيَهْوَى مِنْ شَفِيرِهَا أَبَدَ الْآبِدِينَ  .  هَذَا  مَوْضُوعٌ  .","","Al-Matalib al-Aliyah 1467","","عبد الله بن عباس عن أبو سلمة بن عبد الرحمن عن يزيد بن عمر بن عبد العزيز بن مروان عن أبو عائشة السعدي عن ميسرة بن عبد ربه التراس عن داود بن المحبر البكراوي عن الحارث بن محمد بن أبي أسامة","باب الأمر برد الوديعة"
"1763","[7/406]      1468  -  مُسَدَّدٌ :  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  إِنَّ  أَبَا بَكْرٍ - رَضِيَ اللهُ عَنْهُ - أُتِيَ فِي وَدِيعَةٍ ضَاعَتْ  ، فَلَمْ يَضْمَنْهَا  .","","Al-Matalib al-Aliyah 1468","","أبو  بكر الصديق عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حجاج بن أرطاة عن حفص بن غياث النخعي عن مسدد بن مسرهد","باب الأمر برد الوديعة"
"1764","[7/407]      1469  -  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  ثَنَا  حَجَّاجٌ ،  عَنْ  هِلَالِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُكَيْمٍ ، قَالَ :  إِنَّ  عُمَرَ بْنَ الْخَطَّابِ - رَضِيَ اللهُ عَنْهُ - كَانَ لَا يَضْمَنُ الْوَدِيعَةَ  .","","Al-Matalib al-Aliyah 1469","","عمر بن الخطاب عن عبد الله بن عكيم الجهني عن هلال بن عبد الرحمن الحنفي عن حجاج بن أرطاة عن حفص بن غياث النخعي عن مسدد بن مسرهد","باب الأمر برد الوديعة"
"1765","[7/408]      37 - بَابُ الْغَصْبِ  1470  -  قَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  شَرِيكٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أَبِي مَالِكٍ الْأَشْعَرِيِّ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَعْظَمُ الْغُلُولِ عِنْدَ اللهِ تَعَالَى يَوْمَ الْقِيَامَةِ  ذِرَاعُ أَرْضٍ يَسْرِقُهَا الرَّجُلَانِ وَالْجَارَانِ ، يَكُونُ بَيْنَهُمَا ، فَيَسْرِقُ أَحَدُهُمَا مِنْ صَاحِبِهِ ، فَيُطَوَّقُهُ مِنْ سَبْعِ أَرَضِينَ  .         [7/409]","","Al-Matalib al-Aliyah 1470","","أبو مالك الأشعري عن عطاء بن يسار الهلالي عن عبد الله بن محمد بن عقيل بن أبي طالب عن شريك بن عبد الله النخعي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة","باب الغصب"
"1766","[7/410]      1471  -  مُسَدَّدٌ :  حَدَّثَنَا  مُعْتَمِرٌ ،  عَنْ  أَبِيهِ  ،  حَدَّثَنِي  شَيْخٌ ، لَقِيتُهُ  بِالْبَحْرَيْنِ  ، عَنْ خُطْبَةِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  حَجَّةِ الْوَدَاعِ  ، أَنَّهُ قَالَ :  لَا يَحِلُّ مِنْ مَالِ امْرِئٍ  إِلَّا مَا أَعْطَى عَنْ طِيبِ نَفْسٍ  .         [7/411]","","Al-Matalib al-Aliyah 1471","","شيخ عن سليمان بن طرخان عن معتمر بن سليمان عن مسدد بن مسرهد","باب الغصب"
"1767","[7/412]      1472  -  قَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  مُحَمَّدِ بْنِ كُرَيْبٍ ،  عَنْ  كُرَيْبٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَلْعُونٌ مَنِ انْتَقَصَ شَيْئًا مِنْ  تُخُومِ  الْأَرْضِ بِغَيْرِ حَقِّهِ  .","","Al-Matalib al-Aliyah 1472","","عبد الله بن عباس عن كريب بن أبي مسلم الحجازي عن محمد بن كريب بن أبي مسلم الهاشمي عن عبد الرحيم بن سليمان الأشل عن أبو بكر ابن أبي شيبة","باب الغصب"
"1768","[7/413]      1473  -  أَبُو يَعْلَى :  حَدَّثَنَا  عَمْرُو بْنُ الضَّحَّاكِ ،  ثَنَا  أَبِي  ،  ثَنَا  طَالِبُ بْنُ سَلْمٍ ،  حَدَّثَنِي  بَعْضُ أَهْلِي ، قَالَ : إِنَّ جَدِّي عَاصِمَ بْنَ الْحَكَمِ  حَدَّثَهُمْ  :  أَنَّهُ شَهِدَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي خُطْبَتِهِ ، فَقَالَ :  إِنَّ أَمْوَالَكُمْ وَدِمَاءَكُمْ عَلَيْكُمْ حَرَامٌ  ...  الْحَدِيثَ .","","Al-Matalib al-Aliyah 1473","","عاصم بن الحكم عن بعض أهل طالب بن سلم بن عاصم عن طالب بن سلم بن عاصم عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن أبو يعلى الموصلي","باب الغصب"
"1769","[7/414]      1474  -  حَدَّثَنَا  شَبَّابٌ ،  ثَنَا  عَوْنُ بْنُ كَهْمَسٍ ،  عَنْ  عَطِيَّةَ بْنِ سَعْدٍ ،  عَنِ  الْحَكَمِ بْنِ الْحَارِثِ السُّلَمِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ أَخَذَ مِنْ طَرِيقِ الْمُسْلِمِينَ شِبْرًا  جَاءَ بِهِ يَوْمَ الْقِيَامَةِ يَحْمِلُهُ مِنْ سَبْعِ أَرَضِينَ ، قَالَ : وَغَزَوْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَبْعَ غَزَوَاتٍ ، آخِرُهُنَّ  حُنَيْنٌ  ، فَكُنْتُ أَسِيرُ فِي مُقَدِّمَةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَخَلَأَتْ  رَاحِلَتِي ، فَمَرَّ بِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا أَضْرِبُهَا ، فَقَالَ : مَهْ ،  وَزَجَرَهَا  فَقَامَتْ  .         [7/415]","","Al-Matalib al-Aliyah 1474","","الحكم بن الحارث السلمي عن عطية بن سعد الدعاء عن عون بن كهمس التميمي عن خليفة بن خياط عن أبو يعلى الموصلي","باب الغصب"
"1770","[7/416]      1475  -  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  ثَنَا  مُحَمَّدُ بْنُ كُرَيْبٍ ،  عَنْ  كُرَيْبٍ  ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَلْعُونٌ مَنْ ذَبَحَ لِغَيْرِ اللهِ  ، وَمَلْعُونٌ مَنْ لَعَنَهُ اللهُ ، وَمَلْعُونٌ مَنِ انْتَقَصَ شَيْئًا مِنْ  تُخُومِ  الْأَرْضِ بِغَيْرِ حَقِّهِ  .","","Al-Matalib al-Aliyah 1475","","عبد الله بن عباس عن كريب بن أبي مسلم الحجازي عن محمد بن كريب بن أبي مسلم الهاشمي عن عبد الرحيم بن سليمان الأشل عن أبو بكر ابن أبي شيبة","باب الغصب"
"1771","[7/417]      38 - بَابُ اللُّقَطَةِ  1476  -  قَالَ أَبُو بَكْرٍ :  حَدَّثَنِي  أَبُو أُسَامَةَ ،  حَدَّثَنِي  أَبُو فَرْوَةَ ،  حَدَّثَنِي  عُرْوَةُ بْنُ رُوَيْمٍ اللَّخْمِيُّ ،  عَنْ  أَبِي ثَعْلَبَةَ الْخُشَنِيِّ ، قَالَ :  وَلَقِيتُهُ وَكَلَّمْتُهُ ، قَالَ : قُلْتُ : يَا نَبِيَّ اللهِ ، الْوَرِقُ يُوجَدُ عِنْدَ الْقَرْيَةِ الْعَامِرَةِ أَوِ الطَّرِيقِ الْمَأْتِيِّ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عَرِّفْهَا حَوْلًا ، فَإِنْ جَاءَ بَاغِيهَا فَادْفَعْهَا إِلَيْهِ  ، وَإِلَّا فَاحْفَظْ وِعَاءَهَا  وَوِكَاءَهَا  وَعَدَدَهَا ، ثُمَّ اسْتَمْتِعْ بِهَا ، قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، فِي الْوَرِقِ يُوجَدُ فِي الْأَرْضِ  الْعَادِيَّةِ  ؟ قَالَ : فِيهَا  وَالرِّكَازِ  الْخُمُسُ قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، الشَّاةُ تُوجَدُ بِأَرْضِ فَلَاةٍ ؟ قَالَ : كُلْهَا ، فَإِنَّمَا هِيَ لَكَ أَوْ لِأَخِيكَ أَوْ لِلذِّئْبِ قَالَ : قُلْتُ : يَا نَبِيَّ اللهِ ، الْبَعِيرُ أَوِ النَّاقَةُ تُوجَدُ فِي أَرْضِ الْفَلَاةِ ، عَلَيْهَا الْوِعَاءُ وَالسِّقَاءُ ؟ فَقَالَ : دَعْهَا ، مَا لَكَ وَلَهَا ؟  .         [7/418]","","Al-Matalib al-Aliyah 1476","","أبو ثعلبة الخشني عن عروة بن رويم اللخمي عن يزيد بن سنان الرهاوي عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة","باب اللقطة"
"1772","[7/419]      1477  -  وَقَالَ عَبْدُ بْنُ حُمَيْدٍ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ بَكْرٍ السَّهْمِيُّ ،  ثَنَا  فَائِدٌ أَبُو الْوَرْقَاءِ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي أَوْفَى الْأَسْلَمِيِّ - رَضِيَ اللهُ عَنْهُ - قَالَ :  خَرَجْتُ فَإِذَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبُو بَكْرٍ  وَعُمَرُ  - رَضِيَ اللهُ عَنْهُمَا - قُعُودًا ، وَإِذَا غُلَامٌ صَغِيرٌ يَبْكِي ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِعُمَرَ  - رَضِيَ اللهُ عَنْهُ - :  ضُمَّ الصَّبِيَّ إِلَيْكَ ، فَإِنَّهُ ضَالٌّ  ، فَضَمَّهُ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - إِلَيْهِ ... الْحَدِيثَ  .  ( 55 )  وَسَيَأْتِي - إِنْ شَاءَ اللهُ تَعَالَى - بِتَمَامِهِ فِي كِتَابِ الْأَدَبِ  .","","Al-Matalib al-Aliyah 1477","","عبد الله بن أبي أوفى الأسلمي عن فائد بن عبد الرحمن العطار عن عبد الله بن بكر بن حبيب عن عبد بن حميد","باب اللقطة"
"1773","[7/420]      1478  -  وَقَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  سَعْدِ بْنِ أَوْسٍ ،  عَنْ  بِلَالِ بْنِ يَحْيَى الْعَبْسِيِّ ،  عَنْ  عَلِيٍّ - رَضِيَ اللهُ عَنْهُ -  أَنَّهُ الْتَقَطَ دِينَارًا ، فَقَطَعَ مِنْهُ قِيرَاطَيْنِ ، ثُمَّ أَتَى  فَاطِمَةَ  - رَضِيَ اللهُ عَنْهَا - فَقَالَ : اصْنَعِي لَنَا طَعَامًا ، ثُمَّ انْطَلَقَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَدَعَاهُ ، فَأَتَاهُ وَمَنْ مَعَهُ ، فَأَتَاهُمْ بِحَفْنَةٍ ، فَلَمَّا رَآهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْكَرَهَا ، فَقَالَ :  مَا هَذَا ؟ فَأَخْبَرَهُ ، فَقَالَ : أُلْقُطْهُ أُلْقُطْهُ ، عَلَيَّ الْقِيرَاطَانِ  ، ضَعُوا أَيْدِيَكُمْ بِاسْمِ اللهِ  .  هَذَا حَدِيثٌ حَسَنٌ  ، أَخْرَجَ  أَبُو دَاوُدَ  مِنْهُ طَرَفًا قَصِيرًا .","","Al-Matalib al-Aliyah 1478","","علي بن أبي طالب عن بلال بن يحيى العبسي عن سعد بن أوس العبسي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة","باب اللقطة"
"1774","[7/421]      1479  / 1  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  ثَنَا  مُحَمَّدُ بْنُ بَكْرٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  أَبُو بَكْرِ بْنُ عَبْدِ اللهِ بْنِ مُحَمَّدٍ ، قَالَ : إِنَّ شَرِيكَ بْنَ أَبِي نَمِرٍ ،  حَدَّثَهُ  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ  عَلِيًّا  - رَضِيَ اللهُ عَنْهُ - أَتَاهُ بِدِينَارٍ وَجَدَهُ فِي السُّوقِ ، فَقَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عَرِّفْهُ ثَلَاثًا  ، فَعَرَّفَهُ ، فَلَمْ يَجِدْ مَنْ يَعْرِفُهُ ، فَرَجَعَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخْبَرَهُ ، فَقَالَ : كُلْهُ ، أَوْ شَأْنَكَ بِهِ ، فَابْتَاعَ مِنْهُ بِثَلَاثَةِ دَرَاهِمَ شَعِيرًا ، وَبِثَلَاثَةِ دَرَاهِمَ تَمْرًا ، وَابْتَاعَ بِدِرْهَمٍ لَحْمًا ، وَبِدِرْهَمٍ زَيْتًا ، وَفَضَلَ عِنْدَهُ دِرْهَمٌ - وَكَانَ الصَّرْفُ أَحَدَ عَشَرَ بِدِينَارٍ - حَتَّى إِذَا كَانَ بَعْدَ ذَلِكَ جَاءَ صَاحِبُهُ فَعَرَفَهُ ، فَقَالَ لَهُ  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُ - : أَمَرَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرَ ذَلِكَ لَهُ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنْ جَاءَنَا شَيْءٌ أَدَّيْنَاهُ إِلَيْكَ  .  1479  / 2  -  تَابَعَهُ  يَحْيَى بْنُ سَعِيدٍ الْأُمَوِيُّ  ، عَنِ  ابْنِ جُرَيْجٍ  . أَخْرَجَهُ  الْبَزَّارُ  ، وَقَالَ :  أَبُو بَكْرٍ هَذَا عِنْدِي هُوَ ابْنُ أَبِي سَبْرَةَ  ، وَهُوَ  لَيِّنُ الْحَدِيثِ  . قُلْتُ : وَقَدْ ظَنَّ  الْحَافِظُ الضِّيَاءُ  أَنَّهُ غَيْرُهُ ، فَأَخْرَجَ هَذَا الْحَدِيثَ فِي الْمُخْتَارَةِ .         [7/422]","","Al-Matalib al-Aliyah 1479","","أبو سعيد الخدري عن عطاء بن يسار الهلالي عن شريك بن عبد الله بن أبي نمر الكناني عن أبو بكر بن عبد الله بن محمد بن أبي سبرة عن ابن جريج عن محمد بن بكر بن عثمان البرساني عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","باب اللقطة"
"1775","[7/423]      1480  -  وَقَالَ أَبُو يَعْلَى أَيْضًا :  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  حَدَّثَتْنِي  أُمُّ عَبْدِ اللهِ بِنْتُ نَابِلٍ وَاسْمُهَا عُبَيْدَةُ ،  عَنْ  عَائِشَةَ بِنْتِ سَعْدٍ ،  عَنْ  أَبِيهَا سَعْدٍ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  كُنْتُ أَمْشِي مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوَجَدَ ثُفْرُوقَةً فِيهَا تَمْرَتَانِ ، فَأَخَذَ تَمْرَةً وَأَعْطَانِي تَمْرَةً  .","","Al-Matalib al-Aliyah 1480","","سعد بن أبي وقاص عن عائشة بنت سعد بن أبي وقاص عن عبيدة بنت نابل حجازية عن عثمان بن عبد الرحمن الطرائفي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","باب اللقطة"
"1776","[7/424]      1481  -  مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ،  عَنْ  أَبِي حَمْزَةَ الْأَعْرَجِ جَارٍ لَهُ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - يَقُولُ فِي اللُّقَطَةِ :  ادْفَعُوهَا إِلَى السُّلْطَانِ  .","","Al-Matalib al-Aliyah 1481","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن عبد الله المازني عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد","باب اللقطة"
"1777","[7/425]      1482  -  حَدَّثَنَا  الْمُعْتَمِرُ ، قَالَ :  سَمِعْتُ  عُبَيْدَ اللهِ بْنَ عُمَرَ  يُحَدِّثُ عَنْ  أَيُّوبَ بْنِ مُوسَى ،  عَنْ  أَبِيهِ ، أَوْ  عَنْ  رَجُلٍ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ قَالَ لِعُمَرَ بْنِ الْخَطَّابِ - رَضِيَ اللهُ عَنْهُ - : إِنِّي وَجَدْتُ دِينَارًا فَالْتَقَطْتُهُ ، حَتَّى بَلَغْتُ مِائَةَ دِينَارٍ ، قَالَ :  عَرِّفْهَا سَنَةً  . فَعَرَّفَهَا سَنَةً ، ثُمَّ أَتَاهُ ، فَقَالَ : عَرِّفْهَا سَنَةً ، ثُمَّ أَتَاهُ فِي الثَّالِثَةِ ، فَقَالَ : عَرِّفْهَا ، ثُمَّ شَأْنَكَ وَشَأْنَهَا  .","","Al-Matalib al-Aliyah 1482","","عمر بن الخطاب عن أبيه عن رجل عن موسى بن عمرو بن سعيد بن العاص الأشدق عن أيوب بن موسى الأموي عن عبيد الله بن عمر العمري عن معتمر بن سليمان عن مسدد بن مسرهد","باب اللقطة"
"1778","[7/426]      1483  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ بْنِ مَسْمُولٍ ، قَالَ :  سَمِعْتُ  قَاسِمَ بْنَ مُخَوَّلٍ الْبَهْزِيَّ ، قَالَ :  سَمِعْتُ  أَبِي  - وَكَانَ قَدْ أَدْرَكَ الْجَاهِلِيَّةَ وَالْإِسْلَامَ - قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، نَلْقَى الْإِبِلَ وَبِهَا لَبَنٌ ، وَهِيَ  مُصَرَّاةٌ  ، وَنَحْنُ مُحْتَاجُونَ ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  نَادِ صَاحِبَ الْإِبِلِ ثَلَاثًا ، فَإِنْ جَاءَ وَإِلَّا فَاحْلُلْ  صِرَارَهَا  ثُمَّ اشْرَبْ  ، ثُمَّ صُرَّ وَأَبْقِ لِلَّبَنِ ذَوَاعِيَهُ ، قُلْتُ : يَا رَسُولَ اللهِ ، الضَّوَالُّ تَرِدُ عَلَيْنَا ، هَلْ لَنَا أَجْرٌ أَنْ نَسْقِيَهَا ؟ قَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : نَعَمْ ، فِي كُلِّ ذَاتِ كَبِدٍ حَرَّاءَ أَجْرٌ  .         [7/427]","","Al-Matalib al-Aliyah 1483","","مخول بن يزيد البهزي عن القاسم بن مخول البهزى عن محمد بن سليمان المسمولي عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","باب اللقطة"
"1779","[7/428]      39 - بَابُ  الزَّجْرِ  عَنْ كَسْرِ الدِّينَارِ وَالدِّرْهَمِ  1484  -  قَالَ مُسَدَّدٌ :  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  ثَنَا  مَالِكٌ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  قَطْعُ الدِّينَارِ وَالدِّرْهَمِ مِنَ الْفَسَادِ فِي الْأَرْضِ  .","","Al-Matalib al-Aliyah 1484","","سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن مالك بن أنس عن خالد بن عبد الله الطحان عن مسدد بن مسرهد","باب الزجر عن كسر الدينار والدرهم"
"1780","[7/429]      40 - بَابُ الْإِجَارَةِ  1485  -  أَبُو يَعْلَى :  حَدَّثَنَا  إِسْحَاقُ - هُوَ ابْنُ أَبِي إِسْرَائِيلَ -  ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ ،  عَنْ  سُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَعْطُوا الْأَجِيرَ أَجْرَهُ قَبْلَ أَنْ يَجِفَّ رَشْحُهُ  .         [7/430]","","Al-Matalib al-Aliyah 1485","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن عبد الله بن جعفر بن نجيح عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","باب الإجارة"
"1781","[7/431]      41 - بَابُ الْهَدِيَّةِ  1486  -  قَالَ عَبْدُ بْنُ حُمَيْدٍ :  حَدَّثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِنْدَلٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أُهْدِيَتْ لَهُ هَدِيَّةٌ وَعِنْدَهُ قَوْمٌ ، فَهُمْ شُرَكَاؤُهُ فِيهَا  .  عَلَّقَهُ  الْبُخَارِيُّ  .         [7/432]","","Al-Matalib al-Aliyah 1486","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن ابن جريج عن مندل بن علي عن الفضل بن دكين عن عبد بن حميد","باب الهدية"
"1782","[7/433]      1487  -  قَالَ إِسْحَاقُ :  أَخْبَرَنَا  يَحْيَى بْنُ سَعِيدٍ الْعَطَّارُ الْحِمْصِيُّ ،  ثَنَا  يَحْيَى بْنُ الْعَلَاءِ ،  عَنْ  طَلْحَةَ بْنِ عُبَيْدِ اللهِ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَتَتْهُ هَدِيَّةٌ وَعِنْدَهُ قَوْمٌ جُلُوسٌ فَهُمْ شُرَكَاؤُهُ فِيهَا  .","","Al-Matalib al-Aliyah 1487","","الحسن بن علي سبط رسول الله عن طلحة بن عبيد الله بن كريز الخزاعي عن يحيى بن العلاء الفوراردي عن يحيى بن سعيد الأنصاري عن إسحاق ابن راهويه","باب الهدية"
"1783","[7/434]      1488  -  وَقَالَ مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  عَلِيِّ بْنِ الْمُبَارَكِ ،  حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  حَدَّثَنِي  قَيْلَوَيْهِ أَبُو صَالِحٍ ، قَالَ :  كَانَ لِي عَلَى عِلْجٍ عِشْرُونَ دِرْهَمًا ، فَأَهْدَى إِلَيَّ هَدِيَّةً ،  فَسَأَلْتُ  ابْنَ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - فَقَالَ :  احْسُبْ ثَمَنَ الْهَدِيَّةِ وَخُذِ الْبَقِيَّةَ  .         [7/435]","","Al-Matalib al-Aliyah 1488","","عبد الله بن عباس عن قيلويه البصري عن يحيى بن أبي كثير عن علي بن المبارك الهنائي عن يحيى القطان عن مسدد بن مسرهد","باب الهدية"
"1784","[7/436]      1489  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  ثَنَا  الْحَارِثُ ،  عَنْ  سَعِيدِ بْنِ الرَّبِيعِ ،  عَنْ  رَجُلٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَزَاوَرُوا وَتَهَادُوا ، فَإِنَّ الزِّيَارَةَ تُنْبِتُ الْوُدَّ  ، وَإِنَّ الْهَدِيَّةَ تَسُلُّ  السَّخِيمَةَ  .         [7/437]","","Al-Matalib al-Aliyah 1489","","رجل عن سعيد بن الربيع عن الحارث بن عبيد الإيادي عن سليمان بن داود العتكي عن أبو يعلى الموصلي","باب الهدية"
"1785","[7/438]      1490  -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ ،  ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  ثَنَا  حَبَابَةُ بِنْتُ عَجْلَانَ ،  عَنْ  أُمِّهَا أُمِّ حَفْصٍ  ،  عَنْ  صَفِيَّةَ بِنْتِ جَرِيرٍ ،  عَنْ  أُمِّ حَكِيمٍ بِنْتِ وَدَاعٍ الْخُزَاعِيَّةِ - رَضِيَ اللهُ عَنْهَا - قَالَتْ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  تَهَادُوا ، فَإِنَّهُ يُضَعِّفُ الْحُبَّ  ، وَيُذْهِبُ الْغَوَائِلَ  .","","Al-Matalib al-Aliyah 1490","","أم حكيم بنت وداع الخزاعية عن صفية بنت جرير عن حفصة أم حبابة بنت عجلان عن حبابة بنت عجلان البصرية عن موسى بن إسماعيل التبوذكي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","باب الهدية"
"1786","[7/439]      1491  -  حَدَّثَنَا  عُقْبَةُ ،  ثَنَا  يُونُسُ - هُوَ ابْنُ بُكَيْرٍ -  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ - رَضِيَ اللهُ عَنْهَا - قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا أَقْبَلُ هَدِيَّةً مِنْ أَعْرَابِيٍّ  ... الْحَدِيثَ  .         [7/440]","","Al-Matalib al-Aliyah 1491","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن صالح بن كيسان الدوسي عن محمد بن إسحاق عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","باب الهدية"
"1787","[7/441]      1492  -  مُسَدَّدٌ :  حَدَّثَنَا  يَحْيَى ،  عَنْ  مَالِكٍ ،  عَنْ  دَاوُدَ بْنِ الْحُصَيْنِ ،  عَنْ  أَبِي غَطَفَانَ ،  عَنْ  مَرْوَانَ بْنِ الْحَكَمِ ، قَالَ :  قَالَ  عُمَرُ - رَضِيَ اللهُ عَنْهُ - :  مَنْ وَهَبَ هِبَةً لِصِلَةِ رَحِمٍ أَوْ عَلَى وَجْهِ الصَّدَقَةِ ، فَهِيَ جَائِزَةٌ  ، وَمَنْ وَهَبَ هِبَةً يَرَى أَنَّهُ إِنَّمَا أَرَادَ الثَّوَابَ فَهُوَ أَحَقُّ بِهَا إِنْ يُرْضَ مِنْهَا  .         [7/442]","","Al-Matalib al-Aliyah 1492","","عمر بن الخطاب عن مروان بن الحكم بن أبي العاص عن أبو غطفان المري عن داود بن الحصين الأموي عن مالك بن أنس عن يحيى بن يحيى الليثي عن مسدد بن مسرهد","باب الهدية"
"1788","[7/443]      1493  -  حَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  حَدَّثَنِي  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُمَرَ بْنِ الْخَطَّابِ ،  فِي رَجُلٍ وَهَبَ  بَهْمَةً  فَوَلَدَتْ ، فَأَرَادَ أَنْ يَرْجِعَ فِيهَا ، فَقَالَ :  يَرْجِعُ فِي قِيمَتِهَا  .","","Al-Matalib al-Aliyah 1493","","عمر بن الخطاب عن الزهري عن معمر بن راشد عن سفيان الثوري عن يحيى القطان عن مسدد بن مسرهد","باب الهدية"
"1789","[7/444]      1494  -  وَحَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ ،  عَنْ  عُمَرَ بْنِ عَبْدِ الْعَزِيزِ - رَضِيَ اللهُ عَنْهُ -  فِي رَجُلٍ وَهَبَ وَصِيفَةً فَشَبَّتْ ، ثُمَّ أَرَادَ أَنْ يَرْجِعَ فِيهَا ، قَالَ :  يَرْجِعُ فِي الْقِيمَةِ عَلَانِيَةً  .","","Al-Matalib al-Aliyah 1494","","عمر بن عبد العزيز بن مروان عن إسماعيل بن أمية الأموي عن سفيان الثوري عن يحيى القطان عن مسدد بن مسرهد","باب الهدية"
"1790","[7/445]      1495  -  حَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  حَدَّثَنِي  طَارِقُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  إِذَا اسْتُهْلِكَتِ الْهِبَةُ فَلَيْسَ لِصَاحِبِهِ أَنْ يَعُودَ فِيهَا  .","","Al-Matalib al-Aliyah 1495","","الشعبي عن طارق بن عبد الرحمن البجلي عن سفيان الثوري عن يحيى القطان عن مسدد بن مسرهد","باب الهدية"
"1791","[7/446]      1496  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  أَبِي  ،  ثَنَا  هِشَامُ بْنُ سَعْدٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُمَرَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  إِنَّ رَجُلًا كَانَ يُلَقَّبُ  حِمَارًا  ، وَكَانَ يُهْدِي لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْعُكَّةَ  مِنَ السَّمْنِ  وَالْعُكَّةَ  مِنَ الْعَسَلِ ، فَإِذَا جَاءَ صَاحِبُهُ يَتَقَاضَاهُ جَاءَ بِهِ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَيَقُولُ :  يَا رَسُولَ اللهِ ، أَعْطِ هَذَا ثَمَنَ مَتَاعِهِ ، فَمَا يَزِيدُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى أَنْ يَبْتَسِمَ وَيَأْمُرَ بِهِ فَيُعْطَى  .         [7/447]","","Al-Matalib al-Aliyah 1496","","عمر بن الخطاب عن أسلم العدوي مولى عمر بن الخطاب عن زيد بن أسلم عن هشام بن سعد المخزومي عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","باب الهدية"
"1792","[7/448]      42 - بَابُ النَّدْبِ إِلَى التَّسْوِيَةِ بَيْنَ الْأَوْلَادِ فِي الْعَطِيَّةِ  1497  -  الْحَارِثُ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَوْنٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  سَعِيدِ بْنِ يُوسُفَ الرَّحَبِيِّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  سَوُّوا بَيْنَ أَوْلَادِكُمْ فِي الْعَطِيَّةِ  ، فَلَوْ كُنْتُ مُفَضِّلًا أَحَدًا لَفَضَّلْتُ النِّسَاءَ  .         [7/449]","","Al-Matalib al-Aliyah 1497","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن يحيى بن أبي كثير عن سعيد بن يوسف الرحبي عن إسماعيل بن عياش الأحول عن عبد الله بن عون الهلالي عن الحارث بن محمد بن أبي أسامة","باب الندب إلى التسوية بين الأولاد في العطية"
"1793","[7/450]      43 - بَابُ الرَّهْنِ  1498  / 1  -  إِسْحَاقُ :  أَخْبَرَنَا  وَكِيعٌ ،  ثَنَا  مُوسَى بْنُ عُبَيْدَةَ الرَّبَذِيُّ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ قُسَيْطٍ ،  عَنْ  أَبِي رَافِعٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  نَزَلَ بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  ضَيْفٌ  ، فَبَعَثَنِي إِلَى  يَهُودِيٍّ  ، فَقَالَ : قُلْ لَهُ : إِنَّ رَسُولَ اللهِ يَقُولُ : بِعْنِي ، أَوْ أَسْلِفْنِي إِلَى رَجَبٍ ، فَأَتَيْتُهُ ، فَقُلْتُ لَهُ ذَلِكَ ، فَقَالَ لَهُ : وَاللهِ لَا أَبِيعُهُ وَلَا أُسْلِفُهُ إِلَّا بِرَهْنٍ ! فَأَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخْبَرْتُهُ ، فَقَالَ :  وَاللهِ لَوْ بَاعَنِي أَوْ أَسْلَفَنِي لَقَضَيْتُهُ ! إِنِّي لَأَمِينٌ فِي السَّمَاءِ أَمِينٌ فِي الْأَرْضِ  . اذْهَبْ بِدِرْعِي الْحَدِيدِ إِلَيْهِ ! قَالَ : فَنَزَلَتْ تُعَزِّيهِ عَنِ الدُّنْيَا         {      وَلا تَمُدَّنَّ عَيْنَيْكَ إِلَى مَا مَتَّعْنَا بِهِ أَزْوَاجًا مِنْهُمْ زَهْرَةَ الْحَيَاةِ الدُّنْيَا         }      .","","Al-Matalib al-Aliyah 1498","","أبو رافع القبطي عن يزيد بن عبد الله بن قسيط الليثي عن موسى بن عبيدة بن نشيط الحميري عن وكيع بن الجراح عن إسحاق ابن راهويه","باب الرهن"
"1794","1498  / 2  - وَقَالَ أَبُو بَكْرٍ :  حَدَّثَنَا  وَكِيعٌ بِهَذَا .  1498  / 3  - وَقَالَ إِسْحَاقُ :  أَخْبَرَنَا  رَوْحُ بْنُ عُبَادَةَ - يَعْنِي  عَنْ  مُوسَى - بِهَذَا  الْإِسْنَادِ  مِثْلَهُ .","","Al-Matalib al-Aliyah 1498","","أبو رافع القبطي عن يزيد بن عبد الله بن قسيط الليثي عن موسى بن عبيدة بن نشيط الحميري عن روح بن عبادة القيسي عن إسحاق ابن راهويه","باب الرهن"
"1795","1498  / 4  - وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  أَبُو بَكْرٍ ... فَذَكَرَهُ .","","Al-Matalib al-Aliyah 1498","","أبو رافع القبطي عن يزيد بن عبد الله بن قسيط الليثي عن موسى بن عبيدة بن نشيط الحميري عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","باب الرهن"
"1796","1498  / 5  -  قَالَ :  وَحَدَّثَنَا  الْحَسَنُ بْنُ شَبِيبٍ ،  ثَنَا  خَلَفُ بْنُ خَلِيفَةَ ،  ثَنَا  جَعْفَرُ بْنُ عَلِيِّ بْنِ أَبِي رَافِعٍ ،  عَنْ  جَدِّهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ:  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعَثَ فَاسْتُقْرِضَ لَهُ تَمْرٌ مِنْ  رَجُلٍ يَهُودِيٍّ  ، فَقَالَ الْيَهُودِيُّ :         [7/451]      لَا وَاللهِ ، إِلَّا بِرَهْنٍ ! قَالَ : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنَا فِي السَّمَاءِ أَمِينٌ ، وَفِي الْأَرْضِ أَمِينٌ  .         [7/452]","","Al-Matalib al-Aliyah 1498","","أبو رافع القبطي عن جعفر بن علي بن أبي رافع عن خلف بن خليفة الأشجعي عن الحسن بن شبيب البغدادي عن ابن حجر","باب الرهن"
"1797","[7/453]      1499  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ ،  ثَنَا  يُوسُفُ - هُوَ السَّمْتِيُّ -  ثَنَا  جَعْفَرُ بْنُ سَعْدٍ ،  عَنْ  خُبَيْبِ بْنِ سُلَيْمَانَ بْنِ سَمُرَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  سَمُرَةَ  - رَضِيَ اللهُ عَنْهُ - قَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ رَهَنَ أَرْضًا بِدَيْنٍ عَلَيْهِ ، فَإِنَّهُ يَقْضِي مِنْ  ثَمَرِهَا  بِمَا فَضَلَ عَنْ نَفَقَتِهَا  ، فَيَقْضِي مِنْ ذَلِكَ دَيْنَهُ الَّذِي عَلَيْهِ بَعْدَ أَنْ يَحْسِبَ الَّذِي بَقِيَ لَهُ عِنْدَ عَمَلِهِ وَنَفَقَتِهِ بِالْعَدْلِ  .  كذا في طبعة دار العاصمة ، ولعل الصواب : ( عن جده سمرة )","","Al-Matalib al-Aliyah 1499","","سمرة بن جندب عن جد سليمان بن سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","باب الرهن"
"1798","[7/454]      44 - بَابُ الْحَجْرِ  1500  -  قَالَ الْحَارِثُ :  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ أَبِي إِسْمَاعِيلَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  حَرَامِ بْنِ عُثْمَانَ ،  عَنْ  أَبِي عَتِيقٍ ،  عَنْ  جَابِرٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا يُتْمَ بَعْدَ حُلُمٍ  .         [7/455]             [7/456]","","Al-Matalib al-Aliyah 1500","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن جابر السلمي عن حرام بن عثمان الأنصاري عن إسماعيل بن عياش الأحول عن إسماعيل بن أبي إسماعيل المؤدب عن الحارث بن محمد بن أبي أسامة","باب الحجر"
"1799","[7/457]      1501  -  وَقَالَ أَبُو يَعْلَى :  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ ،  ثَنَا  مُعْتَمِرٌ ، قَالَ :  قَرَأْتُ عَلَى  فُضَيْلٍ ،  عَنْ  أَبِي حَرِيزٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  ابْنِ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِرَجُلٍ  :  أَنْتَ وَمَالُكَ لِأَبِيكَ  .  هَذَا  إِسْنَادٌ حَسَنٌ  .         [7/458]","","Al-Matalib al-Aliyah 1501","","عبد الله بن عمر بن الخطاب عن أبو إسحاق السبيعي عن عبد الله بن الحسين السجستاني عن فضيل بن ميسرة عن معتمر بن سليمان عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","باب الحجر"
"1800","[7/459]      45 - بَابُ عَلَامَةِ الْبُلُوغِ الَّذِي يَقَعُ بِهِ التَّكْلِيفُ  1502  -  قَالَ ابْنُ أَبِي عُمَرَ :  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  سَمِعْتُ  رَجُلًا ، فِي  مَسْجِدِ الْكُوفَةِ  ، يَقُولُ :  كُنْتُ يَوْمَ حَكَمَ  سَعْدٌ  - رَضِيَ اللهُ عَنْهُ - فِي  بَنِي قُرَيْظَةَ  ، وَأَنَا غُلَامٌ ،  فَشَكُّوا فِيَّ فَلَمْ يَجِدُونِي جَرَتْ عَلَيَّ الْمُوسَى ، فَاسْتُبْقِيتُ  .  ( 56 )  وَسَيَأْتِي - إِنْ شَاءَ اللهُ تَعَالَى - فِي حَدِّ السَّرِقَةِ ذِكْرُ مَنِ اعْتَبَرَهُ بِسِتَّةِ أَشْبَارٍ  .         [7/460]","","Al-Matalib al-Aliyah 1502","","عطية القرظي عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن ابن أبي عمر العدني","باب علامة البلوغ الذي يقع به التكليف"
