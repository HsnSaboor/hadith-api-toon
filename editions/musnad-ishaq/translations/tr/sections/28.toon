hadiths[6]{hadithnumber,text}:
"735","[AI-translation] ((Seyyidünâ Ebu Hüreyre (radıyallahu anh) anlatıyor: Resulullah (sallallahu aleyhi ve sellem) buyurdu: “Çocuk, doğduğu yatağın sahibindir.”))"
"736","[AI-translation] ((Seyyidünâ Ebu Hüreyre (radıyallahu anh) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: “Dayı (anne tarafı) mirasçıdır.”))"
"737","[AI-translation] ((Seyyidünâ İbn Abbas (radıyallahu anhümâ) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: “Malı Allah'ın Kitabı'na göre sabit pay sahipleri arasında paylaştırın — kalan, ölüye en yakın erkek içindir.”))"
"738","[AI-translation] ((Cemile bint Sa'd bin Rebi' (radıyallahu anhâ) anlattı: Babam ile amcam Uhud Savaşı'nda şehit edildi. Miraslarından bir şey almadım; müttefikler aldı.))"
"739","[AI-translation] ((Seyyidünâ İbn Abbas (radıyallahu anhümâ) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: “Sabit payları hak sahiplerine verin — sabit pay sahiplerinden sonra kalan, en yakın erkek akraba (ölünün) içindir.”))"
"740","[AI-translation] ((Vüheyb bu zincirle buna benzer rivayet etti — İshak (rahimehullah) dedi ki: Yani kişi tarafından — çünkü asabe onlardan olmayacak.))"
