hadiths[300]{hadithnumber,text}:
"309","[AI-translation] ((Uislamu ni safi, basi kaeni safi, na hakika hataingia Peponi isipokuwa mtu safi.))"
"310","[AI-translation] ((Heshima ya muumini mbele ya Allah Mtukufu iko katika usafi wa nguo zake.))"
"311","[AI-translation] ((Uislamu umejengwa juu ya usafi.))"
"312","[AI-translation] ((Hakuna dhara katika mkojo wa punda na wanyama ambao nyama yao ni halali kuliwa.))"
"313","[AI-translation] ((Utakaso wa ardhi ni kukauka kwake.))"
"314","[AI-translation] ((Aina mbili za maji hazitoshelezi kwa ghuslu baada ya janaba: maji ya bahari na maji ya bafu [la umma].))"
"315","[AI-translation] ((Maji yakifikia vibuyu arobaini, hayabebi uchafu.))"
"316","[AI-translation] ((Ardhi hainajisiki kwa mkojo isipokuwa baada ya siku arobaini.))"
"317","[AI-translation] ((Chimbeni sehemu ya [mkojo] huu kisha mmwagie maji.))"
"318","[AI-translation] ((Hakika imeharamishwa kuingia bafuni bila shuka [la kiunoni].))"
"319","[AI-translation] ((Paka akiingiza mdomo wake katika chombo, kioshwe mara saba.))"
"320","[AI-translation] ((Msikojoe hali ya kusimama.))"
"321","[AI-translation] ((Mmoja wenu asipopata maji lakini akapata nabidh, basi atawadhe kwayo.))"
"322","[AI-translation] ((Msitawadhe katika choo ambacho mnakojoa humo, kwani hakika maji ya udhu wa muumini yatapimwa pamoja na mema yake mengine.))"
"323","[AI-translation] ((Yule anayepeana mkono na Myahudi au Mkristo atawadhe na anaoshe mkono wake.))"
"324","[AI-translation] ((Udhu juu ya udhu ni nuru juu ya nuru.))"
"325","[AI-translation] ((Yule anayetawadha licha ya kuwa katika hali ya twahara, Allah Mtukufu humwandikia mema kumi.))"
"326","[AI-translation] ((Yule anayemletea ndugu yake chombo ili atawadhe nacho, ni kana kwamba amemletea farasi.))"
"327","[AI-translation] ((Udhu ni ufunguo wa swala.))"
"328","[AI-translation] ((Mswaki humwongezea mtu ufasaha.))"
"329","[AI-translation] ((Swala kwa mswaki ni bora mara sabini kuliko swala bila mswaki.))"
"330","[AI-translation] ((Yule anayesoma Bismillah wakati wa udhu, malaika wawili huendelea kumwandikia mema hadi udhu wake uvunjike.))"
"331","[AI-translation] ((Fanyeni khilal [kupitisha maji baina] ya vidole wakati wa udhu; [kwa kufanya hivyo] Siku ya Kiama, moto hautafanya khilal yao.))"
"332","[AI-translation] ((Mtume Muhammad (Swalla Allahu 'alayhi wa sallam) alipotawadha, alikuwa akiizungusha pete yake.))"
"333","[AI-translation] ((Kusukutua mdomo na kuingiza maji puani ni Sunna.))"
"334","[AI-translation] ((Mtu akisahau kuupaka kichwa na akakumbuka hali ya kuswali, akipata unyevu ndevuni mwake, auchukue na aupake kichwa chake; hii itamtosheleza. Lakini asipopata unyevu, arejee swala na udhu.))"
"335","[AI-translation] (([Katika hadithi ndefu imetajwa kwamba] Mtume (Swalla Allahu 'alayhi wa sallam) aliupaka shingo yake alipotawadha.))"
"336","[AI-translation] ((Kuupaka shingo ni njia ya ulinzi kutokana na kongwa [la adhabu] Siku ya Kiama.))"
"337","[AI-translation] ((Alipoosha mikono yake, alisoma dua hii ((Bismillah walhamdulillah...)) na alipoosha uso wake, alisoma dua hii ((Ee Allah, uufanye uso wangu mweupe...)).))"
"338","[AI-translation] ((Kwa sababu ya mkojo, viungo vya udhu vioshwe mara moja kila kimoja; kwa sababu ya kinyesi, mara mbili kila kimoja; na kwa sababu ya najisi kubwa [janaba], mara tatu kila kimoja.))"
"339","[AI-translation] ((Ningependa kukata miguu yangu kuliko kupaka juu ya khofu [masah juu ya soksi za ngozi].))"
"340","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akipaka juu ya sehemu ya nje ya soksi kwa kuchora mistari kwa vidole vyake.))"
"341","[AI-translation] (([Ibn Abi Amarah (Allah amridhie) aliuliza: Ee Mtume wa Allah!] Je, nipake juu ya khofu? Mtume (Swalla Allahu 'alayhi wa sallam) akasema: Ndiyo. Akasema: Kwa siku moja au siku mbili, hadi akataja siku saba; basi Mtume akasema: Kwa muda unaoona unafaa.))"
"342","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akipaka juu ya bandeji [za majeraha].))"
"343","[AI-translation] ((Mnapotawadha, nyunyizeni [maji] chini ya vazi lenu.))"
"344","[AI-translation] ((Alitawadha vizuri kisha akainua macho yake kuelekea mbinguni.))"
"345","[AI-translation] ((Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) alikuwa na kitambaa ambacho alikuwa akikikausha viungo vyake baada ya kutawadha.))"
"346","[AI-translation] ((Mtu akitapika [wakati wa swala], au akatokwa na damu ya pua, au kitu kutoka ndani ya tumbo kikafika mdomoni, au akatokwa na madhiy [maji ya mwanzo ya uzazi], basi aondoke [kwenye swala] na atawadhe.))"
"347","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alitapika wala hakutawadha.))"
"348","[AI-translation] ((Yule anayegusa sanamu atawadhe.))"
"349","[AI-translation] (([Katika mapokezi marefu imetajwa kwamba] Mtume (Swalla Allahu 'alayhi wa sallam) aliamrisha kwamba wale waliocheka [wakati wa swala] warejee udhu na swala zao.))"
"350","[AI-translation] ((Mtu akicheka kwa sauti, arejee udhu na swala zake.))"
"351","[AI-translation] ((Wakati mmoja mtu alikuwa akiswali huku shuka lake la chini likining'inia chini ya vifundo vya miguu, basi Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) akamwambia: Nenda katawadhe.))"
"352","[AI-translation] ((Udhu huwa wajibu kwa sababu ya kile kinachotoka mwilini, si kwa sababu ya kile kinachoingia mwilini.))"
"353","[AI-translation] ((Udhu unahitajika kwa kila damu inayotiririka.))"
"354","[AI-translation] ((Hakika udhu una shetani anayeitwa Walhan, basi jihadharini na wasiwasi kuhusu maji.))"
"355","[AI-translation] ((Tayammum ni kwamba mikono hupigwa ardhini mara mbili: mara moja kwa uso na mara moja kwa mikono miwili hadi viwiko.))"
"356","[AI-translation] ((Sunna ni kwamba mtu asiswali zaidi ya swala moja kwa tayammum moja, kisha afanye tayammum tena kwa swala nyingine.))"
"357","[AI-translation] ((Yule anayefanya tayammum asimuongoze katika swala yule aliyetawadha.))"
"358","[AI-translation] ((Yule anayefanya ghuslu [oga la ibada] kwa sababu ya janaba lililopatikana kwa njia halali, Allah Mtukufu atampa majumba mia moja ya lulu nyeupe.))"
"359","[AI-translation] ((Msiooge kwa maji yaliyopashwa na jua kwa sababu husababisha barasi [mabaka meupe].))"
"360","[AI-translation] ((Yule anayemwosha maiti, akaificha aibu zake, na akatekeleza amana, Allah Mtukufu atamghfiria dhambi zake kubwa arobaini.))"
"361","[AI-translation] ((Yule ambaye, kwa sababu ya najisi, huacha hata nafasi ya upana wa unywele bila kuoshwa alipofanya ghuslu, basi kwa sehemu hiyo atashughulikiwa katika Moto wa Jahannamu kwa namna fulani na fulani.))"
"362","[AI-translation] ((Chini ya kila unywele kuna najisi, basi osheni nywele na uitakaseni ngozi.))"
"363","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akifanya ghuslu [oga la ibada] siku ya Ijumaa, siku ya Idi al-Fitr, siku ya Idi al-Adha, na siku ya Arafa.))"
"364","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akifanya ghuslu kwa sababu nne: kwa Ijumaa [swala ya Ijumaa], baada ya najisi ya ngono [janaba], baada ya hijama, na baada ya kumwosha maiti.))"
"365","[AI-translation] ((Ogeni kila Ijumaa hata kama mtalazimika kununua maji kwa chakula chenu cha siku nzima.))"
"366","[AI-translation] ((Yule anayetawadha baada ya kuoga si miongoni mwetu.))"
"367","[AI-translation] ((Mwanamke mwenye hedhi na mtu mwenye najisi kubwa wasisome chochote kutoka Qur'an Tukufu.))"
"368","[AI-translation] ((Kitu pekee kilichomzuia Mtume (Swalla Allahu 'alayhi wa sallam) kusoma Qur'an ni hali ya najisi kubwa [janaba].))"
"369","[AI-translation] ((Muda wa chini wa hedhi ni siku tatu na muda wa juu ni siku kumi.))"
"370","[AI-translation] ((Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) aliwawekea siku arobaini wanawake wenye damu ya uzazi, isipokuwa watwaharike kabla ya hapo.))"
"371","[AI-translation] ((Muadhini anapoanza wito wa swala, Bwana huweka mkono wake juu ya kichwa chake na hubaki hivyo hadi muadhini amalize wito.))"
"372","[AI-translation] ((Asiadhini isipokuwa mtu mwenye udhu.))"
"373","[AI-translation] ((Asiadhini mtoto hadi afikie baleghe.))"
"374","[AI-translation] ((Asiwadhiniieni isipokuwa mtu mfasaha.))"
"375","[AI-translation] ((Yule ambaye, wakati muadhini anaposema ((Nashuhudia kwamba Muhammad ni Mtume wa Allah)), hubusu ndani ya vidole viwili vya shahada na kuvipitisha machoni mwake, kwake uombezi wa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) huwa wajibu.))"
"376","[AI-translation] ((Katika mji ambao wito wa swala [Adhana] ni wa mara kwa mara, baridi hupungua.))"
"377","[AI-translation] ((Muadhini wa wakaazi wa mbinguni ni Jibril (amani iwe juu yake), na imamu ni Mikael (amani iwe juu yake).))"
"378","[AI-translation] ((Maneno ya Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) yalikuwa yakirudirudiwa katika Adhana na Iqama.))"
"379","[AI-translation] ((Yule anayeadhini pia asome iqama.))"
"380","[AI-translation] ((Muadhini ana mamlaka zaidi juu ya adhana, ilhali imamu ana mamlaka zaidi juu ya iqama.))"
"381","[AI-translation] ((Yule anayesoma Iqama peke yake si miongoni mwetu.))"
"382","[AI-translation] ((Bilal (Allah amridhie) alipoanza kutamka Iqama, alipofikia ((Hakika swala imesimama)), Mtume (Swalla Allahu 'alayhi wa sallam) alisema: ((Allah aiimarishe na aidumishe)).))"
"383","[AI-translation] ((Baina ya kila wito miwili wa swala [yaani adhana na iqama] kuna [swala ya hiari], isipokuwa Magharibi.))"
"384","[AI-translation] ((Wekeni muda kati ya adhana yenu na iqama kama ambao ungemruhusu yule anayekula au kunywa amalize chakula na kinywaji chake.))"
"385","[AI-translation] ((Mtu akizaliwa mwana kisha akamuadhini sikio lake la kuume na akamsomea iqama sikio lake la kushoto, basi ugonjwa wa Umm Sibyan hautamdhuru.))"
"386","[AI-translation] ((Yule asiyeswali hana fungu katika Uislamu.))"
"387","[AI-translation] ((Allah Mtukufu kwanza aliifaradhisha swala kwa watu kuhusu dini yao.))"
"388","[AI-translation] ((Yule anayelinda swala, saumu, na twahara kutokana na najisi kubwa ni rafiki wa kweli [wali], ilhali yule anayevipuuzia ni adui wa kweli.))"
"389","[AI-translation] ((Nimekatazwa kuwaua wale wanaoswali.))"
"390","[AI-translation] ((Yule aliyeswali swala ya Isha kwa jamaa amepata fungu lake la Laylat al-Qadr.))"
"391","[AI-translation] ((Swala isicheleweshwe kwa chakula, wala kwa kazi yoyote nyingine.))"
"392","[AI-translation] ((Wakati wa mwanzo wa swala ni radhi ya Allah, ilhali wakati wa mwisho ni sababu ya maghfira na msamaha wa Allah.))"
"393","[AI-translation] ((Yule anayeinua Alfajiri [akichelewa kuiswali mapema], Allah Mtukufu atainua moyo wake na kaburi lake, na swala yake pia itakubaliwa.))"
"394","[AI-translation] ((Iinueni Alfajiri [ichelewesheni kidogo] nanyi mtaghfiriwa.))"
"395","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akiswali swala ya Alfajiri wakati nuru imeenea angani.))"
"396","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akichelewesha swala ya Alasiri hadi jua libaki jeupe na safi.))"
"397","[AI-translation] ((Yule anayejishughulisha na maneno ya dunia msikitini, Allah Mtukufu huharibu matendo yake.))"
"398","[AI-translation] ((Kila usiku mpigaji hutangaza: Enyi wakaazi wa makaburi! Nani mnamhusudu? Hujibu: Wale waliofungamana na msikiti [yaani wale walioambatanishwa na misikiti].))"
"399","[AI-translation] ((Zilindeni misikiti yenu na watoto wenu.))"
"400","[AI-translation] ((Kukaa misikitini ni utawa wa umma wangu.))"
"401","[AI-translation] ((Yule anayewasha taa msikitini, malaika wa kawaida na malaika wanaobeba Arshi huendelea kumwombea maghfira maadamu nuru ya taa hiyo inabaki msikitini.))"
"402","[AI-translation] ((Zitunzeni misikiti hii kwa kuipaka chokaa, kuweka taa humo, kuwasha vinara, na kupaka manukato safi.))"
"403","[AI-translation] ((Siku ya Kiama, ardhi zote zitaangamia isipokuwa misikiti; zitaungana moja na nyingine.))"
"404","[AI-translation] ((Yule anayefagia nyumba yoyote ya Allah [yaani msikiti], ni kana kwamba amehiji mara mia nne.))"
"405","[AI-translation] ((Kufagia misikiti ni mahari ya mahur-ul-ayn wa Peponi.))"
"406","[AI-translation] ((Ujira wa umma wangu ulionyeshwa mbele yangu, hata [ukiwemo] uchafu ambao mtu huuondoa msikitini.))"
"407","[AI-translation] ((Mmoja wenu akipata chawa msikitini, azike.))"
"408","[AI-translation] ((Mtu anayeswali asiye na fimbo [au kitu kama hicho kama sutra], basi achore mstari.))"
"409","[AI-translation] ((Hakuna kinachovunja swala, [kwa hiyo, mzuieni mpitaji mbele yenu] kadri mwezavyo.))"
"410","[AI-translation] ((Yule anayepita kwa makusudi mbele ya mtu anayeswali atatamani Siku ya Kiama kwamba angelikuwa mti mkavu.))"
"411","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alimwona mtu aliyekuwa akiswali akimtumia mtu mwingine kama sutra, basi akamamrisha arejee swala.))"
"412","[AI-translation] ((Tahadhari! Asiwasali mtu yoyote kwa kumchukua mtu mwingine au kaburi kama sutra.))"
"413","[AI-translation] Abu Bakr (Allah amridhie) alisema kwamba swala ya mwisho ambayo Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) aliiswali nyuma yangu, aliiswali katika vazi moja."
"414","[AI-translation] ((Ni Sunna kuswali katika vazi moja.))"
"415","[AI-translation] ((Abu Abdur Rahman anasema:) Nilimwona Mtume (Swalla Allahu 'alayhi wa sallam) na Aisha (Allah amridhie) wakiswali katika vazi moja; nusu ya vazi ilikuwa juu ya Mtume (Swalla Allahu 'alayhi wa sallam) na nusu ilikuwa juu ya Aisha (Allah amridhie)."
"416","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikataza kuswali katika suruali.))"
"417","[AI-translation] ((Mnaposwali, inueni mavazi yenu juu ya vifundo vya miguu. Sehemu yoyote ya mavazi yenu inayogusa ardhi iko Motoni.))"
"418","[AI-translation] ((Mnaposimama kwa swala, vaeni viatu vyenu.))"
"419","[AI-translation] ((Pia ni sehemu ya ukamilifu wa swala kwamba mtu aswali hali ya kuvaa viatu.))"
"420","[AI-translation] ((Jibril (amani iwe juu yake) alikuja kwangu, na alisoma 'Bismillah ir-Rahman ir-Raheem' kwa sauti mwanzoni mwa swala.))"
"421","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akiinua mikono yake mwanzoni mwa swala, kisha hangefanya hivyo tena.))"
"422","[AI-translation] ((Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) alipokuwa akiinamaskwenda kurukuu na kuinuka kutoka kurukuu, alikuwa akiinua mikono yake. Kisha, aliinua mikono yake mwanzoni mwa swala tu wala si wakati mwingine wowote.))"
"423","[AI-translation] ((Yule aliyeinua mikono yake katika swala, swala yake si sahihi.))"
"424","[AI-translation] ((Ni Sunna kuweka mkono mmoja juu ya mwingine chini ya kitovu wakati wa swala.))"
"425","[AI-translation] ((Usomaji wa Imamu ni usomaji kwa yule mwenye Imamu mbele yake.))"
"426","[AI-translation] ((Usomaji wa Imamu unamtosheleza, akiimba kwa siri au kwa sauti.))"
"427","[AI-translation] ((Hakuna usomaji nyuma ya Imamu.))"
"428","[AI-translation] ((Yule anayesoma [Qur'an] nyuma ya Imamu, swala yake si sahihi.))"
"429","[AI-translation] ((Nimekumbuka kusimama mara mbili katika swala: kusimama moja [kwa kimya] wakati Imamu anaposema Takbira ya ufunguzi hadi aanze usomaji, na kusimama moja baada ya kumaliza Sura Al-Fatiha na Sura nyingine kabla ya kurukuu.))"
"430","[AI-translation] ((Kuna kusimama mara mbili kwa Imamu; zihesabuni usomaji wa Sura Al-Fatiha humo kama baraka.))"
"431","[AI-translation] ((Mtume Mtukufu (Swalla Allahu 'alayhi wa sallam) alisoma ((Ghayril-maghduubi alayhim walad-dalleen)), akasema Amin, na akapunguza sauti yake nacho.))"
"432","[AI-translation] ((Nilimwona Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) alipofanya sijda, aliweka magoti yake mawili ardhini kabla ya mikono yake.))"
"433","[AI-translation] ((Mmoja wenu anaporukuu [katika ruku'], aseme ((Subhana Rabbiyal-Adhim)) mara tatu katika ruku', na anaposujudu [katika sujud], aseme ((Subhana Rabbiyal-A'laa)) mara tatu katika sujud.))"
"434","[AI-translation] ((Sijda juu ya paji ni faradhi, ilhali sijda juu ya pua ni sunna.))"
"435","[AI-translation] ((Mwanamke anapokaa katika swala, aweke paja moja juu ya jingine, na anaposujudu, aambatanishe tumbo lake na mapaja yake.))"
"436","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akisimama juu ya sehemu za miguu yake wakati wa swala.))"
"437","[AI-translation] ((Yule asiyemtumia salawat Mtume Mtukufu (Swalla Allahu 'alayhi wa sallam), swala yake haikubaliwi.))"
"438","[AI-translation] ((Imamu, baada ya kumaliza swala, akikaka na akawa bila udhu kabla ya kusema salam, swala yake imekamilika.))"
"439","[AI-translation] ((Yule ambaye, baada ya kuswali swala ya asubuhi na kabla ya kuzungumza neno lolote, husoma Sura Al-Ikhlas mara mia moja, kisha kila anaposoma 'Qul Huwallahu Ahad', dhambi za mwaka wake hughfiriwa.))"
"440","[AI-translation] ((Yule anayechanganya swala mbili bila udhuru halali amefanya dhambi kubwa.))"
"441","[AI-translation] ((Hakika, Allah Mtukufu haikubali swala ya yule anayeacha shuka lake la chini lining'inie chini ya vifundo vya miguu.))"
"442","[AI-translation] ((Hakuna swala kwa yule anayetazama huku na huku.))"
"443","[AI-translation] ((Yule anayetazama huku na huku wakati wa swala, Allah Mtukufu huikataa swala yake.))"
"444","[AI-translation] ((Kuweka mkono ubavuni wakati wa swala ni raha ya watu wa Jahannamu.))"
"445","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akigusa ndevu zake wakati wa swala.))"
"446","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikataza kupuliza wakati wa sijda.))"
"447","[AI-translation] ((Ni bora kwa mmoja wenu kuuzuia mkono wake kutoka kokoto [hali ya kusujudu] kuliko kuwa na ngamia mia moja wa kike.))"
"448","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akifuta jasho usoni mwake wakati wa swala.))"
"449","[AI-translation] ((Kupiga chafya, kusinzia, na kupiga miayo wakati wa swala ni kutoka kwa Shetani.))"
"450","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alichukia kupiga miayo wakati wa swala.))"
"451","[AI-translation] ((Yule mwenye uso mzuri zaidi awaongoze watu katika swala.))"
"452","[AI-translation] ((Mkitaka swala zenu zikubaliwe, basi waongozeni watu wenu bora.))"
"453","[AI-translation] ((Yule anayeswali nyuma ya mwanachuoni mcha Mungu, ni kana kwamba ameswali nyuma ya Nabii.))"
"454","[AI-translation] ((Sali nyuma ya kila mwadilifu na mwovu.))"
"455","[AI-translation] ((Yule aliyewaongoza watu katika swala kisha akakumbuka kwamba alikuwa bila udhu au katika hali ya najisi, basi arejee swala yake na wafuasi pia warejee swala yao.))"
"456","[AI-translation] ((Baada yangu, asiwaongoze yeyote swala hali ya kukaa.))"
"457","[AI-translation] ((Mwekeni Imamu katikati.))"
"458","[AI-translation] ((Yule aliyeswali swala ya Alfajiri kwa jamaa, ni kana kwamba amehiji mara hamsini na Adam (amani iwe juu yake).))"
"459","[AI-translation] ((Yule asiyekosa rakaa hata moja ya swala ya Alfajiri kwa siku arobaini ataona sehemu yake Peponi kabla hajafa.))"
"460","[AI-translation] ((Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) alikuwa akifanya Qunut katika swala ya Alfajiri daima hadi alipoondoka duniani.))"
"461","[AI-translation] ((Muumini anaposwali swala ya faradhi kwa jamaa, dhambi zake huanguka kwake kama majani haya yanavyoanguka.))"
"462","[AI-translation] ((Watu wawili na zaidi ya hapo huunda jamaa.))"
"463","[AI-translation] ((Jamaa inapoisimama, hakuna swala isipokuwa faradhi, isipokuwa Sunna mbili za Alfajiri.))"
"464","[AI-translation] ((Msimtangulie Imamu wenu katika kurukuu, kwani hakika mtapata kile kilichowatangulia.))"
"465","[AI-translation] ((Wakati wa swala ya faradhi ulifika tukiwa na Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) juu ya vipando vyetu. Basi [Swalla Allahu 'alayhi wa sallam] akasogea mbele na akatuongoza katika swala, nasi tukaswali juu ya vipando vyetu.))"
"466","[AI-translation] ((Ee Ali! Usimkumbushe imamu wakati wa swala.))"
"467","[AI-translation] ((Mwanamke peke yake huunda safu [tofauti].))"
"468","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) hakuacha swala za Sunna za Alfajiri akiwa safarini au nyumbani.))"
"469","[AI-translation] ((Yule anayeswali rakaa nne kabla ya Adhuhuri, dhambi zote za siku hiyo hughfiriwa kwake.))"
"470","[AI-translation] ((Yule asiyefanya rakaa nne kabla ya Adhuhuri mara kwa mara hatapewa uombezi wangu.))"
"471","[AI-translation] ((Yule anayeswali rakaa nne kabla ya Alasiri, Allah Mtukufu huifanya mwili wake kuwa haramu kwa Moto.))"
"472","[AI-translation] ((Yule anayeswali rakaa sita baada ya Magharibi wala hakutamka maneno mabaya humo, basi rakaa hizi zitakuwa sawa na ibada ya miaka kumi na miwili kwake.))"
"473","[AI-translation] ((Yule anayeswali rakaa ishirini baina ya Magharibi na Isha, Allah Mtukufu atamjengea nyumba Peponi.))"
"474","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akiswali rakaa mbili za swala baada ya Magharibi, na alikuwa akisoma kwa urefu humo hadi [wote] watu wa msikiti waondoke msikitini.))"
"475","[AI-translation] Ali (Allah amridhie) anasimulia kwamba nilikuwa na nyakati mbili za kujitokeza mbele ya Mtume wa Allah (Swalla Allahu 'alayhi wa sallam): moja usiku na nyingine mchana. Nilipokuja kwake usiku [naye akiwa ameshughulishwa na swala], alikuwa akikohoa ili kunijulisha uwepo wake."
"476","[AI-translation] ((Heshima ya muumini iko katika kusimama kwake [kwa swala] usiku.))"
"477","[AI-translation] ((Vipande viwili vya swala katikati ya usiku hufuta dhambi.))"
"478","[AI-translation] ((Rakaa mbili ambazo mwana wa Adam huziswali katika sehemu ya mwisho ya usiku ni bora kwake kuliko dunia na kilichomo humo, na lau kama singeliweka mzigo kwa umma wangu, ningelifanya rakaa hizi kuwa faradhi kwao.))"
"479","[AI-translation] ((Kamwe msiache swala ya usiku, hata kama mnaswali tu kadri ya muda wa kukamua mbuzi.))"
"480","[AI-translation] ((Enyi watu wa Qur'an! Msifanye Qur'an kuwa mto, na isomeni wakati wa mchana na usiku kama inavyostahiki kusomwa.))"
"481","[AI-translation] ((Yule ambaye swala zake ni nyingi zaidi usiku, uso wake ni [sawa] mzuri mchana.))"
"482","[AI-translation] ((Mmoja wenu anapolala kwa nia ya kufanya Qiyam al-Layl, akeepe konde la udongo ubavuni mwake.))"
"483","[AI-translation] ((Allah Mtukufu amekuongezeeni swala nyingine kwa swala zenu, nayo ni Witri.))"
"484","[AI-translation] ((Yule asiyefanya Witri si miongoni mwetu.))"
"485","[AI-translation] ((Yule asiyefanya Witri, swala yake si sahihi.))"
"486","[AI-translation] ((Witri ni faradhi kwa watu wa Qur'an [yaani wahifadhi].))"
"487","[AI-translation] ((Witri ni faradhi kwa kila Muislamu.))"
"488","[AI-translation] ((Swala ya Witri ni rakaa tatu kama Magharibi.))"
"489","[AI-translation] ((Yule anayekosa Witri usiku ailipe asubuhi.))"
"490","[AI-translation] ((Mtume Mtukufu (Swalla Allahu 'alayhi wa sallam) alikuwa akiswali rakaa ishirini [vipande] vya swala ya [Tarawihi] katika Ramadhani.))"
"491","[AI-translation] ((Wakati wa Umar (Allah amridhie), watu walikuwa wakiswali rakaa ishirini na tatu za swala ya [Tarawihi] katika Ramadhani.))"
"492","[AI-translation] ((Ali (Allah amridhie) alimamrisha mtu awaongoze watu katika rakaa ishirini [vipande] vya swala ya [Tarawihi].))"
"493","[AI-translation] ((Ibn Abi Ka'b (Allah amridhie) alikuwa akiwaongoza watu wa Madina katika rakaa ishirini za swala ya [Tarawihi] wakati wa Ramadhani.))"
"494","[AI-translation] ((Kuna mlango Peponi uitwao Duha. Yule anayeswali swala ya Duha, Siku ya Kiama swala hii itaelekea kwake kama mtoto anavyoelekea kwa mama yake, hadi itampokea, na mwabudu ataingia Peponi.))"
"495","[AI-translation] ((Kuna mlango Peponi uitwao Duha; ataingia humo mtu pekee anayefanya swala ya Duha [ya mchana] mara kwa mara.))"
"496","[AI-translation] ((Yule anayefanya swala ya Duha mara kwa mara wala haiatchi bila sababu au kisingizio chochote, basi mimi na mtu huyo tutapanda mashua ya nuru katika bahari ya nuru Peponi hadi tumtembelee Bwana.))"
"497","[AI-translation] ((Mnafiki hafanyi swala ya Duha [ya mchana].))"
"498","[AI-translation] ((Sali swala ya Duha kwa sura mbili zenye jina moja: 'Kwa Jua na mwangaza wake' [Ash-Shams] na 'Kwa mchana' [Ad-Duha].))"
"499","[AI-translation] ((Yule anayeswali vipande viwili vya swala ya Duha, Allah Mtukufu humwandikia mema laki moja.))"
"500","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) hakuacha swala ya Duha hata wakati wa safari na hali nyingine.))"
"501","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akiswali swala ya Duha kwa kiwango ambacho tungesema: Sasa hataiacha kamwe, kisha akaiacha kwa kiwango ambacho tungesema: Sasa hataiswali kamwe.))"
"502","[AI-translation] ((Yule mwenye haja kutoka kwa Allah Mtukufu au kutoka kwa mmoja wa wana wa Adam, atawadhe na atawadhe vizuri, kisha aswali vipande viwili vya swala, kisha amhimidi Allah Mtukufu, kisha amtumie salawat Mtume (Swalla Allahu 'alayhi wa sallam), kisha asome dua hii ((La ilaha illallah al-Halim... isipokuwa umenitimiza, ee Mwingi wa Rehma kuliko wenye rehma)).))"
"503","[AI-translation] ((Ee Mtume wa Allah! Mwenye dhambi afanye nini ili atubu kutokana na dhambi?)) Mtume (Swalla Allahu 'alayhi wa sallam) akasema: ((Aoge baada ya swala ya Witri usiku wa Jumatatu na aswali vipande kumi na viwili vya swala.))"
"504","[AI-translation] ((Yule aliyekesha usiku wa Ashura [Muharram] kwa [swala za hiari na matendo ya ibada], ni kana kwamba amemwabudu Allah kwa namna ya wakaazi wa mbinguni.))"
"505","[AI-translation] ((Yule anayefunga Alhamisi ya kwanza ya Rajab, kisha usiku wa Ijumaa akaswali rakaa kumi na mbili za swala... [hadithi ndefu kuhusu Salat al-Raghaib].))"
"506","[AI-translation] ((Yule aliyeswali swala ya Magharibi usiku wa kwanza wa Rajab kisha akafanya vipande ishirini vya swala...))"
"507","[AI-translation] ((Yule anayeswali rakaa kumi na nne usiku wa kumi na tano wa Rajab... Allah Mtukufu atamtumia malaika elfu kuelekea kwake.))"
"508","[AI-translation] ((Yule anayeswali rakaa mia moja za swala usiku wa katikati ya Sha'ban... Allah Mtukufu atatimiza haja zake zote.))"
"509","[AI-translation] ((Yule anayeswali rakaa mbili usiku wa Ijumaa, akisoma Sura Al-Fatiha na Sura Az-Zalzalah mara kumi na tano katika kila rakaa, Allah Mtukufu atampa ulinzi kutokana na adhabu ya kaburi na vitisho vya Siku ya Kiama.))"
"510","[AI-translation] ((Yule anayeswali rakaa mbili baina ya Adhuhuri na Alasiri siku ya Ijumaa... hataondoka duniani hadi amwone Bwana wake ndotoni na makao yake Peponi.))"
"511","[AI-translation] ((Yule anayeswali rakaa nne siku ya Jumamosi wakati wa Duha... bishara njema kwao.))"
"512","[AI-translation] ((Yule anayeswali rakaa nne usiku wa Jumapili, akisoma Sura Al-Fatiha mara moja na Sura Al-Ikhlas mara kumi na tano katika kila rakaa, Allah Mtukufu atampa Siku ya Kiama ujira wa kuisoma Qur'an mara kumi na kuitendea kazi mara kumi.))"
"513","[AI-translation] ((Yule anayeswali rakaa nne siku ya Jumatatu... Allah Mtukufu atampa jumba Peponi.))"
"514","[AI-translation] ((Siku yenye fadhila zaidi ni siku ya Ijumaa.))"
"515","[AI-translation] ((Ijumaa ni Hijja ya masikini.))"
"516","[AI-translation] ((Siku ya Ijumaa inapokuwa salama, basi siku zote zinakuwa salama.))"
"517","[AI-translation] ((Ubora wa Ijumaa katika Ramadhani juu ya Ijumaa nyingine ni kama ubora wa mwezi wa Ramadhani juu ya miezi mingine yote.))"
"518","[AI-translation] ((Yule anayekosa swala ya Ijumaa atoe dinari moja sadaka.))"
"519","[AI-translation] ((Kuoga siku ya Ijumaa ni Sunna.))"
"520","[AI-translation] ((Ogeni siku ya Ijumaa hata kama mtalazimika kununua bakuli la maji kwa dinari.))"
"521","[AI-translation] ((Yule anayekata kucha na sharubu zake kila Ijumaa, Allah Mtukufu ataweka uponya humo na kuondoa ugonjwa kutokana nao.))"
"522","[AI-translation] ((Mfano wa muumini siku ya Ijumaa ni kama ule wa mtu katika hali ya Ihram; asikate nywele zake wala kucha zake hadi amalize swala.))"
"523","[AI-translation] ((Kuswali swala ya Ijumaa kwa kilemba ni bora mara sabini kuliko kuswali swala ya Ijumaa bila kilemba.))"
"524","[AI-translation] ((Kuna baadhi ya malaika wa Allah Mtukufu wanaowaombea maghfira wale wanaovaa vilemba vyeupe siku ya Ijumaa.))"
"525","[AI-translation] ((Ijumaa ni faradhi kwa yule anayelala usiku na familia yake.))"
"526","[AI-translation] ((Ijumaa ni faradhi kwa yule ambaye wito wake humfikia.))"
"527","[AI-translation] ((Desturi iliyothibitika ni kwamba Ijumaa ni faradhi kwa kila watu arobaini au zaidi.))"
"528","[AI-translation] ((Tunaposem sabini twenda kwa swala ya Ijumaa, wako kama wale watu sabini ambao, katika sura ya ujumbe, walienda na Musa (amani iwe juu yake) kwa Bwana wao, au wako bora kuliko wao.))"
"529","[AI-translation] ((Ijumaa na Tashriq ziko tu katika msikiti mkuu wa mji.))"
"530","[AI-translation] ((Lau kama hangekuwepo mimbari, watu wa makazi wangechomwa.))"
"531","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alipopanda mimbari, alikuwa akisema Salam [kusalimia kwa amani].))"
"532","[AI-translation] ((Mhubiri anapopanda mimbari, wala swala si sahihi wala mazungumzo.))"
"533","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akiswali rakaa nne kabla ya khutba ya Ijumaa, wala hakuzitenganisha [kwa kumaliza kwa salam] katika chochote miongoni mwazo.))"
"534","[AI-translation] ((Yule anayezungumza wakati wa khutba ya Ijumaa ilhali Imamu anatoa khutba ni kama punda anayebeba vitabu, na yule anayemwambia 'Nyamaza,' Ijumaa yake [swala] si sahihi.))"
"535","[AI-translation] ((Yule anayeruka juu ya shingo za watu baada ya Imamu kuingia msikitini na akaunda mgawanyiko baina ya watu wawili ni kama yule anayeburuta matumbo yake katika moto wa Jahannamu.))"
"536","[AI-translation] ((Siku ya Ijumaa, mema huongezwa maradufu.))"
"537","[AI-translation] ((Yule anayesoma maneno haya mara tatu kabla ya Alfajiri siku ya Ijumaa ((Nastaghfirullah alladhi la ilaha illa huwal-Hayyul-Qayyum wa atubu ilayh)), dhambi zake zote zitaghfiriwa, hata kama ni nyingi kama povu la bahari.))"
"538","[AI-translation] ((Yule anayesoma Sura Ha-Meem ad-Dukhan usiku wa Ijumaa ataghfiriwa.))"
"539","[AI-translation] ((Yule anayesoma Sura Ha-Meem ad-Dukhan usiku wa Ijumaa au siku ya Ijumaa, Allah Mtukufu atamjengea nyumba Peponi.))"
"540","[AI-translation] ((Yule anayezikesha usiku za Idi al-Fitr na Idi al-Adha katika swala, akitafuta ujira kutoka kwa Allah Mtukufu, moyo wake hautakufa siku ambayo nyoyo zote zitakufa.))"
"541","[AI-translation] ((Yule anayeswali rakaa mia moja usiku wa Idi al-Fitr... [hadithi ndefu].))"
"542","[AI-translation] ((Tulikuwa tukila, tukinywa, na kuoga [siku ya Idi al-Fitr], kisha tukielekea kwenye uwanja wa swala ya Idi.))"
"543","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akivaa mashuka mekundu katika Idi mbili na siku za Ijumaa.))"
"544","[AI-translation] ((Pambeni Idi zenu kwa Takbira.))"
"545","[AI-translation] ((Pambeni Idi mbili kwa Tahleel, Tahdees, Tahmeed, na Takbeer.))"
"546","[AI-translation] ((Ali (Allah amridhie) alikuwa akisema takbira kwa sauti kubwa kiasi kwamba watu barabarani walisikia.))"
"547","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa akisema takbira nne katika swala za Idi, kama takbira za swala ya jeneza.))"
"548","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) aliongoza swala ya Idi katika rakaa mbili na humo alisoma Sura Al-Fatiha peke yake.))"
"549","[AI-translation] ((Mtume Mtukufu (Swalla Allahu 'alayhi wa sallam) alikuwa akisoma 'Amma Yatasa'aloon' na 'Wash-Shamsi wa Duhaha' katika swala za Idi.))"
"550","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikataza kuvaa silaha katika maeneo ya Kiislamu wakati wa Idi mbili, isipokuwa kama kuna adui [basi si haramu].))"
"551","[AI-translation] ((Nilimwona Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) siku za Idi mbili, na kulikuwa na mkuki mbele yake.))"
"552","[AI-translation] ((Katika tukio moja la Idi, mvua iliwanyeshea watu, basi Mtume Mtukufu (Swalla Allahu 'alayhi wa sallam) aliwaongoza katika swala ya Idi ndani ya msikiti.))"
"553","[AI-translation] ((Watu bora wa umma wangu ni wale ambao, wanaposafiri, hufanya Qasr [swala zilizofupishwa].))"
"554","[AI-translation] ((Enyi watu wa Makka! Msifupishe swala kwa umbali chini ya barid nne, kama umbali kutoka Makka hadi Usfan.))"
"555","[AI-translation] ((Mtume (Swalla Allahu 'alayhi wa sallam) alikuwa wakati mwingine akifupisha swala wakati wa safari na wakati mwingine akiiswali kamili.))"
"556","[AI-translation] ((Aisha (Allah amridhie) alisema kwamba nilienda na Mtume (Swalla Allahu 'alayhi wa sallam) kwa Umra katika Ramadhani, basi aliswali swala zilizofupishwa ilhali mimi niliswali swala kamili. Kisha nikamwambia: Umeswali swala zilizofupishwa nami nimeswali swala kamili. Basi Mtume (Swalla Allahu 'alayhi wa sallam) akasema: Ee Aisha! Nawe umefanya vyema.))"
"557","[AI-translation] ((Yule anayeswali swala kamili wakati wa safari ni kama yule anayefupisha swala hali ya nyumbani.))"
"558","[AI-translation] ((Yule anayeswali rakaa nne wakati wa safari ni kama yule anayeswali rakaa mbili hali ya nyumbani.))"
"559","[AI-translation] ((Yule anayeswali rakaa nne za swala hali ya safarini arejee swala.))"
"560","[AI-translation] ((Msifupishe swala isipokuwa wakati wa Hajj au Jihad.))"
"561","[AI-translation] ((Wakati wa swala ya yule anayesahau kuswali ni anapokumbuka.))"
"562","[AI-translation] Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) aliulizwa kuhusu mtu anayesahau ni vipande vingapi vya swala ameswali wakati wa swala. Akasema (Swalla Allahu 'alayhi wa sallam): Arejee swala na afanye sijda mbili hali ya kukaa."
"563","[AI-translation] ((Hakuna kusahau [sahw] katika swala ya hofu.))"
"564","[AI-translation] ((Hakuna sijda za kusahau [sajda sahw] kwa mfuasi nyuma ya imamu, lakini imamu akisahau, basi imamu na mfuasi wote lazima wafanye sijda za kusahau.))"
"565","[AI-translation] ((Mmoja wenu anapovua viatu vyake wakati wa swala, asiviweke mbele yake, kwani basi atakuwa akivifuata, wala asiviweke nyuma yake, kwani basi mmoja wa ndugu zake anaweza kuvifuata; bali aviweke baina ya miguu yake.))"
"566","[AI-translation] ((Katika kila rakaa [kipande] cha swala ya kupatwa, kuna kurukuu moja.))"
"567","[AI-translation] ((Je, Sura Al-Hajj ilipewa ubora kwa sababu ina sijda mbili?)) Mtume (Swalla Allahu 'alayhi wa sallam) akasema: ((Ndiyo, na yule asiyefanya sijda zote mbili asizisome.))"
"568","[AI-translation] ((Swala ya mfungwa ni rakaa mbili hadi afe au Allah amwachilie huru kutoka utumwani.))"
"569","[AI-translation] ((Mtume Mtukufu (Swalla Allahu 'alayhi wa sallam) alimwamrisha Ja'far (Allah amridhie) aswali hali ya kusimama juu ya mashua, isipokuwa kama kuna hofu ya kuzama [basi ruhusa imetolewa kuswali hali ya kukaa].))"
"570","[AI-translation] ((Allah Mtukufu haikubali swala ya watu watatu, wala mema yoyote ya kwao hayapandi mbinguni: mtumwa aliyetoroka hadi arudi kwa mabwana zake; mwanamke ambaye mumewe amemkasirikia hadi aridhike naye; na mlevi hadi arudiwe na fahamu zake.))"
"571","[AI-translation] ((Yule anayekuwa mlezi wa yatima anapaswa kufanya biashara kwa mali yake wala asiache ili zaka iile.))"
"572","[AI-translation] ((Niliuliza: Ee Mtume wa Allah (Swalla Allahu 'alayhi wa sallam), kuhusu zaka, naye (Swalla Allahu 'alayhi wa sallam) aliulizwa kuhusu hilo. Akasema (Swalla Allahu 'alayhi wa sallam): Hakika, kuna [haki inayostahiki] katika mali zaidi ya zaka. Kisha [Swalla Allahu 'alayhi wa sallam] akasoma aya hii kutoka Sura Al-Baqarah: Wema si kwamba mgeuze nyuso zenu mashariki au magharibi.))"
"573","[AI-translation] ((Dinari moja ya zaka inastahiki kwa kila farasi wa malisho.))"
"574","[AI-translation] ((Hakuna zaka ya faradhi katika kiasi cha kati [yaani baina ya viwango viwili vilivyowekwa].))"
"575","[AI-translation] ((Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) alikuwa akituamrisha kulipa zaka kwa bidhaa za biashara.))"
"576","[AI-translation] ((Katika tango, tikiti maji, komamanga, miwa, na mboga, Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) ameondoa zaka.))"
"577","[AI-translation] ((Hakuna zaka kwa mboga.))"
"578","[AI-translation] ((Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) aliamrisha kwamba zabibu zikadiriwe kwa namna ile ile kama tende zinavyokadiriwa, na zaka yake ikusanywe katika sura ya zabibu kavu kama zaka ya tende inavyochukuliwa katika sura ya tende kavu [yaani chuwara].))"
"579","[AI-translation] ((Hakuna zaka kwa mapambo.))"
"580","[AI-translation] ((Mnapokadiria na kutathmini nafaka, basi acheni theluthi moja; msipoweza kuacha theluthi moja, basi acheni robo moja.))"
"581","[AI-translation] ((Hakuna zaka katika asali.))"
"582","[AI-translation] ((Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) alimpa migodi ya sehemu ya Qabliyyah Bilal bin Harith Muzani (Allah amridhie). Sehemu hii iko upande mmoja wa eneo la Fara'. Hivyo, kutoka migodi hii hadi leo, hakuna kilichochukuliwa isipokuwa kwa zaka.))"
"583","[AI-translation] ((Zaka haijawahi kuchanganywa na mali yoyote isipokuwa iliiharibu.))"
"584","[AI-translation] ((Lipeni Zaka na mtafuteni mtu mwenye ilmu kwa ajili yake, kwa sababu ni mcha Mungu zaidi na mwadilifu zaidi.))"
"585","[AI-translation] ((Hivi karibuni watakuja kwenu [wale wanaokusanya zaka] watu ambao mtawachukia, lakini wanapokuja kwenu, wakaribisheni na waacheni wakusanye zaka kama watakavyo. Wakitenda kwa uadilifu na haki, kutakuwa na ujira, na wakitenda udhalimu, dhambi itakuwa juu yao. Lakini mnapaswa kuwaweka radhi, kwa sababu ukamilifu wa zaka yenu uko katika kuwaweka radhi, nao wanapaswa kuwaombeeni dua.))"
"586","[AI-translation] ((Kukusanya nafaka kutoka nafaka, mbuzi kutoka mbuzi, ngamia kutoka ngamia, na ng'ombe kutoka ng'ombe.))"
"587","[AI-translation] ((Tulisema [kwa Mtume wa Allah, Swalla Allahu 'alayhi wa sallam]: Wakusanyaji wa Zaka wanatudhulumu; je, tunaweza kuficha mali yetu sawa na ziada yao? Akasema: Hapana.))"
"588","[AI-translation] ((Kuhusu zaka, Allah Mtukufu hakuridhika na amri ya nabii yoyote wala na amri ya mwingine yoyote, hadi Yeye Mwenyewe alipotoa amri kuhusu hilo na akagawanya matumizi ya zaka katika makundi manane.))"
"589","[AI-translation] ((Katika Sadaqat al-Fitr, saa moja ya ngano ni kwa niaba ya watu wawili.))"
"590","[AI-translation] ((Katika [yaani Idi] siku hii, wafanye masikini wawe huru kutokana na kuzunguka mlango hadi mlango.))"
"591","[AI-translation] ((Sadaka bora ni kwamba mtu Muislamu hujifunza ilmu kisha akaifundisha kwa ndugu yake Muislamu.))"
"592","[AI-translation] ((Je, nisiwaambie kuhusu sadaka bora? [Nayo ni kwamba] dada yako arudishwa kwako [kwa sababu ya talaka au kitu kama hicho] naye hana wa kumletea riziki isipokuwa wewe.))"
"593","[AI-translation] ((Sadaka gani ni bora?)) Mtume (Swalla Allahu 'alayhi wa sallam) akasema: ((Sadaka inayotolewa katika Ramadhani.))"
"594","[AI-translation] ((Harakaia katika kutoa sadaka, kwani sadaka huzuia mitihani.))"
"595","[AI-translation] ((Hata kiasi kidogo cha sadaka huzuia misiba mingi.))"
"596","[AI-translation] ((Mkarimu yuko karibu na rehma ya Allah, karibu na Pepo, karibu na watu, na mbali na moto wa Jahannamu, ilhali mbahiri yuko mbali na Allah, mbali na Pepo, mbali na watu, na karibu na Jahannamu. Na mjinga mkarimu anapendwa zaidi na Allah Mtukufu kuliko muabudu mbahiri.))"
"597","[AI-translation] ((Pepo ni nyumba ya watu wakarimu.))"
"598","[AI-translation] ((Mdanganyifu, mbahiri, na yule anayewakumbusha wengine fadhila zake hataingia Peponi.))"
"599","[AI-translation] ((Sadaka huokoa kutokana na kifo kibaya.))"
"600","[AI-translation] ((Masikini ni taulo za matajiri; husafisha dhambi zao nazo.))"
"601","[AI-translation] ((Udhuru wa yeyote unapodhihirika, basi sadaka huwa wajibu kwake.))"
"602","[AI-translation] ((Mpeni mwombaji hata akija akiwa amepanda farasi.))"
"603","[AI-translation] ((Mkilazimika kuomba, basi ombeni kwa watu wema.))"
"604","[AI-translation] ((Pepo pekee ndiyo inapaswa kuombwa kwa njia ya Dhati ya Allah.))"
"605","[AI-translation] ((Yatima anapolia, machozi yake huangukia juu ya kiganja cha Mwingi wa Rehma.))"
"606","[AI-translation] ((Yule aliyemnywesha maji sehemu ambayo alikuwa na mamlaka juu ya maji, basi kwa kila funda la maji alilotoa, kuna mema kumi kwake, awe mwadilifu au mwovu.))"
"607","[AI-translation] ((Wema na tabia laini kwa watu pia ni sadaka.))"
"608","[AI-translation] ((Yule asiye na sadaka awalaani Mayahudi.))"
