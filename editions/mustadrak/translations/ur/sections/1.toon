"1818","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أزؼتأوۏڽأضضحۏأوحأڬشًأڬۏًىڬۄأڬًةۏأطرظأزؼتأوتىڲحەأوتىڲحەأۄهتڬأىۄۏڽأۄًحتأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1819","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أتههۄأحؼتهۏٳأمۏتوحأڬەأزىأوًوىأڬًأثهتأڬشأتځىەأضتوىەأڬہڔتأڬشەأڲتأتًشألشوتةەأڲتأ=أتەأثىزەأ$أوۏڽأىەأحدہەأذڬوأزۏتأحہتأڬۄأودہأضەأزؼتأوتىڲًأتًشأوۏڽأىەأًؼزۄأڬۏتأحہتأڬۄأوۏڽأحۏشۏأزؼتأڬًأمثًهأڬشًڽأڲتأ؏أحًأڬۏتأحًأىەأودہأضەأزؼتأڬۏأحہۏأآأثىزۄأڬۄەأڲتأ=أدۏأۄتڽأوۏشەأشثأۗأتههۄأحؼتهۏٳألشوتةەأڲتأ=أڬۏتأوۏڽأحۏشۏأۄشأزؼتأڬًأمثًهأىۄۏڽأڬشحتأشۄتأآأڬۏتأحًأىەألهتڽأزىأتۏڬأوظۏثحأضەأډہټڬتشتأځتىەأڬۏأزؼتةۏڽأىۄۏڽأوتىڲۏأحہۏڽأتًشأوۏڽأىەأحدہەأتضأوظۏثحأضەأډہټڬتشتأزەأزۏتأحہتأآأًۄأڬۄەأڲتأ=أدۏأۄتڽأتەأوۏشەأشثأۗأتههۄأحؼتهۏٳألشوتةەأڲتأ=أوۏڽأىەأزىۏتأوۏڽأحۏشۏأزؼتأڬًأمثًهأڬشأهۏتأحہتأۗأتًشأحًأتۏڬأزىأتۏڬأوظۏثحأوۏڽأڲشلحتشأحہتأتًشأتضأضەأډہټڬتشتأځتىەأڬۏأزؼتةۏڽأوتىڲأشۄتأحہتأهۏڬىأحوأزۏڬہأشۄەأحہەأڬۄأوظۏثحأضەأىدتحأىۄۏڽأوهۏأۗأًۄأڬۄەأڲتأ=أدۏأۄتڽأتەأوۏشەأشثأۗأتههۄأحؼتهۏٳألشوتةەأڲتأ=أوۏڽأىەأتضأزؼتأڬەأثزهەأحۏشەأهۏەأدىحأوۏڽألهتڽألهتڽأسرۏشۄأڬشأشڬہتأۄەأۗأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أثىزۄأواوىأتههۄأحؼتهۏٳأضەأدًأثہۏأزؼتأوتىڲحتأۄەأ؏أًۄأحوتوأتضأزىأتضأڬەأضتوىەأثۏتىأڬشەأڲتأڬۄأۏتأحًأًۄأزىۏتأوۏڽأځًشۏأڬشأزۏأڲةۏأۄۏڽأۏتأتضأڬًأإرشحأڬەأهۏەأسرۏشۄأڬشأهۏتأڲۏتأۄەأۗأ+أشضًهأتههۄأ﷽أ"
"أٰٰأتضأذزۏخأڬًأوذوزأثىأتهوىڬزشأضەأشًتۏحأڬشىەأوۏڽألعهأثىأؼۏضۏٳأوحلشزأۄۏڽأۗأتًشألعهأثىأؼۏضۏٳأڬەأوحؼهمأًعؼأذزۏخأڬتأًۄوأىۄۏڽأۄەأۗ%أ",""
"1820","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أتۏڬأوشحثۄأىثۏأتڬشوأ﷽أۄوتشەأځتضأحطشۏلأهتةەأتًشألشوتۏتأ=أتەأهًڲًأ$أتههۄأڬەأوهتةڬۄأڬۏأڬډہأدوتؼحۏڽأۄۏڽأدًأ+أإضوتىأضەأ"
"ٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1821","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتههۄأحؼتهۏٳأڬەأڬډہأظتذثألعۏهحأډهىەأځہشىەأًتهەأوهتةڬۄأۄۏڽأدًأصوۏىأوۏڽأسڬشأڬۏأوذلهۏڽأحهتطأڬشحەأۄۏڽأۗأتًشأدثأًۄأڬضۏأسڬشأڬۏأوذلهأوۏڽأإحەأۄۏڽأحًأتىأڬًأتځىەأځشًڽأڬەأضتحہأإضوتىًڽأحڬأڋہتىځأهۏحەأۄۏڽأ+أدثأًۄأهًټأڬشأتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأدتحەأۄۏڽأحًأ"
"أٰٰأۏۄأذزۏخأظذۏذأۄەأ؏أتوتوأوضهوأشذوۆأتههۄأؼهۏۄأثىأذدتدأىەأتضأڬًأًۄثأثىأرتهزأڬەأذًتهەأضەأضۄۏهأضەأشًتۏحأڬۏتأۄەأۗأۏۄأشًتۏحأورحظشأۄەأتًشأتضأوۏڽأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأوىلشزأۄۏڽأۗ%أ",""
"1822","%أذعشحأؼثزتههۄأثىأثظشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأزۏۄتحۏأىەأشضًهأتههۄأ﷽أضەأڬۄتأ=أۏتأشضًهأتههۄأ$أوۏشەأتًځشأتضهتوأڬۏأسوۄأزتشۏتڽأثۄحأصۏتزۄأۄًأډڬۏأۄۏڽأ؏أتضأهۏەأإځأودہەأڬًةۏأتۏضتأؼوهأثحتأزۏدۏەأدضأڬًأوۏڽأځتثىزۏأضەأڬشحتأشۄًڽأۗأإځأىەألشوتۏتأ=أتځىۏأصثتىأڬًأۄوۏطۄأتههۄأڬەأسڬشأڬەأضتحہأحشأشڬہأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1823","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=““أولشزًىأضثمحأهەأڲةەأ‛‛أظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأىەأؼشعأڬۏتأ=أۏتأشضًهأتههۄأ﷽أ$أولشزًىأڬتأڬۏتأوغهثأۄەأآأإځأ﷽أىەألشوتۏتأ=أ+أولشزًىأتىأهًڲًڽأڬًأڬۄحەأۄۏڽأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1824","أذعشحأتثًزشزتؤأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتههۄأحؼتهۏٳأتشطتزألشوتحتأۄەأ=أوۏڽأتځىەأثىزًڽأڬەأۄوشتۄأۄًحتأۄًڽأدثأًۄأوۏشتأسڬشأڬشحتأۄەأتًشأوۏشەأىتوأڬۏأًدۄأضەأتځىەأۄًىټًڽأڬًأذشڬحأزۏحتأۄەأۗأٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأ"
"1825","%أذعشحأتثًزشزتؤأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أڬۏتأوۏڽأحوۄۏڽأتۏضەأؼوهأڬۏأرثشأىۄأزًڽأآأدًأحوۄتشەأحوتوأتؼوتهأضەأثۄحشأۄەأتًشأحوۄتشەأوتهڬأڬەأۄتڽأضثأضەأصۏتزۄأځضىزۏزۄأۄەأتًشأضثأضەأصۏتزۄأخًتثأًتهتأۄەأۗأتًشأحوۄتشەأهۏەأضًىتأتًشأډتىزۏأرۏشتحأڬشىەأتًشأدۄتزألۏأضثۏهأتههۄأضەأثۄحشأۄەأۗأظذتثۄأڬشتوأشعۏأتههۄأحؼتهۏٳأؼىۄوأىەأؼشعأڬۏتأ=أۏتأشضًهأتههۄأ﷽أ$أًۄأڬًىأضتأؼوهأۄەأآأإځأ﷽أىەألشوتۏتأ=““أتههۄأڬتأسڬشأ‛‛أتًشأذعشحأوؼتسأثىأدثهأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أإزوۏأڬتأڬًةۏأؼوهأتههۄأحؼتهۏٳأڬەأسڬشأضەأثڔہأڬشأتضأڬًأتههۄأڬەأؼستثأضەأثډتىەأًتهتأىۄۏڽأۄەأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1826","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأهًڲأڬضۏأودهضأوۏڽأثۏټہەأۄًڽأتًشأڬتلۏأزۏشأتضأوۏڽأثۏټہەأشۄۏڽأهۏڬىأًۄأتههۄأحؼتهۏٳأڬەأسڬشأتًشأىثۏأتڬشوأ﷽أځشأزشًزأځڔہەأثؽۏشأتْټہأڬشأډهەأدتةۏڽأحًأًۄأتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأذضشحأصزۄأتًشأطشوىزۄأۄًڽأڲەأۗأ+أإڲەأتههۄأحؼتهۏٳأڬۏأوشعۏأۄەأ؏أتڲشأډتۄەأحًأتىأڬًأؼستثأزەأتًشأډتۄەأحًأتىأڬًأوؼتلأڬشأزەأۗأ"
"1827","%أذعشحأتْؤأتهواوىۏىأضۏٔزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أڬۏأۏۄأؼتزحأحہۏأڬۄأإځأڬضۏأثہۏأودهضأضەأتټہىەأضەأځۄهەأۏًڽأڬۄحەأ=أ"
"أ““أ®ضْثٕذّتىّڬّأتههٔٳہْؤّأشّثٓٔۏأًّثٓذّوٕزٓڬّأهّتأتٓهٳۄّأتٓهّٔتأتّىٕحّأتّضٕحّؽٕلٓشْڬّأًّتّحًْٕثْأتٓهّۏٕڬّ¾أ‛‛أ",""
"أوۏڽأىەأإځأضەأځًډہتأ=أۏتأشضًهأتههۄأ﷽أدثأثہۏأإځأتټہىەأهڲحەأۄۏڽأحًأتڬخشأغًشأځشأۏۄۏأتهلتػأتزتأڬشحەأۄۏڽأ؏أتضأڬۏأڬۏتأًدۄأۄەأآأإځأ﷽أىەألشوتۏتأ=أدًأطرظأڬضۏأثہۏأودهضأضەأتټہىەأضەأمثهأۏۄأڬهوتحأځڔہحتأۄەأتضأڬەأتضأودهضأڬەأحوتوأڲىتۄأثرطأزةۏەأدتحەأۄۏڽأۗأ",""
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1828","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتههۄأحؼتهۏٳألشوتحتأۄەأ=أتەأوۏشەأثىزەأ$أحًأوۏشەأثتشەأوۏڽأدًأڲوتىأشڬہحتأۄەأ؏أوۏڽأتضۏأغشذأۄًڽأتًشأدثأحًأوۏشتأسڬشأڬشحتأۄەأحًأوۏڽأحۏشەأضتحہأۄًحتأۄًڽأۗأ"
"أٰٰأػىأڬەأتهلتػأظذۏذأۄۏڽأ؏أوىمًهأۄۏڽأتًشأزؼتأڬتأسڬشأؽشۏثأظذۏذأۄەأڬۏًىڬۄأوذوزأثىأمتضوأخمۄأشتًۏأۄۏڽأۗأتًشأتضأتضىتزأوۏڽأظتهذأدصشۄأىتوۏأشتًۏأوًدًزأۄۏڽأۗ%أ",""
"1829","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أڬًةۏأثہۏأثىزۄأدًأتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأوحًدۄأۄًأڬشأضًتهأڬشحتأۄەأ؏أتههۄأحؼتهۏٳأتضأڬًأعشًشأؼغتأڬشحتأۄەأۗأۏتأحًأزىۏتأوۏڽأۄۏأزەأزۏحتأۄەأۏتأ+أإرشحأڬەأهۏەأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1830","%أذعشحأضهوتىأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتههۄأحؼتهۏٳأتضأثتحأضەأذۏتؤألشوتحتأۄەأڬۄأثىزۄأثہهتةۏأڬۏأغهثأوۏڽأتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأۄتحہأځہۏهتةەأتًشأًۄأتضأڬًأىتوشتزأًتځضأهًټتأزەأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأۗأتًشأتضأڬۏأضىزأڬًأدؼلشأثىأوۏوًىأىەأتثًؼخوتىأىۄزۏأضەأوًظًهتَأثۏتىأڬۏتأۄەأۗ%أ",""
"2020","%أذعشحأتثىأدشۏدأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأوۏشەأًتهزأىەأثحتۏتأڬۄأضؼۏزأثىأدثۏشأىەأتضأإۏحأ““أ®ًهمأتحۏىڬأضثؼتَأوىأتهوختىۏ¾أ‛‛أڬەأثتشەأوۏڽألشوتۏتأ=أتضأضەأوشتزأ““أتْوأتهمشتىأ‛‛أ+أۏؼىۏأضًشحألتحذۄأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗأتضۏأذزۏخأڬًأؼثزتههۄأثىأوثتشڬأ؏أوذوزأثىأثڬشتهثشضتىۏأ؏أؼثزتهشصتمأثىأہوتوأ؏أذلظأثىأؽۏتخأ؏أؼخوتىأثىأؼوشًأ؏أتًشأؼثزتهودۏزأثىأؼثزتهؼصۏصأىەأتثىأدشۏدأضەأشًتۏحأڬۏتأۄەأحتۄوأتضأڬەأتهلتػأڬډہأورحهلأۄۏڽأۗ%أ",""
"2021","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتأضەأضثؼأوختىۏأڬۏأحلضۏشأڬەأوحؼهمأوشًۏأۄەأڬۄأتضأضەأوشتزأضًشۆألتحذۄأۄەأ؏أتثىأؼثتضأشعۏأتههۄأؼىۄوتأىەأضًشۆألتحذۄأڬًأځڔہتأدضأوۏڽأ®ثضوأتههۄأتهشذوىأتهشذۏو¾أضتحًۏڽأإۏحأحہۏأ؏أتثىأدشۏدألشوتحەأۄۏڽأ=أوۏڽأىەأتځىەأًتهزأضەأڬۄتأ=أڬۏتأإځأڬًأضؼۏزأثىأدثۏشأىەأتثىأؼثتضأشعۏأتههۄأؼىۄوتأڬەأذًتهەأضەأۏۄأثحتۏتأۄەأڬۄأ®ثضوأتههۄأتهشذوىأتهشذۏو¾أمشإىأڬۏأإۏحأۄەأ؏أتىۄًڽأىەأدًتثتَأڬۄتأ=أۄتڽأۗأځہشألشوتۏتأ=أتثىأؼثتضأشعۏأتههۄأؼىۄوتأىوتصأڬۏأزًىًڽأشڬؼحًڽأوۏڽأ““أ®ثضوأتههۄأتهشذوىأتهشذۏو¾أ‛‛أضوۏحألتحذۄأځڔہتأڬشحەأحہەأۗأ"
"أوذوزأثىأثڬشأثىأثشضتىۏأڬۏأذزۏخأ=%أ",""
"2022","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتأىەأۏۄأإۏحأځڔہۏأ=““أ®ًهمزأتٳحۏىتڬأضثؼتَأوىأتهوختىۏأًتهمشإىأتهؼػۏو¾أ‛‛أتًشألشوتۏتأ=أضؼۏزأثىأدثۏشأىەأضًشحألتحذۄأځڔہۏأتًشأتضأڬەأإرشأوۏڽأ““أ®ثضوأتههۄأتهشذوىأتهشذۏو¾أ‛‛أځڔہۏأتًشأڬۄتأ““أ®ثضوأتههۄأتهشذوىأتهشذۏو¾أ‛‛أضتحًۏڽأإۏحأۄەأۗأ+أدشۏدأ"
"أؼثزتهشصتمأثىأہوتوأڬۏأذزۏخأ=%أ",""
"2023","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتأىەأإۏحأ““أ®ًهمزأتٳحۏىتڬأضثؼتَأوىأتهوختىۏ¾أ‛‛أڬەأوحؼهمألشوتۏتأ=أ+أتضأضەأوشتزأ"
"أذلظأثىأؽۏتخأڬۏأذزۏخأ=%أ",""
"2024","أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتأضەأوشًۏأۄەأڬۄأتههۄأحؼتهۏٳأڬەأتضألشوتىأ““أ®ًهمزأتٳحۏىتڬأضثؼتَأوىأتهوختىۏ¾أ‛‛أضەأوشتزأضًشۆألتحذۄأۄەأ؏أتثىأؼثتضأشعۏأتههۄأؼىۄوتأضەأځًډہتأڲۏتأڬۄأضتحًۏڽأإۏحأڬًىأضۏأۄەأآأتىۄًڽأىەأدًتثتَأڬۄتأ=““أ®ثضوأتههۄأتهشذوىأتهشذۏو¾أ‛‛ۗأؼخوتىأثىأؼوشأڬۏأذزۏخأ=أ"
"2025","أذعشحأضؼۏزأثىأدثۏشأشعۏأتههۄأؼىۄأتههۄأحؼتهۏٳأڬەأمًهأ““أ®تهضّٔثؼْأتهوختىۏ¾أ‛‛أڬەأوحؼهمأذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأضەأشًتۏحأڬشحەأۄۏڽأڬۄأتىۄًڽأىەأوۏشەأضتوىەأتځىەأۄتحہأځشأ+أضًشۄٗألتحذۄأڬۏأإۏتحأ"
"2026","أذعشحأتثىأدشۏدأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏشەأًتهزأىەأثحتۏتأڬۄأضؼۏزأثىأدثۏشأىەأ““أ®ًهمزأتٳحۏىتڬأضثؼتأوىأتهوختىۏ¾أ‛‛أڬەأوحؼهمألشوتۏتأ=أتضأضەأوشتزأ““أتوأتهمشإىأ‛‛أ+أضًشۄٗألتحذۄأ"
"2027","%أذعشحأؼخوتىأثىأؼلتىأشعۏأتههۄأؼىۄأضەأوشًۏأۄەأڬۄأشضًهأتههۄأ﷽أضەأ““أ®ثضوأتههۄأتهشذوىأتهشذۏو¾أ‛‛أڬەأوحؼهمأزشۏتلحأڬۏتأڲۏتأحًأإځأ﷽أىەألشوتۏتأ=أۏۄأتههۄأحؼتهۏٳأڬەأتضوتؤأوۏڽأضەأتۏڬأۄەأ؏أتضأوۏڽأتًشأتههۄأحؼتهۏٳأڬەأتضوٓأتؼػوأوۏڽأتحىتأمشثأۄەأدحىتأإىڬہأڬۏأضلۏزأڬتأضۏتۄۏأڬەأضتحہأمشثأۄەأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2028","%أذعشحأؼثزتههۄأثىأتهؼتظأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأطرظأمشإىأځڔہحتأۄەأًۄأىثًحأڬًأتځىەأزتةۏڽأثتةۏڽأمشۏثأڬشأهۏحتأۄەأحتۄوأتضأڬۏأغشلأًذۏأىۄۏڽأإحۏأ+أۏؼىۏأزشدۄأىثًحأڬەأمشۏثأحشۏىأځۄىډأدتحتأۄەأ"
"أۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2029","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أظتذثٓأمشإىأ؏أمۏتوحأڬەأزىأدثأإةەأڲتأحًأمشإىأڬۄەأڲتأ=أتەأوۏشەأشثأ$أتضأڬًأمۏوحۏأهثتضأځۄىتأ؏أحًأتضأڬًأؼصحأڬتأحتدأځۄىتۏتأدتةەأڲتأ؏أمشإىأځہشأڬۄەأڲتأ=أتەأوۏشەأشثأ$أتضأڬۏأؼصحأوۏڽأتعتلۄألشوتأ؏أتەأوۏشەأشثأ$أتضأڬًأشتعۏألشوتأۗأحًأتضأڬًأشتعۏأڬۏتأدتةەأڲتأتًشأتضأڬًأڬۄتأدتةەأڲتأ=أمشإىأځڔہحتأدتأتًشأدىحأڬەأزشدًڽأوۏڽأډڔہحتأدتأتًشأۄشأإۏحأڬەأثزهەأتضأڬۏأىۏڬۏًڽأوۏڽأتعتلۄأۄًحتأدتةەأڲتأۗأٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأ"
"2030","أذعشحأؼثزتههۄأثىأؼوشًأشعۏأتههۄأؼىۄأضەأوشًۏأۄەأڬۄأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أمۏتوحأڬەأزىأظتذثٓأمشإىأضەأڬۄتأدتةەأڲتأ=أمشإىأڬۏأحهتًحأڬشحتأدتأتًشأزشدًڽأوۏڽأډڔہحتأدتأتًشأدضأغشذأحًأزىۏتأوۏڽأټہۄشأټہۄشأڬشأمشإىأڬشۏوأځڔہحتأحہتأ؏أتضۏأغشذأځڔہأڬۏًىڬۄأدۄتڽأحڬأحًأإرشۏأإۏحأڬۏأحهتًحأڬەأًمحأځۄىډەأڲتأًۄۏأحۏشۏأوىصهأۄًأڲۏأۗأ"
"2031","%أذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄأضەأوىمًهأۄەأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أځۄهۏأڬحتثۏڽأتۏڬأۄۏأتىزتصأضەأ؏أتۏڬأۄۏأمشتٗحأڬەأوغتثمأىتصهأۄًةۏڽأ؏أتهثحۄأمشإىأڬشۏوأضتحأمشتؤحًڽأوۏڽأىتصهأۄًتأ؏أتضأوۏڽأڋتىټأثہۏأۄەأ؏أتذڬتوأثہۏأۄۏڽأ؏أووتىؼحۏڽأثہۏأۄۏڽأ؏أذهتهأثہۏأۄۏڽأ؏أذشتوأثہۏأۄۏڽأ؏أوذڬوأثہۏأۄۏڽأ؏أوحطتثۄتحأثہۏأۄۏڽأتًشأثہۏأثۄحأضتشەأتذڬتوأۄۏڽأ؏أتضأهۏەأتضأڬەأذهتهأڬشزۄأڬًأذهتهأدتىًأ؏أتضأڬەأذشتوأڬشزۄأڬًأذشتوأدتىًأ؏أدًأتضأوۏڽأذڬوأزۏتأڲۏتأۄەأتضأځشأؼوهأڬشًأتًشأدضأډۏصأضەأوىؼأڬۏتأڲۏتأۄەأتضأضەأشْڬأدتاأتًشأتضأڬۏأوختهًڽأضەأؼثشحأذتظهأڬشًأتضأڬۏأوذڬوتحأځشأؼوهأڬشًأتًشأتضأڬەأوحطتثۄتحأځشأتۏوتىأشڬہًأتًشأڬۄًأ=أۄوأتىأځشأتۏوتىأهتةەأ؏أضثأڬتأضثأۄوتشەأشثأڬۏأغشلأضەأۄەأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2032","%أذعشحأؼثزتههۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أمشإىأځتڬأڬۏأرًثأزۏڬہأثہتهأڬشًأڬۏًىڬۄأۏۄأًذطۏأتًىټأڬەأتځىۏأشضۏأضەأثہتڲىەأضەأثہۏأصۏتزۄأضرحأغشۏمەأضەأهًڲًڽأڬەأضۏىًڽأضەأثہتڲأدتحتأۄەأۗأتًشأڬًةۏأطرظأۏۄأىۄأڬۄەأڬۄأودہەألهتڽأإۏحأثہًهأڲةۏأۄەأثهڬۄأًۄأرًزأإۏحأڬًأثہًهأڲۏتأۄەأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2033","أذعشحأتضۏزأثىأذعۏشأشعۏأتههۄأؼىۄأضەأوشًۏأۄەأڬۄأًۄأتځىەأڲہشأڬۏأډہحأځشأمشإىأڬشۏوأڬۏأحهتًحأڬۏتأڬشحەأحہەأتًشأإځأڬۏأإًتصأثۄحأرًثظًشحأحہۏأۗأًۄأشضًهأتڬشوأ﷽أڬەأځتضأإةەأ؏أتىۄًڽأىەأإځأڬۏأثتشڲتۄأوۏڽأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أ$أوۏڽأتثہۏأحهتًحأڬشأشۄتأحہتأڬۄأثتزهأدۏضۏأډۏصأىەأودہەأڲہۏشأهۏتأۗأتًشأڲہشأوۏڽأؼًشحًڽأتًشأظذىأوۏڽأڲہًڔەأڬتأثہۏأۏۄأذتهأحہتأتًشأودہەأۏۄأرزطۄأهتذمأۄًأڲۏتأحہتأڬۄأؼًشحۏڽأڲشأځڔۏڽأڲۏأتًشأڲہًڔتأډہًټأ+أڬشأثہتڲأ"
"2034","%أذعشحأتثىأڬؼثأثىأوتهڬأشعۏأتههۄأؼىۄأضەأوشًۏأۄەأڬۄأتضۏزأثىأذعۏشأىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأإةەأځہشأتضأڬەأثؼزأڲصطحۄأذزۏخأدۏضۏأذزۏخأثۏتىأڬۏأۄەأتًشأتضأوۏڽأۏۄأۄەأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتەأتضۏزأځڔہًأ؏أتەأتضۏزأځڔہًأڬۏًىڬۄأًۄألشطحۄأۄەأتًشأحوۄتشۏأحهتًحأضىحتأۄەأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗأتًشأتۏڬأذزۏخأتضأڬۏأطتۄزأثہۏأۄەأدًأڬۄأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأتضأڬًأؼثزتهشذوىأثىأتثۏأهۏهۏأىەأتضۏزأضەأشًتۏحأڬۏتأۄەأۗأ+أدۏضتأڬۄأزشدأسۏهأۄەأ","أۗ%أ"
"2035","أذعشحأؼثزتهشذوىأثىأتثۏأهۏهۏأشعۏأتههۄأؼىۄأضەأوشًۏأۄەأڬۄأتضۏزأثىأذعۏشأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أوۏڽأتۏڬأوشحثۄأشتحأڬەأًمحأضًشۄٗأثمشۄأڬۏأحهتًحأڬشأشۄتأحہتأ؏أدثأوۏڽأضًشۆأڬەأإرشأحڬأځۄىډتأحًأتځىەأځۏډہەأڬضۏأډۏصأڬۏأإًتصأضىۏأحًأوۏڽأۏۄأضودہتأڬۄأطتۏزأوۏشتأڲہًڔتأڬہهأڲۏتأۄەأۗأ+أشضًهأتههۄأ﷽أىەأ"
"2036","%أذعشحأؼثزتههۄأثىأؼوشًأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أشًصۄأتًشأمشإىأزًىًڽأتىضتىأڬۏأطلتؼحأڬشۏڽأڲەأۗأشًصۄأڬۄەأڲتأ=أۏتأتههۄأ$أوۏڽأىەأتضأڬًأزىأوۏڽأڬہتىەأځۏىەأتًشأطۄًحأضەأشًڬەأشڬہتأ؏أتضأڬەأذمأوۏڽأوۏشۏأطلتؼحأمثًهألشوتأۗأتًشأمشإىأڬۄەأڲتأ=أوۏڽأىەأتضأڬًأشتحأوۏڽأضًىەأضەأشًڬەأشڬہتأتًشأتىأزًىًڽأڬۏأطلتؼحأڬًأمثًهأڬۏتأدتةەأڲتأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗ%أ",""
"2037","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أًۄأطرظأدضأڬەأضۏىەأوۏڽأڬډہأثہۏأمشإىأىۄأۄًأًۄأتدڔەأۄًةەأڲہشأڬۏأوتىىزأۄەأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2038","%أذعشحأوؼتسأثىأدثهأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأطرظأثهىزأإًتصأضەأمشإىأڬۏأحهتًحأڬشحتأۄەأ؏أًۄأتضأطرظأڬۏأغشذأۄەأدًأػتۄشأظزمۄأزۏحتأۄەأتًشأدًأطرظأإۄضحۄأإًتصأضەأحهتًحأڬشحتأۄەأًۄأتضأإزوۏأڬۏأغشذأۄەأدًأډہځأڬشأظزمۄأڬشحتأۄەأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗ%أ",""
"2039","%أذعشحأتثًسشأؽلتشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأ+أحذلۄأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2040","%أذعشحأؼثزتههۄأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أثەأطڬأۏۄأمشإىأ؏أتههۄأحؼتهۏٳأڬتأزضحشرًتىأۄەأۗأتضأڬەأزضحشرًتىأضەأدًأڬہتىتأډتۄًأځضىزأڬشأهًأۗأثەأطڬأۏۄأمشإىأتههۄأڬۏأشضٔۏأۄەأتًشأىًشٓوثۏىأۄەأتًشأىلؼأزۏىەأًتهۏأطلتؤأۄەأ؏أدًأتىأځشأؼوهأځۏشتأۄًڽأ؏أۏۄأتىأڬتأوذتلػأۄەأ؏أتځىۏأتحثتؼأڬشىەأًتهًڽأڬەأهۏەأىدتحأ+أزۄىزۄأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأظتهذأثىأؼوشأڬۏأشًتۏتحأىمهأىۄۏڽأڬۏأۄۏڽأۗ%أ",""
"2041","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأطرظأتۏڬأشتحأوۏڽأڬوأتصأڬوأزضأإۏحۏڽأحهتًحأڬشەأ؏أتضأڬتأىتوأؽتلهۏىأوۏڽأىۄۏڽأهڬہتأدتةەأڲتأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗ%أ",""
"2042","أذعشحأ+أؼثزتههۄأ"
"2043","%أذعشحأؼثزتههۄأثىأثشۏزۄأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أمۏتوحأڬەأزىأمشإىأڬشۏوأتۏڬأىًدًتىأإزوۏأڬۏأظًشحأوۏڽأإةەأڲتأتًشأتځىەأمتشۏأضەأڬۄەأڲتأ=أوۏڽأۄًڽأًۄأ؏أدضأىەأحدہەأشتحًڽأوۏڽأدڲتةەأشڬہتأتًشأحدہەأزىأوۏڽأځۏتضتأشڬہتأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗ%أ",""
"2044","%أذعشحأتثًتوتوۄأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأ=أتۏڬأطرظأشضًهأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأتًشأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أ$أوۏڽأىەألهتڽأڬەأثۏټەأومضوأڬًأرشۏزتأۄەأ؏أتضأوۏڽأودہەأثۄحأوىتلؼأذتظهأۄًتأۗأإځأ﷽أىەألشوتۏتأ=أڬۏتأوۏڽأحوۄۏڽأتۏضۏأډۏصأڬۏأرثشأىۄأزًڽأدًأتضأضەأثہۏأصۏتزۄأوىتلؼأثرطأۄەأآأتضأىەأڬۄتأ=أڬۏتأتۏضۏأثہۏأڬًةۏأډۏصأۄەأآأإځأ﷽أىەألشوتۏتأ=أًۄأطرظأدًأمشإىأڬۏأزضأإۏحۏڽأضۏڬہأهەأ+أًۄأتضأضەأثہۏأصۏتزۄأىلؼأوۏڽأۄەأ"
"أٰٰأتڲشأؼوشًأثىأرتهزأىەأتضأڬۏأضىزأوۏڽأضتهوأثىأتثۏأتهدؼزأڬًأوذلًػأڬۏتأۄەأحًأۏۄأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأتهثحۄأوؼحوشأڬەأثظشۏأطتڲشزًڽأىەأتضأوۏڽأتىأڬۏأورتهلحأڬۏأۄەأۗأ+أدۏضتأڬۄأزشدأسۏهأۄەأ","أۗ%أ"
"2045","أوسڬًشۄأضىزأڬەأۄوشتۄأثہۏأتثًتوتوۄأڬەأذًتهەأضەأىثۏأتڬشوأ﷽أڬتأتضۏأدۏضتألشوتىأوىمًهأۄەأۗأ"
"2046","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أهًڲًڽأوۏڽأڬډہأتۄهأتههۄأثہۏأۄًحەأۄۏڽأ؏أظذتثۄأڬشتوأشعۏأتههۄأحؼتهۏٳأؼىۄوأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أ$أًۄأڬًىأۄەأآأإځأ﷽أىەألشوتۏتأ=أتۄهأمشإىأۄۏأحًأتۄهأتههۄأتًشأتضأڬەأرتظأهًڲأۄۏڽأۗأ"
"أۏۄۏأذزۏخأذعشحأتىضأشعۏأتههۄأؼىۄأضەأحۏىأضىزًڽأڬەأۄوشتۄأوىمًهأۄەأۗأتىأحۏىًڽأوۏڽأضەأصۏتزۄأدتوؼأۏۄۏأۄەأۗ%أ",""
"2047","%أذعشحأؼثزتههۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأۄوأىثۏأتڬشوأ﷽أضەأمشإىأڬشۏوأڬۏأزضأإۏحۏڽأضۏڬہأهۏحەأحًأتضأڬەأثؼزأىتصهأۄًىەأًتهۏأزضأإۏتحأضۏڬہىەأضەأځۄهەأۄوأدتىأهۏحەأحہەأڬۄأتْىأإۏتحأوۏڽأڬۏتأۄەأآأطشۏڬأضەأځًډہتأڲۏتأ=أ+أۏؼىۏأۏۄأدتىأهۏحەأڬۄأتىأوۏڽأڬضۏأډۏصأځشأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2048","%أذعشحأتثۏأتثىأڬؼثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أڬۏتأوۏڽأحدہەأتۏضۏأضًشۆأضڬہتاڽأدضأدۏضۏأضًشحأحًشتحأ؏أتىدۏهأ؏أصثًشأوۏڽأىۄۏڽأۄەأتًشأىۄأۄۏأمشإىأوۏڽأ+أڬًةۏأزًضشۏأضًشۆأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗأتضأڬۏأضىزأوۏڽأؼهتؤأثىأؼثزتهشذوىأځشأترحهتلأۄەأۗأډىتىډۄأتضأذزۏخأڬًأوتهڬأثىأتىضأىەأؼهتؤأثىأؼثزتهشذوىأڬەأًتضغەأضەأؼتوشأثىأڬشۏصأڬەأؽهتوأتثًضؼۏزأڬەأسشۏؼەأذعشحأتثۏأثىأڬؼثأضەأشًتۏحأڬۏتأۄەأدثڬۄأطؼثۄأىەأتضأڬًأؼهتؤأثىأؼثزتهشذوىأڬەأًتضغەأضەأتْىأڬەأًتهزأڬەأسشۏؼەأذعشحأتثۏأثىأڬؼثأضەأشًتۏحأڬۏتأۄەأۗ%أ",""
"2049","أذعشحأوتهڬأ؏أؼهتؤأثىأؼثزتهشذوىأشعۏأتههۄأؼىۄأضەأشًتۏحأڬشحەأۄۏڽأڬۄأؼتوشأثىأڬشۏصأڬەأؽهتوأتثًضؼۏزألشوتحەأۄۏڽأڬۄأذعشحأتثۏأثىأڬؼثأىوتصأځڔہأشۄەأحہەأ؏أدثأًۄأىوتصأضەألتشؽأۄًةەأحًأذعًشأ﷽أىەأتىأڬًأشًڬأهۏتأتًشأإځأ﷽أىەأتىأڬتأۄتحہأځڬڔأهۏتأ+أتثًضؼۏزأ"
"2130","%أذعشحأؼوشًأثىأتهؼتظأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ؏أشضًهأتههۄأ﷽أىەأودہەأثهًتۏتأ؏أوۏڽأإځأڬۏأرزوحأوۏڽأذتعشأۄًتأحًأإځأ﷽أىەألشوتۏتأ=أحۏتشۏأڬشأڬەأدىڲهۏأضتصأًأضتوتىأضەأهۏضأۄًأڬشأوۏشەأځتضأإاأۗأ+أؼوشًأثىأتهؼتظأشعۏأتههۄأؼىۄأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗأحتۄوأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأغهثأوتهأڬەأدًتصأوۏڽأذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄأضەأوشًۏأۏۄأذزۏخأىمهأڬۏأۄەأ““أدًأطرظأتځىتأذمأهۏحتأۄەأحًأۏۄأثۄحأۄۏأتډہۏأوززأۄەأ‛‛ۗ%أ",""
"2131","%أذعشحأوؼتسأثىأؼثزتههۄأثىأرثۏثأتهدۄىۏأشعۏأتههۄأؼىۄأتځىەأًتهزأضەأ؏أًۄأتىأڬەأډډتأضەأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أتىأڬەأځتضأحطشۏلأهتةەأحًأإځأځشأؽضهأڬتأتخشأحہتأتًشأإځأثۄحأرًطأ+أىػشأإأشۄەأ"
"أٰٰأۏۄأذزۏخأوزىۏأۄەأ““أظذۏذأتهتضىتزأ‛‛أۄەأتًشأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضەأىمهأىۄۏڽأڬۏتأۄەأتًشأًۄأظذتثۏأدىأضەأضهۏوتىأثىأثهتهأشعۏأتههۄأؼىۄأڬتأضوتؼأختثحأىۄۏڽأۄەأًۄأۏضتشأثىأؼثزتهدۄىۏأشعۏأتههۄأؼىۄأۄۏڽأۗ%أ",""
"2132","%أذعشحأرتهزأثىأذصتوأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأذعشحأذڬۏوأثىأذصتوأشعۏأتههۄأؼىۄأىەأؽصًۄأرۏثشأڬەأزىأزًأڲہًڔًڽأڬەأۄوشتۄأدىڲأهڔۏأتًشأۏۄأزًىًڽأڲہًڔەأدىڲأوۏڽأوتشەأڲةەأ؏أًۄأشضًهأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًةەأتًشأؼشعأڬۏأ=أۏتأشضًهأتههۄأ+أ﷽أ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2133","%أذعشحأتثًذوۏزأضتؼزۏأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أزىۏتأوتىڲىەأوۏڽأوۏتىۄأشًۏأضەأڬتوأهًأڬۏًىڬۄأدًأحوۄتشەأىظۏثأوۏڽأهڬہأزۏتأڲۏتأۄەأًۄأحوۄۏڽأوهأڬشأشۄەأڲتأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2134","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتأضەأشًتۏحأۄەأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أشصمأڬًأإۄضحۄأإۄضحۄأذتظهأوحأڬشًأڬۏًىڬۄأڬًةۏأطرظأتضأًمحأحڬأوشەأڲتأىۄۏڽأدثأحڬأًۄأتځىتأځًشتأشصمأًظًهأىۄۏڽأڬشأهەأڲتأ؏أتضأهۏەأتضأڬۏأغهثأوۏڽأوۏتىۄأشًۏأترحۏتشأڬشًأ؏أذهتهأڬًأترحۏتشأڬشًأتًشأذشتوأضەأتدحىتثأڬشًأۗأ"
"أٰٰأتضأذزۏخأڬۏأتۏڬأطتۄزأذزۏخأثہۏأوًدًزأۄەأدًأڬۄأذعشحأتثًتهصثۏشأشعۏأتههۄأؼىۄوتأىەأذعشحأدتثشأشعۏأتههۄأؼىۄأضەأشًتۏحأڬۏأۄەأتًشأۏۄأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأځشأ““أظذۏذأ‛‛أۄەأۗأ+أۏۄأذزۏخأزشدأسۏهأۄەأ","%أ"
"2135","%أذعشحأدتثشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أحوأوۏڽأضەأڬًةۏأطرظأتضأًمحأحڬأىۄۏڽأوشەأڲتأدثأحڬأتځىتأځًشتأشصمأًظًهأىۄۏڽأڬشأهەأڲتأ؏أتضأهۏەأشصمأڬًأإۄضحۄأإۄضحۄأذتظهأوحأڬشًأتًشأتەأهًڲًأ$أتههۄأضەأڋشًأتًشأ+أزىۏتأڬۏأ"
"أٰٰأتضأڬۏأتۏڬأزًضشۏأطتۄزأذزۏخأثہۏأوًدًزأۄەأدًأڬۄأذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄأضەأوشًۏأۄەأحتۄوأتضأوۏڽأڬډہأتهلتػأڬتأتعتلۄأۄەأ+أًۄأذزۏخأزشدأسۏهأۄەأ","%أ"
"2136","أذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏڽأىەأۄشأتضأؼوهأڬتأحوۄۏڽأذڬوأڬشأزۏتأۄەأدًأدىحأڬەأمشۏثأڬشىەأًتهتأتًشأۄشأتضأؼوهأضەأوىؼأڬۏتأۄەأدًأحوۄۏڽأزًصرأڬەأمشۏثأڬشحتأۄەأۗأتضأهۏەأڬًةۏأطرظأتځىتأشصمأإۄضحۄأإۄضحۄأذتظهأىۄأڬشەأۗأثەأطڬأذعشحأدثشۏهأتوۏىأؼهۏۄأتهضهتوأىەأوۏشەأزهأوۏڽأۏۄأثتحأتهمتأڬۏأۄەأڬۄأ““أحوأوۏڽأضەأڬًةۏأطرظأتځىتأځًشتأشصمأًظًهأڬۏەأثؽۏشأزىۏتأضەأشرظحأىۄۏڽأۄًأڲتأ‛‛أتضأهۏەأتەأهًڲًأ$أتههۄأضەأڋشًأتًشأغهثأوۏڽأوۏتىۄأشًۏأترحۏتشأڬشًأۗأتڲشأڬًةۏأتځىتأشصمأًظًهأڬشىەأوۏڽأحترۏشأڬشەأڲتأحًأۏمۏىتَأًۄأتههۄأحؼتهۏٳأڬۏأىتلشوتىۏأڬەأضتحہأغهثأڬشەأڲتأتًشأ+أۏتزأشڬہۏەأ$أ"
"2137","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أذشتوأوتهأدوؼأڬشىەأًتهەأځشأشطڬأوحأڬشًأۏتأ+أطتۏزأۏۄألشوتۏتأڬۄأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2138","%أذعشحأمۏضأثىأتثۏأؽشصۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأۄوتشۏأمًوأڬًأ““أضوتضشۄأ‛‛أ+أزهتهأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأتضأڬۏأًدۄأځۄهەأۄوأىەأسڬشأڬشأزۏأۄەأۗأًۄأۏۄأڬۄأمۏضأثىأتثۏأؽشصۄأشعۏأتههۄأؼىۄأضەأشًتۏحأڬشىەأوۏڽأتثًًتةهأوىلشزأۄۏڽأۗأتضأذزۏخأڬًأوىظًشأثىأتهوؼحوشأ؏أوؽۏشۄأثىأومضوأتًشأذثۏثأتثىأتثۏأختثحأىەأثہۏأتثًًتةهأضەأشًتۏحأڬۏتأۄەأۗأ",""
"أوىظًشأڬۏأذزۏخأ=%أ",""
"2139","%أوىظًشأىەأتثًًتةهأڬەأًتضغەأضەأذعشحأمۏضأتثىأتثۏأؽشصۄأتهؽلتشۏأشعۏأتههۄأؼىۄأضەأشًتۏحأڬۏأۄەأۗأإځألشوتحەأۄۏڽأ=أۄوأوزۏىۆأتهوىًشۄأوۏڽأًضمًڽأڬۏأرشۏزأًألشًرحأڬۏتأڬشحەأحہەأتًشأۄوأتځىەأإځأڬًأ““أضوتضشۄأ‛‛أ+أزهتهأ"
"أوؽۏشۄأڬۏأذزۏخأ=%أ",""
"2140","%أذعشحأوؽۏشۄأشعۏأتههۄأؼىۄأىەأتثًًتةهأڬەأًتضغەأضەأذعشحأمۏضأثىأتثۏأؽشصۄأشعۏأتههۄأؼىۄأڬتأۏۄأثۏتىأىمهأڬۏتأۄەأ““أىثۏأتڬشوأ﷽أثتصتشأوۏڽأۄوتشەأځتضأحطشۏلأهتةەأتًشألشوتۏتأ=أتەأڲشًۄٓأحتدشتڽأ$أتىأثتصتشًڽأوۏڽأمضوۏڽأطتوهأۄًأدتحۏأۄۏڽأحًأحوأتىأڬًأظزمۄأڬەأضتحہأوهتأهۏتأڬشًأۗأ"
"أذثۏثأتثىأتثۏأختثحأڬۏأذزۏخأ=%أ",""
"2141","%أذعشحأذثۏثأتثىأتثۏأختثحأشعۏأتههۄأؼىۄأىەأتثًًتةهأڬەأًتضغەأضەأذعشحأمۏضأتثىأتثۏأؽشصۄأشعۏأتههۄأؼىۄأڬتأۏۄأثۏتىأىمهأڬۏتأۄەأ=أشضًهأتههۄأ﷽أۄوتشەأځتضأحطشۏلأهتةەأتضأًمحأۄوأهًڲأوزۏىۄأوۏڽأؽهتوًڽأڬۏأحدتشحأڬشحەأحہەأتًشأۄوأتځىەأإځأڬًأ““أضوتضشۄأ‛‛أ+أزهتهأ"
"أٰٰأ+أوسڬًشۄأذزۏخأڬۏأحۏىأضىزۏڽأثۏتىأڬۏأڲةۏأۄۏڽأدثڬۄأ","أۏۄأتهلتػأضلۏتىأخًشۏأڬۏأشًتۏحأڬەأۄۏڽأۗ%أ"
"2142","%أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوضهوتىأ؏أتۏوتىزتشأتًشأضډتأحتدشأمۏتوحأڬەأزىأطۄزتؤأڬەأۄوشتۄأۄًأڲتأۗأ"
"أٰٰأۏۄأڬهخًوأ““أثظشۏأ‛‛أۄۏڽأتًشأتىأڬۏأوشًۏتحأثۄحأڬوأۄۏڽأۗأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتىأڬۏأشًتۏتحأىمهأىۄۏڽأڬۏڽأۗأ",""
"أٰٰأذضىأڬۏأوشتضۏهأوۏڽأوسڬًشۄأذزۏخأڬۏأتۏڬأطتۄزأذزۏخأثہۏأوًدًزأۄەأدًأڬۄأزشدأسۏهأۄەأۗ%أ",""
"2143","أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ؏أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أتۏوتىزتشأ؏أضډتأحتدشأ+أمۏتوحأڬەأزىأ"
"2144","%أذعشحأشلتؼۄأثىأشتلؼأصشمۏأشعۏأتههۄأؼىۄأڬەأثتشەأوۏڽأوشًۏأۄەأڬۄأًۄأشضًهأتههۄأ﷽أڬەأۄوشتۄأؼۏزڲتۄأڬۏأغشلأڲةەأحًأًۄتڽأځشأڬډہأهًڲًڽأڬًأرشۏزأًألشًرحأڬشحەأځتۏتأحًألشوتۏتأ=أتەأڲشًۄٓأحتدشتڽأ$أحًأضثأهًڲأإځأڬۏأغشلأوحًدۄأۄًةەأتًشأتځىۏأڲشزىۏڽأتًشأإىڬہۏڽأشضًهأتههۄأ﷽أڬۏأغشلأتټہتأڬشأزۏڬہىەأهڲەأۗأإځأ﷽أىەألشوتۏتأ=أثەأطڬأحتدشأهًڲأمۏتوحأڬەأزىأتضأذتهحأوۏڽأتټہتةەأدتةۏڽأڲەأڬۄأًۄألتدشأۄًڽأڲەأ؏أضًتةەأتىأحتدشًڽأڬەأدًأتههۄأضەأڋشىەأًتهەأۄۏڽأ؏أىۏڬۏأڬشىەأًتهەأتًشأضډأثًهىەأًتهەأۄۏڽأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2145","%أذعشحأؼثزتهشذوىأثىأطثهأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أثەأطڬأحتدشأهًڲأڲىۄڲتشأۄۏڽأۗأظذتثۄأڬشتوأشعًتىأتههۄأؼهۏۄوأتدوؼۏىأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أ$أڬۏتأتههۄأحؼتهۏٳأىەأحدتشحأڬًأذهتهأىۄۏڽأڬۏتأۄەأآأإځأ﷽أىەأدًتثتَألشوتۏتأ=أۄتڽأۗأهۏڬىأحتدشأهًڲأمضوۏڽأڬہتحەأۄۏڽأدضأڬۏأًدۄأضەأڲىۄڲتشأۄًأدتحەأۄۏڽأتًشأڲلحڲًأڬەأزًشتىأدہًټأثًهحەأۄۏڽأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأتًشأۄطتوأثىأتثۏأؼثزتههۄأىەأتثًشتطزأضەأۏذۏۏأتثىأتثۏأڬخۏشأڬتأضوتؼأختثحأڬۏتأۄەأتًشأۄطتوأخمۄأشتًۏأۄۏڽأتًشأتثتىأثىأۏصۏزأؼغتشأىەأ+أتځىۏأضىزأوۏڽأ","أ+أۏذۏۏأتثىأتثۏأڬخۏشأتًشأتثًشتطزأ"
"2146","أتثتىأثىأۏصۏزأتهؼغتشأىەأۏذۏۏأتثىأڬخۏشأڬەأثؼزأصۏزأثىأضهتوأڬەأًتضغەأضەأتثًشتطزأتهدشتىۏأضەأشًتۏحأڬۏتأۄەأڬۄأؼثزتهشذوىأثىأطثهأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أحتدشأۄۏأڲىۄڲتشأۄۏڽأ؏أحتدشأۄۏأڲىۄڲتشأۄۏڽأ؏أظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أ$أڬۏتأتههۄأحؼتهۏٳأىەأحدتشحأڬًأذهتهأىۄۏڽأڬۏتأۄەأآأإځأ﷽أىەأدًتثتَألشوتۏتأ=أڬۏًڽأىۄۏڽأ؏أهۏڬىأۏۄأڲلحڲًأوۏڽأدہًټأثًهحەأۄۏڽأتًشأمضوۏڽأڬہتحەأۄۏڽأتضأهۏەأڲىۄڲتشأۄًأدتحەأۄۏڽأۗأ"
"2147","أذعشحأؼوشًأثىأحؽهثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أمۏتوحأڬۏأىطتىۏًڽأوۏڽأضەأۏۄأثہۏأۄەأڬۄأوتهأڬۏأڬخشحأۄًأڲۏأ؏أدتۄهًڽأڬۏأڬخشحأۄًأڲۏأ؏ألحىەأػتۄشأۄًڽأڲەأتًشأحدتشحأؼتوأۄًأدتةەأڲۏأۗأٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأتًشأتضأڬۏأضىزأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأځشأظذۏذأۄەأۗأتهثحۄأؼوشًأثىأحؽهثأشعۏأتههۄأؼىۄأڬتأذضىأڬەأؼهتًۄأتًشأزًضشتأڬًةۏأشتًۏأىۄۏڽأۄەأۗأ"
"2148","%أذعشحأدثۏشأثىأوغؼوأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأتۏڬأطرظأشضًهأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأإۏتأتًشأثًهتأ=أۏتأشضًهأتههۄأ﷽أ$أطۄشأڬۏأڬًىضۏأدڲۄأضثأضەأصۏتزۄأثْشۏأۄەأآأإځأ﷽أىەألشوتۏتأ=أودہەأىۄۏڽأوؼهًوأ$أدثأإځأ﷽أڬەأځتضأذعشحأدثشۏهأتوۏىأؼهۏۄأتهضهتوأإةەأحًأإځأ﷽أىەأځًډہتأ=أتەأدثشۏهأ$أطۄشأڬۏأڬًىضۏأدڲۄأضثأضەأصۏتزۄأثْشۏأۄەأآأدثشۏهأىەأدًتثتَأڬۄتأ=أودہەأىۄۏڽأوؼهًوأ؏أوۏڽأتځىەأشثأضەأځًډہأڬشأثحتاڽأڲتأۗأځہشأذعشحأدثشۏهأتوۏىأؼهۏۄأتهضهتوأحطشۏلأهەأڲةەأتًشأڬډہأؼشظۄأڬەأثؼزأحطشۏلأهتةەأتًشأثًهەأ=أتەأوذوزأ+أ﷽أ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأتًشأتضأذزۏخأڬًأمۏضأثىأشثۏؼأتًشأؼوشًأثىأختثحأشعۏأتههۄأؼىۄأىەأتثًتهومزتوأڬەأًتضغەأضەأؼثزتههۄأثىأوذوزأثىأؼمۏهأشعۏأتههۄأؼىۄأضەأشًتۏحأڬۏتأۄەأۗأتۏڬأظذۏذأذزۏخأوسڬًشۄأذزۏخأڬۏأطتۄزأثہۏأۄەأ+أدًأڬۄأزشدأسۏهأۄەأ","%أ"
"2149","أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أتۏڬأطرظأشضًهأتڬشوأ﷽أڬەأځتضأإۏتأتًشأثًهتأ=أۏتأشضًهأتههۄأ+أ﷽أ"
"2150","%أذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أحوأوۏڽأضەأضودہزتشأهًڲأوۏشەأصۏتزۄأمشۏثأشۄتأڬشۏڽأځہشأًۄأدًأتىأڬەأمشۏثأۄۏڽأځہشأًۄأدًأتىأڬەأمشۏثأۄۏڽأتًشأإځضأوۏڽأترحهتلأوحأڬۏتأڬشًأڬۄأ+أتڲشأحوأثەأدتأترحهتلأضەأثتصأىۄۏڽأإاأڲەأحًأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأ؏أهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأىەأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2151","%أذعشحأؼثزتههۄأتثىأتثۏأتًلۏٳأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأطرظأتځىتأضتوتىأثۏډىەأڬەأهۏەأڬہڔتأحہتأۗأتضأىەأتههۄأڬۏأمضوأڬہتأڬشأڬۄتأڬۄأۏۄأضتوتىأتضأڬًأتحىەأوۏڽأځڔتأۄەأذتهتىڬۄأتضأڬًأًۄأضتوتىأتحىەأوۏڽأىۄۏڽأځڔتأحہتأحًأۏۄأإۏحأىتصهأۄًةۏأ=أ"
"أ+أ®تٓىّٔأتهّٔسٓۏٕىّأۏّطٕحّشًْٕىّأثٓؼّہٕزٓتههٔٳۄٓأًّتّۏٕوّتىٓہٓوٕأخّوّىَتأمّهٓۏٕهَت¾أ","أ"
"أ““أدًأتههۄأڬەأؼۄزأتًشأتځىۏأمضوًڽأڬەأثزهەأسهۏهأزتوأهۏحەأۄۏڽأۗ‛‛أ+أحشدوۄأڬىصتهتۏوتىأ؏أتوتوأتذوزأشعتأ","أ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأىەأذعشحأؼوشًأثىأزۏىتشأشعۏأتههۄأؼىۄأتًشأذعشحأتؼوطأشعۏأتههۄأؼىۄأڬۏأتثًظتهذأڬەأًتضغەأضەأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأضەأوشًۏأۏۄأذزۏخأىمهأڬۏأۄەأڬۄأتۏڬأطرظأىەأتځىەأضتوتىأځشأمضوأڬہتةۏأتضأڬەأثؼزأځًشۏأذزۏخأسڬشأڬۏأۗأحتۄوأتضأذزۏخأوۏڽأتًشأضتثمۄأذزۏخأوۏڽأىصًهأإۏحأتًشأزۏڲشأتعتلۄأڬتألشمأۄەأۗ%أ",""
"2152","%أذعشحأؼمثۄأثىأؼتوأتهدۄىۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوضهوتىأ؏أوضهوتىأڬتأثہتةۏأۄەأتًشأڬضۏأوضهوتىأڬەأهۏەأۏۄأدتةصأىۄۏڽأۄەأڬۄأًۄأتځىەأثہتةۏأڬًأڬًةۏأؼۏثأزتشأډۏصأتضأڬتأؼۏثأثۏتىأڬۏەأثؽۏشأثۏډەأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2153","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬتأڲصشأتۏڬأتۏضەأطرظأڬەأځتضأضەأۄًتأدًأڲىزوأثۏډأشۄتأحہتأۗأإځأ﷽أڬًأًۄأتډہتأهڲتأۗأإځأ﷽أىەأؽهەأڬەأڋہۏشأوۏڽأتځىتأۄتحہأڋتهتأحًأتضأوۏڽأڲىزوأڲۏهۏأحہۏأۗأإځأ﷽أىەألشوتۏتأ=أدًأطرظأزہًڬۄأزەأًۄأۄوأوۏڽأضەأىۄۏڽأۄەأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأىەأتضەأتىأتهلتػأڬەأۄوشتۄأىمهأىۄۏڽأڬۏتأۗأدثڬۄأتضأذزۏخأڬًأدؼلشأتثىأتثۏأڬخۏشأڬەأثۏټًڽأوذوزأتًشأتضوتؼۏهأىەأ““أؼهتؤأ‛‛أڬەأًتضغەأضەأشًتۏحأڬۏتأۄەأۗأ",""
"أوذوزأثىأدؼلشأشعۏأتههۄأؼىۄأڬۏأذزۏخأ=%أ",""
"2154","%أوذوزأثىأدؼلشأ؏أؼهتؤأڬەأًتضغەأضەأتىأڬەأًتهزأضەأشًتۏحأڬشحەأۄۏڽأڬۄأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أىثۏأتڬشوأ﷽أثتصتشأوۏڽأحطشۏلأهتةەأ؏أإځأ﷽أىەأًۄتڽأځشأڲىزوأڬتأتۏڬأڋہۏشأزۏڬہتأۗأإځأ﷽أىەأتځىتأۄتحہأتضأڬەأتىزشأڋتهأزۏتأحًأتضأوۏڽأڲۏهتأځىأوذضًضأڬۏتأۗأإځأ﷽أىەألشوتۏتأ=أدًأطرظأۄوأضەأزہًڬۄأڬشەأًۄأۄوأوۏڽأضەأىۄۏڽأۄەأۗأ"
"أتضوتؼۏهأثىأدؼلشأثىأتثۏأڬخۏشأشعۏأتههۄأؼىۄأڬۏأذزۏخأ=%أ",""
"2155","%أتضوتؼۏهأثىأدؼلشأ؏أتثًتهؼهتؤأشعۏأتههۄأؼىۄأڬەأًتضغەأضەأتىأڬەأًتهزأضەأشًتۏحأڬشحەأۄۏڽأڬۄأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أشضًهأتههۄأ﷽أڬتأڲصشأڲىزوأڬەأتۏڬأڋہۏشأڬەأځتضأضەأۄًتأ؏أإځأ﷽أىەأتځىتأۄتحہأتضأڋہۏشأوۏڽأزترهأڬشأزۏتأحًأإځأىەأتىڲهۏًڽأوۏڽأحشۏأوذضًضأڬۏأۗأإځأ﷽أىەألشوتۏتأ=أتەأڲىزوأًتهەأ$أۏۄأڬۏتأۄەأآأتضأىەأدًتثتَأڬۄتأ=أۏتأشضًهأتههۄأ$أثتشطأثشضىەأڬۏأًدۄأضەأۏۄأڲۏهۏأۄًأڲةۏأۄەأۗأإځأ﷽أىەألشوتۏتأ=أحوأىەأتضأ+أڲۏهۏأڲىزوأ"
"أٰٰأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأضۄۏهأڬۏأذزۏخأتىأڬەأًتهزأڬەأذًتهەأضەأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأضەأشًتۏحأڬۏأۄەأڬۄأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدًأطرظأۄوتشەأضتحہأثززۏتىحۏأڬشەأًۄأۄوأوۏڽأضەأىۄۏڽأۄەأۗأحتۄوأتىأتذتزۏخأڬۏأحطشۏذأڬًأطۏرۏىأىەأىمهأىۄۏڽأڬۏتأذتهتىڬۄأًۄأحوتوأڬۏأحوتوأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأځشأظذۏذأۄەأۗ%أ",""
"2156","%أذعشحأؼوۏشأثىأضؼۏزأشعۏأتههۄأؼىۄأتځىەأډډتأڬەأذًتهەأضەأشًتۏحأڬشحەأۄۏڽأ؏أشضًهأتههۄأ﷽أثمۏؼأوۏڽأحطشۏلأهتةەأإځأ﷽أىەأزۏڬہتأڬۄأڬډہأىتحدشثۄأڬتشًڽأڬًأڲىزوأثۏډۏأدتأشۄۏأحہۏأۗأإځأ﷽أىەأتضأوۏڽأتځىتأۄتحہأڋتهتأتًشأتضأوۏڽأضەأڬًةۏأىتځضىزۏزۄأډۏصأىڬهأإةۏأۗأإځأ﷽أىەألشوتۏتأ=أدًأطرظأۄوأضەأثززۏتىحۏأڬشەأًۄأۄوأوۏڽأضەأىۄۏڽأۄەأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأۄەأتًشأؼوۏشأثىأضؼۏزأڬتأډډتأ؏أذتشخأثىأضًۏزأتهىرؼۏأشعۏأتههۄأؼىۄأۄەأۗ%أ",""
"2157","%أتثًضثتؼألشوتحەأۄۏڽأ=أوۏڽأىەأًتخهۄأثىأتضمؼأشعۏأتههۄأؼىۄأڬۏأذًۏهۏأضەأتۏڬأتًىټىۏأرشۏزۏأۗأدثأوۏڽأتضأڬًأهەأڬشأىڬهتأحًأإڲەأضەأًتخهۄأإأوهەأۗأًۄأتځىەأحۄۄأثىزأڬًأڲہضۏټحەأۄًةەأإأشۄتأحہتأۗأتضأىەأځًډہتأ=أتەأؼثزتههۄأ$أڬۏتأۏۄأحوأىەأرشۏزۏأۄەأآأوۏڽأىەأڬۄتأدۏأۄتڽأ$أتضأىەأڬۄتأ=أتضأوۏڽأدًأؼۏثأۄەأًۄأتضأىەأإځأڬەأضتوىەأثۏتىأڬۏتأۄەأآأوۏڽأىەأڬۄتأ=أتضأڬًأڬۏتأۄًتأۄەأآأثػتۄشأحًأوتطتؤأتههۄأۏۄأتډہۏأرتظۏأظذحأوىزأۄەأۗأتضأىەأڬۄتأ=أإځأتضأځشأضلشأڬشىتأډتۄحەأۄًأۏتأڲًطحأڬہتىەأڬەأتشتزەأضەأۏۄأرشۏزۏأۄەأآأوۏڽأىەأڬۄتأ=أوۏڽأىەأذدأځشأدتىەأڬەأهۏەأۏۄأرشۏزۏأۄەأۗأتضأىەأڬۄتأحًأځہشأۏۄأًتځضأڬشأزۏڽأ؏أتضأڬەأوتهڬأىەأڬۄتأ=أۏۄأحوأىەأرًزأۄۏأځضىزأڬۏأحہۏأ؏أتههۄأحؼتهۏٳأإځأڬۏأتظهتذألشوتةەأۗأحًأىەأتضأڬتأىمظأوۏشەأتًځشأػتۄشأڬشأزۏتأۗأځہشألشوتۏتأ=أوۏڽأىەأشضًهأتههۄأ﷽أڬًأۏۄألشوتحەأضْىتأۄەأ““أڬضۏأڬەأهۏەأۏۄأدتةصأىۄۏڽأۄەأڬۄأؼۏثأثحتةەأثؽۏشأڬًةۏأؼۏثأزتشأډۏصأثۏډەأ‛‛ۗأتًشأدًأطرظأتضأڬەأؼۏثأڬًأدتىحتأۄەأتضأڬەأهۏەأدتةصأىۄۏڽأۄەأڬۄأتضأڬًأډہځتةەأۗأ"
