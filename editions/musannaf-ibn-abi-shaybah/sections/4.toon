hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3007","(۳۰۰۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ زَیْدٍ الْعَمِّیِّ ، عَنْ أَبِی الصِّدِّیقِ النَّاجِی ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ أَبَا بَکْرٍ کَانَ یُعَلِّمُہُمُ التَّشَہُّدَ عَلَی الْمِنْبَرِ ، کَمَا یُعَلِّمُ الصِّبْیَانَ فِی الْکُتَّابِ : التَّحِیَّاتُ لِلَّہِ وَالصَّلَوَاتُ وَالطَّیِّبَاتُ ، السَّلاَمُ عَلَیْک أَیُّہَا النَّبِیُّ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ ، السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ۔ (طحاوی ۲۶۴)","Da'if","Musannaf Ibn Abi Shaybah 3007","","","كتاب الصلوات"
"3008","(۳۰۰۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی الْمُتَوَکِّلِ ، قَالَ : سَأَلْنَا أَبَا سَعِیدٍ ، عَنِ التَّشَہُّدِ ؟ فَقَالَ : التَّحِیَّاتُ الصَّلَوَاتُ الطَّیِّبَاتُ لِلَّہِ ، السَّلاَمُ عَلَیْک أَیُّہَا النَّبِیُّ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ ، السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ۔ فَقَالَ أَبُو سَعِیدٍ : کُنَّا لاَ نَکْتُبُ شَیْئًا إِلاَّ الْقُرْآنَ وَالتَّشَہُّدَ۔ (ابوداؤد ۲۴۰)","Sahih","Musannaf Ibn Abi Shaybah 3008","","","كتاب الصلوات"
"3009","(۳۰۰۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدٍ الْقَارِی ، قَالَ : شَہِدْت عُمَرَ بْنَ الْخَطَّابِ یُعَلِّمُ النَّاسَ التَّشَہُّدَ عَلَی الْمِنْبَرِ : التَّحِیَّاتُ لِلَّہِ ، الزَّاکِیَاتُ لِلَّہِ ، الطَّیِّبَاتُ ، الصَّلَوَاتُ لِلَّہِ ، السَّلاَمُ عَلَیْک أَیُّہَا النَّبِیُّ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ ، السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ۔ (مالک ۵۳)","Sahih","Musannaf Ibn Abi Shaybah 3009","","","كتاب الصلوات"
"3010","(۳۰۱۰) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، قَالَ : رَأَیْتُ عَائِشَۃَ تُعِدُّ بِیَدِہَا تَقُولُ : التَّحِیَّاتُ الطَّیِّبَاتُ ، الصَّلَوَاتُ الزَّاکِیَاتُ لِلَّہِ ، السَّلاَمُ عَلَی النَّبِیِّ وَرَحْمَۃُ اللہِ ، السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، قَالَ : ثُمَّ یَدْعُو لِنَفْسِہِ بِمَا بَدَا لَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 3010","","","كتاب الصلوات"
"3011","(۳۰۱۱) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ حَبِیبِ بْنِ الشَّہِیدِ ، قَالَ : سُئِلَ مُحَمَّدٌ عَنِ التَّشَہُّدِ ؟ فَقَالَ : التَّحِیَّاتُ الصَّلَوَاتُ الطَّیِّبَاتُ ، قَالَ : ثُمَّ قَالَ : کَانَ ابْنُ عَبَّاسٍ یَزِیدُ فِیہَا ، الْبَرَکَاتُ۔","Sahih","Musannaf Ibn Abi Shaybah 3011","","","كتاب الصلوات"
"3012","(۳۰۱۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إبْرَاہِیمَ ؛ کَانَ عَلْقَمَۃُ یُعَلِّمُ أَعْرَابِیًّا التَّشَہُّدَ ، فَیَقُولُ عَلْقَمَۃُ : السَّلاَمُ عَلَیْک أَیُّہَا النَّبِیُّ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ وَمَغْفِرَتُہُ ، فَیُعِیدُ الأَعْرَابِیُّ ، فَقَالَ عَلْقَمَۃُ : ہَکَذَا عُلِّمْنَا۔","Sahih","Musannaf Ibn Abi Shaybah 3012","","","كتاب الصلوات"
"3013","(۳۰۱۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سُمِعَ إبْرَاہِیمُ یُعَلِّمُ التَّشَہُّدَ ، التَّحِیَّاتُ لِلَّہِ وَالطَّیِّبَاتُ وَالصَّلَوَاتُ ، السَّلاَمُ عَلَیْک أَیُّہَا النَّبِیُّ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ ، السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ۔","","Musannaf Ibn Abi Shaybah 3013","","","كتاب الصلوات"
"3014","(۳۰۱۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَقُولُ فِی الرَّکْعَتَیْنِ: السَّلاَمُ عَلَیْک أَیُّہَا النَّبِیُّ ، السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ۔","Hasan","Musannaf Ibn Abi Shaybah 3014","","","كتاب الصلوات"
"3015","(۳۰۱۵) حَدَّثَنَا ہُشَیْمٌ بْنُ بَشِیرٍ ، قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أُعْطِیتُ فَوَاتِحَ الْکَلِمِ ، وَخَوَاتِمَہُ ، وَجَوَامِعَہُ ، قَالَ : فَقُلْنَا : عَلِّمْنَا مِمَّا عَلَّمَک اللَّہُ ، قَالَ : فَعَلَّمَنَا التَّشَہُّدَ۔","Da'if","Musannaf Ibn Abi Shaybah 3015","","","كتاب الصلوات"
"3016","(۳۰۱۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ ، عَنْ مُحَارِبٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَلِّمُنَا التَّشَہُّدَ فِی الصَّلاَۃِ ، کَمَا یُعَلِّمُ الْمُکَتِّبُ الْوِلْدَانَ۔ (ابویعلی ۵۶۰۵)","Da'if","Musannaf Ibn Abi Shaybah 3016","","","كتاب الصلوات"
"3017","(۳۰۱۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ السُّلَمِیِّ ، قَالَ : کُنَّا نَتَعَلَّمُ التَّشَہُّدَ کَمَا نَتَعَلَّمُ السُّورَۃَ مِنَ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 3017","","","كتاب الصلوات"
"3018","(۳۰۱۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، قَالَ : رَأَیْتُ عَلْقَمَۃَ یَتَعَلَّمُ التَّشَہُّدَ مِنْ عَبْدِ اللہ ، کَمَا یَتَعَلَّمُ السُّورَۃَ مِنَ الْقُرْآنِ۔","Sahih","Musannaf Ibn Abi Shaybah 3018","","","كتاب الصلوات"
"3019","(۳۰۱۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ حُمَیْدٍ ، قَالَ : حَدَّثَنِی أَبُو الزُّبَیْرِ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَلِّمُنَا التَّشَہُّدَ ، کَمَا یُعَلِّمُنَا السُّورَۃَ مِنَ الْقُرْآنِ۔ (مسلم ۳۰۳۔ احمد ۱/۳۱۵)","Sahih","Musannaf Ibn Abi Shaybah 3019","","","كتاب الصلوات"
"3020","(۳۰۲۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَتَحَفَّظُونَ ہَذَا التَّشَہُّدَ ، تَشَہُّدَ عَبْدِ اللہِ ، وَیَتَّبِعُونَ حُرُوفَہُ حَرْفًا حَرْفًا۔","","Musannaf Ibn Abi Shaybah 3020","","","كتاب الصلوات"
"3021","(۳۰۲۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ شَرِیکٍ ، عَنْ جَامِعِ بْنِ أَبِی رَاشِدٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَلِّمُنَا التَّشَہُّدَ کَمَا یُعَلِّمُنَا السُّورَۃَ مِنَ الْقُرْآنِ۔(ابوداؤد ۹۶۱۔ احمد ۳۹۴)q","Hasan","Musannaf Ibn Abi Shaybah 3021","","","كتاب الصلوات"
"3022","(۳۰۲۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ عُمَیْرِ بْنِ سَعْیدٍ النَّخَعِیِّ ، قَالَ : أَتَیْتُ ابْنَ مَسْعُودٍ مَعَ أَبِی ، فَعَلَّمَنَا ہَذَا التَّشَہُّدَ ، یَعْنِی تَشَہُّدَ عَبْدِ اللہِ۔","","Musannaf Ibn Abi Shaybah 3022","","","كتاب الصلوات"
"3023","(۳۰۲۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا جُوَیْبِرٌ ، عَنِ الضَّحَّاکِ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : مَا کُنَّا نَکْتُبُ فِی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنَ الأَحَادِیثِ إِلاَّ الاسْتِخَارَۃَ وَالتَّشَہُّدَ۔","Da'if","Musannaf Ibn Abi Shaybah 3023","","","كتاب الصلوات"
"3024","(۳۰۲۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : کَانَ عَبْدُ اللہِ یُعَلِّمُنَا التَّشَہُّدَ فِی الصَّلاَۃِ ، کَمَا یُعَلِّمُنَا السُّورَۃَ مِنَ الْقُرْآنِ ، یَأْخُذُ عَلَیْنَا الأَلِفَ وَالْوَاوَ۔","Sahih","Musannaf Ibn Abi Shaybah 3024","","","كتاب الصلوات"
"3025","(۳۰۲۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : سَمِعَ ابْنُ عَبَّاسٍ رَجُلاً یُصَلِّی ، فَلَمَّا قَعَدَ یَتَشَہَّدُ ، قَالَ : الْحَمْدُ لِلَّہِ ، التَّحِیَّاتُ لِلَّہِ ، قَالَ : فَقَالَ ابْنُ عَبَّاسٍ : وَہُوَ یَنْتَہِرُہُ ، الْحَمْدُ لِلَّہِ ، إذَا قَعَدْت فَابْدَأْ بِالتَّشَہُّدِ ، بِـ : التَّحِیَّاتِ لِلَّہِ۔","Sahih","Musannaf Ibn Abi Shaybah 3025","","","كتاب الصلوات"
"3026","(۳۰۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَأْخُذُ عَلَیْنَا الْوَاوَ فِی التَّشَہُّدِ ، الصَّلَوَاتُ وَالطَّیِّبَاتُ۔","","Musannaf Ibn Abi Shaybah 3026","","","كتاب الصلوات"
"3027","(۳۰۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَتَعَلَّمُونَ التَّشَہُّدَ ، کَمَا یَتَعَلَّمُونَ السُّورَۃَ مِنَ الْقُرْآنِ۔","Sahih","Musannaf Ibn Abi Shaybah 3027","","","كتاب الصلوات"
"3028","(۳۰۲۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ أَیْمَنَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ فِی التَّشَہُّدِ : بِسْمِ اللہِ۔","","Musannaf Ibn Abi Shaybah 3028","","","كتاب الصلوات"
"3029","(۳۰۲۹) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ عُمَرَ قَالَ فِی التَّشَہُّدِ : بِسْمِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 3029","","","كتاب الصلوات"
"3030","(۳۰۳۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یَقُولُ إذَا تَشَہَّدَ : بِسْمِ اللہِ ، خَیْرُ الأَسْمَائِ اسْمُ اللہِ۔","Da'if","Musannaf Ibn Abi Shaybah 3030","","","كتاب الصلوات"
"3031","(۳۰۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْحَاقَ بْنِ یَحْیَی ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، قَالَ : سَمِعَ ابْنُ مَسْعُودٍ رَجُلاً یَقُولُ فِی التَّشَہُّدِ : بِسْمِ اللہِ ، فَقَالَ : إنَّمَا یُقَالُ ہَذَا عَلَی الطَّعَامِ۔","Da'if","Musannaf Ibn Abi Shaybah 3031","","","كتاب الصلوات"
"3032","(۳۰۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یَقُولُ فِی التَّشَہُّدِ : بِسْمِ اللہِ۔","","Musannaf Ibn Abi Shaybah 3032","","","كتاب الصلوات"
"3033","(۳۰۳۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی عُبَیْدَۃَ ، عَنْ أَبِیہِ عَبْدِ اللہِ بْنِ مَسْعُودٍ ؛أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا قَعَدَ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ کَأَنَّہُ عَلَی الرَّضْفِ ، قُلْتُ : حتَّی یَقُومَ ؟ قَالَ : حَتَّی یَقُومَ۔ (ابوداؤد ۹۸۷۔ احمد ۱/۳۸۶)","","Musannaf Ibn Abi Shaybah 3033","","","كتاب الصلوات"
"3034","(۳۰۳۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ ، قَالَ : کَانَ أَبُو بَکْرٍ إذَا جَلَسَ فِی الرَّکْعَتَیْنِ کَأَنَّہُ عَلَی الرَّضْفِ ، یَعْنِی حَتَّی یَقُومَ۔","Sahih","Musannaf Ibn Abi Shaybah 3034","","","كتاب الصلوات"
"3035","(۳۰۳۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، عَن رَجُلٍ صَلَّی خَلْفَ أَبِی بَکْرٍ ؛ فَکَانَ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ ، کَأَنَّہُ عَلَی الْجَمْرِ حَتَّی یَقُومَ۔","Majhul","Musannaf Ibn Abi Shaybah 3035","","","كتاب الصلوات"
"3036","(۳۰۳۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخبرنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَجْلِسُ فِی التَّشَہُّدِ فِی الرَّکْعَتَیْنِ قَدْرَ التَّشَہُّدِ مُتَرَسِّلاً ، ثُمَّ یَقُومُ۔","","Musannaf Ibn Abi Shaybah 3036","","","كتاب الصلوات"
"3037","(۳۰۳۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عِیَاضِ بْنِ مُسْلِمٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَقُولُ : مَا جُعِلَتِ الرَّاحَۃُ فِی الرَّکْعَتَیْنِ إِلاَّ لِلتَّشَہُّدِ۔","Majhul","Musannaf Ibn Abi Shaybah 3037","","","كتاب الصلوات"
"3038","(۳۰۳۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ : لاَ یَزِیدُ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ عَلَی التَّشَہُّدِ۔","","Musannaf Ibn Abi Shaybah 3038","","","كتاب الصلوات"
"3039","(۳۰۳۹) حَدَّثَنَا جَرِیرٌ ، عَنْ نُعَیْمٍ الْقَارِیء ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَنْ زَادَ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ عَلَی التَّشَہُّدِ فَعَلَیْہِ سَجْدَتَا السَّہْوَ۔","","Musannaf Ibn Abi Shaybah 3039","","","كتاب الصلوات"
"3040","(۳۰۴۰) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ بُدَیْلٍ ، عَنْ أَبِی الْجَوْزَائِ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ فِی الرَّکْعَتَیْنِ : التَّحِیَّاتُ۔ (ابوداؤد ۷۷۲)","Sahih","Musannaf Ibn Abi Shaybah 3040","","","كتاب الصلوات"
"3041","(۳۰۴۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ زِیَادِ بْنِ فَیَّاضٍ ، قَالَ : سَمِعْتُ مُصْعَبَ بْنَ سَعْدٍ یُحَدِّثُ عَنْ سَعْدٍ ؛ أَنَّہُ کَانَ إذَا تَشَہَّدَ فَقَالَ : سُبْحَانَ اللہِ مِلْئَ السَّمَاوَاتِ وَمِلْئَ الأَرْضِ ، وَمَا بَیْنَہُنَّ ، وَمَا تَحْتَ الثَّرَی ، وَالْحَمْدُ لِلَّہِ مِلْئَ السَّمَاوَاتِ وَمِلْئَ الأَرْضِ ، وَمَا بَیْنَہُنَّ ، وَمَا تَحْتَ الثَّرَی ، وَاللَّہُ أَکْبَرُ مِلْئَ السَّمَاوَاتِ وَمِلْئَ الأَرْضِ ، وَمَا بَیْنَہُنَّ ، وَمَا تَحْتَ الثَّرَی ، قَالَ شُعْبَۃُ : لاَ أَدْرِی اللَّہُ أَکْبَرُ قَبْلُ ، أَوِ الْحَمْدُ لِلَّہِ ، وَالْحَمْدُ لِلَّہِ حَمْدًا طَیِّبًا مُبَارَکًا فِیہِ ، لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ ، وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، اللَّہُمَّ إنِّی أَسْأَلُک مِنَ الْخَیْرِ کُلِّہِ ، ثُمَّ یُسَلِّمُ۔","Sahih","Musannaf Ibn Abi Shaybah 3041","","","كتاب الصلوات"
"3042","(۳۰۴۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، قَالَ : کَانَ عَبْدُ اللہِ یُعَلِّمُنَا التَّشَہُّدَ فِی الصَّلاَۃِ، ثُمَّ یَقُولُ : إذَا فَرَغَ أَحَدُکُمْ مِنَ التَّشَہُّدِ فِی الصَّلاَۃِ فَلْیَقُلِ : اللَّہُمَّ إنِّی أَسْأَلُک مِنَ الْخَیْرِ کُلِّہِ ، مَا عَلِمْت مِنْہُ ، وَمَا لَمْ أَعْلَمْ ، وَأَعُوذُ بِکَ مِنَ الشَّرِّ کُلِّہِ ، مَا عَلِمْت مِنْہُ ، وَمَا لَمْ أَعْلَمْ ، اللَّہُمَّ إنِّی أَسْأَلُک مِنْ خَیْرِ مَا سَأَلَک مِنْہُ عِبَادُک الصَّالِحُونَ ، وَأَعُوذُ بِکَ مِنْ شَرِّ مَا عَاذَ مِنْہُ عِبَادُک الصَّالِحُونَ ، رَبَّنَا آتِنَا فِی الدُّنْیَا حَسَنَۃً وَفِی الآخِرَۃِ حَسَنَۃً وَقِنَا عَذَابَ النَّارِ ، رَبَّنَا إنَّنَا آمَنَّا فَاغْفِرْ لَنَا ذُنُوبَنَا ، وَکَفِّرْ عَنَّا سَیِّئَاتِنَا ، وَتَوَفَّنَا مَعَ الأَبْرَارِ ، رَبَّنَا وَآتِنَا مَا وَعَدْتنَا عَلَی رُسُلِک[corrupt] ، وَلاَ تُخْزِنَا یَوْمَ الْقِیَامَۃِ ، إنَّک لاَ تُخْلِفُ الْمِیعَادَ۔","Sahih","Musannaf Ibn Abi Shaybah 3042","","","كتاب الصلوات"
"3043","(۳۰۴۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، وَأَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : یَتَشَہَّدُ الرَّجُلُ ، ثُمَّ یُصَلِّی عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ یَدْعُو لِنَفْسِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 3043","","","كتاب الصلوات"
"3044","(۳۰۴۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا فَرَغْت مِنَ التَّشَہُّدِ فَادْعُ لِاٰخِرَتِکَ وَدُنْیَاک مَا بَدَا لَک۔","","Musannaf Ibn Abi Shaybah 3044","","","كتاب الصلوات"
"3045","(۳۰۴۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ (ح) وَعَنِ الشَّیْبَانِیِّ عَنِ الشَّعْبِیِّ أَنَّہُمَا قَالاَ : اُدْعُ فِی صَلاَتِکَ بِمَا بَدَا لَک۔","","Musannaf Ibn Abi Shaybah 3045","","","كتاب الصلوات"
"3046","(۳۰۴۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، قَالَ : قُلْتُ لِمُجَاہِدٍ : أَدْعُو لِنَفْسِی فِی الْمَکْتُوبَۃِ ؟ قَالَ : لاَ تَدْعُ لِنَفْسِکَ حَتَّی تَتَشَہَّدَ ۔ قَالَ : وَسَأَلْت عَطَائً ، فَقَالَ : تَحْتَاطُ بِالإسْتِغْفَارِ۔","","Musannaf Ibn Abi Shaybah 3046","","","كتاب الصلوات"
"3047","(۳۰۴۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یُحِبُّونَ أَنْ یَدْعُوَ الإِمَامُ بَعْدَ التَّشَہُّدِ بِخَمْسِ کَلِمَاتٍ جَوَامِعَ : اللَّہُمَّ إنَّا نَسْأَلُک مِنَ الْخَیْرِ کُلِّہِ ، مَا عَلِمْنَا مِنْہُ ، وَمَا لَمْ نَعْلَمْ ، وَنَعُوذُ بِکَ مِنَ الشَّرِّ کُلِّہِ ، مَا عَلِمْنَا مِنْہُ ، وَمَا لَمْ نَعْلَمْ ، قَالَ : فَمَہْمَا عَجِلَ بِہِ الإِمَامُ فَلاَ یَعْجَلْ عَنْ ہَؤُلاَئِ الْکَلِمَاتِ۔","Hasan","Musannaf Ibn Abi Shaybah 3047","","","كتاب الصلوات"
"3048","(۳۰۴۸) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ عَوْنٍ ، قَالَ : قَالَ عَبْدُ اللہِ : اُدْعُوا فِی صَلاَتِکُمْ بِأَہَمِّ حَوَائِجِکُمْ إلَیْکُمْ۔","","Musannaf Ibn Abi Shaybah 3048","","","كتاب الصلوات"
"3049","(۳۰۴۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ عَوْنٍ ، قَالَ : اجْعَلُوا حَوَائِجَکُمُ الَّتِی تَہُمُّکُمْ فِی الصَّلاَۃِ الْمَکْتُوبَۃِ، فَإِنَّ فَضْلَ الدُّعَائِ فِیہَا کَفَضْلِ النَّافِلَۃِ۔","","Musannaf Ibn Abi Shaybah 3049","","","كتاب الصلوات"
"3050","(۳۰۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، عَنْ أَبِی بُرْدَۃَ ، قَالَ : کَانَ أَبُو مُوسَی إذَا فَرَغَ مِنْ صَلاَتِہِ ، قَالَ : اللَّہُمَّ اغْفِرْ لِی ذَنْبِی ، وَیَسِّرْ لِی أَمْرِی ، وَبَارِکْ لِی فِی رِزْقِی۔","Hasan","Musannaf Ibn Abi Shaybah 3050","","","كتاب الصلوات"
"3051","(۳۰۵۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَسْتَحِبُّ أَنْ یَدْعُوَ فِی الْمَکْتُوبَۃِ بِدُعَائِ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 3051","","","كتاب الصلوات"
"3052","(۳۰۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ صَدَقَۃَ بْنِ یَسَارٍ ، قَالَ : سَمِعْتُ طَاوُوسًا یَقُولُ : اُدْعُوا فِی الْفَرِیضَۃِ بِمَا فِی الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 3052","","","كتاب الصلوات"
"3053","(۳۰۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، مِثْلَ حَدِیثِ طَاوُوس۔","","Musannaf Ibn Abi Shaybah 3053","","","كتاب الصلوات"
"3054","(۳۰۵۴) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ صَدَقَۃَ بْنِ یَسَارٍ ، عَنْ طَاوُوسٍ ، قَالَ : اُدْعُوا فِی الْفَرِیضَۃِ بِمَا فِی الْقُرْآنِ ، أَوَ قَالَ : فِی الْمَکْتُوبَۃِ۔","","Musannaf Ibn Abi Shaybah 3054","","","كتاب الصلوات"
"3055","(۳۰۵۵) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، قَالَ : سَمِعْتُ مُحَمَّدًا ، وَسُئِلَ عَنِ الدُّعَائِ فِی الصَّلاَۃِ ؟ فَقَالَ : کَانَ أَحَبُّ دُعَائِہِمْ مَا وَافَقَ الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 3055","","","كتاب الصلوات"
"3056","(۳۰۵۶) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ یَکْرَہُ أَنْ یَدْعُوَ فِی الصَّلاَۃِ بِشَیْئٍ مِنْ أَمْرِ الدُّنْیَا۔","","Musannaf Ibn Abi Shaybah 3056","","","كتاب الصلوات"
"3057","(۳۰۵۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یُعْجِبُہُ أَنْ یَدْعُوَ فِی الْمَکْتُوبَۃِ بِمَا فِی الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 3057","","","كتاب الصلوات"
"3058","(۳۰۵۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ مُصْعَبِ بْنِ ثَابِتٍ ، عَنْ إسْمَاعِیلَ بْنِ مُحَمَّدٍ ، عَنْ عَامِرِ بْنِ سَعْدٍ ، عَنْ سَعْدٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُسَلِّمُ عَنْ یَمِینِہِ ، وَعَنْ یَسَارِہِ ، حَتَّی یُرَی بَیَاضُ خَدِّہِ۔ (مسلم ۱۱۹۔ احمد ۱/۱۷۳)","","Musannaf Ibn Abi Shaybah 3058","","","كتاب الصلوات"
"3059","(۳۰۵۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : سَمِعْتُ أَبَا الْبَخْتَرِیِّ یُحَدِّثُ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْیَحْصُبِیِّ ، عَنْ وَائِلٍ الْحَضْرَمِیِّ ؛ أَنَّہُ صَلَّی مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَکَانَ یُکَبِّرُ إذَا خَفَضَ ، وَإِذَا رَفَعَ ، وَیَرْفَعُ یَدَیْہِ عِنْدَ التَّکْبِیرِ ، وَیُسَلِّمُ عَنْ یَمِینِہِ وَعَنْ یَسَارِہِ۔n قَالَ شُعْبَۃُ : قَالَ لِی أَبَانُ بْنُ تَغْلِبَ : إنَّ فِی الْحَدِیثِ : حَتَّی یَبْدُوَ وَضَحُ وَجْہِہِ ، فَقُلْتُ لِعَمْرٍو : فِی الْحَدِیثِ : حَتَّی یَبْدُوَ وَضَحُ وَجْہِہِ ، فَقَالَ : أَوْ نَحْوُ ذَلِکَ۔ (احمد ۴/۳۱۶۔ طیالسی ۱۰۲۱)","Majhul","Musannaf Ibn Abi Shaybah 3059","","","كتاب الصلوات"
"3060","(۳۰۶۰) حَدَّثَنَا عُمَرُ بْنُ عُبَیْدٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُسَلِّمُ عَنْ یَمِینِہِ حَتَّی یَبْدُوَ بَیَاضُ خَدِّہِ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ ، وَعَنْ یَسَارِہِ مِثْلَ ذَلِکَ۔ (احمد ۱/۴۴۸۔ ابوداؤد ۹۸۸)","Sahih","Musannaf Ibn Abi Shaybah 3060","","","كتاب الصلوات"
"3061","(۳۰۶۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُسَلِّمُ فِی الصَّلاَۃِ عَنْ یَمِینِہِ ، وَعَنْ شِمَالِہِ حَتَّی یُرَی بَیَاضُ وَجْہِہِ وَیَقُولُ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ ، مِنْ کِلاَ الْجَانِبَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 3061","","","كتاب الصلوات"
"3062","(۳۰۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حُرَیْثٍ ، عَنِ الشَّعْبِیِّ ، عَنِ الْبَرَائِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُسَلِّمُ عَنْ یَمِینِہِ وَعَنْ شِمَالِہِ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ ، حَتَّی یُرَی بَیَاضُ خَدِّہِ۔ (طحاوی ۲۶۹۔ دارقطنی ۳۵۷)","Da'if","Musannaf Ibn Abi Shaybah 3062","","","كتاب الصلوات"
"3063","(۳۰۶۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ عَلْقَمَۃَ، وَالأَسْوَدِ ، عَنْ عَبْدِ اللہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُسَلِّمُ عَنْ یَمِینِہِ وَعَنْ یَسَارِہِ ، وَأَبُوبَکْرٍ، وَعُمَرُ۔ (نسائی ۱۲۴۲۔ طیالسی ۲۷۹)","Sahih","Musannaf Ibn Abi Shaybah 3063","","","كتاب الصلوات"
"3064","(۳۰۶۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الْعَلاَئِ بْنِ صَالِحٍ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ حُجْرِ بْنِ عَنْبَسٍ، عَنْ وَائِلِ بْنِ حُجْرٍ؛ أَنَّہُ صَلَّی خَلْفَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا قَرَأَ فَاتِحَۃَ الْکِتَابِ جَہَرَ بِآمِینَ ، قَالَ : وَسَلَّمَ عَنْ یَمِینِہِ وَعَنْ یَسَارِہِ ، حَتَّی رَأَیْت بَیَاضَ خَدَّیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 3064","","","كتاب الصلوات"
"3065","(۳۰۶۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، قَالَ : ذُکِرَ التَّسْلِیمُ عِنْدَ شَقِیقٍ ، فَقَالَ : قَدْ صَلَّیْت خَلْفَ عُمَرَ ، وَعَبْدِ اللہِ فَکِلاَہُمَا یُسَلِّمُ یَقُولُ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ ، السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ۔","Hasan","Musannaf Ibn Abi Shaybah 3065","","","كتاب الصلوات"
"3066","(۳۰۶۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حَارِثَۃَ بْنِ مُضَرِّبٍ ، قَالَ : صَلَّیْت خَلْفَ عَمَّارٍ فَسَلَّمَ عَنْ یَمِینِہِ وَعَنْ شِمَالِہِ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 3066","","","كتاب الصلوات"
"3067","(۳۰۶۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ فُضَیْلٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، قَالَ : کَأَنِّی أَنْظُرُ إلَی بَیَاضِ خَدِّ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَلَّمَ حِینَ سَلَّمَ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ ، السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ۔ (احمد ۴۶۵)","","Musannaf Ibn Abi Shaybah 3067","","","كتاب الصلوات"
"3068","(۳۰۶۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقِ بْنِ سَلَمَۃَ ، قَالَ : صَلَّیْت خَلْفَ عَلِیٍّ ، فَسَلَّمَ عَنْ یَمِینِہِ وَعَنْ شِمَالِہِ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ ، السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 3068","","","كتاب الصلوات"
"3069","(۳۰۶۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إِسْمَاعِیلَ بْنِ سُمَیْعٍ ، قَالَ : سَمِعْتُ أَبَا رَزِینٍ یَقُولُ : سَمِعْت عَلِیًّا یُسَلِّمُ فِی الصَّلاَۃِ عَنْ یَمِینِہِ وَعَنْ شِمَالِہِ ، وَالَّتِی عَنْ شِمَالِہِ أَخْفَضُ۔","Sahih","Musannaf Ibn Abi Shaybah 3069","","","كتاب الصلوات"
"3070","(۳۰۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ إبْرَاہِیمَ بْنِ سُوَیْد ، قَالَ : کَانَ عَلْقَمَۃُ یُسَلِّمُ عَنْ یَمِینِہِ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ ، وَعَنْ یَسَارِہِ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ ، قَالَ : وَکَانَ الأَسْوَدُ یَقُولُ عَنْ یَمِینِہِ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ ، وَعَنْ یَسَارِہِ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ۔","","Musannaf Ibn Abi Shaybah 3070","","","كتاب الصلوات"
"3071","(۳۰۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ خَیْثَمَۃَ ، أَنَّہُ قَالَ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ، السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ۔","","Musannaf Ibn Abi Shaybah 3071","","","كتاب الصلوات"
"3072","(۳۰۷۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُسَلِّمُ فِی الصَّلاَۃِ یَقُولُ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ ، السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ۔","","Musannaf Ibn Abi Shaybah 3072","","","كتاب الصلوات"
"3073","(۳۰۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ کَانَ یُسَلِّمُ عَنْ یَمِینِہِ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ ، وَعَنْ یَسَارِہِ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ۔","","Musannaf Ibn Abi Shaybah 3073","","","كتاب الصلوات"
"3074","(۳۰۷۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یُسَلِّمُ عَنْ یَمِینِہِ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ ، یَرْفَعُ بِہَا صَوْتَہُ ، وَعَنْ یَسَارِہِ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ ، أَخْفَضَ مِنَ الأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 3074","","","كتاب الصلوات"
"3075","(۳۰۷۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ سَعِیدًا وَعَمَّارًا سَلَّمَا تَسْلِیمَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 3075","","","كتاب الصلوات"
"3076","(۳۰۷۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِیہِ ؛ أَنَّ إمَامَ مَسْجِدِ مَسْرُوقٍ کَانَ یُسَلِّمُ تَسْلِیمَتَیْنِ ، فَقُلْنَا لِمَسْرُوقٍ ؟ فَقَالَ : أَنَا أَمَرْتُہُ بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 3076","","","كتاب الصلوات"
"3077","(۳۰۷۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، وَوَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنِ ابْنِ أَبِی لَیْلَی ؛ أَنَّہُ کَانَ یُسَلِّمُ عَنْ یَمِینِہِ وَعَنْ یَسَارِہِ : السَّلاَمُ عَلَیْکُمْ ، السَّلاَمُ عَلَیْکُمْ۔","","Musannaf Ibn Abi Shaybah 3077","","","كتاب الصلوات"
"3078","(۳۰۷۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی مَعْمَرٍ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ قِیلَ لَہُ : إنَّ رَجُلاً مِنْ أَہْلِ مَکَّۃَ یُسَلِّمُ تَسْلِیمَتَیْنِ ، فَقَالَ عَبْدُ اللہِ : أَنَّی عَلِقَہَا ؟ ! (مسلم ۱۱۷)","Sahih","Musannaf Ibn Abi Shaybah 3078","","","كتاب الصلوات"
"3079","(۳۰۷۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ ثَابِتِ بْنِ یَزِیدَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ؛ أَنَّہُ کَانَ یُسَلِّمُ تَسْلِیمَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 3079","","","كتاب الصلوات"
"3080","(۳۰۸۰) حَدَّثَنَا مَخْلَدُ بْنُ یَزِیدَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ یُسَلِّمُ تَسْلِیمَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 3080","","","كتاب الصلوات"
"3081","(۳۰۸۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبَا بَکْرٍ ، وَعُمَرَ ، کَانُوا یُسَلِّمُونَ تَسْلِیمَۃً وَاحِدَۃً۔ (ابن ماجہ ۹۲۰۔ بیہقی ۱۷۹)","Da'if","Musannaf Ibn Abi Shaybah 3081","","","كتاب الصلوات"
"3082","(۳۰۸۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ حُمَیْدٍ ، قَالَ : کَانَ أَنَسٌ یُسَلِّمُ وَاحِدَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 3082","","","كتاب الصلوات"
"3083","(۳۰۸۳) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ سَعِیدِ بْنِ مَرْزُبَانَ ، قَالَ : صَلَّیْت خَلْفَ ابْنِ أَبِی لَیْلَی فَسَلَّمَ وَاحِدَۃً ، ثُمَّ صَلَّیْتُ خَلْفَ عَلِیٍّ فَسَلَّمَ وَاحِدَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 3083","","","كتاب الصلوات"
"3084","(۳۰۸۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ الزِّبْرِقَانِ ؛ أَنَّ أَبَا وَائِلٍ کَانَ یُسَلِّمُ تَسْلِیمَۃً۔","","Musannaf Ibn Abi Shaybah 3084","","","كتاب الصلوات"
"3085","(۳۰۸۵) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ یَحْیَی بْنِ وَثَّابٍ ؛ أَنَّہُ کَانَ یُسَلِّمُ تَسْلِیمَۃً۔","","Musannaf Ibn Abi Shaybah 3085","","","كتاب الصلوات"
"3086","(۳۰۸۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، قَالَ : صَلَّیْت خَلْفَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَسَلَّمَ وَاحِدَۃً۔","","Musannaf Ibn Abi Shaybah 3086","","","كتاب الصلوات"
"3087","(۳۰۸۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ أَنَّہُمَا کَانَا یُسَلِّمَانِ تَسْلِیمَۃً عَنْ أَیْمَانِہِمَا ، وَصَلَّیْت خَلْفَ الْقَاسِمِ فَلاَ أَعْلَمُہُ خَالَفَہُمَا۔","","Musannaf Ibn Abi Shaybah 3087","","","كتاب الصلوات"
"3088","(۳۰۸۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ خَالِدٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُسَلِّمُ تَسْلِیمَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 3088","","","كتاب الصلوات"
"3089","(۳۰۸۹) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا جَابِرُ بْنُ حَازِمٍ ، عَنْ أَیُّوبَ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَلَّمَ تَسْلِیمَۃً۔","","Musannaf Ibn Abi Shaybah 3089","","","كتاب الصلوات"
"3090","(۳۰۹۰) حَدَّثَنَا أَبُو بَکْرٍ ، بَلَغَنِی عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ تُسَلِّمُ تَسْلِیمَۃً۔ (ابن خزیمۃ ۷۳۲۔ بیہقی ۱۷۹)","","Musannaf Ibn Abi Shaybah 3090","","","كتاب الصلوات"
"3091","(۳۰۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ دِرْہَمٍ ، قَالَ : رَأَیْتُ أَنَسًا ، وَالْحَسَنَ ، وَأَبَا الْعَالِیَۃِ ، وَأَبَا رَجَائٍ یُسَلِّمُونَ تَسْلِیمَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 3091","","","كتاب الصلوات"
"3092","(۳۰۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُلَیْمَانَ بْنِ زَیْدٍ ، قَالَ : رَأَیْتُ ابْنَ أَبِی أَوْفَی یُسَلِّمُ تَسْلِیمَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 3092","","","كتاب الصلوات"
"3093","(۳۰۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ دِینَارٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُسَلِّمُ تَسْلِیمَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 3093","","","كتاب الصلوات"
"3094","(۳۰۹۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ وِقَائٍ ؛ أَنَّ سَعِیدَ بْنَ جُبَیْرٍ کَانَ یُسَلِّمُ تَسْلِیمَۃً۔","","Musannaf Ibn Abi Shaybah 3094","","","كتاب الصلوات"
"3095","(۳۰۹۵) حَدَّثَنَا مُصْعَبُ بْنُ الْمِقْدَامِ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ سُوَیْد ؛ أَنَّہُ کَانَ یُسَلِّمُ تَسْلِیمَۃً وَاحِدَۃً۔","","Musannaf Ibn Abi Shaybah 3095","","","كتاب الصلوات"
"3096","(۳۰۹۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، أَنَّہُ کَانَ یُسَلِّمُ تَسْلِیمَۃً۔","","Musannaf Ibn Abi Shaybah 3096","","","كتاب الصلوات"
"3097","(۳۰۹۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ : کَانَ عَبْدُ اللہِ إذَا قَضَی الصَّلاَۃَ انْفَتَلَ سَرِیعًا ، فَإِمَّا أَنْ یَقُومَ ، وَإِمَّا أَنْ یَنْحَرِفَ۔","Sahih","Musannaf Ibn Abi Shaybah 3097","","","كتاب الصلوات"
"3098","(۳۰۹۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، وَخَالِدٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ الإِمَامُ إذَا سَلَّمَ قَامَ ، وَقَالَ خَالِدٌ : انْحَرَفَ۔","Sahih","Musannaf Ibn Abi Shaybah 3098","","","كتاب الصلوات"
"3099","(۳۰۹۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی رَزِینٍ ، قَالَ : صَلَّیْت خَلْفَ عَلِیٍّ فَسَلَّمَ عَنْ یَمِینِہِ وَعَنْ یَسَارِہِ ، ثُمَّ وَثَبَ کَمَا ہُوَ۔","Sahih","Musannaf Ibn Abi Shaybah 3099","","","كتاب الصلوات"
"3100","(۳۱۰۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ عُمَرُ : جُلُوسُ الإِمَامِ بَعْدَ التَّسْلِیمِ بِدْعَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 3100","","","كتاب الصلوات"
"3101","(۳۱۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ أَبِی حَصِینٍ ، قَالَ : کَانَ أَبُو عُبَیْدَۃَ بْنُ الْجَرَّاحِ إذَا سَلَّمَ کَأَنَّہُ عَلَی الرَّضْفِ ، حَتَّی یَقُومَ۔","","Musannaf Ibn Abi Shaybah 3101","","","كتاب الصلوات"
"3102","(۳۱۰۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا سَلَّمَ لَمْ یَقْعُدْ إِلاَّ مِقْدَارَ مَا یَقُولُ : اللَّہُمَّ أَنْتَ السَّلاَمُ وَمِنْک السَّلاَمُ تَبَارَکْتَ یَا ذَا الْجَلاَلِ وَالإِکْرَامِ۔ (مسلم ۱۳۶۔ ترمذی ۲۹۹)","Sahih","Musannaf Ibn Abi Shaybah 3102","","","كتاب الصلوات"
"3103","(۳۱۰۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ عَوْسَجَۃَ بْنِ الرَّمَّاحِ ، عَنِ ابْنِ أَبِی الْہُذَیْلِ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا سَلَّمَ لَمْ یَجْلِسْ إِلاَّ مِقْدَارَ مَا یَقُولُ اللَّہُمَّ أَنْتَ السَّلاَمُ ، وَإِلَیْکَ السَّلاَمُ ، تَبَارَکْتَ یَا ذَا الْجَلاَلِ وَالإِکْرَامِ۔ (ابن حبان ۲۰۰۲۔ ابن خزیمۃ ۷۳۶)","Sahih","Musannaf Ibn Abi Shaybah 3103","","","كتاب الصلوات"
"3104","(۳۱۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی سِنَان ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : کَانَ لَنَا إمَامٌ ، ذکر مِنْ فَضْلِہِ ، إذَا سَلَّمَ تَقَدَّمَ۔","","Musannaf Ibn Abi Shaybah 3104","","","كتاب الصلوات"
"3105","(۳۱۰۵) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ: کُلُّ صَلاَۃٍ بَعْدَہَا تَطَوُّعٌ فَتَحَوَّلْ، إِلاَّ الْعَصْرَ وَالْفَجْرَ۔","","Musannaf Ibn Abi Shaybah 3105","","","كتاب الصلوات"
"3106","(۳۱۰۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَمَّا الْمَغْرِبُ فَلاَ تَدَعْ أَنْ تَحَوَّلَ۔","","Musannaf Ibn Abi Shaybah 3106","","","كتاب الصلوات"
"3107","(۳۱۰۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ إذَا سَلَّمَ انْحَرَفَ ، أَوْ قَامَ سَرِیعًا۔","","Musannaf Ibn Abi Shaybah 3107","","","كتاب الصلوات"
"3108","(۳۱۰۸) حَدَّثَنَا أَبُو دَاوُدَ، عَنْ زَمْعَۃَ، عَنِ ابْنِ طَاوُوس، عَنْ أَبِیہِ، أَنَّہُ کَانَ إذَا سَلَّمَ قَامَ فَذَہَبَ کَمَا ہُوَ، وَلَمْ یَجْلِسْ۔","","Musannaf Ibn Abi Shaybah 3108","","","كتاب الصلوات"
"3109","(۳۱۰۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ إذَا سَلَّمَ انْحَرَفَ ، وَاسْتَقْبَلَ الْقَوْمَ۔","","Musannaf Ibn Abi Shaybah 3109","","","كتاب الصلوات"
"3110","(۳۱۱۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یَعْلَی بْنُ عَطَائٍ ، عَنْ جَابِرِ بْنِ یَزِیدَ بْنِ الأَسْوَدِ الْعَامِرِیِّ ، عَنْ أَبِیہِ ، قَالَ : صَلَّیْت مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْفَجْرَ ، فَلَمَّا سَلَّمَ انْحَرَفَ۔ (ترمذی ۲۱۹۔ احمد ۱۶۱)","Sahih","Musannaf Ibn Abi Shaybah 3110","","","كتاب الصلوات"
"3111","(۳۱۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی عَاصِمٍ الثَّقَفِیِّ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ؛ أَنَّ عَلِیًّا لَمَّا انْصَرَفَ اسْتَقْبَلَ الْقَوْمَ بِوَجْہِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 3111","","","كتاب الصلوات"
"3112","(۳۱۱۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : حَدَّثَنِی شَیْخٌ ، عَنْ صِلَۃَ بْنِ زُفَرَ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ فِی دُبُرِ الصَّلاَۃِ : اللَّہُمَّ أَنْتَ السَّلاَمُ ، وَمِنْک السَّلاَمُ ، تَبَارَکْت یَا ذَا الْجَلاَلِ وَالإِکْرَامِ ۔ ثُمَّ صَلَّیْتُ إلَی جَنْبِ عَبْدِ اللہِ بْنِ عَمْرٍو ، فَسَمِعْتُہُ یَقُولُہُنَّ ، قَالَ : فَقُلْتُ لَہُ : إنِّی سَمِعْت ابْنَ عُمَرَ یَقُولُ مِثْلَ الَّذِی تَقُولُ ، فَقَالَ عَبْدُ اللہِ بْنُ عَمْرٍو : إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُہُنَّ۔ (طبرانی ۶۵۰)","Majhul","Musannaf Ibn Abi Shaybah 3112","","","كتاب الصلوات"
"3113","(۳۱۱۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ وَرَّادٍ مَوْلَی الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، قَالَ : کَتَبَ مُعَاوِیَۃُ إلَی الْمُغِیرَۃِ بْنِ شُعْبَۃَ : أَیُّ شَیْئٍ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ ، إذَا سَلَّمَ مِنَ الصَّلاَۃِ ؟ قَالَ : فَأَمْلاَہَا عَلَی الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، فَکَتَبَ بِہَا إلَی مُعَاوِیَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ إذَا سَلَّمَ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ ، وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، اللَّہُمَّ لاَ مَانِعَ لِمَا أَعْطَیْت ، وَلاَ مُعْطِیَ لِمَا مَنَعْت ، وَلاَ یَنْفَعُ ذَا الْجَدِّ مِنْک الْجَدُّ۔ n(مسلم ۴۱۵۔ ابوداؤد ۱۵۰۰)","Sahih","Musannaf Ibn Abi Shaybah 3113","","","كتاب الصلوات"
"3114","(۳۱۱۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی ہَارُونَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ غَیْرَ مَرَّۃٍ یَقُولُ فِی آخِرِ صَلاَتِہِ عِنْدَ انْصِرَافِہِ : سُبْحَانَ رَبِّکَ رَبِّ الْعِزَّۃِ عَمَّا یَصِفُونَ وَسَلاَمٌ عَلَی الْمُرْسَلِینَ وَالْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ۔ (طیالسی ۲۱۹۸۔ ابو یعلی ۱۱۱۸)","Da'if","Musannaf Ibn Abi Shaybah 3114","","","كتاب الصلوات"
"3115","(۳۱۱۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ أَبِی الْیَقْظَانِ ، عَنْ حُصَیْنِ بْنِ یَزِیدَ الثَّعْلَبِیِّ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ؛ أَنَّہُ کَانَ یَقُولُ إذَا فَرَغَ مِنَ الصَّلاَۃِ : اللَّہُمَّ إنِّی أَسْأَلُک مِنْ مُوجِبَاتِ رَحْمَتِکَ ، وَعَزَائِمَ مَغْفِرَتِکَ ، وَأَسْأَلُک الْغَنِیمَۃَ مِنْ کُلِّ بِرٍّ ، وَالسَّلاَمَۃَ مِنْ کُلِّ إِثْمَ ، اللَّہُمَّ إنِّی أَسْأَلُک الْفَوْزَ بِالْجَنَّۃِ وَالْجَوَازَ مِنَ النَّارِ ، اللَّہُمَّ لاَ تَدَعْ لَنَا ذَنْبًا إِلاَّ غَفَرْتَہُ ، وَلاَ ہَمًّا إِلاَّ فَرَّجْتَہُ ، وَلاَ حَاجَۃً إِلاَّ قَضَیْتَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 3115","","","كتاب الصلوات"
"3116","(۳۱۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ السَّلاَمِ بْنِ شَدَّادٍ الْجُرَیْرِیِّ ، عَنْ غَزْوَانَ بْنِ جَرِیرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، أَنَّہُ قَالَ حِینَ سَلَّمَ : لاَ إلَہَ إِلاَّ اللَّہُ ، وَلاَ نَعْبُدُ إِلاَّ اللَّہَ۔","Majhul","Musannaf Ibn Abi Shaybah 3116","","","كتاب الصلوات"
"3117","(۳۱۱۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ عَوْسَجَۃَ ، عَنِ ابْنِ أَبِی الْہُذَیْلِ ، عَنْ عَبْدِ اللہِ ، وَعَنْ عَاصِمٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ إِذَا سَلَّمَ : اللَّہُمَّ أَنْتَ السَّلاَمُ وَمِنْک السَّلاَمُ ۔ إِلاَّ أَنَّ فِی حَدِیثِ عَبْدِ اللہِ : وَإِلَیْک السَّلاَمُ ، تَبَارَکْت یَا ذَا الْجَلاَلِ وَالإِکْرَامِ۔","Sahih","Musannaf Ibn Abi Shaybah 3117","","","كتاب الصلوات"
"3118","(۳۱۱۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، قَالَ : کَانَ إبْرَاہِیمُ إذَا سَلَّمَ أَقْبَلَ عَلَیْنَا بِوَجْہِہِ وَہُوَ یَقُولُ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ۔","","Musannaf Ibn Abi Shaybah 3118","","","كتاب الصلوات"
"3119","(۳۱۱۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ : مَرَرْت أَنَا وَعُبَیْدَۃُ فِی الْمَسْجِدِ ، وَمُصْعَبٌ یُصَلِّی بِالنَّاسِ ، فَلَمَّا انْصَرَفَ ، فَقَالَ : لاَ إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ ، رَفَعَ بِہَا صَوْتَہُ ، فَقَالَ عبیدَۃُ : قَاتَلَہُ اللَّہُ تَعَالَی ، نَعَّارٌ بِالْبِدَعِ۔","","Musannaf Ibn Abi Shaybah 3119","","","كتاب الصلوات"
"3120","(۳۱۲۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنِ ابْنِ أَبِی الْہُذَیْلِ ، قَالَ : کَانُوا یَقُولُونَ إذَا انْصَرَفُوا مِنَ الصَّلاَۃِ : اللَّہُمَّ أَنْتَ السَّلاَمُ وَمِنْک السَّلاَمُ ، تَبَارَکْت یَا ذَا الْجَلاَلِ وَالإِکْرَامِ۔","","Musannaf Ibn Abi Shaybah 3120","","","كتاب الصلوات"
"3121","(۳۱۲۱) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : ذَکَرْت لِلْقَاسِمِ أَنَّ رَجُلاً مِنْ أَہْلِ الْیَمَنِ ذَکَرَ لِی : أَنَّ النَّاسَ کَانُوا إذَا سَلَّمَ الإِمَامُ مِنْ صَلاَۃِ الْمَکْتُوبَۃِ کَبَّرُوا ثَلاَثَ تَکْبِیرَاتٍ ، أَوْ تَہْلِیلاَتٍ ، فَقَالَ الْقَاسِمُ : وَاللَّہِ إِنْ کَانَ ابْنُ الزُّبَیْرِ لِیَصْنَع ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 3121","","","كتاب الصلوات"
"3122","(۳۱۲۲) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الأَعْمَشِ ، قَالَ : سُئِلَ إبْرَاہِیمُ عَنِ الإِمَامِ إذَا سَلَّمَ فَیَقُولُ : صَلَّی اللَّہُ عَلَی مُحَمَّدٍ ، وَلاَ إلَہَ إِلاَّ اللَّہُ ؟ فَقَالَ : مَا کَانَ مَنْ قَبْلَہُمْ یَصْنَعُ ہَکَذَا۔","","Musannaf Ibn Abi Shaybah 3122","","","كتاب الصلوات"
"3123","(۳۱۲۳) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الأَعْمَشِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ : ہَذِہِ بِدْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 3123","","","كتاب الصلوات"
"3124","(۳۱۲۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنِی مُعَاوِیَۃُ بْنُ صَالِحٍ ، قَالَ : حَدَّثَنِی مَالِکُ بْنُ زِیَادٍ الأَشْجَعِیُّ ، قَالَ: سَمِعْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَقُولُ : مِنْ تَمَامِ الصَّلاَۃِ أَنْ تَقُولَ إذَا فَرَغْتَ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ ، وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، ثَلاَثَ مَرَّاتٍ۔","","Musannaf Ibn Abi Shaybah 3124","","","كتاب الصلوات"
"3125","(۳۱۲۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنِ الأَسْوَدِ ، قَالَ : قَالَ عَبْدُ اللہِ : لاَ یَجْعَلَنَّ أَحَدُکُمْ لِلشَّیْطَانِ مِنْ نَفْسِہِ جُزْئً ا ، لاَ یَرَی إِلاَّ أَنَّ حَقًّا عَلَیْہِ أَِنْ لاَ یَنْصَرِفَ إِلاَّ عَنْ یَمِینِہِ ، أَکْثَرُ مَا رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْصَرِفُ عَنْ شِمَالِہِ۔ (بخاری ۸۵۲۔ ابوداؤد ۱۰۳۵)","Sahih","Musannaf Ibn Abi Shaybah 3125","","","كتاب الصلوات"
"3126","(۳۱۲۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سِمَاکِ بْنِ حَرْبٍ ، قَالَ : سَمِعْتُ قَبِیصَۃَ بْنِ ہُلْبٍ یُحَدِّثُ ، عَنْ أَبِیہِ ؛ أَنَّہُ صَلَّی مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَرَآہُ یَنْصَرِفُ عَنْ شِقَّیْہِ۔ (احمد ۲۲۷۔ طیالسی ۱۰۸۷)","Majhul","Musannaf Ibn Abi Shaybah 3126","","","كتاب الصلوات"
"3127","(۳۱۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّیّ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَنْصَرِفُ عَنْ یَمِینِہِ۔ (مسلم ۶۱۔ احمد ۲۸۰)","Hasan","Musannaf Ibn Abi Shaybah 3127","","","كتاب الصلوات"
"3128","(۳۱۲۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا قُضِیَتِ الصَّلاَۃُ وَأَنْتَ تُرِیدُ حَاجَۃً ، فَکَانَتْ حَاجَتُک عَنْ یَمِینِکَ ، أَوْ عَنْ یَسَارِکَ فَخُذْ نَحْوَ حَاجَتِک۔","Da'if","Musannaf Ibn Abi Shaybah 3128","","","كتاب الصلوات"
"3129","(۳۱۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ السَّلاَمِ بْنِ شَدَّادٍ ، عَنْ غَزْوَانَ بْنِ جَرِیرٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا کَانَ إذَا سَلَّمَ لاَ یُبَالِی انْصَرَفَ عَلَی یَمِینِہِ ، أَوْ عَلَی شِمَالِہِ۔","Majhul","Musannaf Ibn Abi Shaybah 3129","","","كتاب الصلوات"
"3130","(۳۱۳۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَسْتَدِیرَ الرَّجُلُ فِی صَلاَتِہِ ، کَمَا یَسْتَدِیرُ الْحِمَارُ۔","Sahih","Musannaf Ibn Abi Shaybah 3130","","","كتاب الصلوات"
"3131","(۳۱۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ نَاجِیَۃَ ؛ أَنَّ أَبَا عُبَیْدَۃَ رَأَی رَجُلاً انْصَرَفَ عَنْ یَسَارِہِ ، فَقَالَ : أَمَّا ہَذَا فَقَدْ أَصَابَ السُّنَّۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 3131","","","كتاب الصلوات"
"3132","(۳۱۳۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَسْتَحِبُّ أَنْ یَنْصَرِفَ الرَّجُلُ مِنْ صَلاَتِہِ عَنْ یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 3132","","","كتاب الصلوات"
"3133","(۳۱۳۳) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، عَنْ عَمِّہِ وَاسِعِ بْنِ حَبَّانَ ، قَالَ : کُنْتُ أُصَلِّی ، وَابْنُ عُمَرَ مُُسْنِدٌ ظَہْرَہُ إلَی جِدَارِ الْقِبْلَۃِ ، فَانْصَرَفْت عَنْ یَسَارِی ، فَقَالَ : مَا یَمْنَعُک أَنْ تَنْصَرِفَ عَنْ یَمِینِکَ ؟ قُلْتُ : لاَ ، إِلاَّ أَنِّی رَأَیْتُکَ فَانْصَرَفْت إلَیْک ، فَقَالَ : أَصَبْتَ ، إنَّ نَاسًا یَقُولُونَ : تَنْصَرِفُ عَنْ یَمِینِکَ ، فَإِذَا کُنْت تُصَلِّی فَانْصَرِفْ إِنْ أَحْبَبْت عَنْ یَمِینِکَ ، أَوْ عَنْ یَسَارِک۔","Sahih","Musannaf Ibn Abi Shaybah 3133","","","كتاب الصلوات"
"3134","(۳۱۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : انْصَرِفْ عَلَی أَیِّ شِقَّیْک شِئْت۔","","Musannaf Ibn Abi Shaybah 3134","","","كتاب الصلوات"
"3135","(۳۱۳۵) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْوَلِیدِ الْبَجَلِیِّ ، قَالَ : قَالَ عَبْدُ اللہِ : عَلَیْکُمْ بِحَدِّ الصَّلاَۃِ ؛ التَّکْبِیرَۃِ الأَولَی۔","Majhul","Musannaf Ibn Abi Shaybah 3135","","","كتاب الصلوات"
"3136","(۳۱۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عِمْرَانَ بْن مُسْلِمٍ ، عَنْ خَیْثَمَۃَ ، قَالَ : بِکْرُ الصَّلاَۃِ التَّکْبِیرَۃُ الأَولَی۔","","Musannaf Ibn Abi Shaybah 3136","","","كتاب الصلوات"
"3137","(۳۱۳۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی فَرْوَۃَ یَزِیدَ بْنِ سِنَانٍ ، قَالَ : حدَّثَنَا أَبُو عُبَیْدٍ الْحَاجِبُ ، قَالَ : سَمِعْتُ شَیْخًا فِی الْمَسْجِدِ الْحَرَامِ یَقُولُ : قَالَ أَبُو الدَّرْدَائِ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ لِکُلِّ شَیْئٍ أُنْفَۃً ، وَإِنَّ أُنْفَۃَ الصَّلاَۃِ التَّکْبِیرَۃُ الأَولَی ، فَحَافِظُوا عَلَیْہَا ۔ قَالَ أَبُو عُبَیْدٍ : فَحَدَّثْت بِہِ رَجَائَ بْنَ حَیْوَۃَ ، فَقَالَ : حَدَّثَتْنِیہِ أُمُّ الدَّرْدَائِ ، عَنْ أَبِی الدَّرْدَائِ۔ (مسندہ ۴۶)","Majhul","Musannaf Ibn Abi Shaybah 3137","","","كتاب الصلوات"
"3138","(۳۱۳۸) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الْجَرِیرِیِّ ، عَنِ الرَّیَّانِ الرَّاسِبیِّ ، عَنْ أَشْیَاخِ بَنِی رَاسِبٍ ؛ أَنَّ طَلْحَۃَ وَالزُّبَیْرَ صَلَّیَا فِی بَعْضِ مَسَاجِدِہِمْ ، وَلَمْ یَکُنِ الإِمَامُ ثَمَّ ، فَقُلْنَا لَہُمَا : لِیَتَقَدَّمْ أَحَدُکُمَا ، فَإِنَّکُمَا مِنْ صَحَابَۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَبَیَا وَقَالاَ : أَیْنَ الإِمَامُ ، أَیْنَ الإِمَامُ ؟ فَجَائَ الإِمَامُ وَصَلَّی بِہِمْ ، قَالاَ : کُلُّ صَلاَتِکُمْ کَانَتْ مُقَارِبَۃً إِلاَّ شَیْئًا رَأَیْتُہُ تَصْنَعُونَہُ ، لَیْسَ بِحَسَنٍ فِی صَلاَتِکُمْ ، فَقُلْنَا : مَا ہُوَ ؟ قَالاَ : إذَا سَلَّمَ الإِمَامُ فَلاَ یَقُومَنَّ رَجُلٌ مِنْ خَلْفِہِ حَتَّی یَنْفَتِلَ الإِمَامُ بِوَجْہِہِ ، أَوْ یَنْہَضَ مِنْ مَکَانِہِ۔","Majhul","Musannaf Ibn Abi Shaybah 3138","","","كتاب الصلوات"
"3139","(۳۱۳۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ أَنَّہُمَا قَالاَ : لاَ یَقْضِی حَتَّی یَنْحَرِفَ الإِمَامُ۔","","Musannaf Ibn Abi Shaybah 3139","","","كتاب الصلوات"
"3140","(۳۱۴۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، وَخَالِدٌ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، قَالَ : قُلْتُ لابْنِ عُمَرَ : أُسْبَقُ بِبَعْضِ الصَّلاَۃِ فَیُسَلِّمُ الإِمَامُ ، فَأَقُومُ فَأَقْضِی مَا سُبِقْتُ بِہِ ، أَوْ أَنْتَظِرُ أَنْ یَنْحَرِفَ ؟ فَقَالَ ابْنُ عُمَرَ : کَانَ الإِمَامُ إذَا سَلَّمَ قَامَ ، وَقَالَ خَالِدٌ : کَانَ الإِمَامُ إذَا سَلَّمَ انْکَفَأَ ، کَانَ الانکِفَائُ مَعَ التَّسْلِیمِ۔","Sahih","Musannaf Ibn Abi Shaybah 3140","","","كتاب الصلوات"
"3141","(۳۱۴۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ فِی رَجُلٍ سُبِقَ بِرَکْعَۃٍ ، أَوْ رَکْعَتَیْنِ ؟ قَالَ : لاَ یَقُومُ إذَا سَلَّمَ الإِمَامُ حَتَّی یَنْحَرِفَ ، أَوْ یَقُومَ۔","","Musannaf Ibn Abi Shaybah 3141","","","كتاب الصلوات"
"3142","(۳۱۴۲) حَدَّثَنَا حَفْصٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ سُئِلَ عَنِ الإِمَامِ إذَا سَلَّمَ ، ثُمَّ لاَ یَنْحَرِفُ ؟ قَالَ : دَعْہُ حَتَّی یَفْرُغَ مِنْ بِدْعَتِہِ ، وَکَانَ یَکْرَہُ أَنْ یَقُومَ فَیَقْضِیَ۔","","Musannaf Ibn Abi Shaybah 3142","","","كتاب الصلوات"
"3143","(۳۱۴۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا سَلَّمَ الإِمَامُ فَقُمْ وَاصْنَعْ مَا شِئْت یَقُولُ : لاَ تَنْظُرْ قِیَامَہُ ، وَلاَ تُحَوِّلْہُ مِنْ مَجْلِسِہِ۔","","Musannaf Ibn Abi Shaybah 3143","","","كتاب الصلوات"
"3144","(۳۱۴۴) حَدَّثَنَا حَفْصٌ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَقْضِی ، وَلاَ یَنْتَظِرُ الإِمَامَ ، قَالَ : وَکَانَ الْقَاسِمُ ، وَسَالِمٌ ، وَنَافِعٌ یَفْعَلُونَ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 3144","","","كتاب الصلوات"
"3145","(۳۱۴۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو ہَارُونَ ، قَالَ : صَلَّیْت بِالْمَدِینَۃِ فَسُبِقْتُ بِبَعْضِ الصَّلاَۃِ ، فَلَمَّا سَلَّمَ الإِمَامُ قُمْتُ لأَقْضِیَ مَا سُبِقْتُ بِہ ، فَجَبَذَنِی رَجُلٌ کَانَ إلَی جَنْبِی ، ثُمَّ قَالَ : کَانَ یَنْبَغِی لَکَ أَنْ لاَ تَقُومَ حَتَّی یَنْحَرِف ، قَالَ : فَلَقِیتُ أَبَا سَعِیدٍ فَذَکَرْت لَہ ذَلِکَ ، فَکَأَنَّہُ لَمْ یَکْرَہْ مَا صَنَعْتُ ، أَوْ کَلِمَۃً نَحْوَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 3145","","","كتاب الصلوات"
"3146","(۳۱۴۶) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : یَا بُنَیَّ ، إذَا سَلَّمْتُ فَإِنِّی أَجْلِسُ فَأُسَبِّحُ وَأُکَبِّرُ ، فَمَنْ بَقِیَ عَلَیْہِ شَیْئٌ مِنْ صَلاَتِہِ ، فَلْیَقُمْ فَلْیَقْضِ۔","","Musannaf Ibn Abi Shaybah 3146","","","كتاب الصلوات"
"3147","(۳۱۴۷) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یَنْتَظِرُہُ قَلِیلاً ، فَإِنْ جَلَسَ فَقُمْ وَدَعْہُ۔","","Musannaf Ibn Abi Shaybah 3147","","","كتاب الصلوات"
"3148","(۳۱۴۸) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَرُدُّ السَّلاَمَ عَلَی الإِمَامِ۔","Hasan","Musannaf Ibn Abi Shaybah 3148","","","كتاب الصلوات"
"3149","(۳۱۴۹) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا سَلَّمَ الإِمَامُ فَرُدَّ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 3149","","","كتاب الصلوات"
"3150","(۳۱۵۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَالِمٍ ، قَالَ : إذَا سَلَّمَ الإِمَامُ فَرُدَّ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 3150","","","كتاب الصلوات"
"3151","(۳۱۵۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : إنَّ ذَرًّا إذَا سَلَّمَ الإِمَامُ رَدَّ عَلَیْہِ ، قَالَ : یُجْزِئہ أَنْ یُسَلِّمَ عَنْ یَمِینِہِ ، وَعَنْ یَسَارِہِ۔","","Musannaf Ibn Abi Shaybah 3151","","","كتاب الصلوات"
"3152","(۳۱۵۲) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : إذَا سَلَّمَ الإِمَامُ فَلْیَرُدَّ عَلَیْہِ مَنْ خَلْفَہُ۔","","Musannaf Ibn Abi Shaybah 3152","","","كتاب الصلوات"
"3153","(۳۱۵۳) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِیئُ ، عَنْ سَعِیدِ بْنِ أَبِی أَیُّوبَ ، قَالَ : حدَّثَنِی أَبُو عَقِیلٍ ؛ أَنَّہُ رَأَی سَعِیدَ بْنَ الْمُسَیَّبِ یُسَلِّمُ عَنْ یَمِینِہِ ، وَعَنْ یَسَارِہِ ، ثُمَّ یَرُدُّ عَلَی الإِمَامِ۔","","Musannaf Ibn Abi Shaybah 3153","","","كتاب الصلوات"
"3154","(۳۱۵۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ قَاعِدًا عِنْدَ ابْنِ عُمَرَ ، فَرَأَی رَجُلاً قَدْ أَثَّرَ السُّجُودُ فِی وَجْہِہِ ، فَقَالَ : إنَّ صُورَۃَ الرَّجُلِ وَجْہُہُ ، فَلاَ یَشِینُ أَحَدُکُمْ صُورَتَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 3154","","","كتاب الصلوات"
"3155","(۳۱۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ ثَوْرٍ ، عَنْ أَبِی عَوْنٍ الأَعْوَرِ ، عَنْ أَبِی الدَّرْدَائِ ؛ أَنَّہُ رَأَی امْرَأَۃً بَیْنَ عَیْنَیْہَا مِثْلُ ثَفِنَۃِ الشَّاۃِ ، فَقَالَ : أَمَا إنَّ ہَذَا لَوْ لَمْ یَکُنْ بَیْنَ عَیْنَیْک کَانَ خَیْرًا لَک۔","Hasan","Musannaf Ibn Abi Shaybah 3155","","","كتاب الصلوات"
"3156","(۳۱۵۶) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ یَزِیدَ بْنِ الأَصَمِّ ، قَالَ : قلت لِمَیْمُونَۃَ : أَلَمْ تَرَیْ إلَی فُلاَنٍ یَنْقُرُ جَبْہَتَہُ بِالأَرْضِ یُرِیدُ أَنْ یُؤَثِّرَ بِہَا أَثَرَ السُّجُودِ ، فَقَالَتْ : دَعْہُ لَعَلَّہُ یَلِجُ۔","Sahih","Musannaf Ibn Abi Shaybah 3156","","","كتاب الصلوات"
"3157","(۳۱۵۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حُرَیْثٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَرِہَ الأَثَرَ فِی الْوَجْہِ۔","","Musannaf Ibn Abi Shaybah 3157","","","كتاب الصلوات"
"3158","(۳۱۵۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مُسَافِرٍ الْجَصَّاصِ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، قَالَ : شَکَوْت إلَی مُجَاہِدٍ الأَثَرَ بَیْنَ عَیْنَیَّ ، فَقَالَ لِی : إذَا سَجَدْت فَتَجَافَ۔","","Musannaf Ibn Abi Shaybah 3158","","","كتاب الصلوات"
"3159","(۳۱۵۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ أَصْحَابَ عَلِیٍّ وَأَصْحَابَ عَبْدِ اللہِ وَأَثَارُ السُّجُودِ فِی جِبَاہِہِمْ وَأُنُوفِہِمْ۔","","Musannaf Ibn Abi Shaybah 3159","","","كتاب الصلوات"
"3160","(۳۱۶۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ، عَنْ أَبِی إِسْحَاقَ، قَالَ: مَا رَأَیْت سَجْدَۃً أَعْظَمَ مِنْہَا، یَعْنِی سَجْدَۃَ ابْنِ الزُّبَیْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 3160","","","كتاب الصلوات"
"3161","(۳۱۶۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : رَأَیْتُ مَا یَلِی الأَرْضَ مِنْ عَامِرِ بَنِی عَبْدِ قَیْسٍ مِثْلَ ثَفِنِ الْبَعِیرِ۔","","Musannaf Ibn Abi Shaybah 3161","","","كتاب الصلوات"
"3162","(۳۱۶۲) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ الْحَسَنِ ، قَالُوا : لَمَّا بُنِیَ الْمَسْجِدُ قَالُوا : یَا رَسُولَ اللہِ ، کَیْفَ نَبْنِیہ ؟ قَالَ : عَرْشٌ کَعَرْشِ مُوسَی۔","","Musannaf Ibn Abi Shaybah 3162","","","كتاب الصلوات"
"3163","(۳۱۶۳) حَدَّثَنَا ابْنُ عُلَیَّ[corrupt]َ ، عَنْ أَیُّوبَ ، قَالَ : حدَّثَنِی رَجُلٌ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : کَانَ یُقَالُ : لَیَأْتِیَنَّ عَلَی النَّاسِ زَمَانٌ یَبْنُونَ الْمَسَاجِدَ یَتَبَاہَوْنَ بِہَا ، وَلاَ یَعْمُرُونَہَا إِلاَّ قَلِیلاً۔ (ابوداؤد ۴۵۰۔ نسائی ۷۶۸)","Majhul","Musannaf Ibn Abi Shaybah 3163","","","كتاب الصلوات"
"3164","(۳۱۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی فَزَارَۃَ ، عَنْ یَزِیدَ بْن الأَصَمِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا أُمِرْتُ بِتَشْیِیدِ الْمَسَاجِدِ۔ (عبدالرزاق ۵۱۲۷)","","Musannaf Ibn Abi Shaybah 3164","","","كتاب الصلوات"
"3165","(۳۱۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی فَزَارَۃَ ، عَنْ یَزِیدَ بْن الأَصَمِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَتُزَخْرِفُنَّہَا کَمَا زَخْرَفَتِ الْیَہُودُ وَالنَّصَارَی۔","Sahih","Musannaf Ibn Abi Shaybah 3165","","","كتاب الصلوات"
"3166","(۳۱۶۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، قَالَ : قَالَ أَبِی : إذَا زَوَّقْتُمْ مَسَاجِدَکُمْ ، وَحَلَّیْتُمْ مَصَاحِفَکُمْ ، فَالدُّبَارُ عَلَیْکُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 3166","","","كتاب الصلوات"
"3167","(۳۱۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی فَزَارَۃَ ، عَنْ مُسْلِمٍ الْبَطِینِ ، قَالَ : مَرَّ عَلَی مَسْجِدٍ قَدْ شُرِّف ، فَقَالَ: ہَذِہِ بَیْعَۃُ بَنِی فُلاَنٍ۔","","Musannaf Ibn Abi Shaybah 3167","","","كتاب الصلوات"
"3168","(۳۱۶۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجَرِیرِیِّ ، قَالَ : قَالَ عَبْدُ اللہِ بْنُ شَقِیقٍ : إنَّمَا کَانَتِ الْمَسَاجِدُ جُمًّا ، وَإِنَّ مَا شَرَّفَ النَّاسُ حَدِیثٌ مِنَ الدَّہْرِ۔","","Musannaf Ibn Abi Shaybah 3168","","","كتاب الصلوات"
"3169","(۳۱۶۹) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ مُوسَی ، عَنْ رَجُلٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أُمِرْنَا أَنْ نَبْنِیَ الْمَسَاجِدَ جُمًّا ، وَالْمَدَائِنَ شُرَفًا۔","Majhul","Musannaf Ibn Abi Shaybah 3169","","","كتاب الصلوات"
"3170","(۳۱۷۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ یَزِیدَ بْنِ الأَصَمِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَتُزَخْرِفُنَّ مَسَاجِدَکُمْ ، کَمَا زَخْرَفَتِ الْیَہُودُ وَالنَّصَارَی مَسَاجِدَہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 3170","","","كتاب الصلوات"
"3171","(۳۱۷۱) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ ، قَالَ : حدَّثَنَا ہُرَیْمٌ ، عَنْ لَیْثٍ ، عَنْ أَیُّوبَ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ابْنُوا الْمَسَاجِدَ وَاتَّخِذُوہَا جُمًّا۔","Da'if","Musannaf Ibn Abi Shaybah 3171","","","كتاب الصلوات"
"3172","(۳۱۷۲) حَدَّثَنَا مَالِکٌ ، قَالَ : حدَّثَنَا ہُرَیْمٌ ، قَالَ : حَدَّثَنَا لَیْثٌ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نُہِینَا ، أَوْ نَہَانَا ، أَنْ نُصَلِّیَ فِی مَسْجِدٍ مُشَرَّفٍ۔ (طبرانی ۱۳۴۹۹۔ بیہقی ۴۳۹)","Da'if","Musannaf Ibn Abi Shaybah 3172","","","كتاب الصلوات"
"3173","(۳۱۷۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ ، عَنْ أَبِی ذَرٍّ ، قَالَ : مَنْ بَنَی لِلَّہِ مَسْجِدًا وَلَوْ مِثْلَ مَفْحَصِ قَطَاۃٍ ، بُنِیَ لَہُ بَیْتٌ فِی الْجَنَّۃِ۔","","Musannaf Ibn Abi Shaybah 3173","","","كتاب الصلوات"
"3174","(۳۱۷۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ عَبْدِ الْعَزِیزِ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ ، عَنْ أَبِی ذَرٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ بَنَی لِلَّہِ مَسْجِدًا وَلَوْ مَفْحَصَ قَطَاۃٍ ، بَنَی اللَّہُ لَہُ بَیْتًا فِی الْجَنَّۃِ۔ (ابن حبان ۱۶۱۱۔ طبرانی ۱۱۰۵)","","Musannaf Ibn Abi Shaybah 3174","","","كتاب الصلوات"
"3175","(۳۱۷۵) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ أُسَامَۃَ ، عَنِ الْوَلِیدِ بْنِ أَبِی الْوَلِیدِ ، عَنْ عُثْمَانَ بْنِ عَبْدِ اللہِ بْنِ سُرَاقَۃَ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ، أَنَّہُ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ بَنَی مَسْجِدًا یُذْکَرُ فِیہِ اسْمُ اللہِ ، بَنَی اللَّہُ لَہُ بَیْتًا فِی الْجَنَّۃِ۔ n(ابن ماجہ ۲۷۵۸۔ ابن حبان ۱۶۰۸)","Sahih","Musannaf Ibn Abi Shaybah 3175","","","كتاب الصلوات"
"3176","(۳۱۷۶) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ جَابِرٍ ، عَنْ عَمَّارٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ بَنَی مَسْجِدًا مَفْحَصَ قَطَاۃٍ ، بَنَی اللَّہُ لَہُ بَیْتًا فِی الْجَنَّۃِ۔n(احمد ۲۴۱۔ طیالسی ۲۶۱۷)","Da'if","Musannaf Ibn Abi Shaybah 3176","","","كتاب الصلوات"
"3177","(۳۱۷۷) قَالَ أَبو بَکر : وَجَدْتُ فِی کِتَابِ أَبِی : عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ مَحْمُودِ بْنِ لَبِیدٍ ، عَنْ عُثْمَانَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : مَنْ بَنَی مَسْجِدًا وَلَوْ مَفْحَصَ قَطَاۃٍ ، بَنَی اللَّہُ لَہُ بَیْتًا فِی الْجَنَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 3177","","","كتاب الصلوات"
"3178","(۳۱۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا کَثِیرُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ بَنَی مَسْجِدًا بَنَی اللَّہُ لَہُ بَیْتًا ، قِیلَ : وَہَذِہِ الْمَسَاجِدُ الَّتِی فِی طَرِیقِ مَکَّۃَ ؟ قَالَتْ : وَہَذِہِ الْمَسَاجِدُ الَّتِی فِی طَرِیقِ مَکَّۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 3178","","","كتاب الصلوات"
"3179","(۳۱۷۹) حَدَّثَنَا سُفیان بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أَتَی رَجُلٌ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّ أَحَدَنَا یُصَلِّی فِی ثوْبٍ وَاحِدٍ ، فَقَالَ : أَوَلِکُلِّکُمْ ثَوْبَانِ ؟ قَالَ أَبُو ہُرَیْرَۃَ لِلَّذِی سَأَلَہُ : أَتَعْرِفُ أَبَا ہُرَیْرَۃَ ، فَإِنَّہُ یُصَلِّی فِی ثَوْبٍ۔ (ابن حبان ۲۲۹۶۔ احمد ۲/۲۳۹)","Sahih","Musannaf Ibn Abi Shaybah 3179","","","كتاب الجمعة"
"3180","(۳۱۸۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی فِی ثَوْبٍ وَاحِدٍ مُتَوَشِّحًا بِہِ۔ (مسلم ۲۸۵۔ احمد ۳/۱۰)","Hasan","Musannaf Ibn Abi Shaybah 3180","","","كتاب الجمعة"
"3181","(۳۱۸۱) حَدَّثَنَا شَرِیکٌ ، عَنْ حُسَیْنِ بْنِ عَبْدِ اللہِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی فِی ثَوْبٍ وَاحِدٍ ، یَتَّقِی بِفُضُولِہِ حَرَّ الأَرْضِ وَبَرْدَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 3181","","","كتاب الجمعة"
"3182","(۳۱۸۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : سُئِلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الصَّلاَۃِ فِی الثَّوْبِ ؟ فَقَالَ : أَوَلِکُلِّکُمْ ثَوْبَانِ ؟۔ (بخاری ۳۶۵۔ مسلم ۳۶۸)","Sahih","Musannaf Ibn Abi Shaybah 3182","","","كتاب الجمعة"
"3183","(۳۱۸۳) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللہِ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ اللہِ بْنِ حُنَیْنٍ ، عنِ ابْنِ عَبَّاسٍ ، عَنْ عَلِیِّ بْنِ أَبِی طَالِبٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا کَانَ إزَارُک وَاسِعًا فَتَوَشَّحْ بِہِ، وَإِنْ کَانَ ضَیِّقًا فَاتَّزِرْ۔ (ابن سعد ۳۰)","Da'if","Musannaf Ibn Abi Shaybah 3183","","","كتاب الجمعة"
"3184","(۳۱۸۴) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرٍو ، عَنْ عَبْدِ اللہِ بْنِ بَدْرٍ ، عَنْ قَیْسِ بْنِ طَلْقِ بْنِ عَلِیٍّ ، عَنْ أَبِیہِ ، قَالَ : جَائَ رَجُلٌ فَقَالَ : یَا نَبِیَّ اللہِ ، مَا تَرَی فِی الصَّلاَۃِ فِی ثَوْبٍ وَاحِدٍ ؟ قَالَ : فَأَطْلَقَ النَبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إزَارَہُ فَطَارَقَ بِہِ رِدَائَہُ ، ثُمَّ اشْتَمَلَ بِہِمَا ثُمَّ صَلَّی بِنَا ، فَلَمَّا قَضَی الصَّلاَۃَ ، قَالَ : أَکُلُّکُمْ یَجِدُ ثَوْبَیْنِ ؟۔","Hasan","Musannaf Ibn Abi Shaybah 3184","","","كتاب الجمعة"
"3185","(۳۱۸۵) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَطَائٍ ، عَنْ مُعَاوِیَۃَ بْنِ أَبِی سُفْیَانَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی فِی ثَوْبٍ وَاحِدٍ۔","Da'if","Musannaf Ibn Abi Shaybah 3185","","","كتاب الجمعة"
"3186","(۳۱۸۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ أَجْلَح ، عَنْ عَاصِمٍ ، عَنْ أَنَسٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ثَوْبٍ وَاحِدٍ خَالَفَ بَیْنَ طَرَفَیْہِ۔ (نسائی ۸۶۰۔ احمد ۳/۲۴۳)","Hasan","Musannaf Ibn Abi Shaybah 3186","","","كتاب الجمعة"
"3187","(۳۱۸۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ طَارِقٍ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، قَالَ : کَانَ خَالِدُ بْنُ الْوَلِیدِ یَخْرُجُ فَیُصَلِّی بِالنَّاسِ فِی ثَوْبٍ وَاحِدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 3187","","","كتاب الجمعة"
"3188","(۳۱۸۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی فَرْوَۃَ ، عَنْ أَبِی الضُّحَی ، قَالَ : سُئِلَ ابْنُ عَبَّاسٍ عَنِ الرَّجُلِ یُصَلِّی فِی الثَّوْبِ الْوَاحِدِ ؟ فَقَالَ : نَعَمْ ، یُخَالِفُ بَیْنَ طَرَفَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 3188","","","كتاب الجمعة"
"3189","(۳۱۸۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : جَائَ رَجُلٌ إلَی عَائِشَۃَ ، فَقَالَ : أُصَلِّی فِی ثَوْبٍ وَاحِدٍ ؟ قَالَتْ : نَعَمْ ، وَخَالِفْ بَیْنَ طَرَفَیْہِ۔","","Musannaf Ibn Abi Shaybah 3189","","","كتاب الجمعة"
"3190","(۳۱۹۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، قَالَ : صَلَّی بِنَا خَالِدُ بْنُ الْوَلِیدِ فِی ثَوْبٍ وَاحِدٍ فِی الْوُفُودِ ، وَقَدْ خَالَفَ بَیْنَ طَرَفَیْہِ ، وَخَلْفَہُ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 3190","","","كتاب الجمعة"
"3191","(۳۱۹۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، قَالَ : سُئِلَ أَنَسٌ عَنِ الصَّلاَۃِ فِی الثَّوْبِ ؟ فَقَالَ : یَتَوَشَّحُ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 3191","","","كتاب الجمعة"
"3192","(۳۱۹۲) حَدَّثَنَا حَفْصٌ ، عَنْ حَلاَّمٍ ، عَنْ مَسْعُودٍ ، یَعْنِی ابْنَ حِرَاشٍ ، قَالَ : صَلَّی بِنَا عُمَرُ فِی ثَوْبٍ لَیْسَ عَلَیْہِ غَیْرُہُ ، قَالَ : وَأَمَّنَا مَسْعُودٌ ، یَعْنِی ابْنَ حِرَاشٍ ، فِی بَتٍّ۔","Sahih","Musannaf Ibn Abi Shaybah 3192","","","كتاب الجمعة"
"3193","(۳۱۹۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ صَلَّی فِی ثَوْبٍ وَاحِدٍ خَالَفَ بَیْنَ طَرَفَیْہِ۔","","Musannaf Ibn Abi Shaybah 3193","","","كتاب الجمعة"
"3194","(۳۱۹۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عَوْفٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ أَنْ یُصَلِّیَ الرَّجُلُ فِی ثَوْبٍ۔","","Musannaf Ibn Abi Shaybah 3194","","","كتاب الجمعة"
"3195","(۳۱۹۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ اللہِ بْنِ حُنَیْنٍ ، عَنْ أَبِی مُرَّۃَ مَوْلَی عَقِیلِ بْنِ أَبِی طَالِبٍ ، عَنْ أُمِّ ہَانِیئٍ ابْنَۃِ أَبِی طَالِبٍ ، قَالَتْ : أَتَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَوُضِعَ لَہُ مَائٌ فَاغْتَسَلَ ، ثُمَّ الْتَحَفَ وَخَالَفَ بَیْنَ طَرَفَیْہِ عَلَی عَاتِقَیْہِ ، ثُمَّ صَلَّی الضُّحَی ، ثَمَانِیَ رَکَعَاتٍ۔n قَالَ مُحَمَّدٌ : وَقَدْ رَأَیْت أَبَا مُرَّۃَ۔(احمد ۶/۳۴۲۔ ابن حبان ۲۵۳۷)","Hasan","Musannaf Ibn Abi Shaybah 3195","","","كتاب الجمعة"
"3196","(۳۱۹۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، قَالَ : قَالَ أُبَیّ : الصَّلاَۃُ فِی ثَوْبٍ وَاحِدٍ حَسَنٌ ، قَدْ فَعَلْنَاہُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 3196","","","كتاب الجمعة"
"3197","(۳۱۹۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : سَأَلْتُہ عَنِ الصَّلاَۃِ فِی الثَّوْبِ ، أَوْ سُئِلَ ؟ فَقَالَ : یُخَالِفُ بَیْنَ طَرَفَیْہِ۔","","Musannaf Ibn Abi Shaybah 3197","","","كتاب الجمعة"
"3198","(۳۱۹۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، قَالَ : سَأَلْتُ أَبَا سَلَمَۃَ بْنَ عَبْدِ الرَّحْمَنِ عَنِ الصَّلاَۃِ فِی الثَّوْبِ الْوَاحِدِ ؟ فَقَالَ : إنِّی لأُصَلِّی فِی الثَّوْبِ الْوَاحِدِ وَإِلَی جَنْبِی ثِیَابٌ ، لَوْ أَشَائُ أَنْ آخُذَ مِنْہَا لأَخَذْت۔","","Musannaf Ibn Abi Shaybah 3198","","","كتاب الجمعة"
"3199","(۳۱۹۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ عُثْمَانَ بْنِ الْمُغِیرَۃِ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ؛ أَنَّ عَلِیًّا ، قَالَ : لاَ بَأْسَ بِالصَّلاَۃِ فِی ثَوْبٍ وَاحِدٍ ، أَوْ صَلَّی فِی ثَوْبٍ وَاحِدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 3199","","","كتاب الجمعة"
"3200","(۳۲۰۰) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یُصَلِّی فِی ثَوْبٍ وَاحِدٍ ، قَالَ : حسَنٌ ، إذَا خَالَفَ بَیْنَ طَرَفَیْہِ۔","","Musannaf Ibn Abi Shaybah 3200","","","كتاب الجمعة"
"3201","(۳۲۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی فِی ثَوْبٍ وَاحِدٍ مُتَوَشِّحًا بِہِ۔(مسلم ۲۸۳۔ احمد ۳/۳۵۶)","Sahih","Musannaf Ibn Abi Shaybah 3201","","","كتاب الجمعة"
"3202","(۳۲۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبَانُ بْنُ صَمْعَۃَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ فِی الصَّلاَۃِ فِی الثَّوْبِ الْوَاحِدِ۔","Sahih","Musannaf Ibn Abi Shaybah 3202","","","كتاب الجمعة"
"3203","(۳۲۰۳) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ کَانَ یَقُولُ : یُصَلِّی فِی ثَوْبٍ وَاحِدٍ یَتَّزِرُ بِبَعْضِہِ ، وَیَرْتَدِی بِبَعْضِہِ۔","","Musannaf Ibn Abi Shaybah 3203","","","كتاب الجمعة"
"3204","(۳۲۰۴) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ یَزِیدَ مَوْلَی سَلَمَۃَ بْنِ الأَکْوَعِ ، قَالَ : کَانَ سَلَمَۃُ یُصَلِّی فِی ثَوْبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 3204","","","كتاب الجمعة"
"3205","(۳۲۰۵) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللہِ بْنِ یُونُسَ ، قَالَ : حدَّثَنَا یَعْلَی بْنُ الْحَارِثِ الْمُحَارِبِیُّ ، قَالَ : سَمِعْتُ غَیْلاَنَ بْنَ جَامِعٍ ، قَالَ : حَدَّثَنِی إیَاسُ بْنُ سَلَمَۃَ ، عَنِ ابْنٍ لِعَمَّارِ بْنِ یَاسِرٍ ، قَالَ : قَالَ أَبِی : أَمَّنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ثَوْبٍ وَاحِدٍ مُتَوَشِّحًا بِہِ۔ (ابو یعلی ۱۶۳۵)","Majhul","Musannaf Ibn Abi Shaybah 3205","","","كتاب الجمعة"
"3206","(۳۲۰۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا عَمْرُو بْنُ کَثِیرٍ ، قَالَ : حَدَّثَنِی ابْنُ کَیْسَانَ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی الظُّہْرَ وَالْعَصْرَ فِی ثَوْبٍ وَاحِدٍ، مُتَلَبِّباً بِہِ۔ (ابن ماجہ ۱۰۵۱۔ احمد ۳/۴۱۷)","Majhul","Musannaf Ibn Abi Shaybah 3206","","","كتاب الجمعة"
"3207","(۳۲۰۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا دَاوُد بْنُ أَبِی ہِنْدٍ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ: اخْتَلَفَ أُبَیُّ بْنُ کَعْبٍ ، وَابْنُ مَسْعُودٍ فِی الصَّلاَۃِ فِی الثَّوْبِ الْوَاحِدِ ، فَقَالَ أُبَیٌّ : ثَوْبٌ ، وَقَالَ : ابْنُ مَسْعُودٍ: ثَوْبَانِ ، فَخَرَجَ عَلَیْہِمَا عُمَرُ فَلاَمَہُمَا ، وَقَالَ : إِنَّہُ لَیَسُوؤُنِی أَنْ یَخْتَلِفَ اثْنَانِ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الشَّیْئِ الْوَاحِدِ ، فَعَنْ أَیِّ فُتْیَاکُمَا یَصْدُر النَّاسُ ؟ أَمَّا ابْنُ مَسْعُودٍ فَلَمْ یَأْلُ ، وَالْقَوْلُ مَا قَالَ أُبَیٌّ۔ (بیہقی ۲۳۸)","Sahih","Musannaf Ibn Abi Shaybah 3207","","","كتاب الجمعة"
"3208","(۳۲۰۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یُصَلِّی فِی الثَّوْبِ الْوَاحِدِ مُتَوَشِّحًا بِہِ ، وَقَالَ ابْنُ عُمَرَ : لاَ یَضُرُّہُ لَوِ الْتَحَفَ حَتَّی یُخْرِجَ إحْدَی یَدَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 3208","","","كتاب الجمعة"
"3209","(۳۲۰۹) حَدَّثَنَا یَحْیَی بْنُ إِسْحَاقَ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ أَیُّوبَ ، قَالَ : أَخْبَرَنَا یَحْیَی الأَمَوِیُّ ، قَالَ : دَخَلْت أَنَا وَعُزْرَۃُ بْنُ أَبِی قَیْسٍ عَلَی عَبْدِ اللہِ بْن الْحَارِثِ بْنِ جَزْئٍ الزُّبَیْدِیِّ ، وَکَانَتْ لَہُ صُحْبَۃٌ ، فَتَوَضَّأَ ثُمَّ صَلَّی فِی ثَوْبٍ وَاحِدٍ قَدْ خَالَفَ بَیْنَ طَرَفَیْہِ۔","Majhul","Musannaf Ibn Abi Shaybah 3209","","","كتاب الجمعة"
"3210","(۳۲۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عُمَرَ بْنِ أَبِی سَلَمَۃَ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی فِی بَیْتِ أُمِّ سَلَمَۃَ فِی ثَوْبٍ ، وَاضِعًا طَرَفَیْہِ عَلَی عَاتِقَیْہِ۔ (ترمذی ۳۳۹۔ ابوداؤد ۶۲۸)","Sahih","Musannaf Ibn Abi Shaybah 3210","","","كتاب الجمعة"
"3211","(۳۲۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا فُضَیْلُ بْنُ غَزْوَانَ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : رَأَیْتُ سَبْعِینَ مِنْ أَہْلِ الصُّفَّۃِ یُصلَّون فِی ثَوْبٍ ثَوْبٍ ، فَمِنْہُمْ مَنْ یَبْلُغُ رُکْبَتَیْہِ ، وَمِنْہُمْ مَا ہُوَ أَسْفَلَ مِنْ ذَلِکَ ، فَإِذَا رَکَعَ قَبَضَ عَلَیْہِ مَخَافَۃَ أَنْ تَبْدُوَ عَوْرَتُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 3211","","","كتاب الجمعة"
"3212","(۳۲۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ عُثْمَانَ بْنِ مُغِیرَۃَ الثَّقَفِیِّ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ مُحَمَّدِ بْنِ الْحَنَفِیَّۃِ ، قَالَ : قَالَ عَلِیٌّ : إذَا صَلَّی الرَّجُلُ فِی الثَّوْبِ الْوَاحِدِ فَلْیَتَوَشَّحْ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 3212","","","كتاب الجمعة"
"3213","(۳۲۱۳) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : أَمَّنَا جَابِرُ بْنُ عَبْدِ اللہِ فِی ثَوْبٍ وَاحِدٍ مُتَوَشِّحًا بِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 3213","","","كتاب الجمعة"
"3214","(۳۲۱۴) حَدَّثَنَا مُحَمَّدُ بْنُ عُمَرَ الأَسْلَمِیُّ ، قَالَ : أَخْبَرَنَا الضَّحَّاکُ بْنُ عُثْمَانَ ، عَنْ حَبِیبٍ مَوْلَی عُرْوَۃَ ، قَالَ : سَمِعْتُ أَسْمَائَ بِنْتَ أَبِی بَکْرٍ تَقُولُ : رَأَیْت أَبِی یُصَلِّی فِی ثَوْبٍ وَاحِدٍ ، فَقُلت : یَا أَبۃِ أَتُصلِّی فِی ثَوْبٍ وَاحِدٍ وَثِیَابُکَ مَوْضُوعَۃٌ ؟ فَقَالَ : یَا بُنَیَّۃُ ، إنَّ آخِرَ صَلاَۃٍ صَلاَّہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَلْفِی فِی ثَوْبٍ وَاحِدٍ۔ (ابویعلی ۵۱)","Da'if","Musannaf Ibn Abi Shaybah 3214","","","كتاب الجمعة"
"3215","(۳۲۱۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ رَأَی رَجُلاً یُصَلِّی مُلْتَحِفًا ، فَقَالَ : لاَ تَشَبَّہُوا بِالْیَہُودِ ، مَنْ لَمْ یَجِدْ مِنْکُمْ إِلاَّ ثَوْبًا وَاحِدًا فَلْیَتَّزِرْ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 3215","","","كتاب الصلوات"
"3216","(۳۲۱۶) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرٍ ، قَالَ : رَأَیْتُہُ یُصَلِّی فِی ثَوْبٍ مُؤْتَزِرًا بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 3216","","","كتاب الصلوات"
"3217","(۳۲۱۷) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ إبْرَاہِیمَ بْنِ أَبِی عَطَائٍ ، قَالَ : سَمِعْتُ عَبْدَ الرَّحْمَنِ بْنَ أَبِی نُعْمٍ یَقُولُ : إنَّ أَبَا سَعِیدٍ سُئِلَ عَنِ الصَّلاَۃِ فِی الثَّوْبِ الْوَاحِدِ ؟ فَقَالَ : یَتَّزِرُ بِہِ کَمَا یَتَّزِرُ لِلصِّراع۔","Majhul","Musannaf Ibn Abi Shaybah 3217","","","كتاب الصلوات"
"3218","(۳۲۱۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَمِعْتُ حَیَّانَ الْبَارِقِیَّ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : لَوْ لَمْ أَجِدْ إِلاَّ ثَوْبًا وَاحِدًا کُنْتُ أَتَّزِرُ بِہِ أَحَبُّ إلَیَّ مِنْ أَنْ أَتَوَشَّحَ بِہِ تَوَشُّحَ الْیَہُودِ۔","Sahih","Musannaf Ibn Abi Shaybah 3218","","","كتاب الصلوات"
"3219","(۳۲۱۹) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : إذَا أَرَادَ الرَّجُلُ أَنْ یُصَلِّیَ فَلَمْ یَکُنْ لَہُ إِلاَّ ثَوْبٌ وَاحِدٌ اتَّزَرَ بِہِ۔","","Musannaf Ibn Abi Shaybah 3219","","","كتاب الصلوات"
"3220","(۳۲۲۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ نَافِعٍ بْنِ عُمَرَ ، قَالَ : صَلَّی بِنَا عَبْدُ اللہِ بْنُ أَبِی مُلَیْکَۃَ فِی ثَوْبٍ وَاحِدٍ قَدْ رَفَعَہُ إلَی صَدْرِہِ۔","","Musannaf Ibn Abi Shaybah 3220","","","كتاب الصلوات"
"3221","(۳۲۲۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا نَافِعٌ بْنِ عُمَرَ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی بِالْعَرَجِ فِی ثَوْبٍ وَاحِدٍ رَفَعَہُ إلَی صَدْرِہِ۔","","Musannaf Ibn Abi Shaybah 3221","","","كتاب الصلوات"
"3222","(۳۲۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ فُضَیْلِ بْنِ غَزْوَانَ ، عَنْ عَبْدِ اللہِ بْنِ وَاقِدٍ ، قَالَ : صَلَّیْت إلَی جَنْبِ عَبْدِ اللہِ بْنِ عُمَرَ وَأَنَا مُتَوَشِّحٌ فَأَمَرَنِی بِالإِزْرَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 3222","","","كتاب الصلوات"
"3223","(۳۲۲۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ تُصَلِّ فِی ثَوْبٍ وَاحِدٍ ، إِلاَّ أَنْ لاَ تَجِدَ غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 3223","","","كتاب الصلوات"
"3224","(۳۲۲۴) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ قَرْمٍ ، عَنْ أَبِی فَزَارَۃَ ، عَنْ أَبِی زَیْدٍ ، عَنِ ابْنِ مَسْعُودٍ، قَالَ : لاَ تُصَلِّیَنَّ فِی ثَوْبٍ ، وَإِنْ کَانَ أَوْسَعَ مَا بَیْنَ السَّمَائِ وَالأَرْضِ۔","Majhul","Musannaf Ibn Abi Shaybah 3224","","","كتاب الصلوات"
"3225","(۳۲۲۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، قَالَ : رَأَیْتُ أَبَا قِلاَبَۃَ وَعَلَیْہِ جُبَّۃٌ وَمِلْحَفَۃٌ غَسِیلَۃٌ وَہُوَ یُصَلِّی مُضْطَبِعًا قَدْ أَخْرَجَ یَدَہُ الْیُمْنَی۔","","Musannaf Ibn Abi Shaybah 3225","","","كتاب الصلوات"
"3226","(۳۲۲۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قیلَ لِلْحَسَنِ : إنَّہُمْ یَقُولُونَ یُکْرَہُ أَنْ یُصَلِّیَ الرَّجُلُ وَقَدْ أَخْرَجَ یَدَہُ مِنْ تَحْتِ نَحْرِہِ ، فَقَالَ الْحَسَنُ : لَوْ وَکَّلَ اللَّہُ دِینَہُ إلَی ہَؤُلاَئِ ، لَضَیَّقُوا عَلَی عِبَادِہِ۔","","Musannaf Ibn Abi Shaybah 3226","","","كتاب الصلوات"
"3227","(۳۲۲۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیرِیِّ ، عَنْ حَیَّانَ بْنِ عُمَیْرٍ ، قَالَ : کُنْتُ مَعَ قَیْسِ بْنِ عُبَادٍ ، فَرَأَی رَجُلاً یُصَلِّی قَدْ أَخْرَجَ یَدَہُ مِنْ عِنْدِ نَحْرِہِ ، فَقَالَ : اذْہَبْ إلَی صَاحِبِکَ فَقُلْ لَہُ : فَلْیَضَعْ یَدَہُ مِنْ مَکَانِ یَدِ الْمَغْلُولِ ، فَأَتَیْتُہُ ، فَقُلْتُ لَہُ : إنَّ قَیْسًا یَقُولُ : ضَعْ یَدَک مِنْ مَکَانِ یَدِ الْمَغْلُولِ ، قَالَ : فَوَضَعَہَا۔","","Musannaf Ibn Abi Shaybah 3227","","","كتاب الصلوات"
"3228","(۳۲۲۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ، قَالَ : لَقَدْ رَأَیْتُہُ یُصَلِّی ضَابِعًا بِرِدَائِہِ مِنْ تَحْتِ عَضُدِہِ۔","","Musannaf Ibn Abi Shaybah 3228","","","كتاب الصلوات"
"3229","(۳۲۲۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْوَلِیدِ بْنِ الْعَیْزَارِ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، قَالَ : سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَیُّ الْعَمَلِ أَفْضَلُ ؟ قَالَ : الصَّلاَۃُ لِوَقْتِہَا۔ (بخار ی۵۲۷۔ ترمذی ۱۸۹۸)","Sahih","Musannaf Ibn Abi Shaybah 3229","","","كتاب الصلوات"
"3230","(۳۲۳۰) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَسَنِ بْنِ سَعْدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ مَسْعُودٍ ؛ {الَّذِینَ ہُمْ عَلَی صَلاَتِہِمْ دَائِمُونَ} قَالَ : عَلَی مَوَاقِیتِہَا۔","","Musannaf Ibn Abi Shaybah 3230","","","كتاب الصلوات"
"3231","(۳۲۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : نُبِّئْتُ أَنَّ أَبَا بَکْرٍ وَعُمَرَ کَانَا یُعَلِّمَانِ النَّاسَ : تَعْبُدُ اللَّہَ، وَلاَ تُشْرِکُ بِہِ شَیْئًا ، وَتُقِیمُ الصَّلاَۃَ الَّتِی افْتَرَضَ اللَّہُ لِمَوَاقِیتِہَا ، فَإِنَّ فِی تَفْرِیطِہَا الْہَلَکَۃَ۔","Majhul","Musannaf Ibn Abi Shaybah 3231","","","كتاب الصلوات"
"3232","(۳۲۳۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، قَالَ : الْحِفَاظُ عَلَی الصَّلاَۃِ ، الصَّلاَۃُ لِوَقْتِہَا۔","","Musannaf Ibn Abi Shaybah 3232","","","كتاب الصلوات"
"3233","(۳۲۳۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، قَالَ : مَا کَانَ الأَسْوَدُ إِلاَّ رَاہِبًا ، یَتَخَلَّفُ یُرَی أَنَّہُ یُصَلِّی ، فَإِذَا جَائَ وَقْتُ الصَّلاَۃِ أَنَاخَ وَلَوْ عَلَی الْحِجَارَۃِ۔","","Musannaf Ibn Abi Shaybah 3233","","","كتاب الصلوات"
"3234","(۳۲۳۴) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : کَتَبَ إلَیْنَا عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : أَمَّا بَعْدُ ، فَإِنَّ عُری الدِّینِ وَقِوَامَ الإِسْلاَمِ الإِیمَانُ بِاللَّہِ ، وَإِقَامُ الصَّلاَۃِ ، وَإِیتَائُ الزَّکَاۃِ ، فَصَلِّ الصَّلاَۃَ لِوَقْتِہَا ، وَحَافِظْ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 3234","","","كتاب الصلوات"
"3235","(۳۲۳۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُعْجِبُہُ إذَا کَانَ فِی سَفَرٍ ، أَنْ یُصَلِّیَ الصَّلاَۃَ لِوَقْتِہَا۔","","Musannaf Ibn Abi Shaybah 3235","","","كتاب الصلوات"
"3236","(۳۲۳۶) حَدَّثَنَا وَکِیعٌ، عَنْ عُمَرَ بْنِ مُوسَی، عَنْ أَبِی جَعْفَرٍ، قَالَ: قُلْتُ لَہُ: أَیُّ الصَّلاَۃِ أَفْضَلُ؟ قَالَ: فِی أَوَّلِ وَقْتٍ۔","","Musannaf Ibn Abi Shaybah 3236","","","كتاب الصلوات"
"3237","(۳۲۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمِ بْنِ أَبِی النَّجُودِ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، عَنْ سَعْدٍ ، قَالَ : السَّہْوُ: التَّرْکُ عَنِ الْوَقْتِ۔","Hasan","Musannaf Ibn Abi Shaybah 3237","","","كتاب الصلوات"
"3238","(۳۲۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَی الْعُمَرِیُّ ، عَنْ القَاسِمِ بْنِ غَنَّامٍ ، عَنْ بَعْضِ أُمَّہَاتِہِ ، عَنْ أُمِّ فَرْوَۃَ ؛ أَنَّہَا سَأَلَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَیُّ الْعَمَلِ ، أَوْ أَیُّ الصَّلاَۃِ ، أَفْضَلُ ؟ فَقَالَ : الصَّلاَۃُ فِی أَوَّلِ وَقْتِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 3238","","","كتاب الصلوات"
"3239","(۳۲۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ عَیَّاشِ بْنِ أَبِی رَبِیعَۃَ ، عَنْ حَکِیمِ بْنِ حَکِیمِ بْنِ عَبَّادِ بْنِ حُنَیْفٍ ، عَنْ نَافِعِ بْنِ جُبَیْرِ بْنِ مُطْعِمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَمَّنِی جِبْرِیلُ عِنْدَ الْبَیْتِ مَرَّتَیْنِ ، فَصَلَّی بِی الظُّہْرَ حِینَ زَالَتِ الشَّمْسُ وَکَانَتْ بِقَدْرِ الشِّرَاکِ ، وَصَلَّی بِی الْعَصْرَ حِینَ کَانَ ظِلَّ کُلِّ شَیْئٍ مِثْلَہُ ، وَصَلَّی بِی الْمَغْرِبَ حِینَ أَفْطَرَ الصَّائِمُ ، وَصَلَّی بِی الْعِشَائَ حِینَ غَابَ الشَّفَقُ ، وَصَلَّی بِی الْفَجْرَ حِینَ حَرُمَ الطَّعَامُ وَالشَّرَابُ عَلَی الصَّائِمِ ، وَصَلَّی بِی الْغدَ الظُّہْرَ حِینَ کَانَ ظِلَّ کُلِّ شَیْئٍ مِثْلَہُ ، وَصَلَّی بِی الْعَصْرَ حِینَ کَانَ ظِلَّ کُلِّ شَیْئٍ مِثْلَیْہِ ، وَصَلَّی بِی الْمَغْرِبَ حِینَ أَفْطَرَ الصَّائِمُ ، وَصَلَّی بِی الْعِشَائَ ثُلُثَ اللَّیْلِ ، وَصَلَّی بِی الْفَجْرَ فَأَسْفَرَ ، ثُمَّ الْتَفَتَ إلَیَّ ، فَقَالَ : یَا مُحَمَّدُ ، ہَذَا الْوَقْتُ وَقْتُ النَّبِیِّینَ قَبْلَک ، الْوَقْتُ مَا بَیْنَ ہَذَیْنِ الْوَقْتَیْنِ۔n(ترمذی ۱۴۹۔ ابوداؤد ۳۹۶)","Hasan","Musannaf Ibn Abi Shaybah 3239","","","كتاب الصلوات"
"3240","(۳۲۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ بَدْرِ بْنِ عُثْمَانَ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مُوسَی سَمِعَہُ مِنْہُ ، عَنْ أَبِیہِ ؛ أَنَّ سَائِلاً أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَأَلَہُ عَنْ مَوَاقِیتِ الصَّلاَۃِ فَلَمْ یَرُدَّ شَیْئًا ، قَالَ : ثُمَّ أَمَرَ بِلاَلاً فَأَقَامَ حِینَ انْشَقَّ الْفَجْرُ فَصَلَّی ، ثُمَّ أَمَرَہُ فَأَقَامَ الصَّلاَۃَ وَالْقَائِلُ یَقُولُ : قَدْ زَالَتِ الشَّمْسُ ، أَوْ لَمْ تَزُلْ ، وَہُوَ کَانَ أَعْلَمَ مِنْہُمْ، ثُمَّ أَمَرَہُ فَأَقَامَ الْعَصْرَ وَالشَّمْسُ مُرْتَفِعَۃٌ ، وَأَمَرَہُ فَأَقَامَ الْمَغْرِبَ حِینَ وَقَعَتِ الشَّمْسُ ، وَأَمَرَہُ فَأَقَامَ الْعِشَائَ عِنْدَ سُقُوطِ الشَّفَقِ ، ثُمَّ صَلَّی الْفَجْرَ مِنَ الْغَدِ وَالْقَائِلُ یَقُولُ : قَدْ طَلَعَتِ الشَّمْسُ ، أَوْ لَمْ تَطْلُعْ ، وَہُوَ کَانَ أَعْلَمَ مِنْہُمْ ، وَصَلَّی الظُّہْرَ قَرِیبًا مِنْ وَقْتِ الْعَصْرِ بِالأَمْسِ ، وَصَلَّی الْعَصْرَ وَالْقَائِلُ یَقُولُ : قَدِ احْمَرَّتِ الشَّمْسُ ، وَصَلَّی الْمَغْرِبَ قَبْلَ أَنْ یَغِیبَ الشَّفَقُ ، وَصَلَّی الْعِشَائَ ثُلُثَ اللَّیْلِ الأَوَّلَ ، ثُمَّ قَالَ : أَیْنَ السَّائِلُ عَنِ الْوَقْتِ ؟ مَا بَیْنَ ہَذَیْنِ الْوَقْتَیْنِ وَقْتٌ۔ (مسلم ۱۷۸۔ ابوداؤد ۳۹۸)","Sahih","Musannaf Ibn Abi Shaybah 3240","","","كتاب الصلوات"
"3241","(۳۲۴۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ لِلصَّلاَۃِ أَوَّلاً وَآخِرًا ، وَإِنَّ أَوَّلَ وَقْتِ الظُّہْرِ حِینَ تَزُولُ الشَّمْسُ ، وَإِنَّ آخِرَ وَقْتِہَا حِینَ یَدْخُلُ وَقْتُ الْعَصْرِ ، وَإِنَّ أَوَّلَ وَقْتِ الْعَصْرِ حِینَ یَدْخُلُ وَقْتُ الْعَصْرِ ، وَإِنَّ آخِرَ وَقْتِہَا حِینَ تَصْفَارُّ الشَّمْسُ ، وَإِنَّ أَوَّلَ وَقْتِ الْمَغْرِبِ حِینَ تَغْرُبُ الشَّمْسُ ، وَإِنَّ آخِرَ وَقْتِہَا حِینَ یَغِیبُ الأَفُقُ ، وَإِنَّ أَوَّلَ وَقْتِ الْعِشَائِ الآخِرَۃِ حِینَ یَغِیبُ الأَفُقُ ، وَإِنَّ آخِرَ وَقْتِہَا حِینَ یَنْتَصِفُ اللَّیْلُ ، وَإِنَّ أَوَّلَ وَقْتِ الْفَجْرِ حِینَ یَطْلُعُ الْفَجْرُ ، وَإِنَّ آخِرَ وَقْتِہَا حِینَ تَطْلُعُ الشَّمْسُ۔ (ترمذی ۱۵۱۔ احمد ۲/۲۳۲)","Sahih","Musannaf Ibn Abi Shaybah 3241","","","كتاب الصلوات"
"3242","(۳۲۴۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَوْفٍ ، عَنْ أَبِی الْمِنْہَالِ ، عَنْ أَبِی بَرْزَۃَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی الْہَجِیرَ الَّتِی تَدْعُونَہَا الأَولَی حِین تَدْحُضُ الشَّمْسُ ، وَیُصَلِّی الْعَصْرَ ، ثُمَّ یَرْجِعُ أَحَدُنَا إلَی رَحْلِہِ فِی أَقْصَی الْمَدِینَۃِ وَالشَّمْسُ حَیَّۃٌ ، قَالَ : وَنَسِیت مَا قَالَ فِی الْمَغْرِبِ ، قَالَ : وَکَانَ یَسْتَحِبُّ أَنْ یُؤَخِّرَ مِنَ الْعِشَائِ الَّتِی تَدْعُونَہَا الْعَتَمَۃَ ، وَکَانَ یَنْفَتِلُ مِنْ صَلاَۃِ الْغَدَاۃِ حِینَ یَعْرِفُ الرَّجُلُ جَلِیسَہُ ، وَکَانَ یَقْرَأُ بِالسِّتِّینَ إلَی الْمِئَۃِ۔ (مسلم ۲۳۷۔ ابوداؤد ۴۰۱)","Sahih","Musannaf Ibn Abi Shaybah 3242","","","كتاب الصلوات"
"3243","(۳۲۴۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن مُحَمَّدِ بْنِ عَمْرِو بْنِ حسن، عَنْ جَابِرِ بْن عَبْدِاللہِ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی الظُّہْرَ بِالْہَاجِرَۃِ ،وَالْعَصْرَ وَالشَّمْسُ نَقِیَّۃٌ ، وَالْمَغْرِبَ إذَا وَجَبَتْ ، وَالْعِشَائَ أَحْیَانًا یُؤَخِّرُہَا وَأَحْیَانًا یُعَجِّلُ ، إذَا رَآہُمْ قَدِ اجْتَمَعُوا عَجَّلَ ، وَإِذَا رَآہُمْ قَدْ أَبْطَؤوا أَخَّرَ ، وَالصُّبْحَ ، قَالَ : کَانُوا ، أَوْ قَالَ : وَکَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّیہَا بِغَلَسٍ۔ n(بخاری ۵۶۰۔ مسلم ۲۳۳)","Sahih","Musannaf Ibn Abi Shaybah 3243","","","كتاب الصلوات"
"3244","(۳۲۴۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُئِلَ عَنْ صَلاَۃِ الْفَجْرِ ؟ فَأَمَرَ بِلاَلاً فَأَذَّنَ حِینَ طَلَعَ الْفَجْرُ ، ثُمَّ مِنَ الْغَدِ حِینَ أَسْفَرَ ، ثُمَّ قَالَ : أَیْنَ السَّائِلُ ؟ مَا بَیْنَ ذَیْنِ وَقْتٌ۔","Hasan","Musannaf Ibn Abi Shaybah 3244","","","كتاب الصلوات"
"3245","(۳۲۴۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنِی خَارِجَۃُ بْنُ عَبْدِ اللہِ بْنِ سُلَیْمَانَ بْنِ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : حَدَّثَنِی حُسَیْنُ بْنُ بَشِیر بْنِ سَلْمَانَ ، عَنْ أَبِیہِ ، قَالَ : دَخَلْت أَنَا وَمُحَمَّدُ بْنُ عَلِیٍّ ، أَوْ رَجُلٌ مِنْ آلِ عَلِیٍّ ، عَلَی جَابِرِ بْنِ عَبْدِ اللہِ فَقُلْنَا لَہُ : حَدِّثْنَا کَیْفَ کَانَتِ الصَّلاَۃُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الظُّہْرَ حِینَ کَانَ الظِّلُّ مِثْلَ الشِّرَاکِ ، ثُمَّ صَلَّی بِنَا الْعَصْرَ حِینَ کَانَ الظِّلُّ مِثْلَہُ وَمِثْلَ الشِّرَاکِ ، ثُمَّ صَلَّی بِنَا الْمَغْرِبَ حِینَ غَابَتِ الشَّمْسُ ، ثُمَّ صَلَّی بِنَا الْعِشَائَ حِینَ غَابَ الشَّفَقُ ، ثُمَّ صَلَّی بِنَا الْفَجْرَ حِینَ طَلَعَ الْفَجْرُ ، ثُمَّ صَلَّی بِنَا مِنَ الْغَدِ الظُّہْرَ حِینَ کَانَ ظِلُّ کُلِّ شَیْئٍ مِثْلَہُ ، ثُمَّ صَلَّی بِنَا الْعَصْرَ حِینَ کَانَ ظِلُّ کُلِّ شَیْئٍ مِثْلَیْہِ قَدْرَ مَا یَسِیرُ الرَّاکِبُ إلَی ذِی الْحُلَیْفَۃِ الْعَنَقِ ، ثُمَّ صَلَّی بِنَا الْمَغْرِبَ حِینَ غَابَتِ الشَّمْسُ ، ثُمَّ صَلَّی بِنَا الْعِشَائَ حِینَ ذَہَبَ ثُلُثُ اللَّیْلِ ، ثُمَّ صَلَّی بِنَا الْفَجْرَ فَأَسْفَرَ ۔ فَقُلْنَا لَہُ : کَیْفَ نُصَلِّی مَعَ الْحَجَّاجِ وَہُوَ یُؤَخِّرُ ؟ فَقَالَ : مَا صَلَّی لِلْوَقْتِ فَصَلُّوا مَعَہُ ، فَإِذَا أَخَّرَ فَصَلُّوہَا لِوَقْتِہَا ، وَاجْعَلُوہَا مَعَہُ نَافِلَۃً ، وَحَدِیثِی ہَذَا عِنْدَکُمْ أَمَانَۃٌ فَإِذَا مِتُّ ، فَإِنِ اسْتَطَاعَ الْحَجَّاجُ أَنْ یَنْبُشَنِی فَلْیَنْبُشْنِی۔ (نسائی ۵۲۴)","Majhul","Musannaf Ibn Abi Shaybah 3245","","","كتاب الصلوات"
"3246","(۳۲۴۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، قَالَ : أَخْبَرَنِی بَشِیرُ بْنُ أَبِی مَسْعُودٍ ، عَنْ أَبِیہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : نَزَلَ جِبْرِیلُ فَأَمَّنِی ، حَتَّی عَدَّ خَمْسَ صَلَوَاتٍ۔ (بخاری ۵۲۱۔ مسلم ۴۲۵)","Sahih","Musannaf Ibn Abi Shaybah 3246","","","كتاب الصلوات"
"3247","(۳۲۴۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، قَالَ : سَمِعْتُ أَبَا أَیُّوبَ یُحَدِّثُ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ: وَقْتُ الظُّہْرِ مَا لَمْ یَحْضُرْ وَقْتُ الْعَصْرِ ، وَوَقْتُ الْعَصْرِ مَا لَمْ تَصْفَرَّ الشَّمْسُ ،وَوَقْتُ الْمَغْرِبِ مَا لَمْ یَسْقُطْ ثَوْر الشَّفَقِ ، وَوَقْتُ الْعِشَائِ إلَی نِصْفِ اللَّیْلِ ، وَوَقْتُ الصُّبْحِ مَا لَمْ تَطْلُعِ الشَّمْسُ۔","Sahih","Musannaf Ibn Abi Shaybah 3247","","","كتاب الصلوات"
"3248","(۳۲۴۸) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی أَیُّوبَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ: لَمْ یَرْفَعْہُ مَرَّتَیْنِ ، ثُمَّ رَفَعَہُ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ ثُمَّ ذَکَرَ مِثْلَ حَدِیثِ غُنْدَرٍ۔n(مسلم ۴۲۷۔ احمد ۲/۲۱۳)","Sahih","Musannaf Ibn Abi Shaybah 3248","","","كتاب الصلوات"
"3249","(۳۲۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْمُغِیرَۃِ بْنِ النُّعْمَانِ ، عَنْ عَلِیِّ بْنِ عَمْرٍو قَالَ : أَتَانَا کِتَابُ عُمَرَ : أَنْ صَلُّوا الْفَجْرَ وَالنُّجُومُ مُشْتَبِکَۃٌ نَیِّرَۃٌ ، وَصَلُّوا الظُّہْرَ إذَا زَالَتِ الشَّمْسُ عَنْ بَطْنِ السَّمَائِ ، وَصَلُّوا الْعَصْرَ وَالشَّمْسُ بَیْضَائُ نَقِیَّۃٌ ، وَصَلُّوا الْمَغْرِبَ حِینَ تَغْرُبُ الشَّمْسُ ، وَرَخَّصَ فِی الْعِشَائِ۔","Majhul","Musannaf Ibn Abi Shaybah 3249","","","كتاب الصلوات"
"3250","(۳۲۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ نَافِعِ بْنِ جُبَیْرٍ ، قَالَ : کَتَبَ عُمَرُ إلَی أَبِی مُوسَی : أَنْ صَلِّ الظُّہْرَ إذَا زَالَتِ الشَّمْسُ ، وَصَلِّ الْعَصْرَ وَالشَّمْسُ بَیْضَائُ حَیَّۃٌ ، وَصَلِّ الْمَغْرِبَ إذَا اخْتَلَطَ اللَّیْلُ وَالنَّہَارُ ، وَصَلِّ الْعِشَائَ أَیَّ اللَّیْلِ شِئْتَ ، وَصَلِّ الْفَجْرَ إذَا نَوَّرَ النُّورُ۔","","Musannaf Ibn Abi Shaybah 3250","","","كتاب الصلوات"
"3251","(۳۲۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرٍ ، قَالَ : الظُّہْرُ کَاسْمِہَا ، وَالْعَصْرُ وَالشَّمْسُ بَیْضَائُ حَیَّۃٌ، وَالْمَغْرِبُ کَاسْمِہَا، کُنَّا نُصَلِّی مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَغْرِبَ، ثُمَّ نَأْتِی مَنَازِلَنَا عَلَی قَدْرِ مِیلٍ فَنَرَی مَوَاقِعَ النَّبْلِ ، وَکَانَ یُعَجِّلُ بِالْعِشَائِ ، وَیُؤَخِّرُ ، وَالْفَجْرُ کَاسْمِہَا ، وَکَانَ یُغَلِّسُ بِہَا۔ (احمد ۳/۳۰۳۔ عبدالرزاق ۲۰۹۱)","Da'if","Musannaf Ibn Abi Shaybah 3251","","","كتاب الصلوات"
"3252","(۳۲۵۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : کُنَّ نِسَائُ الْمُؤْمِنَاتِ یُصَلِّینَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلاَۃَ الصُّبْحِ ، ثُمَّ یَرْجِعْنَ إلَی أَہْلِہِنَّ فَلاَ یَعْرِفُہُنَّ أَحَدٌ۔n(بخاری ۵۷۸۔ مسلم ۲۳۱)","Sahih","Musannaf Ibn Abi Shaybah 3252","","","كتاب الصلوات"
"3253","(۳۲۵۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی الْفَجْرَ ، ثُمَّ یَخْرُجْنَ نِسَائُ الْمُؤْمِنِینَ مُتَلَفِّعات فِی مُرُوطِہِنَّ مَا یُعْرَفْنَ مِنَ الْغَلَسِ۔","Sahih","Musannaf Ibn Abi Shaybah 3253","","","كتاب الصلوات"
"3254","(۳۲۵۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : أَخْبَرَنِی الْمُہَاجِرُ ، قَالَ : قَرَأْتُ کِتَابَ عُمَرَ إلَی أَبِی مُوسَی فِیہِ مَوَاقِیتُ الصَّلاَۃِ ، فَلَمَّا انْتَہَی إلَی الْفَجْرِ ، أَوَ قَالَ : إلَی الْغَدَاۃِ ، قَالَ : قُمْ فِیہَا بِسَوَادٍ ، أَوْ بِغَلَسٍ، وَأَطِلِ الْقِرَائَۃَ۔","Majhul","Musannaf Ibn Abi Shaybah 3254","","","كتاب الصلوات"
"3255","(۳۲۵۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مَنْصُورُ بْنُ حَیَّانَ ، قَالَ : سَمِعْتُ عَمْرَو بْنَ مَیْمُونٍ الأَوْدِیَّ یَقُولُ: إِنْ کُنْتُ لأصَلِّی خَلْفَ عُمَرَ بْنِ الْخَطَّابِ الْفَجْرَ ، وَلَوْ أَنَّ ابْنِی مِنِّی ثَلاَثَۃَ أَذْرُعٍ ، مَا عَرَفْتُہُ حَتَّی یَتَکَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 3255","","","كتاب الصلوات"
"3256","(۳۲۵۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مَنْصُورِ بْنِ حَیَّانَ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إلَی عَبْدِ الْحَمِیدِ : أَنْ غَلِّسْ بِالْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 3256","","","كتاب الصلوات"
"3257","(۳۲۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی سَلْمَانَ ، قَالَ : خَدَمْتُ الرَّکْبَ فِی زَمَانِ عُثْمَانَ ، فَکَانَ النَّاسُ یُغَلِّسُونَ بِالْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 3257","","","كتاب الصلوات"
"3258","(۳۲۵۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ حَبِیبِ بْنِ شِہَابٍ ، عَنْ أَبِیہِ ؛ أَنَّ أَبَا مُوسَی صَلَّی الْفَجْرَ بِسَوَادٍ۔","Sahih","Musannaf Ibn Abi Shaybah 3258","","","كتاب الصلوات"
"3259","(۳۲۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ نَافِعِ بْنِ عُمَرَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ؛ أَنَّہُ صَلَّی مَعَ ابْنِ الزُّبَیْرِ ، فَکَانَ یُغَلِّسُ بِالْفَجْرِ ، فَیَنْصَرِفُ وَلاَ یَعْرِفُ بَعْضُنَا بَعْضًا۔","Sahih","Musannaf Ibn Abi Shaybah 3259","","","كتاب الصلوات"
"3260","(۳۲۶۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنِی عَبْدُ اللہِ بْنُ إیَاسٍ الْحَنَفِیُّ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا نُصَلِّی مَعَ عُثْمَانَ الْفَجْرَ ، فَنَنْصَرِفُ ، وَمَا یَعْرِفُ بَعْضُنَا وُجُوہَ بَعْضٍ۔","Majhul","Musannaf Ibn Abi Shaybah 3260","","","كتاب الصلوات"
"3261","(۳۲۶۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَۃَ ، عَنْ مَحْمُودِ بْنِ لَبِیدٍ ، عَنْ رَافِعِ بْنِ خَدِیجٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَسْفِرُوا بِالْفَجْرِ ، فَإِنَّہُ أَعْظَمُ لِلأَجْرِ۔n(ابوداؤد ۴۲۷۔ احمد ۳/۱۴۰)","Hasan","Musannaf Ibn Abi Shaybah 3261","","","كتاب الصلوات"
"3262","(۳۲۶۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا نُصَلِّی الْفَجْرَ فَیَقْرَأُ إمَامُنَا بِالسُّورَۃِ مِنَ الْمِئِیْنَ وَعَلَیْنَا ثِیَابُنَا ، ثُمَّ نَأْتِی ابْنَ مَسْعُودٍ فَنَجِدُہُ فِی الصَّلاَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 3262","","","كتاب الصلوات"
"3263","(۳۲۶۳) حَدَّثَنَا شَرِیکٌ ، عَنْ سَعِیدِ بْنِ عُبَیْدٍ ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ ؛ أَنَّ عَلِیًّا ، قَالَ : یَا ابْنَ النَّبَّاحِ ، أَسْفِرْ بِالْفَجْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 3263","","","كتاب الصلوات"
"3264","(۳۲۶۴) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ؛ أَنَّ ابْنَ مَسْعُودٍ کَانَ یُنَوِّرُ بِالْفَجْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 3264","","","كتاب الصلوات"
"3265","(۳۲۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ أَبِی رَوْقٍ، عَنْ زِیَادِ بْنِ الْمُقَطِّعِ، قَالَ: رَأَیْتُ الْحُسَیْنَ بْنَ عَلِیٍّ أَسْفَرَ بِالْفَجْرِ جِدًّا۔","Majhul","Musannaf Ibn Abi Shaybah 3265","","","كتاب الصلوات"
"3266","(۳۲۶۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنْ أَبِی الزَّاہِرِیَّۃِ ، عَنْ جُبَیْرِ بْنِ نُفَیْرٍ ، قَالَ : صَلَّی بِنَا مُعَاوِیَۃُ بِغَلَسٍ ، فَقَالَ أَبُو الدَّرْدَائِ : أَسْفِرُوا بِہَذِہِ الصَّلاَۃِ ، فَإِنَّہُ أَفْقَہُ لَکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 3266","","","كتاب الصلوات"
"3267","(۳۲۶۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ رَضِیِّ بْنِ أَبِی عَقِیلٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ رَبِیعُ بْنُ جُبَیْرٍ یَقُولُ لَہُ ، وَکَانَ مُؤَذِّنُہُ : یَا أَبَا عَقِیلٍ ، نَوِّرْ ، نَوِّرْ۔","","Musannaf Ibn Abi Shaybah 3267","","","كتاب الصلوات"
"3268","(۳۲۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ یُنَوِّرُ بِالْفَجْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 3268","","","كتاب الصلوات"
"3269","(۳۲۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عُثْمَانَ بْنِ أَبِی ہِنْدٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَانَ یُسْفِرُ بِالْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 3269","","","كتاب الصلوات"
"3270","(۳۲۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ یُسْفِرُونَ بِالْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 3270","","","كتاب الصلوات"
"3271","(۳۲۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عُبَیْدٍ الْمُکْتِبِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یُنَوِّرُ بِالْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 3271","","","كتاب الصلوات"
"3272","(۳۲۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَسْفِرُوا بِالْفَجْرِ ، فَإِنَّکُمْ کُلَّمَا أَسْفَرْتُمْ کَانَ أَعْظَمَ لِلأَجْرِ۔ (طحاوی ۱۷۹)","","Musannaf Ibn Abi Shaybah 3272","","","كتاب الصلوات"
"3273","(۳۲۷۳) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانُوا یُحِبُّونَ أَنْ یَنْصَرِفُوا مِنْ صَلاَۃِ الصُّبْحِ ، وَأَحَدُہُمْ یَرَی مَوْضِعَ نَبْلِہِ۔","","Musannaf Ibn Abi Shaybah 3273","","","كتاب الصلوات"
"3274","(۳۲۷۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ بِشْرِ بْنِ عُرْوَۃَ ، قَالَ : سَافَرْت مَعَ عَلْقَمَۃَ ، فَکَانَ یُنَوِّرُ بِالصُّبْحِ۔","","Musannaf Ibn Abi Shaybah 3274","","","كتاب الصلوات"
"3275","(۳۲۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَا أَجْمَعَ أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی شَیْئٍ مَا أَجْمَعُوا عَلَی التَّنْوِیرِ بِالْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 3275","","","كتاب الصلوات"
"3276","(۳۲۷۶) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ نَفَاعَۃَ بْنِ مُسْلِمٍ ، قَالَ : کَانَ سُوَیْد بْنُ غَفَلَۃَ یُسْفِرُ بِالْفَجْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 3276","","","كتاب الصلوات"
"3277","(۳۲۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ وِقَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یُنَوِّرُ بِالْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 3277","","","كتاب الصلوات"
"3278","(۳۲۷۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ رَجُلٍ ؛ أَنَّ أُنَاسًا مِنْ أَصْحَابِ عَبْدِ اللہِ کَانُوا یُسْفِرُونَ بِصَلاَۃِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 3278","","","كتاب الصلوات"
"3279","(۳۲۷۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ أَبِی حَصِینٍ ، عَنْ خَرَشَۃَ ، قَالَ : صَلَّی عُمر بِالنَّاسِ الْفَجْر فَغَلَّسَ وَنَوَّرَ ، وَصَلَّی بِہِمْ فِیمَا بَیْنَ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 3279","","","كتاب الصلوات"
"3280","(۳۲۸۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : صَلَّی الْمُغِیرَۃُ بْنُ شُعْبَۃَ الصُّبْحَ فَغَلَّسَ وَنَوَّرَ ، حَتَّی قُلْتُ : قَدْ طَلَعَتِ الشَّمْسُ ، أَوْ لَمْ تَطْلُعْ ، وَصَلَّی فِیمَا بَیْنَ ذَلِکَ ، وَکَانَ مُؤَذِّنُہُ ابْنَ النَّبَّاحِ ، وَلَمْ یَکُنْ لَہُ مُؤَذِّنٌ غَیْرُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 3280","","","كتاب الصلوات"
"3281","(۳۲۸۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ سَدُوسٍ ، رَجُلٍ مِنَ الْحَیِّ ؛ أَنَّ الرَّبِیعَ ، قَالَ : نَوِّرْ ، نَوِّرْ۔","","Musannaf Ibn Abi Shaybah 3281","","","كتاب الصلوات"
"3282","(۳۲۸۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الرُّکَیْنِ الضَّبِّیِّ ، قَالَ : سَمِعْتُ تَمِیمَ بْنَ حَذْلَمَ ، وَکَانَ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، یَقُولُ : نَوِّرْ ، نَوِّرْ بِالصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 3282","","","كتاب الصلوات"
"3283","(۳۲۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَکِیمِ بْنِ جُبَیْرٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ قَالَتْ : مَا رَأَیْتُ أَحَدًا کَانَ أَشَدَّ تَعْجِیلاً لِلظُّہْرِ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلاَ أَبًو بَکْرٍ ، وَلاَ عُمَرَ۔n(ترمذی ۱۵۵۔ احمد ۶/۱۳۵)","Da'if","Musannaf Ibn Abi Shaybah 3283","","","كتاب الصلوات"
"3284","(۳۲۸۴) حَدَّثَنَا جَرِیرٌ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : کَانَ عُمَرُ یُصَلِّی الظُّہْرَ حِینَ تَزُولُ الشَّمْسُ۔","Sahih","Musannaf Ibn Abi Shaybah 3284","","","كتاب الصلوات"
"3285","(۳۲۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنْ مَسْرُوقٍ ، قَالَ : صَلَّی بِنَا عَبْدُ اللہِ بْنُ مَسْعُودٍ الظُّہْرَ حِینَ زَالَتِ الشَّمْسُ ، ثُمَّ قَالَ : ہَذَا ، وَالَّذِی لاَ إلَہَ غَیْرُہُ ، وَقْتُ ہَذِہِ الصَّلاَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 3285","","","كتاب الصلوات"
"3286","(۳۲۸۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ عَنْ مَسْرُوقٍ ، قَالَ : لَمَّا زَالَتِ الشَّمْسُ جَائَ أَبُو مُوسَی ، فَقَالَ : أَیْنَ صَاحِبُکُمْ ؟ ہَذَا وَقْتُ ہَذِہِ الصَّلاَۃِ ، فَلَمْ یَلْبَثْ أَنْ جَائَ عَبْدُ اللہِ مُسْرِعًا ، فَصَلَّی الظُّہْرَ۔","Sahih","Musannaf Ibn Abi Shaybah 3286","","","كتاب الصلوات"
"3287","(۳۲۸۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَوْفٍ ، قَالَ : حدَّثَنِی أَبُو الْمِنْہَالِ ، قَالَ : انْتَہَیْت مَعَ أَبِی إلَی أَبِی بَرْزۃَ ، فَقَالَ : حَدِّثْنَا کَیْفَ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی الْمَکْتُوبَۃَ ؟ فَقَالَ : کَانَ یُصَلِّی الْہَجِیرَ الَّتِی تَدْعُونَہَا الأُولَی حِینَ تَدْحَضُ الشَّمْسُ۔","Sahih","Musannaf Ibn Abi Shaybah 3287","","","كتاب الصلوات"
"3288","(۳۲۸۸) حَدَّثَنَا إسْمَاعِیلُ بْنُ إبْرَاہِیمَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَتْ أُمُّ سَلَمَۃَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَشَدَّ تَعْجِیلاً لِلظُّہْرِ مِنْکُمْ ، وَأَنْتُمْ أَشَدُّ تَأْخِیرًا لِلْعَصْرِ مِنْہُ۔ n(ترمذی ۱۶۳۔ احمد ۶/۳۱۰)","","Musannaf Ibn Abi Shaybah 3288","","","كتاب الصلوات"
"3289","(۳۲۸۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ حَبِیبِ بْنِ شِہَابٍ ، عَنْ أَبِیہِ ، قَالَ : سَأَلْتُ أَبَا ہُرَیْرَۃَ عَنْ وَقْتِ الظُّہْرِ ؟ فَقَالَ : إذَا زَالَتِ الشَّمْسُ عَنْ نِصْفِ النَّہَارِ ، وَکَانَ الظِّلُّ قِیسَ الشِّرَاکِ فَقَدْ قَامَتِ الظُّہْرُ۔","Sahih","Musannaf Ibn Abi Shaybah 3289","","","كتاب الصلوات"
"3290","(۳۲۹۰) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : حدَّثَنِی مَیْمُونُ بْنُ مِہْرَانَ ؛ أَنَّ سُوَیْد بْنَ غَفَلَۃَ کَانَ یُصَلِّی الظُّہْرَ حِینَ تَزُولُ الشَّمْسُ فَأَرْسَلَ إلَیْہِ الْحَجَّاجُ لاَ تَسْبِقْنَا بِصَلاَتِنَا ، فَقَالَ سُوَیْد : قَدْ صَلَّیْتہَا مَعَ أَبِی بَکْرٍ وَعُمَرَ ہَکَذَا ، وَالْمَوْتُ أَقْرَبُ إلَیَّ مِنْ أَنْ أَدَعَہَا۔","","Musannaf Ibn Abi Shaybah 3290","","","كتاب الصلوات"
"3291","(۳۲۹۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إسْمَاعِیلَ بْنِ سُمَیْعٍ ، عَنْ مُسْلِمٍ الْبَطِینِ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ : کَانَ عُمر یَنْصَرِفُ مِنَ الْہَجْر فِی الْحَرِّ ، ثُمَّ یَنْطَلِقُ الْمُنْطَلِقُ إلَی قُبَائَ فَیَجِدُہُمْ یُصَلُّونَ۔","","Musannaf Ibn Abi Shaybah 3291","","","كتاب الصلوات"
"3292","(۳۲۹۲) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ سِمَاکٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : کَانَ بِلاَلٌ یُؤَذِّنُ إذَا دَحَضَتِ الشَّمْسُ۔ (مسلم ۱۸۸۔ ابوداؤد ۴۰۶)","Hasan","Musannaf Ibn Abi Shaybah 3292","","","كتاب الصلوات"
"3293","(۳۲۹۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ وَہْبٍ ، عَنْ خبّاب ، قَالَ : شَکَوْنَا إلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الصَّلاَۃَ فِی الرَّمْضَائِ ، فَلَمْ یُشْکِنَا۔ (مسلم ۱۸۹۔ احمد ۵/۱۰۸)","Sahih","Musannaf Ibn Abi Shaybah 3293","","","كتاب الصلوات"
"3294","(۳۲۹۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ سَعِیدِ بْنِ الْحَارِثِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : کُنْتُ أُصَلِّی مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الظُّہْرَ ، فَآخُذُ قَبْضَۃً مِنَ الْحَصَی فَأَجْعَلُہَا فِی کَفِّی ، ثُمَّ أُحَوِّلُہَا إلَی الْکَفِّ الأُخْرَی حَتَّی تَبْرُدَ ، ثُمَّ أَضَعُہَا لِجَبِینِی حِینَ أَسْجُدُ ، مِنْ شِدَّۃِ الْحَرِّ۔n(ابوداؤد ۴۰۲۔ احمد ۳/۳۲۷)","Hasan","Musannaf Ibn Abi Shaybah 3294","","","كتاب الصلوات"
"3295","(۳۲۹۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : کُنَّا نُصَلِّی مَعَہُ الظُّہْرَ أَحْیَانًا نَجِدُ ظِلاًّ نَجْلِسُ فِیہِ ، وَأَحْیَانًا لاَ نَجِدُ ظِلاًّ نَجْلِسُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 3295","","","كتاب الصلوات"
"3296","(۳۲۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زَیْدِ بْنِ جُبَیْرٍ ، عَنْ خِشْفِ بْنِ مَالِکٍ ، قَالَ : صَلَّی بِنَا عَبْدُ اللہِ وَإِنَّ الْجَنَادِبَ لَتَنْقُِزُ مِنْ شِدَّۃِ الرَّمْضَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 3296","","","كتاب الصلوات"
"3297","(۳۲۹۷) حَدَّثَنَا حَفْصٌ ، عَنِ أَبِی الَعَنْبَسِ ، قَالَ : سَأَلْتُ أَبِی ، قُلْتُ : صَلَّیْتَ مَعَ عَلِیٍّ ، فَأَخْبِرْنِی کَیْفَ کَانَ یُصَلِّی الظُّہْرَ ؟ فَقَالَ : إذَا زَالَتِ الشَّمْسُ۔","Sahih","Musannaf Ibn Abi Shaybah 3297","","","كتاب الصلوات"
"3298","(۳۲۹۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، قَالَ : سَأَلْتُ جَعْفَرًا عَنْ وَقْتِ الظُّہْرِ ؟ فَقَالَ : إذَا زَالَتِ الشَّمْسُ ، ثُمَّ قَالَ : تسْمَعْ ، لأَنْ یُؤَخِّرَہَا رَجُلٌ حَتَّی یُصَلِّیَ الْعَصْرَ خَیْرٌ لَہُ مِنْ أَنْ یُصَلِّیَہَا قَبْلَ أَنْ تَزُولَ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 3298","","","كتاب الصلوات"
"3299","(۳۲۹۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَبْرِدُوا بِالصَّلاَۃِ ، یَعْنِی الظُّہْرَ ، فَإِنَّ شِدَّۃَ الْحَرِّ مِنْ فَیْحِ جَہَنَّمَ۔n(بخاری ۳۲۵۹۔ احمد ۳/۵۹)","Sahih","Musannaf Ibn Abi Shaybah 3299","","","كتاب الصلوات"
"3300","(۳۳۰۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ نَبِیُّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَبْرِدُوا بِالصَّلاَۃِ ، فَإِنَّ حَرَّ الظَّہِیرَۃِ مِنْ فَیْحِ جَہَنَّمَ۔ (بخاری ۵۳۶۔ مسلم ۴۳۰)","Da'if","Musannaf Ibn Abi Shaybah 3300","","","كتاب الصلوات"
"3301","(۳۳۰۱) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ شُعْبَۃَ ، قَالَ : حدَّثَنَا الْمُہَاجِرُ أَبُو الْحَسَنِ ، قَالَ : سَمِعْتُ زَیْدَ بْنَ وَہْبٍ یُحَدِّثُ ، عَنْ أَبِی ذَرٍّ ، قَالَ : کُنَّا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَسِیرٍ فَأَرَادَ بِلاَلٌ أَنْ یُؤَذِّنَ ، فَقَالَ لَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَبْرِدْ ، ثُمَّ أَرَادَ أَنْ یُؤَذِّنَ ، فَقَالَ : أَبْرِدْ ، حَتَّی رَأَیْنَا فَیْئَ التُّلُولِ ، ثُمَّ أَذَّنَ فَصَلَّی الظُّہْرَ ، ثُمَّ قَالَ : إنَّ شِدَّۃَ الْحَرِّ مِنْ فَیْحِ جَہَنَّمَ ، فَإِذَا اشْتَدَّ الْحَرُّ فَأَبْرِدُوا بِالصَّلاَۃِ۔n(بخاری ۵۳۵۔ مسلم ۴۳۱)","Sahih","Musannaf Ibn Abi Shaybah 3301","","","كتاب الصلوات"
"3302","(۳۳۰۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مُوسَی ، عَنْ أَبِی مُوسَی ، أَنَّہُ کَانَ یَقُولُ : أَبْرِدُوا بِالصَّلاَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 3302","","","كتاب الصلوات"
"3303","(۳۳۰۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ، قَالَ : أَذَّنَ أَبُو مَحْذُورَۃَ بِصَلاَۃِ الظُّہْرِ بِمَکَّۃَ ، فَقَالَ لَہُ عُمَرُ : أَصَوْتُک یَا أَبَا مَحْذُورَۃَ الَّذِی سَمِعْتُ ؟ قَالَ : نَعَمْ ، ذَخَرْتُہُ لَکَ یَا أَمِیرَ الْمُؤْمِنِینَ لأَسْمِعَکَہُ ، فَقَالَ عُمَرُ : یَا أَبَا مَحْذُورَۃَ ، إنَّک بِأَرْضٍ شَدِیدَۃِ الْحَرِّ ، فَأَبْرِدْ بِالصَّلاَۃِ ، ثُمَّ أَبْرَدَ بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 3303","","","كتاب الصلوات"
"3304","(۳۳۰۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : الْحَرُّ ، أَوْ شِدَّۃُ الْحَرِّ مِنْ فَیْحِ جَہَنَّمَ ، فَأَبْرِدُوا بِالظُّہْرِ۔","","Musannaf Ibn Abi Shaybah 3304","","","كتاب الصلوات"
"3305","(۳۳۰۵) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، قَالَ : حدَّثَنَا بَشِیر بْن سَلْمَانَ ، عَنِ الْقَاسِمِ بْنِ صَفْوَانَ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : أَبْرِدُوا بِصَلاَۃِ الظُّہْرِ ، فَإِنَّ شِدَّۃَ الْحَرِّ مِنْ فَیْحِ جَہَنَّمَ۔n(بخاری ۲۹۲۳۔ احمد ۴/۲۶۲)","Hasan","Musannaf Ibn Abi Shaybah 3305","","","كتاب الصلوات"
"3306","(۳۳۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : إسْمَاعِیلُ ، عَنْ قَیْسٍ ، قَالَ : کَانَ یُقَالُ : أَبْرِدُوا بِالظُّہْرِ فَإِنَّ أَبْوَابَ جَہَنَّمَ تُفْتَحُ۔","","Musannaf Ibn Abi Shaybah 3306","","","كتاب الصلوات"
"3307","(۳۳۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ مُنْذِرٍ ، قَالَ : قَالَ عُمَرُ : أَبْرِدُوا بِالظُّہْرِ ، فَإِنَّ شِدَّۃَ الْحَرِّ مِنْ فَیْحِ جَہَنَّمَ۔","Majhul","Musannaf Ibn Abi Shaybah 3307","","","كتاب الصلوات"
"3308","(۳۳۰۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ کَثِیرِ بْنِ مُدْرِکٍ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، قَالَ : قَالَ عَبْدُ اللہِ : إنَّ أَوَّلَ وَقْتِ الظُّہْرِ أَنْ تَنْظُرَ إلَی قَدَمَیْک فَتَقِیسَ ثَلاَثَۃَ أَقْدَامٍ إلَی خَمْسَۃِ أَقْدَامٍ ، وَإِنَّ أَوَّلَ الْوَقْتِ الأَخِرِ خَمْسَۃُ أَقْدَامٍ إلَی سَبْعَۃِ أَقْدَامٍ ، أَظُنُّہُ قَالَ : فِی الشِّتَائِ۔","Hasan","Musannaf Ibn Abi Shaybah 3308","","","كتاب الصلوات"
"3309","(۳۳۰۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، قَالَ : کَانُوا یُصَلُّونَ الظُّہْرَ وَالظِّلُّ قَامَۃٌ۔","","Musannaf Ibn Abi Shaybah 3309","","","كتاب الصلوات"
"3310","(۳۳۱۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُصَلَّی الظُّہْرُ إذَا کَانَ الظِّلُّ ثَلاَثَۃَ أَذْرُعٍ ، وَإِنْ عَجَّلَتْ بِرَجُلٍ حَاجَۃٌ صَلَّی قَبْلَ ذَلِکَ ، وَإِنْ شَغَلَہُ شَیْئٌ صَلَّی بَعْدَ ذَلِکَ ، قَالَ زَائِدَۃُ : قُلْتُ لِمَنْصُورٍ : أَلَیْسَ إِنَّمَا یَعْنِی ذَلِکَ فِی الصَّیْفِ ؟ قَالَ : بَلَی۔","","Musannaf Ibn Abi Shaybah 3310","","","كتاب الصلوات"
"3311","(۳۳۱۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : إذَا کَانَ ظِلُّ الرَّجُلِ ثَلاَثَۃَ أَذْرُعٍ فَہُوَ وَقْتُ صَلاَۃِ الظُّہْرِ۔","","Musannaf Ibn Abi Shaybah 3311","","","كتاب الصلوات"
"3312","(۳۳۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : صَلَّیْت مَعَ ابْنِ عُمَرَ فَأَرَدْت أَنْ أَقِیسَ صَلاَتَہُ ، فَفَطِنْتُ لِظِلِّی فَقِسْتُہُ ، فَوَجَدْتُہُ ثَلاَثَۃَ أَذْرُعٍ۔","Sahih","Musannaf Ibn Abi Shaybah 3312","","","كتاب الصلوات"
"3313","(۳۳۱۳) حَدَّثَنَا فَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا حُرَیْثُ بْنُ السَّائِبِ ، قَالَ : سَأَلْتُ مُحَمَّدَ بْنَ سِیرِینَ عَنْ وَقْتِ صَلاَۃِ الظُّہْرِ ؟ فَقَالَ : إذَا کَانَ ظِلُّہُ ثَلاَثَۃَ أَذْرُعٍ فَذَاکَ حِینَ تُصَلَّی الظُّہْرُ۔","","Musannaf Ibn Abi Shaybah 3313","","","كتاب الصلوات"
"3314","(۳۳۱۴) حَدَّثَنَا الْفَضْلُ بْن[corrupt] دُکَیْنٍ ، قَالَ : حدَّثَنَا حُرَیْثُ بْنُ السَّائِبِ ، قَالَ : سَأَلْتُ الْحَسَنَ عَنْ وَقْتِ الظُّہْرِ ؟ فَقَالَ : إذَا زَالَ الْفَیْئُ عَنْ طُولِ الشَّیْئِ فَذَاکَ حِینَ تُصَلَّی الظُّہْرُ۔","","Musannaf Ibn Abi Shaybah 3314","","","كتاب الصلوات"
"3315","(۳۳۱۵) حَدَّثَنَا وَکِیعٌ ، وَمُعَاذٌ ، کِلاَہُمَا عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : لَیْسَ الْوَقْتُ مَمْدُودًا کَالشِّرَاکِ ، مَنْ أَخْطَأَہُ ہَلَکَ۔","","Musannaf Ibn Abi Shaybah 3315","","","كتاب الصلوات"
"3316","(۳۳۱۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی الْعَصْرَ وَالشَّمْسُ طَالِعَۃٌ فِی حُجْرَتِی ، لَمْ یَظْہَرِ الْفَیئُ بَعْدُ۔ (بخاری ۵۲۲۔ ابوداؤد ۴۱۰)","Sahih","Musannaf Ibn Abi Shaybah 3316","","","كتاب الصلوات"
"3317","(۳۳۱۷) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ رِبْعِیِّ بْنِ حِرَاشٍ ، عَنْ أَبِی الأَبْیَضِ ، عَنْ أَنَسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی الْعَصْرَ وَالشَّمْسُ بَیْضَائُ مُحَلِّقَۃٌ ، ثُمَّ آتِی عَشِیرَتِی فِی جَانِبِ الْمَدِینَۃِ لَمْ یُصَلُّوا فَأَقُولُ : مَا یُجْلِسُکُمْ ؟ صَلُّوا ، فَقَدْ صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔n(احمد ۳/۲۳۲۔ دارقطنی ۱۰)","Sahih","Musannaf Ibn Abi Shaybah 3317","","","كتاب الصلوات"
"3318","(۳۳۱۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ عَبْدَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ ، قَالَ : کَتَبْتُ إلَی عُمَرَ أَسْأَلُہُ عَنْ وَقْتِ الْعَصْرِ ؟ فَکَتَبَ إلَیَّ أَنْ صَلِّ الْعَصْرَ إذَا کَانَتِ الشَّمْسُ بَیْنَ الشِّقَّیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 3318","","","كتاب الصلوات"
"3319","(۳۳۱۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ یُصَلِّی الْعَصْرَ وَالشَّمْسُ بَیْضَائُ نَقِیَّۃٌ ، یُعَجِّلُہَا مَرَّۃً ، وَیُؤَخِّرُہَا أُخْرَی۔","","Musannaf Ibn Abi Shaybah 3319","","","كتاب الصلوات"
"3320","(۳۳۲۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ خَیْثَمَۃَ ، قَالَ : تُصَلَّی الْعَصْرُ وَالشَّمْسُ بَیْضَائُ حَیَّۃٌ ، وَحَیَاتُہَا أَنْ تَجِدَ حَرَّہَا۔","","Musannaf Ibn Abi Shaybah 3320","","","كتاب الصلوات"
"3321","(۳۳۲۱) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِیِّ ، عَنْ أَبِی النَّجَاشِیِّ ، عَنْ رَافِعِ بْنِ خَدِیجٍ ، قَالَ : کُنَّا نُصَلِّی مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ نَنْحَرُ الْجَزُورَ ، فَنَقْسِمُ عَشَرَۃَ أَجْزَائٍ ، ثُمَّ نَطْبُخُ ، وَنَأْکُلُ لَحْمًا نَضِیجًا قَبْلَ أَنْ نُصَلِّیَ الْمَغْرِبَ۔ (بخاری ۲۴۸۰۔ مسلم ۴۳۵)","Sahih","Musannaf Ibn Abi Shaybah 3321","","","كتاب الصلوات"
"3322","(۳۳۲۲) حَدَّثَنَا حَفْصٌ ، عَنْ أَبِی الَعَنْبَسِ ، قَالَ : سَأَلْتُ أَبِی ، قُلْتُ : صَلَّیْتَ مَعَ عَلِیٍّ ، فَأَخْبِرْنِی کَیْفَ کَانَ یُصَلِّی الْعَصْرَ ؟ فَقَالَ : کَانَ یُصَلِّی الْعَصْرَ وَالشَّمْسُ مُرْتَفِعَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 3322","","","كتاب الصلوات"
"3323","(۳۳۲۳) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ ہِشَامٍ، عَنْ أَبِیہِ ، قَالَ: قدِمَ رَجُلٌ عَلَی الْمُغِیرَۃِ بْنِ شُعْبَۃَ وَہُوَ عَلَی الْکُوفَۃِ، فَرَآہُ یُؤَخِّرُ الْعَصْرَ، فَقَالَ لَہُ: لِمَ تُؤَخِّرُ الْعَصْرَ ؟ فَقَدْ کُنْتُ أُصَلِّیہَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ أَرْجِعُ إلَی أَہْلِی إلَی بَنِی عَمْرِو بْنِ عَوْفٍ وَالشَّمْسُ مُرْتَفِعَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 3323","","","كتاب الصلوات"
"3324","(۳۳۲۴) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنِ ابْنِ شِہَابٍ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی الْعَصْرَ وَالشَّمْسُ مُرْتَفِعَۃٌ حَیَّۃٌ ، فَیَذْہَبُ الذَّاہِبُ فَیَأْتِی الْعَوَالِیَ وَالشَّمْسُ مُرْتَفِعَۃٌ۔n(مسلم ۱۹۲۔ ابوداؤد ۴۰۷)","Sahih","Musannaf Ibn Abi Shaybah 3324","","","كتاب الصلوات"
"3325","(۳۳۲۵) - حَدَّثَنِی أَحْمَدُ بْنُ إِسْحَاقَ ، عَنْ وُہَیْبٍ ، عَنْ أَبِی وَاقِدٍ ، عَنْ أَبِی أَرْوَی ، قَالَ : کُنْتُ أُصَلِّی مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْعَصْرَ، ثُمَّ آتِی الشَّجَرَۃَ، یَعْنِی ذَا الْحُلَیْفَۃِ قَبْلَ أَنْ تَغِیبَ الشَّمْسُ۔(طحاوی ۱۹۱)","Da'if","Musannaf Ibn Abi Shaybah 3325","","","كتاب الصلوات"
"3326","(۳۳۲۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی الْعَصْرَ ، ثُمَّ أَخْرَجَ مَالاً یَقْسِمُہُ یُبَادِرُ بِہِ اللَّیْلَ۔","","Musannaf Ibn Abi Shaybah 3326","","","كتاب الصلوات"
"3327","(۳۳۲۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَبِی عَاصِمٍ ، عَنْ أَبِی عَوْنٍ ؛ أَنَّ عَلِیًّا کَانَ یُؤَخِّرُ الْعَصْرَ حَتَّی تَرْتَفِعَ الشَّمْسُ عَلَی الْحِیطَانِ۔","","Musannaf Ibn Abi Shaybah 3327","","","كتاب الصلوات"
"3328","(۳۳۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ مُنَبِّہٍ ، عَنْ سَوَّارِ بْنِ شَبِیبٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّہُ کَانَ یُؤَخِّرُ الْعَصْرَ حَتَّی أَقُولَ : قدِ اصْفَرَّتِ الشَّمْسُ۔","Sahih","Musannaf Ibn Abi Shaybah 3328","","","كتاب الصلوات"
"3329","(۳۳۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، وَإِسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یُؤَخِّرُ الْعَصْرَ۔","Sahih","Musannaf Ibn Abi Shaybah 3329","","","كتاب الصلوات"
"3330","(۳۳۳۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ ابْنُ أَخِی الأَسْوَدِ مُؤَذِّنَہُمْ ، فَکَانَ یُعَجِّلُ الْعَصْرَ ، فَقَالَ لَہُ الأَسْوَدُ : لَتُطِیعُنَا فِی أَذَانِنَا ، أَوْ لَتَعْتَزِلَنَّ مُؤَذِّنِینَا۔","","Musannaf Ibn Abi Shaybah 3330","","","كتاب الصلوات"
"3331","(۳۳۳۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ مَنْ قَبْلَکُمْ أَشَدَّ تَأْخِیرًا لِلْعَصْرِ مِنْکُمْ۔","","Musannaf Ibn Abi Shaybah 3331","","","كتاب الصلوات"
"3332","(۳۳۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ وَکِیعٍ ، قَالَ : قَالَ لِی إبْرَاہِیمُ : لاَ تُقِمِ الْعَصْرَ حَتَّی لاَ تَسْمَعَ حَوْلَک مُؤَذِّنًا۔","","Musannaf Ibn Abi Shaybah 3332","","","كتاب الصلوات"
"3333","(۳۳۳۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : أَتَیْتُ عَبْدَ الرَّحْمَنِ بْنَ الأَسْوَدِ وَہُوَ یَتَوَضَّأُ ، فَقَالَ : غَلَبَنَا الْحَوَّاکُونَ عَلَی صَلاَتِنَا یُعَجِّلُونَہَا ، یَعْنِی الْعَصْرَ۔","","Musannaf Ibn Abi Shaybah 3333","","","كتاب الصلوات"
"3334","(۳۳۳۴) حَدَّثَنَا جَرِیرٌ عن أبی سنان ، عَنِ ابْنِ أَبِی الْہُذَیْلِ ، قَالَ: تُصَلَّی العصر قَدْرَ مَا تَسِیرُ الْعِیرُ فَرْسَخًا إلَی غُرُوبِ الشَّمْسِ۔","","Musannaf Ibn Abi Shaybah 3334","","","كتاب الصلوات"
"3335","(۳۳۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ مَرْدَانُبَۃَ ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ ، قَالَ : سَأَلْتُ أَنَسًا عَنْ وَقْتِ الْعَصْرِ ؟ فَقَالَ : وَقْتُہَا أَنْ تَسِیرَ سِتَّۃَ أَمْیَالٍ إلَی أَنْ تَغْرُبَ الشَّمْسُ۔","Sahih","Musannaf Ibn Abi Shaybah 3335","","","كتاب الصلوات"
"3336","(۳۳۳۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ حَرِیشٍ ، عَنْ طَلْحَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : تُصَلَّی الْعَصْرُ إذَا کَانَ الظِّلُّ وَاحِدًا وَعِشْرِینَ قَدَمًا فِی الشِّتَاء وَالصَّیْفِ۔","","Musannaf Ibn Abi Shaybah 3336","","","كتاب الصلوات"
"3337","(۳۳۳۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : إنَّمَا سُمِّیَتِ الْعَصْرَ لِتَعْتَصِرَ۔","","Musannaf Ibn Abi Shaybah 3337","","","كتاب الصلوات"
"3338","(۳۳۳۸) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عن حمید ، عَنْ أَنَسٍ ، قَالَ : کُنَّا نُصَلِّی الْمَغْرِبَ فِی مَسْجِدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ نَأْتِی بَنِی سَلِمَۃَ ، وَأَحَدُنَا یَرَی مَوْقِعَ نَبْلِہ۔ (ابوداؤد ۴۱۹۔ ابن خزیمۃ ۳۳۸)","Sahih","Musannaf Ibn Abi Shaybah 3338","","","كتاب الصلوات"
"3339","(۳۳۳۹) حَدَّثَنَا عَلِیُّ بْنُ إِسْحَاقَ ، عَنِ ابْنِ مُبَارَکٍ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : حدَّثَنَا أَبُو النَّجَاشِیِّ ، قَالَ : حَدَّثَنَا رَافِعُ بْنُ خَدِیجٍ ، قَالَ : کُنَّا نُصَلِّی الْمَغْرِبَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَیَنْصَرِفُ أَحَدُنَا ، وَإِنَّہُ لَیَنْظُرُ إلَی مَوَاقِعِ نَبْلِہِ۔ (بخاری ۵۵۹۔ مسلم ۴۴۱)","Sahih","Musannaf Ibn Abi Shaybah 3339","","","كتاب الصلوات"
"3340","(۳۳۴۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : قَالَ عُمَرُ : صَلُّوا ہَذِہِ الصَّلاَۃَ وَالْفِجَاجُ مُسْفِرَۃٌ ، یَعْنِی الْمَغْرِبَ۔","Sahih","Musannaf Ibn Abi Shaybah 3340","","","كتاب الصلوات"
"3341","(۳۳۴۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ طَارِقٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : کَانَ عُمَرُ یَکْتُبُ إلَی أُمَرَائِ الأَمْصَارِ أَنْ لاَ تَنْتَظِرُوا بِصَلاَتِکُمَ اشْتِبَاکَ النُّجُومِ۔","Sahih","Musannaf Ibn Abi Shaybah 3341","","","كتاب الصلوات"
"3342","(۳۳۴۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، قَالَ : کَانَ عَبْدُ اللہِ یُصَلِّی الْمَغْرِبَ حِینَ تَغْرُبُ الشَّمْسُ وَیَقُولُ : ہَذَا ، وَالَّذِی لاَ إِلٰہَ إِلاَّ ہُوَ ، وَقْتُ ہَذِہِ الصَّلاَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 3342","","","كتاب الصلوات"
"3343","(۳۳۴۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنْ مُحَمَّدِ بْنِ بِشْرٍ ، قَالَ : کَانَ ابْنُ الْحَنَفِیَّۃِ یَأْمُرُ مُؤَذِّنَہُ فَیُؤَذِّنُ الْمَغْرِبَ حِینَ تَغْرُبُ الشَّمْسُ سَوَائً۔","","Musannaf Ibn Abi Shaybah 3343","","","كتاب الصلوات"
"3344","(۳۳۴۴) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ إسْمَاعِیلَ بْنِ أبی خَالِدٍ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ؛ أَنَّ سُوَیْد بْنَ غَفَلَۃَ کَانَ یَأْمُرُ مُؤَذِّنَہُ أَنْ یُؤَذِّنَ الْمَغْرِبَ إذَا غَرَبَتِ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 3344","","","كتاب الصلوات"
"3345","(۳۳۴۵) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ حَجَّاجٍ الصَّوَّافِ ، عَنْ عَبْدِ اللہِ الدَّانَاجِ ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَنَاضَلُونَ بَعْدَ الْمَغْرِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 3345","","","كتاب الصلوات"
"3346","(۳۳۴۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ حَاجِبِ بْنِ عُمَرَ ، قَالَ : کُنْتُ أَسْمَعُ عَمِّی الْحَکَمَ بْنَ الأَعْرَجِ یَسْأَلُ دِرْہَمًا أَبَا ہِنْدٍ عَنْ ہَذَا الْحَدِیثِ ؟ فَیَقُولُ دِرْہَمٌ : کُنْتُ أُقْبِلُ مِنَ السُّوقِ فَیَتَلَقَّانِی النَّاسُ مُنْصَرِفِینَ ، قَدْ صَلَّی بِہِمْ مَعْقِلُ بْنُ یَسَارٍ ، فَأَتَمَارَی غَرُبَتِ الشَّمْسُ ، أَوْ لَمْ تَغْرُبْ۔","Majhul","Musannaf Ibn Abi Shaybah 3346","","","كتاب الصلوات"
"3347","(۳۳۴۷) حَدَّثَنَا حَفْصٌ ، عَنْ أَبِی الَعَنْبَسِ عَمْرِو بْنِ مَرْوَانَ ، قَالَ : سَأَلْتُ أَبِی ، قُلْتُ : قَدْ صَلَّیْتَ مَعَ عَلِیٍّ ، فَأَخْبِرْنِی کَیْفَ کَانَ یُصَلِّی الْمَغْرِبَ ؟ فَقَالَ : کَانَ یُصَلِّی إذَا سَقَطَ الْقُرْصُ۔","Sahih","Musannaf Ibn Abi Shaybah 3347","","","كتاب الصلوات"
"3348","(۳۳۴۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنِ الزُّہْرِیِّ ، عَنْ رَجُلٍ أَظُنُّہُ قَالَ : مِنْ أَبْنَائِ النُّقَبَائِ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا نُصَلِّی الْمَغْرِبَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ نَرْجِعُ إلَی رِحَالِنَا وَأَحَدُنَا یُبْصِرُ مَوَاقِعَ النَّبْلِ ، قَالَ : قُلْتُ لِلزُّہْرِیِّ : وَکَمْ کَانَتْ مَنَازِلُہُمْ مِنَ الْمَدِینَۃِ ، قَالَ : ثُلُثَیْ مِیلٍ۔ (طبرانی ۱۱۷)","Majhul","Musannaf Ibn Abi Shaybah 3348","","","كتاب الصلوات"
"3349","(۳۳۴۹) حَدَّثَنَا شَبَابَۃُ ، قَالَ: حَدَّثَنَا ابْنُ أَبِی ذِئْبٍ، عَنْ صَالِحٍ مَوْلَی التَّوْأَمَۃِ ، عَنْ زَیْدِ بْنِ خَالِدٍ ، قَالَ : کُنَّا نُصَلِّی مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَغْرِبَ ، ثُمَّ نَنْصَرِفُ إلَی السُّوقِ ، وَلَوْ رُمِیَ بِنَبْلٍ أَبْصَرْتُ مَوَاقِعَہَا۔n(احمد ۴/۱۱۵۔ طبرانی ۵۲۶۰)","Hasan","Musannaf Ibn Abi Shaybah 3349","","","كتاب الصلوات"
"3350","(۳۳۵۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ السُّدِیِّ ، عَنْ أَبِی مَالِکٍ ، عَنْ مَسْرُوقٍ ، قَالَ : صَلَّیْت مَعَ عَبْدِ اللہِ الْمَغْرِبَ ، مِقْدَارَ مَا إذَا رَمَی رَجُلٌ بِسَہْمٍ رَأَی مَوْضِعَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 3350","","","كتاب الصلوات"
"3351","(۳۳۵۱) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ أَبِی حَبِیبَۃَ ، أَنَّہُ بَلَغَہُ عَنْ أَبِی أَیُّوبَ الأَنْصَارِیِّ، أَنَّہُ سَمِعَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : صَلُّوا الْمَغْرِبَ حِینَ فِطْرِ الصَّائِمِ ، مُبَادَرَۃَ طُلُوعِ النُّجُومِ۔ (طبرانی۴۰۸۳)","","Musannaf Ibn Abi Shaybah 3351","","","كتاب الصلوات"
"3352","(۳۳۵۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُؤَخِّرُ الْعِشَائَ الآخِرَۃَ۔ (مسلم ۲۲۶۔ احمد ۵/۸۹)","Hasan","Musannaf Ibn Abi Shaybah 3352","","","كتاب الصلوات"
"3353","(۳۳۵۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ حَبِیبِ بْنِ سَالِمٍ ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ ، قَالَ : أَنَا مِنْ أَعْلَمِ النَّاسِ ، أَوْ کَأَعْلَمِ النَّاسِ بِوَقْتِ صَلاَۃِ ) رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْعِشَائَ ، کَانَ یُصَلِّیہَا بَعْدَ سُقُوطِ الْقَمَرِ لَیْلَۃَ الثَّانِیَۃِ مِنْ أَوَّلِ الشَّہْرِ۔ (ترمذی ۱۶۵۔ احمد ۴/۲۷۰)","Sahih","Musannaf Ibn Abi Shaybah 3353","","","كتاب الصلوات"
"3354","(۳۳۵۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَوْفٍ ، عَنْ أَبِی الْمِنْہَالِ ، عَنْ أَبِی بَرْزَۃَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْتَحِبُّ أَنْ یُؤَخِّرَ مِنَ الْعِشَائِ الَّتِی یَدْعُونَہَا النَّاسُ الْعَتَمَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 3354","","","كتاب الصلوات"
"3355","(۳۳۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَجِّلُ الْعِشَائَ وَیُؤَخِّرُ۔","Da'if","Musannaf Ibn Abi Shaybah 3355","","","كتاب الصلوات"
"3356","(۳۳۵۶) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، قَالَ : حدَّثَنَا ابْنُ شِہَابٍ ، عَنْ عُرْوَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کان یُصَلِّی الْعِشَائَ حِینَ یَسْوَدُّ الأَفُقُ ، وَرُبَّمَا أَخَّرَہَا حَتَّی یَجْتَمِعَ النَّاسُ۔ n(ابوداؤد ۳۹۷۔ ابن خزیمۃ ۳۵۲)","","Musannaf Ibn Abi Shaybah 3356","","","كتاب الصلوات"
"3357","(۳۳۵۷) حَدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ ، عَنِ ابْنِ لَبِیبَۃَ ، قَالَ : قَالَ لِی أَبُو ہُرَیْرَۃَ : صَلِّ الْعِشَائَ إذَا ذَہَبَ الشَّفَقُ وَادْلاَمَّ اللَّیْلُ مَا بَیْنَکَ وَبَیْنَ ثُلُثِ اللَّیْلِ ، وَمَا عَجَّلْتَ بَعْدَ ذَہَابِ بَیَاضِ الأُفُقِ فَہُوَ أَفْضَلُ۔","Majhul","Musannaf Ibn Abi Shaybah 3357","","","كتاب الصلوات"
"3358","(۳۳۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ عُمَرَ کَتَبَ إلَی أَبِی مُوسَی أَنْ صَلِّ الْعِشَائَ إلَی ثُلُثِ اللَّیْلِ ، فَإِنْ أَخَّرْت فَإِلَی الشَّطْرِ ، وَلاَ تَکُنْ مِنَ الْغَافِلِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 3358","","","كتاب الصلوات"
"3359","(۳۳۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ یُؤَخِّرُ الْعِشَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 3359","","","كتاب الصلوات"
"3360","(۳۳۶۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : وَقْتُ الْعِشَائِ الآخِرَۃِ رُبْعُ اللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 3360","","","كتاب الصلوات"
"3361","(۳۳۶۱) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرِو بْنِ مَرْوَانَ ، قَالَ : سَأَلْتُ أَبِی ، قُلْتُ : صَلَّیْتَ مَعَ عَلِیٍّ ، فَأَخْبِرْنِی کَیْفَ کَانَ یُصَلِّی الْعِشَائَ ؟ قَالَ : إذَا غَابَ الشَّفَقُ۔","Sahih","Musannaf Ibn Abi Shaybah 3361","","","كتاب الصلوات"
"3362","(۳۳۶۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : وَقْتُ الْعِشَائِ إلَی ثُلُثِ اللَّیْلِ ، وَلاَ نَوْمَ ، وَلاَ غَفلَۃَ۔","","Musannaf Ibn Abi Shaybah 3362","","","كتاب الصلوات"
"3363","(۳۳۶۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : انْتَظَرْنَا لَیْلَۃً رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِصَلاَۃِ الْعِشَائِ الآخِرَۃِ ، حَتَّی کَانَ ثُلُثُ اللَّیْلِ ، أَوْ بَعْدُ ، ثُمَّ خَرَجَ إلَیْنَا ، فَلاَ أَدْرِی أَشَیْئٌ شَغَلَہُ أَوْ حَاجَۃٌ کَانَتْ لَہُ فِی أَہْلِہِ ، فَقَالَ : مَا أَعْلَمُ أَہْلَ دِینٍ یَنْتَظِرُونَ ہَذِہِ الصَّلاَۃَ غَیْرَکُمْ ، وَلَوْلاَ أَنْ أَشُقَّ عَلَی أُمَّتِی لَصَلَّیْتُ بِہِمْ ہَذِہِ الصَّلاَۃَ ہَذِہِ السَّاعَۃَ۔ (بخاری ۵۷۰۔ ابوداؤد ۴۲۳)","Sahih","Musannaf Ibn Abi Shaybah 3363","","","كتاب الصلوات"
"3364","(۳۳۶۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَأَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْلاَ أَنْ أَشُقَّ عَلَی أُمَّتِی لأَخَّرْتُ صَلاَۃَ الْعِشَائِ إلَی ثُلُثِ اللَّیْلِ ، أَوْ نِصْفِ اللَّیْلِ۔ (ابن ماجہ ۶۹۱)","Sahih","Musannaf Ibn Abi Shaybah 3364","","","كتاب الصلوات"
"3365","(۳۳۶۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَرِیزٌ ، قَالَ : حَدَّثَنَا رَاشِدُ بْنُ سَعْدٍ ، عَنْ عَاصِمِ بْنِ حُمَیْدِ السَّکُونِیِّ ، وَکَانَ مِنْ أَصْحَابِ مُعَاذٍ ، عَنْ مُعَاذِ بْنِ جَبَلٍ ، قَالَ : بَقَیْنَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی صَلاَۃِ الْعِشَائِ حَتَّی أَبْطَأَ ، حَتَّی قَالَ الْقَائِلُ : قَدْ صَلَّی وَلَمْ یَخْرُجْ ، فَخَرَجَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالْقَائِلُ یَقُولُ : یَا رَسُولَ اللہِ ، ظَنَنَّا أَنَّک صَلَّیْت وَلَمْ تَخْرُجْ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَعْتِمُوا بِہَذِہِ الصَّلاَۃِ ، فَقَدْ فُضِّلْتُمْ بِہَا عَلَی سَائِرِ الأُمَمِ ، وَلَمْ تُصَلِّہَا أُمَّۃٌ قَبْلَکُمْ۔n(ابوداؤد ۴۲۴۔ احمد ۵/۲۳۷)","Sahih","Musannaf Ibn Abi Shaybah 3365","","","كتاب الصلوات"
"3366","(۳۳۶۶) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَخَّرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلاَۃَ الْعِشَائِ ذَاتَ لَیْلَۃٍ ، فَخَرَجَ وَرَأْسُہُ یَقْطُرُ فَقَالَ : لَوْلاَ أَنْ أَشُقَّ عَلَی أُمَّتِی لَجَعَلْتُ وَقْتَ ہَذِہِ الصَّلاَۃِ ہَذَا الْحِینَ۔ (دارمی ۱۲۱۵۔ ابن حبان ۱۵۳۳)","Hasan","Musannaf Ibn Abi Shaybah 3366","","","كتاب الصلوات"
"3367","(۳۳۶۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو قَالَ : حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ عَمْرِو بْنِ ضَمْرَۃَ ، عَنْ رَجُلٍ مِنْ جُہَیْنَۃَ ، قَالَ : قَالَ : سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَتَی أُصَلِّی الْعِشَائَ ؟ قَالَ : إذَا مَلأَ اللَّیْلُ بَطْنَ کُلِّ وَادٍ۔ (احمد ۵/۳۶۵)","Majhul","Musannaf Ibn Abi Shaybah 3367","","","كتاب الصلوات"
"3368","(۳۳۶۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عُبَیْدٍ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا نُصَلِّی مَعَ النُّعْمَانِ ، یَعْنِی ابْنَ بَشِیرٍ ، الْمَغْرِبَ فَمَا یَخْرُجُ آخرُنَا حَتَّی یَبْدَأَ بِالْعِشَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 3368","","","كتاب الصلوات"
"3369","(۳۳۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : قَالَ عُمَرُ: عَجِّلُوا الْعِشَائَ قَبْلَ أَنْ یَکْسَلَ الْعَامِلُ ، وَیَنَامَ الْمَرِیضُ۔","Sahih","Musannaf Ibn Abi Shaybah 3369","","","كتاب الصلوات"
"3370","(۳۳۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ أَثْقَلَ الصَّلاَۃِ عَلَی الْمُنَافِقِینَ صَلاَۃُ الْعِشَائِ وَصَلاَۃُ الْفَجْرِ ، وَلَوْ یَعْلَمُونَ مَا فِیہِمَا لأَتَوْہُمَا وَلَوْ حَبْوًا ، وَلَقَدْ ہَمَمْت أَنْ آمُرَ بِالصَّلاَۃِ ، فَتُقَامَ ، ثُمَّ آمُرَ رَجُلاً ، فَیُصَلِّیَ بِالنَّاسِ ، ثُمَّ أَنْطَلِقَ مَعِی بِرِجَالٍ ، مَعَہُمْ حُزَمٌ مِنْ حَطَبٍ إلَی قَوْمٍ لاَ یَشْہَدُونَ الصَّلاَۃَ ، فَأُحَرِّقَ عَلَیْہِمْ بُیُوتَہُمْ بِالنَّارِ۔n(بخاری ۶۵۷۔ ابوداؤد ۵۴۹)","Sahih","Musannaf Ibn Abi Shaybah 3370","","","كتاب الصلوات"
"3371","(۳۳۷۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْعَیْزَارِ بْنِ حُرَیْثٍ ، عَنْ أَبِی بَصِیرٍ ، قَالَ : قَالَ أُبَیّ بْنُ کَعْبٍ : صَلَّی بِنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا قَضَی الصَّلاَۃَ ، رَأَی مِنْ أَہْلِ الْمَسْجِدِ قِلَّۃً ، قَالَ : شَاہِدٌ فُلاَنٌ ؟ قُلْنَا : نَعَمْ ، حَتَّی عَدَّ ثَلاَثَۃَ نَفَرٍ ، فَقَالَ : إِنَّہُ لَیْسَ مِنْ صَلاَۃٍ أَثْقَلُ عَلَی الْمُنَافِقِینَ مِنْ صَلاَۃِ الْعِشَائِ الآخِرَۃِ ، وَمِنْ صَلاَۃِ الْفَجْرِ ، وَلَوْ یَعْلَمُونَ مَا فِیہِمَا لأَتَوْہُمَا وَلَوْ حَبْوًا۔(ابوداؤد ۵۵۵۔ احمد ۵/۱۴۰)","Sahih","Musannaf Ibn Abi Shaybah 3371","","","كتاب الصلوات"
"3372","(۳۳۷۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ یَحْیَی بْنق سَعِیدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کُنَّا إذَا فَقَدْنَا الرَّجُلَ فِی صَلاَۃِ الْعِشَائِ وَصَلاَۃِ الْفَجْرِ ، أَسَأْنَا بِہِ الظَّنَّ۔","Hasan","Musannaf Ibn Abi Shaybah 3372","","","كتاب الصلوات"
"3373","(۳۳۷۳) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی بِشْرٍ ، عَنْ أَبِی عُمَیْرِ بْنِ أَنَسٍ ، قَالَ : حَدَّثَنِی عمُومَتِی مِنَ الأَنْصَارِ قَالُوا : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا یَشْہَدُہُمَا مُنَافِقٌ ، یَعْنِی الْعِشَائَ وَالْفَجْرَ۔n(احمد ۵/۵۷۔ عبدالرزاق ۲۰۲۳)","Sahih","Musannaf Ibn Abi Shaybah 3373","","","كتاب الصلوات"
"3374","(۳۳۷۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : سَمِعْتُ ابْنَ أَبِی لَیْلَی ، عَنْ أَبِی الدَّرْدَائِ ؛ أَنَّہُ قَالَ فِی مَرَضِہِ الَّذِی مَاتَ فِیہِ : أَلاَ احْمِلُونِی ، قَالَ : فَحَمَلُوہُ فَأَخْرَجُوہُ ، فَقَالَ : اسْمَعُوا ، وَبَلِّغُوا مَنْ خَلْفَکُمْ : حَافِظُوا عَلَی ہَاتَیْنِ الصَّلاَتَیْنِ ؛ الْعِشَائِ وَالصُّبْحِ ، وَلَوْ تَعْلَمُونَ مَا فِیہِمَا ) لأَتَیْتُمُوہُمَا وَلَوْ حَبْوًا عَلَی مَرَافِقِکُمْ وَرُکَبِکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 3374","","","كتاب الصلوات"
"3375","(۳۳۷۵) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا شَیْبَانُ ، عَنْ یَحْیَی ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن یُحَنَّسَ ، أَنَّ عَائِشَۃَ أَخْبَرَتْہُ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لَوْ أَنَّ النَّاسَ یَعْلَمُونَ مَا فِی فَضْلِ صَلاَۃِ الْعِشَائِ وَصَلاَۃِ الصُّبْحِ لأَتَوْہُمَا وَلَوْ حَبْوًا۔ (احمد ۶/۸۰۔ نسائی ۳۸۶)","Sahih","Musannaf Ibn Abi Shaybah 3375","","","كتاب الصلوات"
"3376","(۳۳۷۶) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ التَّیْمِیِّ ، عَنِ ابْنِ أَبِی عَمْرَۃَ الأَنْصَارِیِّ ، قَالَ : جِئْت وَعُثْمَانُ جَالِسٌ فِی الْمَسْجِدِ صَلاَۃَ الْعِشَائِ الآخِرَۃِ ، فَجَلَسْتُ إلَیْہِ ، فَقَالَ عُثْمَانُ : شُہُودُ صَلاَۃِ الصُّبْحِ کَقِیَامِ لَیْلَۃٍ ، وَصَلاَۃُ الْعِشَائِ کَقِیَامِ نِصْفِ لَیْلَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 3376","","","كتاب الصلوات"
"3377","(۳۳۷۷) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عُمَرَ ، قَالَ : لأَنْ أُصَلِّیَہُمَا فِی جَمَاعَۃٍ أَحَبُّ إلَیَّ مِنْ أَنْ أُحْیِیَ مَا بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 3377","","","كتاب الصلوات"
"3378","(۳۳۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ n(ح) وَشُعْبَۃُ ، عَنْ نَاجِیَۃَ بْنِ حَسَّانَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عُمَرَ ، قَالَ : لأَنْ أَشْہَدَ الْعِشَائَ وَالْفَجْرَ فِی جَمَاعَۃٍ أَحَبُّ إلَیَّ مِنْ أَنْ أُحْیِیَ مَا بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 3378","","","كتاب الصلوات"
"3379","(۳۳۷۹) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ یَحْیَی بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ، قَالَ : کَانَ عُمَرُ إذَا ہَبَطَ من السُّوقِ مَرَّ عَلَی الشِّفَائِ ابْنَۃِ عَبْدِ اللہِ ، فَمَرَّ عَلَیْہَا یَوْمًا مِنْ رَمَضَانَ ، فَقَالَ : أَیْنَ سُلَیْمَانُ ؟ ابْنُہَا ، قَالَتْ : نَائِمٌ ، قَالَ : وَمَا شَہِدَ صَلاَۃَ الصُّبْحِ ؟ قَالَتْ : لاَ ، قَامَ بِالنَّاسِ اللَّیْلَۃَ ، ثُمَّ جَائَ فَضَرَبَ بِرَأْسِہِ ، فَقَالَ عُمَرُ : شُہُودُ صَلاَۃِ الصُّبْحِ أَحَبُّ إلَیَّ مِنْ قِیَامِ لَیْلَۃٍ حَتَّی الصُّبْحِ۔","","Musannaf Ibn Abi Shaybah 3379","","","كتاب الصلوات"
"3380","(۳۳۸۰) حَدَّثَنَا یَزِیدُ عن ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لأَنْ أَشْہَدَ الْعِشَائَ وَالْفَجْرَ فِی جَمَاعَۃٍ أَحَبُّ إلَیَّ مِنْ أَنْ أُحْیِیَ مَا بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 3380","","","كتاب الصلوات"
"3381","(۳۳۸۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : الشَّفَقُ الْحُمْرَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 3381","","","كتاب الصلوات"
"3382","(۳۳۸۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَوَکِیعٌ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : کَانَ عُبَادَۃُ بْنُ الصَّامِتِ وَشَدَّادُ بْنُ أَوْسٍ یُصَلِّیَانِ الْعِشَائَ الآخِرَۃَ إذَا غَابَتِ الْحُمْرَۃُ۔","","Musannaf Ibn Abi Shaybah 3382","","","كتاب الصلوات"
"3383","(۳۳۸۳) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الْعَوَّامِ بْنِ حَوْشَبٍ ، قَالَ : قُلْتُ لِمُجَاہِدٍ : الشَّفَقُ ، قَالَ : لاَ تَقُلِ الشَّفَقُ ، إنَّ الشَّفَقَ مِنَ الشَّمْسِ ، وَلَکِنْ قُلْ حُمْرَۃَ الأُفُقِ۔","","Musannaf Ibn Abi Shaybah 3383","","","كتاب الصلوات"
"3384","(۳۳۸۴) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : أَخْبَرَنَا فُضَیْلُ بْنُ مَرْزُوقٍ ، قَالَ : سَأَلْتُ جَابِرًا الْجُعْفِیَّ عَنْ ہَذِہِ الآیَۃِ: {حَتَّی یَتَبَیَّنَ لَکُمُ الْخَیْطُ الأَبْیَضُ مِنَ الْخَیْطِ الأَسْوَدِ مِنَ الْفَجْرِ}؟ فَقَالَ : قَالَ سَعِیدُ بْنُ جُبَیْرٍ : فَہُوَ حُمْرَۃُ الأُفُقِ۔","","Musannaf Ibn Abi Shaybah 3384","","","كتاب الصلوات"
"3385","(۳۳۸۵) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : بَیْنَ کُلِّ صَلاَتَیْنِ وَقْتٌ۔","Da'if","Musannaf Ibn Abi Shaybah 3385","","","كتاب الصلوات"
"3386","(۳۳۸۶) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : مَا بَیْنَ الصَّلاَۃِ إلَی الصَّلاَۃِ وَقْتٌ۔","","Musannaf Ibn Abi Shaybah 3386","","","كتاب الصلوات"
"3387","(۳۳۸۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُنْذِرٍ ، قَالَ : سَأَلْتُ مُرَّۃَ أَبَا رَزِینٍ مَتَی تَفُوتُنِی صَلاَۃٌ ؟ فَقَالَ : لاَ تَفُوتُک صَلاَۃٌ حَتَّی یَدْخُلَ وَقْتُ الأُخْرَی ، وَلَکِنْ بَیْنَ ذَلِکَ إفْرَاطٌ وَإِضَاعَۃٌ۔","","Musannaf Ibn Abi Shaybah 3387","","","كتاب الصلوات"
"3388","(۳۳۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی الأَصْبَغِ ، قَالَ : سَمِعْتُ کَثِیرَ ابْنَ عَبَّاسٍ یَقُولُ : لاَ تَفُوتُ صَلاَۃٌ حَتَّی یُنَادَی بِالأُخْرَی۔","","Musannaf Ibn Abi Shaybah 3388","","","كتاب الصلوات"
"3389","(۳۳۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عُثْمَانَ بْنِ مَوْہَبٍ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یُسْأَل مَا التَّفْرِیطُ فِی الصَّلاَۃِ ؟ قَالَ : أَنْ تُؤَخِّرَہَا حَتَّی یَدْخُلَ وَقْتُ الَّتِی بَعْدَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 3389","","","كتاب الصلوات"
"3390","(۳۳۹۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : صَلَّیْت مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی بَیْتِ الْمَقْدِسِ ، سِتَّۃَ عَشَرَ شَہْرًا حَتَّی نَزَلَتِ الآیَۃُ الَّتِی فِی الْبَقَرَۃِ : {وَحَیْثُ مَا کُنْتُمْ فَوَلُّوا وُجُوہَکُمْ شَطْرَہُ} فَنَزَلَتْ بَعْدَ مَا صَلَّی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَانْطَلَقَ رَجُلٌ مِنَ الْقَوْمِ ، فَمَرَّ بِنَاسٍ مِنَ الأَنْصَارِ وَہُمْ یُصَلُّونَ ، فَحَدَّثَہُمْ بِالْحَدِیثِ فَوَلَّوْا وُجُوہَہُمْ قِبَلَ الْبَیْتِ۔ (مسلم ۱۱۔ ترمذی ۲۹۶۲)","Sahih","Musannaf Ibn Abi Shaybah 3390","","","كتاب الصلوات"
"3391","(۳۳۹۱) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ جَمِیلِ بْنِ عُبَیْدٍ الطَّائِیِّ ، عَنْ ثُمَامَۃَ ، عَنْ جَدِّہِ أَنَسِ بْنِ مَالِکٍ ، قَالَ : جَائَ مُنَادِی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّ الْقِبْلَۃَ قَدْ حُوِّلَتْ إلَی بَیْتِ اللہِ الْحَرَامِ ، وَقَدْ صَلَّی الإِمَامُ رَکْعَتَیْنِ ، فَاسْتَدَارُوا ، فَصَلَّوُا الرَّکْعَتَیْنِ الْبَاقِیَتَیْنِ نَحْوَ الْکَعْبَۃِ۔ (مسلم ۳۷۵)","Sahih","Musannaf Ibn Abi Shaybah 3391","","","كتاب الصلوات"
"3392","(۳۳۹۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَصْحَابُہُ إلَی بَیْتِ الْمَقْدِسِ سِتَّۃَ عَشَرَ شَہْرًا ، ثُمَّ جُعِلَتِ الْقِبْلَۃُ بَعْدُ۔ (احمد ۱/۲۵۰)","","Musannaf Ibn Abi Shaybah 3392","","","كتاب الصلوات"
"3393","(۳۳۹۳) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا قَیْسٌ ، عَنْ زِیَادِ بْنِ عِلاَقَۃَ ، عَنْ عُمَارَۃَ بْنِ أَوْسٍ ، قَالَ : کُنَّا نُصَلِّی إلَی بَیْتِ الْمَقْدِسِ إذْ أَتَانَا آتٍ وَإِمَامُنَا رَاکِعٌ ، وَنَحْنُ رُکُوعٌ ، فَقَالَ : إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَدْ أُنْزِلَ عَلَیْہِ قُرْآنٌ ، وَقَدْ أُمِرَ أَنْ یَسْتَقْبِلَ الْکَعْبَۃَ أَلاَ فَاسْتَقْبِلُوہَا ، قَالَ : فَانْحَرَفَ إمَامُنَا وَہُوَ رَاکِعٌ ، وَانْحَرَفَ الْقَوْمُ حَتَّی اسْتَقْبَلُوا الْکَعْبَۃَ ، فَصَلَّیْنَا بَعْضَ تِلْکَ الصَّلاَۃِ إلَی بَیْتِ الْمَقْدِسِ ، وَبَعْضَہَا إلَی الْکَعْبَۃِ۔n(ابو یعلی ۱۵۰۹۔ ابن سعد ۲۴۳)","Da'if","Musannaf Ibn Abi Shaybah 3393","","","كتاب الصلوات"
"3394","(۳۳۹۴) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ عَقِیلٍ ، عَنِ ابْنِ شِہَابٍ ؛ أَنَّہُ سُئِلَ عَنْ قَوْمٍ صَلَّوْا فِی یَوْمِ غَیْمٍ إلَی غَیْرِ الْقِبْلَۃِ ، ثُمَّ اسْتَبَانَتْ لَہُم الْقِبْلَۃُ وَہُمْ فِی الصَّلاَۃِ ؟ فَقَالَ : یَسْتَقْبِلُونَ الْقِبْلَۃَ ، وَیَعْتَدُّونَ مَا صَلَّوْا، وَقَدْ فَعَلَ ذَلِکَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ أُمِرُوا أَنْ یَسْتَقْبِلُوا الْکَعْبَۃَ ، وَہُمْ فِی الصَّلاَۃِ یُصَلُّونَ إلَی بَیْتِ الْمَقْدِسِ فَاسْتَقْبَلُوا الْکَعْبَۃَ ، فَصَلَّوْا بَعْضَ تِلْکَ الصَّلاَۃِ إلَی بَیْتِ الْمَقْدِسِ ، وَبَعْضَہَا إلَی الْکَعْبَۃِ۔","","Musannaf Ibn Abi Shaybah 3394","","","كتاب الصلوات"
"3395","(۳۳۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانُوا رُکُوعًا فِی صَلاَۃِ الصُّبْحِ ، فَانْحَرَفُوا وَہُمْ رُکُوعٌ۔","Sahih","Musannaf Ibn Abi Shaybah 3395","","","كتاب الصلوات"
"3396","(۳۳۹۶) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا النَّضْرُ بْنُ عَرَبِیٍّ، قَالَ: سَمِعْتُ مُجَاہِدًا یَقُولُ: {فَأَیْنَمَا تُوَلُّوا فَثَمَّ وَجْہُ اللہِ} قَالَ: قِبْلَۃُ اللہِ، فَأَیْنَمَا کُنْتُمْ مِنْ شَرْقٍ أَوْ غَرْبٍ فَاسْتَقْبِلُوہَا۔","","Musannaf Ibn Abi Shaybah 3396","","","كتاب الصلوات"
"3397","(۳۳۹۷) حَدَّثَنَا وَکِیعٌ، عَنْ سَعِیدِ بْنِ سِنَانٍ أَبُو سِنَانٍ، قَالَ: سَمِعْتُ الضَّحَّاکَ بْنَ مُزَاحِمٍ یَقُولُ: (وَلِکُلٍّ وِجْہَۃٌ ہُوَ مُوَلِّیہَا) یَقُولُ: لِکُلٍّ قِبْلَۃٌ ہُوَ مُوَلِّیہَا۔","","Musannaf Ibn Abi Shaybah 3397","","","كتاب الصلوات"
"3398","(۳۳۹۸) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا مِسْعَرٌ، عَنْ سِمَاکٍ الْحَنَفِیِّ، قَالَ: سَمِعْتُ ابْنَ عَبَّاسٍ یَقُولُ: لاَ تَجْعَلْ شَیْئًا مِنَ الْبَیْتِ خَلْفًا، وَأتَمَّ بِہِ جَمِیعًا۔","Sahih","Musannaf Ibn Abi Shaybah 3398","","","كتاب الصلوات"
"3399","(۳۳۹۹) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ دَاوُدَ، عَنْ أَبِی الْعَالِیَۃِ، قَالَ: {شَطْرَہُ} : تِلْقَائَہُ۔","","Musannaf Ibn Abi Shaybah 3399","","","كتاب الصلوات"
"3400","(۳۴۰۰) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ حُصَیْنٍ، عَنْ عَامِرٍ ؛ فِی الرَّجُلِ یُصَلِّی فِی یَوْمِ الْغَیْمِ لِغَیْرِ الْقِبْلَۃِ، قَالَ: یُجْزِئُہُ۔","","Musannaf Ibn Abi Shaybah 3400","","","كتاب الصلوات"
"3401","(۳۴۰۱) حَدَّثَنَا حَفْصٌ، عَنْ حَجَّاجٍ، قَالَ: سَأَلْتُ عَطَائً عَنِ الرَّجُلِ صَلَّی فِی یَوْمِ غَیْمٍ فَإِذَا ہُوَ قَدْ صَلَّی إلَی غَیْرِ الْقِبْلَۃِ ؟ قَالَ: یُجْزِئُہُ، قَالَ وَحَدَّثَنِی مَنْ سَأَلَ إبْرَاہِیمَ وَالشَّعْبِیَّ فَقَالاَ: یُجْزِئُہُ۔","","Musannaf Ibn Abi Shaybah 3401","","","كتاب الصلوات"
"3402","(۳۴۰۲) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنِ الْقَعْقَاعِ بْنِ یَزِیدَ، قَالَ: صَلَّیْت وَأَنَا أَعْمَی لِغَیْرِ الْقِبْلَۃِ، فَسَأَلْت إبْرَاہِیمَ ؟ فَقَالَ: یُجْزِئُکَ۔","","Musannaf Ibn Abi Shaybah 3402","","","كتاب الصلوات"
"3403","(۳۴۰۳) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، قَالَ: سَأَلْتُ عَطَائً عَنِ الرَّجُل یُصَلِّی لِغَیْرِ الْقِبْلَۃِ ؟ فَقَالَ: یُجْزِئُہُ۔","","Musannaf Ibn Abi Shaybah 3403","","","كتاب الصلوات"
"3404","(۳۴۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یُصَلِّی إِلَی غَیْرِ الْقِبْلَۃِ ، قَالَ یُجْزِئُہُ۔","","Musannaf Ibn Abi Shaybah 3404","","","كتاب الصلوات"
"3405","(۳۴۰۵) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا مِسْعَرٌ، عَنْ حَمَّادٍ، عَنْ إبْرَاہِیمَ، قَالَ: یُجْزِئُہُ۔","","Musannaf Ibn Abi Shaybah 3405","","","كتاب الصلوات"
"3406","(۳۴۰۶) حَدَّثَنَا وَکِیعٌ، حدَّثَنَا ابْنُ أَبِی عَرُوبَۃَ، عَنْ قَتَادَۃَ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، قَالَ: لاَ إعَادَۃَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 3406","","","كتاب الصلوات"
"3407","(۳۴۰۷) حَدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ، قَالَ: إذَا صَلَّی الرَّجُل فِی یَوْمِ غَیْمٍ لِغَیْرِ الْقِبْلَۃِ، ثُمَّ تَکَشَّفَ السَّحَابُ وَقَدْ صَلَّیْت بَعْضَ صَلاَتِکَ، فَاحْتَسِبْ بِمَا صَلَّیْت، ثُمَّ أَقْبِلْ بِوَجْہِکَ إلَی الْقِبْلَۃِ۔","","Musannaf Ibn Abi Shaybah 3407","","","كتاب الصلوات"
"3408","(۳۴۰۸) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ حَمَّادٍ ؛ فِی رَجُلٍ صَلَّی لِغَیْرِ الْقِبْلَۃِ، قَالَ: قَدْ مَضَتْ صَلاَتُہُ۔","","Musannaf Ibn Abi Shaybah 3408","","","كتاب الصلوات"
"3409","(۳۴۰۹) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ، عَنْ ہِشَامٍ، عَنْ مُحَمَّدٍ، قَالَ: صَلَّی حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ فِی مَنْزِلِنَا، فَقُلْتُ لَہُ: إنَّ فِی قِبْلَتِنَا تَیَاسُرًا، فَأَعَادَ۔","","Musannaf Ibn Abi Shaybah 3409","","","كتاب الصلوات"
"3410","(۳۴۱۰) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ، عَنْ زَکَرِیَّا بْنِ إِسْحَاقَ، عَنْ ہِشَامِ بْنِ حُجَیْرٍ، عَنْ طَاوُوسٍ، قَالَ: یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 3410","","","كتاب الصلوات"
"3411","(۳۴۱۱) حَدَّثَنَا مَعْنُ بْنُ عِیسَی، عَنِ ابْنِ أَبِی ذِئْبٍ، عَنِ الزُّہْرِیِّ، قَالَ: مَنْ صَلَّی إلَی غَیْرِ الْقِبْلَۃِ فَاسْتَفَاقَ وَہُوَ فِی وَقْتٍ، فَعَلَیْہِ الإِعَادَۃُ، وَإِنْ لَمْ یَکُنْ فِی وَقْتٍ فَلَیْسَ عَلَیْہِ إِعَادَۃٌ۔","","Musannaf Ibn Abi Shaybah 3411","","","كتاب الصلوات"
"3412","(۳۴۱۲) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا رَبِیعٌ، عَنِ الْحَسَنِ، قَالَ: یُعِیدُ مَا دَامَ فِی وَقْتٍ۔","","Musannaf Ibn Abi Shaybah 3412","","","كتاب الصلوات"
"3413","(۳۴۱۳) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، عَنْ مَرْثَدٍ، عَنْ أَبِی ظَبْیَانَ ؛ أَنَّہُ کَرِہَ أَنْ یَقُولوا: قَدْ حَانَتِ الصَّلاَۃُ۔","","Musannaf Ibn Abi Shaybah 3413","","","كتاب الصلوات"
"3414","(۳۴۱۴) حَدَّثَنَا ہُشَیْمٌ، قَالَ: أَخْبَرَنَا مُغِیرَۃُ، عَنْ أَبِی مَعْشَرٍ، عَنْ إبْرَاہِیمَ، قَالَ: کَانُوا یَکْرَہُونَ أَنْ یَقُولُوا: قَدْ حَانَتِ الصَّلاَۃُ، فَقَالَ: إنَّ الصَّلاَۃَ لاَ تَحِینُ، وَلْیَقُولُوا: قَدْ حَضَرَتِ الصَّلاَۃُ۔","","Musannaf Ibn Abi Shaybah 3414","","","كتاب الصلوات"
"3415","(۳۴۱۵) حَدَّثَنَا الْمُطَّلِبُ بْنُ زِیَادٍ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی، عَنِ ابْنِ أَبِی لَیْلَی ؛ أَنَّہُ کَانَ یَنْتَظِرُ مَا سَمِعَ وَقْعَ نَعْلٍ۔","","Musannaf Ibn Abi Shaybah 3415","","","كتاب الصلوات"
"3416","(۳۴۱۶) حَدَّثَنَا وَکِیعٌ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ، عَنِ الشَّعْبِیِّ، قَالَ: إذَا کُنْتَ إمَامًا فَدَخَلَ إنْسَانٌ وَأَنْتَ رَاکِعٌ فَانْتَظِرْہُ۔","","Musannaf Ibn Abi Shaybah 3416","","","كتاب الصلوات"
"3417","(۳۴۱۷) حَدَّثَنَا وَکِیعٌ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ، عَنْ أَبِی مِجْلَزٍ، قَالَ: إذَا جَائَ أَحَدُکُمْ وَالإِمَامُ رَاکِعٌ، فَلْیُسْرِع الْمَشْیَ فَإِنَّا نَنْتَظِرُہُ۔","","Musannaf Ibn Abi Shaybah 3417","","","كتاب الصلوات"
"3418","(۳۴۱۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ، عَنْ عِمْرَانَ، عَنْ أَبِی مِجْلَزٍ ؛ أَنَّہُ کَانَ یَنْتَظِرُ مَا سَمِعَ وَقْعَ النِّعَالِ۔","","Musannaf Ibn Abi Shaybah 3418","","","كتاب الصلوات"
"3419","(۳۴۱۹) حَدَّثَنَا عَفَّانُ، قَالَ: حدَّثَنَا ہَمَّامٌ، عَنْ مُحَمَّدِ بْنِ جُحَادَۃَ، عَنْ رَجُلٍ، عَنِ ابْنِ أَبِی أَوْفَی ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَنْتَظِرُ مَا سَمِعَ وَقْعَ نَعْلٍ۔","Majhul","Musannaf Ibn Abi Shaybah 3419","","","كتاب الصلوات"
"3420","(۳۴۲۰) حَدَّثَنَا شَرِیکٌ، عَنْ جَابِرٍ، عَنْ عَامِرٍ ؛ أَنَّہُ کَانَ یَنْتَظِرُ مَا سَمِعَ وَقْعَ نَعْلٍ۔","","Musannaf Ibn Abi Shaybah 3420","","","كتاب الصلوات"
"3421","(۳۴۲۱) حَدَّثَنَا ہُشَیْمٌ، قَالَ: أَخْبَرَنَا حُمَیْدٌ، عَنْ أَنَسٍ، قَالَ: دَخَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ یَوْمٍ، فَإِذَا حَبْلٌ مَمْدُودٌ، فَقَالَ: مَا ہَذَا ؟ قِیلَ: فُلاَنَۃٌ تُصَلِّی یَا رَسُولَ اللہِ، فَإِذَا أَعْیَتْ اسْتَرَاحَتْ عَلَی ہَذَا الْحَبْلِ، قَالَ: فَلْتُصَلِّ مَا نَشِطَتْ، فَإِذَا أَعْیَتْ فَلْتَنَمْ۔ (احمد ۱۸۴۔ ابو یعلی ۳۷۸۶)","Sahih","Musannaf Ibn Abi Shaybah 3421","","","كتاب الصلوات"
"3422","(۳۴۲۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ أَبِی حَازِمٍ، عَنْ مَوْلاَتِہِ، قَالَتْ: کُنْتُ فِی أَصْحَابِ الصُّفَّۃِ، کَانَ لَنَا حِبَالٌ نَتَعَلَّقُ بِہَا إذَا فَتَرْنَا وَنَعَسْنَا فِی الصَّلاَۃِ، وَبُسُطٌ نَقُومُ عَلَیْہِمَا مِنْ غِلَظِ الأَرْضِ، قَالَتْ: فَأَتَی أَبُو بَکْرٍ، فَقَالَ: اقْطَعُوا ہَذِہِ الْحِبَالَ وَأَفْضُوا إلَی الأَرْضِ۔","Majhul","Musannaf Ibn Abi Shaybah 3422","","","كتاب الصلوات"
"3423","(۳۴۲۳) حَدَّثَنَا وَکِیعٌ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ، عَنْ رَجُلٍ قَدْ سَمَّاہُ، یَحْسِبُہُ أَبُو بَکْرٍ: عَمْرَو بْنَ مُرَّۃَ، عَنْ حُذَیْفَۃَ، قَالَ: إنَّمَا یَفْعَلُ ذَلِکَ الْیَہُودُ، یَعْنِی بِالتَّعَلُّقِ مِنْ أَسْفَلَ ہَکَذَا۔","Majhul","Musannaf Ibn Abi Shaybah 3423","","","كتاب الصلوات"
"3424","(۳۴۲۴) حَدَّثَنَا وَکِیعٌ، عَنْ عِکْرِمَۃَ بن عمار، عَنْ عَاصِمِ بْنِ شُمَیْخٍ، قَالَ: رَأَیْتُ أَبَا سَعِیدٍ الْخُدْرِیَّ یُصَلِّی مُتَوَکِّئًا عَلَی عَصًا۔","Majhul","Musannaf Ibn Abi Shaybah 3424","","","كتاب الصلوات"
"3425","(۳۴۲۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنِ ابْنِ أَبِی نَجِیحٍ، عَنْ أَبِیہِ، قَالَ: أَخْبَرَنِی مَنْ رَأَی أَبَا ذَرٍّ یُصَلِّی مُتَوَکِّئًا عَلَی عَصًا۔","Majhul","Musannaf Ibn Abi Shaybah 3425","","","كتاب الصلوات"
"3426","(۳۴۲۶) حَدَّثَنَا حَفْصٌ، وَیَزِیدُ، عَنْ حَجَّاجٍ، عَنْ عَطَائٍ، قَالَ: کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَوَکَّؤونَ عَلَی الْعصا فِی الصَّلاَۃِ ۔ زَادَ یَزِیدُ: إذَا اسْتَوَوْا۔","","Musannaf Ibn Abi Shaybah 3426","","","كتاب الصلوات"
"3427","(۳۴۲۷) حَدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ، قَالَ: کَانَ عَمْرُو بْنُ مَیْمُونٍ أُوتِدَ لَہُ وَتَدٌ فِی حَائِطِ الْمَسْجِدِ، وَکَانَ إذَا سَئِمَ مِنَ الْقِیَامِ فِی الصَّلاَۃِ، أَوْ شَقَّ عَلَیْہِ أَمْسَکَ بِالْوَتَدِ یَعْتَمِدُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 3427","","","كتاب الصلوات"
"3428","(۳۴۲۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ، قَالَ: رَأَیْتُ مُرَّۃً، وَکَانَ یَؤُمُّ قَوْمَہُ، وَرَأَیْت لَہُ عُودًا فِی الطَّاقِ یَتَوَکَّأُ عَلَیْہِ إذَا نَہَضَ۔","","Musannaf Ibn Abi Shaybah 3428","","","كتاب الصلوات"
"3429","(۳۴۲۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عِرَاکِ بْنِ مَالِکٍ، عَنْ أَبِیہِ، قَالَ: أَدْرَکْت النَّاسَ فِی شَہْرِ رَمَضَانَ تُرْبَطُ لَہُمَ الْحِبَالُ یَتَمَسَّکُونَ بِہَا مِنْ طُولِ الْقِیَامِ۔","","Musannaf Ibn Abi Shaybah 3429","","","كتاب الصلوات"
"3430","(۳۴۳۰) حَدَّثَنَا وَکِیعٌ، عَنْ أَبَانَ بن عَبْدِ اللہِ الْبَجَلِیِّ، قَالَ: رَأَیْتُ أَبَا بَکْرِ بْنَ أَبِی مُوسَی یُصَلِّی مُتَوَکِّئًا عَلَی عَصًا۔","","Musannaf Ibn Abi Shaybah 3430","","","كتاب الصلوات"
"3431","(۳۴۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ، وَأَبُو مُعَاوِیَۃَ، عَنْ لَیْثٍ، عَنْ عَبْدِ اللہِ بْنِ الْحَسَنِ، عَنْ أُمِّہِ، عَنْ فَاطِمَۃَ ابْنَۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَتْ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا دَخَلَ الْمَسْجِدَ یَقُولُ: بِسْمِ اللہِ، وَالسَّلاَمُ عَلَی رَسُولِ اللہِ، صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، اللَّہُمَّ اغْفِرْ لِی ذُنُوبِی وَافْتَحْ لِی أَبْوَابَ رَحْمَتِکَ، وَإِذَا خَرَجَ، قَالَ: بِسْمِ اللہِ، وَالسَّلاَمُ عَلَی رَسُولِ اللہِ، صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، اللَّہُمَّ اغْفِرْ لِی ذُنُوبِی، وَافْتَحْ لِی أَبْوَابَ فَضْلِک۔ (ترمذی ۳۱۴۔ احمد ۶/۲۸۳)","Da'if","Musannaf Ibn Abi Shaybah 3431","","","كتاب الصلوات"
"3432","(۳۴۳۲) حَدَّثَنَا وَکِیعٌ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ، عَنْ عَمْرِو بْنِ أَبِی عَمْرٍو الْمَدِینِیِّ، عَنِ الْمُطَّلِبِ بْنِ عَبْدِ اللہِ بْنِ حَنْطَبٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا دَخَلَ الْمَسْجِدَ، قَالَ: اللَّہُمَّ افْتَحْ لِی أَبْوَابَ رَحْمَتِکَ، وَیَسِّرْ لِی أَبْوَابَ رِزْقِک۔","","Musannaf Ibn Abi Shaybah 3432","","","كتاب الصلوات"
"3433","(۳۴۳۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ، عَنِ النُّعْمَانِ بْنِ سَعْدٍ، عَنْ عَلِیٍّ، قَالَ: إذَا دَخَلَ الْمَسْجِدَ، قَالَ: اللَّہُمَّ اغْفِرْ لِی ذُنُوبِی وَافْتَحْ لِی أَبْوَابَ رَحْمَتِکَ، وَإِذَا خَرَجَ، قَالَ: اللَّہُمَّ اغْفِرْ لِی ذُنُوبِی، وَافْتَحْ لِی أَبْوَابَ فَضْلِک۔","Majhul","Musannaf Ibn Abi Shaybah 3433","","","كتاب الصلوات"
"3434","(۳۴۳۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ، عَنِ ابْنِ عَجْلاَنَ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: قَالَ لِی کَعْبُ بْنُ عُجْرَۃَ: إذَا دَخَلْتَ الْمَسْجِدَ فَسَلِّمْ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقُلَ: اللَّہُمَّ افْتَحْ لِی أَبْوَابَ رَحْمَتِکَ، وَإِذَا خَرَجْتَ فَسَلِّمْ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقُلِ: اللَّہُمَّ احْفَظْنِی مِنَ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 3434","","","كتاب الصلوات"
"3435","(۳۴۳۵) حَدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ؛ أَنَّ عَبْدَ اللہِ بْنَ سَلاَمٍ کَانَ إذَا دَخَلَ الْمَسْجِدَ سَلَّمَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، وَقَالَ: اللَّہُمَّ افْتَحْ لِی أَبْوَابَ رَحْمَتِکَ، وَإِذَا خَرَجَ سَلَّمَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَتَعَوَّذَ مِنَ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 3435","","","كتاب الصلوات"
"3436","(۳۴۳۶) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ أَبِی إِسْحَاقَ، عَنْ سَعِیدِ بْنِ ذِی حُدَّانَ، عَنْ عَلْقَمَۃَ ؛ أَنَّہُ کَانَ إذَا دَخَلَ الْمَسْجِدَ، قَالَ: السَّلاَمُ عَلَیْک أَیُّہَا النَّبِیُّ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ، صَلَّی اللَّہُ وَمَلاَئِکَتُہُ عَلَی مُحَمَّدٍ۔","","Musannaf Ibn Abi Shaybah 3436","","","كتاب الصلوات"
"3437","(۳۴۳۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ قَالَ: کَانَ إذَا دَخَلَ الْمَسْجِدَ، قَالَ: بِسْمِ اللہِ وَالسَّلاَم عَلَی رَسُولِ اللہِ، وَإِذَا دَخَلَ بَیْتًا لَیْسَ فِیہِ أَحَدٌ، قَالَ: السَّلاَمُ عَلَیْکُمْ۔","","Musannaf Ibn Abi Shaybah 3437","","","كتاب الصلوات"
"3438","(۳۴۳۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ، عَنِ ابْنِ عَجْلاَنَ، عَنْ عَامِرِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ، عَنْ عَمْرِو بْنِ سُلَیْمٍ، عَنْ أَبِی قَتَادَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ: إذَا دَخَلْتَ الْمَسْجِدَ فَصَلِّ رَکْعَتَیْنِ قَبْلَ أَنْ تَجْلِسَ۔n(بخاری ۴۴۴۔ مسلم ۴۹۵)","Hasan","Musannaf Ibn Abi Shaybah 3438","","","كتاب الصلوات"
"3439","(۳۴۳۹) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ حُصَیْنٍ، عَنْ عَبْدِ الأَعْلَی بْنِ الْحَکَمِ، عَنْ خَارِجَۃَ بْنِ الصَّلْتِ الْبُرْجُمِیِّ، عَنْ عَبْدِ اللہِ، قَالَ: کَانَ یقال: مِنِ اقْتِرَابِ، أَوْ مِنْ أَشْرَاطِ، السَّاعَۃِ أَنْ تُتَّخَذَ الْمَسَاجِدُ طُرُقًا۔","Majhul","Musannaf Ibn Abi Shaybah 3439","","","كتاب الصلوات"
"3440","(۳۴۴۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو، عَنْ أَبِی عَمْرِو بْنِ حَمَاسٍ، عَنْ مَالِکِ بْنِ أَوْسِ بْنِ الْحَدَثَانِ النَّضْرِیِّ، عَنْ أَبِی ذَرٍّ ؛ أَنَّہُ دَخَلَ الْمَسْجِدَ فَأَتَی سَارِیَۃً فَصَلَّی عِنْدَہَا رَکْعَتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 3440","","","كتاب الصلوات"
"3441","(۳۴۴۱) حَدَّثَنَا أَبُو خَالِدٍ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ حَزْمٍ، عَنْ عَمْرِو بْنِ سُلَیْمٍ، عَنْ أَبِی قَتَادَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ: أَعْطُوا الْمَسَاجِدَ حَقَّہَا قِیلَ: وَمَا حَقُّہَا ؟ قَالَ: رَکْعَتَانِ قَبْلَ أَنْ تَجْلِسَ۔","","Musannaf Ibn Abi Shaybah 3441","","","كتاب الصلوات"
"3442","(۳۴۴۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنِ الْمَسْعُودِیِّ، عَنْ أَبِی عُمَر، عَنْ عُبَیْدِ بْنِ الْخَشْخَاشِ، عَنْ أَبِی ذَرٍّ، قَالَ: دَخَلْتُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ فِی الْمَسْجِدِ، فَقَالَ لِی: یَا أَبَا ذَرٍّ، صَلَّیْتَ ؟ قُلْتُ: لاَ، قَالَ: فَقُمْ فَصَلِّ رَکْعَتَیْنِ۔ (احمد ۱۷۹۔ طیالسی ۴۷۸)","Da'if","Musannaf Ibn Abi Shaybah 3442","","","كتاب الصلوات"
"3443","(۳۴۴۳) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ، عَنِ الْمَقْبُرِیِّ، عَنْ عُمَرَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ، عَنْ أَبِیہِ، عَنْ عَمَّارِ بْنِ یَاسِرٍ ؛ أَنَّہُ دَخَلَ الْمَسْجِدَ فَصَلَّی رَکْعَتَیْنِ خَفِیفَتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 3443","","","كتاب الصلوات"
"3444","(۳۴۴۴) حَدَّثَنَا عَبَّادٌ، عن عَبْدِ الْمَلِکِ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَدْخُلُ الْمَسْجِدَ یُصَلِّی فِیہِ کُلَّمَا مَرَّ ؟ قَالَ: یُصَلِّی رَکْعَتَیْنِ، ثُم یَمُرُّ فِیہِ سَائِرَ یَوْمِہِ۔","","Musannaf Ibn Abi Shaybah 3444","","","كتاب الصلوات"
"3445","(۳۴۴۵) حَدَّثَنَا حَرَمِیُّ بْنُ عُمَارَۃَ، عَنْ أَبِی خَلْدَۃَ، قَالَ: رَأَیْتُ عِکْرِمَۃَ دَخَلَ الْمَسْجِدَ فَصَلَّی فِیہِ رَکْعَتَیْنِ، وَقَالَ: ہَذَا حَقُّ الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 3445","","","كتاب الصلوات"
"3446","(۳۴۴۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ، قَالَ: حدَّثَنَا مِسْعَرٌ، عَنْ مُحَارِبِ بْنِ دِثَارٍ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ، قَالَ: أَتَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ فِی الْمَسْجِدِ، فَقَالَ: صَلِّ رَکْعَتَیْنِ۔ (بخاری ۴۴۳۔ مسلم ۴۹۵)","Sahih","Musannaf Ibn Abi Shaybah 3446","","","كتاب الصلوات"
"3447","(۳۴۴۷) حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِیُّ، عَنْ زَیْدِ بْنِ أَسْلَمَ، قَالَ: کَانَ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدْخُلُونَ الْمَسْجِدَ، ثُمَّ یَخْرُجُونَ وَلاَ یُصَلُّونَ، قَالَ: وَرَأَیْت ابْنَ عُمَرَ یَفْعَلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 3447","","","كتاب الصلوات"
"3448","(۳۴۴۸) حَدَّثَنَا وَکِیعٌ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدِ بْنِ أَبِی ہِنْدٍ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ کَانَ یَمُرُّ فِی الْمَسْجِدِ، وَلاَ یُصَلِّی فِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 3448","","","كتاب الصلوات"
"3449",") حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ، عَنِ ابْنِ عَوْنٍ، قَالَ: مَرَرْتُ مَعَ الشَّعْبِیِّ فِی مَسْجِدِ الْکُوفَۃِ، فَقُلْتُ لَہُ: أَلاَ تُصَلِّی ؟ قَالَ: إذنْ وَرَبِّی لاَ نَزَالُ نُصَلِّی۔","","Musannaf Ibn Abi Shaybah 3449","","","كتاب الصلوات"
"3450","(۳۴۵۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنْ حَنَشٍ، قَالَ: رَأَیْتُ سُوَیْد بْنَ غَفَلَۃَ یَمُرُّ فِی مَسْجِدِنَا، فَرُبَّمَا صَلَّی، وَرُبَّمَا لَمْ یُصَلِّ۔","","Musannaf Ibn Abi Shaybah 3450","","","كتاب الصلوات"
"3451","(۳۴۵۱) حَدَّثَنَا مَعْنُ بْنُ عِیسَی، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ، قَالَ: رَأَیْتُ سَالِمًا یَدْخُلُ مِنَ الْمَسْجِدِ حَتَّی یَخْرُجَ مِنَ الْخَوْخَۃِ، فَلاَ یُصَلِّی فِیہِ۔","","Musannaf Ibn Abi Shaybah 3451","","","كتاب الصلوات"
"3452","(۳۴۵۲) حَدَّثَنَا ہُشَیْمٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ لَیْثٍ، عَنْ مُجَاہِدٍ (ح) وَأَبُو إِسْحَاقَ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُمْ کَرِہُوا الضَّجَّۃَ فِی الصَّلاَۃِ إذَا ذَکَرَ الإِمَامُ آیَۃَ رَحْمَۃٍ، أَوْ آیَۃَ عَذَابٍ، أَوْ ذَکَرَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 3452","","","كتاب الصلوات"
"3453","(۳۴۵۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو، قَالَ: خَیْرُ الْمَسْجِدِ الْمَقَامُ، ثُمَّ مَیَامِنُ الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 3453","","","كتاب الصلوات"
"3454","(۳۴۵۴) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ حَمَّادٍ، عَنْ إبْرَاہِیمَ، قَالَ: یُسْتَحَبُّ یَمِینُ الإِمَامِ۔","","Musannaf Ibn Abi Shaybah 3454","","","كتاب الصلوات"
"3455","(۳۴۵۵) حَدَّثَنَا عَبْدَۃُ، عَنْ سَعِیدٍ، عَنْ أَبِی مَعْشَرٍ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یُعْجِبُہُ أَنْ یَقُومَ عَنْ یَمِینِ الإِمَامِ۔","","Musannaf Ibn Abi Shaybah 3455","","","كتاب الصلوات"
"3456","(۳۴۵۶) حَدَّثَنَا مَعْنُ بْنُ عِیسَی، عَنْ سَلَمَۃَ بْنِ أَبِی یَحْیَی، قَالَ: رَأَیْتُ سَعِیدَ بْنَ الْمُسَیَّبِ یُصَلِّی فِی الشِّقِّ الأَیْمَنِ مِنَ الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 3456","","","كتاب الصلوات"
"3457","(۳۴۵۷) حَدَّثَنَا مَعْنُ بْنُ عِیسَی، عَنْ سَلَمَۃَ بْنِ أَبِی یَحْیَی، قَالَ: رَأَیْتُ أنس بن مالک یُصَلِّی فِی الشِّقِّ الأَیْسَر مِنَ الْمَسْجِدِ۔","Majhul","Musannaf Ibn Abi Shaybah 3457","","","كتاب الصلوات"
"3458","(۳۴۵۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَنْ سُفْیَانَ، عَنْ عِمْرَانَ الْمُنْقِرِیِّ، عَنِ الْحَسَنِ، وَابْنِ سِیرِینَ ؛ أَنَّہُمَا کَانَا یُصَلِّیَانِ عَنْ یَسَارِ الإِمَامِ۔","","Musannaf Ibn Abi Shaybah 3458","","","كتاب الصلوات"
"3459","(۳۴۵۹) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ، عَنِ ابْنِ الْبَرَائِ، عَنْ أَبِیہِ، قَالَ: کُنَّا نُحِبُّ أَو نَسْتَحِبُّ أَنْ نَقُومَ عَنْ یَمِینِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (احمد ۳۰۴۔ مسلم ۶۲)","Sahih","Musannaf Ibn Abi Shaybah 3459","","","كتاب الصلوات"
"3460","(۳۴۶۰) حَدَّثَنَا الْمُحَارِبِیُّ، عَنْ حَجَّاجِ بْنِ دِینَارٍ، عَنْ أَبِی جَعْفَرٍ، قَالَ: مَیَامِنُ الصُّفُوفِ تَزِیدُ عَلَی سَائِرِ المسجد، خَمْسًا وَعِشْرِینَ دَرَجَۃً۔","","Musannaf Ibn Abi Shaybah 3460","","","كتاب الصلوات"
"3461","(۳۴۶۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ، عَنِ الزُّہْرِیِّ، عَنْ سَالِمٍ، عَنْ أَبِیہِ، رَفَعَہُ، قَالَ: إنَّ الَّذِی تَفُوتُہُ الْعَصْرُ، کَأَنَّمَا وُتِرَ أَہْلَہُ وَمَالَہُ۔ (مسلم ۴۳۶۔ احمد ۲/۱۳۴)","Sahih","Musannaf Ibn Abi Shaybah 3461","","","كتاب الصلوات"
"3462","(۳۴۶۲) حَدَّثَنَا ہُشَیْمٌ، عَنْ حَجَّاجٍ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ تَرَکَ الْعَصْرَ حَتَّی تَغِیبَ الشَّمْسُ مِنْ غَیْرِ عُذْرٍ، فَکَأَنَّمَا وُتِرَ أَہْلَہُ وَمَالَہُ۔ (بخاری ۵۵۲۔ مسلم ۵/۴۳۹)","","Musannaf Ibn Abi Shaybah 3462","","","كتاب الصلوات"
"3463","(۳۴۶۳) حَدَّثَنَا شَبَابَۃُ، قَالَ: حدَّثَنَا لَیْثُ بْنُ سَعْدٍ، عَنْ یَزِیدَ بْنِ أبی حَبِیبٍ، عَنْ عِرَاکٍ، عَنْ نَوْفَلِ بْنِ مُعَاوِیَۃَ بْنِ عُرْوَۃَ، قَالَ: سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: إِنَّ من الصلوات صلاۃ من فاتتہ، فَکَأَنَّمَا وُتِرَ أَہْلَہُ وَمَالَہُ ۔ قَالَ ابن عمر: سَمِعْتُ النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یقول: ہِیَ صَلاَۃُ الْعَصْرِ۔n(بخاری ۳۶۰۲۔ احمد ۴۲۲)","Sahih","Musannaf Ibn Abi Shaybah 3463","","","كتاب الصلوات"
"3464","(۳۴۶۴) حَدَّثَنَا ہُشَیْمٌ، قَالَ: أَخْبَرَنَا عَبَّادُ بْنُ مَیْسَرَۃَ الْمُنْقِرِیُّ، عَنْ أَبِی قِلاَبَۃَ، وَالْحَسَنِ ؛أَنَّہُمَا کَانَا جَالِسَیْنِ، فَقَالَ أَبُو قِلاَبَۃَ: قَالَ أَبُو الدَّرْدَائِ: مَنْ تَرَکَ الْعَصْرَ حَتَّی تَفُوتَہُ مِنْ غَیْرِ عُذْرٍ، فَقَدْ حَبِطَ عَمَلُہُ، قَالَ: وَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ تَرَکَ صَلاَۃً مَکْتُوبَۃً حَتَّی تَفُوتَہُ مِنْ غَیْرِ عُذْرٍ، فَقَدْ حَبِطَ عَمَلُہُ۔n(احمد ۶/۴۴۲)","Hasan","Musannaf Ibn Abi Shaybah 3464","","","كتاب الصلوات"
"3465","(۳۴۶۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ أَبِی جَعْفَرٍ، قَالَ: مَنْ فَاتَتْہُ الْعَصْرُ، فَکَأَنَّمَا وُتِرَ أَہْلَہُ۔","","Musannaf Ibn Abi Shaybah 3465","","","كتاب الصلوات"
"3466","(۳۴۶۶) حَدَّثَنَا أَبُو أُسَامَۃَ، قَالَ: حدَّثَنَا الأَعْمَشُ، عَنْ مَالِکِ بْنِ الْحَارِثِ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: کَانَ سُلَیْمَانُ بْنُ دَاوُد النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یُکَلَّمُ إعْظَامًا لَہُ، فَلَقَدْ فَاتَتْہُ الْعَصْرُ، وَمَا اسْتَطَاعَ أَحَدٌ أَنْ یُکَلِّمَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 3466","","","كتاب الصلوات"
"3467","(۳۴۶۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ: حَدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ، عَنْ أَوْسِ بْنِ ضَمْعَجٍ، قَالَ: أُخْبِرْتُ أَنَّہُ مَنْ أَخْطَأَتْہُ الْعَصْرُ، فَکَأَنَّمَا وُتِرَ أَہْلَہُ وَمَالَہُ۔","","Musannaf Ibn Abi Shaybah 3467","","","كتاب الصلوات"
"3468","(۳۴۶۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ، وَوَکِیعٌ، عَنِ الأَوْزَاعِیِّ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ، عَنْ أَبِی قِلاَبَۃَ، عَنْ أَبِی الْمُہَاجِرِ، عَنْ بُرَیْدَۃَ الأَسْلَمِیِّ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ فَاتَتْہُ صَلاَۃُ الْعَصْرِ حَبِطَ عَمَلُہُ۔ (ابن ماجہ ۶۹۴۔ احمد ۵/۳۶۱)","","Musannaf Ibn Abi Shaybah 3468","","","كتاب الصلوات"
"3469","(۳۴۶۹) حَدَّثَنَا یَزِیدُ، عن ہِشَامٍ، عَنْ یَحْیَی، عَنْ أَبِی قِلاَبَۃَ، عَنْ أَبِی الْمَلِیحِ، عَنْ بُرَیْدَۃَ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ مِثْلَ حَدِیثِ عِیسَی وَوَکِیعٍ۔ (بخاری ۵۹۴۔ احمد ۵/۳۵۷)","Sahih","Musannaf Ibn Abi Shaybah 3469","","","كتاب الصلوات"
"3470","(۳۴۷۰) حَدَّثَنَا أَبُو خَالِدٍ، عَنِ الأَعْمَشِ، عَنْ إسْمَاعِیلَ بْنِ رَجَائٍ، عَنْ أَوْسِ بْنِ ضَمْعَجٍ، عَنْ أَبِی مَسْعُودٍ الأَنْصَارِیِّ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: یَؤُمُّ الْقَوْمَ أَقْرَؤُہُمْ لِکِتَابِ اللہِ، فَإِنْ کَانُوا فِی الْقِرَائَۃِ سَوَائً فَأَعْلمُہمْ بِالسُّنَّۃِ، فَإِنْ کَانُوا فِی السُّنَّۃِ سَوَائً، فَأَقْدَمُہُمْ ہِجْرَۃً، فَإِنْ کَانُوا فِی الْہِجْرَۃِ سَوَائً، فَأَقْدَمُہُمْ سِلْمًا، وَلاَ یَؤُمَّنَّ الرَّجُلُ الرَّجُلَ فِی سُلْطَانِہِ، وَلاَ یَقْعُدْ فِی بَیْتِہِ عَلَی تَکْرِمَتِہِ إِلاَّ بِإِذْنِہِ۔n(مسلم ۶۹۰۔ ابوداؤد ۳/۵۸۳)","Hasan","Musannaf Ibn Abi Shaybah 3470","","","كتاب الصلوات"
"3471","(۳۴۷۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ، عَنِ ابْنِ أَبِی عَرُوبَۃَ، عَنْ قَتَادَۃَ، عَنْ أَبِی نَضْرَۃَ، عَنْ أَبِی سَعِیدٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إذَا کَانُوا ثَلاَثَۃً فَلْیَؤُمَّہُمْ أَحَدُہُمْ، وَأَحَقُّہُمْ بِالإِمَامَۃِ أَقْرَؤُہُمْ۔n(مسلم ۴۶۴۔ احمد ۳۶)","Hasan","Musannaf Ibn Abi Shaybah 3471","","","كتاب الصلوات"
"3472","(۳۴۷۲) حَدَّثَنَا أَبُو خَالِدٍ، عَنْ مُجَالِدٍ، عَنِ الشَّعْبِیِّ، وَزَیْدِ بْنِ إیَاسٍ قَالاَ: حدَّثَنَا مُرَّۃُ بْنُ شَرَاحِیلَ، قَالَ: کُنْتُ فِی بَیْتٍ فِیہِ عَبْدُ اللہِ بْنُ مَسْعُودٍ، وَحُذَیْفَۃُ، وَأَبُو مُوسَی الأَشْعَرِیُّ، فَحَضَرَتِ الصَّلاَۃُ، فَقَالَ ہَذَا لِہَذَا: تَقَدَّمْ، وَقَالَ ہَذَا لِہَذَا: تَقَدَّمْ، وعبد اللہ بین أبی مُوسَی وَحُذَیْفَۃ، فَأَخَذَا بِنَاحِیَتَیْہِ فَقَدَّمَاہُ، قُلْتُ: مِمَّ ذَلِکَ ؟ قَالَ: إِنَّہُ شَہِدَ بَدْرًا۔","Da'if","Musannaf Ibn Abi Shaybah 3472","","","كتاب الصلوات"
"3473","(۳۴۷۳) حَدَّثَنَا حَفْصٌ، عَنِ ابْنِ جُرَیْجٍ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، قَالَ: کَانَ سَالِمٌ یَؤُمُّ الْمُہَاجِرِینَ وَالأَنْصَارَ فِی مَسْجِدِ قُبَائَ۔","","Musannaf Ibn Abi Shaybah 3473","","","كتاب الصلوات"
"3474","(۳۴۷۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، قَالَ: حَدَّثَنَا عَاصِمٌ، عَنْ عَمْرِو بْنِ سَلِمَۃَ، قَالَ: لَما رَجَعَ قَوْمِی مِنْ عِنْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالُوا لَہُ: إِنَّہُ قَالَ لَنَا: لِیَؤُمَّکُمْ أَکْثَرُکُمْ قِرَائَۃً لِلْقُرْآنِ، قَالَ: فَدَعَوْنِی فَعَلَّمُونِی الرکوع وَالسُّجُودَ، فَکُنْت أُصَلِّی بِہِمْ وَعَلَیَّ بُرْدَۃٌ مَفْتُوقَۃٌ، قَالَ: فَکَانُوا یَقُولُونَ لأَبِی: أَلاَ تُغَطِّی عَنَّا اسْتِ ابْنِک۔ (ابوداؤد ۵۸۷۔ احمد ۵/۷۱)","Sahih","Musannaf Ibn Abi Shaybah 3474","","","كتاب الصلوات"
"3475","(۳۴۷۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، عَنْ عَمْرِو بْنِ سَلِمَۃَ، قَالَ: کُنَّا عَلَی حَاضِرٍ، فَکَانَ الرُّکْبَانُ یَمُرُّونَ بِنَا رَاجِعِینَ مِنْ عِنْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، فَأَدْنُو مِنْہُمْ فَأَسْتَمِعُ حَتَّی حَفِظْتُ قُرْآنًا کَثِیرًا، وَکَانَ النَّاسُ یَنْتَظِرُونَ بِإِسْلاَمِہِمْ فَتْحَ مَکَّۃَ، فَلَمَّا فُتِحَتْ جَعَلَ الرَّجُلُ یَأْتِیہِ فَیَقُولُ: یَا رَسُولَ اللہِ، أَنَا وَافِدُ بَنِی فُلاَنٍ، وَجِئْتُک بِإِسْلاَمِہِمْ، فَانْطَلَقَ أَبِی بِإِسْلاَمِ قَوْمِہِ، فَلَمَّا رَجَعَ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: قَدِّمُوا أَکْثَرَکُمْ قُرْآنًا، فَنَظَرُوا وَأَنَا عَلَی حِوَائٍ عَظِیمٍ، فَمَا وَجَدُوا فِیہِمْ أَحَدًا أَکْثَرَ قُرْآنًا مِنِّی، فَقَدَّمُونِی وَأَنَا غُلاَمٌ، فَصَلَّیْتُ بِہِمْ۔ (بخاری ۴۳۰۲۔ ابوداؤ۹ ۵۸۶)","Sahih","Musannaf Ibn Abi Shaybah 3475","","","كتاب الصلوات"
"3476","(۳۴۷۶) حَدَّثَنَا وَکِیعٌ، عَنْ ثَوْرٍ الشَّامِیِّ، عَنْ مُہَاصِرِ بْنِ حَبِیبٍ، عَنْ أَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إذَا خَرَجَ ثَلاَثَۃٌ مُسْلِمِینَ فِی سَفَرٍ فَلْیَؤُمَّہُمْ أَقْرَؤُہُمْ لِکِتَابِ اللہِ، وَإِنْ کَانَ أَصْغَرَہُمْ ، فَإِذَا أَمَّہُمْ فَہُوَ أَمِیرُہُمْ ، وَذَلِکَ أَمِیرٌ أَمَّرَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔n(عبدالرزاق ۹۲۵۶)","","Musannaf Ibn Abi Shaybah 3476","","","كتاب الصلوات"
"3477","(۳۴۷۷) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرِ بْنِ حَبِیبٍ الْجَرْمِیِّ، عَنْ عَمْرِو بْنِ سَلِمَۃَ، عَنْ أَبِیہِ ؛ أَنَّہُمْ وَفَدُوا إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، فَلَمَّا أَرَادُوا أَنْ یَنْصَرِفُوا قَالُوا: قلْنَا لَہُ: یَا رَسُولَ اللہِ، مَنْ یُصَلِّی بِنَا ؟ قَالَ: أَکْثَرُکُمْ جَمْعًا لِلْقُرْآنِ، أَوْ أَخْذًا لِلْقُرْآنِ، فَلَمْ یَکُنْ فِیہِمْ أَحَدٌ جَمَعَ مِنَ الْقُرْآنِ مَا جَمَعْتُ، قَالَ: فَقَدَّمُونِی وَأَنَا غُلاَمٌ، فَکُنْت أُصَلِّی بِہِمْ وَعَلَیَّ شَمْلَۃٌ، قَالَ: فَمَا شَہِدْتُ مَجْمَعًا مِنْ جَرْمٍ إِلاَّ کُنْتُ إمَامَہُمْ، وَأُصَلِّی علی جَنَائِزِہِمْ إلَی یَوْمِی ہَذَا۔ (ابوداؤد ۵۸۸۔ احمد ۵/۲۹)","Sahih","Musannaf Ibn Abi Shaybah 3477","","","كتاب الصلوات"
"3478","(۳۴۷۸) حَدَّثَنَا وَکِیعٌ، عَنِ الرَّبِیعِ، عَنِ ابْنِ سِیرِینَ، قَالَ: یَؤُمُّ الْقَوْمَ، أَقْرَؤُہُمْ۔","","Musannaf Ibn Abi Shaybah 3478","","","كتاب الصلوات"
"3479","(۳۴۷۹) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، قَالَ: یَؤُمُّ الْقَوْمَ، أَفْقَہُہُمْ۔","","Musannaf Ibn Abi Shaybah 3479","","","كتاب الصلوات"
"3480","(۳۴۸۰) حَدَّثَنَا ابْنُ نُمَیْرٍ، عَنْ عُبَیْدِ اللہِ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ الْمُہَاجِرِینَ حِینَ أَقْبَلُوا مِنْ مَکَّۃَ نَزَلُوا إلَی جَنْبِ قُبَائَ، فَأَمَّہُمْ سَالِمٌ مَوْلَی أَبِی حُذَیْفَۃَ، لأَنَّہُ کَانَ أَکْثَرَہُمْ قُرْآنًا، وَفِیہِمْ أَبُو سَلَمَۃَ بْنُ عَبْدِ الأَسَدِ، وَعُمَرُ بْنُ الْخَطَّابِ۔","Sahih","Musannaf Ibn Abi Shaybah 3480","","","كتاب الصلوات"
"3481","(۳۴۸۱) حَدَّثَنَا وَکِیعٌ، قَالَ: حَدَّثَنَا ہُشَیْمٌ، عَنْ أَبِیہِ، قَالَ: فَقَدَ عُمَرُ رَجُلاً فِی صَلاَۃِ الصُّبْحِ فَأَرْسَلَ إلَیْہِ، فَجَائَ فَقَالَ: أَیْنَ کُنْت ؟ فَقَالَ: کُنْتُ مَرِیضًا وَلَوْلا أَنَّ رَسُولَک أَتَانِی مَا خَرَجْت، فَقَالَ عُمَرُ: فَإِنْ کُنْتَ خَارِجًا إلَی أَحَدٍ فَاخْرُجْ إِلی الصَّلاَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 3481","","","كتاب الصلوات"
"3482","(۳۴۸۲) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنْ أَبِی حَصِینٍ، عَنْ أَبِی بُرْدَۃَ، عَنْ أَبِی مُوسَی، قَالَ: مَنْ سَمِعَ الْمُنَادِی، ثُمَّ لَمْ یُجِبْہُ مِنْ غَیْرِ عُذْرٍ، فَلاَ صَلاَۃَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 3482","","","كتاب الصلوات"
"3483","(۳۴۸۳) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنْ عَدِیِّ بْنِ ثَابِتٍ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: مَنْ سَمِعَ الْمُنَادِی، ثُمَّ لَمْ یُجِبْ مِنْ غَیْرِ عُذْرٍ، فَلاَ صَلاَۃَ لَہُ۔ (ابوداؤد ۵۵۲)","Sahih","Musannaf Ibn Abi Shaybah 3483","","","كتاب الصلوات"
"3484","(۳۴۸۴) حَدَّثَنَا وَکِیعٌ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حُصَیْنٍ، عَنْ أَبِی نَجِیحٍ الْمَکِّیِّ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: لأَنْ یَمْتَلِئَ أُذُنُ ابْنِ آدَمَ رَصَاصًا مُذَابًا، خَیْرٌ لَہُ مِنْ أَنْ یَسْمَعَ الْمُنَادِیَ، ثُمَّ لاَ یُجِیبُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 3484","","","كتاب الصلوات"
"3485","(۳۴۸۵) حَدَّثَنَا وَکِیعٌ، عن سفیان، عَنْ مَنْصُورٍ، عَنْ عَدِیِّ بْنِ ثَابِتٍ، عَنْ عَائِشَۃَ، قَالَتْ: مَنْ سَمِعَ الْمُنَادِی فَلَمْ یُجِبْہ، لَمْ یُرِدْ خَیْرًا، وَلَمْ یُرَدْ بِہِ۔","","Musannaf Ibn Abi Shaybah 3485","","","كتاب الصلوات"
"3486","(۳۴۸۶) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ، عن أَبی مُوسَی الْہِلاَلِیِّ، عَنْ أَبِیہِ، عَنِ ابْنِ مَسْعُودٍ، قَالَ: مَنْ سَمِعَ الْمُنَادِی، ثُمَّ لَمْ یُجِبْ مِنْ غَیْرِ عُذْرٍ، فَلاَ صَلاَۃَ لَہُ۔","Majhul","Musannaf Ibn Abi Shaybah 3486","","","كتاب الصلوات"
"3487","(۳۴۸۷) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا ابْنُ عَوْنٍ، عَنِ ابْنِ سِیرِینَ، قَالَ: خَرَجَ عُثْمَانُ وَقَدْ غَسَلَ أَحد شِقَّیْ رَأْسِہِ، فَقَالَ: إنَّ الْمُنَادِیَ جَائَ فَأَعْجَلَنِی ، فَکَرِہْتُ أَنْ أَحْبِسَہُ۔","","Musannaf Ibn Abi Shaybah 3487","","","كتاب الصلوات"
"3488","(۳۴۸۸) حَدَّثَنَا ہُشَیْمٌ، قَالَ: أَخْبَرَنَا أَبُو حَیَّانَ، عَنْ أَبِیہِ، عَنْ عَلِیٍّ، قَالَ: لاَ صَلاَۃَ لِجَارِ الْمَسْجِدِ إِلاَّ فِی الْمَسْجِدِ، قَالَ: قِیلَ لہ: وَمَنْ جَارُ الْمَسْجِدِ ؟ قَالَ: مَنْ أَسْمَعَہُ الْمُنَادِی۔","Majhul","Musannaf Ibn Abi Shaybah 3488","","","كتاب الصلوات"
"3489","(۳۴۸۹) حَدَّثَنَا ہُشَیْمٌ، قَالَ: أَخْبَرَنَا مَنْصُورٌ، عَنِ الْحَسَنِ، عَنْ عَلِیٍّ، أَنَّہُ قَالَ: مَنْ سَمِعَ النِّدَائَ فَلَمْ یَأْتِہِ، لَمْ تُجَاوِز صَلاَتُہُ رَأْسَہُ، إِلاَّ بِالْعُذْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 3489","","","كتاب الصلوات"
"3490","(۳۴۹۰) حَدَّثَنَا ہُشَیْمٌ، قَالَ: حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، أَنَّہُ قَالَ: إِنْ کُنْتَ مُجِیبَ دَعْوَۃٍ، فَأَجِبْ دَاعِیَ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 3490","","","كتاب الصلوات"
"3491","(۳۴۹۱) حَدَّثَنَا ہُشَیْمٌ، عَنْ حُصَیْنٍ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ، قَالَ: اسْتَقَلَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ النَّاسَ ذَاتَ لَیْلَۃٍ فِی الْعِشَائِ، یَعْنِی الْعَتَمَۃَ، قَالَ: فَلَقَدْ ہَمَمْتُ أَنْ آمُرَ بِالصَّلاَۃِ فَیُنَادَی بِہَا، ثُمَّ آتِیَ قَوْمًا فِی بُیُوتِہِمْ فَأُحَرِّقَہَا عَلَیْہِمْ، لاَ یَشْہَدُونَ الصَّلاَۃَ۔","","Musannaf Ibn Abi Shaybah 3491","","","كتاب الصلوات"
"3492","(۳۴۹۲) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ سُفْیَانَ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَابِسٍ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی، قَالَ: جَائَ ابْنُ أُمِّ مَکْتُومٍ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، فَقَالَ: یَا رَسُولَ اللہِ، إنَّ الْمَدِینَۃَ أَرْضُ ہَوَامٍّ وَسِبَاخٍ، فَہَلْ لِی رُخْصَۃٌ أَنْ أُصَلِّیَ الْعِشَائَ وَالْفَجْرَ فِی بَیْتِی ؟ فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أَتَسْمَعُ، حَیَّ عَلَی الصَّلاَۃِ، حَیَّ عَلَی الْفَلاَحِ ؟ قَالَ: فَقَالَ: نَعَمْ، قَالَ: فَحَیَّہَلاَ۔ (حاکم ۲۴۷)","","Musannaf Ibn Abi Shaybah 3492","","","كتاب الصلوات"
"3493","(۳۴۹۳) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ، عَنْ أَبِی سِنَانٍ، عَنْ عَمْرِو بْنِ مُرَّۃَ، قَالَ: حَدَّثَنِی أَبُو رَزِینٍ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: جَائَ ابْنُ أُمِّ مَکْتُومٍ إلَی رَسُولِ اللہ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، فَقَالَ: إنِّی رَجُلٌ ضَرِیرٌ شَاسِعُ الدَّارِ، وَلَیْسَ لِی قَائِدٌ یُلاَزِمُنِی، فَلِی رُخْصَۃٌ أَنْ لاَ آتِیَ الْمَسْجِدَ ؟ أَوْ کَمَا قَالَ، قَالَ: لاَ۔ (ابوداؤد ۵۵۳۔ احمد ۳/۴۲۳)","Hasan","Musannaf Ibn Abi Shaybah 3493","","","كتاب الصلوات"
"3494","(۳۴۹۴) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: اخْتَلَفَ إلَیْہِ رَجُلٌ شَہْرًا یَسْأَلُہُ عَنْ رَجُلٍ یَصُومُ النَّہَارَ وَیَقُومُ اللَّیْلَ، وَلاَ یَشْہَدُ جُمُعَۃً، وَلاَ جَمَاعَۃً، مَات ؟قَالَ: فِی النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 3494","","","كتاب الصلوات"
"3495","(۳۴۹۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ، عَنْ أَشْعَثَ، عَنْ جَہْمِ بْنِ أَبِی سَبْرَۃَ ؛ أَنَّ الزُّبَیْرَ بْنَ الْعَوَّامِ کَانَ یَقْعُدُ خَلْفَہُ رَجُلٌ یَحْفَظ عَلیہ صَلاَتَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 3495","","","كتاب الصلوات"
"3496","(۳۴۹۶) حَدَّثَنَا عَفَّانُ، قَالَ: حدَّثَنَا أَبُو ہِلاَلٍ، قَالَ: حَدَّثَنَا مُحَمَّدُ بْنُ سِیرِینَ، قَالَ: کَانَ عُمَرُ بْنُ الْخَطَّابِ یَخَافُ النِّسْیَانَ، قَالَ: فَکَانَ إذَا صَلَّی وَکَّلَ رَجُلاً فَیَلْحَظُ إلَیْہِ، فَإِنْ رَآہُ قَامَ قَامَ، وَإِنْ رَآہُ قَعَدَ قَعَدَ۔","","Musannaf Ibn Abi Shaybah 3496","","","كتاب الصلوات"
"3497","(۳۴۹۷) حَدَّثَنَا وَکِیعٌ، عَنْ شَرِیکٍ، عَنِ الرُّکَیْنِ، قَالَ: دَخَلْتُ عَلَی أَسْمَائَ وَہِیَ تُصَلِّی وَہِیَ عَجُوزٌ، وَامْرَأَۃٌ تَقُولُ لَہَا: ارْکَعِی وَاسْجُدِی۔","Hasan","Musannaf Ibn Abi Shaybah 3497","","","كتاب الصلوات"
"3498","(۳۴۹۸) حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِیُّ، عَنْ مُوسَی بْنِ إِبْرَاہِیمَ، عَن سَلَمَۃَ بْنِ الأَکْوَعِ، أَنَّہُ قَالَ: قُلْتُ: یَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، إنِّی أَتَصَیَّدُ فَأُصَلِّی فِی الْقَمِیصِ الْوَاحِدِ ؟ قَالَ: نَعَمْ، وَزُرَّہُ وَلَوْ بِشَوْکَۃٍ۔ (ابوداؤد ۶۳۲۔ ابن خزیمۃ ۷۷۸)","Hasan","Musannaf Ibn Abi Shaybah 3498","","","كتاب الصلوات"
"3499","(۳۴۹۹) حَدَّثَنَا وَکِیعٌ، عَنْ کَثِیرِ بْنِ زَیْدٍ، قَالَ: رَأَیْتُ سَالِمًا وَہُوَ یُصَلِّی مُحَلَّلَۃٌ أَزْرَارُہُ۔","","Musannaf Ibn Abi Shaybah 3499","","","كتاب الصلوات"
"3500","(۳۵۰۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَاب قَالَ: حدَّثَنِی عَبْدُ الْمَلِکِ بْنُ الرَّبِیعِ بْنِ سَبْرَۃَ بْنِ مَعْبَدٍ الْجُہَنِیُّ، قَالَ: حَدَّثَنِی أَبِی، عَنْ جَدِّی، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إذَا بَلَغَ الْغُلاَمُ سَبْعَ سِنِینَ فَأمُرُوہُ بِالصَّلاَۃِ، فَإِذَا بَلَغَ عَشْرًا فَاضْرِبُوہُ عَلَیْہَا۔ (ترمذی ۴۰۷۔ ابوداؤد ۴۹۵)","Hasan","Musannaf Ibn Abi Shaybah 3500","","","كتاب الصلوات"
"3501","(۳۵۰۱) حَدَّثَنَا وَکِیعٌ، عَنْ دَاوُدَ بْنِ سَوَّارٍ، عَنْ عَمْرِو بْنِ شُعَیْبٍ، عَنْ أَبِیہِ، عَنْ جَدِّہِ، قَالَ: قَالَ نَبِیُّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مُرُوا صِبْیَانَکُمْ بِالصَّلاَۃِ إذَا بَلَغُوا سَبْعًا، وَاضْرِبُوہُمْ عَلَیْہَا إذَا بَلَغُوا عَشْرًا، وَفَرِّقُوا بَیْنَہُمْ فِی الْمَضَاجِعِ۔ (ابوداؤد ۴۹۷۔ احمد ۲/۱۸۰)","Da'if","Musannaf Ibn Abi Shaybah 3501","","","كتاب الصلوات"
"3502","(۳۵۰۲) حَدَّثَنَا ابْنُ مُبَارَکٍ، عَنْ حُسَیْنِ بْنِ عَبْدِ اللہِ، قَالَ: حدَّثَتْنِی أُمُّ یُونُسَ خَادِمُ ابْنِ عَبَّاسٍ، قَالَتْ: کَانَ ابْنُ عَبَّاسٍ یَقُولُ: أَیْقِظُوا الصَّبِیَّ یُصَلِّی وَلَوْ سَجْدَۃً۔","Majhul","Musannaf Ibn Abi Shaybah 3502","","","كتاب الصلوات"
"3503","(۳۵۰۳) حَدَّثَنَا حَفْصٌ، عَنْ مُحَمَّدِ بْنِ أَبِی یَحْیَی، عَنِ امْرَأَۃٍ مِنْہُمْ، عَنْ جَدَّۃٍ لَہَا ؛ أَنَّ عُمَرَ مَرَّ بِامْرَأَۃٍ وَہِیَ تُوقِظُ صَبِیًّا لَہَا یُصَلِّی وَہُوَ یَتَلَکَّأُ، فَقَالَ: دَعِیہِ فَلَیْسَتْ عَلَیْہِ حَتَّی یَعْقِلَہَا۔","Majhul","Musannaf Ibn Abi Shaybah 3503","","","كتاب الصلوات"
"3504","(۳۵۰۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ حَجَّاج، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، قَالَ: یُعَلَّمُ الصَّبِیَّ الصَّلاَۃَ إذَا عَرَفَ یَمِینَہُ مِنْ شِمَالِہِ۔","","Musannaf Ibn Abi Shaybah 3504","","","كتاب الصلوات"
"3505","(۳۵۰۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، وَحَفْصٌ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ، قَالَ: کَانَ یُعَلَّمُ الصَّبِیُّ الصَّلاَۃَ إذَا اثَّغَرَ۔","","Musannaf Ibn Abi Shaybah 3505","","","كتاب الصلوات"
"3506","(۳۵۰۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: کَانُوا یُعَلِّمُونَ الصِّبْیَانَ الصَّلاَۃَ إذَا اثَّغَرُوا۔","","Musannaf Ibn Abi Shaybah 3506","","","كتاب الصلوات"
"3507","(۳۵۰۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ ہِشَامٍ، عَنْ أَبِیہِ، قَالَ: کَانَ یُعَلِّمُ بَنِیہِ الصَّلاَۃَ إذَا عَقَلُوا، وَالصَّوْمَ إذَا أَطَاقُوا۔","","Musannaf Ibn Abi Shaybah 3507","","","كتاب الصلوات"
"3508","(۳۵۰۸) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ، عَنْ عَبْدِ الرَّحْمَنِ الْیَحْصُبِیِّ، قَالَ: یُؤْمَرُ الصَّبِیُّ بِالصَّلاَۃِ إذَا عَدَّ عِشْرِینَ۔","","Musannaf Ibn Abi Shaybah 3508","","","كتاب الصلوات"
"3509","(۳۵۰۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ سُفْیَانَ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ، عَنِ امْرَأَۃِ عَبْدِ الرَّحْمَنِ الْیَحْصُبِیِّ، عَنْ عَبْدِ الرَّحْمَنِ الْیَحْصُبِیِّ، بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 3509","","","كتاب الصلوات"
"3510","(۳۵۱۰) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ أَبِی رَجَائٍ، عَنْ مَکْحُولٍ، قَالَ: یُؤْمَرُ الصَّبِیُّ بِہَا إذَا بَلَغَ السَّبْعَ، وَیُضْرَبُ عَلَیْہَا إذَا بَلَغَ عَشْرًا","","Musannaf Ibn Abi Shaybah 3510","","","كتاب الصلوات"
"3511","(۳۵۱۱) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ أَبِی فَزَارَۃَ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ، قَالَ: یُؤْمَرُ بِہَا إذَا بَلَغَ حُلْمَہُ۔","","Musannaf Ibn Abi Shaybah 3511","","","كتاب الصلوات"
"3512","(۳۵۱۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ حَجَّاجٍ، عَنْ أَبِی إِسْحَاقَ، قَالَ: کَانَ یُعَلَّمُ الصَّبِیُّ الصَّلاۃ مَا بَیْنَ سَبْعِ سِنِینَ إلَی عَشَرِ سِنِینَ۔","","Musannaf Ibn Abi Shaybah 3512","","","كتاب الصلوات"
"3513","(۳۵۱۳) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ، عَنْ جَعْفَرٍ، عَنْ أَبِیہِ، قَالَ: کَانَ عَلِیُّ بْنُ الْحُسَیْنِ یَأْمُرُ الصِّبْیَانَ أَنْ یُصَلُّوا الظُّہْرَ وَالْعَصْرَ جَمِیعًا وَالْمَغْرِبَ وَالْعِشَائَ جَمِیعًا فَیُقَالُ یُصَلُّونَ الصَّلاَۃَ لِغَیْرِ وَقْتِہَا فَیَقُولُ ہَذَا خَیْرٌ مِنْ أَنْ یَنَامُوا عَنْہَا۔","","Musannaf Ibn Abi Shaybah 3513","","","كتاب الصلوات"
"3514","(۳۵۱۴) حَدَّثَنَا حَفْصٌ، عَنْ أَشْعَثَ، عَنِ ابْنِ سِیرِینَ، قَالَ: یُعَلَّمُ الصَّبِیُّ الصَّلاَۃَ إذَا عَرَفَ یَمِینَہُ مِنْ شِمَالِہِ۔","","Musannaf Ibn Abi Shaybah 3514","","","كتاب الصلوات"
"3515","(۳۵۱۵) حَدَّثَنَا حَفْصٌ، عَنْ عُبَیْدِ اللہِ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 3515","","","كتاب الصلوات"
"3516","(۳۵۱۶) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا الأَعْمَشُ، عَنْ عُمَارَۃَ، عَنْ أَبِی الأَحْوَصِ، قَالَ: قَالَ عَبْدُ اللہِ حَافِظُوا عَلَی أَبْنَائِکُمْ عَلَی الصَّلاَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 3516","","","كتاب الصلوات"
"3517","(۳۵۱۷) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ، عَنْ عَبْدِ الْکَرِیمِ، عَنْ عَمْرِو بْنِ شُعَیْبٍ، قَالَ: کَانَ الْغُلاَمُ إذَا أَفْصَحَ مِنْ بَنِی عَبْدِ الْمُطَّلِبِ عَلَّمَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ہَذِہِ الآیَۃَ سَبْعَ مَرَّاتٍ: {الْحَمْدُ لِلَّہِ الَّذِی لَمْ یَتَّخِذْ وَلَدًا وَلَمْ یَکُنْ لَہُ شَرِیکٌ فِی الْمُلْکِ}۔ (عبدالرزاق ۷۹۷۶)","","Musannaf Ibn Abi Shaybah 3517","","","كتاب الصلوات"
"3518","(۳۵۱۸) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ، عَنْ جَعْفَرٍ، عَنْ أَبِیہِ، قَالَ: کَانَ عَلِیُّ بْنُ الْحُسَیْنِ یُعَلِّمُ وَلَدَہُ یَقُولُ قُلْ آمَنْت بِاللَّہِ وَکَفَرْت بِالطَّاغُوتِ۔","","Musannaf Ibn Abi Shaybah 3518","","","كتاب الصلوات"
"3519","(۳۵۱۹) حَدَّثَنَا ہُشَیْمٌ، عَنِ الْعَوَّامِ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ، قَالَ: کَانُوا یَسْتَحِبُّونَ أَنْ یُلَقِّنُوا الصَّبِیَّ الصَّلاَۃَ وَیُعْرِبُ أَوَّلَ مَا یَتَکَلَّمُ یَقُولُ لاَ إلَہَ إِلاَّ اللَّہُ سَبْعَ مَرَّاتٍ فَیَکُونُ ذَلِکَ أَوَّلَ شَیْئٍ یَتَکَلَّمُ بِہِ۔","","Musannaf Ibn Abi Shaybah 3519","","","كتاب الصلوات"
"3520","(۳۵۲۰) حَدَّثَنَا وَکِیعٌ، عَنْ ہَمَّامٍ، عَنْ أَبِیہِ، أَنَّ الأَشْعَثَ قَدَّمَ غُلاَمًا فَقِیلَ لَہُ، فَقَالَ: إنَّمَا قَدَّمْت الْقُرْآنَ۔","Majhul","Musannaf Ibn Abi Shaybah 3520","","","كتاب الصلوات"
"3521","(۳۵۲۱) حَدَّثَنَا عَبْدَۃُ، عَنْ ہِشَامٍ، عَنْ أَبِیہِ، قَالَ: لَمَّا قَدِمَ الأَشْعَثُ، قَدَّمَ غُلاَمًا فَعَابُوا ذَلِکَ عَلَیْہِ، فَقَالَ: مَا قَدَّمْتُہُ، وَلَکِنِّی قَدَّمْت الْقُرْآنَ۔","Sahih","Musannaf Ibn Abi Shaybah 3521","","","كتاب الصلوات"
"3522","(۳۵۲۲) حَدَّثَنَا ہُشَیْمٌ، عَنْ یُونُسَ، عَنِ الْحَسَنِ، عَنْ إبْرَاہِیمَ، قَالَ: لاَ بَأْسَ أَنْ یَؤُمَّ الْغُلاَمُ قَبْلَ أَنْ یَحْتَلِمَ فِی شَہْرِ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 3522","","","كتاب الصلوات"
"3523",") حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ: لاَ بَأْسَ أَنْ یَؤُمَّ الْغُلاَمُ قَبْلَ أَنْ یَحْتَلِمَ۔","","Musannaf Ibn Abi Shaybah 3523","","","كتاب الصلوات"
"3524","(۳۵۲۴) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَاء، وَعُمَر بْنِ عَبْدِ الْعَزِیز، قَالاَ: لاَ یَؤُمُّ الْغُلاَمُ قَبْلَ أَنْ یَحْتَلِمَ فِی الْفَرِیضَۃِ وَلاَ غَیْرِہَا۔","","Musannaf Ibn Abi Shaybah 3524","","","كتاب الصلوات"
"3525","(۳۵۲۵) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ، عَنْ عَبْدِ الْعَزِیزِ، عَنِ الشَّعْبِیِّ، قَالَ: لاَ یَؤُمُّ الْغُلاَمُ حَتَّی یَحْتَلِمَ۔","","Musannaf Ibn Abi Shaybah 3525","","","كتاب الصلوات"
"3526","(۳۵۲۶) حَدَّثَنَا رَوَّادُ بْنُ جَرَّاحٍ أَبُو عِصَامٍ، عَنِ الأَوْزَاعِیِّ، عَنْ وَاصِلٍ أَبِی بَکْرٍ، عَنْ مُجَاہِدٍ، قَالَ: لاَ یَؤُمُّ غُلاَمٌ حَتَّی یَحْتَلِمَ۔","","Musannaf Ibn Abi Shaybah 3526","","","كتاب الصلوات"
"3527","(۳۵۲۷) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: کَانَ یُکْرَہُ التَّمَطِّیَ عِنْدَ النِّسَائِ، وَفِی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 3527","","","كتاب الصلوات"
"3528","(۳۵۲۸) حَدَّثَنَا جَرِیرٌ، عَنْ لَیْثٍ، قَالَ: قَالَ سَعِیدُ بْنُ جُبَیْرٍ: التَّمَطِّی یَنْقُصُ الصَّلاَۃَ۔","","Musannaf Ibn Abi Shaybah 3528","","","كتاب الصلوات"
"3529","(۳۵۲۹) حَدَّثَنَا أَبُو خَالِدٍ الأحمر، عَنِ ابْنِ عَجْلاَنَ، عَنْ أَبِی الزِّنَادِ، عَنِ الأَعْرَجِ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُصَلِّیَ الرَّجُلُ فِی الثَّوْبِ الْوَاحِدِ، لَیْسَ عَلَی عَاتِقَیہِ مِنْہُ شَیْئٌ۔","Hasan","Musannaf Ibn Abi Shaybah 3529","","","كتاب الصلوات"
"3530","(۳۵۳۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ أَبِی الزِّنَادِ، عَنِ الأَعْرَجِ، عَنْ أَبِی ہُرَیْرَۃَ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ مِثْلَہُ۔n(مسلم ۲۷۷۔ ابوداؤد ۶۲۶)","Sahih","Musannaf Ibn Abi Shaybah 3530","","","كتاب الصلوات"
"3531","(۳۵۳۱) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ أَبِی إِسْحَاقَ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ، قَالَ: کَانَ الرَّجُلُ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا لَمْ یَجِدْ رِدَائً یُصَلِّی فِیہِ، وَضَعَ عَلَی عَاتِقَیہِ عِقَالاً ثُمَّ صَلَّی۔","","Musannaf Ibn Abi Shaybah 3531","","","كتاب الصلوات"
"3532","(۳۵۳۲) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: کَانُوا یَکْرَہُونَ إعْرَائَ الْمَنَاکِبِ فِی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 3532","","","كتاب الصلوات"
"3533","(۳۵۳۳) حَدَّثَنَا حَفْصٌ، عَنْ أَشْعَثَ، عَنِ الْحَکَمِ ؛ أَنَّ مُحَمَّدَ بْنَ عَلِیٍّ کَانَ یَقُولُ: لاَ یُصَلِّی الرَّجُلُ، إِلاَّ وَہُوَ مُخَمِّرٌ عَاتِقَہُ۔","","Musannaf Ibn Abi Shaybah 3533","","","كتاب الصلوات"
"3534","(۳۵۳۴) حَدَّثَنَا جَرِیرٌ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ، عَنْ مُجَاہِدٍ، قَالَ: لَمَّا قَدِمَ عُمَرُ مَکَّۃَ أَتَاہُ أَبُو مَحْذُورَۃَ وَقَدْ أَذَّنَ، فَقَالَ: الصَّلاَۃَ یَا أَمِیرَ الْمُؤْمِنِینَ، حَیَّ عَلَی الصَّلاَۃِ، حَیَّ عَلَی الصَّلاَۃِ، حَیَّ عَلَی الْفَلاَحِ، حَیَّ عَلَی الْفَلاَحِ، قَالَ: وَیْحَک، أَمَجْنُونٌ أَنْتَ ؟ أَمَا کَانَ فِی دُعَائِکَ الَّذِی دَعَوْتنَا مَا نَأْتِیک حَتَّی تَأْتِیَنَا۔","","Musannaf Ibn Abi Shaybah 3534","","","كتاب الصلوات"
"3535","(۳۵۳۵) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، قَالَ: کَانَ الْمُؤَذِّنُ إذَا اسْتَبْطَأَ الْقَوْمَ، قَالَ: أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ، قَدْ قَامَتِ الصَّلاَۃُ، قَدْ قَامَتِ الصَّلاَۃُ، حَیَّ عَلَی الصَّلاَۃِ، حَیَّ عَلَی الصَّلاَۃِ، حَیَّ عَلَی الْفَلاَحِ، حَیَّ عَلَی الْفَلاَحِ۔","","Musannaf Ibn Abi Shaybah 3535","","","كتاب الصلوات"
"3536","(۳۵۳۶) حَدَّثَنَا جَرِیرٌ، عَنْ مِسْحَاجِ بْنِ مُوسَی الضَّبِّیِّ، قَالَ: سَمِعْتُ أَنَسَ بْنَ مَالِکٍ یَقُولُ لِمُحَمَّدِ بْنِ عَمْرٍو: إذَا کُنْتَ فِی سَفَرٍ، فَقُلْتُ: أَزَالَتِ الشَّمْسُ، أَوْ لَمْ تَزُلْ، أَوِ انْتَصَفَ النَّہَارُ، أَوْ لَمْ یَنْتَصِفْ، فَصَلِّ قَبْلَ أَنْ تَرْتَحِلَ۔","Sahih","Musannaf Ibn Abi Shaybah 3536","","","كتاب الصلوات"
"3537","(۳۵۳۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، قَالَ: إذَا کُنْتَ فِی سَفَرٍ ، فَقُلْتُ : زَالَتِ الشَّمْسُ ، أَوْ لَمْ تَزُلْ ، فَصَلِّ۔","","Musannaf Ibn Abi Shaybah 3537","","","كتاب الصلوات"
"3538","(۳۵۳۸) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنْ حَمْزَۃَ الضَّبِّیِّ، قَالَ: سَمِعْتُ أَنَسًا یَقُولُ: کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا نَزَلَ مَنْزِلاً لَمْ یَرْتَحِلْ حَتَّی یُصَلِّیَ الظُّہْرَ، فَقَالَ لَہُ مُحَمَّدُ بْنُ عَمْرٍو: وَإِنْ کَانَ نِصْفَ النَّہَارِ ؟ قَالَ: وَإِنْ کَانَ نِصْفَ النَّہَارِ۔ (ابوداؤد ۱۱۹۸۔ احمد ۳/۱۳۰)","Sahih","Musannaf Ibn Abi Shaybah 3538","","","كتاب الصلوات"
"3539","(۳۵۳۹) حَدَّثَنَا ابْنُ نُمَیْرٍ، عَنْ أَبِی حَیَّانَ، عَنْ أَبِیہِ، عَنِ الرَّبِیعِ بْنِ خُثَیْمٍ ؛ أَنَّہُ کَانَ بِہِ مَرَضٌ، فَکَانَ تُہَادَی بَیْنَ رَجُلَیْنِ إلَی الصَّلاَۃِ، فَیُقَالُ لَہُ: یَا أَبَا زَیْدٍ، إنَّک إِنْ شَائَ اللَّہُ فِی عُذْرٍ، فَیَقُولُ: أَجَلْ، وَلَکِنِّی أَسْمَعُ الْمُؤَذِّنَ یَقُولُ: حَیَّ عَلَی الصَّلاَۃِ، حَیَّ عَلَی الْفَلاَحِ، فَمَنْ سَمِعَہَا فَلْیَأْتِہَا وَلَوْ حَبْوًا، وَلَوْ زَحْفًا۔","","Musannaf Ibn Abi Shaybah 3539","","","كتاب الصلوات"
"3540","(۳۵۴۰) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنْ مَنْصُورٍ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ کَانَ یُحْمَلُ وَہُوَ مَرِیضٌ إلَی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 3540","","","كتاب الصلوات"
"3541","(۳۵۴۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ، عَنِ الأَسْوَدِ، عَنْ عَائِشَۃَ، قَالَتْ: لَقَدْ رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَرَضِہِ الَّذِی مَاتَ فِیہِ وَإِنَّہُ لیُہَادَی بَیْنَ رَجُلَیْنِ حَتَّی دَخَلَ فِی الصَّفِّ۔n(بخاری ۷۱۳)","Hasan","Musannaf Ibn Abi Shaybah 3541","","","كتاب الصلوات"
"3542","(۳۵۴۲) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ شَیْخٍ یُکَنَّی أَبَا سَہْلٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، قَالَ: مَا أَذَّنَ الْمُؤَذِّنُ مُنْذُ ثَلاَثِینَ سَنَۃً، إِلاَّ وَأَنَا فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 3542","","","كتاب الصلوات"
"3543","(۳۵۴۳) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ أَبِی حَمْزَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: مَا کَانُوا یُرَخِّصُونَ فِی تَرْکِ الْجَمَاعَۃِ، إِلاَّ لِخَائِفٍ، أَوْ مَرِیضٍ۔","","Musannaf Ibn Abi Shaybah 3543","","","كتاب الصلوات"
"3544","(۳۵۴۴) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ، قَالَ: أَخْبَرَنَا حُمَیْدٌ، عَنْ أَنَسٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: اعْتَدِلُوا فِی صُفُوفِکُمْ وَتَراصَّوا، فَإِنِّی أَرَاکُمْ مِنْ وَرَائِ ظَہْرِی، قَالَ أَنَسٌ: لَقَدْ رَأَیْت أَحَدَنَا یُلْزِقُ مَنْکِبَہُ بِمَنْکِبِ صَاحِبِہِ، وَقَدَمَہُ بِقَدَمِہِ، وَلَوْ ذَھَبْتَ تَفْعَلَ ذَلِکَ لَتَرَی أَحَدَھُمْ کَأَنَّہُ بَغْلٌ شَمُوسٌ۔ (بخاری ۷۲۵۔ احمد ۳/۱۰۳)","Sahih","Musannaf Ibn Abi Shaybah 3544","","","كتاب الصلوات"
"3545","(۳۵۴۵) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ سِمَاکٍ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ، قَالَ: لَقَدْ رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَإِنَّہُ لیقَوِّمُ الصُّفُوفَ کَمَا تُقَوَّمُ الْقِدَاحُ، فَأَبْصَرَ یَوْمًا صَدْرَ رَجُلٍ خَارِجًا مِنَ الصَّفِّ، فَقَالَ: لَتُقِیمُنَّ صُفُوفَکُمْ، أَوْ لَیُخَالِفَنَّ اللَّہُ بَیْنَ وُجُوہِکُمْ۔ (مسلم ۳۲۵۔ ابوداؤد ۶۶۵)","Hasan","Musannaf Ibn Abi Shaybah 3545","","","كتاب الصلوات"
"3546","(۳۵۴۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ، عَنْ طَلْحَۃَ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَۃَ، عَنِ الْبَرَائِ بْنِ عَازِبٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أَقِیمُوا صُفُوفَکُمْ لاَ یَتَخَلَّلُکُمْ کَأَوْلاَدِ الْحَذَفِ، قِیلَ: یَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، وَمَا أَوْلاَدُ الْحَذَفِ ؟ قَالَ: ضَأْنٌ سُودٌ جُرْدٌ تَکُونُ بِأَرْضِ الْیَمَنِ۔ (ابوداؤد ۶۶۴۔ احمد ۴/۲۹۷)","Hasan","Musannaf Ibn Abi Shaybah 3546","","","كتاب الصلوات"
"3547","(۳۵۴۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، وَوَکِیعٌ، عَنِ الأَعْمَشِ، عَنْ عُمَارَۃَ، عَنْ أَبِی مَعْمَرٍ، عَنْ أَبِی مَسْعُودٍ، قَالَ: کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَمْسَحُ مَنَاکِبَنَا فِی الصَّلاَۃِ وَیَقُولُ: اسْتَوُوا، وَلاَ تَخْتَلِفُوا فَتَخْتَلِفَ قُلُوبُکُمْ، لِیَلِیَنِّی مِنْکُمْ أُولُوا الأَحْلاَمِ وَالنُّہَی، ثُمَّ الَّذِینَ یَلُونَہُمْ، قَالَ أَبُو مَسْعُودٍ: فَأَنْتُمُ الْیَوْمَ أَشَدُّ اخْتِلاَفًا۔n(مسلم ۱۲۲۔ ابوداؤد ۶۷۴)","Sahih","Musannaf Ibn Abi Shaybah 3547","","","كتاب الصلوات"
"3548","(۳۵۴۸) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنْ قَتَادَۃَ، عَنْ أَنَسٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أَقِیمُوا صُفُوفَکُمْ، فَإِنَّ مِنْ حُسْنِ الصَّلاَۃِ إقَامَۃَ الصف۔ (بخاری ۷۲۳۔ مسلم ۱۲۴)","Sahih","Musannaf Ibn Abi Shaybah 3548","","","كتاب الصلوات"
"3549","(۳۵۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنْ یُونُسَ بْنِ جُبَیْرٍ، عَنْ حِطَّانَ بْنِ عَبْدِ اللہِ الرَّقَاشِیِّ، قَالَ: صَلَّی بِنَا أَبُو مُوسَی الأَشْعَرِیُّ، فَلَمَّا انْفَتَلَ قَالَ: إِنَّ نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَنَا، فَبَیَّنَ لَنَا سُنَّتَنَا وَعَلَّمَنَا صَلاَتَنَا، فَقَالَ: إذَا صَلَّیْتُمْ فَأَقِیمُوا صُفُوفَکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 3549","","","كتاب الصلوات"
"3550","(۳۵۵۰) حَدَّثَنَا وَکِیعٌ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ، عَنْ أَبِی عُثْمَانَ، قَالَ: کُنْتُ فِیمَنْ یُقِیمُ عُمَرُ بْنُ الْخَطَّابِ قُدَّامَہُ لإِقَامَۃِ الصَّفِّ۔","Sahih","Musannaf Ibn Abi Shaybah 3550","","","كتاب الصلوات"
"3551","(۳۵۵۱) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ ابْنِ الأَصْبَہَانِیِّ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ؛ أَنَّ عُمَرَ رَأَی فِی الصَّفِّ شَیْئًا، فَقَالَ بِیَدِہِ ہَکَذَا، یَعْنِی وَکِیعٌ، فَعَدَّلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 3551","","","كتاب الصلوات"
"3552","(۳۵۵۲) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ مَالِکِ بْنِ أَنَسٍ، عَنْ سَالِمٍ أَبِی النَّضْرِ، عَنْ مَالِکِ بْنِ أَبِی عَامِرٍ، قَالَ: سَمِعْتُ عُثْمَانَ وَہُوَ یَقُولُ: اسْتَوُوا وَحَاذُوا بَیْنَ الْمَنَاکِبِ، فَإِنَّ مِنْ تَمَامِ الصَّلاَۃِ إقَامَۃَ الصَّفِّ، قَالَ: وَکَانَ لاَ یُکَبِّرُ حَتَّی یَأْتِیَہُ رِجَالٌ قَدْ وَکَّلَہُمْ بِإِقَامَۃِ الصُّفُوفِ۔","Sahih","Musannaf Ibn Abi Shaybah 3552","","","كتاب الصلوات"
"3553","(۳۵۵۳) حَدَّثَنَا أَبُو خَالِدٍ، عَنْ مُجَالِدٍ، عَنِ الشَّعْبِیِّ، عَنِ الْحَارِثِ، وَأَصْحَابِ عَلِیٍّ قَالُوا: کَانَ عَلِیٌّ یَقُولُ: اسْتَوُوا تَسْتَوِ قُلُوبُکُمْ، وَتَرَاصُّوا تَرَاحَمُوا۔","Da'if","Musannaf Ibn Abi Shaybah 3553","","","كتاب الصلوات"
"3554","(۳۵۵۴) حَدَّثَنَا ابْنُ نُمَیْرٍ، عَنِ الأَعْمَشِ، عَنْ عِمْرَانَ، عَنْ سُوَیْد، عَنْ بِلاَلٍ، قَالَ: کَانَ یُسَوِّی مَنَاکِبَنَا وَأَقْدَامَنَا فِی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 3554","","","كتاب الصلوات"
"3555","(۳۵۵۵) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ، عَنْ شُعْبَۃَ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ، عَنْ أَبِی الأَحْوَصِ، قَالَ: قَالَ عَبْدُ اللہِ: سَوُّوا صُفُوفَکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 3555","","","كتاب الصلوات"
"3556","(۳۵۵۶) حَدَّثَنَا ہُشَیْمٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: کَانَ یُقَالُ: سَوُّوا الصُّفُوفَ وَتَرَاصُّوا، لاَ تَتَخَلَّلُکُمُ الشَّیَاطِینُ، کَأَنَّہُمَ بَنَاتُ حَذَفٍ۔","","Musannaf Ibn Abi Shaybah 3556","","","كتاب الصلوات"
"3557","(۳۵۵۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ عَاصِمٍ، عَنْ أَبِی عُثْمَانَ، قَالَ: مَا رَأَیْت أَحَدًا کَانَ أَشَدَّ تَعَاہُدًا لِلصَّفِّ مِنْ عُمَرَ، إِنْ کَانَ لیسْتَقْبِلَ الْقِبْلَۃَ حَتَّی إذَا قُلْنَا قَدْ کَبَّرَ، الْتَفَتَ فَنَظَرَ إلَی الْمَنَاکِبِ وَالأَقْدَامِ، وَإِنْ کَانَ یَبْعَثُ رِجَالاً یَطْرُدُونَ النَّاسَ حَتَّی یُلْحِقُوہُمْ بِالصُّفُوفِ۔","Sahih","Musannaf Ibn Abi Shaybah 3557","","","كتاب الصلوات"
"3558","(۳۵۵۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ، عَنْ مُجَاہِدٍ، عَنْ أَبِی الْوَدَّاکِ، عَنْ أَبِی سَعِیدٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: یَضْحَکُ اللَّہُ إلَی ثَلاَثَۃٍ: الْقَوْمُ إذَا صَفُّوا فِی الصَّلاَۃِ، وَإِلَی الرَّجُلِ یُقَاتِلُ وَرَائَ أَصْحَابِہِ، وَإِلَی الرَّجُلِ یَقُومُ فِی سَوَادِ اللَّیْلِ۔","Da'if","Musannaf Ibn Abi Shaybah 3558","","","كتاب الصلوات"
"3559","(۳۵۵۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ، عَنْ تَمِیمِ بْنِ طَرَفَۃَ، عَنْ جَابِرِ بْنِ سَمُرَۃَ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أَلاَ تَصُفُّونَ کَمَا تَصُفُّ الْمَلاَئِکَۃُ عِنْدَ رَبِّہَا ؟ قَالُوا: وَکَیْفَ تَصُفُّ الْمَلاَئِکَۃُ عِنْدَ رَبِّہَا ؟ قَالَ: یُتِمُّونَ الصُّفُوفَ الأَولَی، وَیَتَرَاصُّونَ فِی الصَّفِّ۔ (مسلم ۱۱۹۔ ابوداؤد ۶۶۱)","Sahih","Musannaf Ibn Abi Shaybah 3559","","","كتاب الصلوات"
"3560","(۳۵۶۰) حَدَّثَنَا شَبَابَۃُ، عَنِ ابْنِ أَبِی ذِئْبٍ، عَنْ عَجْلاَنَ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: سَوُّوا صُفُوفَکُمْ، وَأَحْسِنُوا رُکُوعَکُمْ وَسُجُودَکُمْ۔ (احمد ۲/۲۳۴)","Hasan","Musannaf Ibn Abi Shaybah 3560","","","كتاب الصلوات"
"3561","(۳۵۶۱) حَدَّثَنَا شَرِیکٌ، عَنْ زِیَادِ بْنِ عِلاَقَۃَ، عَنْ قُطْبَۃَ بْنِ مَالِکٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ فِی الْفَجْرِ: {وَالنَّخْلَ بَاسِقَاتٍ}۔ (مسلم ۱۶۵۔ ترمذی ۳۰۶)","Hasan","Musannaf Ibn Abi Shaybah 3561","","","كتاب الصلوات"
"3562","(۳۵۶۲) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنِ الْوَلِیدِ بْنِ سَرِیعٍ، عَنْ عَمْرِو بْنِ حُرَیْثٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ فِی الْفَجْرِ: {وَاللَّیْلِ إذَا عَسْعَسَ}۔ (مسلم ۱۶۴۔ احمد ۴/۳۰۷)","Hasan","Musannaf Ibn Abi Shaybah 3562","","","كتاب الصلوات"
"3563","(۳۵۶۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ، عَنْ زُہَیْرٍ، عَنْ سِمَاکٍ، قَالَ: سَأَلْتُ جَابِرَ بْنَ سَمُرَۃَ عَنْ صَلاَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَأَنْبَأَنِی، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی الْفَجْرِ بِـ: {ق وَالْقُرْآنِ الْمَجِیدِ} وَنَحْوِہَا۔ (مسلم ۱۶۹۔ احمد ۵/۱۰۵ )","Hasan","Musannaf Ibn Abi Shaybah 3563","","","كتاب الصلوات"
"3564","(۳۵۶۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ عَوْفٍ، عَنْ أَبِی الْمِنْہَالِ، عَنْ أَبِی بَرْزَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِیہَا بِالسِّتِّینَ إلَی الْمِئَۃِ، یَعْنِی فِی الْفَجْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 3564","","","كتاب الصلوات"
"3565","(۳۵۶۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنِ الزُّہْرِیِّ، عَنْ أَنَسٍ ؛ أَنَّ أَبَا بَکْرٍ قَرَأَ فِی صَلاَۃِ الصُّبْحِ بِالْبَقَرَۃِ، فَقَالَ لَہُ عُمَرُ حِینَ فَرَغَ: کَرَبَتِ الشَّمْسُ أَنْ تَطْلُعَ، قَالَ: لَوْ طَلَعَتْ لَمْ تَجِدْنَا غَافِلِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 3565","","","كتاب الصلوات"
"3566","(۳۵۶۶) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ، عَنِ الزُّبَیْرِ بْنِ خِرِّیتٍ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ، عَنِ الأَحْنَفِ، قَالَ: صَلَّیْت خَلْفَ عُمَرَ الْغَدَاۃَ، فَقَرَأَ بِیُونُسَ، وَہُودٍ، وَنَحْوَہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 3566","","","كتاب الصلوات"
"3567","(۳۵۶۷) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنْ عَبْدِالْمَلِکِ بْنِ مَیْسَرَۃَ، عَنْ زَیْدِ بْنِ وَہْبٍ؛ أَنَّ عُمَرَ قَرَأَ فِی الْفَجْرِ، بِالْکَہْفِ۔","Sahih","Musannaf Ibn Abi Shaybah 3567","","","كتاب الصلوات"
"3568","(۳۵۶۸) حَدَّثَنَا وَکِیعٌ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ، عَنْ عَبْدِ اللہِ بْنِ عَامِرِ بْنِ رَبِیعَۃَ، قَالَ: سَمِعْتُ عُمَرَ یَقْرَأُ فِی الْفَجْرِ بِسُورَۃِ یُوسُفَ قِرَائَۃً بَطِیئَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 3568","","","كتاب الصلوات"
"3569","(۳۵۶۹) حَدَّثَنَا أَبُو أُسَامَۃَ، قَالَ: حدَّثَنَا عُبَیْدُ اللہِ، قَالَ: أَخْبَرَنِی ابْنُ الْفُرَافِصَۃِ، عَنْ أَبِیہِ، قَالَ: تَعَلَّمْتُ سُورَۃَ یُوسُفَ خَلْفَ عُمَرَ فِی الصُّبْحِ۔","Majhul","Musannaf Ibn Abi Shaybah 3569","","","كتاب الصلوات"
"3570","(۳۵۷۰) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ، قَالَ: صَلَّی بِنَا عَبْدُ اللہِ الْفَجْرَ فَقَرَأَ بِسُورَتَیْنِ، الآخِرَۃُ مِنْہُمَا بَنِو إسْرَائِیلَ۔","Sahih","Musannaf Ibn Abi Shaybah 3570","","","كتاب الصلوات"
"3571","(۳۵۷۱) حَدَّثَنَا وَکِیعٌ، عَنْ إدْرِیسَ الأَوْدِیِّ، عَنْ أَبِیہِ، قَالَ: سَمِعْتُ عَلِیًّا یَقْرَأُ فِی الآخِرَۃِ مِنْہُمَا بـ: {سَبِّحِ اسْمَ رَبِّکَ}۔","Hasan","Musannaf Ibn Abi Shaybah 3571","","","كتاب الصلوات"
"3572","(۳۵۷۲) حَدَّثَنَا مُعْتَمِرٌ، عَنِ الزُّبَیْرِ بْنِ خِرِّیتٍ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: صَلَّیْت خَلْفَہُ صَلاَۃَ الْغَدَاۃِ، فَقَرَأَ بِیُونُسَ وَہُودٍ۔","Sahih","Musannaf Ibn Abi Shaybah 3572","","","كتاب الصلوات"
"3573","(۳۵۷۳) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ، قَالَ: سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ، یُحَدِّثُ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ؛ أَنَّ مُعَاذَ بْنَ جَبَلٍ صَلَّی الصُّبْحَ بِالْیَمَنِ فَقَرَأَ بِالنِّسَائِ، فَلَمَّا أَتَی عَلَی ہَذِہِ الآیَۃِ: {وَاتَّخَذَ اللَّہُ إبْرَاہِیمَ خَلِیلاً} قَالَ رَجُلٌ مِنْ خَلْفِہِ: لَقَدْ قَرَّتْ عَیْنُ أُمِّ إبْرَاہِیمَ۔","Sahih","Musannaf Ibn Abi Shaybah 3573","","","كتاب الصلوات"
"3574","(۳۵۷۴) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ عُبَیْدِ اللہِ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، قَالَ: کَانَ یَقْرَأُ فِی الْفَجْرِ بِالسُّورَۃِ الَّتِی یُذْکَرُ فِیہَا یُوسُفُ، وَالَّتِی یُذْکَرُ فِیہَا الْکَہْفُ۔","Sahih","Musannaf Ibn Abi Shaybah 3574","","","كتاب الصلوات"
"3575","(۳۵۷۵) حَدَّثَنَا وَکِیعٌ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ، عَنِ الْحَارِثِ بْنِ سُوَیْد، قَالَ: کَانَ إمَامُنَا یَقْرَأُ بِنَا فِی الْفَجْرِ بِالسُّورَۃِ مِنَ الْمِئِینَ۔","","Musannaf Ibn Abi Shaybah 3575","","","كتاب الصلوات"
"3576","(۳۵۷۶) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنِ النُّعْمَانِ بْنِ قَیْسٍ، عَنْ عبیدَۃَ ؛ أَنَّہُ کَانَ یَقْرَأُ فِی الْفَجْرِ {الرَّحْمَنِ} ، وَنَحْوَہَا۔","","Musannaf Ibn Abi Shaybah 3576","","","كتاب الصلوات"
"3577","(۳۵۷۷) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ عَطَائِ بْنِ السَّائِبِ، قَالَ: صَلَّیْت خَلْفَ عَرْفَجَۃَ فَرُبَّمَا قَرَأَ بِالْمَائِدَۃِ فِی الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 3577","","","كتاب الصلوات"
"3578","(۳۵۷۸) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ، عَنْ جَدِّ ابْنِ إدْرِیسَ، قَالَ: صَلَّیْتُ خَلْفَ عَلِیٍّ الصُّبْحَ، فَقَرَأَ بِـ: {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی}۔","Hasan","Musannaf Ibn Abi Shaybah 3578","","","كتاب الصلوات"
"3579","(۳۵۷۹) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ تَوْبَۃَ الْعَنْبَرِیِّ ؛ أَنَّہُ سَمِعَ أَبَا سَوَّارٍ الْقَاضِیَ، قَالَ: صَلَّیْتُ خَلْفَ ابْنِ الزُّبَیْرِ الصُّبْحَ فَسَمِعْتُہُ یَقْرَأُ: {أَلَمْ تَرَ کَیْفَ فَعَلَ رَبُّک بِعَادٍ إرَمَ ذَاتِ الْعِمَادِ}۔","Sahih","Musannaf Ibn Abi Shaybah 3579","","","كتاب الصلوات"
"3580","(۳۵۸۰) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنِ الْوَلِیدِ بْنِ جُمَیْعٍ، قَالَ: صَلَّیْتُ خَلْفَ إبْرَاہِیمَ، فَکَانَ یَقْرَأُ فِی الصُّبْحِ بـ: (یس) وَأَشْبَاہَہَا، وَکَانَ سَرِیعَ الْقِرَائَۃِ۔","","Musannaf Ibn Abi Shaybah 3580","","","كتاب الصلوات"
"3581","(۳۵۸۱) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ قَالَ: مَا رَأَیْت رَجُلاً أَقْرَأَ مِنْ عَلِیٍّ، إِنَّہُ قَرَأَ بِنَا فِی صَلاَۃِ الْفَجْرِ بِالأَنْبِیَائِ، قَالَ: إذَا بَلَغَ رَأْسَ سَبْعِینَ تَرَکَ مِنْہَا آیَۃً فَقَرَأَ مَا بَعْدَہَا، ثُمَّ ذَکَرَ فَرَجَعَ فَقَرَأَہَا، ثُمَّ رَجَعَ إلَی مَکَانِہِ الَّذِی کَانَ قَرَأَ، لَمَّا یَتَتَعْتَعْ۔","Da'if","Musannaf Ibn Abi Shaybah 3581","","","كتاب الصلوات"
"3582","(۳۵۸۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ، قَالَ: أَخْبَرَنَا الضَّحَّاکُ بْنُ عُثْمَانَ، قَالَ: رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ قَرَأَ فِی الْفَجْرِ بِسُورَتَیْنِ مِنْ طِوَالِ الْمُفَصَّلِ۔","","Musannaf Ibn Abi Shaybah 3582","","","كتاب الصلوات"
"3583","(۳۵۸۳) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنِ الْجُریرِیِّ، عَنْ أَبِی الْعَلاَئِ، عَنْ أَبِی رَافِعٍ قَالَ: کَانَ عُمَرُ یَقْرَأُ فِی صَلاَۃِ الصُّبْحِ بِمِئَۃٍ مِنَ الْبَقَرَۃِ، وَیُتْبِعُہَا بِسُورَۃٍ مِنَ الْمَثَانِی، أَوْ مِنْ صُدُورِ الْمُفَصَّلِ، وَیَقْرَأُ بِمِئَۃٍ مِنْ آلِ عِمْرَانَ، وَیُتْبِعُہَا بِسُورَۃٍ مِنَ الْمَثَانِی، أَوْ مِنْ صُدُورِ الْمُفَصَّلِ۔","Sahih","Musannaf Ibn Abi Shaybah 3583","","","كتاب الصلوات"
"3584","(۳۵۸۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ، عَنْ حُصَیْنِ بْنِ سَبْرَۃَ، قَالَ: صَلَّیْت خَلْفَ عُمَرَ، فَقَرَأَ فِی الرَّکْعَۃِ الأَولَی بِسُورَۃِ یُوسُفَ، ثُمَّ قَرَأَ فِی الثَّانِیَۃِ بِالنَّجْمِ، فَسَجَدَ، ثُمَّ قَامَ فَقَرَأَ: {إذَازُلْزِلَتِ الأَرض} ثُمَّ رَکَعَ۔","Sahih","Musannaf Ibn Abi Shaybah 3584","","","كتاب الصلوات"
"3585","(۳۵۸۵) حَدَّثَنَا ابْنُ عُیینَّۃَ، عَنْ إسْمَاعِیلَ بْنِ مُحَمَّدٍ بْنِ سَعْدٍ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ، قَالَ: سَمِعْتُ نَشِیجَ عُمَرَ nوَأَنَا فِی آخِرِ الصُّفُوفِ فِی صَلاَۃِ الصُّبْحِ وَہُوَ یَقْرَأُ: {إنَّمَا أَشْکُو بَثِّی وَحُزْنِی إلَی اللہِ}۔","Sahih","Musannaf Ibn Abi Shaybah 3585","","","كتاب الصلوات"
"3586","(۳۵۸۶) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنِ ابْنِ جُرَیْجٍ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ، عَنْ عَلْقَمَۃَ بْنِ وَقَّاصٍ، قَالَ: سَمِعْتُ عُمَرَ ؛ ثُمَّ ذَکَرَ نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 3586","","","كتاب الصلوات"
"3587","(۳۵۸۷) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ مُغِیرَۃَ، عَنْ أَبِی حَمْزَۃَ الأَعْوَرِ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ صَلَّی بِہِمْ یَوْمَ جُمُعَۃٍ الْفَجْرَ، فَقَرَأَ بِـ: (کہیعص)۔","","Musannaf Ibn Abi Shaybah 3587","","","كتاب الصلوات"
"3588","(۳۵۸۸) حَدَّثَنَا ہُشَیْمٌ، عَنْ مَنْصُورٍ، عَنْ أَبِی بِشْرٍ الْہُجَیْمِیِّ، عَنْ أَبِی الصِّدِّیق، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ، قَالَ: کُنَّا نَحْزُرُ قِیَامَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الظُّہْرِ وَالْعَصْرِ، فَحَزَرْنَا قِیَامَہُ فِی الظُّہْرِ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ بِقَدْرِ ثَلاَثِینَ آیَۃً، وَحَزَرْنَا قِیَامَہُ فِی الرَّکْعَتَیْنِ الأُخْرَیَیْنِ عَلَی النِّصْفِ مِنْ ذَلِکَ، وَحَزَرْنَا قِیَامَہُ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ مِنَ الْعَصْرِ عَلَی قَدْرِ الأُخْرَیَیْنِ مِنَ الظُّہْرِ، وَحَزَرْنَا قِیَامَہُ فِی الأُخْرَیَیْنِ مِنَ الْعَصْرِ عَلَی النِّصْفِ مِنْ ذَلِکَ۔ (ابوداؤد ۸۰۰۔ احمد ۳/۲)","Sahih","Musannaf Ibn Abi Shaybah 3588","","","كتاب الصلوات"
"3589","(۳۵۸۹) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ، عَنْ شُعْبَۃَ، عَنْ سِمَاکٍ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی الظُّہْرِ بِـ: {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} وَفِی الصُّبْحِ بِأَطْوَلَ مِنْ ذَلِکَ۔ n(مسلم ۳۳۸۔ احمد ۵/۸۶)","Hasan","Musannaf Ibn Abi Shaybah 3589","","","كتاب الصلوات"
"3590","(۳۵۹۰) حَدَّثَنَا أَبُو دَاوُدَ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ، عَنْ سِمَاکِ بْنِ حَرب، عَنْ جَابِرِ بْنِ سَمُرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی الظُّہْرِ وَالْعَصْرِ بِـ: {السَّمَائِ وَالطَّارِقِ} ، وَ {وَالسَّمَائِ ذَاتِ الْبُرُوجِ}۔n(طیالسی ۷۷۴۔ ابن حبان ۱۸۲۷)","Hasan","Musannaf Ibn Abi Shaybah 3590","","","كتاب الصلوات"
"3591","(۳۵۹۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ، قَالَ: حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ، عَنْ عَبْدِ اللہِ بْنِ أَبِی قَتَادَۃَ، عَنْ أَبِیہِ، قَالَ: کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْرَأُ بِنَا فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ مِنَ الظُّہْرِ، یُطِیلُ فِی الأُولَی وَیُقَصِّرُ فِی الثَّانِیَۃِ، وَکَانَ یَفْعَلُ ذَلِکَ فِی صَلاَۃِ الصُّبْحِ، یُطِیلُ فِی الأُولَی وَیُقَصِّرُ فِی الثَّانِیَۃِ، وَکَانَ یَقْرَأُ بِنَا فِی الرَّکْعَتَیْنِ مِنَ الْعَصْرِ۔ (بخاری ۷۵۹۔ مسلم ۳۳۳)","Sahih","Musannaf Ibn Abi Shaybah 3591","","","كتاب الصلوات"
"3592","(۳۵۹۲) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ زَیْدٍ الْعَمِّیِّ، عَنْ أَبِی الْعَالِیَۃِ، قَالَ: حزَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قِرَائَتَہُ فِی الظُّہْرِ نَحْوًا مِنْ (أَلم تَنْزِیلُ)۔","Da'if","Musannaf Ibn Abi Shaybah 3592","","","كتاب الصلوات"
"3593","(۳۵۹۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ عَلِیِّ بْنِ زَیْدِ بْنِ جُدْعَانَ، عَنْ أَبِی عُثْمَانَ النَّہْدِیِّ، قَالَ: سَمِعْتُ مِنْ عُمَرَ نَغْمَۃً مِنْ (ق) فِی صَلاَۃِ الظُّہْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 3593","","","كتاب الصلوات"
"3594","(۳۵۹۴) حَدَّثَنَا وَکِیعٌ، عَنْ إسْمَاعِیلَ بْنِ مُسْلِمٍ، عَنْ أَبِی الْمُتَوَکِّلِ النَّاجِی ؛ أَنَّ عُمَرَ قَرَأَ فِی الظُّہْرِبِـ: {ق}، {وَالذَّارِیَاتِ}۔","","Musannaf Ibn Abi Shaybah 3594","","","كتاب الصلوات"
"3595","(۳۵۹۵) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ، عَنْ حُمَیْدٍ، قَالَ: صَلَّیْت خَلْفَ أَنَسٍ الظُّہْرَ، فَقَرَأَ بِـ: {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ، وَجَعَلَ یُسْمِعُنَا الآیَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 3595","","","كتاب الصلوات"
"3596","(۳۵۹۶) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ ہِشَامٍ، عَنْ جَمِیلِ بْنِ مُرَّۃَ، عَنْ مُوَرِّقٍ الْعِجْلِیّ، قَالَ: صَلَّیْت خَلْفَ ابْنِ عُمَرَ الظُّہْرَ، فَقَرَأَ بِسُورَۃِ مَرْیَمَ۔","Sahih","Musannaf Ibn Abi Shaybah 3596","","","كتاب الصلوات"
"3597","(۳۵۹۷) حَدَّثَنَا وَکِیعٌ، عَنْ سَیْفٍ، عَنْ مُجَاہِدٍ، قَالَ: سَمِعْتُ عَبْدَ اللہِ بْنَ عَمْرو یَقْرَأُ فِی الظُّہْرِ بِـ: {کہیعص}","Sahih","Musannaf Ibn Abi Shaybah 3597","","","كتاب الصلوات"
"3598","(۳۵۹۸) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ، قَالَ: إنِّی لأَقْرَأُ فِی الظُّہْرِ بـ: {الصَّافَّاتِ}۔","","Musannaf Ibn Abi Shaybah 3598","","","كتاب الصلوات"
"3599","(۳۵۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ، قَالَ: حدَّثَنَا مِسْعَرٌ، عَنْ حَمَّادٍ، قَالَ: الْقِرَائَۃُ فِی الظُّہْرِ وَالْفَجْرِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 3599","","","كتاب الصلوات"
"3600","(۳۶۰۰) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ حَمَّادٍ، قَالَ: تُعْدلُ الظُّہْرُ بِالْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 3600","","","كتاب الصلوات"
"3601","(۳۶۰۱) حَدَّثَنَا وَکِیعٌ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ، عَنْ عُقْبَۃَ بْنِ نَافِعٍ، قَالَ: سَمِعْتُ ابْنَ عُمَرَ یَہْمِسُ بِالْقِرَائَۃِ فِی الظُّہْرِ وَالْعَصْرِ۔","Majhul","Musannaf Ibn Abi Shaybah 3601","","","كتاب الصلوات"
"3602","(۳۶۰۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنْ زُرَارَۃَ بْنِ أَوْفَی، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی الظُّہْرَ، فَلَمَّا سَلَّمَ قَالَ: ہَلْ قَرَأَ أَحَدٌ مِنْکُمْ بِـ: {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ؟ فَقَالَ رَجُلٌ مِنَ الْقَوْمِ: أَنَا، فَقَالَ: قَدْ عَلِمْتُ أَنَّ بَعْضَکُمْ خَالَجَنِیہَا۔ (مسلم ۲۹۹۔ ابوداؤد ۸۲۵)","Sahih","Musannaf Ibn Abi Shaybah 3602","","","كتاب الصلوات"
"3603","(۳۶۰۳) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ وَسُفْیَانَ، عَنْ زِیَادِ بْنِ فَیَّاضٍ، عَنْ إبْرَاہِیمَ، قَالَ: الْعَصْرُ وَالْمَغْرِبُ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 3603","","","كتاب الصلوات"
"3604","(۳۶۰۴) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مُغِیرَۃَ، عَنْ شِبَاکٍ، عَنْ إبْرَاہِیمَ، قَالَ: تُضَاعَفُ الظُّہْرُ عَلَی الْعَصْرِ أَرْبَعَ مِرَار۔","","Musannaf Ibn Abi Shaybah 3604","","","كتاب الصلوات"
"3605","(۳۶۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَعْدِلُونَ الظُّہْرَ بِالْعِشَائِ ، وَالْعَصْرَ بِالْمَغْرِبِ۔","","Musannaf Ibn Abi Shaybah 3605","","","كتاب الصلوات"
"3606","(۳۶۰۶) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ سِمَاکِ بْنِ حَرْبٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی الظُّہْرِ وَالْعَصْرِ بِـ : {السَّمَائِ وَالطَّارِقِ} ، {وَالسَّمَائِ ذَاتِ الْبُرُوجِ}۔","Hasan","Musannaf Ibn Abi Shaybah 3606","","","كتاب الصلوات"
"3607","(۳۶۰۷) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُسَوِّی بَیْنَ رَکَعَاتِ الظُّہْرِ وَالْعَصْرِ۔","","Musannaf Ibn Abi Shaybah 3607","","","كتاب الصلوات"
"3608","(۳۶۰۸) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ الرَّازِیّ ، عَنْ أَبِی جَعْفَرٍ، عَنْ أَبِی الرَّبِیعِ، عَنْ أَبِی الْعَالِیَۃِ، قَالَ: الْعَصْرُ عَلَی النِّصْفِ مِنَ الظُّہْرِ۔","","Musannaf Ibn Abi Shaybah 3608","","","كتاب الصلوات"
"3609","(۳۶۰۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ مُحَمَّدِ بْنِ جُبَیْرِ بْنِ مُطْعِمٍ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْرَأُ فِی الْمَغْرِبِ بِـ : {الطُّورِ}۔ (بخاری ۸۶۵۔ مسلم ۱۷۴)","Sahih","Musannaf Ibn Abi Shaybah 3609","","","كتاب الصلوات"
"3610","(۳۶۱۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عَبْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ أُمِّہِ ؛ أَنَّہَا سَمِعَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْرَأُ فِی الْمَغْرِبِ : {وَالْمُرْسَلاَتِ}۔ (بخاری ۷۶۳۔ مسلم ۳۳۸)","Sahih","Musannaf Ibn Abi Shaybah 3610","","","كتاب الصلوات"
"3611","(۳۶۱۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ زَیْدٍ ، أَوْ أَبِی أَیُّوبَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ فِی الْمَغْرِبِ بِالأَعْرَافِ فِی الرَّکْعَتَیْنِ جَمِیعًا۔ (بخاری ۸۶۴۔ احمد ۵/۱۸۵)","Sahih","Musannaf Ibn Abi Shaybah 3611","","","كتاب الصلوات"
"3612","(۳۶۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ فِی الْمَغْرِبِ بـ : {التِّینِ وَالزَّیْتُونِ}۔ (طحاوی ۲۱۴)","Da'if","Musannaf Ibn Abi Shaybah 3612","","","كتاب الصلوات"
"3613","(۳۶۱۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : صَلَّی بِنَا عُمَرُ صَلاَۃَ الْمَغْرِبِ ، فَقَرَأَ فِی الرَّکْعَۃِ الأَولَی بـ : {التِّینِ وَالزَّیْتُونِ} ، وَفِی الرَّکْعَۃِ الثَّانِیَۃِ : {أَلَمْ تَرَ کَیْفَ فَعَلَ رَبُّک بِأَصْحَابِ الْفِیلِ}، وَ {لإِیلاَفِ قُرَیْشٍ}۔","","Musannaf Ibn Abi Shaybah 3613","","","كتاب الصلوات"
"3614","(۳۶۱۴) حَدَّثَنَا شَرِیکٌ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، قَالَ : أَقْرَأَنِی أَبُو مُوسَی کِتَابَ عُمَرَ : أَنِ اقْرَأْ بِالنَّاسِ فِی الْمَغْرِبِ بِآخِرِ الْمُفَصَّلِ۔","Da'if","Musannaf Ibn Abi Shaybah 3614","","","كتاب الصلوات"
"3615","(۳۶۱۵) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ قُرَّۃَ ، عَنِ النَّزَّالِ بْنِ عَمَّارٍ ، قَالَ : حدَّثَنِی أَبُو عُثْمَانَ النَّہْدِیُّ ، قَالَ : صَلَّی بِنَا أَبُو مَسْعُودٍ الْمَغْرِبَ فَقَرَأَ : (قُلْ ہُوَ اللَّہُ أَحَدٌ) فَوَدِدْت أَنَّہُ کَانَ قَرَأَ سُورَۃَ الْبَقَرَۃِ ، مِنْ حُسْنِ صَوْتِہِ۔","Majhul","Musannaf Ibn Abi Shaybah 3615","","","كتاب الصلوات"
"3616","(۳۶۱۶) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ خَالِدٍ، عَنْ عَبْدِاللہِ بْنِ [corrupt]لْحَارِثِ؛ أَنَّ ابْنَ عَبَّاسٍ قَرَأَ الدُّخَانَ فِی الْمَغْرِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 3616","","","كتاب الصلوات"
"3617","(۳۶۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی نَوْفَلِ بْنِ أَبِی عَقْرَبٍ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: سَمِعْتُہُ یَقْرَأُ فِی الْمَغْرِبِ {إذَا جَائَ نَصْرُ اللہِ وَالْفَتْحُ}۔","Sahih","Musannaf Ibn Abi Shaybah 3617","","","كتاب الصلوات"
"3618","(۳۶۱۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقْرَأُ بِـ : (قٓ) فِی الْمَغْرِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 3618","","","كتاب الصلوات"
"3619","(۳۶۱۹) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ قَرَأَ مَرَّۃً فِی الْمَغْرِبِ بِـ : (یٰسٓ)۔","Sahih","Musannaf Ibn Abi Shaybah 3619","","","كتاب الصلوات"
"3620","(۳۶۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ قَرَأَ فِی الْمَغْرِبِ بِـ: (یَسِ)، وَ(عَمَّ یَتَسَائَلُونَ)۔","Da'if","Musannaf Ibn Abi Shaybah 3620","","","كتاب الصلوات"
"3621","(۳۶۲۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ عِمْرَانُ بْنُ حُصَیْنٍ یَقْرَأُ فِی الْمَغْرِبِ {إذَا زُلْزِلَتِ الأَرْضُ} وَ(الْعَادِیَاتِ)۔","Sahih","Musannaf Ibn Abi Shaybah 3621","","","كتاب الصلوات"
"3622","(۳۶۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ یَقْرَأُ فِی الْمَغْرِبِ مَرَّۃً {تُنَبِّیئُ أَخْبَارَہَا} وَمَرَّۃً {تُحَدِّثُ أَخْبَارَہَا}۔","","Musannaf Ibn Abi Shaybah 3622","","","كتاب الصلوات"
"3623","(۳۶۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحِلٍّ، قَالَ: سَمِعْتُ إبْرَاہِیمَ یَقْرَأُ فِی الرَّکْعَۃِ الأَولَی مِنَ الْمَغْرِبِ {لإِیلاَفِ قُرَیْشٍ}۔","","Musannaf Ibn Abi Shaybah 3623","","","كتاب الصلوات"
"3624","(۳۶۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، قَالَ : کَانَ الْحَسَنْ یَقْرَأُ فِی الْمَغْرِبِ : (إذَا زُلْزِلَت) (وَالْعَادِیَاتِ) لاَ یَدَعُہَا۔","","Musannaf Ibn Abi Shaybah 3624","","","كتاب الصلوات"
"3625","(۳۶۲۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سَعِیدِ بْنِ مَسْرُوقٍ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : أَمَّ مُعَاذٌ قَوْمًا فِی صَلاَۃِ الْمَغْرِبِ ، فَمَرَّ بِہِ غُلاَمٌ مِنَ الأَنْصَارِ وَہُوَ یَعْمَلُ عَلَی بَعِیرٍ لَہُ ، فَأَطَالَ بِہِمْ مُعَاذٌ ، فَلَمَّا رَأَی ذَلِکَ الْغُلاَمُ تَرَکَ الصَّلاَۃَ وَانْطَلَقَ فِی طَلَبِ بَعِیرِہِ ، فَرُفِعَ ذَلِکَ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ: أَفَتَّانٌ أَنْتَ یَامُعَاذُ؟ أَلاَّ یَقْرَأُ أَحَدُکُمْ فِی الْمَغْرِبِ بِـ: {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} وَ {الشَّمْسِ وَضُحَاہَا}۔n(بخاری ۷۰۵۔ مسلم ۱۷۸)","Sahih","Musannaf Ibn Abi Shaybah 3625","","","كتاب الصلوات"
"3626","(۳۶۲۶) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ نُسَیْرِ بْنِ ذُعْلُوقٍ ، عَنِ الرَّبِیعِ بْنِ خُثَیْمٍ ؛ أَنَّہُ کَانَ یَقْرَأُ فِی الْمَغْرِبِ بِقِصَارِ الْمُفَصَّلِ : {قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، وَ {قُلْ ہُوَ اللَّہُ أَحَدٌ}۔","","Musannaf Ibn Abi Shaybah 3626","","","كتاب الصلوات"
"3627","(۳۶۲۷) حَدَّثَنَا یَزِیدُ بْنُ حُبَابٍ ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَقْرَأُ فِی الْمَغْرِبِ بِقِصَارِ الْمُفَصَّلِ۔","","Musannaf Ibn Abi Shaybah 3627","","","كتاب الصلوات"
"3628","(۳۶۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْرَأُ فِی الْعِشَائِ : {وَالتِّینِ وَالزَّیْتُونِ}۔ (بخار ی۷۶۷۔ مسلم ۱۷۵)","Sahih","Musannaf Ibn Abi Shaybah 3628","","","كتاب الصلوات"
"3629","(۳۶۲۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : أَمَّنَا عَبْدُ اللہِ فِی الْعِشَائِ الآخِرَۃِ ، فَافْتَتَحَ الأَنْفَالَ حَتَّی بَلَغَ : {فَاعْلَمُوا أَنَّ اللَّہَ مَوْلاَکُمْ نِعْمَ الْمَوْلَی وَنِعْمَ النَّصِیرُ} رَکَعَ ، ثُمَّ قَامَ فَقَرَأَ فِی الثَّانِیَۃِ بِسُورَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 3629","","","كتاب الصلوات"
"3630","(۳۶۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ ؛ مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 3630","","","كتاب الصلوات"
"3631","(۳۶۳۱) حَدَّثَنَا شَرِیکٌ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، قَالَ : أَقْرَأَنِی أَبُو مُوسَی کِتَابَ عُمَرَ إلَیْہِ : أَنِ اقْرَأْ بِالنَّاسِ فِی الْعِشَائِ بِوَسَطِ الْمُفَصَّلِ۔","Da'if","Musannaf Ibn Abi Shaybah 3631","","","كتاب الصلوات"
"3632","(۳۶۳۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَلِیِّ بْنِ زَیْدِ بْنِ جُدْعَانَ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ مَسْرُوقِ بْنِ الأَجْدَعِ ؛ أَنَّ عُثْمَانَ قَرَأَ فِی الْعِشَائِ ، یَعْنِی الْعَتَمَۃَ بِـ : (النَّجْمِ) ، ثُمَّ سَجَدَ ، ثُمَّ قَامَ فَقَرَأَ بِـ : (التِّینِ وَالزَّیْتُونِ)۔","Da'if","Musannaf Ibn Abi Shaybah 3632","","","كتاب الصلوات"
"3633","(۳۶۳۳) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عَبَّادِ بْنِ عَبَّادٍ ، قَالَ : حدَّثَنِی ہِلاَلٌ ؛ أَنَّہُ سَمِعَ أَبَا ہُرَیْرَۃَ یَقْرَأُ {وَالْعَادِیَاتِ ضَبْحًا} فِی الْعِشَائِ۔","Hasan","Musannaf Ibn Abi Shaybah 3633","","","كتاب الصلوات"
"3634","(۳۶۳۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ کَانَ یَقْرَأُ فِی الْعِشَائِ بِـ : {اَلَّذِینَ کَفَرُوا} وَ (الْفَتْحِ)۔","Sahih","Musannaf Ibn Abi Shaybah 3634","","","كتاب الصلوات"
"3635","(۳۶۳۵) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَقْرَأُ فِی الْعِشَائِ بِـ : (تَنْزِیلِ) السَّجْدَۃِ، فَیَرْکَعُ بِہَا۔","","Musannaf Ibn Abi Shaybah 3635","","","كتاب الصلوات"
"3636","(۳۶۳۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ عَلِیِّ بْنِ سُوَیْد بْنِ مَنْجُوفٍ ، قَالَ : حدَّثَنَا أَبُو رَافِعٍ ، قَالَ : صَلَّیْت مَعَ عُمَرَ الْعِشَائَ فَقَرَأَ : {إذَا السَّمَائُ انْشَقَّتْ}۔","Sahih","Musannaf Ibn Abi Shaybah 3636","","","كتاب الصلوات"
"3637","(۳۶۳۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : أَخْبَرَنِی الضَّحَّاکُ بْنُ عُثْمَانَ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَقْرَأُ فِی الْعِشَائِ بِوَسَطِ الْمُفَصَّلِ۔","","Musannaf Ibn Abi Shaybah 3637","","","كتاب الصلوات"
"3638","(۳۶۳۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ مَحْمُودِ بْنِ رَبِیعٍ ، عَنْ عُبَادَۃَ بْنِ الصَّامِتِ یَبْلُغُ بِہِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ قَالَ : لاَ صَلاَۃَ لِمَنْ لَمْ یَقْرَأْ بِفَاتِحَۃِ الْکِتَابِ۔ (بخاری ۷۵۶۔ ابوداؤد ۸۱۸)","Sahih","Musannaf Ibn Abi Shaybah 3638","","","كتاب الصلوات"
"3639","(۳۶۳۹) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الْعَلاَئِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ یَعْقُوبَ ؛ أَنَّ أَبَا السَّائِبِ أَخْبَرَہُ ، أَنَّہُ سَمِعَ أَبَا ہُرَیْرَۃَ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَلَّی صَلاَۃً لَمْ یَقْرَأْ فِیہَا بِفَاتِحَۃِ الْکِتَابِ فَہِیَ خِدَاجٌ ، ہِیَ خِدَاجٌ ، ہِیَ خِدَاجٌ غَیْرُ تَمَامٍ۔ (مسلم ۲۹۶۔ ابوداؤد ۸۱۷)","Sahih","Musannaf Ibn Abi Shaybah 3639","","","كتاب الصلوات"
"3640","(۳۶۴۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ یَحْیَی بْنِ عَبَّادِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : کُلُّ صَلاَۃٍ لاَ یُقْرَأُ فِیہَا بِفَاتِحَۃِ الْکِتَابِ فَہِیَ خِدَاجٌ۔","Hasan","Musannaf Ibn Abi Shaybah 3640","","","كتاب الصلوات"
"3641","(۳۶۴۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْوَلِیدِ بْن أَبِی ہِشَامٍ ، عَنْ وَہْبِ بْنِ کَیْسَانَ ، قَالَ : قَالَ جَابِرُ بْنُ عَبْدِ اللہِ : مَنْ لَمْ یَقْرَأْ فِی کُلِّ رَکْعَۃٍ بِأُمِّ الْقُرْآنِ فَلَمْ یُصَلِّ ، إِلاَّ خَلْفَ الإِمَام۔","Sahih","Musannaf Ibn Abi Shaybah 3641","","","كتاب الصلوات"
"3642","(۳۶۴۲) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیرِیِّ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : لاَ تَجُوزُ صَلاَۃٌ لاَ یُقْرَأُ فِیہَا بِفَاتِحَۃِ الْکِتَابِ وَآیَتَیْنِ فَصَاعِدًا۔","Sahih","Musannaf Ibn Abi Shaybah 3642","","","كتاب الصلوات"
"3643","(۳۶۴۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدِ بْنِ یَزِیدَ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ؛ فِی کُلِّ صَلاَۃٍ قِرَائَۃُ قُرْآنٍ ، أُمُّ الْکِتَابِ فَمَا زَادَ۔","Sahih","Musannaf Ibn Abi Shaybah 3643","","","كتاب الصلوات"
"3644","(۳۶۴۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ ، عَنْ عَبَایَۃَ بْنِ رِبْعِیٍّ ، قَالَ : قَالَ عُمَرُ : لاَ تُجْزِیئُ صَلاَۃٌ لاَ یُقْرَأُ فِیہَا بِفَاتِحَۃِ الْکِتَابِ وَآیَتَیْنِ فَصَاعِدًا۔","Hasan","Musannaf Ibn Abi Shaybah 3644","","","كتاب الصلوات"
"3645","(۳۶۴۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : جَلَسْت إلَی رَہْطٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنَ الأَنْصَارِ ، فَذَکَرُوا الصَّلاَۃَ وَقَالُوا : لاَ صَلاَۃَ إِلاَّ بِقِرَائَۃٍ وَلَوْ بِأُمِّ الْکِتَابِ ، قَالَ خَالِدٌ : فَقُلْتُ لِعَبْدِ اللہِ بْنِ الْحَارِثِ : ہَلْ تُسَمِّی مِنْہُمْ أَحَدًا ؟ قَالَ : نَعَمْ ، خَوَّاتُ بْنُ جُبَیْرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 3645","","","كتاب الصلوات"
"3646","(۳۶۴۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا لَمْ یَقْرَأْ فِی کُلِّ رَکْعَۃٍ بِفَاتِحَۃِ الْکِتَابِ ، فَإِنَّہُ یُعِیدُ تِلْکَ الرَّکْعَۃَ۔","","Musannaf Ibn Abi Shaybah 3646","","","كتاب الصلوات"
"3647","(۳۶۴۷) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ مُحَمَّدِ بْنِ الْحَکَمِ ؛ أَنَّ أَبَا وَائِلٍ قَرَأَ بِفَاتِحَۃِ الْکِتَابِ وَآیَۃٍ ، ثُمَّ رَکَعَ۔","","Musannaf Ibn Abi Shaybah 3647","","","كتاب الصلوات"
"3648","(۳۶۴۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : تُجْزِیئُ فَاتِحَۃُ الْکِتَابِ ، قَالَ : فَلَقِیتُہُ بَعْدُ ، فَقُلْتُ : فِی الْفَرِیضَۃِ ؟ فَقَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 3648","","","كتاب الصلوات"
"3649","(۳۶۴۹) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنِ الْمُغِیرَۃِ ، عَنْ إبْرَاہِیمَ ، قَالَ : تُجْزِیئُ فَاتِحَۃُ الْکِتَابِ فِی الْفَرِیضَۃِ وَغَیْرِہَا۔","","Musannaf Ibn Abi Shaybah 3649","","","كتاب الصلوات"
"3650","(۳۶۵۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی الْعَالِیَۃِ الْبَرَّائِ ، قَالَ : قُلْتُ لابْنِ عُمَرَ : أَفِی کُلِّ رَکْعَۃٍ أَقْرَأُ ؟ فَقَالَ : إنِّی لأَسْتَحِیی مِنْ رَبِّ ہَذَا الْبَیْتِ أَنْ لاَ أَقْرَأَ فِی کُلِّ رَکْعَۃٍ بِفَاتِحَۃِ الْکِتَابِ ، وَمَا تَیَسَّرَ ۔ وَسَأَلْت ابْنَ عَبَّاسٍ ؟ فَقَالَ : ہُوَ إمَامُک ، فَإِنْ شِئْتَ فَأَقِلَّ مِنْہُ ، وَإِنْ شِئْتَ فَأَکْثِر۔","Sahih","Musannaf Ibn Abi Shaybah 3650","","","كتاب الصلوات"
"3651","(۳۶۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنِ الْوَلِیدِ بْنِ یَحْیَی ، عَنْ جَابِرِ بْنِ زَیْدٍ ؛ أَنَّہُ قَرَأَ : {مُدْہَامَّتَانِ} ، ثُمَّ رَکَعَ۔","","Musannaf Ibn Abi Shaybah 3651","","","كتاب الصلوات"
"3652","(۳۶۵۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی سُفْیَانَ السَّعْدِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ صَلاَۃَ لِمَنْ لَمْ یَقْرَأْ فِی کُلِّ رَکْعَۃٍ بِـ : (الْحَمْدُ لِلَّہِ) وَسُورَۃٍ فِی الْفَرِیضَۃِ وَغَیْرِہَا۔n(ترمذی ۲۳۸۔ ابن ماجہ ۸۳۹)","Da'if","Musannaf Ibn Abi Shaybah 3652","","","كتاب الصلوات"
"3653","(۳۶۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ یَزِیدَ الْفَقِیرِ ، عَنْ جَابِرٍ ، قَالَ : کُنَّا نَتَحَدَّثُ ، أَنَّہُ لاَ صَلاَۃَ إِلاَّ بِقِرَائَۃِ فَاتِحَۃِ الْکِتَابِ فَمَا زَادَ۔","Sahih","Musannaf Ibn Abi Shaybah 3653","","","كتاب الصلوات"
"3654","(۳۶۵۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الحَسَن ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : تُجْزِیئُ فَاتِحَۃُ الْکِتَابِ فِی التَّطَوُّعِ۔","","Musannaf Ibn Abi Shaybah 3654","","","كتاب الصلوات"
"3655","(۳۶۵۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، عَنْ أَبِی مَعْمَرٍ ، قَالَ : قلْنَا لِخَبَّابٍ : بِأَیِّ شَیْئٍ کُنْتُمْ تَعْرِفُونَ قِرَائَۃَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الظُّہْرِ وَالْعَصْرِ ؟ قَالَ : بِاضْطِرَابِ لِحْیَتِہِ ، وَقَالَ أَبُو مُعَاوِیَۃَ : لَحْیَیْہِ۔ (بخاری ۷۷۷۔ ابوداؤد ۷۹۷)","Sahih","Musannaf Ibn Abi Shaybah 3655","","","كتاب الصلوات"
"3656","(۳۶۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزَّعْرَائِ ، عَنْ أَبِی الأَحْوَصِ ، عَمَّنْ سَمِعَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : کَانُوا یَعْرِفُونَ قِرَائَتَہُ فِی الظُّہْرِ وَالْعَصْرِ بِاضْطِرَابِ لِحْیَیْہِ۔ (احمد ۵/۳۷۱)","Sahih","Musannaf Ibn Abi Shaybah 3656","","","كتاب الصلوات"
"3657","(۳۶۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنِ الْحَسَنِ الْعُرَنِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَا أَدْرِی، کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْرَأُ فِی الظُّہْرِ وَالْعَصْرِ ؟ وَلَکِنَّا نَقْرَأُ۔ (ابوداؤد ۸۰۵۔ احمد ۱/۲۴۹)","Hasan","Musannaf Ibn Abi Shaybah 3657","","","كتاب الصلوات"
"3658","(۳۶۵۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حَبِیبِ بْنِ شَہِیدٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : فِی کُلِّ صَلاَۃٍ أَقْرَأُ ، فَمَا أَعْلَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَعْلَنَّا ، وَمَا أَخْفَی أَخْفَیْنَا۔ (بخاری ۷۷۲۔ مسلم ۴۴)","Sahih","Musannaf Ibn Abi Shaybah 3658","","","كتاب الصلوات"
"3659","(۳۶۵۹) حَدَّثَنَا جَرِیرُ بْنِ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ یَحْیَی بْنِ عَبَّادٍ ، قَالَ : کَانَ خَبَّابُ بْنُ الأَرَتِّ یَجْہَرُ بِالْقِرَائَۃِ فِی الظُّہْرِ وَالْعَصْرِ۔","","Musannaf Ibn Abi Shaybah 3659","","","كتاب الصلوات"
"3660","(۳۶۶۰) حَدَّثَنَا وَکِیعٌ، عَنْ کِلاَبِ بْنِ عَمْرٍو، عَنْ عَمِّہِ ، قَالَ: تَعَلَّمْت {إذَا زُلْزِلَتِ الأَرض} خَلْفَ خَبَّابٍ فِی الْعَصْرِ۔","Majhul","Musannaf Ibn Abi Shaybah 3660","","","كتاب الصلوات"
"3661","(۳۶۶۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ سَعِیدَ بْنِ الْعَاصِ صَلَّی بِالنَّاسِ الظُّہْرَ أَوِ الْعَصْرَ ، فَجَہَرَ بِالْقِرَائَۃِ فَسَبَّحَ الْقَوْمُ ، فَمَضَی فِی قِرَائَتِہِ ، فَلَمَّا فَرَغَ صَعِدَ الْمِنْبَرَ ، فَخَطَبَ النَّاسَ ، فَقَالَ : فِی کُلِّ صَلاَۃٍ قِرَائَۃٌ ، وَإِنَّ صَلاَۃَ النَّہَارِ تخرس ، وَإِنِّی کَرِہْت أَنْ أَسْکُتَ ، فَلاَ تَرَوْنَ أَنِّی فَعَلْت ذَلِکَ بِدْعَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 3661","","","كتاب الصلوات"
"3662","(۳۶۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حُسَیْنِ بْنِ عُقَیْلٍ ، عَنْ مُحَمَّدِ بْنِ مُزَاحِمٍ ، قَالَ : صَلَّیْت خَلْفَ سَعِیدِ بْنِ جُبَیْرٍ ، فَکَانَ الصَّفُّ الأَوَّلُ یَفْقَہُونَ قِرَائَتَہُ فِی الظُّہْرِ وَالْعَصْرِ۔","","Musannaf Ibn Abi Shaybah 3662","","","كتاب الصلوات"
"3663","(۳۶۶۳) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ حُمَیْدٍ ، قَالَ : صَلَّیْت خَلْفَ أَنَسٍ الظُّہْرَ ، فَقَرَأَ بِـ: {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} وَجَعَلَ یُسْمِعُنَا الآیَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 3663","","","كتاب الصلوات"
"3664","(۳۶۶۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَلِیِّ بْنِ زَیْدِ بْنِ جُدْعَانَ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : سَمِعْتُ مِنْ عُمَرَ نَغْمَۃً مِنْ (ق) فِی الظُّہْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 3664","","","كتاب الصلوات"
"3665","(۳۶۶۵) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ عَبْدِالرَّحْمَنِ بْنِ الأَسْوَدِ؛ أَنَّ الأَسْوَدَ وَعَلْقَمَۃَ کَانَا یَجْہَرَانِ فِی الظُّہْرِ وَالْعَصْرِ فَلاَ یَسْجُدَانِ۔","","Musannaf Ibn Abi Shaybah 3665","","","كتاب الصلوات"
"3666","(۳۶۶۶) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، قَالَ: سَأَلْتُ الشَّعْبِیَّ ، وَالْحَکَمَ ، وَسَالِمًا وَالْقَاسِمَ ، وَمُجَاہِدًا، وَعَطَائً ؛ عَنِ الرَّجُلِ یَجْہَرُ فِی الظُّہْرِ أَوَ الْعَصْرِ ؟ قَالُوا : لَیْسَ عَلَیْہِ سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 3666","","","كتاب الصلوات"
"3667","(۳۶۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ بَشِیرٍ ، عَنْ قَتَادَۃَ ؛ أَنَّ أَنَسًا جَہَرَ فِی الظُّہْرِ وَالْعَصْرِ ، فَلَمْ یَسْجُدْ۔","Hasan","Musannaf Ibn Abi Shaybah 3667","","","كتاب الصلوات"
"3668","(۳۶۶۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ سُئِلَ عَنِ الرَّجُلِ یَجْہَرُ فِیمَا لاَ یُجْہَرُ فِیہِ ؟ قَالَ : یَسْجُدُ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 3668","","","كتاب الصلوات"
"3669","(۳۶۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا جَہَرَ فِیمَا یُخَافَتُ فِیہِ ، أَوْ خَافَتَ فِیمَا یُجْہَرُ فِیہِ ، فَعَلَیْہِ سَجْدَتَا السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 3669","","","كتاب الصلوات"
"3670","(۳۶۷۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، قَالَ : حدَّثَنَا لَیْثٌ ، عَنْ طَاوُوسٍ ، قَالَ : مَنْ فَاتَہُ شَیْئٌ مِنْ صَلاَۃِ الإِمَامِ ، فَإِنْ شَائَ جَہَرَ ، وَإِنْ شَائَ لَمْ یَجْہَرْ۔","","Musannaf Ibn Abi Shaybah 3670","","","كتاب الصلوات"
"3671","(۳۶۷۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَبِی الْعُمَیْسِ ، قَالَ : قَالَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : اصْنَعُوا مِثْلَ مَا صَنَعَ الإِمَامُ۔","","Musannaf Ibn Abi Shaybah 3671","","","كتاب الصلوات"
"3672","(۳۶۷۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الْعُمَیْسِ ، عَنِ الْمُغِیرَۃِ بْنِ حَکِیمٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ؛نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 3672","","","كتاب الصلوات"
"3673","(۳۶۷۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو قَالَ : فَاتَتْ عُبَیْدَ بْنَ عُمَیْرٍ رَکْعَۃٌ مِنَ الْمَغْرِبِ ، فَسَمِعْتُہُ یَقْرَأُ : {وَاللَّیْلِ إذَا یَغْشَی}۔","Sahih","Musannaf Ibn Abi Shaybah 3673","","","كتاب الصلوات"
"3674","(۳۶۷۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُفَضَّلِ بْنِ مُہَلْہِل ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ لِمَنْ سُبِقَ بِبَعْضِ الصَّلاَۃِ فِی الْفَجْرِ أَوِ الْمَغْرِبِ أَوِ الْعِشَائِ إذَا قَامَ یَقْضِی ، أَنْ یَجْہَرَ بِالْقِرَائَۃِ ، کَیْ یَعْلَمَ مَنْ لاَ یَعْلَمُ أَنَّ الْقِرَائَۃَ فِیمَا یُقْضَی۔","","Musannaf Ibn Abi Shaybah 3674","","","كتاب الصلوات"
"3675","(۳۶۷۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَاصِمٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُصَلِّی الْمَغْرِبَ وَحْدَہُ ، قَالَ : یُسْمِعُ قِرَائَتَہُ أُذُنَیْہِ۔","","Musannaf Ibn Abi Shaybah 3675","","","كتاب الصلوات"
"3676","(۳۶۷۶) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ أَیُّوبَ بْنِ نَجِیحٍ ، قَالَ : کُنْتُ مَعَ سَعِیدِ بْنِ جُبَیْرٍ ، فَقُمْنَا إلَی الْمَغْرِبِ وَقَدْ سُبِقْنَا بِرَکْعَۃٍ ، فَلَمَّا قَامَ سَعِیدٌ یَقْضِی قَرَأَ بِـ : { أَلْہَاکُمُ التَّکَاثُرُ} ۔","","Musannaf Ibn Abi Shaybah 3676","","","كتاب الصلوات"
"3677","(۳۶۷۷) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، عَنْ عَبِیْدَۃَ ؛ فِی الْقِرَائَۃِ فِی صَلاَۃِ النَّہَارِ ، أَسْمِعْ نَفْسَک۔","","Musannaf Ibn Abi Shaybah 3677","","","كتاب الصلوات"
"3678","(۳۶۷۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبِیْدَۃَ (ح) وَعَنْ لَیْثٍ ، عَنِ ابْنِ سَابِطٍ ، قَالاَ : أَدْنَی مَا یُقْرَأُ الْقُرْآنُ أَنْ تُسْمِعَ أُذُنَیْک۔","","Musannaf Ibn Abi Shaybah 3678","","","كتاب الصلوات"
"3679","(۳۶۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : صَلَّیْت إلَی جَنْبِ عَبْدِ اللہِ بِالنَّہَارِ ، فَلَمْ أَدْرِ أَیَّ شَیْئٍ قَرَأَ ، حَتَّی انْتَہَی إلَی قَوْلِہِ : {رَبِّ زِدْنِی عِلْمًا} فَظَنَنْت أَنَّہُ یَقْرَأُ فِی طَہ۔","Sahih","Musannaf Ibn Abi Shaybah 3679","","","كتاب الصلوات"
"3680","(۳۶۸۰) حَدَّثَنَا حَفْصٌ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : حدَّثَنِی مَنْ صَلَّی خَلْفَ ابْنِ مَسْعُودٍ ، فَذَکَرَ نَحْوًا مِنْ حَدِیثِ وَکِیعٍ۔","","Musannaf Ibn Abi Shaybah 3680","","","كتاب الصلوات"
"3681","(۳۶۸۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ رَأَی رَجُلاً یَجْہَرُ بِالْقِرَائَۃِ نَہَارًا ، فَدَعَاہُ فَقَالَ : إنَّ صَلاَۃَ النَّہَارِ لاَ یُجْہَرُ فِیہَا ، فَأَسِرَّ قِرَائَتَک۔","Sahih","Musannaf Ibn Abi Shaybah 3681","","","كتاب الصلوات"
"3682","(۳۶۸۲) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، قَالَ : کَانَ ابْنُ سِیرِینَ یَتَطَوَّعُ فَکُنَّا نَسْمَعُ قِرَائَتَہُ ، فَإِذَا قَامَ إلَی الصَّلاَۃِ خَفِیَ عَلَیْنَا مَا یَقْرَأُ۔","","Musannaf Ibn Abi Shaybah 3682","","","كتاب الصلوات"
"3683","(۳۶۸۳) حَدَّثَنَا مُعْتَمِرٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یَتَطَوَّعُ بِالنَّہَارِ فَیُسْمِعُ۔","","Musannaf Ibn Abi Shaybah 3683","","","كتاب الصلوات"
"3684","(۳۶۸۴) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : صَلاَۃُ النَّہَارِ عَجْمَائُ ، وَصَلاَۃُ اللَّیْلِ تُسْمِعُ أُذُنَیْک۔","","Musannaf Ibn Abi Shaybah 3684","","","كتاب الصلوات"
"3685","(۳۶۸۵) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْکَرِیمِ ، قَالَ : صَلَّی رَجُلٌ إلَی جَنْبِ أَبِی عُبَیْدَۃَ فَجَہَرَ بِالْقِرَائَۃِ ، فَقَالَ لَہُ : إنَّ صَلاَۃَ النَّہَارِ عَجْمَائُ ، وَصَلاَۃَ اللَّیْلِ تُسْمِعُ أُذُنَیْک۔","","Musannaf Ibn Abi Shaybah 3685","","","كتاب الصلوات"
"3686","(۳۶۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَجْہَرَ بِالنَّہَارِ فِی التَّطَوُّعِ إذَا کَانَ لاَ یُؤْذِی أَحَدًا۔","","Musannaf Ibn Abi Shaybah 3686","","","كتاب الصلوات"
"3687","(۳۶۸۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : قُمْتُ إلَی جَنْبِ عَبْدِ اللہِ وَہُوَ یُصَلِّی فِی الْمَسْجِدِ ، فَمَا عَلِمْت أَنَّہُ یَقْرَأُ حَتَّی سَمِعْتُہ یَقُولُ: {رَبِّ زِدْنِی عِلْمًا} ، فَعَلِمْت أَنَّہُ یَقْرَأُ فِی سُورَۃِ طَہ۔","Sahih","Musannaf Ibn Abi Shaybah 3687","","","كتاب الصلوات"
"3688","(۳۶۸۸) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ صَلَّی فَرَفَعَ صَوْتَہُ ، فَأَرْسَلَ إلَیْہِ سَعِیدٌ ، أَفَتَّانٌ أَنْتَ أَیُّہَا الرَّجُلُ۔","","Musannaf Ibn Abi Shaybah 3688","","","كتاب الصلوات"
"3689","(۳۶۸۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، قَالَ : قالُوا : یَا رَسُولَ اللہِ ، إنَّ ہَاہُنَا قومًا یَجْہَرُونَ بِالْقِرَائَۃِ بِالنَّہَارِ ؟ فَقَالَ : اُرْمُوہُمْ بِالْبَعْرِ۔ (طبرانی ۳۸۹۶)","","Musannaf Ibn Abi Shaybah 3689","","","كتاب الصلوات"
"3690","(۳۶۹۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْجُرَیرِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أبی عَاصِمِ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : إذَا قَرَأْتَ فَأَسْمِع أُذُنَیْک ، فَإِنَّ الْقَلْبَ عَدْلٌ بَیْنَ اللِّسَانِ وَالأُذُنِ۔","","Musannaf Ibn Abi Shaybah 3690","","","كتاب الصلوات"
"3691","(۳۶۹۱) حَدَّثَنَا مَخْلَدُ بْنُ یَزِیدَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنْ حَکِیمِ بْنِ عِقَالٍ ؛ أَنَّہُ نَہَی عَنْ رَفْعِ الصَّوْتِ بِالْقِرَائَۃِ فِی النَّہَارِ ، وَقَالَ : یَرْفَعُ بِاللَّیْلِ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 3691","","","كتاب الصلوات"
"3692","(۳۶۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ یَحْیَی بْنِ جَعْدۃ ، عَنْ أُمِّ ہَانِیئٍ ، قَالَتْ : کُنْتُ أَسْمَعُ قِرَائَۃَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا عَلَی عَریشِی۔ (ترمذی ۳۱۸۔ احمد ۶/۳۴۱)","Sahih","Musannaf Ibn Abi Shaybah 3692","","","كتاب الصلوات"
"3693","(۳۶۹۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : قالُوا لَہُ : کَیْفَ کَانَتْ قِرَائَۃُ عَبْدِ اللہِ بِاللَّیْلِ ؟ فَقَالَ : کَانَ یُسْمِعُ أَحْیَانًا آلَ عُتْبَۃَ ، قَالَ : وَکَانُوا فِی حُجْرَۃٍ بَیْنَ یَدَیْہِ ، وَکَانَ عَلْقَمَۃُ مِمَّنْ یُبَایِتُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 3693","","","كتاب الصلوات"
"3694","(۳۶۹۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : بِتُّ عِنْدَ عَبْدِ اللہِ ذَاتَ لَیْلَۃٍ ، فَقَالُوا لَہُ : کَیْفَ کَانَتْ قِرَائَتُہُ ؟ قَالَ : کَانَ یُسْمِعُ أَہْلَ الدَّارِ۔","Sahih","Musannaf Ibn Abi Shaybah 3694","","","كتاب الصلوات"
"3695","(۳۶۹۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، قَالَ : کَانَ رَجُلٌ إذَا قَرَأَ جَہَرَ بِقِرَائَتِہِ ، فَفَقَدَہُ مُعَاذٌ ، فَقَالَ : أَیْنَ الَّذِی کَانَ یُوقِظُ الْوَسْنَانَ ؟ وَیَزْجُرُ ، أَوْ یَطْرُدُ ، الشَّیْطَانَ۔","","Musannaf Ibn Abi Shaybah 3695","","","كتاب الصلوات"
"3696","(۳۶۹۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی بَکْرِ بْنِ عَمْرٍو قَالَ : بَاتَتْ بِنَا عَمْرَۃُ لَیْلَۃً ، فَقُمْت أُصَلِّی فَأَخْفَیْتُ صَوْتِی ، فَقَالَتْ : أَلاَ تَجْہَرُ بِقِرَائَتِکَ ؟ فَمَا کَانَ یُوقِظُنَا إِلاَّ صَوْتُ مُعَاذٍ الْقَارِیِٔ ، وَأَفْلَحَ مَوْلَی أَبِی أَیُّوبَ۔","","Musannaf Ibn Abi Shaybah 3696","","","كتاب الصلوات"
"3697","(۳۶۹۷) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُصَلِّی مِنَ اللَّیْلِ ، فَیُسْمِعُ أَہْلَ دَارِہِ۔","","Musannaf Ibn Abi Shaybah 3697","","","كتاب الصلوات"
"3698","(۳۶۹۸) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : صَلاَۃُ اللَّیْلِ ، تُسْمِعُ أُذُنَیْک۔","","Musannaf Ibn Abi Shaybah 3698","","","كتاب الصلوات"
"3699","(۳۶۹۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَلْقَمَۃَ ، قَالَ : صَلَّیْتُ مَعَ عَبْدِ اللہِ لَیْلَۃً کُلَّہَا ، فَکَانَ یَرْفَعُ صَوْتَہُ ، یَقْرَأُ قِرَائَۃً یُسْمِعُ أَہْلَ الْمَسْجِدِ ، یُرَتِّلُ وَلاَ یُرَجِّعُ۔","","Musannaf Ibn Abi Shaybah 3699","","","كتاب الصلوات"
"3700","(۳۷۰۰) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، وَالْحَسَنُ بْنُ عُبَیْدِ اللہِ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَنِ الأَسْوَدِ بْنِ ہِلاَلٍ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ أَسْمَعَ أُذُنَیْہِ فَلَمْ یُخَافِتْ۔","Sahih","Musannaf Ibn Abi Shaybah 3700","","","كتاب الصلوات"
"3701","(۳۷۰۱) حَدَّثَنَا حَفْصٌ ، عَنْ عِمْرَانَ بْنِ زَائِدَۃَ بْنِ نَشِیطٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی خَالِدٍ الْوَالِبِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا قَامَ مِنَ اللَّیْلِ یَخْفِضُ طَوْرًا ، وَیَرْفَعُ طَوْرًا۔ n(ابوداؤد ۱۳۲۲۔ ابن حبان ۲۶۰۳)","Hasan","Musannaf Ibn Abi Shaybah 3701","","","كتاب الصلوات"
"3702","(۳۷۰۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنِ الْمَعْرُورِ بْنِ سُوَیْد ، قَالَ : خَرَجْنَا مَعَ عُمَرَ حُجَّاجًا ، فَصَلَّی بِنَا الْفَجْرَ فَقَرَأ بِـ : (أَلَمْ تَرَ) ، وَ(لإِیلاَفِ)۔","Sahih","Musannaf Ibn Abi Shaybah 3702","","","كتاب الصلوات"
"3703","(۳۷۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ غِیلاَنَ بْنِ جَامِعٍ الْمُحَارِبِیِّ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : صَلَّی بِنَا عُمَرُ الْفَجْرَ فِی السَّفَرِ ، فَقَرَأَ بِـ : {قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، وَ {قُلْ ہُوَ اللَّہُ أَحَدٌ}۔","Sahih","Musannaf Ibn Abi Shaybah 3703","","","كتاب الصلوات"
"3704","(۳۷۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْرَؤُونَ فِی السَّفَرِ بِالسُّوَرِ الْقِصَارِ۔","","Musannaf Ibn Abi Shaybah 3704","","","كتاب الصلوات"
"3705","(۳۷۰۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ دَاوُدَ ، قَالَ : خَرَجْت مَعَ أَنَسٍ ، فَکَانَ یَقْرَأُ بِنَا فِی الْفَجْرِ بِـ: {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} وَأَشْبَاہِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 3705","","","كتاب الصلوات"
"3706","(۳۷۰۶) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ ، عَنْ مُحَمَّدِ بْنِ الْحَکَمِ ، عَنْ أَبِی وَائِلٍ ، قَالَ : صَلَّی بِنَا ابْنُ مَسْعُودٍ الْفَجْرَ فِی السَّفَرِ ، فَقَرَأَ بِآخِرِ بَنِی إسْرَائِیلَ : {الْحَمْدُ لِلَّہِ الَّذِی لَمْ یَتَّخِذْ وَلَدًا} ثُمَّ رَکَعَ۔","Hasan","Musannaf Ibn Abi Shaybah 3706","","","كتاب الصلوات"
"3707","(۳۷۰۷) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، قَالَ : حَدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ عِمْرَانَ بْنِ أَبِی الْجَعْدِ ، قَالَ : کُنْتُ مَعَ ابْنِ عُمَرَ فِی سَفَرٍ فَصَلَّی بِنَا الْفَجْرَ ، فَقَرَأَ بِنَا : {إذَا الشَّمْسُ کُوِّرَتْ}۔","Majhul","Musannaf Ibn Abi Shaybah 3707","","","كتاب الصلوات"
"3708","(۳۷۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ الْغَازِ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ الْجُہَنِیِّ ، قَالَ : کُنْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ ، فَلَمَّا طَلَعَ الْفَجْرُ أَذَّنَ وَأَقَامَ ، ثُمَّ أَقَامَنِی عَنْ یَمِینِہِ ، ثُمَّ قَرَأَ بِالْمُعَوِّذَتَیْنِ، فَلَمَّا انْصَرَفَ ، قَالَ : کَیْفَ رَأَیْتَ ؟ قُلْتُ : قَدْ رَأَیْت یَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: فَاقْرَأْ بِہِمَا کُلَّمَا نِمْتَ وَکَمَا قُمْتَ۔ (ابوداؤد ۱۴۵۷۔ احمد ۴/۱۴۴)","","Musannaf Ibn Abi Shaybah 3708","","","كتاب الصلوات"
"3709","(۳۷۰۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَقْرَأُ فِی الرَّکْعَۃِ ، بِعَشْرِ سُوَرٍ وَأَکْثَرَ وَأَقَلَّ۔","Sahih","Musannaf Ibn Abi Shaybah 3709","","","كتاب الصلوات"
"3710","(۳۷۱۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ ابْنِ سِیرِینَ ، قَالَتْ نَائِلَۃُ ابْنَۃُ الْفَرَافِصَۃِ الْکَلْبِیَّۃُ حَیثُ دَخَلُوا عَلَی عُثْمَانَ فَقَتَلُوہُ ، فَقَالَتْ : إِنْ تَقْتُلُوہُ ، أَوْ تَدَعُوہُ فَقَدْ کَانَ یُحْیِی اللَّیْلَ بِرَکْعَۃٍ یَجْمَعُ فِیہَا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 3710","","","كتاب الصلوات"
"3711","(۳۷۱۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ تَمِیمًا الدَّارِیَّ کَانَ یَقْرَأُ الْقُرْآنَ کُلَّہُ فِی رَکْعَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 3711","","","كتاب الصلوات"
"3712","(۳۷۱۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إنِّی لأَقْرَأُ السُّوَرَ مِنَ الْمُفَصَّلِ فِی رَکْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 3712","","","كتاب الصلوات"
"3713","(۳۷۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، قَالَ : حدَّثَنَا بَکْرُ بْنُ مَاعِزٍ ، عَنِ الرَّبِیعِ بْنِ خُثَیْمٍ ؛ یَقْرَأُ بالسُّورَتَیْنِ وَالثَّلاَثَ فِی الرَّکْعَۃِ۔","","Musannaf Ibn Abi Shaybah 3713","","","كتاب الصلوات"
"3714","(۳۷۱۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حَدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَقْرُنُ بَیْنَ السُّورَتَیْنِ فِی رَکْعَۃٍ مِنَ الصَّلاَۃِ الْمَکْتُوبَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 3714","","","كتاب الصلوات"
"3715","(۳۷۱۵) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ، قَالَ: حدَّثَنَا عَبْدُ الْمَلِکِ بْنُ أَبِی سُلَیْمَانَ ، عَنْ عَطَائٍ؛ فِی الرَّجُلِ یُصَلِّی الْمَکْتُوبَۃَ فَیَقْرَأُ بِسُورَتَیْنِ فِی رَکْعَۃٍ ، أَوْ بِسُورَۃٍ فِی رَکْعَتَیْنِ ؟ قَالَ : لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 3715","","","كتاب الصلوات"
"3716","(۳۷۱۶) حَدَّثَنَا یَعْلَی ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ فِی الرَّجُلِ یَجْمَعُ بَیْنَ السُّورَتَیْنِ فِی رَکْعَۃٍ ؟ قَالَ : أَمَّا مَا کَانَ مِنَ الْمِئیْنَ فَارْکَعْ بِکُلِّ سُورَۃٍ ، وَأَمَّا مَا کَانَ مِنَ الْمَثَانِی وَالْمُفَصَّلِ فَاقْرُنْ إِنْ شِئْت۔","","Musannaf Ibn Abi Shaybah 3716","","","كتاب الصلوات"
"3717","(۳۷۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ؛ أَنَّہُ کَانَ یَقْرُن السُّورَتَیْنِ فِی رَکْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 3717","","","كتاب الصلوات"
"3718","(۳۷۱۸) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنِ الْقَاسِمِ وَسَالِمٍ ، قَالاَ : اقْرُنْ کَمْ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 3718","","","كتاب الصلوات"
"3719","(۳۷۱۹) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، وَوَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مَعْبَدِ بْنِ خَالِدٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالسَّبْعِ الطِّوَالِ فِی رَکْعَۃٍ ، إِلاَّ أَنَّ وَکِیعًا ، قَالَ : قَرَأَ۔","Da'if","Musannaf Ibn Abi Shaybah 3719","","","كتاب الصلوات"
"3720","(۳۷۲۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْن عُثْمَانَ ، قَالَ : قمْتُ خَلْفَ الْمَقَامِ أُصَلِّی ، وَأَنَا أُرِیدُ أَنْ لاَ یَغْلِبَنِی عَلَیْہِ أَحَدٌ تِلْکَ اللَّیْلَۃَ ، قَالَ : فَإِذَا رَجُلٌ یَغْمِزُنِی مِنْ خَلْفِی ، فَلَمْ أَلْتَفِتْ ، ثُمَّ غَمَزَنِی فَالْتَفَتُّ ، فَإِذَا عُثْمَانَ بْنُ عَفَّانَ ،فَتَنَحَّیْتُ وَتَقَدَّمَ ، فَقَرَأَ الْقُرْآنَ فِی رَکْعَۃٍ ، ثُمَّ انْصَرَفَ۔","Hasan","Musannaf Ibn Abi Shaybah 3720","","","كتاب الصلوات"
"3721","(۳۷۲۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ وِقَائٍ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یَجْمَعُ بَیْنَ سُورَتَیْنِ فِی کُلِّ رَکْعَۃٍ فِی الْفَرِیضَۃِ۔","","Musannaf Ibn Abi Shaybah 3721","","","كتاب الصلوات"
"3722","(۳۷۲۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا کَہْمَسٌ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ الْعُقَیْلِیِّ ، قَالَ : قُلْتُ لِعَائِشَۃَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَجْمَعُ بَیْنَ السُّورَتَیْنِ فِی رَکْعَۃٍ ؟ قَالَتْ : نَعَمَ ،الْمُفَصَّلَ۔n(ابوداؤد ۱۲۸۶۔ احمد ۶/۲۱۸)","Sahih","Musannaf Ibn Abi Shaybah 3722","","","كتاب الصلوات"
"3723","(۳۷۲۳) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا الأَعْمَشُ، عَنْ إِبْرَاہِیمَ، عَن عَلْقَمَۃَ؛ أَنَّہُ کَانَ یَقْرَأُ فِی الْفَجْرِ فِی الرَّکْعَۃِ الأُولَی بـ: (حم) الدُّخَانِ، وَ (الطُّورِ)، وَالجن، وَیَقْرَأُ فِی الثَّانِیَۃِ بِآخِرِ الْبَقَرَۃِ وَآخِرِ آلِ عِمْرَانَ، وَبِالسُّورَۃِ الْقَصِیرَۃِ۔","","Musannaf Ibn Abi Shaybah 3723","","","كتاب الصلوات"
"3724","(۳۷۲۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنِ الْمُسْتَوْرِدِ بْنِ الأَحْنَفِ ، عَنْ صِلَۃَ ، عَنْ حُذَیْفَۃَ ، قَالَ : صَلَّیْت مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَافْتَتَحَ الْبَقَرَۃَ ،فَقُلْت : یَخْتِمُہَا فَیَرْکَعُ بِہَا، ثُمَّ افْتَتَحَ آلَ عِمْرَانَ ، فَقُلْتُ : یَخْتِمُہَا فَیَرْکَعُ بِہَا ، ثُمَّ افْتَتَحَ النِّسَائَ ، فَقُلْتُ : یَرْکَعُ بِہَا ، فَقَرَأَ حَتَّی خَتَمَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 3724","","","كتاب الصلوات"
"3725","(۳۷۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْمَرِ بْنِ مُوسَی ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لاَ یَقْرُنُ بَیْنَ سُورَتَیْنِ فِی کُلِّ رَکْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 3725","","","كتاب الصلوات"
"3726","(۳۷۲۶) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ ، قَالَ : کَانَ أَبُو بَکْرِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ لاَ یَجْمَعُ بَیْنَ سُورَتَیْنِ فِی رَکْعَۃٍ ، وَلاَ یُجَاوِزُ سُورَۃً إذَا خَتَمَہَا حَتَّی یَرْکَعَ۔","","Musannaf Ibn Abi Shaybah 3726","","","كتاب الصلوات"
"3727","(۳۷۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ کَانَ لاَ یَقْرُن بَیْنَ سُورَتَیْنِ فِی رَکْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 3727","","","كتاب الصلوات"
"3728","(۳۷۲۸) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عِیسَی ، عَنِ الشَّعْبِیِّ ، عَنْ زَیْدِ بْنِ خَالِدٍ الْجُہَنِیِّ ، قَالَ : مَا أُحِبُّ أَنِّی قَرَنْتُ سُورَتَیْنِ فِی رَکْعَۃٍ وَلَوْ أَنَّ لِی حُمْرَ النَّعَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 3728","","","كتاب الصلوات"
"3729","(۳۷۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عِیسَی ، عَنِ الشَّعْبِیِّ ، عَنْ زَیْدِ بْنِ خَالِدٍ ؛ مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 3729","","","كتاب الصلوات"
"3730","(۳۷۳۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : حدَّثَنِی مَنْ سَمِعَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : أَعْطِ کُلَّ سُورَۃٍ حَظَّہَا مِنَ الرُّکُوعِ وَالسُّجُودِ۔ (بیہقی ۱۰۔ احمد ۵/۵۹)","Sahih","Musannaf Ibn Abi Shaybah 3730","","","كتاب الصلوات"
"3731","(۳۷۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنِی إسْرَائِیلُ ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : أَعْطِ کُلَّ سُورَۃٍ حَقَّہَا مِنَ الرُّکُوعِ وَالسُّجُودِ۔","","Musannaf Ibn Abi Shaybah 3731","","","كتاب الصلوات"
"3732","(۳۷۳۲) حدَّثَنَا عَبْدَۃُ ، وَوَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی أَیُّوبَ ، أَوْ زَیْدِ بْنِ ثَابِتٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ فِی الْمَغْرِبِ بِالأَعْرَافِ فِی رَکْعَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 3732","","","كتاب الصلوات"
"3733","(۳۷۳۳) حَدَّثَنَا عَبْدَۃُ ، وَوَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّ أَبَا بَکْرٍ قَرَأَ فِی الْمَغْرِبِ بِالأَعْرَافِ فِی رَکْعَتَیْنِ","Sahih","Musannaf Ibn Abi Shaybah 3733","","","كتاب الصلوات"
"3734","(۳۷۳۴) حَدَّثَنَا عَبْدَۃُ ، وَوَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّ أَبَا بَکْرٍ قَرَأَ بِالْبَقَرَۃِ فِی الْفَجْرِ رَکْعَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 3734","","","كتاب الصلوات"
"3735","(۳۷۳۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ یَحْیَی بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ؛ أَنَّ عُمَرَ قَرَأَ بِآلِ عِمْرَانَ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ مِنَ الْعِشَائِ قَطََّعَہَا ، یَعْنِی فِیہِمَا۔","","Musannaf Ibn Abi Shaybah 3735","","","كتاب الصلوات"
"3736","(۳۷۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عُمَرَ بْنِ یَعْلَی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یَقْرَأُ فِی الْفَجْرِ بِبَنِی إسْرَائِیلَ فِی الرَّکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 3736","","","كتاب الصلوات"
"3737","(۳۷۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : صَلَّیْت خَلْفَ سَعِیدِ بْنِ جُبَیْرٍ الْفَجْرَ ، فَقَرَأَ بِـ : (حم) الْمُؤْمِنِ ، فَلَمَّا بَلَغَ (بِالْعَشِیِّ وَالإِبْکَارِ) رَکَعَ ، ثُمَّ قَامَ فِی الثَّانِیَۃِ فَقَرَأَ بِبَقِیَّۃِ السُّورَۃِ ، ثُمَّ رَکَعَ ، وَلَمْ یَقْنُتْ۔","","Musannaf Ibn Abi Shaybah 3737","","","كتاب الصلوات"
"3738","(۳۷۳۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ یَحْیَی ، قَالَ : کَانَ یَقْسِمُ السُّورَۃَ فِی الرَّکْعَتَیْنِ فِی الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 3738","","","كتاب الصلوات"
"3739","(۳۷۳۹) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَقْسِمُ السُّورَۃَ فِی رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 3739","","","كتاب الصلوات"
"3740","(۳۷۴۰) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ، عَنْ عَامِرٍ ، قَالَ : لاَ بَأْسَ أَنْ یَقْسِمَ السُّورَۃَ فِی رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 3740","","","كتاب الصلوات"
"3741","(۳۷۴۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ یَحْیَی ، قَالَ : یقْسِمُ سُورَۃ فِی رَکْعَتَیِّ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 3741","","","كتاب الصلوات"
"3742","(۳۷۴۲) حَدَّثَنَا یَعْلَی ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ تُقْسَمَ السُّورَۃُ فِی رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 3742","","","كتاب الصلوات"
"3743","(۳۷۴۳) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : نُبِّئْتُ أَنَّ ابْنَ مَسْعُودٍ کَانَ یَقْرَأُ فِی الظُّہْرِ وَالْعَصْرِ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ ، وَمَا تَیَسَّرَ ، وَفِی الأُخْرَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 3743","","","كتاب الصلوات"
"3744","(۳۷۴۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَتَبَ عُمَرُ إلَی شُرَیْحٍ ، یَقْرَأُ فِی الأُولَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ وَسُورَۃٍ ، وَفِی الأُخْرَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 3744","","","كتاب الصلوات"
"3745","(۳۷۴۵) حَدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، قَالَ : حدَّثَنَا عَلِیُّ بْنُ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ بْنِ الْحَارِثِ ، قَالَ : سَمِعْتُ ہِشَامَ بْنَ إسْمَاعِیلَ عَلَی مِنْبَرِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : کَانَ أَبُو الدَّرْدَائِ یَقُولُ : اقْرَؤُوا فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ مِنْ صَلاَۃِ الظُّہْرِ بِأُمِّ الْکِتَابِ وَسُورَۃٍ ، وَفِی الأُخْرَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ ، وَاقْرَؤُوا فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ مِنَ الْعَصْرِ بِأُمِّ الْکِتَابِ وَسُورَۃٍ ، وَفِی الأُخْرَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ ، وَفِی الرَّکْعَۃِ الآخِرَۃِ مِنَ الْمَغْرِبِ بِأُمِّ الْکِتَابِ ، وَفِی الرَّکْعَتَیْنِ مِنَ الْعِشَائِ بِأُمِّ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 3745","","","كتاب الصلوات"
"3746","(۳۷۴۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، قَالَ : حُدِّثْت أَنَّ أَبَا الدَّرْدَائِ کَانَ یَقُولُ : اقْرَؤُوا فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ مِنَ الظُّہْرِ وَالْعَصْرِ بِفَاتِحَۃِ الْکِتَابِ وَسُورَۃٍ ، وَفِی الأُخْرَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ ، وَفِی الرَّکْعَۃِ الآخِرَۃِ مِنْ صَلاَۃِ الْمَغْرِبِ ، وَفِی الرَّکْعَتَیْنِ الأُخْرَیَیْنِ مِنَ الْعِشَائِ بِأُمِّ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 3746","","","كتاب الصلوات"
"3747","(۳۷۴۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ عَمِّہِ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی رَافِعٍ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یَقُولُ : یَقْرَأُ الإِمَامُ وَمَنْ خَلْفَہُ فِی الظُّہْرِ وَالْعَصْرِ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ وَسُورَۃٍ ، وَفِی الأُخْرَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ۔","Sahih","Musannaf Ibn Abi Shaybah 3747","","","كتاب الصلوات"
"3748","(۳۷۴۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، وَوَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ رَجَائِ بْنِ حَیْوَۃَ ، عَنْ مَحْمُودِ بْنِ رَبِیعِ ، عَنِ الصُّنَابِحِیِّ ، قَالَ : صَلَّیْت مَعَ أَبِی بَکْرٍ الْمَغْرِبَ فَدَنَوْت مِنْہُ حَتَّی مَسَّتْ ثِیَابِی ثِیَابَہُ ، أَوْ یَدِی ثِیَابَہُ ، شَکَّ ابْنُ مُبَارَکٍ ، فَقَرَأَ فِی الرَّکْعَۃِ الثَّالِثَۃِ بِفَاتِحَۃِ الْکِتَابِ ، وَقَالَ : {رَبَّنَا لاَ تُزِغْ قُلُوبَنَا بَعْدَ إذْ ہَدَیْتنَا}۔","Sahih","Musannaf Ibn Abi Shaybah 3748","","","كتاب الصلوات"
"3749","(۳۷۴۹) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنْ یَزِیدَ الْفَقِیرِ، عَنْ جَابِرٍ، قَالَ: یَقْرَأُ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ وَسُورَۃٍ ، وَفِی الأُخْرَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ ، کُنَّا نَتَحَدَّثُ أَنَّہُ لاَ صَلاَۃَ إِلاَّ بِقِرَائَۃِ فَاتِحَۃِ الْکِتَابِ فَمَا زَادَ۔","Sahih","Musannaf Ibn Abi Shaybah 3749","","","كتاب الصلوات"
"3750","(۳۷۵۰) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ لَیْثٍ ، عَنْ شَہْرٍ ، عَنْ أَبِی مَالِکٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی الظُّہْرِ وَالْعَصْرِ فِی کُلِّہِنَّ۔ (طبرانی ۲۴۳۷)","Da'if","Musannaf Ibn Abi Shaybah 3750","","","كتاب الصلوات"
"3751","(۳۷۵۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ یَقْرَأُ فِی الأَرْبَعِ ، یُسَوِّی بَیْنَہُنَّ۔","Sahih","Musannaf Ibn Abi Shaybah 3751","","","كتاب الصلوات"
"3752","(۳۷۵۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یَحْیَی بْنِ أَبِی إِسْحَاقَ ، قَالَ : حدَّثَنِی عُمَرُ بْنُ أَبِی سُحَیْمٍ ، قَالَ : کَانَ عَبْدُ اللہِ بْنُ مُغَفَّلٍ یَأْمُرُ بِالصَّلاَۃِ الَّتِی لاَ یَجْہَرُ فِیہَا الإِمَامُ أَنْ یَقْرَأَ فِی الصَّلاَۃِ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ وَسُورَۃٍ ، وَفِی الأُخْرَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ۔","Majhul","Musannaf Ibn Abi Shaybah 3752","","","كتاب الصلوات"
"3753","(۳۷۵۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یَقُولُونَ : اقْرَأْ فِی الأُولَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ وَسُورَۃٍ ، وَفِی الآخِرَۃِ بِفَاتِحَۃِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 3753","","","كتاب الصلوات"
"3754","(۳۷۵۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَوَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : اقْرَأْ فِی الأُخْرَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 3754","","","كتاب الصلوات"
"3755",") حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ وَالشَّیْبَانِیُّ ، عَنِ الشَّعْبِیِّ (ح) وَحَجَّاجٌ ، عَنْ عَطَائٍ (ح) وَمَنْصُورٌ ، عَنِ الْحَسَنِ ، أَنَّہُمْ قَالُوا : اقْرَأْ فِی الرَّکْعَتَیْنِ ، یَعْنِی الأُخْرَیَیْنِ ، مِنَ الظُّہْرِ وَالْعَصْرِ بِفَاتِحَۃِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 3755","","","كتاب الصلوات"
"3756","(۳۷۵۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا لَمْ یَقْرَأْ فِی رَکْعَۃٍ بِفَاتِحَۃِ الْکِتَابِ ، فَإِنَّہُ یَقْضِی تِلْکَ الرَّکْعَۃَ۔","","Musannaf Ibn Abi Shaybah 3756","","","كتاب الصلوات"
"3757","(۳۷۵۷) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ مُحَمَّدٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ تَقْرَأُ فِی صَلاَۃِ النَّہَارِ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ وَسُورَۃٍ ، وَفِی الأُخْرَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 3757","","","كتاب الصلوات"
"3758","(۳۷۵۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ سَلَمَۃَ ، عَنِ الضَّحَّاکِ ، قَالَ : اقْرَأْ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ وَسُورَۃٍ ، وَفِی الأُخْرَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 3758","","","كتاب الصلوات"
"3759","(۳۷۵۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حُمَیْدِ بْنِ سَلْمَانَ ، عَنْ مُجَاہِدٍ ، قَالَ : سَمِعْتُہُ یَقْرَأُ فِی الأُخْرَیَیْنِ مِنَ الظُّہْرِ وَالْعَصْرِ بِفَاتِحَۃِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 3759","","","كتاب الصلوات"
"3760","(۳۷۶۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سَلَمَۃَ بْنِ نُبَیْطٍ ، عَنِ الضَّحَّاکِ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 3760","","","كتاب الصلوات"
"3761","(۳۷۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنِ الشَّعْبِیِّ ، قَالَ : اقْرَأْ فِی جَمِیعِہِنَّ۔","","Musannaf Ibn Abi Shaybah 3761","","","كتاب الصلوات"
"3762","(۳۷۶۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہَمَّامٍ ، وَأَبَانُ الْعَطَّارُ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی قَتَادَۃَ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ وَسُورَۃٍ ، وَفِی الأُخْرَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ۔ (بخاری ۷۷۶۔ ابوداؤد ۷۹۵)","Sahih","Musannaf Ibn Abi Shaybah 3762","","","كتاب الصلوات"
"3763","(۳۷۶۳) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ ، أَنَّہُمَا قَالاَ : اقْرَأْ فِی الأُولَیَیْنِ ، وَسَبِّحْ فِی الأُخْرَیَیْنِ۔","","Musannaf Ibn Abi Shaybah 3763","","","كتاب الصلوات"
"3764","(۳۷۶۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ قَالَ : یَقْرَأُ فِی الأُولَیَیْنِ ، وَیُسَبِّحُ فِی الأُخْرَیَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 3764","","","كتاب الصلوات"
"3765","(۳۷۶۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : مَا یُفْعَلُ فِی الرَّکْعَتَیْنِ الأُخْرَیَیْنِ مِنَ الصَلاَۃ ؟ قَالَ : سَبِّحْ ، وَاحْمَدِ اللَّہَ ، وَکَبِّر۔","","Musannaf Ibn Abi Shaybah 3765","","","كتاب الصلوات"
"3766","(۳۷۶۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَبِّحْ فِی الأُخْرَیَیْنِ وَکَبِّرْ۔","","Musannaf Ibn Abi Shaybah 3766","","","كتاب الصلوات"
"3767","(۳۷۶۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنِ ابْنِ الأَسْوَدِ ، قَالَ : یَقْرَأُ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ وَسُورَۃٍ ، وَفِی الأُخْرَیَیْنِ یُسَبِّحُ وَیُکَبِّرُ۔","","Musannaf Ibn Abi Shaybah 3767","","","كتاب الصلوات"
"3768","(۳۷۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : یُسَبِّحُ وَیُکَبِّرُ فِی الأُخْرَیَیْنِ تَسْبِیحَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 3768","","","كتاب الصلوات"
"3769","(۳۷۶۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الشَّیْبَانِیُّ ، عَنْ جَوَّاب بْنِ عُبَیْدِ اللہِ التَّیْمِیِّ ، قَالَ : حَدَّثَنَا یَزِیدُ بْنُ شَرِیکٍ التَّیْمِیُّ أَبُو إبْرَاہِیمَ ، قَالَ : سَأَلْتُ عُمَرَ بْنَ الْخَطَّابِ عَنِ الْقِرَائَۃِ خَلْفَ الإِمَامِ ؟ فَقَالَ لِی : اقْرَأْ ، قُلْتُ : وَإِنْ کُنْتُ خَلْفَک ؟ قَالَ : وَإِنْ کُنْتَ خَلْفِی ، قَلْت : وَإِنْ قَرَأْتَ ؟ قَالَ : وَإِنْ قَرَأْتُ۔","Sahih","Musannaf Ibn Abi Shaybah 3769","","","كتاب الصلوات"
"3770","(۳۷۷۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ مُجَاہِدٍ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ عَمْرِو بْنِ الْعَاصِ یَقْرَأُ خَلْفَ الإِمَامِ فِی صَلاَۃِ الظُّہْرِ مِنْ سُورَۃِ مَرْیَمَ۔","Sahih","Musannaf Ibn Abi Shaybah 3770","","","كتاب الصلوات"
"3771","(۳۷۷۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، قَالَ : صَلَّیْتُ إلَی جَنْبِ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، قَالَ : فَسَمِعْتُہُ یَقْرَأُ خَلْفَ الإِمَامِ ، قَالَ : فَلَقِیت مُجَاہِدًا فَذَکَرْت لَہُ ذَلِکَ ، قَالَ : فَقَالَ مُجَاہِدٌ : سَمِعْت عَبْدَ اللہِ بْنَ عَمْرٍو یَقْرَأُ خَلْفَ الإِمَامِ۔","Sahih","Musannaf Ibn Abi Shaybah 3771","","","كتاب الصلوات"
"3772","(۳۷۷۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ ثَرْوَانَ ، عَنْ ہُذَیْلٍ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ؛ أنَّہُ قَرَأَ فِی الْعَصْرِ خَلْفَ الإِمَامِ فِی الرَّکْعَتَیْنِ بِفَاتِحَۃِ الْکِتَابِ وَسُورَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 3772","","","كتاب الصلوات"
"3773","(۳۷۷۳) حَدَّثَنَا شَرِیکٌ ، عَنْ أَشْعَثَ بْنِ سُلَیْم ، عَنْ أَبِی مَرْیَمَ الأَسَدِیِّ ، عَنْ عَبْدِ اللہِ ، قَالَ : صَلَّیْت إلَی جَنْبِہِ فَسَمِعْتُہُ یَقْرَأُ خَلْفَ بَعْضِ الأُمَرَائِ فِی الظُّہْرِ وَالْعَصْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 3773","","","كتاب الصلوات"
"3774","(۳۷۷۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی رَافِعٍ ؛ أَنَّ عَلِیًّا کَانَ یَقُولُ : اقْرَأْ فِی الظُّہْرِ وَالْعَصْرِ خَلْفَ الإِمَامِ فِی کُلِّ رَکْعَۃٍ بِأُمِّ الْکِتَابِ وَسُورَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 3774","","","كتاب الصلوات"
"3775","(۳۷۷۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ؛ أَنَّ عَلِیًّا کَانَ یَأْمُرُ بِالْقِرَائَۃِ خَلْفَ الإِمَامِ۔","","Musannaf Ibn Abi Shaybah 3775","","","كتاب الصلوات"
"3776","(۳۷۷۶) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تَدَعْ أَنْ تَقْرَأَ خَلْفَ الإِمَامِ بِفَاتِحَۃِ الْکِتَابِ جَہَرَ ، أَوْ لَمْ یَجْہَرْ۔","Da'if","Musannaf Ibn Abi Shaybah 3776","","","كتاب الصلوات"
"3777","(۳۷۷۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ مَکْحُولٍ ، عَنْ مَحْمُودِ بْنِ الرَّبِیعِ ، عَنْ عُبَادَۃَ بْنِ الصَّامِتِ ، قَالَ : صَلَّی بِنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلاَۃَ الْعِشَائِ فَثَقُلَتْ عَلَیْہِ الْقِرَائَۃُ ، فَلَمَّا انْصَرَفَ قَالَ : لَعَلَّکُمْ تَقْرَؤُونَ خَلْفَ إمَامِکُمْ ؟ قَالَ : قُلْنَا : أَجَلْ یَا رَسُولَ اللہِ إنَّا لَنَفْعَلُ ، قَالَ : فَلاَ تَفْعَلُوا إِلاَّ بِأُمِّ الْقُرْآنِ ، فَإِنَّہُ لاَ صَلاَۃَ إِلاَّ بِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 3777","","","كتاب الصلوات"
"3778","(۳۷۷۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لأَصْحَابِہِ : ہَلْ تَقْرَؤُونَ خَلْفَ إمَامِکُمْ ؟ فَقَالَ بَعْضٌ : نَعَمْ ، وَقَالَ بَعْضٌ : لاَ ، فَقَالَ : إِنْ کُنْتُمْ لاَ بُدَّ فَاعِلِینَ ، فَلْیَقْرَأْ أَحَدُکُمْ فَاتِحَۃَ الْکِتَابِ فِی نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 3778","","","كتاب الصلوات"
"3779","(۳۷۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ مُحَمَّدِ بْنِ أَبِی عَائِشَۃَ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ بِنَحْوٍ مِنْ حَدِیثِ ہُشَیْمٍ۔n(احمد ۴/۲۳۶۔ عبدالرزاق ۲۷۶۶)","Sahih","Musannaf Ibn Abi Shaybah 3779","","","كتاب الصلوات"
"3780","(۳۷۸۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی الْفَیْضِ ، قَالَ : سَمِعْتُ أَبَا شَیْبَۃَ الْمَہْرِیَّ یُحَدِّثُ ، عَنْ مُعَاذٍ ؛ أَنَّہُ قَالَ؛ فِی الرَّجُلِ یُصَلِّی خَلْفَ الإِمَامِ : إذَا کَانَ یَسْمَعُ قِرَائَتَہُ قَرَأَ : {قُلْ ہُوَ اللَّہُ أَحَدٌ} ، وَ{قُلْ أَعُوذُ بِرَبِّ النَّاسِ} ، وَ{قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ} قَالَ شُعْبَۃُ : أَوْ نَحْوَہَا ، وَإِذَا کَانَ لاَ یَسْمَعُ الْقِرَائَۃَ فَلْیَقْرَأْ ، وَلاَ یُؤْذِ مَنْ عَنْ یَمِینِہِ ، وَمَنْ عَنْ شِمَالِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 3780","","","كتاب الصلوات"
"3781","(۳۷۸۱) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَنْتَ بِالْخِیَارِ ، إِنْ شِئْتَ فَاقْرَأْ ، وَإِنْ شِئْتَ فَاعْتَدَّ۔","","Musannaf Ibn Abi Shaybah 3781","","","كتاب الصلوات"
"3782","(۳۷۸۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إذَا لَمْ تَسْمَعْ قِرَائَۃَ الإِمَامِ ، فَاقْرَأْ فِی نَفْسِکَ إِنْ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 3782","","","كتاب الصلوات"
"3783","(۳۷۸۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ وَیُونُسُ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ : اقْرَأْ خَلْفَ الإِمَامِ فِی کُلِّ رَکْعَۃٍ بِفَاتِحَۃِ الْکِتَابِ فِی نَفْسِک۔","","Musannaf Ibn Abi Shaybah 3783","","","كتاب الصلوات"
"3784","(۳۷۸۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الشَّیْبَانِیُّ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَانَ یَقُولُ : اقْرَأْ خَلْفَ الإِمَامِ فِی الظُّہْرِ وَالْعَصْرِ بِفَاتِحَۃِ الْکِتَابِ وَسُورَۃٍ ، وَفِی الأُخْرَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 3784","","","كتاب الصلوات"
"3785","(۳۷۸۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا إسْمَاعِیلُ بْنُ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَمِعْتُہُ یَقُولُ : الْقِرَائَۃُ خَلْفَ الإِمَامِ فِی الظُّہْرِ وَالْعَصْرِ نُورٌ لِلصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 3785","","","كتاب الصلوات"
"3786","(۳۷۸۶) حَدَّثَنَا عَبَّادٌ ، عَنْ سَعِیدِ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ قَالَ : یَقْرَأُ الإِمَامُ وَمَنْ خَلْفَہُ فِی الظُّہْرِ وَالْعَصْرِ بِفَاتِحَۃِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 3786","","","كتاب الصلوات"
"3787","(۳۷۸۷) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : اقْرَأْ خَلْفَ الإِمَامِ فِیمَا لَمْ یَجْہَرْ ، فِی الأُولَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ وَسُورَۃٍ ، وَفِی الأُخْرَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 3787","","","كتاب الصلوات"
"3788","(۳۷۸۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : اُسْکُتُوا فِیمَا یَجْہَرُ ، وَاقْرَؤُوا فِیمَا لاَ یَجْہَرُ۔","","Musannaf Ibn Abi Shaybah 3788","","","كتاب الصلوات"
"3789","(۳۷۸۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یَحْیَی بْنِ أَبِی إِسْحَاقَ ، قَالَ : صَلَّیْت الْمَغْرِبَ وَالْحَکَمُ بْنُ أَیُّوبَ إمَامُنَا ، وَأَبُو مَلِیحٍ إلَی جَنْبِ ابْنِ أُسَامَۃَ ، فَسَمِعْتُہُ یَقْرَأُ بِفَاتِحَۃِ الْکِتَابِ ، فَلَمَّا سَلَّمَ الإِمَامُ قُلْتُ لأَبِی مَلِیحٍ : تَقْرَأُ خَلْفَ الإِمَامِ وَہُوَ یَقْرَأُ ؟ ، قَالَ : سَمِعْتَ شَیْئًا ؟ قُلتُ : نَعَمْ ، قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 3789","","","كتاب الصلوات"
"3790","(۳۷۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ ثَعْلَبَۃَ ، عَنْ أَنَسٍ ؛ أَنَّہُ قَالَ فِی الْقِرَائَۃِ خَلْفَ الإِمَامِ التَّسْبِیحُ۔","Hasan","Musannaf Ibn Abi Shaybah 3790","","","كتاب الصلوات"
"3791","(۳۷۹۱) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ رَجَائِ بْنِ حَیْوَۃَ ، عَنْ مَحْمُودِ بْنِ رَبِیعٍ ، قَالَ : صَلَّیْت صَلاَۃً وَإِلَی جَنْبِی عُبَادَۃُ بْنُ الصَّامِتِ ، قَالَ : فَقَرَأَ بِفَاتِحَۃِ الْکِتَابِ ، قَالَ : فَقُلْتُ لَہُ : یَا أَبَا الْوَلِیدِ ، أَلَمْ أَسْمَعْک تَقْرَأُ بِفَاتِحَۃِ الْکِتَابِ ؟ قَالَ : أَجَلْ ، إِنَّہُ لاَ صَلاَۃَ إِلاَّ بِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 3791","","","كتاب الصلوات"
"3792","(۳۷۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : إِنْ قَرَأْتَ خَلْف[corrupt] الإِمَامِ فَحَسَنٌ ، وَإِنْ لَمْ تَقْرَأْ أَجْزَأَکَ قِرَائَۃُ الإِمَامِ۔","Hasan","Musannaf Ibn Abi Shaybah 3792","","","كتاب الصلوات"
"3793","(۳۷۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الْعَیْزَارِ بْنِ حُرَیْثٍ الْعَبْدِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : اقْرَأْ خَلْفَ الإِمَامِ بِفَاتِحَۃِ الْکِتَابِ۔","Sahih","Musannaf Ibn Abi Shaybah 3793","","","كتاب الصلوات"
"3794","(۳۷۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یُحَسِّنُ الْقِرَائَۃَ خَلْفَ الإِمَامِ۔","","Musannaf Ibn Abi Shaybah 3794","","","كتاب الصلوات"
"3795","(۳۷۹۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، قَالَ : إنِّی لاَحِبُّ أَنْ أَشْغَلَ نَفْسِی فِی الظُّہْرِ وَالْعَصْرِ خَلْفَ الإِمَامِ۔","","Musannaf Ibn Abi Shaybah 3795","","","كتاب الصلوات"
"3796","(۳۷۹۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الْعَلاَئِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ یَعْقُوبَ ، أَنَّ أَبَا السَّائِبِ أخْبَرَہُ، قَالَ: قُلْتُ لأَبِی ہُرَیْرَۃَ: إنِّی أَکُونُ وَرَائَ الإِمَامِ؟ فَغَمَزَ ذِرَاعِی، فَقَالَ: یَا فَارِسِیُّ، اقْرَأْ بِہَا فِی نَفْسِکَ، یَعْنِی بِأُمِّ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 3796","","","كتاب الصلوات"
"3797","(۳۷۹۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنِ ابْنِ أُکیمَۃَ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلاَۃً ، نَظُنُّ أَنَّہَا الصُّبْحُ ، فَلَمَّا قَضَاہَا ، قَالَ : ہَلْ قَرَأَ مِنْکُمْ أَحَدٌ ؟ قَالَ رَجُلٌ : أَنَا ، قَالَ: إنِّی أَقُولُ : مَا لِی أُنَازَعُ الْقُرْآنَ۔ (ترمذی ۳۱۲۔ احمد ۲/۲۸۴)","Sahih","Musannaf Ibn Abi Shaybah 3797","","","كتاب الصلوات"
"3798","(۳۷۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی الظُّہْرَ ، فَلَمَّا سَلَّمَ قَالَ : ہَلْ قَرَأَ أَحَدٌ مِنْکُمْ بِـ (سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی) ؟ فَقَالَ رَجُلٌ مِنَ الْقَوْمِ : أَنَا ، فَقَالَ : قَدْ عَلِمْتُ أَنَّ بَعْضَکُمْ خَالَجَنِیہَا۔","Sahih","Musannaf Ibn Abi Shaybah 3798","","","كتاب الصلوات"
"3799","(۳۷۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ یُونُسَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، قَالَ : کُنَّا نَقْرَأُ خَلْفَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : خَلَطْتُمْ عَلَیَّ الْقُرْآنَ۔ n(احمد ۱/۴۵۱۔ ابو یعلی ۴۹۸۵)","Hasan","Musannaf Ibn Abi Shaybah 3799","","","كتاب الصلوات"
"3800","(۳۸۰۰) حَدَّثَنَا شَرِیکٌ ، وَجَرِیرٌ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَانَ لَہُ إمَامٌ ، فَقِرَاء َتُہُ لَہُ قِرَاء َۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 3800","","","كتاب الصلوات"
"3801","(۳۸۰۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : جَائَ رَجُلٌ إلَی عَبْدِ اللہِ ، فَقَالَ : أَقْرَأُ خَلْفَ الإِمَامِ ؟ فَقَالَ لَہُ عَبْدُ اللہِ : إنَّ فِی الصَّلاَۃِ شُغْلاً ، وَسَیَکْفِیک ذَاکَ الإِمَامُ۔","Sahih","Musannaf Ibn Abi Shaybah 3801","","","كتاب الصلوات"
"3802","(۳۸۰۲) حَدَّثَنَا مُحَمَّدُ بْنُ سُلَیْمَانَ الأَصْبَہَانِیُّ ، عَنْ عَبْدِ الرَّحْمَنِ بن الأصبہانی ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَلِیٍّ ، قَالَ : مَنْ قَرَأَ خَلْفَ الإِمَامِ فَقَدْ أَخْطَأَ الْفِطْرَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 3802","","","كتاب الصلوات"
"3803","(۳۸۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ قَتَادَۃَ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، عَنْ أَبِی بِجَادٍ ، عَنْ سَعْدٍ ، قَالَ : وَدِدْت أَنَّ الَّذِی یَقْرَأُ خَلْفَ الإِمَامِ فِی فِیہِ جَمْرَۃٌ۔","Majhul","Musannaf Ibn Abi Shaybah 3803","","","كتاب الصلوات"
"3804","(۳۸۰۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبَّادِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْطٍ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : لاَ قِرَائَۃَ خَلْفَ الإِمَامِ۔","Majhul","Musannaf Ibn Abi Shaybah 3804","","","كتاب الصلوات"
"3805","(۳۸۰۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، وَأَنَسِ بْنِ سِیرِینَ ، قَالاَ : قَالَ ابن عُمَرُ : یَکْفِیک قِرَائَۃَ الإِمَامِ۔","Sahih","Musannaf Ibn Abi Shaybah 3805","","","كتاب الصلوات"
"3806","(۳۸۰۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، وَابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ الأَسْوَدُ : لأَنْ أَعَضَّ عَلَی جَمْرَۃٍ، أَحَبُّ إلَیَّ مِنْ أَنْ أَقْرَأَ خَلْفَ إِمَامٍ أَعْلَمُ أَنَّہُ یَقْرَأُ۔","","Musannaf Ibn Abi Shaybah 3806","","","كتاب الصلوات"
"3807","(۳۸۰۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ ، عَنْ عُبَیْدِ اللہِ بْنِ مِقْسَمٍ ، عَنْ جَابِرٍ ، قَالَ : لاَ تَقْرَأْ خَلْفَ الإِمَامِ۔","Hasan","Musannaf Ibn Abi Shaybah 3807","","","كتاب الصلوات"
"3808","(۳۸۰۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنِ ابْنِ ثَوْبَانَ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ: لاَ تَقْرَأْ خَلْفَ الإِمَامِ إِنْ جَہَرَ ، وَلاَ إِنْ خَافَتَ۔","Hasan","Musannaf Ibn Abi Shaybah 3808","","","كتاب الصلوات"
"3809","(۳۸۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ مُحَمَّدٍ ، عَنْ مُوسَی بْنِ سَعْدٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : مَنْ قَرَأَ خَلْفَ الإِمَامِ فَلاَ صَلاَۃَ لَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 3809","","","كتاب الصلوات"
"3810","(۳۸۱۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ وَبَرَۃَ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، أَنَّہُ قَالَ : وَدِدْت أَنَّ الَّذِی یَقْرَأُ خَلْفَ الإِمَامِ مُلِیئَ فُوہُ تُرَابًا۔","","Musannaf Ibn Abi Shaybah 3810","","","كتاب الصلوات"
"3811","(۳۸۱۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 3811","","","كتاب الصلوات"
"3812","(۳۸۱۲) حَدَّثَنَا مُعْتَمِرٌ ، حَدَّثَنَا مَعْمَرٌ ، عَنْ أَبِی ہَارُونَ ، قَالَ : سَأَلْتُ أَبَا سَعِیدٍ ، عَنِ الْقِرَائَۃِ خَلْفَ الإِمَامِ ؟ فَقَالَ: یَکْفِیک ذَاکَ الإِمَامُ۔","Da'if","Musannaf Ibn Abi Shaybah 3812","","","كتاب الصلوات"
"3813","(۳۸۱۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : سَأَلْتُہ عَنِ الْقِرَائَۃِ خَلْفَ الإِمَامِ ؟ قَالَ : لَیْسَ وَرَائَ الإِمَامِ قِرَائَۃٌ۔","","Musannaf Ibn Abi Shaybah 3813","","","كتاب الصلوات"
"3814","(۳۸۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : أَنْصِتْ لِلإِمَامِ۔","","Musannaf Ibn Abi Shaybah 3814","","","كتاب الصلوات"
"3815","(۳۸۱۵) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ أَعْلَمُ الْقِرَائَۃَ خَلْفَ الإِمَامِ مِنَ السُّنَّۃِ۔","","Musannaf Ibn Abi Shaybah 3815","","","كتاب الصلوات"
"3816","(۳۸۱۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ الْقِرَائَۃَ خَلْفَ الإِمَامِ ، وَکَانَ یَقُولُ : تَکْفِیک قِرَائَۃُ الإِمَامِ۔","","Musannaf Ibn Abi Shaybah 3816","","","كتاب الصلوات"
"3817","(۳۸۱۷) حَدَّثَنَا الْفَضْلُ ، عَنْ زُہَیْرٍ ، عَنِ الْوَلِیدِ بْنِ قَیْسٍ ، قَالَ : سَأَلْتُ سُوَیْد بْنَ غَفَلَۃَ : أَقْرَأُ خَلْفَ الإِمَامِ فِی الظُّہْرِ وَالْعَصْرِ ؟ فَقَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 3817","","","كتاب الصلوات"
"3818","(۳۸۱۸) حَدَّثَنَا الْفَضْلُ ، عَنْ أَبِی کِبْران ، قَالَ : کَانَ الضَّحَّاکُ یَنْہَی عَنِ الْقِرَائَۃِ خَلْفَ الإِمَامِ۔","","Musannaf Ibn Abi Shaybah 3818","","","كتاب الصلوات"
"3819","(۳۸۱۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنْ مَالِکِ بْنِ عُمَارَۃَ ، قَالَ : سَأَلْتُ ، لاَ أَدْرِی ، کَمْ رَجُلٍ مِنْ أَصْحَابِ عَبْدِ اللہِ کُلُّہُمْ یَقُولُ : لاَ یُقْرَأُ خَلْفَ إمَامٍ ، مِنْہُمْ عَمْرُو بْنُ مَیْمُونٍ۔","","Musannaf Ibn Abi Shaybah 3819","","","كتاب الصلوات"
"3820","(۳۸۲۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّمَا جُعِلَ الإِمَامُ لِیُؤْتَمَّ بِہِ ، فَإِذَا کَبَّرَ فَکَبِّرُوا ، وَإِذَا قَرَأَ فَأَنْصِتُوا۔n(ابوداؤد ۶۰۴۔ احمد ۲/۳۷۶)","Hasan","Musannaf Ibn Abi Shaybah 3820","","","كتاب الصلوات"
"3821","(۳۸۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ أُکَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : الَّذِی یَقْرَأُ خَلْفَ الإِمَامِ مُشَاقٌّ۔","","Musannaf Ibn Abi Shaybah 3821","","","كتاب الصلوات"
"3822","(۳۸۲۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ، عَنْ مِسْعَرٍ، عَنْ عَمْرِو بْنِ مُرَّۃَ، عَنْ أَبِی وَائِلٍ، قَالَ: یَکْفِیک قِرَائَۃُ الإِمَامِ۔","","Musannaf Ibn Abi Shaybah 3822","","","كتاب الصلوات"
"3823","(۳۸۲۳) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : کُلُّ مَنْ کَانَ لَہُ إمَامٌ ، فَقِرَائَ تُہُ لَہُ قِرَائَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 3823","","","كتاب الصلوات"
"3824","(۳۸۲۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ طَلْحَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَۃَ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ وَمَلاَئِکَتَہُ یُصَلُّونَ عَلَی الصَّفِّ الأَوَّلِ۔n(ابوداؤد ۶۶۴۔ احمد ۴/۶۸۴)","Sahih","Musannaf Ibn Abi Shaybah 3824","","","كتاب الصلوات"
"3825","(۳۸۲۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ عَمَّارِ بْنِ رُزَیْقٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَۃَ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ اللَّہَ وَمَلاَئِکَتَہُ یُصَلُّونَ عَلَی الصُّفُوفِ الأُوَلِ۔n(احمد ۴/۲۹۹۔ ابن خزیمۃ ۱۵۵۲)","","Musannaf Ibn Abi Shaybah 3825","","","كتاب الصلوات"
"3826","(۳۸۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ فِرَاسٍ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : إنَّ اللَّہَ وَمَلاَئِکَتَہُ یُصَلُّونَ عَلَی الصَّفِّ الْمُقَدَّمِ۔","","Musannaf Ibn Abi Shaybah 3826","","","كتاب الصلوات"
"3827","(۳۸۲۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ یُقَالُ : خَیْرُ صُفُوفِ الرِّجَالِ مُقَدَّمُہَا ، وَشَرُّ صُفُوفِ النِّسَائِ مُقَدِّمُہَا۔","","Musannaf Ibn Abi Shaybah 3827","","","كتاب الصلوات"
"3828","(۳۸۲۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ ضِرَارٍ ، عَنْ زَاذَانَ ، قَالَ : لَوْ یَعْلَمُ النَّاسُ مَا فِی الصَّفِّ الْمُقَدَّمِ ، مَا قَدَرُوا عَلَیْہِ إِلاَّ بِقُرْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 3828","","","كتاب الصلوات"
"3829","(۳۸۲۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ یُقَالُ : إنَّ اللَّہَ وَمَلاَئِکَتَہُ یُصَلُّونَ عَلَی الَّذِینَ یُصَلُّونَ فِی الصُّفُوفِ الأُوَلِ۔","","Musannaf Ibn Abi Shaybah 3829","","","كتاب الصلوات"
"3830","(۳۸۳۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حدَّثَنَا دَاوُد بْنُ أَبِی ہِنْدٍ ، قَالَ : حُدِّثْت أَنَّ رَجُلاً جَائَ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، دُلَّنِی عَلَی عَمَلٍ أَعْمَلُہُ ، قَالَ : کُنْ إمَامَ قَوْمِکَ ، قَالَ : فَإِنْ لَمْ أَسْتَطِعْ ؟ قَالَ : کُنْ مُؤَذِّنَہُمْ ، قَالَ : فَإِنْ لَمْ أَسْتَطِعْ ؟ قَالَ : فَکُنْ فِی الصَّفِّ الأَوَّلِ۔ (بخاری ۵۹)","","Musannaf Ibn Abi Shaybah 3830","","","كتاب الصلوات"
"3831","(۳۸۳۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، قَالَ : کُنْتُ مَعَ عَبْدِ اللہِ بْنِ شَدَّادٍ ، فَأَقَمْتُ الصَّلاَۃَ ، قَالَ : فَجَعَلَ یَقُولُ : تَقَدَّمُوا تَقَدَّمُوا ، فَإِنَّہُ کَانَ یُقَالُ : إنَّ اللَّہَ وَمَلاَئِکَتَہُ یُصَلُّونَ عَلَی الَّذِینَ یُصَلُّونَ فِی الصُّفُوفِ الْمُقَدَّمَۃِ۔ (عبدالرزاق ۲۴۵۴)","","Musannaf Ibn Abi Shaybah 3831","","","كتاب الصلوات"
"3832","(۳۸۳۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ عَامِرِ بْنِ مَسْعُودٍ الْقُرَشِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ یَعْلَمُ النَّاسُ مَا فِی الصَّفِّ الأَوَّلِ مَا صَفُّوا فِیہِ إِلاَّ بِقُرْعَۃٍ۔n(بخاری ۶۱۵۔ مسلم ۱۱۹)","","Musannaf Ibn Abi Shaybah 3832","","","كتاب الصلوات"
"3833","(۳۸۳۳) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا شَیْبَانُ ، عَنْ یَحْیَی ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ ، أَنَّ خَالِدَ بْنَ مَعْدَانَ حَدَّثَہُ، أَنَّ جُبَیْرَ بْنَ نُفَیْرٍ حَدَّثَہُ ، أَنَّ الْعِرْبَاضَ بْنَ سَارِیَۃَ حَدَّثَہُ ، وَکَانَ الْعِرْبَاضُ مِنْ أَصْحَابِ الصُّفَّۃِ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی عَلَی الصَّفِّ الْمُقَدَّمِ ثَلاَثًا ، وَعَلَی الثَّانِی وَاحِدَۃً۔n(احمد ۴/۱۲۶۔ ابن حبان ۶۱۵۸)","Sahih","Musannaf Ibn Abi Shaybah 3833","","","كتاب الصلوات"
"3834","(۳۸۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَیْرُ صُفُوفِ الرِّجَالِ مُقَدَّمُہَا ، وَشَرُّہَا مُؤَخَّرُہَا ، وَخَیْرُ صُفُوفِ النِّسَائِ آخِرُہَا ، وَشَرُّہَا مُقَدَّمُہَا۔(ابن ماجہ ۱۰۰۱۔ احمد ۳/۳۸۷)","Da'if","Musannaf Ibn Abi Shaybah 3834","","","كتاب الصلوات"
"3835","(۳۸۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ : سَمِعْتُ عُرْوَۃَ بْنَ الزُّبَیْرِ حِینَ أُقِیمَتِ الصَّلاَۃُ یَقُولُ : تَقَدَّمُوا ، تَقَدَّمُوا۔","","Musannaf Ibn Abi Shaybah 3835","","","كتاب الصلوات"
"3836","(۳۸۳۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْعَیْزَارِ ، عَنْ أَبِی بَصِیرٍ ، قَالَ : قَالَ أُبَیّ بْنُ کَعْبٍ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ الصَّفَّ الأَوَّلَ لَعَلَی مِثْلِ صَفِّ الْمَلاَئِکَۃِ ، وَلَوْ تَعْلَمُونَ لاَبْتَدَرْتُمُوہُ۔","Hasan","Musannaf Ibn Abi Shaybah 3836","","","كتاب الصلوات"
"3837","(۳۸۳۷) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : حدَّثَنَا زُہَیْرُ بن محمد ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَمِعَہُ یَقُولُ : خَیْرُ صُفُوفِ الرِّجَالِ الْمُقَدَّمُ ، وَشَرُّہَا الْمُؤَخَّرُ ، وَخَیْرُ صُفُوفِ النِّسَائِ الْمُؤَخَّرُ ، وَشَرُّہَا الْمُقَدَّمُ۔","Da'if","Musannaf Ibn Abi Shaybah 3837","","","كتاب الصلوات"
"3838","(۳۸۳۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ زَیْدٍ ، عَنْ مُجَاہِدٍ ، قَالَ : رَأَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الصَّفِّ الْمُقَدَّمِ رِقَّۃً ، فَقَالَ : إنَّ اللَّہَ وَمَلاَئِکَتَہُ یُصَلُّونَ عَلَی الصُّفُوفِ الأُوَلِ ، فَازْدَحَمَ النَّاسُ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 3838","","","كتاب الصلوات"
"3839","(۳۸۳۹) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : حدَّثَنَا زُہَیْرُ بْنُ مُحَمَّدٍ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، أَنَّہُ سَمِعَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إذَا قُمْتُمْ إلَی الصَّلاَۃِ فَاعْدِلُوا صُفُوفَکُمْ ، وَسُدُّوا الْفُرَجَ ، فَإِنِّی أَرَاکُمْ مِنْ وَرَائِ ظَہْرِی۔","Da'if","Musannaf Ibn Abi Shaybah 3839","","","كتاب الصلوات"
"3840","(۳۸۴۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُوسَی بْنِ مُسْلِمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ، قَالَ : مَا تَغَیَّرَتِ الأَقْدَامُ فِی شَیْئٍ أَحَبَّ إلَی اللہِ مِنْ رَقْعِ صَفٍّ۔","","Musannaf Ibn Abi Shaybah 3840","","","كتاب الصلوات"
"3841","(۳۸۴۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ ، قَالَ : رَأَی ابْنُ عُمَرَ رَجُلاً یُصَلِّی وَأَمَامُہُ فُرْجَۃٌ فِی الصَّفِّ ، فَدَفَعَہُ إلَیْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 3841","","","كتاب الصلوات"
"3842","(۳۸۴۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ ، قَالَ : صَلَّیْت إلَی جَنْبِ ابْنِ عُمَرَ ، فَرَأَی فِی الصَّفِّ فُرْجَۃً فَأَوْمَأَ إلَیَّ ، فَلَمْ أَتَقَدَّمْ ، قَالَ : فَتَقَدَّمَ ہُوَ فَسَدَّہَا۔","Sahih","Musannaf Ibn Abi Shaybah 3842","","","كتاب الصلوات"
"3843","(۳۸۴۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إیَّاکَ وَالْفُرَجَ ، یَعْنِی فِی الصَّفِّ۔","","Musannaf Ibn Abi Shaybah 3843","","","كتاب الصلوات"
"3844",") حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الْمَقْبُرِیِّ ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ سَدَّ فُرْجَۃً فِی صَفٍّ رَفَعَہُ اللَّہُ بِہَا دَرَجَۃً ، أَوْ بَنَی لَہُ بَیْتًا فِی الْجَنَّۃِ۔","","Musannaf Ibn Abi Shaybah 3844","","","كتاب الصلوات"
"3845","(۳۸۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ یُقَالُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 3845","","","كتاب الصلوات"
"3846","(۳۸۴۶) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی رَوَّادٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لأَنْ تَسْقُطَ ثَنِیَّتَایَ أَحَبّ إلَیَّ مِنْ أَنْ أَرَی فِی الصَّفِّ خَلَلاً لاَ أَسُدّہُ۔","Majhul","Musannaf Ibn Abi Shaybah 3846","","","كتاب الصلوات"
"3847","(۳۸۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عِیسَی بْنِ حَفْصٍ ، عَنْ أَبِیہِ ، قَالَ : خَرَجْنَا مَعَ ابْنِ عُمَرَ ، قَالَ : فَصَلَّیْنَا الْفَرِیضَۃَ ، فَرَأَی بَعْضَ وَلَدِہِ یَتَطَوَّعُ ، فَقَالَ ابْنُ عُمَرَ : صَلَّیْت مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبِی بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ فَلاَ صَلاَۃَ قَبْلَہَا ، وَلاَ بَعْدَہَا فِی السَّفَرِ ، وَلَوْ تَطَوَّعْت لأَتْمَمْت۔(بخاری ۱۱۰۲۔ مسلم ۴۷۹)","Sahih","Musannaf Ibn Abi Shaybah 3847","","","كتاب الصلوات"
"3848","(۳۸۴۸) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُجَاہِدٍ ، قَالَ : سَأَلْنَاہُ : أَکَانَ ابْنُ عُمَرَ یَتَطَوَّعُ فِی السَّفَرِ ؟ فَقَالَ : لاَ، فَقُلْتُ : فَرَکْعَتَان قَبْلَ الْفَجْرِ ؟ قَالَ : مَا رَأَیْتُہُ تَرَکَ تَیْنِکَ فِی سَفَرٍ ، وَلاَ حَضَرٍ۔","","Musannaf Ibn Abi Shaybah 3848","","","كتاب الصلوات"
"3849","(۳۸۴۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَتَطَوَّعُ فِی السَّفَرِ قَبْلَ الصَّلاَۃِ ، وَلاَ بَعْدَہَا ، وَکَانَ یُصَلِّی مِنَ اللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 3849","","","كتاب الصلوات"
"3850","(۳۸۵۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ مَوْلَی الأَنْصَارِ ، قَالَ : سَمِعْتُ أَبَا جَعْفَرٍ مُحَمَّدَ بْنَ عَلِیٍّ یُحَدِّثُ ، عَنْ أَبِیہِ عَلِیِّ بْنِ حُسَیْنٍ ؛ أَنَّہُ کَانَ لاَ یَتَطَوَّعُ فِی السَّفَرِ قَبْلَ الصَّلاَۃِ ، وَلاَ بَعْدَہَا۔","","Musannaf Ibn Abi Shaybah 3850","","","كتاب الصلوات"
"3851","(۳۸۵۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَبِی الْیَمَانِ ، قَالَ : رَأَیْتُ أَنَسًا یَتَطَوَّعُ فِی السَّفَرِ۔","Majhul","Musannaf Ibn Abi Shaybah 3851","","","كتاب الصلوات"
"3852","(۳۸۵۲) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ؛ أَنَّ أَبَاہُ کَانَ یَتَطَوَّعُ فِی السَّفَرِ ، وَأَنَّ عَبْدَ اللہِ کَانَ یَتَطَوَّعُ فِی السَّفَرِ۔","","Musannaf Ibn Abi Shaybah 3852","","","كتاب الصلوات"
"3853","(۳۸۵۳) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَتَطَوَّعُ فِی السَّفَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 3853","","","كتاب الصلوات"
"3854","(۳۸۵۴) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنْ رَجُلٍ یُقَالُ لَہُ : مُحَمَّدُ بْنُ قَیْسٍ ، قَالَ : دَخَلْتُ عَلَی جَابِرِ بْنِ عَبْدِ اللہِ وَہُوَ یَتَطَوَّعُ فِی السَّفَرِ۔","Hasan","Musannaf Ibn Abi Shaybah 3854","","","كتاب الصلوات"
"3855","(۳۸۵۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنْ أَبِی إِسْحَاقَ ؛ أَنَّ عَلِیًّا کَانَ لاَ یَرَی بِالتَّطَوُّعِ فِی السَّفَرِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 3855","","","كتاب الصلوات"
"3856","(۳۸۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمٍ ؛ أَنَّ عَلِیًّا تَطَوَّعَ فِی السَّفَرِ۔","Hasan","Musannaf Ibn Abi Shaybah 3856","","","كتاب الصلوات"
"3857","(۳۸۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ أُمَّ الْمُؤْمِنِینَ کَانَتْ تَتَطَوَّعُ فِی السَّفَرِ۔","","Musannaf Ibn Abi Shaybah 3857","","","كتاب الصلوات"
"3858","(۳۸۵۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، وَعَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُمَا لَمْ یَکُونَا یَرَیَانِ بَأْسًا بِالتَّطَوُّعِ فِی السَّفَرِ قَبْلَ الصَّلاَۃِ ، وَلاَ بَعْدَہَا۔","","Musannaf Ibn Abi Shaybah 3858","","","كتاب الصلوات"
"3859","(۳۸۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، قَالَ : رَأَیْتُ الْقَاسِمَ یَتَطَوَّعُ فِی السَّفَرِ۔","","Musannaf Ibn Abi Shaybah 3859","","","كتاب الصلوات"
"3860","(۳۸۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، قَالَ : رَأَیْتُ الشَّعْبِیَّ یَتَطَوَّعُ فِی السَّفَرِ۔","","Musannaf Ibn Abi Shaybah 3860","","","كتاب الصلوات"
"3861","(۳۸۶۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّ أَبَا ذَرٍّ وَعُمَرَ کَانَا یَتَطَوَّعَانِ فِی السَّفَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 3861","","","كتاب الصلوات"
"3862","(۳۸۶۲) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ یَتَطَوَّعُونَ فِی السَّفَرِ۔","","Musannaf Ibn Abi Shaybah 3862","","","كتاب الصلوات"
"3863","(۳۸۶۳) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ ، کَانَ أَبِی یُصَلِّی عَلَی إِثْرِ الْمَکْتُوبَۃِ فِی السَّفَرِ۔","","Musannaf Ibn Abi Shaybah 3863","","","كتاب الصلوات"
"3864","(۳۸۶۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، قَالَ ؛ وَافَقْنَا أَصْحَابَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَکَانُوا یُصَلُّونَ قَبْلَ الْفَرِیضَۃِ وَبَعْدَہَا ، یَعْنِی فِی السَّفَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 3864","","","كتاب الصلوات"
"3865","(۳۸۶۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، قَالَ : صَحِبْت ابْنَ عُمَرَ مِنَ الْمَدِینَۃِ إلَی مَکَّۃَ ، فَکَانَ یُصَلِّی تَطَوُّعًا عَلَی دَابَّتِہِ حَیْثُ مَا تَوَجَّہَتْ بِہِ ، فَإِذَا کَانَتِ الْفَرِیضَۃُ نَزَلَ فَصَلَّی۔","","Musannaf Ibn Abi Shaybah 3865","","","كتاب الصلوات"
"3866","(۳۸۶۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَشْعَثَ ، قَالَ : صَحِبْت أَبِی وَالأَسْوَدَ بْنَ یَزِیدَ وَعَمْرَو بْنَ مَیْمُونٍ وَأَبَا وَائِلٍ ، فَکَانُوا یُصَلُّونَ رَکْعَتَیْنِ ، ثُمَّ یُصَلُّونَ بَعْدَہَا رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 3866","","","كتاب الصلوات"
"3867","(۳۸۶۷) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، وَأَشْعَثُ ، وَحَجَّاجٍ ، عَنْ عَطِیَّۃَ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ کَانَ یَتَطَوَّعُ فِی السَّفَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 3867","","","كتاب الصلوات"
"3868","(۳۸۶۸) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ سَالِمٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَعُمَرَ کَانَا یَتَطَوَّعَانِ فِی السَّفَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 3868","","","كتاب الصلوات"
"3869","(۳۸۶۹) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا دَخَلَ الْمُسَافِرُ فِی صَلاَۃِ الْمُقِیمِینَ صَلَّی بِصَلاَتِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 3869","","","كتاب الصلوات"
"3870","(۳۸۷۰) حَدَّثَنَا حَفْصٌ ، عَنْ عبیدَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، قَالَ : یُصَلِّی بِصَلاَتِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 3870","","","كتاب الصلوات"
"3871","(۳۸۷۱) حَدَّثَنَا ہُشَیْمٌ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَنِ ابْنِ عُمَرَ ؛ فِی مُسَافِرٍ أَدْرَکَ مِنْ صَلاَۃِ الْمُقِیمِینَ رَکْعَۃً، قَالَ : یُصَلِّی مَعَہُمْ ، وَیَقْضِی مَا سُبِقَ بِہِ۔","","Musannaf Ibn Abi Shaybah 3871","","","كتاب الصلوات"
"3872","(۳۸۷۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، وَعَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالاَ : إذَا دَخَلَ الْمُسَافِرُ فِی صَلاَۃِ الْمُقِیمِینَ صَلَّی بِصَلاَتِہِمْ۔","","Musannaf Ibn Abi Shaybah 3872","","","كتاب الصلوات"
"3873","(۳۸۷۳) حَدَّثَنَا جَرِیرٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَقَامَ بِوَاسِطَ سَنَتَیْنِ یُصَلِّی رَکْعَتَیْنِ ، إِلاَّ أَنْ یُصَلِّیَ مَعَ قَوْمٍ فَیُصَلِّیَ بِصَلاَتِہِم۔","","Musannaf Ibn Abi Shaybah 3873","","","كتاب الصلوات"
"3874","(۳۸۷۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، وَیُونُسَ ، عَنِ الْحَسَنِ قَالاَ : یُصَلِّی بِصَلاَتِہِمْ۔","","Musannaf Ibn Abi Shaybah 3874","","","كتاب الصلوات"
"3875","(۳۸۷۵) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ فِی الْمُسَافِرِ یُدْرِکُ مِنْ صَلاَۃِ الْمُقِیمِینَ رَکْعَۃً ، أَوْ ثِنْتَیْنِ ؛ فَلْیُصَلِّ بِصَلاَتِہِمْ۔","","Musannaf Ibn Abi Shaybah 3875","","","كتاب الصلوات"
"3876","(۳۸۷۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قدِمْت الْمَدِینَۃَ فَأَدْرَکْت رَکْعَۃً مِنَ الْعِشَائِ ، فَجَعَلْتُ أُحَدِّثُ نَفْسِی کَیْفَ أَصْنَعُ ؟ فَذَکَرْت ذَلِکَ لِلْقَاسِمِ ، فَقَالَ : کُنْت تَرْہَبُ لَوْ صَلَّیْت أَرْبَعًا أَنْ یُعَذِّبَک اللَّہُ؟","","Musannaf Ibn Abi Shaybah 3876","","","كتاب الصلوات"
"3877","(۳۸۷۷) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ رَبَاحِ بْنِ أَبِی مَعْرُوفٍ ، عَنْ عَطَائٍ ، قَالَ ، إذَا أَدْرَکْت مِنْ صَلاَۃِ الْمُقِیمِینَ رَکْعَۃً فَصَلِّ بِصَلاَتِہِمْ۔","","Musannaf Ibn Abi Shaybah 3877","","","كتاب الصلوات"
"3878","(۳۸۷۸) حَدَّثَنَا عَبْدُالسَّلاَمِ، عَنْ سُلَیْمَانَ التَّیْمِیِّ، عَنْ أَبِی مِجْلَزٍ، عَنِ ابْنِ عُمَرَ؛ فِی الْمُسَافِرِ فِی صَلاَۃِ الْمُقِیمِینَ، قَالَ : یُصَلِّی بِصَلاَتِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 3878","","","كتاب الصلوات"
"3879","(۳۸۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمُخْتَارُ بْنُ عَمْرٍو الأَزْدِیُّ ، قَالَ : سَأَلْتُ جَابِرَ بْنَ زَیْدٍ عَنِ الصَّلاَۃِ فِی السَّفَرِ ؟ قَالَ : فَقَالَ : إذَا صَلَّیْت وَحْدَک فَصَلِّ رَکْعَتَیْنِ ، وَإِذَا صَلَّیْت فِی جَمَاعَۃٍ فَصَلِّ بِصَلاَتِہِمْ۔","","Musannaf Ibn Abi Shaybah 3879","","","كتاب الصلوات"
"3880","(۳۸۸۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : أَقَمْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَامَ الْفَتْحِ بِمَکَّۃَ ، فَأَقَامَ ثَمَانَ عَشْرَۃَ لَیْلَۃً لاَ یُصَلِّی إِلاَّ رَکْعَتَیْنِ ، ثُمَّ یَقُولُ لأَہْلِ الْبَلَدِ: صَلُّوا أَرْبَعًا ، فَإِنَّا قَوْمٌ سَفْرٌ۔ (ترمذی ۵۴۵۔ ابوداؤد ۱۲۲۲)","Da'if","Musannaf Ibn Abi Shaybah 3880","","","كتاب الصلوات"
"3881","(۳۸۸۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنْ عُمَرَ (ح) وَعَنْ سُفْیَانَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِیہِ ، عَنْ عُمَرَ (ح) وَعَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عُمَرَ ؛ أَنَّہُ صَلَّی بِمَکَّۃَ رَکْعَتَیْنِ ، ثُمَّ قَالَ : إنَّا قَوْمٌ سَفْرٌ ، فَأَتِمُّوا الصَّلاَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 3881","","","كتاب الصلوات"
"3882","(۳۸۸۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عُمَرَ ، بِمِثْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 3882","","","كتاب الصلوات"
"3883","(۳۸۸۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن حَمَّادٍ ، عَنْ عُمَرَ ، بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 3883","","","كتاب الصلوات"
"3884","(۳۸۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : صَلَّیْت مَعَ عُمَرَ رَکْعَتَیْنِ بِمَکَّۃَ ، ثُمَّ قَالَ : یَا أَہْلَ مَکَّۃَ ، إنَّا قَوْمٌ سَفْرٌ ، فَأَتِمُّوا الصَّلاَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 3884","","","كتاب الصلوات"
"3885","(۳۸۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِیہِ ، عَنْ عُمَر (ح) وَعَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، عَنْ عُمَرَ ، مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 3885","","","كتاب الصلوات"
"3886","(۳۸۸۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی إلَی بَعِیرِہِ۔ (بخاری ۴۳۰۔ ابوداؤد ۶۹۲)","Hasan","Musannaf Ibn Abi Shaybah 3886","","","كتاب الصلوات"
"3887","(۳۸۸۷) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، عَنْ إسْرَائِیلَ ، عَنْ زِیَادِ الْمُصَفِّرِ ، عَنِ الْحَسَنِ ، عَنِ الْمِقْدَامِ الرَّہَاوِیِّ ، قَالَ : جَلَسَ عُبَادَۃُ بْنُ الصَّامِتِ ، وَأَبُو الدَّرْدَائِ ، وَالْحَارِثُ بْنُ مُعَاوِیَۃَ ، فَقَالَ أَبُو الدَّرْدَائِ : أَیُّکُمْ یَذْکُرُ حَدِیثَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ صَلِّی إلَی بَعِیرٍ مِنَ الْمَغْنَمِ ، قَالَ عُبَادَۃُ : أَنَا ، قَالَ : فَحَدِّثْ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی بَعِیرٍ مِنَ الْمَغْنَمِ۔ (ابن ماجہ ۲۸۵۰)","Majhul","Musannaf Ibn Abi Shaybah 3887","","","كتاب الصلوات"
"3888","(۳۸۸۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ دَاوُدَ ، عَنْ أَبِی سَلاَّمٍ ، قَالَ : حدَّثَنَا أَبُو إدْرِیسَ الْخَوْلاَنِیُّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی إلَی صَفْحَۃِ بَعِیرٍ۔","","Musannaf Ibn Abi Shaybah 3888","","","كتاب الصلوات"
"3889","(۳۸۸۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو قَالَ : کَانَ ابْنُ عُمَرَ یُصَلِّی إلَی الْبَعِیرِ إذَا کَانَ عَلَیْہِ رَحْلٌ۔","Sahih","Musannaf Ibn Abi Shaybah 3889","","","كتاب الصلوات"
"3890","(۳۸۹۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُعَرِّضُ رَاحِلَتَہُ وَیُصَلِّی إلَیْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 3890","","","كتاب الصلوات"
"3891","(۳۸۹۱) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَاصِمٍ ، قَالَ : رَأَیْتُ أَنَسًا یُصَلِّی وَبَیْنَہُ وَبَیْنَ الْقِبْلَۃِ بَعِیرٌ عَلَیْہِ مَحْمَلٌ۔","Sahih","Musannaf Ibn Abi Shaybah 3891","","","كتاب الصلوات"
"3892","(۳۸۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، قَالَ : رَأَیْتُ سُوَیْد بْنَ غَفَلَۃَ یُنِیخُ رَاحِلَتَہُ فِی طَرِیقِ مَکَّۃَ ، فَیُصَلِّی إلَیْہَا۔","","Musannaf Ibn Abi Shaybah 3892","","","كتاب الصلوات"
"3893","(۳۸۹۳) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنِ الأَسْوَدِ ؛ أَنَّہُ کَانَ یُصَلِّی إلَی رَاحِلَتِہِ وَہِیَ أَمَامَہُ مُنَاخَۃٌ۔","","Musannaf Ibn Abi Shaybah 3893","","","كتاب الصلوات"
"3894","(۳۸۹۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، قَالَ : رَأَیْتُ الْقَاسِمَ وَسَالِمًا یُصَلِّیَانِ إلَی بَعِیرَیْہِمَا۔","","Musannaf Ibn Abi Shaybah 3894","","","كتاب الصلوات"
"3895","(۳۸۹۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : یَسْتَتِرُ بِالْبَعِیرِ۔","","Musannaf Ibn Abi Shaybah 3895","","","كتاب الصلوات"
"3896","(۳۸۹۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ أَنْ یَسْتَتِرَ بِالْبَعِیرِ۔","","Musannaf Ibn Abi Shaybah 3896","","","كتاب الصلوات"
"3897","(۳۸۹۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ، عَنْ عَبْدِ اللہِ بْنِ مُغَفَّلٍ الْمُزَنِیّ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلُّوا فِی مَرَابِضِ الْغَنَمِ ، وَلاَ تُصَلُّوا فِی أَعْطَانِ الإِبِلِ ، فَإِنَّہَا خُلِقَتْ مِنَ الشَّیَاطِینِ۔n(ابن ماجہ ۷۶۹۔ ابن حبان ۱۷۰۲)","Hasan","Musannaf Ibn Abi Shaybah 3897","","","كتاب الصلوات"
"3898","(۳۸۹۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الصَّلاَۃِ فِی مَبَارِکِ الإِبِلِ ؟ فَقَالَ : لاَ تُصَلُّوا فِیہَا ، وَسُئِلَ عَنِ الصَّلاَۃِ فِی مَرَابِضِ الْغَنَمِ ؟ فَقَالَ : صَلُّوا فِیہَا ، فَإِنَّہَا بَرَکَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 3898","","","كتاب الصلوات"
"3899","(۳۸۹۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْبَرَائِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، نَحْوَہُ ، وَلَمْ یَذْکُرْ : فَإِنَّہَا بَرَکَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 3899","","","كتاب الصلوات"
"3900","(۳۹۰۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا لَمْ تَجِدُوا إِلاَّ مَرَابِضَ الْغَنَمِ وَمَعَاطِنَ الإِبِلِ فَصَلُّوا فِی مَرَابِضِ الْغَنَمِ ، وَلاَ تُصَلُّوا فِی أَعْطَانِ الإِبِلِ۔ (ترمذی ۳۴۸۔ ابن حبان ۱۳۸۴)","Sahih","Musannaf Ibn Abi Shaybah 3900","","","كتاب الصلوات"
"3901","(۳۹۰۱) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنَا عَبْدُ الْمَلِکِ بْنُ الرَّبِیعِ بْنِ سَبْرَۃَ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یُصَلَّی فِی أَعْطَانِ الإِبِلِ وَیُصَلَّی فِی مُرَاحِ الْغَنَمِ ۔n(احمد ۳/۱۰۲۔ دارقطنی ۲۷۶)","Da'if","Musannaf Ibn Abi Shaybah 3901","","","كتاب الصلوات"
"3902","(۳۹۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ جَعْفَرِ بْنِ أَبِی ثَوْرٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : یُصَلَّی فِی مَرَابِضِ الْغَنَمِ ، وَلاَ یُصَلَّی فِی أَعْطَانِ الإِبِلِ۔","Sahih","Musannaf Ibn Abi Shaybah 3902","","","كتاب الصلوات"
"3903","(۳۹۰۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ حُسَیْنٍ الْمُعَلِّمِ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ مَاعِزِ بْنِ نَضْلَۃَ ، قَالَ : أَتَانَا أَبُو ذَرٍّ ، فَدَخَلَ زَرْبَ غَنَمٍ لَنَا ، فَصَلَّی فِیہِ۔","Majhul","Musannaf Ibn Abi Shaybah 3903","","","كتاب الصلوات"
"3904","(۳۹۰۴) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : حدَّثَنِی رَجُلٌ سَأَلَ عَبْدَ اللہِ بْنَ عُمَرَ عَنِ الصَّلاَۃِ فِی أَعْطَانِ الإِبِلِ ؟ قَالَ : فَنَہَاہُ ، وَقَالَ : صَلِّ فِی مُرَاحِ الْغَنَمِ۔","Majhul","Musannaf Ibn Abi Shaybah 3904","","","كتاب الصلوات"
"3905","(۳۹۰۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی التَّیَّاحِ ، عَنْ أَنَسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی فِی مَرَابِضِ الْغَنَمِ قَبْلَ أَنْ یُبْنَی الْمَسْجِدُ۔ (بخاری ۴۲۹۔ مسلم ۳۷۴)","Sahih","Musannaf Ibn Abi Shaybah 3905","","","كتاب الصلوات"
"3906","(۳۹۰۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الرَّحْمَنِ ؛ أَنَّ عُمَرَ صَلَّی فِی مَکَان فِیہِ دِمَنٌ۔","","Musannaf Ibn Abi Shaybah 3906","","","كتاب الصلوات"
"3907","(۳۹۰۷) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ صَخْرِ بْنِ جُوَیْرِیَۃَ ، عَنْ عَاصِمِ بْنِ الْمُنْذِرِ ، قَالَ : خَرَجَ ابْنُ الزُّبَیْرِ إلَی الْمُزْدَلِفَۃِ فِی غَیْرِ أَشْہُرِ الْحَجِّ ، فَصَلَّی بِنَا فِی مُرَاحِ الْغَنَمِ ، وَہُوَ یَجِدُ أَمْکِنَۃً سِوَاہَا ، لَوْ شَائَ لَصَلَّی فِیہِمَا ، وَمَا رَأَیْتُہ فَعَلَ ذَلِکَ إِلاَّ لِیُرِیَنَا۔","Hasan","Musannaf Ibn Abi Shaybah 3907","","","كتاب الصلوات"
"3908","(۳۹۰۸) حَدَّثَنَا أَبُو دَاوُدَ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، قَالَ : سَمِعْتُ مُحَمَّدًا یَقُولُ : کَانُوا إذَا لَمْ یَجِدُوا إِلاَّ أَنْ یُصَلُّوا فِی مَرَابِضِ الْغَنَمِ وَمَرَابِضِ الإِبِلِ ، صَلَّوْا فِی مَرَابِضِ الْغَنَمِ۔","","Musannaf Ibn Abi Shaybah 3908","","","كتاب الصلوات"
"3909","(۳۹۰۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : صَلِّ فِی دِمَنِ الْغَنَمِ۔","","Musannaf Ibn Abi Shaybah 3909","","","كتاب الصلوات"
"3910","(۳۹۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَبَّادِ بْنِ رَاشِدٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہ الصَّلاَۃَ فِی أَعْطَانِ الإِبِلِ ، وَلاَ یَرَی بِہَا بَأْسًا فِی أَعْطَانِ الْغَنَمِ۔","","Musannaf Ibn Abi Shaybah 3910","","","كتاب الصلوات"
"3911","(۳۹۱۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی حَمْزَۃَ ، قَالَ : سَمِعْتُ عُبَیْدَ بْنَ عُمَیْرٍ یَقُولُ : إنَّ لِی لَعَنَاقًا تَنَامُ مَعِی فِی مَسْجِدِی ، وَتَبْعَرُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 3911","","","كتاب الصلوات"
"3912","(۳۹۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ جُنْدُبِ بْنِ عَامِرٍ السُّلَمِیِّ ؛ أَنَّہُ کَانَ یُصَلِّی فِی أَعْطَانِ الإِبِلِ وَمَرَابِضِ الْغَنَمِ۔","","Musannaf Ibn Abi Shaybah 3912","","","كتاب الصلوات"
"3913","(۳۹۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَمَّنْ سَمِعَ جَابِرَ بْنَ سَمُرَۃَ یَقُولُ : کُنَّا نُصَلِّی فِی مَرَابِضِ الْغَنَمِ ، وَلاَ نُصَلِّی فِی أَعْطَانِ الإِبِلِ۔","Majhul","Musannaf Ibn Abi Shaybah 3913","","","كتاب الصلوات"
"3914","(۳۹۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، قَالَ : حَدَّثَنِی رَجُلٌ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : صَلُّوا فِی مَرَابِضِ الْغَنَمِ ، وَلاَ تُصَلُّوا فِی أَعْطَانِ الإِبِلِ۔","Majhul","Musannaf Ibn Abi Shaybah 3914","","","كتاب الصلوات"
"3915","(۳۹۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِالصَّلاَۃِ فِی دِمْنَۃِ الْغَنَمِ۔","","Musannaf Ibn Abi Shaybah 3915","","","كتاب الصلوات"
"3916","(۳۹۱۶) حَدَّثَنَا وَکِیعٌ ؛ فِی رَجُلٍ صَلَّی فِی أَعْطَانِ الإِبِلِ یُجْزِئُہُ ، وَلاَ یَتَوَضَّأُ مِنْ لُحُومِ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 3916","","","كتاب الصلوات"
"3917","(۳۹۱۷) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ جَعْفَرِ بْنِ أَبِی ثَوْرٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : أَمَرَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ نُصَلِّیَ فِی مَرَابِضِ الْغَنَمِ ، وَلاَ نُصَلِّیَ فِی أَعْطَانِ الإِبِلِ۔","Sahih","Musannaf Ibn Abi Shaybah 3917","","","كتاب الصلوات"
"3918","(۳۹۱۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنْ قَطْرَۃِ بَوْلٍ أَصَابَتْ خُفًّا ؟ فَقَالَ أَحَدُہُمَا : یُعِیدُ ، وَقَالَ الأَخَرُ : لاَ یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 3918","","","كتاب الصلوات"
"3919","(۳۹۱۹) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ وَقَدْ ذَکَرَ عِدَّۃً مِنْہُمْ أَبُو جَعْفَرٍ ؛ أَنَّہُمْ کَانُوا لاَ یُعِیدُونَ الصَّلاَۃَ مِنْ نَضْحِ الْبَوْلِ وَالدَّمِ۔","","Musannaf Ibn Abi Shaybah 3919","","","كتاب الصلوات"
"3920","(۳۹۲۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا صَلَّی الرَّجُلُ فَوَجَدَ بَعْدَ مَا صَلَّی فِی ثَوْبِہِ ، أَوْ جِلْدِہِ قَطْرَۃً ، أَوْ بَوْلاً غَسَلَہُ وَأَعَادَ الصَّلاَۃَ ، وَإذَا وَجَدَ فِی جِلْدِہِ مَنِیًّا ، أَوْ دَمًا ، غَسَلَہُ وَلَمْ یُعِدِ الصَّلاَۃَ۔","","Musannaf Ibn Abi Shaybah 3920","","","كتاب الصلوات"
"3921","(۳۹۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَعْفَرٍ الرَّازِیّ ، عَنِ الرَّبِیعِ بْنِ أَنَسٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : التَّبَسُّمُ فِی الصَّلاَۃِ لَیْسَ بِشَیْئٍ۔","Majhul","Musannaf Ibn Abi Shaybah 3921","","","كتاب الصلوات"
"3922","(۳۹۲۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ، عَنْ أَبِی الزُّبَیْرِ، عَنْ جَابِرٍ، قَالَ: التَّبَسُّمُ لاَ یَقْطَعُ، وَلَکِنْ تَقْطَعُ الْقَرْقَرَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 3922","","","كتاب الصلوات"
"3923","(۳۹۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : التَّبَسُّمُ فِی الصَّلاَۃِ لَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 3923","","","كتاب الصلوات"
"3924","(۳۹۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : التَّبَسُّمُ فِی الصَّلاَۃِ لَیْسَ بِشَیْئٍ حَتَّی یُقَرْقِرَ۔","","Musannaf Ibn Abi Shaybah 3924","","","كتاب الصلوات"
"3925","(۳۹۲۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ (ح) وَہِشَامٌ ، عَنِ الْحَسَنِ ؛ أَنَّہُمَا لَمْ یَرَیَا بِالتَّبَسُّمِ فِی الصَّلاَۃِ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 3925","","","كتاب الصلوات"
"3926","(۳۹۲۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ سُئِلَ عَنِ التَّبَسُّمِ فِی الصَّلاَۃِ ؟ فَقَرَأَ ہَذِہِ الآیَۃَ : {فَتَبَسَّمَ ضَاحِکًا مِنْ قَوْلِہَا} لاَ أَعْلَمُ التَّبَسُّمَ إِلاَّ ضَحِکًا۔","","Musannaf Ibn Abi Shaybah 3926","","","كتاب الصلوات"
"3927","(۳۹۲۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ قَالَ : کَانَ الْحَسَنُ بْنُ مُسْلِمٍ إِذَا رَآنِی تَبَسَّمَ فِی وَجْہِی ، وَہُوَ فِی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 3927","","","كتاب الصلوات"
"3928","(۳۹۲۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ شَیْبَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ بَأْسَ بِالتَّبَسُّمِ۔","","Musannaf Ibn Abi Shaybah 3928","","","كتاب الصلوات"
"3929","(۳۹۲۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : إذَا ضَحِکَ الرَّجُلُ فِی الصَّلاَۃِ ، أَعَادَ الصَّلاَۃَ وَلَمْ یُعِدِ الْوُضُوئَ۔","Hasan","Musannaf Ibn Abi Shaybah 3929","","","كتاب الصلوات"
"3930","(۳۹۳۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، قَالَ : ضَحِکْت خَلْفَ أَبِی وَأَنَا فِی الصَّلاَۃِ ، فَأَمَرَنِی أَنْ أُعِیدَ الصَّلاَۃَ۔","","Musannaf Ibn Abi Shaybah 3930","","","كتاب الصلوات"
"3931","(۳۹۳۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، قَالَ : ضَحِکْتُ وَأَنَا أُصَلِّی مَعَ أَبِی ، فَأَمَرَنِی أَنْ أُعِیدَ الصَّلاَۃَ۔","","Musannaf Ibn Abi Shaybah 3931","","","كتاب الصلوات"
"3932","(۳۹۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : یُعِیدُ الصَّلاَۃَ ، وَلاَ یُعِیدُ الْوُضُوئَ۔","","Musannaf Ibn Abi Shaybah 3932","","","كتاب الصلوات"
"3933","(۳۹۳۳) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامٍ ، قَالَ : ضَحِکَ أَخِی فِی الصَّلاَۃِ ، فَأَمَرَہُ عُرْوَۃُ أَنْ یُعِیدَ الصَّلاَۃَ ، وَلَمْ یَأْمُرْہُ أَنْ یُعِیدَ الْوُضُوئَ۔","","Musannaf Ibn Abi Shaybah 3933","","","كتاب الصلوات"
"3934","(۳۹۳۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَضْحَکُ فِی الصَّلاَۃِ ، فَقَالَ : إِنْ تَبَسَّمَ فَلاَ یَنْصَرِفُ ، وَإِنْ قَہْقَہَ اسْتَقْبَلَ الصَّلاَۃَ ، وَلَیْسَ عَلَیْہِ وُضُوئٌ۔","","Musannaf Ibn Abi Shaybah 3934","","","كتاب الصلوات"
"3935","(۳۹۳۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، قَالَ : کَانُوا فِی سَفَرٍ فَصَلَّی بِہِمْ أَبُو مُوسَی ، فَسَقَطَ رَجُلٌ أَعْوَرُ فِی بِئْرٍ ، أَوْ شَیْئٍ فَضَحِکَ الْقَوْمُ کُلُّہُمْ غَیْرُ أَبِی مُوسَی وَالأَحْنَفِ ، فَأَمَرَہُمْ أَنْ یُعِیدُوا الصَّلاَۃَ۔","","Musannaf Ibn Abi Shaybah 3935","","","كتاب الصلوات"
"3936","(۳۹۳۶) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یَأْمُرُونَنَا وَنَحْنُ صِبْیَانٌ إذَا ضَحِکْنَا فِی الصَّلاَۃِ أَنْ نُعِیدَ الصَّلاَۃَ۔","","Musannaf Ibn Abi Shaybah 3936","","","كتاب الصلوات"
"3937","(۳۹۳۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ یَضْحَکُ فِی الصَّلاَۃِ ، قَالَ : یُکَبِّرُ وَیُعِیدُ الصَّلاَۃَ۔","","Musannaf Ibn Abi Shaybah 3937","","","كتاب الصلوات"
"3938","(۳۹۳۸) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی بِأَصْحَابِہِ ، فَجَائَ رَجُلٌ ضَرِیرُ الْبَصَرِ ، فَوَقَعَ فِی بِئْرٍ فِی الْمَسْجِدِ ، فَضَحِکَ بَعْضُ أَصْحَابِہِ ، فَلَمَّا أنْصَرَفَ أَمَرَ مَنْ ضَحِکَ أَنْ یُعِیدَ الْوُضُوئَ وَالصَّلاَۃَ۔ (دارقطنی ۴۲۔ عبدالرزاق ۳۷۶۳)","","Musannaf Ibn Abi Shaybah 3938","","","كتاب الصلوات"
"3939","(۳۹۳۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ ، قَالَ : ہِیَ فِتْنَۃٌ ، یُعِیدُ الْوُضُوئَ وَالصَّلاَۃَ۔","","Musannaf Ibn Abi Shaybah 3939","","","كتاب الصلوات"
"3940","(۳۹۴۰) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا ضَحِکَ الرَّجُلُ فِی الصَّلاَۃِ أَعَادَ الْوُضُوئَ وَالصَّلاَۃَ۔nقالَ أَبُو بَکْرٍ : یُعِیدُ الصَّلاَۃَ ، وَلاَ یُعِیدُ الْوُضُوئَ۔","","Musannaf Ibn Abi Shaybah 3940","","","كتاب الصلوات"
"3941","(۳۹۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُسْتَحَبُّ لِمَنْ صَلَّی وَہُوَ قَاعِدٌ ، أَنْ یُصَلِّیَ رَکْعَتَیْنِ وَہُوَ قَائِمٌ۔","","Musannaf Ibn Abi Shaybah 3941","","","كتاب الصلوات"
"3942","(۳۹۴۲) حَدَّثَنَا حَفْصٌ، عَنْ لَیْثٍ، عَنْ طَاوُوسٍ، قَالَ: کَانَ یُسْتَحَبُّ لِمَنْ صَلَّی وَہُوَ قَاعِدٌ، أَنْ یُنشئہا وَہُوَ قَائِمٌ۔","","Musannaf Ibn Abi Shaybah 3942","","","كتاب الصلوات"
"3943","(۳۹۴۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، قَالَ : رُبَّمَا صَلَّیْت وَأَنَا قَاعِدٌ ، فَإِذَا أَرَدْت أَنْ أَرْکَعَ ، قُمْت فَقَرَأْت ، ثُمَّ رَکَعْت۔","","Musannaf Ibn Abi Shaybah 3943","","","كتاب الصلوات"
"3944","(۳۹۴۴) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی صَلاَۃَ اللَّیْلِ قَائِمًا ، فَلَمَّا دَخَلَ فِی السِّنِّ جَعَلَ یُصَلِّی جَالِسًا ، فَإِذَا بَقِیَتْ عَلَیْہِ ثَلاَثُونَ ، أَوْ أَرْبَعُونَ قَامَ فَقَرَأَہَا ، ثُمَّ سَجَدَ۔ (بخاری ۱۱۴۸۔ ابوداؤد ۹۵۰)","Sahih","Musannaf Ibn Abi Shaybah 3944","","","كتاب الصلوات"
"3945","(۳۹۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی وَہُوَ جَالِسٌ ، فَإِذَا بَقِیَ مِنَ السُّورَۃِ ثَلاَثُونَ آیَۃً ، أَوْ أَرْبَعُونَ آیَۃً قَامَ فَقَرَأَ ثُمَّ رَکَعَ۔ (مسلم ۵۰۵)","Sahih","Musannaf Ibn Abi Shaybah 3945","","","كتاب الصلوات"
"3946","(۳۹۴۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ عَوْفٍ ، عَنْ مُحَمَّدٍ ، قَالَ : مَنْ قَرَأَ وَہُوَ قَاعِدٌ ، فَإِنَّہُ یَرْکَعُ وَیَسْجُدُ وَہُوَ قَاعِدٌ ، وَمَنْ قَرَأَ وَہُوَ قَائِمٌ ، فَإِنَّہُ یَرْکَعُ وَیَسْجُدُ وَہُوَ قَائِمٌ ۔ وَقَالَ الْحَسَنُ : ہُوَ بِالْخِیَارِ ، أَیَّ ذَلِکَ شَائَ فَعَلَ۔","","Musannaf Ibn Abi Shaybah 3946","","","كتاب الصلوات"
"3947","(۳۹۴۷) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ أَنْ یُصَلِّیَ الرَّجُلُ رَکْعَۃً قَائِمًا ، وَرَکْعَۃً قَاعِدًا۔","","Musannaf Ibn Abi Shaybah 3947","","","كتاب الصلوات"
"3948","(۳۹۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ وَحَمَّادٍ قَالاَ : لاَ بَأْسَ أَنْ یُصَلِّیَ الرَّجُلُ رَکْعَۃً قَائِمًا ، وَرَکْعَۃً قَاعِدًا۔ ثُمَّ قَالَ : حَدَّثَنَا وَکِیعٌ بِآخِرَۃٍ : عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَلَمْ یَذْکُرْ حَمَّادًا۔","","Musannaf Ibn Abi Shaybah 3948","","","كتاب الصلوات"
"3949","(۳۹۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ لاَ یُصَلِّی رَکْعَتَیِ الْفَجْرِ فِی السَّفَرِ۔","Sahih","Musannaf Ibn Abi Shaybah 3949","","","كتاب الصلوات"
"3950","(۳۹۵۰) حَدَّثَنَا جَرِیرٌ ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ: أَمَّا مَا لَمْ یَدَعْ صَحِیحًا ، وَلاَ مَرِیضًا فِی سَفَرٍ، وَلاَ حَضَرٍ غَائِبًا ، وَلاَ شَاہِدًا ، تَعْنِی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَرَکْعَتَانِ قَبْلَ الْفَجْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 3950","","","كتاب الصلوات"
"3951","(۳۹۵۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، قَالَ : سَمِعْتُ عَمْرَو بْنَ مَیْمُونٍ الأَوْدِیَّ یَقُولُ : کَانُوا لاَ یَتْرُکُونَ أَرْبَعًا قَبْلَ الظُّہْرِ ، وَرَکْعَتَیْنِ قَبْلَ الْفَجْرِ عَلَی حَالٍ۔","","Musannaf Ibn Abi Shaybah 3951","","","كتاب الصلوات"
"3952","(۳۹۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حَبِیبِ بْنِ جُرَیٍّ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یَدَعُ الرَّکْعَتَیْنِ بَعْدَ الْمَغْرِبِ ، وَالرَّکْعَتَیْنِ قَبْلَ الْفَجْرِ فِی حَضَرٍ ، وَلاَ سَفَرٍ۔","","Musannaf Ibn Abi Shaybah 3952","","","كتاب الصلوات"
"3953","(۳۹۵۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حَدَّثَنَا ابْنُ عَوْنٍ ، عَنْ مُجَاہِدٍ ، قَالَ : سَأَلْتُہُ أَکَانَ ابْنُ عُمَرَ یُصَلِّی رَکْعَتَیِ الْفَجْرِ؟ قَالَ : مَا رَأَیْتُہُ یَتْرُکُ شَیْئًا فِی سَفَرٍ ، وَلاَ حَضَرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 3953","","","كتاب الصلوات"
"3954","(۳۹۵۴) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنَا مُعَاوِیَۃُ بْنُ صَالِحٍ ، قَالَ : حَدَّثَنِی یُونُسُ بْنُ سَیْفٍ العَنَسِیُّ ، عَنِ الْحَارِثِ بْنِ غُطَیْفٍ ، أَوْ غُضَیْفِ بْنِ الْحَارِثِ الْکِنْدِیِّ ، شَکَّ مُعَاوِیَۃُ ، قَالَ : مَہْمَا رَأَیْتُ نَسِیتُ لَمْ أَنْسَ أَنِّی رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَضَعَ یَدَہُ الْیُمْنَی عَلَی الْیُسْرَی ، یَعْنِی فِی الصَّلاَۃِ۔n(احمد ۴/۱۰۵۔ طبرانی ۳۳۹۹)","","Musannaf Ibn Abi Shaybah 3954","","","كتاب الصلوات"
"3955","(۳۹۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سِمَاکٍ ، عَنْ قَبِیصَۃَ بْنِ ہُلْبٍ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَاضِعًا یَمِینَہُ عَلَی شِمَالِہِ فِی الصَّلاَۃِ۔ (ترمذی ۲۵۲۔ احمد ۴/۲۲۶)","Majhul","Musannaf Ibn Abi Shaybah 3955","","","كتاب الصلوات"
"3956","(۳۹۵۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنْ وَائِلِ بْنِ حُجْرٍ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ کَبَّرَ أَخَذَ شِمَالَہٗ بِیَمِینِہِ۔ (ابن ماجہ ۸۱۰)","Sahih","Musannaf Ibn Abi Shaybah 3956","","","كتاب الصلوات"
"3957","(۳۹۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ مُوَرِّقٍ الْعِجْلِیّ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : مِنْ أَخْلاَقِ النَّبِیِّینَ وَضْعُ الْیَمِینِ عَلَی الشِّمَالِ فِی الصَّلاَۃِ۔ (ابن حبان ۱۷۷۰۔ طبرانی ۱۱۴۸۵)","","Musannaf Ibn Abi Shaybah 3957","","","كتاب الصلوات"
"3958","(۳۹۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ یُوسُفَ بْنِ مَیْمُونٍ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَأَنِّی أَنْظُرُ إلَی أَحْبَارِ بَنِی إسْرَائِیلَ وَاضِعِی أَیْمَانِہِمْ عَلَی شَمَائِلِہِمْ فِی الصَّلاَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 3958","","","كتاب الصلوات"
"3959","(۳۹۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُمَیْرٍ ، عَنْ عَلْقَمَۃَ بْنِ وَائِلِ بْنِ حُجْرٍ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَضَعَ یَمِینَہُ عَلَی شِمَالِہِ فِی الصَّلاَۃِ تَحْتَ السُّرَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 3959","","","كتاب الصلوات"
"3960","(۳۹۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَضَعُ یَمِینَہُ عَلَی شِمَالِہِ فِی الصَّلاَۃِ تَحْتَ السُّرَّۃِ۔","","Musannaf Ibn Abi Shaybah 3960","","","كتاب الصلوات"
"3961","(۳۹۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ السَّلاَمِ بْنُ شَدَّادٍ الْجُرَیری أَبُو طَالُوتَ ، عَنْ غَزْوَان بْنِ جَرِیرٍ الضَّبِّیِّ، عَنْ أَبِیہِ ، قَالَ : کَانَ عَلِیٌّ إذَا قَامَ فِی الصَّلاَۃِ وَضَعَ یَمِینَہُ عَلَی رُسْغِہِ ، فَلاَ یُزَالُ کَذَلِکَ حَتَّی یَرْکَعَ مَتَی مَا رَکَعَ، إِلاَّ أَنْ یُصْلِحَ ثَوْبَہُ ، أَوْ یَحُکَّ جَسَدَہُ۔","Majhul","Musannaf Ibn Abi Shaybah 3961","","","كتاب الصلوات"
"3962","(۳۹۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ زِیَادٍ بن أَبِی الْجَعْدِ ، عَنْ عَاصِمٍ الْجَحْدَرِیِّ ، عَنْ عُقْبَۃَ بْنِ ظُہَیْرٍ ، عَنْ عَلِیٍّ : فِی قَوْلِہِ {فَصَلِّ لِرَبِّکَ وَانْحَرْ} قَالَ : وَضْعُ الْیَمِینِ عَلَی الشِّمَالِ فِی الصَّلاَۃِ۔","Majhul","Musannaf Ibn Abi Shaybah 3962","","","كتاب الصلوات"
"3963","(۳۹۶۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا الحَجَّاجُ بْنُ حَسَّانَ ، قَالَ : سَمِعْتُ أَبَا مِجْلَزٍ ، أَوْ سَأَلْتُہُ ، قَالَ : قُلْتُ : کَیْفَ أَصْنَعُ ؟ قَالَ : یَضَعُ بَاطِنَ کَفِّ یَمِینِہِ عَلَی ظَاہِرِ کَفِّ شِمَالِہِ ، وَیَجْعَلُہَا أَسْفَلَ مِنَ السُّرَّۃِ۔","","Musannaf Ibn Abi Shaybah 3963","","","كتاب الصلوات"
"3964","(۳۹۶۴) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا الْحَجَّاجُ بْنُ أَبِی زَیْنَبَ ، قَالَ : حَدَّثَنِی أَبُو عُثْمَانَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ بِرَجُلٍ یُصَلِّی وَقَدْ وَضَعَ شِمَالَہُ عَلَی یَمِینِہِ ، فَأَخَذَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَمِینَہُ فَوَضَعَہَا عَلَی شِمَالِہِ۔","","Musannaf Ibn Abi Shaybah 3964","","","كتاب الصلوات"
"3965","(۳۹۶۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ تَضَعَ الْیُمْنَی عَلَی الْیُسْرَی فِی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 3965","","","كتاب الصلوات"
"3966","(۳۹۶۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنْ زِیَادِ بْنِ زَیْدٍ السُّوَائِیِّ ، عَنْ أَبِی جُحَیْفَۃَ ، عَنْ عَلِیٍّ ، قَالَ : مِنْ سُنَّۃِ الصَّلاَۃِ وَضْعُ الأَیْدِی عَلَی الأَیْدِی تَحْتَ السُّرَرِ۔ (ابوداؤد ۴۹۵۔ دار قطنی ۲۸۶)","Da'if","Musannaf Ibn Abi Shaybah 3966","","","كتاب الصلوات"
"3967","(۳۹۶۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ ثَوْرٍ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنْ أَبِی زِیَادٍ مَوْلَی آلِ دَرَّاجٍ قَالَ : مَا رَأَیْتُ فَنَسِیتُ فَإِنِّی لَمْ أَنْسَ أَنَّ أَبَا بَکْرٍ کَانَ إذَا قَامَ فِی الصَّلاَۃِ ، قَالَ : ہَکَذَا فَوَضَعَ الْیُمْنَی عَلَی الْیُسْرَی۔","Majhul","Musannaf Ibn Abi Shaybah 3967","","","كتاب الصلوات"
"3968","(۳۹۶۸) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَضَعَ الْیُمْنَی عَلَی الشِّمَالِ ، فَیَقُولُ عَلَی کَفِّہِ، أَوْ عَلَی الرُّسْغِ ، وَیَقُولُ فَوْقَ ذَلِکَ ، وَیَقُولُ أَہْلُ الْکِتَابِ یَفْعَلُونَہُ۔","","Musannaf Ibn Abi Shaybah 3968","","","كتاب الصلوات"
"3969","(۳۹۶۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْمُسْتَمِرِّ بْنِ الرَّیَّانِ ، عَنْ أَبِی الْجَوْزَائِ ؛ أَنَّہُ کَانَ یَأْمُرُ أَصْحَابَہُ أَنْ یَضَعَ أَحَدُہُمْ یَدَہُ الْیُمْنَی عَلَی الْیُسْرَی ، وَہُوَ یُصَلِّی۔","","Musannaf Ibn Abi Shaybah 3969","","","كتاب الصلوات"
"3970","(۳۹۷۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ (ح) ، وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُمَا کَانَا یُرْسِلاَنِ أَیْدِیَہُمَا فِی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 3970","","","كتاب الصلوات"
"3971","(۳۹۷۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ إبْرَاہِیمَ ، قَالَ : سَمِعْتُ عَمْرَو بْنَ دِینَارٍ ، قَالَ : کَانَ ابْنُ الزُّبَیْرِ إذَا صَلَّی یُرْسِلُ یَدَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 3971","","","كتاب الصلوات"
"3972","(۳۹۷۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ سُئِلَ عَنِ الرَّجُلِ یُمْسِکُ یَمِینَہُ بِشِمَالِہِ ؟قَالَ : إنَّمَا فُعِلَ ذَلِکَ مِنْ أَجْلِ الدَّمِ۔","","Musannaf Ibn Abi Shaybah 3972","","","كتاب الصلوات"
"3973","(۳۹۷۳) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : مَا رَأَیْت ابْنَ الْمُسَیَّبِ قَابِضًا یَمِینَہُ فِی الصَّلاَۃِ ، کَانَ یُرْسِلُہا۔","","Musannaf Ibn Abi Shaybah 3973","","","كتاب الصلوات"
"3974","(۳۹۷۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ الْعَیْزَارِ ، قَالَ : کُنْتُ أَطُوفُ مَعَ سَعِیدِ بْنِ جُبَیْرٍ ، فَرَأَی رَجُلاً یُصَلِّی وَاضِعًا إحْدَی یَدَیْہِ عَلَی الأُخْرَی ، ہَذِہِ عَلَی ہَذِہِ ، وَہَذِہِ عَلَی ہَذِہِ ، فَذَہَبَ فَفَرَّقَ بَیْنَہُمَا ثُمَّ جَائَ۔","","Musannaf Ibn Abi Shaybah 3974","","","كتاب الصلوات"
"3975","(۳۹۷۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ وَمَنْصُورٌ ، عَنِ ابْنِ سِیرِینَ ، عَنْ یَحْیَی بْنِ الْجَزَّارِ ؛ أَنَّ ابْنَ مَسْعُودٍ صَلَّی وَعَلَی بَطْنِہِ فَرْثٌ وَدَمٌ ، قَالَ : فَلَمْ یُعِدِ الصَّلاَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 3975","","","كتاب الصلوات"
"3976","(۳۹۷۶) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ أَمْسَکَ عَنْ ہَذَا الْحَدِیثِ بَعْدُ ، وَلَمْ یُعْجِبْہُ۔","","Musannaf Ibn Abi Shaybah 3976","","","كتاب الصلوات"
"3977","(۳۹۷۷) حَدَّثَنَا ہُشَیْمٌ، قَالَ: أَخْبَرَنَا یُونُسُ، عَنِ الْحَسَنِ، قَالَ: مَا فِی نَضَخَاتٍ مِنْ دَمٍ مَا یُفْسِدُ عَلَی رَجُلٍ صَلاَتَہُ۔","","Musannaf Ibn Abi Shaybah 3977","","","كتاب الصلوات"
"3978","(۳۹۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عَمْرو بْنِ شَیْبَۃَ ، عَنْ قَارِظٍ أَخِیہِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ کَانَ لاَ یَنْصَرِفُ مِنَ الدَّمِ حَتَّی یَکُونَ مِقْدَارَ الدِّرْہَمِ۔","","Musannaf Ibn Abi Shaybah 3978","","","كتاب الصلوات"
"3979","(۳۹۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا ؟ فَقَالَ الْحَکَمُ : إذَا کَانَ مِقْدَارَ الدِّرْہَمِ ، وَقَالَ حَمَّادٌ : إذَا کَانَ مِقْدَارَ الْمِثْقَالِ ، ثُمَّ قَالَ : أَوِ الدِّرْہَمِ۔","","Musannaf Ibn Abi Shaybah 3979","","","كتاب الصلوات"
"3980","(۳۹۸۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی الرَّبِیعِ ، قَالَ : رَأَیْتُ مُجَاہِدًا فِی ثَوْبِہِ دَمٌ یُصَلِّی فِیہِ أَیَّامًا۔","","Musannaf Ibn Abi Shaybah 3980","","","كتاب الصلوات"
"3981","(۳۹۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ حُسَیْنِ بْنِ صَالِحٍ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنِ الشَّعْبِیِّ ؛ فِی رَجُلٍ صَلَّی وَفِی ثَوْبِہِ دَمٌ ، قَالَ : لاَ یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 3981","","","كتاب الصلوات"
"3982","(۳۹۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَاصِمٍ ، قَالَ : رَأَیْتُ أَبَا وَائِلٍ یُصَلِّی وَفِی ثَوْبِہِ قَطَرَاتٌ مِنْ دَمٍ۔","","Musannaf Ibn Abi Shaybah 3982","","","كتاب الصلوات"
"3983","(۳۹۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ یَاسِینَ ، عَنِ الزُّہْرِیِّ ، قَالَ : إذَا کَانَ قَدْرَ الدِّرْہَمِ أَعَادَ۔","","Musannaf Ibn Abi Shaybah 3983","","","كتاب الصلوات"
"3984","(۳۹۸۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَقُولُ فِی الدَّمِ یَکُونُ فِی الثَّوْبِ قَدْرَ الدِّینَارِ، أَوِ الدِّرْہَمِ ، قَالَ : فَلْیُعِدْ۔","","Musannaf Ibn Abi Shaybah 3984","","","كتاب الصلوات"
"3985","(۳۹۸۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَأَلْتُہ عَنِ الرَّجُلِ یَری فِی ثَوْبِہِ الدَّمُ وَہُوَ فِی الصَّلاَۃِ ؟ قَالَ : إِنْ کَانَ کَثِیرًا فَلْیُلْقِ الثَّوْبَ عَنْہُ ، وَإِنْ کَانَ قَلِیلاً فَلْیَمْضِ فِی صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 3985","","","كتاب الصلوات"
"3986","(۳۹۸۶) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : سَأَلْتُہُ عَنِ الدَّمِ أَرَاہُ فِی ثَوْبِی بَعْدَ مَا أُصَلِّی؟ قَالَ : اغْسِلْہُ وَأَعِدِ الصَّلاَۃَ۔","","Musannaf Ibn Abi Shaybah 3986","","","كتاب الصلوات"
"3987","(۳۹۸۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَیُّوبَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ؛ فِی رَجُلٍ صَلَّی وَفِی ثَوْبِہِ دَمٌ ، فَلَمَّا انْصَرَفَ رَآہُ ، قَالَ : لاَ یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 3987","","","كتاب الصلوات"
"3988","(۳۹۸۸) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا صَلَّیْتَ فَرَأَیْتَ فِی ثَوْبِکَ دَمًا فَلاَ تُعِدْ ، قَدْ مَضَتْ صَلاَتُک۔","","Musannaf Ibn Abi Shaybah 3988","","","كتاب الصلوات"
"3989","(۳۹۸۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ لَمْ یَکُنْ یَرَی فِی الدَّمِ وَالْمَنِیِّ فِی الثَّوْبِ أَنْ تُعَادَ مِنْہُ الصَّلاَۃُ۔","","Musannaf Ibn Abi Shaybah 3989","","","كتاب الصلوات"
"3990","(۳۹۹۰) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ ؛ فِی رَجُلٍ صَلَّی وَفِی ثَوْبِہِ دَمٌ ، قَالَ : إِنْ کَانَ کَثِیرًا یُعِیدُ مِنْہُ الصَّلاَۃ ، وَإِنْ کَانَ قَلِیلاً لَمْ یُعِدْ۔","","Musannaf Ibn Abi Shaybah 3990","","","كتاب الصلوات"
"3991","(۳۹۹۱) حَدَّثَنَا شَرِیکٌ، عَنْ أَبِی إِسْحَاقَ، عَنْ عَطَائٍ، قَالَ: رَأَیْتُہُ یُصَلِّی وَفِی ثَوْبِہِ کَفٌّ مِنْ دَمٍ۔","","Musannaf Ibn Abi Shaybah 3991","","","كتاب الصلوات"
"3992","(۳۹۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ زُیَیْدِ بْنِ الصَّلْتِ ) ؛ أَنَّ عُمَرَ غَسَلَ مَا رَأَی فِی ثَوْبِہِ ، وَنَضَحَ مَا لَمْ یَرَ ، وَأَعَادَ بَعْدَ مَا ارْتَفَعَ الضُّحَی مُتَمَکِّنًا۔","Sahih","Musannaf Ibn Abi Shaybah 3992","","","كتاب الصلوات"
"3993","(۳۹۹۳) حَدَّثَنَا عَبْدَۃُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ؛ أَنَّ عُمَرَ صَلَّی صَلاَۃَ الْغَدَاۃِ ، ثُمَّ غَدَا إلَی أَرْضٍ لَہُ بِالْجُرْفِ ، فَوَجَدَ فِی ثَوْبِہِ احْتِلاَمًا ، قَالَ : فَغَسَلَ الاحْتِلاَمَ وَاغْتَسَلَ ، ثُمَّ أَعَادَ صَلاَۃَ الصُّبْحِ۔","","Musannaf Ibn Abi Shaybah 3993","","","كتاب الصلوات"
"3994","(۳۹۹۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَفْلَحَ ، عَنْ أَبِیہِ ، قَالَ : صَلَّیْت وَفِی ثَوْبِی جَنَابَۃٌ ، فَأَمَرَنِی ابْنُ عُمَرَ فَأَعَدْت۔","Sahih","Musannaf Ibn Abi Shaybah 3994","","","كتاب الصلوات"
"3995","(۳۹۹۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یُصَلِّی وَفِی ثَوْبِہِ جَنَابَۃٌ ، قَالَ : مَضَتْ صَلاَتُہُ ، وَلاَ إعَادَۃَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 3995","","","كتاب الصلوات"
"3996","(۳۹۹۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ وَمَنْصُورٌ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ : یُعِیدُ مَا کَانَ فِی وَقْتٍ۔","","Musannaf Ibn Abi Shaybah 3996","","","كتاب الصلوات"
"3997","(۳۹۹۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ قَالَ : مَنْ صَلَّی وَفِی ثَوْبِہِ جَنَابَۃٌ ، فَلاَ إعَادَۃَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 3997","","","كتاب الصلوات"
"3998","(۳۹۹۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا وَجَدَ فِی ثَوْبِہِ دَمًا ، أَوْ مَنِیًّا غَسَلَہُ ، وَلَمْ یُعِدِ الصَّلاَۃَ۔","","Musannaf Ibn Abi Shaybah 3998","","","كتاب الصلوات"
"3999","(۳۹۹۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : کَانَ عَبْدُ اللہِ یَنْہَضُ فِی الصَّلاَۃِ عَلَی صُدُورِ قَدَمَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 3999","","","كتاب الصلوات"
"4000","(۴۰۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ یَزِیدَ ، عَنْ یَزِیدَ بْنِ زِیَادِ بْنِ أَبِی الْجَعْدِ ، عَنْ عُبَیْدِ بْنِ أَبِی الْجَعْدِ ، قَالَ : کَانَ عَلِیٌّ یَنْہَضُ فِی الصَّلاَۃِ عَلَی صُدُورِ قَدَمَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4000","","","كتاب الصلوات"
"4001","(۴۰۰۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : کَانَ عَبْدُ اللہِ یَنْہَضُ فِی الصَّلاَۃِ عَلَی صُدُورِ قَدَمَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 4001","","","كتاب الصلوات"
"4002","(۴۰۰۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : رَأَیْتُہُ یَنْہَضُ فِی الصَّلاَۃِ عَلَی صُدُورِ قَدَمَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4002","","","كتاب الصلوات"
"4003","(۴۰۰۳) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ ، قَالَ : کَانَ ابْنُ أَبِی لَیْلَی یَنْہَضُ فِی الصَّلاَۃِ عَلَی صُدُورِ قَدَمَیْہِ۔","","Musannaf Ibn Abi Shaybah 4003","","","كتاب الصلوات"
"4004","(۴۰۰۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ عِیسَی بْنِ مَیْسَرَۃَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ عُمَرَ وَعَلِیًّا وَأَصْحَابَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانُوا یَنْہَضُونَ فِی الصَّلاَۃِ عَلَی صُدُورِ أَقْدَامِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 4004","","","كتاب الصلوات"
"4005","(۴۰۰۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ وَہْبِ بْنِ کَیْسَانَ ، قَالَ : رَأَیْتُ ابْنَ الزُّبَیْرِ إذَا سَجَدَ السَّجْدَۃَ الثَّانِیَۃَ قَامَ کَمَا ہُوَ عَلَی صُدُورِ قَدَمَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4005","","","كتاب الصلوات"
"4006","(۴۰۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ وَہْبِ بْنِ کَیْسَانَ ، عَنِ ابْنِ الزُّبَیْرِ ؛ بِنَحْوِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4006","","","كتاب الصلوات"
"4007","(۴۰۰۷) حَدَّثَنَا وَکِیعٌ، عَنْ أُسَامَۃَ، وَالْعُمَرِیِّ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ یَنْہَضُ فِی الصَّلاَۃِ عَلَی صُدُورِ قَدَمَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 4007","","","كتاب الصلوات"
"4008","(۴۰۰۸) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَبِی الْمُعَلَّی ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ فِی الرَّکْعَۃِ الأُولَی وَالثَّالِثَۃِ لاَ یَقْعُدُ حِینَ یُرِیدُ أَنْ یَقُومَ حَتَّی یَقُومَ۔","","Musannaf Ibn Abi Shaybah 4008","","","كتاب الصلوات"
