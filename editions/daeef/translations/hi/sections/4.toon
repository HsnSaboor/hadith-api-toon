"959","[AI-translation] ((हमारे और मुश्रिकों के दरमियान फ़र्क़ टोपियों पर अमामे बाँधना है))।"
"960","[AI-translation] ((फ़रिश्तों का लिबास आधी पिंडली तक पहुँचता है))।"
"961","[AI-translation] ((अपने कपड़े तह करो [यानी ठीक से रखो], उनकी रूहें उनमें लौटती हैं। बेशक अगर शैतान तह किए कपड़े पाए तो नहीं पहनता, लेकिन अगर बिखरे कपड़े पाए तो पहनता है))।"
"962","[AI-translation] ((जो अल्लाह के साथ बैठना चाहे वह ऊनी कपड़े वालों के साथ बैठे))।"
"963","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ऊनी लिबास में वफ़ात पाए))।"
"964","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) पीठ पर कमरबन्द [पेटी] बाँधते))।"
"965","[AI-translation] ((जो ऊँट बाँधे और ऊनी कपड़े पहने वह तकब्बुर से पाक है))।"
"966","[AI-translation] ((जो पीले जूते पहने वह ख़ुशी में रहेगा जब तक पहने रहे))।"
"967","[AI-translation] ((मुनाफ़िक़ की निशानी है कि उसका पायजामा लम्बा है))।"
"968","[AI-translation] ((अँगूठी के साथ नमाज़ बग़ैर अँगूठी सत्तर नमाज़ों के बराबर है))।"
"969","[AI-translation] ((अक़ीक़ की अँगूठी पहनो, वह बाबरकत है))।"
"970","[AI-translation] ((जन्नत के ज़्यादातर नगीने अक़ीक़ के हैं))।"
"971","[AI-translation] ((जो अक़ीक़ की अँगूठी पहने वह हमेशा ख़ैर और भलाई देखेगा))।"
"972","[AI-translation] ((जो याक़ूत नग की अँगूठी पहने, अल्लाह तआला उसकी ग़ुर्बत दूर करता है))।"
"973","[AI-translation] ((ज़मुर्रद [क़ीमती पत्थर] पहनो; वह आसान है, उसमें कोई मुश्किल नहीं))।"
"974","[AI-translation] ((अल्लाह के रास्ते में ख़र्च सात सौ दिरहम के बराबर है, जबकि ख़िज़ाब लगाने के लिए एक दिरहम ख़र्च करना सात हज़ार दिरहम के बराबर है))।"
"975","[AI-translation] ((जो ख़िज़ाब लगाए [बालों में] मरे, मुनकर-नकीर उससे क़ब्र में सवाल न करेंगे))।"
"976","[AI-translation] ((जो दुनिया में लम्बी मूँछें रखे, अल्लाह रब्ब-उल-इज़्ज़त क़ियामत के दिन उसकी हसरत लम्बी करेगा))।"
"977","[AI-translation] ((आसमान के फ़रिश्ते पेशानी पर ज़ुल्फ़ों वाली औरतों और दाढ़ी वाले मर्दों के लिए मग़फ़िरत माँगते हैं, और कहते हैं: पाक है वह जिसने मर्दों को दाढ़ियों से और औरतों को ज़ुल्फ़ों से ज़ीनत दी))।"
"978","[AI-translation] ((तुममें से कोई दाढ़ी न काटे, अलबत्ता कनपटी के बाल तराश सकता है))।"
"979","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) अपनी दाढ़ी लम्बाई और चौड़ाई से तराशते))।"
"980","[AI-translation] ((जो हर रात सिर और दाढ़ी में कंघी करे उसे कई क़िस्म की आज़माइशों से हिफ़ाज़त दी जाती है, और उसकी उम्र भी बढ़ाई जाती है))।"
"981","[AI-translation] ((जो खड़े होकर बालों में कंघी करे, उस पर क़र्ज़ चढ़ता है))।"
"982","[AI-translation] ((कंघी नबी (सल्लल्लाहु अलैहि वसल्लम) से सफ़र या घर में कभी जुदा न होती))।"
"983","[AI-translation] ((जो हफ़्ते को नाख़ुन काटे, बीमारी उससे जाती रहती है और शिफ़ा उसमें दाख़िल होती है))।"
"984","[AI-translation] ((बेशक गुलाब का फूल नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) के पसीने से पैदा किया गया))।"
"985","[AI-translation] ((जिस रात मुझे सैर कराई गई [यानी मेराज की रात], मेरा कुछ पसीना ज़मीन पर गिरा, और उससे गुलाब का फूल उगा। तो जो मेरी ख़ुशबू सूँघना चाहे वह गुलाब सूँघे))।"
"986","[AI-translation] ((जब तुममें से किसी के पास ख़ुशबू लाई जाए तो वह ज़रूर लगाए, और जब कोई मीठी चीज़ लाई जाए तो वह भी ज़रूर खाए))।"
"987","[AI-translation] ((जन्नत के ख़ुशबूदार पौधों का सरदार मेंहदी है))।"
"988","[AI-translation] ((लोबान [काँटेदार दरख़्त का गोंद] मेरी और फ़रिश्तों की ख़ुशबू है))।"
"989","[AI-translation] ((नरगिस का फूल सूँघो, चाहे दिन में एक बार, महीने में एक बार, साल में एक बार, या ज़िन्दगी में एक बार))।"
"990","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) हर रात सुरमा लगाते, हर महीने पछना लगवाते, और हर साल दवा लेते))।"
"991","[AI-translation] ((दीवानगी, कोढ़ और बरस में सिर पर पछना लगाना चाहिए))।"
"992","[AI-translation] ((जो पछना लगवाना चाहे वह [चाँद की] सत्रहवीं, उन्नीसवीं या इक्कीसवीं को लगवाए))।"
"993","[AI-translation] (([चाँद की] पन्द्रहवीं, सत्रहवीं, उन्नीसवीं या इक्कीसवीं को पछना लगवाओ))।"
"994","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने हफ़्ते और बुध को पछना लगवाने से मना किया))।"
"995","[AI-translation] ((जुमा को एक घड़ी है जिसमें अगर कोई पछना लगवाए तो मर जाएगा))।"
"996","[AI-translation] ((एक दिन का बुख़ार एक साल के गुनाहों का कफ़्फ़ारा है))।"
"997","[AI-translation] ((मोमिन के वुज़ू के बचे पानी को पीने में हर बीमारी का इलाज है, जिसमें सबसे कम ग़म है))।"
"998","[AI-translation] ((मोमिन का थूक भी शिफ़ा है))।"
"999","[AI-translation] ((बख़ील का खाना बीमारी है, जबकि सख़ी का खाना शिफ़ा है))।"
"1000","[AI-translation] ((पेट बीमारियों का घर है, और परहेज़ तिब की बुनियाद है))।"
"1001","[AI-translation] ((पेट जिस्म का हौज़ है; सब रगें उसमें उतरती हैं। अगर पेट दुरुस्त हो तो रगें सेहत के साथ लौटेंगी, और अगर पेट ख़राब हो तो रगें बीमारी के साथ लौटेंगी))।"
"1002","[AI-translation] ((आँख का इलाज यह है कि उसे छुआ न जाए))।"
"1003","[AI-translation] ((बीनाई का जाना गुनाहों की बख़्शिश है, समाअत का जाना गुनाहों की बख़्शिश है, और इसी तरह जिस्म की हर तकलीफ़ गुनाहों की बख़्शिश का ज़रिया है))।"
"1004","[AI-translation] ((आदमी के एक पैर की तकलीफ़ उसके आधे गुनाहों की बख़्शिश का ज़रिया बनती है, जबकि दोनों पैरों की तकलीफ़ सब गुनाहों की बख़्शिश का ज़रिया बनती है))।"
"1005","[AI-translation] ((जो हर महीने तीन दिन निहार मुँह शहद चाटे वह किसी बड़ी बीमारी में मुब्तला न होगा))।"
"1006","[AI-translation] ((नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) ने कोढ़ी का हाथ पकड़ा और उसे अपने पास मौजूद बर्तन में रखा, और फ़रमाया: अल्लाह तआला पर भरोसा और तवक्कुल करते हुए खाने में शरीक हो))।"
"1007","[AI-translation] ((तिब में आख़िरी इलाज दाग़ना है))।"
"1008","[AI-translation] ((सूरत-ए-फ़ातिहा हर बीमारी की शिफ़ा है))।"
