hadiths[11]{hadithnumber,text}:
"1701","Telah menceritakan kepada Kami [Muhammad bin Katsir]"
"1704","Telah menceritakan kepada Kami [Qutaibah bin Sa'id]"
"1706","Telah menceritakan kepada Kami [Muhammad bin Rafi']"
"1708","Telah menceritakan kepada Kami [Ahmad bin Hafsh]"
"1709","Telah menceritakan kepada Kami [Musaddad]"
"1714","Telah menceritakan kepada Kami [Muhammad bin Al 'Ala`]"
"1715","Telah menceritakan kepada Kami [Al Haitsam bin Khalid Al Juhani]"
"1717","Telah menceritakan kepada Kami [Sulaiman bin Abdurrahman Ad Damasyqi]"
"1718","Telah menceritakan kepada Kami [Makhlad bin Khalid]"
"1719","Telah menceritakan kepada Kami [Yazid bin Khalid bin Mauhib] serta [Ahmad bin Shalih]"
"1721","Telah menceritakan kepada Kami [Zuhair bin Harb] dan [Utsman bin Abu Syaibah] secara makna"