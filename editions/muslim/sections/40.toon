hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"5862","وحَدَّثَنِي وحَدَّثَنِي أَبُو الطَّاهِرِ أَحْمَدُ بْنُ عَمْرِو بْنِ سَرْحٍ ، وَحَرْمَلَةُ بْنُ يَحْيَي ، قَالَا: أَخْبَرَنَا ابْنُ وَهْبٍ ، حَدَّثَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، أَخْبَرَنِي أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ: قَالَ أَبُو هُرَيْرَةَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" قَالَ اللَّهُ عَزَّ وَجَلَّ: يَسُبُّ ابْنُ آدَمَ الدَّهْرَ، وَأَنَا الدَّهْرُ، بِيَدِيَ اللَّيْلُ وَالنَّهَارُ \""\"".nصحیح مسلم حدیث: 5862 عربی حدیث: 2246""","Sahih","Sahih Muslim 5862","","","1. باب: زمانے کو برا کہنے کی ممانعت۔زمانے کو برا کہنے کی ممانعت :۔Chapter: The Prohibition Of Cursing Time"
"5863","وحَدَّثَنَاه وحَدَّثَنَاه إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، وَابْنُ أَبِي عُمَرَ ، وَاللَّفْظُ لِابْنِ أَبِي عُمَرَ، قَالَ إِسْحَاقُ: أَخْبَرَنَا، وقَالَ ابْنُ أَبِي عُمَرَ: حَدَّثَنَا سُفْيَانُ ، عَنْ الزُّهْرِيِّ ، عَنْ ابْنِ الْمُسَيَّبِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" قَالَ اللَّهُ عَزَّ وَجَلَّ: يُؤْذِينِي ابْنُ آدَمَ، يَسُبُّ الدَّهْرَ وَأَنَا الدَّهْرُ، أُقَلِّبُ اللَّيْلَ وَالنَّهَارَ \""\"".nصحیح مسلم حدیث: 5863 عربی حدیث: 2246""","Sahih","Sahih Muslim 5863","","","1. باب: زمانے کو برا کہنے کی ممانعت۔زمانے کو برا کہنے کی ممانعت :۔Chapter: The Prohibition Of Cursing Time"
"5864","وحَدَّثَنَا وحَدَّثَنَا عَبْدُ بْنُ حُمَيْدٍ ، أَخْبَرَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ الزُّهْرِيِّ ، عَنْ ابْنِ الْمُسَيَّبِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" قَالَ اللَّهُ عَزَّ وَجَلَّ: يُؤْذِينِي ابْنُ آدَمَ، يَقُولُ: يَا خَيْبَةَ الدَّهْرِ، فَلَا يَقُولَنَّ أَحَدُكُمْ: يَا خَيْبَةَ الدَّهْرِ، فَإِنِّي أَنَا الدَّهْرُ، أُقَلِّبُ لَيْلَهُ وَنَهَارَهُ، فَإِذَا شِئْتُ قَبَضْتُهُمَا \""\"".nصحیح مسلم حدیث: 5864 عربی حدیث: 2246""","Sahih","Sahih Muslim 5864","","","1. باب: زمانے کو برا کہنے کی ممانعت۔زمانے کو برا کہنے کی ممانعت :۔Chapter: The Prohibition Of Cursing Time"
"5865","حَدَّثَنَا قُتَيْبَةُ ، حَدَّثَنَا الْمُغِيرَةُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي الزِّنَادِ ، عَنْ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لَا يَقُولَنَّ أَحَدُكُمْ: يَا خَيْبَةَ الدَّهْرِ، فَإِنَّ اللَّهَ هُوَ الدَّهْرُ \""\"".nصحیح مسلم حدیث: 5865 عربی حدیث: 2246""","Sahih","Sahih Muslim 5865","","","1. باب: زمانے کو برا کہنے کی ممانعت۔زمانے کو برا کہنے کی ممانعت :۔Chapter: The Prohibition Of Cursing Time"
"5866","وحَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا جَرِيرٌ ، عَنْ هِشَامٍ ، عَنْ ابْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لَا تَسُبُّوا الدَّهْرَ، فَإِنَّ اللَّهَ هُوَ الدَّهْرُ \""\"".nصحیح مسلم حدیث: 5866 عربی حدیث: 2246""","Sahih","Sahih Muslim 5866","","","1. باب: زمانے کو برا کہنے کی ممانعت۔زمانے کو برا کہنے کی ممانعت :۔Chapter: The Prohibition Of Cursing Time"
"5867","حَدَّثَنَا حَجَّاجُ بْنُ الشَّاعِرِ ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ ابْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" لَا يَسُبُّ أَحَدُكُمُ الدَّهْرَ، فَإِنَّ اللَّهَ هُوَ الدَّهْرُ، وَلَا يَقُولَنَّ أَحَدُكُمْ لِلْعِنَبِ: الْكَرْمَ، فَإِنَّ الْكَرْمَ الرَّجُلُ الْمُسْلِمُ \""\"".nصحیح مسلم حدیث: 5867 عربی حدیث: 2247""","Sahih","Sahih Muslim 5867","","","2. باب: انگور کو کرم کہنے کی ممانعت۔عنب (انگور اور اس کی بیل ) کو کرم کہنا مکروہ ہے :۔Chapter: It Is Disliked To Call Grapes Karm"
"5868","حَدَّثَنَا عَمْرٌو النَّاقِدُ ، وَابْنُ أَبِي عُمَرَ ، قَالَا: حَدَّثَنَا سُفْيَانُ ، عَنْ الزُّهْرِيِّ ، عَنْ سَعِيدٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لَا تَقُولُوا: كَرْمٌ، فَإِنَّ الْكَرْمَ قَلْبُ الْمُؤْمِنِ \""\"".nصحیح مسلم حدیث: 5868 عربی حدیث: 2247""","Sahih","Sahih Muslim 5868","","","2. باب: انگور کو کرم کہنے کی ممانعت۔عنب (انگور اور اس کی بیل ) کو کرم کہنا مکروہ ہے :۔Chapter: It Is Disliked To Call Grapes Karm"
"5869","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا جَرِيرٌ ، عَنْ هِشَامٍ ، عَنْ ابْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لَا تُسَمُّوا الْعِنَبَ: الْكَرْمَ، فَإِنَّ الْكَرْمَ الرَّجُلُ الْمُسْلِمُ \""\"".nصحیح مسلم حدیث: 5869 عربی حدیث: 2247""","Sahih","Sahih Muslim 5869","","","2. باب: انگور کو کرم کہنے کی ممانعت۔عنب (انگور اور اس کی بیل ) کو کرم کہنا مکروہ ہے :۔Chapter: It Is Disliked To Call Grapes Karm"
"5870","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا عَلِيُّ بْنُ حَفْصٍ ، حَدَّثَنَا وَرْقَاءُ ، عَنْ أَبِي الزِّنَادِ ، عَنْ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" لَا يَقُولَنَّ أَحَدُكُمْ: الْكَرْمُ، فَإِنَّمَا الْكَرْمُ قَلْبُ الْمُؤْمِنِ \""\"".nصحیح مسلم حدیث: 5870 عربی حدیث: 2247""","Sahih","Sahih Muslim 5870","","","2. باب: انگور کو کرم کہنے کی ممانعت۔عنب (انگور اور اس کی بیل ) کو کرم کہنا مکروہ ہے :۔Chapter: It Is Disliked To Call Grapes Karm"
"5871","وحَدَّثَنَا ابْنُ رَافِعٍ ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ هَمَّامِ بْنِ مُنَبِّهٍ ، قَالَ: هَذَا مَا حَدَّثَنَا أَبُو هُرَيْرَةَ ، عَنِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَذَكَرَ أَحَادِيثَ مِنْهَا، وَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" لَا يَقُولَنَّ أَحَدُكُمْ لِلْعِنَبِ: الْكَرْمَ، إِنَّمَا الْكَرْمُ الرَّجُلُ الْمُسْلِمُ \""\"".nصحیح مسلم حدیث: 5871 عربی حدیث: 2247""","Sahih","Sahih Muslim 5871","","","2. باب: انگور کو کرم کہنے کی ممانعت۔عنب (انگور اور اس کی بیل ) کو کرم کہنا مکروہ ہے :۔Chapter: It Is Disliked To Call Grapes Karm"
"5872","حَدَّثَنَا عَلِيُّ بْنُ خَشْرَمٍ ، أَخْبَرَنَا عِيسَى يَعْنِي ابْنَ يُونُسَ ، عَنْ شُعْبَةَ ، عَنْ سِمَاكِ بْنِ حَرْبٍ ، عَنْ عَلْقَمَةَ بْنِ وَائِلٍ ، عَنْ أَبِيهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لَا تَقُولُوا: الْكَرْمُ، وَلَكِنْ قُولُوا: الْحَبْلَةُ يَعْنِي الْعِنَبَ.nصحیح مسلم حدیث: 5872 عربی حدیث: 2248""","Sahih","Sahih Muslim 5872","","","2. باب: انگور کو کرم کہنے کی ممانعت۔عنب (انگور اور اس کی بیل ) کو کرم کہنا مکروہ ہے :۔Chapter: It Is Disliked To Call Grapes Karm"
"5873","وحَدَّثَنِيهِ زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا عُثْمَانُ بْنُ عُمَرَ ، حَدَّثَنَا شُعْبَةُ ، عَنْ سِمَاكٍ ، قَالَ: سَمِعْتُ عَلْقَمَةَ بْنَ وَائِلٍ ، عَنْ أَبِيهِ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لَا تَقُولُوا: الْكَرْمُ، وَلَكِنْ قُولُوا: الْعِنَبُ وَالْحَبْلَةُ \""\"".nصحیح مسلم حدیث: 5873 عربی حدیث: 2248""","Sahih","Sahih Muslim 5873","","","2. باب: انگور کو کرم کہنے کی ممانعت۔عنب (انگور اور اس کی بیل ) کو کرم کہنا مکروہ ہے :۔Chapter: It Is Disliked To Call Grapes Karm"
"5874","حَدَّثَنَا يَحْيَي بْنُ أَيُّوبَ ، وَقُتَيْبَةُ ، وَابْنُ حُجْرٍ ، قَالُوا: حَدَّثَنَا إِسْمَاعِيلُ وَهُوَ ابْنُ جَعْفَرٍ ، عَنْ الْعَلَاءِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لَا يَقُولَنَّ أَحَدُكُمْ: عَبْدِي، وَأَمَتِي، كُلُّكُمْ عَبِيدُ اللَّهِ، وَكُلُّ نِسَائِكُمْ إِمَاءُ اللَّهِ، وَلَكِنْ لِيَقُلْ غُلَامِي، وَجَارِيَتِي، وَفَتَايَ، وَفَتَاتِي \""\"".nصحیح مسلم حدیث: 5874 عربی حدیث: 2249""","Sahih","Sahih Muslim 5874","","","3. باب: عبد یا امة یا مولیٰ یا سید، ان لفظوں کے بولنے کا بیان۔عبداَمہ ،مَولی اور سید کے الفا ظ کا صحیح اطلا ق (استعمال )کرنے کا حکمChapter: Ruling On Using The Words 'Abd And Amah (For Slaves) And Mawla And Sayyid (For Masters)"
"5875","وحَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا جَرِيرٌ ، عَنْ الْأَعْمَشِ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" لَا يَقُولَنَّ أَحَدُكُمْ: عَبْدِي، فَكُلُّكُمْ عَبِيدُ اللَّهِ، وَلَكِنْ لِيَقُلْ فَتَايَ، وَلَا يَقُلِ الْعَبْدُ: رَبِّي، وَلَكِنْ لِيَقُلْ: سَيِّدِي \""\"".nصحیح مسلم حدیث: 5875 عربی حدیث: 2249""","Sahih","Sahih Muslim 5875","","","3. باب: عبد یا امة یا مولیٰ یا سید، ان لفظوں کے بولنے کا بیان۔عبداَمہ ،مَولی اور سید کے الفا ظ کا صحیح اطلا ق (استعمال )کرنے کا حکمChapter: Ruling On Using The Words 'Abd And Amah (For Slaves) And Mawla And Sayyid (For Masters)"
"5876","وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، قَالَا: حَدَّثَنَا أَبُو مُعَاوِيَةَ . ح وحَدَّثَنَا أَبُو سَعِيدٍ الْأَشَجُّ ، حَدَّثَنَا وَكِيعٌ كِلَاهُمَا، عَنْ الْأَعْمَشِ ، بِهَذَا الْإِسْنَادِ، وَفِي حَدِيثِهِمَا: وَلَا يَقُلِ الْعَبْدُ لِسَيِّدِهِ: مَوْلَايَ، وَزَادَ فِي حَدِيثِ أَبِي مُعَاوِيَةَ: فَإِنَّ مَوْلَاكُمُ اللَّهُ عَزَّ وَجَلَّ.nصحیح مسلم حدیث: 5876 عربی حدیث: 2249","Sahih","Sahih Muslim 5876","","","3. باب: عبد یا امة یا مولیٰ یا سید، ان لفظوں کے بولنے کا بیان۔عبداَمہ ،مَولی اور سید کے الفا ظ کا صحیح اطلا ق (استعمال )کرنے کا حکمChapter: Ruling On Using The Words 'Abd And Amah (For Slaves) And Mawla And Sayyid (For Masters)"
"5877","وحَدَّثَنَا مُحَمَّدُ بْنُ رَافِعٍ ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ هَمَّامِ بْنِ مُنَبِّهٍ ، قَالَ: حَدَّثَنَا أَبُو هُرَيْرَةَ ، عَنِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَذَكَرَ أَحَادِيثَ مِنْهَا، وَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" لَا يَقُلْ أَحَدُكُمْ: اسْقِ رَبَّكَ، أَطْعِمْ رَبَّكَ، وَضِّئْ رَبَّكَ، وَلَا يَقُلْ أَحَدُكُمْ: رَبِّي، وَلْيَقُلْ: سَيِّدِي مَوْلَايَ، وَلَا يَقُلْ أَحَدُكُمْ: عَبْدِي أَمَتِي، وَلْيَقُلْ: فَتَايَ فَتَاتِي غُلَامِي \""\"".nصحیح مسلم حدیث: 5877 عربی حدیث: 2249""","Sahih","Sahih Muslim 5877","","","3. باب: عبد یا امة یا مولیٰ یا سید، ان لفظوں کے بولنے کا بیان۔عبداَمہ ،مَولی اور سید کے الفا ظ کا صحیح اطلا ق (استعمال )کرنے کا حکمChapter: Ruling On Using The Words 'Abd And Amah (For Slaves) And Mawla And Sayyid (For Masters)"
"5878","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ . ح وحَدَّثَنَا أَبُو كُرَيْبٍ مُحَمَّدُ بْنُ الْعَلَاءِ ، حَدَّثَنَا أَبُو أُسَامَةَ كِلَاهُمَا، عَنْ هِشَامٍ ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ ، قَالَتْ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" لَا يَقُولَنَّ أَحَدُكُمْ: خَبُثَتْ نَفْسِي، وَلَكِنْ لِيَقُلْ: لَقِسَتْ نَفْسِي \""\""، هَذَا حَدِيثُ أَبِي كُرَيْبٍ، وقَالَ أَبُو بَكْرٍ: عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَلَمْ يَذْكُرْ لَكِنْ،nصحیح مسلم حدیث: 5878 عربی حدیث: 2250""","Sahih","Sahih Muslim 5878","","","4. باب: یہ کہنا کہ میرا نفس پلیدہ ہو گیا، مکروہ ہے۔میرا نفس خبیث ہو گیا کہنے کی کرا ہت :۔Chapter: It Is Disliked For A Man To Say: Khabuthat Nafsi (I Feel Bad)"
"5879","وحَدَّثَنَاه أَبُو كُرَيْبٍ ، حَدَّثَنَا أَبُو مُعَاوِيَةَ بِهَذَا الْإِسْنَادِ.nصحیح مسلم حدیث: 5879 عربی حدیث: 2250","Sahih","Sahih Muslim 5879","","","4. باب: یہ کہنا کہ میرا نفس پلیدہ ہو گیا، مکروہ ہے۔میرا نفس خبیث ہو گیا کہنے کی کرا ہت :۔Chapter: It Is Disliked For A Man To Say: Khabuthat Nafsi (I Feel Bad)"
"5880","وحَدَّثَنِي أَبُو الطَّاهِرِ ، وَحَرْمَلَةُ ، قَالَا: أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، عَنْ أَبِي أُمَامَةَ بْنِ سَهْلِ بْنِ حُنَيْفٍ ، عَنْ أَبِيهِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لَا يَقُلْ أَحَدُكُمْ: خَبُثَتْ نَفْسِي، وَلْيَقُلْ: لَقِسَتْ نَفْسِي \""\"".nصحیح مسلم حدیث: 5880 عربی حدیث: 2251""","Sahih","Sahih Muslim 5880","","","4. باب: یہ کہنا کہ میرا نفس پلیدہ ہو گیا، مکروہ ہے۔میرا نفس خبیث ہو گیا کہنے کی کرا ہت :۔Chapter: It Is Disliked For A Man To Say: Khabuthat Nafsi (I Feel Bad)"
"5881","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا أَبُو أُسَامَةَ ، عَنْ شُعْبَةَ ، حَدَّثَنِي خُلَيْدُ بْنُ جَعْفَرٍ ، عَنْ أَبِي نَضْرَةَ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" كَانَتْ امْرَأَةٌ مِنْ بَنِي إِسْرَائِيلَ قَصِيرَةٌ تَمْشِي مَعَ امْرَأَتَيْنِ طَوِيلَتَيْنِ، فَاتَّخَذَتْ رِجْلَيْنِ مِنْ خَشَبٍ، وَخَاتَمًا مِنْ ذَهَبٍ مُغْلَقٌ مُطْبَقٌ، ثُمَّ حَشَتْهُ مِسْكًا، وَهُوَ أَطْيَبُ الطِّيبِ، فَمَرَّتْ بَيْنَ الْمَرْأَتَيْنِ، فَلَمْ يَعْرِفُوهَا، فَقَالَتْ بِيَدِهَا هَكَذَا \""\""، وَنَفَضَ شُعْبَةُ يَدَهُ.nصحیح مسلم حدیث: 5881 عربی حدیث: 2252""","Sahih","Sahih Muslim 5881","","","5. باب: بہتر خوشبو مشک کا بیان اور خوشبو کو پھیر دینے کی ممانعت۔کستوری کا استعمال اور یہ کہ وہ بہترین خوشبوہے اور ریحان (خوشبو دار پھول یا اس کی ٹہنی) اور خوشبو(کا تحفہ) رد کرنا مکروہ ہے:۔Chapter: Using Musk, Which Is The Best Of Perfume. It Is Disliked To Refuse A Gift Of Scent Or Perfume"
"5882","حَدَّثَنَا عَمْرٌو النَّاقِدُ ، حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ ، عَنْ شُعْبَةَ ، عَنْ خُلَيْدِ بْنِ جَعْفَرٍ ، وَالْمُسْتَمِرِّ ، قَالَا: سَمِعْنَا أَبَا نَضْرَةَ يُحَدِّثُ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، ذَكَرَ امْرَأَةً مِنْ بَنِي إِسْرَائِيلَ حَشَتْ خَاتَمَهَا مِسْكًا، وَالْمِسْكُ أَطْيَبُ الطِّيبِ.nصحیح مسلم حدیث: 5882 عربی حدیث: 2252","Sahih","Sahih Muslim 5882","","","5. باب: بہتر خوشبو مشک کا بیان اور خوشبو کو پھیر دینے کی ممانعت۔کستوری کا استعمال اور یہ کہ وہ بہترین خوشبوہے اور ریحان (خوشبو دار پھول یا اس کی ٹہنی) اور خوشبو(کا تحفہ) رد کرنا مکروہ ہے:۔Chapter: Using Musk, Which Is The Best Of Perfume. It Is Disliked To Refuse A Gift Of Scent Or Perfume"
"5883","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَزُهَيْرُ بْنُ حَرْبٍ ، كِلَاهُمَا، عَنْ الْمُقْرِئِ ، قَالَ أَبُو بَكْرٍ، حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ، عَنْ سَعِيدِ بْنِ أَبِي أَيُّوبَ ، حَدَّثَنِي عُبَيْدُ اللَّهِ بْنُ أَبِي جَعْفَرٍ ، عَنْ عَبْدِ الرَّحْمَنِ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنْ عُرِضَ عَلَيْهِ رَيْحَانٌ فَلَا يَرُدُّهُ، فَإِنَّهُ خَفِيفُ الْمَحْمِلِ طَيِّبُ الرِّيحِ \""\"".nصحیح مسلم حدیث: 5883 عربی حدیث: 2253""","Sahih","Sahih Muslim 5883","","","5. باب: بہتر خوشبو مشک کا بیان اور خوشبو کو پھیر دینے کی ممانعت۔کستوری کا استعمال اور یہ کہ وہ بہترین خوشبوہے اور ریحان (خوشبو دار پھول یا اس کی ٹہنی) اور خوشبو(کا تحفہ) رد کرنا مکروہ ہے:۔Chapter: Using Musk, Which Is The Best Of Perfume. It Is Disliked To Refuse A Gift Of Scent Or Perfume"
"5884","حَدَّثَنِي هَارُونُ بْنُ سَعِيدٍ الْأَيْلِيُّ ، وَأَبُو طَاهِرٍ ، وَأَحْمَدُ بْنُ عِيسَى ، قَالَ أَحْمَدُ: حَدَّثَنَا، وقَالَ الْآخَرَانِ: أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي مَخْرَمَةُ ، عَنْ أَبِيهِ ، عَنْ نَافِعٍ ، قَالَ: \\"" كَانَ ابْنُ عُمَرَ إِذَا اسْتَجْمَرَ، اسْتَجْمَرَ بِالْأَلُوَّةِ غَيْرَ مُطَرَّاةٍ، وَبِكَافُورٍ يَطْرَحُهُ مَعَ الْأَلُوَّةِ، ثُمَّ قَالَ: هَكَذَا كَانَ يَسْتَجْمِرُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \""\"".nصحیح مسلم حدیث: 5884 عربی حدیث: 2254""","Sahih","Sahih Muslim 5884","","","5. باب: بہتر خوشبو مشک کا بیان اور خوشبو کو پھیر دینے کی ممانعت۔کستوری کا استعمال اور یہ کہ وہ بہترین خوشبوہے اور ریحان (خوشبو دار پھول یا اس کی ٹہنی) اور خوشبو(کا تحفہ) رد کرنا مکروہ ہے:۔Chapter: Using Musk, Which Is The Best Of Perfume. It Is Disliked To Refuse A Gift Of Scent Or Perfume"
