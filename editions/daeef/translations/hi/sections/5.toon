"1446","[AI-translation] ((एक उँगली से खाना शैतान के खाने का तरीक़ा है, दो उँगलियों से खाना सरकशों के खाने का तरीक़ा है, और तीन उँगलियों से खाना अम्बिया के खाने का तरीक़ा है))।"
"1447","[AI-translation] ((रोना रहमत से है, और नोहा और वावैला शैतान से है))।"
"1448","[AI-translation] ((शदीद जमाही और शदीद छींक शैतान से है))।"
"1449","[AI-translation] ((बुलन्द हँसी शैतान से है और मुस्कुराहट अल्लाह से है))।"
"1450","[AI-translation] ((किसी नबी को कभी एहतिलाम नहीं हुआ; बेशक एहतिलाम शैतान से है))।"
"1451","[AI-translation] ((टालमटोल शैतान की आदत है जो वह मोमिनों के दिलों में डालने की कोशिश करता है))।"
"1452","[AI-translation] ((नमाज़ शैतान का चेहरा काला करती है))।"
"1453","[AI-translation] ((अपनी ज़बान पर हमेशा भलाई जमा रखो; यक़ीनन इस तरह तुम शैतान पर ग़ालिब आओगे))।"
"1454","[AI-translation] ((कम बोलो [वरना] शैतान तुम्हें गुमराह कर सकता है))।"
"1455","[AI-translation] ((नज़र-ए-बद हक़ है; उसे शैतान और आदम के बेटे का हसद लाता है))।"
"1456","[AI-translation] ((बन्दा अपने दीन के बारे में हमेशा आसानी में रहता है जब तक शराब न पिए, लेकिन जब शराब पिए तो अल्लाह उसकी हया का पर्दा फाड़ देता है, और शैतान उसके सुनने, देखने और चलने का निगराँ बन जाता है। वह उसे हर बुराई की तरफ़ ले जाता है और हर नेकी से फेरता है))।"
"1457","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने जानवरों की तरह एक साँस में सारा पानी पीने से मना किया और फ़रमाया कि यह शैतान के पीने का तरीक़ा है))।"
"1458","[AI-translation] ((अल्लाह की क़सम! शैतान उसके साथ लगातार खाता रहा यहाँ तक कि उसने बिस्मिल्लाह पढ़ी))।"
"1459","[AI-translation] ((जिस घर में सफ़ेद मुर्ग़ा हो, न शैतान न जादूगर उसके क़रीब आता है))।"
"1460","[AI-translation] ((अपनी दाढ़ियों और नाख़ुनों के दरमियान साफ़ करो, क्योंकि शैतान गोश्त और नाख़ुनों के दरमियान दौड़ता है))।"
"1461","[AI-translation] ((जब [जंगे-मूता में] जाफ़र (रज़ियल्लाहु अन्हु) ने झंडा थामा तो शैतान उनके पास आया और उनमें दुनिया की चाहत जगाई, मौत को उनके लिए नापसन्दीदा बनाया। उन्होंने कहा: अब तू मुझमें दुनिया की चाहत जगा रहा है जबकि मोमिनों के दिलों में ईमान जम चुका है? यह कहकर वह जंग में शरीक रहे यहाँ तक कि शहीद हुए))।"
"1462","[AI-translation] ((शैतान के कुछ जाल और फन्दे ये हैं: अल्लाह की नेमतों का इनकार, अल्लाह के दिए पर तकब्बुर, अल्लाह के बन्दों पर घमंड, और ख़्वाहिशों की पैरवी))।"
"1463","[AI-translation] ((आलिम की आबिद पर फ़ज़ीलत सत्तर दर्जे है... और इसकी वजह यह है कि जब शैतान लोगों के लिए बिदअत ईजाद करता है तो आलिम उसे पहचानता है और [लोगों को] उससे रोकता है [जबकि आबिद इससे बेख़बर रहता है]))।"
"1464","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने कमरे में कूड़ा छोड़ने से मना किया क्योंकि वह शैतान के बैठने की जगह है))।"
"1465","[AI-translation] ((जैसे कोई चाहेगा कि खाने और क़ैलूला के वक़्त शैतान उसके साथ न हो, वह घर में दाख़िल होते वक़्त सलाम कहे और खाते वक़्त बिस्मिल्लाह पढ़े))।"
"1466","[AI-translation] ((जब आदम का बेटा सोने जाए तो [मुक़र्रर] फ़रिश्ता शैतान से कहता है: मुझे अपना रजिस्टर दिखा। शैतान उसे अपना रजिस्टर देता है, फिर फ़रिश्ता [शख़्स के] रजिस्टर में मिलने वाली हर नेकी के बदले शैतान के रजिस्टर से दस बुराइयाँ मिटाता है, और उनकी जगह दस नेकियाँ लिखता है। इसलिए जब तुममें से कोई सोने लगे तो 'अल्लाहु अकबर' तैंतीस बार, 'अलहम्दुलिल्लाह' चौंतीस बार, और 'सुब्हानल्लाह' तैंतीस बार कहे; ये दुआएँ कुल सौ होंगी))।"
"1467","[AI-translation] ((बुरे अख़लाक़ अल्लाह के अज़ाब की लगाम है बदअख़लाक़ शख़्स की नाक में, और यह लगाम शैतान के हाथ में है, [इसलिए] शैतान उसे बुराई की तरफ़ खींचता है और बुराई से जहन्नम की तरफ़))।"
"1468","[AI-translation] ((बर्तन के टूटे हिस्से से न पियो, क्योंकि शैतान उससे पीता है))।"
"1469","[AI-translation] ((मकड़ी शैतान है; अल्लाह ने उसकी सूरत बिगाड़ी है, तो उसे मार डालो))।"
"1470","[AI-translation] ((उसे 'क़ौस-ए-क़ुज़ह' [बादलों में धनुष जैसी रंग-बिरंगी शक्ल] न कहो, क्योंकि क़ुज़ह शैतान का नाम है; बल्कि तुम्हें उसे 'अल्लाह की कमान' कहना चाहिए))।"
"1471","[AI-translation] एक सहाबी ने अपने बेटे का नाम हुबाब रखा। जब नबी (सल्लल्लाहु अलैहि वसल्लम) को मालूम हुआ तो फ़रमाया: उसका नाम हुबाब न रखो, क्योंकि हुबाब शैतान का नाम है।"
"1472","[AI-translation] ((बेशक शिहाब शैतान का नाम है))।"
"1473","[AI-translation] ((मुझे आदम (अलैहिस्सलाम) पर दो ख़ूबियों से फ़ज़ीलत दी गई: [और वे यह हैं कि] मेरा शैतान काफ़िर था लेकिन अल्लाह तआला ने उसके ख़िलाफ़ मेरी मदद की यहाँ तक कि वह मुसलमान हो गया, और मेरी बीवियाँ भी मेरी मददगार हैं, जबकि आदम (अलैहिस्सलाम) का शैतान काफ़िर रहा और उनकी बीवी ने उनकी ख़ता में उनकी मदद की))।"
"1474","[AI-translation] ((आसमान का हर फ़रिश्ता उमर (रज़ियल्लाहु अन्हु) की इज़्ज़त करता है, और ज़मीन का हर शैतान उमर (रज़ियल्लाहु अन्हु) से डरता है))।"
"1475","[AI-translation] ((जब यतीम किसी क़ौम के प्याले पर बैठे तो शैतान भी उनके प्याले के क़रीब आता है))।"
"1476","[AI-translation] (([उससे जिसके पास ताक़त के बावजूद बीवी या लौंडी न रखे, नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया:] तुम शैतानों के भाई हो))।"
"1477","[AI-translation] ((शैतान सुबह अपने झंडे लेकर बाज़ारों की तरफ़ निकलता है; वह पहले दाख़िल होने वाले के साथ दाख़िल होता है और आख़िर में निकलने वाले के साथ निकलता है))।"
"1478","[AI-translation] ((इबलीस के साथ कुछ सरकश शैतान हैं; वह उन्हें हाजियों और मुजाहिदों को [सीधे] रास्ते से बहकाने को कहता है))।"
"1479","[AI-translation] ((जब अपने कमरों में दाख़िल हो तो सलाम [अमन] कहो; [ऐसा करने से] उनमें रहने वाले शैतान निकल जाएँगे))।"
"1480","[AI-translation] ((अपने घर जहाँ तक हो सके रोशन रखो, और जिस घर में क़ुरआन पढ़ा जाए वह घरवालों के लिए कुशादा हो जाता है, उसकी भलाई बढ़ती है, फ़रिश्ते उसमें हाज़िर होते हैं, और शैतान उसे छोड़ देते हैं))।"
"1481","[AI-translation] ((अल्लाह के कुछ शैतान ख़ुश्की पर हैं; उन्हें समन्दर की चीज़ों पर कोई इख़्तियार नहीं। [इसी तरह अल्लाह के] कुछ शैतान समन्दर में हैं; उन्हें ख़ुश्की की चीज़ों पर कोई इख़्तियार नहीं))।"
"1482","[AI-translation] ((जब कोई नमाज़ के लिए खड़ा हो तो सात शैतान उसके साथ खड़े होते हैं))।"
"1483","[AI-translation] ((जब इन जानवरों पर सवार हो तो उन्हें अलग-अलग जगहों पर आराम दो; शैतानों की तरह उन पर सवार न हो))।"
"1484","[AI-translation] ((अल्लाह तआला उसके [दज्जाल के] साथ एक शैतान भेजेगा जो लोगों से बात करेगा))।"
"1485","[AI-translation] ((ऐ अबू ज़र! जिन्नों और इंसानों के शैतानों से अल्लाह की पनाह माँगो))। मैंने कहा: (([ऐ अल्लाह के रसूल!] क्या इंसानों में भी शैतान हैं?)) आप (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: ((हाँ))।"
"1486","[AI-translation] ((इबलीस नबी (सल्लल्लाहु अलैहि वसल्लम) के पास आया और उनसे बहुत-सी चीज़ों के बारे में पूछा, और उस वक़्त वह अपने साथियों की जमाअत के साथ मस्जिद में थे))।"
"1487","[AI-translation] ((आलिम-ए-दीन की मौत इबलीस की नज़र में सत्तर आबिदों की मौत से बेहतर है))।"
"1488","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने जिन्नों के लिए किए गए ज़बीहों से मना किया। [यह वह ज़बीहा है जो कोई घर बनाने के बाद इस नीयत से करता है कि ऐसा करने से जिन्न घरवालों को नुक़सान न पहुँचाएँगे]))।"
"1489","[AI-translation] ((जिब्रील (अलैहिस्सलाम) मेरे पास आए और कहा: एक सरकश जिन्न तेरे ख़िलाफ़ बुराई चाहता है, तो जब अपने बिस्तर पर लेटे तो आयत-उल-कुर्सी पढ़))।"
"1490","[AI-translation] ((मुसलमान और मुश्रिक जिन्न मेरे पास आए और झगड़े। उन्होंने मुझसे रहने की जगह माँगी, तो मैंने मुसलमान जिन्नों को जलास [पहाड़ों और बस्तियों] में रहने के लिए दिया और मुश्रिक जिन्नों को ग़ौर [पहाड़ों-समन्दरों के दरमियान इलाक़ा] में रहने के लिए दिया))।"
"1491","[AI-translation] ((शाम के शुरू में अपने को और अपने घरवालों को अन्दर रखो, क्योंकि उस वक़्त जिन्न निकले होते हैं))।"
"1492","[AI-translation] ((अल्लाह तआला ने जिन्नों को तीन क़िस्मों में पैदा किया: साँपों, बिच्छुओं और ज़मीन के कीड़ों की सूरत में; हवा में हवा जैसे; और वे जिनसे हिसाब लिया जाएगा और अज़ाब दिया जाएगा))।"
"1493","[AI-translation] ((ग़ीलान [जिन्नों की एक ख़ास क़िस्म] जिन्नों में जादूगर हैं))।"
"1494","[AI-translation] ((हर चीज़ जानती है कि मैं अल्लाह का रसूल हूँ सिवाय काफ़िर जिन्नों और काफ़िर इंसानों के))।"
"1495","[AI-translation] ((ताऊन की बीमारी तुम्हारे जिन्न भाइयों का डंक है))।"
"1496","[AI-translation] ((नापाकी के सत्तर हिस्से हैं; सिर्फ़ एक हिस्सा जिन्नों और इंसानों में है, और बाक़ी उनहत्तर (69) हिस्से बर्बर [शुमाल-मग़रिबी अफ़्रीक़ा की क़ौम] में हैं))।"
"1497","[AI-translation] ((जब कोई औरत अपने घर से निकले जबकि उसका शौहर उसका निकलना नापसन्द करे, तो उसके लौटने तक आसमान का हर फ़रिश्ता और हर वह चीज़ जिससे वह गुज़रे उस पर लानत करती है, सिवाय जिन्नों और इंसानों के))।"
"1498","[AI-translation] ((अगर तख़लीक़ के शुरू से क़ियामत के दिन तक सब इंसान, जिन्न, शैतान और फ़रिश्ते एक सफ़ में खड़े हों, फिर भी वे अल्लाह तआला का अहाता नहीं कर सकते))।"
"1499","[AI-translation] ((क्या तुम जानते हो ख़ुराफ़ा [झूठ] क्या है? ख़ुराफ़ा बनू-उज़रा का एक आदमी था जिसे जिन्नों ने पकड़ लिया था। वह उनमें लम्बे अरसे रहा, फिर उन्होंने उसे इंसानों के पास लौटा दिया। वह लोगों को जिन्नों की अजीब चीज़ें सुनाता था जो उसने उनमें देखी थीं, तो लोग कहने लगे: ये ख़ुराफ़ा की कहानियाँ हैं [यानी वह झूठी कहानियाँ सुना रहा है]))।"
"1500","[AI-translation] ((जिन्न उस शख़्स को नुक़सान नहीं पहुँचाते जिसके घर में उम्दा घोड़ा हो))।"
"1501","[AI-translation] ((जो जन्नत में दाख़िल होगा, ख़ूबसूरत आँखों वाली दो हूरें उसके सिरहाने और दो उसके पैरों की तरफ़ बैठेंगी, और उसे बेहतरीन आवाज़ों में गाएँगी, जो जिन्नों और इंसानों दोनों को सुनाई देंगी))।"
"1502","[AI-translation] ((क़ियामत क़ायम न होगी यहाँ तक कि तुममें तुम्हारी औरतों से जिन्नों की औलाद की बड़ी तादाद पैदा हो [और वे तुम्हें तुम्हारे दीन से फेर दें]))।"
"1503","[AI-translation] (([अल्लाह तआला ने जिन्नों पर लानत की और उन्हें मवेशियों की सूरत में बदल दिया] ये काले कुत्ते हक़ीक़त में जिन्न हैं))।"
"1504","[AI-translation] ((मोमिन जिन्न भी सवाब पाएँगे, और उन्हें भी अज़ाब दिया जाएगा))।"
"1505","[AI-translation] (([जब तुम्हारे चचा ने नबी (सल्लल्लाहु अलैहि वसल्लम) की हिफ़ाज़त के लिए किसी को भेजने का इरादा किया तो उन्होंने कहा:] ऐ मेरे चचा! अल्लाह तआला ने मुझे जिन्नों और इंसानों के शर से महफ़ूज़ किया है))।"
"1506","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने कुछ औरतों से शादी करने से मना किया))।"
"1507","[AI-translation] ((इंसानी शैतान जिन्नी शैतानों पर ग़ालिब हैं))।"
"1508","[AI-translation] ((नज़र-ए-बद से हिफ़ाज़त के लिए अल्लाह की किताब में आठ आयतें हैं। जो उन्हें अपने घर में पढ़े, उस दिन घर वालों पर न इंसान न जिन्न नज़र लगा सकते हैं। सात आयतें सूरत-ए-फ़ातिहा से हैं, और एक आयत आयत-उल-कुर्सी है))।"
