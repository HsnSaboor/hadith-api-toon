hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"31063","(۳۱۰۶۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا دَاوُد ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ تَمِیمٍ الدَّارِیِّ بِمِثْلِ حَدِیثِ یَزِیدَ ، إلاَّ أَنَّہُ لَمْ یَذْکُرْ فِیہِ وَیُؤْخَذُ بِطَرَفَیْہِ فَیُقْذَفُ بِہِ فِی النَّارِ۔","Sahih","Musannaf Ibn Abi Shaybah 31063","","","كتاب الإيمان"
"31064","(۳۱۰۶۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حَدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ زُبَیْدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: کَیْفَ أَصْبَحْت یَا حَارِثَ بْنَ مَالِکٍ ، قَالَ : أَصْبَحْت مُؤْمِنًا حَقًّا ، قَالَ : إنَّ لِکُلِّ قَوْلٍ حَقِیقَۃً فَمَا حَقِیقَۃُ ذَلِکَ ، قَالَ : أَصْبَحْت عَزَفَتْ نَفْسِی عَنِ الدُّنْیَا فَأَسْہَرْت لَیْلِی وَأَظْمَأْت نَہَارِی وَلکَأَنِّی أَنْظُرُ إِلَی عَرْشِ رَبِّی قَدْ أُبْرِزَ لِلْحِسَابِ ، وَلکَأَنِّی أَنْظُرُ إِلَی أَہْلِ الْجَنَّۃِ یَتَزَاوَرُونَ فِی الْجَنَّۃِ ، وَلکَأَنِّی أَسْمَعُ عُوَائَ أَہْلِ النَّارِ، قَالَ : فَقَالَ لَہُ : عَبْدٌ نَوَّرَ الإِیمَانِ فِی قَلْبِہِ ، إذْ عَرَفْت فَالْزَمْ۔ (عبدالرزاق ۲۰۱۱۴۔ بزار ۳۲)","","Musannaf Ibn Abi Shaybah 31064","","","كتاب الإيمان"
"31065","(۳۱۰۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُوسَی بْنِ مُسْلِمٍ ، قَالَ : حدَّثَنَا ابْنُ سَابِطٍ ، قَالَ : کَانَ عَبْدُ اللہِ بْنُ رَوَاحَۃَ یَأْخُذُ بِیَدِ النَّفَرِ مِنْ أَصْحَابِہِ فَیَقُولُ : تَعَالَوْا نُؤْمِنُ سَاعَۃً تَعَالَوْا فَلْنَذْکُرُ اللَّہَ وَنَزْدَدْ إیمَانًا ، تَعَالَوْا نَذْکُرُہُ بِطَاعَتِہِ لَعَلَّہُ یَذْکُرُنَا بِمَغْفِرَتِہِ۔ (احمد ۲۶۵)","","Musannaf Ibn Abi Shaybah 31065","","","كتاب الإيمان"
"31066","(۳۱۰۶۶) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ بْنُ حَوْشَبٍ ، عَنْ أَبِی صَادِقٍ ، عَنْ عَلِیٍّ ، قَالَ : إنَّ الإسْلامَ ثَلاثُ أَثَافِیِ : الإِیمَانُ وَالصَّلاۃُ وَالْجَمَاعَۃُ ، فَلا تُقْبَلُ صَلاۃٌ إلاَّ بِإِیمَانٍ ، وَمَنْ آمَنَ صَلَّی وَمَنْ صَلَّی جَامَعَ ، وَمَنْ فَارَقَ الْجَمَاعَۃَ قَیْدَ شِبْرٍ فَقَدْ خَلَعَ رِبْقَۃَ الإسْلامِ مِنْ عُنُقِہِ۔","","Musannaf Ibn Abi Shaybah 31066","","","كتاب الإيمان"
"31067","(۳۱۰۶۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ مُطَرِّفٍ ، عَنْ حَسَّانَ بْنِ عَطِیَّۃَ ، عَنْ أَبِی أُمَامَۃَ الباہلی، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَیَائُ وَالْعِیُّ شُعْبَتَانِ مِنَ الإِیمَانِ۔ (احمد ۲۶۹۔ حاکم ۵۲)","","Musannaf Ibn Abi Shaybah 31067","","","كتاب الإيمان"
"31068","(۳۱۰۶۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، قَالَ: وَرَدْنَا الْمَدِینَۃِ، فَأَتَیْنَا عَبْدَ اللہِ بْنَ عُمَرَ ، فَقُلْنَا : یَا أَبَا عَبْدِ الرَّحْمَنِ ، إنَّا نُمْعِنُ فِی الأَرْضِ فَنَلْقَی قَوْمًا یَزْعُمُونَ أَنْ لاَ قَدَرَ ، فَقَالَ : مِنَ الْمُسْلِمِینَ مِمَّنْ یُصَلِّی إِلَی الْقِبْلَۃِ ، قُلْنَا نَعَمْ مِمَّنْ یُصَلِّی إِلَی الْقِبْلَۃِ ، قَالَ : فَغَضِبَ حتَّی وَدِدْت أَنِّی لَمْ أَکُنْ سَأَلْتُہُ ، ثُمَّ قَالَ : إذَا لَقِیت أُولَئِکَ فَأَخْبِرْہُمْ ، أَنَّ عَبْدَ اللہِ بْنَ عُمَرَ مِنْہُمْ بَرِیئٌ وَأَنَّہُمْ مِنْہُ بُرَآئُ ، ثُمَّ قَالَ : إِنْ شِئْتَ حَدَّثْتُک ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فقلت : أَجَلْ فَقَالَ : کُنَّا عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ رَجُلٌ جَیِّدُ الثِّیَابِ طَیِّبُ الرِّیحِ حَسَنُ الْوَجْہِ ، فَقَالَ : یَا رَسُولَ اللہِ ، مَا الإسْلامُ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تُقِیمُ الصَّلاۃَ وَتُؤْتِی الزَّکَاۃَ وَتَصُومُ رَمَضَانَ وَتَحُجُّ الْبَیْتَ وَتَغْتَسِلُ مِنَ الْجَنَابَۃِ ، قَالَ : صَدَقْت ، فَمَا الإِیمَانُ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تُؤْمِنُ بِاللہِ وَالْیَوْمِ الآخِرِ وَالْمَلائِکَۃِ وَالْکِتَابِ وَالنَّبِیُّینَ وَبِالْقَدَرِ کُلِّہِ خَیْرِہِ وَشَرِّہِ وَحُلْوِہِ وَمُرِّہِ ، قَالَ : صَدَقْت ، ثُمَّ انْصَرَفَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَلَیَّ بِالرَّجُلِ ، قَالَ : فَقُمْنَا بِأَجْمَعِنَا فَلَمْ نَقْدِرْ عَلَیْہِ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ہَذَا جِبْرِیلُ أَتَاکُمْ یُعَلِّمُکُمْ أَمْرَ دِینَکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 31068","","","كتاب الإيمان"
"31069","(۳۱۰۶۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبَانُ الْعَطَّارُ ، قَالَ : حَدَّثَنَا یَحْیَی بْنُ أَبِی کَثِیرٍ ، عَنْ زَیْدٍ ، عَنْ أَبِی سَلاَّمٍ ، عَنْ أَبِی مَالِکٍ الأَشْعَرِیِّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : الطُّہْرُ شَطْرُ الإِیمَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 31069","","","كتاب الإيمان"
"31070","(۳۱۰۷۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی لَیْلَی الْکِنْدِیِّ ، عَنْ حُجْرِ بْنِ عَدِیٍّ ، قَالَ : حدَّثَنَا عَلِیٌّ ، أَنَّ الطُّہُورَ شَطْرُ الإِیمَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 31070","","","كتاب الإيمان"
"31071","(۳۱۰۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَوْزَاعِیُّ ، عَنْ حَسَّانَ بْنِ عَطِیَّۃَ ، قَالَ : الْوُضُوئُ شَطْرُ الإِیمَانِ۔","","Musannaf Ibn Abi Shaybah 31071","","","كتاب الإيمان"
"31072","(۳۱۰۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی لَیْلَی الْکِنْدِیِّ ، عَنْ غُلامٍ لِحُجْر ، أَنَّ حُجْرًا رَأَی ابْنًا لَہُ خَرَجَ مِنَ الْغَائِطِ ، فَقَالَ : یَا غُلامُ نَاوِلْنِی الصَّحِیفَۃَ مِنَ الْکُوَّۃِ فَسَمِعْت عَلِیًّا یَقُولُ : الطُّہُورُ نِصْفُ الإِیمَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 31072","","","كتاب الإيمان"
"31073","(۳۱۰۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، قَالَ : حَدَّثَنِی الْحَوَارِیُّ ، أَنَّ عَبْدَ اللہِ بْنَ عمر ، قَالَ : إنَّ عُرَی الدِّینِ وَقِوَامَہُ الصَّلاۃُ وَالزَّکَاۃُ لاَ یُفَرَّقُ بَیْنَہُمَا ، وَحَجُّ الْبَیْتِ وَصَوْمُ رَمَضَانَ ، وَإِنَّ مِنْ إصْلاحِ الأَعْمَالِ الصَّدَقَۃَ وَالْجِہَادَ ، قُمْ فَانْطَلِقْ۔","Da'if","Musannaf Ibn Abi Shaybah 31073","","","كتاب الإيمان"
"31074","(۳۱۰۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَکْمَلُ الْمُؤْمِنِینَ إیمَانًا أَحْسَنُہُمْ خُلُقًا۔","Hasan","Musannaf Ibn Abi Shaybah 31074","","","كتاب الإيمان"
"31075","(۳۱۰۷۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ أَبِی إسْمَاعِیلَ ، عَنْ مَعْقِلٍ الْخَثْعَمِیِّ ، قَالَ : أَتَی عَلِیًّا رَجُلٌ وَہُوَ فِی الرَّحْبَۃِ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، مَا تَرَی فِی امْرَأَۃٍ لاَ تُصَلِّی ، قَالَ : مَنْ لَمْ یُصَلِّ فَہُوَ کَافِرٌ۔","Da'if","Musannaf Ibn Abi Shaybah 31075","","","كتاب الإيمان"
"31076","(۳۱۰۷۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ عَبْدِ اللہِ بْنِ ضَمْرَۃَ ، عَنْ کَعْبٍ ، قَالَ : مَنْ أَقَامَ الصَّلاۃَ وَآتَی الزَّکَاۃَ فَقَدْ تَوسَّطَ الإِیمَانَ۔","","Musannaf Ibn Abi Shaybah 31076","","","كتاب الإيمان"
"31077","(۳۱۰۷۷) حَدَّثَنَا مُحَمَّد بْنُ عُبَیْد ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ عَبْدِ اللہِ بْنِ ضَمْرَۃَ ، عَنْ کَعْبٍ ، قَالَ : مَنْ أَقَامَ الصَّلاۃَ وَآتَی الزَّکَاۃَ وَسَمِعَ وَأَطَاعَ فَقَدْ تَوَسَّطَ الإِیمَانَ ، وَمَنْ أَحَبَّ لِلَّہِ وَأَبْغَضَ لِلَّہِ وَأَعْطَی لِلَّہِ وَمَنَعَ لِلَّہِ فَقَدِ اسْتَکْمَلَ الإِیمَانَ۔","","Musannaf Ibn Abi Shaybah 31077","","","كتاب الإيمان"
"31078","(۳۱۰۷۸) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُبَیْدٍ الْکَلاعِیِّ ، قَالَ : أَخَذَ بِیَدِی مَکْحُولٌ ، فَقَالَ : یَا أَبَا وَہْبٍ ، لِیَعْظُمْ شَأْنُ الإِیمَانِ فِی نَفْسِکَ ، مَنْ تَرَکَ صَلاۃً مَکْتُوبَۃً مُتَعَمِّدًا فَقَدْ بَرِئَتْ مِنْہُ ذِمَّۃُ اللہِ ، وَمَنْ بَرِئَتْ مِنْہُ ذِمَّۃُ اللہِ فَقَدْ کَفَرَ۔","","Musannaf Ibn Abi Shaybah 31078","","","كتاب الإيمان"
"31079","(۳۱۰۷۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : قَالَ عَلِیٌّ : الصَّبْرُ مِنَ الإِیمَانِ بِمَنْزِلَۃِ الرَّأْسِ مِنَ الْجَسَدِ ، فَإِذَا ذَہَبَ الصَّبْرُ ذَہَبَ الإِیمَانُ۔","","Musannaf Ibn Abi Shaybah 31079","","","كتاب الإيمان"
"31080","(۳۱۰۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ صِلَۃَ ، عَنْ عَمَّارٍ ، قَالَ : ثَلاثٌ مَنْ جَمَعَہُنَّ جَمَعَ الإِیمَانَ : الإِنْصَافُ مِنْ نَفْسِکَ ، وَالإِنْفَاقُ مِنَ الإِقْتَارِ ، وَبَذْلُ السَّلامِ لِلْعَالِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 31080","","","كتاب الإيمان"
"31081","(۳۱۰۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ صِلَۃَ ، عَنْ عَمَّارٍ : {إنَّہُمْ لاَ أَیْمَانَ لَہُمْ} قَالَ : لاَ عَہْدَ لَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 31081","","","كتاب الإيمان"
"31082","(۳۱۰۸۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالَ : لاَ یَدْخُلُ النَّارَ إنْسَانٌ فِی قَلْبِہِ مِثْقَالُ حَبَّۃِ خَرْدَلٍ مِنْ إیمَانٍ۔ (مسلم ۹۳)","","Musannaf Ibn Abi Shaybah 31082","","","كتاب الإيمان"
"31083","(۳۱۰۸۳) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ الصَّعْقِ بْنِ حَزْنٍ ، قَالَ : حدَّثَنِی عَقِیلُ الْجَعْدِی ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوْثَقُ عُرَی الإِیمَانِ الْحُبُّ فِی اللہِ وَالْبُغْضُ فِی اللہِ۔ (طیالسی ۳۷۸۔ حاکم ۴۸۰)","Da'if","Musannaf Ibn Abi Shaybah 31083","","","كتاب الإيمان"
"31084","(۳۱۰۸۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، قَالَ : حدَّثَنِی عِیسَی بْنُ عَاصِمٍ ، قَالَ : حَدَّثَنا عَدِیُّ بْنُ عَدِیٍّ ، قَالَ : کَتَبَ إلَیَّ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ أَمَّا بَعْدُ فَإِنَّ الإِیمَان فَرَائِضَ وَشَرَائِعَ وَحُدُودَ وَسُنَن ، فَمَنِ اسْتَکْمَلَہَا اسْتَکْمَلَ الإِیمَانَ ، وَمَنْ لَمْ یَسْتَکْمِلْہَا لَمْ یَسْتَکْمِلِ الإِیمَانَ ، فَإِنْ أَعِشْ فَسَأُبَیِّنُہَا لَکُمْ حَتَّی تَعْمَلُوا بِہَا ، وَإِنْ أَمُتْ قَبْلَ ذَلِکَ فَمَا أَنَا عَلَی صُحْبَتِکُمْ بِحَرِیصٍ۔","","Musannaf Ibn Abi Shaybah 31084","","","كتاب الإيمان"
"31085","(۳۱۰۸۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : لاَ بُدَّ لأَہْلِ ہَذَا الدِّینِ مِنْ أَرْبَعٍ : دُخُولٌ فِی دَعْوَۃِ الإسْلامِ ، وَلا بُدَّ مِنَ الإِیمَانِ وَتَصْدِیقٌ بِاللہِ وَبِالْمُرْسَلِینَ أَوَّلِہِمْ وَآخِرِہِمْ وَبِالْجَنَّۃِ وَالنَّارِ وَالْبَعْثِ بَعْدَ الْمَوْتِ ، وَلا بُدَّ من أَنْ تَعْمَلَ عَمَلاً تُصَدِّقُ بِہِ ، وَلا بُدَّ مِنْ أَنْ تَعْلَمَ عِلْمًا یُحْسِنُ بِہِ عَمَلَک ، ثُمَّ قَرَأَ : {وَإِنِّی لَغَفَّارٌ لِمَنْ تَابَ وَآمَنَ وَعَمِلَ صَالِحًا ثُمَّ اہْتَدَی}۔","","Musannaf Ibn Abi Shaybah 31085","","","كتاب الإيمان"
"31086","(۳۱۰۸۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، قَالَ : مَا کَانُوا یَقُولُونَ لِعَمَلٍ تَرَکَہُ رَجُلٌ کُفْرٌ غَیْرِ الصَّلاۃِ ، قَالَ : کَانُوا یَقُولُونَ : تَرْکُہَا کُفْرٌ۔","Sahih","Musannaf Ibn Abi Shaybah 31086","","","كتاب الإيمان"
"31087","(۳۱۰۸۷) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : قیلَ لَہُ : إنَّ أُنَاسًا یَزْعُمُونَ أَنَّ الْمُؤْمِنِینَ یَدْخُلُونَ النَّارَ ، قَالَ : لَعَمْرُک وَاللہِ إنَّ حَشْوَہَا غَیْرُ الْمُؤْمِنِینَ۔","","Musannaf Ibn Abi Shaybah 31087","","","كتاب الإيمان"
"31088","(۳۱۰۸۸) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، قَالَ : سَمِعْتُ شَقِیقًا یَقُولُ وَسَأَلَہُ رَجُلٌ : سَمِعْتَ ابْنَ مَسْعُودٍ یَقُولُ : أَنَّہُ مَنْ شَہِدَ أَنَّہُ مُؤْمِنٌ فَلْیَشْہَدْ ، أَنَّہُ فِی الْجَنَّۃِ ، قَالَ : نَعَمْ۔","Sahih","Musannaf Ibn Abi Shaybah 31088","","","كتاب الإيمان"
"31089","(۳۱۰۸۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ وَکِیعِ بْنِ عُدُسٍ الْعُقَیْلِیِّ ، عَنْ عَمِّہِ أَبِی رَزِینٍ : أَنَّہُ سَمِعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الرُّؤْیَا عَلَی رِجْلِ طَائِرٍ مَا لَمْ تُعْبَرْ فَإِذَا عُبِرَتْ وَقَعَتْ۔n قَالَ : وَالرُّؤْیَا جُزْئٌ مِنْ سِتَّۃٍ وَأَرْبَعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔n قَالَ : وَأَحْسَبُہُ قَالَ : لاَ تَقُصَّہَا إلاَّ عَلَی وَادٍّ ، أَوْ ذِی رَأْیٍ۔ (احمد ۱۲۔ حاکم ۳۹۰)","Da'if","Musannaf Ibn Abi Shaybah 31089","","","كتاب الرؤيا"
"31090","(۳۱۰۹۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ قَالَ : رُؤْیَا الْمُسْلِمِ جُزْئٌ مِنْ سِتَّۃٍ وَأَرْبَعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔n(بخاری ۶۹۸۸۔ مسلم ۱۷۷۴)","Sahih","Musannaf Ibn Abi Shaybah 31090","","","كتاب الرؤيا"
"31091","(۳۱۰۹۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رُؤْیَا الْمُسْلِمِ جُزْئٌ مِنْ سِتَّۃٍ وَأَرْبَعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔ (مسلم ۱۷۷۴۔ احمد ۴۹۵)","Sahih","Musannaf Ibn Abi Shaybah 31091","","","كتاب الرؤيا"
"31092","(۳۱۰۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی صَالِحٍ ، عَنْ عَطَائِ بْنِ یَسَارٍ، عَنْ رَجُلٍ کَانَ یُفْتِی بِمِصْرٍ، قَالَ : سَأَلْتُ أَبَا الدَّرْدَائِ عَنْ ہَذِہِ الآیَۃِ : {لَہُمُ الْبُشْرَی فِی الْحَیَاۃِ الدُّنْیَا} قَالَ مَا سَأَلَنِی عنہا أَحَدٌ مُنْذُ سَأَلْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عنہا ، فَقَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا سَأَلَنِی أَحَدٌ قَبْلَک : ہِیَ الرُّؤْیَا الصَّالِحَۃُ یَرَاہَا الْمُسْلِمُ ، أَوْ تُرَی لَہُ ، وَفِی الآخِرَۃِ الْجَنَّۃُ۔ (ترمذی ۳۱۰۶۔ احمد ۴۴۷)","Da'if","Musannaf Ibn Abi Shaybah 31092","","","كتاب الرؤيا"
"31093","(۳۱۰۹۳) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ، قَالَ: حدَّثَنَا شُعْبَۃُ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ، عَنْ عُبَادَۃَ بْنِ الصَّامِتِ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ: رُؤْیَا الْمُسْلِمِ جُزْئٌ مِنْ سِتَّۃٍ وَأَرْبَعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔ (بخاری ۶۹۸۷۔ مسلم ۱۷۷۴)","Sahih","Musannaf Ibn Abi Shaybah 31093","","","كتاب الرؤيا"
"31094","(۳۱۰۹۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : سَأَلْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْبُشْرَی فِی الْحَیَاۃِ الدُّنْیَا ؟ قَالَ : الرُّؤْیَا الْحَسَنَۃُ یَرَاہَا الْمُسْلِمُ ، أَوْ تُرَی لَہُ۔ (ترمذی ۳۱۰۶)","","Musannaf Ibn Abi Shaybah 31094","","","كتاب الرؤيا"
"31095","(۳۱۰۹۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ وَأَبُو أُسَامَۃَ ، قَالاَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : الرُّؤْیَا الصَّالِحَۃُ جُزْئٌ مِنْ سَبْعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔n(مسلم ۱۷۷۵۔ احمد ۱۸)","Sahih","Musannaf Ibn Abi Shaybah 31095","","","كتاب الرؤيا"
"31096","(۳۱۰۹۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ سُلَیْمَانَ بْنِ سُحَیْمٍ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ اللہِ بْنِ مَعْبَدٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَشَفَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ السِّتْرَ وَالنَّاسُ صُفُوفٌ خَلْفَ أَبِی بَکْرٍ ، فَقَالَ : أَیُّہَا النَّاسُ ، إِنَّہُ لَمْ یَبْقَ مِنْ مُبَشِّرَاتِ النُّبُوَّۃِ إلاَّ الرُّؤْیَا الصَّالِحَۃَ یَرَاہَا الْمُسْلِمُ ، أَوْ تُرَی لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31096","","","كتاب الرؤيا"
"31097","(۳۱۰۹۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ الْمُخْتَارِ بْنِ فُلْفُلٍ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ النُّبُوَّۃَ قَدِ انْقَطَعَتْ وَالرِّسَالَۃُ ، فَحَرِجَ النَّاسُ ، فَقَالَ : قَدْ بَقِیَتْ مُبَشِّرَاتٌ ، وَہِیَ جُزْئٌ مِنَ النُّبُوَّۃِ۔n(ترمذی ۲۲۷۲۔ احمد ۲۶۷)","Sahih","Musannaf Ibn Abi Shaybah 31097","","","كتاب الرؤيا"
"31098","(۳۱۰۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی عِمْرَانَ الْجَوْنِیِّ ، عَنْ عَبْدِ اللہِ بْنِ الصَّامِتِ ، عَنْ أَبِی ذَرٍّ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، الرَّجُلُ یَعْمَلُ الْعَمَلَ یُحِبُّہُ النَّاسُ عَلَیْہِ ؟ قَالَ : تِلْکَ بُشْرَی الْمُؤْمِنِ۔n(مسلم ۱۶۶۔ ابن ماجہ ۴۲۲۵)","Sahih","Musannaf Ibn Abi Shaybah 31098","","","كتاب الرؤيا"
"31099","(۳۱۰۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، قَالَ : حَدَّثَنِی أَبُو حَصِینٍ ، عَنْ زَاہِرٍ الأَسْلَمِیِّ : عَنْ أَبِیہِ : أَنَّ عَبْدِ اللہِ کَانَ یَقُولُ : الرُّؤْیَا الصَّالِحَۃُ الصَّادِقَۃُ جُزْئٌ مِنْ سَبْعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔ (طبرانی ۹۰۵۷)","","Musannaf Ibn Abi Shaybah 31099","","","كتاب الرؤيا"
"31100","(۳۱۱۰۰) حَدَّثَنَا الْقَسْمَلِیُّ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : رُؤْیَا الْمُؤْمِنِ جُزْئٌ مِنْ سِتَّۃٍ وَأَرْبَعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔n(ابویعلی ۳۴۱۷)","Sahih","Musannaf Ibn Abi Shaybah 31100","","","كتاب الرؤيا"
"31101","(۳۱۱۰۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ، عَنْ أَبِی حَصِینٍ، عَنْ أَبِی صَالِحٍ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: الرُّؤْیَا مِنَ الْمُبَشِّرَاتِ، وَہِیَ جُزْئٌ مِنْ سَبْعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 31101","","","كتاب الرؤيا"
"31102","(۳۱۱۰۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ : {لَہُمُ الْبُشْرَی فِی الْحَیَاۃِ الدُّنْیَا} قَالَ : ہِیَ الرُّؤْیَا الصَّالِحَۃُ یَرَاہَا الْعَبْدُ الصَّالِحُ۔ (مالک ۹۵۸)","","Musannaf Ibn Abi Shaybah 31102","","","كتاب الرؤيا"
"31103","(۳۱۱۰۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ : {لَہُمُ الْبُشْرَی فِی الْحَیَاۃِ الدُّنْیَا} قَالَ : ہِیَ الرُّؤْیَا الصَّالِحَۃُ یَرَاہَا الْمُسْلِمُ ، أَوْ تُرَی لَہُ۔","","Musannaf Ibn Abi Shaybah 31103","","","كتاب الرؤيا"
"31104","(۳۱۱۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ الْقَنَّادِ ، عَنْ جَعْفَرٍ ، عَنْ سَ[corrupt]ِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ : {لَہُمُ الْبُشْرَی فِی الْحَیَاۃِ الدُّنْیَا} قَالَ : الرُّؤْیَا الْحَسَنَۃُ یَرَاہَا الرَّجُلُ الْمُسْلِمُ لِنَفْسِہِ ، أَوْ لأَخِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 31104","","","كتاب الرؤيا"
"31105","(۳۱۱۰۵) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ شَیْبان ، عَنْ فِرَاسٍ ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ : أَنَّ نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : رُؤْیَا الرَّجُلِ الْمُسْلِمِ الصَّالِحِ جُزْئٌ مِنْ سَبْعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔n(بخاری ۶۹۸۹۔ ابویعلی ۱۳۵۷)","Da'if","Musannaf Ibn Abi Shaybah 31105","","","كتاب الرؤيا"
"31106","(۳۱۱۰۶) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ رَآنِی فِی الْمَنَامِ فَقَدْ رَآنِی۔ (احمد ۴۷۲)","Sahih","Musannaf Ibn Abi Shaybah 31106","","","كتاب الرؤيا"
"31107","(۳۱۱۰۷) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ۔ وَعَنْ سُفْیَان ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ رَآنِی فِی الْمَنَامِ فَقَدْ رَآنِی ، إنَّ الشَّیْطَانَ لاَ یَتَمَثَّلُ فِی صُورَتِی۔ (بخاری ۶۹۹۳۔ مسلم ۱۷۷۵)","Sahih","Musannaf Ibn Abi Shaybah 31107","","","كتاب الرؤيا"
"31108","(۳۱۱۰۸) حَدَّثَنَا ہَوْذَۃُ بْنُ خَلِیفَۃَ ، قَالَ : حدَّثَنِی عَوْفٌ ، عَنْ یَزِیدَ الْفَارِسِیِّ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی النَّوْمِ زَمَنَ ابْنِ عَبَّاسٍ عَلَی الْبَصْرَۃِ ، قَالَ : قُلْتُ لاِبْنِ عَبَّاسٍ : إنِّی رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی النَّوْمِ ، فَقَالَ ابْنُ عَبَّاسٍ : فَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : إنَّ الشَّیْطَانَ لاَ یَسْتَطِیعُ أَنْ یَتَشَبَّہَ بِی ، فَمَنْ رَآنِی فِی النَّوْمِ فَقَدْ رَآنِی۔ (ابن ماجہ ۳۹۰۵۔ احمد ۲۷۹)","Hasan","Musannaf Ibn Abi Shaybah 31108","","","كتاب الرؤيا"
"31109","(۳۱۱۰۹) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللہِ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : مَنْ رَآنِی فِی النَّوْمِ فَقَدْ رَآنِی ، إِنَّ الشَّیْطَانَ لاَ یَتَمَثَّلُ فِی صُورَتِی۔n(مسلم ۱۷۷۶۔ احمد ۳)","Sahih","Musannaf Ibn Abi Shaybah 31109","","","كتاب الرؤيا"
"31110","(۳۱۱۱۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ مُخْتَارٍ ، قَالَ : حَدَّثَنَا ثَابِتٌ ، قَالَ : حَدَّثَنَا أَنَسٌ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ رَآنِی فِی الْمَنَامِ فَقَدْ رَآنِی ، إنَّ الشَّیْطَانَ لاَ یَتَمَثَّلُ بِی۔n(بخاری ۶۹۹۴۔ ابویعلی ۳۲۷۱)","Sahih","Musannaf Ibn Abi Shaybah 31110","","","كتاب الرؤيا"
"31111","(۳۱۱۱۱) حَدَّثَنَا بَکْرُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : أَخْبَرَنَا عِیسَی ، عَنْ مُحَمَّدِ بْنِ أَبِی لَیْلَی ، عَنْ عطِیَّۃَ الْعَوْفِیِّ ، عَنْ أَبِی سَعِیدٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ رَآنِی فِی الْمَنَامِ فَقَدْ رَآنِی ، إنَّ الشَّیْطَانَ لاَ یَتَمَثَّلُ بِی۔ (بخاری ۶۹۹۷۔ ابن ماجہ ۳۹۰۳)","Da'if","Musannaf Ibn Abi Shaybah 31111","","","كتاب الرؤيا"
"31112","(۳۱۱۱۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ : قَالَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی رَأَیْت کَأَنَّ عُنُقِی ضُرِبَتْ ! قَالَ : لِمَ یُخْبِرُ أَحَدُکُمْ بِلَعِبِ الشَّیْطَانِ بِہِ؟!۔ (مسلم ۱۷۷۶۔ احمد ۳۸۳)","Sahih","Musannaf Ibn Abi Shaybah 31112","","","كتاب الرؤيا"
"31113","(۳۱۱۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، رَأَیْت فِی الْمَنَامِ کَأَنَّ رَأْسِی قُطِعَ ! قَالَ : فَضَحِکَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقَالَ : إذَا لَعِبَ الشَّیْطَانُ بِأَحَدِکُمْ فِی مَنَامِہِ فَلاَ یُحَدِّثْ بِہِ النَّاسَ۔ (مسلم ۱۷۷۷۔ احمد ۳۱۵)","Hasan","Musannaf Ibn Abi Shaybah 31113","","","كتاب الرؤيا"
"31114","(۳۱۱۱۴) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ عُمَرَ بْنِ سَعِیدِ بْنِ أَبِی الْحُسَینِ ، قَالَ : حدَّثَنِی عَطَائُ بْنُ أَبِی رَبَاحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : جَائَ رَجُلٌ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنِّی رَأَیْت فِی الْمَنَامِ کَأَنَّ رَأْسِی ضُرِبَتْ ، فَرَأَیْتہ بِیَدِی ہَذِہِ ! قَالَ : فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَعْمِدُ الشَّیْطَانُ إلَی أَحَدِکُمْ فَیَتَہَوَّلُ لَہُ ، ثُمَّ یَغْدُو فَیُخْبِرُ النَّاسَ!۔ (ابن ماجہ ۳۹۱۱۔ احمد ۳۶۴)","Hasan","Musannaf Ibn Abi Shaybah 31114","","","كتاب الرؤيا"
"31115","(۳۱۱۱۵) حَدَّثَنَا مُعَاوِیَۃ بْن ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حَارِثَۃَ بْنِ مُضَرِّبٍ : أَنَّ رَجُلاً رَأَی رُؤْیَا : مَنْ صَلَّی اللَّیْلَۃَ فِی الْمَسْجِدِ دَخَلَ الْجَنَّۃَ ! ، فَخَرَجَ عَبْدُ اللہِ بْنُ مَسْعُودٍ وَہُوَ یَقُولُ : اخْرُجُوا لاَ تَغْتَرُّوا فَإِنَّمَا ہِیَ نَفْخَۃُ شَیْطَانٍ!۔","Sahih","Musannaf Ibn Abi Shaybah 31115","","","كتاب الرؤيا"
"31116","(۳۱۱۱۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَأَیْت فِی یَدَیَّ سِوَارَین مِنْ ذَہَبٍ فَنَفَخْتَہُمَا فَأَوَّلْتہمَا ہَذَیْنِ الْکَذَّابَیْنِ : مُسَیْلِمَۃَ وَالْعَنْسِیَّ۔ (بخاری ۳۶۲۱۔ مسلم ۱۷۸۱)","Hasan","Musannaf Ibn Abi Shaybah 31116","","","كتاب الرؤيا"
"31117","(۳۱۱۱۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَأَیْت کَأَنَّ فِی یَدَیَّ سِوَارَیْنِ مِنْ ذَہَبٍ فَکَرِہْتہمَا فَنَفَخْتہمَا فَذَہَبَا : کِسْرَی وَقَیْصَرَ۔","Hasan","Musannaf Ibn Abi Shaybah 31117","","","كتاب الرؤيا"
"31118","(۳۱۱۱۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، قَالَ : أَتَی رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، رَأَیْت رَجُلاً یَخْرُجُ مِنَ الأَرْضِ وَعَلَی رَأْسِہِ رَجُلٌ فِی یَدِہِ مِرْزَبَّۃٌ مِنْ حَدِیدٍ ، کُلَّمَا أَخْرَجَ رَأْسَہُ ضَرَبَ رَأْسَہُ فَیَدْخُلُ فِی الأَرْضِ ، ثُمَّ یَخْرُجُ مِنْ مَکَان آخَرَ ، فَیَأْتِیہ فَیَضْرِبُ رَأْسَہُ فَقَالَ : ذَاکَ أَبُو جَہْلِ بْنُ ہِشَامٍ ، لاَ یَزَالُ یُصْنَعُ بِہِ ذَلِکَ إلَی یَوْمِ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 31118","","","كتاب الرؤيا"
"31119","(۳۱۱۱۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَبِی بَکْرٍ : إنِّی رَأَیْتُنِی یَتْبَعَنِی غَنَمٌ سُودٌ یَتْبَعُہَا غَنَمٌ عُفْرٌ ، فَقَالَ أَبُو بَکْرٍ : یَا رَسُولَ اللہِ ، ہَذِہِ الْعَرَبُ تَتْبَعُک تَتْبَعُہَا الْعَجَمُ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَذَلِکَ عَبَرَہَا الْمَلَکُ۔n(حاکم ۳۹۵۔ احمد ۴۵۵)","","Musannaf Ibn Abi Shaybah 31119","","","كتاب الرؤيا"
"31120","(۳۱۱۲۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنِ الْحُرِّ بْنِ الْصَیَّاح ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَذَلِکَ عَبَرَہَا الْمَلَکُ بِالسَّحَرِ۔","","Musannaf Ibn Abi Shaybah 31120","","","كتاب الرؤيا"
"31121","(۳۱۱۲۱) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا سُفْیَانُ بْنُ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنِّی رَأَیْت ظُلَّۃً تَنْطُفُ سَمْنًا وَعَسَلا ، وَکَأَنََّ النَّاسُ یَأْخُذُونَ مِنْہَا فَبَیْنَ مُسْتَکْثِرٍ وَبَیْنَ مُسْتَقِلٍّ ، وَبَیْنَ ذَلِکَ ، وَکَأَنَّ سَبَبًا دُلِّیَ مِنَ السَّمَائِ فَجِئْتَ فَأَخَذْتَ بِہِ فَعَلَوْتَ ، فَأَعْلاَک اللَّہُ ، ثُمَّ جَائَ رَجُلٌ مِنْ بَعْدِکَ فَأَخَذَ بِہِ فَعَلاَ ، فَأَعْلاَہُ اللَّہُ ، ثُمَّ جَائَ رَجُلٌ مِنْ بَعْدِکُمَا فَأَخَذَ بِہِ فَعَلاَ ، فَأَعْلاَہُ اللَّہُ ، ثُمَّ جَائَ رَجُلٌ مِنْ بَعْدِکُمْ فَأَخَذَ بِہِ ، ثُمَّ قَطَعَ بِہِ ثُمَّ وُصِلَ لَہُ فَعَلاَ ، فَأَعْلاَہُ اللَّہُ۔n فَقَالَ أَبُو بَکْرٍ : یَا رَسُولَ اللہِ ائْذَنْ لِی فَأعْبُرُہَا ، فَأَذِنَ لَہُ ، فَقَالَ : أَمَّا الظُّلَّۃُ فَالإِسْلاَمُ ، وَأَمَّا السَّمْنُ وَالْعَسَلُ فَالْقُرْآنُ ، وَأَمَّا السَّبَبُ فَمَا أَنْتَ عَلَیْہِ ، تَعْلُو فَیُعْلِیک اللَّہُ ، ثُمَّ یَکُونُ رَجُلٌ مِنْ بَعْدِکَ عَلَی مِنْہَاجِکَ فَیَعْلُو فَیُعْلِیہ اللَّہُ ، ثُمَّ یَکُونُ رَجُلٌ مِنْ بَعْدِکُمَا فَیَأْخُذُ بِأَخْذِکُمَا فَیَعْلُو فَیُعْلِیہ اللَّہُ ، ثُمَّ یَکُونُ رَجُلٌ مِنْ بَعْدِکُمْ عَلَی مِنْہَاجِکُمْ ثُمَّ یُقْطَعُ بِہِ ، ثُمَّ یُوصَلُ لَہُ فَیَعْلُو فَیُعْلِیہ اللَّہُ ، قَالَ : أَصَبْتُ یَا رَسُولَ اللہِ ؟ قَالَ : أَصَبْتَ وَأَخْطَأْتَ ، قَالَ : أَقْسَمْت یَا رَسُولَ اللہِ لَتُخْبِرنِّی ، قَالَ : لاَ تُقْسِمْ۔ (بخاری ۷۰۴۶۔ مسلم ۱۷۷۷)","Sahih","Musannaf Ibn Abi Shaybah 31121","","","كتاب الرؤيا"
"31122","(۳۱۱۲۲) حَدَّثَنَا قَبِیصَۃُ بْنُ عُقْبَۃَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرَۃَ ، عَنْ أَبِیہِ ، قَالَ : وَفَدْنَا مَعَ زِیَادٍ إلَی مُعَاوِیَۃَ فَمَا أُعْجِبَ بِوَفْدٍ مَا أُعْجِبَ بِنَا ، قَالَ : فَقَالَ : یَا أَبَا بَکْرَۃَ ! حَدِّثْنا بِشَیْئٍ سَمِعْتَہُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: - وَکَانَتْ تُعْجِبُہُ الرُّؤْیَا الْحَسَنَۃُ یَسْأَلُ عنہا - فَسَمِعْتَہُ یَقُولُ : رَأَیْتُ کَأَنَّ مِیزَانًا أُنْزِلَ مِنَ السَّمَائِ فَوُزِنْت فِیہِ أَنَا وَأَبُو بَکْرٍ فَرَجَحْت بِأَبِی بَکْرٍ ، وَوُزِنَ أَبُو بَکْرٍ وَعُمَرُ فَرَجَحَ أَبُو بَکْرٍ ، ثُمَّ وُزِنَ عُمَرُ وَعُثْمَان فَرَجَحَ عُمَرُ بِعُثْمَانَ ، ثُمَّ رُفِعَ الْمِیزَانُ إلَی السَّمَائِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خِلاَفَۃٌ ونُبُوَّۃ، ثُمَّ یُؤْتِی اللَّہُ الْمُلْکَ مَنْ یَشَائُ، قَالَ: فَزُخَّ فِی أَقْفِیَتِنَا فَأُخْرِجْنَا۔ (ابوداؤد ۴۶۱۰۔ ترمذی ۲۲۸۷)","Da'if","Musannaf Ibn Abi Shaybah 31122","","","كتاب الرؤيا"
"31123","(۳۱۱۲۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وُہَیْب ، قَالَ : حَدَّثَنِی مُوسَی بْنُ عُقْبَۃَ ، قَالَ : حَدَّثَنِی سَالِمٌ ، عَنْ رُؤْیَا رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی وَبَائِ الْمَدِینَۃِ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ : رَأَیْتُ امْرَأَۃً سَوْدَائَ ثَائِرَۃَ الرَّأْسِ خَرَجَتْ مِنَ الْمَدِینَۃِ حَتَّی قَدِمَتْ مَہْیَعَۃَ ، فَأَوَّلْت أَنَّ وَبَائَ الْمَدِینَۃِ نُقِلَ إلَی مَہْیَعَۃَ۔ (بخاری ۷۰۳۸۔ ترمذی ۲۲۹۰)","Sahih","Musannaf Ibn Abi Shaybah 31123","","","كتاب الرؤيا"
"31124","(۳۱۱۲۴) حَدَّثَنَا أَبُو دَاوُدَ عُمَرُ بْنُ سَعْدٍ ، عَنْ بَدْرِ بْنِ عُثْمَانَ ، عَنْ عُبَیْدِ اللہِ بْنِ مَرْوَانَ ، عَنْ أَبِی عَائِشَۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : خَرَجَ إلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ غَدَاۃٍ ، فَقَالَ : رَأَیْت آنِفًا أَنِّی أُعْطِیت الْمَوَازِینَ وَالْمَقَالَیدَ ، فَأَمَّا الْمَقَالَیدُ فَہَذِہِ الْمَفَاتِیحُ ، فَوُضِعْت فِی کِفَّۃٍ وَوُضِعَتْ أُمَّتِی فِی کِفَّۃٍ فَرَجَحْت بِہِمْ ، ثُمَّ جِیئَ بِأَبِی بَکْرٍ فَرَجَحَ ، ثُمَّ جِیئَ بِعُمَرَ فَرَجَحَ ، ثُمَّ جِیئَ بِعُثْمَانَ فَرَجَحَ ، قَالَ : ثُمَّ رُفِعْت ، قَالَ : فَقَالَ لَہُ رَجُلٌ : فَأَیْنَ نَحْنُ ؟ قَالَ : حَیْثُ جَعَلْتُمْ أَنْفُسَکُمْ۔ (احمد ۷۶)","Da'if","Musannaf Ibn Abi Shaybah 31124","","","كتاب الرؤيا"
"31125","(۳۱۱۲۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، قَالَ : حَدَّثَنِی أَبُو بَکْرِ بْنُ سَالِمِ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : رَأَیْتُ فِی النَّوْمِ کَأَنِّی أَنْزَعُ بِدَلْوِ بَکَرَۃٍ عَلَی قَلِیبٍ ، فَجَائَ أَبُو بَکْرٍ فَنَزَعَ ذَنُوباً أَوْ ذَنُوبَیْنِ ، فَنَزَعَ نَزْعًا ضَعِیفًا ، وَاللَّہُ یَغْفِرُ لَہُ ، ثُمَّ جَائَ عُمَرُ بْنُ الْخَطَّابِ فَاسْتَقَی فَاسْتَحَالَتْ غَرْبًا ، فَلَمْ أَرَ عَبْقَرِیًّا مِنَ النَّاسِ یَفْرِی فَرِیَّہُ ، حَتَّی رَوِیَ النَّاسُ وَضَرَبُوا بِعَطَنٍ۔ (بخاری ۳۶۷۶۔ مسلم ۱۹)","Sahih","Musannaf Ibn Abi Shaybah 31125","","","كتاب الرؤيا"
"31126","(۳۱۱۲۶) حَدَّثَنَا ہَوْذَۃُ بْنُ خَلِیفَۃَ ، قَالَ : حدَّثَنَا عَوْفٌ ، عَنْ أَبِی رَجَائٍ ، قَالَ : حَدَّثَنَا سَمُرَۃُ بْنُ جُنْدُبٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِمَّا یَقُولُ لأَصْحَابِہِ : ہَلْ رَأَی أَحَدٌ مِنْکُمْ رُؤْیَا ، فَیَقُصُّ عَلَیْہِ مَا شَائَ اللَّہُ أَنْ یَقُصَّ ، فَقَالَ لَنَا ذَاتَ غَدَاۃٍ : إنِّی أَتَانِی اللَّیْلَۃَ آتِیَانِ ، أَو اثْنَانِ الشَّکُّ مِنْ ہَوْذَۃَ ، فَقَالاَ لِی : انْطَلِقْ ، فَانْطَلَقْت مَعَہُمَا ، وَإِنَّا أَتَیْنَا عَلَی رَجُلٍ مُضْطَجِعٍ وَإِذَا آخَرُ قَائِمٌ عَلَیْہِ بِصَخْرَۃٍ ، وَإِذَا ہُوَ یَہْوِی بِالصَّخْرَۃِ لِرَأْسِہِ ، فَیَثْلَغُ رَأْسَہُ فَیَتَدَہْدَہُ الْحَجَرُ ہَاہُنَا فَیَأْخُذُہُ ، وَلاَ یَرْجِعُ إلَیْہِ حَتَّی یَصِحَّ رَأْسُہُ کَمَا کَانَ ، ثُمَّ یَعُودُ عَلَیْہِ فَیَفْعَلُ بِہِ مِثْلَ الْمَرَّۃِ الأُولَی ، قَالَ : قُلْتُ لَہُمَا : سُبْحَانَ اللہِ مَا ہَذَا فَقَالاَ لِی : انْطَلِقْ۔n فَانْطَلَقْنَا حَتَّی أَتَیْنَا عَلَی رَجُلٍ مُسْتَلْقٍ لِقَفَاہُ وَإِذَا آخَرُ قَائِمٌ عَلَیْہِ بِکَلُّوبٍ مِنْ حَدِیدٍ ، وَإِذَا ہُوَ یَأْتِی أَحَدَ شِقَّیْ وَجْہِہِ فَیُشَرْشِرُ شِدْقَہُ إلَی قَفَاہُ ، وَعَیْنَہُ إلَی قَفَاہُ ، وَمَنْخِرَہُ إلَی قَفَاہُ ، ثُمَّ یَتَحَوَّلُ إلَی الْجَانِبِ الآخَرِ ، فَیَفْعَلُ بِہِ مِثْلَ ذَلِکَ ، فَمَا یَفْرُغُ مِنْہُ حَتَّی یَصِحَّ ذَلِکَ الْجَانِبُ کَمَا کَانَ ، ثُمَّ یَعُودُ عَلَیْہِ فَیَفْعَلُ بِہِ کَمَا فَعَلَ فِی الْمَرَّۃِ الأُولَی ، فَقُلْتُ لَہُمَا : سُبْحَانَ اللہِ مَا ہَذَا ؟ قَالَ : قَالاَ لِی : انْطَلِقَ انْطَلِقْ۔n فَانْطَلَقْنَا حَتَّی أَتَیْنَا عَلَی مِثْلِ بِنَائِ التَّنُّورِ ، قَالَ : فَأَحْسِبُ أَنَّہُ قَالَ سَمِعَنَّا فِیہِ لَغَطًا وَأَصْوَاتًا ، فَاطلعنَا فَإِذَا فِیہِ رِجَالٌ وَنِسَائٌ عُرَاۃٌ وَإِذَا ہُمْ یَأْتِیہِمْ لَہَبٌ مِنْ أَسْفَلَ مِنْہُمْ ، فَإِذَا أَتَاہُمْ ذَلِکَ اللَّہَبُ ضَوْضَوا ، قَالَ : قُلْتُ لَہُمَا : مَا ہَؤُلاَئِ ؟ قَالَ : قَالاَ لِی : انْطَلِقَ انْطَلِقْ۔n قَالَ : فَانْطَلَقْنَا حَتَّی أَتَیْنَا عَلَی نَہْرٍ - حَسِبْت أَنَّہُ قَالَ أَحْمَرَ - مِثْلِ الدَّمِ ، فَإِذَا فِی النَّہَرِ رَجُلٌ یَسْبَحُ وَإِذَا عَلَی شَاطِیئِ النَّہَرِ رَجُلٌ قَدْ جَمَعَ عِنْدَہُ حِجَارَۃً کَثِیرَۃً ، وَإِذَا ذَلِکَ السَّابِحُ یَسْبَحُ مَا سَبَحَ ، ثُمَّ یَأْتِی ذَلِکَ الَّذِی قَدْ جَمَعَ عِنْدَہُ الْحِجَارَۃَ فَیَفْغَرُ لَہُ فَاہُ ، فَیُلْقِمُہُ حَجَرًا ، فَیَذْہَبُ فَیَسْبَحُ مَا سَبَحَ ، ثُمَّ یَأْتِی ذَلِکَ الَّذِی کُلَّمَا رَجَعَ فَغَرَ لَہُ فَاہُ فَأَلْقَمَہُ الْحَجَرَ ، قَالَ : قُلْتُ : مَا ہَذَا ؟ قَالَ : قَالاَ : لِی : انْطَلِقَ انْطَلِقْ۔n قَالَ : فَانْطَلَقْنَا ، فَأَتَیْنَا عَلَی رَجُلٍ کَرِیہِ الْمَرْآۃِ کَأَکْرَہِ مَا أَنْتَ رَائٍ رَجُلاً مَرْآۃً ، وَإِذَا ہُوَ عِنْدَ نَارٍ یَحشُہَا وَیَسْعَی حَوْلَہَا ، قَالَ : قُلْتُ لَہُمَا : مَا ہَذَا ؟ قَالاَ لِی : انْطَلِقَ انْطَلِقْ۔n فَانْطَلَقْنَا حَتَّی أَتَیْنَا عَلَی رَوْضَۃٍ مُعْتمَّۃٍ فِیہَا مِنْ کُلِّ نَوْرِ الرَّبِیعِ وَإِذَا بَیْنَ ظَہْرَانَیِ الرَّوْضَۃِ رَجُلٌ طَوِیلٌ لاَ أَکَادُ أَرَی رَأْسَہُ طُولاً فِی السَّمَائِ وَإِذَا حَوْلَ الرَّجُلِ مِنْ أَکْثَرِ وِلْدَانٍ رَأَیْتہمْ قَطُّ وَأَحْسَنِہ ، قَالَ : قُلْتُ لَہُمَا: مَا ہَذَا ؟ وَمَا ہَؤُلاَئِ ؟ قَالَ : قَالاَ لِی : انْطَلِقْ۔n فَانْطَلَقْنَا ، فَانْتَہَیْنَا إلَی دَرَجَۃٍ عَظِیمَۃٍ لَمْ أَرَ قَطُّ دَرَجَۃً أَعْظَمَ مِنْہَا وَلاَ أَحْسَنَ ، قَالَ : قَالاَ لِی : ارْقَ فِیہَا ، فَارْتَقَیْتہَا فَانْتَہَیْنَا إلَی مَدِینَۃٍ مَبْنِیَّۃٍ بِلَبِنِ ذَہَبٍ وَلَبِنِ فِضَّۃٍ ، قَالَ : فَأَتَیْنَا بَابَ الْمَدِینَۃِ فَاسْتَفْتَحْنَاہَا فَفُتِحَ لَنَا ، فَدَخَلْنَاہَا فَتَلَقَّانَا فِیہَا رِجَالٌ شَطْرٌ مِنْ خَلْقِہِمْ کَأَحْسَنِ مَا أَنْتَ رَائٍ وَشَطْرٌ کَأَقْبَحِ مَا أَنْتَ رَائٍ ، قَالَ : قَالاَ لَہُمْ : اذْہَبُوا فَقَعُوا فِی ذَلِکَ النَّہَرِ ، قَالَ : فَإِذَا نَہْرٌ مُعْتَرِضٌ یَجْرِی کَأَنَّ مَائَہُ الْمَحْضُ مِنَ الْبَیَاضِ ، قَالَ : فَذَہَبُوا فَوَقَعُوا فِیہِ ، ثُمَّ رَجَعُوا إلَیْنَا وَقَدْ ذَہَبَ السُّوئُ عَنْہُمْ وَصَارُوا فِی أَحْسَنِ صُورَۃٍ۔n قَالَ : قَالاَ لِی : ہَذِہِ جَنَّۃُ عَدْنٍ ، وَہَا ہُوَ ذَاکَ مَنْزِلُک ، قَالَ : فَسَمَا بَصَرِی صُعَدَاً ، فَإِذَا قَصْرٌ مِثْلُ الرَّبَابَۃِ الْبَیْضَائِ ، قَالَ : قَالاَ لِی : ہَا ہُوَ ذَاک مَنْزِلُک ، قَالَ : قُلْتُ لَہُمَا : بَارَکَ اللَّہُ فِیکُمَا ذَرَانِی فَلأَدْخُلُہُ ، قَالَ : قَالاَ لِی : أَمَّا الآنَ فَلاَ ، وَأَنْتَ دَاخِلُہُ۔n قَالَ : قُلْتُ لَہُمَا : إنِّی قَدْ رَأَیْت ہَذِہِ اللَّیْلَۃَ عَجَبًا ، فَمَا ہَذَا الَّذِی رَأَیْت ؟ قَالَ : قَالاَ : أَمَا إنَّا سَنُخْبِرُک ، أَمَّا الرَّجُلُ الأَوَّلُ الَّذِی أَتَیْتَ عَلَیْہِ یُثْلَغُ رَأْسُہُ بِالْحَجَرِ فَإِنَّہُ رَجُلٌ یَأْخُذُ الْقُرْآنَ وَیَنَامُ عَنِ الصَّلاَۃِ الْمَکْتُوبَۃِ۔ وَأَمَّا الرَّجُلُ الَّذِی أَتَیْتَ عَلَیْہِ یُشَرْشَرُ شَدْقَہُ وَعَیْنَہُ وَمَنْخِرَہُ إلَی قَفَاہُ فَإِنَّہُ رَجُلٌ یَغْدُو مِنْ بَیْتِہِ فَیَکْذِبُ الْکِذْبَۃَ تَبْلُغُ الآفَاقَ۔ وَأَمَّا الرِّجَالُ وَالنِّسَائُ الْعُرَاۃُ الَّذِینَ فِی مِثْلِ بِنَائِ التَّنُّورِ فَإِنَّہُمَ الزُّنَاۃُ وَالزَّوَانِی۔ وَأَمَّا الرَّجُلُ الَّذِی یَسْبَحُ فِی النَّہَرِ وَیُلْقَمُ الْحِجَارَۃَ فَإِنَّہُ آکِلُ الرِّبَا۔ وَأَمَّا الرَّجُلُ الَّذِی عِنْدَ النَّارِ کَرِیہِ الْمِرْآۃِ فَإِنَّہُ مَالِکٌ خَازِنُ جَہَنَّمَ۔ وَأَمَّا الرَّجُلُ الطَّوِیلُ الَّذِی فِی الرَّوْضَۃِ فَإِنَّہُ إبْرَاہِیمُ ، وَأَمَّا الْوِلْدَانُ الَّذِینَ حَوْلَہُ فَکُلُّ مَوْلُودٍ مَاتَ عَلَی الْفِطْرَۃِ ، قَالَ : فَقَالَ بَعْضُ الْمُسْلِمِینَ : یَا رَسُولَ اللہِ ، وَأَوْلاَدُ الْمُشْرِکِینَ ؟ قَالَ : وَأَوْلاَدُ الْمُشْرِکِینَ۔n وَأَمَّا الْقَوْمُ الَّذِینَ شَطْرٌ مِنْہُمْ کَأَقْبَحِ مَا رَأَیْت وَشَطْرٌ کَأَحْسَنِ مَا رَأَیْت فَإِنَّہُمْ قَوْمٌ خَلَطُوا عَمَلاً صَالِحًا وَآخَرَ سَیِّئًا فَتَجَاوَزَ اللَّہُ عَنْہُمْ۔ (بخاری ۱۳۸۶۔ مسلم ۱۷۸۱)","Sahih","Musannaf Ibn Abi Shaybah 31126","","","كتاب الرؤيا"
"31127","(۳۱۱۲۷) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَاصِمِ بْنِ بَہْدَلَۃَ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ خَرَشَۃَ بْنِ الْحُرِّ ، قَالَ : قَدِمْت الْمَدِینَۃَ فَجَلَسْت إلَی مَشْیَخَۃٍ فِی الْمَسْجِدِ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَجَائَ شَیْخٌ مُتَوَکِّئٌ عَلَی عَصًا لَہُ ، فَقَالَ الْقَوْمُ : مَنْ سَرَّہُ أَنْ یَنْظُرَ إلَی رَجُلٍ مِنْ أَہْلِ الْجَنَّۃِ فَلْیَنْظُرْ إلَی ہَذَا ، قَالَ : فَقَامَ خَلْفَ سَارِیَۃٍ فَصَلَّی رَکْعَتَیْنِ فَقُمْت إلَیْہِ فَقُلْتُ لَہُ : قَالَ بَعْضُ الْقَوْمِ کَذَا وَکَذَا ، فَقَالَ : الْجَنَّۃُ لِلَّہِ یُدْخِلُہَا مَنْ یَشَائُ ، وَإِنِّی رَأَیْت عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رُؤْیَا : رَأَیْت کَأَنَّ رَجُلاً یَأْتِی ، فَقَالَ لِی : انْطَلِقْ فَذَہَبْت مَعَہُ فَسَلِکَ بِی فِی مَنْہَجٍ عَظِیمٍ ، فَعَرَضَت لِی طَرِیقٌ عَنْ یَسَارِی ، فَأَرَدْت أَنْ أَسْلُکَہَا ، فَقِیلَ : إنَّک لَسْت مِنْ أَہْلِہَا ، ثُمَّ عَرَضَتْ لِی طَرِیقٌ عَنْ یَمِینِی ، فَسَلِکْتہَا حَتَّی إذَا انْتَہَیْت إلَی جَبَلٍ زَلْق ، فَأَخَذَ بِیَدِی فَأَدْخَلَنِی فَإِذَا أَنَا عَلَی ذُرْوَتِہِ فَلَمْ أَتَقَارَّ وَلَمْ أَتَمَاسَک ، وَإِذَا عَمُودٌ مِنْ حَدِیدٍ فِی ذُرْوَتِہِ حَلْقَۃٌ مِنْ ذَہَبٍ ، فَأَخَذَ بِیَدِی فَدَحَانِی حَتَّی أَخَذْت بِالْعُرْوَۃِn فَقَالَ : اسْتَمْسِکَ ، فَقُلْتُ : نَعَمْ ، فَضَرَبَ الْعَمُودَ بِرِجْلِہِ وَاسْتَمْسَکْت بِالْعُرْوَۃِ۔n فَقَصَصْتہَا عَلَی رَسُولِ اللہِ ، فَقَالَ : رَأَیْت خَیْرًا ، أَمَّا الْمَنْہَجُ الْعَظِیمُ : فَالْمَحْشَرُ ، وَأَمَّا الطَّرِیقُ الَّتِی عَرَضَتْ عَنْ یَسَارِکَ : فَطَرِیقُ أَہْلِ النَّارِ ، وَلَسْت مِنْ أَہْلِہَا ، وَأَمَّا الطَّرِیقُ الَّتِی عَرَضَتْ عَنْ یَمِینِکَ : فَطَرِیقُ أَہْلِ الْجَنَّۃِ ، وَأَمَّا الْجَبَلُ الزَّلِقُ : فَمَنْزِلُ الشُّہَدَائِ ، وَأَمَّا الْعُرْوَۃُ الَّتِی اسْتَمْسَکْت بِہَا : فَعُرْوَۃُ الإسْلاَمِ ، فَاسْتَمْسِکْ بِہَا حَتَّی تَمُوتَ۔n قَالَ : فَأَنَا أَرْجُو أَنْ أَکُونَ مِنْ أَہْلِ الْجَنَّۃِ ، قَالَ : فَإِذَا ہُوَ عَبْدُ اللہِ بْنُ سَلاَمٍ۔ (بخاری ۳۸۱۴۔ مسلم ۱۴۸)","Sahih","Musannaf Ibn Abi Shaybah 31127","","","كتاب الرؤيا"
"31128","(۳۱۱۲۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : رَأَیْتُ کَأَنِّی فِی دَارِ عُقْبَۃَ بْنِ رَافِعٍ وَأُتِینَا بِرُطَبٍ مِنْ رُطَبِ ابْنِ طَّاب ، فَأَوَّلْت : أَنَّ الرِّفْعَۃَ لَنَا فِی الدُّنْیَا ، وَالْعَاقِبَۃَ فِی الأُخْرَی ، وَأَنَّ دِینَنَا قَدْ طَابَ۔ (مسلم ۱۷۷۹۔ ابوداؤد ۴۹۸۶)","Sahih","Musannaf Ibn Abi Shaybah 31128","","","كتاب الرؤيا"
"31129","(۳۱۱۲۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَأَیْت کَأَنِّی فِی دِرْعٍ حَصِینَۃٍ ، وَرَأَیْت بَقَرَاً مَنْحُورَۃً ، فَأَوَّلْت : أَنَّ الدِّرْعَ الْمَدِینَۃُ ، وَالْبَقَرَۃَ نَفَرٌ۔ (دارمی ۲۱۵۹۔ بزار ۲۱۳۳)","Sahih","Musannaf Ibn Abi Shaybah 31129","","","كتاب الرؤيا"
"31130","(۳۱۱۳۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ أَنَسٍ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : رَأَیْتُ فِیمَا یَرَی النَّائِمُ کَأَنِّی مُرْدِفٌ کَبْشًا ، وَکَأَنَّ ضُبَّۃَ سَیْفِی انْکَسَرَتْ ، فَأَوَّلْت أَنِّی أَقْتُلُ صَاحِبَ الْکَتِیبَۃِ ، قَالَ عَفَّانَ : کَانَ بَعْدَ ہَذَا شَیْئٌ لَمْ أَدْرِ مَا ہُوَ۔ (بزار ۲۱۳۱۔ طبرانی ۲۹۵۱)","Da'if","Musannaf Ibn Abi Shaybah 31130","","","كتاب الرؤيا"
"31131","(۳۱۱۳۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا الأَشْعَثُ بْنُ عَبْدِ الرَّحْمَنِ الْجَرْمِیُّ ، عَنْ أَبِیہِ، عَنْ سَمُرَۃََ بْنِ جُنْدُبٍ : أَنَّ رَجُلاً قَالَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَأَیْت کَأَنَّ دَلْوًا دُلیَتْ مِنَ السَّمَائِ، فَجَائَ أَبُو بَکْرٍ فَأَخَذَ بِعَرَاقِیہَا فَشَرِبَ شُرْبًا وَفِیہِ ضَعْفٌ ، ثُمَّ جَائَ عُمَرُ فَأَخَذَ بِعَرَاقِیہَا فَشَرِبَ حَتَّی تَضَلَّعَ ، ثُمَّ جَائَ عُثْمَانُ فَأَخَذَ بِعَرَاقِیہَا فَشَرِبَ حَتَّی تَضَلَّعَ۔ (ابوداؤد ۴۶۱۳۔ طبرانی ۶۹۶۵)","Sahih","Musannaf Ibn Abi Shaybah 31131","","","كتاب الرؤيا"
"31132","(۳۱۱۳۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ مُبَارَکٍ ، عَنْ یُونُسَ ، عَنِ الزُّہْرِیِّ ، عَنْ حَمْزَۃَ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَأَیْت فِی الْمَنَامِ کَأَنَّ الرِّیَّ یَجْرِی بَیْنَ ظُفْرِی ، أَوْ أَظْفَارِی ، قَالُوا : مَا أَوَّلْتہ ؟ قَالَ : الْعِلْمُ۔ (بخاری ۳۶۸۱۔ مسلم ۱۸۵۹)","Sahih","Musannaf Ibn Abi Shaybah 31132","","","كتاب الرؤيا"
"31133","(۳۱۱۳۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی قَتَادَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الرُّؤْیَا مِنَ اللہِ ، وَالْحُلْمُ مِنَ الشَّیْطَانِ ، فَإِذَا رَأَی أَحَدُکُمْ مَا یَکْرَہُ ، فَلْیَنْفِثْ عَنْ یَسَارِہِ ثَلاَثًا ، وَلْیَتَعَوَّذْ بِاللہِ مِنْ شَرِّہَا ، فَإِنَّہَا لاَ تَضُرُّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31133","","","كتاب الرؤيا"
"31134","(۳۱۱۳۴) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللہِ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا رَأَی أَحَدُکُمَ الرُّؤْیَا یَکْرَہُہَا فَلْیَبْصُقْ ، عَنْ یَسَارِہِ ثَلاَثًا ، وَلْیَسْتَعِذْ بِاللہِ مِنَ الشَّیْطَانِ ثَلاَثًا ، وَلْیَتَحَوَّلْ عَنْ جَنْبِہِ الَّذِی کَانَ عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31134","","","كتاب الرؤيا"
"31135","(۳۱۱۳۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ یَزِیدَ الرَّقَاشِیِّ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِلرُّؤْیَا کُنًی ، وَلَہَا أَسْمَائٌ ، فَکَنُّوہَا بِکُنَاہَا وَعَبِّروہَا بِأَسْمَائِہَا ، وَالرُّؤْیَا لأَوَّلِ عَابِرٍ۔n(ابن ماجہ ۳۹۱۵۔ ابویعلی ۴۱۱۷)","Da'if","Musannaf Ibn Abi Shaybah 31135","","","كتاب الرؤيا"
"31136","(۳۱۱۳۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، قَالَ : مَرَّ صُہَیْبٌ بِأَبِی بَکْرٍ فَأَعْرَضَ عَنْہُ، فَقَالَ : مَالَک أَعْرَضْت عَنِّی ؟ أَبْلَغَک شَیْئٌ تَکْرَہُہُ ؟ قَالَ : لاَ وَاللہِ إلاَّ رُؤْیَا رَأَیْتہَا لَکَ کَرِہْتُہَا ، قَالَ : وَمَا رَأَیْت ؟ قَالَ : رَأَیْتُ یَدَک مَغْلُولَۃً إلَی عُنُقِکَ عَلَی بَابِ رَجُلٍ مِنَ الأَنْصَارِ یُقَالَ لَہُ : أَبُو الْحَشْرِ ! فَقَالَ لَہُ أَبُو بَکْرٍ : نِعْمَ مَا رَأَیْت ، جَمَعَ لِی دَیْنِی إلَی یَوْمِ الْحَشْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 31136","","","كتاب الرؤيا"
"31137","(۳۱۱۳۷) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ : أَنَّ عَائِشَۃَ قَالَتْ لأَبِیہَا : إِنِّی رَأَیْت فِی النَّوْمِ کَأَنَّ قَمَرًا وَقَعَ فِی حُجْرَتِی حَتَّی ذَکَرَتْ ثَلاَثَ مِرار ، فَقَالَ لَہَا أَبُو بَکْرٍ : إنْ صَدَقَتْ رُؤْیَاکِ ، دُفِنَ فِی بَیْتِکَ خَیْرُ أَہْلِ الأَرْضِ : ثَلاَثَۃٌ۔ (طبرانی ۱۲۷)","","Musannaf Ibn Abi Shaybah 31137","","","كتاب الرؤيا"
"31138","(۳۱۱۳۸) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ : أَنَّ رَجُلاً أَتَی أَبَا بَکْرٍ ، فَقَالَ : إنِّی رَأَیْت فِی النَّوْمِ کَأَنِّی أَبُولُ دَمًا ، قَالَ : أَرَاک تَأْتِی امْرَأَتَکَ وَہِیَ حَائِضٌ ، قَالَ : نَعَمْ ، قَالَ : فَاتَّقِ اللَّہَوَلاَ تَعُدْ۔","","Musannaf Ibn Abi Shaybah 31138","","","كتاب الرؤيا"
"31139","(۳۱۱۳۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ ، قَالَ : أَتَی رَجُلٌ أَبَا بَکْرٍ فَقَالَ : إنِّی رَأَیْت فِی الْمَنَامِ کَأَنِّی أُجْرِی ثَعْلَبًا ، قَالَ : أَنْتَ رَجُلٌ کَذُوبٌ ، فَاتَّقِ اللَّہَ وَلاَ تَعُدْ۔","Da'if","Musannaf Ibn Abi Shaybah 31139","","","كتاب الرؤيا"
"31140","(۳۱۱۴۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قالَتْ عَائِشَۃُ لأَبِی بَکْرٍ : إنِّی رَأَیْت فِی الْمَنَامِ بَقَرًا یُنْحَرْنَ حَوْلِی ، قَالَ : إنْ صَدَقَتْ رُؤْیَاک قُتِلَتْ حَوْلَک فِئَۃٌ!۔","Da'if","Musannaf Ibn Abi Shaybah 31140","","","كتاب الرؤيا"
"31141","(۳۱۱۴۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادۃ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ الْغَطَفَانِیِّ، عَنْ مَعْدَانَ بْنِ أَبِی طَلْحَۃَ الْیَعْمُرِیِّ : أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَالَ یَوْمَ جُمُعَۃِ ، أَوْ خَطَبَ یَوْمَ جُمُعَۃَ ، فَحَمِدَ اللَّہَ وَأَثْنَی عَلَیْہِ ثُمَّ قَالَ: أَیُّہَا النَّاسُ! إنِّی رَأَیْت دِیکًا أَحْمَرَ نَقَرَنِی نَقْرَتَیْنِ، وَلاَ أُرَی ذَلِکَ إلاَّ حُضُورَ أَجَلِی۔ n(مسلم ۳۹۷۔ احمد ۴۸)","Sahih","Musannaf Ibn Abi Shaybah 31141","","","كتاب الرؤيا"
"31142","(۳۱۱۴۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی جَمْرَۃَ ، عَنْ جَارِیَۃَ بْنِ قُدَامَۃَ السَّعْدِیِّ، قَالَ: حجَجْت الْعَامَ الَّذِی أُصِیبَ فِیہِ عُمَرُ ، قَالَ : فَخَطَبَ ، فَقَالَ : إنِّی رَأَیْت کَأَنَّ دِیکًا نَقَرَنِی نَقْرَتَیْنِ ، أَوْ ثَلاَثًا۔","Sahih","Musannaf Ibn Abi Shaybah 31142","","","كتاب الرؤيا"
"31143","(۳۱۱۴۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ الْخُزَاعِیِّ ، قَالَ : سَمِعْتُ عُمَرَ بْنَ الْخَطَّابِ یَقُولُ فِی خُطْبَتِہِ : إنِّی رَأَیْت الْبَارِحَۃَ دِیکًا نَقَرَنِی وَرَأَیْتہ یُجْلِیہ النَّاسُ عَنِّی ، فَلَمْ یَلْبَثْ إلاَّ ثَلاَثًا حَتَّی قَتَلَہُ عَبْدُ الْمُغِیرَۃِ : أَبُو لُؤْلُؤَۃَ۔ (بیہقی ۲۳۲)","Sahih","Musannaf Ibn Abi Shaybah 31143","","","كتاب الرؤيا"
"31144","(۳۱۱۴۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَر بْنِ حَمْزَۃَ ، قَالَ : أَخْبَرَنِی سَالِمٌ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ عُمَرُ : رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْمَنَامِ ، فَرَأَیْتہ لاَ یَنْظُرُنِی ، فَقُلْتُ : یَا رَسُولَ اللہِ مَا شَأْنِی ؟ قَالَ : أَلَسْت الَّذِی تُقَبِّلُ وَأَنْتَ صَائِمٌ ؟ قُلْتُ : وَالَّذِی بَعَثَک بِالْحَقِّ لاَ أُقَبِّلُ بَعْدَہَا وَأَنَا صَائِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 31144","","","كتاب الرؤيا"
"31145","(۳۱۱۴۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : حدَّثَنِی غَیْرُ وَاحِدٍ : أَنْ قَاضِیًا مِنْ قُضَاۃِ أَہْلِ الشَّامِ أَتَی عُمَرَ بْنَ الْخَطَّابِ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، رَأَیْت رُؤْیَا أَفْظَعَتْنِی ، قَالَ مَا ہِیَ ؟ قَالَ : رَأَیْتُ الشَّمْسَ وَالْقَمَرَ یَقْتَتِلاَنِ وَالنُّجُومَ مَعَہُمَا نِصْفَیْنِ ، قَالَ : فَمَعَ أَیِّہِمَا کُنْت ، قَالَ : مَعَ الْقَمَرِ عَلَی الشَّمْسِ ، فَقَالَ عُمَرُ : وَجَعَلْنَا اللَّیْلَ وَالنَّہَارَ آیَتَیْنِ فَمَحَوْنَا آیَۃَ اللَّیْلِ وَجَعَلْنَا آیَۃَ النَّہَارِ مُبْصِرَۃً ، قَالَ : فَانْطَلِقْ فَوَاللہِ لاَ تَعْمَلُ لِی عَمَلاً أَبَدًا۔","Da'if","Musannaf Ibn Abi Shaybah 31145","","","كتاب الرؤيا"
"31146","(۳۱۱۴۶) حَدَّثَنَا سُرَیْجُ بْنُ النُّعْمَانِ ، قَالَ : حدَّثَنِی عَبْدُ الْعَزِیزِ بْنُ أَبِی سَلَمَۃَ ، عَنْ زَیْدِ بْنِ أسْلَمَ ، عْن أَبِیہِ ، قَالَ : خَطَبَ عُمَرُ بْنُ الْخَطَّابِ النَّاسَ ، فَقَالَ : إنِّی رَأَیْت فِی مَنَامِی دِیکًا أَحْمَرَ نَقَرَنِی عَلَی مَعْقِدِ إزَارِی ثَلاَثَ نَقَرَاتٍ ، فَاسْتَعْبَرْتُہَا أَسْمَائَ بِنْتَ عُمَیْسٍ ، فَقَالَتْ : إنْ صَدَقَتْ رُؤْیَاک ، قَتَلَک رَجُلٌ مِنَ الْعَجَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 31146","","","كتاب الرؤيا"
"31147","(۳۱۱۴۷) حَدَّثَنَا الْمُعَلَّی بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنِی یَحْیَی بْنُ حَمْزَۃَ ، عَنْ یَزِیدَ بْنِ عَبِیدَۃَ ، عَنْ أَبِی عُبَیْدِ اللہِ ، عَنْ عَوْفِ بْنِ مَالِکٍ الأَشْجَعِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الرُّؤْیَا عَلَی ثَلاَثَۃٍ : مِنْہَا تَخْوِیفٌ مِنَ الشَّیْطَانِ لِیَحْزُنَ بِہِ ابْنَ آدَمَ ، وَمِنْہُ الأَمْرُ یُحَدِّثُ بِہِ نَفْسَہُ فِی الْیَقَظَۃِ فَیَرَاہُ فِی الْمَنَامِ ، وَمِنْہَا جُزْئٌ مِنْ سِتَّۃٍ وَأَرْبَعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔ (ابن ماجہ ۳۹۰۷۔ ابن حبان ۶۰۴۲)","Hasan","Musannaf Ibn Abi Shaybah 31147","","","كتاب الرؤيا"
"31148","(۳۱۱۴۸) حَدَّثَنَا ہَوْذَۃُ بْنُ خَلِیفَۃَ ، عَنْ عَوْفٍ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الرُّؤْیَا ثَلاَثٌ : فَالْبُشْرَی مِنَ اللہِ ، وَحَدِیثُ النَّفْسِ ، وَتَخْوِیفٌ مِنَ الشَّیْطَانِ ، فَإِذَا رَأَی أَحَدُکُمْ رُؤْیَا تُعْجِبُہُ ، فَلْیَقُصَّہَا إِنْ شَائَ ، وَإِذَا رَأَی شَیْئًا یَکْرَہُہُ فَلاَ یَقُصَّہُ عَلَی أَحَدٍ وَلْیَقُمْ یُصَلِّی۔ n(بخاری ۷۰۱۷۔ مسلم ۱۷۷۳)","","Musannaf Ibn Abi Shaybah 31148","","","كتاب الرؤيا"
"31149","(۳۱۱۴۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، عَنْ عَلْقَمَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : الرُّؤْیَا ثَلاَثَۃٌ : حُضُورُ الشَّیْطَانِ ، وَالرَّجُلُ یُحَدِّثُ نَفْسَہُ بِالنَّہَارِ فَیَرَاہُ بِاللَّیْ[corrupt]ِ ، وَالرُّؤْیَا الَّتِی ہِیَ الرُّؤْیَا۔","Sahih","Musannaf Ibn Abi Shaybah 31149","","","كتاب الرؤيا"
"31150","(۳۱۱۵۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وُہَیْبٌ ، قَالَ : حَدَّثَنَا دَاوُد ، عَنْ زِیَادِ بْنِ عَبْدِ اللہِ ، عَنْ أُمِّ ہِلاَلٍ بِنْتِ وَکِیعٍ، عَنِ امْرَأَۃِ عُثْمَانَ ، قَالَتْ : أَغْفَی عُثْمَان ، فَلَمَّا اسْتَیْقَظَ قَالَ : إنَّ الْقَوْمَ یَقْتُلُونَنِی ، قُلْتُ : کَلاَّ یَا أَمِیرَ الْمُؤْمِنِینَ ، قَالَ : إِنِّی رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَبَا بَکْرٍ وَعُمَرَ ، قَالَ : فَقَالُوا : أَفْطِرْ عِنْدَنَا اللَّیْلَۃَ ، أَوْ قَالَ : إنَّک تُفْطِرُ عِنْدَنَا اللَّیْلَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 31150","","","كتاب الرؤيا"
"31151","(۳۱۱۵۱) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی جَعْفَرٍ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أَنَّ عُثْمَانَ أَصْبَحَ یُحَدِّثُ النَّاسَ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اللَّیْلَۃَ فِی الْمَنَامِ ، فَقَالَ : یَا عُثْمَان أَفْطِرْ عِنْدَنَا ، فَأَصْبَحَ صَائماً وَقُتِلَ مِنْ یَوْمِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 31151","","","كتاب الرؤيا"
"31152","(۳۱۱۵۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أُحِبُّ الْقَیْدَ فِی الْمَنَامِ ، وَأَکْرَہُ الْغُل، الْقَیْدُ ثَبَاتٌ فِی الدِّینِ ، وَقَالَ أَبُو ہُرَیْرَۃَ : اللَّبَنُ فِی الْمَنَامِ الْفِطْرَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 31152","","","كتاب الرؤيا"
"31153","(۳۱۱۵۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : رَأَیْتُنِی عَلَی تَلٍّ کَأَنَّ حَوْلِی بَقَرًا تُنْحَر ، فَقَالَ مَسْرُوقٌ : إنِ اسْتَطَعْتِ أَنْ لاَ تَکُونِی أَنْتِ ہِیَ فَافْعَلِی ، قَالَ : فَابْتُلِیت بِذَلِکَ رَحِمَہَا اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31153","","","كتاب الرؤيا"
"31154","(۳۱۱۵۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ بَکْرٍ السَّہْمِیُّ ، عَنْ حَاتِمِ بْنِ أَبِی صَغِیرَۃٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَائِشَۃَ بِنْتِ طَلْحَۃَ ، عَنْ عَائِشَۃَ أُمِّ الْمُؤْمِنِینَ ، أَنَّہَا قَتَلَتْ جَانًّا ، فَأُتِیَتْ فِیمَا یَرَی النَّائِمُ ، فَقِیلَ لَہَا : أَمَا وَاللہِ لَقَدْ قَتَلْتِ مُسْلِمًا ، قَالَتْ : فَلِمَ یَدْخُلْ عَلَیَّ أَزْوَاجُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقِیلَ لَہَا : مَا یَدْخُلُ عَلَیْک إلاَّ وَعَلَیْک ثِیَابُک ، فَأَصْبَحَتْ فَزِعَۃً وَأَمَرَتْ بِاثْنَیْ عَشَرَ أَلْفًا ، فَجعلَت فِی سَبِیلِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31154","","","كتاب الرؤيا"
"31155","(۳۱۱۵۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی جَعْفَرٍ الْخَطْمِیِّ ، عَنْ عُمَارَۃَ بْنِ خُزَیْمَۃَ بْنِ ثَابِتٍ ، عَنْ أَبِیہِ : أَنَّہُ رَأَی فِی الْمَنَامِ کَأَنَّہُ یَسْجُدُ عَلَی جَبِینِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَذَکَرَ ذَلِکَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ الرُّوحَ لَیَلْقَی الرُّوحَ، أَو قَالَ : الرُّوحُ یَلْقَی الرُّوحَ ، شَکَّ یَزِیدُ ، فَأَقْنَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأْسَہُ ثُمَّ أَمَرَہُ فَسَجَدَ مِنْ خَلْفِہِ عَلَی جَبِینِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 31155","","","كتاب الرؤيا"
"31156","(۳۱۱۵۶) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا عَلِیُّ بْنُ زَیْدٍ وَأَبُو عِمْرَانَ الْجَوْنِیُّ : أَنَّ سَمُرَۃَ بْنَ جُنْدُبٍ قَالَ لأَبِی بَکْرٍ : رَأَیْت فِی الْمَنَامِ کَأَنِّی أَفْتِلُ شَرِیطًا وَأَضَعُہُ إلَی جَنْبِی وَنَقَدٌ یَأْکُلْنَہُ ، قَالَ : تَزَوَّجُ امْرَأَۃً ذَاتَ وَلَدٍ یَأْکُلُ کَسْبَک۔ قَالَ : وَرَأَیْت ثَوْرًا خَرَجَ مِنْ جُحْرٍ فَلَمْ یَسْتَطِعْ یَعُودُ فِیہِ ، قَالَ : ہَذِہِ الْعَظِیمَۃُ تَخْرُجُ مِنْ فِی الرَّجُلِ فَلاَ یَسْتَطِیعُ أَنْ یَرُدَّہَا ، قَالَ : وَرَأَیْت کَأَنَّہُ قِیلَ : الدَّجَّالُ یَخْرُجُ ، فَجَعَلْتُ أَتَقَحَّمُ الْجُدُرَ ، فَالْتَفَتّ خَلْفِی فَفُرِجَتْ لِی الأَرْضُ فَدَخَلْتہَا ، قَالَ : تُصِیبُک قُحَمٌ فِی دِینِکَ ، وَالدَّجَّالُ عَلَی إِثْرِکَ قَرِیبًا۔","Hasan","Musannaf Ibn Abi Shaybah 31156","","","كتاب الرؤيا"
"31157","(۳۱۱۵۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ بَکْرٍ ، قَالَ : حدَّثَنَا حُمَیْدٌ ، عَنْ أَنَسٍ ، قَالَ : رَأَیْتُ فِیمَا یَرَی النَّائِمُ کَأَنَّ عَبْدَ اللہِ بْنَ عُمَرَ یَأْکُلُ تَمْرًا ، فَکَتَبْتُ إلَیْہِ : إنِّی رَأَیْتُک تَأْکُلُ تَمْرًا وَہُوَ حَلاَوَۃُ الإِیمَانِ إنْ شَائَ اللَّہُ تَعَالَی۔","Sahih","Musannaf Ibn Abi Shaybah 31157","","","كتاب الرؤيا"
"31158","(۳۱۱۵۸) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَنِ الْعَلاَئِ بْنِ زِیَادٍ الْعَدَوِیِّ ،َقَالَ : رَأَیْت فِی النَّوْمِ کَأَنِّی أَرَی عَجُوزًا کَبِیرَۃً عَوْرَائَ الْعَیْنِ وَالأُخْرَی قَدْ کَادَتْ تَذْہَبُ عَلَیْہَا مِنَ الزَّبَرْجَدِ ، وَمِنَ الْحِلْیَۃُ شَیْئٌ عَجَبٌ ، قَالَ : قُلْتُ : مَا أَنْتِ ؟ قَالَتْ : الدُّنْیَا ، قُلْتُ : أَعُوذُ بِاللہِ مِنْ شَرِّکَ، قَالَتْ : إنْ سَرَّک أَنْ یُعِیذَکَ اللہ مِنْ شَرِّی فَأَبْغِضِ الدِّرْہَمَ۔","","Musannaf Ibn Abi Shaybah 31158","","","كتاب الرؤيا"
"31159","(۳۱۱۵۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا فُضَیْلُ بْنُ غَزْوَانَ ، قَالَ : حَدَّثَنَا عَبْدُ اللہِ بْنُ الْقَاسِمِ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَأَلْتُہُ عَنِ الأَشْرِبَۃِ ، فَقَالَ : بَیْنَ شَارِبٍ وَتَارِکٍ۔","","Musannaf Ibn Abi Shaybah 31159","","","كتاب الرؤيا"
"31160","(۳۱۱۶۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، قَالَ : قِیلَ لِمُحَمَّدِ بْنِ سِیرِینَ : إنَّ فُلاَنًا یَضْحَکُ ، قَالَ : وَلِمَ لاَ یَضْحَکُ ، فَقَدْ ضَحِکَ مَنْ ہُوَ خَیْرٌ مِنْہُ ، حُدِّثْت أَنَّ عَائِشَۃَ قَالَتْ : ضَحِکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ رُؤْیَا قَصَّہَا عَلَیْہِ رَجُلٌ ضَحِکًا مَا رَأَیْتہ ضَحِکَ مِنْ شَیْئٍ قَطُّ أَشَدَّ مِنْہُ ، قَالَ مُحَمَّدٌ : وَقَدْ عَلِمْت مَا الرُّؤْیَا ، وَمَا تَأْوِیلُہَا ، رَأَی کَأَنَّ رَأْسَہُ قُطِعَ ، قَالَ : فَذَہَبَ یَتْبَعُہُ ، فَالرَّأْسُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالرَّجُلُ یُرِیدُ أَنْ یَلْحَقَ بِعَمَلِہِ عَمَلَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ لاَ یُدْرِکُہُ۔","","Musannaf Ibn Abi Shaybah 31160","","","كتاب الرؤيا"
"31161","(۳۱۱۶۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنِی ثَابِتٌ ، عَنْ أَنَسِ بْنِ مَالِکٍ : أَنَّ أَبَا مُوسَی الأَشْعَرِیَّ ، أَوْ أَنَسًا قَالَ : رَأَیْتُ فِی الْمَنَامِ کَأَنِّی أَخَذْت جَوَادَّ کَثِیرَۃً فَسَلَکْتہَا حَتَّی انْتَہَیْت إلَی جَبَلٍ ، فَإِذَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَوْقَ الْجَبَلِ ، وَأَبُو بَکْرٍ إلَی جَنْبِہِ وَجَعَلَ یُومِئُ بِیَدِہِ إلَی عُمَرَ ، فَقُلْتُ: إنَّا لِلَّہِ وَإِنَّا إلَیْہِ رَاجِعُونَ ، مَاتَ وَاللہِ عُمَرُ ، فَقُلْتُ : أَلاَ تَکْتُبُ بِہِ إلَی عُمَرَ ، فَقَالَ : مَا کُنْت أَنْعَی إلَی عُمَرَ نَفْسَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31161","","","كتاب الرؤيا"
"31162","(۳۱۱۶۲) حَدَّثَنَا حُسَیْنُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ نَافِعٍ : أَنَّ ابْنَ عُمَرَ رَأَی رُؤْیَا : کَأَنَّ مَلَکًا انْطَلَقَ بِہِ إلَی النَّارِ ، فَلَقِیَہُ مَلَکٌ آخَرُ وَہُوَ یَزَعُہُ ، فَقَالَ : لَمْ تُرَعْ ، ہَذَا نِعْمَ الرَّجُلُ لَوْ کَانَ یُصَلِّی مِنَ اللَّیْلِ، قَالَ : فَکَانَ بَعْدَ ذَلِکَ یُطِیلُ الصَّلاَۃَ باللَّیْلِ ، قَالَ : وَقَدِ انْتَہَی بِی إلَی جَہَنَّمَ وَأَنَا أَقُولُ : أَعُوذُ بِاللہِ مِنَ النَّارِ ، فَإِذَا ہِیَ ضَیِّقَۃٌ کَالْبَیْتِ أَسْفَلُہُ وَاسِعٌ وَأَعْلاَہُ ضَیِّقٌ ، وَإِذَا رِجَالٌ مِنْ قُرَیْشٍ أَعْرِفُہُمْ مُنَکَّسُونَ بِأَرْجُلِہِمْ۔n(بخاری ۱۱۵۶۔ مسلم ۱۹۲۸)","Sahih","Musannaf Ibn Abi Shaybah 31162","","","كتاب الرؤيا"
"31163","(۳۱۱۶۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ إبْرَاہِیمَ التَّیْمِیَّ یَقُولُ : إنَّمَا حَمَلَنِی عَلَی مَجْلِسِی ہَذَا أَنِّی رَأَیْت کَأَنِّی أَقْسِمُ رَیْحَانًا بَیْنَ النَّاسِ ، فَذَکَرْت ذَلِکَ لإِبْرَاہِیمَ النَّخَعِیِّ ، فَقَالَ : إنَّ الرَّیْحَانَ لَہُ مَنْظَرٌ وَطَعْمُہُ مُرٌّ۔","","Musannaf Ibn Abi Shaybah 31163","","","كتاب الرؤيا"
"31164","(۳۱۱۶۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شِبْلٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : {وَعَلَّمْتَنِی مِنْ تَأْوِیلِ الأَحَادِیثِ} قَالَ: عِبَارَۃُ الرُّؤْیَا۔","","Musannaf Ibn Abi Shaybah 31164","","","كتاب الرؤيا"
"31165","(۳۱۱۶۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ : أَنَّہُ سَمِعَ قَوْمًا یَذْکُرُونَ رُؤْیَا وَہُوَ یُصَلِّی ، فَلَمَّا انْصَرَفَ سَأَلَہُمْ عنہا فَکَتَمُوہُ ، فَقَالَ : أَمَا أَنَّہُ جَائَ تَأْوِیلُ رُؤْیَا یُوسُفَ بَعْدَ أَرْبَعِینَ ۔ یَعْنِی : سَنَۃً۔","","Musannaf Ibn Abi Shaybah 31165","","","كتاب الرؤيا"
"31166","(۳۱۱۶۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : سَأَلَ رَجُلٌ مُحَمَّدًا ، قَالَ : رَأَیْتُ کَأَنِّی آکُلُ خَبِیصًا فِی الصَّلاَۃِ ؟ فَقَالَ : الْخَبِیصُ حَلاَلٌ ، وَلاَ یَحِلُّ لَک الأَکْلُ فِی الصَّلاَۃِ ، فَقَالَ لَہُ : تُقَبِّلُ امْرَأَتَکَ وَأَنْتَ صَائِمٌ ؟ قَالَ : نَعَمْ، قَالَ : فَلاَ تَفْعَلْ۔","","Musannaf Ibn Abi Shaybah 31166","","","كتاب الرؤيا"
"31167","(۳۱۱۶۷) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، عَنْ سَلْمَانَ ، قَالَ : کَانَ بَیْنَ رُؤْیَا یُوسُفَ وَتَأْوِیلِہَا أَرْبَعُونَ سَنَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 31167","","","كتاب الرؤيا"
"31168","(۳۱۱۶۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا عَبْدُ اللہِ بْنُ عَوْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا إذَا رَأَی أَحَدُہُمْ مَا یَکْرَہُ ، قَالَ : أَعُوذُ بِمَا عَاذَتْ بِہِ مَلاَئِکَۃُ اللہِ وَرَسُولُہُ مِنْ شَرِّ مَا رَأَیْت فِی مَنَامِی أَنْ یُصِیبَنِی مِنْہُ شَیْئٌ أَکْرَہُہُ فِی الدُّنْیَا وَالآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 31168","","","كتاب الرؤيا"
"31169","(۳۱۱۶۹) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حدَّثَنَا بُکَیْر بْنُ أَبِی السُّمَیْطِ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ سِیرِینَ وَسُئِلَ عَنْ رَجُلٍ رَأَی فِی الْمَنَامِ کَأَنَّ مَعَہُ سَیْفًا مُخْتَرِطَۃً ، فَقَالَ : وَلَدٌ ذَکَرٌ ، قَالَ : انْدَقَّ السَّیْفُ ، قَالَ : یَمُوتُ۔n قَالَ : وَسُئِلَ ابْنُ سِیرِینَ عَنِ الْحِجَارَۃِ فِی النَّوْمِ ، فَقَالَ : قَسْوَۃٌ۔n وَسُئِلَ عَنِ الْخَشَبِ فِی النَّوْمِ ، فَقَالَ : نِفَاقٌ۔","","Musannaf Ibn Abi Shaybah 31169","","","كتاب الرؤيا"
"31170","(۳۱۱۷۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : سُئِلَ عَنْ رَجُلٍ رَأَی ضَوْئًا فِی جَوْفِ اللَّیْلِ ، فَقَالَ : لَوْ کَانَ ہَذَا خَیْرًا نَظَرَ إِلَیْہِ أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 31170","","","كتاب الرؤيا"
"31171","(۳۱۱۷۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، قَالَ : قَالَ صِلَۃُ بْنُ أَشْیَمَ : رَأَیْت فِی النَّوْمِ کَأَنِّی فِی رَہْطٍ ، وَکَانَ رَجُلٌ خَلْفِی مَعَہُ السَّیْفُ شَاہِرُہُ ، قَالَ : کُلَّمَا أَتَی عَلَی أَحَدٍ مِنَّا ضَرَبَ رَأْسَہُ فَوَقَعَ ، ثُمَّ یَقْعُدُ فَیَعُودُ کَمَا کَانَ ، قَالَ : فَجَعَلْتُ أَنْظُرُ مَتَی یَأْتِی عَلَیَّ فَیَصْنَعُ بِی ذَاکَ ، قَالَ : فَأَتَی عَلَیَّ فَضَرَبَ رَأْسِی فَوَقَعَ فَکَأَنِّی أَنْظُرُ إلَی رَأْسِی حِینَ أَخَذْتہ أَنْفُضُ عَنْ شَفَتَیَّ التُّرَابَ ، ثُمَّ أَخَذْتہ فَأَعَدْتہ کَمَا کَانَ۔","","Musannaf Ibn Abi Shaybah 31171","","","كتاب الرؤيا"
"31172","(۳۱۱۷۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سُلَیْمَانُ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، قَالَ : قَالَ صِلَۃُ : رَأَیْت أَبَا رِفَاعَۃَ بَعْدَ مَا أُصِیبَ فِی النَّوْمِ عَلَی نَاقَۃٍ سَرِیعَۃٍ ، وَأَنَا عَلَی جَمَلٍ ثَفَالَ قَطُوفٍ ، وَأَنَا آخِذ عَلَی أَثَرِہِ ، قَالَ : فَیُعَوِّجُہَا عَلَی، فَأَقُولُ : الآنَ أُسْمِعُہُ الصَّوْتَ ، فَسَرَّحہَا ، وَأَنَا أَتْبَعُ أَثَرَہُ ، قَالَ : فَأَوَّلْت رُؤْیَایَ آخُذُ طَرِیقَ أَبِی رِفَاعَۃَ وَأَنَا أُکُدُّ الْعَمَلَ بَعْدَہُ کَدًّا۔ (حاکم ۴۳۲)","","Musannaf Ibn Abi Shaybah 31172","","","كتاب الرؤيا"
"31173","(۳۱۱۷۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ : أَنَّ أَبَا ثَامِرٍ رَأَی فِیمَا یَرَی النَّائِمُ : وَیْلٌ لِلْمُتَسَمِّنَاتِ مِنْ فَتَرَۃٍ فِی الْعِظَامِ یَوْمَ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 31173","","","كتاب الرؤيا"
"31174","(۳۱۱۷۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، قَالَ : قَالَ عَبْدُ الْمَلِکِ : دَخَلَ شَقِیقٌ عَلَی الْحَجَّاجِ فَقَالَ : مَا اسْمُک ؟ قَالَ : مَا بَعَثَ إلَیَّ الأَمِیرُ حَتَّی عَلِمَ اسْمِی ، قَالَ : أُرِیدُ أَنْ أَسْتَعِینَ بِکَ عَلَی بَعْضِ عَمَلِی ، قَالَ : فَقَالَ : أَمَا إنِّی أَخَافُ عَلَیْکَ نَفْسِی ، فَاسْتَعْفَاہُ فَأَعْفَاہُ ، قَالَ : فَلَمَّا خَرَجَ مِنْ عِنْدِہِ قَامَ وَہُوَ یَقُولُ : ہَکَذَا یَتَعَاشی ، قَالَ : فَقَالَ الْحَجَّاجُ : سَدِّدُوا الشَّیْخَ ، سَدِّدُوا الشَّیْخَ۔","","Musannaf Ibn Abi Shaybah 31174","","","كتاب الأمراء"
"31175","(۳۱۱۷۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنِ ابْنِ أَبْجَرَ ، قَالَ : بَعَثَ ابْنُ أَوْسَطَ بِالشَّعْبِیِّ إلَی الْحَجَّاجِ وَکَانَ عَامِلاً عَلَی الرَّیِّ ، قَالَ : فَأُدْخِلَ عَلَی ابْنِ أَبِی مُسْلِمٍ وَکَانَ الَّذِی بَیْنَہُ وَبَیْنَہُ لَطِیفًا ، قَالَ : فَعَذَلَہُ ابْنُ أَبِی مُسْلِمٍ ، وَقَالَ : إنِّی مُدْخِلُک عَلَی الأَمِیرِ فَإِنْ ضَحِکَ فِی وَجْہِکَ فَلاَ تَضْحَکَنَّ ، قَالَ : فَأُدْخِلَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 31175","","","كتاب الأمراء"
"31176","(۳۱۱۷۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ شَیْخٍ مِنَ النَّخَعِ ، عَنْ جَدَّتِہ ، قَالَتْ : کَانَ سَعِیدُ بْنُ جُبَیْرٍ مُسْتَخْفٍ عِنْدَ أَبِیک زَمَنَ الْحَجَّاجِ فَأَخْرَجَہُ أَبُوک فِی صُنْدُوقٍ إلَی مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 31176","","","كتاب الأمراء"
"31177","(۳۱۱۷۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : قَالَ الْوَلِیدُ بْنُ عُقْبَۃَ وَہُوَ یَخْطُبُ : یَا أَہْلَ الْکُوفَۃِ ، أَعْزِمُ عَلَی مَنْ سَمَّانِی أَشْعَرَ بَرَکاً لَمَا قَامَ ، فَتَحَرَّجَ عَدِیٌّ مِنْ عَزْمَتِہِ ، فَقَامَ ، فَقَالَ لَہُ : إِنَّہُ لَذُو نَدبَۃ الَّذِی یَقُومُ فَیَقُولُ : أَنَا الَّذِی سَمَّیْتُک ، قَالَ ابْنُ عَوْنٍ : وَکَانَ ہُوَ الَّذِی سَمَّاہُ۔","","Musannaf Ibn Abi Shaybah 31177","","","كتاب الأمراء"
"31178","(۳۱۱۷۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبْجَرَ ، قَالَ : کَانُوا یَتَکَلَّمُونَ ، قَالَ : فَخَرَجَ عَلِیٌّ مَرَّۃً وَمَعَہُ عَقِیلٌ ، قَالَ : وَمَعَ عَقِیلٍ کَبْشٌ ، قَالَ : فَقَالَ عَلِیٌّ : عضَّ أَحَدُنَا بِذِکْرِہِ ، قَالَ : فَقَالَ عَقِیلٌ : أَمَّا أَنَا وَکَبْشِی فَلاَ۔","","Musannaf Ibn Abi Shaybah 31178","","","كتاب الأمراء"
"31179","(۳۱۱۷۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ مُجَمِّعٍ ، قَالَ : دَخَلَ عَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی عَلَی الْحَجَّاجِ ، فَقَالَ لِجُلَسَائِہِ : إذَا أَرَدْتُمْ أَنْ تَنْظُرُوا إلَی رَجُلٍ یَسُبُّ أَمِیرَ الْمُؤْمِنِینَ عُثْمَانَ فَہَذَا عِنْدَکُمْ ، - یَعْنِی : عَبْدَ الرَّحْمَن - ، فَقَالَ عَبْدُ الرَّحْمَنِ : مَعَاذَ اللہِ أَیُّہَا الأَمِیرُ أَنْ أَکُونَ أَسُبُّ عُثْمَانَ ، أَنَّہُ لَیَحْجُزنِی عَنْ ذَلِکَ ثَلاث آیَاتٌ فِی کِتَابِ اللہِ ، قَالَ اللَّہُ : {لِلْفُقَرَائِ الْمُہَاجِرِینَ الَّذِینَ أُخْرِجُوا مِنْ دِیَارِہِمْ وَأَمْوَالِہِمْ یَبْتَغُونَ فَضْلاً مِنَ اللہِ وَرِضْوَانًا وَیَنْصُرُونَ اللَّہَ وَرَسُولَہُ أُولَئِکَ ہُمُ الصَّادِقُونَ} قَالَ : فَکَانَ عُثْمَان مِنْہُمْ ، قَالَ : ثُمَّ قَالَ : {وَالَّذِینَ تَبَوَّؤُوا الدَّارَ وَالإِیمَانَ مِنْ قَبْلِہِمْ} ، فَکَانَ أَبِی مِنْہُمْ : {وَالَّذِینَ جَاؤُوا مِنْ بَعْدِہِمْ یَقُولُونَ رَبَّنَا اغْفِرْ لَنَا وَلاِِخْوَانِنَا الَّذِینَ سَبَقُونَا بِالإِیمَانِ} فَکُنْت مِنْہُمْ ، قَالَ : صَدَقْت۔","","Musannaf Ibn Abi Shaybah 31179","","","كتاب الأمراء"
"31180","(۳۱۱۸۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی وَہْبٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : قَالَ لِی أَبُو جَعْفَرٍ مُحَمَّدُ بْنُ عَلِیٍّ: مِمَّنْ أَنْتَ ؟ قَالَ : قُلْتُ : مِنْ قَوْمٍ یُبْغِضُہُمُ النَّاسُ : مِنْ ثَقِیفٍ۔","","Musannaf Ibn Abi Shaybah 31180","","","كتاب الأمراء"
"31181","(۳۱۱۸۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی مُوسَی ، قَالَ : قَالَ الْمُغِیرَۃُ بْنُ شُعْبَۃَ لِعَلِیٍّ : اکْتُبْ إلَی ہَذَیْنِ الرَّجُلَیْنِ بِعَہْدِہِمَا إلَی الْکُوفَۃِ وَالْبَصْرَۃِ ، یَعْنِی الزُّبَیْرَ وَطَلْحَۃَ ، وَاکْتُبْ إلَی مُعَاوِیَۃَ بِعَہْدِہِ إلَی الشَّامِ فَإِنَّہُ سَیَرْضَی مِنْک بِذَلِکَ ، قَالَ : قَالَ عَلِیٌّ : لَمْ أَکُنْ لأُعْطِی الدَّنِیَّۃَ فِی دِینِی ، قَالَ : فَلَمَّا کَانَ بَعْدُ لَقِیَ الْمُغِیرَۃُ مُعَاوِیَۃَ ، فَقَالَ لَہُ مُعَاوِیَۃُ : أَنْتَ صَاحِبُ الْکَلِمَۃِ ؟ قَالَ : نَعَمْ ، قَالَ : أَمَ وَاللہِ مَا وَقَی شَرَّہَا إلاَّ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 31181","","","كتاب الأمراء"
"31182","(۳۱۱۸۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی مُوسَی ، قَالَ : کَتَبَ زِیَادٌ إلَی عَائِشَۃَ أُمِّ الْمُؤْمِنِینَ : مِنْ زِیَادِ بْنِ أَبِی سُفْیَانَ رَجَائَ أَنْ تَکْتُبَ إلَیْہِ : ابْنِ أَبِی سُفْیَانَ ، قَالَ فَکَتَبَت إلَیْہ : مِنْ عَائِشَۃَ أُمِّ الْمُؤْمِنِینَ إلَی زِیَادٍ ابْنِہَا۔","","Musannaf Ibn Abi Shaybah 31182","","","كتاب الأمراء"
"31183","(۳۱۱۸۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنِ الْوَلِیدِ بْنِ عَلِیٍّ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : مَا جَالَسْت فِی أَہْلِ بَیْتِہِ مِثْلَہُ : یَعْنِی : عَلِی بْن حُسَیْن۔","Hasan","Musannaf Ibn Abi Shaybah 31183","","","كتاب الأمراء"
"31184","(۳۱۱۸۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی مُوسَی ، قَالَ : قَالَ رَجُلٌ لِلْحَسَنِ : یَا أَبَا سَعِیدٍ وَاللہِ مَا أَرَاک تَلْحَنُ ، قَالَ : ابْنَ أَخِی قَدْ سَبَقْتُ اللَّحْنَ۔","","Musannaf Ibn Abi Shaybah 31184","","","كتاب الأمراء"
"31185","(۳۱۱۸۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَصْبَہَانِیِّ ، قَالَ: حدَّثَنِی عَبْدُ اللہِ بْنُ شَدَّادٍ، قَالَ : قَالَ لِی ابْنُ عَبَّاسٍ : أَلاَ أُعجِّبُک ! قَالَ : إنِّی یَوْمًا فِی الْمَنْزِلِ وَقَدْ أَخَذْت مَضْجِعِی لِلْقَائِلَۃِ إذْ قِیلَ : رَجُلٌ بِالْبَابِ ، قَالَ : قُلْتُ : مَا جَائَ ہَذَا ہَذِہِ السَّاعَۃَ إلاَّ لِحَاجَۃٍ ، أَدْخِلُوہُ ، قَالَ : فَدَخَلَ ، قَالَ : قُلْتُ : لَک حَاجَۃٌ ؟ قَالَ : مَتَی یُبْعَث ذَلِکَ الرَّجُلُ ؟ قُلْتُ : أَیُّ رَجُلٍ ؟ قَالَ : عَلِیٌّ ، قَالَ : قُلْتُ : لاَ یُبْعَثُ حَتَّی یَبْعَثَ اللَّہُ مَنْ فِی الْقُبُورِ! قَالَ : فَقَالَ : تَقُولُ مَا یَقُولُ ہَؤُلاَئِ الْحَمْقَی ! قَالَ : قُلْتُ : أَخْرِجُوا ہَذَا عَنِّی۔","Sahih","Musannaf Ibn Abi Shaybah 31185","","","كتاب الأمراء"
"31186","(۳۱۱۸۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبْجَرَ ، قَالَ : انتہی الشعبی إلی رجلین وہما یغتابانہ ویقعان فیہ ، فقال :nہَنِیئًا مَرِیئًا غَیْرَ دَائِ مُخَامِرٍ لِعَزَّۃَ مِنْ أَعْرَاضِنَا مَا اسْتَحَلَّتِ","","Musannaf Ibn Abi Shaybah 31186","","","كتاب الأمراء"
"31187","(۳۱۱۸۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبْجَرَ ، قَالَ : لَمَّا دَخَلَ سَعِیدُ بْنُ جُبَیْرٍ عَلَی الْحَجَّاجِ ، قَالَ: أَنْتَ الشَّقِیُّ بْنُ کُسَیْرٍ ، قَالَ : لاَ ، أَنَا سَعِیدُ بْنُ جُبَیْرٍ ، قَالَ : إنِّی قَاتِلُک ، قَالَ : لَئِنْ قَتَلْتَنِی ، لَقَدْ أَصَابَتْ أُمِّی اسْمِی۔","","Musannaf Ibn Abi Shaybah 31187","","","كتاب الأمراء"
"31188","(۳۱۱۸۸) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، قَالَ : قُلْتُ لِعَائِشَۃَ : إنَّ رَجُلاً مِنَ الطُّلَقَائِ یُبَایَعُ لَہُ - یَعْنِی : مُعَاوِیَۃَ - ، قَالَتْ : یَا بُنَیَّ لاَ تَعْجَبْ ، ہُوَ مُلْکُ اللہِ یُؤْتِیہ مَنْ یَشَائُ۔","","Musannaf Ibn Abi Shaybah 31188","","","كتاب الأمراء"
"31189","(۳۱۱۸۹) حَدَّثَنَا عَبِیدُ اللہِ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حَارِثَۃَ ، عَنِ الْوَلِیدِ بْنِ عُقْبَۃَ : أَنَّہُ قَالَ : لَمْ تَکُنْ نُبُوَّۃٌ إلاَّ کَانَ بَعْدَہَا مُلْکٌ۔","","Musannaf Ibn Abi Shaybah 31189","","","كتاب الأمراء"
"31190","(۳۱۱۹۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ : أَنَّ رَجُلاً مِنْ قُرَیْشٍ یُقَالَ لَہُ : ثُمَامَۃُ کَانَ عَلَی صَنْعَائَ ، فَلَمَّا جَائَہ قَتْلُ عُثْمَانَ بَکَی فَأَطَالَ الْبُکَائَ ، فَلَمَّا أَفَاقَ قَالَ : الْیَوْمُ اُنْتُزِعَتِ النُّبُوَّۃُ - أوَخِلاَفَۃُ النُّبُوَّۃِ - مِنْ أُمَّۃِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَصَارَتْ مُلْکًا وَجَبْرِیَّۃً ، مَنْ غَلَبَ عَلَی شَیْئٍ أَکَلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31190","","","كتاب الأمراء"
"31191","(۳۱۱۹۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : قَالَ لِی الْحَسَنُ : أَلاَ تَعْجَبُ مِنْ سَعِیدِ بْنِ جُبَیْرٍ! دَخَلَ عَلَیَّ فَسَأَلَنِی عَنْ قِتَالِ الْحَجَّاجِ وَمَعَہُ بَعْضُ الرُّؤَسَائِ ، یَعْنِی : أَصْحَابَ ابْنِ الأَشْعَثِ۔","","Musannaf Ibn Abi Shaybah 31191","","","كتاب الأمراء"
"31192","(۳۱۱۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ قَیْسٍ ، قَالَ : سَمِعْتُ مُعَاوِیَۃَ فِی مَرَضِہِ الَّذِی مَاتَ فِیہِ حَسَرَ عَنْ ذِرَاعَیْہِ کَأَنَّہُمَا عَسِیبَا نَخْلٍ وَہُوَ یَقُولُ : وَاللہِ لَوَدِدْت أَنِّی لاَ أَغْبرَ فِیکُمْ فَوْقَ ثَلاَثٍ ، فَقَالُوا : إلَی رَحْمَۃِ اللہِ وَمَغْفِرَتِہِ ، فَقَالَ : مَا شَائَ اللَّہُ أَنْ یَفْعَلَ وَلَوْ کَرِہَ أَمْرًا غَیْرَہُ۔n وَزَادَ فِیہِ ابْنُ بِشْرٍ : ہَلِ الدُّنْیَا إلاَّ مَا عَرَفْنَا وَجَرَّبْنَا؟!","Sahih","Musannaf Ibn Abi Shaybah 31192","","","كتاب الأمراء"
"31193","(۳۱۱۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ قَیْسٍ ، قَالَ : حَدَّثَنِی قَیْسُ بْنُ رُمَّانَۃَ ، عَنْ أَبِی بُرْدَۃَ ، قَالَ : قَالَ مُعَاوِیَۃُ : مَا قَاتَلْت عَلِیًّا إلاَّ فِی أَمْرِ عُثْمَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 31193","","","كتاب الأمراء"
"31194","(۳۱۱۹۴) حَدَّثَنَا حَفْصٌ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : دَخَلَ شَابٌّ مِنْ قُرَیْشٍ عَلَی مُعَاوِیَۃَ فَأَغْلَظَ لَہُ ، فَقَالَ لَہُ : یَا ابْنَ أَخِی ، أَنْہَاک عَنِ السُّلْطَانِ ، إنَّ السُّلْطَانَ یَغْضَبُ غَضَبَ الصَّبِیِّ وَیَأْخُذُ أَخْذَ الأَسَدِ۔","Da'if","Musannaf Ibn Abi Shaybah 31194","","","كتاب الأمراء"
"31195","(۳۱۱۹۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ زِیَادٌ : مَا غَلَبَنِی أَمِیرُ الْمُؤْمِنِینَ بِشَیْئٍ مِنَ السِّیَاسَۃِ إلاَّ بِبَابٍ وَاحِدٍ ، اسْتَعْمَلْت فُلاَنًا فَکَسرَ خَرَاجُہُ فَخَشِیَ أَنْ أُعَاقِبَہُ ، فَفَرَّ إلَی أَمِیرُ الْمُؤْمِنِینَ فَکَتَبَ إلَیْہِ : إنَّ ہَذَا أَدَبُ سُوئٍ لِمَنْ قِبَلِی ، فَکَتَبَ إلَیَّ : أَنَّہُ لَیْسَ یَنْبَغِی لِی وَلاَ لَک أَنْ نَسُوسَ النَّاسَ سِیَاسَۃً وَاحِدَۃً ، أَنْ نَلِینَ جَمِیعًا فَیَمْرَجَ النَّاسُ فِی الْمَعْصِیَۃِ ، وَلاَ أَنْ نَشْتَدَّ جَمِیعًا فَنَحْمِلَ النَّاسَ عَلَی الْمَہَالِکَ ، وَلَکِنْ تَکُونُ لِلشِّدَّۃِ وَالْفَظَاظَۃِ وَالْغِلْظَۃ ، وَأَکُونُ لِلِّینِ وَالرَّأْفَۃِ وَالرَّحْمَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 31195","","","كتاب الأمراء"
"31196","(۳۱۱۹۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : أَخْبَرَنَا مُجَالِدٌ ، قَالَ : أَخْبَرَنَا عَامِرٌ ، قَالَ : سَمِعْتُ مُعَاوِیَۃَ یَقُولُ : مَا تَفَرَّقَتْ أُمَّۃٌ قَطُّ إلاَّ ظَہَرَ أَہْلُ الْبَاطِلِ عَلَی أَہْلِ الْحَقِّ إلاَّ ہَذِہِ الأُمَّۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 31196","","","كتاب الأمراء"
"31197","(۳۱۱۹۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ سَعِیدِ بْنِ سُوَیْد ، قَالَ : صَلَّی بِنَا مُعَاوِیَۃُ الْجُمُعَۃَ بِالنُّخَیلَۃِ فِی الضُّحَی ، ثُمَّ خَطَبْنَا فَقَالَ : مَا قَاتَلْتُکُمْ لِتُصَلُّوا وَلاَ لِتَصُومُوا وَلاَ لِتَحُجُّوا وَلاَ لِتُزَکُّوا ، وَقَدْ أَعْرِفُ أَنَّکُمْ تَفْعَلُونَ ذَلِکَ، وَلَکِنْ إنَّمَا قَاتَلْتُکُمْ لأَتَأَمَّرَ عَلَیْکُمْ، فَقَدْ أَعْطَانِی اللَّہُ ذَلِکَ وَأَنْتُمْ کَارِہُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 31197","","","كتاب الأمراء"
"31198","(۳۱۱۹۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ حَبِیبٍ ، عَنْ ہُزَیْلَ بْنِ شُرَحْبِیلَ ، قَالَ : خَطَبَہُمْ مُعَاوِیَۃُ ، فَقَالَ : أَیُّہَا النَّاسُ ! إنَّکُمْ جِئْتُمْ فَبَایَعْتُمُونِی طَائِعِینَ ، وَلَوْ بَایَعْتُمْ عَبْدًا حَبَشِیًّا مُجَدَّعًا لَجِئْت حَتَّی أُبَایِعَہُ مَعَکُمْ ، قَالَ : فَلَمَّا نَزَلَ عَنِ الْمِنْبَرِ قَالَ لَہُ عَمْرُو بْنُ الْعَاصِ : تَدْرِی أَیَّ شَیْئٍ جِئْت بِہِ الْیَوْمَ ؟! زَعَمْت أَنَّ النَّاسَ بَایَعُوک طَائِعِینَ ، وَلَوْ بَایَعُوا عَبْدًا حَبَشِیًّا مُجَدَّعًا لَجِئْت حَتَّی تُبَایِعَہُ مَعَہُمْ ، قَالَ : فَقَامَ مُعَاوِیَۃُ إلَی الْمِنْبَرِ ، فَقَالَ : أَیُّہَا النَّاسُ ! وَہَلْ کَانَ أَحَدٌ أَحَقَّ بِہَذَا الأَمْرِ مِنِّی؟۔","Sahih","Musannaf Ibn Abi Shaybah 31198","","","كتاب الأمراء"
"31199","(۳۱۱۹۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ مُعَاوِیَۃُ : لاَ حِلْمَ إلاَّ التَّجَارِبُ۔","Sahih","Musannaf Ibn Abi Shaybah 31199","","","كتاب الأمراء"
"31200","(۳۱۲۰۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حُسَیْنِ بْنِ وَاقِدٍ ، قَالَ : حدَّثَنِی عَبْدُ اللہِ بْنُ بُرَیْدَۃَ : أَنَّ حُسَیْنَ بْنَ عَلِیٍّ دَخَلَ عَلَی مُعَاوِیَۃَ، فَقَالَ: لأَجِیزَنَّکَ بِجَائِزَۃٍ لَمْ أُجِزْ بِہَا أَحَدًا قَبْلَک، وَلاَ أُجِیزُ بِہَا أَحَدًا بَعْدَکَ مِنَ الْعَرَبِ، فَأَجَازَہُ بِأَرْبَعِمِئَۃِ أَلْفٍ ، فَقَبِلَہَا۔","Hasan","Musannaf Ibn Abi Shaybah 31200","","","كتاب الأمراء"
"31201","(۳۱۲۰۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ، عَنْ حُسَیْنِ بْنِ وَاقِدٍ، قَالَ: حدَّثَنَا عَبْدُ اللہِ بْنُ بُرَیْدَۃَ، قَالَ: دَخَلْت أَنَا وَأَبِی عَلَی مُعَاوِیَۃَ فَأَجْلَسَ أَبِی عَلَی السَّرِیرِ وَأُتِیَ بِالطَّعَامِ فَطَعِمنَا وَأَتَی بِشَرَابٍ فَشَرِبَ، فَقَالَ مُعَاوِیَۃُ: مَا شَیْئٌ کُنْت أَسْتَلِذُّہُ وَأَنَا شَابٌّ فَآخُذُہُ الْیَوْمَ إلاَّ اللَّبَنَ ، فَإِنِّی آخُذُہُ کَمَا کُنْت آخُذُہُ قَبْلَ الْیَوْمِ ، وَالْحَدِیثَ الْحَسَنَ۔","Hasan","Musannaf Ibn Abi Shaybah 31201","","","كتاب الأمراء"
"31202","(۳۱۲۰۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا أَبُو مُحَلِّمٍ الْہَمْدَانِیُّ ، عَنْ عَامِرٍ ، قَالَ : أَتَی رَجُلٌ مُعَاوِیَۃَ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، عِدَتَکَ الَّتِی وَعَدْتنِی ، قَالَ : وَمَا وَعَدْتُک ؟ قَالَ : أَنْ تَزِیدَنِی مِئَۃ فِی عَطَائِی ، قَالَ : مَا فَعَلْت ، قَالَ : بَلَی ، قَالَ : مَنْ یَعْلَمُ ذَلِکَ ؟ قَالَ الأَسْوَدُ ، أَو ابْنُ الأَسْوَدِ ، قَالَ : مَا یَقُولُ ہَذَا یَا ابْنَ الأَسْوَدِ؟ قَالَ : نَعَمْ قَدْ زِدْتہ ، فَأَمَرَ لَہُ بِہَا ، ثُمَّ إنَّ مُعَاوِیَۃَ ضَرَبَ بِیَدَیْہِ إحْدَاہُمَا عَلَی الأُخْرَی ، فَقَالَ : مَا بِی مِئَۃٌ زِدْتہَا رَجُلاً وَلَکِنْ بِی غَفْلتی أَنْ أَزِیدَ رَجُلاً مِنَ الْمُہَاجِرِینَ مِئَۃ ، ثُمَّ أَنْسَاہَا ، فَقَالَ لَہُ ابْنُ الأَسْوَدِ : یَا أَمِیرَ الْمُؤْمِنِینَ ! فَہُوَ آمِن عَلَیْہَا ؟ قَالَ : نَعَمْ ، قَالَ : فَوَاللہِ مَا زِدْتہ شَیْئًا وَلَکِنَّہُ لاَ یَدْعُونِی رَجُلٌ إلَی خَیْرٍ یُصِیبُہُ مِنْ ذِی سُلْطَانٍ إلاَّ شَہِدْت لَہُ بِہِ ، وَلاَ شَرٍّ أَصْرِفُہُ عَنْہُ مِنْ ذِی سُلْطَانٍ إلاَّ شَہِدْت لَہُ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31202","","","كتاب الأمراء"
"31203","(۳۱۲۰۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنِی الْوَلِیدُ بْنُ کَثِیرٍ ، عَنْ وَہْبِ بْن کَیْسَانَ ، قَالَ : سَمِعْتُ جَابِرَ بْنِ عَبْدِ اللہِ یَقُولُ : لَمَّا کَانَ عَامُ الْجَمَاعَۃِ بَعَثَ مُعَاوِیَۃُ إلَی الْمَدِینَۃِ بُسْرَ بْنَ أَرْطَاۃَ لِیُبَایِعَ أَہْلَہَا عَلَی رَایَاتِہِمْ وَقَبَائِلِہِمْ فَلَمَّا کَانَ یَوْمَ جَائَتْہُ الأَنْصَارُ ، جَائَتْہُ بَنُو سَلِمۃ ، قَالَ : أَفِیہِمْ جَابِرٌ ؟ قَالُوا : لاَ ، قَالَ : فَلْیَرْجِعُوا فَإِنِّی لَسْتُ مُبَایِعَہُمْ حَتَّی یَحْضُرَ جَابِرٌ ، قَالَ : فَأَتَانِی ، فَقَالَ : نَاشَدْتُک اللَّہَ إلاَّ مَا انْطَلَقْت مَعَنا فَبَایَعْت فَحَقَنْت دَمَک وَدِمَائَ قَوْمِکَ ، فَإِنَّک إنْ لَمْ تَفْعَلْ قُتِلَتْ مُقَاتِلَتُنَا وَسُبِیَتْ ذَرَارِیّنَا ، قَالَ : فَأَسْتَنْظَرْتہُمْ إلَی اللَّیْلِ ، فَلَمَّا أَمْسَیْت دَخَلْتُ عَلَی أُمِّ سَلَمَۃَ زَوْجِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرْتہَا الْخَبَرَ فَقَالَتْ : یَا ابْنَ أَخِی ، انْطَلِقْ فَبَایِعْ وَاحْقِنْ دَمَک وَدِمَائَ قَوْمِکَ ، فَإِنِّی قَدْ أَمَرْت ابْنَ أَخِی یَذْہَبُ فَیُبَایِعُ۔","Sahih","Musannaf Ibn Abi Shaybah 31203","","","كتاب الأمراء"
"31204","(۳۱۲۰۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ وَہْبِ بْنِ کَیْسَانَ ، قَالَ : کَتَبَ رَجُلٌ مِنْ أَہْلِ الْعِرَاقِ إلَی ابْنِ الزُّبَیْرِ حِینَ بُویِعَ : سَلاَمٌ عَلَیْک فَإِنِّی أَحْمَدُ إلَیْک اللَّہَ الَّذِی لاَ إلَہَ إلاَّ ہُوَ ، أَمَّا بَعْدُ : فَإِنَّ لأَہْلِ طَاعَۃِ اللہِ وَلأَہْلِ الْخَیْرِ عَلاَمَۃٌ یُعْرَفُونَ بِہَا وَتُعْرَفُ فِیہِمْ : مِنَ الأَمْرِ بِالْمَعْرُوفِ وَالنَّہْیِ عَنِ الْمُنْکَرِ وَالْعَمَلِ بِطَاعَۃِ اللہِ ، وَاعْلَمْ أَنَّمَا مَثَلُ الإِمَامِ مَثَلُ السُّوقِ : یَأْتِیہ مَا کَانَ فِیہِ ، فَإِنْ کَانَ بَرًّا جَائَ ہُ أَہْلُ الْبِرِّ بِبِرِّہِمْ ، وَإِنْ کَانَ فَاجِرًا جَائَ ہُ أَہْلُ الْفُجُورِ بِفُجُورِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 31204","","","كتاب الأمراء"
"31205","(۳۱۲۰۵) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ وَہْبٍ ، قَالَ : کُنْتُ عِنْدَ عَبْدِ اللہِ بْنِ الزُّبَیْرِ فَقِیلَ لَہُ : إنَّ الْمُخْتَارَ یَزْعُمُ أَنَّہُ یُوحَی إلَیْہِ ، فَقَالَ : صَدَقَ ، ثُمَّ تَلاَ {ہَلْ أُنَبِّئُکُمْ عَلَی مَنْ تَنَزَّلُ الشَّیَاطِینُ تَنَزَّلُ عَلَی کُلِّ أَفَّاکٍ أَثِیمٍ}۔","","Musannaf Ibn Abi Shaybah 31205","","","كتاب الأمراء"
"31206","(۳۱۲۰۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زَائِدَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شِمْرٍ ، عَنْ أَنَسٍ ، قَالَ : إِنَّہَا سَتَکُونُ مُلُوکٌ ، ثُمَّ الْجَبَابِرَۃُ ، ثُمَّ الطَّوَاغِیتُ۔","","Musannaf Ibn Abi Shaybah 31206","","","كتاب الأمراء"
"31207","(۳۱۲۰۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ لَیْثٍ ، عَنْ أَبِی نَضرَۃَ ، قَالَ : کُنَّا نُحَدَّثُ أَنَّ بَنِی فُلاَنٍ یُصِیبُہُمْ قَتْلٌ شَدِیدٌ ، فَإِذَا کَانَ ذَلِکَ ہَرَبَ مِنْہُمْ أَرْبَعَۃُ رَہْطٍ إلَی الرُّومِ ، فَجَلَبُوا الرُّومَ عَلَی الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 31207","","","كتاب الأمراء"
"31208","(۳۱۲۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَرَ بْنِ حَمْزَۃَ ، قَالَ : خَبَّرَنِی سَالِمٌ ، قَالَ : لَمَّا أَرَادُوا أَنْ یُبَایِعُوا لِیَزِیدَ بْنَ مُعَاوِیَۃَ ، قَامَ مَرْوَانُ فَقَالَ : سُنَّۃُ أَبِی بَکْرٍ الرَّاشِدَۃُ الْمَہْدِیَّۃُ فَقَامَ عَبْدُ الرَّحْمَنِ بْنُ أَبِی بَکْرٍ ، فَقَالَ : لَیْسَ بِسُنَّۃِ أَبِی بَکْرٍ وَقَدْ تَرَکَ أَبُو بَکْرٍ الأَہْلَ وَالْعَشِیرَۃَ وَالأَصْلَ ، وَعَمَدَ إلَی رَجُلٍ مِنْ بَنِی عَدِیِّ بْنِ کَعْبٍ أَنْ رَأَی أَنَّہُ لِذَلِکَ أَہْلٌ ، فَبَایَعَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31208","","","كتاب الأمراء"
"31209","(۳۱۲۰۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْمُجَالِدِ ، عَنْ عَامِرٍ ، قَالَ : قَالَ مُحَمَّدُ بْنُ الأَشْعَثِ : إنَّ لِکُلِّ شَیْئٍ دَوْلَۃً ، حَتَّی إِنَّ لِلْحُمْقِ عَلَی الْحِلْمِ دَوْلَۃً۔","","Musannaf Ibn Abi Shaybah 31209","","","كتاب الأمراء"
"31210","(۳۱۲۱۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَرَ بْنِ حَمْزَۃَ ، قَالَ : أَخْبَرَنِی سَالِمٌ ، عَنْ أَبِیہِ : أَنَّ عُمَرَ لَمَّا نَزَعَ شُرَحْبِیلَ بْنَ حَسَنَۃَ ، قَالَ : یَا عُمَرُ عَنْ سَخْطَۃٍ نَزَعَتْنِی ؟ قَالَ : لاَ ، وَلَکِنَّا رَأَیْنَا مَنْ ہُوَ أَقْوَی مِنْک فَتَحَرَّجْنَا مِنَ اللہِ أَنْ نَتْرُککَ وَقَدْ رَأَیْنَا مَنْ ہُوَ أَقْوَی مِنْک ، فَقَالَ لَہُ شُرَحْبِیلُ : فَأَعْذِرْنِی فَقَامَ عُمَرُ عَلَی الْمِنْبَرِ ، فَقَالَ : کُنَّا اسْتَعْمَلْنَا شُرَحْبِیلَ بْنَ حَسَنَۃَ ، ثُمَّ نَزَعْنَاہُ مِنْ غَیْرِ سَخْطَۃٍ وَجَدْتہَا عَلَیْہِ ، وَلَکِنْ رَأَیْنَا مَنْ ہُوَ أَقْوَی مِنْہُ ، فَتَحَرَّجْنَا مِنَ اللہِ أَنْ نُقِرَّہُ وَقَدْ رَأَیْنَا مَنْ ہُوَ أَقْوَی مِنْہُ ، فَنَظَرَ عُمَرُ مِنَ الْعَشِیِّ إلَی النَّاسِ وَہُمْ یَلُوذُونَ بِالْعَامِلِ الَّذِی اُسْتُعْمِلَ ، وَشُرَحْبِیلُ مُحْتَبٍ وَحْدَہُ ، فَقَالَ عُمَرُ : أَمَّا الدُّنْیَا فَإِنَّہَا لَکَاعٌ۔","Da'if","Musannaf Ibn Abi Shaybah 31210","","","كتاب الأمراء"
"31211","(۳۱۲۱۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَرَ بْنِ حَمْزَۃَ ، عَنْ مُحَمَّدٍ الْکَاتِبِ : أَنَّ عُمَرَ کَانَ یَقُولُ : لاَ یُصْلِحُ ہَذَا الأَمْرَ إلاَّ شِدَّۃٌ فِی غَیْرِ تَجَبُّرٍ ، وَلِینٌ فِی غَیْرِ وَہَنٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31211","","","كتاب الأمراء"
"31212","(۳۱۲۱۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عُمَرَ بْنِ عَلِیٍّ ، قَالَ : حدَّثَنِی أَبِی ، قَالَ : قَالَ عَلِیٌّ : وَالَّذِی فَلَقَ الْحَبَّۃَ وَبَرَأَ النَّسْمَۃَ ، لإزَالَۃُ الْجِبَالِ مِنْ مَکَانِہَا أَہْوَنُ مِنْ إزَالَۃِ مَلِکٍ مُؤَجَّلٍ۔","","Musannaf Ibn Abi Shaybah 31212","","","كتاب الأمراء"
"31213","(۳۱۲۱۳) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِالْحَمِیدِ، عَنْ مُغِیرَۃَ، عَنْ سِمَاکِ بْنِ سَلَمَۃَ، عَنْ عَبْدِالرَّحْمَنِ بْنِ عصمۃ، قَالَ: کُنْتُ عِنْدَ عَائِشَۃَ فَأَتَاہَا رَسُولٌ مِنْ مُعَاوِیَۃَ بِہَدِیَّۃٍ ، فَقَالَ : أَرْسَلَ بِہَذَا أَمِیرُ الْمُؤْمِنِینَ ، فَقَبِلَتْ ہَدِیَّتَہُ ، فَلَمَّا خَرَجَ الرَّسُولُ قُلْنَا : یَا أُمَّ الْمُؤْمِنِینَ أَلَسْنَا مُؤْمِنِینَ وَہُوَ أَمِیرُنَا ؟ قَالَتْ : أَنْتُمْ إنْ شَائَ اللَّہُ الْمُؤْمِنُونَ ، وَہُوَ أَمِیرُکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 31213","","","كتاب الأمراء"
"31214","(۳۱۲۱۴) حَدَّثَنَا جَرِیرُ ، عَنِ الْمُغِیرَۃِ ، عَنْ عُثْمَانَ بْنِ یَسَارٍ ، عَنْ تَمِیمِ بْنِ حَذْلَمٍ ، قَالَ : إنَّ أَوَّلَ یَوْمٍ سُلِّمَ عَلَیَّ أَمِیرٌ بِالْکُوفَۃِ بِالإِمْرَۃِ ، قَالَ : خَرَجَ الْمُغِیرَۃ بْن شُعْبَۃ مِنَ الْقَصْرِ ، فَعَرَضَ لَہُ رَجُلٌ مِنْ کِنْدَۃَ ، فَسَلَّمَ عَلَیْہِ بِالإِمْرَۃِ ، فَقَالَ : مَا ہَذَا ؟ مَا أَنَا إلاَّ رَجُلٌ مِنْہُمْ ، فَتُرِکَتْ زَمَانًا ، ثُمَّ أَقَرَّہَا بَعْدُ۔","Hasan","Musannaf Ibn Abi Shaybah 31214","","","كتاب الأمراء"
"31215","(۳۱۲۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، قَالَ : سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللہِ یَقُولُ : دَخَلْتُ عَلَی الْحَجَّاجِ فَلَمْ أُسَلِّمْ عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31215","","","كتاب الأمراء"
"31216","(۳۱۲۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، قَالَ : بَلَغَ ابْنَ عُمَرَ أَنَّ یَزِیدَ بْنَ مُعَاوِیَۃَ بُویِعَ لَہُ ، قَالَ : إنْ کَانَ خَیْرًا رَضِینَا ، وَإِنْ کَانَ شَرًّا صَبَرْنَا۔","Sahih","Musannaf Ibn Abi Shaybah 31216","","","كتاب الأمراء"
"31217","(۳۱۲۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنْ قَیْسٍ ، قَالَ : شَہِدْت عَبْدَ اللہِ بْنَ مَسْعُودٍ جَائَ یَتَقَاضَی سَعْدًا دَرَاہِمَ أَسْلَفَہَا إیَّاہُ مِنْ بَیْتِ الْمَالِ ، فَقَالَ : رُدَّ ہَذَا الْمَالَ ، فَقَالَ سَعْدُ : أَظُنُّک لاَقِیًا شَرًّا ، قَالَ : رُدَّ ہَذَا الْمَالَ ، قَالَ : فَقَالَ سَعْدُ : ہَلْ أَنْتَ ابْنُ مَسْعُودٍ إلاَّ عَبْدٌ مِنْ ہُذَیْلٍ ؟ قَالَ : فَقَالَ عَبْدُ اللہِ : ہَلْ أَنْتَ إلاَّ ابْنُ حُمَیْنَۃَ ، قَالَ : فَقَالَ ابْنُ أَخِی سَعْدٌ : أَجَل ، أَنَّکُمَا لَصَاحِبَا رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْظُرُ النَّاسُ إلَیْکُمَا ! فَرَفَعَ سَعْدُ یَدَیْہِ یَقُولُ : اللَّہُمَّ رَبَّ السَّمَاوَاتِ وَالأَرْضِ ، فَقَالَ ابْنُ مَسْعُودٍ : وَیْحَک ، قُلْ قَوْلاً وَلاَ تَلْعَنْ ، قَالَ : فَقَالَ سَعْدٌ : أَمَ وَاللہِ أَنْ لَوْلاَ مَخَافَۃُ اللہِ لَدَعَوْت عَلَیْک دَعْوَۃً لاَ تُخْطِئُک ، قَالَ : فَانْصَرَفَ عَبْدُ اللہِ کَمَا ہُوَ۔","Sahih","Musannaf Ibn Abi Shaybah 31217","","","كتاب الأمراء"
"31218","(۳۱۲۱۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنْ زِیَادٍ ، قَالَ : لَمَّا أَرَادَ عُثْمَان أَنْ یَجْلِدَ الْوَلِیدَ ، قَالَ لِطَلْحَۃَ : قُمْ فَاجْلِدْہُ ، قَالَ : إنِّی لَمْ أَکُنْ مِنَ الْجَلاَدِینَ ، فَقَامَ إلَیْہِ عَلِیٌّ فَجَلَدَہُ ، فَجَعَلَ الْوَلِیدُ یَقُولُ لِعَلِیٍّ : أَنَا صَاحِبُ مَکِینَۃٍ ، قَالَ : قُلْتُ لِزِیَادٍ : وَمَا صَاحِبُ مَکِینَۃٍ ؟ قَالَ : امْرَأَۃٌ کَانَ یَتَحَدَّثُ إِلَیْہَا۔","","Musannaf Ibn Abi Shaybah 31218","","","كتاب الأمراء"
"31219","(۳۱۲۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، قَالَ : کَانَ مَرْوَانُ مَعَ طَلْحَۃَ یَوْمَ الْجَمَلِ ، فَلَمَّا اشْتَبَکَت الْحَرْبُ ، قَالَ مَرْوَانُ : لاَ أَطْلُبُ بِثَأْرِی بَعْدَ الْیَوْمِ ، قَالَ : ثُمَّ رَمَاہُ بِسَہْمٍ فَأَصَابَ رُکْبَتَہُ ، فَمَا رَقَأَ الدَّمُ حَتَّی مَاتَ ، قَالَ : وَقَالَ طَلْحَۃُ : دَعُوہُ فَإِنَّہُ سَہْمٌ أَرْسَلَہُ اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31219","","","كتاب الأمراء"
"31220","(۳۱۲۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عُیَیْنَۃَ ، عَنْ أَبِیہِ ، قَالَ : لَقِیَ أَبُو بَکْرَۃَ الْمُغِیرَۃَ بْنَ شُعْبَۃَ یَوْمًا نِصْفَ النَّہَارِ وَہُوَ مُتَقَنِّعٌ ، فَقَالَ : أَیْنَ تُرِیدُ ؟ فَقَالَ : أُرِیدُ حَاجَۃً ، قَالَ : إنَّ الأَمِیرَ یُزَارُ ، وَلاَ یَزُورُ۔","Sahih","Musannaf Ibn Abi Shaybah 31220","","","كتاب الأمراء"
"31221","(۳۱۲۲۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : بَلَغَنِی أَنَّ الْمُغِیرَۃَ بْنَ شُعْبَۃَ وَلِیَ الْمَوْسِمَ ، فَبَلَغَہُ أَنْ أَمِیرًا یَقدَمُ عَلَیْہِ ، فَقَدِمَ یَوْمَ عَرَفَۃَ ، فَجَعَلَہُ یَوْمَ الأَضْحَی۔","","Musannaf Ibn Abi Shaybah 31221","","","كتاب الأمراء"
"31222","(۳۱۲۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، قَالَ : کَانَ قَیْسُ بْنُ سَعْد بْنُ عُبَادَۃَ مَعَ عَلِیٍّ عَلَی مُقَدِّمَتَہُ ، وَمَعَہُ خَمْسَۃُ آلاَفٍ قَدْ حَلَقُوا رُؤُوسَہُمْ بَعْدَ مَا مَاتَ عَلِیٌّ ، فَلَمَّا دَخَلَ الْحَسَنُ فِی بَیْعَۃِ مُعَاوِیَۃَ أَبَی قَیْسٌ أَنْ یَدْخُلَ ، فَقَالَ لأَصْحَابِہِ : مَا شِئْتُمْ ، إنْ شِئْتُمْ جَالَدْت بِکُمْ أَبَدًا حَتَّی یَمُوتَ الأَعْجَلُ ، وَإِنْ شِئْتُمْ أَخَذْت لَکُمْ أَمَانًا ، فَقَالُوا لَہُ : خُذْ لَنَا أَمَانًا ، فَأَخَذَ لَہُمْ أَنَّ لَہُمْ کَذَا وَکَذَا ، وَلاَ یُعَاقَبُوا بِشَیْئٍ وَإِنِّی رَجُلٌ مِنْہُمْ ، وَلَمْ یَأْخُذْ لِنَفْسِہِ خَاصّۃ شَیْئًا ، فَلَمَّا ارْتَحَل نَحْوَ الْمَدِینَۃِ وَمَضَی بِأَصْحَابِہِ جَعَلَ یَنْحَرُ لَہُمْ کُلَّ یَوْمٍ جَزُورًا حَتَّی بَلَغَ۔","Sahih","Musannaf Ibn Abi Shaybah 31222","","","كتاب الأمراء"
"31223","(۳۱۲۲۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی جَعْفَرٍ : أَنَّ عَلِیًّا بَلَغَہُ عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ شَیْئٌ ، فَقَالَ : لأَنْ أَخَذْتہ لأَتْبَعْتہُ أَحْجَارُہُ۔","","Musannaf Ibn Abi Shaybah 31223","","","كتاب الأمراء"
"31224","(۳۱۲۲۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی جَعْفَرٍ : أَنَّ فُلاَنًا شَہِدَ عِنْدَ عُمَرَ فَرَدَّ شَہَادَتَہُ۔","","Musannaf Ibn Abi Shaybah 31224","","","كتاب الأمراء"
"31225","(۳۱۲۲۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ : سَمِعْتُ أَبِی یُحَدِّثُ : أَنَّہُ سَمِعَ عَمْرَو بْنَ الْعَاصِ قَالَ : لَمَّا مَاتَ عَبْدُ الرَّحْمَنِ بْنُ عَوْف ، قَالَ : اذْہَبِ ابْنَ عَوْفٍ بِبَطْنَتک ، لَمْ تَتَغَضْغَضْ مِنْہَا بِشَیْئٍ۔n(ابن سعد ۱۳۶۔ طبرانی ۲۶۳)","Sahih","Musannaf Ibn Abi Shaybah 31225","","","كتاب الأمراء"
"31226","(۳۱۲۲۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : سَمِعَ ابْنُ سِیرِینَ رَجُلاً یَسُبُّ الْحَجَّاجَ ، فَقَالَ ابْنُ سِیرِینَ : إنَّ اللَّہَ حَکَمٌ عَدْلٌ ، یَأْخُذُ لِلْحَجَّاجِ مِمَّنْ ظَلَمَہُ ، کَمَا یَأْخُذُ لِمَنْ ظَلَمَہُ الْحَجَّاجُ۔","","Musannaf Ibn Abi Shaybah 31226","","","كتاب الأمراء"
"31227","(۳۱۲۲۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا سُفْیَانَ ، قَالَ : حَدَّثَنِی أَبُو الْجَحَّاف ، قَالَ : أَخْبَرَنِی مُعَاوِیَۃُ بْنُ ثَعْلَبَۃٍ ، قَالَ : أَتَیْتُ مُحَمَّدَ بْنَ الْحَنَفِیَّۃِ ، فَقُلْتُ : إنَّ رَسُولَ الْمُخْتَارِ أَتَانَا یَدْعُونَا ، قَالَ : فَقَالَ لِی : لاَ تُقَاتِلْ ، إنِّی لاَکْرَہُ أَنْ أَبْتَزَّ ہَذِہِ الأُمَّۃَ أَمْرَہَا ، أَوْ آتِیہَا مِنْ غَیْرِ وَجْہِہَا۔","","Musannaf Ibn Abi Shaybah 31227","","","كتاب الأمراء"
"31228","(۳۱۲۲۸) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنِ الْحَارِثِ الأَزْدِیِّ ، قَالَ : قَالَ ابْنُ الْحَنَفِیَّۃِ : رَحِمَ اللَّہُ امْرَئًا أَغْنَی نَفْسَہُ وَکَفَّ یَدَہُ ، وَأَمْسَکَ لِسَانَہُ ، وَجَلَسَ فِی بَیْتِہِ ، لَہُ مَا احْتَسَبَ ، وَہُوَ مَعَ مَنْ أَحَبَّ۔","","Musannaf Ibn Abi Shaybah 31228","","","كتاب الأمراء"
"31229","(۳۱۲۲۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ رِضَی بْنِ أَبِی عَقِیلٍ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا عَلَی بَابِ ابْنِ الْحَنَفِیَّۃِ بِالشِّعبِ فَخَرَجَ ابْنٌ لَہُ - لَہُ ذُؤَابَتَانِ - فَقَالَ یَا مَعْشَرَ الشِّیعَۃِ ، إنَّ أَبِی یُقْرِئُکُمُ السَّلاَمَ ، قَالَ : فَکَأَنَّمَا کَانَتْ عَلَی رُؤُوسِہِمُ الطَّیْرُ ، قَالَ : إنَّ أَبِی یَقُولُ : إنَّا لاَ نُحِبُّ اللَّعَّانِینَ ، وَلاَ الْمُفرِطِینَ ، وَلاَ الْمُسْتَعْجِلِینَ بِالْقَدَرِ۔","","Musannaf Ibn Abi Shaybah 31229","","","كتاب الأمراء"
"31230","(۳۱۲۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِیہِ ، عَنْ مُنْذِرٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : لَوْ أَنَّ عَلِیًّا أَدْرَکَ أَمْرَنَا ہَذَا ، کَانَ ہَذَا مَوْضِعَ رَحْلِہِ ، یَعْنِی : الشِّعْبَ۔","","Musannaf Ibn Abi Shaybah 31230","","","كتاب الأمراء"
"31231","(۳۱۲۳۱) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الأَسَدِیُّ ، عَنْ شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ ابْنِ الزُّبَیْرِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَقُومُ السَّاعَۃُ حَتَّی یَخْرُجَ ثَلاَثُونَ کَذَّابًا مِنْہُمَ الْعَنْسِیُّ وَمُسَیْلِمَۃُ وَالْمُخْتَارُ۔n(ابویعلی ۶۷۸۶۔ بزار ۳۳۷۶)","Da'if","Musannaf Ibn Abi Shaybah 31231","","","كتاب الأمراء"
"31232","(۳۱۲۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سُفْیَانُ بْنُ سَعِیدٍ ، عَنْ أَبِی الْجَحَّافِ ، عَنْ مُوسَی بْنِ عُمَیْرٍ ، عَنْ أَبِیہِ ، قَالَ : أَمَرَ الْحُسَیْنُ مُنَادِیًا فَنَادَی فَقَالَ : لاَ یقبلَنَّ رَجُلٌ مَعِی عَلَیْہِ دَیْنٌ ، فَقَالَ رَجُلٌ : ضَمِنَتِ امْرَأَتِی دَیْنِی ، فَقَالَ : امْرَأَۃ ! مَا ضَمَانُ امْرَأَۃٍ ؟ قَالَ : وَنَادَی فِی الْمَوَالِی : فَإِنَّہُ بَلَغَنِی أَنَّہُ لاَ یُقْتَلُ رَجُلٌ لَمْ یَتْرُکْ وَفَائً إلاَّ دَخَلَ النَّارَ۔","Da'if","Musannaf Ibn Abi Shaybah 31232","","","كتاب الأمراء"
"31233","(۳۱۲۳۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، قَالَ : قَالَ لِی إبْرَاہِیمُ : إیَّاکَ أَنْ تُقْتَلَ مَعَ فِتْنۃٍ۔","","Musannaf Ibn Abi Shaybah 31233","","","كتاب الأمراء"
"31234","(۳۱۲۳۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : سَمِعْتُ مِسْعَرًا یَذْکُرُ ، عَنْ إبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ : أَنَّ مَسْرُوقًا کَانَ یَرْکَبُ کُلَّ جُمُعَۃٍ بَغْلَۃً لَہُ وَیَجْعَلُنِی خَلْفَہُ ، فَیَأْتِی کُنَاسَۃً بِالْحِیرَۃِ قَدِیمَۃً فَیَحْمِلُ عَلَیْہَا بَغْلَتَہُ ، ثُمَّ یَقُولُ : الدُّنْیَا تَحْتَنَا۔","","Musannaf Ibn Abi Shaybah 31234","","","كتاب الأمراء"
"31235","(۳۱۲۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : سَمِعْتُ حُمَیْدَ بْنَ عَبْدِ اللہ الأَصَمِّ ، یَذْکُرُ عَنْ أُمِّ رَاشِدٍ جَدَّتِہِ ، قَالَتْ : کُنْت عِنْدَ أُمِّ ہَانِئٍ فَأَتَاہَا عَلِیٌّ فَدَعَتْ لَہُ بِطَعَامٍ ، قَالَتْ : وَنَزَلْت فَلَقِیتُ رَجُلَیْنِ فِی الرَّحْبَۃِ ، فَسَمِعْتُ أَحَدَہُمَا یَقُولُ لِصَاحِبِہِ : بَایَعَتْہُ أَیْدِینَا وَلَمْ تُبَایِعْہُ قُلُوبُنَا ، قَالَ : فَقُلْتُ : مَنْ ہَذَانِ الرَّجُلاَنِ ؟ قَالُوا : طَلْحَۃُ وَالزُّبَیْرُ ، قُلْتُ : فَإِنِّی سَمِعْت أَحَدُہُمَا یَقُولُ لِصَاحِبِہِ : بَایَعَتْہُ أَیْدِینَا وَلَمْ تُبَایِعْہُ قُلُوبُنَا ، فَقَالَ عَلِیٌّ : (فَمَنْ نَکَثَ فَإِنَّمَا یَنْکُثُ عَلَی نَفْسِہِ ، وَمَنْ أَوْفَی بِمَا عَاہَدَ عَلَیْہُ اللَّہَ فَسَیُؤْتِیہِ أَجْرًا عَظِیمًا)۔","Da'if","Musannaf Ibn Abi Shaybah 31235","","","كتاب الأمراء"
"31236","(۳۱۲۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیِّ بْنِ حُسَیْنٍ ، قَالَ : حدَّثَنِی ابْنُ عَبَّاسٍ ، قَالَ : أَرْسَلِنِی عَلِیٌّ إلَی طَلْحَۃَ وَالزُّبَیْرِ یَوْمَ الْجَمَلِ ، قَالَ : فَقُلْتُ لَہُمَا : إنَّ أَخَاکُمَا یُقْرِئُکُمَا السَّلاَمَ وَیَقُولُ لَکُمَا : ہَلْ وَجَدْتُمَا عَلَیَّ فِی حَیْفٍ فِی حُکْمٍ ، أَوْ فِی اسْتِئْثَارٍ فِی فَیْئٍ ، أَوْ فِی کَذَا ، أَوْ فِی کَذَا ؟ قَالَ : فَقَالَ الزُّبَیْرُ : لاَ ولاَ فِی وَاحِدَۃٍ مِنْہُمَا ، وَلَکِنْ مَعَ الْخَوْفِ شِدَّۃُ الْمَطَامِعِ۔","Sahih","Musannaf Ibn Abi Shaybah 31236","","","كتاب الأمراء"
"31237","(۳۱۲۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ ، عَنْ أَبِی صَادِقٍ ، عَنْ حَنَشٍ الْکِنَانِیِّ ، عَنْ عُلَیمٍ الْکِنْدِیِّ ، عَنْ سَلْمَانَ ، قَالَ : لَیُحْرَقَنَّ ہَذَا الْبَیْتُ عَلَی یَدِ رَجُلٍ مِنْ آلِ الزُّبَیْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 31237","","","كتاب الأمراء"
"31238","(۳۱۲۳۸) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ أَبِی حَصِینٍ ، قَالَ : مَا رَأَیْت رَجُلاً ہُوَ أَسَبَّ مِنْہُ۔ یَعْنِی : ابْنَ الزُّبَیْرِ۔","","Musannaf Ibn Abi Shaybah 31238","","","كتاب الأمراء"
"31239","(۳۱۲۳۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الأَجْلَحِ ، قَالَ : قُلْتُ لِعَامِرٍ : إنَّ النَّاسَ یَزْعُمُونَ أَنَّ الْحَجَّاجَ مُؤْمِنٌ ؟ فَقَالَ : وَأَنَا أَشْہَدُ أَنَّہُ مُؤْمِنٌ بِالطَّاغُوتِ کَافِرٌ بِاللہِ۔","","Musannaf Ibn Abi Shaybah 31239","","","كتاب الأمراء"
"31240","(۳۱۲۴۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، قَالَ : مَا رَأَیْت أَبَا وَائِلٍ سَبَّ دَابَّۃً قَطُّ إلاَّ الْحَجَّاجَ مَرَّۃً وَاحِدَۃً، فَإِنَّہُ ذَکَرَ بَعْضَ صَنِیعَہُ ، فَقَالَ : اللَّہُمَّ أَطْعِمَ الْحَجَّاجَ طَعَامًا مِنْ ضَرِیعٍ لاَ یُسْمِنُ وَلاَ یُغْنِی مِنْ جُوعٍ ، قَالَ: ثُمَّ تَدَارَکَہَا بَعْدُ ، فَقَالَ : إنْ کَانَ ذَلِکَ أَحَبَّ إلَیْک ، فَقُلْتُ : أَتَشُکُّ فِی الْحَجَّاجِ ؟ قَالَ : وَتَعُدُّ ذَلِکَ ذَنْبًا؟۔","","Musannaf Ibn Abi Shaybah 31240","","","كتاب الأمراء"
"31241","(۳۱۲۴۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ : سَمِعْتُ أَبِی یَقُولُ ، قَالَ : بَلَغَ عَلِیَّ بْنَ أَبِی طَالِبٍ أَنَّ طَلْحَۃَ یَقُولُ : إنَّمَا بَایَعْت وَاللُّجُّ عَلَی قَفَای ، فَأَرْسَل ابْنُ عَبَّاسٍ فَسَأَلَہُ ، قَالَ : فَقَالَ أُسَامَۃُ : أَمَّا اللُّجُّ عَلَی قَفَاہُ فَلا ، وَلَکِنْ قَدْ بَایَعَ وَہُوَ کَارِہٌ ، قَالَ : فَوَثَبَ النَّاسُ إلَیْہِ حَتَّی کَادُوا أَنْ یَقْتُلُوہُ ، قَالَ : فَخَرَجَ صُہَیْبٌ وَأَنَا إلَی جَنْبِہِ ، فَالْتَفَتَ إلَیَّ فَقَالَ : قَدْ عَلِمْت أَنَّ أُمَّ عَوْفٍ حَائِنَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 31241","","","كتاب الأمراء"
"31242","(۳۱۲۴۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، قَالَ : دَخَلْنَا عَلَی ابْنِ أَبِی الْہُذَیْلِ فَقَالَ : قَتَلُوا عُثْمَانَ ، ثُمَّ جَائُونِی ، فَقُلْتُ لَہُ : أَتَرِیبُک نَفْسُک ؟۔","","Musannaf Ibn Abi Shaybah 31242","","","كتاب الأمراء"
"31243","(۳۱۲۴۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہَارُونَ بْنِ عَنْتَرَۃَ ، قَالَ : سَمِعْتُ أَبَا عُبَیْدَۃَ یَقُولُ : کَیْفَ أَرْجُو الشَّہَادَۃَ بَعْدَ قَوْلِی : أَرَأَیْت أَبَاکَ یُزْجَرُ زَجْرَ الأَعْرَابِ۔","","Musannaf Ibn Abi Shaybah 31243","","","كتاب الأمراء"
"31244","(۳۱۲۴۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہَارُونَ بْنِ عَنْتَرَۃَ ، عَنْ سُلَیْمِ بْنِ حَنْظَلَۃَ ، قَالَ : أَتَیْنَا أُبَیَّ بْنَ کَعْبٍ لِنَتَحَدَّثَ مَعَہُ ، فَلَمَّا قَامَ یَمْشِی قُمْنَا لِنَمْشِی مَعَہُ ، فَلَحِقَہُ عُمَرُ فَرَفَعَ عَلَیْہِ الدِّرَّۃَ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ : أَعْلَمُ مَا تَصْنَعُ ، قَالَ : مَا تَرَی فِتْنَۃً لِلْمَتْبُوعِ ذِلَّۃً لِلتَّابِعِ۔","Hasan","Musannaf Ibn Abi Shaybah 31244","","","كتاب الأمراء"
"31245","(۳۱۲۴۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : جَائَ رَجُلٌ إلَی کَعْبِ بْنِ عُجْرَۃَ فَجَعَلَ یَذْکُرُ عَبْدَ اللہِ بْنَ أُبَیٍّ ، وَمَا نَزَلَ فِیہِ مِنَ الْقُرْآنِ وَیَعِیبَہُ ، وَکَانَ بَیْنَہُ وَبَیْنَہُ حُرْمَۃٌ وَقَرَابَۃٌ ، وَکَعْبٌ سَاکِتٌ ، قَالَ : فَانْطَلَقَ الرَّجُلُ إلَی عُمَرَ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ أَلَمْ تَرَ أَنِّی ذَکَرْت مَا نَزَلَ فِی عَبْدِ اللہِ بْنِ أُبَی، فَلَمْ یَکُنْ مِنْ کَعْبٍ، فَالْتَقَی عُمَرُ کَعْبًا ، فَقَالَ: أَلَمْ أُخْبِرْ أَنَّ عَبْدَ اللہِ بْنَ أُبَیٍّ ذُکِرَ عِنْدَکَ فَلَمْ یَکُنْ مِنْک ، قَالَ کَعْبٌ: قَدْ سَمِعْت مَقَالَتَہُ ، فَلَمَّا رَأَیْتہ کَأَنَّہُ تَعَمَّد مَسَائَتِی ، کَرِہْتُ أَنْ أُعِینُہُ عَلَی مَسَائَتِی ، قَالَ : فَقَالَ عُمَرُ : وَدِدْت أَنْ لَوْ ضَرَبْت أَنْفَہُ ، أَوْ وَدِدْت أَنْ لَوْ کَسَرْت أَنْفَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31245","","","كتاب الأمراء"
"31246","(۳۱۲۴۶) حَدَّثَنَا عَبْدُاللہِ بْنُ إدْرِیسَ، عَنْ ہَارُونَ بْنِ أَبِی إِبْرَاہِیمَ، عَن عَبْدِاللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ: أَنَ الأَشْتَرَ وَابْنَ الزُّبَیْرِ الْتَقَیَا ، فَقَالَ ابْنُ الزُّبَیْرِ : مَا ضَرَبْتہ إلاَّ ضَرْبَۃً حَتَّی ضَرَبَنِی خَمْسًا أَوْ سِتًّا ، ثُمَّ قَالَ : فَأَلْقَانِی بِرجلی ، ثُمَّ قَالَ : أَما واللہِ لَوْلاَ قَرَابَتُک مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَا تَرَکْت مِنْک عُضْوًا مَعَ صَاحِبِہِ ، قَالَ : وَقَالَتْ عَائِشَۃُ : وَا ثُکْلَ أَسْمَائَ ، قَالَ : فَلَمَّا کَانَ بَعْدُ أَعْطَتَ الَّذِی بَشَّرَہَا ، أَنَّہُ حَیٌّ عَشَرَۃَ آلاَفٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31246","","","كتاب الأمراء"
"31247","(۳۱۲۴۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی السَّفَرِ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَا عَلِمْت أَحَدًا انْتَصَفَ مِنْ شُرَیْحٍ إلاَّ أَعْرَابِیٌّ ، قَالَ لَہُ شُرَیْحٌ : إنَّ لِسَانَک أَطْوَلُ مِنْ یَدِکَ ، فَقَالَ الأَعْرَابِیُّ : أَسَامِرِیٌّ أَنْتَ فَلاَ تُمَسُّ ، قَالَ لَہُ شُرَیْحٌ : أَقْبِلْ قِبَلَ أَمْرِک ، قَالَ : ذَاکَ أَعملَنِی إلَیْک ، قَالَ : فَلَمَّا أَرَادَ أَنْ یَقُومَ ، قَالَ لَہُ شُرَیْحٌ : إنِّی لَمْ أُرِدْک بِقَوْلِی ، قَالَ : وَلاَ اجْتَرَمْتُ عَلَیْک۔","","Musannaf Ibn Abi Shaybah 31247","","","كتاب الأمراء"
"31248","(۳۱۲۴۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ شَمْرِ بْنِ عَطِیَّۃَ : أَنَّ ابْنَ مِخْنَفٍ الأَزْدِیَّ جَلَسَ إلَی عَلِیٍّ ، قَالَ : فَقَالَ لَہُ عَلِیٌّ : اقْرَا ، فَقَرَأَ سُورَۃَ الْبَقَرَۃِ ، فَمَا فَرَغَ مِنْہَا حَتَّی شَقَّ عَلیَّ ، قَالَ : فَبَعَثَہُ إِلَی أَصْبَہَانَ ، قَالَ : فَأَخَذَ مَا أَخَذَ وَحَمَلَ بَقِیَّۃَ الْمَالِ إلَی مُعَاوِیَۃَ۔","","Musannaf Ibn Abi Shaybah 31248","","","كتاب الأمراء"
"31249","(۳۱۲۴۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ سِیَاہٍ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ ثَعْلَبَۃَ بْنِ یَزِیدَ الْحِمَّانِیِّ ، قَالَ : سَمِعْتُ عَلِیًّا عَلَی ہَذَا الْمِنْبَرِ یَقُولُ : أَیُّہَا النَّاسُ ، أَعِینُونِی عَلَی أَنْفُسِکُمْ ، فَإِنْ کَانَتِ الْقَرْیَۃُ لَیُصْلِحُہَا السَّبْعَۃُ ، وَإِنْ کُنْتُمْ لاَ بُدَّ مُنْتَہِبِیہِ فَہَلُمَّ حَتَّی أُقَسِّمَہُ بَیْنَکُمْ ، فَإِنَّ الْقَوْمَ مَتَی یَنْزِلُوا بِالْقَوْمِ یَضْرِبُوا وُجُوہَہُمْ عَن قَرْیَتِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 31249","","","كتاب الأمراء"
"31250","(۳۱۲۵۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، قَالَ : مَرَّ ابْنُ عُمَرُ بِحُذَیْفَۃَ ، فَقَالَ حُذَیْفَۃُ : لَقَدْ جَلَسَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَجْلِسًا مَا مِنْہُمْ مِنْ أَحَدٍ إلاَّ أَعْطَی مِنْ دَیْنِہِ إلاَّ ہَذَا الرَّجُلُ۔","Da'if","Musannaf Ibn Abi Shaybah 31250","","","كتاب الأمراء"
"31251","(۳۱۲۵۱) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ شُعْبَۃَ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ، عَنِ ابْنِ مِینَائَ، عَنِ الْمِسْوَرِ بْنِ مَخْرَمَۃَ، قَالَ: سَمِعْتُ عُمَرَ، وَإِنَّ أَحَدَ أَصَابِعِی فِی جُرْحِہِ ہَذِہِ أَوْ ہُوَ یَقُولُ : یَا مَعْشَرَ قُرَیْشٍ ، إنِّی لاَ أَخَافُ النَّاسَ عَلَیْکُمْ ، إنَّمَا أَخَافُکُم عَلَی النَّاسِ ، وَإِنِّی قَدْ تَرَکْت فِیکُمَ اثْنَتَیْنِ لَمْ تَبْرَحُوا بِخَیْرٍ مَا لَزِمْتُمُوہَا : الْعَدْلَ فِی الْحُکْمِ ، وَالْعَدْلَ فِی الْقَسْمِ ، وَإِنِّی قَدْ تَرَکَتْکُمْ عَلَی مِثْلِ مَخْرَفَۃِ الْنَعَمِ إلاَّ أَنْ یَعْوَجَّ قَوْمٌ فَیُعْوَجَّ بِہِمْ۔ (بیہقی ۱۳۴)","Sahih","Musannaf Ibn Abi Shaybah 31251","","","كتاب الأمراء"
"31252","(۳۱۲۵۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : مَرَرْنَا عَلَی أَبِی ذَرٍّ بِالرَّبَذَۃِ ، فَسَأَلْنَاہُ عَنْ مَنْزِلِہِ ، قَالَ : کُنْتُ بِالشَّامِ فَقَرَأْت ہَذِہِ الآیَۃَ : {الَّذِینَ یَکْنِزُونَ الذَّہَبَ وَالْفِضَّۃَ وَلاَ یُنْفِقُونَہَا فِی سَبِیلِ اللہِ} فَقَالَ مُعَاوِیَۃُ : إنَّمَا ہِیَ فِی أَہْلِ الْکِتَابِ ، فَقُلْتُ : إِنَّہَا لَفِینَا وَفِیہِمْ ، فَکَتَبْتُ إلَی عُثْمَان ، قَالَ : فَکَتَبَ إلَیَّ عُثْمَان : أَنْ أَقْبِلْ ، فَلَمَّا قَدِمْت رَکِبَنِی النَّاسُ کَأَنَّہُمْ لَمْ یَرَوْنِی قَبْلَ ذَلِکَ ، فَشَکَوْت ذَلِکَ إلَی عُثْمَانَ ، فَقَالَ : لَوِ اعْتَزَلْت فَکُنْت قَرِیبًا ، فَنَزَلْت ہَذَا الْمَنْزِلَ ، فَلاَ أَدَعُ قَوْلَہ وَلَوْ أَمَّرُوا عَلَیَّ عَبْدًا حَبَشِیًّا۔","Sahih","Musannaf Ibn Abi Shaybah 31252","","","كتاب الأمراء"
"31253","(۳۱۲۵۳) حَدَّثَنَا جَرِیرٌ ، عَنْ أَبِی جَعْفَر ، عَنْ مُغِیرَۃَ ، قَالَ : قَالَ إبْرَاہِیمُ : کَفَی بِمَنْ شَکَّ فِی الْحَجَّاجِ لَحَاہُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 31253","","","كتاب الأمراء"
"31254","(۳۱۲۵۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَانَ لَہُ سُمَّارٌ ، فَکَانَ عَلاَمَۃُ مَا بَیْنَہُ وَبَیْنَہُمْ أَنْ یَقُولَ لَہُمْ : إذَا شِئْتُمْ۔","","Musannaf Ibn Abi Shaybah 31254","","","كتاب الأمراء"
"31255","(۳۱۲۵۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ إبْرَاہِیمُ إذَا ذُکِرَ عِنْدَ ابْنِ سِیرِینَ ، قَالَ : قَدْ رَأَیْت فَتًی یَغْشَی عَلْقَمَۃَ فِی عَیْنِہِ بَیَاضٌ فَأَمَّا الشَّعْبِیُّ فَقَدْ رَأَیْتہ۔ یَعْنِی : فِی زَمَانِ ابْنِ زِیَادٍ۔","","Musannaf Ibn Abi Shaybah 31255","","","كتاب الأمراء"
"31256","(۳۱۲۵۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ مُعَاذُ شَابًّا آدَمَ وَضَّاحَ الثَّنَایَا ، وَکَانَ إذَا جَلَسَ مَعَ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَوْا لَہُ مَا یَرَوْنَ لِلْکَہْلِ۔","","Musannaf Ibn Abi Shaybah 31256","","","كتاب الأمراء"
"31257","(۳۱۲۵۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حَسَنِ بْنِ فُرَاتٍ ، عَنْ أَبِیہِ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، قَالَ : لَمَّا رَجَعَ عَلِیٌّ مِنَ الْجَمَلِ ، وَتَہَیَّأَ إلَی صِفِّینَ اجْتَمَعَتِ النَّخْعُ حَتَّی دَخَلُوا عَلَی الأَشْتَرِ ، فَقَالَ : ہَلْ فِی الْبَیْتِ إلاَّ نَخْعِیٌّ ، قَالُوا : لاَ ، قَالَ : إنَّ ہَذِہِ الأُمَّۃَ عَمَدَتْ إلَی خَیْرِہَا فَقَتَلَتْہُ ، وَسِرْنَا إلَی أَہْلِ الْبَصْرَۃِ قوْمٌ لَنَا عَلَیْہِمْ بَیْعَۃٌ فَنُصِرْنَا عَلَیْہِمْ بِنَکْثِہِمْ ، وَإِنَّکُمْ سَتَسِیرُونَ إلَی أَہْلِ الشَّامِ قَوْمٌ لَیْسَ لَکُمْ عَلَیْہِمْ بَیْعَۃٌ ، فَلْیَنْظُرَ امْرُؤٌ مِنْکُم أَیْنَ یَضَعُ سَیْفَہُ ؟!۔","Sahih","Musannaf Ibn Abi Shaybah 31257","","","كتاب الأمراء"
"31258","(۳۱۲۵۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ قِیلَ لِعُمَرَ : اکْتُبْ إلَی جَوَانَانَ ، قَالَ : وَمَا جَوَانَانُ ، قَالُوا : خَیْرُ الْفِتْیَانِ ، قَالَ : اکْتُبْ إلَی شَرِّ الْفِتْیَانِ۔ (عبدالرزاق ۱۹۸۵۵)","","Musannaf Ibn Abi Shaybah 31258","","","كتاب الأمراء"
"31259","(۳۱۲۵۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، قَالَ : رَأَیْتُ عَبْدَ الرَّحْمَن بْنَ أَبِی لَیْلَی ضَرَبَہُ الْحَجَّاجُ وَأَوْقَفَہُ عَلَی بَابِ الْمَسْجِدِ ، قَالَ : فَجَعَلُوا یَقُولُونَ لَہُ : الْعَنِ الْکَذَّابِینَ ، فَجَعَلَ یَقُولُ : لَعَن اللَّہُ الْکَذَّابِینَ ، ثُمَّ سَکَتَ حِینَ سَکَتَ ، ثُمَّ یَقُولُ : عَلِیُّ بْنُ أَبِی طَالِبٍ ، وَعَبْدُ اللہِ بْنُ الزُّبَیْرِ وَالْمُخْتَارُ بْنُ أَبِی عُبَیْدٍ ، فَعَرَفْت حِینَ سَکَتَ ، ثُمَّ ابْتَدَأَہُمْ فَعِرَّفَہُمْ ، أَنَّہُ لَیْسَ یُرِیدُہُمْ۔","","Musannaf Ibn Abi Shaybah 31259","","","كتاب الأمراء"
"31260","(۳۱۲۶۰) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ ، قَالَ : أَخْبَرَنَا جَعْفَرُ بْنُ زِیَادٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : کُنْتُ جَالِسًا مَعَ أَبِی الْبَخْترِیِّ الطَّائِیِّ وَالْحَجَّاجُ یَخْطُبُ ، فَقَالَ : مَثَلُ عُثْمَانَ عِنْدَ اللہِ کَمَثَلِ عِیسَی ابْنِ مَرْیَمَ ، قَالَ : فَرَفَعَ رَأْسَہُ ثُمَّ تَأَوَّہَ ، ثُمَّ قَالَ : {إنِّی مُتَوَفِّیک وَرَافِعُک إلَیَّ} إِلَی قَوْلِہ {وَجَاعِلُ الَّذِینَ اتَّبَعُوک فَوْقَ الَّذِینَ کَفَرُوا إلَی یَوْمِ الْقِیَامَۃِ} قَالَ : فَقَالَ أَبُو الْبَخْترِیِّ : کَفَرَ وَرَبِّ الْکَعْبَۃِ۔","","Musannaf Ibn Abi Shaybah 31260","","","كتاب الأمراء"
"31261","(۳۱۲۶۱) حَدَّثَنَا مالک بن إسْمَاعِیلَ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، قَالَ : حَدَّثَنَا کِنَانَۃٌ ، قَالَ : کُنْتُ أَقُودُ بِصَفِیَّۃَ لِتَرُدَّ عَنْ عُثْمَانَ ، قَالَ : فَلَقِیَہَا الأَشْتَرُ فَضَرَبَ وَجْہَ بَغْلَتِِہَا حَتَّی مَالَتْ وَحَتَّی قَالَتْ : رُدُّونِی لاَ یَفْضَحُنِی ہَذَا۔n(ابن سعد ۱۲۸)","Hasan","Musannaf Ibn Abi Shaybah 31261","","","كتاب الأمراء"
"31262","(۳۱۲۶۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الرَّبِیعِ بْنِ أَبِی صَالِحٍ ، قَالَ : لَمَّا قَدِمَ سَعِیدُ بْنُ جُبَیْرٍ مِنْ مَکَّۃَ إلَی الْکُوفَۃِ لِیُنْطَلَقَ بِہِ إلَی الْحَجَّاجِ إلَی وَاسِطٍ ، قَالَ : فَأَتَیْنَاہُ وَنَحْنُ ثَلاَثَۃُ نَفَرٍ ، أَوْ أَرْبَعَۃٌ ، فَوَجَدْنَاہُ فِی کُنَاسَۃِ الْخَشَبِ فَجَلَسْنَا إلَیْہِ ، فَبَکَی رَجُلٌ مِنَّا ، فَقَالَ لَہُ سَعِیدٌ : مَا یُبْکِیَک ، قَالَ : أَبْکِی لِلَّذِی نَزَلَ بِکَ مِنَ الأَمْرِ ، قَالَ : فَلاَ تَبْکِ فَإِنَّہُ قَدْ کَانَ سَبَقَ فِی عِلْمِ اللہِ یَکُونُ ہَذَا ، ثُمَّ قَرَأَ : {مَا أَصَابَ مِنْ مُصِیبَۃٍ فِی الأَرْضِ ، وَلاَ فِی أَنْفُسِکُمْ إلاَّ فِی کِتَابٍ مِنْ قَبْلِ أَنْ نَبْرَأَہَا إنَّ ذَلِکَ عَلَی اللہِ یَسِیرٌ}۔","","Musannaf Ibn Abi Shaybah 31262","","","كتاب الأمراء"
"31263","(۳۱۲۶۳) حَدَّثَنَا عَفَّانُ، قَالَ: حدَّثَنَا أَبُو عَوَانَۃَ، قَالَ: حَدَّثَنَا الْمُغِیرَۃُ، عَنْ ثَابِتِ بْنِ ہُرْمُزَ، عَنْ عَبَّادٍ، قَالَ: أَتَی الْمُخْتَارُ عَلِیَّ بْنَ أَبِی طَالِبٍ بِمَالٍ مِنَ الْمَدَائِنِ وَعَلَیْہَا عَمُّہُ سَعْدُ بْنُ مَسْعُودٍ ، قَالَ : فَوَضَعَ الْمَالَ بَیْنَ یَدَیْہِ وَعَلَیْہِ مُقَطَّعَۃٌ حَمْرَائُ، قَالَ: فَأَدْخَلَ یَدَہُ فَاسْتَخْرَجَ کِیسًا فِیہِ نَحْوٌ مِنْ خَمْسَ عَشْرَۃَ مِئَۃ، قَالَ: ہَذَا مِنْ أُجُورِ الْمُومِسَاتِ قَالَ : فَقَالَ عَلِیٌّ : لاَ حَاجَۃَ لَنَا فِی أُجُورِ الْمُومِسَاتِ ، قَالَ : وَأَمَرَ بِمَالِ الْمَدَائِنِ فَرُفِعَ إلَی بَیْتِ الْمَالِ ، قَالَ : فَلَمَّا أَدْبَرَ ، قَالَ لَہُ عَلِیٌّ : قَاتَلَہُ اللہ ، لَوْ شُقَّ عَلَی قَلْبِہِ لَوُجِدَ مَلآنُ مِنْ حُبِّ اللاَّتِ وَالْعُزَّی۔","","Musannaf Ibn Abi Shaybah 31263","","","كتاب الأمراء"
"31264","(۳۱۲۶۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وُہَیْبٌ ، قَالَ : حَدَّثَنَا دَاوُد ، عَنِ الْحَسَنِ ، عَنِ الزُّبَیْرِ بْنِ الْعَوَّامِ : فِی ہَذِہِ الآیَۃِ : {وَاتَّقُوا فِتْنَۃً لاَ تُصِیبَنَّ الَّذِینَ ظَلَمُوا مِنْکُمْ خَاصَّۃً} قَالَ لَقَدْ نَزَلَتْ ، وَمَا نَدْرِی مَنْ یَخلُفُ لَہَا ، قَالَ : فَقَالَ بَعْضُہُمْ : یَا أَبَا عَبْدِ اللہِ ، فَلِمَ جِئْت إلَی الْبَصْرَۃِ ؟ قَالَ : وَیْحَک إنَّا نُبْصِرُ وَلَکِنَّا لاَ نَصْبِرُ۔","Hasan","Musannaf Ibn Abi Shaybah 31264","","","كتاب الأمراء"
"31265","(۳۱۲۶۵) حَدَّثَنَا عَفَّانُ ، قَالَ : نَا أَبُو عَوَانَۃَ ، عَنِ الْمُغِیرَۃِ ، عَنْ قُدَامَۃَ بْنِ عِتَابٍ ، قَالَ : رَأَیْتُ عَلِیًّا یَخْطُبُ فَأَتَاہُ آتٍ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، أَدْرِکْ بَکْرَ بْنَ وَائِلٍ فَقَدْ ضَرَبَتْہَا بَنُو تَمِیمٍ بِالْکُنَاسَۃِ ، قَالَ عَلِیٌّ : ہَاہ ، ثُمَّ أَقْبَلَ عَلَی خُطْبَتِہِ ، ثُمَّ أَتَاہُ آخَرُ فَقَالَ مِثْلَ ذَلِکَ ، فَقَالَ : آہٍ ، ثُمَّ أَتَاہُ الثَّالِثَۃَ ، أَو الرَّابِعَۃَ ، فَقَالَ : أَدْرِکْ بَکْرَ بْنَ وَائِلٍ فَقَدْ ضَرَبَتْہَا بَنُو تَمِیمٍ ہِیَ بِالْکُنَاسَۃِ ، فَقَالَ : الآن صَدَقْتنِی سِن بَکْرِکَ یَا شَدَّادُ ؟ أَدْرِکْ بَکْرَ بْنَ وَائِلٍ وَبَنِی تَمِیمٍ فَأَقْرِعْ بَیْنَہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 31265","","","كتاب الأمراء"
"31266","(۳۱۲۶۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ بْنُ حَوْشَبٍ ، عَنْ إبْرَاہِیمَ مَوْلَی صُخَیرٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : بَعَثَ إلَیَّ الْحَجَّاجُ فَقَدِمْت عَلَیْہِ الأَہْوَازَ ، قَالَ لِی : مَا مَعَک مِنَ الْقُرْآنِ ، قَالَ : قُلْتُ : مَعِی مَا إنِ اتَّبَعْتہ کَفَانِی ، قَالَ : إنِّی أُرِیدُ أَنْ أَسْتَعِینَ بِکَ عَلَی بَعْضِ عَمَلِی ، قَالَ : قُلْتُ : إنْ تُقْحِمْنِی أَقْتَحِمْ ، وَإِنْ تَجْعَلْ مَعِی غَیْرِی خِفْت بَطَائِنَ السُّوئِ ، قَالَ : فَقَالَ الْحَجَّاجُ : وَاللہِ لَئِنْ قُلْتَ ذَاکَ إنَّ بَطَائِنَ السُّوئِ لَمَفْسَدَۃٌ للرَّجُلِ ، قَالَ : قُلْتُ : مَا زِلْت أُقَحَّزُ مُنْذُ اللَّیْلَۃَ عَلَی فِرَاشِی مَخَافَۃَ أَنْ تَقْتُلَنِی ، قَالَ : وَعَلاَمَ أَقْتُلُک ؟ أَمَا وَاللہِ لَئِنْ قُلْتَ ذَاکَ ، إنِّی لأقْتُلُ الرَّجُلَ عَلَی أَمْرٍ قَدْ کَانَ مَنْ قَبْلِی یُہَابُ الْقَتْلُ عَلَی مِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 31266","","","كتاب الأمراء"
"31267","(۳۱۲۶۷) حَدَّثَنَا زَیْدُ بْنُ حَبَّابٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ ہِلاَلٍ الْقُرَشِیُّ ، قَالَ : أَخْبَرَنَا أَبِی ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ لِمَرْوَانَ وَأَبْطَأَ بِالْجُمُعَۃِ : تَظَلُّ عِنْدَ بِنْتِ فُلاَنٍ تُرَوِّحُک بِالْمَرَاوِحِ وَتَسْقِیک الْمَائَ الْبَارِدَ ، وَأَبْنَائُ الْمُہَاجِرِینَ یُسْلَقُونَ مِنَ الْحَرِ ، لَقَدْ ہَمَمْت أَنِّی أَفْعَلُ وَأَفْعَلُ ، ثُمَّ قَالَ : اسْمَعُوا لأَمِیرِکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 31267","","","كتاب الأمراء"
"31268","(۳۱۲۶۸) حَدَّثَنَا حَمَّادُ بْنُ أُسَامَۃَ ، قَالَ : حدَّثَنَ[corrupt] حماد بن زید ، قَالَ : حدَّثَنَا أَبُو نَعَامَۃَ عَمْرُو بْنُ عِیسَی ، قَالَ : قَالَتْ عَائِشَۃُ : اللَّہُمَّ أَدْرِکْ خُفْرَتَکَ فِی عُثْمَانَ وَأَبْلِغِ الْقِصَاصَ فِی مُذَمَّمْ وَأَبْدِ عَوْرَۃ أَعْیَن رَجُلٌ مِنْ بَنِی تَمِیمٍ أَبِی امْرَأَۃِ الْفَرَزْدَقَ۔","","Musannaf Ibn Abi Shaybah 31268","","","كتاب الأمراء"
"31269","(۳۱۲۶۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، قَالَ : أَخْبَرَنَا أَبُو نَضْرَۃَ : أَنَّ رَبِیعَۃَ کَلَّمَت طَلْحَۃَ فِی مَسْجِدِ بَنِی سَلَمَۃَ ، فَقَالَت : کُنَّا فِی نَحْرِ الْعَدُوِّ حِینَ جَائَتْنَا بَیْعَتُک ہَذَا الرَّجُلَ ، ثُمَّ أَنْتَ الآنَ تُقَاتِلُہُ ، أَوْ کَمَا قَالُوا ، فَقَالَ : إنِّی أُدْخِلْت الْحُشَّ وَوُضِعَ عَلَی عُنُقِی اللُّج ، فَقِیلَ : بَایِعْ وَإِلاَّ قَتَلْنَاک ، قَالَ : فَبَایَعْت ، وَعَرَفْتُ أَنَّہَا بَیْعَۃُ ضَلاَلَۃٍ۔ قَالَ التَّیْمِیُّ : وَقَالَ وَلِیدُ بْنُ عَبْدِ الْمَلِکِ : إنَّ مُنَافِقًا مِنْ مُنَافِقِی أَہْلِ الْعِرَاقِ جَبَلَۃَ بْنَ حَکِیمٍ قَالَ لِلزُّبَیْرِ : فإنَّک قَدْ بَایَعْت ، فَقَالَ الزُّبَیْرُ : إنَّ السَّیْفَ وُضِعَ عَلَی عنقِی فَقِیلَ لِی : بَایِعْ وَإِلاَّ قَتَلْنَاک ، قَالَ : فَبَایَعْت۔","Hasan","Musannaf Ibn Abi Shaybah 31269","","","كتاب الأمراء"
"31270","(۳۱۲۷۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ : أَنَّ أُنَاسًا کَانُوا عِنْدَ فُسْطَاطِ عَائِشَۃَ ، فَمَرَّ عُثْمَان أُری ذَاکَ بِمَکَّۃَ ، قَالَ أَبُو سَعِیدٍ : فَمَا بَقِیَ أَحَدٌ مِنْہُمْ إلاَّ لَعَنَہُ ، أَوْ سَبَّہُ غَیْرِی، وَکَانَ فِیہِمْ رَجُلٌ مِنْ أَہْلِ الْکُوفَۃِ ، فَکَانَ عُثْمَان عَلَی الْکُوفِیِّ أَجْرَأَ مِنْہُ عَلَی غَیْرِہِ ، فَقَالَ : یَا کُوفِی ، أَتَشْتِمُنِی ؟ اقْدَمِ الْمَدِینَۃَ ، کَأَنَّہُ یَتَہَدَّدُہُ ، قَالَ : فَقَدِمَ الْمَدِینَۃَ ، فَقِیلَ لَہُ : عَلَیْک بِطَلْحَۃِ ، قَالَ : فَانْطَلَقَ مَعَہُ طَلْحَۃُ حَتَّی أَتَی عُثْمَانَ ، قَالَ عُثْمَان : وَاللہِ لاَجْلِدَنَّکَ مِئَۃ ، قَالَ طَلْحَۃُ : وَاللہِ لاَ تَجْلِدُہُ مِئَۃ إلاَّ أَنْ یَکُونَ زَانِیًا ، قَالَ : لأَحْرِمَنَّکَ عَطَائَک ، قَالَ : فَقَالَ طَلْحَۃُ : إنَّ اللَّہَ سَیَرْزُقُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31270","","","كتاب الأمراء"
"31271","(۳۱۲۷۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ عُمَرَ بْنِ جَاوَانَ ، عَنِ الأَحْنَفِ بْنِ قَیْسٍ ، قَالَ : قدِمْنَا الْمَدِینَۃَ وَنَحْنُ نُرِیدُ الْحَجَّ ، قَالَ الأَحْنَفُ : فَانْطَلَقْتُ فَأَتَیْتُ طَلْحَۃَ وَالزُّبَیْرَ ، فَقُلْتُ : مَنْ تَأْمُرَانِی بِہِ وَتَرْضَیَانِہِ لِی ؟ فَإِنِّی مَا أَرَی ہَذَا إلاَّ مَقْتُولاً ، یَعْنِی عُثْمَانَ ، قَالاَ : نَأْمُرُک بِعَلِیّ ، قُلْتُ تَأْمُرَانِی بِہِ وَتَرْضَیَانِہِ لِی ؟ قَالاَ : نَعَمْ ، قَالَ : ثُمَّ انْطَلَقْت حَاجًّا حَتَّی قَدِمْت مَکَّۃَ ، فَبَیْنَا نَحْنُ بِہَا إذْ أَتَانَا قَتْلُ عُثْمَانَ ، وَبِہَا عَائِشَۃُ أُمُّ الْمُؤْمِنِینَ ، فَلَقِیتُہَا ، فَقُلْتُ : مَنْ تَأْمُرِینِی بِہِ أَنْ أُبَایِعَ ؟ قَالَتْ : عَلِی ، قُلْتُ : أَتَأْمُرِینِی بِہِ وَتَرْضَیْنَہُ لِی ؟ قَالَتْ : نَعَمْ ، فَمَرَرْت عَلَی عَلِیٍّ بِالْمَدِینَۃِ فَبَایَعْتہ ، ثُمَّ رَجَعْت إلَی الْبَصْرَۃِ وَأَنَا أَرَی أَنَّ الأَمْرَ قَدِ اسْتَقَامَ۔n فَبَیْنَا أَنَا کَذَلِکَ إذْا أَتَانِی آتٍ ، فَقَالَ : ہَذِہِ عَائِشَۃُ أُمُّ الْمُؤْمِنِینَ وَطَلْحَۃُ وَالزُّبَیْرُ قَدْ نَزَلُوا جَانِبَ الْخُرَیْبَۃِ ، قَالَ : فَقُلْتُ : مَا جَائَ بِہِمْ ؟ قَالُوا : أَرْسَلُوا إلَیْک یَسْتَنْصِرُونَک عَلَی دَمِ عُثْمَانَ ، قُتِلَ مَظْلُومًا ، قَالَ : فَأَتَانِی أَفْظَعُ أَمْرٍ أَتَانِی قَطُّ ، قَالَ : قُلْتُ : إنَّ خِذَلاَنِی ہَؤُلاَئِ وَمَعَہُمْ أُمُّ الْمُؤْمِنِینَ وَحَوَارِیُّ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَشَدِیدٌ ، وَإِنَّ قِتَالِی ابْنِ عَمِّ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعْدَ أَنْ أَمَرُونِی بِبَیْعَتِہِ لَشَدِیدٌ۔n قَالَ : فَلَمَّا أَتَیْتہمْ ، قَالوا : جِئْنَا نَسْتَنْصِرُک عَلَی دَمِ عُثْمَانَ قُتِلَ مَظْلُومًا ، قَالَ : قُلْتُ : یَا أُمَّ الْمُؤْمِنِینَ ، أُنْشِدُک بِاللہِ أَقُلْتُ لَکِ : مَنْ تَأْمُرِینِی فَقُلْتِ : عَلِیّ ، وَقُلْتُ : تَأْمُرِینِی بِہِ وَتَرْضِینَہُ لِی ؟ قُلْتُ : نَعَم ؟ قَالَتْ : نَعَمْ ، وَلَکِنَّہُ بَدَّل ، فَقُلْتُ : یَا زُبَیْرُ یَا حَوَارِیَّ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، یَا طَلْحَۃُ ، نَشَدْتُکُمَا بِاللہِ: أَقُلْت لَکُمَا : مَنْ تَأْمُرَانِی بِہِ ، فَقُلْتُمَا : عَلِیًّا ، فَقُلْتُ : تَأْمُرَانِی بِہِ وَتَرْضَیَانِہِ لِی ، فَقُلْتُمَا : نَعَمْ ؟ قَالاَ : بَلَی ، وَلَکِنَّہُ بَدَّلَ۔n قَالَ : قُلْتُ : لاَ أُقَاتِلُکُمْ وَمَعَکُمْ أُمُّ الْمُؤْمِنِینَ وَحَوَارِیُّ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلاَ أُقَاتِلُ ابْنَ عَمِّ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرْتُمُونِی بِبَیْعَتِہِ ، اخْتَارُوا مِنِّی إِحْدَی ثَلاَثَ خِصَالٍ : إمَّا أَنْ تَفْتَحُوا لِی بَابَ الْجِسْرِ فَأَلْحَقَ بِأَرْضِ الأَعَاجِمِ حَتَّی یَقْضِیَ اللَّہُ مِنْ أَمْرِہِ مَا قَضَی ، أَوْ أَلْحَقَ بِمَکَّۃَ فَأَکُونَ بِہَا حَتَّی یَقْضِیَ اللَّہُ مِنْ أَمْرِہِ مَا قَضَی ، أَوْ أَعْتَزِلُ فَأَکُونَ قَرِیبًا ، قَالُوا : نَأْتَمر ، ثُمَّ نُرْسِلُ إلَیْک ، فَأْتَمَرُوا ، فَقَالُوا : نَفْتَحُ لَہُ بَابَ الْجِسْرِ یَلْحَقُ بِہِ الْمُفَارِقُ وَالْخَاذِلُ ، أَوْ یَلْحَقُ بِمَکَّۃَ فَیَتَعَجَّسَکُمْ فِی قُرَیْشٍ وَیُخْبِرُہُمْ بِأَخْبَارِکُمْ ، لَیْسَ ذَلِکَ بِرَأْی ، اجْعَلُوہُ ہَاہُنَا قَرِیبًا حَیْثُ تَطَؤُونَ عَلَی صِمَاخِہِ وَتَنْظُرُونَ إلَیْہِ۔n فَاعْتَزَلَ بِالْجَلْحَائِ مِنَ الْبَصْرَۃِ وَاعْتَزَلَ مَعَہُ زُہَائُ سِتَّۃِ آلاَفٍ ، ثُمَّ الْتَقَی الْقَوْمُ ، فَکَانَ أَوَّلُ قَتِیلٍ طَلْحَۃَ وَکَعْبَ بْنَ سُورٍ وَمَعَہُ الْمُصْحَفُ ، یُذَکِّرُ ہَؤُلاَئِ وَہَؤُلاَئِ حَتَّی قُتِلَ بَیْنَہُمْ ، وَبَلَغَ الزُّبَیْرُ سَفَوَانَ مِنَ الْبَصْرَۃِ کَمَکَانِ الْقَادِسِیَّۃِ مِنْکُمْ ، فَلَقِیَہُ النَّعِرُ : رَجُلٌ مِنْ مُجَاشِعٍ ، فَقَالَ : أَیْنَ تَذْہَبُ یَا حَوَارِیَّ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ إلَیَّ ، فَأَنْتَ فِی ذِمَّتِی لاَ یُوصَلُ إلَیْک ، فَأَقْبَلَ مَعَہُ ، فَأَتَی إنْسَانٌ الأَحْنَفَ ، فَقَالَ : ہَذَا الزُّبَیْرُ قَدْ لَحِقَ بِسَفوَانَ ، قَالَ : فَمَا یَأْمَن ؟ جَمَعَ بَیْنَ الْمُسْلِمِینَ حَتَّی ضَرَبَ بَعْضُہُمْ حَوَاجِبَ بَعْضٍ بِالسُّیُوفِ ، ثُمَّ لَحِقَ بِبَیْتہِ وَأَہْلِہِ۔n قَالَ : فَسَمِعَہُ عُمَیْرُ بْنُ جُرْمُوزٍ ، وَغُوَاۃٌ مِنْ غُوَاۃِ بَنِی تَمِیمٍ ، وَفُضَالَۃُ بْنُ حَابِسٍ ، وَنُفَیْعٌ ، فَرَکِبُوا فِی طَلَبِہِ فَلَقُوہُ مَعَ النَّعِرِ ، فَأَتَاہُ عُمَیْرُ بْنُ جُرْمُوزٍ مِنْ خَلْفِہِ وَہُوَ عَلَی فَرَسٍ لَہُ ضَعِیفَۃ فَطَعَنَہُ طَعْنَۃً خَفِیفَۃً ، وَحَمَلَ عَلَیْہِ الزُّبَیْرُ وَہُوَ عَلَی فَرَسٍ لَہُ یُقَالَ لَہُ : ذُو الْخِمَارِ ، حَتَّی إذَا ظَنَّ ، أَنَّہُ نَائِلُہُ نَادَی صَاحِبَیْہ یَا نُفَیْعٌ ، یَا فُضَالَۃُ ، فَحَمَلُوا عَلَیْہِ حَتَّی قَتَلُوہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31271","","","كتاب الأمراء"
"31272","(۳۱۲۷۲) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ یَحْیَی بْنِ عَبْدِاللہِ بْن أَبِی قَتَادَۃَ، قَالَ: مَازَحَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَبَا قَتَادَۃَ، فَقَالَ: لاَجُزَّنَّ جُمَّتَکَ، فَقَالَ لَہُ: لَک مَکَانُہَا أَسِیرٌ، فَقَالَ لَہُ بَعْدَ ذَلِکَ: أَکْرِمْہَا، فَکَانَ یَتَّخِذُ لَہَا السُّک۔","","Musannaf Ibn Abi Shaybah 31272","","","كتاب الأمراء"
"31273","(۳۱۲۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، عَنِ الْحَسَنِ بْنِ الْحَسَنِ : أَنَّ عَبْدَ اللہِ بْنَ جَعْفَرٍ زَوَّجَ ابْنَتَہُ فَخَلاَ بِہَا ، فَقَالَ لَہَا : إذَا نَزَلَ بِکَ الْمَوْتُ ، أَوْ أَمْرٌ مِنْ أُمُورِ الدُّنْیَا فَظِیعٌ فَاسْتَقْبِلِیہِ بِأَنْ تَقُولِی لاَ إلَہَ إلاَّ اللَّہُ الْحَلِیمُ الْکَرِیمُ سُبْحَانَ اللہِ رَبِّ الْعَرْشِ الْعَظِیمِ الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ۔n قَالَ الْحَسَنُ بْنُ الْحَسَنِ : فَبَعَثَ إلَیَّ الْحَجَّاجُ فَقُلْ[corrupt]ہنَّ ، فَلَمَّا مَثُلْت بَیْنَ یَدَیْہِ ، قَالَ : لَقَدْ بَعَثْت إلَیْک وَأَنَا أُرِیدُ أَنْ أَضْرِبَ عُنُقَک ، وَلَقَدْ صِرْت وَمَا مِنْ أَہْلِ بَیْتِکَ أَحَدٌ أَکْرَمُ عَلَیَّ مِنْک ، سَلْنِی حَاجَتَک۔","Hasan","Musannaf Ibn Abi Shaybah 31273","","","كتاب الأمراء"
"31274","(۳۱۲۷۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ نَافِعِ بْنِ عُمَرَ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : قَالَ ابْن الزُّبَیْرُ لِعُبَیْدِ بْنِ عُمَیْرٍ : کَلِّمْ ہَؤُلاَئِ لأَہْلِ الشَّامِ رَجَائَ أَنْ یَرُدَّہُمْ ذَاکَ ، فَسَمِعَ ذَلِکَ الْحَجَّاجُ فَأَرْسَلِ إلَیْہِمْ : ارْفَعُوا أَصْوَاتَکُمْ ، فَلاَ تَسْمَعُوا مِنْہُ شَیْئًا ، فَقَالَ عُبَیْدٌ : وَیْحَکُمْ ، لاَ تَکُونُوا کَاَلَّذِینَ قَالُوا : {لاَ تَسْمَعُوا لِہَذَا الْقُرْآنِ وَأَلْغَوْا فِیہِ لَعَلَّکُمْ تَغْلِبُونَ}۔","Sahih","Musannaf Ibn Abi Shaybah 31274","","","كتاب الأمراء"
"31275","(۳۱۲۷۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : قَالَ أَبُو جَعْفَرٍ مُحَمَّدُ بْنُ عَلِیٍّ : اللَّہُمَّ إنَّک تَعْلَمُ أَنِّی لَسْتُ لَہُمْ بِإِمَامٍ۔","","Musannaf Ibn Abi Shaybah 31275","","","كتاب الأمراء"
"31276","(۳۱۲۷۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا جَرِیرُ بْنُ حَازِمٍ ، قَالَ : حَدَّثَنِی شَیْخٌ مِنْ أَہْلِ الْکُوفَۃِ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ فِی أَیَّامِ ابْنِ الزُّبَیْرِ ، قَدْ دَخَلَ الْمَسْجِدَ فَإِذَا السِّلاَح ، فَجَعَلَ یَقُولُ : لَقَدْ أَعْظَمْتُمَ الدُّنْیَا ! حَتَّی اسْتَلَمَ الْحَجَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 31276","","","كتاب الأمراء"
"31277","(۳۱۲۷۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ طَلْحَۃَ ، قَالَ : حَدَّثَنَا إبْرَاہِیمُ بْنُ عَبْدِ الأَعْلَی الْجُعْفِیُّ ، قَالَ : أَرْسَلَ الْحَجَّاجُ إلَی سُوَیْد بْنِ غَفَلَۃَ فَقَالَ : لاَ تَؤُمَّ قَوْمَک ، وَإِذَا رَجَعْت فَاسْبِبْ عَلِیًّا ، قَالَ : قُلْتُ : سَمْع وَطَاعَۃً۔","","Musannaf Ibn Abi Shaybah 31277","","","كتاب الأمراء"
"31278","(۳۱۲۷۸) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، قَالَ : ذَکَرَ إبْرَاہِیمُ : أَنَّہُ أُرْسِلَ إلَیْہِ زَمَنَ الْمُخْتَارِ بْنِ أَبِی عُبَیْدٍ ، قَالَ : فَطَلاَ وَجْہَہُ بِطِلاَئٍ ، وَشَرِبَ دَوَائً ، فَلَمْ یَأْتِہِمْ فَتَرَکُوہُ۔","","Musannaf Ibn Abi Shaybah 31278","","","كتاب الأمراء"
"31279","(۳۱۲۷۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ زَکَرِیَّا ، عَنِ الْعَبَّاسِ بْنِ ذَرِیحٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَتَبَتْ عَائِشَۃُ إلَی مُعَاوِیَۃَ : أَمَّا بَعْدُ فَإِنَّہُ مَنْ یَعْمَلْ بِسَخَطِ اللہِ یُعَدُّ حَامِدُہُ مِنَ النَّاسِ ذَامًّا۔ (حمیدی ۲۶۶۔ ابن حبان ۲۷۷)","Sahih","Musannaf Ibn Abi Shaybah 31279","","","كتاب الأمراء"
"31280","(۳۱۲۸۰) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ حُجْرٌ بْنَ عَدِیٍّ وَہُوَ یَقُولُ : ہاہ ! بَیْعَتِی لاَ أَقِیلُہَا وَلاَ أَسْتَقِیلُہَا ، سَمَاعُ اللہِ وَالنَّاسِ۔ یَعْنِی بِقَوْلِہِ الْمُغِیرَۃَ۔","","Musannaf Ibn Abi Shaybah 31280","","","كتاب الأمراء"
"31281","(۳۱۲۸۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا قُطْبَۃُ بْنُ عَبْدِ الْعَزِیزِ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ : کَتَبَ أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَیْبَ عُثْمَانَ فَقَالُوا : مَنْ یَذْہَبُ بِہِ إلَیْہِ، فَقَالَ عَمَّارُ : أَنَا ، فَذَہَبَ بِہِ إلَیْہِ ، فَلَمَّا قَرَأَہُ قَالَ : أَرْغَمَ اللَّہُ بِأَنْفِکَ ، فَقَالَ عَمَّارُ : وَبِأَنْفِ أَبِی بَکْرٍ وَعُمَرَ ، قَالَ : فَقَامَ وَوَطِئَہُ حَتَّی غُشِیَ عَلَیْہِ ، قَالَ : وَکَانَ عَلَیْہِ تُبَّان۔n قَالَ : ثُمَّ بَعَثَ إلَیْہِ الزُّبَیْرِ وَطَلْحَۃَ فَقَالاَ لَہُ : اخْتَرْ إحْدَی ثَلاَثٍ : إمَّا أَنْ تَعْفُوَ ، وَإِمَّا أَنْ تَأْخُذَ الأَرْشَ ، وَإِمَّا أَنْ تَقْتَصَّ ، قَالَ : فَقَالَ عَمَّارُ : لاَ أَقْبَلُ مِنْہُنَّ شَیْئًا حَتَّی أَلْقَی اللَّہَ۔n قَالَ أَبُو بَکْرٍ : سَمِعْت یَحْیَی بْنَ آدَمَ ، قَالَ : ذَکَرْت ہَذَا الْحَدِیثَ لِحَسَنِ بْنِ صَالِحٍ ، فَقَالَ : مَا کَانَ عَلَی عُثْمَانَ أَکْثَرَ مِمَّا صَنَعَ۔","","Musannaf Ibn Abi Shaybah 31281","","","كتاب الأمراء"
"31282","(۳۱۲۸۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی حَیَّانَ ، عَنْ حَمَّادٍ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : إِنَّ الْکُتُب تَجِیئُ مِنْ قِبَلِ قُتَیْبَۃَ فِیہَا الْبَاطِلُ وَالْکَذِبُ ، فَإِذَا أَرَدْت أَنْ أُحَدِّثَ جَلِیسِی أَفْعَلُ ؟ قَالَ : لاَ بَلْ أَنْصِتْ۔","","Musannaf Ibn Abi Shaybah 31282","","","كتاب الأمراء"
"31283","(۳۱۲۸۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ إسْرَائِیلَ ، قَالَ : قَالَ رَجُلٌ لِعُثْمَانَ بْنِ أَبِی الْعَاصِ : ذَہَبْتُمْ بِالدُّنْیَا وَالآخِرَۃِ ، قَالَ : وَمَا ذَاکَ ؟ قَالَ : لَکُمْ أَمْوَالٌ تَصَدَّقُونَ مِنْہَا وَتَصِلُونَ مِنْہَا ، وَلَیْسَتْ لَنَا أَمْوَالٌ ، قَالَ : لَدِرْہَمٌ یَأْخُذُہُ أَحَدُکُمْ فَیَضَعُہُ فِی حَقٍّ أَفْضَلَ مِنْ عَشَرَۃِ آلاَفٍ یَأْخُذُہا أَحَدُنَا غَیضًا مِنْ فَیْضٍ فَلاَ یَجِدُ لَہَا مَسًّا۔","","Musannaf Ibn Abi Shaybah 31283","","","كتاب الأمراء"
"31284","(۳۱۲۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ یَحْیَی بْنِ الْحُصَیْنِ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ : کَانَ بَیْنَ خَالِدِ بْنِ الْوَلِیدِ وَبَیْنَ سَعْدٍ کَلاَمُ ، قَالَ : فَتَنَاوَلَ رَجُلٌ خَالِدًا عِنْد سَعْدٍ ، فَقَالَ سَعْدٌ : مَہْ ، إنَّ مَا بَیْنَنَا لَمْ یَبْلُغْ دِینَنَا۔","Sahih","Musannaf Ibn Abi Shaybah 31284","","","كتاب الأمراء"
"31285","(۳۱۲۸۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، قَالَ : حدَّثَنِی مَنْ سَمِعَ سَالِمًا ، قَالَ : کَانَ عُمَرُ إذَا نَہَی النَّاسَ عَنْ شَیْئٍ جَمَعَ أَہْلَ بَیْتِہِ ، فَقَالَ : إنِّی نَہَیْت النَّاسَ عَنْ کَذَا وَکَذَا ، وَإنَّ النَّاسَ لَیَنْظُرُونَ إلَیْکُمْ نَظَرَ الطَّیْرِ إلَی اللَّحْمِ ، وَایْمُ اللہِ لاَ أَجِدُ أَحَدًا مِنْکُمْ فَعَلَہُ إلاَّ أَضْعَفْتُ لَہُ الْعُقُوبَۃَ ضِعْفَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 31285","","","كتاب الأمراء"
"31286","(۳۱۲۸۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الصَّبَاحِ بْنِ ثَابِتٍ ، قَالَ : کَانَ أَبِی یَسْمَعُ الْخَادِمَ تَسُبُّ الشَّاۃَ ، فَیَقُولُ : تَسُبِّینَ شَاۃً تَشْرَبِینَ مِنْ لَبَنِہَا۔","","Musannaf Ibn Abi Shaybah 31286","","","كتاب الأمراء"
"31287","(۳۱۲۸۷) حَدَّثَنَا مَرْحُومُ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ مَالِکِ بْنِ دِینَارٍ سَمِعَہُ یَقُولُ : قَالَ سَالِمُ بْنُ عَبْدِ اللہِ : قَالَ لِی عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : اکْتُبْ إلَیَّ بِسُنَّۃِ عُمَرَ ، قَالَ : قُلْتُ : إنَّک إنْ عَمِلْت بِمَا عَمِلَ عُمَرُ فَأَنْتَ أَفْضَلُ مِنْ عُمَرَ ، إِنَّہُ لَیْسَ لَکَ مِثْلُ زَمَانِ عُمَرَ ، وَلاَ رِجَالٌ مِثْلُ رِجَالِ عُمَرَ۔","","Musannaf Ibn Abi Shaybah 31287","","","كتاب الأمراء"
"31288","(۳۱۲۸۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عُثْمَانَ بْنِ وَاقِدٍ عَمَّنْ حَدَّثَہُ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ وَہُوَ سَاجِدٌ فِی الْکَعْبَۃِ نَحْوَ الْحَجَرِ وَہُوَ یَقُولُ : إنِّی أَعُوذُ بِکَ مِنْ شَرِّ مَا تَسَوِّطُ۔","Da'if","Musannaf Ibn Abi Shaybah 31288","","","كتاب الأمراء"
"31289","(۳۱۲۸۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنِی عَبْدُ اللہِ بْنُ الْوَلِیدِ ، قَالَ : أَخْبَرَنِی عُمَرُ بْنُ أَیُّوبَ ، قَالَ : أَخْبَرَنِی أَبُو إیَاسٍ مُعَاوِیَۃُ بْنُ قُرَّۃَ ، قَالَ : کُنْتُ نَازِلاً عِنْدَ عَمْرِو بْنِ النُّعْمَانِ بْنِ مُقَرِّنٍ ، فَلَمَّا حضَرَ رَمَضَانُ ، جَائَہُ رَجُلٌ بِأَلْفَیْ دِرْہَمٍ مِنْ قِبَلِ مُصْعَبِ بْنِ الزُّبَیْرِ ، فَقَالَ : إنَّ الأَمِیرَ یُقْرِئُک السَّلاَمَ وَیَقُولُ : إنَّا لَمْ نَدَعْ قَارِئًا شَرِیفًا إلاَّ وَقَدْ وَصَلَ إلَیْہِ مِنَّا مَعْرُوفٌ ، فَاسْتَعِنْ بِہَذَیْنِ عَلَی نَفَقَۃِ شَہْرِکَ ہَذَا ، فَقَالَ عَمْرٌو : اقْرَأْ عَلَی الأَمِیرِ السَّلاَمَ ، وَقُلْ لَہُ : إنَّا وَاللہِ مَا قَرَأْنَا الْقُرْآنَ نُرِیدُ بِہِ الدُّنْیَا ، وَرَدَّہُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 31289","","","كتاب الأمراء"
"31290","(۳۱۲۹۰) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَاصِمِ بْنِ مُحَمَّدٍ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، قَالَ : بَیْنَا أَنَا جَالِسٌ فِی الْمَسْجِدِ الْحَرَامِ ، وَابْنُ عُمَرَ جَالِسٌ فِی نَاحِیَۃٍ وَابْنَاہُ عَنْ یَمِینِہِ وَشِمَالِہِ ، وَقَدْ خَطَبَ الْحَجَّاجُ بْنُ یُوسُفَ النَّاسَ ، فَقَالَ : أَلاَ إنَّ ابْنَ الزُّبَیْرِ نَکَّسَ کِتَابَ اللہِ ، نَکَّسَ اللَّہُ قَلْبَہُ ، فَقَالَ ابْنُ عُمَرَ : أَلاَ إنَّ ذَلِکَ لَیْسَ بِیَدِکَ ، وَلاَ بِیَدِہِ ، فَسَکَتَ الْحَجَّاجُ ہُنَیْہَۃً - إنْ شِئْتَ قُلْتَ طَوِیلاً ، وَإِنْ شِئْتَ قُلْتُ لَیْسَ بِطَوِیلٍ - ، ثُمَّ قَالَ : أَلاَ إنَّ اللَّہَ قَدْ عَلَّمَنَا وَکُلَّ مُسْلِمٍ وَإِیَّاکَ أَیُّہَا الشَّیْخُ ، أَنَّہُ ہُوَ نفعک ، قَالَ : فَجَعَلَ ابْنُ عُمَرَ یَضْحَکُ وَقَالَ لِمَنْ حَوْلَہُ : أَمَّا إنِّی قَدْ تَرَکْت الَّتِی فِیہَا الْفَضْلُ : أَنْ أَقُولَ : کَذَبْتَ۔","Sahih","Musannaf Ibn Abi Shaybah 31290","","","كتاب الأمراء"
"31291","(۳۱۲۹۱) حَدَّثَنَا مالک بن إسْمَاعِیلَ ، عَنْ کَامِلِ بْنِ حَبِیبٍ ، قَالَ : کَانَ الْعَبَّاسُ أَقْرَبَ شَحْمَۃِ أذَنٍ إلَی السَّمَائِ۔","","Musannaf Ibn Abi Shaybah 31291","","","كتاب الأمراء"
"31292","(۳۱۲۹۲) حَدَّثَنَا قَبِیصَۃُ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنِ الْوَلِیدِ بْنِ الْعَیْزَارِ ، قَالَ : بَیْنَمَا عَمْرُو بْنُ الْعَاصِ فِی ظِلِّ الْکَعْبَۃِ ، إذْ رَأَی الْحُسَیْنَ بْن عَلِیٍّ مُقْبِلاً ، فَقَالَ : ہَذَا أَحَبُّ أَہْلِ الأَرْضِ إلَی أَہْلِ السَّمَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 31292","","","كتاب الأمراء"
"31293","(۳۱۲۹۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ أَیْمَنَ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ جُبَیْرٍ : إنَّک قَادِمٌ عَلَی الْحَجَّاجِ فَانْظُرْ مَإِذَا تَقُولُ ، لاَ تَقُلْ مَا یَسْتَحِلُّ بِہِ دَمَک ، قَالَ : إنَّمَا یَسْأَلُنِی کَافِرٌ أَنَا أَوْ مُؤْمِنٌ ؟ فَلَمْ أَکُنْ لأَشْہَدَ عَلَی نَفْسِی بِالْکُفْرِ وَأَنَا لاَ أَدْرِی أَنْجُو مِنْہُ أَمْ لاَ۔","","Musannaf Ibn Abi Shaybah 31293","","","كتاب الأمراء"
"31294","(۳۱۲۹۴) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنِ النُّعْمَانِ ، قَالَ : کَتَبَ عُمَرُ إلَی مُعَاوِیَۃَ : الْزَمِ الْحَقَّ یَلْزَمْک الْحَقُّ۔","","Musannaf Ibn Abi Shaybah 31294","","","كتاب الأمراء"
"31295","(۳۱۲۹۵) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُبَیْدٍ ، قَالَ : قَالَ عُمَرُ : نَسْتَعِینُ بِقُوَّۃِ الْمُنَافِقِ وَإِثْمُہُ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 31295","","","كتاب الأمراء"
"31296","(۳۱۲۹۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ ابْنِ شُبْرُمَۃَ ، قَالَ : سَمِعْتُ الْفَرَزْدَقَ یَقُولُ : کَانَ ابْنُ حِطَّانَ مِنْ أَشْعَرِ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 31296","","","كتاب الأمراء"
"31297","(۳۱۲۹۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، قَالَ : کُنْتُ إذَا لَقِیت عُبَیْد اللہِ بْنَ عَبْدِ اللہِ فَکَأَنَّمَا أُفَجِّرُ بِہِ بَحْرًا۔","","Musannaf Ibn Abi Shaybah 31297","","","كتاب الأمراء"
"31298","(۳۱۲۹۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حَمْزَۃَ أَبِی عُمَارَۃَ ، قَالَ : قَالَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ لِعُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ : مَالَک وَلِلشِّعْرِ ، قَالَ : ہَلْ یَسْتَطِیعُ الْمَصْدُورُ إلاَّ أَنْ یَنْفِثَ۔","","Musannaf Ibn Abi Shaybah 31298","","","كتاب الأمراء"
"31299","(۳۱۲۹۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سُلَیْمُ بْنُ أَخْضَرَ ، قَالَ : حَدَّثَنَا ابْنُ عَوْنٍ ، قَالَ : کَانَ مُسْلِمُ بْنُ یَسَارٍ أَرْفَعَ عِنْدَ أَہْلِ الْبَصْرَۃِ مِنَ الْحَسَنِ ، حَتَّی خَفَّ مَعَ ابْنِ الأَشْعَثِ وَکَفُّ الآخَرُ ، فَلَمْ یَزَلْ أَبُو سَعِیدٍ فِی عُلوّ مِنْہَا وَسَقَطَ الآخَرُ۔","","Musannaf Ibn Abi Shaybah 31299","","","كتاب الأمراء"
"31300","(۳۱۳۰۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنِی عَبْدُ الرَّحْمَنِ بْنُ ثَوْبَان ، قَالَ : أَخْبَرَنِی عُمَیْرُ بْنُ ہَانِئٍ ، قَالَ : أَخْبَرَنِی مُنْقِذٌ صَاحِبُ الْحَجَّاجِ : أَنَّ الْحَجَّاجَ لَمَّا قَتَلَ سَعِیدَ بْنَ جُبَیْرٍ مَکَثَ ثَلاَثَ لَیَالٍ یَقُولُ : مَالِی وَلِسَعِیدِ بْنِ جُبَیْرٍ۔","","Musannaf Ibn Abi Shaybah 31300","","","كتاب الأمراء"
"31301","(۳۱۳۰۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ الْمُرَادِیِّ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، قَالَ : بَیْنَا شَاعِرٌ یَوْمَ صِفِّینَ یُنْشِدُ ہِجَائً لِمُعَاوِیَۃَ وَعَمْرِو بْنِ الْعَاصِ ، قَالَ : وَعَمَّارٌ یَقُولُ : الْزَق بِالْعَجُوزَیْنِ ، قَالَ : فَقَالَ رَجُلٌ : سُبْحَانَ اللہِ ، تَقُولُ ہَذَا وَأَنْتُمْ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ لَہُ عَمَّارٌ : إنْ شِئْت أَنْ تَجْلِسَ فَاجْلِسْ ، وَإِنْ شِئْت أَنْ تَذْہَبَ فَاذْہَبْ۔","Hasan","Musannaf Ibn Abi Shaybah 31301","","","كتاب الأمراء"
"31302","(۳۱۳۰۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حَبِیبٍ بْنِ الشَّہِیدِ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : کَانَ ابْنُ عُمَرَ یَقُولُ : رَحِمَ اللَّہُ ابْنَ الزُّبَیْرِ ، أَرَادَ دَنَانِیرَ الشَّامِ ، رَحِمَ اللَّہُ مَرْوَانَ أَرَادَ دَرَاہِمَ الْعِرَاقِ۔","Sahih","Musannaf Ibn Abi Shaybah 31302","","","كتاب الأمراء"
"31303","(۳۱۳۰۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَتَبَ زِیَادٌ إلَی الْحَکَمِ بْنِ عَمْرٍو الْغِفَارِیِّ وَہُوَ عَلَی خُرَاسَانَ: إِنَّ أَمِیرَ الْمُؤْمِنِینَ کَتَبَ: أَنْ تُصْطَفَی لَہُ الصَّفْرَائُ وَالْبَیْضَائُ ، فَلاَ یُقَسَّمُ بَیْنَ النَّاسِ ذَہَبًا وَلاَ فِضَّۃً، فَکَتَبَ إلَیْہِ: بَلَغَنِی کِتَابُک، تَذْکُرُ أَنَّ أَمِیرَ الْمُؤْمِنِینَ کَتَبَ أَنْ تُصْطَفَی لَہُ الْبَیْضَائُ وَالصَّفْرَائُ، وَأَنِّی وَجَدْت کِتَابَ اللہِ قَبْلَ کِتَابِ أَمِیرِ الْمُؤْمِنِینَ ، وَإِنَّہُ وَاللہِ لَوْ أَنَّ السَّمَاوَاتِ وَالأَرْضَ کَانَتَا رَتْقًا عَلَی عَبْدٍ ثُمَّ اتَّقَی اللَّہَ جَعَلَ اللَّہُ لَہُ مَخْرَجًا ، وَالسَّلاَمُ عَلَیْکُمْ ، ثُمَّ قَالَ لِلنَّاسِ : اغْدُوَا عَلَیَّ بِمَالِکُمْ ، فَغَدَوْا ، فَقَسمَہُ بَیْنَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 31303","","","كتاب الأمراء"
"31304","(۳۱۳۰۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عُمَرَ بْنِ عَلِیٍّ ، قَالَ : قَالَ عَلِیٌّ : مَا زَالُ الزُّبَیْرِ کَأَنَّہُ رَجُلٌ مِنَّا أَہْلَ الْبَیْتِ حَتَّی أَدْرَکَ بُنَیَّہُ عَبْدُ اللہِ فَلَفَتَہُ عَنَّا۔","","Musannaf Ibn Abi Shaybah 31304","","","كتاب الأمراء"
"31305","(۳۱۳۰۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی شُرَاعَۃَ ، عَنْ عُبَادَۃَ بْنِ نُسَیٍّ ، قَالَ : ذَکَرُوا الشُّعَرَاء عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرُوا امْرَأَ الْقِیسِ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَذْکُورٌ فِی الدُّنْیَا مَذْکُورٌ فِی الآخِرَۃِ: حَامِلٌ لِوَائَ الشِّعْرِ یَوْمَ الْقِیَامَۃِ فِی جَہَنَّمَ ، أَو قَالَ فِی النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 31305","","","كتاب الأمراء"
"31306","(۳۱۳۰۶) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُنَیْدَۃَ بْنِ خَالِدٍ الْخُزَاعِیِّ ، قَالَ : أَوَّلُ رَأْسٍ أُہْدِیَ فِی الإسْلاَمِ : رَأْسُ ابْنِ الْحَمِق۔","","Musannaf Ibn Abi Shaybah 31306","","","كتاب الأمراء"
"31307","(۳۱۳۰۷) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی الْجُوَیْرِیَۃِ الْجَرْمِیِّ ، قَالَ : کُنْتُ فِیمَنْ صَارَ إلَی أَہْلِ الشَّامِ یَوْمَ الْخَازِرِ ، فَالْتَقَیْنَا ، فَہَبَّ الرِّیحُ عَلَیْہِمْ ، فَأَدْبَرُوا ، فَقَتَلْنَاہُمْ عَشِیَّتَنَا وَلَیْلَتَنَا حَتَّی أَصْبَحْنَا ، قَالَ : فَقَالَ : إبْرَاہِیمُ۔ یَعْنِی : ابْنَ الأَشْتَرِ : إِنِّی قَتَلْت الْبَارِحَۃَ رَجُلاً وَإِنِّی وَجَدْت مِنْہُ رِیحَ طِیبٍ ، وَمَا أُرَاہُ إلاَّ ابْنَ مَرْجَانَۃَ ، شَرَّقَتْ رِجْلاَہُ وَغَرَّبَ رَأْسُہُ ، أَوْ شَرَّقَ رَأْسُہُ وَغَرَّبَتْ رِجْلاَہُ ، قَالَ : فَانْطَلَقْت فَإِذَا ہُوَ وَاللہِ ہُوَ۔","","Musannaf Ibn Abi Shaybah 31307","","","كتاب الأمراء"
"31308","(۳۱۳۰۸) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنِی الْعَلاَئُ بْنُ الْمِنْہَالِ الْغَنَوِیُّ ، قَالَ : حَدَّثَنِی أَبُو الْجَہْمِ الْقُرَشِیُّ ، عَنْ أَبِیہِ ، قَالَ : بَلَغَ عَلِیًّا عَنِّی شَیْئٌ فَضَرَبَنِی أَسْوَاطًا ، ثُمَّ بَلَغَہُ بَعْدَ ذَلِکَ أَنَّ مُعَاوِیَۃَ کَتَبَ إلَیْہِ ، فَأَرْسَلِ رَجُلَیْنِ یُفَتِّشَانِ مَنْزِلَہُ ، فَوَجَدَا الْکِتَابَ فِی مَنْزِلِہِ ، فَقَالَ لأَحَدِ الرَّجُلَیْنِ وَہُوَ مِنْ الْعَشِیرَۃِ : إنَّک مِنَ الْعَشِیرَۃِ فَاسْتُرْ عَلَیَّ ، قَالَ : فَأَتَیَا عَلِیًّا فَأَخْبَرَاہُ ، قَالَ : فَرَکِبَ عَلِیٌّ وَرَکِبَ أَبِی ، فَقَالَ لأَبِی : أَمَا إنَّا فَتَّشْنَا عَلَیْہِ ذَلِکَ فَوَجَدْنَاہُ بَاطِلاً ، قَالَ : مَا ضَرَبَنِی فِیہِ أَبْطَلُ۔","Da'if","Musannaf Ibn Abi Shaybah 31308","","","كتاب الأمراء"
"31309","(۳۱۳۰۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، حَدَّثَنَا شَیْبَانُ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، قَالَ : حدَّثَنِی مَنْ سَمِعَ عُمَرَ یَقُولُ إذَا رَأَی الْمُغِیرَۃَ بْنَ شُعْبَۃَ : وَیْحَک یَا مُغِیرَۃُ ، وَاللہِ مَا رَأَیْتُک قَطُّ إلاَّ خَشِیت۔","Da'if","Musannaf Ibn Abi Shaybah 31309","","","كتاب الأمراء"
"31310","(۳۱۳۱۰) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا شَیْبَانُ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ بْنِ سِنَانٍ ، قَالَ : خَرَجَ إلَیْنَا ابْنُ مَسْعُودٍ وَنَحْنُ فِی الْمَسْجِدِ ، فَقَالَ : یَا أَہْلَ الْکُوفَۃِ فُقِدَت مِنْ بَیْتِ مَالِکُمُ اللَّیْلَۃَ مِئَۃَ أَلْفٍ لَمْ یَأْتِنِی بِہَا کِتَابٌ مِنْ أَمِیرِ الْمُؤْمِنِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 31310","","","كتاب الأمراء"
"31311","(۳۱۳۱۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا فِطْرٌ ، قَالَ : حَدَّثَنَا مُنْذِرٌ الثَّوْرِیُّ ، عَنْ مُحَمَّدِ بْنِ عَلِیِّ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : اتَّقُوا ہَذِہِ الْفِتَنَ فَإِنَّہُ لاَ یُشْرِفُ لَہَا أَحَدٌ إلاَّ انْتَسَفَتْہُ ، أَلاَ إنَّ ہَؤُلاَئِ الْقَوْمَ لَہُمْ أَجَلٌ وَمُدَّۃٌ ، لَوْ أَجْمَعَ مَنْ فِی الأَرْضِ أَنْ یُزِیلُوا مُلْکَہُمْ لَمْ یَقْدِرُوا عَلَی ذَلِکَ حَتَّی یَکُونَ اللَّہُ ہُوَ الَّذِی یَأْذَنُ فِیہِ ، أَتَسْتَطِیعُونَ أَنْ تُزِیلُوا ہَذِہِ الْجِبَالَ ؟!۔","","Musannaf Ibn Abi Shaybah 31311","","","كتاب الأمراء"
"31312","(۳۱۳۱۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا مِسْعَرٌ ، حَدَّثَنِی أَبُو بَکْرِ بْنُ عَمْرِو بْنِ عُتْبَۃَ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : بَعَثَنِی سَعْدٌ أَقْسِمُ بَیْنَ الزُّبَیْرِ وَخَبَّابٍ أَرْضًا ، فَتَرَامَیَا بِالْجَنْدَلِ ، فَرَجَعْت فَأَخْبَرْت سَعْدًا ذَلِکَ ، فَضَحِکَ حَتَّی ضَرَبَ بِرِجْلِہِ ، وَقَالَ : فِی الأَرْضِ مِثْلُ ہَذَا الْمَسْجِدِ ، أَو قلََّ مَا یَزِیدُ عَلَیْہِ ، قَالَ : فَہَلا رَدَدْتہمَا۔","Da'if","Musannaf Ibn Abi Shaybah 31312","","","كتاب الأمراء"
"31313","(۳۱۳۱۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا مِسْعَرٌ ، حَدَّثَنَا سَعِیدُ بْنُ شَیْبَانَ ، عَمَّنْ حَدَّثَہُ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ قُدِّمَ إلَیْہِ لَحْمُ جَدَاوِلاً ، فَقَالَ : انْہشُوا نَہْشًا۔","Da'if","Musannaf Ibn Abi Shaybah 31313","","","كتاب الأمراء"
"31314","(۳۱۳۱۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَمَّا بُویِعَ لِعَلِیٍّ أَتَانِی فَقَالَ : إنَّک امْرُؤٌ مُحَبَّبٌ فِی أَہْلِ الشَّام ، وَقَدِ اسْتَعْمَلْتُک عَلَیْہِمْ ، فَسِرْ إلَیْہِمْ ، قَالَ : فَذَکَرْت الْقَرَابَۃَ وَذَکَرْت الصِّہْر ، فَقُلْتُ : أَمَّا بَعْدُ فَوَاللہِ لاَ أُبَایِعُک ، قَالَ : فَتَرَکَنِی وَخَرَجَ ، فَلَمَّا کَانَ بَعْدَ ذَلِکَ جَائَ ابْنُ عُمَرَ إلَی أُمِّ کُلْثُومٍ فَسَلَّمَ عَلَیْہَا وَتَوَجَّہَ إلَی مَکَّۃَ ، فَأُتِیَ عَلِیٌّ رحمہ اللہ فَقِیلَ لَہُ : إنَّ ابْنَ عُمَرَ قَدْ تَوَجَّہَ إلَی الشَّامِ ، فَاسْتَنْفِرَ النَّاسَ ، قَالَ : فَإِنْ کَانَ الرَّجُلُ لَیَعْجَلُ حَتَّی یُلْقِیَ رِدَائَہُ فِی عُنُقِ بَعِیرِہِ ، قَالَ : وَأَتَیْت أُمَّ کُلْثُومٍ فَأُخْبِرَتْ ، فَأَرْسَلتْ إلَی أَبِیہَا : مَا ہَذَا الَّذِی تَصْنَعُ ، قَدْ جَائَنِی الرَّجُلُ فَسَلَّمَ عَلَیَّ ، وَتَوَجَّہَ إلَی مَکَّۃَ ، فَتَرَاجَعَ النَّاسُ۔","Sahih","Musannaf Ibn Abi Shaybah 31314","","","كتاب الأمراء"
"31315","(۳۱۳۱۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ دَاوُدَ بْنِ شَابُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کُنَّا نَفْخَرُ عَلَی النَّاسِ بِأَرْبَعَۃٍ : بِفَقِیہِنَا وَقَاصِّنَا وَمُؤَذِّنِنَا وَقَارِئِنَا ، فَفَقِیہُنَا : ابْنُ عَبَّاسٍ ، وَمُؤَذِّنُنَا : أَبُو مَحْذُورَۃَ ، وَقَاصُّنَا : عُبَیْدُ بْنُ عُمَیْرٍ ، وَقَارِئُنَا : عَبْدُ اللہِ بْنُ السَّائِبِ۔","","Musannaf Ibn Abi Shaybah 31315","","","كتاب الأمراء"
"31316","(۳۱۳۱۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ دَاوُدَ بْنِ شَابُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لَمَّا أَجْمَعَ ابْنُ الزُّبَیْرِ عَلَی ہَدْمِہَا ، خَرَجْنَا إلَی مِنًی ، نَنْتَظِرُ الْعَذَابَ ، یَعْنِی ہَدْمَ الْکَعْبَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 31316","","","كتاب الأمراء"
"31317","(۳۱۳۱۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَنْصُورٍ بْنِ صَفِیَّۃَ ، عَنْ أُمِّہِ ، قَالَتْ : دَخَلَ ابْنُ عُمَرَ الْمَسْجِدَ ، وَابْنُ الزُّبَیْرِ مَصْلُوبٌ ، فَقَالُوا لَہُ : ہَذِہِ أَسْمَائُ ، فَأَتَاہَا فَذَکَّرَہَا وَوَعَظَہَا ، وَقَالَ : إنَّ الْجُثَّۃُ لَیْسَتْ بِشَیْئٍ ، وَإِنَّمَا الأَرْوَاحُ عِنْدَ اللہِ ، فَاصْبِرِی وَاحْتَسِبِی ، فَقَالَتْ : مَا یَمْنَعُنِی مِنَ الصَّبْرِ ، وَقَدْ أُہْدِیَ رَأْسُ یَحْیَی بْنُ زَکَرِیَّا إلَی بَغِیٍّ مِنْ بَغَایَا بَنِی إسْرَائِیلَ۔","Sahih","Musannaf Ibn Abi Shaybah 31317","","","كتاب الأمراء"
"31318","(۳۱۳۱۸) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : أَتَیْتُ أَسْمَائَ بَعْدَ قَتْلِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ فَقَالَتْ : بَلَغَنِی أَنَّہُمْ صَلَبُوا عَبْدَ اللہِ مُنَکَّسًا وَعَلَّقُوا مَعَہُ الْہِرَّۃَ ، وَاللہِ لَوَدِدْت أَنِّی لاَ أَمُوتُ حَتَّی یُدْفَعَ إلَیَّ فَأُغَسِّلَہُ وَأُحَنِّطَہُ وَأُکَفِّنَہُ ، ثُمَّ أَدْفِنَہُ ، فَمَا لَبِثُوا أَنْ جَائَہُ کِتَابُ عَبْدِ الْمَلِکِ أَنْ یُدْفَعَ إلَی أَہْلِہِ ، قَالَ : فَأُتِیَتْ بِہِ أَسْمَائَ فَغَسَّلَتْہُ وَحَنَّطَتْہُ وَکَفَّنَتْہُ ، ثُمَّ دَفَنَتْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31318","","","كتاب الأمراء"
"31319","(۳۱۳۱۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، قَالَ : دَخَلْت أَنَا وَعَبْدُ اللہِ بْنُ الزُّبَیْرِ عَلَی أَسْمَائَ قَبْلَ قَتْلِ عَبْدِ اللہِ بِعَشْرِ لَیَالٍ ، وَأَسْمَائُ وَجِعَۃٌ ، فَقَالَ لَہَا عَبْدُ اللہِ : کَیْفَ تَجِدِینَک ، قَالَتْ : وَجِعَۃً ، قَالَ : إنَّ فِی الْمَوْتِ لَعَافِیَۃً ، قَالَتْ : لَعَلَّکَ تشمتُ بِمَوْتِی فَلِذَلِکَ تَتَمَنَّاہُ ؟ فَلاَ تَفْعَلْ ، فَوَاللہِ مَا أَشْتَہِی أَنْ أَمُوتَ حَتَّی یَأْتِیَ عَلَیَّ أَحَد طَرفَیْک ، إمَّا أَنْ تُقْتَلَ فَأَحْتَسِبَک ، وَإِمَّا تَظْہَرَ فَتَقَرُّ عَیْنِی ، فَإِیَّاکَ أَنْ تُعْرَضَ عَلَیْک خِطَّۃ لاَ تُوَافِقُک ، فَتَقْبَلُہَا کَرَاہَۃَ الْمَوْتِ ، قَالَ : وَإِنَّمَا عَنَی ابْنُ الزُّبَیْرِ لَیُقْتَل فَیُحْزِنُہَا ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 31319","","","كتاب الأمراء"
"31320","(۳۱۳۲۰) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ أَبِیہِ ، قَالَ : أَخْبَرَنِی أَبِی : أَنَّ الْحَجَّاجَ حِینَ قَتَلَ ابْنَ الزُّبَیْرِ جَائَ بِہِ إلَی مِنًی فَصَلَبَہُ عِنْدَ الثَّنِیَّۃِ فِی بَطْنِ الْوَادِی ، ثُمَّ قَالَ لِلنَّاسِ : انْظُرُوا إلَی ہَذَا ! ہَذَا شَرِّ الأُمَّۃِ ، فَقَالَ : إنِّی رَأَیْت ابْنَ عُمَرَ جَائَ عَلَی بَغْلَۃٍ لَہُ فَذَہَبَ لِیُدْنِیَہَا مِنَ الْجِذْعِ فَجَعَلَتْ تَنْفِرُ ، فَقَالَ لِمَوْلاَہُ : وَیْحَک خُذْ بِلِجَامِہَا فَأَدْنِہَا ، قَالَ : فَرَأَیْتہ أَدْنَاہَا فَوَقَفَ عَبْدُ اللہِ بْنُ عُمَرَ وَہُوَ یَقُولُ : رَحِمَک اللَّہُ ، إنْ کُنْت لَصَوَّامًا قَوَّامًا ، وَلَقَدْ أَفْلَحَتْ أُمَّۃٌ أَنْتَ شَرُّہَا۔","Da'if","Musannaf Ibn Abi Shaybah 31320","","","كتاب الأمراء"
"31321","(۳۱۳۲۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَمِرٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، قَالَ : حدَّثَنِی الْبَرِیدُ الَّذِی جَائَ بِرَأْسِ الْمُخْتَارِ إلَی عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، قَالَ : فَلَمَّا وَضَعْتہُ بَیْنَ یَدَیْہِ ، قَالَ : مَا حَدَّثَنِی کَعْبٌ بِحَدِیثٍ إلاَّ رَأَیْت مِصْدَاقَہُ غَیْرَ ہَذَا ، فَإِنَّہُ حَدَّثَنِی أَنَّہُ یَقْتُلُنِی رَجُلٌ مِنْ ثَقِیفٍ ، أُرَانِی أَنَا الَّذِی قَتَلْتہ۔","Da'if","Musannaf Ibn Abi Shaybah 31321","","","كتاب الأمراء"
"31322","(۳۱۳۲۲) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَنْ أَبِیہِ یَعْلَی بْنِ حَرْمَلَۃَ ، قَالَ : تَکَلَّمَ الْحَجَّاجُ یَوْمَ عَرَفَۃَ بِعَرَفَاتٍ فَأَطَالَ الْکَلاَمُ ، فَقَالَ عَبْدُ اللہِ بْنُ عُمَرَ : أَلاَ إِنَّ الْیَوْمَ یَوْمُ ذِکْرٍ ، قَالَ : فَمَضَی الْحَجَّاجُ فِی خُطْبَتِہِ ، قَالَ : فَأَعَادَہَا عَبْدُ اللہِ مَرَّتَیْنِ ، أَوْ ثَلاَثًا ، ثُمَّ قَالَ : یَا نَافِعُ نَادِ بِالصَّلاَۃِ ، فَنَزَلَ الْحَجَّاجُ۔","Da'if","Musannaf Ibn Abi Shaybah 31322","","","كتاب الأمراء"
"31323","(۳۱۳۲۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ أَخْبَرَنَا قَیْسٌ ، قَالَ : قَالَ عُمَرُ : أَلاَ تُخْبِرانِی عَنْ منْزِلَیکُمْ ہَذَیْنِ ، وَمَعَ ہَذَا إنِّی لأَسْأَلُکُمَا ، وَإِنِّی لأَتَبَیَّنُ فِی وُجُوہِکُمَا أَیُّ الْمَنْزِلَیْنِ خَیْرٌ ، قَالَ : فَقَالَ لَہُ جَرِیرٌ : أَنَا أُخْبِرُک یَا أَمِیرَ الْمُؤْمِنِینَ ، أَمَّا إحْدَی الْمَنْزِلَتَیْنِ : فَأَدْنَی نَخْلَۃٍ بِالسَّوَادِ إلَی أَرْضِ الْعَرَبِ ، وَأَمَّا الْمَنْزِلُ الآ خَرُ : فَأَرْضُ فَارِسٍ ، وَعْکُہَا وَحَرُّہَا وَبَقُّہَا۔ یَعْنِی : الْمَدَائِنَ ، قَالَ : فَکَذَّبَنِی عَمَّارٌ ، فَقَالَ : کَذَبْت ، فَقَالَ عُمَرُ : أَنْتَ أَکْذَبُ ، ثُمَّ قَالَ عُمَرُ : أَلاَ تُخْبِرُونِی عَنْ أَمِیرِکُمْ ہَذَا أَمُجْزِیئٌ ہُوَ ؟ قُلْتُ : وَاللہِ مَا ہُوَ بِمُجْزِیئٍ وَلاَ کَافٍ وَلاَ عَالِمٌ بِالسِّیَاسَۃِ ، فَعَزَلَہُ وَبَعَثَ الْمُغِیرَۃَ بْنَ شُعْبَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 31323","","","كتاب الأمراء"
"31324","(۳۱۳۲۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنْ قَیْسٍ ، قَالَ : کَانَ بَیْنَ ابْنِ مَسْعُودٍ وَالْوَلِیدِ بْنِ عُقْبَۃَ حَسَنٌ ، قَالَ : فَدَعَا عَلَیْہِمَا سَعْدٌ ، فَقَالَ : اللَّہُمَّ أَمِسَّ بَیْنَہُمَا ، فَکَانَ أَحَدُہُمَا یَقُولُ لِصَاحِبِہِ : لَقَدْ أُجِیبَ فِینَا سَعْدٌ۔","Sahih","Musannaf Ibn Abi Shaybah 31324","","","كتاب الأمراء"
"31325","(۳۱۳۲۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوسٍ ، قَالَ : ذَکَرْت الأُمَرَائَ عِنْدَ ابْنِ عَبَّاسٍ ، فَابْتَرَک فِیہِمْ رَجُلٌ فَتَطَاوَلَ حَتَّی مَا أَرَی فِی الْبَیْتِ أَطْوَلَ مِنْہُ ، فَسَمِعْت ابْنَ عَبَّاسٍ یَقُولُ : یَا ہَزَہَازُ ، لاَ تَجْعَلْ نَفْسَک فِتْنَۃً لِلظَّالِمِینَ ، فَتَقَاصَرَ حَتَّی مَا رَأَیْت فِی الْقَوْمِ أَقْصَرَ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31325","","","كتاب الأمراء"
"31326","(۳۱۳۲۶) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الأَسَدِیُّ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ الْمُہَلَّبِ أَبُو کُدَیْنَۃَ ، عَنِ الأَعْمَشِ ، قَالَ : ذَکَرُوا عِنْدَ ابْنِ عُمَرَ الْخُلَفَائَ وَحُبَّ النَّاسُ تَغْیِیرَہُمْ ، فَقَالَ ابْنُ عُمَرَ : لَوْ وَلِیَ النَّاسَ صَاحِبُ ہَذِہِ السَّارِیَۃِ مَا رَضُوا بِہِ۔ یَعْنِی : عَبْدَ الْمَلِکِ بْنَ مَرْوَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 31326","","","كتاب الأمراء"
"31327","(۳۱۳۲۷) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الأَسَدِیُّ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی الْجَحَّافِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ عَلِیٍّ ، قَالَ: إنَّ حُمَۃً کَحُمَۃِ الْعَقْرَبِ ، فَإِذَا کَانَ ذَلِکَ فَالْحَقُوا بِعَمَّتِکُمُ النَّخْلَۃِ۔ یَعْنِی: السَّوَادَ۔","Da'if","Musannaf Ibn Abi Shaybah 31327","","","كتاب الأمراء"
"31328","(۳۱۳۲۸) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ، قَالَ: حدَّثَنَا شَرِیکٌ، عَنْ دَاوُدَ، عَنْ رَجُلٍ، عَنْ عَلِیٍّ: أَنَّہُ قَالَ: سَتَکُونُ عَکَرَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 31328","","","كتاب الأمراء"
"31329","(۳۱۳۲۹) حَدَّثَنَا مُحَمَّدُ بْنُ کُنَاسَۃَ ، قَالَ : حدَّثَنَا إِسْحَاقُ بْنُ سَعِیدٍ ، عَنْ أَبِیہِ ، قَالَ : أَتَی مُصْعَبُ بْنُ الزُّبَیْرِ عَبْدَ اللہِ بْنَ عُمَرَ وَہُوَ یَطُوفُ بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، فَقَالَ : مَنْ أَنْتَ ؟ فَقَالَ : ابْنُ أَخِیک مُصْعَبُ بْنُ الزُّبَیْرِ ، قَالَ: صَاحِبُ الْعِرَاقِ ؟ قَالَ : نَعَمْ ، جِئْتُک لأَسْأَلَک عَنْ قَوْمٍ خَلَعُوا الطَّاعَۃَ ، وَسَفَکُوا الدِّمَائَ ، وَجَبَوا الأَمْوَالَ ، فَقُوتِلُوا فَغُلِبُوا فَدَخَلُوا قَصْرًا فَتَحَصَّنُوا فِیہِ ، ثُمَّ سَأَلُوا الأَمَانَ فَأُعْطُوہُ ، ثُمَّ قُتِلُوا ؟ قَالَ : وَکَمَ الْعِدَّۃُ ؟ قَالَ : خَمْسَۃُ آلاَفٍ ، قَالَ : فَسَبَّحَ ابْنُ عُمَرَ عِنْدَ ذَلِکَ ، وَقَالَ : عَمْرَکَ اللہِ یَا ابْنَ الزُّبَیْرِ ! لَوْ أَنَّ رَجُلاً أَتَی مَاشِیَۃً لِلزُّبَیْرِ فَذَبَحَ مِنْہَا فِی غَدَاۃٍ خَمْسَۃَ آلاَفٍ أَکُنْتَ تَرَاہُ مُسْرِفًا ؟ قَالَ : نَعَمْ ، قَالَ : فَتَرَاہُ إسْرَافًا فِی بَہَائِمَ لاَ تَدْرِی مَا اللَّہُ ، وَتَسْتَحِلُّہُ مِمَّنْ ہَلَّلَ اللَّہَ یَوْمًا وَاحِدًا ؟۔","Sahih","Musannaf Ibn Abi Shaybah 31329","","","كتاب الأمراء"
"31330","(۳۱۳۳۰) حَدَّثَنَا مُحَمَّدُ بْنُ کُنَاسَۃَ ، عَنْ إِسْحَاقَ بْنِ سَعِیدٍ ، عَنْ أَبِیہِ ، قَالَ : أَتَی عَبْدُ اللہِ بْنُ عُمَرَ عَبْدَ اللہِ بْنَ الزُّبَیْرِ ، فَقَالَ : یَا ابْنَ الزُّبَیْرِ ، إیَّاکَ وَالإِلْحَادَ فِی حَرَمِ اللہِ ، فَإِنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : سَیُلْحِدُ فِیہِ رَجُلٌ مِنْ قُرَیْشٍ لَوْ أَنَّ ذُنُوبَہُ تُوزَنُ بِذُنُوبِ الثَّقَلَیْنِ لَرَجَحَتْ عَلَیْہِ۔ فَانْظُرْ لاَ تَکُنْہُ۔n(احمد ۱۳۶۔ حاکم ۳۸۸)","","Musannaf Ibn Abi Shaybah 31330","","","كتاب الأمراء"
"31331","(۳۱۳۳۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنِ الْمُثَنَّی بْنِ سَعِیدٍ ، عَنْ أَبِی سُفْیَانَ ، قَالَ : خَطَبَنَا ابْنُ الزُّبَیْرِ فَقَالَ : إنَّا قَدِ اُبْتُلِینَا بِمَا قَدْ تَرَوْنَ ، فَمَا أَمَرْنَاکُمْ بِأَمْرٍ لِلَّہِ فِیہِ طَاعَۃٌ فَلَنَا عَلَیْکُمْ فِیہِ السَّمْعُ وَالطَّاعَۃُ ، وَمَا أَمَرْنَاکُمْ بِأَمْرٍ لَیْسَ لِلَّہِ فِیہِ طَاعَۃٌ فَلَیْسَ لَنَا عَلَیْکُمْ فِیہِ طَاعَۃٌ ، وَلاَ نِعْمَۃُ عَیْنٍ۔","Hasan","Musannaf Ibn Abi Shaybah 31331","","","كتاب الأمراء"
"31332","(۳۱۳۳۲) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حَارِثَۃَ بْنِ مُضَرِّبٍ ، عَنْ عَلِیٍّ : أَنَّہُ خَطَبَ ثُمَّ قَالَ : إنَّ ابْنَ أَخِیکُمَ الْحَسَنَ بْنَ عَلِیٍّ قَدْ جَمَعَ مَالاً وَہُوَ یُرِیدُ أَنْ یُقَسِّمَہُ بَیْنَکُمْ ، فَحَضَرَ النَّاسُ فَقَامَ الْحَسَنُ ، فَقَالَ : إنَّمَا جَمَعْتہ لِفُقَرَائِکُمْ ، فَقَامَ نِصْفُ النَّاسِ ، ثُمَّ کَانَ أَوَّلُ مَنْ أَخَذَ مِنْہُ الأَشْعَثُ بْنُ قَیْسٍ۔","","Musannaf Ibn Abi Shaybah 31332","","","كتاب الأمراء"
"31333","(۳۱۳۳۳) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہَانِئٍ ، عَنْ عَلِیٍّ ، قَالَ : لَیُقْتَلَنَّ الْحُسَیْنُ ظُلْمًا ، وَإِنِّی لاَعْرَفُ تُرْبَۃَ الأَرْضِ الَّتِی یُقْتَلُ فِیہَا : قَرِیبًا مِنَ النَّہْرَیْنِ۔ (طبرانی ۲۸۲۴)","","Musannaf Ibn Abi Shaybah 31333","","","كتاب الأمراء"
"31334","(۳۱۳۳۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ السُّلَمِیِّ ، قَالَ : جَائَ الأَشْعَثُ بْنُ قَیْسٍ فَجَلَسَ إلَی کَعْبِ بْنِ عُجْرَۃَ فِی الْمَسْجِدِ فَوَضَعَ إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی ، فَقَالَ لَہُ کَعْبٌ : ضَعْہَا ، فَإِنَّہَا لاَ تَصْلُحُ لِبَشَرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31334","","","كتاب الأمراء"
"31335","(۳۱۳۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، عَنْ أَبِی خَالِدٍ ، قَالَ : وَفَدْت إلَی عُمَرَ فَفَضَّلَ أَہْلَ الشَّامِ عَلَیْنَا فِی الْجَائِزَۃِ ، فَقُلْنَا لَہُ ، فَقَالَ : یَا أَہْلَ الْکُوفَۃِ ، أَجَزِعْتُمْ أَنِّی فَضَّلْت عَلَیْکُمْ أَہْلَ الشَّامِ فِی الْجَائِزَۃِ ، لِبُعْدِ شُقَّتکُمْ ، فَقَدْ آثَرْتُکُمْ بِابْنِ أُمِّ عَبْدِ۔","Sahih","Musannaf Ibn Abi Shaybah 31335","","","كتاب الأمراء"
"31336","(۳۱۳۳۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ سَالِمِ بْنِ أَبِی حَفْصَۃَ ، عَنْ مُنْذِرٍ ، قَالَ : کُنْتُ عِنْدَ ابْنِ الْحَنَفِیَّۃِ فَرَأَیْتہ یَتَقَلَّبُ عَلَی فِرَاشِہِ وَیَنْفُخُ ، فَقَالَتْ لَہُ امْرَأَتُہُ : مَا یَکْرِثُک مِنْ أَمْرِ عَدُوِّکَ ہَذَا ابْنُ الزُّبَیْرِ ؟ فَقَالَ : وَاللہِ مَا بِی عَدُوُّ اللہِ ہَذَا ابْنُ الزُّبَیْرِ ، وَلَکِنْ بِی مَا یُفْعَلُ فِی حَرَمِہِ غَدًا ، قَالَ : ثُمَّ رَفَعَ یَدَیْہِ إلَی السَّمَائِ ، ثُمَّ قَالَ : اللَّہُمَّ أَنْتَ تَعْلَمُ أَنِّی کُنْت أَعْلَمُ مِمَّا عَلَّمْتنِی ، أَنَّہُ یَخْرُجُ مِنْہَا قَتِیلاً یُطَافُ بِرَأْسِہِ فِی الأَمْصَارِ ، أَوْ فِی الأَسْوَاقِ۔","","Musannaf Ibn Abi Shaybah 31336","","","كتاب الأمراء"
"31337","(۳۱۳۳۷) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنَا شُعْبَۃُ بْنُ الْحَجَّاجِ ، قَالَ : حَدَّثَنَا عُمَارَۃُ بْنُ أَبِی حَفْصَۃَ ، عَنْ أَبِی مِجْلَزٍ ، عَنْ قَیْسِ بْنِ عُبَادٍ ، قَالَ : خَرَجْت إلَی الْمَدِینَۃِ أَطْلُبُ الشَّرَفَ وَالْعِلْمَ ، فَأَقْبَلَ رَجُلٌ عَلَیْہِ حُلَّۃٌ جَمِیلَۃٌ ، فَوَضَعَ یَدَیْہِ عَلَی مَنْکِبَیْ عُمَرَ ، فَقُلْتُ مَنْ ہَذَا ، فَقَالُوا : عَلِیُّ بْنُ أَبِی طَالِبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31337","","","كتاب الأمراء"
"31338","(۳۱۳۳۸) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ حَکِیمِ بْنِ جَابِرٍ ، قَالَ : لَمَّا حُصِرَ عُثْمَان أَتَی عَلِیٌّ طَلْحَۃَ وَہُوَ مُسْنِدٌ ظَہْرَہُ إلَی وَسَائِدَ فِی بَیْتِہِ ، فَقَالَ : أُنْشِدُک اللَّہَ لَمَّا رَدَدْت النَّاسَ عَنْ أَمِیرِ الْمُؤْمِنِینَ ، فَقَالَ طَلْحَۃُ : حَتَّی یُعْطُوا الْحَقَّ مِنْ أَنْفُسِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 31338","","","كتاب الأمراء"
"31339","(۳۱۳۳۹) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ وَہْبٍ ، أَوِ ابْنِ أَخِیہِ عَبْدِ الرَّحْمَنِ : أَنَّہُ سَمِعَ الْمُخْتَارَ وَہُوَ یَقُولُ : مَا بَقِیَ مِنْ عِمَامَۃِ عَلِیٍّ إلاَّ زِرَاعَانِ حَتَّی یَجِیئَ ، قَالَ : قلْت : لِمَ تُضِلُّ النَّاسَ ؟ قَالَ : دَعَنْی أَتَأَلَّفُہُمْ۔","","Musannaf Ibn Abi Shaybah 31339","","","كتاب الأمراء"
"31340","(۳۱۳۴۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنِی ابْنُ عُیَیْنَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ حَکِیمِ بْنِ جَابِرٍ، قَالَ: سَمِعْتُ طَلْحَۃَ بْنَ عُبَیْدِ اللہِ یَقُولُ یَوْمَ الْجَمَلِ : إنَّا کُنَّا قَدْ دَاہَنَّا فِی أَمْرِ عُثْمَانَ ، فَلاَ نَجِدُ بُدًّا مِنَ الْمُبَالَغَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 31340","","","كتاب الأمراء"
"31341","(۳۱۳۴۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مُجَالِدِ بْنِ سَعِیدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَمَّا کَانَ الصُّلْحُ بَیْنَ الْحَسَنِ بْنِ عَلِیٍّ وَبَیْنَ مُعَاوِیَۃَ بْنِ أَبِی سُفْیَانَ أَرَادَ الْحَسَنُ الْخُرُوجَ - یَعْنِی : إلَی الْمَدِینَۃِ - فَقَالَ لَہُ مُعَاوِیَۃُ : مَا أَنْتَ بِالَّذِی تَذْہَبُ حَتَّی تَخْطُبَ النَّاسَ ، قَالَ الشَّعْبِیُّ : فَسَمِعْتہ عَلَی الْمِنْبَرِ حَمِدَ اللَّہَ وَأَثْنَی عَلَیْہِ ، ثُمَّ قَالَ : أَمَّا بَعْدُ ، فَإِنَّ أَکَیْسَ الْکَیْسِ التُّقَی ، وَإِنَّ أَعْجَزَ الْعَجْزِ الْفُجُورُ ، وَإِنَّ ہَذَا الأَمْرَ الَّذِی اخْتَلَفْت فِیہِ أَنَا وَمُعَاوِیَۃُ حَقٌّ کَانَ لِی فَتَرَکْتہ لِمُعَاوِیَۃَ ، أَوْ حَقٌّ کَانَ لاِمْرِئٍ أَحَقَّ بِہِ مِنِّی ، وَإِنَّمَا فَعَلْت ہَذَا لِحَقْنِ دِمَائِکُمْ {وَإِنْ أَدْرِی لَعَلَّہُ فِتْنَۃٌ لَکُمْ وَمَتَاعٌ إلَی حِینٍ}۔","Da'if","Musannaf Ibn Abi Shaybah 31341","","","كتاب الأمراء"
"31342","(۳۱۳۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ أَبِی الضُّحَی ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : اللَّہُمَّ إنِّی أَبْرَأُ إلَیْک مِنْ مُغِیرَۃَ وَبَیَانَ۔","","Musannaf Ibn Abi Shaybah 31342","","","كتاب الأمراء"
"31343","(۳۱۳۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنِ السُّمَیْطِ ، عَنْ کَعْبٍ ، قَالَ : لِکُلِّ زَمَانٍ مُلُوک ، فَإِذَا أَرَادَ اللَّہُ بِقَوْمٍ خَیْرًا بَعَثَ فِیہِمْ مُصْلِحِیہِمْ ، وَإِذَا أَرَادَ اللَّہُ بِقَوْمٍ شَرًّا بَعَثَ فِیہِمْ مُتْرَفِیہِمْ۔","","Musannaf Ibn Abi Shaybah 31343","","","كتاب الأمراء"
"31344","(۳۱۳۴۴) حَدَّثَنَا ابْنُ فَضْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ مَیْسَرَۃَ ، قَالَ : کَانَ یَمُرُّ عَلَیْہِ الْغُلاَمُ ، أَو الْجَارِیَۃُ مِمَّنْ یُخْرِجُہُ الْحَجَّاجُ إلَی السَّوَادِ فَیَقُولُ : مَنْ رَبُّک ؟ فَیَقُولُ : اللَّہُ ، فَیَقُولُ : مَنْ نَبِیُّک ؟ فَیَقُولُ : مُحَمَّدٌ رَسُولُ اللہ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَیَقُولُ : وَاللہِ الَّذِی لاَ إلَہَ إلاَّ ہُوَ ، لاَ أَجِدُ أَحَدًا یُقَاتِلُ الْحَجَّاجَ إلاَّ قَاتَلْت مَعَہُ الْحَجَّاجَ۔","","Musannaf Ibn Abi Shaybah 31344","","","كتاب الأمراء"
"31345","(۳۱۳۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَزِیدَ ، عَنْ أَبِی الْبَخْتَرِیِّ : أَنَّہُ رَأَی رَجُلاً انْحَازَ ، فَقَالَ : حرُّ النَّارِ أَشَدُّ مِنْ حَرِّ السَّیْفِ۔","","Musannaf Ibn Abi Shaybah 31345","","","كتاب الأمراء"
"31346","(۳۱۳۴۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حُصَیْنٍ ، قَالَ : سَمِعْتُ عَبْدَ الرَّحْمَن بْنَ أَبِی لَیْلَی یُحَضِّضُ النَّاسَ أَیَّامَ الْجَمَاجِمِ۔","","Musannaf Ibn Abi Shaybah 31346","","","كتاب الأمراء"
"31347","(۳۱۳۴۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجًرَیرِیِّ ، عَنِ أَبِی الْعَلاَئِ ، قَالَ : قالَوا لِمُطَرِّفٍ : ہَذَا عَبْدُ الرَّحْمَنِ بْنُ الأَشْعَثِ قَدْ أَقْبَلَ ، فَقَالَ مُطَرِّفٌ : وَاللہِ لَقَدْ نَزَی بَیْنَ أَمْرَیْنِ ، لَئِنْ ظَہَرَ لاَ یَقُومُ لِلَّہِ دِینٌ ، وَلَئِنْ ظُہِرَ عَلَیْہِ لاَ تَزَالُون أَذِلَّۃً إلَی یَوْمِ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 31347","","","كتاب الأمراء"
"31348","(۳۱۳۴۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : أَخْبَرَنِی غَیْرُ وَاحِدٍ : أَنَّ قَاضِیًا مِنْ قُضَاۃِ أَہْلِ الشَّامِ أَتَی عُمَرَ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، رَأَیْت رُؤْیَا أَفْظَعَتْنِی ، قَالَ : وَمَا رَأَیْت ؟ قَالَ : رَأَیْتُ الشَّمْسَ وَالْقَمَرَ یَقْتَتِلاَنِ ، وَالنُّجُومَ مَعَہُمَا نِصْفَیْنِ ، قَالَ : فَمَعَ أَیِّہِمَا کُنْت ، قَالَ : کُنْتُ مَعَ الْقَمَرِ عَلَی الشَّمْسِ ، فَقَالَ : عُمَرُ : {وَجَعَلْنَا اللَّیْلَ وَالنَّہَارَ آیَتَیْنِ فَمَحَوْنَا آیَۃَ اللَّیْلِ وَجَعَلْنَا آیَۃَ النَّہَارِ مُبْصِرَۃً} فَانْطَلِقْ فَوَاللہِ لاَ تَعْمَلُ لِی عَمَلاً أَبَدًا۔n قَالَ عَطَائٌ : فَبَلَغَنِی ، أَنَّہُ قُتِلَ مَعَ مُعَاوِیَۃَ یَوْمَ صِفِّینَ۔","Da'if","Musannaf Ibn Abi Shaybah 31348","","","كتاب الأمراء"
"31349","(۳۱۳۴۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، قَالَ : اجْتَمَعَ عِیدَانِ فِی یَوْمٍ ، فَقَامَ الْحَجَّاجُ فِی الْعِیدِ الأَوَّلِ ، فَقَالَ : مَنْ شَائَ أَنْ یُجَمِّعْ مَعَنا فَلْیُجَمِّعْ ، وَمَنْ شَائَ أَنْ یَنْصَرِفَ فَلْیَنْصَرِفْ ، وَلاَ حَرَجَ ، فَقَالَ أَبُو الْبَخْتَرِیِّ وَمَیْسَرَۃُ : مَا لَہُ قَاتَلَہُ اللَّہُ ، مِنْ أَیْنَ سَقَطَ عَلَی ہَذَا ؟","","Musannaf Ibn Abi Shaybah 31349","","","كتاب الأمراء"
"31350","(۳۱۳۵۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ وَاصِلٍ الأَحْدَبِ ، قَالَ : رَأَی إبْرَاہِیمُ أَمِیرَ حُلْوَانَ یَمُرُّ بِدَوَابِّہ فِی زَرْعِ قَوْمٍ ، فَقَالَ إبْرَاہِیم : الْجَوْرُ فِی الطَّرِیقِ خَیْرٌ مِنَ الْجَوْرِ فِی الدِّینِ۔","","Musannaf Ibn Abi Shaybah 31350","","","كتاب الأمراء"
"31351","(۳۱۳۵۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا زَائِدَۃٌ ، قَالَ : حَدَّثَنَا عَبْدُ الْمَلِکِ بْنُ عُمَیْرٍ ، عَنْ رِبْعِیٍّ ، عَنْ أَبِی مُوسَی ، قَالَ : قَالَ عَمْرُو بْنُ الْعَاصِ : لَئنْ کَانَ أَبُو بَکْرٍ وَعُمَرُ تَرَکَا ہَذَا الْمَالَ وَہُوَ یَحِلُّ لَہُمَا مِنْہُ شَیْئٌ لَقَدْ غُبِنَا وَنَقَصَ رَأْیُہُمَا ، وَلَعَ[corrupt]ْرُ اللہِ مَا کَانَا بِمَغْبُونَیْنِ ، وَلاَ نَاقِصِی الرَّأْی ، وَلَئنْ کَانَا امْرَأَیْنِ یَحْرُمُ عَلَیْہِمَا مِنْ ہَذَا الْمَالِ الَّذِی أَصَبْنَا بَعْدَہُمَا لَقَدْ ہَلَکْنَا وَایْمُ اللہِ مَا جَائَ الْوَہَمُ إلاَّ مِنْ قِبَلِنَا۔","Sahih","Musannaf Ibn Abi Shaybah 31351","","","كتاب الأمراء"
"31352","(۳۱۳۵۲) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، قَالَ سَمِعْت مُحَمَّدَ بْنَ سِیرِینَ ، قَالَ : بَعَثَ عَلِیُّ بْنُ أَبِی طَالِبٍ قَیْسَ بْنَ سَعْدٍ أَمِیرًا عَلَی مِصْرَ ، قَالَ : فَکَتَبَ إلَیْہِ مُعَاوِیَۃُ وَعَمْرُو بْنُ الْعَاصِ بِکِتَابٍ فَأَغْلَظَا لَہُ فِیہِ وَشَتَمَاہُ وَأَوْعَدَاہُ فَکَتَبَ إلَیْہِمَا بِکِتَابٍ لَیِّنٍ یُقَارِبُہُمَا وَیُطْمِعَہُمَا فِی نَفْسِہِ، قَالَ: فَلَمَّا أَتَاہُمَا الْکِتَابَ کَتَبَا إلَیْہِ بِکِتَابٍ لَیِّنٍ یَذْکُرَانِ فَضْلَہُ وَیُطْمِعَانِہِ فِیمَا قِبلَہُمَا ، فَکَتَبَ إلَیْہِمَا بِجَوَابِ کِتَابِہِمَا الأَوَّلِ یُغْلِظُ لَہُمَا ، فَلَمْ یَدَعْ شَیْئًا إلاَّ قَالَہُ ، فَقَالَ أَحَدُہُمَا لِلآخَرِ: لاَ وَاللہِ مَا نُطِیقُ نَحْنُ قَیْسَ بْنَ سَعْدٍ ، وَلَکِنْ تَعَالَ نَمْکُرُ بِہِ عِنْدَ عَلِیٍّ ، قَالَ : فَبَعْثَا بِکِتَابِہِ الأُولَی إلَی عَلِیٍّ، قَالَ: فَقَالَ لَہُ أَہْلُ الْکُوفَۃِ : عَدُوُّ اللہِ قَیْسُ بْنُ سَعْدٍ فَاعْزِلْہُ ، فَقَالَ عَلِیٌّ : وَیْحَکُمْ أَنَا وَاللہِ أَعْلَمُ ہِیَ وَاللہِ إحْدَی فِعْلاَتِہِ ، فَأَبَوْا إلاَّ عَزْلَہُ فَعَزَلَہُ ، وَبَعَثَ مُحَمَّدُ بْنُ أَبِی بَکْرٍ ، فَلَمَّا قَدِمَ عَلَی قَیْسِ بْنِ سَعْدٍ ، قَالَ لَہُ قَیْسٌ : اُنْظُرْ مَا آمُرُک بِہِ ، إذَا کَتَبَ إلَیْک مُعَاوِیَۃُ بِکَذَا وَکَذَا فَاکْتُبْ إلَیْہِ بِکَذَا وَکَذَا ، وَإِذَا صَنَعَ کَذَا فَاصْنَعْ کَذَا ، وَإِیَّاکَ أَنْ تُخَالِفَ مَا أَمَرْتُک بِہِ ، وَاللہِ لَکَأَنِّی أَنْظُرُ إلَیْک إنْ فَعَلْت قَدْ قُتِلْت ، ثُمَّ أُدْخِلْت فِی جَوْفَ حِمَارٍ فَأُحْرِقْت بِالنَّارِ ، قَالَ : فَفَعَلَ ذَلِکَ بِہِ۔","","Musannaf Ibn Abi Shaybah 31352","","","كتاب الأمراء"
"31353","(۳۱۳۵۳) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : مَا عَلِمْت أَنَّ عَلِیًّا اتُّہِمَ فِی قَتْلِ عُثْمَانَ حَتَّی بُویِعَ ، فَلَمَّا بُویِعَ اتَّہَمَہُ النَّاسُ۔","","Musannaf Ibn Abi Shaybah 31353","","","كتاب الأمراء"
"31354","(۳۱۳۵۴) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : قَالَ قَیْسُ بْنُ سَعْدِ بْنِ عُبَادَۃَ : لَوْلاَ أَنْ یَمْکُرَ الرَّجُلُ حَتَّی یَفْجُرَ لَمَکَرْت بِأَہْلِ الشَّامِ مَکْرًا یَضْطَرِبُونَ یَوْمًا إلَی اللَّیْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 31354","","","كتاب الأمراء"
"31355","(۳۱۳۵۵) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَبِی مَعْدَانَ ، عَنْ مَالِکِ بْنِ دِینَارٍ ، قَالَ : شَہِدْت الْحَسَنَ وَمَالِکَ بْنَ دِینَارٍ وَمُسْلِمَ بْنَ یَسَارٍ وَسَعِیدًا یَأْمُرُونَ بِقِتَالِ الْحَجَّاجِ مَعَ ابْنِ الأَشْعَثِ ، فَقَالَ الْحَسَنُ : إنَّ الْحَجَّاجِ عُقُوبَۃٌ جَائَتْ مِنَ السَّمَائِ ، فَلْنَسْتَقْبِلْ عُقُوبَۃَ اللہِ بِالسَّیْفِ۔","","Musannaf Ibn Abi Shaybah 31355","","","كتاب الأمراء"
"31356","(۳۱۳۵۶) حَدَّثَنَا أَبُو سُفْیَانَ الْحِمْیَرِیُّ ، قَالَ : حدَّثَنَا خَالِدُ بْنُ مُحَمَّدٍ الْقُرَشِیُّ ، قَالَ : قَالَ عَبْدُ الْمَلِکِ بْنُ مَرْوَانَ : مَنْ أَرَاْدَ أَنْ یَتَّخِذَ جَارِیَۃً لِلتَّلَذُّذِ فَلْیَتَّخِذْہَا بَرْبَرِیَّۃً ، وَمَنْ أَرَاْدَ أَنْ یَتَّخِذَہَا لِلْوَلَدِ فَلْیَتَّخِذْہَا فَارِسِیَّۃً ، وَمَنْ أَرَاْدَ أَنْ یَتَّخِذَہَا لِلْخِدْمَۃِ فَلْیَتَّخِذْہَا رُومِیَّۃً۔","","Musannaf Ibn Abi Shaybah 31356","","","كتاب الأمراء"
"31357","(۳۱۳۵۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا ابْنُ أَبِی غُنْیَۃً ، عَنْ شَیْخٍ مِنْ أَہْلِ الْمَدِینَۃِ ، قَالَ : قَالَ مُعَاوِیَۃُ : أَنَا أَوَّلُ الْمُلُوکِ۔","Da'if","Musannaf Ibn Abi Shaybah 31357","","","كتاب الأمراء"
"31358","(۳۱۳۵۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ بْنِ إِبْرَاہِیمَ ، عَن عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : قَالَ مُعَاوِیَۃُ : مَا زِلْت أَطْمَعُ فِی الْخِلاَفَۃِ مُنْذُ قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا مُعَاوِیَۃُ ، إنْ مَلَکْت فَأَحْسِنْ۔n(طبرانی ۸۵۰۔ بیہقی ۴۴۶)","Da'if","Musannaf Ibn Abi Shaybah 31358","","","كتاب الأمراء"
"31359","حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ ، قَالَ : حَدَّثَنَا أَبُو بَکْرِ ، قَالَ :n(۳۱۳۵۹) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ شُرَحْبِیلَ بْنِ مُسْلِمٍ ، قَالَ : سَمِعْتُ أَبَا أُمَامَۃَ الْبَاہِلِیَّ یَقُولُ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی خُطْبَتِہِ عَامَ حَجَّۃِ الْوَدَاعِ یَقُولُ : إنَّ اللَّہَ قَدْ أَعْطَی کُلَّ ذِی حَقٍّ حَقَّہُ ، فَلاَ وَصِیَّۃَ لِوَارِثٍ۔","Hasan","Musannaf Ibn Abi Shaybah 31359","","","كتاب الوصايا"
"31360","(۳۱۳۶۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ ، عَنْ عَمْرِو بْنِ خَارِجَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ وَصِیَّۃَ لِوَارِثٍ۔","","Musannaf Ibn Abi Shaybah 31360","","","كتاب الوصايا"
"31361","(۳۱۳۶۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ، عَنْ حَجَّاجٍ، عَنْ أَبِی إِسْحَاقَ، عَنِ الْحَارِثِ، عَنْ عَلِیٍّ، قَالَ: لَیْسَ لِوَارِثٍ وَصِیَّۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 31361","","","كتاب الوصايا"
"31362","(۳۱۳۶۲) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرٍو ، عَنْ عَبْدِ اللہِ بْنِ بَدْرٍ ، قَالَ : سَأَلَ رَجُلٌ ابْنَ عُمَرَ ، فَقَالَ : یَا ابْنَ عُمَرَ مَا تَرَی فِی الْوَصِیَّۃِ لِلْوَارِثِ ؟ فَانْتَہَرَہُ وَقَالَ : ہَلْ قَارَبْت الْحَرُورِیَّۃَ ، فَقَالَ : لاَ تَجُوزُ الْوَصِیَّۃُ لِلْوَارِثِ۔","Sahih","Musannaf Ibn Abi Shaybah 31362","","","كتاب الوصايا"
"31363","(۳۱۳۶۳) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ وَابْنِ سِیرِینَ، قَالاَ: لَیْسَ لِوَارِثٍ وَصِیَّۃٌ إلاَّ إنْ یَشَائَ الْوَرَثَۃُ۔","","Musannaf Ibn Abi Shaybah 31363","","","كتاب الوصايا"
"31364","(۳۱۳۶۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی مِسْکِینٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لَیْسَ لِوَارِثٍ وَصِیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 31364","","","كتاب الوصايا"
"31365","(۳۱۳۶۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَوْصَی الرَّجُلُ بِوَصِیَّۃَ لِوَارِثٍ ، فَأَجَازَ الْوَرَثَۃُ قَبْلَ أَنْ یَمُوتَ ، ثُمَّ رَجِعَ الْوَرَثَۃُ بَعْدَ مَوْتِہِ ، فَہُمْ عَلَی رَأْسِ أَمْرِہِمْ ، وَإِذَا کَانَ لِغَیْرِ وَارِثٍ زِیَادَۃ عَلَی الثُّلُثِ فَمِثْلُ ذَلِکَ ، وَإِذَا کَانَتْ لِغَیْرِ وَارِثٍ مَا بَیْنَہُ وَبَیْنَ الثُّلُثِ فَإِنَّہَا جَائِزَۃٌ۔","","Musannaf Ibn Abi Shaybah 31365","","","كتاب الوصايا"
"31366","(۳۱۳۶۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : إذَا اسْتَأْذَنَ الرَّجُلُ وَرَثَتَہُ فِی الْوَصِیَّۃِ فَأَوْصَی بِأَکْثَرَ مِنَ الثُّلُثِ ، فَطَیَّبُوا لَہُ ، فَإِذَا نَفَضُوا أَیْدِیَہُمْ مِنْ قَبْرِہِ فَہُمْ عَلَی رَأْسِ أَمْرِہِمْ ، إنْ شَاؤُوا أَجَازُوا ، وَإِنْ شَاؤُوا لَمْ یُجِیزُوا۔","","Musannaf Ibn Abi Shaybah 31366","","","كتاب الوصايا"
"31367","(۳۱۳۶۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ صَالِحِ بْنِ مُسْلِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَأَلْتُہ ؟ فَقَالَ : ہُمْ عَلَی رَأْسِ أَمْرِہِمْ۔","","Musannaf Ibn Abi Shaybah 31367","","","كتاب الوصايا"
"31368","(۳۱۳۶۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : یَرْجِعُونَ إنْ شَاؤُوا۔","","Musannaf Ibn Abi Shaybah 31368","","","كتاب الوصايا"
"31369","(۳۱۳۶۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : فِی رَجُلٍ أَوْصَی بِأَکْثَرَ مِنَ الثُّلُثِ بِرِضًا مِنَ الْوَرَثَۃِ ، فَلَمَّا مَاتَ أَنْکَرُوا ذَلِکَ ، قَالَ : ہُوَ جَائِزٌ عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 31369","","","كتاب الوصايا"
"31370","(۳۱۳۷۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : کَانَ عَطَائٌ یَقُولُ : جَائِزٌ ، قَدْ أَذِنُوا۔","","Musannaf Ibn Abi Shaybah 31370","","","كتاب الوصايا"
"31371","(۳۱۳۷۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ : أَنَّہُ قَالَ : فِی الرَّجُلِ یُوصِی بِأَکْثَرَ مِنَ الثُّلُثِ یُجِیزُہُ الْوَرَثَۃُ ، ثُمَّ یَرْجِعُونَ فِیہِ ؟ قَالَ : لَیْسَ لَہُمْ أَنْ یَرْجِعُوا ، وَقَالَ الْحَکَمُ : إنْ شَاؤُوا رَجَعُوا فِیہِ۔","","Musannaf Ibn Abi Shaybah 31371","","","كتاب الوصايا"
"31372","(۳۱۳۷۲) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : إذَا أَوْصَی الرَّجُلُ فَزَادَ عَلَی الثُّلُثِ فَاسْتَأْذَنَ ابْنَہُ فِی حَیَاتِہِ فَأَذِنَ لَہُ ، فَإِذَا مَاتَ فَعَادَ إلَی ابْنِہِ ، إنْ شَائَ أَجَازَہُ وَإِنْ شَائَ رَدَّہُ۔","","Musannaf Ibn Abi Shaybah 31372","","","كتاب الوصايا"
"31373","(۳۱۳۷۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنْ أَبِی عَوْنٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ : أَنَّ رَجُلاً اسْتَأْذَنَ وَرَثَتَہُ فِی مَرَضِہِ فِی أَنْ یُوصِیَ بِأَکْثَرَ مِنَ الثُّلُثِ فَأَذِنُوا لَہُ ، فَلَمَّا مَاتَ رَجَعُوا ، فَسُئِلَ ابْنُ مَسْعُودٍ عَنْ ذَلِکَ ؟ فَقَالَ : ذَلِکَ لَہُمْ ، ذَلِکَ التَّکَرُّہُ لاَ یَجُوزُ۔","","Musannaf Ibn Abi Shaybah 31373","","","كتاب الوصايا"
"31374","(۳۱۳۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ عَامِرٍ۔ وَعَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ، قَالَ : إذَا أَوْصَی الرَّجُلُ فِی مَرَضِہِ بِأَکْثَرَ مِنَ الثُّلُثِ لِغَیْرِ وَارِثٍ أَوْ لِوَارِثٍ ، فَأَذِنَ الْوَرَثَۃُ ، ثُمَّ مَاتَ فَلَہُمْ أَنْ یَرْجِعُوا۔","","Musannaf Ibn Abi Shaybah 31374","","","كتاب الوصايا"
"31375","(۳۱۳۷۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَزِیدَ أَبِی خَالِدٍ الدَّالاَنِیِّ ، قَالَ : سَمِعْتُ أَبَا عَوْنٍ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ یُحَدِّثُ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ : أَنَّہُ قَالَ ؛ فِی الرَّجُلِ یُوصِی بِأَکْثَرَ مِنَ الثُّلُثِ یُجِیزُہُ الْوَارِثُ ، ثُمَّ لاَ یُجِیزُہُ بَعْدَ مَوْتِہِ ، قَالَ : ذَلِکَ التَّکَرُّہُ لاَ یَجُوزُ۔","","Musannaf Ibn Abi Shaybah 31375","","","كتاب الوصايا"
"31376","(۳۱۳۷۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، أَوْ ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا أَوْصَی بِوَصِیَّۃٍ ، ثُمَّ أَوْصَی بِأُخْرَی بَعْدَہَا ، قَالَ : یُؤْخَذُ بِالأُخْرَی مِنْہُمَا۔","","Musannaf Ibn Abi Shaybah 31376","","","كتاب الوصايا"
"31377","(۳۱۳۷۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَمْرِو بْنِ دِینَارٍ، عَنْ عَطَائٍ وَطَاوُوسٍ وَأَبِی الشَّعْثَائِ ، قَالُوا : یُؤْخَذُ بِآخِرِ وَصِیَّۃٍ۔","","Musannaf Ibn Abi Shaybah 31377","","","كتاب الوصايا"
"31378","(۳۱۳۷۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : أَنَّ رَجُلاً أَوْصَی فَدَعَا نَاسًا ، فَقَالَ : أُشْہِدُکُمْ أَنَّ غُلاَمِی فُلاَنًا إنْ حَدَثَ بِی حَدَثٌ فَہُوَ حُرٌّ ، فَخَرَجُوا مِنْ عِنْدِہِ فَقِیلَ لَہُ : أَعْتَقْت فُلاَنًا وَتَرَکْت فُلاَنًا وَکَانَ أَحْسَنَ بَلاَئً ، فَقَالَ : رُدُّوا عَلَیَّ الْبَیِّنَۃَ ، أُشْہِدُکُمْ أَنِّی قَدْ رَجَعْت فِی عِتْقِ فُلاَنٍ ، وَأَنَّ فُلاَنًا لِعَبْدِہِ الآخَرِ إنْ حَدَثَ بِی حَدَثٌ فَہُوَ حُرٌّ ، فَمَاتَ الرَّجُلُ ، فَقَالَ الأَوَّلُ : أَنَا حُرٌّ ، وَقَالَ الآخَرُ : أَنَا حُرٌّ ، فَاخْتَصَمَا إلَی عَبْدِ الْمَلِکِ بْنِ مَرْوَانَ ، فَرَدَّ عِتْقَ الأَوَّلِ وَأَجَازَ عِتْقَ الآخَرِ۔","","Musannaf Ibn Abi Shaybah 31378","","","كتاب الوصايا"
"31379","(۳۱۳۷۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إذَا أَوْصَی الرَّجُلُ بِوَصِیَّۃٍ ، ثُمَّ نَقَضَہَا فَہِیَ الآخِرَۃُ ، وَإِنْ لَمْ یَنْقُضْہَا فَإِنَّہُمَا تَجُوزَانِ جَمِیعًا فِی ثُلُثِہِ بِالْحِصَصِ۔","","Musannaf Ibn Abi Shaybah 31379","","","كتاب الوصايا"
"31380","(۳۱۳۸۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ : أَنَّ ابْنَ أَبِی رَبِیعَۃَ کَتَبَ إلَی عُمَرَ بْنِ الْخَطَّابِ : فِی الرَّجُلُ یُوصِی بِوَصِیَّۃٍ ثُمَّ یُوصِی بِأُخْرَی ، قَالَ : أَمْلَکُہُمَا آخِرُہُمَا۔","","Musannaf Ibn Abi Shaybah 31380","","","كتاب الوصايا"
"31381","(۳۱۳۸۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ : فِی رَجُلٍ أَوْصَی لِرَجُلٍ فَمَاتَ الَّذِی أُوصِیَ لَہُ قَبْلَ أَنْ تَأْتِیَہُ ، قَالَ : ہِیَ لِوَرَثَۃِ الْمُوصَی لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31381","","","كتاب الوصايا"
"31382","(۳۱۳۸۲) حَدَّثَنَا حَفْصٌ ، قَالَ سَأَلَتْ عَمْرًا عَنْہُ ، قَالَ : کَانَ الْحَسَنُ یَقُولُ : ہِیَ لِوَرَثَۃِ الْمُوصَی لَہُ۔","","Musannaf Ibn Abi Shaybah 31382","","","كتاب الوصايا"
"31383","(۳۱۳۸۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَوْصَی لِرَجُلٍ وَہُوَ مَیِّتٌ یَوْمَ یُوصِی لَہُ فَإِنَّ الْوَصِیَّۃَ تَرْجِعُ إلَی وَرَثَۃِ الْمُوصِی ، وَإِذَا أَوْصَی لِرَجُلٍ ثُمَّ مَاتَ فَإِنَّ الْوَصِیَّۃَ لِوَرَثَۃِ الْمُوصَی لَہُ۔","","Musannaf Ibn Abi Shaybah 31383","","","كتاب الوصايا"
"31384","(۳۱۳۸۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : لاَ وَصِیَّۃَ لِمَیِّتٍ۔","","Musannaf Ibn Abi Shaybah 31384","","","كتاب الوصايا"
"31385","(۳۱۳۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ قَالَ : لاَ وَصِیَّۃَ لِمَیِّتٍ۔","","Musannaf Ibn Abi Shaybah 31385","","","كتاب الوصايا"
"31386","(۳۱۳۸۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ : فِی الرَّجُلِ یُوصِی بِالْوَصِیَّۃِ فَیَمُوتُ الَّذِی أُوصِیَ لَہُ قَبْلَ الَّذِی أَوْصَی ، قَالَ : لَیْسَ لَہُ شَیْئٌ ، أَنَّہُ أَوْصَی لَہُ وَہُوَ مَیِّتٌ۔","","Musannaf Ibn Abi Shaybah 31386","","","كتاب الوصايا"
"31387","(۳۱۳۸۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ : فِی الرَّجُلِ یُوصِی بِالْوَصِیَّۃِ فَیَمُوتُ الْمُوصَی لَہُ قَبْلَ الَّذِی أَوْصَی ، قَالَ : تَبْطُلُ ، وَإِنْ مَاتَ الَّذِی أَوْصَی ، ثُمَّ الَّذِی أُوصِیَ لَہُ ، کَانَ لِوَرَثَتِہِ۔","","Musannaf Ibn Abi Shaybah 31387","","","كتاب الوصايا"
"31388","(۳۱۳۸۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ أَوْصَی لِرَجُلٍ بِثُلُثِ مَالِہِ وَأَفَادَ مَالاً قَبْلَ أَنْ یَمُوتَ ثُمَّ مَاتَ ، قَالَ : لَہُ ثُلُثُ الَّذِی أَوْصَی لَہُ ، وَلَہُ ثُلُثُ مَا أَفَادَ۔","","Musannaf Ibn Abi Shaybah 31388","","","كتاب الوصايا"
"31389","(۳۱۳۸۹) حَدَّثَنَا حَفْصٌ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، عَنْ عَلِیٍّ : فِی رَجُلٍ أَوْصَی بِثُلُثِ مَالِہِ وَقُتِلَ خَطَأً، قَالَ : الثُّلُثُ دَاخِلٌ فِی دِیَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 31389","","","كتاب الوصايا"
"31390","(۳۱۳۹۰) حَدَّثَنَا حَفْصٌ، عَنْ أَشْعَثَ، عَنْ أَبِی إِسْحَاقَ، عَنِ الْحَارِثِ، عَنْ عَلِیٍّ ، قَالَ: لَہُ ثُلُثُ مَالِہِ ، وَثُلُثُ دِیَتِہ۔","Da'if","Musannaf Ibn Abi Shaybah 31390","","","كتاب الوصايا"
"31391","(۳۱۳۹۱) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ أَوْصَی بِثُلُثِ مَالِہِ فَقُتِلَ خَطَأً ، قَالَ : یَدْخُلُ ثُلُثُ الدِّیَۃِ فِی ثُلُثِ مَالِہِ۔","","Musannaf Ibn Abi Shaybah 31391","","","كتاب الوصايا"
"31392","(۳۱۳۹۲) حَدَّثَنَا عَبَّادٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَہْلُ الْوَصِیَّۃِ شُرَکَائُ فِی الْوَصِیَّۃِ ، إنْ زَادَتْ وَإِنْ نَقَصَتْ ، قَالَ : فَأَخْبَرْت بِہِ ابْنَ سِیرِینَ فَأَعْجَبَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 31392","","","كتاب الوصايا"
"31393","(۳۱۳۹۳) حَدَّثَنَا زَیْدُ بْنُ حُبَابِ ، عَنِ ابْنِ لَہِیعَۃَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : فِی رَجُلٍ أَوْصَی لِرَجُلٍ بِوَصِیَّۃٍ ، ثُمَّ جَائَہُ مَالٌ أَوْ أَفَادَ مَالاً ، قَالَ : لاَ یَدْخُلُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 31393","","","كتاب الوصايا"
"31394","(۳۱۳۹۴) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَوْصَی الرَّجُلُ لِلرَّجُلِ بِخَمْسِینَ دِرْہَمًا عُجِّلَتْ لَہُ مِنَ الْعَیْنِ ، وَإِذَا أَوْصَی بِثُلُثٍ أَوْ رُبُعٍ کَانَ فِی الْعَیْنِ وَالدَّیْنِ۔","","Musannaf Ibn Abi Shaybah 31394","","","كتاب الوصايا"
"31395","(۳۱۳۹۵) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یُوصِی لِلرَّجُلِ بِخَمْسِینَ دِرْہَمًا مِنْ مَالِہِ ، قَالَ : یُعَجِّلُ لَہُ مَا بَیْنَہُ وَبَیْنَ ثُلُثِ الْعَیْنِ۔","","Musannaf Ibn Abi Shaybah 31395","","","كتاب الوصايا"
"31396","(۳۱۳۹۶) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ یَعْقُوبَ ، عَنْ عَطَائٍ وَقَتَادَۃَ۔ وَعَنْ مَطَرٍ ، عَنِ الْحَسَنِ : فِی رَجُلٍ أَوْصَی لِبَنِی عَمِّہِ رِجَالٍ وَنِسَائٍ ، قَالُوا لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَی ، إلاَّ أَنْ یَکُونَ قَالَ : {لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ}۔","","Musannaf Ibn Abi Shaybah 31396","","","كتاب الوصايا"
"31397","(۳۱۳۹۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ طَلْحَۃَ بْنِ الأَعْلَمِ الْحَنَفِیِّ ، عَنِ الشَّعْبِیِّ : أَنَّ رَجُلاً أَوْصَی لأَرَامِلَ بَنِی حَنِیفَۃَ ، فَقَالَ الشَّعْبِیُّ : ہُوَ لِلرِّجَالِ وَالنِّسَائِ مِمَّنْ خَرَجَ مِنْ کَمَرَۃِ حَنِیفَۃَ۔","","Musannaf Ibn Abi Shaybah 31397","","","كتاب الوصايا"
"31398","(۳۱۳۹۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ وُہَیْبٍ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یَقُولُ : لِبَنِی فُلاَنٍ کَذَا وَکَذَا ، قَالَ : ہُوَ لِغَنِیِّہِمْ وَفَقِیرِہِمْ وَذَکَرِہِمْ وَأُنْثَاہُمْ۔","","Musannaf Ibn Abi Shaybah 31398","","","كتاب الوصايا"
"31399","(۳۱۳۹۹) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ عَبْدِ اللہِ بْنِ جَعْفَرٍ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ : سَأَلْتُ الْقَاسِمَ عْن رَجُلٍ کَانَتْ لَہُ مَسَاکِنُ فَأَوْصَی بِثُلُثِ کُلِّ مَسْکَنٍ لَہُ ؟ قَالَ : یُخْرَجُ حَتَّی یَکُونَ فِی مَسْکَنٍ وَاحِدٍ۔","","Musannaf Ibn Abi Shaybah 31399","","","كتاب الوصايا"
"31400","(۳۱۴۰۰) حَدَّثَنَا یَعْلَی ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : فِی رَجُلٍ أَوْصَی بِثُلُثِ مَالِہِ وَأَشْیَائَ سِوَی ذَلِکَ ، وَتَرَکَ دَارًا تَکُونُ ثُلُثُہَا ، أَیُعْطَاہَا الْمُوصَی لَہُ بِالثُّلُثِ ، قَالَ : لاَ وَلَکِنْ یُعْطَی بِالْحِصَّۃِ مِنَ الْمَالِ وَالدَّارِ۔","","Musannaf Ibn Abi Shaybah 31400","","","كتاب الوصايا"
"31401","(۳۱۴۰۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٌ ، عَنْ إبْرَاہِیمَ : أَنَّہُ سُئِلَ عَنْ رَجُلٍ ، قَالَ : ثُلُثَیْ ثَلاَثُمِئَۃ دِرْہَمٍ : مِئَۃٌ لِفُلاَنٍ ، وَمِئَۃٌ لِفُلاَنٍ ، وَمَا بَقِیَ مِنْ ثُلُثی ؛ فَہُوَ لِفُلاَنٍ ، قَالَ : فَلِفُلاَنٍ مِئَۃٌ ، وَلِفُلاَنٍ مِئَۃٌ ، وَمَا بَقِیَ فَلِفُلاَنٍ ، وَإِنْ لَمْ یَبْقَ شَیْئٌ ، فَلَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 31401","","","كتاب الوصايا"
"31402","(۳۱۴۰۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : فِی رَجُلٍ أَوْصَی ، قَالَ : ثُلُثَیْ لِفُلاَنٍ ، فَإِنْ مَاتَ فَہُوَ لِفُلاَنٍ ، قَالَ : ہُوَ لِلأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 31402","","","كتاب الوصايا"
"31403","(۳۱۴۰۳) حَدَّثَنَا زَیْدُ بْنُ الحُبَابٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : ہُوَ لِلأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 31403","","","كتاب الوصايا"
"31404","(۳۱۴۰۴) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حَمَّادٍ ، عَنْ قَتَادَۃَ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : یُجْرِی کَمَا قَالَ۔","","Musannaf Ibn Abi Shaybah 31404","","","كتاب الوصايا"
"31405","(۳۱۴۰۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حَمَّادٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 31405","","","كتاب الوصايا"
"31406","(۳۱۴۰۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : بَلَغَنِی أَنَّ صَفِیَّۃَ أَوْصَتْ لِقَرَابَۃٍ لَہَا بِمَالٍ عَظِیمٍ، وَکَثِیرٍ مِنَ الْیَہُودِ کَانُوا وَرَثَتَہَا لَوْ کَانُوا مُسْلِمِینَ فَوَرِثَہَا غَیْرُہُمْ مِنَ الْمُسْلِمِینَ وَجَازَ لَہُمْ مَا أَوْصَتْ۔","","Musannaf Ibn Abi Shaybah 31406","","","كتاب الوصايا"
"31407","(۳۱۴۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ : أَنَّ صَفِیَّۃَ أَوْصَتْ لِقَرَابَۃٍ لَہَا یَہُود۔","Da'if","Musannaf Ibn Abi Shaybah 31407","","","كتاب الوصايا"
"31408","(۳۱۴۰۸) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : وَصِیَّۃُ الرَّجُلِ جَائِزَۃٌ لِذِمِّیٍّ کَانَ أَوْ لِغَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 31408","","","كتاب الوصايا"
"31409","(۳۱۴۰۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَقُولُ : الْوَصِیَّۃُ لِلْیَہُودِیِّ وَالنَّصْرَانِیِّ وَالْمَجُوسِیِّ وَالْمَمْلُوکِ جَائِزَۃً۔","","Musannaf Ibn Abi Shaybah 31409","","","كتاب الوصايا"
"31410","(۳۱۴۱۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ : أَنَّ امْرَأَۃً مِنْ أَزْوَاجِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَوْصَتْ لِقَرَابَۃٍ لَہَا مِنَ الْیَہُودِ۔","Da'if","Musannaf Ibn Abi Shaybah 31410","","","كتاب الوصايا"
"31411","(۳۱۴۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، قَالَ: لاَ بَأْسَ أَنْ یُوصَی لِلْیَہُودِیِّ وَالنَّصْرَانِیِّ۔","","Musannaf Ibn Abi Shaybah 31411","","","كتاب الوصايا"
"31412","(۳۱۴۱۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ {إلاَّ أَنْ تَفْعَلُوا إلَی أَوْلِیَائِکُمْ مَعْرُوفًا} قَالَ : أَوْلِیَائِکَ مِنْ أَہْلِ الْکِتَابِ ، یَقُولُ : وَصِیَّۃٌ وَلاَ مِیرَاثَ لَہُمْ۔","","Musannaf Ibn Abi Shaybah 31412","","","كتاب الوصايا"
"31413","(۳۱۴۱۳) حَدَّثَنَا عُمَرُ بْنُ ہَارون، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ: سَمِعَہُ وَہُوَ یُسْأَلُ عَنِ الْوَصِیَّۃِ لأَہْلِ الشِّرْکِ؟ قَالَ : لاَ بَأْسَ بِہَا۔","","Musannaf Ibn Abi Shaybah 31413","","","كتاب الوصايا"
"31414","(۳۱۴۱۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ : أَنَّ عُمَرَ أَوْصَی إلَی حَفْصَۃَ۔","","Musannaf Ibn Abi Shaybah 31414","","","كتاب الوصايا"
"31415","(۳۱۴۱۵) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا أَبُو جَنَابٍ، عَنْ أَبِی عَوْنٍ الثَّقَفِیِّ: أَنَّ رَجُلاً أَوْصَی إلَی امْرَأَتِہِ، فَأَجَازَ ذَلِکَ شُرَیْحٌ۔","","Musannaf Ibn Abi Shaybah 31415","","","كتاب الوصايا"
"31416","(۳۱۴۱۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَرَ بْنِ عَمْرٍو الأَزْدِیِّ ، قَالَ : حدَّثَتْنِی خَالَتِی ، وَکَانَتِ امْرَأَۃُ إبْرَاہِیمَ ، قَالَتْ : أَوْصَی إلَیَّ إبْرَاہِیمُ بِشَیْئٍ مِنْ وَصِیَّتِہِ۔","","Musannaf Ibn Abi Shaybah 31416","","","كتاب الوصايا"
"31417","(۳۱۴۱۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : لاَ تَکُونُ الْمَرْأَۃُ وَصِیًّا ، فَإِنْ فَعَلَ نُظِرَ إلَی رَجُلٍ یَوْثقُ بِہِ ، فَجُعِلَ ذَلِکَ إلَیْہِ","","Musannaf Ibn Abi Shaybah 31417","","","كتاب الوصايا"
"31418","(۳۱۴۱۸) وَسَمِعْت وَکِیعًا یَقُولُ : قَالَ سُفْیَانُ : تَکُونُ وَصِیًّا ، رُبَّ امْرَأَۃٍ خَیْرٌ مِنْ رَجُلٍ۔","","Musannaf Ibn Abi Shaybah 31418","","","كتاب الوصايا"
"31419","(۳۱۴۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِکْرِمَۃَ : فِی رَجُلٍ أَوْصَی وَصِیَّۃً لِلْمُحْوِجِینَ ، قَالَ : یُجْعَلُ فِی الْقَرَابَۃِ ، فَإِنْ لَمْ یَکُونُوا فَللْمَوَالِی ، فَإِنْ لَمْ یَکُونُوا فَللْجِیرَانِ۔","","Musannaf Ibn Abi Shaybah 31419","","","كتاب الوصايا"
"31420","(۳۱۴۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : قَالَ عُبَیْدُ اللہِ بْنُ عَبْدِ اللہِ بْنِ مَعْمَرٍ فِی الْوَصِیَّۃِ : مَنْ سَمَّی : جَعَلْنَاہَا حَیْثُ سَمَّی ، وَمَنْ قَالَ حَیْثُ أَمَرَ اللَّہُ : جَعَلْنَاہَا فِی قَرَابَتِہِ۔ (عبدالرزاق ۱۶۴۳۰)","","Musannaf Ibn Abi Shaybah 31420","","","كتاب الوصايا"
"31421","(۳۱۴۲۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یُوصِی لِلأَبَاعِدِ وَیَتْرُکُ الأَقَارِبَ ، قَالَ : تُجْعَلُ وَصِیَّتُہُ ثَلاَثَۃُ أَثْلاَثٍ : لِلأَقَارِبِ ثُلُثَانِ ، وَلِلأَبَاعِدِ ثُلُثٌ ، وَأَمَّا مُحَمَّدُ بْنُ کَعْبٍ ، فَقَالَ : إنَّمَا ہُوَ مَالٌ ، أَعْطَاہُ اللَّہُ ، یَضَعُہُ حَیْثُ أَحَبَّ۔","","Musannaf Ibn Abi Shaybah 31421","","","كتاب الوصايا"
"31422","(۳۱۴۲۲) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ حُمَیْدٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : ضَعُوہَا حَیْثُ أَمَرَ بِہَا۔","","Musannaf Ibn Abi Shaybah 31422","","","كتاب الوصايا"
"31423","(۳۱۴۲۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہَمَّامٍ : أَنَّ قَتَادَۃَ سُئِلَ عَنِ الرَّجُلِ یُوصِی لِغَیْرِ قَرَابَتِہِ ؟ قَالَ : کَانَ سَالِمٌ وَسُلَیْمَانُ بْنُ یَسَارٍ وَعَطَائٌ یَقُولُونَ : ہِیَ لِمَنْ أُوصِی لَہُ بِہَا۔","","Musannaf Ibn Abi Shaybah 31423","","","كتاب الوصايا"
"31424","(۳۱۴۲۴) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ : أَوْصَی إِنْسَانٌ فِی سَبِیلِ اللہِ ، وَفِی الْمَسَاکِینِ ، وَتَرَکَ قَرَابَۃً مُحْتَاجِینَ ؟ قَالَ : وَصِیَّتُہُ حَیْثُ أَوْصَی بِہَا۔","","Musannaf Ibn Abi Shaybah 31424","","","كتاب الوصايا"
"31425","(۳۱۴۲۵) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : أَمَرَہُمْ بِأَمْرٍ فَإِنْ خَالَفُوا جَازَ وَبِئْسَ مَا صَنَعُوا ، وَقَدْ کَانَ عَطَاء قَالَ : ذُو الْقَرَابَۃِ أَحَقُّ بِہَا۔","","Musannaf Ibn Abi Shaybah 31425","","","كتاب الوصايا"
"31426","(۳۱۴۲۶) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا إسْرَائِیلُ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، قَالَ: لِلرَّجُلِ ثُلُثُہُ، یَطْرَحُہُ فِی الْبَحْرِ إنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 31426","","","كتاب الوصايا"
"31427","(۳۱۴۲۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یُوصِی لِلأَبَاعِدِ وَیَتْرُکُ الأَقَارِبَ ، قَالَ : تُجْعَلُ وَصِیَّتُہُ ثَلاَثَۃَ أَثْلاَثٍ : لِلأَقَارِبِ ثُلُثَانِ ، وَلِلأَبَاعِدِ ثُلُثٌ۔","","Musannaf Ibn Abi Shaybah 31427","","","كتاب الوصايا"
"31428","(۳۱۴۲۸) حَدَّثَنَا الضَّحَّاکُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : کَانَ لاَ یَرَی الْوَصِیَّۃَ إلاَّ لِذَوِی الأَرْحَامِ أَہْلِ الْفَقْرِ ، فَإِنْ أَوْصَی بِہَا لِغَیْرِہِمْ إنْتُزِعَتْ مِنْہُمْ فَرُدَّتْ إلَیْہِمْ ، فَإِنْ لَمْ یَکُنْ فِیہِمْ فُقَرَائُ فَلأَہْلِ الْفَقْرِ مَا کَانُوا ، وَإِنْ سَمَّی أَہْلُہَا الَّذِینَ أُوصِی لَہُمْ۔","","Musannaf Ibn Abi Shaybah 31428","","","كتاب الوصايا"
"31429","(۳۱۴۲۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ أَبِی مَیْمُونَۃَ ، قَالَ : سَأَلْتُ الْعَلاَئَ بْنَ زِیَادٍ وَمُسْلِمَ بْنَ یَسَارٍ عَنِ الْوَصِیَّۃِ ؟ فَدَعَا بِالْمُصْحَفِ فَقَرَأَ : {إنْ تَرَکَ خَیْرًا الْوَصِیَّۃُ لِلْوَالِدَیْنِ وَالأَقْرَبِینَ} قَالاَ: ہِیَ لِلْقَرَابَۃِ۔","","Musannaf Ibn Abi Shaybah 31429","","","كتاب الوصايا"
"31430","(۳۱۴۳۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہَمَّامِ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ وَعَبْدِ الْمَلِکِ بْنِ یَعْلَی ، قَالاَ : تُرَدُّ عَلَی قَرَابَتِہِ۔","","Musannaf Ibn Abi Shaybah 31430","","","كتاب الوصايا"
"31431","(۳۱۴۳۱) حَدَّثَنَا حَفْصٌ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ : أَنَّ أَبَا طَلْحَۃَ أَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : یَا رَسُولَ اللہِ ، إنِّی جَعَلْت حَائِطِی لِلَّہِ ، وَلَوَ اسْتَطَعْت أَنْ أُخْفِیَہُ لَمْ أُظْہِرْہُ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اجْعَلْہُ فِی فُقَرَائِ أَہْلِک۔ (مسلم ۲۸۵۔ ابوداؤد ۱۶۸۶)","Sahih","Musannaf Ibn Abi Shaybah 31431","","","كتاب الوصايا"
"31432","(۳۱۴۳۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ : فِی الرَّجُلِ إذَا أَوْصَی فِی مَرَضِہِ ، ثُمَّ بَرَأَ فَلَمْ یُغَیِّرْ وَصِیَّتَہُ تِلْکَ حَتَّی یَمُوتَ بَعْدُ ، قَالَ : یُؤْخَذُ بِمَا فِیہَا۔","","Musannaf Ibn Abi Shaybah 31432","","","كتاب الوصايا"
"31433","(۳۱۴۳۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ یَعْلَی : فِی رَجُلٍ أَوْصَی بِوَصِیَّۃٍ فِی مَرَضِہِ فَبَرَأَثُمَّ تَرَکَہَا حَتَّی مَاتَ ، قَالَ : جَائِزَۃٌ۔","","Musannaf Ibn Abi Shaybah 31433","","","كتاب الوصايا"
"31434","(۳۱۴۳۴) حَدَّثَنَا حَفْصٌ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، قَالَ : سُئِلَ عَامِرٌ عَنْ رَجُلٍ مَاتَ وَتَرَکَ ثَلاَثَۃَ بَنِینَ ، وَأَوْصَی بِمِثْلِ نَصِیبِ أَحَدِہِمْ ؟ قَالَ : ہُوَ رَابِعٌ ، لَہُ الرُّبْعُ۔","","Musannaf Ibn Abi Shaybah 31434","","","كتاب الوصايا"
"31435","(۳۱۴۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ وَالأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا تَرَکَ الرَّجُلُ ثَلاَثَۃَ بَنِینَ وَأَوْصَی بِمِثْلِ نَصِیبِ أَحَد بَنِیہِ ، قَالَ : زِدْ وَاحِدًا اجْعَلْہَا مِنْ أَرْبَعَۃٍ۔","","Musannaf Ibn Abi Shaybah 31435","","","كتاب الوصايا"
"31436","(۳۱۴۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : زِدْ وَاحِدًا وَاجْعَلْہَا مِنْ أَرْبَعَۃٍ۔","","Musannaf Ibn Abi Shaybah 31436","","","كتاب الوصايا"
"31437","(۳۱۴۳۷) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ مَنْص[corrupt]ورٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ تَرَکَ ابْنَیْنِ وَأَبَوَیْنِ ، وَأَوْصَی بِمِثْلِ نَصِیبِ أَحَدِ الاِبْنَیْنِ ، قَالَ ، ہِیَ مِنْ ثَمَانِیَۃٍ۔","","Musannaf Ibn Abi Shaybah 31437","","","كتاب الوصايا"
"31438","(۳۱۴۳۸) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ مَنْصُورٍ وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ تَرَکَ سِتَّۃَ بَنِینَ وَأَوْصَی بِمِثْلِ نَصِیبِ بَعْضِ وَلَدِہِ ، قَالَ : قَالَ مَنْصُورٌ : ہِیَ مِنْ سَبْعَۃٍ ، یَدْخُلُ مَعَہُمْ ، وَقَالَ مُغِیرَۃُ : یُنْقَصُ وَلاَ یُتَمُّ لَہُ مِثْلُ نَصِیبِ أَحَدِہِمْ۔","","Musannaf Ibn Abi Shaybah 31438","","","كتاب الوصايا"
"31439","(۳۱۴۳۹) حَدَّثَنَا أَبُو مُعَاویَۃ ، حَدَّثَنَا أَبُو عَاصِمٍ الثَّقَفِیُّ ، قَالَ : لَقِیَنِی إبْرَاہِیمُ فَقَالَ : مَا تَقُولُ فِی رَجُلٍ أَوْصَی بِنِصْفِہِ وَثُلُثِہِ وَرُبْعِہِ ، قَالَ : فَلَمْ یَکُنْ عِنْدِی فِیہَا شَیْئٌ ، فَقَالَ : إبْرَاہِیمُ ، خُذْ مَالاً لَہُ نِصْفٌ وَثُلُثٌ وَرُبْعٌ : اثْنَا عَشَرَ فَخُذْ نِصْفَہَا سِتَّۃً وَثُلُثَہَا أَرْبَعَۃً وَرُبْعَہَا ثَلاَثَۃً ، فَاقْسِمَ الْمَالَ عَلَی ثَلاَثَۃَ عَشَرَ ، فَمَا أَصَابَ سِتَّۃً کَانَ لِصَاحِبِ النِّصْفِ ، وَمَا أَصَابَ أَرْبَعَۃً کَانَ لِصَاحِبِ الثُّلُثِ ، وَمَا أَصَابَ ثَلاَثَۃً کَانَ لِصَاحِبِ الرُّبْعِ۔","","Musannaf Ibn Abi Shaybah 31439","","","كتاب الوصايا"
"31440","(۳۱۴۴۰) حَدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یُوصِیَ الرَّجُلُ بِمِثْلِ نَصِیبِ أَحَدِ الْوَرَثَۃِ حَتَّی یَکُونَ أَقَلَّ۔","","Musannaf Ibn Abi Shaybah 31440","","","كتاب الوصايا"
"31441","(۳۱۴۴۱) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا عُبَادَۃُ الصَّیْدَلاَنِیُّ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ : أَنَّہُ أَوْصَی بِمِثْلِ نَصِیبِ أَحَدِ وَلَدِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 31441","","","كتاب الوصايا"
"31442","(۳۱۴۴۲) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا زَائِدَۃُ أَبُو قُتَیْبَۃَ الْہَمْدَانِیُّ ، عَنْ یَسَارِ بْنِ أَبِی کَرِبٍ ، عَنْ شُرَیْحٍ : أَنَّہُ قَضَی فِی رَجُلٍ أَوْصَی لِرَجُلٍ بِسَہْمٍ مِنْ مَالِہِ وَلَمْ یُسَمِّ ، قَالَ : تُرْفَعُ السِّہَامُ فَیَکُونُ لِلْمُوصَی لَہُ سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 31442","","","كتاب الوصايا"
"31443","(۳۱۴۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ رَجُلٍ مِنْ أَہْلِ خُرَاسَانَ ، عَنْ عِکْرِمَۃَ ، قَالَ : لَیْسَ لَہُ شَیْئٌ ، ہَذَا مَجْہُولٌ۔","","Musannaf Ibn Abi Shaybah 31443","","","كتاب الوصايا"
"31444","(۳۱۴۴۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ یَعْقُوبَ بْنِ الْقَعْقَاعِ ، عَنْ عَطَائٍ۔ وَیَعْقُوبَ ، عَنْ مُحَمَّدِ بْنِ صُہَیْبٍ ، عَنْ عِکْرِمَۃَ : فِی رَجُلٍ أَوْصَی لِرَجُلٍ بِسَہْمٍ مِنْ مَالِہِ ، قَالَ : لَیْسَ بِشَیْئٍ ، لَمْ یُبَیِّنْ۔","","Musannaf Ibn Abi Shaybah 31444","","","كتاب الوصايا"
"31445","(۳۱۴۴۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ أَیُّوبَ ، عَنْ إیَاسِ بْنِ مُعَاوِیَۃَ ، قَالَ : کَانَتِ الْعَرَبُ تَقُولُ : لَہُ السُّدُسُ۔","","Musannaf Ibn Abi Shaybah 31445","","","كتاب الوصايا"
"31446","(۳۱۴۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ ، عَنْ أَبِی قَیْسٍ ، عَنِ الْہُزَیْلِ : أَنَّ رَجُلاً جَعَلَ لِرَجُلٍ سَہْمًا مِنْ مَالِہِ وَلَمْ یُسَمِّ ، فَقَالَ عَبْدُ اللہِ : لَہُ السُّدُسُ۔","Da'if","Musannaf Ibn Abi Shaybah 31446","","","كتاب الوصايا"
"31447","(۳۱۴۴۷) حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حُمَیْدٍ : أَنْ عَدِیًّا سَأَلَ إیَاسًا ؟ فَقَالَ : السَّہْمُ فِی کَلاَمُ الْعَرَبِ السُّدُسُ۔","","Musannaf Ibn Abi Shaybah 31447","","","كتاب الوصايا"
"31448","(۳۱۴۴۸) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، أَنَّ امْرَأَۃً قِیلَ لَہَا فِی مَرَضِہَا : أَوْصِی بِکَذَا ، أَوْصِی بِکَذَا ، فَأَوْمَأَتْ بِرَأْسِہَا ، فَلَمْ یُجِزْہُ عَلِیُّ بْنُ أَبِی طَالِبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31448","","","كتاب الوصايا"
"31449","(۳۱۴۴۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ حُسَیْنِ الْمُعَلِّمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ بْنِ أَبِی رَبِیعَۃَ ، أَو الْحَارِثِ بْنِ عَبْدِ اللہِ بْنِ أَبِی رَبِیعَۃَ ، قَالَ : قُلْتُ لِعُمَرَ : شَیْئٌ یَصْنَعُہُ أَہْلُ الْیَمَنِ ، یُوصِی الرَّجُلُ، ثُمَّ یُغَیِّرُ وَصِیَّتَہُ ، قَالَ : لِیُغَیِّرْ مَا شَائَ مِنْ وَصِیَّتِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 31449","","","كتاب الوصايا"
"31450","(۳۱۴۵۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ عُمَرُ : مَا أَعْتَقَ الرَّجُلُ فِی مَرَضِہِ مِنْ رَقِیقِہِ فَہِیَ وَصِیَّۃٌ إنْ شَائَ رَجَعَ فِیہَا۔","Da'if","Musannaf Ibn Abi Shaybah 31450","","","كتاب الوصايا"
"31451","(۳۱۴۵۱) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یُغَیِّرُ الرَّجُلُ مِنْ وَصِیَّتِہِ مَا شَائَ إلاَّ الْعَتَاقَۃ۔","","Musannaf Ibn Abi Shaybah 31451","","","كتاب الوصايا"
"31452","(۳۱۴۵۲) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : کُلُّ وَصِیَّۃٍ إنْ شَائَ رَجَعَ فِیہَا غَیْرِ الْعَتَاقَۃَ۔","","Musannaf Ibn Abi Shaybah 31452","","","كتاب الوصايا"
"31453","(۳۱۴۵۳) حَدَّثَنَا ابْنُ مَہْدِی، عَنْ حَمَّادِ بْنِ سَلَمَۃَ، عَنْ حَجَّاجٍ، عَنِ الْحَکَمِ، عَنْ إبْرَاہِیمَ، قَالَ: إذَا أَوْصَی الرَّجُلُ بِوَصَایَا، وَأَعْتَقَ غُلاَمًا لَہُ إنْ حَدَثَ بِہِ حَدَثُ الْمَوْتِ، قَالَ: لاَ یَرْجِعُ فِی الْعِتْقِ؛ لَیْسَ الْعِتْق کَسَائِرِ الْوَصِیَّۃ۔","","Musannaf Ibn Abi Shaybah 31453","","","كتاب الوصايا"
"31454","(۳۱۴۵۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا أَوْصَی الرَّجُلُ فَإِنَّہُ یُغَیِّرُ وَصِیَّتَہُ مَا شَائَ ، قِیلَ لَہُ : فَالْعَتَاقَۃُ ، قَالَ الْعَتَاقَۃُ وَغَیْرُ الْعَتَاقَۃِ ، وَإِنَّمَا یُؤْخَذُ بِآخِرِہَا۔","","Musannaf Ibn Abi Shaybah 31454","","","كتاب الوصايا"
"31455","(۳۱۴۵۵) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ طَاوُوسٍ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَعُودَ الرَّجُلُ فِی عَتَاقِہِ۔","","Musannaf Ibn Abi Shaybah 31455","","","كتاب الوصايا"
"31456","(۳۱۴۵۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عَاصِمٍ ، قَالَ : مَرِضَ أَبُو الْعَالِیَۃَ فَأَعْتَقَ مَمْلُوکًا لَہُ ذَکَرُوا لَہُ أَنَّہُ مِنْ وَرَائِ النَّہَرِ ، فَقَالَ : إنْ کَانَ حَیًّا فَلاَ أُعْتِقُہُ ، وَإِنْ کَانَ مَیِّتًا فَہُوَ عَتِیقٌ ، وَذَکَرَ ہَذِہِ الآیَۃَ : {وَلَہُ ذُرِّیَّۃٌ ضُعَفَائُ}۔","","Musannaf Ibn Abi Shaybah 31456","","","كتاب الوصايا"
"31457","(۳۱۴۵۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانُوا یُوصُونَ ، فَیَکْتُبُ الرَّجُلُ فِی وَصِیَّتِہِ : إنْ حَدَثَ بِی حَدَثٌ قَبْلَ أَنْ أُغَیِّرَ وَصِیَّتِی ہَذِہِ فَإِنْ بَدَا لَہُ أَنْ یُغَیِّرَ غَیَّرَ إنْ شَائَ الْعَتَاقَۃَ وَغَیْرَہَا ، فَإِنْ لَمْ یَسْتَثْنِ فِی وَصِیَّتِہِ غَیَّرَ مِنْہَا مَا شَائَ غَیْرَ الْعَتَاقَۃِ۔","","Musannaf Ibn Abi Shaybah 31457","","","كتاب الوصايا"
"31458","(۳۱۴۵۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ رُوحِ بْنِ الْقَاسِمِ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : کَانَ یُقْسِمُ عَلَیْہِ قَسَمًا ، أَنَّ الْمُعْتَقَ عَنْ دُبُرِ وَصِیَّۃٍ ، وَأَنَّ لِلرَّجُلِ أَنْ یُغَیِّرَ مِنْ وَصِیَّتِہِ مَا شَائَ۔","","Musannaf Ibn Abi Shaybah 31458","","","كتاب الوصايا"
"31459","(۳۱۴۵۹) حَدَّثَنَا سَعِیدُ بْنُ خُثَیْمٍ ، عَنْ حَنْظَلَۃَ ، عَنْ طَاوُوسٍ ، قَالَ : یَرْجِعُ مَوْلَی الْمُدَبَّرِ فِیہِ مَتَی شَائَ۔","","Musannaf Ibn Abi Shaybah 31459","","","كتاب الوصايا"
"31460","(۳۱۴۶۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ نَافِعٍ ، قَالَ : قالَتْ عَائِشَۃُ : لِیَکْتُبَ الرَّجُلُ فِی وَصِیَّتِہِ : إنْ حَدَثَ بِی حَدَثٌ قَبْلَ أَنْ أُغَیِّرَ وَصِیَّتِی ہَذِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31460","","","كتاب الوصايا"
"31461","(۳۱۴۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ عَامِرِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ : أَنَّ ابْنَ مَسْعُودٍ أَوْصَی فَکَتَبَ فِی وَصِیَّتِہِ : بِسْمِ اللہِ الرَّحْمَن الرَّحِیمِ ، ہَذَا مَا أَوْصَی بِہِ ابْنُ مَسْعُودٍ : إنْ حَدَثَ بِہِ حَدَثٌ فِی مَرَضِہِ ہَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 31461","","","كتاب الوصايا"
"31462","(۳۱۴۶۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانُوا یُوصُونَ فَیَکْتُبُ الرَّجُلُ فِی وَصِیَّتِہِ : إنْ حَدَثَ بِی حَدَثٌ قَبْلَ أَنْ أُغَیِّرَ وَصِیَّتِی ہَذِہِ۔","","Musannaf Ibn Abi Shaybah 31462","","","كتاب الوصايا"
"31463","(۳۱۴۶۳) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ أَبِی خَلْدَۃَ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : أَوْصَیْت بِضْعَ عَشْرَ مَرَّۃٍ أُوَقِّت وَقْتًا إذَا جَائَ الْوَقْتُ کُنْت بِالْخِیَارِ۔","","Musannaf Ibn Abi Shaybah 31463","","","كتاب الوصايا"
"31464","(۳۱۴۶۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی عُمَیْرٍ الْحَارِثُ بْنُ عُمَیْرٍ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أَنَّہُ کَانَ یَشْتَرِطُ : إنْ حَدَثَ بِی حَدَثٌ قَبْلَ أُغَیِّرَ کِتَابِی ہَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 31464","","","كتاب الوصايا"
"31465","(۳۱۴۶۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس : أَنَّ رَجُلاً مِنْ أَہْلِ الْیَمَنِ أَوْصَی ، فَقَالَ : فُلاَنٌ حُرٌّ وَفُلاَنٌ حُرٌّ - وَلَمْ یُسَمِّ - إنْ مِتّ فِی مَرَضِی ہَذَا ، فَبَرَأَ الرَّجُلُ فَخَاصَمَہُ مَمْلُوکَاہُ إِلَی قَاضِی أَہْلِ الْجَنَدِ ، فَشَاوَرَ فِی ذَلِکَ طَاوُوسًا ، فَقَالَ طَاوُوس : ہُمْ عَبِیدٌ ، إنَّمَا کَانَتْ نِیَّتُہُ : إنْ حَدَثَ بِہِ حَدَثٌ۔","","Musannaf Ibn Abi Shaybah 31465","","","كتاب الوصايا"
"31466","(۳۱۴۶۸) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ : أَنَّہُ سُئِلَ عَنْ رَجُلٍ أَوْصَی بِجَارِیَتِہِ لاِبْنِ أَخِیہِ ، ثُمَّ وَطِئَہَا ؟ قَالَ : أَفْسَدَ وَصِیَّتَہُ۔","","Musannaf Ibn Abi Shaybah 31466","","","كتاب الوصايا"
"31467","(۳۱۴۶۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَوْصَی بِہِمَا فَہُمَا مِنَ الثُّلُثِ۔ یَعْنِی : الْحَجَّ وَالزَّکَاۃَ۔","","Musannaf Ibn Abi Shaybah 31467","","","كتاب الوصايا"
"31468","(۳۱۴۶۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَوْصَی بِحَجَّۃ وَلَمْ یَکُنْ حَجَّ فَمِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31468","","","كتاب الوصايا"
"31469","(۳۱۴۶۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31469","","","كتاب الوصايا"
"31470","(۳۱۴۷۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ وَمَنْصُورٍ ، عَنِ الْحَسَنِ ، قَالَ : ہُوَ مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 31470","","","كتاب الوصايا"
"31471","(۳۱۴۷۱) حَدَّثَنَا جَرِیرٌ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنِ الْحَسَنِ وَطَاوُسٍ : فِی الرَّجُلِ عَلَیْہِ حِجَّۃُ الإسْلاَمِ وَتَکُونُ عَلَیْہِ الزَّکَاۃُ فِی مَالِہِ ؟ قَالاَ : یَکُونَانِ ہَذَیْنِ بِمَنْزِلَۃِ الدَّیْنِ۔","","Musannaf Ibn Abi Shaybah 31471","","","كتاب الوصايا"
"31472","(۳۱۴۷۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ ، عَنِ الشَّعْبِیِّ : فِی الرَّجُلِ یَمُوتُ وَیُوصِی أَنْ یُحَجَّ عَنْہُ ، أَوْ یُتَصَدَّقَ عَنْہُ کَفَّارَۃُ رَمَضَانَ ، أَوْ کَفَّارَۃُ یَمِینٍ ؟ قَالَ : مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31472","","","كتاب الوصايا"
"31473","(۳۱۴۷۳) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ، قَالَ: إذَا کَانَ عَلَی الرَّجُلِ شَیْئٌ وَاجِبٌ فَہُوَ مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 31473","","","كتاب الوصايا"
"31474","(۳۱۴۷۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : ہُوَ مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 31474","","","كتاب الوصايا"
"31475","(۳۱۴۷۵) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ صَالِحِ بْنِ خَوَّاتٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ : أَنَّ الْمُکَاتَبَ لاَ تَجُوزُ لَہُ وَصِیَّۃٌ ، وَلاَ ہِبَۃٌ إلاَّ بِإِذْنِ مَوْلاَہُ۔","","Musannaf Ibn Abi Shaybah 31475","","","كتاب الوصايا"
"31476","(۳۱۴۷۶) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : الْمُکَاتَبُ لاَ یَعْتِقُ ، وَلاَ یَہَبُ إلاَّ بِإِذْنِ مَوْلاَہُ۔","","Musannaf Ibn Abi Shaybah 31476","","","كتاب الوصايا"
"31477","(۳۱۴۷۷) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : الأَحْمَقُ وَالمُوَسْوَسُ أَتَجُوزُ وَصِیَّتُہُمَا إنْ أَصَابَا الْحَقَّ وَہُمَا مَغْلُوبَانِ عَلَی عُقُولِہِمَا ؟ قَالَ : مَا أَحْسَبُ لَہُمَا وَصِیَّۃ۔","","Musannaf Ibn Abi Shaybah 31477","","","كتاب الوصايا"
"31478","(۳۱۴۷۸) حَدَّثَنَا ابْنُ مَہْدِی ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ إیَاسِ بْنِ مُعَاوِیَۃَ : فِی وَصِیَّۃِ الْمَجْنُونِ ، قَالَ : إِذَا أَصَابَ الْحَقّ جَازَ۔","","Musannaf Ibn Abi Shaybah 31478","","","كتاب الوصايا"
"31479","(۳۱۴۷۹) حَدَّثَنَا ابْنُ مَہْدِیٌّ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : لاَ تَجُوزُ وَصِیَّۃ وَلاَ طَلاَق إِلاَّ فِی عَقْلٍ۔","","Musannaf Ibn Abi Shaybah 31479","","","كتاب الوصايا"
"31480","(۳۱۴۸۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، قَالَ : إنْ کَانَ سَمَّی الْغُزَاۃَ : أُعْطِیَ الْغُزَاۃَ ، وَإِلاَّ : طَاعَۃُ اللہِ : سَبِیلُہُ۔","","Musannaf Ibn Abi Shaybah 31480","","","كتاب الوصايا"
"31481","(۳۱۴۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی حَبِیبَۃَ ، عَنْ أَبِی الدَّرْدَائِ : فِی الرَّجُلِ أَوْصَی بِشَیْئٍ فِی سَبِیلِ اللہِ ، قَالَ فِی الْمُجَاہِدِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 31481","","","كتاب الوصايا"
"31482","(۳۱۴۸۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ : أَنَّ امْرَأَۃً أَوْصَتْ بِثَلاَثِینَ دِرْہَمًا فِی سَبِیلِ اللہِ ، فَلَمَّا کَانَ زَمَنُ الفُرْقَۃِ قُلْتُ لاِبْنِ عُمَرَ : امْرَأَۃٌ أَوْصَتْ بِثَلاَثِینَ دِرْہَمًا فِی سَبِیلِ اللہِ ، فَنُعْطِیہَا فِی الْحَجِّ ؟ فَقَالَ : أَمَا إِنَّہُ مِنْ سَبِیلِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31482","","","كتاب الوصايا"
"31483","(۳۱۴۸۳) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ وَاقِدِ بْنِ مُحَمَّدِ بْنِ زَیْدٍ : أَنَّ رَجُلاً مَاتَ وَتَرَکَ مَالاً وَأَوْصَی بِہِ فِی سَبِیلِ اللہِ ، فَذَکَرَ ذَلِکَ الْوَصِیُّ لِعُمَرَ بْنَ الْخَطَّابِ ، فَقَالَ : أَعْطِہِ عُمَّالَ اللہِ ، قَالَ : وَمَا عُمَّالُ اللہِ ؟ قَالَ : حُجَّاجُ بَیْتِ اللہِ۔","Da'if","Musannaf Ibn Abi Shaybah 31483","","","كتاب الوصايا"
"31484","(۳۱۴۸۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَیْمَنَ بْنِ نَابِلٍ ، قَالَ : سَأَلَ رَجُلٌ مُجَاہِدًا عَنْ رَجُلٍ ، قَالَ : کُلُّ شَیْئٍ لِی فِی سَبِیلِ اللہِ ؟ قَالَ مُجَاہِدٌ : لَیْسَ سَبِیلُ اللہِ وَاحِدًا ، کُلُّ خَیْرٍ عَمِلَہُ فَہُوَ فِی سَبِیلِ اللہِ۔","","Musannaf Ibn Abi Shaybah 31484","","","كتاب الوصايا"
"31485","(۳۱۴۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَنَسِ بْنِ سِیرِینَ : أَنَّ رَجُلاً أَوْصَی بِشَیْئٍ فِی سَبِیلِ اللہِ ، فَقَالَ ابْنُ عُمَرَ: الْحَجُّ فِی سَبِیلِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31485","","","كتاب الوصايا"
"31486","(۳۱۴۸۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ فِی رَجُلٍ تَصَدَّقَ بِمَالِہِ کُلِّہِ عَلَی غَیْرِ وَارِثٍ ، ثُمَّ حَبَسَہُ حَتَّی مَاتَ ، یُرَدُّ ذَلِکَ إلَی الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31486","","","كتاب الوصايا"
"31487","(۳۱۴۸۷) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : مَنْ صَنَعَ فِی مَالِہِ شَیْئًا لَمْ یُنَفِّذْہُ حَتَّی یَحْضُرَہُ الْمَوْتُ : فَہُوَ فِی سَبِیلِہِ۔","","Musannaf Ibn Abi Shaybah 31487","","","كتاب الوصايا"
"31488","(۳۱۴۸۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، قَالَ : جَائَ رَجُلٌ إلَی الْحَسَنِ بِوَصِیَّۃٍ مَخْتُومَۃٍ لِیَشْہَدَ عَلَیْہَا ، فَقَالَ الْحَسَنُ : مَا تَجِدُ فِی ہَؤُلاَئِ النَّاسِ رَجُلَیْنِ تَثِقْہُمَا تُشْہِدُہُمَا عَلَی کِتَابِکَ ہَذَا ؟!۔","","Musannaf Ibn Abi Shaybah 31488","","","كتاب الوصايا"
"31489","(۳۱۴۸۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : أَرَاہُ عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یَخْتِمُ وَصِیَّتَہُ ، وَیَقُولُ لِلْقَوْمِ : اشْہَدُوا عَلَی مَا فِیہَا ، قَالَ : لاَ تَجُوزُ إلاَّ أَنْ یَقْرَأَہَا عَلَیْہِمْ ، أَوْ تُقْرَأَ عَلَیْہِ فَیُقِرَّ بِمَا فِیہَا۔","","Musannaf Ibn Abi Shaybah 31489","","","كتاب الوصايا"
"31490","(۳۱۴۹۰) حَدَّثَنَا أَبُو أُسَامَۃ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ : فِی الرَّجُلِ یَکْتب الوَصِیَّۃ وَیَقُولُ : اشْہَدُوا عَلَی مَا فِی ہَذِہِ الصَّحِیفَۃِ ، قَالَ : لاَ ، حَتَّی یُعْلَمَ مَا فِیہَا۔","","Musannaf Ibn Abi Shaybah 31490","","","كتاب الوصايا"
"31491","(۳۱۴۹۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، عَنْ سَعِیدِ بْنِ زَیْدٍ ، قَالَ : ذَہَبْت مَعَ حَفْصِ بْنِ عَاصِمٍ إلَی سَالِمٍ وَقَدْ خَتَمَ وَصِیَّتَہُ ، فَقَالَ : إنْ حَدَثَ بِی حَادِثٌ فَاشْہَدُوا عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 31491","","","كتاب الوصايا"
"31492","(۳۱۴۹۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ یَعْلَی قَاضِی الْبَصْرَۃِ : فِی الرَّجُلِ یَکْتُبُ وَصِیَّتَہُ ، ثُمَّ یَخْتِمُہَا ، ثُمَّ یَقُولُ : اشْہَدُوا عَلَی مَا فِیہَا ، قَالَ : جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 31492","","","كتاب الوصايا"
"31493","(۳۱۴۹۳) حَدَّثَنَا عَبَّادٌ ، عَنْ رَوْحِ بْنِ الْقَاسِمِ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ حَزْمٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ غُلاَمٌ مِنْ غَسَّانَ بِالْمَدِینَۃِ ، وَکَانَ لَہُ وَرَثَۃٌ بِالشَّامِ ، وَکَانَتْ لَہُ عَمَّۃٌ بِالْمَدِینَۃِ ، فَلَمَّا حُضِرَ أَتَتْ عُمَرَ بْنَ الْخَطَّابِ فَذَکَرَتْ ذَلِکَ لَہُ وَقَالَتْ : أَفَیُوصِی ؟ قَالَ : احْتَلَمَ بَعْدُ ؟ قَالَ : قُلْتُ : لاَ ، قَالَ : فَلْیُوصِ، قَالَ : فَأَوْصَی لَہَا بِنَخْلٍ ، فَبِعْتہ أَنَا لَہَا بِثَلاَثِینَ أَلْفِ دِرْہَمٍ۔","","Musannaf Ibn Abi Shaybah 31493","","","كتاب الوصايا"
"31494","(۳۱۴۹۴) حَدَّثَنَا أَبُو عِصَامٍ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ : أَنَّ عُثْمَانَ أَجَازَ وَصِیَّۃَ ابْنِ إحْدَی عَشْرَۃَ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 31494","","","كتاب الوصايا"
"31495","(۳۱۴۹۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ أَجَازَ وَصِیَّۃَ الصَّبِیِّ۔","","Musannaf Ibn Abi Shaybah 31495","","","كتاب الوصايا"
"31496","(۳۱۴۹۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، أَنَّ عَبْد اللہِ بْنِ عُتْبَۃَ سُئِلَ عَنْ وَصِیَّۃِ جَارِیَۃٍ صَغَّرُوہَا وَحَقَّرُوہَا ؟ فَقَالَ : مَنْ أَصَابَ الْحَقَّ أُجِر۔","","Musannaf Ibn Abi Shaybah 31496","","","كتاب الوصايا"
"31497","(۳۱۴۹۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مُوسَی ، قَالَ : أَوْصَی ابْنٌ لأَبِی مُوسَی غُلاَمٌ صَغِیرٌ بِوَصِیَّۃٍ ، فَأَرَادَ إخْوَتُہُ أَنْ یَرُدُّوا وَصِیَّتَہُ ، فَارْتَفَعُوا إلَی شُرَیْحٍ ، فَأَجَازَ وَصِیَّۃَ الْغُلاَمِ۔","","Musannaf Ibn Abi Shaybah 31497","","","كتاب الوصايا"
"31498","(۳۱۴۹۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہِشَامٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : تَجُوزُ وَصِیَّۃُ الصَّبِیِّ فِی مَالِہِ فِی الثُّلُثِ فَمَا دُونَہُ۔","","Musannaf Ibn Abi Shaybah 31498","","","كتاب الوصايا"
"31499","(۳۱۴۹۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قُلْتُ لَہُ : تَجُوزُ وَصِیَّتُہُ ؟ قَالَ : جَائِزَۃٌ۔","","Musannaf Ibn Abi Shaybah 31499","","","كتاب الوصايا"
"31500","(۳۱۵۰۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عُمَارَۃَ ، قَالَ : سَمِعْتُ أَبَا عَمْرِو بْنِ الأَجْدَعِ ، قَالَ : اخْتَصَمَ إلَی عَلِیٍّ ظِئْرُ غُلاَمٍ ، فَأَمَرَ عَلِیٌّ أَنْ نُعْتِقَہُ ، فَأَعْتَقْنَاہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31500","","","كتاب الوصايا"
"31501",") حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ : أَنَّہُ قَالَ فِی وَصِیَّۃِ الصَّبِیِّ : أَیُّمَا مُوصٍ أَوْصَی فَأَصَابَ حَقًّا جَازَ۔","","Musannaf Ibn Abi Shaybah 31501","","","كتاب الوصايا"
"31502","( (۳۱۵۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنْ أَبِیہِ : أَنَّ صَبِیًّا أَوْصَی لِظِئْرٍ لَہُ مِنْ أَہْلِ الْحِیرَۃِ بِأَرْبَعِینَ دِرْہَمًا ، فَأَجَازَہُ شُرَیْحٌ۔","","Musannaf Ibn Abi Shaybah 31502","","","كتاب الوصايا"
"31503","(۳۱۵۰۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنْ أَبِیہِ ، عَنْ شُرَیْحٍ ، قَالَ : إذَا اتَّقَی الصَّبِیُّ الرُّکّی، أَنْ یَقَعَ فِیہَا فَقَدْ جَازَتْ وَصِیَّتُہُ۔","","Musannaf Ibn Abi Shaybah 31503","","","كتاب الوصايا"
"31504","(۳۱۵۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ تَجُوزُ وَصِیَّۃُ غُلاَمٍ وَلاَ جَارِیَۃٍ حَتَّی یُصَلِّیَا۔","","Musannaf Ibn Abi Shaybah 31504","","","كتاب الوصايا"
"31505","(۳۱۵۰۵) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ یَجُوزُ عِتْقُ الصَّبِیِّ ، وَلاَ وَصِیَّتُہُ ، وَلاَ بَیْعُہُ ، وَلاَ شِرَاؤُہُ ، وَلاَ طَلاَقُہُ۔","","Musannaf Ibn Abi Shaybah 31505","","","كتاب الوصايا"
"31506","(۳۱۵۰۶) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ: لاَ تَجُوزُ وَصِیَّۃُ غُلاَمٍ حَتَّی یَحْتَلِمَ، وَلاَ جَارِیَۃٍ حَتَّی تَحِیضَ۔","","Musannaf Ibn Abi Shaybah 31506","","","كتاب الوصايا"
"31507","(۳۱۵۰۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : وَصِیَّتُہُ لَیْسَتْ بِجَائِزَۃٍ إلاَّ مَا لَیْسَ بِذِی بَالٍ۔","","Musannaf Ibn Abi Shaybah 31507","","","كتاب الوصايا"
"31508","(۳۱۵۰۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ اللہِ ، عَنْ مَکْحُولٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : إذَا بَلَغَ الْغُلاَمُ خَمْسَۃَ عَشَرَ جَازَتْ وَصِیَّتُہُ۔","","Musannaf Ibn Abi Shaybah 31508","","","كتاب الوصايا"
"31509","(۳۱۵۰۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ تَجُوزُ وَصِیَّتُہُ۔","","Musannaf Ibn Abi Shaybah 31509","","","كتاب الوصايا"
"31510","(۳۱۵۱۰) حَدَّثَنَا أَبُو دَاوُدَ ، عَنِ الْمُسْتَمِرِّ بْنِ الرَّیَّانِ ، قَالَ : حضَرْت جَابِرَ بْنَ زَیْدٍ فِی الْمَسْجِدِ الْجَامِعِ ، وَقَالَ لَہُ زُرَارَۃُ بْنُ أَوْفَی - وَہُوَ یَوْمَئِذٍ عَلَی الْقَضَائِ : أَنَّہُ رُفِعَ إلَیَّ غُلاَمٌ أَعْتَقَ عَبْدًا لَہُ ، فَأَنْکَرَ ذَلِکَ الأَوْلِیَائُ ، فَرَأَیْت أَنْ أَرُدَّ ذَلِکَ ، ثُمَّ یُؤدِّی الْغُلاَمُ ، حَتَّی یَشِبَّ الْغُلاَمُ وَیُحِبَّ الْمَالَ ، فَإِنْ شَائَ أَنْ یَمْضِیَ أَمْضَی ، وَإِنْ شَائَ أَنْ یَرُدَّ رَدَّ۔","","Musannaf Ibn Abi Shaybah 31510","","","كتاب الوصايا"
"31511","(۳۱۵۱۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْف ، قَالَ : شَہِدْت ہِشَامَ بْنَ ہُبَیْرَۃٍ قَضَی فِی رَجُلٍ أَوْصَی لأُخْتٍ لَہُ عِنْدَ مَوْتِہِ بِمِثْلِ نَصِیبِ اثْنَیْنِ مِنْ وَلَدِہِ ، وَتَرَکَ الْمَیِّتُ بَنِینَ وَبَنَاتٍ ، فَأَرَادَتِ الْمُوصَی لَہَا أَنْ تَجْعَلَ نَفْسَہَا بِمَنْزِلَۃِ الذَّکَرِ ، وَأَبَی الْوَرَثَۃُ أَنْ یَجْعَلُوہَا إلاَّ بِمَنْزِلَۃِ الأُنْثَی ، فَقَضَی أَنَّہَا بِمَنْزِلَتِہَا إنْ لَمْ تَکُنْ تُبَیِّنَ۔","","Musannaf Ibn Abi Shaybah 31511","","","كتاب الوصايا"
"31512","(۳۱۵۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَوْفٍ الأَعْرَابِیِّ ، عَنْ ہِشَامِ بْنِ ہُبَیْرَۃَ : أَنَّہُ قَضَی فِی رَجُلٍ أَوْصَی لِرَجُلٍ بِمِثْلِ نَصِیبِ أَحَدِ وَلَدِہِ ، وَلَہُ ذَکَرٌ وَأُنْثَی ، أَنَّ لَہُ نَصِیبَ الأُنْثَی۔ قَالَ أَبُو بَکْرٍ : قَالَ وَکِیعٌ : قَالَ سُفْیَانُ : لَہُ نَصِیبُ أُنْثَی۔","","Musannaf Ibn Abi Shaybah 31512","","","كتاب الوصايا"
"31513","(۳۱۵۱۳) حَدَّثَنَا عُمَرُ ، عَنْ یُونُسَ ، عَنِ الزُّہْرِیِّ : فِی رَجُلٍ أَوْصَی لِرَجُلٍ بِفَرَسٍ وَسَمَّاہُ ، وَقَالَ : ثُلُثُ مَالِی لِفُلاَنٍ وَفُلاَنٍ ، وَکَانَ الْفَرَسُ کَفَاف ثُلُثِ مَالِہِ ، قَالَ الزُّہْرِیُّ : نَرَی أَنْ یُقَسِّمَ ثُلُثَ مَالِہِ عَلَی حِصَصِہِمْ۔","","Musannaf Ibn Abi Shaybah 31513","","","كتاب الوصايا"
"31514","(۳۱۵۱۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنِ الْحَسَنِ : أَنَّہُ قَالَ فِی رَجُلٍ أَوْصَی بِدَرَاہِمٍ وَبِالسُّدُسِ وَنَحْوِہِ : یَتَحَاصُّونَ جَمِیعًا۔","Hasan","Musannaf Ibn Abi Shaybah 31514","","","كتاب الوصايا"
"31515","(۳۱۵۱۵) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُوصِیَ الرَّجُلُ لِمَمْلُوکِہِ بِمِئَۃِ دِرْہَمٍ وَالْمِئَتَیْنِ إذَا رَضِیَ الأَوْلِیَائُ ، وَإِنْ جَعَلَ لَہُ شَیْئًا مِنْ ثُلُثِہِ فَہُوَ فِی عُنُقِہِ۔","","Musannaf Ibn Abi Shaybah 31515","","","كتاب الوصايا"
"31516","(۳۱۵۱۶) حَدَّثَنَا حَفْصٌ ، قَالَ : سَأَلْتُ عُمَرَاً عَنِ الرَّجُلِ یُوصِی لِعَبْدِہِ ؟ فَقَالَ : کَانَ الْحَسَنُ یَقُولُ : لَوْ أَوَصَی لَہُ بِرَغِیفٍ وَصِلَتُہُ عَتَاقَتُہُ۔","","Musannaf Ibn Abi Shaybah 31516","","","كتاب الوصايا"
"31517","(۳۱۵۱۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ شَبِیبِ بْنِ غَرْقَدَۃَ ، عَنْ جُنْدُبٍ ، قَالَ : سَأَلَ طَہْمَانُ ابْنَ عَبَّاسٍ : أَیُوصِی الْعَبْدُ ؟ قَالَ : لاَ۔","Da'if","Musannaf Ibn Abi Shaybah 31517","","","كتاب الوصايا"
"31518","(۳۱۵۱۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، قَالاَ : وَصِیَّۃُ الرَّجُلِ حَیْثُ جَعَلَہَا إلاَّ أَنْ یُتَّہَمَ الْوَصِیُّ بِہِ۔","","Musannaf Ibn Abi Shaybah 31518","","","كتاب الوصايا"
"31519","(۳۱۵۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : الْوَصِیُّ بِمَنْزِلَۃِ الْوَالِدِ ، وَإِذَا اتُّہِمَ الْوَصِیُّ عُزِلَ ، أَوْ جُعِلَ مَعَہُ غَیْرُہُ۔","","Musannaf Ibn Abi Shaybah 31519","","","كتاب الوصايا"
"31520","(۳۱۵۲۰) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ عُمَرَ ، قَالَ : إذَا کَانَتْ وَصِیَّۃٌ وَعَتَاقَۃٌ تَحَاصُّوا۔","Da'if","Musannaf Ibn Abi Shaybah 31520","","","كتاب الوصايا"
"31521","(۳۱۵۲۱) حَدَّثَنَا حَفْصٌ وَابْنُ عُلَیَّۃَ، عَنْ أَشْعَثَ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، قَالَ: إذَا کَانَتْ عَتَاقَۃٌ وَوَصِیَّۃٌ بُدِئَ بِالْعَتَاقَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 31521","","","كتاب الوصايا"
"31522","(۳۱۵۲۲) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ وَحَجَّاجٌ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ : أَنَّہُ کَانَ یَبْدَأُ بِالْعَتَاقَۃِ۔","","Musannaf Ibn Abi Shaybah 31522","","","كتاب الوصايا"
"31523","(۳۱۵۲۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یُوصِی بِعَتَاقِ عَبْدِہِ فِی مَرَضِہِ وَیُوصِی مَعَہُ بِوَصَایَا، قَالَ : یُبْدَأُ بِعَتَاقِ الْعَبْدِ قَبْلَ الْوَصَایَا ، فَإِنْ أَوْصَی أَنْ یَشْتَرِیَ لَہُ نَسَمَۃً فَتَعْتِقُ : کَانَتِ النَّسَمَۃُ کَسَائِرِ الْوَصِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 31523","","","كتاب الوصايا"
"31524","(۳۱۵۲۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ یُونُسَ، عَنِ الْحَسَنِ: أَنَّہُ کَانَ یَقُولُ : یُبْدَأُ بِالْعَتَاقِ وَإِنْ أَتَی ذَلِکَ عَلَی الثُّلُثِ کُلِّہِ۔","","Musannaf Ibn Abi Shaybah 31524","","","كتاب الوصايا"
"31525","(۳۱۵۲۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ : أَنَّہُ کَانَ یَقُولُ فِی الْوَصِیَّۃِ یَکُونُ فِیہَا الْعِتْقُ فَتَزِیدُ عَلَی الثُّلُثِ ، قَالَ : الثُّلُثُ بَیْنَہُمْ بِالْحِصَصِ۔","","Musannaf Ibn Abi Shaybah 31525","","","كتاب الوصايا"
"31526","(۳۱۵۲۶) حَدَّثَنَا ہُشَیْمٌ، عَنِ الشَّیْبَانِیِّ عَمَّنْ حَدَّثَہُ، عَنْ مَسْرُوقٍ: أَنَّہُ قَالَ فِی الْعَتَاقَۃِ وَالْوَصِیَّۃِ، قَالَ: یُبْدَأُ بِالْوَصِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 31526","","","كتاب الوصايا"
"31527","(۳۱۵۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ بِالْحِصَصِ۔","","Musannaf Ibn Abi Shaybah 31527","","","كتاب الوصايا"
"31528","(۳۱۵۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُبْدَأُ بِالْعَتَاقَۃِ۔","","Musannaf Ibn Abi Shaybah 31528","","","كتاب الوصايا"
"31529","(۳۱۵۲۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إنَّمَا یُبْدَأُ بِالْعَتَاقَۃِ إذَا سَمَّی مَمْلُوکًا بِعَیْنِہِ۔","","Musannaf Ibn Abi Shaybah 31529","","","كتاب الوصايا"
"31530","(۳۱۵۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : قَالَ سُفْیَانُ : إذَا أَوْصَی بِأَشْیَائَ ، وَقَالَ : أَعْتِقُوا عَنِّی فَبِالْحِصَصِ ، وَإِذَا أَوْصَی ، فَقَالَ : فُلاَنٌ حُرٌّ ، بُدِئَ بِالْعَتَاقَۃِ۔","","Musannaf Ibn Abi Shaybah 31530","","","كتاب الوصايا"
"31531","(۳۱۵۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یُبْدَأُ بِالْعَتَاقَۃِ۔","","Musannaf Ibn Abi Shaybah 31531","","","كتاب الوصايا"
"31532","(۳۱۵۳۲) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : بِالْحِصَصِ۔","","Musannaf Ibn Abi Shaybah 31532","","","كتاب الوصايا"
"31533","(۳۱۵۳۳) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ ، یُبْدَأُ بِالْعَتَاقَۃِ۔","","Musannaf Ibn Abi Shaybah 31533","","","كتاب الوصايا"
"31534","(۳۱۵۳۴) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ حَجَّاجٍ ، عَنِ الشَّعْبِیِّ : فِی رَجُلٌ مَاتَ وَتَرَکَ أَلْفَیْ دِرْہَمٍ وَعَبْدًا قِیمَتُہُ أَلْفُ دِرْہَمٍ ، وَأَوْصَی لِرَجُلٍ بِخَمْسِمِئَۃٍ وَأَعْتَق الْعَبْد ، قَالَ : یَعْتِقُ الْعَبْدُ وَتَبْطُلُ الْوَصِیَّۃُ۔","","Musannaf Ibn Abi Shaybah 31534","","","كتاب الوصايا"
"31535","(۳۱۵۳۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : فِی قَوْلِہِ : {وَإِذَا حَضَرَ الْقِسْمَۃَ أُوْلُواْ الْقُرْبَی وَالْیَتَامَی وَالْمَسَاکِینُ فَارْزُقُوہُم مِّنْہُ} فَحَدَّثَ عَنْ مُحَمَّدٍ ، عَنْ عَبِیدَۃَ : أَنَّہُ وَلِیَ وَصِیَّۃً فَأَمَرَ بِشَاۃٍ فَذُبِحَتْ فَصَنَعَ طَعَامًا لأَجْلِ ہَذِہِ الآیَۃِ ، وَقَالَ : لَوْلاَ ہَذِہِ الآیَۃُ لَکَانَ ہَذَا مِنْ مَالِی۔","","Musannaf Ibn Abi Shaybah 31535","","","كتاب الوصايا"
"31536","(۳۱۵۳۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی قَوْلِہِ : {وَإِذَا حَضَرَ الْقِسْمَۃَ أُولُوا الْقُرْبَی وَالْیَتَامَی وَالْمَسَاکِینُ فَارْزُقُوہُمْ مِنْہُ} قَالَ : کَانَ إذَا قَسَمَ الْقَوْمُ الْمِیرَاثَ ، وَکَانَ ہَؤُلاَئِ شُہُودًا رُضِخَ لَہُمْ مِنَ الْمِیرَاثِ ، فَإِنْ کَانُوا غَیَبًا وَأَحَدٌ مِنْہُمْ شَاہِدٌ ، فَإِنْ شَائَ أَعْطَی مِنْ نَصِیبِہِ وَإِلاَّ قَالَ لَہُمْ قَوْلاً مَعْرُوفًا ، قَالَ : یَقُولُ : إنَّ لَکُمْ فِیہِ حَقًّا۔","","Musannaf Ibn Abi Shaybah 31536","","","كتاب الوصايا"
"31537","(۳۱۵۳۷) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْعَالِیَۃِ وَالْحَسَنِ ، قَالاَ : یَرْضَخُونَ وَیَقُولُونَ قَوْلاً مَعْرُوفًا۔","","Musannaf Ibn Abi Shaybah 31537","","","كتاب الوصايا"
"31538","(۳۱۵۳۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ رَجُلٌ یَقْسِمُ مِیرَاثًا ، فَقَالَ لِصَاحِبِہِ : أَلاَ تَجِیئُ نُحْیِی آیَۃً مِنْ کِتَابِ اللہِ قَدْ أُمِیتَتْ ، فَقَسَمَ بَیْنَہُمْ مِنْ نَصِیبِہِ۔","","Musannaf Ibn Abi Shaybah 31538","","","كتاب الوصايا"
"31539","(۳۱۵۳۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عنَْسُفْیَانُ بْنُ حُسَیْنٍ، عَنِ الْحَسَنِ وَابْنِ سِیرِینَ: فِی قَوْلِہِ: {وَإِذَا حَضَرَ الْقِسْمَۃَ أُولُوا الْقُرْبَی وَالْیَتَامَی} ، قَالاَ : ہِیَ مُثبتۃٌ ، فَإِذَا حَضَرَتْ وَحَضَرَ ہَؤُلاَئِ الْقَوْمِ أُعْطُوا مِنْہَا وَرُضِخَ لَہُمْ۔","","Musannaf Ibn Abi Shaybah 31539","","","كتاب الوصايا"
"31540","(۳۱۵۴۰) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ: فِی قَوْلِہِ: {وَإِذَا حَضَرَ الْقِسْمَۃَ أُولُوا الْقُرْبَی} إنَّہَا مُحْکَمَۃٌ۔","","Musannaf Ibn Abi Shaybah 31540","","","كتاب الوصايا"
"31541","(۳۱۵۴۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، قَالَ : سَمِعْتُ یُونُسَ بْنَ جُبَیْر یُحَدِّثُ عَنْ حِطَّانَ ، عَنْ أَبِی مُوسَی: فِی ہَذِہِ الآیَۃِ : {إِذَا حَضَرَ الْقِسْمَۃَ أُولُوا الْقُرْبَی وَالْیَتَامَی وَالْمَسَاکِینُ فَارْزُقُوہُمْ مِنْہُ وَقُولُوا لَہُمْ قَوْلاً مَعْرُوفًا} قَالَ : قَضَی بِہَا أَبُو مُوسَی۔","Sahih","Musannaf Ibn Abi Shaybah 31541","","","كتاب الوصايا"
"31542","(۳۱۵۴۲) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ : أَنَّ عُرْوَۃَ قَسَمَ مِیرَاثَ أَخِیہِ مُصْعَبٍ ، فَأَعْطَی مَنْ حَضَرَہُ مِنْ ہَؤُلاَئِ وَبَنُوہُ صِغَارٌ۔","","Musannaf Ibn Abi Shaybah 31542","","","كتاب الوصايا"
"31543","(۳۱۵۴۳) حَدَّثَنَا عَبْدُ الصَّمَدِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مُوسَی وَعَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرٍ : أَنَّہُمَا کَانَا یُعْطِیَانِ مَنْ حَضَرَ مِنْ ہَؤُلاَئِ۔","","Musannaf Ibn Abi Shaybah 31543","","","كتاب الوصايا"
"31544","(۳۱۵۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَنْ أَبِی سَعِیدٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ : {وَإِذَا حَضَرَ الْقِسْمَۃَ أُولُوا الْقُرْبَی وَالْیَتَامَی وَالْمَسَاکِینُ فَارْزُقُوہُمْ مِنْہُ}، قَالَ : إنْ کَانُوا کِبَارًا رُضِخُوا ، وَإِنْ کَانُوا صِغَارًا اعْتُذِرَ إلَیْہِمْ ، فَذَلِکَ قَوْلہ {قَوْلاً مَعْرُوفًا}۔","","Musannaf Ibn Abi Shaybah 31544","","","كتاب الوصايا"
"31545","(۳۱۵۴۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : وَلِیَ أَبِی مِیرَاثًا فَأَمَرَ بِشَاۃٍ فَذُبِحَتْ فَصُنِعَتْ ، فَلَمَّا قَسَمَ ذَلِکَ الْمِیرَاثَ أَطْعَمَہُمْ ، وَقَالَ : لِمَنْ لَمْ یَرِثْ مَعْرُوفًا۔","","Musannaf Ibn Abi Shaybah 31545","","","كتاب الوصايا"
"31546","(۳۱۵۴۶) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَنْ أَبِی مَالِکٍ : نَسَخَتْہَا آیَۃُ الْمِیرَاثِ۔","","Musannaf Ibn Abi Shaybah 31546","","","كتاب الوصايا"
"31547","(۳۱۵۴۷) حَدَّثَنَا ابْنُ یَمَانٍ، عَنْ سُفْیَانَ، عَنِ الشَّیْبَانِیِّ، عَنْ عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: مُحْکَمَۃٌ لَیْسَتْ بِمَنْسُوخَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31547","","","كتاب الوصايا"
"31548","(۳۱۵۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ فِی الْمَسْجِدِ مَرَّۃً : سَمِعْت حَدِیثًا مَا بَقِیَ أَحَدٌ سَمِعَہُ غَیْرِی، سَمِعْت عَمْرَو بْنَ شُرَحْبِیلَ یَقُولُ: قَالَ عَبْدُ اللہِ: إنَّکُمْ مَعْشَرَ الْیَمَنِ مِنْ أَجْدَرِ قَوْمٍ أَنْ یَمُوتَ الرَّجُلُ، وَلاَ یَدْعُ عُصْبَۃً فَلْیَضَعْ مَالَہُ حَیْثُ شَائَ، قَالَ الأَعْمَشُ: فَقُلْتُ لإِبْرَاہِیمَ: إنَّ الشَّعْبِیَّ، قَالَ کَذَا وَکَذَا، قَالَ إبْرَاہِیمُ: حَدَّثَنِی ہَمَّامُ بْنُ الْحَارِثِ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ، عَنْ عَبْدِاللہِ مِثْلَہُ۔n(سعید بن منصور ۲۱۷)","Sahih","Musannaf Ibn Abi Shaybah 31548","","","كتاب الوصايا"
"31549","(۳۱۵۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَأَلْتُ عَبِیدَۃَ عَنْ رَجُلٍ لَیْسَ عَلَیْہِ عَقْدٌ وَلَیْسَ عَلَیْہِ عُصْبَۃٌ ، یُوصِی بِمَالِہِ کُلِّہِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 31549","","","كتاب الوصايا"
"31550","(۳۱۵۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ؛ سُئِلَ عَنْ رَجُلٍ مَاتَ وَلَمْ یَتْرُکْ مَوْلًی عَتَاقَۃٍ ، وَلاَ وَارِثًا ؟ قَالَ : مَالُہُ حیْثُ وَضَعَہُ ، فَإِنْ لَمْ یَکُنْ أَوْصَی بِشَیْئٍ فَمَالُہُ فِی بَیْتِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 31550","","","كتاب الوصايا"
"31551","(۳۱۵۵۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : فِی رَجُلٍ وَالَی رَجُلاً فَأَسْلَمَ عَلَی یَدَیْہِ ، قَالَ : إنْ شَائَ أَوْصَی بِمَالِہِ کُلِّہِ۔","","Musannaf Ibn Abi Shaybah 31551","","","كتاب الوصايا"
"31552","(۳۱۵۵۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ : أَنَّ أَبَا الْعَالِیَۃِ أَوْصَی بِمِیرَاثِہِ لِبَنِی ہَاشِمٍ۔","","Musannaf Ibn Abi Shaybah 31552","","","كتاب الوصايا"
"31553","(۳۱۵۵۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ : أَنَّ عَبْدَ اللہِ بْنَ مَسْعُودٍ وَعُثْمَانَ وَالْمِقْدَادَ بْنَ الأَسْوَدِ، وَعَبْدَ الرَّحْمَن بْنَ عَوْفٍ وَمُطِیعَ بْنَ الأَسْوَدِ أَوْصَوا إلَی الزُّبَیْرِ بْنِ الْعَوَّامِ ، قَالَ : وَأَوْصَی إلَی عَبْدِ اللہِ بْنِ الزُّبَیْرِ۔","","Musannaf Ibn Abi Shaybah 31553","","","كتاب الوصايا"
"31554","(۳۱۵۵۴) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : کَانَ وَصّی لِرَجُلٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31554","","","كتاب الوصايا"
"31555","(۳۱۵[corrupt]۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : أَوْصَی إلَیَّ ابْن عَمٍّ لِی ، قَالَ : فَکَرِہْت ذَلِکَ ، فَسَأَلْت عَمْرًا ؟ فَأَمَرَنِی أَنْ أَقْبَلَہَا ، قَالَ : وَکَانَ ابْنُ سِیرِینَ یَقْبَلُ الْوَصِیَّۃَ۔","","Musannaf Ibn Abi Shaybah 31555","","","كتاب الوصايا"
"31556","(۳۱۵۵۶) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ إسْمَاعِیلَ، عَنْ قَیْسٍ، قَالَ: کَانَ أَبُو عُبَیْد عَبَرَ الْفُرَاتِ فَأَوْصَی إلَی عُمَرَ بْنِ الْخَطَّابِ۔","Sahih","Musannaf Ibn Abi Shaybah 31556","","","كتاب الوصايا"
"31557","(۳۱۵۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ أَبِی الْہَیْثُمَّ ، قَالَ : بَعَثَ إلَیَّ إبْرَاہِیمُ فَأَوْصَی إلَیَّ۔","","Musannaf Ibn Abi Shaybah 31557","","","كتاب الوصايا"
"31558","(۳۱۵۵۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عَامِرِ بْنِ سَعْدٍ ، عَنْ أَبِیہِ : أَنَّہُ قَالَ : مَرِضَ مَرَضًا أَشْفَی مِنْہُ ، فَأَتَاہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَعُودُہُ ، فَقَالَ : یَا رَسُولَ اللہِ ، إنَّ لِی مَالاً کَثِیرًا وَلَیْسَ یَرِثُنِی إِلاَّ ابْنَۃٌ لِی ، أَفَأَتَصَدَّقُ بِالثُّلُثَیْنِ ؟ قَالَ : لاَ ، قَالَ : فَالشَّطْرَ ؟ قَالَ : لاَ ، قُلْتُ : فَالثُّلُثُ ؟ قَالَ : الثُّلُثُ کَثِیرٌ۔n(بخاری ۶۷۳۳۔ مسلم ۱۲۵۲)","Sahih","Musannaf Ibn Abi Shaybah 31558","","","كتاب الوصايا"
"31559","(۳۱۵۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : وَدِدْت أَنَّ النَّاسَ غَضُّوا مِنَ الثُّلُثِ إلَی الرُّبُعِ ، لأَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الثُّلُثُ کَثِیرٌ۔ (بخاری ۲۷۴۳۔ مسلم ۱۲۵۳)","Sahih","Musannaf Ibn Abi Shaybah 31559","","","كتاب الوصايا"
"31560","(۳۱۵۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، أَنَّ الزُّبَیْرَ أَوْصَی بِثُلُثِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31560","","","كتاب الوصايا"
"31561","(۳۱۵۶۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : ذُکِرَ عِنْدَ عُمَرَ الثُّلُثُ فِی الْوَصِیَّۃِ ، قَالَ : الثُّلُثُ وَسَطٌ لاَ بَخْسٌ ، وَلاَ شَطَطٌ۔","Sahih","Musannaf Ibn Abi Shaybah 31561","","","كتاب الوصايا"
"31562","(۳۱۵۶۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ : أَنَّ مُعَاذَ بْنَ جَبَلٍ قَالَ : إنَّ اللَّہَ تَصَدَّقَ عَلَیْکُمْ بِثُلُثِ أَمْوَالِکُمْ زِیَادَۃً فِی حَیَاتِکُمْ۔ یَعْنِی : الْوَصِیَّۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 31562","","","كتاب الوصايا"
"31563","(۳۱۵۶۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ خَالِدِ بْنِ أَبِی عَزَّۃَ ، قَالَ : قَالَ أَبُو بَکْرٍ : آخُذُ مِنْ مَالِی مَا أَخَذَ اللَّہُ مِنَ الْفَیْئِ فَأَوْصَی بِالْخُمُسِ۔","Da'if","Musannaf Ibn Abi Shaybah 31563","","","كتاب الوصايا"
"31564","(۳۱۵۶۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : أَوْصَی أَبُو بَکْرٍ وَعَلِیٌّ بِالْخُمُسِ۔","Da'if","Musannaf Ibn Abi Shaybah 31564","","","كتاب الوصايا"
"31565","(۳۱۵۶۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ : أَنَّ حُمَیْدَ بْنَ عَبْدِ الرَّحْمَنِ ، قَالَ : مَا کُنْت لأَقْبَلَ وَصِیَّۃَ رَجُلٍ یُوصِی بِالثُّلُثِ وَلَہُ وَلَدٌ۔","","Musannaf Ibn Abi Shaybah 31565","","","كتاب الوصايا"
"31566","(۳۱۵۶۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ شُرَیْحٍ ، قَالَ : الثُّلُثُ جَیِّدٌّ وَہُوَ جَائِزٌ۔","Sahih","Musannaf Ibn Abi Shaybah 31566","","","كتاب الوصايا"
"31567","(۳۱۵۶۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ بَشِیرِ بْنِ عُقْبَۃَ ، عَنْ یَزِیدَ بْنِ الشِّخِّیرِ ، قَالَ : کَانَ مُطَرِّفٌ یَرَی الْخُمُسَ فِی الْوَصِیَّۃِ حَسَنًا۔","","Musannaf Ibn Abi Shaybah 31567","","","كتاب الوصايا"
"31568","(۳۱۵۶۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَقُولُونَ الَّذِی یُوصِی بِالْخُمُسِ أَفْضَلُ مِنَ الَّذِی یُوصِی بِالرُّبُعِ ، وَالَّذِی یُوصِی بِالرُّبُعِ أَفْضَلُ مِنَ الَّذِی یُوصِی بِالثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31568","","","كتاب الوصايا"
"31569","(۳۱۵۶۹) حَدَّثَنَا یَعْلَی وَابْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إنَّمَا کَانُوا یُوصُونَ بِالْخُمُسِ وَالرُّبُعِ ، وَالثُّلُثُ مُنْتَہَی الْجَامِحِ ، وَقَالَ ابْنُ نُمَیْرٍ : مُنْتَہَی الْجِمَاحِ۔","","Musannaf Ibn Abi Shaybah 31569","","","كتاب الوصايا"
"31570","(۳۱۵۷۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : لأَنْ أُوصِیَ بِالْخُمُسِ أَحَبُّ إلَیَّ مِنْ أَنْ أُوصِیَ بِالرُّبُعِ ، وَلأَنْ أُوصِیَ بِالرُّبُعِ أَحَبُّ إلَیَّ مِنْ أَنْ أُوصِیَ بِالثُّلُثِ ، وَمَنْ أَوْصَی لَمْ یَتْرُکْ۔","Da'if","Musannaf Ibn Abi Shaybah 31570","","","كتاب الوصايا"
"31571","(۳۱۵۷۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا مَنْدَل ، عَنِ الأَعْمَشِ ، عَنْ طَلْحَۃَ ، عَنْ أَبِی عَمَّارٍ ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ ، قَالَ : الثُّلُثُ حَیْفٌ وَالرُّبُعُ حَیْفٌ۔","","Musannaf Ibn Abi Shaybah 31571","","","كتاب الوصايا"
"31572","(۳۱۵۷۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا مَنْدَل ، عَنِ الأَعْمَشِ ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، عَنِ الْعَبَّاسِ ، قَالَ : الرُّبُعُ حَیْفٌ وَالثُّلُثُ حَیْفٌ۔","","Musannaf Ibn Abi Shaybah 31572","","","كتاب الوصايا"
"31573","(۳۱۵۷۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، قَالَ : قَالَ إبْرَاہِیمُ : کَانَ یُقَالَ : السُّدُسُ خَیْرٌ مِنَ الثُّلُثِ فِی الْوَصِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 31573","","","كتاب الوصايا"
"31574","(۳۱۵۷۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : کَانُوا یَسْتَحِبُّونَ أَنْ یَتْرُکُوا مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31574","","","كتاب الوصايا"
"31575","(۳۱۵۷۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ قُثَم مَوْلَی ابْنِ عَبَّاسٍ ، قَالَ : قَالَ عَلِیٌّ : وَصِیَّتِی إلَی أَکْبَرِ وَلَدِی غَیْرَ طَاعن عَلَیْہِ فِی بَطْنٍ وَلاَ فِی فَرْجٍ۔","Hasan","Musannaf Ibn Abi Shaybah 31575","","","كتاب الوصايا"
"31576","(۳۱۵۷۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَا حَقُّ امْرِئٍ مُسْلِمٍ یَبِیتُ لَیْلَتَیْنِ وَلَہُ شَیْئٌ یُوصِی بِہِ ، إلاَّ وَوَصِیَّتُہُ مَکْتُوبَۃٌ عِنْدَہُ۔n(مسلم ۱۲۴۹۔ ابوداؤد ۲۸۵۴)","Sahih","Musannaf Ibn Abi Shaybah 31576","","","كتاب الوصايا"
"31577","(۳۱۵۷۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ عَامِرٍ ، قَالَ : مَنْ أَوْصَی بِوَصِیَّۃٍ لَمْ یَحِفْ فِیہَا وَلَمْ یُضَارَّ أَحَدًا أَنْ یَکُونَ لَہُ مِنَ الأَجْرِ مَا لَوْ تَصَدَّقَ بِہِ فِی حَیَاتِہِ فِی صِحَّتِہِ۔","","Musannaf Ibn Abi Shaybah 31577","","","كتاب الوصايا"
"31578","(۳۱۵۷۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ دَاوُدَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الضِّرَارُ فِی الْوَصِیَّۃِ مِنَ الْکَبَائِرِ ، ثُمَّ تَلاَ {غَیْرَ مُضَارٍّ وَصِیَّۃً مِنَ اللہِ}۔","Da'if","Musannaf Ibn Abi Shaybah 31578","","","كتاب الوصايا"
"31579","(۳۱۵۷۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، قَالَ : ذَہَبْت أَنَا وَالْحُکْمُ إلَی سَعِیدِ بْنِ جُبَیْرٍ فَسَأَلْتُہُ عَنْ قولہ : {وَلْیَخْشَ الَّذِینَ لَوْ تَرَکُوا مِنْ خَلْفِہِمْ ذُرِّیَّۃً ضِعَافًا خَافُوا عَلَیْہِمْ} إلَی قَوْلہ {سَدِیدًا} قَالَ : ہُوَ الَّذِی یَحْضُرُہُ الْمَوْتُ فَیَقُولُ لَہُ مَنْ یَحْضُرُہُ : اتَّقِ اللَّہَ وَأَعْطِہِمْ صِلْہُمْ بَرَّہُمْ وَلَوْ کَانُوا ہُمَ الَّذِینَ یَأْمُرُونَہُ بِالْوَصِیَّۃِ لأَحَبُّوا أَنْ یُنْفِقُوا لأَوْلاَدِہِمْ۔n فَأَتَیْنَا مِقْسَمًا فَسَأَلَنَاہ ؟ فَقَالَ : مَا قَالَ سَعِیدٌ ؟ فَقُلْنَا : کَذَا وَکَذَا ، قَالَ : لاَ ، وَلَکِنَّہُ الرَّجُلُ یَحْضُرُہُ الْمَوْتُ فَیُقَالُ لَہُ : اتَّقِ اللَّہَ وَأَمْسِکْ عَلَیْک مَالِکَ فَإِنَّہُ لَیْسَ أَحَدٌ أَحَقَّ بِمَالِکَ مِنْ وَلَدِکَ وَلَوْ کَانَ الَّذِی یُوصِی ذَا قَرَابَۃٍ لاَحَبُّوا أَنْ یُوصِیَ لَہُمْ۔","","Musannaf Ibn Abi Shaybah 31579","","","كتاب الوصايا"
"31580","(۳۱۵۸۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ دَاوُدَ بْنَ أَبِی ہِنْدٍ ، عَنِ الْقَاسِمِ بْنِ عَمْروٍ ، قَالَ : اشْتَکَی أَبِی فَلَقِیت ثُمَامَۃَ بْنَ حَزَنٍ الْقُشَیْرِیَّ ، فَقَالَ لِی : أَوْصَی أَبُوک ؟ قُلْتُ : لاَ ، قَالَ : إنِ اسْتَطَعْت أَنْ یُوصِیَ فَلْیُوصِ ، فَإِنَّہَا تَمَامٌ لِمَا انْتَقَصَ مِنْ زَکَاتِہِ۔ (طبرانی ۶۹)","","Musannaf Ibn Abi Shaybah 31580","","","كتاب الوصايا"
"31581","(۳۱۵۸۱) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الضِّرَارُ فِی الْوَصِیَّۃِ مِنَ الْکَبَائِرِ ، ثُمَّ قَرَأَ: {وَمَنْ یَعْصِ اللَّہَ وَرَسُولَہُ وَیَتَعَدَّ حُدُودَہُ یُدْخِلْہُ نَارًا خَالِدًا فِیہَا}۔","Hasan","Musannaf Ibn Abi Shaybah 31581","","","كتاب الوصايا"
"31582","(۳۱۵۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی إبْرَاہِیمُ بْنُ مَیْسَرَۃَ ، أَنَّہُ سَمِعَ طَاوُوسًا یَقُولُ : مَا مِنْ مُسْلِمٍ یُوقِنُ بِالْوَصِیَّۃِ یَمُوتُ لَمْ یُوصِ إلاَّ أَہْلُہُ مَحْقُوقُونَ أَنْ یُوصُوا عَنْہُ۔","","Musannaf Ibn Abi Shaybah 31582","","","كتاب الوصايا"
"31583","(۳۱۵۸۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، قَالَ : حَدَّثَنَا أَبُو حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إِنَّمَا کَانُوا یَکْرَہُونَ أَنْ یَمُوتَ الرَّجُلُ قَبْلَ أَنْ یُوصِیَ قَبْلَ أَنْ تُنَزَّلَ الْمَوَارِیثُ۔","","Musannaf Ibn Abi Shaybah 31583","","","كتاب الوصايا"
"31584","(۳۱۵۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ طَلْحَۃَ ، قَالَ : قُلْتُ لاِبْنِ أَبِی أَوْفَی : أَوْصَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : لاَ ، قُلْتُ : فَکَیْفَ أَمَرَ النَّاسَ بِالْوَصِیَّۃِ ؟ قَالَ : أَوْصَی بِکِتَابِ اللہِ۔n(بخاری ۲۷۴۰۔ مسلم ۱۲۵۶)","Sahih","Musannaf Ibn Abi Shaybah 31584","","","كتاب الوصايا"
"31585","(۳۱۵۸۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ وَابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیق ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : مَا تَرَکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دِینَارًا ، وَلاَ دِرْہَمًا ، وَلاَ أَوْصَی بِشَیْئٍ۔ (مسلم ۱۲۵۶۔ ابن ماجہ ۲۶۹۵)","Sahih","Musannaf Ibn Abi Shaybah 31585","","","كتاب الوصايا"
"31586","(۳۱۵۸۶) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَرَقْمَ بْنِ شُرَحْبِیلَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَاتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَلَمْ یُوصِ۔ (احمد ۳۴۳۔ ابویعلی ۲۵۵۳)","","Musannaf Ibn Abi Shaybah 31586","","","كتاب الوصايا"
"31587","(۳۱۵۸۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : ذَکَرُوا عِنْدَ عَائِشَۃَ أَنَّ عَلِیًّا کَانَ وَصِیًّا ، فَقَالَتْ : مَتَی أَوْصَی إلَیْہِ ؟ فَلَقَدْ کُنْت مُسْنِدَتَہُ إلَی حِجْرِی ، فَانْخَنَثَ فَمَاتَ ، فَمَتَی أَوْصَی إلَیْہِ؟!۔n(بخاری ۲۷۴۱۔ احمد ۳۲)","Sahih","Musannaf Ibn Abi Shaybah 31587","","","كتاب الوصايا"
"31588","(۳۱۵۸۸) حَدَّثَنَا ابْنِ جُرَیْجٍ، عَنْ لَیْثٍ، عَنْ طَاوُوسٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: إِذَا تَرَکَ الْمَیِّت سَبْعمِئۃ دِرْہَم فَلا یُوصِی۔n(سعید بن منصور ۲۵۰)","Da'if","Musannaf Ibn Abi Shaybah 31588","","","كتاب الوصايا"
"31589","(۳۱۵۸۹) حَدَّثَنَا زَیْدُ بْنُ حَبَّابٍ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ {إنْ تَرَکَ خَیْرًا الْوَصِیَّۃُ} قَالَ : خَیْرُ الْمَالِ ، کَانَ یُقَالَ : أَلْفُ دِرْہَمٍ فَصَاعِدًا۔","","Musannaf Ibn Abi Shaybah 31589","","","كتاب الوصايا"
"31590","(۳۱۵۹۰) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ : أَنَّ عَلِیًّا دَخَلَ عَلَی رَجُلٍ مِنْ بَنِی ہَاشِمٍ یَعُودُہُ ، فَأَرَادَ أَنْ یُوصِیَ فَنَہَاہُ ، وَقَالَ : إنَّ اللَّہَ یَقُولُ : {إنْ تَرَکَ خَیْرًا} وَإِنَّک لَمْ تَدَعْ مَالا ، فَدَعْہُ لِعِیَالِک۔","Hasan","Musannaf Ibn Abi Shaybah 31590","","","كتاب الوصايا"
"31591","(۳۱۵۹۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُحَمَّدِ بْنِ شَرِیکٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَائِشَۃَ ، قَالَ : قَالَ لَہَا رَجُلٌ : إنِّی أُرِیدُ أَنْ أُوصِیَ ، قَالَتْ : کَمْ مَالُک ؟ قَالَ : ثَلاَثَۃُ آلاَفٍ ، قَالَتْ : فَکَمْ عِیَالُک ؟ قَالَ : أَرْبَعَۃٌ ، قَالَتْ : فَإِنَّ اللَّہَ یَقُولُ : {إنْ تَرَکَ خَیْرًا} وَإِنَّہُ شَیْئٌ یَسِیرٌ ، فَدَعْہُ لِعِیَالِکَ فَإِنَّہُ أَفْضَلُ۔","Sahih","Musannaf Ibn Abi Shaybah 31591","","","كتاب الوصايا"
"31592","(۳۱۵۹۲) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ حَبِیبٍ، عَنْ إبْرَاہِیمَ: فِی قَوْلِہِ {وَصِیَّۃً لأَزْوَاجِہِمْ} قَالَ: ہِیَ مَنْسُوخَۃٌ۔","","Musannaf Ibn Abi Shaybah 31592","","","كتاب الوصايا"
"31593","(۳۱۵۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْجَہْضَمِ ، عَنْ عَبْدِ اللہِ بْنِ بَدْرٍ ، عَنِ ابْنِ عُمَرَ {إنْ تَرَکَ خَیْرًا الْوَصِیَّۃُ} ، قَالَ : نَسَخَتْہَا آیَۃُ الْمِیرَاثُ۔","Sahih","Musannaf Ibn Abi Shaybah 31593","","","كتاب الوصايا"
"31594","(۳۱۵۹۴) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ قَالَ: نَسَخَتْہَا آیَۃُ الْفَرَائِضِ، وَتَرَکَ الأَقْرَبُونَ مِمَّنْ لاَ یَرِثُ۔","","Musannaf Ibn Abi Shaybah 31594","","","كتاب الوصايا"
"31595","(۳۱۵۹۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : الْوَصِیَّۃُ لَیْسَتْ بِمَضْمُونَۃٍ ، إنَّمَا ہِیَ بِمَنْزِلَۃِ الدَّیْنِ فِی مَالِ الرَّجُلِ۔","","Musannaf Ibn Abi Shaybah 31595","","","كتاب الوصايا"
"31596","(۳۱۵۹۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ : أَنَّہُ کَانَ یَرَی الْوَصِیَّۃَ مَضْمُونَۃً۔","","Musannaf Ibn Abi Shaybah 31596","","","كتاب الوصايا"
"31597","(۳۱۵۹۷) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : إذَا أَوْصَی رَجُلٌ إلَی رَجُلٍ غَائِبٍ ، ثُمَّ قَدِمَ فَأَقَرَّ بِالْوَصِیَّۃِ ، ثُمَّ أَنْکَرَ فَلَیْسَ لَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 31597","","","كتاب الوصايا"
"31598","(۳۱۵۹۸) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، أَنَّہُ قَرَأَ عَلَی فُضَیْلِ بْنِ مَیْسَرَۃَ ، عَنْ أَبِی حَرِیزٍ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ ، عَنْ عُمَرَ ، قَالَ : إذَا الْتَقَی الزَّحْفَانِ وَالْمَرْأَۃُ یَضْرِبُہَا الْمَخَاضُ لاَ یَجُوزُ لَہُمَا فِی مَالِہِمَا إلاَّ الثُّلُثُ۔","Da'if","Musannaf Ibn Abi Shaybah 31598","","","كتاب الوصايا"
"31599","(۳۱۵۹۹) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یُعْطِی فِی الْمُزَاحَفَۃِ وَرُکُوبِ الْبَحْرِ وَالطَّاعُونِ وَالْحَامِلِ ، قَالَ : مَا أَعْطَوا فَہُوَ جَائِزٌ ، لاَ یَکُن مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31599","","","كتاب الوصايا"
"31600","(۳۱۶۰۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : مَا صَنَعَت الْحَامِلُ فِی شَہْرِہَا فَہُوَ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31600","","","كتاب الوصايا"
"31601","(۳۱۶۰۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : فِی الرَّجُلِ یَکُونُ بِہِ السِّلُّ وَالْحُمَّی وَہُوَ یَجِیئُ وَیَذْہَبُ ، قَالَ : مَا صَنَعَ مِنْ شَیْئٍ فَہُوَ مِنْ جَمِیعِ الْمَالِ ، إلاَّ أَنْ یَکُونَ أُضْنِی عَلَی فِرَاشِہِ۔","","Musannaf Ibn Abi Shaybah 31601","","","كتاب الوصايا"
"31602","(۳۱۶۰۲) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : مَا صَنَعَتِ الْحَامِلُ فَہُوَ وَصِیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 31602","","","كتاب الوصايا"
"31603","(۳۱۶۰۳) حَدَّثَنَا وَکِیعٌ قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنِِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : الْحَامِلُ وَصِیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 31603","","","كتاب الوصايا"
"31604","(۳۱۶۰۴) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ ، قَالَ : الْحَامِلُ وَصِیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 31604","","","كتاب الوصايا"
"31605","(۳۱۶۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ أَعْطَتِ امْرَأَتِی عَطیَّۃ وَہِیَ حَامِلٌ ، فَقَالَتْ لِلْقَاسِمِ بْنِ مُحَمَّدٍ ، فَقَالَ : ہُوَ مِنْ جَمِیعِ الْمَالِ۔n قَالَ حَمَّادٌ : قَالَ یَحْیَی : وَنَحْنُ نَقُولُ : ہُوَ مِنْ جَمِیعِ الْمَالِ مَا لَمْ یَضْرِبْہَا الطَّلْقُ۔","","Musannaf Ibn Abi Shaybah 31605","","","كتاب الوصايا"
"31606","(۳۱۶۰۶) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : الْحَامِلُ وَصِیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 31606","","","كتاب الوصايا"
"31607","(۳۱۶۰۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُحَمَّدٍ ، قَالَ : حُبِسَ إیَاسُ بْنُ مُعَاوِیَۃَ فِی الظِّنَّۃِ ، فَأَرْسَلِنِی ، فَقَالَ : انْطَلِقْ إلَی الْحَسَنِ فَاسْأَلْہُ مَا حَالِی فِیمَا أخذتُ مِنْ مَالِی عَلَی حَالِی ہَذِہِ ؟ قَالَ : فَأَتَیْت الْحَسَنَ فَقُلْتُ لَہُ : إنَّ أَخَاک إیَاسًا یُقْرِئُک السَّلاَمَ وَیَقُولُ : مَالِی فِیمَا أحدِثُ فِی یَوْمِی ہَذَا ؟ فَقَالَ الْحَسَنُ : حَالُہُ حَالُ الْمَرِیضِ ، لاَ یَجُوزُ لَہُ إلاَّ الثُّلُثُ۔","","Musannaf Ibn Abi Shaybah 31607","","","كتاب الوصايا"
"31608","(۳۱۶۰۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ سِمَاکٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا وَضَعَ رِجْلَہُ فِی الْغَرْزِ فَمَا أَوْصَی بِہِ فَہُوَ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31608","","","كتاب الوصايا"
"31609","(۳۱۶۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : إذَا وَضَعَ رِجْلَہُ فِی الْغَرْزِ فَمَا تَکَلَّمَ بِہِ مِنْ شَیْئٍ فَہُوَ مِنْ ثُلُثِہِ۔","","Musannaf Ibn Abi Shaybah 31609","","","كتاب الوصايا"
"31610","(۳۱۶۱۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ سِمَاکٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، أَنَّہُ قَالَ : إذَا وَضَعَ الرَّجُلُ رِجْلَہُ فِی الْغَرْزِ یَقُولُ : إذَا سَافَرَ فَمَا أَوْصَی بِہِ فَہُوَ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31610","","","كتاب الوصايا"
"31611","(۳۱۶۱۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : فِی الأَسِیرِ فِی أَیْدِی الْعَدُوِّ : إنْ أَعْطَی عَطِیَّۃً ، أَوْ نَحَلَ نَحْلاً ، أَوْ أَوْصَی بِثُلُثِہِ فَہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 31611","","","كتاب الوصايا"
"31612","(۳۱۶۱۲) حَدَّثَنَا مَعْن بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ یَجُوزُ لِلأَسِیرِ فِی مَالِہِ إلاَّ الثُّلُثُ۔","","Musannaf Ibn Abi Shaybah 31612","","","كتاب الوصايا"
"31613","(۳۱۶۱۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : بَیْعُ الْوَصِیِّ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 31613","","","كتاب الوصايا"
"31614","(۳۱۶۱۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ شَرِیکٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : الْوَصِیُّ بِمَنْزِلَۃِ الأَبِ۔","","Musannaf Ibn Abi Shaybah 31614","","","كتاب الوصايا"
"31615","(۳۱۶۱۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ یَحْیَی بْنِ حَمْزَۃَ ، عَنْ أَبِی وَہْبٍ ، قَالَ : أمْرُ الْوَصِیِّ جَائِزٌ إلاَّ فِی الرِّبَاعِ ، وَإِنْ بَاعَ بَیْعًا لَمْ یُقَلْ۔","","Musannaf Ibn Abi Shaybah 31615","","","كتاب الوصايا"
"31616","(۳۱۶۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، قَالَ : یَنْظُرُ والِی الْیَتِیمِ مِثْلُ مَا یُرَی لِلْیَتِیمِ یَعْمَل لِلْیَتِیمِ بِہِ۔","","Musannaf Ibn Abi Shaybah 31616","","","كتاب الوصايا"
"31617","(۳۱۶۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : الْوَصِیُّ بِمَنْزِلَۃِ الْوَالِدِ۔","","Musannaf Ibn Abi Shaybah 31617","","","كتاب الوصايا"
"31618","(۳۱۶۱۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ : أَنَّ شُرَیْحًا کَانَ یُجِیزُ شَہَادَۃَ الأَوْصِیَائِ۔","","Musannaf Ibn Abi Shaybah 31618","","","كتاب الوصايا"
"31619","(۳۱۶۱۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، مِثْلُہُ۔","","Musannaf Ibn Abi Shaybah 31619","","","كتاب الوصايا"
"31620","(۳۱۶۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ تَجُوزُ ، ہُوَ خَصْمٌ۔","","Musannaf Ibn Abi Shaybah 31620","","","كتاب الوصايا"
"31621","(۳۱۶۲۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ : أَنَّ عُمَرَ أَوْصَی لأُمَّہَاتِ أَوْلاَدِہِ بِأَرْبَعَۃِ آلاَفٍ ، أَرْبَعَۃِ آلاَفٍ۔","Hasan","Musannaf Ibn Abi Shaybah 31621","","","كتاب الوصايا"
"31622","(۳۱۶۲۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنِ الْحَسَنِ : أَنَّ عِمْرَانَ بْنَ حُصَیْنٍ أَوْصَی لأُمَّہَاتِ أَوْلاَدِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31622","","","كتاب الوصايا"
"31623","(۳۱۶۲۳) حَدَّثَنَا خَالِدُ بْنُ حَیَّانَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : قُلْتُ لِمَیْمُونِ بْنِ مِہْرَانَ : الرَّجُلُ یُوصِی لأُمِّ وَلَدِہِ ؟ قَالَ : ہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 31623","","","كتاب الوصايا"
"31624","(۳۱۶۲۴) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : أَوْصَی الشَّعْبِیُّ لأُمِّ وَلَدِہِ۔","","Musannaf Ibn Abi Shaybah 31624","","","كتاب الوصايا"
"31625","(۳۱۶۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یَہَبُ لأُمِّ وَلَدِہِ ، قَالَ : ہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 31625","","","كتاب الوصايا"
"31626","(۳۱۶۲۶) حَدَّثَنَا مُعْتَمِرٌ، قَالَ: قُلْتُ لِیُونُسَ: رَجُلٌ وَہَبَ لأُمِّ وَلَدٍ شَیْئًا ثُمَّ مَاتَ؟ قَالَ: کَانَ الْحَسَنُ یَقُولُ: ہُوَ لَہَا۔","","Musannaf Ibn Abi Shaybah 31626","","","كتاب الوصايا"
"31627","(۳۱۶۲۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَحْرَزَتْ أُمُّ الْوَلَدِ شَیْئًا فِی حَیَاۃِ سَیِّدِہَا فَمَاتَ سَیِّدُہَا فَہُوَ لَہَا وَقَدْ عَتَقَتْ ، فَإِنِ انْتَزَعَ الْمَیِّتُ شَیْئًا قَبْلَ أَنْ یَمُوتَ ، أَوْ أَوْصَی بِشَیْئٍ مِمَّا کَانَتْ أَحْرَزَتْ فِی حَیَاتِہِ : یَصْنَعُ فِیہِ مَا شَائَ۔","","Musannaf Ibn Abi Shaybah 31627","","","كتاب الوصايا"
"31628","(۳۱۶۲۸) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْکَرِیمِ بْنِ رُفَیْعٍ ، قَالَ : تُوُفِّیَ رَجُلٌ بِالرَّیِّ وَتَرَکَ مَالاً وَرَقِیقًا ، فَقَالَ : عَبْدِی فُلاَنٌ لِفُلاَنٍ وَعَبْدِی فُلاَنٌ لِفُلاَنٍ ، وَلَمْ تَبْلُغْ وَصِیَّتُہُ الثُّلُثَ ، فَلَمَّا أَقْبَلَ بِالرَّقِیقِ إلَی الْکُوفَۃِ مَاتَ بَعْضُ رَقِیقِ الْوَرَثَۃِ ، وَلَمْ یَمُتْ رَقِیقُ الَّذِی أَوْصَی لَہُمْ ، فَسَأَلْت إبْرَاہِیمَ ؟ فَقَالَ : یُعْطَی أَصْحَابَ الْوَصِیَّۃِ عَلَی مَا أَوْصَی بِہِ صَاحِبُہُ۔","","Musannaf Ibn Abi Shaybah 31628","","","كتاب الوصايا"
"31629","(۳۱۶۲۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ: فِی رَجُلٍ جَعَلَ وَصِیَّتَہُ إلَی مُکَاتَبِہِ ، فَقَالَ : الْمُکَاتَبُ : إنِّی قَدْ أَنْفَقْت مُکَاتَبَتِی عَلَی عِیَالِ مَوْلاَیَ ، فَقَالَ : یُصَدَّقُ ، وَیَجُوزُ ذَلِکَ ، وَلاَ بَأْسَ أَنْ یُوصِیَ إلَی عَبْدِہِ ، فَإِنْ قَالَ الْعَبْدُ : إنِّی قَدْ کَاتَبْت نَفْسِی ، أَوْ بِعْت نَفْسِی ، لَمْ یَجُزْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 31629","","","كتاب الوصايا"
"31630","(۳۱۶۳۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : سُئِلَ عَنْ رَجُلٍ أَوْصَی لِبَنِی ہَاشِمٍ ، أَیَدْخُلُ مَوَالِیہِمْ مَعَہُمْ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 31630","","","كتاب الوصايا"
"31631","(۳۱۶۳۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : أَنَّ سَعْدَ بْنَ عُبَادَۃَ قَسَمَ مَالَہُ بَیْنَ وَرَثَتِہِ عَلَی کِتَابِ اللہِ ، وَامْرَأَۃٌ لَہُ قَدْ وَضَعَتْ رَجُلاً ، فَأَرْسَلِ أَبُو بَکْرٍ وَعُمَرُ إلَی قَیْسِ بْنِ سَعْدٍ أَنْ أَخْرِجْ لِہَذَا الْغُلاَمِ حَقَّہُ ، قَالَ : قَالَ أَمَّا شَیْئٌ صَنَعَہُ سَعْدٌ فَلاَ أَرْجِعُ فِیہِ ، وَلَکِنْ نَصِیبِی لَہُ ، فَقِبَلاَ ذَلِکَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 31631","","","كتاب الوصايا"
"31632","(۳۱۶۳۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَیَانٍ ، عَنْ وَبَرَۃَ ، قَالَ : اشْتَرَی رَجُلٌ أُخْتًا لَہُ کَانَتْ سُبِیَّت فِی الْجَاہِلِیَّۃِ فَاشْتَرَاہَا وَابْنًا لَہَا لاَ یُدْرَی مَنْ أَبُوہُ ، فَشَبَّ فَأَصَابَ مَالاً ، ثُمَّ مَاتَ فَأَتَوْا عُمَرَ فَقَصُّوا عَلَیْہِ الْقِصَّۃَ ، فَقَالَ : خُذُوا مِیرَاثَہُ فَاجْعَلُوہُ فِی بَیْتِ الْمَالِ ، مَا أُرَاہُ تَرَکَ وَلِیَّ نِعْمَۃٍ ، وَلاَ أَرَی لَک فَرِیضَۃً ، فَبَلَغَ ذَلِکَ ابْنَ مَسْعُودٍ ، فَقَالَ : مَہْ ، حَتَّی أَلْقَاہُ ، فَلَقِیَہُ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ عَصَبَۃٌ وَوَلِیُّ نِعْمَۃٍ ، قَالَ : کَذَا ؟ قَالَ : نَعَمْ، فَأَعْطَاہُ الْمَالَ۔","Sahih","Musannaf Ibn Abi Shaybah 31632","","","كتاب الوصايا"
"31633","(۳۱۶۳۳) حَدَّثَنَا یَحْیَی بْنُ عِیسَی ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : جَائَ رَجُلٌ إلَی عُمَرَ ، فَقَالَ لَہُ : کَانَتْ لِی أُخْتٌ بَغِیٌّ فَتُوُفِّیَتْ وَتَرَکَتْ غُلاَمًا فَمَاتَ وَتَرَکَ ذَوْدًا مِنَ الإِبِلِ ، فَقَالَ عُمَرُ : مَا أَرَی بَیْنَکَ وَبَیْنَہُ نَسَبًا ، ائْتِ بِہَا فَاجْعَلْہَا فِی إبِلِ الصَّدَقَۃِ ، قَالَ : فَأَتَی ابْنَ مَسْعُودٍ فَذَکَرَ ذَلِکَ لَہُ ، فَقَامَ عَبْدُ اللہِ فَأَتَی عُمَرَ ، فَقَالَ : مَا تَقُولُ یَا أَمِیرَ الْمُؤْمِنِینَ ؟ فَقَالَ : مَا أَرَی بَیْنَہُ وَبَیْنَہُ نَسَبًا ، فَقَالَ : أَلَیْسَ ہُوَ خَالُہُ وَوَلِیُّ نِعْمَتِہِ ؟ فَقَالَ : مَا تَرَی ؟ قَالَ : أَرَی أَنَّہُ أَحَقُّ بِمَالِہِ ، فَرَدَّہَا عَلَیْہِ عُمَرُ۔","Sahih","Musannaf Ibn Abi Shaybah 31633","","","كتاب الوصايا"
"31634","(۳۱۶۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی عَوَانَۃَ ، قَالَ : سُئِلَ حَمَّادٌ عَنْ رَجُلٍ أَوْصَی فِی الْفُقَرَائِ بِدَرَاہِمَ ؟ قَالَ : لَمْ یَرَ بَأْسًا أَنْ یُفَضِّلَ بَعْضَہُمْ عَلَی بَعْضٍ بِقَدْرِ الْحَاجَۃِ۔","","Musannaf Ibn Abi Shaybah 31634","","","كتاب الوصايا"
"31635","(۳۱۶۳۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : أَحَقٌّ تَسْوِیَۃُ النِّحَلِ بَیْنَ الْوَلَدِ عَلَی کِتَابِ اللہِ ؟ قَالَ : نَعَمْ ، وَقَدْ بَلَغَنَا ذَلِکَ عَنْ نَبِیِّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ قَالَ : سَوَّیْت بَیْنَ وَلَدِکَ ؟ قُلْتُ : فِی النُّعْمَانِ ؟ قَالَ : وَغَیْرِہِ ، زَعَمُوا۔","","Musannaf Ibn Abi Shaybah 31635","","","كتاب الوصايا"
"31636","(۳۱۶۳۶) حَدَّثَنَا عَبَّادٌ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَمِعْتُ النُّعْمَانَ بْنَ بَشِیرٍ یَقُولُ : أَعْطَانِی أَبِی عَطِیَّۃً ، فَقَالَتْ أُمِّی عَمْرَۃُ ابْنَۃُ رَوَاحَۃَ : فَلاَ أَرْضَی حَتَّی تُشْہِدَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَتَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، إنِّی أَعْطَیْت ابْنَ عَمْرَۃَ عَطِیَّۃً فَأَمَرَتْنِی أَنْ أُشْہِدَک ، فَقَالَ : أَعْطَیْت کُلَّ وَلَدِکَ مِثْلَ ہَذَا ؟ قَالَ : لاَ ، قَالَ : فَاتَّقُوا اللَّہَ وَاعْدِلُوا بَیْنَ أَوْلاَدِکُمْ ، قَالَ : فَرَجَعَ فَرَدَّ عَطِیَّتَہُ۔n(بخاری ۲۵۸۷۔ مسلم ۱۲۴۲)","Sahih","Musannaf Ibn Abi Shaybah 31636","","","كتاب الوصايا"
"31637","(۳۱۶۳۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، وَعَنْ مُحَمَّدِ بْنِ النُّعْمَانِ ، عَنْ أَبِیہِ : أَنْ أَبَاہُ نَحَلَہُ غُلاَمًا وَأَنَّہُ أَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِیُشْہِدَہُ ، فَقَالَ : أَکُلَّ وَلَدِکَ أَعْطَیْتہ مِثْلَ ہَذَا ، قَالَ : لاَ قَالَ : فَارْدُدْہُ۔ (مسلم ۱۲۴۲۔ ترمذی ۱۳۶۷)","Sahih","Musannaf Ibn Abi Shaybah 31637","","","كتاب الوصايا"
"31638","(۳۱۶۳۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَبِی حَیَّانَ ، عَنِ الشَّعْبِیِّ ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ ، قَالَ : انْطَلَقَ بِی أَبِی إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِیُشْہِدَہُ عَلَی عَطِیَّۃٍ أَعْطَانِیہَا ، قَالَ : لَک غَیْرُہُ ، قَالَ : نَعَمْ ، قَالَ : کُلَّہُم أَعْطَیْتَہُمْ مِثْلَ أُعْطِیَّتِہِ ؟ قَالَ : لاَ ، قَالَ : فَلاَ أَشْہَدُ عَلَی جَوْرٍ۔ (بخاری ۲۶۵۰۔ احمد ۲۶۸)","Sahih","Musannaf Ibn Abi Shaybah 31638","","","كتاب الوصايا"
"31639","(۳۱۶۳۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، قَالَ : کَانَ طَاوس إذَا سُئِلَ عَنْہُ ، قَرَأَ : {أَفَحُکْمَ الْجَاہِلِیَّۃِ یَبْغُونَ}۔","","Musannaf Ibn Abi Shaybah 31639","","","كتاب الوصايا"
"31640","(۳۱۶۴۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ، قَالَ: قَالَ عُرْوَۃٌ: یُرَدُّ مِنْ حَیْفِ الْحَیِّ مَا یُرَدُّ مِنْ حَیْفِ الْمَیِّتِ۔","","Musannaf Ibn Abi Shaybah 31640","","","كتاب الوصايا"
"31641","(۳۱۶۴۱) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ مِسْمَعِ بْنِ ثَابِتٍ ، عَنْ عِکْرِمَۃَ : أَنَّہُ کَانَ یَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 31641","","","كتاب الوصايا"
"31642","(۳۱۶۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ أَنْ یَعْدِلَ الرَّجُلُ بَیْنَ وَلَدِہِ حَتَّی فِی الْقُبَلِ۔","","Musannaf Ibn Abi Shaybah 31642","","","كتاب الوصايا"
"31643","(۳۱۶۴۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ : أَنَّہُ کَرِہَ أَنْ یُفَضِّلَ الرَّجُلُ بَعْضَ وَلَدِہِ عَلَی بَعْضٍ وَکَانَ یُجِیزُہُ فِی الْقَضَائِ۔","","Musannaf Ibn Abi Shaybah 31643","","","كتاب الوصايا"
"31644","(۳۱۶۴۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا مُجَالِدٌ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ ، أَنَّہُ قَالَ : لاَ بَأْسَ أَنْ یُفَضِّلَ الرَّجُلُ بَعْضَ وَلَدِہِ عَلَی بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 31644","","","كتاب الوصايا"
"31645","(۳۱۶۴۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ أَبِی حَیَّانَ ، قَالَ : حدَّثَنِی أَبِی ، قَالَ : حَضَرَ جَارٌ لِشُرَیْحٍ وَلَہُ بَنُونَ ، فَقَسَمَ مَالَہُ بَیْنَہُمْ لاَ یَأْلُو أَنْ یَعْدِلَ ، ثُمَّ دَعَا شُرَیْحًا فَجَائَ ، فَقَالَ : أَبَا أُمَیَّۃَ إنِّی قَسَمْت مَالِی بَیْنَ وَلَدِی وَلَمْ آلُ ، وَقَدْ أَشْہَدْتُک ، فَقَالَ شُرَیْحٌ : قِسْمَۃُ اللہِ أَعْدَلُ مِنْ قِسْمَتِکَ ، فَارْدُدْہُمْ إلَی سِہَامِ اللہِ وَفَرَائِضِہِ وَأَشْہِدْنِی وَإِلاَّ فَلاَ تُشْہِدْنِی ، فَإِنِّی لاَ أَشْہَدُ عَلَی جَوْرٍ۔","","Musannaf Ibn Abi Shaybah 31645","","","كتاب الوصايا"
"31646","(۳۱۶۴۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَن[corrupt] مَسْرُوقٍ : أَنَّہُ حَضَرَ رَجُلاً یُوصِی فَأَوْصَی بِأَشْیَائَ لاَ تََنْبَغِی ، فَقَالَ مَسْرُوقٌ : إنَّ اللَّہَ قَدْ قَسَمَ بَیْنَکُمْ فَأَحْسَنَ ، وَإِنَّہُ مَنْ یَرْغَبْ بِرَأْیِہِ عَنْ رَأْیِ اللہِ یَضِل ، أَوْصِ لِذَوِی قَرَابَتِکَ مِمَّنْ لاَ یَرْغَب ، ثُمَّ دَع الْمَالَ عَلَی مَنْ قَسَمَہُ اللَّہُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 31646","","","كتاب الوصايا"
"31647","(۳۱۶۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنِ الْقَاسِمِ وَالشَّعْبِیِّ : فِی رَجُلٍ کَانَ بِہِ جُذَامٌ ، فَقَالَ : أَخِی شَرِیکِی فِی مَالِی ، فَقَالَ : إنْ شَہِدَتِ الشُّہُودُ أَنَّہُ أَوْصَی بِہِ قَبْلَ أَنْ یُصِیبَہُ وَجَعَہُ شَرَّکَہُ۔","","Musannaf Ibn Abi Shaybah 31647","","","كتاب الوصايا"
"31648","(۳۱۶۴۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ وَالْحَسَنِ ، قَالَ : إذَا أَقَرَّ بَعْضُ الْوَرَثَۃِ بِدَیْنٍ عَلَی الْمَیِّتِ جَازَ عَلَیْہِ فِی نَصِیبِہِ۔","","Musannaf Ibn Abi Shaybah 31648","","","كتاب الوصايا"
"31649","(۳۱۶۴۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ : فِی وَارِثٍ أَقَرَّ بِدَیْنٍ ، قَالَ : عَلَیْہِ فِی نَصِیبِہِ بِحِصَّتِہِ ، قَالَ : ثُمَّ قَالَ بَعْدَ ذَلِکَ : یُخَرَّجُ مِنْ نَصِیبِہِ۔","","Musannaf Ibn Abi Shaybah 31649","","","كتاب الوصايا"
"31650","(۳۱۶۵۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : عَلَیْہِ فِی نَصِیبِہِ بِحِصَّتِہِ۔","","Musannaf Ibn Abi Shaybah 31650","","","كتاب الوصايا"
"31651","(۳۱۶۵۱) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ مُغِیرَۃَ ، عَنْ عَامِرٍ : فِی رَجُلٍ مَاتَ وَتَرَکَ ابْنَیْنِ ، وَتَرَکَ مِئَتَیْ دِینَارٍ ، فَأَقَرَّ أَحَدُ الاِبْنَیْنِ أَنَّ عَلَی أَبِیہِ خَمْسِینَ دِینَارًا ، قَالَ : یُؤْخَذُ مِنْ نَصِیبِ ہَذَا وَیَسْلََمُ لِلآخَرِ نَصِیبُہُ۔","","Musannaf Ibn Abi Shaybah 31651","","","كتاب الوصايا"
"31652","(۳۱۶۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا أَقَرَّ بَعْضُ الْوَرَثَۃِ بِدَیْنٍ عَلَی الْمَیِّتِ جَازَ عَلَیْہِ فِی نَصِیبِہِ۔","","Musannaf Ibn Abi Shaybah 31652","","","كتاب الوصايا"
"31653","(۳۱۶۵۳) حَدَّثَنَا حَفْصٌ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ، قَالَ: إذَا شَہِدَ رَجُلاَنِ أَوْ ثَلاَثَۃٌ مِنَ الْوَرَثَۃِ فَإِنَّمَا أَقَرُّوا عَلَی أَنْفُسِہِمْ۔","","Musannaf Ibn Abi Shaybah 31653","","","كتاب الوصايا"
"31654","(۳۱۶۵۴) حَدَّثَنَا حَفْصٌ، عَنْ أَشْعَثَ، عَنِ الْحَکَمِ وَحَمَّادٌ، عَنْ إبْرَاہِیمَ، قَالَ: یَجُوزُ عَلَی الْوَرَثَۃِ بِحِسَابِ مَا وَرِثُوا۔","","Musannaf Ibn Abi Shaybah 31654","","","كتاب الوصايا"
"31655","(۳۱۶۵۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : ہُمَا شَاہِدَانِ مِنَ الْمُسْلِمِینَ ، تَجُوزُ شَہَادَتُہُمَا عَلَی الْوَرَثَۃِ کُلِّہِمْ۔","","Musannaf Ibn Abi Shaybah 31655","","","كتاب الوصايا"
"31656","(۳۱۶۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا شَہِدَ اثْنَانِ مِنَ الْوَرَثَۃِ جَازَ عَلَیْہِمَا فِی أَنْصِبَائِہِمَا ، وَقَالَ الْحَکَمُ : یَجُوزُ عَلَیْہِمْ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 31656","","","كتاب الوصايا"
"31657","(۳۱۶۵۷) حَدَّثَنَا عَبْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ مَنْصُورٍ ، عَنِ الْحَارِثِ ، قَالَ : إذَا شَہِدَ اثْنَانِ مِنَ الْوَرَثَۃِ لِرَجُلٍ بِدَیْنٍ أُعْطِیَ دَیْنَہُ۔","","Musannaf Ibn Abi Shaybah 31657","","","كتاب الوصايا"
"31658","(۳۱۶۵۸) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا شَہِدَ أَحَدُ الْوَرَثَۃِ جَازَ عَلَیْہِمْ کُلِّہِمْ۔","","Musannaf Ibn Abi Shaybah 31658","","","كتاب الوصايا"
"31659","(۳۱۶۵۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ مَرْوَانَ ، عَنْ إبْرَاہِیمَ ، عَنِ ابْنِ سِیرِینَ : سُئِلَ عَنْ رَجُلٍ ، قَالَ : إنْ حَدَثَ بِی حَدَثٌ فَعَبْدِی حُرٌّ ، فَاحْتَاجَ إلَیْہِ ، أَلَہُ أَنْ یَبِیعَہُ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 31659","","","كتاب الوصايا"
"31660","(۳۱۶۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ : فِی رَجُلٍ قَالَ لِعَبْدِہِ : إنْ مِتّ فِی مَرَضِی ہَذَا فَأَنْتَ حُرٌّ ، قَالَ : لَیْسَ لَہُ أَنْ یَبِیعَہُ حَتَّی یَمُوتَ۔","","Musannaf Ibn Abi Shaybah 31660","","","كتاب الوصايا"
"31661","(۳۱۶۶۱) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ وَمُحَمَّدٍ: أَنَّہُمَا کَرِہَا أَنْ یَشْتَرِیَ الْوَصِیُّ مِنَ الْمِیرَاثِ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 31661","","","كتاب الوصايا"
"31662","(۳۱۶۶۲) حَدَّثَنَا عَبْدُ اللہِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ وَعَطَائٍ ، قَالاَ : لاَ یَجُوزُ لِوَالٍ أَنْ یَشْتَرِیَ مِمَّا وَلِیَ عَلَیْہِ۔n قَالَ : وَقَالَ مُجَاہِدٌ : لاَ تَشْتَرِ إحْدَی یَدَیْک مِنَ الأُخْرَی۔","","Musannaf Ibn Abi Shaybah 31662","","","كتاب الوصايا"
"31663","(۳۱۶۶۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ صِلَۃَ بْنِ زُفَرَ ، قَالَ : کَانَ عِنْدَ عَبْدِ اللہِ فَأَتَاہُ رَجُلٌ عَلَی فَرَسٍ أَبْلَقٍ ، فَقَالَ : تَأْمُرُنِی أَنْ أَشْتَرِیَ ہَذَا ؟ قَالَ : وَمَا شَأْنُہُ ؟ قَالَ : أَوْصَی إلَیَّ رَجُلٌ وَتَرَکَہُ فَأَقَمْتہ فِی السُّوقِ عَلَی ثَمَنٍ ، قَالَ : لاَ تَشْتَرِہِ ، وَلاَ تَسْتَسْلِفْ مِنْ مَالِہِ۔n قَالَ أَبُو إِسْحَاقَ : سَمِعْتہ مِنْ صِلَۃَ مُنْذُ سِتِّینَ سَنَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 31663","","","كتاب الوصايا"
"31664","(۳۱۶۶۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا سِنَانُ بْنُ ہَارُونَ الْبُرْجُمِیُّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ وَابْنِ سِیرِینَ، قَالاَ : فِی رَجُلٍ أَوْصَی لِعَبْدِہِ بِالثُّلُثِ ، قَالاَ : ذَلِکَ مِنْ رَقَبَتِہِ ، فَإِنْ کَانَ الثُّلُثُ أَکْثَرَ مِنْ ثَمَنِہِ عَتَقَ وَدَفَعَ إلَیْہِ مَا بَقِی ، وَإِنْ کَانَ أَقَلَّ مِنْ ثُمَّنِہِ عَتَقَ وَسَعَی لَہُمْ فِیمَا بَقِی ، وَإِنْ أَوْصَی لَہُمْ بِدَرَاہِمَ ، فَإِنْ شَائَ الْوَرَثَۃُ أَجَازُوا ، وَإِنْ شَاؤُوا لَمْ یُجِیزُوا۔","","Musannaf Ibn Abi Shaybah 31664","","","كتاب الوصايا"
"31665","(۳۱۶۶۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی خَالِدٍ ، عَنْ حَکِیمِ بْنِ جَابِرٍ : أَنَّہُ قِیلَ لَہُ فِی الْوَصِیَّۃِ عِنْدَ الْمَوْتِ : لَوْ أَعْتَقْت غُلاَمَک ! فَقَرَأَ ہَذِہِ الآیَۃَ : {وَلْیَخْشَ الَّذِینَ لَوْ تَرَکُوا مِنْ خَلْفِہِمْ ذُرِّیَّۃً ضِعَافًا خَافُوا عَلَیْہِمْ}۔","","Musannaf Ibn Abi Shaybah 31665","","","كتاب الوصايا"
"31666","(۳۱۶۶۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ إسْمَاعِیلَ ، عَنْ حَکِیمِ بْنِ جَابِرٍ : أَنَّہُ لَمَّا حَضَرَہُ الْمَوْتُ وَکَانَ لَہُ غُلاَمٌ فَقِیلَ لَہُ : لَوْ أَعْتَقْت ہَذَا ؟ فَقَالَ : إنِّی لَمْ أَتْرُکْ لِوَلَدِی غَیْرَہُ ، قَالَ : فَأَعَادُوا عَلَیْہِ : لَوْ أَعْتَقَہُ ، فَقَرَأَ ہَذِہِ الآیَۃَ {وَلْیَخْشَ الَّذِینَ لَوْ تَرَکُوا مِنْ خَلْفِہِمْ ذُرِّیَّۃً ضِعَافًا خَافُوا عَلَیْہِمْ} إلَی قَوْلِہِ {سَدِیدًا}۔","","Musannaf Ibn Abi Shaybah 31666","","","كتاب الوصايا"
"31667","(۳۱۶۶۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ نُسَیْرٍ ، قَالَ : قَالَ رَجُلٌ لِلرَّبِیعِ بْنِ خُثَیْمٍ : أَوْصِ لِی بِمُصْحَفِکَ ، قَالَ : فَنَظَرَ إلَی ابْنٍ لَہُ صَغِیرٍ ، فَقَالَ : {وَأُولُوا الأَرْحَامِ بَعْضُہُمْ أَوْلَی بِبَعْضٍ فِی کِتَابِ اللہِ}۔","","Musannaf Ibn Abi Shaybah 31667","","","كتاب الوصايا"
"31668","(۳۱۶۶۸) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عَاصِمٍ ، قَالَ : مَرِضَ أَبُو الْعَالِیَۃِ فَأَعْتَقَ مَمْلُوکًا ، ذَکَرَوا لَہُ أَنَّہ مِنْ وَرَائِ النَّہَرِ ، فَقَالَ : إنْ کَانَ حَیًّا فَلاَ أَعْتِقُہُ ، وَإِنْ کَانَ مَیِّتًا فَہُوَ عَتِیقٌ وَذَکَرَ ہَذِہِ الآیَۃَ {وَلَہُ ذُرِّیَّۃٌ ضُعَفَائُ}۔","","Musannaf Ibn Abi Shaybah 31668","","","كتاب الوصايا"
"31669","(۳۱۶۶۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنِ الأَشْجَعِیِّ سَمِعَ سُفْیَانَ یَقُولُ : فِی رَجُلٍ أَوْصَی بِثُلُثِہِ لِرَجُلَیْنِ فَیُوجَدُ أَحَدُہُمَا مَیِّتًا ، قَالَ : یَکُونُ لِلآخَرِ۔ یَعْنِی : الثُّلُثَ کُلَّہُ۔n قَالَ یَحْیَی : وَہُوَ الْقَوْلُ۔","","Musannaf Ibn Abi Shaybah 31669","","","كتاب الوصايا"
"31670","(۳۱۶۷۰) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : فِی رَجُلٍ أَوْصَی لِعَقِبِ بَنِی فُلاَنٍ ، قَالَ : لَیْسَ الْمَرْأَۃُ مِنَ الْعَقِبِ۔","","Musannaf Ibn Abi Shaybah 31670","","","كتاب الوصايا"
"31671","(۳۱۶۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : عَقِبُ الرَّجُلِ : وَلَدُہُ ، وَوَلَدُ وَلَدِہِ مِنَ الذُّکُورِ۔","","Musannaf Ibn Abi Shaybah 31671","","","كتاب الوصايا"
"31672","(۳۱۶۷۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا وَضَّاحٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ : فِی رَجُلٍ تُوُفِّیَ وَتَرَکَ ثَلاَثَۃَ بَنِینَ ، وَقَالَ : ثُلُثُ مَالِی لأَصْغَرِ بَنِیَّ ، فَقَالَ : الأَکْبَرُ : أَنَا لاَ أُجِیزُ ، وَقَالَ الأَوْسَطُ : أَنَا أُجِیزُ ، فَقَالَ : اجْعَلْہَا عَلَی تِسْعَۃِ أَسْہُمٍ : یُرْفَعُ ثَلاَثَۃ ، فَلَہُ سَہْمُہُ وَسَہْمُ الَّذِی أَجَازَہُ۔n وَقَالَ حَمَّادٌ : یُرَدُّ عَلَیْہِمَ السَّہْمُ جَمِیعًا۔n وَقَالَ عَامِرٌ : الَّذِی رَدَّ إنَّمَا رَدَّ عَلَی نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 31672","","","كتاب الوصايا"
"31673","(۳۱۶۷۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْفَزَارِیِّ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : سُئِلَ الزُّہْرِیُّ عَنِ امْرَأَۃٍ أَوْصَتْ بِثُلُثِ مَالِہَا لِزَوْجِہَا فِی سَبِیلِ اللہِ ؟ قَالَ : لاَ یَجُوزُ إلاَّ أَنْ تَقُولَ : ہُوَ فِی سَبِیلِ اللہِ إلَی زَوْجِی ، یَضَعُہُ حَیْثُ شَاء ۔","","Musannaf Ibn Abi Shaybah 31673","","","كتاب الوصايا"
"31674","(۳۱۶۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، قَالَ : کُنْتُ عِنْدَ دَاوُد بْنِ أَبِی ہِنْدٍ ، فَجَائَ رَجُلاَنِ أَوْ أَکْثَرُ مِنْ آلِ أَنَسِ بْنِ مَالِکٍ بَیْنَہُمْ عُبَیْدُ اللہِ بْنُ أَبِی بَکْرٍ ، وَجَاؤُوا مَعَہُمْ بِکِتَابٍ فِی صَحِیفَۃٍ ذَکَرُوا أَنَّہَا وَصِیَّۃُ أَنَسِ بْنِ مَالِکَ ، فَفُتِحْت صَدْرُہَا : بِسْمِ اللہِ الرَّحْمَن الرَّحِیمِ ہَذَا ذِکْرُ مَا کَتَبَ أَنَسُ بْنُ مَالِکٍ فِی ہَذِہِ الصَّحِیفَۃِ مِنْ أَمْرِ وَصِیَّتِہِ ، إنِّی أُوصِی مَنْ تَرَکْت مِنْ أَہْلِی کُلّہُم بِتَقْوَی اللہِ وَشُکْرِہِ وَاسْتِمْسَاکٍ بِحَبْلِہِ ، وَإِیمَانٍ بِوَعْدِہِ ، وَأُوصِیہِمْ بِصَلاَحِ ذَاتِ بَیْنِہِم وَالتَّرَاحُمِ وَالْبِرِّ وَالتَّقْوَی ، ثُمَّ أَوْصَی إنْ تُوُفِّیَ أَنَّ ثُلُثَ مَالِہِ صَدَقَۃٌ إلاَّ أَنْ یُغَیِّرَ وَصِیَّتَہُ قَبْلَ أَنْ یَلْحَقَ بِاللہِ ، أَلْف فِی سَبِیلِ اللہِ إنْ کَانَ أَمْرُ الأُمَّۃِ یَوْمئِذٍ جَمِیعًا ، وَفِی الرِّقَابِ وَالأَقْرَبِینَ ، وَمَنْ سَمَّیْت لَہُ الْعِتْقَ مِنْ رَقِیقِی یَوْمَ دُبُر مِنِّی فَأَدْرَکَہُ الْعِتْقُ فَإِنَّہُ یُقِیمُہُ وَلِیُّ وَصِیَّتِی فِی الثُّلُثِ غَیْرَ حَرِجٍ ، وَلاَ مُنَازِعٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31674","","","كتاب الوصايا"
"31675","(۳۱۶۷۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ ابْنِ عَوْنٍ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ مِنْہُمْ مَنْ یُوَرِّثُ الصَّامِتَ وَمِنْہُمْ مَنْ لاَ یُوَرِّثُہُ۔","","Musannaf Ibn Abi Shaybah 31675","","","كتاب الوصايا"
"31676","(۳۱۶۷۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُوسَی ، قَالَ : قَالَ سُفْیَانُ : لاَ تَجُوزُ وَصِیَّۃٌ لأَہْلِ الْحَرْبِ۔","","Musannaf Ibn Abi Shaybah 31676","","","كتاب الوصايا"
"31677","(۳۱۶۷۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ سَعِیدِ بْنِ السَّائِبِ : أَنَّ رَجُلاً أَوْصَی أَنْ تُعْتَقَ عَنْہُ رَقَبَتَانِ بِثَمَنٍ ، وَسَمَّاہُ ، فَلَمْ یُوجَدْ بِذَلِکَ الثَمَنُ رَقَبَتَانِ ، فَسَأَلْت عَطَائً ، فَقَالَ : اشْتَرُوا رَقَبَۃً وَاحِدَۃً وَأَعْتِقُوہَا عَنْہُ۔","","Musannaf Ibn Abi Shaybah 31677","","","كتاب الوصايا"
"31678","(۳۱۶۷۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامُ بْنُ حَسَّانٍ ، قَالَ : کَانَ أَوَّلُ وَصِیَّۃِ مُحَمَّدِ بْنِ سِیرِینَ : ہَذَا مَا أَوْصَی بِہِ مُحَمَّدُ بْنُ أَبِی عَمْرَۃَ ، أَنَّہُ یَشْہَدُ أَنْ لاَ إلَہَ إلاَّ اللَّہُ ، وَأَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، وَأَوْصَی بَنِیہِ وَأَہْلِہِ أَنِ {اتَّقُوا اللَّہَ وَأَصْلِحُوا ذَاتَ بَیْنِکُمْ وَأَطِیعُوا اللَّہَ وَرَسُولَہُ إنْ کُنْتُمْ مُؤْمِنِینَ} ، وَأُوصِیہِمْ بِمَا أَوْصَی بِہِ إبْرَاہِیمُ بَنِیہِ وَیَعْقُوبُ : {یَا بَنِیَّ إنَّ اللَّہَ اصْطَفَی لَکُمُ الدِّینَ فَلاَ تَمُوتُنَّ إلاَّ وَأَنْتُمْ مُسْلِمُونَ} وَزَعَمَ أَنَّہَا کَانَتْ أَوَّلَ وَصِیَّۃِ أَنَسِ بْنِ مَالِکٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31678","","","كتاب الوصايا"
"31679","حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ ، قَالَ : حَدَّثَنَا أَبُو بَکْرِ بْنُ أَبِی شَیْبَۃَ ، قَالَ :n(۳۱۶۷۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ تَعَلَّمَ الْقُرْآنَ فَلْیَتَعَلَّمِ الْفَرَائِضَ ، وَلاَ یَکُنْ کَرَجُلٍ لَقِیَہُ أَعْرَابِیٌّ فَقَالَ لَہُ : أَمُہَاجِرٌ أَنْتَ یَا عَبْدَ اللہِ ، فَیَقُولُ : نَعَمْ ، فَیَقُولُ : إنَّ بَعْضَ أَہْلِی مَاتَ وَتَرَکَ کَذَا وَکَذَا ، فَإِنْ ہُوَ عَلِمَہُ فَعِلْمٌ آتَاہُ اللَّہُ إِیَّاہُ ، وَإِنْ کَانَ لاَ یُحْسِنُ فَیَقُولُ : فَبِمَ تَفْضُلُونَا یَا مَعْشَرَ الْمُہَاجِرِینَ؟۔ (بیہقی ۲۰۹)","Sahih","Musannaf Ibn Abi Shaybah 31679","","","كتاب الفرائض"
"31680","(۳۱۶۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، بِنَحْوِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31680","","","كتاب الفرائض"
"31681","(۳۱۶۸۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ وَوَکِیعٌ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ، قَالَ: قَالَ عُمَرُ: تَعَلَّمُوا الْفَرَائِضَ فَإِنَّہَا مِنْ دِینِکُمْ۔","","Musannaf Ibn Abi Shaybah 31681","","","كتاب الفرائض"
"31682","(۳۱۶۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ زِیَاد بْنِ أَبِی مُسْلِمٍ ، عَنْ صَالِحٍ أَبِی الْخَلِیلِ ، عَنْ أَبِی مُوسَی ، قَالَ : مَثَلُ الَّذِی یَقْرَأُ الْقُرْآنَ ، وَلاَ یُحْسِنُ الْفَرَائِضَ کَالْیَدَیْنِ بِلاَ رَأْسٍ۔","","Musannaf Ibn Abi Shaybah 31682","","","كتاب الفرائض"
"31683","(۳۱۶۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ قَیْسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ قَرَأَ سُورَۃَ النِّسَائِ ، فَعَلِمَ مَا یَحْجُبُ مِمَّا لاَ یَحْجُبُ عَلِمَ الْفَرَائِضَ۔","Da'if","Musannaf Ibn Abi Shaybah 31683","","","كتاب الفرائض"
"31684","(۳۱۶۸۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ : أَنَّہُ قِیلَ لَہُ : ہَلْ کَانَتْ عَائِشَۃُ تُحْسِنُ الْفَرَائِضَ ، فَقَالَ : إی وَالَّذِی نَفْسِی بِیَدِہِ ، لَقَدْ رَأَیْت مَشْیَخَۃَ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الأَکَابِرَ یَسْأَلُونَہَا ، عَنِ الْفَرَائِضِ ؟","Sahih","Musannaf Ibn Abi Shaybah 31684","","","كتاب الفرائض"
"31685","(۳۱۶۸۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : مَا رَأَیْت أَحَدًا أَعْلَمَ بِفَرِیضَۃٍ ، وَلاَ أَعْلَمَ بِفِقْہٍ وَلاَ بِشِعْرٍ : مِنْ عَائِشَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 31685","","","كتاب الفرائض"
"31686","(۳۱۶۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُلَیِّ بْنِ رَبَاحٍ ، عَنْ أَبِیہِ : أَنَّ عُمَرَ خَطَبَ النَّاسَ بِالْجَابِیَۃِ فَحَمِدَ اللَّہَ وَأَثْنَی عَلَیْہِ ، ثُمَّ قَالَ : مَنْ أَحَبَّ أَنْ یَسْأَلَ عَنِ الْقُرْآنِ فَلِیَأْتِ أُبَیَّ بْنَ کَعْبٍ ، وَمَنْ أَحَبَّ أَنْ یَسْأَلَ عَنِ الْفَرَائِضِ فَلِیَأْتِ زَیْدَ بْنَ ثَابِتٍ۔","","Musannaf Ibn Abi Shaybah 31686","","","كتاب الفرائض"
"31687","(۳۱۶۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ عَبْدُ اللہِ : تَعَلَّمُوا الْقُرْآنَ وَالْفَرَائِضَ ، فَإِنَّہُ یُوشِکُ أَنْ یَفْتَقِرَ الرَّجُلُ إلَی عِلْمٍ کَانَ یَعْلَمُہُ ، أَوْ یَبْقَی فِی قَوْمٍ لاَ یَعْلَمُونَ۔","","Musannaf Ibn Abi Shaybah 31687","","","كتاب الفرائض"
"31688","(۳۱۶۸۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الْعُقَیْلِیُّ ، عَنْ أَبِی سَلَمَۃَ الْحِمْصِیِّ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَبْطَلَ مِیرَاثًا فَرَضَہُ اللَّہُ فِی کِتَابِہِ أَبْطَلَ اللَّہُ مِیرَاثَہُ مِنَ الْجَنَّۃِ۔ (سعید بن منصور ۲۸۵)","","Musannaf Ibn Abi Shaybah 31688","","","كتاب الفرائض"
"31689","(۳۱۶۸۹) حَدَّثَنَا زَیْدُ بْنُ حَبَّابٍ ، قَالَ : أَخْبَرَنَا أَبُو سِنَانٍ ، قَالَ : حَدَّثَنِی أَبُو إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونً ، قَالَ: کَانُوا إذَا اخْتَلَفُوا فِی فَرِیضَۃٍ أَتَوْا عَائِشَۃَ فَأَخْبَرَتْہُمْ بِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 31689","","","كتاب الفرائض"
"31690","(۳۱۶۹۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ ، قَالَ: قُلْتُ لِعَلْقَمَۃَ: عَلِّمْنِی الْفَرَائِضَ، قَالَ: ائْتِ جِیرَانَک۔","","Musannaf Ibn Abi Shaybah 31690","","","كتاب الفرائض"
"31691","(۳۱۶۹۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ مُوَرِّقٍ ، قَالَ : قَالَ عُمَرُ : تَعَلَّمُوا اللَّحْنَ وَالْفَرَائِضَ وَالسُّنَّۃَ کَمَا تَعَلَّمُونَ الْقُرْآنَ۔","Sahih","Musannaf Ibn Abi Shaybah 31691","","","كتاب الفرائض"
"31692","(۳۱۶۹۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن مَعْبَدٍ الْجَہْنَیِّ ، عَنْ مُعَاوِیَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ یُرِدَ اللَّہُ بِہِ خَیْرًا یُفَقِّہْہُ فِی الدِّینِ۔ (بخاری ۷۱۔ مسلم ۷۱۸)","Hasan","Musannaf Ibn Abi Shaybah 31692","","","كتاب الفرائض"
"31693","(۳۱۶۹۳) حَدَّثَنَا یَعْلَی ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ الْقُرَظِیِّ ، قَالَ : سَمِعْتُ مُعَاوِیَۃَ ابْنَ أَبِی سُفْیَانَ یَخْطُبُ یَقُولُ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ عَلَی ہَذِہِ الأَعْوَادِ ، اللَّہُمَّ لاَ مَانِعَ لِمَا أَعْطَیْت ، وَلاَ مُعْطِیَ لِمَا مَنَعْت ، مَنْ یُرِدَ اللَّہُ بِہِ خَیْرًا یُفَقِّہْہُ فِی الدِّینِ۔ (احمد ۹۵۔ مالک ۹۰۰)","Sahih","Musannaf Ibn Abi Shaybah 31693","","","كتاب الفرائض"
"31694","(۳۱۶۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ یُرِدَ اللَّہُ بِہِ خَیْرًا یُفَقِّہْہُ فِی الدِّینِ۔","","Musannaf Ibn Abi Shaybah 31694","","","كتاب الفرائض"
"31695","(۳۱۶۹۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : إذَا أَرَادَ اللَّہُ بِعَبْدٍ خَیْرًا فَقَّہَہُ فِی الدِّینِ وَأَلْہَمَہُ رُشْدَہُ۔","","Musannaf Ibn Abi Shaybah 31695","","","كتاب الفرائض"
"31696","(۳۱۶۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ ، قَالَ : إذَا أَرَادَ اللَّہُ بِعَبْدٍ خَیْرًا ، فَقَّہَہُ فِی الدِّینِ ، وَزَہَّدَہُ فِی الدُّنْیَا ، وَبَصَّرَہُ عَیْبَہُ ، فَمَنْ أُوتِیَہُنَّ فَقَدْ أُوتِیَ خَیْرَ الدُّنْیَا وَالآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 31696","","","كتاب الفرائض"
"31697","(۳۱۶۹۷) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَلَّبِ : أَنَّ عُثْمَانَ سُئِلَ عَنْہَا ، فَقَالَ : لِلْمَرْأَۃِ الرُّبْعُ ، وَلِلأُمِّ ثُلُثُ مَا بَقِیَ ، وَسَائِرُ ذَلِکَ لِلأَبِ۔","Hasan","Musannaf Ibn Abi Shaybah 31697","","","كتاب الفرائض"
"31698","(۳۱۶۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّ زَیْدَ بْنَ ثَابِتٍ سُئِلَ عَنِ امْرَأَۃٍ وَأَبَوَیْنِ ، فَأَعْطَی الْمَرْأَۃَ الرُّبْعَ ، وَالأُمَّ ثُلُثَ مَا بَقِیَ ، وَمَا بَقِیَ لِلأَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 31698","","","كتاب الفرائض"
"31699","(۳۱۶۹۹) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ : فِی امْرَأَۃٍ وَأَبَوَیْنِ ، قَالَ : الرُّبْعُ ، وَثُلُثُ مَا بَقِیَ۔","Da'if","Musannaf Ibn Abi Shaybah 31699","","","كتاب الفرائض"
"31700","(۳۱۷۰۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : أُتِیَ عَبْدُ اللہِ فِی امْرَأَۃٍ وَأَبَوَیْنِ ، فَقَالَ : إنَّ عُمَرَ کَانَ إذَا سَلِکَ طَرِیقًا فَسَلِکْنَاہُ وَجَدْنَاہُ سَہْلا ، وَإنَّہُ أُتِیَ فِی امْرَأَۃٍ وَأَبَوَیْنِ فَجَعَلَہَا مِنْ أَرْبَعَۃٍ ، فَأَعْطَی الْمَرْأَۃَ الرُّبْعَ ، وَالأُمَّ ثُلُثَ مَا بَقِی ، وَأَعْطَی الأَبَ سَائِرَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 31700","","","كتاب الفرائض"
"31701","(۳۱۷۰۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَبْدِ اللہِ ، عَنْ عُمَرَ ، بِمِثْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31701","","","كتاب الفرائض"
"31702","(۳۱۷۰۲) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ : فِی امْرَأَۃٍ وَأَبَوَیْنِ : لِلْمَرْأَۃِ الرُّبْعُ وَلِلأُمِّ ثُلُثُ مَا بَقِیَ ، وَمَا بَقِیَ فَلِلأَبِ۔","Da'if","Musannaf Ibn Abi Shaybah 31702","","","كتاب الفرائض"
"31703","(۳۱۷۰۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، عَنْ عُمَرَ ، بِمِثْلِہِ ، إلاَّ أَنَّہُ قَالَ : أُتِیَ فِی امْرَأَۃٍ وَأَبَوَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 31703","","","كتاب الفرائض"
"31704","(۳۱۷۰۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ : أَنَّہُ قَالَ : کَانَ عُمَرُ إذَا سَلِکَ طَرِیقًا فَسَلِکْنَاہُ وَجَدْنَاہُ سَہْلا ، فَسُئِلَ عَنْ زَوْجَۃٍ وَأَبَوَیْنِ ، فَقَالَ : لِلزَّوْجَۃِ الرُّبْعُ ، وَلِلأُمِّ ثُلُثُ مَا بَقِیَ ، وَمَا بَقِیَ فَلِلأَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 31704","","","كتاب الفرائض"
"31705","(۳۱۷۰۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : خَالَفَ ابْنُ عَبَّاسٍ أَہْلَ الصَّلاَۃِ فِی امْرَأَۃٍ وَأَبَوَیْنِ وَزَوْجٍ ، قَالَ : لِلأُمِّ الثُّلُثُ مِنْ جَمِیعِ الْمَالِ۔ (عبدالرزاق ۱۹۰۱۸۔ بیہقی ۲۲۸)","","Musannaf Ibn Abi Shaybah 31705","","","كتاب الفرائض"
"31706","(۳۱۷۰۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : مَا یَمْنَعُہُمْ أَنْ یَجْعَلُوہَا مِنَ اثْنَیْ عَشَرَ سَہْمًا ، فَیُعْطُونَ الْمَرْأَۃَ ثَلاَثَۃَ أَسْہُمٍ وَلِلأُمِّ أَرْبَعَۃَ أَسْہُمٍ وَلِلأَبِ خَمْسَۃَ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31706","","","كتاب الفرائض"
"31707","(۳۱۷۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِیہِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، قَالَ : قَالَ عَبْدُ اللہِ : مَا کَانَ اللَّہُ لِیَرَانِی أُفَضِّلُ أُمًّا عَلَی أَبٍ۔","","Musannaf Ibn Abi Shaybah 31707","","","كتاب الفرائض"
"31708","(۳۱۷۰۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : قَالَ عَبْدُ اللہِ : إنَّ عُمَرَ کَانَ إذَا سَلِکَ طَرِیقًا فَسَلِکْنَاہُ وَجَدْنَاہُ سَہْلا ، وَأَنَّہُ أُتِیَ فِی امْرَأَۃٍ وَأَبَوَیْنِ ، فَجَعَلَ لِلْمَرْأَۃِ الرُّبْعُ ، وَلِلأُمِّ ثُلُثُ مَا بَقِیَ، وَمَا بَقِیَ لِلأَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 31708","","","كتاب الفرائض"
"31709","(۳۱۷۰۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ شَیْخٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ : فِی امْرَأَۃٍ وَأَبَوَیْنِ : لِلْمَرْأَۃِ الرُّبْعُ ، وَلِلأُمِّ ثُلُثُ مَا بَقِیَ۔n قَالَ أَبُوبَکْرٍ: فَہَذِہِ مِنْ أَرْبَعَۃِ أَسْہُمٍ: لِلْمَرْأَۃِ سَہْمٌ وَہُوَ الرُّبْعُ، وَلِلأُمِّ ثُلُثُ مَا بَقِیَ وَہُوَ سَہْمٌ، وَلِلأَبِ سَہْمَانِ۔","","Musannaf Ibn Abi Shaybah 31709","","","كتاب الفرائض"
"31710","(۳۱۷۱۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَصْبَہَانِیِّ ، عَنْ عِکْرِمَۃَ ، قَالَ : بَعَثَنِی ابْنُ عَبَّاسٍ إلَی زَیْدِ بْنِ ثَابِتٍ أَسْأَلُہُ عَنْ زَوْجٍ وَأَبَوَیْنِ ، فَقَالَ زَیْدٌ : لِلزَّوْجِ النِّصْفُ ، وَلِلأُمِّ ثُلُثُ مَا بَقِیَ وَہُوَ السُّدُسُ ، فَأَرْسَلِ إلَیْہِ ابْنُ عَبَّاسٍ : أَفِی کِتَابِ اللہِ تَجِدُ ہَذَا ؟ قَالَ : أَکْرَہُ أَنْ أُفَضِّلَ أُمًّا علَی أَبٍ ، وَکَانَ ابْنُ عَبَّاسٍ یُعْطِی الأُمَّ الثُّلُثَ مِنْ جَمِیعِ الْمَالِ۔","Sahih","Musannaf Ibn Abi Shaybah 31710","","","كتاب الفرائض"
"31711","(۳۱۷۱۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ سُلَیْمَانَ ، قَالَ : کَانَ إبْرَاہِیمُ یَفْرِضُہَا کَمَا فَرَضَہَا زَیْدٌ۔","","Musannaf Ibn Abi Shaybah 31711","","","كتاب الفرائض"
"31712","(۳۱۷۱۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ شَیْخٍ ، عَنِ ابْن الْحَنَفِیَّۃِ: فِی زَوْجٍ وَأَبَوَیْنِ: لِلزَّوْجِ النِّصْفُ، وَلِلأُمِّ ثُلُثُ مَا بَقِی ، وَمَا بَقِیَ فَلِلأَبِ۔","","Musannaf Ibn Abi Shaybah 31712","","","كتاب الفرائض"
"31713","(۳۱۷۱۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا مِنْدَلٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ وَزَیْدِ بْنِ ثَابِتٍ : فِی امْرَأَۃٍ وَأَبَوَیْنِ وَزَوْجٍ وَأَبَوَیْنِ ، قَالَ : قَالَ : لِلأُمِّ ثُلُثُ مَا بَقِیَ۔","","Musannaf Ibn Abi Shaybah 31713","","","كتاب الفرائض"
"31714","(۳۱۷۱۴) حَدَّثَنَا عَبْدَۃُ ، عَنِ الأَعْمَشِ : أَنَّ ابْنَ عَبَّاسٍ أَرْسَلِ إلَی زَیْدٍ یَسْأَلُہُ عَنْ زَوْجٍ وَأَبَوَیْنِ ؟ فَقَالَ زَیْدٌ : لِلزَّوْجِ النِّصْفُ ، وَلِلأُمِّ ثُلُثُ مَا بَقِیَ ، فَقَالَ ابْنُ عَبَّاسٍ : تَجِدُ لَہَا فِی کِتَابِ اللہِ ثُلُثَ مَا بَقِیَ ؟ فَقَالَ زَیْدٌ : ہَذَا رَأْیِی وَاللَّہُ أَعْلَمُ۔n قَالَ أَبُو بَکْرٍ : ہَذِہِ سِتَّۃُ أَسْہُمٍ : لِلزَّوْجِ ثَلاَثَۃٌ ، وَلِلأُمِّ سَہْمٌ ، وَلِلأَبِ سَہْمَانِ۔","","Musannaf Ibn Abi Shaybah 31714","","","كتاب الفرائض"
"31715","(۳۱۷۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، قَالَ : قضَی مُعَاذٌ بِالْیَمَنِ فِی ابْنَۃٍ وَأُخْتٍ لأَبٍ وَأَمٍّ : لِلأُخْتِ النِّصْفُ ، وَلِلاِبْنَۃِ النِّصْفُ۔","Sahih","Musannaf Ibn Abi Shaybah 31715","","","كتاب الفرائض"
"31716","(۳۱۷۱۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ مُعَاذٍ ، مِثْلَ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 31716","","","كتاب الفرائض"
"31717","(۳۱۷۱۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن وَبَرَۃَ بْنِ عَبْدِ الرَّحْمَن ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، قَالَ : کَانَ ابْنُ الزُّبَیْرِ لاَ یُعْطِی الأُخْتَ مَعَ الاِبْنَۃِ شَیْئًا حَتَّی حَدَّثْتہ أَنَّ مُعَاذًا قَضَی بِالْیَمَنِ فِی ابْنَۃٍ وَأُخْتٍ لأَبٍ وَأَمٍّ : لِلاِبْنَۃِ النِّصْفُ وَلِلأُخْتِ النِّصْفُ ، فَقَالَ : أَنْتَ رَسُولِی إلَی ابْنِ عُتْبَۃَ فَمُرْہُ بِذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 31717","","","كتاب الفرائض"
"31718","(۳۱۷۱۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : حدَّثْت ابْنَ الزُّبَیْرِ بِقَوْلِ مُعَاذٍ ، فَقَالَ : أَنْتَ رَسُولِی إلَی ابْنِ عُتْبَۃَ فَمُرْہُ بِذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 31718","","","كتاب الفرائض"
"31719","(۳۱۷۱۹) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنِی یَحْیَی بْنُ أَیُّوبَ الْمِصْرِیُّ ، قَالَ : حَدَّثَنَا یَزِیدُ بْنُ أَبِی حَبِیبٍ ، عَنْ أَبِی سَلَمَۃَ : أَنَّ عُمَرَ جَعَلَ الْمَالَ بَیْنَ الاِبْنَۃِ وَالأُخْتِ نِصْفَیْنِ۔","","Musannaf Ibn Abi Shaybah 31719","","","كتاب الفرائض"
"31720","(۳۱۷۲۰) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حَصِینٍ ، عَنْ عَبْدِ اللہِ بْنِ عُتْبَۃَ : فِی ابْنَۃٍ وَأُخْتٍ، قَالَ : النِّصْفُ ، وَالنِّصْفُ۔","","Musannaf Ibn Abi Shaybah 31720","","","كتاب الفرائض"
"31721","(۳۱۷۲۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، عَنِ الأَسْوَدِ ، قَالَ : کَانَ ابْنُ الزُّبَیْرِ قَدْ ہَمَّ أَنْ یَمْنَعَ الأَخَوَاتِ مَعَ الْبَنَاتِ الْمِیرَاثَ فَحَدَّثْتہ أَنَّ مُعَاذًا قَضَی بِہِ فِینَا : وَرَّثَ ابْنَۃً وَأُخْتًا۔","Sahih","Musannaf Ibn Abi Shaybah 31721","","","كتاب الفرائض"
"31722","(۳۱۷۲۲) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، قَالَ: کَانَ عَلِیٌّ وَابْنُ مَسْعُودٍ وَمُعَاذٌ یَقُولُونَ فِی ابْنَۃٍ وَأُخْتٍ: النِّصْفُ وَالنِّصْفُ، وَہُوَ قَوْلُ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلاَّ ابْنَ الزُّبَیْرِ، وَابْنَ عَبَّاسٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31722","","","كتاب الفرائض"
"31723","(۳۱۷۲۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ عَبْدِ اللہِ بْنِ عُتْبَۃَ وَقَدْ أَمَرَنِی أَنْ أُصْلِحَ بَیْنَ الاِبْنَۃِ وَالأُخْتِ فِی الْمِیرَاثِ ، وَقَدْ کَانَ ابْنُ الزُّبَیْرِ أَمَرَہُ أَنْ لاَ یُوَرِّثَ الأُخْتَ مَعَ الاِبْنَۃِ شَیْئًا ، فَإِنِّی لأُصْلِحُ بَیْنَہُمَا عِنْدَہُ إذَا جَائَ الأَسْوَدُ بْنُ یَزِیدَ ، فَقَالَ : إنِّی شَہِدْت مُعَاذًا بِالْیَمَنِ قَسَمَ الْمَالَ بَیْنَ الاِبْنَۃِ وَالأُخْتِ ، وَإِنِّی أَتَیْتُ ابْنَ الزُّبَیْرِ فَأَعْلَمْتہ ذَلِکَ ، فَأَمَرَنِی أَنْ آتِیَک فَأُعْلِمَک ذَلِکَ لِتَقْضِیَ بِہِ وَتَکْتُبَ بِہِ إلَیْہِ ، فَقَالَ : یَا أَسْوَدُ ، إنَّک عِنْدَنَا لَمُصَدَّقٌ فَأْتِہِ فَأَعْلِمْہُ ذَلِکَ فَلِیَقْضِ بِہِ۔n قَالَ أَبُو بَکْرٍ : وَہَذِہِ مِنْ سَہْمَیْنِ : لِلاِبْنَۃِ سَہْمٌ وَلِلأُخْتِ سَہْمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 31723","","","كتاب الفرائض"
"31724","(۳۱۷۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُزَیْلِ بْنِ شُرَحْبِیلَ ، قَالَ : جَائَ رَجُلٌ إلَی أَبِی مُوسَی وَسَلْمَانَ بْنِ رَبِیعَۃَ فَسَأَلَہُمَا عَنِ ابْنَۃٍ ، وَابْنَۃِ ابْنٍ ، وَأُخْتٍ لأَبٍ وَأُمٍ ؟ فَقَالاَ : لِلاِبْنَۃِ النِّصْفُ ، وَمَا بَقِیَ لِلأُخْتِ ، وَائْتِ ابْنَ مَسْعُودٍ فَسَلْہُ ، فَإِنَّہُ سَیُتَابِعنَا ، قَالَ : فَأَتَی الرَّجُلُ ابْنَ مَسْعُودٍ فَسَأَلَہُ وَأَخْبَرَہُ بِمَا قَالاَ ، فَقَالَ : لَقَدْ ضَلَلْت إذًا وَمَا أَنَا مِنَ الْمُہْتَدِینَ ، وَلَکِنْ سَأَقْضِی بِمَا قَضَی بِہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لِلاِبْنَۃِ النِّصْفُ ، وَلاِبْنَۃِ الاِبْنِ السُّدُسُ تَکْمِلَۃُ الثُّلُثَیْنِ ، وَمَا بَقِیَ فَلِلأُخْتِ۔","Sahih","Musannaf Ibn Abi Shaybah 31724","","","كتاب الفرائض"
"31725","(۳۱۷۲۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُزَیْلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ابْنَۃٍ ، وَابْنَۃِ ابْنٍ ، وَأُخْتٍ : أَعْطَی الْبِنْتِ النِّصْفَ ، وَابْنَۃَ الاِبْنِ السُّدُسَ تَکْمِلَۃَ الثُّلُثَیْنِ ، وَالأُخْتَ مَا بَقِیَ۔n قَالَ أَبُو بَکْرٍ : وَہَذِہِ مِنْ سِتَّۃِ أَسْہُمٍ : لِلاِبْنَۃِ ثَلاَثَۃُ أَسْہُمٍ ، وَلاِبْنَۃِ الاِبْنِ سَہْمٌ ، وَلِلأُخْتِ سَہْمَانِ۔","","Musannaf Ibn Abi Shaybah 31725","","","كتاب الفرائض"
"31726","(۳۱۷۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَعْبَدِ بْنِ خَالِدٍ ، عَنْ مَسْرُوقٍ ، عَنِ ابْنِ مَسْعُودٍ : أَنَّہُ کَانَ یَجْعَلُ لِلأَخَوَاتِ وَالْبَنَاتِ الثُّلُثَیْنِ ، وَیَجْعَلُ مَا بَقِیَ لِلذُّکُورِ دُونَ الإِنَاثِ ، وَأَنَّ عَائِشَۃَ شَرَّکَتْ بَیْنَہُمْ ، فَجَعَلَتْ مَا بَقِیَ بَعْدَ الثُّلُثَیْنِ {لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ}۔","Sahih","Musannaf Ibn Abi Shaybah 31726","","","كتاب الفرائض"
"31727","(۳۱۷۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ حَکِیمِ بْنِ جَابِرٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ : أَنَّہُ قَالَ فِیہَا : ہَذَا مِنْ قَضَائِ أَہْلِ الْجَاہِلِیَّۃِ : یَرِثُ الرِّجَالُ دُونَ النِّسَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 31727","","","كتاب الفرائض"
"31728","(۳۱۷۲۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن مَسْرُوقٍ ، قَالَ : کَانَ یَأْخُذُ بِقَوْلِ عَبْدِ اللہِ فِی أَخَوَاتٍ لأُمٍّ وَأَبٍ ، وَإِخْوَۃٍ وَأَخَوَاتٍ لأَبٍ ، یَجْعَلُ مَا بَقِیَ عَلَی الثُّلُثَیْنِ لِلذِّکُور دُونَ الإِنَاثِ ، فَخَرَجَ خَرْجَۃً إلَی الْمَدِینَۃِ ، قَالَ : فَجَائَ وَہُوَ یَرَی أَنْ یُشَرِّکَ بَیْنَہُمْ ، قَالَ : فَقَالَ لَہُ عَلْقَمَۃُ : مَا رَدَّک عَنْ قَوْلِ عَبْدِ اللہِ ؟ أَلَقِیت أَحَدًا ہُوَ أَثْبَتُ فِی نَفْسِکَ مِنْہُ ؟ قَالَ : فَقَالَ : لاَ ، وَلَکِنْ لَقِیت زَیْدَ بْنَ ثَابِتٍ فَوَجَدْتہ مِنَ الرَّاسِخِینَ فِی الْعِلْمِ۔","Sahih","Musannaf Ibn Abi Shaybah 31728","","","كتاب الفرائض"
"31729","(۳۱۷۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن مَسْرُوقٍ ، قَالَ : قدِمَ فَقَالَ لَہُ عَلْقَمَۃُ : مَا کَانَ ابْنُ مَسْعُودٍ بِثَبْتٍ ؟ فَقَالَ لَہُ مَسْرُوقٌ : کَلاَّ ، وَلَکِنْ رَأَیْت زَیْدَ بْنَ ثَابِتٍ وَأَہْلَ الْمَدِینَۃِ یُشَرِّکُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 31729","","","كتاب الفرائض"
"31730","(۳۱۷۳۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لأُخْتَیْہِ لأَبِیہِ وَأُمِّہِ الثُّلُثَانِ ، وَلإِخْوَتِہِ لأَبِیہِ وَأَخَوَاتِہِ مَا بَقِیَ {لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ} فِی قَوْلِ عَلِیٍّ وَزَیْدٍ ، وَفِی قَوْلِ عَبْدِ اللہِ : لأُخْتَیْہِ لأَبِیہِ وَأُمِّہِ الثُّلُثَانِ ، وَمَا بَقِیَ فَلِلذُّکُورِ مِنْ إخْوَتِہِ دُونَ إنَاثِہِمْ۔n قَالَ أَبُو بَکْرٍ : وَہَذِہِ فِی الْقَوْلَیْنِ جَمِیعًا مِنْ ثَلاَثَۃِ أَسْہُمٍ : لِلأَخَوَاتِ وَالْبَنَاتِ الثُّلُثَانِ ، وَیَبْقَی الثُّلُثُ فَہُوَ بَیْنَ الإِخْوَۃِ وَالأَخَوَاتِ ، أَوْ بَیْنَ بَنَاتِ ابْنِہِ ، وَبَنِی ابْنِہِ ، لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ۔","","Musannaf Ibn Abi Shaybah 31730","","","كتاب الفرائض"
"31731","(۳۱۷۳۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ تَرَکَ ابْنَتَیْہِ وَابْنَۃَ ابْنٍ ، وَابْنَ ابْنٍ أَسْفَلَ مِنْہَا : فَلاِبْنَتَیْہِ الثُّلُثَانِ ، وَمَا فَضَلَ لاِبْنِ ابْنِہِ ، یُرَدُّ عَلَی مَنْ فَوْقَہُ وَمَنْ مَعَہُ مِنَ الْبَنَاتِ ، فِی قَوْلِ عَلِیٍّ وَزَیْدٍ : {لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ} وَلاَ یُرَدُّ عَلَی مَنْ أَسْفَلَ مِنْہُ ، وَفِی قَوْلِ عَبْدِ اللہِ : لاِبْنَتَیْہِ الثُّلُثَانِ ، وَلاِبْنِ ابْنِہِ مَا بَقِی ، لاَ یَردُّ عَلَی أُخْتِہِ شَیْئًا ، وَلاَ عَلَی مَنْ فَوْقَہُ مِنْ أَجْلِ أَنَّہُ اسْتَکْمَلَ الثُّلُثَیْنِ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ مِنْ تِسْعَۃٍ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ : فَیَصِیرُ لِلاِبْنَتَیْنِ الثُّلُثَانِ : وَتَبْقَی ثَلاَثَۃُ أَسْہُمٍ : فَلاِبْنِ الاِبْنِ سَہْمَانِ ، وَلأُخْتِہِ سَہْمٌ ، وَفِی قَوْلِ عَبْدِ اللہِ : مِنْ ثَلاَثَۃٍ أَسْہُمٍ : لِلْبِنْتَیْنِ الثُّلُثَانِ سَہْمَانِ ، وَلاِبْنِ الاِبْنِ مَا بَقِیَ وَہُوَ سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 31731","","","كتاب الفرائض"
"31732","(۳۱۷۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ عَبْدُ اللہِ یَقُولُ فِی ابْنَۃٍ ، وَابْنَۃِ ابْنٍ ، وَبَنِی ابْنٍ ، وَبَنِی أُخْتٍ لأَبٍ وَأُمٍّ ، وَأُخْتٍ وَإِخْوَۃٍ لأَبٍ : أَنَّ ابْنَ مَسْعُودٍ کَانَ یُعْطِی ہَذِہِ النِّصْفَ ، ثُمَّ یَنْظُرُ، فَإِنْ کَانَ إذَا قَاسَمَتِ الذُّکُورَ أَصَابَہَا أَکْثَرُ مِنَ السُّدُسِ ، لَمْ یُزِدْہَا عَلَی السُّدُسِ ، وَإِنْ أَصَابَہَا أَقَلُّ مِنَ السُّدُسِ قَاسَمَ بِہَا ، لَمْ یُلْزِمْہَا الضَّرَرُ ، وَکَانَ غَیْرُہُ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لِہَذِہِ النِّصْفُ ، وَمَا بَقِیَ فَلِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ۔n قَالَ أَبُو بَکْرٍ : ہَذِہِ أَصْلُہَا مِنْ سِتَّۃِ أَسْہُمٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31732","","","كتاب الفرائض"
"31733","(۳۱۷۳۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ عَلِیٌّ وَزَیْدٌ یَقُولاَنِ فِی بَنِی عَمٍّ أحَدُہُمْ أَخٌ لأُمٍّ : یُعْطِیَانِہِ السُّدُسَ ، وَمَا بَقِیَ بَیْنَہُ وَبَیْنَ بَنِی عَمِّہِ ، وَکَانَ عَبْدُ اللہِ یُعْطِیہ الْمَالَ کُلَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31733","","","كتاب الفرائض"
"31734","(۳۱۷۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : أُتِیَ فِی بَنِی عَمٍّ أَحَدُہُمْ أَخٌ لأُمٍّ ، وَکَانَ ابْنُ مَسْعُودٍ أَعْطَاہُ الْمَالَ کُلَّہُ ، فَقَالَ عَلِیٌّ : یَرْحَمُ اللَّہُ أَبَا عَبْدِ الرَّحْمَنِ ، إِنْ کَانَ لَفَقِیہًا ، لَوْ کُنْت أَنَا لأَعْطیْتُہُ السُّدُسَ ، وَکَانَ شَرِیکَہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 31734","","","كتاب الفرائض"
"31735","(۳۱۷۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ : أَنَّہُ کَانَ یَقْضِی فِی بَنِی عَمٍّ أَحَدُہُمْ أَخٌ لأُمٍّ بِقَضَائِ عَبْدِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31735","","","كتاب الفرائض"
"31736","(۳۱۷۳۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ بَنِی عَمِّہَا ، أَحَدُہُمْ أَخُوہَا لأُمِّہَا ، قَالَ : فَقَضَی فِیہَا عُمَرُ وَعَلِیٌّ وَزَیْدٌ : أَنَّ لأَخِیہَا مِنْ أُمِّہَا السُّدُسَ ، وَہُوَ شَرِیکُہُمْ بَعْدُ فِی الْمَالِ ، وَقَضَی فِیہَا عَبْدُ اللہِ : أَنَّ الْمَالَ لَہُ دُونَ بَنِی عَمِّہِ۔n قَالَ أَبُو بَکْرٍ : فَہِیَ فِی قَوْلِ عُمَرَ وَعَلِیٍّ وَزَیْدٍ : مِنْ سِتَّۃِ أَسْہُمٍ ، وَہِیَ فِی قَوْلِ عَبْدِ اللہِ وَشُرَیْحٍ : مِنْ سَہْمٍ وَاحِدٍ وَہُوَ جَمِیعُ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 31736","","","كتاب الفرائض"
"31737","(۳۱۷۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَوْسٍ ، عَنْ حَکِیمِ بْنِ عِقَالٍ ، قَالَ : أُتِیَ عَلِیٌّ فِی ابْنَیْ عَمٍّ أَحَدُہُمَا زَوْجٌ، وَالآخَرُ أَخٌ لأُمٍّ ، فَقَالَ لِشُرَیْحٍ : قُلْ فِیہَا ، فَقَالَ شُرَیْحٌ : لِلزَّوْجِ النِّصْفُ ، وَمَا بَقِیَ فَلِلأَخِ ، فَقَالَ لَہُ عَلِیٌّ : رَأْیٌ ؟ قَالَ : کَذَلِکَ رَأَیْت ، فَأَعْطَی عَلِیٌّ الزَّوْجَ النِّصْفَ ، وَالأَخ السُّدُسَ ، وَجَعَلَ مَا بَقِیَ بَیْنَہُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 31737","","","كتاب الفرائض"
"31738","(۳۱۷۳۸) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ ، عَنْ إسْرَائِیلَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ ثَلاَثَۃً بَنِی عَمٍّ أَحَدُہُمْ زَوْجُہَا ، وَالآخَرُ أَخُوہَا لأُمِّہَا ، فَقَالَ عَلِیٌّ وَزَیْدٌ : لِلزَّوْجِ النِّصْفُ ، وَلِلأَخِ مِنَ الأُمِّ السُّدُسُ ، وَمَا بَقِیَ فَہُوَ بَیْنَہُمْ سَوَائٌ ، وَقَالَ ابْنُ مَسْعُودٍ : لِلزَّوْجِ النِّصْفُ ، وَمَا بَقِیَ فَلِلأَخِ مِنَ الأُمِّ۔n قَالَ أَبُو بَکْرٍ : وَہَذِہِ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ مِنْ سِتَّۃِ : لِلزَّوْجِ النِّصْفُ ثَلاثَۃ ، وَلِلأَخِ لِلأُمِّ السُّدُسُ ، وَیَبْقَی سَہْمَانِ ، فَہُمَا بَیْنَہُمَا ، وَفِی قَوْلِ ابْنِ مَسْعُودٍ مِنْ سَہْمَیْنِ : لِلزَّوْجِ النِّصْفُ ، وَمَا بَقِیَ فَلِلأَخِ لِلأُمِّ۔","","Musannaf Ibn Abi Shaybah 31738","","","كتاب الفرائض"
"31739","(۳۱۷۳۹) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا ، عَنْ إسْرَائِیلَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ أَخَوَیْہَا لأُمِّہَا ، أَحَدُہُمَا ابْنُ عَمِّہَا، فَقَالَ عَلِیٌّ وَزَیْدٌ: الثُّلُثُ بَیْنَہُمَا، وَمَا بَقِیَ فَلاِبْنِ عَمِّہَا، وَقَالَ ابْنُ مَسْعُودٍ: الْمَالُ بَیْنَہُمَا۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ مِنْ ثَلاَثَۃِ أَسْہُمٍ ، وَفِی قَوْلِ ابْنِ مَسْعُودٍ مِنْ سَہْمَیْنِ۔","","Musannaf Ibn Abi Shaybah 31739","","","كتاب الفرائض"
"31740","(۳۱۷۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ عَبْدِ الْمَلِکِ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنْ أبْنَۃٍ وَابْنَیْ عَمٍّ أَحَدُہُمَا أَخٌ لأُمٍّ ؟ فَقَالَ : لِلاِبْنَۃِ النِّصْفُ ، وَمَا بَقِیَ فَلاِبْنِ الْعَمِّ الَّذِی لَیْسَ بِأَخٍ لأُمٍّ ، وَلاَ یَرِث أَخٌ لأُمٍّ مَعَ وَلَدٍ ، قَالَ : فَسَأَلْت عَطَائً ، فَقَالَ : أَخْطَأَ سَعِیدٌ ، لِلاِبْنَۃِ النِّصْفُ ، وَمَا بَقِیَ بَیْنَہُمَا نِصْفَیْنِ۔n قَالَ : أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ سَعِیدِ بْنِ جُبَیْرٍ مِنْ سَہْمَیْنِ : لِلاِبْنَۃِ النِّصْفُ وَلاِبْنِ الْعَمِّ الَّذِی لَیْسَ بِأَخٍ لأُمٍّ النِّصْفُ ، وَفِی قَوْلِ عَطَائٍ مِنْ أَرْبَعَۃٍ : سَہْمَانِ لِلاِبْنَۃِ ، وَسَہْمَانِ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 31740","","","كتاب الفرائض"
"31741","(۳۱۷۴۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ أَعْمَامَہَا أَحَدُہُمْ أَخُوہَا لأُمِّہَا ، فَقَضَی فِیہَا عَلِیٌّ وَزَیْدٌ : أَنَّ لأَخِیہَا لأُمِّہَا السُّدُسَ ، ثُمَّ ہُوَ شَرِیکُہُمْ بَعْدُ فِی الْمَالِ ، وَقَضَی فِیہَا ابْنُ مَسْعُودٍ : أَنَّ الْمَالَ کُلَّہُ لَہُ ، وَہَذَا نَسَب یَکُونُ فِی الشِّرْکِ ، ثُمَّ یُسلمُ أَہْلَہُ بَعْدُ۔n قَالَ أَبُو بَکْرٍ: فَہَذِہِ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ مِنْ سِتَّۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَبْدِ اللہِ: مِنْ سَہْمٍ وَاحِدٍ لأَنَّہُ ا[corrupt]ْمَالُ کُلُّہُ۔","","Musannaf Ibn Abi Shaybah 31741","","","كتاب الفرائض"
"31742","(۳۱۷۴۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ إخْوَتَہَا لأُمِّہَا رِجَالاً وَنِسَائً، وَہُمْ بَنُو عَمِّہَا فِی الْعَصَبَۃِ ، قَالَ : یَقْتَسِمُونَ الثُّلُثَ بَیْنَہُمْ : الرِّجَالُ وَالنِّسَائُ فِیہِ سَوَائٌ ، وَالثُّلُثَانِ الْبَاقِیَانِ لِذُکُورِہِمْ خَالِصًا دُونَ النِّسَائِ فِی قَضَائِ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کُلِّہِمْ۔n وَہَذِہِ فِی قَوْلِہِمْ جَمِیعًا مِنْ ثَلاَثَۃِ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31742","","","كتاب الفرائض"
"31743","(۳۱۷۴۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ تَرَکَ ابْنَتَیْہِ وَبَنِی ابْنِہِ رِجَالاً وَنِسَائً : فَلاِبْنَتَیْہِ الثُّلُثَانِ ، وَمَا بَقِیَ فَلِلذُّکُورِ دُونَ الإِنَاثِ ، وَکَانَ عَبْدُ اللہِ لاَ یَزِیدُ الأَخَوَاتِ وَالْبَنَاتِ عَلَی الثُّلُثَیْنِ ، وَکَانَ عَلِیٌّ وَزَیْدٌ یُشَرِّکُونَ فِیمَا بَیْنَہُمْ ، فَمَا بَقِیَ {لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ}۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ مِنْ ثَلاَثَۃِ أَسْہُمٍ فِی قَوْلِہِمْ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 31743","","","كتاب الفرائض"
"31744","(۳۱۷۴۴) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ سِمَاکِ بْنِ الْفَضْلِ ، قَالَ : سَمِعْتُ وَہْبًا یُحَدِّثُ ، عَنِ الْحَکَمِ بْنِ مَسْعُودٍ ، قَالَ : شَہِدْت عُمَرَ أَشْرَکَ الإِخْوَۃَ مِنَ الأَبِ وَالأُمِّ مَعَ الإِخْوَۃِ مِنَ الأُمِّ فِی الثُّلُثِ ، فَقَالَ لَہُ رَجُلٌ : قَدْ قَضَیْت فِی ہَذَہ عَامَ الأَوَّلِ بِغَیْرِ ہَذَا ، قَالَ : وَکَیْفَ قَضَیْت ؟ قَالَ : جَعَلْتہ لِلإِخْوَۃِ لِلأُمِّ وَلَمْ تَجْعَلْ لِلإِخْوَۃِ مِنَ الأَبِ وَالأُمِّ شَیْئًا ، فَقَالَ : ذَلِکَ عَلَی مَا قَضَیْنَا ، وَہَذَا عَلَی مَا نَقْضِی۔ (عبدالرزاق ۱۹۰۰۵)","Da'if","Musannaf Ibn Abi Shaybah 31744","","","كتاب الفرائض"
"31745","(۳۱۷۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ : أَنَّ عُمَرَ وَزَیْدًا وَابْنَ مَسْعُودٍ کَانُوا یُشَرِّکُونَ فِی زَوْجٍ وَأُمٍّ وَإِخْوَۃٍ لأُمٍّ وَأَبٍ وَأَخَوَاتٍ لأُمٍّ ، یُشَرِّکُونَ بَیْنَ الإِخْوَۃِ مِنَ الأَبِ وَالأُمِّ مَعَ الإِخْوَۃِ لِلأُمِّ فِی سَہْمٍ ، وَکَانُوا یَقُولُونَ : لَمْ یَزِدْہُمَ الأَبُ إلاَّ قُرْبًا ، وَیَجْعَلُونَ ذُکُورَہُمْ وَإِنَاثَہُمْ فِیہِ سَوَائً۔","","Musannaf Ibn Abi Shaybah 31745","","","كتاب الفرائض"
"31746","(۳۱۷۴۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ زَوْجَہَا وَأُمَّہَا وَإِخْوَتَہَا لأَبِیہَا وَأُمِّہَا وَإِخْوَتَہَا لأُمِّہَا : فَلِزَوْجِہَا النِّصْفُ ثَلاَثَۃُ أَسْہُمٍ ، وَلأُمِّہَا السُّدُسُ سَہْمٌ ، وَلاِِخْوَتِہَا لأُمِّہَا الثُّلُثُ سَہْمَانِ ، وَلَمْ یَجْعَلْ لاِِخْوَتِہَا لأَبِیہَا وَأُمِّہَا مِنَ الْمِیرَاثِ شَیْئًا فِی قَضَائِ عَلِی ، وَشَرَّک بَیْنَہُمْ عُمَرُ وَعَبْدُ اللہِ وَزَیْدُ بْنُ ثَابِتٍ : بَیْنَ الإِخْوَۃِ مِنَ الأَبِ وَالأُمِّ مَعَ بَنِی الأُمِّ فِی الثُّلُثِ الَّذِی وَرِثُوا ، غَیْرَ أَنَّہُمْ شَرَّکُوا ذُکُورَہُمْ وَإِنَاثَہُمْ فِیہِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 31746","","","كتاب الفرائض"
"31747","(۳۱۷۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ : أَنَّ عُثْمَانَ شَرَّک بَیْنَہُمْ۔","","Musannaf Ibn Abi Shaybah 31747","","","كتاب الفرائض"
"31748","(۳۱۷۴۸) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنِ ابْنِ الْمُنْتَشِرِ ، عَنْ شُرَیْحٍ وَمَسْرُوقٍ : أَنَّہُمَا شَرَّکَا الإِخْوَۃَ مِنَ الأَبِ وَالأُمِّ مَعَ الإِخْوَۃِ مِنَ الأُمِّ۔","","Musannaf Ibn Abi Shaybah 31748","","","كتاب الفرائض"
"31749","(۳۱۷۴۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، بِمِثْلِہِ ، قَالَ : مَا زَادَہُمَ الأَبُ إلاَّ قُرْبًا۔","","Musannaf Ibn Abi Shaybah 31749","","","كتاب الفرائض"
"31750","(۳۱۷۵۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ قَالَ : لأُمِّہَا السُّدُسُ ، وَلِزَوْجِہَا الشَّطْرُ ، وَالثُّلُثُ بَیْنَ الإِخْوَۃِ مِنَ الأُمِّ وَالإِخْوَۃِ مِنَ الأَبِ وَالأُمِّ۔","","Musannaf Ibn Abi Shaybah 31750","","","كتاب الفرائض"
"31751","(۳۱۷۵۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، قَالَ : مَاتَتِ ابْنَۃٌ لِلْحَسَنِ بْنِ الْحَسَنِ وَتَرَکَتْ زَوْجَہَا وَأُمَّہَا وَإِخْوَتَہَا لأُمِّہَا وَإِخْوَتَہَا لأَبِیہَا وَأُمِّہَا ، فَارْتَفَعُوا إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ، فَأَعْطَی الزَّوْجَ النِّصْفَ ، وَالأُمَّ السُّدُسَ ، وَأَشْرَکَ بَیْنَ الإِخْوَۃِ مِنَ الأُمِّ وَالإِخْوَۃِ مِنَ الأَبِ وَالأُمِّ ، وَقَالَ لِلزَّوْجِ : أَمْسِکْ عَنْ أَتْرَابِکَ ، أَیَلْحَقُ بِہِمْ سَہْمٌ آخَرُ ، حَتَّی یُنْظر حُبْلَی ہِیَ أَمْ لاَ ؟۔","","Musannaf Ibn Abi Shaybah 31751","","","كتاب الفرائض"
"31752","(۳۱۷۵۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ وَعُمَرُ یُشَرِّکَانِ ، قَالَ : وَکَانَ عَلِیٌّ لاَ یُشَرِّکُ۔n قَالَ أَبُو بَکْرٍ : وَہَذِہِ مِنْ سِتَّۃِ أَسْہُمٍ : لِلزَّوْجِ النِّصْفُ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأُمِّ السُّدُسُ ، وَلِلإِخْوَۃِ مِنَ الأُمِّ الثُّلُثُ وَہُوَ سَہْمَانِ۔","","Musannaf Ibn Abi Shaybah 31752","","","كتاب الفرائض"
"31753","(۳۱۷۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَنْ عَلِیٍّ : أَنَّہُ کَانَ لاَ یُشَرِّکُ۔","Hasan","Musannaf Ibn Abi Shaybah 31753","","","كتاب الفرائض"
"31754","(۳۱۷۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ : أَنَّہُ کَانَ لاَ یُشَرِّکُ۔","Da'if","Musannaf Ibn Abi Shaybah 31754","","","كتاب الفرائض"
"31755","(۳۱۷۵۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَلِیٌّ لاَ یُشَرِّکُ۔","","Musannaf Ibn Abi Shaybah 31755","","","كتاب الفرائض"
"31756","(۳۱۷۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُزَیْلٍ ، عَنْ عَبْدِ اللہِ : أَنَّہُ کَانَ لاَ یُشَرِّکُ ، وَیَقُولُ : تَنَاہَت السِّہَامُ۔","Sahih","Musannaf Ibn Abi Shaybah 31756","","","كتاب الفرائض"
"31757","(۳۱۷۵۷) حَدَّثَنَا مَعْشَرٌ ، عَنْ أَبِیہِ ، عَنْ أَبِی مِجْلَزٍ ، عَنْ عَلِیٍّ : أَنَّہُ کَانَ لاَ یُشَرِّکُ بَیْنَہُمْ۔","","Musannaf Ibn Abi Shaybah 31757","","","كتاب الفرائض"
"31758","(۳۱۷۵۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنْ زَیْدِ بْنِ ثَابِتٍ : أَنَّہُ کَانَ لاَ یُشَرِّکُ۔","Da'if","Musannaf Ibn Abi Shaybah 31758","","","كتاب الفرائض"
"31759","(۳۱۷۵۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ دَاوُد ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ : أَنَّ عَلِیًّا وَأَبَا مُوسَی وَأُبَیًّا کَانُوا لاَ یُشَرِّکُونَ ، قَالَ وَکِیعٌ : وَلَیْسَ أَحَدٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلاَّ اخْتَلَفُوا عَنْہُ فِی الشَّرِکَۃِ ، إلاَّ عَلِیٌّ فَإِنَّہُ کَانَ لاَ یُشَرِّکُ۔","Da'if","Musannaf Ibn Abi Shaybah 31759","","","كتاب الفرائض"
"31760","(۳۱۷۶۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عُمَرَ : أَنَّہُ قَسَمَ الْمَالَ بَیْنَ عَمَّۃٍ وَخَالَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31760","","","كتاب الفرائض"
"31761","(۳۱۷۶۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ زِیَادٍ ، قَالَ : إنِّی لأَعْلَمُ مَا صَنَعَ عُمَرُ ، جَعَلَ الْعَمَّۃَ بِمَنْزِلَۃِ الأَبِ ، وَالْخَالَۃَ بِمَنْزِلَۃِ الأُمِّ۔","Sahih","Musannaf Ibn Abi Shaybah 31761","","","كتاب الفرائض"
"31762","(۳۱۷۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، عَنْ عُمَرَ ، قَالَ : لِلْعَمَّۃِ الثُّلُثَانِ ، وَلِلْخَالَۃِ الثُّلُثُ۔","Hasan","Musannaf Ibn Abi Shaybah 31762","","","كتاب الفرائض"
"31763","(۳۱۷۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سُلَیْمَانَ الْعَبْسِیِّ ، عَنْ رَجُلٍ ، عَنْ عَلِیٍّ : أَنَّہُ کَانَ یَقُولُ فِی الْعَمَّۃِ وَالْخَالَۃِ بِقَوْلِ عُمَرَ : لِلْعَمَّۃِ الثُّلُثَانِ ، وَلِلْخَالَۃِ الثُّلُثُ۔","Da'if","Musannaf Ibn Abi Shaybah 31763","","","كتاب الفرائض"
"31764","(۳۱۷۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، أَنَّہُ کَانَ یُنَزِّلُ الْعَمَّۃَ بِمَنْزِلَۃِ الأَبِ ، وَالْخَالَۃَ بِمَنْزِلَۃِ الأُمِّ۔","","Musannaf Ibn Abi Shaybah 31764","","","كتاب الفرائض"
"31765","(۳۱۷۶۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عُمَرُ وَعَبْدُ اللہِ یُوَرِّثَانِ الْخَالَۃَ وَالْعَمَّۃَ إذَا لَمْ یَکُنْ غَیْرُہُمَا۔n قَالَ إبْرَاہِیمُ : کَانُوا یَجْعَلُونَ الْعَمَّۃَ بِمَنْزِلَۃِ الأَبِ ، وَالْخَالَۃَ بِمَنْزِلَۃِ الأُمِّ۔","","Musannaf Ibn Abi Shaybah 31765","","","كتاب الفرائض"
"31766","(۳۱۷۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ بَشِیرٍ الْہَمْدَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ مَسْعُودٍ ، أَنَّہُ کَانَ یَقُولُ فِی الْخَالَۃِ وَالْعَمَّۃِ : لِلْعَمَّۃِ الثُّلُثَانِ ، وَلِلْخَالَۃِ الثُّلُثُ۔","Da'if","Musannaf Ibn Abi Shaybah 31766","","","كتاب الفرائض"
"31767","(۳۱۷۶۷) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ مَنْصُورٍ وَمُغِیرَۃ، عَنْ إبْرَاہِیمَ، قَالَ: کَانُوا یُوَرَّثُونَ بِقَدْرِ أَرْحَامِہِمْ۔","","Musannaf Ibn Abi Shaybah 31767","","","كتاب الفرائض"
"31768","(۳۱۷۶۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیِّ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّ عُمَرَ وَرَّثَ الْخَالَۃَ وَالْعَمَّۃَ ، فَوَرَّثَ الْعَمَّۃَ الثُّلُثَیْنِ ، وَالْخَالَۃَ الثُّلُثَ۔","Hasan","Musannaf Ibn Abi Shaybah 31768","","","كتاب الفرائض"
"31769","(۳۱۷۶۹) حَدَّثَنَا سُوَیْد بْنُ عَمْرو ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ ابْنُ مَسْعُودٍ : لِلْعَمَّۃِ الثُّلُثَانِ ، وَلِلْخَالَۃِ الثُّلُثُ۔","","Musannaf Ibn Abi Shaybah 31769","","","كتاب الفرائض"
"31770","(۳۱۷۷۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : دُعِیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی جِنَازَۃِ رَجُلٍ مِنَ الأَنْصَارِ ، فَجَائَ عَلَی حِمَارٍ ، فَقَالَ : مَا تَرَکَ ؟ قَالُوا : تَرَکَ عَمَّۃً وَخَالَۃً ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَجُلٌ مَاتَ وَتَرَکَ عَمَّۃً وَخَالَۃً ، ثُمَّ سَارَ ، ثُمَّ قَالَ : رَجُلٌ مَاتَ وَتَرَکَ عَمَّۃً وَخَالَۃً ، ثُمَّ قَالَ : لَمْ أَجِدْ لَہُمَا شَیْئًا۔ (ابوداؤد ۳۶۱۔ سعید بن منصور ۱۶۳)","","Musannaf Ibn Abi Shaybah 31770","","","كتاب الفرائض"
"31771","(۳۱۷۷۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی بَکْرٍ ، قَالَ : قَالَ عُمَرُ : عَجَبًا لِلْعَمَّۃِ تُورثُ، وَلاَ تَرِثُ۔","","Musannaf Ibn Abi Shaybah 31771","","","كتاب الفرائض"
"31772","(۳۱۷۷۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ شَرِیکِ بْنِ عَبْدِ اللہِ بْنِ أَبِی نَمِرٍ ، قَالَ : سُئِلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ مِیرَاثِ الْعَمَّۃِ وَالْخَالَۃِ وَہُوَ رَاکِبٌ ، فَسَکَتَ ، ثُمَّ سَارَ ہُنَیْہَۃً ، ثُمَّ قَالَ : حَدَّثَنِی جِبْرِیلُ أَنَّہُ لاَ مِیرَاثَ لَہُمَا۔","","Musannaf Ibn Abi Shaybah 31772","","","كتاب الفرائض"
"31773","(۳۱۷۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ: أَنَّہُ کَانَ یَرَی الْمِیرَاثَ لِلْمَوَالِی دُونَ الْعَمَّۃِ وَالْخَالَۃِ۔","","Musannaf Ibn Abi Shaybah 31773","","","كتاب الفرائض"
"31774","(۳۱۷۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ عَیَّاش بْنِ أَبِی رَبِیعَۃَ الزُّرَقِیِّ ، عَنْ حَکِیمِ بْنِ حَکِیمِ بْنِ عَبَّادِ بْنِ حُنَیْفٍ الأَنْصَارِیِّ ، عَنْ أَبِی أُمَامَۃَ بْنِ سَہْلِ بْنِ حُنَیْفٍ : أَنَّ رَجُلاً رَمَی رَجُلاً بِسَہْمٍ فَقَتَلَہُ وَلَیْسَ لَہُ وَارِثٌ إلاَّ خَالٌ ، فَکَتَبَ فِی ذَلِکَ أَبُو عُبَیْدَۃَ بْنُ الْجَرَّاحِ إلَی عُمَرَ ، فَکَتَبَ إلَیْہِ عُمَرُ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : اللَّہُ وَرَسُولُہُ مَوْلَی مَنْ لاَ مَوْلَی لَہُ ، وَالْخَالُ وَارِثُ مَنْ لاَ وَارِثَ لَہُ۔ (ترمذی ۲۱۰۳۔ ابن ماجہ ۲۷۳۷)","Da'if","Musannaf Ibn Abi Shaybah 31774","","","كتاب الفرائض"
"31775","(۳۱۷۷۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ، قَالَ: وَرَّثَ عُمَرُ الْخَالَ الْمَالَ کُلَّہُ، قَالَ: کَانَ خَالاً وَمَوْلًی۔","","Musannaf Ibn Abi Shaybah 31775","","","كتاب الفرائض"
"31776","(۳۱۷۷۶) حَدَّثَنَا وَکِیعٌ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ، عَنْ عَبْدِاللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ: أَنَّ عُمَرَ وَرَّثَ خَالاً وَمَوْلًی مِنْ مَوْلاَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31776","","","كتاب الفرائض"
"31777","(۳۱۷۷۷) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ : حَدَّثَنَا بُدَیْلُ بْنُ مَیْسَرَۃَ الْعُقَیْلِیُّ ، عَنِ ابْنِ أَبِی طَلْحَۃَ ، عَنْ رَاشِدِ بْنِ سَعْدٍ ، عَنْ أَبِی عَامِرٍ الْہَوْزَنِیُّ ، عَنِ الْمِقْدَامِ رَجُلٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْخَالُ وَارِثُ مَنْ لاَ وَارِثَ لَہُ۔ (ابوداؤد ۲۸۹۱۔ ابن حبان ۶۰۳۵)","Hasan","Musannaf Ibn Abi Shaybah 31777","","","كتاب الفرائض"
"31778","(۳۱۷۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : سُئِلَ مَسْرُوقٌ عَنْ رَجُلٍ مَاتَ وَلَیْسَ لَہُ وَارِثٌ إلاَّ خَالُہُ وَابْنَۃُ أَخِیہ ؟ قَالَ : لِلْخَالِ نَصِیبُ أُخْتِہِ ، وَلاِبْنَۃِ الأَخِ نَصِیبُ أَبِیہَا۔","","Musannaf Ibn Abi Shaybah 31778","","","كتاب الفرائض"
"31779","(۳۱۷۷۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، عَنْ عَمِّہِ وَاسِعِ بْنِ حَبَّانَ، قَالَ : ہَلَکَ ابْنُ دَحْدَاحَۃَ وَکَانَ ذَا رَأْیٍ فِیہِمْ ، فَدَعَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَاصِمَ بْنَ عَدِیٍّ ، فَقَالَ : ہَلْ کَانَ لَہُ فِیکُمْ نَسَبٌ ؟ قَالَ : لاَ ، قَالَ : فَأَعْطَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِیرَاثَہُ ابْنَ أُخْتِہِ أَبَا لُبَابَۃَ بْنَ عَبْدِ الْمُنْذِرِ۔ (عبدالرزاق ۱۹۱۲۰)","","Musannaf Ibn Abi Shaybah 31779","","","كتاب الفرائض"
"31780","(۳۱۷۸۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ وُہَیْبٍ ، عَنِ ابْنِ طَاوس ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلْحِقُوا الْفَرَائِضَ بِأَہْلِہَا فَمَا بَقِیَ فَہُوَ لأَوْلَی رَجُلٍ۔ (بخاری ۶۷۳۲۔ مسلم ۱۲۳۳)","Sahih","Musannaf Ibn Abi Shaybah 31780","","","كتاب الفرائض"
"31781","(۳۱۷۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ رَجُلٍ مِنْ أَہْلِ الْمَدِینَۃِ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، عَنْ عَمِّہِ وَاسِعِ بْنِ حَبَّانَ ، قَالَ : کَانَ ثَابِتُ ابْنُ الدَّحْدَاحَ رَجُلاً أَتِیًّا - یَعْنِی : طَارِئًا - وَکَانَ فِی بَنِی أُنَیفٍ ، أَوْ فِی بَنِی الْعَجْلاَنِ ، فَمَاتَ وَلَمْ یَدَعْ وَارِثًا إلاَّ ابْنَ أُخْتِہِ أَبَا لُبَابَۃَ بْنَ عَبْدِ الْمُنْذِرِ ، فَأَعْطَاہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِیرَاثَہُ۔ (عبدالرزا ق۱۹۱۲۰)","Da'if","Musannaf Ibn Abi Shaybah 31781","","","كتاب الفرائض"
"31782","(۳۱۷۸۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عُبَیْدِ بْنِ أَبِی الْجَعْدِ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، قَالَ : تَدْرِی مَا ابْنَۃُ حَمْزَۃَ مِنِّی ہِیَ أُخْتِی لأُمِّی ، أَعْتَقَتْ رَجُلاً فَمَاتَ فَقُسِمَ مِیرَاثُہُ بَیْنَ ابْنَتِہِ وَبَیْنَہَا ، قَالَ : عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (سعید بن منصور ۱۷۳)","","Musannaf Ibn Abi Shaybah 31782","","","كتاب الفرائض"
"31783","(۳۱۷۸۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، عَنِ ابْنَۃِ حَمْزَۃَ - قَالَ مُحَمَّدٌ : وَہِیَ أُخْتُ ابْنِ شَدَّادٍ لأُمِّہِ - قَالَتْ : مَاتَ مَوْلًی لِی وَتَرَکَ ابْنَتَہُ ، فَقَسَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَالَہُ بَیْنِی وَبَیْنَ ابْنَتِہِ ، فَجَعَلَ لِی النِّصْفَ وَلَہَا النِّصْفَ۔","Da'if","Musannaf Ibn Abi Shaybah 31783","","","كتاب الفرائض"
"31784","(۳۱۷۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أعْطَی ابْنَۃَ حَمْزَۃَ النِّصْفَ وَابْنَتَہُ النِّصْفَ۔","","Musannaf Ibn Abi Shaybah 31784","","","كتاب الفرائض"
"31785","(۳۱۷۸۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ الحَسَنِ بْنِ صَالِحٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ أَبِی بُرْدَۃَ : أَنَّ رَجُلاً مَاتَ وَتَرَکَ ابْنَتَہُ وَمَوَالِیَہُ الَّذِینَ أَعْتَقُوہُ فَأَعْطَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ابْنَتَہُ النِّصْفَ وَمَوَالِیَہُ النِّصْفَ۔ (ابوداؤد ۳۶۳۔ بیہقی ۲۴۱)","","Musannaf Ibn Abi Shaybah 31785","","","كتاب الفرائض"
"31786","(۳۱۷۸۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْحَکَمِ ، عَنْ شَمُوسٍ الْکِنْدِیَّۃِ ، قَالَتْ : قاضَیْت إلَی عَلِیٍّ فِی أَبِی : مَاتَ وَلَمْ یَتْرُکْ غَیْرِی وَمَوْلاَہُ ، فَأَعْطَانِی النِّصْفَ وَمَوْلاَہُ النِّصْفَ۔","Da'if","Musannaf Ibn Abi Shaybah 31786","","","كتاب الفرائض"
"31787","(۳۱۷۸۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْحَکَمِ ، عَنْ شَمُوسٍ ، عَنْ عَلِیٍّ ، بِمِثْلِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 31787","","","كتاب الفرائض"
"31788","(۳۱۷۸۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ أَبِی الْکَنُودِ ، عَنْ عَلِیٍّ : أَنَّہُ قَضَی فِی ابْنَۃٍ وَمَوْلًی ، أَعْطَی الْبِنْتَ النِّصْفَ ، وَالْمَوْلَی النِّصْفَ۔","Da'if","Musannaf Ibn Abi Shaybah 31788","","","كتاب الفرائض"
"31789","(۳۱۷۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ : أَنَّ مَوْلًی لاِبْنَۃِ حَمْزَۃَ مَاتَ وَتَرَکَ ابْنَتَہُ وَابْنَۃَ حَمْزَۃَ ، فَأَعْطَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ابْنَۃَ حَمْزَۃَ النِّصْفَ ، وَابْنَتَہُ النِّصْفَ۔","","Musannaf Ibn Abi Shaybah 31789","","","كتاب الفرائض"
"31790","(۳۱۷۹۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ عَبْدِ الرَّحْمَنِ الْمُحَارِبِیُّ ، عَنْ زَائِدَۃَ ، عَنْ أَبِی حَصِینٍ ، قَالَ : خَاصَمْت إلَی شُرَیْحٍ فِی مَوْلًی لَنَا مَاتَ وَتَرَکَ ابْنَتَیْہِ وَمَوَالِیَہُ ، فَأَعْطَی شُرَیْحٌ ابْنَتَیْہِ الثُّلُثَیْنِ ، وَأَعْطَی مَوْلاَہُ الثُّلُثَ۔","","Musannaf Ibn Abi Shaybah 31790","","","كتاب الفرائض"
"31791","(۳۱۷۹۱) حَدَّثَنَا عَبْدَۃُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : ذُکِرَ عِنْدَہُ حَدِیثُ ابْنَۃِ حَمْزَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَعْطَاہَا النِّصْفَ ، فَقَالَ : إنَّمَا أَطْعَمَہَا إیَّاہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ طُعْمَۃً۔","","Musannaf Ibn Abi Shaybah 31791","","","كتاب الفرائض"
"31792","(۳۱۷۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورِ بْنِ حَیَّانَ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ : أَنَّ مَوْلًی لاِبْنَۃِ حَمْزَۃَ مَاتَ وَتَرَکَ ابْنَتَہُ وَابْنَۃَ حَمْزَۃَ ، فَأَعْطَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ابْنَتَہُ النِّصْفَ ، وَابْنَۃَ حَمْزَۃَ النِّصْفَ۔n قَالَ أَبُو بَکْرٍ : وَہَذِہِ مِنْ سَہْمَیْنِ : لِلْبِنْتِ النِّصْفُ وَلِلْمَوْلَی النِّصْفُ۔ (طحاوی ۴۰۱۔ بیہقی ۲۴۱)","","Musannaf Ibn Abi Shaybah 31792","","","كتاب الفرائض"
"31793","(۳۱۷۹۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ۔ وَعَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ : أَنَّ عَلِیًّا کَانَ یَقُولُ فِی الْمَمْلُوکِینَ وَأَہْلِ الْکِتَابِ : لاَ یَحْجُبُونَ ، وَلاَ یَرِثُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 31793","","","كتاب الفرائض"
"31794","(۳۱۷۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، عَنِ زَیْدِ بْنِ ثَابِتٍ قَالَ : لاَ یَحْجُبُونَ وَلاَ یَرِثُونَ۔","","Musannaf Ibn Abi Shaybah 31794","","","كتاب الفرائض"
"31795","(۳۱۷۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ ، قَالَ عُمَرُ : لاَ یَحْجُبُ مَنْ لاَ یَرِثُ۔","","Musannaf Ibn Abi Shaybah 31795","","","كتاب الفرائض"
"31796","(۳۱۷۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ أَبِی صَادِقٍ ، عَنْ عَلِیٍّ ، قَالَ : الْمَمْلُوکُونَ لاَ یَرِثُونَ ، وَلاَ یَحْجُبُونَ۔","","Musannaf Ibn Abi Shaybah 31796","","","كتاب الفرائض"
"31797","(۳۱۷۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ أَبِی صَادِقٍ : أَنَّ رَجُلاً سَأَلَ عَلِیًّا عَنِ امْرَأَۃٍ مَاتَتْ وَتَرَکَتْ أُخْتُہَا وَأُمُّہَا مَمْلُوکَۃٌ ؟ فَقَالَ عَلِیٌّ : ہَلْ یُحِیطُ السُّدُسُ بِرَقَبَتِہَا ؟ فَقَالَ : لاَ ، فَقَالَ : دَعْنَا مِنْہَا سَائِرَ الْیَوْمِ۔","","Musannaf Ibn Abi Shaybah 31797","","","كتاب الفرائض"
"31798","(۳۱۷۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، عَنْ شُرَیْحٍ ، أَنَّہُ أَعْطَی مِیرَاثَ رَجُلٍ - أَخُوہُ مَمْلُوکُ - بَنِی أَخِیہِ الأَحْرَارَ۔","","Musannaf Ibn Abi Shaybah 31798","","","كتاب الفرائض"
"31799","(۳۱۷۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یَرِثُہُ بَنُو أَخِیہِ الأَحْرَارُ۔","","Musannaf Ibn Abi Shaybah 31799","","","كتاب الفرائض"
"31800","(۳۱۸۰۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ : فِی رَجُلٍ مَاتَ وَتَرَکَ أُمَّہُ مَمْلُوکَۃً ، وَجَدَّتَہُ حُرَّۃً ، قَالَ : الْمَالُ لِلْجَدَّۃِ۔","","Musannaf Ibn Abi Shaybah 31800","","","كتاب الفرائض"
"31801","(۳۱۸۰۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَعْمَرٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ وَزَیْدٍ : فِی الْمَمْلُوکِینَ وَالْمُشْرِکِینَ ، قَالاَ : لاَ یَحْجُبُونَ ، وَلاَ یَرِثُونَ۔","","Musannaf Ibn Abi Shaybah 31801","","","كتاب الفرائض"
"31802","(۳۱۸۰۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ۔ وَعَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ مَسْعُودٍ : أَنَّہُ کَانَ یَحْجُبُ بِالْمَمْلُوکِینَ وَأَہْلِ الْکِتَابِ ، وَلاَ یُوَرِّثُہُمْ۔","","Musannaf Ibn Abi Shaybah 31802","","","كتاب الفرائض"
"31803","(۳۱۸۰۳) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : إذَا مَاتَ الرَّجُلُ وَتَرَکَ أَبَاہُ ، أَوْ أَخَاہُ، أَو ابْنَہُ مَمْلُوکًا وَلَمْ یَتْرُکْ وَارِثًا فَإِنَّہُ یُشْتَرَی فَیُعْتَقُ ، ثُمَّ یُوَرَّثُ۔","","Musannaf Ibn Abi Shaybah 31803","","","كتاب الفرائض"
"31804","(۳۱۸۰۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، عَنِ ابْنِ مَسْعُودٍ : فِی رَجُلٍ مَاتَ وَتَرَکَ أَبَاہُ مَمْلُوکًا، قَالَ : یُشْتَرَی مِنْ مَالِہِ فَیُعْتَقُ ، ثُمَّ یُوَرَّثُ ، قَالَ : وَکَانَ الْحَسَنُ یَقُولُہُ۔","","Musannaf Ibn Abi Shaybah 31804","","","كتاب الفرائض"
"31805","(۳۱۸۰۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 31805","","","كتاب الفرائض"
"31806","(۳۱۸۰۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عُمَرُ وَعَبْدُ اللہِ یُعْطِیَانِ الْمِیرَاثَ ذَوِی الأَرْحَامِ، قَالَ فُضَیْلٌ: فَقُلْتُ لإِبْرَاہِیمَ: فَعَلِیٌّ؟ قَالَ: کَانَ أَشَدَّہُمْ فِی ذَلِکَ: أَنْ یُعْطِیَ ذَوِی الأَرْحَامِ۔","","Musannaf Ibn Abi Shaybah 31806","","","كتاب الفرائض"
"31807","(۳۱۸۰۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ وَعُمَرَ وَعَلِیٍّ ، وَعَبْدِ اللہِ ، بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 31807","","","كتاب الفرائض"
"31808","(۳۱۸۰۸) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنْ أَبِی الزَّاہِرِیَّۃِ - قَالَ أَبُو بَکْرٍ : أَظُنُّہُ ، عَنْ جُبَیْرِ بْنِ نُفَیْرٍ - قَالَ : کُنْتُ جَالِسًا عِنْدَ أَبِی الدَّرْدَائِ - وَکَانَ قَاضِیًا - فَأَتَاہُ رَجُلٌ ، فَقَالَ : إنَّ ابْنَ أُخْتِی مَاتَ وَلَمْ یَدَعْ وَارِثًا ، فَکَیْفَ تَرَی فِی مَالِہِ ؟ قَالَ : انْطَلِقْ فَاقْبِضْہُ۔","Hasan","Musannaf Ibn Abi Shaybah 31808","","","كتاب الفرائض"
"31809","(۳۱۸۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَیَّانَ الْجُعْفِیِّ ، عَنْ سُوَیْد بْنِ غَفَلَۃً : أَنَّ عَلِیًّا أُتِیَ فِی ابْنَۃٍ وَامْرَأَۃٍ وَمَوَالِی ، فَأَعْطَی الاِبْنَۃَ النِّصْفَ ، وَالْمَرْأَۃَ الثُّمُنَ ، وَرَدَّ مَا بَقِیَ عَلَی الاِبْنَۃِ ، وَلَمْ یُعْطِ الْمَوَالِی شَیْئًا۔","Sahih","Musannaf Ibn Abi Shaybah 31809","","","كتاب الفرائض"
"31810","(۳۱۸۱۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ مَیْسَرَۃَ ، عَنْ إبْرَاہِیمَ : أَنَّہُ أَنْکَرَ حَدِیثَ ابْنَۃِ حَمْزَۃَ ، وَقَالَ : إنَّمَا أَطْعَمَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ طُعْمَۃً۔","","Musannaf Ibn Abi Shaybah 31810","","","كتاب الفرائض"
"31811","(۳۱۸۱۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : أَوْصَی مَوْلًی لِعَلْقَمَۃَ لأَہْلِ عَلْقَمَۃَ بِالثُّلُثِ ، وَأَعْطَی ابْنَ أَخِیہِ لأُمِّہِ الثُّلُثَیْنِ۔","","Musannaf Ibn Abi Shaybah 31811","","","كتاب الفرائض"
"31812","(۳۱۸۱۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ سَالِمٍ ، قَالَ : أُتِیَ عَلِیٌّ فِی رَجُلٍ تَرَکَ جَدَّتَہُ وَمَوَالِیَہُ ، فَأَعْطَی الْجَدَّۃَ الْمَالَ دُونَ الْمَوَالِی۔","Sahih","Musannaf Ibn Abi Shaybah 31812","","","كتاب الفرائض"
"31813","(۳۱۸۱۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کُنْتُ أَمْشِی مَعَہُ فَأَدْرَکَتْہُ امْرَأَۃٌ عِنْدَ الصَّیَاقِلَۃِ ، قَالَتْ : إنَّ مَوْلاَتَکَ قَدْ مَاتَتْ فَخُذْ مِیرَاثَہَا ، قَالَ : ہُوَ لَک ، فَقَالَتْ : بَارَکَ اللَّہُ لَک فِیہِ ، قَالَ : أَمَا إِنَّہُ لَوْ کَانَ لِی لَمْ أَدَعْہُ لَک ، وَإِنَّہُ لَمُحْتَاجٌ یَوْمَئِذٍ إلَی تَوْرٍ یُصِیبہُ مِنْ مِیرَاثِہَا ، مِنْ خَمْسَۃِ دَرَاہِمَ ، فَقُلْتُ لَہُ : مَا ہَذِہِ مِنْہَا : قَالَ : ابْنَۃُ أُخْتِہَا لأُمِّہَا۔","","Musannaf Ibn Abi Shaybah 31813","","","كتاب الفرائض"
"31814","(۳۱۸۱۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : أُتِیَ ابْنُ مَسْعُودٍ فِی أُمٍّ وَإِخْوَۃٍ لأُمٍّ ، فَأَعْطَی الإِخْوَۃَ لِلأُمِّ الثُّلُثَ ، وَأَعْطَی الأُمَّ سَائِرَ الْمَالِ ، وَقَالَ : الأُمُّ عَصَبَۃُ مَنْ لاَ عَصَبَۃَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31814","","","كتاب الفرائض"
"31815","(۳۱۸۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن مَسْرُوقٍ ، قَالَ : أُتِیَ عَبْدُ اللہِ فِی أُمٍّ وَإِخْوَۃٍ لأُمٍ ، فَأَعْطَی الأُمَّ السُّدُسَ وَالإِخْوَۃَ الثُّلُثَ ، وَرَدَّ مَا بَقِیَ عَلَی الأُمِّ ، وَقَالَ : الأُمُّ عَصَبَۃُ مَنْ لاَ عَصَبَۃَ لَہُ، وَکَانَ ابْنُ مَسْعُودٍ لاَ یَرُدُّ عَلَی أُخْتٍ لأَبٍ مَعَ أُخْتٍ لأَبٍ وَأَمٍ، وَلاَ عَلَی ابْنَۃِ ابْنٍ مَعَ ابْنَۃِ صُلْبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31815","","","كتاب الفرائض"
"31816","(۳۱۸۱۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ وَالأَعْمَشِ ، عَنْ إبْرَاہِیمَ : أَنَّ عَلِیًّا کَانَ یَرُدُّ عَلَی کُلِّ ذِی سَہْمٍ إلاَّ الزَّوْجَ وَالْمَرْأَۃَ۔","","Musannaf Ibn Abi Shaybah 31816","","","كتاب الفرائض"
"31817","(۳۱۸۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، قَالَ : بَلَغَنِی عَنْ عَلِیٍّ أَنَّہُ کَانَ یَرُدُّ عَلَی کُلِّ ذِی سَہْمٍ إلاَّ الزَّوْجَ وَالْمَرْأَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 31817","","","كتاب الفرائض"
"31818","(۳۱۸۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ : أَنَّ عَلِیًّا کَانَ یَرُدُّ عَلَی ذَوِی السِّہَامِ مِنْ ذَوِی الأَرْحَامِ۔","Da'if","Musannaf Ibn Abi Shaybah 31818","","","كتاب الفرائض"
"31819","(۳۱۸۱۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ : أَنَّہُ ذُکِرَ عِنْدَہُ قَضَائً قَضَی بِہِ أَبُو عُبَیْدَۃَ بْنُ عَبْدِ اللہِ : أَنَّہُ أَعْطَی ابْنَۃً أِوْ أُخْتِاً الْمَالَ کُلَّہُ ، فَقَالَ الشَّعْبِیُّ : ہَذَا قَضَائُ عَبْدِ اللہِ۔","","Musannaf Ibn Abi Shaybah 31819","","","كتاب الفرائض"
"31820","(۳۱۸۲۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إسْمَاعِیلَ ، عَنْ عَامِرٍ ، عَنْ عَبْدِ اللہِ : أَنَّہُ کَانَ یَرُدُّ عَلَی الاِبْنَۃِ وَالأُخْتِ وَالأُمِّ إذَا لَمْ تَکُنْ عَصَبَۃٌ ، وَکَانَ زَیْدٌ لاَ یُعْطِیہِمْ إلاَّ نَصِیبَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 31820","","","كتاب الفرائض"
"31821","(۳۱۸۲۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ لاَ یَرُدُّ عَلَی سِتَّۃٍ : عَلَی زَوْجٍ ، وَلاَ امْرَأَۃٍ ، وَلاَ جَدَّۃٍ ، وَلاَ عَلَی أَخَوَاتٍ لأَبٍ مَعَ أَخَوَاتٍ لأَبٍ وَأَمٍ ، وَلاَ عَلَی بَنَاتِ ابْنٍ مَعَ بَنَاتِ صُلْبٍ ، وَلاَ عَلَی أُخْتٍ لأُمٍّ مَعَ أُمٍّ ، قَالَ إبْرَاہِیمُ : فَقُلْتُ لِعَلْقَمَۃَ یُرَدُّ عَلَی الأُخْوَۃِ مِنَ الأُمِّ مَعَ الْجَدَّۃِ ، قَالَ : إنْ شِئْت ، قَالَ : وَکَانَ عَلِیٌّ یَرُدُّ عَلَی جَمِیعِہِمْ إلاَّ الزَّوْجَ وَالْمَرْأَۃَ۔","","Musannaf Ibn Abi Shaybah 31821","","","كتاب الفرائض"
"31822","(۳۱۸۲۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ لاَ یَرُدُّ عَلَی سِتَّۃٍ : لاَ یَرُدُّ عَلَی زَوْجٍ ، وَلاَ امْرَأَۃٍ ، وَلاَ جَدَّۃٍ ، وَلاَ عَلَی أُخْتٍ لأَبٍ مَعَ أُخْتٍ لأَبٍ وَأَمٍ ، وَلاَ عَلَی أُخْتٍ لأُمٍّ مَعَ أُمٍ ، وَلاَ عَلَی ابْنَۃِ ابْنٍ مَعَ ابْنَۃِ صُلْبٍ۔","","Musannaf Ibn Abi Shaybah 31822","","","كتاب الفرائض"
"31823","(۳۱۸۲۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : اُسْتُشْہِدَ سَالِمٌ مَوْلَی أَبِی حُذَیْفَۃَ ، قَالَ : فَأَعْطَی أَبُو بَکْرٍ ابْنَتَہُ النِّصْفَ وَأَعْطَی النِّصْفَ الثَّانِی فِی سَبِیلِ اللہِ۔","","Musannaf Ibn Abi Shaybah 31823","","","كتاب الفرائض"
"31824","(۳۱۸۲۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلِ بْنِ عَمْرٍو ، قَالَ : قَالَ إبْرَاہِیمُ : لَمْ یَکُنْ أَحَدٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَرُدُّ عَلَی الْمَرْأَۃِ وَالزَّوْجِ شَیْئًا ، قَالَ : وَکَانَ زَیْدٌ یُعْطِی کُلَّ ذِی فَرْضٍ فَرِیضَتَہُ، وَمَا بَقِیَ جَعَلَہُ فِی بَیْتِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 31824","","","كتاب الفرائض"
"31825","(۳۱۸۲۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ لاَ یَرُدُّ عَلَی أُخْتٍ لأَبٍ مَعَ أُخْتٍ لأَبٍ وَأَمٍّ ، وَلاَ یَرُدُّ عَلَی ابْنَۃِ ابْنٍ مَعَ ابْنَۃٍ شَیْئًا ، وَلاَ عَلَی إخْوَۃٍ لأُمٍّ مَعَ أُمٍّ شَیْئًا ، وَلاَ عَلَی زَوْجٍ ، وَلاَ امْرَأَۃٍ۔","","Musannaf Ibn Abi Shaybah 31825","","","كتاب الفرائض"
"31826","(۳۱۸۲۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ وَالأَعْمَشِ ، قَالاَ : لَمْ یَکُنْ أَحَدٌ یَرُدُّ عَلَی جَدَّۃٍ إلاَّ أَنْ یَکُونَ غَیْرَہَا۔","","Musannaf Ibn Abi Shaybah 31826","","","كتاب الفرائض"
"31827","(۳۱۸۲۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنِ الْعَمَّۃِ : أَہِیَ أَحَقُّ بِالْمِیرَاثِ ، أَو ابْنَۃُ الأَخِ ؟ قَالَ : فَقَالَ لِی : وَأَنْتَ لاَ تَعْلَمُ ذَلِکَ ، قَالَ : قُلْتُ : ابْنَۃُ الأَخِ أَحَقُّ مِنَ الْعَمَّۃِ ، قَالَ أَبُو إِسْحَاقَ : وَشَہِدَ عَامِرٌ عَلَی مَسْرُوقٍ أَنَّہُ قَالَ : أَنْزِلُوہُمْ مَنَازِلَ آبَائِہِمْ۔","","Musannaf Ibn Abi Shaybah 31827","","","كتاب الفرائض"
"31828","(۳۱۸۲۸) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنِ الشَّیْبَانِیِّ، عَنِ الشَّعْبِیِّ، عَنِ مَسْرُوقٍ، قَالَ: أَنْزِلُوا ذَوِی الأَرْحَامِ مَنَازِلَ آبَائِہِمْ۔","","Musannaf Ibn Abi Shaybah 31828","","","كتاب الفرائض"
"31829","(۳۱۸۲۹) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنِ الشَّیْبَانِیِّ، عَنِ الشَّعْبِیِّ: فِی ابْنَۃِ أَخٍ وَعَمَّۃٍ، قَالَ: الْمَالُ لاِبْنَۃِ الأَخِ۔","","Musannaf Ibn Abi Shaybah 31829","","","كتاب الفرائض"
"31830","(۳۱۸۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْمَالُ لِلْعَمَّۃِ۔","","Musannaf Ibn Abi Shaybah 31830","","","كتاب الفرائض"
"31831","(۳۱۸۳۱) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ مُغِیرَۃَ وَمَنْصُورٍ، عَنْ إبْرَاہِیمَ، قَالَ: کَانُوا یُوَرَّثُونَ بِقَدْرِ أَرْحَامِہِمْ۔","","Musannaf Ibn Abi Shaybah 31831","","","كتاب الفرائض"
"31832","(۳۱۸۳۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنِ ابْنَۃِ أَخٍ وَعَمَّۃٍ أَیُّہُمَا أَحَقُّ بِالْمِیرَاثِ ؟ قَالَ : ابْنَۃُ الأَخِ ، قَالَ : أَنْزِلُوہُمْ مَنَازِلَ آبَائِہِمْ۔","","Musannaf Ibn Abi Shaybah 31832","","","كتاب الفرائض"
"31833","(۳۱۸۳۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، قَالَ : قَالَ إبْرَاہِیمُ : قَالَ عَلِیٌّ : لاَ یُضْرَبُ بِسَہْمِ مَنْ لاَ یَرِثُ۔","","Musannaf Ibn Abi Shaybah 31833","","","كتاب الفرائض"
"31834","(۳۱۸۳۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالَ : ذُو السَّہْمِ أَحَقُّ مِمَّنْ لاَ سَہْمَ لَہُ","","Musannaf Ibn Abi Shaybah 31834","","","كتاب الفرائض"
"31835","(۳۱۸۳۵) قَالَ وَکِیعٌ : وَقَالَ غَیْرُ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ مَاتَ وَتَرَکَ أُخْتَیْنِ لأَبٍ وَأُخْتَیْنِ لأَبٍ وَأَمٍّ ، قَالَ : کَانَ یُقَالَ : ذُو السَّہْمِ أَحَقُّ مِمَّنْ لاَ سَہْمَ لَہُ۔","","Musannaf Ibn Abi Shaybah 31835","","","كتاب الفرائض"
"31836","(۳۱۸۳۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ مُسْلِمَۃٍ تَرَکَتْ زَوْجَہَا مُسْلِمًا وَإِخْوَتَہَا لأُمِّہَا مُسْلِمِینَ وَلَہَا ابْنٌ نَصْرَانِیٌّ ، أَوْ یَہُودِیٌّ ، أَوْ کَافِرٌ ، فَلِزَوْجِہَا النِّصْفُ ثَلاَثَۃُ أَسْہُمٍ وَلاِِخْوَتِہَا لأُمِّہَا الثُّلُثُ سَہْمَانِ ، وَمَا بَقِیَ فَلِذِی الْعَصَبَۃِ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ ، وَلاَ یَرِثُ یَہُودِیٌّ ، وَلاَ نَصْرَانِیٌّ مُسْلِمًا، وَقَضَی فِیہَا عَبْدُ اللہِ : أَنَّ لِلزَّوْجِ الرُّبْعَ مِنْ أَجْلِ أَنَّ لَہَا وَلَدًا کَافِرًا ، وَہُمْ یَحْجِبُونَ فِی قَوْلِ عَبْدِ اللہِ ، وَلاَ یَرِثُونَ ، وَفِی قَوْلِ عَلِیٍّ وَزَیْدٍ : لاَ یَحْجُبُونَ وَلاَ یَرِثُونَ ، قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ مِنْ سِتَّۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَبْدِ اللہِ بْنِ مَسْعُودٍ مِنْ أَرْبَعَۃٍ۔","","Musannaf Ibn Abi Shaybah 31836","","","كتاب الفرائض"
"31837","(۳۱۸۳۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ فِی امْرَأَۃٍ مُسْلِمَۃٍ تَرَکَتْ أُمَّہَا مُسْلِمَۃً وَلَہَا إخْوَۃٌ نَصَارَی أَوْ یَہُودٌ ، أَوْ کُفَّارٌ ، فَقَضَی عَبْدُ اللہِ : أَنَّ لَہَا مَعَہُمَ السُّدُسَ ، وَجَعَلَہُمْ یَحْجُبُونَ وَلاَ یَرِثُونَ ، وَقَضَی فِیہَا سَائِرُ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنَّہُمْ لاَ یَحْجُبُونَ وَلاَ یَرِثُونَ۔n قَالَ أَبُو بَکْرٍ : فَہِیَ فِیمَا قَضَی سَائِرُ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ غَیْرُ عَبْدِ اللہِ مِنْ أَرْبَعَۃِ أَسْہُمٍ ، فَہِیَ لِذِی الْعَصَبَۃِ ، وَہِیَ فِی قَضَائِ عَبْدِ اللہِ : مِنْ خَمْسَۃُ أَسْہُمٍ ، فَہِیَ لِذِی الْعَصَبَۃِ بِالرَّحِمِ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِہِمْ جَمِیعًا مِنْ سِتَّۃِ أَسْہُمٍ ، إنْ کَانَ فِی قَوْلِ عَبْدِ اللہِ : فَلِلأُمِّ السُّدُسُ وَیَبْقَی خَمْسَۃٌ ، وَإِنْ کَانَ فِی قَوْلِ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فَلِلأُمِّ الثُّلُثُ وَہُوَ سَہْمَانِ ، وَأَرْبَعَۃٌ لِسَائِرِ الْعَصَبَۃِ۔","","Musannaf Ibn Abi Shaybah 31837","","","كتاب الفرائض"
"31838","(۳۱۸۳۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ : فِی امْرَأَۃٍ تَرَکَتْ زَوْجَہَا وَإِخْوَتَہَا لأُمِّہَا أَحْرَارًا ، وَلَہَا ابْنٌ مَمْلُوکٌ : فَلِزَوْجِہَا النِّصْفُ ثَلاَثَۃُ أَسْہُمٍ ، وَلإِخْوَتِہَا لأُمِّہَا الثُّلُثُ سَہْمَانِ ، وَیَبْقَی السُّدُسُ فَہُوَ لِلْعَصَبَۃِ ، وَلاَ یَرِثُ ابْنُہَا الْمَمْلُوکُ شَیْئًا فِی قَضَائِ عَلِی۔n وَقَضَی فِیہَا عَبْدُ اللہِ : أَنَّ لِزَوْجِہَا الرُّبْعَ سَہْم وَنِصْف ، وَأَنَّ ابْنَہَا یَحْجُبُ الإِخْوَۃَ مِنَ الأُمِّ إذَا کَانَ مَمْلُوکًا، وَلاَ یَرِثُ ابْنُہَا شَیْئًا وَیَحْجُبُ الزَّوْجَ ، وَأَنَّ الثَّلاَثَۃَ أَرْبَاعٍ الْبَاقِیَۃِ لِلْعَصَبَۃِ۔n وَقَضَی فِیہَا زَیْدٌ : أَنَّ لِزَوْجِہَا النِّصْفَ ثَلاَثَۃَ أَسْہُمٍ ، وَأَنَّ لاِِخْوَتِہَا لأُمِّہَا الثُّلُثَ سَہْمَانِ ، وَمَا بَقِیَ فَہُوَ فِی بَیْتِ الْمَالِ إذَا لَمْ یَکُنْ ، وَلاَئٌ ، وَلاَ رَحِمٌn قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ مِنْ سِتَّۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَبْدِ اللہِ بْنِ مَسْعُودٍ مِنْ أَرْبَعَۃِ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31838","","","كتاب الفرائض"
"31839","(۳۱۸۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ جُرَیْج ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الْفَرَائِضُ لاَ تَعُولُ۔","","Musannaf Ibn Abi Shaybah 31839","","","كتاب الفرائض"
"31840","(۳۱۸۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ وَعَبْدِ اللہِ وَزَیْدٍ : أَنَّہُمْ أَعَالُوا الْفَرِیضَۃَ۔","","Musannaf Ibn Abi Shaybah 31840","","","كتاب الفرائض"
"31841","(۳۱۸۴۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ : فِی أُخْتَیْنِ لأَبٍ وَأَمٍّ ، وَأُخْتَیْنِ لأُمٍّ ، وَزَوْجٍ ، وَأَمٍّ ، قَالَ : مِنْ عَشَرَۃٍ ، لِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ أَرْبَعَۃٌ ، وَلِلأُخْتَیْنِ مِنَ الأُمّ سَہْمَانِ ، وَلِلزَّوْجِ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأُمِّ سَہْمٌ۔n وَقَالَ وَکِیعٌ : وَالنَّاسُ عَلَی ہَذَا ، وَہَذِہِ قِسْمَۃُ ابْن الْفَرُّوخِ۔","","Musannaf Ibn Abi Shaybah 31841","","","كتاب الفرائض"
"31842","(۳۱۸۴۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَحْجُبُنِی بَنُو بَنِیَّ دُونَ إخْوَتِی ، وَلاَ أَحْجُبُہُمْ دُونَ إخْوَتِہِمْ۔","","Musannaf Ibn Abi Shaybah 31842","","","كتاب الفرائض"
"31843","(۳۱۸۴۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ أُخْتَہَا لأُمِّہَا وَأُمَّہَا ، وَلاَ عَصَبَۃَ لَہَا ، فَلأُخْتِہَا مِنْ أُمِّہَا السُّدُسُ ، وَلأُمِّہَا خَمْسَۃُ أَسْدَاسٍ فِی قَضَائِ عَبْدِ اللہِ ، وَقَضَی فِیہَا زَیْدٌ : أَنَّ لأُخْتِہَا مِنْ أُمِّہَا السُّدُسَ ، وَلأُمِّہَا الثُّلُثَ ، وَیَجْعَلُ سَائِرَہُ فِی بَیْتِ الْمَالِ ، وَقَضَی فِیہَا عَلَیَّ : أَنَّ لَہُمَا الْمَالَ عَلَی قَدْرِ مَا وَرِثَا ، فَجَعَلَ لِلأُخْتِ مِنَ الأُمِّ الثُّلُثَ وَلِلأُمِّ الثُّلُثَیْنِ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ مِنْ ثَلاَثَۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَبْدِ اللہِ وَزَیْدٍ مِنْ سِتَّۃٍ۔","","Musannaf Ibn Abi Shaybah 31843","","","كتاب الفرائض"
"31844","(۳۱۸۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ فِی امْرَأَۃٍ تَرَکَتْ أُخْتَہَا لأَبِیہَا وَأُمَّہَا وَأُخْتَہَا مِنْ أَبِیہَا ، وَلاَ عَصَبَۃَ لَہَا غَیْرُہُمَا : فَلأُخْتِہَا لأَبِیہَا وَأُمِّہَا ثَلاَثَۃُ أَرْبَاعٍ ، وَلأُخْتِہَا مِنْ أَبِیہَا الرُّبْعُ فِی قَضَائِ عَلِی ، وَقَضَی عَبْدُ اللہِ : أَنَّ لِلأُخْتِ مِنَ الأَبِ وَالأُمِّ خَمْسَۃَ أَسْہُمٍ ، وَلِلأُخْتِ مِنَ الأَبِ السُّدُسُ ، وَقَضَی فِیہَا زَیْدٌ : أَنَّ لِلأُخْتِ لِلأَبِ وَالأُمِّ ثَلاَثَۃَ أَسْہُمٍ وَلِلأُخْتِ لِلأَبِ السُّدُسَ ، وَمَا بَقِیَ لِبَیْتِ الْمَالِ إذَا لَمْ یَکُنْ وَلاَئٌ وَلاَ عَصَبَۃٌ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ مِنْ ثَلاَثَۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَبْدِ اللہِ وَزَیْدٍ مِنْ سِتَّۃِ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31844","","","كتاب الفرائض"
"31845","(۳۱۸۴۵) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ فِی امْرَأَۃٍ تَرَکَتِ ابْنَتَہَا وَابْنَۃَ ابْنِہَا وَأُمَّہَا، وَلاَ عَصَبَۃَ لَہَا : فَلاِبْنَتِہَا ثَلاَثَۃُ أَخْمَاسٍ ، وَلاِبْنَۃِ ابْنِہَا خُمُسٌ ، وَلأُمِّہَا خُمُسٌ فِی قَضَائِ عَلِی ، وَقَضَی فِیہَا عَبْدُ اللہِ : أَنَّہَا مِنْ أَرْبَعَۃٍ وَعِشْرِینَ سَہْمًا : فَلاِبْنَۃِ الاِبْنِ مِنْ ذَلِکَ السُّدُسُ أَرْبَعَۃُ أَسْہُمٍ ، وَلِلأُمِّ رُبْعُ مَا بَقِیَ خَمْسَۃُ أَسْہُمٍ ، وَلِلاِبْنَۃِ ثَلاَثَۃُ أَرْبَاعِ عِشْرِینَ : خَمْسَۃَ عَشَرَ سَہْمًا ، وَقَضَی فِیہَا زَیْدٌ : لِلاِبْنَۃِ النِّصْفُ وَلاِبْنَۃِ الاِبْنِ السُّدُسُ وَلِلأُمِّ السُّدُسُ ، وَمَا بَقِیَ فَفِی بَیْتِ الْمَالِ إذَا لَمْ یَکُنْ وَلاَئٌ وَلاَ عَصَبَۃٌ۔","","Musannaf Ibn Abi Shaybah 31845","","","كتاب الفرائض"
"31846","(۳۱۸۴۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ بْنِ عَمْرو ، قَالَ : قَالَ إبْرَاہِیمُ : یَرِثُ مِنَ النِّسَائِ سِتُّ نِسْوَۃٍ : الاِبْنَۃُ، وَابْنَۃُ الاِبْنِ، وَالأُمُّ، وَالْجَدَّۃُ، وَالأُخْتُ، وَالْمَرْأَۃُ، وَیَرِثُ النِّسَائُ مِنَ الرِّجَالِ سَبْعَۃَ نَفَرٍ: تَرِثُ أَبَاہَا، وَابْنَہَا، وَابْنَ ابْنِہَا، وَأَخَاہَا، وَزَوْجَہَا، وَجَدَّہَا، وَتَرِثُ مِنَ ابْنِ ابْنَتِہَا سُدُسًا إلاَّ أَنْ یَکُونَ لَہُ عَصَبَۃٌ غَیْرُہَا۔","","Musannaf Ibn Abi Shaybah 31846","","","كتاب الفرائض"
"31847","(۳۱۸۴۷) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا مِنْدَلٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ: یَرِثُ الرَّجُلُ سِتُّ نِسْوَۃٍ: ابْنَتَہُ ، وَابْنَۃَ ابْنِہِ ، وَأُمَّہُ ، وَجَدَّتَہُ ، وَأُخْتَہ ، وَزَوْجَتَہُ ، وَتَرِثُ الْمَرْأَۃُ سَبْعَۃ نَفَرٍ : ابْنَہَا ، وَابْنَ ابْنِہَا ، وَأَبَاہَا ، وَجَدَّہَا ، وَزَوْجَہَا ، وَأَخَاہَا ، وَتَرِثُ مِنَ ابْنِ ابْنَتِہَا سُدُسًا ، وَلاَ یَرِثُ ہُوَ مِنْہَا شَیْئًا فِی قَوْلِہِمْ کُلِّہِمْ۔","","Musannaf Ibn Abi Shaybah 31847","","","كتاب الفرائض"
"31848","(۳۱۸۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ النُّعْمَانِ بْنِ سَالِمٍ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ ابْنِ ابْنَۃٍ : أَرَأَیْت رَجُلاً تَرَکَ ابْنِ ابْنَتہ ، أَیَرِثہُ ؟ قَالَ : لا۔","Sahih","Musannaf Ibn Abi Shaybah 31848","","","كتاب الفرائض"
"31849","(۳۱۸۴۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ مِنْدَلٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، قَالَ : فِی قَوْلِ عَلِیٍّ وَزَیْدٍ : ابْنُ الاِبْنِ یُرَدُّ عَلَی مَنْ تَحْتَہُ وَمَنْ فَوْقَہُ لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ ، وَفِی قَوْلِ عَبْدِ اللہِ : إذَا اسْتَکْمَلَ الثُّلُثَیْنِ فَلَیْسَ لِبَنَاتِ الاِبْنِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 31849","","","كتاب الفرائض"
"31850","(۳۱۸۵۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا مِنْدَلٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ فِی قَوْلِ عَبْدِ اللہِ : لِلاِبْنَۃِ النِّصْفُ ، وَمَا بَقِیَ لِبَنِی الاِبْنِ وَبَنَاتِ الاِبْنِ : لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ ، مَا لَمْ یَزِدْنَ بَنَاتُ الاِبْنِ عَلَی السُّدُسِ۔","","Musannaf Ibn Abi Shaybah 31850","","","كتاب الفرائض"
"31851","(۳۱۸۵۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا مِنْدَلٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یَرِثُ الإِخْوَۃُ مِنَ الأُمِّ مَعَ وَلَدٍ ، وَلاَ وَلَدَ ابْنٍ ذَکَرٍ وَلاَ أُنْثَی ، وَلاَ مَعَ أَبٍ ، وَلاَ مَعَ جَدٍّ۔","","Musannaf Ibn Abi Shaybah 31851","","","كتاب الفرائض"
"31852","(۳۱۸۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ رَجُلٍ لَمْ یُسَمِّہِ ، قَالَ : مَا رَأَیْت رَجُلاً کَانَ أَحْسَبُ مِنْ عَلِیٍّ سُئِلَ عَنِ ابْنَتَیْنِ وَأَبَوَیْنِ وَامْرَأَۃٍ ، فَقَالَ : صَارَ ثَمَنُہَا تُسُعًا۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ مِنْ سَبْعَۃٍ وَعِشْرِینَ سَہْمًا : لِلاِبْنَتَیْنِ سِتَّۃَ عَشَرَ ، وَلِلأَبَوَیْنِ ثَمَانِیَۃٌ وَلِلْمَرْأَۃِ ثَلاَثَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 31852","","","كتاب الفرائض"
"31853","(۳۱۸۵۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ خَالِدٍ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ : أَنَّ أَبَا بَکْرٍ کَانَ یَرَی الْجَدَّ أَبًا۔","Sahih","Musannaf Ibn Abi Shaybah 31853","","","كتاب الفرائض"
"31854","(۳۱۸۵۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ کُرْدُوسِ بْنِ عَبَّاسٍ الثَّعْلبِیِّ ، عَنْ أَبِی مُوسَی : أَنَّ أَبَا بَکْرٍ جَعَلَ الْجَدَّ أَبًا۔","Hasan","Musannaf Ibn Abi Shaybah 31854","","","كتاب الفرائض"
"31855","(۳۱۸۵۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : قَالَ ابْنُ الزُّبَیْرِ : إنَّ الَّذِی قَالَ فِیہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ کُنْت مُتَّخِذًا خَلِیلاً لاَتَّخَذْتہ خَلِیلاً جَعَلَ الْجَدَّ أَبًا۔ یَعْنِی : أَبَا بَکْرٍ۔n(بخاری ۳۶۵۸۔ احمد ۴)","Sahih","Musannaf Ibn Abi Shaybah 31855","","","كتاب الفرائض"
"31856","(۳۱۸۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ فُرَاتٍ الْقَزَّازِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : کَتَبَ ابْنُ الزُّبَیْرِ إلَی عَبْدِ اللہِ بْنِ عُتْبَۃَ : إنَّ أَبَا بَکْرٍ کَانَ یَجْعَلُ الْجَدَّ أَبًا۔ (احمد ۴۔ ابویعلی ۶۷۷۲)","Sahih","Musannaf Ibn Abi Shaybah 31856","","","كتاب الفرائض"
"31857","(۳۱۸۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ خَالِدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ مَعْقِلٍ ، قَالَ : کُنْتُ عِنْدَ ابْنِ عَبَّاسٍ فَسَأَلَہُ رَجُلٌ عَنِ الْجَدِّ ؟ فَقَالَ لَہُ ابْنُ عَبَّاسٍ : أَیُّ أَبٍ لَک أَکْبَرُ ؟ فَلَمْ یَدْرِ الرَّجُلُ مَا یَقُولُ ، فَقُلْتُ أَنَا : آدَم ، فَقَالَ ابْنُ عَبَّاسٍ : إنَّ اللَّہَ یَقُولُ : یَا بَنِی آدَمَ۔","Hasan","Musannaf Ibn Abi Shaybah 31857","","","كتاب الفرائض"
"31858","(۳۱۸۵۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنْ أَبِی بَکْرٍ وَابْنِ عَبَّاسٍ وَعُثْمَانَ : أَنَّہُمْ جَعَلُوا الْجَدَّ أَبًا۔","Da'if","Musannaf Ibn Abi Shaybah 31858","","","كتاب الفرائض"
"31859","(۳۱۸۵۹) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّہُ جَعَلَہُ أَبًا۔","Hasan","Musannaf Ibn Abi Shaybah 31859","","","كتاب الفرائض"
"31860","(۳۱۸۶۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنِ الزُّہْرِیِّ ، عَنْ قَبِیصَۃَ بْنِ ذُؤَیْبٍ : أَنَّ عُمَرَ کَانَ یَفْرِضُ لِلْجَدِّ الَّذِی یَفْرِضُ لَہُ النَّاسُ الْیَوْمَ ، قُلْتُ لَہُ : یَعْنِی : قَوْلَ زَیْدِ بْنِ ثَابِتٍ ؟ قَالَ : نَعَمْ۔","Sahih","Musannaf Ibn Abi Shaybah 31860","","","كتاب الفرائض"
"31861","(۳۱۸۶۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنْ عَطَائٍ ، عَنْ أَبِی بَکْرٍ ، قَالَ : الْجَدُّ بِمَنْزِلَۃِ الأَبِ مَا لَمْ یَکُنْ أَبٌ دُونَہُ ، وَابْنُ الاِبْنِ بِمَنْزِلِہِ الاِبْنِ مَا لَمْ یَکُنَ ابْنٌ دُونَہُ۔","","Musannaf Ibn Abi Shaybah 31861","","","كتاب الفرائض"
"31862","(۳۱۸۶۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ إسْمَاعِیلَ بْنِ سُمَیْعٍ ، قَالَ : قَالَ رَجُلٌ لأَبِی وَائِلٍ : إنَّ أَبَا بُرْدَۃَ یَزْعُمُ أَنَّ أَبَا بَکْرٍ جَعَلَ الْجَدَّ أَبًا ؟ فَقَالَ : کَذَبَ ، لَوْ جَعَلَہُ أَبًا لَمَا خَالَفَہُ عُمَرُ۔","","Musannaf Ibn Abi Shaybah 31862","","","كتاب الفرائض"
"31863","(۳۱۸۶۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا ہِمَّامٌ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ : أَنَّ رَجُلاً أَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّ ابْنَ ابْنِی مَاتَ فَمَا لِی مِنْ مِیرَاثِہِ ؟ قَالَ : لَکَ السُّدُسُ ، فَلَمَّا أَدْبَرَ دَعَاہُ ، قَالَ : لَک سُدُسٌ آخَرُ ، فَلَمَّا أَدْبَرَ دَعَاہُ ، قَالَ : إنَّ السُّدُسَ الآخَر طُعْمَۃٌ۔n(ابوداؤد ۲۸۸۸۔ احمد ۴۲۸)","Hasan","Musannaf Ibn Abi Shaybah 31863","","","كتاب الفرائض"
"31864","(۳۱۸۶۴) حَدَّثَنَا شَبَابَۃُ ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَنْ مَعْقِلِ بْنِ یَسَارٍ الْمُزَنِیّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُتِیَ بِفَرِیضَۃٍ فِیہَا جَدٌّ فَأَعْطَاہُ ثُلُثًا أَوْ سُدُسًا۔ (ابن ماجہ ۶۷۲۲۔ طبرانی ۵۳۶)","Hasan","Musannaf Ibn Abi Shaybah 31864","","","كتاب الفرائض"
"31865","(۳۱۸۶۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّ عُمَرَ ، قَالَ : مَنْ یَعْلَم قَضِیَّۃَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْجَدِّ ؟ فَقَالَ : مَعْقِلُ بْنُ یَسَارٍ الْمُزَنِیّ : فِینَا قَضَی بِہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَا ذَاک ؟ قَالَ : السُّدُسُ ، قَالَ : مَعَ مَنْ ؟ قَالَ لاَ أَدْرِی ، قَالَ : لاَ دَرَیْت ، فَمَا تُغْنِی إذًا۔","Hasan","Musannaf Ibn Abi Shaybah 31865","","","كتاب الفرائض"
"31866","(۳۱۸۶۶) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عِیَاضٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : کُنَّا نُوَرِّثُہُ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ یَعْنِی : الْجَدَّ۔ (ابویعلی ۱۰۹۰)","","Musannaf Ibn Abi Shaybah 31866","","","كتاب الفرائض"
"31867","(۳۱۸۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَلِیٌّ لاَ یَزِیدُ الْجَدَّ مَعَ الْوَلَدِ عَلَی السُّدُسِ۔","","Musannaf Ibn Abi Shaybah 31867","","","كتاب الفرائض"
"31868","(۳۱۸۶۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عُبَیْدِ بْنِ نُضَیْلَۃَ ، قَالَ : کَانَ عُمَرُ وَعَبْدُ اللہِ یُقَاسِمَانِ بِالْجَدِّ مَعَ الإِخْوَۃِ مَا بَیْنَہُ وَبَیْنَ أَنْ یَکُونَ السُّدُسُ خَیْرًا لَہُ مِنْ مُقَاسَمَتِہِمْ ، ثُمَّ إنَّ عُمَرَ کَتَبَ إلَی عَبْدِ اللہِ : مَا أَرَی إلاَّ أَنَّا قَدْ أَجْحَفْنَا بِالْجَدِّ ، فَإِذَا جَائَک کِتَابِی ہَذَا فَقَاسِمِ بِہِ مَعَ الإِخْوَۃِ مَا بَیْنَہُ وَبَیْنَ أَنْ یَکُونَ الثُّلُثُ خَیْرًا لَہُ مِنْ مُقَاسَمَتِہِمْ ، فَأَخَذَ بِہِ عَبْدُ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31868","","","كتاب الفرائض"
"31869","(۳۱۸۶۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : کَانَ عَبْدُ اللہِ یُشَرِّکُ الْجَدَّ مَعَ الإِخْوَۃِ ، فَإِذَا کَثُرُوا وَفَّاہ الثُّلُثَ ، فَلَمَّا تُوُفِّیَ عَلْقَمَۃُ أَتَیْتُ عَبِیدَۃَ ، فَحَدَّثَنِی أَنَّ ابْنَ مَسْعُودٍ کَانَ یُشَرِّکُ الْجَدَّ مَعَ الإِخْوَۃِ ، فَإِذَا کَثُرُوا وَفَّاہُ السُّدُسَ ، فَرَجَعْت مِنْ عِنْدِہِ وَأَنَا خَاثِرٌ۔n فَمَرَرْت بِعُبَیْدِ بْنِ نُضَیْلَۃَ فَقَالَ : مَا لِی أَرَاک خَاثِراً ؟ قَالَ : قُلْتُ : کَیْفَ لاَ أَکُونُ خَاثِرًا ، فَحَدَّثْتہ ، فَقَالَ : صَدَقَاک کِلاَہُمَا ، قُلْتُ : لِلَّہِ أَبُوک وَکَیْفَ صَدَقَانِی کِلاَہُمَا ، قَالَ : کَانَ رَأْیُ عَبْدِ اللہِ وَقِسْمَتُہُ أَنْ یُشَرِّکَہُ مَعَ الإِخْوَۃِ ، فَإِذَا کَثُرُوا وَفَّاہُ السُّدُسَ ، ثُمَّ وَفَدَ إلَی عُمَرَ فَوَجَدَہُ یُشَرِّکُہُ مَعَ الإِخْوَۃِ ، فَإِذَا کَثُرُوا وَفَّاہُ الثُّلُثَ ، فَتَرَکَ رَأْیَہُ وَتَابَعَ عُمَرَ۔","Hasan","Musannaf Ibn Abi Shaybah 31869","","","كتاب الفرائض"
"31870","(۳۱۸۷۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَنْ عَلِیٍّ : أَنَّہُ کَانَ یُقَاسِمُ بِالْجَدِّ الإِخْوَۃَ إلَی السُّدُسِ۔","Hasan","Musannaf Ibn Abi Shaybah 31870","","","كتاب الفرائض"
"31871","(۳۱۸۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ : أَنَّہُ أُتِیَ فِی سِتَّۃِ إخْوَۃٍ وَجَدٍّ ، فَأَعْطَی الْجَدَّ السُّدُسَ۔","Sahih","Musannaf Ibn Abi Shaybah 31871","","","كتاب الفرائض"
"31872","(۳۱۸۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَتَبَ ابْنُ عَبَّاسٍ إلَی عَلِیٍّ یَسْأَلُہُ عَنْ سِتَّۃِ إخْوَۃٍ وَجَدٍّ ؟ فَکَتَبَ إلَیْہِ : أَنِ اجْعَلْہُ کَأَحَدِہِمْ ، وَامْحُ کِتَابِی۔","Sahih","Musannaf Ibn Abi Shaybah 31872","","","كتاب الفرائض"
"31873","(۳۱۸۷۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ : أَنَّ زَیْدًا کَانَ یُقَاسِمُ بِالْجَدِّ مَعَ الإِخْوَۃِ مَا بَیْنَہُ وَبَیْنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31873","","","كتاب الفرائض"
"31874","(۳۱۸۷۴) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عُمَرَ وَعَبْدِ اللہِ : أَنَّہُمَا کَانَا یُقَاسِمَانِ الْجَدَّ مَعَ الإِخْوَۃِ مَا بَیْنَہُ وَبَیْنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31874","","","كتاب الفرائض"
"31875","(۳۱۸۷۵) حَدَّثَنَا حَفْصٌ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ: أَنَّ عَلِیًّا کَانَ یُقَاسِمُ الْجَدَّ مَعَ الإِخْوَۃِ مَا بَیْنَہُ وَبَیْنَ السُّدُسِ۔","","Musannaf Ibn Abi Shaybah 31875","","","كتاب الفرائض"
"31876","(۳۱۸۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَتَبَ عُمَرُ إلَی عَبْدِ اللہِ بْنِ مَسْعُودٍ : إنَّا قَدْ خَشِینَا أَنْ نَکُونَ قَدْ أَجْحَفْنَا بِالْجَدِّ ، فَأَعْطِہِ الثُّلُثَ مَعَ الإِخْوَۃِ۔","","Musannaf Ibn Abi Shaybah 31876","","","كتاب الفرائض"
"31877","(۳۱۸۷۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّ زَیْدًا کَانَ یَقُول : یُقَاسَمُ الْجَدَّ مَعَ الْوَاحِدِ وَالاِثْنَیْنِ، فَإِذَا کَانُوا ثَلاَثَۃً کَانَ لَہُ ثُلُثُ جَمِیعِ الْمَالِ ، فَإِنْ کَانَ مَعَہُ فَرَائِضُ نُظِرَ لَہُ ، فَإِنْ کَانَ الثُّلُثُ خَیْرًا لَہُ أُعْطِیَہُ ، وَإِنْ کَانَتِ الْمُقَاسَمَۃُ خَیْرًا لَہُ قَاسَمَ ، وَلاَ یُنْتَقَصُ مِنْ سُدُسِ جَمِیعِ الْمَالِ۔","Hasan","Musannaf Ibn Abi Shaybah 31877","","","كتاب الفرائض"
"31878","(۳۱۸۷۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ وَزَیْدٌ یَجْعَلاَنِ لِلْجَدِّ الثُّلُثَ وَلِلإِخْوَۃِ الثُّلُثَیْنِ ، وَفِی رَجُلٍ تَرَکَ أَرْبَعَۃَ إخْوَۃٍ لأَبِیہِ وَأُمِّہِ وَأُخْتَیْہِ لأَبِیہِ وَأُمِّہِ وَجَدِّہِ ، قَالَ : کَانَ عَلِیٌّ یَجْعَلُہَا أَسْہُمًا أَسْدَاسًا لِلْجَدِّ السُّدُسَ ، لَمْ یَکُنْ عَلِیٌّ یَجْعَلُ لِلْجَدِّ أَقَلَّ مِنَ السُّدُسِ مَعَ الإِخْوَۃِ ، وَمَا بَقِیَ فَلِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ ، وَکَانَ عَبْدُ اللہِ وَزَیْدٌ یُعْطِیَانِ الْجَدَّ الثُّلُثَ وَالإِخْوَۃَ الثُّلُثَیْنِ لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ ، وَقَالَ فِی خَمْسَۃِ إخْوَۃٍ وَجَدٍّ ، قَالَ : فَلِلْجَدِّ فِی قَوْلِ عَلِیٍّ السُّدُسُ ، وَلِلإِخْوَۃِ خَمْسَۃُ أَسْدَاسٍ ، وَکَانَ عَبْدُ اللہِ وَزَیْدٌ یُعْطِیَانِ الْجَدَّ الثُّلُثَ ، وَالإِخْوَۃَ الثُّلُثَیْنِ۔","","Musannaf Ibn Abi Shaybah 31878","","","كتاب الفرائض"
"31879","(۳۱۸۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ مَسْرُوقٍ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ لاَ یَزِیدُ الْجَدَّ عَلَی السُّدُسِ مَعَ الإِخْوَۃِ ، قَالَ : فَقُلْتُ لَہُ : شَہِدْت عُمَرَ بْنَ الْخَطَّابِ أَعْطَاہُ الثُّلُثَ مَعَ الإِخْوَۃِ ، فَأَعْطَاہُ الثُّلُثَ۔","Da'if","Musannaf Ibn Abi Shaybah 31879","","","كتاب الفرائض"
"31880","(۳۱۸۸۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ ، قَالَ : إنَّ أَوَّلَ جَدٍّ ورِّثَ فِی الإسْلاَمِ : عُمَرُ بْنُ الْخَطَّابِ ، فَأَرَادَ أَنْ یَحْتَازَ الْمَالَ ، فَقُلْتُ لَہُ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إنَّہُمْ شَجَرَۃٌ دُونَک۔ یَعْنِی : بَنِی بَنِیہِ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عُمَرَ ، وَعَبْدِ اللہِ وَزَیْدٍ مِنْ ثَلاَثَۃِ أَسْہُمٍ ، فَلِلْجَدِّ الثُّلُثُ ، وَمَا بَقِیَ فَلِلإِخْوَۃِ ، وَفِی قَوْلِ عَلِیٍّ مِنْ سِتَّۃِ أَسْہُمٍ : لِلْجَدِّ السُّدُسُ سَہْمٌ ، وَلِلإِخْوَۃِ خَمْسَۃُ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31880","","","كتاب الفرائض"
"31881","(۳۱۸۸۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ : فِی أُخْتٍ وَجَدٍّ : النِّصْفُ ، وَالنِّصْفُ۔","","Musannaf Ibn Abi Shaybah 31881","","","كتاب الفرائض"
"31882","(۳۱۸۸۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ تَرَکَ جَدَّہُ وَأَخَاہُ لأَبِیہِ وَأُمِّہِ : فَلِلْجَدِّ النِّصْفُ وَلأَخِیہِ النِّصْفُ فِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ وَزَیْدٍ ، قَالُوا فِی رَجُلٍ تَرَکَ جَدَّہُ وَإِخْوَیہ لأَبِیہِ وَأُمِّہِ : فَلِلْجَدِّ الثُّلُثُ وَلِلإِخْوَۃِ الثُّلُثَانِ فِی قَوْلِہِمْ جَمِیعًا۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ مِنْ سَہْمَیْنِ إذَا کَانَتْ أُخْتٌ ، أَوْ أَخٌ وَجَدٌّ ، فَلِلْجَدِّ النِّصْفُ ، وَلِلأُخْتِ - أَو الأَخِ - النِّصْفُ ، وَإِنْ کَانَا أَخَوَیْنِ فَلِلْجَدِّ الثُّلُثُ ، وَلِلأَخَوَیْنِ الثُّلُثَانِ۔","","Musannaf Ibn Abi Shaybah 31882","","","كتاب الفرائض"
"31883","(۳۱۸۸۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ تَرَکَ جَدَّہُ ، وَابْنَ أَخِیہِ لأَبِیہِ وَأُمِّہِ : فَلِلْجَدِّ الْمَالُ فِی قَضَائِ عَلِیٍّ ، وَعَبْدِ اللہِ وَزَیْدٍ۔n فَہَذِہِ مِنْ سَہْمٍ وَاحِدٍ وَہُوَ الْمَالُ کُلُّہُ۔","","Musannaf Ibn Abi Shaybah 31883","","","كتاب الفرائض"
"31884","(۳۱۸۸۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ تَرَکَ جَدَّہُ وَأَخَاہُ لأَبِیہِ وَأُمِّہِ وَأَخَاہُ لأَبِیہِ : فَلِلْجَدِّ النِّصْفُ ، وَلأَخِیہِ لأَبِیہِ وَأُمِّہِ النِّصْفُ فِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ ، وَکَانَ زَیْدٌ یُعْطِی الْجَدَّ الثُّلُثَ، وَالأَخَ مِنَ الأَبِ وَالأُمِّ الثُّلُثَیْنِ ، قَاسَمَ بِالأَخِ مِنَ الأَبِ مَعَ الأَخِ مِنَ الأَبِ وَالأُمِّ ، وَلاَ یَرِثُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 31884","","","كتاب الفرائض"
"31885","(۳۱۸۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ یُقَاسِمُ بِالْجَدِّ الأُخْوَۃَ إلَی الثُّلُثِ ، وَیُعْطِی کُلَّ صَاحِبِ فَرِیضَۃٍ فَرِیضَتَہُ ، وَلاَ یُوَرِّثُ الأُخْوَۃَ مِنَ الأُمِّ مَعَ الْجَدِّ ، وَلاَ یُقَاسِمُ بِالأُخْوَۃِ لِلأَبِ الأُخْوَۃُ لِلأَبِ وَالأُمِّ مَعَ الْجَدِّ ، وَإِذَا کَانَتْ أُخْتٌ لأَبٍ وَأُمٌّ وَأُخْتٌ لأَبٍ وَجَدٌّ ، أَعْطَی الأُخْتَ مِنَ الأَبِ وَالأُمِّ النِّصْفَ ، وَالْجَدَّ النِّصْفَ۔n وَکَانَ عَلِیٌّ یُقَاسِمُ بِالْجَدِّ الأُخْوَۃَ إلَی السُّدُسِ ، وَیُعْطِی کُلَّ صَاحِبِ فَرِیضَۃٍ فَرِیضَتَہُ ، وَلاَ یُوَرِّثُ الأخْوَۃَ مِنَ الأُمِّ مَعَ الْجَدِّ ، وَلاَ یَزِیدُ الْجَدَّ مَعَ الْوَلَدِ عَلَی السُّدُسِ إلاَّ أَنْ لاَ یَکُونَ غَیْرَہُ ، فَإِذَا کَانَتْ أُخْتٌ لأَبٍ وَأَمٍّ ، وَأَخٌ وَأُخْتٌ لأَبٍ ، وَجَدٌّ ، أَعْطَی الأُخْتَ مِنَ الأَبِ وَالأُمِّ النِّصْفَ ، وَقَاسَمَ بِالأَخِ وَالأُخْتِ الْجَدَّn قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ مِنْ سَہْمَیْنِ ، وَفِی قَوْلِ زَیْدٍ مِنْ ثَلاَثَۃِ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31885","","","كتاب الفرائض"
"31886","(۳۱۸۸۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : أَرَادَ عُبَیْدُ اللہِ بْنُ زِیَادٍ أَنْ یُوَرِّثَ الأُخْتَ مِنَ الأُمِّ مَعَ الْجَدِّ ، وَقَالَ : إنَّ عُمَرَ قَدْ وَرَّثَ الأُخْتَ مَعَہُ ، فَقَالَ عَبْدُ اللہِ بْنُ عُتْبَۃَ : إنِّی لَسْتُ بِسَبَئِیٍّ وَلاَ حَرُورِی ، فَاقْتَفِرِ الأَثَرَ ، فَإِنَّک لَنْ تُخْطِئَ فِی الطَّرِیقِ مَا دُمْت عَلَی الأَثَرِ۔","Sahih","Musannaf Ibn Abi Shaybah 31886","","","كتاب الفرائض"
"31887","(۳۱۸۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَا وَرَّثَ أَحَدٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إخْوَۃً مِنْ أُمٍّ مَعَ جَدٍّ۔","Sahih","Musannaf Ibn Abi Shaybah 31887","","","كتاب الفرائض"
"31888","(۳۱۸۸۸) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ زَیْدٌ لاَ یُوَرِّثُ أَخًا لأُمٍّ ، وَلاَ أُخْتًا لأُمٍّ مَعَ جَدٍّ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 31888","","","كتاب الفرائض"
"31889","(۳۱۸۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَلِیٌّ وَعَبْدُ اللہِ لاَ یُوَرِّثَانِ الإِخْوَۃَ مِنَ الأُمِّ مَعَ الْجَدِّ شَیْئًا۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ مِنْ سَہْمٍ وَاحِدٍ لأَنَّ الْمَالَ کُلَّہُ لِلْجَدِّ۔","","Musannaf Ibn Abi Shaybah 31889","","","كتاب الفرائض"
"31890","(۳۱۸۹۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ یَجْعَلُ الأَکْدَرِیَّۃَ مِنْ ثَمَانِیَۃٍ : لِلزَّوْجِ ثَلاَثَۃٌ ، وَثَلاَثَۃٌ لِلأُخْتِ ، وَسَہْمٌ لِلأُمِ ، وَسَہْمٌ لِلْجَدِّ۔ قَالَ : وَکَانَ عَلِیٌّ یَجْعَلُہَا مِنْ تِسْعَۃٍ : ثَلاَثَۃٌ لِلزَّوْجِ ، وَثَلاَثَۃٌ لِلأُخْتِ ، وَسَہْمَانِ لِلأُمِّ ، وَسَہْمٌ لِلْجَدِّ۔ وَکَانَ زَیْدٌ یَجْعَلُہَا مِنْ تِسْعَۃٍ : ثَلاَثَۃٌ لِلزَّوْجِ ، وَثَلاَثَۃٌ لِلأُخْتِ ، وَسَہْمَانِ لِلأُمِّ ، وَسَہْمٌ لِلْجَدِّ ، ثُمَّ یَضْرِبُہَا فِی ثَلاَثَۃٍ فَتَصِیرُ سَبْعَۃً وَعِشْرِینَ ، فَیُعْطِی الزَّوْجَ تِسْعَۃً ، وَالأُمَّ سِتَّۃً ، وَیَبْقَی اثْنَا عَشَرَ ، فَیُعْطِی الْجَدَّ ثَمَانِیَۃً ، وَیُعْطِی الأُخْتَ أَرْبَعَۃً۔","","Musannaf Ibn Abi Shaybah 31890","","","كتاب الفرائض"
"31891","(۳۱۸۹۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ وَعَبْدِ اللہِ وَزَیْدٍ بِمِثْلِ حَدِیثِ أَبِی مُعَاوِیَۃَ ، وَزَادَ فِیہِ : وَبَلَغَنِی عَنِ ابْنِ عَبَّاسٍ أَنَّہُ کَانَ یَجْعَلُ الْجَدَّ وَالِدًا ، لاَ یَرِثُ الإِخْوَۃَ مَعَہُ شَیْئًا ، وَیَجْعَلُ لِلزَّوْجِ النِّصْفَ وَلِلْجَدِّ السُّدُسَ : سَہْمٌ ، وَلِلأُمِّ الثُّلُثُ : سَہْمَانِ۔","","Musannaf Ibn Abi Shaybah 31891","","","كتاب الفرائض"
"31892","(۳۱۸۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ وَعَبْدِ اللہِ وَزَیْدٍ ، مِثْلَ حَدِیثِ أَبِی مُعَاوِیَۃَ۔","","Musannaf Ibn Abi Shaybah 31892","","","كتاب الفرائض"
"31893","(۳۱۸۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، قَالَ : قُلْتُ لِلأَعْمَشِ : لِمَ سُمِّیَت الأَکْدَرِیَّۃَ ؟ قَالَ : طَرَحَہَا عَبْدُ الْمَلِکِ بْنُ مَرْوَانَ عَلَی رَجُلٍ یُقَالَ لَہُ : الأَکْدَرُ ، کَانَ یَنْظُرُ فِی الْفَرَائِضِ ، فَأَخْطَأَ فِیہَا ، فَسَمَّاہَا الأَکْدَرِیَّۃَ۔n قَالَ وَکِیعٌ : وَکُنَّا نَسْمَعُ قَبْلَ أَنْ یُفَسِّرَ سُفْیَانُ إنَّمَا سُمِّیَتِ الأَکْدَرِیَّۃَ ، لأَنَّ قَوْلَ زَیْدٍ تَکَدَّرَ فِیہَا ، لَمْ یُفَسِّر قَوْلَہُ۔","","Musannaf Ibn Abi Shaybah 31893","","","كتاب الفرائض"
"31894","(۳۱۸۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْوَاحِدِ ، عَنْ إسْمَاعِیلَ بْنِ رَجَائٍ ، عَنْ إبْرَاہِیمَ۔ وَعَنْ سُفْیَانَ ، عَمَّنْ سَمِعَ الشَّعْبِیَّ قَالَ فِی أُمٍّ ، وَأُخْتٍ لأَبٍ وَأَمٍّ ، وَجَدٍّ : إنَّ زَیْدَ بْنَ ثَابِتٍ قَالَ : مِنْ تِسْعَۃِ أَسْہُمٍ : لِلأُمِّ ثَلاَثَۃٌ ، وَلِلْجَدِّ أَرْبَعَۃٌ ، وَلِلأُخْتِ سَہْمَانِ۔ وَإِنَّ عَلِیًّا قَالَ : لِلأُخْتِ النِّصْفُ : ثَلاَثَۃٌ ، وَلِلأُمِّ الثُّلُثُ : سَہْمَانِ ، وَمَا بَقِیَ فَلِلْجَدِّ وَہُوَ سَہْمٌ۔ وَقَالَ ابْنُ مَسْعُودٍ : لِلأُخْتِ النِّصْفُ : ثَلاَثَۃٌ ، وَلِلأُمِّ السُّدُسُ : سَہْمٌ ، وَمَا بَقِیَ فَلِلْجَدِّ وَہُوَ سَہْمَانِ۔ وَقَالَ عُثْمَان : أَثْلاَثًا : ثُلُثٌ لِلأُمِ ، وَثُلُثٌ لِلأُخْتِ ، وَثُلُثٌ لِلْجَدِّ ، وَقَالَ ابْنُ عَبَّاسٍ : لِلأُمِّ الثُّلُثُ ، وَمَا بَقِیَ فَلِلْجَدِّ۔n قَالَ وَکِیعٌ : وَقَالَ الشَّعْبِیُّ : سَأَلَنِی الْحَجَّاجُ بْنُ یُوسُفَ عنہا ؟ فَأَخْبَرْتہ بِأَقَاوِیلِہِمْ فَأَعْجَبَہُ قَوْلُ عَلِیٍّ ، فَقَالَ: قَوْلُ مَنْ ہَذَا ؟ فَقُلْتُ : قَوْلُ أَبِی تُرَابٍ ، فَفَطِنَ الْحَجَّاجُ ، فَقَالَ : إنَّا لَمْ نَعِبْ عَلَی عَلِیٍّ قَضَائِہِ ، إنَّمَا عِبْنَا کَذَا وَکَذَا۔","","Musannaf Ibn Abi Shaybah 31894","","","كتاب الفرائض"
"31895","(۳۱۸۹۵) حَدَّثَنَا ابْنِ فُضَیْلٌ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ أُخْتَہَا لأَبِیہَا وَأُمِّہَا ، وَجَدَّہَا ، وَأُمَّہَا ، فَلأُخْتِہَا لأَبِیہَا وَأُمِّہَا النِّصْفُ ، وَلأُمِّہَا الثُّلُثُ ، وَلِلْجَدِّ السُّدُسُ فِی قَوْلِ عَلِی۔n وَکَانَ عَبْدُ اللہِ یَقُولُ : لِلأُمِّ السُّدُسُ ، وَلِلْجَدِّ الثُّلُثُ ، وَلِلأُخْتِ النِّصْفُ ، وَکَانَ عَبْدُ اللہِ یَقُولُ : لَمْ یَکُنِ اللَّہُ لِیَرَانِی أُفَضِّلُ أُمًّا عَلَی جَدٍّ فِی ہَذِہِ الْفَرِیضَۃِ وَلاَ فِی غَیْرِہَا مِنَ الْحُدُودِ۔n وَکَانَ زَیْدٌ یُعْطِی الأُمَّ الثُّلُثَ ، وَالأُخْتَ ثُلُثَ مَا بَقِیَ ، قَسَمَہَا زَیْدٌ عَلَی تِسْعَۃِ أَسْہُمٍ : لِلأُمِّ الثُّلُثُ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأُخْتِ ثُلُثُ مَا بَقِیَ سَہْمَانِ ، وَلِلْجَدِّ أَرْبَعَۃُ أَسْہُمٍ۔n وَکَانَ عُثْمَان یَجْعَلُہَا بَیْنَہُمْ أَثْلاَثًا : لِلأُمِّ الثُّلُثُ ، وَلِلأُخْتِ الثُّلُثُ ، وَلِلْجَدِّ الثُّلُثُ۔n وَکَانَ ابْنُ عَبَّاسٍ یَقُولُ : الْجَدُّ بِمَنْزِلَۃِ الأَبِ۔","","Musannaf Ibn Abi Shaybah 31895","","","كتاب الفرائض"
"31896","(۳۱۸۹۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : کَانَ عَبْدُ اللہِ یَقُولُ فِی أُخْتٍ وَأَمٍّ وَجَدٍّ : لِلأُخْتِ النِّصْفُ ، وَالنِّصْفُ الْبَاقِی بَیْنَ الْجَدِّ وَالأُمِّ۔","","Musannaf Ibn Abi Shaybah 31896","","","كتاب الفرائض"
"31897","(۳۱۸۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عُمَرَ : فِی أُخْتٍ وَأَمٍّ وَجَدٍّ ، قَالَ : لِلأُخْتِ النِّصْفُ ، وَلِلأُمِّ السُّدُسُ ، وَمَا بَقِیَ فَلِلْجَدِّ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ مِنْ سِتَّۃِ أَسْہُمٍ ، وَفِی قَوْلِ زَیْدِ بْنِ ثَابِتٍ مِنْ تِسْعَۃِ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31897","","","كتاب الفرائض"
"31898","(۳۱۸۹۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ : أَنَّہُ قَالَ فِی ابْنَۃٍ وَأُخْتٍ وَجَدٍّ : أَعْطَی الاِبْنَۃَ النِّصْفَ ، وَجَعَلَ مَا بَقِیَ بَیْنَ الْجَدِّ وَالأُخْتِ ، لَہُ نِصْفٌ ، وَلَہَا نِصْفٌ۔n وَسُئِلَ عَنِ ابْنَۃٍ ، وَأُخْتَیْنِ ، وَجَدٍّ ، فَأَعْطَی الْبِنْتَ النِّصْفَ ، وَجَعَلَ مَا بَقِیَ بَیْنَ الْجَدِّ وَالأُخْتَیْنِ ، لَہُ نِصْفٌ وَلَہُمَا نِصْفٌ۔n وَسُئِلَ عَنِ ابْنَۃٍ وَثَلاَثَۃِ أَخَوَاتٍ وَجَدٍّ ، فَأَعْطَی الْبِنْتَ النِّصْفَ ، وَجَعَلَ لِلْجَدِّ خُمُسَیْ مَا بَقِیَ وَأَعْطَی الأَخَوَاتِ خُمُسًا خُمُسًا۔","","Musannaf Ibn Abi Shaybah 31898","","","كتاب الفرائض"
"31899","(۳۱۸۹۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبِیدَۃَ : فِی ابْنَۃٍ وَأُخْتٍ وَجَدٍّ ، قَالَ : ہِیَ مِنْ أَرْبَعَۃٍ : سَہْمَانِ لِلْبِنْتِ ، وَسَہْمٌ لِلْجَدِّ ، وَسَہْمٌ لِلأُخْتِ ، قُلْتُ لَہُ : فَإِنْ کَانَتَا أُخْتَیْنِ ؟ قَالَ : جَعَلَہَا عَبِیدَۃُ مِنْ أَرْبَعَۃٍ : لِلْبِنْتِ سَہْمَانِ ، وَسَہْمٌ لِلْجَدِّ ، وَلِلأُخْتَیْنِ سَہْمٌ ، قُلْتُ لَہُ : فَإِنْ کُنَّ ثَلاَث أَخَوَاتٍ ؟ قَالَ : جَعَلَہَا مَسْرُوقٌ مِنْ عَشَرَۃٍ : لِلْبِنْتِ خَمْسَۃُ أَسْہُمٍ ، وَلِلْجَدِّ سَہْمَانِ ، وَلِکُلِّ وَاحِدَۃٍ مِنْہُنَّ سَہْمٌ سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 31899","","","كتاب الفرائض"
"31900","(۳۱۹۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن مَسْرُوقٍ : فِی بِنْتٍ وَثَلاَثِ أَخَوَاتٍ وَجَدٍّ ، قَالَ : مِنْ عَشَرَۃٍ : لِلْبِنْتِ النِّصْفُ خَمْسَۃُ أَسْہُمٍ ، وَلِلْجَدِّ سَہْمَانِ ، وَلِکُلِّ أُخْتٍ سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 31900","","","كتاب الفرائض"
"31901","(۳۱۹۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبِیدَۃَ : فِی ابْنَۃٍ وَأُخْتٍ وَجَدٍّ ، قَالَ: مِنْ أَرْبَعَۃٍ سہْمَانِ : لِلإِبْنِۃِ النِّصْفُ ، وَسَہْمٌ لِلْجَدِّ ، وَسَہْمٌ لِلأُخْتِ۔","","Musannaf Ibn Abi Shaybah 31901","","","كتاب الفرائض"
"31902","(۳۱۹۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن مَسْرُوقٍ : فِی ابْنَۃٍ وَأُخْتَیْنِ وَجَدٍّ ، قَالَ : مِنْ ثَمَانِیَۃِ أَسْہُمٍ : لِلْبِنْتِ النِّصْفُ أَرْبَعَۃٌ ، وَلِلْجَدِّ سَہْمَانِ ، وَلِکُلِّ أُخْتٍ سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 31902","","","كتاب الفرائض"
"31903","(۳۱۹۰۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ تَرَکَ ابْنَتَہُ وَأُخْتَہ لأَبِیہِ وَأُمِّہِ وَجَدًّا ، فَلاِبْنَتِہِ النِّصْفُ ، وَلِجَدِّہِ السُّدُسُ ، وَمَا بَقِیَ فَلأُخْتِہِ فِی قَوْلِ عَلِی ، لَمْ یَکُنْ یَزِیدُ الْجَدَّ مَعَ الْوَلَدِ عَلَی السُّدُسِ شَیْئًا ، وَفِی قَوْلِ عَبْدِ اللہِ لاِبْنَتِہِ النِّصْفُ ، وَمَا بَقِیَ فَبَیْنَ الأُخْتِ وَالْجَدِّ۔n فَإِنْ کَانَتَا أُخْتَانِ فَمَا بَقِیَ بَیْنَ الْجَدِّ وَالأُخْتَیْنِ فِی قَوْلِ عَبْدِ اللہِ وَزَیْدٍ ، وَفِی قَوْلِ عَلِیٍّ : لِلْجَدِّ السُّدُسُ ، وَللأُخْتَیْہِ مَا بَقِی ، وَإِنْ کُنَّ ثَلاَثَ أَخَوَاتٍ مَعَ الاِبْنَۃِ وَالْجَدِّ ، فَلِلاِبْنَۃِ النِّصْفُ وَلِلْجَدِّ خُمُسَا مَا بَقِی ، وَلِلأَخَوَاتِ ثَلاَثَۃُ أَخْمَاسٍ فِی قَوْلِ عَبْدِ اللہِ وَزَیْدٍ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ مِنْ سِتَّۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَبْدِ اللہِ وَزَیْدٍ مِنْ عَشَرَۃِ أَسْہُمٍ : خَمْسَۃٌ لِلْبِنْتِ وَسَہْمَانِ لِلْجَدِّ وَلِلأَخَوَاتِ سَہْمٌ ، سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 31903","","","كتاب الفرائض"
"31904","(۳۱۹۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، قَالَ : قُلْتُ لِلشَّعْبِیِّ : کَیْفَ قَوْلُ عَلِیٍّ فِی ابْنَۃٍ وَأُخْتٍ وَجَدٍّ ؟ قَالَ : مِنْ أَرْبَعَۃٍ ، قَالَ : قُلْتُ : إنَّمَا ہَذِہِ فِی قَوْلِ عَبْدِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31904","","","كتاب الفرائض"
"31905","(۳۱۹۰۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ فِی امْرَأَۃٍ تَرَکَتْ زَوْجَہَا وَأُمَّہَا وَأَخَاہَا لأَبِیہَا وَجَدِّہَا : لِلزَّوْجِ النِّصْفُ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأُمِّ الثُّلُثُ سَہْمَانِ ، وَلِلْجَدِّ سَہْمٌ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ ، وَفِی قَوْلِ عَبْدِ اللہِ : لِلزَّوْجِ النِّصْفُ ، وَلِلأُمِّ ثُلُثُ مَا بَقِیَ سَہْمٌ ، وَلِلْجَدِّ سَہْمٌ ، وَلِلأَخِ سَہْمٌ ، وَإِنْ کَانَا أَخَوَانِ أَوْ أَکْثَرَ مِنْ ذَلِکَ : فَلِلزَّوْجِ النِّصْفُ وَلِلأُمِّ سَہْمٌ ، وَلِلْجَدِّ سَہْمٌ ، وَبَقِیَ سَہْمٌ فَہُوَ لاِِخْوَتِہِ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ وَعَبْدِ اللہِ۔","","Musannaf Ibn Abi Shaybah 31905","","","كتاب الفرائض"
"31906","(۳۱۹۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ: أَتَیْنَا شُرَیْحًا فَسَأَلْنَاہُ عَنْ زَوْجٍ ، وَأَمٍّ ، وَأَخٍ، وَجَدٍّ ؟ فَقَالَ : لِلْبَعْلِ الشَّطْرُ ، وَلِلأُمِّ الثُّلُثُ ، ثُمَّ سَکَتَ ، ثُمَّ قَالَ الَّذِی عَلَی رَأْسِہِ : أَنَّہُ لاَ یَقُولُ فِی الْجَدِّ شَیْئًا ، قَالَ : فَأَتَیْنَا عَبِیدَۃَ فَقَسَمَہَا مِنْ سِتَّۃٍ فِی قَوْلِ عَبْدِ اللہِ ، فَأَعْطَی الزَّوْجَ ثَلاَثَۃً ، وَالأُمَّ سَہْمًا ، وَالْجَدَّ سَہْمًا ، وَالأَخَ سَہْمًا۔n فَہَذِہِ فِی قَوْلِہِمْ جَمِیعًا مِنْ سِتَّۃِ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31906","","","كتاب الفرائض"
"31907","(۳۱۹۰۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ أُخْتَہَا لأَبِیہَا وَأُمِّہَا وَجَدَّہَا ، فَلأُخْتِہَا لأَبِیہَا وَأُمِّہَا النِّصْفُ فِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ ، وَکَانَ زَیْدٌ یُعْطِی الأُخْتَ الثُّلُثَ وَالْجَدَّ الثُّلُثَیْنِ۔nقَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ مِنْ سَہْمَیْنِ ، وَفِی قَوْلِ زَیْدٍ : مِنْ ثَلاَثَۃِ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31907","","","كتاب الفرائض"
"31908","(۳۱۹۰۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ : فِی رَجُلٍ تَرَکَ جَدَّہُ ، وَأُخْتَہ لأَبِیہِ وَأُمِّہِ، وَأَخَاہُ لأَبِیہِ ، فَلِلْجَدِّ فِی قَضَائِ زَیْدٍ الْخُمُسَانِ مِنْ عَشَرَۃٍ ، أَرْبَعَۃُ أَسْہُمٍ ، وَلأُخْتِہِ مِنْ أَبِیہِ وَأُمِّہِ النِّصْفُ ، خَمْسَۃٌ ، وَلأَخِیہِ لأَبِیہِ سَہْمٌ ، یَرُدُّ الأَخُ مِنَ الأَبِ فِی قَضَائِ زَیْدٍ عَلَی الأُخْت مِنَ الأَبِ وَالأُمِّ کَانَ لَہَا ثَلاَثَۃُ أَخْمَاسِ الْمَالِ فَأُعْطِیَتَ النِّصْفُ مِنْ أَجْلِ أَنَّ ثَلاَثَۃَ أَخْمَاسٍ أَکْثَرُ مِنَ النِّصْفِ ، وَلَیْسَ لِلأُخْتِ الْوَاحِدۃ وَإِنْ قَاسَمَہَا أَکْثَرَ مِنَ النِّصْفِ۔n وَکَانَ ابْنُ مَسْعُودٍ یُعْطِی الأُخْتَ مِنَ الأَبِ وَالأُمِّ النِّصْفَ ، وَالْجَدَّ النِّصْفَ ، وَلاَ یَعْتَدُّ بِالأُخْوَۃِ مِنَ الأَبِ مَعَ الأخْوَۃِ مِنَ الأَبِ وَالأُمِ۔n وَکَانَ عَلِیٌّ یَجْعَلُ لِلأُخْتِ مِنَ الأَبِ وَالأُمِّ النِّصْفَ ، وَیَقْسِمُ النِّصْفَ الْبَاقِی بَیْنَ الأُخْوَۃِ وَالْجَدِّ ، الْجَدُّ کَأَحَدِہِمْ مَا لَمْ یَکُنْ نَصِیبُ الْجَدِّ أَقَلَّ مِنَ السُّدُسِ ، إِنْ کَانَ أَخٌ وَاحِدٌ فَالنِّصْفُ الَّذِی بَقِیَ بَیْنَہُمَا ، وَإِنْ کَانَا أَخَوَیْنِ فَالنِّصْفُ بَیْنَہُمَا ، وَإِنْ کَانُوا ثَلاَثَۃٌ ، فَلِلْجَدِّ السُّدُسِ ، وَمَا بَقِیَ فَلِلأُخْوَۃِ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ زَیْدٍ مِنْ عَشَرَۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَبْدِ اللہِ : مِنْ سَہْمَیْنِ ، وَکَانَ عَلِیٌّ یَجْعَلُہَا مِنْ سِتَّۃٍ إذَا کَثُرَ الأُخْوَۃُ۔","","Musannaf Ibn Abi Shaybah 31908","","","كتاب الفرائض"
"31909","(۳۱۹۰۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ : فِی امْرَأَۃٍ تَرَکَتْ أُمَّہَا ، وَأُخْتَہَا لأَبِیہَا وَأُمِّہَا ، وَأَخَاہَا لأَبِیہَا ، وَجَدَّہَا ، قَضَی فِیہَا زَیْدٌ : أَنَّ لِلأُمِّ السُّدُسَ ، وَلِلْجَدِّ خُمُسَا مَا بَقِی ، وَلِلأُخْتِ ثَلاَثَۃُ أَخْمَاسِ مَا بَقِی ، رَدَّ الأَخُ عَلَی أُخْتِہِ وَلَمْ یَرِثْ شَیْئًا ، وَقَضَی فِیہَا عَبْدُ اللہِ : أَنَّ لِلأُخْتِ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأُمِّ سَہْمٌ ، وَلِلْجَدِّ سَہْمٌ ، وَقَضَی فِیہَا عَلِیٌّ : أَنَّ لِلأُخْتِ مِنَ الأَبِ وَالأُمِّ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأُمِّ سَہْماً ، وَبَقِیَ سَہْمَانِ : لِلْجَدِّ سَہْمٌ ، وَلِلأَخِ سَہْمٌ۔n فَہَذِہِ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ مِنْ سِتَّۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَبْدِ اللہِ مِنْ خَمْسَۃٍ۔","","Musannaf Ibn Abi Shaybah 31909","","","كتاب الفرائض"
"31910","(۳۱۹۱۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ فِی امْرَأَۃٍ تَرَکَتْ زَوْجَہَا ، وَأُمَّہَا ، وَأَرْبَعَ أَخَوَاتٍ لَہَا مِنْ أَبِیہَا وَأُمَّہَا ، وَجَدَّہَا ، قضَی فِیہَا زَیْدٌ : أَنَّ لِلزَّوْجِ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأُمِّ سَہْماً ، وَلِلْجَدِّ سَہْمَاً، وَلِلأَخَوَاتِ سَہْمَاً ، وَقَضَی فِیہَا عَلِیٌّ وَعَبْدُ اللہِ عَلَی تِسْعَۃِ أَسْہُمٍ : لِلزَّوْجِ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأُمِّ سَہْمٌ، وَلِلْجَدِّ سَہْمٌ ، وَلِلأَخَوَاتِ أَرْبَعَۃُ أَسْہُمٍ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ زَیْدٍ مِنْ سِتَّۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ مِنْ تِسْعَۃِ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31910","","","كتاب الفرائض"
"31911","(۳۱۹۱۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ سَالِمٍ ، عَنِ الشَّعْبِیِّ : فِی أُخْتٍ لأَمٍّ وأَبٍ ْ وَأَخٍ وَأُخْتٍ لأَبٍ ، وَجَدٍّ ، فِی قَوْلِ عَلِیٍّ : لِلأُخْتِ مِنَ الأَبِ وَالأُمِّ النِّصْفُ ، وَمَا بَقِیَ فَبَیْنَ الْجَدِّ وَالأُخْتِ وَالأَخِ مِنَ الأَبِ عَلَی الأَخْمَاسِ : لِلْجَدِّ خُمُسَانِ ، وَلِلأُخْتِ خُمُسٌ۔ وَفِی قَوْلِ عَبْدِ اللہِ : لِلأُخْتِ مِنَ الأَبِ وَالأُمِّ النِّصْفُ ، وَلِلْجَدِّ مَا بَقِی ، وَلَیْسَ لِلأَخِ وَالأُخْتِ مِنَ الأَبِ شَیْئٌ۔ وَفِی قَوْلِ زَیْدٍ : مِنْ ثَمَانیَۃَ عَشَرَ سَہْمًا : لِلْجَدِّ الثُّلُثُ سِتَّۃٌ ، وَلِلأَخِ مِنَ الأَبِ سِتَّۃٌ ، وَلِلأُخْتِ مِنَ الأَبِ ثَلاَثَۃٌn وَلِلأُخْتِ مِنَ الأَبِ وَالأُمِّ ثَلاَثَۃٌ ، ثُمَّ تَرُدُّ الأُخْتُ وَالأَخُ مِنَ الأَبِ عَلَی الأُخْتِ مِنَ الأَبِ وَالأُمِّ سِتَّۃَ أَسْہُمٍ ، فَاسْتَکْمَلَتِ النِّصْفَ تِسْعَۃً ، وَبَقِیَ لَہُمَا ثَلاَثَۃُ أَسْہُمٍ : لِلأَخِ سَہْمَانِ وَلِلأُخْتِ سَہْمٌ۔n وَفِی أُخْتَینِ لأَبٍ وَأُم ، وَأَخٍ لأَبٍ ، وَجَدٍّ فِی قَوْلِ عَلِیٍّ : لِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ الثُّلُثَانِ ، وَمَا بَقِیَ فَبَیْنَ الْجَدِّ وَالأَخِ ، وَفِی قَوْلِ عَبْدِ اللہِ : لِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ الثُّلُثَانِ ، وَلِلْجَدِّ مَا بَقِی ، وَلَیْسَ لِلأَخِ مِنَ الأَبِ شَیْئٌ۔ وَفِی قَوْلِ زَیْدٍ : ہِیَ ثَلاَثَۃُ أَسْہُمٍ : لِلْجَدِّ سَہْمٌ ، وَلِلأَخِ سَہْمٌ وَلِلأُخْتَیْنِ سَہْمٌ ، ثُمَّ یَرُدُّ الأَخُ مِنَ الأَبِ عَلَی الأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ سَہْمَہُما ، فَتَسْتَکْمِلاَنِ الثُّلُثَیْنِ ، وَلَمْ یَبْقَ لَہُ شَیْئٌ۔n وَفِی أُخْتَیْنِ لأَبٍ وَأَمٍّ ، وَأُخْتٍ لأَبٍ ، وَجَدٍّ ، فِیn قَوْلِ عَلِیٍّ ، وَعَبْدِ اللہِ : لِلأُخْتَیْنِ لِلأَبِ وَالأُمِّ الثُّلُثَانِ ، وَمَا بَقِیَ لِلْجَدِّ ، وَلَیْسَ لِلأُخْتِ مِنَ الأَبِ شَیْئٌ وَفِی قَوْلِ زَیْدٍ : مِنْ خَمْسَۃِ أَسْہُمٍ : لِلْجَدِّ سَہْمَانِ ، وَلِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ سَہْمَانِ ، وَلِلأُخْتِ مِنَ الأَبِ سَہْمٌ ، ثُمَّ تَرُدُّ الأُخْتُ مِنَ الأَبِ عَلَی الأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ سَہْمَہُمَا ، وَلَمْ یَبْقَ لَہَا شَیْئٌ۔n وَفِی أُخْتَیْنِ لأَبٍ وَأَمٍّ ، وَأَخٍ وَأُخْتٍ لأَبٍ ، وَجَدٍّ فِی قَوْلِ عَلِیٍّ : لِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ الثُّلُثَانِ ، وَلِلْجَدِّ السُّدُسُ ، وَمَا بَقِیَ فَبَیْنَ الأُخْتِ وَالأَخِ مِنَ الأَبِ لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ ، وَفِی قَوْلِ عَبْدِ اللہِ : لِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ الثُّلُثَانِ ، وَلِلْجَدِّ مَا بَقِی ، وَلَیْسَ لِلأَخِ وَالأُخْتِ مِنَ الأَبِ شَیْئٌ وَفِی قَوْلِ زَیْدٍ : مِنْ خَمْسَۃَ عَشَرَ سَہْمًا : لِلْجَدِّ الثُّلُثُ خَمْسَۃُ أَسْہُمٍ ، وَلِلأَخِ مِنَ الأَبِ أَرْبَعَۃٌ ، وَلِلأُخْتِ مِنَ الأَبِ سَہْمَانِ وَلِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ أَرْبَعَۃُ أَسْہُمٍ ، ثُمَّ یَرُدُّ الأَخُ وَالأُخْتُ مِنَ الأَبِ عَلَی الأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ نَصِیبَہُمَا ، یَسْتَکْمِلاَنِ الثُّلُثَین وَلَمْ یَبْقَ لَہُمَا شَیْئٌ۔n وَفِی أُخْتَیْنِ لأَبٍ وَأَمٍّ ، وَأُخْتَیْنِ لأَبٍ ، وَجَدٍّ فِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ : لِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ الثُّلُثَانِ ، وَلِلْجَدِّ مَا بَقِی ، وَلَیْسَ لِلأُخْتَیْنِ مِنَ الأَبِ شَیْئٌ۔ وَفِی قَوْلِ زَیْدٍ : مِنْ سِتَّۃِ أَسْہُمٍ : لِلْجَدِّ سَہْمَانِ ، وَلِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ سَہْمَانِ ، وَلِلأُخْتَیْنِ مِنَ الأَبِ سَہْمَانِ ، ثُمَّ تَرُدُّ الأُخْتَانِ مِنَ الأَبِ عَلَی الأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ سَہْمَیْہِمَا ، فَیَسْتَکْمِلاَنِ الثُّلُثَیْنِ ، وَلَمْ یَبْقَ لَہُمَا شَیْئٌ۔n وَفِی أُخْتٍ لأَبٍ وَأَمٍّ ، وَثَلاَثِ أَخَوَاتٍ لأَبٍ ، وَجَدِّہِ : فِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ : لِلأُخْتِ مِنَ الأَبِ وَالأُمِّ النِّصْفُ ، وَلِلأَخَوَاتِ مِنْ الأَبِ السُّدُسُ تَکْمِلَۃَ الثُّلُثَیْنِ ، وَلِلْجَدِّ مَا بَقِی ، وَفِی قَوْلِ زَیْدٍ : ثَمَانیَۃَ عَشَرَ سَہْمًا : لِلْجَدِّ الثُّلُثُ سِتَّۃٌ ، وَلِلأُخْتِ مِنَ الأَبِ وَالأُمِّ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأَخَوَاتِ مِنَ الأَبِ تِسْعَۃُ أَسْہُمٍ ، ثُمَّ تَرُدُّ الأَخَوَاتُ مِنَ الأَبِ عَلَی الأُخْتِ مِنَ الأَبِ وَالأُمِّ سِتَّۃَ أَسْہُمٍ ، فَاسْتَکْمَلَتِ النِّصْفَ تِسْعَۃً ، وَبَقِیَ لَہُنَّ سَہْمٌ سَہْمٌ۔n وَفِی أُخْتَیْنِ لأَبٍ وَأَمٍّ ، وَأَخٍ ، وَأُخْتَیْنِ لأَبٍ ، وَجَدٍّ : فِی قَوْلِ عَلِیٍّ : لِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ الثُّلُثَانِ ، وَلِلْجَدِّ السُّدُسُ ، وَمَا بَقِیَ فَبَیْنَ الأَخِ وَالأُخْتَیْنِ مِنَ الأَبِ لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ ، وَفِی قَوْلِ عَبْدِ اللہِ : لِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ الثُّلُثَانِ ، وَلِلْجَدِّ مَا بَقِی ، وَلَیْسَ لِلأَخِ وَالأُخْتَیْنِ مِنَ الأَبِ شَیْئٌ۔n وَفِی أُمٍّ وَأُخْتٍ وَجَدٍّ فِی قَوْلِ عَلِیٍّ : لِلأُخْتِ النِّصْفُ ، وَلِلأُمِّ ثُلُث مَا بَقِی ، وَلِلْجَدِّ مَا بَقِیَ۔n وَفِی قَوْلِ زَیْدٍ : مِنْ تِسْعَۃِ أَسْہُمٍ : لِلأُمِّ الثُّلُثُ ثَلاَثَۃٌ ، وَلِلْجَدِّ أَرْبَعَۃٌ ، وَلِلأُخْتِ سَہْمَانِ ، جَعَلَہُ مَعَہُمَا بِمَنْزِلَۃِ الأَخِ ، وَفِی قَوْلِ عُثْمَانَ: لِلأُمِّ الثُّلُثُ ، وَلِلْجَدِّ الثُّلُثُ ، وَلِلأُخْتِ الثُّلُثُ ، وَفِی قَوْلِ ابْنِ عَبَّاسٍ: لِلأُمِّ الثُّلُثُ، وَلِلْجَدِّ مَا بَقِی ، لَیْسَ لِلأُخْتِ شَیْئٌ ، لَمْ یَکُنْ یُوَرِّثُ أَخًا وَأُخْتًا مَعَ جَدٍّ شَیْئًا۔","Da'if","Musannaf Ibn Abi Shaybah 31911","","","كتاب الفرائض"
"31912","(۳۱۹۱۲) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ زَیْدٌ یُشَرِّکُ الْجَدَّ إِلَی الثُّلُثِ مَعَ الإِخْوَۃِ وَالأَخَوَاتِ ، فَإِذَا بَلَغَ الثُّلُثَ أَعْطَاہُ الثُّلُثَ ، وَکَانَ لِلأُخْوَۃِ وَالأَخَوَاتِ مَا بَقِی ، وَلاَ للأَخٍ لأُمٍّ ، وَلاَ للأُخْتٍ لأُمٍّ مَعَ جَدٍّ شَیْئٌ ، وَیُقَاسِمُ الأُخْوَۃَ مِنَ الأَبِ الإِخْوَۃَ مِنَ الأَبِ وَالأُمِّ ، وَلاَ یُوَرِّثُہُمْ شَیْئًا ، فَإِذَا کَانَ أَخٌ لأَبٍ وَأَمٍّ وَجَدٍّ ، أَعْطَی الْجَدَّ النِّصْفَ ، وَإِذَا کَانَا أَخَوَیْنِ أَعْطَاہُ الثُّلُثَ ، فَإِنْ زَادُوا أَعْطَاہُ الثُّلُثَ ، وَکَانَ لِلإِخْوَۃِ مَا بَقِی وَإِذَا کَانَتْ أُخْتٌ وَجَدٌّ أَعْطَاہُ مَعَ الأُخْتِ الثُّلُثَیْنِ ، وَلِلأُخْتِ الثُّلُثَ ، وَإِذَا کَانَتَا أُخْتَیْنِ أَعْطَاہُمَا النِّصْفَ ، وَلَہُ النِّصْفَ مَا دَامَتِ الْمُقَاسَمَۃُ خَیْرًا لَہُ ، فَإِنْ لَحِقَتْ فَرَائِضُ امْرَأَۃٍ وَ أُمٍّ وَزَوْجٍ أَعْطَی أَہْلَ الْفَرَائِضِ فَرَائِضَہُمْ ، وَمَا بَقِیَ قَاسَمَ الإِخْوَۃُ وَالأَخَوَاتُ ، فَإِنْ کَانَ ثُلُثُ مَا بَقِیَ خَیْرًا لَہُ مِنَ الْمُقَاسَمَۃِ أَعْطَاہُ ثُلُثَ مَا بَقِی ، وَإِنْ کَانَتِ الْمُقَاسَمَۃُ خَیْرًا لَہُ أَعْطَاہُ الْمُقَاسَمَۃَ ، وَإِنْ کَانَ سُدُسُ جَمِیعِ الْمَالِ خَیْرًا لَہُ مِنَ الْمُقَاسَمَۃِ أَعْطَاہُ السُّدُسَ ، وَإِنْ کَانَتِ الْمُقَاسَمَۃُ خَیْرًا لَہُ مِنْ سُدُسِ جَمِیعِ الْمَالِ أَعْطَاہُ الْمُقَاسَمَۃَ۔","","Musannaf Ibn Abi Shaybah 31912","","","كتاب الفرائض"
"31913","(۳۱۹۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إِبْرَاہِیمَ ، عَن عُمَرَ وَعَبْدِ اللہِ : أَنَّہُمَا کَانَا لاَ یُفَضِّلاَنِ أُمًّا عَلَی جَدٍّ۔","","Musannaf Ibn Abi Shaybah 31913","","","كتاب الفرائض"
"31914","(۳۱۹۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَنْ عَبِیدَۃَ ، قَالَ : إنِّی لأُحِیلُ الْجَدَّ عَلَی مِئَتَیْ قَضِیَّۃٍ۔","","Musannaf Ibn Abi Shaybah 31914","","","كتاب الفرائض"
"31915","(۳۱۹۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ أَیُّوب ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبِیدَۃَ ، قَالَ : حَفِظْت عَن عُمَرَ مِئَۃَ قَضِیَّۃٍ فِی الْجَدِّ مُخْتَلِفَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31915","","","كتاب الفرائض"
"31916","(۳۱۹۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عُبَیْدِ بْنِ عَمْرٍو الْخَارِفِیِّ : أَنَّ رَجُلاً سَأَلَ عَلِیًّا عَنْ فَرِیضَۃٍ ؟ فَقَالَ : ہَاتِ إنْ لَمْ یَکُنْ فِیہَا جَدٌّ۔","Da'if","Musannaf Ibn Abi Shaybah 31916","","","كتاب الفرائض"
"31917","(۳۱۹۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنْ رَجُلٍ مِنْ مُرَادٍ ، قَالَ : سَمِعْتُ عَلِیًّا یَقُولُ : مَنْ أَحَبَّ أَنْ یَتَقَحَّمَ جَرَاثِیمَ جَہَنَّمَ فَلْیَقْضِ بَیْنَ الْجَدِّ وَالإِخْوَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 31917","","","كتاب الفرائض"
"31918","(۳۱۹۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : أَتَیْنَا شُرَیْحًا فَسَأَلْنَاہُ ؟ فَقَالَ الَّذِی عَلَی رَأْسِہِ : إنَّہُ لاَ یَقُولُ فِی الْجَدِّ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 31918","","","كتاب الفرائض"
"31919","(۳۱۹۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنِ الشَّعْبِیِّ ، قَالَ : خُذْ فِی أَمْرِ الْجَدِّ بِمَا اجْتَمَعَ عَلَیْہِ النَّاسُ۔ یَعْنِی : قَوْلَ زَیْدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31919","","","كتاب الفرائض"
"31920","(۳۱۹۲۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ : أَنَّ عُمَرَ کَتَبَ فِی أَمْرِ الْجَدِّ وَالْکَلاَلَۃِ فِی کَتِفٍ ، ثُمَّ طَفِقَ یَسْتَخِیرُ رَبَّہُ ، فَلَمَّا طُعِنْ دَعَا بِالْکَتِفِ فَمَحَاہَا ، ثُمَّ قَالَ : إنِّی کُنْت کَتَبْت کِتَابًا فِی الْجَدِّ وَالْکَلاَلَۃِ ، وَإِنِّی قَدْ رَأَیْت أَنْ أَرُدَّکُمْ عَلَی مَا کُنْتُمْ عَلَیْہِ ، فَلَمْ یَدْرُوا مَا کَانَ فِی الْکَتِفِ۔","Sahih","Musannaf Ibn Abi Shaybah 31920","","","كتاب الفرائض"
"31921","(۳۱۹۲۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ سَعِیدٍ ، قَالَ : حدَّثَنِی رَجُلٌ مِنْ مُرَادٍ ، عَنْ عَلِیٍّ ، قَالَ : مَنْ أَحَبَّ أَنْ یَتَقَحَّمَ فِی جَرَاثِیمِ جَہَنَّمَ فَلْیَقْضِ بَیْنَ الإِخْوَۃِ وَالْجَدِّ۔","Da'if","Musannaf Ibn Abi Shaybah 31921","","","كتاب الفرائض"
"31922","(۳۱۹۲۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ قَبِیصَۃَ ، قَالَ : جَائَتِ الْجَدَّۃُ بِالأُمِّ وَابْنِ الاِبْنِ بَعْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی أَبِی بَکْرٍ ، فَقَالَتْ : إنَّ ابْنَ ابْنِی وَابْنَ ابْنَتِی مَاتَ ، وَقَدْ أُخْبِرْتُ أَنَّ لِی حَقًّا ، فَقَالَ أَبُو بَکْرٍ : مَا أَجِدُ لَکِ فِی کِتَابِ اللہِ مِنْ حَقٍّ ، وَمَا سَمِعْت فِیکِ شَیْئًا مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَسَأَسْأَلُ النَّاسَ ، قَالَ : فَشَہِدَ الْمُغِیرَۃُ بْنُ شُعْبَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَعْطَاہَا السُّدُسَ ، فَقَالَ : مَنْ یَشْہَدُ مَعَک ؟ قَالَ : مُحَمَّدُ بْنُ مَسْلَمَۃَ ، فَشَہِدَ فَأَعْطَاہَا السُّدُسَ ، وَجَائَتِ الْجَدَّۃُ الَّتِی تُخَالِفُہَا إلَی عُمَرَ ، فَأَعْطَاہَا السُّدُسَ ، فَقَالَ : إذَا اجْتَمَعْتُمَا فَہُوَ بَیْنَکُمَا۔n زَادَ مَعْمَرٌ : وَأَیُّکُمَا انْفَرَدَتْ بِہِ فَہُوَ لَہَا۔ (ترمذی ۲۱۰۰)","","Musannaf Ibn Abi Shaybah 31922","","","كتاب الفرائض"
"31923","(۳۱۹۲۳) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَعْطَی الْجَدَّۃَ السُّدُسَ۔ (ابن ماجہ ۲۷۲۵۔ سعید بن منصور ۸۳)","Da'if","Musannaf Ibn Abi Shaybah 31923","","","كتاب الفرائض"
"31924","(۳۱۹۲۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَبِی الْمُنِیبِ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ ، قَالَ : حدَّثَنِی ابْنُ بُرَیْدَۃَ ، عَنْ أَبِیہِ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَطْعَمَ الْجَدَّۃَ السُّدُسَ إذَا لَمْ یَکُنْ ابنٌ۔ (ابوداؤد ۲۸۸۷۔ دارقطنی ۷۴)","Da'if","Musannaf Ibn Abi Shaybah 31924","","","كتاب الفرائض"
"31925","(۳۱۹۲۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : أَخْبَرَنَا ابْنُ عُمَیْرٍ ، عَنْ أَیُّوبَ ، عَنْ رَجُلٍ ، عَنْ طَاوُوسٍ ، قَالَ : الْجَدَّۃُ بِمَنْزِلَۃِ الأُمِ ، تَرِثُ مَا تَرِثُ الأُمُّ۔","","Musannaf Ibn Abi Shaybah 31925","","","كتاب الفرائض"
"31926","(۳۱۹۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَطْعَمَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَلاَثَ جَدَّاتٍ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : مَنْ ؟ قَالَ : جَدَّتَا أَبِیہِ : أُمّ أُمّہِ ، وَأُمّ أَبِیہِ ،وَجَدَّتِہِ أُمّ أُمّہِ۔n(ابوداؤد ۳۵۵۔ دارمی ۲۹۳۵)","","Musannaf Ibn Abi Shaybah 31926","","","كتاب الفرائض"
"31927","(۳۱۹۲۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : یَرِثُ مِنَ الْجَدَّاتِ ثَلاَثَۃٌ ، وَأَقْعَدُ الْجَدَّاتِ فِی النَّسَبِ أَحَقُّہُنَّ بِالسُّدُسِ۔","","Musannaf Ibn Abi Shaybah 31927","","","كتاب الفرائض"
"31928","(۳۱۹۲۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ عَامِرٍ ، قَالَ : إذَا اجْتَمَعَ أَرْبَعُ جَدَّاتٍ لَمْ تَرِثَ أُمُّ أَبِی الأُمِّ۔","","Musannaf Ibn Abi Shaybah 31928","","","كتاب الفرائض"
"31929","(۳۱۹۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : یَرِثُ ثَلاَثُ جَدَّاتٍ : جَدَّتَانِ مِنْ قِبَلِ الأُمِّ ، وَجَدَّۃَّ مِنْ قِبَلِ الأَبِ۔","","Musannaf Ibn Abi Shaybah 31929","","","كتاب الفرائض"
"31930","(۳۱۹۳۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ لَیْثٍ ، عَنْ طَاووسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : تَرِثُ الْجَدَّاتُ الأَرْبَعُ جَمِیعًا۔","Da'if","Musannaf Ibn Abi Shaybah 31930","","","كتاب الفرائض"
"31931","(۳۱۹۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَہْمٍ الْفَرَائِِضِیِّ ، قَالَ : کَانَ جَابِرُ بْنُ زَیْدٍ یُوَرِّثُ أَرْبَعَ جَدَّاتٍ۔","","Musannaf Ibn Abi Shaybah 31931","","","كتاب الفرائض"
"31932","(۳۱۹۳۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : سُئِلَ عَنْ أَرْبَعِ جَدَّاتٍ ؟ فَقَالَ : یَرِثُ مِنْہُنَّ ثَلاَثٌ ، وَتُلْغی أُمَّ أَبِی الأُمِّ۔","","Musannaf Ibn Abi Shaybah 31932","","","كتاب الفرائض"
"31933","(۳۱۹۳۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ : أَنَّہُ کَانَ یُوَرِّثُ تِسْعَ جَدَّاتٍ وَیَقُولُ : إذَا کَانَتْ إحْدَی الْجَدَّاتِ أَقْرَبَ فَہُوَ لَہَا دُونَہُنَّ۔","","Musannaf Ibn Abi Shaybah 31933","","","كتاب الفرائض"
"31934","(۳۱۹۳۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یُوَرِّثُ ثَلاَثَ جَدَّاتٍ وَیَقُولُ : أَیَّتُہُنَّ کَانَتْ أَقْرَبَ فَہُوَ لَہَا دُونَ الأُخْرَی ، فَإِذَا اسْتَوَتَا فَہُوَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 31934","","","كتاب الفرائض"
"31935","(۳۱۹۳۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، قَالَ : قَالَ إبْرَاہِیمُ : جَعَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَ جَدَّۃٍ مِنْ قِبَلِ أُمِّہِ ، وَجَدَّتَیْنِ مِنْ قِبَلِ أَبِیہِ السُّدُسَ ، قَالَ زَائِدَۃُ : قُلْتُ لِمَنْصُورٍ : الَّتِی مِنْ قِبَلِ أَبِیہِ: أُمُّ أَبِیہِ ، وَأُمّ أُمِّہِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 31935","","","كتاب الفرائض"
"31936","(۳۱۹۳۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، قَالَ : قَالَ إبْرَاہِیمُ : إذَا کَانَتِ الْجَدَّاتُ مِنْ نَحْوٍ وَاحِدٍ ، بَعْضُہُنَّ أَقْرَبُ سَقَطَتِ الْقُصْوَی۔","","Musannaf Ibn Abi Shaybah 31936","","","كتاب الفرائض"
"31937","(۳۱۹۳۷) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ بَسَّامٍ، عَنْ فُضَیْلٍ، قَالَ: قَالَ إبْرَاہِیمُ: تَرِثُ الْجَدَّاتُ السُّدُسَ، فَإِنْ کَانَتْ وَاحِدَۃً أَو اثْنَتَیْنِ أَوْ ثَلاَثًا فَبَیْنَہُنَّ سَہْمٌ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ ، وَإذَا اجْتَمَعْن ثَلاَثُ جَدَّاتٍ ہُنَّ إلَی الْمَیِّتِ شرعٌ سَوَائٌ قَالَ: بَیْنَہُنَّ سَہْمٌ تَکُونُ جَدَّۃُ الأُمِّ ، وَجَدَّۃٌ بَنِی الأَبِ : أُمَّ أَبِیہِ ، وَأَمَّ أُمِّہِ ، وَفِی قَوْلِ عَبْدِ اللہِ : إذَا اجْتَمَعْن ثَلاَثُ جَدَّاتٍ کَانَ بَیْنَہُنَّ السُّدُسُ ، وَإِنْ کَانَ بَعْضُہُنَّ أَقْرَبَ نَسَبًا لَمْ یَکُنْ بَعْضُہُنَّ أُمَّہَاتِ بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 31937","","","كتاب الفرائض"
"31938","(۳۱۹۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، قَالَ : جِئْنَ أَرْبَعُ جَدَّاتٍ یَتَسَاوَقْنَ إلَی مَسْرُوقٍ فَوَرَّثَ ثَلاَثًا ، وَطَرَحَ أُمَّ أَبِی الأُمِّ۔","","Musannaf Ibn Abi Shaybah 31938","","","كتاب الفرائض"
"31939","(۳۱۹۳۹) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَلَّبِ : أَنَّ جَدَّتَیْنِ أَتَتَا شُرَیْحًا ، فَجَعَلَ السُّدُسَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 31939","","","كتاب الفرائض"
"31940","(۳۱۹۴۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ عَبْدُ اللہِ یُوَرِّثُ الْجَدَّاتِ وَإِنْ کُنَّ عَشْرًا ، وَیَقُولُ : إنَّمَا ہُوَ سَہْمٌ أَطْعَمَہُ إیَّاہُنَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (عبدالرزاق ۱۹۰۹۳)","","Musannaf Ibn Abi Shaybah 31940","","","كتاب الفرائض"
"31941","(۳۱۹۴۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَشْعَثِ ، عَنِ الشَّعْبِیِّ ، قَالَ : جَائَتْ أَرْبَعُ جَدَّاتٍ یَتَسَاوَقْنَ إلَی مَسْرُوقٍ ، فَوَرَّثَ ثَلاَثًا ، وَطَرَحَ وَاحِدَۃً : أُمَّ أَبِی الأُمِّ۔","","Musannaf Ibn Abi Shaybah 31941","","","كتاب الفرائض"
"31942","(۳۱۹۴۲) حَدَّثَنَا یَعْلَی ، عَنْ یَحْیَی ، عَنِ الْقَاسِمِ ، قَالَ : تُوُفِّیَ رَجُلٌ وَتَرَکَ جَدَّتَیْہِ : أُمَّ أُمِّہِ ، وَأَمَّ أَبِیہِ ، فَوَرَّثَ أَبُو بَکْرٍ أُمَّ أُمِّہِ ، وَتَرَکَ الأُخْرَی ، فَقَالَ رَجُلٌ مِنَ الأَنْصَارِ : لَقَدْ تَرَکْت امْرَأَۃً لَوْ أَنَّ الْجَدَّتَیْنِ مَاتَتَا وَابْنُہُمَا حَیٌّ مَا وَرِثَ مِنَ الَّتِی وَرَّثْتہَا مِنْہُ شَیْئًا ، وَوَرِثَ الَّتِی تَرَکَتَ : أَمَّ أَبِیہِ ! فَوَرَّثَہَا أَبُو بَکْرٍ ، فَشَرَّکَ بَیْنَہُمَا فِی السُّدُسِ۔ (سعید بن منصور ۸۲)","","Musannaf Ibn Abi Shaybah 31942","","","كتاب الفرائض"
"31943","(۳۱۹۴۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی الزِّنَادِ : سَمِعْت خَارِجَۃَ بْنَ زَیْدٍ وَسُلَیْمَانَ بْنَ یَسَارٍ وَطَلْحَۃَ بْنَ عَبْدِ اللہِ بْنِ عَوْفٍ یَقُولُونَ : إذَا کَانَتِ الْجَدَّۃُ الَّتِی مِنْ قِبَلِ الأُمِّ أَقْرَبَ فَہِیَ أَحَقُّ بِہِ۔","","Musannaf Ibn Abi Shaybah 31943","","","كتاب الفرائض"
"31944","(۳۱۹۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا بَشِیرٌ ، عَنْ عَبْدِ اللہِ بْنِ ذَکْوَانَ ، عَنْ خَارِجَۃَ بْنِ زَیْدٍ ، قَالَ : إذَا کَانَتِ الْجَدَّۃُ مِنْ قِبَلِ الأُمِّ أَقْعَدَ مِنَ الْجَدَّۃِ الَّتِی مِنْ قِبَلِ الأَبِ کَانَ السُّدُسُ لَہَا ، وَإِذَا کَانَتِ الْجَدَّۃُ مِنْ قِبَلِ الأَبِ أَقْعَدَ مِنَ الْجَدَّۃِ مِنْ قِبَلِ الأُمِّ کَانَ بَیْنَہُمَا السُّدُسُ۔","","Musannaf Ibn Abi Shaybah 31944","","","كتاب الفرائض"
"31945","(۳۱۹۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا فِطْرٌ ، عَنْ شَیْخٍ مِنْ أَہْلِ الْمَدِینَۃِ ، عَنْ خَارِجَۃَ بْنِ زَیْدٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : إذَا کَانَتِ الْجَدَّۃُ مِنْ قِبَلِ الأُمِّ ہِیَ أَقْعَدَ مِنَ الْجَدَّۃِ مِنْ قِبَلِ الأَبِ کَانَ لَہَا السُّدُسُ ، وَإِذَا کَانَتِ الْجَدَّۃُ مِنْ قِبَلِ الأَبِ أَقْعَدُ مِنَ الْجَدَّۃِ مِنْ قِبَلِ الأُمِّ کَانَ السُّدُسُ بَیْنَہُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 31945","","","كتاب الفرائض"
"31946","(۳۱۹۴۶) حَدَّثَنَا حَفْصٌ بْنِ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ وَزَیْدٍ ، قَالاَ فِی الْجَدَّاتِ : السَّہْمُ لِذَوِی الْقُرْبَی مِنْہُنَّ۔","Da'if","Musannaf Ibn Abi Shaybah 31946","","","كتاب الفرائض"
"31947","(۳۱۹۴۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ مُحَمَّدٍ ، قَالَ : الْجَدَّتَانِ : أَیُّہُمَا أَقْرَبُ فَلَہَا الْمِیرَاثُ۔","","Musannaf Ibn Abi Shaybah 31947","","","كتاب الفرائض"
"31948","(۳۱۹۴۸) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ عَمَّارٍ مَوْلَی بَنِی ہَاشِمٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ : فِی الْجَدَّاتِ إذَا کَانَتِ الْجَدَّۃُ أَقْرَبَ فَہِیَ أَحَقُّ۔","Sahih","Musannaf Ibn Abi Shaybah 31948","","","كتاب الفرائض"
"31949","(۳۱۹۴۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ سُلَیْمَان الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : لاَ تَحْجُبُ الْجَدَّاتِ إلاَّ الأُمُّ۔","Sahih","Musannaf Ibn Abi Shaybah 31949","","","كتاب الفرائض"
"31950","(۳۱۹۵۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ : سَمِعَ سَعِیدُ بْنُ الْمُسَیَّبِ : أَنَّ عُمَرَ وَرَّثَ جَدَّۃَ رَجُلٍ مِنْ ثَقِیفٍ مَعَ ابْنِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 31950","","","كتاب الفرائض"
"31951","(۳۱۹۵۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، قَالَ : کَانَ عَبْدُ اللہِ یُوَرِّثُ الْجَدَّۃَ مَعَ ابْنِہَا وَابْنُہَا حَیٌّ۔","Sahih","Musannaf Ibn Abi Shaybah 31951","","","كتاب الفرائض"
"31952","(۳۱۹۵۲) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَنْ أَبِی الدَّہْمَائِ ، قَالَ : قَالَ عِمْرَانُ بْنُ حُصَیْنٍ : تَرِثُ الْجَدَّۃُ وَابْنُہَا حَیٌّ۔","Sahih","Musannaf Ibn Abi Shaybah 31952","","","كتاب الفرائض"
"31953","(۳۱۹۵۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَطْعَمَ جَدَّۃً مِنَ ابْنِہَا السُّدُسَ ، فَکَانَتْ أَوَّلَ جَدَّۃٍ وَرِثَتْ فِی الإسْلاَمِ۔ (عبدالرزاق ۱۹۰۹۳)q","Da'if","Musannaf Ibn Abi Shaybah 31953","","","كتاب الفرائض"
"31954","(۳۱۹۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ الْحِمْیَرِیِّ ، عَنْ أَبِیہِ ، قَالَ : مَاتَ ابْنٌ لِحَسَکَۃَ الْحَنْظَلِیُّ وَتَرَکَ حَسْکَۃَ وَأَمَّ حَسْکَۃَ ، فَکَتَبَ فِیہَا أَبُو مُوسَی إلَی عُمَرَ بْنِ الْخَطَّابِ ، فَکَتَبَ إلَیْہِ عُمَرُ : أَنْ وَرِّثْہَا مَعَ ابْنِہَا السُّدُسَ۔","","Musannaf Ibn Abi Shaybah 31954","","","كتاب الفرائض"
"31955","(۳۱۹۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ وَہَمَّامٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، عَنْ شُرَیْحٍ : أَنَّہُ وَرَّثَ جَدَّۃً مَعَ ابْنِہَا۔n(عبدالرزاق ۱۹۰۹۵)","","Musannaf Ibn Abi Shaybah 31955","","","كتاب الفرائض"
"31956","(۳۱۹۵۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یُوَرِّثُ الْجَدَّۃَ وَابْنُہَا حَیٌّ۔","","Musannaf Ibn Abi Shaybah 31956","","","كتاب الفرائض"
"31957","(۳۱۹۵۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ : أَنَّہُ کَانَ یُوَرِّثُ الْجَدَّۃَ مَعَ ابْنِہَا ، وَابْنُہَا حَیٌّ۔","","Musannaf Ibn Abi Shaybah 31957","","","كتاب الفرائض"
"31958","(۳۱۹۵۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، أَنَّہُ قَالَ : أَوَّلُ جَدَّۃٍ أُطْعِمَتِ السُّدُسُ فِی الإسْلاَمِ جَدَّۃٌ أُطْعِمَتْہُ وَابْنُہَا حَیٌّ۔","","Musannaf Ibn Abi Shaybah 31958","","","كتاب الفرائض"
"31959","(۳۱۹۵۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، عَنْ شُرَیْحٍ : أَنَّہُ وَرَّثَ جَدَّتَیْنِ : أُمَّ أُمٍّ ، وَأُمَّ أَبٍ ، وَابْنَہُمَا حَیٌّ۔","","Musannaf Ibn Abi Shaybah 31959","","","كتاب الفرائض"
"31960","(۳۱۹۶۰) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِاللہِ الزُّبَیْرِیُّ، عَنْ سُفْیَانَ، عَنْ ہِشَامٍ، عَنْ أَبِیہِ: أَنَّہُ کَانَ یُوَرِّثُ الْجَدَّۃَ وَابْنُہَا حَیٌّ۔","","Musannaf Ibn Abi Shaybah 31960","","","كتاب الفرائض"
"31961","(۳۱۹۶۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : مَنَعَہَا ابْنُہَا الْمِیرَاثَ۔","Sahih","Musannaf Ibn Abi Shaybah 31961","","","كتاب الفرائض"
"31962","(۳۱۹۶۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ : أَنَّ عُثْمَانَ کَانَ لاَ یُوَرِّثُ الْجَدَّۃَ أُمَّ الأَبِ وَابْنُہَا حَیٌّ ، قَالَ الزُّہْرِیُّ : وَتُوُفِّیَ ابْنُ الزُّبَیْرِ فَلَمْ یُوَرِّثْ۔","","Musannaf Ibn Abi Shaybah 31962","","","كتاب الفرائض"
"31963","(۳۱۹۶۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ : لاَ تَرِثُ الْجَدَّۃُ مَعَ ابْنِہَا إذَا کَانَ حَیًّا ، فِی قَوْلِ عَلِیٍّ وَزَیْدٍ۔n قَالَ أَبُو بَکْرٍ : سَمِعْت وَکِیعًا یَقُولُ : النَّاسُ عَلَی ہَذَا۔","","Musannaf Ibn Abi Shaybah 31963","","","كتاب الفرائض"
"31964","(۳۱۹۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لَمْ یُوَرِّثْ أَحَدٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْجَدَّۃَ مَعَ ابْنِہَا إلاَّ ابْنُ مَسْعُودٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31964","","","كتاب الفرائض"
"31965","(۳۱۹۶۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّ زَیْدًا لَمْ یَکُن یَجْعَلْ لِلْجَدَّۃِ مَعَ ابْنِہَا مِیرَاثًا۔","Sahih","Musannaf Ibn Abi Shaybah 31965","","","كتاب الفرائض"
"31966","(۳۱۹۶۶) حَدَّثَنَا یَزِیدُ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ وَزَیْدٍ : أَنَّہُمَا لَمْ یَکُونَا یَجْعَلاَنِ لِلْجَدَّۃِ مَعَ ابْنِہَا مِیرَاثًا۔","Da'if","Musannaf Ibn Abi Shaybah 31966","","","كتاب الفرائض"
"31967","(۳۱۹۶۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ مَکْحُولٍ ، قَالَ : ابْنُ الْمُلاعَنَۃ تَرِثُ أُمُّہُ مِیرَاثَہُ کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 31967","","","كتاب الفرائض"
"31968","(۳۱۹۶۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ : لِلْمُلاَعِنَۃِ مِیرَاثُ وَلَدِہَا کُلُّہُ۔","","Musannaf Ibn Abi Shaybah 31968","","","كتاب الفرائض"
"31969","(۳۱۹۶۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَر بْنِ عَامِرٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، قَالَ فِی وَلَدِ الْمُلاعَنَۃ : مِیرَاثُہُ کُلُّہُ لأُمِّہِ ، فَإِنْ لَمْ یَکُنْ لَہُ أُمٌّ فَہُوَ لِعَصَبَتِہِ۔n وَقَالَ إبْرَاہِیمُ : مِیرَاثُہُ کُلُّہُ لأُمِّہِ ، وَیَعْقِلُ عَنْہُ عَصَبَتُہَا ، وَکَذَلِکَ وَلَدُ الزِّنَا وَوَلَدُ النَّصْرَانِیِّ وَأُمُّہُ مُسْلِمَۃٌ۔","","Musannaf Ibn Abi Shaybah 31969","","","كتاب الفرائض"
"31970","(۳۱۹۷۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ : فِی ابْنِ الْمُلاعَنَۃ : مِیرَاثُہُ لأُمِّہِ ، فَإِنْ کَانَتْ أُمُّہُ قَدْ مَاتَتْ یَرِثُہُ وَرَثَتُہَا۔","","Musannaf Ibn Abi Shaybah 31970","","","كتاب الفرائض"
"31971","(۳۱۹۷۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : یَرِثُ ابْنُ الْمُلاعَنَۃ أُمَّہُ ، فَإِذَا مَاتَ وَرِثَہُ مَنْ کَانَ یَرِثُ أُمَّہُ۔","","Musannaf Ibn Abi Shaybah 31971","","","كتاب الفرائض"
"31972","(۳۱۹۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ: حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ، عَنْ عَبْدِ اللہِ ، قَالَ: مِیرَاثُ ابْنِ الْمُلاعَنَۃ لأُمِّہِ۔","","Musannaf Ibn Abi Shaybah 31972","","","كتاب الفرائض"
"31973","(۳۱۹۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ عَلِیٍّ وَزَیْدٍ : فِی ابْنِ الْمُلاعَنَۃ ، قَالاَ : الثُّلُثُ لأُمِّہِ ، وَمَا بَقِیَ فِی بَیْتِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 31973","","","كتاب الفرائض"
"31974","(۳۱۹۷۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ، قَالَ : تَرِثُہُ مِیرَاثَہَا ، وَبَقِیَّتُہُ فِی بَیْتِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 31974","","","كتاب الفرائض"
"31975","(۳۱۹۷۵) حَدَّثَنَا مَعْن بْنُ عِیسَی ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ عُرْوَۃَ : فِی ابْنِ الْمُلاعَنَۃ وَوَلَدِ الزِّنَا إذَا مَاتَ : وَرِثَتْہُ أُمُّہُ حَقَّہَا فِی کِتَابِ اللہِ وَإِخْوَتُہُ لأُمِّہِ حُقُوقَہُمْ ، وَکَانَ مَا بَقِیَ لِلْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 31975","","","كتاب الفرائض"
"31976","(۳۱۹۷۶) حدَّثَنَا عِیسَی ، عَنْ مَالِکٍ ، أَنَّہُ بَلَغَہُ عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 31976","","","كتاب الفرائض"
"31977","(۳۱۹۷۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَارَأْیُ إبْرَاہِیمَ بْنِ یَزِیدَ فِی ابْنِ الْمُلاعَنَۃ ؟ فَقُلْتُ : یَلْحَقُ بِأُمِّہِ ، وَقَالَ إبْرَاہِیمُ : یَلْحَقُ بِأَبِیہِ ، فَأَتَیْنَا عَبْدَ اللہِ بْنَ ہُرْمُزَ ، فَکَتَبَ لَنَا إلَی الْمَدِینَۃِ إلَی أَہْلِ الْبَیْتِ الَّذِی کَانَ ذَلِکَ فِیہِمْ ، فَجَائَ جَوَابُ کِتَابِہِمْ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَلْحَقَہُ بِأُمِّہِ۔n(عبدالرزاق ۱۲۴۸۶)","","Musannaf Ibn Abi Shaybah 31977","","","كتاب الفرائض"
"31978","(۳۱۹۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : کَتَبْت إلَی أَخٍ لِی فِی بَنِی زُرَیْقٍ : لِمَنْ قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِابْنِ الْمُلاعَنَۃ ؟ فَکَتَبَ إلَیَّ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِہِ لأُمِّہِ ، ہِیَ بِمَنْزِلَۃِ أَبِیہِ وَمَنْزِلَۃِ أُمِّہِ۔n(ابوداؤد ۳۶۲۔ عبدالرزاق ۱۲۴۷۷)","","Musannaf Ibn Abi Shaybah 31978","","","كتاب الفرائض"
"31979","(۳۱۹۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ وَعَبْدِ اللہِ ، أَنَّہُمَا قَالاَ فِی ابْنِ الْمُلاعَنْۃ : عَصَبَتُہُ عَصَبَۃُ أُمِّہِ۔","Da'if","Musannaf Ibn Abi Shaybah 31979","","","كتاب الفرائض"
"31980","(۳۱۹۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : ابْنُ الْمُلاعَنَۃ عَصَبَتُہُ عَصَبَۃُ أُمِّہِ یَرِثُہُمْ وَیَرِثُونَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31980","","","كتاب الفرائض"
"31981","(۳۱۹۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : ابْنُ الْمُلاعَنَۃ عَصَبَتُہُ عَصَبَۃُ أُمِّہِ ، یَرِثُونَہُ وَیَعْقِلُونَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 31981","","","كتاب الفرائض"
"31982","(۳۱۹۸۲) حَدَّثَنَا أَسْبَاطُ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : یَرِثُہُ أَقْرَبُ النَّاسِ إِلَی أُمِّہِ۔","","Musannaf Ibn Abi Shaybah 31982","","","كتاب الفرائض"
"31983","(۳۱۹۸۳) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، قَالاَ : ابْنُ الْمُلاعَنْۃ یَرِثُہُ مَنْ یَرِثُ أُمَّہُ۔","","Musannaf Ibn Abi Shaybah 31983","","","كتاب الفرائض"
"31984","(۳۱۹۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمْزَۃُ الزَّیَّاتُ ، عَنْ رَجُلٍ یُقَالَ لَہُ : عُمَرُ ، عَنِ الشَّعْبِیِّ : فِی ابْنِ مُلاعَنَۃٍ مَاتَ وَتَرَکَ خَالَہُ وَخَالَتَہُ ، قَالَ : الْمَالُ لِلْخَالِ۔","","Musannaf Ibn Abi Shaybah 31984","","","كتاب الفرائض"
"31985","(۳۱۹۸۵) حدَّثَنَا وَکِیعٌ ، قَالَ : قَالَ حَمْزَۃُ : وَکَانَ ابْنُ أَبِی لَیْلَی یَقُولُ : لِلْخَالِ الثُّلُثَانِ وَلِلْخَالَۃِ الثُّلُثُ۔","","Musannaf Ibn Abi Shaybah 31985","","","كتاب الفرائض"
"31986","(۳۱۹۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَمَّنْ سَمِعَ الشَّعْبِیَّ یَقُولُ : فِی ابْنِ مُلاَعَنَۃٍ مَاتَ وَتَرَکَ ابْنَ أَخِیہِ وَجَدَّہُ أَبَا أُمِّہِ ، قَالَ : الْمَالُ لابْنِ الأَخِ۔","","Musannaf Ibn Abi Shaybah 31986","","","كتاب الفرائض"
"31987","(۳۱۹۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ عَمَّنْ سَمِعَ الشَّعْبِیَّ ، عَنْ عَلِیٍّ وَعَبْدِ اللہِ ، أَنَّہُمَا قَالاَ فِی ابْنِ مُلأَعَنْۃٍ مَاتَ وَتَرَکَ أُمَّہُ وَأَخَاہُ لأُمِّہِ ، قَالَ : کَانَ عَلِیٌّ یَقُولُ : لِلأُمِّ الثُّلُثُ ، وَلِلأَخِ السُّدُسُ ، وَیَرُدُّ مَا بَقِیَ عَلَیْہِمَا الثُّلُثَانِ وَالثُّلُثُ ، وَکَانَ ابْنُ مَسْعُودٍ یَقُولُ : لِلأُمِّ الثُّلُثُ ، وَلِلأَخِ السُّدُسُ ، وَیَرُدُّ مَا بَقِیَ عَلَی الأُمِّn قَالَ أَبُو بَکْرٍ : فَہَذِہِ مِنْ قَوْلِہِمْ جَمِیعًا تَصِیرُ مِنْ سِتَّۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31987","","","كتاب الفرائض"
"31988","(۳۱۹۸۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی الْمِنْہَالِ ، عَنْ إیَاسِ بْنِ عَبْدٍ ، الْمُزَنِیّ : أَنَّہُ سُئِلَ عَنْ أُنَاسٍ سَقَطَ عَلَیْہِمْ بَیْتٌ فَمَاتُوا جَمِیعًا ؟ فَوَرِثَ بَعْضُہُمْ مِنْ بَعْضٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31988","","","كتاب الفرائض"
"31989","(۳۱۹۸۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، قَالَ : أَخْبَرَنِی قَطَنُ بْنُ عَبْدِ اللہِ الضَّبِّیُّ : أَنَّ امْرَأَۃً رَکِبَتِ الْفُرَاتِ وَمَعَہَا ابْنٌ لَہَا فَغَرِقَا جَمِیعًا ، فَلَمْ یُدْرَ أَیُّہُمَا مَاتَ قَبْلَ صَاحِبِہِ فَأَتَیْنَا شُرَیْحًا فَأَخْبَرْنَاہُ بِذَلِکَ ، فَقَالَ : وَرِثُوا کُلَّ وَاحِدٍ مِنْہُمَا مِنْ صَاحِبِہِ ، وَلاَ تَرُدُّوا عَلَی وَاحِدٍ مِنْہُمَا مِمَّا وَرِثَ مِنْ صَاحِبِہِ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 31989","","","كتاب الفرائض"
"31990","(۳۱۹۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الزَّعْرَائِ عَمْرِو بْنِ عَمْرٍو الْجُشَمِیِّ ، عَنْ عَبْدِ اللہِ بْنِ عُتْبَۃَ - وَکَانَ قَاضِیًا لابْنِ الزُّبَیْرِ - : أَنَّہُ وَرَّثَ الْغَرْقَی بَعْضَہُمْ مِنْ بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 31990","","","كتاب الفرائض"
"31991","(۳۱۹۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سِمَاکٍ ، عَنْ رَجُلٍ ، عَنْ عُمَرَ ، أَنَّہُ وَرَّثَ قَوْمًا غَرِقُوا بَعْضَہُمْ مِنْ بَعْضٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31991","","","كتاب الفرائض"
"31992","(۳۱۹۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حُصَینٍ : أَنَّ قَوْمًا غَرِقُوا عَلَی جِسْرِ مَنْبِجٍ ، فَوَرَّثَ عُمَرُ بَعْضَہُمْ مِنْ بَعْضٍ ، قَالَ سُفْیَانُ لأَبِی حُصَیْنٍ : مِنَ الشَّعْبِیِّ سَمِعْتہ ، قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 31992","","","كتاب الفرائض"
"31993","(۳۱۹۹۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ : أَنَّ أَہْلَ بَیْتٍ غَرِقُوا فِی سَفِینَۃٍ ، فَوَرَّثَ عَلِیٌّ بَعْضَہُمْ مِنْ بَعْضٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31993","","","كتاب الفرائض"
"31994","(۳۱۹۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنْ عَبِیدَۃَ : أَنَّ قَوْمًا وَقَعَ عَلَیْہِمْ بَیْتٌ ، أَوْ مَاتُوا فِی طَاعُونٍ ، فَوَرَّثَ عُمَرُ بَعْضَہُمْ مِنْ بَعْضٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31994","","","كتاب الفرائض"
"31995","(۳۱۹۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ حُرَیسِ الْبَجَلِیِّ ، عَنْ أَبِیہِ : أَنَّ رَجُلاً وَابْنَہُ - أَوْ أَخَوَیْنِ - قُتِلاَ یَوْمَ صِفِّینَ جَمِیعًا ، لاَ یُدْرَی أَیُّہُمَا قُتِلَ أَوَّلاً ، قَالَ : فَوَرَّثَ عَلِیٌّ کُلَّ وَاحِدٍ مِنْہُمَا صَاحِبَہُ۔n(عبدالرزاق ۱۹۱۵۲۔ دارمی ۳۰۴۸)","Da'if","Musannaf Ibn Abi Shaybah 31995","","","كتاب الفرائض"
"31996","(۳۱۹۹۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ رَجُلٍ ، عَنْ قَبِیصَۃَ بْنِ ذُؤَیْبٍ : أَنَّ طَاعُونًا وَقَعَ بِالشَّامِ ، فَکَانَ أَہْلُ الْبَیْتِ یَمُوتُونَ جَمِیعًا ، فَکَتَبَ عُمَرُ أَنْ یُوَرَّثُ الأَعْلَی مِنَ الأَسْفَلِ ، وَإِذَا لَمْ یَکُونُوا کَذَلِکَ وَرَّثَ ہَذَا مِنْ ذَا ، وَہَذَا مِنْ ذَا۔n قَالَ سَعِیدٌ : الأَعْلَی مِنَ الأَسْفَلِ : کَانَ الْمَیِّتُ مِنْہُمْ یَمُوتُ وَقَدْ وَضَعَ یَدُہُ عَلَی آخَرَ إلَی جَنْبِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 31996","","","كتاب الفرائض"
"31997","(۳۱۹۹۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عَلِیٍّ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 31997","","","كتاب الفرائض"
"31998","(۳۱۹۹۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، قَالَ إبْرَاہِیمُ : فِی الْقَوْمِ یَمُوتُونَ لاَ یُدْرَی أَیُّہُمْ مَاتَ قَبْلُ ، قَالَ : یُوَرَّثُ بَعْضُہُمْ مِنْ بَعْضٍ۔n قَالَ مَنْصُورٌ : لاَ یَضُرُّک بِأَیِّہِمْ بَدَأْت إذَا وَرَّثْت بَعْضَہُمْ مِنْ بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 31998","","","كتاب الفرائض"
"31999","(۳۱۹۹۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : أَنَّہُ کَانَ یُوَرِّثُ الأَحْیَائَ مِنَ الأَمْوَاتِ ، وَلاَ یُوَرِّثُ الْغَرْقَی بَعْضَہُمْ مِنْ بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 31999","","","كتاب الفرائض"
"32000","(۳۲۰۰۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، قَالَ : کَانَ فِی کِتَابِ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : یَرِثُ کُلُّ إنْسَانٍ وَارِثُہُ مِنَ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 32000","","","كتاب الفرائض"
"32001","(۳۲۰۰۱) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَتَتْہُ امْرَأَۃٌ فَقَالَتْ : إنَّ أَخِی وَابْنَ أَخِی خَرَجَا فِی سَفِینَۃٍ فَغَرِقَا ، فَلَمْ یُوَرِّثْہُمَا شَیْئًا۔","","Musannaf Ibn Abi Shaybah 32001","","","كتاب الفرائض"
"32002","(۳۲۰۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حُسَیْنٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یَرِثُ وَاحِدٌ مِنْہُمَا مِمَّا وَرِثَ مِنْ صَاحِبِہِ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 32002","","","كتاب الفرائض"
"32003","(۳۲۰۰۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ فِی الَّذِینَ یَمُوتُونَ جَمِیعًا ، لاَ یُدْرَی أیُّہُمْ مَاتَ قَبْلَ صَاحِبِہِ ، قَالَ : لاَ یُوَرَّثُ بَعْضُہُمْ مِنْ بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 32003","","","كتاب الفرائض"
"32004","(۳۲۰۰۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ جَہْمٍ ، عَنْ إبْرَاہِیمَ : أَنَّ عَلِیًّا وَرَّثَ ثَلاَثَۃً غَرِقُوا فِی سَفِینَۃٍ بَعْضَہُمْ مِنْ بَعْضٍ وَأُمُّہُمْ حَیَّۃٌ ، فَوَرَّثَ أُمَّہُمُ السُّدُسَ مِنْ صُلْبِ کُلِّ وَاحِدٍ مِنْہُمْ ، ثُمَّ وَرَّثَہَا الثُّلُثَ بِمَا وَرِثَ کُلُّ وَاحِدٍ مِنْ صَاحِبِہِ ، وَجَعَلَ مَا بَقِیَ لِلْعَصَبَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 32004","","","كتاب الفرائض"
"32005","(۳۲۰۰۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ : أَنَّہُ سَمِعَہُمَا یُفَسِّرَانِ قَوْلَہُمْ : یُوَرَّثُ بَعْضُہُمْ مِنْ بَعْضٍ ، قَالاَ : إذَا مَاتَ أَحَدُہُمَا وَتَرَکَ مَالا ، وَلَمْ یَتْرُکَ الآخَرُ شَیْئًا ، وَرِثَ وَرَثَۃُ الَّذِی لَمْ یَتْرُکْ شَیْئًا مِیرَاثَ صَاحِبِ الْمَالِ ، وَلَمْ یَکُنْ لِوَرَثَۃِ صَاحِبِ الْمَالِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 32005","","","كتاب الفرائض"
"32006","(۳۲۰۰۶) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : مِیرَاثُ اللَّقِیطِ بِمَنْزِلَۃِ اللُّقَطَۃِ۔","","Musannaf Ibn Abi Shaybah 32006","","","كتاب الفرائض"
"32007","(۳۲۰۰۷) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنِ الْحَارِثِ بْنِ حَصِیرَۃ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : لَمَّا رَجَمَ عَلِیٌّ الْمَرْأَۃَ ، قَالَ لاَہْلِہَا : ہَذَا ابْنُکُمْ تَرِثُونَہُ ، وَیَرِثُکُمْ ، وَإِنْ جَنَی جِنَایَۃً فَعَلَیْکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 32007","","","كتاب الفرائض"
"32008","(۳۲۰۰۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ وَعَبْدِ اللہِ : فِی ابْنِ الْمُلاعَنَۃ : أُمُّہُ عَصَبَتُہُ وَعَصَبَتُہَا عَصَبَتُہُ وَوَلَدُ الزِّنَا بِمَنْزِلَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 32008","","","كتاب الفرائض"
"32009","(۳۲۰۰۹) حَدَّثَنَا عَبَّادُ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : مِیرَاثُہُ کُلُّہُ لأُمِّہِ - یَعْنِی : ابْنَ الْمُلاعَنَۃ - ، وَیَعْقِلُ عَنْہُ عَصَبَتُہَا ، وَکَذَلِکَ وَلَدُ الزِّنَا ، وَوَلَدُ النَّصْرَانِیِّ وَأُمُّہُ مُسْلِمَۃٌ۔","","Musannaf Ibn Abi Shaybah 32009","","","كتاب الفرائض"
"32010","(۳۲۰۱۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : وَلَدُ الْمُلاعَنَۃ وَوَلَدُ الزِّنَا : یَتَوَارَثَانِ مِنْ قِبَلِ الأُمِّ۔","","Musannaf Ibn Abi Shaybah 32010","","","كتاب الفرائض"
"32011","(۳۲۰۱۱) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : وَلَدُ الزِّنَا بِمَنْزِلَۃِ ابْنِ الْمُلاعَنَۃ ، أَو ابْنُ الْمُلاعَنَۃ بِمَنْزِلَۃِ وَلَدِ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 32011","","","كتاب الفرائض"
"32012","(۳۲۰۱۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَشْعَثِ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَتَبَ ہِشَامُ بْنُ ہُبَیْرَۃَ إلَی شُرَیْحٍ یَسْأَلُہُ عَنْ مِیرَاثِ وَلَدِ الزِّنَا ؟ فَکَتَبَ إلَیْہِ : ارْفَعْہُ إلَی السُّلْطَانِ فَلْیَلِ حُزُونَتَہُ وَسُہُولَتَہُ۔","","Musannaf Ibn Abi Shaybah 32012","","","كتاب الفرائض"
"32013","(۳۲۰۱۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ، عَنْ إبْرَاہِیمَ، عَنِ الْحَسَنِ بْنِ الْحُرّ، عَنِ الْحَکَمِ، قَالَ: وَلَدُ الزِّنَا وَوَلَدُ الْمُتَلاعَنْینَ تَرِثُہُمَا أُمُّہُمَا وَأَخْوَالُہُمَا۔","","Musannaf Ibn Abi Shaybah 32013","","","كتاب الفرائض"
"32014","(۳۲۰۱۴) حَدَّثَنَا ہُشَیْمٌ، عَنْ مُغِیرَۃَ، عَنْ شِبَاکٍ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ: فِی الْخُنْثَی ، قَالَ: یُوَرَّثُ مِنْ قِبَلِ مَبَالِہِ۔","","Musannaf Ibn Abi Shaybah 32014","","","كتاب الفرائض"
"32015","(۳۲۰۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْحَسَنُ بْنُ کَثِیرٍ الأَحْمَسِیُّ ، عَنْ أَبِیہِ : أَنَّ مُعَاوِیَۃَ أُتِیَ فِی خُنْثَی فَأَرْسَلِہُمْ إلَی عَلِیّ ، فَقَالَ : یُوَرَّثُ مِنْ حَیْثُ یَبُولُ۔","Da'if","Musannaf Ibn Abi Shaybah 32015","","","كتاب الفرائض"
"32016","(۳۲۰۱۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ وَالْحَسَنِ : فِی الْخُنْثَی ، قَالاَ : یُوَرَّثُ مِنْ مَبَالِہِ۔n قَالَ قَتَادَۃُ : فَذَکَرْتُ ذَلِکَ لِسَعِیدِ بْنِ الْمُسَیَّبِ ، فَقَالَ : نَعَمْ ، وَإِنْ بَالَ مِنْہُمَا جَمِیعًا فَمِنْ أَیِّہِمَا سَبَقَ۔","","Musannaf Ibn Abi Shaybah 32016","","","كتاب الفرائض"
"32017","(۳۲۰۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُمَرُ بْنُ بَشِیرٍ الْہَمْدَانِیُّ ، عَنِ الشَّعْبِیِّ : فِی مَوْلُودٍ وُلِدَ لَیْسَ لَہُ مَا لِلذَّکَرِ ، وَلاَ مَا لِلأُنْثَی ، یَبُولُ منْ سُرَّتِہِ ! قَالَ : لَہُ نِصْفُ حَظِّ الأُنْثَی وَنِصْفُ حَظِّ الذَّکَرِ۔","","Musannaf Ibn Abi Shaybah 32017","","","كتاب الفرائض"
"32018","(۳۲۰۱۸) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الْعَدَنِیِّ ، عَنْ أَبِی جَعْفَرٍ : فِی الْخُنْثَی یُوَرَّثُ مِنْ مَبَالِہِ ، وَإِنْ بَالَ مِنْہُمَا جَمِیعًا فَمِنْ أَیِّہِمَا سَبَقَ۔","","Musannaf Ibn Abi Shaybah 32018","","","كتاب الفرائض"
"32019","(۳۲۰۱۹) حَدَّثَنَا جَرِیرٌ، عَنْ لَیْثٍ، عَنْ حَمَّادٍ، عَنْ إبْرَاہِیمَ، قَالَ: لَمْ یَکُنْ أَبُوبَکْرٍ وَعُمَرُ وَعُثْمَان یُوَرِّثُونَ الْحَمِیلَ۔","Da'if","Musannaf Ibn Abi Shaybah 32019","","","كتاب الفرائض"
"32020","(۳۲۰۲۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَبِی طَلْقٍ ، عَنْ أَبِیہِ ، قَالَ : أَدْرَکْت الْحُمَلاَئَ فِی زَمَانِ عَلِیٍّ وَعُثْمَانَ لاَ یُوَرَّثُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 32020","","","كتاب الفرائض"
"32021","(۳۲۰۲۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَابْنِ سِیرِینَ ، قَالاَ : مَا یُوَرَّثُ الْحَمِیلُ إلاَّ بِبَیِّنَۃٍ۔","","Musannaf Ibn Abi Shaybah 32021","","","كتاب الفرائض"
"32022","(۳۲۰۲۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَلِیُّ بْنُ الْمُبَارَکِ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ : أَنَّ عُمَرَ کَتَبَ : أَنْ لاَ یُوَرَّثُ بِوِلاَدَۃِ الشِّرْکِ۔","","Musannaf Ibn Abi Shaybah 32022","","","كتاب الفرائض"
"32023","(۳۲۰۲۳) حَدَّثَنَا ابْنُ نُمَیْرٍ، قَالَ: حدَّثَنَا مُجَالِدٌ، عَنِ الشَّعْبِیِّ، قَالَ: کُتِبَ إلَی شُرَیْحٍ أَنْ لاَ یُوَرَّثَ حَمِیلٌ إلاَّ بِبَیِّنَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 32023","","","كتاب الفرائض"
"32024","(۳۲۰۲۴) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : ذُکِرَ لِمُحَمَّدٍ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ فِی الْحُمَلاَئِ: لاَ یُوَرَّثُونَ إلاَّ بِشَہَادَۃِ الشُّہُودِ ، قَالَ : فَقَالَ مُحَمَّدٌ : قَدْ تَوَارَثَ الْمُہَاجِرُونَ وَالأَنْصَارُ بِنَسَبِہِمَ الَّذِی کَانَ فِی الْجَاہِلِیَّۃِ ، فَأَنَا أُنْکِرُ أَنْ یَکُونَ عُمَرُ کَتَبَ بِہَذَا۔","","Musannaf Ibn Abi Shaybah 32024","","","كتاب الفرائض"
"32025","(۳۲۰۲۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَتَوَارَثُونَ بِالأَرْحَامِ الَّتِی یَتَوَاصَلُونَ بِہَا۔","","Musannaf Ibn Abi Shaybah 32025","","","كتاب الفرائض"
"32026","(۳۲۰۲۶) حَدَّثَنَا جَرِیرٌ ، عَنِ الأَعْمَشِ ، عَنْ إیَاسِ بْنِ عَبَّاسٍ ، عَنْ شَیْخٍ مِنْ قَوْمِہِ : أَنَّ أَبَا سُلَیْمَانَ غَرِقَ أَخٌ لَہُ یُقَالَ لَہُ : رَاشِدٌ ، فَاخْتَصَمَ فِیہِ بَنُو زَبِیدٍ وَبَنُو أَسَدٍ ، فَارْتَفَعُوا إلَی مَسْرُوقٍ ، فَقَالَ : مَسْرُوقٌ لِبَنِی أَسَدٍ : أَتَشْہَدُونَ أَنَّہُ کَانَ یَحْرُمُ عَنْہُ مَا یَحْرُمُ الأَخَ مِنْ أُخْتِہِ ، فَشَہِدُوا بِذَلِکَ ، فَأَعْطَی أَبَا سُلَیْمَانَ مِیرَاثَہُ۔","","Musannaf Ibn Abi Shaybah 32026","","","كتاب الفرائض"
"32027","(۳۲۰۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ سَمِعْت الأَعْمَشَ ، قَالَ : کَانَ أَبِی حَمِیلاً فَمَاتَ أَخُوہُ ، فَوَرَّثَہُ مَسْرُوقٌ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 32027","","","كتاب الفرائض"
"32028","(۳۲۰۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عُمَرُ : کُلّ نَسَبٍ یُتَوَصَل عَلَیْہِ فِی الإسْلاَمِ فَہُوَ وَارِثٌ مَوْرُوثٌ۔","","Musannaf Ibn Abi Shaybah 32028","","","كتاب الفرائض"
"32029","(۳۲۰۲۹) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ، قَالَ: إذَا کَانَ نَسَبًا مَعْرُوفًا مَوْصُولاً وَرِثَ۔ یَعْنِی: الْحَمِیلَ۔","","Musannaf Ibn Abi Shaybah 32029","","","كتاب الفرائض"
"32030","(۳۲۰۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنِ الْحَمِیلِ ؟ فَقَالاَ : لاَ یَرِثُ إلاَّ بِبَیِّنَۃٍ۔","","Musannaf Ibn Abi Shaybah 32030","","","كتاب الفرائض"
"32031","(۳۲۰۳۱) حَدَّثَنَا عَبْدُالرَّحِیمِ بْنُ عَبْدِالرَّحْمَنِ الْمُحَارِبِیُّ، قَالَ: حدَّثَنَا زَائِدَۃُ بْنُ قُدَامَۃَ، قَالَ: حَدَّثَنَا أَشْعَثُ بْنُ أَبِی الشَّعْثَائِ، قَالَ: أَقَرَّتِ امْرَأَۃٌ مِنْ مُحَارِبٍ جَلِیبَۃٌ بِنَسَبِ أَخٍ لَہَا جَلِیبٌ، فَوَرَّثَہُ عَبْدُالرَّحْمَنِ بْن عُتْبَۃَ مِنْ أُخْتِہِ۔","","Musannaf Ibn Abi Shaybah 32031","","","كتاب الفرائض"
"32032","(۳۲۰۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْحَکَمُ بْنُ عَطِیَّۃَ ، قَالَ : سَأَلْتُ الْحَسَنَ عَنِ الْحَمِیلِ یُقِیمُ الْبَیِّنَۃَ أَنَّہُ أَخُوہُ ، قَالَ : یَرِثُہُ فِی کِتَابِ اللہِ {وَأُولُو الأَرْحَامِ بَعْضُہُمْ أَوْلَی بِبَعْضٍ فِی کِتَابِ اللہِ}۔","","Musannaf Ibn Abi Shaybah 32032","","","كتاب الفرائض"
"32033","(۳۲۰۳۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْوَلِیدِ بْنِ جُمَیْعٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا ارْتَدَّ الْمُرْتَدُّ وَرِثَہُ وَلَدُہُ۔","","Musannaf Ibn Abi Shaybah 32033","","","كتاب الفرائض"
"32034","(۳۲۰۳۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، عَنْ عَلِیٍّ : أَنَّہُ أُتِیَ بِمسْتورِد الْعِجْلِیّ وَقَدِ ارْتَدَ ، فَعَرَضَ عَلَیْہِ الإسْلاَمَ فَأَبَی فَقَتَلَہُ وَجَعَلَ مِیرَاثَہُ بَیْنَ وَرَثَتِہِ مِنَ الْمُسْلِمِینَ۔n(عبدالرزاق ۱۹۲۹۶۔ دارمی ۳۰۷۵)","Sahih","Musannaf Ibn Abi Shaybah 32034","","","كتاب الفرائض"
"32035","(۳۲۰۳۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ حَجَّاجٍ، عَنِ الْحَکَمِ، عَنْ عَلِیٍّ: فِی مِیرَاثِ الْمُرْتَدِّ: لِوَرَثَتِہِ مِنَ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 32035","","","كتاب الفرائض"
"32036","(۳۲۰۳۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : فِی مِیرَاثِ الْمُرْتَدِّ ، أَنَّہُ لِوَرَثَتِہِ مِنَ الْمُسْلِمِینَ ، وَلَیْسَ لأَہْلِ ۔۔ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 32036","","","كتاب الفرائض"
"32037","(۳۲۰۳۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنِ الْحَسَنِ، قَالَ: یُقْتَلُ، وَمِیرَاثُہُ لِوَرَثَتِہِ مِنَ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 32037","","","كتاب الفرائض"
"32038","(۳۲۰۳۸) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرو ، عَنِ الْحَسَنِ ، قَالَ : جُعِلَ مِیرَاثُ الْمُرْتَدِّ لِوَرَثَتِہِ۔","","Musannaf Ibn Abi Shaybah 32038","","","كتاب الفرائض"
"32039","(۳۲۰۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُوسَی بْنِ أَبِی کَثِیرٍ قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنْ مِیرَاثِ الْمُرْتَدِّ ، ہَلْ یُوصَلُ ؟ قَالَ : مَا یُوصَلُ ؟ قُلْتُ : یَرِثُہُ بَنُوہُ ، قَالَ نَرِثُہُمْ لاَ یَرِثُونَنَا۔","","Musannaf Ibn Abi Shaybah 32039","","","كتاب الفرائض"
"32040","(۳۲۰۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ أَبِی الصَّبَّاحِ مُوسَی بْنِ أَبِی کَثِیرٍ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ : الْمُرْتَدُّونَ نَرِثُہُمْ ، وَلاَ یَرِثُونَنَا۔","","Musannaf Ibn Abi Shaybah 32040","","","كتاب الفرائض"
"32041","(۳۲۰۴۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ وَالْحَکَمِ ، قَالاَ : یُقَسَّمُ مِیرَاثُہُ بَیْنَ امْرَأَتِہِ وَبَیْنَ وَرَثَتِہِ مِنَ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 32041","","","كتاب الفرائض"
"32042","(۳۲۰۴۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ : إذَا لَحِقَ بِدَارِ الْحَرْبِ ، ثُمَّ رَجَعَ قَبْلَ أَنْ یُقَسَّمَ مِیرَاثُہُ ، أَوْ یَعْتِقَ الْحَاکِمُ أُمَّہَاتِ أَوْلاَدِہِ وَمُدَبَّرَتَہُ فَہُوَ أَحَقُّ بِہِمْ۔","","Musannaf Ibn Abi Shaybah 32042","","","كتاب الفرائض"
"32043","(۳۲۰۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : کَانَ الْمُسْلِمُونَ یُطَیِّبُونَ لأَہْلِ الْمُرْتَدِّ مِیرَاثَہُ۔ یَعْنِی : إذَا قُتِلَ۔","","Musannaf Ibn Abi Shaybah 32043","","","كتاب الفرائض"
"32044","(۳۲۰۴۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ : أَنَّ قَتَادَۃَ - رَجُلاً مِنْ بَنِی مُدْلِجٍ - قَتَلَ ابْنَہُ ، فَأَخَذَ بِہِ عُمَرُ بْنُ الْخَطَّابِ مِئَۃ مِنَ الإِبِلِ : ثَلاَثِینَ حِقَّۃً ، وَثَلاَثِینَ جَذَعَۃً ، وَأَرْبَعِینَ خَلِفَۃً ، وَقَالَ لاَبِی الْمَقْتُولِ: سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: لَیْسَ لِقَاتِلٍ مِیرَاثٌ۔(ابن ماجہ ۲۶۴۶۔ مالک ۸۶۷)","","Musannaf Ibn Abi Shaybah 32044","","","كتاب الفرائض"
"32045","(۳۲۰۴۵) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ عُمَرُ : لاَ یَرِثُ الْقَاتِلُ۔","","Musannaf Ibn Abi Shaybah 32045","","","كتاب الفرائض"
"32046","(۳۲۰۴۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ، عَنْ مُطَرِّفٍ، عَنِ الشَّعْبِیِّ ، قَالَ: قَالَ عُمَرُ: لاَ یَرِثُ الْقَاتِلُ عَمْدًا ، وَلاَ خَطَأً۔","","Musannaf Ibn Abi Shaybah 32046","","","كتاب الفرائض"
"32047","(۳۲۰۴۷) حَدَّثَنَا عَبَّادٌ ، عَنْ حَجَّاجٍ ، عَنْ حَبِیبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّ رَجُلاً قَتَلَ أَخَاہُ خَطَا ، فَسُئِلَ عَنْ ذَلِکَ ابْنُ عَبَّاسٍ ؟ فَلَمْ یُوَرِّثْہُ ، وَقَالَ : لاَ یَرِثُ قَاتِلٌ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 32047","","","كتاب الفرائض"
"32048","(۳۲۰۴۸) حَدَّثَنَا شَبَابَۃُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قضَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَرِثُ قَاتِلٌ مَنْ قَتَلِ قَرِیبِہِ شَیْئًا مِنَ الدِّیَۃِ عَمْدًا أَوْ خَطَأً۔n وَقَالَ الزُّہْرِیُّ الْقَاتِلُ لاَ یَرِثُ مِنْ دِیَۃ مَنْ قُتِلَ شَیْئًا وَإِنْ کَانَ وَلَدًا ، أَوْ وَالِدًا ، وَلَکِنْ یَرِثُ مِنْ مَالِہِ ، لأَنَّ اللَّہَ قَدْ عَلِمَ أَنَّ النَّاسَ یَقْتُلُ بَعْضُہُمْ بَعْضًا ، وَلاَ یَنْبَغِی لأَحَدٍ أَنْ یَقْطَعَ الْمَوَارِیثَ الَّتِی فَرَضَہَا۔","","Musannaf Ibn Abi Shaybah 32048","","","كتاب الفرائض"
"32049","(۳۲۰۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی عَمْرٍو الْعَبْدِیِّ ، عَنْ عَلِیٍّ ، قَالَ : لاَ یَرِثُ الْقَاتِلُ۔","Da'if","Musannaf Ibn Abi Shaybah 32049","","","كتاب الفرائض"
"32050","(۳۲۰۵۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ یَرِثُ الْقَاتِلُ مِنَ دِیَۃٍ مَنْ قُتِلَ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 32050","","","كتاب الفرائض"
"32051","(۳۲۰۵۱) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانُ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاہِیمَ قَالَ: لاَ یَرِثُ الْقَاتِلُ مِنَ الدِّیَۃ ولاَ مِنَ الْمَالُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 32051","","","كتاب الفرائض"
"32052","(۳۲۰۵۲) حَدَّثَنَا إبْرَاہِیمُ بْنُ صَدَقَۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ لاَ یُوَرِّثُ الْقَاتِلَ وَیَرَی ، أَنَّہُ یَحْجبُ۔","","Musannaf Ibn Abi Shaybah 32052","","","كتاب الفرائض"
"32053","(۳۲۰۵۳) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، قَالَ : سَأَلْتُ ابْنَ شِہَابٍ عَنِ الْقَاتِلِ یَرِثُ شَیْئًا ؟ قَالَ : فَقَالَ سَعِیدُ بْنُ الْمُسَیَّبِ : مَضَتِ السُّنَّۃُ أَنَّ الْقَاتِلَ لاَ یَرِثُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 32053","","","كتاب الفرائض"
"32054","(۳۲۰۵۴) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ أَبِی عَوْنٍ ، قَالَ : قَالَ مُحَمَّدُ بْنُ جُبَیْرٍ: الْقَاتِلُ عَمْدًا لاَ یَرِثُ مِنَ الدِّیَۃِ ، وَلاَ مِنْ غَیْرِہَا شَیْئًا ، وَالْقَاتِلُ خَطَأً لاَ یَرِثُ مِنَ الدِّیَۃِ شَیْئًا وَیَرِثُ مِنْ غَیْرِہَا إنْ کَانَ۔","","Musannaf Ibn Abi Shaybah 32054","","","كتاب الفرائض"
"32055","(۳۲۰۵۵) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عُرْوَۃَ ، قَالَ : لاَ یَرِثُ الْقَاتِلُ۔","","Musannaf Ibn Abi Shaybah 32055","","","كتاب الفرائض"
"32056","(۳۲۰۵۶) حَدَّثَنَا حَاتِمٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : لاَ یَرِثُ قَاتِلٌ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 32056","","","كتاب الفرائض"
"32057","(۳۲۰۵۷) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : إذَا قَتَلَ الرَّجُلُ ابْنَہُ ، أَوْ أَخَاہُ لَمْ یَرِثْہُ ، وَوَرِثَہُ أَقْرَبُ النَّاسِ بَعْدَہُ۔","","Musannaf Ibn Abi Shaybah 32057","","","كتاب الفرائض"
"32058","(۳۲۰۵۸) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إنْ قَتَلَہُ خَطَأً وَرِثَہُ مِنْ مَالِہِ ، وَلَمْ یَرِثْ مِنْ دِیَتِہِ ، وَإِنْ قَتَلَہُ عَمْدًا لَمْ یَرِثْ مِنْ مَالِہِ ، وَلاَ مِنْ دِیَتِہِ۔","","Musannaf Ibn Abi Shaybah 32058","","","كتاب الفرائض"
"32059","(۳۲۰۵۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إذَا قَتَلَ وَلِیَّہُ خَطَأً وَرِثَ مِنْ مَالِہِ ، وَلَمْ یَرِثْ مِنْ دِیَتِہِ ، وَإِنْ قَتَلَہُ عَمْدًا لَمْ یَرِثْ مِنْ مَالِہِ ، وَلاَ مِنْ دِیَتِہِ۔","","Musannaf Ibn Abi Shaybah 32059","","","كتاب الفرائض"
"32060","(۳۲۰۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَلِیُّ بْنُ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عَلِیٍّ : فِی رَجُلٍ قَتَلَ أُمَّہُ قَالَ : إنْ کَانَ خَطَأً وَرِثَ ، وَإِنْ کَانَ عَمْدًا لَمْ یَرِثْ۔n قَالَ وَکِیعٌ : لاَ یَرِثُ قَاتِلُ عَمْدٍ وَلاَ خَطَأٍ مِنَ الدِّیَۃِ ، وَلاَ مِنَ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 32060","","","كتاب الفرائض"
"32061","(۳۲۰۶۱) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یَرِثُ الْقَاتِلُ۔","","Musannaf Ibn Abi Shaybah 32061","","","كتاب الفرائض"
"32062","(۳۲۰۶۲) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ ، قَالَ: لاَ یَرِثُ الْقَاتِلُ شَیْئًا مِنْ دِیَتِہِ ، وَلاَ مِنْ مَالِہِ۔","","Musannaf Ibn Abi Shaybah 32062","","","كتاب الفرائض"
"32063","(۳۲۰۶۳) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، عَنِ الْقَاسِمِ ، قَالَ : لاَ یَرِثُ الْقَاتِلُ۔","","Musannaf Ibn Abi Shaybah 32063","","","كتاب الفرائض"
"32064","(۳۲۰۶۴) حَدَّثَنَا یَحْیَی بْنُ یَمَانِ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : لاَ یَرِثُ الْقَاتِلُ۔","","Musannaf Ibn Abi Shaybah 32064","","","كتاب الفرائض"
