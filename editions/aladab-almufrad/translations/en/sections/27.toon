hadiths[8]{hadithnumber,text}:
"477","The Messager of Allah"
"478","Hanash ibn al-Harith reported that his father said"
"479","Anas ibn Malik reported that the Prophet"
"480","Dawud ibn Abi Dawud said"
"481","the supplication of the person who is wronged"
"482","Jabir reported that the Prophet"
"483","Jabir ibn 'Abdullah reported that the Prophet"
"484","Jabir reported that the Messenger of Allah"
