hadiths[78]{hadithnumber,text}:
"2606","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2607","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2608","। আনাস ইবনু মালিক (রাযিঃ) হতে বর্ণিত"
"2609","। ইবনু উমার (রাযিঃ) হতে বর্ণিত"
"2610","। ইয়াহইয়া ইবনু ইয়ামার (রহঃ) হতে বর্ণিত"
"2611","। ইবনু আব্বাস (রাযিঃ) হতে বর্ণিত"
"2612","। আইশা (রাঃ) হতে বর্ণিত আছে"
"2613","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত আছে যে"
"2614","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2615","। সালিম (রহঃ) হতে তার বাবার সূত্রে বর্ণিত আছে যে"
"2616","। মু'আয ইবনু জাবাল (রাযিঃ) হতে বর্ণিত"
"2617","। আবূ সাঈদ (রাঃ) হতে বর্ণিত আছে"
"2618","। জাবির (রাযিঃ) হতে বর্ণিত আছে যে"
"2619","। আমাশ (রহঃ) হতেও উপরোক্ত সনদে একই রকম হাদীস বর্ণিত আছে। এতে রাসূলুল্লাহ বলেছেনঃ বান্দাহ ও শিরকের মধ্যে অথবা বান্দাহ্ ও কুফরীর মধ্যে পার্থক্য হল নামায ত্যাগ করা। সহীহঃ দেখুন পূর্বের হাদীস আবূ ঈসা বলেন"
"2620","। জাবির (রাযিঃ) হতে বর্ণিত"
"2621","। বুরাইদাহ (রাযিঃ) হতে বর্ণিত"
"2622","। আবদুল্লাহ ইবনু শাকীক আল-উকাইলী (রাহঃ) হতে বর্ণিত"
"2623","। আল-আব্বাস ইবনু আবদিল মুত্তালিব (রাযিঃ) হতে বর্ণিত আছে যে"
"2624","আনাস ইবনু মালিক (রাযিঃ) হতে বর্ণিত আছে যে"
"2625","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2626","। আলী ইবনু আবূ তালিব (রাঃ) হতে বর্ণিত আছে"
"2627","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2628","। আবূ মূসা আল-আশ'আরী (রাযিঃ) হতে বর্ণিত আছে যে"
"2629","। আবদুল্লাহ ইবনু মাসউদ (রাযিঃ) হতে বর্ণিত"
"2630","। কাসীর ইবনু আবদুল্লাহ ইবনু আমর ইবনু আওফ ইবনু যাইদ ইবনু মিলহা (রহঃ) হতে পর্যায়ক্রমে তার পিতা ও দাদার সূত্রে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ সাপ যেভাবে (সংকুচিত হয়ে) তার গর্তে ফিরে যায় তেমনি দীন ইসলামও এক সময় সংকুচিত হয়ে হিজাযে ফিরে আসবে। পাহাড়ী বকরী যেমন পাহাড় শৃংগে আশ্রয় নেয়"
"2631","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2632","। আবদুল্লাহ ইবনু আমর (রাযিঃ) হতে বর্ণিত আছে যে"
"2633","। যাইদ ইবনু আরকাম (রাঃ) হতে বর্ণিত আছে"
"2634","। আবদুল্লাহ ইবনু মাসউদ (রাযিঃ) হতে বর্ণিত"
"2635","। আবদুল্লাহ ইবনু মাসউদ (রাযিঃ) হতে বর্ণিত"
"2636","। সাবিত ইবনুয যাহহাক (রাযিঃ) হতে বর্ণিত"
"2637","। ইবনু উমার (রাযিঃ) হতে বর্ণিত আছে যে"
"2638","। আস-সুনাবিহী (রহঃ) হতে বর্ণিত"
"2639","। আবদুল্লাহ ইবনু আমর ইবনুল আস (রাযিঃ) হতে বর্ণিত"
"2640","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত আছে যে"
"2641","। আবদুল্লাহ ইবনু আমর (রাযিঃ) হতে বর্ণিত"
"2642","। আবদুল্লাহ ইবনু আমর (রাযিঃ) হতে বর্ণিত"
"2643","। মু'আয ইবনু জাবাল (রাযিঃ) হতে বর্ণিত"
"2644","আবূ যার (রাযিঃ) হতে বর্ণিত আছে যে"
"2676","। ইরবায ইবনু সারিয়াহ (রাযিঃ) হতে বর্ণিত"
"2677","। কাসীর ইবনু আবদুল্লাহ (রাহঃ) হতে পর্যায়ক্রমে তার পিতা ও দাদার সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বিলাল ইবনুল হারিসকে বলেনঃ তুমি জেনে রাখ। তিনি বললেন"
"2678","। আনাস ইবনু মালিক (রাঃ) বলেন"
"2679","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2680","। আবূ হুরাইরাহ (রাযি.) হতে বর্ণিত আছে। রসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ অচিরেই মানুষ উটে চড়ে ইলম অন্বেষণের উদ্দেশ্যে দুনিয়া ঘুরে বেড়াবে। কিন্তু তারা মদীনার আলিমদের অপেক্ষা বিজ্ঞ আলিম আর কোথাও খুঁজে পাবে না। (য’ঈফ; মিশকাত— হাঃ নং- ২৪৬; তা’লীক 'আলা তানকীল- হাঃ নং- ১/৩৮৫; য’ঈফাহ-হাঃ নং- ৪৮৩৩) আবূ ঈসা বলেনঃ এ হাদীসটি হাসান। এটা ইবনু উয়াইনার রিওয়ায়াত। এ প্রসঙ্গে তিনি আরো বলেনঃ মাদীনার আলিম হলেন মালিক ইবনু আনাস (রাহ.)। ইসহাক ইবনু মূসা বলেনঃ আমি ইবনু উয়াইনাকে আরো বলতে শুনেছি"
"2681","। ইবনু আব্বাস (রাযি.) হতে বর্ণিত আছে। তিনি বলেন"
"2682","। কাইস ইবনু কাসীর (রহঃ) হতে বর্ণিত"
"2683","। ইয়াযীদ ইবনু সালামা (রাঃ) বলেন"
"2684","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2685","। আবূ উমামাহ্ আল-বাহিলী (রাযিঃ) হতে বর্ণিত"
"2686","। আবূ সাঈদ আল-খুদরী (রাঃ) হতে বর্ণিত আছে"
"2687","। আবূ হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"2688","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2689","। ইমরান ইবনু হুসাইন (রাযিঃ) হতে বর্ণিত আছে যে"
"2690","। আবূ সাঈদ (রাযিঃ) হতে বর্ণিত"
"2691","। উমার ইবনুল খাত্তাব (রাঃ) বলেন"
"2692","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2693","। আয়িশাহ (রাযিঃ) হতে বর্ণিত"
"2694","। আবূ উমামাহ্ (রাযিঃ) হতে বর্ণিত"
"2695","। আমর ইবনু শু'আইব (রাহঃ) হতে পর্যায়ক্রমে তার বাবা ও দাদার সূত্রে বর্ণিত"
"2696","। সাইয়্যার (রহঃ) হতে বর্ণিত"
"2697","। আসমা বিনতু ইয়াযীদ (রাযিঃ) হতে বর্ণিত"
"2698","। আনাস (রাযিঃ) হতে বর্ণিত"
"2699","। জাবির ইবনু আবদুল্লাহ (রাযিঃ) হতে বর্ণিত"
"2700","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত আছে যে"
"2701","। আয়িশাহ্ (রাযিঃ) হতে বর্ণিত"
"2702","। উসামাহ্ ইবনু যাইদ (রাযিঃ) হতে বর্ণিত"
"2703","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত আছে যে"
"2704","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত আছে যে"
"2705","। ফাযালাহ ইবনু উবাইদ (রাযিঃ) হতে বর্ণিত আছে যে"
"2706","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত আছে যে"
"2707","। আবূ যার (রাঃ) হতে বর্ণিত আছে"
"2708","। আনাস (রাযিঃ) হতে বর্ণিত আছে যে"
"2709","। সাহল ইবনু সা'দ (রাযিঃ) হতে বর্ণিত"
"2710","। কালাদাহ ইবনু হাম্বল (রহঃ) হতে বর্ণিত আছে যে"
"2711","। জাবির (রাযিঃ) হতে বর্ণিত"
"2712","। জাবির (রাযিঃ) হতে বর্ণিত আছে যে"
"2713","। জাবির (রাঃ) হতে বর্ণিত আছে"
"2714","। যাইদ ইবনু সাবিত (রাঃ) হতে বর্ণিত আছে"