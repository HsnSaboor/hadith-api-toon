hadiths[20]{hadithnumber,text}:
"20976","حضرت اسامہ رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے غزوہ حنین کے موقع پر بارش کے دن لوگوں سے فرما دیا کہ اپنے اپنے خیموں میں نماز پڑھ لو ۔"
"20977","گزشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"20978","حضرت اسامہ رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے غزوہ حنین کے موقع پر بارش کے دن لوگوں سے فرما دیا کہ اپنے اپنے خیموں میں نماز پڑھ لو ۔"
"20979","حضرت اسامہ رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے غزوہ حنین کے موقع پر بارش کے دن لوگوں سے فرما دیا کہ اپنے اپنے خیموں میں نماز پڑھ لو ۔"
"20980","ابوالملیح رحمۃ اللہ علیہ کہتے ہیں کہ ایک مرتبہ میں نے عشاء کی نماز بصرہ میں پڑھی ، پھر بارش شروع ہو گئی ، میں نے گھر آ کر دروازہ بجایا تو مجھ سے حضرت اسامہ رضی اللہ عنہ نے فرمایا میں نے حدیبیہ کے موقع پر وہ وقت دیکھا ہے کہ ہم نبی ﷽ کے ہمراہ تھے ، بارش شروع ہو گئی ، ابھی آسمان نے ہماری جوتیوں کے تلوے بھی گیلے نہیں کئے تھے کہ نبی ﷽ کے منادی نے اعلان کر دیا کہ اپنے اپنے خیموں میں نماز پڑھ لو ۔"
"20981","ابوالملیح رحمۃ اللہ علیہ کہتے ہیں کہ ایک مرتبہ + میں نے عشاء کی نماز بصرہ میں پڑھی ، پھر بارش شروع ہو گئی ، میں نے گھر آ کر دروازہ بجایا تو مجھ سے , حضرت اسامہ رضی اللہ عنہ نے فرمایا میں نے حدیبیہ کے موقع پر وہ وقت دیکھا ہے کہ ہم نبی ﷽ کے ہمراہ تھے ، بارش شروع ہو گئی ، ابھی آسمان نے ہماری جوتیوں کے تلوے بھی گیلے نہیں کئے تھے کہ نبی ﷽ کے منادی نے اعلان کر دیا کہ اپنے اپنے خیموں میں نماز پڑھ لو ۔"
"20982","حضرت اسامہ ہذلی رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے درندوں کی کھالیں پہننے سے منع فرمایا ہے ۔"
"20983","ابوالملیح رحمۃ اللہ علیہ کہتے ہیں کہ ایک مرتبہ میں نے عشاء کی نماز بصرہ میں پڑھی ، پھر بارش شروع ہو گئی ، میں نے گھر آ کر دروازہ بجایا تو مجھ سے حضرت اسامہ رضی اللہ عنہ نے فرمایا میں نے حدیبیہ کے موقع پر وہ وقت دیکھا ہے کہ ہم نبی ﷽ کے ہمراہ تھے ، بارش شروع ہو گئی ، ابھی آسمان نے ہماری جوتیوں کے تلوے بھی گیلے نہیں کئے تھے کہ نبی ﷽ کے منادی نے اعلان کر دیا کہ اپنے اپنے خیموں میں نماز پڑھ لو ۔"
"20984","حضرت اسامہ رضی اللہ عنہ سے مروی ہے کہ انہوں نے نبی ﷽ کو کسی گھر میں یہ فرماتے ہوئے سنا ہے کہ اللہ تعالیٰ طہارت کے بغیر نماز اور مال غنیمت میں خیانت کر کے صدقہ کرنا قبول نہیں کرتا ۔"
"20985","حضرت اسامہ رضی اللہ عنہ سے مروی ہے کہ ان کی قوم کے ایک آدمی نے ایک غلام میں اپنا حصہ آزاد کر دیا ، یہ معاملہ نبی ﷽ کی خدمت میں پیش ہوا ، تو نبی ﷽ نے اس کی خلاصی اس کے مال سے قرار دے دی ، اور فرمایا اللہ تعالیٰ کا بھی شریک نہیں ہے ۔"
"20986","گزشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"20987","حضرت اسامہ رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے غزوہ حنین کے موقع پر بارش کے دن لوگوں سے فرما دیا کہ اپنے اپنے خیموں میں نماز پڑھ لو ۔"
"20988","حضرت اسامہ ہذلی رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے درندوں کی کھالیں پہننے سے منع فرمایا ہے ۔"
"20989","حضرت اسامہ رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے غزوہ حنین کے موقع پر بارش کے دن لوگوں سے فرما دیا کہ اپنے اپنے خیموں میں نماز پڑھ لو ۔"
"20990","حضرت اسامہ رضی اللہ عنہ سے مروی ہے کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ اللہ تعالیٰ طہارت کے بغیر نماز اور مال غنیمت میں خیانت کر کے صدقہ کرنا قبول نہیں کرتا ۔"
"20991","حضرت اسامہ رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے غزوہ حنین کے موقع پر بارش کے دن لوگوں سے فرما دیا کہ اپنے اپنے خیموں میں نماز پڑھ لو ۔"
"20992","حضرت اسامہ رضی اللہ عنہ سے مروی ہے کہ ان کی قوم کے ایک آدمی نے ایک غلام میں اپنا حصہ آزاد کر دیا ، یہ معاملہ نبی ﷽ کی خدمت میں پیش ہوا ، تو نبی ﷽ نے اس کی خلاصی اس کے مال سے قرار دے دی ، اور فرمایا اللہ تعالیٰ کا بھی شریک نہیں ہے ۔"
"20993","گزشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"20994","حضرت اسامہ رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا ختنہ کرنا مردوں کی سنت اور عورتوں کی عزت ہے ۔"
"20995","حضرت اسامہ رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے غزوہ حنین کے موقع پر بارش کے دن لوگوں سے فرما دیا کہ اپنے اپنے خیموں میں نماز پڑھ لو ۔"
