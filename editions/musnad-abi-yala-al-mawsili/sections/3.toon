hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"1201","228 - (  1202  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  ابْنُ أَبِي لَيْلَى ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَا تَحِلُّ الصَّدَقَةُ لِغَنِيٍّ إِلَّا لِثَلَاثَةٍ : غَازٍ فِي  سَبِيلِ  اللهِ  ، وَابْنِ السَّبِيلِ ، أَوْ رَجُلٍ كَانَ         [2/414]      لَهُ جَارٌ فَتُصُدِّقَ عَلَيْهِ ، فَأَهْدَى لَهُ  .","","Musnad Abi Ya'la al-Mawsili 1202","","أبو سعيد الخدري عن عطية بن سعد العوفي عن محمد بن عبد الرحمن بن أبي ليلى عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1202","229 - (  1203  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  إِسْمَاعِيلَ بْنِ رَجَاءٍ ،  عَنْ  أَبِيهِ  ،  وَعَنْ  قَيْسِ بْنِ مُسْلِمٍ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ، كِلَاهُمَا  عَنْ  أَبِي سَعِيدٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ رَأَى مُنْكَرًا فَاسْتَطَاعَ أَنْ يُغَيِّرَهُ بِيَدِهِ فَلْيَفْعَلْ  ، فَإِنْ لَمْ يَسْتَطِعْ بِيَدِهِ فَبِلِسَانِهِ ، فَإِنْ لَمْ يَسْتَطِعْ بِلِسَانِهِ فَبِقَلْبِهِ ، وَذَلِكَ أَضْعَفُ الْإِيمَانِ  .","","Musnad Abi Ya'la al-Mawsili 1203","","أبو سعيد الخدري عن طارق بن شهاب الأحمسي عن قيس بن مسلم الجدلي عن رجاء بن ربيعة الزبيدي عن إسماعيل بن رجاء الزبيدي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1203","230 - (  1204  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  الْأَعْمَشِ  عَنْ  أَبِي صَالِحٍ :  عَنْ  أَبِي سَعِيدٍ قَالَ :  احْتَجَّ  آدَمُ  وَمُوسَى  فَقَالَ  مُوسَى  : يَا         [2/415]      آدَمُ  ، خَلَقَكَ اللهُ بِيَدِهِ وَنَفَخَ فِيكَ مِنْ رُوحِهِ وَأَمَرَ الْمَلَائِكَةَ فَسَجَدُوا لَكَ  ، وَأَسْكَنَكَ جَنَّتَهُ  فَأَغْوَيْتَ  النَّاسَ وَأَخْرَجْتَهُمْ مِنَ الْجَنَّةِ ؟ فَقَالَ  آدَمُ  : يَا  مُوسَى  اصْطَفَاكَ اللهُ بِكَلِمَتِهِ وَأَنْزَلَ عَلَيْكَ التَّوْرَاةَ وَفَعَلَ بِكَ وَفَعَلَ ، تَلُومُنِي عَلَى أَمْرٍ قَدْ قَدَّرَهُ اللهُ عَلَيَّ قَبْلَ أَنْ يَخْلُقَنِي ؟ قَالَ : فَحَجَّ  آدَمُ  مُوسَى  عَلَيْهِمَا السَّلَامُ ""  .","","Musnad Abi Ya'la al-Mawsili 1204","","أبو سعيد الخدري عن ذكوان السمان عن الأعمش عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1204","231 - (  1205  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  مِسْعَرٌ ،  عَنْ  زَيْدٍ الْعَمِّيِّ ،  عَنْ  أَبِي الصِّدِّيقِ ،  عَنْ  أَبِي سَعِيدٍ  "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أُتِيَ  بِرَجُلٍ  - قَالَ :  أَظُنُّهُ فِي شَرَابٍ  -  فَضَرَبَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَعْلَيْنِ أَرْبَعِينَ  "" .","","Musnad Abi Ya'la al-Mawsili 1205","","أبو سعيد الخدري عن بكر بن عمرو الناجي عن زيد بن الحواري العمي عن مسعر بن كدام عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1205","232 - (  1206  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  ابْنُ أَبِي لَيْلَى ،  عَنْ  عَطِيَّةَ ،         [2/416]      عَنْ  أَبِي سَعِيدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  ذَكَاةُ  الْجَنِينِ  ذَكَاةُ  أُمِّهِ  .","","Musnad Abi Ya'la al-Mawsili 1206","","أبو سعيد الخدري عن عطية بن سعد العوفي عن محمد بن عبد الرحمن بن أبي ليلى عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1206","233 - (  1207  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فِي قَوْلِهِ :         {      وَكَذَلِكَ جَعَلْنَاكُمْ أُمَّةً وَسَطًا         }      قَالَ : "" عَدْلًا  .","","Musnad Abi Ya'la al-Mawsili 1207","","أبو سعيد الخدري عن ذكوان السمان عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1207","234 - (  1208  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْوِتْرُ  بِلَيْلٍ  .","","Musnad Abi Ya'la al-Mawsili 1208","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن يحيى بن أبي كثير عن همام بن يحيى بن دينار عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1208","235 - (  1209  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  زَيْدُ بْنُ أَسْلَمَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  حَدِّثُوا         [2/417]      عَنِّي وَلَا حَرَجَ ، حَدِّثُوا عَنِّي وَلَا تَكْذِبُوا عَلَيَّ  ، وَمَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا فَقَدْ تَبَوَّأَ مَقْعَدَهُ مِنَ النَّارِ ، وَحَدِّثُوا عَنْ  بَنِي إِسْرَائِيلَ  وَلَا  حَرَجَ  .","","Musnad Abi Ya'la al-Mawsili 1209","","أبو سعيد الخدري عن عطاء بن يسار الهلالي عن زيد بن أسلم عن همام بن يحيى بن دينار عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1209","236 - (  1210  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ قَالَ : ""  أَمَرَنَا نَبِيُّنَا - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ نَقْرَأَ بِفَاتِحَةِ الْكِتَابِ         [2/418]      وَمَا تَيَسَّرَ  "" .","","Musnad Abi Ya'la al-Mawsili 1210","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1210","237 - (  1211  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  قَتَادَةُ ،  حَدَّثَنِي  أَرْبَعَةُ رِجَالٍ ،  عَنْ  أَبِي سَعِيدٍ ،  وَخَمْسُ نِسْوَةٍ  ،  عَنْ  عَائِشَةَ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ نَبِيذِ  الْجَرِّ  .         [2/419]","","Musnad Abi Ya'la al-Mawsili 1211","","عائشة بنت أبي بكر الصديق عن وخمس نسوة عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1211","238 - (  1212  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  حَدَّثَنَا  الْمُسْتَمِرُّ بْنُ الرَّيَّانِ الْإِيَادِيُّ ،  حَدَّثَنَا  أَبُو نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَا يَمْنَعَنَّ أَحَدَكُمْ مَخَافَةُ النَّاسِ أَنْ يَتَكَلَّمَ بِالْحَقِّ إِذَا رَآهُ وَعَلِمَهُ  ، أَوْ رَآهُ وَسَمِعَهُ  .","","Musnad Abi Ya'la al-Mawsili 1212","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن المستمر بن الريان الإيادي عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1212","239 - (  1213  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  الْمُسْتَمِرُّ ،  حَدَّثَنَا  أَبُو نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لِكُلِّ غَادِرٍ  لِوَاءٌ  يَوْمَ الْقِيَامَةِ يُرْفَعُ لَهُ بِقَدْرِ غَدْرَتِهِ  ، أَلَا وَلَا غَادِرَ أَعْظَمُ غَدْرًا مِنْ أَمِيرِ عَامَّةٍ  .         [2/420]","","Musnad Abi Ya'la al-Mawsili 1213","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن المستمر بن الريان الإيادي عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1213","240 - (  1214  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  حَدَّثَنِي  أَبِي ،  حَدَّثَنَا  الْجُرَيْرِيُّ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  قَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى نَهَرٍ مِنْ مَاءِ السَّمَاءِ وَالنَّاسُ صِيَامٌ فِي يَوْمٍ صَائِفٍ ، وَهُمْ مُشَاةٌ وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى بَغْلَتِهِ ، فَقَالَ : "" اشْرَبُوا أَيُّهَا النَّاسُ ، قَالُوا : نَشْرَبُ يَا رَسُولَ اللهِ ، قَالَ : فَقَالَ :  إِنِّي لَسْتُ مِثْلَكُمْ ، إِنِّي أَيْسَرُ مِنْكُمْ ، إِنِّي رَاكِبٌ  . قَالَ : فَأَبَوْا ، قَالَ : فَثَنَى نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَخِذَهُ فَنَزَلَ فَشَرِبَ وَشَرِبَ النَّاسُ ، وَمَا كَانَ يُرِيدُ أَنْ يَشْرَبَهُ  .","","Musnad Abi Ya'la al-Mawsili 1214","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن سعيد بن إياس الجريري عن عبد الوارث بن سعيد بن ذكوان عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1214","241 - (  1215  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  دَاوُدُ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ ،  أَنَّ  مَاعِزَ بْنَ مَالِكٍ  أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : "" يَا رَسُولَ اللهِ ، إِنِّي أَصَبْتُ  حَدًّا  فَأَقِمْهُ عَلَيَّ ، قَالَ : فَرَدَّهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  ثَلَاثَ مَرَّاتٍ ، وَإِمَّا أَرْبَعَ مَرَّاتٍ  ، فَسَأَلَ عَنْهُ : "" أَبِهِ بَأْسٌ ؟ "" قَالُوا : لَا يَا رَسُولَ اللهِ ، إِلَّا أَنَّهُ أَصَابَ  حَدًّا  لَا يَرَى أَنَّهُ يُخْرِجُهُ مِنْهُ إِلَّا  الْحَدُّ  . قَالَ : فَأَمَرَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَانْطَلَقْنَا بِهِ إِلَى  بَقِيعِ الْغَرْقَدِ  ، فَلَمْ نَحْفِرْ لَهُ وَلَمْ نُوثِقْهُ ، فَرَمَيْنَاهُ بِالْخَزَفِ وَالْعِظَامِ ، فَشَقَّ ذَلِكَ عَلَيْهِ ،         [2/421]      فَسَعَى إِلَى  الْحَرَّةِ  ، فَتَبِعْنَاهُ فَرَمَيْنَاهُ بِجَلَامِيدِ  الْحَرَّةِ  حَتَّى  سَكَتَ ،  ثُمَّ قَامَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَطِيبًا ، فَقَالَ :  إِذَا خَرَجْنَا فِي  سَبِيلِ  اللهِ تَخَلَّفَ أَحَدُهُمْ لَهُ نَبِيبٌ  كَنَبِيبِ  التَّيْسِ  ، أَمَا إِنِّي لَا أُوتَى مِنْ أُولَئِكَ بِأَحَدٍ إِلَّا نَكَّلْتُ بِهِ "" . قَالَ : زَعَمَ فَلَمْ يَلْعَنْهُ وَلَمْ يَسْتَغْفِرْ لَهُ  .","","Musnad Abi Ya'la al-Mawsili 1215","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن داود بن أبي هند عن عبد الوارث بن سعيد بن ذكوان عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1215","242 - (  1216  ) -  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى الْمَوْصِلِيُّ ،  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  دَاوُدُ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ ، وَجَابِرِ بْنِ عَبْدِ اللهِ ، قَالَا : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  يَكُونُ فِي آخِرِ الزَّمَانِ  خَلِيفَةٌ  يَقْسِمُ الْمَالَ وَلَا يَعُدُّهُ  .         [2/422]","","Musnad Abi Ya'la al-Mawsili 1216","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن داود بن أبي هند عن عبد الوارث بن سعيد بن ذكوان عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1216","243 - (  1217  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  شُعْبَةُ ،  حَدَّثَنَا  عَبْدُ اللهِ الزَّعْفَرَانِيُّ ،  عَنْ  أَبِي الْمُتَوَكِّلِ النَّاجِيِّ ،  عَنْ  أَبِي سَعِيدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  الْفِضَّةُ بِالْفِضَّةِ ، وَالذَّهَبُ بِالذَّهَبِ ، سَوَاءٌ بِسَوَاءٍ  ، مِثْلًا بِمِثْلٍ ، مَنْ زَادَ أَوِ اسْتَزَادَ فَقَدْ  أَرْبَى  ، وَالْآخِذُ وَالْمُعْطِي سَوَاءٌ  .","","Musnad Abi Ya'la al-Mawsili 1217","","أبو سعيد الخدري عن علي بن داود الناجي عن عبد الله الزعفراني عن شعبة بن الحجاج عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1217","244 - (  1218  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحُ بْنُ أَسْلَمَ ،  حَدَّثَنِي  حَمَّادُ بْنُ سَلَمَةَ ،  أَخْبَرَنَا  سَعِيدٌ الْجُرَيْرِيُّ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ""  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَأَلَ  ابْنَ صَائِدٍ  عَنْ تُرْبَةِ الْجَنَّةِ ؟  فَقَالَ : دَرْمَكَةٌ بَيْضَاءُ ، مِسْكٌ خَالِصٌ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" صَدَقَ  "" .         [2/423]","","Musnad Abi Ya'la al-Mawsili 1218","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن سعيد بن إياس الجريري عن حماد بن سلمة عن روح بن أسلم الباهلي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1218","245 - (  1219  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  رَوْحُ بْنُ أَسْلَمَ ،  أَخْبَرَنَا  وُهَيْبٌ ،  عَنْ  عَمْرِو بْنِ يَحْيَى ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا دَخَلَ أَهْلُ الْجَنَّةِ الْجَنَّةَ ، وَأَهْلُ النَّارِ النَّارَ ، قَالَ اللهُ تَبَارَكَ وَتَعَالَى  : مَنْ كَانَ فِي قَلْبِهِ  مِثْقَالُ  حَبَّةٍ مِنْ خَيْرٍ فَأَخْرِجُوهُ مِنَ النَّارِ ، قَالَ : فَيَخْرُجُونَ قَدِ  امْتَحَشُوا  وَصَارُوا حُمَمًا ، فَيُلْقَوْنَ فِي نَهَرٍ ، يُقَالُ لَهُ : نَهَرُ الْحَيَاةِ ، فَيَنْبُتُونَ كَمَا تَنْبُتُ  الْحِبَّةُ  فِي  حَمِيلِ  السَّيْلِ ، أَوْ قَالَ : فِي  حَمِيلِ  الشَّيْحِ  - شَكَّ  أَبُو عَمْرٍو  - فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَلَمْ يَرَوْا إِلَيْهَا تَنْبُتُ صَفْرَاءَ مُلْتَوِيَةً ؟  .","","Musnad Abi Ya'la al-Mawsili 1219","","أبو سعيد الخدري عن يحيى بن عمارة المازني عن عمرو بن يحيى بن عمارة المازني عن وهيب بن خالد الكرابيسي عن روح بن أسلم الباهلي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1219","246 - (  1220  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  رَوْحُ بْنُ أَسْلَمَ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  أَبِي نَضْرَةَ ،         [2/424]      عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ""  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِابْنِ صَائِدٍ  : "" مَا تَرَى ؟ "" قَالَ : أَرَى عَرْشًا عَلَى مَاءِ الْبَحْرِ وَحَوْلَهُ الْحَيَّاتُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  رَأَى عَرْشَ إِبْلِيسَ  .","","Musnad Abi Ya'la al-Mawsili 1220","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن علي بن زيد بن جدعان عن حماد بن سلمة عن روح بن أسلم الباهلي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1220","247 - (  1221  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ أَبُو أَحْمَدَ ،  أَخْبَرَنَا  كَثِيرُ بْنُ زَيْدٍ ،  عَنْ  رُبَيْحِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي سَعِيدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَا وُضُوءَ لِمَنْ لَمْ يَذْكُرِ اسْمَ اللهِ عَلَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 1221","","أبو سعيد الخدري عن عبد الرحمن بن أبي سعيد الخدري عن ربيح بن عبد الرحمن الخدري عن كثير بن زيد السهمي عن محمد بن عبد الله بن الزبير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1221","248 - (  1222  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  هَمَّامُ بْنُ يَحْيَى ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي عِيسَى الْأُسْوَارِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  عُودُوا الْمَرْضَى وَاتَّبِعُوا الْجَنَائِزَ تُذَكِّرْكُمُ الْآخِرَةَ  .         [2/425]","","Musnad Abi Ya'la al-Mawsili 1222","","أبو سعيد الخدري عن أبو عيسى الأسواري عن قتادة بن دعامة عن همام بن يحيى بن دينار عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1222","249 - (  1223  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي الْحَكَمِ ،  حَدَّثَنِي  أَخِي  ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ  الْجَرِّ  ،  وَالدُّبَّاءِ  ،  وَالْمُزَفَّتِ  ، وَنَهَى عَنِ الْبُسْرِ وَالتَّمْرِ  .","","Musnad Abi Ya'la al-Mawsili 1223","","أبو سعيد الخدري عن مالك بن الحارث السلمي عن عمران بن الحارث السلمي عن سلمة بن كهيل الحضرمي عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1223","250 - (  1224  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         {      وَهُمْ فِي غَفْلَةٍ         }      قَالَ : "" فِي الدُّنْيَا  "" .","","Musnad Abi Ya'la al-Mawsili 1224","","أبو سعيد الخدري عن ذكوان السمان عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1224","251 - (  1225  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ يُوسُفَ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَطَاءِ بْنِ يَزِيدَ اللَّيْثِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : "" أَيُّ النَّاسِ خَيْرٌ ؟ قَالَ :  رَجُلٌ جَاهَدَ بِنَفْسِهِ وَمَالِهِ فِي  سَبِيلِ  اللهِ  ، وَرَجُلٌ -  يَعْنِي فِي شِعْبٍ مِنَ الشِّعَابِ  - يَعْبُدُ رَبَّهُ وَيَدَعُ النَّاسَ مِنْ شَرِّهِ  .         [2/426]","","Musnad Abi Ya'la al-Mawsili 1225","","أبو سعيد الخدري عن عطاء بن يزيد الجندعي عن الزهري عن أبو عمرو الأوزاعي عن محمد بن يوسف الفريابي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1225","252 - (  1226  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ  التَّيْمِيِّ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ ،  أَنَّ  رَجُلًا  أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِتَمْرٍ أَنْكَرَهُ ، فَقَالَ : "" أَنَّى لَكَ هَذَا ؟ "" فَقَالَ : أَخَذْتُهُ بِصَاعَيْنِ مِنْ تَمْرٍ . فَقَالَ :  أَضْعَفْتَ وَأَرْبَيْتَ . أَوْ : أَرْبَيْتَ وَأَضْعَفْتَ  .         [2/427]","","Musnad Abi Ya'la al-Mawsili 1226","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن سليمان بن طرخان عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1226","253 - (  1227  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ  ابْنِ عَجْلَانَ ،  حَدَّثَنَا  عِيَاضُ بْنُ عَبْدِ اللهِ ،  عَنْ  أَبِي سَعِيدٍ قَالَ :  لَا أُخْرِجُ أَبَدًا إِلَّا صَاعًا ، إِنَّا كُنَّا نُخْرِجُ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَاعًا مِنْ تَمْرٍ  أَوْ شَعِيرٍ أَوْ أَقِطٍ أَوْ زَبِيبٍ  .         [2/428]","","Musnad Abi Ya'la al-Mawsili 1227","","أبو سعيد الخدري عن عياض بن عبد الله بن سعد العامري عن محمد بن عجلان عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1227","254 - (  1228  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  حَدَّثَنِي  أَبِي  قَالَ :  سَمِعْتُ  يُونُسَ  يُحَدِّثُ عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا بُعِثَ مِنْ نَبِيٍّ وَلَا اسْتُخْلِفَ مِنْ  خَلِيفَةٍ  ، إِلَّا كَانَتْ لَهُ  بِطَانَتَانِ  :  بِطَانَةٌ  تَأْمُرُهُ بِالْخَيْرِ وَتَحُضُّهُ عَلَيْهِ ،  وَبِطَانَةٌ  تَأْمُرُهُ بِالشَّرِّ وَتَحُضُّهُ عَلَيْهِ ، وَالْمَعْصُومُ مَنْ  عَصَمَ  اللهُ  .","","Musnad Abi Ya'la al-Mawsili 1228","","أبو سعيد الخدري عن أبو سلمة بن عبد الرحمن عن الزهري عن يونس بن يزيدالأيلي عن جرير بن حازم عن وهب بن جرير بن حازم عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1228","255 - (  1229  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي سَلَمَةَ  قَالَ :  سَمِعْتُ  أَبَا نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ كَذَبَ عَلَيَّ         [2/429]      مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .  كذا في طبعة دار المأمون للتراث ، والصواب ( أبي مسلمة ) ، وينظر مصادر التخريج ، وقال ابن حجر في إتحاف المهرة : ( ثنا شعبة , عن أبي مسلمة ، أنه سمع أبا نضرة , بهذا ) ، والله أعلم.","","Musnad Abi Ya'la al-Mawsili 1229","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن سعيد بن يزيد الطاحي عن شعبة بن الحجاج عن عثمان بن عمر بن فارس عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1229","256 - (  1230  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  حَدَّثَنَا  أَبِي  قَالَ :  سَمِعْتُ  يُونُسَ  يُحَدِّثُ عَنِ  الزُّهْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَيْرِيزٍ ،  عَنْ  أَبِي سَعِيدٍ قَالَ :  سَأَلَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَجُلٌ مِنَ الْأَنْصَارِ  عَنِ  الْعَزْلِ ،  فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا عَلَيْكُمْ أَنْ لَا تَفْعَلُوا ، فَإِنَّهُ لَيْسَتْ  نَسَمَةٌ  كَتَبَ اللهُ أَنْ تَخْرُجَ إِلَّا هِيَ خَارِجَةٌ  .","","Musnad Abi Ya'la al-Mawsili 1230","","أبو سعيد الخدري عن عبد الله بن محيريز الجمحي عن الزهري عن يونس بن يزيدالأيلي عن جرير بن حازم عن وهب بن جرير بن حازم عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1230","257 - (  1231  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  هُشَيْمُ بْنُ بَشِيرٍ ،  حَدَّثَنَا  عُثْمَانُ الْبَتِّيُّ ،  عَنْ  أَبِي الْخَلِيلِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  أَصَبْنَا  يَوْمَ أَوْطَاسٍ  سَبَايَا ، وَلَهُنَّ أَزْوَاجٌ فِي قَوْمِهِنَّ ، فَذَكَرُوا ذَلِكَ لِلنَّبِيِّ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : "" فَنَزَلَتْ :         {      وَالْمُحْصَنَاتُ مِنَ النِّسَاءِ إِلا مَا مَلَكَتْ أَيْمَانُكُمْ         }      .","","Musnad Abi Ya'la al-Mawsili 1231","","أبو سعيد الخدري عن صالح بن أبي مريم الضبعي عن عثمان بن مسلم عن هشيم بن بشير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1231","258 - (  1232  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  شُعْبَةُ ،  عَنْ  خُلَيْدِ بْنِ جَعْفَرٍ ، وَالْمُسْتَمِرِّ بْنِ الرَّيَّانِ ، قَالَا :  سَمِعْنَا         [2/430]      أَبَا نَضْرَةَ  يُحَدِّثُ عَنْ  أَبِي سَعِيدٍ ،  أَنَّ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَكَرَ امْرَأَةً مِنْ  بَنِي إِسْرَائِيلَ  حَشَتْ خَاتَمَهَا مِسْكًا  ، وَالْمِسْكُ أَطْيَبُ مِنَ الطِّيبِ  .","","Musnad Abi Ya'la al-Mawsili 1232","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن المستمر بن الريان الإيادي عن شعبة بن الحجاج عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1232","259 - (  1233  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ حُمْرَانَ قَالَ عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ :  أَخْبَرَنَا  عَنِ  الْأَسْوَدِ بْنِ الْعَلَاءِ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي سَعِيدٍ قَالَ :  لَمَّا خَرَجَتِ الْحَرُورِيَّةُ جِئْنَا  أَبَا سَعِيدٍ الْخُدْرِيَّ  ، فَقُلْنَا : أَسَمِعْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَذْكُرُ الْحَرُورِيَّةَ ؟ فَقَالَ : لَا وَلَكِنْ سَمِعْتُهُ يَقُولُ :  يُوشِكُ  أَنْ يَأْتِيَ قَوْمٌ تَحْقِرُونَ صَلَاتَكُمْ مَعَ صَلَاتِهِمْ  ، وَأَعْمَالَكُمْ مَعَ أَعْمَالِهِمْ ،  يَمْرُقُونَ  مِنَ الْإِسْلَامِ كَمَا  يَمْرُقُ  السَّهْمُ مِنَ  الرَّمِيَّةِ ،  حَتَّى يَأْخُذَهُ صَاحِبُهُ فَيَنْظُرَ إِلَى نَصْلِهِ فَلَا         [2/431]      يَرَى شَيْئًا ، ثُمَّ يَنْظُرَ إِلَى  رُعْظِهِ  فَلَا يَرَى شَيْئًا ، ثُمَّ يَنْظُرَ إِلَى قِدْحِهِ فَلَا يَرَى فِيهِ شَيْئًا ، ثُمَّ يَنْظُرَ إِلَى  قُذَذِهِ  هَلْ يَرَى فِيهِ شَيْئًا أَمْ لَا ؟  .","","Musnad Abi Ya'la al-Mawsili 1233","","أبو سعيد الخدري عن أبو سلمة بن عبد الرحمن عن الأسود بن العلاء الثقفي عن عبد الحميد بن جعفر الأوسي عن عبد الله بن حمران مولى عثمان بن عفان عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1233","260 - (  1234  ) -  حَدَّثَنَا  زُهَيْرٌ  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  فُلَيْحُ بْنُ سُلَيْمَانَ  عَنْ  سَعِيدِ بْنِ الْحَارِثِ قَالَ :  اشْتَكَى  أَبُو هُرَيْرَةَ  وَغُلِبَ . قَالَ : فَصَلَّى أَبُو سَعِيدٍ الْخُدْرِيُّ ، فَجَهَرَ بِالتَّكْبِيرِ حِينَ افْتَتَحَ وَحِينَ رَكَعَ ، وَبَعْدَ أَنْ قَالَ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، وَحِينَ رَفَعَ رَأْسَهُ مِنَ السُّجُودِ ، وَحِينَ سَجَدَ وَحِينَ رَفَعَ وَحِينَ قَامَ مِنَ الرَّكْعَتَيْنِ ، حَتَّى صَلَّى صَلَاتَهُ عَلَى ذَلِكَ ، فَلَمَّا انْصَرَفَ قِيلَ لَهُ : قَدِ اخْتَلَفَ النَّاسُ عَلَى صَلَاتِكَ ، فَقَامَ حَتَّى قَامَ عِنْدَ الْمِنْبَرِ  فَقَالَ  :  يَا أَيُّهَا النَّاسُ إِنِّي وَاللهِ مَا  أُبَالِي  اخْتَلَفَتْ صَلَاتُكُمْ أَوْ لَمْ تَخْتَلِفْ  ؛ إِنِّي رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - هَكَذَا يُصَلِّي  .","","Musnad Abi Ya'la al-Mawsili 1234","","أبو سعيد الخدري عن سعيد بن الحارث بن أبي سعيد الأنصاري عن فليح بن سليمان عن يونس بن محمد بن مسلم البغدادي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1234","261 - (  1235  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  عَنْ  زُهَيْرِ بْنِ مُحَمَّدٍ ،  عَنْ  شَرِيكِ بْنِ عَبْدِ اللهِ بْنِ أَبِي نَمِرٍ ،  عَنْ         [2/432]      عَبْدِ الرَّحْمَنِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  أَبِيهِ  ، وَعَمِّهِ قَتَادَةَ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  كُلُوا لُحُومَ الْأَضَاحِيِّ وَادَّخِرُوا  .","","Musnad Abi Ya'la al-Mawsili 1235","","قتادة بن النعمان ذو العينين عن عبد الرحمن بن أبي سعيد الخدري عن شريك بن عبد الله بن أبي نمر الكناني عن زهير بن محمد التميمي عن أبو عامر العقدي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1235","262 - (  1236  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو عَامِرٍ ،  عَنْ  زُهَيْرٍ ،  عَنْ  شَرِيكٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  أَبِيهِ  قَالَ :  خَرَجْنَا مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ الِاثْنَيْنِ إِلَى  قُبَاءَ  ، فَمَرَّ بِنَا فِي  بَنِي سَالِمٍ  ، فَوَقَفَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى بَابِ  ابْنِ عِتْبَانَ  فَصَاحَ بِهِ وَهُوَ عَلَى بَطْنِ امْرَأَتِهِ ، فَخَرَجَ وَهُوَ يَجُرُّ إِزَارَهُ ، فَلَمَّا رَآهُ قَالَ : "" أَعْجَلْنَا الرَّجُلَ ، فَقَالَ  ابْنُ عِتْبَانَ  : يَا رَسُولَ اللهِ ، أَرَأَيْتَ الرَّجُلَ إِذَا أُعْجِلَ عَنِ امْرَأَتِهِ فَلَمْ يُمْنِ مَاذَا عَلَيْهِ ؟ قَالَ :  إِنَّمَا الْمَاءُ مِنَ الْمَاءِ  .         [2/433]","","Musnad Abi Ya'la al-Mawsili 1236","","أبو سعيد الخدري عن عبد الرحمن بن أبي سعيد الخدري عن شريك بن عبد الله بن أبي نمر الكناني عن زهير بن محمد التميمي عن أبو عامر العقدي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1236","263 - (  1237  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  عَنْ  زُهَيْرِ بْنِ مُحَمَّدٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أَبِي هُرَيْرَةَ وَأَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَا يُصِيبُ الْمَرْءَ الْمُؤْمِنَ مِنْ نَصَبٍ ، وَلَا وَصَبٍ  ، وَلَا هَمٍّ ، وَلَا  حَزَنٍ  ، وَلَا غَمٍّ ، وَلَا أَذًى ، حَتَّى  الشَّوْكَةُ  يُشَاكُهَا ،  إِلَّا كَفَّرَ اللهُ بِهَا مِنْ خَطَايَاهُ  .","","Musnad Abi Ya'la al-Mawsili 1237","","أبو سعيد الخدري عن عطاء بن يسار الهلالي عن محمد بن عمرو بن حلحلة الديلي عن زهير بن محمد التميمي عن أبو عامر العقدي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1237","264 - (  1238  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو عَامِرٍ ،  عَنْ  زُهَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي سَعِيدٍ الْخُدْرِيِّ ،         [2/434]      عَنْ  أَبِيهِ  قَالَ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ عَلَى هَذَا الْمِنْبَرِ :  مَا بَالُ رِجَالٍ يَقُولُونَ : إِنَّ رَحِمَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَا تَنْفَعُ قَوْمَهُ  ؟ بَلَى وَاللهِ إِنَّ رَحِمِي مَوْصُولَةٌ فِي الدُّنْيَا وَالْآخِرَةِ ، وَإِنِّي يَا أَيُّهَا النَّاسُ  فَرَطٌ  لَكُمْ عَلَى الْحَوْضِ ، فَإِذَا جِئْتُمْ قَالَ رَجُلٌ : يَا رَسُولَ اللهِ ، أَنَا فُلَانُ ابْنُ فُلَانٍ ، وَقَالَ آخَرُ : أَنَا فُلَانُ ابْنُ فُلَانٍ ، فَأَقُولُ : أَمَّا النَّسَبُ فَقَدْ عَرَفْتُهُ ، وَلَكِنَّكُمْ أَحْدَثْتُمْ بَعْدِي وَارْتَدَدْتُمُ  الْقَهْقَرَى  .","","Musnad Abi Ya'la al-Mawsili 1238","","أبو سعيد الخدري عن عبد الرحمن بن أبي سعيد الخدري عن عبد الله بن محمد بن عقيل بن أبي طالب عن زهير بن محمد التميمي عن أبو عامر العقدي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1238","265 - (  1239  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  عَنْ  سُلَيْمَانَ بْنِ بِلَالٍ ،  عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ ،  عَنْ  يَحْيَى بْنِ عُمَارَةَ ،  عَنْ  أَبِي سَعِيدٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَقِّنُوا مَوْتَاكُمْ : لَا إِلَهَ إِلَّا اللهُ  .","","Musnad Abi Ya'la al-Mawsili 1239","","أبو سعيد الخدري عن يحيى بن عمارة المازني عن عمارة بن غزية عن سليمان بن بلال القرشي عن أبو عامر العقدي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1239","266 - (  1240  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو النَّضْرِ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  أَبِي صَالِحٍ قَالَ :         [2/435]      بَيْنَمَا أَبُو سَعِيدٍ الْخُدْرِيُّ يَوْمَ الْجُمُعَةِ يُصَلِّي إِلَى شَيْءٍ يَسْتُرُهُ مِنَ النَّاسِ ، إِذْ جَاءَ شَابٌّ  مِنْ  بَنِي مُعَيْطٍ  ، فَأَرَادَ أَنْ يَجْتَازَ بَيْنَ يَدَيْهِ ، قَالَ : فَدَفَعَهُ  أَبُو سَعِيدٍ  فِي نَحْرِهِ ، فَلَمْ يَجِدْ مَسَاغًا إِلَّا مَا بَيْنَ يَدَيْ  أَبِي سَعِيدٍ الْخُدْرِيِّ  ، فَعَادَ فَدَفَعَهُ فِي نَحْرِهِ أَشَدَّ مِنَ الدَّفْعَةِ الْأُولَى ، قَالَ :  فَمَثَلَ  قَائِمًا ، ثُمَّ نَالَ مِنْ  أَبِي سَعِيدٍ .  قَالَ : فَدَخَلَ  أَبُو سَعِيدٍ  عَلَى  مَرْوَانَ  ، فَقَالَ : مَا لَكَ وَلِابْنِ أَخِيكَ جَاءَ يَشْتَكِيكَ ؟  فَقَالَ  أَبُو سَعِيدٍ الْخُدْرِيُّ  : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا صَلَّى أَحَدُكُمْ فَأَرَادَ أَحَدٌ أَنْ يَجْتَازَ بَيْنَ يَدَيْهِ فَلْيَدْفَعْ فِي نَحْرِهِ  ، فَإِنْ أَبَى فَلْيُقَاتِلْهُ فَإِنَّمَا هُوَ شَيْطَانٌ  .         [2/436]","","Musnad Abi Ya'la al-Mawsili 1240","","أبو سعيد الخدري عن ذكوان السمان عن حميد بن هلال العدوي عن سليمان بن المغيرة القيسي عن هاشم بن القاسم بن مسلم عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1240","267 - (  1241  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنِ  الدَّسْتُوَائِيِّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  عِيَاضٍ قَالَ :  قُلْتُ  لِأَبِي سَعِيدٍ الْخُدْرِيِّ : أَحَدُنَا يُصَلِّي فَلَا يَدْرِي كَمْ صَلَّى ، فَقَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا صَلَّى أَحَدُكُمْ فَلَمْ يَدْرِ كَمْ صَلَّى ، فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ  ، وَإِذَا جَاءَ أَحَدَكُمُ الشَّيْطَانُ وَهُوَ فِي صَلَاتِهِ ، فَقَالَ : إِنَّكَ قَدْ أَحْدَثْتَ ، فَلْيَقُلْ : كَذَبْتَ ، إِلَّا مَا وَجَدَ رِيحَهُ بِأَنْفِهِ أَوْ سَمِعَ صَوْتًا بِأُذُنِهِ  .","","Musnad Abi Ya'la al-Mawsili 1241","","أبو سعيد الخدري عن عياض بن هلال الأنصاري عن يحيى بن أبي كثير عن هشام الدستوائي عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1241","268 - (  1242  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  هِلَالِ بْنِ أَبِي مَيْمُونَةَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  إِنَّ أَخْوَفَ مَا أَخَافُ عَلَيْكُمْ مَا يُخْرِجُ اللهُ لَكُمْ مِنْ زِينَةِ الدُّنْيَا وَزَهْرَتِهَا  . فَقَالَ لَهُ  رَجُلٌ  : يَا رَسُولَ اللهِ أَوَيَأْتِي الْخَيْرُ بِالشَّرِّ ؟ فَسَكَتَ عَنْهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَأَيْنَا أَنَّهُ يُنْزَلُ عَلَيْهِ ، فَقِيلَ لَهُ : مَا شَأْنُكَ ، تُكَلِّمُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَا يُكَلِّمُكَ ؟ فَسُرِّيَ عَنْ         [2/437]      رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَعَلَ يَمْسَحُ عَنْهُ  الرُّحَضَاءَ  ، فَقَالَ : "" أَيْنَ السَّائِلُ "" ؟ فَرَأَيْنَا أَنَّهُ حَمِدَهُ ، فَقَالَ : إِنَّ الْخَيْرَ لَا يَأْتِي بِالشَّرِّ ، وَإِنَّ مِمَّا يُنْبِتُ الرَّبِيعُ يَقْتُلُ - أَوْ  يُلِمُّ  -  حَبَطًا  ، أَلَمْ تَرَوْا إِلَى آكِلَةِ  الْخَضِرِ  أَكَلَتْ حَتَّى امْتَلَأَتْ  خَاصِرَتَاهَا  ، فَاسْتَقْبَلَتْ عَيْنَ الشَّمْسِ  فَثَلَطَتْ  فَبَالَتْ ، ثُمَّ رَتَعَتْ ؟ وَإِنَّ الْمَالَ حُلْوَةٌ  خَضِرَةٌ ،  وَنِعْمَ صَاحِبُ الْمُسْلِمِ هُوَ إِنْ وَصَلَ الرَّحِمَ ، وَأَنْفَقَ فِي  سَبِيلِ  اللهِ . وَمَثَلُ الَّذِي يَأْخُذُهُ بِغَيْرِ حَقِّهِ كَمَثَلِ الَّذِي يَأْكُلُ وَلَا يَشْبَعُ ، وَيَكُونُ عَلَيْهِ شَهِيدًا يَوْمَ الْقِيَامَةِ  .         [2/438]      قَالَ  زُهَيْرٌ  : قَالَ : خَبَطًا ، وَهُوَ حَبَطًا  .","","Musnad Abi Ya'la al-Mawsili 1242","","أبو سعيد الخدري عن عطاء بن يسار الهلالي عن هلال بن علي بن أسامة عن يحيى بن أبي كثير عن هشام الدستوائي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1242","269 - (  1243  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ         [2/439]      هَارُونَ ،  أَخْبَرَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ،  أَنَّ  غُلَامًا  لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَتَى بِتَمْرٍ رَيَّانَ ، وَكَانَ تَمْرُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَمْرًا بَعْلًا فِيهِ يُبْسٌ ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَنَّى لَكَ هَذَا التَّمْرُ ؟ "" قَالَ : هَذَا صَاعٌ ابْتَعْتُهُ بِصَاعَيْنِ مِنْ تَمْرِنَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ هَذَا لَا يَصْلُحُ ، وَلَكِنْ إِذَا أَرَدْتَ ذَلِكَ فَبِعْ تَمْرَكَ ، ثُمَّ اشْتَرِ أَيَّ تَمْرٍ شِئْتَ  .","","Musnad Abi Ya'la al-Mawsili 1243","","أبو سعيد الخدري عن سعيد بن المسيب عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1243","270 - (  1244  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  الْجُرَيْرِيُّ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا أَتَى أَحَدُكُمْ عَلَى رَاعٍ فَلْيُنَادِ : يَا رَاعِيَ الْإِبِلِ ، ثَلَاثًا ، فَإِنْ أَجَابَهُ ، وَإِلَّا فَلْيَحْلِبْ فَلْيَشْرَبْ  ، وَلَا يَحْمِلَنَّ . وَإِذَا أَتَى أَحَدُكُمْ عَلَى حَائِطِ بُسْتَانٍ فَلْيُنَادِ ثَلَاثًا : يَا صَاحِبَ الْحَائِطِ ، فَإِنْ أَجَابَهُ ، وَإِلَّا فَلْيَأْكُلْ وَلَا يَحْمِلْ  .  وَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  الضِّيَافَةُ ثَلَاثَةُ أَيَّامٍ فَمَا زَادَ فَصَدَقَةٌ  .         [2/440]             [2/441]","","Musnad Abi Ya'la al-Mawsili 1244","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن سعيد بن إياس الجريري عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1244","271 - (  1245  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو الْوَلِيدِ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  خُلَيْدِ بْنِ جَعْفَرٍ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ : ""  لِكُلِّ غَادِرٍ  لِوَاءٌ  يَوْمَ الْقِيَامَةِ عِنْدَ اسْتِهِ  .","","Musnad Abi Ya'la al-Mawsili 1245","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن خليد بن جعفر الحنفي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1245","272 - (  1246  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  عَنِ  الْقَاسِمِ بْنِ الْفَضْلِ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  تَمْرُقُ  مَارِقَةٌ  عِنْدَ فُرْقَةٍ مِنَ الْمُسْلِمِينَ ، يَقْتُلُهَا أَوْلَى الطَّائِفَتَيْنِ بِالْحَقِّ  .","","Musnad Abi Ya'la al-Mawsili 1246","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن القاسم بن الفضل بن معدان عن أبو عامر العقدي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1246","273 - (  1247  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو عَامِرٍ ،  عَنْ  زُهَيْرِ         [2/442]      بْنِ مُحَمَّدٍ ،  عَنْ  زَيْدٍ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أَبِي سَعِيدٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِيَّاكُمْ وَالْجُلُوسَ فِي الطُّرُقَاتِ  ، قَالُوا : يَا رَسُولَ اللهِ . مَا لَنَا مِنْ مَجَالِسِنَا بُدٌّ ، نَتَحَدَّثُ فِيهَا ، قَالَ : "" فَإِذَا أَبَيْتُمْ إِلَّا الْمَجْلِسَ فَأَعْطُوا الطَّرِيقَ حَقَّهُ "" ، قَالُوا : وَمَا حَقُّ الطَّرِيقِ ؟ قَالَ : غَضُّ الْبَصَرِ ، وَكَفُّ  الْأَذَى  ، وَرَدُّ السَّلَامِ ، وَالْأَمْرُ بِالْمَعْرُوفِ ، وَالنَّهْيُ عَنِ الْمُنْكَرِ  .         [2/443]","","Musnad Abi Ya'la al-Mawsili 1247","","أبو سعيد الخدري عن عطاء بن يسار الهلالي عن زيد بن أسلم عن زهير بن محمد التميمي عن أبو عامر العقدي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1247","274 - (  1248  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو عَامِرٍ ،  عَنْ  زُهَيْرٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي سَعِيدٍ الْخُدْرِيِّ ،  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا كَانَ أَحَدُكُمْ يُصَلِّي فَلَا يَتْرُكَنَّ أَحَدًا يَمُرُّ بَيْنَ يَدَيْهِ  ، فَإِنْ أَبَى فَلْيُقَاتِلْهُ فَإِنَّمَا هُوَ شَيْطَانٌ  .","","Musnad Abi Ya'la al-Mawsili 1248","","أبو سعيد الخدري عن عبد الرحمن بن أبي سعيد الخدري عن زيد بن أسلم عن زهير بن محمد التميمي عن أبو عامر العقدي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1248","275 - (  1249  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  حَبَّانُ بْنُ هِلَالٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ الشَّيْطَانَ يَأْتِي أَحَدَكُمْ فِي صَلَاتِهِ فَيَمُدُّ شَعَرَةً فِي دُبُرِهِ  ، فَيَرَى أَنَّهُ قَدْ أَحْدَثَ ، فَلَا يَنْصَرِفْ حَتَّى يَسْمَعَ صَوْتًا أَوْ يَجِدَ رِيحًا  .         [2/444]","","Musnad Abi Ya'la al-Mawsili 1249","","أبو سعيد الخدري عن سعيد بن المسيب عن علي بن زيد بن جدعان عن حماد بن سلمة عن حبان بن هلال الباهلي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1249","276 - (  1250  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  سَأَلَ  رَجُلٌ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ  الْعَزْلِ  ، فَقَالَ :  أَوَتَفْعَلُونَ ذَلِكَ ؟ لَا عَلَيْكُمْ أَنْ لَا تَفْعَلُوا ذَلِكَ  ، لَا عَلَيْكُمْ أَنْ لَا تَفْعَلُوا ، فَإِنَّهُ لَيْسَ  نَسَمَةٌ  قَضَى اللهُ أَنْ تَكُونَ إِلَّا وَهِيَ كَائِنَةٌ  .","","Musnad Abi Ya'la al-Mawsili 1250","","أبو سعيد الخدري عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1250","277 - (  1251  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَحْيَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  حَدَّثَنَا  أَبُو سُفْيَانَ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  حَدَّثَنِي  أَبُو سَعِيدٍ الْخُدْرِيُّ ،  أَنَّهُ دَخَلَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَآهُ يُصَلِّي فِي ثَوْبٍ وَاحِدٍ مُتَوَشِّحًا بِهِ  "" .","","Musnad Abi Ya'la al-Mawsili 1251","","أبو سعيد الخدري عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن الوضاح بن عبد الله اليشكري عن يحيى بن حماد بن أبي زياد الشيباني عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1251","278 - (  1252  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو الْوَلِيدِ ،  حَدَّثَنَا         [2/445]      شُعْبَةُ ،  أَخْبَرَنَا  أَبُو إِسْحَاقَ قَالَ :  سَمِعْتُ  الْأَغَرَّ أَبَا مُسْلِمٍ ، يَقُولُ :  أَشْهَدُ عَلَى  أَبِي سَعِيدٍ الْخُدْرِيِّ ، وَأَبِي هُرَيْرَةَ ، أَنَّهُمَا شَهِدَا عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ : ""  لَا يَقْعُدُ قَوْمٌ يَذْكُرُونَ اللهَ إِلَّا  غَشِيَتْهُمُ  الرَّحْمَةُ  ،  وَحَفَّتْهُمُ  الْمَلَائِكَةُ ، وَنَزَلَتْ عَلَيْهِمُ  السَّكِينَةُ  ، وَذَكَرَهُمُ اللهُ فِيمَنْ عِنْدَهُ  .","","Musnad Abi Ya'la al-Mawsili 1252","","أبو هريرة الدوسي عن الأغر المديني مولى أبي هريرة وأبي سعيد الخدري عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1252","279 - (  1253  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  عُثْمَانُ بْنُ غِيَاثٍ ،  حَدَّثَنَا  أَبُو نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ : ""  يَمُرُّ النَّاسُ عَلَى جِسْرِ  جَهَنَّمَ ،  وَعَلَيْهِ  حَسَكٌ  وَكَلَالِيبُ  وَخَطَاطِيفُ  تَخْطَفُ النَّاسَ يَمِينًا وَشِمَالًا  ، وَعَلَى جَنْبَتَيْهِ مَلَائِكَةٌ يَقُولُونَ : اللَّهُمَّ سَلِّمْ سَلِّمْ ، فَمِنَ النَّاسِ مَنْ يَمُرُّ مِثْلَ الْبَرْقِ ، وَمِنْهُمْ مَنْ يَمُرُّ مِثْلَ الرِّيحِ ، وَمِنْهُمْ مَنْ يَمُرُّ مِثْلَ الْفَرَسِ ، وَمِنْهُمْ مَنْ يَسْعَى سَعْيًا ، وَمِنْهُمْ مَنْ يَمْشِي مَشْيًا ، وَمِنْهُمْ مَنْ يَحْبُو  حَبْوًا  ، وَمِنْهُمْ مَنْ  يَزْحَفُ  زَحْفًا ، فَأَمَّا أَهْلُ النَّارِ الَّذِينَ هُمْ أَهْلُهَا فَلَا يَمُوتُونَ وَلَا يَحْيَوْنَ ، وَأَمَّا أُنَاسٌ فَيُؤْخَذُونَ بِذُنُوبٍ وَخَطَايَا ، قَالَ : فَيَحْتَرِقُونَ فَيَكُونُونَ         [2/446]      فَحْمًا ، ثُمَّ يُؤْذَنُ فِي الشَّفَاعَةِ ، فَيُؤْخَذُونَ  ضِبَارَاتٍ  ضِبَارَاتٍ  ، فَيُقْذَفُونَ عَلَى نَهَرٍ مِنْ أَنْهَارِ الْجَنَّةِ ، فَيَنْبُتُونَ كَمَا تَنْبُتُ  الْحِبَّةُ  فِي  حَمِيلِ  السَّيْلِ . قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَمَا رَأَيْتُمُ  الصَّبْغَاءَ  ؟ ( شَجَرَةٌ تَنْبُتُ فِي  الْغُثَاءِ  ) ؟ فَيَكُونُ مِنْ آخِرِ مَنْ أُخْرِجَ مِنَ النَّارِ رَجُلٌ عَلَى شَفَتِهَا ، فَيَقُولُ : يَا رَبِّ اصْرِفْ وَجْهِي عَنْهَا ، فَيَقُولُ : عَهْدَكَ وَذِمَّتَكَ لَا تَسْأَلْنِي غَيْرَهَا ؟ قَالَ : وَعَلَى الصِّرَاطِ ثَلَاثُ شَجَرَاتٍ ، فَيَقُولُ : يَا رَبِّ حَوِّلْنِي إِلَى هَذِهِ الشَّجَرَةِ آكُلُ مِنْ  ثَمَرِهَا  ، وَأَكُونُ فِي ظِلِّهَا ، فَيَقُولُ : عَهْدَكَ وَذِمَّتَكَ لَا تَسْأَلْنِي غَيْرَهَا ؟ قَالَ : ثُمَّ يَرَى أُخْرَى أَحْسَنَ مِنْهَا ، فَيَقُولُ : يَا رَبِّ حَوِّلْنِي إِلَى هَذِهِ آكُلُ مِنْ  ثَمَرِهَا  ، وَأَكُونُ فِي ظِلِّهَا . قَالَ : فَيَقُولُ عَهْدَكَ وَذِمَّتَكَ لَا تَسْأَلْنِي غَيْرَهَا ؟ قَالَ : ثُمَّ يَرَى أُخْرَى ، فَيَقُولُ : يَا رَبِّ حَوِّلْنِي إِلَى هَذِهِ آكُلُ مِنْ  ثَمَرِهَا  وَأَشْرَبُ فِي ظِلِّهَا ، ثُمَّ يَرَى سَوَادَ النَّاسِ وَيَسْمَعُ كَلَامَهُمْ ، قَالَ : فَيَقُولُ : يَا رَبِّ أَدْخِلْنِي الْجَنَّةَ "" . قَالَ  أَبُو نَضْرَةَ  : اخْتَلَفَ  أَبُو سَعِيدٍ  وَرَجُلٌ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ أَحَدُهُمَا : "" فَيُدْخِلُهُ الْجَنَّةَ ، فَيُعْطَى الدُّنْيَا وَمِثْلَهَا . وَقَالَ الْآخَرُ : يَدْخُلُ الْجَنَّةَ فَيُعْطَى الدُّنْيَا وَعَشَرَةَ أَمْثَالِهَا  .         [2/447]","","Musnad Abi Ya'la al-Mawsili 1253","","أحد الصحابة عن المنذر بن مالك العوقي عن عثمان بن غياث الراسبي عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1253","280 - (  1254  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  أَبُو الزُّبَيْرِ قَالَ  أَبُو خَيْثَمَةَ  :  أُرَاهُ  عَنْ  جَابِرٍ  ،  عَنْ  أَبِي سَعِيدٍ ، أَنَّهُ سَمِعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  يَخْرُجُ نَاسٌ مِنَ النَّارِ قَدِ احْتَرَقُوا وَكَانُوا مِثْلَ الْحُمَمِ  ، ثُمَّ لَا يَزَالُ أَهْلُ الْجَنَّةِ يَرُشُّونَ عَلَيْهِمُ الْمَاءَ حَتَّى يَنْبُتُوا نَبَاتَ  الْغُثَاءِ  فِي السَّيْلِ  .","","Musnad Abi Ya'la al-Mawsili 1254","","أبو سعيد الخدري عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1254","281 - (  1255  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  عَوْفٌ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  يَخْرُجُ ضِبَارَةٌ مِنَ النَّارِ قَدْ كَانُوا فَحْمًا ، فَيُقَالُ : بَوِّئُوهُمُ الْجَنَّةَ  ، وَرُشُّوا عَلَيْهِمْ مِنَ الْمَاءِ . قَالَ : فَيَنْبُتُونَ كَمَا تَنْبُتُ  الْحِبَّةُ  فِي  حَمِيلِ  السَّيْلِ . فَقَالَ  رَجُلٌ مِنَ الْقَوْمِ  : كَأَنَّكَ كُنْتَ مِنْ أَهْلِ الْبَادِيَةِ يَا رَسُولَ اللهِ  "" .         [2/448]","","Musnad Abi Ya'la al-Mawsili 1255","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن عوف بن أبي جميلة عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1255","282 - (  1256  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عُلَيَّةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ الْمُؤْمِنَ لَا يُصِيبُهُ نَصَبٌ ، وَلَا وَصَبٌ ، وَلَا  حَزَنٌ  ، وَلَا أَذًى ، حَتَّى الْهَمُّ يُهِمُّهُ ، إِلَّا اللهُ يُكَفِّرُ مِنْ سَيِّئَاتِهِ  "" .","","Musnad Abi Ya'la al-Mawsili 1256","","أبو سعيد الخدري عن عطاء بن يسار الهلالي عن محمد بن عمرو بن عطاء العامري عن محمد بن إسحاق عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1256","283 - (  1257  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  لَيْثٌ ،  عَنْ  يَزِيدَ بْنِ الْهَادِ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنِ  النُّعْمَانِ بْنِ أَبِي عَيَّاشٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  مَا مِنْ عَبْدٍ يَصُومُ يَوْمًا فِي  سَبِيلِ  اللهِ  ، إِلَّا أَبْعَدَ اللهُ بِذَلِكَ الْيَوْمِ وَجْهَهُ عَنِ النَّارِ سَبْعِينَ  خَرِيفًا  "" .         [2/449]","","Musnad Abi Ya'la al-Mawsili 1257","","أبو سعيد الخدري عن النعمان بن أبي عياش الزرقي عن سهيل بن أبي صالح السمان عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن الليث بن سعد عن يونس بن محمد بن مسلم البغدادي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1257","284 - (  1258  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  حَدَّثَنَا  إِسْرَائِيلُ بْنُ يُونُسَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْأَغَرِّ أَبِي مُسْلِمٍ ،  عَنْ  أَبِي سَعِيدٍ وَأَبِي هُرَيْرَةَ قَالَا : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِذَا قَالَ الْعَبْدُ : لَا إِلَهَ إِلَّا اللهُ ، وَاللهُ أَكْبَرُ  ، صَدَّقَهُ رَبُّهُ قَالَ : صَدَقَ عَبْدِي ، لَا إِلَهَ إِلَّا أَنَا وَأَنَا أَكْبَرُ ، فَإِذَا قَالَ : لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ ، صَدَّقَهُ رَبُّهُ : لَا إِلَهَ إِلَّا أَنَا وَحْدِي . فَإِذَا قَالَ : لَا إِلَهَ إِلَّا اللهُ لَا شَرِيكَ لَهُ ، صَدَّقَهُ رَبُّهُ ، قَالَ : لَا إِلَهَ إِلَّا أَنَا لَا شَرِيكَ لِي ، فَإِذَا قَالَ : لَا إِلَهَ إِلَّا اللهُ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ ، صَدَّقَهُ رَبُّهُ ، فَقَالَ : صَدَقَ عَبْدِي لَا إِلَهَ إِلَّا أَنَا ، لِيَ الْمُلْكُ ، وَلِيَ الْحَمْدُ ، فَإِذَا         [2/450]      قَالَ : لَا إِلَهَ إِلَّا اللهُ ، وَلَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ ، صَدَّقَهُ رَبُّهُ قَالَ : صَدَقَ عَبْدِي ، لَا إِلَهَ إِلَّا أَنَا ، وَلَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِي  .","","Musnad Abi Ya'la al-Mawsili 1258","","أبو هريرة الدوسي عن الأغر المديني مولى أبي هريرة وأبي سعيد الخدري عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن يحيى بن أبي بكير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1258","285 - (  1259  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  حَدَّثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مَالِكِ بْنِ الْحَارِثِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : ""  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الزَّهْوِ وَالتَّمْرِ ، وَعَنِ الزَّبِيبِ وَالتَّمْرِ  ، فَقُلْتُ : أَنْ يُنْبَذَا جَمِيعًا ؟ فَقَالَ : نَعَمْ  "" .","","Musnad Abi Ya'la al-Mawsili 1259","","أبو سعيد الخدري عن مالك بن الحارث السلمي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1259","286 - (  1260  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  عَوْفٌ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَقَدِ  اهْتَزَّ  الْعَرْشُ  لِمَوْتِ  سَعْدِ بْنِ مُعَاذٍ  "" .         [2/451]","","Musnad Abi Ya'la al-Mawsili 1260","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن عوف بن أبي جميلة عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1260","287 - (  1261  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمُتَوَكِّلِ ،  عَنْ  أَبِي سَعِيدٍ قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : "" يَا رَسُولَ اللهِ ، إِنَّ أَخِي  اسْتَطْلَقَ  بَطْنُهُ ، فَقَالَ : "" اسْقِهِ عَسَلًا "" . قَالَ : فَسَقَاهُ ، قَالَ : فَأَتَاهُ ، فَقَالَ : قَدْ سَقَيْتُهُ عَسَلًا فَلَمْ يَزِدْهُ إِلَّا اسْتِطْلَاقًا . قَالَ : فَقَالَ : "" اسْقِهِ عَسَلًا "" . ثُمَّ أَتَاهُ ، فَقَالَ : قَدْ سَقَيْتُهُ فَلَمْ يَزِدْهُ إِلَّا اسْتِطْلَاقًا ؟ قَالَ : فَقَالَ : "" اسْقِهِ عَسَلًا "" قَالَ :  فَأَمَّا فِي الثَّالِثَةِ أَوْ فِي الرَّابِعَةِ حَسِبْتُهُ قَالَ : فَشُفِيَ  ، قَالَ : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  صَدَقَ اللهُ  وَكَذَبَ  بَطْنُ أَخِيكَ  .","","Musnad Abi Ya'la al-Mawsili 1261","","أبو سعيد الخدري عن علي بن داود الناجي عن قتادة بن دعامة عن شعبة بن الحجاج عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1261","288 - (  1262  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنِ  الْأَعْرَجِ ،  عَنْ  أَبِي هُرَيْرَةَ ،         [2/452]      وَعَنْ  عُبَيْدِ اللهِ بْنِ الْمُغِيرَةِ بْنِ مُعَيْقِيبٍ ،  عَنْ  عَمْرِو بْنِ سُلَيْمٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَا : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  اللَّهُمَّ إِنِّي أَتَّخِذُ عِنْدَكَ عَهْدًا تُؤَدِّيهِ إِلَيَّ يَوْمَ الْقِيَامَةِ ؛ إِنَّكَ لَا تُخْلِفُ الْمِيعَادَ  : إِنَّمَا أَنَا بَشَرٌ فَأَيُّ الْمُسْلِمِينَ  آذَيْتُهُ أَوْ شَتَمْتُهُ - أَوْ قَالَ : ضَرَبْتُهُ أَوْ شَتَمْتُهُ  - فَاجْعَلْهَا لَهُ صَلَاةً ، وَاجْعَلْهَا لَهُ زَكَاةً وَقُرْبَةً تُقَرِّبُهُ بِهَا إِلَيْكَ يَوْمَ الْقِيَامَةِ  "" .         [2/453]","","Musnad Abi Ya'la al-Mawsili 1262","","أبو سعيد الخدري عن عمرو بن سليم بن خلدة الزرقي عن عبيد الله بن المغيرة بن معيقيب السبئي عن محمد بن إسحاق عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1262","289 - (  1263  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي إِبْرَاهِيمَ الْأَنْصَارِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَلَقَ  يَوْمَ الْحُدَيْبِيَةِ  وَأَصْحَابُهُ إِلَّا  أَبَا قَتَادَةَ  ،  وَعُثْمَانَ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَرْحَمُ اللهُ  الْمُحَلِّقِينَ  . قَالُوا : وَالْمُقَصِّرِينَ يَا رَسُولَ اللهِ ؟ قَالَ : "" يَرْحَمُ اللهُ  الْمُحَلِّقِينَ  "" . قَالُوا : يَا رَسُولَ اللهِ ، وَالْمُقَصِّرِينَ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" وَالْمُقَصِّرِينَ "" . فِي الثَّالِثَةِ  .         [2/454]","","Musnad Abi Ya'la al-Mawsili 1263","","أبو سعيد الخدري عن أبو إبراهيم الأشهلي عن يحيى بن أبي كثير عن هشام الدستوائي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1263","290 - (  1264  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  لَيْثُ بْنُ سَعْدٍ ،  حَدَّثَنِي  سَعِيدٌ ،  عَنْ  عِيَاضِ بْنِ عَبْدِ اللهِ ،  أَنَّهُ سَمِعَ  أَبَا سَعِيدٍ الْخُدْرِيَّ ، يَقُولُ :  قَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَخَطَبَ النَّاسَ ، فَقَالَ :  وَاللهِ مَا أَخْشَى عَلَيْكُمْ أَيُّهَا النَّاسُ إِلَّا مَا يَخْرُجُ لَكُمْ مِنْ  زَهْرَةِ  الدُّنْيَا  . فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، أَيَأْتِي الْخَيْرُ بِالشَّرِّ ؟ فَصَمَتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - وَذَكَرَ الْحَدِيثَ  .","","Musnad Abi Ya'la al-Mawsili 1264","","أبو سعيد الخدري عن عياض بن عبد الله بن سعد العامري عن سعيد المقبري عن الليث بن سعد عن يونس بن محمد بن مسلم البغدادي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1264","291 - (  1265  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يُونُسُ ،  حَدَّثَنَا  لَيْثٌ ،  حَدَّثَنِي  سَعِيدٌ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ سَمِعَ  أَبَا سَعِيدٍ الْخُدْرِيَّ ، يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِذَا وُضِعَتِ الْجِنَازَةُ وَاحْتَمَلَهَا الرِّجَالُ عَلَى أَعْنَاقِهِمْ ، فَإِنْ كَانَتْ صَالِحَةً قَالَتْ : قَدِّمُونِي قَدِّمُونِي  . وَإِنْ كَانَتْ غَيْرَ صَالِحَةٍ ، قَالَتْ : يَا وَيْلَهَا ، أَيْنَ يَذْهَبُونَ بِهَا ؟ يَسْمَعُ صَوْتَهَا كُلُّ شَيْءٍ إِلَّا الْإِنْسَانَ ، وَلَوْ سَمِعَهَا الْإِنْسَانُ لَصَعِقَ  .         [2/455]","","Musnad Abi Ya'la al-Mawsili 1265","","أبو سعيد الخدري عن أبو سعيد المقبري عن سعيد المقبري عن الليث بن سعد عن يونس بن محمد بن مسلم البغدادي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1265","292 - (  1266  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يُونُسُ ،  حَدَّثَنَا  لَيْثٌ ،  حَدَّثَنِي  سَعِيدٌ ،  عَنْ  أَبِي سَعِيدٍ مَوْلَى الْمَهْرِيِّ ،  أَنَّهُ جَاءَ أَبَا سَعِيدٍ الْخُدْرِيَّ لَيَالِيَ  الْحَرَّةِ  فَاسْتَشَارَهُ فِي الْجَلَاءِ مِنَ  الْمَدِينَةِ  ، وَشَكَا إِلَيْهِ أَسْعَارَهَا وَكَثْرَةَ عِيَالِهِ  ، وَأَخْبَرَهُ أَنْ لَا صَبْرَ لَهُ عَلَى  جَهْدِ  الْمَدِينَةِ  . فَقَالَ لَهُ : وَيْحَكَ ، لَا آمُرُكَ بِذَلِكَ  ، إِنِّي  سَمِعْتُ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَصْبِرُ أَحَدٌ عَلَى  جَهْدِ  الْمَدِينَةِ  وَلَأْوَائِهَا  ، فَيَمُوتُ إِلَّا كُنْتُ لَهُ  شَفِيعًا - أَوْ : شَهِيدًا  - يَوْمَ الْقِيَامَةِ  ، إِذَا كَانَ مُسْلِمًا  "" .","","Musnad Abi Ya'la al-Mawsili 1266","","أبو سعيد الخدري عن أبو سعيد المهري عن سعيد المقبري عن الليث بن سعد عن يونس بن محمد بن مسلم البغدادي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1266","293 - (  1267  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يُونُسُ ،  حَدَّثَنَا  شَيْبَانُ ،  عَنْ  قَتَادَةَ قَالَ :  حَدَّثَ  هِلَالُ بْنُ حِصْنٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  أَصَابَهُ مَرَّةً  جَهْدٌ  شَدِيدٌ ، فَقَالَ لِي بَعْضُ أَهْلِي : لَوْ سَأَلْتَ لَنَا رَسُولَ اللهِ ، صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : فَانْطَلَقْتُ مُحْنَقًا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَكَانَ أَوَّلَ مَا وَاجَهَنِي بِهِ مِنْ قَوْلِهِ أَنَّهُ قَالَ :  مَنِ اسْتَعَفَّ أَعَفَّهُ اللهُ ، وَمَنِ اسْتَغْنَى أَغْنَاهُ اللهُ  ، وَمَنْ سَأَلَنَا لَمْ         [2/456]      نَدَّخِرْ  عَنْهُ شَيْئًا وَجَدْنَاهُ "" . قَالَ : فَرَجَعْتُ إِلَى نَفْسِي أُخَيِّرُ إِلَيْهَا : أَلَا أَسْتَعَفُّ فَيُعِفَّنِي اللهُ ؟ أَلَا أَسْتَغْنِي فَيُغْنِيَنِي اللهُ ؟ قَالَ : فَمَا مَشَيْتُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعْدَ ذَلِكَ أَسْأَلُهُ شَيْئًا مِنْ  فَاقَةٍ  حَتَّى أَقْبَلَتْ عَلَيْنَا الدُّنْيَا ، فَغَرَّقَتْنَا ، إِلَّا مَا  عَصَمَ  اللهُ  .","","Musnad Abi Ya'la al-Mawsili 1267","","أبو سعيد الخدري عن هلال بن حصن البصرى عن قتادة بن دعامة عن شيبان بن عبد الرحمن المؤدب عن يونس بن محمد بن مسلم البغدادي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1267","294 - (  1268  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  يَعْقُوبَ بْنِ عُتْبَةَ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : ""  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ صَلَاتَيْنِ ، وَعَنْ نِكَاحَيْنِ ، وَعَنْ صِيَامَيْنِ : عَنْ صَلَاةٍ بَعْدَ الْعَصْرِ حَتَّى تَغْرُبَ الشَّمْسُ  . وَعَنْ صَلَاةٍ بَعْدَ الْفَجْرِ حَتَّى تَطْلُعَ الشَّمْسُ ، وَعَنْ صِيَامِ يَوْمِ الْفِطْرِ وَيَوْمِ النَّحْرِ ، وَأَنْ تُنْكَحَ الْمَرْأَةُ عَلَى خَالَتِهَا أَوْ عَلَى عَمَّتِهَا  "" .","","Musnad Abi Ya'la al-Mawsili 1268","","أبو سعيد الخدري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يعقوب بن عتبة بن المغيرة الثقفي عن محمد بن إسحاق عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1268","295 - (  1269  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ عَلْقَمَةَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي سَعِيدٍ قَالَ : ""  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ  الْمُحَاقَلَةِ  وَالْمُزَابَنَةِ  "" .","","Musnad Abi Ya'la al-Mawsili 1269","","أبو سعيد الخدري عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1269","296 - (  1270  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ ،  أَخْبَرَنَا  فُضَيْلُ         [2/457]      بْنُ مَرْزُوقٍ ،  عَنْ  عَطِيَّةَ الْعَوْفِيِّ ،  عَنْ  أَبِي سَعِيدٍ قَالَ : ""  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي الضُّحَى حَتَّى نَقُولَ : لَا يَدَعُهَا  ، وَيَدَعُهَا حَتَّى نَقُولَ : لَا يُصَلِّيهَا  .","","Musnad Abi Ya'la al-Mawsili 1270","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1270","297 - (  1271  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ مُصْعَبٍ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَطَاءِ بْنِ يَزِيدَ اللَّيْثِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ،  أَنَّ  أَعْرَابِيًّا  أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : "" يَا رَسُولَ اللهِ ، إِنَّ لِي إِبِلًا ، وَإِنِّي أُرِيدُ الْهِجْرَةَ ، فَمَا تَأْمُرُنِي ؟ قَالَ : هَلْ تَمْنَحُ مِنْهَا ؟ قَالَ : نَعَمْ . قَالَ : وَتُؤَدِّي زَكَاتَهَا ؟ قَالَ : نَعَمْ . قَالَ : وَتَحْلُبُهَا يَوْمَ وِرْدِهَا ؟ قَالَ : نَعَمْ . قَالَ :  فَانْطَلِقْ فَاعْمَلْ مِنْ وَرَاءِ الْبِحَارِ ، فَإِنَّ اللهَ لَنْ يَتِرَكَ مِنْ عَمَلِكَ شَيْئًا ، وَإِنَّ  شَأْنَ  الْهِجْرَةِ شَدِيدٌ  "" .         [2/458]","","Musnad Abi Ya'la al-Mawsili 1271","","أبو سعيد الخدري عن عطاء بن يزيد الجندعي عن الزهري عن أبو عمرو الأوزاعي عن محمد بن مصعب القرقساني عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1271","298 - (  1272  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  لَيْثٌ ،  عَنْ  يَزِيدَ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنِ  النُّعْمَانِ بْنِ أَبِي عَيَّاشٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  مَا مِنْ عَبْدٍ يَصُومُ يَوْمًا فِي  سَبِيلِ  اللهِ ، إِلَّا أَبْعَدَ اللهُ بِذَلِكَ الْيَوْمِ وَجْهَهُ عَنِ النَّارِ سَبْعِينَ  خَرِيفًا  "" .","","Musnad Abi Ya'la al-Mawsili 1272","","أبو سعيد الخدري عن النعمان بن أبي عياش الزرقي عن سهيل بن أبي صالح السمان عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن الليث بن سعد عن يونس بن محمد بن مسلم البغدادي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1272","299 - (  1273  ) -  وَعَنْ  يَزِيدَ ،  عَنْ  عَمْرٍو ،  عَنْ  أَبِي سَعِيدٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  إِنَّ إِبْلِيسَ قَالَ لِرَبِّهِ : بِعِزَّتِكَ وَجَلَالِكَ لَا أَبْرَحُ أُغْوِي ابْنَ آدَمَ مَا دَامَتِ الْأَرْوَاحُ فِيهِمْ . قَالَ لَهُ رَبُّهُ :  فَبِعِزَّتِي وَجَلَالِي لَا أَبْرَحُ أَغْفِرُ لَهُمْ مَا اسْتَغْفَرُونِي  .         [2/459]","","Musnad Abi Ya'la al-Mawsili 1273","","أبو سعيد الخدري عن عمرو بن أبي عمرو المخزومي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن الليث بن سعد عن يونس بن محمد بن مسلم البغدادي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1273","300 - (  1274  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَسَدِيُّ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  الضَّحَّاكِ الْمِشْرَقِيِّ ،  عَنْ  أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  فِي حَدِيثٍ ذَكَرَ فِيهِ قَوْمًا يَخْرُجُونَ عَلَى فُرْقَةٍ مِنَ النَّاسِ مُخْتَلِفَةٍ ، يَقْتُلُهُمْ أَقْرَبُ الطَّائِفَتَيْنِ مِنَ الْحَقِّ  "" .","","Musnad Abi Ya'la al-Mawsili 1274","","أبو سعيد الخدري عن الضحاك بن شراحيل المشرقي عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن محمد بن عبد الله بن الزبير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1274","301 - (  1275  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  أَخْبَرَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  دَرَّاجٍ ،  عَنْ  أَبِي الْهَيْثَمِ ،  عَنْ  أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  إِنَّ مَا بَيْنَ مِصْرَاعَيْنِ فِي الْجَنَّةِ  مَسِيرَةُ  أَرْبَعِينَ سَنَةً  "" .         [2/460]","","Musnad Abi Ya'la al-Mawsili 1275","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1275","302 - (  1276  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  رِبْعِيُّ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ مُعَاوِيَةَ ،  عَنِ  الْحَارِثِ مَوْلَى ابْنِ سِبَاعٍ ،  عَنْ  أَبِي سَعِيدٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ تَغَنَّى أَغْنَاهُ اللهُ  ، وَمَنْ تَعَفَّفَ أَعَفَّهُ اللهُ  "" .","","Musnad Abi Ya'la al-Mawsili 1276","","أبو سعيد الخدري عن الحارث مولى ابن سباع عن عبد الرحمن بن معاوية النوفلي عن عبد الرحمن بن إسحاق العامري عن ربعي بن إبراهيم الأسدي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1276","303 - (  1277  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ ،  حَدَّثَنَا  عِيسَى ،  عَنِ  الْمُجَالِدِ ،  عَنْ  أَبِي الْوَدَّاكِ ،  عَنْ  أَبِي سَعِيدٍ قَالَ :  كَانَ عِنْدَنَا خَمْرٌ لِيَتِيمٍ ، فَلَمَّا نَزَلَتِ الْآيَةُ الَّتِي فِي الْمَائِدَةِ ، سَأَلْنَا عَنْهُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْنَا :  إِنَّهُ لِيَتِيمٍ . فَقَالَ : "" أَهْرِيقُوهُ  "" .         [2/461]","","Musnad Abi Ya'la al-Mawsili 1277","","أبو سعيد الخدري عن جبر بن نوف البكالي عن مجالد بن سعيد عن عيسى بن يونس بن أبي إسحاق عن عبد الله بن جعفر بن غيلان عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1277","304 - (  1278  ) -  وَعَنْ  أَبِي سَعِيدٍ قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  إِنَّ أَهْلَ  عِلِّيِّينَ  لَيَرَاهُمْ مَنْ هُوَ أَسْفَلُ مِنْهُمْ كَمَا  تَرَوْنَ  الْكَوْكَبَ  الدُّرِّيَّ  فِي أُفُقِ السَّمَاءِ  ، وَإِنَّ  أَبَا بَكْرٍ  وَعُمَرَ  مِنْهُمْ ،  وَأَنْعَمَا  .","","Musnad Abi Ya'la al-Mawsili 1278","","أبو سعيد الخدري عن جبر بن نوف البكالي عن مجالد بن سعيد عن عيسى بن يونس بن أبي إسحاق عن عبد الله بن جعفر بن غيلان عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1278","305 - (  1279  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  شَبَابَةُ بْنُ سَوَّارٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَصْبَهَانِيِّ ،  عَنْ  ذَكْوَانَ ،  عَنْ  أَبِي سَعِيدٍ قَالَ :  قُلْنَ النِّسَاءُ : غَلَبَنَا عَلَيْكَ الرِّجَالُ يَا رَسُولَ اللهِ ، فَاجْعَلْ لَنَا يَوْمًا ، قَالَ : فَوَعَدَهُنَّ يَوْمًا ، فَجِئْنَ فَوَعَظَهُنَّ ، وَقَالَ لَهُنَّ فِيمَا قَالَ لَهُنَّ :  مَا مِنْكُنَّ مِنِ امْرَأَةٍ تُقَدِّمُ ثَلَاثَةً مِنْ وَلَدِهَا إِلَّا كَانُوا لَهَا حِجَابًا مِنَ النَّارِ  ؟ قَالَتِ  امْرَأَةٌ  : يَا رَسُولَ اللهِ وَاثْنَيْنِ ؟ فَقَدْ مَاتَ لَهَا اثْنَانِ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" وَاثْنَيْنِ  "" .         [2/462]","","Musnad Abi Ya'la al-Mawsili 1279","","أبو سعيد الخدري عن ذكوان السمان عن عبد الرحمن بن عبد الله بن الأصبهاني عن شعبة بن الحجاج عن شبابة بن سوار المدائني عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1279","306 - (  1280  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ قَالَ :  تَذَاكَرْنَا لَيْلَةَ الْقَدْرِ ، فَأَتَيْنَا أَبَا سَعِيدٍ الْخُدْرِيَّ ،  فَقُلْتُ لَهُ  : يَا  أَبَا سَعِيدٍ  ، هَلْ سَمِعْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَذْكُرُ لَيْلَةَ الْقَدْرِ ؟ فَقَالَ : اعْتَكَفَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْعَشْرَ الْأَوْسَطَ مِنْ شَهْرِ رَمَضَانَ ، وَاعْتَكَفْنَا مَعَهُ . فَلَمَّا كَانَ صَبِيحَةُ عِشْرِينَ رَجَعَ وَرَجَعْنَا مَعَهُ ، فَنَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَأَى لَيْلَةَ الْقَدْرِ فِي الْمَنَامِ ، ثُمَّ أُنْسِيَهَا ، فَخَرَجَ عَشِيَّةً فَخَطَبَنَا ، فَقَالَ :  إِنِّي رَأَيْتُ لَيْلَةَ الْقَدْرِ فِي الْمَنَامِ ، ثُمَّ أُنْسِيتُهَا ، وَأُرَانِي تِلْكَ اللَّيْلَةَ أَسْجُدُ فِي مَاءٍ وَطِينٍ  . فَمَنْ كَانَ اعْتَكَفَ مَعَنَا فَلْيَرْجِعْ إِلَى مُعْتَكَفِهِ ، ابْغُوهَا فِي الْعَشْرِ الْأَوَاخِرِ فِي  الْوِتْرِ  مِنْهَا ، فَإِنَّ اللهَ  وِتْرٌ  يُحِبُّ  الْوِتْرَ  "" . قَالَ : فَرَجَعْنَا فَهَاجَتْ عَلَيْنَا السَّمَاءُ تِلْكَ الْعَشِيَّةَ ، وَكَانَ سَقْفُ الْمَسْجِدِ  عَرِيشًا  مِنْ جَرِيدِ النَّخْلِ ، فَاعْتَكَفَ ، فَوَالَّذِي أَكْرَمَهُ وَأَنْزَلَ عَلَيْهِ الْكِتَابَ لَرَأَيْتُهُ لَيْلَةَ إِحْدَى وَعِشْرِينَ ، وَإِنَّ جَبْهَتَهُ وَأَرْنَبَةَ أَنْفِهِ فِي الْمَاءِ وَالطِّينِ  "" .","","Musnad Abi Ya'la al-Mawsili 1280","","أبو سعيد الخدري عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1280","307 - (  1281  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ قَالَ :  قُلْنَا  لِأَبِي سَعِيدٍ :  هَلْ سَمِعْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَذْكُرُ الْحَرُورِيَّةَ ؟ فَقَالَ : سَمِعْتُهُ يَقُولُ ، وَذَكَرَ الْحَدِيثَ  .         [2/463]","","Musnad Abi Ya'la al-Mawsili 1281","","أبو سعيد الخدري عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1281","308 - (  1282  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  حُسَيْنٌ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَعِيدٍ مَوْلَى الْمَهْرِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  بَعَثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى  بَنِي لِحْيَانَ  قَالَ : فَقَالَ : "" لِيَنْبَعِثْ مِنْ كُلِّ رَجُلَيْنِ أَحَدُهُمَا ، وَالْأَجْرُ بَيْنَهُمَا "" . ثُمَّ قَالَ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اللَّهُمَّ بَارِكْ فِي صَاعِنَا وَمُدِّنَا  ، وَاجْعَلْ مَعَ الْبَرَكَةِ بَرَكَتَيْنِ  "" .","","Musnad Abi Ya'la al-Mawsili 1282","","أبو سعيد الخدري عن أبو سعيد المهري عن يحيى بن أبي كثير عن حسين المعلم عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1282","309 - (  1283  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ         [2/464]      حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْأَغَرِّ أَبِي مُسْلِمٍ قَالَ :  أَشْهَدُ  عَلَى أَبِي هُرَيْرَةَ ، وَأَبِي سَعِيدٍ ، أَنَّهُمَا شَهِدَا عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  مَا جَلَسَ قَوْمٌ يَذْكُرُونَ اللهَ عَزَّ وَجَلَّ ، إِلَّا  حَفَّتْ  بِهِمُ الْمَلَائِكَةُ  ،  وَغَشِيَتْهُمُ  الرَّحْمَةُ ، وَتَنَزَّلَتْ عَلَيْهِمُ  السَّكِينَةُ  ، وَذَكَرَهُمُ اللهُ فِيمَنْ عِنْدَهُ  "" .","","Musnad Abi Ya'la al-Mawsili 1283","","أبو سعيد الخدري عن الأغر المديني مولى أبي هريرة وأبي سعيد الخدري عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1283","310 - (  1284  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عُلَيَّةَ ،  عَنْ  عَلِيِّ بْنِ الْمُبَارَكِ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  حَدَّثَنِي  أَبُو سَعِيدٍ مَوْلَى الْمَهْرِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ""  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعَثَ بَعْثًا إِلَى  بَنِي لِحْيَانَ  مِنْ  هُذَيْلٍ  قَالَ :  لِيَنْبَعِثْ مِنْ كُلِّ رَجُلَيْنِ أَحَدُهُمَا ، وَالْأَجْرُ بَيْنَهُمَا  ، وَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" اللَّهُمَّ بَارِكْ لَنَا فِي صَاعِنَا وَمُدِّنَا ، وَاجْعَلْ مَعَ الْبَرَكَةِ بَرَكَتَيْنِ  "" .","","Musnad Abi Ya'la al-Mawsili 1284","","أبو سعيد الخدري عن أبو سعيد المهري عن يحيى بن أبي كثير عن علي بن المبارك الهنائي عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1284","311 - (  1285  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  سَعِيدُ بْنُ عَامِرٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  مَطَرٍ ،  عَنِ  ابْنِ سِيرِينَ ،  عَنْ  ذَكْوَانَ أَبِي صَالِحٍ ، وَأَثْنَى عَلَيْهِ خَيْرًا ،  عَنْ  جَابِرٍ وَأَبِي هُرَيْرَةَ وَأَبِي سَعِيدٍ الْخُدْرِيِّ ""  أَنَّهُمْ نُهَوْا عَنِ         [2/465]      الصَّرْفِ  ، وَرَجُلَانِ مِنْهُمْ  يَرْفَعَانِ  ذَلِكَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Musnad Abi Ya'la al-Mawsili 1285","","أبو سعيد الخدري عن ذكوان السمان عن محمد بن سيرين عن مطر بن طهمان الوراق عن سعيد بن أبي عروبة عن سعيد بن عامر الضبعي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1285","312 - (  1286  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  سَعِيدُ بْنُ عَامِرٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  سُلَيْمَانَ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  يَكُونُ أُمَرَاءُ يَغْشَاهُمْ  غَوَاشٍ مِنَ النَّاسِ - أَوْ قَالَ : حَوَاشِي  - قَالَ  شُعْبَةُ  :  أَحْسَبُهُ قَالَ : فَيَظْلِمُونَ وَيَكْذِبُونَ  ، فَمَنْ صَدَّقَهُمْ بِكَذِبِهِمْ ، وَأَعَانَهُمْ عَلَى ظُلْمِهِمْ فَلَيْسَ مِنِّي ، وَلَا أَنَا مِنْهُ ، وَمَنْ لَمْ يُصَدِّقْهُمْ بِكَذِبِهِمْ ، وَلَمْ يُعِنْهُمْ عَلَى ظُلْمِهِمْ فَهُوَ مِنِّي وَأَنَا مِنْهُ  "" .","","Musnad Abi Ya'la al-Mawsili 1286","","أبو سعيد الخدري عن سليمان بن أبي سليمان عن قتادة بن دعامة عن شعبة بن الحجاج عن سعيد بن عامر الضبعي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1286","313 - (  1287  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  الْجُرَيْرِيُّ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا أَتَى أَحَدُكُمْ عَلَى رَاعِي إِبِلٍ فَلْيُنَادِ : يَا رَاعِيَ الْإِبِلِ  ، ثَلَاثًا ، فَإِنْ أَجَابَهُ ، وَإِلَّا فَلْيَحْلِبْ فَيَشْرَبْ ، وَلَا يَحْمِلَنَّ ، وَإِذَا أَتَى أَحَدُكُمْ عَلَى حَائِطِ         [2/466]      بُسْتَانٍ فَلْيُنَادِ ثَلَاثًا : يَا صَاحِبَ الْحَائِطِ ، فَإِنْ أَجَابَهُ وَإِلَّا فَلْيَأْكُلْ وَلَا يَحْمِلْ  .  وَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  الضِّيَافَةُ ثَلَاثَةُ أَيَّامٍ ، فَمَا زَادَ فَهُوَ صَدَقَةٌ  .","","Musnad Abi Ya'la al-Mawsili 1287","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن سعيد بن إياس الجريري عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1287","314 - (  1288  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو الْوَلِيدِ هِشَامُ بْنُ عَبْدِ الْمَلِكِ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  زَيْدُ بْنُ أَسْلَمَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا  تَكْتُبُوا  عَنِّي شَيْئًا غَيْرَ الْقُرْآنِ  ، فَمَنْ كَتَبَ عَنِّي شَيْئًا غَيْرَ الْقُرْآنِ فَلْيَمْحُهُ  "" .         [2/467]","","Musnad Abi Ya'la al-Mawsili 1288","","أبو سعيد الخدري عن عطاء بن يسار الهلالي عن زيد بن أسلم عن همام بن يحيى بن دينار عن أبو الوليد الطيالسي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1288","315 - (  1289  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ نَامَ عَنِ  الْوِتْرِ  أَوْ نَسِيَهُ فَلْيُوتِرْ إِذَا ذَكَرَ أَوِ اسْتَيْقَظَ  "" .","","Musnad Abi Ya'la al-Mawsili 1289","","أبو سعيد الخدري عن عطاء بن يسار الهلالي عن زيد بن أسلم عن عبد الرحمن بن زيد بن أسلم عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1289","316 - (  1290  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  صَالِحٍ قَالَ :  قَالَ  ابْنُ شِهَابٍ :  حَدَّثَنِي  أَبُو أُمَامَةَ بْنُ سَهْلٍ ،  أَنَّهُ سَمِعَ  أَبَا سَعِيدٍ الْخُدْرِيَّ ، يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  بَيْنَمَا أَنَا نَائِمٌ رَأَيْتُ النَّاسَ يُعْرَضُونَ وَعَلَيْهِمْ قُمُصٌ ، مِنْهَا مَا يَبْلُغُ الثُّدِيَّ ، وَمِنْهَا مَا يَبْلُغُ دُونَ ذَلِكَ  . وَمَرَّ  عُمَرُ بْنُ الْخَطَّابِ  عَلَيْهِ قَمِيصٌ يَجُرُّهُ "" . قَالُوا : مَاذَا تَأَوَّلْتَ ذَلِكَ يَا رَسُولَ اللهِ ؟ قَالَ : "" الدِّينُ  "" .         [2/468]","","Musnad Abi Ya'la al-Mawsili 1290","","أبو سعيد الخدري عن أسعد بن سهل بن حنيف عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1290","317 - (  1291  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو بَدْرٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا كَانَ ثَلَاثَةٌ فَلْيَؤُمَّهُمْ أَحَدُهُمْ ، وَأَحَقُّهُمْ بِالْإِمَامَةِ أَقْرَؤُهُمْ  .         [2/469]","","Musnad Abi Ya'la al-Mawsili 1291","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن شجاع بن الوليد السكوني عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1291","318 - (  1292  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الْوَلِيدِ بْنِ مُسْلِمٍ ،  عَنْ  أَبِي الصِّدِّيقِ ،  عَنْ  أَبِي سَعِيدٍ قَالَ :  كُنَّا نَحْزِرُ قِيَامَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الظُّهْرِ وَالْعَصْرِ ،  فَحَزَرْنَا قِيَامَهُ فِي الظُّهْرِ فِي الرَّكْعَتَيْنِ الْأُولَيَيْنِ كَقَدْرِ قِرَاءَةِ ثَلَاثِينَ آيَةً - كَقَدْرِ قِرَاءَةِ :         {      الم             *          تَنْـزِيلُ         }      السَّجْدَةِ  . وَفِي الرَّكْعَتَيْنِ الْأُخْرَيَيْنِ عَلَى النِّصْفِ مِنْ ذَلِكَ . وَحَزَرْنَا قِيَامَهُ فِي الرَّكْعَتَيْنِ الْأُولَيَيْنِ مِنَ الْعَصْرِ عَلَى قَدْرِ الْأُخْرَيَيْنِ مِنَ الظُّهْرِ ، وَالْأُخْرَيَيْنِ مِنَ الْعَصْرِ عَلَى النِّصْفِ مِنْ ذَلِكَ  "" .","","Musnad Abi Ya'la al-Mawsili 1292","","أبو سعيد الخدري عن بكر بن عمرو الناجي عن الوليد بن مسلم العنبري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1292","319 - (  1293  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  حَدَّثَنَا  الْمُسْتَمِرُّ بْنُ الرَّيَّانِ ،  حَدَّثَنَا  أَبُو نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ الدُّنْيَا  خَضِرَةٌ  حُلْوَةٌ ، فَاتَّقُوا اللهَ وَاتَّقُوا النِّسَاءَ  . قَالَ : ثُمَّ ذَكَرَ ثَلَاثَ نِسْوَةٍ كُنَّ فِي  بَنِي إِسْرَائِيلَ  : وَاحِدَةً قَصِيرَةً ، وَثِنْتَيْنِ طَوِيلَتَيْنِ ، فَجَعَلَتْ رِجْلًا مِنْ خَشَبٍ حَتَّى لَحِقَتْ بِهِمَا ، وَاتَّخَذَتْ خَاتَمًا ، وَجَعَلَتْ لَهُ غَلَقًا ، وَحَشَتْهُ بِأَطْيَبِ الطِّيبِ : الْمِسْكِ ، فَكَانَ إِذَا مَرَّتْ عَلَى مَجْلِسٍ فَتَحَتِ الْغَلَقَ فَفَاحَ رِيحُ الْمِسْكِ  .         [2/470]","","Musnad Abi Ya'la al-Mawsili 1293","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن المستمر بن الريان الإيادي عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1293","320 - (  1294  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ دِينَارٍ ،  عَنْ  أَبِي مَسْلَمَةَ سَعِيدِ بْنِ يَزِيدَ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  يَكُونُ  خَلِيفَةٌ  يَحْثِي الْمَالَ لَا يَعُدُّهُ عَدًّا  "" .","","Musnad Abi Ya'la al-Mawsili 1294","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن سعيد بن يزيد الطاحي عن محمد بن دينار الطاحي عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1294","321 - (  1295  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  حُسَيْنُ بْنُ مُحَمَّدٍ ،  عَنْ  شَيْبَانَ قَالَ يَحْيَى :  أَخْبَرَنِي  عَنْ  عَبْدِ اللهِ بْنِ الْفَضْلِ أَنَّ أَبَا صَالِحٍ  أَخْبَرَهُ  ، أَنَّ أَبَا سَعِيدٍ  أَخْبَرَهُ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَرْسَلَ إِلَى  رَجُلٍ  مِنْ أَصْحَابِهِ . قَالَ : فَخَرَجَ إِلَيْهِ الرَّجُلُ فَعَمَدَ إِلَى الْمَشْرَبَةِ فَاغْتَسَلَ فِيهَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَعْجَلْتُكَ ؟ "" فَقَالَ : يَا رَسُولَ اللهِ كُنْتُ بَيْنَ رِجْلَيِ الْمَرْأَةِ ، وَلَمْ أُمْنِ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" فَمَا عَلَيْكَ غُسْلٌ  "" .         [2/471]","","Musnad Abi Ya'la al-Mawsili 1295","","أبو سعيد الخدري عن ذكوان السمان عن عبد الله بن الفضل بن العباس الهاشمي عن يحيى بن أبي كثير عن شيبان بن عبد الرحمن المؤدب عن الحسين بن محمد بن بهرام المروذي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1295","322 - (  1296  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  ابْنُ أَبِي ذِئْبٍ مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنِ  الْمَقْبُرِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  أَبِيهِ  قَالَ :  حُبِسْنَا  يَوْمَ الْخَنْدَقِ  عَنِ الظُّهْرِ ، وَالْعَصْرِ ، وَالْمَغْرِبِ ، وَالْعِشَاءِ ، حَتَّى كُفِينَا ، وَذَلِكَ قَوْلُ اللهِ :         {      وَكَفَى اللهُ الْمُؤْمِنِينَ الْقِتَالَ وَكَانَ اللهُ قَوِيًّا عَزِيزًا         }      ،  فَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَمَرَ  بِلَالًا  فَأَقَامَ  ، ثُمَّ صَلَّى الظُّهْرَ كَمَا كَانَ يُصَلِّيهَا قَبْلَ ذَلِكَ ، ثُمَّ أَقَامَ فَصَلَّى الْعَصْرَ كَمَا كَانَ يُصَلِّيهَا قَبْلَ ذَلِكَ ، ثُمَّ أَقَامَ الْمَغْرِبَ فَصَلَّاهَا كَمَا كَانَ يُصَلِّيهَا قَبْلَ ذَلِكَ ، ثُمَّ أَقَامَ الْعِشَاءَ فَصَلَّاهَا كَمَا كَانَ يُصَلِّيهَا قَبْلَ ذَلِكَ ، وَذَلِكَ قَبْلَ أَنْ يَنْزِلَ :         {      فَإِنْ خِفْتُمْ فَرِجَالًا أَوْ رُكْبَانًا         }      .","","Musnad Abi Ya'la al-Mawsili 1296","","أبو سعيد الخدري عن عبد الرحمن بن أبي سعيد الخدري عن سعيد المقبري عن محمد بن عبد الرحمن بن المغيرة عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1296","323 - (  1297  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  حَدَّثَنَا  الْمُسْتَمِرُّ بْنُ الرَّيَّانِ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا يَمْنَعَنَّ أَحَدَكُمْ مَخَافَةُ  رَجُلٍ - أَوْ مَخَافَةُ بَشَرٍ  - أَنْ يَتَكَلَّمَ بِالْحَقِّ إِذَا رَآهُ ، أَوْ عَلِمَهُ  .  قَالَ أَبُو سَعِيدٍ :  فَلَقِيتُ  مُعَاوِيَةَ  ، فَقُلْتُ لَهُ :  إِنَّهُ لَيْسَ صَاحِبُ         [2/472]      غَدْرٍ إِلَّا لَهُ يَوْمَ الْقِيَامَةِ  لِوَاءُ  غَدْرٍ بِغَدْرَتِهِ  ، وَلَا غَادِرَ أَعْظَمُ مِنْ أَمِيرِ عَامَّةٍ  .","","Musnad Abi Ya'la al-Mawsili 1297","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن المستمر بن الريان الإيادي عن عثمان بن عمر بن فارس عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1297","324 - (  1298  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  حَدَّثَنَا  شَيْبَانُ ،  عَنْ  قَتَادَةَ ،  عَنْ  عُقْبَةَ بْنِ عَبْدِ الْغَافِرِ ،  عَنْ  أَبِي سَعِيدٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ رَجُلًا مِمَّنْ خَلَا مِنَ النَّاسِ  رَغَسَهُ  اللهُ مَالًا وَوَلَدًا  ، فَلَمَّا حَضَرَهُ الْمَوْتُ دَعَا بَنِيهِ ، فَقَالَ : أَيُّ أَبٍ كُنْتُ لَكُمْ ؟ قَالُوا : خَيْرَ أَبٍ ، قَالَ : فَإِنَّهُ وَاللهِ مَا ابْتَأَرَ عِنْدَ اللهِ خَيْرًا قَطُّ ، فَإِذَا مَاتَ  فَأَحْرِقُوهُ  ، حَتَّى إِذَا كَانَ فَحْمًا فَاسْحَقُوهُ ، ثُمَّ اذْرُوهُ فِي يَوْمٍ عَاصِفٍ "" قَالَ : وَقَالَ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَخَذَ مَوَاثِيقَهُمْ عَلَى ذَلِكَ وَرَبِّي ، فَفَعَلُوا وَرَبِّي : لَمَّا مَاتَ أَحْرَقُوهُ ، حَتَّى إِذَا كَانَ فَحْمًا سَحَقُوهُ ، ثُمَّ أَذْرَوْهُ فِي يَوْمٍ عَاصِفٍ ، قَالَ : فَقَالَ لَهُ رَبُّهُ : كُنْ ، فَإِذَا هُوَ رَجُلٌ قَائِمٌ . قَالَ لَهُ رَبُّهُ : مَا حَمَلَكَ عَلَى الَّذِي صَنَعْتَ ؟ قَالَ : رَبِّ خِفْتُ عَذَابَكَ . قَالَ : فَوَالَّذِي نَفْسُ  مُحَمَّدٍ  بِيَدِهِ مَا تَلَافَاهُ عِنْدَهَا أَنْ غَفَرَ لَهُ  .         [2/473]      قَالَ  قَتَادَةُ  :  رَجُلٌ خَافَ عَذَابَ اللهِ فَأَنْجَاهُ اللهُ مِنْ مَخَافَتِهِ  .","","Musnad Abi Ya'la al-Mawsili 1298","","أبو سعيد الخدري عن عقبة بن عبد الغافر العوذي عن قتادة بن دعامة عن شيبان بن عبد الرحمن المؤدب عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1298","325 - (  1299  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  حَدَّثَنَا  سَالِمٌ ، وَعَبْدُ اللهِ بْنُ صُهْبَانَ ، وَكَثِيرٌ النَّوَّاءُ ، وَابْنُ أَبِي لَيْلَى ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ أَهْلَ الدَّرَجَاتِ الْعُلَى لَيَرَاهُمْ مَنْ تَحْتَهُمْ كَمَا تَرَوْنَ النَّجْمَ الطَّالِعَ فِي أُفُقِ السَّمَاءِ  ، وَإِنَّ  أَبَا بَكْرٍ  وَعُمَرَ  مِنْهُمْ  وَأَنْعَمَا  "" .","","Musnad Abi Ya'la al-Mawsili 1299","","أبو سعيد الخدري عن عطية بن سعد العوفي عن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن فضيل بن غزوان عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1299","326 - (  1300  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  مُحَمَّدُ بْنُ جُحَادَةَ ،  عَنِ  الْوَلِيدِ ،  عَنْ  عَبْدِ اللهِ الْبَهِيِّ ،  عَنْ  أَبِي سَعِيدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  يَكُونُ عَلَيْكُمْ أُمَرَاءُ تَطْمَئِنُّ إِلَيْهِمُ الْقُلُوبُ ، وَتَلِينُ لَهُمُ الْجُلُودُ  ، ثُمَّ يَكُونُ عَلَيْكُمْ أُمَرَاءُ تَقْشَعِرُّ مِنْهُمُ الْجُلُودُ ،  وَتَشْمَئِزُّ  مِنْهُمُ الْقُلُوبُ "" . قَالَ : فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ أَفَلَا نُقَاتِلُهُمْ ؟ قَالَ : "" لَا ، مَا أَقَامُوا الصَّلَاةَ  "" .         [2/474]","","Musnad Abi Ya'la al-Mawsili 1300","","أبو سعيد الخدري عن عبد الله البهي مولى مصعب بن الزبير عن الوليد عن محمد بن جحادة الأودي عن عبد الوارث بن سعيد بن ذكوان عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1300","327 - (  1301  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  مَالِكُ بْنُ أَنَسٍ ،  عَنْ  أَيُّوبَ بْنِ حَبِيبٍ مَوْلَى بَنِي زُهْرَةَ ،  عَنْ  أَبِي الْمُثَنَّى الْجُهَنِيِّ قَالَ :  كُنْتُ عِنْدَ  مَرْوَانَ بْنِ الْحَكَمِ  ، فَجَاءَ أَبُو سَعِيدٍ الْخُدْرِيُّ ، فَقَالَ لَهُ  مَرْوَانُ  : سَمِعْتَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَنْهَى عَنِ  النَّفْخِ  فِي الشَّرَابِ ؟ قَالَ : "" نَعَمْ  "" .","","Musnad Abi Ya'la al-Mawsili 1301","","أبو سعيد الخدري عن أبو المثنى الجهني عن أيوب بن حبيب الجمحي عن مالك بن أنس عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1301","328 - (  1302  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ ،  أَخْبَرَنَا  فُضَيْلُ بْنُ مَرْزُوقٍ ،  عَنْ  عَطِيَّةَ ،         [2/475]      عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَلَّهُ أَفْرَحُ بِتَوْبَةِ عَبْدِهِ مِنْ رَجُلٍ أَضَلَّ رَاحِلَتَهُ بِفَلَاةٍ مِنَ الْأَرْضِ  ، فَطَلَبَهَا فَلَمْ يَقْدِرْ عَلَيْهَا ، فَتَسَجَّى لِلْمَوْتِ ، فَبَيْنَمَا هُوَ كَذَلِكَ إِذْ سَمِعَ  وَجْبَةَ  الرَّاحِلَةِ حِينَ بَرَكَتْ ، فَكَشَفَ عَنْ وَجْهِهِ فَإِذَا هُوَ بِرَاحِلَتِهِ  "" .","","Musnad Abi Ya'la al-Mawsili 1302","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1302","329 - (  1303  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  مَالِكُ بْنُ أَنَسٍ ،  عَنْ  إِسْحَاقَ بْنِ عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ ، أَنَّ رَافِعًا مَوْلَى الشِّفَاءِ  أَخْبَرَهُ  قَالَ :  دَخَلْتُ أَنَا  وَعَبْدُ اللهِ بْنُ أَبِي طَلْحَةَ  عَلَى  أَبِي سَعِيدٍ الْخُدْرِيِّ  نَعُودُهُ ،  فَقَالَ لَنَا  أَبُو سَعِيدٍ : "" أَخْبَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنَّ الْمَلَائِكَةَ لَا تَدْخُلُ         [2/476]      بَيْتًا فِيهِ  تَمَاثِيلُ أَوْ صُورَةٌ  .  شَكَّ  إِسْحَاقُ  ، لَا يَدْرِي أَيُّهُمَا قَالَ  أَبُو سَعِيدٍ  .","","Musnad Abi Ya'la al-Mawsili 1303","","أبو سعيد الخدري عن رافع بن إسحاق الأنصاري عن إسحاق بن عبد الله بن أبي طلحة الخزرجي عن مالك بن أنس عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1303","330 - (  1304  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ،  عَنْ  مُطَرِّفٍ ،  عَنْ  خَالِدِ بْنِ أَبِي نَوْفٍ ،  عَنْ  سَلِيطٍ ،  عَنِ  ابْنِ أَبِي سَعِيدٍ ،  عَنْ  أَبِيهِ  قَالَ :  انْتَهَيْتُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَتَوَضَّأُ مِنْ  بِئْرِ بُضَاعَةَ  ، فَقُلْتُ : يَا رَسُولَ اللهِ ، أَتَتَوَضَّأُ مِنْهَا وَهِيَ يُلْقَى فِيهَا مَا يُلْقَى مِنَ النَّتْنِ ؟ فَقَالَ :  إِنَّ الْمَاءَ لَا يُنَجِّسُهُ شَيْءٌ  "" .         [2/477]             [2/478]","","Musnad Abi Ya'la al-Mawsili 1304","","أبو سعيد الخدري عن عبد الرحمن بن أبي سعيد الخدري عن سليط بن أيوب الأنصاري عن خالد السجستاني عن مطرف بن طريف عن عبد العزيز بن مسلم الخراساني عن يونس بن محمد بن مسلم البغدادي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1304","331 - (  1305  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  سَعْدٍ الطَّائِيِّ ،  عَنْ  عَطِيَّةَ الْعَوْفِيِّ ،  عَنْ  أَبِي سَعِيدٍ قَالَ :  ذَكَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  صَاحِبَ الصُّورِ  ، فَقَالَ :  عَنْ يَمِينِهِ  جِبْرِيلُ  ، وَعَنْ يَسَارِهِ  مِيكَائِيلُ  "" .         [2/479]","","Musnad Abi Ya'la al-Mawsili 1305","","أبو سعيد الخدري عن عطية بن سعد العوفي عن سعد أبو مجاهد الطائي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1305","332 - (  1306  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  هِشَامُ بْنُ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَخِيهِ مَعْبَدِ بْنِ سِيرِينَ  قَالَ :  قُلْنَا  لِأَبِي سَعِيدٍ الْخُدْرِيِّ : هَلْ سَمِعْتَ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  الْعَزْلِ  شَيْئًا ؟ قَالَ : سَأَلْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ  الْعَزْلِ  قَالَ : "" وَمَا  الْعَزْلُ  ؟ "" قَالَ : قُلْنَا : الرَّجُلُ تَكُونُ لَهُ الْمَرْأَةُ تُرْضِعُ ، فَيُصِيبُ مِنْهَا وَيَكْرَهُ أَنْ تَحْبَلَ  فَيَعْزِلُ  عَنْهَا ، وَتَكُونُ لَهُ الْجَارِيَةُ فَيُصِيبُ مِنْهَا وَيَكْرَهُ أَنْ تَحْبَلَ  فَيَعْزِلُ  عَنْهَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا عَلَيْكُمْ أَلَّا تَفْعَلُوا ذَلِكَ ، فَإِنَّمَا هُوَ الْقَدَرُ  "" .","","Musnad Abi Ya'la al-Mawsili 1306","","أبو سعيد الخدري عن معبد بن سيرين الأنصاري عن محمد بن سيرين عن هشام بن حسان العتكي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1306","333 - (  1307  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  هِشَامُ بْنُ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَبِي الْعَلَانِيَةِ قَالَ :  سَأَلْنَا  أَبَا سَعِيدٍ الْخُدْرِيَّ عَنْ نَبِيذِ  الْجَرِّ  ، فَقَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ نَبِيذِ  الْجَرِّ  . قَالَ : قُلْنَا :  فَالْجُفُّ  ؟ قَالَ : ذَاكَ شَرٌّ  "" .         [2/480]","","Musnad Abi Ya'la al-Mawsili 1307","","أبو سعيد الخدري عن أبو العلانية المرئي عن محمد بن سيرين عن هشام بن حسان العتكي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1307","334 - (  1308  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ،  عَنْ  أَبِي سَعِيدٍ قَالَ : ""  دَخَلْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يُصَلِّي عَلَى حَصِيرٍ وَيَسْجُدُ عَلَيْهِ  "" .","","Musnad Abi Ya'la al-Mawsili 1308","","أبو سعيد الخدري عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن محمد بن عبيد بن أبي أمية عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1308","335 - (  1309  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي سَعِيدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  أَبْرِدُوا  بِالظُّهْرِ فِي الْحَرِّ  ، فَإِنَّ شِدَّةَ الْحَرِّ مِنْ  فَيْحِ  جَهَنَّمَ  "" .         [2/481]","","Musnad Abi Ya'la al-Mawsili 1309","","أبو سعيد الخدري عن ذكوان السمان عن الأعمش عن محمد بن عبيد بن أبي أمية عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1309","336 - (  1310  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ قَالَ :  كُنْتُ أَمْشِي مَعَ ابْنِ عُمَرَ فِي  الْبَلَاطِ  ، فَمَرَّ بِرَجُلٍ يَجُرُّ إِزَارَهُ ، فَقَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ جَرَّ ثِيَابَهُ مِنَ  الْخُيَلَاءِ  فَإِنَّ اللهَ لَا يَنْظُرُ إِلَيْهِ يَوْمَ الْقِيَامَةِ  قَالَ : قُلْتُ : إِنِّي  سَمِعْتُ  أَبَا سَعِيدٍ الْخُدْرِيَّ يُحَدِّثُ هَذَا الْحَدِيثَ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : "" وَأَنَا سَمِعْتُهُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Musnad Abi Ya'la al-Mawsili 1310","","عبد الله بن عمر بن الخطاب عن أبو سعيد الخدري عن عطية بن سعد العوفي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1310","337 - (  1311  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  حَمَّادٌ ،  أَخْبَرَنَا  عَلِيُّ بْنُ زَيْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،         [2/482]      عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ أَسْوَأَ النَّاسِ سَرِقَةً - قَالَ : الَّذِي يَسْرِقُ صَلَاتَهُ  . قَالُوا : يَا رَسُولَ اللهِ ، كَيْفَ يَسْرِقُهَا ؟ قَالَ : "" لَا يُتِمُّ رُكُوعَهَا وَلَا سُجُودَهَا  "" .","","Musnad Abi Ya'la al-Mawsili 1311","","أبو سعيد الخدري عن سعيد بن المسيب عن علي بن زيد بن جدعان عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1311","338 - (  1312  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَخْبَرَنَا  عَمْرُو بْنُ دِينَارٍ ،  عَنْ  عَتَّابٍ ،  عَنْ  أَبِي سَعِيدٍ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَوْ حَبَسَ اللهُ الْقَطْرَ عَنْ أُمَّتِي عَشْرَ سِنِينَ  ، ثُمَّ أُنْزِلَتْ لَأَصْبَحَتْ طَائِفَةٌ مِنْ أُمَّتِي بِهَا كَافِرِينَ ، يَقُولُونَ : هُوَ  بِنَوْءِ  الْمِجْدَحِ  "" .         [2/483]","","Musnad Abi Ya'la al-Mawsili 1312","","أبو سعيد الخدري عن عتاب بن حنين المكي عن عمرو بن دينار الأثرم عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1312","339 - (  1313  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَخْبَرَنَا  عَطَاءُ بْنُ السَّائِبِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  افْتَخَرَتِ الْجَنَّةُ وَالنَّارُ ، فَقَالَتِ النَّارُ : أَيْ رَبِّ ، يَدْخُلُنِي الْجَبَابِرَةُ وَالْمُلُوكُ وَالْعُظَمَاءُ وَالْأَشْرَافُ  ، وَقَالَتِ الْجَنَّةُ : يَا رَبِّ ، يَدْخُلُنِي الْفُقَرَاءُ  وَالضُّعَفَاءُ  وَالْمَسَاكِينُ ، فَقَالَ اللهُ لِلنَّارِ : أَنْتِ عَذَابِي أُصِيبُ بِكِ مَنْ أَشَاءُ ، وَقَالَ لِلْجَنَّةِ : أَنْتِ رَحْمَتِي وَسِعْتِ كُلَّ شَيْءٍ ، وَلِكُلِّ وَاحِدَةٍ مِنْكُمَا مِلْؤُهَا ، فَأَمَّا النَّارُ فَيُلْقَى فِيهَا أَهْلُهَا ، وَتَقُولُ : هَلْ مِنْ مَزِيدٍ ؟ حَتَّى يَأْتِيَهَا تَبَارَكَ وَتَعَالَى فَتُزْوَى ، وَتَقُولُ :  قَدْنِي  قَدْنِي  . وَأَمَّا الْجَنَّةُ فَيَبْقَى فِيهَا مَا شَاءَ اللهُ أَنْ يَبْقَى ، ثُمَّ يُنْشِئُ اللهُ لَهَا خَلْقًا مِمَّا يَشَاءُ  .         [2/484]","","Musnad Abi Ya'la al-Mawsili 1313","","أبو سعيد الخدري عن عبيد الله بن عبد الله بن عتبة بن مسعود عن عطاء بن السائب عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1313","340 - (  1314  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ رَاشِدٍ مَوْلَى عُثْمَانَ بْنِ عَفَّانَ قَالَ :  سَمِعْتُ  أَبَا سَعِيدٍ الْخُدْرِيَّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ بَيْنَ يَدَيِ الرَّحْمَنِ لَلَوْحًا فِيهِ ثَلَاثُمِائَةٍ وَخَمْسَ عَشْرَةَ شَرِيعَةً  ، يَقُولُ الرَّحْمَنُ : وَعِزَّتِي وَجَلَالِي لَا يَأْتِي عَبْدٌ مِنْ عِبَادِي لَا يُشْرِكُ بِي شَيْئًا فِيهِ وَاحِدَةٌ مِنْهَا ، إِلَّا دَخَلَ الْجَنَّةَ  .","","Musnad Abi Ya'la al-Mawsili 1314","","أبو سعيد الخدري عن عبد الله بن راشد مولى عثمان بن عفان عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1314","341 - (  1315  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  حَدَّثَنَا  حَيْوَةُ ،  أَخْبَرَنَا  سَالِمُ بْنُ غَيْلَانَ ،  أَنَّ الْوَلِيدَ بْنَ قَيْسٍ التُّجِيبِيَّ  أَخْبَرَهُ  ،  أَنَّهُ سَمِعَ  أَبَا سَعِيدٍ الْخُدْرِيَّ ، أَوْ  عَنْ  أَبِي الْهَيْثَمِ  ،  عَنْ  أَبِي سَعِيدٍ         [2/485]      الْخُدْرِيِّ أَنَّهُ سَمِعَ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  لَا تَصْحَبْ إِلَّا مُؤْمِنًا  ، وَلَا يَأْكُلْ طَعَامَكَ إِلَّا تَقِيٌّ  "" .","","Musnad Abi Ya'la al-Mawsili 1315","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن الوليد بن قيس بن الأخرم التجيبي عن سالم بن غيلان التجيبي عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1315","342 - (  1316  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ""  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِابْنِ صَيَّادٍ  : مَا تَرَى ؟ قَالَ : أَرَى عَرْشًا عَلَى الْبَحْرِ حَوْلَهُ الْحَيَّاتُ . فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ذَاكَ عَرْشُ إِبْلِيسَ  "" .","","Musnad Abi Ya'la al-Mawsili 1316","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن علي بن زيد بن جدعان عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1316","343 - (  1317  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  هَمَّامٌ ،  أَخْبَرَنَا  الْمُعَلَّى بْنُ زِيَادٍ ،  حَدَّثَنِي  الْعَلَاءُ - رَجُلٌ مِنْ مُزَيْنَةَ - ،  عَنْ  أَبِي الصِّدِّيقِ النَّاجِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ،  أَنَّهُمْ كَانُوا جُلُوسًا يَقْرَؤُونَ وَيَدْعُونَ ، قَالَ : فَخَرَجَ عَلَيْهِمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : "" فَلَمَّا رَأَيْنَاهُ سَكَتْنَا ، فَقَالَ : "" أَلَيْسَ كُنْتُمْ تَصْنَعُونَ كَذَا وَكَذَا ؟ "" قَالَ : قُلْنَا : نَعَمْ . قَالَ : "" فَاصْنَعُوا كَمَا كُنْتُمْ تَصْنَعُونَ "" . وَجَلَسَ مَعَنَا ، ثُمَّ قَالَ :         [2/486]      أَبْشِرُوا صَعَالِيكَ  الْمُهَاجِرِينَ  بِالْفَوْزِ يَوْمَ الْقِيَامَةِ عَلَى الْأَغْنِيَاءِ بِخَمْسِمِائَةِ سَنَةٍ  ، حَتَّى إِنَّ الْغَنِيَّ وَدَّ أَنَّهُ كَانَ فَقِيرًا ، أَوْ  عَائِلَا  فِي الدُّنْيَا  "" .","","Musnad Abi Ya'la al-Mawsili 1317","","أبو سعيد الخدري عن بكر بن عمرو الناجي عن العلاء بن بشير المزني عن معلى بن زياد القردوسي عن همام بن يحيى بن دينار عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1317","344 - (  1318  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  هَمَّامٌ  عَنْ  قَتَادَةَ  عَنْ  أَبِي الْخَلِيلِ  عَنْ  أَبِي عَلْقَمَةَ الْهَاشِمِيِّ :  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ  أَنَّهُمْ أَصَابُوا يَوْمَ فَتَحُوا  أَوْطَاسَ  نِسَاءً لَهُنَّ أَزْوَاجٌ فَكَرِهَهُنَّ رِجَالٌ مِنْهُمْ  ، فَأَنْزَلَ اللهُ هَذِهِ الْآيَةَ :         {      وَالْمُحْصَنَاتُ مِنَ النِّسَاءِ إِلا مَا مَلَكَتْ أَيْمَانُكُمْ         }      .","","Musnad Abi Ya'la al-Mawsili 1318","","أبو سعيد الخدري عن أبو علقمة الفارسي عن صالح بن أبي مريم الضبعي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1318","345 - (  1319  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِذَا اجْتَمَعَ ثَلَاثَةٌ فَلْيَؤُمَّهُمْ أَحَدُهُمْ ، وَأَحَقُّهُمْ بِالْإِمَامَةِ أَقْرَؤُهُمْ  "" .","","Musnad Abi Ya'la al-Mawsili 1319","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1319","346 - (  1320  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  أَبِي عِيسَى الْأُسْوَارِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  عُودُوا         [2/487]      الْمَرْضَى ، وَاتَّبِعُوا الْجَنَائِزَ تُذَكِّرْكُمُ الْآخِرَةَ  "" .","","Musnad Abi Ya'la al-Mawsili 1320","","أبو سعيد الخدري عن أبو عيسى الأسواري عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1320","347 - (  1321  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  زَجَرَ  عَنِ الشُّرْبِ قَائِمًا  "" .","","Musnad Abi Ya'la al-Mawsili 1321","","أبو سعيد الخدري عن أبو عيسى الأسواري عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1321","348 - (  1322  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي التَّيَّاحِ ،  عَنْ  أَبِي الْوَدَّاكِ قَالَ :  اخْتَلَفْتُ أَنَا وَصَاحِبٌ لِي فِي الْحَنْتَمِ ، فَأَتَيْنَا أَبَا سَعِيدٍ الْخُدْرِيَّ ، فَقُلْنَا لَهُ :  حَدِّثْنَا  بِشَيْءٍ سَمِعْتَهُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْحَنْتَمِ ؟ قَالَ : لَئِنْ قُلْتَ ذَاكَ لَقَدْ كُنَّا أَحْيَانًا عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَّا مَنْ يَحْضُرُهُ يَسْمَعُ مِنْهُ ، وَمِنَّا مَنْ تَشْغَلُهُ الضَّيْعَةُ فَيَجِيءُ وَقَدْ قَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَيَقُولُ : مَاذَا قَالَ ؟ فَنُخْبِرُهُ مَا قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - . وَإِنَّهُ أُتِيَ  بِشَارِبٍ  ذَاتَ يَوْمٍ ، فَنُهِزَ بِالْأَيْدِي وَخُفِقَ بِالنِّعَالِ ، فَقَالَ : يَا رَسُولَ اللهِ ، وَاللهِ مَا شَرِبْتُ خَمْرًا . قَالَ :  فَمَا شَرِبْتَ ؟ "" قَالَ : إِنَّمَا أَخَذْتُ تَمَرَاتٍ وَزَبِيبَاتٍ فَجَعَلْتُهُنَّ فِي دُبَّاءَةٍ لِي  ، فَنَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يُخْلَطَ بَيْنَ التَّمْرِ وَالزَّبِيبِ فِي  الدُّبَّاءِ  وَالْمُزَفَّتِ  .","","Musnad Abi Ya'la al-Mawsili 1322","","أبو سعيد الخدري عن جبر بن نوف البكالي عن يزيد بن حميد الضبعي عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1322","349 - (  1323  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا         [2/488]      إِسْمَاعِيلُ بْنُ مُسْلِمٍ الْعَبْدِيُّ ،  عَنْ  أَبِي الْمُتَوَكِّلِ النَّاجِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ شَرِبَ مِنْكُمُ النَّبِيذَ فَلْيَشْرَبْهُ زَبِيبًا فَرْدًا  ، أَوْ تَمْرًا فَرْدًا ، أَوْ بُسْرًا فَرْدًا  "" .","","Musnad Abi Ya'la al-Mawsili 1323","","أبو سعيد الخدري عن علي بن داود الناجي عن إسماعيل بن مسلم الكيشي عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1323","350 - (  1324  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  الْجُرَيْرِيُّ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  اعْتَكَفَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْعَشْرَ الْأَوْسَطَ مِنْ رَمَضَانَ وَهُوِ يَلْتَمِسُ لَيْلَةَ الْقَدْرِ قَبْلَ أَنْ تُبَيَّنَ ، فَلَمَّا انْقَضَى أَمَرَ  بِبِنَائِهِ  فَنُقِضَ ، ثُمَّ أُبِينَتْ لَهُ أَنَّهَا فِي الْعَشْرِ الْأَوَاخِرِ ، فَأَمَرَ بِالْبِنَاءِ فَأُعِيدَ وَاعْتَكَفَ فِي الْعَشْرِ الْأَوَاخِرِ ، فَخَرَجَ عَلَى النَّاسِ ، فَقَالَ :  يَا أَيُّهَا النَّاسُ إِنَّمَا أُبِينَتْ لِي لَيْلَةُ الْقَدْرِ فَخَرَجْتُ لِأُخْبِرَكُمْ بِهَا فَرَأَيْتُ رَجُلَيْنِ يَخْتَصِمَانِ  مَعَهُمَا الشَّيْطَانُ وَنُسِّيتُهَا ، فَالْتَمِسُوهَا فِي التَّاسِعَةِ ، وَالسَّابِعَةِ ، وَالْخَامِسَةِ ، فَقُلْتُ : يَا  أَبَا سَعِيدٍ  ، إِنَّكُمْ أَعْلَمُ بِالْعَدَدِ مِنَّا ، قَالَ : إِنَّا أَحَقُّ بِذَلِكَ مِنْكُمْ ، فَأَمَّا التَّاسِعَةُ ، وَالسَّابِعَةُ ، وَالْخَامِسَةُ . قَالَ : تَدَعُ الَّتِي تَدْعُونَ : إِحْدَى وَعِشْرِينَ ، وَالَّتِي تَلِيهَا التَّاسِعَةُ ، وَتَدَعُ الَّتِي تَدْعُونَ : ثَلَاثَةً وَعِشْرِينَ ، وَالَّتِي تَلِيهَا السَّابِعَةُ ، وَتَدَعُ الَّتِي تَدْعُونَ : خَمْسًا         [2/489]      وَعِشْرِينَ ، وَالَّتِي تَلِيهَا الْخَامِسَةُ  .","","Musnad Abi Ya'la al-Mawsili 1324","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن سعيد بن إياس الجريري عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1324","351 - (  1325  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي نُعْمٍ قَالَ :  جَاءَ  أَبُو سَعِيدٍ الْخُدْرِيُّ  إِلَى رَجُلٍ ، فَقَالَ لَهُ : أَقَرَأْتَ مَا لَمْ نَقْرَأْ ، وَصَحِبْتَ مَا لَمْ نَصْحَبْ ؟ قَالَ : مَا قَرَأْتُ إِلَّا مَا قَرَأْتُمْ ، وَقَدْ صَحِبْتُمْ ، قَالَ : فَفِيمَ تُفْتِي النَّاسَ : الدِّرْهَمَيْنِ بِثَلَاثٍ ، وَالدِّرْهَمَ بِدِرْهَمَيْنِ ؟ فَقَالَ أَبُو سَعِيدٍ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الذَّهَبُ بِالذَّهَبِ مِثْلًا بِمِثْلٍ ، فَمَا زَادَ فَهُوَ رِبًا  ، وَالْفِضَّةُ بِالْفِضَّةِ مِثْلًا بِمِثْلٍ ، فَمَا زَادَ فَهُوَ رِبًا "" . قَالَ : سَمِعْتُهُ بَعْدُ يَقُولُ : اللَّهُمَّ إِنِّي أَتُوبُ إِلَيْكَ مِمَّا كُنْتُ أُفْتِي بِهِ النَّاسَ فِي الصَّرْفِ  .","","Musnad Abi Ya'la al-Mawsili 1325","","أبو سعيد الخدري عن عبد الرحمن بن أبي نعم البجلي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1325","352 - (  1326  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  شَهْرٍ قَالَ :  أَقْبَلْتُ أَنَا وَرِجَالٌ مِنْ عُمْرَةٍ ، فَمَرَرْنَا بِأَبِي سَعِيدٍ الْخُدْرِيِّ ، فَدَخَلْنَا عَلَيْهِ ، فَقَالَ : أَيْنَ تُرِيدُونَ ؟ قُلْتُ : نُرِيدُ  الطُّورَ .  قَالَ : وَمَا  الطُّورُ  ؟  سَمِعْتُ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تُشَدُّ رِحَالُ  الْمَطِيِّ  إِلَى مَسْجِدٍ يُذْكَرُ اللهُ فِيهِ ، إِلَّا إِلَى ثَلَاثَةِ مَسَاجِدَ  :  مَسْجِدِ الْحَرَامِ  ،  وَمَسْجِدِ الْمَدِينَةِ  ،  وَبَيْتِ الْمَقْدِسِ  . وَلَا تَصْلُحُ الصَّلَاةُ فِي سَاعَتَيْنِ مِنَ النَّهَارِ : بَعْدَ الْفَجْرِ حَتَّى تَطْلُعَ الشَّمْسُ ، وَبَعْدَ الْعَصْرِ حَتَّى تَغِيبَ الشَّمْسُ . وَلَا         [2/490]      يَصْلُحُ الصَّوْمُ فِي يَوْمَيْنِ مِنَ السَّنَةِ : يَوْمِ الْفِطْرِ مِنْ رَمَضَانَ ، وَيَوْمِ الْأَضْحَى مِنْ ذِي الْحِجَّةِ . وَلَا تُسَافِرُ الْمَرْأَةُ سَفَرًا فِي الْإِسْلَامِ إِلَّا مَعَ بَعْلٍ أَوْ ذِي  مَحْرَمٍ  "" .","","Musnad Abi Ya'la al-Mawsili 1326","","أبو سعيد الخدري عن شهر بن حوشب عن ليث بن أبي سليم عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1326","353 - (  1327  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  دَخَلَ رَجُلَانِ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَأَلَاهُ فِي ثَمَنِ بَعِيرٍ ، فَأَعَانَهُمَا بِدِينَارَيْنِ ، فَخَرَجَا مِنْ عِنْدِهِ فَلَقِيَهُمَا  عُمَرُ  ، فَقَالَا وَأَثْنَيَا مَعْرُوفًا وَشَكَرَا مَا صَنَعَ بِهِمَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَدَخَلَ  عُمَرُ  عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخْبَرَهُ بِمَا قَالَا ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَكِنْ فُلَانٌ أَعْطَيْتُهُ مَا بَيْنَ الْعَشَرَةِ إِلَى الْمِائَةِ فَلَمْ يَقُلْ ذَلِكَ  . إِنَّ أَحَدَهُمْ يَسْأَلُنِي فَيَنْطَلِقُ بِمَسْأَلَتِهِ مُتَأَبِّطَهَا ، وَمَا هِيَ إِلَّا نَارٌ "" . فَقَالَ  عُمَرُ  : تُعْطِينَا مَا هُوَ نَارٌ ؟ قَالَ : يَأْبَوْنَ إِلَّا أَنْ يَسْأَلُونِي ، وَيَأْبَى اللهُ لِيَ الْبُخْلَ  "" .","","Musnad Abi Ya'la al-Mawsili 1327","","أبو سعيد الخدري عن عطية بن سعد العوفي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1327","354 - (  1328  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ         [2/491]      الْأَزْدِيُّ ،  حَدَّثَنَا  صَدَقَةُ صَاحِبُ الدَّقِيقِ ،  حَدَّثَنَا  مَالِكُ بْنُ دِينَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ غَالِبٍ الْأَزْدِيِّ ،  عَنْ  أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  خَصْلَتَانِ  لَا تَجْتَمِعَانِ فِي مُؤْمِنٍ : سُوءُ  الْخُلُقِ  ، وَالْبُخْلُ  "" .","","Musnad Abi Ya'la al-Mawsili 1328","","أبو سعيد الخدري عن عبد الله بن غالب الحداني عن مالك بن دينار الناجي عن صدقة بن موسى الدقيقي عن مسلم بن إبراهيم الشحام عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1328","355 - (  1329  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  حَدَّثَنَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ قَالَ :  سَمِعْتُ  دَرَّاجًا أَبَا السَّمْحِ يَقُولُ :  سَمِعْتُ  أَبَا الْهَيْثَمِ يَقُولُ :  سَمِعْتُ  أَبَا سَعِيدٍ الْخُدْرِيَّ يَقُولُ : ""  يُسَلَّطُ عَلَى الْكَافِرِ فِي قَبْرِهِ تِسْعَةٌ وَتِسْعُونَ تِنِّينًا تَنْهَشُهُ وَتَلْدَغُهُ حَتَّى تَقُومَ السَّاعَةُ  ، فَلَوْ أَنَّ تِنِّينًا مِنْهَا نَفَخَتْ فِي الْأَرْضِ مَا نَبَتَتْ خَضْرَاءُ  "" .","","Musnad Abi Ya'la al-Mawsili 1329","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1329","356 - (  1330  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  أَخْبَرَنَا  حَيْوَةُ ،  أَخْبَرَنِي  سَالِمُ بْنُ غَيْلَانَ ،  أَنَّهُ سَمِعَ  دَرَّاجًا أَبَا السَّمْحِ ،  أَنَّهُ سَمِعَ  أَبَا الْهَيْثَمِ ،  أَنَّهُ سَمِعَ  أَبَا سَعِيدٍ الْخُدْرِيَّ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [2/492]      يَقُولُ : ""  أَعُوذُ بِاللهِ مِنَ الْكُفْرِ وَالدَّيْنِ  . فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ تَعْدِلُ الدَّيْنَ بِالْكُفْرِ ؟ قَالَ : "" نَعَمْ  "" .","","Musnad Abi Ya'la al-Mawsili 1330","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن سالم بن غيلان التجيبي عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1330","357 - (  1331  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  إِنَّ اللهَ إِذَا رَضِيَ عَنِ الْعَبْدِ أَثْنَى عَلَيْهِ تِسْعَةُ أَصْنَافٍ مِنَ الْخَيْرِ لَمْ يَعْمَلْهُ  ، وَإِنْ  سَخِطَ  عَلَى الْعَبْدِ أَثْنَى عَلَيْهِ تِسْعَةُ أَصْنَافٍ مِنَ الشَّرِّ لَمْ يَعْمَلْهُ  "" .","","Musnad Abi Ya'la al-Mawsili 1331","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن سالم بن غيلان التجيبي عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1331","358 - (  1332  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  حَدَّثَنَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ الْوَلِيدِ ،  عَنْ  أَبِي سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَثَلُ الْمُؤْمِنِ وَمَثَلُ الْإِيمَانِ كَمَثَلِ الْفَرَسِ فِي  آخِيَّتِهِ  ، يَجُولُ ثُمَّ يَرْجِعُ إِلَى  آخِيَّتِهِ  . وَإِنَّ الْمُؤْمِنَ يَسْهُو ، ثُمَّ يَرْجِعُ إِلَى الْإِيمَانِ ، فَأَطْعِمُوا         [2/493]      طَعَامَكُمُ الْأَتْقِيَاءَ ، وَأَوْلُوا مَعْرُوفَكُمُ الْمُؤْمِنِينَ  "" .","","Musnad Abi Ya'la al-Mawsili 1332","","أبو سعيد الخدري عن أبو سليمان الليثي عن عبد الله بن الوليد بن قيس التجيبي عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1332","359 - (  1333  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  أَخْبَرَنَا  شَيْبَانُ ،  عَنْ  فِرَاسٍ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا تَحِلُّ الصَّدَقَةُ لِغَنِيٍّ  ، إِلَّا أَنْ يَكُونَ لَهُ جَارٌ فَقِيرٌ فَيَدَعُوَهُ فَيَأْكُلَ مَعَهُ ، أَوِ ابْنِ السَّبِيلِ ، أَوْ فِي  سَبِيلِ  اللهِ  "" .","","Musnad Abi Ya'la al-Mawsili 1333","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فراس بن يحيى الخارفي عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1333","360 - (  1334  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنْ نَبِيِّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ : ""  نَارُكُمْ هَذِهِ جُزْءٌ مِنْ سَبْعِينَ جُزْءًا مِنْ نَارِ  جَهَنَّمَ  ، لِكُلِّ جُزْءٍ مِنْهَا حَرُّهَا  "" .","","Musnad Abi Ya'la al-Mawsili 1334","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فراس بن يحيى الخارفي عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1334","361 - (  1335  ) -  وَعَنْ  أَبِي سَعِيدٍ ، عَنْ نَبِيِّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  رُؤْيَا الْمُسْلِمِ الصَّالِحِ  جُزْءٌ  مِنْ سَبْعِينَ  جُزْءًا  مِنَ النُّبُوَّةِ  "" .         [2/494]","","Musnad Abi Ya'la al-Mawsili 1335","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فراس بن يحيى الخارفي عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1335","362 - (  1336  ) -  وَعَنْ  أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ : ""  الْمُجَاهِدُ فِي  سَبِيلِ  اللهِ مَضْمُونٌ عَلَى اللهِ : إِمَّا أَنْ يَكْفِتَهُ إِلَى مَغْفِرَتِهِ وَرَحْمَتِهِ  ، وَإِمَّا أَنْ يُرْجِعَهُ بِأَجْرٍ وَغَنِيمَةٍ ، وَمَثَلُ الْمُجَاهِدِ فِي  سَبِيلِ  اللهِ كَمَثَلِ الصَّائِمِ الْقَائِمِ لَا يَفْتُرُ حَتَّى يَرْجِعَ  "" .","","Musnad Abi Ya'la al-Mawsili 1336","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فراس بن يحيى الخارفي عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1336","363 - (  1337  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  حَدَّثَنَا  شَيْبَانُ ،  عَنْ  فِرَاسٍ ،  عَنْ  عَطِيَّةَ ،         [2/495]      عَنْ  أَبِي سَعِيدٍ ، عَنْ نَبِيِّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  اجْتَنِبُوا دَعَوَاتِ الْمَظْلُومِ  وَقَالَ  عَطِيَّةُ  :  قَالَ  رَجُلٌ مِنْ أَهْلِ خُرَاسَانَ :  قَالَ  أَبُو هُرَيْرَةَ : مَا بَيْنَهَا وَبَيْنَ اللهِ حِجَابٌ  "" .","","Musnad Abi Ya'la al-Mawsili 1337","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فراس بن يحيى الخارفي عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1337","364 - (  1338  ) -  وَعَنْ  أَبِي سَعِيدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  يُقَالُ لِصَاحِبِ الْقُرْآنِ إِذَا دَخَلَ الْجَنَّةَ : اقْرَأْ وَاصْعَدْ  ، فَيَقْرَأُ وَيَصْعَدُ بِكُلِّ آيَةٍ دَرَجَةً حَتَّى يَقْرَأَ آخِرَ شَيْءٍ مَعَهُ  "" .","","Musnad Abi Ya'la al-Mawsili 1338","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فراس بن يحيى الخارفي عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1338","365 - (  1339  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ الْوَلِيدِ الْوَصَّافِيُّ ،  عَنْ  عَطِيَّةَ الْعَوْفِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ قَالَ حِينَ يَأْوِي إِلَى فِرَاشِهِ : أَسْتَغْفِرُ اللهَ الَّذِي لَا إِلَهَ إِلَّا هُوَ الْحَيَّ الْقَيُّومَ  ، - ثَلَاثَ مَرَّاتٍ - وَأَتُوبُ إِلَيْهِ ، كَفَّرَ اللهُ ذُنُوبَهُ وَإِنْ كَانَتْ مِثْلَ         [2/496]      زَبَدِ الْبَحْرِ  "" .","","Musnad Abi Ya'la al-Mawsili 1339","","أبو سعيد الخدري عن عطية بن سعد العوفي عن عبيد الله بن الوليد الوصافي عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1339","366 - (  1340  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ يُنْتَبَذَ فِي  الْحَنْتَمِ  ،  وَالدُّبَّاءِ  ،  وَالنَّقِيرِ  ، وَأَنْ يُخْلَطَ الزَّهْوُ بِالتَّمْرِ ، وَالزَّبِيبُ بِالتَّمْرِ  "" .","","Musnad Abi Ya'la al-Mawsili 1340","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1340","367 - (  1341  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ شَرْفَى مَوْلَى ابْنِ عُمَرَ ، قَالَ :  حَدَّثَنِي  أَبُو بَكْرِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  قَالَ :  حَدَّثَنِي  أَبُو سَعِيدٍ الْخُدْرِيُّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَا بَيْنَ قَبْرِي وَمِنْبَرِي رَوْضَةٌ مِنْ رِيَاضِ الْجَنَّةِ  "" .         [2/497]","","Musnad Abi Ya'la al-Mawsili 1341","","أبو سعيد الخدري عن عبد الله بن عمر بن الخطاب عن أبو بكر بن عمر بن عبد الرحمن بن عبد الله بن عمر بن الخطاب عن إسحاق بن شرفي مولى ابن عمر بن الخطاب عن عبد الواحد بن زياد عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1341","368 - (  1342  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  ابْنِ إِسْحَاقَ ،  حَدَّثَنِي  عِيسَى بْنُ عَبْدِ اللهِ بْنِ مَالِكٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  إِذَا أَرَادَ أَحَدُكُمْ أَمْرًا ، فَلْيَقُلِ : اللَّهُمَّ إِنِّي أَسْتَخِيرُكَ بِعِلْمِكَ ،  وَأَسْتَقْدِرُكَ  بِقُدْرَتِكَ  ، وَأَسْأَلُكَ مِنْ فَضْلِكَ ، فَإِنَّكَ تَقْدِرُ وَلَا أَقْدِرُ ، وَتَعْلَمُ وَلَا أَعْلَمُ ، وَأَنْتَ عَلَّامُ الْغُيُوبِ . اللَّهُمَّ إِنْ كَانَ كَذَا وَكَذَا - مِنَ الْأَمْرِ الَّذِي يُرِيدُ - لِي خَيْرًا فِي دِينِي ، وَمَعِيشَتِي ، وَعَاقِبَةِ أَمْرِي ، وَإِلَّا فَاصْرِفْهُ عَنِّي ، وَاصْرِفْنِي عَنْهُ ، ثُمَّ قَدِّرْ لِيَ الْخَيْرَ أَيْنَمَا كَانَ ، لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ  "" .         [2/498]","","Musnad Abi Ya'la al-Mawsili 1342","","أبو سعيد الخدري عن عطاء بن يسار الهلالي عن محمد بن عمرو بن عطاء العامري عن عيسى بن عبد الله مولى عمر بن الخطاب عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1342","369 - (  1343  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مَسْلَمَةَ بْنِ قَعْنَبٍ ،  حَدَّثَنَا  دَاوُدُ بْنُ قَيْسٍ الْفَرَّاءُ ،  عَنْ  عِيَاضِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِي سَعِيدٍ قَالَ :  كَانَ يَخْرُجُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ الْعِيدِ - يَوْمَ الْفِطْرِ - فَيُصَلِّي بِالنَّاسِ تَيْنِكَ الرَّكْعَتَيْنِ ، ثُمَّ يُسَلِّمُ وَيَقُومُ فَيَسْتَقْبِلُ النَّاسَ وَهُمْ جُلُوسٌ ، فَيَقُولُ :  تَصَدَّقُوا تَصَدَّقُوا  ثَلَاثَ مِرَارٍ ، وَكَانَ أَكْثَرَ مَنْ يَتَصَدَّقُ النِّسَاءُ  بِالْقُرْطِ  ، وَالْخَاتَمِ وَالشَّيْءِ ، فَإِنْ كَانَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَاجَةٌ ، أَوْ يَضْرِبُ لِلنَّاسِ بَعْثًا ذَكَرَهُ لَهُمْ ، وَإِلَّا انْصَرَفَ  .         [2/499]","","Musnad Abi Ya'la al-Mawsili 1343","","أبو سعيد الخدري عن عياض بن عبد الله بن سعد العامري عن داود بن قيس الدباغ عن عبد الله بن مسلمة القعنبي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1343","370 - (  1344  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مَسْلَمَةَ بْنِ قَعْنَبٍ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  نَهَارٍ الْعَبْدِيِّ ،  أَنَّهُ سَمِعَ  أَبَا سَعِيدٍ الْخُدْرِيَّ يَذْكُرُ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ اللهَ يَسْأَلُ عَنِ الْعَبْدِ يَوْمَ الْقِيَامَةِ حَتَّى يَقُولَ : مَا مَنَعَكَ إِذْ رَأَيْتَ الْمُنْكَرَ أَنْ تُنْكِرَهُ ؟  فَإِذَا اللهُ لَقَّنَ عَبْدَهُ حُجَّتَهُ قَالَ : رَبِّ وَثِقْتُ بِكَ وَفَرِقْتُ النَّاسَ  "" .","","Musnad Abi Ya'la al-Mawsili 1344","","أبو سعيد الخدري عن نهار بن عبد الله القيسي عن عبد الله بن عبد الرحمن بن معمر الأنصاري عن سليمان بن بلال القرشي عن عبد الله بن مسلمة القعنبي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1344","371 - (  1345  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ يُوسُفَ ،  حَدَّثَنَا  عَوْفٌ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  تَفْتَرِقُ أُمَّتِي فِرْقَتَيْنِ  ،  فَتَمْرُقُ  بَيْنَهُمَا  مَارِقَةٌ  يَقْتُلُهَا أَوْلَى الطَّائِفَتَيْنِ بِالْحَقِّ  "" .","","Musnad Abi Ya'la al-Mawsili 1345","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن عوف بن أبي جميلة عن إسحاق بن يوسف الأزرق عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1345","372 - (  1346  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  حُسَيْنُ بْنُ مُحَمَّدٍ ،         [2/500]      حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  عَبْدِ اللهِ بْنِ عِصْمَةَ قَالَ :  سَمِعْتُ  أَبَا سَعِيدٍ الْخُدْرِيَّ ، يَقُولُ :  أَخَذَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الرَّايَةَ  فَهَزَّهَا ، ثُمَّ قَالَ :  مَنْ يَأْخُذُهَا بِحَقِّهَا ؟ "" فَجَاءَ  الزُّبَيْرُ  ، فَقَالَ : أَنَا  ، فَقَالَ : ""  أَمِطْ  "" ، ثُمَّ قَامَ  رَجُلٌ  آخَرُ ، فَقَالَ : أَنَا ، فَقَالَ : ""  أَمِطْ  "" ، ثُمَّ قَامَ  آخَرُ  قَالَ : أَنَا ، فَقَالَ : ""  أَمِطْ  "" ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" وَالَّذِي أَكْرَمَ وَجْهَ  مُحَمَّدٍ  لَأُعْطِيَنَّهَا رَجُلًا لَا يَفِرُّ بِهَا ، هَاكَ يَا  عَلِيُّ  "" . فَقَبَضَهَا ، ثُمَّ انْطَلَقَ حَتَّى فَتَحَ اللهُ  فَدَكَ  وَخَيْبَرَ  ، وَجَاءَ  بِعَجْوَتِهَا  وَقَدِيدِهَا  .","","Musnad Abi Ya'la al-Mawsili 1346","","أبو سعيد الخدري عن عبد الله بن عصم اليمامي عن إسرائيل بن يونس بن أبي إسحاق عن الحسين بن محمد بن بهرام المروذي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1346","373 - (  1347  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  زَكَرِيَّا بْنُ عَدِيٍّ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : ""  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَطْعَمُ يَوْمَ الْفِطْرِ قَبْلَ أَنْ يَخْرُجَ  ، وَلَا يُصَلِّي قَبْلَ الصَّلَاةِ ، فَإِذَا انْصَرَفَ صَلَّى رَكْعَتَيْنِ  "" .         [2/501]","","Musnad Abi Ya'la al-Mawsili 1347","","أبو سعيد الخدري عن عطاء بن يسار الهلالي عن عبد الله بن محمد بن عقيل بن أبي طالب عن عبيد الله بن عمرو بن أبي الوليد عن زكريا بن عدي بن رزيق عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1347","374 - (  1348  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  حَدَّثَنَا  شَيْبَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَفِي يَدِهِ أَكْمُؤٌ ، فَقَالَ :  هَؤُلَاءِ مِنَ الْمَنِّ  ، وَمَاؤُهُنَّ شِفَاءٌ لِلْعَيْنِ  "" .         [2/502]","","Musnad Abi Ya'la al-Mawsili 1348","","أبو سعيد الخدري عن عبد الرحمن بن أبي ليلى عن المنهال بن عمرو الأسدي عن الأعمش عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1348","375 - (  1349  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  عُمَرَ بْنِ الْحَكَمِ بْنِ ثَوْبَانَ ،  أَنَّ  أَبَا سَعِيدٍ الْخُدْرِيَّ قَالَ :  بَعَثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَلْقَمَةَ بْنَ مُجَزِّزٍ  عَلَى بَعْثٍ أَنَا فِيهِمْ ، فَخَرَجْنَا حَتَّى إِذَا كُنَّا عَلَى  رَأْسِ غَزَاتِنَا أَوْ فِي بَعْضِ الطَّرِيقِ  ، فَاسْتَأْذَنَهُ طَائِفَةٌ فَأَذِنَ لَهُمْ ، وَأَمَّرَ عَلَيْهِمْ  عَبْدَ اللهِ بْنَ حُذَافَةَ  ، وَكَانَ مِنْ أَصْحَابِ بَدْرٍ ، وَكَانَتْ فِيهِ  دُعَابَةٌ  ، فَكُنْتُ فِيمَنْ رَجَعَ مَعَهُ ، فَبَيْنَمَا نَحْنُ فِي بَعْضِ الطَّرِيقِ فَنَزَلْنَا مَنْزِلَنَا وَأَوْقَدَ  الْقَوْمُ  نَارًا يَصْطَلُونَ بِهَا ، أَوْ يَصْنَعُونَ عَلَيْهَا صَنِيعًا لَهُمْ ، إِذْ قَالَ لَهُمْ  عَبْدُ اللهِ  : أَلَيْسَ لِي عَلَيْكُمُ السَّمْعُ وَالطَّاعَةُ ؟ قَالُوا : بَلَى ، قَالَ : فَمَا أَنَا بِآمِرِكُمْ مِنْ شَيْءٍ إِلَّا فَعَلْتُمُوهُ ؟ قَالُوا : بَلَى . قَالَ : فَإِنِّي  أَعْزِمُ  عَلَيْكُمْ بِحَقِّي وَطَاعَتِي إِلَّا تَوَاثَبْتُمْ فِي هَذِهِ النَّارِ ، قَالَ : فَقَامَ نَاسٌ فَتَحَجَّزُوا ، حَتَّى إِذَا ظَنَّ أَنَّهُمْ وَاثِبُونَ فِيهَا ، قَالَ : أَمْسِكُوا عَلَيْكُمْ أَنْفُسَكُمْ ، وَإِنَّمَا كُنْتُ أَضْحَكُ مَعَكُمْ ، فَلَمَّا قَدِمُوا عَلَى نَبِيِّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَكَرُوا ذَلِكَ لَهُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَمَرَكُمْ مِنْهُمْ بِمَعْصِيَةٍ فَلَا تُطِيعُوهُ  "" .         [2/503]","","Musnad Abi Ya'la al-Mawsili 1349","","أبو سعيد الخدري عن عمر بن الحكم بن ثوبان الحجازي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1349","376 - (  1350  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  سُفْيَانُ الثَّوْرِيُّ ، وَحَمَّادُ بْنُ سَلَمَةَ جَمِيعًا ،  عَنْ  عَمْرِو بْنِ يَحْيَى ،  عَنْ  أَبِيهِ  - قَالَ  حَمَّادٌ  فِي حَدِيثِهِ :  عَنْ  أَبِي سَعِيدٍ - وَلَمْ يُجَاوِزْ  سُفْيَانُ  أَبَاهُ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  الْأَرْضُ كُلُّهَا مَسْجِدٌ  إِلَّا الْمَقْبَرَةَ وَالْحَمَّامَ  "" .","","Musnad Abi Ya'la al-Mawsili 1350","","أبو سعيد الخدري عن يحيى بن عمارة المازني عن عمرو بن يحيى بن عمارة المازني عن حماد بن سلمة عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1350","377 - (  1351  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  ابْنِ إِسْحَاقَ ،  حَدَّثَنِي  عَاصِمُ بْنُ عُمَرَ بْنِ قَتَادَةَ         [2/504]      الْأَنْصَارِيُّ ، ثُمَّ الظَّفَرِيُّ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ أَحَدِ بَنِي عَبْدِ الْأَشْهَلِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  يُفْتَحُ  يَأْجُوجُ  وَمَأْجُوجُ  عَلَى النَّاسِ  ، كَمَا قَالَ اللهُ :         {      وَهُمْ مِنْ كُلِّ حَدَبٍ يَنْسِلُونَ         }      ، فَيَغْشَوْنَ النَّاسَ ، وَيَنْحَازُ الْمُسْلِمُونَ عَنْهُمْ إِلَى مَدَائِنِهِمْ وَحُصُونِهِمْ ، وَيَضُمُّونَ إِلَيْهِمْ مَوَاشِيَهُمْ ، وَيَشْرَبُونَ مِيَاهَ الْأَرْضِ حَتَّى إِنَّ بَعْضَهُمْ لَيَمُرُّ بِالنَّهَرِ فَيَشْرَبُونَ مَا فِيهِ حَتَّى يَتْرَكُوا يَبَسًا ، حَتَّى إِنَّ مَنْ بَعْدَهُمْ لَيَمُرُّ بِذَلِكَ النَّهَرِ ، فَيَقُولُ : قَدْ كَانَ هَاهُنَا مَاءٌ مَرَّةً ، حَتَّى إِذَا لَمْ يَبْقَ مِنَ النَّاسِ إِلَّا أَحَدٌ فِي حِصْنٍ أَوْ مَدِينَةٍ قَالَ قَائِلُهُمْ : هَؤُلَاءِ أَهْلُ الْأَرْضِ قَدْ فَرَغْنَا مِنْهُمْ ، بَقِيَ أَهْلُ السَّمَاءِ ، قَالَ : ثُمَّ يَهُزُّ أَحَدُهُمْ حَرْبَتَهُ ، ثُمَّ يَرْمِي بِهَا إِلَى السَّمَاءِ فَتَرْجِعُ إِلَيْهِ مُتَخَضِّبَةً دَمًا ؛ لِلْبَلَاءِ وَالْفِتْنَةِ ، فَبَيْنَمَا هُمْ عَلَى ذَلِكَ بَعَثَ اللهُ دُودًا فِي أَعْنَاقِهِمْ  كَنَغَفِ  الْجَرَادِ الَّذِي يَخْرُجُ فِي أَعْنَاقِهِمْ ، فَيُصْبِحُونَ مَوْتَى لَا يُسْمَعُ لَهُمْ حِسٌّ ، فَيَقُولُ الْمُسْلِمُونَ : أَلَا رَجُلٌ يَشْتَرِي لَنَا نَفْسَهُ فَيَنْظُرَ مَا فَعَلَ هَؤُلَاءِ الْعَدُوُّ ؟ قَالَ : فَتَجَرَّدَ رَجُلٌ مِنْهُمْ لِذَلِكَ مُحْتَسِبًا لِنَفْسِهِ قَدْ أَطَابَهَا عَلَى أَنَّهُ مَقْتُولٌ ، فَيَجِدُهُمْ مَوْتَى بَعْضُهُمْ عَلَى بَعْضٍ ، فَيُنَادِي : يَا مَعْشَرَ الْمُسْلِمِينَ أَلَا أَبْشِرُوا ، فَإِنَّ اللهَ قَدْ كَفَاكُمْ عَدُوَّكُمْ . فَيَخْرُجُونَ مِنْ مَدَائِنِهِمْ وَحُصُونِهِمْ وَيُسَرِّحُونَ مَوَاشِيَهُمْ ، فَلَا يَكُونُ لَهَا رَعْيٌ إِلَّا لُحُومَهُمْ ، فَتَشْكَرُ كَأَحْسَنِ مَا شَكِرَتْ عَنْ شَيْءٍ مِنَ النَّبَاتِ أَصَابَتْهُ قَطُّ  "" .         [2/505]","","Musnad Abi Ya'la al-Mawsili 1351","","أبو سعيد الخدري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1351","378 - (  1352  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  صَالِحٍ  قَالَ  ابْنُ شِهَابٍ :  أَخْبَرَنِي  عَطَاءُ بْنُ يَزِيدَ الْجُنْدَعِيُّ ، أَنَّ أَبَا سَعِيدٍ الْخُدْرِيَّ  أَخْبَرَهُ  ،  أَنَّ نَاسًا مِنَ  الْأَنْصَارِ  سَأَلُوا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمْ يَسْأَلْهُ أَحَدٌ إِلَّا أَعْطَاهُ حَتَّى نَفِدَ مَا عِنْدَهُ ، فَلَمَّا أَنْفَقَ كُلَّ شَيْءٍ عِنْدَهُ قَالَ :  مَا يَكُونُ عِنْدِي مِنْ خَيْرٍ فَلَنْ  أَدَّخِرَهُ  عَنْكُمْ  ، وَإِنَّهُ مَنْ يَسْتَعِفَّ يُعِفَّهُ اللهُ ، وَمَنْ يَسْتَغْنِ يُغْنِهِ اللهُ ، وَمَنْ يَصْطَبِرْ يُصَبِّرْهُ اللهُ ، وَلَمْ تُعْطَوْا عَطَاءً خَيْرًا وَلَا أَوْسَعَ مِنَ الصَّبْرِ  "" .","","Musnad Abi Ya'la al-Mawsili 1352","","أبو سعيد الخدري عن عطاء بن يزيد الجندعي عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1352","379 - (  1353  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  عَطِيَّةَ الْعَوْفِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فِي قَوْلِهِ :         {      يَوْمَ يَأْتِي بَعْضُ آيَاتِ رَبِّكَ لا يَنْفَعُ نَفْسًا إِيمَانُهَا         }      قَالَ :  طُلُوعُ الشَّمْسِ مِنْ مَغْرِبِهَا  "" .         [2/506]","","Musnad Abi Ya'la al-Mawsili 1353","","أبو سعيد الخدري عن عطية بن سعد العوفي عن محمد بن عبد الرحمن بن أبي ليلى عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1353","380 - (  1354  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُعَلَّى بْنُ مَنْصُورٍ ،  أَخْبَرَنِي  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  أَخْبَرَنِي  دَاوُدُ بْنُ صَالِحٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  قَدِمَ  نَبَطِيٌّ مِنَ الشَّامِ  بِثَلَاثِينَ حِمْلَ شَعِيرٍ وَتَمْرٍ فِي زَمَنِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَعَّرَ ، يَعْنِي مُدًّا بِدِرْهَمٍ بِمُدِّ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَيْسَ فِي النَّاسِ يَوْمَئِذٍ طَعَامٌ غَيْرُهُ ، فَشَكَا النَّاسُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غَلَاءَ السِّعْرِ ، فَخَطَبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  أَلَا لَأَلْقَيَنَّ اللهَ تَبَارَكَ وَتَعَالَى قَبْلَ أَنْ أُعْطِيَ أَحَدًا  مِنْ مَالِ أَحَدٍ بِغَيْرِ طِيبِ نَفْسِهِ  "" .         [2/507]","","Musnad Abi Ya'la al-Mawsili 1354","","أبو سعيد الخدري عن صالح بن دينار التمار عن داود بن صالح التمار عن عبد العزيز بن محمد الدراوردي عن معلى بن منصور الرازي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1354","381 - (  1355  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  حَدَّثَنَا  زُهَيْرُ بْنُ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  أَلَا أَدُلُّكُمْ عَلَى شَيْءٍ يُكَفِّرُ اللهُ بِهِ الْخَطَايَا وَيَزِيدُ فِي الْحَسَنَاتِ ؟  قَالُوا : بَلَى يَا رَسُولَ اللهِ . قَالَ : إِسْبَاغُ الْوُضُوءِ فِي  الْمَكَارِهِ  ، وَكَثْرَةُ  الْخُطَا  إِلَى الْمَسَاجِدِ ، وَانْتِظَارُ الصَّلَاةِ بَعْدَ الصَّلَاةِ ، مَا مِنْكُمْ مِنْ رَجُلٍ يَخْرُجُ مِنْ بَيْتِهِ مُتَطَهِّرًا فَيُصَلِّي مَعَ الْمُسْلِمِينَ الصَّلَاةَ الْجَامِعَةَ ، ثُمَّ يَقْعُدُ فِي الْمَسْجِدِ يَنْتَظِرُ الصَّلَاةَ الْأُخْرَى ، إِلَّا الْمَلَكُ يَقُولُ : اللَّهُمَّ اغْفِرْ لَهُ ، اللَّهُمَّ ارْحَمْهُ ، فَإِذَا قُمْتُمْ إِلَى الصَّلَاةِ فَاعْدِلُوا صُفُوفَكُمْ ، وَأَقِيمُوا ، وَسُدُّوا  الْفُرَجَ  ، فَإِنِّي أَرَاكُمْ مِنْ خَلْفِي وَرَاءَ ظَهْرِي . فَإِذَا قَالَ إِمَامُكُمُ : اللهُ أَكْبَرُ ، فَقُولُوا : اللهُ أَكْبَرُ . وَإِذَا رَكَعَ فَارْكَعُوا ، وَإِذَا قَالَ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، فَقُولُوا : اللَّهُمَّ رَبَّنَا لَكَ الْحَمْدُ . وَإِنَّ خَيْرَ الصُّفُوفِ الْمُقَدَّمُ ، وَشَرَّهَا الْمُؤَخَّرُ ، وَخَيْرَ صُفُوفِ النِّسَاءِ الْمُؤَخَّرُ ، وَشَرَّهَا الْمُقَدَّمُ . يَا مَعْشَرَ النِّسَاءِ ، إِذَا سَجَدَ الرِّجَالُ فَاخْفِضْنَ أَبْصَارَكُنَّ لَا تَرَيْنَ  عَوْرَاتِ  الرِّجَالِ ، مِنْ ضِيقِ الْأُزُرِ  "" .         [2/508]","","Musnad Abi Ya'la al-Mawsili 1355","","أبو سعيد الخدري عن سعيد بن المسيب عن عبد الله بن محمد بن عقيل بن أبي طالب عن زهير بن محمد التميمي عن يحيى بن أبي بكير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1355","382 - (  1356  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  أَبِي الصِّدِّيقِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  أَنَّ رَجُلًا قَتَلَ تِسْعَةً وَتِسْعِينَ نَفْسًا  ، فَسَأَلَ أَعْلَمَ أَهْلِ الْأَرْضِ فَدُلَّ عَلَى رَجُلٍ ، فَأَتَاهُ فَقَالَ : إِنَّهُ قَتَلَ تِسْعَةً وَتِسْعِينَ نَفْسًا ، فَهَلْ لَهُ مِنْ تَوْبَةٍ ؟ فَقَالَ : بَعْدَ قَتْلِ تِسْعَةٍ وَتِسْعِينَ لَيْسَتْ لَكَ تَوْبَةٌ .  فَانْتَضَى  سَيْفَهُ فَقَتَلَهُ فَكَمَّلَ بِهِ مِائَةً . قَالَ : ثُمَّ إِنَّهُ مَكَثَ مَا شَاءَ اللهُ ، ثُمَّ سَأَلَ عَنْ أَعْلَمِ أَهْلِ الْأَرْضِ ، فَدُلَّ عَلَى رَجُلٍ ، فَقَالَ : إِنَّهُ قَتَلَ مِائَةَ نَفْسٍ فَهَلْ لَهُ مِنْ تَوْبَةٍ ؟ قَالَ : وَمَنْ يَحُولُ بَيْنَكَ وَبَيْنَ التَّوْبَةِ ؟ اخْرُجْ مِنْ هَذِهِ الْقَرْيَةِ الْخَبِيثَةِ الَّتِي أَنْتَ بِهَا إِلَى قَرْيَةِ كَذَا وَكَذَا ، فَاعْبُدْ رَبَّكَ فِيهِمْ . قَالَ : فَخَرَجَ وَعَرَضَ أَجَلُهُ فِي الطَّرِيقِ ، فَاخْتَصَمَ مَلَائِكَةُ         [2/509]      الرَّحْمَةِ وَمَلَائِكَةُ الْعَذَابِ ، فَقَالَ إِبْلِيسُ : إِنَّهُ لَمْ يَعْصِنِي سَاعَةً قَطُّ ، قَالَتْ مَلَائِكَةُ الرَّحْمَةِ : إِنَّهُ خَرَجَ تَائِبًا . فَزَعَمَ  حُمَيْدٌ الطَّوِيلُ  أَنَّ  بَكْرًا  حَدَّثَهُ عَنْ  أَبِي رَافِعٍ  قَالَ :  بَعَثَ اللهُ مَلَكًا فَاجْتَمَعُوا إِلَيْهِ  - رَجَعَ الْحَدِيثُ إِلَى حَدِيثِ  قَتَادَةَ  - قَالَ : فَقَالَ : انْظُرُوا إِلَى أَيِّ الْقَرْيَتَيْنِ كَانَ أَقْرَبَ فَأَلْحِقُوهُ بِأَهْلِهَا . قَالَ  قَتَادَةُ  : فَقَرَّبَ اللهُ عَزَّ وَجَلَّ الْقَرْيَةَ الصَّالِحَةَ ، وَبَاعَدَ مِنْهُ الْخَبِيثَةَ وَأَلْحَقُوهُ بِأَهْلِهَا  "" .","","Musnad Abi Ya'la al-Mawsili 1356","","أبو سعيد الخدري عن بكر بن عمرو الناجي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1356","383 - (  1357  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ وَهْبٍ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ،  عَنْ  دَرَّاجٍ ،  عَنْ  أَبِي الْهَيْثَمِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  أَصْدَقُ الرُّؤْيَا بِالْأَسْحَارِ  "" .","","Musnad Abi Ya'la al-Mawsili 1357","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1357","384 - (  1358  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  حَدَّثَنَا  فُضَيْلُ بْنُ مَرْزُوقٍ ،  عَنْ  عَطِيَّةَ الْعَوْفِيِّ قَالَ :  قَالَ  أَبُو سَعِيدٍ :  قَالَ  رَجُلٌ مِنَ الْأَنْصَارِ  لِأَصْحَابِهِ : أَمَا وَاللهِ لَقَدْ         [2/510]      كُنْتُ أُحَدِّثُكُمْ أَنَّهُ لَوْ قَدِ اسْتَقَامَتْ لَهُ الْأُمُورُ قَدْ آثَرَ عَلَيْكُمْ غَيْرَكُمْ ، قَالَ : فَرَدُّوا عَلَيْهِ رَدًّا عَنِيفًا . قَالَ : فَبَلَغَ ذَلِكَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : "" فَجَاءَهُمْ ، فَقَالَ لَهُمْ أَشْيَاءَ لَا أَحْفَظُهَا ، قَالُوا : بَلَى يَا رَسُولَ اللهِ ، قَالَ :  فَكُنْتُمْ لَا تَرْكَبُونَ الْخَيْلَ  قَالَ : كُلَّمَا قَالَ لَهُمْ شَيْئًا ، قَالُوا : بَلَى يَا رَسُولَ اللهِ ، فَلَمَّا رَآهُمْ لَا يَرُدُّونَ عَلَيْهِ شَيْئًا قَالَ : "" أَفَلَا تَقُولُونَ : قَاتَلَكَ قَوْمُكَ فَنَصَرْنَاكَ ، وَأَخْرَجَكَ قَوْمُكَ فَآوَيْنَاكَ ؟ "" قَالُوا : نَحْنُ لَا نَقُولُ ذَلِكَ يَا رَسُولَ اللهِ ، أَنْتَ تَقُولُهُ ، قَالَ : فَقَالَ : "" يَا مَعْشَرَ  الْأَنْصَارِ  أَلَا تَرْضَوْنَ أَنْ يَذْهَبَ النَّاسُ بِالدُّنْيَا وَأَنْتُمْ تَذْهَبُونَ بِرَسُولِ اللهِ ، صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ "" قَالَ : يَا مَعْشَرَ  الْأَنْصَارِ  أَلَا تَرْضَوْنَ أَنَّ النَّاسَ لَوْ سَلَكُوا وَادِيًا وَسَلَكْتُمْ وَادِيًا لَسَلَكْتُ وَادِيَ  الْأَنْصَارِ ؟  "" قَالُوا : بَلَى يَا رَسُولَ اللهِ ، قَالَ : "" لَوْلَا الْهِجْرَةُ لَكُنْتُ امْرَأً مِنَ  الْأَنْصَارِ  .  الْأَنْصَارُ  كَرِشِي  وَأَهْلُ بَيْتِي ،  عَيْبَتِي  الَّتِي آوِي إِلَيْهَا ، اعْفُوا عَنْ مُسِيئِهِمْ ، وَاقْبَلُوا مِنْ مُحْسِنِهِمْ "" . قَالَ  أَبُو سَعِيدٍ  : فَمَا عَلِمَ ذَلِكَ  ابْنُ مَرْجَانَةَ  عَدُوُّ اللهِ . قَالَ  أَبُو سَعِيدٍ  : قُلْتُ  لِمُعَاوِيَةَ  : أَمَا إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ كَانَ حَدَّثَنَا أَنَّا سَنَرَى بَعْدَهُ  أَثَرَةً  ؟ قَالَ  مُعَاوِيَةُ  : فَمَا أَمَرَكُمْ ؟ قَالَ : قُلْتُ : أَمَرَنَا أَنْ نَصْبِرَ . قَالَ : فَاصْبِرُوا إِذًا  "" .         [2/511]","","Musnad Abi Ya'la al-Mawsili 1358","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن يحيى بن أبي بكير عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1358","385 - (  1359  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ أَبِي الْحَسَنِ الْمَدَنِيُّ ،  حَدَّثَنِي  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنِ  ابْنِ عَجْلَانَ ،  عَنْ  نَافِعٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا خَرَجَ         [2/512]      ثَلَاثَةٌ فِي سَفَرٍ فَلْيَؤُمَّهُمْ أَحَدُهُمْ  . قَالَ  نَافِعٌ  : قُلْتُ  لِأَبِي سَلَمَةَ  : أَنْتَ أَمِيرُنَا  .","","Musnad Abi Ya'la al-Mawsili 1359","","أبو سعيد الخدري عن أبو سلمة بن عبد الرحمن عن نافع مولى ابن عمر عن محمد بن عجلان عن حاتم بن إسماعيل الحارثي عن محمد بن الحسن بن زبالة المخزومي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1359","386 - (  1360  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ أَبِي الْحَسَنِ الْمَدَنِيُّ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  يَزِيدَ بْنِ الْهَادِ ،  عَنْ  عَبْدِ اللهِ بْنِ خَبَّابٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ،  أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَذُكِرَ عِنْدَهُ  أَبُو طَالِبٍ  ، فَقَالَ :  لَعَلَّهُ أَنْ تَنْفَعَهُ شَفَاعَتِي يَوْمَ الْقِيَامَةِ  فَيُجْعَلَ فِي  ضَحْضَاحٍ  مِنَ النَّارِ إِلَى كَعْبَيْهِ يَغْلِي مِنْهُ أُمُّ دِمَاغِهِ  "" .         [2/513]","","Musnad Abi Ya'la al-Mawsili 1360","","أبو سعيد الخدري عن عبد الله بن خباب النجاري عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن محمد الدراوردي عن محمد بن الحسن بن أبي الحسن البراد عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1360","387 - (  1361  ) -  وَعَنْ  أَبِي سَعِيدٍ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  صَلَاةُ الْجَمَاعَةِ تَفْضُلُ عَلَى صَلَاةِ الْفَذِّ  بِخَمْسٍ وَعِشْرِينَ دَرَجَةً  "" .","","Musnad Abi Ya'la al-Mawsili 1361","","أبو سعيد الخدري عن عبد الله بن خباب النجاري عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن محمد الدراوردي عن محمد بن الحسن بن زبالة المخزومي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1361","388 - (  1362  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  الرُّؤْيَا الصَّالِحَةُ  جُزْءٌ  مِنْ خَمْسَةٍ وَأَرْبَعِينَ  جُزْءًا  مِنَ النُّبُوَّةِ  .  قَالَ  يَزِيدُ : سَمِعْتُ أَبَا سَلَمَةَ  يُحَدِّثُ  بِهَذَا الْحَدِيثِ عَنْ أَبِي هُرَيْرَةَ ، عُمَرَ بْنَ عَبْدِ الْعَزِيزِ .  فَقَالَ  عُمَرُ :  لَوْ كَانَتْ حَصَاةً مِنْ عَدَدِ الْحَصَى لَرَأَيْتُهَا صِدْقًا  .","","Musnad Abi Ya'la al-Mawsili 1362","","أبو سعيد الخدري عن عبد الله بن خباب النجاري عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن محمد الدراوردي عن محمد بن الحسن بن زبالة المخزومي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1362","389 - (  1363  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [2/514]      أَنَّهُ سَمِعَهُ يَقُولُ : ""  إِذَا رَأَى أَحَدُكُمْ رُؤْيَا يُحِبُّهَا فَإِنَّهَا مِنَ اللهِ  ، فَلْيَحْمَدِ اللهَ عَلَيْهَا وَلْيُحَدِّثْ بِهَا ، وَإِذَا رَأَى غَيْرَ ذَلِكَ مِمَّا يَكْرَهُ فَإِنَّهَا مِنَ الشَّيْطَانِ فَلْيَسْتَعِذْ مِنْ شَرِّهَا ، وَلَا يَذْكُرْهَا لِأَحَدٍ فَإِنَّهَا لَنْ تَضُرَّهُ  "" .         [2/515]","","Musnad Abi Ya'la al-Mawsili 1363","","أبو سعيد الخدري عن عبد الله بن خباب النجاري عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن محمد الدراوردي عن محمد بن الحسن بن زبالة المخزومي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1363","390 - (  1364  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  قُلْنَا : يَا رَسُولَ اللهِ ، هَذَا السَّلَامُ عَلَيْكَ ، فَكَيْفَ نُصَلِّي عَلَيْكَ ؟ قَالَ :  قُولُوا اللَّهُمَّ صَلِّ عَلَى  مُحَمَّدٍ  عَبْدِكَ وَرَسُولِكَ  ، كَمَا صَلَّيْتَ عَلَى  إِبْرَاهِيمَ  ،  وَبَارِكْ  عَلَى  مُحَمَّدٍ  وَآلِ مُحَمَّدٍ  ، كَمَا بَارَكْتَ عَلَى  إِبْرَاهِيمَ  "" .","","Musnad Abi Ya'la al-Mawsili 1364","","أبو سعيد الخدري عن عبد الله بن خباب النجاري عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن محمد الدراوردي عن محمد بن الحسن بن زبالة المخزومي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1364","391 - (  1365  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ""  أَنَّهُ كَانَ تُصِيبُهُ الْجَنَابَةُ مِنَ اللَّيْلِ فَيُرِيدُ أَنْ يَنَامَ ، فَأَمَرَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَتَوَضَّأَ ثُمَّ يَنَامَ  "" .         [2/516]","","Musnad Abi Ya'la al-Mawsili 1365","","أبو سعيد الخدري عن عبد الله بن خباب النجاري عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن محمد الدراوردي عن محمد بن الحسن بن زبالة المخزومي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1365","392 - (  1366  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  سُلَيْمَانُ الْأَعْمَشُ ،  عَنْ  عَطِيَّةَ الْعَوْفِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : ""  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُحَدِّثُ عَنِ  الدَّجَّالِ  قَالَ : "" إِنَّهُ  سَيُسَلَّطُ عَلَى نَفْسٍ وَاحِدَةٍ ، يَقْتُلُهَا ثُمَّ يُحْيِيهَا  ، فَيَقُولُ : أَلَسْتُ بِرَبِّكَ ؟ فَيَقُولُ : مَا كُنْتَ فِي نَفْسِي أَكْذَبَ مِنْكَ السَّاعَةَ ، قَالَ : فَمَا كُنَّا نَرَى إِلَّا أَنَّهُ  عُمَرُ بْنُ الْخَطَّابِ  حَتَّى مَاتَ  .","","Musnad Abi Ya'la al-Mawsili 1366","","أبو سعيد الخدري عن عطية بن سعد العوفي عن الأعمش عن عبد العزيز بن مسلم الخراساني عن أحمد بن إسحاق الحضرمي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1366","393 - (  1367  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  إِبْرَاهِيمُ أَبُو إِسْحَاقَ الطَّالْقَانِيُّ ،  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  سَعِيدِ بْنِ يَزِيدَ أَبِي شُجَاعٍ ،  عَنْ  أَبِي السَّمْحِ ،  عَنْ  أَبِي الْهَيْثَمِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""         {      وَهُمْ فِيهَا كَالِحُونَ         }      قَالَ :  تَشْوِيهِ النَّارُ فَتَقَلَّصُ شَفَتُهُ حَتَّى تَبْلُغَ وَسَطَ رَأْسِهِ  ، وَتَسْتَرْخِي الْأُخْرَى حَتَّى تَضْرِبَ سُرَّتَهُ  "" .         [2/517]","","Musnad Abi Ya'la al-Mawsili 1367","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن سعيد بن يزيد الحميري عن عبد الله بن المبارك عن إبراهيم بن إسحاق الطالقاني عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1367","394 - (  1368  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ يَحْيَى ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي سَعِيدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَا تُخَيِّرُوا بَيْنَ الْأَنْبِيَاءِ  "" .","","Musnad Abi Ya'la al-Mawsili 1368","","أبو سعيد الخدري عن يحيى بن عمارة المازني عن عمرو بن يحيى بن عمارة المازني عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1368","395 - (  1369  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُلَيَّةَ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ قَالَ :  حَدَّثَ  رَجُلٌ  ابْنَ عُمَرَ  بِهَذَا الْحَدِيثِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ يُحَدِّثُهُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَامَ إِلَيْهِ حَتَّى دَخَلَ عَلَى  أَبِي سَعِيدٍ  وَأَنَا مَعَهُ ، فَقَالَ : إِنَّ هَذَا حَدَّثَنِي عَنْكَ حَدِيثًا تُحَدِّثُهُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَفَسَمِعْتَهُ ؟ قَالَ :  بَصُرَ  عَيْنِي وَسَمِعَ أُذُنِي ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَبِيعُوا الذَّهَبَ بِالذَّهَبِ  ، وَلَا الْوَرِقَ بِالْوَرِقِ ، إِلَّا مِثْلًا بِمِثْلٍ . وَلَا تَبِيعُوا شَيْئًا غَائِبًا  بِنَاجِزٍ  "" .         [2/518]","","Musnad Abi Ya'la al-Mawsili 1369","","أبو سعيد الخدري عن رجل عن نافع مولى ابن عمر عن أيوب السختياني عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1369","396 - (  1370  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  إِسْمَاعِيلُ ،  حَدَّثَنَا  أَبُو سَلَمَةَ سَعِيدُ بْنُ يَزِيدَ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  أَمَّا أَهْلُ النَّارِ الَّذِينَ هُمْ أَهْلُهَا فَإِنَّهُمْ لَا يَمُوتُونَ فِيهَا وَلَا يَحْيَوْنَ  ، وَلَكِنْ أُنَاسٌ  - أَوْ كَمَا قَالَ - تُصِيبُهُمْ بِذُنُوبِهِمْ - أَوْ قَالَ : بِخَطَايَاهُمْ  - فَتُمِيتُهُمْ إِمَاتَةً ، حَتَّى إِذَا صَارُوا فَحْمًا أُذِنَ فِي الشَّفَاعَةِ فَجِيءَ بِهِمْ  ضَبَائِرَ  ضَبَائِرَ  فَبُثُّوا عَلَى أَنْهَارِ الْجَنَّةِ ، فَيُقَالُ : يَا أَهْلَ الْجَنَّةِ أَفِيضُوا عَلَيْهِمْ ، فَيَنْبُتُونَ كَمَا تَنْبُتُ  الْحِبَّةُ  فِي  حَمِيلِ  السَّيْلِ "" . قَالَ  رَجُلٌ  مِنَ  الْقَوْمِ  حِينَئِذٍ : كَأَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ فِي الْبَادِيَةِ  .","","Musnad Abi Ya'la al-Mawsili 1370","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن سعيد بن يزيد الطاحي عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1370","397 - (  1371  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  إِسْمَاعِيلُ ،  عَنِ  الْجُرَيْرِيِّ ،  عَنْ  أَبِي نَضْرَةَ قَالَ :  سَأَلْتُ  ابْنَ عَبَّاسٍ  عَنِ الصَّرْفِ ، قَالَ : يَدٌ بِيَدٍ ، فَقُلْتُ : نَعَمْ ، فَقَالَ : لَا بَأْسَ . قَالَ :  فَلَقِيتُ  أَبَا سَعِيدٍ فَأَخْبَرْتُهُ أَنِّي سَأَلْتُ  ابْنَ عَبَّاسٍ  عَنِ الصَّرْفِ ، فَقَالَ : لَا بَأْسَ بِهِ . قَالَ : أَوَقَالَ ذَلِكَ ؟ أَمَا إِنَّا سَنَكْتُبُ إِلَيْهِ فَلَا يُفْتِيكُمُوهُ . قَالَ : فَوَاللهِ لَقَدْ جَاءَ بَعْضُ فِتْيَانِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِتَمْرٍ فَأَنْكَرَهُ ، فَقَالَ :  كَأَنَّ هَذَا لَيْسَ مِنْ تَمْرِ أَرْضِنَا ؟  قَالَ : كَانَ فِي تَمْرِ الْعَامِ بَعْضُ الشَّيْءِ ، فَأَخَذْتُ هَذَا وَزِدْتُ بَعْضَ الزِّيَادَةِ ، فَقَالَ :         [2/519]      "" أَضْعَفْتَ ، أَرْبَيْتَ ، لَا تَقْرَبَنَّ هَذَا ، إِذَا رَابَكَ مِنْ تَمْرِكَ شَيْءٌ فَبِعْهُ ، ثُمَّ اشْتَرِ الَّذِي تُرِيدُ مِنَ التَّمْرِ  "" .","","Musnad Abi Ya'la al-Mawsili 1371","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن سعيد بن إياس الجريري عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1371","398 - (  1372  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  إِسْمَاعِيلُ ،  عَنِ  الْجُرَيْرِيِّ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ قَالَ : ""  كُنَّا نَغْزُو مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي رَمَضَانَ ، فَمِنَّا الصَّائِمُ وَمِنَّا الْمُفْطِرُ  ، فَلَا  يَجِدُ  الصَّائِمُ عَلَى الْمُفْطِرِ ، وَلَا الْمُفْطِرُ عَلَى الصَّائِمِ ، يَرَوْنَ أَنَّهُ مَنْ وَجَدَ قُوَّةً فَصَامَ ، ذَلِكَ حَسَنٌ ، وَيَرَوْنَ أَنَّهُ مَنْ وَجَدَ ضَعْفًا فَأَفْطَرَ ، فَإِنَّ ذَلِكَ حَسَنٌ  "" .","","Musnad Abi Ya'la al-Mawsili 1372","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن سعيد بن إياس الجريري عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1372","399 - (  1373  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : ""  دَخَلْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يُصَلِّي مُتَوَشِّحًا  "" .","","Musnad Abi Ya'la al-Mawsili 1373","","أبو سعيد الخدري عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن محمد بن عبيد بن أبي أمية عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1373","400 - (  1374  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنَا  دَرَّاجٌ أَبُو السَّمْحِ ، أَنَّ أَبَا الْهَيْثَمِ  حَدَّثَهُ  ،         [2/520]      عَنْ  أَبِي سَعِيدٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّ  رَجُلًا  قَالَ : يَا رَسُولَ اللهِ ، طُوبَى لِمَنْ رَآكَ وَآمَنَ بِكَ ، قَالَ :  طُوبَى لِمَنْ رَآنِي وَآمَنَ بِي  ، ثُمَّ طُوبَى ، ثُمَّ طُوبَى ، ثُمَّ طُوبَى لِمَنْ آمَنَ بِي وَلَمْ يَرَنِي "" فَقَالَ لَهُ رَجُلٌ : وَمَا طُوبَى ؟ قَالَ :  شَجَرَةٌ  فِي الْجَنَّةِ  مَسِيرَةُ  مِائَةِ سَنَةٍ ، ثِيَابُ أَهْلِ الْجَنَّةِ تَخْرُجُ مِنْ أَكْمَامِهَا  "" .","","Musnad Abi Ya'la al-Mawsili 1374","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1374","401 - (  1375  ) -  وَعَنْ  أَبِي سَعِيدٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  قَالَ  رَجُلٌ  : مَا         {      كَالْمُهْلِ         }      ؟ قَالَ :  كَعَكَرِ الزَّيْتِ ، فَإِذَا قَرَّبَهُ إِلَيْهِ سَقَطَتْ  فَرْوَةُ  وَجْهِهِ مِنْهُ  "" .         [2/521]","","Musnad Abi Ya'la al-Mawsili 1375","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1375","402 - (  1376  ) -  وَعَنْ  أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  اذْكُرُوا اللهَ ذِكْرًا كَثِيرًا حَتَّى يَقُولُوا : مَجْنُونٌ  "" .","","Musnad Abi Ya'la al-Mawsili 1376","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1376","403 - (  1377  ) -  وَعَنْ  أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَوْ ضُرِبَ بِمِقْمَعٍ مِنْ حَدِيدٍ الْجَبَلُ لَتَفَتَّتَ ، ثُمَّ عَادَ كَمَا كَانَ  "" .","","Musnad Abi Ya'la al-Mawsili 1377","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1377","404 - (  1378  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ : ""  لَوْ أَنَّ أَحَدَكُمْ يَعْمَلُ فِي صَخْرَةٍ صَمَّاءَ لَيْسَ لَهَا بَابٌ وَلَا كُوَّةٌ  ، لَخَرَجَ عَمَلُهُ إِلَى النَّاسِ كَائِنًا مَا كَانَ  "" .         [2/522]","","Musnad Abi Ya'la al-Mawsili 1378","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1378","405 - (  1379  ) -  وَعَنْ  أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ : ""  كُلُّ حَرْفٍ فِي الْقُرْآنِ يُذْكَرُ فِيهِ  الْقُنُوتُ  فَهُوَ طَاعَةٌ  "" .","","Musnad Abi Ya'la al-Mawsili 1379","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1379","406 - (  1380  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ : ""  أَتَانِي  جِبْرِيلُ  ، فَقَالَ : إِنَّ رَبِّي وَرَبَّكَ يَقُولُ : كَيْفَ رَفَعْتُ ذِكْرَكَ ؟  قَالَ : وَاللهُ أَعْلَمُ . قَالَ : إِذَا ذُكِرْتُ ذُكِرْتَ مَعِي  "" .","","Musnad Abi Ya'la al-Mawsili 1380","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1380","407 - (  1381  ) -  وَعَنْ  أَبِي سَعِيدٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَوْ أَنَّ دَلْوًا مِنْ  غَسَّاقٍ  يُهَرَاقُ فِي الدُّنْيَا  ، لَأَنْتَنَ أَهْلُ الدُّنْيَا  "" .         [2/523]","","Musnad Abi Ya'la al-Mawsili 1381","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1381","408 - (  1382  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  يَأْكُلُ التُّرَابُ كُلَّ شَيْءٍ مِنَ الْإِنْسَانِ إِلَّا  عَجْبَ  ذَنَبِهِ  . قِيلَ : وَمِثْلُ مَا هُوَ يَا رَسُولَ اللهِ ؟ قَالَ : "" مِثْلُ  حَبَّةِ  الْخَرْدَلِ مِنْهُ يَنْبُتُونَ  "" .","","Musnad Abi Ya'la al-Mawsili 1382","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1382","409 - (  1383  ) -  وَعَنْ  أَبِي سَعِيدٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  وَيْلٌ : وَادٍ فِي  جَهَنَّمَ  يَهْوِي  فِيهِ الْكَافِرُ أَرْبَعِينَ  خَرِيفًا  قَبْلَ أَنْ يَبْلُغَ قَعْرَهُ ، وَقَالَ : الصَّعُودُ : جَبَلٌ مِنْ نَارٍ يَصْعَدُ فِيهِ سَبْعِينَ  خَرِيفًا  ، ثُمَّ يَهْوِي بِهِ كَذَلِكَ فِيهِ أَبَدًا  "" .         [2/524]","","Musnad Abi Ya'la al-Mawsili 1383","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1383","410 - (  1384  ) -  وَعَنْ  أَبِي سَعِيدٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  اسْتَكْثِرُوا مِنَ الْبَاقِيَاتِ الصَّالِحَاتِ  . قِيلَ : وَمَا هُنَّ يَا رَسُولَ اللهِ ؟ قَالَ : "" الْمِلَّةُ "" . قِيلَ : وَمَا هِيَ يَا رَسُولَ اللهِ ؟ قَالَ : "" التَّهْلِيلُ ، وَالتَّكْبِيرُ ، وَالتَّسْبِيحُ ، وَالْحَمْدُ لِلهِ ، وَلَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ  "" .","","Musnad Abi Ya'la al-Mawsili 1384","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1384","411 - (  1385  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  يُنْصَبُ ؟ لِلْكَافِرِ يَوْمَ الْقِيَامَةِ مِقْدَارُ خَمْسِينَ أَلْفَ سَنَةٍ  كَمَا لَمْ يَعْمَلْ لِلهِ فِي الدُّنْيَا ، وَإِنَّ الْكَافِرَ يَرَى  جَهَنَّمَ  وَيَظُنُّ أَنَّهَا مُوَاقِعَتُهُ مِنْ  مَسِيرَةِ  أَرْبَعِينَ سَنَةً  "" .         [2/525]","","Musnad Abi Ya'la al-Mawsili 1385","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1385","412 - (  1386  ) -  وَعَنْ  أَبِي سَعِيدٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ الرَّجُلَ لَيَتَّكِئُ فِي الْجَنَّةِ  مَسِيرَةَ  سَبْعِينَ سَنَةً قَبْلَ أَنْ يَتَحَوَّلَ  . ثُمَّ تَأْتِيهِ امْرَأَةٌ فَتَضْرِبُ عَلَى مَنْكِبَيْهِ ، فَيَنْظُرُ وَجْهَهُ فِي خَدِّهَا أَصْفَى مِنَ الْمِرْآةِ ، وَإِنَّ أَدْنَى لُؤْلُؤَةٍ عَلَيْهَا لَتُضِيءُ مَا بَيْنَ الْمَشْرِقِ إِلَى الْمَغْرِبِ ، فَتُسَلِّمُ عَلَيْهِمْ ، فَيَرُدُّ عَلَيْهَا السَّلَامَ وَيَسْأَلُهَا : مَنْ أَنْتِ ؟ فَتَقُولُ : أَنَا هِيَ الْمَزِيدُ ، وَإِنَّهُ لَيَكُونُ عَلَيْهَا سَبْعُونَ ثَوْبًا ، أَدْنَاهَا مِثْلُ النُّعْمَانِ مِنْ طُوبَى ، فَيَنْفُذُهَا بَصَرُهُ حَتَّى يَرَى مُخَّ سَاقِهَا مِنْ وَرَاءِ ذَلِكَ ، وَإِنَّ عَلَيْهِمُ  التِّيجَانَ  ، إِنَّ أَدْنَى لُؤْلُؤَةٍ فِيهَا لَتُضِيءُ مَا بَيْنَ الْمَشْرِقِ وَالْمَغْرِبِ  "" .","","Musnad Abi Ya'la al-Mawsili 1386","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1386","413 - (  1386  ) -  وَعَنْ  أَبِي سَعِيدٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  الشِّتَاءُ رَبِيعُ الْمُؤْمِنِ  "" .","","Musnad Abi Ya'la al-Mawsili 1386","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1387","414 - (  1387  ) -  وَعَنْ  أَبِي سَعِيدٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَقْعَدُ الْكَافِرِ مِنَ النَّارِ ثَلَاثَةُ أَيَّامٍ  ، كُلُّ ضِرْسٍ لَهُ مِثْلُ  أُحُدٍ  ، وَفَخِذُهُ مِثْلُ  وَرِقَانَ  ، وَجِلْدُهُ سِوَى لَحْمِهِ وَعِظَامِهِ أَرْبَعُونَ ذِرَاعًا  "" .         [2/526]","","Musnad Abi Ya'la al-Mawsili 1387","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1388","415 - (  1388  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَوْ أَنَّ مِقْمَعًا مِنْ حَدِيدٍ وُضِعَ فِي الْأَرْضِ  وَاجْتَمَعَ عَلَيْهِ  الثَّقَلَانِ  مَا أَقَلُّوهُ مِنَ الْأَرْضِ  "" .","","Musnad Abi Ya'la al-Mawsili 1388","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1389","416 - (  1389  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ : ""  لِسُرَادِقِ النَّارِ أَرْبَعَةُ جُدُرٍ  ، بَيْنَ كُلِّ جِدَارٍ مِثْلُ أَرْبَعِينَ سَنَةً  "" .         [2/527]","","Musnad Abi Ya'la al-Mawsili 1389","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1390","417 - (  1390  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  قِيلَ : يَا رَسُولَ اللهِ ، يَوْمٌ كَانَ مِقْدَارُهُ خَمْسِينَ أَلْفَ سَنَةٍ ، مَا أَطْوَلَ هَذَا ! فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وَالَّذِي نَفْسُ  مُحَمَّدٍ  بِيَدِهِ ، إِنَّهُ لَيُخَفَّفُ عَلَى الْمُؤْمِنِ  حَتَّى يَكُونَ أَخَفَّ عَلَيْهِ مِنْ صَلَاةٍ مَكْتُوبَةٍ يُصَلِّيهَا فِي الدُّنْيَا  .","","Musnad Abi Ya'la al-Mawsili 1390","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1391","418 - (  1391  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَيَذْكُرَنَّ اللهَ قَوْمٌ فِي الدُّنْيَا عَلَى الْفُرُشِ الْمُمَهَّدَةِ يُدْخِلُهُمُ الْجِنَانَ الْعُلَى  .","","Musnad Abi Ya'la al-Mawsili 1391","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1392","419 - (  1392  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا كَانَ يَوْمُ الْقِيَامَةِ عُرِّفَ الْكَافِرُ بِعَمَلِهِ  ، فَجَحَدَ وَخَاصَمَ ، فَيُقَالُ : هَؤُلَاءِ جِيرَانُكَ يَشْهَدُونَ عَلَيْكَ ، فَيَقُولُ : كَذَبُوا ، فَيَقُولُ : أَهْلُكُ ، عَشِيرَتُكَ ؟ فَيَقُولُ : كَذَبُوا ، فَيَقُولُ : احْلِفُوا ، فَيَحْلِفُونَ ، ثُمَّ يُصْمِتُهُمُ اللهُ وَتَشْهَدُ أَلْسِنَتُهُمْ ، ثُمَّ يُدْخِلُهُمُ النَّارَ  .         [2/528]","","Musnad Abi Ya'la al-Mawsili 1392","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1393","420 - (  1393  ) -  وَعَنْ  أَبِي سَعِيدٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  قَالَ  مُوسَى  : يَا رَبِّ عَلِّمْنِي شَيْئًا أَذْكُرُكَ وَأَدْعُوكَ بِهِ  قَالَ : قُلْ يَا  مُوسَى  : لَا إِلَهَ إِلَّا اللهُ ، قَالَ : كُلُّ عِبَادِكَ يَقُولُ هَذَا . قَالَ : قُلْ : لَا إِلَهَ إِلَّا اللهُ . قَالَ : لَا إِلَهَ إِلَّا أَنْتَ ، إِنَّمَا أُرِيدُ شَيْئًا تَخُصُّنِي بِهِ ، قَالَ : يَا  مُوسَى  لَوْ أَنَّ السَّمَاوَاتِ السَّبْعَ وَعَامِرَهُنَّ غَيْرِي ، وَالْأَرَضِينَ السَّبْعَ ، فِي كِفَّةٍ ، وَلَا إِلَهَ إِلَّا اللهُ فِي كِفَّةٍ ، مَالَتْ بِهِنَّ لَا إِلَهَ إِلَّا اللهُ  "" .","","Musnad Abi Ya'la al-Mawsili 1393","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1394","421 - (  1394  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ : ""  الْمَجَالِسُ ثَلَاثَةٌ : سَالِمٌ ، وَغَانِمٌ ،  وَشَاجِبٌ  .","","Musnad Abi Ya'la al-Mawsili 1394","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1395","422 - (  1395  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ قَالَ :         {      وَفُرُشٍ مَرْفُوعَةٍ         }      قَالَ :  وَالَّذِي نَفْسِي بِيَدِهِ إِنَّ ارْتِفَاعَهَا لَكَمَا بَيْنَ السَّمَاءِ وَالْأَرْضِ  ، وَإِنَّ مَا بَيْنَ السَّمَاءِ وَالْأَرْضِ  لَمَسِيرَةُ  خَمْسِمِائَةِ عَامٍ  .         [2/529]","","Musnad Abi Ya'la al-Mawsili 1395","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1396","423 - (  1396  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ : ""  الشِّيَاعُ  حَرَامٌ  ""  قَالَ  ابْنُ لَهِيعَةَ  :  يَعْنِي : الَّذِي يَفْتَخِرُ بِالْجِمَاعِ  .","","Musnad Abi Ya'la al-Mawsili 1396","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1397","424 - (  1397  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  رُبَّمَا رَجُلٌ كَسَبَ مَالًا مِنْ حَلَالٍ فَأَطْعَمَ نَفْسَهُ  ، وَرَجُلٌ يَكُونُ لَهُ مَالٌ تَكُونُ فِيهِ الصَّدَقَةُ ، فَقَالَ : اللَّهُمَّ صَلِّ عَلَى  مُحَمَّدٍ  عَبْدِكَ وَرَسُولِكَ ، وَصَلِّ عَلَى الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ وَالْمُسْلِمِينَ وَالْمُسْلِمَاتِ ، فَإِنَّهُ لَهُ زَكَاةٌ  "" .         [2/530]","","Musnad Abi Ya'la al-Mawsili 1397","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1398","425 - (  1398  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لِلْجَنَّةِ مِائَةُ دَرَجَةٍ  ، لَوْ أَنَّ الْعَالَمِينَ اجْتَمَعُوا فِي إِحْدَاهُنَّ وَسِعَتْهُمْ  "" .","","Musnad Abi Ya'la al-Mawsili 1398","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1399","426 - (  1399  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ الشَّيْطَانَ قَالَ : وَعِزَّتِكَ يَا رَبِّ ، لَا أَبْرَحُ أُغْوِي عِبَادَكَ  مَا دَامَتْ أَرْوَاحُهُمْ فِي أَجْسَادِهِمْ قَالَ الرَّبُّ : وَعِزَّتِي وَجَلَالِي لَا أَزَالُ أَغْفِرُ لَهُمْ مَا اسْتَغْفَرُونِي  "" .","","Musnad Abi Ya'la al-Mawsili 1399","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1400","427 - (  1400  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  وَالَّذِي نَفْسِي بِيَدِهِ ، إِنَّهُ لَيَخْتَصِمُ حَتَّى الشَّاتَانِ فِيمَ انْتَطَحَتَا  .","","Musnad Abi Ya'la al-Mawsili 1400","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1401","428 - (  1401  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ،  أَيُّ الْعِبَادَةِ أَفْضَلُ دَرَجَةً عِنْدَ اللهِ يَوْمَ الْقِيَامَةِ ؟ قَالَ :         [2/531]      "" الذَّاكِرِينَ اللهَ كَثِيرًا  ، قُلْتُ : يَا رَسُولَ اللهِ ، وَمَنِ الْغَازِي فِي  سَبِيلِ  اللهِ ؟ قَالَ : لَوْ ضَرَبَ بِسَيْفِهِ الْكُفَّارَ وَالْمُشْرِكِينَ حَتَّى يَنْكَسِرَ وَيَخْتَضِبَ دَمًا ، لَكَانَ الذَّاكِرُ اللهَ أَفْضَلَ مِنْهُ  .","","Musnad Abi Ya'la al-Mawsili 1401","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1402","429 - (  1402  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  هَاجَرَ رَجُلٌ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ  الْيَمَنِ  ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  هَجَرْتَ  الشِّرْكَ  ، وَلَكِنَّهُ  الْجِهَادُ  ، هَلْ  بِالْيَمَنِ  أَبَوَاكَ ؟ "" قَالَ : نَعَمْ ، قَالَ : "" أَذِنَا لَكَ ؟ "" قَالَ : لَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" ارْجِعْ إِلَى أَبَوَيْكَ فَاسْتَأْذِنْهُمَا ، فَإِنْ فَعَلَا فَجَاهِدْ وَإِلَّا فَبِرَّهُمَا  "" .","","Musnad Abi Ya'la al-Mawsili 1402","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1403","430 - (  1403  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنْ         [2/532]      رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  يَقُولُ الرَّبُّ يَوْمَ الْقِيَامَةِ :  سَيَعْلَمُ أَهْلُ الْجَمْعِ الْيَوْمَ مَنْ أَهْلُ الْكَرَمِ  ، فَقِيلَ : وَمَنْ أَهْلُ الْكَرَمِ ؟ قَالَ : "" أَهْلُ الذِّكْرِ فِي الْمَسَاجِدِ  "" .","","Musnad Abi Ya'la al-Mawsili 1403","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1404","431 - (  1404  ) -  وَعَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ أَدْنَى أَهْلِ الْجَنَّةِ مَنْزِلَةً الَّذِي لَهُ ثَمَانُونَ أَلْفَ خَادِمٍ  ، وَاثْنَانِ وَسَبْعُونَ زَوْجًا ، يُنْصَبُ لَهُ  قُبَّةٌ  مِنْ لُؤْلُؤٍ وَيَاقُوتٍ وَزَبَرْجَدٍ ، كَمَا بَيْنَ  الْجَابِيَةِ  وَصَنْعَاءَ  "" .","","Musnad Abi Ya'la al-Mawsili 1404","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1405","432 - (  1405  ) -  وَعَنْ  أَبِي سَعِيدٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  شَكَّ  أَبُو خَيْثَمَةَ  - عَنْ  أَبِي سَعِيدٍ  ، أَنَّهُ قَالَ : ""  مَنْ مَاتَ مِنْ أَهْلِ الدُّنْيَا صَغِيرًا أَوْ كَبِيرًا يُرَدُّونَ إِلَى سِتِّينَ سَنَةً فِي الْجَنَّةِ  ، لَا يَزِيدُونَ عَلَيْهَا أَبَدًا ، وَكَذَلِكَ أَهْلُ النَّارِ  .         [2/533]","","Musnad Abi Ya'la al-Mawsili 1405","","أبو سعيد الخدري عن سليمان بن عمرو العتواري عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1406","433 - (  1406  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمِقْدَامِ ،  حَدَّثَنَا  الْمُعْتَمِرُ قَالَ :  سَمِعْتُ  أَبِي  يُحَدِّثُ عَنْ  قَتَادَةَ ،  عَنْ  عُقْبَةَ بْنِ عَبْدِ الْغَافِرِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَيَأْخُذَنَّ الرَّجُلُ بِيَدِ أَبِيهِ يَوْمَ الْقِيَامَةِ فَلَيُقَطِّعَنَّهُ النَّارَ  ، يُرِيدُ أَنْ يُدْخِلَهُ الْجَنَّةَ ، فَيُنَادَى أَنَّ الْجَنَّةَ لَا يَدْخُلُهَا مُشْرِكٌ ، أَلَا إِنَّ اللهَ قَدْ حَرَّمَ الْجَنَّةَ عَلَى كُلِّ مُشْرِكٍ ، فَيَقُولُ : رَبِّ أَبِي ، رَبِّ أَبِي ، رَبِّ أَبِي . قَالَ : فَيُحَوَّلُ فِي صُورَةٍ قَبِيحَةٍ وَرِيحٍ مُنْتِنَةٍ فَيَتْرُكُهُ  .  قَالَ  أَبُو سَعِيدٍ  :  فَكَانَ أَصْحَابُ  مُحَمَّدٍ  يَرَوْنَ أَنَّ ذَاكَ الرَّجُلَ  إِبْرَاهِيمُ  ، وَلَمْ يَزِدْهُمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 1406","","أبو سعيد الخدري عن عقبة بن عبد الغافر العوذي عن قتادة بن دعامة عن سليمان بن طرخان عن معتمر بن سليمان عن أحمد بن المقدام العجلي عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1407","434 - (  1407  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  بِشْرُ بْنُ حَرْبٍ قَالَ :  سَمِعْتُ  أَبَا سَعِيدٍ الْخُدْرِيَّ يُحَدِّثُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  نَهَى عَنِ  الْوِصَالِ  فِي الصِّيَامِ ، فَقِيلَ : يَا رَسُولَ اللهِ مَا لَكَ أَنْتَ تَفْعَلُهُ ؟ فَقَالَ :  إِنِّي لَسْتُ كَأَحَدِكُمْ ، إِنِّي أُطْعَمُ وَأُسْقَى  "" .","","Musnad Abi Ya'la al-Mawsili 1407","","أبو سعيد الخدري عن بشر بن حرب عن حماد بن زيد عن خلف بن هشام البزار عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1408","435 - (  1408  ) -  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي حُمَيْدٍ ،  عَنْ  أَبِي مَلِيحٍ قَالَ :  حَدَّثَنِي  أَبُو سَعِيدٍ الْخُدْرِيُّ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [2/534]      يَقُولُ : ""  إِذَا مَضَى أَحَدُكُمْ فِي صَلَاةٍ ، ثُمَّ رَجَعَ إِلَى بَيْتِهِ فَلْيُصَلِّ  ، وَلْيَجْعَلْ لِبَيْتِهِ نَصِيبًا مِنْ صَلَاتِهِ ، فَإِنَّ اللهَ جَاعِلٌ مِنْ صَلَاتِهِ فِي بَيْتِهِ خَيْرًا  "" .","","Musnad Abi Ya'la al-Mawsili 1408","","أبو سعيد الخدري عن أبو المليح بن أسامة الهذلي عن عبيد الله بن أبي حميد الهذلي عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1409","436 - (  1409  ) -  قَرَأْتُ عَلَى  الْحُسَيْنِ بْنِ يَزِيدَ الطَّحَّانِ ،  حَدَّثَنَا  سَعِيدُ بْنُ خُثَيْمٍ ،  عَنْ  فُضَيْلٍ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : ""  لَمَّا نَزَلَتْ هَذِهِ الْآيَةُ :         {      وَآتِ ذَا الْقُرْبَى حَقَّهُ         }      دَعَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَاطِمَةَ  وَأَعْطَاهَا  فَدَكَ  "" .","","Musnad Abi Ya'la al-Mawsili 1409","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن سعيد بن خثيم الهلالي عن الحسين بن يزيد بن يحيى الطحان عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1410","437 - (  1410  ) -  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعٍ قَالَ :  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي  ،  عَنْ  قَيْسِ بْنِ وَهْبٍ ،  عَنْ  أَبِي الْوَدَّاكِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  يَخْرُجُ         [2/535]      الدَّجَّالُ  فَيَتَوَجَّهُ قِبَلَهُ رَجُلٌ مِنَ الْمُسْلِمِينَ فَتَلْقَاهُ  الْمَسَالِحُ  -  مَسَالِحُ  الدَّجَّالِ  - فَيَقُولُونَ لَهُ : أَيْنَ تَعْمِدُ ؟ فَيَقُولُ : أَعْمِدُ إِلَى هَذَا الَّذِي خَرَجَ . فَيَقُولُونَ لَهُ : أَوَمَا تُؤْمِنُ بِرَبِّنَا ؟ قَالَ : يَقُولُ : مَا أَرَى - أَحْسِبُهُ - حَقًّا . قَالَ : يَقُولُونَ : اقْتُلُوهُ . قَالَ : فَيَقُولُ بَعْضُهُمْ لِبَعْضٍ : أَلَيْسَ قَدْ نَهَاكُمْ رَبُّكُمْ أَنْ تَقْتُلُوا أَحَدًا دُونَهُ ؟ قَالَ : فَيَنْطَلِقُونَ بِهِ إِلَى  الدَّجَّالِ  . قَالَ : فَإِذَا رَآهُ الْمُؤْمِنُ قَالَ : يَا أَيُّهَا النَّاسُ هَذَا  الدَّجَّالُ  الَّذِي ذَكَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - . قَالَ : "" فَيَأْمُرُ بِهِ  الدَّجَّالُ  فَيُشْبَحُ ، قَالَ : فَيَقُولُ : خُذُوهُ  فَاشْبَحُوهُ ،  قَالَ : فَيُشْبَحُ ، قَالَ : فَيُمْصَعُ ظَهْرُهُ وَبَطْنُهُ ضَرْبًا ، قَالَ : فَيَقُولُ لَهُ : أَمَا تُؤْمِنُ بِي ؟ قَالَ : فَيَقُولُ : أَنْتَ  الْمَسِيحُ الْكَذَّابُ  . قَالَ : فَيَأْمُرُ بِهِ فَيُنْشَرُ بِالْمِنْشَارِ مِنْ مَفْرِقِهِ حَتَّى يُفَرَّقَ بَيْنَ رِجْلَيْهِ ، قَالَ : ثُمَّ يَمْشِي  الدَّجَّالُ  بَيْنَ الْقِطْعَتَيْنِ . قَالَ : ثُمَّ يَقُولُ : قُمْ ، فَيَسْتَوِي قَائِمًا . قَالَ : فَيَقُولُ لَهُ : أَمَا تُؤْمِنُ بِي ؟ قَالَ : فَيَقُولُ لَهُ : مَا ازْدَدْتُ فِيكَ إِلَّا  بَصِيرَةً  ، قَالَ : ثُمَّ يَقُولُ : يَا أَيُّهَا النَّاسُ ، إِنَّهُ لَا يَفْعَلُ الَّذِي فَعَلَ بِي بِأَحَدٍ مِنَ النَّاسِ . قَالَ : فَيَأْخُذُهُ  الدَّجَّالُ  لِيَذْبَحَهُ ، فَيُجْعَلُ مَا بَيْنَ ذَقْنِهِ إِلَى تَرْقُوَتِهِ نُحَاسًا ، فَلَا يَسْتَطِيعُ إِلَيْهِ سَبِيلًا . قَالَ : فَيَأْخُذُ بِيَدَيْهِ وَرِجْلَيْهِ فَيَقْذِفُ بِهِ ، فَيَحْسِبُ النَّاسُ أَنَّهُ قَذَفَهُ فِي النَّارِ ، وَإِنَّمَا أُلْقِيَ فِي الْجَنَّةِ "" . قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" هَذَا         [2/536]      أَعْظَمُ النَّاسِ شَهَادَةً عِنْدَ رَبِّ الْعَالَمِينَ  "" .","","Musnad Abi Ya'la al-Mawsili 1410","","أبو سعيد الخدري عن جبر بن نوف البكالي عن قيس بن وهب الهمداني عن الجراح بن مليح الرؤاسي والد وكيع عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1411","438 - (  1411  ) -  حَدَّثَنَا  قَطَنُ بْنُ نُسَيْرٍ ،  حَدَّثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  الْمُعَلَّى بْنُ زِيَادٍ ،  قَالَ  :  لَمَّا هَزَمَ  يَزِيدُ بْنُ الْمُهَلَّبِ  أَهْلَ الْبَصْرَةِ  ، قَالَ  الْمُعَلَّى  : فَخَشِيتُ أَنْ أَجْلِسَ فِي حَلْقَةِ الْحَسَنِ بْنِ أَبِي الْحَسَنِ ، فَأُوجَدَ فِيهَا فَأُعْرَفَ . فَأَتَيْتُ  الْحَسَنَ  فِي مَنْزِلِهِ فَدَخَلْتُ عَلَيْهِ ، فَقُلْتُ : يَا  أَبَا سَعِيدٍ  ، كَيْفَ بِهَذِهِ الْآيَةِ مِنْ كِتَابِ اللهِ ؟ قَالَ : أَيَّةُ آيَةٍ مِنْ كِتَابِ اللهِ ؟ قُلْتُ : قَوْلُ اللهِ فِي هَذِهِ الْآيَةِ :         {      وَتَرَى كَثِيرًا مِنْهُمْ يُسَارِعُونَ فِي الإِثْمِ وَالْعُدْوَانِ وَأَكْلِهِمُ السُّحْتَ لَبِئْسَ مَا كَانُوا يَعْمَلُونَ         }      . قَالَ : يَا  عَبْدَ اللهِ  ، إِنَّ  الْقَوْمَ  عَرَضُوا السَّيْفَ فَحَالَ السَّيْفُ دُونَ الْكَلَامِ ، قُلْتُ : يَا  أَبَا سَعِيدٍ  ، فَهَلْ تَعْرِفُ لِمُتَكَلِّمٍ فَضْلًا ؟ قَالَ : لَا ، قَالَ  الْمُعَلَّى  : ثُمَّ حَدَّثَ بِحَدِيثَيْنِ ، قَالَ :  حَدَّثَنَا  أَبُو سَعِيدٍ الْخُدْرِيُّ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِحَدِيثٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَا لَا يَمْنَعَنَّ أَحَدَكُمْ رَهْبَةُ النَّاسِ  أَنْ يَقُولَ الْحَقَّ إِذَا رَآهُ ، أَنْ يَذْكُرَ تَعْظِيمَ اللهِ ؛ فَإِنَّهُ لَا يُقَرِّبُ مِنْ أَجَلٍ ، وَلَا يُبَعِّدُ مِنْ رِزْقٍ "" .  قَالَ : ثُمَّ حَدَّثَ الْحَسَنُ بِحَدِيثٍ آخَرَ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         [2/537]      لَيْسَ لِلْمُؤْمِنِ أَنْ يُذِلَّ نَفْسَهُ  . قِيلَ : وَمَا إِذْلَالُهُ نَفْسَهُ ؟ قَالَ : "" يَتَعَرَّضُ مِنَ الْبَلَاءِ لِمَا لَا يُطِيقُ "" .  قِيلَ : يَا  أَبَا سَعِيدٍ  ،  فَيَزِيدُ الضَّبِّيُّ  وَكَلَامُهُ فِي الصَّلَاةِ ؟ قَالَ : أَمَا إِنَّهُ لَمْ يَخْرُجْ مِنَ السِّجْنِ حَتَّى نَدِمَ . قَالَ  الْمُعَلَّى  : فَقُمْتُ مِنْ مَجْلِسِ  الْحَسَنِ  ، فَأَتَيْتُ  يَزِيدَ  ، فَقُلْتُ : يَا  أَبَا مَوْدُودٍ  ، بَيْنَمَا أَنَا  وَالْحَسَنُ  نَتَذَاكَرُ إِذْ نَصَبْتُ أَمْرَكَ نَصْبًا ، فَقَالَ :  مَهْ  يَا  أَبَا الْحَسَنِ  قَالَ : قُلْتُ : قَدْ فَعَلْتُ ، قَالَ : فَمَا قَالَ  الْحَسَنُ  ؟ قُلْتُ : قَالَ : أَمَا إِنَّهُ لَمْ يَخْرُجْ مِنَ السِّجْنِ حَتَّى نَدِمَ عَلَى مَقَالَتِهِ . قَالَ  يَزِيدُ  : مَا نَدِمْتُ عَلَى مَقَالَتِي ، وَايْمُ اللهِ لَقَدْ قُمْتُ مَقَامًا أُخْطِرُ فِيهِ بِنَفْسِي . قَالَ  يَزِيدُ  : فَأَتَيْتُ  الْحَسَنَ  ، فَقُلْتُ : يَا  أَبَا سَعِيدٍ  ، غُلِبْنَا عَلَى كُلِّ شَيْءٍ ، نُغْلَبُ عَلَى صَلَاتِنَا ؟ فَقَالَ : يَا  عَبْدَ اللهِ  ، إِنَّكَ لَمْ تَصْنَعْ شَيْئًا ، إِنَّكَ تُعَرِّضُ نَفْسَكَ لَهُمْ . ثُمَّ أَتَيْتُهُ ، فَقَالَ لِي مِثْلَ مَقَالَتِهِ ، قَالَ : فَقُمْتُ يَوْمَ الْجُمُعَةِ فِي الْمَسْجِدِ  وَالْحَكَمُ بْنُ أَيُّوبَ  يَخْطُبُ ، فَقُلْتُ : رَحِمَكَ اللهُ ، الصَّلَاةَ ، قَالَ : فَلَمَّا قُلْتُ ذَلِكَ احْتَوَشَتْنِيَ الرِّجَالُ يَتَعَاوَرُونِي ، فَأَخَذُوا بِلِحْيَتِي  وَتَلْبِيبَتِي  ، وَجَعَلُوا يَجِئُونَ بَطْنِي بِنِعَالِ سُيُوفِهِمْ . قَالَ : وَمَضَوْا بِي نَحْوَ الْمَقْصُورَةِ ، فَمَا وَصَلْتُ إِلَيْهِ حَتَّى ظَنَنْتُ أَنَّهُمْ سَيَقْتُلُونِي دُونَهُ . قَالَ : فَفُتِحَ لِي بَابُ الْمَقْصُورَةِ ، قَالَ : فَدَخَلْتُ فَقُمْتُ بَيْنَ يَدَيِ  الْحَكَمِ  وَهُوَ سَاكِتٌ ، فَقَالَ : أَمَجْنُونٌ أَنْتَ ؟ قَالَ : وَمَا كُنَّا فِي صَلَاةٍ ، فَقُلْتُ : أَصْلَحَ اللهُ الْأَمِيرَ ، هَلْ مِنْ كَلَامٍ أَفْضَلَ مِنْ كِتَابِ اللهِ ؟ قَالَ : لَا ، قُلْتُ : أَصْلَحَ اللهُ الْأَمِيرَ . أَرَأَيْتَ لَوْ أَنَّ رَجُلًا نَشَرَ مُصْحَفًا يَقْرَؤُهُ         [2/538]      غُدْوَةً إِلَى اللَّيْلِ ، أَكَانَ ذَلِكَ قَاضِيًا عَنْهُ صَلَاتَهُ ؟ قَالَ : وَاللهِ إِنِّي لَأَحْسَبُكَ مَجْنُونًا ، قَالَ :  وَأَنَسُ بْنُ مَالِكٍ  جَالِسٌ تَحْتَ مِنْبَرِهِ سَاكِتٌ ، فَقُلْتُ : يَا  أَنَسُ  ، يَا  أَبَا حَمْزَةَ  ،  أَنْشُدُكَ  اللهَ ، فَقَدْ خَدَمْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَصَحِبْتَهُ ، أَبِمَعْرُوفٍ قُلْتُ أَمْ بِمُنْكَرٍ ؟ أَبِحَقٍّ قُلْتُ أَمْ بِبَاطِلٍ ؟ قَالَ : فَلَا وَاللهِ مَا أَجَابَنِي بِكَلِمَةٍ . قَالَ لَهُ  الْحَكَمُ بْنُ أَيُّوبَ  : يَا  أَنَسُ  ، قَالَ : يَقُولُ : لَبَّيْكَ ، أَصْلَحَكَ اللهُ ، قَالَ : وَكَانَ وَقْتُ الصَّلَاةِ قَدْ ذَهَبَ ، قَالَ : كَانَ بَقِيَ مِنَ الشَّمْسِ بَقِيَّةٌ ، فَقَالَ : احْبِسُوهُ .  قَالَ  يَزِيدُ  : فَأُقْسِمُ لَكَ يَا  أَبَا الْحَسَنِ  - يَعْنِي  لِلْمُعَلَّى  - لَمَا لَقِيتُ مِنْ أَصْحَابِي كَانَ أَشَدَّ عَلَيَّ مِنْ مَقَامِي ، قَالَ بَعْضُهُمْ : مُرَاءٍ . وَقَالَ بَعْضُهُمْ : مَجْنُونٌ . قَالَ : وَكَتَبَ  الْحَكَمُ  إِلَى  الْحَجَّاجِ  : أَنَّ رَجُلًا مِنْ  بَنِي ضَبَّةَ  قَامَ يَوْمَ الْجُمُعَةِ قَالَ : الصَّلَاةَ ، وَأَنَا أَخْطُبُ ، وَقَدْ شَهِدَ الشُّهُودُ الْعُدُولُ عِنْدِي أَنَّهُ مَجْنُونٌ ، فَكَتَبَ إِلَيْهِ  الْحَجَّاجُ  : إِنْ كَانَتْ قَامَتِ الشُّهُودُ الْعُدُولُ أَنَّهُ مَجْنُونٌ فَخَلِّ سَبِيلَهُ ، وَإِلَّا فَاقْطَعْ يَدَيْهِ وَرِجْلَيْهِ ، وَاسْمُرْ عَيْنَيْهِ ، وَاصْلُبْهُ ، قَالَ : فَشَهِدُوا عِنْدَ  الْحَكَمِ  أَنِّي مَجْنُونٌ فَخَلَّى عَنِّي .  قَالَ  الْمُعَلَّى  : عَنْ  يَزِيدَ الضَّبِّيِّ  : مَاتَ أَخٌ لَنَا فَتَبِعْنَا جِنَازَتَهُ فَصَلَّيْنَا عَلَيْهِ ، فَلَمَّا دُفِنَ تَنَحَّيْتُ فِي عِصَابَةٍ ، فَذَكَرْنَا اللهَ وَذَكَرْنَا  مَعَادَنَا  ، فَإِنَّا كَذَلِكَ إِذْ رَأَيْنَا نَوَاصِيَ الْخَيْلِ وَالْحِرَابِ ، فَلَمَّا رَآهُ أَصْحَابِي قَامُوا وَتَرَكُونِي وَحْدِي ، فَجَاءَ  الْحَكَمُ  حَتَّى وَقَفَ عَلَيَّ فَقَالَ : مَا كُنْتُمْ تَصْنَعُونَ ؟ قُلْتُ : أَصْلَحَ اللهُ الْأَمِيرَ ، مَاتَ صَاحِبٌ         [2/539]      لَنَا فَصَلَّيْنَا عَلَيْهِ وَدُفِنَ ، فَقَعَدْنَا نَذْكُرُ رَبَّنَا ، وَنَذْكُرُ  مَعَادَنَا  ، وَنَذْكُرُ مَا صَارَ إِلَيْهِ ، قَالَ : مَا مَنَعَكَ أَنْ تَفِرَّ كَمَا فَرُّوا ؟ قُلْتُ : أَصْلَحَ اللهُ الْأَمِيرَ ، أَنَا أَبْرَأُ مِنْ ذَلِكَ سَاحَةً وَآمَنُ لِلْأَمِيرِ مِنْ أَنْ أَفِرَّ ، قَالَ : فَسَكَتَ  الْحَكَمُ  ، فَقَالَ  عَبْدُ الْمَلِكِ بْنُ الْمُهَلَّبِ  - وَكَانَ عَلَى شُرَطَتِهِ : تَدْرِي مَنْ هَذَا ؟ قَالَ : مَنْ هَذَا ؟ قَالَ : الْمُتَكَلِّمُ يَوْمَ الْجُمُعَةِ ، قَالَ : فَغَضِبَ  الْحَكَمُ  ، وَقَالَ : أَمَا إِنَّكَ لَجَرِيءٌ ، خُذَاهُ ، قَالَ : فَأُخِذْتُ فَضَرَبَنِي أَرْبَعَ مِائَةِ سَوْطٍ ، فَمَا دَرَيْتُ حِينَ تَرَكَنِي مِنْ شِدَّةِ مَا ضَرَبَنِي ، قَالَ : وَبَعَثَنِي إِلَى  وَاسِطٍ  ، فَكُنْتُ فِي  دِيمَاسِ  الْحَجَّاجِ  حَتَّى مَاتَ  الْحَجَّاجُ  .  إِلَى هُنَا  مُسْنَدُ  أَبِي سَعِيدٍ الْخُدْرِيِّ .","","Musnad Abi Ya'la al-Mawsili 1411","","أبو سعيد الخدري عن الحسن البصري عن معلى بن زياد القردوسي عن جعفر بن سليمان الضبعي عن قطن بن نسير الغبري عن أبو يعلى الموصلي","من مسند أبي سعيد الخدري"
"1412","[3/5]      مُسْنَدُ  رُكَانَةَ  439 - (  1412  ) -  أَخْبَرَنَا  أَبُو يَعْلَى ،  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ رَبِيعَةَ ، قَالَ :  لَقِيتُ  بِمَكَّةَ  رَجُلًا مِنْ  أَهْلِ عَسْقَلَانَ  يُقَالُ لَهُ : أَبُو الْحَسَنِ  فَحَدَّثَنِي  ،  عَنْ  أَبِي جَعْفَرِ بْنِ مُحَمَّدِ بْنِ رُكَانَةَ ،  عَنْ  أَبِيهِ  ، أَنَّهُ صَارَعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  فَقَالَ  رُكَانَةُ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  فَرْقٌ بَيْنَنَا وَبَيْنَ الْمُشْرِكِينَ الْعَمَائِمُ عَلَى الْقَلَانِسِ  .","","Musnad Abi Ya'la al-Mawsili 1412","","ركانة بن عبد يزيد المطلبي عن محمد بن ركانة بن عبد يزيد القرشي عن أبو جعفر بن محمد بن ركانة القرشي عن أبو الحسن العسقلاني عن محمد بن ربيعة بن سمير الرؤاسي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند ركانة"
"1413","[3/6]      مُسْنَدُ  بُرَيْدَةَ  440 - (  1413  ) -  أَخْبَرَنَا  أَبُو يَعْلَى ، قَالَ :  قُرِئَ عَلَى  بِشْرِ بْنِ الْوَلِيدِ ،  عَنْ  أَبِي يُوسُفَ ،  عَنْ  أَبِي حَنِيفَةَ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَنَّهُ  كَانَ إِذَا بَعَثَ سَرِيَّةً ، أَوْ جَيْشًا أَوْصَى صَاحِبَهَا بِتَقْوَى اللهِ فِي خَاصَّةِ نَفْسِهِ ، وَأَوْصَاهُ بِمَنْ مَعَهُ مِنَ الْمُسْلِمِينَ خَيْرًا ، ثُمَّ قَالَ :  اغْزُوا بِاسْمِ اللهِ ، قَاتِلُوا مَنْ كَفَرَ بِاللهِ ، لَا تَغُلُّوا ، وَلَا تَغْدِرُوا  ، وَلَا تُمَثِّلُوا ، وَلَا تَقْتُلُوا  وَلِيدًا ،  فَإِذَا لَقِيتُمْ عَدُوَّكُمْ مِنَ الْمُشْرِكِينَ فَادْعُوهُمْ إِلَى الْإِسْلَامِ ، فَإِنْ أَسْلَمُوا فَاقْبَلُوا مِنْهُمْ وَكُفُّوا عَنْهُمْ ، ثُمَّ ادْعُوهُمْ إِلَى التَّحَوُّلِ مِنْ         [3/7]      دَارِهِمْ إِلَى دَارِ الْمُسْلِمِينَ ، فَإِنْ فَعَلُوا فَاقْبَلُوا مِنْهُمْ ، وَإِلَّا فَأَخْبِرُوهُمْ أَنَّهُمْ كَأَعْرَابِ الْمُسْلِمِينَ يَجْرِي عَلَيْهِمْ حُكْمُ اللهِ الَّذِي يَجْرِي عَلَى الْمُسْلِمِينَ ، وَلَيْسَ لَهُمْ فِي الْفَيْءِ ، وَلَا فِي الْغَنِيمَةِ نَصِيبٌ ، فَإِنْ أَبَوْا ذَلِكَ فَادْعُوهُمْ إِلَى إِعْطَاءِ الْجِزْيَةِ ، فَإِنْ فَعَلُوا فَاقْبَلُوا مِنْهُمْ وَكُفُّوا عَنْهُمْ ، فَإِذَا حَاصَرْتُمْ حِصْنًا أَوْ مَدِينَةً ، فَإِنْ أَرَادُوكُمْ أَنْ تُنْزِلُوهُمْ عَلَى حُكْمِ اللهِ ، فَلَا تُنْزِلُوهُمْ ، فَإِنَّكُمْ لَا تَدْرُونَ مَا حُكْمُ اللهِ ، وَلَكِنْ أَنْزِلُوهُمْ عَلَى حُكْمِكُمْ ، ثُمَّ احْكُمُوا فِيهِمْ مَا رَأَيْتُمْ ، وَإِذَا حَاصَرْتُمْ قَصْرًا فَلَا تُعْطُوهُمْ ذِمَّةَ اللهِ ، وَلَا ذِمَّةَ رَسُولِهِ ، وَلَكِنْ أَعْطُوهُمْ ذِمَمَكُمْ وَذِمَمَ آبَائِكُمْ ، فَإِنَّكُمْ أَنْ تُخْفِرُوا ذِمَمَكُمْ وَذِمَمَ آبَائِكُمْ أَهْوَنُ  .         [3/8]","","Musnad Abi Ya'la al-Mawsili 1413","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن أبو حنيفة النعمان عن أبو يوسف يعقوب بن إبراهيم القاضي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند بريدة"
"1414","[3/9]      مُسْنَدُ  أَبِي طَلْحَةَ  رَضِيَ اللهُ عَنْهُ  1 - (  1414  ) -  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى الْمَوْصِلِيُّ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أَبِي طَلْحَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَدْخُلُ الْمَلَائِكَةُ بَيْتًا فِيهِ كَلْبٌ وَلَا صُورَةٌ  .         [3/10]","","Musnad Abi Ya'la al-Mawsili 1414","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن سفيان بن عيينة عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند أبي طلحة"
"1415","2 - (  1415  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  مُعَاذُ بْنُ مُعَاذٍ ، وَعَبْدُ الْأَعْلَى ، قَالَا :  حَدَّثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  عَنْ  أَبِي طَلْحَةَ ، قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا غَلَبَ عَلَى قَوْمٍ أَحَبَّ أَنْ يُقِيمَ بِعَرْصَتِهِمْ ثَلَاثًا  .         [3/11]","","Musnad Abi Ya'la al-Mawsili 1415","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الأعلى بن عبد الأعلى القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند أبي طلحة"
"1416","3 - (  1416  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ، وَأَبُو مُعَاوِيَةَ ،  عَنْ  حَجَّاجٍ ،  عَنِ  الْحَسَنِ بْنِ سَعْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَخْبَرَنِي  أَبُو طَلْحَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَمَعَ بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ  .","","Musnad Abi Ya'la al-Mawsili 1416","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عباس عن الحسن بن سعد مولى علي بن أبي طالب عن حجاج بن أرطاة عن أبو معاوية الضرير عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند أبي طلحة"
"1417","4 - (  1417  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ بَكْرٍ السَّهْمِيُّ ،  عَنْ  حُمَيْدٍ ،  عَنْ  ثَابِتٍ ،  عَنْ  إِسْحَاقَ بْنِ عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ ،  عَنْ  أَبِي طَلْحَةَ  :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ضَحَّى بِكَبْشَيْنِ  أَمْلَحَيْنِ  ، فَقَالَ         [3/12]      عِنْدَ الذَّبْحِ الْأَوَّلِ : عَنْ  مُحَمَّدٍ  وَآلِ مُحَمَّدٍ  ، وَقَالَ عِنْدَ الذَّبْحِ الثَّانِي : عَمَّنْ آمَنَ بِي وَصَدَّقَ مِنْ أُمَّتِي  .","","Musnad Abi Ya'la al-Mawsili 1417","","زيد بن سهل بن الأسود الأنصاري عن إسحاق بن عبد الله بن أبي طلحة الخزرجي عن ثابت البناني عن حميد الطويل عن عبد الله بن بكر بن حبيب عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند أبي طلحة"
"1418","5 - (  1418  ) -  حَدَّثَنَاهُ  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ بَكْرٍ ،  عَنْ  حُمَيْدٍ ،  عَنْ  ثَابِتٍ ،  عَنْ  إِسْحَاقَ بْنِ عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ ،  عَنْ  أَبِي طَلْحَةَ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ضَحَّى بِكَبْشَيْنِ  أَمْلَحَيْنِ  ، فَقَالَ عِنْدَ الذَّبْحِ الْأَوَّلِ : عَنْ  مُحَمَّدٍ  وَآلِ مُحَمَّدٍ  ، وَقَالَ عِنْدَ الذَّبْحِ الْآخَرِ : عَمَّنْ آمَنَ بِي وَصَدَّقَنِي مِنْ أُمَّتِي  .","","Musnad Abi Ya'la al-Mawsili 1418","","زيد بن سهل بن الأسود الأنصاري عن إسحاق بن عبد الله بن أبي طلحة الخزرجي عن ثابت البناني عن حميد الطويل عن عبد الله بن بكر بن حبيب عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","مسند أبي طلحة"
"1419","6 - (  1419  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  حَجَّاجٍ ،  عَنِ  الْحَسَنِ بْنِ سَعْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،         [3/13]      عَنْ  أَبِي طَلْحَةَ  :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  قَرَنَ  الْحَجَّ  وَالْعُمْرَةَ  .","","Musnad Abi Ya'la al-Mawsili 1419","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عباس عن الحسن بن سعد مولى علي بن أبي طالب عن حجاج بن أرطاة عن أبو معاوية الضرير عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","مسند أبي طلحة"
"1420","7 - (  1420  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ ثَابِتٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ :  أَنَّهُ دَخَلَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي وَجَعِهِ الَّذِي مَاتَ فِيهِ ، فَقَالَ :  أَقْرِئْ قَوْمَكَ السَّلَامَ ، فَإِنَّهُمْ مَا عَلِمْتُ  أَعِفَّةٌ  صُبُرٌ  .","","Musnad Abi Ya'la al-Mawsili 1420","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن ثابت البناني عن محمد بن ثابت بن أسلم البناني عن أبو داود الطيالسي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند أبي طلحة"
"1421","8 - (  1421  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  حَدَّثَنَا  عُثْمَانُ بْنُ حَكِيمٍ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ ، قَالَ :  قَالَ  أَبُو طَلْحَةَ  :  كُنَّا قُعُودًا بِالْأَفْنِيَةِ نَتَحَدَّثُ ، فَجَاءَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَامَ عَلَيْنَا ، فَقَالَ :  مَا لَكُمْ وَلِمَجَالِسِ  الصُّعُدَاتِ  ؟ اجْتَنِبُوا مَجَالِسَ  الصُّعُدَاتِ  ، قَالَ : قُلْنَا : يَا رَسُولَ اللهِ ، إِنَّا جَلَسْنَا لِغَيْرِ مَا بَأْسٍ : جَلَسْنَا نَتَذَاكَرُ ، وَنَتَحَدَّثُ ، فَقَالَ : إِمَّا لَا         [3/14]      فَأَدُّوا حَقَّهَا ، قُلْنَا : يَا رَسُولَ اللهِ ، وَمَا حَقُّهَا ؟ قَالَ : غَضُّ الْبَصَرِ ، وَرَدُّ السَّلَامِ ، وَحُسْنُ الْكَلَامِ  .","","Musnad Abi Ya'la al-Mawsili 1421","","زيد بن سهل بن الأسود الأنصاري عن إسحاق بن عبد الله بن أبي طلحة الخزرجي عن عثمان بن حكيم الأحلافي عن عبد الواحد بن زياد عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند أبي طلحة"
"1422","9 - (  1422  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ أَبُو بَحْرٍ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  ثَابِتٍ  عَنْ  أَنَسٍ قَالَ :  قَالَ  أَبُو طَلْحَةَ :  رَفَعْتُ رَأْسِي  يَوْمَ أُحُدٍ  فَجَعَلْتُ أَنْظُرُ  فَمَا مِنْهُمْ أَحَدٌ إِلَّا وَهُوَ يَمِيدُ مِنَ النُّعَاسِ تَحْتَ حَجَفَتِهِ  .","","Musnad Abi Ya'la al-Mawsili 1422","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن ثابت البناني عن حماد بن سلمة عن عبد الواحد بن غياث عن أبو يعلى الموصلي","مسند أبي طلحة"
"1423","[3/15]      10 - (  1423  ) -  حَدَّثَنَا  أَبُو بَحْرٍ ،  حَدَّثَنَا  حَمَّادٌ  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الزُّبَيْرِ مِثْلَهُ ، وَتَلَا :         {      ثُمَّ أَنْـزَلَ عَلَيْكُمْ مِنْ بَعْدِ الْغَمِّ أَمَنَةً نُعَاسًا يَغْشَى طَائِفَةً         }      .","","Musnad Abi Ya'la al-Mawsili 1423","","الزبير بن العوام عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن عبد الواحد بن غياث عن أبو يعلى الموصلي","مسند أبي طلحة"
"1424","11 - (  1424  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ أَبِي الرَّبِيعِ الْجُرْجَانِيُّ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  مَطَرَتِ السَّمَاءُ بَرَدًا ، فَقَالَ لَنَا  أَبُو طَلْحَةَ  ، وَنَحْنُ غِلْمَانٌ : نَاوِلْنِي يَا  أَنَسُ  مِنْ ذَاكَ الْبَرَدِ ، فَجَعَلَ يَأْكُلُ وَهُوَ صَائِمٌ ، فَقُلْتُ : أَلَسْتَ صَائِمًا ؟ قَالَ : بَلَى ، إِنَّ ذَا لَيْسَ بِطَعَامٍ وَلَا شَرَابٍ ، وَإِنَّمَا هُوَ بَرَكَةٌ مِنَ السَّمَاءِ نُطَهِّرُ بِهِ بُطُونَنَا ، قَالَ  أَنَسٌ  : فَأَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخْبَرْتُهُ ، فَقَالَ :  خُذْ عَنْ عَمِّكَ  .","","Musnad Abi Ya'la al-Mawsili 1424","","أنس بن مالك عن علي بن زيد بن جدعان عن عبد الوارث بن سعيد بن ذكوان عن عبد الصمد بن عبد الوارث التنوري عن الحسن بن يحيى بن الجعد الجرجاني عن أبو يعلى الموصلي","مسند أبي طلحة"
"1425","12 - (  1425  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  حَمَّادُ         [3/16]      بْنُ عَمْرٍو الْجَزَرِيُّ ،  حَدَّثَنَا  زَيْدُ بْنُ رُفَيْعٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ ، قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَتَهَلَّلُ وَجْهُهُ مُسْتَبْشِرًا ، فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنَّكَ لَعَلَى حَالٍ مَا رَأَيْتُكَ عَلَى مِثْلِهَا . قَالَ : وَمَا يَمْنَعُنِي ؟ أَتَانِي  جِبْرِيلُ  ، فَقَالَ :  بَشِّرْ أُمَّتَكَ مَنْ صَلَّى عَلَيْكَ صَلَاةً ، كَتَبَ اللهُ لَهُ بِهَا عَشْرَ حَسَنَاتٍ  ، وَكَفَّرَ عَنْهُ بِهَا عَشْرَ سَيِّئَاتٍ ، وَرَفَعَ لَهُ بِهَا عَشْرَ دَرَجَاتٍ ، وَرَدَّ اللهُ عَلَيْهِ بِمِثْلِ قَوْلِهِ ، وَعُرِضَتْ عَلَيْهِ يَوْمَ الْقِيَامَةِ  .         [3/17]","","Musnad Abi Ya'la al-Mawsili 1425","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن الزهري عن زيد بن رفيع مولى أسماء بن خارجة عن حماد بن عمرو النصيبي عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند أبي طلحة"
"1426","13 - (  1426  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  حَدَّثَنَا  حَاتِمٌ ،  عَنْ  مُعَاوِيَةَ يَعْنِي ابْنَ أَبِي مُزَرِّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ الْأَنْصَارِيِّ ،  عَنْ  أَبِيهِ عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ ،  عَنْ  أَبِي طَلْحَةَ  ، قَالَ :  دَخَلْتُ الْمَسْجِدَ فَعَرَفْتُ فِي وَجْهِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْجُوعَ ، فَخَرَجْتُ حَتَّى أَتَيْتُ  أُمَّ سُلَيْمٍ  ، وَهِيَ أُمُّ  أَنَسِ بْنِ مَالِكٍ  كَانَتْ تَحْتَ  مَالِكٍ أَبِي أَنَسِ بْنِ مَالِكٍ  ، فَقُلْتُ : يَا  أُمَّ سُلَيْمٍ  ، إِنِّي قَدْ عَرَفْتُ فِي وَجْهِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْجُوعَ ، فَهَلْ عِنْدَكِ مِنْ شَيْءٍ ؟ قَالَتْ : عِنْدِي شَيْءٌ ، وَأَشَارَتْ بِكَفِّهَا ، فَقُلْتُ : اصْنَعِي وَانْعَمِي ، فَأَرْسَلْتُ  أَنَسًا  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقُلْتُ : سَارِّهِ فِي أُذُنِهِ وَادْعُهُ ، فَلَمَّا أَقْبَلَ  أَنَسٌ  ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  هَذَا رَجُلٌ قَدْ جَاءَ بِخَيْرٍ  ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَأَرْسَلَكَ أَبُوكَ يَدْعُونَا يَا بُنَيَّ ؟ قَالَ : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِأَصْحَابِهِ : اذْهَبُوا بِاسْمِ اللهِ ، قَالَ : فَأَدْبَرَ  أَنَسٌ  يَشْتَدُّ حَتَّى أَتَى  أَبَا طَلْحَةَ  ، فَقَالَ : هَذَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ أَتَاكَ فِي النَّاسِ ، قَالَ : فَخَرَجْتُ حَتَّى لَقِيتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدَ الْبَابِ عَلَى مُسْتَرَاحِ الدَّرَجَةِ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، مَاذَا صَنَعْتَ بِنَا ؟ إِنَّمَا عَرَفْتُ فِي وَجْهِكَ الْجُوعَ ، فَصَنَعْنَا لَكَ شَيْئًا تَأْكُلُهُ ، قَالَ : ادْخُلْ وَأَبْشِرْ ، قَالَ : فَأَخَذَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَمَعَهَا فِي الصَّحْفَةِ بِيَدِهِ ، ثُمَّ أَصْلَحَهَا ، فَقَالَ : هَلْ مِنْ ؟ كَأَنَّهُ يَعْنِي الْأُدْمَ ، قَالَ : فَأَتَوْهُ  بِعُكَّتِهِمْ  فِيهَا         [3/18]      شَيْءٌ ، أَوْ لَيْسَ فِيهَا شَيْءٌ  ، فَقَالَ بِهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِيَدِهِ : فَأَسْكَبَ مِنْهَا السَّمْنُ ، ثُمَّ قَالَ : أَدْخِلْ عَلَيَّ عَشَرَةً عَشَرَةً ، فَأَكَلُوا كُلُّهُمْ وَشَبِعُوا ، وَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِلْفَضْلِ الَّذِي فَضَلَ : كُلُوا أَنْتُمْ وَعِيَالُكُمْ ، فَأَكَلُوا وَشَبِعُوا  .","","Musnad Abi Ya'la al-Mawsili 1426","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن أبي طلحة البخاري عن عبد الله بن عبد الله بن أبي طلحة الأنصاري عن معاوية بن أبي مزرد الهاشمي عن حاتم بن إسماعيل الحارثي عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند أبي طلحة"
"1427","14 - (  1427  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَرْزُوقٍ ،  حَدَّثَنَا  زَاجِرُ بْنُ الصَّلْتِ ،  عَنِ  الْحَارِثِ بْنِ عُمَيْرٍ ،  عَنْ  شَدَّادٍ ،  عَنْ  أَبِي طَلْحَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  يَا شَبَابَ  قُرَيْشٍ         [3/19]      لَا تَزْنُوا  ، مَنْ سَلِمَ لَهُ شَبَابُهُ فَلَهُ الْجَنَّةُ  .","","Musnad Abi Ya'la al-Mawsili 1427","","زيد بن سهل بن الأسود الأنصاري عن شداد بن سعيد الراسبي عن الحارث بن عمير البصري عن زاجر بن الصلت الطاحي عن محمد بن محمد بن مرزوق الباهلي عن أبو يعلى الموصلي","مسند أبي طلحة"
"1428","15 - (  1428  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ الْهُذَلِيُّ ،  حَدَّثَنَا  هُشَيْمٌ ،  أَخْبَرَنَا  حُمَيْدٌ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ قَالَ :  لَقَدْ سَقَطَ السَّيْفُ مِنِّي  يَوْمَ بَدْرٍ  لِمَا غَشِيَنَا مِنَ النُّعَاسِ  ، يَقُولُ اللهُ :         {      إِذْ يُغَشِّيكُمُ النُّعَاسَ أَمَنَةً مِنْهُ         }      .","","Musnad Abi Ya'la al-Mawsili 1428","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن حميد الطويل عن هشيم بن بشير عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند أبي طلحة"
"1429","16 - (  1429  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ الْعَنْبَرِيُّ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  يَحْيَى بْنِ جَعْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،         [3/20]      عَنْ  أَبِي طَلْحَةَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  تَوَضَّئُوا مِمَّا غَيَّرَتِ النَّارُ  .","","Musnad Abi Ya'la al-Mawsili 1429","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عمرو بن عبد المخزومي عن يحيى بن جعدة بن هبيرة المخزومي عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن أبو يعلى الموصلي","مسند أبي طلحة"
"1430","17 - (  1430  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أَبِي طَلْحَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَدْخُلُ الْمَلَائِكَةُ بَيْتًا         [3/21]      فِيهِ كَلْبٌ وَلَا صُورَةٌ  .","","Musnad Abi Ya'la al-Mawsili 1430","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند أبي طلحة"
"1431","18 - (  1431  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عَرْعَرَةَ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ، قَالَ :  ذَكَرَ  لَنَا أَنَسٌ ،  عَنْ  أَبِي طَلْحَةَ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَ  يَوْمَ بَدْرٍ  بِأَرْبَعَةٍ وَعِشْرِينَ رَجُلًا مِنْ  صَنَادِيدِ  قُرَيْشٍ  ، فَقُذِفُوا فِي  طَوِيٍّ  مِنْ أَطْوَاءِ  بَدْرٍ  خَبِيثٍ  مُخْبِثٍ  ، وَكَانَ إِذَا ظَهَرَ عَلَى قَوْمٍ أَحَبَّ أَنْ يُقِيمَ بِعَرْصَتِهِمْ ثَلَاثَ لَيَالٍ ، فَلَمَّا كَانَ  بِبَدْرٍ  يَوْمَ الثَّالِثِ ، أَمَرَ بِرَاحِلَتِهِ فَشُدَّ عَلَيْهَا رَحْلُهَا ، ثُمَّ مَشَى وَاتَّبَعَهُ أَصْحَابُهُ ، وَقَالُوا : مَا نَرَاهُ يَنْطَلِقُ إِلَّا لِيَقْضِيَ حَاجَتَهُ ، حَتَّى قَامَ عَلَى شَفَةِ  الرَّكِيِّ  ، فَجَعَلَ يُنَادِيهِمْ بِأَسْمَائِهِمْ وَأَسْمَاءِ آبَائِهِمْ :  يَا فُلَانُ بْنَ فُلَانٍ ، يَا فُلَانُ بْنَ فُلَانٍ ، أَيَسُرُّكُمْ أَنَّكُمْ أَطَعْتُمُ اللهَ وَرَسُولَهُ ؟ فَإِنَّا قَدْ وَجَدْنَا مَا وَعَدَنَا رَبُّنَا حَقًّا  ، فَهَلْ وَجَدْتُمْ مَا وَعَدَ رَبُّكُمْ حَقًّا ؟ قَالَ : قَالَ  عُمَرُ بْنُ الْخَطَّابِ  : يَا رَسُولَ اللهِ ، مَا تُكَلِّمُ مِنْ أَجْسَادٍ لَا أَرْوَاحَ لَهَا ؟ فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : وَالَّذِي نَفْسِي بِيَدِهِ مَا أَنْتُمْ بِأَسْمَعَ لِمَا أَقُولُ مِنْهُمْ ، قَالَ  قَتَادَةُ  : أَحْيَاهُمُ اللهُ حَتَّى أَسْمَعَهُمْ تَوْبِيخًا ، وَتَصْغِيرًا ، وَنِقْمَةً ، وَحَسْرَةً ، وَنَدَامَةً  .         [3/22]","","Musnad Abi Ya'la al-Mawsili 1431","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن سعيد بن أبي عروبة عن روح بن عبادة القيسي عن إبراهيم بن محمد بن عرعرة عن أبو يعلى الموصلي","مسند أبي طلحة"
"1432","19 - (  1432  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  سَعِيدِ بْنِ يَسَارٍ ،  عَنْ  أَبِي طَلْحَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ الْمَلَائِكَةَ لَا تَدْخُلُ بَيْتًا فِيهِ تَصَاوِيرُ وَلَا كَلْبٌ  .  فَقَالَ  زَيْدُ بْنُ خَالِدٍ الْجُهَنِيُّ  لِأَبِي طَلْحَةَ  : مُرَّ بِنَا إِلَى عَائِشَةَ نَسْأَلْهَا عَنْ هَذَا ، فَأَتَيَا  عَائِشَةَ  ، فَسَأَلَاهَا ، فَقَالَتْ : أَمَّا هَذَا فَلَا أَحْفَظُهُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَكِنْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي مَغْزًى لَهُ ،  فَتَحَيَّنْتُ  قَفْلَتَهُ فَكَسَوْتُ عَرْشَ الْبَيْتِ نَمَطًا ، فَلَمَّا دَخَلَ اسْتَقْبَلْتُ فَأَخَذْتُ بِيَدِهِ ، فَقُلْتُ : الْحَمْدُ لِلهِ الَّذِي نَصَرَكَ وَأَعَزَّكَ وَأَكْرَمَكَ ، فَنَظَرَ إِلَيْهِ فَرَأَيْتُ الْكَرَاهِيَةَ فِي وَجْهِهِ  ، وَذَكَرَ الْحَدِيثَ بِتَمَامِهِ  .","","Musnad Abi Ya'la al-Mawsili 1432","","عائشة بنت أبي بكر الصديق عن سعيد بن يسار مولى ميمونة زوج رسول الله عن سهيل بن أبي صالح السمان عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند أبي طلحة"
"1433","[3/23]      مُسْنَدُ  قَيْسِ بْنِ سَعْدٍ  1 - (  1433  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  قَيْسِ بْنِ سَعْدٍ ـ  رِوَايَةً  ـ : قَالَ :  لَوْ كَانَ الْإِيمَانُ مُعَلَّقًا  بِالثُّرَيَّا  لَنَالَهُ نَاسٌ مِنْ  أَهْلِ فَارِسَ  .         [3/24]","","Musnad Abi Ya'la al-Mawsili 1433","","قيس بن سعد بن عبادة عن يسار الثقفي مولى الأخنس بن شريق عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند قيس بن سعد"
"1434","2 - (  1434  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  سَلَمَةَ ،  عَنِ  الْقَاسِمِ بْنِ مُخَيْمِرَةَ ،  عَنْ  أَبِي عَمَّارٍ ،  عَنْ  قَيْسِ بْنِ سَعْدٍ ، قَالَ :  أَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ نُخْرِجَ زَكَاةَ الْفِطْرِ قَبْلَ أَنْ تَنْزِلَ الزَّكَاةُ  ، فَلَمَّا نَزَلَتِ الزَّكَاةُ لَمْ يَأْمُرْنَا وَلَمْ يَنْهَنَا ، وَنَحْنُ نَفْعَلُهُ  .         [3/25]","","Musnad Abi Ya'la al-Mawsili 1434","","قيس بن سعد بن عبادة عن عريب بن حميد الدهني عن القاسم بن مخيمرة عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند قيس بن سعد"
"1435","3 - (  1435  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَسْعَدَ بْنِ زُرَارَةَ ،  عَنْ  مُحَمَّدِ بْنِ شُرَحْبِيلَ ،  عَنْ  قَيْسِ بْنِ سَعْدٍ ، قَالَ :  أَتَانَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوَضَعْنَا لَهُ مَاءً فَاغْتَسَلَ  ، ثُمَّ أَتَيْنَاهُ بِمِلْحَفَةٍ  وَرْسِيَّةٍ  فَالْتَحَفَ بِهَا ، فَكَأَنِّي أَنْظُرُ إِلَى أَثَرِ الْوَرْسِ عَلَى عُكَنِهِ  .         [3/26]","","Musnad Abi Ya'la al-Mawsili 1435","","قيس بن سعد بن عبادة عن محمد بن شرحبيل عن قيس بن سعد عن محمد بن عبد الرحمن بن سعد بن زرارة عن محمد بن عبد الرحمن بن أبي ليلى عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند قيس بن سعد"
"1436","4 - (  1436  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  ابْنُ هُبَيْرَةَ ، قَالَ :  سَمِعْتُ  شَيْخًا ، يُحَدِّثُ  أَبَا تَمِيمٍ  ،  أَنَّهُ سَمِعَ  قَيْسَ بْنَ سَعْدِ بْنِ عُبَادَةَ ، وَهُوَ عَلَى  مِصْرَ  ، يَقُولُ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ كَذَبَ عَلَيَّ كَذْبَةً مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  بَيْتًا مِنْ  جَهَنَّمَ ،  أَوْ مَضْجَعًا مِنْ  جَهَنَّمَ  ، أَلَا وَمَنْ  شَرِبَ  الْخَمْرَ أَتَى يَوْمَ الْقِيَامَةِ عَطِشًا ، وَكُلُّ مُسْكِرٍ خَمْرٌ ، وَإِيَّاكُمْ  وَالْغُبَيْرَاءَ  .  وَسَمِعْتُ عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ مِثْلَ ذَلِكَ ، فَلَمْ يَخْتَلِفَا إِلَّا فِي مَضْجَعٍ أَوْ بَيْتٍ  .","","Musnad Abi Ya'la al-Mawsili 1436","","عبد الله بن عمرو بن العاص عن شيخ عن عبد الله بن هبيرة السبئي عن عبد الله بن لهيعة عن عبد الله بن يزيد القصير عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند قيس بن سعد"
"1437","5 - (  1437  ) -  قَالَ أَبُو يَعْلَى :  وَجَدْتُ فِي كِتَابِي  : عَنْ  عَلِيِّ بْنِ الْجَعْدِ ،  عَنْ  شُعْبَةَ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  قَالَ  :  كَانَ سَهْلُ بْنُ حُنَيْفٍ ، وَقَيْسُ بْنُ سَعْدٍ قَاعِدَيْنِ  بِالْقَادِسِيَّةِ  ، فَمَرَّتْ بِهِمَا جِنَازَةٌ ، فَقَامَا ، فَقِيلَ لَهُمَا : إِنَّمَا هُوَ مِنْ أَهْلِ الْأَرْضِ ، فَقَالَا :  إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّتْ بِهِ جِنَازَةٌ فَقَامَ ، فَقِيلَ : إِنَّهَا جِنَازَةُ كَافِرٍ ، فَقَالَ : أَلَيْسَتْ نَفْسًا ؟         [3/27]      قَالَ أَبُو يَعْلَى :  وَجَدْتُ فِي كِتَابِي : عَنْ  عَلِيِّ بْنِ الْجَعْدِ  ، عَنْ  شُعْبَةَ  وَلَيْسَ عَلَيْهِ عَلَامَةُ السَّمَاعِ فَشَكَكْتُ فِيهِ  .","","Musnad Abi Ya'la al-Mawsili 1437","","قيس بن سعد بن عبادة عن عبد الرحمن بن أبي ليلى عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن علي بن الجعد عن أبو يعلى الموصلي","مسند قيس بن سعد"
"1438","6 - (  1438  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  قَيْسِ بْنِ سَعْدٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَوْ كَانَ الْإِيمَانُ مُعَلَّقًا  بِالثُّرَيَّا  ، لَنَالَهُ رِجَالٌ مِنْ أَبْنَاءِ  فَارِسَ  .","","Musnad Abi Ya'la al-Mawsili 1438","","قيس بن سعد بن عبادة عن يسار الثقفي مولى الأخنس بن شريق عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند قيس بن سعد"
"1439","[3/28]      مُسْنَدُ  أَبِي رَيْحَانَةَ  1 - (  1439  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  حَدَّثَنَا  حُمَيْدٌ الْكِنْدِيُّ ،  عَنْ  عُبَادَةَ بْنِ نُسَيٍّ ،  عَنْ  أَبِي رَيْحَانَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنِ انْتَسَبَ إِلَى تِسْعَةِ آبَاءٍ كُفَّارٍ يُرِيدُ بِهِمْ كَرَمًا وَعِزًّا  ، فَهُوَ عَاشِرُهُمْ فِي النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 1439","","شمعون بن زيد الكناني عن عبادة بن نسي الأردني عن حميد بن أبي حميد الخياط عن أبو بكر بن عياش عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند أبي ريحانة"
"1440","[3/29]      مُسْنَدُ  عُثْمَانَ بْنِ حُنَيْفٍ  1 - (  1440  ) -  حَدَّثَنَا  هَارُونُ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ مَسْلَمَةَ  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  سَالِمٍ أَبِي النَّضْرِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  قَالَ  :  خَرَجْتُ مَعَ عُثْمَانَ بْنِ حُنَيْفٍ نَعُودُ أَبَا طَلْحَةَ فِي شَكْوَى لَهُ ، قَالَ : فَدَخَلْنَا عَلَيْهِ ، وَتَحْتَهُ نَمَطٌ عَلَى فِرَاشِهِ ، فِيهِ صُورَةُ تَمَاثِيلَ ،  فَقَالَ  :  انْزِعُوا هَذَا مِنْ تَحْتِي  ، فَقَالَ لَهُ  عُثْمَانُ  :  أَوَمَا سَمِعْتَ يَا  أَبَا طَلْحَةَ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ حِينَ نَهَى عَنِ الصُّورَةِ : إِلَّا رَقْمًا فِي ثَوْبٍ أَوْ ثَوْبًا فِيهِ رَقْمٌ ؟  قَالَ : بَلَى ، وَلَكِنَّهُ أَطْيَبُ لِنَفْسِي أَنْ لَا يُجْعَلَ تَحْتِي  .  كذا في طبعة دار المأمون للتراث ، والصواب : ( محمد بن سلمة).","","Musnad Abi Ya'la al-Mawsili 1440","","زيد بن سهل بن الأسود الأنصاري عن عبيد الله بن عبد الله بن عتبة بن مسعود عن سالم بن أبي أمية التيمي عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عثمان بن حنيف"
"1441","[3/30]      مُسْنَدُ  أَبِي وَاقِدٍ اللَّيْثِيِّ  1 - (  1441  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سِنَانِ بْنِ أَبِي سِنَانٍ ،  عَنْ  أَبِي وَاقِدٍ اللَّيْثِيِّ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ أَتَى  خَيْبَرَ  مَرَّ بِشَجَرَةٍ يُعَلِّقُ الْمُشْرِكُونَ عَلَيْهَا أَسْلِحَتَهُمْ يُقَالُ لَهَا : ذَاتُ  أَنْوَاطٍ ،  فَقَالُوا : يَا رَسُولَ اللهِ ، اجْعَلْ لَنَا ذَاتَ  أَنْوَاطٍ ،  فَقَالَ :  اللهُ أَكْبَرُ ، هَذَا كَمَا قَالَ  قَوْمُ مُوسَى  لِمُوسَى  :         {      اجْعَلْ لَنَا إِلَهًا كَمَا لَهُمْ آلِهَةٌ         }      ، لَتَرْكَبُنَّ سُنَّةَ مَنْ كَانَ قَبْلَكُمْ  .         [3/31]","","Musnad Abi Ya'la al-Mawsili 1441","","أبو واقد الليثي عن سنان بن أبي سنان الدؤلي عن الزهري عن سفيان بن عيينة عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند أبي واقد الليثي"
"1442","2 - (  1442  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ عُثْمَانَ ،  عَنْ  نَافِعِ بْنِ سَرْجِسَ أَبِي سَعِيدٍ ،  أَنَّهُ سَمِعَ  أَبَا وَاقِدٍ اللَّيْثِيَّ ، صَاحِبَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَذُكِرَتِ الصَّلَاةُ عِنْدَهُ ، فَقَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَخَفَّ النَّاسِ صَلَاةً عَلَى النَّاسِ وَأَدْوَمَهُ عَلَى نَفْسِهِ  .","","Musnad Abi Ya'la al-Mawsili 1442","","أبو واقد الليثي عن نافع بن سرجس السباعي عن عبد الله بن عثمان بن خثيم عن عبد الوهاب بن عبد المجيد الثقفي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند أبي واقد الليثي"
"1443","3 - (  1443  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  ضَمْرَةَ بْنِ سَعِيدٍ ، قَالَ :  سَمِعْتُ  عُبَيْدَ اللهِ بْنَ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  يَقُولُ  :  خَرَجَ  عُمَرُ  يَوْمَ عِيدٍ فَسَأَلَ أَبَا وَاقِدٍ اللَّيْثِيَّ :  بِأَيِّ شَيْءٍ قَرَأَ         [3/32]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي هَذَا الْيَوْمِ ؟ فَقَالَ : بِـ "" قَافْ  وَ         {      اقْتَرَبَتِ         }      "" .","","Musnad Abi Ya'la al-Mawsili 1443","","أبو واقد الليثي عن عبيد الله بن عبد الله بن عتبة بن مسعود عن ضمرة بن سعيد بن أبي حنة المازني عن سفيان بن عيينة عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند أبي واقد الليثي"
"1444","4 - (  1444  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ الْكُوفِيُّ ابْنُ أُخْتِ حُسَيْنٍ الْجُعْفِيِّ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنِ  ابْنٍ لِأَبِي وَاقِدٍ اللَّيْثِيِّ ، صَاحِبِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  عَنْ  أَبِيهِ  ، أَنَّهُ قَالَ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ لِأَزْوَاجِهِ  عَامَ حَجَّةِ الْوَدَاعِ  :  هَذِهِ ، ثُمَّ ظُهُورَ  الْحُصُرِ  .","","Musnad Abi Ya'la al-Mawsili 1444","","أبو واقد الليثي عن واقد بن أبي واقد الأسلمي عن زيد بن أسلم عن عبد العزيز بن محمد الدراوردي عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند أبي واقد الليثي"
"1445","5 - (  1445  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ،  حَدَّثَنَا         [3/33]      عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  حَرْبٌ ،  حَدَّثَنَا  يَحْيَى ،  حَدَّثَنِي  إِسْحَاقُ بْنُ عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ ،  عَنْ  حُرَيْثٍ أَبِي مُرَّةَ ، أَنَّ أَبَا وَاقِدٍ اللَّيْثِيَّ  حَدَّثَهُ  ، قَالَ :  بَيْنَمَا نَحْنُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، إِذْ مَرَّ ثَلَاثَةُ نَفَرٍ ، فَجَاءَ أَحَدُهُمْ ، فَوَجَدَ فُرْجَةً فِي الْحَلْقَةِ ، فَجَلَسَ ، وَجَلَسَ الْآخَرُ مِنْ وَرَائِهِمْ ، وَانْطَلَقَ الثَّالِثُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَا أُخْبِرُكُمْ عَنْ هَؤُلَاءِ النَّفَرِ ؟  قَالُوا : بَلَى يَا رَسُولَ اللهِ ، قَالَ : أَمَّا الَّذِي جَاءَ فَجَلَسَ  فَأَوَى  ، فَآوَاهُ اللهُ ، وَأَمَّا الَّذِي جَلَسَ مِنْ وَرَائِكُمْ فَاسْتَحْيَا ، فَاسْتَحْيَا اللهُ مِنْهُ ، وَأَمَّا الَّذِي انْطَلَقَ فَرَجُلٌ أَعْرَضَ ، فَأَعْرَضَ اللهُ عَنْهُ  .         [3/34]","","Musnad Abi Ya'la al-Mawsili 1445","","أبو واقد الليثي عن حريث أبو مرة عن إسحاق بن عبد الله بن أبي طلحة الخزرجي عن يحيى بن أبي كثير عن حرب بن شداد اليشكري عن عبد الصمد بن عبد الوارث التنوري عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند أبي واقد الليثي"
"1446","6 - (  1446  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  ضَمْرَةَ         [3/35]      بْنِ سَعِيدٍ الْأَنْصَارِيِّ ،  سَمِعَ  عُبَيْدَ اللهِ بْنَ عَبْدِ اللهِ بْنِ عُتْبَةَ ، يَقُولُ :  خَرَجَ  عُمَرُ  فِي يَوْمِ عِيدٍ ، فَسَأَلَ أَبَا وَاقِدٍ اللَّيْثِيَّ :  بِأَيِّ شَيْءٍ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ فِي هَذَا الْيَوْمِ ؟ فَقَالَ : بِـ "" قَافْ  ، وَ         {      اقْتَرَبَتِ         }      .","","Musnad Abi Ya'la al-Mawsili 1446","","أبو واقد الليثي عن عبيد الله بن عبد الله بن عتبة بن مسعود عن ضمرة بن سعيد بن أبي حنة المازني عن سفيان بن عيينة عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند أبي واقد الليثي"
"1447","7 - (  1447  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  حَدَّثَنَا  أَبُو عَامِرٍ ،  عَنْ  فُلَيْحٍ ،  عَنْ  ضَمْرَةَ بْنِ سَعِيدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  أَبِي وَاقِدٍ اللَّيْثِيِّ ، قَالَ :  سَأَلَنِي  عُمَرُ  بِمَ قَرَأَ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْعِيدَيْنِ ؟ قُلْتُ : بِـ         {      اقْتَرَبَتِ السَّاعَةُ وَانْشَقَّ الْقَمَرُ         }      ، وَ"" قَافْ         {      وَالْقُرْآنِ الْمَجِيدِ         }      .","","Musnad Abi Ya'la al-Mawsili 1447","","أبو واقد الليثي عن عبيد الله بن عبد الله بن عتبة بن مسعود عن ضمرة بن سعيد بن أبي حنة المازني عن فليح بن سليمان عن أبو عامر العقدي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند أبي واقد الليثي"
"1448","8 - (  1448  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  وَهْبٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُثْمَانَ بْنِ خُثَيْمٍ ،  عَنْ  نَافِعِ بْنِ سَرْجِسَ ،  عَنْ  أَبِي وَاقِدٍ اللَّيْثِيِّ ، أَنَّهُ سَمِعَهُ يَقُولُ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ أَخَفَّ النَّاسِ صَلَاةً وَأَدْوَمَهُ عَلَى نَفْسِهِ  .         [3/36]","","Musnad Abi Ya'la al-Mawsili 1448","","أبو واقد الليثي عن نافع بن سرجس السباعي عن عبد الله بن عثمان بن خثيم عن وهيب بن خالد الكرابيسي عن عفان بن مسلم الصفار عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند أبي واقد الليثي"
"1449","9 - (  1449  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ الْوَرَّاقُ ،  حَدَّثَنَا  حُسَيْنٌ الْجُعْفِيُّ ،  عَنْ  زَائِدَةَ ،  عَنِ  ابْنِ خُثَيْمٍ الْمَكِّيِّ ،  عَنْ  نَافِعِ بْنِ سَرْجِسَ ، قَالَ :  دَخَلْتُ عَلَى أَبِي وَاقِدٍ اللَّيْثِيِّ  بِمَكَّةَ  فِي مَرَضِهِ الَّذِي مَاتَ فِيهِ ،  فَسَمِعْتُهُ يَقُولُ ، أَوْ قَالَ لِي  :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَخَفَّ النَّاسِ صَلَاةً  وَأَدْوَمَهُ عَلَى نَفْسِهِ  .","","Musnad Abi Ya'la al-Mawsili 1449","","أبو واقد الليثي عن نافع بن سرجس السباعي عن عبد الله بن عثمان بن خثيم عن زائدة بن قدامة عن الحسين بن علي الجعفي عن الحسن بن حماد الوراق عن أبو يعلى الموصلي","مسند أبي واقد الليثي"
"1450","10 - (  1450  ) -  حَدَّثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَخْبَرَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِي وَاقِدٍ اللَّيْثِيِّ ، قَالَ :  قَدِمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْمَدِينَةَ  وَالنَّاسُ  يَجُبُّونَ  أَسْنِمَةَ الْإِبِلِ ، وَيَقْطَعُونَ  أَلَيَاتِ  الْغَنَمِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا قُطِعَ مِنَ الْبَهِيمَةِ وَهِيَ حَيَّةٌ ، فَهِيَ مَيْتَةٌ  .","","Musnad Abi Ya'la al-Mawsili 1450","","أبو واقد الليثي عن زيد بن أسلم عن عبد الرحمن بن عبد الله بن دينار العدوي عن علي بن الجعد عن أبو يعلى الموصلي","مسند أبي واقد الليثي"
"1451","[3/37]      مُسْنَدُ  عَبْدِ اللهِ الصُّنَابِحِيِّ  1 - (  1451  ) -  حَدَّثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ ،  حَدَّثَنِي  مَالِكُ بْنُ أَنَسٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  عَبْدِ اللهِ الصُّنَابِحِيِّ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ الشَّمْسَ تَطْلُعُ مَعَهَا  قَرْنُ  شَيْطَانٍ  ، فَإِذَا ارْتَفَعَتْ فَارَقَهَا ، فَإِذَا اسْتَوَتْ قَارَنَهَا ، فَإِذَا زَالَتْ فَارَقَهَا ، فَإِذَا دَنَتْ لِلْغُرُوبِ قَارَنَهَا ، فَإِذَا غَرَبَتْ فَارَقَهَا ، فَنَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، عَنِ الصَّلَاةِ فِي تِلْكَ السَّاعَاتِ  .         [3/38]             [3/39]","","Musnad Abi Ya'la al-Mawsili 1451","","عبد الله الصنابحي عن عطاء بن يسار الهلالي عن زيد بن أسلم عن مالك بن أنس عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عبد الله الصنابحي"
"1452","2 - (  1452  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  عَبَّادُ بْنُ عَبَّادٍ ،  عَنْ  مُجَالِدِ بْنِ سَعِيدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الصُّنَابِحِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنِّي مُكَاثِرٌ بِكُمُ الْأُمَمَ  ، فَلَا تَرْجِعُوا بَعْدِي  كُفَّارًا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  .","","Musnad Abi Ya'la al-Mawsili 1452","","صنابح بن الأعسر الأحمسي عن قيس بن أبي حازم عن مجالد بن سعيد عن عباد بن عباد بن حبيب عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","مسند عبد الله الصنابحي"
"1453","3 - (  1453  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  مُجَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الصُّنَابِحِيِّ الْأَحْمَسِيِّ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَبْصَرَ نَاقَةً حَسَنَةً فِي إِبِلِ الصَّدَقَةِ ، فَقَالَ :  قَاتَلَ اللهُ صَاحِبَ هَذِهِ النَّاقَةِ  ، قَالَ : يَا         [3/40]      رَسُولَ اللهِ ، إِنِّي  ارْتَجَعْتُهَا  بِبَعِيرَيْنِ مِنْ حَوَاشِي الْإِبِلِ ، فَقَالَ : فَنَعَمْ إِذًا  .","","Musnad Abi Ya'la al-Mawsili 1453","","صنابح بن الأعسر الأحمسي عن قيس بن أبي حازم عن مجالد بن سعيد عن عبد الرحيم بن سليمان الأشل عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله الصنابحي"
"1454","4 - (  1454  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  ابْنُ مُبَارَكٍ ، وَوَكِيعٌ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنِ  الصُّنَابِحِيِّ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  :  إِنِّي  فَرَطٌ  عَلَى الْحَوْضِ  ، وَإِنِّي مُكَاثِرٌ بِكُمُ الْأُمَمَ ، فَلَا تَقْتَتِلُنَّ بَعْدِي  .","","Musnad Abi Ya'la al-Mawsili 1454","","صنابح بن الأعسر الأحمسي عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله الصنابحي"
"1455","5 - (  1455  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  ابْنُ نُمَيْرٍ ، وَأَبُو أُسَامَةَ ، قَالَا :  حَدَّثَنَا  إِسْمَاعِيلُ ،  عَنْ  قَيْسٍ ،  عَنِ  الصُّنَابِحِيِّ الْأَحْمَسِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 1455","","صنابح بن الأعسر الأحمسي عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله الصنابحي"
"1456","[3/41]      مُسْنَدُ  عَمْرِو بْنِ حُرَيْثٍ  1 - (  1456  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  يَحْيَى بْنُ يَمَانٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  سَمِعْتُ  عَمْرَو بْنَ حُرَيْثٍ ، يَقُولُ :  ذَهَبَتْ بِي أُمِّي إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَمَسَحَ رَأْسِي وَدَعَا لِي بِالرِّزْقِ  .","","Musnad Abi Ya'la al-Mawsili 1456","","عمرو بن حريث بن عمرو المخزومي عن إسماعيل بن أبي خالد عن يحيى بن يمان العجلي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عمرو بن حريث"
"1457","2 - (  1457  ) -  حَدَّثَنَا  مُحْرِزُ بْنُ عَوْنٍ ،  حَدَّثَنَا  خَلَفُ بْنُ         [3/42]      خَلِيفَةَ ،  عَنِ  الْوَلِيدِ بْنِ سَرِيعٍ مَوْلَى آلِ عَمْرِو بْنِ حُرَيْثٍ ،  عَنْ  عَمْرِو بْنِ حُرَيْثٍ ، قَالَ :  صَلَّيْتُ خَلْفَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْفَجْرَ ، فَسَمِعْتُهُ يَقْرَأُ :         {      فَلا أُقْسِمُ بِالْخُنَّسِ             *          الْجَوَارِ الْكُنَّسِ         }      ، قَالَ : وَكَانَ لَا  يَحْنِي  رَجُلٌ مِنَّا ظَهْرَهُ حَتَّى يَسْتَقِيمَ سَاجِدًا  .","","Musnad Abi Ya'la al-Mawsili 1457","","عمرو بن حريث بن عمرو المخزومي عن الوليد بن سريع المخزومي عن خلف بن خليفة الأشجعي عن محرز بن عون الهلالي عن أبو يعلى الموصلي","مسند عمرو بن حريث"
"1458","3 - (  1458  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ بْنِ مَيْسَرَةَ الْجُشَمِيُّ ،  حَدَّثَنَا  عَفِيفُ بْنُ سَالِمٍ الْمَوْصِلِيُّ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ بْنِ الْمُهَاجِرِ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  عَمْرِو بْنِ حُرَيْثٍ ، قَالَ :  بِعْتُ دَارًا لِي وَأَرْضًا  بِالْمَدِينَةِ  ، فَقَالَ لِي أَخِي سَعِيدُ بْنُ حُرَيْثٍ : اسْتَعِفَّ عَنْهَا مَا اسْتَطَعْتَ ، وَلَا تُنْفِقَنَّ مِنْهَا شَيْئًا  ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ بَاعَ دَارًا أَوْ  عَقَارًا  فَإِنَّهُ  قَمِنٌ  أَنْ لَا يُبَارَكَ لَهُ فِيهِ إِلَّا أَنْ يَجْعَلَهُ فِي مِثْلِهِ  ، قَالَ  عَمْرٌو  : فَاشْتَرَيْتُ بِبَعْضِ ثَمَنِهَا دَارِي هَذِهِ ، يَعْنِي دَارَ  عَمْرِو بْنِ         [3/43]      حُرَيْثٍ  .","","Musnad Abi Ya'la al-Mawsili 1458","","سعيد بن حريث المخزومي عن عمرو بن حريث بن عمرو المخزومي عن عبد الملك بن عمير القبطي عن إسماعيل بن إبراهيم بن مهاجر النخعي عن عفيف بن سالم الموصلي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمرو بن حريث"
"1459","4 - (  1459  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  مُسَاوِرٍ الْوَرَّاقِ ،  عَنْ  جَعْفَرِ بْنِ عَمْرِو بْنِ حُرَيْثٍ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ رَأَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَيْهِ عِمَامَةٌ سَوْدَاءُ  .         [3/44]","","Musnad Abi Ya'la al-Mawsili 1459","","عمرو بن حريث بن عمرو المخزومي عن جعفر بن عمرو بن حريث المخزومي عن مساور الوراق عن سفيان بن عيينة عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمرو بن حريث"
"1460","5 - (  1460  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  مُسَاوِرٍ الْوَرَّاقِ ،  عَنْ  جَعْفَرِ بْنِ عَمْرِو بْنِ حُرَيْثٍ ،  عَنْ  أَبِيهِ ،  قَالَ :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعَلَيْهِ عِمَامَةٌ سَوْدَاءُ  .","","Musnad Abi Ya'la al-Mawsili 1460","","عمرو بن حريث بن عمرو المخزومي عن جعفر بن عمرو بن حريث المخزومي عن مساور الوراق عن وكيع بن الجراح عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمرو بن حريث"
"1461","6 - (  1461  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ ،  حَدَّثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ،  حَدَّثَنَا  مِسْعَرٌ ،  عَنِ  الْوَلِيدِ بْنِ سَرِيعٍ ،  عَنْ  عَمْرِو بْنِ حُرَيْثٍ ، قَالَ :  سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ فِي الْفَجْرِ :         {      وَاللَّيْلِ إِذَا عَسْعَسَ         }      .","","Musnad Abi Ya'la al-Mawsili 1461","","عمرو بن حريث بن عمرو المخزومي عن الوليد بن سريع المخزومي عن مسعر بن كدام عن محمد بن عبد الله بن الزبير عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمرو بن حريث"
"1462","7 - (  1462  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْخَطَّابِ ،  حَدَّثَنَا  مُؤَمَّلٌ ،  حَدَّثَنَا  شُعْبَةُ ،  حَدَّثَنَا  حُصَيْنٌ ،  عَنْ  عَبْدِ الْمَلِكِ ،  عَنْ  عَمْرِو بْنِ حُرَيْثٍ ، قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رُبَّمَا مَسَّ لِحْيَتَهُ فِي الصَّلَاةِ  .         [3/45]","","Musnad Abi Ya'la al-Mawsili 1462","","عمرو بن حريث بن عمرو المخزومي عن عبد الملك بن سعد المخزومي عن حصين بن عبد الرحمن السلمي عن شعبة بن الحجاج عن مؤمل بن إسماعيل العدوي عن محمد بن الخطاب البلدي عن أبو يعلى الموصلي","مسند عمرو بن حريث"
"1463","8 - (  1463  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الْأَصْبَغِ ،  عَنْ  عَمْرِو بْنِ حُرَيْثٍ ، وَقَالَ  مُعْتَمِرٌ  مَوْلًى لِعَمْرِو بْنِ حُرَيْثٍ ،  عَنْ  عَمْرِو بْنِ حُرَيْثٍ ، قَالَ :  صَلَّيْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَرَأَ  ، فَكَأَنِّي أَسْمَعُ صَوْتَهُ وَهُوَ يَقُولُ :         {      فَلا أُقْسِمُ بِالْخُنَّسِ             *          الْجَوَارِ الْكُنَّسِ         }      .  قَالَ  مُحَمَّدُ بْنُ يَزِيدَ  فِي حَدِيثِهِ : وَذَهَبَتْ بِي  أُمِّي أَوْ أَبِي  إِلَيْهِ ، فَدَعَا لِي بِالرِّزْقِ  .","","Musnad Abi Ya'la al-Mawsili 1463","","عمرو بن حريث بن عمرو المخزومي عن أصبغ المخزومي مولى عمرو بن حريث القرشي عن إسماعيل بن أبي خالد عن عبدة بن سليمان الكلابي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عمرو بن حريث"
"1464","9 - (  1464  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ،  عَنْ  فِطْرِ بْنِ خَلِيفَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَمْرِو بْنِ حُرَيْثٍ ، قَالَ :  خَطَّ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَارًا         [3/46]      بِالْمَدِينَةِ  بِقَوْسٍ  ، وَقَالَ : أَزِيدُكَ  .","","Musnad Abi Ya'la al-Mawsili 1464","","عمرو بن حريث بن عمرو المخزومي عن خليفة المخزومي والد فطر عن فطر بن خليفة عن عبد الله بن داود الخريبي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمرو بن حريث"
"1465","10 - (  1465  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  السُّدِّيِّ ،  حَدَّثَنِي  مَنْ  سَمِعَ  عَمْرَو بْنَ حُرَيْثٍ ، يَقُولُ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي فِي نَعْلَيْنِ مَخْصُوفَتَيْنِ  .         [3/47]","","Musnad Abi Ya'la al-Mawsili 1465","","عمرو بن حريث بن عمرو المخزومي عن من عن السدي الكبير عن سفيان الثوري عن عبد الرحمن بن مهدي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمرو بن حريث"
"1466","11 - (  1466  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ ،  حَدَّثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي إِسْحَاقَ ، عَمَّنْ  سَمِعَ  عَمْرَو بْنَ حُرَيْثٍ ، يَقُولُ :  رَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي فِي نَعْلَيْنِ مَخْصُوفَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 1466","","عمرو بن حريث بن عمرو المخزومي عن عمن عن أبو إسحاق السبيعي عن سفيان الثوري عن محمد بن عبد الله بن الزبير عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمرو بن حريث"
"1467","12 - (  1467  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ،  عَنْ  فِطْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَمْرِو بْنِ حُرَيْثٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّ  بِعَبْدِ اللهِ بْنِ جَعْفَرٍ  وَهُوَ يَبِيعُ مَعَ  الْغِلْمَانِ أَوِ الصِّبْيَانِ  فَقَالَ :  اللَّهُمَّ بَارِكْ لَهُ  فِي بَيْعِهِ ، أَوْ قَالَ : فِي سَفْقَتِهِ  .","","Musnad Abi Ya'la al-Mawsili 1467","","عمرو بن حريث بن عمرو المخزومي عن خليفة المخزومي والد فطر عن فطر بن خليفة عن عبد الله بن داود الخريبي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمرو بن حريث"
"1468","13 - (  1468  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  مِسْعَرٍ ،  حَدَّثَنِي  الْوَلِيدُ بْنُ سَرِيعٍ ،  عَنْ  عَمْرِو بْنِ حُرَيْثٍ ، قَالَ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ فِي الصُّبْحِ :         {      وَاللَّيْلِ إِذَا عَسْعَسَ         }      أَوْ قَالَ :         {      إِذَا الشَّمْسُ كُوِّرَتْ         }      .         [3/48]","","Musnad Abi Ya'la al-Mawsili 1468","","عمرو بن حريث بن عمرو المخزومي عن الوليد بن سريع المخزومي عن مسعر بن كدام عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عمرو بن حريث"
"1469","14 - (  1469  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ يَزِيدَ الْوَاسِطِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  مَوْلَى عَمْرِو بْنِ حُرَيْثٍ ،  عَنْ  عَمْرِو بْنِ حُرَيْثٍ ، قَالَ :  صَلَّيْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْفَجْرَ فَقَرَأَ :         {      إِذَا الشَّمْسُ كُوِّرَتْ         }      ، كَأَنِّي أَسْمَعُ صَوْتَهُ يَقُولُ :         {      فَلا أُقْسِمُ بِالْخُنَّسِ             *          الْجَوَارِ الْكُنَّسِ         }      ، وَقَالَ : ذَهَبَتْ بِي أُمِّي وَأَبِي إِلَيْهِ فَدَعَا لِي بِالرِّزْقِ  .","","Musnad Abi Ya'la al-Mawsili 1469","","عمرو بن حريث بن عمرو المخزومي عن أصبغ المخزومي مولى عمرو بن حريث القرشي عن إسماعيل بن أبي خالد عن محمد بن يزيد الكلاعي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عمرو بن حريث"
"1470","15 - (  1470  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  عَبْدُ الْوَارِثِ بْنُ سَعِيدٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  عَمْرِو بْنِ حُرَيْثٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْكَمْأَةُ  مِنَ السَّلْوَى  ، وَمَاؤُهَا شِفَاءٌ لِلْعَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 1470","","عمرو بن حريث بن عمرو المخزومي عن عطاء بن السائب عن عبد الوارث بن سعيد بن ذكوان عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمرو بن حريث"
"1471","16 - (  1471  ) -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَبْدِ الْأَعْلَى ،  عَنِ  الْوَلِيدِ بْنِ عَلِيٍّ ،  عَنْ  مُحَمَّدِ بْنِ         [3/49]      سُوقَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  أَتَيْتُ عَمْرَو بْنَ حُرَيْثٍ أَتَكَارَى مِنْهُ بَيْتًا فِي دَارِهِ ، فَقَالَ : تَكَارَّ ، فَإِنَّهَا مُبَارَكَةٌ عَلَى مَنْ هِيَ لَهُ ، مُبَارَكَةٌ عَلَى مَنْ سَكَنَهَا ، فَقُلْتُ : مِنْ أَيِّ شَيْءٍ ذَلِكَ ؟ قَالَ : أَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقَدْ نُحِرَتْ جَزُورٌ ، وَقَدْ أَمَرَ بِقِسْمَتِهَا ، فَقَالَ لِلَّذِي يَقْسِمُهَا :  أَعْطِ  عَمْرًا  مِنْهَا قَسْمًا  ، فَلَمْ يُعْطِنِي ، وَأَغْفَلَنِي ، فَلَمَّا كَانَ مِنَ الْغَدِ ، أَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَبَيْنَ يَدَيْهِ دَرَاهِمُ ، فَقَالَ : أَخَذْتَ الْقَسْمَ الَّذِي أَمَرْتُ لَكَ ؟ قَالَ : قُلْتُ : يَا رَسُولَ اللهِ مَا أَعْطَانِي شَيْئًا ، قَالَ : فَتَنَاوَلَ كَفًّا مِنْ دَرَاهِمَ ، ثُمَّ أَعْطَانِيهَا ، فَجِئْتُ بِهَا إِلَى أُمِّي ، فَقُلْتُ : خُذِي هَذِهِ الدَّرَاهِمَ ، أَخَذَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِيَدِهِ ، ثُمَّ أَعْطَانِيهَا ، أَمْسِكِيهَا حَتَّى نَنْظُرَ فِي أَيِّ شَيْءٍ نَضَعُهَا ، ثُمَّ ضَرَبَ الدَّهْرُ ضَرْبًا بِهِ حَتَّى اشْتَرَيْتُ هَذِهِ الدَّارَ ، قَالَتْ أُمِّي : إِذَا أَرَدْتَ أَنْ تَنْقُدَ ثَمَنَهَا فَلَا تَنْقُدْ حَتَّى تَدْعُوَنِي أَدْعُو لَكَ بِالْبَرَكَةِ ، فَدَعَوْتُهَا حِينَ هَيَّأْتُهَا ، فَقَالَتْ لِي : خُذْ هَذِهِ الدَّرَاهِمَ ، فَنَثَرْتُهَا فِيهَا ، ثُمَّ خَلَطْتُهَا بِهَا ، وَقَالَتِ : اذْهَبْ بِهَا  .","","Musnad Abi Ya'la al-Mawsili 1471","","عمرو بن حريث بن عمرو المخزومي عن سوقة الغنوي عن محمد بن سوقة الغنوي عن الوليد بن علي الجعفي عن إسماعيل بن عبد الأعلى الغبري عن يحيى بن عبد الحميد عن أبو يعلى الموصلي","مسند عمرو بن حريث"
"1472","[3/50]      مُسْنَدُ  عَمْرِو بْنِ حُرَيْثٍ  ( رَجُلٌ آخَرُ ذَكَرَهُ  أَبُو خَيْثَمَةَ  )  1 - (  1472  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  وَحَدَّثَنَا  أَحْمَدُ بْنُ الدَّوْرَقِيِّ ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  حَدَّثَنِي  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  حَدَّثَنِي  أَبُو هَانِئٍ ،         [3/51]      حَدَّثَنِي  عَمْرُو بْنُ حُرَيْثٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا خَفَّفْتَ عَنْ خَادِمِكَ مِنْ عَمَلِهِ  ، فَإِنَّ أَجْرَهُ فِي مَوَازِينِكَ  .","","Musnad Abi Ya'la al-Mawsili 1472","","عمرو بن حريث بن عمرو المخزومي عن حميد بن هانئ الخولاني عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عمرو بن حريث ( رجل آخر ذكره أبو خيثمة"
"1473","2 - (  1473  ) -  حَدَّثَنَا  زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  حَدَّثَنَا  حَيْوَةُ ، قَالَ :  أَخْبَرَنِي  أَبُو هَانِئٍ حُمَيْدُ بْنُ هَانِئٍ الْخَوْلَانِيُّ ،  أَنَّهُ سَمِعَ  أَبَا عَبْدِ الرَّحْمَنِ الْحُبُلِيَّ وَهُوَ عَبْدُ اللهِ بْنُ يَزِيدَ ، وَعَمْرَو بْنَ حُرَيْثٍ ، وَغَيْرَهُمَا يَقُولُونَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّكُمْ سَتَقْدَمُونَ عَلَى قَوْمٍ ،  جُعْدٌ  رُءُوسُهُمْ ، فَاسْتَوْصُوا بِهِمْ خَيْرًا  ، فَإِنَّهُمْ قُوَّةٌ لَكُمْ ،  وَبَلَاغٌ  إِلَى عَدُوِّكُمْ بِإِذْنِ اللهِ ،  يَعْنِي  قِبْطَ مِصْرَ  .","","Musnad Abi Ya'la al-Mawsili 1473","","عمرو بن حريث بن عمرو المخزومي عن حميد بن هانئ الخولاني عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عمرو بن حريث ( رجل آخر ذكره أبو خيثمة"
"1474","[3/52]      مُسْنَدُ  حَارِثَةَ بْنِ وَهْبٍ  1 - (  1474  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ، وَأَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  حَارِثَةَ بْنِ وَهْبٍ ، قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمِنًى  - آمَنَ مَا كَانَ النَّاسُ وَأَكْثَرَهُ - رَكْعَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 1474","","حارثة بن وهب الخزاعي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند حارثة بن وهب"
"1475","2 - (  1475  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  مَعْبَدِ بْنِ خَالِدٍ ، قَالَ :         [3/53]      سَمِعْتُ  حَارِثَةَ بْنَ وَهْبٍ الْخُزَاعِيَّ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَصَدَّقُوا فَإِنَّهُ  يُوشِكُ  أَنْ يَخْرُجَ الرَّجُلُ بِصَدَقَتِهِ فَلَا يَجِدُ مَنْ يَقْبَلُهَا  .","","Musnad Abi Ya'la al-Mawsili 1475","","حارثة بن وهب الخزاعي عن معبد بن خالد بن مزين الجدلي عن شعبة بن الحجاج عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند حارثة بن وهب"
"1476","3 - (  1476  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  مَعْبَدِ بْنِ خَالِدٍ ،  عَنْ  حَارِثَةَ بْنِ وَهْبٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَدْخُلُ الْجَنَّةَ الْجَوَّاظُ  ، وَلَا الْجَعْظَرِيُّ  .  قَالَ :  وَالْجَوَّاظُ :  الْفَظُّ  الْغَلِيظُ  .","","Musnad Abi Ya'la al-Mawsili 1476","","حارثة بن وهب الخزاعي عن معبد بن خالد بن مزين الجدلي عن سفيان الثوري عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند حارثة بن وهب"
"1477","4 - (  1477  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا         [3/54]      حَجَّاجٌ ، أَوْ غَيْرُهُ  ،  أَخْبَرَنَا  شُعْبَةُ ،  حَدَّثَنَا  مَعْبَدُ بْنُ خَالِدٍ ،  أَنَّهُ سَمِعَ  حَارِثَةَ بْنَ وَهْبٍ الْخُزَاعِيَّ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَلَا أَدُلُّكُمْ عَلَى أَهْلِ الْجَنَّةِ ؟ كُلُّ  ضَعِيفٍ  مُتَضَعِّفٍ  لَوْ أَقْسَمَ عَلَى اللهِ  لَأَبَرَّهُ  ، وَأَهْلُ النَّارِ كُلُّ مُسْتَكْبِرٍ  جَوَّاظٍ  .","","Musnad Abi Ya'la al-Mawsili 1477","","حارثة بن وهب الخزاعي عن معبد بن خالد بن مزين الجدلي عن شعبة بن الحجاج عن غيره عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند حارثة بن وهب"
"1478","5 - (  1478  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَخْبَرَنَا  خَالِدٌ ،  عَنْ  دَاوُدَ ،  عَنْ  عَبَّاسٍ ،  عَنْ  كِنْدِيرِ بْنِ سَعِيدٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  حَجَجْتُ فِي الْجَاهِلِيَّةِ ، فَإِذَا بِرَجُلٍ يَطُوفُ  بِالْبَيْتِ  وَهُوَ يَرْتَجِزُ :  قُلْتُ : مَنْ هَذَا يَعْنِي ؟ فَقَالُوا :  عَبْدُ الْمُطَّلِبِ بْنُ هَاشِمٍ  ، ذَهَبَتْ إِبِلٌ لَهُ ، فَأَرْسَلَ ابْنَ ابْنِهِ فِي طَلَبِهَا ، فَاحْتُبِسَ عَلَيْهِ ، وَلَمْ يُرْسِلْهُ فِي حَاجَةٍ قَطُّ إِلَّا جَاءَ بِهَا ، قَالَ : فَمَا بَرِحْتُ حَتَّى جَاءَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [3/55]      وَجَاءَ بِالْإِبِلِ ، فَقَالَ :  يَا بُنَيَّ ، لَقَدْ حَزِنْتُ عَلَيْكَ هَذِهِ الْمَرَّةَ حُزْنًا لَا يُفَارِقُنِي أَبَدًا  .","","Musnad Abi Ya'la al-Mawsili 1478","","سعيد بن حيوة الباهلي عن كندير بن سعيد عن عباس بن عبد الرحمن الهاشمي عن داود بن أبي هند عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند حارثة بن وهب"
"1479","6 - (  1479  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  حَدَّثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ،  حَدَّثَنَا  سَعْدُ بْنُ أَوْسٍ الْعَبْسِيُّ ،  عَنْ  شُتَيْرِ بْنِ شَكَلٍ ،  عَنْ  أَبِيهِ شَكَلِ بْنِ حُمَيْدٍ  ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، عَلِّمْنِي تَعَوُّذًا أَتَعَوَّذُ بِهِ ، فَأَخَذَ بِيَدِي ، فَقَالَ : قُلِ : اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ شَرِّ نَفْسِي  ، وَمِنْ شَرِّ سَمْعِي ، وَمِنْ شَرِّ بَصَرِي ، وَمِنْ شَرِّ قَلْبِي ، وَمِنْ شَرِّ لِسَانِي ، وَمِنْ شَرِّ مَنِيِّي  .         [3/56]","","Musnad Abi Ya'la al-Mawsili 1479","","شكل بن حميد العبسي عن شتير بن شكل العبسي عن سعد بن أوس العبسي عن محمد بن عبد الله بن الزبير عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند حارثة بن وهب"
"1480","7 - (  1480  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ  حَدَّثَنَا  عَبَّادُ بْنُ عَبَّادٍ ،  عَنِ  الزُّبَيْرِ بْنِ خِرِّيتٍ ،  عَنْ  نُعَيْمِ بْنِ أَبِي هِنْدٍ قَالَ :  كُنْتُ جَالِسًا إِلَى يَزِيدَ بْنِ أَبِي مُسْلِمٍ أَيَّامَ  الْحَجَّاجِ  وَهُوَ يُعَذِّبُ النَّاسَ  ، فَذَكَرَ رَجُلًا فِي السِّجْنِ ، فَبَعَثَ إِلَيْهِ بِغَيْظٍ وَغَضَبٍ فَأُتِيَ بِهِ ، فَلَمَّا قَامَ بَيْنَ يَدَيْهِ رَأَيْتُ الرَّجُلَ حَرَّكَ شَفَتَيْهِ بِشَيْءٍ لَمْ أَسْمَعْهُ ، فَرَفَعَ رَأْسَهُ إِلَيْهِ فَقَالَ :  خَلُّوا سَبِيلَهُ أَوْ قَالَ : رُدُّوهُ  .  قَالَ : فَقُمْتُ إِلَى الرَّجُلِ فَقُلْتُ : إِنِّي شَهِدْتُ هَذَا حِينَ أَرْسَلَ إِلَيْكَ بِغَيْظٍ وَغَضَبٍ ، وَلَا أَشُكُّ أَنَّهُ سَيَقَعُ بِكَ ، فَلَمَّا قُمْتُ بَيْنَ يَدَيْهِ رَأَيْتُكَ حَرَّكْتَ شَفَتَيْكَ بِشَيْءٍ لَمْ أَسْمَعْهُ ، فَأَمَرَ فِيكَ بِمَا تَرَى ، فَمَا الَّذِي قُلْتَ ؟  قَالَ : قُلْتُ : اللَّهُمَّ إِنِّي أَسْأَلُكَ بِقُدْرَتِكَ الَّتِي تُمْسِكُ بِهَا السَّمَاوَاتِ السَّبْعَ أَنْ يَقَعَ بَعْضُهُنَّ عَلَى بَعْضٍ أَنْ تَكْفِينِيهِ  .         [3/57]","","Musnad Abi Ya'la al-Mawsili 1480","","يزيد بن أبي مسلم مولى الحجاج عن نعيم بن أبي هند الأشجعي عن الزبير بن الخريت عن عباد بن عباد بن حبيب عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","مسند حارثة بن وهب"
"1481","8 - (  1481  ) -  حَدَّثَنَا  التَّرْجُمَانِيُّ أَبُو إِبْرَاهِيمَ ،  حَدَّثَنَا  عُبَيْسُ بْنُ مَيْمُونٍ ،  حَدَّثَنَا  يَزِيدُ الرَّقَاشِيُّ ،  عَنْ  أَنَسٍ ، قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  :  أَمَا يَسْتَطِيعُ أَحَدُكُمْ أَنْ يَقْرَأَ فِي اللَّيْلَةِ :         {      قُلْ هُوَ اللهُ أَحَدٌ         }      فَإِنَّهَا تَعْدِلُ الْقُرْآنَ كُلَّهُ  .  قَالَ : وَقَالَ :  لَا بُدَّ لِلنَّاسِ مِنْ عَرِيفٍ ، وَالْعَرِيفُ فِي النَّارِ  . قَالَ :  وَيُؤْتَى بِالشُّرْطِيِّ يَوْمَ الْقِيَامَةِ  ، فَيُقَالُ لَهُ : ضَعْ سَوْطَكَ وَادْخُلِ النَّارَ  .","","Musnad Abi Ya'la al-Mawsili 1481","","أنس بن مالك عن يزيد بن أبان الرقاشي عن عبيس بن ميمون التيمي عن إسماعيل بن إبراهيم الترجماني عن أبو يعلى الموصلي","مسند حارثة بن وهب"
"1482","9 - (  1482  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  مُعْتَمِرٌ ، قَالَ :  سَمِعْتُ  ابْنَ أَبِي الْحَكَمِ الْغِفَارِيَّ ، يَقُولُ :  حَدَّثَتْنِي  جَدَّتِي  ،  عَنْ  عَمِّ أَبِي رَافِعِ بْنِ عَمْرٍو الْغِفَارِيِّ ، قَالَ :  كُنْتُ وَأَنَا         [3/58]      غُلَامٌ أَرْمِي نَخْلَ  الْأَنْصَارِ  ، فَقِيلَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنَّ هَاهُنَا غُلَامًا  يَرْمِي نَخْلَنَا ، أَوْ قَالَ : يَرْمِي النَّخْلَ  ، قَالَ : فَأُتِيَ بِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ :  يَا غُلَامُ ، لَا تَرْمِ النَّخْلَ  ، قَالَ : قُلْتُ : آكُلُ ، قَالَ : لَا تَرْمِ النَّخْلَ ، كُلْ مَا سَقَطَ ، قَالَ : وَمَسَحَ رَأْسَهُ ، وَقَالَ : اللَّهُمَّ أَشْبِعْ بَطْنَهُ  .","","Musnad Abi Ya'la al-Mawsili 1482","","رافع بن عمرو بن مجدع الغفاري عن جدة ابن أبي الحكم الغفاري عن ابن أبي الحكم الغفاري عن معتمر بن سليمان عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند حارثة بن وهب"
"1483","[3/59]      مُسْنَدُ  مُعَاذِ بْنِ أَنَسٍ  1 - (  1483  ) -  حَدَّثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  حَدَّثَنِي  أَسِيدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  فَرْوَةَ بْنِ مُجَاهِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذٍ الْجُهَنِيِّ  ،  قَالَ  :  غَزَوْتُ مَعَ أَبِي الصَّائِفَةَ فِي زَمَنِ  عَبْدِ الْمَلِكِ بْنِ مَرْوَانَ  ، وَعَلَيْنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْمَلِكِ  ، فَنَزَلْنَا عَلَى  حِصْنِ سِنَانٍ  ، فَضَيَّقَ النَّاسُ الْمَنَازِلَ ، وَقَطَعُوا الطُّرُقَ ، فَقَامَ  أَبِي  فِي النَّاسِ ، فَقَالَ : أَيُّهَا النَّاسُ ، إِنِّي غَزَوْتُ مَعَ نَبِيِّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غَزْوَةَ كَذَا وَكَذَا ، فَضَيَّقَ النَّاسُ الْمَنَازِلَ ، وَقَطَعُوا الطُّرُقَ ، فَبَعَثَ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُنَادِيًا فَنَادَى فِي النَّاسِ :  أَنَّ مَنْ ضَيَّقَ         [3/60]      مَنْزِلًا ، أَوْ قَطَعَ طَرِيقًا فَلَا  جِهَادَ  لَهُ  .","","Musnad Abi Ya'la al-Mawsili 1483","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن فروة بن مجاهد اللخمي عن أسيد بن عبد الرحمن الخثعمي عن إسماعيل بن عياش الأحول عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1484","2 - (  1484  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ عَبْدُ اللهِ بْنُ يَزِيدَ ،  حَدَّثَنِي  سَعِيدٌ يَعْنِي ابْنَ أَبِي أَيُّوبَ ، قَالَ :  حَدَّثَنِي  عَبْدُ الرَّحِيمِ بْنُ مَيْمُونٍ أَبُو مَرْحُومٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ تَرَكَ اللِّبَاسَ وَهُوَ يَقْدِرُ عَلَيْهِ تَوَاضُعًا لِلهِ  ، دَعَاهُ اللهُ يَوْمَ الْقِيَامَةِ عَلَى رُءُوسِ الْخَلَائِقِ يُخَيِّرُهُ بَيْنَ حُلَلِ الْإِيمَانِ يَلْبَسُ أَيَّهَا شَاءَ  .","","Musnad Abi Ya'la al-Mawsili 1484","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن عبد الرحيم بن ميمون المعافري عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1485","3 - (  1485  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  حَدَّثَنَا  سَعِيدٌ ، قَالَ :  حَدَّثَنِي  عَبْدُ الرَّحِيمِ بْنُ مَيْمُونٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَعْطَى لِلهِ ، وَمَنَعَ         [3/61]      لِلهِ  ، وَأَحَبَّ لِلهِ ، وَأَبْغَضَ لِلهِ ، وَأَنْكَحَ لِلهِ ، فَقَدِ اسْتَكْمَلَ إِيمَانَهُ  .","","Musnad Abi Ya'la al-Mawsili 1485","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن عبد الرحيم بن ميمون المعافري عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1486","4 - (  1486  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى ،  حَدَّثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ صَامَ يَوْمًا فِي  سَبِيلِ  اللهِ مُتَطَوِّعًا فِي غَيْرِ رَمَضَانَ  ، بَعُدَ مِنَ النَّارِ مِائَةَ عَامٍ سَيْرَ  الْمُضَمَّرِ  الْمُجِيدِ  .","","Musnad Abi Ya'la al-Mawsili 1486","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن يحيى بن أيوب الغافقي عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1487","5 - (  1487  ) -  حَدَّثَنَا  الْحَكَمُ بْنُ مُوسَى أَبُو صَالِحٍ ،  حَدَّثَنَا         [3/62]      بَقِيَّةُ ، قَالَ :  حَدَّثَنِي  أَبُو الْحَجَّاجِ الْمَهْرِيُّ ،  حَدَّثَنَا  زَبَّانُ بْنُ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ صَلَّى صَلَاةَ الْفَجْرِ ثُمَّ قَعَدَ يَذْكُرُ اللهَ حَتَّى تَطْلُعَ الشَّمْسُ  ، وَجَبَتْ لَهُ الْجَنَّةُ  .","","Musnad Abi Ya'la al-Mawsili 1487","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن بقية بن الوليد عن الحكم بن موسى بن أبي زهير النسائي عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1488","6 - (  1488  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  حَدَّثَنِي  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  حَدَّثَنِي  أَبُو مَرْحُومٍ عَبْدُ الرَّحِيمِ بْنُ مَيْمُونٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ أَكَلَ طَعَامًا ، فَقَالَ : الْحَمْدُ لِلهِ الَّذِي أَطْعَمَنِي هَذَا وَرَزَقَنِيهِ مِنْ غَيْرِ حَوْلٍ مِنِّي وَلَا قُوَّةٍ  ، غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ ، وَمَنْ لَبِسَ ثَوْبًا فَقَالَ : الْحَمْدُ لِلهِ الَّذِي كَسَانِي هَذَا وَرَزَقَنِيهِ مِنْ غَيْرِ حَوْلٍ مِنِّي وَلَا قُوَّةٍ ، غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ  .         [3/63]","","Musnad Abi Ya'la al-Mawsili 1488","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن عبد الرحيم بن ميمون المعافري عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1489","7 - (  1489  ) -  حَدَّثَنَا  مُحْرِزُ بْنُ عَوْنٍ ،  حَدَّثَنَا  رِشْدِينُ بْنُ سَعْدٍ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذٍ ،  عَنْ  أَبِيهِ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ قَرَأَ أَلْفَ آيَةٍ فِي  سَبِيلِ  اللهِ ، كُتِبَ يَوْمَ الْقِيَامَةِ مَعَ النَّبِيِّينَ  ، وَالصِّدِّيقِينَ ، وَالشُّهَدَاءِ ، وَالصَّالِحِينَ ، وَحَسُنَ أُولَئِكَ رَفِيقًا إِنْ شَاءَ اللهُ  .","","Musnad Abi Ya'la al-Mawsili 1489","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن محرز بن عون الهلالي عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1490","8 - (  1490  ) -  حَدَّثَنَا  مُحْرِزٌ ،  حَدَّثَنَا  رِشْدِينُ بْنُ سَعْدٍ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذٍ ،  عَنْ  أَبِيهِ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ حَرَسَ وَرَاءَ الْمُسْلِمِينَ فِي  سَبِيلِ  اللهِ مُتَطَوِّعًا لَا يَأْخُذُهُ سُلْطَانٌ  لَمْ يَرَ النَّارَ بِعَيْنِهِ إِلَّا  تَحِلَّةَ  الْقَسَمِ ، فَإِنَّ اللهَ سُبْحَانَهُ لَا شَرِيكَ لَهُ يَقُولُ :         {      وَإِنْ مِنْكُمْ إِلا وَارِدُهَا         }      .         [3/64]","","Musnad Abi Ya'la al-Mawsili 1490","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن محرز بن عون الهلالي عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1491","9 - (  1491  ) -  حَدَّثَنَا  مُحْرِزُ بْنُ عَوْنٍ ،  حَدَّثَنَا  رِشْدِينُ بْنُ سَعْدٍ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذٍ ،  عَنْ  أَبِيهِ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ تَخَطَّى النَّاسَ يَوْمَ الْجُمُعَةِ اتَّخَذَ جِسْرًا إِلَى  جَهَنَّمَ  .","","Musnad Abi Ya'la al-Mawsili 1491","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن محرز بن عون الهلالي عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1492","10 - (  1492  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  بِهِ أَبُو عَبْدِ الرَّحْمَنِ ،  حَدَّثَنَا  سَعِيدٌ ،  حَدَّثَنِي  أَبُو مَرْحُومٍ عَبْدُ الرَّحِيمِ بْنُ مَيْمُونٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ الْجُهَنِيِّ ،  عَنْ  أَبِيهِ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ  نَهَى عَنِ  الْحُبْوَةِ  يَوْمَ الْجُمُعَةِ وَالْإِمَامُ يَخْطُبُ  .         [3/65]","","Musnad Abi Ya'la al-Mawsili 1492","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن عبد الرحيم بن ميمون المعافري عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1493","11 - (  1493  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذٍ الْجُهَنِيِّ ،  عَنْ  أَبِيهِ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ قَرَأَ الْقُرْآنَ وَعَمِلَ بِمَا فِيهِ أَلْبَسَ وَالِدَيْهِ تَاجًا يَوْمَ الْقِيَامَةِ  ، ضَوْءُهُ أَحْسَنُ مِنْ ضَوْءِ الشَّمْسِ فِي بُيُوتِ أَهْلِ الدُّنْيَا لَوْ كَانَتْ فِيهِ ، فَمَا ظَنُّكُمْ بِالَّذِي عَمِلَ بِهِمَا . ؟","","Musnad Abi Ya'la al-Mawsili 1493","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن يحيى بن أيوب الغافقي عن عبد الله بن وهب المصري عن الوليد بن شجاع عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1494","12 - (  1494  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنِي  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  :  مَنْ بَرَّ وَالِدَيْهِ ، طُوبَى لَهُ  ، زَادَ اللهُ فِي عُمُرِهِ  .         [3/66]","","Musnad Abi Ya'la al-Mawsili 1494","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن وهب المصري عن الوليد بن شجاع عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1495","13 - (  1495  ) -  حَدَّثَنَا  الْحَكَمُ بْنُ مُوسَى ،  حَدَّثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  حَدَّثَنِي  أَبُو الْحَجَّاجِ الْمَهْرِيُّ ،  حَدَّثَنِي  زَبَّانُ بْنُ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ صَلَّى صَلَاةَ الْفَجْرِ ، ثُمَّ قَعَدَ يَذْكُرُ اللهَ حَتَّى تَطْلُعَ الشَّمْسُ  ، وَجَبَتْ لَهُ الْجَنَّةُ  .","","Musnad Abi Ya'la al-Mawsili 1495","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن بقية بن الوليد عن الحكم بن موسى بن أبي زهير النسائي عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1496","14 - (  1496  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  حَدَّثَنَا  سَعِيدٌ ،  حَدَّثَنِي  أَبُو مَرْحُومٍ عَبْدُ الرَّحِيمِ بْنُ مَيْمُونٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ الْجُهَنِيِّ ،  عَنْ  أَبِيهِ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَنَّهُ  نَهَى عَنِ  الْحُبْوَةِ  يَوْمَ الْجُمُعَةِ وَالْإِمَامُ يَخْطُبُ  .  قَالَ  ابْنُ الدَّوْرَقِيِّ  : قَالَ  أَبُو عَبْدِ الرَّحْمَنِ  : لَيْسَ هُوَ بِالْمَعْرُوفِ عِنْدَ النَّاسِ ، وَلَمْ يَزَلِ النَّاسُ يَحْتَبُونَ  .","","Musnad Abi Ya'la al-Mawsili 1496","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن عبد الرحيم بن ميمون المعافري عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1497","15 - (  1497  ) -  حَدَّثَنَا  أَبُو عَبْدِ اللهِ أَحْمَدُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  حَدَّثَنَا  سَعِيدٌ ،  حَدَّثَنِي  أَبُو مَرْحُومٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ  كَظَمَ  غَيْظًا وَهُوَ قَادِرٌ         [3/67]      عَلَى أَنْ يُنْفِذَهُ  ، دَعَاهُ اللهُ عَلَى رُءُوسِ الْأَشْهَادِ يَوْمَ الْقِيَامَةِ ، فَيُخَيِّرُهُ فِي أَيِّ الْحُورِ شَاءَ  .","","Musnad Abi Ya'la al-Mawsili 1497","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن عبد الرحيم بن ميمون المعافري عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1498","16 - (  1498  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  حَدَّثَنَا  سَعِيدٌ ،  حَدَّثَنِي  أَبُو مَرْحُومٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ أَكَلَ طَعَامًا ثُمَّ قَالَ : الْحَمْدُ لِلهِ الَّذِي أَطْعَمَنِي هَذَا الطَّعَامَ وَرَزَقَنِيهِ مِنْ غَيْرِ حَوْلٍ مِنِّي وَلَا قُوَّةٍ  ، غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ ، وَمَنْ لَبِسَ ثَوْبًا ، قَالَ : الْحَمْدُ لِلهِ الَّذِي كَسَانِي هَذَا وَرَزَقَنِيهِ مِنْ غَيْرِ حَوْلٍ مِنِّي وَلَا قُوَّةٍ ، غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ  .         [3/68]","","Musnad Abi Ya'la al-Mawsili 1498","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن عبد الرحيم بن ميمون المعافري عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1499","17 - (  1499  ) -  حَدَّثَنَا  أَبُو عَبْدِ اللهِ الدَّوْرَقِيُّ ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  حَدَّثَنَا  سَعِيدٌ ،  حَدَّثَنِي  أَبُو مَرْحُومٍ عَبْدُ الرَّحِيمِ بْنُ مَيْمُونٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ الْجُهَنِيِّ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ تَرَكَ اللِّبَاسَ وَهُوَ يَقْدِرُ عَلَيْهِ تَوَاضُعًا لِلهِ  ، دَعَاهُ اللهُ يَوْمَ الْقِيَامَةِ عَلَى رُءُوسِ الْخَلَائِقِ حَتَّى يُخَيِّرَهُ مِنْ حُلَلِ الْإِيمَانِ يَلْبَسُ مِنْ أَيِّهَا شَاءَ  .","","Musnad Abi Ya'la al-Mawsili 1499","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن عبد الرحيم بن ميمون المعافري عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1500","18 - (  1500  ) -  حَدَّثَنَا  أَبُو عَبْدِ اللهِ ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  حَدَّثَنَا  سَعِيدٌ ،  حَدَّثَنِي  أَبُو مَرْحُومٍ عَبْدُ الرَّحِيمِ بْنُ مَيْمُونٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ الْجُهَنِيِّ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَعْطَى لِلهِ ، وَمَنَعَ لِلهِ  ، وَأَحَبَّ لِلهِ ، وَأَبْغَضَ لِلهِ ، وَأَنْكَحَ لِلهِ ، فَقَدِ اسْتَكْمَلَ إِيمَانَهُ  .","","Musnad Abi Ya'la al-Mawsili 1500","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن عبد الرحيم بن ميمون المعافري عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند معاذ بن أنس"
"1501","[3/69]      مُسْنَدُ  عَرْفَجَةَ بْنِ أَسْعَدَ  1 - (  1501  ) -  حَدَّثَنَا  حَوْثَرَةُ بْنُ أَشْرَسَ أَبُو عَامِرٍ ،  أَخْبَرَنِي  أَبُو الْأَشْهَبِ جَعْفَرُ بْنُ حَيَّانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ طَرَفَةَ بْنِ عَرْفَجَةَ بْنِ أَسْعَدَ بْنِ مِنْقَرٍ ، قَالَ  أَبُو عَامِرٍ  : هَؤُلَاءِ أَخْوَالُ  بَنِي سَعْدٍ  ،  أَنَّ جَدَّهُ عَرْفَجَةَ أُصِيبَ أَنْفُهُ فِي الْجَاهِلِيَّةِ  يَوْمَ  الْكُلَابِ  ، فَاتَّخَذَ أَنْفًا مِنْ  وَرِقٍ  ، فَأَنْتَنَ عَلَيْهِ ، فَذَكَرَ ذَلِكَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَأَمَرَهُ أَنْ يَتَّخِذَ أَنْفًا مِنْ ذَهَبٍ  .         [3/70]      قَالَ  أَبُو عَامِرٍ حَوْثَرَةُ  :  وَزَعَمَ  عَبْدُ الرَّحْمَنِ  أَنَّهُ قَدْ رَأَى أَنْفَ جَدِّهِ  .","","Musnad Abi Ya'la al-Mawsili 1501","","عرفجة بن أسعد بن كريب العطاردي عن عبد الرحمن بن طرفة العطاردي عن جعفر بن حيان العطاردي عن حوثرة بن أشرس بن عومر العدوي عن أبو يعلى الموصلي","مسند عرفجة بن أسعد"
"1502","2 - (  1502  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  أَبُو الْأَشْهَبِ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ طَرَفَةَ بْنِ عَرْفَجَةَ ، وَزَعَمَ أَنَّهُ رَأَى  عَرْفَجَةَ  جَدَّهُ ، قَالَ :         [3/71]      أُصِيبَ أَنْفُ عَرْفَجَةَ  يَوْمَ  الْكُلَابِ  ، فَاتَّخَذَ أَنْفًا مِنْ  وَرِقٍ  ، فَأَنْتَنَ عَلَيْهِ ، فَأَمَرَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَتَّخِذَ أَنْفًا مِنْ ذَهَبٍ  .","","Musnad Abi Ya'la al-Mawsili 1502","","عرفجة بن أسعد بن كريب العطاردي عن عبد الرحمن بن طرفة العطاردي عن جعفر بن حيان العطاردي عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عرفجة بن أسعد"
"1503","[3/72]      مُسْنَدُ  أَبِي الْعُشَرَاءِ الدَّارِمِيُّ  1 - (  1503  ) -  حَدَّثَنَا  عَلِيُّ بْنُ الْجَعْدِ ، وَهُدْبَةُ بْنُ خَالِدٍ ، وَعَبْدُ الْأَعْلَى النَّرْسِيُّ ، وَحَوْثَرَةُ بْنُ أَشْرَسَ ، وَإِبْرَاهِيمُ بْنُ الْحَجَّاجِ ، قَالُوا :  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي الْعُشَرَاءِ ،  عَنْ  أَبِيهِ  ، قَالَ : قُلْتُ :  يَا رَسُولَ اللهِ ، أَمَا تَكُونُ الذَّكَاةُ إِلَّا مِنَ  اللَّبَّةِ  أَوِ الْحَلْقِ ؟  قَالَ : لَوْ طَعَنْتَ فِي فَخِذِهَا لَأَجْزَأَ عَنْكَ .         [3/73]      2 - (  1504  ) - زَادَ  حَوْثَرَةُ  : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : وَالَّذِي نَفْسِي بِيَدِهِ ، لَوْ طَعَنْتَ فِي فَخِذِهَا لَأَجْزَأَ عَنْكَ  .","","Musnad Abi Ya'la al-Mawsili 1503","","مالك بن قهطم الدارمي عن أبو العشراء الدارمي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند أبي العشراء الدارمي"
"1504","[3/74]      مُسْنَدُ  عِتْبَانَ  1 - (  1505  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  حَدَّثَنَا  ثَابِتٌ ،  عَنْ  أَنَسٍ ،  حَدَّثَنِي  مَحْمُودُ بْنُ الرَّبِيعِ ،  عَنْ  عِتْبَانَ بْنِ مَالِكٍ ، قَالَ :  قَدِمْتُ  الْمَدِينَةَ  فَلَقِيتُ عِتْبَانَ بْنَ مَالِكٍ فَقُلْتُ : حَدِيثٌ بَلَغَنِي عَنْكَ ،  قَالَ  : أَصَابَنِي فِي بَصَرِي شَيْءٌ ، فَبَعَثْتُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنِّي أُحِبُّ أَنْ تَأْتِيَنِي ، فَتُصَلِّيَ فِي مَنْزِلِي ، فَأَتَّخِذُهُ مُصَلًّى ، قَالَ : فَأَتَانِي النَّبِيُّ فِيمَنْ شَاءَ اللهُ مِنْ أَصْحَابِهِ ، فَدَخَلَ عَلَيَّ ، فَهُوَ يُصَلِّي فِي مَنْزِلِي ، وَأَصْحَابُهُ يَتَحَدَّثُونَ بَيْنَهُمْ ، ثُمَّ أَسْنَدُوا  عُظْمَ  ذَلِكَ وَكُبْرَهُ إِلَى  مَالِكِ بْنِ دُخْشُمٍ  ، قَالَ : وَدُّوا أَنَّهُ دَعَا عَلَيْهِ فَهَلَكَ ، وَدُّوا أَنَّهُ أَصَابَهُ سَقَمٌ ، فَقَضَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الصَّلَاةَ ، فَقَالَ : أَلَيْسَ يَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنِّي رَسُولُ اللهِ ؟ قَالُوا : إِنَّهُ يَقُولُ ذَلِكَ ، وَمَا هُوَ فِي قَلْبِهِ ، قَالَ :  لَا يَشْهَدُ أَحَدٌ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنِّي رَسُولُ اللهِ  فَيَدْخُلَ النَّارَ أَوْ         [3/75]      تَطْعَمَهُ النَّارُ  ، قَالَ : فَأَعْجَبَنِي هَذَا الْحَدِيثُ ، فَقُلْتُ لِابْنِي : اكْتُبْهُ ، فَكَتَبَهُ  .","","Musnad Abi Ya'la al-Mawsili 1505","","عتبان بن مالك البدري عن محمود بن الربيع بن سراقة الخزرجي عن أنس بن مالك عن ثابت البناني عن سليمان بن المغيرة القيسي عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عتبان"
"1505","2 - (  1506  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  هَاشِمُ بْنُ الْقَاسِمِ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ ،         [3/76]      عَنْ  عِتْبَانَ بْنِ مَالِكٍ ، نَحْوًا مِنْهُ وَزَادَ فِيهِ :  وَأَصْحَابُهُ يَتَحَدَّثُونَ بَيْنَهُمْ ، وَيَذْكُرُونَ مَا يَلْقَوْنَ مِنَ الْمُنَافِقِينَ ، ثُمَّ أَسْنَدُوا  عُظْمَ  ذَلِكَ إِلَى  مَالِكِ بْنِ دُخْشُمٍ  ، قَالَ :  وَدُّوا أَنَّهُ دَعَا عَلَيْهِ ، يَحْمِلُونَهُ عَلَيْهِ  ، فَقَضَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - ، فَذَكَرَ نَحْوًا مِنْهُ  .","","Musnad Abi Ya'la al-Mawsili 1506","","عتبان بن مالك البدري عن أنس بن مالك عن ثابت البناني عن سليمان بن المغيرة القيسي عن هاشم بن القاسم بن مسلم عن زهير بن حرب عن أبو يعلى الموصلي","مسند عتبان"
"1506","3 - (  1507  ) -  حَدَّثَنَا  أَبُو حَمْزَةَ هُرَيْمُ بْنُ عَبْدِ الْأَعْلَى ،  حَدَّثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  سُلَيْمَانَ بْنِ الْمُغِيرَةِ ،  حَدَّثَنَا  ثَابِتٌ ،  عَنْ  أَنَسٍ ،  عَنْ  مَحْمُودِ بْنِ الرَّبِيعِ ،  عَنْ  عِتْبَانَ بْنِ مَالِكٍ ، قَالَ :  لَقِيتُ عِتْبَانَ بَعْدَ ذَلِكَ ،  فَحَدَّثَنِي  بِحَدِيثٍ أَعْجَبَنِي ، فَقُلْتُ لِابْنِي : اكْتُبْهُ ، فَكَتَبَهُ ، قَالَ : وَقَدْ كَانَ ذَهَبَ بَصَرُهُ ، قَالَ : قُلْتُ : يَا نَبِيَّ اللهِ ، لَوْ أَتَيْتَنِي ، فَصَلَّيْتَ عِنْدِي فِي مَكَانٍ أَتَّخِذُهُ مَسْجِدًا ؟ قَالَ : فَجَاءَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَعَلَ يُصَلِّي ، وَجَعَلَ أَصْحَابُهُ يَتَحَدَّثُونَ ، قَالَ : فَذَكَرُوا مَا يَلْقَوْنَ مِنَ الْمُنَافِقِينَ مِنَ الْأَذَى ، فَحَمَلُوا  عُظْمَ  ذَلِكَ عَلَى  مَالِكِ بْنِ الدُّخْشُمِ  ، فَكَانَ يُعْجِبُهُمْ أَنْ يَحْمِلُوا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَيَدْعُو عَلَيْهِ فَيَهْلِكَ ، فَقَالُوا : يَا نَبِيَّ اللهِ ، إِنَّ مِنْ         [3/77]      أَمْرِهِ كَذَا وَكَذَا ، قَالَ : فَقَالَ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَلَيْسَ يَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ؟ قَالُوا : إِنَّمَا يَقُولُ ذَلِكَ بِلِسَانِهِ ، وَلَيْسَ لَهُ حَقِيقَةٌ فِي قَلْبِهِ ، قَالَ : فَقَالَ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَشْهَدُ أَحَدٌ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنِّي رَسُولُ اللهِ  فَيُدْخِلَهُ اللهُ النَّارَ أَوْ قَالَ : فَتَطْعَمَهُ النَّارُ أَبَدًا  .  قَالَ  الْمُعْتَمِرُ  : إِنِّي سَمِعْتُهُ مِنْ  أَنَسٍ  وَمَا حَدَّثَ بِهِ أَحَدًا .","","Musnad Abi Ya'la al-Mawsili 1507","","عتبان بن مالك البدري عن محمود بن الربيع بن سراقة الخزرجي عن أنس بن مالك عن ثابت البناني عن سليمان بن المغيرة القيسي عن معتمر بن سليمان عن هريم بن عبد الأعلى الأسدي عن أبو يعلى الموصلي","مسند عتبان"
"1507","[3/78]      مُسْنَدُ  عَمْرِو بْنِ خَارِجَةَ  1 - (  1508  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ ،  عَنْ  عَمْرِو بْنِ خَارِجَةَ ، قَالَ :  خَطَبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ عَلَى نَاقَةٍ ، وَأَنَا تَحْتَ  جِرَانِهَا  ، وَهِيَ تَقْصَعُ بِجِرَّةٍ ، وَلُعَابُهَا يَسِيلُ بَيْنَ كَتِفَيَّ ، فَقَالَ :  يَا أَيُّهَا النَّاسُ ، إِنَّ اللهَ أَعْطَى كُلَّ ذِي  حَقٍّ  حَقَّهُ  ، فَلَا وَصِيَّةَ لِوَارِثٍ ، وَالْوَلَدُ  لِلْفِرَاشِ ،  وَلِلْعَاهِرِ  الْحَجَرُ ،  وَمَنِ  ادَّعَى  إِلَى غَيْرِ أَبِيهِ ، أَوِ  انْتَمَى  إِلَى غَيْرِ مَوَالِيهِ رَغْبَةً عَنْهُمْ فَعَلَيْهِ لَعْنَةُ اللهِ ، وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ ، لَا يَقْبَلُ اللهُ مِنْهُ  صَرْفًا  وَلَا  عَدْلًا  .","","Musnad Abi Ya'la al-Mawsili 1508","","عمرو بن خارجة بن المنتفق الأسدي عن عبد الرحمن بن غنم الأشعري عن شهر بن حوشب عن قتادة بن دعامة عن الوضاح بن عبد الله اليشكري عن خلف بن هشام البزار عن أبو يعلى الموصلي","مسند عمرو بن خارجة"
"1508","[3/79]      مُسْنَدُ  عُمَارَةَ بْنِ أَوْسٍ  1 - (  1509  ) -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ ،  حَدَّثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  عُمَارَةَ بْنِ أَوْسٍ ،  وَقَدْ كَانَ صَلَّى الْقِبْلَتَيْنِ جَمِيعًا ، قَالَ : إِنِّي لَفِي مَنْزِلِي إِذَا مُنَادٍ يُنَادِي عَلَى الْبَابِ :  إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ حَوَّلَ الْقِبْلَةَ  ، فَأَشْهَدُ عَلَى إِمَامِنَا ، وَالرِّجَالِ ، وَالنِّسَاءِ ، وَالصِّبْيَانِ لَقَدْ صَلَّوْا إِلَى هَاهُنَا -  يَعْنِي  بَيْتَ الْمَقْدِسِ  - وَإِلَى هَاهُنَا ،  يَعْنِي  الْكَعْبَةَ  .","","Musnad Abi Ya'la al-Mawsili 1509","","عمارة بن أوس الخطمي عن زياد بن علاقة الثعلبي عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن أبو يعلى الموصلي","مسند عمارة بن أوس"
"1509","[3/80]      مُسْنَدُ  سَعْدِ بْنِ الْأَطْوَلِ  1 - (  1510  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَخْبَرَنَا  عَبْدُ الْمَلِكِ أَبُو جَعْفَرٍ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  سَعْدِ بْنِ الْأَطْوَلِ ،  أَنَّ رَجُلًا مَاتَ وَتَرَكَ ثَلَاثَمِائَةِ دِرْهَمٍ وَعِيَالًا  ، قَالَ : فَأَرَدْتُ أَنْ أُنْفِقَهَا عَلَى عِيَالِهِ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنَّ أَخَاكَ مَحْبُوسٌ بِدَيْنِهِ ، فَاقْضِ عَنْهُ ، فَقَضَى عَنْهُ ، فَقَالَ : يَا رَسُولَ اللهِ ، قَدْ قَضَيْتُ عَنْهُ إِلَّا امْرَأَةً ادَّعَتْ دِينَارَيْنِ ، وَلَيْسَ لَهَا بَيِّنَةٌ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَعْطِهَا فَإِنَّهَا صَادِقَةٌ  .         [3/81]","","Musnad Abi Ya'la al-Mawsili 1510","","سعد بن الأطول القحطانى عن المنذر بن مالك العوقي عن عبد الملك البصري عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند سعد بن الأطول"
"1510","2 - (  1511  ) -  حَدَّثَنَا  ابْنُ عَبْدِ اللهِ بْنُ بَدْرِ بْنِ وَاصِلِ بْنِ عَبْدِ اللهِ بْنِ سَعْدِ بْنِ الْأَطْوَلِ ، قَالَ :  حَدَّثَنِي  أَبِي عَبْدُ اللهِ بْنُ بَدْرِ بْنِ وَاصِلِ بْنِ عَبْدِ اللهِ بْنِ سَعْدِ بْنِ الْأَطْوَلِ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ سَعْدِ بْنِ الْأَطْوَلِ ،  قَالَ :  كَانَ  عَبْدُ اللهِ بْنُ سَعْدٍ  يَخْرُجُ إِلَى أَصْحَابِهِ  بِتُسْتَرَ  يَزُورُهُمْ ، فَيُقِيمُ يَوْمَ دُخُولِهِ ، وَالثَّانِي ، وَيَخْرُجُ فِي الثَّالِثِ ، فَيَقُولُونَ لَهُ : لَوْ أَقَمْتَ ، فَيَقُولُ :  سَمِعْتُ  أَبِي ، يَقُولُ :  نَهَانِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، أَوْ سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  يَنْهَى عَنِ التِّنَاءَةِ  ، فَمَنْ أَقَامَ بِبَلَدِ الْخَرَاجِ فَقَدْ  تَنَأَ  ، فَأَنَا أَكْرَهُ أَنْ أُقِيمَ  .         [3/82]","","Musnad Abi Ya'la al-Mawsili 1511","","سعد بن الأطول القحطانى عن عبد الله بن سعد بن الأطول عن عبد الله بن بدر بن واصل الجهني عن واصل بن عبد الله الجهني عن أبو يعلى الموصلي","مسند سعد بن الأطول"
"1511","3 - (  1512  ) -  حَدَّثَنَا  ابْنُ عَبْدِ اللهِ بْنُ بَدْرٍ ،  حَدَّثَنِي  عَبَّادُ بْنُ مُوسَى الْقُرَشِيُّ ،  عَنْ  حَمَّادِ بْنِ سَلَمَةَ ،  عَنْ  عَبْدِ الْمَلِكِ أَبِي جَعْفَرٍ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  سَعْدِ بْنِ الْأَطْوَلِ ،  أَنَّ أَبَاهُ مَاتَ ، وَتَرَكَ ثَلَاثَمِائَةِ دِرْهَمٍ وَعِيَالًا ، وَدَيْنًا ، فَأَرَدْتُ أَنْ أُنْفِقَ عَلَى عِيَالِهِ ، فَقَالَ لِيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ أَبَاكَ مَحْبُوسٌ بِدَيْنِهِ  ، فَاقْضِ عَنْهُ ، قُلْتُ : بِأَبِي أَنْتَ وَأُمِّي يَا رَسُولَ اللهِ ، قَدْ قَضَيْتُ عَنْهُ مَا خَلَا امْرَأَةً ادَّعَتْ دِينَارَيْنِ ، وَلَيْسَ لَهَا بَيِّنَةٌ ، قَالَ : أَعْطِهَا فَإِنَّهَا صَادِقَةٌ ، فَأَعْطَيْتُهَا  .","","Musnad Abi Ya'la al-Mawsili 1512","","سعد بن الأطول القحطانى عن المنذر بن مالك العوقي عن عبد الملك البصري عن حماد بن سلمة عن عباد بن موسى العباداني عن واصل بن عبد الله الجهني عن أبو يعلى الموصلي","مسند سعد بن الأطول"
"1512","4 - (  1513  ) -  حَدَّثَنَا  ابْنُ عَبْدِ اللهِ ،  حَدَّثَنِي  عَبَّادُ بْنُ مُوسَى ،  عَنْ  حَمَّادِ بْنِ سَلَمَةَ ،  عَنْ  سَعِيدٍ الْجُرَيْرِيِّ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمِثْلِهِ .","","Musnad Abi Ya'la al-Mawsili 1513","","أحد الصحابة عن المنذر بن مالك العوقي عن سعيد بن إياس الجريري عن حماد بن سلمة عن عباد بن موسى العباداني عن واصل بن عبد الله الجهني عن أبو يعلى الموصلي","مسند سعد بن الأطول"
"1513","[3/83]      أَبُو مَرْثَدٍ الْغَنَوِيُّ  1 - (  1514  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ بْنِ جَابِرٍ ، قَالَ :  سَمِعْتُ  بُسْرَ بْنَ عُبَيْدِ اللهِ ، وَقَالَ مَرَّةً ،  عَنْ  بُسْرِ بْنِ عُبَيْدِ اللهِ  ،  عَنْ  أَبِي إِدْرِيسَ الْخَوْلَانِيِّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ ،  عَنْ  أَبِي مَرْثَدٍ الْغَنَوِيِّ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَجْلِسُوا عَلَى الْقُبُورِ وَلَا تُصَلُّوا إِلَيْهَا  .","","Musnad Abi Ya'la al-Mawsili 1514","","كناز بن الحصين الغنوي عن واثلة بن الأسقع الليثي عن عائذ الله بن عبد الله الخولاني عن بسر بن عبيد الله الحضرمي عن عبد الرحمن بن يزيد الداراني عن عبد الله بن المبارك عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","أبو مرثد الغنوي"
"1514","[3/84]      عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ الْأَنْصَارِيُّ  1 - (  1515  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  فَضَالَةُ بْنُ حُصَيْنٍ الْعَطَّارُ ، قَالَ :  سَمِعْتُ  الْخَطَّابَ بْنَ سَعِيدٍ ،  عَنْ  سُلَيْمَانَ بْنِ مُحَمَّدِ بْنِ إِبْرَاهِيمَ الْأَنْصَارِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ الْأَنْصَارِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الرَّاسِخَاتُ فِي الْوَحْلِ ، الْمُطْعِمَاتُ فِي  الْمَحْلِ  ، مَنْ بَاعَهَا فَإِنَّ ثَمَنَهَا بِمَنْزِلَةِ الرَّمَادِ عَلَى شَاهِقَةٍ هَبَّتْ لَهُ رِيحٌ فَقَذَفَتْهُ  .","","Musnad Abi Ya'la al-Mawsili 1515","","عبد الله بن عبد الرحمن الأنصاري عن سليمان بن محمد بن إبراهيم الأنصاري عن الخطاب بن سعيد عن فضالة بن حصين الضبي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","عبد الله بن عبد الرحمن الأنصاري"
"1515","2 - (  1516  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  حَدَّثَنَا  الْحَسَنُ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، قَالَ :  قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         [3/85]      يَا  عَبْدَ الرَّحْمَنِ  ، لَا تَسْأَلِ الْإِمَارَةَ  .","","Musnad Abi Ya'la al-Mawsili 1516","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن جرير بن حازم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","عبد الله بن عبد الرحمن الأنصاري"
"1516","[3/86]      الْمِقْدَادُ بْنُ عَمْرٍو الْكِنْدِيُّ  1 - (  1517  ) -  حَدَّثَنَا  هُدْبَةُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  الْمِقْدَادِ بْنِ عَمْرٍو الْكِنْدِيِّ ، قَالَ :  قَدِمْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَعِي رَجُلَانِ مِنْ أَصْحَابِي ، فَطَلَبْنَا هَلْ يُضِيفُنَا أَحَدٌ ؟ فَلَمْ يُضِفْنَا أَحَدٌ ، فَأَتَيْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقُلْنَا : يَا رَسُولَ اللهِ ، أَصَابَنَا جُوعٌ  وَجَهْدٌ  ، وَإِنَّا تَعَرَّضْنَا هَلْ يُضِيفُنَا أَحَدٌ ؟ فَلَمْ يُضِفْنَا أَحَدٌ ، فَدَفَعَ إِلَيْنَا أَرْبَعَةَ أَعْنُزٍ ، فَقَالَ :  يَا  مِقْدَادُ  ، خُذْ هَذِهِ فَاحْتَلِبْهَا  ، فَجَزِّئْهَا أَرْبَعَةَ أَجْزَاءٍ : جُزْءًا لِي ، وَجُزْءًا لَكَ ، وَجُزْءًا لِصَاحِبَيْكَ ، فَكُنْتُ أَفْعَلُ ذَلِكَ ، فَلَمَّا كَانَ ذَاتَ لَيْلَةٍ شَرِبْتُ جُزْئِي ، وَشَرِبَ صَاحِبَايَ جُزْأَيْهِمَا ،         [3/87]      وَجَعَلْتُ جُزْءَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْقَعْبِ ، وَأَطْبَقْتُ عَلَيْهِ ، فَاحْتُبِسَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَتْ لِي نَفْسِي : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ دَعَاهُ أَهْلُ بَيْتٍ مِنَ  الْمَدِينَةِ  ، فَتَعَشَّى مَعَهُمْ ، وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَا يَحْتَاجُ إِلَى هَذَا اللَّبَنِ ، فَلَمْ تَزَلْ نَفْسِي تُدِيرُنِي حَتَّى قُمْتُ إِلَى الْقَعْبِ ، فَشَرِبْتُ مَا فِيهِ ، فَلَمَّا تَقَارَّ فِي بَطْنِي أَخَذَنِي مَا  قَدُمَ  ، وَمَا حَدَثَ ، فَقَالَتْ لِي نَفْسِي : يَجِيءُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ جَائِعٌ ظَمْآنُ ، فَيَرْفَعُ الْقَعْبَ ، فَلَا يَجِدُ فِيهِ شَيْئًا ، فَيَدْعُو عَلَيْكَ ، فَتَسَجَّيْتُ كَأَنِّي نَائِمٌ ، وَمَا كَانَ بِي نَوْمٌ ، فَجَاءَ رَسُولُ اللهِ ، فَسَلَّمَ تَسْلِيمَةً أَسْمَعَ الْيَقْظَانَ ، وَلَمْ يُوقِظِ النَّائِمَ ، فَلَمَّا لَمْ يَرَ فِي الْقَعْبِ شَيْئًا رَفَعَ رَأْسَهُ إِلَى السَّمَاءِ ، فَقَالَ : اللَّهُمَّ أَطْعِمْ مَنْ أَطْعَمَنَا وَاسْقِ مَنْ سَقَانَا ، قَالَ : فَاغْتَنَمْتُ دَعْوَةَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَأَخَذْتُ الشَّفْرَةَ وَأَنَا أُرِيدُ أَنْ أَذْبَحَ بَعْضَ تِلْكَ الْأَعْنُزِ ، فَأُطْعِمَهُ ، فَضَرَبْتُ بِيَدِي ، فَوَقَعَتْ عَلَى ضَرْعِهَا ، فَإِذَا هِيَ  حَافِلٌ  ، ثُمَّ نَظَرْتُ إِلَيْهِنَّ جَمِيعًا ، فَإِذَا هُنَّ حُفَّلٌ ، فَحَلَبْتُ فِي الْقَعْبِ ، حَتَّى امْتَلَأَ ، ثُمَّ أَتَيْتُهُ وَأَنَا أَبْتَسِمُ ، فَقَالَ : هِيهِ بَعْضَ سَوْآتِكَ يَا  مِقْدَادُ  ، فَقُلْتُ : يَا رَسُولَ اللهِ ، اشْرَبْ ، ثُمَّ أُخْبِرُ ، فَشَرِبَ ، ثُمَّ شَرِبْتُ مَا بَقِيَ ، ثُمَّ أَخْبَرْتُهُ ، فَقَالَ : يَا  مِقْدَادُ  ، هَذِهِ بَرَكَةٌ كَانَ يَنْبَغِي لَكَ أَنْ تُعْلِمَنِي حَتَّى نُوقِظَ صَاحِبَيْنَا ، فَنَسْقِيَهُمَا مِنْ هَذِهِ الْبَرَكَةِ ، قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، إِذَا شَرِبْتَ أَنْتَ الْبَرَكَةَ وَأَنَا فَمَا  أُبَالِي  مَنْ أَخْطَأَتْ  .","","Musnad Abi Ya'la al-Mawsili 1517","","المقداد بن عمرو بن ثعلبة البهراني عن عبد الرحمن بن أبي ليلى عن ثابت البناني عن حماد بن سلمة عن هدبة بن خالد عن أبو يعلى الموصلي","المقداد بن عمرو الكندي"
"1517","[3/88]      عَبْدُ الرَّحْمَنِ بْنُ شِبْلٍ الْأَنْصَارِيُّ  1 - (  1518  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  أَبَانُ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  حَدَّثَنِي  زَيْدٌ ،  عَنْ  أَبِي سَلَّامٍ ،  عَنِ  الْحُبْرَانِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ شِبْلٍ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  اقْرَءُوا الْقُرْآنَ ، وَلَا تَغْلُوا فِيهِ  ، وَلَا  تَجْفُوا  عَنْهُ ، وَلَا تَأْكُلُوا بِهِ ، وَلَا تَسْتَكْثِرُوا بِهِ  .","","Musnad Abi Ya'la al-Mawsili 1518","","عبد الرحمن بن شبل الأوسي عن أخضر الحبراني عن ممطور الحبشي عن زيد بن سلام الحبشي عن يحيى بن أبي كثير عن أبان بن يزيد العطار عن هدبة بن خالد عن أبو يعلى الموصلي","عبد الرحمن بن شبل الأنصاري"
"1518","[3/89]      مُسْنَدُ  جُنْدُبِ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ  1 - (  1519  ) -  حَدَّثَنَا  خَلَفُ بْنُ الْبَزَّازِ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَبِي عِمْرَانَ ،  عَنْ  جُنْدُبِ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ ، وَلَا أَعْلَمُهُ إِلَّا  رَفَعَهُ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  اقْرَءُوا الْقُرْآنَ مَا ائْتَلَفَتْ عَلَيْهِ قُلُوبُكُمْ  ، فَإِذَا اخْتَلَفْتُمْ فِيهِ ، فَقُومُوا عَنْهُ .         [3/90]      قَالَ : وَكُنْتُ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غُلَامًا  حَزَوَّرًا  .","","Musnad Abi Ya'la al-Mawsili 1519","","جندب بن عبد الله البجلي عن عبد الملك بن حبيب الجوني عن حماد بن زيد عن خلف بن هشام البزار عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1519","2 - (  1520  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ الْكِنْدِيُّ ،  حَدَّثَنَا  سُهَيْلٌ ، أَخُو حَزْمٍ ،  عَنْ  أَبِي عِمْرَانَ ،  عَنْ  جُنْدُبٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ قَالَ فِي الْقُرْآنِ بِرَأْيِهِ ، فَأَصَابَ ، فَقَدْ أَخْطَأَ  .","","Musnad Abi Ya'la al-Mawsili 1520","","جندب بن عبد الله البجلي عن عبد الملك بن حبيب الجوني عن سهيل بن أبي حزم القطعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1520","3 - (  1521  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  حُمَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  جُنْدُبٍ ، وَغَيْرِهِ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  احْتَجَّ  آدَمُ  ،         [3/91]      وَمُوسَى  ، فَقَالَ  مُوسَى  : أَنْتَ  آدَمُ  الَّذِي خَلَقَكَ اللهُ بِيَدِهِ وَأَسْجَدَ لَكَ مَلَائِكَتَهُ ، وَأَسْكَنَكَ جَنَّتَهُ ، فَأَخْرَجْتَ النَّاسَ مِنَ الْجَنَّةِ ؟ فَقَالَ  آدَمُ  : أَنْتَ  مُوسَى  الَّذِي كَلَّمَكَ اللهُ  نَجِيًّا  ، وَآتَاكَ التَّوْرَاةَ ، تَلُومُنِي عَلَى أَمْرٍ قَدْ كُتِبَ عَلَيَّ قَبْلَ أَنْ يَخْلُقَنِي ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : فَحَجَّ  آدَمُ  مُوسَى  ، فَحَجَّ  آدَمُ  مُوسَى  .","","Musnad Abi Ya'la al-Mawsili 1521","","أحد الصحابة عن الحسن البصري عن حميد الطويل عن حماد بن سلمة عن عبد الواحد بن غياث عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1521","4 - (  1522  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  حَدَّثَنِي  عَبْدُ الْحَمِيدِ بْنُ بَهْرَامَ ،  حَدَّثَنَا  شَهْرُ بْنُ حَوْشَبٍ ،  حَدَّثَنِي  جُنْدُبُ بْنُ سُفْيَانَ ، رَجُلٌ مِنْ  بَجِيلَةَ  قَالَ :  إِنِّي عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذْ جَاءَهُ  بَشِيرٌ  مِنْ سَرِيَّةٍ بَعَثَهَا  ، فَأَخْبَرَهُ بِنَصْرِ اللهِ الَّذِي نَصَرَ سَرِيَّتَهُ ، وَبِفَتْحِ اللهِ الَّذِي فَتَحَ لَهُمْ ، قَالَ : يَا رَسُولَ اللهِ ، بَيْنَمَا نَحْنُ بِطَلَبِ الْعَدُوِّ وَقَدْ هَزَمَهُمُ اللهُ ، إِذْ لَحِقْتُ رَجُلًا بِالسَّيْفِ ، فَلَمَّا  أَحَسَّ  أَنَّ السَّيْفَ قَدْ وَاقَعَهُ ، الْتَفَتَ وَهُوَ يَسْعَى ، فَقَالَ : إِنِّي مُسْلِمٌ ، إِنِّي مُسْلِمٌ ، فَقَتَلْتُهُ ، وَإِنَّمَا كَانَ يَا نَبِيَّ اللهِ مُتَعَوِّذًا .         [3/92]      قَالَ : فَهَلَّا شَقَقْتَ عَنْ قَلْبِهِ ، فَنَظَرْتَ صَادِقٌ هُوَ أَوْ كَاذِبٌ ؟ قَالَ : لَوْ شَقَقْتُ عَنْ قَلْبِهِ مَا كَانَ يُعْلِمُنِي الْقَلْبُ ، هَلْ قَلْبُهُ إِلَّا مُضْغَةٌ مِنْ لَحْمٍ ؟ قَالَ : فَأَنْتَ قَتَلْتَهُ ، لَا مَا فِي قَلْبِهِ عَلِمْتَ ، وَلَا لِسَانَهُ صَدَّقْتَ ، قَالَ : يَا رَسُولَ اللهِ ، اسْتَغْفِرْ لِي ، قَالَ : لَا أَسْتَغْفِرُ لَكَ ، فَدَفَنُوهُ ، فَأَصْبَحَ عَلَى وَجْهِ الْأَرْضِ ثَلَاثَ مَرَّاتٍ ، فَلَمَّا رَأَى ذَلِكَ قَوْمُهُ اسْتَحْيَوْا وَخَزَوْا مِمَّا لَقِيَ ، فَحَمَلُوهُ فَأَلْقَوْهُ فِي شِعْبٍ مِنْ تِلْكِ الشِّعَابِ  .","","Musnad Abi Ya'la al-Mawsili 1522","","جندب بن عبد الله البجلي عن شهر بن حوشب عن عبد الحميد بن بهرام الفزاري عن عبد الرحمن بن مهدي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1522","5 - (  1523  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  حَدَّثَنَا  عَبْدُ الْحَمِيدِ بْنُ بَهْرَامَ ،  حَدَّثَنَا  شَهْرُ بْنُ حَوْشَبٍ ،  حَدَّثَنِي  جُنْدُبُ بْنُ سُفْيَانَ ، رَجُلٌ مِنْ  بَجِيلَةَ  ، قَالَ :  إِنِّي لَعِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ جَاءَهُ  بَشِيرٌ  مِنْ سَرِيَّةٍ بَعَثَهَا ، فَأَخْبَرَهُ بِنَصْرِ اللهِ الَّذِي نَصَرَ سَرِيَّتَهُ ، وَبِفَتْحِ اللهِ الَّذِي فَتَحَ لَهُمْ ، فَذَكَرَ نَحْوَهُ ، وَزَادَ فِيهِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، عِنْدَ ذَلِكَ :  سَتَكُونُ         [3/93]      بَعْدِي فِتَنٌ  كَقِطَعِ  اللَّيْلِ الْمُظْلِمِ  ، تَصْدِمُ كَصَدْمِ الْحَيَّاتِ ، وَفُحُولِ الثِّيرَانِ ، يُصْبِحُ الرَّجُلُ فِيهَا مُسْلِمًا ، وَيُمْسِي كَافِرًا ، وَيُمْسِي فِيهَا مُسْلِمًا ، وَيُصْبِحُ كَافِرًا ، فَقَالَ  رَجُلٌ مِنَ الْمُسْلِمِينَ  : فَكَيْفَ نَصْنَعُ عِنْدَ ذَلِكَ يَا رَسُولَ اللهِ ؟ قَالَ : ادْخُلُوا بُيُوتَكُمْ وَأَخْمِلُوا ذِكْرَكُمْ ، فَقَالَ  رَجُلٌ مِنَ الْمُسْلِمِينَ  : أَفَرَأَيْتَ إِنْ دَخَلَ عَلَى أَحَدِنَا فِي بَيْتِهِ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لِيُمْسِكْ بِيَدِهِ ، وَلْيَكُنْ عَبْدَ اللهِ الْمَقْتُولَ ، وَلَا يَكُنْ عَبْدَ اللهِ الْقَاتِلَ ، فَإِنَّ الرَّجُلَ يَكُونُ فِي  قُبَّةِ  الْإِسْلَامِ ، فَيَأْكُلُ مَالَ أَخِيهِ ،  وَيَسْفِكُ  دَمَهُ ، وَيَعْصِي رَبَّهُ ، وَيَكْفُرُ بِخَالِقِهِ ، وَتَجِبُ لَهُ  جَهَنَّمُ  .","","Musnad Abi Ya'la al-Mawsili 1523","","جندب بن عبد الله البجلي عن شهر بن حوشب عن عبد الحميد بن بهرام الفزاري عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1523","6 - (  1524  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  سُفْيَانَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ، قَالَ :  سَمِعْتُ  جُنْدُبًا الْبَجَلِيَّ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ سَمَّعَ سَمَّعَ اللهُ بِهِ  ، وَمَنْ رَاءَى رَاءَى اللهُ بِهِ  .         [3/94]             [3/95]","","Musnad Abi Ya'la al-Mawsili 1524","","جندب بن عبد الله البجلي عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن عبد الرحمن بن مهدي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1524","7 - (  1525  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ يَعْنِي ابْنَ عُمَيْرٍ ،  عَنْ  جُنْدُبِ بْنِ سُفْيَانَ الْبَجَلِيِّ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَنَا  فَرَطُكُمْ  عَلَى الْحَوْضِ  .","","Musnad Abi Ya'la al-Mawsili 1525","","جندب بن عبد الله البجلي عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1525","8 - (  1526  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  حَدَّثَنَا  الْأَنْصَارِيُّ ،  حَدَّثَنَا  الْأَشْعَثُ ،  عَنِ  الْحَسَنِ ،  عَنْ  جُنْدُبِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ صَلَّى صَلَاةَ الصُّبْحِ كَانَ فِي ذِمَّةِ اللهِ  ، فَإِيَّاكَ أَنْ يَطْلُبَكَ اللهُ بِشَيْءٍ مِنْ ذِمَّتِهِ  .         [3/96]","","Musnad Abi Ya'la al-Mawsili 1526","","جندب بن عبد الله البجلي عن الحسن البصري عن أشعث الحمراني عن محمد بن عبد الله بن المثنى الخزرجي عن أبو موسى الزمن عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1526","9 - (  1527  ) -  حَدَّثَنَا  أَبُو مُوسَى ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  حَدَّثَنِي  أَبِي  ، قَالَ :  سَمِعْتُ  الْحَسَنَ ، قَالَ :  حَدَّثَنَا  جُنْدُبُ بْنُ عَبْدِ اللهِ ، فِي هَذَا الْمَسْجِدِ ، فَمَا نَسِينَا مِنْهُ حَدِيثًا وَلَا نَخْشَى أَنْ يَكُونَ كَذَبَ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  خَرَجَ بِرَجُلٍ خُرَّاجٌ مِمَّنْ كَانَ قَبْلَكُمْ ، فَجَزِعَ مِنْهُ  ، فَأَخَذَ  سِكِّينًا  ، فَجَزَّ بِهَا يَدَهُ ، فَمَا رَقَأَ عَنْهُ الدَّمُ حَتَّى مَاتَ ، قَالَ اللهُ تَعَالَى : عَبْدِي بَادَرَنِي بِنَفْسِهِ حَرَّمْتُ عَلَيْهِ الْجَنَّةَ  .         [3/97]      قَالَ  أَبُو مُوسَى  : قَالَ  وَهْبٌ  :  الْقَدَرِيَّةُ يَحْتَجُّونَ بِهَذَا الْحَدِيثِ ، وَلَيْسَ لَهُمْ فِيهِ حُجَّةٌ  .         [3/98]","","Musnad Abi Ya'la al-Mawsili 1527","","جندب بن عبد الله البجلي عن الحسن البصري عن جرير بن حازم عن وهب بن جرير بن حازم عن أبو موسى الزمن عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1527","10 - (  1528  ) -  حَدَّثَنَا  أَبُو مُوسَى ،  حَدَّثَنَا  الْحَجَّاجُ بْنُ الْمِنْهَالِ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ ،  عَنْ  أَبِي هُرَيْرَةَ ،","","Musnad Abi Ya'la al-Mawsili 1528","","أبو هريرة الدوسي عن عمار بن أبي عمار الحارثي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أبو موسى الزمن عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1528","10 - (  1528  ) ( م ) -  وَعَنْ  حَمَّادٍ ،  عَنْ  حُمَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  جُنْدُبِ بْنِ عَبْدِ اللهِ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَقِيَ  آدَمُ  مُوسَى  ، فَقَالَ  مُوسَى  : أَنْتَ  آدَمُ  الَّذِي خَلَقَكَ اللهُ بِيَدِهِ  ، وَأَسْكَنَكَ جَنَّتَهُ ، وَأَسْجَدَ لَكَ مَلَائِكَتَهُ ، فَعَلْتَ مَا فَعَلْتَ ، فَأَخْرَجْتَ ذُرِّيَّتَكَ مِنَ الْجَنَّةِ ؟ قَالَ  آدَمُ  : يَا  مُوسَى  ، أَنْتَ الَّذِي اصْطَفَاكَ اللهُ بِرِسَالَتِهِ ، وَكَلَّمَكَ ، وَقَرَّبَكَ  نَجِيًّا  ؟ قَالَ : نَعَمْ ، قَالَ : فَأَنَا أَقْدَمُ أَمِ الذِّكْرُ ؟ قَالَ : الذِّكْرُ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : فَحَجَّ  آدَمُ  ،  مُوسَى  ، فَحَجَّ  آدَمُ  مُوسَى  .         [3/99]","","Musnad Abi Ya'la al-Mawsili 1528","","جندب بن عبد الله البجلي عن الحسن البصري عن حميد الطويل عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أبو موسى الزمن عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1529","11 - (  1529  ) -  حَدَّثَنَا  صَالِحُ بْنُ حَاتِمِ بْنِ وَرْدَانَ ،  حَدَّثَنَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  سَمِعْتُ  أَبِي  يُحَدِّثُ ، عَنْ  أَبِي عِمْرَانَ الْجَوْنِيِّ ،  عَنْ  جُنْدُبِ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَالَ رَجُلٌ : وَاللهِ لَا يَغْفِرُ اللهُ لِفُلَانٍ ، فَقَالَ اللهُ :  مَنْ ذَا الَّذِي  يَتَأَلَّى  عَلَيَّ أَنْ لَا أَغْفِرَ لِفُلَانٍ ؟  فَإِنَّنِي قَدْ غَفَرْتُ لِفُلَانٍ ،  وَأَحْبَطْتُ  عَمَلَكَ  .         [3/100]","","Musnad Abi Ya'la al-Mawsili 1529","","جندب بن عبد الله البجلي عن عبد الملك بن حبيب الجوني عن سليمان بن طرخان عن معتمر بن سليمان عن صالح بن حاتم بن وردان البصري عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1530","12 - (  1530  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  حُمَيْدٌ يَعْنِي الرُّؤَاسِيَّ ،  حَدَّثَنِي  حَسَنُ بْنُ صَالِحٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  مَنْ سَلَّمَ عَلَيْكَ مِنْ خَلْقِ اللهِ فَارْدُدْ عَلَيْهِ وَإِنْ كَانَ مَجُوسِيًّا  فَإِنَّ اللهَ يَقُولُ :         {      وَإِذَا حُيِّيتُمْ بِتَحِيَّةٍ فَحَيُّوا بِأَحْسَنَ مِنْهَا أَوْ رُدُّوهَا         }      .","","Musnad Abi Ya'la al-Mawsili 1530","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن الحسن بن صالح بن صالح بن حي عن حميد بن عبد الرحمن الرؤاسي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1531","13 - (  1531  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سَالِمُ بْنُ نُوحٍ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ :         {      وَإِذَا حُيِّيتُمْ بِتَحِيَّةٍ فَحَيُّوا بِأَحْسَنَ مِنْهَا         }      لِأَهْلِ الْإِسْلَامِ أَوْ رُدُّوهَا عَلَى أَهْلِ  الشِّرْكِ  .","","Musnad Abi Ya'la al-Mawsili 1531","","الحسن البصري عن يونس بن عبيد عن سالم بن نوح العطار عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1532","14 - (  1532  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَسْوَدِ بْنِ قَيْسٍ ،         [3/101]      عَنْ  جُنْدُبِ بْنِ سُفْيَانَ ، قَالَ :  صَلَّيْنَا مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ يَوْمٍ ، فَذَبَحَ نَاسٌ ضَحَايَاهُمْ قَبْلَ الصَّلَاةِ ، فَلَمَّا انْصَرَفَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَآهُمْ قَدْ ذَبَحُوا قَبْلَ الصَّلَاةِ ، قَالَ :  مَنْ كَانَ ذَبَحَ أُضْحِيًّتَهُ قَبْلَ الصَّلَاةِ ، فَلْيَذْبَحْ  ذِبْحًا  آخَرَ  ، وَمَنْ كَانَ لَمْ يَذْبَحْ حَتَّى صَلَّيْنَا ، فَلْيَذْبَحْ عَلَى اسْمِ اللهِ  .","","Musnad Abi Ya'la al-Mawsili 1532","","جندب بن عبد الله البجلي عن الأسود بن قيس العبدي عن الوضاح بن عبد الله اليشكري عن خلف بن هشام البزار عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1533","15 - (  1533  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  جُنْدُبِ بْنِ سُفْيَانَ الْبَجَلِيِّ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَمِيَتْ إِصْبَعُهُ فِي بَعْضِ الْمَشَاهِدِ  ، فَقَالَ :         [3/102]      هَلْ أَنْتِ إِلَّا إِصْبَعٌ دَمِيتِ وَفِي  سَبِيلِ  اللهِ مَا لَقِيتِ .  ؟","","Musnad Abi Ya'la al-Mawsili 1533","","جندب بن عبد الله البجلي عن الأسود بن قيس العبدي عن الوضاح بن عبد الله اليشكري عن خلف بن هشام البزار عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1534","16 - (  1534  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  سَمِعْتُ  أَبِي  ،  عَنْ  صَاحِبٍ لَهُ وَهُوَ الْحَضْرَمِيُّ ،  عَنْ  أَبِي السَّوَّارِ  يُحَدِّثُ عَنْ  جُنْدُبِ بْنِ عَبْدِ اللهِ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعَثَ رَهْطًا وَبَعَثَ عَلَيْهِمْ  أَبَا عُبَيْدَةَ بْنَ الْجَرَّاحِ  ، فَلَمَّا أَخَذَ يَنْطَلِقُ لَكِنَّهُ بَكَى صَبَابَةً إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَبَعَثَ رَجُلًا مَكَانَهُ يُقَالُ لَهُ  عَبْدُ اللهِ بْنُ جَحْشٍ  ، وَكَتَبَ لَهُ كِتَابًا ، وَأَمَرَهُ أَنْ لَا يُكْرِهَ أَحَدًا مِنْ أَصْحَابِهِ عَلَى الْمَسِيرِ مَعَهُ ، فَلَمَّا قَرَأَ الْكِتَابَ ،  اسْتَرْجَعَ  ، وَقَالَ : سَمْعٌ وَطَاعَةٌ ،  يَعْنِي لِلهِ وَرَسُولِهِ  ، خَبَّرَهُمُ الْخَبَرُ ، وَقَرَأَ عَلَيْهِمُ الْكِتَابَ ، فَرَجَعَ رَجُلَانِ ، وَمَضَى بَقِيَّتُهُمْ ، فَلَقُوا  ابْنَ الْحَضْرَمِيِّ  ، فَقَتَلُوهُ ، وَلَمْ يُدْرِكْ ذَاكَ الْيَوْمَ  مِنْ رَجَبٍ         [3/103]      أَوْ مِنْ جُمَادَى  ، فَقَالَ الْمُشْرِكُونَ لِلْمُسْلِمِينَ : فَعَلْتُمْ كَذَا وَكَذَا فِي  الشَّهْرِ  الْحَرَامِ ، فَأَتَوْا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَحَدَّثُوهُ الْحَدِيثَ ، فَأَنْزَلَ اللهُ :         {      يَسْأَلُونَكَ عَنِ الشَّهْرِ الْحَرَامِ قِتَالٍ فِيهِ قُلْ قِتَالٌ فِيهِ كَبِيرٌ         }      إِلَى قَوْلِهِ         {      وَالْفِتْنَةُ أَكْبَرُ مِنَ الْقَتْلِ         }      قَالَ :  الشِّرْكُ  ، قَالَ بَعْضُ الَّذِينَ كَانُوا فِي السَّرِيَّةِ : وَاللهِ مَا قَتَلَهُ إِلَّا وَاحِدٌ ، فَإِنْ يَكُ خَيْرًا ، فَقَدْ وَلِيتَهُ ، وَإِنْ يَكُ ذَنْبًا فَقَدْ عَمِلْتَهُ ، وَقَالَ بَعْضُ الْمُسْلِمِينَ : إِنْ لَمْ يَكُونُوا أَصَابُوا فِي شَهْرِهِمْ هَذَا وِزْرًا ، فَلَيْسَ لَهُمْ فِيهِ أَجْرٌ ، فَأَنْزَلَ اللهُ :         {      إِنَّ الَّذِينَ آمَنُوا وَالَّذِينَ هَاجَرُوا وَجَاهَدُوا فِي سَبِيلِ اللهِ أُولَئِكَ يَرْجُونَ رَحْمَتَ اللهِ وَاللهُ غَفُورٌ رَحِيمٌ         }      .","","Musnad Abi Ya'la al-Mawsili 1534","","جندب بن عبد الله البجلي عن أبو السوار العدوي عن حضرمي بن لاحق الأعرجي عن سليمان بن طرخان عن معتمر بن سليمان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جندب بن عبد الله البجلي"
"1535","[3/104]      مُسْنَدُ  ثَابِتِ بْنِ الضَّحَّاكِ  1 - (  1535  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  أَبَانُ بْنُ يَزِيدَ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ، أَنَّ أَبَا قِلَابَةَ  حَدَّثَهُ  ، أَنَّ ثَابِتَ بْنَ الضَّحَّاكِ  حَدَّثَهُ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ حَلَفَ عَلَى مِلَّةٍ غَيْرِ الْإِسْلَامِ كَاذِبًا ، فَهُوَ كَمَا قَالَ  ، لَيْسَ عَلَى رَجُلٍ نَذْرٌ فِيمَا لَا يَمْلِكُ  .","","Musnad Abi Ya'la al-Mawsili 1535","","ثابت بن الضحاك الأشهلي عن أبو قلابة الجرمي عن يحيى بن أبي كثير عن أبان بن يزيد العطار عن هدبة بن خالد عن أبو يعلى الموصلي","مسند ثابت بن الضحاك"
"1536","[3/105]      مُسْنَدُ  حَمْزَةَ الْأَسْلَمِيِّ  1 - (  1536  ) -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الْجَبَّارِ ،  حَدَّثَنَا  الْمُغِيرَةُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ خَالِدِ بْنِ حِزَامٍ الْحِزَامِيِّ ،  حَدَّثَنَا  أَبُو الزِّنَادِ ،  أَنَّ مُحَمَّدَ بْنَ حَمْزَةَ  حَدَّثَهُ  ،  عَنْ  أَبِيهِ حَمْزَةَ الْأَسْلَمِيِّ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعَثَهُ فِي سَرِيَّةٍ ،         [3/106]      وَأَمَّرَهُ عَلَيْهِمْ ، وَقَالَ :  إِنْ أَخَذْتُمْ  فُلَانًا  فَأَحْرِقُوهُ  بِالنَّارِ  ، فَلَمَّا وَلَّيْتُ دَعُونِي مِنْ وَرَائِي ، فَجِئْتُ ، فَقَالَ : إِنْ أَخَذْتُمْ فُلَانًا فَاقْتُلُوهُ ، وَلَا تُحْرِقُوهُ بِالنَّارِ ، فَإِنَّهُ لَا يُعَذِّبُ بِالنَّارِ إِلَّا رَبُّ النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 1536","","حمزة بن عمرو بن عويمر الأسلمي عن محمد بن حمزة الأسلمي عن أبو الزناد عن المغيرة بن عبد الرحمن بن عبد الله الحزامي عن سعيد بن عبد الجبار الكرابيسي عن أبو يعلى الموصلي","مسند حمزة الأسلمي"
"1537","[3/107]      يَزِيدُ بْنُ رُكَانَةَ  1 - (  1537  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  جَرِيرٌ يَعْنِي ابْنَ حَازِمٍ ،  عَنِ  الزُّبَيْرِ بْنِ سَعِيدٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ بْنِ رُكَانَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  أَنَّهُ طَلَّقَ امْرَأَتَهُ  الْبَتَّةَ  ، فَأَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : مَا أَرَدْتَ بِهَا ؟ قَالَ : وَاحِدَةً ، قَالَ : آللهِ ؟ قَالَ : آللهِ ، قَالَ : هِيَ عَلَى مَا أَرَدْتَ  .         [3/108]","","Musnad Abi Ya'la al-Mawsili 1537","","ركانة بن عبد يزيد المطلبي عن علي بن يزيد بن ركانة المطلبي عن عبد الله بن علي بن يزيد بن ركانة المطلبي عن الزبير بن سعيد الهاشمي عن جرير بن حازم عن سليمان بن داود العتكي عن أبو يعلى الموصلي","يزيد بن ركانة"
"1538","2 - (  1538  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  جَرِيرٌ ،  حَدَّثَنَا  الزُّبَيْرُ بْنُ سَعِيدٍ الْهَاشِمِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَلِيِّ بْنِ يَزِيدَ بْنِ رُكَانَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  أَنَّهُ طَلَّقَ امْرَأَتَهُ  الْبَتَّةَ  عَلَى عَهْدِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - ، فَأَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَأَخْبَرَهُ ، فَقَالَ : مَا نَوَيْتَ بِذَلِكَ ؟ قَالَ : وَاحِدَةً ، قَالَ : آللهِ ؟ قَالَ : آللهِ ، قَالَ : هِيَ عَلَى مَا أَرَدْتَ  .","","Musnad Abi Ya'la al-Mawsili 1538","","ركانة بن عبد يزيد المطلبي عن علي بن يزيد بن ركانة المطلبي عن عبد الله بن علي بن يزيد بن ركانة المطلبي عن الزبير بن سعيد الهاشمي عن جرير بن حازم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","يزيد بن ركانة"
"1539","[3/109]      الْجَارُودُ  1 - (  1539  ) -  حَدَّثَنَا  هُدْبَةُ ،  حَدَّثَنَا  أَبَانُ ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِي مُسْلِمٍ الْجَذْمِيِّ ،  عَنِ  الْجَارُودِ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 1539","","الجارود ظئر العناق عن أبو مسلم الجذمي عن يزيد بن عبد الله بن الشخير العامري عن قتادة بن دعامة عن أبان بن يزيد العطار عن هدبة بن خالد عن أبو يعلى الموصلي","الجارود"
"1540","عَبْدُ اللهِ بْنُ الْحَارِثِ بْنِ جَزْءٍ الزُّبَيْدِيِّ  1 - (  1540  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرٌو ، أَنَّ سُلَيْمَانَ بْنَ زِيَادٍ الْحَضْرَمِيَّ  حَدَّثَهُ  ، أَنَّ عَبْدَ اللهِ بْنَ الْحَارِثِ بْنِ جَزْءٍ الزُّبَيْدِيِّ  حَدَّثَهُ  ،  أَنَّهُ مَرَّ         [3/110]      وَصَاحِبٌ لَهُ  بِأُمِّ أَيْمَنَ  ، وَفِتْيَةٌ مِنْ  قُرَيْشٍ  قَدْ حَلُّوا أُزُرَهُمْ  ، فَجَعَلُوهَا مَخَارِيقَ يَجْتَلِدُونَ بِهَا وَهُمْ عُرَاةٌ ، قَالَ  عَبْدُ اللهِ  : فَلَمَّا مَرَرْنَا بِهِمْ ، قَالُوا : إِنَّ هَؤُلَاءِ قِسِّيسُونَ فَدَعُوهُمْ ، ثُمَّ إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَرَجَ عَلَيْهِمْ فَلَمَّا أَبْصَرُوهُ تَبَدَّدُوا ، فَرَجَعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُغْضَبًا حَتَّى دَخَلَ ، وَكُنْتُ وَرَاءَ الْحُجْرَةِ ، فَسَمِعْتُهُ يَقُولُ : سُبْحَانَ اللهِ ، لَا مِنَ اللهِ اسْتَحْيَوْا ، وَلَا مِنْ رَسُولِهِ اسْتَتَرُوا ،  وَأُمُّ أَيْمَنَ  عِنْدَهُ ، تَقُولُ : اسْتَغْفِرْ لَهُمْ يَا رَسُولَ اللهِ ، قَالَ  عَبْدُ اللهِ  : فَبِأَبِي مَا اسْتَغْفَرَ لَهُمْ  .","","Musnad Abi Ya'la al-Mawsili 1540","","عبد الله بن الحارث بن جزء الزبيدي عن سليمان بن زياد الصوراني عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","عبد الله بن الحارث بن جزء الزبيدي"
"1541","2 - (  1541  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  الْمُفَضَّلُ بْنُ فَضَالَةَ ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  سُلَيْمَانَ بْنِ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَزْءٍ ، قَالَ :  أَكَلْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمًا         [3/111]      شِوَاءً وَنَحْنُ فِي الْمَسْجِدِ أُقِيمَتِ الصَّلَاةُ  ، فَلَمْ نَزِدْ عَلَى أَنْ مَسَحْنَا أَيْدِيَنَا بِالْحَصَاةِ  .","","Musnad Abi Ya'la al-Mawsili 1541","","عبد الله بن الحارث بن جزء الزبيدي عن سليمان بن زياد الصوراني عن عبد الله بن لهيعة عن المفضل بن فضالة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","عبد الله بن الحارث بن جزء الزبيدي"
"1542","هُبَيْبُ بْنُ مُغَفَّلٍ  1 - (  1542  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ، قَالَ :  وَحَدَّثَنَا  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَسْلَمَ أَبِي عِمْرَانَ ،         [3/112]      عَنْ  هُبَيْبِ بْنِ مُغَفَّلٍ ،  أَنَّهُ رَأَى  مُحَمَّدَ بْنَ عُلْبَةَ الْقُرَشِيَّ  يَجُرُّ إِزَارَهُ ، فَنَظَرَ إِلَيْهِ  هُبَيْبُ بْنُ مُغْفِلٍ  ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ وَطِئَهُ  خُيَلَاءَ  ، وَطِئَهُ فِي النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 1542","","هبيب بن مغفل الغفارى عن أسلم بن يزيد التجيبي عن يزيد بن أبي حبيب الأزدي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","هبيب بن مغفل"
"1543","مُسْنَدُ  أَبِي شَهْمٍ  1 - (  1543  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ الْكِنْدِيُّ ،  حَدَّثَنَا  يَزِيدُ بْنُ عَطَاءٍ ،  عَنْ  بَيَانَ بْنِ بِشْرٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  أَبِي شَهْمٍ ، وَكَانَ بَطَّالًا ، قَالَ :  مَرَّتْ بِي جَارِيَةٌ فِي بَعْضِ طُرُقِ  الْمَدِينَةِ  ، فَأَهْوَيْتُ بِيَدِي إِلَى  خَاصِرَتِهَا  ، فَلَمَّا كَانَ الْغَدُ أَتَى النَّاسُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يُبَايِعُونَهُ  ، وَأَتَيْتُهُ فَبَسَطْتُ يَدِي  لِأُبَايِعَهُ  ،         [3/113]      فَقَبَضَ يَدَيْهِ فَقَالَ : أَنْتَ صَاحِبُ الْجُبَيْذَةِ أَمْسِ ؟ قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، بَايِعْنِي لَا أَعُودُ أَبَدًا ، قَالَ : فَنَعَمْ إِذًا  .","","Musnad Abi Ya'la al-Mawsili 1543","","أبو شهم الكوفي عن قيس بن أبي حازم عن بيان بن بشر الأحمسي عن يزيد بن عطاء بن يزيد اليشكري عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند أبي شهم"
"1544","مُسْنَدُ  رَافِعِ بْنِ مَكِيثٍ  .  1 - (  1544  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  أَخْبَرَنَا  مَعْمَرٌ ،  عَنْ  عُثْمَانَ بْنِ زُفَرَ ،  عَنْ  بَعْضِ بَنِي رَافِعِ بْنِ مَكِيثٍ ،  عَنْ  رَافِعِ بْنِ مَكِيثٍ ، وَكَانَ شَهِدَ الْحُدَيْبِيَةَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [3/114]      قَالَ :  حُسْنُ  الْمَلَكَةِ  نَمَاءٌ  ، وَسُوءُ  الْخُلُقِ  شُؤْمٌ  .","","Musnad Abi Ya'la al-Mawsili 1544","","رافع بن مكيث الحديبي عن بعض بني رافع بن مكيث عن عثمان بن زفر الجهني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند رافع بن مكيث"
"1545","2 - (  1545  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  هَمَّامُ بْنُ يَحْيَى ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَامِرِ بْنِ أَبِي أُمَيَّةَ أَخِي أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصْبِحُ  جُنُبًا  وَيَصُومُ وَلَا يُفْطِرُ  .","","Musnad Abi Ya'la al-Mawsili 1545","","هند بنت أبي أمية زوج رسول الله عن عامر بن أبي أمية المخزومي عن سعيد بن المسيب عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن أبو يعلى الموصلي","مسند رافع بن مكيث"
"1546","[3/115]      مُسْنَدُ  رَبَاحِ بْنِ رَبِيعٍ  1 - (  1546  ) -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الْجَبَّارِ  بِالْبَصْرَةِ  ،  حَدَّثَنَا  الْمُغِيرَةُ بْنُ عَبْدِ الرَّحْمَنِ الْحِزَامِيِّ ،  حَدَّثَنَا  أَبُو الزِّنَادِ ،  عَنْ  مُرَقِّعِ بْنِ صَيْفِيٍّ ،  عَنْ  جَدِّهِ رَبَاحِ بْنِ رَبِيعٍ  ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي غَزَاةٍ ، وَعَلَى  مُقَدِّمَةِ  النَّاسِ  خَالِدُ بْنُ الْوَلِيدِ  ، فَإِذَا امْرَأَةٌ مَقْتُولَةٌ عَلَى         [3/116]      الطَّرِيقِ ، يَتَعَجَّبُونَ مِنْ خَلْقِهَا ، قَدْ أَصَابَتْهَا  الْمُقَدِّمَةُ  ، فَأَتَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَوَقَفَ عَلَيْهَا ، فَقَالَ : هَا مَا كَانَتْ هَذِهِ تُقَاتِلُ ، ثُمَّ قَالَ لِرَجُلٍ :  أَدْرِكْ  خَالِدًا  ، فَلَا يَقْتُلَنَّ  ذُرِّيَّةً  ، وَلَا  عَسِيفًا  .","","Musnad Abi Ya'la al-Mawsili 1546","","رباح بن الربيع الأسيدي عن مرقع بن صيفي الحنظلي عن أبو الزناد عن المغيرة بن عبد الرحمن بن عبد الله الحزامي عن سعيد بن عبد الجبار الكرابيسي عن أبو يعلى الموصلي","مسند رباح بن ربيع"
"1547","[3/117]      مُسْنَدُ  عَفِيفٍ الْكِنْدِيِّ  1 - (  1547  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ ،  حَدَّثَنَا  سَعِيدُ بْنُ خُثَيْمٍ الْهِلَالِيُّ ،  عَنْ  أَسَدِ بْنِ وَدَاعَةَ الْبَجَلِيِّ ،  عَنِ  ابْنِ يَحْيَى بْنِ عَفِيفٍ الْكِنْدِيِّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ عَفِيفٍ  ، قَالَ :  جِئْتُ فِي الْجَاهِلِيَّةِ إِلَى  مَكَّةَ  ، وَأَنَا أُرِيدُ أَنْ أَبْتَاعَ لِأَهْلِي مِنْ ثِيَابِهَا وَعِطْرِهَا  ، فَأَتَيْتُ  الْعَبَّاسَ بْنَ عَبْدِ الْمُطَّلِبِ  ، وَكَانَ رَجُلًا تَاجِرًا ، فَأَنَا عِنْدَهُ جَالِسٌ حَيْثُ أَنْظُرُ إِلَى  الْكَعْبَةِ  ، وَقَدْ حَلَّقَتِ الشَّمْسُ فِي السَّمَاءِ ، فَارْتَفَعَتْ ، فَذَهَبْتُ إِذْ جَاءَ شَابٌّ فَرَمَى بِبَصَرِهِ إِلَى السَّمَاءِ ، ثُمَّ قَامَ مُسْتَقْبِلَ الْقِبْلَةِ ، ثُمَّ لَمْ أَلْبَثْ إِلَّا يَسِيرًا حَتَّى جَاءَ غُلَامٌ ، فَقَامَ عَلَى يَمِينِهِ ، ثُمَّ لَمْ أَلْبَثْ إِلَّا يَسِيرًا حَتَّى جَاءَتِ امْرَأَةٌ ، فَقَامَتْ خَلْفَهُمَا ، فَرَكَعَ الشَّابُّ ، فَرَكَعَ الْغُلَامُ وَالْمَرْأَةُ ، فَرَفَعَ الشَّابُّ ، فَرَفَعَ الْغُلَامُ وَالْمَرْأَةُ ، فَقُلْتُ : يَا  عَبَّاسُ  ، أَمْرٌ         [3/118]      عَظِيمٌ ! فَقَالَ  الْعَبَّاسُ  : أَمْرٌ عَظِيمٌ ، تَدْرِي مَنْ هَذَا الشَّابُّ ؟ قُلْتُ : لَا ، قَالَ : هَذَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ  ، ابْنُ أَخِي ، تَدْرِي مَنْ هَذَا الْغُلَامُ ؟ هَذَا  عَلِيٌّ  ابْنُ أَخِي ، تَدْرِي مَنْ هَذِهِ الْمَرْأَةُ ؟ هَذِهِ  خَدِيجَةُ بِنْتُ خُوَيْلِدٍ  زَوْجَتُهُ ، إِنَّ ابْنَ أَخِي هَذَا أَخْبَرَنِي أَنَّ رَبَّهُ رَبُّ السَّمَوَاتِ وَالْأَرْضِ أَمَرَهُ بِهَذَا الدِّينِ الَّذِي هُوَ عَلَيْهِ ، وَلَا وَاللهِ مَا عَلَى الْأَرْضِ كُلِّهَا أَحَدٌ عَلَى هَذَا الدِّينِ غَيْرُ هَؤُلَاءِ الثَّلَاثَةِ  .","","Musnad Abi Ya'la al-Mawsili 1547","","عفيف الكندي عن يحيى بن عفيف الكندي عن ابن يحيى بن عفيف الكندي عن أسد بن عبد الله بن يزيد بن أسد القسري عن سعيد بن خثيم الهلالي عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","مسند عفيف الكندي"
"1548","[3/119]      مُسْنَدُ  قَتَادَةَ بْنِ النُّعْمَانِ  1 - (  1548  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ الْهُذَلِيُّ إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ جَعْفَرٍ ،  عَنْ  مَالِكِ بْنِ أَنَسٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ صَعْصَعَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ :  أَخْبَرَنِي  أَخِي قَتَادَةُ بْنُ النُّعْمَانِ ،  أَنَّ  رَجُلًا  قَامَ فِي زَمَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ مِنَ السَّحَرِ :         {      قُلْ هُوَ اللهُ أَحَدٌ         }      ، يُرَدِّدُهَا لَا يَزِيدُ عَلَيْهَا ، فَلَمَّا أَصْبَحَ أَتَى  رَجُلٌ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : يَا رَسُولَ اللهِ ،         [3/120]      إِنَّ فُلَانًا قَامَ اللَّيْلَةَ فَقَرَأَ فِي السَّحَرِ :         {      قُلْ هُوَ اللهُ أَحَدٌ             *          اللهُ الصَّمَدُ             *          لَمْ يَلِدْ وَلَمْ يُولَدْ             *          وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ         }      ، يُرَدِّدُهَا لَا يَزِيدُ عَلَيْهَا ، كَأَنَّ الرَّجُلَ يَتَقَالُّهَا ، قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وَالَّذِي نَفْسِي بِيَدِهِ إِنَّهَا لَتَعْدِلُ  ثُلُثَ  الْقُرْآنِ  .","","Musnad Abi Ya'la al-Mawsili 1548","","قتادة بن النعمان ذو العينين عن أبو سعيد الخدري عن عبد الله بن عبد الرحمن بن أبي صعصعة المازني عن عبد الرحمن بن عبد الله بن عبد الرحمن  بن أبي صعصعة المازني عن مالك بن أنس عن إسماعيل بن جعفر بن أبي كثير الزرقي عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند قتادة بن النعمان"
"1549","2 - (  1549  ) -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ الْحِمَّانِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سُلَيْمَانَ بْنِ غَسِيلٍ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  أَبِيهِ يَعْنِي ،  عَنْ  قَتَادَةَ بْنِ النُّعْمَانِ  ،  أَنَّهُ أُصِيبَتْ عَيْنُهُ  يَوْمَ بَدْرٍ  ، فَسَالَتْ  حَدَقَتُهُ  عَلَى وَجْنَتِهِ  ، فَأَرَادُوا أَنْ يَقْطَعُوهَا فَسَأَلَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : لَا ، فَدَعَا بِهِ ، فَغَمَزَ  حَدَقَتَهُ  بِرَاحَتِهِ ، فَكَانَ لَا يُدْرَى أَيُّ عَيْنَيْهِ أُصِيبَتْ  .","","Musnad Abi Ya'la al-Mawsili 1549","","قتادة بن النعمان ذو العينين عن عمر بن قتادة بن النعمان الظفري عن عاصم بن عمر الظفري عن عبد الرحمن بن سليمان الأوسي عن يحيى بن عبد الحميد عن أبو يعلى الموصلي","مسند قتادة بن النعمان"
"1550","3 - (  1550  ) -  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْأَذْرَمِيُّ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ عُبَيْدٍ ،         [3/121]      عَنْ  جَدِّهِ  ، قَالَ :  أُصِيبَتْ عَيْنُ  أَبِي ذَرٍّ  يَوْمَ أُحُدٍ  ، فَبَزَقَ فِيهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَكَانَتْ أَصَحَّ عَيْنَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 1550","","عبيد بن أبي عبيد مولى أبي رهم عن عبد الرحمن بن الحارث بن عبيد عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن عبد الله بن محمد الأذرمي عن أبو يعلى الموصلي","مسند قتادة بن النعمان"
"1551","[3/122]      مُسْنَدُ  مَعْنِ بْنِ يَزِيدَ  1 - (  1551  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ وَعَبْدُ الرَّحْمَنِ بْنُ سَلَّامٍ وَعِدَّةٌ قَالُوا :  حَدَّثَنَا  أَبُو عَوَانَةَ  عَنْ  أَبِي الْجُوَيْرِيَةَ  عَنْ  مَعْنِ بْنِ يَزِيدَ قَالَ :  بَايَعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَا وَأَبِي وَجَدِّي وَخَاصَمْتُ إِلَيْهِ  فَأَفْلَجَنِي  ، وَخَطَبَ عَلَيَّ فَأَنْكَحَنِي . وَقَالَ  مَعْنٌ  : لَا تَحِلُّ غَنِيمَةٌ حَتَّى تُقْسَمَ عَلَى النَّاسِ  جَفَّةً  وَاحِدَةِ ، فَإِذَا قُسِّمَ حَلَّ لِي أَنْ أُعْطِيَكَ  .  وَهَذَا لَفْظُ  عَبْدِ الْأَعْلَى  خَاصَّةً ، وَلَيْسَ فِي حَدِيثِ غَيْرِهِ "" فَإِذَا قَسَمٌ أَنَا أُعْطِيكَ  "" .","","Musnad Abi Ya'la al-Mawsili 1551","","معن بن يزيد بن الأخنس السلمي عن حطان بن خفاف الجرمي عن الوضاح بن عبد الله اليشكري عن عدة عن أبو يعلى الموصلي","مسند معن بن يزيد"
"1552","[3/123]      مُسْنَدُ  أَحْمَرَ  1 - (  1552  ) -  حَدَّثَنَا  أَبُو مُوسَى ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ         [3/124]      مَهْدِيٍّ ،  حَدَّثَنَا  عَبَّادُ بْنُ رَاشِدٍ ، قَالَ :  سَمِعْتُ  الْحَسَنَ ، يَقُولُ :  حَدَّثَنَا  أَحْمَرُ ، صَاحِبُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِنَّ كُنَّا لَنَأْوِي لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِمَّا  يُجَافِي  مِرْفَقَيْهِ عَنْ جَنْبَيْهِ إِذَا سَجَدَ  .","","Musnad Abi Ya'la al-Mawsili 1552","","أحمر بن جزء الربعي عن الحسن البصري عن عباد بن راشد الكليبى عن عبد الرحمن بن مهدي عن أبو موسى الزمن عن أبو يعلى الموصلي","مسند أحمر"
"1553","2 - (  1553  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  حَدَّثَنَا  حُمَيْدُ بْنُ هِلَالٍ ،  عَنْ  هِشَامِ بْنِ عَامِرٍ ، قَالَ :  جَاءَتِ  الْأَنْصَارُ  يَوْمَ أُحُدٍ  ، فَقَالُوا : يَا رَسُولَ اللهِ ، بِنَا  قَرْحٌ  وَجَهْدٌ  ، فَكَيْفَ تَأْمُرُنَا ؟ قَالَ :  احْفِرُوا ، وَأَوْسِعُوا ، وَاجْعَلُوا الرَّجُلَيْنِ وَالثَّلَاثَةَ فِي الْقَبْرِ  ، فَقَالُوا : مَنْ نُقَدِّمُ ؟ قَالَ : قَدِّمُوا أَكْثَرَكُمْ قُرْآنًا ، قَالَ : فَقُدِّمَ         [3/125]      أَبِي بَيْنَ يَدَيِ  اثْنَيْنِ مِنَ  الْأَنْصَارِ  ، أَوْ قَالَ : وَاحِدٌ مِنَ  الْأَنْصَارِ  .","","Musnad Abi Ya'la al-Mawsili 1553","","هشام بن عامر بن أمية الأنصاري عن حميد بن هلال العدوي عن سليمان بن المغيرة القيسي عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند أحمر"
"1554","3 - (  1554  ) -  حَدَّثَنَا  زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَيُّوبُ ،  عَنْ  أَبِي قِلَابَةَ ، قَالَ :  كَانَ النَّاسُ يَشْتَرُونَ الذَّهَبَ بِالْوَرِقِ  نَسِيئَةً  ، قَالَ  إِسْمَاعِيلُ  :  أَحْسَبُهُ إِلَى الْعَطَاءِ  ، فَأَتَى عَلَيْهِمْ هِشَامُ بْنُ عَامِرٍ ، فَنَهَاهُمْ ،  وَقَالَ  : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ نَبِيعَ الذَّهَبَ  نَسِيئَةً  ، وَأَنْبَأَنَا ، أَوْ قَالَ : أَخْبَرَنَا أَنَّ ذَلِكَ هُوَ الرِّبَا  .","","Musnad Abi Ya'la al-Mawsili 1554","","هشام بن عامر بن أمية الأنصاري عن أبو قلابة الجرمي عن أيوب السختياني عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","مسند أحمر"
"1555","4 - (  1555  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ ،  عَنْ  أَيُّوبَ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  بَعْضِ أَشْيَاخِهِمْ ، قَالَ :  قَالَ  هِشَامُ بْنُ عَامِرٍ لِجِيرَانِهِ :  إِنَّكُمْ مُتَخَطُّونَ إِلَى رِجَالٍ مَا كَانُوا بِأَخَصَّ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَلَا أَوْعَى لِحَدِيثِهِ مِنِّي ، سَمِعْتُ         [3/126]      رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا بَيْنَ خَلْقِ  آدَمَ  إِلَى أَنْ تَقُومَ السَّاعَةُ خَلْقٌ أَكْبَرُ مِنَ  الدَّجَّالِ  .","","Musnad Abi Ya'la al-Mawsili 1555","","هشام بن عامر بن أمية الأنصاري عن بعض أشياخ حميد بن هلال العدوي عن حميد بن هلال العدوي عن أيوب السختياني عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","مسند أحمر"
"1556","5 - (  1556  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ ،  حَدَّثَنَا  أَيُّوبُ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  رَهْطٍ مِنْهُمْ : أَبُو الدَّهْمَاءِ ، وَأَبُو قَتَادَةَ ، قَالَ :  كُنَّا نَمُرُّ عَلَى هِشَامٍ ، نَأْتِي  عِمْرَانَ بْنَ حُصَيْنٍ  ، فَقَالَ ذَاتَ يَوْمٍ : إِنَّكُمْ لَتَتَجَاوَزُونَنِي إِلَى رِجَالٍ مَا كَانُوا بِأَخَصَّ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنِّي ، وَلَا أَعْلَمَ بِحَدِيثِهِ مِنِّي ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : مَا  بَيْنَ خَلْقِ  آدَمَ  إِلَى قِيَامِ السَّاعَةِ خَلْقٌ أَكْبَرُ مِنَ  الدَّجَّالِ  .","","Musnad Abi Ya'la al-Mawsili 1556","","هشام بن حكيم بن حزام الأسدي عن أبو قتادة العدوي عن حميد بن هلال العدوي عن أيوب السختياني عن عبد العزيز بن المختار الدباغ عن أحمد بن إسحاق الحضرمي عن زهير بن حرب عن أبو يعلى الموصلي","مسند أحمر"
"1557","6 - (  1557  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  عَنْ         [3/127]      شُعْبَةَ ،  عَنْ  يَزِيدَ الرِّشْكِ ،  عَنْ  مُعَاذَةَ ،  عَنْ  هِشَامِ بْنِ عَامِرٍ الْأَنْصَارِيِّ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَحِلُّ لِمُسْلِمٍ أَنْ  يُصَارِمَ  مُسْلِمًا فَوْقَ ثَلَاثٍ  ، وَإِنَّهُمَا نَاكِبَانِ عَنِ الْحَقِّ مَا كَانَا عَلَى صِرَامِهِمَا ، وَإِنَّ أَوَّلَهُمَا فَيْئًا يَكُونُ فِي سَبْقِهِ بِالْفَيْءِ كَفَّارَةٌ لَهُ ، وَإِنْ سَلَّمَ عَلَيْهِ فَلَمْ يَقْبَلْ سَلَامَهُ رَدَّتْ عَلَيْهِ الْمَلَائِكَةُ ، وَرَدَّ عَلَى الْآخَرِ الشَّيْطَانُ ، وَإِنْ مَاتَا عَلَى صِرَامِهِمَا  لَمْ يَدْخُلَا الْجَنَّةَ ، أَوْ لَمْ يَجْتَمِعَا فِي الْجَنَّةِ  .","","Musnad Abi Ya'la al-Mawsili 1557","","هشام بن عامر بن أمية الأنصاري عن معاذة بنت عبد الله العدوية عن يزيد بن أبي يزيد الرشك عن شعبة بن الحجاج عن أبو عامر العقدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند أحمر"
"1558","7 - (  1558  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  أَيُّوبُ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  أَبِي الدَّهْمَاءِ ،  عَنْ  هِشَامِ بْنِ عَامِرٍ ، قَالَ :  شَكَوْا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَا بِهِمْ مِنَ  الْقَرْحِ  ، فَقَالَ : احْفِرُوا ، وَأَحْسِنُوا ، وَأَوْسِعُوا ، وَادْفِنُوا الِاثْنَيْنِ وَالثَّلَاثَةَ فِي الْقَبْرِ ، وَقَدِّمُوا أَكْثَرَهُمْ قُرْآنًا ، قَالَ : فَمَاتَ أَبِي ، قُدِّمَ بَيْنَ يَدَيْ رَجُلَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 1558","","هشام بن عامر بن أمية الأنصاري عن قرفة بن بهيس العدوي عن حميد بن هلال العدوي عن أيوب السختياني عن عبد الوارث بن سعيد بن ذكوان عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","مسند أحمر"
"1559","[3/128]      مُسْنَدُ  أَبِي جُمُعَةَ  1 - (  1559  ) -  حَدَّثَنَا  عَبْدُ الْغَفَّارِ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُطَارِدٍ الْبَصْرِيُّ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  أَسِيدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  صَالِحِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِي جُمُعَةَ ، قَالَ :  تَغَدَّيْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَمَعَنَا  أَبُو عُبَيْدَةَ بْنُ الْجَرَّاحِ  ، فَقَالَ لَهُ  أَبُو عُبَيْدَةَ  : يَا رَسُولَ اللهِ ، أَحَدٌ خَيْرٌ مِنَّا ؟ أَسْلَمْنَا مَعَكَ ، وَجَاهَدْنَا مَعَكَ ، قَالَ : نَعَمْ ، قَوْمٌ يَكُونُونَ مِنْ بَعْدِي يُؤْمِنُونَ بِي ، وَلَمْ يَرَوْنِي  .         [3/129]","","Musnad Abi Ya'la al-Mawsili 1559","","أبو جمعة الأنصاري عن صالح بن جبير الصدائي عن أسيد بن عبد الرحمن الخثعمي عن أبو عمرو الأوزاعي عن عبد الله بن عطارد الطائي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","مسند أبي جمعة"
"1560","2 - (  1560  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  حَدَّثَنَا  أَبُو سَعِيدٍ مَوْلَى بَنِي هَاشِمٍ ،  عَنْ  أَبِي خَلَفٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَوْفٍ ، قَالَ :  سَمِعْتُ  أَبَا جُمُعَةَ جُنْبُذَ بْنَ سَبْعٍ ، يَقُولُ :  قَاتَلْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَوَّلَ النَّهَارِ كَافِرًا ، وَقَاتَلْتُ مَعَهُ آخِرَ النَّهَارِ مُسْلِمًا  ، وَكُنَّا ثَلَاثَةَ رِجَالٍ وَسَبْعَ نِسْوَةٍ ، وَفِينَا أُنْزِلَتْ :         {      وَلَوْلا رِجَالٌ مُؤْمِنُونَ وَنِسَاءٌ مُؤْمِنَاتٌ         }      الْآيَةَ  .         [3/130]","","Musnad Abi Ya'la al-Mawsili 1560","","أبو جمعة الأنصاري عن عبد الله بن عوف الكناني عن حجر بن الحارث الغساني عن عبد الرحمن بن عبد الله بن عبيد جردقة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند أبي جمعة"
"1561","3 - (  1561  ) -  حَدَّثَنَا  أَبُو عُبَيْدَةَ بْنُ الْفُضَيْلِ بْنِ عِيَاضٍ ،  حَدَّثَنَا  أَبُو سَعِيدٍ مَوْلَى بَنِي هَاشِمٍ ،  حَدَّثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَوْنِ بْنِ عَبْدِ اللهِ ، قَالَ :  لَقِيتُ شَيْخًا  بِالشَّامِ  ، فَقُلْتُ : أَسَمِعْتَ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَيْئًا ؟ قَالَ : نَعَمْ ، سَمِعْتُهُ يَقُولُ :  اللَّهُمَّ اغْفِرْ لَنَا وَارْحَمْنَا  .","","Musnad Abi Ya'la al-Mawsili 1561","","أحد الصحابة عن عون بن عبد الله بن عتبة عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عبد الرحمن بن عبد الله بن عبيد جردقة عن أبو عبيدة بن الفضيل بن عياض عن أبو يعلى الموصلي","مسند أبي جمعة"
"1562","4 - (  1562  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ الْكُوفِيُّ ،  حَدَّثَنَا  مُسْهِرُ بْنُ عَبْدِ الْمَلِكِ بْنِ سَلْعٍ ،  أَخْبَرَنِي  أَبِي  ، قَالَ :  قُلْتُ  لِعَبْدِ خَيْرٍ : كَمْ أَتَى عَلَيْكَ ؟ قَالَ : عِشْرُونَ وَمِائَةُ سَنَةٍ ، قُلْتُ :  هَلْ تَذْكُرُ مِنْ أَمْرِ الْجَاهِلِيَّةِ شَيْئًا  ؟ قَالَ : نَعَمْ ، كُنَّا  بِبِلَادِ الْيَمَنِ  ، فَجَاءَنَا كِتَابُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَدْعُو النَّاسَ إِلَى خَيْرٍ وَاسِعٍ ، فَكَانَ أَبِي مِمَّنْ خَرَجَ وَأَنَا غُلَامٌ ، فَلَمَّا رَجَعَ أَبِي قَالَ لِأُمِّي : مُرِي بِهَذِهِ الْقِدْرِ فَلْتُرَقْ لِلْكِلَابِ ، فَإِنَّا قَدْ أَسْلَمْنَا ، فَأَسْلِمِي  .","","Musnad Abi Ya'la al-Mawsili 1562","","عبد خير بن يزيد الخيواني عن عبد الملك بن سلع الهمداني عن مسهر بن عبد الملك الهمدانى عن الحسن بن حماد الوراق عن أبو يعلى الموصلي","مسند أبي جمعة"
"1563","[3/131]      مُسْنَدُ  عَبْدِ اللهِ بْنِ سَرْجِسَ  1 - (  1563  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  حَدَّثَنَا  عَاصِمٌ الْأَحْوَلُ ،  عَنْ  عَبْدِ اللهِ بْنِ سَرْجِسَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَأَكَلْتُ مَعَهُ خُبْزًا  وَلَحْمًا أَوْ قَالَ : ثَرِيدًا  ، فَقُلْتُ : غَفَرَ اللهُ لَكَ يَا رَسُولَ اللهِ ، قَالَ : وَلَكَ ، قُلْتُ  لِعَبْدِ اللهِ بْنِ سَرْجِسَ  : اسْتَغْفَرَ لَكَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : نَعَمْ ، وَلَكَ ، وَتَلَا هَذِهِ الْآيَةَ :         [3/132]             {      وَاسْتَغْفِرْ لِذَنْبِكَ وَلِلْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ         }      ، قَالَ : ثُمَّ دُرْتُ حَتَّى صِرْتُ خَلْفَهُ فَرَأَيْتُ خَاتَمَ النُّبُوَّةِ عِنْدَ  نُغْضِ  كَتِفِهِ الْيُسْرَى  جُمْعًا  عَلَيْهِ  خِيلَانٌ  .","","Musnad Abi Ya'la al-Mawsili 1563","","عبد الله بن سرجس المزني عن عاصم بن سليمان الأحول عن عبد الواحد بن زياد عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عبد الله بن سرجس"
"1564","2 - (  1564  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْمُخْتَارِ ،  حَدَّثَنَا  عَاصِمٌ الْأَحْوَلُ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَرْجِسَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ يَغْتَسِلَ الرَّجُلُ بِفَضْلِ الْمَرْأَةِ  ، وَتَغْتَسِلَ الْمَرْأَةُ بِفَضْلِ الرَّجُلِ ، وَلَكِنْ يَشْرَعَانِ فِيهِ جَمِيعًا  .","","Musnad Abi Ya'la al-Mawsili 1564","","عبد الله بن سرجس المزني عن عاصم بن سليمان الأحول عن عبد العزيز بن المختار الدباغ عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عبد الله بن سرجس"
"1565","[3/133]             [3/134]      مُسْنَدُ  عَمْرِو بْنِ مُرَّةَ  1 - (  1565  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  حَمَّادٌ يَعْنِي ابْنَ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ الْحَكَمِ ،  عَنْ  أَبِي حَسَنٍ :  أَنَّ  عَمْرَو بْنَ مُرَّةَ قَالَ  لِمُعَاوِيَةَ  : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  مَا مِنْ وَالٍ يُغْلَقُ بَابَهُ دُونَ ذَوِي الْخَلَّةِ وَالْحَاجَةِ ، إِلَّا أَغْلَقَ اللهُ أَبْوَابَ السَّمَاءِ عَنْ خَلَّتِهِ وَمَسْكَنَتِهِ  .         [3/135]","","Musnad Abi Ya'la al-Mawsili 1565","","عمرو بن مرة  بن عبس الفلسطيني عن أبو الحسن الجزري عن علي بن الحكم البناني عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عمرو بن مرة"
"1566","2 - (  1566  ) -  حَدَّثَنَا  زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَلِيِّ بْنِ الْحَكَمِ ، قَالَ :  حَدَّثَنِي  أَبُو حَسَنٍ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ، قَالَ : قُلْتُ  لِمُعَاوِيَةَ  : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنْ أَمِيرٍ وَلَا وَالٍ يُغْلِقُ بَابَهُ دُونَ ذَوِي الْحَاجَةِ وَالْخَلَّةِ وَالْمَسْكَنَةِ  ، إِلَّا أَغْلَقَ اللهُ أَبْوَابَ السَّمَاءِ دُونَ حَاجَتِهِ وَمَسْكَنَتِهِ ، قَالَ : فَجَعَلَ  مُعَاوِيَةُ  رَجُلًا عَلَى حَوَائِجِ النَّاسِ  .","","Musnad Abi Ya'la al-Mawsili 1566","","عمرو بن مرة  بن عبس الفلسطيني عن أبو الحسن الجزري عن علي بن الحكم البناني عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","مسند عمرو بن مرة"
"1567","3 - (  1567  ) -  حَدَّثَنَا  زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنَا  الرَّبِيعُ بْنُ سَبْرَةَ ،         [3/136]      عَنْ  عَمْرِو بْنِ مُرَّةَ الْجُهَنِيِّ ، قَالَ :  كُنْتُ جَالِسًا عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ :  مَنْ هَاهُنَا مِنْ  مَعَدٍّ  فَلْيَقُمْ  ؟ قَالَ : فَأَخَذْتُ ثَوْبِي لِأَقُومَ ، قَالَ : اقْعُدْ ، ثُمَّ قَالَ الثَّانِيَةَ ، فَقُلْتُ : مِمَّنْ أَنَا يَا رَسُولَ اللهِ ؟ قَالَ : مِنْ  حِمْيَرَ  .","","Musnad Abi Ya'la al-Mawsili 1567","","عمرو بن مرة  بن عبس الفلسطيني عن الربيع بن سبرة الجهني عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","مسند عمرو بن مرة"
"1568","[3/137]      مُخَوَّلٌ  1 - (  1568  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ بْنِ مَسْمُولٍ ، قَالَ :  سَمِعْتُ  الْقَاسِمَ بْنَ مُخَوَّلٍ الْبَهْزِيَّ ثُمَّ السُّلَمِيَّ ، يَقُولُ :  سَمِعْتُ  أَبِي ،  وَكَانَ قَدْ أَدْرَكَ الْجَاهِلِيَّةَ وَالْإِسْلَامَ ، يَقُولُ :  نَصَبْتُ حَبَائِلَ لِي  بِالْأَبْوَاءِ  ، فَوَقَعَ فِي حَبْلٍ مِنْهَا ظَبْيٌ ، فَأَفْلَتْ ، فَخَرَجْتُ فِي إِثْرِهِ ، فَوَجَدْتُ  رَجُلًا  قَدْ أَخَذَهُ ، فَتَنَازَعْنَا فِيهِ ،  فَتَسَاوَقْنَا  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَوَجَدْنَاهُ نَازِلًا  بِالْأَبْوَاءِ  تَحْتَ شَجَرَةٍ يَسْتَظِلُّ بِنِطَعٍ ، فَاخْتَصَمْنَا إِلَيْهِ ، فَقَضَى بِهِ بَيْنَنَا  شَطْرَيْنِ  ، قُلْتُ : يَا رَسُولَ اللهِ ، نَلْقَى الْإِبِلَ وَبِهَا لَبَنٌ وَهِيَ  مُصَرَّاةٌ  ، وَنَحْنُ مُحْتَاجُونَ ، قَالَ :  نَادِ صَاحِبَ الْإِبِلِ ثَلَاثًا ، فَإِنْ جَاءَ ، وَإِلَّا فَاحْلُلْ  صِرَارَهَا  ، ثُمَّ اشْرَبْ ، ثُمَّ صُرَّ  ، وَأَبْقِ لِلَّبَنِ دَوَاعِيَهُ ، قُلْتُ : يَا رَسُولَ اللهِ ، الضَّوَالُّ تَرِدُ عَلَيْنَا ، هَلْ لَنَا أَجْرٌ أَنْ نَسْقِيَهَا ؟ قَالَ : نَعَمْ ، فِي كُلِّ ذَاتِ كَبِدٍ  حَرَّى  أَجْرٌ .         [3/138]      ثُمَّ أَنْشَأَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُحَدِّثُنَا ، قَالَ : سَيَأْتِي عَلَى النَّاسِ زَمَانٌ ، خَيْرُ الْمَالِ فِيهِ غَنَمٌ بَيْنَ الْمَسْجِدَيْنِ تَأْكُلُ الشَّجَرَ وَتَرِدُ الْمَاءَ ، يَأْكُلُ صَاحِبُهَا مِنْ رِسْلِهَا ، وَيَشْرَبُ مِنْ أَلْبَانِهَا ، وَيَلْبَسُ مِنْ  أَصْوَافِهَا ، أَوْ قَالَ : أَشْعَارِهَا  ، وَالْفِتَنُ  تَرْتَكِسُ  بَيْنَ  جَرَاثِيمِ  الْعَرَبِ ، وَاللهِ مَا تَعْبَئُونَ ، يَقُولُهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثَلَاثًا ، قُلْتُ : يَا رَسُولَ اللهِ ، أَوْصِنِي ، قَالَ : أَقِمِ الصَّلَاةَ ، وَآتِ الزَّكَاةَ ، وَصُمْ رَمَضَانَ ، وَحُجَّ الْبَيْتَ ، وَاعْتَمِرْ ، وَبِرَّ وَالِدَيْكَ ، وَصِلْ رَحِمَكَ ، وَأَقْرِ الضَّيْفَ ، وَأْمُرْ بِالْمَعْرُوفِ ، وَانْهَ عَنِ الْمُنْكَرِ ، وَزُلْ مَعَ الْحَقِّ حَيْثُ زَالَ  .","","Musnad Abi Ya'la al-Mawsili 1568","","مخول بن يزيد البهزي عن القاسم بن مخول البهزى عن محمد بن سليمان المسمولي عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مخول"
"1569","[3/139]      مُسْنَدُ  عَمِّ  أَبِي حُرَّةَ الرَّقَاشِيِّ  1 - (  1569  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  أَبِي حُرَّةَ الرَّقَاشِيِّ ،  عَنْ  عَمِّهِ ، قَالَ :  كُنْتُ آخِذًا بِزِمَامِ نَاقَةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي أَوْسَطِ أَيَّامِ  التَّشْرِيقِ  فِي  حَجَّةِ الْوَدَاعِ  ، فَقَالَ فِيمَا يَقُولُ :  يَا أَيُّهَا النَّاسُ ، إِنَّ كُلَّ رِبًا مَوْضُوعٌ  ، وَإِنَّ أَوَّلَ رِبًا يُوضَعُ رِبَا  الْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ  ،         {      فَلَكُمْ رُءُوسُ أَمْوَالِكُمْ لا تَظْلِمُونَ وَلا تُظْلَمُونَ         }      .         [3/140]","","Musnad Abi Ya'la al-Mawsili 1569","","حنيفة عم أبي حرة الرقاشي عن حنيفة الرقاشي عن علي بن زيد بن جدعان عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عم أبي حرة الرقاشي"
"1570","2 - (  1570  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  أَبِي حُرَّةَ الرَّقَاشِيِّ ،  عَنْ  عَمِّهِ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا يَحِلُّ مَالُ امْرِئٍ مُسْلِمٍ إِلَّا بِطِيبِ نَفْسٍ مِنْهُ  .","","Musnad Abi Ya'la al-Mawsili 1570","","حنيفة عم أبي حرة الرقاشي عن حنيفة الرقاشي عن علي بن زيد بن جدعان عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عم أبي حرة الرقاشي"
"1571","الْحَارِثُ الْأَشْعَرِيُّ  1 - (  1571  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  أَبَانُ بْنُ يَزِيدَ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ، أَنَّ زَيْدًا  حَدَّثَهُ  ، أَنَّ أَبَا سَلَّامٍ  حَدَّثَهُ  ،         [3/141]      أَنَّ الْحَارِثَ الْأَشْعَرِيَّ  حَدَّثَهُ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ اللهَ أَمَرَ  يَحْيَى بْنَ زَكَرِيَّا  بِخَمْسِ كَلِمَاتٍ يَعْمَلُ بِهِنَّ  ، وَيَأْمُرُ  بَنِي إِسْرَائِيلَ  يَعْمَلُونَ بِهِنَّ ، وَإِنَّ  عِيسَى ابْنَ مَرْيَمَ  قَالَ لَهُ : إِنَّ اللهَ أَمَرَكَ بِخَمْسِ كَلِمَاتٍ تَعْمَلُ بِهِنَّ وَتَأْمُرُ بِهِنَّ  بَنِي إِسْرَائِيلَ  يَعْمَلُونَ بِهِنَّ ، فَإِمَّا أَنْ تَأْمُرَهُمْ ، وَإِمَّا أَنْ آمُرَهُمْ ؟ قَالَ : إِنَّكَ إِنْ تَسْبِقْنِي بِهِنَّ خَشِيتُ أَنْ أُعَذَّبَ ، أَوْ يُخْسَفَ بِي ، قَالَ : فَجَمَعَ النَّاسَ فِي  بَيْتِ الْمَقْدِسِ  حَتَّى امْتَلَأَ ، وَقَعَدَ النَّاسُ عَلَى الشُّرُفَاتِ ، قَالَ : فَوَعَظَهُمْ ، قَالَ : إِنَّ اللهَ أَمَرَنِي بِخَمْسِ كَلِمَاتٍ أَعْمَلُ بِهِنَّ ، وَآمُرُكُمْ أَنْ تَعْمَلُوا بِهِنَّ : أُولَاهُنَّ أَنْ تَعْبُدُوا اللهَ وَلَا تُشْرِكُوا بِهِ شَيْئًا ، وَإِنَّ مَثَلَ مَنْ  أَشْرَكَ  بِاللهِ كَمَثَلِ رَجُلٍ اشْتَرَى عَبْدًا مِنْ خَالِصِ مَالِهِ بِذَهَبٍ أَوْ  وَرِقٍ  ، قَالَ : هَذِهِ دَارِي ، وَهَذَا عَمَلِي ، فَاعْمَلْ وَأَدِّ إِلَيَّ ، فَجَعَلَ يَعْمَلُ وَيُؤَدِّي إِلَى غَيْرِ سَيِّدِهِ ، فَأَيُّكُمْ يَسُرُّهُ أَنْ يَكُونَ عَبْدُهُ كَذَلِكَ ؟ وَإِنَّ اللهَ خَلَقَكُمْ وَرَزَقَكُمْ فَلَا تُشْرِكُوا بِهِ         [3/142]      شَيْئًا ، وَأَمَرَكُمْ بِالصَّلَاةِ ، فَإِذَا صَلَّيْتُمْ فَلَا تَلْتَفِتُوا ، وَأَمَرَكُمْ بِالصِّيَامِ ، وَإِنَّ مَثَلَ ذَلِكَ كَمَثَلِ رَجُلٍ كَانَتْ مَعَهُ صُرَّةٌ ، فِيهَا مِسْكٌ ، وَمَعَهُ عِصَابَةٌ كُلُّهُمْ يُعْجِبُهُ أَنْ يَجِدَ رِيحَهَا ، وَإِنَّ الصِّيَامَ أَطْيَبُ عِنْدَ اللهِ مِنْ رِيحِ الْمِسْكِ ، وَآمُرُكُمْ بِالصَّدَقَةِ ، وَإِنَّ مَثَلَ ذَلِكَ كَمَثَلِ رَجُلٍ أَسَرَهُ الْعَدُوُّ وَقَامُوا إِلَيْهِ ، فَأَوْثَقُوا يَدَهُ إِلَى عُنُقِهِ ، فَقَالَ : هَلْ لَكُمْ أَنْ أَفْدِيَ نَفْسِي مِنْكُمْ ؟ قَالَ : فَجَعَلَ يُعْطِيهِمُ الْقَلِيلَ وَالْكَثِيرَ لِيَفُكَّ نَفْسَهُ مِنْهُمْ ، وَآمُرُكُمْ بِذِكْرِ اللهِ كَثِيرًا ، وَإِنَّ مَثَلَ ذَلِكَ كَمَثَلِ رَجُلٍ طَلَبَهُ الْعَدُوُّ سِرَاعًا فِي إِثْرِهِ حَتَّى أَتَى عَلَى حِصْنٍ حَصِينٍ ، فَأَحْرَزَ نَفْسَهُ فِيهِ ، كَذَلِكَ الْعَبْدُ لَا يُحْرِزُ نَفْسَهُ مِنَ الشَّيْطَانِ إِلَّا بِذِكْرِ اللهِ .  وَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وَأَنَا آمُرُكُمْ بِخَمْسٍ أَمَرَنِي اللهُ بِهِنَّ  : الْجَمَاعَةِ ، وَالسَّمْعِ ، وَالطَّاعَةِ ، وَالْهِجْرَةِ ،  وَالْجِهَادِ  فِي  سَبِيلِ  اللهِ ، فَمَنْ  فَارَقَ  الْجَمَاعَةَ  قِيدَ  شِبْرٍ خُلِعَ الْإِسْلَامُ مِنْ رَأْسِهِ ، إِلَّا أَنْ يَرْجِعَ ، وَمَنْ دَعَا بِدَعْوَى الْجَاهِلِيَّةِ ، فَإِنَّهُ مِنْ جُثَى  جَهَنَّمَ ،  قِيلَ : وَإِنْ صَامَ وَصَلَّى ؟ قَالَ : وَإِنْ صَلَّى وَصَامَ ، فَادْعُوا بِدَعْوَى اللهِ الَّذِي سَمَّاكُمُ الْمُسْلِمِينَ الْمُؤْمِنِينَ عِبَادَ اللهِ  .","","Musnad Abi Ya'la al-Mawsili 1571","","الحارث بن الحارث الأشعري عن ممطور الحبشي عن زيد بن سلام الحبشي عن يحيى بن أبي كثير عن أبان بن يزيد العطار عن هدبة بن خالد عن أبو يعلى الموصلي","الحارث الأشعري"
"1572","[3/143]      مُسْنَدُ  أَبِي هُبَيْرَةَ الْأَنْصَارِيِّ  1 - (  1572  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  أَخْبَرَنَا  مَخْرَمَةُ ،  عَنْ  أَبِيهِ  ،  عَنْ  سَعِيدِ بْنِ نَافِعٍ ،  قَالَ  :  رَآنِي أَبُو هُبَيْرَةَ الْأَنْصَارِيُّ صَاحِبُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا أُصَلِّي الضُّحَى حِينَ طَلَعَتِ الشَّمْسُ ، فَعَابَ ذَلِكَ عَلَيَّ ، وَنَهَانِي ، ثُمَّ         [3/144]      قَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تُصَلُّوا حَتَّى تَرْتَفِعَ الشَّمْسُ  ، فَإِنَّهَا إِنَّمَا تَطْلُعُ فِي  قَرْنِ  شَيْطَانٍ  .","","Musnad Abi Ya'la al-Mawsili 1572","","أبو هبيرة الأنصارى عن سعيد بن نافع الأنصاري عن بكير بن عبد الله بن الأشج القرشي عن مخرمة بن بكير المخزومي عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند أبي هبيرة الأنصاري"
"1573","مُسْنَدُ  سَعْدٍ مَوْلَى أَبِي بَكْرٍ  1 - (  1573  ) -  حَدَّثَنَا  أَبُو مُوسَى مُحَمَّدُ بْنُ الْمُثَنَّى ،  حَدَّثَنَا  أَبُو دَاوُدَ ،  حَدَّثَنَا  أَبُو عَامِرٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَعْدٍ مَوْلَى أَبِي بَكْرٍ الصِّدِّيقِ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  قَالَ         [3/145]      لِأَبِي بَكْرٍ  ، وَكَانَ  سَعْدٌ  مَمْلُوكًا لَهُ ، وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تُعْجِبُهُ خِدْمَتُهُ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَعْتِقْ  سَعْدًا  ، فَقَالَ  أَبُو بَكْرٍ  : يَا رَسُولَ اللهِ ، مَا لَنَا هَاهُنَا غَيْرُهُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَعْتِقْ  سَعْدًا  ، أَتَتْكَ الرِّجَالُ  ، أَتَتْكَ الرِّجَالُ  .","","Musnad Abi Ya'la al-Mawsili 1573","","سعد البصري مولى أبي بكر الصديق عن الحسن البصري عن صالح بن رستم الخزاز عن أبو داود الطيالسي عن أبو موسى الزمن عن أبو يعلى الموصلي","مسند سعد مولى أبي بكر"
"1574","2 - (  1574  ) -  حَدَّثَنَا  أَبُو مُوسَى ،  حَدَّثَنَا  أَبُو دَاوُدَ ،  حَدَّثَنَا  أَبُو عَامِرٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَعْدٍ ، قَالَ :  قَرَّبْتُ بَيْنَ يَدَيْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَمْرًا ، فَجَعَلُوا يَقْرِنُونَ  ، فَنَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الْقِرَانِ  .","","Musnad Abi Ya'la al-Mawsili 1574","","سعد البصري مولى أبي بكر الصديق عن الحسن البصري عن صالح بن رستم الخزاز عن أبو داود الطيالسي عن أبو موسى الزمن عن أبو يعلى الموصلي","مسند سعد مولى أبي بكر"
"1575","3 - (  1575  ) -  حَدَّثَنَا  أَبُو هِشَامٍ ،  حَدَّثَنَا  مُعَاذُ بْنُ هِشَامٍ ،         [3/146]      حَدَّثَنَا  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  دَغْفَلٍ :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تُوُفِّيَ وَهُوَ ابْنُ خَمْسٍ وَسِتِّينَ  .","","Musnad Abi Ya'la al-Mawsili 1575","","دغفل بن حنظلة السدوسي عن الحسن البصري عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند سعد مولى أبي بكر"
"1576","عُبَيْدٌ  مَوْلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  1 - (  1576  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،         [3/147]      عَنْ  عُبَيْدٍ مَوْلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِنَّ امْرَأَتَيْنِ كَانَتَا صَائِمَتَيْنِ ، فَكَانَتَا تَغْتَابَانِ النَّاسَ ، فَدَعَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِقَدَحٍ ، فَقَالَ لَهُمَا : قِيئَا ، فَقَاءَتَا  قَيْحًا  وَدَمًا وَلَحْمًا  عَبِيطًا ،  ثُمَّ قَالَ :  إِنَّ هَاتَيْنِ صَامَتَا عَنِ الْحَلَالِ ، وَأَفْطَرَتَا عَلَى الْحَرَامِ  .","","Musnad Abi Ya'la al-Mawsili 1576","","عبيد بن عبد الغفار مولى رسول الله عن سليمان بن طرخان عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","عبيد مولى رسول الله - صلى الله عليه وسلم"
"1577","[3/148]      أَبُو مَالِكٍ الْأَشْعَرِيُّ  1 - (  1577  ) -  حَدَّثَنَا  هُدْبَةُ ،  حَدَّثَنَا  أَبَانُ بْنُ يَزِيدَ ،  حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ ، أَنَّ زَيْدًا  حَدَّثَهُ  ، أَنَّ أَبَا سَلَّامٍ  حَدَّثَهُ  ، أَنَّ أَبَا مَالِكٍ الْأَشْعَرِيَّ  حَدَّثَهُ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  أَرْبَعٌ فِي أُمَّتِي مِنْ أَمْرِ الْجَاهِلِيَّةِ لَا يَتْرُكُونَهُنَّ  : الْفَخْرُ فِي الْأَحْسَابِ ، وَالطَّعْنُ فِي الْأَنْسَابِ ، وَالِاسْتِسْقَاءُ بِالنُّجُومِ ، وَالنِّيَاحَةُ ، وَقَالَ : النَّائِحَةُ إِذَا لَمْ تَتُبْ قَبْلَ مَوْتِهَا يُقَامُ يَوْمَ الْقِيَامَةِ عَلَيْهَا  سِرْبَالٌ  مِنْ قَطِرَانٍ وَدِرْعٌ مِنْ جَرَبٍ  .","","Musnad Abi Ya'la al-Mawsili 1577","","أبو مالك الأشعري عن ممطور الحبشي عن زيد بن سلام الحبشي عن يحيى بن أبي كثير عن أبان بن يزيد العطار عن هدبة بن خالد عن أبو يعلى الموصلي","أبو مالك الأشعري"
"1578","[3/149]      مُسْنَدُ  الْعَبَّاسِ بْنِ مِرْدَاسٍ السُّلَمِيِّ  1 - (  1578  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  عَبْدُ الْقَاهِرِ بْنُ السَّرِيِّ السُّلَمِيُّ ،  حَدَّثَنِي  ابْنُ كِنَانَةَ بْنُ الْعَبَّاسِ بْنِ مِرْدَاسٍ السُّلَمِيُّ ، أَنَّ أَبَاهُ         [3/150]      حَدَّثَهُ  عَنْ  أَبِيهِ الْعَبَّاسِ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَعَا عَشِيَّةَ  عَرَفَةَ  لِأُمَّتِهِ بِالْمَغْفِرَةِ وَالرَّحْمَةِ وَأَكْثَرَ الدُّعَاءَ ، فَأَجَابَهُ اللهُ أَنِّي قَدْ فَعَلْتُ وَغَفَرْتُ لِأُمَّتِكَ إِلَّا ظُلْمَ بَعْضِهِمْ بَعْضًا ، فَأَعَادَ ، فَقَالَ : يَا رَبِّ ، إِنَّكَ قَادِرٌ أَنْ تَغْفِرَ لِلظَّالِمِ وَتُثِيبَ الْمَظْلُومَ خَيْرًا مِنْ مَظْلَمَتِهِ ، فَلَمْ يَكُنْ تِلْكَ الْعَشِيَّةَ إِلَّا ذَا ، فَلَمَّا كَانَ مِنَ الْغَدِ دَعَا غَدَاةَ  الْمُزْدَلِفَةِ  ، فَعَادَ يَدْعُو لِأُمَّتِهِ ، فَلَمْ يَلْبَثِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ تَبَسَّمَ ، فَقَالَ بَعْضُ أَصْحَابِهِ : يَا رَسُولَ اللهِ بِأَبِي أَنْتَ وَأُمِّي ، تَبَسَّمْتَ فِي سَاعَةٍ لَمْ تَكُنْ تَضْحَكُ فِيهَا ، فَمَا أَضْحَكَكَ ، أَضْحَكَ اللهُ سِنَّكَ ؟ قَالَ :  تَبَسَّمْتُ مِنْ عَدُوِّ اللهِ إِبْلِيسَ حِينَ عَلِمَ أَنَّ اللهَ قَدْ أَجَابَنِي فِي أُمَّتِي ، وَغَفَرَ لِلظَّالِمِ  ، أَهْوَى يَدْعُو  بِالثُّبُورِ  وَالْوَيْلِ وَيَحْثُو التُّرَابَ عَلَى رَأْسِهِ ، وَقَالَ مَرَّةً : فَضَحِكْتُ مِنْ جَزَعِهِ  .","","Musnad Abi Ya'la al-Mawsili 1578","","عباس بن مرداس السلمي عن كنانة بن عباس بن مرداس السلمي عن عبد الله بن كنانة السلمي عن عبد القاهر بن السري السلمي عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند العباس بن مرداس السلمي"
"1579","2 - (  1579  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  حَدَّثَنَا  أَبُو بَكْرٍ الْحَنَفِيُّ ،  حَدَّثَنَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي الْحُوَيْرِثِ ،  أَنَّهُ سَمِعَ  الْحَكَمَ بْنَ مِينَاءَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ  لِعُمَرَ  : اجْمَعْ         [3/151]      لِي مَنْ هَاهُنَا مِنْ  قُرَيْشٍ  ، فَجَمَعَهُمْ ، ثُمَّ قَالَ : يَا رَسُولَ اللهِ ، أَتَخْرُجُ إِلَيْهِمْ أَمْ يَدْخُلُونَ ؟ قَالَ : بَلْ أَخْرُجُ إِلَيْهِمْ ، فَخَرَجَ ، فَقَالَ : يَا مَعْشَرَ  قُرَيْشٍ  هَلْ فِيكُمْ غَيْرُكُمْ ، قَالُوا : لَا ، إِلَّا بَنُو أَخَوَاتِنَا ، قَالَ : ابْنُ أُخْتِ  الْقَوْمِ  مِنْهُمْ ، ثُمَّ قَالَ :  يَا مَعْشَرَ  قُرَيْشٍ  ، اعْلَمُوا أَنَّ أَوْلَى النَّاسِ بِالنَّبِيِّ الْمُتَّقُونَ  ، فَانْظُرُوا ، لَا يَأْتِي النَّاسُ بِالْأَعْمَالِ يَوْمَ الْقِيَامَةِ وَتَأْتُونَ بِالدُّنْيَا تَحْمِلُونَهَا ،  فَأَصُدَّ  عَنْكُمْ بِوَجْهِي ، ثُمَّ قَرَأَ :         {      إِنَّ أَوْلَى النَّاسِ بِإِبْرَاهِيمَ لَلَّذِينَ اتَّبَعُوهُ وَهَذَا النَّبِيُّ وَالَّذِينَ آمَنُوا وَاللهُ وَلِيُّ الْمُؤْمِنِينَ         }      .","","Musnad Abi Ya'la al-Mawsili 1579","","الحكم بن ميناء الأنصاري عن عبد الرحمن بن معاوية النوفلي عن سعيد المقبري عن عبد الحميد بن جعفر الأوسي عن عبد الكبير بن عبد المجيد الحنفي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند العباس بن مرداس السلمي"
"1580","[3/152]      مُسْنَدُ  عُمَيْرِ بْنِ سَعْدٍ  1 - (  1580  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي سِنَانٍ ،  عَنْ  أَبِي طَلْحَةَ الْخَوْلَانِيِّ ، قَالَ :  أَتَيْنَا عُمَيْرَ بْنَ سَعْدٍ فِي نَفَرٍ مِنْ  أَهْلِ فِلَسْطِينَ  ، وَكَانَ يُقَالُ :  نَسِيجُ  وَحْدِهِ  ، فَقَعَدْنَا عَلَى  دُكَّانٍ  لَهُ عَظِيمٍ فِي دَارِهِ ، فَقَالَ لِغُلَامِهِ : يَا غُلَامُ ، أَوْرِدِ الْخَيْلَ ، قَالَ : وَفِي الدَّارِ  تَوْرٌ  مِنْ حِجَارَةٍ ، قَالَ : فَأَوْرَدَهَا ، فَقَالَ : أَيْنَ فُلَانَةُ ؟ قَالَ : هِيَ جَرِبَةٌ  تَقْطُرُ دَمًا ، أَوْ قَالَ : تَقْطُرُ مَاءً  ،  شَكَّ  أَبُو إِسْحَاقَ  ، قَالَ : أَوْرِدْهَا ، فَقَالَ أَحَدُ  الْقَوْمِ  : إِذًا تَجْرَبُ الْخَيْلُ كُلُّهَا ، قَالَ : أَوْرِدْهَا ، فَإِنِّي سَمِعْتُ         [3/153]      رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا  عَدْوَى  ، وَلَا  طِيَرَةَ ،  وَلَا  هَامَةَ  ، أَلَمْ تَرَ إِلَى الْبَعِيرِ مِنَ الْإِبِلِ كَيْفَ يَكُونُ بِالصَّحْرَاءِ ، ثُمَّ يُصْبِحُ فِي  كِرْكِرَتِهِ  أَوْ فِي مَرَاقِّهِ  نُكْتَةٌ  لَمْ تَكُنْ قَبْلَ ذَلِكَ ، فَمَنْ  أَعْدَى  الْأَوَّلَ  ؟ .","","Musnad Abi Ya'la al-Mawsili 1580","","عمير بن سعد بن شهيد الأوسي عن أبو طلحة  الخولاني عن عيسى بن سنان القسملي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عمير بن سعد"
"1581","مُسْنَدُ  الْحَارِثِ بْنِ وُقَيْشٍ  1 - (  1581  ) -  حَدَّثَنَا  صَالِحُ بْنُ حَاتِمِ بْنِ وَرْدَانَ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ قَيْسٍ ،         [3/154]      عَنِ  الْحَارِثِ بْنِ وُقَيْشٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْ مُسْلِمَيْنِ يَمُوتُ بَيْنَهُمَا أَرْبَعَةٌ إِلَّا أَدْخَلَهُمَا اللهُ الْجَنَّةَ بِفَضْلِ رَحْمَتِهِ  ، قَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، وَثَلَاثَةٌ ؟ قَالَ : وَثَلَاثَةٌ ، قَالَ : وَاثْنَانِ ؟ قَالَ : وَاثْنَانِ ، قَالَ : وَإِنَّ مِنْ أُمَّتِي مَنْ يَدْخُلُ بِشَفَاعَتِهِ أَكْثَرُ مِنْ  مُضَرَ  .","","Musnad Abi Ya'la al-Mawsili 1581","","الحارث بن أقيش العكلي عن عبد الله بن قيس النخعي عن داود بن أبي هند عن يزيد بن زريع العيشي عن صالح بن حاتم بن وردان البصري عن أبو يعلى الموصلي","مسند الحارث بن وقيش"
"1582","[3/155]      حَبَّةُ بْنُ حَابِسٍ التَّمِيمِيُّ  1 - (  1582  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ،  قَالَ : حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  حَرْبٌ ،  حَدَّثَنِي  يَحْيَى ، قَالَ :  حَدَّثَنِي  حَبَّةُ بْنُ حَابِسٍ التَّمِيمِيُّ ، أَنَّ أَبَاهُ  أَخْبَرَهُ  ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا شَيْءَ فِي الْهَامِ  ، وَالْعَيْنُ حَقٌّ ، وَأَصْدَقُ الطَّيَرِ  الْفَأْلُ  .","","Musnad Abi Ya'la al-Mawsili 1582","","حابس بن سعد التميمي عن حية بن حابس التميمي عن يحيى بن أبي كثير عن حرب بن شداد اليشكري عن عبد الصمد بن عبد الوارث التنوري عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","حبة بن حابس التميمي"
"1583","[3/156]      الْفَلَتَانُ بْنُ عَاصِمٍ  1 - (  1583  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  حَدَّثَنَا  عَاصِمُ بْنُ كُلَيْبٍ ، يَعْنِي         [3/157]      عَنِ  الْفَلَتَانِ بْنِ عَاصِمٍ ، قَالَ :  كُنَّا عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَأُنْزِلَ عَلَيْهِ ، وَكَانَ إِذَا أُنْزِلَ عَلَيْهِ دَامَ بَصَرُهُ مَفْتُوحَةً عَيْنَاهُ  ، وَفَرَغَ سَمْعُهُ وَقَلْبُهُ لِمَا يَأْتِيهِ مِنَ اللهِ ، قَالَ : فَكُنَّا نَعْرِفُ ذَلِكَ مِنْهُ ، فَقَالَ لِلْكَاتِبِ : اكْتُبْ :         {      لا يَسْتَوِي الْقَاعِدُونَ مِنَ الْمُؤْمِنِينَ             *          وَالْمُجَاهِدُونَ فِي سَبِيلِ اللهِ         }      قَالَ : فَقَامَ الْأَعْمَى ، فَقَالَ : يَا رَسُولَ اللهِ ، مَا ذَنْبُنَا ؟ فَأَنْزَلَ اللهُ ، فَقُلْنَا لِلْأَعْمَى : إِنَّهُ يُنَزَّلُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَخَافَ أَنْ يَكُونَ يُنَزَّلُ عَلَيْهِ شَيْءٌ مِنْ أَمْرِهِ ، فَبَقِيَ قَائِمًا يَقُولُ : أَعُوذُ بِغَضَبِ رَسُولِ اللهِ ، قَالَ : فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِلْكَاتِبِ : اكْتُبْ :         {      غَيْرُ أُولِي الضَّرَرِ         }      .","","Musnad Abi Ya'la al-Mawsili 1583","","الفلتان بن عاصم الجرمي عن عاصم بن كليب الجرمي عن عبد الواحد بن زياد عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","الفلتان بن عاصم"
"1584","[3/158]      مُسْنَدُ  مَعْنِ بْنِ نَضْلَةَ  1 - (  1584  ) -  حَدَّثَنَا  أَبُو مُوسَى إِسْحَاقُ بْنُ مُوسَى الْأَنْصَارِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْنٍ ،  حَدَّثَنِي  جَدِّي مُحَمَّدُ بْنُ مَعْنٍ ،  عَنْ  أَبِيهِ مَعْنِ بْنِ نَضْلَةَ  ،  أَنَّ  نَضْلَةَ لَقِيَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمُرِّينَ  ، وَمَعَهُ  شَوَائِلُ  لَهُ ،         [3/159]      فَحَلَبَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي إِنَاءٍ ، فَشَرِبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، ثُمَّ شَرِبَ مِنْ إِنَاءٍ وَاحِدٍ ، ثُمَّ قَالَ : يَا رَسُولَ اللهِ ، وَالَّذِي بَعَثَكَ بِالْحَقِّ ، إِنْ كُنْتُ لَأَشْرَبُ سَبْعَةً ، فَمَا أَشْبَعُ ، وَمَا أَمْتَلِئُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الْمُؤْمِنَ يَشْرَبُ فِي  مِعًى  وَاحِدٍ  ، وَإِنَّ الْكَافِرَ يَشْرَبُ فِي سَبْعَةِ أَمْعَاءٍ  .         [3/160]","","Musnad Abi Ya'la al-Mawsili 1584","","نضلة بن عمرو بن أهبان الغفاري عن معن بن نضلة عن محمد بن معن بن نضلة الغفاري عن محمد بن معن بن محمد الغفاري عن إسحاق بن موسى الخطمي عن أبو يعلى الموصلي","مسند معن بن نضلة"
"1585","2 - (  1585  ) -  أَخْبَرَنَا  أَبُو يَعْلَى ،  حَدَّثَنَاهُ  ابْنُ الْمَدِينِيِّ  بِإِسْنَادِهِ  نَحْوَهُ .","","Musnad Abi Ya'la al-Mawsili 1585","","نضلة بن عمرو بن أهبان الغفاري عن معن بن نضلة عن محمد بن معن بن نضلة الغفاري عن محمد بن معن بن محمد الغفاري عن علي ابن المديني عن أبو يعلى الموصلي","مسند معن بن نضلة"
"1586","مُسْنَدُ  وَابِصَةَ بْنِ مَعْبَدٍ  1 - (  1586  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي عَبْدِ السَّلَامِ ،  عَنْ  أَيُّوبَ بْنِ عَبْدِ اللهِ بْنِ مِكْرَزٍ ،         [3/161]      عَنْ  وَابِصَةَ بْنِ مَعْبَدٍ الْأَسَدِيِّ ، قَالَ :  أَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَأَنَا أُرِيدُ أَنْ لَا أَدَعَ شَيْئًا مِنَ  الْبِرِّ  وَالْإِثْمِ إِلَّا سَأَلْتُهُ ، فَأَتَيْتُهُ فِي عِصَابَةٍ مِنَ النَّاسِ يَسْتَفْتُونَهُ ، فَجَعَلْتُ  أَتَخَطَّاهُمْ  ، فَقَالُوا : إِلَيْكَ يَا  وَابِصَةُ  عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقُلْتُ : دَعُونِي أَدْنُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَإِنَّهُ أَحَبُّ النَّاسِ إِلَيَّ أَنْ أَدْنُوَ مِنْهُ ، قَالَ :  دَعُوا  وَابِصَةَ  ، ادْنُ يَا  وَابِصَةُ  ، اسْتَفْتِ قَلْبَكَ ، وَاسْتَفْتِ نَفْسَكَ ، اسْتَفْتِ قَلْبَكَ ، وَاسْتَفْتِ نَفْسَكَ ،  الْبِرُّ  مَا اطْمَأَنَّتْ إِلَيْهِ النَّفْسُ ، وَاطْمَأَنَّ إِلَيْهِ الْقَلْبُ ، وَالْإِثْمُ مَا حَاكَ فِي النَّفْسِ ، وَتَرَدَّدَ فِي الصَّدْرِ ، وَإِنْ  أَفْتَاكَ  النَّاسُ وَأَفْتَوْكَ ، ثَلَاثًا  .         [3/162]","","Musnad Abi Ya'la al-Mawsili 1586","","وابصة بن معبد بن عتبة الأسدي عن أيوب بن عبد الله بن مكرز العامري عن الزبير بن جواتشير البصري عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند وابصة بن معبد"
"1587","2 - (  1587  ) -  حَدَّثَنَا  عَلِيُّ بْنُ حَمْزَةَ الْمِعْوَلِيُّ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الزُّبَيْرِ أَبِي عَبْدِ السَّلَامِ ،  عَنْ  أَيُّوبَ بْنِ عَبْدِ اللهِ ،  عَنْ  وَابِصَةَ الْأَسَدِيِّ ، قَالَ :  أَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَأَنَا أُرِيدُ أَنْ لَا أَدَعَ شَيْئًا مِنَ  الْبِرِّ  وَالْإِثْمِ إِلَّا سَأَلْتُهُ عَنْهُ ، فَأَتَيْتُهُ وَحَوْلَهُ عِصَابَةٌ مِنَ الْمُسْلِمِينَ يَسْتَفْتُونَهُ ، فَجَعَلْتُ  أَتَخَطَّاهُمْ  إِلَيْهِ ، فَقَالُوا : إِلَيْكَ يَا  وَابِصَةُ  ، فَقُلْتُ لَهُمْ : دَعُونِي أَدْنُ مِنْهُ ، فَإِنَّهُ أَحَبُّ النَّاسِ إِلَيَّ أَنْ أَدْنُوَ مِنْهُ ، فَقَالَ :  دَعُوا  وَابِصَةَ  ، ادْنُ يَا  وَابِصَةُ  ، ادْنُ يَا  وَابِصَةُ  ، فَدَنَوْتُ ، فَجَلَسْتُ بَيْنَ يَدَيْهِ ، فَقَالَ لِي : يَا  وَابِصَةُ  ، أَتَسْأَلُنِي أَوْ أُخْبِرُكَ ؟ قُلْتُ : بَلْ أَخْبِرْنِي يَا رَسُولَ اللهِ ، قَالَ : جِئْتَ تَسْأَلُنِي عَنِ  الْبِرِّ  وَالْإِثْمِ ؟ قُلْتُ : نَعَمْ ، فَجَمَعَ أَنَامِلَهُ ، ثُمَّ جَعَلَ يَنْكُتُ بِهِنَّ فِي صَدْرِي ، وَيَقُولُ : يَا  وَابِصَةُ  ، اسْتَفْتِ قَلْبَكَ ، وَاسْتَفْتِ نَفْسَكَ ، اسْتَفْتِ قَلْبَكَ ، وَاسْتَفْتِ نَفْسَكَ ،  الْبِرُّ  مَا اطْمَأَنَّتْ إِلَيْهِ النَّفْسُ ، وَالْإِثْمُ مَا  حَاكَ  فِي الصَّدْرِ ، وَإِنْ  أَفْتَاكَ  النَّاسُ ،  وَأَفْتَوْكَ  ثَلَاثَ مَرَّاتٍ  .","","Musnad Abi Ya'la al-Mawsili 1587","","وابصة بن معبد بن عتبة الأسدي عن أيوب بن عبد الله بن مكرز العامري عن الزبير بن جواتشير البصري عن حماد بن سلمة عن علي بن حمزة المعولي عن أبو يعلى الموصلي","مسند وابصة بن معبد"
"1588","3 - (  1588  ) -  حَدَّثَنَا  أَبُو عُبَيْدَةَ بْنُ فُضَيْلِ بْنِ عِيَاضٍ ،  حَدَّثَنَا  مَالِكُ بْنُ سُعَيْرٍ ،  حَدَّثَنَا  السَّرِيُّ بْنُ إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  وَابِصَةَ بْنِ مَعْبَدٍ ، قَالَ :  انْصَرَفَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَرَجُلٌ  يُصَلِّي خَلْفَ  الْقَوْمِ  ، فَقَالَ :  أَيُّهَا الْمُصَلِّي وَحْدَهُ ، أَلَا تَكُونُ وَصَلْتَهُ         [3/163]      صَفًّا ، فَدَخَلْتَ مَعَهُمْ  ، أَوِ اجْتَرَرْتَ رَجُلًا إِلَيْكَ أَنْ ضَاقَ بِكُمُ الْمَكَانُ ؟ أَعِدْ صَلَاتَكَ ، فَإِنَّهُ لَا صَلَاةَ لَكَ  .","","Musnad Abi Ya'la al-Mawsili 1588","","وابصة بن معبد بن عتبة الأسدي عن الشعبي عن السري بن إسماعيل الهمداني عن مالك بن سعير التميمي عن أبو عبيدة بن الفضيل بن عياض عن أبو يعلى الموصلي","مسند وابصة بن معبد"
"1589","4 - (  1589  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  عَمْرُو بْنُ عُثْمَانَ الْكِلَابِيُّ الرَّقِّيُّ ،  حَدَّثَنَا  أَصْبُغُ بْنُ مُحَمَّدٍ ،  عَنْ  جَعْفَرِ بْنِ بُرْقَانَ ،  عَنْ  شَدَّادٍ مَوْلَى عِيَاضٍ ،  عَنْ  وَابِصَةَ ، قَالَ  أَبُو عُثْمَانَ عَمْرٌو : يَعْنِي ابْنَ مَعْبَدٍ  إِنْ شَاءَ اللهُ ،  أَنَّهُ كَانَ يَقُومُ فِي النَّاسِ  يَوْمَ الْأَضْحَى ، أَوْ يَوْمَ الْفِطْرِ  ، فَيَقُولُ : إِنِّي شَهِدْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  حَجَّةِ الْوَدَاعِ  ، وَهُوَ يَقُولُ : أَيُّ يَوْمٍ هَذَا ؟ قَالَ النَّاسُ : يَوْمَ النَّحْرِ ، قَالَ : فَأَيُّ شَهْرٍ هَذَا ؟ ثُمَّ قَالَ : أَيُّ بَلَدٍ هَذَا ؟ قَالُوا : هَذِهِ الْبَلْدَةُ ، قَالَ :  فَإِنَّ دِمَاءَكُمْ         [3/164]      وَأَمْوَالَكُمْ  وَأَعْرَاضَكُمْ  حَرَامٌ عَلَيْكُمْ ،  كَحُرْمَةِ  يَوْمِكُمْ هَذَا  ، فِي شَهْرِكُمْ هَذَا ، فِي بَلَدِكُمْ هَذَا إِلَى يَوْمِ تَلْقَوْنَهُ ، ثُمَّ قَالَ : اللَّهُمَّ هَلْ بَلَّغْتُ ؟ يُبَلِّغُ الشَّاهِدُ الْغَائِبَ .  قَالَ وَابِصَةُ : نُشْهِدُ عَلَيْكُمْ كَمَا أَشْهَدَ عَلَيْنَا  .","","Musnad Abi Ya'la al-Mawsili 1589","","وابصة بن معبد بن عتبة الأسدي عن شداد الجزري عن جعفر بن برقان الكلابي عن أصبغ بن محمد عن عمرو بن عثمان بن سيار الرقي عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند وابصة بن معبد"
"1590","5 - (  1590  ) -  قَالَ  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ :  حَدَّثَنَا  أَبُو سَلَمَةَ الْخُزَاعِيُّ ،  أَنَّ  جَعْفَرَ بْنَ بُرْقَانَ  حَدَّثَهُمْ  فِي هَذَا الْحَدِيثِ ،  أَنَّ  سَالِمَ بْنَ وَابِصَةَ ، صَلَّى بِهِمْ  بِالرَّقَّةِ  وَذَكَرَ حَدِيثَ  وَابِصَةَ  هَذَا ،  وَقَالَ  وَابِصَةُ  :  نُشْهِدُ عَلَيْكُمْ كَمَا أَشْهَدَ عَلَيْنَا  ، فَأَوْعَيْتُمْ وَنَحْنُ نُبَلِّغُكُمْ  .","","Musnad Abi Ya'la al-Mawsili 1590","","وابصة بن معبد بن عتبة الأسدي عن سالم بن وابصة بن معبد الأسدي عن جعفر بن برقان الكلابي عن منصور بن سلمة بن عبد العزيز عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند وابصة بن معبد"
"1591","6 - (  1591  ) -  حَدَّثَنَا  أَبُو عَلِيٍّ أَحْمَدُ بْنُ إِبْرَاهِيمَ الْمَوْصِلِيُّ ،  حَدَّثَنَا  أَبُو فَضَالَةَ فَرَجُ بْنُ فَضَالَةَ ،  عَنْ  عَبْدِ الْخَبِيرِ بْنِ قَيْسِ بْنِ ثَابِتِ بْنِ شَمَّاسٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ :  قُتِلَ  يَوْمَ قُرَيْظَةَ  رَجُلٌ مِنَ الْأَنْصَارِ  يُدْعَى         [3/165]      خَلَّادًا  ، فَقِيلَ لِأُمِّهِ : يَا  أُمَّ خَلَّادٍ  ، قُتِلَ  خَلَّادٌ  ، فَجَاءَتْ وَهِيَ مُتَنَقِّبَةٌ ، فَقِيلَ لَهَا : قُتِلَ  خَلَّادٌ  ، وَتَجِيئِينَنَا مُتَنَقِّبَةً ؟ قَالَتْ : إِنْ رُزِئْتُ  خَلَّادًا  ، فَلَا  أُرْزَأُ  حَيَائِي ، فَذَكَرُوا ذَلِكَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ :  أَمَا إِنَّ لَهُ أَجْرَ شَهِيدَيْنِ  ، قِيلَ : يَا رَسُولَ اللهِ ، وَبِمَ ؟ قَالَ : لِأَنَّ أَهْلَ الْكِتَابِ قَتَلُوهُ  .","","Musnad Abi Ya'la al-Mawsili 1591","","ثابت بن قيس الخزرجي خطيب رسول الله عن قيس بن ثابت بن قيس الخزرجي عن عبد الخبير بن قيس الخزرجي عن فرج بن فضالة بن النعمان التنوخي عن أحمد بن إبراهيم بن خالد عن أبو يعلى الموصلي","مسند وابصة بن معبد"
"1592","مُسْنَدُ  سَفِينَةَ  ( رَجُلٌ )  1 - (  1592  ) -  حَدَّثَنَا  زَحْمَوَيْهِ  حَدَّثَنَا  صَالِحٌ  حَدَّثَنَا  حَاجِبٌ يَعْنِي ابْنَ عُمَرَ قَالَ :  دَخَلْتُ مَعَ  الْحَكَمِ الْأَعْرَجِ  عَلَى بَكْرِ بْنِ عَبْدِ اللهِ ، فَتَذَكَّرُوا أَمْرَ الْمَيِّتِ يُعَذَّبُ بِبُكَاءِ الْحَيِّ  فَحَدَّثَنَا  بَكْرٌ قَالَ :  حَدَّثَنَا  رَجُلٌ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَانَ  أَبُو هُرَيْرَةَ  خَالَفَهُ فِي ذَلِكَ فَقَالَ :  قَالَ  أَبُو هُرَيْرَةَ :  وَاللهِ لَئِنِ انْطَلَقَ رَجُلٌ مُحَارِبًا فِي  سَبِيلِ  اللهِ ، ثُمَّ قُتِلَ فِي  قُطْرٍ  مِنْ أَقْطَارِ الْأَرْضِ  شَهِيدًا  فَعَمَدَتِ         [3/166]      امْرَأَةٌ سَفَهًا أَوْ جَهْلًا فَبَكَتْ عَلَيْهِ ، لَيُعَذَّبَنَّ هَذَا الشَّهِيدُ بِبُكَاءِ هَذِهِ السَّفِيهَةِ عَلَيْهِ ، فَقَالَ رَجُلٌ : صَدَقَ رَسُولُ اللهِ وَكَذَبَ  أَبُو هُرَيْرَةَ  ، صَدَقَ رَسُولُ اللهِ وَكَذَبَ  أَبُو هُرَيْرَةَ  .","","Musnad Abi Ya'la al-Mawsili 1592","","أبو هريرة الدوسي عن بكر بن عبد الله المزني عن حاجب بن عمر الثقفي عن صالح بن عمر الواسطي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند سفينة ( رجل"
"1593","رَجُلٌ  1 - (  1593  ) -  حَدَّثَنَا  زَحْمَوَيْهِ ،  حَدَّثَنَا  صَالِحٌ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  بَعْضِ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  يَا رَسُولَ اللهِ ، عَلِّمْنِي عَمَلًا يُدْخِلُنِي الْجَنَّةَ ، وَلَا تُكْثِرْ عَلَيَّ ، قَالَ :  لَا تَغْضَبْ  .","","Musnad Abi Ya'la al-Mawsili 1593","","أحد الصحابة عن ذكوان السمان عن الأعمش عن صالح بن عمر الواسطي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","رجل"
"1594","[3/167]      رَجُلٌ عَنْ أَبِيهِ  1 - (  1594  ) -  حَدَّثَنَا  زَحْمَوَيْهِ ،  حَدَّثَنَا  صَالِحٌ ،  حَدَّثَنَا  أَبُو جَنَابٍ يَحْيَى بْنُ أَبِي حَيَّةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  رَجُلٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ : إِنَّ أَخِي وَجِعٌ ، فَقَالَ :  مَا وَجَعُ أَخِيكَ  ؟ قَالَ : بِهِ  لَمَمٌ  ، قَالَ : فَابْعَثْ إِلَيَّ بِهِ ، قَالَ : فَجَاءَهُ ، فَجَلَسَ بَيْنَ يَدَيْهِ ، قَالَ : فَقَرَأَ عَلَيْهِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاتِحَةَ الْكِتَابِ ، وَأَرْبَعَ آيَاتٍ مِنْ أَوَّلِ سُورَةِ الْبَقَرَةِ ، وَآيَتَيْنِ مِنْ         [3/168]      وَسَطِهَا :         {      وَإِلَهُكُمْ إِلَهٌ وَاحِدٌ لا إِلَهَ إِلا هُوَ الرَّحْمَنُ الرَّحِيمُ             *          إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالأَرْضِ         }      حَتَّى فَرَغَ مِنَ الْآيَةِ ، وَآيَةَ الْكُرْسِيِّ ، وَثَلَاثَ آيَاتٍ مِنْ آخِرِ سُورَةِ الْبَقَرَةِ ، وَآيَةً مِنْ أَوَّلِ سُورَةِ آلِ عِمْرَانَ         {      شَهِدَ اللهُ أَنَّهُ لا إِلَهَ إِلا هُوَ وَالْمَلائِكَةُ وَأُولُو الْعِلْمِ قَائِمًا بِالْقِسْطِ         }      إِلَى آخِرِ الْآيَةِ ، وَآيَةً مِنْ سُورَةِ الْأَعْرَافِ :         {      إِنَّ رَبَّكُمُ اللهُ الَّذِي خَلَقَ السَّمَاوَاتِ وَالأَرْضَ         }      ، وَآيَةً مِنْ سُورَةِ الْمُؤْمِنِينَ :         {      فَتَعَالَى اللهُ الْمَلِكُ الْحَقُّ لا إِلَهَ إِلا هُوَ رَبُّ الْعَرْشِ الْكَرِيمِ         }      ، وَآيَةً مِنْ سُورَةِ الْجِنِّ :         {      وَأَنَّهُ تَعَالَى جَدُّ رَبِّنَا مَا اتَّخَذَ صَاحِبَةً وَلا وَلَدًا         }      ، وَعَشْرَ آيَاتٍ مِنْ سُورَةِ الصَّفِّ مِنْ أَوَّلِهَا ، وَثَلَاثَ آيَاتٍ مِنْ آخِرِ سُورَةِ الْحَشْرِ ، وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      ، وَالْمُعَوِّذَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 1594","","أبو ليلى الأيسر الأنصاري عن رجل عن عبد الرحمن بن أبي ليلى عن يحيى بن أبي حية عن صالح بن عمر الواسطي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","رجل عن أبيه"
"1595","2 - (  1595  ) -  حَدَّثَنَا  زَحْمَوَيْهِ ،  حَدَّثَنَا  ابْنُ أَبِي الزِّنَادِ ،  عَنْ  يَحْيَى بْنِ سَعِيدِ بْنِ دِينَارٍ مَوْلَى آلِ الزُّبَيْرِ ،  أَخْبَرَنِي  الثِّقَةُ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى  يَوْمَ  خَيْبَرَ  أَنْ يُوقَعَ عَلَى الْحَبَالَى  ، وَقَالَ : تَسْقِي زَرْعَ غَيْرِكَ ؟  .","","Musnad Abi Ya'la al-Mawsili 1595","","الثقة عن يحيى بن سعيد بن دينار مولى آل الزبير عن عبد الرحمن بن أبي الزناد عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","رجل عن أبيه"
"1596","[3/169]      فَرْوَةُ بْنُ نَوْفَلٍ الْأَشْجَعِيُّ  1 - (  1596  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  فَرْوَةَ بْنِ نَوْفَلٍ ، قَالَ :  أَتَيْتُ  الْمَدِينَةَ  ، فَقَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَا جَاءَ بِكَ ؟ قَالَ : قُلْتُ : لِتُعَلِّمَنِي كَلِمَاتٍ إِذَا أَخَذْتُ مَضْجَعِي ، قَالَ :  اقْرَأْ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      فَإِنَّهَا بَرَاءَةٌ مِنَ  الشِّرْكِ  .","","Musnad Abi Ya'la al-Mawsili 1596","","فروة بن نوفل الأشجعي عن أبو إسحاق السبيعي عن عبد العزيز بن مسلم الخراساني عن عبد الواحد بن غياث عن أبو يعلى الموصلي","فروة بن نوفل الأشجعي"
"1597","[3/170]      رَسُولُ  قَيْصَرَ  1 - (  1597  ) -  حَدَّثَنَا  حَوْثَرَةُ بْنُ أَشْرَسَ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُثْمَانَ بْنِ خُثَيْمٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي رَاشِدٍ ، قَالَ :  كَانَ رَسُولُ قَيْصَرَ جَارًا لِي زَمَنَ  يَزِيدَ بْنِ مُعَاوِيَةَ  ، فَقُلْتُ لَهُ :         [3/171]      أَخْبِرْنِي  عَنْ كِتَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى  قَيْصَرَ  ، فَقَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَرْسَلَ  دِحْيَةَ الْكَلْبِيَّ  إِلَى  قَيْصَرَ  ، وَكَتَبَ مَعَهُ إِلَيْهِ كِتَابًا يُخَيِّرُهُ بَيْنَ إِحْدَى ثَلَاثٍ : إِمَّا أَنْ يُسْلِمَ وَلَهُ مَا فِي يَدَيْهِ مِنْ مُلْكِهِ ، وَإِمَّا أَنْ يُؤَدِّيَ الْخَرَاجَ ، وَإِمَّا أَنْ يَأْذَنَ بِحَرْبٍ .  قَالَ : فَجَمَعَ  قَيْصَرُ  بَطَارِقَتَهُ  وَقِسِّيِسِيهِ فِي قَصْرِهِ ، وَأَغْلَقَ عَلَيْهِمُ الْبَابَ ، وَقَالَ : إِنَّ  مُحَمَّدًا  كَتَبَ إِلَيَّ يُخَيِّرُنِي بَيْنَ إِحْدَى ثَلَاثٍ : إِمَّا أَنْ أُسْلِمَ وَلِي مَا فِي يَدِي مِنْ مُلْكِي ، وَإِمَّا أَنْ أُؤَدِّيَ الْخَرَاجَ ، وَإِمَّا أَنْ آذَنَ بِحَرْبٍ ، وَقَدْ تَجِدُونَ فِيمَا تَقَرْءُونَ مِنْ كُتُبِكُمْ أَنَّهُ سَيَمْلِكُ مَا تَحْتَ قَدَمَيَّ مِنْ مُلْكِي ،  فَنَخَرُوا  نَخْرَةً حَتَّى إِنَّ بَعْضَهُمْ خَرَجُوا مِنْ بَرَانِسِهِمْ ، وَقَالُوا : تُرْسِلُ إِلَى رَجُلٍ مِنَ الْعَرَبِ ، جَاءَ فِي بُرْدَيْهِ وَنَعْلَيْهِ بِالْخَرَاجِ ؟ فَقَالَ : اسْكُتُوا إِنَّمَا أَرَدْتُ أَنْ أَعْلَمَ تَمَسُّكَكُمْ بِدِينِكُمْ وَرَغْبَتَكُمْ فِيهِ ، ثُمَّ قَالَ : ابْتَغُوا لِي رَجُلًا مِنَ الْعَرَبِ ، فَجَاءُوا بِي ، فَكَتَبَ مَعِي إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كِتَابًا ، وَقَالَ لِي : انْظُرْ مَا سَقَطَ عَنْكَ مِنْ قَوْلِهِ ، فَلَا يَسْقُطْ عِنْدَ ذِكْرِ اللَّيْلِ وَالنَّهَارِ ، فَأَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ مَعَ أَصْحَابِهِ ، وَهُمْ مُحْتَبُونَ بِحَمَائِلِ سُيُوفِهِمْ حَوْلَ  بِئْرِ تَبُوكَ  ، فَقُلْتُ : أَيُّكُمْ  مُحَمَّدٌ  ؟ فَأَوْمَأَ بِيَدِهِ إِلَى نَفْسِهِ ، فَدَفَعْتُ إِلَيْهِ الْكِتَابَ ، فَدَفَعَهُ إِلَى  رَجُلٍ  إِلَى جَنْبِهِ ، فَقُلْتُ : مَنْ هَذَا ؟ فَقَالُوا :  مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ  ، فَقَرَأَهُ فَإِذَا فِيهِ : كَتَبْتَ تَدْعُونِي إِلَى جَنَّةٍ عَرْضُهَا السَّمَاوَاتُ وَالْأَرْضُ ، فَأَيْنَ النَّارُ إِذًا ؟         [3/172]      فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : يَا سُبْحَانَ اللهِ ، إِذَا جَاءَ اللَّيْلُ فَأَيْنَ النَّهَارُ ؟ فَكَتَبْتُهُ عَنْدِي ، ثُمَّ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنَّكَ رَسُولُ قَوْمٍ ، فَإِنَّ لَكَ حَقًّا ، وَلَكِنْ جِئْتَنَا وَنَحْنُ مُرْمِلُونَ ، قَالَ  عُثْمَانُ  : أَكْسُوهُ  حُلَّةً  صَفُورِيَّةً ، فَقَالَ  رَجُلٌ مِنَ الْأَنْصَارِ  : عَلَيَّ ضِيَافَتُهُ .  وَقَالَ لِي  قَيْصَرُ  فِيمَا قَالَ : انْظُرْ إِلَى ظَهْرِهِ ، فَرَأَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنِّي أُرِيدُ النَّظَرَ إِلَى ظَهْرِهِ ، فَأَلْقَى ثَوْبَهُ عَنْ ظَهْرِهِ ، فَنَظَرْتُ إِلَى الْخَاتَمِ فِي نُغَصِ الْكَتِفِ ، فَأَقْبَلْتُ عَلَيْهِ أُقَبِّلُهُ ، ثُمَّ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنِّي كَتَبْتُ إِلَى  النَّجَاشِيِّ  فَأَحْرَقَ كِتَابِي ، وَاللهُ مُحْرِقُهُ ، وَكَتَبْتُ إِلَى  كِسْرَى  عَظِيمِ  فَارِسَ  ، فَمَزَّقَ كِتَابِي ، وَاللهُ مُمَزِّقُهُ ، وَكَتَبْتُ إِلَى  قَيْصَرَ  فَرَفَعَ كِتَابِي ، فَلَا يَزَالُ النَّاسُ - ذَكَرَ كَلِمَةً - مَا كَانَ فِي الْعَيْشِ خَيْرٌ  .","","Musnad Abi Ya'la al-Mawsili 1597","","التنوخي رسول هرقل عن سعيد بن أبي راشد السماك عن عبد الله بن عثمان بن خثيم عن حماد بن سلمة عن حوثرة بن أشرس بن عومر العدوي عن أبو يعلى الموصلي","رسول قيصر"
"1598","[3/173]      عُرْوَةُ بْنُ مَسْعُودٍ  1 - (  1598  ) -  حَدَّثَنَا  حَوْثَرَةُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدِ بْنِ جُدْعَانَ ،  أَنَّ  عُرْوَةَ بْنَ مَسْعُودٍ الثَّقَفِيَّ قَالَ لِقَوْمِهِ  زَمَنَ الْحُدَيْبِيَةِ  : أَيْ قَوْمِ ، إِنِّي قَدْ رَأَيْتُ الْمُلُوكَ وَكَلَّمْتُهُمْ ، فَابْعَثُونِي إِلَى  مُحَمَّدٍ  فَأُكَلِّمَهُ ، فَأَتَاهُ  بِالْحُدَيْبِيَةِ  ، فَجَعَلَ  عُرْوَةُ  يُكَلِّمُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَيَتَنَاوَلُ لِحْيَةَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  وَالْمُغِيرَةُ بْنُ شُعْبَةَ  شَاكٍ فِي السِّلَاحِ عَلَى رَأْسِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ لَهُ  الْمُغِيرَةُ  : كُفَّ يَدَكَ مِنْ قَبْلِ أَنْ لَا تَصِلَ إِلَيْكَ ، فَرَفَعَ  عُرْوَةُ  رَأْسَهُ ، فَقَالَ : أَنْتَ هُوَ وَاللهِ إِنَّكَ لَفِي غَدْرَتِكَ مَا خَرَجْتَ مِنْهَا بَعْدُ ، فَرَجَعَ  عُرْوَةُ  إِلَى قَوْمِهِ ، فَقَالَ : أَيْ         [3/174]      قَوْمِ ، إِنِّي قَدْ رَأَيْتُ الْمُلُوكَ وَكَلَّمْتُهُمْ ، مَا رَأَيْتُ مِثْلَ  مُحَمَّدٍ  قَطُّ ، مَا هُوَ بِمَلِكٍ ، وَلَقَدْ رَأَيْتُ الْهَدْيَ مَعْكُوفًا يَأْكُلُ وَبَرَهُ ، وَمَا أَرَاكُمْ إِلَّا سَتُصِيبُكُمْ قَارِعَةٌ ، فَانْصَرَفَ وَمَنْ مَعَهُ مِنْ قَوْمِهِ ، فَصَعِدَ سُورَ  الطَّائِفِ  ، فَشَهِدَ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، فَرَمَاهُ  رَجُلٌ  مِنْ قَوْمِهِ بِسَهْمٍ ، فَقَتَلَهُ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْحَمْدُ لِلهِ الَّذِي جَعَلَ فِي أُمَّتِي مِثْلَ صَاحِبِ يَاسِينَ  .","","Musnad Abi Ya'la al-Mawsili 1598","","عروة بن مسعود بن معتب الثقفي عن علي بن زيد بن جدعان عن حماد بن سلمة عن حوثرة بن أشرس بن عومر العدوي عن أبو يعلى الموصلي","عروة بن مسعود"
"1599","عَبْدُ اللهِ بْنُ الشِّخِّيرِ  1 - (  1599  ) -  حَدَّثَنَا  حَوْثَرَةُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  مُطَرِّفِ بْنِ عَبْدِ اللهِ بْنِ الشِّخِّيرِ ،         [3/175]      عَنْ  أَبِيهِ ،  قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْمَسْجِدَ ، وَهُوَ قَائِمٌ ، وَلِصَدْرِهِ  أَزِيزٌ  كَأَزِيزِ  الْمِرْجَلِ  .","","Musnad Abi Ya'la al-Mawsili 1599","","عبد الله بن الشخير الحرشي عن مطرف بن عبد الله بن الشخير الحرشي عن ثابت البناني عن حماد بن سلمة عن حوثرة بن أشرس بن عومر العدوي عن أبو يعلى الموصلي","عبد الله بن الشخير"
"1600","أَبُو الْجَعْدِ  1 - (  1600  ) -  حَدَّثَنَا  أُمَيَّةُ بْنُ بِسْطَامٍ ،  حَدَّثَنَا  يَزِيدُ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  أَخْبَرَنِي  عَبِيدَةُ بْنُ سُفْيَانَ الْحَضْرَمِيُّ ،  عَنْ  أَبِي الْجَعْدِ الضَّمْرِيِّ وَكَانَتْ لَهُ صُحْبَةٌ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ تَرَكَ الْجُمُعَةَ ثَلَاثَ مَرَّاتٍ تَهَاوُنًا بِهَا  ،  طَبَعَ  اللهُ عَلَى قَلْبِهِ  .","","Musnad Abi Ya'la al-Mawsili 1600","","أبو الجعد الضمري عن عبيدة بن سفيان بن الحارث الحضرمي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يزيد بن زريع العيشي عن أمية بن بسطام عن أبو يعلى الموصلي","أبو الجعد"
"1601","[3/176]      رَجُلٌ  1 - (  1601  ) -  حَدَّثَنَا  هُدْبَةُ ،  حَدَّثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،         [3/177]      أَنَّ  رَجُلًا  بِالْكُوفَةِ  ، شَهِدَ أَنَّ  عُثْمَانَ  رَضِيَ اللهُ عَنْهُ قُتِلَ  شَهِيدًا  ، فَأَخَذَتْهُ الزَّبَانِيَةُ فَرَفَعُوهُ إِلَى  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ ، وَقَالُوا : لَوْلَا أَنْ  تَنْهَانَا أَوْ نَهَيْتَنَا  أَنْ لَا نَقْتُلَ أَحَدًا لَقَتَلْنَاهُ ، هَذَا زَعَمَ أَنَّهُ يَشْهَدُ أَنَّ  عُثْمَانَ  رَضِيَ اللهُ عَنْهُ قُتِلَ  شَهِيدًا  ، فَقَالَ الرَّجُلُ  لِعَلِيٍّ  رَضِيَ اللهُ عَنْهُ : وَأَنْتَ تَشْهَدُ ، أَتَذْكُرُ أَنِّي أَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَسَأَلْتُهُ ، فَأَعْطَانِي ، وَأَتَيْتُ  أَبَا بَكْرٍ  رَضِيَ اللهُ عَنْهُ فَسَأَلْتُهُ فَأَعْطَانِي ، وَأَتَيْتُ  عُمَرَ  رَضِيَ اللهُ عَنْهُ فَسَأَلْتُهُ فَأَعْطَانِي ، وَأَتَيْتُ  عُثْمَانَ  رَضِيَ اللهُ عَنْهُ فَسَأَلْتُهُ فَأَعْطَانِي ، قَالَ : فَأَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقُلْتُ : يَا رَسُولَ اللهِ ، ادْعُ اللهَ أَنْ يُبَارِكَ لِي ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كَيْفَ لَا يُبَارَكُ لَكَ وَأَعْطَاكَ نَبِيٌّ ، وَصِدِّيقٌ ، وَشَهِيدَانِ  ، وَأَعْطَاكَ نَبِيٌّ وَصِدِّيقٌ وَشَهِيدَانِ ، وَأَعْطَاكَ نَبِيٌّ وَصِدِّيقٌ وَشَهِيدَانِ ؟  .","","Musnad Abi Ya'la al-Mawsili 1601","","أحد الصحابة عن محمد بن سيرين عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن أبو يعلى الموصلي","رجل"
"1602","[3/178]      مُسْنَدُ  عَمَّارِ بْنِ يَاسِرٍ  1 - (  1602  ) -  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى الْمَوْصِلِيُّ سَنَةَ سِتٍّ وَثَلَاثُمِائَةٍ ،  حَدَّثَنَا  الْحَسَنُ بْنُ عَرَفَةَ ،  حَدَّثَنَا         [3/179]      سَعِيدُ بْنُ مُحَمَّدٍ الْوَرَّاقُ الثَّقَفِيُّ ،  عَنْ  عَلِيِّ بْنِ الْحَزَوَّرِ ، قَالَ :  سَمِعْتُ  أَبَا مَرْيَمَ الثَّقَفِيَّ ، يَقُولُ :  سَمِعْتُ  عَمَّارَ بْنَ يَاسِرٍ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَقُولُ  لِعَلِيٍّ  :  يَا  عَلِيُّ  ، طُوبَى لِمَنْ أَحَبَّكَ وَصَدَقَ فِيكَ  ، وَوَيْلٌ لِمَنْ أَبْغَضَكَ وَكَذَبَ فِيكَ  .","","Musnad Abi Ya'la al-Mawsili 1602","","عمار بن ياسر عن أبو مريم الثقفي عن علي بن الحزور الغنوي عن سعيد بن محمد الوراق عن الحسن بن عرفة العبدي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1603","2 - (  1603  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ عَرَفَةَ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ الْفَضْلِ الْعَنَزِيُّ ،  عَنْ  إِسْمَاعِيلَ الْعِجْلِيِّ ،  عَنْ  حَمَّادِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  إِبْرَاهِيمَ النَّخَعِيِّ ،  عَنْ  عَلْقَمَةَ بْنِ قَيْسٍ ،  عَنْ  عَمَّارِ بْنِ يَاسِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  عَمَّارُ  أَتَانِي  جِبْرِيلُ  آنِفًا ، فَقُلْتُ :  يَا  جِبْرِيلُ  حَدِّثْنِي بِفَضَائِلِ  عُمَرَ بْنِ الْخَطَّابِ  فِي السَّمَاءِ  ، فَقَالَ : يَا  مُحَمَّدُ  لَوْ حَدَّثْتُكَ بِفَضَائِلِ  عُمَرَ  مِثْلَ مَا لَبِثَ  نُوحٌ  فِي قَوْمِهِ أَلْفَ سَنَةٍ إِلَّا خَمْسِينَ عَامًا مَا نَفِدَتْ فَضَائِلُ  عُمَرَ  ، وَإِنَّ  عُمَرَ  لَحَسَنَةٌ مِنْ حَسَنَاتِ  أَبِي بَكْرٍ  .         [3/180]","","Musnad Abi Ya'la al-Mawsili 1603","","عمار بن ياسر عن علقمة بن قيس النخعي عن إبراهيم النخعي عن حماد بن أبي سليمان عن إسماعيل بن عبيد بصري عن الوليد بن الفضل العنزي عن الحسن بن عرفة العبدي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1604","3 - (  1604  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ، وَأَبُو خَيْثَمَةَ ، قَالَا :  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ ، أَنَّ حَسَّانَ بْنَ بِلَالٍ الْمُزَنِيَّ  حَدَّثَهُ  ،  أَنَّهُ رَأَى  عَمَّارَ بْنَ يَاسِرٍ تَوَضَّأَ وَأَنَّهُ خَلَّلَ لِحْيَتَهُ ، فَقِيلَ لَهُ : أَتَفْعَلُ هَذَا ؟ قَالَ :  إِنِّي رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَفْعَلُهُ  .","","Musnad Abi Ya'la al-Mawsili 1604","","عمار بن ياسر عن حسان بن بلال المزني عن عبد الكريم بن أبي المخارق عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1605","4 - (  1605  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  نَاجِيَةَ بْنِ كَعْبٍ ،  أَنَّ  عَمَّارًا ، قَالَ  لِعُمَرَ  : تَذْكُرُ حَيْثُ كُنْتُ أَنَا وَأَنْتَ فِي الْإِبِلِ ، فَأَصَابَتْنِي جَنَابَةٌ ،  فَتَمَعَّكْتُ  تَمَعُّكَ  الدَّابَّةِ ، فَلَقِيتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَذَكَرْتُ         [3/181]      ذَلِكَ لَهُ ، فَقَالَ :  إِنَّمَا كَانَ يَكْفِيكَ مِنْ ذَلِكَ التَّيَمُّمُ  .","","Musnad Abi Ya'la al-Mawsili 1605","","عمار بن ياسر عن ناجية بن كعب العنزي عن أبو إسحاق السبيعي عن سفيان بن عيينة عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1606","5 - (  1606  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  سُفْيَانَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي مَالِكٍ ،  وَعَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَى ،  عَنْ  أَبِيهِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَى  ،  قَالَ  :  كُنَّا عِنْدَ  عُمَرَ  فَأَتَاهُ  رَجُلٌ  ،  فَقَالَ  : يَا أَمِيرَ الْمُؤْمِنِينَ ، إِنَّمَا نَمْكُثُ  الشَّهْرَ  وَالشَّهْرَيْنِ لَا نَجِدُ الْمَاءَ ، فَقَالَ  عُمَرُ  : أَمَّا أَنَا فَلَمْ أَكُنْ أُصَلِّي حَتَّى أَجِدَ الْمَاءَ ، فَقَالَ عَمَّارٌ : يَا أَمِيرَ الْمُؤْمِنِينَ ، تَذْكُرُ إِذْ كُنَّا بِمَكَانِ كَذَا وَكَذَا ، وَنَحْنُ نَرْعَى الْإِبِلَ ، فَتَذَاكَرْنَا أَنَّا أَجْنَبْنَا ، قَالَ : قَالَ : نَعَمْ ، فَإِنِّي  تَمَرَّغْتُ  بِالتُّرَابِ ، فَأَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَدَّثْتُهُ ، فَضَحِكَ ، وَقَالَ :  إِذْ كَانَ الصَّعِيدُ لَكَافِيَكَ  ، وَضَرَبَ بِكَفَّيْهِ الْأَرْضَ ، ثُمَّ         [3/182]      نَفَخَ فِيهِمَا ، ثُمَّ مَسَحَ وَجْهَهُ وَبَعْضَ ذِرَاعَيْهِ ، فَقَالَ : اتَّقِ اللهَ يَا  عَمَّارُ  ، فَقَالَ : يَا أَمِيرَ الْمُؤْمِنِينَ ، إِنْ شِئْتَ لَمْ أَذْكُرْهُ مَا حَيِيتُ ، فَقَالَ : لَا ، وَلَكِنْ  نُوَلِّيكَ  مِنْ ذَلِكَ مَا تَوَلَّيْتَ  .         [3/183]","","Musnad Abi Ya'la al-Mawsili 1606","","عمار بن ياسر عن عبد الرحمن بن أبزى الخزاعي عن عبد الله بن عبد الرحمن بن أبزى الخزاعي عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن عبد الرحمن بن مهدي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1607","6 - (  1607  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  ذَرٍّ ،  عَنِ  ابْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَى ،  عَنْ  أَبِيهِ  ،  عَنْ  عُمَرَ بْنِ الْخَطَّابِ ، وَعَمَّارِ بْنِ يَاسِرٍ ، قَالَ :  سَأَلَ  رَجُلٌ  عُمَرَ  ، فَقَالَ : إِنِّي أَجْنَبْتُ فَلَمْ أَجِدِ الْمَاءَ ؟ قَالَ : لَا تُصَلِّ ، فَقَالَ  عَمَّارٌ  : أَمَا تَذْكُرُ أَنِّي كُنْتُ أَنَا وَأَنْتَ فِي سَرِيَّةٍ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَجْنَبْنَا ، فَأَمَّا أَنْتَ فَلَمْ تُصَلِّ ، وَأَمَّا أَنَا  فَتَمَعَّكْتُ  فَصَلَّيْتُ ، فَأَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرْتُ ذَلِكَ لَهُ ، فَقَالَ :  إِنَّمَا كَانَ يَكْفِيكَ ، فَضَرَبَ بِيَدِهِ الْأَرْضَ ضَرْبَةً فَنَفَخَ فِي كَفَّيْهِ ، وَمَسَحَ بِوَجْهِهِ وَكَفَّيْهِ  .","","Musnad Abi Ya'la al-Mawsili 1607","","عمار بن ياسر عن عبد الرحمن بن أبزى الخزاعي عن سعيد بن عبد الرحمن بن أبزى عن ذر بن عبد الله المرهبي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن يزيد بن زريع العيشي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1608","7 - (  1608  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  سَعِيدٌ ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  عَزْرَةَ ،  عَنْ  سَعِيدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَى ،  عَنْ  أَبِيهِ  ،  عَنْ  عَمَّارٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَهُ فِي التَّيَمُّمِ بِالْكَفَّيْنِ         [3/184]      وَالْوَجْهِ  .","","Musnad Abi Ya'la al-Mawsili 1608","","عمار بن ياسر عن عبد الرحمن بن أبزى الخزاعي عن سعيد بن عبد الرحمن بن أبزى عن عزرة بن عبد الرحمن بن زرارة عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1609","8 - (  1609  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يُوسُفُ بْنُ خَالِدٍ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ  عَمَّارَ بْنَ يَاسِرٍ ، قَالَ :  تَيَمَّمْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَمَسَحْنَا وُجُوهَنَا  وَأَيْدِيَنَا إِلَى الْمَنَاكِبِ بِالتُّرَابِ  .         [3/185]","","Musnad Abi Ya'la al-Mawsili 1609","","عمار بن ياسر عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن عبد الرحمن بن إسحاق العامري عن يوسف بن خالد السمتي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1610","9 - (  1610  ) -  حَدَّثَنَا  بُنْدَارٌ ،  حَدَّثَنَا  مُحَمَّدٌ يَعْنِي غُنْدَرًا ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ سَلِمَةَ ، يَقُولُ :  رَأَيْتُ  عَمَّارَ بْنَ يَاسِرٍ  يَوْمَ الصِّفِّينِ  شَيْخًا ، طُوَالًا ، آدَمَ ، آخِذًا الْحَرْبَةَ بِيَدِهِ ، وَيَدُهُ  تَرْعَدُ  ، فَقَالَ :  وَالَّذِي نَفْسِي بِيَدِهِ لَقَدْ قَاتَلْتُ بِهَذِهِ  الرَّايَةِ  مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثَلَاثَ مَرَّاتٍ  ، وَهَذِهِ الرَّابِعَةُ ، وَالَّذِي نَفْسِي بِيَدِهِ لَوْ ضَرَبُونَا حَتَّى بَلَغُوا بِنَا شَعَفَاتِ  هَجَرَ  لَعَرَفْنَا أَنَّ مُصْلِحِينَا عَلَى الْحَقِّ ، وَإِنَّهُمْ عَلَى الضَّلَالَةِ  .","","Musnad Abi Ya'la al-Mawsili 1610","","عمار بن ياسر عن عبد الله بن سلمة الجملي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1611","10 - (  1611  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  ثَابِتُ بْنُ حَمَّادٍ أَبُو زَيْدٍ ،  حَدَّثَنَا  عَلِيُّ بْنُ زَيْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَمَّارٍ ، قَالَ :  مَرَّ بِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا أَسْقِي نَاقَةً لِي ،         [3/186]      فَتَنَخَّمْتُ ، فَأَصَابَتْ  نُخَامَتِي  ثَوْبِي ، فَأَقْبَلْتُ أَغْسِلُ ثَوْبِي مِنَ  الرَّكْوَةِ  الَّتِي بَيْنَ يَدَيَّ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  عَمَّارُ  ، مَا  نُخَامَتُكَ  وَلَا دُمُوعُ عَيْنَيْكَ إِلَّا بِمَنْزِلَةِ الْمَاءِ الَّذِي فِي  رَكْوَتِكَ  ، إِنَّمَا تَغْسِلُ ثَوْبَكَ مِنَ الْبَوْلِ وَالْغَائِطِ وَالْمَنِيِّ مِنَ الْمَاءِ الْأَعْظَمِ وَالدَّمِ وَالْقَيْءِ  .","","Musnad Abi Ya'la al-Mawsili 1611","","عمار بن ياسر عن سعيد بن المسيب عن علي بن زيد بن جدعان عن ثابت بن حماد البصري عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1612","11 - (  1612  ) -  قُرِئَ عَلَى  بِشْرِ بْنِ الْوَلِيدِ وَأَنَا حَاضِرٌ  ،  حَدَّثَنَا  أَبُو يُوسُفَ ،  عَنْ  أَبِي حَنِيفَةَ ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنِ  ابْنِ الْحَوْتَكِيَّةِ ،  عَنْ  عُمَرَ :  أَنَّ  رَجُلًا  سَأَلَهُ عَنْ أَكْلِ الْأَرْنَبِ ؟  فَقَالَ  : ادْعُ لِيَ  عَمَّارًا  ، فَجَاءَ عَمَّارٌ ، فَقَالَ : حَدِّثْنَا حَدِيثَ الْأَرْنَبِ يَوْمَ كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي مَوْضِعِ كَذَا وَكَذَا .         [3/187]      فَقَالَ  عَمَّارٌ  : أَهْدَى أَعْرَابِيٌّ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَرْنَبًا ، فَأَمَرَ  الْقَوْمَ  أَنْ يَأْكُلُوا ، فَقَالَ أَعْرَابِيٌّ : إِنِّي رَأَيْتُ دَمًا ، فَقَالَ : لَيْسَ بِشَيْءٍ ، ثُمَّ قَالَ : ادْنُ فَكُلْ ، فَقَالَ : إِنِّي صَائِمٌ ، فَقَالَ : صَوْمُ مَاذَا ؟ قَالَ : أَصُومُ مِنْ كُلِّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ ، قَالَ :  فَهَلَّا جَعَلْتَهَا  الْبِيضَ  ؟  .         [3/188]","","Musnad Abi Ya'la al-Mawsili 1612","","عمار بن ياسر عن عمر بن الخطاب عن يزيد بن الحوتكية التميمي عن موسى بن طلحة بن عبيد الله التيمي عن أبو حنيفة النعمان عن أبو يوسف يعقوب بن إبراهيم القاضي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1613","12 - (  1613  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  ابْنُ مَهْدِيٍّ ،  عَنْ  سُفْيَانَ ،  عَنِ  ابْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي الْبَخْتَرِيِّ ،  أَنَّ  عَمَّارًا ، أُتِيَ بِشَرْبَةٍ مِنْ لَبَنٍ ، فَضَحِكَ ، فَقِيلَ لَهُ : مَا يُضْحِكُكَ ؟ قَالَ : إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِنَّ آخِرَ شَرَابٍ تَشْرَبُهُ لَبَنٌ حِينَ تَمُوتُ  .         [3/189]","","Musnad Abi Ya'la al-Mawsili 1613","","عمار بن ياسر عن سعيد بن فيروز الطائي عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن عبد الرحمن بن مهدي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1614","13 - (  1614  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يُوسُفُ بْنُ الْمَاجِشُونِ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  أَبِي عُبَيْدَةَ بْنِ مُحَمَّدِ بْنِ عَمَّارِ بْنِ يَاسِرٍ ،  عَنْ  مَوْلَاةٍ لِعَمَّارِ بْنِ يَاسِرٍ ،  قَالَتِ  :  اشْتَكَى عَمَّارٌ شَكْوَى ثَقُلَ مِنْهَا فَغُشِيَ عَلَيْهِ ،  فَأَفَاقَ  وَنَحْنُ نَبْكِي حَوْلَهُ ، فَقَالَ : مَا يُبْكِيكُمْ ؟ أَتَخْشَوْنَ أَنِّي أَمُوتُ عَلَى فِرَاشِي ؟  أَخْبَرَنِي حَبِيبِي - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ تَقْتُلُنِي  الْفِئَةُ  الْبَاغِيَةُ  ، وَأَنَّ آخِرَ زَادِي مَذْقَةٌ مِنْ لَبَنٍ  .","","Musnad Abi Ya'la al-Mawsili 1614","","عمار بن ياسر عن مولاة لعمار بن ياسر عن أبو عبيدة بن محمد بن عمار العنسي عن يعقوب بن أبي سلمة الماجشون عن يوسف بن يعقوب بن أبي سلمة الماجشون عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1615","14 - (  1615  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  حَدَّثَنِي  سَعِيدٌ الْمَقْبُرِيُّ ،  عَنْ  عُمَرَ بْنِ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ ،  عَنْ  أَبِيهِ  :  أَنَّ  عَمَّارَ بْنَ يَاسِرٍ صَلَّى رَكْعَتَيْنِ ، فَقَالَ لَهُ  عَبْدُ الرَّحْمَنِ بْنُ الْحَارِثِ  : يَا أَبَا  الْيَقْظَانِ  ، أَرَاكَ قَدْ خَفَّفْتَهُمَا ، قَالَ : إِنِّي بَادَرْتُ بِهِمَا الْوَسْوَاسَ ، إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  إِنَّ الرَّجُلَ         [3/190]      لَيُصَلِّي الصَّلَاةَ لَعَلَّهُ أَنْ لَا يَكُونَ لَهُ مِنْهَا إِلَّا عُشْرُهَا  ، أَوْ تُسْعُهَا ، أَوْ ثُمُنُهَا ، أَوْ سُبُعُهَا ، أَوْ سُدُسُهَا ، أَوْ خُمُسُهَا ، حَتَّى أَتَى عَلَى الْعَدَدِ  .","","Musnad Abi Ya'la al-Mawsili 1615","","عمار بن ياسر عن أبو بكر بن عبد الرحمن راهب قريش عن عمر بن أبي بكر بن عبد الرحمن المخزومي عن سعيد المقبري عن عبيد الله بن عمر العمري عن يحيى القطان عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1616","15 - (  1616  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  غُنْدَرٌ ،  حَدَّثَنَا  شُعْبَةُ ، قَالَ :  سَمِعْتُ  قَتَادَةَ  يُحَدِّثُ ، عَنْ  أَبِي نَضْرَةَ ،  عَنْ  قَيْسِ بْنِ عَبَّادٍ ، قَالَ :  قُلْتُ  لِعَمَّارِ بْنِ يَاسِرٍ : أَرَأَيْتَ قِتَالَكُمْ رَأْيًا رَأَيْتُمُوهُ ، فَإِنَّ الرَّأْيَ يُخْطِئُ وَيُصِيبُ ، أَوْ عَهْدًا عَهِدَهُ إِلَيْكُمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : مَا عَهِدَ إِلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَيْئًا لَمْ يَعْهَدْهُ إِلَى النَّاسِ كَافَّةً ، وَقَالَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  شُعْبَةُ  :  وَأَحْسِبُهُ قَالَ :  حَدَّثَنِي  حُذَيْفَةُ  ، قَالَ - :  إِنَّ فِي أُمَّتِي اثْنَيْ عَشَرَ مُنَافِقًا  لَا يَدْخُلُونَ الْجَنَّةَ وَلَا يَجِدُونَ رِيحَهَا حَتَّى يَلِجَ الْجَمَلُ فِي سَمِّ  الْخِيَاطِ  ، ثَمَانِيَةٌ مِنْهُمْ تَكْفِيهِمُ         [3/191]      الدُّبَيْلَةُ  : سِرَاجٌ مِنْ نَارٍ يَظْهَرُ فِي أَكْتَافِهِمْ حَتَّى  يَنْجُمَ  - أَوْ يَثْجِمَ  - مِنْ صُدُورِهِمْ  .","","Musnad Abi Ya'la al-Mawsili 1616","","حذيفة بن اليمان عن عمار بن ياسر عن قيس بن عباد الضبعي عن المنذر بن مالك العوقي عن قتادة بن دعامة عن شعبة بن الحجاج عن غندر ربيب شعبة عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1617","16 - (  1617  ) -  حَدَّثَنَا  سُلَيْمَانُ الشَّاذَكُونِيُّ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ أَبَانَ ،  حَدَّثَنَا  عَلِيُّ بْنُ الْحَزَوَّرِ ، قَالَ :  سَمِعْتُ  أَبَا مَرْيَمَ ، يَقُولُ :  سَمِعْتُ  عَمَّارَ بْنَ يَاسِرٍ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  مَا تَزَيَّنَ الْأَبْرَارُ فِي الدُّنْيَا بِمِثْلِ الزُّهْدِ فِي الدُّنْيَا  .         [3/192]","","Musnad Abi Ya'la al-Mawsili 1617","","عمار بن ياسر عن أبو مريم الثقفي عن علي بن الحزور الغنوي عن إسماعيل بن أبان الغنوي عن الشاذكوني عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1618","17 - (  1618  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ،  حَدَّثَنَا  الْعَلَاءُ بْنُ صَالِحٍ ،  عَنْ  عَدِيِّ بْنِ ثَابِتٍ ،  عَنْ  أَبِي رَاشِدٍ ،  قَالَ  :  تَكَلَّمَ عَمَّارٌ فَأَوْجَزَ ، فَقِيلَ لَهُ : قَدْ قُلْتَ قَوْلًا لَوْ زِدْتَنَا فَقَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَنَا بِإِقْصَارِ الْخُطَبِ  .","","Musnad Abi Ya'la al-Mawsili 1618","","عمار بن ياسر عن أبو راشد عن عدي بن ثابت الظفري عن العلاء بن صالح التيمي عن محمد بن عبد الله بن الزبير عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1619","18 - (  1619  ) -  حَدَّثَنَا  أَبُو مُوسَى الْهَرَوِيُّ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  أَبِي إِسْحَاقَ الْهَمْدَانِيِّ ،  عَنْ  نَاجِيَةَ الْعَنَزِيِّ ،  قَالَ  :  بَدَأَ عَمَّارٌ ، وَعَبْدُ اللهِ بْنُ مَسْعُودٍ فِي التَّيَمُّمِ ، فَقَالَ  عَبْدُ اللهِ  :  لَوْ مَكَثْتُ شَهْرًا لَا أَجِدُ فِيهَا الْمَاءَ مَا صَلَّيْتُ  ، فَقَالَ لَهُ  عَمَّارٌ  : مَا تَذْكُرُ إِذْ كُنْتُ أَنَا وَأَنْتَ فِي الْإِبِلِ ،  فَجَنُبْتُ  ،         [3/193]      فَتَمَعَّكْتُ  تَمَعُّكَ  الدَّابَّةِ ، فَلَمَّا رَجَعْتُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخْبَرْتُهُ بِالَّذِي صَنَعْتُ ، فَقَالَ :  إِنَّمَا كَانَ يَكْفِيكَ التَّيَمُّمُ  .","","Musnad Abi Ya'la al-Mawsili 1619","","عبد الله بن مسعود عن ناجية بن كعب العنزي عن أبو إسحاق السبيعي عن أبو بكر بن عياش عن إسحاق بن إبراهيم الهروي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1620","19 - (  1620  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنِ  الرُّكَيْنِ بْنِ الرَّبِيعِ ،  عَنْ  نُعَيْمِ بْنِ حَنْظَلَةَ ،  عَنْ  عَمَّارٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنْ كَانَ ذَا وَجْهَيْنِ فِي الدُّنْيَا كَانَ لَهُ لِسَانَانِ يَوْمَ الْقِيَامَةِ مِنْ نَارٍ  .","","Musnad Abi Ya'la al-Mawsili 1620","","عمار بن ياسر عن نعيم بن حنظلة الكوفي عن ركين بن الربيع الفزاري عن شريك بن عبد الله النخعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1621","20 - (  1621  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  الْعَلَاءُ بْنُ صَالِحٍ ،  عَنْ  عَدِيِّ بْنِ ثَابِتٍ ،  حَدَّثَنَا  أَبُو رَاشِدٍ ، قَالَ :  خَطَبَنَا  عَمَّارُ بْنُ يَاسِرٍ فَتَجَوَّزَ فِي الْخُطْبَةِ ، فَقَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَهَانَا أَنْ نُطِيلَ الْخُطْبَةَ  .         [3/194]","","Musnad Abi Ya'la al-Mawsili 1621","","عمار بن ياسر عن أبو راشد عن عدي بن ثابت الظفري عن العلاء بن صالح التيمي عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1622","21 - (  1622  ) -  حَدَّثَنَا  مُحَمَّدٌ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جَبَلَةَ ،  حَدَّثَنَا  عَمْرُو بْنُ النُّعْمَانِ ،  عَنْ  كَثِيرٍ أَبِي الْفَضْلِ ،  عَنْ  مُطَرِّفِ بْنِ عَبْدِ اللهِ بْنِ الشِّخِّيرِ ، قَالَ :  سَمِعْتُ  عَمَّارَ بْنَ يَاسِرٍ ، قَالَ :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ  :  أَيُّ يَوْمٍ هَذَا  ؟ فَقُلْنَا : يَوْمُ النَّحْرِ ، فَقَالَ : أَيُّ شَهْرٍ هَذَا ؟ قُلْنَا : ذُو الْحِجَّةِ شَهْرٌ حَرَامٍ ، قَالَ : فَأَيُّ بَلَدٍ هَذَا ؟ قُلْنَا : بَلَدُ الْحَرَامِ ، قَالَ : فَإِنَّ دِمَاءَكُمْ وَأَمْوَالَكُمْ  وَأَعْرَاضَكُمْ  حَرَامٌ  كَحُرْمَةِ  يَوْمِكُمْ هَذَا ، فِي شَهْرِكُمْ هَذَا ، فِي بَلَدِكُمْ هَذَا ، أَلَا هَلْ يُبَلِّغُ الشَّاهِدُ الْغَائِبَ  ؟  .","","Musnad Abi Ya'la al-Mawsili 1622","","عمار بن ياسر عن مطرف بن عبد الله بن الشخير الحرشي عن كثير بن يسار الطفاوي عن عمرو بن النعمان الباهلي عن عبد الرحمن بن عمرو بن جبلة الباهلي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1623","22 - (  1623  ) -  حَدَّثَنَا  الصَّلْتُ بْنُ مَسْعُودٍ الْجَحْدَرِيُّ ،  حَدَّثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  الْخَلِيلُ بْنُ مُرَّةَ ،  عَنِ  الْقَاسِمِ بْنِ سُلَيْمَانَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ :  سَمِعْتُ  عَمَّارَ بْنَ يَاسِرٍ ، يَقُولُ :  أُمِرْتُ أَنْ أُقَاتِلَ  النَّاكِثِينَ  ،         [3/195]      وَالْقَاسِطِينَ  ،  وَالْمَارِقِينَ  .","","Musnad Abi Ya'la al-Mawsili 1623","","عمار بن ياسر عن عبد الملك بن مروان بن الحكم عن سليمان بن عبد الملك الأموي عن القاسم بن سليمان عن الخليل بن مرة الضبعي عن جعفر بن سليمان الضبعي عن الصلت بن مسعود الجحدري عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1624","23 - (  1624  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلِ بْنِ غَزْوَانَ ،  حَدَّثَنَا  عَطَاءُ بْنُ السَّائِبِ ،  عَنْ  أَبِيهِ ،  قَالَ :  كُنْتُ عِنْدَ عَمَّارٍ ، وَكَانَ يَدْعُو بِدُعَاءٍ فِي صَلَاتِهِ فَأَتَاهُ رَجُلٌ ، فَقَالَ لَهُ  عَمَّارٌ  قُلِ : اللَّهُمَّ بِعِلْمِكَ الْغَيْبَ ، وَقُدْرَتِكَ عَلَى الْخَلْقِ ، أَحْيِنِي مَا عَلِمْتَ الْحَيَاةَ خَيْرًا لِي ، وَاقْبِضْنِي إِذَا عَلِمْتَ الْوَفَاةَ خَيْرًا لِي ، اللَّهُمَّ إِنِّي أَسْأَلُكَ الْخَشْيَةَ فِي الْغَيْبِ وَالشَّهَادَةِ ، وَكَلِمَةَ الْحَقِّ فِي الرِّضَا وَالْغَضَبِ ، وَالْقَصْدَ فِي الْغِنَى وَالْفَقْرِ ، وَأَسْأَلُكَ الرِّضَا بَعْدَ الْقَضَاءِ ، وَبَرْدَ الْعَيْشِ بَعْدَ الْمَوْتِ ، وَأَسْأَلُكَ شَوْقًا إِلَى لِقَائِكَ مِنْ غَيْرِ ضَرَّاءَ مُضِرَّةٍ ، وَلَا فِتْنَةٍ مُضِلَّةٍ ، اللَّهُمَّ زَيِّنِّي بِزِينَةِ الْإِيمَانِ ، وَاجْعَلْنِي مِنَ الْهُدَاةِ الْمُهْتَدِينَ         [3/196]      24 - (  1625  ) - ثُمَّ قَالَ : أَلَا أُعَلِّمُكَ كَلِمَاتٍ هُنَّ أَحْسَنُ مِنْهُنَّ ؟ كَأَنَّهُ  يَرْفَعُهُنَّ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ : إِذَا أَخَذْتَ مَضْجَعَكَ مِنَ اللَّيْلِ ، فَقُلِ :  اللَّهُمَّ إِنِّي أَسْلَمْتُ نَفْسِي إِلَيْكَ ، وَوَجَّهْتُ وَجْهِي إِلَيْكَ  ،  وَفَوَّضْتُ  أَمْرِي إِلَيْكَ ، آمَنْتُ بِكِتَابِكَ الْمُنَزَّلِ ، وَنَبِيِّكَ الْمُرْسَلِ ، إِنَّ نَفْسِي نَفْسٌ خَلَقْتَهَا ، لَكَ مَحْيَاهَا ، وَلَكَ مَمَاتُهَا ، فَإِنْ كَفَتَّهَا فَارْحَمْهَا ، وَإِنْ أَخَّرْتَهَا فَاحْفَظْهَا بِحِفْظِ الْإِيمَانِ  .","","Musnad Abi Ya'la al-Mawsili 1624","","عمار بن ياسر عن السائب بن مالك الثقفي عن عطاء بن السائب عن محمد بن فضيل بن غزوان عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1625","25 - (  1626  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ  حَدَّثَنَا  خَالِدٌ  عَنْ  عَطَاءَ ،  عَنْ  مَيْسَرَةَ وَأَبِي الْبَخْتَرِيِّ ،  أَنَّ  عَمَّارًا  يَوْمَ  صِفِّينَ  جَعَلَ يُقَاتِلُ فَلَا يُقْتَلُ ، فَيَجِيءُ إِلَى  عَلِيٍّ  فَيَقُولُ : يَا أَمِيرَ الْمُؤْمِنِينَ أَلَيْسَ هَذَا يَوْمَ كَذَا وَكَذَا هُوَ ؟ فَيَقُولُ : أَذْهِبْ عَنْكَ ، فَقَالَ ذَلِكَ مِرَارًا ثُمَّ أُتِيَ بِلَبَنٍ فَشَرِبَهُ ، فَقَالَ  عَمَّارٌ  :  إِنَّ هَذِهِ لَآخِرُ شَرْبَةٍ أَشْرَبُهَا مِنَ الدُّنْيَا ، ثُمَّ تَقَدَّمَ فَقَاتَلَ حَتَّى قُتِلَ  .         [3/197]","","Musnad Abi Ya'la al-Mawsili 1626","","عمار بن ياسر عن سعيد بن فيروز الطائي عن عطاء بن السائب عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1626","26 - (  1627  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  سَلَمَةَ بْنِ مُحَمَّدِ بْنِ عَمَّارِ بْنِ يَاسِرٍ ،  عَنْ  عَمَّارِ بْنِ يَاسِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِنَّ مِنَ  الْفِطْرَةِ  الْمَضْمَضَةُ  ، وَالِاسْتِنْشَاقُ ، وَقَصُّ الشَّارِبِ ، وَالسِّوَاكُ ، وَغَسْلُ  الْبَرَاجِمِ ،  وَنَتْفُ الْإِبْطِ ،  وَالِاسْتِحْدَادُ  ، وَالِاخْتِتَانُ ،  وَالِانْتِضَاحُ  .","","Musnad Abi Ya'la al-Mawsili 1627","","عمار بن ياسر عن سلمة بن محمد بن عمار بن ياسر عن علي بن زيد بن جدعان عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1627","27 - (  1628  ) -  حَدَّثَنَا  عُمَرُ بْنُ الْخَطَّابِ ،  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ إِبْرَاهِيمَ الْجُدِّيُّ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ عَجْلَانَ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ ،  أَنَّ  عَمَّارًا صَلَّى ، فَقَالَ لَهُ  رَجُلٌ  : لَقَدْ خَفَّفْتَ الصَّلَاةَ يَا  أَبَا         [3/198]      الْيَقْظَانِ  ، قَالَ : هَلْ رَأَيْتَنِي نَقَصْتُ مِنْ حُدُودِهَا شَيْئًا ؟ شَهِدْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ الرَّجُلَ لَيُصَلِّي ، ثُمَّ يَنْصَرِفُ مَا كُتِبَ لَهُ إِلَّا نِصْفُهَا ، ثُلُثُهَا  ، رُبُعُهَا ، خُمُسُهَا ، سُدُسُهَا ، ثُمُنُهَا ، تُسْعُهَا ، عُشْرُهَا  .","","Musnad Abi Ya'la al-Mawsili 1628","","عمار بن ياسر عن سعيد المقبري عن محمد بن عجلان عن سفيان الثوري عن عبد الملك بن إبراهيم الجدي عن عمر بن الخطاب السجستاني عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1628","28 - (  1629  ) -  حَدَّثَنَا  حَجَّاجُ بْنُ يُوسُفَ الشَّاعِرُ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  صَالِحٍ ،  عَنِ  ابْنِ شِهَابٍ ،  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  عَمَّارِ بْنِ يَاسِرٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَرَّسَ  بِذَاتِ الْجَيْشِ  وَمَعَهُ  عَائِشَةُ  زَوْجَتُهُ ، فَانْقَطَعَ عِقْدٌ لَهَا مِنْ  جَزْعِ  ظَفَارِ  ، فَحُبِسَ النَّاسُ ابْتِغَاءَ عِقْدِهَا ذَلِكَ حَتَّى أَضَاءَ الْفَجْرُ ، وَلَيْسَ مَعَ النَّاسِ مَاءٌ ، فَتَغَيَّظَ عَلَيْهَا  أَبُو بَكْرٍ  ، وَقَالَ : حَبَسْتِ النَّاسَ وَلَيْسَ مَعَهُمْ مَاءٌ ؟ فَأَنْزَلَ اللهُ تَعَالَى عَلَى رَسُولِهِ رُخْصَةَ التَّطْهِيرِ بِالصَّعِيدِ الطَّيِّبِ ، فَقَامَ الْمُسْلِمُونَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَضَرَبُوا أَيْدِيَهُمْ فِي الْأَرْضِ وَرَفَعُوا أَيْدِيَهُمْ وَلَمْ يَقْبِضُوا مِنَ التُّرَابِ شَيْئًا ، فَمَسَحُوا بِهَا وُجُوهَهُمْ وَأَيْدِيَهُمْ         [3/199]      إِلَى الْمَنَاكِبِ ، وَمِنْ بَطْنِ أَيْدِيهِمْ إِلَى الْآبَاطِ  .","","Musnad Abi Ya'la al-Mawsili 1629","","عمار بن ياسر عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن حجاج يوسف الثقفي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1629","29 - (  1630  ) -  حَدَّثَنَا  حَجَّاجٌ ،  حَدَّثَنَا  يَعْقُوبُ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ مُسْلِمِ بْنِ عَبْدِ اللهِ بْنِ شِهَابٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبَّاسٍ ،  عَنْ  عَمَّارِ بْنِ يَاسِرٍ قَالَ :  كُنْتُ فِي  الْقَوْمِ  حِينَ نَزَلَتِ الرُّخْصَةُ فِي الْمَسْحِ بِالصَّعِيدِ إِذَا لَمْ نَجِدِ الْمَاءَ  ، قَالَ : فَضَرَبْنَا ضَرْبَةً بِالْيَدَيْنِ بِالصَّعِيدِ لِلْوَجْهِ ، فَمَسَحْنَاهُ مَسْحَةً وَاحِدَةً ، قَالَ : ثُمَّ ضَرَبْنَا ضَرْبَةً أُخْرَى لِلْيَدَيْنِ فَمَسَحْنَاهُمَا بِهَا إِلَى الْمَنْكِبَيْنِ ظَهْرًا وَبَطْنًا  .","","Musnad Abi Ya'la al-Mawsili 1630","","عمار بن ياسر عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن حجاج يوسف الثقفي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1630","30 - (  1631  ) -  حَدَّثَنَا  حَجَّاجٌ ،  حَدَّثَنَا  يَعْقُوبُ ،  حَدَّثَنَا  أَبُو أُوَيْسٍ ،  عَنِ  الزُّهْرِيِّ ، أَنَّ  عُبَيْدَ اللهِ بْنَ عَبْدِ اللهِ  أَخْبَرَهُ  ،  عَنْ  أَبِيهِ  ،  عَنْ  عَمَّارِ بْنِ يَاسِرٍ ، أَنَّهُ قَالَ :  تَمَسَّحْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ         [3/200]      التُّرَابِ فَمَسَحْنَا بِوُجُوهِنَا وَأَيْدِينَا إِلَى الْمَنَاكِبِ  .","","Musnad Abi Ya'la al-Mawsili 1631","","عمار بن ياسر عن عبد الله بن عتبة بن مسعود عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن عبد الله بن عبد الله بن أويس عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن حجاج يوسف الثقفي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1631","31 - (  1632  ) -  حَدَّثَنَا  حَجَّاجٌ ،  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ ، أَنَّ عَمَّارَ بْنَ يَاسِرٍ ،  كَانَ يُحَدِّثُ  :  أَنَّهُ كَانَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَفَرٍ وَمَعَهُ  عَائِشَةُ  ، فَهَلَكَ عِقْدُهَا ،  فَاحْتَبَسَ أَوْ حُبِسَ  النَّاسُ ابْتِغَاءَهُ ، وَلَيْسَ مَعَهُمْ مَاءٌ ، فَأَنْزَلَ اللهُ تَعَالَى آيَةَ التَّيَمُّمِ ، قَالَ  عَمَّارٌ  : فَضَرَبُوا أَيْدِيَهُمْ فَمَسَحُوا بِهَا وُجُوهَهُمْ ، ثُمَّ عَادُوا فَضَرَبُوا بِأَيْدِيهِمْ         [3/201]      فَمَسَحُوا بِهَا أَيْدِيَهُمْ إِلَى  الْإِبِطَيْنِ ، أَوْ قَالَ : إِلَى الْمَنَاكِبِ  .  قَالَ  عَبْدُ الرَّزَّاقِ : وَكَانَ مَعْمَرٌ  يُحَدِّثُ  ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ ،  أَنَّ  عَمَّارًا  كَانَ يَمْسَحُ بِالتَّيَمُّمِ وَجْهَهُ مَسْحَةً وَاحِدَةً  ، ثُمَّ يَعُودُ فَيَمْسَحُ يَدَيْهِ إِلَى الْإِبْطَيْنِ  ،  وَكَانَ  يَخْتَصِرُهُ  مَعْمَرٌ  هَكَذَا  .","","Musnad Abi Ya'la al-Mawsili 1632","","عمار بن ياسر عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن حجاج يوسف الثقفي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1632","32 - (  1633  ) -  حَدَّثَنَا  حَجَّاجٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  عَمَّارِ بْنِ يَاسِرٍ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ فِي سَفَرٍ ، فَهَلَكَ عِقْدٌ  لِعَائِشَةَ  ، فَطَلَبُوهُ حَتَّى أَصْبَحُوا ، وَلَيْسَ مَعَ  الْقَوْمِ  مَاءٌ ، فَنَزَلَتِ الرُّخْصَةُ  ، فَقَامَ الْمُسْلِمُونَ فَضَرَبُوا بِأَيْدِيهِمْ إِلَى الْأَرْضِ فَمَسَحُوا بِهَا وُجُوهَهُمْ ، وَظَاهِرَ أَيْدِيهِمْ ، وَبَاطِنَهَا إِلَى الْآبَاطِ  .         [3/202]","","Musnad Abi Ya'la al-Mawsili 1633","","عمار بن ياسر عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن يزيد بن هارون عن حجاج يوسف الثقفي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1633","33 - (  1634  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  عَمَّارٍ ، قَالَ :  أَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يُصَلِّي فَسَلَّمْتُ عَلَيْهِ فَرَدَّ عَلَيَّ  .","","Musnad Abi Ya'la al-Mawsili 1634","","عمار بن ياسر عن ابن الحنفية عن أبو الزبير المكي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1634","34 - (  1635  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَطَاءٍ الْخُرَاسَانِيِّ ،  عَنْ  يَحْيَى بْنِ يَعْمَرَ ،         [3/203]      عَنْ  عَمَّارِ بْنِ يَاسِرٍ ، أَنَّهُ قَالَ :  قَدِمْتُ عَلَى أَهْلِي لَيْلًا مِنْ سَفَرٍ قَدْ تَشَقَّقَتْ يَدَايَ ، فَضَمَّخُونِي بِالزَّعْفَرَانِ ، فَغَدَوْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَسَلَّمْتُ ، فَلَمْ يَرُدَّ عَلَيَّ ، وَلَمْ يُرَحِّبْ بِي ، فَقَالَ :  اذْهَبْ فَاغْسِلْ هَذَا عَنْكَ  ، فَذَهَبْتُ فَغَسَلْتُهُ ، ثُمَّ جِئْتُ فَسَلَّمْتُ عَلَيْهِ ، فَرَدَّ عَلَيَّ وَرَحَّبَ بِي ، وَقَالَ : إِنَّ الْمَلَائِكَةَ لَا تَحْضُرُ جِنَازَةَ الْكَافِرِ بِخَيْرٍ ، وَلَا الْمُتَضَمِّخَ بِالزَّعْفَرَانِ ، وَلَا  الْجُنُبَ  ، وَرَخَّصَ  لِلْجُنُبِ  إِذَا أَرَادَ أَنْ يَنَامَ ، أَوْ يَأْكُلَ ، أَوْ يَشْرَبَ أَنْ يَتَوَضَّأَ  .","","Musnad Abi Ya'la al-Mawsili 1635","","عمار بن ياسر عن يحيى بن يعمر الجدلي عن عطاء الخراساني عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1635","35 - (  1636  ) -  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  حَدَّثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  حَدَّثَنَا  عَلِيُّ بْنُ أَبِي فَاطِمَةَ ،  عَنْ  أَبِي مَرْيَمَ ، قَالَ :  سَمِعْتُ  عَمَّارَ بْنَ يَاسِرٍ ، يَقُولُ :  يَا  أَبَا مُوسَى  ،  أَنْشُدُكَ  اللهَ ، أَلَمْ تَسْمَعْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا ،  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ ؟  فَأَنَا سَائِلُكَ عَنْ حَدِيثٍ ، فَإِنْ صَدَقْتَ وَإِلَّا بَعَثْتُ عَلَيْكَ مِنْ أَصْحَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَنْ يُقَرِّرُكَ ، ثُمَّ  أَنْشُدُكَ  اللهَ : أَلَيْسَ إِنَّمَا         [3/204]      عَنَاكَ أَنْتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَفْسِكَ ؟ قَالَ : إِنَّهَا سَتَكُونُ فِتْنَةٌ فِي أُمَّتِي أَنْتَ يَا  أَبَا مُوسَى  فِيهَا نَائِمٌ ، خَيْرٌ مِنْكَ قَاعِدًا ، وَقَاعِدٌ خَيْرٌ مِنْكَ قَائِمًا ، وَقَائِمٌ خَيْرٌ مِنْكَ مَاشِيًا ، فَخَصَّكَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَمْ يَعُمَّ النَّاسَ ؟ فَخَرَجَ  أَبُو مُوسَى  وَلَمْ يَرُدَّ عَلَيْهِ شَيْئًا  .","","Musnad Abi Ya'la al-Mawsili 1636","","عمار بن ياسر عن أبو مريم الثقفي عن علي بن الحزور الغنوي عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1636","36 - (  1637  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَامِرِ بْنِ زُرَارَةَ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنِ  الرُّكَيْنِ ،  عَنِ  ابْنِ حَنْظَلَةَ ،  عَنْ  عَمَّارٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ كَانَ ذَا وَجْهَيْنِ فِي الدُّنْيَا كَانَ لَهُ لِسَانَانِ مِنْ نَارٍ يَوْمَ الْقِيَامَةِ  .","","Musnad Abi Ya'la al-Mawsili 1637","","عمار بن ياسر عن نعيم بن حنظلة الكوفي عن ركين بن الربيع الفزاري عن شريك بن عبد الله النخعي عن عبد الله بن عامر بن زرارة الحضرمي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1637","37 - (  1638  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَزْرَةَ ،  عَنْ  سَعِيدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَى ،  عَنْ  أَبِيهِ  ،         [3/205]      عَنْ  عَمَّارِ بْنِ يَاسِرٍ ، قَالَ :  سَأَلْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، عَنِ التَّيَمُّمِ ؟ قَالَ : فَأَمَرَنِي بِالْوَجْهِ وَالْكَفَّيْنِ ضَرْبَةً وَاحِدَةً  .  وَكَانَ  قَتَادَةُ  يُعَفِّرُ .","","Musnad Abi Ya'la al-Mawsili 1638","","عمار بن ياسر عن عبد الرحمن بن أبزى الخزاعي عن سعيد بن عبد الرحمن بن أبزى عن عزرة بن عبد الرحمن بن زرارة عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن محمد بن المنهال عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1638","38 - (  1639  ) -  حَدَّثَنَا  يَحْيَى الْحِمَّانِيُّ ،  حَدَّثَنَا  يَعْلَى بْنُ الْحَارِثِ الْمُحَارِبِيُّ ،  عَنْ  غَيْلَانَ بْنِ جَامِعٍ ،  عَنْ  إِيَاسِ بْنِ سَلَمَةَ ،  عَنِ  ابْنٍ لِعَمَّارٍ ،  عَنْ  عَمَّارٍ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى فِي ثَوْبٍ وَاحِدٍ مُتَوَشِّحًا بِهِ  .","","Musnad Abi Ya'la al-Mawsili 1639","","عمار بن ياسر عن ابن لعمار عن إياس بن سلمة بن الأكوع الأسلمي عن غيلان بن جامع المحاربي عن يعلى بن الحارث بن حرب المحاربي عن يحيى بن عبد الحميد عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1639","39 - (  1640  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ ، قَالَ :  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  نَاجِيَةَ ، قَالَ :  قَالَ  عَمَّارٌ :  أَجْنَبْتُ وَأَنَا فِي الْإِبِلِ ، فَلَمْ أَجِدْ مَاءً ،  فَتَمَعَّكْتُ  تَمَعُّكَ  الدَّابَّةِ ، فَأَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخْبَرْتُهُ بِذَلِكَ ، فَقَالَ :         [3/206]      إِنَّمَا كَانَ يَجْزِيكَ مِنْ ذَلِكَ التَّيَمُّمُ  .","","Musnad Abi Ya'la al-Mawsili 1640","","عمار بن ياسر عن ناجية بن كعب العنزي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن خلف بن هشام البزار عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1640","40 - (  1641  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  ابْنُ أَبِي غَنِيَّةَ ،  عَنْ  عُقْبَةَ بْنِ الْمُغِيرَةِ الشَّيْبَانِيِّ ، عَمَّنْ  حَدَّثَهُ  ،  عَنْ  جَدِّ أَبِيهِ الْمُخَارِقِ  ،  قَالَ  :  لَقِيتُ عَمَّارَ بْنَ يَاسِرٍ  يَوْمَ الْجَمَلِ  وَهُوَ يَبُولُ فِي قَرْنٍ ، فَقُلْتُ لَهُ : أُقَاتِلُ مَعَكَ وَأَكُونُ مَعَكَ ؟ قَالَ :  قَاتِلْ تَحْتَ رَايَةِ قَوْمِكَ ، فَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَسْتَحِبُّ الرَّجُلَ يُقَاتِلُ تَحْتَ رَايَةِ قَوْمِهِ  .","","Musnad Abi Ya'la al-Mawsili 1641","","عمار بن ياسر عن مخارق بن سليم الشيباني عن عمن عن عقبة بن المغيرة الشيباني عن يحيى بن عبد الملك بن حميد عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1641","41 - (  1642  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْمَلِكِ بْنِ أَبْجَرَ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَاصِلِ بْنِ حَيَّانَ ، قَالَ :  قَالَ  أَبُو وَائِلٍ :  خَطَبَنَا عَمَّارُ بْنُ يَاسِرٍ فَأَوْجَزَ وَأَبْلَغَ ، فَلَمَّا نَزَلَ ، قُلْنَا : يَا  أَبَا         [3/207]      الْيَقْظَانِ  ، لَقَدْ أَبْلَغْتَ وَأَوْجَزْتَ ، فَلَوْ كُنْتَ تَنَفَّسْتَ ؟ فَقَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ طُولَ صَلَاةِ الرَّجُلِ وَقِصَرَ خُطْبَتِهِ  مَئِنَّةٌ  مِنْ فِقْهِهِ  ، فَأَطِيلُوا الصَّلَاةَ ، وَاقْصُرُوا الْخُطَبَ ، وَإِنَّ مِنَ  الْبَيَانِ  سِحْرًا  .","","Musnad Abi Ya'la al-Mawsili 1642","","عمار بن ياسر عن شقيق بن سلمة عن واصل بن حيان الأحدب عن عبد الملك بن سعيد بن حيان عن عبد الرحمن بن عبد الملك الكناني عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1642","42 - (  1643  ) -  حَدَّثَنَا  مُوسَى ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  حَدَّثَنَا  أَبِي  ، قَالَ :  سَمِعْتُ  قَيْسَ بْنَ سَعْدٍ  يُحَدِّثُ ، عَنْ  عَطَاءٍ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيِّ بْنِ أَبِي طَالِبٍ ،  عَنْ  عَمَّارِ بْنِ يَاسِرٍ  أَنَّهُ سَلَّمَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَهُوَ يُصَلِّي فَرَدَّ         [3/208]      عَلَيْهِ السَّلَامَ  .","","Musnad Abi Ya'la al-Mawsili 1643","","عمار بن ياسر عن ابن الحنفية عن عطاء بن أبي رباح عن قيس بن سعد الحبشي عن جرير بن حازم عن وهب بن جرير بن حازم عن موسى عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1643","43 - (  1644  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  صِلَةَ ، قَالَ :  كُنَّا عِنْدَ عَمَّارٍ فِي الْيَوْمِ الَّذِي يُشَكُّ فِيهِ مِنْ رَمَضَانَ ، فَأُتِيَ بِشَاةٍ فَتَنَحَّى بَعْضُ  الْقَوْمِ  ، فَقَالَ  عَمَّارٌ  : مَنْ صَامَ هَذَا الْيَوْمَ ، فَقَدْ عَصَى  أَبَا الْقَاسِمِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .         [3/209]","","Musnad Abi Ya'la al-Mawsili 1644","","عمار بن ياسر عن صلة بن زفر العبسي عن أبو إسحاق السبيعي عن عمرو بن قيس الملائي عن سليمان بن حيان الأحمر عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1644","44 - (  1645  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  خَالِدُ بْنُ الْحَارِثِ ،  حَدَّثَنَا  ابْنُ عَوْنٍ ،  عَنِ  الْحَسَنِ ، قَالَ :  قَالَتْ  أُمُّ حَسَنٍ  :  قَالَتْ  أُمُّ الْمُؤْمِنِينَ أُمُّ سَلَمَةَ :  مَا نَسِيتُ  يَوْمَ الْخَنْدَقِ  وَهُوَ يُعَاطِيهِمُ اللَّبَنَ ، وَقَدِ اغْبَرَّ شَعَرُهُ ، يَعْنِي النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - وَهُوَ يَقُولُ :  وَجَاءَ  عَمَّارٌ  ، فَقَالَ :  وَيْحَكَ  ، أَوْ وَيْلَكَ  -  شَكَّ  خَالِدٌ  -  ابْنَ سُمَيَّةَ  ، تَقْتُلُكَ  الْفِئَةُ  الْبَاغِيَةُ  .         [3/210]      قَالَ  ابْنُ عَوْنٍ  : حَدَّثْتُ  مُحَمَّدًا  ، عَنْ أُمِّهِ ، فَقَالَ : أَمَا إِنَّهَا قَدْ كَانَتْ تَدْخُلُ عَلَى  أُمِّ سَلَمَةَ  .","","Musnad Abi Ya'la al-Mawsili 1645","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن عبد الله بن عون بن أرطبان عن خالد الصدق عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1645","45 - (  1646  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  غُنْدَرٌ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ، قَالَ :  سَمِعْتُ  أَبَا وَائِلٍ ،  قَالَ  :  لَمَّا بَعَثَ  عَلِيٌّ  عَمَّارًا  وَالْحَسَنَ  إِلَى  الْكُوفَةِ  لِيَسْتَنْفِرَهُمْ ، خَطَبَ  عَمَّارٌ  ، فَقَالَ :  أَمَا إِنِّي لَأَعْلَمُ أَنَّهَا زَوْجَتُهُ فِي الدُّنْيَا وَالْآخِرَةِ ، يَعْنِي  عَائِشَةَ  .","","Musnad Abi Ya'la al-Mawsili 1646","","عمار بن ياسر عن شقيق بن سلمة عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن غندر ربيب شعبة عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1646","46 - (  1647  ) -  حَدَّثَنَا  مُوسَى ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  يَعْلَى بْنِ الْحَارِثِ ،  عَنْ  غَيْلَانَ بْنِ جَامِعٍ ،  عَنْ  إِيَاسِ بْنِ سَلَمَةَ ،  عَنِ  ابْنٍ لِعَمَّارٍ ،  عَنْ  عَمَّارٍ  :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى فِي ثَوْبٍ  .         [3/211]","","Musnad Abi Ya'la al-Mawsili 1647","","عمار بن ياسر عن ابن لعمار عن إياس بن سلمة بن الأكوع الأسلمي عن غيلان بن جامع المحاربي عن يعلى بن الحارث بن حرب المحاربي عن عبد الرحمن بن مهدي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1647","47 - (  1648  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي الْوَزِيرِ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عُمَرَ بْنِ حَبِيبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ كَثِيرٍ ، قَالَ :  قَالَ  عَمَّارُ بْنُ يَاسِرٍ :  أَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ نُطِيلَ الصَّلَاةَ وَنَقْصُرَ الْخُطْبَةَ  .","","Musnad Abi Ya'la al-Mawsili 1648","","عمار بن ياسر عن عبد الله بن كثير بن عبد الله الداري عن عمر بن حبيب المكي عن سفيان بن عيينة عن محمد بن عمر بن مطرف عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1648","48 - (  1649  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمَّارٍ ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ ،  حَدَّثَنَا  عُبَيْدُ اللهِ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  عُمَرَ بْنِ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  أَنَّ  عَمَّارَ بْنَ يَاسِرٍ دَخَلَ الْمَسْجِدَ فَصَلَّى رَكْعَتَيْنِ خَفِيفَتَيْنِ ، فَقَالَ رَجُلٌ : خَفَّفْتَهُمَا يَا  أَبَا الْيَقْظَانِ  ، فَقَالَ : رَأَيْتَنِي نَقَصْتُ مِنْ حُدُودِهَا شَيْئًا ؟ إِنِّي بَادَرْتُ بِهِمَا الْوَسْوَاسَ ، إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  إِنَّ الرَّجُلَ لَيُصَلِّي ، وَلَعَلَّهُ أَنْ لَا يَكُونَ لَهُ مِنْ صَلَاتِهِ إِلَّا عُشْرُهَا  ، أَوْ تُسْعُهَا ، أَوْ ثُمُنُهَا ، أَوْ سُبُعُهَا ، أَوْ سُدُسُهَا ، أَوْ خُمُسُهَا ، أَوْ رُبُعُهَا ، أَوْ ثُلُثُهَا ، أَوْ نِصْفُهَا  .","","Musnad Abi Ya'la al-Mawsili 1649","","عمار بن ياسر عن عمر بن أبي بكر بن عبد الرحمن المخزومي عن سعيد المقبري عن عبيد الله بن عمر العمري عن عبد الوهاب بن عبد المجيد الثقفي عن محمد بن عبد الله بن عمار الغامدي عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1649","49 - (  1650  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  مُحَمَّدُ         [3/212]      بْنُ عَبْدِ اللهِ الْأَسَدِيُّ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  سِمَاكٍ ،  عَنْ  ثَرْوَانَ بْنِ مِلْحَانَ ، قَالَ :  كُنَّا جُلُوسًا فِي الْمَسْجِدِ فَمَرَّ عَلَيْنَا عَمَّارٌ ، فَقُلْنَا لَهُ : حَدِّثْنَا حَدِيثَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْفِتْنَةِ ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  سَيَكُونُ بَعْدِي أُمَرَاءُ يَقْتَتِلُونَ عَلَى الْمُلْكِ يَقْتُلُ بَعْضُهُمْ عَلَيْهِ بَعْضًا  ، قُلْنَا : لَوْ حَدَّثَنَا بِهِ غَيْرُكَ كَذَّبْنَاهُ ، أَمَا إِنَّهُ سَيَكُونُ  .","","Musnad Abi Ya'la al-Mawsili 1650","","عمار بن ياسر عن ثروان بن ملحان التيمي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن عبد الله بن الزبير عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1650","50 - (  1651  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ قَزَعَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ حَبِيبٍ ،  عَنْ  سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  خِلَاسِ بْنِ عَمْرٍو ،  عَنْ  عَمَّارِ بْنِ يَاسِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أُنْزِلَتِ الْمَائِدَةُ مِنَ السَّمَاءِ خُبْزًا وَلَحْمًا ، فَأُمِرُوا أَنْ لَا يَخُونُوا  ، وَلَا  يَدَّخِرُوا  لِغَدٍ ، فَخَانُوا ، وَادَّخَرُوا ، وَرَفَعُوا ، فَمُسِخُوا قِرَدَةً وَخَنَازِيرَ  .         [3/213]","","Musnad Abi Ya'la al-Mawsili 1651","","عمار بن ياسر عن خلاس بن عمرو الهجري عن قتادة بن دعامة عن سعيد بن أبي عروبة عن سفيان بن حبيب البصري عن الحسن بن قزعة الخلقاني عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1651","51 - (  1652  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  يُوسُفُ بْنُ خَالِدٍ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ عَمَّارَ بْنَ يَاسِرٍ ،  قَالَ  :  تَيَمَّمْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَمَسَحْنَا وُجُوهَنَا وَأَيْدِيَنَا إِلَى الْمَنَاكِبِ بِالتُّرَابِ  .","","Musnad Abi Ya'la al-Mawsili 1652","","عمار بن ياسر عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن عبد الرحمن بن إسحاق العامري عن يوسف بن خالد السمتي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1652","52 - (  1653  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَرَجِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الزِّبْرِقَانِ ،  حَدَّثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  أَخْبَرَنِي  سَعْدُ بْنُ إِبْرَاهِيمَ ، عَمَّنْ  أَخْبَرَهُ  ،  عَنْ  عَمَّارِ بْنِ يَاسِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِنَّ الْحَلَالَ بَيِّنٌ وَالْحَرَامَ بَيِّنٌ ، وَبَيْنَهُمَا شُبُهَاتٌ  ، مَنْ تَوَقَّاهُنَّ كُنَّ وِقَاءً لِدِينِهِ ، وَمَنْ يُوقَعُ فِيهِنَّ  يُوشِكُ  أَنْ يُوَاقِعَ الْكَبَائِرَ كَالْمُرْتِعِ حَوْلَ الْحِمَى  يُوشِكُ  أَنْ يُوَاقِعَهُ ، لِكُلِّ مَلِكٍ حِمًى  .","","Musnad Abi Ya'la al-Mawsili 1653","","عمار بن ياسر عن عمن عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن موسى بن عبيدة بن نشيط الحميري عن محمد بن الزبرقان الأهوازي عن محمد بن الفرج الفراء عن أبو يعلى الموصلي","مسند عمار بن ياسر"
"1653","[3/214]             [3/215]      مُسْنَدُ  الْبَرَاءِ بْنِ عَازِبٍ  1 - (  1654  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنِ  الْحَسَنِ بْنِ الْحَكَمِ ،  عَنْ  عَدِيِّ بْنِ ثَابِتٍ ،  عَنِ  الْبَرَاءِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ  بَدَا  جَفَا  .","","Musnad Abi Ya'la al-Mawsili 1654","","البراء بن عازب الأوسي عن عدي بن ثابت الظفري عن الحسن بن الحكم النخعي عن شريك بن عبد الله النخعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1654","2 - (  1655  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو         [3/216]      أُسَامَةَ ،  عَنْ  زَكَرِيَّا ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْبَرَاءِ ، قَالَ :  نَزَلْنَا مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْحُدَيْبِيَةَ  فَوَجَدْنَا مَاءَهَا قَدْ شَرِبَهُ أَوَائِلُ النَّاسِ  ، فَجَلَسَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى الْبِئْرِ ، وَدَعَا بِدَلْوٍ مِنْهَا فَأَخَذَ مِنْهُ بِفِيهِ ، ثُمَّ مَجَّهُ فِيهَا وَدَعَا اللهَ تَعَالَى ، فَكَثُرَ مَاؤُهَا حَتَّى رَوِيَ النَّاسُ مِنْهَا  .","","Musnad Abi Ya'la al-Mawsili 1655","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن زكريا بن أبي زائدة الوادعي عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1655","3 - (  1656  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  حَدَّثَنَا  مُعَمَّرُ بْنُ سُلَيْمَانَ الرَّقِّيُّ ،  حَدَّثَنَا  حَجَّاجُ بْنُ أَرْطَاةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الْكَلَالَةِ         [3/217]      فَقَالَ :  تَكْفِيكَ آيَةُ  الصَّيْفِ  .         [3/218]","","Musnad Abi Ya'la al-Mawsili 1656","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن حجاج بن أرطاة عن معمر بن سليمان النخعي عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1656","4 - (  1657  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ النَّخَعِيُّ ،  حَدَّثَنَا  الْحَجَّاجُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ :  سُئِلَ أَيْنَ كَانَ يَسْجُدُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : كَانَ يَسْجُدُ بَيْنَ كَفَّيْهِ  .","","Musnad Abi Ya'la al-Mawsili 1657","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن حجاج بن أرطاة عن حفص بن غياث النخعي عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1657","5 - (  1658  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى الْوَاسِطِيُّ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ افْتَتَحَ الصَّلَاةَ رَفَعَ يَدَيْهِ  حَتَّى  حَاذَتَا إِبْهَامَيْهِ ، أَوْ تُحَاذِيَانِ أُذُنَيْهِ  .         [3/219]             [3/220]             [3/221]","","Musnad Abi Ya'la al-Mawsili 1658","","البراء بن عازب الأوسي عن عبد الرحمن بن أبي ليلى عن يزيد بن أبي زياد القرشي عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1658","6 - (  1659  ) -  وَعَنِ  الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مِنَ الْحَقِّ عَلَى الْمُسْلِمِينَ أَنْ يَغْتَسِلَ أَحَدُهُمْ يَوْمَ الْجُمُعَةِ  ، وَأَنْ يَمَسَّ مِنْ طِيبٍ إِنْ كَانَ عِنْدَ أَهْلِهِ ، فَإِنْ لَمْ يَكُنْ عِنْدَهُمْ فَإِنَّ الْمَاءَ طِيبٌ  .         [3/222]      قَالَ هُشَيْمٌ : قُلْتُ لِيَزِيدَ : هَلْ مِنْ غُسْلٍ غَيْرَ يَوْمِ الْجُمُعَةِ ؟ قَالَ : نَعَمْ ، يَوْمَ عِيدِ الْفِطْرِ ، وَيَوْمَ الْأَضْحَى ، وَيَوْمَ عَرَفَةَ ، وَيَوْمَ الْجُمُعَةِ ، وَقَالَ فِيهِ  .","","Musnad Abi Ya'la al-Mawsili 1659","","البراء بن عازب الأوسي عن عبد الرحمن بن أبي ليلى عن يزيد بن أبي زياد القرشي عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1659","7 - (  1660  ) -  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْأَذْرَمِيُّ ،  حَدَّثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  حَدَّثَنَا  زَكَرِيَّا ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْبَرَاءِ ، قَالَ :  اعْتَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَبْلَ  الْحَجِّ  .         [3/223]      قَالَ : وَقَالَتْ عَائِشَةُ : لَقَدْ عَلِمَ أَنْ قَدِ اعْتَمَرَ أَرْبَعًا لِعُمْرَتِهِ فِي حَجَّةِ الْوَدَاعِ  .","","Musnad Abi Ya'la al-Mawsili 1660","","عائشة بنت أبي بكر الصديق عن البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن زكريا بن أبي زائدة الوادعي عن إسحاق بن يوسف الأزرق عن عبد الله بن محمد الأذرمي عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1660","8 - (  1661  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي يَوْمِ         [3/224]      نَحْرٍ ، فَقَالَ :  أَلَا لَا يَذْبَحَنَّ أَحَدٌ حَتَّى يُصَلِّي  ، فَقَامَ  رَجُلٌ  ، فَقَالَ : يَا رَسُولَ اللهِ ، هَذَا يَوْمٌ اللَّحْمُ فِيهِ  مَكْرُوهٌ ،  وَإِنِّي عَجَّلْتُ  نَسِيكَتِي  لِأُطْعِمَ أَهْلِي وَأَهْلَ دَارِي ، أَوْ أَهْلِي وَجِيرَانِي ، قَالَ : فَقَدْ فَعَلْتَ فَأَعِدْ ذَبْحًا آخَرَ ، قَالَ : يَا رَسُولَ اللهِ ، عِنْدِي  عَنَاقُ  لَبَنٍ ، هِيَ خَيْرٌ مِنْ شَاتَيْ لَحْمٍ ، أَفَأَذْبَحُهَا ؟ قَالَ : نَعَمْ ، وَهِيَ خَيْرٌ مِنْ  نَسِيكَتِكَ  ، وَلَا تَقْضِي  جَذَعَةٌ  عَنْ أَحَدٍ بَعْدَكَ  .         [3/225]","","Musnad Abi Ya'la al-Mawsili 1661","","البراء بن عازب الأوسي عن الشعبي عن داود بن أبي هند عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1661","9 - (  1662  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ الْأَضْحَى بَعْدَ الصَّلَاةِ ، فَقَالَ :  مَنْ صَلَّى صَلَاتَنَا  وَنَسَكَ  نَسِيكَتَنَا  ، فَقَدْ أَصَابَ  النُّسُكَ  ، وَمَنْ  نَسَكَ  قَبْلَ الصَّلَاةِ ، فَشَاتُهُ شَاةُ لَحْمٍ ، وَلَا  نُسُكَ  لَهُ  ، فَقَالَ  أَبُو بُرْدَةَ بْنُ نِيَارٍ خَالُ الْبَرَاءِ  : يَا رَسُولَ اللهِ ، فَإِنِّي  نَسَكْتُ  شَاتَيْ قَبْلَ الصَّلَاةِ ، وَعَرَفْتُ أَنَّ الْيَوْمَ يَوْمُ أَكْلٍ  وَشُرْبٍ  ، وَأَحْبَبْتُ أَنْ تَكُونَ شَاتَيْ أَوَّلَ شَيْءٍ يُذْبَحُ فِي بَيْتِي ، فَذَبَحْتُ شَاتَيْ ، وَتَغَدَّيْتُ قَبْلَ أَنْ آتِيَ الصَّلَاةَ ، قَالَ : شَاتُكَ شَاةُ لَحْمٍ ، قَالَ : فَقَالَ : يَا رَسُولَ اللهِ ، فَإِنَّ عِنْدَنَا  عَنَاقًا  لَنَا  جَذَعَةً  هِيَ أَحَبُّ إِلَيَّ مِنْ شَاتَيْنِ ،         [3/226]      أَفَتَجْزِي عَنِّي ؟ قَالَ : نَعَمْ ، وَلَنْ  تَجْزِي  عَنْ أَحَدٍ بَعْدَكَ  .","","Musnad Abi Ya'la al-Mawsili 1662","","البراء بن عازب الأوسي عن الشعبي عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1662","10 - (  1663  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  فِطْرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْبَرَاءِ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا خَرَجَ إِلَى سَفَرٍ ، فَقَالَ :  اللَّهُمَّ  بَلَاغًا  يُبَلِّغُ خَيْرًا ، مَغْفِرَةً مِنْكَ وَرِضْوَانًا  ، بِيَدِكَ الْخَيْرُ ، إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، اللَّهُمَّ أَنْتَ الصَّاحِبُ فِي السَّفَرِ ، وَالْخَلِيفَةُ فِي الْأَهْلِ ، اللَّهُمَّ هَوِّنْ عَلَيْنَا السَّفَرَ ،  وَاطْوِ  لَنَا الْأَرْضَ ، اللَّهُمَّ أَعُوذُ بِكَ مِنْ  وَعْثَاءِ  السَّفَرِ ،  وَكَآبَةِ  الْمُنْقَلَبِ  .","","Musnad Abi Ya'la al-Mawsili 1663","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن فطر بن خليفة عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1663","11 - (  1664  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنِي  بَهْزٌ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الرَّبِيعِ بْنِ الْبَرَاءِ ،         [3/227]      عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا رَجَعَ مِنْ سَفَرِهِ ، قَالَ :  آيِبُونَ ، تَائِبُونَ ، عَابِدُونَ ، لِرَبِّنَا حَامِدُونَ  .","","Musnad Abi Ya'la al-Mawsili 1664","","البراء بن عازب الأوسي عن الربيع بن البراء بن عازب عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن بهز بن أسد عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1664","12 - (  1665  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنِي  بَهْزٌ ،  حَدَّثَنَا  شُعْبَةُ ،  حَدَّثَنِي  عَدِيُّ بْنُ ثَابِتٍ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ فِي سَفَرٍ فَقَرَأَ فِي الْعِشَاءِ الْآخِرَةِ فِي إِحْدَى الرَّكْعَتَيْنِ بِـ         {      وَالتِّينِ وَالزَّيْتُونِ         }      "" .         [3/228]","","Musnad Abi Ya'la al-Mawsili 1665","","البراء بن عازب الأوسي عن عدي بن ثابت الظفري عن شعبة بن الحجاج عن بهز بن أسد عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1665","13 - (  1666  ) -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  هُشَيْمٌ ،  أَخْبَرَنَا  أَشْعَثُ ،  عَنْ  عَدِيِّ بْنِ ثَابِتٍ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ :  بَعَثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَالِي إِلَى رَجُلٍ تَزَوَّجَ امْرَأَةَ أَبِيهِ ، فَأَمَرَهُ أَنْ يَضْرِبَ عُنُقَهُ  .","","Musnad Abi Ya'la al-Mawsili 1666","","البراء بن عازب الأوسي عن عدي بن ثابت الظفري عن أشعث بن سوار عن هشيم بن بشير عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1666","14 - (  1667  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ ،  حَدَّثَنَا  حَفْصٌ ،  عَنْ  أَشْعَثَ ،  عَنْ  عَدِيٍّ ،  عَنِ  الْبَرَاءِ :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعَثَ رَجُلًا إِلَى رَجُلٍ تَزَوَّجَ امْرَأَةَ أَبِيهِ ، فَأَمَرَهُ أَنْ يَضْرِبَ عُنُقَهُ وَيَأْتِي بِرَأْسِهِ  .         [3/229]             [3/230]","","Musnad Abi Ya'la al-Mawsili 1667","","البراء بن عازب الأوسي عن عدي بن ثابت الظفري عن أشعث بن سوار عن حفص بن غياث النخعي عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1667","15 - (  1668  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ، وَأَبُو دَاوُدَ ، قَالَا :  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ، قَالَ :  سَمِعْتُ  سَعْدَ بْنَ عُبَيْدَةَ يُحَدِّثُ ،  عَنِ  الْبَرَاءِ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَ  رَجُلًا  إِذَا أَخَذَ مَضْجَعَهُ أَنْ يَقُولَ :  اللَّهُمَّ أَسْلَمْتُ نَفْسِي إِلَيْكَ ، وَوَجَّهْتُ وَجْهِي إِلَيْكَ  ، وَأَلْجَأْتُ ظَهْرِي إِلَيْكَ ،  وَفَوَّضْتُ  أَمْرِي إِلَيْكَ ،  رَغْبَةً  وَرَهْبَةً  إِلَيْكَ ، لَا مَلْجَأَ وَلَا مَنْجَا مِنْكَ إِلَّا إِلَيْكَ ، آمَنْتُ بِكِتَابِكَ الَّذِي أَنْزَلْتَ ، وَبِرَسُولِكَ الَّذِي أَرْسَلْتَ ، فَإِنْ مَاتَ مَاتَ عَلَى الْفِطْرَةِ  .         [3/231]             [3/232]","","Musnad Abi Ya'la al-Mawsili 1668","","البراء بن عازب الأوسي عن سعد بن عبيدة السلمي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن أبو داود الطيالسي عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1668","16 - (  1669  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ الْأَزْدِيُّ ،  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  حَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْبَرَاءِ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَضَعُ وَجْهَهُ بَيْنَ كَفَّيْهِ إِذَا سَجَدَ  .","","Musnad Abi Ya'la al-Mawsili 1669","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن حجاج بن أرطاة عن حفص بن غياث النخعي عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1669","17 - (  1670  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  قَنَانِ بْنِ عَبْدِ اللهِ النَّهْمِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَةَ ،         [3/233]      عَنِ  الْبَرَاءِ ، قَالَ :  سَمِعَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَبَا مُوسَى  يَقْرَأُ ، فَقَالَ : كَأَنَّ صَوْتَ هَذَا مِنْ مَزَامِيرِ  آلِ دَاوُدَ  .","","Musnad Abi Ya'la al-Mawsili 1670","","البراء بن عازب الأوسي عن عبد الرحمن بن عوسجة النهمي عن قنان بن عبد الله النهمي عن عبد الرحيم بن سليمان الأشل عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1670","18 - (  1671  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ مَوْلَى بَنِي هَاشِمٍ ،  حَدَّثَنَا  يَحْيَى بْنُ عُقْبَةَ بْنِ أَبِي الْعَيْزَارِ ،  حَدَّثَنَا  أَبُو إِسْحَاقَ ،  عَنِ  الْبَرَاءِ ، قَالَ :  سَجَدْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الظُّهْرِ ، فَظَنَنَّا أَنَّهُ قَرَأَ "" تَنْزِيلُ "" السَّجْدَةَ  .","","Musnad Abi Ya'la al-Mawsili 1671","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن يحيى بن عقبة الكوفي عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1671","19 - (  1672  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  حَدَّثَنَا  أَبُو إِسْحَاقَ ،  عَنِ  الْبَرَاءِ ، قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَصْحَابُهُ ، فَأَحْرَمْنَا         [3/234]      بِالْحَجِّ ، فَلَمَّا أَنْ قَدِمْنَا  مَكَّةَ  ، قَالَ :  اجْعَلُوا حَجَّكُمْ عُمْرَةً  ، فَقَالَ نَاسٌ : يَا رَسُولَ اللهِ ، قَدْ أَحْرَمْنَا بِالْحَجِّ ، فَكَيْفَ نَجْعَلُهَا عُمْرَةً ؟ قَالَ : انْظُرُوا مَا أَمَرْتُكُمْ بِهِ فَافْعَلُوا ، قَالَ : فَرَدُّوا عَلَيْهِ الْقَوْلَ ، فَغَضِبَ ثُمَّ انْطَلَقَ حَتَّى دَخَلَ عَلَى  عَائِشَةَ  غَضْبَانَ ، قَالَ : فَرَأَتِ الْغَضَبَ فِي وَجْهِهِ ، فَقَالَتْ : مَنْ أَغْضَبَكَ أَغْضَبَهُ اللهُ تَعَالَى ؟ فَقَالَ : مَا لِي لَا أَغْضَبُ ، وَأَنَا آمُرُ بِالْأَمْرِ فَلَا يُتَّبَعُ  ؟  .","","Musnad Abi Ya'la al-Mawsili 1672","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن أبو بكر بن عياش عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1672","20 - (  1673  ) -  حَدَّثَنَا  خَالِدُ بْنُ مِرْدَاسٍ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  أَبِي بَلْجٍ ،  عَنْ  زَيْدِ بْنِ أَبِي الشَّعْثَاءِ الْعَبْدِيِّ ،  عَنِ  الْبَرَاءِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا الْتَقَى الْمُسْلِمَانِ فَتَصَافَحَا وَحَمِدَا اللهَ وَاسْتَغْفَرَاهُ ، غُفِرَ لَهُمَا  .         [3/235]","","Musnad Abi Ya'la al-Mawsili 1673","","البراء بن عازب الأوسي عن زيد بن أبي الشعثاء العنزي عن أبو بلج يحيى بن سليم الفزاري عن هشيم بن بشير عن خالد بن مرداس البغدادي عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1673","21 - (  1674  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْخَطَّابِ ،  حَدَّثَنَا  مُؤَمَّلٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  الْبَرَاءِ ، قَالَ :  قَنَتَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي صَلَاةِ الْمَغْرِبِ وَالْغَدَاةِ  .         [3/236]             [3/237]      قَالَ  عَمْرٌو  : فَذَكَرْتُ ذَلِكَ  لِإِبْرَاهِيمَ  فَغَضِبَ ، وَقَالَ : إِنَّهُ كَانَ صَاحِبَ أَمْرٍ ، يَعْنِي :  ابْنَ أَبِي لَيْلَى  .","","Musnad Abi Ya'la al-Mawsili 1674","","البراء بن عازب الأوسي عن عبد الرحمن بن أبي ليلى عن عمرو بن مرة المرادي عن سفيان الثوري عن مؤمل بن إسماعيل العدوي عن محمد بن الخطاب البلدي عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1674","22 - (  1675  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دِينَارٍ ،  حَدَّثَنَا  مُصْعَبُ بْنُ سَلَّامٍ ،  عَنْ  حَمْزَةَ بْنِ حَبِيبٍ الزَّيَّاتِ ،  عَنْ  أَبِي إِسْحَاقَ السَّبِيعِيِّ ،  عَنِ  الْبَرَاءِ ، قَالَ :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى أَسْمَعَ الْعَوَاتِقَ  فِي بُيُوتِهَا ، أَوْ قَالَ : فِي خُدُورِهَا ،  فَقَالَ :  يَا مَعْشَرَ مَنْ آمَنَ بِلِسَانِهِ ، لَا تَغْتَابُوا الْمُسْلِمِينَ وَلَا تَتَّبِعُوا  عَوْرَاتِهِمْ  ،  فَإِنَّهُ مَنْ تَتَبَّعَ  عَوْرَةَ         [3/238]      أَخِيهِ تَتَبَّعَ اللهُ  عَوْرَتَهُ  ، وَمَنْ تَتَبَّعِ اللهُ  عَوْرَتَهُ  يَفْضَحْهُ فِي جَوْفِ بَيْتِهِ  .","","Musnad Abi Ya'la al-Mawsili 1675","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن حمزة الزيات عن مصعب بن سلام التميمي عن إبراهيم بن دينار التمار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1675","23 - (  1676  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ سَهْمٍ الْأَنْطَاكِيُّ ،  حَدَّثَنَا  أَبُو إِسْحَاقَ الْفَزَارِيُّ ،  عَنْ  أَبِي إِسْحَاقَ الشَّيْبَانِيِّ ، أَنَّهُ  حَدَّثَهُ  مُحَارِبُ بْنُ دِثَارٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ يَزِيدَ ، يَقُولُ عَلَى الْمِنْبَرِ :  حَدَّثَنَا  الْبَرَاءُ بْنُ عَازِبٍ  أَنَّهُمْ كَانُوا يُصَلُّونَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَإِذَا رَكَعَ رَكَعُوا  ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ ، فَقَالَ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، لَمْ نَزَلْ قِيَامًا حَتَّى نَرَاهُ قَدْ وَضَعَ  .         [3/239]","","Musnad Abi Ya'la al-Mawsili 1676","","البراء بن عازب الأوسي عن عبد الله بن يزيد بن زيد الخطمي عن محارب بن دثار عن سليمان بن فيروز الشيباني عن أبو إسحاق الفزاري عن محمد بن عبد الرحمن بن حكيم الأنطاكي عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1676","24 - (  1677  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنِ  الْعَوَّامِ ،  أَخْبَرَنِي  عَزْرَةُ بْنُ الْحَارِثِ الشَّيْبَانِيُّ ،  عَنِ  الْبَرَاءِ ، قَالَ :  كُنَّا إِذَا صَلَّيْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَفَعْنَا رُءُوسَنَا مِنَ الرُّكُوعِ  ، قُمْنَا صُفُوفًا حَتَّى يَسْجُدَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَإِذَا سَجَدَ تَبِعْنَاهُ  .         [3/240]","","Musnad Abi Ya'la al-Mawsili 1677","","البراء بن عازب الأوسي عن عزرة بن الحارث الشيباني عن العوام بن حوشب عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1677","25 - (  1678  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْبَرَاءِ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمَّا لَقِيَ الْمُشْرِكِينَ  يَوْمَ حُنَيْنٍ  نَزَلَ عَنْ بَغْلَتِهِ فَتَرَجَّلَ  .         [3/241]","","Musnad Abi Ya'la al-Mawsili 1678","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن وكيع بن الجراح عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1678","26 - (  1679  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  حَدَّثَنَا  ابْنُ أَبِي لَيْلَى ،  عَنْ  حَفْصَةَ بِنْتِ عَازِبٍ ،  عَنِ  الْبَرَاءِ  ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسْأَلُهُ عَنْ مَوَاقِيتِ الصَّلَاةِ  ؟ فَأَمَرَ  بِلَالًا  ، فَقَدَّمَ وَأَخَّرَ ، وَقَالَ : الْوَقْتُ مَا بَيْنَهُمَا  .","","Musnad Abi Ya'la al-Mawsili 1679","","البراء بن عازب الأوسي عن حفصة بنت البراء بن عازب عن محمد بن عبد الرحمن بن أبي ليلى عن أبو معاوية الضرير عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1679","27 - (  1680  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ،  حَدَّثَنَا  بَهْزٌ ،  حَدَّثَنَا  شُعْبَةُ ،  أَخْبَرَنِي  الْحَكَمُ بْنُ عُتَيْبَةَ ، قَالَ :  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ أَبِي لَيْلَى  يُحَدِّثُ         [3/242]      عَنِ  الْبَرَاءِ ، قَالَ :  كَانَ رُكُوعُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ ، وَإِذَا سَجَدَ ، وَبَيْنَ السَّجْدَتَيْنِ قَرِيبًا مِنَ السَّوَاءِ  .","","Musnad Abi Ya'la al-Mawsili 1680","","البراء بن عازب الأوسي عن عبد الرحمن بن أبي ليلى عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن بهز بن أسد عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1680","28 - (  1681  ) -  وَحَدَّثَنَا  أَحْمَدُ ،  حَدَّثَنَا  أَبُو دَاوُدَ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ، قَالَ :  سَمِعْتُ  ابْنَ أَبِي لَيْلَى  يُحَدِّثُ ، عَنِ  الْبَرَاءِ ، قَالَ :  كَانَتْ صَلَاةُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا رَكَعَ ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ ، وَإِذَا سَجَدَ  ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ السَّجْدَتَيْنِ قَرِيبًا مِنَ السَّوَاءِ  .         [3/243]","","Musnad Abi Ya'la al-Mawsili 1681","","البراء بن عازب الأوسي عن عبد الرحمن بن أبي ليلى عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن أبو داود الطيالسي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1681","29 - (  1682  ) -  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  حَدَّثَنَا  يُونُسُ يَعْنِي ابْنَ مُحَمَّدٍ ،  حَدَّثَنَا  يُونُسُ بْنُ عَمْرٍو ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  أَبِيهِ عَبْدِ اللهِ بْنِ مَسْعُودٍ  ، أَنَّهُ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا اضْطَجَعَ لِيَنَامَ وَضَعَ يَدَهُ الْيُمْنَى تَحْتَ خَدِّهِ الْأَيْمَنِ ، وَقَالَ :  اللَّهُمَّ قِنِي عَذَابَكَ يَوْمَ تَجْمَعُ عِبَادَكَ  .","","Musnad Abi Ya'la al-Mawsili 1682","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن يونس بن بكير عن عقبة بن مكرم عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1682","30 - (  1683  ) -  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  حَدَّثَنَا  يُونُسُ ،  حَدَّثَنَا  يُونُسُ بْنُ عَمْرٍو ، قَالَ :  قَالَ  أَبِي  ،  حَدَّثَنَا  الْبَرَاءُ بْنُ عَازِبٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ ، غَيْرَ أَنَّهُ قَالَ :  يَوْمَ تَبْعَثُ عِبَادَكَ  .         [3/244]","","Musnad Abi Ya'la al-Mawsili 1683","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1683","31 - (  1684  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَرْعَرَةَ بْنِ الْبِرِنْدِ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ أَبَانَ ،  حَدَّثَنِي  مَسْعُودُ بْنُ سَعْدٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  الْبَرَاءِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  حَقٌّ عَلَى الْمُسْلِمِينَ أَنْ يَغْتَسِلُوا يَوْمَ الْجُمُعَةِ  .","","Musnad Abi Ya'la al-Mawsili 1684","","البراء بن عازب الأوسي عن عبد الرحمن بن أبي ليلى عن يزيد بن أبي زياد القرشي عن مسعود بن سعد الجعفي عن إسماعيل بن أبان عن إبراهيم بن محمد بن عرعرة عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1684","32 - (  1685  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  حَدَّثَنَا  خَالِدٌ ،  عَنْ  عَوْفٍ ،  عَنْ  أَبِي عَبْدِ اللهِ مَيْمُونٍ ،  عَنِ  الْبَرَاءِ ، قَالَ :  أَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِحَفْرِ  الْخَنْدَقِ  قَالَ : عَرَضَ لَنَا صَخْرَةٌ لَا تَأْخُذُ فِيهَا الْمَعَاوِلُ ، فَشَكَوْا ذَلِكَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ : فَأَخَذَ  الْمِعْوَلَ  ، قَالَ :  وَأَحْسَبُهُ ، قَالَ : وَضَعَ ثَوْبَهُ  فَضَرَبَ ضَرْبَةً ، وَقَالَ : بِاسْمِ اللهِ ، فَكَسَرَ ثُلُثَ الصَّخْرَةِ ، ثُمَّ قَالَ :  اللهُ أَكْبَرُ ، أُعْطِيتُ مَفَاتِيحَ  الشَّامِ  ، إِنِّي لَأَنْظُرُ إِلَى قُصُورِهَا الْحُمْرِ مِنْ مَكَانِي هَذَا  ، ثُمَّ قَالَ : بِاسْمِ اللهِ ، وَضَرَبَ أُخْرَى فَكَسَرَ ثُلُثَهَا ، وَقَالَ : اللهُ أَكْبَرُ ، أُعْطِيتُ مَفَاتِيحَ         [3/245]      فَارِسَ  ، وَاللهِ إِنِّي لَأَنْظُرُ إِلَى الْمَدَائِنِ وَقَصْرِهَا الْأَبْيَضِ مِنْ مَكَانِي هَذَا ، ثُمَّ قَالَ : بِاسْمِ اللهِ ، وَضَرَبَ أُخْرَى فَكَسَرَ بَقِيَّةَ الْحَجَرِ ، وَقَالَ : اللهُ أَكْبَرُ ، أُعْطِيتُ مَفَاتِيحَ  الْيَمَنِ  ، وَاللهِ إِنِّي لَأَنْظُرُ إِلَى مَفَاتِيحِ  صَنْعَاءَ  مِنْ مَكَانِي هَذَا  .","","Musnad Abi Ya'la al-Mawsili 1685","","البراء بن عازب الأوسي عن ميمون الكندي مولى عبد الرحمن بن سمرة عن عوف بن أبي جميلة عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1685","33 - (  1686  ) -  حَدَّثَنَا  خَالِدُ بْنُ مِرْدَاسٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عُتْبَةَ بْنِ أَبِي حَكِيمٍ ،  عَنْ  طَلْحَةَ بْنِ نَافِعٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَةَ ،  عَنِ  الْبَرَاءِ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  زَيِّنُوا  الْقُرْآنَ بِأَصْوَاتِكُمْ  .         [3/246]","","Musnad Abi Ya'la al-Mawsili 1686","","البراء بن عازب الأوسي عن عبد الرحمن بن عوسجة النهمي عن طلحة بن نافع العراقي عن عتبة بن أبي حكيم عن إسماعيل بن عياش الأحول عن خالد بن مرداس البغدادي عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1686","34 - (  1687  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  حَدَّثَنَا  قَنَانُ بْنُ عَبْدِ اللهِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَةَ ،         [3/247]      عَنِ  الْبَرَاءِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَفْشُوا السَّلَامَ تَسْلَمُوا ، وَالْأَشَرَةُ شَرٌّ  .  قَالَ  أَبُو مُعَاوِيَةَ  :  يَعْنِي كَثْرَةَ الْعَبَثِ  .","","Musnad Abi Ya'la al-Mawsili 1687","","البراء بن عازب الأوسي عن عبد الرحمن بن عوسجة النهمي عن قنان بن عبد الله النهمي عن أبو معاوية الضرير عن إسحاق بن إسماعيل الطالقاني عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1687","35 - (  1688  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الْمَوْصِلِيُّ ،  حَدَّثَنَا  أَبُو عَلِيٍّ صَالِحُ بْنُ عُمَرَ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ قَالَ         [3/248]      لِلْمَدِينَةِ  يَثْرِبَ ، فَلْيَسْتَغْفِرِ اللهَ  .","","Musnad Abi Ya'la al-Mawsili 1688","","البراء بن عازب الأوسي عن عبد الرحمن بن أبي ليلى عن يزيد بن أبي زياد القرشي عن صالح بن عمر الواسطي عن أحمد بن إبراهيم بن خالد عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1688","36 - (  1689  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  ابْنُ أَبِي لَيْلَى ،  عَنِ  الْحَكَمِ ، وَعِيسَى ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  الْبَرَاءِ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا افْتَتَحَ الصَّلَاةَ رَفَعَ يَدَيْهِ ، ثُمَّ لَا يَرْفَعُ حَتَّى يَنْصَرِفَ  .","","Musnad Abi Ya'la al-Mawsili 1689","","البراء بن عازب الأوسي عن عبد الرحمن بن أبي ليلى عن عيسى بن عبد الرحمن بن أبي ليلى عن محمد بن عبد الرحمن بن أبي ليلى عن وكيع بن الجراح عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1689","37 - (  1690  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  الْبَرَاءِ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا افْتَتَحَ الصَّلَاةَ رَفَعَ يَدَيْهِ نَحْوَ رَأْسِهِ ، ثُمَّ لَا يَعُودُ  .","","Musnad Abi Ya'la al-Mawsili 1690","","البراء بن عازب الأوسي عن عبد الرحمن بن أبي ليلى عن يزيد بن أبي زياد القرشي عن شريك بن عبد الله النخعي عن إسحاق بن عيسى بن نجيح عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1690","38 - (  1691  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،         [3/249]      عَنِ  الْبَرَاءِ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ افْتَتَحَ الصَّلَاةَ كَبَّرَ  ، وَرَفَعَ يَدَيْهِ حَتَّى كَادَتَا تُحَاذِيَانِ أُذُنَيْهِ ، ثُمَّ لَمْ يُعِدْ  .","","Musnad Abi Ya'la al-Mawsili 1691","","البراء بن عازب الأوسي عن عبد الرحمن بن أبي ليلى عن يزيد بن أبي زياد القرشي عن هشيم بن بشير عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1691","39 - (  1692  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  ابْنُ إِدْرِيسَ ، قَالَ :  سَمِعْتُ  يَزِيدَ بْنَ أَبِي زِيَادٍ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنِ  الْبَرَاءِ قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَفَعَ يَدَيْهِ حِينَ اسْتَقْبَلَ الصَّلَاةَ  ، حَتَّى رَأَيْتُ إِبْهَامَيْهِ قَرِيبًا مِنْ أُذُنَيْهِ ، ثُمَّ لَمْ يَرْفَعْهُمَا  .","","Musnad Abi Ya'la al-Mawsili 1692","","البراء بن عازب الأوسي عن عبد الرحمن بن أبي ليلى عن يزيد بن أبي زياد القرشي عن عبد الله بن إدريس الأودي عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1692","40 - (  1693  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  حَدَّثَنَا  حُدَيْجُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ :  غَزَوْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَمْسَ عَشْرَةَ غَزْوَةً  .","","Musnad Abi Ya'la al-Mawsili 1693","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن حديج بن معاوية بن حديج  الجعفي عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1693","[3/250]      41 - (  1694  ) -  قَالَ  :  وَسَمِعْتُ  زَيْدَ بْنَ أَرْقَمَ يَقُولُ :  غَزَوْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِضْعَ  عَشْرَةَ غَزْوَةً  .","","Musnad Abi Ya'la al-Mawsili 1694","","زيد بن أرقم الأنصاري عن أبو إسحاق السبيعي عن حديج بن معاوية بن حديج  الجعفي عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1694","42 - (  1695  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  مُطَرِّفٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْبَرَاءِ ، قَالَ :  عُرِضْتُ  يَوْمَ بَدْرٍ  عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَا  وَابْنُ عُمَرَ  ، فَاسْتَصْغَرَنَا  ، وَشَهِدْنَا  يَوْمَ أُحُدٍ  .         [3/251]","","Musnad Abi Ya'la al-Mawsili 1695","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن مطرف بن طريف عن عبد الله بن إدريس الأودي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1695","43 - (  1696  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  فِرَاسٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  الْبَرَاءِ ، قَالَ :  تُوُفِّيَ  إِبْرَاهِيمُ ابْنُ النَّبِيِّ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ ابْنُ سِتَّةَ عَشَرَ شَهْرًا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ادْفِنُوهُ  بِالْبَقِيعِ  ، فَإِنَّ لَهُ مُرْضِعًا تُتِمُّ رَضَاعَهُ فِي الْجَنَّةِ  .","","Musnad Abi Ya'la al-Mawsili 1696","","البراء بن عازب الأوسي عن الشعبي عن فراس بن يحيى الخارفي عن سفيان الثوري عن معاوية بن هشام القصار عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1696","44 - (  1697  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  حَدَّثَنَا  أَبُو         [3/252]      الْأَحْوَصِ ،  حَدَّثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  حَدَّثَنَا  الْبَرَاءُ بْنُ عَازِبٍ ، وَكَانَ  غَيْرَ كَذُوبٍ  ، قَالَ :  كُنَّا نُصَلِّي خَلْفَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَإِذَا قَالَ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ  ، لَمْ  يَحْنِ  أَحَدٌ مِنَّا ظَهْرَهُ حَتَّى يَضَعَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَبْهَتَهُ إِلَى الْأَرْضِ ، فَإِذَا وَضَعَ جَبْهَتَهُ إِلَى الْأَرْضِ خَرَرْنَا سُجُودًا  .","","Musnad Abi Ya'la al-Mawsili 1697","","البراء بن عازب الأوسي عن عبد الله بن يزيد بن زيد الخطمي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1697","45 - (  1698  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى الْوَاسِطِيُّ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْبَرَاءِ ، قَالَ :  مَرَّ بِنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقُدُورُنَا تَغْلِي مِنْ لُحُومِ الْحُمُرِ ، فَأَمَرَنَا أَنْ نَكْفِئَهَا فَأَكْفَأْنَاهَا .         [3/253]","","Musnad Abi Ya'la al-Mawsili 1698","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1698","46 - (  1699  ) -  وَعَنِ  الْبَرَاءِ ، قَالَ :  مَا رَأَيْنَا أَحَدًا فِي  حُلَّةٍ  حَمْرَاءَ مُتَرَجِّلًا أَجْمَلَ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ لَهُ شَعَرٌ قَرِيبًا مِنْ مَنْكِبَيْهِ  .         [3/254]","","Musnad Abi Ya'la al-Mawsili 1699","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1699","47 - (  1700  ) -  حَدَّثَنَا  زَكَرِيَّا ،  حَدَّثَنَا  أَبُو وَكِيعٍ ،  عَنْ  أَبِي إِسْحَاقَ ،         [3/255]      عَنِ  الْبَرَاءِ ، قَالَ :  مَا رَأَيْتُ ذَا  لِمَّةٍ  فِي  حُلَّةٍ  أَحْسَنَ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  .","","Musnad Abi Ya'la al-Mawsili 1700","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن الجراح بن مليح الرؤاسي والد وكيع عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1700","48 - (  1701  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  حَدَّثَنَا  صَالِحُ بْنُ عُمَرَ ،  حَدَّثَنَا  يَزِيدُ بْنُ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  الْبَرَاءِ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا افْتَتَحَ الصَّلَاةَ رَفَعَ يَدَيْهِ حَتَّى يُحَاذِيَ بِهِمَا أُذُنَيْهِ  ، فَذَكَرْتُ ذَلِكَ  لِعَدِيِّ بْنِ ثَابِتٍ  ، فَقَالَ : قَدْ سَمِعْتُ  الْبَرَاءَ  يَذْكُرُ ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 1701","","البراء بن عازب الأوسي عن عبد الرحمن بن أبي ليلى عن يزيد بن أبي زياد القرشي عن صالح بن عمر الواسطي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1701","49 - (  1702  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  حَدَّثَنَا  يَحْيَى بْنُ زَكَرِيَّا ، قَالَ :  حَدَّثَنِي  أَبُو يَعْقُوبَ الثَّقَفِيُّ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ، مَوْلَى مُحَمَّدِ بْنِ الْقَاسِمِ ،  قَالَ  :  أَرْسَلَنِي  مُحَمَّدُ بْنُ الْقَاسِمِ  إِلَى الْبَرَاءِ بْنِ عَازِبٍ أَسْأَلُهُ عَنْ رَايَةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَا كَانَتْ ؟  قَالَ : كَانَتْ سَوْدَاءَ مُرَبَّعَةً مِنْ  نَمِرَةٍ  .         [3/256]","","Musnad Abi Ya'la al-Mawsili 1702","","البراء بن عازب الأوسي عن يونس بن عبيد الثقفي عن إسحاق بن إبراهيم الثقفي عن يحيى بن زكريا بن أبي زائدة عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1702","50 - (  1703  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْبَرَاءِ ، قَالَ :  كَانَ فِيمَا اشْتَرَطُوا عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَلَّا يَدْخُلُوا  مَكَّةَ  إِلَّا  بِجُلُبَّانِ  السِّلَاحِ  ، قَالَ : وَمَا  جُلُبَّانُ  السِّلَاحِ ؟ قَالَ :  الْقِرَابُ  وَمَا فِيهِ  .         [3/257]","","Musnad Abi Ya'la al-Mawsili 1703","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1703","51 - (  1704  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ الْكُوفِيُّ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ إِيَادٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْبَرَاءِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كَيْفَ تَقُولُونَ بِفَرَحِ رَجُلٍ انْفَلَتَتْ مِنْهُ رَاحِلَتُهُ تَجُرُّ زِمَامَهَا بِأَرْضٍ قَفْرٍ لَيْسَ بِهَا طَعَامٌ وَلَا شَرَابٌ  وَعَلَيْهَا لَهُ الطَّعَامُ وَالشَّرَابُ ، فَطَلَبَهَا حَتَّى شَقَّ عَلَيْهِ ، ثُمَّ مَرَّتْ  بِجِذْلِ  شَجَرَةٍ ، فَتَعَلَّقَ زِمَامُهَا فَوَجَدَهَا مُتَعَلِّقَةً بِهِ ؟ قُلْنَا : شَدِيدًا يَا رَسُولَ اللهِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَلَّهُ أَشَدُّ  فَرَحًا  بِتَوْبَةِ عَبْدِهِ مِنَ الرَّجُلِ بِرَاحِلَتِهِ  .         [3/258]","","Musnad Abi Ya'la al-Mawsili 1704","","البراء بن عازب الأوسي عن إياد بن لقيط السدوسي عن عبيد الله بن إياد بن لقيط السدوسي عن جعفر بن حميد زنبقة عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1704","52 - (  1705  ) -  حَدَّثَنَا  مُحْرِزُ بْنُ عَوْنٍ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْبَرَاءِ ، قَالَ :  مَا رَأَيْتُ أَحَدًا فِي  حُلَّةٍ  حَمْرَاءَ أَجْمَلَ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُتَرَجِّلًا  ، كَانَ لَهُ شَعَرٌ قَرِيبٌ مِنْ  أُذُنَيْهِ ، أَوْ قَالَ : مَنْكِبَيْهِ  ،  الشَّكُّ مِنْ  مُحْرِزٍ  .","","Musnad Abi Ya'la al-Mawsili 1705","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن محرز بن عون الهلالي عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1705","53 - (  1706  ) -  حَدَّثَنَا  زِيَادُ بْنُ أَيُّوبَ ،  حَدَّثَنَا  أَبُو يَحْيَى الْحِمَّانِيُّ ،  حَدَّثَنَا  مَالِكُ بْنُ مِغْوَلٍ ، وَالْحَسَنُ بْنُ عُمَارَةَ ، وَفِطْرٌ ،  عَنْ  إِسْمَاعِيلَ بْنِ رَجَاءٍ ،  عَنْ  أَوْسِ بْنِ ضَمْعَجٍ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  زَيِّنُوا  الْقُرْآنَ بِأَصْوَاتِكُمْ  .","","Musnad Abi Ya'la al-Mawsili 1706","","البراء بن عازب الأوسي عن أوس بن ضمعج الحضرمي عن إسماعيل بن رجاء الزبيدي عن فطر بن خليفة عن عبد الحميد بن عبد الرحمن بشمين عن دلويه زياد بن أيوب عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1706","54 - (  1707  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ الْكُوفِيُّ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ إِيَادٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا سَجَدْتَ فَضَعْ كَفَّيْكَ وَارْفَعْ مِرْفَقَيْكَ  .         [3/259]","","Musnad Abi Ya'la al-Mawsili 1707","","البراء بن عازب الأوسي عن إياد بن لقيط السدوسي عن عبيد الله بن إياد بن لقيط السدوسي عن جعفر بن حميد زنبقة عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1707","55 - (  1708  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ مَنْصُورٍ ،  عَنْ  أَبِي رَجَاءٍ الْخُرَاسَانِيِّ عَبْدِ اللهِ بْنِ وَاقِدٍ ،  عَنْ  مُحَمَّدِ بْنِ مَالِكٍ ،  قَالَ  :  رَأَيْتُ عَلَى الْبَرَاءِ خَاتَمًا مِنْ ذَهَبٍ ، فَقِيلَ لَهُ مِنْ أَجْلِهِ ، قَالَ : قَسَمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَفَضَلَ هَذَا الْخَاتَمُ  ، فَقَالَ : مَنْ تَرَوْنَ أَحَقُّ بِهَذَا ؟ ثُمَّ قَالَ : ادْنُ يَا  بَرَاءُ  ، فَأَلْبَسَنِي فِي إِصْبَعِي ، وَقَالَ : الْبَسْ مَا كَسَاكَ اللهُ وَرَسُولُهُ  .         [3/260]","","Musnad Abi Ya'la al-Mawsili 1708","","البراء بن عازب الأوسي عن محمد بن مالك الجوزجاني عن عبد الله بن واقد بن الحارث الخراساني عن إسحاق بن منصور السلولي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1708","56 - (  1709  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنِ  الْبَرَاءِ قَالَ :  الْغَنَمُ بَرَكَةٌ  .","","Musnad Abi Ya'la al-Mawsili 1709","","البراء بن عازب الأوسي عن عبد الرحمن بن أبي ليلى عن عبد الله بن عبد الله الهاشمي عن الأعمش عن أبو معاوية الضرير عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1709","57 - (  1710  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ الْهَمْدَانِيِّ ، قَالَ :  سَمِعْتُ  الْبَرَاءَ بْنَ عَازِبٍ ، قَالَ :  لَمَّا أَقْبَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ         [3/261]      مَكَّةَ  إِلَى  الْمَدِينَةِ  تَبِعَهُ  سُرَاقَةُ بْنُ جُعْشُمٍ  ، فَدَعَا عَلَيْهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  فَسَاخَتْ  بِهِ فَرَسُهُ ، فَقَالَ : ادْعُ اللهَ لِي وَلَا أَضُرُّكَ ، فَدَعَا لَهُ ، فَعَطِشَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَمَرُّوا بِرَاعٍ ،  فَقَالَ  أَبُو بَكْرٍ الصِّدِّيقُ : فَأَخَذْتُ قَدَحًا فَحَلَبْتُ فِيهِ  كُثْبَةً  مِنْ لَبَنٍ ، فَأَتَيْتُهُ ، فَشَرِبَ ، ثُمَّ شَرِبَ حَتَّى رَضِيتُ  .","","Musnad Abi Ya'la al-Mawsili 1710","","أبو  بكر الصديق عن البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1710","58 - (  1711  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ، وَرَجُلٍ آخَرَ ،  عَنِ  الْبَرَاءِ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَرَادَ أَنْ يَنَامَ تَوَسَّدَ يَمِينَهُ ، وَيَقُولُ :  اللَّهُمَّ قِنِي عَذَابَكَ يَوْمَ تَجْمَعُ عِبَادَكَ  .  59 - (  1712  ) - قَالَ  شُعْبَةُ  : قَالَ  أَبُو إِسْحَاقَ  : وَقَالَ  أَبُو الْأَحْوَصِ  : يَوْمَ تَبْعَثُ عِبَادَكَ .","","Musnad Abi Ya'la al-Mawsili 1711","","البراء بن عازب الأوسي عن رجل آخر عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1711","60 - (  1713  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ، قَالَ :         [3/262]      سَمِعْتُ  الْبَرَاءَ ، قَالَ :  لَمَّا صَالَحَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَهْلَ  مَكَّةَ  ، كَتَبَ  عَلِيٌّ  بَيْنَهُمْ كِتَابًا  فَكَتَبَ :  مُحَمَّدٌ  رَسُولُ اللهِ ، فَقَالَ الْمُشْرِكُونَ : لَا تَكْتُبْ  مُحَمَّدٌ  رَسُولُ اللهِ ، لَوْ كُنْتَ رَسُولَ اللهِ لَمْ نُقَاتِلْكَ ، قَالَ  لِعَلِيٍّ  : امْحُهُ ، فَقَالَ  عَلِيٌّ  : مَا أَنَا بِالَّذِي أَمْحُوهُ ، فَمَحَاهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِيَدِهِ ، فَصَالَحَهُمْ عَلَى أَنْ يَدْخُلَهَا هُوَ وَأَصْحَابُهُ ثَلَاثَةَ أَيَّامٍ ، وَلَا يَدْخُلَهَا إِلَّا  بِجُلُبَّانِ  السِّلَاحِ ، فَسَأَلُوهُ مَا  جُلُبَّانُ  السِّلَاحِ ؟ قَالَ :  الْقِرَابُ  وَمَا فِيهِ  .","","Musnad Abi Ya'la al-Mawsili 1713","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1712","61 - (  1714  ) -  قَالَ :  وَسَمِعْتُ  أَبَا إِسْحَاقَ قَالَ :  سَمِعْتُ  الْبَرَاءَ بْنَ عَازِبٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَجُلًا  مَرْبُوعًا  ، بَعِيدَ مَا بَيْنَ الْمَنْكِبَيْنِ  ، عَظِيمَ  الْجُمَّةِ  إِلَى  شَحْمَةِ  أُذُنَيْهِ ، عَلَيْهِ  حُلَّةٌ  حَمْرَاءُ ، مَا رَأَيْتُ شَيْئًا قَطُّ أَحْسَنَ مِنْهُ  .","","Musnad Abi Ya'la al-Mawsili 1714","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1713","62 - (  1715  ) -  وَبِإِسْنَادِهِ  ،  عَنْ  أَبِي إِسْحَاقَ ، قَالَ :  سَمِعْتُ  الْبَرَاءَ بْنَ عَازِبٍ ، قَالَ :  كَانَ أَوَّلُ مَنْ قَدِمَ مِنْ أَصْحَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مُصْعَبَ بْنَ عُمَيْرٍ  ،  وَابْنَ أُمِّ مَكْتُومٍ  ، فَكَانُوا يُقْرِئُونَ النَّاسَ  ، قَالَ : فَقَدِمَ  بِلَالٌ  ،  وَسَعِيدٌ  ،  وَعَمَّارُ بْنُ يَاسِرٍ  ، قَالَ : ثُمَّ قَدِمَ  عُمَرُ بْنُ الْخَطَّابِ  فِي عِشْرِينَ مِنْ أَصْحَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، ثُمَّ         [3/263]      قَدِمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَمَا رَأَيْتُ أَهْلَ  الْمَدِينَةِ  فَرِحُوا بِشَيْءٍ فَرَحَهُمْ بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ : حَتَّى جَعَلَ الْإِمَاءُ يَقُلْنَ : قَدِمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ : فَمَا قَدِمَ حَتَّى قَرَأْتُ بِـ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      ، فِي سُوَرٍ مِنَ الْمُفَصَّلِ  .","","Musnad Abi Ya'la al-Mawsili 1715","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1714","63 - (  1716  ) -  وَبِإِسْنَادِهِ  ، قَالَ :  سَمِعْتُ  الْبَرَاءَ ، قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْقُلُ التُّرَابَ ، وَلَقَدْ وَارَى التُّرَابُ بَطْنَهُ  وَهُوَ يَقُولُ :         [3/264]      وَرُبَّمَا قَالَ :  يَرْفَعُ بِهَا صَوْتَهُ  .","","Musnad Abi Ya'la al-Mawsili 1716","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1715","64 - (  1717  ) -  وَبِإِسْنَادِهِ  ،  عَنِ  الْبَرَاءِ ، قَالَ :  مَرَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِقَوْمٍ جُلُوسٍ فِي الطَّرِيقِ  ، فَقَالَ : إِنْ كُنْتُمْ لَا بُدَّ فَاعِلِينَ فَاهْدُوا السَّبِيلَ ، وَرُدُّوا السَّلَامَ ، وَأَعِينُوا الْمَظْلُومَ  .         [3/265]","","Musnad Abi Ya'la al-Mawsili 1717","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1716","65 - (  1718  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْبَرَاءِ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، بِمِثْلِهِ .  قَالَ  شُعْبَةُ  : قُلْتُ  لِأَبِي إِسْحَاقَ  : أَسَمِعْتَهُ مِنَ  الْبَرَاءِ  ؟ قَالَ : لَا  .","","Musnad Abi Ya'la al-Mawsili 1718","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1717","66 - (  1719  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ قَالَ :  قَالَ  الْبَرَاءُ بْنُ عَازِبٍ :  مَاتَ نَاسٌ مِنْ أَصْحَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُمْ يَشْرَبُونَ الْخَمْرَ  ، فَلَمَّا نَزَلَ تَحْرِيمُهَا قَالَ أُنَاسٌ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : وَكَيْفَ بِأَصْحَابِنَا الَّذِينَ مَاتُوا وَهُمْ يَشْرَبُونَهَا ؟ فَنَزَلَتْ         {      لَيْسَ عَلَى الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جُنَاحٌ فِيمَا طَعِمُوا إِذَا مَا اتَّقَوْا وَآمَنُوا         }      .         [3/266]","","Musnad Abi Ya'la al-Mawsili 1719","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1718","67 - (  1720  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  شُعْبَةُ  عَنْ  أَبِي إِسْحَاقَ  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ مِثْلَهُ .  قَالَ  شُعْبَةُ  : قُلْتُ : أَسَمِعْتَهُ مِنَ  الْبَرَاءِ  ؟ قَالَ : لَا  .","","Musnad Abi Ya'la al-Mawsili 1720","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1719","68 - (  1721  ) -  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  أَنَّهُ سَمِعَ  الْبَرَاءَ بْنَ عَازِبٍ ، يَقُولُ :  أَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَجُلًا  إِذَا أَخَذَ مَضْجَعَهُ أَنْ يَقُولَ : اللَّهُمَّ أَسْلَمْتُ نَفْسِي إِلَيْكَ ، وَوَجَّهْتُ وَجْهِي إِلَيْكَ  ،  وَفَوَّضْتُ  أَمْرِي إِلَيْكَ ، وَأَلْجَأْتُ ظَهْرِي إِلَيْكَ ،  رَغْبَةً  وَرَهْبَةً  إِلَيْكَ ، لَا مَلْجَأَ وَلَا مَنْجَى مِنْكَ إِلَّا إِلَيْكَ ، آمَنْتُ بِكِتَابِكَ الَّذِي أَنْزَلْتَ ، وَبِنَبِيِّكَ الَّذِي أَرْسَلْتَ ، فَإِنْ مَاتَ مَاتَ عَلَى الْفِطْرَةِ  .         [3/267]","","Musnad Abi Ya'la al-Mawsili 1721","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1720","69 - (  1722  ) -  وَبِهِ  ،  عَنْ  أَبِي إِسْحَاقَ ، قَالَ :  سَمِعْتُ  الْبَرَاءَ ، يَقُولُ :  قَرَأَ رَجُلٌ الْكَهْفَ وَفِي الدَّارِ دَابَّةٌ فَجَعَلَتْ تَنْفِرُ فَسَلَّمَ ، فَإِذَا ضَبَابَةٌ أَوْ سَحَابَةٌ قَدْ غَشِيَتْهُ ، فَذَكَرَهُ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  اقْرَأْ فُلَانُ ، فَإِنَّهَا  السَّكِينَةُ  نَزَلَتْ عِنْدَ الْقُرْآنِ ، أَوْ تَنَزَّلَتْ لِلْقُرْآنِ  .","","Musnad Abi Ya'la al-Mawsili 1722","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1721","70 - (  1723  ) -  وَبِهِ  عَنْ  أَبِي إِسْحَاقَ قَالَ :         [3/268]      سَمِعْتُ  الْبَرَاءَ يَقُولُ :  آخِرُ آيَةٍ نَزَلَتِ الْكَلَالَةُ ، وَآخِرُ سُورَةٍ نَزَلَتْ بَرَاءَةٌ  .","","Musnad Abi Ya'la al-Mawsili 1723","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1722","71 - (  1724  ) -  وَبِهِ  عَنْ  أَبِي إِسْحَاقَ  أَنَّهُ سَمِعَ  الْبَرَاءَ بْنَ عَازِبٍ يَقُولُ :  اسْتُصْغِرْتُ  يَوْمَ بَدْرٍ  أَنَا  وَابْنُ عُمَرَ  وَكَانَتِ  الْمُهَاجِرُونَ  نَيِّفًا عَلَى السِّتِّينَ ،  وَالْأَنْصَارُ  نَيِّفًا عَلَى الْمِائَتَيْنِ وَأَرْبَعِينَ  .         [3/269]","","Musnad Abi Ya'la al-Mawsili 1724","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1723","72 - (  1725  ) -  وَبِإِسْنَادِهِ  ،  عَنْ  أَبِي إِسْحَاقَ ،  أَنَّهُ سَمِعَ  الْبَرَاءَ يَقُولُ فِي هَذِهِ الْآيَةِ :         {      لا يَسْتَوِي الْقَاعِدُونَ مِنَ الْمُؤْمِنِينَ غَيْرُ أُولِي الضَّرَرِ وَالْمُجَاهِدُونَ فِي سَبِيلِ اللهِ         }      ، قَالَ : فَأَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  زَيْدًا ،  فَجَاءَ بِكَتِفٍ ، قَالَ : فَشَكَا  ابْنُ أُمِّ مَكْتُومٍ  ضَرَارَتَهُ ،  فَنَزَلَتْ :         {      لا يَسْتَوِي الْقَاعِدُونَ مِنَ الْمُؤْمِنِينَ غَيْرُ أُولِي الضَّرَرِ         }      .         [3/270]","","Musnad Abi Ya'la al-Mawsili 1725","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1724","73 - (  1726  ) -  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَبِيهِ  ،  عَنْ  رَجُلٍ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ ، فِي هَذِهِ الْآيَةِ         {      لا يَسْتَوِي الْقَاعِدُونَ         }      ، مِثْلَ حَدِيثِ  الْبَرَاءِ  .         [3/271]","","Musnad Abi Ya'la al-Mawsili 1726","","زيد بن ثابت الأنصاري عن رجل عن إبراهيم بن عبد الرحمن بن عوف عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1725","74 - (  1727  ) -  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ، قَالَ :  سَمِعْتُ  الْبَرَاءَ ،  وَسَأَلَهُ  رَجُلٌ مِنْ قَيْسٍ ،  قَالَ : أَفَرَرْتُمْ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ حُنَيْنٍ  ؟ فَقَالَ  الْبَرَاءُ  : لَكِنَّ رَسُولَ اللهِ لَمْ يَفِرَّ ، كَانَتْ  هَوَازِنُ  نَاسًا رُمَاةً ، وَإِنَّا لَمَّا حَمَلْنَا عَلَيْهِمْ ، فَأَكْبَبْنَا عَلَى الْغَنَائِمِ ، فَاسْتَقْبَلُونَا بِالسِّهَامِ ، وَلَقَدْ رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى بَغْلَتِهِ الشَّهْبَاءِ ، وَإِنَّ  أَبَا سُفْيَانَ بْنَ الْحَارِثِ  آخِذٌ بِلِجَامِهَا ، وَهُوَ يَقُولُ :  أَنَا النَّبِيُّ لَا كَذِبْ أَنَا ابْنُ  عَبْدِ الْمُطَّلِبْ .         [3/272]","","Musnad Abi Ya'la al-Mawsili 1727","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1726","75 - (  1728  ) -  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ، قَالَ :  قَالَ  الْبَرَاءُ :  أَصَبْنَا  يَوْمَ خَيْبَرَ  حُمُرًا ، فَنَادَى مُنَادِي         [3/273]      رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنْ أَكْفِئُوا الْقُدُورَ  .","","Musnad Abi Ya'la al-Mawsili 1728","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1727","76 - (  1729  ) -  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ، قَالَ :  سَمِعْتُ  الرَّبِيعَ بْنَ الْبَرَاءِ ، يَقُولُ :  سَمِعْتُ  الْبَرَاءَ  ، يَقُولُ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا أَقْبَلَ مِنْ سَفَرٍ ، قَالَ :  آيِبُونَ عَابِدُونَ لِرَبِّنَا حَامِدُونَ  .","","Musnad Abi Ya'la al-Mawsili 1729","","البراء بن عازب الأوسي عن الربيع بن البراء بن عازب عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1728","77 - (  1730  ) -  وَبِإِسْنَادِهِ  ،  عَنْ  أَبِي إِسْحَاقَ ، قَالَ :  سَمِعْتُ  الْبَرَاءَ ، يَقُولُ :  أُهْدِيَتْ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  حُلَّةُ  حَرِيرٍ ، فَجَعَلَ أَصْحَابُهُ يَلْمِسُونَهَا ، يَعْجَبُونَ مِنْ لِينِهَا ، فَقَالَ :  تَعْجَبُونَ مِنْ لِينِ هَذِهِ ؟ لَمَنَادِيلُ  سَعْدٍ  فِي الْجَنَّةِ خَيْرٌ مِنْهَا وَأَلْيَنُ  .         [3/274]","","Musnad Abi Ya'la al-Mawsili 1730","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1729","78 - (  1731  ) -  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْبَرَاءِ ، قَالَ :  أُهْدِيَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  حُلَّةُ  حَرِيرٍ ، فَجَعَلَ أَصْحَابُهُ يَلْمِسُونَهَا ، فَقَالَ :  أَتَعْجَبُونَ مِنْ لِينِ هَذَا ؟ لَمَنَادِيلُ  سَعْدٍ  فِي الْجَنَّةِ أَلْيَنُ مِنْ هَذَا  .","","Musnad Abi Ya'la al-Mawsili 1731","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن سفيان الثوري عن يحيى القطان عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1730","79 - (  1732  ) -  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  شُعْبَةُ  عَنْ  أَبِي إِسْحَاقَ قَالَ :  سَمِعْتُ  الْبَرَاءَ يَقُولُ :  كَانَتِ  الْأَنْصَارُ  إِذَا حَجُّوا لَمْ يَدْخُلُوا الْبُيُوتَ إِلَّا مِنْ ظُهُورِهَا  ، فَجَاءَ  رَجُلٌ  مِنَ  الْأَنْصَارِ  فَدَخَلَ مِنْ بَابِهِ         [3/275]      فَقِيلَ لَهُ فِي ذَلِكَ فَنَزَلَتْ :         {      وَلَيْسَ الْبِرُّ بِأَنْ تَأْتُوا الْبُيُوتَ مِنْ ظُهُورِهَا         }      الْآيَةَ  .","","Musnad Abi Ya'la al-Mawsili 1732","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن رافع القشيري عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1731","80 - (  1733  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  قَنَانُ بْنُ عَبْدِ اللهِ النَّهْمِيُّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَةَ ،  عَنِ  الْبَرَاءِ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  وَسَمِعَ  أَبَا مُوسَى  يَقْرَأُ الْقُرْآنَ : كَأَنَّ صَوْتَ هَذَا مِنْ أَصْوَاتِ  آلِ دَاوُدَ  .","","Musnad Abi Ya'la al-Mawsili 1733","","البراء بن عازب الأوسي عن عبد الرحمن بن عوسجة النهمي عن قنان بن عبد الله النهمي عن عبد الرحيم بن سليمان الأشل عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند البراء بن عازب"
"1732","[3/276]      مُسْنَدُ  عُقْبَةَ بْنِ عَامِرٍ الْجُهَنِيِّ  1 - (  1734  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مُعَاوِيَةَ بْنِ صَالِحٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرِ بْنِ نُفَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ ،  أَنَّهُ سَأَلَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الْمُعَوِّذَتَيْنِ ؟ قَالَ  عُقْبَةُ  : فَأَمَّنَا رَسُولُ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِهِمَا فِي صَلَاةِ الْفَجْرِ ، ثُمَّ دَعَانِي فَذَكَرْتُ حَدِيثَهُ فِيهِمَا  .         [3/277]","","Musnad Abi Ya'la al-Mawsili 1734","","عقبة بن عامر بن عبس الفرضي عن جبير بن نفير بن مالك الحضرمي عن عبد الرحمن بن جبير الحضرمي عن معاوية بن صالح بن حدير الحضرمي عن سفيان الثوري عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1733","2 - (  1735  ) -  حَدَّثَنَا  زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  مَرْثَدِ بْنِ عَبْدِ اللهِ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  اقْرَأْ بِهَاتَيْنِ الْآيَتَيْنِ مِنْ آخِرِ سُورَةِ الْبَقَرَةِ ، إِنِّي أُعْطِيتُهُمَا مِنْ تَحْتِ الْعَرْشِ  .         [3/278]","","Musnad Abi Ya'la al-Mawsili 1735","","عقبة بن عامر بن عبس الفرضي عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1734","3 - (  1736  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ بْنِ جَابِرٍ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، قَالَ :  بَيْنَا أَنَا أَقُودُ بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي نَقْبٍ مِنْ تِلْكَ النِّقَابِ ، قَالَ : يَا  عُقْبَ  ، أَلَا تَرْكَبُ ؟ فَأَجْلَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ أَرْكَبَ مَرْكَبَهُ ، ثُمَّ قَالَ : يَا  عُقْبَ  ، أَلَا تَرْكَبُ ؟ فَأَشْفَقْتُ أَنْ تَكُونَ مَعْصِيَةً ، فَنَزَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَرَكِبْتُ هُنَيْهَةً ، ثُمَّ رَكِبَ ، ثُمَّ قَالَ : يَا  عُقْبَ  ،  أَلَا أُعَلِّمُكَ سُورَتَيْنِ مِنْ خَيْرِ السُّورَتَيْنِ قَرَأَ بِهِمَا النَّاسُ ؟ قُلْتُ : بَلَى يَا رَسُولَ اللهِ  ، قَالَ : فَأَقْرَأَنِي : قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ ، وَقُلْ أَعُوذُ بِرَبِّ النَّاسِ ، ثُمَّ أُقِيمَتِ الصَّلَاةُ ، فَتَقَدَّمَ رَسُولُ اللهِ ، فَقَرَأَ بِهِمَا ثُمَّ مَرَّ بِي ، قَالَ : كَيْفَ رَأَيْتَ يَا  عُقْبَ  ؟ اقْرَأْ بِهِمَا كُلَّمَا نِمْتَ وَقُمْتَ  .","","Musnad Abi Ya'la al-Mawsili 1736","","عقبة بن عامر بن عبس الفرضي عن القاسم بن عبد الرحمن الدمشقي عن عبد الرحمن بن يزيد الداراني عن الوليد بن مسلم القرشي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1735","4 - (  1737  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مَعْنُ بْنُ عِيسَى ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  بَحِيرِ بْنِ سَعْدٍ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنْ  كَثِيرِ بْنِ مُرَّةَ ،         [3/279]      عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْمُسِرُّ بِالْقُرْآنِ كَالْمُسِرِّ بِالصَّدَقَةِ ، وَالْجَاهِرُ بِالْقُرْآنِ كَالْجَاهِرِ بِالصَّدَقَةِ  .","","Musnad Abi Ya'la al-Mawsili 1737","","عقبة بن عامر بن عبس الفرضي عن كثير بن مرة الرهاوي عن خالد بن معدان عن بحير بن سعد عن معاوية بن صالح بن حدير الحضرمي عن معن بن عيسى عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1736","5 - (  1738  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  حَدَّثَنَا  مُوسَى بْنُ أَيُّوبَ الْقَارِيُّ ، قَالَ :  حَدَّثَنِي  عَمِّي إِيَاسُ بْنُ عَامِرٍ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، قَالَ :  لَمَّا نَزَلَتْ :         {      فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ         }      ، قَالَ لَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : اجْعَلُوهَا فِي رُكُوعِكُمْ  ، فَلَمَّا نَزَلَتْ :         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      ، قَالَ : اجْعَلُوهَا فِي سُجُودِكُمْ  .         [3/280]","","Musnad Abi Ya'la al-Mawsili 1738","","عقبة بن عامر بن عبس الفرضي عن إياس بن عامر المصري عن موسى بن أيوب بن عامر الغافقي عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1737","6 - (  1739  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  حَدَّثَنَا  حَيْوَةُ ،  أَخْبَرَنِي  بَكْرُ بْنُ عَمْرٍو ، أَنَّ شُعَيْبَ بْنَ زُرْعَةَ  حَدَّثَهُ  ، قَالَ :  حَدَّثَنِي  عُقْبَةُ بْنُ عَامِرٍ ،  أَنَّهُ سَمِعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ لِأَصْحَابِهِ :  لَا تُخِيفُوا أَنْفُسَكُمْ ، أَوْ قَالَ : الْأَنْفُسَ  ، قِيلَ : يَا رَسُولَ اللهِ ، وَبِمَ نُخِيفُ أَنْفُسَنَا ؟ قَالَ : بِالدَّيْنِ  .","","Musnad Abi Ya'la al-Mawsili 1739","","عقبة بن عامر بن عبس الفرضي عن شعيب بن زرعة المعافري عن بكر بن عمرو المعافري عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1738","7 - (  1740  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  حَدَّثَنَا  قَبَاثُ بْنُ رَزِينٍ الْمِصْرِيُّ ، قَالَ :  سَمِعْتُ  عُلَيَّ بْنَ رَبَاحٍ اللَّخْمِيَّ ، قَالَ :  سَمِعْتُ  عُقْبَةَ بْنَ عَامِرٍ الْجُهَنِيَّ ، يَقُولُ :  كُنَّا جُلُوسًا فِي         [3/281]      الْمَسْجِدِ نَقْرَأُ الْقُرْآنَ ، فَدَخَلَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ :  تَعَلَّمُوا كِتَابَ اللهِ وَأَفْشُوهُ  ، قَالَ  قَبَاثٌ  :  حَسِبْتُهُ قَالَ : وَتَغَنَّوْا بِهِ  ، فَوَالَّذِي نَفْسِي بِيَدِهِ لَهُوَ أَشَدُّ تَفَلُّتًا مِنَ الْعِشَارِ مِنَ الْعُقُلِ  .","","Musnad Abi Ya'la al-Mawsili 1740","","عقبة بن عامر بن عبس الفرضي عن علي بن رباح اللخمي عن قباث بن رزين اللخمي عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1739","8 - (  1741  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  بَكْرُ بْنُ يُونُسَ بْنِ بُكَيْرٍ ،  عَنْ  مُوسَى بْنِ عُلَيٍّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تُكْرِهُوا مَرْضَاكُمْ عَلَى الطَّعَامِ وَالشَّرَابِ ، فَإِنَّ اللهَ يُطْعِمُهُمْ وَيَسْقِيهِمْ  .         [3/282]","","Musnad Abi Ya'la al-Mawsili 1741","","عقبة بن عامر بن عبس الفرضي عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن بكر بن يونس الشيباني عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1740","9 - (  1742  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  أَبِي عَلِيٍّ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، أَنَّهُ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  سَتُفْتَحُ عَلَيْكُمْ أَرَضُونَ ، وَيَكْفِيكُمُ اللهُ ، فَلَا يَعْجِزَنَّ أَحَدُكُمْ أَنْ يَلْهُوَ بِأَسْهُمِهِ  .         [3/283]","","Musnad Abi Ya'la al-Mawsili 1742","","عقبة بن عامر بن عبس الفرضي عن ثمامة بن شفي الهمداني عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1741","10 - (  1743  ) -  حَدَّثَنَا  هَارُونُ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  أَبِي عَلِيٍّ ثُمَامَةَ بْنِ شَفِيٍّ ،  أَنَّهُ سَمِعَ  عُقْبَةَ بْنَ عَامِرٍ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ عَلَى الْمِنْبَرِ ، يَقُولُ :         {      وَأَعِدُّوا لَهُمْ مَا اسْتَطَعْتُمْ مِنْ قُوَّةٍ         }      ،  أَلَا إِنَّ الْقُوَّةَ الرَّمْيُ ، أَلَا إِنَّ الْقُوَّةَ الرَّمْيُ ، أَلَا إِنَّ الْقُوَّةَ الرَّمْيُ  .","","Musnad Abi Ya'la al-Mawsili 1743","","عقبة بن عامر بن عبس الفرضي عن ثمامة بن شفي الهمداني عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1742","11 - (  1744  ) -  حَدَّثَنَا  أَبُو يَحْيَى كَامِلُ بْنُ طَلْحَةَ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنَا  كَعْبُ بْنُ عَلْقَمَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ شِمَاسَةَ الْمَهْرِيِّ ،  عَنْ  أَبِي الْخَيْرِ ،         [3/284]      عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  النَّذْرُ يَمِينٌ ، وَكَفَّارَتُهُ كَفَّارَةُ يَمِينٍ  .","","Musnad Abi Ya'la al-Mawsili 1744","","عقبة بن عامر بن عبس الفرضي عن مرثد بن عبد الله اليزني عن عبد الرحمن بن شماسة المهري عن كعب بن علقمة بن كعب عن عبد الله بن لهيعة عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1743","12 - (  1745  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  مِشْرَحِ بْنِ هَاعَانَ الْمَعَافِرِيِّ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ الْجُهَنِيِّ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَوْ أَنَّ الْقُرْآنَ جُعِلَ فِي  إِهَابٍ ،  ثُمَّ أُلْقِيَ فِي النَّارِ مَا احْتَرَقَتْ  .         [3/285]      قَالَ  أَبُو عَبْدِ الرَّحْمَنِ  : فَفَسَّرَهُ :  أَنَّ مَنْ جَمَعَ الْقُرْآنَ ثُمَّ دَخَلَ النَّارَ ، فَهُوَ شَرٌّ مِنْ خِنْزِيرٍ  .","","Musnad Abi Ya'la al-Mawsili 1745","","عقبة بن عامر بن عبس الفرضي عن مشرح بن هاعان المعافري عن عبد الله بن لهيعة عن عبد الله بن يزيد القصير عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1744","13 - (  1746  ) -  حَدَّثَنَا  أَحْمَدُ ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ، قَالَ :  حَدَّثَنِي  أَبُو قَبِيلٍ حُيَيُّ بْنُ هَانِئٍ الْمَعَافِرِيُّ ، قَالَ :  سَمِعْتُ  عُقْبَةَ بْنَ عَامِرٍ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  هَلَاكُ أُمَّتِي فِي الْكِتَابِ وَاللَّبَنِ ، قَالُوا : وَمَا الْكِتَابُ وَاللَّبَنُ  ؟ قَالَ : يَتَعَلَّمُونَ الْقُرْآنَ فَيَتَأَوَّلُونَهُ عَلَى غَيْرِ تَأْوِيلِهِ ، وَيُحِبُّونَ اللَّبَنَ فَيَدَعُونَ الْجَمَاعَاتِ وَالْجُمَعَ وَيَبْدُونَ  .         [3/286]","","Musnad Abi Ya'la al-Mawsili 1746","","عقبة بن عامر بن عبس الفرضي عن حيي بن هانئ السريعي عن عبد الله بن لهيعة عن عبد الله بن يزيد القصير عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1745","14 - (  1747  ) -  حَدَّثَنَا  أَبُو عَبْدِ اللهِ الدَّوْرَقِيُّ ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ، قَالَ :  حَدَّثَنِي  أَبُو قَبِيلٍ الْمَعَافِرِيُّ ،  عَنْ  أَبِي عُشَّانَةَ الْمَعَافِرِيِّ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ الْجُهَنِيِّ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنْ خَرَجَ مِنْ بَيْتِهِ إِلَى الْمَسْجِدِ كُتِبَتْ لَهُ بِكُلِّ خُطْوَةٍ يَخْطُوهَا عَشْرَ حَسَنَاتٍ  ، وَالْقَاعِدُ فِي الْمَسْجِدِ يَنْتَظِرُ الصَّلَاةَ  كَالْقَانِتِ  ، وَيُكْتَبُ مِنَ الْمُصَلِّينَ حَتَّى يَرْجِعَ إِلَى بَيْتِهِ  .","","Musnad Abi Ya'la al-Mawsili 1747","","عقبة بن عامر بن عبس الفرضي عن حي بن يؤمن أبو عشانة المصري عن حيي بن هانئ السريعي عن عبد الله بن لهيعة عن عبد الله بن يزيد القصير عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1746","15 - (  1748  ) -  حَدَّثَنَا  كَامِلُ بْنُ طَلْحَةَ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  عَنْ  أَبِي الْخَيْرِ ،  عَنْ  عُقْبَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى عَلَى قَتْلَى  أُحُدٍ  بَعْدَ ثَمَانِ سِنِينَ كَالْمُوَدِّعِ لِلْأَحْيَاءِ وَالْأَمْوَاتِ ، فَقَالَ :  إِنَّ بَيْنَ أَيْدِيكُمْ         [3/287]      فَرَطَاتٍ  أَنَا عَلَيْكُمْ شَهِيدٌ  ، وَإِنَّ مَوْعِدَكُمُ الْحَوْضُ ، وَإِنِّي أَنْظُرُ إِلَيْهِ فِي مَكَانِي هَذَا ، وَإِنَّ عَرْضَهُ كَمَا بَيْنَ  أَيْلَةَ  وَالْجُحْفَةَ  ، وَإِنِّي أُتِيتُ  بِمَفَاتِيحِ  خَزَائِنِ الْأَرْضِ وَأَنَا فِي مَقَامِي هَذَا ، وَإِنِّي لَسْتُ أَخَافُ عَلَيْكُمْ أَنْ تُشْرِكُوا ، وَلَكِنِّي أَخَافُ عَلَيْكُمُ الدُّنْيَا أَنْ تَنَافَسُوهَا .  قَالَ  عُقْبَةُ  : فَكَانَ آخِرَ نَظْرَةٍ نَظَرْتُهَا إِلَى         [3/288]      رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad Abi Ya'la al-Mawsili 1748","","عقبة بن عامر بن عبس الفرضي عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1747","16 - (  1749  ) -  حَدَّثَنَا  كَامِلٌ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنَا  أَبُو عُشَّانَةَ ، قَالَ :  سَمِعْتُ  عُقْبَةَ بْنَ عَامِرٍ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  عَجِبَ  رَبُّنَا مِنَ الشَّابِّ الَّذِي لَيْسَتْ لَهُ  صَبْوَةٌ  .         [3/289]","","Musnad Abi Ya'la al-Mawsili 1749","","عقبة بن عامر بن عبس الفرضي عن حي بن يؤمن أبو عشانة المصري عن عبد الله بن لهيعة عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1748","17 - (  1750  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  صَالِحِ بْنِ مُحَمَّدِ بْنِ زَائِدَةَ ،  عَنْ  عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  رَحِمَ اللهُ حَارِسَ الْحَرَسِ  .","","Musnad Abi Ya'la al-Mawsili 1750","","عقبة بن عامر بن عبس الفرضي عن عمر بن عبد العزيز بن مروان عن صالح بن محمد بن زائدة الليثي عن عبد العزيز بن محمد الدراوردي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1749","18 - (  1751  ) -  حَدَّثَنَا  هَارُونُ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  أَخْبَرَ  عَمْرٌو ، أَنَّ هِشَامَ بْنَ أَبِي رُقَيَّةَ  حَدَّثَهُ  ، قَالَ :  سَمِعْتُ  مَسْلَمَةَ بْنَ مُخَلَّدٍ  ، وَهُوَ قَائِمٌ عَلَى الْمِنْبَرِ يَخْطُبُ وَهُوَ يَقُولُ : يَا أَيُّهَا النَّاسُ ، أَمَا لَكُمْ فِي الْعَصْبِ وَالْكَتَّانِ مَا يُغْنِيكُمْ عَنِ الْحَرِيرِ ؟ وَهَذَا رَجُلٌ فِيكُمْ يُخْبِرُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قُمْ يَا  عُقْبَةُ  ، فَقَامَ عُقْبَةُ بْنُ عَامِرٍ ، وَأَنَا أَسْمَعُ ، فَقَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ         [3/290]      مَقْعَدَهُ مِنَ النَّارِ  . وَأَشْهَدُ أَنِّي سَمِعْتُهُ يَقُولُ : مَنْ لَبِسَ الْحَرِيرَ فِي الدُّنْيَا ، حُرِمَهُ أَنْ يَلْبَسَهُ فِي الْآخِرَةِ  .","","Musnad Abi Ya'la al-Mawsili 1751","","عقبة بن عامر بن عبس الفرضي عن هشام بن أبي رقية المصري عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1750","19 - (  1752  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى التُّسْتَرِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  عَنْ  عَمْرِو بْنِ مَالِكٍ  ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي جَعْفَرٍ ،  عَنْ  جَعْفَرِ بْنِ عَبْدِ اللهِ بْنِ الْحَكَمِ ، قَالَ :  سَمِعْتُ  عُقْبَةَ بْنَ عَامِرٍ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  مَنْ  صُرِعَ  عَنْ دَابَّتِهِ فِي  سَبِيلِ  اللهِ فَمَاتَ ، فَهُوَ  شَهِيدٌ  .         [3/291]      كذا في طبعة دار المأمون للتراث ، والصواب : ( عمر بن مالك )","","Musnad Abi Ya'la al-Mawsili 1752","","عقبة بن عامر بن عبس الفرضي عن جعفر بن عبد الله بن الحكم الأوسي عن عبيد الله بن أبي جعفر الكناني عن عمر بن مالك الشرعبي عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1751","20 - (  1753  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ الْقَطَّانُ ،  عَنْ  يَحْيَى ، قَالَ :  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ زَحْرٍ ، أَنَّ أَبَا سَعِيدٍ  أَخْبَرَهُ  ، أَنَّ عَبْدَ اللهِ بْنَ مَالِكٍ  أَخْبَرَهُ  ، أَنَّ عُقْبَةَ بْنَ عَامِرٍ  أَخْبَرَهُ  ،  أَنَّهُ سَأَلَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، عَنْ أُخْتِهِ  نَذَرَتْ أَنْ تَمْشِيَ مُخْتَمِرَةً ؟ فَأَمَرَهَا أَنْ تَخْتَمِرَ ، وَتَرْكَبَ ، وَتَصُومَ ثَلَاثَةَ أَيَّامٍ  .         [3/292]","","Musnad Abi Ya'la al-Mawsili 1753","","عقبة بن عامر بن عبس الفرضي عن عبد الله بن مالك اليحصبي عن جعثل بن هاعان الرعيني عن عبيد الله بن زحر الضمري عن يحيى بن سعيد الأنصاري عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1752","21 - (  1754  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعُ بْنُ الْجَرَّاحِ ،  حَدَّثَنِي  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ الْأَنْصَارِيُّ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  مَرْثَدِ بْنِ عَبْدِ اللهِ الْيَزَنِيِّ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ أَحَقَّ الشُّرُوطِ أَنْ يُوفَى مَا اسْتُحِلَّ بِهِ الْفَرْجُ  .","","Musnad Abi Ya'la al-Mawsili 1754","","عقبة بن عامر بن عبس الفرضي عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن عبد الحميد بن جعفر الأوسي عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1753","22 - (  1755  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  مُوسَى بْنُ عُلَيِّ بْنِ رَبَاحٍ ،  عَنْ  أَبِيهِ  ، قَالَ :         [3/293]      سَمِعْتُ  عُقْبَةَ بْنَ عَامِرٍ ، يَقُولُ :  ثَلَاثُ سَاعَاتٍ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْهَانَا أَنْ نُصَلِّيَ فِيهِنَّ  ، وَأَنْ نَقْبُرَ فِيهِنَّ مَوْتَانَا : حِينَ تَطْلُعُ الشَّمْسُ حَتَّى تَرْتَفِعَ ، وَحِينَ يَقُومُ  قَائِمُ  الظَّهِيرَةِ حَتَّى تَمِيلَ الشَّمْسُ ، وَحِينَ تَضَيَّفُ لِلْغُرُوبِ حَتَّى تَغْرُبَ  .","","Musnad Abi Ya'la al-Mawsili 1755","","عقبة بن عامر بن عبس الفرضي عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1754","23 - (  1756  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ شِمَاسَةَ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا         [3/294]      يَدْخُلُ الْجَنَّةَ صَاحِبُ  مَكْسٍ  ،  يَعْنِي : الْعَشَّارَ  .","","Musnad Abi Ya'la al-Mawsili 1756","","عقبة بن عامر بن عبس الفرضي عن عبد الرحمن بن شماسة المهري عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1755","24 - (  1757  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  أَبَانُ بْنُ يَزِيدَ ،  عَنْ  قَتَادَةَ ،  عَنْ  نُعَيْمِ بْنِ هَمَّارٍ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَتَعْجِزُ ابْنَ آدَمَ أَنْ تُصَلِّيَ أَرْبَعَ رَكَعَاتٍ مِنْ أَوَّلِ النَّهَارِ أَكْفِكَ آخِرَ يَوْمِكَ  ؟ .         [3/295]","","Musnad Abi Ya'la al-Mawsili 1757","","عقبة بن عامر بن عبس الفرضي عن نعيم بن همار الغطفاني عن قتادة بن دعامة عن أبان بن يزيد العطار عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1756","25 - (  1758  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  بَعْجَةَ الْجُهَنِيِّ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، قَالَ :  قَسَمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ضَحَايَا فَأَصَابَنِي  جَذَعٌ  ، فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنَّهُ صَارَ لِي  جَذَعٌ  ، قَالَ : ضَحِّ بِهِ  .","","Musnad Abi Ya'la al-Mawsili 1758","","عقبة بن عامر بن عبس الفرضي عن بعجة بن عبد الله بن بدر الجذامي عن يحيى بن أبي كثير عن هشام الدستوائي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1757","26 - (  1759  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَبُو عَاصِمٍ الضَّحَّاكُ         [3/296]      بْنُ مَخْلَدٍ ،  عَنْ  حَيْوَةَ بْنِ شُرَيْحٍ ،  عَنْ  خَالِدِ بْنِ عُبَيْدٍ ،  عَنْ  مِشْرَحٍ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ الْجُهَنِيِّ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ  تَعَلَّقَ  تَمِيمَةً  فَلَا  أَتَمَّ  اللهُ عَلَيْهِ  ، وَمَنْ  تَعَلَّقَ  وَدَعَةً  فَلَا  وَدَعَ  اللهُ لَهُ  .","","Musnad Abi Ya'la al-Mawsili 1759","","عقبة بن عامر بن عبس الفرضي عن مشرح بن هاعان المعافري عن خالد بن عبيد المعافري عن حيوة بن شريح التجيبي عن أبو عاصم النبيل عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1758","27 - (  1760  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  حَدَّثَنَا  هِشَامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  قَيْسٍ الْجُذَامِيِّ ،         [3/297]      عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَعْتَقَ رَقَبَةً مُؤْمِنَةً فَهِيَ فِدَاؤُهُ مِنَ النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 1760","","عقبة بن عامر بن عبس الفرضي عن قيس الجذامي عن قتادة بن دعامة عن هشام الدستوائي عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1759","28 - (  1761  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  حَبَّانُ ،  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ حَرْمَلَةَ ، أَنَّ رَجُلًا مِنَ  الْإِسْكَنْدَرِيَّةِ  مِنْ  هَمْدَانَ  حَدَّثَهُ  يُقَالُ لَهُ : أَبُو عَلِيٍّ ، قَالَ :  خَرَجْنَا فِي سَفَرٍ وَمَعَنَا عُقْبَةُ بْنُ عَامِرٍ ، فَقُلْنَا لَهُ : صَلِّ بِنَا رَحِمَكَ اللهُ ، فَقَالَ : لَا أَفْعَلُ ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ أَمَّ النَّاسَ فَأَصَابَ الْوَقْتَ وَأَتَمَّ الصَّلَاةَ فَلَهُ وَلَهُمْ ، وَمَنِ انْتَقَصَ         [3/298]      مِنْ ذَلِكَ شَيْئًا فَعَلَيْهِ وَلَا عَلَيْهِمْ  .","","Musnad Abi Ya'la al-Mawsili 1761","","عقبة بن عامر بن عبس الفرضي عن ثمامة بن شفي الهمداني عن عبد الرحمن بن حرملة الأسلمي عن زهير بن محمد التميمي عن حبان بن هلال الباهلي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1760","29 - (  1762  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  ابْنِ إِسْحَاقَ ، قَالَ :  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ شِمَاسَةَ التُّجِيبِيِّ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  لَا يَحِلُّ لِامْرِئٍ مُسْلِمٍ أَنْ  يَخْطُبَ  عَلَى خِطْبَةِ أَخِيهِ حَتَّى يَتْرُكَ  ، وَلَا يَبِيعَ عَلَى بَيْعِهِ حَتَّى يَتْرُكَ  .         [3/299]","","Musnad Abi Ya'la al-Mawsili 1762","","عقبة بن عامر بن عبس الفرضي عن عبد الرحمن بن شماسة المهري عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1761","30 - (  1763  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  حَدَّثَنَا  حَيْوَةُ ،  حَدَّثَنَا  أَبُو عَقِيلٍ ،  عَنِ  ابْنِ عَمِّهِ  ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ ،  أَنَّهُ خَرَجَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  غَزْوَةِ تَبُوكَ  ، فَجَلَسَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمًا يُحَدِّثُ أَصْحَابَهُ ، فَقَالَ :  مَنْ قَامَ إِذَا اسْتَقْبَلَتْهُ الشَّمْسُ فَتَوَضَّأَ فَأَحْسَنَ وُضُوءَهُ ، ثُمَّ قَامَ فَصَلَّى رَكْعَتَيْنِ غُفِرَ لَهُ خَطَايَاهُ  ، وَكَانَ كَمَا وَلَدَتْهُ أُمُّهُ  .","","Musnad Abi Ya'la al-Mawsili 1763","","عقبة بن عامر بن عبس الفرضي عن زهرة بن معبد عن زهرة بن معبد القرشي عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1762","31 - (  1764  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  حَدَّثَنَا  حَرْمَلَةُ بْنُ عِمْرَانَ ،  عَنْ  أَبِي عُشَّانَةَ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنْ كَانَتْ لَهُ أَوْ كَانَ لَهُ ثَلَاثُ بَنَاتٍ فَصَبَرَ عَلَيْهِنَّ  ، فَأَطْعَمَهُنَّ ، وَسَقَاهُنَّ ، وَكَسَاهُنَّ         [3/300]      مِنْ جِدَتِهِ ، كُنَّ لَهُ حِجَابًا مِنَ النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 1764","","عقبة بن عامر بن عبس الفرضي عن حي بن يؤمن أبو عشانة المصري عن حرملة بن عمران التجيبي عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1763","32 - (  1765  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  حَدَّثَنَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ الْوَلِيدِ ،  عَنْ  أَبِي الْخَيْرِ ،  عَنْ  عُقْبَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِنْ كَانَ فِي شَيْءٍ شِفَاءٌ فَفِي شَرْطَةِ حَجَّامٍ ، أَوْ شَرْبَةٍ مِنْ عَسَلٍ  ، أَوْ كَيَّةِ نَارٍ تُصِيبُ الدَّاءَ ، وَأَنَا أَكْرَهُ الْكَيَّ وَلَا أُحِبُّهُ  .","","Musnad Abi Ya'la al-Mawsili 1765","","عقبة بن عامر بن عبس الفرضي عن مرثد بن عبد الله اليزني عن عبد الله بن الوليد بن قيس التجيبي عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1764","33 - (  1766  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا         [3/301]      ابْنُ الْمُبَارَكِ ،  عَنْ  حَرْمَلَةَ بْنِ عِمْرَانَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَبِي الْخَيْرِ ،  عَنْ  عُقْبَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الرَّجُلُ فِي ظِلِّ صَدَقَتِهِ  حَتَّى يُقْضَى بَيْنَ النَّاسِ ، أَوْ قَالَ : حَتَّى يُقْتَصَّ بَيْنَ النَّاسِ  .  وَكَانَ أَبُو الْخَيْرِ لَا يَأْتِي عَلَيْهِ يَوْمٌ إِلَّا  تَصَدَّقَ  فِيهِ بِشَيْءٍ وَلَوْ كَعْكَةً وَلَوْ بَصَلَةً  .","","Musnad Abi Ya'la al-Mawsili 1766","","عقبة بن عامر بن عبس الفرضي عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن حرملة بن عمران التجيبي عن عبد الله بن المبارك عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1765","34 - (  1767  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبِ بْنِ شَابُورَ ،  أَخْبَرَنِي  أَبُو عَمْرٍو يَحْيَى بْنُ الْحَارِثِ الذِّمَارِيُّ ،  أَنَّهُ سَمِعَ  الْقَاسِمَ أَبَا عَبْدِ الرَّحْمَنِ مَوْلَى يَزِيدَ بْنِ مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ ،  يَرْفَعُ الْحَدِيثَ  إِلَى عُقْبَةَ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنْ صَامَ يَوْمًا فِي  سَبِيلِ  اللهِ بَاعَدَ اللهُ مِنْهُ  جَهَنَّمَ  مَسِيرَةَ  مِائَةِ عَامٍ  .","","Musnad Abi Ya'la al-Mawsili 1767","","عقبة بن عامر بن عبس الفرضي عن القاسم بن عبد الرحمن الدمشقي عن يحيى بن الحارث الذماري عن محمد بن شعيب بن شابور القرشي عن الوليد بن شجاع عن أبو يعلى الموصلي","مسند عقبة بن عامر الجهني"
"1766","[3/302]      مُسْنَدُ  جَابِرٍ  1 - (  1768  ) -  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى الْمَوْصِلِيُّ ،  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  جَرِيرٌ ، قَالَ :  سَمِعْتُ  عَطَاءَ بْنَ رَبَاحٍ  ،  حَدَّثَنَا  جَابِرُ بْنُ عَبْدِ اللهِ : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ يُخْلَطَ الزَّبِيبُ وَالتَّمْرُ ، وَالْبُسْرُ وَالتَّمْرُ  .         [3/303]      كذا في طبعة دار المأمون للتراث ، ولعل الصواب: (عطاء بن أبي رباح) .","","Musnad Abi Ya'la al-Mawsili 1768","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن جرير بن حازم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند جابر"
"1767","2 - (  1769  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  حَدَّثَنَا         [3/304]      أَبُو عَوَانَةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُنْبَذُ لَهُ فِي  تَوْرٍ  مِنْ حِجَارَةٍ  .","","Musnad Abi Ya'la al-Mawsili 1769","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن الوضاح بن عبد الله اليشكري عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند جابر"
"1768","3 - (  1770  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  الْفُرَاتُ بْنُ أَبِي الْفُرَاتِ الْقُرَشِيُّ ، قَالَ :  سَمِعْتُ  عَطَاءَ بْنَ أَبِي رَبَاحٍ  يُحَدِّثُ ،         [3/305]      عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَنِمْتُ ، ثُمَّ اسْتَيْقَظْتُ ، ثُمَّ نِمْتُ ، ثُمَّ اسْتَيْقَظْتُ ، فَقَامَ رَجُلٌ مِنَ الْمُسْلِمِينَ ، فَقَالَ : الصَّلَاةَ الصَّلَاةَ ، قَالَ : فَخَرَجَ إِلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَرَأْسُهُ يَقْطُرُ ، فَصَلَّى ، ثُمَّ قَالَ :  لَوْلَا أَنْ أَشُقَّ عَلَى أُمَّتِي ، وَلَا أُحِبُّ أَنْ أَشُقَّ عَلَى أُمَّتِي ، لَأَحْبَبْتُ أَنْ تُصَلُّوا هَذِهِ الصَّلَاةَ هَذِهِ السَّاعَةَ  ، قَالَ :  الْفُرَاتُ  :  أَظُنُّهَا الْعِشَاءَ  .","","Musnad Abi Ya'la al-Mawsili 1770","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن فرات بن أبي الفرات البصري عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند جابر"
"1769","4 - (  1771  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  حَمَّادٌ ،         [3/306]      عَنْ  حَبِيبٍ الْمُعَلِّمِ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كُفُّوا فَوَاشِيَكُمْ حَتَّى تَذْهَبَ فَزْعَةُ الْعِشَاءِ ، فَإِنَّهَا سَاعَةٌ تَحْتَرِقُ فِيهَا الشَّيَاطِينُ  .","","Musnad Abi Ya'la al-Mawsili 1771","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن حبيب المعلم مولى معقل بن يسار عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند جابر"
"1770","5 - (  1772  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  أَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنُ نُغْلِقَ الْأَبْوَابَ ، وَأَنْ         [3/307]      نُخَمِّرَ  الْآنِيَةَ ، وَأَنْ نُوكِيَ الْأَسْقِيَةَ  ، وَأَنْ نُطْفِئَ الْمَصَابِيحَ ، وَأَنْ نَكُفَّ مَوَاشِيَنَا ، حَتَّى تَذْهَبَ  فَحْمَةُ  الْعِشَاءِ ، وَنَهَى أَنْ يَأْكُلَ أَحَدُنَا بِشِمَالِهِ ، وَأَنْ يَمْشِيَ فِي نَعْلٍ وَاحِدٍ ، وَعَنِ  الصَّمَّاءِ  وَالِاحْتِبَاءِ  فِي ثَوْبٍ وَاحِدٍ  .","","Musnad Abi Ya'la al-Mawsili 1772","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند جابر"
"1771","6 - (  1773  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ حِسَابٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،         [3/308]      عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  صَلَّى عَلَى  النَّجَاشِيِّ  ، قَالَ : فَكُنْتُ فِي الصَّفِّ الثَّانِي ، أَوِ الثَّالِثِ  .","","Musnad Abi Ya'la al-Mawsili 1773","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن قتادة بن دعامة عن الوضاح بن عبد الله اليشكري عن محمد بن عبيد بن حساب الغبري عن أبو يعلى الموصلي","مسند جابر"
"1772","7 - (  1774  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ،  وَعَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ :  أَنَّ رَجُلًا يُقَالُ لَهُ :  أَبُو حُمَيْدٍ  أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِإِنَاءٍ فِيهِ لَبَنٌ مِنَ النَّقِيعِ نَهَارًا ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَا  خَمَّرْتَهُ  وَلَوْ أَنْ  تَعْرُضَ         [3/309]      عَلَيْهِ بِعُودٍ  ؟  .","","Musnad Abi Ya'la al-Mawsili 1774","","أبو هريرة الدوسي عن ذكوان السمان عن الأعمش عن عبد العزيز بن مسلم الخراساني عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند جابر"
"1773","8 - (  1775  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  وَعَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  سَدِّدُوا  وَقَارِبُوا ،  وَلَنْ يُنْجِيَ أَحَدًا مِنْكُمْ عَمَلُهُ  ، قُلْنَا : وَلَا أَنْتَ يَا رَسُولَ اللهِ ؟ قَالَ :         [3/310]      وَلَا أَنَا إِلَّا أَنْ  يَتَغَمَّدَنِي  اللهُ مِنْهُ بِرَحْمَةٍ  .         [3/311]","","Musnad Abi Ya'la al-Mawsili 1775","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد العزيز بن مسلم الخراساني عن إبراهيم عن أبو يعلى الموصلي","مسند جابر"
"1774","9 - (  1776  ) -  حَدَّثَنَا  الْحَارِثُ بْنُ سُرَيْجٍ ،  حَدَّثَنَا  مُعْتَمِرٌ ،  حَدَّثَنَا  الْفَضْلُ بْنُ عِيسَى ،  حَدَّثَنِي  مُحَمَّدُ بْنُ الْمُنْكَدِرِ ، أَنَّ جَابِرَ بْنَ عَبْدِ اللهِ  حَدَّثَهُ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  الْعَارُ وَالتَّخْزِيَةُ تَبْلُغُ مِنَ ابْنِ آدَمَ فِي الْقِيَامَةِ فِي الْمَقَامِ بَيْنَ يَدَيِ اللهِ  مَا يَتَمَنَّى الْعَبْدُ أَنْ يُؤْمَرَ بِهِ فِي النَّارِ  .         [3/312]","","Musnad Abi Ya'la al-Mawsili 1776","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن الفضل بن عيسى الواعظ عن معتمر بن سليمان عن الحارث بن سريج النقال عن أبو يعلى الموصلي","مسند جابر"
"1775","10 - (  1777  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  سُلَيْمَانَ بْنِ قَيْسٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  دَعَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَبَا طَيْبَةَ  فَحَجَمَهُ ، فَسَأَلَهُ عَنْ ضَرِيبَتِهِ ؟  فَقَالَ : ثَلَاثَةُ آصُعٍ ، قَالَ : فَوَضَعَ عَنْهُ صَاعًا  .","","Musnad Abi Ya'la al-Mawsili 1777","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سليمان بن قيس اليشكري عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند جابر"
"1776","11 - (  1778  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  سُلَيْمَانَ بْنِ قَيْسٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ :  قَاتَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مُحَارِبَ         [3/313]      خَصَفَةَ  بِنَخْلٍ  ، فَرَأَوْا مِنَ الْمُسْلِمِينَ  غِرَّةً ،  فَجَاءَ رَجُلٌ مِنْهُمْ يُقَالُ لَهُ :  غَوْرَثُ بْنُ الْحَارِثِ  حَتَّى  قَامَ عَلَى رَأْسِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِالسَّيْفِ ، فَقَالَ : مَنْ يَمْنَعُكَ مِنِّي ؟ قَالَ : اللهُ ، قَالَ : فَسَقَطَ السَّيْفُ مِنْ يَدِهِ  ، فَأَخَذَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - السَّيْفَ ، فَقَالَ لَهُ : مَنْ يَمْنَعُكَ مِنِّي ؟ قَالَ : كُنْ خَيْرَ آخِذٍ ، قَالَ : تَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، قَالَ : لَا ، وَلَكِنِّي أُعَاهِدُكَ أَنْ لَا أُقَاتِلَكَ ، وَلَا أَكُونَ مَعَ قَوْمٍ يُقَاتِلُونَكَ ، قَالَ : فَخَلَّى سَبِيلَهُ ، فَجَاءَ إِلَى أَصْحَابِهِ ، فَقَالَ : جِئْتُكُمْ مِنْ عِنْدِ خَيْرِ النَّاسِ ، فَلَمَّا كَانَ  عِنْدَ الظُّهْرِ أَوِ الْعَصْرِ  أَمَرَ النَّبِيُّ بِصَلَاةِ الْخَوْفِ ،  شَكَّ  أَبُو عَوَانَةَ  ، قَالَ : فَكَانَ النَّاسُ طَائِفَتَيْنِ : طَائِفَةٌ بِإِزَاءِ عَدُوِّهِمْ ، وَطَائِفَةٌ يُصَلُّونَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَصَلَّى بِالطَّائِفَةِ الَّذِينَ مَعَهُ رَكْعَتَيْنِ ، ثُمَّ انْصَرَفُوا فَكَانُوا فِي مَكَانِ أُولَئِكَ ، وَجَاءَ أُولَئِكَ فَصَلَّوْا مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَكْعَتَيْنِ ، فَكَانَتْ لِرَسُولِ اللهِ أَرْبَعُ رَكَعَاتٍ ، وَلِلْقَوْمِ رَكْعَتَيْنِ  .         [3/314]             [3/315]             [3/316]","","Musnad Abi Ya'la al-Mawsili 1778","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سليمان بن قيس اليشكري عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند جابر"
"1777","12 - (  1779  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ :  أَنَّ  رَجُلًا  ذَبَحَ قَبْلَ أَنْ يُصَلِّيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَتُودًا  جَذَعًا  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَجْزِي عَنْ أَحَدٍ بَعْدَكَ أَنْ يَذْبَحَ حَتَّى يُصَلِّيَ  .","","Musnad Abi Ya'la al-Mawsili 1779","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جابر"
"1778","13 - (  1780  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَافَرَ فِي رَمَضَانَ ، فَاشْتَدَّ الصَّوْمُ عَلَى  رَجُلٍ  مِنْ أَصْحَابِهِ  ، فَجَعَلَتْ نَاقَتُهُ تَهِيمُ بِهِ تَحْتَ ظِلَالِ الشَّجَرِ ، فَأُخْبِرَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَأَمَرَهُ فَأَفْطَرَ ، ثُمَّ دَعَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِإِنَاءٍ فِيهِ مَاءٌ ، فَوَضَعَهُ عَلَى يَدِهِ ، فَلَمَّا رَآهُ النَّاسُ شَرِبَ شَرِبُوا  .         [3/317]","","Musnad Abi Ya'la al-Mawsili 1780","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جابر"
"1779","14 - (  1781  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  وَاسِعِ بْنِ حَبَّانَ ،  عَنْ  جَابِرٍ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي الْعَرَايَا بِالْوَسْقِ وَالْوَسْقَيْنِ  وَالثَّلَاثَةِ وَالْأَرْبَعَةِ ، وَقَالَ : فِي كُلِّ  جَادٍّ  عَشَرَةُ  أَوْسُقٍ  ، وَمَا بَقِيَ  عِذْقًا  يُوضَعُ فِي الْمَسْجِدِ لِلْمَسَاكِينِ  .  قَالَ  مُحَمَّدٌ  :  وَهُمُ الْيَوْمَ يَشْتَرِطُونَ ذَلِكَ عَلَى التُّجَّارِ  .","","Musnad Abi Ya'la al-Mawsili 1781","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن واسع بن حبان بن منقذ المازني عن محمد بن يحيى بن حبان عن محمد بن إسحاق عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جابر"
"1780","15 - (  1782  ) -  حَدَّثَنَا  سُوَيْدٌ ،  عَنْ  مَالِكٍ ،  عَنْ  هَاشِمِ بْنِ هَاشِمِ بْنِ عُتْبَةَ بْنِ أَبِي وَقَّاصٍ ،  عَنْ  عَبْدِ اللهِ بْنِ نِسْطَاسٍ ،         [3/318]      عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ حَلَفَ عَلَى مِنْبَرِي هَذَا يَمِينًا آثِمَةً تَبَوَّأَ مَقْعَدَهُ مِنَ النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 1782","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن نسطاس الكندي عن هاشم بن هاشم بن عتبة الوقاصي عن مالك بن أنس عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند جابر"
"1781","16 - (  1783  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  بَيْنَ الْعَبْدِ وَبَيْنَ الْكُفْرِ تَرْكُ الصَّلَاةِ  .         [3/319]","","Musnad Abi Ya'la al-Mawsili 1783","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند جابر"
"1782","17 - (  1784  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  هُشَيْمٌ ،  أَخْبَرَنَا  عَلِيُّ بْنُ زَيْدِ بْنِ جُدْعَانَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا بَيْنَ مِنْبَرِي إِلَى         [3/320]      حُجْرَتِي رَوْضَةٌ مِنْ رِيَاضِ الْجَنَّةِ  ، وَإِنَّ مِنْبَرِي عَلَى  تُرْعَةٍ  مِنْ تُرَعِ الْجَنَّةِ  .","","Musnad Abi Ya'la al-Mawsili 1784","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن علي بن زيد بن جدعان عن هشيم بن بشير عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند جابر"
"1783","18 - (  1785  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنِ  الْمُعَلَّى ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  جَابِرٍ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اسْتَتَابَ رَجُلًا ارْتَدَّ عَنِ الْإِسْلَامِ أَرْبَعَ مَرَّاتٍ  .","","Musnad Abi Ya'la al-Mawsili 1785","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن معلى بن هلال بن سويد الطحان عن إسماعيل بن زكريا شقوصا عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند جابر"
"1784","19 - (  1786  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ :  أَنَّهُمْ كَانُوا فِي مَغْزًى لَهُمْ فَأَصَابَهُمْ جُوعٌ شَدِيدٌ ، فَأَلْقَى الْبَحْرُ دَابَّةً عَظِيمَةً  ، فَأَكَلُوا مِنْهَا خَمْسَةً وَعِشْرِينَ يَوْمًا         [3/321]      لَحْمًا  عَبِيطًا  ، قَالَ أَبُو الزُّبَيْرِ ، قَالَ  جَابِرُ بْنُ عَبْدِ اللهِ  : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : هَلْ جِئْتُمُونَا مِنْهُ بِشَيْءٍ ؟  .         [3/322]","","Musnad Abi Ya'la al-Mawsili 1786","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند جابر"
"1785","20 - (  1787  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ  أَنَّهُمْ ذَبَحُوا  يَوْمَ خَيْبَرَ  الْخَيْلَ ، وَالْبِغَالَ ، وَالْحَمِيرَ  الْأَهْلِيَّةَ  ،  فَنَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الْبِغَالِ ، وَالْحَمِيرِ ، وَلَمْ يَنْهَ عَنِ الْخَيْلِ  .         [3/323]","","Musnad Abi Ya'la al-Mawsili 1787","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند جابر"
"1786","21 - (  1788  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ  الدُّبَّاءِ  وَالْمُزَفَّتِ  وَالنَّقِيرِ  .         [3/324]      قَالَ أَبُو الزُّبَيْرِ : فَكَانَ جَابِرٌ إِذَا لَمْ يَجِدْ سِقَاءً انْتَبَذَ لَهُ فِي  تَوْرِ  حِجَارَةٍ  .","","Musnad Abi Ya'la al-Mawsili 1788","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند جابر"
"1787","22 - (  1789  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا  عَدْوَى  وَلَا  طِيَرَةَ  وَلَا  صَفَرَ  وَلَا  غُولَ  .         [3/325]","","Musnad Abi Ya'la al-Mawsili 1789","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند جابر"
"1788","23 - (  1790  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ ،         [3/326]      عَنْ  جَابِرٍ ، قَالَ :  جَاءَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبُو بَكْرٍ  ،  وَعُمَرُ  ، فَأَطْعَمْنَاهُمْ رُطَبًا ، وَأَسْقَيْنَاهُمْ مِنَ الْمَاءِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  هَذَا مِنَ النَّعِيمِ الَّذِي تُسْأَلُونَ عَنْهُ  .","","Musnad Abi Ya'la al-Mawsili 1790","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمار بن أبي عمار الحارثي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند جابر"
"1789","24 - (  1791  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  حَجَّاجٍ الصَّوَّافِ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِذَا أَوَى الرَّجُلُ إِلَى فِرَاشِهِ ابْتَدَرَهُ مَلَكٌ وَشَيْطَانٌ ، فَيَقُولُ الْمَلَكُ : اخْتِمْ بِخَيْرٍ ، وَيَقُولُ الشَّيْطَانُ : اخْتِمْ بِشَرٍّ  ، فَإِنْ ذَكَرَ اللهَ ثُمَّ نَامَ بَاتَ الْمَلَكُ يَكْلَؤُهُ ، فَإِذَا اسْتَيْقَظَ ، قَالَ الْمَلَكُ : افْتَحْ بِخَيْرٍ ، وَقَالَ الشَّيْطَانُ : افْتَحْ بِشَرٍّ ، فَإِنْ قَالَ : الْحَمْدُ لِلهِ الَّذِي رَدَّ عَلَيَّ نَفْسِي وَلَمْ يُمِتْهَا فِي مَنَامِهَا ، الْحَمْدُ لِلهِ الَّذِي         {      يُمْسِكُ السَّمَاوَاتِ وَالأَرْضَ أَنْ تَزُولا         }      ، إِلَى آخِرِ الْآيَةِ ، الْحَمْدُ لِلهِ الَّذِي يُمْسِكُ السَّمَاءَ         [3/327]      أَنْ تَقَعَ عَلَى الْأَرْضِ إِلَّا بِإِذْنِهِ ، فَإِنْ وَقَعَ مِنْ سَرِيرِهِ فَمَاتَ دَخَلَ الْجَنَّةَ  .","","Musnad Abi Ya'la al-Mawsili 1791","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حجاج بن أبى عثمان الصواف الكندي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند جابر"
"1790","25 - (  1792  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جَابِرٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ  ، قَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أُتِيَ بِكَبْشَيْنِ أَقْرَنَيْنِ  أَمْلَحَيْنِ  عَظِيمَيْنِ  مَوْجُوءَيْنِ  ، فَأَضْجَعَ أَحَدَهُمَا ، وَقَالَ : بِاسْمِ اللهِ ، وَاللهُ أَكْبَرُ  ، اللَّهُمَّ عَنْ  مُحَمَّدٍ  وَآلِ مُحَمَّدٍ  ، ثُمَّ أَضْجَعَ الْآخَرَ ، فَقَالَ : بِاسْمِ اللهِ ، وَاللهُ أَكْبَرُ ، عَنْ  مُحَمَّدٍ  وَأُمَّتِهِ : مَنْ شَهِدَ لَكَ بِالتَّوْحِيدِ ، وَشَهِدَ لِي  بِالْبَلَاغِ  .         [3/328]             [3/329]","","Musnad Abi Ya'la al-Mawsili 1792","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن جابر السلمي عن عبد الله بن محمد بن عقيل بن أبي طالب عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جابر"
"1791","26 - (  1793  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  أَبِي الْمُتَوَكِّلِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لَهُ فِي  غَزْوَةِ تَبُوكَ  ، وَهُوَ عَلَى جَمَلٍ أَحْمَرَ ، فَتَخَلَّفَ الْبَعِيرُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا شَأْنُكَ يَا  جَابِرُ  ؟ فَقُلْتُ : يَا رَسُولَ اللهِ ، تَخَلَّفَ بَعِيرِي ، فَأَتَاهُ مِنْ قِبَلِ عَجُزِهِ فَدَعَا لَهُ  وَزَجَرَهُ  ، فَأَتَى عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : مَا فَعَلَ الْبَعِيرُ يَا  جَابِرُ  ؟ قُلْتُ : يَا رَسُولَ اللهِ ، مَا زَالَ يَقْدُمُنَا مُنْذُ اللَّيْلَةِ ، قَالَ : فَبِكَمْ أَخَذْتَهُ ؟ فَقُلْتُ : بِثَلَاثَةَ عَشَرَ دِينَارًا ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : بِعْنِيهِ بِثَمَنِهِ الَّذِي أَخَذْتَهُ وَلَكَ ظَهْرُهُ إِلَى  الْمَدِينَةِ  ، فَفَعَلْتُ ، فَلَمَّا قَدِمْنَا         [3/330]      الْمَدِينَةَ  خَطَمْتُهُ  فَأَتَيْتُهُ فَأَعْطَانِي الْبَعِيرَ وَالثَّلَاثَةَ عَشَرَ دِينَارًا  .         [3/331]             [3/332]","","Musnad Abi Ya'la al-Mawsili 1793","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن علي بن داود الناجي عن علي بن زيد بن جدعان عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جابر"
"1792","27 - (  1794  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  بِشْرُ بْنُ مَنْصُورٍ ،  عَنْ  عُمَرَ بْنِ نَبْهَانَ ،  عَنْ  أَبِي شَدَّادٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ثَلَاثٌ مَنْ جَاءَ بِهِنَّ مَعَ إِيمَانٍ دَخَلَ مِنْ أَيِّ أَبْوَابِ الْجَنَّةِ شَاءَ ، وَزُوِّجَ مِنَ  الْحُورِ  الْعِينِ  حَيْثُ شَاءَ : مَنْ عَفَا عَنْ قَاتِلِهِ ، وَأَدَّى دَيْنًا خَفِيًّا ، وَقَرَأَ فِي دُبُرِ كُلِّ صَلَاةٍ مَكْتُوبَةٍ عَشْرَ مَرَّاتٍ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      ، قَالَ : فَقَالَ  أَبُو بَكْرٍ  : أَوْ إِحْدَاهُنَّ يَا رَسُولَ اللهِ ، قَالَ : أَوْ إِحْدَاهُنَّ  .         [3/333]","","Musnad Abi Ya'la al-Mawsili 1794","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو شداد عن عمر بن نبهان عن بشر بن منصور السليمي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جابر"
"1793","28 - (  1795  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  يَعْقُوبُ بْنُ عَبْدِ اللهِ ،  عَنْ  عِيسَى بْنِ جَارِيَةَ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ :  صَلَّى  أُبَيٌّ  بِالنَّاسِ فِي  قُبَاءٍ  ، وَدَخَلَ فِي صَلَاتِهِ  غُلَامٌ مِنَ الْأَنْصَارِ  وَلَهُ سِقْيٌ ، قَالَ : فَلَمَّا سَمِعَ  أُبَيًّا  يَقْرَأُ سُورَةً طَوِيلَةً انْفَتَلَ مِنْ صَلَاتِهِ ، فَلَمَّا انْفَتَلَ  أُبَيٌّ  أُخْبِرَ بِذَلِكَ ، قَالَ : فَعَرَفَ  أُبَيٌّ  أَنَّ الْغُلَامَ يَشْكُو إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَقَرُبَ الْغُلَامُ يَشْكُو  أُبَيًّا  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ مِنْكُمْ  مُنَفِّرِينَ ،  فَإِذَا صَلَّيْتُمْ فَأَوْجِرُوا ، أَوْ قَالَ :  فَأَوْجِزُوا  -  شَكَّ  أَبُو يَحْيَى  أَوْ كَمَا قَالَ - فَإِنَّ خَلْفَكُمُ الْكَبِيرَ وَالْمَرِيضَ وَذَا الْحَاجَةِ  .","","Musnad Abi Ya'la al-Mawsili 1795","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عيسى بن جارية الأنصاري عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جابر"
"1794","29 - (  1796  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  يَعْقُوبُ بْنُ عَبْدِ اللهِ ،  عَنْ  عِيسَى بْنِ جَارِيَةَ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمَكَّةَ  فَمَرَّ         [3/334]      عَلَى  رَجُلٍ  قَائِمٍ يُصَلِّي عَلَى صَخْرَةٍ ، فَأَتَى نَاحِيَةَ  مَكَّةَ  فَمَكَثَ مَلِيًّا ، ثُمَّ أَقْبَلَ فَوَجَدَ الرَّجُلَ عَلَى حَالِهِ يُصَلِّي ، فَجَمَعَ يَدَيْهِ ، ثُمَّ قَالَ ثَلَاثَ مَرَّاتٍ :  يَا أَيُّهَا النَّاسُ ، عَلَيْكُمْ بِالْقَصْدِ ، عَلَيْكُمْ بِالْقَصْدِ ، عَلَيْكُمْ بِالْقَصْدِ ، فَإِنَّ اللهَ لَنْ  يَمَلَّ  حَتَّى تَمَلُّوا  .","","Musnad Abi Ya'la al-Mawsili 1796","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عيسى بن جارية الأنصاري عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جابر"
"1795","30 - (  1797  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  يَعْقُوبُ ،  حَدَّثَنَا  عِيسَى بْنُ جَارِيَةَ ،  عَنْ  جَابِرٍ :  مَرَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمَكَّةَ  عَلَى  رَجُلٍ  يُصَلِّي عَلَى صَخْرَةٍ فَأَتَى نَاحِيَةً فَمَكَثَ مَلِيًّا ، ثُمَّ انْصَرَفَ فَوَجَدَ الرَّجُلَ يُصَلِّي عَلَى حَالِهِ ، فَقَامَ فَجَمَعَ يَدَيْهِ ، ثُمَّ قَالَ :  أَيُّهَا النَّاسُ ، عَلَيْكُمْ بِالْقَصْدِ ، عَلَيْكُمْ بِالْقَصْدِ ، فَإِنَّ اللهَ لَا  يَمَلُّ  حَتَّى تَمَلُّوا  .","","Musnad Abi Ya'la al-Mawsili 1797","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عيسى بن جارية الأنصاري عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند جابر"
"1796","31 - (  1798  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  يَعْقُوبُ ،  أَخْبَرَنَا  عِيسَى بْنُ جَارِيَةَ ،  عَنْ  جَابِرٍ ، قَالَ :  كَانَ  أُبَيٌّ  يُصَلِّي  بِأَهْلِ قُبَاءٍ  ، فَاسْتَفْتَحَ سُورَةً طَوِيلَةً وَدَخَلَ مَعَهُ  غُلَامٌ مِنَ الْأَنْصَارِ  فِي الصَّلَاةِ ، فَلَمَّا سَمِعَهُ قَدِ         [3/335]      اسْتَفْتَحَ بِسُورَةٍ طَوِيلَةٍ ، انْفَتَلَ الْغُلَامُ مِنْ صَلَاتِهِ وَكَانَ يُرِيدُ أَنْ  يُعَالِجَ  نَاضِحًا  لَهُ يَسْقِي عَلَيْهِ ، فَلَمَّا انْفَتَلَ  أُبَيُّ بْنُ كَعْبٍ  قَالَ لَهُ  الْقَوْمُ  : إِنَّ فُلَانًا انْفَتَلَ مِنَ الصَّلَاةِ ، فَغَضِبَ  أُبَيٌّ  ، فَأَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَشْكُو الْغُلَامَ ، فَأَتَاهُ الْغُلَامُ يَشْكُوهُ إِلَيْهِ ، فَغَضِبَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى رُئِيَ الْغَضَبُ فِي وَجْهِهِ ، ثُمَّ قَالَ :  إِنَّ مِنْكُمْ  مُنَفِّرِينَ ،  فَإِذَا صَلَّيْتُمْ  فَأَوْجِزُوا  ، فَإِنَّ خَلْفَكُمُ الضَّعِيفَ ، وَالْكَبِيرَ ، وَالْمَرِيضَ ، وَذَا الْحَاجَةِ  .","","Musnad Abi Ya'la al-Mawsili 1798","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عيسى بن جارية الأنصاري عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند جابر"
"1797","32 - (  1799  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  يَعْقُوبُ ،  حَدَّثَنِي  عِيسَى بْنُ جَارِيَةَ ،  عَنْ  جَابِرٍ ، قَالَ :  دَخَلَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ  الْمَسْجِدَ وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ ، فَجَلَسَ إِلَى جَنْبِهِ  أُبَيُّ بْنُ كَعْبٍ  ،  فَسَأَلَهُ عَنْ شَيْءٍ - أَوْ كَلَّمَهُ بِشَيْءٍ  - فَلَمْ يَرُدَّ عَلَيْهِ  أُبَيٌّ  ، فَظَنَّ  ابْنُ مَسْعُودٍ  أَنَّهَا مَوْجِدَةٌ ، فَلَمَّا انْفَتَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ صَلَاتِهِ ، قَالَ  ابْنُ مَسْعُودٍ  : يَا  أُبَيُّ  ، مَا مَنَعَكَ أَنْ تَرُدَّ عَلَيَّ ؟ قَالَ :  إِنَّكَ لَمْ تَحْضُرْ مَعَنَا الْجُمُعَةَ ، قَالَ : لِمَ ؟ قَالَ : تَكَلَّمْتَ وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ  ، فَقَامَ  ابْنُ مَسْعُودٍ  فَدَخَلَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرَ ذَلِكَ لَهُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : صَدَقَ  أُبَيٌّ  ، أَطِعْ  أُبَيًّا  .         [3/336]","","Musnad Abi Ya'la al-Mawsili 1799","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عيسى بن جارية الأنصاري عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جابر"
"1798","33 - (  1800  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  يَعْقُوبُ ،  أَخْبَرَنَا  عِيسَى بْنُ جَارِيَةَ ،  عَنْ  جَابِرٍ قَالَ : دَخَلَ  ابْنُ مَسْعُودٍ  الْمَسْجِدَ وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ  فَذَكَرَ نَحْوَ حَدِيثِ  عَبْدِ الْأَعْلَى  .","","Musnad Abi Ya'la al-Mawsili 1800","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عيسى بن جارية الأنصاري عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند جابر"
"1799","34 - (  1801  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  يَعْقُوبُ ،  عَنْ  عِيسَى بْنِ جَارِيَةَ ،  حَدَّثَنَا  جَابِرُ بْنُ عَبْدِ اللهِ ، قَالَ :  جَاءَ  أُبَيُّ بْنُ كَعْبٍ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنْ كَانَ مِنِّي اللَّيْلَةَ شَيْءٌ  يَعْنِي فِي رَمَضَانَ  ، قَالَ : وَمَا ذَاكَ يَا  أُبَيُّ  ؟ قَالَ :  نِسْوَةٌ فِي دَارِي ، قُلْنَ : إِنَّا لَا نَقْرَأُ الْقُرْآنَ فَنُصَلِّي بِصَلَاتِكَ ، قَالَ : فَصَلَّيْتُ بِهِنَّ ثَمَانَ رَكَعَاتٍ ، ثُمَّ أَوْتَرْتُ  ، قَالَ : فَكَانَ شِبْهَ الرِّضَا وَلَمْ يَقُلْ شَيْئًا  .","","Musnad Abi Ya'la al-Mawsili 1801","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عيسى بن جارية الأنصاري عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جابر"
"1800","35 - (  1802  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  يَعْقُوبُ ،  أَخْبَرَنَا  عِيسَى ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ :  صَلَّى بِنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي شَهْرِ رَمَضَانَ ثَمَانَ رَكَعَاتٍ وَأَوْتَرَ ، فَلَمَّا كَانَتِ الْقَابِلَةُ اجْتَمَعْنَا فِي الْمَسْجِدِ وَرَجَوْنَا أَنْ يَخْرُجَ إِلَيْنَا ، فَلَمْ نَزَلْ فِيهِ حَتَّى أَصْبَحْنَا ، ثُمَّ دَخَلْنَا ، فَقُلْنَا :         [3/337]      يَا رَسُولَ اللهِ ، اجْتَمَعْنَا فِي الْمَسْجِدِ وَرَجَوْنَا أَنْ تُصَلِّيَ بِنَا ، فَقَالَ : إِنِّي خَشِيتُ أَوْ كَرِهْتُ أَنْ تُكْتَبَ عَلَيْكُمْ  .","","Musnad Abi Ya'la al-Mawsili 1802","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عيسى بن جارية الأنصاري عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند جابر"
