hadiths[22]{hadithnumber,text}:
"484","[AI-translation] ((Seyyidünâ Ebû Hüreyre (radıyallahu anh) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: ""Umra (birine ömrü boyunca bir şeyi bağışlamak) mirasçılarına mirastır. Veya mirasçılarına caizdir.""))"
"485","[AI-translation] ((Şüreyh rivayet etti: Resulullah (sallallahu aleyhi ve sellem) umra hakkında caiz olduğuna hükmetti.))"
"486","[AI-translation] ((Seyyidünâ Ebû Hüreyre (radıyallahu anh) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: ""Umra caizdir.""))"
"487","[AI-translation] ((Katade (rahimehullah) rivayet etti — Hasan (rahimehullah) dedi ki: Derlerdi ki: 'Umra caizdir.' ))"
"488","[AI-translation] ((İmam Zühri (rahimehullah) dedi ki: Umra, kişinin: ""Bu onundur — ondan sonra soyunundur."" demesidir. Kime şart koşarsa onundur.))"
"489","[AI-translation] ((Seyyidünâ Cabir bin Abdullah (radıyallahu anh) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: ""Umra caizdir.""))"
"490","[AI-translation] ((İmam Zühri (rahimehullah) dedi ki: Halifeler bu meseleyi karara bağlarlardı. Ata (rahimehullah) dedi ki: Abdülmelik bin Mervan bu meseleyi karara bağladı.))"
"491","[AI-translation] ((Seyyidünâ Cabir bin Abdullah (radıyallahu anh) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: ""Umra caizdir.""))"
"492","[AI-translation] ((Seyyidünâ Ebû Hüreyre (radıyallahu anh) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: ""Kime istemeden bir şey verilip onu kabul ederse, o Allah'ın ona gönderdiği rızıktır.""))"
"493","[AI-translation] ((Seyyidünâ Ebû Hüreyre (radıyallahu anh) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: ""Bana ön ayak hediye edilirse kabul ederim; ayak yemeğine çağrılırsam o daveti de kabul ederim.""))"
"494","[AI-translation] ((A'meş (rahimehullah) bu isnadla önceki hadisin benzerini rivayet etti.))"
"495","[AI-translation] ((Seyyidünâ Ebû Hüreyre (radıyallahu anh) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: ""Bana ön ayak eti hediye edilirse kabul ederim."" Cerir (rahimehullah) rivayet etti: (sallallahu aleyhi ve sellem): ""Ön ayak etine çağrılırsam kabul ederim."" dediğini sanırım.))"
"496","[AI-translation] ((Ebû Hüreyre (radıyallahu anh) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: ""Hediyesini geri alan, doyana kadar yiyip sonra kusup sonra kusmuğunu yemeye başlayan köpek gibidir.""))"
"497","[AI-translation] ((Seyyidünâ Ebû Hüreyre (radıyallahu anh) rivayet etti: Kendi evinden başka evde Resulullah'a (sallallahu aleyhi ve sellem) yemek getirilince sorardı: ""Bu hediye mi sadaka mı?"" Sadaka olduğu söylenirse ondan yemezdi — ashabı yerdi. Hediye olduğu söylenirse ondan yerdi.))"
"498","[AI-translation] ((Seyyidünâ İbn Abbas (radıyallahu anhümâ) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: ""Hediyesini geri alan, kusup sonra onu yalayan köpek gibidir.""))"
"499","[AI-translation] ((Seyyidünâ İbn Abbas (radıyallahu anhümâ) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: ""Hediyesini geri alan, kusup sonra onu yalayan köpek gibidir.""))"
"500","[AI-translation] ((Seyyidünâ İbn Abbas (radıyallahu anhümâ) Resulullah'ın (sallallahu aleyhi ve sellem) dediğini rivayet etti: ""Hediye verip sonra geri almak kimseye helâl değildir — çocuğuna veren baba hariç. Hediye verip sonra geri alanın örneği, kusup sonra onu yalayan köpek gibidir.""))"
"501","[AI-translation] ((Tavus (rahimehullah) rivayet etti — Resulullah (sallallahu aleyhi ve sellem) buyurdu: ""Hediye verip sonra geri almak kimseye helâl değildir — baba hariç (çocuğuna verdiğini geri alabilir).\"))"
"502","[AI-translation] ((Ata (rahimehullah) rivayet etti — Resulullah (sallallahu aleyhi ve sellem) buyurdu: ""Hediyesini geri alan, kendi kusmuğunu yalayan gibidir.""))"
"503","[AI-translation] ((Seyyidünâ İbn Abbas (radıyallahu anhümâ) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: ""Sizden birine hediye verilip yanında bazı kimseler bulunursa onlar da ona ortak olurlar.""))"
"504","[AI-translation] ((Seyyidünâ İbn Abbas (radıyallahu anhümâ) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: ""Bize kötü örnek yoktur (bu örnekle nitelenenlerden olmayacağız); hediyesini geri alan, kusup sonra onu yalayan köpek gibidir.""))"
"505","[AI-translation] ((Seyyidünâ İbn Abbas (radıyallahu anhümâ) Resulullah'tan (sallallahu aleyhi ve sellem) önceki hadisin benzerini rivayet etti.))"
