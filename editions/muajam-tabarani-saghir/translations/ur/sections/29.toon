hadiths[229]{hadithnumber,text}:
"10472"," حضرت مسلمہ بن مخلد رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :   """" جو شخص دنیا میں کسی مسلمان کی پردہ پوشی کرتا ہے اللہ تعالیٰ دنیا اور آخرت میں اس کی پردہ پوشی کرتا ہے "" جو شخص کسی پریشان حال کو نجات دیتا ہے اللہ تعالیٰ اس سے قیامت کی دن کی پریشانیوں میں سے کوئی پریشانی دور کر دے گا اور جو شخص اپنے بھائی کی حاجت روائی میں مشغول ہوتا ہے اللہ تعالیٰ اس کی حاجت روائی کرتا ہے """"۔   یہ روایت امام احمد نے نقل کی ہے "" اور اس کے رجال صحیح کے رجال ہیں ۔  اس سے پہلے علم کے حصول کے لئے سفر کرنے سے متعلق باب میں اس مضمون کی کچھ روایات پہلے گزر چکی ہیں ۔"
"10473"," حضرت ارطاۃ بن منذر سکونی رضی اللہ عنہ کے بارے یہ بات مذکور ہے : ایک شخص اْن کے پاس آیا اور بولا : میرا پڑوسی شراب پیتا ہے "" اور برے کام کرتا ہے "" تو میں اس کا معاملہ سلطان کے سامنے پیش کروں ۔ حضرت ارطاج رضی اللہ عنہ نے فرمایا : میں نے نبی اکرم ﷽ کے سامنے ننانوے مشرکین کو قتل کیا مجھے یہ بات پسند نہیں ہے کہ جب میں نے ان جیسے لوگوں کو قتل کیا ہوا ہو "" تو اس کے باوجود میں کسی مسلمان کی پردہ دری کروں ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی مسلمہ بن علی ہے "" اور وہ ضعیف ہے ۔"
"10474"," حضرت لقكط بن ارطاۃ سکونی رضی اللہ عنہ کے بارے میں مذکور ہے : ایک شخص نے ان سے کہا : ہمارا ایک پڑوسی شراب پیتا ہے "" "
"10475"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ کھڑے ہوئے آپ نے ارشاد فرمایا :   """" اے لوگو ! اے ان لوگوں کے گروہ ! جو اپنی زبان کے ذریعے ایمان لائے ہیں لیکن ایمان ان کے دل تک نہیں پہنچا راوی کہتے ہیں : نبی اکرم ﷽ نے پردے میں موجود خواتین تک آواز پہنچائی "
"10476"," حضرت ابوسعید خدری رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" جو مومن اپنے بھائی کی قابل پردہ کوئی چیز دیکھ کر اس کی پردہ پوشی کرتا ہے اللہ تعالیٰ اس کو جنت میں داخل کرے گا """"۔  ایک روایت میں یہ الفاظ ہیں :   """" اللہ تعالیٰ اسے اس وجہ سے جنت میں داخل کر دے گا """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے "" اور معجم صغیر میں اس کی مانند نقل کی ہے "" اور ان دونوں کی سند ضعیف ہے ۔"
"10477"," حضرت نبیط بن شریط رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" جو شخص کسی مومن کی حرمت کی پردہ پوشی کرے گا اللہ تعالیٰ اسے جہنم سے بچائے گا """"۔   یہ روایت امام طبرانی نے معجم صغیر میں نقل کی ہے "" اور اس کی سند میں ایسا راوی ہے "" جس سے میں واقف نہیں ہوں ۔"
"10478"," حضرت جابر بن عبداللي رضی اللہ عنہما نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :   """" جس نے کسی کی پردہ پوشی کی تو گویا اس نے زندہ گاڑی جانے والی بچی کو اس کی قبر میں زندگی دی """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ اس کی سند میں ایک راوی طلحہ بن زید ہے "" اور وہ ضعیف ہے ۔ انہوں نے اسے ایک اور سند کے ساتھ بھی نقل کیا ہے جس کی سند میں ایک راوی ابومعشر ہے "" اور یہ طلحہ سے کم ضعیف ہے ۔ اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"10479"," حضرت ابوہریرہ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :"""" جو شخص اپنے بھائی کی طرف سے اس کے دین میں کوئی خامی دیکھے اور پھر اس کی پردہ پوشی کرے تو یہ چیز اس کے لئے قیامت کے دن نیکی ہو گی """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ اس کی سند میں ایک راوی ابوصالح خوزی ہے "" اور وہ ضعیف ہے ۔"
"10480","وَعَنْ جُبَيْرِ بْنِ نُفَيْرٍ: «أَنَّ عَوْفَ بْنَ مَالِكٍ خَرَجَ إِلَى النَّاسِ فَقَالَ: إِنَّ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - أَمَرَكُمْ أَنْ تَتَعَوَّذُوا مِنْ ثَلَاثٍ: مِنْ طَمَعٍ حَيْثُ لَا مَطْمَعَ، وَمِنْ طَمَعٍ يُرَدُّ إِلَى طَبْعٍ، وَمِنْ طَمَعٍ إِلَى غَيْرِ مَطْمَعٍ».\nرَوَاهُ الطَّبَرَانِيُّ بِأَسَانِيدَ، وَرِجَالُ أَحَدِهَا ثِقَاتٌ، وَفِي بَعْضِهِمْ خِلَافٌ."
"10481"," مسروق بیان کرتے ہیں : حضرت عبداللہ بن مسعود رضی اللہ عنہ گھر سے نکل کر باہر موجود افراد کے پاس تشریف لائے انہوں نے ان لوگوں سے فرمایا : تم میں سے جو شخص مسئلہ معلوم کرنے کے لئے آیا ہے وہ اپنی جگہ پر بیٹھ جائے تم میں سے جو شخص کوئی مقدمہ لے کر آیا ہے "" تو وہ اپنے مقابل فریق کو بھی لے کر آئے تاکہ ہم ان کے درمیان فیصلہ دیں اور تم میں سے جو شخص ہمیں کسی شخص کے پوشیدہ معاملہ کے بارے میں اطلاع دینے آیا ہے "" جس کی اللہ تعالیٰ نے پردہ پوشی کی ہوئی ہو "" تو اس شخص کو اللہ تعالیٰ کے پردے کو پردے میں رکھنا چاہیے اور اس پردے کی چیز کو اس ذات کے سپرد کرنا چاہیے جو اس کو مغفرت کرنے کی مالک ہے کیونکہ میں اس کی مغفرت کرنے کا مالک نہیں ہوں ، میں تو اس شخص پر حد جاری کروں گا "" اور سزا دوں گا ۔ یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی ابوبکر ہذلی ہے "" اور وہ ضعیف ہے ۔"
"10482"," ابراہیم نخعی بیان کرتے ہیں : ایک شخص حضرت عبداللہ بن مسعود رضی اللہ عنہ کے پاس آیا اس نے حنوط لگائی ہوئی تھی جب حضرت عبداللہ رضی اللہ عنہ نے اس کو دیکھا تو انہیں اس میں سے حنوط کی خوشبو محسوس ہوئی "" تو انہوں نے کہا : اے اللہ میں اس کے شر سے تیری پناہ مانگتا ہوں راوی کہتے ہیں : وہ شخص ان کے پاس آیا اور اس نے یہ بات ذکر کی کہ اس نے اپنی بیوی کی کنیز کے ساتھ صحبت کر لی ہے اس نے ان سے درخواست کی کہ وہ اس پر حد جاری کریں تو حضرت عبداللہ رضی اللہ عنہ نے فرمایا : تم اللہ تعالیٰ سے مغفرت طلب کرو اور اس کی بارگاہ میں توبہ کرو اور اپنی ذات کی پردہ پوشی کرو اگر تم سے ہو سکے تو اس کنیز کو آزاد کر دو ۔   یہ روایت امام طبرانی نے نقل کی ہے : ابراہیم نامی راوی نے حضرت عبداللہ بن مسعود رضی اللہ عنہ کا زمانہ نہیں پایا ہے "" تا ہم اس کے رجال صحیح کے رجال ہیں ۔"
"10483"," حضرت عبداللہ بن مسعود رضی اللہ عنہ فرماتے ہیں جب تم اپنے بھائی کو دیکھو جو گناہ کا ارتکاب کرنے لگا ہو "" تو اس کے خلاف شیطان کے مدد گار نہ بن جاا کہ تم یہ کہو کہ اے اللہ تو اسے رسوا کر دے اے اللہ تو اس پر لعنت کر بلکہ تم لوگ اللہ تعالیٰ سے عافیت مانگو کیونکہ ہم یعنی نبی اکرم ﷽ کے اصحاب کسی بھی شخص کے بارے میں کوئی رائے نہیں دیتے تھے جب تک ہمیں یہ پتہ نہیں چل جاتا تھا کہ وہ کس حال میں مرا ہے اگر اس کا خاتمہ خیر کے ساتھ ہوا ہوتا اگر ہمیں یہ علم ہو جاتا کہ اس نے بھلائی کا ارتکاب کیا ہے "" اور اگر اس کا خاتمہ برائی کے ساتھ ہوتا تھا تو ہمیں اس کے عمل کے حوالے سے اس کی ذات کے بارے میں اندیشہ ہوتا تھا ۔ "
"10484"," ان کی نقل کردہ ایک روایت میں یہ الفاظ ہیں :  لیکن تم اللہ تعالیٰ سے دعا کرو کہ وہ اس کو توبہ کی توفیق دے اور اس پر رحم کرے """"۔"
"10485","عَنْ أَنَسٍ: أَنَّ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - قَالَ: """" «مَنْ هَمَّ بِحَسَنَةٍ فَلَمْ يَعْمَلْهَا كُتِبَتْ لَهُ حَسَنَةً، فَإِنْ عَمِلَهَا كُتِبَتْ لَهُ عَشْرًا، وَمَنْ هَمَّ بِسَيِّئَةٍ فَلَمْ يَعْمَلْهَا لَمْ يُكْتَبْ عَلَيْهِ شَيْءٌ، فَإِنْ عَمِلَهَا كُتِبَتْ سَيِّئَةً وَاحِدَةً» """".\nرَوَاهُ أَبُو يَعْلَى، وَرِجَالُهُ رِجَالُ الصَّحِيحِ."
"10486"," حضرت سائب بن یزید رضی اللہ عنہ بیان کرتے ہیں : ایک شخص کو نبی اکرم ﷽ کے پاس لایا گیا لوگوں نے عرض کی : یا رسول اللہ ! اس شخص نے ایک اونٹ چوری کیا ہے + راوی کو شک ہے شاید یہ الفاظ ہیں : , ایک جانور چوری کیا ہے ۔ نبی اکرم ﷽ نے فرمایا : اس کے بارے میں میرا یہ خیال نہیں ہے کہ اس نے ایسا کیا ہو گا "" لوگوں نے عرض کی : یا رسول اللہ ! اس نے چوری کی ہے پھر نبی اکرم ﷽ نے فرمایا : اس کے بارے میں میرا یہ خیال نہیں ہے کہ اس نے ایسا کیا ہو گا "" یہاں تک کہ اس شخص نے اپنے خلاف گواہیاں دیں تو نبی اکرم ﷽ نے فرمایا : تم اسے لے جاا اور اس کا ہاتھ کاٹ دو پھر اسے میرے پاس لے کر آنا لوگ اسے لے گئے اور انہوں نے اس کا ہاتھ کاٹ دیا پھر وہ اسے لے کر نبی اکرم ﷽ کے پاس آئے تو نبی اکرم ﷽ نے ارشاد فرمایا : تمہارا ستیاناس ہو تم اللہ تعالیٰ کی بارگاہ میں   توبہ کرو اس نے عرض کی : میں اللہ تعالیٰ کی بارگاہ میں توبہ کرتا ہوں ۔ نبی اکرم ﷽ نے فرمایا : اے اللہ ! تو اس کی توبہ قبول فرما ۔   یہ روایت امام طبرانی نے نقل کی ہے "" اور اس کے رجال صحیح کے رجال ہیں ۔"
"10487"," امام شعبی بیان کرتے ہیں : شراحہ ہمدانیہ حضرت علی رضی اللہ عنہ کے پاس آئی اور بولی : میں نے زنا کا ارتکاب کیا ہے ۔   حضرت علی رضی اللہ عنہ نے فرمایا : شاید تم مزاج کی تیزی کی وجہ سے ایسا کہہ رہی ہو شاید تم نے یہ چیز خواب میں دیکھی تھی شاید تمہارے ساتھ زبردستی کی گئی تھی ہر مرتبہ اس عورت نے یہی جواب دیا : جی نہیں ۔"
"10488","حضرت معاذ بن جبل رضی اللہ عنہ ، نبی اکرم ﷺ کے حوالے سے یہ بات نقل کرتے ہیں ( نبی اکرم ﷺ نے ارشاد فرمایا :   """" تقدیر کے مقابلے میں احتیاط کوئی فائدہ نہیں دیتی ، لیکن دعا اْس چیز میں بھی نفع دیتی ہے جو نازل ہو چکی ہو ، اور اس میں بھی دیتی ہے جو نازل نہ ہوئی ہو ، تو اے اللہ کے بندو ! تم پر دعا کرنا لازم ہے ۔""""  یہ روایت امام احمد اور امام طبرانی نے نقل کی ہے ، شہر بن حوشب نامی راوی نے حضرت معاذ رضی اللہ عنہ سے سماع نہیں کیا ہے ، اور اسماعیل بن عیاش کی ، اہل حجاز سے نقل کردہ روایات ضعیف ہوتی ہیں ۔ 17192"
"10489"," قاسم بیان کرتے ہیں : حضرت عبداللہ بن مسعود رضی اللہ عنہ فرماتے ہیں : "
"10490"," حضرت یعلی بن مرہ رضی اللہ عنہ کے بارے میں یہ بات منقول ہے : وہ زیاد کے پاس موجود تھے ایک شخص آیا اس نے گواہی دی پھر اس نے گواہی تبدیل کر لی تو زیاد نے کہا : میں تمہاری زبان ضرور کٹوا دوں گا "" تو حضرت یعلی رضی اللہ عنہ نے اس سے کہا : کیا میں تمہیں ایک حدیث نہ سنااں جو میں نے نبی اکرم ﷽ کی زبانی سنی ہے "" میں نے نبی اکرم ﷽ کو یہ ارشاد فرماتے ہوئے سنا ہے : اللہ تعالیٰ فرماتا ہے :   """" تم میرے بندوں کا مثلہ نہ کرو """"۔  راوی کہتے ہیں : تو زیاد نے اسے ترک کر دیا ۔   یہ روایت امام احمد نے نقل کی ہے ۔ ان صحابی کی نقل کردہ ایک روایت جو امام طبرانی نے نقل کی ہے اس میں وہ بیان کرتے  ہیں : میں نے نبی اکرم ﷽ کو یہ ارشاد فرماتے ہوئے سنا ہے :   """" تم لوگ اللہ کے بندوں کا مثلہ نہ کرو """"۔  ان دونوں روایات کی سند میں ایک راوی عطاء بن سائب ہے "" جو اختلاط کا شکار ہو گیا تھا ۔"
"10491"," حضرت مغیرہ بن شعبہ رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے مثلہ کرنے سے منع کیا ہے ۔   یہ روایت امام احمد نے ایک شخص کے حوالے سے نقل کی ہے "" جو حضرت مغیرہ رضی اللہ عنہ کی اولاد سے تعلق رکھتا ہے اس کے حوالے سے یہ حضرت مغیرہ رضی اللہ عنہ سے منقول ہے طبرانی میں یہ بات منقول ہے کہ یہ روایت حضرت مغیرہ رضی اللہ عنہ کے نواسے مغیرہ سے منقول ہے وہ بیان کرتے ہیں : حیرہ کے مقام پر حضرت مغیرہ بن شعبہ رضی اللہ عنہ کا گزر ہوا وہاں کچھ لوگوں نے ایک لومڑی کو نشانہ بنایا ہوا تھا "" اور اس پر نشانے بازی کر رہے تھے "" تو حضرت مغیرہ رضی اللہ عنہ ان کے پاس کھڑے ہوئے "" اور بولے میں نے نبی اکرم ﷽ کو مثلہ کرنے سے منع کرتے ہوئے سنا ہے ۔   اگر تو حضرت مغیرہ رضی اللہ عنہ کے نواسے مغیرہ سے مراد مغیرہ بن عبداللہ یشکری ہے "" تو پھر وہ ثقہ ہے "" اور اگر یہ اس کے علاوہ کوئی اور ہے "" تو پھر میں اس سے واقف نہیں ہوں ۔  اس سے پہلے قسموں اور نذر سے متعلق باب میں حضرت عمران بن حصین رضی اللہ عنہ سے منقول حدیث گزر چکی ہے ۔"
"10492"," حضرت حکم بن عمرو رضی اللہ عنہ اور حضرت عائذ بن قرظ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" اللہ کی مخلوق میں سے کسی ایسی چیز کا مثلہ نہ کرو جس میں روح موجود ہوتی ہے """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی سلیمان بن سلمہ خبائری ہے "" اور وہ متروک ہے ۔"
"10493"," اسماعیل بن راشد کہتے ہیں : ابن ملجم "" اللہ تعالیٰ اس پر اور اس کے ساتھیوں پر لعنت کرے اس کے واقعہ میں یہ بات ہے "" جس میں راوی نے پوری روایت ذکر کی ہے "" جو حضرت علی رضی اللہ عنہ کی وفات اور ان کے قتل ہونے کے بارے میں ہے اس میں راوی کہتے ہیں : حضرت علی رضی اللہ عنہ نے امام حسین رضی اللہ عنہ سے فرمایا : اگر میں زندہ رہ گیا تو اس کے بارے میں اپنی رائے دیکھوں گا + کہ وہ کیا ہوتی ہے آ , اور اگر اس کی اس ضرب کی وجہ سے میں مر گیا تو تم بھی اسے ایک ضرب لگانا تم اس کا مثلہ نہ کرنا کیونکہ میں نے نبی اکرم ﷽ کو مثلہ کرنے سے منع کرتے ہوئے سنا ہے خواہ وہ کوئی باالہ کتا ہی کیوں نہ ہو ۔   یہ مکمل روایت حضرت علی رضی اللہ عنہ کے مناقب سے متعلق باب میں آئے گی ۔   یہ روایت امام طبرانی نے نقل کی ہے "" اور اس کی سند منقطع ہے ۔"
"10494"," حضرت ابوایوب انصاری رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے + کوئی چیز , لوٹ لینے اور مثلہ کرنے سے منع فرمایا ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے "" اور اس کے رجال صحیح کے رجال ہیں ۔"
"10495","وَعَنْ عُبَادَةَ بْنِ الصَّامِتِ: أَنَّ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - قَالَ: """" «مَا عَلَى وَجْهِ الْأَرْضِ مِنْ رَجُلٍ مُسْلِمٍ يَدْعُو اللَّهَ بِدَعْوَةٍ إِلَّا آتَاهُ إِيَّاهَا، أَوْ كَفَّ عَنْهُ مِنَ السُّوءِ مِثْلَهَا، مَا لَمْ يَدْعُ بِإِثْمِ، أَوْ قَطِيعَةِ رَحِمٍ، مَا لَمْ يُعَجِّلْ """". قَالُوا: يَا رَسُولَ اللَّهِ، وَمَا اسْتِعْجَالُهُ؟ قَالَ: """" يَقُولُ: قَدْ دَعَوْتُ (وَدَعَوْتُ) فَلَمْ يُسْتَجَبْ لِي """"، فَقَالَ رَجُلٌ مِنَ الْقَوْمِ: إِذًا نُكْثِرُ يَا رَسُولَ اللَّهِ؟ قَالَ: """" اللَّهُ أَكْثَرُ» """". قُلْتُ: رَوَاهُ التِّرْمِذِيُّ بِاخْتِصَارِ اسْتِعْجَالِ الدُّعَاءِ.\nرَوَاهُ الطَّبَرَانِيُّ فِي الْأَوْسَطِ، وَفِيهِ مَسْلَمَةُ بْنُ عَلِيٍّ، وَهُوَ ضَعِيفٌ."
"10496"," حضرت عبداللہ بن عمر رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ نے مثلہ کرنے سے منع کیا ہے ۔   یہ روایت امام طبرانی نے معجم اوسط اور معجم کبیر میں نقل کی ہے ۔ اس کی سند میں ایک راوی محمد بن ابان قرشی ہے "" اور وہ ضعیف ہے ۔"
"10497"," حضرت زید بن خالد رضی اللہ عنہ نے نبی اکرم ﷽ کے بارے میں یہ بات نقل کی ہے : آپ ﷽ نے + کوئی چیز , لوٹ لینے اور مثلہ کرنے سے منع کیا ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی ایسا ہے "" جس کا نام بیان نہیں کیا گیا ہے ۔"
"10498"," قاسم بن محمد بیان کرتے ہیں : سیدہ اسماء رضی اللہ عنہما اپنے ایک پڑوسی کے ساتھ آئیں ان کی بینائی رخصت ہو چکی تھی انہوں نے دریافت کیا : حجاج کہاں ہے آ ہم نے کہا : وہ یہاں نہیں ہے ۔ سیدہ اسماء رضی اللہ عنہا نے فرمایا : اسے کہو کہ وہ یہ ہڈیاں ہمیں دیدے کیونکہ میں نے نبی اکرم ﷽ کو مثلہ کرنے سے منع کرتے ہوئے سنا ہے 111111111 اس کے بعد راوی نے پوری روایت ذکر کی ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے "" اور اس کے رجال ثقہ ہیں ۔"
"10499"," حضرت عمران بن حصین رضی اللہ عنہ بیان کرتے ہیں : حضرت عمر بن خطاب رضی اللہ عنہ نے یہ بات بیان کی ہے : نبی اکرم ﷽ نے ہمیں خطبہ دیتے ہوئے ہمیں صدقہ کرنے کا حکم دیا "" اور ہمیں مثلہ کرنے سے منع کیا ۔   یہ روایت امام طبرانی نے معجم صغیر میں نقل کی ہے "" اور اس کی سند میں ایسے راوی ہیں ، جن سے میں واقف نہیں ہوں ۔"
"10500"," ابوصالح حنفی نے نبی اکرم ﷽ کے اصحاب میں سے ایک صاحب کے حوالے سے یہ روایت نقل کی ہے "" راوی کہتے ہیں : میرا خیال ہے وہ صاحب حضرت عبداللہ بن عمر رضی اللہ عنہما ہیں وہ بیان کرتے ہیں : میں نے نبی اکرم ﷽ کو یہ ارشاد فرماتے ہوئے سنا ہے :   """" جو شخص کسی ذی روح کا مثلہ کرے اور پھر اس عمل سے توبہ نہ کرے تو قیامت کے دن اللہ تعالیٰ اس کا مثلہ کرے گا ‟۔ یہ روایت امام احمد نے اور امام طبرانی نے معجم اوسط میں حضرت عبداللہ بن عمر رضی اللہ عنہما کے حوالے سے کسی شک کے بغیر نقل کی ہے ""  اور امام احمد کے رجال ثقہ ہیں ۔"
"10501"," حضرت عبداللہ بن مسعود رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے اس بات سے منع کیا ہے کہ اولاد آدم میں سے کسی کو خصی کیا جائے ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی معاویہ بن عطاء خزاعی ہے "" اور وہ ضعیف ہے ۔"
"10502"," حضرت عقبہ بن عامر رضی اللہ عنہ نبی اکرم ﷽ کے حوالے سے اس کی مانند نقل کرتے ہیں جو اس سے پہلے والی حدیث میں نبی اکرم ﷽ کے حوالے سے نقل ہوا ہے : + نبی اکرم ﷽ نے ارشاد فرمایا ہے : , """" میری امت سے خطا ، نسیان اور جس چیز پر انہیں مجبور کیا گیا ہو "" وہ اٹھا لی گئی ہیں + یعنی ان کا گناہ نہیں ہو گا , """"۔ یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ اس کی سند میں ایک راوی ابن لہیعہ ہے اس کی نقل کردہ حدیث حسن ہے "" اور اس میں ضعف پایا جاتا ہے ۔"
"10503"," حضرت عمران بن حصین رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :   """" میری امت کے لئے ان چیزوں سے درگزر کیا گیا ہے "" جو وہ دل میں سوچتے ہیں جب تک وہ اس کے بارے میں بات نہیں کرتے یا عمل نہیں کرتے """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی مسعودی ہے "" جو اختلاط کا شکار ہو گیا تھا اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"10504"," حضرت ثوبان رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :   """" بے شک اللہ تعالیٰ نے میری امت کی تین چیزوں سے درگزر کیا ہے خطاء ، نسیان اور جس پر انہیں مجبور کیا گیا ہو """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی یزید بن ربیعہ رحبی ہے "" اور وہ ضعیف ہے ۔"
"10505","وَعَنْ جَابِرٍ قَالَ: قَالَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: """" «إِنَّ لِلَّهِ فِي كُلِّ يَوْمٍ وَلَيْلَةٍ عُتَقَاءَ مِنَ النَّارِ فِي شَهْرِ رَمَضَانَ، وَإِنَّ لِكُلِّ مُسْلِمٍ دَعْوَةً يَدْعُو بِهَا فَيُسْتَجَابُ لَهُ» """". قُلْتُ: رَوَاهُ ابْنُ مَاجَهْ بِاخْتِصَارِ الدَّعْوَةِ.\nرَوَاهُ الْبَزَّارُ، وَرِجَالُهُ ثِقَاتٌ."
"10506"," حضرت عبداللہ بن عمر رضی اللہ عنہما نے نبی اکرم ﷽ کے حوالے سے اس کی مانند روایت نقل کی ہے ۔ "
"10507"," سیدہ عائشہ صدیقہ رضی اللہ عنہا بیان کرتی ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" مجھے تم لوگوں کے بارے میں غلطی سے کیے جانے والے کاموں کے حوالے سے اندیشہ نہیں ہے بلکہ مجھے تمہارے بارے میں جان بوجھ کر کیے جانے والے کاموں کے حوالے سے اندیشہ ہے """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ اس کی سند میں ایک راوی بقیہ بن ولید ہے "" اور وہ مدلس ہے ۔"
"10508"," عثمان بن حیان بیان کرتے ہیں : میں سیدہ ام درداء رضی اللہ عنہا کے پاس آتا تھا "" اور ان کے پاس بیٹھ کر + احادیث , نوٹ کرتا تھا "" ایک مرتبہ میں نے ایک جواں یا پسو کو پکڑا اور اسے آگ میں ڈال دیا "" تو انہوں نے فرمایا : اے میرے بیٹے ! تم ایسا نہ کرو کیونکہ میں نے حضرت ابودرداء رضی اللہ عنہ کو یہ بیان کرتے ہوئے سنا ہے : وہ کہتے ہیں : میں نے نبی اکرم ﷽ کو یہ ارشاد فرماتے ہوئے سنا ہے : "
"10509"," بشر بن عبیداللہ "" جو ایک پرانے بزرگ ہیں وہ بیان کرتے ہیں :   ہم مقام ابراہیم کے پاس طااس کے ساتھ موجود تھے ہم نے شور و غوغا سنا انہوں نے دریافت کیا : کیا ہوا ہے ہم نے کہا : کچھ لوگوں کو ابن ہشام نے کسی جرم کی وجہ سے پکڑا تھا "" اور اب وہ ان کو چکر لگوا رہا ہے ۔ راوی کہتے ہیں : تو میں نے طااس کو حضرت عبداللہ بن عباس رضی اللہ عنہما کے حوالے سے یہ حدیث بیان کرتے ہوئے سنا کہ نبی اکرم ﷽ نے ارشاد فرمایا ہے :   """" جو بھی شخص اس امت میں کوئی نئی چیز پیدا کرے گا "" جو پہلے نہ ہوئی ہو "" تو وہ اس وقت تک نہیں مرے گا "" جب تک وہ خود اس کا سامنا نہیں کرے گا """"۔  راوی کہتے ہیں : تو میں نے ابن ہشام کو دیکھا کہ جب اسے معزول کیا گیا اور ولید کا مقرر کردہ دوسرا حکمران آیا تو اس "
"10510"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :"""" تین قسم کے لوگوں سے قلم اٹھا لیا گیا ہے "" سوئے ہوئے شخص سے جب تک وہ بیدار نہیں ہو جاتا ذہنی توازن کی خرابی کا شکار شخص جب تک وہ ٹھیک نہیں ہو جاتا اور بچے سے جب تک اسے عقل نہیں آ جاتی + راوی کو شک ہے شاید یہ"
"10511"," ابوادریس خولانی بیان کرتے ہیں : مجھے ایک سے زیادہ صحابہ کرام نے یہ بات بیان کی ہے جن میں ایک حضرت شداد بن اوس رضی اللہ عنہ اور ایک حضرت ثوبان رضی اللہ عنہ ہیں "" وہ بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا ہے :   """" تین قسم کے لوگوں سے قلم اٹھا لیا گیا ہے "" بچے سے "" جب تک وہ بڑا نہیں ہو جاتا ہے "" سوئے ہوئے شخص سے "" جب تک وہ بیدار نہیں ہو جاتا "" اور پاگل سے "" جب تک وہ ٹھیک نہیں ہو جاتا """"۔   یہ روایت امام طبرانی نے نقل کی ہے "" اور اس کے رجال ثقہ ہیں ۔"
"10512"," حضرت ابوہریرہ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" تین قسم کے لوگوں سے قلم اٹھا لیا گیا ہے بچے سے جب تک وہ بڑا نہیں ہو جاتا ہے سوئے ہوئے شخص سے جب تک وہ بیدار نہیں ہو جاتا اور پاگل سے جب تک وہ ٹھیک نہیں ہو جاتا """"۔   یہ روایت امام بزار نے نقل کی ہے ۔ اس کی سند میں ایک راوی عبدالرحمن بن عبداللہ بن عمر بن حفص ہے "" اور وہ متروک ہے ۔"
"10513"," حضرت اسلم بن بجرہ رضی اللہ عنہ نے نبی اکرم ﷽ کے بارے میں یہ بات نقل کی ہے کہ آپ نے انہیں قریظہ کے قیدیوں پر مقرر کیا تھا وہ لڑکے کی شرمگاہ کا جائزہ لیتے تھے اگر وہ دیکھتے تھے کہ اگر اس کے زیرناف بال اگ چکے ہوں تو وہ اس کی گردن اڑا دیتے تھے اور جس کے زیر ناف بال نہیں اگے ہوتے تھے اسے پکڑ کر مسلمانوں کے مال غنیمت میں شامل کر دیتے تھے ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی اسحاق بن عبداللہ بن ابوفروہ ہے "" اور وہ متروک ہے ۔"
"10514"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ کے گھر والوں کی خادمہ نے گناہ کا ارتکاب کیا "" تو نبی اکرم ﷽ نے ارشاد فرمایا : اے علی ! تم اس پر حد جاری کرو ۔ راوی کہتے ہیں : حضرت علی رضی اللہ عنہ نے اس عورت کو رہنے دیا """"۔ یہاں تک کہ اس نے اپنے پیٹ میں موجود بچے کو جنم دے دیا پھر حضرت علی رضی اللہ عنہ نے اسے پچاس کوڑے لگائے پھر وہ نبی اکرم ﷽ کی خدمت میں حاضر ہوئے "" اور آپ کے سامنے یہ بات ذکر کی تو آپ نے فرمایا : تم نے ٹھیک کیا ہے ۔   یہ روایت امام ابویعلیٰ نے نقل کی ہے ۔ اس کی سند میں ایک راوی مندل بن علی ہے "" اور وہ ضعیف ہے ۔"
"10515"," حضرت انس رضی اللہ عنہ بیان کرتے ہیں : ایک خاتون نے چار مرتبہ زنا کرنے کا اعتراف کر لیا وہ عورت حاملہ تھی نبی اکرم ﷽ نے اس سے فرمایا : تم جاا اور پہلے بچے کو جنم دو پھر وہ عورت آئی وہ اس وقت بچے کو جنم دے چکی تھی پھر نبی اکرم ﷽ نے فرمایا : پہلے تم اس بچے کو دودھ پلاا جب تک دودھ چھڑا نہیں دیتی پھر وہ عورت آئی ، تو نبی اکرم ﷽ نے اسے سنگسار کروایا لوگوں نے اس عورت کا ذکر کیا "" تو نبی اکرم ﷽ نے ارشاد فرمایا : اس عورت نے ایسی توبہ کی ہے کہ اگر بھتہ لینے والا شخص وہ توبہ کرتا تو اس کی بھی مغفرت ہو جاتی """"۔   یہ روایت امام بزار نے نقل کی ہے "" اور اس کے رجال ثقہ ہیں البتہ اعمش نامی راوی نے حضرت انس رضی اللہ عنہ سے سماع نہیں کیا ہے اس نے حضرت انس رضی اللہ عنہ کی زیارت کی ہے ۔"
"10516"," حضرت ابوسعید خدری رضی اللہ عنہ بیان کرتے ہیں : ایک صاحب جو انتہائی کمزور تھے وہ ام سعد کے گھر کے پاس رہتے تھے وہاں ایک عورت کا حمل ظاہر ہوا اس سے اس کے بارے میں دریافت کیا گیا تو اس نے بتایا : یہ اس کمزور شخص سے ہے اس شخص سے اس بارے میں دریافت کیا گیا تو اس نے گناہ کا اعتراف کر لیا تو نبی اکرم ﷽ کے حکم کے تحت اسے کھجور کی شاخوں کے  ذریعے اسے سزا دی گئی ۔   یہ روایت امام طبرانی نے نقل کی ہے "" اور اس کے رجال صحیح کے رجال ہیں ۔"
"10517"," حضرت ابوامامہ رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ کے پاس ایک شخص کو لایا گیا جس نے زنا کا ارتکاب کیا تھا ۔ نبی اکرم ﷽ نے اس سے دریافت کیا : تو اس نے اعتراف کر لیا ۔ نبی اکرم ﷽ کے حکم کے تحت اس کے اوپری کپڑے اتارے گئے تو وہ انتہائی کمزور شخص تھا ۔ نبی اکرم ﷽ نے فرمایا : اگر اسے ضرب لگائی گئی ، تو یہ زندہ نہیں رہے گا ، پھر نبی اکرم ﷽ نے شاخ منگوائی جس میں ایک سو شاخیں تھیں اور ان کے ذریعے اسے ایک مرتبہ ضرب لگا دی ۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے "" اور اس کے رجال ثقہ ہیں ۔"
"10518"," حضرت سہل بن سعد ساعدی رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ کے پاس ایک بوڑھے کو لایا گیا جسے پیٹ کی خرابی کی شکایت تھی اور اس کا رنگ زرد ہو چکا تھا اس کی رگیں ظاہر ہو چکی تھیں اس نے ایک عورت کے ساتھ زنا کیا تھا ۔ نبی اکرم ﷽ نے اسے شاخ ماری "" جس میں ایک سو تنکے تھے ۔ "
"10519"," حضرت جابر رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" جو شخص اس بات کی گواہی دے کہ اللہ تعالیٰ کے علاوہ اور کوئی معبود نہیں ہے "" اور میں اللہ کا رسول ہوں اس کا خون تین میں سے صرف وجہ سے حلال ہو سکتا ہے اپنے دین کو ترک کرنے والا شخص یا زنا کرنے والا شادی شدہ شخص یا وہ شخص جس نے کسی کو ظلم کے طور پر قتل کیا ہو """"۔   یہ روایت امام بزار نے نقل کی ہے ۔ اس کی سند میں ایک راوی محمد بن ابولیلی ہے "" اور وہ خراب حافظے کا مالک ہے ۔"
"10520"," حضرت عمار بن یاسر رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" مومن کا خون تین میں سے کسی ایک وجہ سے حلال ہو سکتا ہے جان کے بدلے میں جان ، شادی شدہ زانی اور ایمان کو چھوڑ کر مرتد ہونے والا """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی ایوب بن سوید ہے "" اور وہ متروک ہے اسے ابن حبان نے "
"10521"," حضرت ابوامامہ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :"""" جو شخص ناحق طور پر کسی مسلمان کی پشت سے کپڑا ہٹا دے جب وہ اللہ تعالیٰ کی بارگاہ میں حاضر ہو گا "" تو اللہ تعالیٰ اس پر غضبناک ہو گا """"۔   یہ روایت امام طبرانی نے معجم کبیر اور معجم اوسط میں نقل کی ہے "" اور اس کی سند عمدہ ہے ۔"
"10522"," حضرت عصمہ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :  مومن کی پشت چراہ گاہ ہے البتہ اس کے حق کا معاملہ مختلف ہے """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی فضل بن مختار ہے "" اور وہ ضعیف ہے ۔"
"10523"," حضرت عبداللہ بن مسعود رضی اللہ عنہ فرماتے ہیں : اس امت میں تجرید "" مد اور صفر جائز نہیں ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے یہ سند کے اعتبار سے منقطع ہے ۔ اس کی سند میں ایک راوی جویبر ہے "" اور وہ ضعیف ہے ۔"
"10524"," حضرت عبداللہ بن عمرو رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :"""" جو شخص مسلمان کی طرف اس طرح نظر کرے کہ اس کے ذریعے اسے خوف زدہ کر دے اور وہ ناحق طور پر ایسا کرے تو قیامت کے دن اللہ تعالیٰ اس شخص کو خوف کا شکار کرے گا ‟۔ یہ روایت امام طبرانی نے اپنے استاد احمد بن عبدالرحمن بن عقال کے حوالے سے نقل کی ہے "" اور ابوعروبہ نے اسے ضعیف قرار دیا ہے ۔"
"10525","عَنِ ابْنِ مَسْعُودٍ: أَنَّ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - قَالَ: """" «إِذَا كَانَ ثُلُثُ اللَّيْلِ الْبَاقِي يَهْبِطُ اللَّهُ - عَزَّ وَجَلَّ - إِلَى السَّمَاءِ الدُّنْيَا، ثُمَّ تُفْتَحُ أَبْوَابُ السَّمَاءِ، ثُمَّ يَبْسُطُ يَدَهُ - عَزَّ وَجَلَّ - فَيَقُولُ: هَلْ مِنْ سَائِلٍ يُعْطَى سُؤْلَهُ؟ فَلَا يَزَالُ كَذَلِكَ حَتَّى يَسْطَعَ الْفَجْرُ» """".\nرَوَاهُ أَحْمَدُ وَأَبُو يَعْلَى، وَرِجَالُهُمَا رِجَالُ الصَّحِيحِ."
"10526"," حضرت ابوالحسن رضی اللہ عنہ "" جنہیں بیعت عقبہ اور غزوہ بدر میں شرکت کا شرف حاصل ہے وہ بیان کرتے ہیں : ایک مرتبہ ہم نبی اکرم ﷽ کے ساتھ بیٹھے ہوئے تھے ایک شخص اٹھ کر گیا وہ اپنے جوتے بھول گیا ایک اور شخص نے وہ جوتے لے لئے اور انہیں اپنے نیچے رکھ لیا پھر وہ شخص واپس آیا اور اس نے کہا : یہاں میرے جوتے تھے لوگوں نے کہا : ہم نے وہ نہیں دیکھے اس نے کہا : وہ یہیں تھے نبی اکرم ﷽ نے فرمایا : کسی مومن کو کیسے پریشان کیسے پریشان کیا جا سکتا ہے اس شخص نے عرض کی : یا رسول اللہ ! میں نے مذاق کے طور پر ایسا کیا ہے ۔ نبی اکرم ﷽ نے فرمایا : کسی مومن کو کیسے پریشان کیا جا سکتا ہے آ یہ بات آپ نے دو یا شاید تین مرتبہ یہ بات ارشاد فرمائی ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی حسین بن عبداللہ بن عبیداللہ ہاشمی ہے "" اور وہ ضعیف ہے ۔"
"10527"," حضرت عبداللہ بن عمر رضی اللہ عنہما بیان کرتے ہیں : میں نے نبی اکرم ﷽ کو یہ ارشاد فرماتے ہوئے سنا ہے :   """" جو شخص کسی مومن کو خوف زدہ کرے تو اللہ تعالیٰ کے ذمہ یہ بات لازم ہے کہ اس شخص کو قیامت کی خوف زدہ کرنے والی چیزوں سے محفوظ نہ رکھے """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ اس کی سند میں ایک راوی محمد بن حفص وصابی ہے "" اور وہ ضعیف ہے ۔"
"10528","ابن عمر سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""کسی مسلمان یا مومن کے لیے جائز نہیں کہ وہ کسی مسلمان کو ڈرائے۔"" بزار نے روایت کیا ہے، اس میں عبدالکریم ابو امیہ ہیں جو ضعیف ہیں۔"
"10529"," حضرت نعمان بن بشیر رضی اللہ عنہ بیان کرتے ہیں : ہم نبی اکرم ﷽ کے ساتھ سفر کر رہے تھے ایک شخص اپنی سواری پر اونگھنے لگا "" تو دوسرے شخص نے اس کے ترکش میں سے ایک تیر لے لیا وہ شخص بیدار ہو گیا اور پریشان ہو گیا ۔ نبی اکرم ﷽ نے فرمایا : کسی شخص کے لئے یہ بات حلال نہیں ہے کہ وہ کسی مسلمان کو خوف زدہ کرے + یا پریشان کرے , """"۔   یہ روایت امام طبرانی نے معجم کبیر اور معجم اوسط میں نقل کی ہے معجم کبیر کے رجال ثقہ ہیں ۔"
"10530","وَعَنْ عُبَادَةَ بْنِ الصَّامِتِ قَالَ: قَالَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: """" «يَنْزِلُ رَبُّنَا - تَبَارَكَ وَتَعَالَى - إِلَى السَّمَاءِ الدُّنْيَا حِينَ يَبْقَى ثُلُثُ اللَّيْلِ، فَيَقُولُ: أَلَا عَبْدٌ مِنْ عِبَادِي يَدْعُونِي فَأَسْتَجِيبَ لَهُ؟ أَلَا ظَالِمٌ لِنَفْسِهِ يَدْعُونِي فَأَغْفِرَ لَهُ؟ أَلَا مُقْتِرٌ فَأَرْزُقَهُ؟ أَلَا مَظْلُومٌ يَدْعُونِي فَأَنْصُرَهُ؟ أَلَا عَانٍ فَأَفُكُّ عَنْهُ؟ فَيَكُونُ كَذَلِكَ حَتَّى يُصْبِحَ الصُّبْحُ، ثُمَّ يَعْلُو - جَلَّ وَعَزَّ - عَلَى كُرْسِيِّهِ """".\nرَوَاهُ الطَّبَرَانِيُّ فِي الْكَبِيرِ وَالْأَوْسَطِ بِنَحْوِهِ، وَقَالَ فِيهِ: """" أَلَا مَظْلُومٌ (يُذَكِّرُنِي) فَأَنْصُرَهُ؟ أَلَا عَانٍ (يَدْعُونِي) فَأُعِينَهُ؟ """". قَالَ: """" فَيَكُونُ كَذَلِكَ حَتَّى يُضِيءَ الصُّبْحُ» """". وَيَحْيَى بْنُ إِسْحَاقَ لَمْ يَسْمَعْ مِنْ عُبَادَةَ، وَلَمْ يَرْوِ عَنْهُ غَيْرُ مُوسَى بْنِ عَقْبَةَ، وَبَقِيَّةُ رِجَالِ الْكَبِيرِ رِجَالُ الصَّحِيحِ."
"10531"," حضرت ابوہریرہ رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ سے دریافت کیا گیا : کیا آپ کو بھی غصہ آتا ہے آ نبی اکرم ﷽ نے ارشاد فرمایا : اللہ کی قسم مجھے بھی غصہ آتا ہے "" اور اللہ تعالیٰ کو مجھ سے زیادہ غصہ آتا ہے "" اور اس کے غصے میں یہ چیز شامل ہے کہ اس نے فحش چیزوں سے منع کیا ہے ۔   یہ روایت امام احمد نے نقل کی ہے "" اور اس کے رجال ثقہ ہیں ۔"
"10532"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : میں نے نبی اکرم ﷽ کو یہ ارشاد فرماتے ہوئے سنا ہے :   """" میں تمہارے پہلو سے پکڑ کر تمہیں یہ کہتا ہوں تم لوگ جہنم سے بچو تم لوگ حدود کے ارتکاب سے بچو تم لوگ جہنم سے بچو تم لوگ حدود کے ارتکاب سے بچو تم لوگ جہنم سے بچو تم لوگ حدود کے ارتکاب سے بچو یہ بات آپ نے تین مرتبہ ارشاد فرمائی "
"10533"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :"""" تم لوگ زنا سے بچو ! کیونکہ اس میں چار چیزیں پائی جاتی ہیں وہ چہرے کی رونق رخصت کر دیتا ہے رزق کو ختم کر دیتا ہے رحمان کو ناراض کر دیتا ہے "" اور جہنم میں ہمیشگی کا باعث بنتا ہے """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ اس کی سند میں ایک راوی عمرو بن جمیع ہے "" اور وہ متروک ہے ۔"
"10534"," حضرت عبداللي بن بسر رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :"""" زنا کرنے والے لوگ جب آئیں گے "" تو ان کے چہرے آگ سے جل رہے ہوں گے """"۔   یہ روایت امام طبرانی نے محمد بن عبداللہ بن بسر کے حوالے سے ان کے والد سے نقل کی ہے میں ان سے واقف نہیں ہوں اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"10535","وَعَنْ فَضَالَةَ بْنِ عُبَيْدٍ قَالَ: «بَيْنَا رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - قَاعِدٌ إِذْ دَخَلَ رَجُلٌ فَصَلَّى، ثُمَّ قَالَ: اللَّهُمَّ اغْفِرْ لِي وَارْحَمْنِي. فَقَالَ لَهُ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: """" عَجِلْتَ أَيُّهَا الْمُصَلِّي، إِذَا صَلَّيْتَ فَقَعَدْتَ فَاحْمَدِ اللَّهَ بِمَا هُوَ أَهْلُهُ، ثُمَّ صَلِّ عَلَيَّ، ثُمَّ ادْعُهُ """".\nثُمَّ صَلَّى آخَرُ، فَحَمِدَ اللَّهَ، وَصَلَّى عَلَى النَّبِيِّ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لَهُ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: """" سَلْ تُعْطَهْ» """". قُلْتُ: رَوَاهُ أَبُو دَاوُدَ خَلَا مِنْ قَوْلِهِ: ثُمَّ صَلَّى آخَرُ إِلَى آخِرِهِ.\nرَوَاهُ الطَّبَرَانِيُّ، وَفِيهِ رِشْدِينُ بْنُ سَعْدٍ، وَحَدِيثُهُ فِي الرِّقَاقِ مَقْبُولٌ، وَبَقِيَّةُ رِجَالِهِ ثِقَاتٌ.\nقُلْتُ: وَتَأْتِي أَحَادِيثُ الصَّلَاةِ عَلَى النَّبِيِّ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - بَعْدُ."
"10536"," حضرت سلمان فارسی رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" تین لوگ جنت میں داخل نہیں ہوں گے بوڑھا زانی "" جھوٹا حکمران اور غریب متکبر """"۔   یہ روایت امام بزار نے نقل کی ہے "" اور اس کے رجال صحیح کے رجال ہیں صرف عباس بن ابوطالب کا معاملہ مختلف ہے "" اور وہ ثقہ ہے ۔"
"10537"," حضرت جابر بن عبداللہ رضی اللہ عنہما روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :"""" جب اہل ذمہ پر ظلم کیا جائے "" تو حکمرانی دشمن کے پاس چلی جاتی ہے جب زنا بکثرت ہو جائے "" تو قیدی بکثرت ہو جاتے ہیں "" اور جب قوم لوط کا سا عمل زیادہ ہو جائے "" تو اللہ تعالیٰ مخلوق سے اپنا ہاتھ اٹھا لیتا ہے "" اور پھر وہ اس بات کی پرواہ نہیں کرتا کہ وہ + لوگ , کون سی وادی میں ہلاکت کا شکار ہوتے ہیں """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی عبدالخالق بن زید بن واقد ہے "" اور وہ ضعیف ہے ۔"
"10538"," حضرت ابوہریرہ رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" قیامت کے دن اللہ تعالیٰ بوڑھے زانی مرد اور بوڑھی زانی عورت کی طرف نظر نہیں کرے گا """"۔   یہ روایت امام طبرانی نے معجم اوسط میں اپنے استاد موسیٰ بن سہل کے حوالے سے نقل کی ہے "" اور میں اس سے واقف نہیں ہوں اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"10539"," حضرت عبداللہ بن عمر رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" اللہ تعالیٰ بوڑھے زانی اور غریب متکبر کی طرف نظر نہیں کرے گا """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی ابن لہیعہ ہے اس کی نقل کردہ حدیث حسن ہے اس میں ضعف پایا جاتا ہے ۔ اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"10540","وَعَنْ مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ قَالَ: سَمِعْتُ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ: """" «مَنْ دَعَا بِهَؤُلَاءِ الْكَلِمَاتِ الْخَمْسِ لَمْ يَسْأَلِ اللَّهَ شَيْئًا إِلَّا أَعْطَاهُ: لَا إِلَهَ إِلَّا اللَّهُ، وَاللَّهُ أَكْبَرُ، لَا إِلَهَ إِلَّا اللَّهُ، وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ، وَلَهُ الْحَمْدُ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ، لَا إِلَهَ إِلَّا اللَّهُ، وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ» """".\nرَوَاهُ الطَّبَرَانِيُّ فِي الْكَبِيرِ وَالْأَوْسَطِ، وَإِسْنَادُهُ حَسَنٌ."
"10541"," حضرت بریدہ رضی اللہ عنہ بیان کرتے ہیں :"""" سات آسمان اور سات زمینیں ، بوڑھے زانی پر لعنت کرتے ہیں "" اور زنا کرنے والوں کی شرمگاہوں کی بو اہل جہنم کو بھی اذیت دے گی """"۔"
"10542"," حضرت بریدہ رضی اللہ عنہ کے حوالے سے "" نبی اکرم ﷽ سے "" اس کی مانند روایت منقول ہے ۔  یہ دونوں روایات امام بزار نے نقل کی ہیں "" اور ان دونوں کی سند میں ایک راوی صالح بن حیان ہے "" اور وہ ضعیف ہے ۔"
"10543"," حضرت عبداللہ بن مسعود رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :"""" دونوں آنکھیں زنا کرتی ہیں دونوں پااں زنا کرتے ہیں "" اور شرمگاہ زنا کرتی ہے """"۔   یہ روایت امام احمد نے اور امام ابویعلیٰ نے نقل کی ہے "" اور انہوں نے یہ الفاظ زائد نقل کیے ہیں : † اور دونوں ہاتھ زنا کرتے ہیں """"۔  امام بزار اور امام طبرانی دونوں کی سند عمدہ ہے ۔"
"10544"," حضرت ابوموسی رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" ہر آنکھ زنا کرتی ہے """"۔   یہ روایت امام بزار اور امام طبرانی نے نقل کی ہے "" اور ان دونوں کے رجال ثقہ ہیں ۔ "
"10545","وَعَنْ سَعْدٍ - يَعْنِي ابْنَ أَبِي وَقَّاصٍ - قَالَ: «مَرَرْتُ بِعُثْمَانَ بْنِ عَفَّانَ فِي الْمَسْجِدِ فَسَلَّمْتُ عَلَيْهِ، فَمَلَأَ عَيْنَيْهِ مِنِّي ثَمَّ لَمْ يَرُدَّ عَلَيَّ السَّلَامَ، فَأَتَيْتُ أَمِيرَ الْمُؤْمِنِينَ: عُمَرَ بْنَ الْخَطَّابِ فَقُلْتُ لَهُ: يَا أَمِيرَ الْمُؤْمِنِينَ، هَلْ حَدَثَ فِي الْإِسْلَامِ شَيْءٌ؟ مَرَّتَيْنِ قَالَ: (لَا) وَمَا ذَاكَ؟! قُلْتُ: لَا إِلَّا أَنِّي مَرَرْتُ بِعُثْمَانَ آنِفًا فِي الْمَسْجِدِ فَسَلَّمْتُ عَلَيْهِ، فَمَلَأَ عَيْنَيْهِ مِنِّي، ثُمَّ لَمْ يَرُدَّ عَلَيَّ السَّلَامَ، قَالَ: فَأَرْسَلَ عُمَرُ إِلَى عُثْمَانَ فَدَعَاهُ فَقَالَ: مَا مَنَعَكَ أَلَّا تَكُونَ رَدَدْتَ عَلَى أَخِيكَ السَّلَامَ؟ قَالَ عُثْمَانُ: مَا فَعَلْتُ. قَالَ: قُلْتُ: بَلَى. (قَالَ) حَتَّى حَلَفَ وَحَلَفْتُ، قَالَ: ثُمَّ إِنَّ عُثْمَانَ ذَكَرَ فَقَالَ: بَلَى. وَأَسْتَغْفِرُ اللَّهَ، وَأَتُوبُ إِلَيْهِ، إِنَّكَ مَرَرْتَ بِي آنِفًا، وَإِنِّي أُحَدِّثُ نَفْسِي بِكَلِمَةٍ سَمِعْتُهَا مِنْ رَسُولِ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - (لَا) وَاللَّهِ، مَا ذَكَرْتُهَا قَطُّ إِلَّا تَغْشَى بَصَرِي، وَقَلْبِي غِشَاوَةٌ. قَالَ سَعْدٌ: فَأَنَا أُنْبِئُكَ بِهَا: إِنَّ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - ذَكَرَ لَنَا أَوَّلَ دَعْوَةٍ، ثُمَّ جَاءَهُ أَعْرَابِيٌّ فَشَغَلَهُ حَتَّى قَامَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - فَاتَّبَعْتُهُ، فَلَمَّا أَشْفَقْتُ أَنْ يَسْبِقَنِي إِلَى مَنْزِلِهِ ضَرَبْتُ بِقَدَمِي الْأَرْضَ ; فَالْتَفَتَ إِلَيَّ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ: """" مَنْ هَذَا؟ أَبُو إِسْحَاقَ؟! """". قُلْتُ: نَعَمْ يَا رَسُولَ اللَّهِ، قَالَ: """" فَمَهْ؟ """". قُلْتُ: لَا وَاللَّهِ، أَلَا إِنَّكَ ذَكَرْتَ لَنَا أَوَّلَ دَعْوَةٍ، ثُمَّ جَاءَكَ هَذَا الْأَعْرَابِيُّ فَشَغَلَكَ، قَالَ: """" نَعَمْ. دَعْوَةُ ذِي النُّونِ إِذْ هُوَ فِي بَطْنِ الْحُوتِ: {لَا إِلَهَ إِلَّا أَنْتَ سُبْحَانَكَ إِنِّي كُنْتُ مِنَ الظَّالِمِينَ} [الأنبياء: 87] ; فَإِنَّهُ لَنْ يَدْعُوَ بِهَا مُسْلِمٌ رَبَّهُ فِي شَيْءٍ قَطُّ إِلَّا اسْتَجَابَ لَهُ» """".\nقُلْتُ: عِنْدَ التِّرْمِذِيِّ طَرَفٌ مِنْهُ.\nرَوَاهُ أَحْمَدُ، وَأَبُو يَعْلَى، وَالْبَزَّارُ، وَرِجَالُ أَحْمَدَ وَأَبِي يَعْلَى وَأَحَدُ إِسْنَادَيِ الْبَزَّارِ رِجَالُ الصَّحِيحِ غَيْرَ إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ سَعْدِ بْنِ أَبِي وَقَّاصٍ، وَهُوَ ثِقَةٌ."
"10546"," سہل بن ابوامامہ بیان کرتے ہیں : وہ اور ان کے والد حضرت انس بن مالک رضی اللہ عنہ کی خدمت میں حاضر ہوئے یہ حضرت عمر بن عبدالعزیز کے زمانے کی بات ہے وہ امیر تھے انہوں نے مختصر نماز پڑھائی یوں جیسے مسافر کی نماز ہو یا اس کے قریب کی نماز پڑھائی جب انہوں نے سلام پھیر دیا "" تو انہوں نے کہا : اللہ تعالیٰ آپ پر رحم کرے کیا آپ نے فرض نماز ادا کی ہے یا آپ نے کوئی نفل نماز ادا کی ہے ۔ انہوں نے کہا : یہ فرض نماز تھی اور یہ اللہ کے رسول کی نماز تھی میں نے اس میں کوئی کوتاہی نہیں کی اور نہ ہی اس کے بارے میں بھول کا شکار ہوا ہوں ۔ نبی اکرم ﷽ نے ارشاد فرمایا ہے : "
"10547","امام شعبی بیان کرتے ہیں : ( ارشاد باری تعالیٰ ہے : ) """" اگر تمہیں یہ ( مطلوبہ یا پسندیدہ "" حکم یا فیصلہ ) دیدیا جائے "" تو تم قبول کر لینا اور اگر تمہیں ( تمہارا مطلوبہ حکم یا فیصلہ ) نہیں دیا جاتا "" تو تم ( اس کو قبول کرنے سے ) پرہیز کرنا """"۔ انہوں نے صوریا کے دو بیٹوں کا ذکر کیا کہ جب نبی اکرم ﷺ ان کے پاس تشریف لائے "" اور آپ نے ان دونوں سے فرمایا : اس ذات کی قسم ! جس نے تورات کو حضرت موسیٰ علیہ السلام پر نازل کیا اور جس نے سمندر کو چیر دیا "" اور اس ذات کی قسم ! جس نے تم لوگوں پر من و سلوی نازل کیا تم لوگ زیادہ بہتر جانتے ہو ۔ ان دونوں نے کہا : ہم اپنی قوم کو یہ عطیہ ( یا سہولت ) دیتے ہیں ، پھر ان دونوں میں سے ایک نے کہا : یہ ہمیں اس طرح کا واسطہ دے رہے ہیں نبی اکرم ﷺ نے فرمایا : کیا تم لوگوں نے یہ بات پائی ہے کہ دیکھنا بھی زنا ہے "" اور گلے لگانا بھی زنا ہے "" اور بوسہ لینا بھی زنا ہے 1111111 اس کے بعد راوی نے حسب سابق حدیث ذکر کی ہے ۔ یہ روایت امام ابویعلیٰ نے نقل کی ہے "" اور یہ روایت مرسل ہے "" اور اس کے رجال ثقہ ہیں ۔"
"10548"," حضرت واثلہ رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" خواتین کا ایک دوسرے سے جنسی تعلق زنا ہے """"۔   یہ روایت امام طبرانی نے نقل کی ہے یہی روایت امام ابویعلیٰ نے بھی نقل کی ہے "" اور ان کے الفاظ یہ ہیں : نبی اکرم ﷽ نے  ارشاد فرمایا :   """" خواتین کا جنسی تعلق زنا ہے """"۔ اس کے رجال ثقہ ہیں ۔"
"10549"," سیدہ عائشہ صدیقہ رضی اللہ عنہا بیان کرتی ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" وہ تینوں میں سب سے برا ہے جبکہ وہ اپنے ماں باپ کا سا عمل کرے """"   نبی اکرم ﷽ کی مراد زنا کے نتیجے میں پیدا ہونے والا بچہ تھا ۔ یہ روایت امام احمد نے اسود بن عامر کے حوالے سے ابراہیم بن اسحاق کے اسحاق نامی راوی سے میں واقف نہیں ہوں اس روایت کے بقیہ رجال صیح کے رجال ہیں ۔"
"10550"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" زنا کے نتیجے میں پیدا ہونے والا بچہ تینوں میں سب سے برا ہے جب وہ اپنے ماں باپ کا سا عمل کرے """"۔   یہ روایت امام طبرانی نے معجم کبیر اور معجم اوسط میں نقل کی ہے ۔ اس کی سند میں ایک راوی محمد بن ابولیلی ہے "" اور وہ خراب حافظے کا مالک ہے "" اور ایک راوی مندل ہے اس کی توثیق کی گئی ہے "" اور اس میں ضعف پایا جاتا ہے ۔"
"10551"," نبی اکرم ﷽ کی زوجہ محترمہ سیدہ میمونہ رضی اللہ عنہ بیان کرتی ہیں : میں نے نبی اکرم ﷽ کو یہ ارشاد فرماتے ہوئے سنا ہے :"""" میری امت اس وقت تک بھلائی پر گامزن رہے گی جب تک ان کے درمیان زنا کے نتیجے میں پیدا ہونے والے بچے نہیں پھیل جائیں گے جب ان کے درمیان زنا کے نتیجے میں پیدا ہونے والے بچے پھیل جائیں گے "" تو عنقریب اللہ تعالیٰ ان سب کو عمومی عذاب دے گا """"۔   یہ روایت امام احمد امام ابویعلیٰ اور امام طبرانی نے نقل کی ہے ۔ انہوں نے یہ الفاظ نقل کیے ہیں :   """" میری امت مسلسل بھلائی پر گامزن رہے گی اور وہ اپنے معاملے کو تھام کے رکھے گی جب تک + ان کے درمیان"
"10552"," حضرت عبداللہ بن عمرو رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :"""" + والدین کا , نافرمان شخص ، باقاعدگی سے شراب پینے والا شخص ، احسان جتانے والا شخص اور زنا کے نتیجے میں پیدا ہونے والا بچہ جنت میں داخل نہیں ہوں گے ۔ "
"10553"," حضرت ابوہریرہ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" زنا کے نتیجے میں پیدا ہونے والا بچہ اور اس کی نسل میں سے سات پشتوں تک کوئی جنت میں داخل نہیں ہو گا """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ اس کی سند میں ایک راوی حسین بن ادریس ہے "" اور وہ ضعیف ہے ۔"
"10554"," سیدہ عائشہ صدیقہ رضی اللہ عنہا نبی اکرم ﷽ کا یہ فرمان نقل کرتی ہیں :"""" زنا کے نتیجے میں پیدا ہونے والے بچے پر اس کے ماں باپ کے گناہوں میں سے کوئی چیز لاگو نہیں ہو گی """"۔  پھر انہوں نے یہ آیت تلاوت کی :   """" کوئی بوجھ اٹھانے والا کسی دوسرے کا بوجھ نہیں اٹھائے گا """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ اس کی سند میں ایک راوی جعفر بن محمد بن جعفر مدائنی ہے "" اور میں اس سے واقف نہیں ہوں ۔"
"10555"," ابوولید قرشی بیان کرتے ہیں : میں بلال بن ابوبردہ کے پاس موجود تھا عبدالقیس قبیلے سے تعلق رکھنے والا ایک شخص ان کے پاس آیا اور بولا : اللہ تعالیٰ امیر کو ٹھیک رکھے طف کے رہنے والے لوگ اپنے اموال کی زکوۃ ادا نہیں کرتے ہیں انہوں نے فرمایا : پھر کیا ہوا اس نے کہا : آپ یہ بات جانتے ہیں میں نے تو امیر کو اطلاع دی ہے ۔ انہوں نے کہا : تمہارا تعلق کہاں سے ہے آ اْس نے کہا : عبدالقیس قبیلے سے انہوں نے دریافت کیا : تمہارا نام کیا ہے اس نے بتایا : فلاں بن فلاں ہے "" تو بلال بن ابوبردہ نے اس کے علاقے کے کوتوال کو خط لکھا "" اور فرمایا : تم عبدالقیس قبیلے کی طرف کسی کو بھیج کر ان سے فلاں بن فلاں کے بارے میں دریافت کرو کہ ان کے درمیان اْس کا حسب کیسا ہے قاصد واپس آیا تو اس نے بتایا : میں نے یہ چیز پائی کہ اس شخص کے حسب پر نکتہ چینی کی جاتی ہے "" تو انہوں نے فرمایا : اللہ اکبر ! میرے والد نے میرے دادا حضرت ابوموسیٰ اشعری رضی اللہ عنہ کے حوالے سے مجھے یہ حدیث بیان کی ہے آ نبی اکرم ﷽ نے ارشاد فرمایا :"""" لوگوں کے خلاف + پوشیدہ امور , کی تلاش صرف وہ کرے گا "" جو زنا کے نتیجے میں پیدا ہوا ہو یا جس میں اس کا کچھ اثر ہو """"۔ "
"10556"," عمرو بن شرحبكل بن سعید بن سعد بن عبادہ نے "" اپنے والد کے حوالے سے اپنے دادا کا یہ بیان نقل کیا ہے :   نبی اکرم ﷽ نے ارشاد فرمایا ہے :   """" سعد غیور ہے میں اس سے زیادہ غیور ہوں ، اور اللہ تعالیٰ مجھ سے بھی زیادہ غیور ہے ایک صاحب نے عرض کی :   اللہ تعالیٰ کسی چیز پر غیور ہوتا ہے آ نبی اکرم ﷽ نے فرمایا : اس مجاہد کے حوالے سے جو اللہ کی راہ میں جہاد کر رہا ہو "" اور اس کی غیر موجودگی میں اس کی بیوی + کے ساتھ برائی کرنے کی کوشش کی جائے """"۔   یہ روایت امام احمد نے ایک طویل حدیث میں نقل کی ہے "" جو سورہ نور کی تفسیر کے بارے میں ہے ۔ اس کی سند میں ایک راوی ابو معشر نجیح ہے "" اور وہ ضعیف ہے ۔"
"10557","انس سے روایت ہے کہ نبی ﷺ نے فرمایا: ""تم جنگی عورتیوں سے بچو۔"" بزار نے روایت کیا ہے، اس میں سعید بن زربی ہیں جو ضعیف ہیں۔"
"10558"," حضرت ابوقتادہ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" جو شخص ایسی عورت کے بچھونے پر بیٹھتا ہے "" جس کا شوہر موجود نہ ہو "" تو قیامت کے دن "" اللہ تعالیٰ اْس شخص پر اڛدھے کو مسلط کر دے گا """"۔   یہ روایت امام طبرانی نے معجم کبیر اور معجم اوسط میں نقل کی ہے ۔ اس کی سند میں ایک راوی ابن لہیعہ ہے اس کی نقل کردہ حدیث حسن ہے "" اور اس میں ضعف پایا جاتا ہے ۔"
"10559"," حضرت عبداللہ بن عمرو رضی اللہ عنہ نے مرفوع حدیث کے طور پر یہ بات نقل کی ہے + نبی اکرم ﷽ نے ارشاد فرمایا ہے : ,   """" جو شخص ایسی عورت کے بچھونے پر بیٹھتا ہے "" جس کا شوہر موجود نہ ہو اس کی مثال اس شخص کی مانند ہے "" جسے قیامت کے دن سیاہ سانپوں میں سے کوئی سانپ نوچ لے گا """"۔   یہ روایت امام طبرانی نے نقل کی ہے "" اور اس کے رجال ثقہ ہیں ۔"
"10560","وَعَنِ ابْنِ الْحِمْيَرِيِّ قَالَ: قَالَ لِي عَمَّارٌ: يَا ابْنَ الْحِمْيَرِيِّ، أَلَا أُحَدِّثُكَ عَنْ حَبِيبِي - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ -؟ قُلْتُ: بَلَى. قَالَ: قَالَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: """" «يَا عَمَّارُ، إِنَّ لِلَّهِ مَلَكًا أَعْطَاهُ أَسْمَاءَ الْخَلَائِقِ كُلَّهَا، وَهُوَ قَائِمٌ عَلَى قَبْرِي، إِذَا مُتُّ إِلَى يَوْمِ الْقِيَامَةِ، فَلَيْسَ أَحَدٌ مِنْ أُمَّتِي يُصَلِّي عَلَيَّ صَلَاةً إِلَّا أَسْمَاهُ بِاسْمِهِ، وَاسْمِ أَبِيهِ، قَالَ: يَا مُحَمَّدُ، صَلَّى عَلَيْكَ فُلَانٌ، فَيُصَلِّي الرَّبُّ عَلَى ذَلِكَ الرَّجُلِ بِكُلِّ وَاحِدَةٍ عَشْرًا """"».\nرَوَاهُ الطَّبَرَانِيُّ، وَنُعَيْمُ بْنُ ضَمْضَمٍ ضَعِيفٌ، وَابْنُ الْحِمْيَرِيِّ اسْمُهُ عِمْرَانُ. قَالَ الْبُخَارِيُّ: لَا يُتَابَعُ عَلَى حَدِيثِهِ. وَقَالَ صَاحِبُ الْمِيزَانِ: لَا يُعْرَفُ، وَبَقِيَّةُ رِجَالِهِ رِجَالُ الصَّحِيحِ."
"10561"," محمد بن یزید بن رکانہ بیان کرتے ہیں : ان کی خالہ جو مسعود بن عجماء کی بہن تھی انہوں نے ان صاحب کو یہ حدیث بیان کی ہے کہ اس خاتون کے والد نے نبی اکرم ﷽ کی خدمت میں اس مخزومی عورت کے بارے میں گزارش کی جس نے ایک چادر کی چوری کی تھی یہ گزارش کی کہ ہم اس کے بدلے میں فدیہ کے طور پر چالیس اوقیہ دے دیتے ہیں نبی اکرم ﷽ نے ارشاد فرمایا :   اگر تم اس کی تطہیر ہو لینے دو تو یہ اس کے حق میں زیادہ بہتر ہے "" پھر نبی اکرم ﷽ کے حکم کے تحت اس عورت کا ہاتھ کاٹ دیا گیا اس کا تعلق بنو عبداشہل یا شاید بنواسعد سے تھا ۔ "
"10562"," سیدہ ام سلمہ رضی اللہ عنہا بیان کرتی ہیں : قریش ، مخزومی عورت کے معاملے میں پریشانی کا شکار ہو گئے جس نے چوری کی تھی لوگوں نے کہا : اس عورت کے بارے میں اللہ کے رسول کے ساتھ کون بات کرے گا لوگوں نے اس بارے میں نبی اکرم ﷽ کے ساتھ بات چیت کی تو نبی اکرم ﷽ نے ارشاد فرمایا : "
"10563"," عروہ بن زبیر نے اپنے والد کا یہ بیان نقل کیا ہے : حضرت زبیر رضی اللہ عنہ کی ملاقات ایک چور سے ہوئی ۔ انہوں نے اس چور کے بارے میں سفارش کی ان سے کہا گیا : ہم پہلے حاکم تک اسے پہنچا دیں انہوں نے فرمایا : جب یہ معاملہ حاکم تک پہنچ جائے گا "" تو اللہ تعالٰی سفارش کرنے والے اور جس کے سامنے سفارش کی گئی + یا جس کے بارے میں سفارش کی گئی , ان پر لعنت کرے """"۔ یا جس طرح نبی اکرم ﷽ نے ارشاد فرمایا ہے ۔   یہ روایت امام طبرانی نے معجم اوسط اور معجم صغیر میں نقل کی ہے ۔ اس کی سند میں ایک راوی ابوغزیہ محمد بن موسیٰ انصاری ہے ۔ جسے امام ابوحاتم اور دیگر حضرات نے ضعیف قرار دیا ہے "" اور امام حاکم نے اسے ثقہ کہا ہے "" اور ایک راوی عبدالرحمن بن ابوزناد ہے ""  اور وہ ضعیف ہے ۔"
"10564"," حضرت ابوہریرہ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" جس شخص کی سفارش اللہ تعالیٰ کی حدود میں سے کسی حد میں رکاوٹ بن رہی ہو "" تو وہ شخص اللہ تعالیٰ کی بادشاہی کے بارے میں اس کے خلاف کرتا ہے """"۔  یہ روایت اس سے پہلے احکام سے متعلق باب میں گزر چکی ہے ۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ اس کی سند میں ایک راوی رجاء بن صبح ہے "" جو """" صاحب سقط """" ہے "" یحیی بن معین اور دیگر حضرات نے اسے ضعیف قرار دیا ہے ابن حبان نے اسے ثقہ کہا ہے ۔"
"10565"," حضرت عبداللہ بن عمر رضی اللہ عنہما روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" جس شخص کی سفارش اللہ تعالیٰ کی حدود میں سے کسی حد کے بارے میں رکاوٹ بن رہی ہو "" تو وہ شخص اللہ تعالیٰ کے حکم کے بارے میں اس کی خلاف ورزی کرتا ہے """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی عبداللہ بن جعفر مدینی ہے "" اور وہ متروک ہے ۔"
"10566"," حضرت ابودرداء رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں : جس بھی شخص کی سفارش اللہ تعالیٰ کی حدود میں سے کسی حد میں رکاوٹ بن رہی ہو ایسا شخص مسلسل اللہ تعالیٰ کی ناراضگی میں رہتا ہے جب تک وہ اس + رکاوٹ بننے , سے الگ نہیں ہو جاتا """"۔ یہ مکمل روایت احکام سے متعلق باب میں ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے "" اور اس کی سند میں ایسا راوی ہے "" جس سے میں واقف نہیں ہوں ۔"
"10567"," ابومطر بیان کرتے ہیں : میں نے حضرت علی رضی اللہ عنہ کو دیکھا ان کے پاس ایک شخص کو لایا گیا ۔ لوگوں نے بتایا : اس نے ایک اونٹ چوری کیا ہے ۔ حضرت علی رضی اللہ عنہ نے فرمایا : تمہارے بارے میں میری یہ رائے نہیں ہے کہ تم نے چوری کی ہو گی آ اس نے کہا : جی ہاں + میں نے چوری کی ہے , حضرت علی رضی اللہ عنہ نے فرمایا : ہو سکتا ہے تمہیں کوئی شبہ لاحق ہو گیا ہو ۔ اس نے کہا : جی نہیں ! میں نے چوری کی ہے ۔ حضرت علی رضی اللہ عنہ نے فرمایا : اے قنبر ! تم اسے لے جاا اور اس کی انگلیاں باندھ دو اور آگ جلا دو اور قصائی کو بلا لو "" جو اس کو کاٹ دے پھر تم انتظار کرنا "" جب تک میں تمہارے پاس نہیں آ جاتا ۔ حضرت علی رضی اللہ عنہ آئے "" تو حضرت علی رضی اللہ عنہ نے "
"10568"," حضرت علی بن ابوطالب رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :"""" جو شخص انبیاء کرام کو برا کہے اسے قتل کر دیا جائے گا اور جو شخص میرے اصحاب کو برا کہے اسے کوڑے لگائے جائیں گے """"۔   یہ روایت امام طبرانی نے معجم صغیر اور معجم اوسط میں نقل کی ہے ۔ انہوں نے اسے اپنے استاد عبیداللہ بن محمد عمری کے حوالے سے نقل کیا ہے ، جس پر امام نسائی نے جھوٹا ہونے کا الزام عائد کیا ہے ۔"
"10569"," کعب بن علقمہ بیان کرتے ہیں : حضرت عرفہ بن حارث رضی اللہ عنہ کو صحابی ہونے کا شرف حاصل ہے ۔ انہوں نے حضرت عکرمہ بن ابوجہل رضی اللہ عنہ کے ساتھ مل کر یمن میں مرتدین کے ساتھ جنگ کی تھی ایک مرتبہ مصر سے تعلق رکھنے والا ایک عیسائی ان کے پاس سے گزرا "" جس کا نام مندقون تھا ۔ انہوں نے اسے اسلام کی دعوت دی اس عیسائی نے نبی اکرم ﷽ کا ذکر کرتے ہوئے نبی اکرم ﷽ کی شان میں گستاخی کی یہ معاملہ حضرت عمرو بن العاص رضی اللہ عنہ کے سامنے پیش کیا گیا تو حضرت عمرو رضی اللہ عنہ نے انہیں بلوایا حضرت عمرو رضی اللہ عنہ نے کہا : ہم ان لوگوں کو عہد دے چکے ہیں کہ تو حضرت عرفہ رضی اللہ عنہ نے کہا : اس بات سے اللہ کی پناہ ہے کہ یہ عہد اور میثاق اس چیز کے بارے میں ہو کہ وہ ہمیں اللہ اور اس کے رسول کے بارے میں اذیت پہنچائیں ہم نے انہیں عہد اس چیز کا دیا ہے کہ ہم انہیں ان کے حال پر چھوڑ دیں گے وہ اپنی عبادت گاہوں میں جو مناسب سمجھیں کریں اور انہیں کسی ایسی چیز کا پابند نہیں کریں گے ، جس کی ان میں طاقت نہ ہو "" اور ہم ان کی خاطر جنگ کریں گے "" اور ان کے اور ان کے مذہبی احکام کے بارے میں کوئی مداخلت نہیں کریں گے "" البتہ جب وہ لوگ ہمارے پاس آئیں گے "" تو ہم ان کے درمیان اس کے مطابق فیصلہ دیں گے "" جو اللہ تعالیٰ نے نازل کیا ہے "" تو حضرت عمرو بن العاص رضی اللہ عنہ نے فرمایا : آپ نے سچ کہا ہے ۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ اس کی سند میں ایک راوی عبداللہ بن صالح ہے "" جو لیث کا کاتب ہے اس کی توثیق کی گئی ہے "" اور اس میں ضعف پایا جاتا ہے ۔ اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"10570","وَعَنْ سَلَامَةَ الْكِنْدِيِّ قَالَ: كَانَ عَلَيٌّ - رَضِيَ اللَّهُ عَنْهُ - يُعَلِّمُ النَّاسَ الصَّلَاةَ عَلَى نَبِيِّ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ: اللَّهُمَّ دَاحِيَ الْمَدْحُوَّاتِ، وَبَارِئَ الْمَسْمُوكَاتِ، وَجَبَّارَ الْقُلُوبِ عَلَى فِطْرَتِهَا، شِقِيِّهَا وَسَعِيدِهَا، اجْعَلْ شَرَائِفَ صَلَوَاتِكَ، وَنَوَامِيَ بَرَكَاتِكَ، وَرَأْفَةَ تَحِيَّتِكَ عَلَى مُحَمَّدٍ عَبْدِكَ وَرَسُولِكَ، الْخَاتِمِ لِمَا سَبَقَ، وَالْفَاتِحِ لِمَا أُغْلِقَ، وَالْمُعِينِ عَلَى الْحَقِّ (بِالْحَقِّ)، وَالدَّامِغِ جَيْشَاتِ الْأَبَاطِيلِ، كَمَا حَمَلَ فَاضْطَلَعَ بِأَمْرِكَ لِطَاعَتِكَ، مُسْتَوْفِزًا فِي مَرْضَاتِكَ بِغَيْرِ نَكَلٍ عَنْ قَدَمٍ، وَلَا وَهَنٍ فِي عَزْمٍ، دَاعِيًا لِوَحْيِكَ، حَافِظًا لِعَهْدِكَ، مَاضِيًا عَلَى نَفَاذِ أَمْرِكَ، حَتَّى أَوْرَى قَبَسًا لِقَابِسٍ، بِهِ هُدِيَتِ الْقُلُوبُ بَعْدَ خَوَضَانِ الْفِتَنِ وَالْإِثْمِ، بِمُوَضِّحَاتِ الْأَعْلَامِ، وَمُنِيرَاتِ الْإِسْلَامِ، وَنَائِرَاتِ الْأَحْكَامِ، فَهُوَ أَمِينُكَ الْمَأْمُونُ، وَخَازِنُ عِلْمِكَ الْمَخْزُونِ، وَشَهِيدُكَ يَوْمَ الدِّينِ، وَبَعْثَتُكَ لَهُ نِعْمَةٌ، وَرَسُولُكَ بِالْحَقِّ رَحْمَةٌ. اللَّهُمَّ افْسَحْ لَهُ مَفْسَحًا فِي عَدْلِكَ، وَاجْزِهِ مُضَاعَفَةَ الْخَيْرِ مِنْ فَضْلِكَ، مُهَنَّئَاتٍ غَيْرَ مُكَدَّرَاتٍ، مِنْ فَوْزِ ثَوَابِكَ الْمَعْلُولِ، وَجَزِيلِ عَطَائِكَ الْمَحْلُولِ. اللَّهُمَّ عَلِّ عَلَى بِنَاءِ النَّاسِ بِنَاهُ، وَأَكْرِمْ مَثْوَاهُ لَدَيْكَ وَنُزُلَهُ، وَأَتْمِمْ لَهُ نُورَهُ، وَاجْزِهِ مِنِ ابْتِعَاثِكَ لَهُ، مَقْبُولَ الشَّهَادَةِ مَرْضِيَّ الْمَقَالَةِ، ذَا مَنْطِقٍ وَعَدْلٍ، وَكَلَامٍ فَصْلٍ، وَحُجَّةٍ، وَبُرْهَانٍ عَظِيمٍ.\nرَوَاهُ الطَّبَرَانِيُّ فِي الْأَوْسَطِ، وَسَلَامَةُ الْكِنْدِيُّ، رِوَايَتُهُ عَنْ عَلِيٍّ مُرْسَلَةٌ، وَبَقِيَّةُ رِجَالِهِ رِجَالُ الصَّحِيحِ."
"10571"," حضرت معاذ بن جبل رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :   """" اللہ تعالیٰ کے نزدیک مخلوق میں سب سے زیادہ ناپسندیدہ شخص وہ ہے "" جو ایمان لائے اور پھر کافر ہو جائے """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی صدقہ بن عبداللہ سمین ہے ۔ جسے ابوحاتم اور ایک جماعت نے ثقہ قرار دیا ہے "" اور دیگر حضرات نے اسے ضعیف کہا ہے ۔ اس روایت کے بقیہ رجال ثقہ ہیں ۔ "
"10572"," حضرت ابوہریرہ رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :"""" جو شخص + اسلام کو چھوڑ کر , اپنا دین تبدیل کر لے اسے قتل کر دو """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے "" اور اس کی سند حسن ہے ۔"
"10573","جس نے اپنا دین بدل لیا، اسے قتل کر دو۔ اور دوسری روایات میں: جس نے اپنا دین بدل لیا، اسے قتل کر دو، اللہ اس بندے کی توبہ قبول نہیں کرتا جو اسلام کے بعد کافر ہو گیا۔"
"10574","جس نے اپنا دین بدل لیا، اسے قتل کر دو۔"
"10575","وَعَنِ ابْنِ عَبَّاسٍ: «أَنَّ النَّبِيَّ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - ارْتَقَى الْمِنْبَرَ، فَأَمَّنَ ثَلَاثَ مَرَّاتٍ، ثُمَّ قَالَ: """" تَدْرُونَ لِمَ أَمَّنْتُ؟ """". قَالُوا: اللَّهُ وَرَسُولُهُ أَعْلَمُ، قَالَ: """" جَاءَنِي جِبْرِيلُ - عَلَيْهِ السَّلَامُ - فَقَالَ: إِنَّهُ مَنْ ذُكِرْتَ عِنْدَهُ فَلَمْ يُصَلِّ عَلَيْكَ دَخَلَ النَّارَ ; فَأَبْعَدَهُ اللَّهُ، وَأَسْحَقَهُ، قُلْتُ: آمِينَ. وَمَنْ أَدْرَكَ وَالِدَيْهِ أَوْ أَحَدَهُمَا فَلَمْ يَبَرَّهُمَا دَخَلَ النَّارَ ; فَأَبْعَدَهُ اللَّهُ، وَأَسْحَقَهُ، قُلْتُ: آمِينَ. وَمَنْ أَدْرَكَ رَمَضَانَ فَلَمْ يُغْفَرْ لَهُ دَخَلَ النَّارَ ; فَأَبْعَدَهُ اللَّهُ، وَأَسْحَقَهُ، فَقُلْتُ: آمِينَ» """".\nرَوَاهُ الطَّبَرَانِيُّ، وَفِيهِ إِسْحَاقُ بْنُ عَبْدِ اللَّهِ بْنِ كَيْسَانَ، وَفِيهِ ضَعْفٌ."
"10576"," حضرت ابوموسیٰ اشعری رضی اللہ عنہ اور حضرت معاذ بن جبل رضی اللہ عنہ کے بارے میں یہ بات منقول ہے کہ نبی اکرم ﷽ نے ان دونوں حضرات کو یمن بھیجا اور ان دونوں کو یہ حکم دیا کہ وہ لوگوں کو قرآن کی تعلیم دیں راوی بیان کرتے ہیں : ایک مرتبہ حضرت معاذ رضی اللہ عنہ حضرت ابوموسی رضی اللہ عنہ سے ملنے کے لئے آئے "" تو ان کے پاس ایک شخص کو لوہے کی زنجیر میں بندھا ہوا پایا ۔ حضرت معاذ رضی اللہ عنہ نے فرمایا : اے میرے بھائی ! کیا ہمیں اس لئے بھیجا گیا ہے کہ ہم لوگوں کو عذاب دیں ہمیں تو اس لئے بھیجا گیا ہے "" تاکہ ہم لوگوں کو دین کی تعلیم دیں ، اور انہیں اس چیز کے بارے میں حکم دیں جو چیز انہیں فائدہ دیتی ہے "" تو حضرت ابوموسیٰ اشعری رضی اللہ عنہ نے بتایا : یہ شخص پہلے مسلمان ہوا تھا "" اور پھر کافر ہو گیا ہے تو حضرت معاذ رضی اللہ عنہ نے کہا : اس ذات کی قسم ! جس نے حضرت محمد + ﷽ , کو حق کے ہمراہ مبعوث کیا ہے ۔ میں اس وقت تک نہیں ہلوں گا "" جب تک میں اسے آگ میں نہیں جلا دیتا ۔   حضرت ابوموسیٰ اشعری رضی اللہ عنہ نے کہا : ہمارا اس کے پاس بقیہ ہے آ تو حضرت معاذ رضی اللہ عنہ نے کہا : اللہ کی قسم میں نہیں جااں گا راوی بیان کرتے ہیں : تو پھر لکڑیاں لائی گئیں "" اور ان میں آگ لگائی گئی ۔ انہوں نے اس کا کندھا پکڑا اور اسے آگ میں ڈال دیا ۔ "
"10577"," قیس بن ابوحازم بیان کرتے ہیں : ایک شخص حضرت عبداللہ بن مسعود رضی اللہ عنہ کے پاس آیا اور بولا : میں بنو حنیفہ کی مساجد میں سے ایک مسجد کے پاس سے گزرا "" تو میں نے انہیں ایسی چیز کی تلاوت کرتے ہوئے سنا "" جو اللہ تعالیٰ نے نازل نہیں کی"
"10578"," قاسم بیان کرتے ہیں : حضرت عبداللہ بن مسعود رضی اللہ عنہ کے پاس ایک شخص آیا "" اور انہیں یہ بتایا : اے ابوعبدالرحمن ! یہاں کچھ لوگ ہیں جو مسیلمہ کی قرئت کی تلاوت کرتے ہیں ۔ حضرت عبداللہ رضی اللہ عنہ نے اس شخص کو واپس بھیج دیا "" جتنا عرصہ اللہ کو منظور تھا "" اتنا عرصہ گزرنے کے بعد حضرت عبداللہ بن مسعود رضی اللہ عنہ اس شخص کے پاس آئے "" تو اس نے کہا : اے ابوعبدالرحمن ! اس ذات کی قسم ! جس کے نام پر میں حلف اٹھا رہا ہوں ۔ میں ان لوگوں کو ابھی ایک گھر میں چھوڑ کے آیا ہوں "" اور وہ مصحف ان لوگوں کے پاس موجود ہے "" تو حضرت عبداللہ رضی اللہ عنہ نے قرظہ بن کعب کو حکم دیا "" وہ لوگوں کو ساتھ لے کر ان کے ساتھ روانہ ہوا ۔ حضرت عبداللہ رضی اللہ عنہ نے فرمایا : تم ان کے پاس پہنچو ! جب وہ ان کے پاس آئے "" تو انہوں نے دریافت کیا : یہ کیا ہے آ کیا اسلام کے پھیل جانے کے بعد ایسا ہو رہا ہے ۔ انہوں نے کہا : اے ابوعبدالرحمن ! ہم اللہ تعالیٰ سے مغفرت طلب کرتے ہیں "" اور اس کی بارگاہ میں توبہ کرتے ہیں "" اور ہم اس بات کی گواہی دیتے ہیں کہ مسیلمہ کذاب ہے "" اور اللہ اور اس کے رسول کی طرف جھوٹی بات منسوب کرنے والا ہے ۔ راوی کہتے ہیں : حضرت عبداللہ رضی اللہ عنہ نے ان لوگوں سے توبہ کروائی اور انہیں شام بھجوا دیا ۔ وہ تقریباَ اسی کے قریب افراد تھے ۔ ابن نواحہ نے توبہ کرنے سے انکار کر دیا "" تو حضرت عبداللہ رضی اللہ عنہ نے قرظہ بن کعب کو حکم دیا وہ اسے لے کر بازار آئے ""  اور انہوں نے اس کی گردن اڑا دی پھر حضرت عبداللہ بن مسعود رضی اللہ عنہ نے حکم دیا کہ اس کا سر پکڑ کر اس کی ماں کی گود میں ڈال دیا جائے ۔ "
"10579"," سوید بن غفلہ بیان کرتے ہیں حضرت علی رضی اللہ عنہ کو یہ اطلاع ملی کہ بصرہ میں کچھ لوگ اسلام کو چھوڑ کر مرتد ہو گئے ہیں حضرت علی رضی اللہ عنہ نے ان لوگوں کی طرف پیغام بھیجا وہ دو ہفتوں تک انہیں اناج بھیجتے رہے پھر انہوں نے ان لوگوں کی طرف اسلام کی دعوت دی انہوں نے وہ نہیں مانی تو حضرت علی رضی اللہ عنہ ان کے لئے گڑھا کھدایا اور پھر ان کے سرہانے کھڑے ہوئے اور فرمایا میں تمہیں چربی اور گوشت سے بھر دوں گا پھر ان لوگوں کو لایا گیا اور ان کی گردنیں اڑائیں اور انہں گڑھے میں ڈال دیا گیا پھر ان پر لکڑیاں ڈال دی گئیں اور انہیں جلا دیا گیا پھر حضرت علی رضی اللہ عنہ نے فرمایا اللہ اور اس کے رسول نے سچ فرمایا ہے ۔  سوید بن غفلہ بیان کرتے ہیں جب وہ واپس مڑے تو میں ان کے پیچھے گیا میں نے کہا میں نے آپ کو یہ کہتے ہوئے سنا ہے   اللہ اور اس کے رسول نے سچ فرمایا ہے تو انہوں نے فرمایا : تمہارا ستیاناس ہو میرے اردگرد جاہل لوگ موجود تھے جب تم نے مجھے یہ کہتے ہوئے سنا کہ اللہ کے رسول نے ارشاد فرمایا ہے تو میں آسمان سے گر جااں یہ میرے نزدیک اس سے زیادہ پسندیدہ ہو گا کہ میں اللہ اور اس کے رسول کی طرف کوئی ایسی بات منصوب کروں جو آپ نے ارشاد نہ فرمائی ہو ۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے اس کی سند میں ایک راوی حسن بن زیاد لالای ہے اور وہ متروک ہے ۔"
"10580"," حضرت انس بن مالک رضی اللہ عنہ بیان کرتے ہیں نبہان نامی شخص تین مرتبہ مرتد ہوا نبی اکرم ﷽ نے ارشاد فرمایا اے اللہ تو مجھے نبہان پر اس طرح قابو دے کہ اس کا گردن میں سیاہ رسی ہو نبی اکرم ﷽ نے توجہ کی تو سامنے سے نبہان آ رہا تھا اسے پکڑا گیا تھا اور اس کے گلے میں سیاہ رسی ڈالی گئی تھی لوگ اسے لے کے نبی اکرم ﷽ کے پاس آئے نبی اکرم ﷽ نے اپنے دست مبارک میں تلوار پکڑی اور بائیں ہاتھ رسی پکڑی تاکہ اسے قتل کر دیں انصار سے تعلق رکھنے والے ایک شخص نے عرض کی :   یا رسول اللہ ! اگر آپ اسے خود سے دور کر دیں تو یہ مناسب ہو گا نبی اکرم ﷽ نے وہ تلوار اس شخص کو پکڑا دی اور فرمایا تم جاا اور اس کی گردن اڑا دو وہ اسے لے کے جانے لگا تو نبہان ہنسنے لگا اس نے کہا کیا تم ایک ایسے شخص کو قتل کرنا چاہتے ہو جو یہ کہتا ہے کہ اللہ تعالی کے علاوہ اور کوئی معبود نہیں ہے اور حضرت محمد اللہ کے رسول ہیں تو اسے چھوڑ دیا گیا ۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے اور اس کے رجال ثقہ ہیں البتہ امام طبرانی کے استاد محمد بن مرزبان کا معاملہ مختلف ہے میزان الاعتدال یا اس کے علاوہ کسی اور کتاب میں ان کا ذکر نہیں دیکھا ہے ۔"
"10581"," حضرت جابر رضی اللہ عنہ بیان کرتے ہیں نبی اکرم ﷽ نے ایک ایسے شخص سے چار مرتبہ توبہ کروائی تھی جو اسلام کو چھوڑ کر مرتد ہو گیا تھا ۔ یہ روایت امام ابویعلیٰ نے نقل کی ہے اس کی سند میں ایک راوی معلی بن ہلال ہے جس کے جھوٹ کے حوالے سے ضعیف ہونے پر محدثین کا اتفاق ہے ۔"
"10582"," حضرت عبداللہ بن عباس رضی اللہ عنہما نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں  """" جو شخص اپنے دین یعنی اسلام کو چھوڑ دے اس کی گردن اڑا دو اور آپ نے یہ بھی ارشاد فرمایا ہے جو شخص اس بات کی گواہی دے کہ اللہ تعالیٰ کے علاوہ اور کوئی معبود نہیں ہے اور حضرت محمد اللہ کے رسول ہیں تو پھر اسے کچھ نہیں کہا جا سکتا البتہ اگر وہ کسی جرم کا ارتکاب کرتا ہے تو اس کو اس کی سزا دی جائے گی """"۔   یہ روایت امام طبرنی نے نقل کی ہے اس کی سند میں ایک راوی حکم بن ابان ہے اور وہ ضعیف ہے ۔"
"10583"," حضرت معاذ بن جبل رضی اللہ عنہ بیان کرتے ہیں نبی اکرم ﷽ جب انہیں یمن بھیجنے لگے تو آپ نے ان سے فرمایا :"""" جو شخص اسلام کو چھوڑ کر مرتد ہو جائے تم اسے دعوت دو اگر وہ توبہ قبول کر لے تو اس سے توبہ کو قبول کر لو اور اگر وہ توبہ نہیں کرتا تو اس کی گردن اڑا دو اور جو عورت اسلام کو چھوڑ کر مرتد ہو جائے تم اسے دعوت دو اگر وہ توبہ کر لے تو اس کی توبہ قبول کر لو اور اگر وہ نہیں مانتی تو اس سے توبہ کرواتے رہو """"۔   یہ روایت امام طبرانی نے نقل کی ہے اس کی سند میں ایک راوی ایسا ہے جس کا نام بیان نہیں کیا گیا ہے مکحول نے یہ کہا یہ ابوطلحہ یعمری کے بیٹے کے حوالے سے منقول ہے اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"10584"," حضرت عبداللہ بن عمر رضی اللہ عنہما بیان کرتے ہیں ہم یہ بات کہا کرتے تھے اس شخص کو کیا ملے گا جو توبہ کی آزمائش میں مبتلا ہوتا ہے جبکہ وہ اسلام قبول کرنے کے بعد اور اس کی معرفت کے بعد اپنے دین کو ترک کر چکا ہو تو ایسے لوگوں کے بارے میں اللہ تعالیٰ نے یہ آیت نازل کی :   """" اے میرے وہ بندو جنہوں نے اپنے اوپر ظلم کیا تم لوگ اللہ کی رحمت سے مایوس نہ ہو """" اس کے بعد راوی نے پوری حدیث ذکر کی ہے ۔  اس سے پہلے یہ حدیث ہجرت سے متعلق باب میں گزر چکی ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے اس کی سند میں ایک راوی محمد بن اسحاق ہے اور وہ مدلس ہے ۔"
"10585"," حضرت ابوہریرہ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :"""" احصان دو قسم کے ہوتے ہیں ایک احصان پاکدامنی کا ہوتا ہے اور ایک احصان نکاح کا ہوتا """"۔   یہ روایت امام بزار نے اور امام طبرانی نے معجم اوسط میں نقل کی ہے اس کی سند میں ایک راوی مبشر بن عبید ہے اور وہ متروک ہے ۔"
"10586"," حضرت عبداللہ بن عباس رضی اللہ عنہما روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" عادل حکمران کی طرف سے ایک دن ساٹھ سال کی عبادت سے زیادہ بہتر ہے اور زمین میں ایک حد کا قائم ہو جانا زمین کے حق میں چالیس دن تک بارش ہونے سے زیادہ پاکیزگی کا باعث ہے """"۔ یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے وہ بیان کرتے ہیں یہ حضرت عبداللہ بن عباس رضی اللہ عنہما کے حوالے سے صرف اسی سند کے ساتھ منقول ہے اس کی سند میں ایک راوی زریق بن سحت ہے اور میں اس سے واقف نہیں ہوں ۔"
"10587"," حضرت عبداللہ بن عباس رضی اللہ عنہما اللہ تعالیٰ کے اس فرمان کے بارے میں بیان کرتے ہیں + ارشاد باری تعالیٰ ہے : ,   """" تمہاری عورتوں میں سے جو برائی کا ارتکاب کرتی ہیں """" حضرت عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں پہلے ان عورتوں کو گھروں میں بند کر دیا جاتا تھا اگر کوئی مر جاتی تھی تو مر جاتی تھی زندہ رہتی تھی تو زندہ رہتی تھی یہاں تک کہ یہ آیت نازل ہوئی جو سورت نور میں ہے   """" زنا کرنے والی عورت اور زنا کرنے والا مرد ان میں سے ہر ایک کو سو کوڑے لگاا """"   پھر حدود کے حکم سے متعلق حکم نازل ہو گیا تو جو شخص کوئی عمل کرتا تھا اسے کوڑے لگائے جاتے تھے اور چھوڑ دیا جاتا تھا ۔ یہ روایت امام طبرانی نے اپنے استاد محمد بن عبداللہ بن سعید بن ابومریم کے حوالے سے نقل کی ہے اور وہ ضعیف ہے ۔  حضرت عبداللہ بن عباس رضی اللہ عنہما کی نقل کردہ حدیث سورت نور میں آگے آئے گی ۔"
"10588"," حضرت عبادہ بن صامت رضی اللہ عنہ بیان کرتے ہیں  """" نبی اکرم ﷽ پر یہ آیت نازل ہوئی  """" تمہاری عورتوں میں سے جو برائی کا ارتکاب کریں """" یہ آیت کے آخر تک ہے  نبی اکرم ﷽ نے ان خواتین کے ساتھ ایسا ہی کیا ایک مرتبہ نبی اکرم ﷽ تشریف فرما تھے ہم آپ کے ارد گرد تھے جب آپ پر وحی نازل نازل ہوتی تھی تو آپ ہماری طرف سے توجہ ہٹا لیتے تھے اور ہم بھی آپ کو مخاطب نہیں کرتے تھے آپ کے چہرہ مبارک کی حالت تبدیل ہو جاتی تھی اور آپ کو اس سے دقت کا سامنا کرنا پڑتا تھا جب وحی کی کیفیت ختم ہو گئی تو آپ نے ارشاد فرمایا مجھ سے حکم حاصل کر لو ہم نے عرض کی ٹھیک ہے یا رسول اللہ ! نبی اکرم ﷽ نے فرمایا اللہ تعالیٰ نے ایسی خواتین کے لئے حکم مقرر کر دیا ہے اگر کنوارہ لڑکا کنواری لڑکی کے ساتھ زنا کرے تو اسے ایک سو کوڑے لگائیں جائیں گے اور ایک سال کی جلاوطنی ہو گی اور اگر شادی شدہ شخص شادی شدہ عورت کے ساتھ زنا کرے تو انہیں ایک سو کوڑے لگائے جائیں گے  اور پھر سنگسار کیا جائے گا """"۔  حسن نامی راوی کہتے ہیں مجھے نہیں معلوم کہ کیا یہ روایت کا حصہ ہے یا نہیں ہے آپ نے فرمایا :   """" اگر لوگ اس بات کی گواہی دیتے ہیں کہ وہ دونوں ایک لحاف میں پائے گئے ہیں اور ان کی صحبت کے بارے میں گواہی نہیں دیتے تو پھر انہیں ایک سو کوڑے لگائے جائیں گے اور ان کے سر مونڈوا دیے جائیں گے """"۔ "
"10589"," قبیصہ بن حریث نے حضرت سلمہ بن محبق رضی اللہ عنہ کا یہ بیان نقل کیا ہے نبی اکرم ﷽ نے ارشاد فرمایا ہے   """" مجھ سے حکم حاصل کر لو مجھ سے حکم حاصل کر لو اللہ تعالیٰ نے ان خواتین کے لئے حکم بیان کر دیا ہے کنوارہ لڑکا کنواری لڑکی کے ساتھ زنا کرے گا تو ایک سو کوڑوں کی سزا ہو گی اور ایک سال کی جلاوطنی ہو گی اور اگر شادی شدہ شخص شادی شدہ عورت کے ساتھ زنا کرے گا تو ایک سو کوڑوں کی سزا ہو گی اور سنگسار کرنا ہو گا """"۔   یہ روایت امام احمد نے نقل کی ہے اس کی سند میں ایک راوی فضل بن دلہم ہے اور وہ ثقہ ہے لیکن اس نے اس حدیث میں غلطی کی ہے جیسا کہ یہ بات ذکر کی گئی ہے ۔"
"10590","وَعَنِ ابْنِ عَبَّاسٍ قَالَ: «رَأَيْتُ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - يَدْعُو بِعَرَفَةَ وَيَدَاهُ إِلَى صَدْرِهِ، كَاسْتِطْعَامِ الْمِسْكِينِ».\nرَوَاهُ الطَّبَرَانِيُّ فِي الْأَوْسَطِ، وَفِيهِ الْحُسَيْنُ بْنُ عَبْدِ اللَّهِ بْنِ عُبَيْدِ اللَّهِ، وَهُوَ ضَعِيفٌ."
"10591"," حضرت عبادہ بن صامت رضی اللہ عنہ بیان کرتے ہیں جب نبی اکرم ﷽ پر رجم سے متعلق حکم پر آیت نازل ہوئی تو آپ اپنے اصحاب کے درمیان موجود تھے جب آپ پر وحی نازل ہوتی تھی اور آپ پر نیند کی سی کیفیت طاری ہو جاتی تھی "" جب وحی ختم ہو جاتی تھی تو آپ سیدھے ہو کر بیٹھ جاتے تھے آپ نے ارشاد فرمایا اللہ تعالیٰ نے ان عورتوں کے لئے حکم بیان کر دیا ہے اگر شادی شدي مرد شادی شدہ عورت کے ساتھ زنا کرے گا تو اسے ایک سو کوڑے لگائے جائیں گے اور سنگسار کیا جائے اور اگر کنوارہ شخص کنواری لڑکی کے ساتھ زنا کرے گا تو انہیں ایک سو کوڑے لگائیں جائیں گے اور ایک سال کے لئے جلا وطن کر دیا جائے گا کچھ لوگوں نے حضرت سعد بن عبادہ رضی اللہ عنہ سے کہا : اے ابوثابت حدود کے بارے میں حکم نازل ہو گیا ہے اس بارے میں آپ کی کیا رائے ہے کہ اگر آپ اپنی بیوی کے ساتھ کسی شخص کو پاتے ہیں تو آپ کیا کریں گے انہوں نے فرمایا : میں اسے تلوار ماروں گا یہاں تک کہ وہ دونوں ٹھنڈے ہو جائیں کیا میں جا کر چار آدمی جمع کروں گا اتنی دیر میں تو وہ شخص اپنی حاجت پوری کر کے چلا جائے گا اور پھر میں آاں گا اور یہ کہوں گا کہ میں نے فلاں شخص کو اس اس طرح کرتے ہوئے دیکھا تو لوگ مجھے کوڑے لگائیں گے اور میری گواہی کبھی قبول نہیں کریں گے تو لوگ ہنس پڑے پھر لوگ نبی اکرم ﷽ کے پاس اکٹھے ہوئے انہوں نے عرض کی : یا رسول اللہ ! کیا آپ نے ابوثابت کو نہیں دیکھا ہم نے ان سے یہ یہ بات کہی اور انہوں نے جواب میں یہ یہ کچھ کہا تو نبی اکرم ﷽ نے ارشاد فرمایا گواہ ہونے کے لئے تلوار کافی ہے پھر آپ نے ارشاد فرمایا اگر مجھے اس بات کا اندیشہ نہ ہوتا کہ مدحوش شخص یا تیز مزاج والے لوگ یکے بعد دیگر + یہی حرکت کرنے لگیں گے , لوگوں نے عرض کی : یا رسول اللہ ! ان میں سب سے زیادہ غصہ پایا جاتا ہے نبی اکرم ﷽ نے ارشاد فرمایا وہ شدید غصے والا ہوں اور میں اس سے زیادہ غیور ہوں اور اللہ تعالیٰ مجھ سے بھی زیادہ غیور ہے اس لئے اس نے حدود کا حکم مقرر کیا ہے """"۔ "
"10592"," سیدہ عجماء رضی اللہ عنہا بیان کرتی ہیں میں نے نبی اکرم ﷽ کو یہ ارشاد فرماتے ہوئے سنا ہے "
"10593"," حضرت عبداللہ بن مسعود رضی اللہ عنہ ایسے کنوارے شخص کے بارے میں فرماتے ہیں جو کسی کنواری لڑکی کے ساتھ زنا کرتا ہے کہ ان دونوں کو ایک سو کوڑے لگائے جائیں گے اور ان دونوں کو ایک سال کے لئے جلا وطن کر دیا جائے گا ۔   یہ روایت امام طبرانی نے نقل کی ہے اور اس کی سند منقطع ہے اور اس میں ضعف پایا جاتا ہے ۔"
"10594"," حضرت ابوہریرہ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" مجھے نہیں معلوم کہ کیا حدود کفارہ بنتی ہیں یا نہیں بنتی ہیں """"۔ یہ روایت امام بزار نے دو اسناد کے ساتھ نقل کی ہے ان دو میں سے ایک کے رجال صحیح کے رجال ہیں صرف حمد بن منصور رمادی معاملہ مختلف ہے اور وہ ثقہ ہے ۔"
"10595","وَعَنْ سَلْمَانَ قَالَ: قَالَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: """" «مَا رَفَعَ قَوْمٌ أَكُفَّهُمْ إِلَى اللَّهِ - عَزَّ وَجَلَّ - يَسْأَلُونَهُ شَيْئًا، إِلَّا كَانَ حَقًّا عَلَى اللَّهِ أَنْ يَضَعَ فِي أَيْدِيهِمُ الَّذِي سَأَلُوا» """". قُلْتُ: لَهُ حَدِيثٌ فِي السُّنَنِ غَيْرُ هَذَا.\nرَوَاهُ الطَّبَرَانِيُّ، وَرِجَالُهُ رِجَالُ الصَّحِيحِ."
"10596"," ایک روایت میں یہ الفاظ ہیں   """" جو شخص کسی گناہ کا ارتکاب کرے اور اس گناہ کی حد اس پر جاری ہو جائے تو وہ حد اس کا کفارہ بن جائے گا """"۔   یہ روایت امام طبرانی نے نقل کی ہے امام احمد نے اس کی مانند روایت نقل کی ہے اس کی سند میں ایک راوی ایسا ہے جس کا نام بیان نہیں کیا گیا ہے اور وہ ابن خزیمہ ہے اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"10597"," انہوں نے اسے موقوف روایت کے طور پر بھی نقل کیا ہے ۔ "
"10598"," حضرت خزیمہ بن معمر انصاری رضی اللہ عنہ بیان کرتے ہیں نبی اکرم ﷽ کے زمانہ اقدس میں ایک عورت کو سنگسار کر دیا گیا لوگوں نے کہا اس عورت کا عمل ضائع ہو گیا ہے نبی اکرم ﷽ کو جب اس بات کی اطلاع ملی تو آپ نے ارشاد فرمایا : "
"10599"," حضرت عبداللہ بن عمر رضی اللہ عنہما نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :"""" جب بھی کسی بندے کو کسی گناہ پر سزا دے دی جائے تو اللہ تعالٰی اس چیز کو اس کے اس گناہ کے ارتکاب کا کفارہ بنا دیتا ہے """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے اس کی سند میں ایک راوی یسین زیاد ہے اور وہ متروک ہے ۔"
"10600","عَنْ أَبِي مُوسَى: «أَنَّ رَجُلًا سَأَلَ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - شَيْئًا، فَقَالَ: """" أَعَجَزْتَ أَنْ تَكُونَ مِثْلَ عَجُوزِ بَنِي إِسْرَائِيلَ؟! """". فَقَالَ أَصْحَابُهُ: وَمَا عَجُوزُ بَنِي إِسْرَائِيلَ يَا رَسُولَ اللَّهِ؟! فَقَالَ: """" إِنَّ مُوسَى حِينَ أُمِرَ أَنْ يَسِيرَ بِبَنِي إِسْرَائِيلَ ضَلَّ الطَّرِيقَ، فَسَأَلَ بَنِي إِسْرَائِيلَ: مَا هَذَا؟ فَقَالَ عُلَمَاءُ بَنِي إِسْرَائِيلَ: إِنَّ يُوسُفَ حِينَ حَضَرَهُ الْمَوْتُ أَخَذَ عَلَيْنَا مَوْثِقًا مِنَ اللَّهِ أَنْ لَا نَخْرُجَ مِنْ مِصْرَ حَتَّى نَنْقُلَ عِظَامَهُ، فَقَالَ لَهُمْ مُوسَى: وَأَيُّكُمْ يَدْرِي أَيْنَ قَبْرُ يُوسُفَ؟ فَقَالَ لَهُ بَنُو إِسْرَائِيلَ: مَا يَدْرِي أَيْنَ قَبْرُ يُوسُفَ إِلَّا عَجُوزُ بَنِي إِسْرَائِيلَ، فَأَرْسَلَ إِلَيْهَا فَقَالَ: دُلِّينِي عَلَى قَبْرِ يُوسُفَ، فَقَالَتْ: لَا وَاللَّهِ، حَتَّى تُعْطِيَنِي حُكْمِي، قَالَ: وَمَا حُكْمُكِ؟ قَالَتْ: أَكُونُ مَعَكَ فِي الْجَنَّةِ، فَكَأَنَّهُ ثَقُلَ ذَلِكَ عَلَيْهِ، فَقِيلَ لَهُ: أَعْطِهَا حُكْمَهَا، فَانْطَلَقَتْ بِهِمْ إِلَى بُحَيْرَةِ مُسْتَنْقَعِ مَاءٍ، فَقَالَتِ: انْضُبُوا هَذَا الْمَكَانَ، فَلَمَّا أَنْضَبُوهُ قَالَتِ: احْفِرُوا فِي هَذَا الْمَكَانِ، فَلَمَّا احْتَفَرُوا أَخْرَجُوا عِظَامَ يُوسُفَ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا اسْتَقَلُّوهَا مِنَ الْأَرْضِ إِذِ الطَّرِيقُ مِثْلُ النَّهَارِ» """".\nرَوَاهُ الطَّبَرَانِيُّ، وَأَبُو يَعْلَى وَلَفْظُهُ: عَنْ أَبِي مُوسَى\nقَالَ: «أَتَى النَّبِيَّ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - أَعْرَابِيٌّ فَأَكْرَمَهُ، فَقَالَ: """" ائْتِنَا """"، فَأَتَاهُ، فَقَالَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: """" سَلْ حَاجَتَكَ """"، فَقَالَ: نَاقَةٌ نَرْكَبُهَا، وَأَعْنُزٌ يَحْلِبُهَا أَهْلِي، فَقَالَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: """" أَعَجَزْتُمْ أَنْ تَكُونُوا مِثْلَ عَجُوزِ بَنِي إِسْرَائِيلَ؟! """"، فَقَالَ: """" إِنَّ مُوسَى لَمَّا سَارَ بِبَنِي إِسْرَائِيلَ مِنْ مِصْرَ ضَلُّوا الطَّرِيقَ، فَقَالَ: مَا هَذَا؟ فَقَالَ عُلَمَاؤُهُمْ: إِنَّ يُوسُفَ لَمَّا حَضَرَهُ الْمَوْتُ أَخَذَ عَلَيْنَا مَوْثِقًا مِنَ اللَّهِ: أَنْ لَا نَخْرُجَ مِنْ مِصْرَ حَتَّى نَنْقُلَ عِظَامَهُ مَعَنَا، قَالَ: فَمَنْ يَعْلَمُ مَوْضِعَ قَبْرِهِ؟ قَالَ: عَجُوزٌ مِنْ بَنِي إِسْرَائِيلَ، فَبَعَثَ إِلَيْهَا فَأَتَتْهُ فَقَالَ: دُلِّينِي عَلَى قَبْرِ يُوسُفَ، قَالَتْ: حَتَّى تُعْطِيَنِي حُكْمِي، قَالَ: وَمَا حُكْمُكِ؟ قَالَتْ: أَكُونُ مَعَكَ فِي الْجَنَّةِ، فَكَرِهَ أَنْ يُعْطِيَهَا ذَلِكَ، فَأَوْحَى اللَّهُ إِلَيْهِ: أَنْ أَعْطِهَا حُكْمَهَا. فَانْطَلَقَتْ بِهِمْ إِلَى بُحَيْرَةٍ مَوْضِعَ مُسْتَنْقَعِ مَاءٍ فَقَالَتِ: انْضُبُوا هَذَا الْمَكَانَ، فَأَنْضَبُوهُ، قَالَتِ: احْتَفِرُوا وَاسْتَخْرِجُوا عِظَامَ يُوسُفَ، فَلَمَّا أَقَلُّوهَا إِلَى الْأَرْضِ إِذِ الطَّرِيقُ مِثْلُ ضَوْءِ النَّهَارِ».\nوَرِجَالُ أَبِي يَعْلَى رِجَالُ الصَّحِيحِ، وَهَذَا الَّذِي حَمَلَنِي عَلَى سِيَاقِهَا."
"10601"," حضرت ابوہریرہ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :"""" آدمی کا باندھ کر قتل ہو جانا اس کے پہلے کے گناہوں کا کفارہ بن جاتا ہے """"۔   یہ روایت امام بزار نے نقل کی ہے اس کی سند میں ایک راوی صالح بن موسیٰ بن طلحہ ہے اور وہ متروک ہے ۔"
"10602"," سیدہ عائشہ صدیقہ رضی اللہ عنہا بیان کرتی ہیں نبی اکرم ﷽ نے ارشاد فرمایا :   """" باندھ کر قتل ہو جانا جس بھی گناہ کے پاس سے گزرتا ہے اسے مٹا دیتا ہے """"۔   یہ روایت امام بزار نے نقل کی ہے وہ کہتے ہیں ہمارے علم کے مطابق نبی اکرم ﷽ سے یہ روایت صرف اسی سند کے ساتھ منقول ہے اور اس کے رجال ثقہ ہیں ۔"
"10603"," حضرت عبداللہ بن مسعود رضی اللہ عنہ کے بارے میں یہ بات منقول ہے کہ وہ فرماتے ہیں جو شخص حدود کا مرتکب ہو اور پھر قتل عمد کے طور پر قتل ہو جائے تو حضرت عبداللہ بن مسعود رضی اللہ عنہ فرماتے ہیں جب قتل آ جاتا ہے تو ہر چیز + یعنی گناہ , کو مٹا دیا جاتا ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے اس کی سند میں ایک راوی ایسا ہے جس کا نام بیان نہیں کیا گیا ہے اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"10604"," حسن بصری بیان کرتے ہیں زیاد شیعہ نے علی کو تلاش کر کے انہیں قتل کر دیتا تھا اور حضرت امام حسن بن علی رضی اللہ عنہما کو اس بات کی اطلاع ملی تو انہوں نے فرمایا اے اللہ ! اسے طبعی موت دینا "" کیونکہ قتل "" کفارہ ہوتا ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے اور اس کے رجال صحیح کے رجال ہیں ۔"
"10605"," حضرت ابوبکر صدیق رضی اللہ عنہ بیان کرتے ہیں میں نبی اکرم ﷽ کے پاس بیٹھا ہوا تھا حضرت مالک بن ماعز رضی اللہ عنہ آیا اس نے آپ کے سامنے ایک مرتبہ اعتراف کیا تو آپ نے اسے واپس کر دیا وہ پھر آیا اس نے آپ کے سامنے دوسری مرتبہ اعتراف کیا تو آپ نے اسے واپس کر دیا وہ پھر آیا اس نے تیسری مرتبہ اعتراف کیا تو آپ نے اسے واپس کر دیا میں نے اس سے کہا اگر تم نے چوتھی مرتبہ بھی اعتراف کیا تو نبی اکرم ﷽ تمہیں سنگسار کروا دیں گے حضرت ابوبکر صدیق رضی اللہ عنہ کہتے ہیں   اس نے چوتھی مرتبہ بھی اعتراف کیا تو نبی اکرم ﷽ نے اسے قید کروا دیا پھر آپ نے اس کے بارے میں تحقیق کی تو لوگوں نے بتایا کہ ہمیں تو صرف بھلائی کا علم ہے تو نبی اکرم ﷽ نے اسے سنگسار کرنے کا حکم دے دیا ۔   یہ روایت امام احمد امام ابویعلیٰ اور امام بزار نے نقل کی ہے ان کی روایت کے یہ الفاظ ہیں نبی اکرم ﷽ نے حضرت ماعز رضی اللہ عنہ کو چار مرتبہ واپس کیا تھا اور پھر انہیں سنگسار کرنے کا حکم دیا تھا ۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے تاہم انہوں نے یہ الفاظ نقل کیے ہیں تین مرتبہ واپس کیا تھا ۔   ان تمام روایات کی سند میں ایک راوی جابر جعفی ہے اور وہ ضعیف ہے ۔"
"10606"," حضرت ابوذر غفاری رضی اللہ عنہ بیان کرتے ہیں ہم نبی اکرم ﷽ کے ساتھ سفر کر رہے تھے ایک شخص آپ کے پاس آیا اور بولا اس بدنصیب نے زنا کا ارتکاب کیا ہے نبی اکرم ﷽ نے اس سے منہ پھیر لیا پھر اس نے تیسری مرتبہ بھی ایسا کیا چوتھی مرتبہ بھی ایسا کیا تو نبی اکرم ﷽ سواری سے نیچے اترے ایک مرتبہ راوی نے یہ الفاظ نقل کیے ہیں اس نے نبی اکرم ﷽ کے سامنے زنا کا اعتراف کیا تو نبی اکرم ﷽ نے چار مرتبہ اسے واپس کیا پھر آپ سواری سے نیچے اترے آپ نے ہمیں حکم دیا ہم نے اس کے لئے گڑھا کھودا جو زیادہ لمبا نہیں تھا پھر اسے سنگسار کر دیا گیا پھر نبی اکرم ﷽ روانہ ہوئے تو آپ پریشان اور غمگین تھے ہم چلتے رہے یہاں تک کہ ہم نے ایک جگہ پر پڑاا کیا نبی اکرم ﷽ کی وہ کیفیت ختم ہوئی تو آپ نے مجھ سے فرمایا اے ابوذر کیا تم نے اس شخص کی طرف نہیں دیکھا کہ اس کی مغفرت ہو گئی اور اسے جنت میں داخل کر دیا گیا ۔   یہ روایت امام احمد اور امام بزار نے نقل کی ہے اس کی سند میں ایک راوی حجاج بن ارطاۃ ہے اور وہ مدلس ہے ۔"
"10607"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں ایک مرتبہ نبی اکرم ﷽ جمعہ کے دن لوگوں کو خطبہ دے رہے تھے بنولیث بن بکر بن عبدمناد بن کنانہ سے تعلق رکھنے والا ایک شخص آپ کی خدمت میں حاضر ہوا وہ لوگوں کی گردنیں پھیلانگتا ہوا آپ کے پاس آ گیا اس نے عرض کی : یا رسول اللہ ! مجھ پر حد قائم کیجئے نبی اکرم ﷽ نے اس سے فرمایا تم بیٹھ جاا وہ بیٹھ گیا پھر وہ دوسری مرتبہ کھڑا ہوا تو نبی اکرم ﷽ نے فرمایا تم بیٹھ جاا پھر وہ تیسری مرتبہ کھڑا ہوا تو نبی اکرم ﷽ نے اس کی مانند ارشاد فرمایا آپ نے دریافت کیا تمہاری حد کیا ہے اس نے بتایا میں نے حرام طور پر ایک عورت کے ساتھ صحبت کی ہے نبی اکرم ﷽ نے اپنے اصحاب میں سے ایک صاحب سے فرمایا ان اصحاب میں حضرت علی بن ابوطالب رضی اللہ عنہ حضرت عباس رضی اللہ عنہ حضرت زید بن حارثہ رضی اللہ عنہ اور حضرت عثمان غنی رضی اللہ عنہ سے اسے ساتھ لے جاا اور اسے ایک سو کوڑے لگاا اس لیثی شخص نے بھی شادی نہیں کی تھی لوگوں نے عرض کی : یا رسول اللہ ! کیا آپ اس عورت کو کوڑے نہیں لگوائیں گے جس کے ساتھ اس نے زنا کیا ہے نبی اکرم ﷽ نے فرمایا پہلے اسے کوڑے لگا کے میرے پاس لے کے آا جب اسے نبی اکرم ﷽ کے پاس لایا گیا تو نبی اکرم ﷽ نے دریافت کیا تم نے کس کے ساتھ ایسا کیا تھا اس نے بنو بکر سے تعلق رکھنے والی ایک عورت کا نام لے کے کہا کہ فلاں عورت کے ساتھ اس عورت کو لایا گیا نبی اکرم ﷽ نے اس سے دریافت کیا تو اس نے کہا اللہ کی قسم یہ جھوٹ بول رہا ہے میں اسے نہیں جانتی ہوں اور اس نے جو الزام لگایا ہے میں اس سے لاتعلق ہوں اور میں جو کہہ رہی ہوں اس بات پر گواہ اللہ تعالیٰ ہے نبی اکرم ﷽ نے ارشاد فرمایا کون شخص اس بات کی گواہی دے گا کہ تم نے اس عورت کے ساتھ زنا کیا ہے یہ تو انکار کر رہی ہے اگر تمہارے پاس گواہ ہیں تو ہم اس عورت کو حد کے طور پر کوڑے لگائیں گے ورنہ ہم تمہیں زنا کا جھوٹا الزام لگانے کی وجہ سے کوڑے لگائیں گے اس نے عرض کی : یا رسول اللہ ! میرے حق میں گواہی کون دے گا تو نبی اکرم ﷽ نے اس کے بارے میں حکم دیا تو زنا کا الزام لگانے کی حد میں اسی کوڑے لگائے گئے ۔ "
"10608"," عبدالعزیز بن عبداللي بن عمرو قرشی بیان کرتے ہیں مجھے اس شخص نے یہ بات بتائی ہے جو اس وقت نبی اکرم ﷽ کے پاس موجود تھے نبی اکرم ﷽ نے مکہ اور مدینہ کے درمیان ایک شخص کو سنگسار کرنے کا حکم دیا جب اسے پتھر لگے تو وہ بھاگ کھڑا ہوا نبی اکرم ﷽ کو اس بات کی اطلاع ملی تو آپ نے + لوگوں سے , فرمایا تم لوگوں نے اسے چھوڑ کیوں نہیں دیا تھا ۔   یہ روایت امام احمد نے نقل کی ہے اور اس کے رجال ثقہ ہیں 1"
"10609"," حضرت ابوہریرہ رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :   """" جب کوئی شخص زنا کا اعتراف کر لے اور پھر سنگسار ہونے کے وقت وہ بھاگ کھڑا ہو تو اسے چھوڑ دیا جائے """"۔ "
"10610","وَعَنْ أَبِي سَعِيدٍ - يَعْنِي الْخُدْرِيَّ - قَالَ: «جَاءَ شَابٌّ إِلَى رَسُولِ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ: يَا رَسُولَ اللَّهِ، عَلِّمْنِي دُعَاءً أُصِيبُ بِهِ خَيْرًا، فَقَالَ لَهُ: """" ادْنُهْ """". فَدَنَا حَتَّى كَادَتْ رُكْبَتُهُ تَمَسُّ رُكْبَةَ رَسُولِ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ: """" اللَّهُمَّ اعْفُ عَنِّي ; فَإِنَّكَ عَفُوٌّ تُحِبُّ الْعَفْوَ، وَأَنْتَ عَفُوٌّ كَرِيمٌ» """".\nرَوَاهُ أَبُو يَعْلَى، وَالطَّبَرَانِيُّ فِي الْأَوْسَطِ، وَفِيهِ يَحْيَى بْنُ مَيْمُونٍ التَّمَّارُ، وَهُوَ مَتْرُوكٌ."
"10611"," حضرت سہل بن سعد رضی اللہ عنہ بیان کرتے ہیں میں ماعز کے پاس موجود تھا جب نبی اکرم ﷽ اسے سنگسار کرنے کا حکم دیا تھا وہ بھاگا تو لوگ اس کو پتھر مارتے ہوئے اس کے پیچھے گئے یہاں تک کہ جبابہ کے مقام پر حضرت عمر رضی اللہ عنہ ان کے سامنے آئے انہوں نے اسے اونٹ کی ہڈی مار کے قتل کر دیا ۔   یہ روایت امام طبرانی نے نقل کی ہے اس کی سند میں ایک راوی ابوبکر بن ابوسبرہ ہے اور وہ کذاب ہے ۔"
"10612"," حضرت ابوبرزي رضی اللہ عنہ بیان کرتے ہیں نبی اکرم ﷽ نے حضرت ماعز بن مالک رضی اللہ عنہ کو سنگسار کروا دیا تھا ۔   یہ روایت امام طبرانی نے نقل کی ہے اور اس کے رجال ثقہ ہیں ۔"
"10613"," حضرت انس بن مالک رضی اللہ عنہ بیان کرتے ہیں ایک عورت نبی اکرم ﷽ کی خدمت میں حاضر ہوئی اس نے عرض کی : یا رسول اللہ ! میں حاملہ ہوں آپ مجھ پر حد جاری کیجئے نبی اکرم ﷽ نے فرمایا تمہارے پیٹ میں جو ہے ہم اسے قتل نہیں کریں گے وہ عورت چلی گئی جب اس نے بچے کو جنم دے دیا تو وہ آئی اس نے عرض کی میں نے بچے کو جنم دے دیا ہے نبی اکرم ﷽ نے فرمایا تم جاا اور اسے دودھ پلاا جب تک تم اس کا دودھ نہیں چھڑاتی ہو + تمہیں سزا نہیں ملے گی , پھر اس نے جب اس بچے کا دودھ چھڑا دیا تو وہ آئی اس نے عرض کی : یا رسول اللہ ! میں نے اس کا دودھ چھڑوا دیا ہے نبی اکرم ﷽ نے فرمایا تم جاا اور اس کا کفیل لے کے آا + جو اس کی دیکھ بھال کرے , وہ چلی گئی پھر وہ عورت اور اس کی بہن چلتی ہوئی آئیں نبی اکرم ﷽ کو اس عورت کا صبر پسند آیا پھر نبی اکرم ﷽ نے اسے سنگسار کرنے کا حکم دیا پر نبی اکرم ﷽ نے ایک شخص سے فرمایا تم جاا جب اس عورت کو گڑھے میں رکھا جائے تو تم اس کے سامنے کھڑے ہو جانا یہاں تک کہ تم اس کی آنکھوں کے بلکل سامنے آ جانا پھر آپ نے ایک اور شخص کو حکم دیا اور فرمایا تم جاا ایک بڑا پتھر لو اور پیچھے کی طرف سے اس عورت کے پاس آنا اور اس کو مار کر اسے توڑ دینا + یعنی قتل کر دینا , ۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے اس کی سند میں ایک ایسا راوی ہے جس سے میں واقف نہیں ہوں 1"
"10614"," حضرت انس بن مالک رضی اللہ عنہ بیان کرتے ہیں ایک عورت نبی اکرم ﷽ کے پاس آئی اس نے عرض کی اس نے زنا کا ارتکاب کیا ہے وہ عورت حاملہ تھی نبی اکرم ﷽ نے فرمایا تم جاا اور پہلے حمل کو جنم دو وہ عورت نہیں آئی تو نبی اکرم ﷽ نے اسے پیغام بھیج کے نہیں بلوایا پھر اس عورت نے اپنے حمل کو جنم دیا پھر وہ آپ کے پاس آئی تو نبی اکرم ﷽ نے فرمایا تم جاا جب تک تم اپنے بچے کا دودھ نہیں چھڑاتی ہو پھر وہ عورت آپ کے پاس آئی اگر وہ آپ کے پاس نہ آتی تو آپ نے اسے پیغام بھیج کے  بلوانا نہیں تھا دودھ چھڑانے کے بعد وہ آپ کے پاس آئی تو آپ نے اسے سنگسار کروا دیا ۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے اس کی سند میں ایک راوی حارث بن نبہان ہے اور وہ متروک ہے 1"
"10615"," حضرت انس رضی اللہ عنہ بیان کرتے ہیں ایک عورت نبی اکرم ﷽ کے پاس آئی اس نے زنا کا اعتراف کیا وہ عورت حاملہ تھی نبی اکرم ﷽ نے اس کے معاملے کو ماخر کر دیا جب تک وہ بچے کو جنم نہیں دیتی پھر آپ نے اس کے بارے میں حکم دیا اس کے کپڑے اس کے جسم پر باندھ دیے گئے پھر آپ نے اسے سنگسار کرنے کا حکم دیا پھر آپ نے اس کی نماز جنازہ پڑھائی ایک صاحب نے آپ کی خدمت میں عرض کی آپ اس کی نماز جنازہ پڑھا رہے ہیں جبکہ اس نے زنا کا ارتکاب کیا ہے اور آپ نے اسے سنگسار بھی کروایا ہے نبی اکرم ﷽ نے ارشاد فرمایا :   """" اس نے ایسی توبہ کی ہے کہ اگر اہل مدینہ کے ستر افراد نے اگر ایسی توبہ کی ہوتی تو وہ ان کی طرف سے بھی قبول ہو جاتی ہے کیا تمہیں اس سے زیادہ فضیلت والا کوئی فرد ملتا ہے کہ اس نے اپنی جان قربان کر دی ہے """"۔   یہ روایت امام طبرانی نے معجم صغیر اور معجم اوسط میں اپنے استاد علی بن احمد بن نضر کے حوالے سے نقل کی ہے امام دارقطنی نے اسے ضعیف قرار دیا ہے احمد بن کامل قاضی کہتے ہیں میرے علم کے مطابق اسے حدیث میں قابل مذمت قرار نہیں دیا گیا اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"10616"," حضرت ابوذر غفاری رضی اللہ عنہ بیان کرتے ہیں نبی اکرم ﷽ نے ایک عورت کو سنگسار کروایا آپ نے مجھے حکم دیا کہ میں اس کے لئے گڑھا کھودوں تو میں نے اپنی ناف تک اس کے لئے گڑھا کھود دیا ۔ یہ روایت امام احمد نے نقل کی ہے اس کی سند میں ایک راوی جابر جعفی ہے اور وہ ضعیف ہے ۔"
"10617"," صالح بن راشد قرشی بیان کرتے ہیں حجاج بن یوسف کے پاس ایک شخص کو لایا گیا جس نے اپنی بہن کے ساتھ زنا کیا تھا حجاج نے کہا اسے قید کر دو اور یہاں جو صحابہ کرام موجود ہیں ان سے اس بارے میں دریافت کرو لوگوں نے حضرت عبداللہ بن ابومطرف رضی اللہ عنہ سے اس بارے میں دریافت کیا تو انہوں نے بتایا میں نے نبی اکرم ﷽ کو یہ ارشاد فرماتے ہوئے سنا ہے :   """" جو شخص دو حرمتوں کو پھیلانگے اسے درمیان میں سے تلوار کے ذریعے چیر دو """"۔  راوی بیان کرتے ہیں ان لوگوں نے حضرت عبداللہ بن عباس رضی اللہ عنہما کو خط لکھا تو حضرت عبداللہ بن عباس رضی اللہ عنہما نے بھی انہیں جواب میں اسی کی مانند لکھا جو حضرت عبداللہ بن ابومطرف رضی اللہ عنہ نے بیان کیا تھا ۔   یہ روایت امام طبرانی نے نقل کی ہے اس کی سند میں ایک راوی رفدہ بن قضاعہ ہے ہشام بن عمار نے اسے ثقہ قرار دیا ہے  اور جمہور نے اسے ضعیف کہا ہے اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"10618"," حضرت براء بن عازب رضی اللہ عنہ بیان کرتے ہیں نبی اکرم ﷽ نے ایک شخص کی طرف کسی کو بھیجا جس نے اپنے باپ کی بیوی سے شادی کر لی تھی کہ اسے قتل کر دے ۔ "
"10619"," مطرف بیان کرتے ہیں وہ لوگ ایک خیمے میں آئے انہوں نے اس میں سے ایک شخص کو نکالا اور اسے قتل کر دیا میں نے دریافت کیا اس کا کیا معاملہ ہے لوگوں نے بتایا کہ اس شخص نے اپنی بیوی کی ماں کے ساتھ زنا کیا تھا تو نبی اکرم ﷽ نے اس کی طرف لوگوں کو بھیجا اور انہوں نے اسے قتل کر دیا ۔   یہ روایت امام احمد نے اسی طرح منقطع سند کے ساتھ نقل کی ہے اور اس کے رجال صحیح کے رجال ہیں ۔ "
"10620","وَفِي رِوَايَةٍ: «قُلْتُ: يَا رَسُولَ اللَّهِ، إِنِّي أَدْعُو بِشَيْءٍ مِنْ غَدْوَةٍ إِلَى اللَّيْلِ، فَقَالَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: """" فَسَلِ اللَّهَ الْعَافِيَةَ» """".\nرَوَاهُ كُلَّهُ الطَّبَرَانِيُّ بِأَسَانِيدَ، وَرِجَالُ بَعْضِهَا رِجَالُ الصَّحِيحِ غَيْرَ يَزِيدَ بْنِ أَبِي زِيَادٍ، وَهُوَ حَسَنُ الْحَدِيثِ."
"10621"," حضرت عبداللہ بن عمرو رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں """" وہ شخص جنت میں داخل نہیں ہو گا جو کسی محرم عورت کے ساتھ زنا کرے """"۔   یہ روایت امام طبرانی نے معجم اوسط میں اپنے استاد علی بن سعید سے نقل کی ہے امام دارقطنی کہتے ہیں وہ پائے کا نہیں ہے امام ذہبی کہتے ہیں وہ حافظان حدیث اور علم کے لئے سفر کرنے والوں میں سے ایک ہے ایک راوی عبدالعزیز بن عیسیٰ ہے اور میں اس سے واقف نہیں ہوں اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"10622"," عمران کے دو صاحبزادے معبد اور عبید بیان کرتے ہیں حضرت عبداللہ بن مسعود رضی اللہ عنہ کے پاس ایک شخص کو لایا گیا ہے اس نے کہا میں نے زنا کیا ہے حضرت عبداللہ بن مسعود رضی اللہ عنہ نے فرمایا ایسی صورت میں ہم تمہیں سنگسار کر دیں گے اگر تم محصن ہوئے لوگوں نے بتایا کہ اس نے اپنی بیوی کی کنیز کے ساتھ زنا کیا ہے تو حضرت عبداللہ رضی اللہ عنہ نے فرمایا اگر تو تم نے اس کے ساتھ زبردستی کی ہے تو تم اس کنیز کو آزاد کر دو اور اس کی جگہ اپنی بیوی کو ایک کنیز اور لے کے دو اس نے کہا اللہ کی قسم میں نے اس کنیز کے ساتھ زبردستی کی ہے اور اسے مارا ہے تو حضرت عبداللہ رضی اللہ عنہ نے اسے سنگسار نہیں کروایا انہوں نے اس کے بارے میں حکم دیا تو اسے حد سے کم سزا دی گئی ۔   یہ روایت امام طبرانی نے نقل کی ہے عبید اور معبد دونوں سے میں واقف نہیں ہوں اس روایت کے بقیہ رجال صحیح کے رجال ہیں 1"
"10623"," امام شعبی بیان کرتے ہیں حضرت عبداللہ بن مسعود رضی اللہ عنہ کا یہ خیال تھا کہ اس شخص پر نہ حد جاری ہو گی اور نہ مہر لازم ہو گا ۔   یہ روایت امام طبرانی نے نقل کی ہے اور اس کے رجال صحیح کے رجال ہیں البتہ امام شعبی نے حضرت عبداللہ بن مسعود رضی اللہ عنہ سے سماع نہیں کیا ہے ۔"
"10624"," حضرت عبداللہ بن عباس رضی اللہ عنہما نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں  """" کنیز پر اس وقت تک حد لازم نہیں ہو گی جب تک وہ محصن نہیں ہوتی جب وہ شادی کے ہمراہ محصن ہو جائے گی"
"10625"," ابراہیم بیان معقل بن مقرن مزنی حضرت عبداللہ رضی اللہ عنہ کے پاس آئے اور بولے کہ ان کی کنیز نے زنا کا ارتکاب کیا ہے حضرت عبداللہ رضی اللہ عنہ نے فرمایا تم اسے پچاس کوڑے لگاا انہوں نے کہا اس کنیز کا شوہر نہیں ہے حضرت عبداللہ رضی اللہ عنہ نے فرمایا اس کا اسلام اس کا احصان ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے اور اس کے رجال صحیح کے رجال ہیں البتہ ابراہیم نامی راوی نے حضرت عبداللہ بن مسعود رضی اللہ عنہ سے ملاقات نہیں کی ہے ۔"
"10626"," حضرت ابوحجیفہ رضی اللہ عنہ بیان کرتے ہیں نبی اکرم ﷽ نے ایسی عورت سے حد کو پرے کر دیا گیا جس کے ساتھ زبردستی کی گئی تھی ۔  یہ روایت امام طبرانی نے نقل کی ہے اس کی سند میں ایک راوی حجاج بن ارطاۃ ہے اور وہ مدلس ہے ۔"
"10627"," عبدالکریم بیان کرتے ہیں مجھے حضرت علی رضی اللہ عنہ اور حضرت عبداللہ بن مسعود رضی اللہ عنہ کے بارے میں یہ بات بتائی گئی ہے کہ جس کنواری لڑکی کے ساتھ زبردستی کی گئی ہو اس کے بارے میں وہ حضرات فرماتے ہیں کہ کنواری لڑکی کو اس جیسی کسی لڑکی مانند مہر ملے گا اور ثیبہ عورت کو بھی اس جیسی عورت کی مانند مہر ملے گا ۔   یہ روایت امام طبرانی نے نقل کی ہے اس کی سند منقطع ہے اور عبدالکریم نامی راوی تک اس کے رجال ثقہ ہیں ۔"
"10628"," عبدالکریم بیان کرتے ہیں حضرت علی رضی اللہ عنہ اور حضرت عبداللہ بن مسعود رضی اللہ عنہ نے ایسی کنیز کے بارے میں یہ فرمایا ہے جس کے ساتھ زبردستی کی گئی ہو کہ اگر تو وہ کنواری ہو تو پھر اس کی قیمت کا دسواں حصہ ادا کیا جائے گا اور اگر وہ ثیبہ ہو تو پھر اس کی قیمت کا بیسواں حصہ ادا کیا جائے گا ۔   یہ روایت امام طبرانی نے اسی سند کے ساتھ نقل کی ہے جو اس سے پہلے گزری ہے اور وہ سند منقطع ہے ۔"
"10629"," عبدالرحمن بن عبداللہ بن مسعود رضی اللہ عنہ بیان کرتے ہیں حضرت عبداللہ بن مسعود رضی اللہ عنہ کے پاس ایک شخص کو لایا گیا جو ایک عورت کے ساتھ ایک لحاف میں پایا گیا تھا تو حضرت عبداللہ رضی اللہ عنہ نے ان دو میں سے ہر ایک کو چالیس کوڑے لگوائے ان دونوں کو لوگوں کے سامنے کھڑا کیا عورت کے گھر والے اور مرد کے گھر والے گئے انہوں نے اس بارے میں شکایت حضرت عمر بن خطاب رضی اللہ عنہ سے کی حضرت عمر رضی اللہ عنہ نے حضرت عبداللہ بن مسعود رضی اللہ عنہ سے فرمایا یہ لوگ کیا کہہ رہے ہیں حضرت عبداللہ رضی اللہ عنہ نے فرمایا میں نے ایسا کیا ہے حضرت عمر رضی اللہ عنہ نے دریافت کیا کیا یہ آپ کی اپنی رائے ہے انہوں نے جواب دیا جی ہاں حضرت عمر رضی اللہ عنہ نے فرمایا آپ کی رائے اچھی ہے ان لوگوں نے کہا ہم تو ان کے پاس آئے تھے تاکہ ان سے اجازت لیں اور یہ خود ان سے پوچھ رہے ہیں ۔ یہ روایت امام طبرانی نے نقل کی ہے اور اس کے رجال صحیح کے رجال ہیں ۔"
"10630"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں نبی اکرم ﷽ نے مسجد کے دروازے کے پاس ایک یہودی مرد اور یہودی عورت کو سنگسار کرنے کا حکم دیا جب یہودی مرد کو پتھر لگے تو وہ اپنی ساتھی عورت کی طرف بڑھا اور اس پر جھگ گیا تاکہ اسے پتھر لگنے سے بچائے یہاں تک کہ ان دونوں کو قتل کر دیا گیا تو ان دونوں کی طرف سے زنا ثابت ہو جانے کے بعد اللہ تعالیٰ نے اپنے رسول کے لئے یہ طرز عمل مقرر کیا تھا ۔   یہ روایت امام احمد اور امام طبرانی نے نقل کی ہے تاہم انہوں نے یہ الفاظ نقل کیے ہیں  """" نبی اکرم ﷽ کے پاس ایک یہودی مرد اور یہودی عورت کو لایا گیا وہ دونوں محصن تھے ان لوگوں نے نبی اکرم ﷽ سے یہ درخواست کی کہ آپ ان دونوں کے بارے میں سنگسار کرنے کا حکم دیں تو نبی اکرم ﷽ نے مسجد سے باہر ان دونوں کو سنگسار کروایا ۔  امام احمد کے رجال ثقہ ہیں ابن اسحاق نے سماع کی صراحت کی ہے جو امام احمد کی روایت میں ہے ۔"
"10631"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں کچھ لوگ نبی اکرم ﷽ کی خدمت میں حاضر ہوئے وہ اپنے ساتھ ایک عورت کو لے کے آئے تھے انہوں نے کہا : اے حضرت محمد + ﷽ , آپ پر زنا کے بارے میں کیا نازل ہوا ہے آپ نے فرمایا تم لوگ جاا اور میرے پاس بنی اسرائیل کے علماء میں سے دو افراد کو لے کے آا وہ لوگ گئے اور اپنے میں سے دو علماء کو آپ کے پاس لے کے آئے جن میں سے ایک نوجوان تھا اور فصیح تھا اور دوسرا بوڑھا تھا جس کی بھویں اس کی آنکھوں پے آ رہی تھیں یہاں تک کہ انہیں اٹھایا جاتا تھا نبی اکرم ﷽ نے فرمایا میں دونوں کو اس اللہ کا واسطہ دے کر دریافت کرتا ہوں کہ تم لوگ ہمیں بتاا کہ اللہ تعالیٰ زنا کرنے والے شخص کے بارے میں حضرت موسیٰ پر کیا حکم نازل کیا ہے تو انہوں نے کہا آپ نے ہمیں عظیم واسطہ دیا ہے ہم آپ کو بتاتے ہیں زنا کرنے والے کے بارے میں اللہ تعالیٰ نے حضرت موسیٰ پر سنگسار کرنے کا حکم نازل کیا ہے ہم ایسے لوگ ہیں جن میں نوجوان زیادہ ہیں اور ہماری عورتیں خوبصورت ہوتی ہیں زنا ہمارے درمیان زیادہ ہو گیا تو ہم پھر یہ سزا نہیں دیتے تھے ہم کوڑے لگوا دیتے تھے اور شرمندہ کروا دیتے تھے نبی اکرم ﷽ نے فرمایا تم اپنی ساتھی عورت کو لے جاا جب یہ اپنے پیٹ میں موجود بچے کو جنم دے دے گی تو تم اسے سنگسار کر دینا ۔   یہ روایت امام طبرانی نے نقل کی ہے اور اس کے رجال ثقہ ہیں اس روایت کا ایک اور طریق ہے جو سورت مائدہ میں آئے گا ۔"
"10632"," حضرت عبداللہ بن حارث بن جزء رضی اللہ عنہ بیان کرتے ہیں یہودی نبی اکرم ﷽ کی خدمت میں ایک یہودی مرد اور ایک یہودی عورت کو لے کے آئے جنہوں نے زنا کیا تھا وہ دونوں محصن تھے تو نبی اکرم ﷽ کے حکم کے تحت ان دونوں کو سنگسار کر دیا گیا ۔  حضرت عبداللہ بن حارث رضی اللہ عنہ بیان کرتے ہیں میں نے انہیں سنگسار کرنے ولوں میں شامل تھا ۔   یہ روایت امام بزار اور امام طبرانی نے معجم کبیر اور معجم اوسط میں نقل کی ہے انہوں نے اس میں یہ الفاظ نقل کیے ہیں حضرت عبداللہ بن حارث رضی اللہ عنہ کے حوالے سے یہ روایت صرف اسی سند کے ساتھ منقول ہے اس کی سند میں ایک راوی ابن لہیعہ ہے اس کی نقل کردہ حدیث حسن ہے اس میں ضعف پایا جاتا ہے اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"10633"," حضرت جابر رضی اللہ عنہ بیان کرتے ہیں یہودی اپنے ایک مرد اور ایک عورت کو لے کے آئے جنہوں نے زنا کا ارتکاب کیا تھا نبی اکرم ﷽ نے فرمایا تم اپنے درمیان موجود دو سب سے بڑے عالموں کو میرے پاس لے کے آئے تو لوگ صوریا کے دو بیٹوں کو لے کے آپ کے پاس آئے نبی اکرم ﷽ نے فرمایا تم دونوں اپنے پیچھے موجود افراد سے زیادہ علم رکھتے ہو انہوں نے کہا لوگوں کا یہی سمجھنا ہے تو نبی اکرم ﷽ نے ان دونوں کو اس اللہ کا واسطہ دیا جس نے حضرت موسیٰ پر تورات نازل کی کہ تم دونوں مرد اور عورت , کے بارے میں اللہ کی تورات میں کیا حکم پاتے ہو ان دونوں نے یہ کہا کہ ہم نے تورات میں یہ حکم پایا ہے کہ جب کوئی شخص کسی عورت کے ساتھ کسی گھر میں پایا جائے تو ایک مشکوک صورت حال ہے اس میں سزا دی جائے گی جب کوئی شخص عورت کے کپڑے میں پایا جائے یا اس کے پیٹ پر پایا جائے تو یہ مشکوک صورت حال ہے تو اس میں سزا دی جائے گی اور جب چار افراد اس بات کی گواہی دیں کہ ان لوگوں نے مرد کو دیکھا ہے کہ جس طرح سرمہ دانی کی سلائی سرمہ دانی میں ڈالی جاتی ہے اس طرح اس نے + اس عورت کے ساتھ زنا کیا ہے , تو اسے سنگسار کر دیا جائے گا نبی اکرم ﷽ نے فرمایا پھر کیا وجہ ہے تم نے ان دونوں کو سنگسار کیوں نہیں کیا ان دونوں نے کہا ایک تو ہماری حکومت ختم ہو گئی ہے تو ہم نے قتل کرنے کو ناپسند کیا نبی اکرم ﷽ نے گواہوں کو بلوایا ان لوگوں نے گواہی دی تو نبی اکرم ﷽ نے ان دونوں + مرد و عورت , کو سنگسار کرنے کا حکم دیا ۔ "
"10634"," جابر نامی راوی بیان کرتے ہیں میں نے سالم بن عبداللہ اور ابان بن عثمان اور زید بن حسن کو یہ بات ذکر کرتے ہوئے سنا کہ حضرت عثمان غنی رضی اللہ عنہ کے عہد خلافت میں , ان کے پاس ایک ایسے شخص کو لایا گیا جس نے قریش سے تعلق رکھنے والے ایک لڑکے کے ساتھ بدکاری کی تھی جس کا نسب معروف تھا حضرت عثمان رضی اللہ عنہ نے فرمایا تمہارا ستیاناس ہو گواہ کہاں ہیں کیا یہ شخص محصن ہے لوگوں نے کہا اس شخص نے ایک عورت کے ساتھ شادی کی تھی لیکن اس کی رخصتی نہیں کروائی تھی حضرت علی رضی اللہ عنہ نے حضرت عثمان رضی اللہ عنہ سے فرمایا اگر تو اس نے اس عورت کی رخصتی کروا لی ہوتی تو پھر اسے سنگسار کرنے کی سزا دی جا سکتی تھی لیکن کیونکہ اس نے اپنی بیوی کی رخصتی نہیں کروائی تو اب آپ اسے حد کے کوڑے لگوا دیں حضرت ابوایوب انصاری رضی اللہ عنہ نے کہا میں اس بات کی گواہی دیتا ہوں کہ میں نے نبی اکرم ﷽ کو وہی بات ارشاد فرماتے ہوئے سنا ہے جو جناب ابوالحسن نے نقل کی ہے تو حضرت عثمان رضی اللہ عنہ نے اس شخص کے بارے میں حکم دیا تو اسے ایک سو کوڑے لگائے گئے ۔   یہ روایت امام طبرانی نے نقل کی ہے اس کی سند میں ایک راوی جابر جعفی ہے جس نے سماع کی صراحت کی ہے اور اس کی سند میں ایسا راوی ہے جس سے میں واقف نہیں ہوں ۔"
"10635","وَعَنْ عَبْدِ اللَّهِ - يَعْنِي ابْنَ مَسْعُودٍ - قَالَ: «كَانَ النَّبِيُّ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - يُعَلِّمُنَا هَذَا الْكَلَامَ: """" اللَّهُمَّ أَصْلِحْ ذَاتَ بَيْنِنَا، وَأَلِّفْ بَيْنَ قُلُوبِنَا، وَاهْدِنَا سُبُلَ السَّلَامِ، وَنَجِّنَا مِنَ الظُّلُمَاتِ إِلَى النُّورِ، وَجَنِّبْنَا الْفَوَاحِشَ مَا ظَهَرَ مِنْهَا وَمَا بَطَنَ. اللَّهُمَّ بَارِكْ لَنَا فِي أَسْمَاعِنَا وَفِي أَبْصَارِنَا، وَقُلُوبِنَا وَأَرْوَاحِنَا، وَذُرِّيَّاتِنَا، وَتُبْ عَلَيْنَا ; إِنَّكَ أَنْتَ التَّوَّابُ الرَّحِيمُ، وَاجْعَلْنَا شَاكِرِينَ لِنِعَمِكَ مُثْنِينَ بِهَا، قَابِلِينَ لَهَا، وَأَتِمَّهَا عَلَيْنَا» """".\nرَوَاهُ الطَّبَرَانِيُّ فِي الْكَبِيرِ وَالْأَوْسَطِ، وَإِسْنَادُ الْكَبِيرِ جَيِّدٌ."
"10636","حضرت ابوہریرہ رضی اللہ عنہ نبی اکرم ﷺ کا یہ فرمان نقل کرتے ہیں : """" اللہ تعالیٰ نے سات آسمانوں کے اوپر سے اپنی مخلوق میں سے سات قسم کے لوگوں پر لعنت کی ہے اور ان میں سے ایک پر تین مرتبہ لعنت کی ہے حالانکہ ان میں سے ہر ایک کے لئے ایک لعنت ہی کفایت کر جائے اس نے فرمایا ہے وہ شخص ملعون ہے جو قوم لوط کا سا عمل کرتا ہے وہ شخص ملعون ہے جو قوم لوط کا سا عمل کرتا ہے وہ شخص ملعون ہے جو قوم لوط کا سا عمل کرتا ہے وہ شخص ملعون ہے غیر اللہ کے نام پر ذبح کرتا ہے وہ شخص ملعون ہے جو کسی جانور کے ساتھ بدکاری کرتا ہے وہ شخص ملعون ہے جو اپنے ماں باپ کی نافرمانی کرتا ہے وہ شخص ملعون ہے جو عورت اور اس کی بیٹی کو ( صحبت کرنے میں ) جمع کرتا ہے وہ شخص ملعون ہے جو زمین کی حدود کو تبدیل کرتا ہے وہ شخص ملعون ہے جو آزاد کرنے والے اپنے آقا کی بجائے کسی اور کی طرف خود کو منسوب کرتا ہے """"۔ یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے اس کی سند میں ایک راوی محرز بن ہارون ہے ایک قول کے مطابق ان کا نام محرر ہے جمہور نے اسے ضعیف قرار دیا ہے امام ترمذی نے اس کی نقل کردہ حدیث کو حسن قرار دیا ہے اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"10637"," حضرت ابوہریرہ رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :"""" چار قسم کے لوگ اللہ کے غضب میں صبح کرتے ہیں اور اللہ کی ناراضگی میں شام کرتے ہیں میں نے عرض کی یا رسول اللہ وہ کون لوگ ہیں نبی اکرم ﷽ نے فرمایا خواتین کے ساتھ مشابہت اختیار کرنے والے مرد مردوں کے ساتھ مشابہت اختیار کرنے والی خواتین وہ شخص جو کسی جانور کے ساتھ بدفعلی کرتا ہے اور وہ شخص جو مرد کے ساتھ بدفعلی کرتا ہے """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل محمد بن سلام خزاعی کے حوالے سے ان کے والد سے نقل کی ہے امام بخاری کہتے ہیں اس کی اس حدیث میں اس کی متابعت نہیں کی گئی ہے ۔"
"10638"," حضرت ابوسعید خدری رضی اللہ عنہ بیان کرتے ہیں نبی اکرم ﷽ کے پاس ایک ہیجڑے کو لایا گیا جس نے دونوں ہاتھوں اور دونوں پااں پر مہندی لگائی ہوئی تھی نبی اکرم ﷽ کے اصحاب نے اسے جوتوں کے ذریعے مارنا شروع کیا تو نبی اکرم ﷽ نے فرمایا اسے اور اس طرح کے دیگر لوگوں کو اپنی خواتین کے پاس جانے سے روکو لوگوں نے عرض کی : یا رسول اللہ ! کیا ہم اسے قتل نہ کر دیں نبی اکرم ﷽ نے فرمایا جی نہیں مجھے نمازیوں کو قتل کرنے سے منع کیا گیا ہے ۔ "
"10639"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں نبی اکرم ﷽ نے ہیجڑوں پر لعنت کی ہے آپ نے فرمایا ہے انہیں اپنے گھروں سے نکال دو """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے اور اس کی سند میں ایک راوی حماد بن عبدالرحمن کلبی ہے اور وہ ضعیف ہے ۔"
"10640"," حضرت عبداللہ بن مسعود رضی اللہ عنہ نبی اکرم ﷽ کے بارے میں یہ بات نقل کرتے ہیں آپ نے دس قسم کے لوگوں پر لعنت کی ہے "" جسم گودنے والی عورت "" گودنے والی عورت "" چہرے کے بال نوچنے والی عورت ، نقلی بال لگوانے والی عورت اور لگانے والی عورت اور سود کھانے والا شخص اور اس کا گواہ اور زکوۃ نہ دینے والا شخص اور عورتوں کے ساتھ مشابہت اختیار کرنے والا مرد اور مردوں کے ساتھ مشابہت اختیار کرنے والی عورت """"۔ "
"10641"," حضرت ابوہریرہ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" جو شخص جانور سے بدفعلی کرے تو اس شخص کو قتل کر دو اور اس کے ساتھ اس جانور کو بھی قتل کر دو """"۔   یہ روایت امام ابویعلیٰ نے نقل کی ہے اس کی سند میں ایک راوی محمد بن عمرو بن علقمہ ہے اس کی نقل کردہ حدیث حسن ہے اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"10642","دس درہم سے کم کی چوری میں ہاتھ کاٹنا نہیں ہے۔"
"10643"," عراک بیان کرتے ہیں : انہوں نے حج کے موقع پر مروان کو یہ کہتے ہوئے سنا : نبی اکرم ﷽ نے ایک ڈھال کی چوری پر ہاتھ کٹوا دیا تھا اور اونٹ تو ڈھال سے مہنگا ہوتا ہے ۔   یہ روایت امام احمد نے نقل کی ہے "" اور اس کے رجال صحیح کے رجال ہیں ۔"
"10644"," حضرت عبداللہ بن مسعود رضی اللہ عنہ فرماتے ہیں : ہاتھ صرف ایک دینار "" یا دس درہم + قیمت والی چیز کی چوری ,  پر کاٹا جائے گا ۔   یہ روایت امام طبرانی نے نقل کی ہے یہ موقوف ہے قاسم ابوعبدالرحمن نامی راوی ضعیف ہے "" ویسے اس کی توثیق کی گئی ہے ۔"
"10645","وَعَنِ الزُّبَيْرِ أَنَّ النَّبِيَّ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ: "" «اللَّهُمَّ بَارِكْ لِي فِي دِينِي الَّذِي هُوَ عِصْمَةُ أَمْرِي، وَفِي آخِرَتِي الَّتِي إِلَيْهَا مَصِيرِي، وَفِي دُنْيَايَ الَّتِي فِيهَا بَلَاغِي، وَاجْعَلْ حَيَاتِي زِيَادَةً فِي كُلِّ خَيْرٍ، وَاجْعَلِ الْمَوْتَ رَاحَةً لِي مِنْ كُلِّ شَرٍّ» "" رَوَاهُ الْبَزَّارُ، وَرِجَالُهُ رِجَالُ الصَّحِيحِ غَيْرَ صَالِحِ بْنِ مُحَمَّدٍ جَزَرَةَ، وَهُوَ ثِقَةٌ."
"10646"," حضرت عبداللہ بن مسعود رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :"""" صرف + یعنی کم از کم , دس درہم + قیمت والی چیز چوری کرنے , پر ہاتھ کاٹا جائے گا """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے "" اور اس کی سند ضعیف ہے ۔"
"10647"," سیدہ ام ایمن رضی اللہ عنہا بیان کرتی ہیں : نبی اکرم ﷽ نے ارشاد فرمایا : "
"10648"," حضرت سعد بن ابی وقاص رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے ایک ڈھال + چوری کرنے پر چور کا ہاتھ , کٹوا دیا تھا ، جس کی قیمت پانچ درہم تھی ۔ "
"10649"," حضرت علی رضی اللہ عنہ فرماتے ہیں : نبی اکرم ﷽ نے لوہے کی ڈھال + چوری کرنے پر چور کا ہاتھ , کٹوا دیا تھا اس + ڈھال , کی قیمت اکیس درہم تھی ۔   یہ روایت امام بزار نے نقل کی ہے ۔ اس کی سند میں ایک راوی مختار بن نافع ہے "" اور وہ ضعیف ہے ۔"
"10650"," حضرت جابر بن عبداللي رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ کے زمانہ اقدس میں ایک لڑکی نے شراب کا مٹکا + یا مشکیزہ , چوری کر لیا اس کی قیمت تین درہم بھی نہیں تھی ، تو نبی اکرم ﷽ نے اس کا ہاتھ نہیں کٹوایا ۔   یہ روایت امام بزار نے نقل کی ہے وہ فرماتے ہیں : یہ شراب کی حرمت نازل ہونے سے پہلے کی بات ہے باقی اللہ بہتر جانتا ہے ۔ اس کی سند میں ایک راوی ابوحومل ہے ۔ امام ذہبی کہتے ہیں : یہ معروف نہیں ہے ۔"
"10651","مویشیوں میں ہاتھ کاٹنا نہیں ہے سواۓ اس کے جو باڑے کے پیچھے ہو، اور کھجوروں میں بھی نہیں سواۓ اس کے جو انبار میں محفوظ ہو۔"
"10652"," ہمام بن حارث بیان کرتے ہیں : ابن مقرن نے حضرت عبداللہ بن مسعود رضی اللہ عنہ سے دریافت کیا "" اور کہا : اے ابوعبدالرحمن ! میں نے یہ حلف اٹھایا ہے کہ میں ایک سال تک اپنے بستر پر نہیں سواں گا "" تو حضرت عبداللہ رضی اللہ عنہ نے یہ آیت تلاوت کی :  اے ایمان والو ! ان پاکیزہ حلال چیزوں کو حرام قرار نہ دو "" جو اللہ تعالیٰ نے تمہارے لئے حلال قرار دی ہیں "" اور تم حد سے تجاوز نہ کرو بے شک اللہ تعالیٰ حد سے تجاوز کرنے والوں کو پسند نہیں کرتا """"۔ "
"10653"," قاسم بیان کرتے ہیں : حضرت عبداللہ رضی اللہ عنہ کے پاس ایک کنیز + یا لڑکی , کو لایا گیا جس نے چوری کی تھی وہ محصنہ نہیں تھی ، تو حضرت عبداللہ رضی اللہ عنہ نے اس کا ہاتھ نہیں کاٹا ۔   یہ روایت امام طبرانی نے نقل کی ہے "" اور قاسم بن عبدالرحمن بن عبداللہ بن مسعود نے اپنے دادا سے سماع نہیں کیا ہے لیکن اس روایت کے رجال صحیح کے رجال ہیں ۔"
"10654"," قاسم نامی اسی راوی کے حوالے سے یہ بات منقول ہے وہ بیان کرتے ہیں : حضرت عبداللہ بن مسعود رضی اللہ عنہ آئے حضرت سعد رضی اللہ عنہ نے قصر بنوایا تھا اور انہوں نے اصحاب نمر کے درمیان مسجد بنائی تھی ، وہ نکل کر اس کی طرف نمازوں کی ادائیگی کے لئے جاتے تھے جب حضرت عبداللہ رضی اللہ عنہ کو بیت المال کا نگران مقرر کیا گیا اور بیت المال میں نقب لگی تو انہوں نے ایک شخص کو پکڑ لیا تو حضرت عبداللہ رضی اللہ عنہ نے اس بارے میں حضرت عمر رضی اللہ عنہ کو خط لکھا تو حضرت عمر رضی اللہ عنہ نے جوابی خط میں لکھا کہ تم اس کا ہاتھ نہ کاٹو   اور مسجد کو منتقل کر دو اور بیت المال کو قبلہ والی سمت میں کر دو کیونکہ جو شخص نماز ادا کرے گا وہ مسلسل مسجد میں رہے گا ، تو حضرت عبداللہ رضی اللہ عنہ نے اسے منتقل کر دیا اور وہاں لکیر لگوا دی حضرت سعد رضی اللہ عنہ نے جو محل تعمیر کروایا تھا وہ شاذروان تھا امام اس پر کھڑا ہوتا تھا حضرت عبداللہ رضی اللہ عنہ کے حکم کے تحت اسے توڑ دیا گیا تھا یہاں تک کہ امام لوگوں کے برابر کھڑا ہونے لگا ۔   یہ روایت امام طبرانی نے نقل کی ہے قاسم نامی راوی نے اپنے دادا سے سماع نہیں کیا ہے اس روایت کے رجال صحیح کے رجال ہیں ۔"
"10655"," حضرت عصمہ رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ کے زمانہ اقدس میں ایک غلام نے چوری کر لی یہ معاملہ نبی اکرم ﷽ کی بارگاہ میں پیش کیا گیا تو نبی اکرم ﷽ نے اس سے درگزر کیا پھر دوسری مرتبہ آپ کے سامنے اسے پیش کیا گیا کہ اس نے چوری کی ہے "" تو آپ نے پھر اسے معاف کر دیا پھر تیسری مرتبہ اسے آپ کے سامنے لایا گیا اس نے چوری کی ہوئی تھی نبی اکرم ﷽ نے اس سے درگزر کیا پھر چوتھی مرتبہ اسے نبی اکرم ﷽ کے سامنے پیش کیا گیا اس نے چوری کی تھی نبی اکرم ﷽ نے اسے معاف کر دیا پھر پانچویں مرتبہ اسے نبی اکرم ﷽ کے پاس لایا گیا اس نے چوری کی ہوئی تھی ، تو نبی اکرم ﷽ نے اس کا ہاتھ کٹوا دیا پھر چھٹی مرتبہ اسے نبی اکرم ﷽ کے پاس لایا گیا اس نے چوری کی ہوئی تھی ، تو نبی اکرم ﷽ نے اس کا ایک پااں کٹوا دیا پھر ساتویں مرتبہ اسے نبی اکرم ﷽ کے پاس لایا گیا اس نے چوری کی ہوئی تھی ، تو نبی اکرم ﷽ نے اس کا دوسرا ہاتھ کٹوا دیا پھر اسے آٹھویں مرتبہ نبی اکرم ﷽ کے پاس لایا گیا کہ اس نے چوری کی تھی تو نبی اکرم ﷽ نے اس کا دوسرا پااں کٹوا دیا اور نبی اکرم ﷽ نے فرمایا : چار کے بدلے چار ہو گئے ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی فضل بن مختار ہے "" اور وہ ضعیف ہے ۔"
"10656"," ابو ماجد حنفی بیان کرتے ہیں : میں حضرت عبداللہ رضی اللہ عنہ کے پاس بیٹھا ہوا تھا ، انہوں نے فرمایا : اور میں اس شخص کا ذکر کر رہا تھا ، جس کا نبی اکرم ﷽ نے سب سے پہلے ہاتھ کٹوایا تھا ایک چور کو لایا گیا آپ نے اس کا ہاتھ کٹوا دیا ۔ نبی اکرم ﷽ کا چہرہ مبارک تبدیل ہو گیا + یعنی آپ اس حوالے سے غمگین تھے , ۔ راوی کہتے ہیں : لوگوں نے عرض کی : یا رسول اللہ ! گویا آپ کو یہ بات اچھی نہیں لگی کہ اس کا ہاتھ کاٹ دیا جائے ۔ نبی اکرم ﷽ نے ارشاد فرمایا : میرے لئے کیا چیز رکاوٹ ہو سکتی ہے تم لوگ اپنے بھائی کے خلاف شیطان کے مددگار نہ بنوحکمران کے لئے مناسب یہ ہے : جب کوئی مقدمہ آئے "" تو وہ اس کی سزا کو جاری کرے بے شک اللہ تعالیٰ معاف کرنے والا ہے وہ معاف کرنے کو پسند کرتا ہے + بے شک اس نے ارشاد فرمایا ہے : ,   """" لوگوں کو چاہیے کہ وہ معاف کریں اور درگزر کریں کیا تم لوگ یہ بات پسند نہیں کرتے ہو کہ اللہ تعالیٰ تمہاری مغفرت کر دے اور اللہ تعالیٰ مغفرت کرنے والا رحم کرنے والا ہے """"۔   یہ روایت امام احمد نے نقل کی ہے ۔"
"10657"," ان کی نقل کردہ ایک روایت میں یہ الفاظ ہیں : وہ بیان کرتے ہیں : نبی اکرم ﷽ کا چہرہ مبارک متغیر ہو گیا ۔ راوی کہتے ہیں : یوں لگتا تھا جیسے اس پر راکھ ڈال دی گئی ہو ۔"
"10658"," ایک روایت میں یہ الفاظ ہیں : ایک شخص حضرت عبداللہ بن مسعود رضی اللہ عنہ کے پاس اپنے بھتیجے کو لے کر آیا اور بولا یہ میرا بھتیجا ہے "" اور اس نے چوری کی ہے "" حضرت عبداللہ رضی اللہ عنہ نے فرمایا : تم یہ بات جانتے ہو کہ اسلام میں جو پہلی حد جاری ہوئی تھی وہ ایک عورت پر جاری ہوئی تھی جس نے چوری کی تھی اور اس کا ہاتھ کاٹ دیا گیا تھا 11111111 اس کے بعد راوی نے حسب سابق روایت نقل کی ہے ۔   یہ تمام روایات امام احمد نے نقل کی ہیں "" اور امام ابویعلیٰ نے صرف عورت والی روایت نقل کی ہے ابوماجد حنفی نامی راوی ضعیف ہے ۔"
"10659"," ابوماجد حنفی بیان کرتے ہیں : ایک شخص اپنے بھتیجے کو لے کر حضرت عبداللہ بن مسعود رضی اللہ عنہ کی خدمت میں آیا وہ بھتیجا نشے کی حالت میں تھا اس شخص نے بتایا میں نے اسے نشے کی حالت میں پایا ہے حضرت عبداللہ رضی اللہ عنہ نے فرمایا : اسے حرکت دو تاکہ اسے ہوش آئے ۔ راوی کہتے ہیں : لوگوں نے اسے ہلایا جلایا اسے حرکت دی اس کے منہ سے شراب کی بو آ رہی تھی حضرت عبداللہ رضی اللہ عنہ نے اس کے بارے میں حکم دیا کہ اسے قید کر دیا جائے پھر اگلے دن اسے وہاں سے نکالا گیا پھر حضرت عبداللہ رضی اللہ عنہ نے ایک چھڑی تیار کرنے کا حکم دیا اس کا پھل اتار لیا گیا یہاں تک کہ وہ ہلکی ہو گئی "" پھر حضرت عبداللہ رضی اللہ عنہ نے جلاد سے کہا : تم اسے کوڑے لگاا اور اپنا ہاتھ کھینچ کے رکھنا اور ہر عضو کو اس کا حق دینا تو اس جلاد نے اسے ایسے مارا کہ جو زیادہ تکلیف دہ نہیں تھا لیکن تکلیف دہ تھا اور حضرت عبداللہ رضی اللہ عنہ نے اسے قبا اور شلوار پہنائے رکھی تھی یا قمیص اور شلوار تھی پھر حضرت عبداللہ رضی اللہ عنہ نے + اس کے چچا سے کہا : اللہ کی قسم ! تم یتیم کے برے والی ہو تم نے اس کی تربیت کرتے ہوئے اچھی تربیت بھی نہیں کی اور اس رسوائی کی بات کی پردہ پوشی بھی نہیں کی اس نے کہا : اے ابوعبدالرحمن یہ میرا بھتیجا ہے میں اس کے لئے وہی محبت محسوس کرتا ہوں جو اپنی اولاد کے لئے کرتا ہوں تو حضرت عبداللہ رضی اللہ عنہ نے فرمایا : بے شک اللہ تعالیٰ معاف کرنے کو پسند کرتا ہے لیکن والی کے لئے یہ مناسب نہیں ہے کہ اس کے پاس کوئی حد کا مقدمہ آئے اور وہ اس کو جاری نہ کرے پھر حضرت عبداللہ رضی اللہ عنہ نے نبی اکرم ﷽ کے حوالے سے یہ بات بیان کی انہوں نے فرمایا : مسلمانوں میں سے پہلا شخص جس کا ہاتھ کاٹا گیا تھا اس کا تعلق انصار سے تھا ۔ عرض کی گئی : یا رسول اللہ ! اس نے چوری کی ہے 11111 اس کے بعد حسب سابق حدیث ہے جو پہلے گزر چکی ہے ۔  ابو ماجد نامی راوی ضعیف ہے ۔"
"10660"," حضرت عبداللہ بن عمرو رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ کے زمانہ اقدس میں ایک عورت نے چوری کر لی وہ لوگ اسے لے کر آئے جن کے ہاں اس عورت نے چوری کی تھی انہوں نے کہا : یا رسول اللہ ! اس عورت نے ہمارے ہاں چوری کی ہے عورت کی قوم نے کہا : ہم اس کا فدیہ دے دیتے ہیں نبی اکرم ﷽ نے فرمایا : اس کا ہاتھ کاٹ دو لوگوں نے کہا : ہم اس کے فدیے میں پانچ سو دینار دیدیتے ہیں نبی اکرم ﷽ نے فرمایا : اس کا ہاتھ کاٹ دو اس عورت کا دایاں ہاتھ کاٹ دیا گیا اس عورت نے کہا : یا رسول اللہ ! کیا میرے لئے توبہ کی گنجائش ہے آ نبی اکرم ﷽ نے فرمایا : جی ہاں تم اپنے اس گناہ کے حوالے سے اس طرح ہو گئی ہو جیسے اس دن تھی جب تمہاری والدہ نے تمہیں جنم دیا تھا ، تو اللہ تعالیٰ نے سورت مائدہ میں یہ آیت نازل کی :   """" جو شخص ظلم کرنے کے بعد توبہ کر لے اور اصلاح کر لے تو بے شک اللہ تعالیٰ اس کی توبہ قبول کر لیتا ہے 1111111""""  یہ آیت کے آخر تک ہے ۔   یہ روایت امام احمد نے نقل کی ہے ۔ اس کی سند میں ایک راوی ابن لہیعہ ہے اس کی نقل کردہ حدیث حسن ہے "" اور اس میں ضعف پایا جاتا ہے اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"10661"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : صفوان بن امیہ مدینہ منورہ آئے اور وہ مسجد میں سو گئے انہوں نے اپنی چادر اپنے سر کے نیچے رکھی ایک چور آیا اور اس کو چوری کر لیا وہ اس کو پکڑ کر نبی اکرم ﷽ کے پاس لے آئے نبی اکرم ﷽ نے اس چور کے بارے میں حکم دیا کہ اس کا ہاتھ کاٹ دیا جائے تو صفوان نے کہا : یا رسول اللہ ! یہ چادر اس کی ہوئی نبی اکرم ﷽ نے فرمایا : اس کو میرے پاس لانے سے پہلے تم نے ایسا کیوں نہیں کیا ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی یعقوب بن حمید ہے "" جسے ابن حبان اور دیگر حضرات نے ثقہ قرار دیا ہے امام نسائی اور دیگر حضرات نے اسے ضعیف کہا ہے اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"10662"," حضرت ابوہریرہ رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ کے پاس ایک چور کو لایا گیا لوگوں نے بتایا اس نے چوری کی ہے نبی اکرم ﷽ نے فرمایا : اس کے بارے میں میرا یہ خیال نہیں ہے کہ اس نے چوری کی ہو گی اس نے عرض کی : جی ہاں یا رسول اللہ ! میں نے چوری کی ہے نبی اکرم ﷽ نے فرمایا : اسے لے جاا اور اس کا ہاتھ کاٹ دو پھر اسے داغ لگوا دینا پھر اسے میرے پاس لے کر آنا اسے لے جایا گیا اس کا ہاتھ کاٹ دیا گیا پھر اسے داغ لگوا دیا گیا + تاکہ خون بہنا بند ہو جائے , پھر اسے نبی اکرم ﷽ کے پاس لایا گیا تو نبی اکرم ﷽ نے ارشاد فرمایا : تم اللہ تعالیٰ کی بارگاہ میں توبہ کرو اس نے عرض کی : میں اللہ تعالیٰ کی بارگاہ میں توبہ قبول کرتا ہوں ۔ نبی اکرم ﷽ نے دعا کی : اللہ تعالیٰ تمہاری توبہ قبول کرے + راوی کو شک ہے شاید یہ الفاظ ہیں : , اے اللہ ! تو اس کی توبہ قبول فرما لے """"۔   یہ روایت امام بزار نے اپنے استاد احمد بن ابان قرشی کے حوالے سے نقل کی ہے "" جسے ابن حبان نے ثقہ قرار دیا ہے اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"10663"," محمد حاطب یا شاید محمد بن حارث بیان کرتے ہیں : انہوں نے حضرت عبداللہ بن زبیر رضی اللہ عنہ کا ذکر کرتے ہوئے یہ بات ذکر کی کہ انہیں طویل عرصے سے حکمرانی کی خواہش تھی ۔ راوی کہتے ہیں : میں نے دریافت کیا اس کی وجہ کیا ہے ۔ انہوں نے فرمایا : ایک مرتبہ نبی اکرم ﷽ کی بارگاہ میں ایک چور کو لایا گیا آپ نے اس کو قتل کرنے کا حکم دیا عرض کی گئی : اس نے چوری کی ہے نبی اکرم ﷽ نے فرمایا : اس کا ہاتھ کاٹ دو پھر اس چور کو اس کے بعد حضرت ابوبکر رضی اللہ عنہ کے پاس لایا گیا اس کے تمام اعضا کاٹے جا چکے تھے "" تو حضرت ابوبکر رضی اللہ عنہ نے فرمایا : تمہارے لئے مجھے کوئی چیز نہیں ملتی صرف وہ چیز ملتی ہے جو نبی اکرم ﷽ نے تمہارے بارے میں اس دن فیصلہ دیا تھا جب آپ نے تمہیں قتل کرنے کا حکم دیا تھا "" کیونکہ نبی اکرم ﷽ تمہارے بارے میں زیادہ بہتر جانتے تھے پھر حضرت ابوبکر رضی اللہ عنہ نے مہاجرین کے بیٹوں میں سے تعلق رکھنے والے کچھ نو جوانوں کو اس کو قتل کرنے کا حکم دیا میں ان لوگوں میں شامل تھا حضرت عبداللہ بن زبیر رضی اللہ عنہ نے ان لوگوں سے کہا : تم اپنے پر مجھے امیر بنا دو تو ہم نے انہیں اپنے پر امیر بنا لیا پھر اس چور کو لے کر بقیع کی طرف گئے اور ہم نے اسے قتل کر دیا ۔   یہ روایت امام ابویعلیٰ نے نقل کی ہے "" اور اس کے رجال ثقہ ہیں البتہ میں نے یوسف بن یعقوب کے صحابہ کرام میں سے کسی سے سماع کی روایت نہیں پائی ہے 1"
"10664"," حضرت زید بن خالد جہنی رضی اللہ عنہ بیان کرتے ہیں : انہوں نے نبی اکرم ﷽ کو اچک لینے اور لوٹ لینے سے منع کرتے ہوئے سنا ہے ۔   یہ روایت امام احمد اور امام طبرانی نے نقل کی ہے ۔"
"10665","وَعَنْ عَبْدِ اللَّهِ بْنِ قُرْطٍ قَالَ: أَزْحَفُ عَلَى بَعِيرٍ لِي، وَأَنَا مَعَ خَالِدِ بْنِ الْوَلِيدِ، فَأَرَدْتُ أَنْ أَتْرُكَهُ فَدَعَوْتُ اللَّهَ فَأَقَامَهُ لِي فَرَكِبْتُ.\nرَوَاهُ الطَّبَرَانِيُّ، وَإِسْنَادُهُ جَيِّدٌ."
"10666"," حضرت شرحبیل بن اوس رضی اللہ عنہ جو صحابہ کرام میں سے ہیں وہ بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" جو شخص شراب پیئے اسے کوڑے لگاا اگر وہ دوبارہ پیئے تو اسے دوبارہ لگاا اگر وہ پھر پیئے تو اسے قتل کر دو """"۔   یہ روایت امام احمد اور امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی عمران بن محمد ہے "" اور اسے مخبر کہا جاتا ہے میں اس سے واقف نہیں ہوں اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"10667"," یزید بن ابوکبشہ بیان کرتے ہیں : انہوں نے صحابہ کرام کے طبقے سے تعلق رکھنے والے ایک صحابی کو "" عبدالملک بن مروان کو شراب نوشی کے بارے میں یہ حدیث بیان کرتے ہوئے سنا : نبی اکرم ﷽ نے شراب کے بارے میں یہ ارشاد فرمایا ہے :"""" اگر آدمی اسے پی لے تو اسے کوڑے لگاا پھر اگر وہ دوبارہ ایسا کرے تو اسے کوڑے لگاا "" اگر وہ پھر دوبارہ ایسا کرے تو اسے کوڑے لگاا ، پھر اگر وہ چوتھی مرتبہ پھر ایسا کرے تو اسے قتل کر دو """"۔ یہ روایت امام احمد نے نقل کی ہے یزید بن ابوکبشہ کو ابن حبان نے ثقہ قرار دیا ہے اس روایت کے بقیہ رجال صحیح کے رجال ہیں 1"
"10668"," حضرت جریر بن عبداللي رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" جو شخص شراب پیئے اسے کوڑے لگاا پھر اگر وہ دوبارہ ایسے کرے تو اسے کوڑے لگاا "" اگر وہ پھر ایسا کرے تو اسے کوڑے لگاا پھر اگر وہ چوتھی مرتبہ ایسا کرے تو اسے قتل کر دو """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی دااد بن یزیداادی ہے "" اور وہ ضعیف ہے 1"
"10669"," حضرت شرید رضی اللہ عنہ بیان کرتے ہیں : میں نے نبی اکرم ﷽ کو یہ ارشاد فرماتے ہوئے سنا ہے :   """" جب تم میں سے کوئی ایک شخص شراب پی لے تو تم اس کی پٹائی کرو پھر اگر وہ ایسا کرے تو تم اس کی پٹائی کرو پھر اگر وہ ایسا کرے تو تم اس کی پٹائی کرو پھر اگر وہ چوتھی مرتبہ ایسا کرے تو اسے قتل کر دو """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی عبداللہ بن عتبہ بن عروہ بن مسعود ثقفی ہے "" اور میں اس سے واقف نہیں ہوں اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"10670","عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ، عَنِ النَّبِيِّ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - قَالَ: «إِذَا تَخَوَّفَ أَحَدُكُمْ سُلْطَانًا فَلْيَقُلِ: اللَّهُمَّ رَبَّ السَّمَاوَاتِ السَّبْعِ وَرَبَّ الْعَرْشِ الْعَظِيمِ، كُنْ لِي جَارًا مِنْ شَرِّ فُلَانِ بْنِ فُلَانٍ - يَعْنِي الَّذِي يُرِيدُ - وَشَرِّ الْجِنِّ وَالْإِنْسِ وَأَتْبَاعِهِمْ، أَنْ يُفْرِطَ عَلَيَّ أَحَدٌ مِنْهُمْ، عَزَّ جَارُكَ، وَجَلَّ ثَنَاؤُكَ، وَلَا إِلَهَ غَيْرُكَ».\nرَوَاهُ الطَّبَرَانِيُّ، وَرِجَالُهُ رِجَالُ الصَّحِيحِ غَيْرَ جُنَادَةَ بْنِ سَلْمٍ، وَقَدْ وَثَّقَهُ ابْنُ حِبَّانَ، وَضَعَّفَهُ غَيْرُهُ.\nقُلْتُ: وَقَدْ تَقَدَّمَ فِي الْأَذْكَارِ هَذَا الْحَدِيثُ وَغَيْرُهُ."
"10671"," حضرت غضیف بن حارث رضی اللہ عنہ بیان کرتے ہیں : میں نے نبی اکرم ﷽ کو یہ ارشاد فرماتے ہوئے سنا ہے :   """" جب کوئی شخص شراب پیئے تو اسے کوڑے لگاا پھر اگر وہ ایسا کرے تو اسے کوڑے لگاا پھر اگر وہ ایسا کرے تو اسے  کوڑے لگاا پھر اگر وہ ایسا کرے تو اسے قتل کر دو """"۔   یہ روایت امام طبرانی اور امام بزار نے نقل کی ہے اس کے بقیہ رجال ثقہ ہیں ۔"
"10672"," سیدہ ام حبیبہ بنت ابوسفیان رضی اللہ عنہا بیان کرتی ہیں : یمن سے تعلق رکھنے والے کچھ لوگ نبی اکرم ﷽ کی خدمت میں حاضر ہوئے ۔ نبی اکرم ﷽ نے انہیں نماز سنتوں اور فرائض کی تعلیم دی پھر ان لوگوں نے عرض کی : یا رسول اللہ ! ہمارا ایک مشروب ہے "" جسے ہم گندم اور جو سے بناتے ہیں نبی اکرم ﷽ نے دریافت کیا : کیا غبیراء انہوں نے عرض کی : جی ہاں نبی اکرم ﷽ نے فرمایا : تم اسے استعمال نہ کرو پھر ان لوگوں نے جانے کا ارادہ کیا تو انہوں نے نبی اکرم ﷽ سے اس بارے میں سوال کیا تو نبی اکرم ﷽ نے فرمایا : کیا غبیراء انہوں نے عرض کی : جی ہاں ! تو نبی اکرم ﷽ نے فرمایا : تم اسے نہ کھاا لوگوں نے کہا : لوگ اسے نہیں چھوڑیں گے نبی اکرم ﷽ نے فرمایا : جو اس کو نہیں چھوڑے گا ۔ تم اس کی گردن اڑا دینا ۔   یہ روایت امام احمد امام ابویعلیٰ اور امام طبرانی نے نقل کی ہے اس کی سند میں ایک راوی ابن لہیعہ ہے اس کی نقل کردہ حدیث حسن ہے "" اور اس میں ضعف پایا جاتا ہے امام احمد کے بقیہ رجال ثقہ ہیں ۔"
"10673"," حضرت عبداللہ بن عمر رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ کے پاس نشے کے شکار شخص کو لایا گیا تو آپ نے اسے  حد کے طور پر کوڑے لگوائے ۔ "
"10674"," یہی روایت امام ابویعلیٰ نے نقل کی ہے "" اور انہوں نے یہ الفاظ زائد نقل کیے ہیں ، پھر نبی اکرم ﷽ نے دریافت کیا :   """" تمہارا مشروب کیا ہے آ‟ ۔ انہوں نے عرض کی : کشمش اور کھجور ۔"
"10675"," حضرت جابر بن عبداللہ رضی اللہ عنہما نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :"""" جو شخص شراب پیئے اسے کوڑے مارو اگر وہ پھر پیئے تو اسے کوڑے مارو اگر وہ پھر پیئے تو اسے کوڑے مارو اگر وہ چوتھی مرتبہ پیئے تو اسے قتل کر دو """"۔  راوی بیان کرتے ہیں : پھر نعیمان نامی صاحب کو لایا گیا جنہوں نے چوتھی مرتبہ شراب پی تھی ، تو نبی اکرم ﷽ نے انہیں کوڑے لگوائے انہیں قتل نہیں کیا تو یہ حکم قتل کے حکم کا ناسخ ہو گا ۔ "
"10676"," عبدالرحمن کے والد حضرت ازہر رضی اللہ عنہ بیان کرتے ہیں :   نبی اکرم ﷽ کے پاس ایک شرابی کو لایا گیا آپ اس وقت خیبر میں تھے نبی اکرم ﷽ نے اس کے چہرے پر مٹی ڈالی پھر آپ نے اپنے اصحاب کو حکم دیا تو انہوں نے اپنے جوتوں اور اپنے ہاتھ میں موجود چیزوں کے ذریعے اس کی پٹائی کی یہاں تک کہ نبی اکرم ﷽ نے ان لوگوں سے فرمایا : اب ہاتھ کھینچ لو ان لوگوں نے ہاتھ اٹھا لئے نبی اکرم ﷽ کا وصال ہو گیا اس وقت تک یہی طریقہ کار رہا پھر حضرت ابوبکر رضی اللہ عنہ نے شراب نوشی کے لئے چالیس کوڑے لگوائے پھر حضرت عمر رضی اللہ عنہ نے اپنی خلافت کے ابتدائی دور میں چالیس کوڑے لگوائے پھر انہوں نے اپنے عہد خلافت کے آخری دور میں اسی کوڑے لگوائے پھر حضرت عثمان رضی اللہ عنہ نے چالیس کوڑے لگوائے پھر حضرت معاویہ رضی اللہ عنہ نے اسی کوڑے لگوائے ۔   یہ روایت امام طبرانی نے ابوطاہر بن سرح کی نقل کردہ روایت کے طور پر نقل کی ہے وہ بیان کرتے ہیں : میں نے اپنے ماموں کی تحریر میں یہ بات پائی ہے کہ یہ عقیل نامی راوی سے منقول ہے ان کے ماموں کا نام عبدالرحمن بن عبدالحمید بن سالم ہے ""  اور وہ ثقہ ہیں اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"10677"," حضرت عبداللہ بن عمرو رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" جو شخص تھوڑی سی شراب پی لے اسے اسی کوڑے لگاا """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی حمید بن کریب ہے "" اور میں اس سے واقف نہیں ہوں ۔"
"10678","وَعَنْ عَائِشَةَ قَالَتْ: قَالَ النَّبِيُّ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: «هَلَكَ الْمُقَذِّرُونَ»، قُلْتُ: ذَكَرَ صَاحِبُ النِّهَايَةِ أَنَّهُمُ الَّذِينَ يَأْتُونَ الْقَاذُورَاتِ مِنَ الذُّنُوبِ.\nرَوَاهُ الطَّبَرَانِيُّ فِي الْأَوْسَطِ، وَفِيهِ عَبْدُ اللَّهِ بْنُ سَعِيدٍ الْمَقْبُرِيُّ، وَهُوَ ضَعِيفٌ."
"10679"," امام ابوجعفر + شاید امام باقر مراد ہیں : , بیان کرتے ہیں : حضرت علی رضی اللہ عنہ نے قریش سے تعلق رکھنے والے ایک شخص کو شراب نوشی کے جرم میں چالیس کوڑے لگوائے تھے جس + کوڑے , کے دو اطراف تھے ۔ "
"10680"," حضرت بریدہ رضی اللہ عنہ بیان کرتے ہیں : حضرت ماعز بن مالک رضی اللہ عنہ نبی اکرم ﷽ کے پاس آئے نبی اکرم ﷽ نے انہیں واپس کر دیا پھر آپ نے ارشاد فرمایا : † اسے سونگھ کے دیکھو """"۔ لوگوں نے انہیں سونگھ کر دیکھا پھر انہیں سنگسار کر دیا گیا ۔   یہ روایت امام بزار نے نقل کی ہے "" اور اس کے رجال صحیح کے رجال ہیں ۔"
"10681"," ابو ماجد حنفی بیان کرتے ہیں : ایک شخص اپنے بھتیجے کو لے کر حضرت عبداللہ رضی اللہ عنہ کے پاس آیا وہ بھتیجا نشے کی حالت میں تھا اس شخص نے بتایا میں نے اسے نشے کے عالم میں پایا ہے حضرت عبداللہ رضی اللہ عنہ نے فرمایا : اسے ہلاا جلاا اسے جھنجوڑو اور اسے سونگھو لوگوں نے اسے ہلایا جلایا اور اس کو سونگھا تو اس میں سے شراب کی بو آئی حضرت عبداللہ رضی اللہ عنہ نے اس لڑکے بارے میں حکم دیا کہ اسے قید کر دیا جائے اگلے دن اسے باہر نکالا گیا پھر حضرت عبداللہ رضی اللہ عنہ نے حکم دیا کہ ایک چھڑی تیار کی جائے اس کا پھل اتار لیا گیا یہاں تک کہ وہ صاف ہو گئی ، پھر انہوں نے جلاد سے کہا : تم کوڑے لگاا اور اپنے ہاتھ کو کھینچنا اور ہر عضو کو اس کا حق دینا تو اس نے اسے ایسے ضرب لگائی کہ جو تکلیف دہ ہو لیکن نشان نہ ڈالے اور یہ سزا اس لڑکے کو لباس میں دی گئی اس نے قبا اور شلوار پہنی ہوئی تھی یا قمیص یا شلوار پہنی ہوئی تھی 11111111 اس کے بعد راوی نے پوری حدیث ذکر کی ہے جو اس سے پہلے چوری کی حد سے متعلق باب میں گزر چکی ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے "" اور ابوماجد نامی راوی ضعیف ہے ۔"
"10682"," حضرت حذیفہ رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں : پاک دامن عورت پر زنا کا جھوٹا الزام لگانا ایک سو سال کے عمل کو منہدم کر دیتا ہے """"۔   یہ روایت امام طبرانی اور امام بزار نے نقل کی ہے ۔ اس کی سند میں ایک راوی لیث بن ابوسلیم ہے "" اور اس کی نقل کردہ حدیث کو حسن قرار دیا گیا ہے اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"10683"," حضرت ابوالیسر رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے سیدہ عائشہ رضی اللہ عنہا سے فرمایا : اے عائشہ ! بے شک اللہ تعالیٰ نے تمہاری بے گناہی کے بارے حکم نازل کر دیا ہے "" تو سیدہ عائشہ رضی اللہ عنہا نے کہا : میں اللہ تعالیٰ کی حمد بیان کرتی ہوں آپ کی تعریف نہیں کرتی نبی اکرم ﷽ سیدہ عائشہ رضی اللہ عنہا کے پاس سے نکلے آپ نے عبداللہ بن ابی کو پیغام بھیج کر بلوایا اور اس کو دو حدوں کی سزا دی پھر آپ نے مسطح نامی صاحب اور حمنہ نامی خاتون کو پیغام بھیج کر بلوایا اور ان کی بھی پٹائی کروائی ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی اسماعیل بن یحیی تیمی ہے "" اور وہ کذاب ہے ۔"
"10684"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ نے انہیں اسی اسی کوڑے لگوائے تھے ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی محمد بن سائب کلبی ہے "" اور وہ کذاب ہے ۔  سیدہ عائشہ رضی اللہ عنہا کے مناقب سے متعلق باب میں حضرت عبداللہ بن عباس رضی اللہ عنہما سے منقول حدیث آئے گی جس میں یہ مذکور ہو گا کہ قیامت کے دن بھی انہیں کوڑے لگیں گے ۔"
"10685"," حضرت عبداللہ بن عمرو رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے لعان کرنے والے میاں بیوی کی اولاد کے بارے میں یہ فیصلہ دیا ہے کہ وہ بچہ اپنی ماں کا وارث بنے گا اور اس کی ماں اس کی وارث بنے گی اور جو شخص اس عورت پر زنا کا الزام لگائے گا اسے اسی کوڑے لگائے جائیں گے اور جو شخص اس کے بیٹے کو زنا کے نتیجے میں پیدا ہونے کے طور پر بلائے گا اسے بھی اسی کوڑے لگائے جائیں گے ۔   یہ روایت امام احمد نے ابن اسحاق کے حوالے سے نقل کی ہے "" اور یہ بات بیان کی ہے کہ عمرو بن شعیب نے یہ بات ذکر کی ہے اگر تو اس میں سماع کی صراحت ہے "" تو اس کے رجال ثقہ ہیں ورنہ یہ ابن اسحاق کی عنعنہ کے طور پر نقل کردہ روایت ہو گی اور وہ راوی مدلس ہے اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"10686"," قاسم بیان کرتے ہیں : حضرت عبداللہ بن مسعود رضی اللہ عنہ نے فرمایا : دو میں سے کسی ایک صورت میں حد ہو سکتی ہے یہ کہ تم کسی پاک دامن عورت پر زنا کا الزام لگا دو یا کسی شخص کی اس کے باپ سے نسبت کا انکار کر دو ۔   یہ روایت امام طبرانی نے نقل کی ہے قاسم نامی راوی نے اپنے دادا حضرت عبداللہ رضی اللہ عنہ سے سماع نہیں کیا ہے "" تاہم اس روایت کے رجال ثقہ ہیں ۔"
"10687"," ابوعثمان نہدی بیان کرتے ہیں : حضرت ابوبکرہ رضی اللہ عنہ حضرت نافع رضی اللہ عنہ حضرت شبل بن معبد رضی اللہ عنہ نے حضرت مغیرہ بن شعبہ رضی اللہ عنہ کے خلاف یہ گواہی دی کہ انہوں نے حضرت مغیرہ رضی اللہ عنہ کو دیکھا اور یوں دیکھا کہ جس طرح کو سلائی سرمہ دانی میں ڈالی جاتی ہے پھر زیاد آئے "" تو حضرت عمر رضی اللہ عنہ نے کہا : ایک ایسا شخص آیا ہے جو صرف حق کے مطابق گواہی دے گا "" تو اس نے کہا : میں نے ایک ایسا منظر دیکھا جو قبیح اور قابل مذمت تھا ۔ راوی کہتے ہیں : تو حضرت عمر رضی اللہ عنہ نے ان لوگوں کو حد کے طور پر کوڑے لگوائے ۔   یہ روایت امام طبرانی نے نقل کی ہے "" اور اس کے رجال صحیح کے رجال ہیں ۔"
"10688","وَعَنْ عَمَّارِ بْنِ يَاسِرٍ: «أَنَّ رَجُلًا مَرَّتْ بِهِ امْرَأَةٌ فَأَحْدَقَ بَصَرَهُ إِلَيْهَا، فَمَرَّ بِجِدَارٍ فَمَرَسَ وَجْهُهُ، فَأَتَى رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - وَوَجْهُهُ يُسِيلُ دَمًا، فَقَالَ: يَا رَسُولَ اللَّهِ، إِنِّي فَعَلْتُ كَذَا وَكَذَا، فَقَالَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: """" إِذَا أَرَادَ اللَّهُ بِعَبْدٍ خَيْرًا عَجَّلَ عُقُوبَةَ ذَنْبِهِ فِي الدُّنْيَا، وَإِذَا أَرَادَ بِهِ غَيْرَ ذَلِكَ أَمْهَلَ عَلَيْهِ بِذُنُوبِهِ حَتَّى يُوَافَى بِهَا يَوْمَ الْقِيَامَةِ، كَأَنَّهُ عِيرٌ».\nرَوَاهُ الطَّبَرَانِيُّ، وَإِسْنَادُهُ جَيِّدٌ."
"10689"," حضرت عبداللہ بن عمر رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ کی زوجہ محترمہ سیدہ حفصہ رضی اللہ عنہا کی کنیز نے ان پر جادو کر دیا پھر اس نے اپنے بارے میں اس چیز کا اعتراف بھی کر لیا تو سیدہ حفصہ رضی اللہ عنہا نے عبدالرحمن بن یزید کو حکم دیا تو انہوں نے اس کنیز کو قتل کر دیا حضرت عثمان غنی رضی اللہ عنہ اس حوالے سے سیدہ حفصہ رضی اللہ عنہا پر اعتراض کیا تو حضرت عبداللہ رضی اللہ عنہ ان کے پاس آئے اور انہوں نے بتایا کہ اس کنیز نے ان پر جادو کیا تھا اور اس کا اعتراف بھی کر لیا تھا + راوی بیان کرتے ہیں : , یوں لگتا ہے کہ حضرت عثمان غنی رضی اللہ عنہ نے اس حوالے سے اعتراض کیا تھا کہ انہوں نے حاکم وقت کے بغیر خود ایسا کیا تھا + یعنی اسے سزا دے دی"
"10690"," حضرت زید بن ارقم رضی اللہ عنہ بیان کرتے ہیں : ایک شخص نبی اکرم ﷽ کے پاس آیا اس نے نبی اکرم ﷽ کے لئے گرہ لگائی اور اس گرہ والی چیز کو انصار سے تعلق رکھنے والے ایک شخص کے کنویں میں ڈال دیا + یعنی نبی اکرم ﷽ پر جادو کر دیا , دو فرشتے نبی اکرم ﷽ کی عیادت کرنے کے لئے آئے ان میں سے ایک آپ کے سرہانے کی طرف بیٹھ گیا اور دوسرا پائنتی کی طرف بیٹھ گیا ان میں سے ایک نے کہا : کیا تم جانتے ہو کہ انہیں کیا تکلیف ہے دوسرے نے بتایا کہ فلاں شخص ان کے پاس آیا اور اس نے ان کے لئے گرہ لگائی اور اس چیز کو فلاں انصاری کے کنویں میں ڈال دیا + یعنی ان پر جادو کر دیا , اگر یہ اس کنویں کی طرف کسی کو بھیجیں تو وہ شخص وہاں کے پانی کو زرد پائے گا ۔ راوی کہتے ہیں : نبی اکرم ﷽ نے ایک شخص کو بھیجا اس نے گرہوں والی چیز کو لیا اور اسے کھول دیا تو نبی اکرم ﷽ ٹھیک ہو گئے اس کے بعد بھی وہ + جادو کرنے والا , شخص نبی اکرم ﷽ کے پاس آتا رہا لیکن نبی اکرم ﷽ نے اس کے سامنے اس حوالے سے کوئی بات ذکر نہیں کی اور اسے کوئی سزا نہیں دی 1"
"10691"," ایک روایت میں یہ الفاظ ہیں : راوی بیان کرتے ہیں : یہودیوں سے تعلق رکھنے والے ایک شخص نے نبی اکرم ﷽ پر جادو کر دیا آپ اس کی وجہ سے کچھ دن بیمار رہے حضرت جبرائیل علیہ السلام آپ کے پاس آئے اور بولے : یہودیوں سے تعلق رکھنے والے ایک شخص نے آپ پر جادو کیا ہے "" اور اس نے آپ کے لئے گرہیں لگائی ہیں نبی اکرم ﷽ نے حضرت علی رضی اللہ عنہ کو اس کی طرف بھیجا انہوں نے اس چیز کو نکالا تو وہ جیسے جیسے گرہ کھولتے گئے نبی اکرم ﷽ کی طبیعت میں بہتری ہوتی گئی 11111111 اس کے بعد راوی نے حسب سابق روایت ذکر کی ہے ۔ "
"10692"," حضرت نعمان بن بشیر رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" جو شخص حد کے علاوہ کسی اور جرم میں حد جتنے کوڑے لگائے وہ زیادتی کرنے والوں میں سے ہو گا """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی محمد بن حسین فضاض ہے "" اور ایک راوی ولید بن عثمان ہے  جو مسعر کا ماموں ہے میں ان دونوں سے واقف نہیں ہوں اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"10693"," حضرت سعد رضی اللہ عنہ بیان کرتے ہیں : ایک مرتبہ ہم نبی اکرم ﷽ کے ساتھ سفر کر رہے تھے "" ہمارے ساتھ کچھ کھجوریں تھیں صفوان نے مجھ سے کہا یہ کھجوریں مجھے کھانے کے لئے دو تو حضرت سعد رضی اللہ عنہ نے کہا یہ تھوڑی کھجوریں ہیں اور مجھے اس بات کا بھی اندیشہ ہے کہ یہ لوگوں کے لیے منگوائی جائیں گی "" جب وہ لوگ پڑاا کریں گے تو ان کے ساتھ تم بھی کھا لینا "" انہوں نے کہا : تم مجھے کھانے کے لئے دو کیونکہ بھوک مجھے ہلاک کر دے گی ان کی یہ حالت ہو چکی تھی لیکن میں نے اس حوالے سے ان کی بات کا انکار کر دیا میں اس سواری کو پہچانتا تھا "" جس میں کھجوریں موجود تھیں نبی اکرم ﷽ کو اس بات کی اطلاع ملی تو آپ نے فرمایا : تم لوگ صفوان سے کہو کہ وہ جائے اس دن حضرت صفوان رضی اللہ عنہ نبی اکرم ﷽ کے مختلف اصحاب کے پاس جاتے رہے پھر وہ حضرت علی رضی اللہ عنہ کے پاس بھی آئے اور انہوں نے کہا : میں کہاں جااں کیا کفر کی طرف جااں آ حضرت علی رضی اللہ عنہ نبی اکرم ﷽ کی خدمت میں حاضر ہوئے اور اس بارے میں آپ کو بتایا تو نبی اکرم ﷽ نے فرمایا : تم لوگ صفوان سے یہ کہو کہ وہ ساتھ شامل ہو جائے ۔   یہ روایت امام طبرانی نے نقل کی ہے "" اور اس کے رجال ثقہ ہیں ۔"
"10694"," حضرت عبداللہ بن مسعود رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" سخی شخص کی زیادتی سے درگزر کرو کیونکہ اللہ تعالیٰ اس کی لغزش کے وقت اس کا ہاتھ تھام لیتا ہے """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے "" اور اس کی سند میں ایک راوی بشر بن عبداللہ دارسی ہے "" اور وہ ضعیف ہے ۔"
"10695"," حضرت عبداللہ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :"""" صاحب حیثیت لوگوں کی لغزشوں کو لوٹا دو + یعنی انہیں معاف کر دو , """"۔   روایت امام طبرانی نے محمد بن عاصم کے حوالے سے عبداللہ بن محمد بن یزید رفاعی سے نقل کی ہے "" اور میں ان دونوں سے  واقف نہیں ہوں اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"10696","شریف اور نیک لوگوں کی غلطیوں پر نظر اندازی کرو، سواۓ اللہ کی حدوں میں سے کسی حد کے معاملے میں۔"
"10697"," حضرت عبداللہ بن عباس رضی اللہ عنہما روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" سخی کی غلطی سے الگ رہو کیونکہ جب کبھی وہ لغزش کرتا ہے اللہ تعالیٰ اس کا ہاتھ تھام لیتا ہے """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے "" اور اس کی سند میں راویوں کی ایک جماعت ایسی ہے جن سے میں واقف نہیں ہوں ۔"
"10698","وَعَنْ عَبْدِ اللَّهِ - يَعْنِي ابْنَ مَسْعُودٍ - قَالَ: لَا تَعْجَلُوا بِمَدْحِ النَّاسِ وَلَا بِذَمِّهِمْ ; فَإِنَّكَ أَوْ لَعَلَّكَ أَنْ تَرَى مِنْ أَخِيكَ شَيْئًا الْيَوْمَ يُعْجِبُكَ لَعَلَّهُ أَنْ يَسُوءَكَ غَدًا، وَلَعَلَّكَ أَنْ تَرَى مِنْهُ الْيَوْمَ شَيْئًا يَسُوءُكَ لَعَلَّهُ يُعْجِبُكَ غَدًا، وَإِنَّ النَّاسَ يَغْتَرُّونَ، وَإِنَّمَا يَغْفِرُ اللَّهُ الذُّنُوبَ يَوْمَ الْقِيَامَةِ، وَاللَّهُ أَرْحَمُ بِعَبْدِهِ يَوْمَ يَلْقَاهُ مِنْ أُمِّ وَاحِدٍ فَرَشَتْ لَهُ بِأَرْضِ فَيْءٍ ثُمَّ لَمَسَتْ، فَإِنْ كَانَتْ شَوْكَةٌ كَانَتْ بِهَا قَبْلَهُ، وَإِنْ كَانَتْ لَدْغَةٌ كَانَتْ بِهَا قَبْلَهُ.\nرَوَاهُ الطَّبَرَانِيُّ، وَإِسْنَادُهُ مُنْقَطِعٌ. قُلْتُ: وَتَأْتِي أَحَادِيثُ فِي بَابِ الِاسْتِغْفَارِ لِأَهْلِ الْكَبَائِرِ."
"10699","شریف لوگوں کی غلطیوں کو معاف کر دو۔"
"10700"," حضرت جبیر بن مطعم رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :   """" مساجد میں حدود قائم نہ کی جائیں """"۔   یہ روایت امام بزار نے نقل کی ہے ۔ اس کی سند میں ایک راوی واقدی ہے "" اور وہ اپنی تدلیس کی وجہ سے ضعیف ہے اس نے  سماع کی صراحت کی ہے "" اور اس نے تحدیث کی بھی صراحت کی ہے ۔"
