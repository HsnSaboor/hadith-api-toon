hadiths[9]{hadithnumber,text}:
"1245","%أذعشحأخؼهثۄأثىأصۄزوأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأضؼۏزأثىأؼتظأڬەأۄوشتۄأغثشضحتىأوۏڽأحہەأ؏أتىۄًڽأىەألشوتۏتأ=أحوأوۏڽأضەأڬضأطرظأىەأشضًهأتههۄأ﷽أڬەأۄوشتۄأظهًۆأتهرًلأځڔہۏأۄەأآأحًأذعشحأذسۏلۄأشعۏأتههۄأؼىۄأڬہڔەأۄًأڲةەأۗأهًڲًڽأىەأتۏڬأظلأتىأڬەأځۏډہەأثىتةۏأتًشأتۏڬأظلأزطوىأڬەأومتثهەأوۏڽأڬہڔۏأشۄۏأ؏أتىۄًڽأىەأتځىەأځۏډہەأڬہڔەأۄًاڽأڬًأتۏڬأشڬؼحأځڔہتةۏأ؏أځہشأۏۄأىوتصأډہًڔأڬشأتىأڬۏأدۄأځشأدتأڬشأڬہڔەأۄًأڲةەأتًشأًۄأتىأڬەأځۏډہەأإأڲةەأ؏أإځأىەأتىأڬًأثہۏأتۏڬأشڬؼحأځڔہتةۏأتًشأڬضۏأىەأثہۏأ+أتوتوأڬەأځۏډہەأځًشۏأ"
"1246",""" حضرت ابن عباس رضی اللہ عنہما فرماتے ہیں : رسول اللہ ﷺ نے ذی قرد میں صلوۃ الخوف کی ایک ایک رکعت پڑھائی ۔ اور لوگوں نے نماز قضا نہیں کی ۔\n ٭٭ یہ ھدیث صحیح الاسناد ہے اور یہ گزشتہ حدیث کی شاہد ہے ۔"" \nالمستدرك على الصحيحين حدیث: 1246 عربی حدیث: 1246"
"1247","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأسۏأمشزأوۏڽأ+أتضأغشۏمەأضەأ"
"1248","%أذعشحأضهوۄأثىأتڬًؼأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتىۄًڽأىەأشضًهأتههۄأ﷽أضەأۏۄًزۏًڽأڬەأؼثتزحأرتىەأوۏڽأىوتصأځڔہىەأڬەأوحؼهمأځًډہتأحًأإځأ﷽أىەألشوتۏتأ=أًۄتڽأىوتصأځڔہأهًأتًشأدًأ+أثحأًؽۏشۄأ"
"1249","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄأشضًهأتههۄأ﷽أڬۏأىوتصأرًلأڬەأوحؼهمأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أڬہڔەأۄًةەأحًأتۏڬأدوتؼحأإځأڬەأځۏډہەأڬہڔۏأۄًةۏأۗأتًشأتۏڬأدوتؼحأتىأڬەأځۏډہەأثۏټہأڲةۏأ؏أتىأضثأڬەأډۄشەأشضًهأتههۄأ﷽أڬۏأغشلأحہەأ؏أشضًهأتههۄأ﷽أىەأحڬثۏشأڬۄۏأ=أحًأزًىًأدوتؼحًڽأىەأحڬثۏشأڬۄۏأۗأځہشأإځأ﷽أىەأشڬًؼأڬۏتأحًأدًأدوتؼحأإځأ﷽أڬەأځۏډہەأحہۏأ؏أتىۄًڽأىەأشڬًؼأڬشأهۏتأتًشأدًأتىأڬەأثہۏأځۏډہەأحہەأ؏أًۄأثۏټہەأشۄەأ؏أځہشأشضًهأتههۄأ﷽أىەأضدزۄأڬۏتأحًأإځأ﷽أڬەأځۏډہەأًتهًڽأىەأثہۏأضدزۄأڬۏتأۗأتًشأتىأڬەأځۏډہەأًتهەأثۏټہەأشۄەأځہشأإځأ﷽أڬہڔەأۄًةەأتًشأإځأ﷽أڬەأځۏډہەأًتهەأثہۏأڬہڔەأۄًأڲةەأۗأځہشأۏۄأهًڲأځۏډہەأڬہضڬحەأۄًةەأتىأهًڲًڽأڬۏأظلأحڬأډهەأڲةەأدًأثۏټہەأۄًةەأحہەأتًشأًۄأزًضشۏأدوتؼحأ+أدًأځۄهەأثۏټہۏأشۄۏأتىۄًڽأ"
"1250","%أتوأتهوًوىۏىأضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أىەأظهًۆأتهرًلأځڔہتةۏأ؏أإځألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أىەأظذتثۄأشعۏأتههۄأؼىۄوأڬًأزًأذظًڽأوۏڽأحمضۏوأڬشأزۏتأ؏أتىأوۏڽأضەأتۏڬأدوتؼحأإځأ﷽أڬەأځۏډہەأڬہڔۏأۄًأڲةۏأتًشأزًضشۏأزطوىأڬەأإڲەأڬہڔۏأۄًأڲةۏأ؏أتوأتهوًوىۏىأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أىەأحڬثۏشأڬۄۏأحًأإځأ﷽أڬەأۄوشتۄأتضأدوتؼحأىەأثہۏأحڬثۏشأڬۄۏأدًأإځأ﷽أڬەأځۏډہەأظلأثضحۄأحہەأځہشأإځأ﷽أىەأشڬًؼأڬۏتأ؏أتىۄًڽأىەأثہۏأشڬًؼأڬۏتأځہشأإځأ﷽أىەأضدزۄأڬۏتأ؏أتىۄًڽأىەأثہۏأضدزۄأڬۏتأځہشأإځأ﷽أىەأضشأتټہتۏتأتىۄًڽأىەأثہۏأضحأتټہتأهۏتأځہشأشضًهأتههۄأ﷽أثۏټہأڲةەأتًشأتىۄًڽأىەأزًضشتأضدزۄأرًزأۄۏأڬۏتأځہشأًۄأهًڲأڬہڔەأۄًةەأتًشأتځىۏأتۏڔۏًڽأڬەأثهأتهټەأځتاڽأډهحەأۄًةەأځۏډہەأهًټأڲةەأ؏أۏۄتڽأحڬأڬۄأۏۄأهًڲأزًضشەأظذتثۄأشعۏأتههۄأؼىۄوأضەأځۏډہەأدتأڬشأڬہڔەأۄًأڲةەأ؏أځہشأزًضشۏأدوتؼحأإةۏأتًشأتىۄًڽأىەأشضًهأتههۄأ﷽أڬەأځۏډہەأظلأثىتةۏأځہشأتىۄًڽأىەأحڬثۏشأڬۄۏأځہشأرًزأۄۏأضدزۄأڬۏتأ؏أځہشأشضًهأتههۄأ﷽أىەأزًضشتأضدزۄأڬۏتأ؏أحًأتىۄًڽأىەأثہۏأإځأڬەأۄوشتۄأضدزۄأڬۏتأ؏أځہشأشضًهأتههۄأ﷽أ+أتڲهۏأ"
"1251","%أذعشحأتثًثڬشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأڬًأىوتصأرًلأڬەأغًشأځشأوؽشثأڬۏأىوتصأڬۏأحۏىأشڬؼحۏڽأځڔہتةۏڽأ؏أۏۄأهًڲأىوتصأضەألتشؽأۄًةەأ+أتًشأډهەأڲةەأ"
"1252","%أذعشحأتثًؼۏتطأتهصشمۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأشضًهأتههۄأ﷽أڬەأۄوشتۄأؼضلتىأوۏڽأحہەأتًشأوطشڬًڽأڬەأضځۄأضتهتشأرتهزأثىأًهۏزأحہەأ؏أۄوأىەأىوتصأػۄشأتزتأڬۏأ؏أوطشڬًڽأىەأځشًڲشتوأثىتۏتأڬۄأۄوتشەأځتضأثۄحأتډہتأوًمؼأۄەأڬۄأوضهوتىأىوتصأوۏڽأ+أدىڲأڬۏأغشلأ"
"1253","%أوشًتىأثىأذڬوأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأ؏أتىۄًڽأىەأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأضەأځًډہتأ=أإځأىەأ+أڬثہۏأ"
