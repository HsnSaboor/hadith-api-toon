hadiths[107]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"1","من لم تنهه صلاته عن الفحشاء و المنكر ، فلا صلاة له","","Majmu'a Da'eef Ahadith 1","","","Prayer that does not prevent indecency and evil is not prayer"
"2","من لم تنهه صلاته عن الفحشاء و المنكر ، لم يزدد من الله الا بعدا","","Majmu'a Da'eef Ahadith 2","","","Prayer that does not prevent indecency and evil leads away from Allah"
"3","الحديث فى المسجد ياكل الحسنات كما تاكل البهائم الحشيش","","Majmu'a Da'eef Ahadith 3","","","Idle talk in the mosque consumes good deeds"
"4","الحديث فى المسجد ياكل الحسنات كما تاكل النار الحطب","","Majmu'a Da'eef Ahadith 4","","","Talking in the mosque eats up good deeds"
"5","اعمل لدنياك كأنك تعيش ابدا ، واعمل لاخرتك كأنك تموت غدا","","Majmu'a Da'eef Ahadith 5","","","Example of deeds for this world and the Hereafter"
"6","أنا جد كل تقي","","Majmu'a Da'eef Ahadith 6","","","The Prophet ﷺ is the pivot of every believer’s good fortune"
"7","إنما بعثت معلما","","Majmu'a Da'eef Ahadith 7","","","The Prophet ﷺ was sent as a teacher"
"8","اوحي الله إلى الدنيا ان اخدمي من خدمني و اتعبي من خدمك","","Majmu'a Da'eef Ahadith 8","","","Allah’s revelation for the world"
"9","إياكم و خضراء الدمن ، فقيل : ما خضراء الدمن؟ قال : المرأة الحسناء فى المنبت السوء","","Majmu'a Da'eef Ahadith 9","","","Beware of a beautiful woman"
"10","صنفان من أمتي إذا صلحا ، صلح الناس : الأمراء و الفقهاء","","Majmu'a Da'eef Ahadith 10","","","Reform of two groups guarantees the reform of the whole Ummah"
"12","توسلو ا بجاهي ، فإن جاهي عند الله عظيم","","Majmu'a Da'eef Ahadith 12","","","Seek means through my status"
"13","من خرج من بيته إلى الصلاة فقال : اللهم بحق السائلين عليك ، و أسألك بحق ممشاى هذا فإني لم أخرج أشرا ولا بطرا أقبل الله عليه بوجهه و استغفر له ألف ملك","","Majmu'a Da'eef Ahadith 13","","","Supplicating when going for prayer brings the prayers of a thousand angels"
"14","الخير فى و فى أمتي إلى يوم القيامة","","Majmu'a Da'eef Ahadith 14","","","The Ummah of Muhammad ﷺ is the center of goodness until the Day of Judgment"
"15","من نام بعد العصر ، فاختلس عقله ، فلا يلومن إلا نفسه","","Majmu'a Da'eef Ahadith 15","","","Sleeping after Asr may harm the mind"
"16","من أحدث ولم يتوضأ فقد جفاني ومن توضأ ولم يصل فقد جفاني ومن صلى ولم يدعني فقد جفاني ومن دعاني فلم أجبه فقد جفيته ولست برب جاف","","Majmu'a Da'eef Ahadith 16","","","Encouragement to renew wudu after breaking it"
"17","من حج البيت ولم يزرني فقد جفاني","","Majmu'a Da'eef Ahadith 17","","","Encouragement to visit the Prophet’s ﷺ grave during Hajj"
"18","من حج فزار قبري بعد موتي ، كان كمن زارني فى حياتي","","Majmu'a Da'eef Ahadith 18","","","Virtue of visiting the Prophet’s ﷺ grave during Hajj"
"19","اختلاف أمتي رحمة","","Majmu'a Da'eef Ahadith 19","","","Difference in the Ummah is a mercy"
"20","أصحابي كالنجوم بايهم اقتديتم اهتديتم","","Majmu'a Da'eef Ahadith 20","","","Following any companion is guidance"
"21","إنما أصحابي مثل النجوم فأيهم اخذتم بقوله اهتديتم","","Majmu'a Da'eef Ahadith 21","","","My companions are like stars"
"22","من عرف نفسه فقد عرف ربه","","Majmu'a Da'eef Ahadith 22","","","Knowing the self is knowing the Lord"
"23","أدبني ربي ، فاحسن تأديبي","","Majmu'a Da'eef Ahadith 23","","","My Lord taught me manners"
"24","الناس كلهم موتي إلا العالمون ، و العالمون كلهم هلكي إلا العاملون ، و العاملون كلهم غرقي إلا المخلصون ، و المخلصون على خطر عظيم","","Majmu'a Da'eef Ahadith 24","","","Even the sincere are at risk"
"25","سؤر المؤمن شفاء","","Majmu'a Da'eef Ahadith 25","","","There is healing in a believer’s leftovers"
"26","إذا رايتم الرايات السود خرجت من قبل خراسان ، فأتوها ولو حبوا ، فإن فيها خليفة الله المهدي","","Majmu'a Da'eef Ahadith 26","","","Sign of the coming of Caliph Mahdi"
"27","التائب حبيب الله","","Majmu'a Da'eef Ahadith 27","","","Virtue of the repentant"
"28","أما إني لا انسي ، و لكن أنس لأ شرع","","Majmu'a Da'eef Ahadith 28","","","The Prophet ﷺ never forgot anything without purpose"
"29","الناس نيام فاذا ماتوا انتبهوا","","Majmu'a Da'eef Ahadith 29","","","People will awaken after death"
"30","من حدث حديثا ، فعطس عنده ، فهو حق","","Majmu'a Da'eef Ahadith 30","","","Recognition of authentic hadith"
"31","تزوجوا ولا تطلقوا ، فان الطلاق يهتز له العرش","","Majmu'a Da'eef Ahadith 31","","","The Throne trembles at divorce"
"32","تعاد الصلاة من قدر الدرهم من الدم","","Majmu'a Da'eef Ahadith 32","","","Prayer is invalid if blood equals a dirham in amount"
"33","السخي قريب من الله ، قريب من الجنة ، قريب من الناس ، بعيد من النار ، و البخيل بعيد من الله ، بعيد من الجنة ، بعيد من الناس ، قريب من النار ، ولجاهل سخي أحب إلى الله من عابد بخيل","","Majmu'a Da'eef Ahadith 33","","","Virtue of generosity"
"34","انا عربى و القرآن عربى و لسان أهل الجنة عربى","","Majmu'a Da'eef Ahadith 34","","","Excellence of the Arabic language"
"35","إن لكل شئي قلبا ، و إن قلب القرآن ”يٓس“ من قرأها ، فكأنما قرأ القرآن عشر مرات","","Majmu'a Da'eef Ahadith 35","","","The heart of the Quran is Surah Yasin"
"36","فكرة ساعة خير من عبادة ستين سنة","","Majmu'a Da'eef Ahadith 36","","","Virtue of concern for the Hereafter"
"37","لا صلاة لجار المسجد إلا فى المسجد","","Majmu'a Da'eef Ahadith 37","","","Neighbor of the mosque cannot pray at home"
"38","الحجر الأسود يمين الله فى الأرض يصافح بها عباده","","Majmu'a Da'eef Ahadith 38","","","Black Stone is Allah’s right hand"
"39","صومو ا تصحوا","","Majmu'a Da'eef Ahadith 39","","","Fasting guarantees health"
"40","أوصاني جبرئيل عليه السلام بالجار إلى أربعين دارا ، عشرة من هاهنا ، وعشرة من هاهنا ، وعشرة من هاهنا ، وعشرة من هاهنا","","Majmu'a Da'eef Ahadith 40","","","Limits of neighborhood"
"41","لولاك ما خلقت الدنيا","","Majmu'a Da'eef Ahadith 41","","","Creation of the universe for the Prophet ﷺ"
"42","من قرأء سورة الواقعة من كل ليلة لم تصبه فاقة ابدا","","Majmu'a Da'eef Ahadith 42","","","Reciting Surah Waqiah removes poverty"
"43","من أصبح وهمه غير الله عزوجل ، فليس من الله فى شيء و من لم يهتم للمسلمين فليس منهم","","Majmu'a Da'eef Ahadith 43","","","Encouragement to care for Allah’s pleasure and Muslims"
"44","كما تكونوا يولى عليكم","","Majmu'a Da'eef Ahadith 44","","","As the people, so the ruler"
"45","إن الله عزوجل ينزل ليلة النصف من شعبان إلى السماء الدنيا فيغفر لأكثر من عدد شعر غنم كلب","","Majmu'a Da'eef Ahadith 45","","","Forgiveness of sins and increase in provision on Shab-e-Baraat"
"46","هل تدرين ما هذه الليلة؟ يعني ليلة النصف من شعبان ، قالت : ما فيها يا رسول الله؟ فقال : فيها أن يكتب كل مولود من بني آدم فى هذه السنة ، و فيها أن يكتب كل هالك بني آدم فى هذه السنة ، و فيها ترفع اعمالهم ، و فيها تنزل ارزاقهم","","Majmu'a Da'eef Ahadith 46","","","Forgiveness of sins and increase in provision on Shab-e-Baraat"
"47","«إن الله ليطلع فى ليلة النصف من شعبان فيغفر لجميع خلقه إلا لمشرك أو مشاحن»","","Majmu'a Da'eef Ahadith 47","","","Forgiveness of sins and increase in provision on Shab-e-Baraat"
"48","«إذا كانت ليلة النصف من شعبان فقوموا ليلها و صوموا نهارها، فإن الله ينزل فيها لغروب الشمس إلى السماء الدنيا فيقول ألا من مستغفر لي فاغفرله، ألا مسترزق فارزقه، ألا مبتلي فأعافيه، ألا كذا ألا كذا حتي يطلع الفجر»","","Majmu'a Da'eef Ahadith 48","","","Forgiveness of sins and increase in provision on Shab-e-Baraat"
"49","«خمس ليال لا ترد فيهن الدعوة: أول ليلة من رجب، و ليلة النصف من شعبان، و ليلة الجمعة، و ليلة الفطر، و ليلة النحر»","","Majmu'a Da'eef Ahadith 49","","","Forgiveness of sins and increase in provision on Shab-e-Baraat"
"50","من ولد له مولود فأذن فى أذنه اليمنى وأقام فى اذنه اليسرى لم تضره أم الصبيان","","Majmu'a Da'eef Ahadith 50","","","Virtue of saying adhan and iqamah in a newborn’s ear"
"51","من تمسك بسنتي عند فساد أمتي فله أجر مائة شهيد","","Majmu'a Da'eef Ahadith 51","","","Reviving a sunnah earns the reward of a hundred martyrs"
"52","المتمسك بسنتي عند فساد أمتي له أجر شهيد","","Majmu'a Da'eef Ahadith 52","","","One who adheres to sunnah gets the reward of a martyr"
"53","أنا ابن الذبيحين","","Majmu'a Da'eef Ahadith 53","","","I am the son of two sacrifices"
"54","النظر فى المصحف عبادة و نظر الولد إلى الوالدين عبادة و النظر إلى على بن ابي طالب عبادة","","Majmu'a Da'eef Ahadith 54","","","Looking at the Quran, parents, and Ali (RA) is worship"
"55","من صلى فى مسجدي أربعين صلاة لا يفوته صلاة كتبت له برائة من النار و نجاة من العذاب و بري من النفاق","","Majmu'a Da'eef Ahadith 55","","","Virtue of forty prayers in Masjid Nabawi ﷺ"
"56","الأقربون أولى بالمعروف","","Majmu'a Da'eef Ahadith 56","","","Close relatives are more deserving of good"
"57","آخر من يدخل الجنة رجل من جهينة ، يقال له : جهينه ، فيسأله أهل الجنة : هل بقي أحد يعذب؟ فيقول : لا ، فيقولون : عند جهينة الخبر اليقين","","Majmu'a Da'eef Ahadith 57","","","The last person to enter Paradise"
"58","خير الأسماء ما عبد وما حمد","","Majmu'a Da'eef Ahadith 58","","","Best names"
"59","اطلبوا العلم ولو بالصين","","Majmu'a Da'eef Ahadith 59","","","Command to seek knowledge even in China"
"60","شاور وهن . يعني النساء . وخالفوهن","","Majmu'a Da'eef Ahadith 60","","","Command to oppose women’s opinions"
"61","يدعي الناس يوم القيامة بأمهاتهم سترا من الله عزوجل عليهم","","Majmu'a Da'eef Ahadith 61","","","People will be called with their mothers on Judgment Day"
"62","السلطان ظل الله فى ارضه ، من نصحه هدى ومن غشه ضل","","Majmu'a Da'eef Ahadith 62","","","The ruler is Allah’s shadow on earth"
"63","من خاف الله خوف الله منه كل شىء ومن لم يخف الله خوفه الله من كل شىء","","Majmu'a Da'eef Ahadith 63","","","End of those who fear Allah and those who do not"
"64","قال الله تبارك و تعالىٰ : من لم يرض بقضائي و يصبر على بلائي فليلتمس ربا سوائى","","Majmu'a Da'eef Ahadith 64","","","One dissatisfied with Allah’s decree should seek another Lord"
"65","ليس لفاسق غيبة","","Majmu'a Da'eef Ahadith 65","","","Backbiting a sinner is not backbiting"
"66","إذا مات الرجل منكم فدفنتموه فليقم أحدكم عند رأسه ، فليقل : يا فلان بن فلانة ! فإنه سيسمع ، فليقل : يا فلان بن فلانة ! فإنه سيستوي قاعدا ، فليقل : يا فلان بن فلانة ! فإنه سيقول أرشدني أرشدني ، رحمك الله ، فليقل : أذكر ما خرجت عليه من دار الدنيا شهادة أن لا إله الا الله وحده لا شريك له وان محمدا عبده و رسوله وان الساعة آتية لا ريب فيها وان الله يبعث من فى القبور . . . !","","Majmu'a Da'eef Ahadith 66","","","Guidance to the dead after burial"
"67","ما خاب من استخار ، ولا ندم من استشار ، ولا عال من اقتصد","","Majmu'a Da'eef Ahadith 67","","","Glad tidings for one who does istikhara, consults, and is moderate"
"68","كان إذا أخذ من شعره أو قلم أظفاره أو احتجم بعث به إلى البقيع فدفن","","Majmu'a Da'eef Ahadith 68","","","Cutting hair and nails and sending them to Jannat al-Baqi for burial with the Prophet ﷺ"
"69","المؤمن كيس فطن حذر","","Majmu'a Da'eef Ahadith 69","","","Qualities of a believer"
"70","يٰأيها الناس قد أظلكم شهر عظيم ، شهر فيه ليلة خير من ألف شهر ، جعل الله صيامه فريضة وقيام ليلة تطوعا ، من تقرب فيه بخصلة من الخير كان كمن أدي فريضة فيما سواه ومن أدي فيه فريضة كان كمن أدي سبعين فريضة فيما سواه ، وهو شهر الصبر والصبر ثوابه الجنة ، وشهر المواساة ، وشهر يزاد فيه فى رزق المؤمن ومن فطر فيه صائما كان مغفرة لذنوبه وعتق رقبته من النار وكان له مثل أجره من غير أن ينقض من أجره شئي ، قلنا يا رسول الله ! ليس كلنا نجد ما نفطر به الصائم ، فقال رسول الله صلى الله عليه وسلم : يعطي الله هذا الثواب من فطر صائما على مذقة لبن أو تمرة أو شربة من ماء ، ومن أشبع صائما سقاه الله من حوضي شربة لا يظمأ حتي يدخل الجنة ، وهو شهر أوله رحمة ، و أوسطه مغفرة و آخره عتق من النار ومن خفف عن مملوكه فيه غفرالله له و اعتقه من النار","","Majmu'a Da'eef Ahadith 70","","","Virtue of Ramadan"
"71","يا جبريل صف لي النار ، وانعت لي جهنم ، فقال جبريل : إن الله تبارك وتعاليٰ أمر بجهنم فأوقد عليها ألف عام حتي أبيضت ، ثم أمر بها فأوقد عليها ألف عام حتي أحمرت ، ثم أمر بها فأوقد عليها ألف عام حتي أسودت فهي سوداء مظلمة","","Majmu'a Da'eef Ahadith 71","","","State of Hell"
"72","لا تكثروا الكلام بغير ذكر الله ، فإن كثرة الكلام بغير ذكر الله قسوة للقلب وإن أبعد الناس من الله القلب القاسي","","Majmu'a Da'eef Ahadith 72","","","Harm of excessive speech"
"73","إذا انتهي أحدكم إلى الصف وقد تم فليجبذ إليه رجلا يقيمه إلى جنبه","","Majmu'a Da'eef Ahadith 73","","","Pulling someone back if the front row is full"
"74","الأبدال فى هذه الأمة ثلاثون ، مثل إبراهيم خليل الرحمان عزوجل ، كلما مات رجل أبدل الله تبارك وتعاليٰ مكانه رجلا","","Majmu'a Da'eef Ahadith 74","","","Thirty abdal will appear in this Ummah"
"75","ما فضلكم أبوبكر بكثرة صيام ولا صلاة ولكن بشيء وقر فى صدره","","Majmu'a Da'eef Ahadith 75","","","Reason for Abu Bakr’s (RA) superiority among all companions"
"76","تحية البيت الطواف","","Majmu'a Da'eef Ahadith 76","","","Tawaf in the Kaaba is the greeting of the mosque"
"77","إن العبد إذا قام فى الصلاة فإنه بين عيني الرحمان فإذا التفت ، قال له الرب : يا ابن آدم إلى من تلتفت؟ إلى من هو خير لك مني؟ ابن آدم ! أقبل على صلاتك فأنا خير لك ممن تلتفت إليه","","Majmu'a Da'eef Ahadith 77","","","In prayer, a person stands before Allah"
"78","وقع فى نفس موسىٰ : هل ينام الله تعالىٰ؟ فأرسل الله إليه ملكا ، فأرقده ثلاثا ، ثم أعطاه قارورتين ، فى كل يد قارورة . . . ثم نام نومة ، فاصطفقت يداه وانكسرت القارورتان ، قال : ضرب الله له مثلا ، أن الله لو كان ينام لم تستمسك السماوات والأرض","","Majmu'a Da'eef Ahadith 78","","","Does Allah sleep?"
"79","النظرة سهم من سهام ابليس من تركها خوفا من الله آتاه الله ايمانا يجد حلاوته فى قلبه","","Majmu'a Da'eef Ahadith 79","","","The evil eye is a dart of Satan"
"80","يعاد الوضوء من الرعاف السائل","","Majmu'a Da'eef Ahadith 80","","","Nosebleed breaks wudu"
"81","ليس الإيمان بالتمنى ولا بالتحلى ، ولكن ما وقر فى القلب و صدقه الفعل","","Majmu'a Da'eef Ahadith 81","","","Reality of faith"
"82","تخرج الدابة ومعها عصا موسىٰ عليه السلام ، و خاتم سليمان عليه السلام ، فيقول : هذا يا مؤمن ، هذا يا كافر","","Majmu'a Da'eef Ahadith 82","","","A sign of the Hour"
"83","انطلق النبى صلى الله عليه وسلم و أبوبكر إلى الغار فدخلا فيه فجاءت العنكبوت فنسجت على باب الغار وجاءت قريش يطلبون النبى صلى الله عليه وسلم وكانوا إذا رأوا على باب الغار نسج العنكبوت قالو ألم يدخله أحد . . .","","Majmu'a Da'eef Ahadith 83","","","Spider spun a web at the cave’s entrance for the Prophet ﷺ and Abu Bakr (RA)"
"84","وجد النبى صلى الله عليه وسلم ريحا ، فقال : ليقم صاحب هذا الريح فليتوضأ ، فاستحيا الرجل ان يقوم ، فقال رسول الله صلى الله عليه وسلم : ليقم صاحب هذا الريح فليتوضأ ، فإن الله لا يستحي من الحق ، فقال العباس : يا رسول الله أفلا نقوم كلنا نتوضأ؟ فقال : قوموا كلكم فتوضئوا","","Majmu'a Da'eef Ahadith 84","","","Command to renew wudu after breaking it"
"85","إذا فعلت أمتي خمس عشرة خصلة حل بها البلاء : إذا كان المغنم دولا والأمانة مغنما والزكاة مغرما وأطاع الرجل زوجته وعق أمه وبر صديقه وجفا أباه وارتفعت الأصوات فى المساجد وكان زعيم القوم أرزلهم وأكرم الرجل مخافة شره وشربت الخمور ولبس الحرير واتخذت القينات والمعازف ولعن آخر هذه الأمة أولها فلير تقبوا عند ذالك ريحا حمراء أو خسفا ومسخا","","Majmu'a Da'eef Ahadith 85","","","Fifteen actions that will bring trials upon the Ummah"
"86","حب الدنيا رأس كل خطيئة","","Majmu'a Da'eef Ahadith 86","","","Love of the world is the root of all sin"
"87","طلب الحلال جهاد ، و إن الله يحب المؤمن المحترف","","Majmu'a Da'eef Ahadith 87","","","Earning lawful sustenance is also jihad"
"88","لكل شيء عروس و عروس القرآن الرحمٰن","","Majmu'a Da'eef Ahadith 88","","","The bride of the Quran is Surah Rahman"
"89","سيد القوم خادمهم","","Majmu'a Da'eef Ahadith 89","","","The leader of a people is their servant"
"90","عليكم بالشفائين : العسل و القرآن","","Majmu'a Da'eef Ahadith 90","","","There is healing in honey and the Quran"
"91","آمن شعر أمية بن أبى الصلت و كفر قلبه","","Majmu'a Da'eef Ahadith 91","","","The miserable state of Umayyah bin Abi Salt"
"92","البر لا يبلي والاثم لا ينسي والديان لا ينام فكن كما شئت كما تدين تدان","","Majmu'a Da'eef Ahadith 92","","","As you practice religion, so will you be rewarded"
"93","لمعالجة ملك الموت أشد من ألف ضربة بالسيف","","Majmu'a Da'eef Ahadith 93","","","How difficult is facing the Angel of Death?"
"94","بادروا بالأعمال سبعا ، هل تنتظرون إلا فقرا منسيا أو غنا مطغيا أو مرضا مفسدا أو هرما مفندا أو موتا مجهزا أو الدجال فشر غائب ينتظر أو الساعة فالساعة أدهى وأمر","","Majmu'a Da'eef Ahadith 94","","","Hasten to good deeds before seven things"
"95","أجروكم على الفتيا أجروكم على النار","","Majmu'a Da'eef Ahadith 95","","","Fatwa can also lead to Hell"
"96","اتقوا فراسة المؤمن فإنه ينظر بنور الله","","Majmu'a Da'eef Ahadith 96","","","Beware of a believer’s insight"
"97","الدنيا دار من لا دار له ومال من لا مال له و لها يجمع من لا عقل له","","Majmu'a Da'eef Ahadith 97","","","One who amasses wealth for worldly luxury is foolish"
"98","لا تجعلوا آخر طعامكم ماء","","Majmu'a Da'eef Ahadith 98","","","Prohibition of drinking water at the end of a meal"
"99","إن للقلوب صدأ كصدء الحديد وجلائها الاستغفار","","Majmu'a Da'eef Ahadith 99","","","Remedy for rusted hearts"
"100","رجعنا من الجهاد الأصغر إلى الجهاد الأكبر","","Majmu'a Da'eef Ahadith 100","","","From lesser jihad to greater jihad"
"101","من أفطر يوما من رمضان فى غير رخصة رخصها الله له ، لم يقض صيام الدهر كله وان صامه","","Majmu'a Da'eef Ahadith 101","","","A missed fast without excuse can never be made up"
"102","إن عبدالرحمٰن بن عوف يدخل الجنة حبوا","","Majmu'a Da'eef Ahadith 102","","","How Abdur Rahman bin Awf (RA) will enter Paradise"
"103","أبغض الحلال إلى الله الطلاق","","Majmu'a Da'eef Ahadith 103","","","Divorce is the most hated thing to Allah"
"104","لما قدم النبى صلى الله عليه وسلم المدينة جعل النساء والصبيان والو لائد يقولون : طلع البدر علينا وجب الشكر علينا ۔ ۔ ۔ أيها المبعوث فينا من ثنيات الوداع ۔ ۔ ۔ ما دعا لله داع جئت بالأمر المطاع","","Majmu'a Da'eef Ahadith 104","","","Women and children’s poetry at the Prophet’s ﷺ arrival in Madinah"
"105","إياكم والحسد ، فإن الحسد يأكل الحسنات كما تأكل النار الحطب","","Majmu'a Da'eef Ahadith 105","","","Envy eats up good deeds"
"106","إن الله عز و جل يقول : أنا الله لا إله الا أنا ، مالك الملوك ، ملك الملوك ، قلوب الملوك فى يدى ، وان العباد إذا أطاعوني حولت قلوب ملوكهم عليهم بالرأفة والرحمة وان العباد إذا عصوني حولت قلوب ملوكهم عليهم بالسخط والنقمة فساموهم سوء العذاب ، فلا تشغلوا أنفسكم بالدعا على الملوك ولكن أشغلوا أنفسكم بالذكر والتضرع أكفكم ملوككم","","Majmu'a Da'eef Ahadith 106","","","Punishment from rulers is actually from Allah"
"107","الأذان والإقامة فى أذن المولود","","Majmu'a Da'eef Ahadith 107","","","Adhan and iqamah in a newborn’s ear"
"108","الحكمة ضالة كل حكيم فإذا وجدها فهو أحق بها","","Majmu'a Da'eef Ahadith 108","","","Who deserves wisdom most?"
