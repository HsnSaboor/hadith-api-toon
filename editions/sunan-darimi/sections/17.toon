hadiths[91]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3009","(حديث موقوف) أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ يَزِيدَ، حَدَّثَنَا حَيْوَةُ، حَدَّثَنَا أَبُو الْأَسْوَدِ مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ نَوْفَلٍ: أَنَّ عَاصِمَ بْنَ عُمَرَ بْنِ قَتَادَةَ الْأَنْصَارِيَّ أَخْبَرَهُ: أَنَّ عُمَرَ بْنَ الْخَطَّابِالْتَمَسَ مَنْ يَرِثُ ابْنَ الدَّحْدَاحَةِ، فَلَمْ يَجِدْ وَارِثًا، فَدَفَعَ مَالَ ابْنِ الدَّحْدَاحَةِ إِلَى أَخْوَالِ ابْنِ الدَّحْدَاحَةِ"".""","","Sunan al-Darimi 3009","","","27. ذوی الارحام کی میراث کا بیان"
"3010","(حديث موقوف) أَخْبَرَنَا أَبُو عَاصِمٍ، عَنْ ابْنِ جُرَيْجٍ، عَنْ عَمْرِو بْنِ مُسْلِمٍ، عَنْ طَاوُسٍ، عَنْ عَائِشَةَ، قَالَتْ: اللَّهُ وَرَسُولُهُ مَوْلَى مَنْ لَا مَوْلَى لَهُ، وَالْخَالُ وَارِثُ مَنْ لَا وَارِثَ لَهُ"".""","","Sunan al-Darimi 3010","","","27. ذوی الارحام کی میراث کا بیان"
"3011","(حديث موقوف) أَخْبَرَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ فِرَاسٍ، عَنْ الشَّعْبِيِّ، عَنْ زِيَادٍ، قَالَ:أُتِيَ عُمَرُ فِي عَمٍّ لِأُمٍّ، وَخَالَة، فَأَعْطَى الْعَمَّ لِلْأُمِّ الثُّلُثَيْنِ، وَأَعْطَى الْخَالَةَ الثُّلُثَ"".""","Sahih","Sunan al-Darimi 3011","","","27. ذوی الارحام کی میراث کا بیان"
"3012","(حديث موقوف) أَخْبَرَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ يُونُسَ، عَنِ الْحَسَنِ: أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَعْطَى الْخَالَةَ الثُّلُثَ، وَالْعَمَّةَ الثُّلُثَيْنِ"".""","Hasan","Sunan al-Darimi 3012","","","27. ذوی الارحام کی میراث کا بیان"
"3013","(حديث موقوف) أَخْبَرَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ الْحَسَنِ بْنِ عَمْرٍو، عَنْ غَالِبِ بْنِ عَبَّادٍ، عَنْ قَيْسِ بْنِ حَبْتَرٍ النَّهْشَلِيِّ، قَالَ: أُتِيَ عَبْدُ الْمَلِكِ بْنُ مَرْوَانَ فِي خَالَةٍ وَعَمَّةٍ، فَقَامَ شَيْخٌ، فَقَالَ: شَهِدْتُ عُمَرَ بْنَ الْخَطَّابِ أَعْطَى الْخَالَةَ الثُّلُثَ، وَالْعَمَّةَ الثُّلُثَيْنِ""، قَالَ: فَهَمَّ أَنْ يَكْتُبَ بِهِ، ثُمَّ قَالَ: أَيْنَ زَيْدٌ عَنْ هَذَا.""","Da'if","Sunan al-Darimi 3013","","","27. ذوی الارحام کی میراث کا بیان"
"3014","(حديث موقوف) أَخْبَرَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ، عَنْ الشَّعْبِيِّ، عَنْ مَسْرُوقٍ، عَنْ عَبْدِ اللَّهِ قَالَ: الْخَالَةُ بِمَنْزِلَةِ الْأُمِّ، وَالْعَمَّةُ بِمَنْزِلَةِ الْأَبِ، وَبِنْتُ الْأَخِ بِمَنْزِلَةِ الْأَخِ، وَكُلُّ ذِي رَحِمٍ بِمَنْزِلَةِ رَحِمِهِ الَّتِي يُدْلِي بِهَا إِذَا لَمْ يَكُنْ وَارِثٌ ذُو قَرَابَةٍ"".""","Da'if","Sunan al-Darimi 3014","","","27. ذوی الارحام کی میراث کا بیان"
"3015","(حديث موقوف) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أَنْبَأَنَا هِشَامٌ، عَنْ مُحَمَّدٍ، عَنْ عَبْدِ اللَّهِ بْنِ عُتْبَةَ، قَالَ: حَدَّثَنِي الضَّحَّاكُ بْنُ قَيْسٍ: أَنَّ عُمَرَ قَضَى فِي أَهْلِ طَاعُونِ عَمَوَاسَ أَنَّهُمْ كَانُوا إِذَا كَانُوا مِنْ قِبَلِ الْأَبِ سَوَاءً، فَبَنُو الْأُمِّ أَحَقُّ، وَإِذَا كَانَ بَعْضُهُمْ أَقْرَبَ مِنْ بَعْضٍ بِأَبٍ، فَهُمْ أَحَقُّ بِالْمَالِ.""","Sahih","Sunan al-Darimi 3015","","","28. عصبہ کا بیان"
"3016","(حديث موقوف) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ، حَدَّثَنَا أَبُو شِهَابٍ، حَدَّثَنِي أَبُو إِسْحَاق الشَّيْبَانِيُّ، عَنْ عُبَيْدِ بْنِ أَبِي الْجَعْدِ، عَنْ عَبْدِ اللَّهِ بْنِ شَدَّادِ بْنِ الْهَادِ، قَالَ: أُصِيبَ سَالِمٌ مَوْلَى أَبِي حُذَيْفَةَ يَوْمَ الْيَمَامَة، فَبَلَغَ مِيرَاثُهُ مِائَتَيْ دِرْهَمٍ، فَقَالَ عُمَرُ: احْبِسُوهَا عَلَى أُمِّهِ حَتَّى تَأْتِيَ عَلَى آخِرِهَا"".""","Sahih","Sunan al-Darimi 3016","","","28. عصبہ کا بیان"
"3017","(حديث مرفوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا زُهَيْرٌ، عَنْ أَبِي إِسْحَاق، عَنْ الْحَارِثِ، عَنْ عَلِيٍّ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: الْإِخْوَةُ مِنْ الْأُمِّ يَتَوَارَثُونَ دُونَ بَنِي الْعَلَّاتِ، يَرِثُ الرَّجُلُ أَخَاهُ لِأَبِيهِ وَأُمِّهِ، دُونَ أَخِيهِ لِأَبِيهِ"".""","Hasan","Sunan al-Darimi 3017","","","28. عصبہ کا بیان"
"3018","(حديث موقوف) حَدَّثَنَا سَهْلُ بْنُ حَمَّادٍ، حَدَّثَنَا شُعْبَةُ، عَنْ النُّعْمَانِ بْنِ سَالِمٍ، قَالَ: قُلْتُ لِابْنِ عُمَرَ:أَرَأَيْتَ رَجُلًا تَرَكَ ابْنَ ابْنَتِهِ، أَيَرِثُهُ؟ قَالَ: لا"".""","Sahih","Sunan al-Darimi 3018","","","28. عصبہ کا بیان"
"3019","(حديث موقوف) حَدَّثَنَا يَعْلَى، حَدَّثَنَا الْأَعْمَشُ، عَنْ إِبْرَاهِيمَ، قَالَ: قَالَ عَبْدُ اللَّهِ: الْأُمُّ عَصَبَةُ مَنْ لَا عَصَبَةَ لَهُ، وَالْأُخْتُ عَصَبَةُ مَنْ لَا عَصَبَةَ لَهُ"".""","","Sunan al-Darimi 3019","","","28. عصبہ کا بیان"
"3020","(حديث مرفوع) حَدَّثَنَا مُسْلِمُ بْنُ إِبْرَاهِيمَ، حَدَّثَنَا وُهَيْبٌ، حَدَّثَنَا ابْنُ طَاوُسٍ، عَنْ أَبِيهِ، عَنْ ابْنِ عَبَّاسٍ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: أَلْحِقُوا الْفَرَائِضَ بِأَهْلِهَا، فَمَا بَقِي، فَهُوَ لِأَوْلَى رَجُلٍ ذَكَرٍ"".""","Sahih","Sunan al-Darimi 3020","","","28. عصبہ کا بیان"
"3021","(حديث موقوف) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، حَدَّثَنَا يَحْيَى: أَنَّ سُلَيْمَانَ بْنَ يَسَارٍ أَخْبَرَهُ، عَنْ مُحَمَّدِ بْنِ الْأَشْعَثِ: أَنَّ عَمَّةً لَهُ تُوُفِّيَتْ يَهُودِيَّةً بِالْيَمَنِ، فَذَكَرَ ذَلِكَ لِعُمَرَ بْنِ الْخَطَّابِ فَقَالَ: يَرِثُهَا أَقْرَبُ النَّاسِ إِلَيْهَا مِنْ أَهْلِ دِينِهَا"".""","Sahih","Sunan al-Darimi 3021","","","29. مشرک اور مسلم کی میراث کا بیان"
"3022","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ قَيْسِ بْنِ مُسْلِمٍ، عَنْ طَارِقِ بْنِ شِهَابٍ، قَالَ: مَاتَتْ عَمَّةُ الْأَشْعَثِ بْنِ قَيْسٍ وَهِيَ يَهُودِيَّة، فَأَتَى عُمَرَ بْنَ الْخَطَّاب، فَقَالَ: أَهْلُ دِينِهَا يَرِثُونَهَا"".""","Sahih","Sunan al-Darimi 3022","","","29. مشرک اور مسلم کی میراث کا بیان"
"3023","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ حَمَّادٍ، عَنْ إِبْرَاهِيمَ، قَالَ: قَالَ عُمَرُ بْنُ الْخَطَّابِ: أَهْلُ الشِّرْكِ لَا نَرِثُهُمْ، وَلَا يَرِثُونَا"".""","","Sunan al-Darimi 3023","","","29. مشرک اور مسلم کی میراث کا بیان"
"3024","(حديث مرفوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا حَسَنٌ، عَنْ عِيسَى الْخياط، عَنْ الشَّعْبِيِّ:أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَأَبَا بَكْرٍ، وَعُمَرَ، قَالُوا: لَا يَتَوَارَثُ أَهْلُ دِينَيْنِ"".""","Hasan","Sunan al-Darimi 3024","","","29. مشرک اور مسلم کی میراث کا بیان"
"3025","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا زُهَيْرٌ، عَنْ مُطَرِّفٍ، عَنْ عَامِرٍ، عَنْ عُمَرَ، قَالَ: لَا يَتَوَارَثُ أَهْلُ مِلَّتَيْنِ"".""","","Sunan al-Darimi 3025","","","29. مشرک اور مسلم کی میراث کا بیان"
"3026","(حديث موقوف) أَخْبَرَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا شَرِيكٌ، عَنْ الْأَشْعَثِ، عَنْ الْحَسَنِ، عَنْ جَابِرٍ، قَالَ: لَا نَرِثُ أَهْلَ الْكِتَابِ وَلَا يَرِثُونَا، إِلَّا أَنْ يَمُوتَ لِلرَّجُلِ عَبْدُهُ أَوْ أَمَتُهُ"".""","Da'if","Sunan al-Darimi 3026","","","29. مشرک اور مسلم کی میراث کا بیان"
"3027","(حديث مرفوع) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا شَرِيكٌ، عَنْ الْأَشْعَثِ، عَنْ الْحَسَنِ، عَنْ جَابِرٍ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: لَا نَرِثُ أَهْلَ الْكِتَابِ وَلَا يَرِثُونَا، إِلَّا الرَّجُلُ يَرِثُ عَبْدَهُ، أَوْ أَمَتَهُ"".""","Da'if","Sunan al-Darimi 3027","","","29. مشرک اور مسلم کی میراث کا بیان"
"3028","(حديث موقوف) حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ دَاوُدَ، عَنْ الشَّعْبِيِّ، عَنْ مَسْرُوقٍ، قَالَ:كَانَ مُعَاوِيَةُ يُوَرِّثُ الْمُسْلِمَ مِنْ الْكَافِرِ، وَلَا يُوَرِّثُ الْكَافِرَ مِنْ الْمُسْلِمِ، قَالَ: قَالَ مَسْرُوقٌ: وَمَا حَدَثَ فِي الْإِسْلَامِ قَضَاءٌ أَحَبُّ إِلَيَّ مِنْهُ، قِيلَ لِأَبِي مُحَمَّدٍ: تَقُولُ بِهَذَا؟ قَالَ: لا.""","Sahih","Sunan al-Darimi 3028","","","29. مشرک اور مسلم کی میراث کا بیان"
"3029","(حديث موقوف) حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ، عَنْ دَاوُدَ بْنِ أَبِي هِنْدٍ، عَنْ عَامِرٍ: أَنَّ الْمُعْزِلَةَ بِنْتَ الْحَارِثِ تُوُفِّيَتْ بِالْيَمَنِ وَهِيَ يَهُودِيَّةٌ، فَرَكِبَ الْأَشْعَثُ بْنُ قَيْسٍ، وَكَانَتْ عَمَّتَهُ، إِلَى عُمَرَ فِي مِيرَاثِهَا، فَقَالَ عُمَرُ:لَيْسَ ذَاكَ لَكَ، يَرِثُهَا أَقْرَبُ النَّاسِ مِنْهَا مِنْ أَهْلِ دِينِهَا، لَا يَتَوَارَثُ مِلَّتَانِ"".""","Sahih","Sunan al-Darimi 3029","","","29. مشرک اور مسلم کی میراث کا بیان"
"3030","(حديث موقوف) حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، حَدَّثَنَا أَنَسُ بْنُ سِيرِينَ، قَالَ: قَالَ عُمَرُ بْنُ الْخَطَّابِ: لَا يَتَوَارَثُ مِلَّتَانِ شَتَّى، وَلَا يَحْجُبُ مَنْ لَا يَرِثُ"".""","","Sunan al-Darimi 3030","","","29. مشرک اور مسلم کی میراث کا بیان"
"3031","(حديث مرفوع) حَدَّثَنَا نَصْرُ بْنُ عَلِيٍّ، حَدَّثَنَا عَبْدُ الْأَعْلَى، عَنْ مَعْمَرٍ، عَنْ الزُّهْرِيِّ، عَنْ عَلِيِّ بْنِ حُسَيْنٍ، عَنْ عَمْرِو بْنِ عُثْمَانَ، عَنْ أُسَامَةَ بْنِ زَيْدٍ أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: لَا يَرِثُ الْمُسْلِمُ الْكَافِرَ، وَلَا الْكَافِرُ الْمُسْلِمَ"".""","Sahih","Sunan al-Darimi 3031","","","29. مشرک اور مسلم کی میراث کا بیان"
"3032","(حديث مقطوع) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، عَنْ سَعِيدٍ، عَنْ أَبِي مَعْشَرٍ، عَنْ إِبْرَاهِيمَ، قَالَ: إِذَا مَاتَ الْمَيِّتُ وَجَبَتْ الْحُقُوقُ لِأَهْلِهَا، وَلَمْ يَجْعَلْ لِمَنْ أَسْلَمَ أَوْ أُعْتِقَ قَبْلَ أَنْ يُقْسَمَ الْمِيرَاثُ شَيْئًا"".""","Da'if","Sunan al-Darimi 3032","","","29. مشرک اور مسلم کی میراث کا بیان"
"3033","(حديث مرفوع) أَخْبَرَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ عَبْدِ اللَّهِ بْنِ عِيسَى، عَنْ الزُّهْرِيِّ، عَنْ عَلِيِّ بْنِ حُسَيْنٍ، عَنْ أُسَامَةَ بْنِ زَيْدٍ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: لَا يَرِثُ الْمُسْلِمُ الْكَافِرَ، وَلَا الْكَافِرُ الْمُسْلِمَ"".""","Sahih","Sunan al-Darimi 3033","","","29. مشرک اور مسلم کی میراث کا بیان"
"3034","(حديث مرفوع) حَدَّثَنَا عَمْرُو بْنُ عَوْنٍ، حَدَّثَنَا سُفْيَانُ، عَنْ الزُّهْرِيِّ، عَنْ عَلِيِّ بْنِ حُسَيْنٍ، عَنْ عَمْرِو بْنِ عُثْمَانَ، عَنْ أُسَامَةَ بْنِ زَيْدٍ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: لَا يَرِثُ الْمُسْلِمُ الْكَافِرَ، وَلَا الْكَافِرُ الْمُسْلِمَ"".""","Sahih","Sunan al-Darimi 3034","","","29. مشرک اور مسلم کی میراث کا بیان"
"3035","(حديث مقطوع) حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا أَبُو عَوَانَةَ، عَنْ مُغِيرَةَ، عَنْ إِبْرَاهِيمَ، قَالَ: لَيْسَ لِلْمُكَاتَبِ مِيرَاثٌ، مَا بَقِيَ عَلَيْهِ شَيْءٌ مِنْ مُكَاتَبَتِهِ"".""","Sahih","Sunan al-Darimi 3035","","","30. غلام مکاتب کا بیان"
"3036","(حديث موقوف) حَدَّثَنَا يَعْلَى، حَدَّثَنَا عَبْدُ الْمَلِكِ، عَنْ عَطَاءٍ:فِي رَجُلٍ لَهُ بَنُونَ قَدْ أَعْتَقَ مِنْ بَعْضِهِمْ النِّصْفَ، وَمِنْ بَعْضٍ الثُّلُثَ، وَمِنْ بَعْضٍ الرُّبُعَ، قَالَ: لَا يَرِثُونَ حَتَّى يُعْتَقُوا"".""","Sahih","Sunan al-Darimi 3036","","","30. غلام مکاتب کا بیان"
"3037","(حديث مقطوع) حَدَّثَنَا عبد الله بن جعفر الرقي، وَسَعِيدُ بْنُ الْمُغِيرَةِ، عَنْ ابْنِ الْمُبَارَكِ، عَنْ مَعْمَرٍ، عَنْ حَمَّادٍ، عَنْ إِبْرَاهِيمَ:فِي رَجُلٍ اشْتَرَى ابْنَهُ فِي مَرَضِهِ، قَالَ: إِنْ خَرَجَ مِنْ الثُّلُثِ وَرِثَهُ، وَإِنْ وَقَعَتْ عَلَيْهِ السِّعَايَةُ لَمْ يَرِثْ"".""","Sahih","Sunan al-Darimi 3037","","","30. غلام مکاتب کا بیان"
"3038","(حديث مقطوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا حَسَنٌ، عَنْ أَبِيهِ، عَنْ الشَّعْبِيِّ، قَالَ: حَدُّ الْمُكَاتَبِ حَدُّ الْمَمْلُوكِ، حَتَّى يُعْتَقَ"".""","Hasan","Sunan al-Darimi 3038","","","30. غلام مکاتب کا بیان"
"3039","(حديث مرفوع) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ، حَدَّثَنَا يُونُسُ، عَنْ الزُّهْرِيِّ، قَالَ: قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: الْمَوْلَى أَخٌ فِي الدِّينِ وَنِعْمَةٌ، أَحَقُّ النَّاسِ بِمِيرَاثِهِ أَقْرَبُهُمْ مِنْ الْمُعْتِقِ"".""","Sahih","Sunan al-Darimi 3039","","","31. ولاء کا بیان"
"3040","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا هُشَيْمٌ، حدثنا مَنْصُورٌ، عَنْ الْحَسَنِ، وَمُحَمَّدُ بْنُ سَالِمٍ، عَنْ الشَّعْبِيِّ فِي رَجُلٍ أَعْتَقَ مَمْلُوكًا، ثُمَّ مَاتَ الْمَوْلَى وَالْمَمْلُوكُ، وَتَرَكَ الْمُعْتِقُ أَبَاهُ وَابْنَهُ، قَالَا: الْمَالُ لِلِابْنِ"".""","Hasan","Sunan al-Darimi 3040","","","31. ولاء کا بیان"
"3041","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا عَبَّادٌ، عَنْ عُمَرَ بْنِ عَامِرٍ، عَنْ قَتَادَةَ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ، عَنْ زَيْدِ بْنِ ثَابِتٍ فِي رَجُلٍ تَرَكَ أَبَاهُ وَابْنَ ابْنِهِ، فَقَالَ: الْوَلَاءُ لِابْنِ الِابْنِ"".""","Hasan","Sunan al-Darimi 3041","","","31. ولاء کا بیان"
"3042","(حديث مرفوع) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا مُعَمَّرٌ، حَدَّثَنَا خُصَيْفٌ، عَنْ زِيَادِ بْنِ أَبِي مَرْيَمَ: أَنَّ امْرَأَةً أَعْتَقَتْ عَبْدًا لَهَا، ثُمَّ تُوُفِّيَتْ وَتَرَكَتْ ابْنَهَا وَأَخَاهَا، ثُمَّ تُوُفِّيَ مَوْلَاهَا، فَأَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ابْنُ الْمَرْأَةِ وَأَخُوهَا فِي مِيرَاثِهِ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: مِيرَاثُهُ لِابْنِ الْمَرْأَةِ، فَقَالَ أَخُوهَا: يَا رَسُولَ اللَّه، ِلَوْ أَنَّهُ جَرَّ جَرِيرَةً، عَلَى مَنْ كَانَتْ؟ قَالَ: عَلَيْكَ"".""","Hasan","Sunan al-Darimi 3042","","","31. ولاء کا بیان"
"3043","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ الصَّلْتِ، حَدَّثَنَا هُشَيْمٌ، أَخْبَرَنَا مُغِيرَةُ، قَالَ: سَأَلْتُ إِبْرَاهِيمَعَنْ رَجُلٍ أَعْتَقَ مَمْلُوكًا لَهُ، فَمَاتَ وَمَاتَ الْمَوْلَى، فَتَرَكَ الْمُعْتِقُ أَبَاهُ وَابْنَهُ، فَقَالَ لِأَبِيهِ: كَذَا، وَمَا بَقِيَ فَلِابْنِهِ"".""","Sahih","Sunan al-Darimi 3043","","","31. ولاء کا بیان"
"3044","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ الصَّلْتِ، حَدَّثَنَا هُشَيْمٌ، عَنْ شُعْبَةَ قَالَ: سَمِعْتُ الْحَكَمَ، وَحَمَّادًا، يَقُولَانِ: هُوَ لِلِابْنِ"".""","Da'if","Sunan al-Darimi 3044","","","31. ولاء کا بیان"
"3045","(حديث مرفوع) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أَنْبَأَنَا الْأَشْعَثُ، عَنْ الْحَسَن: أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ""خَرَجَ إِلَى الْبَقِيعِ، فَرَأَى رَجُلًا يُبَاعُ، فَأَتَاهُ فَسَاوَمَ بِهِ، ثُمَّ تَرَكَهُ فَرَآهُ رَجُلٌ فَاشْتَرَاهُ فَأَعْتَقَهُ، ثُمَّ جَاءَ بِهِ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَالَ: إِنِّي اشْتَرَيْتُ هَذَا فَأَعْتَقْتُهُ، فَمَا تَرَى فِيهِ؟ فَقَالَ: هُوَ أَخُوكَ وَمَوْلَاكَ، قَالَ: مَا تَرَى فِي صُحْبَتِهِ؟ قَالَ: إِنْ شَكَرَكَ فَهُوَ خَيْرٌ لَهُ وَشَرٌّ لَكَ، وَإِنْ كَفَرَكَ فَهُوَ خَيْرٌ لَكَ وَشَرٌّ لَهُ، قَالَ: مَا تَرَى فِي مَالِهِ؟ قَالَ: إِنْ مَاتَ وَلَمْ يَتْرُكْ عَصَبَةً فَأَنْتَ وَارِثُهُ"".""","Da'if","Sunan al-Darimi 3045","","","31. ولاء کا بیان"
"3046","(حديث مرفوع) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أَنْبَأَنَا أَشْعَثُ، عَنْ الْحَكَمِ، وَسَلَمَةَ بْنِ كُهَيْلٍ، عَنْ عَبْدِ اللَّهِ بْنِ شَدَّادٍ: أَنَّ ابْنَةَ حَمْزَةَ أَعْتَقَتْ عَبْدًا لَهَا، فَمَاتَ وَتَرَكَ ابْنَتَهُ وَمَوْلَاتَهُ بِنْتَ حَمْزَةَ،فَقَسَمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِيرَاثَهُ بَيْنَ ابْنَتِهِ وَمَوْلَاتِهِ بِنْتِ حَمْزَةَ نِصْفَيْنِ"".""","Da'if","Sunan al-Darimi 3046","","","31. ولاء کا بیان"
"3047","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ عُيَيْنَةَ، عَنْ عَلِيِّ بْنِ مُسْهِرٍ، عَنْ الشَّيْبَانِيِّ، عَنْ الْحَكَمِ، عَنْ شَمُوسَ الْكِنْدِيَّةِ، قَالَتْ:قَاضَيْتُ إِلَى عَلِيٍّ فِي أَبٍ مَاتَ فَلَمْ يَدَعْ أَحَدًا غَيْرِي، وَمَوْلَاهُ، فَأَعْطَانِي النِّصْفَ، َوَأَعْطَى مَوْلَاهُ النِّصْفَ"".""","Sahih","Sunan al-Darimi 3047","","","31. ولاء کا بیان"
"3048","(حديث موقوف) أَخْبَرَنَا مُحَمَّدُ بْنُ عُيَيْنَةَ، عَنْ عَلِيِّ بْنِ مُسْهِرٍ، عَنْ ابْنِ أَبِي لَيْلَى، عَنْ الْحَكَمِ، عَنْ أَبِي الْكَنُودِ، عَنْ عَلِيٍّ:أَنَّهُ أُتِيَ بِابْنَةٍ وَمَوْلًى، فَأَعْطَى الِابْنَةَ النِّصْفَ، وَالْمَوْلَى النِّصْفَ، قَالَ الْحَكَمُ: فَمَنْزِلِي هَذَا نَصِيبُ الْمَوْلَى الَّذِي وَرِثَهُ عَنْ مَوْلَاهُ.""","Da'if","Sunan al-Darimi 3048","","","31. ولاء کا بیان"
"3049","(حديث موقوف) أَخْبَرَنَا إِبْرَاهِيمُ بْنُ مُوسَى، عَنْ ابْنِ إِدْرِيسَ، عَنْ أَشْعَثَ، عَنْ الْحَكَمِ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ مُدْلِجٍ: أَنَّهُ مَاتَ وَتَرَكَ ابْنَتَهُ وَمَوَالِيَهُ، فَأَعْطَى عَلِيٌّ ابْنَتَهُ النِّصْفَ وَمَوَالِيَهُ النِّصْفَ.""","Da'if","Sunan al-Darimi 3049","","","31. ولاء کا بیان"
"3050","(حديث موقوف) حَدَّثَنَا إِبْرَاهِيمُ، عَنْ ابْنِ إِدْرِيسَ، عَنْ الشَّيْبَانِيِّ، عَنْ الْحَكَمِ، عَنْ الشَّمُّوسِ:أَنَّ أَبَاهَا مَاتَ، فَجَعَلَ عَلِيٌّ لَهَا النِّصْفَ وَلِمَوَالِيهِ النِّصْفَ"".""","","Sunan al-Darimi 3050","","","31. ولاء کا بیان"
"3051","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا حَفْصُ بْنُ غِيَاثٍ، حَدَّثَنَا أَشْعَثُ، عَنْ جَهْمِ بْنِ دِينَارٍ، عَنْ إِبْرَاهِيمَ: أَنَّهُسُئِلَ عَنْ أُخْتَيْنِ اشْتَرَتْ إِحْدَاهُمَا أَبَاهَا فَأَعْتَقَتْهُ، ثُمَّ مَاتَ، قَالَ لَهُمَا: الثُّلُثَانِ فَرِيضَتُهُمَا فِي كِتَابِ اللَّهِ، وَمَا بَقِيَ فَلِلْمُعْتِقَةِ دُونَ الْأُخْرَى"".""","Da'if","Sunan al-Darimi 3051","","","31. ولاء کا بیان"
"3052","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا إِسْرَائِيلُ، حَدَّثَنَا الْأَشْعَثُ، عَنْ الشَّعْبِيِّ:فِي امْرَأَةٍ أَعْتَقَتْ أَبَاهَا، فَمَاتَ الْأَبُ وَتَرَكَ أَرْبَعَ بَنَاتٍ هِيَ إِحْدَاهُنَّ، قَالَ: لَيْسَ عَلَيْهِ مِنَّةٌ، لَهُنَّ الثُّلُثَانِ، وَهِيَ مَعَهُنَّ"".""","Da'if","Sunan al-Darimi 3052","","","31. ولاء کا بیان"
"3053","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا زُهَيْرٌ، عَنْ حَيَّانَ بْنِ سَلْمَانَ، قَالَ: كُنْتُ عِنْدَ سُوَيْدِ بْنِ غَفَلَةَ، فَجَاءَهُ رَجُلٌ، فَسَأَلَهُ عَنْفَرِيضَةِ رَجُلٍ تَرَكَ ابْنَتَهُ وَامْرَأَتَه، فَقَالَ: أَنَا أُنْبِئُكَ قَضَاءَ عَلِيٍّ، قَالَ: حَسْبِي قَضَاءُ عَلِيٍّ، قَالَ: قَضَى عَلِيٌّ لِامْرَأَتِهِ الثُّمُنَ، وَلِابْنَتِهِ النِّصْفَ، ثُمَّ رَدَّ الْبَقِيَّةَ عَلَى ابْنَتِهِ"".""","Sahih","Sunan al-Darimi 3053","","","32. ان علمائے کرام کا بیان جو غلام کی وراثت کا مالکان کے علاوہ صرف ذوی الارحام کو حق دار کہتے ہیں"
"3054","(حديث مقطوع) حَدَّثَنَا عُبَيْدُ اللَّهِ، عَنْ إِسْرَائِيلَ، عَنْ أَبِي الْهَيْثَمِ، عَنْ إِبْرَاهِيمَ: أَنَّ مَوْلَاةً لِإِبْرَاهِيمَ تُوُفِّيَتْ وَتَرَكَتْ مَالًا، فَقُلْتُ لِإِبْرَاهِيمَ، فَقَالَ: إِنَّ لَهَا ذَا قَرَابَةٍ"".""","Sahih","Sunan al-Darimi 3054","","","32. ان علمائے کرام کا بیان جو غلام کی وراثت کا مالکان کے علاوہ صرف ذوی الارحام کو حق دار کہتے ہیں"
"3055","(حديث موقوف) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، حَدَّثَنَا أَشْعَثُ، عَنْ الشَّعْبِيِّ، عَنْ عُمَرَ، وَعَلِيٍّ، وَزَيْدٍ، قَالَ: وَأَحْسَبُهُ قَدْ ذَكَرَ عَبْدَ اللَّهِ أَيْضًا: أَنَّهُمْ قَالُوا: الْوَلَاءُ لِلْكُبْرِ. يَعْنُونَ بِالْكُبْرِ: مَا كَانَ أَقْرَبَ بِأَبٍ أَوْ أُمٍّ"".""","Da'if","Sunan al-Darimi 3055","","","33. حق وراثت بڑے کو حاصل ہو گا"
"3056","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا يَزِيدُ، حَدَّثَنَا أَشْعَثُ، عَنْ ابْنِ سِيرِينَ، عَنْ عَبْدِ اللَّهِ بْنِ عُتْبَةَ، قَالَ:كَتَبَ إِلَيَّ عُمَرُ فِي شَأْنِ فُكَيْهَةَ بِنْتِ سَمْعَانَ أَنَّهَا مَاتَتْ وَتَرَكَتْ ابْنَ أَخِيهَا لِأَبِيهَا وَأُمِّهَا، وَابْنَ أَخِيهَا لِأَبِيهَا، فَكَتَبَ عُمَرُ: إِنَّ الْوَلَاءَ لِلْكُبْرِ"".""","Da'if","Sunan al-Darimi 3056","","","33. حق وراثت بڑے کو حاصل ہو گا"
"3057","(حديث موقوف) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ، حَدَّثَنَا أَبُو شِهَابٍ، عَنْ الشَّيْبَانِيِّ، عَنْ الشَّعْبِيِّ: أَنَّ عَلِيًّا، وَزَيْدًا قَالَا: الْوَلَاءُ لِلْكُبْر"". وَقَالَ عَبْدُ اللَّهِ، وَشُرَيْحٌ: لِلْوَرَثَةِ.""","Sahih","Sunan al-Darimi 3057","","","33. حق وراثت بڑے کو حاصل ہو گا"
"3058","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ عُيَيْنَةَ، عَنْ عَلِيِّ بْنِ مُسْهِرٍ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِيِّ، قَالَ:قَضَى عُمَر، وَعَبْدُ اللَّهِ، وَعَلِيٌّ، وَزَيْدٌ لِلْكُبْرِ بِالْوَلَاءِ"".""","Da'if","Sunan al-Darimi 3058","","","33. حق وراثت بڑے کو حاصل ہو گا"
"3059","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا شَرِيكٌ، عَنْ أَشْعَثَ، عَنْ ابْنِ سِيرِينَ، قَالَ:تُوُفِّيَتْ فُكَيْهَةُ بِنْتُ سَمْعَانَ وَتَرَكَتْ ابْنَ أَخِيهَا لِأَبِيهَا، وَبَنِي بَنِي أَخِيهَا لِأَبِيهَا وَأُمِّهَا، فَوَرَّثَ عُمَرُ بَنِي أَخِيهَا لِأَبِيهَا"".""","Da'if","Sunan al-Darimi 3059","","","33. حق وراثت بڑے کو حاصل ہو گا"
"3060","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا عَبْدُ السَّلَامِ بْنُ حَرْبٍ، عَنْ الْأَعْمَشِ، عَنْ إِبْرَاهِيمَ، عَنْ عُمَرَ، وَعَلِيٍّ، وَزَيْدٍ: أَنَّهُمْ قَالُوا: الْوَلَاءُ لِلْكُبْرِ"".""","Da'if","Sunan al-Darimi 3060","","","33. حق وراثت بڑے کو حاصل ہو گا"
"3061","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا أَبُو عَوَانَةَ، عَنْ مُغِيرَةَ، عَنْ إِبْرَاهِيمَ:فِي أَخَوَيْنِ وَرِثَا مَوْلًى كَانَ أَعْتَقَهُ أَبُوهُمَا، فَمَاتَ أَحَدُهُمَا وَتَرَكَ وَلَدًا، قَالَ: كَانَ عَلِيٌّ، وَزَيْدٌ، وَعَبْدُ اللَّهِ، يَقُولُونَ: ""الْوَلاءُ لِلْكَبِر"".""","Sahih","Sunan al-Darimi 3061","","","33. حق وراثت بڑے کو حاصل ہو گا"
"3062","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، قَالَ: سَمِعْتُ مَطَرًا الْوَرَّاقَ، يَقُولُ: قَالَ عُمَرُ، وَعَلِيٌّ: الْوَلاءُ لِلْكِبَرِ"".""","Da'if","Sunan al-Darimi 3062","","","33. حق وراثت بڑے کو حاصل ہو گا"
"3063","(حديث مقطوع) أَخْبَرَنَا مُحَمَّدُ بْنُ عِيسَى، عَنْ رَوْحٍ، عَنْ ابْنِ جُرَيْجٍ، عَنْ عَطَاءٍ، وَابْنِ جُرَيْجٍ، عَنْ ابْنِ طَاوُسٍ، عَنْ أَبِيهِ، قَالَ: الْوَلَاءُ لِلْكُبْرِ"".""","Da'if","Sunan al-Darimi 3063","","","33. حق وراثت بڑے کو حاصل ہو گا"
"3064","(حديث مقطوع) أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ مُوسَى، عَنْ إِسْرَائِيلَ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاهِيمَ، قَالَ: الْوَلَاءُ لِلْكُبْرِ"".""","Sahih","Sunan al-Darimi 3064","","","33. حق وراثت بڑے کو حاصل ہو گا"
"3065","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا سُفْيَانُ، عَنْ مُطَرِّفٍ، عَنْ الشَّعْبِيِّ، وَسُفْيَانُ، عَنْ يُونُسَ، عَنْ الْحَسَنِ فِي الرَّجُلِ يُوَالِي الرَّجُلَ، قَالَا: هُوَ بَيْنَ الْمُسْلِمِينَ"". قَالَ سُفْيَانُ: وَكَذَلِكَ نَقُولُ.""","Hasan","Sunan al-Darimi 3065","","","34. ایک آدمی دوسرے کی مدد کرے اس کا بیان"
"3066","(حديث مرفوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا عَبْدُ الْعَزِيزِ بْنُ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ، عَنْ عَبْدِ اللَّهِ بْنِ مَوْهَبٍ، قَالَ: سَمِعْتُ تَمِيمًا الدَّارِيَّ، يَقُولُ: سَأَلْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقُلْتُ: يَا رَسُولَ اللَّهِ، مَا السُّنَّةُ فِي الرَّجُلِ مِنْ أَهْلِ الْكُفْرِ يُسْلِمُ عَلَى يَدَيْ رَجُلٍ مِنْ الْمُسْلِمِينَ؟ فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: هُوَ أَوْلَى النَّاسِ بِمَحْيَاهُ وَمَمَاتِهِ"".""","Sahih","Sunan al-Darimi 3066","","","34. ایک آدمی دوسرے کی مدد کرے اس کا بیان"
"3067","(حديث مقطوع) حَدَّثَنَا عُبَيْدُ اللَّهِ، عَنْ إِسْرَائِيلَ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاهِيمَ، قَالَ: سُئِلَ عَنْ رَجُلٍ مِنْ أَهْلِ السَّوَادِ، أَسْلَمَ عَلَى يَدَيْ رَجُلٍ، قَالَ: يَعْقِلُ عَنْهُ، وَيَرِثُهُ"".""","Sahih","Sunan al-Darimi 3067","","","34. ایک آدمی دوسرے کی مدد کرے اس کا بیان"
"3068","(حديث مقطوع) حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا شُعْبَةُ، عَنْ مُغِيرَةَ، عَنْ إِبْرَاهِيمَ، قَالَ: تَرِثُ الْمَرْأَةُ مِنْ دِيَةِ زَوْجِهَا فِي الْعَمْدِ وَالْخَطَإِ"".""","Sahih","Sunan al-Darimi 3068","","","35. بیوی شوہر کے قتل عمد یا قتل خطا کی دیت کی وارث ہو گی"
"3069","(حديث مقطوع) حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا أَبُو عَوَانَةَ، عَنْ مُغِيرَةَ، عَنْ إِبْرَاهِيمَ، قَالَ: الدِّيَةُ عَلَى فَرَائِضِ اللَّهِ"".""","Sahih","Sunan al-Darimi 3069","","","35. بیوی شوہر کے قتل عمد یا قتل خطا کی دیت کی وارث ہو گی"
"3070","(حديث موقوف) حَدَّثَنَا مُسْلِمُ بْنُ إِبْرَاهِيمَ، حَدَّثَنَا وُهَيْبٌ، حَدَّثَنَا أَيُّوبُ، عَنْ أَبِي قِلَابَةَ، قَالَ: الدِّيَةُ سَبِيلُهَا سَبِيلُ الْمِيرَاثِ"".""","Sahih","Sunan al-Darimi 3070","","","35. بیوی شوہر کے قتل عمد یا قتل خطا کی دیت کی وارث ہو گی"
"3071","(حديث مقطوع) حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ حُمَيْدٍ، وَدَاوُدَ بْنِ أَبِي هِنْدٍ: أن عمر بن عبد العزيز كتب أن: يورث الإخوة من الأم من الدية"".""","Sahih","Sunan al-Darimi 3071","","","35. بیوی شوہر کے قتل عمد یا قتل خطا کی دیت کی وارث ہو گی"
"3072","(حديث موقوف) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ صَالِحٍ، حَدَّثَنِي اللَّيْثُ، حَدَّثَنِي يُونُسُ، عَنْ ابْنِ شِهَابٍ، قَالَ: الْعَقْلُ مِيرَاثٌ بَيْنَ وَرَثَةِ الْقَتِيلِ عَلَى كِتَابِ اللَّهِ وَفَرَائِضِهِ"".""","Sahih","Sunan al-Darimi 3072","","","35. بیوی شوہر کے قتل عمد یا قتل خطا کی دیت کی وارث ہو گی"
"3073","(حديث موقوف) حَدَّثَنَا قَبِيصَةُ، حَدَّثَنَا سُفْيَانُ، عَنْ عَمْرِو بْنِ دِينَارٍ، عَنْ بَعْضِ وَلَدِ ابْنِ الْحَنَفِيَّةِ، عَنْ عَلِيٍّ، قَالَ: لَقَدْ ظَلَمَ مَنْ لَمْ يُوَرِّثْ الْإِخْوَةَ مِنْ الْأُمِّ مِنْ الدِّيَةِ"".""","","Sunan al-Darimi 3073","","","35. بیوی شوہر کے قتل عمد یا قتل خطا کی دیت کی وارث ہو گی"
"3074","(حديث موقوف) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ سَعِيدٍ، حَدَّثَنَا أَبُو خَالِدٍ، أَنْبَأَنَا ابْنُ سَالِمٍ، عَنْ الشَّعْبِيِّ، عَنْ عُمَرَ، وَعَلِيٍّ، وَزَيْدٍ، قَالُوا: الدِّيَةُ تُورَثُ كَمَا يُورَثُ الْمَالُ خَطَؤُهُ وَعَمْدُهُ"".""","Da'if","Sunan al-Darimi 3074","","","35. بیوی شوہر کے قتل عمد یا قتل خطا کی دیت کی وارث ہو گی"
"3075","(حديث موقوف) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، حَدَّثَنَا إِسْمَاعِيل، عَنْ عَامِرٍ، قَالَ:كَانَ عَلِيٌّ لَا يُوَرِّثُ الْإِخْوَةَ مِنْ الْأُمِّ، وَلَا الزَّوْجَ، وَلَا الْمَرْأَةَ، مِنْ الدِّيَةِ شَيْئًا"". قَالَ عَبْد اللَّهِ: بَعْضُهُمْ يُدْخِلُ بَيْنَ إِسْمَاعِيل، وَعَامِرٍ رَجُلًا.""","Sahih","Sunan al-Darimi 3075","","","36. ان لوگوں کا بیان جو دیت کے وارث نہیں ہوں گے"
"3076","(حديث مقطوع) حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، عَنْ حَمَّادِ بْنِ سَلَمَةَ، عَنْ زِيَادٍ الْأَعْلَمِ، عَنْ الْحَسَنِ، قَالَ: لَا تُوَرَّثُ الْإِخْوَةُ مِنْ الْأُمِّ مِنْ الدِّيَةِ"".""","Hasan","Sunan al-Darimi 3076","","","36. ان لوگوں کا بیان جو دیت کے وارث نہیں ہوں گے"
"3077","(حديث موقوف) حَدَّثَنَا يَحْيَى بْنُ حَسَّانَ، حَدَّثَنَا ابْنُ أَبِي الزِّنَادِ، عَنْ أَبِيهِ، عَنْ خَارِجَةَ بْنِ زَيْدٍ، عَنْ زَيْدِ بْنِ ثَابِتٍ، قَالَ: كُلُّ قَوْمٍ مُتَوَارِثِينَ عَمِيَ مَوْتُهُمْ فِي هَدْمٍ، أَوْ غَرَقٍ، فَإِنَّهُمْ لَا يَتَوَارَثُونَ، يَرِثُهُمْ الْأَحْيَاءُ"".""","Hasan","Sunan al-Darimi 3077","","","37. پانی میں ڈوبنے والوں کی میراث کا بیان"
"3078","(حديث مقطوع) حَدَّثَنَا يَحْيَى بْنُ حَسَّانَ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، عَنْ يَحْيَى بْنِ عَتِيقٍ، قَالَ: قَرَأْتُ فِي بَعْضِ كُتُبِ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ فِي الْقَوْمِ يَقَعُ عَلَيْهِمْ الْبَيْتُ، لَا يُدْرَى أَيُّهُمَا مَاتَ قَبْلُ؟ قَالَ: لَا يُوَرَّثُ الْأَمْوَاتُ بَعْضُهُمْ مِنْ بَعْضٍ، وَيُوَرَّثُ الْأَحْيَاءُ مِنْ الْأَمْوَاتِ"".""","Sahih","Sunan al-Darimi 3078","","","37. پانی میں ڈوبنے والوں کی میراث کا بیان"
"3079","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا نُعَيْمُ بْنُ حَمَّادٍ، عَنْ عَبْدِ الْعَزِيزِ بْنِ مُحَمَّدٍ، حَدَّثَنَا جَعْفَرٌ، عَنْ أَبِيهِ: أَنَّ أُمَّ كُلْثُومٍ، وَابْنَهَا زَيْدًا مَاتَا فِي يَوْمٍ وَاحِدٍ، فَالْتَقَتْ الصَّائِحَتَانِ فِي الطَّرِيقِ، فَلَمْ يَرِثْ كُلُّ وَاحِدٍ مِنْهُمَا مِنْ صَاحِبِهِ، وَأَنَّ أَهْلَ الْحَرَّةِ لَمْ يَتَوَارَثُوا، وَأَنَّ أَهْلَ صِفِّينَ لَمْ يَتَوَارَثُوا.""","Hasan","Sunan al-Darimi 3079","","","37. پانی میں ڈوبنے والوں کی میراث کا بیان"
"3080","(حديث موقوف) أَخْبَرَنَا جَعْفَرُ بْنُ عَوْنٍ، أَنْبَأَنَا ابْنُ أَبِي لَيْلَى، عَنْ الشَّعْبِيِّ:أَنَّ بَيْتًا بِالشَّامِ وَقَعَ عَلَى قَوْمٍ، فَوَرَّثَ عُمَرُ بَعْضَهُمْ مِنْ بَعْضٍ"".""","Da'if","Sunan al-Darimi 3080","","","37. پانی میں ڈوبنے والوں کی میراث کا بیان"
"3081","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا سُفْيَانُ، عَنْ حُرَيْسٍ، عَنْ أَبِيهِ، عَنْ عَلِيٍّ:أَنَّهُ وَرَّثَ أَخَوَيْنِ قُتِلَا بِصِفِّينَ، أَحَدَهُمَا مِنْ الْآخَرِ"".""","Da'if","Sunan al-Darimi 3081","","","37. پانی میں ڈوبنے والوں کی میراث کا بیان"
"3082","(حديث موقوف) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أَنْبَأَنَا حُمَيْدٌ، عَنْ بَكْرِ بْنِ عَبْدِ اللَّهِ الْمُزَنِيِّ:أَنَّ رَجُلًا هَلَكَ، وَتَرَكَ عَمَّتَهُ، وَخَالَتَهُ، فَأَعْطَى عُمَرُ الْعَمَّةَ نَصِيبَ الْأَخِ، وَأَعْطَى الْخَالَةَ نَصِيبَ الْأُخْتِ"".""","Da'if","Sunan al-Darimi 3082","","","38. ذوی الارحام کی میراث کا بیان"
"3083","(حديث مقطوع) أَخْبَرَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ، حَدَّثَنَا أَبُو شِهَابٍ، عَنْ الْأَعْمَشِ، عَنْ إِبْرَاهِيمَ، قَالَ: مَنْ أَدْلَى بِرَحِمٍ، أُعْطِيَ بِرَحِمِهِ الَّتِي يُدْلِي بِهَا"".""","Sahih","Sunan al-Darimi 3083","","","38. ذوی الارحام کی میراث کا بیان"
"3084","(حديث مقطوع) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ، حَدَّثَنَا أَبُو شِهَابٍ، قَالَ: حَدَّثَنِي أَبُو إِسْحَاق الشَّيْبَانِيُّ، عَنْ الشَّعْبِيِّ:فِي رَجُلٍ تَرَكَ عَمَّتَهُ، وَابْنَةَ أَخِيهِ، قَالَ: الْمَالُ لِابْنَةِ أَخِيهِ"".""","Sahih","Sunan al-Darimi 3084","","","38. ذوی الارحام کی میراث کا بیان"
"3085","(حديث مرفوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا شَرِيكٌ، عَنْ لَيْثٍ، عَنْ مُحَمَّدِ بْنِ الْمُنْكَدِرِ، عَنْ أَبِي هُرَيْرَةَ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: الْخَالُ وَارِثٌ"".""","Da'if","Sunan al-Darimi 3085","","","38. ذوی الارحام کی میراث کا بیان"
"3086","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا حَسَنٌ، عَنْ عُبَيْدَةَ، عَنْ إِبْرَاهِيمَ: أَنَّ عُمَرَ، وَعَبْدَ اللَّهِ رَأَيَا أَنْ يُوَرِّثَا خَالًا.""","Da'if","Sunan al-Darimi 3086","","","38. ذوی الارحام کی میراث کا بیان"
"3087","(حديث مقطوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا حَسَنٌ، عَنْ سُلَيْمَانَ أَبِي إِسْحَاق، عَنْ الشَّعْبِيِّ: فِي عَمَّةٍ، وَبِنْتِ أَخٍ، قَالَ: الْمَالُ لِابْنَةِ الْأَخِ"".""","Sahih","Sunan al-Darimi 3087","","","38. ذوی الارحام کی میراث کا بیان"
"3088","(حديث مقطوع) حَدَّثَنَا أَبُو نُعَيْمٍ، أنبأنا حَسَنٌ، عَنْ سُلَيْمَانَ، عَنْ بَعْضِهِمْ، عَنْ إِبْرَاهِيمَ، قَالَ: لِلْعَمَّةِ"".""","","Sunan al-Darimi 3088","","","38. ذوی الارحام کی میراث کا بیان"
"3089","(حديث مقطوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا سُفْيَانُ، عَنْ الشَّيْبَانِيِّ، عَنْ الشَّعْبِيِّ: فِي بِنْتِ أَخٍ، وَعَمَّةٍ، قَالَ: أَعْطِي الْمَالَ لِابْنَةِ الْأَخِ"".""","Sahih","Sunan al-Darimi 3089","","","38. ذوی الارحام کی میراث کا بیان"
"3090","(حديث مقطوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا سُفْيَانُ، عَنْ الشَّيْبَانِيِّ، عَنْ الشَّعْبِيِّ: فِي بِنْتِ أَخٍ، وَعَمَّةٍ، قَالَ: أَعْطِي الْمَالَ لِابْنَةِ الْأَخِ"".""","Sahih","Sunan al-Darimi 3090","","","38. ذوی الارحام کی میراث کا بیان"
"3091","(حديث موقوف) حَدَّثَنَا يَعْلَى، حَدَّثَنَا زَكَرِيَّا، عَنْ عَامِرٍ، عَنْ مَسْرُوقٍ: فِي رَجُلٍ تُوُفِّيَ وَلَيْسَ لَهُ وَارِثٌ إِلَّا ابْنَةُ أَخِيهِ وَخَالُهُ، قَالَ: لِلْخَالِ نَصِيبُ أُخْتِهِ، وَلِابْنَةِ الْأَخِ نَصِيبُ أَبِيهَا"".""","Sahih","Sunan al-Darimi 3091","","","38. ذوی الارحام کی میراث کا بیان"
"3092","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا يُونُسُ، عَنْ عَامِرٍ، قَالَ:كَانَ مَسْرُوقٌ يُنَزِّلُ الْعَمَّةَ بِمَنْزِلَةِ الْأَبِ، إِذَا لَمْ يَكُنْ أَبٌ، وَالْخَالَةَ بِمَنْزِلَةِ الْأُمِّ، إِذَا لَمْ تَكُنْ أُمٌّ"".""","Sahih","Sunan al-Darimi 3092","","","38. ذوی الارحام کی میراث کا بیان"
"3093","(حديث مرفوع) حَدَّثَنَا يَعْلَى، عَنْ مُحَمَّدِ بْنِ إِسْحَاق، عَنْ مُحَمَّدِ بْنِ حَبَّانَ نَسَبَهُ إِلَى جَدِّهِ، عَنْ عَمِّهْ وَاسِعِ بْنِ حَبَّانَ، قَالَ: تُوُفِّيَ ابْنُ الدَّحْدَاحَةِ، وَكَانَ أَتِيًّا، وَهُوَ الَّذِي لَا يُعْرَفُ لَهُ أَصْلٌ، فَكَانَ فِي بَنِي الْعَجْلَانِ، وَلَمْ يَتْرُكْ عَقِبًا، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِعَاصِمِ بْنِ عَدِيٍّ: هَلْ تَعْلَمُونَ لَهُ فِيكُمْ نَسَبًا؟ قَالَ: مَا نَعْرِفُهُ يَا رَسُولَ اللَّهِ، فَدَعَا ابْنَ أُخْتِهِ، فَأَعْطَاهُ مِيرَاثَهُ.""","Da'if","Sunan al-Darimi 3093","","","38. ذوی الارحام کی میراث کا بیان"
"3094","(حديث موقوف) حَدَّثَنَا عُمَرُ بْنُ حَفْصِ بْنِ غِيَاثٍ، حَدَّثَنَا أَبِي، عَنِ الْأَعْمَشِ، عَنْ إِبْرَاهِيمَ، عَنْ عُمَرَ:أَنَّهُ أَعْطَى خَالًا الْمَالَ"".""","Da'if","Sunan al-Darimi 3094","","","38. ذوی الارحام کی میراث کا بیان"
"3095","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا أَبُو هَانِئٍ، قَالَ: سُئِلَ عَامِرٌ عَنْ امْرَأَةٍ أَوْ رَجُلٍ، تُوُفِّيَ وَتَرَكَ خَالَةً وَعَمَّةً، قَالَ:لَيْسَ لَهُ وَارِثٌ وَلَا رَحِمٌ غَيْرُهُمَا""، فَقَالَ: كَانَ عَبْدُ اللَّهِ بْنُ مَسْعُودٍ يُنَزِّلُ الْخَالَةَ بِمَنْزِلَةِ أُمِّهِ، وَيُنَزِّلُ الْعَمَّةَ بِمَنْزِلَةِ أَخِيهَا.""","Da'if","Sunan al-Darimi 3095","","","38. ذوی الارحام کی میراث کا بیان"
"3096","(حديث موقوف) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ، حَدَّثَنَا أَبُو شِهَابٍ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ: فِي رَجُلٍ اعْتَرَفَ عِنْدَ مَوْتِهِ بِأَلْفِ دِرْهَمٍ لِرَجُلٍ، وَأَقَامَ آخَرُ بَيِّنَةً بِأَلْفِ دِرْهَمٍ، وَتَرَكَ الْمَيِّتُ أَلْفَ دِرْهَمٍ، فَقَالَ: الْمَالُ بَيْنَهُمَا نِصْفَيْنِ، إِلَّا أَنْ يَكُونَ مُفْلِسًا، فَلَا يَجُوزُ إِقْرَارُهُ"".""","Da'if","Sunan al-Darimi 3096","","","39. کسی چیز کے انکار کا دعویٰ کرنے کا بیان"
"3097","(حديث موقوف) أَخْبَرَنَا أَبُو نُعَيْمٍ، قَالَ: قُلْتُ لِشَرِيكٍ: كَيْفَ ذَكَرْتَ فِي الْأَخَوَيْنِ يَدَّعِي أَحَدُهُمَا أَخًا؟ قَالَ: يَدْخُلُ عَلَيْهِ فِي نَصِيبِهِ""، قُلْتُ: مَنْ ذَكَرَهُ؟ قَالَ: جَابِرٌ، عَنْ عَامِرٍ، عَنْ عَلِيٍّ.""","Da'if","Sunan al-Darimi 3097","","","39. کسی چیز کے انکار کا دعویٰ کرنے کا بیان"
"3098","(حديث مقطوع) حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِيُّ، عَنْ الْأَعْمَشِ، عَنْ إِبْرَاهِيمَ: فِي الْإِخْوَةِ يَدَّعِي بَعْضُهُمْ الْأَخَ، وَيُنْكِرُ الْآخَرُونَ، قَالَ: يَدْخُلُ مَعَهُمْ بِمَنْزِلَةِ عَبْدٍ يَكُونُ بَيْنَ الْإِخْوَةِ، فَيَعْتِقَ أَحَدُهُمْ نَصِيبَهُ، قَالَ: وَكَانَ عَامِرٌ، وَالْحَكَمُ، وَأَصْحَابُهُمَا يَقُولُونَ: لَا يَدْخُلُ إِلَّا فِي نَصِيبِ الَّذِي اعْتَرَفَ بِهِ.""","","Sunan al-Darimi 3098","","","39. کسی چیز کے انکار کا دعویٰ کرنے کا بیان"
"3099","(حديث موقوف) حَدَّثَنَا أَبُو بَكْرِ ابْنُ أَبِي شَيْبَةَ، عَنْ وَكِيعٍ، قَالَ: إِذَا كَانَا أَخَوَيْنِ، فَادَّعَى أَحَدُهُمَا أَخًا وَأَنْكَرَهُ الْآخَرُ؟ قَالَ: كَانَ ابْنُ أَبِي لَيْلَى، يَقُولُ: هِيَ مِنْ سِتَّةٍ: لِلَّذِي لَمْ يَدَّعِ ثَلَاثَةٌ، وَلِلْمُدَّعِي سَهْمَانِ، وَلِلْمُدَّعَى سَهْمٌ"".""","Da'if","Sunan al-Darimi 3099","","","39. کسی چیز کے انکار کا دعویٰ کرنے کا بیان"
