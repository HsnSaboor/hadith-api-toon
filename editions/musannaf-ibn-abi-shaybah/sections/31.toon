hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"30061","(۳۰۰۶۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن یُونُسَ ، عَن حُمَیْدِ بْنِ ہِلالٍ ، عَنْ أَبِی بُرْدَۃَ ، قَالَ : جَلَسْت إِلَی شَیْخٍ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَسْجِدِ الْکُوفَۃِ فَحَدَّثَنِی ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَوْ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا أَیُّہَا النَّاسُ ، تُوبُوا إِلَی اللہِ وَاسْتَغْفِرُوہُ فَإِنِّی أَتُوبُ إِلَی اللہِ وَأَسْتَغْفِرُ فِی کُلِّ یَوْمٍ مِئَۃ مَرَّۃٍ ، قَالَ : قُلْتُ : اللَّہُمَّ إنِّی أَسْتَغْفِرُک اثْنَتَیْنِ ، قَالَ : ہُوَ مَا أَقُولُ لَک۔ (نسائی ۱۰۲۷۸۔ احمد ۲۶۰)","Sahih","Musannaf Ibn Abi Shaybah 30061","","","كتاب الدعاء"
"30062","(۳۰۰۶۲) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ رَجُلٍ ، عَن مُعَاذِ بْنِ جَبَلٍ ، قَالَ : مَنْ قَا??َ أَسْتَغْفِرُ اللَّہَ الَّذِی لاَ إلَہَ إِلاَّ ہُوَ الْحَیُّ الْقَیُّومُ وَأَتُوبُ إلَیْہِ ثَلاثًا غُفِرَ لَہُ ، وَإِنْ کَانَ فَرَّ مِنَ الزَّحْفِ۔","Da'if","Musannaf Ibn Abi Shaybah 30062","","","كتاب الدعاء"
"30063","(۳۰۰۶۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی سِنَانٍ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، قَالَ : مَنْ قَالَ أَسْتَغْفِرُ اللَّہَ الَّذِی لاَ إلَہَ إِلاَّ ہُوَ الْحَیُّ الْقَیُّومُ وَأَتُوبُ إلَیْہِ ثَلاثًا غُفِرَ لَہُ ، وَإِنْ کَانَ فَرَّ مِنَ الزَّحْفِ۔","Sahih","Musannaf Ibn Abi Shaybah 30063","","","كتاب الدعاء"
"30064","(۳۰۰۶۴) حَدَّثَنَا أَبُو دَاوُدَ الْحَفَرِیُّ عُمَرُ بْنُ سَعْدٍ ، عَن یُونُسَ بْنِ الْحَارِثِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : مَنْ قَالَ سُبْحَانَ اللہِ الْعَظِیمِ وَبِحَمْدِہِ غُرِسَ لَہُ بِہَا نَخْلَۃٌ فِی الْجَنَّۃِ۔ n(طبرانی ۳۵۲۔ احمد ۲۳۹)","Da'if","Musannaf Ibn Abi Shaybah 30064","","","كتاب الدعاء"
"30065","حدثنا أبو عبد الرحمن قَالَ حدثنا أبو بکر بن أبی شیبۃ قَالَ :n(۳۰۰۶۵) حَدَّثَنَا سُلَیْمَانُ بْنُ حَیَّانَ حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن یَحْیَی بْنِ سَعِیدٍ، عَنْ أَبِی الزُّبَیْرِ، عَن طَاوُوس، عَن مُعَاذٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا عَمِلَ ابْنُ آدَمَ عَمَلاً أَنْجَی لَہُ مِنَ النَّارِ مِنْ ذِکْرِ اللہِ ، قَالُوا : یَا رَسُولَ اللہِ ، وَلا الْجِہَادُ فِی سَبِیلِ اللہِ ؟ قَالَ : وَلا الْجِہَادُ فِی سَبِیلِ اللہِ ، إلاَّ أن تَضْرِبَ بِسَیْفِکَ حَتَّی یَنْقَطِعَ ، ثُمَّ تَضْرِبُ بہ حَتَّی یَنْقَطِعَ ، ثُمَّ تَضْرِبُ بِہِ حَتَّی یَنْقَطِعَ۔","","Musannaf Ibn Abi Shaybah 30065","","","كتاب الدعاء"
"30066","(۳۰۰۶۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، أَخْبَرَنَا مُعَاوِیَۃُ بْنُ صَالِحٍ ، قَالَ : أَخْبَرَنِی عَمْرُو بْنُ قَیْسٍ الْکِنْدِیُّ ، عَنْ عَبْدِ اللہِ بْنِ بُسْرٍ ، أَنَّ أَعْرَابِیًّا ، قَالَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا رَسُولَ اللہِ ، إنَّ شَرَائِعَ الإِسْلامِ قَدْ کَثُرَتْ ، فَأَنْبِئْنِی فیہ بِأَمْرٍ أَتَشَبَّثُ بِہِ ، قَالَ : لاَ یَزَالُ لِسَانُک رَطْبًا بِذِکْرِ اللہِ۔ (ترمذی ۲۳۲۹۔ احمد ۱۸۸)","Sahih","Musannaf Ibn Abi Shaybah 30066","","","كتاب الدعاء"
"30067","(۳۰۰۶۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن دَاوُد ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ أَبِی أَیُّوبَ الأَنْصَارِیِّ ، عَن رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ قَالَ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ بِیَدِہِ الْخَیْرُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ عَشْرَ مَرَّاتٍ ، کُنْ لَہُ کَعَدْلِ عَشْرِ رَقَباتٍ ، أَوْ رَقَبَۃٍ۔ (مسلم ۲۰۷۱۔ احمد ۴۲۲)","Shadh","Musannaf Ibn Abi Shaybah 30067","","","كتاب الدعاء"
"30068","(۳۰۰۶۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن لَیْثٍ ، عَن طَلْحَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَۃَ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَالَ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ ، وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، کَانَ کَعِتْقِ رَقَبَۃٍ۔ (احمد ۲۸۵۔ حاکم ۵۰۱)","Da'if","Musannaf Ibn Abi Shaybah 30068","","","كتاب الدعاء"
"30069","(۳۰۰۶۹) حَدَّثَنَا ہُشَیْمٌ ، عَن یَعْلَی بْنِ عَطَائٍ ، عَن بِشْرِ بْنِ عَاصِمٍ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، قَالَ : ذِکْرُ اللہِ بِالْغَدَاۃِ وَالْعَشِیِّ أَعْظَمُ مِنْ حَطْمِ السُّیُوفِ فِی سَبِیلِ اللہِ ، وَإِعْطَائِ الْمَالِ سَحًّا۔","Da'if","Musannaf Ibn Abi Shaybah 30069","","","كتاب الدعاء"
"30070","(۳۰۰۷۰) حَدَّثَنَا یَحْیَی بْنُ وَاضِحٍ ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ اللہِ الْقَرَّاظِ ، عَن مُعَاذِ بْنِ جَبَلٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَحَبَّ أَنْ یَرْتَعَ فِی رِیَاضِ الْجَنَّۃِ فَلْیُکْثِرْ ذِکْرَ اللہِ۔ (طبرانی ۳۲۶)","Da'if","Musannaf Ibn Abi Shaybah 30070","","","كتاب الدعاء"
"30071","(۳۰۰۷۱) حَدَّثَنَا وَکِیعٌ، عَن مِسْعَرٍ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ، عَنِ ابْنِ سَابِطٍ، عَن مُعَاذٍ، قَالَ: لأَنْ أَذْکُرَ اللَّہَ مِنْ غُدْوَۃٍ حَتَّی تَطْلُعَ الشَّمْسُ أَحَبُّ إلَیَّ مِنْ أَنْ أُحْمَلَ عَلَی الْجِہَادِ فِی سَبِیلِ اللہِ مِنْ غُدْوَۃٍ حَتَّی تَطْلُعَ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 30071","","","كتاب الدعاء"
"30072","(۳۰۰۷۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، حَدَّثَنَا مُعَاوِیَۃُ ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ جُبَیْرِ بْنِ نُفَیْرٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : إنَّ الَّذِینَ لاَ تَزَالُ أَلْسِنَتُہُمْ رَطْبَۃً مِنْ ذِکْرِ اللہِ یَدْخُلُونَ الْجَنَّۃَ وَہُمْ یَضْحَکُونَ۔","Hasan","Musannaf Ibn Abi Shaybah 30072","","","كتاب الدعاء"
"30073","(۳۰۰۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا مِسْعَرٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَن ہِلالِ بْنِ یَِسَافٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ، عَنِ الرَّبِیعِ بْنِ خُثَیْمٍ ، عَنْ عَبْدِ اللہِ ، قَالَ: مَنْ قَالَ عَشْرَ مَرَّاتٍ: لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، کُنَّ لہ کَعَدْلِ أَرْبَعِ رِقَابٍ ، أُرَاہُ قَالَ : مِنْ وَلَدِ إسْمَاعِیلَ۔","Sahih","Musannaf Ibn Abi Shaybah 30073","","","كتاب الدعاء"
"30074","(۳۰۰۷۴) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَن ہِلالٍ ، عَن أُمِّ الدَّرْدَائِ قَالَتْ : مَنْ قَالَ مِئَۃ مَرَّۃٍ غَدْوَۃً وَمِئَۃَ مَرَّۃٍ عَشِیَّۃً : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، لَمْ یَجِئْ أَحَدٌ یَوْمَ الْقِیَامَۃِ بِمِثْلِ مَا جَائَ بِہِ إِلاَّ مَنْ قَالَ مِثْلَہُنَّ ، أَوْ زَادَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30074","","","كتاب الدعاء"
"30075","(۳۰۰۷۵) حَدَّثَنَا شَرِیکٌ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ مُعَاذُ بْنُ جَبَلٍ : لَوْ أَنَّ رَجُلَیْنِ یَحْمِلُ أَحَدُہُمَا عَلَی الْجِیَادِ فِی سَبِیلِ اللہِ وَالآخَرُ یَذْکُرُ اللَّہَ لَکَانَ أَفْضَلَ ، أَوْ أَعْظَمَ أَجْرًا الذَّاکِرُ۔","","Musannaf Ibn Abi Shaybah 30075","","","كتاب الدعاء"
"30076","(۳۰۰۷۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَن مُفَضَّلٍ ، عَن مَنْصُورٍ ، عَن مُجَاہِدٍ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الحارث بن ہِشَامٍ ، عَن کَعْبٍ ، قَالَ : قَالَ مُوسَی : یَا رَبِّ دُلَّنِی عَلَی عَمَلٍ إذَا عَمِلْتہ کَانَ شُکْرًا لَکَ فِیمَا اصْطَنَعْت إلَیَّ ، قَالَ : یَا مُوسَی قُلْ : لاَ إلَہَ إِلاَّ اللَّہُ ، أَوْ قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، قَالَ : فَکَأَنَّ مُوسَی أَرَادَ مِنَ الْعَمَلِ مَا ہُوَ أَنْہَکُ لِجِسْمِہِ مِمَّا أُمِرَ بِہِ ، قَالَ : فَقَالَ لَہُ : یَا مُوسَی لَوْ أَنَّ السَّمَاوَاتِ السَّبْعَ وَالأَرْضِینَ السَّبْعَ وُضِعَتْ فِی کِفَّۃٍ ، وَوُضِعَتْ لاَ إلَہَ إِلاَّ اللَّہُ فِی کِفَّۃٍ لَرَجَحَتْ بِہِنَّ۔","","Musannaf Ibn Abi Shaybah 30076","","","كتاب الدعاء"
"30077","(۳۰۰۷۷) حَدَّثَنَا شَرِیکٌ ، عَنِ الأَعْمَشِ ، عَن سَالِمٍ ، قَالَ ، قِیلَ لأَبِی الدَّرْدَائِ : إنَّ أَبَا سَعْدِ بْنَ مُنَبِّہٍ جَعَلَ فِی مَالِہِ مِئَۃ مُحَرَّرَۃً ، فَقَالَ : إنَّ مِئَۃ مُحَرَّرَۃً فِی مَالِ رَجُلٍ لَکَثِیرٌ ، أَلا أُخْبِرُکُمْ بِأَفْضَلَ مِنْ ذَلِکَ ، إیمَانًا بلْزُومِ اللَّیْلِ وَالنَّہَارِ ، وَلا یَزَالُ لِسَانُک رَطْبًا مِنْ ذِکْرِ اللہِ۔","","Musannaf Ibn Abi Shaybah 30077","","","كتاب الدعاء"
"30078","(۳۰۰۷۸) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَن مُسْلِمٍ ، عَن سُوَیْد بْنِ جُہَیْلٍ ، قَالَ : مَنْ قَالَ بَعْدَ الْعَصْرِ : لاَ إلَہَ إِلاَّ اللَّہُ لَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، قَاتَلْنَ عَن قَائِلِہَا إِلَی مِثْلِہَا مِنَ الْغَدِ۔","","Musannaf Ibn Abi Shaybah 30078","","","كتاب الدعاء"
"30079","(۳۰۰۷۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَن مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَن مُسْلِمٍ مَوْلَی سُوَیْد بْنِ جُہَیْلٍ ، عَن سُوَیْد ، قَالَ : کَانَ مِنْ أَصْحَابِ عُمَرَ ، ثُمَّ ذَکَرَ نَحْوَ حَدِیثِ وَکِیعٍ۔","","Musannaf Ibn Abi Shaybah 30079","","","كتاب الدعاء"
"30080","(۳۰۰۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ حَدَّثَنَا مِسْعَرٌ ، عَن سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی عُبَیْدَۃَ ، قَالَ : الْعَبْدُ مَا ذُکِرَ اللَّہَ ، فَہُوَ فِی صَلاۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 30080","","","كتاب الدعاء"
"30081","(۳۰۰۸۱) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَن سَالِمٍ ، عَن مَسْرُوقٍ ، قَالَ : مَا دَامَ قَلْبُ الرَّجُلِ یَذْکُرُ اللَّہَ ، فَہُوَ فِی صَلاۃٍ ، وَإِنْ کَانَ فِی السُّوقِ۔","","Musannaf Ibn Abi Shaybah 30081","","","كتاب الدعاء"
"30082","(۳۰۰۸۲) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَن ہِلالٍ عَن أَبِی عُبَیْدَۃَ قَالَ : مَا دَامَ قَلْبُ الرَّجُلِ یَذْکُرُ اللہ ، فَہُوَ فِی صَلاۃٍ ، وَإِنْ کَانَ فِی السُّوقِ ، وَإِنْ یُحَرِّکْ بِہِ شَفَتَیْہِ ، فَہُوَ أَفْضَلُ۔","","Musannaf Ibn Abi Shaybah 30082","","","كتاب الدعاء"
"30083","(۳۰۰۸۳) حَدَّثَنَا مَرْحُومُ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ أَبِی نَعَامَۃَ السَّعْدِیِّ ، عَنْ أَبِی عُثْمَانَ النَّہْدِیِّ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : خَرَجَ مُعَاوِیَۃُ عَلَی حَلْقَۃٍ فِی الْمَسْجِدِ فَقَالَ : مَا أَجْلَسَکُمْ قَالُوا : جَلَسْنَا نَذْکُرُ اللَّہَ وَنَحْمَدُہُ عَلَی مَا ہَدَانَا لِلإِسْلامِ وَمَنَّ عَلَیْنَا بِہِ ، قَالَ : آللہِ مَا أَجْلَسَکُمْ إِلاَّ ذَاکَ ، قَالُوا : وَاللہِ مَا أَجْلَسَنَا إِلاَّ ذَاکَ ، فَقَالَ : أَمَّا إنِّی لَمْ أَسْتَحْلِفْکُمْ تُہْمَۃً لَکُمْ ، وَمَا مِنْ أَحَدٍ بِمَنْزِلَۃٍ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَقَلَّ عَنْہُ حَدِیثًا مِنِّی ، وَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَرَجَ عَلَی حَلْقَۃٍ مِنْ أَصْحَابِہِ فَقَالَ : مَا أَجْلَسَکُمْ ؟ فَقَالُوا : جَلَسْنَا نَذْکُرُ اللَّہَ وَنَحْمَدُہُ عَلَی مَا ہَدَانَا لِلإِسْلامِ وَمَنَّ عَلَیْنَا بِہِ ، قَالَ : آللہِ مَا أَجْلَسَکُمْ إِلاَّ ذَاکَ ، قَالُوا : وَاللہِ مَا أَجْلَسَنَا إِلاَّ ذَاکَ ، فَقَالَ : أَمَّا إنِّی لَمْ أَسْتَحْلِفْکُمْ تُہْمَۃً لَکُمْ وَلَکِنِّی أَتَانِی جِبْرِیلُ فَأَخْبَرَنِی ، أَنَّ اللَّہَ یُبَاہِی بِکُمَ الْمَلائِکَۃَ۔ (مسلم ۲۰۷۵۔ ترمذی ۳۳۷۹)","Sahih","Musannaf Ibn Abi Shaybah 30083","","","كتاب الدعاء"
"30084","(۳۰۰۸۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَن مُحَمَّدِ بْنِ إبْرَاہِیمَ ، قَالَ : قَالَ عبَادَۃُ بْنُ الصَّامِتِ : لأَنْ أَکُونَ فِی قَوْمٍ یَذْکُرُونَ اللَّہَ مِنْ حِینَ یُصَلُّونَ الْغَدَاۃَ إِلَی حِینَ تَطْلُعُ الشَّمْسُ أَحَبُّ إلَیَّ مِنْ أَنْ أَکُونَ عَلَی مُتُونِ الْخَیْلِ أُجَاہِدُ فِی سَبِیلِ اللہِ إِلَی أَنْ تَطْلُعَ الشَّمْسُ ، وَلأَنْ أَکُونَ فِی قَوْمٍ یَذْکُرُونَ مِنْ حِینَ یُصَلُّونَ الْعَصْرَ حَتَّی تَغْرُبَ الشَّمْسُ أَحَبُّ إلَیَّ مِنْ أَنْ أَکُونَ عَلَی مُتُونِ الْخَیْلِ أُجَاہِدُ فِی سَبِیلِ اللہِ حَتَّی تَغْرُبَ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 30084","","","كتاب الدعاء"
"30085","(۳۰۰۸۵) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَن سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، عَن سَلْمَانَ ، قَالَ : لَوْ بَاتَ رَجُلٌ یُعْطِی الْقنَان الْبِیضَ وَبَاتَ آخَرُ یَقْرَأُ الْقُرْآنَ أَوْ یَذْکُرُ اللَّہَ تعالی لَرَأَیْت أَنَّ ذَلِکَ ، أَوْ قَالَ : أَنَّ ذَاکِرَ اللہِ أَفْضَلُ۔","Sahih","Musannaf Ibn Abi Shaybah 30085","","","كتاب الدعاء"
"30086","(۳۰۰۸۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَبِی ہِلالٍ ، عَنْ أَبِی الْوَازِعِ جَابِرٍ الرَّاسِی ، عَنْ أَبِی بَرْزَۃَ ، قَالَ : لَوْ أَنَّ رَجُلَیْنِ أَحَدُہُمَا فِی حِجْرِہِ دَنَانِیرَ یُعْطِیہَا ، وَالآخَرُ یَذْکُرُ اللَّہَ ، کَانَ ذَاکِرُ اللہِ أَفْضَلَ۔","Hasan","Musannaf Ibn Abi Shaybah 30086","","","كتاب الدعاء"
"30087","(۳۰۰۸۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا مِسْعَرٌ ، قَالَ : حدَّثَنِی ثَعْلَبَۃُ بْنُ عَمْرٍو ، عَنْ عَمْرِو بْنِ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : لَوْ أَنَّ رَجُلَیْنِ أَقْبَلَ أَحَدُہُمَا مِنَ الْمَشْرِقِ وَالآخَرُ مِنَ الْمَغْرِبِ ، مَعَ أَحَدِہِمَا ذَہَبٌ لاَ یَضَعُ مِنْہُ شَیْئًا إِلاَّ فِی حَقٍّ وَالآخَرُ یَذْکُرُ اللَّہَ حَتَّی یَلْتَقِیَا فِی طَرِیقٍ کَانَ الَّذِی یَذْکُرُ اللَّہَ أَفْضَلَہُمَا۔","","Musannaf Ibn Abi Shaybah 30087","","","كتاب الدعاء"
"30088","(۳۰۰۸۸) حَدَّثَنَا شَرِیکٌ ، عَن مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : مَا مِنْ شَیْئٍ أَحَبَّ إلی اللہ مِنَ الشُّکْرِ وَالذِّکْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30088","","","كتاب الدعاء"
"30089","(۳۰۰۸۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، حَدَّثَنَا عَمَّارُ بْنُ رُزَیْقٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَغَرِّ أَبِی مُسْلِمٍ، عَنْ أَبِی ہُرَیْرَۃَ، وَأَبِی سَعِیدٍ یَشْہَدَانِ بِہِ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ قَالَ: مَا جَلَسَ قَوْمٌ مُسْلِمُونَ مَجْلِسًا یَذْکُرُونَ اللَّہَ فِیہِ إِلاَّ حَفَّتْہُمُ الْمَلائِکَۃُ وَتَغَشَّتْہُمُ الرَّحْمَۃُ ، وَنَزَلَتْ عَلَیْہِمُ السَّکِینَۃُ ، وَذَکَرَہُمَ اللَّہُ فِیمَنْ عِنْدَہُ۔ (ترمذی ۳۳۷۸۔ ابن ماجہ ۳۷۹۱)","Sahih","Musannaf Ibn Abi Shaybah 30089","","","كتاب الدعاء"
"30090","(۳۰۰۹۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، أَخْبَرَنِی مَالِکُ بْنُ أَنَسٍ ، قَالَ : أَخْبَرَنِی سُمِیٌّ مَوْلَی أَبِی بَکْرٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَالَ فِی یَوْمٍ مِئَۃ مَرَّۃٍ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، کَانَ لَہُ کَعَدْلِ عَشْرِ رِقَابٍ ، وَکُتِبَتْ لَہُ مِئَۃ حَسَنَۃٍ ، وَمُحِیَ عَنْہُ مِئَۃ سَیِّئَۃٍ ، وَکَانت لَہُ حِرْزًا مِنَ الشَّیْطَانِ سَائِرَ یَوْمہ إِلَی اللَّیْلِ ، وَلَمْ یَأْتِ أَحَدٌ بِأَفْضَلَ مِمَّا أَتَی بِہِ إِلاَّ مَنْ قَالَ أَکْثَرَ۔ (بخاری ۳۲۹۳۔ مسلم ۲۰۷۱)","Sahih","Musannaf Ibn Abi Shaybah 30090","","","كتاب الدعاء"
"30091","(۳۰۰۹۱) حَدَّثَنَا عَفَّانُ حَدَّثَنَا أَبَانُ بْنُ یَزِیدَ الْعَطَّارُحَدَّثَنَا قَتَادَۃُ ، قَالَ : حدَّثَ أَبُو الْعَالِیَۃِ الرِّیَاحِیُّ ، عَن حَدِیثِ سُہَیْلِ بْنِ حَنْظَلَۃَ الْعَبْشَمِیِّ ، أَنَّہُ قَالَ : مَا اجْتَمَعَ قَوْمٌ قط یَذْکُرُونَ اللَّہَ إِلاَّ نَادَی مُنَادٍ مِنَ السَّمَائِ : قُومُوا مَغْفُورًا لَکُمْ ، قَدْ بُدِّلَتْ سَیِّئَاتُکُمْ حَسَنَاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30091","","","كتاب الدعاء"
"30092","(۳۰۰۹۲) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ مَنْصُورٍ ، عَن ہِلالِ بْنِ یَِسَافٍ ، قَالَ : کَانَتِ امْرَأَۃٌ مِنْ ہَمْدَانَ تُسَبِّحُ وَتُحْصِیہِ بِالْحَصْباء ، أَوِ النَّوَی فَمَرَّتْ عَلَی عَبْدِ اللہِ ، فَقِیلَ لَہُ : ہَذِہِ الْمَرْأَۃُ تُسَبِّحُ وَتُحْصِیہِ بِالْحَصَی ، أَوِ النَّوَی ، فَدَعَاہَا فَقَالَ : لَہَا : أَنْتِ الَّتِی تُسَبِّحِینَ وَتُحْصِینَ ؟ فَقَالَتْ : نَعَمْ إنِّی لأَفْعَلُ ، فَقَالَ : أَلا أَدُلُّک عَلَی خَیْرٍ مِنْ ذَلِکَ ، تَقُولِینَ : اللَّہُ أَکْبَرُ کَبِیرًا ، وَالْحَمْدُ للہِ کَثِیرًا ، وَسُبْحَانَ اللہِ بُکْرَۃً وَأَصِیلاً۔","Sahih","Musannaf Ibn Abi Shaybah 30092","","","كتاب الدعاء"
"30093","(۳۰۰۹۳) حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الأَغَرِّ أَبِی مُسْلِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِیمَا یُحَدِّثُ ، عَن رَبِّہِ ، قَالَ : مَنْ ذَکَرَنِی فِی نَفْسِہِ ذَکَرْتہ فِی نَفْسِی ، وَمَنْ ذَکَرَنِی فِی مَلأٍ مِنَ النَّاسِ ذَکَرْتہ فِی مَلأٍ أَکثر مِنْہُمْ وَأَطْیَبَ۔ (احمد ۳۵۴۔ ابن حبان ۳۲۸)","Sahih","Musannaf Ibn Abi Shaybah 30093","","","كتاب الدعاء"
"30094","(۳۰۰۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، عَن سَلْمَانَ ، قَالَ : إذَا کَانَ الْعَبْدُ یَحْمَدُ اللَّہَ فِی السَّرَّائِ وَیَحْمَدُہُ فِی الرَّخَائِ فَأَصَابَہُ ضُرٌّ فَدَعَا اللَّہَ قَالَتِ الْمَلائِکَۃُ : صَوْتٌ مَعْرُوفٌ مِنَ امْرِئٍ ضَعِیفٍ فَیَشْفَعُونَ لَہُ وَإِذَا کَانَ الْعَبْدُ لاَ یَذْکُرُ اللَّہَ فِی السَّرَّائِ ، وَلا یَحْمَدُہُ فِی الرَّخَائِ فَأَصَابَہُ ضُرٌّ فَدَعَا اللَّہَ قَالَتِ الْمَلائِکَۃُ : صَوْتٌ مُنْکَرٌ۔","Sahih","Musannaf Ibn Abi Shaybah 30094","","","كتاب الدعاء"
"30095","(۳۰۰۹۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الأَصْبَغِ بْنِ زَیْدٍ ، عَن ثَوْرٍ ، عَن خَالِدِ بْنِ مَعْدَانَ ، قَالَ : إنَّ اللَّہَ یَتَصَدَّقُ کُلَو یَوْمٍ بِصَدَقَۃٍ فَمَا تَصَدَّقَ عَلَی عَبْدِہِ بِشَیْئٍ أَفْضَلَ مِنْ ذِکْرِہِ۔","","Musannaf Ibn Abi Shaybah 30095","","","كتاب الدعاء"
"30096","(۳۰۰۹۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَنْ قَالَ فِی یَوْمٍ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ ، وَلَہُ الْحَمْدُ ، وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، کُنَّ لَہُ عَدْلَ أَرْبَعِ رَقَابات یُعْتِقُہُنَّ مِنْ وَلَدِ إسْمَاعِیلَ۔","Sahih","Musannaf Ibn Abi Shaybah 30096","","","كتاب الدعاء"
"30097","(۳۰۰۹۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ، عَن زَائِدَۃَ، عَن مَنْصُورٍ، عَن طَلْحَۃَ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَۃَ، عَنِ الْبَرَائِ بْنِ عَازِبٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ قَالَ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، عَشْرَ مَرَّاتٍ کُنَّ لَہُ کَعَدْلِ نَسَمَۃٍ۔ (نسائی ۹۹۵۳۔ طبرانی ۱۷۱۷)","Sahih","Musannaf Ibn Abi Shaybah 30097","","","كتاب الدعاء"
"30098","(۳۰۰۹۸) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ حَدَّثَنَا إسْمَاعِیلُ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، عَنْ أَبِی رُعَافَۃَ رَجُلٌ مِنَ الأَنْصَارِ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : مَنْ قَالَ فِی الْیَوْمِ مِئَۃ مَرَّۃٍ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، لَمْ یَجِئْ أَحَدٌ مِنْ أَہْلِ الدُّنْیَا بِأَفْضَلَ مِمَّا جَائَ بِہِ إِلاَّ إنْسَانٌ یَزِیدُ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30098","","","كتاب الدعاء"
"30099","(۳۰۰۹۹) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، أَنَّ عُمَرَ خَرَجَ یَسْتَسْقِی فَصَعِدَ الْمِنْبَرَ فَقَالَ : {اسْتَغْفِرُوا رَبَّکُمْ إِنَّہُ کَانَ غَفَّارًا یُرْسِلِ السَّمَائَ عَلَیْکُمْ مِدْرَارًا وَیُمْدِدْکُمْ بِأَمْوَالٍ وَبَنِینَ وَیَجْعَلْ لَکُمْ جَنَّاتٍ وَیَجْعَلْ لَکُمْ أَنْہَارًا} وَ {اسْتَغْفِرُوا رَبَّکُمْ إِنَّہُ کَانَ غَفَّارًا} ثُمَّ نَزَلَ فَقِیلَ لَہُ : یَا أَمِیرَ الْمُؤْمِنِینَ ، لَوِ اسْتَسْقَیْت فَقَالَ : لَقَدْ طَلَبْت بِمَجَادِیحِ السَّمَائِ الَّتِی یُسْتَنْزَلُ بِہَا الْقَطْرُ۔","","Musannaf Ibn Abi Shaybah 30099","","","كتاب الدعاء"
"30100","(۳۰۱۰۰) حَدَّثَنَا وَکِیعٌ ، عَن عِیسَی بْنِ حَفْصٍ ، عَنْ عَطَائِ بْنِ أَبِی مَرْوَانَ ، عَنْ أَبِیہِ ، قَالَ : خَرَجْنَا مَعَ عُمَرَ بْنِ الْخَطَّابِ نَسْتَسْقِی فَمَا زَادَ عَلَی الاسْتِغْفَارِ۔","Hasan","Musannaf Ibn Abi Shaybah 30100","","","كتاب الدعاء"
"30101","(۳۰۱۰۱) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَن زَیْدِ الْعَمِّیِّ ، عَنْ أَبِی الصِّدِّیقِ النَّاجِی ، أَنَّ سُلَیْمَانَ بْنَ دَاوُد خَرَجَ بِالنَّاسِ یَسْتَسْقِی فَمَرَّ عَلَی نَمْلَۃٍ مُسْتَلْقِیَۃٍ عَلَی قَفَاہَا رَافِعَۃٍ قَوَائِمَہَا إِلَی السَّمَائِ وَہِیَ تَقُولُ ، اللَّہُمَّ إنَّا خَلْقٌ مِنْ خَلْقِکَ لَیْسَ لَنَا غِنًی عَن رِزْقِکَ ، فَإِمَّا أَنْ تَسْقِیَنَا وَإِمَّا أَنْ تُہْلِکَنَا، فَقَالَ: سُلَیْمَانُ لِلنَّاسِ: ارْجِعُوا، فَقَدْ سُقِیتُمْ بِدَعْوَۃِ غَیْرِکُمْ۔","","Musannaf Ibn Abi Shaybah 30101","","","كتاب الدعاء"
"30102","(۳۰۱۰۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن مُسْلِمٍ ، عَن مَسْرُوقٍ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَوِّذُ بِہَذِہِ الْکَلِمَاتِ : أَذْہِبِ الْبَأْسَ رَبَّ النَّاسِ وَاشْفِ أَنْتَ الشَّافِی لاَ شِفَائَ إِلاَّ شِفَاؤُک شِفَائً لاَ یُغَادِرُ سَقَمًا ، قَالَتْ : فَلَمَّا ثَقُلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَرَضِہِ الَّذِی مَاتَ فِیہِ أَخَذْت بِیَدِہِ فَجَعَلْتُ أَمْسَحُہَا وَأَقُولُہَا ، قَالَتْ : فَنَزَعَ یَدَہُ مِنْ یَدَیْ ، وَقَالَ : اللَّہُمَّ اغْفِرْ لِی وَأَلْحِقْنِی بِالرَّفِیقِ ، قَالَتْ : فَکَانَ ہَذَا آخِرَ مَا سَمِعْت مِنْ کَلامِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30102","","","كتاب الدعاء"
"30103","(۳۰۱۰۳) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ أَبِی الضُّحَی ، عَن مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِ حَدِیثِ أَبِی مُعَاوِیَۃَ إِلاَّ أَنَّہُ لَمْ یَقُلْ : فَلَمَّا ثَقُلَ۔ (مسلم ۱۷۲۲۔ ابن ماجہ ۳۵۲۰)","Sahih","Musannaf Ibn Abi Shaybah 30103","","","كتاب الدعاء"
"30104","(۳۰۱۰۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَن سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَن مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کان یَقُولُ لِلْمَرِیضِ : أَذْہِبَ الْبَأْسَ رَبَّ النَّاسِ وَاشْفِ أَنْتَ الشَّافِی لاَ شِفَائَ إِلاَّ شِفَاؤُک شِفَائً لاَ یُغَادِرُ سَقَمًا ، قَالَ سُفْیَانُ : فَذَکَرْتہ لِمَنْصُورٍ فَحَدَّثَنِی ، عَنْ إبْرَاہِیمَ ، عَن مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔ (بخاری ۵۷۵۰۔ مسلم ۱۷۲۲)","Sahih","Musannaf Ibn Abi Shaybah 30104","","","كتاب الدعاء"
"30105","(۳۰۱۰۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا دَخَلَ عَلَی مَرِیضٍ ، قَالَ : أَذْہِبِ الْبَأْسَ رَبَّ النَّاسِ وَاشْفِ أَنْتَ الشَّافِی لاَ شَافِیَ إِلاَّ أَنْتَ۔","Da'if","Musannaf Ibn Abi Shaybah 30105","","","كتاب الدعاء"
"30106","(۳۰۱۰۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ رَبِّہِ ، عَنْ عَمْرَۃَ ، عَنْ عَائِشَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ مِمَّا یَقُولُ لِلْمَرِیضِ ، بِبُزَاقِہِ بِإِصْبَعِہِ ، بِسْمِ اللہِ تُرْبَۃُ أَرْضِنَا بَرِیقَۃُ بَعْضِنَا یُشْفَی سَقِیمُنَا بِإِذْنِ رَبِّنَا۔","Sahih","Musannaf Ibn Abi Shaybah 30106","","","كتاب الدعاء"
"30107","(۳۰۱۰۷) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، عَن زِیَادِ بْنِ ثُوَیْبٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : دَخَلَ عَلَیَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا أَشْتَکِی ، فَقَالَ : أَلا أَرْقِیک بِرُقْیَۃٍ عَلَّمَنِیہَا جِبْرِیلُ : بِسْمِ اللہِ أَرْقِیک ، وَاللَّہُ یَشْفِیک مِنْ کُلِّ أَرِبٍ یُؤْذِیک ، وَمِنْ شَرِّ النَّفَّاثَاتِ فِی الْعُقَدِ وَمِنْ شَرِّ حَاسِدٍ إذَا حَسَدَ۔","Da'if","Musannaf Ibn Abi Shaybah 30107","","","كتاب الدعاء"
"30108","(۳۰۱۰۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن حَجَّاجٍ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ دَخَلَ عَلَی مَرِیضٍ لَمْ تَحْضُرْ وَفَاتُہُ فَقَالَ : أَسْأَلُ اللَّہَ الْعَظِیمِ رَبَّ الْعَرْشِ الْعَظِیمِ أَنْ یَشْفِیَک سَبْعَ مَرَّاتٍ شُفِیَ۔","","Musannaf Ibn Abi Shaybah 30108","","","كتاب الدعاء"
"30109","(۳۰۱۰۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ، قَالَ : أَخْبَرَنِی عُمَیْرُ بْنُ ہَانِئٍ ، قَالَ : سَمِعْتُ جُنَادَۃَ بْنَ أَبِی أُمِّیَّۃَ یَقُولُ : سَمِعْت عُبَادَۃَ بْنَ الصَّامِتِ یُحَدِّثُ ، عَن رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّ جِبْرِیلَ رَقَاہُ وَہُوَ یُوعَکُ فَقَالَ : بِسْمِ اللہِ أَرْقِیک مِنْ کُلِّ دَائٍ یُؤْذِیک مِنْ کُلِّ حَاسِدٍ إذَا حَسَدَ وَمِنْ کُلِّ عَیْنٍ ، وَاسْمُ اللہِ یَشْفِیک۔","Da'if","Musannaf Ibn Abi Shaybah 30109","","","كتاب الدعاء"
"30110","(۳۰۱۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، حَدَّثَنَا زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ ، حَدَّثَنَا سِمَاکٌ ، عَن مُحَمَّدِ بْنِ حَاطِبٍ ، قَالَ : تَنَاوَلْت قِدْرًا لَنَا فَاحْتَرَقَتْ یَدَیَّ فَانْطَلَقَتْ بِی أُمِّی إِلَی رَجُلٍ جَالِسٍ فِی الْجَبَّانَۃِ ، فَقَالَتْ لَہُ : یَا رَسُولَ اللہِ ، فَقَالَ : لَبَّیْکَ وَسَعْدَیْکَ ، ثُمَّ أَدْنَتْنِی مِنْہُ فَجَعَلَ یَنْفُثُ وَیَتَکَلَّمُ لاَ أَدْرِی مَا ہُوَ ، فَسَأَلْت أُمِّی بَعْدَ ذَلِکَ مَا کَانَ یَقُولُ ؟ قَالَتْ : کَانَ یَقُولُ : أَذْہِبِ الْبَأْسَ رَبَّ النَّاسِ وَاشْفِ أَنْتَ الشَّافِی لاَ شَافِیَ إِلاَّ أَنْتَ۔","Hasan","Musannaf Ibn Abi Shaybah 30110","","","كتاب الدعاء"
"30111","(۳۰۱۱۱) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَن مَنْصُورٍ ، عَنِ الْمِنْہَالِ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابن عباس أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُعَوِّذُ الْحَسَنَ وَالْحُسَیْنَ بِہَؤُلائِ الْکَلِمَاتِ : أُعِیذُکُمَا بِکَلِمَاتِ اللہِ التَّامَّۃِ مِنْ شَرِّ کُلِّ شَیْطَانٍ وَہَامَّۃٍ وَشَرِّ کُلِّ عَیْنٍ لامَّۃٍ ، قَالَ : وَکَانَ إبْرَاہِیمُ یُعَوِّذُ بِہَا إسْمَاعِیلَ وَإِسْحَاقَ۔","Sahih","Musannaf Ibn Abi Shaybah 30111","","","كتاب الدعاء"
"30112","(۳۰۱۱۲) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، حَدَّثَنَا سُفْیَانُ ، عَن مَنْصُورٍ ، عَنِ الْمِنْہَالِ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَوِّذُ الْحَسَنَ وَالْحُسَیْنَ ، ثُمَّ ذَکَرَ مِثْلَہُ إِلاَّ أَنَّہُ لَمْ یَقُلْ : وَشَرِّ۔","Sahih","Musannaf Ibn Abi Shaybah 30112","","","كتاب الدعاء"
"30113","(۳۰۱۱۳) حَدَّثَنَا وَکِیعٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَنْ عَلِیٍّ ، قَالَ : اشْتَکَیْت فَدَخَلَ عَلَیَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا أَقُولُ : اللَّہُمَّ إِنْ کَانَ أَجَلِی قَدْ حَضَرَ فَأَرِحْنِی ، وَإِنْ کَانَ مُتَأَخِّرًا فَاشْفِنِی ، أَوْ عَافِنِی ، وَإِنْ کَانَ بَلائً فَصَبِّرْنِی ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَیْفَ قُلْتَ ؟ قَالَ : فَقُلْتُ لَہُ ، فَمَسَحَنِی بِیَدِہِ ، ثم قَالَ : اللَّہُمَّ اشْفِہِ ، أَوْ عَافِہِ فَمَا اشْتَکَیْت ذَلِکَ الْوَجَعَ بَعْدُ۔","Hasan","Musannaf Ibn Abi Shaybah 30113","","","كتاب الدعاء"
"30114","(۳۰۱۱۴) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، حَدَّثَنَا زُہَیْرُ بْنُ مُحَمَّدٍ ، عَن یَزِیدَ بْنِ خُصَیْفَۃَ ، عَنْ عُمَرَ بْنِ عَبْدِ اللہِ بْنِ کَعْبٍ ، عَن نَافِعِ بْنِ جُبَیْرٍ، عَن عُثْمَانَ بْنِ أَبِی الْعَاصِ الثَّقَفِیِّ، قَالَ: قدِمْت عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَبِی وَجَعٌ قَدْ کَادَ یبطلنی ، فَقَالَ لی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اجْعَلْ یَدَکَ الْیُمْنَی عَلَیْہِ ، ثُمَّ قُلِ : بِسْمِ اللہِ أَعُوذُ بِعِزَّۃِ اللہِ وَقُدْرَتِہِ مِنْ شَرِّ مَا أَجِدُ ، سَبْعَ مَرَّاتٍ ، فَفَعَلْتُ ، فَشَفَانِی اللَّہُ عَزَّ وَجَلَّ۔","Sahih","Musannaf Ibn Abi Shaybah 30114","","","كتاب الدعاء"
"30115","(۳۰۱۱۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ إبْرَاہِیمَ بْنِ إسْمَاعِیلَ بْنِ أَبِی حَبِیبَۃَ ، قَالَ : حدَّثَنِی دَاوُد بْنُ الْحُصَیْنِ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ ، کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَلِّمُنَا مِنَ الأَوْجَاعِ کُلِّہَا وَالْحُمَّی ہَذَا الدُّعَائَ : بِسْمِ اللہِ الْکَبِیرِ أَعُوذُ بِاللہِ الْعَظِیمِ مِنْ شَرِّ کُلِّ عِرْقٍ نَعَّار ، وَمِنْ شَرِّ حَرِّ النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 30115","","","كتاب الدعاء"
"30116","(۳۰۱۱۶) حَدَّثَنَا مُحَمَّدُ بْنُ الْفُضَیْلِ ، عَنِ الْعَلائِ بْنِ الْمُسَیَّبِ ، عَنِ الْفُضَیْلِ بْنِ عَمْرٍو ، قَالَ : جَائَ رَجُلٌ إِلَی عَلِیٍّ، قَالَ : إنَّ فُلانًا شَاکٍ ، قَالَ : یَسُرُّک أَنْ یَبْرَأَ قَالَ : نَعَمْ ، قَالَ : قُلْ : یَا حَلِیمُ یَا کَرِیمُ اشْفِ ثَلاثًا۔","","Musannaf Ibn Abi Shaybah 30116","","","كتاب الدعاء"
"30117","(۳۰۱۱۷) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللہِ حَدَّثَنَا أَبُو شِہَابٍ ، عَن دَاوُد ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : اشْتَکَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَرَقَاہُ جِبْرِیلُ فَقَالَ : بِسْمِ اللہِ أَرْقِیک مِنْ کُلِّ شَیْئٍ یُؤْذِیک مِنْ کُلِّ حَاسِدٍ وَعَیْنٍ ، وَاللَّہُ یَشْفِیک۔","Sahih","Musannaf Ibn Abi Shaybah 30117","","","كتاب الدعاء"
"30118","(۳۰۱۱۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَمْرَۃَ بِنْتِ عَبْدِ الرَّحْمَنِ قَالَتْ : اشْتَکَتْ عَائِشَۃُ أُمُّ الْمُؤْمِنِینَ ، وَإِنَّ أَبَا بَکْرٍ دَخَلَ عَلَیْہَا وَیَہُودِیَّۃ تَرْقِیہَا فَقَالَ : ارْقِیہَا بِکِتَابِ اللہِ۔","","Musannaf Ibn Abi Shaybah 30118","","","كتاب الدعاء"
"30119","(۳۰۱۱۹) حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن حُمَیْدٍ ، عَنْ أَنَسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا دَخَلَ عَلَی مَرِیضٍ ، قَالَ : أَذْہِبَ الْبَأْسَ رَبَّ النَّاسِ وَاشْفِ أَنْتَ الشَّافِی لاَ شَافِیَ إِلاَّ أَنْتَ شِفَائً لاَ یُغَادِرُ سَقَمًا۔ (بخاری ۵۷۴۲۔ ابوداؤد ۳۸۸۶)","Sahih","Musannaf Ibn Abi Shaybah 30119","","","كتاب الدعاء"
"30120","(۳۰۱۲۰) حَدَّثَنَا عَبْدُاللہِ بْنُ نُمَیْرٍ حَدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ، عَن حَکِیمِ بْنِ حَکِیمٍ، عَنْ عَلِیِّ بْنِ عَبْدِالرَّحْمَنِ، عَن حُذَیْفَۃَ بْنِ الْیَمَانِ، قَالَ: خَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلَی حَرَّۃِ بَنِی مُعَاوِیَۃَ واتَّبَعْت أَثَرَہُ حَتَّی ظَہَرَ عَلَیْہَا فَصَلَّی الضُّحَی ، ثَمَانِ رَکَعَاتٍ طَوَّلَ فِیہِنَّ ، ثُمَّ انْصَرَفَ فَقَالَ : یَا حُذَیْفَۃُ طَوَّلْت عَلَیْک ، قُلْتُ: اللَّہُ وَرَسُولُہُ أَعْلَمُ ، قَالَ : إنِّی سَأَلْت اللَّہَ فِیہَا ثَلاثًا فَأَعْطَانِی اثْنَتَیْنِ وَمَنَعَنِی وَاحِدَۃً ، سَأَلْتُہُ أَنْ لاَ یُظْہِرَ عَلَی أُمَّتِی غَیْرَہَا فَأَعْطَانِی ، وَسَأَلْتُہُ أَنْ لاَ یُہْلِکَہَا بِالسِّنِینَ ، فَأَعْطَانِی وَسَأَلْتُہُ أَنْ لاَ یَجْعَلَ بَأْسَہَا بَیْنَہَا، فَمَنَعَنِی۔","Da'if","Musannaf Ibn Abi Shaybah 30120","","","كتاب الدعاء"
"30121","(۳۰۱۲۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن رَجَائٍ الأَنْصَارِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، عَن مُعَاذِ بْنِ جَبَلٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمًا صَلاۃً فَأَطَالَ فِیہَا ، فَلَمَّا انْصَرَفَ قُلْتُ : یَا رَسُولَ اللہِ ، لَقَدْ أَطَلْت الْیَوْمَ الصَّلاۃَ ، قَالَ : إنِّی صَلَّیْت صَلاۃَ رَغْبَۃٍ وَرَہْبَۃٍ وَسَأَلْت اللَّہَ لأُمَّتِی ثَلاثًا ، فَأَعْطَانِی ثِنْتَیْنِ وَرَدَّ عَلَیَّ وَاحِدَۃً ، سَأَلْتُہُ أَنْ لاَ یُسَلِّطَ عَلَیْہِمْ عَدُوًّا مِنْ غَیْرِہِمْ فَأَعْطَانِیہَا ، وَسَأَلْتُہُ أَنْ لاَ یُہْلِکَہُمْ غَرَقًا فَأَعْطَانِیہَا ، وَسَأَلْتُہُ أَنْ لاَ یَجْعَلَ بَأْسَہُمْ بَیْنَہُمْ ، فَرُدَّت عَلَیَّ۔ (احمد ۲۴۰۔ ابن خزیمہ ۱۲۱۸)","Da'if","Musannaf Ibn Abi Shaybah 30121","","","كتاب الدعاء"
"30122","(۳۰۱۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، حَدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ حَدَّثَنَا ثَابِتٌ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَن صُہَیْبٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا صَلَّی ہَمَسَ شَیْئًا لاَ یُخْبِرُنَا بِہِ ، فقُلْنَا : یَا رَسُولَ اللہِ ، إنَّک مِمَّا إذَا صَلَّیْت ہَمَسْت شَیْئًا لاَ نَفْقَہُہُ ، قَالَ ، فَطِنْتُمْ بِی ؟ قُلْتُ : نَعَمْ ، قَالَ : ذَکَرْت نَبِیًّا مِنَ الأَنْبِیَائِ أُعْطِیَ جُنُودًا مِنْ قَوْمِہِ ، فَنَظَرَ إِلَیْہِمْ ، فَقَالَ : مَنْ یُکَافِئُ ہَؤُلائِ ، قَالَ : فَقِیلَ لَہُ : اخْتَرْ لِقَوْمِکَ إحْدَی ثَلاثٍ : إمَّا أَنْ یُسَلِّطَ عَلَیْہِمْ عَدُوًّا مِنْ غَیْرِہِمْ ، أَوِ الْجُوعَ ، أَوِ الْمَوْتَ ، قَالَ : فَعَرَضَ ذَلِکَ عَلَی قَوْمِہِ ، قَالَ : فَقَالُوا : أَنْتَ نَبِیُّ اللہِ فَاخْتَرْ لَنَا ، قَالَ : فَقَامَ إِلَی الصَّلاۃِ ، قَالَ : وَکَانُوا مِمَّا إذَا فَزِعُوا فَزِعُوا إِلَی الصَّلاۃِ فَصَلَّی فَقَالَ : اللَّہُمَّ أما أن تُسَلِّطْ عَلَیْہِمْ مِنْ غَیْرِہِمْ فَلا ، أَو الْجُوعُ فَلا ، وَلَکِنَّ الْمَوْتَ ، قَالَ : فَسَلَّطَ عَلَیْہِمَ الْمَوْتَ ، فَمَاتَ مِنْہُمْ سَبْعُونَ أَلْفًا فِی ثَلاثَۃِ أَیَّامٍ ، قَالَ : فَہَمْسِی الَّذِی تَسْمَعُونَ أنی أَقُولُ : اللَّہُمَّ بِکَ أُحَاوِلُ وَبِکَ أُصَاوِلُ ، وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِکَ۔ (نسائی ۱۰۴۵۰۔ احمد ۳۳۳)","Sahih","Musannaf Ibn Abi Shaybah 30122","","","كتاب الدعاء"
"30123","(۳۰۱۲۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، حَدَّثَنَا عُثْمَانُ بْنُ حَکِیمٍ ، أَخْبَرَنَا عَامِرُ بْنُ سَعْدٍ ، عَنْ أَبِیہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَقْبَلَ ذَاتَ یَوْمٍ مِنَ الْعَالِیَۃِ حَتَّی إذَا مَرَّ بِمَسْجِدِ بَنِی مُعَاوِیَۃَ دَخَلَ فَرَکَعَ فِیہِ رَکْعَتَیْنِ وَصَلَّیْنَا مَعَہُ ، وَدَعَا رَبَّہُ طَوِیلاً ، ثُمَّ انْصَرَفَ إلَیْنَا فَقَالَ : سَأَلْتُ رَبِّی ثَلاثًا ، فَأَعْطَانِی اثْنَتَیْنِ وَرَدَّ عَلَیَّ وَاحِدَۃً ، سَأَلْت رَبِّی أَنْ لاَ یُہْلِکَ أُمَّتِی بِالسَّنَۃِ فَأَعْطَانِیہَا ، وَسَأَلْتُہُ أَنْ لاَ یُہْلِکَ أُمَّتِی بِالْغَرَقِ فَأَعْطَانِیہَا ، وَسَأَلْتُہُ أَنْ لاَ یَجْعَلَ بَأْسَہُمْ بَیْنَہُمْ ، فَمَنَعَنِیہَا۔ (مسلم ۲۲۱۶۔ احمد ۱۸۱)","Sahih","Musannaf Ibn Abi Shaybah 30123","","","كتاب الدعاء"
"30124","(۳۰۱۲۴) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَن کَثِیرِ بْنِ زَیْدٍ ، عَنِ الْمُطَّلِبِ بْنِ عَبْدِ اللہِ ، أَنَّ أَبَا بَکْرٍ کَانَ یَقُولُ : اللَّہُمَّ اجْعَلْ خَیْرَ عُمْرِی أَخِیرَہُ ، وَخَیْرَ عَمَلِی خَوَاتِمَہُ ، وَخَیْرَ أَیَّامِی یَوْمَ أَلْقَاک ، قَالَ : وَکَانَ عُمَرُ یَقُولُ : اللَّہُمَّ اعْصِمْنِی بِحَبْلِکَ وَارْزُقْنِی مِنْ فَضْلِکَ وَاجْعَلْنِی أَحْفَظُ أَمْرَک۔","","Musannaf Ibn Abi Shaybah 30124","","","كتاب الدعاء"
"30125","(۳۰۱۲۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ أَوَّلُ کَلامٍ تَکَلَّمَ بِہِ عُمَرُ أَنْ ، قَالَ : اللَّہُمَّ إنِّی ضَعِیفٌ فَقَوِّنِی وَإِنِّی شَدِیدٌ فَلَیِّنِی وَإِنِّی بَخِیلٌ فَسَخِّنِی۔","Da'if","Musannaf Ibn Abi Shaybah 30125","","","كتاب الدعاء"
"30126","(۳۰۱۲۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ حَدَّثَنَا إسْرَائِیلُ، عَنْ أَبِی إِسْحَاقَ عَن حَسَّانَ بْنِ فَائِدٍ الْعَبْسِیِّ، عَن عُمَرَ، أَنَّہُ کَانَ یَدْعُو : اللَّہُمَّ اجْعَلْ غِنَایَا فِی قَلْبِی وَرَغْبَتِی فِیمَا عِنْدَکَ وَبَارِکْ لِی فِیمَا رَزَقْتَنِی وَأَغْنِنِی عَمَّا حَرَّمْت عَلَیَّ۔","Hasan","Musannaf Ibn Abi Shaybah 30126","","","كتاب الدعاء"
"30127","(۳۰۱۲۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ حَدَّثَنَا مِسْعَرٌ ، عَنِ الرُّکَیْنِ ، عَنْ أَبِیہِ ، عَن عُمَرَ ، أَنَّہُ کَانَ یَقُولُ : اللَّہُمَّ أَسْتَغْفِرُک لِذَنْبِی ، وَأَسْتَہْدِیک لِمَرَاشِدِ أَمْرِی ، وَأَتُوبُ إلَیْک فَتُبْ عَلَیَّ إنَّک أَنْتَ رَبِّی ، اللَّہُمَّ فَاجْعَلْ رَغْبَتِی إِلَیْکَ ، وَاجْعَلْ غِنَایَا فِی صَدْرِی ، وَبَارِکْ لِی فِیمَا رَزَقْتَنِی ، وَتَقَبَّلْ مِنِّی إِنَّکَ أَنْتَ رِبِّی۔","","Musannaf Ibn Abi Shaybah 30127","","","كتاب الدعاء"
"30128","(۳۰۱۲۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : قَالَ رَجُلٌ عِنْدَ عُمَرَ اللَّہُمَّ اجْعَلْنِی مِنَ الْقَلِیلِ ، قَالَ ، فَقَالَ : عُمَرُ : مَا ہَذَا الَّذِی تَدْعُو بِہِ ؟ فَقَالَ : إنِّی سَمِعْت اللَّہَ یَقُولُ : وَقَلِیلٌ مِنْ عِبَادِی الشَّکُورُ فَأَنَا أَدْعُو أَنْ یَجْعَلَنِی مِنْ أُولَئِکَ الْقَلِیلِ ، قَالَ : فَقَالَ : عُمَرُ : کُلُّ النَّاسِ أَعْلَمُ مِنْ عُمَرَ۔","","Musannaf Ibn Abi Shaybah 30128","","","كتاب الدعاء"
"30129","(۳۰۱۲۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنْ أَبِی خَلْدَۃَ، عَنْ أَبِی الْعَالِیَۃِ قَالَ سَمِعْت عُمَرَ یَقُولُ اللَّہُمَّ عَافِنَا وَاعْفُ عَنَّا۔","Sahih","Musannaf Ibn Abi Shaybah 30129","","","كتاب الدعاء"
"30130","(۳۰۱۳۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن طُعْمَۃَ بْنِ عَبْدِ اللہِ ، عَن رَجُلٍ یُقَالُ لَہُ مِیکَائِیلُ شَیْخٌ مِنْ أَہْلِ خُرَاسَانَ ، قَالَ : کَانَ عُمَرُ إذَا قَامَ مِنَ اللَّیْلِ یقول : قَدْ تَرَی مَقَامِی وتعلم حَاجَتِی فَارْجِعْنِی مِنْ عِنْدِکَ یَا اللَّہُ بِحَاجَتِی مُفَلَّجًا مُنَجَّحًا مُسْتَجِیبًا مُسْتَجَابًا لِی ، قَدْ غَفَرْت لِی وَرَحِمَتْنِی فَإِذَا قَضَی صَلاتَہُ ، قَالَ : اللَّہُمَّ لاَ أَرَی شَیْئًا مِنَ الدُّنْیَا یَدُومُ ، وَلا أَرَی حَالاً فِیہَا یَسْتَقِیمُ ، اللَّہُمَّ اجْعَلْنِی أنْطِقُ فِیہَا بِعِلْمٍ وَأَصْمُتُ بِحُکْمٍ ، اللَّہُمَّ لاَ تُکْثِرْ لِی مِنَ الدُّنْیَا فَأَطْغَی ، وَلا تُقِلَّ لِی مِنْہَا فَأَنْسَی ، فَإِنَّہُ مَا قَلَّ وَکَفَی خَیْرٌ مِمَّا کَثُرَ وَأَلْہَی۔","Da'if","Musannaf Ibn Abi Shaybah 30130","","","كتاب الدعاء"
"30131","(۳۰۱۳۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن لَیْثٍ ، عَن سُلَیْمِ بْنِ حَنْظَلَۃَ ، عَن عُمَرَ ، أَنَّہُ کَانَ یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ أَنْ تَأْخُذَنِی عَلَی غِرَّۃٍ ، أَوْ تَذَرَنِی فِی غَفْلَۃٍ ، أَوْ تَجْعَلَنِی مِنَ الْغَافِلِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 30131","","","كتاب الدعاء"
"30132","(۳۰۱۳۲) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَنْ عَلِیٍّ ، أَنَّہُ کَانَ یَدْعُو : اللَّہُمَّ ثَبِّتْنَا عَلَی کَلِمَۃِ الْعَدْلِ بِالرِّضَی وَالصَّوَابِ ، وَقِوَامِ الْکِتَابِ ، ہَادِینَ مَہْدِیِّینَ رَاضِینَ مَرْضِیِّینَ ، غَیْرَ ضَالِّینَ، وَلا مُضِلِّینَ۔","Hasan","Musannaf Ibn Abi Shaybah 30132","","","كتاب الدعاء"
"30133","(۳۰۱۳۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَنِ الْوَلِیدِ بْنِ أَبِی الْوَلِیدِ عَمَّنْ حَدَّثَہُ ، عَنْ عَلِیٍّ ، أَنَّہُ کَانَ یَقُولُ فِی دُعَائِہِ : اللَّہُمَّ إنِّی أَسْأَلُک بِرَحْمَتِکَ الَّتِی وَسِعْت بِہَا کُلَّ شَیْئٍ ، وَبِعِزَّتِکَ الَّتِی أَذْلَلْتَ بِہَا کُلَّ شَیْئٍ ، وَخَضَعَ لَکَ بِہَا کُلَّ شَیْئٍ ، وَذَلَّ لَکَ بِہَا کُلَّ شَیْئٍ ، وَبِجَبَرُوتِکَ الَّتِی غَلَبْت بِہَا کُلَّ شَیْئٍ ، وَبِعَظَمَتِکَ الَّتِی غَلَبْت بِہَا کُلَّ شَیْئٍ ، وَبِسُلْطَانِکَ الَّذِی مَلأَت بِہِ کُلَّ شَیْئٍ ، وَبِقُوَّتِکَ الَّتِی لاَ یَقُومُ لَہَا شَیْئٌ ، وَبِنُورِکَ الَّذِی أَضَائَ لَہُ کُلُّ شَیْئٍ وَبِعِلْمِکَ الَّذِی أَحَاطَ بِکُلِّ شَیْئٍ ، وَبِاسْمِکَ الَّذِی یُبتدأ بِہِ کُلَّ شَیْئٍ ، وَبِوَجْہِکَ الْبَاقِی بَعْدَ فَنَائِ کُلِّ شَیْئٍ ، یَا نُورُ یَا قُدُّوسُ یَا نُورُ یَا قُدُّوسُ ثَلاثًا ، یَا أَوَّلَ الأَوَّلِینَ وَیَا آخِرَ الآخِرِینَ ، وَیَا اللَّہُ یَا رَحْمَانُ یَا رَحِیمُ ، اغْفِرْ لِی الذُّنُوبَ الَّتِی تُنْزِلُ النِّقَمَ ، وَاغْفِرْ لِی الذُّنُوبَ الَّتِی تہتک العصم ، وَاغْفِرْ لِی الذُّنُوبَ الَّتِی تُورِثُ النَّدَمَ ، وَاغْفِرْ لِی الذُّنُوبَ الَّتِی تَحْبِسُ الْقَسَمَ وَاغْفِرْ لِی الذُّنُوبَ الَّتِی تُغَیِّرُ النِّعَمَ ، وَاغْفِرْ لِی الذُّنُوبَ الَّتِی تُنْزِلُ الْبَلائَ ، وَتُدِیلُ الأَعْدَائَ ، وَاغْفِرْ لِی الذُّنُوبَ الَّتِی تَحْبِسُ غَیْثَ السَّمَائِ ، وَتُعَجِّلُ الْفَنَائَ ، وَتُظْلِمُ الْہَوَائَ ، وَتَرُدُّ الدُّعَائَ ، وَاغْفِرْ لِی الذُّنُوبَ الَّتِی ترِد إِلَی النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 30133","","","كتاب الدعاء"
"30134","(۳۰۱۳۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَبْدِ اللہِ الأَسَدِیِّ ، عَن رَجُلٍ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ یَقُولُ : اللَّہُمَّ یَا دَاحِیَ الْمَدحُوَّاتِ وَیَا بَانِیَ الْمَبْنِیَّاتِ وَیَا مُرْسِیَ الْمُرَسِّیَاتِ ، وَیَا جَبَّارَ الْقُلُوبِ عَلَی فِطْرَتِہَا شَقِیِّہَا وَسَعِیدِہَا ، وَبَاسِطَ الرَّحْمَۃِ لِلْمُتَّقِینَ ، اجْعَلْ شَرَائِفَ صَلَوَاتِکَ وَنَوَامِی بَرَکَاتِکَ وَرَأْفَاتِ تحننک ، وَعَوَاطِفَ زَوَاکِی رَحْمَتِکَ عَلَی مُحَمَّدٍ عَبْدِکَ وَرَسُولِکَ ، الْفَاتِحِ لِمَا أُغْلِقَ ، وَالْخَاتَمِ لِمَا سَبَقَ وَفَالِجِ الْحَقِّ بِالْحَقِ ، وَدَامِغِ جَاشِیَاتِ الأَبَاطِیلِ کَمَا حَمَّلْتَہُ ، فَاضْطَلَعَ بِأَمْرِکَ مُسْتَنْصِرًا فِی رِضْوَانِکَ غَیْرَ نَاکِلٍ عَن قَدَمٍ ، وَلا مُثْنِی عَنْ عَزْمٍ ، حَافِظٍ لِعَہْدِکَ ، مَاضٍ لِنَفَاذِ أَمْرِکَ ، حَتَّی أَورَی قبسا لقلبس آلاء اللہ تصل بآلہ أسبابہ بہ ہُدِیت الْقُلُوبِ ، بَعْدَ خَوْضَاتِ الْفِتَنِ والأثم وأنہج موضحات الأعلام إِلَی ودائرات الأَحْکَامِ ، فَہُوَ أَمِینُک الْمَأْمُونُ ، وَشَاہِدُک یَوْمَ الدِّینِ ، وَبَعِیثُکَ رَحْمَۃً لِلْعَالَمِینَ ، اللَّہُمَّ افْسَحْ لَہُ مُفْسَحًا عِنْدَکَ ، وَأَعْطِہِ بَعْدَ رِضَاہُ الرِّضَی مِنْ فَوْزِ ثَوَابِکَ الْمَحْلُولِ ، وَعَظِیمِ جَزَائِکَ الْمَعْلُولِ ، اللَّہُمَّ أَتْمِمْ لَہُ مَوْعِدَک بِابْتعَاثِکَ إیَّاہُ مَقْبُولَ الشَّفَاعَۃِ عَدْلَ الشَّہَادَۃِ مَرَضِیَّ الْمَقَالَۃِ ذَا مَنْطِقٍ عَدْلٍ وَخَطِیبٍ فَصْلٍ ، وَحُجَّۃٍ وَبُرْہَانٍ عَظِیمٍ ، اللَّہُمَّ اجْعَلْنَا سَامِعِینَ مُطِیعِینَ وَأَوْلِیَائَ مُخْلِصِینَ وَرُفَقَائَ مُصَاحِبِینَ ، اللَّہُمَّ أبْلِغْہُ مِنَّا السَّلامَ ، وَارْدُدْ عَلَیْنَا مِنْہُ السَّلامَ۔","Da'if","Musannaf Ibn Abi Shaybah 30134","","","كتاب الدعاء"
"30135","(۳۰۱۳۵) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ أَبِی جَعْفَرٍ مُحَمَّدٍ الْبَصْرِیِّ ، عَن رَجُلٍ یُدْعَی سَالِمًا ، قَالَ : کَانَ مِنْ دُعَائِ عَلِیٍّ : اللَّہُمَّ اجْعَلْنِی مِمَّنْ رَضِیتَ عَمَلَہُ وَقَصَّرْت أَمَلَہُ ، وَأَطَلْت عُمُرَہُ ، وَأَحْیَیْتہ بَعْدَ الْمَوْتِ حَیَاۃً طَیِّبَۃً وَرَزَقْتہ اللَّہُمَّ إنِّی أَسْأَلُک نَعِیمًا لاَ یَنْفَدُ ، وَفَرْحَۃً لاَ تَرْتَدُ ، وَمُرَافَقَۃَ نَبِیِّکَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَإِبْرَاہِیمَ فِی أَعْلَی جَنَّۃِ الْخُلْدِ ، اللَّہُمَّ ہَبْ لِی شفقا یَوْجَلُ لَہُ قَلْبِی ، وَتَدْمَعُ لَہُ عَیْنِی ، وَیَقْشَعِرُّ لَہُ جِلْدِی وَیَتَجَافَی لَہُ جَنْبِی ، وَأَجِدُ نَفْعَہُ فِی قَلْبِی ، اللَّہُمَّ طَہِّرْ قَلْبِی مِنَ النِّفَاقِ ، وَصَدْرِی مِنَ الْغِلِ ، وَأَعْمَالِی مِنَ الرِّیَائِ ، وَعَیْنِی مِنَ الْخِیَانَۃِ ، وَلِسَانِی مِنَ الْکَذِبِ ، وَبَارِکْ لِی فِی سَمْعِی وَقَلْبِی ، وَتُبْ عَلَیَّ إنَّک أَنْتَ التَّوَّابُ الرَّحِیمُ ، اللَّہُمَّ إنِّی أَعُوذُ بِوَجْہِکَ الْکَرِیمِ الَّذِی أَشْرَقَتْ لَہُ السَّمَاوَاتُ السَّبْعُ وَکُشِفَتْ بِہِ الظُّلُمَاتُ وَصَلُحَ عَلَیْہِ أَمْرُ الأَوَّلِینَ وَالآخِرِینَ مِنْ أَنْ یَحِلَّ عَلَیَّ غَضَبُک ، أَوْ یَنْزِلَ بِی سَخَطُک ، أَوْ أَتَّبِعَ ہَوَایَ بِغَیْرِ ہُدًی مِنْک ، أَوْ أَقُولَ لِلَّذِینَ کَفَرُوا {ہَؤُلائِ أَہْدَی مِنَ الَّذِینَ آمَنُوا سَبِیلاً} اللَّہُمَّ کُنْ بِی بَرًّا رَؤُوفًا رَحِیمًا بِحَاجَتِی حَفِیًّا ، اللَّہُمَّ اغْفِرْ لِی یَا غَفَّارُ ، وَتُبْ عَلَیَّ یَا تَوَّابُ ، وَارْحَمْنِی یَا رَحْمَنُ ، وَاعْفُ عَنِّی یَا حَلِیمُ ، اللَّہُمَّ ارْزُقْنِی زَہَادَۃً وَاجْتِہَادًا فِی الْعِبَادَۃِ ، وَلَقِّنِی إیَّاکَ عَلَی شَہَادَۃٍ یسبق بُشْرَاہَا وَجَعَہَا وَفَرْحُہَا جَزَعہَا ، یَا رَبِّ لَقِّنِّی عِنْدَ الْمَوْتِ نَضْرَۃً وَبَہْجَۃً وَقُرَّۃَ عَیْنٍ وَرَاحَۃً فِی الْمَوْتِ ، اللَّہُمَّ لَقِّنِّی فِی قَبْرِی ثَبَاتَ الْمَنْطِقِ وَقُرَّۃَ عَیْنِ الْمَنْظَرِ وَسَعَۃً فِی الْمَنْزِلِ ، اللَّہُمَّ قفنی مِنْ عَمَلِ یَوْمِ الْقِیَامَۃِ مَوْقِفًا تُبَیِّضُّ بِہِ وَجْہِی ، وتُثَبِّتُ بِہِ مَقَالَتِی ، وَتُقَرُّ بِہِ عَیْنِی ، وَتَنْزِلُ بِہِ عَلَی أمنتی ، وَتَنْظُرُ إلَیَّ بِوَجْہِکَ نَظْرَۃً أَسْتَکْمِلُ بِہَا الْکَرَامَۃَ فِی الرَّفِیقِ الأَعْلَی فِی أَعْلَی عِلِّیِّینَ ، فَإِنَّ نِعْمَتَکَ تُتِمُّ الصَّالِحَاتِ ، اللَّہُمَّ إنِّی ضَعِیفٌ مِنْ ضَعْفٍ خَلَقْتَنِی إِلَی ضَعْف مَا أَصِیرُ ، فَمَا شِئْت لاَ مَا شئنا ، فَشَأْ لِی أَنْ أَسْتَقِیمَ۔","Da'if","Musannaf Ibn Abi Shaybah 30135","","","كتاب الدعاء"
"30136","(۳۰۱۳۶) حَدَّثَنَا عَفَّانُ حَدَّثَنَا شُعْبَۃُ أَخْبَرَنِی مَنْصُورُ بْنُ الْمُعْتَمِرِ ، قَالَ : سَمِعْتُ رِبْعِیَّ بْنَ خِرَاشٍ ، عَنْ عَلِیٍّ ، قَالَ : ما مِنْ کَلِمَاتٍ أَحَبُّ إِلَی اللہِ أَنْ یَقُولَہُنَّ الْعَبْدُ : اللَّہُمَّ لاَ إلَہَ إِلاَّ أَنْتَ اللَّہُمَّ لاَ أَعْبُدُ إِلاَّ إیَّاکَ ، اللَّہُمَّ لاَ أُشْرِکُ بِکَ شَیْئًا ، اللَّہُمَّ إنِّی قَدْ ظَلَمْت نَفْسِی فَاغْفِرْ لِی ذُنُوبِی ، إِنَّہُ لاَ یَغْفِرُ الذُّنُوبَ إِلاَّ أَنْتَ۔","Sahih","Musannaf Ibn Abi Shaybah 30136","","","كتاب الدعاء"
"30137","(۳۰۱۳۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ وَعَلْقَمَۃَ ، قَالا : قَالَ عَبْدُ اللہِ : إنَّ فِی کِتَابِ اللہِ آیَتَیْنِ مَا أَصَابَ عَبْدٌ ذَنْبًا فَقَرَأَہُمَا ، ثُمَّ اسْتَغْفَرَ اللَّہَ إِلاَّ غَفَرَ لَہُ {وَالَّذِینَ إذَا فَعَلُوا فَاحِشَۃً أَوْ ظَلَمُوا أَنْفُسَہُمْ } إِلَی آخِرِ الآیَۃِ وَ {مَنْ یَعْمَلْ سُوئًا أَوْ یَظْلِمْ نَفْسَہُ}۔","Sahih","Musannaf Ibn Abi Shaybah 30137","","","كتاب الدعاء"
"30138","(۳۰۱۳۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن شَقِیقٍ ، قَالَ : کَانَ مِنْ دُعَائِ عَبْدِ اللہِ رَبَّنَا أَصْلِحْ ذَاتَ بَیْنِنَا وَاہْدِنَا سُبُلَ الإِسْلامِ وَأَخْرِجْنَا مِنَ الظُّلُمَاتِ إِلَی النُّورِ ، وَاصْرِفْ عَنَّا الْفَوَاحِشَ مَا ظَہَرَ مِنْہَا ، وَمَا بَطَنَ ، وَبَارِکْ لَنَا فِی أَسْمَاعِنَا وَأَبْصَارِنَا وَقُلُوبِنَا وَأَزْوَاجِنَا وَذُرِّیَّاتِنَا وَتُبْ عَلَیْنَا وَعَلَیْہِمْ إنَّک أَنْتَ التَّوَّابُ الرَّحِیمُ، وَاجْعَلْنَا لأَنْعُمِکَ شَاکِرِینَ مُثْنِینَ بِہَا قَائِلِینَ بِہَا وَأَتْمِمْہَا عَلَیْنَا۔","Sahih","Musannaf Ibn Abi Shaybah 30138","","","كتاب الدعاء"
"30139","(۳۰۱۳۹) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَن مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : کَانَ عَبْدُ اللہِ یَقُولُ ، اللَّہُمَّ أَصْلِحْ ذَاتَ بَیْنِنَا ، ثُمَّ ذَکَرَ نَحْوًا مِنْ حَدِیثِ الأَعْمَشِ۔","Sahih","Musannaf Ibn Abi Shaybah 30139","","","كتاب الدعاء"
"30140","(۳۰۱۴۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی فَاخِتَۃَ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، قَالَ : قَالَ عَبْدُ اللہِ : یَقُولُ اللَّہُ تعالی مَنْ کَانَ لَہُ عِنْدِی عَہْدٌ فَلْیَقُمْ قَالُوا : یَا أَبَا عَبْدِ الرَّحْمَنِ ، فَعَلِّمْنَا ، قَالَ : قُولُوا : اللَّہُمَّ فَاطِرَ السَّمَاوَاتِ وَالأَرْضِ عَالِمَ الْغَیْبِ وَالشَّہَادَۃِ إنِّی أَعْہَدُ إلَیْک عَہْدًا فِی ہَذِہِ الْحَیَاۃِ الدُّنْیَا إنَّک إِنْ تَکِلْنِی إِلَی عملی تُقَرِّبُنِی مِنَ الشَّرِّ وَتُبَاعِدُنِی مِنَ الْخَیْرِ ، وَأَنِّی لاَ أَثِقُ إِلاَّ بِرَحْمَتِکَ فَاجْعَلْہُ لِی عِنْدَکَ عَہْدًا تُؤَدِّیہِ إلَیَّ یَوْمَ الْقِیَامَۃِ إنَّک لاَ تُخْلِفُ الْمِیعَادَ۔","Sahih","Musannaf Ibn Abi Shaybah 30140","","","كتاب الدعاء"
"30141","(۳۰۱۴۱) حَدَّثَنَا عَفَّانُ حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ أَخْبَرَنَا عَطَائُ بْنُ السَّائِبِ ، عَنْ أَبِی الأَحْوَصِ ، أَنَّ ابْنَ مَسْعُودٍ کَانَ إذَا دَعَا لأَصْحَابِہِ ، یقول : اللَّہُمَّ اہْدِنَا ، وَیَسِّرْ ہُدَاک لَنَا ، اللَّہُمَّ یَسِّرْنَا لِلْیُسْرَی وَجَنِّبْنَا الْعُسْرَی وَاجْعَلْنَا مِنْ أُولِی النُّہَی اللَّہُمَّ لَقِّنَّا نَضْرَۃً وَسُرُورًا ، وَاکْسُنَا سُنْدُسًا وَحَرِیرًا وَحَلِّنَا أَسَاوِرَ إلَہِ الْحَقِّ اللَّہُمَّ اجْعَلْنَا شَاکِرِینَ لِنِعْمَتِکَ مُثْنِینَ بِہَا قَائِلِیہَا وَتُبْ عَلَیْنَا إنَّک أَنْتَ التَّوَّابُ الرَّحِیمُ۔","Sahih","Musannaf Ibn Abi Shaybah 30141","","","كتاب الدعاء"
"30142","(۳۰۱۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ حَدَّثَنَا مِسْعَرٌ، عَنِ جواب التیمی عن الحارث بن سوید قَالَ: قَالَ عَبْدُ اللہِ إن مِنْ أَحَبُّ الْکَلامِ إِلَی اللہِ أَنْ یَقُولَ الْعَبْدُ اللَّہُمَّ أَبُوئُ بِالنِّعْمَۃِ وَأَبُوئُ بِالذَّنْبِ فَاغْفِرْ لِی إنَّہُ لاَ یَغْفِرُ الذُّنُوبَ إِلاَّ أَنْتَ۔","Hasan","Musannaf Ibn Abi Shaybah 30142","","","كتاب الدعاء"
"30143","(۳۰۱۴۳) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَن مِسْعَرٍ ، عَن مَعْنٍ قَالَ : کَانَ عَبْدُ اللہِ مِمَّا یَدْعُو یَقُولُ اللَّہُمَّ أَعِنِّی عَلَی أَہَاوِیلِ الدُّنْیَا وَبَوَائِقِ الدَّہْرِ وَمَصَائِبِ اللَّیَالِیِ وَالأَیَّامِ ، وَاکْفِنِی شَرَّ مَا یَعْمَلُ الظَّالِمُونَ فِی الأَرْضِ ، اللَّہُمَّ اصْحَبْنِی فِی سَفَرِی وَاخْلُفْنِی فِی حَضَرِی وَإِلَیْک فَحَبِّبْنِی ، وَفِی أَعْیُنِ النَّاسِ فَعَظِّمْنِی ، وَفِی نَفْسِکَ فَاذْکُرْنِی ، وَفِی نَفْسِی لَکَ فَذَلِّلْنِی ، وَمِنْ شَرِّ الأَخْلاقِ فَجَنِّبْنِی یَا رَحْمَنُ ، إِلَی مَنْ تَکِلُنِی ، أَنْتَ رَبِّی ، إِلَی بَعِیدٍ یَتَجَہَّمُنِی أَمْ إِلَی قَرِیبٍ قَلَّدْْتہ أَمْرِی۔","","Musannaf Ibn Abi Shaybah 30143","","","كتاب الدعاء"
"30144","(۳۰۱۴۴) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : کَانَ عَبْدُ اللہِ إذَا اجْتَہَدَ فِی الدُّعَائِ ، قَالَ اللَّہُمَّ إنِّی أَسْأَلُک مِنْ فَضْلِکَ الَّذِی أَفَضَلْت عَلَی ، وَبَلائِکَ الْحَسَنِ الَّذِی ابْتَلَیْتنِی ، وَنَعْمَائِکَ الَّتِی أَنْعَمْت عَلَیَّ أَنْ تُدْخِلَنِی الْجَنَّۃَ ، اللَّہُمَّ أَدْخِلْنِی الْجَنَّۃَ بِرَحْمَتِکَ وَمَغْفِرَتِکَ وَفَضْلِک۔","","Musannaf Ibn Abi Shaybah 30144","","","كتاب الدعاء"
"30145","(۳۰۱۴۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، قَالَ : مَا دَعَا عَبْدٌ قَطُّ بِہَذِہِ الدَّعَوَاتِ إِلاَّ وَسَّعَ اللَّہُ عَلَیْہِ فِی مَعِیشَتِہِ یَا ذَا الْمَنِّ فَلا یُمَنَّ عَلَیْک یَا ذَا الْجَلالِ وَالإِکْرَامِ یَا ذَا الطَّوْلِ لاَ إلَہَ إِلاَّ أَنْتَ ، ظَہْرُ اللاجِئِینَ وَجَارُ الْمُسْتَجِیرِینَ وَمَأْمَنُ الْخَائِفِینَ ، إِنْ کُنْتَ کَتَبْتنِی عِنْدَکَ فِی أُمِّ الْکِتَابِ شَقِیًّا فَامْحُ عَنِّی اسْمَ الشَّقَائِ ، وَأَثْبِتْنِی عِنْدَکَ سَعِیدًا ، وَإِنْ کُنْتَ کَتَبْتَنِی فِی أُمِّ الْکِتَابِ مُقترًا عَلَی رِزْقِی ، فَامْحُ حِرْمَانِی ، وَتَقْتِیر رِزْقِی ، وَاثْبِتْنِی عِنْدَک سَعِیدًا مُوَفَّقًا لِلْخَیْرِ ، فَإِنَّک تَقُولُ فِی کِتَابِکَ {یَمْحُو اللَّہُ مَا یَشَائُ وَیُثْبِتُ وَعِنْدَہُ أُمُّ الْکِتَابِ}۔","Da'if","Musannaf Ibn Abi Shaybah 30145","","","كتاب الدعاء"
"30146","(۳۰۱۴۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ، عَنْ أَبِی إِسْحَاقَ، عَنْ أَبِی عُبَیْدَۃَ، قَالَ سُئِلَ عَبْدُاللہِ: مَا الدُّعَائُ الَّذِی دَعَوْت بِہِ لَیْلَۃَ ، قَالَ لَکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سَلْ تُعْطَہُ ، قَالَ : قُلْتُ اللَّہُمَّ إنِّی أَسْأَلُک إیمَانًا لاَ یَرْتَدُّ ، وَنَعِیمًا لاَ یَنْفَدُ ، وَمُرَافَقَۃَ نَبِیِّکَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی أَعْلَی دَرَجَۃِ الْجَنَّۃِ جَنَّۃِ الْخُلْدِ۔","","Musannaf Ibn Abi Shaybah 30146","","","كتاب الدعاء"
"30147","(۳۰۱۴۷) حَدَّثَنَا ہُشَیْمٌ ، أَخْبَرَنَا حُصَیْنٌ ، عَنْ أَبِی الْیَقْظَانِ حُصَیْنِ بْنِ یَزِیدَ الثَّعْلَبِیِّ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، أَنَّہُ کَانَ یَقُولُ : إذَا فَرَغَ مِنَ الصَّلاۃِ : اللَّہُمَّ إنِّی أَسْأَلُک مُوجِبَاتِ رَحْمَتِکَ وَعَزَائِمَ مَغْفِرَتِکَ وَأَسْأَلُکَ الْغَنِیمَۃَ مِنْ کُلِّ بِرٍّ وَالسَّلامَۃَ مِنْ کُلِّ إِثْمٍ ، اللَّہُمَّ إنِّی أَسْأَلُک الْفَوْزَ بِالْجَنَّۃِ وَالْجَوَارَ مِنَ النَّارِ ، اللَّہُمَّ لاَ تَدَعْ ذَنْبًا إِلاَّ غَفَرْتہ ، وَلا ہَمًّا إِلاَّ فَرَّجْتہ ، وَلا حَاجَۃً إِلاَّ قَضَیْتہَا۔","Da'if","Musannaf Ibn Abi Shaybah 30147","","","كتاب الدعاء"
"30148","(۳۰۱۴۸) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، أَنَّہُ کَانَ یَدْعُو اللَّہُمَّ أَلْبِسْنَا لِبَاسَ التَّقْوَی ، وَأَلْزِمْنَا کَلِمَۃَ التَّقْوَی ، وَاجْعَلْنَا مِنْ أُولِی النُّہَی ، وَأَمِتْنَا حِینَ تَرْضَی ، وَأَدْخِلْنَا جَنَّۃَ الْمَأْوَی ، وَاجْعَلْنَا مِمَّنْ بَرَّ وَاتَّقَی ، وَصَدَّقَ بِالْحُسْنَی ، وَنَہَی النَّفْسَ عَنِ الْہَوَی ، وَاجْعَلْنَا مِمَّنْ تُیَسِّرُہُ لِلْیُسْرَی ، وَتُجَنِّبُہُ الْعُسْرَی ، وَاجْعَلْنَا مِمَّنْ یَتَذَکَّرُ فَتَنْفَعُہُ الذِّکْرَی ، اللَّہُمَّ اجْعَلْ سَعْیَنَا مَشْکُورًا وَذَنْبَنَا مَغْفُورًا ، وَلَقِّنَّا نَضْرَۃً وَسُرُورًا ، وَاکْسُنَا سُنْدُسًا وَحَرِیرًا ، وَاجْعَلْ لَنَا أَسَاوِرَ مِنْ ذَہَبٍ وَلُؤْلُؤٍ وَحَرِیرًا۔","Sahih","Musannaf Ibn Abi Shaybah 30148","","","كتاب الدعاء"
"30149","(۳۰۱۴۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَطِیَّۃَ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ قَالَ : اللَّہُمَّ اغْفِرْ لَنَا وَارْحَمْنَا وَعَافِنَا وَاہْدِنَا وَارْزُقْنَا ، قَالَ : فَقَالُوا لَہُ : لَوْ زِدْتنَا ، قَالَ : أَعُوذُ بِاللہِ أَنْ أَکُونَ مِنَ الْمُسْہَبِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 30149","","","كتاب الدعاء"
"30150","(۳۰۱۵۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ حَدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَن عُمَارَۃَ بْنِ غَزِیَّۃَ عَن یَحْیَی بْنِ رَاشِدٍ ، قَالَ : حجَجْنَا ، فَلَمَّا قَضَیْنَا نُسُکَنَا قُلْنَا : لَوْ أَتَیْنَا ابْنَ عُمَرَ فَحَدَّثْنَا ، فَأَتَیْنَا فَخَرَجَ إلَیْنَا فَجَلَسَ بَیْنَنَا فَصَمَتَ لِنَسْأَلَہُ ، وَصَمَتْنَا لِیُحَدِّثَنَا ، فَلَمَّا أَطَالَ الصَّمْتَ ، قَالَ : مَا لَکُمْ لاَ تَکَلَّمُونَ ، أَلا تَقُولُونَ : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ ، وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ ، الْحَسَنَۃُ بِعَشْرِ أَمْثَالِہَا إِلَی سَبْعِمِئَۃِ ضِعْفٍ ، فَإِنْ زِدْتُمْ خَیْرًا زَادَکُمَ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 30150","","","كتاب الدعاء"
"30151","(۳۰۱۵۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَن سُفْیَانَ ، عَن عُبَیْدِ اللہِ ، عَن نَافِعٍ ، أَنَّ ابْنَ عُمَرَ کَانَ یَقُولُ : اللَّہُمَّ لاَ تَنْزِعْ مِنِّی الإِیمَانَ کَمَا أَعْطَیْتنِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30151","","","كتاب الدعاء"
"30152","(۳۰۱۵۲) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَن سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : رَبِّ بِمَا أَنْعَمْتَ عَلَیَّ فَلَنْ أَکُونَ ظَہِیرًا لِلْمُجْرِمِینَ ، فَلَمَّا صَلَّی ، قَالَ : مَا صَلَّیْت صَلاۃً إِلاَّ وَأَنَا أَرْجُو أَنْ تَکُونَ کَفَّارَۃً لِمَا أَمَامَہَا یَعْنِی ، قَالَہَا وَہُوَ رَاکِعٌ۔","Sahih","Musannaf Ibn Abi Shaybah 30152","","","كتاب الدعاء"
"30153","(۳۰۱۵۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، عَن مُحَمَّدٍ ، عَنْ أَبِی مُوسَی ، أَنَّہُ کَانَ یَقُولُ فِی دُعَائِہِ : اللَّہُمَّ إنِّی أَسْأَلُک مِنَ الْخَیْرِ کُلِّہِ مَا یَنْبَغِی أَنْ أَسْأَلَک مِنْہُ ، وَأَعُوذُ بِکَ مِنَ الشَّرِّ کُلِّہِ مَا یَنْبَغِی أَنْ أَتَعَوَّذَ بِکَ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30153","","","كتاب الدعاء"
"30154","(۳۰۱۵۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ حَدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو ، عن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُک بِنُورِ وَجْہِکَ الَّذِی أَشْرَقَتْ لَہُ السَّمَاوَاتُ وَالأَرْضُ أَنْ تَجْعَلَنِی فِی حِرْزِکَ وَحِفْظِکَ وَجِوَارِکَ وَتَحْتَ کَنَفِک۔","Sahih","Musannaf Ibn Abi Shaybah 30154","","","كتاب الدعاء"
"30155","(۳۰۱۵۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَن سُفْیَانَ ، عَن طَارِقٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنْ أَبِی ہَیَّاجٍ الأَسَدِیِّ، قَالَ : سَمِعْتُ شَیْخًا یَطُوفُ خَلْفَ الْبَیْتِ وَہُوَ یَقُولُ : اللَّہُمَّ قِنِی شُحَّ نَفْسِی ، فَلَمْ أَدْرِ مَنْ ہُوَ ، فَلَمَّا انْصَرَفَ ، اتَّبَعْتُہُ ، فَسَأَلْتُ عَنْہُ ؟ فَقَالُوا : عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30155","","","كتاب الدعاء"
"30156","(۳۰۱۵۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن الجریری عن ثمامۃ بن حزن قَالَ ، سمعت شیخاً یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ شَرٍّ لاَ یُخْلَطُ مَعَہُ غَیْرُہُ ، قَالَ : قُلْتُ : مَنْ ہَذَا الشَّیْخُ ، قَالَ : أَبُو الدَّرْدَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 30156","","","كتاب الدعاء"
"30157","(۳۰۱۵۷) حَدَّثَنَ?? أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن حَبِیبٍ ، عَن عُرْوَۃَ بْنِ عَامِرٍ ، قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الطِّیَرَۃِ فَقَالَ : أَصْدَقُہَا الْفَأْلُ ، وَلا تَرُدُّ مُسْلِمًا ، فَإِذَا رَأَیْتُمْ مِنَ الطِّیَرَۃِ شَیْئًا تَکْرَہُونَہُ فَقُولُوا : اللَّہُمَّ لاَ یَأْتِی بِالْحَسَنَاتِ إِلاَّ أَنْتَ ، وَلا یَذْہَبُ بِالسَّیِّئَاتِ إِلاَّ أَنْتَ ، وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ۔","","Musannaf Ibn Abi Shaybah 30157","","","كتاب الدعاء"
"30158","(۳۰۱۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَن حَبِیبٍ ، عَن عُرْوَۃَ بْنِ عَامِرٍ ، قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الطِّیَرَۃِ ، ثُمَّ ذَکَرَ مِثْلَ حَدِیثِ أَبِی مُعَاوِیَۃَ إِلاَّ أَنَّہُ قَالَ : وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِک۔","","Musannaf Ibn Abi Shaybah 30158","","","كتاب الدعاء"
"30159","(۳۰۱۵۹) حَدَّثَنَا وَکِیعٌ ، عَن أُسَامَۃَ بْنِ زَیْدٍ ، عَن نَافِعِ بْنِ جُبَیْرٍ ، قَالَ : قَالَ کَعْبٌ لِعَبْدِ اللہِ بْنِ عَمْرٍو : ہَلْ تَطَیَّرُ ؟ قَالَ : نَعَمْ ، قَالَ : فَمَا تَقُولُ : قَالَ : أَقُولُ : اللَّہُمَّ لاَ طَیْرَ إِلاَّ طَیْرُک ، وَلا خَیْرَ إِلاَّ خَیْرُک ، وَلا رَبَّ غَیْرُک ، قَالَ : أَنْتَ أَفْقَہُ الْعَرَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 30159","","","كتاب الدعاء"
"30160","(۳۰۱۶۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی قَتَادَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الرُّؤْیَا مِنَ اللہِ ، وَالْحُلْمُ مِنَ الشَّیْطَانِ ، فَإِذَا رَأَی أَحَدُکُمْ مَا یَکْرَہُ فَلْیَنْفُثْ عَن یَسَارِہِ وَلْیَتَعَوَّذْ مِنْ شَرِّہَا فَإِنَّہَا لن تَضُرَّہُ۔ (بخاری ۵۷۴۷۔ مسلم ۱۷۷۲)","Sahih","Musannaf Ibn Abi Shaybah 30160","","","كتاب الدعاء"
"30161","(۳۰۱۶۱) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللہِ بْنِ یُونُسَ ، عَن لَیْثِ بْنِ سَعْدٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا رَأَی أَحَدُکُمَ الرُّؤْیَا یَکْرَہُہَا فَلْیَبْصُقْ ، عَن یَسَارِہِ ثَلاثًا وَلْیَسْتَعِذْ بِاللہِ مِنَ الشَّیْطَانِ ثَلاثًا ، وَیَتَحَوَّلُ ، عَنْ جَنْبِہِ الَّذِی کَانَ عَلَیْہِ۔ (مسلم ۱۷۷۲۔ ابوداؤد ۴۹۸۳)","Sahih","Musannaf Ibn Abi Shaybah 30161","","","كتاب الدعاء"
"30162","(۳۰۱۶۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنْ إبْرَاہِیمَ النَّخَعِیِّ ، قَالَ : کَانُوا إذَا رَأَی أَحَدُہُمْ فِی مَنَامِہِ مَا یَکْرَہُ ، قَالَ : أَعُوذُ بِمَا عَاذَتْ بِہِ مَلائِکَۃُ اللہِ وَرَسُولِہِ مِنْ شَرِّ مَا رَأَیْت فِی مَنَامِی أَنْ یُصِیبَنِی مِنْہُ شَیْئٌ أَکْرَہُہُ فِی الدُّنْیَا وَالآخِرَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30162","","","كتاب الدعاء"
"30163","(۳۰۱۶۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، حَدَّثَنَا عَبْدُ الْمَلِکِ بْنُ أَبِی سُلَیْمَانَ ، عَنْ أَبِی عَلِیٍّ رَجُلٍ مِنْ بَنِی کَاہِلٍ ، قَالَ: خَطَبَنَا أَبُو مُوسَی الأَشْعَرِیُّ فَقَالَ : خَطَبَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ یَوْمٍ فَقَالَ : أَیُّہَا النَّاسُ ، اتَّقُوا ہَذَا الشِّرْکَ فَإِنَّہُ أَخْفَی مِنْ دَبِیبِ النَّمْلِ ، فَقَالَ مَنْ شَائَ أَنْ یَقُولَ : وَکَیْفَ نَتَّقِیہِ وَہُوَ أَخْفَی مِنْ دَبِیبِ النَّمْلِ یَا رَسُولَ اللہِ ؟ قَالَ قُولُوا : اللَّہُمَّ إنَّا نَعُوذُ بِکَ مِنْ أَنْ نُشْرِکَ بِکَ شَیْئًا نَعْلَمُہُ وَنَسْتَغْفِرُک لِمَا لاَ نَعْلَمُ۔n(بخاری ۵۰۹۔ احمد ۴۰۳)","Da'if","Musannaf Ibn Abi Shaybah 30163","","","كتاب الدعاء"
"30164","(۳۰۱۶۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَن عُبَیْدِ اللہِ بْنِ الْمُغِیرَۃِ بْنِ مُعَیْقِیبٍ ، عَنْ عَمْرِو بْنِ سُلَیْمٍ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: اللَّہُمَّ أَتَّخِذُ عِنْدَکَ عَہْدًا تُؤَدِّیہِ إِلَیَّ یَوْمَ الْقِیَامَۃِ ، إنَّک لاَ تُخْلِفُ الْمِیعَادَ ، فَإِنَّمَا أَنَا بَشَرٌ فَأَیَّ الْمُسْلِمِینَ آذَیْتہ ، أَوْ شَتَمْتہ ، أَوْ قَالَ ضَرَبْتہ ، أَوْ سَبَبْتہ فَاجْعَلْہَا لَہُ صَلاۃً وَاجْعَلْہَا لَہُ زَکَاۃً وَقُرْبَۃً تُقَرِّبُہُ بِہَا إلَیْک یَوْمَ الْقِیَامَۃِ۔(احمد ۴۴۹۔ ابویعلی ۱۲۵۷)","","Musannaf Ibn Abi Shaybah 30164","","","كتاب الدعاء"
"30165","(۳۰۱۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، عَنْ عُمَرَ بْنِ قَیْسٍ ، عَنْ عَمْرِو بْنِ أَبِی قُرَّۃَ ، عَن سَلْمَانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ وَلَدِ آدَمَ أَنَا ، فَأَیُّمَا عَبْدٍ مِنْ أُمَّتِی لَعَنْتہ لَعْنَۃً ، أَوْ سَبَبْتہ سَبَّۃً فِی غَیْرِ کُنْہِہِ ، فَاجْعَلْہَا عَلَیْہِ صَلاۃً۔ (بخاری ۲۳۴۔ ابوداؤد ۴۶۲۶)","Sahih","Musannaf Ibn Abi Shaybah 30165","","","كتاب الدعاء"
"30166","(۳۰۱۶۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : اللَّہُمَّ أَیُّمَا مُؤْمِنٍ لَعَنْتہ ، أَوْ سَبَبْتہ ، أَوْ جَلَدْتہ فَاجْعَلْہَا لَہُ زَکَاۃً وَأَجْرًا۔ (مسلم ۲۰۰۸۔ احمد ۳۹۱)","Hasan","Musannaf Ibn Abi Shaybah 30166","","","كتاب الدعاء"
"30167","(۳۰۱۶۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اللَّہُمَّ إنَّمَا بَشَرٌ فَأَیُّما رَجُلٍ مِنَ الْمُسْلِمِینَ سَبَبْتہ ، أَوْ لَعَنْتہ ، أَوْ جَلَدْتہ فَاجْعَلْہَا زَکَاۃً وَرَحْمَۃً۔ (مسلم ۲۰۰۷۔ احمد ۳۹۰)","Sahih","Musannaf Ibn Abi Shaybah 30167","","","كتاب الدعاء"
"30168","(۳۰۱۶۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَہُ غَیْرَ أَنَّہُ قَالَ : زَکَاۃً وَأَجْرًا۔ (مسلم ۲۰۰۷۔ دارمی ۲۷۶۶)","Hasan","Musannaf Ibn Abi Shaybah 30168","","","كتاب الدعاء"
"30169","(۳۰۱۶۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَن مَسْرُوقٍ ، عَنْ عَائِشَۃَ قَالَتْ : اسْتَأْذَنَ عَلَی النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلانِ فَأَغْلَظَ لَہُمَا وَسَبَّہُمَا ، قَالَتْ : قُلْتُ : یَا رَسُولَ اللہِ مَنْ أَصَابَ مِنْک خَیْرًا فما أَصَابَ ہَذَانِ مِنْک خَیْرًا ، قَالَ : أَوَ مَا عَلِمْت مَا عَاہَدْت عَلَیْہِ رَبِّی ؟ قَالَتْ لَہُ : وَمَا عَاہَدْت عَلَیْہِ رَبَّک ؟ قَالَ : قُلْتُ : اللَّہُمَّ أَیُّمَا مُؤْمِنٍ سَبَبْتہ ، أَوْ لَعَنْتہ ، أَوْ جَلَدْتہ فَاجْعَلْہَا لَہُ مَغْفِرَۃً وَعَافِیَۃً وَکَذَا وَکَذَا۔n(مسلم ۲۰۰۷۔ احمد ۴۵)","Sahih","Musannaf Ibn Abi Shaybah 30169","","","كتاب الدعاء"
"30170","(۳۰۱۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن حَبِیبٍ ، عَن بَعْضِ أَشْیَاخِہِ، قَالَ: کَانَ إذَا أَتَاہُ الأَمْرُ مِمَّا یُعْجِبُہُ، قَالَ : الْحَمْدُ لِلَّہِ الْمُنْعِمِ الْمُفْضِلِ ، الَّذِی بِنِعْمَتِہِ تَتِمُّ الصَّالِحَاتِ ، وَإِذَا أَتَاہُ الأَمْر مِمَّا یَکْرَہُہُ ، قَالَ : الْحَمْدُ لِلَّہِ عَلَی کُلِّ حَالٍ۔ (ابن ماجہ ۳۸۰۳)","","Musannaf Ibn Abi Shaybah 30170","","","كتاب الدعاء"
"30171","(۳۰۱۷۱) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، عَن سَلْمَانَ ، قَالَ : إنَّ اللَّہَ یَسْتَحْیِی أَنْ یَبْسُطَ إلَیْہِ عَبْدُہُ یَدَیْہِ یَسْأَلُہُ بِہِمَا خَیْرًا فَیَرُدَّہُمَا خَائِبَتَیْنِ۔ (ابوداؤد ۱۴۸۳۔ ترمذی ۳۵۵۶)","Sahih","Musannaf Ibn Abi Shaybah 30171","","","كتاب الدعاء"
"30172","(۳۰۱۷۲) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَغَرِّ أَبِی مُسْلِمٍ یَشْہَدُ بہ عَلَی أَبِی ہُرَیْرَۃَ ، وَأَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالا : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ یُمْہِلُ حَتَّی یَذْہَبَ ثُلُثُ اللَّیْلِ ، ثُمَّ یَنْزِلُ إِلَی السَّمَائِ الدُّنْیَا فَیَقُولُ : ہَلْ مِنْ مُسْتَغْفِرٍ ؟ ہَلْ مِنْ تَائِبٍ ؟ ہَلْ مِنْ دَاعٍ ؟ ہَلْ مِنْ سَائِلٍ ؟ حَتَّی یَنْفَجِرَ الْفَجْرُ۔ (بخاری ۶۳۲۱۔ مسلم ۵۲۳)","Sahih","Musannaf Ibn Abi Shaybah 30172","","","كتاب الدعاء"
"30173","(۳۰۱۷۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَن لَیْثٍ ، عَن شَہْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ ، عَنْ أَبِی ذَرٍّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَقُولُ اللَّہُ : یَا عِبَادِی ، کُلُّکُمْ مُذْنِبٌ إِلاَّ مَنْ عَافَیْتہ ، فَاسْتَغْفِرُونِی أَغْفِرْ لَکُمْ ، وَمَنْ عَلِمَ أَنِّی ذُو قُدْرَۃٍ عَلَی أَنْ أَغْفِرَ لَہُ غَفَرْت لَہُ ، وَلا أُبَالِی ، یَا عِبَادِی ، کُلُّکُمْ ضَالٌّ إِلاَّ مَنْ ہَدَیْتہ فَاسْتَہْدُونِی أَہْدِکُمْ ، یَا عِبَادِی ، کُلُّکُمْ فَقِیرٌ إِلاَّ مَنْ أَغْنَیْتہ فَاسْأَلُونِی أُعْطِکُمْ۔n(ترمذی ۲۴۹۵۔ احمد ۱۵۴)","Da'if","Musannaf Ibn Abi Shaybah 30173","","","كتاب الدعاء"
"30174","(۳۰۱۷۴) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَن مَنْصُورٍ ، عَن رِبْعِیِّ بْنِ حِرَاشٍ ، قَالَ : قَالَ عَبْدُ اللہِ بْنُ رَوَاحَۃَ : اللَّہُمَّ إنِّی أَسْأَلُک قُرَّۃَ عَیْنٍ لاَ تَرْتَدُّ وَنَعِیمًا لاَ یَنْفَدُ۔","","Musannaf Ibn Abi Shaybah 30174","","","كتاب الدعاء"
"30175","(۳۰۱۷۵) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عن منصور ، عَن رِبْعِیِّ بْنِ حِرَاشٍ ، قَالَ : قَالَ عَبْدُ اللہِ بْنُ رَوَاحَۃَ : اللَّہُمَّ إنِّی أَسْأَلُک قُرَّۃَ عَیْنٍ لاَ تَرْتَدُّ ، وَنَعِیمًا لاَ یَنْفَدُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ مِنْ ہَاتَیْنِ شَیْئٌ فِی الدُّنْیَا۔","","Musannaf Ibn Abi Shaybah 30175","","","كتاب الدعاء"
"30176","(۳۰۱۷۶) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْعَلائِ بْنِ الْمُسَیَّبِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا فَرَغَ مِنْ طَعَامِہِ ، قَالَ : الْحَمْدُ لِلَّہِ الَّذِی مَنَّ عَلَیْنَا فَہَدَانَا، وَالْحَمْدُ لِلَّہِ الَّذِی أَشْبَعَنَا وَأَرْوَانَا، وَکُلُّ بَلائٍ حَسَنٍ ، أَوْ صَالِحٍ أَبْلانَا۔ (نسائی ۱۰۱۳۳۔ ابن حبان ۵۲۱۹)","","Musannaf Ibn Abi Shaybah 30176","","","كتاب الدعاء"
"30177","(۳۰۱۷۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ، عَن حَجَّاجٍ ، عَن رِیَاحِ بْنِ عَبِیْدَۃَ مَوْلَی أَبِی سَعِیدٍ، عَنْ أبِی سَعِیدٍ ، قَالَ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَکَلَ طَعَامًا ، قَالَ : الْحَمْدُ لِلَّہِ الَّذِی أَطْعَمَنَا وَسَقَانَا وَجَعَلَنَا مُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 30177","","","كتاب الدعاء"
"30178","(۳۰۱۷۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنِ الْحَارِثِ بْنِ سُوَیْد ، قَالَ کَانَ سَلْمَانُ إذَا طَعِمَ ، قَالَ : الْحَمْدُ لِلَّہِ الَّذِی کَفَانَا الْمُؤْنَۃَ ، وَأَوْسَعَ لَنَا الرِّزْقَ۔","Sahih","Musannaf Ibn Abi Shaybah 30178","","","كتاب الدعاء"
"30179","(۳۰۱۷۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن حُصَیْنٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی سَعِیدٍ ، قَالَ : کَانَ أَبُو سَعِیدٍ إذَا وُضِعَ لَہُ الطَّعَامُ ، قَالَ : الْحَمْدُ لِلَّہِ الَّذِی أَطْعَمَنَا وَسَقَانَا وَجَعَلَنَا مُسْلِمِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 30179","","","كتاب الدعاء"
"30180","(۳۰۱۸۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی الْوَرْدِ ، عَنِ ابْنِ أَعْبَدَ ، أَو ابْنِ مَعْبَدٍ ، قَالَ ، قَالَ عَلِیٌّ : تَدْرِی مَا حَقُّ الطَّعَامِ ؟ قَالَ : قُلْتُ : وَمَا حَقُّہُ ؟ قَالَ : تَقُولُ : بِسْمِ اللہِ اللَّہُمَّ بَارِکْ لَنَا فِیمَا رَزَقْتنَا ، قَالَ: تَدْرِی مَا شُکْرُہُ ؟ قُلْتُ : وَمَا شُکْرُہُ ؟ قَالَ : تَقُولُ : الْحَمْدُ لِلَّہِ الَّذِی أَطْعَمَنَا وَسَقَانَا۔","Da'if","Musannaf Ibn Abi Shaybah 30180","","","كتاب الدعاء"
"30181","(۳۰۱۸۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَاصِمِ بْنِ أَبِی النَّجُودِ ، عَن ذَکْوَانَ أَبِی صَالِحٍ ، عَنْ عَائِشَۃَ ، أَنَّہُ قُدِّمَ إلَیْہَا طَعَامٌ فَقَالَتْ : ائْدِمُوہُ ، فَقَالُوا : وَمَا إدَامُہُ ؟ قَالَتْ : تَحْمَدُونَ اللَّہَ عَلَیْہِ إذَا فَرَغْتُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 30181","","","كتاب الدعاء"
"30182","(۳۰۱۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَأَبُو أُسَامَۃَ ، عَن زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَن سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إنَّ اللَّہَ لَیَرْضَی عَنِ الْعَبْدِ أَنْ یَأْکُلَ الأَکْلَۃَ فَیَحْمَدَہُ عَلَیْہَا ، أَوْ یَشْرَبَ الشَّرْبَۃَ فَیَحْمَدَہُ عَلَیْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 30182","","","كتاب الدعاء"
"30183","(۳۰۱۸۳) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ عَبْدِالرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ حَدَّثَنَا بِشْرُ بْنُ زِیَادٍ، عَن سُلَیْمَانَ بْنِ عَبْدِاللہِ، عَن عِتْرِیسِ بْنِ عُرْقُوبَ ، قَالَ : قَالَ عَبْدُ اللہِ: مَنْ قَالَ حِینَ یُوضَعُ طَعَامُہُ: بِسْمِ اللہِ، خَیْرُ الأَسْمَائِ فِی الأَرْضِ وَفِی السَّمَائِ لاَ یَضُرُّ مَعَ اسْمِہِ دَائٌ ، اللَّہُمَّ اجْعَلْ فِیہِ بَرَکَۃً وَعَافِیَۃً وَشِفَائً فَلا یَضُرُّہُ ذَلِکَ الطَّعَامُ مَا کَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 30183","","","كتاب الدعاء"
"30184","(۳۰۱۸۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن ہِشَامٍ ، قَالَ : کَانَ أَبِی لاَ یُؤْتَی بِطَعَامٍ وَلا شَرَابٍ حَتَّی الشَّرْبَۃِ مِنَ الدَّوَائِ فَیَشْرَبُہُ ، أَوْ یَطْعَمُہُ حَتَّی یَقُولَ : الْحَمْدُ لِلَّہِ الَّذِی ہَدَانَا وَأَطْعَمَنَا وَسَقَانَا وَنَعَّمَنَا ، اللَّہُ أَکْبَرُ ، اللَّہُمَّ أَلْفَتْنَا نِعْمَتَکَ بِکُلِّ شَرٍّ ، فَأَصْبَحْنَا وَأَمْسَیْنَا مِنْہَا بِکُلِّ خَیْرٍ نَسْأَلُک تَمَامَہَا وَشُکْرَہَا ، لاَ خَیْرَ إِلاَّ خَیْرُک ، وَلا إلَہَ غَیْرُک ، إلَہَ الصَّالِحِینَ وَرَبَّ الْعَالَمِینَ ، الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ ، لاَ إلَہَ إِلاَّ اللَّہُ ، مَا شَائَ اللَّہُ ، لاَ قُوَّۃَ إِلاَّ بِاللہِ ، اللَّہُمَّ بَارِکْ لَنَا فِیمَا رَزَقْتنَا وَقِنَا عَذَابَ النَّارِ۔","","Musannaf Ibn Abi Shaybah 30184","","","كتاب الدعاء"
"30185","(۳۰۱۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَن مِسْعَرٍ ، عَن ہِلالٍ ، عَن عُرْوَۃَ ، أَنَّہُ کَانَ إذَا وَضَعَ الطَّعَامَ ، قَالَ : سُبْحَانَک مَا أَحْسَنَ مَا تُبْلِینَا ، سُبْحَانَک مَا أَحْسَنَ مَا تُعْطِینَا ، رَبَّنَا وَرَبَّ آبَائِنَا الأَوَّلِینَ ، ثُمَّ یُسَمِّی اللَّہَ وَیَضَعُ یَدَہُ۔","","Musannaf Ibn Abi Shaybah 30185","","","كتاب الدعاء"
"30186","(۳۰۱۸۶) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ اللہِ ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَن تَمِیمِ بْنِ سَلَمَۃَ ، قَالَ : حُدِّثْتُ أَنَّ الرَّجُلَ إذَا ذَکَرَ اسْمَ اللہِ عَلَی طَعَامِہِ وَحَمِدَہُ عَلَی آخِرِہِ لَمْ یُسْأَلْ عَن نَعِیمِ ذَلِکَ الطَّعَامِ۔","","Musannaf Ibn Abi Shaybah 30186","","","كتاب الدعاء"
"30187","(۳۰۱۸۷) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَن حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : سُئِلَ ہَلْ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَرْفَعُ یَدَیْہِ ؟ قَالَ : نَعَمْ ، شَکَا النَّاسُ إلَیْہِ ذَاتَ جُمُعَۃٍ فَقَالُوا : یَا رَسُولَ اللہِ ، قُحِطَ الْمَطَرُ ، وَأَجْدَبَتِ الأَرْضُ ، وَہَلَکَ الْمَالُ ، قَالَ : فَرَفَعَ یَدَیْہِ حَتَّی رَأَیْت بَیَاضَ إبْطَیْہِ ، وَمَا فِی السَّمَائِ قَزَعَۃُ سَحَابٍ ، فَمَا صَلَّیْنَا حَتَّی إنَّ الشَّابَّ الْقَوِیَّ الْقَرِیبَ الْمَنْزِلِ لَیَہُمُّہُ الرُّجُوعُ إِلَی مَنْزِلِہِ ، قَالَ : فَدَامَتْ عَلَیْنَا جُمُعَۃٌ قَالَ فقالوا یا رسول اللہ تَہَدَّمَتِ الدُّورُ وَاحْتَبَسَ الرُّکْبَانُ ، قَالَ : فَتَبَسَّمَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ سُرْعَۃِ مَلالَۃِ ابْنِ آدَمَ فَقَالَ : اللَّہُمَّ حَوَالَیْنَا لاَ عَلَیْنَا ، قَالَ فأصحت السماء ۔","Sahih","Musannaf Ibn Abi Shaybah 30187","","","كتاب الدعاء"
"30188","(۳۰۱۸۸) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن مَنْصُورٍ ، عَنْ عَبْدِ اللہِ بْنِ یَسَارٍ ، عَن حُذَیْفَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ تَقُولُوا : مَا شَائَ اللَّہُ وَشَائَ فُلانٌ ، وَلَکِنْ قُولُوا : مَا شَائَ اللَّہُ ، ثُمَّ شَائَ فُلانٌ۔","Sahih","Musannaf Ibn Abi Shaybah 30188","","","كتاب الدعاء"
"30189","(۳۰۱۸۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَن یَزَیْدَ بْنِ الأَصَمِّ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَمِعَ رَجُلاً یَقُولُ : مَا شَائَ اللَّہُ وَشَائَ فُلانٌ ، فَقَالَ : جَعَلْتنِی لِلَّہِ عَدْلا ، قُلْ : مَا شَائَ اللَّہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30189","","","كتاب الدعاء"
"30190","(۳۰۱۹۰) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَن تَمِیمِ بْنِ طَرَفَۃَ الطَّائِیِّ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، أَنَّ رَجُلاً خَطَبَ عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : مَنْ یُطِعِ اللَّہَ وَرَسُولَہُ ، فَقَدْ رَشَدَ ، وَمَنْ یَعْصِہِمَا ، فَقَدْ غَوَی ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : بِئْسَ الْخَطِیبُ أَنْتَ ، قُلْ : وَمَنْ یَعْصِ اللَّہَ وَرَسُولَہُ۔ (مسلم ۵۹۴۔ ابوداؤد ۱۰۹۲)","Sahih","Musannaf Ibn Abi Shaybah 30190","","","كتاب الدعاء"
"30191","(۳۰۱۹۱) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَن مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: خَطَبَ رَجُلٌ عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ: مَنْ یُطِعَ اللَّہَ وَرَسُولَہُ ، فَقَدْ رَشَدَ ، وَمَنْ یَعْصِہِمَا ، فَقَدْ غَوَی ، قَالَ : فَتَغَیَّرَ وَجْہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَکَرِہَ ذَلِکَ، فَقَالَ: إبْرَاہِیمُ: فَکَانُوا یَکْرَہُونَ أَنْ یَقُولَ: وَمَنْ یَعْصِہِمَا، وَلَکِنْ یَقُولُ: مَنْ یَعْصِ اللَّہَ وَرَسُولَہُ۔","","Musannaf Ibn Abi Shaybah 30191","","","كتاب الدعاء"
"30192","(۳۰۱۹۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ دَعَا عَلَی مَنْ ظَلَمَہُ ، فَقَدِ انْتَصَرَ۔ (ترمذی ۳۵۵۲۔ ابویعلی ۴۴۳۷)","Da'if","Musannaf Ibn Abi Shaybah 30192","","","كتاب الدعاء"
"30193","(۳۰۱۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن حَبِیبٍ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ قَالَتْ : سَرَقَہَا سَارِقٌ فَدَعَتْ عَلَیْہِ ، فَقَالَ : لَہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُسَبِّخِی عَنْہُ۔ (ابوداؤد ۱۴۹۲۔ احمد ۱۳۶)","Sahih","Musannaf Ibn Abi Shaybah 30193","","","كتاب الدعاء"
"30194","(۳۰۱۹۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَن عُثْمَانَ بْنِ عَبْدِ اللہِ بْنِ مُوہِبٍ ، عَن مُوسَی بْنِ طَلْحَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَلِمَاتٌ إذَا قَالَہُنَّ الْعَبْدُ وَضَعَہُنَّ مَلَکُ فی جَنَاحِہِ ، ثُمَّ عَرَجَ بِہِنَّ فَلا یَمُرُّ عَلَی مَلأٍ مِنَ الْمَلائِکَۃِ إِلاَّ صَلَّوْا عَلَیْہِنَّ وَعَلَی قَائِلِہِنَّ حَتَّی یُوضَعن بَیْنَ یَدَیِ الرَّحْمَن : سُبْحَانَ اللہِ ، وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ ، وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ وَسُبْحَانَ اللہِ أنزاہ اللَّہُ عَنِ السُّوئِ۔ (طبرانی ۶۷۴۱)","","Musannaf Ibn Abi Shaybah 30194","","","كتاب الدعاء"
"30195","(۳۰۱۹۵) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَن حُصَیْنٍ ، قَالَ : الْتَقَی إبْرَاہِیمُ ، وَمُجَاہِدٌ فَقَالا : جَائَ أَعْرَابِیٌّ إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَشَکَا إلَیْہِ الْجُوعَ ، قَالَ : فَدَخَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلَی بُیُوتِہِ ، ثُمَّ خَرَجَ فَقَالَ : مَا وَجَدْت لَکَ فِی بُیُوتِ آلِ مُحَمَّدٍ شَیْئًا ، قَالَ : فَبَیْنَمَا ہُوَ کَذَلِکَ إذْ جَائَتْہُ شَاۃٌ مَصْلِیَّۃٌ ، وَقَالَ الآخَرُ جَائَتْہُ قَصْعَۃٌ مِنْ ثَرِیدٍ ، فَوُضِعَتْ بَیْنَ یَدَیَ الأَعْرَابِی ، فَقَالَ لہ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اطْعَمْ ، قَالَ : فَأَکَلَ ، فَقَالَ : یَا رَسُولَ اللہِ أَصَابَنِی الَّذِی أَصَابَنِی ، فَرَزَقَنِی اللَّہُ عَلَی یَدَیْک ، أَفَرَأَیْت إِنْ أَصَابَنِی ، وَأَنَا لَسْت عِنْدَکَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قُلِ : اللَّہُمَّ إنِّی أَسْأَلُک مِنْ فَضْلِکَ وَرَحْمَتِکَ ، فَإِنَّہُ لاَ یَمْلِکُہُمَا إِلاَّ أَنْتَ ، فَإِنَّ اللَّہَ رَازِقُک۔ (طبرانی ۱۰۳۷۹)","","Musannaf Ibn Abi Shaybah 30195","","","كتاب الدعاء"
"30196","(۳۰۱۹۶) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، حَدَّثَنَا وَائِلُ بْنُ دَاوُد ، قَالَ : سَمِعْتُ الْحَسَنَ الْبَصْرِیَّ یُحَدِّثُ ، قَالَ : بَیْنَمَا رَجُلٌ رَأَی فِی الْمَنَامِ ، أَنَّ مُنَادِیًا یُنَادِی فِی السَّمَائِ ، أَیُّہَا النَّاسُ ، خُذُوا سِلاحَ فَزَعِکُمْ ، فَعَمَدَ النَّاسُ فَأَخَذُوا السِّلاحَ حَتَّی إنَّ الرَّجُلَ یَجِیئُ، وَمَا مَعَہُ عَصًا ، فَنَادَی مُنَادٍ مِنَ السَّمَائِ : لَیْسَ ہَذَا سِلاحَ فَزَعِکُمْ، فَقَالَ رَجُلٌ مِنْ أَہْلِ الأَرْضِ: مَا سِلاحُ فَزَعِنَا ، فَقَالَ : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ۔","","Musannaf Ibn Abi Shaybah 30196","","","كتاب الدعاء"
"30197","(۳۰۱۹۷) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ عَن سُلَیْمَانَ بْنِ صُرَدٍ ، أَنَّ رَجُلَیْنِ تَلاحَیَا فَاشْتَدَّ غَضَبُ أَحَدِہِمَا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی لأعْرِفُ کَلِمَۃً لَوْ قَالَہَا ذَہَبَ غَضَبُہُ : أَعُوذُ بِاللہِ مِنَ الشَّیْطَانِ الرَّجِیمِ۔ (مسلم ۲۰۱۵۔ نسائی ۱۰۲۲۴)","Sahih","Musannaf Ibn Abi Shaybah 30197","","","كتاب الدعاء"
"30198","(۳۰۱۹۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَن مُعَاذِ بْنِ جَبَلٍ ، قَالَ : اسْتَبَّ رَجُلانِ عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَغَضِبَ أَحَدُہُمَا غَضَبًا شَدِیدًا حَتَّی إنِّی لَیُخَیَّلُ إلَیَّ أَنَّ أَنْفَہُ تَمَزَّعَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی لأَعْرِفُ کَلِمَۃً لَوْ قَالَہَا ہَذَا الْغَضْبَانُ ذَہَبَ غَضَبُہُ : أَعُوذُ بِاللہِ مِنَ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 30198","","","كتاب الدعاء"
"30199","(۳۰۱۹۹) حَدَّثَنَا قُرَادٌ أَبُو نُوحٍ حَدَّثَنَا عِکْرِمَۃُ بْنُ عَمَّارٍ حَدَّثَنَا سِمَاکٌ الْحَنَفِیُّ ، قَالَ أَبُو زَمِیلٍ حَدَّثَنِی ابْنُ عَبَّاسٍ ، قَالَ : حدَّثَنِی عُمَرُ بْنُ الْخَطَّابِ ، قَالَ : لَمَّا کَانَ یَوْمُ بَدْرٍ اسْتَقْبَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْقِبْلَۃَ ، ثُمَّ مَدَّ یَدَیْہِ ثُمَّ قَالَ : اللَّہُمَّ أَنْجِزْ لِی مَا وَعَدْتنِی ، اللَّہُمَّ ائْتِنِی مَا وَعَدْتنِی ، اللَّہُمَّ إنَّک إِنْ تُہْلِکْ ہَذِہِ الْعِصَابَۃَ مِنْ أَہْلِ الإِسْلامِ فَلا تُعْبَدْ فِی الأَرْضِ أَبَدًا ، فَمَا زَالَ یَسْتَغِیثُ رَبَّہُ وَیَدْعُو حَتَّی سَقَطَ رِدَاؤُہُ ، فَأَنْزَلَ اللَّہُ عَزَّ وَجَلَّ : {إذْ تَسْتَغِیثُونَ رَبَّکُمْ فَاسْتَجَابَ لَکُمْ أَنِّی مُمِدُّکُمْ بِأَلْفٍ مِنَ الْمَلائِکَۃِ مُرْدِفِینَ}۔n(مسلم ۱۳۸۳۔ ترمذی ۳۰۸۱)","Sahih","Musannaf Ibn Abi Shaybah 30199","","","كتاب الدعاء"
"30200","(۳۰۲۰۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : کَانَ من دعاء النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ حُنَیْنٍ : اللَّہُمَّ إنَّک إِنْ تَشَأْ لاَ تُعْبَدْ بَعْدَ الْیَوْمِ۔ (مسلم ۱۳۶۳۔ احمد ۱۲۱)","Sahih","Musannaf Ibn Abi Shaybah 30200","","","كتاب الدعاء"
"30201","(۳۰۲۰۱) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا لَقِیَ الْعَدُوَّ ، قَالَ : اللَّہُمَّ أَنْتَ عَضُدِی وَنَصِیرِی ، بِکَ أُحَاوِلُ وَبِکَ أَصُولُ وَبِکَ أُقَاتِلُ۔n(ابوداؤد ۲۶۲۵۔ ترمذی ۳۵۸۴)","","Musannaf Ibn Abi Shaybah 30201","","","كتاب الدعاء"
"30202","(۳۰۲۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، قَالَ : سَمِعْتُ ابْنَ أَبِی أَوْفَی یَقُولُ : دَعَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی الأَحْزَابِ فَقَالَ : اللَّہُمَّ مُنْزِلَ الْکِتَابِ ، سَرِیعَ الْحِسَابِ ، ہَازِمَ الأَحْزَابِ ، اہْزِمْہُمْ وَزَلْزِلْہُمْ۔ (بخاری ۶۳۹۲۔ مسلم ۱۳۶۳)","Sahih","Musannaf Ibn Abi Shaybah 30202","","","كتاب الدعاء"
"30203","(۳۰۲۰۳) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَن مُطَرِّفٍ ، عَنْ عَطِیَّۃَ ، عَنِ ابْنِ عَبَّاسٍ فِی قولہ تعالی : {فَإِذَا نُقِرَ فِی النَّاقُورِ} قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَیْفَ أَنْعَمُ وَصَاحِبُ الْقَرْنِ قَدِ الْتَقَمَ الْقَرْنَ وَحَنَی جَبْہَتَہُ یَسْتمِعُ مَتَی یُؤْمَرُ ، فَیَنْفُخُ ، فَقَالَ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَیْفَ نَقُولُ ؟ قَالَ : قُولُوا : {حَسْبُنَا اللَّہُ وَنِعْمَ الْوَکِیلُ} عَلَی اللہِ تَوَکَّلْنَا۔ (طبرانی ۱۲۶۷۰)","Da'if","Musannaf Ibn Abi Shaybah 30203","","","كتاب الدعاء"
"30204","(۳۰۲۰۴) حَدَّثَنَا وَکِیعٌ ، عَن زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : لَمَّا أُلْقِیَ إبْرَاہِیمُ عَلَیْہِ السَّلامُ فِی النَّارِ ، قَالَ : حَسْبُنَا اللَّہُ وَنِعْمَ الْوَکِیلُ۔","Sahih","Musannaf Ibn Abi Shaybah 30204","","","كتاب الدعاء"
"30205","(۳۰۲۰۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : التَّوَکُّلُ عَلَی اللہِ جِمَاعُ الإِیمَانِ۔","","Musannaf Ibn Abi Shaybah 30205","","","كتاب الدعاء"
"30206","(۳۰۲۰۶) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، عَن مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سَلِ اللَّہَ لِی الْوَسِیلَۃَ لاَ یَسْأَلُہَا لِی مُؤْمِنٌ فِی الدُّنْیَا إِلاَّ کُنْت لَہُ شَہِیدًا ، أَوْ شَفِیعًا یَوْمَ الْقِیَامَۃِ۔ (بخاری ۶۱۴۔ ابوداؤد ۵۳۰)","Da'if","Musannaf Ibn Abi Shaybah 30206","","","كتاب الدعاء"
"30207","(۳۰۲۰۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی الْعَلائِ ، عَن عُثْمَانَ بْنِ أَبِی الْعَاصِ ، أَنَّہُ أتَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : یَا رَسُولَ اللہِ ، إنَّ الشَّیْطَانَ حَالَ بَیْنَ صَلاتِی وَقِرَائَتِی ، فَقَالَ : ذَاکَ شَیْطَانٌ یُقَالُ لَہُ : خَنْزَبُ فَإِذَا أَحْسَسْت بِہِ فَاتْفُلْ عَلَی یَسَارِکَ ثَلاثًا وَتَعَوَّذْ بِاللہِ مِنْ شَرِّہِ","Sahih","Musannaf Ibn Abi Shaybah 30207","","","كتاب الدعاء"
"30208","(۳۰۲۰۸) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی جَعْفَرٍ الْخِطْمِیِّ ، عَن مُحَمَّدِ بْنِ کَعْبٍ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ الْخِطْمِیِّ ، أَنَّہُ کَانَ یَقُولُ : اللَّہُمَّ ارْزُقْنِی حُبَّک وَحُبَّ مَنْ یَنْفَعُنِی حُبُّہُ عِنْدَکَ ، اللَّہُمَّ وَارْزُقْنِی مَا أُحِبُّ وَاجْعَلْہُ قُوَّۃً لِی فِیمَا تُحِبُّ ، وَمَا زَوَیْت عَنِّی مِمَّا أُحِبُّ فَاجْعَلْہُ لِی فَرَاغًا فِیمَا تُحِبُّ۔","Sahih","Musannaf Ibn Abi Shaybah 30208","","","كتاب الدعاء"
"30209","(۳۰۲۰۹) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَن حُصَیْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ مِنَّا رَجُلٌ یُقَالُ لَہُ ہَمَّامُ بْنُ الْحَارِثِ ، وَکَانَ لاَ یَنَامُ إِلاَّ قَاعِدًا فِی مَسْجِدِہِ فِی صَلاتِہِ ، وَکَانَ یَقُولُ : اللَّہُمَّ اشْفِنِی مِنَ النَّوْمِ بِیَسِیرٍ وَارْزُقْنِی سَہَرًا فِی طَاعَتِک۔","No Data Available","Musannaf Ibn Abi Shaybah 30209","","","كتاب الدعاء"
"30210","(۳۰۲۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَأَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، قَالَ : حدَّثَنَا زِیَادُ بْنُ عِلاقَۃَ ، عَنْ عَمِّہِ قُطْبَۃَ بْنِ مَالِکٍ، أَنَّہُ کَانَ یَقُولُ اللَّہُمَّ جَنِّبْنِی مُنْکَرَاتِ الأَعْمَالِ وَالأَخْلاقِ وَالأَہْوَائِ وَالأَدْوَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 30210","","","كتاب الدعاء"
"30211","(۳۰۲۱۱) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنِ الْہَیْثَمِ عَن طَلْحَۃَ ، عَن مُجَاہِدٍ ، قَالَ : کَانَ یَتَعَوَّذُ مِنَ الأَسَدِ وَالأَسْوَدِ وَرُوحِ الأَذَی۔","","Musannaf Ibn Abi Shaybah 30211","","","كتاب الدعاء"
"30212","(۳۰۲۱۲) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنِ الأَعْمَشِ ، عَن طَلْحَۃَ الْیَامِیِّ ، عَنْ أَبِی إدْرِیسَ رَجُلٌ مِنْ أَہْلِ الْیَمَنِ قَالَ : کَانَ یَقُولُ : اللَّہُمَّ اجْعَلْ نَظَرِی عِبَرًا وَصَمْتِی تَفَکُّرًا وَمَنْطِقِی ذِکْرًا۔","","Musannaf Ibn Abi Shaybah 30212","","","كتاب الدعاء"
"30213","(۳۰۲۱۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلابَۃَ ، أَنَّہُ قَالَ فِی دُعَائِہِ : اللَّہُمَّ إنِّی أَسْأَلُک الطَّیِّبَاتِ وَتَرْکَ الْمُنْکَرَاتِ وَحُبَّ الْمَسَاکِینِ وَأَنْ تَتُوبَ عَلَی ، وَإِذَا أَرَدْت بِعِبَادِکَ فِتْنَۃً فَتَوَفَّنِی غَیْرَ مَفْتُونٍ۔","","Musannaf Ibn Abi Shaybah 30213","","","كتاب الدعاء"
"30214","(۳۰۲۱۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، حَدَّثَنَا مُوسَی بْنُ مُسْلِمٍ الطَّحَّانُ عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ، قَالَ : کَانَ نَفَرٌ مُتَوَاخِینَ ، قَالَ : فَفَقَدُوا رَجُلاً مِنْہُمْ أَیَّامًا ، ثُمَّ أَتَاہُمْ فَقَالُوا : أَیْنَ کُنْت ؟ فَقَالَ : دَیْنٌ کَانَ عَلَیَّ فَقَالَ : ہَلاَّ دَعَوْت بہَؤُلائِ الدَّعَوَاتِ : اللَّہُمَّ مُنَفِّسَ کُلِّ کَرْبٍ وَفَارِجَ کُلِّ ہَمٍّ وَکَاشِفَ کُلِّ غَمٍّ وَمُجِیبَ دَعْوَۃِ الْمُضْطَرِّینَ رَحْمَنَ الدُّنْیَا وَالآخِرَۃِ وَرَحِیمَہُمَا ، أَنْتَ رَحْمَانِی فَارْحَمْنِی یَا رَحْمَنُ رَحْمَۃً تُغْنِینِی بِہَا عَن رَحْمَۃِ مَنْ سِوَاک۔","","Musannaf Ibn Abi Shaybah 30214","","","كتاب الدعاء"
"30215","(۳۰۲۱۵) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَن دَاوُد ، عَنِ الشَّعْبِیِّ ، قَالَ : دَخَلْنَا عَلَی رَبِیعِ بْنِ خُثَیْمٍ ، فَدَعَا بِہَذِہِ الدَّعَوَاتِ : اللَّہُمَّ لَکَ الْحَمْدُ کُلُّہُ وَبِیَدِکَ الْخَیْرُ کُلُّہُ ، وَإِلَیْک یَرْجِعُ الأَمْرُ کُلُّہُ ، وَأَنْتَ إلَہُ الْخَلْقِ کُلِّہِ ، نَسْأَلُک مِنَ الْخَیْرِ کُلِّہِ ، وَنَعُوذُ بِکَ مِنَ الشَّرِّ کُلِّہِ۔","","Musannaf Ibn Abi Shaybah 30215","","","كتاب الدعاء"
"30216","(۳۰۲۱۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا عَلِیُّ بْنُ مَسْعَدَۃَ ، عَنْ عَبْدِ اللہِ الرُّومِیِّ ، قَالَ : کُنَّا عنْدَ أَنَسِ بْنِ مَالِکٍ فَقَالَ لَہُ رَجُلٌ : یَا أَبَا حَمْزَۃَ ، إنَّ إخْوَانَک یُحِبُّونَ أَنْ تَدْعُوَ لَہُمْ ، فَقَالَ : اللَّہُمَّ اغْفِرْ لَنَا وَارْحَمْنَا وَآتِنَا فِی الدُّنْیَا حَسَنَۃً وَفِی الآخِرَۃِ حَسَنَۃً وَقِنَا عَذَابَ النَّارِ ، قَالُوا : زِدْنَا یَا أَبَا حَمْزَۃَ ، فَرَدَّہَا عَلَیْہِمْ ، قَالُوا : زِدْنَا یَا أَبَا حَمْزَۃَ ، قَالَ : حَسْبُنَا اللَّہُ یَا أَبَا فُلانٍ ، إِنْ أُعْطِینَاہَا ، فَقَدْ أُعْطِینَا خَیْرَ الدُّنْیَا وَالآخِرَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 30216","","","كتاب الدعاء"
"30217","(۳۰۲۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ ، عَن تُبَیْعٍ ، عَن کَعْبٍ ، قَالَ : لَوْلا کَلِمَاتٌ أَقُولُہُنَّ لَجَعَلَتْنِی الْیَہُودُ أَصِیحُ مَعَ الْحُمْرِ النَّاہِقَۃِ وَأَعْوِی مَعَ الْکِلابِ الْعَاوِیَۃِ ، أَعُوذُ بِوَجْہِکَ الْکَرِیمِ وَبِاسْمِکَ الْعَظِیمِ وَبِکَلِمَاتِکَ التَّامَّۃِ الَّتِی لاَ یُجَاوِزُہُنَّ بَرٌّ ، وَلا فَاجِرٌ ، الَّذِی لاَ یَخْفِرُ جَارُہُ مِنْ شَرِّ مَا یَنْزِلُ مِنَ السَّمَائِ ، وَمَا یَعْرُجُ فِیہَا ، وَمِنْ شَرِّ مَا خَلَقَ وَذَرَأَ وَبَرَأَ۔","","Musannaf Ibn Abi Shaybah 30217","","","كتاب الدعاء"
"30218","(۳۰۲۱۸) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ عَوْنٍ ، قَالَ : قالَتْ أَسْمَائُ بِنْتُ أَبِی بَکْرٍ : مَنْ قَرَأَ بَعْدَ الْجُمُعَۃِ فَاتِحَۃَ الْکِتَابِ وَ(قُلْ ہُوَ اللَّہُ أَحَدٌ) وَ(قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ) وَ(قُلْ أَعُوذُ بِرَبِّ النَّاسِ) حَفِظَ مَا بَیْنَہُ وَبَیْنَ الْجُمُعَۃِ الأخری۔","Sahih","Musannaf Ibn Abi Shaybah 30218","","","كتاب الدعاء"
"30219","(۳۰۲۱۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَن فِرَاسٍ ، عَن شَیْبَانَ ، عَنِ الشَّعْبِیِّ ، عَنْ أَبِی مُسْلِمٍ ، أَنَّہُ کَانَ یَقُولُ فِی آخِرِ قَوْلِہِ : وَصَلَ اللَّہُ بِالإِیمَانِ أُخُوَّتَکُمْ وَقَرَّبَ بِرَحْمَتِہِ مَوَدَّتَکُمْ ، وَمَکَّنَ بِإِحْسَانِہِ کَرَامَتَکُمْ ، وَنَوَّرَ بِالْقُرْآنِ صُدُورَکُمْ۔","","Musannaf Ibn Abi Shaybah 30219","","","كتاب الدعاء"
"30220","(۳۰۲۲۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، سُلَیْمَانُ بْنُ حَیَّانَ ، عَن مُحَمَّدِ بْنِ عَجْلانَ ، عَن سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَن عُقْبَۃَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا سَأَلَ سَائِلٌ ، وَلا اسْتَعَاذَ مُسْتَعِیذٌ بِمِثْلِہِمَا، یَعْنِی الْمُعَوِّذَتَیْنِ۔ (ابوداؤد ۱۴۵۸۔ دارمی ۳۴۴۰)","Hasan","Musannaf Ibn Abi Shaybah 30220","","","كتاب الدعاء"
"30221","(۳۰۲۲۱) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، أَنَّ الْحَسَنَ بْنَ عَلِیِّ بْنِ أَبِی طَالِبٍ کَانَ یَقُولُ إذَا طَلَعَتِ الشَّمْسُ : سَمِعَ سَامِعٌ بِحَمْدِ اللہِ الأَعْظَمِی ، لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، سَمِعَ سَامِعٌ بِحَمْدِ اللہِ الأَکْبَرِی ، لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، سَمِعَ سَامِعٌ بِحَمْدِ اللہِ الأَمْجَدِی ، لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، یَتْبَعُ ہَذَا النَّحْوَ۔","Sahih","Musannaf Ibn Abi Shaybah 30221","","","كتاب الدعاء"
"30222","(۳۰۲۲۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن سِمَاکٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَرَادَ أَنْ یَخْرُجَ فِی سَفَرٍ قَالَ : اللَّہُمَّ أَنْتَ الصَّاحِبُ فِی السَّفَرِ وَالْخَلِیفَۃُ فِی الأَہْلِ اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْضُّبْنَۃِ فِی السَّفَرِ ، وَالْکَآبَۃِ فِی الْمُنْقَلَبِ ، اللَّہُمَّ اقْبِضْ لَنَا الأَرْضَ وَہَوِّنْ عَلَیْنَا السَّفَرَ۔ (احمد ۲۹۹۔ ابن حبان ۲۷۱۶)","","Musannaf Ibn Abi Shaybah 30222","","","كتاب الدعاء"
"30223","(۳۰۲۲۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَاصِمٍ ، عَنْ عَبْدِ اللہِ بْنِ سَرْجِسَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا خَرَجَ مُسَافِرًا یَتَعَوَّدُ مِنْ وَعْثَائِ السَّفَرِ وَکَآبَۃِ الْمُنْقَلَبِ وَالْحَوْرِ بَعْدَ الْکَوْرِ ، وَمِنْ دَعْوَۃِ الْمَظْلُومِ وَمِنْ سُوئِ الْمَنْظَرِ فِی الأَہْلِ وَالْمَالِ۔ (مسلم ۹۷۹۔ احمد ۸۳)","Sahih","Musannaf Ibn Abi Shaybah 30223","","","كتاب الدعاء"
"30224","(۳۰۲۲۴) حَدَّثَنَا وَکِیعٌ ، عَن أُسَامَۃَ بْنِ زَیْدٍ ، عَن سَعِیدٍ الْمَقْبُرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أَرَادَ رَجُلٌ سَفَرًا فَأَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : أَوْصِنِی ، فَقَالَ : أُوصِیک بِتَقْوَی اللہِ وَالتَّکْبِیرِ عَلَی کُلِّ شَرَفٍ۔ (ترمذی ۳۴۴۵۔ احمد ۴۴۳)","Hasan","Musannaf Ibn Abi Shaybah 30224","","","كتاب الدعاء"
"30225","(۳۰۲۲۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ عَجْلانَ ، قَالَ : حدَّثَنِی عَوْنُ بْنُ عَبْدِ اللہِ ، أَنَّ رَجُلاً أَتَی ابْنَ مَسْعُودٍ فَقَالَ : إنِّی أُرِیدُ سَفَرًا فَأَوْصِنِی ، فَقَالَ : إذَا تَوَجَّہْت فَقُلْ : بِسْمِ اللہِ حَسْبِی اللَّہُ وَتَوَکَّلْت عَلَی اللہِ فَإِنَّک إذَا قُلْتَ : بِسْمِ اللہِ ، قَالَ الْمَلَکُ : ہُدِیْتَ وَإِذَا قُلْتَ : حَسْبِی اللَّہُ ، قَالَ الْمَلَک ، حُفِظْت ، وَإِذَا قُلْتَ : تَوَکَّلْت عَلَی اللہِ ، قَالَ الْمَلَکُ : کُفِیت۔","","Musannaf Ibn Abi Shaybah 30225","","","كتاب الدعاء"
"30226","(۳۰۲۲۶) حَدَّثَنَا ہُشَیْمٌ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَقُولُونَ فِی السَّفَرِ : اللَّہُمَّ بَلاغًا یُبَلِّغُ خَیْرًا مَغْفِرَتِکَ مِنْک وَرِضْوَانًا ، بِیَدِکَ الْخَیْرُ ، إنَّک عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، اللَّہُمَّ أَنْتَ الصَّاحِبُ فِی السَّفَرِ وَالْخَلِیفَۃُ عَلَی الأَہْلِ ، اللَّہُمَّ اطْوِ لَنَا الأَرْضَ وَہَوِّنْ عَلَیْنَا السَّفَرَ ، اللَّہُمَّ إنَّا نَعُوذُ بِکَ مِنْ وَعْثَائِ السَّفَرِ وَکَآبَۃِ الْمُنْقَلَبِ وَسُوئِ الْمَنْظَرِ فِی الأَہْلِ وَالْمَالِ۔","","Musannaf Ibn Abi Shaybah 30226","","","كتاب الدعاء"
"30227","(۳۰۲۲۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن یَزِیدَ ، عَن مُجَاہِدٍ ، قَالَ : سَافَرْت مَعَ ابْنِ عُمَرَ فَإِذَا کَانَ مِنَ السَّحَرِ نَادَی : سَمِعَ سَامِعٌ بِحَمْدِ اللہِ وَنِعْمَتِہِ وَحُسْنِ بَلائِہِ عِنْدَنَا ، اللَّہُمَّ صَاحِبْنَا فَأَفْضِلْ عَلَیْنَا ثَلاثًا اللَّہُمَّ عَائِذٌ بِکَ مِنْ جَہَنَّمَ ثَلاثًا۔","Da'if","Musannaf Ibn Abi Shaybah 30227","","","كتاب الدعاء"
"30228","(۳۰۲۲۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن سِمَاکٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا أَرَادَ الرُّجُوعَ ، یعنی مِنَ السَّفَرِ قَالَ : تَائِبُونَ عَابِدُونَ لِرَبِّنَا حَامِدُونَ ، وَإِذَا دَخَلَ عَلَی أَہْلِہِ ، قَالَ : تَوْبًا تَوْبًا لِرَبِّنَا أَوْبًا لاَ یُغَادِرُ عَلَیْنَا حَوْبًا۔","","Musannaf Ibn Abi Shaybah 30228","","","كتاب الدعاء"
"30229","(۳۰۲۲۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا قَفَلَ مِنْ سَفَرٍ ، قَالَ : آیِبُونَ تَائِبُونَ عَابِدُونَ لِرَبِّنَا حَامِدُونَ۔ (احمد ۳۰۰۔ طیالسی ۷۱۶)","Sahih","Musannaf Ibn Abi Shaybah 30229","","","كتاب الدعاء"
"30230","(۳۰۲۳۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، حَدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ کَانَ إذَا رَجَعَ مِنَ الْجَیْشِ ، أَوِ السَّرَایَا ، أَوِ الْحَجِّ ، أَوِ الْعُمْرَۃِ ، قَالَ کُلَّمَا أَوْفَی عَلَی ثَنِیَّۃٍ ، أَوْ فَدْفَدٍ کَبَّرَ ثَلاثًا ، ثُمَّ قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ صَدَقَ وَعْدَہُ تَائِبُونَ عَابِدُونَ لِرَبِّنَا حَامِدُونَ۔ (بخاری ۱۷۹۷۔ مسلم ۹۸۰)","Sahih","Musannaf Ibn Abi Shaybah 30230","","","كتاب الدعاء"
"30231","(۳۰۲۳۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، حَدَّثَنَا عُبَیْدُ اللہِ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ ذَکَرَ مِثْلَہُ ، أَوْ نَحْوَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30231","","","كتاب الدعاء"
"30232","(۳۰۲۳۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، حَدَّثَنَا سَعِیدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن یَحْیَی بْنِ أَبِی إِسْحَاقَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، أَنَّہُ کَانَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا کَانَ بِظَہْرِ الْبَیْدَائَ ، أَو بالْحَرَّۃَ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ آیِبُونَ تَائِبُونَ عَابِدُونَ إِنْ شَائَ اللَّہُ لِرَبِّنَا حَامِدُونَ۔ (بخاری ۳۰۸۵۔ مسلم ۹۸۰)","Sahih","Musannaf Ibn Abi Shaybah 30232","","","كتاب الدعاء"
"30233","(۳۰۲۳۳) حَدَّثَنَا ہُشَیْمٌ ، أَخْبَرَنَا الْعَوَّامُ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : کَانُوا إذَا قَفَلُوا قَالُوا : آیِبُونَ إِنْ شَائَ اللَّہُ تَائِبُونَ لِرَبِّنَا حَامِدُونَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30233","","","كتاب الدعاء"
"30234","(۳۰۲۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : حدَّثَنَا مَکْحُولٌ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمَّا دَخَلَ مَکَّۃَ تَلَقَّتْہُ الْجِنُّ بِالشَّرَرِ یَرْمُونَہُ ، فَقَالَ جِبْرِیلُ : تَعَوَّذْ یَا مُحَمَّدُ ، فَتَعَوَّذَ بِہَؤُلائِ الْکَلِمَاتِ فَدُحِرُوا عَنْہُ ، أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّاتِ الَّتِی لاَ یُجَاوِزُہُنَّ بَرٌّ ، وَلا فَاجِرٌ ، مِنْ شَرِّ مَا یَنْزِلُ مِنَ السَّمَائِ ، وَمَا یَعْرُجُ فِیہَا ، وَمِنْ شَرِّ مَا بُثَّ فِی الأَرْضِ ، وَمَا یَخْرُجُ مِنْہَا ، وَمِنْ شَرِّ اللَّیْلِ وَالنَّہَارِ ، وَمِنْ کُلِّ طَارِقٍ یَطْرُقُ بِخَیْرٍ یَا رَحْمَنُ۔","","Musannaf Ibn Abi Shaybah 30234","","","كتاب الدعاء"
"30235","(۳۰۲۳۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَن مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، أَنَّ الْوَلِیدَ بْنَ الْوَلِیدِ بْنِ الْمُغِیرَۃِ الْمَخْزُومِیَّ شَکَا إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَدِیثَ نَفْسٍ وَجَدَہُ وَأَنَّہُ قَالَ لَہُ : إذَا أَتَیْتَ إِلَی فِرَاشِکَ فَقُلْ : أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّۃِ مِنْ غَضَبِہِ وَعِقَابِہِ ، وَشَرِّ عِبَادِہِ ، وَمِنْ ہَمَزَاتِ الشَّیَاطِینِ وَأَنْ یَحْضُرُونِ ، فَو الَّذِی نَفْسِی بِیَدِہِ لاَ یَضُرُّک شَیْئٌ حَتَّی تُصْبِحَ۔","","Musannaf Ibn Abi Shaybah 30235","","","كتاب الدعاء"
"30236","(۳۰۲۳۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَن زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَن مُصْعَبٍ ، عَن یَحْیَی بْنِ جَعْدَۃَ ، قَالَ : کَانَ خَالِدُ بْنُ الْوَلِیدِ یَفْزَعُ مِنَ اللَّیْلِ حَتَّی یَخْرُجَ ، وَمَعَہُ سَیْفُہُ فَخُشِیَ عَلَیْہِ أَنْ یُصِیبَ أَحَدًا ، فَشَکَا ذَلِکَ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : إنَّ جِبْرِیلَ ، قَالَ لِی : إنَّ عِفْرِیتًا مِنَ الْجِنِّ یَکِیدُک ، فَقُلْ أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّۃِ الَّتِی لاَ یُجَاوِزُہُنَّ بَرٌّ ، وَلا فَاجِرٌ ، مِنْ شَرِّ مَا یَنْزِلُ مِنَ السَّمَائِ ، وَمَا یَعْرُجُ فِیہَا ، وَمِنْ شَرِّ مَا ذَرَأَ فِی الأَرْضِ ، وَمَا یَخْرُجُ مِنْہَا ، وَشَرِّ فِتَنِ اللَّیْلِ وَالنَّہَارِ ، وَکُلِّ طَارِقٍ إِلاَّ طَارِقًا یَطْرُقُ بِخَیْرٍ یَا رَحْمَنُ فَقَالَہُنَّ خَالِدٌ فَذَہَبَ ذَلِکَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 30236","","","كتاب الدعاء"
"30237","(۳۰۲۳۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا فَزِعَ أَحَدُکُمْ مِنْ نَوْمِہِ فَلْیَقُلْ : بِسْمِ اللہِ أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّۃِ مِنْ غَضَبِہِ وَسُوئِ عِقَابِہِ وَشَرِّ عِبَادِہِ وَمِنْ شَرِّ الشَّیَاطِینِ ، وَمَا یَحْضُرُونِ۔","","Musannaf Ibn Abi Shaybah 30237","","","كتاب الدعاء"
"30238","(۳۰۲۳۸) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ ، حَدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، حَدَّثَنَا أَبُو التَّیَّاحِ ، قَالَ : سَأَلَ رَجُلٌ عَبْدَ اللہ بْنَ خَنْبَش : کَیْفَ صَنَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ کَادَتْہُ الشَّیَاطِینُ ؟ قَالَ : جَائَتِ الشَّیَاطِینُ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنَ الأَوْدِیَۃِ ، وَتَحَدَّرَتْ عَلَیْہِ مِنَ الْجِبَالِ ، وَفِیہِمْ شَیْطَانٌ مَعَہُ شُعْلَۃُ نَارٍ یُرِیدُ أَنْ یَحْرِقَ بِہَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأُرْعِبَ مِنْہُمْ ، قَالَ جَعْفَرٌ : أَحْسَبُہُ ، قَالَ : جَعَلَ یَتَأَخَّرُ ، قَالَ : وَجَائَہُ جِبْرِیلُ فَقَالَ : یَا مُحَمَّدُ ، قُلْ ، قَالَ : مَا أَقُولُ ؟ قَالَ : قُلْ : أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّاتِ الَّتِی لاَ یُجَاوِزُہُنَّ بَرٌّ ، وَلا فَاجِرٌ مِنْ شَرِّ مَا خَلَقَ وَذَرَأَ وَبَرَأَ ، وَمِنْ شَرِّ مَا یَنْزِلُ مِنَ السَّمَائِ ، وَمِنْ شَرِّ مَا یَعْرُجُ فِیہَا ، وَمِنْ شَرِّ مَا ذَرَأَ فِی الأَرْضِ وَمِنْ شَرِّ مَا یَخْرُجُ مِنْہَا وَمِنْ شَرِّ فِتَنِ اللَّیْلِ وَالنَّہَارِ ، وَمِنْ شَرِّ کُلِّ طَارِقٍ إِلاَّ طَارِقًا یَطْرُقُ بِخَیْرٍ یَا رَحْمَنُ ، قَالَ : فَطُفِئَتْ نَارُ الشَّیْطَانِ ، قَالَ : وَہَزَمَہُمَ اللَّہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30238","","","كتاب الدعاء"
"30239","(۳۰۲۳۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ حَدَّثَنَا مِسْعَرٌ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنِ ابْنِ سَابِطٍ ، قَالَ : أَصَابَ خَالِدَ بْنَ الْوَلِیدِ أَرَقٌ فَقَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَلا أُعَلِّمُک کَلِمَاتٍ إذَا قُلْتہنَّ نِمْت اللَّہُمَّ رَبَّ السَّمَاوَاتِ، وَمَا أَظَلَّتْ ، وَرَبَّ الأَرْضِینَ ، وَمَا أَقَلَّتْ وَرَبَّ الشَّیَاطِینِ ، وَمَا أَضَلَّتْ ، کُنْ لِی جَاری مِنْ شَرِّ خَلْقِکَ کُلِّہِمْ جَمِیعًا أَنْ یَفْرُطَ عَلَیَّ أَحَدٌ مِنْہُمْ ، أَوْ یَبْغِی ، عَزَّ جَارُک ، وَلا إلَہَ غَیْرُک۔ (ترمذی ۳۵۲۳۔ طبرانی ۹۸۴)","","Musannaf Ibn Abi Shaybah 30239","","","كتاب الدعاء"
"30240","(۳۰۲۴۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن رَجُلٍ مِنْ أَہْلِ الشَّامِ ، عَن مَکْحُولٍ ، أن النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا رَأَی الْبَیْتَ قَالَ : اللَّہُمَّ زِدْ ہَذَا الْبَیْتَ تَشْرِیفًا وَتَعْظِیمًا وَمَہَابَۃً ، وَزِدْ مَنْ حَجَّہُ ، أَو اعْتَمَرَہُ تَشْرِیفًا وَتَعْظِیمًا وَتَکْرِیمًا وَبِرًّا۔ (بیہقی ۷۳)","Da'if","Musannaf Ibn Abi Shaybah 30240","","","كتاب الدعاء"
"30241","(۳۰۲۴۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ سَعِیدٍ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ، أَنَّہُ کَانَ إذَا دَخَلَ مَسْجِدَ الْکَعْبَۃَ، وَنَظَرَ إِلَی الْبَیْتِ، قَالَ: اللَّہُمَّ أَنْتَ السَّلامُ وَمِنْک السَّلامُ فَحَیِّنَا رَبَّنَا بِالسَّلامِ۔","","Musannaf Ibn Abi Shaybah 30241","","","كتاب الدعاء"
"30242","(۳۰۲۴۲) حَدَّثَنَا جَرِیرٌ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَوَّلُ مَا تَدْخُلُ مکۃ فَانْتَہَیْت إِلَی الْحِجْرِ فَاحْمَدَ اللَّہَ عَلَی حُسْنِ تَیْسِیرِہِ وَبَلاغِہِ۔","","Musannaf Ibn Abi Shaybah 30242","","","كتاب الدعاء"
"30243","(۳۰۲۴۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَن مُحَمَّدِ بْنِ سَعِیدٍ ، عَنْ أَبِیہِ ، أَنَّ عُمَرَ کَانَ إذَا دَخَلَ الْبَیْتَ ، قَالَ : اللَّہُمَّ أَنْتَ السَّلامُ وَمِنْک السَّلامُ فَحَیِّنَا رَبَّنَا بِالسَّلامِ۔","Da'if","Musannaf Ibn Abi Shaybah 30243","","","كتاب الدعاء"
"30244","(۳۰۲۴۴) حَدَّثَنَا وَکِیعٌ ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، عَن وَہْبِ بْنِ وَہْبٍ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ ، عَن عُمَرَ ، أَنَّہُ کَانَ یَقُولُ إذَا اسْتَلَمَہُ یَعْنِی الْحَجَرَ : آمَنْت بِاللہِ وَکَفَرْت بِالطَّاغُوتِ۔","","Musannaf Ibn Abi Shaybah 30244","","","كتاب الدعاء"
"30245","(۳۰۲۴۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْمَسْعُودِیِّ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ یَقُولُ إذَا اسْتَلَمَ الْحَجَرَ : اللَّہُمَّ تَصْدِیقًا بِکِتَابِکَ وَسُنَّۃِ نَبِیِّک۔","Da'if","Musannaf Ibn Abi Shaybah 30245","","","كتاب الدعاء"
"30246","(۳۰۲۴۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن عُبَیْدٍ الْمُکْتِبِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا اسْتَلَمْت الْحَجَرَ فَقُلْ : لاَ إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30246","","","كتاب الدعاء"
"30247","(۳۰۲۴۷) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَن شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، عَن مُجَاہِدٍ ، قَالَ : کَانَ یُسْتَحَبُّ أَنْ یُقَالَ عِنْدَ اسْتِلامِ الْحَجَرِ : اللَّہُمَّ تَصْدِیقًا بِکِتَابِکَ وَسُنَّۃِ نَبِیِّک۔","No Data Available","Musannaf Ibn Abi Shaybah 30247","","","كتاب الدعاء"
"30248","(۳۰۲۴۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَن یَحْیَی بْنِ عُبَیْدٍ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ السَّائِبِ ، قَالَ سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ بَیْنَ الرُّکْنِ وَالْحَجَرِ : {رَبَّنَا آتِنَا فِی الدُّنْیَا حَسَنَۃً وَفِی الآخِرَۃِ حَسَنَۃً وَقِنَا عَذَابَ النَّارِ}۔","Da'if","Musannaf Ibn Abi Shaybah 30248","","","كتاب الدعاء"
"30249","(۳۰۲۴۹) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ، عَنْ عَطَائٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ: کَانَ مِنْ دُعَائِ ابْنِ عَبَّاسٍ الَّذِی لاَ یَدَعُ بَیْنَ الرُّکْنِ وَالْمَقَامِ أَنْ یَقُولَ : اللَّہُمَّ قَنِّعْنِی بِمَا رَزَقْتنِی وَبَارِکْ لِی فِیہِ وَاخْلُفْ عَلَیَّ کُلَّ غَائِبَۃٍ لِی بِخَیْرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 30249","","","كتاب الدعاء"
"30250","(۳۰۲۵۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مَنْصُورٍ ، عَن ہِلالِ بْنِ یَِسَافٍ ، عَنْ أَبِی شُعْبَۃَ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ عِنْدَ الرُّکْنِ أو الْحَجَرِ : {رَبَّنَا آتِنَا فِی الدُّنْیَا حَسَنَۃً وَفِی الآخِرَۃِ حَسَنَۃً وَقِنَا عَذَابَ النَّارِ}۔","Da'if","Musannaf Ibn Abi Shaybah 30250","","","كتاب الدعاء"
"30251","(۳۰۲۵۱) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ ہُرْمُزَ ، عَن مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : عَلَی الرُّکْنِ الْیَمَانِیِّ مَلَکٌ یَقُولُ آمِینَ ، فَإِذَا مَرَرْتُمْ بِہِ فَقُولُوا : اللَّہُمَّ رَبَّنَا آتِنَا فِی الدُّنْیَا حَسَنَۃً وَفِی الآخِرَۃِ حَسَنَۃً وَقِنَا عَذَابَ النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 30251","","","كتاب الدعاء"
"30252","(۳۰۲۵۲) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ بَدَأَ بِالصَّفَا فَرَقَیَ عَلَیْہِ حَتَّی رَأَی الْبَیْتَ وَوَحَّدَ اللَّہَ وَکَبَّرَہُ ، وَقَالَ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْک، وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ، لاَ إلَہَ إِلاَّ اللَّہُ وحدہ أَنْجَزَ وَعْدَہُ وَنَصَرَ عَبْدَہُ وَہَزَمَ الأَحْزَابَ وَحْدَہُ، ثُمَّ دَعَا بَیْنَ ذَلِکَ فَقَالَ: مِثْلَ ہَذَا ثَلاثَ مَرَّاتٍ، ثُمَّ أَتَی الْمَرْوَۃَ فَفَعَلَ عَلَی الْمَرْوَۃِ کَمَا فَعَلَ عَلَی الصَّفَا۔","Sahih","Musannaf Ibn Abi Shaybah 30252","","","كتاب الدعاء"
"30253","(۳۰۲۵۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَن سُفْیَانَ ، عَن فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، عَنْ وَہْبِ بْنِ الأَجْدَعِ ، قَالَ سَمِعْت عُمَرَ یَقُولُ : إذَا قُمْتُمْ عَلَی الصَّفَا فَکَبِّرُوا سَبْعَ تَکْبِیرَاتٍ ، بَیْنَ کُلِّ تَکْبِیرَتَیْنِ حَمْدُ اللہِ وَثَنَاؤٌ عَلَیْہِ وَصَلاۃ اللہِ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَدُعَائٌ لِنَفْسِکَ ، وَعَلَی الْمَرْوَۃِ مِثْلُ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 30253","","","كتاب الدعاء"
"30254","(۳۰۲۵۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، عَن وَہْبِ بْنِ الأَجْدَعِ أَنَّہُ سَمِعَ عُمَرَ یَقُولُ : یَبْدَأُ بِالصَّفَا وَیَسْتَقْبِلُ الْقِبْلَۃَ الْبَیْتَ ، ثُمَّ یُکَبِّرُ سَبْعَ تَکْبِیرَاتٍ ، بَیْنَ کُلِّ تَکْبِیرَتَیْنِ حَمْدُ اللہِ ، وَصَلاۃٌ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَسْأَلَۃٌ لِنَفْسِکَ ، وَعَلَی الْمَرْوَۃِ مِثْلُ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 30254","","","كتاب الدعاء"
"30255","(۳۰۲۵۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَن عُبَیْدِ اللہِ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا صَعِدَ علی الصَّفَا اسْتَقْبَلَ الْبَیْتَ ، ثُمَّ کَبَّرَ ثَلاثًا ، ثُمَّ قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، یَرْفَعُ بِہَا صَوْتَہُ ، ثُمَّ یَدْعُو قَلِیلاً ، ثُمَّ یَفْعَلُ ذَلِکَ عَلَی الْمَرْوَۃِ حَتَّی یَفْعَلَ ذَلِکَ سَبْعَ مَرَّاتٍ فَیَکُونُ التَّکْبِیرُ واحِدًا وَعِشْرِینَ تَکْبِیرَۃً ، فَمَا یَکَادُ یَفْرُغُ حَتَّی یَشُقَّ عَلَیْنَا وَنَحْنُ شَبَابٌ۔","Sahih","Musannaf Ibn Abi Shaybah 30255","","","كتاب الدعاء"
"30256","(۳۰۲۵۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الأَصْبَغِ بْنِ یَزِیدَ ، عَنِ الْقَاسِمِ بْنِ أَبِی أَیُّوبَ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ کَانَ یقول : یَقُومُ الرجل عَلَی الصَّفَا وَالْمَرْوَۃِ قَدْرَ قِرَائَۃِ سُورَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 30256","","","كتاب الدعاء"
"30257","(۳۰۲۵۷) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن مُغِیرَۃَ ، قَالَ : قَالَ الْحَکَمُ لإِبْرَاہِیمَ ، رَأَیْت أَبَا بَکْرِ بْنَ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ یَقُومُ عَلَی الصَّفَا قَدْرَ مَا یَقْرَأُ الرَّجُلُ عِشْرِینَ وَمِئَۃَ آیَۃٍ فَقَالَ : إِنَّہُ لَفَقِیہٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 30257","","","كتاب الدعاء"
"30258","(۳۰۲۵۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ عَلَی الصَّفَا وَالْمَرْوَۃِ دُعَائٌ مُؤقَّتٌ فَادْعُ مَا شِئْت۔","","Musannaf Ibn Abi Shaybah 30258","","","كتاب الدعاء"
"30259","(۳۰۲۵۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، قَالَ: لَمْ أَسْمَعْ، أَنَّ عَلَی الصَّفَا وَالْمَرْوَۃِ دُعَائً مُوَقَّتًا۔","","Musannaf Ibn Abi Shaybah 30259","","","كتاب الدعاء"
"30260","(۳۰۲۶۰) حَدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : لَیْسَ فِیہَا دُعَائٌ مُوَقَّتٌ فَادْعُ بِمَا شِئْت وَسَلْ مَا شِئْت۔","","Musannaf Ibn Abi Shaybah 30260","","","كتاب الدعاء"
"30261","(۳۰۲۶۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَن مُعَاذِ بْنِ الْعَلائِ ، قَالَ : شَہِدْت عِکْرِمَۃَ بْنَ خَالِدٍ المخزومی یَقُولُ : لاَ أَعْلَمُ عَلَی الصَّفَا وَالْمَرْوَۃِ دُعَائً مُؤَقَّتًا۔","","Musannaf Ibn Abi Shaybah 30261","","","كتاب الدعاء"
"30262","(۳۰۲۶۲) حَدَّثَنَا مُحَمَّدُ بْنُ فضیل ، عَنِ الْعَلائِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ ، قَالَ : کَانَ عُمَرُ إذَا مَرَّ بِالْوَادِی بَیْنَ الصَّفَا وَالْمَرْوَۃِ یَسْعَی فِیہِ ویَقُولُ : رَبِّ اغْفِرْ وَارْحَمْ ، وَأَنْتَ الأَعَزُّ الأَکْرَمُ۔","","Musannaf Ibn Abi Shaybah 30262","","","كتاب الدعاء"
"30263","(۳۰۲۶۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الأَعْمَشِ ، عَن شَقِیقٍ ، عَن مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : کَانَ إذَا سَعَی فِی بَطْنِ الْوَادِی ، قَالَ : رَبِّ اغْفِرْ وَارْحَمْ إنَّک أَنْتَ الأَعَزُّ الأَکْرَمُ۔","Hasan","Musannaf Ibn Abi Shaybah 30263","","","كتاب الدعاء"
"30264","(۳۰۲۶۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ حَجَّاجِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْہَیْثمِ بْنِ حَنَشٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ : رَبّ اغْفِرْ وَارْحَمْ ، وأَنْتَ الأَعَزُّ الأَکْرَمُ۔","Da'if","Musannaf Ibn Abi Shaybah 30264","","","كتاب الدعاء"
"30265","(۳۰۲۶۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، أَنَّ أَبَاہُ کَانَ یَقُولُ وَہُوَ یَسْعَی بَیْنَ الصَّفَا وَالْمَرْوَۃِ اللَّہُمَّ إنَّ ہَذَا وَاحِدٌ إِنْ تَما أَتَمَّہ اللہ ، وَقَد أَتَمَّا۔","","Musannaf Ibn Abi Shaybah 30265","","","كتاب الدعاء"
"30266","(۳۰۲۶۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَن لَیْثٍ ، عَن مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ أبِیہِ ، قَالَ : أَفَضْت مَعَ عَبْدِ اللہِ فَرَمَی سَبْع حَصَیَاتٍ ، یُکَبِّرُ مَعَ کُلِّ حَصَاۃٍ ، وَاسْتَبْطَنَ الْوَادِی حَتَّی إذَا فَرَغَ ، قَالَ : اللَّہُمَّ اجْعَلْہُ حَجًّا مَبْرُورًا ، وَذَنْبًا مَغْفُورًا ، ثُمَّ قَالَ : ہَکَذَا رَأَیْت الَّذِی أُنْزِلَتْ عَلَیْہِ سُورَۃُ الْبَقَرَۃِ صَنَعَ۔","Da'if","Musannaf Ibn Abi Shaybah 30266","","","كتاب الدعاء"
"30267","(۳۰۲۶۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْہَیْثمِ بْنِ حَنَشٍ ، قَالَ سَمِعْت ابْنَ عُمَرَ حِینَ رَمَی الْجِمَارَ یَقُولُ : اللَّہُمَّ اجْعَلْہُ حَجًّا مَبْرُورًا وَذَنْبًا مَغْفُورًا۔","Da'if","Musannaf Ibn Abi Shaybah 30267","","","كتاب الدعاء"
"30268","(۳۰۲۶۸) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَن مُغِیرَۃَ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : مَا أَقُولُ إذَا رَمَیْت الْجَمْرَۃَ ؟ قَالَ : قُلِ : اللَّہُمَّ اجْعَلْہُ حَجًّا مَبْرُورًا وَذَنْبًا مَغْفُورًا ، قَالَ : قلت أَقُولُہُ مَعَ کُلِّ حَصَاۃٍ ؟ قَالَ : نَعَمْ إِنْ شِئْت۔","","Musannaf Ibn Abi Shaybah 30268","","","كتاب الدعاء"
"30269","(۳۰۲۶۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ عَلَی الْوُقُوفِ عِنْدَ الْجَمْرَتَیْنِ دُعَائٌ مُوَقَّتٌ فَادْعُ بِمَا شِئْت۔","No Data Available","Musannaf Ibn Abi Shaybah 30269","","","كتاب الدعاء"
"30270","(۳۰۲۷۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، قَالَ : کَانَ الْحَسَنُ یَقُولُ : یَدْعُو عِنْدَ الْجِمَارِ کُلِّہَا ، وَلا یُؤقِّتُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 30270","","","كتاب الدعاء"
"30271","(۳۰۲۷۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ فِی الْجَمْرَۃِ شَیْئٌ مُؤقَّتٌ ، لاَ یُزَادُ عَلَیْہِ ؟ قَالَ : لاَ إِلاَّ قَوْلَ جَابِرٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 30271","","","كتاب الدعاء"
"30272","(۳۰۲۷۲) حَدَّثَنَا وَکِیعٌ ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ أَخِیہِ ، عَنْ عَلِیٍّ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَکْثَرُ دُعَائِی وَدُعَائِ الأَنْبِیَائِ قَبْلِی بِعَرَفَۃَ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، اللَّہُمَّ اجْعَلْ فِی قَلْبِی نُورًا وَفِی سَمْعِی نُورًا وَفِی بَصَرِی نُورًا ، اللَّہُمَّ اشْرَحْ لِی صَدْرِی وَیَسِّرْ لِی أَمْرِی ، وَأَعُوذُ بِکَ مِنْ وَسْوَاسِ الصَّدْرِ ، وَشَتَاتِ الأَمْرِ ، وَفِتْنَۃِ الْقَبْرِ ، اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ شَرِّ مَا یَلِجُ فِی اللَّیْلِ ، وَشَرِّ مَا یَلِجُ فِی النَّہَارِ ، وَشَرِّ مَا تَہُبُّ بِہِ الرِّیَاحُ۔","Da'if","Musannaf Ibn Abi Shaybah 30272","","","كتاب الدعاء"
"30273","(۳۰۲۷۳) حَدَّثَنَا وَکِیعٌ ، عَن نَضْرِ بْنِ عَرَبِیٍّ ، عَنِ ابْنِ أَبِی حُسَیْنٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَکْثَرُ دُعَائِی وَدُعَائِ الأَنْبِیَائِ قَبْلِی بِعَرَفَۃَ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ یُحْیِی وَیُمِیتُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ۔","","Musannaf Ibn Abi Shaybah 30273","","","كتاب الدعاء"
"30274","(۳۰۲۷۴) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَن ہِلالٍ ، عَنْ أَبِی شُعْبَۃَ ، قَالَ : کُنْتُ بِجَنْبِ ابْنِ عُمَرَ بِعَرَفَۃَ وَإِنَّ رُکْبَتَیَّ لَتَمَسُّ رُکْبَتَہُ ، أَوْ فَخِذِی تَمَسُّ فَخِذَہُ ، فَمَا سَمِعْتہ یَزِیدُ عَلَی ہَؤُلائِ الْکَلِمَاتِ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ حَتَّی أَفَاضَ مِنْ عَرَفَۃَ إِلَی جَمْعٍ۔","Da'if","Musannaf Ibn Abi Shaybah 30274","","","كتاب الدعاء"
"30275","(۳۰۲۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ شَترٍ ، قَالَ : قُلْتُ لابْنِ الْحَنَفِیَّۃِ : مَا خَیْرُ مَا نَقُولُ فِی حَجِّنَا ، قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ۔","","Musannaf Ibn Abi Shaybah 30275","","","كتاب الدعاء"
"30276","(۳۰۲۷۶) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَن رَجُلٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ مِثْلُہُ۔","","Musannaf Ibn Abi Shaybah 30276","","","كتاب الدعاء"
"30277","(۳۰۲۷۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن سَعِیدِ بْنِ السَّائِبِ ، عَن دَاوُد بْنِ أَبِی عَاصِمٍ ، قَالَ : وَقَفْت مَعَ سَالِمِ بْنِ عَبْدِ اللہِ بِعَرَفَۃَ أَنْظُرُ کَیْفَ یَصْنَعُ ، فَکَانَ فِی الذِّکْرِ وَالدُّعَائِ حَتَّی أَفَاضَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30277","","","كتاب الدعاء"
"30278","(۳۰۲۷۸) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مَنْصُورٍ ، عَن ہِلالٍ ، عَنْ أَبِی شُعْبَۃَ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ حَوْلَ الْبَیْتِ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ۔","Da'if","Musannaf Ibn Abi Shaybah 30278","","","كتاب الدعاء"
"30279","(۳۰۲۷۹) حَدَّثَنَا وَکِیعٌ ، عَن أُسَامَۃَ بْنِ زَیْدٍ ، عَنِ ابْنِ أَبِی لَبِیبَۃَ ، عَنْ سَعْدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَیْرُ الذِّکْرِ الْخَفِیُّ۔ (احمد ۱۷۲)","Da'if","Musannaf Ibn Abi Shaybah 30279","","","كتاب الدعاء"
"30280","(۳۰۲۸۰) حَدَّثَنَا أَبُو دَاوُدَ ، عَن ہِشَامٍ ، عَن یَحْیَی ، عَن رَجُلٍ ، عَنْ عَائِشَۃَ قَالَتْ : الذِّکْرُ الْخَفِیُّ الَّذِی لاَ یَکْتُبُہُ الْحَفَظَۃُ یُضَاعَفُ عَلَی مَا سِوَاہُ مِنَ الذِّکْرِ سَبْعِینَ ضِعْفًا۔","Da'if","Musannaf Ibn Abi Shaybah 30280","","","كتاب الدعاء"
"30281","(۳۰۲۸۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، عَنْ أَبِی مُوسَی ، قَالَ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ فَجَعَلَ النَّاسَ یَجْہَرُونَ بِالتَّکْبِیرِ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ارْبَعُوا عَلَی أَنْفُسِکُمْ فَإِنَّکُمْ لیس تَدْعُونَ أَصَمَّ ، وَلا غَائِبًا ، إنَّکُمْ تَدْعُونَہُ سَمِیعًا قَرِیبًا وَہُوَ مَعَکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 30281","","","كتاب الدعاء"
"30282","(۳۰۲۸۲) حَدَّثَنَا عَلِیُّ بْنُ ہَاشم ، عَنِ ابْنِ أَبِی لَیْلَی ، عَن صَدَقَۃَ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ : إنَّ الْمُصَلِّیَ إذا صلی یُنَاجِی رَبَّہُ فَلْیَعْلَمْ بِمَا یُنَاجِیہِ ، وَلا یَجْہَرْ بَعْضُکُمْ عَلَی بَعْضٍ۔","Da'if","Musannaf Ibn Abi Shaybah 30282","","","كتاب الدعاء"
"30283","(۳۰۲۸۳) حَدَّثَنَا وَکِیعٌ ، عَن عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أَیُّہَا النَّاسُ إنَّکُمْ لاَ تَدْعُونَ أَصَمَّ ، وَلا غَائِبًا یَعْنِی فِی رَفْعِ الصَّوْتِ فِی الدُّعَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 30283","","","كتاب الدعاء"
"30284","(۳۰۲۸۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ نسیب ، قَالَ : صَلَّیْت إِلَی جَنْبِ سَعِیدِ بْنِ الْمُسَیَّبِ ، فَلَمَّا جَلَسْت فِی الرَّکْعَۃِ الثَّانِیَۃِ رَفَعْت صَوْتِی بِالدُّعَائِ فَانْتَہَرَنِی ، فَلَمَّا انْصَرَفَت قُلْتُ لَہُ : مَا کَرِہْت مِنِّی ؟ قَالَ: ظَنَنْت أَنَّ اللَّہَ لَیْسَ بِقَرِیبٍ مِنْک۔","","Musannaf Ibn Abi Shaybah 30284","","","كتاب الدعاء"
"30285","(۳۰۲۸۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ ، عَن مُجَاہِدٍ ، أَنَّہُ سَمِعَ رَجُلاً یَرْفَعُ صَوْتَہُ فِی الدُّعَائِ فَرَمَاہُ بِالْحَصَی۔","No Data Available","Musannaf Ibn Abi Shaybah 30285","","","كتاب الدعاء"
"30286","(۳۰۲۸۶) حَدَّثَنَا وَکِیعٌ ، عَن رَبِیعٍ ، عَن یَزِیدَ بْنِ أَبَانَ ، عَنْ أَنَسٍ ، وَعَنْ رَبِیعٍ ، عَنِ الْحَسَنِ أَنَّہُمَا کَرِہَا أَنْ یُسْمِعَ الرَّجُلُ جَلِیسَہُ شَیْئًا مِنَ الدُّعَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 30286","","","كتاب الدعاء"
"30287","(۳۰۲۸۷) حَدَّثَنَا وَکِیعٌ ، عَن مُبَارَکٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانُوا یَجْتَہِدُونَ فِی الدُّعَائِ ، وَلا تَسْمَعُ إِلاَّ ہَمْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 30287","","","كتاب الدعاء"
"30288","(۳۰۲۸۸) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ مُعَاوِیَۃَ ، عَنِ ابْنِ أَبِی ذُبَابٍ ، عَن سَہْلِ بْنِ سَعْدٍ قَالَ : مَا رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شَاہِرًا یَدَہُ فِی الدُّعَائِ عَلَی مِنْبَرٍ ، وَلا غَیْرِہِ ، وَلَقَدْ رَأَیْت یَدَیْہِ حَذْوَ مَنْکِبَیْہِ یَدْعُو۔","Da'if","Musannaf Ibn Abi Shaybah 30288","","","كتاب الدعاء"
"30289","(۳۰۲۸۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَن سَعِیدٍ ، عَن قَتَادَۃَ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ لاَ یَرْفَعُ یَدَیْہِ فِی شَیْئٍ مِنَ الدُّعَائِ إِلاَّ فِی الاسْتِسْقَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 30289","","","كتاب الدعاء"
"30290","(۳۰۲۹۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَن تَمِیمِ بْنِ طَرَفَۃَ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : خَرَجَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَا لِی أَرَاکُمْ رَافِعِی أَیْدِیکُمْ کَأَنَّہَا أَذْنَابُ خَیْلٍ شُمْسٍ ، اسْکُنُوا فِی الصَّلاۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 30290","","","كتاب الدعاء"
"30291","(۳۰۲۹۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَن سُلَیمَانَ بْنِ عَمْرِو بْنِ الأَحْوَصِ ، قَالَ : أَخْبَرَنَا أَبُو ہِلالٍ ، عَنْ أَبِی بَرَزَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَعَا عَلَی رَجُلَیْنِ فَرَفَعَ یَدَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30291","","","كتاب الدعاء"
"30292","(۳۰۲۹۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَن حَیَّانَ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَمُرَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَفَعَ یَدَیْہِ حیث صَلَّی فِی الْکُسُوفِ۔","Sahih","Musannaf Ibn Abi Shaybah 30292","","","كتاب الدعاء"
"30293","(۳۰۲۹۳) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَن حُمَیْدٍ ، قَالَ : سُئِلَ أَنَسٌ : ہَلْ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَرْفَعُ یَدَیْہِ یَعْنِی فِی الدُّعَائِ فَقَالَ : نَعَمْ ، شَکَا النَّاسُ إلَیْہِ ذَاتَ جُمُعَۃٍ فَقَالُوا : یَا رَسُولَ اللہِ ، قَحَطَ الْمَطَرُ وَأَجْدَبَتِ الأَرْضُ وَہَلَکَ الْمَالُ ،قال: فَرَفَعَ یَدَیْہِ حَتَّی رَأَیْت بَیَاضَ إبْطَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30293","","","كتاب الدعاء"
"30294","(۳۰۲۹۴) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ حَدَّثَنَا شُعْبَۃُ ، عَن ثَابِتٍ ، عَنْ أَنَسٍ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَرْفَعُ یَدَیْہِ فِی الدُّعَائِ حَتَّی یُرَی بَیَاضُ إبْطَیْہِ۔ (مسلم ۶۱۲۔ طیالسی ۲۰۴۷)","Sahih","Musannaf Ibn Abi Shaybah 30294","","","كتاب الدعاء"
"30295","(۳۰۲۹۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَن وَائِلِ بْنِ حُجْرٍ ، قَالَ : رَأَیْتُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَضَعَ حَدَّ مِرْفَقِہِ الأَیْمَنِ عَلَی فَخِذِہِ الْیُمْنَی وَحَلَّقَ بِالإِبْہَامِ وَالْوُسْطَی وَرَفَعَ الَّتِی تَلِی الإِبْہَامَ یَدْعُو بِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 30295","","","كتاب الدعاء"
"30296","(۳۰۲۹۶) حَدَّثَنَا وَکِیعٌ ، عَن عِصَامِ بْنِ قُدَامَۃَ ، عَن مَالِکِ بْنِ نُمَیْرٍ الْخُزَاعِیِّ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَالِسًا فِی الصَّلاۃِ وَاضِعًا یَدَہُ الْیُمْنَی عَلَی فَخِذِہِ یشیر بِإِصْبَعِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30296","","","كتاب الدعاء"
"30297","(۳۰۲۹۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ، عَنِ ابْنِ عَجْلاَنَ، عَنْ عَامِرِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ، عَنْ أَبِیہِ، قَالَ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، إِذَا قَعَدَ یَدْعُو ، وَضَعَ یَدَہُ الْیُمْنَی عَلَی فَخِذِہِ الْیُمْنَی ، وَیَدَہُ الْیُسْرَی عَلَی فَخِذِہِ الْیُسْرَی، وَأَشَارَ بِإِصْبَعِہِ السَّبَّابَۃِ، وَوَضَعَ إِبْہَامَہُ عَلَی إِصْبَعِہِ الْوُسْطَی، وَیُلْقِمُ کَفَّہُ الْیُسْرَی رُکْبَتَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30297","","","كتاب الدعاء"
"30298","(۳۰۲۹۸) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَن رَاشِدٍ أَبِی سَعْدٍ ، عَن سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا جَلَسَ فِی الصَّلاۃِ وَضَعَ یَدَہُ عَلَی فَخِذِہِ وَیُشِیرُ بِإِصْبَعِہِ فِی الدُّعَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 30298","","","كتاب الدعاء"
"30299","(۳۰۲۹۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أَبْصَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَعْدًا وَہُوَ یَدْعُو بِأَصَابِعِہِ فَقَالَ : یَا سَعْدُ ، أَحِّدْ أَحِّدْ۔","Sahih","Musannaf Ibn Abi Shaybah 30299","","","كتاب الدعاء"
"30300","(۳۰۳۰۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ التَّمِیمِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ہُوَ الإِخْلاصُ یَعْنِی الدُّعَائَ بِإِصْبَعٍ۔","Da'if","Musannaf Ibn Abi Shaybah 30300","","","كتاب الدعاء"
"30301","(۳۰۳۰۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَن مُحَمَّدِ عن کَثِیرِ بْنِ أَفْلَحَ ، قَالَ : صَلَّیْت ، قَالَ : فَلَمَّا کَانَ فِی آخِرِ الْقَعْدَۃِ قُلْتُ ہَکَذَا وأَشَارَ ابْنُ عُلَیَّۃَ بِإِصْبَعَیْہِ فَقَبَضَ ابْنُ عُمَرَ ہَذِہِ یَعْنِی الْیُسْرَی۔","Sahih","Musannaf Ibn Abi Shaybah 30301","","","كتاب الدعاء"
"30302","(۳۰۳۰۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یُشِیرُ بِإِصْبَعِہِ فِی الصَّلاۃِ۔","","Musannaf Ibn Abi Shaybah 30302","","","كتاب الدعاء"
"30303","(۳۰۳۰۳) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ أَبِی عَلْقَمَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : إنَّ اللَّہَ وِتْرٌ یُحِبُّ الْوِتْرَ أَنْ یُدْعَا ہَکَذَا وَأَشَارَتْ بِإِصْبَعٍ وَاحِدَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 30303","","","كتاب الدعاء"
"30304","(۳۰۳۰۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَن ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّہُ رَأَی رَجُلاً یَدْعُو بِإِصْبَعَیْہِ کِلَیْہِمَا فَنَہَاہُ ، وَقَالَ : بِإِصْبَعٍ وَاحِدٍ بِالْیُمْنَی۔","Sahih","Musannaf Ibn Abi Shaybah 30304","","","كتاب الدعاء"
"30305","(۳۰۳۰۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلانَ ، عَن سُلَیْمَانَ بْنِ أَبِی یَحْیَی ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْخُذُ بَعْضُہُمْ عَلَی بَعْضٍ یَعْنِی الإِشَارَۃَ بِإِصْبَعٍ فِی الدُّعَائِ۔","Hasan","Musannaf Ibn Abi Shaybah 30305","","","كتاب الدعاء"
"30306","(۳۰۳۰۶) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنِ ابْنِ الزُّبَیْرِ ، قَالَ : إنَّکُمْ لَتَدْعُونَ ، أَفْضَلُ الدُّعَائِ ہَکَذَا وَأَشَارَ بِإِصْبَعِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30306","","","كتاب الدعاء"
"30307","(۳۰۳۰۷) حَدَّثَنَا وَکِیعٌ، عَن مِسْعَرٍ، عن معبد بن خالد عن قیس بن سعد قَالَ: کان لاَ یزاد ہَکَذَا وَأَشَارَ بِإِصْبَعِہِ۔","","Musannaf Ibn Abi Shaybah 30307","","","كتاب الدعاء"
"30308","(۳۰۳۰۸) حَدَّثَنَا جَرِیرٌ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَشَارَ الرَّجُلُ بِإِصْبَعِہِ فِی الصَّلاۃِ ، فَہُوَ حَسَنٌ وَہُوَ التَّوْحِیدُ ، وَلَکِنْ لاَ یُشِیرُ بِإِصْبَعَیْہِ فَإِنَّہُ یُکْرَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30308","","","كتاب الدعاء"
"30309","(۳۰۳۰۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَن طَلْحَۃَ ، عَن خَیْثَمَۃَ ، أَنَّہُ کَانَ یعقد ثَلاثًا وَخَمْسِینَ ، وَیُشِیرُ بِإِصْبَعِہِ۔","","Musannaf Ibn Abi Shaybah 30309","","","كتاب الدعاء"
"30310","(۳۰۳۱۰) حَدَّثَنَا حَفص بْنُ غِیَاثٍ ، عَن عُثْمَانَ بْنِ الأَسْوَدِ ، عَن مُجَاہِدٍ ، أَنَّہُ قَالَ : الدُّعَائُ ہَکَذَا وَأَشَارَ بِإِصْبَعٍ وَاحِدَۃٍ مَقْمَعَۃٌ لِلشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 30310","","","كتاب الدعاء"
"30311","(۳۰۳۱۱) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا إذَا رَأَوْا إنْسَانًا یَدْعُو بِإِصْبَعَیْہِ ضَرَبُوا إحْدَاہُمَا ، وَقَالُوا : إنَّمَا ہُوَ إلَہٌ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 30311","","","كتاب الدعاء"
"30312","(۳۰۳۱۲) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إسْرَائِیلَ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَن رَجُلٍ مِنَ الأَنْصَارِ حَدَّثَہُ ، عَنْ جَدِّہِ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ عَلَیْہِ وَہُوَ یَدْعُو بِیَدَیْہِ فَقَالَ: أَحِّدْ فَإِنَّہُ أَحَدٌ۔ (مسند ۶۶۹)","Da'if","Musannaf Ibn Abi Shaybah 30312","","","كتاب الدعاء"
"30313","(۳۰۳۱۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، أَنَّ أَبَاہُ کَانَ یُشِیرُ بِإِصْبَعِہِ فِی الدُّعَائِ ، وَلا یُحَرِّکُہَا۔","","Musannaf Ibn Abi Shaybah 30313","","","كتاب الدعاء"
"30314","حدثنا بقی بن مخلد ، قَالَ : حدثنا أبو بکر ، قَالَ :n(۳۰۳۱۴) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ قَالَ : لاَ تَقُومُوا تَدْعُونَ کَمَا تَصْنَعُ الْیَہُودُ فِی کَنَائِسِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 30314","","","كتاب الدعاء"
"30315","(۳۰۳۱۵) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنِ ابْنِ الأَصْبَہَانِیِّ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، أَنَّہُ رَأَی رَجُلاً یَدْعُو قَائِمًا بَعْدَ مَا انْصَرَفَ فَسَبَّہُ ، أَوْ شَتَمَہُ۔","","Musannaf Ibn Abi Shaybah 30315","","","كتاب الدعاء"
"30316","(۳۰۳۱۶) حَدَّثَنَا وَکِیعٌ، عَن مِسْعَرٍ ، عَنِ الْحَکَمِ ، عَنْ عَبْدَۃَ بْنِ أَبِی لُبَابَۃَ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ، أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 30316","","","كتاب الدعاء"
"30317","(۳۰۳۱۷) حَدَّثَنَا أَبُو مُعَاوِیَۃُ ، عَن حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ ، قَالَ : ثِنْتَانِ بِدْعَۃٌ : أَنْ یَقُومَ الرَّجُلُ بَعْدَ مَا یَفْرُغُ مِنْ صَلاتِہِ مُسْتَقْبِلَ الْقِبْلَۃِ یَدْعُو ، وَأَنْ یَسْجُدَ السَّجْدَۃَ الثَّانِیَۃَ فَیَرَی أَنَّ حَقًّا عَلَیْہِ أَنْ یَلْزَقَ أَلْیَتَیْہِ بِالأَرْضِ قَبْلَ أَنْ یَنْہَضَ۔","","Musannaf Ibn Abi Shaybah 30317","","","كتاب الدعاء"
"30318","(۳۰۳۱۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ ، أَنَّہُ کَرِہَ الْقِیَامَ بَعْدَہَا تَشَبُّہًا بِالْیَہُودِ۔","","Musannaf Ibn Abi Shaybah 30318","","","كتاب الدعاء"
"30319","(۳۰۳۱۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَن جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، عَنْ عَبْدِ اللہِ ، أَنَّہُ بَلَغَہُ ، أَنَّ قَوْمًا یَذْکُرُونَ اللَّہَ قِیَامًا ، قَالَ : فَأَتَاہُمْ فَقَالَ : مَا ہَذَہ النُّکْراء ۔","Da'if","Musannaf Ibn Abi Shaybah 30319","","","كتاب الدعاء"
"30320","(۳۰۳۲۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ جَمِیلِ بْنِ زَیْدٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ دَخَلَ الْبَیْتَ وَصَلَّی رَکْعَتَیْنِ ، ثُمَّ خَرَجْت وَتَرَکْتہ قَائِمًا یَدْعُو وَیُکَبِّرُ۔","Da'if","Musannaf Ibn Abi Shaybah 30320","","","كتاب الدعاء"
"30321","(۳۰۳۲۱) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، قَالَ : قُلْتُ لِمُغِیرَۃَ : کَانَ إبْرَاہِیمُ یَکْرَہُ إذَا انْصَرَفَ أَنْ یَقُومَ مُسْتَقْبِلَ الْقِبْلَۃِ یَرْفَعُ یَدَیْہِ ؟ قَالَ : نَعَمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 30321","","","كتاب الدعاء"
"30322","(۳۰۳۲۲) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ، عَنْ أَشْعَثَ، قَالَ: رَأَیْتُ الْحَسَنَ یَرْفَعُ بَصَرَہُ إِلَی السَّمَائِ فِی الصَّلاۃِ یَدْعُو وَہُوَ قَائِمٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 30322","","","كتاب الدعاء"
"30323","(۳۰۳۲۳) حَدَّثَنَا شَرِیکُ بْنُ عَبْدِ اللہِ ، عَنْ أَبِی إِسْحَاقَ ، عَن بُرَیْدِ بْنِ أَبِی مَرْیَمَ ، عْن أَبِی الْحَوْرَائِ ، عَنِ الْحَسَنِ بْنِ عَلِیٍّ قَالَ : عَلَّمَنِی جَدِّی کَلِمَاتٍ أَقُولُہُنَّ فِی قُنُوتِ الْوِتْرِ : اللَّہُمَّ اہْدِنِی فِیمَنْ ہَدَیْت ، وَعَافِنِی فِیمَنْ عَافَیْت ، وَتَوَلَّنِی فِیمَنْ تَوَلَّیْت ، وَقِنِی شَرَّ مَا قَضَیْت ، وَبَارِکْ لِی فِیمَا أَعْطَیْت ، إنَّک تَقْضِی ، وَلا یُقْضَی عَلَیْک ، فَإِنَّہُ لاَ یَذِلُّ مَنْ وَالَیْت ، تَبَارَکْت وَتَعَالَیْت۔","Hasan","Musannaf Ibn Abi Shaybah 30323","","","كتاب الدعاء"
"30324","(۳۰۳۲۴) حَدَّثَنَا وَکِیعٌ ، عَن حَسَنِ بْنِ صَالِحٍ ، عَن مَنْصُورٍ ، عَن شَیْخٍ یُکَنَّی أَبَا مُحَمَّدٍ ، أَنَ الْحُسَیْنَ بْنَ عَلِیٍّ کَانَ یَقُولُ فِی قُنُوتِ الْوِتْرِ : اللَّہُمَّ إنَّک تَرَی ، وَلا تُرَی ، وَأَنْتَ بِالْمَنْظَرِ الأَعْلَی ، وَإِنَّ إلَیْک الرُّجْعَی ، وَإِنَّ لَکَ الآخِرَۃَ وَالأُولَی ، اللَّہُمَّ إنَّا نَعُوذُ بِکَ أَنْ نَذِلَّ وَنَخْزَی۔","Da'if","Musannaf Ibn Abi Shaybah 30324","","","كتاب الدعاء"
"30325","(۳۰۳۲۵) حَدَّثَنَا وَکِیعٌ ، عَن ہَارُونَ بْنِ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ یَقُولُ فِی قُنُوتِ الْوِتْرِ : لَکَ الْحَمْدُ مِلْئَ السَّمَاوَاتِ السَّبْعِ ، وَمِلْئَ الأَرَضِینَ السَّبْعِ ، وَمِلْئَ مَا بَیْنَہُمَا مِنْ شَیْئٍ بَعْدُ ، أَہْلُ الثَّنَائِ وَالْمَجْدِ أَحَقُّ مَا قَالَ الْعَبْدُ ، کُلُّنَا لَکَ عَبْدٌ : لاَ مَانِعَ لِمَا أَعْطَیْت ، وَلا مُعْطِیَ لِمَا مَنَعْت ، وَلا یَنْفَعُ ذَا الْجَدِّ مِنْک الْجَدُّ۔","Sahih","Musannaf Ibn Abi Shaybah 30325","","","كتاب الدعاء"
"30326","(۳۰۳۲۶) حَدَّثَنَا محمد بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : عَلَّمَنَا ابْنُ مَسْعُودٍ أَنْ نَقُولَ فِی الْقُنُوتِ یَعْنِی فِی الْوِتْرِ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنَسْتَغْفِرُک وَنُثْنِی عَلَیْک الخیر، وَلا نَکْفُرُک وَنَخْلَعُ وَنَتْرُکُ مَنْ یَفْجُرُکَ اللَّہُمَّ إیَّاکَ نَعْبُدُ وَلَک نُصَلِّی وَنَسْجُدُ وَإِلَیْک نَسْعَی وَنَحْفِدُ وَنَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَک إنَّ عَذَابَکَ بِالْکُفَّارِ مُلْحَقٌ۔","Da'if","Musannaf Ibn Abi Shaybah 30326","","","كتاب الدعاء"
"30327","(۳۰۳۲۷) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ، قَالَ : قلْ فِی قُنُوتِ الْوِتْرِ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنَسْتَغْفِرُک۔","","Musannaf Ibn Abi Shaybah 30327","","","كتاب الدعاء"
"30328","(۳۰۳۲۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ قَالَ : لَیْسَ فِی قُنُوتِ الْوِتْرِ شَیْئٌ مُوَقَّتٌ ، إنَّمَا ہُوَ دُعَائٌ وَاسْتِغْفَارٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 30328","","","كتاب الدعاء"
"30329","(۳۰۳۲۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ، عَنْ عَلِیٍّ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ فِی آخِرِ وِتْرِہِ: اللَّہُمَّ إنِّی أَعُوذُ بِرِضَاک مِنْ سَخَطِکَ، وَأَعُوذُ بِمُعَافَاتِکَ مِنْ عُقُوبَتِکَ ، وَأَعُوذُ بِکَ مِنْک ، لاَ أُحْصِی ثَنَائً علَیْک أَنْتَ کَمَا أَثْنَیْت عَلَی نَفْسِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 30329","","","كتاب الدعاء"
"30330","(۳۰۳۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زُبَیْدٍ ، عَنْ ذَرٍّ ، عَن سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أبیہ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُوتِرُ ویقول فِی آخِرِ صَلاتِہِ إذَا جَلَسَ : سُبْحَانَ الْمَلِکِ الْقُدُّوسِ ثَلاثًا ، یَمُدُّ بِہَا صَوْتَہُ فِی الآخِرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 30330","","","كتاب الدعاء"
"30331","(۳۰۳۳۱) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عُبَیْدَۃَ ، قَالَ : حدَّثَنَا أَبِی ، عَنِ الأَعْمَشِ ، عَن طَلْحَۃَ ، عَن ذَرٍّ ، عَن سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ ، عَن أُبَیِّ بْنِ کَعْبٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ فِی آخِرِ صَلاتِہِ : سُبْحَانَ الْمَلِکِ الْقُدُّوسِ ثَلاثًا۔","Sahih","Musannaf Ibn Abi Shaybah 30331","","","كتاب الدعاء"
"30332","(۳۰۳۳۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ابْنُ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَن عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : صَلَّیْت خَلْفَ عُمَرَ بْنِ الْخَطَّابِ الْغَدَاۃَ فَقَالَ فِی قُنُوتِہِ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنَسْتَغْفِرُک وَنُثْنِی عَلَیْک الْخَیْرَ ، وَلا نَکْفُرُک ، وَنَخْلَعُ وَنَتْرُکُ مِنْ یَفْجُرُکَ ، اللَّہُمَّ إیَّاکَ نَعْبُدُ وَلَک نُصَلِّی وَنَسْجُدُ ، وَإِلَیْک نَسْعَی وَنَحْفِدُ ، وَنَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَک ، إنَّ عَذَابَک بِالْکَافِرِینَ مُلْحَقٌ۔","Da'if","Musannaf Ibn Abi Shaybah 30332","","","كتاب الدعاء"
"30333","(۳۰۳۳۳) حَدَّثَنَا ہُشَیْمٌ ، أَخْبَرَنَا حُصَیْنٌ ، عَن ذَرٍّ ، عَن سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ قَالَ : إِنَّہُ کَانَ صَلَّی خَلْفَ عُمَرَ فَصَنَعَ مِثْلَ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 30333","","","كتاب الدعاء"
"30334","(۳۰۳۳۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، قَالَ : صَلَّیْت الْغَدَاۃَ ذَاتَ یَوْمٍ وَصَلَّی خَلْفِی عُثْمَانُ بْنُ زِیَادٍ ، قَالَ : فَقَنَتُّ فِی صَلاۃِ الصُّبْحِ ، قَالَ : فَلَمَّا قَضَیْت صَلاتِی ، قَالَ لِی : مَا قُلْتَ فِی قُنُوتِکَ ؟ فَقُلْتُ : ذَکَرْت ہَؤُلائِ الْکَلِمَاتِ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنَسْتَغْفِرُک وَنُثْنِی عَلَیْک الْخَیْرَ ، وَلا نَکْفُرُک ، وَنَخْلَعُ وَنَتْرُکُ مَنْ یَفْجُرُکَ ، اللَّہُمَّ إیَّاکَ نَعْبُدُ وَلَک نُصَلِّی وَنَسْجُدُ ، وَإِلَیْک نَسْعَی وَنَحْفِدُ ، وَنَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَک الجد ، إنَّ عَذَابَک بِالْکَافِرِینَ مُلْحَقٌ ، قَالَ : قَالَ لِی عُثْمَانُ : کَذَا کَانَ یَصْنَعُ عُمَرُ بْنُ الْخَطَّابِ وَعُثْمَانُ بْنُ عَفَّانَ۔","","Musannaf Ibn Abi Shaybah 30334","","","كتاب الدعاء"
"30335","(۳۰۳۳۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سُوَیْد الْکَاہِلِیِّ ، أَنَّ عَلِیًّا قَنَتَ فِی الْفَجْرِ بِہَاتَیْنِ السُّورَتَیْنِ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنَسْتَغْفِرُک وَنُثْنِی عَلَیْک الْخَیْرَ ، وَلا نَکْفُرُک ، وَنَخْلَعُ وَنَتْرُکُ مَنْ یَفْجُرُکَ ، اللَّہُمَّ إیَّاکَ نَعْبُدُ ، وَلَک نُصَلِّی وَنَسْجُدُ وَإِلَیْک نَسْعَی وَنَحْفِدُ وَنَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَک ، إنَّ عَذَابَک بِالْکَافِرِینَ مُلْحَقٌ۔","Da'if","Musannaf Ibn Abi Shaybah 30335","","","كتاب الدعاء"
"30336","(۳۰۳۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ ، عَن مَیْمُونِ بْنِ مِہْرَانَ ، قَالَ فِی قِرَائَ ۃِ أُبَیِّ بْنِ کَعْبٍ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنَسْتَغْفِرُک وَنُثْنِی عَلَیْک الْخَیْرَ ، وَلا نَکْفُرُک ، وَنَخْلَعُ وَنَتْرُکُ مَنْ یَفْجُرُکَ ، اللَّہُمَّ إیَّاکَ نَعْبُدُ، وَلَک نُصَلِّی وَنَسْجُدُ ، وَإِلَیْک نَسْعَی وَنَحْفِدُ ، وَنَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَک إنَّ عَذَابَک بِالْکَافِرِینَ مُلْحِقٌ۔","","Musannaf Ibn Abi Shaybah 30336","","","كتاب الدعاء"
"30337","(۳۰۳۳۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَن عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : سَمِعْتُ عُمَرَ یَقْنُتُ فِی الْفَجْرِ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنُؤْمِنُ بِکَ وَنَتَوَکَّلُ عَلَیْک وَنُثْنِی عَلَیْک الْخَیْرَ ، وَلا نَکْفُرُک ، اللَّہُمَّ إیَّاکَ نَعْبُدُ وَلَک نُصَلِّی وَنَسْجُدُ وَإِلَیْک نَسْعَی وَنَحْفِدُ ، نَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَک ، إنَّ عَذَابَک بِالْکَافِرِینَ مُلْحَقٌ ، اللَّہُمَّ عَذِّبْ کَفَرَۃَ أَہْلِ الْکِتَابِ الَّذِینَ یَصُدُّونَ عَن سَبِیلِک۔","","Musannaf Ibn Abi Shaybah 30337","","","كتاب الدعاء"
"30338","(۳۰۳۳۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلانَ ، عَن عُمَرَ بْنِ کَثِیرِ بْنِ أَفْلَحَ عَنِ ابْنِ عُمَرَ فِی الضَّالَّۃِ یَتَوَضَّأُ وَیُصَلِّی رَکْعَتَیْنِ وَیَتَشَہَّدُ وَیَقُولُ : بِسْمِ اللہِ یَا ہَادِیَ الضَّالِّ ، وَرَادَّ الضَّالَّۃِ ارْدُدْ عَلَیَّ ضَالَّتِی بِعِزَّتِکَ وَسُلْطَانِکَ فَإِنَّہَا مِنْ عَطَائِکَ وَفَضْلِک۔","Hasan","Musannaf Ibn Abi Shaybah 30338","","","كتاب الدعاء"
"30339","(۳۰۳۳۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن أُسَامَۃَ ، عَنْ أَبَانَ بْنِ صَالِحٍ ، عَن مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إنَّ لِلَّہِ مَلائِکَۃً فَضْلاً سِوَی خَلْقِہِ یَکْتُبُونَ وَرَقِ الشَّجَرِ ، فَإِذَا أَصَابَتْ أَحَدَکُمْ عَرْجَۃٌ فِی سَفَرٍ فَلِیُنَادِ : أَعِینُوا عِبَادَ اللہِ رَحِمَکُمُ اللَّہُ۔ (بزار ۳۱۲۸)","Hasan","Musannaf Ibn Abi Shaybah 30339","","","كتاب الدعاء"
"30340","(۳۰۳۴۰) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَلَی ذِرْوَۃِ کُلِّ بَعِیرٍ شَیْطَانٌ فَإِذَا رَکِبْتُمُوہَا فَقُولُوا کَمَا أَمَرَکُمُ اللَّہُ {سُبْحَانَ اللہِ الَّذِی سَخَّرَ لَنَا ہَذَا وَمَا کُنَّا لَہُ مُقْرِنِینَ} وَامْتَہِنُوہَا لأَنْفُسِکُمْ فَإِنَّمَا یَحْمِلُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 30340","","","كتاب الدعاء"
"30341","(۳۰۳۴۱) حَدَّثَنَا وَکِیعٌ ، عَن أُسَامَۃَ بْنِ زَیْدٍ ، عَن مُحَمَّدِ بْنِ حَمْزَۃَ بن عَمْرٍو ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ عَلَی ذِرْوَۃِ کُلِّ بَعِیرٍ شَیْطَانٌ ، فَإِذَا رَکِبْتُموہا فَامْتَہِنُوہَا ، وَاذْکُرُوا اسْمَ اللہِ ، ثم لاَ تقصروا عن حوائجکم۔ (احمد ۴۹۴۔ دارمی ۲۶۶۷)","Hasan","Musannaf Ibn Abi Shaybah 30341","","","كتاب الدعاء"
"30342","(۳۰۳۴۲) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَن حبیب، عَن عبد الرحمن بن أبی عمرۃ قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِن عَلَی ذِرْوَۃِ کُلِّ بَعِیرٍ شَیْطَانًا ، فَإِذَا رَکِبْتُمْ فَاذْکُرُوا اسْمَ اللہِ وَامْتَہِنُوہَا فَإِنَّمَا یَحْمِلُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 30342","","","كتاب الدعاء"
"30343","(۳۰۳۴۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَن سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ أَبِی مِجْلَزٍ ، أَنَّ حُسَیْنَ بْنَ عَلِیٍّ رَأَی رَجُلاً رَکِبَ دَابَّۃً فَقَالَ : {سُبْحَانَ الَّذِی سَخَّرَ لَنَا ہَذَا وَمَا کُنَّا لَہُ مُقْرِنِینَ} ، قَالَ أَفَبِہَذَا أُمِرْت ، قَالَ : کَیْفَ أَقُولُ ؟ قَالَ : الْحَمْدُ لِلَّہِ الَّذِی ہَدَانِی لِلإِسْلامِ الْحَمْدُ لِلَّہِ الَّذِی مَنَّ عَلَیَّ بِمُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، الْحَمْدُ لِلَّہِ الَّذِی جَعَلَنِی فِی خَیْرِ أُمَّۃٍ أُخْرِجَتْ لِلنَّاسِ ، ثُمَّ تَقُولُ: {سُبْحَانَ الَّذِی سَخَّرَ لَنَا ہذا}۔","Sahih","Musannaf Ibn Abi Shaybah 30343","","","كتاب الدعاء"
"30344","(۳۰۳۴۴) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن زُبَیْدٍ ، عَن مُرَّۃَ قَالَ : قَالَ عَبْدُ اللہِ : مَنْ جَبُنَ مِنْکُمْ عَنِ الْعَدُوِّ أَنْ یُجَاہِدَہُ ، وَاللَّیْلِ أَنْ یُکَابِدَہُ وَضَنَّ بِالْمَالِ أَنْ یُنْفِقَہُ فَلْیُکْثِرْ مِنْ سُبْحَانَ اللہِ ، وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ۔","Sahih","Musannaf Ibn Abi Shaybah 30344","","","كتاب الدعاء"
"30345","(۳۰۳۴۵) حَدَّثَنَا شَبَابَۃُ ، عَن شُعْبَۃَ ، عَنْ أَبِی التَّیَّاحِ ، عَن مُوَرِّقٍ الْعِجْلِیّ ، عَن عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : إِنْ عَجَزْتُمْ عَنِ اللَّیْلِ أَنْ تُکَابِدُوہُ ، وَعَنِ الْعَدُوِّ أَنْ تُجَاہِدُوہُ ، وَعَنِ الْمَالِ أَنْ تُنْفِقُوہُ ، فَأَکْثِرُوا مِنْ سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ فَإِنَّہُنَّ أَحَبُّ إلَیَّ مِنْ جَبَلَیْ ذَہَبٍ وَفِضَّۃٍ۔","","Musannaf Ibn Abi Shaybah 30345","","","كتاب الدعاء"
"30346","(۳۰۳۴۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الْعَوَّامِ ، أَنَّہُ سَمِعَ إبْرَاہِیمَ التَّیْمِیَّ یَقُولُ : إذَا قَالَ : الْحَمْدُ لِلَّہِ وَسُبْحَانَ اللہِ قَالَتِ الْمَلائِکَۃُ وَبِحَمْدِہِ ، فَإذَا قَالَ : سُبْحَانَ اللہِ وَبِحَمْدِہِ ، قَالَتِ الْمَلائِکَۃُ : رَحِمَکَ اللَّہُ ، فَإذَا قَالَ : اللَّہُ أَکْبَرُ ، قَالَتِ الْمَلائِکَۃُ کَبِیرًا ، فَإذَا قَالَ : اللَّہُ أَکْبَرُ کَبِیرًا ، قَالَتِ الْمَلائِکَۃُ : رَحِمَک اللَّہُ ، فَإذَا قَالَ : الْحَمْدُ لِلَّہِ ، قَالَتِ الْمَلائِکَۃُ : رَبِّ الْعَالَمِینَ ، وَإذَا قَالَ : رَبِّ الْعَالَمِینَ ، قَالَتِ الْمَلائِکَۃُ : رَحِمَک اللَّہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30346","","","كتاب الدعاء"
"30347","(۳۰۳۴۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ الْجُعْفِیُّ ، عَنْ إسْرَائِیلَ ، عَن زِیَادٍ الْمصفِّر ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَبِی بَکْرٍ : أَلا أَدُلُّک عَلَی صَدَقَۃٍ تَمْلأ مَا بَیْنَ السَّمَائِ وَالأَرْضِ : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ ، وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ فِی یَوْمٍ ثَلاثِینَ مَرَّۃً۔","Hasan","Musannaf Ibn Abi Shaybah 30347","","","كتاب الدعاء"
"30348","(۳۰۳۴۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلانَ ، عَنْ عَبْدِ الْجَلِیلِ ، عَن خَالِدِ بْنِ أَبِی عِمْرَانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خُذُوا جُنَّتَکُمْ ، قَالُوا : یَا رَسُولَ اللہِ ، مِنْ عَدُوٍّ حَضَرَ ؟ قَالَ : لاَ بَلْ مِنَ النَّارِ ، قُلْنَا : مَا جُنَّتُنَا مِنَ النَّارِ ، قَالَ : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ ، وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ ، فَإِنَّہُنَّ یَأْتِینَ یَوْمَ الْقِیَامَۃِ مُقَدِّمَاتٍ وَمُعَقِّبَاتٍ وَمُجَنِّبَاتٍ ، وَہُنَّ {الْبَاقِیَاتُ الصَّالِحَاتُ}۔n(نسائی ۱۰۶۸۴۔ حاکم ۵۴۱)","","Musannaf Ibn Abi Shaybah 30348","","","كتاب الدعاء"
"30349","(۳۰۳۴۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن وقاء ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : رَأَی عُمَرُ بْنُ الْخَطَّابِ إنْسَانًا یُسَبِّحُ بِتَسَابِیحَ معہ ، فَقَالَ عُمَرُ : رحمہ اللہ إنَّمَا یُجْزِیہِ مِنْ ذَلِکَ أَنْ یَقُولَ : سُبْحَانَ اللہِ مِلْئَ السَّمَاوَاتِ وَمِلْئَ الأَرْضِ وَمِلْئَ مَا شَائَ مِنْ شَیْئٍ بَعْدُ ، وَیَقُولَ : الْحَمْدُ للہِ مِلْئَ السَّمَاوَاتِ وَمِلْئَ الأَرْضِ وَمِلْئَ مَا شَائَ مِنْ شَیْئٍ بَعْدُ ، وَیَقُولُ : اللَّہُ أَکْبَرُ مِلْئَ السَّمَاوَاتِ وَمِلْئَ الأَرْضِ وَمِلْئَ مَا شَائَ مِنْ شَیْئٍ بَعْدُ۔","","Musannaf Ibn Abi Shaybah 30349","","","كتاب الدعاء"
"30350","(۳۰۳۵۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، قَالَ : اجْتَمَعَ ابْنُ مَسْعُودٍ ، وَعَبْدُ اللہِ بْنُ عَمْرٍو ، قَالَ ابْنُ مَسْعُودٍ : لأَنْ أَقُول إذَا خَرَجْت حَتَّی أَبْلُغُ حَاجَتِی سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ أَحَبُّ إلَیَّ مِنْ أَنْ أَحْمِلَ عَلَی عَدَدِہِنَّ مِنَ الْجِیَادِ فِی سَبِیلِ اللہِ ، وَقَالَ عَبْدُ اللہِ بْنُ عَمْرٍو : لأَنْ أَقُولَہُنَّ أَحَبُّ إلَیَّ مِنْ أَنْ أُنْفِقَ عَدَدَہُنَّ دَنَانِیرَ فِی سَبِیلِ اللہِ عَزَّ وَجَلَّ۔","","Musannaf Ibn Abi Shaybah 30350","","","كتاب الدعاء"
"30351","(۳۰۳۵۱) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَن مَنْصُورٍ ، عَن سَالِمٍ ، عَن کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ أَنَّ أَحَدَکُمْ إذَا أَرَادَ أَنْ یَأْتِیَ أَہْلَہُ ، قَالَ : بِسْمِ اللہِ اللَّہُمَّ جَنِّبْنَا الشَّیْطَانَ وَجَنِّبَ الشَّیْطَانَ مَا رَزَقْتَنَا ، فَإِنَّہُ إِنْ یُقَدَّرْ بَیْنَہُمَا وَلَدٌ فِی ذَلِکَ لَمْ یَضُرَّہُ شَیْطَانٌ أَبَدًا۔","Sahih","Musannaf Ibn Abi Shaybah 30351","","","كتاب الدعاء"
"30352","(۳۰۳۵۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَن دَاوُد ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ مَوْلَی أَبِی أسَیْدَ : تَزَوَّجْت وَأَنَا مَمْلُوکٌ فَدَعَوْت نَفَرًا مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ منہم أبو مَسْعُودٍ ، وَأَبُو ذَرٍّ وَحُذَیْفَۃُ یُعَلِّمُونَنِی ، فَقَالَ : إذَا دَخَلَ عَلَیْک أَہْلُک فَصَلِّ رَکْعَتَیْنِ ، ثُمَّ سَلِ اللَّہَ مِنْ خَیْرِ مَا دَخَلَ عَلَیْک ، ثُمَّ تَعَوَّذْ بِہِ مِنْ شَرِّہِ ، ثُمَّ شَأْنُکَ وَشَأْنُ أَہْلِک۔","Da'if","Musannaf Ibn Abi Shaybah 30352","","","كتاب الدعاء"
"30353","(۳۰۳۵۳) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ ابْنِ أَخِی عَلْقَمَۃَ بْنِ قَیْسٍ ، عَنْ عَلْقَمَۃَ ، أَنَّ ابْنَ مَسْعُودٍ کَانَ إذَا غَشِیَ أَہْلَہُ فَأَنْزَلَ ، قَالَ : اللَّہُمَّ لاَ تَجْعَلْ لِلشَّیْطَانِ فِیمَا رَزَقْتَنِی نَصِیبًا۔","Da'if","Musannaf Ibn Abi Shaybah 30353","","","كتاب الدعاء"
"30354","(۳۰۳۵۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَن بَکْرٍ ، قَالَ : کَانَ یُقَالُ : إنَّ سَتْرَ مَا بَیْنَ عَوْرَاتِ بَنِی آدَمَ وَبَیْنَ أَعْیُنِ الْجِنِّ وَالشَّیَاطِینِ أَنْ یَقُولَ أَحَدُکُمْ إذَا وَضَعَ ثِیَابَہُ بِسْمِ اللہِ۔ (ترمذی ۶۰۶)","","Musannaf Ibn Abi Shaybah 30354","","","كتاب الدعاء"
"30355","(۳۰۳۵۵) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ الْقَہْرَمَانِیِّ ، عَن سَالِمِ بْنِ عَبْدِ اللہِ بْنِ عُمَرَ ، عَنْ أَبِیہِ ، قَالَ : مَا مِنْ رَجُلٍ یَرَی مُبْتَلًی فَیَقُولُ : الْحَمْدُ لِلَّہِ الَّذِی عَافَانِی مِمَّا ابْتَلاک بِہِ وَفَضَّلَنِی عَلَیْک ، وَعَلَی کَثِیرٍ مِنْ خَلْقِہِ تَفْضِیلاً إِلاَّ عَافَاہُ اللَّہُ مِنْ ذَلِکَ الْبَلائِ کَائِنًا مَا کَانَ۔ (ترمذی ۳۴۳۱۔ ابن ماجہ ۳۸۹۲)","Da'if","Musannaf Ibn Abi Shaybah 30355","","","كتاب الدعاء"
"30356","(۳۰۳۵۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : لَمَّا بُعِثَ مُوسَی إِلَی فِرْعَوْنَ ، قَالَ : رَبِّ أَیَّ شَیْئٍ أَقُولُ ؟ قَالَ : قُلْ : ہَیَّا شَرًّا ہَیَّا ، قَالَ الأَعْمَشُ : تَفْسِیرُ ذَلِکَ : الْحَیُّ قَبْلَ کُلِّ شَیْئٍ ، وَالْحَیُّ بَعْدَ کُلِّ شَیْئٍ۔","","Musannaf Ibn Abi Shaybah 30356","","","كتاب الدعاء"
"30357","(۳۰۳۵۷) حَدَّثَنَا وَکِیعٌ ، عَنِ أبی العمیس ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ عُتْبَۃَ ، عَنِ ابْنِ حُذَیْفَۃَ ، عَنْ أَبِیہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا دَعَا لِرَجُلٍ أَصَابَتْہُ وَأَصَابَتْ وَلَدَہُ وَوَلَدَ وَلَدِہِ۔ (احمد ۳۸۵)","Da'if","Musannaf Ibn Abi Shaybah 30357","","","كتاب الدعاء"
"30358","(۳۰۳۵۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إنَّ الرَّجُلَ لَیُرْفَعُ بِدُعَائِ وَلَدِہِ مِنْ بَعْدِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30358","","","كتاب الدعاء"
"30359","(۳۰۳۵۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَاصِمِ بْنِ بَہْدَلَۃَ عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ الرَّجُلَ لَتُرْفَعُ لَہُ الدَّرَجَۃُ فِی الْجَنَّۃِ فَیَقُولُ : یَا رَبِّ أَنَّی لِی ہَذِہِ ؟ فَیُقَالُ : بِاسْتِغْفَارِ وَلَدِک۔ (احمد ۵۰۹)","Sahih","Musannaf Ibn Abi Shaybah 30359","","","كتاب الدعاء"
"30360","(۳۰۳۶۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن ہِشَامِ بْنِ حَسَّانَ ، عَنِ الْحَسَنِ ، عَنْ جَابِرِ بْنِ عبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا تَغَوَّلَتْ لکُمَ الْغِیلانُ فَنَادُوا بِالأَذَانِ۔ (نسائی ۱۰۷۹۱)","Hasan","Musannaf Ibn Abi Shaybah 30360","","","كتاب الدعاء"
"30361","(۳۰۳۶۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الشَّیْبَانِیِّ ، عَن یُسَیْرِ بْنِ عَمْرٍو ، قَالَ : ذُکِرَتِ الْغِیلانُ عِنْدَ عُمَر رحمہ اللہ فَقَالَ : إِنَّہُ لَیْسَ مِنْ شَیْئٍ یَسْتَطِیعُ أن یتغیر عَن خَلْقِ اللہِ خَلْقَہُ ، وَلَکِنْ لَہُمْ سَحَرَۃٌ کَسَحَرَتِکُمْ ، فَإِذَا رَأَیْتُمْ مِنْ ذَلِکَ شَیْئًا فَأَذِّنُوا۔","Sahih","Musannaf Ibn Abi Shaybah 30361","","","كتاب الدعاء"
"30362","(۳۰۳۶۲) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ عن سفیان ، عَنِ ابْنِ أَبِی لَیْلَی عَنْ أَخِیہِ عِیسَی بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ أَبِی أَیُّوبَ ، أَنَّہُ کَانَ فِی سَہْوَۃٍ لَہُ فَکَانَتِ الْغُولُ تَجِیئُ ، فَشَکَاہَا إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : إذَا رَأَیْتہَا فَقُلْ : بِسْمِ اللہِ أَجِیبِی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: فَجَائَتْہُ فَقَالَ : لَہَا فَأَخَذَہَا فَقَالَتْ لَہُ : إنِّی لاَ أَعُودُ ، فَأَرْسَلِہَا ، فَجَائَ فَقَالَ لَہُ : النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا فَعَلَ أَسِیرُک ؟ فَقَالَ : أَخَذْتہَا فَقَالَتْ : إنِّی لاَ أَعُودُ ، فَأَرْسَلْتہَا ، فَقَالَ : إِنَّہَا عَائِدَۃٌ ، فَأَخَذْتہَا مَرَّتَیْنِ، أَوْ ثَلاثًا کُلَّ ذَلِکَ تَقُولُ: لاَ أَعُودُ، وَیَجِیئُ إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَیَقُولُ: مَا فَعَلَ أَسِیرُک؟ فَیَقُولُ : أَخَذْتہَا فَتَقُولُ : لاَ أَعُودُ ، فَیَقُولُ : إِنَّہَا عَائِدَۃٌ فَأَخَذْتہَا فَقَالَتْ : أَرْسِلْنِی وَأُعَلِّمُک شَیْئًا تَقُولُہُ لاَ یَقْرَبُک شَیْئٌ، آیَۃَ الْکُرْسِی، فَأَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرَہُ فَقَالَ: صَدَقَتْ وَہِیَ کَذُوبٌ۔ (ترمذی ۲۸۸۰۔ احمد ۴۲۳)","Da'if","Musannaf Ibn Abi Shaybah 30362","","","كتاب الدعاء"
"30363","(۳۰۳۶۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ عُمَرَ ، قَالَ : حدَّثَنِی مَنْ لاَ أَتَّہِمُ مِنْ أَہْلِ الشَّامِ ، عَن عُبَادَۃَ بْنِ الصَّامِتِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا رَأَی الْہِلالَ ، قَالَ : اللَّہُ أَکْبَرُ اللَّہُ أَکْبَرُ الْحَمْدُ لِلَّہِ لاَ حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ ، اللَّہُمَّ إنِّی أَسْأَلُک خَیْرَ ہَذَا الشَّہْرِ وَأَعُوذُ بِکَ مِنْ شَرِّ الْقَدَرِ وَأَعُوذُ بِکَ مِنْ شَرِّ یَوْمِ الْحَشْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 30363","","","كتاب الدعاء"
"30364","(۳۰۳۶۴) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، قَالَ : انْصَرَفْت مَعَ سَعِیدِ بْنِ الْمُسَیَّبِ فَقُلْنَا: ہَذَا الْہِلالُ یَا أَبَا مُحَمَّدٍ ، فَلَمَّا أَبْصَرَہُ ، قَالَ : آمَنْت بِالَّذِی خَلَقَک فَسَوَّاک فَعَدَلَک ، ثُمَّ الْتَفَتَ إلَیَّ فَقَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا رَأَی الْہِلالَ ، قَالَ ہَکَذَا۔","","Musannaf Ibn Abi Shaybah 30364","","","كتاب الدعاء"
"30365","(۳۰۳۶۵) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبِیدَۃَ ، عَنْ عَلِیٍّ رضی اللہ عنہ ، قَالَ : إذَا رَأَی أَحَدُکُمَ الْہِلالَ فَلا یَرْفَعْ بِہِ رَأْسًا إنما یَکْفِی أَحَدَکُمْ أَنْ یَقُولَ : رَبِّی وَرَبُّک اللَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30365","","","كتاب الدعاء"
"30366","(۳۰۳۶۶) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، أَنَّ عَلِیًّا کَانَ یَقُولُ إذَا رَأَی الْہِلالَ : اللَّہُمَّ ارْزُقْنَا خَیْرَہُ وَنَصْرَہُ وَبَرَکَتَہُ وَنُورَہُ وَنَعُوذُ بِکَ مِنْ شَرِّہِ وَشَرِّ مَا بَعْدَہُ۔","","Musannaf Ibn Abi Shaybah 30366","","","كتاب الدعاء"
"30367","(۳۰۳۶۷) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، قَالَ : حدَّثَنَا حُجَّاجُ بْنُ دِینَارٍ ، عَن مَنْصُورٍ ، عَن مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَرِہَ أَنْ یَنْتَصِبَ لِلْہِلالِ وَلَکِنْ یَعْتَرِضُ فَیَقُولُ : اللَّہُ أَکْبَرُ الْحَمْدُ لِلَّہِ الَّذِی ذَہَبَ بِہِلالِ کَذَا وَکَذَا ، وَجَائَ بِہِلالِ کَذَا وَکَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 30367","","","كتاب الدعاء"
"30368","(۳۰۳۶۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَن قَتَادَۃَ ، أَنَّ نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا رَأَی الْہِلالَ ، قَالَ : ہِلالُ خَیْرٍ وَرُشْدٍ ، ہِلالُ رُشْدٍ وَخَیْرٍ ، ہِلالُ خَیْرٍ وَرُشْدٍ ، آمَنْت بِالَّذِی خَلَقَک ثَلاثًا ، الْحَمْدُ لِلَّہِ ذَہَبَ بہِلالِ کَذَا وَکَذَا ، وَجَائَ بِہِلالِ کَذَا وَکَذَا۔","Da'if","Musannaf Ibn Abi Shaybah 30368","","","كتاب الدعاء"
"30369","(۳۰۳۶۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، قَالَ : سَأَلْتُ ہِشَامَ بْنَ حَسَّانَ : أَیُّ شَیْئٍ کَانَ الْحَسَنَ یَقُولُ إذَا رَأَی الْہِلالَ ؟ قَالَ : کَانَ یَقُولُ : اللَّہُمَّ اجْعَلْہُ شَہْرَ بَرَکَۃٍ وَنُورٍ وَأَجْرٍ وَمُعَافَاۃٍ اللَّہُمَّ إنَّک قَاسِمٌ بَیْنَ عِبَادٍ مِنْ عِبَادِکَ فِیہِ خَیْرًا فَاقْسِمْ لَنَا فِیہِ مِنْ خَیْرِ مَا تَقْسِمُ لِعِبَادِکَ الصَّالِحِینَ۔","","Musannaf Ibn Abi Shaybah 30369","","","كتاب الدعاء"
"30370","(۳۰۳۷۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، قَالَ : سَأَلْتُ ابْنَ جُرَیْجٍ فَذَکَرَ عَنْ عَطَائٍ ، أَنَّ رَجُلاً أَہَلَّ ہِلالاً بِفَلاۃٍ مِنَ الأَرْضِ ، قَالَ : فَسَمِعَ قَائِلاً یَقُولُ : اللَّہُمَّ أَہِلَّہُ عَلَیْنَا بِالأَمْنِ وَالإِیمَانِ وَالسَّلامَۃِ وَالإِسْلامِ وَالْہُدَی وَالْمَغْفِرَۃِ وَالتَّوْفِیقِ لِمَا تَرْضَی وَالْحِفْظِ مِمَّا تَسْخَطُ ، رَبِّی وَرَبُّک اللَّہُ ، قَالَ : فَلَمْ یُتِمَّہُنَّ حَتَّی حَفِظْتہنَّ وَلَمْ أَرَ أَحَدًا۔","","Musannaf Ibn Abi Shaybah 30370","","","كتاب الدعاء"
"30371","(۳۰۳۷۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُعْجِبُہُمْ إذَا رَأَی الرَّجُلُ الْہِلالَ أَنْ یَقُولَ : رَبِّی وَرَبُّک اللَّہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30371","","","كتاب الدعاء"
"30372","(۳۰۳۷۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا أَصَبْغُ بْنُ زَیْدٍ حَدَّثَنَا أَبُو الْعَلائِ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : لَبِسَ عُمَرُ بْنُ الْخَطَّابِ ثَوْبًا جَدِیدًا فَقَالَ : الْحَمْدُ لِلَّہِ الَّذِی کَسَانِی مَا أُوَارِی بِہِ عَوْرَتِی وَأَتَجَمَّلُ بِہِ فِی حَیَاتِی ثُمَّ قَالَ سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ لَبِسَ ثَوْبًا جَدِیدًا فَقَالَ : الْحَمْدُ لِلَّہِ الَّذِی کَسَانِی مَا أُوَارِی بِہِ عَوْرَتِی وَأَتَجَمَّلُ بِہِ فِی حَیَاتِی ، ثُمَّ عَمَدَ إِلَی الثَّوْبِ الَّذِی أَخْلَقَ ، أَوْ قَالَ : أَلْقَی ، فَتَصَدَّقَ بِہِ کَانَ فِی کَنَفِ اللہِ وَفِی حِفْظِ اللہِ وَفِی سِتْرِ اللہِ حَیًّا وَمَیِّتًا قَالَہَا ثَلاثًا۔","Da'if","Musannaf Ibn Abi Shaybah 30372","","","كتاب الدعاء"
"30373","(۳۰۳۷۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَخِیہِ عِیسَی ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا لَبِسَ أَحَدُکُمْ ثَوْبًا جَدِیدًا فَلْیَقُلْ : الْحَمْدُ لِلَّہِ الَّذِی کَسَانِی مَا أُوَارِی بِہِ عَوْرَتِی وَأَتَجَمَّلُ بِہِ فِی النَّاسِ۔","Da'if","Musannaf Ibn Abi Shaybah 30373","","","كتاب الدعاء"
"30374","(۳۰۳۷۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِی الأَشْہَبِ ، عَن رَجُلٍ مِنْ مُزَیْنَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی عَلَی عُمَرَ ثَوْبًا غَسِیلاً فَقَالَ : أجَدِیدٌ ثَوْبُک ہَذَا ؟ قَالَ : غَسِیلٌ یَا رَسُولَ اللہِ ، قَالَ : فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْبَسْ جَدِیدًا وَعِشْ حَمِیدًا وَتَوَفَّ شَہِیدًا یُعْطِکَ اللَّہُ قُرَّۃَ عَیْنٍ فِی الدُّنْیَا وَالآخِرَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 30374","","","كتاب الدعاء"
"30375","(۳۰۳۷۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی وَہْبٍ ، عَن مَنْصُورٍ عَن سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ : إذَا لَبِسَ الإِنْسَاْن الثَّوْبَ الْجَدِیدَ فَقَالَ : اللَّہُمَّ اجْعَلْہَا ثِیَابًا مُبَارَکَۃً نَشْکُرُ فِیہَا نِعْمَتَکَ ، وَنُحْسِنُ فِیہَا عِبَادَتَکَ ، وَنَعْمَلُ فِیہَا بِطَاعَتِکَ ، لَمْ تُجَاوِزْ تَرْقُوَتَہُ حَتَّی یَغْفِرَ لَہُ۔","","Musannaf Ibn Abi Shaybah 30375","","","كتاب الدعاء"
"30376","(۳۰۳۷۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا مِسْعَرٌ ، قَالَ : حدَّثَنَا عَوْنُ بْنُ عَبْدِ اللہِ ، قَالَ : لَبِسَ رَجُلٌ ثَوْبًا جَدِیدًا فَحَمِدَ اللَّہَ ، فَأُدْخِلَ الْجَنَّۃَ ، أَوْ غُفِرَ لَہُ ، قَالَ : فَقَالَ لَہُ رَجُلٌ : أَرْجِعُ إِلَی أَہْلِی حَتَّی أَلْبَسَ ثَوْبًا جَدِیدًا وَأَحْمَدُ اللَّہَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 30376","","","كتاب الدعاء"
"30377","(۳۰۳۷۷) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، قَالَ : کَانَ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا رَأَوْا عَلَی أَحَدِہِمَ الثَّوْبَ الْجَدِیدَ قَالُوا : تُبْلِی وَیُخْلِفُ اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30377","","","كتاب الدعاء"
"30378","(۳۰۳۷۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا الْجُرَیْرِیُّ ، عَنْ أَبِی نَضْرَۃَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا لَبِسَ ثَوْبًا جَدِیدًا سَمَّاہُ بِاسْمِہِ إِنْ کَانَ قَمِیصًا ، أَوْ إزَارًا ، أَوْ عِمَامَۃً یَقُولُ اللَّہُمَّ لَکَ الْحَمْدُ أَنْتَ کَسَوْتنِی ہَذَا ، أَسْأَلُک مِنْ خَیْرِہِ وَخَیْرِ مَا صُنِعَ لَہُ وَأَعُوذُ بِکَ مِنْ شَرِّہِ وَشَرِّ مَا صُنِعَ لَہُ۔","","Musannaf Ibn Abi Shaybah 30378","","","كتاب الدعاء"
"30379","(۳۰۳۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ??ِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ فِی قَوْلِہِ : (وَلا تَجْہَرْ بِصَلاتِکَ وَلا تُخَافِتْ بِہَا) قَالَتْ : الدُّعَائُ۔","Sahih","Musannaf Ibn Abi Shaybah 30379","","","كتاب الدعاء"
"30380","(۳۰۳۸۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن عُبَیْدٍ الْمُکْتِبِ ، عَنْ إبْرَاہِیمَ وَعَنْ سُفْیَانَ ، عَن سِمَاکِ بْنِ عُبَیْدٍ ، عَنْ عَطَائٍ ، قَالَ : الدُّعَائُ۔","","Musannaf Ibn Abi Shaybah 30380","","","كتاب الدعاء"
"30381","(۳۰۳۸۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ الْہَجَرِیِّ ، عَنْ أَبِی عِیَاضٍ ، قَالَ : الدُّعَائُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30381","","","كتاب الدعاء"
"30382","(۳۰۳۸۲) حَدَّثَنَا بَکْرُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : حدَّثَنَا عِیسَی بْنُ الْمُخْتَارِ ، عَن مُحَمَّدٍ ، عَنِ الْحَکَمِ ، عَن مُجَاہِدٍ فِی ہَذِہِ الآیَۃِ : {وَلا تَجْہَرْ بِصَلاتِکَ وَلا تُخَافِتْ بِہَا} قَالَ : ذَلِکَ فِی الدُّعَائِ وَالْمَسْأَلَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30382","","","كتاب الدعاء"
"30383","(۳۰۳۸۳) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، وَأَبُو مُعَاوِیَۃَ ، عَن لَیْثٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَسَنِ ، عَن أُمِّہِ ، عَن فَاطِمَۃَ بِنْتِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا دَخَلَ الْمَسْجِدَ یَقُولُ : بِسْمِ اللہِ وَعَلَی سُنَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اللَّہُمَّ اغْفِرْ لِی ذُنُوبِی وَافْتَحْ لِی أَبْوَابَ رَحْمَتِکَ ، وَإِذَا خَرَجَ ، قَالَ : بِسْمِ اللہِ وَالسَّلامُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، اللَّہُمَّ اغْفِرْ لِی ذُنُوبِی ، وَافْتَحْ لِی أَبْوَابَ فَضْلِک۔","Da'if","Musannaf Ibn Abi Shaybah 30383","","","كتاب الدعاء"
"30384","(۳۰۳۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، عَنْ أَبِی ہِنْدٍ ، عَنْ عَمْرِو بْنِ عَمْرٍو الْمَدَنِیِّ ، عَنِ الْمُطَّلِبِ بْنِ عَبْدِ اللہِ بْنِ حَنْطَبٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا دَخَلَ الْمَسْجِدَ ، قَالَ : اللَّہُمَّ افْتَحْ لِی أَبْوَابَ رَحْمَتِکَ وَیَسِّرْ لِی أَبْوَابَ رِزْقِک۔","","Musannaf Ibn Abi Shaybah 30384","","","كتاب الدعاء"
"30385","(۳۰۳۸۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ النُّعْمَانِ بْنِ سَعْدٍ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ إذَا دَخَلَ الْمَسْجِدَ ، قَالَ : اللَّہُمَّ اغْفِرْ لِی ذُنُوبِی وَافْتَحْ لِی أَبْوَابَ رَحْمَتِکَ ، وَإِذَا خَرَجَ ، قَالَ : اللَّہُمَّ اغْفِرْ لِی ذُنُوبِی وَافْتَحْ لِی أَبْوَابَ فَضْلِک۔","Da'if","Musannaf Ibn Abi Shaybah 30385","","","كتاب الدعاء"
"30386","(۳۰۳۸۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلانَ ، عَن سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ لِی کَعْبُ بْنُ عُجْرَۃَ : إذَا دَخَلْت الْمَسْجِدَ الْحَرَامَ فَسَلِّمْ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقُلِ : اللَّہُمَّ افْتَحْ لِی أَبْوَابَ رَحْمَتِکَ ، وَإِذَا خَرَجْت فَسَلِّمْ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقُلِ : اللَّہُمَّ احْفَظْنِی مِنَ الشَّیْطَانِ الرَّجِیمِ۔","","Musannaf Ibn Abi Shaybah 30386","","","كتاب الدعاء"
"30387","(۳۰۳۸۷) حَدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَن یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَن مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ عَبْدَ اللہِ بْنَ سَلامٍ کَانَ إذَا دَخَلَ الْمَسْجِدَ سَلَّمَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقَالَ : اللَّہُمَّ افْتَحْ لِی أَبْوَابَ رَحْمَتِکَ ، وَإِذَا خَرَجَ سَلَّمَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَتَعَوَّذَ مِنَ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 30387","","","كتاب الدعاء"
"30388","(۳۰۳۸۸) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَن سَعِیدِ بْنِ ذِی حُدَّانِ ، عَنْ عَلْقَمَۃَ ، أَنَّہُ کَانَ إذَا دَخَلَ الْمَسْجِدَ ، قَالَ : سَلامٌ عَلَیْک أَیُّہَا النَّبِیُّ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ ، صَلَّی اللَّہُ وَمَلائِکَتُہُ عَلَی مُحَمَّدٍ۔","","Musannaf Ibn Abi Shaybah 30388","","","كتاب الدعاء"
"30389","(۳۰۳۸۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ کَانَ إذَا دَخَلَ الْمَسْجِدَ ، قَالَ : بِسْمِ اللہِ وَالسَّلامُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 30389","","","كتاب الدعاء"
"30390","(۳۰۳۹۰) حَدَّثَنَا حَبِیبُ بْنُ أَبِی حَبِیبٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَکَمِ ، قَالَ : مَنْ سَمِعَ الْمُنَادِیَ یُنَادِی بِإِقَامَۃِ الصَّلاۃِ فَقَالَ : اللَّہُمَّ رَبَّ ہَذِہِ الدَّعْوَۃِ التَّامَّۃِ وَالصَّلاۃِ الْقَائِمَۃِ أَعْطِ مُحَمَّدًا سُؤْلَہُ یَوْمَ الْقِیَامَۃِ إِلاَّ کَانَ مِمَّنْ یَشْفَعُ لَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30390","","","كتاب الدعاء"
"30391","(۳۰۳۹۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی حَمْزَۃَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا سَمِعْت الْمُؤَذِّنَ ، قَالَ قَدْ قَامَتِ الصَّلاۃُ فَقُلِ : اللَّہُمَّ رَبَّ ہَذِہِ الدَّعْوَۃِ التَّامَّۃِ وَالصَّلاۃِ الْقَائِمَۃِ أَعْطِ مُحَمَّدًا صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُؤْلَہُ یَوْمَ الْقِیَامَۃِ لاَ یَقُولُہَا رَجُلٌ حِینَ یَقُومُ الْمُؤَذِّنُ إِلاَّ أَدْخَلَہُ اللَّہُ فِی شَفَاعَۃِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 30391","","","كتاب الدعاء"
"30392","(۳۰۳۹۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن سَعِیدٍ ، عَن قَتَادَۃَ ، أَنَّ عُثْمَانَ کَانَ إذَا سَمِعَ الْمُؤَذِّنَ ، قَالَ قَدْ قَامَتِ الصَّلاۃُ ، قَالَ : مَرْحَبًا بِالْقَائِلِینَ عَدْلاً وَبِالصَّلاۃِ مَرْحَبًا وَأَہْلاً ، ثُمَّ یَنْہَضُ إِلَی الصَّلاۃِ۔","","Musannaf Ibn Abi Shaybah 30392","","","كتاب الدعاء"
"30393","(۳۰۳۹۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ عَمَّنْ أَخْبَرَہُ ، عَن مُجَاہِدٍ ، أَنَّہُ کَانَ إذَا قَالَ الْمُؤَذِّنُ حَیَّ عَلَی الصَّلاۃِ ، قَالَ : الْمُسْتَعَانُ اللہ ، فَإذَا قَالَ : حَیَّ عَلَی الْفَلاحِ ، قَالَ : لاَ حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30393","","","كتاب الدعاء"
"30394","(۳۰۳۹۴) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، عَن عُبَیْدِ اللہ بنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ أَبِیہِ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ مِثْلَ مَا یَقُولُ الْمُؤَذِّنُ ، فَإذَا قَالَ حَیَّ عَلَی الصَّلاۃِ حَیَّ عَلَی الْفَلاحِ ، قَالَ : لاَ حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30394","","","كتاب الدعاء"
"30395","(۳۰۳۹۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنَا مُعَاوِیَۃُ بْنُ صَالِحٍ ، قَالَ : حَدَّثَنِی حَبِیبُ بْنُ عُبَیْدٍ الْکَلاعِیُّ ، عَن جُبَیْرِ بْنِ نُفَیْرٍ الْحَضْرَمِیِّ ، عَنْ عَوْفِ بْنِ مَالِکٍ الأَشْجَعِیِّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ عَلَی الْمَیِّتِ : اللَّہُمَّ اغْفِرْ لَہُ وَارْحَمْہُ وَعَافِہِ وَاعْفُ عَنْہُ وَأَکْرِمْ نُزُلَہُ وَأَوْسِعْ مُدْخَلَہُ وَاغْسِلْہُ بِالْمَائِ وَالثَّلْجِ وَالْبَرَدِ ، وَنَقِّہِ مِنَ الْخَطَایَا کَمَا یُنَقَّی الثَّوْبُ الأَبْیَضَ مِنَ الدَّنَسِ ، اللَّہُمَّ أَبْدِلْہُ دَارًا خَیْرًا مِنْ دَارِہِ ، وَزَوْجًا خَیْرًا مِنْ زَوْجِہِ ، وَأَہْلاً خَیْرًا مِنْ أَہْلِہِ وَأَدْخِلْہُ الْجَنَّۃَ ، وَنَجِّہِ مِنَ النَّارِ ، أَوْ قَالَ : وَقِہ عَذَابَ النَّارِ ، حَتَّی تَمَنَّیْت أَنْ أَکُونَ أَنَا ہُوَ۔","Sahih","Musannaf Ibn Abi Shaybah 30395","","","كتاب الدعاء"
"30396","(۳۰۳۹۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتوَائِیُّ ، عَن یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی إبْرَاہِیمَ الأَنْصَارِیِّ ، عَنْ أَبِیہِ ، أَنَّہُ سَمِعَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یقول فِی الصَّلاۃِ عَلَی الْمَیِّتِ : اللَّہُمَّ اغْفِرْ لِحَیِّنَا وَمَیِّتِنَا وَشَاہِدِنَا وَغَائِبِنَا وَذَکَرِنَا وَأُنْثَانَا وَصَغِیرِنَا وَکَبِیرِنَا۔","Da'if","Musannaf Ibn Abi Shaybah 30396","","","كتاب الدعاء"
"30397","(۳۰۳۹۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن شُعْبَۃَ ، عَنِ الْجُلاسِ ، عَن عُثْمَانَ بْنِ شَمَّاسٍ ، قَالَ : کُنَّا عِنْدَ أَبِی ہُرَیْرَۃَ فَمَرَّ بِہِ مَرْوَانُ فَقَالَ لہ : بَعْضَ حَدِیثَکَ عَن رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ مَضَی ، ثُمَّ رَجَعَ فَقُلْنَا : الآنَ یَقَعُ بِہِ ، فَقَالَ : کَیْفَ سمعت رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی عَلَی الْجَِنَازَۃِ ؟ ، قَالَ : سَمِعْتُہُ یَقُولُ أَنْتَ ہَدَیْتہَا لِلإِسْلامِ وَأَنْتَ قَبَضْت رُوحَہَا ، تَعْلَمُ سِرَّہَا وَعَلانِیَتَہَا ، جِئْنَاک شُفَعَائَ فَاغْفِرْ لَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 30397","","","كتاب الدعاء"
"30398","(۳۰۳۹۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَن رَجُلٍ مِنْ أَہْلِ مَکَّۃَ ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ فِی الصَّلاۃِ عَلَی الْجِنَازَۃِ : اللَّہُمَّ اغْفِرْ لِحَیِّنَا وَمَیِّتِنَا وَذَکَرِنَا وَأُنْثَانَا وَشَاہِدِنَا وَغَائِبِنَا وَصَغِیرِنَا وَکَبِیرِنَا اللَّہُمَّ مَنْ أَحْیَیْتہ مِنَّا فَأَحْیِہِ عَلَی الإِسْلامِ ، وَمَنْ تَوَفَّیْتہ مِنَّا فَتَوَفَّہُ عَلَی الإِسْلامِ۔","Da'if","Musannaf Ibn Abi Shaybah 30398","","","كتاب الدعاء"
"30399","(۳۰۳۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن حُصَیْنٍ ، عَنْ أَبِی مَالِکٍ ، قَالَ : کَانَ أَبُو بَکْرٍ إذَا صَلَّی عَلَی الْمَیِّتِ ، قَالَ : اللَّہُمَّ عَبْدُک أَسْلَمَہُ الأَہْلَ وَالْمَالَ وَالْعَشِیرَۃَ ، وَالذَّنْبُ عَظِیمٌ وَأَنْتَ غَفُورٌ رَحِیمٌ۔","","Musannaf Ibn Abi Shaybah 30399","","","كتاب الدعاء"
"30400","(۳۰۴۰۰) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَن طَارِقٍ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ، قَالَ: کَانَ عُمَرُ یَقُولُ فِی الصَّلاۃِ إِنْ کَانَ مسائ، قَالَ : اللَّہُمَّ أَمْسَی عَبْدُک ، وَإِنْ کَانَ صَبَاحًا ، قَالَ : اللَّہُمَّ أَصْبَحَ عَبْدُک قَدْ تَخَلَّی مِنَ الدُّنْیَا وَتَرَکَہَا لأَہْلِہَا وَاسْتَغْنَتْ عَنْہُ وَافْتَقَرَ إلَیْک کَانَ یَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ أَنْتَ وَأَنَّ مُحَمَّدًا عَبْدُک وَرَسُولُک فَاغْفِرْ لہ ذُنُوبَہُ۔","","Musannaf Ibn Abi Shaybah 30400","","","كتاب الدعاء"
"30401","(۳۰۴۰۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن مَنْصُورٍ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی قَالَ : کَانَ عَلِیٌّ یَقُولُ فِی الصَّلاۃِ عَلَی الْمَیِّتِ : اللَّہُمَّ اغْفِرْ لأَحْیَائِنَا وَأَمْوَاتِنَا وَأَلِّفْ بَیْنَ قُلُوبِنَا ، وَأَصْلِحْ ذَاتَ بَیْنِنَا وَاجْعَلْ قُلُوبَنَا عَلَی قُلُوبِ خِیَارِنَا ، اللَّہُمَّ اغْفِرْ لَہُ اللَّہُمَّ ارْحَمْہُ اللَّہُمْ أَرْجِعْہُ إِلَی خَیْرٍ مِمَّا کَانَ فِیہِ ، اللَّہُمَّ عَفْوَک۔","","Musannaf Ibn Abi Shaybah 30401","","","كتاب الدعاء"
"30402","(۳۰۴۰۲) حَدَّثَنَا عَبْدُالْوَہَّابِ الثَّقَفِیُّ، عَن خَالِدٍ، قَالَ: کُنْتُ فِی جَِنَازَۃِ غُنَیْمٍ فَحَدَّثَنِی رَجُلٌ عَنْہُ، أَنَّہُ، قَالَ: سَمِعْتُ أَبَا مُوسَی صَلَّی عَلَی مَیِّتٍ فَکَبَّرَ فَقَالَ : اللَّہُمَّ اغْفِرْ لَہُ کَمَا اسْتَغْفَرَک وَأَعْطِہِ مَا سَأَلَک وَزِدْہُ مِنْ فَضْلِک۔","Da'if","Musannaf Ibn Abi Shaybah 30402","","","كتاب الدعاء"
"30403","(۳۰۴۰۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ بْنُ سَلامٍ الصَّلاۃُ عَلَی الْجِنَازَۃِ أَنْ تَقُولَ : اللَّہُمَّ اغْفِرْ لِحَیِّنَا وَمَیِّتِنَا وَصَغِیرِنَا وَکَبِیرِنَا وَذَکَرِنَا وَأُنْثَانَا وَشَاہِدِنَا وَغَائِبِنَا ، اللَّہُمَّ مَنْ تَوَفَّیْتہ مِنَّا فَتَوَفَّہُ عَلَی الإِیمَانِ ، وَمَنْ أَبْقَیْتہ مِنَّا فَأَبْقِہِ عَلَی الإِسْلامِ۔","Hasan","Musannaf Ibn Abi Shaybah 30403","","","كتاب الدعاء"
"30404","(۳۰۴۰۴) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن زَیْدٍ الْعَمِّیِّ ، عَنْ أَبِی الصِّدِّیقِ النَّاجِی ، قَالَ : سَأَلْتُ أَبَا سَعِیدٍ ، عَنِ الصَّلاۃِ عَلَی الْجِنَازَۃِ ، فقَالَ : کُنَّا نَقُولُ : اللَّہُمَّ رَبَّنَا وَرَبَّہُ خَلَقْتہ وَرَزَقْتہ وَأَحْیَیْتہ وَکَفَیْتہ فَاغْفِرْ لَنَا وَلَہُ ، وَلا تَحْرِمْنَا أَجْرَہُ ، وَلا تُضِلَّنَا بَعْدَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30404","","","كتاب الدعاء"
"30405","(۳۰۴۰۵) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، قَالَ : حَدَّثَنَا خَالِدٌ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنِ ابْنِ عَمْرِو بْنِ غَیْلانَ ، عَنْ أَبِی الدَّرْدَائِ ، أَنَّہُ کَانَ یَقُولُ فِی الصَّلاۃِ عَلَی الْمَیِّتِ : اللَّہُمَّ اغْفِرْ لأَحْیَائِنَا وَأَمْوَاتِنَا الْمُسْلِمِینَ اللَّہُمَّ اغْفِرْ لِلْمُؤْمِنِینَ وَالْمُؤْمِنَاتِ وَالْمُسْلِمِینَ وَالْمُسْلِمَاتِ وَأَصْلِحْ ذَاتَ بَیْنِہِمْ ، وَأَلِّفْ بَیْنَ قُلُوبِہِمْ ، وَاجْعَلْ قُلُوبَہُمْ عَلَی قُلُوبِ أخْیَارِہِمَ اللَّہُمَّ اغْفِرْ لِفُلانِ بْنِ فُلانٍ ذَنْبَہُ ، وَأَلْحِقْہُ بِنَبِیِّہِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، اللَّہُمَّ ارْفَعْ دَرَجَتَہُ فِی الْمُہْتَدِینَ وَاخْلُفْہُ فِی عَقِبِہِ فِی الْغَابِرِینَ ، وَاجْعَلْ کِتَابَہُ فِی عَلِیَّیْنِ، وَاغْفِرْ لَنَا وَلَہُ یَا رَبَّ الْعَالَمِینَ ، اللَّہُمَّ لاَ تَحْرِمْنَا أَجْرَہُ ، وَلا تضِلنا بَعْدَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30405","","","كتاب الدعاء"
"30406","(۳۰۴۰۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ فِی الْجِنَازَۃِ إذَا صَلَّی عَلَیْہِ : اللَّہُمَّ بَارِکْ فِیہِ وَصَلِّ عَلَیْہِ وَاغْفِرْ لَہُ ، وَأَوْرِدْہُ حَوْضَ رَسُولِکَ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ فِی قِیَامٍ کَثِیرٍ وَکَلام کَثِیرٍ لَمْ أَفْہَمْ مِنْہُ غَیْرَ ہَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 30406","","","كتاب الدعاء"
"30407","(۳۰۴۰۷) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ حَرِیزٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی عَوْفٍ ، عَنِ ابْنِ لُحَیٍّ الْہَوْزَنِیِّ ، أَنَّہُ شَہِدَ جِنَازَۃَ شُرَحْبِیلَ بْنِ السِّمْطِ فَقَدِمَ عَلَیْہَا حَبِیبُ بْنُ مَسْلَمَۃَ الْفِہْرِیُّ فَأَقْبَلَ عَلَیْنَا کَالْمُشْرِفِ عَلَیْنَا مِنْ طُولِہِ فَقَالَ : اجْتَہِدُوا لأَخِیکُمْ فِی الدُّعَائِ ، وَلْیَکُنْ مِمَّا تَدْعُونَ لَہُ اللَّہُمَّ اغْفِرْ لِہَذِہِ النَّفْسِ الْحَنَفِیَّۃِ المسلمۃ وَاجْعَلْہَا مِنَ الَّذِینَ تَابُوا وَاتَّبَعُوا سَبِیلَک ، وَقِہَا عَذَابَ الْجَحِیمِ وَاسْتَنْصِرُوا عَلَی عَدُوِّکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 30407","","","كتاب الدعاء"
"30408","(۳۰۴۰۸) حَدَّثَنَا حَفْصٌ ، عَن حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : مَا بَاحَ لَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلا أَبُو بَکْرٍ ، وَلا عُمَرُ فِی الصَّلاۃِ عَلَی الْمَیِّتِ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 30408","","","كتاب الدعاء"
"30409","(۳۰۴۰۹) حَدَّثَنَا حَفْصٌ ، عَن حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَن ثَلاثِینَ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُمْ لَمْ یُقِیمُوا فِی أَمْرِ الصَّلاۃِ عَلَی الْجِنَازَۃِ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 30409","","","كتاب الدعاء"
"30410","(۳۰۴۱۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ لَیْسَ فِی الصَّلاۃِ عَلَی الْمَیِّتِ دُعَائٌ مُؤقَّتٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 30410","","","كتاب الدعاء"
"30411","(۳۰۴۱۱) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَن دَاوُد ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ وَالشَّعْبِیِّ ، قَالا : لَیْسَ عَلَی الْمَیِّتِ دُعَائٌ مُوَقَّتٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 30411","","","كتاب الدعاء"
"30412","(۳۰۴۱۲) حَدَّثَنَا غُنْدَرٌ ، عَن عِمْرَانَ بْنِ حُدَیْرٍ ، قَالَ : سَأَلْتُ مُحَمَّدًا ، عَنِ الصَّلاۃِ عَلَی الْمَیِّتِ فَقَالَ : مَا نَعْلَمُ لَہُ شَیْئًا یُؤقَّت ادْعُ بِأَحْسَنِ مَا تَعْلَمُ۔","","Musannaf Ibn Abi Shaybah 30412","","","كتاب الدعاء"
"30413","(۳۰۴۱۳) حَدَّثَنَا مُعْتَمِرٌ، عَنْ إِسْحَاقَ بْنِ سُوَیْد، عَن بَکْرِ بْنِ عَبْدِاللہِ، قَالَ: لَیْسَ فِی الصَّلاۃِ عَلَی الْمَیِّتِ شَیْئٌ یُؤقَّتٌ۔","","Musannaf Ibn Abi Shaybah 30413","","","كتاب الدعاء"
"30414","(۳۰۴۱۴) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَن مُوسَی الْجُہَنِیِّ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ وَالْحَکَمَ ، وَعَطَائً وَمُجَاہِدًا فِی الصَّلاۃِ عَلَی الْمَیِّتِ شَیْئٌ مُؤقَّتٌ ؟ قَالُوا : لاَ ، إنَّمَا أَنْتَ شَفِیعٌ فَاشْفَعْ بِأَحْسَنِ مَا تَعْلَمُ۔","","Musannaf Ibn Abi Shaybah 30414","","","كتاب الدعاء"
"30415","(۳۰۴۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَن مُغِیثِ بْنِ سُمَیٍّ ، قَالَ : کَانَ رَجُلٌ مِمَّنْ کَانَ قَبْلَکُمْ یَعْمَلُ بالْمَعَاصِیَ فَادَّکَرَ یَوْمًا فَقَالَ : اللَّہُمَّ غُفْرَانَک غُفْرَانَک ، فَغَفَرَ لَہُ۔","","Musannaf Ibn Abi Shaybah 30415","","","كتاب الدعاء"
"30416","(۳۰۴۱۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن حَجَّاجٍ ، عَنْ إبْرَاہِیمَ السَّکْسَکِیِّ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : جَائَ أَعْرَابِیٌّ إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : یَا رَسُولَ اللہِ ، عَلِّمْنِی شَیْئًا یُجْزِینِی مِنَ الْقُرْآنِ فَإِنِّی لاَ أُحْسِنُ شَیْئًا مِنَ الْقُرْآنِ ، فَقَالَ لَہُ رَسُولُ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قُلْ سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ ، وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ ، فَعَدَّہَا الأَعْرَابِیُّ فِی یَدِہِ خَمْسًا ، ثُمَّ وَلَّی ہُنَیْہَۃً ، ثُمَّ رَجَعَ فَقَالَ : یَا رَسُولَ اللہِ، ہَذَا لِرَبِّی فَمَا لِی ؟ قَالَ : قُلِ : اللَّہُمَّ اغْفِرْ لِی وَارْحَمْنِی وارزقنی وَعَافَنِی وَاہْدِنِی ، فَعَدَّہَا الأَعْرَابِیُّ فِی یَدِہِ خَمْسًا ، ثُمَّ انْطَلَقَ فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَقَدْ مَلأَ الأَعْرَابِیُّ یَدَیْہِ مِنَ الْخَیْرِ إِنْ ہُوَ وَفَّی بِمَا قَالَ۔","Sahih","Musannaf Ibn Abi Shaybah 30416","","","كتاب الدعاء"
"30417","(۳۰۴۱۷) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَن عبد العزیز بن رُفَیْعٍ ، عَنْ أَبِی صَالِحٍ ، قَالَ : لُدِغَ رَجُلٌ مِنَ الأَنْصَارِ، فَلَمَّا أَصْبَحَ أَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ یَا رَسُولَ اللہِ ، مَا زِلْت الْبَارِحَۃَ سَاہِرًا مِنْ لَدْغَۃِ عَقْرَبٍ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَمَا إنَّک لَوْ قُلْتَ حِینَ أَمْسَیْت أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّۃِ مِنْ شَرِّ مَا خَلَقَ مَا ضَرَّک عَقْرَبٌ حَتَّی تُصْبِحَ ، قَالَ أَبُو صَالِحٍ : فَعَلَّمْتہَا ابْنَتِی وَابْنِی فَلَدَغَتْہُمَا فَلَمْ یَضُرَّہُمَا بِشَیْئٍ۔ (نسائی ۱۰۴۳۳)","","Musannaf Ibn Abi Shaybah 30417","","","كتاب الدعاء"
"30418","(۳۰۴۱۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامُ بْنُ حَسَّانَ ، عَن سُہَیْلِ بْنِ أَبِی صَالِحٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَالَ حِینَ یُمْسِی ثَلاثَ مَرَّاتٍ أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّۃِ مِنْ شَرِّ مَا خَلَقَ لَمْ یَضُرَّہُ لَسْعَۃٌ تِلْکَ اللَّیْلَۃَ ، قَالَ سُہَیْلٌ : فَکَانَ أَہْلُہُ قَدِ اعْتَادُوا أَنْ یَقُولُوہَا فَلُسِعَتِ امْرَأَۃٌ فَلَمْ تَجِدْ لَہَا وَجَعًا۔ (ترمذی ۳۶۰۰۔ احمد ۲۹۰)","Sahih","Musannaf Ibn Abi Shaybah 30418","","","كتاب الدعاء"
"30419","(۳۰۴۱۹) حَدَّثَنَا عَبْدُ الرحمن بْنُ سُلَیْمَانَ ، عَن حَجَّاجٍ ، عَنِ الزُّہْرِیِّ ، عَن طَارِقِ بْنِ أَبِی مخَاشِنِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أُتِیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِرَجُلٍ قَدْ لَدَغَتْہُ عَقْرَبٌ ، فَقَالَ : أَمَا إِنَّہُ لَوْ قَالَ أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّۃِ مِنْ شَرِّ مَا خَلَقَ لَمْ یُلْدَغْ ، أَوْ لَمْ یَضُرَّہُ۔","","Musannaf Ibn Abi Shaybah 30419","","","كتاب الدعاء"
"30420","(۳۰۴۲۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن مُطَرِّفٍ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو عَن مُحَمَّدِ بْنِ عَلِیٍّ ، عَنْ عَلِیٍّ ، قَالَ : بَیْنَمَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ لَیْلَۃٍ یُصَلِّی فَوَضَعَ یَدَہُ عَلَی الأَرْضِ فَلَدَغَتْہُ عَقْرَبٌ فَتَنَاوَلَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَعْلِہِ فَقَتَلَہَا ، فَلَمَّا انْصَرَفَ ، قَالَ : أَخْزَی اللَّہُ الْعَقْرَبَ ، مَا تَدَعُ مُصَلِّیًا ، وَلا غَیْرَہُ ، أَوْ مُؤْمِنًا ، وَلا غَیْرَہُ ، ثُمَّ دَعَا بِمِلْحٍ وَمَائٍ فَجَعَلَہُ فِی إنَائٍ وَجَعَلَ یَصُبُّہُ عَلَی إصْبَعِہِ حَیْثُ لَدَغَتْہُ وَیَمْسَحُہَا وَیُعَوِّذُہَا بِالْمُعَوِّذَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 30420","","","كتاب الدعاء"
"30421","(۳۰۴۲۱) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَنِ الْقَعْقَاعِ، عَنْ إبْرَاہِیمَ، قَالَ: رُقْیَۃُ الْعَقْرَبِ شَجَّۃُ قَرْنِیَّۃٍ مَلِحَۃٍ بحر قفطا۔","","Musannaf Ibn Abi Shaybah 30421","","","كتاب الدعاء"
"30422","(۳۰۴۲۲) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ الْمُغِیرَۃِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : عَرَضْتہَا عَلَی عَائِشَۃَ فَقَالَتْ : ہَذِہِ مَوَاثِیقُ۔","Sahih","Musannaf Ibn Abi Shaybah 30422","","","كتاب الدعاء"
"30423","(۳۰۴۲۳) حَدَّثَنَا مُعَاوِیَۃ بْن ہِشَامٍ، قَالَ: حدَّثَنَا سُفْیَانُ، عَن قُدَامَۃَ بْنِ حَمَاطَۃَ ، عَن زِیَادِ بْنِ حُدَیْرٍ، قَالَ: سَمِعْتُ الْعَلائَ بْنَ الْحَضْرَمِیِّ یُحَدِّثُ خَالَہُ ، أَنَّہُ کَانَ مِنْ دُعَائِہِ حِینَ خَاضَ الْبَحْرَ : اللَّہُمَّ یَا حَلِیمُ یَا عَلِیُّ یَا عَظِیمُ۔","Hasan","Musannaf Ibn Abi Shaybah 30423","","","كتاب الدعاء"
"30424","(۳۰۴۲۴) حَدَّثَنَا قُتَیْبَۃُ بْنُ سَعِیدٍ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ جَعْفَرِ بْنِ رَبِیعَۃَ ، عَنِ الأَعْرَجِ، عَنْ أَبِی ہُرَیْرَۃَ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا سَمِعْتُمَ الدِّیکَۃ فَسَلُوا اللَّہَ مِنْ فَضْلِہِ فَإِنَّہَا رَأَتْ مَلَکًا ، وَإِذَا سَمِعْتُمْ نَہِیقَ الْحِمَارِ فَتَعَوَّذُوا بِاللہِ مِنَ الشَّیْطَانِ الرَّجِیمِ فَإِنَّہَا رَأَتْ شَیْطَانًا۔ (بخاری ۳۳۰۳۔ مسلم ۲۰۹۲)","Sahih","Musannaf Ibn Abi Shaybah 30424","","","كتاب الدعاء"
"30425","(۳۰۴۲۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَن مُحَمَّدِ بْنِ إبْرَاہِیمَ بْنِ الْحَارِثِ ، عَنْ عَطَائِ بْنِ یَسَارٍ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، یقول : إذَا سَمِعْتُمْ نُبَاحَ الْکِلابِ، أَوْ نُہَاقَ الْحِمَارِ مِنَ اللَّیْلِ فَتَعَوَّذُوا بِاللہِ فَإِنَّہُنَّ یَرَیْنَ مَا لاَ تَرَوْنَ۔ (بخاری ۱۲۳۴۔ احمد ۳۰۶)","Hasan","Musannaf Ibn Abi Shaybah 30425","","","كتاب الدعاء"
"30426","(۳۰۴۲۶) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَن طَلْحَۃَ بْنِ عَمْرٍو ، عَنْ عَطَائٍ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ إذَا سَمِعَ نُہَاقَ الْحِمَارِ ، قَالَ : بسم اللہ الرَّحْمَن الرحیم أَعُوذُ بِاللہِ السَّمِیعِ الْعَلِیمِ مِنَ الشَّیْطَانِ الرَّجِیمِ۔","Da'if","Musannaf Ibn Abi Shaybah 30426","","","كتاب الدعاء"
"30427","(۳۰۴۲۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن یُونُسَ بْنِ عَمْرٍو ، عَن برید بْنِ أَبِی مَرْیَمَ ، عْن أَنَسِ بْنِ مَالِکٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا مِنْ عَبْدٍ یَسْأَلُ اللَّہَ الْجَنَّۃَ ثَلاثَ مَرَّاتٍ ، إِلاَّ قَالَتِ الجنۃ : اللَّہُمَّ أدخلہ الجنۃ ، وما من عبد یستعیذوا باللہ من النار ثَلاثَ مَرَّاتٍ إلا قالت النار اللہم أجرہ مِنِّی۔ (ترمذی ۲۵۷۲۔ ابن حبان ۱۰۱۴)","Hasan","Musannaf Ibn Abi Shaybah 30427","","","كتاب الدعاء"
"30428","(۳۰۴۲۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَن مِسْعَرٍ ، عَنْ عَبْدِ الأَعْلَی التَّیْمِیِّ ، قَالَ : الْجَنَّۃُ وَالنَّارُ لَقِنَتَا السَّمْعَ مِنْ بَنِی آدَمَ ، فَإِذَا سَأَلَ الرَّجُلُ الْجَنَّۃَ قَالَتِ الْجَنَّۃُ : اللَّہُمَّ أَدْخِلْہُ فِیَّ ، وَإِذَا اسْتَعَاذَ مِنَ النَّارِ قَالَتْ : اللَّہُمَّ أَعِذْہُ مِنِّی۔","","Musannaf Ibn Abi Shaybah 30428","","","كتاب الدعاء"
"30429","(۳۰۴۲۹) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عَامِرِ بْنِ شَقِیقٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : مَا شَہِدَ عَبْدُ اللہِ مَجْمَعًا ، وَلا مَأْدُبَۃً فَیَقُومُ حَتَّی یَحْمَدَ اللَّہَ وَیُصَلِّیَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَإِنْ کَانَ مِمَّا یتبع أَغْفَلَ مَکَان فِی السُّوقِ فَیَجْلِسُ فِیہِ فَیَحْمَدُ اللَّہَ وَیُصَلِّی عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Hasan","Musannaf Ibn Abi Shaybah 30429","","","كتاب الدعاء"
"30430","(۳۰۴۳۰) حَدَّثَنَا طَلْقُ بْنُ غَنَّامٍ ، قَالَ : حدَّثَنَا شَیْبَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَن حبَّۃ الْعُرَنِی ، عَنْ عَلِیٍّ ، قَالَ : مَنْ قَالَ عِنْدَ کُلِّ عَطْسَۃٍ یَسْمَعُہَا الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ عَلَی کُلِّ حَالٍ مَا کَانَ لَمْ یَجِدْ وَجَعَ ضِرْسٍ ، وَلا أُذُنٍ أَبَدًا۔","Da'if","Musannaf Ibn Abi Shaybah 30430","","","كتاب الدعاء"
"30431","(۳۰۴۳۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، قَالَ : أَبْطَأَ عَلَی عُمَرَ خَبَرُ نَہَاوَنْدَ وَخَبَرُ النُّعْمَانِ بْنِ مُقَرِّنٍ فَجَعَلَ یَسْتَنْصِرُ۔","Hasan","Musannaf Ibn Abi Shaybah 30431","","","كتاب الدعاء"
"30432","(۳۰۴۳۲) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَن حَجَّاجِ بْنِ دِینَارٍ ، عَنِ الْحَکَمِ بْنِ جَحْلٍ ، عَن رَجُلٍ حَدَّثَہُ عَنْ عَلِیٍّ ، أَنَّہُ قَالَ : مَنْ قَرَأَ بَعْدَ الْفَجْرِ {قُلْ ہُوَ اللَّہُ أَحَدٌ} عَشْرَ مَرَّاتٍ لَمْ یَلْحَقْ بِہِ ذَلِکَ الْیَوْمَ ذَنْبٌ ، وَإِنْ جَہَدَتہ الشَّیَاطِینُ۔","Da'if","Musannaf Ibn Abi Shaybah 30432","","","كتاب الدعاء"
"30433","(۳۰۴۳۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن لَیْثٍ ، عَن ہِلالٍ ، قَالَ : مَنْ قَرَأَ {قُلْ ہُوَ اللَّہُ أَحَدٌ} عَشْرَ مَرَّاتٍ بُنِیَ لَہُ بُرْجٌ فِی الْجَنَّۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30433","","","كتاب الدعاء"
"30434","(۳۰۴۳۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن سَعِیدِ بْنِ سَعِیدٍ ، قَالَ : لَحِقَنِی نَافِعُ بْنُ جُبَیْرٍ حِینَ انْصَرَفْت مِنَ الْمَغْرِبِ ، فَقُلْتُ : مَا شَأْنُکَ ؟ فَقَالَ : إذَا مَرَرْت عَلَی قَبْرِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقُلْ : السَّلامُ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَرَحْمَۃُ اللہِ ، فَإِنَّ الشَّیْطَانَ یَقُولُ : لاَ صُحْبَۃَ ، فَإِذَا دَخَلْتُ عَلَی أَہْلِکَ فَقُلْ : السَّلامُ عَلَیْکُمْ ، فَإِنَّ الشَّیْطَانَ یَقُولُ : لاَ مَبِیتَ ، فَإِذَا أُتِیتَ بِعَشَائِکَ فَقُلْ : بِسْمِ اللہِ ، فَإِنَّ الشَّیْطَانَ یُوَلِّی خَاسِئًا یَقُولُ لأَصْحَابِہِ : لاَ مَبِیتَ ، وَلا عَشَائَ۔","","Musannaf Ibn Abi Shaybah 30434","","","كتاب الدعاء"
"30435","(۳۰۴۳۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن لَیْثٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یَنَامُ حَتَّی یَقْرَأَ : {الم تَنْزِیلُ} وَ {تَبَارَکَ الَّذِی بِیَدِہِ الْمُلْکُ}۔ (بخاری ۱۲۰۹۔ دارمی ۳۴۱۱)","Da'if","Musannaf Ibn Abi Shaybah 30435","","","كتاب الدعاء"
"30436","(۳۰۴۳۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن لَیْثٍ ، عَن طَاوُوس ، قَالَ : فُضِّلَتْ : {الم تَنْزِیلُ} وَ{تَبَارَکَ الَّذِی بِیَدِہِ الْمُلْکُ} عَلَی سَائِرِ الْقُرْآنِ بِسِتِّینَ حَسَنَۃً۔ (ترمذی ۲۸۹۲۔ دارمی ۳۴۱۲)","","Musannaf Ibn Abi Shaybah 30436","","","كتاب الدعاء"
"30437","(۳۰۴۳۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن ہِشَامٍ ، عَنْ أَبِی یُونُسَ ، عَن طَاوُوس ، قَالَ : مَنْ قَرَأَ فی لیلۃ : {الم تَنْزِیلُ السَّجْدَۃَ} وَ {تَبَارَکَ الَّذِی بِیَدِہِ الْمُلْکُ} کَانَ مِثْلُ أَجْرِ لَیْلَۃِ الْقَدْرِ ، قَالَ : فَمَرَّ عَطَائٌ فَقُلْنَا لِرَجُلٍ مِنَّا : ائْتِہِ فَسَلْہُ ، فَقَالَ : صَدَقَ ، مَا تَرَکْتہمَا مُنْذُ سَمِعْتہمَا۔","","Musannaf Ibn Abi Shaybah 30437","","","كتاب الدعاء"
"30438","(۳۰۴۳۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ إِسْحَاقَ عَنْ أَبَانَ بْنِ صَالِحٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا نَفَرَتْ دَابَّۃُ أَحَدِکُمْ ، أَوْ بَعِیرُہُ بِفَلاۃٍ مِنَ الأَرْضِ لاَ یَرَی بِہَا أَحَدًا فَلْیَقُلْ : أَعِینُوا عِبَادَ اللہِ ، فَإِنَّہُ سَیُعَانُ۔ (ابویعلی ۵۲۴۷)","","Musannaf Ibn Abi Shaybah 30438","","","كتاب الدعاء"
"30439","(۳۰۴۳۹) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَن مِسْعَرٍ ، عَن ذَکْوَانَ ، عَنْ أَبِی ہُرَیْرَۃً ، قَالَ : دَعْوَۃُ الْمُسْلِمِ مُسْتَجَابَۃٌ مَا لَمْ یَدْعُ بِظُلْمٍ ، أَوْ قَطِیعَۃِ رَحِمٍ ، أَوْ یَقُلْ : قَدْ دَعَوْت فَلَمْ أُجَبْ۔","Sahih","Musannaf Ibn Abi Shaybah 30439","","","كتاب الدعاء"
"30440","(۳۰۴۴۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَن سُفْیَانَ ، عَنْ عَاصِمٍ ، عَن عُبَیْدٍ مَوْلَی أَبِی رُہْمٍ ، قَالَ : مَرَرْت مَعَ أَبِی ہُرَیْرَۃَ عَلَی نَخْلٍ فَقَالَ : اللَّہُمَّ أَطْعِمْنَا مِنْ تَمْرٍ لاَ یَأْبرُہُ بَنُو آدم۔","Da'if","Musannaf Ibn Abi Shaybah 30440","","","كتاب الدعاء"
"30441","(۳۰۴۴۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن مَنْصُورٍ ، عَن مُجَاہِدٍ ، قَالَ : کَانَ یُقَالُ : إذَا خَرَجَ الرَّجُلُ مِنَ الْمَسْجِدِ فَلْیَقُلْ : بِسْمِ اللہِ تَوَکَّلْت عَلَی اللہِ اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ شَرِّ مَا خَرَجْت لَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30441","","","كتاب الدعاء"
"30442","(۳۰۴۴۲) حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ ، قَالَ : حدَّثَنِی عزرۃ بْنُ قَیْسٍ صَاحِبُ الطَّعَامِ ، قَالَ : حَدَّثَتْنِی أُمُّ الفیض ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ قَالَ ہَؤُلائِ الْکَلِمَاتِ لَیْلَۃَ عَرَفَۃَ أَلْفَ مَرَّۃٍ، لَمْ یَسْأَلَ اللَّہَ شَیْئًا إِلاَّ أَعْطَاہُ إیَّاہُ ، لَیْسَ فِیہِ إِثْمَ ، وَلا قَطِیعَۃُ رَحِمٍ ، سُبْحَانَ اللہِ الَّذِی فِی السَّمَائِ عَرْشُہُ ، سُبْحَانَ اللہِ الَّذِی فِی الأَرْضِ مَوْطِئُہُ ، سُبْحَانَ اللہ الَّذِی فِی الْبَحْرِ سَبِیلُہُ ، سُبْحَانَ اللہ الَّذِی فِی الْجَنَّۃِ رَحْمَتُہُ ، سُبْحَانَ اللہ الَّذِی فِی النَّارِ سُلْطَانُہُ ، سُبْحَانَ اللہ الَّذِی فِی الْہَوَائِ رَحْمَتُہُ ، سُبْحَانَ اللہ الَّذِی فِی الْقُبُورِ قَضَاؤُہُ ، سُبْحَانَ اللہ الَّذِی رَفَعَ السَّمَائَ ، سُبْحَانَ اللہ الَّذِی وَضَعَ الأَرْضَ ، سُبْحَانَ اللہِ الَّذِی لاَ مَنْجَی مِنْہُ إِلاَّ إلَیْہِ۔ (ابویعلی ۳۵۶۴۔ طبرانی ۴۱۲)","Da'if","Musannaf Ibn Abi Shaybah 30442","","","كتاب الدعاء"
"30443","(۳۰۴۴۳) حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ ، عَنْ عَبْدِ الْوَاحِدِ بْن زِیَادٍ ، قَالَ : حدَّثَنِی عَبْدُ الرَّحْمَانِ بْنُ زِیَادٍ ، قَالَ : حَدَّثَنِی شَیْخٌ مِنْ قُرَیْشٍ ، عَنِ ابْنِ عُکَیم ، قَالَ : قَالَ لِی عُمَرُ بْنُ الْخَطَّابِ : قَالَ لَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا ابْنَ الْخَطَّابِ ، قُلِ : اللَّہُمَّ اجْعَلْ سَرِیرَتِی خَیْرًا مِنْ عَلانِیَتِی ، وَاجْعَلْ عَلانِیَتِی صَالِحَۃً۔n(ترمذی ۳۵۸۶)","Da'if","Musannaf Ibn Abi Shaybah 30443","","","كتاب الدعاء"
"30444","(۳۰۴۴۴) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ مِنْ دُعَائِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اللَّہُمَّ أَعِنِّی عَلَی ذِکْرِکَ وَشُکْرِکَ وَحُسْنِ عِبَادَتِک۔ (ابوداؤد ۱۵۱۷۔ احمد ۲۴۷)","","Musannaf Ibn Abi Shaybah 30444","","","كتاب الدعاء"
"30445","(۳۰۴۴۵) حَدَّثَ??َا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا سَلِمَۃُ بْنُ وَرْدَانَ ، قَالَ : سَمِعْتُ أَنَسًا ، قَالَ : أَتَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ امْرَأَۃٌ تَشْکُو إلَیْہِ الْحَاجَۃَ فَقَالَ : أَدُلُّک عَلَی خَیْرٍ مِنْ ذَلِکَ ، تُہَلِّلِینَ اللَّہَ ثَلاثًا وَثَلاثِینَ عِنْدَ مَنَامِکَ وَتُسَبِّحِینَہُ ثَلاثًا وَثَلاثِینَ ، وَتَحْمَدِینَہُ أَرْبَعًا وَثَلاثِینَ ، قَالَ : تِلْکَ مِئَۃ مَرَّۃٍ خَیْرٌ مِنَ الدُّنْیَا ، وَمَا فِیہَا۔n (بخاری ۶۳۵)","Da'if","Musannaf Ibn Abi Shaybah 30445","","","كتاب الدعاء"
"30446","(۳۰۴۴۶) حَدَّثَنَا مُصْعَبُ بْنُ الْمِقْدَامِ ، قَالَ : حدَّثَنِی إسْرَائِیلُ ، عَنْ أَبِی سِنَانٍ ضِرَارِ بْنِ مُرَّۃَ ، عَنْ أَبِی صَالِحٍ الْحَنَفِیِّ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، وَأَبِی ہُرَیْرَہُ ، قَالا : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ اصْطَفَی مِنَ الْکَلامِ أَرْبَعًا : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ ، ثُمَّ قَالَ : مَنْ قَالَ سُبْحَانَ اللہِ ، کُتِبَ لَہُ عِشْرُونَ حَسَنَۃً ، وَحُطَّ عَنْہُ عِشْرُونَ سَیِّئَۃً ، وَمَنْ قَالَ : اللَّہُ أَکْبَرُ فَمِثْلُ ذَلِکَ ، وَمَنْ قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ فَمِثْلُ ذَلِکَ ، وَمَنْ قَالَ الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ مِنْ قِبَلِ نَفْسِہِ کُتِبَتْ لَہُ ثَلاثُونَ حَسَنَۃً وَحُطَّ عَنْہُ ثَلاثُونَ سَیِّئَۃً۔ (عبدالرزاق ۳۱۰)","Hasan","Musannaf Ibn Abi Shaybah 30446","","","كتاب الدعاء"
"30447","(۳۰۴۴۷) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، قَالَ : أَخْبَرَنَا ہِشَامُ بْنُ الْغَازِ ، عَن مَکْحُولٍ ، قَالَ : مَنْ قَالَ لاَ حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ ، وَلا مَلْجَأَ مِنَ اللہِ إِلاَّ إلَیْہِ ، دَفَعَ اللَّہُ عَنْہُ سَبْعِینَ بَابًا مِنَ الضُّرِّ أَدْنَاہَا الْفَقْرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30447","","","كتاب الدعاء"
"30448","(۳۰۴۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، قَالَ : حَدَّثَنَا شَرِیکُ بْنُ عَبْدِ اللہِ بْنِ أَبِی نَمِرٍ ، قَالَ : دَخَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَسْجِدَ ، وَرَجُلٌ یَقُولُ : اللَّہُمَّ لاَ إلَہَ إِلاَّ أَنْتَ ، وَعْدُک حَقٌّ ، وَلِقَاؤُک حَقٌّ ، وَالْجَنَّۃُ حَقٌّ ، وَالنَّارُ حَقٌّ ، وَالنَّبِیُّونَ حَقٌّ ، وَمُحَمَّدٌ حَقٌّ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سَلْ تُعْطَہُ۔ (طبرانی ۸۴۱۹)","","Musannaf Ibn Abi Shaybah 30448","","","كتاب الدعاء"
"30449","(۳۰۴۴۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ بَکْرٍ السَّہْمِیُّ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیّ ، عَن یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی جَعْفَرٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ثَلاثُ دَعَوَاتٍ مُسْتَجَاباتٌ لَہُنَّ لاَ شَکَّ فِیہِنَّ : دَعْوَۃُ الْمَظْلُومِ ، وَدَعْوَۃُ الْمُسَافِرِ ، وَدَعْوَۃُ الْوَالِدِ عَلَی وَلَدِہِ۔ (احمد ۲۵۸۔ ابوداؤد ۱۵۳۱)","Da'if","Musannaf Ibn Abi Shaybah 30449","","","كتاب الدعاء"
"30450","(۳۰۴۵۰) حَدَّثَنَا جَرِیرٌ ، عَن مُغِیرَۃَ ، عَنِ الأَسْلَعِ بْنِ حَیٍّ ، قَالَ : کُنْتُ بِالْمَدِینَۃِ أَطْلُبُ دَمًا لِی ، فَقُلْتُ لأَبِی ہُرَیْرَۃَ ادْعُ اللَّہَ أَنْ یَنْصُرَنِی ، فَقَالَ : اللَّہُمَّ إِنْ کَانَ مَظْلُومًا فَانْصُرْہُ ، وَإِنْ کَانَ ظَالِمًا فَانْصُرْ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30450","","","كتاب الدعاء"
"30451","(۳۰۴۵۱) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : جَائَ رَجُلٌ یَہُودِیٌّ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : ادْعُ اللہ لِی ، فَقَالَ : أَکْثَرَ اللَّہُ مَالَک وَوَلَدَک وَأَصَحَّ جِسْمَک وَأَطَالَ عُمْرَک۔","","Musannaf Ibn Abi Shaybah 30451","","","كتاب الدعاء"
"30452","(۳۰۴۵۲) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَقُولَ لِلْیَہُودِیِّ وَالنَّصْرَانِیِّ : ہَدَاکَ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 30452","","","كتاب الدعاء"
"30453","(۳۰۴۵۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَن مَعْمَرٍ ، عَن قَتَادَۃَ ، أَنَّ یَہُودِیًّا حَلَبَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَاقَۃً فَقَالَ : اللَّہُمَّ جَمِّلْہُ ، فَاسْوَدَّ شَعْرُہُ۔","","Musannaf Ibn Abi Shaybah 30453","","","كتاب الدعاء"
"30454","(۳۰۴۵۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَن حَسَّانَ بْنِ عَطِیَّۃَ ، قَالَ : لاَ بَأْسَ أَنْ یُؤَمِّنَ الْمُسْلِمُ عَلَی دُعَائِ الرَّاہِبِ ، فَقَالَ : إنَّہُمْ یُسْتَجَابُ لَہُمْ فِینَا ، وَلا یُسْتَجَابُ لَہُمْ فِی أَنْفُسِہِمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 30454","","","كتاب الدعاء"
"30455","(۳۰۴۵۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَن سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّہُ کَانَ یَقُومُ عَلَی الْمَنْفُوسِ مِنْ وَلَدِہِ الَّذِی لَمْ یَعْمَلْ خَطِیئَۃً فَیَقُولُ : اللَّہُمَّ أَجِرْہُ مِنْ عَذَابِ النَّارِ۔","Sahih","Musannaf Ibn Abi Shaybah 30455","","","كتاب الدعاء"
"30456","(۳۰۴۵۶) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَن یُونُسَ ، عَن زِیَادِ بْنِ جُبَیْرٍ ، عَنْ أَبِیہِ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، قَالَ : السِّقْطُ یدعی لِوَالِدَیْہِ بِالْعَافِیَۃِ وَالْمَغْفِرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 30456","","","كتاب الدعاء"
"30457","(۳۰۴۵۷) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَن سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ : اللَّہُمَّ اجْعَلْہُ لَنَا فَرَطًا وَذُخْرًا وَأَجْرًا۔","No Data Available","Musannaf Ibn Abi Shaybah 30457","","","كتاب الدعاء"
"30458","(۳۰۴۵۸) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، قَالَ : حدَّثَنَا الْجُلاَسُ السُّلَمِیُّ ، قَالَ : سَمِعْتُ عَلِیَّ بْنَ جِحَاشٍ ، قَالَ سَمِعْت سَمُرَۃَ بْنَ جُنْدَبٍ وَمَاتَ ابْنٌ لَہُ صَغِیرٌ فَقَالَ : اذْہَبُوا فَادْفِنُوہُ ، وَلا تُصَلُّوا عَلَیْہِ فَإِنَّہُ لَیْسَ عَلَیْہِ إِثْم، وَادْعُوا اللَّہَ لِوَالِدَیْہِ أَنْ یَجْعَلَہُ لَہُمَا فَرَطًا وَأَجْرًا ، أَوْ نَحْوَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30458","","","كتاب الدعاء"
"30459","(۳۰۴۵۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حُسَیْن عَنْ أَبِی بِشْرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : تَسْبِیحَۃٌ فِی رَمَضَانَ أَفْضَلُ مِنْ أَلْفٍ فِی غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 30459","","","كتاب الدعاء"
"30460","(۳۰۴۶۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا وَضَعَ الْمَیِّتَ فِی الْقَبْرِ ، قَالَ : بِسْمِ اللہِ وَبِاللہِ وَعَلَی سُنَّۃِ رَسُولِ اللہِ۔","","Musannaf Ibn Abi Shaybah 30460","","","كتاب الدعاء"
"30461","(۳۰۴۶۱) حَدَّثَنَا وَکِیعٌ ، عَن ہَمَّامٍ ، عَن قَتَادَۃَ ، عَنْ أَبِی الصِّدِّیقِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا وَضَعْتُمْ مَوْتَاکُمْ فِی قُبُورِہِمْ ، فَقُولُوا : بِسْمِ اللہِ ، وَعَلَی سُنَّۃِ رَسُولِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30461","","","كتاب الدعاء"
"30462","(۳۰۴۶۲) حَدَّثَنَا وَکِیعٌ ، عَن شُعْبَۃُ ، عَن قَتَادَۃَ ، عَنْ أَبِی الصِّدِّیقِ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ مِثْلَ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 30462","","","كتاب الدعاء"
"30463","(۳۰۴۶۳) حَدَّثَنَا شَرِیکٌ ، وَأَبُو الأَحْوَصِ ، عَن مَنْصُورٍ ، عن أَبِی مُدْرِکٍ ، عَنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ إذَا أَدْخَلَ الْمَیِّتَ قَبْرَہُ ، وَقَالَ أَبُو الأَحْوَصِِ : إذَا سَوَّوْا عَلَیْہِ : اللَّہُمَّ أَسْلَمَہُ إلَیْک الْمَالُ وَالأَہْلُ وَالْعَشِیرَۃُ وَالذَّنْبُ الْعَظِیمُ فَاغْفِرْ لَہُ۔","","Musannaf Ibn Abi Shaybah 30463","","","كتاب الدعاء"
"30464","(۳۰۴۶۴) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَن سُفْیَانَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَن خَیْثَمَۃَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ إذَا وُضِعَ الْمَیِّتُ فِی الْقَبْرِ أَنْ یَقُولُوا : بِسْمِ اللہِ وَفِی سَبِیلِ اللہِ وَعَلَی مِلَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اللَّہُمَّ أَجِرْہُ مِنْ عَذَابِ الْقَبْرِ وَعَذَابِ النَّارِ وَشَرِّ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 30464","","","كتاب الدعاء"
"30465","(۳۰۴۶۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ ، أَنَّہُ کَانَ یَقُولُ : بِسْمِ اللہِ وَفِی سَبِیلِ اللہِ وَعَلَی مِلَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اللَّہُمَّ افْسَحْ لَہُ فِی قَبْرِہِ وَنَوِّرْ لَہُ فِیہِ ، وَأَلْحِقْہُ بِنَبِیِّہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنْتَ عَنْہُ رَاضٍ غَیْرُ غَضْبَانَ۔","","Musannaf Ibn Abi Shaybah 30465","","","كتاب الدعاء"
"30466","(۳۰۴۶۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الْعَلائِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ ، قَالَ : إذَا وَضْعت الْمَیِّتُ فِی قَبْرِہِ فَلا تَقُلْ : بِسْمِ اللہِ ، وَلَکِنْ قُلْ : فِی سَبِیلِ اللہِ ، وَعَلَی مِلَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَعَلَی مِلَّۃِ إبْرَاہِیمَ حَنِیفًا مسلما ، وَمَا کَانَ مِنَ الْمُشْرِکِینَ ، اللَّہُمَّ ثَبِّتْہُ بِالْقَوْلِ الثَّابِتِ فِی الآخِرَۃِ ، اللَّہُمَّ اجْعَلْہُ فِی خَیْرٍ مِمَّا کَانَ فِیہِ ، اللَّہُمَّ لاَ تَحْرِمْنَا أَجْرَہُ ، وَلا تَفْتِنَّا بَعْدَہُ ، قَالَ : وَنَزَلَتْ ہَذِہِ الآیَۃُ فِی صَاحِبِ الْقَبْرِ : {یُثَبِّتُ اللَّہُ الَّذِینَ آمَنُوا بِالْقَوْلِ الثَّابِتِ فِی الْحَیَاۃِ الدُّنْیَا وَفِی الآخِرَۃِ}۔","","Musannaf Ibn Abi Shaybah 30466","","","كتاب الدعاء"
"30467","(۳۰۴۶۷) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمٍ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ یَقُولُ عِنْدَ الْمَنَامِ إذَا نَامَ : بِسْمِ اللہِ وَفِی سَبِیلِ اللہِ وَعَلَی مِلَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَیَقُولُہُ إذَا أُدْخِلَ الرَّجُلَ قَبْرَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30467","","","كتاب الدعاء"
"30468","(۳۰۴۶۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا وَضَعْت الْمَیِّتَ فِی الْقَبْرِ فَقُلْ : بِسْمِ اللہِ وَعَلَی سُنَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 30468","","","كتاب الدعاء"
"30469","(۳۰۴۶۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْن سُلَیْمَان عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَن جُبَیْرِ بْنِ عَدِیٍّ ، قَالَ : أُخْبِرْت ، أَنَّ عَلِیَّ بْنَ أَبِی طَالِبٍ کَانَ یَقُولُ إذَا أُدْخِلَ الْمَیِّتَ فِی قَبْرِہِ : بِسْمِ اللہِ ، وَعَلَی مِلَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَتَصْدِیقِ کِتَابِکَ وَرُسُلِکَ وَبالْیَقِینِ بِالْبَعْثِ بَعْدَ الْمَوْتِ ، اللَّہُمَّ ارْحَبْ عَلَیْہِ قَبْرَہُ ، وَبَشِّرْہُ بِالْجَنَّۃِ۔","","Musannaf Ibn Abi Shaybah 30469","","","كتاب الدعاء"
"30470","(۳۰۴۷۰) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَن حُصَیْنٍ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : إذَا وُضِعَ الْمَیِّتُ فِی الْقَبْرِ فَقُلْ : بِسْمِ اللہِ وَإِلَی اللہِ ، وَعَلَی سُنَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30470","","","كتاب الدعاء"
"30471","(۳۰۴۷۱) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَن عبد اللہِ بْنِ أَبِی بَکْرٍ ، قَالَ : کَانَ أَنَسُ بْنُ مَالِکٍ إذَا سُوِّیَ عَلَی الْمَیِّتِ قَبْرُہُ قَامَ عَلَیْہِ ، ثُمَّ قَالَ : اللَّہُمَّ عَبْدُک رُدَّ عَلَیْک ، فَارْأَفْ بِہِ وَارْحَمْہُ ، اللَّہُمَّ جَافِ الأَرْضَ عَنْ جَنْبَیْہِ وَافْتَحْ أَبْوَابَ السَّمَائِ لِرُوحِہِ ، وَتَقَبَّلْہُ مِنْک بِقَبُولٍ حَسَنٍ ، اللَّہُمَّ إِنْ کَانَ مُحْسِنًا فَضَاعِفْ لَہُ فِی إحْسَانِہِ ، وَإِنْ کَانَ مُسِیئًا فَتَجَاوَزْ عَن سَیِّئَاتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30471","","","كتاب الدعاء"
"30472","(۳۰۴۷۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَن حَجَّاجٍ ، عَن عُمَیْرِ بْنِ سَعِیدٍ ، أَنَّ عَلِیًّا کَبَّرَ عَلَی یَزِیدَ بْنِ مُکَفَّفٍ أَرْبَعًا ، ثُمَّ قَامَ عَلَی الْقَبْرِ فَقَالَ : اللَّہُمَّ عَبْدُک ، وَابْنُ عَبْدِکَ نَزَلَ بِکَ الْیَوْمَ ، وَأَنْتَ خَیْرُ مَنْزُولٍ بِہِ ، اللَّہُمَّ وَسِّعْ لَہُ مُدْخَلَہُ وَاغْفِرْ لَہُ ذَنْبَہُ فَإِنَّا لاَ نَعْلَمُ إِلاَّ خَیْرًا وَأَنْتَ أَعْلَمُ بِہِ۔","","Musannaf Ibn Abi Shaybah 30472","","","كتاب الدعاء"
"30473","(۳۰۴۷۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : لَمَّا فُرِغَ مِنْ قَبْرِ عَبْدِ اللہِ بْنِ السَّائِبِ قَامَ ابْنُ عَبَّاسٍ عَلَی الْقَبْرِ فَوَقَفَ عَلَیْہِ ، ثُمَّ دَعَا ، ثُمَّ انْصَرَفَ۔","","Musannaf Ibn Abi Shaybah 30473","","","كتاب الدعاء"
"30474","(۳۰۴۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، قَالَ : رَأَیْتُ أَیُّوبَ یَقُومُ عَلَی الْقَبْرِ فَیَدْعُو لِلْمَیِّتِ ، وَرُبَّمَا رَأَیْتہ یَدْعُو لَہُ وَہُوَ فِی الْقَبْرِ قَبْلَ أَنْ یَخْرُجَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30474","","","كتاب الدعاء"
"30475","(۳۰۴۷۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ ، عَن قَیْسٍ ، قَالَ : دَخَلْنَا عَلَی خَبَّابٍ وَقَدِ اکْتَوَی سَبْعَ کَیَّاتٍ فِی بَطْنِہِ فَقَالَ : لَوْلا أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَانَا أَنْ نَدْعُوَ بِالْمَوْتِ لَدَعَوْت بِہِ۔ (بخاری ۵۶۷۲۔ مسلم ۲۰۶۴)","Sahih","Musannaf Ibn Abi Shaybah 30475","","","كتاب الدعاء"
"30476","(۳۰۴۷۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ ابْنِ عُمَرَ قَالَ: فَسَمِعَ رَجُلاً یَتَمَنَّی الْمَوْتَ ، قَالَ : فَرَفَعَ إلَیْہِ ابْنُ عُمَرَ بَصَرَہُ فَقَالَ : لاَ تَمَنَّ الْمَوْتَ فَإِنَّک مَیِّتٌ ، وَلَکِنْ سَلِ اللَّہَ الْعَافِیَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 30476","","","كتاب الدعاء"
"30477","(۳۰۴۷۷) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَن حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَتَمَنَّی أَحَدُکُمُ الْمَوْتَ لِضُرٍّ نَزَلَ بِہِ فِی الدُّنْیَا۔","Sahih","Musannaf Ibn Abi Shaybah 30477","","","كتاب الدعاء"
"30478","(۳۰۴۷۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَن یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَن عُرْوَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : کُنْت إِلَی جَنْبِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَفَقَدْتہ فَابْتَغَیْتُہُ فَإِذَا ہُوَ بِالْبَقِیعِ رَافِعًا یَدَیْہِ یَدْعُو فَقَالَ : یَا بنت أَبِی بَکْرٍ ، أَخَشِیت أَنَّ یَحِیفَ اللَّہُ عَلَیْک وَرَسُولُہُ ، إنَّ اللَّہَ یَنْزِلُ فِی ہَذِہِ اللَّیْلَۃِ ، لَیْلَۃ النِّصْفِ مِنْ شَعْبَانَ ، فَیَغْفِرُ فِیہَا مِنَ الذُّنُوبِ أَکْثَرَ مِنْ عَدَدِ شَعْرِ مَعْزِ کَلْبٍ۔ (ترمذی ۷۳۹۔ احمد ۲۳۸)","","Musannaf Ibn Abi Shaybah 30478","","","كتاب الدعاء"
"30479","(۳۰۴۷۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَن مَکْحُولٍ ، عَن کَثِیرِ بْنِ مُرَّۃَ الْحَضْرَمِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ یَنْزِلُ لَیْلَۃَ النِّصْفِ مِنْ شَعْبَانَ فَیَغْفِرُ فِیہَا الذُّنُوبَ إِلاَّ لِمُشْرِکٍ ، أَوْ مُشَاحِنٍ۔ (عبدالرزاق ۷۹۲۳)","","Musannaf Ibn Abi Shaybah 30479","","","كتاب الدعاء"
"30480","(۳۰۴۸۰) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَن مُوسَی بْنِ عُبَیْدَۃَ، عَنْ أَبِی بَکْرِ بْنِ أَنَسِ بْنِ مَالِکٍ، قَالَ: کَانَ لَہُ مَجُوسٌ یَعْمَلُونَ لَہُ فِی أَرْضِہِ وَکَانَ یَقُولُ لَہُمْ : أَطَالَ اللَّہُ أَعْمَارَکُمْ ، وَأَکْثَرَ أَمْوَالَکُمْ ، فَکَانُوا یَفْرَحُونَ بِذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 30480","","","كتاب الدعاء"
"30481","(۳۰۴۸۱) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ سُوقَۃَ ، عَن نَافِعٍ قَالَ : کَانَ ابْنُ عمَرَ إذَا قَدِمَ حَاجًّا ، أَوْ مُعْتَمِرًا طَافَ بِالْبَیْتِ وَصَلَّی رَکْعَتَیْنِ ، وَکَانَ جُلُوسُہُ فِیہَا أَطْوَلَ مِنْ قِیَامِہِ ثَنَائً عَلَی رَبِّہِ وَمَسْأَلَۃً ، فَکَانَ یَقُولُ حِینَ یَفْرُغُ مِنْ رَکْعَتَیْہِ وَبَیْنَ الصَّفَا وَالْمَرْوَۃِ : اللَّہُمَّ اعْصِمْنِی بِدِینِکَ وَطَاعَتِکَ وَطَاعَۃِ رَسُولِکَ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، اللَّہُمَّ جَنِّبْنِی حُدُودَک ?? اللَّہُمَّ اجْعَلْنِی مِمَّنْ یُحِبُّک وَیُحِبُّ مَلائِکَتَکَ وَرُسُلَک وَعِبَادَک الصَّالِحِینَ ، اللَّہُمَّ حَبِّبْنِی إلَیْک وَإِلَی مَلائِکَتِکَ وَرُسُلِکَ ، اللَّہُمَّ آتِنِی مِنْ خَیْرِ مَا تُؤْتِی عِبَادَک الصَّالِحِینَ فِی الدُّنْیَا وَالآخِرَۃِ ، اللَّہُمَّ یَسِّرْنِی لِلْیُسْرَی وَجَنِّبْنِی الْعُسْرَی ، وَاغْفِرْ لِی فِی الآخِرَۃِ وَالأُولَی ، اللَّہُمَّ أَوْزِعْنِی أَنْ أَفِیَ بِعَہْدِکَ الَّذِی عَاہَدْتنِی عَلَیْہِ ، اللَّہُمَّ اجْعَلْنِی مِنْ أَئِمَّۃِ الْمُتَّقِینَ ، وَاجْعَلْنِی مِنْ وَرَثَۃِ جَنَّۃِ النَّعِیمِ ، وَاغْفِرْ لِی خَطِیئَتِی یَوْمَ الدِّینِ۔","Sahih","Musannaf Ibn Abi Shaybah 30481","","","كتاب الدعاء"
"30482","(۳۰۴۸۲) حَدَّثَنَا یَعْلَی ، قَالَ : حدَّثَنَا عُثْمَانُ بْنُ حَکِیمٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ أَبِی الشَّعْثَائِ ، قَالَ : إذَا أَتَیْتَ یَوْمَ الْجُمُعَۃِ فَاقْعُدْ عَلَی بَابِ الْمَسْجِدِ وَقُلِ : اللَّہُمَّ اجْعَلْنِی الْیَوْمَ أَوْجَہَ مَنْ تَوَجَّہَ إلَیْک ، وَأَقْرَبَ مَنْ تَقَرَّبَ إلَیْک ، وَأَنْجَحَ مَنْ دَعَا وَطَلَبَ ، ثُمَّ ادْخُلْ وَسَلْ تُعْطَہُ۔","","Musannaf Ibn Abi Shaybah 30482","","","كتاب الدعاء"
"30483","(۳۰۴۸۳) حَدَّثَنَا شُعْبَۃُ ، عَنْ عَاصِمٍ مَوْلَی لقُرَیْبَۃِ بِنْتِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرٍ ، قَالَ : سَمِعْتُ قُرَیْبَۃَ تُحَدِّثُ عَنْ عَائِشَۃَ ، أَنَّہَا قَالَتْ : لاَ تَقُولِی لِلْمِسْکِینِ : بِوَرِکِ فِیہِ ، فَإِنَّہُ یَسْأَلُ الْبَرُّ وَالْفَاجِرُ ، وَلَکِنْ قَوْلِی : یَرْزُقُنَا اللَّہُ وَإِیَّاکَ۔","Da'if","Musannaf Ibn Abi Shaybah 30483","","","كتاب الدعاء"
"30484","(۳۰۴۸۴) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَن صُبَیْحٍ مَوْلَی بَنِی مَرْوَانَ ، عَن مَکْحُولٍ ، قَالَ : سَمِعْتُہُ یَقُولُ فِی الرَّہْصَۃِ : بِسْمِ اللہِ ، أَنْتَ الْوَاقِی وَأَنْتَ الشَّافِی وَأَنْتَ الْبَاقِی ، ثُمَّ یَعْقِدُ فِی خَیْطِ قِنَّبٍ جَدِیدٍ ، أَوْ شَعْرٍ ، ثُمَّ یَرْبِطُ بِہِ الدَّابَّۃَ لِلرَّہْصَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30484","","","كتاب الدعاء"
"30485","(۳۰۴۸۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن سُفْیَانَ ، عَن مُحَمَّدِ بْنِ سَعِیدٍ ، أَوْ سَعِیدِ بْنِ مُحَمَّدٍ ، قَالَ : کَانَ مِنْ دُعَائِ طَاوُوس ، یَقُولُ : اللَّہُمَّ امْنَعْنِی الْمَالَ وَالْوَلَدَ ، وَارْزُقْنِی الأَمْوَال وَالْعَمَلَ۔","","Musannaf Ibn Abi Shaybah 30485","","","كتاب الدعاء"
"30486","(۳۰۴۸۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا فِطْرٌ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدْعُو بِہَؤُلائِ الْکَلِمَاتِ وَیُعَظِّمُہُنَّ : اللَّہُمَّ یا فَارِجَ الْغَمِّ ، وَکَاشِفَ الْکَرْبِ ، وَمُجِیبَ الْمُضْطَرِّینَ ، وَرَحْمَنَ الدُّنْیَا وَالآخِرَۃِ وَرَحِیمَہُمَا ، ارْحَمْنِی الْیَوْمَ رَحْمَۃً تُغْنِینِی بِہَا عَن رَحْمَۃِ مَنْ سِوَاک۔ (طبرانی ۵۵۸۔ بزار ۳۱۷۷)","","Musannaf Ibn Abi Shaybah 30486","","","كتاب الدعاء"
"30487","(۳۰۴۸۷) حَدَّثَنَا وَکِیعٌ وَالْفَضْلُ بْنُ دُکَیْنٍ ، عَن سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْجَعْدِ ، عَن ثَوْبَانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یَرُدُّ الْقَدَرَ إِلاَّ الدُّعَائُ ، وَلا یَزِیدُ فِی الْعُمُرِ إِلاَّ الْبِرُّ۔ (احمد ۲۸۰۔ حاکم ۴۹۳)","","Musannaf Ibn Abi Shaybah 30487","","","كتاب الدعاء"
"30488","(۳۰۴۸۸) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَن مَنْصُورٍ ، عَن ہِلالِ بْنِ یَِسَافٍ ، عَن رَبِیعِ بْنِ عُمَیْلَۃَ ، عَن سَمُرَۃَ بْنِ جُنْدَبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَحَبُّ الْکَلامُ إِلَی اللہِ أَرْبَعٌ : سبحان اللہ ، وَالْحَمْدُ للہِ ، وَلاَ إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ ، لاَ یَضُرُّک بِأَیِّہِنَّ بَدَأْت۔ (مسلم ۱۶۸۵۔ احمد ۱۰)","Sahih","Musannaf Ibn Abi Shaybah 30488","","","كتاب الدعاء"
"30489","(۳۰۴۸۹) حَدَّثَنَا وَکِیعٌ ، وَأَبُو دَاوُد ، عَنْ سُفْیَانَ ، عَن سَلَمَۃَ بْنِ کُہَیْلٍ ، عَن ہِلالٍ ، عَن سَمُرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَفْضَلُ الْکَلامُ أَرْبَعٌ : سُبْحَانَ اللہِ ، وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ ، لاَ عَلَیْک بِأَیِّہِنَّ بَدَأْت۔ (ابن ماجہ ۳۸۱۱۔ احمد ۱۱)","","Musannaf Ibn Abi Shaybah 30489","","","كتاب الدعاء"
"30490","(۳۰۴۹۰) حَدَّثَنَا شَرِیکٌ ، عَن مُغِیرَۃَ ، عَن سُرِّیَّۃٍ لِعَبْدِ اللہِ بْنِ جَعْفَرٍ قَالَتْ: مَرَرْت بِعَلِیٍّ وَأَنَا حُبْلَی فَمَسَحَ بَطْنِی، وَقَالَ : اللَّہُمَّ اجْعَلْہُ ذَکَرًا مُبَارَکًا ، قَالَتْ : فَوَلَدْت غُلامًا۔","Da'if","Musannaf Ibn Abi Shaybah 30490","","","كتاب الدعاء"
"30491","(۳۰۴۹۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا سُفْیَانُ بْنِ أُمَیَّۃَ ، عَن دَاوُد بْنِ شَابُورَ ، قَالَ : قَالَ رَجُلٌ لِطَاوُوسٍ: ادْعُ لَنَا ، فَقَالَ : مَا أَجِدُ لِقَلْبِی خَشْیَۃ الآنَ۔","","Musannaf Ibn Abi Shaybah 30491","","","كتاب الدعاء"
"30492","(۳۰۴۹۲) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ ، قَالَ : حدَّثَنَا مَہْدِیُّ بْنُ مَیْمُونٍ ، عَن غَیْلانَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ إذَا نَعَبَ الْغُرَابُ ، قَالَ : اللَّہُمَّ لاَ طَیْرَ إِلاَّ طَیْرُک ، وَلا خَیْرَ إِلاَّ خَیْرُک ، وَلا إلَۃَ غَیْرُک۔","","Musannaf Ibn Abi Shaybah 30492","","","كتاب الدعاء"
"30493","(۳۰۴۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن یَحْیَی بْنِ وَثَّابٍ ، قَالَ : سَمِعْتُہُ یَقُولُ فِی قُنُوتِہِ : اللَّہُمَّ عَذِّبْ کَفَرَۃَ أَہْلِ الْکِتَابِ ، اللَّہُمَّ اجْعَلْ قُلُوبَہُمْ عَلَی قُلُوبِ نِسَائٍ کَوَافِرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30493","","","كتاب الدعاء"
"30494","(۳۰۴۹۴) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حدَّثَنَا حُمَیْدٌ ، عَنِ الْحَسَنِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : کُنَّا نَدْعُو قِیَامًا وَقُعُودًا وَنُسَبِّحُ رُکُوعًا وَسُجُودًا۔","Sahih","Musannaf Ibn Abi Shaybah 30494","","","كتاب الدعاء"
"30495","(۳۰۴۹۵) حَدَّثَنَا سُفْیَانُ ، عَن مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، قَالَ : جَائَ رَجُلٌ یَشْکُو امْرَأَتَہُ إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخَذَ بِرُؤُوسِہِمَا ، وَقَالَ : اللَّہُمَّ آدِمْ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 30495","","","كتاب الدعاء"
"30496","(۳۰۴۹۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن صَالِحِ بْنِ حَیَّانَ ، قَالَ : سَمِعْتُ أَبَا وَائِلٍ یَقُولُ : أَعْطَانِی عُمَرُ أَرْبَعَ أَعْطِیَۃٍ بِیَدِہِ ، وَقَالَ : التَّکْبِیرُ خَیْرٌ مِنَ الدُّنْیَا ، وَمَا فِیہَا۔","Sahih","Musannaf Ibn Abi Shaybah 30496","","","كتاب الدعاء"
"30497","(۳۰۴۹۷) حَدَّثَنَا سُلَیْمَانُ بْنُ حَرْبٍ ، قَالَ : حدَّثَنَا شُعْبَۃُ بْنُ الْحَجَّاجِ ، عَن یَزِیدَ بْنِ خُمَیْرٍ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ بُسْرٍ ، قَالَ : جَائَ رَجُلٌ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَنَزَلَ ، فَأَتَاہُ بِطَعَامٍ ؛ سَوِیقٍ وَحَیْسٍ ، فَأَکَلَ ، وَأَتَاہُ بِشَرَابٍ فَشَرِبَ ، فَنَاوَلَ مَنْ عَن یَمِینِہِ ، وَکَانَ إذَا أَکَلَ تَمْرًا أَلْقَی النَّوَی ہَکَذَا - وَأَشَارَ بِإِصْبَعَیْہِ عَلَی ظَہْرِہِمَا - قَالَ : فَلَمَّا رَکِبَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَامَ أَبِی فَأَخَذَ بِلِجَامِہِ ، فَقَالَ : یَا رَسُولَ اللہِ ، ادْعُ اللَّہَ لَنَا ، فَقَالَ : اللَّہُمَّ بَارِکْ لَہُمْ فِیمَا رَزَقْتَہُمْ ، وَاغْفِرْ لَہُمْ ، وَارْحَمْہُمْ۔ (احمد ۱۸۷)","Sahih","Musannaf Ibn Abi Shaybah 30497","","","كتاب الدعاء"
"30498","(۳۰۴۹۹) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ قَالَ : حدَّثَنَا أَبُو عَقِیلٍ ، قَالَ : حَدَّثَنَا عَمْرُو بْنُ خَالِدٍ ، قَالَ : سَمِعْتُ زَیْدَ بْنَ عَلِیٍّ یُحَدِّثُ عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : کَانَ إذَا رَأَی الْکَوْکَبَ مُنْقَضًّا ، قَالَ : اللَّہُمَّ صَوِّبْہُ وَأَصِبْ بِہِ وَقِنَا شَرَّ مَا یَتَّبِعُ۔","Da'if","Musannaf Ibn Abi Shaybah 30498","","","كتاب الدعاء"
"30499","(۳۰۴۹۹) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا أَبُو عَقِیلٍ ، قَالَ : حَدَّثَنَا مُجَالِدٌ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ إذَا اشْتَرَی مَمْلُوکًا ، قَالَ اللَّہُمَّ بَارِکْ لَنَا فِیہِ ، وَاجْعَلْہُ طَوِیلَ الْعُمُرِ کَثِیرَ الرِّزْق۔","Da'if","Musannaf Ibn Abi Shaybah 30499","","","كتاب الدعاء"
"30500","(۳۰۵۰۰) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا أَبُو عَقِیلٍ ، عَن شَیْخٍ حَدَّثَہُ قَالَ : سَأَلْتُ ابْنَ سِیرِینَ : مَا أَقُولُ فِی الْبَرْقِ إذَا رَأَیْتہ ؟ قَالَ تُغْمِضُ عَیْنَیْک وَتَذْکُرُ اللَّہَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30500","","","كتاب الدعاء"
"30501","(۳۰۵۰۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ: حدَّثَنِی عَبْدُ اللہِ بْنُ الْوَلِیدِ ، عَن زِیَادٍ ، عَنِ الْحَسَنِ ، قَالَ: مَنْ قَالَ إذَا قَالَ الْمُؤَذِّنُ أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ،اکفنی من أبی وَأَشْہَدُ مَعَ مَنْ شَہِدَ کَانَ لَہُ أَجْرُ مَنْ شَہِدَ وَمَنْ لَمْ یَشْہَدْ۔","","Musannaf Ibn Abi Shaybah 30501","","","كتاب الدعاء"
"30502","(۳۰۵۰۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ أَبِی جَعْفَرٍ بَیَّاعِ الطَّعَامِ ، قَالَ: کَانَ أَبُو جَعْفَرٍ یَقُولُ: أَعُوذُ بِاللہِ مِنْ شَرِّ الشَّیْطَانِ وَالسُّلْطَانِ ، وَشَرِّ النَّبَطِیِّ إذَا اسْتَعْرَبَ ، وَشَرِّ الْعَرَبِیِّ إذَا اسْتَنْبَطَ ، فَقِیلَ: وَکَیْفَ یَسْتَنْبِطُ الْعَرَبِیُّ ؟ قَالَ: إذَا أَخَذَ بِأَخْذِہِمْ وَزِیِّہِمْ۔","","Musannaf Ibn Abi Shaybah 30502","","","كتاب الدعاء"
"30503","(۳۰۵۰۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ عَن رَجُلٍ مِنْ أَہْلِ الْبَصْرَۃِ ، قَالَ: أُتِیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِہَدِیَّۃٍ وَعَائِشَۃُ قَائِمَۃٌ تُصَلِّی فَأَعْجَبَہُ أَنْ تَأْکُلَ مَعَہُ ، فَقَالَ: یَا عَائِشَۃُ اجْمَعِی وَأَوْجِزِی ، قَالَ: قُولِی: اللَّہُمَّ إنِّی أَسْأَلُک مِنَ الْخَیْرِ کُلِّہِ عَاجِلِہِ وَآجِلِہِ ، وَأَعُوذُ بِکَ مِنَ الشَّرِّ کُلِّہِ عَاجِلِہِ وَآجِلِہِ ، وَمَا قَضَیْت مِنْ قَضَائٍ فَبَارِکْ لِی فِیہِ ،وَاجْعَلْ عَاقِبَتَہُ إِلَی خَیْرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 30503","","","كتاب الدعاء"
"30504","(۳۰۵۰۴) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَن رَجُلٍ ، عَن مَکْحُولٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَا مِنْ رَجُلٍ یُحَمُّ فَیَغْتَسِلُ ثَلاثَۃَ أَیَّامٍ مُتَتَابِعَۃً ،یَقُولُ عِنْدَ کُلِّ غُسْلٍ: بِسْمِ اللہِ اللَّہُمَّ إِنِّی إنَّمَا اغْتَسَلْت الْتِمَاسَ شِفَائِکَ وَتَصْدِیقَ نَبِیِّکَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلاَّ کُشِفَ عَنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30504","","","كتاب الدعاء"
"30505","(۳۰۵۰۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ: حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَن زَیْدٍ الْعَمِّیِّ ، قَالَ: لَمَّا رَأَی یُوسُفُ عَزِیزَ مِصْرَ ، قَالَ: اللَّہُمَّ إنِّی أَسْأَلُک بِخَیْرِکَ مِنْ خَیْرِہِ وَأَعُوذُ بِقُوَّتِکَ مِنْ شَرِّہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30505","","","كتاب الدعاء"
"30506","(۳۰۵۰۶) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن حُمَیْدٍ ، أَنَّ سَعِیدَ بْنَ أَبِی الْحَسَنِ کَانَ یَقُولُ: اللَّہُمَّ سَوِّمْنَا سِیمَائَ الإِیمَانِ وَأَلْبِسْنَا لِبَاسَ التَّقْوَی۔","No Data Available","Musannaf Ibn Abi Shaybah 30506","","","كتاب الدعاء"
"30507","(۳۰۵۰۷) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، قَالَ: کُنَّا فِی مَکَان لاَ تَنْفذُہُ الدَّوَابُّ فَقُمْت وَأَنَا أَقْرَأُ ہَؤُلائِ الآیَاتِ {غَافِرِ الذَّنْبِ وَقَابِلِ التَّوْبِ شَدِیدِ الْعِقَابِ}، قَالَ فَمَرَّ شَیْخٌ عَلَی بَغْلَۃٍ شَہْبَائَ ، قَالَ: قُلْ: یَا غَافِرَ الذَّنْبِ اغْفِرْ ذَنْبِی ، یَا قَابِلَ التَّوْبِ اقْبَلْ تَوْبَتِی ، یَا شَدِیدَ الْعِقَابِ اعْفُ عَنی عِقَابِی ، یَا ذَا الطَّوْلِ طُل عَلَیَّ بِخَیْرٍ ، قَالَ: فَقُلْتہَا ، ثُمَّ نَظَرْت فَلَمْ أَرَہُ۔","","Musannaf Ibn Abi Shaybah 30507","","","كتاب الدعاء"
"30508","(۳۰۵۰۸) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن ثَابِتٍ ، عَن عُبَیْدِ اللہِ بْنِ عُبَیْدٍ ، أَنَّ جِبْرِیلَ مُوَکَّلُ بِالْحَوَائِجِ ،فَإِذَا سَأَلَ الْمُؤْمِنُ رَبَّہُ ، قَالَ: احْبِسَ احْبِسْ حُبًّا لِدُعَائِہِ أَنْ یَزْدَادَ ، وَإِذَا سَأَلَ الْکَافِرُ ، قَالَ: أَعْطِہِ أَعْطِہِ بُغْضًا لِدُعَائِہِ۔","","Musannaf Ibn Abi Shaybah 30508","","","كتاب الدعاء"
"30509","(۳۰۵۰۹) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادٌ ، عَن ثَابِتٍ ، قَالَ: کَانَ أَنَسٌ یَقُولُ: لَقَدْ تَرَکْت بَعْدِی عَجَائِزَ یُکْثِرْنَ أَنْ یَدْعِینَ اللَّہَ أَنْ یُورِدَہُنَّ حَوْضَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 30509","","","كتاب الدعاء"
"30510","(۳۰۵۱۰) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ: أَخْبَرَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَن عُمَرَ بْنِ الْحَکَمِ الأَنْصَارِیِّ ، قَالَ: سَأَلْتُہ: ہَلْ صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَسْجِدِ الْفَتْحِ الَّذِی یُقَالُ لَہُ: مَسْجِدُ الأَحْزَابِ ؟ قَالَ : لَمْ یُصَلِّ فِیہِ وَلَکِنَّہُ دَعَا ، فَکَانَ مِنْ دُعَائِہِ أَنْ ، قَالَ : اللَّہُمَّ لَکَ الْحَمْدُ لاَ ہَادِیَ لِمَنْ أَضْلَلْت ، وَلا مُضِلَّ لِمَنْ ہَدَیْت، وَلا مُہِینَ لِمَنْ أَکْرَمْت ، وَلا مُکْرِمَ لِمَنْ أَہَنْت ، وَلا نَاصِرَ لِمَنْ خَذَلْت ، وَلا خَاذِلَ لِمَنْ نَصَرْت ، وَلا مُعِزَّ لِمَنْ أَذْلَلْت ، وَلا مُذِلَّ لِمَنْ أَعْزَزْت ، وَلا رَازِقَ لِمَنْ حَرَمْت ، وَلا حَارِمَ لِمَنْ رَزَقْت ، وَلا مَانِعَ لِمَا أَعْطَیْت ، وَلا مُعْطِیَ لِمَا مَنَعْت ، وَلا رَافِعَ لِمَنْ خَفَضْت ، وَلا سَاتِرَ لِمَا خَرَقْت ، وَلا خَارِقَ لِمَا سَتَرْت ، وَلا مُقَرِّبَ لِمَا بَاعَدْت، وَلا مُبَاعِدَ لِمَنْ قَرَّبْت ، ثُمَّ دَعَا عَلَیْہِمْ فَلَمْ یُصْبِحْ فِی الْمَدِینَۃِ کرَّاب مِنَ الأَحْزَابِ ، وَلا مِنَ الْمُشْرِکِینَ إِلاَّ أَہْلَکَہُ اللَّہُ غَیْرَ حُیَیِّ بْنِ أَخْطَبَ وَقُرَیْظَۃَ قَتَلَہَا اللَّہُ وَشُتِّتَ۔ (احمد ۳۹۳)","Da'if","Musannaf Ibn Abi Shaybah 30510","","","كتاب الدعاء"
"30511","(۳۰۵۱۱) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الأسدی ، قَالَ: حدَّثَنَا یَحْیَی بْنُ الْمُہَلَّبِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ اللہِ الْجَدَلِیِّ ، قَالَ: کَانَ دَاوُد النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ جَارٍ عَیْنُہُ تَرَانِی وَقَلْبُہُ یَرْعَانِی ، إِنْ رَأَی خَیْرًا دَفَنَہُ ، وَإِنْ رَأَی شَرًّا أَشَاعَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30511","","","كتاب الدعاء"
"30512","(۳۰۵۱۲) حَدَّثَنَا سَعِیدُ بْنُ زَکَرِیَّا ، عَنْ عَبْدِ اللہِ بْنِ مُؤَمَّلٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ: کَانَ ابْنُ عَبَّاسٍ إذَا أُتِیَ بِفِطْرٍ دَعَا قَبْلَ ذَلِکَ ، وَبَلَغَنَا أَنَّ الدُّعَائَ قَبْلَ ذَلِکَ یُسْتَجَابُ۔","Hasan","Musannaf Ibn Abi Shaybah 30512","","","كتاب الدعاء"
"30513","(۳۰۵۱۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ الْوَاسِطِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَن قَیْسِ بْنِ عُبَادٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ قَالَ: مَنْ قَالَ إذَا فَرَغَ مِنْ وُضُوئِہِ سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ،أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ أَنْتَ، أَسْتَغْفِرُک وَأَتُوبُ إلَیْک ،خُتِمَتْ بِخَاتَمٍ ، ثُمَّ رُفِعَتْ تَحْتَ الْعَرْشِ ،فَلَمْ تُکْسَرْ إِلَی یَوْمِ الْقِیَامَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 30513","","","كتاب الدعاء"
"30514","(۳۰۵۱۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، وَعَبْدُ اللہِ بْنُ دَاوُد ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَن سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ: کَانَ عَلِیٌّ یَقُولُ إذَا فَرَغَ مِنْ وُضُوئِہِ: أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ رَبِّ اجْعَلْنِی مِنَ التَّوَّابِینَ ، وَاجْعَلْنِی مِنَ الْمُتَطَہِّرِینَ۔","Hasan","Musannaf Ibn Abi Shaybah 30514","","","كتاب الدعاء"
"30515","(۳۰۵۱۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ: حدَّثَنَا عَمْرُو بْنُ عبد اللہِ بْنِ وَہْبٍ النَّخَعِیُّ ، عَن زَیْدٍ الْعَمِّیِّ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: مَنْ تَوَضَّأَ فَقَالَ: أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ،وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ثَلاثَ مَرَّاتٍ ، فُتِحَتْ لَہُ ثَمَانیَۃُ أَبْوَابِ الْجَنَّۃِ یَدْخُلُ مِنْ أَیِّہَا شَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 30515","","","كتاب الدعاء"
"30516","(۳۰۵۱۶) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِیئُ ، عَن سَعِیدِ بْنِ أَبِی أَیُّوبَ ، قَالَ: حدَّثَنِی زَہْرَۃُ بْنُ مَعْبَدٍ أَبُو عَقِیلٍ ، أَنَّ ابْنَ عَمٍّ لَہُ أَخْبَرَہُ ، أَنَّہُ سَمِعَ عُقْبَۃَ بْنَ عَامِرٍ یَقُولُ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ تَوَضَّأَ فَأَتَمَّ وُضُوئَہُ ، ثُمَّ رَفَعَ رَأْسَہُ إِلَی السَّمَائِ فَقَالَ: أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ وَأَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، فُتِحَتْ لَہُ ثَمَانیَۃُ أَبْوَابٍ مِنَ الْجَنَّۃِ یَدْخُلُ مِنْ أَیِّہَا شَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 30516","","","كتاب الدعاء"
"30517","(۳۰۵۱۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ: کَانَ حُذَیْفَۃُ إذَا تَطَہَّرَ ، قَالَ: أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، اللَّہُمَّ اجْعَلْنِی مِنَ التَّوَّابِینَ وَاجْعَلْنِی مِنَ الْمُتَطَہِّرِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 30517","","","كتاب الدعاء"
"30518","(۳۰۵۱۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ صُہَیْبٍ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ: کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا دَخَلَ الْخَلائَ ، قَالَ: أَعُوذُ بِاللہِ مِنَ الْخُبْثِ وَالْخَبَائِثِ۔","Sahih","Musannaf Ibn Abi Shaybah 30518","","","كتاب الدعاء"
"30519","(۳۰۵۱۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَن قَتَادَۃَ ، عَن قَاسِمٍ الشَّیْبَانِیِّ ، عَن زَیْدِ بْنِ أَرْقَمَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إنَّ ہَذِہِ الْحُشُوشَ مُحْتَضِرَۃٌ ، فَإِذَا دَخَلَ أَحَدُکُمْ الخلاء فَلْیَقُلِ: اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْخُبْثِ وَالْخَبَائِثِ۔","","Musannaf Ibn Abi Shaybah 30519","","","كتاب الدعاء"
"30520","(۳۰۵۲۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُمَرَ ، قَالَ: حدَّثَنِی الْحَسَنُ بْنُ مُسْلِمِ بْنِ یَنَّاقَ ، عَن رَجُلٍ مِنْ أَصْحَابِ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، قَالَ: قَالَ عَبْدُ اللہِ: إذَا دَخَلْت الْغَائِطَ فَأَرَدْت التَّکَشُّفَ فَقُلِ: اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الرِّجْسِ وَالنَّجَسِ وَالْخُبْثِ وَالْخَبَائِثِ وَالشَّیْطَانِ الرَّجِیمِ۔","Da'if","Musannaf Ibn Abi Shaybah 30520","","","كتاب الدعاء"
"30521","(۳۰۵۲۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن جُوَیْبِرٍ ، عَنِ الضِّحَاکِ ، قَالَ: کَانَ حُذَیْفَۃُ إذَا دَخَلَ الْخَلائَ ، قَالَ: أَعُوذُ بِاللہِ مِنَ الشَّیْطَانِ الرَّجِیمِ الرِّجْسِ النَّجَسِ الْخَبِیثِ الْمُخَبَّثِ الشَّیْطَانِ الرَّجِیمِ۔","Da'if","Musannaf Ibn Abi Shaybah 30521","","","كتاب الدعاء"
"30522","(۳۰۵۲۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی طَلْحَۃَ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا دَخَلَ الْکَنِیفَ ، قَالَ: بِسْمِ اللہِ اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْخُبْثِ وَالْخَبَائِثِ۔","Da'if","Musannaf Ibn Abi Shaybah 30522","","","كتاب الدعاء"
"30523","(۳۰۵۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنِ الزِّبْرِقَانِ الْعَبْدِیِّ ، عَنِ الضَّحَّاکِ ، قَالَ: إذَا دَخَلْت الْخَلائَ فَقُلِ: اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الرِّجْسِ النَّجَسِ الْخَبِیثِ الْمُخْبِثِ الشَّیْطَانِ الرَّجِیمِ۔","","Musannaf Ibn Abi Shaybah 30523","","","كتاب الدعاء"
"30524","(۳۰۵۲۴) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ: حدَّثَنَا إسْرَائِیلُ ، قَالَ: أَخْبَرَنَا یُوسُفُ بْنُ أَبِی بُرْدَۃَ ، قَالَ: سَمِعْتُ أَبِی یَقُولُ: دَخَلْتُ عَلَی عَائِشَۃَ فَسَمِعْتہَا تَقُولُ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا خَرَجَ مِنَ الْغَائِطِ ، قَالَ: غُفْرَانَک۔","Sahih","Musannaf Ibn Abi Shaybah 30524","","","كتاب الدعاء"
"30525","(۳۰۵۲۵) حَدَّثَنَا ہُشَیْمُ بْنُ الْعَوَّامِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، أَنَّ نُوحًا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا فَرَغَ مِنَ الْغَائِطِ ، قَالَ: الْحَمْدُ لِلَّہِ الَّذِی أَذْہَبَ عَنِّی الأَذَی وَعَافَانِی۔","","Musannaf Ibn Abi Shaybah 30525","","","كتاب الدعاء"
"30526","(۳۰۵۲۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا عَوَّامٌ ، قَالَ: حُدِّثْت أَنَّ نُوحًا عَلَیْہِ السَّلامُ کَانَ یَقُولُ: الْحَمْدُ لِلَّہِ الَّذِی أَذَاقَنِی لَذَّتَہُ وَأَبْقَی فِی مَنْفَعَتَہُ وَأَذْہَبَ عَنِّی أَذَاہُ۔","","Musannaf Ibn Abi Shaybah 30526","","","كتاب الدعاء"
"30527","(۳۰۵۲۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، وَوَکِیعٌ ، عَن سُفْیَانَ ، عَن مَنْصُورٍ ، عَنْ أَبِی عَلِیٍّ ، أَنَّ أَبَا ذَرٍّ کَانَ یَقُولُ إذَا خَرَجَ مِنَ الْخَلائِ: الْحَمْدُ لِلَّہِ الَّذِی أَذْہَبَ عَنِّی الأَذَی وَعَافَانِی۔","Da'if","Musannaf Ibn Abi Shaybah 30527","","","كتاب الدعاء"
"30528","(۳۰۵۲۸) حَدَّثَنَا وَکِیعٌ، عَن زَمْعَۃَ، عَن سَلَمَۃَ بْنِ وَہْرَامٍ، عَن طَاوُوس، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إذَا خَرَجَ أَحَدُکُمْ مِنَ الْخَلائِ فَلْیَقُلَ الْحَمْدُ لِلَّہِ الَّذِی أَذْہَبَ عَنِّی مَا یُؤْذِینِی وَأَمْسَکَ عَلَیَّ مَا یَنْفَعُنِی۔","Da'if","Musannaf Ibn Abi Shaybah 30528","","","كتاب الدعاء"
"30529","(۳۰۵۲۹) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ: حدَّثَنَا ہُرَیْمٌ ، عَن لَیْثٍ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو ، قَالَ: کَانَ أَبُو الدَّرْدَائِ إذَا خَرَجَ مِنَ الْخَلائِ ، قَالَ: الْحَمْدُ لِلَّہِ الَّذِی أَمَاطَ عَنِّی الأَذَی وَعَافَانِی۔","Da'if","Musannaf Ibn Abi Shaybah 30529","","","كتاب الدعاء"
"30530","(۳۰۵۳۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ: کَانَ حُذَیْفَۃُ یَقُولُ إذَا خَرَجَ: الْحَمْدُ لِلَّہِ الَّذِی أَذْہَبَ عَنِّی الأَذَی وَعَافَانِی۔","Da'if","Musannaf Ibn Abi Shaybah 30530","","","كتاب الدعاء"
"30531","(۳۰۵۳۱) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ: حدَّثَنَا أَبُو عَقِیلٍ ، قَالَ: حَدَّثَنَا مُجَالِدٌ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ ، قَالَ: کَانَ ابْنُ مَسْعُودٍ إذَا اشْتَرَی مَمْلُوکًا ، قَالَ: اللَّہُمَّ بَارِکْ فِیہِ ،وَاجْعَلْہُ طَوِیلَ الْعُمُرِ کَثِیرَ الرِّزْقِ۔","Da'if","Musannaf Ibn Abi Shaybah 30531","","","كتاب الدعاء"
"30532","(۳۰۵۳۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ أَبِی شَیْبَۃَ ، قَالَ: حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الْمَقْبُرِیِّ ، عَنْ جَدِّہِ ، عَن أَبِی ہُرَیْرَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أَعْرِبُوا الْقُرْآنَ وَالْتَمِسُوا غَرَائِبَہُ۔ (ابویعلی ۶۵۲۹۔ احمد ۴۴۵)","Da'if","Musannaf Ibn Abi Shaybah 30532","","","كتاب فضائل القرآن"
"30533","(۳۰۵۳۳) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَن لَیْثٍ، عَن طَلْحَۃَ، عَنْ إِبْرَاہِیمَ، عَن عَلْقَمَۃَ، عَنْ عَبْدِ اللہِ، قَالَ: أَعْرِبُوا الْقُرْآنَ۔","Da'if","Musannaf Ibn Abi Shaybah 30533","","","كتاب فضائل القرآن"
"30534","(۳۰۵۳۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَن ثَوْرٍ ، عَنْ عُمَر بْنِ زَیْدٍ قَالَ: کَتَبَ عُمَرُ إِلَی أَبِی مُوسَی: أَمَّا بَعْدُ فَتَفَقَّہُوا فِی السُّنَّۃِ ،وَتَفَقَّہُوا فِی الْعَرَبِیَّۃِ ،وَأَعْرِبُوا الْقُرْآنَ فَإِنَّہُ عَرَبِیٌّ ،وَتَمَعْدَدُوا فَإِنَّکُمْ مَعْدِیُّونَ۔","Da'if","Musannaf Ibn Abi Shaybah 30534","","","كتاب فضائل القرآن"
"30535","(۳۰۵۳۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، قَالَ: حَدَّثَنَا وَاصِلٌ مَوْلَی أَبِی عُیَیْنَۃَ ، عَن یَحْیَی بْنِ عَقِیلٍ ، عَن یَحْیَی بْنِ یَعْمَُرَ ، عَن أُبَیِّ بْنِ کَعْبٍ ، قَالَ: تَعَلَّمُوا الْعَرَبِیَّۃَ کَمَا تَعَلَّمُونَ حِفْظَ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30535","","","كتاب فضائل القرآن"
"30536","(۳۰۵۳۶) حَدَّثَنَا مُعْتَمِرٌ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ: أَعْرِبُوا الْقُرْآنَ۔","Da'if","Musannaf Ibn Abi Shaybah 30536","","","كتاب فضائل القرآن"
"30537","(۳۰۵۳۷) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن عُقْبَۃَ الأَسَدِیِّ ، عَنْ أَبِی الْعَلائِ ، قَالَ: قَالَ عَبْدُ اللہِ: أَعْرِبُوا الْقُرْآنَ فَإِنَّہُ عَرَبِیٌّ۔","Da'if","Musannaf Ibn Abi Shaybah 30537","","","كتاب فضائل القرآن"
"30538","(۳۰۵۳۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَن یُوسُفَ بْنِ صُہَیْبٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَن رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: لأَنْ أَقْرَأَ الآیَۃَ بِإِعْرَابٍ أَحَبُّ إلَیَّ مِنْ أَنْ أَقْرَأَ کَذَا وَکَذَا آیَۃً بِغَیْرِ إعْرَابٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30538","","","كتاب فضائل القرآن"
"30539","(۳۰۵۳۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن عُبَیْدِ اللہِ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَضْرِبُ وَلَدَہُ عَلَی اللَّحْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 30539","","","كتاب فضائل القرآن"
"30540","(۳۰۵۴۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی مُوسَی ، قَالَ: قَالَ رَجُلٌ لِلْحَسَنِ: یَا أَبَا سَعِیدٍ ، وَاللہ مَا أَرَاک تَلْحَنُ ، فَقَالَ: یَا ابْنَ أَخِی ، إنِّی سَبَقْت اللَّحْنَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30540","","","كتاب فضائل القرآن"
"30541","(۳۰۵۴۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن عُمَرَ بْنِ حَمْزَۃَ ، قَالَ: أَخْبَرَنِی سَالِمٌ ، أَنَّ زَیْدَ بْنَ ثَابِتٍ اسْتَشَارَ عُمَرَ فِی جَمْعِ الْقُرْآنِ فَأَبِیَ عَلَیْہِ فَقَالَ: أَنْتُمْ قَوْمٌ تَلْحَنُونَ ، وَاسْتَشَارَ عُثْمَانَ فَأَذِنَ لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30541","","","كتاب فضائل القرآن"
"30542","(۳۰۵۴۲) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَن شُعْبَۃَ ، عَنْ أَبِی رَجَائٍ ، قَالَ: سَأَلْت مُحَمَّدًا عَن نَقْطِ الْمَصَاحِفِ فَقَالَ: أَخَافُ أَنْ تَزِیدُوا فِی الْحُرُوفِ ، أَوْ تُنْقِصُوا مِنْہَا ، وَسَأَلْت الْحَسَنَ فَقَالَ: أَمَا بَلَغَک مَا کَتَبَ بِہِ عُمَرُ أَنْ تَعَلَّمُوا الْعَرَبِیَّۃَ وَحُسْنَ الْعِبَادَۃِ وَتَفَقَّہوا فِی الدِّینِ۔","","Musannaf Ibn Abi Shaybah 30542","","","كتاب فضائل القرآن"
"30543","(۳۰۵۴۳) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَن مُعَاوِیَۃَ بْنِ یَحْیَی ، عَن یُونُسَ بْنِ مَیْسَرَۃَ الْجُبْلانِیِّ ، عَن أُمِّ الدَّرْدَائِ قَالَتْ: إنِّی لأحِبّ أَنْ أَقْرَأَہُ کَمَا أُنْزِلَ یَعْنِی إعْرَابَ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30543","","","كتاب فضائل القرآن"
"30544","(۳۰۵۴۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَن یَزِیدَ بْنِ حَازِمٍ ، عَن سُلَیْمَانَ بْنِ یَسَارٍ ، قَالَ: انْتَہَی عُمَرُ إِلَی قَوْمٍ یُقْرِئُ بَعْضُہُمْ بَعْضًا ، فَلَمَّا رَأَوْا عُمَرَ سَکَتُوا فَقَالَ: مَا کُنْتُمْ تُرَاجِعُونَ قُلْنَا: کان یُقْرِئُ بَعْضُنَا بَعْضًا ،فَقَالَ: اقْرَؤُوا ، وَلا تَلْحَنُوا۔","","Musannaf Ibn Abi Shaybah 30544","","","كتاب فضائل القرآن"
"30545","(۳۰۵۴۵) حَدَّثَنَا جَرِیرٌ ، عَن ثَعْلَبَۃَ ، عَن مُقَاتِلِ بْنِ حَیَّانَ ، قَالَ: کَلامُ أَہْلِ السَّمَائِ الْعَرَبِیَّۃُ ، ثُمَّ قَرَأَ: (حم وَالْکِتَابِ الْمُبِینِ إنَّا جَعَلْنَاہُ قُرْآنًا عَرَبِیًّا لَعَلَّکُمْ تَعْقِلُونَ ،وَإِنَّہُ فِی أُمِّ الْکِتَابِ لَدَیْنَا لَعَلِیٌّ حَکِیمٌ) ۔","No Data Available","Musannaf Ibn Abi Shaybah 30545","","","كتاب فضائل القرآن"
"30546","(۳۰۵۴۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَن مُوَرِّقٍ ، قَالَ: قَالَ عُمَرُ: تَعَلَّمُوا اللَّحْنَ وَالْفَرَائِضَ فَإِنَّہُ مِنْ دِینِکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 30546","","","كتاب فضائل القرآن"
"30547","(۳۰۵۴۷) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ ، قَالَ: حدَّثَنَا جَعْفَرٌ الأَحْمَرُ ، عَن مُطَرِّفٍ ، عَن سَوَادَۃَ بْنِ الْجَعْدِ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ: مِنْ فِقْہِ الرَّجُلِ عِرْفَانُہُ اللَّحْنَ۔","","Musannaf Ibn Abi Shaybah 30547","","","كتاب فضائل القرآن"
"30548","(۳۰۵۴۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَن خُلَیْدٍ الْعَصَرِیِّ ، قَالَ: لَمَّا قَدِمَ عَلَیْنَا سَلْمَانُ أَتَیْنَاہُ لیَسْتَقْرِئُنَا الْقُرْآنَ ،فَقَالَ: الْقُرْآنُ عَرَبِیٌّ فَاسْتَقْرِئُوہُ رَجُلاً عَرَبِیًّا ، فَاسْتَقْرَأْنَا زَیْدَ بْنَ صُوحَانَ ، فَکَانَ إذَا أَخْطَأَ أَخَذَ عَلَیْہِ سَلْمَانُ ، فَإِذَا أَصَابَ ، قَالَ: أَیْمُ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30548","","","كتاب فضائل القرآن"
"30549","(۳۰۵۴۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ: حَدَّثَنَا مَنْ کَانَ یُقْرِئُنَا مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُمْ کَانُوا یَقْتَرِئُونَ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَشْرَ آیَاتٍ ، وَلا یَأْخُذُونَ فِی الْعَشْرِ الأُخْرَی حَتَّی یَعْلَمُوا مَا فِی ہَذِہِ مِنَ الْعَمَلِ وَالْعِلْمِ ، قَالَ: فَعَلِمْنَا الْعَمَلَ وَالْعِلْمَ۔ (احمد ۴۱۰۔ ابن سعد ۱۷۲)","Da'if","Musannaf Ibn Abi Shaybah 30549","","","كتاب فضائل القرآن"
"30550","(۳۰۵۵۰) حَدَّثَنَا وَکِیعٌ ، عَن خَالِدِ بْنِ دِینَارٍ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ: تَعَلَّمُوا الْقُرْآنَ خَمْسَ آیَاتٍ خَمْسَ آیَاتٍ ، فَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَأْخُذُہُ خَمْسًا خَمْسًا۔ (بیہقی ۱۹۵۸)","","Musannaf Ibn Abi Shaybah 30550","","","كتاب فضائل القرآن"
"30551","(۳۰۵۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، قَالَ: کَانَ أَبُو عَبْدِ الرَّحْمَنِ یُعَلِّمُنَا خَمْسًا خَمْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 30551","","","كتاب فضائل القرآن"
"30552","(۳۰۵۵۲) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبْجَرَ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو ، عَن قَیْسِ بْنِ سَکَنٍ ، قَالَ: قَالَ عَبْدُ اللہِ: تَعَلَّمُوا الْقُرْآنَ فَإِنَّہُ یُکْتَبُ بِکُلِّ حَرْفٍ مِنْہُ عَشْرُ حَسَنَاتٍ وَیُکَفَّرُ بِہِ عَشْرُ سَیِّئَاتٍ ، أَمَا إنِّی لاَ أَقُولُ: (الم) وَلَکِنْ أَقُولُ: أَلِفٌ عَشْرٌ وَلامٌ عَشْرٌ وَمِیمٌ عَشْرٌ۔ (حاکم ۵۵۵)","Sahih","Musannaf Ibn Abi Shaybah 30552","","","كتاب فضائل القرآن"
"30553","(۳۰۵۵۳) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ: حدَّثَنَا مُحَمَّدُ بْنُ کَعْبٍ ، عَنْ عَوْفِ بْنِ مَالِکٍ الأَشْجَعِیِّ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ قَرَأَ حَرْفًا مِنْ کِتَابِ اللہِ کُتِبَ لَہُ حَسَنَۃ ، لاَ أَقُولُ: {الم ذَلِکَ الْکِتَابُ} وَلَکِنَّ الْحُرُوفَ مُقَطَّعَۃٌ عَنِ الأَلِفِ وَاللامِ وَالْمِیمِ۔ (بزار ۲۳۲۳۔ طبرانی ۳۱۶)","Da'if","Musannaf Ibn Abi Shaybah 30553","","","كتاب فضائل القرآن"
"30554","(۳۰۵۵۴) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنْ أَبِی الأَحْوَصِ، عَنْ عَبْدِاللہِ، قَالَ: تَعَلَّمُوا الْقُرْآنَ وَاتْلُوہُ فَإِنَّ اللَّہَ یَأْجُرُکُمْ عَلَی تِلاوَتِہِ بِکُلِّ حَرْفٍ عَشْرَ حَسَنَاتٍ ، أَمَا إنِّی لاَ أَقُولُ: (الم) وَلَکِنْ أَلِفٌ وَلامٌ وَمِیمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 30554","","","كتاب فضائل القرآن"
"30555","(۳۰۵۵۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ: حدَّثَنَا مِسْعَرٌ ، عَن سُلَیْمَانَ الضَّبِّیِّ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، أَو الأَسْوَدِ ، عَنْ عَبْدِ اللہِ ، قَالَ: مَنْ قَرَأَ الْقُرْآنَ یَبْتَغِی بِہِ وَجْہَ اللہِ کَانَ لَہُ بِکُلِّ حَرْفٍ عَشْرُ حَسَنَاتٍ وَمَحْوُ عَشْرِ سَیِّئَاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30555","","","كتاب فضائل القرآن"
"30556","(۳۰۵۵۶) حَدَّثَنَا حفص بْنُ غِیَاثٍ ، وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَن طَلْحَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَۃَ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: زَیِّنُوا الْقُرْآنَ بِأَصْوَاتِکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 30556","","","كتاب فضائل القرآن"
"30557","(۳۰۵۵۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: دَخَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَسْجِدَ فَسَمِعَ قِرَائَۃَ رَجُلٍ فَقَالَ: مَنْ ہَذَا ؟ فقیل عَبْدُ اللہِ بْنُ قَیْسٍ ، فَقَالَ: لَقَدْ أُوتِیَ ہَذَا مِنْ مَزَامِیر آلِ دَاوُد۔ (احمد ۳۵۴۔ نسائی ۱۰۹۲)","Hasan","Musannaf Ibn Abi Shaybah 30557","","","كتاب فضائل القرآن"
"30558","(۳۰۵۵۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَن مَالِکِ بْنِ مِغْوَلٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لَقَدْ أُوتِیَ الأَشْعَرِیُّ مِزْمَارًا مِنْ مَزَامِیرِ آلِ دَاوُد۔ (بخاری ۱۰۸۷۔ مسلم ۵۴۶)","Sahih","Musannaf Ibn Abi Shaybah 30558","","","كتاب فضائل القرآن"
"30559","(۳۰۵۵۹) حَدَّثَنَا شَبَابَۃُ ، عَن لَیْثِ بْنِ سَعْدٍ ، عَنِ ابْنِ شِہَابٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ کَعْبِ بْنِ مَالِکٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لأَبِی مُوسَی وَسَمِعَہُ یَقْرَأُ الْقُرْآنَ: لَقَدْ أُوتِیَ أَخُوکُمْ مِنْ مَزَامِیرِ آلِ دَاوُد۔","","Musannaf Ibn Abi Shaybah 30559","","","كتاب فضائل القرآن"
"30560","(۳۰۵۶۰) حَدَّثَنَا أَبُو بَکْرٍ ،بَلَغَنِی عَنِ ابْنِ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَن عُرْوَۃَ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ ، أَوْ نَحْوِہِ۔ (دارمی ۱۴۸۹۔ احمد ۱۶۷)","","Musannaf Ibn Abi Shaybah 30560","","","كتاب فضائل القرآن"
"30561","(۳۰۵۶۱) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ أَبِی حَنِیفَۃَ، عَن حَمَّادٍ، عَنْ إبْرَاہِیمَ، قَالَ: قَالَ عُمَرُ: حَسِّنُوا أَصْوَاتَکُمْ بِالْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30561","","","كتاب فضائل القرآن"
"30562","(۳۰۵۶۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی نَہِیکٍ ، عَن سَعْدٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لَیْسَ مِنَّا مَنْ لَمْ یَتَغَنَّ بِالْقُرْآنِ۔","Sahih","Musannaf Ibn Abi Shaybah 30562","","","كتاب فضائل القرآن"
"30563","(۳۰۵۶۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَمْرٍو، عَنْ أَبِی سَلَمَۃَ رِوَایَۃً، قَالَ: مَا أَذِنَ اللَّہُ لِشَیْئٍ کَإِذْنِہِ لِعَبْدٍ یَتَرَنَّمُ بِالْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30563","","","كتاب فضائل القرآن"
"30564","(۳۰۵۶۴) حَدَّثَنَا حَفْصٌ ، عَن لَیْثٍ ، عَن طَاوُوس ، قَالَ: کَانَ یُقَالُ: أَحْسَنُ النَّاسِ صَوْتًا بِالْقُرْآنِ أَخْشَاہُمْ لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 30564","","","كتاب فضائل القرآن"
"30565","(۳۰۵۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَن طَاووس ،سُئِلَ مَنْ أَقْرَأُ النَّاسِ ؟ قَالَ: مَنْ إذَا قَرَأَ رَأَیْتہ یَخْشَی اللَّہَ ، قَالَ: وَکَانَ طَلْقٌ مِنْ أُولَئِکَ۔","","Musannaf Ibn Abi Shaybah 30565","","","كتاب فضائل القرآن"
"30566","(۳۰۵۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی الضُّحَی ، عَن مَسْرُوقٍ ، قَالَ: کُنَّا مَعَ أَبِی مُوسَی فَجنَّنَا اللَّیْلَ إِلَی بُسْتَانٍ خَرِبٍ ، قَالَ: فَقَامَ مِنَ اللَّیْلِ فَقَرَأَ قِرَائَۃً حَسَنَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 30566","","","كتاب فضائل القرآن"
"30567","(۳۰۵۶۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن ثَابِتٍ ، عَنْ أَنَسٍ ، أَنَّ أَبَا مُوسَی کَانَ یَقْرَأُ ذَاتَ لَیْلَۃٍ ، وَنِسَائُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْتَمِعْنَ فَقِیلَ لَہُ ، فَقَالَ: لَوْ عَلِمْت لَحَبَّرْت تَحْبِیرًا ، أَوْ لَشَوَّقْت تَشْوِیقًا۔","Sahih","Musannaf Ibn Abi Shaybah 30567","","","كتاب فضائل القرآن"
"30568","(۳۰۵۶۸) حَدَّثَنَا عَفَّان ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ: أَخْبَرَنَا عِمْرَانُ بْنُ عَبْدِ اللہِ بْنِ طَلْحَۃَ ، أَنَّ رَجُلاً قَرَأَ فِی مَسْجِدِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی رَمَضَانَ فَطَرَّبَ فَأَنْکَرَ ذَلِکَ الْقَاسِمُ ، وَقَالَ یَقُولُ اللَّہُ تَعَالَی: {وَإِنَّہُ لَکِتَابٌ عَزِیزٌ لاَ یَأْتِیہِ الْبَاطِلُ مِنْ بَیْنِ یَدَیْہِ وَلا مِنْ خَلْفِہِ تَنْزِیلٌ مِنْ حَکِیمٍ حَمِیدٍ}۔","","Musannaf Ibn Abi Shaybah 30568","","","كتاب فضائل القرآن"
"30569","(۳۰۵۶۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، أَنَّ رَجُلاً قَرَأَ عِنْدَ أَنَسٍ فَطَرَّبَ فَکَرِہَ ذَلِکَ أَنَسٌ۔","","Musannaf Ibn Abi Shaybah 30569","","","كتاب فضائل القرآن"
"30570","(۳۰۵۷۰) حَدَّثَنَا عَفَّان ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ: أَخْبَرَنَا عُبَیْدُ اللہِ بْنُ أَبِی بَکْرٍ ، أَنَّ زِیَادًا النُّمَیْرِیَّ جَائَ مَعَ الْقُرَّائِ إِلَی أَنَسِ بْنِ مَالِکٍ فقیل لَہُ: اقْرَأْ ، فَرَفَعَ صَوْتَہُ ، وَکَانَ رَفِیعَ الصَّوْتِ ، فَکَشَفَ أَنَسٌ عَن وَجْہِہِ الْخِرْقَۃَ ، وَکَانَ عَلَی وَجْہِہِ خِرْقَۃٌ سَوْدَائُ ،فَقَالَ: مَا ہَذَا ؟ مَا ہَکَذَا کَانُوا یَفْعَلُونَ ، وَکَانَ إذَا رَأَی شَیْئًا یُنْکِرُہُ کَشَفَ الْخِرْقَۃَ عَن وَجْہِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30570","","","كتاب فضائل القرآن"
"30571","(۳۰۵۷۱) حَدَّثَنَا جَرِیرٌ ، عَن لَیْثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ: کَانَ أَحَدُہُمْ یَمُدُّ بِالآیَۃِ فِی جَوْفِ اللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 30571","","","كتاب فضائل القرآن"
"30572","(۳۰۵۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ السَّدُوسِیُّ ، عَن مِعْفَسِ بْنِ عِمْرَانَ ، عَن أُمِّ الدَّرْدَائِ قَالَتْ: دَخَلْتُ عَلَی عَائِشَۃَ ، فَقُلْتُ: مَا فَضْلُ مَنْ قَرَأَ الْقُرْآنَ عَلَی مَنْ لَمْ یَقْرَأْہُ مِمَّنْ دَخَلَ الْجَنَّۃَ ، فَقَالَتْ عَائِشَۃُ: إنَّ عَدَدَ دَرَجِ الْجَنَّۃِ عَلَی عَدَدِ آیِ الْقُرْآنِ ، فَلَیْسَ أَحَدٌ مِمَّنْ دَخَلَ الْجَنَّۃَ أَفْضَلَ مِمَّنْ قَرَأَ الْقُرْآنَ۔","Da'if","Musannaf Ibn Abi Shaybah 30572","","","كتاب فضائل القرآن"
"30573","(۳۰۵۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا إسْمَاعِیلُ بْنُ رَافِعٍ ، عَن رَجُلٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ: مَنْ قَرَأَ الْقُرْآنَ فَکَأَنَّمَا اسْتُدْرِجَتِ النُّبُوَّۃُ بَیْنَ جَنْبَیْہِ إِلاَّ أَنَّہُ لاَ یُوحَی إلَیْہِ۔ (حاکم ۵۵۲)","Da'if","Musannaf Ibn Abi Shaybah 30573","","","كتاب فضائل القرآن"
"30574","(۳۰۵۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا عِمْرَانُ أَبُو بِشْرٍ الْحَلَبِیُّ ، عَنِ الْحَسَنِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ فَاقَۃَ لِعَبْدٍ یَقْرَأُ الْقُرْآنَ ، وَلا غِنَی لَہُ بَعْدَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30574","","","كتاب فضائل القرآن"
"30575","(۳۰۵۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِیہِ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: مَنْ قَرَأَ الْقُرْآنَ وَاتَّبَعَ مَا فِیہِ ،ہَدَاہُ اللَّہُ مِنَ الضَّلالَۃِ ،وَوَقَاہُ یَوْمَ الْقِیَامَۃِ سُوئَ الْحِسَابِ ، وَذَلِکَ بِأَنَّ اللَّہَ یَقُولُ: {فَمَنَ اتَّبَعَ ہُدَایَ فَلا یَضِلُّ وَلا یَشْقَی}۔","Da'if","Musannaf Ibn Abi Shaybah 30575","","","كتاب فضائل القرآن"
"30576","(۳۰۵۷۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن عمرو بن قیس عن عکرمۃ عن ابن عباس قَالَ: ضَمِنَ اللَّہُ لمن قَرَأَ الْقُرْآنَ أَلاَّ یَضِلَّ فِی الدُّنْیَا وَلا یَشْقَی فِی الآخِرَۃِ ثم تلا: {فَمَنَ اتَّبَعَ ہُدَایَ فَلا یَضِلُّ وَلا یَشْقَی}۔","Hasan","Musannaf Ibn Abi Shaybah 30576","","","كتاب فضائل القرآن"
"30577","(۳۰۵۷۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْحَکَمِ بْنِ ہِشَامٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ: کَانَ یُقَالُ: إنَّ أَبْقَی النَّاسِ عُقُولاً قَرَأَۃُ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30577","","","كتاب فضائل القرآن"
"30578","(۳۰۵۷۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَاصِمٍ ، عَن عِکْرِمَۃَ ، قَالَ: مَنْ قَرَأَ الْقُرْآنَ لَمْ یُرَدَّ إِلَی أَرْذَلِ الْعُمُرِ ، ثُمَّ قَرَأَ: {لِکَیْ لاَ یَعْلَمَ بَعْدَ عِلْمٍ شَیْئًا}۔","","Musannaf Ibn Abi Shaybah 30578","","","كتاب فضائل القرآن"
"30579","(۳۰۵۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَن مُحَمَّدِ بْنِ کَعْبٍ ، قَالَ: مَنْ قَرَأَ الْقُرْآنَ فَکَأَنَّمَا رَأَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ قَرَأَ: {وَمَنْ بَلَغَ أَئِنَّکُمْ لَتَشْہَدُونَ}۔","","Musannaf Ibn Abi Shaybah 30579","","","كتاب فضائل القرآن"
"30580","(۳۰۵۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ یَزِیدَ ، عَنِ الزُّہْرِیِّ ، عَن مُعَاذِ بْنِ جَبَلٍ ، قَالَ: مَنِ اسْتَظْہَرَ الْقُرْآنَ کَانَتْ لَہُ دَعْوَۃٌ إِنْ شَائَ یُعَجِّلُہَا لِدُنْیَا ، وَإِنْ شَائَ لآخِرَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 30580","","","كتاب فضائل القرآن"
"30581","(۳۰۵۸۱) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، قَالَ: أَخْبَرَنَا إبْرَاہِیمُ بْنُ إسْمَاعِیلَ الأَنْصَارِیُّ ، قَالَ: أَخْبَرَنَا ابْنُ شِہَابٍ ، عَن عُبَیْدِ بْنِ السَّبَّاقِ ، أَنَّ عُثْمَانَ ، قَالَ: إنَّمَا نَزَلَ بِلِسَانِ قُرَیْشٍ یَعْنِی الْقُرْآنَ۔","Da'if","Musannaf Ibn Abi Shaybah 30581","","","كتاب فضائل القرآن"
"30582","(۳۰۵۸۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ: حدَّثَنَا سَلَمَۃ بْن نُبَیْطٍ ، عَنِ الضَّحَّاکِ ، قَالَ: نَزَلَ الْقُرْآنُ بِکُلِّ لِسَانٍ۔","","Musannaf Ibn Abi Shaybah 30582","","","كتاب فضائل القرآن"
"30583","(۳۰۵۸۳) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی مَیْسَرَۃَ ، قَالَ: نَزَلَ الْقُرْآنُ بِکُلِّ لِسَانٍ۔","","Musannaf Ibn Abi Shaybah 30583","","","كتاب فضائل القرآن"
"30584","(۳۰۵۸۴) حَدَّثَنَا زَیْدِ بْنِ الْحُبَابِ، عَن سیف، قَالَ: سَمِعْتُ مُجَاہِدًا یَقُولُ: نَزَلَ الْقُرْآنُ بِلِسَانِ قُرَیْشٍ، وَبِہِ کَلامُہُمْ۔","","Musannaf Ibn Abi Shaybah 30584","","","كتاب فضائل القرآن"
"30585","(۳۰۵۸۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ: {الْمَاعُونُ} بِلِسَانِ قُرَیْشٍ: الْمَالُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30585","","","كتاب فضائل القرآن"
"30586","(۳۰۵۸۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ، عَنْ جَرِیرِ بْنِ حَازِمٍ، عَن عِکْرِمَۃَ بْنِ خَالِدٍ، قَالَ: نَزَلَ الْقُرْآنُ بِلِسَانِنَا یَعْنِی قُرَیْش۔","","Musannaf Ibn Abi Shaybah 30586","","","كتاب فضائل القرآن"
"30587","(۳۰۵۸۷) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَن حُسَیْنِ بْنِ وَاقِدٍ ، عَنِ ابْنِ بُرَیْدَۃَ: أَنَّ لِسَانَ جُرْہُمٍ کَانَ عَرَبِیًّا۔","","Musannaf Ibn Abi Shaybah 30587","","","كتاب فضائل القرآن"
"30588","(۳۰۵۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَن سَعدِ بْنِ عِیَاضٍ: { کَمِشْکَاۃٍ } قَالَ: کَکُوَّۃٍ بِلِسَانِ الْحَبَشَۃِ۔","","Musannaf Ibn Abi Shaybah 30588","","","كتاب فضائل القرآن"
"30589","(۳۰۵۸۹) حَدَّثَنَا وَکِیعٌ ، عَن عُمَرَ بْنِ أَبِی زَائِدَۃَ ، عَن عِکْرِمَۃَ ، قَالَ: (طَہ) بِالْحَبَشِیَّۃِ: یَا رَجُلُ۔","","Musannaf Ibn Abi Shaybah 30589","","","كتاب فضائل القرآن"
"30590","(۳۰۵۹۰) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ أَبِی إِسْحَاقَ، عَن سَعِیدِ بْنِ جّبَیر قَالَ: ہُوَ بِلِسَانِ الْحَبَشَۃِ: إذا قام نشأ۔","","Musannaf Ibn Abi Shaybah 30590","","","كتاب فضائل القرآن"
"30591","(۳۰۵۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ أَبِی مُوسَی {یُؤْتِکُمْ کِفْلَیْنِ مِنْ رَحْمَتِہِ} قَالَ: أَجْرَیْنِ بِلِسَانِ الْحَبَشَۃِ۔","","Musannaf Ibn Abi Shaybah 30591","","","كتاب فضائل القرآن"
"30592","(۳۰۵۹۲) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی سِنَانٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ ، عَنْ عَبْدِ اللہِ {إنَّ نَاشِئَۃَ اللَّیْلِ} قَالَ: ہُوَ بالْحَبَشَۃِ قِیَامُ اللَّیْلِ۔","Hasan","Musannaf Ibn Abi Shaybah 30592","","","كتاب فضائل القرآن"
"30593","(۳۰۵۹۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ جَابِرٍ ، عَن مُجَاہِدٍ فِی قَوْلِہِ: {وَزِنُوا بِالْقِسْطَاسِ الْمُسْتَقِیمِ} قَالَ: الْعَدْلُ بِالرُّومِیَّۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30593","","","كتاب فضائل القرآن"
"30594","(۳۰۵۹۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن عِکْرِمَۃَ {وَأَنْتُمْ سَامِدُونَ} قَالَ: ہُوَ الْغِنَائُ بِالْحِمْیَرِیَّۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30594","","","كتاب فضائل القرآن"
"30595","(۳۰۵۹۵) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَن مُجَاہِدٍ ، قَالَ: {الْقِسْطَاسُ} الْعَدْلُ بِالرُّومِیَّۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30595","","","كتاب فضائل القرآن"
"30596","(۳۰۵۹۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن سَالِمٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ: (طَہ) بِالنَّبَطِیَّۃِ: ایطہ یَا رَجُلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30596","","","كتاب فضائل القرآن"
"30597","(۳۰۵۹۷) حَدَّثَنَا وَکِیعٌ ، عَن قُرَّۃَ بْنِ خَالِدٍ ، عَنِ الضَّحَّاک ، قَالَ: (طَہ) یَا رَجُلُ بِالنَّبَطِیَّۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30597","","","كتاب فضائل القرآن"
"30598","(۳۰۵۹۸) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن خُصَیْفٍ ، عَن عِکْرِمَۃَ ، قَالَ: (طَہ) یَا رَجُلُ بِالنَّبَطِیَّۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30598","","","كتاب فضائل القرآن"
"30599","(۳۰۵۹۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن سَلَمَۃَ بْنِ سَابُورَ ، عَنْ عَطِیَّۃَ عَنِ ابْنِ عَبَّاسٍ: {ہَیْتَ لَک} قَالَ: ہِیَ بِالنَّبَطِیَّۃِ: ہَلُمَّ لَک۔","Da'if","Musannaf Ibn Abi Shaybah 30599","","","كتاب فضائل القرآن"
"30600","(۳۰۶۰۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ {حِجَارَۃً مِنْ سِجِّیلٍ} قَالَ: ہِیَ بِالْفَارِسِیَّۃِ سنْک ، وَکِلْ حَجَرٍ وَطِینٍ۔","Hasan","Musannaf Ibn Abi Shaybah 30600","","","كتاب فضائل القرآن"
"30601","(۳۰۶۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنِ ابْنِ سَابِطٍ {حِجَارَۃً مِنْ سِجِّیلٍ} قَالَ: ہِیَ بِالْفَارِسِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 30601","","","كتاب فضائل القرآن"
"30602","(۳۰۶۰۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَن مُسْلِمٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ {یَوَدُّ أَحَدُہُمْ لَوْ یُعَمَّرُ أَلْفَ سَنَۃٍ} قَالَ: ہُوَ کَقَوْلِ الأَعَاجِمِ زہر ہَزَارُسَالَ ،أَیْ عِشْ أَلْف سَنَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30602","","","كتاب فضائل القرآن"
"30603","(۳۰۶۰۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ جَعْفَرٍ ، عَنِ الْقَاسِمِ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ: إنَّ الْمَلائِکَۃَ الَّذِینَ یَحْمِلُونَ الْعَرْشَ یَتَکَلَّمُونَ الْفَارِسِیَّۃِ الدُّرِّیِّۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 30603","","","كتاب فضائل القرآن"
"30604","(۳۰۶۰۴) حَدَّثَنَا جَرِیرٌ ، عَن بَیَانٍ ، عَنِ الشَّعْبِیِّ ، قَالَ: کَلامُ النَّاسِ یَوْمَ الْقِیَامَۃِ السُّرْیَانِیَّۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30604","","","كتاب فضائل القرآن"
"30605","(۳۰۶۰۵) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَن مِسْمَعِ بْنِ مَالِکٍ ، قَالَ: سَمِعْتُ عِکْرِمَۃَ ، قَالَ: کَانَ ابْنُ عَبَّاسٍ إذَا سُئِلَ عَن الشَّیْئِ مِنَ الْقُرْآنِ أَنْشَدَ أشْعَارًا مِنْ أَشْعَارِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 30605","","","كتاب فضائل القرآن"
"30606","(۳۰۶۰۶) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَن قَتَادَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: مَا کُنْت أَدْرِی مَا قَوْلُہُ: {رَبَّنَا افْتَحْ بَیْنَنَا وَبَیْنَ قَوْمِنَا بِالْحَقِّ} حَتَّی سَمِعْت بِنْتَ ذِی یَزِنَ تَقُولُ: تَعَالَ أُفَاتِحْک۔","Sahih","Musannaf Ibn Abi Shaybah 30606","","","كتاب فضائل القرآن"
"30607","(۳۰۶۰۷) حَدَّثَنَا شَرِیکٌ ، عَن بَیَانٍ ، عَنْ عَامِرٍ {فَإِذَا ہُمْ بِالسَّاہِرَۃِ} قَالَ: بِالأَرْضِ ، ثُمَّ أَنْشَدَ أَبْیَاتًا لأُمَیَّۃِ: وَفِیہَا لَحْمُ سَاہِرَۃٍ وَبَحْرٍ۔","","Musannaf Ibn Abi Shaybah 30607","","","كتاب فضائل القرآن"
"30608","(۳۰۶۰۸) حَدَّثَنَا شَرِیکٌ ، عَن فُرَاتٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ: الْقَانِعَ السَّائِلَ ، ثُمَّ أَنْشَدَ أَبْیَاتًا لِلشَمَّاخ: nلَمَالُ الْمَرْئِ یُصْلِحُہُ فَیُغْنِی مَفَاقِرَہُ أَعَفُّ مِنَ الْقَنُوعِ","","Musannaf Ibn Abi Shaybah 30608","","","كتاب فضائل القرآن"
"30609","(۳۰۶۰۹) حَدَّثَنَا وَکِیعٌ ، عَن ثَابِتَ بْنِ أَبِی صَفِیَّۃَ ، عَن شَیْخٍ یُکَنَّی أَبَا عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: الزَّنِیمُ اللَّئِیمُ الْمُلَزَّقُ ، ثُمَّ أَنْشَدَ ہَذَا الْبَیْتَ: nزَنِیمٌ تَدَاعَاہُ الرِّجَالُ زِیَادَۃً کَمَا زِیدَ فِی عَرْضِ الأَدِیمِ الأَکَارِعُ","Da'if","Musannaf Ibn Abi Shaybah 30609","","","كتاب فضائل القرآن"
"30610","(۳۰۶۱۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَبِی المعلی ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ یَقْرَأُ: (دَرَسْتَ) ، وَیَتَمَثَّلُ: دَارِسٌ کَطَعْمِ الصَّابِّ وَالْعَلْقَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 30610","","","كتاب فضائل القرآن"
"30611","(۳۰۶۱۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الکَہْفِ ، عَنْ أَبِیہِ {فَمِنْہُمْ مَنْ قَضَی نَحْبَہُ} قَالَ: نَذَرہ ، وَقَالَ الشَّاعِرُ: قَضَتْ مِنْ یَثْرِب نَحْبَہَا فَاسْتَمَرَّتْ۔","","Musannaf Ibn Abi Shaybah 30611","","","كتاب فضائل القرآن"
"30612","(۳۰۶۱۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن عُبَیْدِ اللہِ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَثَلُ الْقُرْآنِ مَثَلُ الإِبِلِ الْمَعْقُولَۃِ ،إِنْ عَقَلَہَا صَاحِبُہَا أَمْسَکَہَا ، وَإِنْ تَرَکَہَا ذَہَبَتْ۔","Hasan","Musannaf Ibn Abi Shaybah 30612","","","كتاب فضائل القرآن"
"30613","(۳۰۶۱۳) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَن مُوسَی بْنِ عُلَیٍّ ، قَالَ: سَمِعْتُ أَبِی یَقُولُ: ، قَالَ: سَمِعْتُ عُقْبَۃَ بْنَ عَامِرٍ یَقُولُ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: تَعَلَّمُوا الْقُرْآنَ وَاقْتَنُوہُ وَالَّذِی نَفْسِی بِیَدِہِ لَہُوَ أَشَدُّ تَفَصِّیًا مِنَ الْمَخَاضِ مِنْ عُقُلِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 30613","","","كتاب فضائل القرآن"
"30614","(۳۰۶۱۴) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَن بُرَیْدِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: تَعَاہَدُوا الْقُرْآنَ فَوَالَّذِی نَفْسِی بِیَدِہِ لَہُوَ أَشَدُّ تَفَصِّیًا مِنْ قُلُوبِ الرِّجَالِ مِنَ الإِبِلِ مِنْ عُقُلِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 30614","","","كتاب فضائل القرآن"
"30615","(۳۰۶۱۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن شَقِیقٍ ، قَالَ: قَالَ عَبْدُ اللہِ: تَعَاہَدُوا ہَذِہِ الْمَصَاحِفَ وَرُبَّمَا قَالَ: الْقُرْآنَ فَلَہُوَ أَشَدُّ تَفَصِّیًا مِنْ قُلُوبِ الرِّجَالِ مِنَ النَّعَمِ مِنْ عُقُلِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 30615","","","كتاب فضائل القرآن"
"30616","(۳۰۶۱۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَن مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ: قَالَ عَبْدُ اللہِ: تَعَاہَدُوا ہَذَا الْقُرْآنَ فَلَہُوَ أَشَدُّ تَفَصِّیًا مِنَ النَّعَمِ مِنْ عُقُلِہِ ، قَالَ: وَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: بِئْسَ مَا لأَحَدِہِمْ أَنْ یَقُولَ: نَسِیت آیَۃَ کَیْتَ وَکَیْتَ بَلْ ہُوَ نُسِّیَ۔ (بخاری ۵۰۳۲۔ ترمذی ۲۹۴۲)","Sahih","Musannaf Ibn Abi Shaybah 30616","","","كتاب فضائل القرآن"
"30617","(۳۰۶۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَن عِیسَی بْنِ فَائِدٍ ، قَالَ: حدَّثَنِی فُلانٌ ، عَن سَعْدِ بْنِ عُبَادَۃَ ، قَالَ: حَدَّثَنِیہِ ، عَن رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَا مِنْ أَحَدٍ یَقْرَأُ الْقُرْآنَ ، ثُمَّ یَنْسَاہُ إِلاَّ لَقِیَ اللَّہَ وَہُوَ أَجْذَمُ۔ (احمد ۲۸۴۔ طبرانی ۵۳۸۷)","Da'if","Musannaf Ibn Abi Shaybah 30617","","","كتاب فضائل القرآن"
"30618","(۳۰۶۱۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی رَوَّاد ، عَنِ الضَّحَّاکِ ، قَالَ: مَا تَعَلَّمَ رَجُلٌ الْقُرْآنَ ، ثُمَّ نَسِیَہُ إِلاَّ بِذَنْبٍ ، ثُمَّ قَرَأَ الضَّحَّاکُ: {وَمَا أَصَابَکُمْ مِنْ مُصِیبَۃٍ فَبِمَا کَسَبَتْ أَیْدِیکُمْ} ثُمَّ قَالَ الضَّحَّاکُ: وَأَیُّ مُصِیبَۃٍ أَعْظَمُ مِنْ نِسْیَانِ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30618","","","كتاب فضائل القرآن"
"30619","(۳۰۶۱۹) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ أَبِی أُمَیَّۃَ ، عَن طَلْقِ بْنِ حَبِیبٍ ، قَالَ: مَنْ تَعَلَّمَ الْقُرْآنَ ، ثُمَّ نَسِیَہُ مِنْ غَیْرِ عُذْرٍ حُطَّ عَنْہُ بِکُلِّ آیَۃٍ دَرَجَۃٌ ، وَجَائَ یَوْمَ الْقِیَامَۃِ مَخْصُومًا۔","","Musannaf Ibn Abi Shaybah 30619","","","كتاب فضائل القرآن"
"30620","(۳۰۶۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ یَزِیدَ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ اللہِ بْنِ أَبِی مُغِیثٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: عُرِضَتْ عَلَیَّ الذُّنُوبُ فَلَمْ أَرَ فِیہَا شَیْئًا أَعْظَمَ مِنْ حَامِلِ الْقُرْآنِ وَتَارِکِہِ۔ (ابوداؤد ۴۶۲۔ ترمذی ۲۹۱۶)","Da'if","Musannaf Ibn Abi Shaybah 30620","","","كتاب فضائل القرآن"
"30621","(۳۰۶۲۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن وَاقِدٍ ، عَن زَاذَانَ ، قَالَ: مَنْ قَرَأَ الْقُرْآنَ لِیَتَأَکَّلَ بِہِ النَّاسَ لَقِیَ اللَّہَ وَلَیْسَ عَلَی وَجْہِہِ مُزْعَۃُ لَحْمٍ۔","","Musannaf Ibn Abi Shaybah 30621","","","كتاب فضائل القرآن"
"30622","(۳۰۶۲۲) حَدَّثَنَا وَکِیعٌ ، عَن یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، قَالَ: قَالَ عُمَرُ: اقَرَؤُوا الْقُرْآنَ وَاسْأَلُوا اللَّہَ بِہِ ،قَبْلَ أَنْ یَقْرَأَہ قَوْمٌ یَسْأَلُونَ النَّاسَ بِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 30622","","","كتاب فضائل القرآن"
"30623","(۳۰۶۲۳) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ الْجَرِیرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی فِرَاسٍ ، قَالَ: قَالَ عُمَرُ: قَدْ أَتَی عَلَیَّ زَمَانٌ وَأَنَا أَحْسِبُ مَنْ قَرَأَ الْقُرْآنَ یُرِیدُ بِہِ اللہ ، فَقَدْ خُیِّلَ لِی الآنَ بِأَخَرِۃٍ أَنِّی أَرَی قَوْمًا قَدْ قَرَؤُوہُ یُرِیدُونَ بِہِ النَّاسَ ، فَأَرِیدُوا اللَّہَ بِقِرَائَتِکُمْ ،وَأَرِیدُوا اللَّہَ بِأَعْمَالِکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 30623","","","كتاب فضائل القرآن"
"30624","(۳۰۶۲۴) حَدَّثَنَا الزُّبَیْرِیُّ مُحَمَّدُ بْنُ عَبْدِ اللہِ ، عَن سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَن خَیْثَمَۃَ ، عَنِ الْحَسَنِ ، عَن عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ: سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: مَنْ قَرَأَ الْقُرْآنَ فَلْیَسْأَلَ اللَّہَ بِہِ ،فَإِنَّہُ سَیَجِیئُ قَوْمٌ یَقْرَؤُونَ الْقُرْآنَ یَسْأَلُونَ النَّاسَ بِہِ۔ (ترمذی ۲۹۱۷۔ احمد ۴۳۹)","Da'if","Musannaf Ibn Abi Shaybah 30624","","","كتاب فضائل القرآن"
"30625","(۳۰۶۲۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ: قَالَ عُمَرُ: اقَرَؤُوا الْقُرْآنَ وَاطْلُبُوا بِہِ مَا عِنْدَ اللہ ،قَبْلَ أَنْ یَقْرَأَہُ أَقْوَامٌ یَطْلُبُونَ بِہِ مَا عِنْدَ النَّاسِ۔","Hasan","Musannaf Ibn Abi Shaybah 30625","","","كتاب فضائل القرآن"
"30626","(۳۰۶۲۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: اقَرَؤُوا الْقُرْآنَ وَسَلُوا اللَّہَ بِہِ فَإِنَّہُ سَیَقْرَؤُہُ أَقْوَامٌ یُقِیمُونَہُ إقَامَۃَ الْقَدَحِ یَتَعَجَّلُونَہُ ، وَلا یَتَأَجَّلُونَہُ۔n(ابوداؤد ۸۲۷۔ احمد ۳۳۸)","","Musannaf Ibn Abi Shaybah 30626","","","كتاب فضائل القرآن"
"30627","(۳۰۶۲۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ: حدَّثَنَا عَبْدُ اللہِ بْنُ الْوَلِیدِ ، قَالَ: أَخْبَرَنِی عُمَرُ بْنُ أَیُّوبَ ، قَالَ: أَخْبَرَنِی أَبُو إیَاسٍ مُعَاوِیَۃُ بْنُ قُرَّۃَ ، قَالَ: کُنْتُ نَازِلاً عَلَی عَمْرِو بْنِ النُّعْمَانِ بْنِ مُقَرِّنٍ ، فَلَمَّا حَضَرَ رَمَضَانُ جَائَہُ رَجُلٌ بِأَلْفَیْ دِرْہَمٍ مِنْ قِبَلِ مُصْعَبِ بْنِ الزُّبَیْرِ فَقَالَ: إنَّ الأَمِیرَ یُقْرِئُک السَّلامَ ، وَیَقُولُ: إنَّا لَمْ نَدَعَ قَارِئًا شَرِیفًا إِلاَّ وَقَدْ وَصَلَ إلَیْہِ مِنَّا مَعْرُوفٌ ، فَاسْتَعِنْ بِہَذَیْنِ عَلَی نَفَقَۃِ شَہْرِکَ ہَذَا ، فَقَالَ عَمْرٌو: اقْرَأْ عَلَی الأَمِیرِ السَّلامَ وَقُلْ لَہُ: إنا وَاللہ مَا قَرَأْنَا الْقُرْآنَ نُرِیدُ بِہِ الدُّنْیَا ، وَرُدَّہ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 30627","","","كتاب فضائل القرآن"
"30628","(۳۰۶۲۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَن سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی شُرَیْحٍ الْخُزَاعِیِّ ، قَالَ: خَرَجَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ: أَبْشِرُوا أَبْشِرُوا أَلَیْسَ تَشْہَدُونَ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ وَأَنِّی رَسُولُ اللہِ ؟ قَالُوا: نَعَمْ ، قَالَ: فَإِنَّ ہَذَا الْقُرْآنَ سَبَبٌ طَرَفُہُ بِیَدِ اللہِ وَطَرَفُہُ بِأَیْدِیکُمْ فَتَمَسَّکُوا بِہِ ، فَإِنَّکُمْ لَنْ تَضِلُّوا وَلَنْ تَہْلِکُوا بَعْدَہُ أَبَدًا۔ (ابن حبان ۱۲۲۔ عبد بن حمید ۴۸۳)","Hasan","Musannaf Ibn Abi Shaybah 30628","","","كتاب فضائل القرآن"
"30629","(۳۰۶۲۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن حَمْزَۃَ الزَّیَّاتِ ، عَنْ أَبِی الْمُخْتَارِ الطَّائِیِّ ، عَنِ ابْنِ أَخِی الْحَارِثِ الأَعْوَرِ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ: سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: کِتَابُ اللہِ فِیہِ خَبَرُ مَا قَبْلَکُمْ وَنَبَأُ مَا بَعْدَکُمْ وَحُکْمُ مَا بَیْنَکُمْ ، ہُوَ الْفَصْلُ لَیْسَ بِالْہَزْلِ ، ہُوَ الَّذِی لاَ تَزِیغُ بِہِ الأَہْوَائُ ، وَلا تَشْبَعُ مِنْہُ الْعُلَمَائُ ، وَلا یَخْلَقُ عَن کَثْرَۃِ رَدٍّ ، وَلا تَنْقَضِی عَجَائِبُہُ ، ہُوَ الَّذِی مَنْ تَرَکَہُ مِنْ جَبَّارٍ قَصَمَہُ اللَّہُ ، وَمَنِ ابْتَغَی الْہُدَی فِی غَیْرِہِ أَضَلَّہُ اللَّہُ ، ہُوَ حَبْلُ اللہِ الْمَتِینُ ،وَہُوَ الذِّکْرُ الْحَکِیمُ ،وَہُوَ الصِّرَاطُ الْمُسْتَقِیمُ ، ہُوَ الَّذِی مَنْ عَمِلَ بِہِ أُجِرَ ، وَمَنْ حَکَمَ بِہِ عَدَلَ ، وَمَنْ دَعَا إلَیْہِ دعا إِلَی صِرَاطٍ مُسْتَقِیمٍ ، خُذْہَا إلَیْک یَا أَعْوَرُ۔ (ترمذی ۲۹۰۶۔ احمد ۹۱)","Da'if","Musannaf Ibn Abi Shaybah 30629","","","كتاب فضائل القرآن"
"30630","(۳۰۶۳۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الْہَجَرِیِّ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ،قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إنَّ ہَذَا الْقُرْآنَ مَأْدُبَۃُ اللہِ فَتَعَلَّمُوا مِنْ مَأْدُبَۃِ اللہِ مَا اسْتَطَعْتُمْ ، إنَّ ہَذَا الْقُرْآنَ حَبْلُ اللہِ ،وَہُوَ النُّورُ الْبَیِّنُ ،وَالشِّفَائُ النَّافِعُ ، عِصْمَۃٌ لِمَنْ تَمَسَّکَ بِہِ ، وَنَجَاۃٌ لِمَنْ تَبِعَہُ ،لاَ یَعْوَجُّ فَیُقَوَّمُ ، وَلا یَزِیغُ فَیَسْتَعْتِبُ ، وَلا تَنْقَضِی عَجَائِبُہُ ، وَلا یَخْلَقُ عن کَثْرَۃِ الرَّدِّ۔ (حاکم ۵۵۵)","Da'if","Musannaf Ibn Abi Shaybah 30630","","","كتاب فضائل القرآن"
"30631","(۳۰۶۳۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا أَبَانُ بْنُ إِسْحَاقَ ، قَالَ: حَدَّثَنِی رَجُلٌ مِنْ بَجِیلَۃَ ، قَالَ: خَرَجَ جُنْدَبٌ الْبَجَلِیُّ فِی سَفَرٍ لَہُ ، قَالَ: فَخَرَجَ مَعَہُ نَاسٌ مِنْ قَوْمِہِ حَتَّی إذَا کَانُوا بِالْمَکَانِ الَّذِی یُوَدِّعُ بَعْضُہُمْ بَعْضًا ، قَالَ: أَیْ قَوْمِ ، عَلَیْکُمْ بِتَقْوَی اللہِ ، عَلَیْکُمْ بِہَذَا الْقُرْآنِ فَالْزَمُوہُ عَلَی مَا کَانَ مِنْ جَہْدٍ وَفَاقَۃٍ ، فَإِنَّہُ نُورٌ بِاللَّیْلِ الْمُظْلِمِ وَہُدًی بِالنَّہَارِ۔","Da'if","Musannaf Ibn Abi Shaybah 30631","","","كتاب فضائل القرآن"
"30632","(۳۰۶۳۲) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَن زَیْدِ بْنِ جُبَیْرٍ، قَالَ: قَالَ لِی أَبُو الْبَخْْتَرِیِّ الطَّائِیُّ: اتَّبِعْ ہَذَا الْقُرْآنَ فَإِنَّہُ یَہْدِیک۔","","Musannaf Ibn Abi Shaybah 30632","","","كتاب فضائل القرآن"
"30633","(۳۰۶۳۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَن ہَارُونَ بْنِ عَنْتَرَۃَ عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، قَالَ: قَالَ عَبْدُ اللہِ: إنَّ ہَذِہِ الْقُلُوبَ أَوْعِیَۃٌ فَاشْغَلُوہَا بِالْقُرْآنِ ، وَلا تَشْغَلُوہَا بِغَیْرِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30633","","","كتاب فضائل القرآن"
"30634","(۳۰۶۳۴) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ: قَالَ عَبْدُ اللہِ: إنَّ ہَذَا الْقُرْآنَ مَأْدُبَۃُ اللہ فمَنْ دَخَلَ فِیہِ ، فَہُوَ آمِنٌ۔","Sahih","Musannaf Ibn Abi Shaybah 30634","","","كتاب فضائل القرآن"
"30635","(۳۰۶۳۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن لَیْثٍ ، عَنْ شِہَابٍ ، قَالَ: قَالَ عُمَرُ: تَعَلَّمُوا کِتَابَ اللہِ ،تُعْرَفُوا بِہِ ،وَاعْمَلُوا بِہِ تَکُونُوا مِنْ أَہْلِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30635","","","كتاب فضائل القرآن"
"30636","(۳۰۶۳۶) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن زِیَادِ بْنِ مِخْرَاقٍ ، عَنْ أَبِی إیَاسٍ ، عَنْ أَبِی کِنَانَۃَ ، عَنْ أَبِی مُوسَی ، أَنَّہُ قَالَ: إنَّ ہَذَا الْقُرْآنَ کَائِنٌ لَکُمْ ذِکْرًا أو کَائِنٌ لَکُمْ أَجْرًا ، أَوْ کَائِنٌ عَلَیْکُمْ وِزْرًا ،فَاتَّبِعُوا الْقُرْآنَ ، وَلا یَتَّبِعْکُمُ الْقُرْآنُ ،فَإِنَّہُ مَنْ یَتَّبِعِ الْقُرْآنَ یَہْبِطْ بِہِ عَلَی رِیَاضِ الْجَنَّۃِ ، وَمَنْ یَتَّبِعْہُ الْقُرْآنُ یَزُخُّ فِی قَفَاہُ فَیَقْذِفُہُ فِی جَہَنَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 30636","","","كتاب فضائل القرآن"
"30637","(۳۰۶۳۷) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ: حدَّثَنَا الأَخْنَسُ بْنُ أَبِی الأَخْنَسِ ، عَن زُبَیْدٍ الْمُرَادِیِّ ، قَالَ: شَہِدْت ابْنَ مَسْعُودٍ وَقَامَ خَطِیبًا فَقَالَ: الْزَمُوا الْقُرْآنَ وَتَمَسَّکُوا بِہِ ، حَتَّی جَعَلَ یَقْبِضُ عَلَی یَدَیْہِ جَمِیعًا کَأَنَّہُ أَخَذَ بِسَبَبِ شَیْئٍ۔","Da'if","Musannaf Ibn Abi Shaybah 30637","","","كتاب فضائل القرآن"
"30638","(۳۰۶۳۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ عَنِ الأَعْمَشِ عَنْ خَیْثَمَۃ قَالَ: مَرَّتْ بِعِیسَی امْرَأَۃٌ ، فَقَالَتْ: طُوبَی لِبَطْنٍ حَمَلَک ، وَلِثَدْیٍ أَرْضَعَک ، قَالَ: فَقَالَ: عِیسَی طُوبَی لِمَنْ قَرَأَ الْقُرْآنَ وَاتَّبَعَ مَا فِیہِ۔","","Musannaf Ibn Abi Shaybah 30638","","","كتاب فضائل القرآن"
"30639","(۳۰۶۳۹) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِی ، عَن سُفْیَانَ ، عَنْ وَاصل عَنْ إِبْرَاہِیم قَالَ: مَرَّتِ امْرَأَۃٌ بِعِیسَی ابْنِ مَرْیَمَ ، ثُمَّ ذَکَرَ نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 30639","","","كتاب فضائل القرآن"
"30640","(۳۰۶۴۰) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَن مُغِیرَۃَ بِنْتِ حَسَّانَ قَالَتْ: سَمِعْت أَنَسًا یَقُولُ: {فَقَدِ اسْتَمْسَکَ بِالْعُرْوَۃِ الْوُثْقَی} ، قَالَ: الْقُرْآنُ۔","Da'if","Musannaf Ibn Abi Shaybah 30640","","","كتاب فضائل القرآن"
"30641","(۳۰۶۴۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَن مُرَّۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ: مَنْ أَرَادَ الْعِلْمَ فَلْیَقْرَإِ الْقُرْآنَ فَإِنَّ فِیہِ عِلْمَ الأَوَّلِینَ وَالآخِرِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 30641","","","كتاب فضائل القرآن"
"30642","(۳۰۶۴۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن خَیْثَمَۃَ ، عَنِ الأَسْوَدِ ، قَالَ: قَالَ عَبْدُ اللہِ: عَلَیْکُمْ بِالشِّفَائَیْنِ: الْقُرْآنِ وَالْعَسَلِ۔","Sahih","Musannaf Ibn Abi Shaybah 30642","","","كتاب فضائل القرآن"
"30643","(۳۰۶۴۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأحوص ، عَنْ عَبْدِ اللہِ ، قَالَ: الْعَسَلُ شِفَائٌ مِنْ کُلِّ دَائٍ ، وَالْقُرْآنُ شِفَائٌ لِمَا فِی الصُّدُورِ۔","Sahih","Musannaf Ibn Abi Shaybah 30643","","","كتاب فضائل القرآن"
"30644","(۳۰۶۴۴) حَدَّثَنَا الْمُحَارِبِیُّ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ (شِفَائٌ لِلنَّاسِ) قَالَ: الشِّفَائُ فِی الْقُرْآنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30644","","","كتاب فضائل القرآن"
"30645","(۳۰۶۴۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی الأ??حْوَصِ ، عَنْ عَبْدِ اللہِ ، قَالَ: الْبَیْتُ الَّذِی لاَ یُقْرَأُ فِیہِ الْقُرْآنُ کَمَثَلِ الْبَیْتِ الْخَرِبِ الَّذِی لاَ عَامِرَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30645","","","كتاب فضائل القرآن"
"30646","(۳۰۶۴۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبَّادٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ: الْبَیْتُ الَّذِی یُقْرَأُ فِیہِ الْقُرْآنُ تَحْضُرُہُ الْمَلائِکَۃُ وَتَخْرُجُ مِنْہُ الشَّیَاطِینُ وَیَتَّسِعُ بِأَہْلِہِ وَیَکْثُرُ خَیْرُہُ ، وَالْبَیْتُ الَّذِی لاَ یُقْرَأُ فِیہِ الْقُرْآنُ تَحْضُرُہُ الشَّیَاطِینُ ، وَتَخْرُجُ مِنْہُ الْمَلائِکَۃُ ، وَیَضِیقُ بِأَہْلِہِ وَیَقِلُّ خَیْرُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30646","","","كتاب فضائل القرآن"
"30647","(۳۰۶۴۷) حَدَّثَنَا عَبِیْدَۃُ ، عَنْ أَبِی الزَّعْرَائِ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ: سَمِعْتُ ابْنَ مَسْعُودٍ یَقُولُ: إنَّ أَصْفَرَ الْبُیُوتِ الیت الَّذِی صَفِرَ مِنْ کِتَابِ اللہِ۔","","Musannaf Ibn Abi Shaybah 30647","","","كتاب فضائل القرآن"
"30648","(۳۰۶۴۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن لَیْثٍ ، عَنِ ابْنِ سَابِطٍ ، قَالَ: إنَّ الْبُیُوتَ الَّتِی یُقْرَأُ فِیہَا الْقُرْآنُ لَتُضِیئُ لأَہْلِ السَّمَائِ کَمَا تُضِیئُ السَّمَائُ لأَہْلِ الأَرْضِ ، قَالَ: وَإِنَّ الْبَیْتَ الَّذِی لاَ یُقْرَأُ فِیہِ الْقُرْآنُ لَیَضِیقُ عَلَی أَہْلِہِ وَتَحْضُرُہُ الشَّیَاطِینُ وَتَنْفِرُ مِنْہُ الْمَلائِکَۃُ ، وَإِنَّ أَصْفَرَ الْبُیُوتِ لَبَیْتٌ صَفِرَ مِنْ کِتَابِ اللہِ۔","","Musannaf Ibn Abi Shaybah 30648","","","كتاب فضائل القرآن"
"30649","(۳۰۶۴۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ: کَانَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ إذَا دَخَلَ مَنْزِلَہُ قَرَأَ فِی زَوَایَاہُ آیَۃَ الْکُرْسِیِّ۔","","Musannaf Ibn Abi Shaybah 30649","","","كتاب فضائل القرآن"
"30650","(۳۰۶۵۰) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، قَالَ: حَدَّثَنَا ثَابِتٌ ، قَالَ: کَانَ أَبُو ہُرَیْرَۃَ یَقُولُ فی الْبَیْتُ إذَا تُلِیَ فِیہِ کِتَابُ اللہِ اتَّسَعَ بِأَہْلِہِ وَکَثُرَ خَیْرُہُ وَحَضَرَتْہُ الْمَلائِکَۃُ ، وَخَرَجَتْ مِنْہُ الشَّیَاطِینُ ، وَالْبَیْتُ إذا لَمْ یُتْلَ فِیہِ کِتَابُ اللہِ ضَاقَ بِأَہْلِہِ ، وَقَلَّ خَیْرُہُ ،وَحَضَرَتْہُ الشَّیَاطِینُ۔","","Musannaf Ibn Abi Shaybah 30650","","","كتاب فضائل القرآن"
"30651","(۳۰۶۵۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ وَحَفْص ، عَنِ الأَعْمَش ، عَن شقیق ، قَالَ: قَالَ عَبْدُ اللہِ: إنِّی قَدْ تَسَمَّعْتُ إِلَی الْقَرَأَۃِ فَوَجَدْتہمْ مُتَقَارِبِینَ فَاقْرَؤُوہُ کَمَا عَلِمْتُمْ ، وَإِیَّاکُمْ وَالتَّنَطُّعَ وَالاخْتِلافَ زَادَ أَبُو مُعَاوِیَۃَ: إنَّمَا ہُوَ کَقَوْلِ أَحَدِکُمْ ہَلُمَّ وَتَعَالَ۔","Sahih","Musannaf Ibn Abi Shaybah 30651","","","كتاب فضائل القرآن"
"30652","(۳۰۶۵۲) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ: اقْرَؤُوا الْقُرْآنَ صِبْیَانِیَّۃ وَلا تَنَطَّعُوا فِیہِ۔","","Musannaf Ibn Abi Shaybah 30652","","","كتاب فضائل القرآن"
"30653","(۳۰۶۵۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ ، عَن حَکِیمِ عَنْ جَابِرٍ ، قَالَ: قَالَ حُذَیْفَۃُ: إنَّ أَقْرَأَ النَّاسِ الْمُنَافِقُ الَّذِی لاَ یَدَعُ وَاوًا ، وَلا أَلِفًا ، یَلْفِت کَمَا تَلْفِت الْبَقَرُ أَلْسِنَتَہَا ، لاَ یُجَاوِزُ تَرْقُوَتَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30653","","","كتاب فضائل القرآن"
"30654","(۳۰۶۵۴) حَدَّثَنَا أَبُو أُسَامَۃَ، قَالَ: أَخْبَرَنِی الثَّوْرِیُّ، عَنِ الْحَسَنِ بْنِ عَمْرٍو عَن فُضَیْلٍ، عَنْ إبْرَاہِیمَ: کَانُوا یَکْرَہُونَ أَنْ یُعَلِّمُوا الصَّبِیَّ الْقُرْآنَ حَتَّی یَعْقِلَ۔","","Musannaf Ibn Abi Shaybah 30654","","","كتاب فضائل القرآن"
"30655","(۳۰۶۵۵) حَدَّثَنَا أَبُو أُسَامَۃَ حَدَّثَنِی الثَّوْرِیُّ، قَالَ: حدَّثَنَا أَسْلَمُ الْمُنْقِرِیُّ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی، عَنْ أَبِیہِ، عَن أُبَیٍّ، قَالَ: کِتَابُ اللہِ مَا اسْتَبَانَ مِنْہُ فَاعْمَلْ بِہِ ، وَمَا اشْتَبَہَ عَلَیْک فَآمِنْ بِہِ ،وَکِلْہُ إِلَی عَالِمِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30655","","","كتاب فضائل القرآن"
"30656","(۳۰۶۵۶) حَدَّثَنَا یَعْلَی ، قَالَ: حدَّثَنَا إسْمَاعِیلُ ، عَن زُبَیْدٍ ، قَالَ: قَالَ عَبْدُ اللہِ إنَّ لِلْقُرْآنِ مَنَارًا کَمَنَارِ الطَّرِیقِ ، فَمَا عَرَفْتُمْ فَتَمَسَّکُوا بِہِ ، وَمَا اشْتَبَہَ عَلَیْکُمْ فَذَرُوہُ۔","","Musannaf Ibn Abi Shaybah 30656","","","كتاب فضائل القرآن"
"30657","(۳۰۶۵۷) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِیہِ ، عَن بَعْضِ أَصْحَابِہِ ، عَنِ الرَّبِیعِ بْنِ خُثَیْمٍ ، قَالَ: اضْطَرُّوا ہَذَا الْقُرْآنَ إِلَی اللہِ وَرَسُولِہِ۔","","Musannaf Ibn Abi Shaybah 30657","","","كتاب فضائل القرآن"
"30658","(۳۰۶۵۸) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَن مُعَاذٍ ، أَنَّہُ قَالَ: أَمَّا الْقُرْآنُ فَمَنَارٌ کَمَنَارِ الطَّرِیقِ ، لاَ یَخْفَی عَلَی أَحَدٍ ، فَمَا عَرَفْتُمْ مِنْہُ فَلا تَسْأَلُوا عَنْہُ أَحَدًا ، وَمَا شَکَکْتُمْ فِیہِ فَکِلُوہُ إِلَی عَالِمہ۔","Hasan","Musannaf Ibn Abi Shaybah 30658","","","كتاب فضائل القرآن"
"30659","(۳۰۶۵۹) حَدَّثَنَا وَکِیعٌ ، عَن ہِشَامٍ الدَّسْتَوَائِیِّ ، عَن قَتَادَۃَ ، عَن زُرَارَۃَ بْنِ أَوْفَی ، عَن سَعْدِ بْنِ ہِشَامٍ ، عَنْ عَائِشَۃَ قَالَتْ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: الَّذِی یَقْرَأُ الْقُرْآنَ وَہُوَ مَاہِرٌ بِہِ مَعَ السَّفَرَۃِ الْکِرَامِ الْبَرَرَۃِ ، وَالَّذِی یَقْرَؤُہُ وَہُوَ یَشْتَدُّ عَلَیْہِ لَہُ أَجْرَانِ۔ (بخاری ۴۹۳۷۔ مسلم ۲۴۴)","Sahih","Musannaf Ibn Abi Shaybah 30659","","","كتاب فضائل القرآن"
"30660","(۳۰۶۶۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ: الَّذِی یَہُونُ عَلَیْہِ الْقُرْآنُ مَعَ السَّفَرَۃِ الْکِرَامِ ، وَالَّذِی یَنْفَلِتُ مِنْہُ وَیَشُقُّ عَلَیْہِ لَہُ عِنْدَ اللہِ أَجْرَانِ۔","","Musannaf Ibn Abi Shaybah 30660","","","كتاب فضائل القرآن"
"30661","(۳۰۶۶۱) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَن قَتَادَۃَ ، عَنْ أَنَسٍ ، أَنَّہُ کَانَ إذَا خَتَمَ جَمَعَ أَہْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30661","","","كتاب فضائل القرآن"
"30662","(۳۰۶۶۲) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ: یُذْکَرُ ، أَنَّہُ یُصَلَّی عَلَیْہِ إذَا خَتَمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30662","","","كتاب فضائل القرآن"
"30663","(۳۰۶۶۳) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنِ الْحَکَمِ ، قَالَ: کَانَ مُجَاہِدٌ ، وَعَبْدَۃُ بْنُ أَبِی لُبَابَۃَ وَنَاسٌ یَعْرِضُونَ الْمَصَاحِفَ ، فَلَمَّا کَانَ الْیَوْمُ الَّذِی أَرَادُوا أَنْ یَخْتِمُوا أَرْسَلُوا إلَیَّ وَإِلَی سَلَمَۃَ بْنِ کُہَیْلٍ فَقَالُوا: إنَّا کُنَّا نَعْرِضُ الْمَصَاحِفَ فَأَرَدْنَا أَنْ نَخْتِمَ الْیَوْمَ فَأَحْبَبْنَا أَنْ تَشْہَدُونَا ، إِنَّہُ کَانَ یُقَالُ: إذَا خُتِمَ الْقُرْآنُ نَزَلَتِ الرَّحْمَۃُ عِنْدَ خَاتِمَتِہِ ، أَوْ حَضَرَتِ الرَّحْمَۃُ عِنْدَ خَاتِمَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30663","","","كتاب فضائل القرآن"
"30664","(۳۰۶۶۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ بْنِ حَوْشَبٍ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، أَنَّہُ کَانَ یَخْتِمُ الْقُرْآنَ فِی ثَلاثٍ ، وَیُصْبِحُ الْیَوْمَ الَّذِی یَخْتِمُ فِیہِ صَائِمًا۔","","Musannaf Ibn Abi Shaybah 30664","","","كتاب فضائل القرآن"
"30665","(۳۰۶۶۵) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَن مَنْصُورٍ، عَنِ الْحَکَمِ، عَن مُجَاہِدٍ، قَالَ: الرَّحْمَۃُ تَنْزِلُ عِنْدَ خَتْمِ الْقُرْآنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30665","","","كتاب فضائل القرآن"
"30666","(۳۰۶۶۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنِ التَّیْمِیِّ ، عَن رَجُلٍ ، عَنْ أَبِی الْعَالِیَۃِ ، أَنَّہُ کَانَ إذَا أَرَادَ أَنْ یَخْتِمَ الْقُرْآنَ مِنْ آخِرِ النَّہَارِ أَخَّرَہُ إِلَی أَنْ یُمْسِی ، وَإِذَا أَرَادَ أَنْ یَخْتِمَہُ مِنْ آخِرِ اللَّیْلِ أَخَّرَہُ إِلَی أَنْ یُصْبِحَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30666","","","كتاب فضائل القرآن"
"30667","(۳۰۶۶۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ ، سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقول: یُمَثَّلُ الْقُرْآنُ یَوْمَ الْقِیَامَۃِ رَجُلاً فَیُؤْتَی بِالرَّجُلِ قَدْ حَمَلَہُ فَخَالَفَ فی أَمْرِہِ فَیَتَمَثَّلُ خَصْمًا لَہُ فَیَقُولُ: یَا رَبِّ حَمَّلْتہ إیَّایَ فَشَرُّ حَامِلٍ تَعَدَّی حُدُودِی وَضَیَّعَ فَرَائِضِی ، وَرَکِبَ مَعْصِیَتِی وَتَرَکَ طَاعَتِی ، فَمَا یَزَالُ یَقْذِفُ عَلَیْہِ بِالْحُجَجِ حَتَّی یُقَالَ: فَشَأْنُک بِہِ ، فَیَأْخُذُ بِیَدِہِ ، فَمَا یُرْسِلُہُ حَتَّی یَکُبَّہُ عَلَی صَخْرَۃٍ فِی النَّارِ ، وَیُؤْتَی بِرَجُلٍ صَالِحٍ قَدْ کَانَ حَمَلَہُ وَحَفِظَ أَمْرَہُ فَیَتَمَثَّلُ خَصْمًا دُونَہُ فَیَقُولُ: یَا رَبِّ حَمَّلْتہ إیَّایَ فَخَیْرُ حَامِلٍ ، حَفِظَ حُدُودِی وَعَمِلَ بِفَرَائِضِی وَاجْتَنَبَ مَعْصِیَتِی وَاتَّبَعَ طَاعَتِی ، فَمَا یَزَالُ یَقْذِفُ لَہُ بِالْحُجَجِ حَتَّی یُقَالَ: شَأْنُک بِہِ ، فَیَأْخُذُ بِیَدِہِ فَمَا یُرْسِلُہُ حَتَّی یُلْبِسَہُ حُلَّۃَ الإِسْتَبْرَقِ وَیَعْقِدَ عَلَیْہِ تَاجَ الْمُلْکِ وَیَسْقِیَہُ کَأْسَ الْخَمْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 30667","","","كتاب فضائل القرآن"
"30668","(۳۰۶۶۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ: حدَّثَنَا بَشِیرُ بْنُ الْمُہَاجِرِ ، قَالَ:حَدَّثَنِی عَبْدُ اللہِ بْنُ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ: کُنْتُ عِنْدَ النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَمِعْتہ یَقُولُ: إنَّ الْقُرْآنَ یَلْقَی صَاحِبَہُ یَوْمَ الْقِیَامَۃِ حِینَ یَنْشَقُّ عَنْہُ قَبْرُہُ کَالرَّجُلِ الشَّاحِبِ فیَقُولُ لَہُ: ہَلْ تَعْرِفُنِی ؟ فَیَقُولُ: مَا أَعْرِفُک ، فَیَقُولُ لَہُ: أَنَا صَاحِبُک الْقُرْآنُ الَّذِی أَظْمَأْتُک فِی الْہَوَاجِر ،وَأَسْہَرْت لَیْلَک ، وَإِنَّ کُلَّ تَاجِرٍ مِنْ وَرَائِ تِجَارَتِہِ ، وَإِنَّک الْیَوْمَ مِنْ وَرَائِ کُلِّ تِجَارَۃٍ ، قَالَ: فَیُعْطَی الْمُلْکَ بِیَمِینِہِ وَالْخُلْدَ بِشِمَالِہِ ، وَیُوضَعُ عَلَی رَأْسِہِ تَاجُ الْوَقَارِ ، وَیُکْسَی وَالِدَاہُ حُلَّتَیْنِ ، لاَ یَقُومُ لَہُمَا أَہْلُ الدُّنْیَا ، فَیَقُولانِ: بِمَ کُسِینَا ہَذَا ؟ قَالَ: فَیُقَالُ لَہُمَا: بِأَخْذِ وَلَدِکُمَا الْقُرْآنَ ، ثُمَّ یُقَالُ لَہُ: اقْرَأْ وَاصْعَدْ فِی دَرَجِ الْجَنَّۃِ وَغُرَفِہَا ، فَہُوَ فِی صُعُودٍ مَا دَامَ یَقْرَأُ ہَذًّا کَانَ ، أَوْ تَرْتِیلاً۔ (ابن ماجہ ۳۷۸۱۔ احمد ۳۵۲)","Da'if","Musannaf Ibn Abi Shaybah 30668","","","كتاب فضائل القرآن"
"30669","(۳۰۶۶۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ: حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃَ الرَّبَذِیُّ ، قَالَ: حَدَّثَنَا سَعِیدُ بْنُ أَبِی سَعِیدٍ الْمَقْبُرِیُّ ، عَن عُثْمَانَ بْنِ الْحَکَمِ ، عَن کَعْبٍ ، أَنَّہُ قَالَ: یُمَثَّلُ الْقُرْآنُ لِمَنْ کَانَ یَعْمَلُ بِہِ فِی الدُّنْیَا یَوْمَ الْقِیَامَۃِ کَأَحْسَنِ صُورَۃٍ رَآہَا وَأَحْسَنِہَا وَجْہًا وَأَطْیَبِہَا رِیحًا فَیَقُومُ بِجَنْبِ صَاحِبِہِ فَکُلَّمَا جَائَہُ رَوْعٌ ہَدَّأَ رَوْعَہُ وَسَکَّنَہُ وَبَسَطَ لَہُ أَمَلَہُ فَیَقُولُ لَہُ: جَزَاک اللَّہُ خَیْرًا مِنْ صَاحِبٍ ، فَمَا أَحْسَنَ صُورَتَکَ وَأَطْیَبَ رِیحَک، فَیَقُولُ لَہُ: أَمَا تَعْرِفُنِی: تَعَالَ ارْکَبْنِی ، فَطَالَمَا رَکِبْتُک فِی الدُّنْیَا ، أَنَا عَمَلُک ، إنَّ عَمَلَک کَانَ حَسَنًا ، فَتَرَی صُورَتِی حَسَنَۃً ، وَکَانَ طَیِّبًا فَتَرَی رِیحِی طَیِّبَۃً ، فَیَحْمِلُہُ فَیُوَافِی بِہِ الرَّبَّ تَبَارَکَ وَتَعَالَی فَیَقُولُ: یَا رَبِّ ہَذَا فُلانٌ وَہُوَ أَعْرَفُ بِہِ مِنْہُ قَدْ شَغَلْتہ فِی أَیَّامِہِ فِی حَیَاتِہِ فِی الدُّنْیَا ، أَظْمَأْت نَہَارَہُ وَأَسْہَرْت لَیْلَہُ ، فَشَفِّعْنِی فِیہِ ، فَیُوضَعُ تَاجُ الْمُلْکِ عَلَی رَأْسِہِ ، وَیُکْسَی حُلَّۃَ الْمُلْک ، فَیَقُولُ: یَا رَبِّ قَدْ کُنْت أَرْغَبُ لَہُ عَن ہَذَا وَأَرْجُو لَہُ مِنْک أَفْضَلَ مِنْ ہَذَا ، فَیُعْطَی الْخُلْدَ بِیَمِینِہِ وَالنِّعْمَۃَ بِشِمَالِہِ ، فَیَقُولُ: یَا رَبّ إنَّ کُلَّ تَاجِرٍ قَدْ دَخَلَ عَلَی أَہْلِہِ مِنْ تِجَارَتِہِ ، فَیُشَفَّعُ فِی أَقَارِبِہِ ، وَإِذا کَانَ کَافِرًا مُثِّلَ لَہُ عَمَلُہُ فِی أَقْبَحِ صُورَۃٍ رَآہَا ،وَأَنْتَنَہُ ،فَکُلَّمَا جَائَہُ رَوْعٌ زَادَہُ رَوْعًا فَیَقُولُ: قَبَّحَک اللَّہُ مِنْ صَاحِبٍ فَمَا أَقْبَحَ صُورَتَکَ، وَمَا أَنْتَنَ رِیحَک ، فَیَقُولُ: مَنْ أَنْتَ ؟ قَالَ: أَمَا تَعْرِفُنِی ، أَنَا عَمَلُک ، إنَّہ کَانَ قَبِیحًا فَتَرَی صُورَتِی قَبِیحَۃً ، وَکَانَ مُنْتِنًا فَتَرَی رِیحِی مُنْتِنَۃً ، فَیَقُولُ: تَعَالَ حتی أَرْکَبُک ، فَطَالَمَا رَکِبْتنِی فِی الدُّنْیَا ، فَیَرْکَبُہُ فَیُوَافِی بِہِ اللَّہَ فَلا یُقِیمُ لَہُ وَزْنًا۔","Hasan","Musannaf Ibn Abi Shaybah 30669","","","كتاب فضائل القرآن"
"30670","(۳۰۶۷۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: نِعْمَ الشَّفِیعُ الْقُرْآنُ یَوْمَ الْقِیَامَۃِ ، قَالَ: یَقُولُ: یَا رَبِّ قَدْ کُنْت أَمْنَعُہُ شَہْوَتَہُ فِی الدُّنْیَا فَأَکْرِمْہُ ، قَالَ: فَیُلْبَسُ حُلَّۃَ الْکَرَامَۃِ ، قَالَ: فَیَقُولُ: أَیْ رَبِّ زِدْہُ ، قَالَ: فَیُحَلَّی حُلَّۃَ الْکَرَامَۃِ فَیَقُولُ أَیْ رَبِّ زِدْہُ ، قَالَ: فَیُکْسَی تَاجَ الْکَرَامَۃِ ، قَالَ: فَیَقُولُ: یَا رَبِّ زِدْہُ ، قَالَ: فَیَرْضَی مِنْہُ فَلَیْسَ بَعْدَ رِضَی اللہِ عَنْہُ شَیْئٌ۔ (ترمذی ۲۹۱۵)","Sahih","Musannaf Ibn Abi Shaybah 30670","","","كتاب فضائل القرآن"
"30671","(۳۰۶۷۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ أَبِی صَالِحٍ ، قَالَ: یَشْفَعُ الْقُرْآنُ لِصَاحِبِہِ یَوْمَ الْقِیَامَۃِ فَیُکْسَی حُلَّۃَ الْکَرَامَۃِ فَیَقُولُ: أَیْ رَبِّ زِدْہُ ، فَإِنَّہُ فَإِنَّہُ ، قَالَ: فَیُکْسَی تَاجَ الْکَرَامَۃِ ، قَالَ: فَیَقُولُ: أَیْ رَبِّ زِدْہُ فَإِنَّہُ فَإِنَّہُ ، فَیَقُولُ: رِضَای۔","","Musannaf Ibn Abi Shaybah 30671","","","كتاب فضائل القرآن"
"30672","(۳۰۶۷۲) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَن مُجَاہِدٍ ، أَنَّہُ قَالَ: الْقُرْآنُ یَشْفَعُ لِصَاحِبِہِ یَوْمَ الْقِیَامَۃِ یَقُولُ: یَا رَبِّ جَعَلْتنِی فِی جَوْفِہِ فَأَسْہَرْت لَیْلَہُ وَمَنَعْتہ من کَثِیرٍ مِنْ شَہَوَاتِہِ ، وَلِکُلِّ عَامِلٍ مِنْ عَمَلِہِ عِمَالَۃٌ ، فَیُقَالُ لَہُ ابْسُطْ یَدَک ، قَالَ فَتُمْلأ مِنْ رِضْوَان اللہ ، فَلا سَخَطٌ عَلَیْہِ بَعْدَہُ ، ثُمَّ یُقَالُ لَہُ: اقْرَأْ وَارْقَہُ ، قَالَ: فَیُرْفَعُ لَہُ بِکُلِّ آیَۃٍ دَرَجَۃٌ وَیُزَادُ بِکُلِّ آیَۃٍ حَسَنَۃٌ۔","","Musannaf Ibn Abi Shaybah 30672","","","كتاب فضائل القرآن"
"30673","(۳۰۶۷۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، قَالَ: قَالَ مَنْصُورٌ: حُدِّثْت عَن مُجَاہِدٍ ، قَالَ: یَجِیئُ الْقُرْآنُ یَوْمَ الْقِیَامَۃِ بَیْنَ یَدَیْ صَاحِبِہِ حَتَّی إذَا انْتَہَیَا إِلَی رَبِّہِمَا قَالَ الْقُرْآنُ: یَا رَبِّ ، إِنَّہُ لَیْسَ مِنْ عَامِلٍ إِلاَّ لَہُ مِنْ عِمَالَتِہِ نَصِیبٌ ،وَإِنَّک جَعَلْتنِی فِی جَوْفِہِ فَکُنْت أَنْہَاہُ عَن شَہَوَاتِہِ ، قَالَ: فَیُقَالُ لَہُ: ابْسُطْ یَمِینَک ، قَالَ: فَتُمْلأَ مِنْ رِضْوَانِ اللہِ ، ثُمَّ یُقَالُ لَہُ: ابْسُطْ شِمَالَک ، فَتُمْلأَ مِنْ رِضْوَانِ اللہِ ، فَلا یَسْخَطُ اللہ عَلَیْہِ بَعْدَ ذَلِکَ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 30673","","","كتاب فضائل القرآن"
"30674","(۳۰۶۷۴) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَن مُجَاہِدٍ فِی قَوْلِہِ {وَالَّذِی جَائَ بِالصِّدْقِ وَصَدَّقَ بِہِ} ، قَالَ: الَّذِینَ یَجِیئُونَ بِالْقُرْآنِ یَوْمَ الْقِیَامَۃِ فَیَقُولُونَ: ہَذَا الَّذِی أَعْطَیْتُمُونَا قَدِ اتَّبَعْنَا مَا فِیہِ۔","","Musannaf Ibn Abi Shaybah 30674","","","كتاب فضائل القرآن"
"30675","(۳۰۶۷۵) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَن مَنْصُورٍ ، عَنْ أَبِی جَعْفَرٍ ، عَن زَاذَانَ ، قَالَ: یُقَالُ: إنَّ الْقُرْآنَ شَافِعٌ مُشَفَّعٌ وَمَاحِلٌ مُصَدَّقٌ۔","","Musannaf Ibn Abi Shaybah 30675","","","كتاب فضائل القرآن"
"30676","(۳۰۶۷۶) حَدَّثَنَا عَفَّانُ، قَالَ: حدَّثَنَا ہَمَّامٌ، قَالَ: حَدَّثَنَا عَاصِمُ بْنُ بَہْدَلَۃَ، عَنِ الشَّعْبِیِّ، عَنِ ابْنِ مَسْعُودٍ، قَالَ: یَجِیئُ الْقُرْآنُ یَوْمَ الْقِیَامَۃِ فَیَشْفَعُ لِصَاحِبِہِ فَیَکُونُ قَائِدًا إِلَی الْجَنَّۃِ ، أو یَشْہَدُ عَلَیْہِ فَیَکُونُ سَائِقًا لَہُ إ??لَی النَّارِ۔","","Musannaf Ibn Abi Shaybah 30676","","","كتاب فضائل القرآن"
"30677","(۳۰۶۷۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، عَن زُبَیْدٍ ، قَالَ: قَالَ عَبْدُ اللہِ: الْقُرْآنُ شَافِعٌ مُشَفَّعٌ ومَاحِلٌ مُصَدَّقٌ ، فَمَنْ جَعَلَہُ إمَامَہُ قَادَہُ إِلَی الْجَنَّۃِ ، وَمَنْ جَعَلَہُ خَلْفَ ظَہْرِہِ قَادَہُ إِلَی النَّارِ۔n(بزار ۱۲۲۔ ابن حبان ۱۲۲)","","Musannaf Ibn Abi Shaybah 30677","","","كتاب فضائل القرآن"
"30678","(۳۰۶۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی سَعِیدٍ ، أَوْ عَنْ أَبِی ہُرَیْرَۃَ شَکَّ الأَعْمَشُ ، قَالَ: یُقَالُ لِصَاحِبِ الْقُرْآنِ: یَوْمَ الْقِیَامَۃِ اقْرَأْ وَارْقَہُ ، فإن مَنْزِلُک عِنْدَ آخِرِ آیَۃٍ تَقْرَؤُہَا۔","Da'if","Musannaf Ibn Abi Shaybah 30678","","","كتاب فضائل القرآن"
"30679","(۳۰۶۷۹) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو بِمِثْلِہِ ، وَزَادَ فِیہِ: وَرَتِّلْ کَمَا کُنْت تُرَتِّلُ فِی الدُّنْیَا۔ (ابوداؤد ۱۴۵۹۔ ترمذی ۲۹۱۴)","Da'if","Musannaf Ibn Abi Shaybah 30679","","","كتاب فضائل القرآن"
"30680","(۳۰۶۸۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ: یُقَالُ لِصَاحِبِ الْقُرْآنِ حِینَ یَدْخُلُ الْجَنَّۃَ اقْرَأْ وَارْقَہُ فِی الدَّرَجَاتِ وَرَتِّلْ کَمَا کُنْت تُرَتِّلُ فِی الدُّنْیَا فَإِنَّ مَنْزِلَک من الدَّرَجَاتِ عِنْدَ آخِرِ مَا تَقْرَأُ۔","Da'if","Musannaf Ibn Abi Shaybah 30680","","","كتاب فضائل القرآن"
"30681","(۳۰۶۸۱) حَدَّثَنَا غُنْدَرٌ ، حَدَّثَنَا شُعْبَۃُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَن مُجَاہِدٍ ، قَالَ: یُقَالُ: اقْرَأْ وَارْقَہُ ، قَالَ: فَیُرْفَعُ لَہُ بِکُلِّ آیَۃٍ دَرَجَۃٌ وَیُزَادُ بِکُلِّ آیَۃٍ حَسَنَۃٌ۔","","Musannaf Ibn Abi Shaybah 30681","","","كتاب فضائل القرآن"
"30682","(۳۰۶۸۲) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ أَبِی الضُّحَی ، قَالَ: کَانَ الضَّحَّاکُ بْنُ قَیْسٍ یَقُولُ: یَا أَیُّہَا النَّاسُ عَلِّمُوا أَوْلادَکُمْ وَأَہَالِیکُمَ الْقُرْآنَ فَإِنَّہُ مَنْ کُتِبَ لَہُ مِنْ مُسْلِمٍ یُدْخِلُہُ اللَّہُ الْجَنَّۃَ أَتَاہُ مَلَکَانِ فَاکْتَنَفَاہُ فَقَالا لَہُ: إقرأ وَارْتَقِ فِی دَرَجِ الْجَنَّۃِ حَتَّی یَنْزِلانہِ حَیْثُ انْتَہَی عِلْمُہُ مِنَ الْقُرْآنِ۔","Sahih","Musannaf Ibn Abi Shaybah 30682","","","كتاب فضائل القرآن"
"30683","(۳۰۶۸۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن شُعْبَۃَ ، عَن قَتَادَۃَ ، قَالَ: سَمِعْتُ أَنَسًا یَقُولُ: قَرَأَہُ مُعَاذٌ وَأُبَیُّ وَسَعْدٌ ، وَأَبُو زَیْدٍ ، قَالَ: قُلْتُ: مَنْ أَبُو زَیْدٍ قَالَ أَحَدُ عُمُومَتِی عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔n(بخاری ۳۸۱۰۔ مسلم ۱۹۱۴)","Sahih","Musannaf Ibn Abi Shaybah 30683","","","كتاب فضائل القرآن"
"30684","(۳۰۶۸۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ: قَرَؤُوا الْقُرْآنِ فِی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُبَیٌّ وَمُعَاذٌ وَزَیْدٌ ، وَأَبُو زَیْدٍ ، وَأَبُو الدَّرْدَائِ وَسَعِیدُ بْنُ عُبَیْدٍ ، وَلَمْ یَقْرَأْہ أَحَدٌ مِنَ الْخُلَفَائِ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلاَّ عُثْمَانُ ، وَقَرَأَہُ مُجَمِّعُ ابْنُ جَارِیَۃَ إِلاَّ سُورَۃً ، أَوْ سُورَتَیْنِ۔n(ابن سعد ۳۵۵۔ طبرانی ۲۰۹۲)","","Musannaf Ibn Abi Shaybah 30684","","","كتاب فضائل القرآن"
"30685","(۳۰۶۸۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، قَالَ: جَائَ مُعَاذٌ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ: یَا رَسُولَ اللہِ أَقْرِئْنِی ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: یا عبد اللہ أَقْرِئْہُ ، فَأَقْرَأْتہ مَا کَانَ مَعِی ، ثُمَّ اخْتَلَفْت أَنَا وَہُوَ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَرَأَہُ مُعَاذٌ ، وَکَانَ مُعَلِّمًا مِنَ الْمُعَلِّمِینَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 30685","","","كتاب فضائل القرآن"
"30686","(۳۰۶۸۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَن خمیر بْنِ مَالِکٍ ، عَنْ عَبْدِ اللہِ ، قَالَ: قرَأْت مِنْ فِی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَبْعِینَ سُورَۃً وَإِنَّ زَیْدَ بْنَ ثَابِتٍ لَہُ ذُؤَابَتَانِ فِی الْکتابِ۔ (احمد ۳۸۹)","Da'if","Musannaf Ibn Abi Shaybah 30686","","","كتاب فضائل القرآن"
"30687","(۳۰۶۸۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: جَمَعْت الْمُحْکَمَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَعْنِی الْمُفَصَّلَ۔ (بخاری ۵۰۳۶۔ احمد ۳۳۷)","Sahih","Musannaf Ibn Abi Shaybah 30687","","","كتاب فضائل القرآن"
"30688","(۳۰۶۸۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن ہِشَامٍ ، عَن مُحَمَّدٍ ، قَالَ: کَانَ أَصْحَابُنَا لاَ یَخْتَلِفُونَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قُبِضَ وَلَمْ یَقْرَأَ الْقُرْآنَ مِنْ أَصْحَابِہِ إِلاَّ أَرْبَعَۃٌ کُلُّہُمْ مِنَ الأَنْصَارِ: مُعَاذُ بْنُ جَبَلٍ وَأُبَیُّ بْنُ کَعْبٍ وَزَیْدٌ ، وَأَبُو زَیْدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30688","","","كتاب فضائل القرآن"
"30689","(۳۰۶۸۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن حَجَّاجٍ ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ فِی قول اللہ تعالی (قُلْ بِفَضْلِ اللہِ وَبِرَحْمَتِہِ فَبِذَلِکَ فَلْیَفْرَحُوا) قَالَ: (بِفَضْلِ اللہِ) الْقُرْآنُ ، (وَبِرَحْمَتِہِ) أَنْ جُعِلْتُمْ مِنْ أَہْلِہِ ۔","Da'if","Musannaf Ibn Abi Shaybah 30689","","","كتاب فضائل القرآن"
"30690","(۳۰۶۹۰) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَن ہِلالٍ ، عَن مَنْصُورٍ ، عَن ہِلالِ بْنِ یَِسَافٍ فِی قَوْلِہِ: {قُلْ بِفَضْلِ اللہِ وَبِرَحْمَتِہِ فَبِذَلِکَ فَلْیَفْرَحُوا ہُوَ خَیْرٌ مِمَّا یَجْمَعُونَ}۔قَالَ: کِتَابُ اللہِ وَالإِسْلامُ ہُوَ خَیْرٌ مِمَّا یَجْمَعُونَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30690","","","كتاب فضائل القرآن"
"30691","(۳۰۶۹۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَنْ عَطِیَّۃَ ، عَنِ ابْنِ عَبَّاسٍ فِی قَوْلِ اللہِ قُلْ بِفَضْلِ اللہِ وَبِرَحْمَتِہِ ، قَالَ: بِفَضْلِ اللہِ: الإِسْلامُ ، وَبِرَحْمَتِہِ: أَنْ جَعَلَکُمْ مِنْ أَہْلِ الْقُرْآنِ۔","Da'if","Musannaf Ibn Abi Shaybah 30691","","","كتاب فضائل القرآن"
"30692","(۳۰۶۹۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَنِ الْقَاسِمِ ، عَن مُجَاہِدٍ ، قَالَ: الْقُرْآنُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30692","","","كتاب فضائل القرآن"
"30693","(۳۰۶۹۳) حَدَّثَنَا أَبُو خَالِدٍ، عَنْ عَمْرِو بْنِ قَیْسٍ، عَن مَنْصُورٍ، عَن سَالِمٍ، قَالَ: بِفَضْلِ اللہِ وَبِرَحْمَتِہِ الإِسْلامُ وَالْقُرْآنُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30693","","","كتاب فضائل القرآن"
"30694","(۳۰۶۹۴) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ: حدَّثَنَا شُعْبَۃُ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، قَالَ ، عَن سَعْدِ بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَن عُثْمَانَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: خِیَارُکُمْ مَنْ تَعَلَّمَ الْقُرْآنَ وَعَلَّمَہُ۔ (بخاری ۵۰۲۷۔ ابوداؤد ۱۴۴۷)","Sahih","Musannaf Ibn Abi Shaybah 30694","","","كتاب فضائل القرآن"
"30695","(۳۰۶۹۵) حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ زِیَادٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ النُّعْمَانِ بْنِ سَعْدٍ ، عَنْ عَلِیٍّ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: خِیَارُکُمْ مَنْ تَعَلَّمَ الْقُرْآنَ وَعَلَّمَہُ۔n(ترمذی ۲۹۰۹۔ دارمی ۳۳۳۷)","Da'if","Musannaf Ibn Abi Shaybah 30695","","","كتاب فضائل القرآن"
"30696","(۳۰۶۹۶) حَدَّثَنَا وَکِیعٌ قَالَ: حَدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أَیُحِبُّ أَحَدُکُمْ إذَا رَجَعَ إِلَی أَہْلِہِ أَنْ یَجِدَ فِیہِ ثَلاثَ خَلِفَاتٍ عِظَامٍ سِمَانٍ ، قَالَ: قُلْنَا: نَعَمْ ، قَالَ: فثلاث آیَاتٍ یَقْرَأُ بِہِنَّ أَحَدُکُمْ فِی صَلاتِہِ خَیْرٌ لَہُ مِنْ ثَلاثِ خَلِفَاتٍ سِمَانٍ عِظَامٍ۔n(مسلم ۵۵۲۔ احمد ۴۶۶)","Sahih","Musannaf Ibn Abi Shaybah 30696","","","كتاب فضائل القرآن"
"30697","(۳۰۶۹۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ: حدَّثَنَا مُوسَی بْنُ عُلَیٍّ ، قَالَ: سَمِعْتُ أَبِی یُحَدِّثُ ، عَن عُقْبَۃَ بْنِ عَامِرٍ ، قَالَ: خَرَجَ إلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَنَحْنُ فِی الصُّفَّۃِ فَقَالَ: أَیُّکُمْ یُحِبُّ أَنْ یَغْدُوَ کُلَّ یَوْمٍ إِلَی بطْحَانَ ، أَو الْعَقِیقِ فَیَأْتِیَ مِنْہُ بِنَاقَتَیْنِ کَوْمَاوَیْنِ فِی غَیْرِ إِثْمَ وَلا قَطِیعَۃِ رَحِمٍ قُلْنَا: یَا رَسُولَ اللہِ ، کُلُّنَا نُحِبُّ ذَلِکَ ، قَالَ: فَلأَنْ یَغْدُو أَحَدُکُمْ إِلَی الْمَسْجِدِ فَیُعَلِّمُ ، أَوْ یَقْرَأُ آیَتَیْنِ مِنْ کِتَابِ اللہِ خَیْرٌ لَہُ مِنْ نَاقَتَیْنِ وَثَلاثٍ خَیْرٌ لَہُ مِنْ ثلاث ، وَأَرْبَعٌ خَیْرٌ لَہُ مِنْ أَرْبَعٍ وَمِثْل أَعْدَادِہِنَّ مِنَ الإِبِلِ۔ (ابوداؤد ۱۴۵۱۔ احمد ۱۵۴)","Sahih","Musannaf Ibn Abi Shaybah 30697","","","كتاب فضائل القرآن"
"30698","(۳۰۶۹۸) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ: أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، قَالَ: لَوْ جُعِلَ لأَحَدٍ خَمْسُ قَلائِصَ إِنْ صَلَّی الْغَدَاۃَ بالقریۃ لَبَاتَ یَقُولُ لأَہْلِہِ: لَقَدْ أَنَی لِی أَنْ أَنْطَلِقَ ، وَاللہ لأَنْ یَقْعُدُ أَحَدُکُمْ فَیَتَعَلَّمُ خَمْسَ آیَاتٍ مِنْ کِتَابِ اللہِ فَلَہُنَّ خَیْرٌ لَہُ مِنْ خَمْسِ قَلائِصَ وَخَمْسِ قَلائِصَ۔","Sahih","Musannaf Ibn Abi Shaybah 30698","","","كتاب فضائل القرآن"
"30699","(۳۰۶۹۹) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ: أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ: کَانَ یُقْرِیء الْقُرْآنَ فَیَمُرُّ بِالآیَۃِ فَیَقُولُ لِلرَّجُلِ: خُذْہَا فَوَاللہ لَہِیَ خَیْرٌ مِمَّا عَلَی الأَرْضِ مِنْ شَیْئٍ ، قَالَ: فَیَرَی الرَّجُلُ أَنَّمَا یَعْنِی تِلْکَ الآیَۃَ حَتَّی یَفْعَلَہُ بِالْقَوْمِ کُلِّہِمْ۔ (عبدالرزاق ۵۹۹۲)","","Musannaf Ibn Abi Shaybah 30699","","","كتاب فضائل القرآن"
"30700","(۳۰۷۰۰) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: تَرَکْت فِیکُمْ مَا لن تَضِلُّوا بَعْدَہُ إنِ اعْتَصَمْتُمْ بِہِ کِتَابُ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30700","","","كتاب فضائل القرآن"
"30701","(۳۰۷۰۱) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَسَّانُ بْنُ إبْرَاہِیمَ ، عَن سَعِیدِ بْنِ مَسْرُوقٍ ، عَن یَزِید بْنِ حَیَّان ، عَن زَیْدِ بْنِ أَرْقَمَ ، قَالَ: دَخَلْنَا عَلَیْہِ فَقُلْنَا لَہُ قَدْ رَأَیْت خَیْرًا ، صَحِبْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَصَلَّیْت خَلْفَہُ، فَقَالَ: نَعَمْ ، وَإِنَّہُ خَطَبَنَا فَقَالَ: إنِّی تَارِکٌ فِیکُمْ کِتَابَ اللہِ ہُوَ حَبْلُ اللہِ ، مَنِ اتَّبَعَہُ کَانَ عَلَی الْہُدَی وَمَنْ تَرَکَہُ کَانَ عَلَی الضَّلالَۃِ۔ (مسلم ۱۸۷۴۔ احمد ۳۶۶)","Sahih","Musannaf Ibn Abi Shaybah 30701","","","كتاب فضائل القرآن"
"30702","(۳۰۷۰۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: أَخْبَرَنَا جَرِیرٌ ، قَالَ: حَدَّثَنَا سُلَیْمَانُ بْنُ شُرَحْبِیلَ الْجبلانِیُّ ، قَالَ: سَمِعْتُ أَبَا أُمَامَۃَ یَقُولُ: اقَرَؤُوا الْقُرْآنَ وَلا تَغُرَّنَّکُمْ ہَذِہِ الْمَصَاحِفُ الْمُعَلَّقَۃُ فَإِنَّ اللَّہَ لَمْ یُعَذِّبْ قَلْبًا وَعَی الْقُرْآنَ۔","Hasan","Musannaf Ibn Abi Shaybah 30702","","","كتاب فضائل القرآن"
"30703","(۳۰۷۰۳) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ: قَالَ عَبْدُ اللہِ: مَنْ قَرَأَ الْقُرْآنَ فَلْیُبْشِرْ۔","Sahih","Musannaf Ibn Abi Shaybah 30703","","","كتاب فضائل القرآن"
"30704","(۳۰۷۰۴) حَدَّثَنَا محمد بن بشر حَدَّثَنَا زَکَرِیَّا ، قَالَ: حدَّثَنِی عَطِیَّۃُ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: إنِّی تَارِکٌ فِیکُمَ الثَّقَلَیْنِ ، أَحَدُہُمَا أَکْبَرُ مِنَ الآخَرِ کِتَابُ اللہِ حَبْلٌ مَمْدُودٌ مِنَ السَّمَائِ إِلَی الأَرْضِ۔ (احمد ۱۴۔ ترذی ۳۷۸۸)","Da'if","Musannaf Ibn Abi Shaybah 30704","","","كتاب فضائل القرآن"
"30705","(۳۰۷۰۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ: أَخْبَرَنِی مُحَمَّدُ بْنُ إبْرَاہِیمَ بْنِ الْحَارِثِ ، عَن یُحَنَّسَ أَبِی مُوسَی ، عَن رَاشِدِ بْنِ سَعْدٍ أَخٍ لأُمِّ الدَّرْدَائِ عَنْ أَبِی الدَّرْدَائِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ قَرَأَ مِئَۃ آیَۃٍ فِی لَیْلَۃٍ لَمْ یُکْتَبْ مِنَ الْغَافِلِینَ ، وَمَنْ قَرَأَ بِمِئَتَیْ آیَۃٍ کُتِبَ مِنَ الْقَانِتِینَ وَمَنْ قَرَأَ خَمْسَمِئَۃِ آیَۃٍ إِلَی أَلْفِ آیَۃٍ أَصْبَحَ لَہُ قِنْطَارٌ مِنَ الأَجْرِ وَالْقِیرَاطُ منہ مِثْلُ التَّلِّ الْعَظِیمِ۔ (عبد بن حمید ۲۰۰)","Da'if","Musannaf Ibn Abi Shaybah 30705","","","كتاب فضائل القرآن"
"30706","(۳۰۷۰۶) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن مَنْصُورٍ ، عَن سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَن مُعَاذٍ ، أَنَّہُ قَالَ: مَنْ قَرَأَ فِی لَیْلَۃٍ بثَلاثِ مِئَۃ آیَۃٍ کُتِبَ مِنَ الْقَانِتِینَ ، وَمَنْ قَرَأَ بِأَلْفِ آیَۃٍ کَانَ لَہُ قِنْطَاران الْقِیرَاطَ مِنْہُ أَفْضَلُ مِمَّا عَلَی الأَرْضِ مِنْ شَیْئٍ۔","","Musannaf Ibn Abi Shaybah 30706","","","كتاب فضائل القرآن"
"30707","(۳۰۷۰۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنِ الأَعْمَشِ ، عَن مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ ضَمْرَۃَ ، عَن کَعْبٍ ، قَالَ: مَنْ قَرَأَ فِی لَیْلَۃٍ مِئَۃ آیَۃٍ کُتِبَ مِنَ الْقَانِتِینَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30707","","","كتاب فضائل القرآن"
"30708","(۳۰۷۰۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ: حدَّثَنَا مِسْعَرٌ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: مَنْ قَرَأَ مِئَۃ آیَۃٍ فِی لَیْلَۃٍ لَمْ یُکْتَبْ مِنَ الْغَافِلِینَ ، وَمَنْ قَرَأَ مِئَتَیْنِ کُتِبَ مِنَ الْقَانِتِینَ۔n(ابن خزیمۃ ۱۱۴۳۔ حاکم ۳۰۸)","Sahih","Musannaf Ibn Abi Shaybah 30708","","","كتاب فضائل القرآن"
"30709","(۳۰۷۰۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن فِطْرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عبْدِ اللہِ ، قَالَ: مَنْ قَرَأَ فِی لَیْلَۃٍ خَمْسِینَ آیَۃً لَمْ یُکْتَبْ مِنَ الْغَافِلِینَ ، وَمَنْ قَرَأَ مِئَۃ آیَۃٍ کُتِبَ مِنَ الْقَانِتِینَ ، وَمَنْ قَرَأَ ثَلاثُ مِئَۃ آیَۃٍ کُتِبَ لَہُ قِنْطَارٌ ، وَمَنْ قَرَأَ تِسْعَ مِئَۃِ آیَۃٍ فُتِحَ لَہُ۔ (دارمی ۳۴۴۶)","Sahih","Musannaf Ibn Abi Shaybah 30709","","","كتاب فضائل القرآن"
"30710","(۳۰۷۱۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: مَنْ قَرَأَ فِی لَیْلَۃٍ بِمِئَۃِ آیَۃٍ لَمْ یُکْتَبْ مِنَ الْغَافِلِینَ ، وَمَنْ قَرَأَ بِمِئَتَیْ آیَۃٍ کُتِبَ مِنَ الْقَانِتِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 30710","","","كتاب فضائل القرآن"
"30711","(۳۰۷۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْجَدَلِی عن ابْنِ عُمَرَ ، قَالَ: مَنْ قَرَأَ بِعَشْرِ آیَاتٍ فِی لَیْلَۃٍ لَمْ یُکْتَبْ مِنَ الْغَافِلِینَ۔ (ابوداؤد ۱۳۹۳۔ ابن حبان ۲۵۷۲)","Da'if","Musannaf Ibn Abi Shaybah 30711","","","كتاب فضائل القرآن"
"30712","(۳۰۷۱۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن مَنْصُورٍ ، قَالَ: قَالَ عَبْدُ اللہِ: لَوْ أَنَّ رَجُلاً بَاتَ یَحْمِلُ عَلَی الْجِیَادِ فِی سَبِیلِ اللہِ وَبَاتَ رَجُلٌ یَتْلُو کِتَابَ اللہِ لَکَانَ ذَاکِرُ اللہِ أَفْضَلَہُمَا قَالَ: وَقَالَ عَبْدُ اللہِ بْنُ عَمْرو: لَوْ بَاتَ رَجُلٌ یُنْفِقُ دِینَارًا دِینَارًا وَدِرْہَمًا دِرْہَمًا وَیَحْمِلُ عَلَی الْجِیَادِ فِی سَبِیلِ اللہِ حَتَّی یُصْبِحَ مُتَقَبَّلاً مِنْہُ، وَبِتُّ أَتْلُو کِتَابَ اللہِ حَتَّی أُصْبِحَ مُتَقَبَّلاً مِنِّی لَمْ أُحِبَّ ، أَنَّ لِی عَمَلَہُ بِعَمَلِی۔","","Musannaf Ibn Abi Shaybah 30712","","","كتاب فضائل القرآن"
"30713","(۳۰۷۱۳) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ: حدَّثَنَا التَّیْمِیُّ ، عَنْ أَبِی عُثْمَانَ ، عَن سَلْمَانَ ، قَالَ: لَوْ بَاتَ رَجُلٌ یُعْطِی الْقیَانِ الْبِیضَ وَبَاتَ آخَرُ یَقْرَأُ الْقُرْآنَ وَیَذْکُرُ اللَّہَ لَرَأَیْت ، أَنَّ ذَاکِرَ اللہِ أَفْضَلُ۔","Sahih","Musannaf Ibn Abi Shaybah 30713","","","كتاب فضائل القرآن"
"30714","(۳۰۷۱۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن شَقِیقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ: قرَائَۃُ الْقُرْآنِ أَحَبُّ إلَیَّ مِنَ الصَّوْمِ۔","Sahih","Musannaf Ibn Abi Shaybah 30714","","","كتاب فضائل القرآن"
"30715","(۳۰۷۱۵) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَن شَقِیقٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی رَزِینٍ ، قَالَ: قَالَ رَجُلٌ لِحَبَّۃَ بْنِ سَلَمَۃَ ،وَکَانَ مِنْ أَصْحَابِ عَبْدِ اللہِ: قَرَأْت الْقُرْآنَ کُلَّہُ: قَالَ: وَمَا أَدْرَکْت مِنْہُ۔","","Musannaf Ibn Abi Shaybah 30715","","","كتاب فضائل القرآن"
"30716","(۳۰۷۱۶) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، قَالَ حَدَّثَنَا أَیُّوبُ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَقُولَ: قَرَأْت الْقُرْآنَ کُلَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30716","","","كتاب فضائل القرآن"
"30717","(۳۰۷۱۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَن سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، قَالَ: قَالَ حُذَیْفَۃُ: مَا تَقْرَؤُونَ رُبُعَہَا یَعْنِی بَرَائَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 30717","","","كتاب فضائل القرآن"
"30718","(۳۰۷۱۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن عُبَیْدِ اللہِ ، عَن نَافِعٍ ، أن ابْنِ عُمَرَ کَرِہَ أَنْ یَقُولَ: الْمُفَصَّلُ ، وَیَقُولُ: الْقُرْآنُ کُلُّہُ مُفَصَّلٌ ، وَلَکِنْ قُولُوا: قِصَارُ الْقُرْآنِ۔","Sahih","Musannaf Ibn Abi Shaybah 30718","","","كتاب فضائل القرآن"
"30719","(۳۰۷۱۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَر بْنِ حَمْزَۃَ ، عَن سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ: سَأَلَنِی عُمَرُ ، کَمْ مَعَک مِنَ الْقُرْآنِ ؟ قُلْتُ: عَشْرُ سُوَرٍ ، فَقَالَ لِعُبَیْدِ اللہِ بْنِ عُمَرَ: کَمْ مَعَک مِنَ الْقُرْآنِ ؟ قَالَ: سُورَۃٌ ، قَالَ عَبْدُ اللہِ: فَلَمْ یَنْہَنَا وَلَمْ یَأْمُرْنَا غَیْرَ ، أَنَّہُ قَالَ: فَإِنْ کُنْتُمْ مُتَعَلِّمِینَ مِنْہُ بِشَیْئٍ فَعَلَیْکُمْ بِہَذَا الْمُفَصَّلِ فَإِنَّہُ أَحْفَظُ۔","Da'if","Musannaf Ibn Abi Shaybah 30719","","","كتاب فضائل القرآن"
"30720","(۳۰۷۲۰) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سیرین قَالَ: لاَ تقل سورۃ قصیرۃ ، ولا سورۃ خفیفۃ ، قَالَ فکیف أقول ؟ قَالَ: سورۃ یسیرۃ ؛ فإن اللہ تبارک وتعالی قَالَ: {وَلَقَدْ یَسَّرْنَا الْقُرْآنَ لِلذِّکْرِ فَہَلْ مِن مُّدَّکِرٍ} ولا تقل خفیفۃ ؛ فإن اللہ قَالَ {سَنُلْقِی عَلَیْکَ قَوْلاً ثَقِیلاً}۔","","Musannaf Ibn Abi Shaybah 30720","","","كتاب فضائل القرآن"
"30721","(۳۰۷۲۱) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْعَالِیَۃِ ذَکَرَ نَحْوَہُ إِلاَّ أَنَّہُ خَالَفَہُ فِی بَعْضِ الْکَلامِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30721","","","كتاب فضائل القرآن"
"30722","(۳۰۷۲۲) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَن مَنْصُورٍ ، عَن ہِلالِ بْنِ یَِسَافٍ عَن فَرْوَۃَ بْنِ نَوْفَلٍ ، قَالَ: قَالَ خَبَّابُ بْنُ الأَرَتِّ وَأَقْبَلْت مَعَہُ مِنَ الْمَسْجِدِ إِلَی مَنْزِلِہِ فَقَالَ لِی: إنِ اسْتَطَعْت أَنْ تَقَرَّبَ إِلَی اللہِ فَإِنَّک لاَ تَقَرَّبُ إلَیْہِ بِشَیْئٍ أَحَبَّ إلَیْہِ مِنْ کَلامِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30722","","","كتاب فضائل القرآن"
"30723","(۳۰۷۲۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ: سَأَلْتُ عَبِیدَۃَ ، عَن آیَۃٍ فِی کِتَابِ اللہِ ؟ فَقَالَ: عَلَیْک بِتَقْوَی اللہِ وَالسَّدَادِ ، فَقَدْ ذَہَبَ الَّذِینَ کَانُوا یَعْلَمُونَ فِیمَ أُنْزِلَ الْقُرْآنُ۔","","Musannaf Ibn Abi Shaybah 30723","","","كتاب فضائل القرآن"
"30724","(۳۰۷۲۴) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ: سَأَلَ رَجُلٌ سَعِیدَ بْنَ الْمُسَیَّبِ ، عَن آیَۃٍ مِنَ الْقُرْآنِ فَقَالَ: لاَ تَسْأَلْنِی عَنِ الْقُرْآنِ ، وَسَلْ عَنْہُ مَنْ یَزْعُمُ ، أَنَّہُ لاَ یَخْفَی عَلَیْہِ مِنْہُ شَیْئٌ یَعْنِی عِکْرِمَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30724","","","كتاب فضائل القرآن"
"30725","(۳۰۷۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الأَعْلَی ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: مَنْ قَالَ فِی الْقُرْآنِ بِغَیْرِ عِلْمٍ فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 30725","","","كتاب فضائل القرآن"
"30726","(۳۰۷۲۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مُغِیرَۃَ ، قَالَ: کَانَ إبْرَاہِیمُ یَکْرَہُ أَنْ یَتَکَلَّمَ فِی الْقُرْآنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30726","","","كتاب فضائل القرآن"
"30727","(۳۰۷۲۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنِ الشَّعْبِیِّ ، قَالَ: أَدْرَکْت أَصْحَابَ عَبْدِ اللہِ وَأَصْحَابَ عَلِیٍّ وَلَیْسَ ہُمْ لِشَیْئٍ مِنَ الْعِلْمِ أَکْرَہُ مِنْہُمْ لِتَفْسِیرِ الْقُرْآنِ ، قَالَ: وَکَانَ أَبُو بَکْرٍ یَقُولُ: أَیُّ سَمَائٍ تُظِلُّنِی وَأَیُّ أَرْضٍ تُقِلُّنِی إذَا قُلْتُ فِی کِتَابِ اللہِ مَا لاَ أَعْلَمُ۔","","Musannaf Ibn Abi Shaybah 30727","","","كتاب فضائل القرآن"
"30728","(۳۰۷۲۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ: حدَّثَنِی عَبْدُ اللہِ بْنُ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، قَالَ: سَأَلْتُ طَاوُوسًا ، عَن تَفْسِیرِ ہَذِہِ الآیَۃِ: {شَہَادَۃُ بَیْنِکُمْ إذَا حَضَرَ أَحَدَکُمَ الْمَوْتُ} فَأَرَادَ أَنْ یَبْطِشَ حَتَّی قِیلَ ہَذَا ابْنُ حَبِیبٍ کَرَاہِیَۃً لِتَفْسِیرِ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30728","","","كتاب فضائل القرآن"
"30729","(۳۰۷۲۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: أَخْبَرَنَا حُمَیْدٌ ، عَنْ أَنَسٍ ، أَنَّ عُمَرَ ، قَرَأَ عَلَی الْمِنْبَرِ: {وَفَاکِہَۃً وَأَبًّا} ثُمَّ قَالَ: ہَذِہِ الْفَاکِہَۃُ قَدْ عَرَفْنَاہَا فَمَا الأَبُّ ؟ ثُمَّ رَجَعَ إِلَی نَفْسِہِ فَقَالَ: إنَّ ہَذَا لَہُوَ التَّکَلُّفُ یَا عُمَرُ۔","Sahih","Musannaf Ibn Abi Shaybah 30729","","","كتاب فضائل القرآن"
"30730","(۳۰۷۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ: کَتَبَ رَجُلٌ مُصْحَفًا وَکَتَبَ عِنْدَ کُلِّ آیَۃٍ تَفْسِیرَہَا ، فَدَعَا بِہِ عُمَرُ فَقَرَضَہُ بِالْمِقْرَاضَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 30730","","","كتاب فضائل القرآن"
"30731","(۳۰۷۳۱) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الْعَوَّامِ بْنِ حَوْشَبٍ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، أَنَّ أَبَا بَکْرٍ سُئِلَ عَن (وفَاکِہَۃً وَأَبًّا) فَقَالَ: أَیُّ سَمَائٍ تُظِلُّنِی وَأَیُّ أَرْضٍ تُقِلُّنِی إذَا قُلْتُ فِی کِتَابِ اللہِ مَا لاَ أَعْلَمُ۔","","Musannaf Ibn Abi Shaybah 30731","","","كتاب فضائل القرآن"
"30732","(۳۰۷۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ عبد اللہِ الزُّبَیْرِیُّ ، عَن سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی وَائِلٍ ، قَالَ: کَانَ إذَا سُئِلَ عَن شَیْئٍ مِنَ الْقُرْآنِ ، قَالَ: قَدْ أَصَابَ اللَّہُ مَا أَرَادَ۔","","Musannaf Ibn Abi Shaybah 30732","","","كتاب فضائل القرآن"
"30733","(۳۰۷۳۳) حَدَّثَنَا الثَّقَفِیُّ ، عَن شُعَیْبٍ ، قَالَ: کَانَ أَبُو الْعَالِیَۃِ یُقْرِئُ النَّاسَ الْقُرْآنَ ، فَإِذَا أَرَادَ أَنْ یُغَیِّرَ علی الرجل لَمْ یَقُلْ: لَیْسَ کَذَا وَکَذَا ، وَلَکِنَّہُ یَقُولُ: اقْرَأْ آیَۃَ کَذَا ، فَذَکَرْتہ لإِبْرَاہِیمَ فَقَالَ: أَظُنُّ صَاحِبَکُمْ قَدْ سَمِعَ ، أَنَّہُ مَنْ کَفَرَ بِحَرْفٍ مِنْہُ ، فَقَدْ کَفَرَ بِہِ کُلِّہِ۔","","Musannaf Ibn Abi Shaybah 30733","","","كتاب فضائل القرآن"
"30734","(۳۰۷۳۴) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ: أَمْسَکْت عَلَی عَبْدِ اللہِ فِی الْمُصْحَفِ فَقَالَ: کَیْفَ رَأَیْت ؟ قُلْتُ: قَرَأْتہَا کَمَا ہِیَ فِی الْمُصْحَفِ إِلاَّ حَرْفَ کَذَا قَرَأْتُہُ کَذَا وَکَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 30734","","","كتاب فضائل القرآن"
"30735","(۳۰۷۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، قَالَ: کُنْتُ أَقْرَأُ عَلَی إبْرَاہِیمَ فَإِذَا مَرَرْت بِحَرْفٍ یُنْکِرُہُ لَمْ یَقُلْ لِی: لَیْسَ کَذَا وَکَذَا ، وَیَقُولُ: کَانَ عَلْقَمَۃُ یَقْرَأُہ کَذَا وَکَذَا۔","","Musannaf Ibn Abi Shaybah 30735","","","كتاب فضائل القرآن"
"30736","(۳۰۷۳۶) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنِ الأَعْمَشِ ، قَالَ: قَالَ لِی إبْرَاہِیمُ: إنَّ إبْرَاہِیمَ التَّیْمِیَّ یُرِیدُ أَنْ تُقْرِئَہُ قِرَائَۃَ عَبْدِ اللہِ ، قُلْتُ: لاَ أَسْتَطِیعُ ، قَالَ: بَلَی ، فَإِنَّہُ قَدْ أَرَادَ ذَاکَ ، قَالَ: فَلَمَّا رَأَیْتہ قَدْ ہَوِی ذَاکَ ، قُلْتُ: فَیَکُونُ ہَذَا بِمَحْضَرٍ مِنْک فَنَتَذَاکَرُ حُرُوفَ عَبْدِ اللہِ فَقَالَ: اکفنی ہَذَا ، قُلْتُ: وَمَا تَکْرَہُ مِنْ ہَذَا ؟ قَالَ أَکْرَہُ أَنْ أَقُولَ لِشَیْئٍ ہُوَ ہَکَذَا ، وَلَیْسَ ہُوَ ہَکَذَا ، أَوْ أَقُولُ فِیہَا وَاوٌ وَلَیْسَ فِیہَا وَاوٌ۔","","Musannaf Ibn Abi Shaybah 30736","","","كتاب فضائل القرآن"
"30737","(۳۰۷۳۷) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ: سَأَلَ رَجُلٌ ابْنَ مَسْعُودٍ: {وَالَّذِینَ آمَنُوا وَاتَّبَعَتْہُمْ ذُرِّیَّتُہُمْ} فَجَعَلَ الرَّجُلُ یَقُولُ: ذُرِّیَاتُہُم ، فَجَعَلَ الرَّجُلُ یُرَدِّدُہَا وَیُرَدِّدُہَا ، وَلا یَقُولُ: لَیْسَ کَذَا۔","","Musannaf Ibn Abi Shaybah 30737","","","كتاب فضائل القرآن"
"30738","(۳۰۷۳۸) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ: إنِّی لأَکْرَہُ أَنْ أَشْہَدَ عَرْضَ الْقُرْآنِ فَأَقُولُ کَذَا وَلَیْسَ کَذَا۔","No Data Available","Musannaf Ibn Abi Shaybah 30738","","","كتاب فضائل القرآن"
"30739","(۳۰۷۳۹) حَدَّثَنَا جَرِیرٌ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَانَ یَکْرَہُ أَنْ یَقْرَأَ الْقُرْآنَ یَعْرِضُ مِنْ أَمْرِ الدُّنْیَا۔","","Musannaf Ibn Abi Shaybah 30739","","","كتاب فضائل القرآن"
"30740","(۳۰۷۴۰) حَدَّثَنَا حَفْصٌ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ: کَانَ أَبِی إذَا رَأَی شَیْئًا مِنْ أَمْرِ الدُّنْیَا یُعْجِبُہُ ، قَالَ: لاَ تَمُدَّنَّ عَیْنَیْکَ إِلَی مَا مَتَّعْنَا بِہِ أَزْوَاجًا مِنْہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 30740","","","كتاب فضائل القرآن"
"30741","(۳۰۷۴۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَن عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، عَنْ أَبِیہِ ، عَن أُمِّ أَیُّوبَ قَالَتْ: قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: نَزَلَ الْقُرْآنُ عَلَی سَبْعَۃِ أَحْرُفٍ أَیُّہَا قَرَأْت أَصَبْت۔ (احمد ۴۳۳۔ حمیدی ۳۴۰)","Sahih","Musannaf Ibn Abi Shaybah 30741","","","كتاب فضائل القرآن"
"30742","(۳۰۷۴۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: نَزَلَ الْقُرْآنُ عَلَی سَبْعَۃِ أَحْرُفٍ کُلٌّ شَافٍ کَافٍ۔ (طبری ۱۹)","","Musannaf Ibn Abi Shaybah 30742","","","كتاب فضائل القرآن"
"30743","(۳۰۷۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ: حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: نَزَلَ الْقُرْآنُ عَلَی سَبْعَۃِ أَحْرُفٍ عَلِیمًا حَکِیمًا ، غَفُورًا رَحِیمًا۔n(احمد ۳۳۲۔ ابن حبان ۷۴۳)","Hasan","Musannaf Ibn Abi Shaybah 30743","","","كتاب فضائل القرآن"
"30744","(۳۰۷۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ: حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، قَالَ: حَدَّثَنِی عَبْدُ اللہِ بْنُ عِیسَی ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ ، أَخْبَرَنِی أُبَیّ بْنُ کَعْبٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ: إنَّ رَبِّی أَرْسَلَ إلَیَّ: أَنِ اقْرَإِ الْقُرْآنَ عَلَی سَبْعَۃِ أَحْرُفٍ۔ (مسلم ۵۶۲۔ ابن حبان ۷۴۰)","Sahih","Musannaf Ibn Abi Shaybah 30744","","","كتاب فضائل القرآن"
"30745","(۳۰۷۴۵) حَدَّثَنَا غُنْدَر ، عَنْ شُعْبَۃ ، عَنِ الحَکْم ، عَنْ مُجَاہِدْ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ أُبَیِّ بْنِ کَعْبٍ ، أَنَّ النَّبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَتَاہُ جِبْرِیلُ فَقَالَ: إنَّ اللَّہَ یَأْمُرُک أَنْ تُقْرِئَ أُمَّتُک الْقُرْآنَ عَلَی سَبْعَۃِ أَحْرُفٍ فَأَیُّمَا حَرْفٍ قَرَؤُوا عَلَیْہِ ، فَقَدْ أَصَابُوا۔ (مسلم ۵۶۲۔ ابوداؤد ۱۴۷۳)","Sahih","Musannaf Ibn Abi Shaybah 30745","","","كتاب فضائل القرآن"
"30746","(۳۰۷۴۶) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنِ الْہَجَرِیِّ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: نَزَلَ الْقُرْآنُ عَلَی سَبْعَۃِ أَحْرُفٍ۔ (ابن حبان ۷۵۔ طبری ۱۲)","Da'if","Musannaf Ibn Abi Shaybah 30746","","","كتاب فضائل القرآن"
"30747","(۳۰۷۴۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدِ بْنِ جُدْعَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرٍ ، عَنْ أَبِیہِ ، أَنَّ جِبْرِیلَ ، قَالَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: اقْرَإِ الْقُرْآنَ عَلَی حَرْفٍ ، فَقَالَ لَہُ مِیکَائِیلُ: اسْتَزِدْہُ ، فَقَالَ: عَلَی حَرْفَیْنِ ، ثُمَّ قَالَ: اسْتَزِدْہُ ، حَتَّی بَلَغَ سَبْعَۃَ أَحْرُفٍ ، کُلُّہَا شَافٍ کَافٍ کَقَوْلِکَ: ہَلُمَّ وَتَعَالَ ، مَا لَمْ یَخْتِمْ آیَۃَ رَحْمَۃٍ بِآیَۃِ عَذَابٍ ، أَوْ آیَۃَ عَذَابٍ بِرَحْمَۃٍ۔ (احمد ۴۱)","Da'if","Musannaf Ibn Abi Shaybah 30747","","","كتاب فضائل القرآن"
"30748","(۳۰۷۴۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن حُمَیْدٍ ، عَنْ أَنَسٍ ، عَن أُبَیٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ اقْرَإِ الْقُرْآنَ عَلَی سَبْعَۃِ أَحْرُفٍ ، کُلٌّ شَافٍ کَافٍ۔ (احمد ۱۱۴۔ ابن حبان ۷۴۲)","Sahih","Musannaf Ibn Abi Shaybah 30748","","","كتاب فضائل القرآن"
"30749","(۳۰۷۴۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی عَنْ إِسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ عَنْ سُقَیْرٍ الْعَبْدِیِّ عَنْ سُلَیْمَانَ بْنِ صُرَدٍ عَنْ أُبَیٍّ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ: اقْرَأْہُ عَلَی سَبْعَۃِ أَحْرُفٍ۔ (ابوداؤد ۱۴۷۲۔ احمد ۱۲۴)","Da'if","Musannaf Ibn Abi Shaybah 30749","","","كتاب فضائل القرآن"
"30750","(۳۰۷۵۰) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَن سَمُرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: نَزَلَ الْقُرْآنُ عَلَی ثَلاثَۃِ أَحْرُفِ۔ (احمد ۱۶۔ طبرانی ۶۸۵۳)","Hasan","Musannaf Ibn Abi Shaybah 30750","","","كتاب فضائل القرآن"
"30751","(۳۰۷۵۱) حَدَّثَنَا خَالِدُ بْنُ مِجْلَزٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ الْعَزِیزِ الأَنْصَارِیِّ ، عَنِ الزُّہْرِیِّ ، عَن عُرْوَۃَ بْنِ الزُّبَیْرِ ، عَنِ الْمِسْوَرِ بْنِ مَخْرَمَۃَ ، وَعَبْدِ الرَّحْمَنِ بْنِ عَبْد الْقَارِی ، قَالا: سَمِعْنَا عُمَرَ بْنَ الْخَطَّابِ یَقُولُ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إنَّ الْقُرْآنَ نَزَلَ عَلَی سَبْعَۃِ أَحْرُفٍ فَاقْرَؤُوا مَا تَیَسَّرَ مِنْہُ۔n(بخاری ۲۴۱۹۔ مسلم ۵۶۰)","Sahih","Musannaf Ibn Abi Shaybah 30751","","","كتاب فضائل القرآن"
"30752","(۳۰۷۵۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، عَن أُبَیٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أنَّ جِبْرِیلَ لقیہ فَقَالَ: مُرْہُمْ فَلْیَقْرَؤُوہُ عَلَی سَبْعَۃِ أَحْرُفٍ۔ (ترمذی ۲۹۴۴۔ ابن حبان ۷۳۹)","Da'if","Musannaf Ibn Abi Shaybah 30752","","","كتاب فضائل القرآن"
"30753","(۳۰۷۵۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن شَقِیقٍ ، عَن مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: خُذُوا الْقُرْآنَ مِنْ أَرْبَعَۃٍ مِنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ وَمُعَاذِ بْنِ جَبَلٍ وَأُبَیُّ بْنِ کَعْبٍ وَسَالِمٍ مَوْلَی أَبِی حُذَیْفَۃَ۔ (بخاری ۳۷۶۰۔ مسلم ۱۹۱۴)","Sahih","Musannaf Ibn Abi Shaybah 30753","","","كتاب فضائل القرآن"
"30754","(۳۰۷۵۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ: قرَأْت عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ لِی: أَحْسَنْت۔ (مسلم ۵۵۱۔ احمد ۴۲۴)","Sahih","Musannaf Ibn Abi Shaybah 30754","","","كتاب فضائل القرآن"
"30755","(۳۰۷۵۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، عَن حَبِیبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ خَطَبَنَا عُمَرُ فَقَالَ: عَلِیٌّ أَقْضَانَا وَأُبَیٌّ أَقْرَؤُنَا ، وَإِنَّا نَتْرُکُ أَشْیَائَ مِمَّا یَقْرَأُ أُبَیٌّ وَإِنَّ أُبَیًّا یَقُولُ: سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلا أَتْرُکُ قَوْلَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِشَیْئٍ ، وَقَدْ نَزَلَ بَعْدَ أُبَیٍّ کِتَابٌ۔","Sahih","Musannaf Ibn Abi Shaybah 30755","","","كتاب فضائل القرآن"
"30756","(۳۰۷۵۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَن قَبِیصَۃَ بْنِ جَابِرٍ ، قَالَ: مَا رَأَیْت أَحَدًا کَانَ أَقْرَأَ لِکِتَابِ اللہِ ، وَلا أَفْقَہَ فِی دِینِ اللہِ ، وَلا أَعْلَمَ بِاللہِ مِنْ عُمَرَ۔","Hasan","Musannaf Ibn Abi Shaybah 30756","","","كتاب فضائل القرآن"
"30757","(۳۰۷۵۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَن دَاوُد بْنِ شَابُورَ ، عَن مُجَاہِدٍ ، قَالَ: کُنَّا نَفْخَرُ عَلَی النَّاسِ بِقَارِئنَا عَبْدِ اللہِ بْنِ السَّائِبِ۔","","Musannaf Ibn Abi Shaybah 30757","","","كتاب فضائل القرآن"
"30758","(۳۰۷۵۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنِ ابْنِ عُیَیْنَۃَ ، عَن دَاوُد بْنِ شَابُورَ ، عَن مُجَاہِدٍ ، قَالَ: کُنْتُ أفخر النَّاسَ بِالْحِفْظِ لِلْقُرْآنِ حَتَّی صَلَّیْت خَلْفَ مَسْلَمَۃَ بْنِ مَخْلَدٍ ، فَافْتَتَحَ الْبَقَرَۃَ فَمَا أَخْطَأَ فِیہَا وَاوًا ، وَلا أَلِفًا۔","","Musannaf Ibn Abi Shaybah 30758","","","كتاب فضائل القرآن"
"30759","(۳۰۷۵۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَمْرٍو ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ سَرَّہُ أَنْ یَقْرَأَ الْقُرْآنَ رَطْبًا کَمَا أُنْزِلَ فَلْیَقْرَأْ عَلَی قِرَائَۃِ ابْنِ أُمِّ عَبْدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30759","","","كتاب فضائل القرآن"
"30760","(۳۰۷۶۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ: حدَّثَنَا عِیسَی بْنُ دِینَارٍ مَوْلَی عَمْرِو بْنِ الْحَارِثِ ، قَالَ: حَدَّثَنَا أَبِی ، قَالَ: سَمِعْتُ عَمْرَو بْنَ الْحَارِثِ یَقُولُ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ سَرَّہُ أَنْ یَقْرَأَ الْقُرْآنَ کَمَا أُنْزِلَ غَضًّا فَلْیَقْرَأْہُ عَلَی قِرَائَۃِ ابْنِ أُمِّ عَبْدٍ۔ (بخاری ۱۹۲)","Da'if","Musannaf Ibn Abi Shaybah 30760","","","كتاب فضائل القرآن"
"30761","(۳۰۷۶۱) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ عَمَّارِ بْنِ أَبِی عَمَّارٍ ، قَالَ: سَمِعْتُ أَبَا حَبَّۃَ الْبَدْرِیَّ قَالَ: لَمَّا نَزَلَتْ: {لَمْ یَکُنِ الَّذِینَ کَفَرُوا مِنْ أَہْلِ الْکِتَابِ} إِلَی آخِرِہَا ، قَالَ جِبْرِیلُ: یَا رَسُولَ اللہِ ، إنَّ رَبَّک یَأْمُرُک أَنْ تُقْرِئَہَا أُبَیًّا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأُبَیٍّ: إنَّ جِبْرِیلَ أَمَرَنِی أَنْ أُقْرِئَک ہَذِہِ السُّورَۃَ ، قَالَ أُبَیٌّ: أَذَکَرَنِی یَا رَسُولَ اللہِ ؟ قَالَ: نَعَمْ۔ (احمد ۴۸۹۔ مسند ۷۲۳)","Da'if","Musannaf Ibn Abi Shaybah 30761","","","كتاب فضائل القرآن"
"30762","(۳۰۷۶۲) حَدَّثَنَا مُعَاوِیَۃُ بْنُ عَمْرو ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: مَنْ أَحَبَّ أَنْ یَقْرَأَ الْقُرْآنَ غَضًّا کَمَا أُنْزِلَ فَلْیَقْرَأْہُ عَلَی قِرَائَۃِ ابْنِ أُمِّ عَبْدٍ۔ (احمد ۴۴۵۔ ابن حبان ۷۰۶۶)","Da'if","Musannaf Ibn Abi Shaybah 30762","","","كتاب فضائل القرآن"
"30763","(۳۰۷۶۳) حَدَّثَنَا مُصْعَبُ بْنُ الْمِقْدَامِ ، عَنْ إسْرَائِیلَ ، عَن مُغِیرَۃَ ، أَنَّہُ سَمِعَ إبْرَاہِیمَ یَقُولُ: قدْ قَرَأَ عَبْدُ اللہِ القرآن عَلَی ظَہْرِ لِسَانِہِ۔","","Musannaf Ibn Abi Shaybah 30763","","","كتاب فضائل القرآن"
"30764","(۳۰۷۶۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن مَنْصُورِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ الشَّعْبِیِّ ، قَالَ: مَاتَ أَبُو بَکْرٍ ، وَعُمَرُ وَعَلِیٌّ وَلَمْ یَجْمَعُوا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 30764","","","كتاب فضائل القرآن"
"30765","(۳۰۷۶۵) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَن مَنْصُورٍ، عَن مُجَاہِدٍ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: أُنْزِلَتْ فَاتِحَۃُ الْکِتَابِ بِالْمَدِینَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 30765","","","كتاب فضائل القرآن"
"30766","(۳۰۷۶۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ: مَا کَانَ مِنْ حَجٍّ ، أَوْ فَرِیضَۃٍ فَإِنَّہُ نَزَلَ بِالْمَدِینَۃِ ، وَمَا کَانَ مِنْ ذِکْرِ الأُمَمِ وَالْقُرُونِ وَالْعَذَابِ فَإِنَّہُ أُنْزِلَ بِمَکَّۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30766","","","كتاب فضائل القرآن"
"30767","(۳۰۷۶۷) حَدَّثَنَا وَکِیعٌ ، عَن سَلَمَۃَ ، عَنِ الضَّحَّاکِ: یَا أَیُّہَا الَّذِینَ آمَنُوا فِی الْمَدِینَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30767","","","كتاب فضائل القرآن"
"30768","(۳۰۷۶۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عن علقمۃ قَالَ: کُلُّ شَیْئٍ فِی الْقُرْآنِ یَا أَیُّہَا الَّذِینَ آمَنُوا أُنْزِلَ بِالْمَدِینَۃِ ، وَکُلُّ شَیْئٍ فِی الْقُرْآنِ یَا أَیُّہَا النَّاسُ أُنْزِلَ بِمَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 30768","","","كتاب فضائل القرآن"
"30769","(۳۰۷۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ ، قَالَ: قَرَأْنَا الْمُفَصَّلَ حُجَجًا وَنَحْنُ بِمَکَّۃَ لَیْسَ فِیہَا یَا أَیُّہَا الَّذِینَ آمَنُوا۔","Sahih","Musannaf Ibn Abi Shaybah 30769","","","كتاب فضائل القرآن"
"30770","(۳۰۷۷۰) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَیُّوبَ ، عَن عِکْرِمَۃَ ، قَالَ: کُلُّ سُورَۃٍ فِیہَا یَا أَیُّہَا الَّذِینَ آمَنُوا فَہِیَ مَدَنِیَّۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 30770","","","كتاب فضائل القرآن"
"30771","(۳۰۷۷۱) حَدَّثَنَا أَبُو أُسَامَۃَ، عَن زَائِدَۃَ، عَن مَنْصُورٍ، عَن مُجَاہِدٍ، قَالَ: الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ أُنْزِلَتْ بِالْمَدِینَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30771","","","كتاب فضائل القرآن"
"30772","(۳۰۷۷۲) حَدَّثَنَا قَبِیصَۃُ ، عَن سُفْیَانَ ، عَن لَیْثٍ ، عَن شَہْرٍ ، قَالَ: الأَنْعَامُ مَکِّیَّۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 30772","","","كتاب فضائل القرآن"
"30773","(۳۰۷۷۳) حَدَّثَنَا أَبُو أَحْمَدَ ، عَنْ مِسْعَر ، عَنِ النَّضْرِ بْنِ قَیْسٍ ، عَن عُرْوَۃَ: مَا کَانَ {یَا أَیُّہَا النَّاسُ} بِمَکَّۃَ ، وَمَا کَانَ {یَا أَیُّہَا الَّذِینَ آمَنُوا} بِالْمَدِینَۃِ۔","","Musannaf Ibn Abi Shaybah 30773","","","كتاب فضائل القرآن"
"30774","(۳۰۷۷۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ: ذَکَرُوا عِنْدَ الشَّعْبِیِّ قَوْلَہُ: {وَشَہِدَ شَاہِدٌ مِنْ بَنِی إسْرَائِیلَ علی مثلہ} فَقِیلَ: عَبْدُ اللہِ بْنُ سَلامٍ ، فَقَالَ: کَیْفَ یَکُونُ ابْنُ سَلامٍ وَہَذِہِ السُّورَۃُ مَکِّیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 30774","","","كتاب فضائل القرآن"
"30775","(۳۰۷۷۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَن ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ: إنِّی لأَعْلَمُ مَا نَزَلَ مِنَ الْقُرْآنِ بِمَکَّۃَ ، وَمَا أُنْزِلَ بِالْمَدِینَۃِ ، فَأَمَّا مَا نَزَلَ بِمَکَّۃَ فَضَرْبُ الأَمْثَالِ وَذِکْرُ الْقُرُونِ ، وَأَمَّا مَا نَزَلَ بِالْمَدِینَۃِ فَالْفَرَائِضُ وَالْحُدُودُ وَالْجِہَادُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30775","","","كتاب فضائل القرآن"
"30776","(۳۰۷۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَن قَتَادَۃَ ، قَالَ: سَأَلْتُ أَنَسًا ، عَن قِرَائَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ: یَمُدُّ بِہَا صَوْتَہُ مَدًّا۔","Sahih","Musannaf Ibn Abi Shaybah 30776","","","كتاب فضائل القرآن"
"30777","(۳۰۷۷۷) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَن أُمِّ سَلَمَۃَ قَالَتْ: کَانَت قِرَائَ ۃُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ} فَذَکَرَتْ حَرْفًا حَرْفًا۔","","Musannaf Ibn Abi Shaybah 30777","","","كتاب فضائل القرآن"
"30778","(۳۰۷۷۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَانَ عَلْقَمَۃُ یَقْرَأُ عَلَی عَبْدِ اللہِ فَقَالَ: رَتِّلْ فِدَاک أَبِی وَأُمِّی فَإِنَّہُ زَیْنُ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30778","","","كتاب فضائل القرآن"
"30779","(۳۰۷۷۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، قَالَ: کَانَ ابْنُ سِیرِینَ إذَا قَرَأَ یَمْضِی فِی قِرَائَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30779","","","كتاب فضائل القرآن"
"30780","(۳۰۷۸۰) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ، عَن عُثْمَانَ بْنِ الأَسْوَدِ، عَن مُجَاہِدٍ، وَعَطَائٍ أَنَّہُمَا کَانَا یَہُذَّانِ الْقِرَائَۃَ ہَذًّا۔","No Data Available","Musannaf Ibn Abi Shaybah 30780","","","كتاب فضائل القرآن"
"30781","(۳۰۷۸۱) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَن سَلَمَۃَ بْنِ کُہَیْلٍ، عَن حُجْرِ بْنِ عَنْبَسَ، عَن وَائِلِ بْنِ حُجْرٍ، قَالَ سَمِعْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ: {وَلا الضَّالِّینَ} فَقَالَ: آمِینَ یَمُدُّ بِہَا صَوْتَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30781","","","كتاب فضائل القرآن"
"30782","(۳۰۷۸۲) حَدَّثَنَا وَکِیعٌ ، عَن عِیسَی ، عَنِ الشَّعْبِیِّ ، قَالَ: قَالَ عَبْدُ اللہِ لاَ تَہُذُّوا الْقُرْآنَ کَہَذِّ الشِّعْرِ ، وَلا تَنْثُرُوہُ نَثْرَ الدَّقَلِ۔","","Musannaf Ibn Abi Shaybah 30782","","","كتاب فضائل القرآن"
"30783","(۳۰۷۸۳) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَن مَنْصُورٍ، عَن مُجَاہِدٍ: {وَرَتِّلِ الْقُرْآنَ تَرْتِیلاً} قَالَ: بَعْضُہُ عَلَی أَثَرِ بَعْضٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 30783","","","كتاب فضائل القرآن"
"30784","(۳۰۷۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَن مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ: {وَرَتِّلِ الْقُرْآنَ تَرْتِیلاً} قَالَ بَیِّنْہُ تَبْیِینًا۔","Da'if","Musannaf Ibn Abi Shaybah 30784","","","كتاب فضائل القرآن"
"30785","(۳۰۷۸۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن عُبَیْدٍ الْمُکَتِّبِ ، قَالَ: سُئِلَ مُجَاہِدٌ ، عَن رَجُلَیْنِ قَرَأَ أَحَدُہُمَا الْبَقَرَۃَ وَقَرَأَ آخَرُ الْبَقَرَۃَ وَآلَ عِمْرَانَ ، فَکَانَ رُکُوعُہُمَا وَسُجُودُہُمَا وَجُلُوسُہُمَا سَوَائً أَیُّہُمَا أَفْضَلُ ؟ قَالَ: الَّذِی قَرَأَ الْبَقَرَۃَ ، ثُمَّ قَرَأَ مُجَاہِدٌ: {وَقُرْآنًا فَرَقْنَاہُ لِتَقْرَأَہُ عَلَی النَّاسِ عَلَی مُکْثٍ وَنَزَّلْنَاہُ تَنْزِیلاً}۔","","Musannaf Ibn Abi Shaybah 30785","","","كتاب فضائل القرآن"
"30786","(۳۰۷۸۶) حَدَّثَنَا وَکِیعٌ قَالَ: حَدَّثَنَا عُبَیْدُاللہِ بْنُ عَبْدِالرَّحْمَنِ بْنُ مَوْہَبٍ، قَالَ: سَمِعْتُ مُحَمَّدَ بْنَ کَعْبٍ الْقُرَظِیَّ یَقُولُ: لأَنْ أَقْرَأَ: {إذَا زُلْزِلَتْ} وَ {الْقَارِعَۃُ} أُرَدِّدُہُمَا وَأَتَفَکَّرُ فِیہِمَا أَحَبُّ إلَیَّ مِنْ أَنْ أَہُذَّ الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 30786","","","كتاب فضائل القرآن"
"30787","(۳۰۷۸۷) حَدَّثَنَا مَعْنُ بْنُ عِیسَی، عَن ثَابِتِ بْنِ قَیْسٍ، قَالَ: سَمِعْتُ عُمَرَ بْنَ عَبْدِالْعَزِیزِ إذَا قَرَأَ تَرَسَّلَ فِی قِرَائَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30787","","","كتاب فضائل القرآن"
"30788","(۳۰۷۸۸) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلابَۃَ ، أَنَّ أُنَاسًا مِنْ أَہْلِ الْکُوفَۃِ أتوا أبَا الدَّرْدَائِ، فَقَالُوا: إنَّ إخْوَانًا لک مِنْ أَہْلِ الْکُوفَۃِ یُقْرِئُ وْنَک السَّلامَ وَیَأْمُرُونَک أَنْ تُوصِیَہُمْ ، قَالَ: فَأَقْرِئُ وْہُمُ السَّلامَ وَمُرُوہُمْ فَلْیُعْطُوا الْقُرْآنَ خَزَائِمَہُ ، فَإِنَّہُ یَحْمِلُہُمْ عَلَی الْقَصْدِ وَالسُّہُولَۃِ ، وَیُجَنِّبُہُمُ الْجَوْرَ وَالْحُزُونَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 30788","","","كتاب فضائل القرآن"
"30789","(۳۰۷۸۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلابَۃَ ، قَالَ: قَالَ أَبُو الدَّرْدَائِ: لاَ تَفْقَہُ کُلَّ الْفِقْہِ حَتَّی تَرَی لِلْقُرْآنِ وُجُوہًا کَثِیرَۃً۔","","Musannaf Ibn Abi Shaybah 30789","","","كتاب فضائل القرآن"
"30790","(۳۰۷۹۰) حَدَّثَنَا ہَوْذَۃُ بْنُ خَلِیفَۃ ، قَالَ: حدَّثَنَا عَوْفٌ ، عَن زِیَادِ بْنِ مِخْرَاقٍ ، عَنْ أَبِی کِنَانَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ: أَعْطُوا الْقُرْآنَ خَزَائِمَہُ ، یَأْخُذْ بِکُمُ الْقَصْدَ وَالسُّہُولَۃَ وَیُجَنِّبْکُمُ الْجَوْرَ وَالْحُزُونَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 30790","","","كتاب فضائل القرآن"
"30791","(۳۰۷۹۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، عَن مُحَمَّدِ بْنِ إبْرَاہِیمَ ، عَن سَعْدٍ مَوْلَی عَمْرِو بْنِ الْعَاصِ ، قَالَ: تَشَاجَرَ رَجُلانِ فِی آیَۃٍ فَارْتَفَعَا إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: لاَ تُمَاروا فِیہِ فَإِنَّ مراء فِیہِ کُفْرٌ۔ (احمد ۲۰۴۔ بیہقی ۲۲۶۶)","","Musannaf Ibn Abi Shaybah 30791","","","كتاب فضائل القرآن"
"30792","(۳۰۷۹۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃَ ، قَالَ: أَخْبَرَنِی عَبْدُ اللہِ بْنُ یَزِیدَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: دَعُوا الْمِرَائَ فِی الْقُرْآنِ فَإِنَّ الأُمَمَ قَبْلَکُمْ لَمْ یُلْعَنُوا حَتَّی اخْتَلَفُوا فِی الْقُرْآنِ ، فَإِنَّ مِرَائً فِی الْقُرْآنِ کُفْرٌ۔","Da'if","Musannaf Ibn Abi Shaybah 30792","","","كتاب فضائل القرآن"
"30793","(۳۰۷۹۳) حَدَّثَنَا مَالِکٌ ، حَدَّثَنَا أَبُو قُدَامَۃَ ، قَالَ: حدَّثَنَا أَبُو عِمْرَانَ الْجَوْنِیُّ ، عَن جُنْدُبِ بْنِ عَبْدِ اللہِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: اقْرَؤُوا الْقُرْآنَ مَا ائْتَلَفَتْ عَلَیْہِ قُلُوبُکُمْ ، فَإِذَا اخْتَلَفْتُمْ فِیہِ فَقُومُوا۔n(بخاری ۵۰۶۱۔ مسلم ۲۰۵۳)","Sahih","Musannaf Ibn Abi Shaybah 30793","","","كتاب فضائل القرآن"
"30794","(۳۰۷۹۴) حَدَّثَنَا حَفْص ، عَن لَیْثٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: لاَ تَضْرِبُوا الْقُرْآنَ بَعْضَہُ بِبَعْضٍ فَإِنَّ ذَلِکَ یُوقِعُ الشَّکَّ فِی الْقُلُوبِ۔","Da'if","Musannaf Ibn Abi Shaybah 30794","","","كتاب فضائل القرآن"
"30795","(۳۰۷۹۵) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی التَّیْمِیُّ ، عَن مَنْصُورٍ ، عَن سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: جِدَالٌ فِی الْقُرْآنِ کُفْرٌ۔ (احمد ۴۷۸۔ ابویعلی ۵۹۹۰)","Sahih","Musannaf Ibn Abi Shaybah 30795","","","كتاب فضائل القرآن"
"30796","(۳۰۷۹۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن شُعْبَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، قَالَ: سَمِعْتُ النَّزَّالَ یَقُولُ: قَالَ عَبْدُ اللہِ: سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: إنَّ مَنْ قَبْلَکُمُ اخْتَلَفُوا فِیہِ فَأَہْلَکَہُمْ فَلا تَخْتَلِفُوا فِیہِ یَعْنِی فی الْقُرْآنِ۔ (بخاری ۲۴۱۰۔ احمد ۳۹۳)","Sahih","Musannaf Ibn Abi Shaybah 30796","","","كتاب فضائل القرآن"
"30797","(۳۰۷۹۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ: مَثَلُ الَّذِی جَمَعَ الإِیمَانَ وَجَمَعَ الْقُرْآنَ مِثْلُ الأُتْرُجَّۃِ الطَّیِّبَۃِ الطَّعْمِ ، وَمَثَلُ الَّذِی لَمْ یَجْمَعِ الإِیمَانَ وَلَمْ یَجْمَعِ الْقُرْآنَ مِثْلُ الْحَنْظَلَۃِ خَبِیثَۃُ الطَّعْمِ وَخَبِیثَۃُ الرِّیحِ۔ (دارمی ۳۳۶۲)","Da'if","Musannaf Ibn Abi Shaybah 30797","","","كتاب فضائل القرآن"
"30798","(۳۰۷۹۸) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا ہَمَّامٌ ، قَالَ: حَدَّثَنَا قَتَادَۃُ ، عَنْ أَنَسٍ ، أَنَّ أَبَا مُوسَی حَدَّثَہُ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ: مَثَلُ الْمُؤْمِنِ الَّذِی لاَ یَقْرَأُ الْقُرْآنَ کَمَثَلِ التَّمْرَۃِ طَعْمُہَا طَیِّبٌ ، وَلا رِیحَ لَہَا ، وَمَثَلُ الْمُؤْمِنِ الَّذِی یَقْرَأُ الْقُرْآنَ کَمَثَلِ الأُتْرُجَّۃِ طَیِّبَۃُ الطَّعْمِ طَیِّبَۃُ الرِّیحِ ، وَمَثَلُ الْفَاجِرِ الَّذِی لاَ یَقْرَأُ الْقُرْآنَ کَمَثَلِ الْحَنْظَلَۃِ طَعْمُہَا مُرٌّ ، وَلا رِیحَ لَہَا۔ (بخاری ۵۰۲۰۔ ابن حبان ۷۷۰)","Sahih","Musannaf Ibn Abi Shaybah 30798","","","كتاب فضائل القرآن"
"30799","(۳۰۷۹۹) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنِ الأَعْمَشِ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ، قَالَ: الْقُرْآنُ وَحْشِیٌّ، وَلا یَصْلُحُ مَعَ اللَّغَطِ۔","","Musannaf Ibn Abi Shaybah 30799","","","كتاب فضائل القرآن"
"30800","(۳۰۸۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیّ ، عَن قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَن قَیْسِ بْنِ عُبَادٍ ، قَالَ: کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَکْرَہُونَ رَفْعَ الصَّوْتِ عِنْدَ الذِّکْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 30800","","","كتاب فضائل القرآن"
"30801","(۳۰۸۰۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنِ الْحَسَنِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَکْرَہُ رَفْعَ الصَّوْتِ عِنْدَ قِرَائَۃِ الْقُرْآنِ۔","Da'if","Musannaf Ibn Abi Shaybah 30801","","","كتاب فضائل القرآن"
"30802","(۳۰۸۰۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن خَیْثَمَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ: انْتَہَیْت إلَیْہِ وَہُوَ یَنْظُرُ فِی الْمُصْحَفِ ، قَالَ: قُلْتُ: أَیُّ شَیْئٍ تَقْرَأُ فِی الْمُصْحَفِ ؟ قَالَ: حِزْبِی الَّذِی أَقُومُ بِہِ اللَّیْلَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 30802","","","كتاب فضائل القرآن"
"30803","(۳۰۸۰۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، قَالَ: قَالَ عَبْدُ اللہِ: أَدِیمُوا النَّظَرَ فِی الْمَصَاحِفِ۔","Da'if","Musannaf Ibn Abi Shaybah 30803","","","كتاب فضائل القرآن"
"30804","(۳۰۸۰۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی مُوسَی ، عَنِ الْحَسَنِ ، قَالَ: دَخَلُوا عَلَی عُثْمَانَ وَالْمُصْحَفُ فِی حِجْرِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 30804","","","كتاب فضائل القرآن"
"30805","(۳۰۸۰۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُس ، قَالَ: کَانَ من خُلُقُ الأَوَّلِینَ النَّظَرَ فِی الْمَصَاحِفِ ، وَکَانَ الأَحْنَفُ بْنُ قَیْسٍ إذَا خَلا نَظَرَ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 30805","","","كتاب فضائل القرآن"
"30806","(۳۰۸۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَن سُرِّیَّۃَ الرَّبِیعِ قَالَتْ: کَانَ الرَّبِیعُ یَقْرَأُ فِی الْمُصْحَفِ ، فَإِذَا دَخَلَ إنْسَانٌ غَطَّاہُ ، وَقَالَ: لاَ یَرَی ہَذَا أَنِّی أَقْرَأُ فِیہِ کُلَّ سَاعَۃٍ۔","","Musannaf Ibn Abi Shaybah 30806","","","كتاب فضائل القرآن"
"30807","(۳۰۸۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، قَالَ: کَانَ إبْرَاہِیمُ یَقْرَأُ فِی الْمُصْحَفِ فَإِذَا دَخَلَ عَلَیْہِ إنْسَانٌ غَطَّاہُ ، وَقَالَ: لاَ یَرَی ہَذَا أَنِّی أَقْرَأُ فِیہِ کُلَّ سَاعَۃٍ۔","","Musannaf Ibn Abi Shaybah 30807","","","كتاب فضائل القرآن"
"30808","(۳۰۸۰۸) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ قَالَتْ: إنِّی لأَقْرَأُ جزئی ، أَوْ عَامَّۃَ جزئی ، وَأَنَا مُضْطَجِعَۃٌ عَلَی فِرَاشِی۔","Sahih","Musannaf Ibn Abi Shaybah 30808","","","كتاب فضائل القرآن"
"30809","(۳۰۸۰۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن مُوسَی بْنِ عُلَیٍّ ، قَالَ: سَمِعْتُ أَبِی ، قَالَ: أَمْسَکْت عَلَی فَضَالَۃَ بْنِ عُبَیْدٍ الْقُرْآنَ حَتَّی فَرَغَ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30809","","","كتاب فضائل القرآن"
"30810","(۳۰۸۱۰) حَدَّثَنَا سُلَیْمَانُ بْنُ حَرْبٍ ، قَالَ: حدَّثَنَا أَبُو ہِلالٍ ، قَالَ: حَدَّثَنَا أَبُو صَالِحٍ الْعُقَیْلِیُّ ، قَالَ: کَانَ أَبُو الْعَلائِ یَزِیدُ بْنُ عَبْدِ اللہِ بْنِ الشِّخِّیرِ یَقْرَأُ فِی الْمُصْحَفِ حَتَّی یُغْشَی عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 30810","","","كتاب فضائل القرآن"
"30811","(۳۰۸۱۱) حَدَّثَنَا مُعْتَمِرٌ ، عَن لَیْثٍ ، قَالَ: رَأَیْتُ طَلْحَۃَ یَقْرَأُ فِی الْمُصْحَفِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30811","","","كتاب فضائل القرآن"
"30812","(۳۰۸۱۲) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَن مَنْصُورٍ، عَنْ إبْرَاہِیمَ کَرِہَ أَنْ یَقُولَ: قرَائَۃُ فُلانٍ وَیَقُولُ: کَمَا یَقْرَأُ فُلانٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 30812","","","كتاب فضائل القرآن"
"30813","(۳۰۸۱۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَن دَاوُد ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: نَزَلَ الْقُرْآنُ جُمْلَۃً مِنَ السَّمَائِ الْعُلْیَا إِلَی السَّمَائِ الدُّنْیَا فِی رَمَضَانَ ، فَکَانَ اللَّہُ إذَا أَرَادَ أَنْ یُحْدِثَ شَیْئًا أَحْدَثَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30813","","","كتاب فضائل القرآن"
"30814","(۳۰۸۱۴) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلابَۃَ ، قَالَ: نَزَلَتِ التَّوْرَاۃُ لِسِتٍّ خَلَوْنَ مِنْ رَمَضَانَ ، وَأُنْزِلَ الْقُرْآنُ لأَرْبَعٍ وَعِشْرِینَ۔","","Musannaf Ibn Abi Shaybah 30814","","","كتاب فضائل القرآن"
"30815","(۳۰۸۱۵) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَن سُفْیَانَ ، عَن خَالِدٍ ، عَنْ أَبِی قِلابَۃَ ، قَالَ: نَزَلَتِ الْکُتُبُ کلہا لَیْلَۃَ أَرْبَعٍ وَعِشْرِینَ مِنْ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 30815","","","كتاب فضائل القرآن"
"30816","(۳۰۸۱۶) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ: حدَّثَنَا عَمَّارُ بْنُ رُزَیْقٍ ، عَنِ الأَعْمَشِ ، عَن حَسَّانَ بْنِ أَبِی الأَشْرَسِ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ فِی قَوْلِہِ: إنَّا أَنْزَلْنَاہُ فِی لَیْلَۃِ الْقَدْرِ ، قَالَ: دُفِعَ إِلَی جِبْرِیلَ لَیْلَۃَ الْقَدْرِ جُمْلَۃً ،فوضع فِی بَیْتِ الْعِزَّۃِ ثم جَعَلَ یَنْزِلُہ تَنْزِیلاً۔","Hasan","Musannaf Ibn Abi Shaybah 30816","","","كتاب فضائل القرآن"
"30817","(۳۰۸۱۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن سُفْیَانَ ، قَالَ: أَخْبَرَنِی مَنْ سَمِعَ أَبَا الْعَالِیَۃَ یَذْکُرُ ، عَنْ أَبِی الْجَلْدِ ، قَالَ: نَزَلَتْ صُحُفُ إبْرَاہِیمَ أَوَّلَ لَیْلَۃٍ مِنْ رَمَضَانَ ، وَنَزَلَت الزَّبُورُ فِی سِتٍّ ، وَالإِنْجِیلُ فِی ، ثَمَانِ عَشْرَۃَ ، وَالْقُرْآنُ فِی أَرْبَعٍ وَعِشْرِینَ۔","","Musannaf Ibn Abi Shaybah 30817","","","كتاب فضائل القرآن"
"30818","(۳۰۸۱۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَبِی إِسْحَاقَ الشَّیْبَانِیِّ ، عَن وَاصِلِ بْنِ حَیَّانَ ، عَن شَقِیقِ بْنِ سَلَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ: کَیْفَ أَنْتُمْ إذَا أُسْرِیَ عَلَی کِتَابِ اللہِ فَذُہِبَ بِہِ ؟ قَالَ: یَا أَبَا عَبْدِ الرَّحْمَنِ ، کَیْفَ بِمَا فِی أَجَْوَافِ الرِّجَالِ ، قَالَ: یَبْعَثُ اللَّہُ رِیحًا طَیِّبَۃً فَتَکْفِتُ کُلَّ مُؤْمِنٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30818","","","كتاب فضائل القرآن"
"30819","(۳۰۸۱۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَن شَدَّادِ بْنِ مَعْقِلٍ ، قَالَ: قَالَ عَبْدُ اللہِ: إنَّ ہَذَا الْقُرْآنَ الَّذِی بَیْنَ أَظْہُرِکُمْ یُوشِکُ أَنْ یُنْزَعَ مِنْکُمْ ، قَالَ: قُلْتُ: کَیْفَ یُنْزَعُ مِنَّا وَقَدْ أثْبَتَہُ اللَّہُ فِی قُلُوبِنَا وَأَثْبَتْنَاہُ فِی مَصَاحِفِنَا قَالَ: یُسْرَی عَلَیْہِ فِی لَیْلَۃٍ وَاحِدَۃٍ فَیَنْتزِعُ مَا فِی الْقُلُوبِ وَیَذْہَبُ مَا فِی الْمَصَاحِفِ وَیُصْبِحُ النَّاسُ مِنْہُ فُقَرَائَ ، ثُمَّ قَرَأَ {وَلَئِنْ شِئْنَا لَنَذْہَبَنَّ بِالَّذِی أَوْحَیْنَا إلَیْک} ۔ (عبدالرزاق ۵۹۸۱)","Da'if","Musannaf Ibn Abi Shaybah 30819","","","كتاب فضائل القرآن"
"30820","(۳۰۸۲۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن سِمَاکٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لَیَقْرَأَنَّ الْقُرْآنَ أَقْوَامٌ مِنْ أُمَّتِی یَمْرُقُونَ مِنَ الإِسْلامِ کَمَا یَمْرُقُ السَّہْمُ مِنَ الرَّمِیَّۃِ۔ (ابن ماجہ ۱۷۱۔ احمد ۲۵۶)","","Musannaf Ibn Abi Shaybah 30820","","","كتاب فضائل القرآن"
"30821","(۳۰۸۲۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَن یُسَیْرِ بْنِ عَمْرٍو ، قَالَ: سَأَلْتُ سَہْلَ بْنَ حُنَیْفٍ: مَا سَمِعْتَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَذْکُرُ ہَؤُلائِ الْخَوَارِجَ ؟ ، قَالَ: سَمِعْتُہُ وَأَشَارَ بِیَدِہِ نَحْوَ الْمَشْرِقِ: یَخْرُجُ مِنْہُ قَوْمٌ یَقْرَؤُونَ الْقُرْآنَ بِأَلْسِنَتِہِمْ لاَ یَعْدُو تَرَاقِیَہُمْ ، یَمْرُقُونَ مِنَ الدِّینِ کَمَا یَمْرُقُ السَّہْمُ مِنَ الرَّمِیَّۃِ۔ (بخاری ۶۹۳۴۔ مسلم ۷۵۰)","Sahih","Musannaf Ibn Abi Shaybah 30821","","","كتاب فضائل القرآن"
"30822","(۳۰۸۲۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ: حدَّثَنِی قرۃ بْنُ خَالِدٍ السَّدُوسِیُّ ، قَالَ: حَدَّثَنِی أَبُو الزُّبَیْرِ ، عَنْ جَابِرٍ قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَجِیئُ قَوْمٌ یَقْرَؤُونَ الْقُرْآنَ لاَ یُجَاوِزُ تَرَاقِیَہُمْ ، یَمْرُقُونَ مِنَ الدِّینِ کَمَا یَمْرُقُ السَّہْمُ مِنَ الرَّمِیَّۃِ عَلَی فُوقِہِ۔ (مسلم ۱۴۲۔ احمد ۳۵۳)","Sahih","Musannaf Ibn Abi Shaybah 30822","","","كتاب فضائل القرآن"
"30823","(۳۰۸۲۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: یَخْرُجُ فِی آخِرِ الزَّمَانِ قَوْمٌ أَحْدَاثُ الأَسْنَانِ سُفَہَائُ الأَحْلامِ یَقْرَؤُونَ الْقُرْآنَ لاَ یُجَاوِزُ حَنَاجِرَہُمْ۔ (ترمذی ۲۱۸۸۔ احمد ۴۰۴)","Da'if","Musannaf Ibn Abi Shaybah 30823","","","كتاب فضائل القرآن"
"30824","(۳۰۸۲۴) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّد ٍحَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنِ الأَزْرَقِ بْنِ قَیْسٍ ، عَن شَرِیکِ بْنِ شِہَابٍ الْحَارِثِیِّ ، عَنْ أَبِی بَرْزَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: یَخْرُجُ قَوْمٌ مِنَ قبل الْمَشْرِقِ یَقْرَؤُونَ الْقُرْآنَ لاَ یُجَاوِزُ تَرَاقِیَہُمْ یَمْرُقُونَ مِنَ الدِّین?? کَمَا یَمْرُقُ السَّہْمُ مِنَ الرَّمِیَّۃِ لاَ یَرْجِعُونَ إلَیْہِ۔ (احمد ۴۲۱۔ حاکم ۱۴۶)","Da'if","Musannaf Ibn Abi Shaybah 30824","","","كتاب فضائل القرآن"
"30825","(۳۰۸۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، عَن سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَن زِیَادِ بْنِ لَبِیدٍ ، قَالَ: ذَکَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شَیْئًا فَقَالَ: وَذَاکَ عِنْدَ أَوانِ ذَہَابِ الْعِلْمِ ، قَالَ: قُلْتُ: یَا رَسُولَ اللہِ ، کَیْفَ یَذْہَبُ الْعِلْمُ وَنَحْنُ نَقْرَأُ الْقُرْآنَ وَنُقْرِئُہُ أَبْنَائَنَا وَیُقْرِئُہُ أَبْنَاؤُنَا أَبْنَائَہُمْ إِلَی یَوْمِ الْقِیَامَۃِ ، قَالَ: ثَکِلَتْک أُمُّک زِیَادُ ، إِنْ کُنْت لأرَاک مِنْ أَفْقَہِ رَجُلٍ بِالْمَدِینَۃِ ، أَو لَیْسَ ہَذِہِ الْیَہُودُ وَالنَّصَارَی یَقْرَؤُونَ التَّوْرَاۃَ وَالإِنْجِیلَ، لاَ یَعْمَلُونَ بِشَیْئٍ مِمَّا فِیہِمَا۔ (احمد ۱۶۰۔ طبرانی ۵۲۹۱)","","Musannaf Ibn Abi Shaybah 30825","","","كتاب فضائل القرآن"
"30826","(۳۰۸۲۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ أَبِی سِنَان ، عَنْ أَبِی الْمبَارکِ ، عَنْ عَطَائٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَا آمَنَ بِالْقُرْآنِ مَنِ اسْتَحَلَّ مَحَارِمَہُ۔ (عبد بن حمدع ۱۰۰۳)","Da'if","Musannaf Ibn Abi Shaybah 30826","","","كتاب فضائل القرآن"
"30827","(۳۰۸۲۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ سِنَانٍ ، عَنْ أَبِی الْمبَارکِ ، عَن صُہَیْبٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔ (ترمذی ۲۹۱۸)","Da'if","Musannaf Ibn Abi Shaybah 30827","","","كتاب فضائل القرآن"
"30828","(۳۰۸۲۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، قَالَ: قُلْتُ لأُبَیٍّ: إنَّ ابْنَ مَسْعُودٍ لاَ یَکْتُبُ الْمُعَوِّذَتَیْنِ فِی مُصْحَفِہِ ، فَقَالَ: إنِّی سَأَلْت عَنْہُمَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ: قِیلَ لِی ، فَقُلْتُ: فَقَالَ: أُبَیٌّ: وَنَحْنُ نَقُولُ کَمَا قِیلَ لَنَا۔ (بخاری ۴۹۷۶۔ ابن حبان ۴۴۲۹)","Da'if","Musannaf Ibn Abi Shaybah 30828","","","كتاب فضائل القرآن"
"30829","(۳۰۸۲۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، قَالَ: الْمُعَوِّذَتَانِ مِنَ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30829","","","كتاب فضائل القرآن"
"30830","(۳۰۸۳۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن حُصَیْنٍ ، عَنِ الشَّعْبِیِّ بِنَحْوٍ مِنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30830","","","كتاب فضائل القرآن"
"30831","(۳۰۸۳۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ: رَأَیْتُ عَبْدَ اللہِ یَحک الْمُعَوِّذَتَیْنِ مِنْ مَصَاحِفِہِ ، وقال: لاَ تَخْلِطُوا فِیہِ مَا لَیْسَ مِنْہُ۔ (احمد ۱۲۹۔ طبرانی ۹۱۴۸)","Sahih","Musannaf Ibn Abi Shaybah 30831","","","كتاب فضائل القرآن"
"30832","(۳۰۸۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ: قُلْتُ لِلأََسْوَدِ: مِنَ الْقُرْآنِ ہُمَا ؟ قَالَ: نَعَمْ یَعْنِی الْمُعَوِّذَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 30832","","","كتاب فضائل القرآن"
"30833","(۳۰۸۳۳) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، عَنْ إبْرَاہِیمَ بْنِ رَافِعٍ ، قَالَ: سَمِعْتُ سُلَیْمَانَ مَوْلَی أُمِّ عَلِیٍّ ، أَنَّ مُجَاہِدًا کَانَ یَکْرَہُ أَنْ یَقْرَأَ بِالْمُعَوِّذَاتِ وَحْدَہَا حَتَّی یَجْعَلَ مَعَہَا سُورَۃً أُخْرَی۔","","Musannaf Ibn Abi Shaybah 30833","","","كتاب فضائل القرآن"
"30834","(۳۰۸۳۴) حَدَّثَنَا مُطَّلِبُ بْنُ زِیَادٍ ، عَن مُحَمَّدِ بْنِ سَالِمٍ ، قَالَ: قُلْتُ لأَبِی جَعْفَرٍ: إنَّ ابْنَ مَسْعُودٍ مَحَا الْمُعَوِّذَتَیْنِ مِنْ مُصْحَفِہِ ، فَقَالَ: اقْرَأْ بِہِمَا۔","Da'if","Musannaf Ibn Abi Shaybah 30834","","","كتاب فضائل القرآن"
"30835","(۳۰۸۳۵) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا أَبُو ہِلالٍ ، قَالَ: حدَّثَنَا مَنْصُورٌ الْقَصَّابُ ، قَالَ: سَأَلْتُ الْحَسَنَ قُلْتُ: یَا أَبَا سَعِیدٍ ، أَقْرَأُ الْمُعَوِّذَتَیْنِ فِی صَلاۃِ الْفَجْرِ ؟ فقَالَ: نَعَمْ إِنْ شِئْتَ ، سُورَتَانِ مُبَارَکَتَانِ طَیِّبَتَانِ۔","","Musannaf Ibn Abi Shaybah 30835","","","كتاب فضائل القرآن"
"30836","(۳۰۸۳۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن سُفْیَانَ ، عَن مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ جُبَیْرٍ ، عَنْ أَبِیہِ ، عَن عُقْبَۃَ بْنِ عَامِرٍ ، أَنَّہُ سَأَلَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمُعَوِّذَتَیْنِ ، قَالَ: فَأَمَّنَا بِہِمَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی صَلاۃِ الْفَجْرِ۔ (ابویعلی ۱۷۲۸۔ حاکم ۲۴۰)","Sahih","Musannaf Ibn Abi Shaybah 30836","","","كتاب فضائل القرآن"
"30837","(۳۰۸۳۷) حَدَّثَنَا وَکِیعٌ ، عَن ہِشَامِ بْنِ الْغَازِ ، عَن سُلَیْمَانَ بْنِ مُوسَی ، عَن عُقْبَۃَ بْنِ عَامِرٍ ، قَالَ: کُنْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ ، فَلَمَّا طَلَعَ الْفَجْرُ أَذَّنَ وَأَقَامَ ، ثُمَّ أَقَامَنِی عَن یَمِینِہِ وَقَرَأَ بِالْمُعَوِّذَتَیْنِ فَلَمَّا انْصَرَفَ ، قَالَ: کَیْفَ رَأَیْت ؟ قُلْتُ: قَدْ رَأَیْت یَا رَسُولَ اللہِ ، قَالَ: فَاقْرَأْ بِہِمَا کُلَّمَا نِمْت وَکُلَّمَا قُمْت۔","","Musannaf Ibn Abi Shaybah 30837","","","كتاب فضائل القرآن"
"30838","(۳۰۸۳۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ: کَانَ ابْنُ مَسْعُودٍ لاَ یَکْتُبُ الْمُعَوِّذَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 30838","","","كتاب فضائل القرآن"
"30839","(۳۰۸۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ ، قَالَ ، آخِرُ سُورَۃٍ نَزَلَتْ کَامِلَۃً بَرَائَۃٌ ، وَآخِرُ آیَۃٍ نَزَلَتْ فِی الْقُرْآنِ: {یَسْتَفْتُونَک قُلَ اللَّہُ یُفْتِیکُمْ فِی الْکَلالَۃِ} ۔ (مسلم ۴۶۵۴)","Sahih","Musannaf Ibn Abi Shaybah 30839","","","كتاب فضائل القرآن"
"30840","(۳۰۸۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ السُّدِّیِّ ، قَالَ: آخِرُ آیَۃٍ نَزَلَتْ: {وَاتَّقُوا یَوْمًا تُرْجَعُونَ فِیہِ إِلَی اللہِ ثُمَّ تُوَفَّی کُلُّ نَفْسٍ مَا کَسَبَتْ وَہُمْ لاَ یُظْلَمُونَ}۔","","Musannaf Ibn Abi Shaybah 30840","","","كتاب فضائل القرآن"
"30841","(۳۰۸۴۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ عَطِیَّۃَ الْعَوْفِیِّ ، قَالَ: آخِرُ آیَۃٍ نَزَلَتْ: {وَاتَّقُوا یَوْمًا تُرْجَعُونَ فِیہِ إِلَی اللہِ ثُمَّ تُوَفَّی کُلُّ نَفْسٍ مَا کَسَبَتْ وَہُمْ لاَ یُظْلَمُونَ} ۔","","Musannaf Ibn Abi Shaybah 30841","","","كتاب فضائل القرآن"
"30842","(۳۰۸۴۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا بَشِیرٌ ، قَالَ: مَالِکٌ ، عَنْ أَبِی السَّفَرِ ، عَنِ الْبَرَائِ ، قَالَ: آخِرُ آیَۃٍ نَزَلَتْ: {یَسْتَفْتُونَک قُلَ اللَّہُ یُفْتِیکُمْ فِی الْکَلالَۃِ} ۔ (مسلم ۱۲۳۶۔ طبری ۴۲)","Hasan","Musannaf Ibn Abi Shaybah 30842","","","كتاب فضائل القرآن"
"30843","(۳۰۸۴۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ: ہی أَوَّلُ سُورَۃٍ نَزَلَتْ: {اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ} ثُمَّ (ن) ۔","No Data Available","Musannaf Ibn Abi Shaybah 30843","","","كتاب فضائل القرآن"
"30844","(۳۰۸۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ ، قَالَ: آخِرُ آیَۃٍ نَزَلَتْ فِی الْقُرْآنِ: {یَسْتَفْتُونَک قُلِ اللَّہُ یُفْتِیکُمْ فِی الْکَلالَۃِ}۔","Sahih","Musannaf Ibn Abi Shaybah 30844","","","كتاب فضائل القرآن"
"30845","(۳۰۸۴۵) حَدَّثَنَا وَکِیعٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ: سَمِعْتُ عُبَیْدَ بْنَ عُمَیْرٍ یَقُولُ: أَوَّلُ مَا نَزَلَ مِنَ الْقُرْآنِ: (اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ) ثُمَّ (ن) ۔","Sahih","Musannaf Ibn Abi Shaybah 30845","","","كتاب فضائل القرآن"
"30846","(۳۰۸۴۶) حَدَّثَنَا وَکِیعٌ ، عَن قُرَّۃَ ، عَنْ أَبِی رَجَائٍ ، قَالَ: أَخَذْت مِنْ أَبِی مُوسَی: {اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ} وَہِیَ أَوَّلُ سُورَۃٍ أُنْزِلَتْ عَلَی مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 30846","","","كتاب فضائل القرآن"
"30847","(۳۰۸۴۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِیہِ ، قَالَ: کَانَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ لاَ یَفْرِضُ إِلاَّ لِمَنْ قَرَأَ الْقُرْآنَ ، قَالَ: وَکَانَ أَبِی مِمَّنْ قَرَأَ الْقُرْآنَ فَفَرَضَ لَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30847","","","كتاب فضائل القرآن"
"30848","(۳۰۸۴۸) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ الشَّیْبَانِیِّ ، عَن یُسَیْرِ بْنِ عَمْرٍو ، قَالَ: أَرَادَ سَعْدٌ أَنْ یُلْحِقَ مَنْ قَرَأَ الْقُرْآنَ عَلَی أَلْفَیْنِ أَلْفَیْنِ ، فَکَتَبَ إلَیْہِ عُمَرُ: تُعْطِی عَلَی کِتَابِ اللہِ أَجْرًا۔","Sahih","Musannaf Ibn Abi Shaybah 30848","","","كتاب فضائل القرآن"
"30849","(۳۰۸۴۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَن مُحَمَّدٍ ، قَالَ: جَمَعَ نَاسٌ الْقُرْآنَ حَتَّی بَلَغُوا عِدَّۃً ، فَکَتَبَ أَبُو مُوسَی إِلَی عُمَرَ بِذَلِکَ ، فَکَتَبَ إلَیْہِ عُمَرُ: إنَّ بَعْضَ النَّاسِ أَرْوَی لَہُ مِنْ بَعْضٍ ، وَلَعَلَّ بَعْضَ مَنْ یَقْرَؤُہُ أَنْ یَقُومَ الْمَقَامَ خَیْرٌ مِنْ قِرَائَۃِ الآخَرِ آخرَ مَا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 30849","","","كتاب فضائل القرآن"
"30850","(۳۰۸۵۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إِبْرَاہِیمَ، عَن عَلِیٍّ، أَنَّہُ کَرِہَ أَنْ یُکْتَبَ الْقُرْآنُ فِی الْمُصْحَفِ الصَّغِیرِ۔","","Musannaf Ibn Abi Shaybah 30850","","","كتاب فضائل القرآن"
"30851","(۳۰۸۵۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ بِمِثْلِہِ إِلاَّ أَنَّہُ قَالَ: الْمَصَاحِفِ۔","","Musannaf Ibn Abi Shaybah 30851","","","كتاب فضائل القرآن"
"30852","(۳۰۸۵۲) حَدَّثَنَا وَکِیعٌ قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَانَ یُقَالَ: عَظِّمُوا الْقُرْآنَ یَعْنِی: کَبِّرُوا الْمَصَاحِفَ۔","","Musannaf Ibn Abi Shaybah 30852","","","كتاب فضائل القرآن"
"30853","(۳۰۸۵۳) حَدَّثَنَا وَکِیعٌ قَالَ: حدَّثَنَا عَبْدُ الْمَلِکَ بْنُ شَدَّادٍ الأَزْدِیُّ ، عَن عُبَیْدِ اللہ بْنِ سُلَیْمَانَ الْعَبْدِیِّ ، عَنْ أَبِی حَکِیمَۃَ الْعَبْدِیِّ ، قَالَ: کُنَّا نَکْتُبُ الْمَصَاحِفَ بِالْکُوفَۃِ فَیَمُرُّ عَلَیْنَا عَلِیٌّ وَنَحْنُ نَکْتُبُ فَیَقُومُ فَیَقُولُ: أَجِلَّ قَلَمَکَ ، قَالَ: فَقَطَطْت مِنْہُ ، ثُمَّ کَتَبْتُ ، فَقَالَ: ہَکَذَا نَوِّرُوا مَا نَوَّرَ اللَّہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30853","","","كتاب فضائل القرآن"
"30854","(۳۰۸۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ: حَدَّثَنَا عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ أَبِی حَکِیمَۃَ الْعَبْدِیِّ ، قَالَ: کُنَّا نَکْتُبُ الْمَصَاحِفَ بِالْکُوفَۃِ فَیَمُرُّ عَلَیْنَا عَلِیٌّ فیقوم فَیَنْظُرُ وَیُعْجِبُہُ خَطُّنَا وَیَقُولُ: ہَکَذَا نَوِّرُوا مَا نَوَّرَ اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30854","","","كتاب فضائل القرآن"
"30855","(۳۰۸۵۵) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِاللہِ بْنِ الزُّبَیْرِ، عَن سُفْیَانَ، عَن لَیْثٍ، عَن مُجَاہِدٍ، أَنَّہُ کَرِہَ أَنْ یقال: مُصَیْحِفٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 30855","","","كتاب فضائل القرآن"
"30856","(۳۰۸۵۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَنْ عَبْدِ خَیْرٍ ، قَالَ: قَالَ عَلِیٌّ: یَرْحَمُ اللَّہُ أَبَا بَکْرٍ ہُوَ أَوَّلُ مَنْ جَمَعَ بَیْنَ اللَّوْحَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 30856","","","كتاب فضائل القرآن"
"30857","(۳۰۸۵۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: أَخْبَرَنَا ابْنُ عَوْنٍ ، عَن مُحَمَّدٍ ، قَالَ: لَمَّا اسْتُخْلِفَ أَبُو بَکْرٍ قَعَدَ عَلِیٌّ فِی بَیْتِہِ فَقِیلَ لأَبِی بَکْرٍ فَأَرْسَلِ إلَیْہِ: أَکَرِہْت خِلافَتِی ، قَالَ: لاَ ، لَمْ أَکْرَہْ خِلافَتَکَ ، وَلَکِنْ کَانَ الْقُرْآنُ یُزَادُ فِیہِ ، فَلَمَّا قُبِضَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَعَلْت عَلَیّ أَنْ لاَ أَرْتَدِیَ إِلاَّ لِصَلاۃٍ حَتَّی أَجْمَعَہُ لِلنَّاسِ، فَقَالَ أَبُو بَکْرٍ: نِعْمَ مَا رَأَیْت۔","","Musannaf Ibn Abi Shaybah 30857","","","كتاب فضائل القرآن"
"30858","(۳۰۸۵۸) حَدَّثَنَا قَبِیصَۃُ ، قَالَ: حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَن مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَن صَعْصَعَۃَ ، قَالَ: أَوَّلُ مَنْ جَمَعَ بَیْنَ اللَّوْحَیْنِ وَوَرَّثَ الْکَلالَۃَ أَبُو بَکْرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 30858","","","كتاب فضائل القرآن"
"30859","(۳۰۸۵۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن مُحَمَّدِ بْنِ عَجْلانَ ، عَن سَعِیدِ بْنِ أَبِی سَعِیدٍ ، قَالَ: قَالَ أُبَیٌّ: إذَا حَلَّیْتُمْ مَصَاحِفَکُمْ وَزَوَّقْتُمْ مَسَاجِدَکُمْ فَالدَّبَارُ عَلَیْکُمْ۔","","Musannaf Ibn Abi Shaybah 30859","","","كتاب فضائل القرآن"
"30860","(۳۰۸۶۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: حدَّثَنَا قُطْبَۃُ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ عَاصِمٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ رَأَی مُصْحَفًا یُحَلَّی فَقَالَ: تُغْرُونَ بِہِ السُّرَّاقَ ، زِینَتُہُ فِی جَوْفِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30860","","","كتاب فضائل القرآن"
"30861","(۳۰۸۶۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یُحَلَّی الْمُصْحَفُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30861","","","كتاب فضائل القرآن"
"30862","(۳۰۸۶۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی وَائِلٍ ، قَالَ: أُتِیَ عَبْدُ اللہِ بِمُصْحَفٍ قَدْ زُیِّنَ بِالذَّہَبِ فَقَالَ عَبْدُ اللہِ: إنَّ أَحْسَنَ مَا زُیِّنَ بِہِ الْمُصْحَفُ تِلاوَتُہُ فی الْحَقِّ۔","Hasan","Musannaf Ibn Abi Shaybah 30862","","","كتاب فضائل القرآن"
"30863","(۳۰۸۶۳) حَدَّثَنَا عَبْدَۃُ ، عَنِ الزِّبْرِقَانِ ، قَالَ: قُلْتُ لأَبِی رَزِینٍ: إنَّ عِنْدِی مُصْحَفًا أُرِیدُ أَنْ أَخْتِمَہُ بِالذَّہَبِ ، قَالَ: لاَ تَزِیدَنَّ فِیہِ شَیْئًا مِنْ أَمْرِ الدُّنْیَا قَلَّ ، وَلا کَثُرَ۔","","Musannaf Ibn Abi Shaybah 30863","","","كتاب فضائل القرآن"
"30864","(۳۰۸۶۴) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَن سعید بن أَبِی سعید ، قَالَ: قَالَ أَبُو ذَرٍّ: إذا زَوَّقْتُمْ مَسَاجِدَکُمْ وَحَلَّیْتُمْ مَصَاحِفَکُمْ فَالدَّبَارُ عَلَیْکُمْ۔","","Musannaf Ibn Abi Shaybah 30864","","","كتاب فضائل القرآن"
"30865","(۳۰۸۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَحْوَصِ بْنِ حَکِیمٍ ، عَنْ أَبِی الزَّاہِرِیَّۃِ ، عَنْ أَبِی أُمَامَۃَ ، أَنَّہُ کَرِہَ أَنْ یُحَلَّی الْمُصْحَفُ۔","Da'if","Musannaf Ibn Abi Shaybah 30865","","","كتاب فضائل القرآن"
"30866","(۳۰۸۶۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ ابن أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ: أَتَیْتُ عَبْدَ الرَّحْمَن بْنَ أَبِی لَیْلَی بِتِبْرٍ فَقَالَ: ہَلْ عَسَیْت أَنْ تُحَلِّی بِہِ مُصْحَفًا۔","","Musannaf Ibn Abi Shaybah 30866","","","كتاب فضائل القرآن"
"30867","(۳۰۸۶۷) حَدَّثَنَا مُعَاذٌ ، عَنِ ابْنِ عَوْنٍ ، عَن مُحَمَّدٍ ، قَالَ: لاَ بَأْسَ أَنْ یُحَلَّی الْمُصْحَفُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30867","","","كتاب فضائل القرآن"
"30868","(۳۰۸۶۸) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، عَن یَحْیَی ، عَن مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، أَنَّہُ کَرِہَ التَّعْشِیرَ فِی الْمُصْحَفِ۔","Sahih","Musannaf Ibn Abi Shaybah 30868","","","كتاب فضائل القرآن"
"30869","(۳۰۸۶۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَانَ یَکْرَہُ التَّعْشِیرَ فِی الْمُصْحَفِ وَأَنْ یُکْتَبَ فِیہِ شَیْئٌ مِنْ غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 30869","","","كتاب فضائل القرآن"
"30870","(۳۰۸۷۰) حَدَّثَنَا أَبُو خَالِدٍ ، عَن حَجَّاجٍ ، عَن حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 30870","","","كتاب فضائل القرآن"
"30871","(۳۰۸۷۱) حَدَّثَنَا الْمُحَارِبِیُّ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یُکْتَبَ تَعْشِیرٌ ، أَوْ تَفْصِیلٌ ، وَیَقُولُ: سُورَۃُ الْبَقَرَۃِ ، وَیَقُولُ: السُّورَۃُ الَّتِی تُذْکَرُ فِیہَا الْبَقَرَۃُ۔","","Musannaf Ibn Abi Shaybah 30871","","","كتاب فضائل القرآن"
"30872","(۳۰۸۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ ، أَنَّہُ کَرِہَ التَّعْشِیرَ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 30872","","","كتاب فضائل القرآن"
"30873","(۳۰۸۷۳) حَدَّثَنَا عَبْدَۃُ ، عَنِ الزِّبْرِقَانِ ، قَالَ: قُلْتُ لأَبِی رَزِینٍ: إنَّ عِنْدِی مُصْحَفًا أُرِیدُ أَنْ أَخْتِمَہُ بِالذَّہَبِ ، وَأَکْتُبَ عِنْدَ أَوَّلِ سُورَۃٍ آیَۃُ کَذَا وَکَذَا ، فقَالَ أَبُو رَزِینٍ: لاَ تَزِیدَنَّ فِیہِ شَیْئًا مِنْ أَمْرِ الدُّنْیَا قَلَّ ، وَلا کَثُرَ۔","","Musannaf Ibn Abi Shaybah 30873","","","كتاب فضائل القرآن"
"30874","(۳۰۸۷۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن ہِشَامٍ ، عَن مُحَمَّدٍ ، أَنَّہُ کَانَ یَکْرَہُ الْفَوَاتِحَ وَالْعَوَاشِرَ الَّتِی فِیہَا قَافٌ وَکَافٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 30874","","","كتاب فضائل القرآن"
"30875","(۳۰۸۷۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ التَّعْشِیرَ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 30875","","","كتاب فضائل القرآن"
"30876","(۳۰۸۷۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ النَّقْطَ وَخَاتِمَۃَ سُورَۃِ کَذَا وَکَذَا۔","","Musannaf Ibn Abi Shaybah 30876","","","كتاب فضائل القرآن"
"30877","(۳۰۸۷۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَن حَجَّاجٍ ، عَن شَیْخٍ ، عَنْ عَبْدِ اللہِ ، أَنَّہُ رَأَی خَطَأً فِی الْمُصْحَفِ فَحَکَّہُ ، وَقَالَ: لاَ تَخْلِطُوا فِیہِ غَیْرَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30877","","","كتاب فضائل القرآن"
"30878","(۳۰۸۷۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن حَجَّاجٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَانَ یَکْرَہُ التَّعْشِیرَ فِی الْمُصْحَفِ ، وَأَنْ یُکْتَبَ فِیہِ شَیْئٌ مِنْ غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 30878","","","كتاب فضائل القرآن"
"30879","(۳۰۸۷۹) حَدَّثَنَا عَفَّانُ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ، عَن شُعَیْبِ بْنِ الْحَبْحَابِ، أَنَّ أَبَا الْعَالِیَۃِ کَانَ یَکْرَہُ الْعَوَاشِرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30879","","","كتاب فضائل القرآن"
"30880","(۳۰۸۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَن سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ أَبِی الزَّعْرَائِ ، عَنْ عَبْدِ اللہِ ، قَالَ: جَرِّدُوا الْقُرْآنَ ، وَلا تُلْبِسُوا بِہِ مَا لَیْسَ مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30880","","","كتاب فضائل القرآن"
"30881","(۳۰۸۸۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ: قَالَ عَبْدُ اللہِ: جَرِّدُوا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 30881","","","كتاب فضائل القرآن"
"30882","(۳۰۸۸۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَانَ یُقَالُ: جَرِّدُوا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 30882","","","كتاب فضائل القرآن"
"30883","(۳۰۸۸۳) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ: قُلْتُ لِعَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ: مَا یَمْنَعُک أَنْ تَکُونَ سَأَلْت کَمَا سَأَلَ إبْرَاہِیمُ ؟ قَالَ: فَقَالَ: کَانَ یُقَالُ: جَرِّدُوا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 30883","","","كتاب فضائل القرآن"
"30884","(۳۰۸۸۴) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَن حُمَیْدٍ الطَّوِیلِ ، عَن مُعَاوِیَۃَ بْنِ قُرَّۃَ ، عَنْ أَبِی الْمُغِیرَۃِ ، قَالَ: قرَأَ رَجُلٌ عِنْدَ ابْنِ مَسْعُودٍ فَقَالَ: أَسْتَعِیذُ بِالسَّمِیعِ الْعَلِیمِ مِنَ الشَّیْطَانِ الرَّجِیمِ فَقَالَ عَبْدُ اللہِ: جَرِّدُوا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 30884","","","كتاب فضائل القرآن"
"30885","(۳۰۸۸۵) حَدَّثَنَا مَالِکٌ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ، عَن شُعَیْبِ بْنِ الْحَبْحَابِ، أَنَّ أَبَا الْعَالِیَۃِ، قَالَ: جَرِّدُوا الْقُرْآنَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30885","","","كتاب فضائل القرآن"
"30886","(۳۰۸۸۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ عَوْفٍ ، عَنْ زِیَادِ بْنِ مِخْرَاقٍ ، عَنْ أَبِی کِنَانَۃَ ، عَنْ أَبِی مُوسَی الأَشْعَرِیِّ ، قَالَ: إِنَّ مِنْ إجْلالِ اللہِ إکْرَامُ حَامِلِ الْقُرْآنِ غَیْرِ الْغَالِی فِیہِ ، وَلا الْجَافِی عَنْہُ۔ (ابوداؤد ۴۸۱۰۔ بیہقی ۱۶۳)","Da'if","Musannaf Ibn Abi Shaybah 30886","","","كتاب فضائل القرآن"
"30887","(۳۰۸۸۷) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ: مَرَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی بِلالٍ وَہُوَ یَقْرَأُ مِنْ ہَذِہِ السُّورَۃِ وَمِنْ ہَذِہِ السُّورَۃِ ، فَقَالَ: مَرَرْتُ بِکَ یَا بِلالُ وَأَنْتَ تَقْرَأُ مِنْ ہَذِہِ السُّورَۃِ وَمِنْ ہَذِہِ السُّورَۃِ ، فَقَالَ: بِأَبِی أَنْتَ یَا رَسُولَ اللہِ إنِّی أَرَدْت أَنْ أَخْلِطَ الطَّیِّبَ بِالطَّیِّبِ: فَقَالَ: اقْرَأ السُّورَۃَ عَلَی نَحْوِہَا۔","","Musannaf Ibn Abi Shaybah 30887","","","كتاب فضائل القرآن"
"30888","(۳۰۸۸۸) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ: کَانَ مُعَاذٌ یَخْلِطُ مِنْ ہَذِہِ السُّورَۃِ وَمِنْ ہَذِہِ السُّورَۃِ ، فَقِیلَ لَہُ، فَقَالَ: أَتَرُونِی أَخْلِطُ فِیہِ مَا لَیْسَ مِنْہُ ؟۔","","Musannaf Ibn Abi Shaybah 30888","","","كتاب فضائل القرآن"
"30889","(۳۰۸۸۹) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَن زَیْدِ بْنِ یُثَیْعٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ بِبِلالٍ ، ثُمَّ ذَکَرَ نَحْوًا مِنْ حَدِیثِ حَاتِمٍ۔","Hasan","Musannaf Ibn Abi Shaybah 30889","","","كتاب فضائل القرآن"
"30890","(۳۰۸۹۰) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ: سُئِل محمد عَن الذی یَقْرَأَ من ہَاہُنَا ومن ہَاہُنَا ؟ فقَالَ: لیتق لاَ یأثم إثم عظیم وہو لاَ یشعر۔","","Musannaf Ibn Abi Shaybah 30890","","","كتاب فضائل القرآن"
"30891","(۳۰۸۹۱) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَن أشعث ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَقْرَأَ فِی سُورَتَیْنِ حَتَّی یَخْتِمَ آخِرَتَہَا ، ثُمَّ یَأْخُذُ فِی الأُخْرَی۔","","Musannaf Ibn Abi Shaybah 30891","","","كتاب فضائل القرآن"
"30892","(۳۰۸۹۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، قَالَ: حدَّثَنِی الْوَلِیدُ بْنُ جُمَیْعٍ، قَالَ: حَدَّثَنِی رَجُلٌ، أَنَّہُ أَمَّ النَّاسَ بِالْحِیرَۃِ خَالِدُ بْنُ الْوَلِیدِ ، ثُمَّ قَرَأَ مِنْ سُوَرٍ شَتَّی ، ثُمَّ الْتَفَتَ إلَیْنَا حِینَ انْصَرَفَ فَقَالَ: شَغَلَنَا الْجِہَادُ ، عَن تَعْلِیمِ الْقُرْآنِ۔","Da'if","Musannaf Ibn Abi Shaybah 30892","","","كتاب فضائل القرآن"
"30893","(۳۰۸۹۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْہُذَیْلِ ، قَالَ: کَانُوا یَکْرَہُونَ أَنْ یَقَرَؤُوا بَعْضَ الآیَۃِ وَیَتْرُکُوا بَعْضَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 30893","","","كتاب فضائل القرآن"
"30894","(۳۰۸۹۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن سُفْیَانَ ، عَنْ عَطَائٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، أَنَّہُ کَرِہَ أَنْ یَقُولَ: أَسْقَطْت آیَۃَ کَذَا وَکَذَا۔","No Data Available","Musannaf Ibn Abi Shaybah 30894","","","كتاب فضائل القرآن"
"30895","(۳۰۸۹۵) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا سَعِیدُ بْنُ زَیْد ، قَالَ: حَدَّثَنَا عَمْرُو بْنُ مَالِکٍ ، عَنْ أَبِی الْجَوْزَائِ ، قَالَ: نَقْلُ الْحِجَارَۃِ أَہْوَنُ عَلَی الْمُنَافِقِ مِنْ قِرَائَۃِ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30895","","","كتاب فضائل القرآن"
"30896","(۳۰۸۹۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، قَالَ: حدَّثَنِی زَیْدُ بْنُ عَلِیٍّ ، قَالَ: مَرَرْت بِأَبِی جَعْفَرٍ وَہُوَ فِی دَارِہِ وَہُوَ یَقُولُ: اللَّہُمَّ اغْفِرْ لِی بِالْقُرْآنِ اللَّہُمَّ ارْحَمْنِی بِالْقُرْآنِ اللَّہُمَّ اہْدِنِی بِالْقُرْآنِ اللَّہُمَّ ارْزُقْنِی بِالْقُرْآنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30896","","","كتاب فضائل القرآن"
"30897","(۳۰۸۹۷) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ أَبِی إِسْحَاقَ، عَن عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: قَالَ أَبُو بَکْرٍ: یَا رَسُولَ اللہِ، مَا شَیَّبَکَ؟ قَالَ: شَیَّبَنِی ہُودٌ وَالْوَاقِعَۃُ وَالْمُرْسَلاتُ وَعَمَّ یَتَسَائَلُونَ وَإذَا الشَّمْسُ کُوِّرَتْ۔ (ابویعلی ۱۰۲)","","Musannaf Ibn Abi Shaybah 30897","","","كتاب فضائل القرآن"
"30898","(۳۰۸۹۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ وَقَبِیصَۃُ ، عَن سُفْیَانَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، عَن حُذَیْفَۃَ ، قَالَ: یَقُولُونَ سُورَۃُ التَّوْبَۃِ وَہِیَ سُورَۃُ الْعَذَابِ یَعْنِی بَرَائَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 30898","","","كتاب فضائل القرآن"
"30899","(۳۰۸۹۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَن عِکْرِمَۃَ ، قَالَ: مَا زَالَتْ بَرَائَۃُ تَنْزِلُ حَتَّی أَشْفَقَ مِنْہَا أصحاب مُحَمَّدٌ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَکَانَتْ تُسَمَّی الْفَاضِحَۃَ۔","","Musannaf Ibn Abi Shaybah 30899","","","كتاب فضائل القرآن"
"30900","(۳۰۹۰۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنِ الْمُسَیَّبِ ، قَالَ: قَالَ عَبْدُ اللہِ: الطُّوَّلُ کَالتَّوْرَاۃِ ، وَالْمِئِونَ کَالإِنْجِیلِ ، وَالْمَثَانِی کَالزَّبُورِ ، وَسَائِرُ الْقُرْآنِ فَضْلٌ۔","","Musannaf Ibn Abi Shaybah 30900","","","كتاب فضائل القرآن"
"30901","(۳۰۹۰۱) حَدَّثَنَا وَکِیعٌ، عَنِ الأَعْمَشِ، عَن سَعِیدِ بْنِ جُبَیْرٍ: {وَلَقَدْ کَتَبْنَا فِی الزَّبُورِ} قَالَ: الْقُرْآنُ والتَّوْرَاۃُ وَالإِنْجِیلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 30901","","","كتاب فضائل القرآن"
"30902","(۳۰۹۰۲) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَن دَاوُد ، عَنِ الشَّعْبِیِّ: {وَلَقَدْ کَتَبْنَا فِی الزَّبُورِ مِنْ بَعْدِ الذِّکْرِ} قَالَ: زَبُورِ دَاوُد مِنْ بَعْدِ ذِکْرِ مُوسَی۔","","Musannaf Ibn Abi Shaybah 30902","","","كتاب فضائل القرآن"
"30903","(۳۰۹۰۳) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا ہَمَّامٌ ، قَالَ سَمِعْت أَبَا عِمْرَانَ الْجَوْنِیَّ ، قَالَ: حَدَّثَنَا عَبْدُ اللہِ بْنُ رَبَاحٍ ، قَالَ: سَمِعْتُ کَعْبًا یَقُولُ: فَاتِحَۃُ التَّوْرَاۃِ فَاتِحَۃُ سُورَۃِ الأَنْعَامِ ، وَخَاتِمَۃُ التَّوْرَاۃِ خَاتِمَۃُ سُورَۃِ ہُودٍ۔","","Musannaf Ibn Abi Shaybah 30903","","","كتاب فضائل القرآن"
"30904","(۳۰۹۰۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَن دَاوُد ، عَنِ الشَّعْبِیِّ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ: إذَا شَکَکْتُمْ فِی الْیَائِ وَالتَّائِ فَاجْعَلُوہَا یَائً فَإِنَّ الْقُرْآنَ ذَکَرٌ فَذَکِّرُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30904","","","كتاب فضائل القرآن"
"30905","(۳۰۹۰۵) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ: حدَّثَنَا أَبُو نِزَارٍ الْمُرَادِیُّ ، عَنْ عَمْرِو بْنِ مَیْسَرَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ السُّلَمِیِّ ، قَالَ: إذَا اخْتَلَفْتُمْ فِی الْقُرْآنِ فِی یَائٍ ، أَوْ تَائٍ فَاجْعَلُوہَا یَائً فَإِنَّ الْقُرْآنَ نَزَلَ عَلَی الْیَائِ۔","","Musannaf Ibn Abi Shaybah 30905","","","كتاب فضائل القرآن"
"30906","(۳۰۹۰۶) حَدَّثَنَا مُعَاوِیَۃُ بْنُ عُمَر ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ: إذَا تَمَارَیْتُمْ فِی الْقُرْآنِ فِی یَائٍ ، أَوْ تَائٍ فَاجْعَلُوہَا یَائً وَذَکِّرُوا الْقُرْآنَ فَإِنَّہُ مُذَکَّرٌ۔","Da'if","Musannaf Ibn Abi Shaybah 30906","","","كتاب فضائل القرآن"
"30907","(۳۰۹۰۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَن یَحْیَی بْنِ جَعْدَۃَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ: الْقُرْآنُ ذَکَرٌ فَذَکِّرُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30907","","","كتاب فضائل القرآن"
"30908","(۳۰۹۰۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ: کَانَ الْغُلامُ إذَا أَفْصَحَ مِنْ بَنِی عَبْدِ الْمُطَّلِبِ عَلَّمَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ہَذِہِ الآیَۃَ سَبْعًا: {الْحَمْدُ لِلَّہِ الَّذِی لَمْ یَتَّخِذْ وَلَدًا وَلَمْ یَکُنْ لَہُ شَرِیکٌ فِی الْمُلْکِ وَلَمْ یَکُنْ لَہُ وَلِیٌّ مِنَ الذُّلِّ وَکَبِّرْہُ تَکْبِیرًا}۔","","Musannaf Ibn Abi Shaybah 30908","","","كتاب فضائل القرآن"
"30909","(۳۰۹۰۹) حَدَّثَنَا عُمَرُ بْنُ سَعْدٍ أَبُو دَاوُدَ ، عَن سُفْیَانَ ، عَنِ الْحَسَنِ بْنِ عَمْرِو: جَاء بی أبی إلی سعید بن جبیر وأنا صغیر ، فقال: تُعَلِّمْ ہذا الْقُرْآنَ ؟۔","","Musannaf Ibn Abi Shaybah 30909","","","كتاب فضائل القرآن"
"30910","(۳۰۹۱۰) حَدَّثَنَا عُمَرُ بْنُ سَعْدٍ ، عَن سُفْیَانَ ، عَنِ الْحَسَنِ بْنِ عَمْرِو ، عَن فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَانُوا یَکْرَہُونَ أَنْ یُعَلِّمُوا أَوْلادَہُم الْقُرْآنَ حَتَّی یَعْقِلُوا۔","","Musannaf Ibn Abi Shaybah 30910","","","كتاب فضائل القرآن"
"30911","(۳۰۹۱۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَن سَالِمٍ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: لاَ حَسَدَ إِلاَّ فِی اثْنَتَیْنِ: رَجُلٍ آتَاہُ اللَّہُ مَالاً ، فَہُوَ یُنْفِقُہُ آنَائَ اللَّیْلِ وَأَنَائَ النَّہَارِ ، وَرَجُلٍ عَلَّمَہُ اللَّہُ الْقُرْآنَ ، فَہُوَ یَقُومُ بِہِ آنَائَ اللَّیْلِ وَآنَائَ النَّہَارِ۔ (بخاری ۵۰۲۵۔ مسلم ۵۵۸)","Sahih","Musannaf Ibn Abi Shaybah 30911","","","كتاب فضائل القرآن"
"30912","(۳۰۹۱۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: حدَّثَنَا یَزِیدُ بْنُ عَبْدِ الْعَزِیزِ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی سَعِیدٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ حَسَدَ إِلاَّ فِی اثْنَتَیْنِ: رَجُلٍ آتَاہُ اللَّہُ الْقُرْآنَ ، فَہُوَ یَتْلُوہُ آنَائَ اللَّیْلِ وَآنَائَ النَّہَارِ ، فَیَقُولُ الرَّجُلُ: لَوْ آتَانِی اللَّہُ مِثْلَ مَا آتَی فُلانًا فَعَلْت مِثْلَ مَا یَفْعَلُ ، وَرَجُلٍ آتَاہُ اللَّہُ مَالاً ، فَہُوَ یُنْفِقُہُ فِی حَقِّہِ فَیَقُولُ الرَّجُلُ: لَوْ آتَانِی اللَّہُ مِثْلَ مَا آتَی فُلانًا فَعَلْت مِثْلَ مَا یَفْعَلُ۔ (احمد ۴۷۹۔ ابویعلی ۱۰۸۰)","Sahih","Musannaf Ibn Abi Shaybah 30912","","","كتاب فضائل القرآن"
"30913","(۳۰۹۱۳) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ: قَالَ عَبْدُ اللہِ: (حم) دِیبَاجُ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30913","","","كتاب فضائل القرآن"
"30914","(۳۰۹۱۴) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَن مِسْعَرٍ ، عَن سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ: کُنَّ الْحَوَامِیمُ یُسَمَّیْنَ الْعَرَائِسَ۔","","Musannaf Ibn Abi Shaybah 30914","","","كتاب فضائل القرآن"
"30915","(۳۰۹۱۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَوَکِیعٌ ، عَن مِسْعَرٍ ، عَن مَعْنِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ: قَالَ عَبْدُ اللہِ: إذَا وَقَعَتْ فِی آلْ (حم) وَقَعْتُ فِی رَوْضَاتٍ دَمِثَاتٍ أَتَأَنَّقُ فِیہِنَّ۔","","Musannaf Ibn Abi Shaybah 30915","","","كتاب فضائل القرآن"
"30916","(۳۰۹۱۶) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ ، عَن حَبِیبٍ ، عَن رَجُلٍ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ: مَرَّ عَلَیْہِ وَہُوَ یَبْنِی مَسْجِدًا فَقَالَ: مَا ہَذَا ؟ قَالَ: ہَذَا لآلِ (حم) ۔","Da'if","Musannaf Ibn Abi Shaybah 30916","","","كتاب فضائل القرآن"
"30917","(۳۰۹۱۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن شِبْلٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ: عَرَضْت الْقُرْآنَ عَلَی ابْنِ عَبَّاسٍ ثَلاثَ عَرْضَاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30917","","","كتاب فضائل القرآن"
"30918","(۳۰۹۱۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا محمد بن إسحاق عن أبان بن صالح ، عَن مُجَاہِدٍ ، قَالَ: عَرَضْت الْقُرْآنَ عَلَی ابْنِ عَبَّاسٍ مِنْ فَاتِحَتِہِ إِلَی خَاتِمَتِہِ ثَلاثَ عَرْضَاتٍ أَقفہُ عِنْدَ کُلِّ آیَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 30918","","","كتاب فضائل القرآن"
"30919","(۳۰۹۱۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَعْرِضُ الْقُرْآنَ فِی کُلِّ رَمَضَانَ مَرَّۃً إِلاَّ الْعَامَ الَّذِی قُبِضَ فِیہِ فَإِنَّہُ عُرِضَ عَلَیْہِ مَرَّتَیْنِ بِحَضْرَۃِ عَبْدِ اللہِ فَشَہِدَ مَا نُسِخَ مِنْہُ ، وَمَا بُدِّلَ۔ (احمد ۳۶۲۔ ابویعلی ۲۵۵)","Sahih","Musannaf Ibn Abi Shaybah 30919","","","كتاب فضائل القرآن"
"30920","(۳۰۹۲۰) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَن عُبَیْدِ اللہِ بْنِ عبْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَعْرِضُ الْکِتَابَ فِی کُلِّ رَمَضَانَ عَلَی جِبْرِیلَ ، فَلَمَّا کَانَ الشَّہْرُ الَّذِی ہَلَکَ فِیہِ عَرَضَہُ عَلَیْہِ عَرْضَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 30920","","","كتاب فضائل القرآن"
"30921","(۳۰۹۲۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ: حدَّثَنَا مُوسَی بْنُ عُلَیٍّ ، قَالَ: سَمِعْتُ أَبِی یَقُولُ: أَمْسَکْت عَلَی فَضَالَۃَ بْنِ عُبَیْدٍ الْقُرْآنَ حَتَّی فَرَغَ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30921","","","كتاب فضائل القرآن"
"30922","(۳۰۹۲۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنِ ابْنِ عُیَیْنَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، وَعَنِ ابْنِ سِیرِینَ ، عَن عَبِیْدَۃَ ، قَالَ: الْقِرَائَۃُ الَّتِی عُرِضَتْ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْعَامِ الَّذِی قُبِضَ فِیہِ ہِیَ الْقِرَائَۃُ الَّتِی یَقْرَؤُہَا النَّاسُ الْیَوْمَ۔","","Musannaf Ibn Abi Shaybah 30922","","","كتاب فضائل القرآن"
"30923","(۳۰۹۲۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ: کَانَ جِبْرِیلُ یَعْرِضُ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْقُرْآنَ فِی کُلِّ عَامٍ مَرَّۃً فِی رَمَضَانَ ، فَلَمَّا کَانَ الْعَامُ الَّذِی قُبِضَ فِیہِ عَرَضَہُ عَلَیْہِ مَرَّتَیْنِ۔n(بخاری ۳۶۲۴۔ مسلم ۱۹۰۵)","","Musannaf Ibn Abi Shaybah 30923","","","كتاب فضائل القرآن"
"30924","(۳۰۹۲۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ ، عَن فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، عَنْ فَاطِمَۃَ ، قَالَتْ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَعْرِضُ الْقُرْآنَ عَلَی جِبْرِیلَ فِی کُلِّ عَامٍ مَرَّۃً ، فَلَمَّا کَانَ الْعَامُ الَّذِی قُبِضَ فِیہِ عَرَضَہُ عَلَیْہِ مَرَّتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 30924","","","كتاب فضائل القرآن"
"30925","(۳۰۹۲۵) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، قَالَ: لِکُلِّ شَیْئٍ لُبَابٌ وَإِنَّ لُبَابَ الْقُرْآنِ الْمُفَصَّلُ۔","Sahih","Musannaf Ibn Abi Shaybah 30925","","","كتاب فضائل القرآن"
"30926","(۳۰۹۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، عَن سُلَیْمَانَ بْنِ مَیْسَرَۃَ ، عَن طَارِقِ بْنِ شِہَابٍ ، قَالَ: قَالَ سَلْمَانُ لِزَیْدِ بْنِ صُوحَانَ: کَیْفَ أَنْتَ إذَا اقْتَتَلَ الْقُرْآنُ وَالسُّلْطَانُ ؟ قَالَ: إذًا أَکُونُ مَعَ الْقُرْآنِ ، قَالَ: نِعْمَ الزُّویَیْدُ: إذًا أَنْتَ۔","Sahih","Musannaf Ibn Abi Shaybah 30926","","","كتاب فضائل القرآن"
"30927","(۳۰۹۲۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن شِمْرٍ ، عَن شَہْرِ بْنِ حَوْشَبٍ ، عَن کَعْبٍ ، قَالَ: یَقْتَتِلُ الْقُرْآنُ وَالسُّلْطَانُ قَالَ: فَیَطَأُ السُّلْطَانُ عَلَی صِمَاخِ الْقُرْآنِ فَلأْیًا بِلأْیِ ،وَلأْیًا بِلأی ،مَا تَنْفَلتُنَّ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 30927","","","كتاب فضائل القرآن"
"30928","(۳۰۹۲۸) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ: حدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللہِ بن مسعود ، قَالَ: أَتَی ابْنَ مَسْعُودٍ رَجُلٌ فَقَالَ: یَا أَبَا عَبْدِ الرَّحْمَنِ ، عَلِّمْنِی کَلِمَاتٍ جَوَامِعَ نَوَافِعَ ، قَالَ تَعَبَّدَ اللَّہَ ، وَلا تُشْرِکْ بِہِ شَیْئًا وَتَزُولُ مَعَ الْقُرْآنِ حَیْثُ زَال۔","","Musannaf Ibn Abi Shaybah 30928","","","كتاب فضائل القرآن"
"30929","(۳۰۹۲۹) حَدَّثَنَا مُعَاوِیَۃَ بْنَ ہِشَامٍ ، قَالَ: حَدَّثَنَا سُفْیَانُ ، عَنْ جَبَلَۃَ بْنِ سُحَیْمٍ ، عَنْ عَامِرِ بْنِ مَطَرٍ ، قَالَ: کُنْتُ مَعَ حُذَیْفَۃَ فَقَالَ: کَیْفَ أَنْتَ یَا عَامِرُ بْنُ مَطَرٍ إذَا أَخَذَ النَّاسُ طَرِیقًا وَالْقُرْآنُ طَرِیقًا مَعَ أَیِّہِمَا تَکُونُ ؟ فَقُلْتُ: مَعَ الْقُرْآنِ أَحْیَا مَعَہُ ، أو أَمُوتُ ، قَالَ: فَأَنْتَ إذًا۔","Sahih","Musannaf Ibn Abi Shaybah 30929","","","كتاب فضائل القرآن"
"30930","(۳۰۹۳۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، قَالَ: حدَّثَنَا مَعْنٌ ، قَالَ: أَتَی رَجُلٌ ابْنَ مَسْعُودٍ فَقَالَ: عَلِّمْنِی کَلِمَاتٍ جَوَامِعَ نَوَافِعَ ، قَالَ: تَعَبَّدَ اللَّہَ ، وَلا تُشْرِکْ بِہِ شَیْئًا ، وَتَزُولُ مَعَ الْقُرْآنِ حَیْثُ زَالَ۔","","Musannaf Ibn Abi Shaybah 30930","","","كتاب فضائل القرآن"
"30931","(۳۰۹۳۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَانَ أَصْحَابُ عَبْدِ اللہِ الَّذِینَ یُفْتُونَ وَیَقْرَؤُونَ الْقُرْآنَ: عَلْقَمَۃَ وَالأَسْوَدَ وَعُبَیْدَۃَ وَمَسْرُوقًا وَعَمْرَو بْنَ شُرَحْبِیلَ وَالْحَارِثَ بْنَ قَیْسٍ۔","","Musannaf Ibn Abi Shaybah 30931","","","كتاب فضائل القرآن"
"30932","(۳۰۹۳۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَن مَسْرُوقٍ ، قَالَ: کَانَ عَبْدُ اللہِ یُقْرِئُنَا الْقُرْآنَ فِی الْمَسْجِدِ ، ثُمَّ یَجْلِسُ بَعْدَہُ یثبت النَّاسَ۔","Sahih","Musannaf Ibn Abi Shaybah 30932","","","كتاب فضائل القرآن"
"30933","(۳۰۹۳۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ حُمَیْدٍ ، قَالَ سَمِعْت أَبَا إِسْحَاقَ یَقُولُ: أَقْرَأَ أَبُو عَبْدِ الرَّحْمَنِ السُّلَمِیُّ الْقُرْآنَ فِی الْمَسْجِدِ أَرْبَعِینَ سَنَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 30933","","","كتاب فضائل القرآن"
"30934","(۳۰۹۳۴) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَن عَبِیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ: قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: اقْرَأْ عَلَیَّ الْقُرْآنَ ، فَقُلْتُ: أَقْرَأُ عَلَیْک وَعَلَیْک أُنْزِلَ ، قَالَ: إنِّی أَشْتَہِی أَنْ أَسْمَعَہُ مِنْ غَیْرِی ، قَالَ: فَقَرَأْت عَلَیْہِ النِّسَائَ حَتَّی بَلَغْت: {فَکَیْفَ إذَا جِئْنَا مِنْ کُلِّ أُمَّۃٍ بِشَہِیدٍ وَجِئْنَا بِکَ عَلَی ہَؤُلائِ شَہِیدًا} رَفَعْت رَأْسِی ، أَوْ غَمَزَنِی رَجُلٌ إِلَی جَنْبِی فَرَفَعْت رَأْسِی فَرَأَیْتُ عَیْنَیْہِ تَسِیلُ۔n(بخاری ۴۵۸۲۔ مسلم ۵۵۱)","Sahih","Musannaf Ibn Abi Shaybah 30934","","","كتاب فضائل القرآن"
"30935","(۳۰۹۳۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن حُصَیْنٍ ، عَن ہِلالِ بْنِ یَسَافٍ ، عَنْ أَبِی حَیَّانَ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوٍ مِنْ حَدِیثِ الأَعْمَشِ۔ (احمد ۳۷۴۔ ابویعلی ۵۱۲۸)","Da'if","Musannaf Ibn Abi Shaybah 30935","","","كتاب فضائل القرآن"
"30936","(۳۰۹۳۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، عَنْ عَبْدِ اللہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لَہُ: اقْرَأ ، فَافْتَتَحَ سُورَۃَ النِّسَائِ حَتَّی إذَا بَلَغَ إِلَی قولہ تعالی: {فَکَیْفَ إذَا جِئْنَا مِنْ کُلِّ أُمَّۃٍ بِشَہِیدٍ وَجِئْنَابِکَ عَلَی ہَؤُلائِ شَہِیدًا} الآیۃ قَالَ: فَدَمَعَتْ عَیْنَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ: حَسْبُک۔n(نسائی ۸۰۷۷۔ طبرانی ۸۴۵۹)","Da'if","Musannaf Ibn Abi Shaybah 30936","","","كتاب فضائل القرآن"
"30937","(۳۰۹۳۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَجْلَحِ ، عَنِ ابْنِ أَبْزَی ، عَنْ أَبِیہِ ، قَالَ: سَمِعْتُ أُبَیَّ بْنَ کَعْبٍ یَقُولُ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أُمِرْت أَنْ أَعْرِضَ عَلَیْک الْقُرْآنَ ، قَالَ: سَمَّانِی لَکَ ربک ، قَالَ: نَعَمْ ، فَقَالَ: أُبَیٌّ: {بِفَضْلِ اللہِ وَبِرَحْمَتِہِ فَبِذَلِکَ فَلْیَفْرَحُوا ہُوَ خَیْرٌ مِمَّا یَجْمَعُونَ}۔ (بخاری ۴۲۳۔ احمد ۱۲۲)","Hasan","Musannaf Ibn Abi Shaybah 30937","","","كتاب فضائل القرآن"
"30938","(۳۰۹۳۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن شَقِیقٍ ، قَالَ: قیلَ لِعَبْدِ اللہِ: إنَّ فُلانًا یَقْرَأُ الْقُرْآنَ مَنْکُوسًا ، فَقَالَ عَبْدُ اللہِ: ذَاکَ مَنْکُوسُ الْقَلْبِ۔","Sahih","Musannaf Ibn Abi Shaybah 30938","","","كتاب فضائل القرآن"
"30939","(۳۰۹۳۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن ہَارُونَ بْنِ عَنْتَرَۃَ ، عَنْ أَبِیہِ ، قَالَ سَأَلْتُ ابْنَ عَبَّاسٍ: أَیُّ الْعَمَلِ أَفْضَلُ ، قَالَ: ذِکْرُ اللہِ أکبر ، وَمَا جَلَسَ قَوْمٌ فِی بَیْتٍ یَتَعَاطَوْنَ فِیہِ کِتَابَ اللہِ فِیمَا بَیْنَہُمْ وَیَتَدَارَسُونَہُ إِلاَّ أَظَلَّتْہُمُ الْمَلائِکَۃُ بِأَجْنِحَتِہَا ، وَکَانُوا أَضْیَافَ اللہِ مَا دَامُوا فِیہِ حَتَّی یُفِیضُوا فِی حَدِیثٍ غَیْرِہِ۔ (دارمی ۳۵۶)","Sahih","Musannaf Ibn Abi Shaybah 30939","","","كتاب فضائل القرآن"
"30940","(۳۰۹۴۰) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَن شُعْبَۃَ ، عَنْ أَبِی رَجَائٍ ، قَالَ: سَأَلْت مُحَمَّدًا عَن نَقْطِ الْمَصَاحِفِ ؟ فَقَالَ: إنِّی أَخَافُ أَنْ یَزِیدُوا فِی الْحُرُوفِ ، أَوْ یُنْقِصُوا۔","No Data Available","Musannaf Ibn Abi Shaybah 30940","","","كتاب فضائل القرآن"
"30941","(۳۰۹۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ خَارِجَۃَ ، عَنْ خَالدٍ ، قَالَ: رَأَیْتُ ابْنِ سِیرِینَ یَقرأ فی مُصْحَفِ مَنْقُوط۔","No Data Available","Musannaf Ibn Abi Shaybah 30941","","","كتاب فضائل القرآن"
"30942","(۳۰۹۴۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ النُّقَطَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30942","","","كتاب فضائل القرآن"
"30943","(۳۰۹۴۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الہُذَلی ، عَنِ الْحَسَنِ قَالَ: لاَ بَأْسَ بِنُقَطِہَا بِالأَحْمَرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30943","","","كتاب فضائل القرآن"
"30944","(۳۰۹۴۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالدٍ ، أَوْ غَیْرَہُ قَالَ: رَأَیْتُ ابْنِ سِیرِینَ یَقرأ فی مُصْحَفِ مَنْقُوط۔","","Musannaf Ibn Abi Shaybah 30944","","","كتاب فضائل القرآن"
"30945","(۳۰۹۴۵) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَبِی حَیَّانَ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمًا بَارِزًا لِلنَّاسِ فَأَتَاہُ رَجُلٌ ، فَقَالَ: یَا رَسُولَ اللہِ ، مَا الإِیمَانُ ؟ فَقَالَ: الإِیمَانُ أَنْ تُؤْمِنَ بِاللہِ وَمَلائِکَتِہِ وَکُتُبِہِ وَلِقَائِہِ وَرُسُلِہِ وَتُؤْمِنَ بِالْبَعْثِ الآخِرِ ، قَالَ: یَا رَسُولَ اللہِ ، مَا الإسْلامُ ، قَالَ: أَنْ تَعْبُدَ اللَّہَ ، وَلا تُشْرِکَ بِہِ شَیْئًا وَتُقِیمَ الصَّلاۃَ الْمَکْتُوبَۃَ وَتُؤْتِیَ الزَّکَاۃَ الْمَفْرُوضَۃَ وَتَصُومَ رَمَضَانَ ، قَالَ: یَا رَسُولَ اللہِ ، مَا الإِحْسَانُ ؟ قَالَ: أَنْ تَعْبُدَ اللَّہَ کَأَنَّک تَرَاہُ فَإِنَّک إِنْ لاَ تَرَاہُ فَإِنَّہُ یَرَاک۔ (مسلم ۵۔ احمد ۴۲۶)","Sahih","Musannaf Ibn Abi Shaybah 30945","","","كتاب الإيمان"
"30946","(۳۰۹۴۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی جَمْرَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ وَفْدَ عَبْدِ الْقَیْسِ أَتَوْا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنِ الْوَفْدُ ، أَوْ مَنِ الْقَوْمُ ، قَالُوا: رَبِیعَۃُ ، قَالَ: مَرْحَبًا بِالْقَوْمِ ، أَوْ بِالْوَفْدِ غَیْرَ خَزَایَا ، وَلا نَدَامَی ، فَقَالُوا: یَا رَسُولَ اللہِ ، إنَّا نَأْتِیک مِنْ شُقَّۃٍ بَعِیدَۃٍ ، وَإِنَّ بَیْنَنَا وَبَیْنَکَ ہَذَا الْحَیَّ مِنْ کُفَّارِ مُضَرَ ، وَإِنَّا لاَ نَسْتَطِیعُ أَنْ نَأْتِیَک إلاَّ فِی الشَّہْرِ الْحَرَامِ ، فَمُرْنَا بِأَمْرٍ فَصْلٍ نُخْبِرُ بِہِ مَنْ وَرَائَنَا نَدْخُلُ بِہِ الْجَنَّۃَ ، قَالَ: فَأَمَرَہُمْ بِأَرْبَعٍ وَنَہَاہُمْ عَنْ أَرْبَعٍ: أَمَرَہُمْ بِالإِیمَانِ بِاللہِ وَحْدَہُ ، وَقَالَ: ہَلْ تَدْرُونَ مَا الإِیمَانُ بِاللہِ ، قَالُوا: اللَّہُ وَرَسُولُہُ أَعْلَمُ ، قَالَ: شَہَادَۃُ أَنْ لاَ إلَہَ إلاَّ اللَّہُ ، وَأَنَّ مُحَمَّدًا رَسُولُ اللہِ وَإِقَامُ الصَّلاۃِ وَإِیتَائُ الزَّکَاۃِ وَصَوْمُ رَمَضَانَ ، وَأَنْ تُعْطُوا الْخُمُسَ مِنَ الْمَغْنَمِ ، فَقَالَ: احْفَظُوہُ وَأَخْبِرُوا بِہِ مَنْ وَرَائَکُمْ۔ (بخاری ۸۷۔ مسلم ۲۴)","Sahih","Musannaf Ibn Abi Shaybah 30946","","","كتاب الإيمان"
"30947","(۳۰۹۴۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ عَطِیَّۃَ مَوْلَی بَنِی عَامِرٍ ، عَنْ یَزِیدَ بْنِ بِشْر السَّکْسَکِیِّ ، قَالَ: قدِمْت الْمَدِینَۃَ فَدَخَلْتُ عَلَی عَبْدِ اللہِ بْنِ عُمَرَ ، فَأَتَاہُ رَجُلٌ مِنْ أَہْلِ الْعِرَاقِ ، فَقَالَ: یَا عَبْدَ اللہِ ، مَالَک تَحُجُّ وَتَعْتَمِرُ وَتَرَکْت الْغَزْوَ فِی سَبِیلِ اللہِ ، فَقَالَ: وَیْلَک إنَّ الإِیمَانَ بُنِیَ عَلَی خَمْسٍ: تَعْبُدُ اللَّہَ وَتُقِیمُ الصَّلاۃَ وَتُؤْتِی الزَّکَاۃَ وَتَحُجُّ الْبَیْتَ وَتَصُومُ رَمَضَانَ قَالَ: فَرَدَّہَا عَلَیْہِ ، فَقَالَ: یَا عَبْدَ اللہِ ، تَعْبُدُ اللَّہَ وَتُقِیمُ الصَّلاۃَ وَتُؤْتِی الزَّکَاۃَ وَتَحُجُّ الْبَیْتَ وَتَصُومُ رَمَضَانَ قَالَ: فَرَدَّہَا عَلَیْہِ ، فَقَالَ: یَا عَبْدَ اللہِ ، تَعْبُدُ اللَّہَ وَتُقِیمُ الصَّلاۃَ وَتُؤْتِی الزَّکَاۃَ وَتَحُجُّ الْبَیْتَ وَتَصُومُ رَمَضَانَ ، کَذَلِکَ ، قَالَ لَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 30947","","","كتاب الإيمان"
"30948","(۳۰۹۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عُمَارَۃَ ، عَنْ أَبِی زُرْعَۃَ ، قَالَ عُمَرُ: عُرَی الإِیمَانِ أَرْبَعٌ: الصَّلاۃُ وَالزَّکَاۃُ وَالْجِہَادُ وَالأَمَانَۃُ۔","","Musannaf Ibn Abi Shaybah 30948","","","كتاب الإيمان"
"30949","(۳۰۹۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ صِلَۃَ ، قَالَ: قَالَ حُذَیْفَۃُ: الإسْلامُ ، ثَمَانیَۃُ أَسْہُمٍ: الصَّلاۃُ سَہْمٌ وَالزَّکَاۃُ سَہْمٌ وَالْجِہَادُ سَہْمٌ وَصَوْمُ رَمَضَانَ سَہْمٌ وَالأَمْرُ بِالْمَعْرُوفِ سَہْمٌ وَالنَّہْیُ عَنِ الْمُنْکَرِ سَہْمٌ وَالإِسْلامُ سَہْمٌ ، وَقَدْ خَابَ مَنْ لاَ سَہْمَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30949","","","كتاب الإيمان"
"30950","(۳۰۹۵۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ: سَمِعْتُ عُرْوَۃَ بْنَ النَّزَّالِ یُحَدِّثُ عَنْ مُعَاذِ بْنِ جَبَلٍ ، قَالَ: أَقْبَلْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ غَزْوَۃِ تَبُوکَ ، فَلَمَّا رَأَیْتہ خَالِیًا قُلْتُ: یَا رَسُولَ اللہِ ، أَخْبِرْنِی بِعَمَلٍ یُدْخِلُنِی الْجَنَّۃَ ، فقَالَ: بَخٍ ، لَقَدْ سَأَلْت عَنْ عَظِیمٍ ، وَہُوَ یَسِیرٌ عَلَی مَنْ یَسَّرَہُ اللَّہُ عَلَیْہِ: تُقِیمُ الصَّلاۃَ الْمَکْتُوبَۃَ وَتُؤَدِّی الزَّکَاۃَ الْمَفْرُوضَۃَ وَتَلْقَی اللَّہَ لاَ تُشْرِکُ بِہِ شَیْئًا ، أَوَلا أَدُلُّک عَلَی رَأْسِ الأَمْرِ وَعَمُودِہِ وَذِرْوَۃِ سَنَامِہِ ؟ أَمَّا رَأْسُ الأَمْرِ فَالإِسْلام مَنْ أَسْلَمَ سَلِمَ ، وَأَمَّا عَمُودہ فَالصَّلاۃ ، وَأَمَّا ذِرْوَتہ وَسَنَامہ فَالْجِہَادُ فِی سَبِیلِ اللہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30950","","","كتاب الإيمان"
"30951","(۳۰۹۵۱) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنِ الْحَکَمِ ، عَنِ الأَعْمَشِ ، عَنْ مَیْمُونِ بْنِ أَبِی شبیب ، عَنْ مُعَاذِ بْنِ جَبَلٍ ، قَالَ: خَرَجْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ غَزْوَۃَ تَبُوکَ ۔۔۔ثُمَّ ذَکَرَ نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 30951","","","كتاب الإيمان"
"30952","(۳۰۹۵۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ رِبْعِیٍّ ، عَنْ رَجُلٍ مِنْ بَنِی أَسَدٍ ، عَنْ عَلِیٍّ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أَرْبَعٌ لَنْ یَجِدَ رَجُلٌ طَعْمَ الإِیمَانِ حَتَّی یُؤْمِنَ بِہِنَّ: لاَ إلَہَ إلاَّ اللَّہُ وَحْدَہُ ،وَأَنِّی رَسُولُ اللہِ بَعَثَنِی بِالْحَقِّ وَبِأَنَّہُ مَیِّتٌ ، ثُمَّ مَبْعُوثٌ مِنْ بَعْدِ الْمَوْتِ وَیُؤْمِنَ بِالْقَدَرِ کُلِّہِ۔n(ترمذی ۲۱۴۵۔ احمد ۱۳۳)","Da'if","Musannaf Ibn Abi Shaybah 30952","","","كتاب الإيمان"
"30953","(۳۰۹۵۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: جَائَ أَعْرَابِیٌّ إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ: السَّلامُ عَلَیْک یَا غُلامَ بَنِی عَبْدِ الْمُطَّلِبِ ، فَقَالَ: وَعَلَیْک ، فَقَالَ: إنِّی رَجُلٌ مِنْ أَخْوَالِکَ مِنْ بَنِی سَعْدِ بْنِ بَکْرٍ وَأَنَا رَسُولُ قَوْمِی إلَیْک وَوَافِدُہُمْ وَأَنَا سَائِلُک فَمُشْتَدَّۃٌ مَسْأَلَتِی إیاک ، وَمُنَاشِدُک فَمُشْتَدَّۃٌ مُنَاشَدَتِی إیَّاکَ ، قَالَ: خُذْ یَا أَخَا بَنِی سَعْدٍ ، قَالَ: مَنْ خَلَقَک وَہُوَ خَالِقُ مَنْ قَبْلَک وَہُوَ خَالِقُ مَنْ بَعْدَکَ ؟ قَالَ: اللَّہُ ، قَالَ: نَشَدْتُک بِذَلِکَ أَہُوَ أَرْسَلَک ؟ قَالَ: نَعَمْ ، قَالَ: مَنْ خَلَقَ السَّمَاوَاتِ السَّبْعَ وَالأَرْضِینَ السَّبْعَ وَأَجْرَی بَیْنَہُنَّ الرِّزْقَ ؟ قَالَ: اللَّہُ ، قَالَ: نَشَدْتُک بِذَلِکَ أَہُوَ أَرْسَلِکَ ؟ قَالَ: نَعَمْ ، قَالَ: فَإِنَّا وَجَدْنَا فِی کِتَابِکَ وَأَمَرَتْنَا رُسُلُک أَنْ نُصَلِّیَ فِی الْیَوْمِ وَاللَّیْلَۃِ خَمْسَ صَلَوَاتٍ لِمَوَاقِیتِہَا فَنَشَدْتُک بِذَلِکَ أَہُوَ أَمَرَک بِہِ ؟ قَالَ: نَعَمْ ، قَالَ: فَإِنَّا وَجَدْنَا فِی کِتَابِکَ وَأَمَرَتْنَا رُسُلُک أَنْ نَأْخُذَ مِنْ حَوَاشِی أَمْوَالِنَا فَنَرُدَّہَا عَلَی فُقَرَائِنَا فَنَشَدْتُک بِذَلِکَ أَہُوَ أَمَرَک بِذَلِکَ ؟ قَالَ: نَعَمْ ، ثُمَّ قَالَ: أَمَّا الْخَامِسَۃُ فَلَسْت سَائلک عنہا ، وَلا أَرَبَ لِی فِیہَا ، قَالَ: ثُمَّ قَالَ: أَمَا وَالَّذِی بَعَثَک بِالْحَقِّ لأَعْمَلَنَّ بِہَا وَمَنْ أَطَاعَنِی مِنْ قَوْمِی ، ثُمَّ رَجَعَ فَضَحِکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی بَدَتْ نَوَاجِذُہُ ، ثُمَّ قَالَ: وَالَّذِی نَفْسِی بِیَدِہِ لَئِنْ صَدَقَ لَیَدْخُلَنَّ الْجَنَّۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 30953","","","كتاب الإيمان"
"30954","(۳۰۹۵۴) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ: حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، قَالَ: کُنَّا قَدْ نُہِینَا أَنْ نَسْأَلَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ شَیْئٍ ، فَکَانَ یُعْجِبُنَا أَنْ یَأْتِیَ الرَّجُلُ مِنْ أَہْلِ الْبَادِیَۃِ الْعَاقِلُ فَیَسْأَلُہُ وَنَحْنُ نَسْمَعُ ، فَجَائَ رَجُلٌ مِنْ أَہْلِ الْبَادِیَۃِ ، فَقَالَ: یَا مُحَمَّدُ أَتَانَا رَسُولُک فَزَعَمَ أَنَّ اللَّہَ أَرْسَلِکَ ، فقَالَ: صَدَقَ ، قَالَ: فَمَنْ خَلَقَ السَّمَائَ ؟ قَالَ: اللَّہُ ، قَالَ: فَمَنْ خَلَقَ الأَرْضَ ؟ قَالَ: اللَّہُ ، قَالَ: فَمَنْ نَصَبَ ہَذِہِ الْجِبَالَ ؟ قَالَ: اللَّہُ ، قَالَ: فَبِالَّذِی خَلَقَ السَّمَائَ وَخَلَقَ الأَرْضَ وَنَصَبَ الْجِبَالَ آللَّہُ أرسلک ؟ قَالَ: نَعَمْ، قَالَ: وَزَعَمَ رَسُولُک أَنَّ عَلَیْنَا خمس صلوات فی یومنا ولیلتنا قَالَ صدق ،قَالَ: فَبِالَّذِی أرسلک آللَّہُ أمرک بہذا قَالَ نعم: قَالَ: وزَعَمَ رَسُولُک أَنَّ عَلَیْنَا زکاۃ فی أموالنا قَالَ صدق ،قَالَ: فَبِالَّذِی أرسلک آللَّہُ أمرک بہذا قَالَ نعم: قَالَ: فزَعَمَ رَسُولُک أَنَّ عَلَیْنَا صَوْمَ شَہْر رَمَضَانَ فِی سَنَتِنَا ، قَالَ: صَدَقَ ، قَالَ: فَبِالَّذِی خَلَقَ السَّمَائَ وَخَلَقَ الأَرْضَ وَنَصَبَ الْجِبَالَ آللَّہُ أَمَرَک بِہَذَا ؟ قَالَ: نَعَمْ ، قَالَ: وزَعَمَ رَسُولُک ، أَنَّ عَلَیْنَا الْحَجَّ لِمَنِ اسْتَطَاعَ إلَیْہِ سَبِیلاً ، قَالَ صَدَقَ ، قَالَ: فَبِالَّذِی خَلَقَ السَّمَائَ وَخَلَقَ الأَرْضَ وَنَصَبَ الْجِبَالَ آللَّہُ أَمَرَک بِہَذَا ؟ قَالَ: نَعَمْ ، ثُمَّ وَلَّی ، وَقَالَ: وَالَّذِی بَعَثَک بِالْحَقِّ لاَ أَزْدَادُ عَلَیْہِ شَیْئًا ، وَلا أَنْقُصُ مِنْہُ شَیْئًا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إِنْ صَدَقَ دَخَلَ الْجَنَّۃَ۔ (مسلم ۴۱۔ ترمذی ۶۱۹)","Sahih","Musannaf Ibn Abi Shaybah 30954","","","كتاب الإيمان"
"30955","(۳۰۹۵۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ عَلِیِّ بْنِ مَسْعَدَۃَ ، قَالَ: حدَّثَنَا قَتَادَۃُ ، قَالَ: حَدَّثَنَا أَنَسُ بْنُ مَالِکٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: الإسْلامُ عَلانِیَۃٌ وَالإِیمَانُ فِی الْقَلْبِ ، ثُمَّ یُشِیرُ بِیَدِہِ إِلَی صَدْرِہِ: التَّقْوَی ہَاہُنَا التَّقْوَی ہَاہُنَا۔ (احمد ۱۳۴۔ بزار ۲۰)","Da'if","Musannaf Ibn Abi Shaybah 30955","","","كتاب الإيمان"
"30956","(۳۰۹۵۶) حَدَّثَنَا مُصْعَبُ بْنُ الْمِقْدَامِ ، قَالَ: حدَّثَنَا أَبُو ہِلالٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ إیمَانَ لِمَنْ لاَ أَمَانَۃَ لَہُ۔ (احمد ۱۳۵۔ ابن حبان ۱۹۴)","Da'if","Musannaf Ibn Abi Shaybah 30956","","","كتاب الإيمان"
"30957","(۳۰۹۵۷) حَدَّثَنَا أَبُو أُسَامَۃَ، قَالَ: حدَّثَنَا عَوْفٌ، عَنْ عَبْدِ اللہِ بْنِ عَمْرِو ابْنِ ہِنْدٍ الْجَمَلِیِّ، قَالَ: قَالَ عَلِیٌّ: الإِیمَانُ یَبْدَأُ نُقْطَۃً بَیْضَائَ فِی الْقَلْبِ ، کُلَّمَا ازْدَادَ الإِیمَانُ ازْدَادَتْ بَیَاضًا حَتَّی یَبْیَضَّ الْقَلْبُ کُلُّہُ ، وَالنِّفَاقُ یَبْدَأُ نُقْطَۃً سَوْدَائَ فِی الْقَلْبِ کُلَّمَا ازْدَادَ النِّفَاقُ ازْدَادَتْ سَوَادًا حَتَّی یَسْوَدَّ الْقَلْبُ کُلُّہُ ، وَالَّذِی نَفْسِی بِیَدِہِ لَوْ شَقَقْتُمْ ، عَنْ قَلْبِ مُؤْمِنٍ لَوَجَدْتُمُوہُ أَبْیَضَ ، وَلَوْ شَقَقْتُمْ ، عَنْ قَلْبِ مُنَافِقٍ لَوَجَدْتُمُوہُ أَسْوَدَ الْقَلْب ۔","Da'if","Musannaf Ibn Abi Shaybah 30957","","","كتاب الإيمان"
"30958","(۳۰۹۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، عَنْ سُلَیْمَانَ بْنِ مَیْسَرَۃَ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ: قَالَ عَبْدُ اللہِ: إنَّ الرَّجُلَ لَیُذْنِبُ الذَّنْبَ فَیُنْکَتُ فِی قَلْبِہِ نُکْتَۃٌ سَوْدَائُ ، ثُمَّ یُذْنِبُ الذَّنْبَ فَتُنْکَتُ أُخْرَی حَتَّی یَصِیرَ قَلْبُہُ لَوْن الشَّاۃِ الرَّبْدَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 30958","","","كتاب الإيمان"
"30959","(۳۰۹۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، قَالَ: قَالَ ہِشَامٌ ، عَنْ أَبِیہِ: مَا نَقَصَتْ أَمَانَۃُ عَبْدٍ قَطُّ إلاَّ نَقَصَ إیمَانہ۔","","Musannaf Ibn Abi Shaybah 30959","","","كتاب الإيمان"
"30960","(۳۰۹۶۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ: الإِیمَانُ ہَیوبٌ۔","","Musannaf Ibn Abi Shaybah 30960","","","كتاب الإيمان"
"30961","(۳۰۹۶۱) ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ نَافِعِ بْنِ جُبَیْرٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعَثَ بشر بْنَ سُحَیْمٍ الْغِفَارِیَّ یَوْمَ النَّحْرِ یُنَادِی فِی النَّاسِ ، إِنَّہُ لاَ یَدْخُلُ الْجَنَّۃَ إلاَّ نَفْسٌ مُؤْمِنَۃٌ۔","","Musannaf Ibn Abi Shaybah 30961","","","كتاب الإيمان"
"30962","(۳۰۹۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃ ، عَنْ أَبِیہِ ، قَالَ: لاَ تَغُرَّنَّکُمْ صَلاۃُ امْرِئٍ ، وَلا صِیَامُہُ ، مَنْ شَائَ صَامَ وَمَنْ شَائَ صَلَّی ، أَلا لاَ دِینَ لِمَنْ لاَ أَمَانَۃَ لَہُ۔","","Musannaf Ibn Abi Shaybah 30962","","","كتاب الإيمان"
"30963","(۳۰۹۶۳) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أبی جَعْفَرٍ الْخطْمِیِّ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ عُمَیْرِ بْنِ حَبِیبِ بْنِ خُمَاشَۃَ ، أَنَّہُ قَالَ: الإِیمَانُ یَزِیدُ وَیَنْقُصُ ، قِیلَ لَہُ: وَمَا زِیَادَتُہُ ، وَمَا نُقْصَانُہُ ، قَالَ: إذَا ذَکَرْنَاہُ وَخَشِینَاہُ فَذَلِکَ زِیَادَتُہُ ، وَإِذَا غَفَلْنَا وَنَسِینَا وَضَیَّعْنَا فَذَلِکَ نُقْصَانُہُ۔","","Musannaf Ibn Abi Shaybah 30963","","","كتاب الإيمان"
"30964","(۳۰۹۶۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ: اللَّہُمَّ لاَ تَنْزِعْ مِنِّی الإِیمَانَ کَمَا أَعْطَیْتنیہ۔","Sahih","Musannaf Ibn Abi Shaybah 30964","","","كتاب الإيمان"
"30965","(۳۰۹۶۵) حَدَّثَنَا حَمَّادُ بْنُ مَعْقِل ، عَنْ غَالِبِ عَنْ بَکْرٍ ، قَالَ: لَوْ سُئلتُ عَنْ أَفْضَلِ أَہْلِ ہَذَا الْمَسْجِدِ فَقَالُوا: تَشْہَدُ أَنَّہُ مُؤْمِنٌ مُسْتَکْمِلُ الإِیمَانِ بَرِیئٌ مِنَ النِّفَاقِ ، لَمْ أَشْہَدْ ، وَلَوْ شَہِدْت لَشَہِدْت ، أَنَّہُ فِی الْجَنَّۃِ ، وَلَوْ سُئِلْت عَنْ رَجُلٍ ، أَشَرِّ أَو أَخْبَثِ ، الشَّکُّ مِنْ أَبِی بَکْرٍ ، رَجُلٍ فَقَالُوا: نَشْہَدُ أَنَّہُ مُنَافِقٌ مُسْتَکْمِلُ النِّفَاقِ بَرِیئٌ مِنَ الإِیمَانِ ، لَمْ أَشْہَدْ ، وَلَوْ شَہِدْت لَشَہِدْت أَنَّہُ فِی النَّارِ۔","","Musannaf Ibn Abi Shaybah 30965","","","كتاب الإيمان"
"30966","(۳۰۹۶۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا فُضَیْلُ بْنُ غَزْوَانَ ، قَالَ: حَدَّثَنَا عُثْمَان بْنُ أَبِی صَفِیَّۃَ الأَنْصَارِیُّ ، قَالَ: قَالَ عَبْدُ اللہِ بْنُ عَبَّاسٍ لِغُلامٍ مِنْ غِلْمَانِہِ: أَلا أُزَوِّجُک فَمَا مِنْ عَبْدٍ یَزْنِی إلاَّ نَزَعَ اللَّہُ مِنْہُ نُورَ الإِیمَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 30966","","","كتاب الإيمان"
"30967","(۳۰۹۶۷) حَدَّثَنَا سُلَیْمَانُ بْنُ حَرْبٍ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ، عن ہشام عَنْ أَبِیہِ، عَنْ عَائِشَۃَ، قَالَتْ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ یَزْنِی الزَّانِی حِینَ یَزْنِی وَہُوَ مُؤْمِنٌ، وَلا یَسْرِقُ حِینَ یَسْرِقُ وَہُوَ مُؤْمِنٌ۔ (بزار ۱۱۲)","Sahih","Musannaf Ibn Abi Shaybah 30967","","","كتاب الإيمان"
"30968","(۳۰۹۶۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ ثَعْلَبَۃَ ، عَنْ أَبِی قِلابَۃَ قَالَ: حدَّثَنِی الرَّسُولُ الَّذِی سَأَلَ عَبْدُ اللہِ بْنُ مَسْعُودٍ ، قَالَ: أَسْأَلُک بِاللہِ أَتَعْلَمُ ، أَنَّ النَّاسَ کَانُوا فِی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی ثَلاثَۃِ أَصْنَافٍ مُؤْمِنِ السَّرِیرَۃِ وَمُؤْمِنِ الْعَلانِیَۃِ ، وَکَافِرِ السَّرِیرَۃِ کَافِرِ الْعَلانِیَۃِ ، وَمُؤْمِنِ الْعَلانِیَۃِ کَافِرِ السَّرِیرَۃِ ، قَالَ: فَقَالَ عَبْدُ اللہِ: اللَّہُمَّ نَعَمْ ، قَالَ: فَأَنْشُدُک بِاللہِ: مِنْ أَیِّہِمْ کُنْت ، فَقَالَ: اللَّہُمَّ مُؤْمِنُ السَّرِیرَۃِ مُؤْمِنُ الْعَلانِیَۃِ ، أَنَا مُؤْمِنٌ ، قَالَ أَبُو إِسْحَاقَ: فَلَقِیت عَبْدَ اللہِ بْنَ مَعْقِلٍ ، فَقُلْتُ: إنَّ أُنَاسًا مِنْ أَہْلِ الصَّلاحِ یَعِیبُونَ عَلَیَّ أَنْ أَقُولَ: أَنَا مُؤْمِنٌ ، فَقَالَ عَبْدُ اللہِ بْنُ مَعْقِلٍ: لَقَدْ خِبْتَ وَخَسِرْت إِنْ لَمْ تَکُنْ مُؤْمِنًا۔","Da'if","Musannaf Ibn Abi Shaybah 30968","","","كتاب الإيمان"
"30969","(۳۰۹۶۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُوسَی بْنِ مُسْلِمٍ الشَّیْبَانِیِّ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ: وَمَا عَلَی أَحَدِکُمْ أَنْ یَقُولَ: أَنَا مُؤْمِنٌ ، فَوَاللہِ لَئِنْ کَانَ صَادِقًا لاَ یُعَذِّبُہُ اللَّہُ عَلَی صِدْقِہِ ، وَإِنْ کَانَ کَاذِبًا لَمَا دَخَلَ عَلَیْہِ مِنَ الْکُفْرِ أَشَدُّ عَلَیْہِ مِنَ الْکَذِبِ۔","","Musannaf Ibn Abi Shaybah 30969","","","كتاب الإيمان"
"30970","(۳۰۹۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إِبْرَاہِیمَ، عَن عَلْقَمَۃَ، قَالَ: قَالَ لَہُ رَجُلٌ: أَمُؤْمِنٌ أَنْتَ، قَالَ: أَرْجُو۔","No Data Available","Musannaf Ibn Abi Shaybah 30970","","","كتاب الإيمان"
"30971","(۳۰۹۷۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنِ الْحَارِثِ بْنِ عَمِیرۃَ الزُّبَیْدِیِّ ، قَالَ: وَقَعَ الطَّاعُونُ بِالشَّامِ فَقَامَ مُعَاذٌ بِحِمْصٍ فَخَطَبَہُمْ ، فَقَالَ: n إنَّ ہَذَا الطَّاعُونَ رَحْمَۃُ رَبِّکُمْ وَدَعْوَۃُ نَبِیِّکُمْ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَوْتُ الصَّالِحِینَ قَبْلَکُمْ ، اللَّہُمَّ اقْسِمْ لآلِ مُعَاذٍ نُصِیبَہُمُ الأَوْفَی مِنْہُ ، قَالَ: فَلَمَّا نَزَلَ ، عَنِ الْمِنْبَرِ أَتَاہُ آتٍ ، فَقَالَ: إنَّ عَبْدَ الرَّحْمَن بْنَ مُعَاذٍ قَدْ أُصِیبَ ، فَقَالَ: إنَّا لِلَّہِ وَإِنَّا إلَیْہِ رَاجِعُونَ ، قَالَ: ثُمَّ انْطَلَقَ نَحْوَہُ ، قَالَ: فَلَمَّا رَآہُ عَبْدُ الرَّحْمَنِ مُقْبِلاً ، قَالَ: إِنَّہُ {الْحَقُّ مِنْ رَبِّکَ فَلا تَکُونَنَّ مِنَ الْمُمْتَرِینَ} ، قَالَ: فَقَالَ: یَا بُنَیَّ سَتَجِدُنِی إِنْ شَائَ اللَّہُ مِنَ الصَّابِرِینَ قَالَ: فَمَاتَ آلُ مُعَاذٍ إنْسَانًا إنْسَانًا حَتَّی کَانَ مُعَاذٌ آخِرَہُمْ ، قَالَ: فَأُصِیبَ ، فَأَتَاہُ الْحَارِثُ بْنُ عَمِیرَۃَ الزُّبَیْدِیُّ ، قَالَ: فَأُغْشِیَ عَلَی مُعَاذٍ غَشْیَۃً ، قَالَ: فَأَفَاقَ مُعَاذٌ وَالْحَارِثُ یَبْکِی ، قَالَ: فَقَالَ مُعَاذٌ: مَا یُبْکِیک ؟ قَالَ: فَقَالَ: أَبْکِی عَلَی الْعِلْمِ الَّذِی یُدْفَنُ مَعَک، قَالَ: فَقَالَ: إِنْ کُنْت طَالِبَ الْعِلْمِ لاَ مَحَالَۃَ فَاطْلُبْہُ مِنْ عَبْدِاللہِ بْنِ مَسْعُودٍ وَمِنْ عُوَیْمِرٍ أَبِی الدَّرْدَائِ وَمِنْ سَلْمَانَ الْفَارِسِیِّ ، قَالَ: وَإِیَّاکَ وَزَلَّۃَ الْعَالِمِ ، قَالَ: قُلْتُ: وَکَیْف لِی أَصْلَحَک اللَّہُ أَنْ أَعْرِفَہَا ، قَالَ: إنَّ لِلْحَقِّ نُورًا یُعْرَفُ بِہِ ، قَالَ: فَمَاتَ مُعَاذٌ وَخَرَجَ الْحَارِثُ یُرِیدُ عَبْدَ اللہِ بْنَ مَسْعُودٍ بِالْکُوفَۃِ، قَالَ: فَانْتَہَی إِلَی بَابِہِ فَإِذَا عَلَی الْبَابِ نَفَرٌ مِنْ أَصْحَابِ عَبْدِ اللہِ یَتَحَدَّثُونَ، قَالَ: فَجَرَی بَیْنَہُمَ الْحَدِیثُ حَتَّی ، قَالُوا: یَا شَامِیُّ أَمُؤْمِنٌ أَنْتَ ؟ قَالَ: نَعَمْ ، فَقَالُوا: مِنْ أَہْلِ الْجَنَّۃِ ؟ قَالَ: فَقَالَ: إنَّ لِی ذُنُوبًا لاَ أَدْرِی مَا یَصْنَعُ اللَّہُ فِیہَا فَلَوْ أنی أَعْلَمُ، أَنَّہَا غُفِرَتْ لِی لأَنْبَأْتُکُمْ أَنِّی مِنْ أَہْلِ الْجَنَّۃِ ، قَالَ: فَبَیْنَمَا ہُمْ کَذَلِکَ إذْ خَرَجَ عَلَیْہِمْ عَبْدُ اللہِ ، فَقَالُوا لَہُ: أَلا تَعْجَبُ مِنْ أَخِینَا ہَذَا الشَّامِیِّ یَزْعُمُ أَنَّہُ مُؤْمِنٌ ، ولا یَزْعُمُ أَنَّہُ مِنْ أَہْلِ الْجَنَّۃِ ، قَالَ: فَقَالَ عَبْدُ اللہِ: لَوْ قُلْتُ إحْدَاہُمَا لاتَّبَعَتُہَا الأُخْرَی ، قَالَ: فَقَالَ الْحَارِثُ: {إنَّا لِلَّہِ وَإِنَّا إلَیْہِ رَاجِعُونَ} صَلَّی اللَّہُ عَلَی مُعَاذٍ ، قَالَ: وَیْحَک وَمَنْ مُعَاذٌ ، قَالَ: مُعَاذُ بْنُ جَبَلٍ ، قَالَ: وَمَا قَالَ؟ قَالَ: إیَّاکَ وَزَلَّۃَ الْعَالِمِ فَأحْلِفُ بِاللہِ ، أَنَّہَا مِنْک لَزَلَّۃٌ یَا ابْنَ مَسْعُودٍ ، وَمَا الإِیمَانُ إلاَّ أَنَّا نُؤْمِنُ بِاللہِ وَمَلائِکَتِہِ وَکُتُبِہِ وَرُسُلِہِ وَالْیَوْمِ الآخِرِ وَالْجَنَّۃِ وَالنَّارِ وَالْبَعْثِ وَالْمِیزَانِ، وَإِنَّ لَنَا ذُنُوبًا لاَ نَدْرِی مَا یَصْنَعُ اللَّہُ فِیہَا ، فَلَوْ أنا نَعْلَمُ أَنَّہَا غُفِرَتْ لَنَا لَقُلْنَا: إنَّا مِنْ أَہْلِ الْجَنَّۃِ ، فَقَالَ عَبْدُ اللہِ: صَدَقْت وَاللہِ إِنْ کَانَتْ مِنِّی لَزَلَّۃً۔n(ابوداؤد ۴۵۹۶۔ حاکم ۴۶۰)","","Musannaf Ibn Abi Shaybah 30971","","","كتاب الإيمان"
"30972","(۳۰۹۷۲) حَدَّثَنَا مُعْصَبُ بْنُ الْمِقْدَامِ ، قَالَ: حدَّثَنَا عِکْرِمَۃُ بْنُ عَمَّارٍ ، قَالَ: حَدَّثَنِی أَبُو زُمَیْلٍ ، عَنْ مَالِکِ بْنِ مَرْثَدٍ الزِّمَّانِیِّ ، عَنْ أَبِیہِ ، قَالَ: قَالَ أَبُو ذَرٍّ: سَأَلْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَاذَا یُنَجِّی الْعَبْدَ مِنَ النَّارِ ، فَقَالَ: الإِیمَانُ بِاللہِ ، قَالَ: قُلْتُ: یَا نَبِیَّ اللَّہُ أَوَ مَعَ الإِیمَانِ عَمَلٌ ، فَقَالَ: تَرْضَخُ مِمَّا رَزَقَک اللَّہُ ، أَوْ یَرْضَخُ مِمَّا رَزَقَہُ اللَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30972","","","كتاب الإيمان"
"30973","(۳۰۹۷۳) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ أُمِّ مُحَمَّدٍ ، أَنَّ رَجُلاً قَالَ لِعَائِشَۃَ: مَا الإِیمَانُ ؟ قَالَتْ: أُفَسِّرُ أَمْ أُجْمِلُ ، قَالَ: لاَ بَلْ أَجْمِلِی ، فقَالَتْ: مَنْ سَرَّتْہُ حَسَنَتُہُ وَسَائَتْہُ سَیِّئَتُہُ فَہُوَ مُؤْمِنٌ۔n(ترمذی ۲۱۶۵۔ احمد ۴۴۶)","Da'if","Musannaf Ibn Abi Shaybah 30973","","","كتاب الإيمان"
"30974","(۳۰۹۷۴) حَدَّثَنَا مُحَمَّدُ بْنُ سابق ، قَالَ: حدَّثَنَا إسْرَائِیلُ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن علْقَمَۃَ ، عَنْ عَبْدِ اللہِ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لَیْسَ الْمُؤْمِنُ بِالطَّعَّانِ ، وَلا اللَّعَّانِ ، وَلا بِالْفَاحِشِ ، وَلا بِالْبَذِیئ۔ (ترمذی ۱۹۷۷۔ احمد ۴۰۴)","Hasan","Musannaf Ibn Abi Shaybah 30974","","","كتاب الإيمان"
"30975","(۳۰۹۷۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، عَنْ سَعْدٍ ، قَالَ: الْمُؤْمِنُ یُطْبَع عَلَی الْخِلالِ کُلِّہَا إلاَّ الْخِیَانَۃَ وَالْکَذِبَ۔","Sahih","Musannaf Ibn Abi Shaybah 30975","","","كتاب الإيمان"
"30976","(۳۰۹۷۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ، عَنْ مَالِکِ بْنِ الْحَارِثِ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ، عَنْ عَبْدِ اللہِ ، قَالَ: الْمُؤْمِنُ یُطْوَی عَلَی الْخِلالِ کُلِّہَا غَیْرَ الْخِیَانَۃِ وَالْکَذِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 30976","","","كتاب الإيمان"
"30977","(۳۰۹۷۷) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، قَالَ: حُدِّثْت عن أَبِی أُمَامَۃَ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: یُطْوی الْمُؤْمِنُ عَلَی کُلِّ شیئٍ إلاَّ الْخِیَانَۃَ وَالْکَذِبَ۔","Da'if","Musannaf Ibn Abi Shaybah 30977","","","كتاب الإيمان"
"30978","(۳۰۹۷۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، عَنْ أَبِی مُوسَی ، عن النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: تَکُونُ فِی آخِرِ الزَّمَانِ فِتَنٌ کَقِطَعِ اللَّیْلِ الْمُظْلِمِ ، یُصْبِحُ الرَّجُلُ مُؤْمِنًا وَیُمْسِی کَافِرًا وَیُمْسِی مُؤْمِنًا وَیُصْبِحُ کَافِرًا۔","Sahih","Musannaf Ibn Abi Shaybah 30978","","","كتاب الإيمان"
"30979","(۳۰۹۷۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حَجَّاجِ بْنِ أَبِی عُثْمَانَ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ ہِلالِ بْنِ أَبِی مَیْمُونَۃَ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ مُعَاوِیَۃَ بْنِ الْحَکَمِ السُّلَمِیِّ ، قَالَ: کَانَتْ لِی جَارِیَۃٌ تَرْعَی غَنَمًا لِی فِی قِبَلِ أُحُدٍ وَالْجَوَّانِیَّۃ ، فَاطَّلَعْتہَا ذَاتَ یَوْمٍ وَإِذَا الذِّئْبُ قَدْ ذَہَبَ بِشَاۃٍ مِنْ غَنَمِہَا ، قَالَ: وَأَنَا رَجُلٌ مِنْ بَنِی آدَمَ آسَفُ کَمَا یَأْسَفُونَ ، لَکِنِّی صَکَکْتہَا صَکَّۃً فَأَتَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَظَّمَ ذَلِکَ عَلَیَّ ، فَقُلْتُ یَا رَسُولَ اللہِ ، أَفَلا أُعْتِقُہَا قَالَ: ائْتِنِی بِہَا ، فَقَالَ لَہَا: أَیْنَ اللَّہُ ؟ قَالَتْ فِی السَّمَائِ ، قَالَ: مَنْ أَنَا ؟ قَالَتْ: أَنْتَ رَسُولُ اللہِ ، قَالَ: أَعْتِقْہَا ، فَإِنَّہَا مُؤْمِنَۃٌ۔ (مسلم ۳۳۔ ابوداؤد ۹۲۷)","Sahih","Musannaf Ibn Abi Shaybah 30979","","","كتاب الإيمان"
"30980","(۳۰۹۸۰) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْمِنْہَالِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ الْحَکَمِ یَرْفَعُہُ ، أَنَّ رَجُلاً أَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ: إنَّ عَلَی أُمِّی رَقَبَۃً مُؤْمِنَۃً ، وَعِنْدِی رَقَبَۃٌ سَوْدَائُ أَعْجَمِیَّۃٌ ، فَقَالَ: ائْتِ بِہَا ، فَقَالَ: أَتَشْہَدِینَ أَنْ لاَ إلَہَ إلاَّ اللَّہُ وَأَنِّی رَسُولُ اللہِ ؟ قَالَتْ: نَعَمْ ، قَالَ: فَأَعْتِقْہَا۔ (بزار ۱۳۔ طبرانی ۱۳۳۶۹)","Da'if","Musannaf Ibn Abi Shaybah 30980","","","كتاب الإيمان"
"30981","(۳۰۹۸۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَثَلُ الْمُؤْمِنِ مَثَلُ الزَّرْعِ لاَ تَزَالُ الرِّیحُ تُمِیلُہُ ، وَلا یَزَالُ الْمُؤْمِنُ یُصِیبُہُ بَلائٌ ، وَمَثَلُ الْکَافِرِ کَمَثَلِ شَجَرَۃِ الأَرْزِ لاَ تَہْتَزُّ حَتَّی تَسْتَحْصِدَ ۔ (مسلم ۲۱۶۳۔ ترمذی ۲۸۶۶)","Sahih","Musannaf Ibn Abi Shaybah 30981","","","كتاب الإيمان"
"30982","(۳۰۹۸۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا زَکَرِیَّا ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ: أَخْبَرَنِی ابْنُ کَعْبِ بْنِ مَالِکٍ ، عَنْ أَبِیہِ کعب ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مثل الْمُؤْمِنُ کَمَثَلِ الخَامَۃِ من الزَّرْعِ تَفِیئُہَا الرِّیحُ تَصْرَعُہَا مَرَّۃً وَتَعْدِلُہَا أُخْرَی حَتَّی تَہِیجَ ، وَمَثَلُ الْکَافِرِ کَمَثَلِ الأَرْزَۃِ الْمُجْذِیَۃِ عَلَی أَصلہَا لاَ یَفِیئُہَا شَیْئٌ حَتَّی یَکُونَ انْجِعَافُہَا مَرَّۃً وَاحِدَۃً۔ (بخاری ۵۶۴۳۔ مسلم ۵۹)","Sahih","Musannaf Ibn Abi Shaybah 30982","","","كتاب الإيمان"
"30983","(۳۰۹۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ یحیی بْنِ سعید ، عَنْ بَشِیرِ بْنِ نَہِیکٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: مَثَلُ الْمُؤْمِنِ الضَّعِیفِ کَمَثَلِ الْخَامَۃِ مِنَ الزَّرْعِ تُمِیلُہَا الرِّیحُ مَرَّۃً وَتُقِیمُہَا مَرَّۃً ، قَالَ: قُلْتُ: فَالْمُؤْمِنُ الْقَوِیُّ ، قَالَ: مِثْلُ النَّخْلَۃِ تُؤْتِی أُکُلَہَا کُلَّ حِینٍ فِی ظِلِّہَا ذَلِکَ ، وَلا تُمِیلُہَا الرِّیحُ۔","Sahih","Musannaf Ibn Abi Shaybah 30983","","","كتاب الإيمان"
"30984","(۳۰۹۸۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ: مَثَلُ الْمُؤْمِنِ کَمَثَلِ النَّحْلَۃِ تَأْکُلُ طَیِّبًا وَتَضَعُ طَیِّبًا۔","Da'if","Musannaf Ibn Abi Shaybah 30984","","","كتاب الإيمان"
"30985","(۳۰۹۸۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ بُرَیْدِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی بُرْدَۃَ عَنْ أَبِی مُوسَی ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: الْمُؤْمِنُ لِلْمُؤْمِنِ کَالْبُنْیَانِ یَشُدُّ بَعْضُہُ بَعْضًا۔ (بخاری ۴۸۱۔ مسلم ۱۹۹۹)","Sahih","Musannaf Ibn Abi Shaybah 30985","","","كتاب الإيمان"
"30986","(۳۰۹۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی عَمَّارٍ ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إنَّ عَمَّارًا مُلِئَ إیمَانًا إِلَی مُشَاشِہِ۔","","Musannaf Ibn Abi Shaybah 30986","","","كتاب الإيمان"
"30987","(۳۰۹۸۷) حَدَّثَنَا عَثَّامُ بْنُ عَلِیٍّ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہَانِئِ بْنِ ہَانِئٍ ، قَالَ: کُنَّا جُلُوسًا عِنْدَ عَلِیٍّ فَدَخَلَ عَمَّارٌ ، فَقَالَ: مَرْحَبًا بِالطَّیِّبِ الْمُطَیَّبِ ، سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: إنَّ عَمَّارًا مُلِئَ إیمَانًا إِلَی مَشَاشِہِ۔ (ابن ماجہ ۱۴۷)","Hasan","Musannaf Ibn Abi Shaybah 30987","","","كتاب الإيمان"
"30988","(۳۰۹۸۸) حَدَّثَنَا عَفَّان ، قَالَ: حَدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ: حدَّثَنَا زَکَرِیَّا ، قَالَ: سَمِعْتُ الْحَسَنَ یَقُولُ: إنَّ الإِیمَانَ لَیْسَ بِالتَّحَلِّی ، وَلا بِالتَّمَنِّی ، إنَّمَا الإِیمَانُ مَا وَقَرَ فِی الْقَلْبِ وَصَدَّقَہُ الْعَمَلُ۔ (ابن عدی ۲۲۹۰)","","Musannaf Ibn Abi Shaybah 30988","","","كتاب الإيمان"
"30989","(۳۰۹۸۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ قَالَ لِغِلْمَانِہِ: مَنْ أَرَادَ مِنْکُمُ الْبَائَۃَ زَوَّجْنَاہُ ، فَلا یَزْنِی مِنْکُمْ زَانٍ إلاَّ نَزَعَ اللَّہُ مِنْہُ نُورَ الإِیمَانِ ، فَإِنْ شَائَ أَنْ یَرُدَّہُ، وَإِنْ شَائَ أَنْ یَمْنَعَہُ إیَّاہُ مَنَعَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30989","","","كتاب الإيمان"
"30990","(۳۰۹۹۰) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ ، عَجَبًا لإخْوَانِنَا مِنْ أَہْلِ الْعِرَاقِ یُسَمُّونَ الْحَجَّاجَ مُؤْمِنًا۔","","Musannaf Ibn Abi Shaybah 30990","","","كتاب الإيمان"
"30991","(۳۰۹۹۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الأَجْلَحِ ، عَنِ الشَّعْبِیِّ ، قَالَ: أَشْہَدُ أَنَّہُ مُؤْمِنٌ بِالطَّاغُوتِ کَافِرٌ بِاللہِ ، یَعْنِی الْحَجَّاجَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30991","","","كتاب الإيمان"
"30992","(۳۰۹۹۲) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ،قَالَ: یَأْتِی عَلَی النَّاسِ زَمَانٌ یَجْتَمِعُونَ وَیُصَلُّونَ فِی الْمَسَاجِدِ وَلَیْسَ فِیہِمْ مُؤْمِنٌ۔","Sahih","Musannaf Ibn Abi Shaybah 30992","","","كتاب الإيمان"
"30993","(۳۰۹۹۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، قَالَ: قلْنَا لِطَلْقِ بْنِ حَبِیبٍ: صِفْ لَنَا التَّقْوَی ، قَالَ: التَّقْوَی عَمَلٌ بِطَاعَۃِ اللہِ رَجَائَ رَحْمَۃِ اللہِ عَلَی نُورٍ مِنَ اللہ?? ، وَالتَّقْوَی تَرْکُ مَعْصِیَۃِ اللہِ مَخَافَۃَ اللہِ عَلَی نُورٍ مِنَ اللہِ۔","","Musannaf Ibn Abi Shaybah 30993","","","كتاب الإيمان"
"30994","(۳۰۹۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ إذَا ذَکَرَ الْحَجَّاجَ ، قَالَ: أَلا لَعَنْۃُ اللہِ عَلَی الظَّالِمِینَ۔","No Data Available","Musannaf Ibn Abi Shaybah 30994","","","كتاب الإيمان"
"30995","(۳۰۹۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَفَی بِمَنْ شَکَّ فِی الْحَجَّاجِ لَحَاہُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 30995","","","كتاب الإيمان"
"30996","(۳۰۹۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی بَشِیرٍ ، عَنْ عَبْدِ اللہِ بْنِ مِساور ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَا یُؤْمِنُ مَنْ بَاتَ شَبْعَانَ وَجَارُہُ طاوٍ إِلَی جَنْبِہِ۔n(ابویعلی ۲۶۹۱۔ حاکم ۱۶۷)","Da'if","Musannaf Ibn Abi Shaybah 30996","","","كتاب الإيمان"
"30997","(۳۰۹۹۷) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی التَّیْمِیُّ ، عَنْ مَنْصُورٍ ، عَنْ طَلْقِ بْنِ حَبِیبٍ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ: ثَلاثٌ مَنْ کُنَّ فِیہِ وَجَدَ طَعْمَ الإِیمَانِ وَحَلاوَتَہُ: أَنْ یَکُونَ اللَّہُ وَرَسُولُہُ أَحَبَّ إلَیْہِ مِمَّا سِوَاہُمَا ، وَأَنْ یُحِبَّ فِی اللہِ وَیُبْغِضَ فِی اللہِ ، وَذَکَرَ الشِّرْکَ۔","Sahih","Musannaf Ibn Abi Shaybah 30997","","","كتاب الإيمان"
"30998","(۳۰۹۹۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، عَنِ الْمِسْوَرِ بْنِ مَخْرَمَۃَ ، وَابْنِ عَبَّاسٍ أَنَّہُمَا دَخَلا عَلَی عُمَرَ حِینَ طُعِنَ ، فَقَالاَ: الصَّلاۃُ ، فَقَالَ: إِنَّہُ لاَ حَظَّ لأَحَدٍ فِی الإسْلامِ أَضَاعَ الصَّلاۃَ فَصَلَّی وَجُرْحُہُ یَثْعَبُ دَمًا۔ (بیہقی ۳۵۷)","Sahih","Musannaf Ibn Abi Shaybah 30998","","","كتاب الإيمان"
"30999","(۳۰۹۹۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِیہِ ، عَنْ شباک ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، أَنَّہُ کَانَ یَقُولُ لأَصْحَابِہِ : امْشُوا بِنَا نَزْدَاد إیمَانًا۔","","Musannaf Ibn Abi Shaybah 30999","","","كتاب الإيمان"
"31000","(۳۱۰۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَنِ الأَسْوَدِ بْنِ ہِلالٍ الْمُحَارِبِیِّ ، قَالَ : قَالَ لِی مُعَاذٌ اجْلِسْ بِنَا نُؤْمِنُ سَاعَۃً ، یَعْنِی نَذْکُرُ اللَّہَ۔","Sahih","Musannaf Ibn Abi Shaybah 31000","","","كتاب الإيمان"
"31001","(۳۱۰۰۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مَہْدِیِّ بْنِ مَیْمُونٍ ، عَنْ عِمْرَانَ الْقَصِیرِ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : کَانَ أَبُو الدَّرْدَائِ یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُک إیمَانًا دَائِمًا وَعِلْمًا نَافِعًا وَہَدْیًا قَیِّمًا ، قَالَ مُعَاوِیَۃُ : فَنُرَی أَنَّ مِنَ الإِیمَانِ إیمَانًا لَیْسَ بِدَائِمٍ وَمِنَ الْعِلْمِ عِلْمًا لاَ یَنْفَعُ وَمِنَ الْہَدْیِ ہَدْیًا لَیْسَ بِقَیِّمٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31001","","","كتاب الإيمان"
"31002","(۳۱۰۰۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَعْمَشِ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَنِ الأَسْوَدِ بْنِ ہِلالٍ : قَالَ : کَانَ مُعَاذٌ یَقُولُ لِرَجُلٍ مِنْ إخْوَانِہِ : اجْلِسْ بِنَا فَلْنُؤْمِنْ سَاعَۃً ، فَیَجْلِسَانِ یَتَذَاکَرَانِ اللَّہَ وَیَحْمَدَانِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31002","","","كتاب الإيمان"
"31003","(۳۱۰۰۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ طَلْحَۃَ ، عَنْ زُبَیْدٍ ، عَنْ زِرٍّ ، قَالَ : کَانَ عُمَرُ مِمَّا یَأْخُذُ بِیَدِ الرَّجُلِ وَالرَّجُلَیْنِ مِنْ أَصْحَابِہِ فَیَقُولُ : قُمْ بِنَا نَزْدَاد إیمَانًا۔","Sahih","Musannaf Ibn Abi Shaybah 31003","","","كتاب الإيمان"
"31004","(۳۱۰۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ سُلَیْمَانَ بْنِ مَیْسَرَۃَ وَالْمُغِیرَۃِ بْنِ شِبْلٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ الأَحْمَسِیِّ ، عَنْ سَلْمَانَ ، قَالَ : إنَّ مَثَلَ الصَّلَوَاتِ الْخَمْسِ کَمَثَلِ سِہَامِ الْغَنِیمَۃِ ، فَمَنْ یَضْرِبُ فِیہَا بِخَمْسَۃٍ خَیْرٌ مِمَّنْ یَضْرِبُ فِیہَا بِأَرْبَعَۃٍ وَمَنْ یَضْرِبُ فِیہَا بِأَرْبَعَۃٍ خَیْرٌ مِمَّنْ یَضْرِبُ فِیہَا بِثَلاثَۃٍ ، وَمَنْ یَضْرِبُ فِیہَا بِثَلاثَۃٍ خَیْرٌ مِمَّنْ یَضْرِبُ فِیہَا بِسَہْمَیْنِ ، وَمَنْ یَضْرِبُ فِیہَا بِسَہْمَیْنِ خَیْرٌ مِمَّنْ یَضْرِبُ فِیہَا بِسَہْمٍ ، وَمَا جَعَلَ اللَّہُ مَنْ لَہُ سَہْمٌ فِی الإسْلامِ کَمَنْ لاَ سَہْمَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31004","","","كتاب الإيمان"
"31005","(۳۱۰۰۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، عَنْ عَلِیِّ بْنِ مُدْرِکٍ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیرَۃَ ، قَالَ الإِیمَانُ نُورٌ ، فَمَنْ زَنَا فَارَقَہُ الإِیمَانُ ، فَمَنْ لامَ نَفْسَہُ وَرَاجَعَ رَاجَعَہُ الإِیمَانُ۔","Sahih","Musannaf Ibn Abi Shaybah 31005","","","كتاب الإيمان"
"31006","(۳۱۰۰۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَکْمَلُ الْمُؤْمِنِینَ إیمَانًا أَحْسَنُہُمْ خُلُقًا۔","Hasan","Musannaf Ibn Abi Shaybah 31006","","","كتاب الإيمان"
"31007","(۳۱۰۰۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَکْمَلُ الْمُؤْمِنِینَ إیمَانًا وَأَفْضَلُ الْمُؤْمِنِینَ إیمَانًا أَحْسَنُہُمْ خُلُقًا۔","Hasan","Musannaf Ibn Abi Shaybah 31007","","","كتاب الإيمان"
"31008","(۳۱۰۰۸) حَدَّثَنَا حَفْصُ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلابَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَکْمَلُ الْمُؤْمِنِینَ إیمَانًا أَحْسَنُہُمْ خُلُقًا۔","Sahih","Musannaf Ibn Abi Shaybah 31008","","","كتاب الإيمان"
"31009","(۳۱۰۰۹) حَدَّثَنَا الْمُقْرِیئُ ، عَنْ سَعِیدِ بْنِ أَبِی أَیُّوبَ ، عَنِ ابْنِ عَجْلانَ عَنِ الْقَعْقَاعِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَکْمَلُ الْمُؤْمِنِینَ أَحْسَنُہُمْ خُلُقًا۔","Hasan","Musannaf Ibn Abi Shaybah 31009","","","كتاب الإيمان"
"31010","(۳۱۰۱۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ یَعْلَی بْنِ حَکِیمٍ ، قَالَ : أَکْبَرُ ظَنِّی ، أَنَّہُ قَالَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : قَالَ ابْنُ عُمَرَ : إن الْحَیَائُ وَالإِیمَانُ قُرِنَا جَمِیعًا ، فَإِذَا رُفِعَ أَحَدُہُمَا رُفِعَ الآخَرُ۔","Sahih","Musannaf Ibn Abi Shaybah 31010","","","كتاب الإيمان"
"31011","(۳۱۰۱۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَلَمَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : قَالَ رَجُلٌ عِنْدَ عَبْدِ اللہِ : إنِّی مُؤْمِنٌ ، فَقَالَ : قُلْ : إنِّی فِی الْجَنَّۃِ ، وَلَکِنَّا نُؤْمِنُ بِاللہِ وَمَلائِکَتِہِ وَکُتُبِہِ وَرُسُلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31011","","","كتاب الإيمان"
"31012","(۳۱۰۱۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : قیلَ لَہُ : أَمُؤْمِنٌ أَنْتَ ، قَالَ : أَرْجُو۔","No Data Available","Musannaf Ibn Abi Shaybah 31012","","","كتاب الإيمان"
"31013","(۳۱۰۱۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ سِمَاکِ بْنِ سَلَمَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عِصْمَۃَ ، أَنَّ عَائِشَۃَ ، قَالَتْ : أَنْتُمُ الْمُؤْمِنُونَ إِنْ شَائَ اللَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31013","","","كتاب الإيمان"
"31014","(۳۱۰۱۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : إذَا سُئِلَ أَحَدُکُمْ : أَمُؤْمِنٌ أَنْتَ ، فَلا یَشُکَّنَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 31014","","","كتاب الإيمان"
"31015","(۳۱۰۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ زِیَادِ بْنِ عِلاقَۃَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : إذَا سُئِلَ أَحَدُکُمْ : أَمُؤْمِنٌ ا??َنْتَ ؟ فَلا یَشُکُّ فِی إیمَانِہِ۔","","Musannaf Ibn Abi Shaybah 31015","","","كتاب الإيمان"
"31016","(۳۱۰۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ مُوسَی بْنِ أَبِی کَثِیرٍ ، عَنْ رَجُلٍ لَمْ یُسَمِّہِ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ ابْنَ مَسْعُودٍ یَقُولُ : أَنَا مُؤْمِنٌ۔","Da'if","Musannaf Ibn Abi Shaybah 31016","","","كتاب الإيمان"
"31017","(۳۱۰۱۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی وَائِلٍ ، قَالَ : جَائَ رَجُلٌ ، فَقَالَ : لَقِیت رَکْبًا ، فَقُلْتُ : مَنْ أَنْتُمْ ، قَالُوا : نَحْنُ الْمُؤْمِنُونَ ، قَالَ : أَفَلا قَالُوا : نَحْنُ فِی الْجَنَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 31017","","","كتاب الإيمان"
"31018","(۳۱۰۱۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، وَعَنْ مُحِلٍّ ، عَنْ إبْرَاہِیمَ أَنَّہُمَا کَانَا إذَا سُئِلا قَالا : آمَنَّا بِاللہِ وَمَلائِکَتِہِ وَکُتُبِہِ وَرُسُلہ۔","No Data Available","Musannaf Ibn Abi Shaybah 31018","","","كتاب الإيمان"
"31019","(۳۱۰۱۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : لَقِیت عَبْدَ اللہِ بْنَ مَعْقِلٍ ، فَقُلْتُ لَہُ : إنَّ أُنَاسًا مِنْ أَہْلِ الصَّلاحِ یَعِیبُونَ عَلَیَّ أَنْ أَقُولَ : أَنَا مُؤْمِنٌ ، فَقَالَ عَبْدُ اللہِ بْنَ مَعْقِلٍ : لَقَدْ خِبْتَ وَخَسِرْتَ إِنْ لَمْ تَکُنْ مُؤْمِنًا۔","","Musannaf Ibn Abi Shaybah 31019","","","كتاب الإيمان"
"31020","(۳۱۰۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عَمْرِو بْنِ مُنَبِّہٍ ، عَنْ سَوَّارِ بْنِ شَبِیبٍ ، قَالَ : جَائَ رَجُلٌ إِلَی ابْنِ عُمَرَ ، فَقَالَ : إنَّ ہَاہُنَا قَوْمًا یَشْہَدُونَ عَلَیَّ بِالْکُفْرِ ، فَقَالَ : أَلا تَقُولُ : لاَ إلَہَ إلاَّ اللَّہُ فَتُکَذِّبُہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 31020","","","كتاب الإيمان"
"31021","(۳۱۰۲۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی قِلابَۃَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ الأَنْصَارِیِّ ، قَالَ : تَسَمَّوْا بِأَسْمَائِکُمَ الَّتِی سَمَّاکُمَ اللَّہُ بِالْحَنِیفِیَّۃِ وَالإِسْلامِ وَالإِیمَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 31021","","","كتاب الإيمان"
"31022","(۳۱۰۲۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ سَلَمَۃَ بْنِ سَبْرَۃَ ، قَالَ : خَطَبَنَا مُعَاذٌ ، فَقَالَ : أَنْتُمُ الْمُؤْمِنُونَ وَأَنْتُمْ أَہْلُ الْجَنَّۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 31022","","","كتاب الإيمان"
"31023","(۳۱۰۲۳) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : کَتَبَ إلَیْنَا عُمَرُ بْنُ عَبْدِ الْعَزِیزِ أَمَّا بَعْدُ فَإِنَّ عُرَی الدِّینِ وَقِوَامَ الإسْلامِ الإِیمَانُ بِاللہِ وَإِقَامُ الصَّلاۃِ وَإِیتَائُ الزَّکَاۃِ فَصَلُّوا الصَّلاۃَ لِوَقْتِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 31023","","","كتاب الإيمان"
"31024","(۳۱۰۲۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، أَنَّ نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یَخْرُجُ مِنَ النَّارِ مَنْ قَالَ لاَ إلَہَ إلاَّ اللَّہُ ، وَکَانَ فِی قَلْبِہِ مِنَ الْخَیْرِ شَعِیرَۃً ، ثُمَّ قَالَ الثَّانِیَۃَ : یَخْرُجُ مِنَ النَّارِ مَنْ قَالَ لاَ إلَہَ إلاَّ اللَّہُ ، وفِی قَلْبِہِ مِنَ الْخَیْرِ مَا یَزِنُ بُرَّۃً ، ثُمَّ قَالَ : یَخْرُجُ مِنَ النَّارِ مَنْ قَالَ لاَ إلَہَ إلاَّ اللَّہُ، وَکَانَ فِی قَلْبِہِ مِنَ الْخَیْرِ مَا یَزِنُ ذَرَّۃ۔","Sahih","Musannaf Ibn Abi Shaybah 31024","","","كتاب الإيمان"
"31025","(۳۱۰۲۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عَامِرِ بْنِ سَعْدٍ ، عَنْ أَبِیہِ ، أَنَّ نَفَرًا أَتَوْا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَعْطَاہُمْ إلاَّ رَجُلاً مِنْہُمْ ، فَقَالَ سَعْدٌ : یَا رَسُولَ اللہِ ، أَعْطَیْتَہُمْ وَتَرَکْتَ فُلانًا وَاللہِ إنِّی لأُرَاہُ مُؤْمِنًا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوْ مُسْلِمًا ، فَقَالَ سَعْدٌ : وَاللہِ إنِّی لأرَاہُ مُؤْمِنًا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوْ مُسْلِمًا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَلِکَ ثَلاثًا۔","Sahih","Musannaf Ibn Abi Shaybah 31025","","","كتاب الإيمان"
"31026","(۳۱۰۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، عَنْ سَلْمَانَ ، قَالَ : یُقَالُ لَہُ : سَلْ تُعْطَہُ ، یَعْنِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَاشْفَعْ تُشَفَّعْ وَادْعُ تُجَبْ ، فَیَرْفَعُ رَأْسَہُ فَیَقُولُ : أُمَّتِی أُمَّتِی مَرَّتَیْنِ ، أَوْ ثَلاثًا فَقَالَ سَلْمَانُ یَشْفَعُ فِی کُلِّ مَنْ فِی قَلْبِہِ مِثْقَالُ حَبَّۃِ حِنْطَۃٍ مِنْ إیمَانٍ ، أَوْ مِثْقَالُ شَعِیرَۃٍ مِنْ إیمَانٍ ، أَوْ مِثْقَالُ حَبَّۃِ خَرْدَلٍ مِنْ إیمَانٍ ، قَالَ سَلْمَانُ : فَذَلِکُمُ الْمَقَامُ الْمَحْمُودُ۔","Sahih","Musannaf Ibn Abi Shaybah 31026","","","كتاب الإيمان"
"31027","(۳۱۰۲۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَزْنِی الزَّانِی حِینَ یَزْنِی وَہُوَ مُؤْمِنٌ ، وَلا یَسْرِقُ حِینَ یَسْرِقُ وَہُوَ مُؤْمِنٌ، وَلا یَشْرَبُ الْخَمْرَ حِینَ یَشْرَبُ وَہُوَ مُؤْمِنٌ، وَلا یَنْتَہِبُ نُہْبَۃً یَرْفَعُ النَّاسُ فِیہَا أَبْصَارَہُمْ وَہُوَ مُؤْمِنٌ۔","Hasan","Musannaf Ibn Abi Shaybah 31027","","","كتاب الإيمان"
"31028","(۳۱۰۲۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدٌ ، عَنْ یَحْیَی بْنِ عَبَّادِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لاَ یَزْنِی الزَّانِی حِینَ یَزْنِی وَہُوَ مُؤْمِنٌ ، وَلا یَسْرِقُ حِینَ یَسْرِقُ وَہُوَ مُؤْمِنٌ ، وَلا یَشْرَبُ ، یَعْنِی الْخَمْرَ حِینَ یَشْرَبُ وَہُوَ مُؤْمِنٌ فَإِیَّاکُمْ إیَّاکُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 31028","","","كتاب الإيمان"
"31029","(۳۱۰۲۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُدْرِکٍ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَزْنِی الزَّانِی حِینَ یَزْنِی وَہُوَ مُؤْمِنٌ ، وَلا یَسْرِقُ حِینَ یَسْرِقُ وَہُوَ مُؤْمِنٌ ، وَلا یَشْرَبُ الْخَمْرَ حِینَ یَشْرَبُہَا وَہُوَ مُؤْمِنٌ ، وَلا یَنْتَہِبُ نُہْبَۃً ذَاتَ شَرَفٍ یَرْفَعُ الْمُسْلِمُونَ إلَیْہَا رُؤُوسَہُمْ وَہُوَ مُؤْمِنٌ۔","Da'if","Musannaf Ibn Abi Shaybah 31029","","","كتاب الإيمان"
"31030","(۳۱۰۳۰) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ فِرَاسٍ ، عَنْ مُدْرِکٍ ، عَنِ ابْنِ أَبِی أَوْفَی ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ۔۔۔ نَحْوَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 31030","","","كتاب الإيمان"
"31031","(۳۱۰۳۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ، قَالَ: حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَیَائُ مِنَ الإِیمَانِ وَالإِیمَانُ فِی الْجَنَّۃِ وَالْبَذَائِ مِنَ الْجَفَائِ وَالْجَفَائُ فِی النَّارِ۔","Hasan","Musannaf Ibn Abi Shaybah 31031","","","كتاب الإيمان"
"31032","(۳۱۰۳۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، أَنَّہُ قَالَ : قیلَ : یَا رَسُولَ اللہِ ، أَیُّ الأَعْمَالِ أَفْضَلُ ، قَالَ : الصَّبْرُ وَالسَّمَاحَۃُ ، قِیلَ : أَیُّ الْمُؤْمِنِینَ أَکْمَلُ إیمَانًا ، قَالَ أَحْسَنُہُمْ خُلُقًا۔","Sahih","Musannaf Ibn Abi Shaybah 31032","","","كتاب الإيمان"
"31033","(۳۱۰۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : بَیْنَ الْعَبْدِ وَبَیْنَ الْکُفْرِ تَرْکُ الصَّلاۃِ۔ (ابوداؤد ۴۶۴۵۔ ترمذی ۲۶۲۰)","Sahih","Musannaf Ibn Abi Shaybah 31033","","","كتاب الإيمان"
"31034","(۳۱۰۳۴) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ، عَنِ الأَعْمَشِ، عَنْ أَبِی سُفْیَانَ، عَنْ جَابِرٍ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔۔۔ نَحْوَہُ۔ (مسلم ۸۸۔ ترمذی ۲۶۱۹)","Sahih","Musannaf Ibn Abi Shaybah 31034","","","كتاب الإيمان"
"31035","(۳۱۰۳۵) حَدَّثَنَا یَحْیَی بْنُ وَاضِحٍ ، عَنْ حُسَیْنِ بْنِ وَاقِدٍ ، قَالَ : سَمِعْتُ ابْنَ بُرَیْدَۃَ یَقُولُ : سَمِعْت أَبِی یَقُولُ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یقول : الْعَہْدُ الَّذِی بَیْنَنَا وَبَیْنَہُمَ الصَّلاۃُ ، فَمَنْ تَرَکَہَا فَقَدْ کَفَرَ۔n(ترمذی ۲۶۲۱۔ احمد ۳۴۶)","Hasan","Musannaf Ibn Abi Shaybah 31035","","","كتاب الإيمان"
"31036","(۳۱۰۳۶) حَدَّثَنَا شَرِیکٌ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَنْ لَمْ یُصَلِّ فَلا دِینَ لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31036","","","كتاب الإيمان"
"31037","(۳۱۰۳۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی ، عَنْ أَبِی قِلابَۃَ ، عَنْ أَبِی الْمَلِیحِ ، عَنِ بُرَیْدَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ تَرَکَ الْعَصْرَ فَقَدْ حَبِطَ عَمَلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31037","","","كتاب الإيمان"
"31038","(۳۱۰۳۸) حَدَّثَنَا عِیسَی ، وَوَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی قِلابَۃَ ، عَنْ أَبِی الْمُہَاجِرِ ، عَنْ بُرَیْدَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ تَرَکَ الْعَصْرَ فَقَدْ حَبِطَ عَمَلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31038","","","كتاب الإيمان"
"31039","(۳۱۰۳۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَبَّادُ بْنُ مَیْسَرَۃَ الْمُنْقِرِیُّ ، عَنْ أَبِی قِلابَۃَ ، وَالْحَسَنِ ، أَنَّہُمَا کَانَا جَالِسَیْنِ، فَقَالَ أَبُو قِلابَۃَ : قَالَ أَبُو الدَّرْدَائِ : مَنْ تَرَکَ الْعَصْرَ حَتَّی تَفُوتَہُ مِنْ غَیْرِ عُذْرٍ فَقَدْ حَبِطَ عَمَلُہُ ، قَالَ: وَقَالَ الْحَسَنُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ تَرَکَ صَلاۃً مَکْتُوبَۃً حَتَّی تَفُوتَہ مِنْ غَیْرِ عُذْرٍ فَقَدْ حَبِطَ عَمَلُہُ۔","","Musannaf Ibn Abi Shaybah 31039","","","كتاب الإيمان"
"31040","(۳۱۰۴۰) حَدَّثَنَا ہَوْذَۃُ بْنُ خَلِیفَۃَ ، قَالَ : حدَّثَنَا عَوْفٌ ، عَنْ قَسَامَۃَ بْنِ زُہَیْرٍ ، قَالَ : لاَ إیمَانَ لِمَنْ لاَ أَمَانَۃَ لَہُ ، وَلا دِینَ لِمَنْ لاَ عَہْدَ لَہُ۔","","Musannaf Ibn Abi Shaybah 31040","","","كتاب الإيمان"
"31041","(۳۱۰۴۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، قَالَ : إنَّ أَفْضَلَ الْعِبَادَۃِ الرَّأْیُ الْحَسَنُ۔","","Musannaf Ibn Abi Shaybah 31041","","","كتاب الإيمان"
"31042","(۳۱۰۴۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ یُوسُفَ بْنِ مَیْمُونٍ ، قَالَ : قُلْتُ لِعَطَائٍ إنَّ قِبَلَنَا قَوْمًا نَعُدُّہُمْ مِنْ أَہْلِ الصَّلاحِ إِنْ قُلْنَا نَحْنُ مُؤْمِنُونَ عَابُوا ذَلِکَ عَلَیْنَا ، قَالَ : فَقَالَ عَطَائٌ نَحْنُ الْمُسْلِمُونَ الْمُؤْمِنُونَ ، وَکَذَلِکَ أَدْرَکْنَا أَصْحَابَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 31042","","","كتاب الإيمان"
"31043","(۳۱۰۴۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی الْبَخْتَرِیِّ ، عَنْ حُذَیْفَۃَ ، قَالَ : الْقُلُوبُ أَرْبَعَۃٌ : قَلْبٌ مُصَفَّحٌ ، فَذَلِکَ قَلْبُ الْمُنَافِقِ ، وَقَلْبٌ أَغْلَفُ ، فَذَلِکَ قَلْبُ الْکَافِرِ ، وَقَلْبٌ أَجْرَدُ ، کَأَنَّ فِیہِ سِرَاجًا یُزْہِرُ ، فَذَاکَ قَلْبُ الْمُؤْمِنِ ، وَقَلْبٌ فِیہِ نِفَاقٌ وَإِیمَانٌ ، فَمَثَلُہُ کَمَثَلِ قُرْحَۃٍ یَمُدُّ بِہَا قَیْحٌ وَدَمٌ ، وَمَثَلُہُ کَمَثَلِ شَجَرَۃٍ یَسْقِیہَا مَائٌ خَبِیثٌ وَمَائٌ طَیِّبٌ ، فَأَیُّ مَائٍ غَلَبَ عَلَیْہَا غَلَبَ۔ (طبری ۴۰۶)","","Musannaf Ibn Abi Shaybah 31043","","","كتاب الإيمان"
"31044","(۳۱۰۴۴) أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُکْثِرُ أَنْ یَقُولَ : یَا مُقَلِّبَ الْقُلُوبِ ، ثَبِّتْ قَلْبِی عَلَی دِینِکَ قَالُوا : یَا رَسُولَ اللہِ : آمَنَّا بِکَ وَبِمَا جِئْت بِہِ فَہَلْ تَخَافُ عَلَیْنَا ، قَالَ : إنَّ الْقُلُوبَ بَیْنَ إصْبَعَیْنِ مِنْ أَصَابِعِ اللہِ یُقَلِّبُہَا۔","Hasan","Musannaf Ibn Abi Shaybah 31044","","","كتاب الإيمان"
"31045","(۳۱۰۴۵) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : أَخْبَرَنَا أَبُو کَعْبٍ صَاحِبُ الْحَرِیرِ ، قَالَ : حَدَّثَنَا شَہْرُ بْنُ حَوْشَبٍ ، قَالَ : قُلْتُ لأمِّ سَلَمَۃَ : یَا أُمَّ الْمُؤْمِنِینَ مَا کَانَ أَکْثَرُ دُعَائِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا کَانَ عِنْدَکَ ، قَالَ : قُلْتُ : کَانَ أَکْثَرُ دُعَائِہِ : یَا مُقَلِّبَ الْقُلُوبِ ثَبِّتْ قَلْبِی عَلَی دِینِکَ ، قُلْتُ : یا رسول اللہ ، مَا أَکْثَرُ دُعَائِکَ یَا مُقَلِّبَ الْقُلُوب ثَبِّتْ قَلْبِی عَلَی دِینِکَ قَالَ : یَا أُمَّ سَلَمَۃَ : إِنَّہُ لَیْسَ من آدَمِیٌّ إلاَّ وَقَلْبُہُ بَیْنَ إصْبَعَیْنِ مِنْ أَصَابِعِ اللہِ مَا شَائَ أَقَامَ ، وَمَا شَائَ أَزَاغَ۔","Hasan","Musannaf Ibn Abi Shaybah 31045","","","كتاب الإيمان"
"31046","(۳۱۰۴۶) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا ہَمَّامُ بْنُ یَحْیَی ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ أُمِّ مُحَمَّدٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَقُولُ : یَا مُقَلِّبَ الْقُلُوبِ ، ثَبِّتْ قَلْبِی عَلَی دِینِکَ ، قُلْتُ : یَا رَسُولَ اللہِ إنَّک لَتَدْعُو بِہَذَا الدُّعَائِ ، قَالَ : یَا عَائِشَۃُ ، أَو مَا عَلِمْت أَنَّ قَلْبَ ابْنِ آدَمَ بَیْنَ إِصَابِعَیِ اللہِ ، إذَا شَائَ أَنْ یُقَلِّبَہُ إِلَی الْہُدَی قَلَّبَہُ ، وَإِنْ شَائَ أَنْ یُقَلِّبَہُ إِلَی ضَلالَۃٍ قَلَّبَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31046","","","كتاب الإيمان"
"31047","(۳۱۰۴۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ بْنِ عُتَیْبَۃ ، قَالَ : سَمِعْتُ ابْنَ أَبِی لَیْلَی یُحَدِّثُ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ کَانَ یَدْعُو بِہَذَا الدُّعَائِ : یَا مُقَلِّبَ الْقُلُوبِ ثَبِّتْ قَلْبِی عَلَی دِینِک۔","","Musannaf Ibn Abi Shaybah 31047","","","كتاب الإيمان"
"31048","(۳۱۰۴۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ ذَرٍّ ، عَنْ وَائِلِ بْنِ مُہَانَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : مَا رَأَیْت مِنْ نَاقِصِ الدِّینِ وَالرَّأْیِ أَغْلَبَ لِلرِّجَالِ ذَوِی الأَمْرِ عَلَی أَمْرِہِمْ مِنَ النِّسَائِ ، قَالُوا : یَا أَبَا عَبْدِ الرَّحْمَنِ ، وَمَا نُقْصَانُ دِینِہَا ، قَالَ : تَرْکُہَا الصَّلاۃَ أَیَّامَ حَیْضِہَا ، قَالُوا : فَمَا نُقْصَانُ عَقْلِہَا ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ امْرَأَتَیْنِ إلاَّ بِشَہَادَۃِ رَجُلٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31048","","","كتاب الإيمان"
"31049","(۳۱۰۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حسن بْنِ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، قَالَ : سُئِلَ إبْرَاہِیمُ ، عَنِ الرَّجُلِ یَقُولُ لِلرَّجُلِ : أَمُؤْمِنٌ أَنْتَ ، قَالَ : الْجَوَابُ فیہ بِدْعَۃٌ ، وَمَا یَسُرُّنِی أنی شَکَکْت۔","","Musannaf Ibn Abi Shaybah 31049","","","كتاب الإيمان"
"31050","(۳۱۰۵۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حَبِیبِ بْنِ الشَّہِیدِ ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ : لاَ یَزْنِی الزَّانِی حِینَ یَزْنِی وَہُوَ مُؤْمِنٌ ، وَلا یَسْرِقُ وَہُوَ مُؤْمِنٌ ، وَلا یَشْرَبُ الْخَمْرَ وَہُوَ مُؤْمِنٌ۔","Sahih","Musannaf Ibn Abi Shaybah 31050","","","كتاب الإيمان"
"31051","(۳۱۰۵۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، عَنْ أَبِی عَمَّارٍ ، عَنْ حُذَیْفَۃَ ، قَالَ : وَاللہِ إنَّ الرَّجُلَ لَیُصْبِحُ بَصِیرًا ، ثُمَّ یُمْسِی ، وَمَا یَنْظُرُ بِشُفْرٍ۔","Hasan","Musannaf Ibn Abi Shaybah 31051","","","كتاب الإيمان"
"31052","(۳۱۰۵۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ یَسَارٍ ، قَالَ : بَلَغَ عُمَرَ ، أَنَّ رَجُلاً بِالشَّامِ یَزْعُمُ ، أَنَّہُ مُؤْمِنٌ ، قَالَ : فَکَتَبَ عُمَرُ : أَنِ اجْلِبُوہُ عَلَی ، فَقَدِمَ عَلَی عُمَرَ ، فَقَالَ : أَنْتَ الَّذِی تَزْعُمُ أَنَّک مُؤْمِنٌ ، قَالَ : نَعَمْ ، قَالَ : ہَلْ کَانَ النَّاسُ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلاَّ عَلَی ثَلاثَۃِ مَنَازِلَ : مُؤْمِنٌ وَکَافِرٌ وَمُنَافِقٌ ، وَاللہِ مَا أَنَا بِکَافِرٍ ، وَلا نَافَقْتُ ، قَالَ : فَقَالَ لَہُ عُمَرُ : ابْسُطْ یَدَک ، قَالَ ابْنُ إدْرِیسَ : قُلْتُ : رَضِیً بِمَا قَالَ : قَالَ : رَضِیً بِمَا قَالَ۔","","Musannaf Ibn Abi Shaybah 31052","","","كتاب الإيمان"
"31053","(۳۱۰۵۳) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عن یزید عَنْ سَعْد بْنِ سِنَانٍ ، عَنْ أَنَسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یَکُونُ بَیْنَ یَدَیَ السَّاعَۃِ فِتَنٌ کَقِطَعِ اللَّیْلِ الْمُظْلِمِ یُصْبِحُ الرَّجُلُ فِیہَا مُؤْمِنًا وَیُمْسِی کَافِرًا وَیُصْبِحُ کَافِرًا وَیُمْسِی مُؤْمِنًا۔ (حاکم ۴۳۸۔ ترمذی ۲۱۹۷)","Da'if","Musannaf Ibn Abi Shaybah 31053","","","كتاب الإيمان"
"31054","(۳۱۰۵۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بْنِ أَبِی عَمْرٍو السَّیْبَانِیِّ ، قَالَ : قَالَ حُذَیْفَۃُ : إنِّی لأَعْلَمُ أَہْلَ دِینَیْنِ ، أَہْلُ ذَیْنِکَ الدِّینَیْنِ فِی النَّارِ : أَہْلُ دِینٍ یَقُولُونَ : الإِیمَانُ کَلامُ ، وَلا عَمَلَ وَإِنْ قَتَلَ وَإِنْ زَنَا ، وَأَہْلُ دِینٍ یَقُولُونَ : کَانَ أَوَّلُونَا أُرَاہُ ذَکَرَ کَلِمَۃً سَقَطَتْ عَنِّی لِیَأْمُرُوننَا بِخَمْسِ صَلَوَاتٍ فی کُلِّ یَوْمٍ ، وَإِنَّمَا ہِیَ صَلاتَانِ : صَلاۃُ الْعِشَائِ وَصَلاۃُ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 31054","","","كتاب الإيمان"
"31055","(۳۱۰۵۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلانَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الإِیمَانُ سِتُّونَ ، أَوْ سَبْعُونَ ، أَوْ بِضْعَۃٌ ، أَوْ أَحَدُ الْعَدَدَیْنِ أَعْلاہَا شَہَادَۃُ أَنْ لاَ إلَہَ إلاَّ اللَّہُ وَأَدْنَاہَا إمَاطَۃُ الأَذَی عَنِ الطَّرِیقِ , وَالْحَیَائُ شُعْبَۃٌ مِنَ الإِیمَانِ۔","Hasan","Musannaf Ibn Abi Shaybah 31055","","","كتاب الإيمان"
"31056","(۳۱۰۵۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَیَائُ مِنَ الإِیمَانِ۔ (مسلم ۶۳۔ ترمذی ۲۶۱۵)","Sahih","Musannaf Ibn Abi Shaybah 31056","","","كتاب الإيمان"
"31057","(۳۱۰۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ حَبَّۃَ بْنِ جُوَیْنٍ الْعُرَنِیِّ ، قَالَ : کُنَّا مَعَ سَلْمَانَ وَقَدْ صَافَنَّا الْعَدُوُّ ، فَقَالَ : ہَؤُلائِ الْمُؤْمِنُونَ وَہَؤُلائِ الْمُنَافِقُونَ وَہَؤُلائِ الْمُشْرِکُونَ ، فَیَنْصُرُ اللَّہُ الْمُنَافِقِینَ بِدَعْوَۃِ الْمُؤْمِنِینَ ، وَیُؤَیِّدُ اللَّہُ الْمُؤْمِنِینَ بِدَعْوَۃِ الْمُنَافِقِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 31057","","","كتاب الإيمان"
"31058","(۳۱۰۵۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی قُرَّۃَ ، قَالَ : قَالَ سَلْمَانُ لِرَجُلٍ : لَوْ قَطَعْت أَعْضَائً مَا بَلَغْت الإِیمَانَ۔","Hasan","Musannaf Ibn Abi Shaybah 31058","","","كتاب الإيمان"
"31059","(۳۱۰۵۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنِ الْبَرَائِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوْثَقُ عُرَی الإسْلامِ الْحُبُّ فِی اللہِ وَالْبُغْضُ فِی اللہِ۔ (احمد ۲۸۶)","Da'if","Musannaf Ibn Abi Shaybah 31059","","","كتاب الإيمان"
"31060","(۳۱۰۶۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ زُبَیْدٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَوْثَقُ عُرَی الإِیمَانِ الْحُبُّ فِی اللہِ وَالْبُغْضُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 31060","","","كتاب الإيمان"
"31061","(۳۱۰۶۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا دَاوُد ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ تَمِیمٍ الدَّارِیِّ ، قَالَ : أَوَّلُ مَا یُحَاسَبُ بِہِ الْعَبْدُ یَوْم الْقِیَامَۃ صَلاۃُ الْمَکْتُوبَۃُ فَإِنْ أَتَمَّہَا وَإِلاَّ قِیلَ : انْظُرُوا ہَلْ لَہُ مِنْ تَطَوُّعٍ ، فَأُکْمِلَت الْفَرِیضَۃُ مِنْ تَطَوُّعِہِ ، فَإِنْ لَمْ تَکْمُلَ الْفَرِیضَۃُ وَلَمْ یَکُنْ لَہُ تَطَوُّعٌ أُخِذَ بِطَرَفَیْہِ فَقُذِفَ بِہِ فِی النَّارِ۔n(ابن ماجہ ۱۴۲۶۔ دارمی ۱۳۵۵)","Sahih","Musannaf Ibn Abi Shaybah 31061","","","كتاب الإيمان"
"31062","(۳۱۰۶۲) حَدَّثَنَا یُونُسَ بْن ہَارُونَ ، قَالَ : أَخْبَرَنَا أَبُو مَعْشَرٍ ، عَنْ مُحَمَّدِ بْنِ صَالِحٍ الأَنْصَارِیِّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَقِیَ عَوْفَ بْنَ مَالِکٍ ، فَقَالَ : کَیْفَ أَصْبَحْت یَا عَوْفَ بْنَ مَالِکٍ ، قَالَ : أَصْبَحْت مُؤْمِنًا حَقًّا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ لِکُلِّ قَوْلٍ حَقِیقَۃً ، فَمَا ذَلِکَ ، فَقَالَ : یَا رَسُولَ اللہِ : أَلَمْ أَظْلف نَفْسِی ، عَنِ الدُّنْیَا ، أسْہَرْت لَیْلِی وَأَظْمَأْت ہَوَاجِرِی , وَکَأَنِّی أَنْظُرُ إِلَی عَرْشِ رَبِّی ، وَکَأَنِّی أَنْظُرُ إِلَی أَہْلِ الْجَنَّۃِ یَتَزَاوَرُونَ فِیہَا ، وَکَأَنِّی أَنْظُرُ إِلَی أَہْلِ النَّارِ یَتَضَاغُونَ فِیہَا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَرَفْت أَوْ آمَنْت فَالْزَمْ۔","Da'if","Musannaf Ibn Abi Shaybah 31062","","","كتاب الإيمان"
