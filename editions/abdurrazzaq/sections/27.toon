hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"15731","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ مُسْلِمٍ , قَالَ : حَدَّثَنِي طَاوُسٌ ، عَنْ عَائِشَةَ , أَنَّهَا قَالَتْ : \"اللَّهُ وَرَسُولُهُ مَوْلَى مَنْ لا مَوْلَى لَهُ ، وَالْخَالُ وَارِثُ مَنْ لا وَارِثَ لَهُ ""","","","","","Book of Wala' (Clientage)"
"15732","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَبْدُ الْكَرِيمِ , عَنْ عُمَرَ ، وَعَلِيٍّ ، وَابْنِ مَسْعُودٍ , ومسروق , والنخعي , والشعبي \" أَنَّالرَّجُلَ إِذَا مَاتَ , وَتَرَكَ مَوَالِيَهُ الَّذِينَ أَعْتَقُوهُ وَلَمْ يَدَعْ ذَا رَحِمٍ إِلا أُمًّا أَوْ خَالَةً , دَفَعُوا مِيرَاثَهُ إِلَيْهَا ، وَلَمْ يُوَرِّثُوا مَوَالِيَهُ مَعَهَا , وَإِنَّهُمْ لا يُوَرِّثُونَ مَوَالِيَهُ مَعَ ذِي رَحِمٍ ""","","","","","Book of Wala' (Clientage)"
"15733","عَنْ هُشَيْمٍ ، عَنْ أَبِي إِسْحَاقَ الشَّيْبَانِيِّ ، عَنِ الشَّعْبِيِّ , قَالَ : قِيلَ لَهُ : إِنَّ أَبَا عُبَيْدَةَ بْنَ عَبْدِ اللَّهِ \"وَرَّثَ أُخْتًا الْمَالَ كُلَّهُ \". فَقَالَ الشَّعْبِيُّ : \" مَنْ هُوَ خَيْرٌ مِنْ أَبِي عُبَيْدَةَ قَدْ فَعَلَ ذَلِكَ ، كَانَ عَبْدُ اللَّهِ ابْنُ مَسْعُودٍ يَفْعَلُ ذَلِكَ ""","","","","","Book of Wala' (Clientage)"
"15734","عَنْ هُشَيْمٍ ، عَنْ إِسْمَاعِيلَ بْنِ سَالِمٍ ، قَالَ : شَهِدْتُ الْقَاسِمَ بْنَ عَبْدِ الرَّحْمَنِ , اخْتُصِمَ إِلَيْهِ فِيغُلامٍ مَاتَ وَتَرَكَ أُمَّهُ , وَمَوَالِيَهُ الَّذِينَ أَعْتَقُوهُ , فَاخْتُصِمَ فِي مِيرَاثِهِ إِلَى الْقَاسِمِ فَقَالَ : \" حَمَلْتِهِ فِي بَطْنِكِ , وَأَرَضَعْتِهِ بِثَدْيِكِ , لَكِ الْمَالُ كُلُّهُ ""","","","","","Book of Wala' (Clientage)"
"15735","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي سُلَيْمَانُ الأَحْوَلُ ، عَنْ أَبِي حَبِيبٍ الْعِرَاقِيِّ : أَنَّامْرَأَةً كَانَ لَهَا ابْنٌ فَتُوُفِّيَ وَلَهُ خَمْسُونَ دِينَارًا لَيْسَ لَهُ وَارِثٌ إِلا أُمَّهُ , وَمَوَالِيهِ بَعِيدٌ مِنْهُ , فَقَالَ لَهَا أَبُو الشَّعْثَاءِ : \" وَيْحَكِ خُذِيهَا وَلا تُعْطِهِمْ شَيْئًا ""","","","","","Book of Wala' (Clientage)"
"15736","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، أَنَّ زَيْدَ بْنَ ثَابِتٍ \" كَانَيُوَرِّثُ الْمَالَ دُونَ ذَوِي الأَرْحَامِ ""","","","","","Book of Wala' (Clientage)"
"15737","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ \" أَنَّهُ كَانَيُوَرِّثُ الْمَالَ دُونَ ذَوِي الأَرْحَامِ ""","","","","","Book of Wala' (Clientage)"
"15738","عَنْ هُشَيْمِ بْنِ بَشِيرٍ ، عَنْ مُغِيرَةَ ، عَنِ الشَّعْبِيِّ , قَالَ : \"مَا رَدَّ زَيْدُ بْنُ ثَابِتٍ عَلَى ذَوِي الأَرْحَامِ شَيْئًا قَطُّ ""","","","","","Book of Wala' (Clientage)"
"15739","عَنِ الثَّوْرِيِّ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ , قَالَ : انْتَهَيْتُ إِلَى عَبْدِ اللَّهِ بْنِ شَدَّادٍ , وَهُوَ يُحَدِّثُ الْقَوْمَ فَسَمِعْتُهُ يَقُولُ فِي آخِرِ الحديثْ : أُخْتِي , قَالَ : فَسَأَلْتُ الْقَوْمَ , فَحَدَّثَنِي أَصْحَابُهُ أَنَّهُ حَدَّثَهُمْ أَنَّابْنَةً لِحَمْزَةَ وَهِيَ أُخْتٌ لِعَبْدِ اللَّهِ لأُمِّهِ مَاتَ مَوْلًى لَهَا , وَتَرَكَ ابْنَتَهُ , وَتَرَكَ ابْنَةَ حَمْزَةَ , فَقَسَمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَ ذَلِكَ، عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ مِثْلَهُ","","","","","Book of Wala' (Clientage)"
"15740","قَالَ الثَّوْرِيُّ : وَأَخْبَرَنِي مَنْصُورٌ ، وَالأَعْمَشُ ، أَنَّ إِبْرَاهِيمَ ، كَانَإِذَا ذُكِرَ لَهُ ابْنَةُ حَمْزَةَ , قَالَ : \" إِنَّمَا أَطْعَمَهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ طُعْمَةً \", فَقَالَ لَهُ بَعْضُ الْفُقَهَاءِ : فَإِنْ كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَطَعَمَهَا فَنَحْنُ نُطْعِمُ كَمَا أَطْعَمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","","","","","Book of Wala' (Clientage)"
"15741","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ أَبِي حُصَيْنٍ , قَالَ : \"خَاصَمْتُ إِلَى شُرَيْحٍ فِي مُكَاتِبٍ لِي تَرَكَ وَلَدًا , وَعَلَيْهِ بَقِيَّةٌ مِنْ كِتَابَتِهِ , فَأَعْطَانِي شُرَيْحٌ مَا بَقِيَ عَلَيْهِ مِنْ كِتَابَتِهِ ، وَجَعَلَ لابْنَتَيْهِ الثُّلُثَيْنِ ، وَجَعَلَ أَبَا حُصَيْنٍ عُصْبَةً فَوَرَّثَهُ مَا بَقِيَ ""","","","","","Book of Wala' (Clientage)"
"15742","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ عُبَيْدٍ ، عَنِ الْحَسَنِ ، قَالَ :أَرَادَ رَجُلٌ أَنْ يَشْتَرِيَ عَبْدًا فَلَمْ يُقْضَ بَيْنَهُ وَبَيْنَ صَاحِبِهِ بَيْعٌ , فَحَلِفَ رَجُلٌ مِنَ الْمُسْلِمِينَ بِعِتْقِهِ , فَاشْتَرَاهُ فَأَعْتَقَهُ , فَذَكَرَهُ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : فَكَيْفَ بِصُحْبَتِهِ ؟ فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : هُوَ لَكَ إِلا أَنْ يَكُونَ لَهُ عُصْبَةٌ فَإِنْ لَمْ يَكُنْ لَهُ عُصْبَةٌ فَهُوَ لَكَ","","","","","Book of Wala' (Clientage)"
"15743","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، فِيامْرَأَةٍ اشْتَرَتْ أَبَاهَا فَأَعْتَقَتْهُ ، ثُمَّ تُوُفِّيَ أَبُوهَا ، وَتَرَكَ ابْنَتَيْهِ , إِحْدَاهُمَا الَّتِي أَعْتَقَتْهُ , قَالَ : \" تَرِثَانِهِ بِكِتَابِ اللَّهِ عَزَّ وَجَلَّ الثُّلُثَيْنِ ، وَمَا بَقِيَ فَهُوَ لِلَّتِي أَعْتَقَتْهُ ""","","","","","Book of Wala' (Clientage)"
"15744","عَنِ ابْنِ طَاوُسٍ ، قَالَ : سُئِلَ عَنْرَجُلٍ مَاتَ وَتَرَكَ أُمَّهُ أَمَةً , وَلَمْ يَتْرُكْ وَارِثًا , قَالَ : \" تُشْتَرَى مِنْ مَالِهِ ثُمَّ تُعْتَقُ , وَتَرِثُهُ \", قَالَ مَعْمَرٌ : وَبَلَغَنِي عَنِ ابْنِ مَسْعُودٍ مِثْلَهُ","","","","","Book of Wala' (Clientage)"
"15745","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :رَجُلٌ كَاتَبَ رَجُلا وَقَاطَعَهُ ، وَلَمْ يَشْتَرِطْ سَيِّدُهُ أَنَّ وَلاءَكَ لِي لِمَنْ وَلاؤُهُ ؟ قَالَ لِسَيِّدِهِ: قَالَهَا : عَمْرُو بْنُ دِينَارٍ , قُلْتُ لِعَطَاءٍ : \" فَمُكَاتِبٌ كَاتَبَ وَاشْتَرَطَ أَنَّ وَلائِي إِلَى مَنْ شِئْتُ ، أَيَجُوزُ ؟ قَالَ \" نَعَمْ \" , قَالَ عَطَاءٌ , وَعَمْرُو بْنُ دِينَارٍ : \" الْمُسْلِمُونَ عَلَى شُرُوطِهِمْ \" ، قِيلَ لَهُ : فَمَاتَ الْمُكَاتِبُ بَعْدَمَا قَضَى كِتَابَتَهُ ، وَلَمْ يَجْعَلْ وَلاءَهُ إِلَى أَحَدٍ وَتَرَكَ مَالا ؟ قَالَ : \" هُوَ لِلَّذِي كَاتَبَهُ \" , وَقَالَهَا : عَمْرُو بْنُ دِينَارٍ","","","","","Book of Wala' (Clientage)"
"15746","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : \"إِنِ اشْتَرَطَ فِي كِتَابَتِهِ أَنِّي أُوَالِي مَنْ شِئْتُ , فَهُوَ جَائِزٌ ""","","","","","Book of Wala' (Clientage)"
"15747","وَلا أَعْلَمُ مَعْمَرًا إِلا أَخْبَرَنَا , عَنْ قَتَادَةَ , أَنَّهُ قَالَ : \"إِذَا أَدَّى الْمُكَاتِبُ فَأَدَّى جَمِيعَ كِتَابَتِهِ , فَيُوَالِي مَنْ شَاءَ \". قَالَ مَعْمَرٌ : وَمَا رَأَيْتُ النَّاسَ تَابَعُوهُ عَلَى ذَلِكَ","","","","","Book of Wala' (Clientage)"
"15748","عَنِ ابْنِ جُرَيْجٍ , قَالَ : ، قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْ كَانَ يَعْقِلُ عَنْهُ قَوْمٌ ، وَلَمْ يُوَالِهِمْ ؟ قَالَ : \" قَدْوَالاهُمْ إِذَا عَقَلُوا عَنْهُ , وَهَلْ يَكُونُ ذَلِكَ إِلا بِالْمُوَالاةِ ؟ \" , قُلْتُ : أَرَأَيْتَ إِنْ غَضِبَ لَهُ قَوْمٌ وَحَاطُوهُ وَلَمْ يَعْقِلُوا عَنْهُ ، وَلَمْ يُوَالِهِمْ ؟ قَالَ : \" فَوَلاؤُهُ لِلَّذِي كَاتَبَهُ هُوَ أَحَقُّ بِمِيرَاثِهِ \". وَقَالَهَا لِي عَمْرُو بْنُ دِينَارٍ , قُلْتُ لِعَطَاءٍ : أَيْنَ قَوْلُ عُمَرَ : مِيرَاثُهُ لِمَنْ غَضِبَ لَهُ أَوْ حَاطَهُ أَوْ نَصَرَهُ ؟ قَالَ : \" لَيْسَ هَذَا كَهَيْئَةِ الَّذِي لا مَوْلَى لَهُ ، هَذَا يَعْلَمُ مَوْلاهُ ""","","","","","Book of Wala' (Clientage)"
"15749","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَمَرَّ بِرَجُلٍ يُكَاتِبُ عَبْدًا لَهُ , فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" اشْتَرِطْ وَلاءَهُ \". قَالَ : وَكَانَ قَتَادَةُ يَقُولُ : \" إِنْ لَمْ يَشْتَرِطْ وَلاءَهُ وَالَى مَنْ شَاءَ حِينَ يَعْتِقُ \" , قَالَ مَعْمَرٌ : وَيَأَبَى النَّاسُ ذَلِكَ عَلَيْهِ","","","","","Book of Wala' (Clientage)"
"15750","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّ ابْنَ مَسْعُودٍ أَتَاهُ رَجُلٌ , فَقَالَ :مَوْلًى لِي تُوُفِّيَ أَعْتَقْتُهُ سَائِبَةً , وَتَرَكَ مَالا , قَالَ : \" أَنْتَ أَحَقُّ بِمَالِهِ \" , قَالَ : إِنَّمَا أَعْتَقْتُهُ لِلَّهِ , قَالَ : \" أَنْتَ أَحَقُّ بِمَالِهِ , فَإِنْ تَدَعْهُ فَأَرِنِهِ , هَاهُنَا وَرَثَةٌ كَثِيرٌ \" . يَعْنِي : بَيْتَ الْمَالِ","","","","","Book of Wala' (Clientage)"
"15751","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ أَبِي قَيْسٍ الأَوْدِيِّ ، عَنْ هُزَيْلِ بْنِ شُرَحْبِيلَ , قَالَ : جَاءَ رَجُلٌ إِلَى عَبْدِ اللَّهِ بْنِ مَسْعُودٍ , فَقَالَ لَهُ : كَانَ لِي عَبْدٌ فَأَعْتَقْتُهُ , وَجَعَلْتُهُ سَائِبَةً فِي سَبِيلِ اللَّهِ , فَقَالَ لَهُ عَبْدُ اللَّهِ : \" إِنَّأَهْلَ الإِسْلامِ لا يُسَيِّبُونَ , إِنَّمَا كَانَ يُسَيِّبُ أَهْلُ الْجَاهِلِيَّةِ ، وَأَنْتَ أَوْلَى النَّاسِ بِنِعْمَتِهِ ، وَأَحَقُّ النَّاسِ بِمِيرَاثِهِ , فَإِنْ تَحَرَّجْتَ مِنْ شَيْءٍ ، فَأَرِنَاهُ فَجَعَلَهُ فِي بَيْتِ الْمَالِ \". عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ مَسْعُودٍ مِثْلَهُ","","","","","Book of Wala' (Clientage)"
"15752","أَخْبَرَنَا مَعْمَرٌ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ : \"السَّائِبَةُ يَرِثُهُ مَوْلاهُ الَّذِي أَعْتَقَهُ ، وَيَرِثُهُ عَنْهُ ""","","","","","Book of Wala' (Clientage)"
"15753","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ ، أَنَّ طَارِقًا مَوْلَى ابْنِ أَبِي عَلْقَمَةَ ,ابْتَاعَ أَهْلَ بَيْتٍ مُتَحَمِّلِينَ إِلَى الشَّامَ فَأَعْتَقَهُمْ , فَرَجَعُوا إِلَى الْيَمَنِ , قُلْتُ : سَيَّبَهُمْ , أَوْ أَعْتَقَهُمْ إِعْتَاقًا , قَالَ : \" سَيَّبَهُمْ \" , قَالَ : فَمَاتُوا , وَتَرَكُوا سِتَّةَ عَشَرَ أَلْفَ دِرْهَمٍ أَوْ سَبْعَةَ عَشَرَ أَلْفًا , فَكَتَبَ إِلَى طَارِقٍ , فَأَبَى أَنْ يَأْخُذَ مِيرَاثَهُمْ ، فَكَتَبَ فِي ذَلِكَ يَعْلَى إِلَى عُمَرَ بْنِ الْخَطَّابِ , فَكَتَبَ عُمَرُ , إِلَى يَعْلَى : \" أَنْ يَعْرِضَهَا عَلَى طَارِقٍ ، فَإِنْ أَبَى فَابْتَغِ بِهَا رِقَابًا , فَأَعْتِقْهُمْ ""","","","","","Book of Wala' (Clientage)"
"15754","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : سَمِعْتُ سُلَيْمَانَ بْنَ مُوسَى , يَقُولُ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ \" فِيسَائِبَةٍ مَاتَ , وَلَمْ يُوَالِ أَحَدًا , أَنَّ مِيرَاثَهُ لِلْمُؤْمِنِينَ ، وَأَنَّهُمْ يَعْقِلُونَ عَنْهُ جَمِيعَا \". وَقَالَ سُلَيْمَانُ بْنُ مُوسَى \" إِنَّ السَّائِبَةَ يَهَبُ وَلاءَهُ لِمَنْ شَاءَ ، فَإنْ لَمْ يَفْعَلْ , فَإِنَّ وَلاءَهُ لِلْمُؤْمِنِينَ جَمِيعًا ، يَعْقِلُ عَنْهُ الإِمَامُ وَيَرِثُهُ ""","","","","","Book of Wala' (Clientage)"
"15755","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي ابْنُ شِهَابٍ , عَنْرَجُلٍ أَعْتَقَ سَائِبَةً ، وَكَيْفَ السُّنَّةُ فِيهَا ؟ قَالَ : \" لَيْسَ مَوْلاهُ مِنْهُ فِي شَيْءٍ ، يَرِثُهُ الْمُسْلِمُونَ عَنْهُ ويعقلون عنه ""","","","","","Book of Wala' (Clientage)"
"15756","عَنْ مَعْمَرٍ ، عَنِ الثَّوْرِيِّ ، عَنْ سُلَيْمَانَ التَّيْمِيِّ ، عَنْ أَبِي عُثْمَانَ النَّهْدِيِّ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ , قَالَ : \"السَّائِبَةُ , وَالصَّدَقَةُ , لِيَوْمِهِمَا \" ، يَعْنِي : يَوْمَ الْقِيَامَةِ","","","","","Book of Wala' (Clientage)"
"15757","عَنِ الثَّوْرِيِّ ، عَنْ عَلِيِّ بْنِ زَيْدِ بْنِ جُدْعَانَ ، عَنْ عَمَّارٍ ، أَنَّ ابْنَ عُمَرَ :\" أَعْتَقَ سَائِبَةً فَوَرِثَ مِنْهُمْ دَنَانِيرَ فَجَعَلَهَا فِي الرِّقَابِ \". عَنْ مَعْمَرٍ ، عَنِ الثَّوْرِيِّ ، عَنْ سُلَيْمَانَ التَّيْمِيِّ ، عَنْ بَكْرِ بْنِ عَبْدِ اللَّهِ الْمُزَنِيِّ ، عَنِ ابْنِ عُمَرَ مِثْلَ ذَلِكَ , قَالَ الثَّوْرِيُّ : أَخْبَرَنِيهِ سُلَيْمَانُ التَّيْمِيُّ","","","","","Book of Wala' (Clientage)"
"15758","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، أَنَّ سَالِمًا مَوْلَى أَبِي حُذَيْفَةَ , أَعْتَقَتْهُ امْرَأَةٌ مِنَ الأَنْصَارِ , فَلَمَّا قُتِلَ يَوْمَ الْيَمَامَةِ \"دَفَعَ مِيرَاثَهُ إِلَى الأَنْصَارِيَّةِ الَّتِي أَعْتَقَتْهُ , أَوْ إِلَى ابْنِهَا ""","","","","","Book of Wala' (Clientage)"
"15759","عَنْ إِسْمَاعِيلَ بْنِ عَبْدِ اللَّهِ , قَالَ : حَدَّثَنَا دَاوُدُ بْنُ أَبِي هِنْدَ ، عَنْ عَامِرٍ الشَّعْبِيِّ ، أَنَّ سَالِمًا مَوْلَى أَبِي حُذَيْفَةَ \"أَعْتَقَتْهُ امْرَأَةٌ مِنَ الأَنْصَارِ , فَلَمَّا قُتِلَ دَعَاهَا عُمَرُ إِلَى مِيرَاثِهِ , فَأَبَتْ أَنْ تَقْبَلَهُ , وَقَالَتْ : إِنَّمَا أَعْتَقْتُهُ سَائِبَةً لِلَّهِ عَزَّ وَجَلَّ ""","","","","","Book of Wala' (Clientage)"
"15760","عَنْ إِسْمَاعِيلَ , قَالَ : حَدَّثَنِي عَبْدُ اللَّهِ بْنُ عَوْنٍ , قَالَ : قُلْتُ لِلشَّعْبِيِّ : إِنَّ أَبَا الْعَالِيَةَ \"أَوْصَى بِمَالِهِ كُلِّهُ , وَكَانَ أَعْتَقَ سَائِبَةً \" , فَقَالَ الشَّعْبِيُّ : لَيْسَ ذَلِكَ لَهُ","","","","","Book of Wala' (Clientage)"
"15761","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، قَالَ : سَأَلْتُهُ عَنِالرَّجُلِ يُعْتِقُ عَبْدَهُ سَائِبَةً , أَيَجْعَلُ وَلاءَهُ لِمَنْ شَاءَ ؟ قَالَ : \" لَيْسَ سَيِّدُهُ مِنْهُ فِي شَيْءٍ يَرِثُهُ السُّلْطَانُ وَيَعْقِلُ عَنْهُ ""","","","","","Book of Wala' (Clientage)"
"15762","عَنِ ابْنِ جُرَيْجٍ , قَالَ : ، قُلْتُ لِعَطَاءٍ :نُسَيِّبُ الرَّقَبَةَ تَسْيِيبًا أَيُوَالِي مَنْ شَاءَ ؟ قَالَ : \" نَعَمْ ، قَدْ كَانَ ذَلِكَ يُقَالُ يُوَالِي مَنْ شَاءَ , إِلا أَنْ يَقُولَ مَعَ ذَلِكَ : بَرِئْتُ مِنْ وَلائِكَ , وَجَرِيرَتِكَ , فَيُوَالِي مَنْ شَاءَ \" , رَاجَعْتُ عَطَاءً فِيهَا , فَقَالَ : \" كُنَّا نَعْلَمُ أَنَّهُ إِذَا قَالَ : أَنْتَ حُرٌّ سَائِبَةٌ , فَهُوَ يُوَالِي مَنْ شَاءَ , وَهُوَ مُسَيَّبٌ ، وَإِنْ لَمْ يَقُلْ , وَالِ مَنْ شِئْتَ , إِذَا قَالَ : أَنْتَ سَائِبَةٌ \" , قُلْتُ لِعَطَاءٍ : فَمَا الَّذِي يُخَالِفُ قَوْلُهُ أَنْتَ حُرٌّ , قَوْلَهُ : أَنْتَ سَائِبَةٌ , قَالَ : \" إِنَّهُ سَيَّبَهُ , فَخَلاهُ أَرْسَلَهُ \" , قُلْتُ لِعَطَاءٍ : فَلَمْ يُوَالِ السَّائِبَةُ أَحَدًا حَتَّى مَاتَ ؟ قَالَ : \" يُدْعَى الَّذِي أَعْتَقَهُ إِلَى مِيرَاثِهِ فَإِنْ قَبِلَهُ , فَهُوَ أَحَقُّ بِهِ , وَإِلا ابْتِيعَ بِهِ رِقَابٌ فَأُعْتِقَتْ \". وَقَالَ لِي عَمْرُو بْنُ دِينَارٍ : مَا أَرَى إِلا ذَلِكَ , قُلْتُ لِعَطَاءٍ : فَالَّذِي أَعْتَقَهُ إِذًا يُؤْخَذُ بِنَذْرٍ بِمَاجِرٍ ؟ قَالَ : \" نَعَمْ \" ، قُلْتُ لَهُ : فَأَيْنَ كِتَابُ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ فِي ذَلِكَ : إِنَّ مِيرَاثَهُ لِلْمُؤْمِنِينَ ؟ فَأَبَى إِلا أَنْ يُدْعَى الَّذِي أَعْتَقَهُ إِلَى مِيرَاثِهِ , قُلْتُ لَهُ : إِنَّهُ قَدِ احْتَسَبَهُ فَكَيْفَ يَعُودُ فِي شَيْءٍ لِلَّهِ ؟ قَالَ : \" أَفَرَأَيْتَ الَّذِي يُعْتِقُ لِلَّهِ ثُمَّ يَأْخُذُ مِيرَاثَهُ ""","","","","","Book of Wala' (Clientage)"
"15763","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ عُيَيْنَةَ ، عَنْ أَبِي إِسْحَاقَ الشَّيْبَانِيِّ ، عَنْ عُبَيْدِ بْنِ أَبِي الْجَعْدِ ، عَنْ عَبْدِ اللَّهِ بْنِ شَدَّادِ بْنِ الْهَادِي , قَالَ : قُتِلَ سَالِمٌ مَوْلَى أَبِي حُذَيْفَةَ , يَوْمَ الْيَمَامَةِ , وَتَرَكَ مِيرَاثًا ,فَذَهَبَ بِمِيرَاثِهِ إِلَى عُصْبَةِ امْرَأَةٍ مِنَ الأَنْصَارِ , يُقَالُ لَهَا : عَمْرَةُ , كَانَتْ قَدْ أَعْتَقَتْهُ , فَقَالُوا : إِنَّهُ كَانَ سَائِبَةً , وَأَبَوْا أَنْ يَأْخُذُوهُ , فَقَالَ عُمَرُ : \" احْبِسُوهُ عَلَى أُمِّهِ حَتَّى تَسْتَكْمِلَهُ , أَوْ تَمُوتَ ""","","","","","Book of Wala' (Clientage)"
"15764","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ : أَنَّ عَلِيًّا ، وَعُمَرَ ، وَزَيْدَ بْنَ ثَابِتٍ ، كَانُوا يَجْعَلُونَالْوَلاءَ لِلْكِبَرِ, قَالَ سُفْيَانُ : وَتَفْسِيرُهُ \" رَجُلٌ مَاتَ وَتَرَكَ ابْنَيْهِ , وَتَرَكَ مَوَالِيَ , ثُمَّ مَاتَ أَحَدُ الابْنَيْنِ , وَتَرَكَ وَلَدًا ذُكُورًا , فَصَارَ الْوَلاءُ لِعَمِّهِمْ ، ثُمَّ مَاتَ الْعَمُّ بَعَدُ , وَلَهُ خَمْسَةٌ مِنَ الْوَلَدِ , وَلِلأَوَّلِ سَبْعَةٌ , قَالُوا : الْوَلاءُ عَلَى اثْنَيْ عَشَرَ سَهْمًا , كَأَنَّ الْجَدَّ هُوَ الَّذِي مَاتَ , فَوَرَّثُوهُ ""","","","","","Book of Wala' (Clientage)"
"15765","عَنْ مَعْمَرٍ ، عَنْ أَبِي هَاشِمٍ الْوَاسِطِيِّ ، عَنْ إِبْرَاهِيمَ النَّخَعِيِّ ، أَنَّ عَلِيًّا ، وَزَيْدَ بْنَ ثَابِتٍ ،\" قَضَيَا فِي رَجُلٍ تَرَكَ أَخَاهُ لأَبِيهِ , وَأُمِّهِ , وَأَخَاهُ لأَبِيهِ , وَتَرَكَ مَوْلًى , فَجَعَلا الْوَلاءَ لأَخِيهِ لأَبِيهِ وَأُمِّهِ , دُونَ أَخِيهِ لأَبِيهِ , قَالا : \" فَإِنْ مَاتَ الأَخُ لِلأَبِ وَالأُمِّ , رَجَعَ الْوَلاءُ لِلأَخِ لِلأَبِ \" , قَالا : \" فَإِنْ مَاتَ الأَخُ لِلأَبِ , وَتَرَكَ بَنِينَ , رَجَعَ الْوَلاءُ إِلَى بَنِي الأَخِ لِلأَبِ وَالأُمِّ , إِنْ كَانَ لَهُ بَنُونَ \", عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ ، قَالا مِثْلَ ذَلِكَ , عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , مِثْلَ ذَلِكَ","","","","","Book of Wala' (Clientage)"
"15766","قَالَ مَعْمَرٌ : فَقُلْتُ لابْنِ طَاوُسٍ : أَرَأَيْتَإِنْ كَانَ لِوَاحِدٍ عَشَرَةٌ , وَلِوَاحِدٍ وَاحِدٌ , أَيَكُونُ نِصْفَيْنِ ؟ قَالَ : كَانَ أَبِي يَقُولُ : \" هُوَ بَيْنَهُمْ عَلَى أَحَدَ عَشَرَ سَهْمًا فِي الْوَلاءِ \". عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ طَاوُسٍ مِثْلَهُ","","","","","Book of Wala' (Clientage)"
"15767","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ :رَجُلٌ مَاتَ , وَتَرَكَ ابْنَيْنِ لَهُ , وَتَرَكَ مَوَالِيَ , ثُمَّ مَاتَ أَحَدُ ابْنَيْهِ , وَتَرَكَ رِجَالا , وَمَاتَ بَعْضُ مَوَالِي أَبِيهِمْ , قَالَ : \" يَرِثُهُ أَحَقُّ النَّاسِ يَوْمَئِذٍ بِالْمُعْتِقِ \"قُلْتُ : عَمَّنْ هَذَا ؟ قَالَ : \" أَدْرَكْنَا النَّاسَ عَلَيْهِ ""","","","","","Book of Wala' (Clientage)"
"15768","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ ، أَنَّهُ كَانَ يَقُولُ : \"إِنْ مَاتَ رَجُلٌ وَلَهُ مَوْلًى , وَلِلْمَيِّتِ بَنُونَ , فَمَاتَ أَحَدُ أَعْيَانِ بَنِيهِ , وَلَهُ وَلَدٌ ذَكَرٌ , ثُمَّ مَاتَ الْمَوْلَى , كَانَ مِيرَاثُهُ لأَعْيَانِ بَنِيهِ , وَلَمْ يَكُنْ لِبَنِي الابْنِ شَيْءٌ ""","","","","","Book of Wala' (Clientage)"
"15769","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ ، \" أَنَّ عَبْدَ اللَّهِ بْنَ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ ،وَرِثَ عَائِشَةَ أُمَّ الْمُؤْمِنِينَ , وَمَاتَ عَبْدُ الرَّحْمَنِ قَبْلَهَا , وَوَرِثَ عَبْدُ اللَّهِ بْنُ عَبْدِ الرَّحْمَنِ عَائِشَةَ ، ثُمَّ مَاتَ عَبْدُ اللَّهِ , وَتَرَكَ ابْنَيْهِ , وَمَاتَ ذَكْوَانُ مَوْلَى عَائِشَةَ , وَالْقَاسِمُ بْنُ مُحَمَّدِ بْنِ أَبِي بَكْرٍ حَيٌّ , فَوَرَّثَ ابْنُ الزُّبَيْرِ ابْنَيْ عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ ذَكْوَانًا , وَتَرَكَ الْقَاسِمَ ، وَالْقَاسِمُ أَحَقُّ مِنْهُمَا , قَالَ عَطَاءٌ : فَعِيبَ ذَلِكَ عَلَى ابْنِ الزُّبَيْرِ , وَجَعَلَ الْقَاسِمُ يُكَلِّمُ فِي ذَلِكَ , فَقَالَ : مَاذَا اتَّبَعَ مِنْ ذَلِكَ ؟ ""","","","","","Book of Wala' (Clientage)"
"15770","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي مُلَيْكَةَ , قَالَ : خَاصَمَ الْقَاسِمُ بْنُ مُحَمَّدٍ إِلَى ابْنِ الزُّبَيْرِ فِي مَوْلًى لِعَائِشَةَ رَضِي اللَّهُ عَنْهَا , فَخَاصَمَهُ بَنُو بَنِي عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ , وَكَانَ الْقَاسِمُ بْنُ مُحَمَّدٍ أَقْرَبَ إِلَى عَائِشَةَ , وَكَانَ عَبْدُ الرَّحْمَنِ أَخَا عَائِشَةَ لأَبِيهَا وَأُمِّهَا , فَقَضَى بِهِ ابْنُ الزُّبَيْرِ لِبَنِي عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ ، وَكَانُوا أَبْعَدَ بِأَبٍ , قَالَ ابْنُ أَبِي مُلَيْكَةَ : فَخَافَ عَلَيْهَا ابْنُ الزُّبَيْرِ عنِين , قَالَ ابْنُ أَبِي مُلَيْكَةَ : فَلَمَّا كَانَ عَبْدُ الْمَلِكِ قِيلَ لِلْقَاسِمِ : خَاصِمْ فَإِنَّكَ تُدْرِكُ , فَقَالَ الْقَاسِمُ : \"قَدْ خَاصَمْتُ يَوْمَئِذٍ , فَلَوْ أُعْطِيتُ شَيْئًا أَخَذْتُ , فَأَمَّا الْيَوْمَ فَلا أُخَاصِمُ ""","","","","","Book of Wala' (Clientage)"
"15771","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبِي , أَنَّ عَبْدَ الْمَلِكِ بْنَ مَرْوَانَ \" كَانَيَنْقِلُ الْوَلاءَ ""","","","","","Book of Wala' (Clientage)"
"15772","عَنِ ابْنِ جُرَيْجٍ ، أَنَّ عَمْرَو بْنَ شُعَيْبٍ , ذَكَرَ أَنَّ عِنْدَهُمْ كِتَابًا مِنْ عُمَرَ بْنِ الْخَطَّابِ , إِلَى عَمْرِو بْنِ الْعَاصِ , إِنْ كَانَلِرَجُلٍ مَوَالٍ , وَلَهُ ابْنَانِ , فَمَاتَ الأَبُ , كَانَ الْوَلاءُ لابْنَيْهِ , ثُمَّ مَاتَ أَحَدُ ابْنَيْهِ , وَلَهُ وَلَدٌ ذُكُورٌ ، ثُمَّ مَاتَ بَعْضُ الْمَوَالِي , كَانَ ابْنُ الابْنِ عَلَى حِصَّةِ أَبِيهِ مِنَ الْوَلاءِ ، وَلَمْ يَكُنِ الْوَلاءُ لِعَمِّهِ","","","","","Book of Wala' (Clientage)"
"15773","قَالَ : وَذَكَرَ عَمْرُو بْنُ شُعَيْبٍ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ :\" أَنْزَلَ الْوَلاءَ بِمَنْزِلَةِ الْمَالِ لا يَنْقُلُهُ ""","","","","","Book of Wala' (Clientage)"
"15774","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ شُبْرُمَةَ يَذْكُرُ ، أَنَّ عَلِيًّا ، وَعَبْدَ اللَّهِ بْنَ مَسْعُودٍ ، وَزَيْدَ بْنَ ثَابِتٍ ، قَضَوْا \"الْوَلاءَ يُنْقَلُ كَمَا يُنْقَلُ النَّسَبَ , لا يَحْرِزُهُ الَّذِي وَرِثَ وَلِيَّ النِّعْمَةِ , وَلَكِنَّهُ يُنْقَلُ إِلَى أَوْلَى النَّاسِ بِوَلِيِّ النِّعْمَةِ ""","","","","","Book of Wala' (Clientage)"
"15775","عَنِ الثَّوْرِيِّ , قَالَ : \"إِذَا مَاتَ وَلَدُ الْمَرْأَةِ , وَوَلَدُ وَلَدِهَا الذُّكُورُ , رَجَعَ الْوَلاءُ إِلَى الْعَصَبَةِ عَصَبَةِ الْمَرْأَةِ ""","","","","","Book of Wala' (Clientage)"
"15776","وَأَخْبَرَنِي مُغِيرَةُ ، عَنْ إِبْرَاهِيمَ ، عَنْ شُرَيْحٍ , أَنَّهُ كَانَ يَقُولُ : \"يَجْرِي مَجْرَى الْمَالِ لا يَرْجِعُ \", وَالْقَوْلُ الأَوَّلُ أَحَبُّ إِلَى سُفْيَانَ","","","","","Book of Wala' (Clientage)"
"15777","عَنِ الثَّوْرِيِّ , فِيرَجُلَيْنِ أَعْتَقَا عَبْدًا , فَمَاتَ أَحَدُهُمَا , وَتَرَكَ وَلَدًا ذُكُورًا , قَالَ : \" الْوَلاءُ لِوَلَدِهِ مَعَ عَمِّهِمْ , بَيْنَهُمْ نِصْفَانِ ""","","","","","Book of Wala' (Clientage)"
"15778","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الزُّهْرِيِّ \" فِيالرَّجُلِ تُعْتِقُهُ الْمَرْأَةُ وَلاؤُهُ لِوَلَدِهَا , مَا بَقِيَ مِنْهُمْ ذَكَرٌ , فَإِذَا انْقَرَضُوا كَانَ الْوَلاءُ لِعَصَبَةِ أُمِّهِمْ \". وَبَلَغَنِي إِيَّايَ أَنَّ قَتَادَةَ ذَكَرَ عَنْ خِلاسِ بْنِ عُمَرَ بْنِ عَلِيٍّ , قَالَ مَعْمَرٌ : قَالَ قَتَادَةُ : قَالَ الْحَسَنُ , وَابْنُ الْمُسَيِّبِ : \" الْوَلاءُ لأَبْنَائِهِمْ \" ، وَقَالَهُ ابْنُ جُرَيْجٍ","","","","","Book of Wala' (Clientage)"
"15779","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، أَنَّ عَلِيًّا ، وَالزُّبَيْرَ ،اخْتَصَمَا فِي مَوْلًى لِصَفِيَّةَ ، فَقَضَى عُمَرُ \" بِالْعَقْلِ عَلَى عَلِيٍّ , وَبِالْمِيرَاثِ لِلزُّبَيْرِ ""","","","","","Book of Wala' (Clientage)"
"15780","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، وَمُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِيِّ , قَالَ : \"إِذَا مَاتَتِ الْمَرْأَةُ , وَتَرَكَتْ مَوَالِيَ , فَالْمِيرَاثُ لِوَلَدِهَا , وَالْعَقْلُ عَلَيْهِمْ \", قَالَ : وَكَانَ ابْنُ أَبِي لَيْلَى يَقْضِي بِهِ","","","","","Book of Wala' (Clientage)"
"15781","عَنِ الثَّوْرِيِّ ، قَالَ : فِي امْرَأَةٍ مَاتَتْ , وَتَرَكَتْ أَبَاهَا , وَابْنَهَا , وَتَرَكَتْ مَوَالِيَ , قَالَ : أَخْبَرَنِي مُغِيرَةُ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"لِلأَبِ سُدْسُ الْوَلاءِ , وَسَائِرُهُ لِلابْنِ \". وَقَالَ الْحَكَمُ وَحَمَّادٌ : \" الْوَلاءُ لِلابْنِ \" , قَالَ : وَبَلَغَنِي عَنْ زَيْدِ بْنِ ثَابِتٍ , أَنَّهُ قَالَ : \" الْوَلاءُ لِلابْنِ ""","","","","","Book of Wala' (Clientage)"
"15782","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : \"الْمَرْأَةُ ذَاتُ الْوَلَدِ الذُّكُورِ مَنْ يَعْقِلُ عَنْهَا ؟ قَالَ : \" عَصَبَتُهَا \" , قُلْتُ : وَيَرِثُهَا وَلَدُهَا الذُّكُورُ ؟ قَالَ : \" نَعَمْ ""","","","","","Book of Wala' (Clientage)"
"15783","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :الْعَبْدُ يُبْتَاعُ نَفْسَهُ مِنْ سَيِّدِهِ أَيُوَالِي مَنْ شَاءَ ؟ قَالَ : وَلاؤُهُ لِسَيِّدِهِ , وَلَوْ شَاءَ سَيِّدُهُ لَمْ يَجُزْ ذَلِكَ الْبَيْعُ , وَكَانَ ذَلِكَ الْعَبْدُ الَّذِي أَخَذَ مِنْهُ لِسَيِّدِهِ , قُلْتُ لَهُ : إِنَّ الْعَبْدَ مَا ابْتَاعَ نَفْسَهُ بِمَالِ الْعَبْدِ ؟ قَالَ : نَعَمْ , هُوَ مَالُ سَيِّدِهِ , قُلْتُ : فَعَلِمَ سَيِّدُهُ أَنَّمَا هُوَ يَبْتَاعُ نَفْسَهُ , قَالَ : فَهُوَ مُقَاطِعٌ الآنَ , وَوَلاؤُهُ لِسَيِّدِهِ, قَالَ ابْنُ جُرَيْجٍ : وَقَدْ سَمِعْتُ سُلَيْمَانَ بْنَ مُوسَى الشَّامِيَّ , يَقُولُ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ : \" أَيُّمَا عَبْدٍ ابْتَاعَ نَفْسَهُ بِمَالٍ هُوَ لِمَوْلاهُ , فَهُوَ لِمَوْلاهُ ""","","","","","Book of Wala' (Clientage)"
"15784","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : ، قُلْتُ لِعَطَاءٍ :حُرٌّ تَزَوَّجَ أَمَةً لِي ، فَحَمَلَتْ , فَأَعْتَقْتُ وَلَدَهَا فِي بَطْنِهَا , لِمَنْ وَلاؤُهُ ؟ قَالَ : \" لِلَّذِي أَعْتَقَهُ , وَلَكِنْ مِيرَاثُهُ لأَبِيهِ ""","","","","","Book of Wala' (Clientage)"
"15785","عَنِ الثَّوْرِيِّ ، عَنْ أَشْعَثَ ، عَنْ إِبْرَاهِيمَ ، وَالشَّعْبِيِّ ، قَالا : \"لا تَرِثُ النِّسَاءُ مِنَ الْوَلاءِ إِلا مَا أَعْتَقْنَ , أَوْ أَعْتَقَ مَنْ أَعْتَقْنَ \". قَالَ غَيْرُهُمْ : أَوْ جَرَّ مَنْ أَعْتَقْنَ , وَإِلا فَهُوَ يَحْرِزُهُنَّ","","","","","Book of Wala' (Clientage)"
"15786","عَنِ الثَّوْرِيِّ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِيِّ , قَالَ : \"النِّسَاءُ لا يَرِثْنَ مِنَ الْوَلاءِ إِلا مَا أَعْتَقْنَ , أَوْ كَاتَبْنَ ""","","","","","Book of Wala' (Clientage)"
"15787","عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنِ الْحَكَمِ ، عَنْ يَحْيَى بْنِ الْجَزَّارِ ، عَنْ عَلِيِّ بْنِ أَبِي طَالِبٍ , قَالَ : \"لا تَرِثُ النِّسَاءُ مِنَ الْوَلاءِ إِلَّا مَا كَاتَبْنَ , أَوْ أَعْتَقْنَ \". قَالَ الْحَكَمُ : وَأَخْبَرَنِي إِبْرَاهِيمُ ، عَنِ ابْنِ مَسْعُودٍ مِثْلَهُ ، قَالَ الْحَكَمُ : وَكَانَ شُرَيْحٌ يَقُولُهُ","","","","","Book of Wala' (Clientage)"
"15788","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، قَالَ : لا تَرِثُ الْمَرْأَةُ مِنَ الْوَلاءِ شَيْئًا إِلا أَنْ تُعْتِقَهُ , فَيَكُونَ وَلاؤُهُ لَهَا ، قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"الْوَلاءُ لِمَنْ أَعْتَقَ ""","","","","","Book of Wala' (Clientage)"
"15789","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، أَنَّهُ كَانَ يَقُولُ : \"تَرِثُ الْمَرْأَةُ مِنَ الْوَلاءِ ""","","","","","Book of Wala' (Clientage)"
"15790","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي قَيْسُ مَولَى عَمْرٍو , عَنِ ابْنِ طَاوُسٍ ، عَنْ غَيْرِ أَبِيهِ عَنْهُ , أَنَّهُ كَانَ يَقُولُ : \"تَرِثُ الْمَرْأَةُ الْوَلاءَ , وَيَتْلُو :  وَلِلنِّسَاءِ نَصِيبٌ مِمَّا تَرَكَ الْوَالِدَانِ وَالأَقْرَبُونَ ""","","","","","Book of Wala' (Clientage)"
"15791","عَنِ ابْنِ جُرَيْجٍ , قَالَ : \"إِنْ أَعْتَقَتِ امْرَأَةٌ غُلامًا , فَكَانَ لِذَلِكَ الْغُلامُ مَوَالٍ , فَلَهَا مِيرَاثُهُمْ إِنْ مَاتُوا , وَقَدْ مَاتَ مَوْلاهُمُ الأَدْنَى إِلَيْهِمْ ""","","","","","Book of Wala' (Clientage)"
"15792","عَنِ ابْنِ جُرَيْجٍ قَالَ : أَخْبَرَنِي عُمَرُ بْنُ عَبْدِ الرَّحْمَنِ ، أَنَّ أُمَّهُ ابْنَةَ الْمُطَّلِبِ بْنِ أَبِي وَدَاعَةَ , كَانَ لَهَامَوْلًى , وَكَانَ لَهُ مَوَالٍ , فَمَاتَ الْمَوْلَى , ثُمَّ مَاتَ مَوَالِي الْمَوْلَى , أَوْ بَعْضُهُمْ , فَأَحْرَزَتْ مَوَارِيثَهُمْ, قَالَ : وَأَخْبَرَنِي ذَلِكَ عُمَرُ , عَنْ جَعْفَرِ بْنِ الْمُطَّلِبِ , وَغَيْرِهِ مِنْهُمْ , قَالَ : وَأَخْبَرَنِي عَبْدُ اللَّهِ بْنُ كَثِيرٍ , مِثْلَ ذَلِكَ إِلا أَنَّهُ لَمْ يُخْبِرْنِيهِ عَنْ جَعْفَرٍ","","","","","Book of Wala' (Clientage)"
"15793","عَنِ الثَّوْرِيِّ , فِيأُخْتَيْنِ ابْتَاعَتْ إِحْدَاهُمَا أَخَاهَا فَأَعْتَقَتْهُ , ثُمَّ إِنَّ أَخَا هَذِهِ الَّتِي أَعْتَقَتِ ابْتَاعَ الأَبَ فَأَعْتَقَهُ , ثُمَّ مَاتَ الأَخُ , قَالَ : \" يَرِثُهُ أَبُوهُ , فَإِنَّهُ أَحَرَزُ لِلْمِيرَاثِ , ثُمَّ مَاتَ الأَبُ , فَإِحْدَى ابْنَتَيْهِ مَوْلاةٌ لَهُ , فَلَهُمَا الثُّلُثَانِ جَمِيعَا , ثُمَّ الْبَقِيَّةُ لِلَّتِي أَعْتَقَتْ , لأَنَّهَا عَصَبَةٌ ""","","","","","Book of Wala' (Clientage)"
"15794","عَنْ عَبْدِ اللَّهِ بْنِ الْمُبَارَكِ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ ، عَنْ عَبْدِ اللَّهِ بْنِ مَوْهَبٍ ، عَنْ تَمِيمٍ الدَّارِيِّ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَنْ أَسْلَمَ عَلَى يَدَيْ رَجُلٍ فَهُوَ مَوْلاهُ ""","","","","","Book of Wala' (Clientage)"
"15795","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ \" فِيالرَّجُلِ يُوَالِي الرَّجُلَ فَيُسْلِمُ عَلَى يَدَيْهِ , قَالَ : يَعْقِلُ عَنْهُ وَيَرِثُهُ \", أَخْبَرَنَا مَعْمَرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ مِثْلَهُ","","","","","Book of Wala' (Clientage)"
"15796","عَنِ الثَّوْرِيِّ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِيِّ ، وَعَنْ يُونُسَ ، عَنِ الْحَسَنِ , قَالا : \"مِيرَاثُهُ لِلْمُسْلِمِينَ \", عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، مِثْلَ حَدِيثِ مَعْمَرٍ , وَزَادَ : \" وَلَهُ أَنْ يُحَوِّلَ وَلاءَهُ حَيْثُ شَاءَ مَا لَمْ يَعْقِلْ عَنْهُ ""","","","","","Book of Wala' (Clientage)"
"15797","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ، أَنَّهُ سُئِلَ عَنِالْعَبْدِ ، يُعْتَقُ وَلَهُ أَوْلادٌ وَأُمُّهُمْ حُرَّةٌ , قَالَ : \" إِذَا عَتَقَ الأَبُ , جَرَّ الْوَلاءَ \", عَنِ ابْنِ عُيَيْنَةَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ عُمَرَ مِثْلَهُ","","","","","Book of Wala' (Clientage)"
"15798","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، عَنِ الأَسْوَدِ ، أَنَّ شُرَيْحًا ، كَانَ يَقْضِي إِذَا كَانَ الأَبُ مَمْلُوكًا , وَالأُمُّ حُرَّةٌ , وَلَهَا أَوْلادٌ , قَضَى أَنَّ وَلاءَ مَا وَلَدَتْ مِنْ زَوجِهَا , مَمْلُوكًا لِمَوْلَى الأُمِّ , وَأَنَّهُ وَقَعَ يَوْمَئِذٍ فَلا يَنْتَقِلُ , حَتَّى حَدَّثَهُ الأَسْوَدُ بْنُ يَزِيدَ , أَنَّ ابْنَ مَسْعُودٍ , قَالَ : \"يَجُرُّ الأَبُ الْوَلاءَ إِذَا أُعْتِقَ \", فَقَضَى بِهِ شُرَيْحٌ بَعْدُ","","","","","Book of Wala' (Clientage)"
"15799","عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، أَنَّ شُرَيْحًا ، كَانَ يَقْضِي أَنْ وَلاءَهُمْ لِمَوْلَى الأُمِّ , وَأَنَّهُ وَقَعَ يَوْمَئِذٍ فَلا يَنْتَقِلُ , وَأَنَّ زَيْدَ بْنَ ثَابِتٍ كَانَ يَقُولُهُ حَتَّى أَخْبَرَهُ مَسْرُوقُ بْنُ الأَجْدَعِ , أَنَّ ابْنَ مَسْعُودٍ ، قَالَ : \"إِذَا أُعْتِقَ أَبُوهُمْ جَرَّ وَلاءَهُمْ \", فَأَخَذَ بِهِ شُرَيْحٌ","","","","","Book of Wala' (Clientage)"
"15800","عَنْ مَعْمَرٍ ، عَنْ يَزَيْدَ الرَّشْكَ ، أَنَّ عَلِيَّ بْنَ أَبِي طَالِبٍ :\" قَضَى وَلاءَهُمْ إِلَى أَبِيهِمْ , وَأَنَّهُ جَرَّ الْوَلاءَ حِينَ عَتَقَ ""","","","","","Book of Wala' (Clientage)"
"15801","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي حُمَيْدٌ الأَعْرَجُ ، أَنَّ مُحَمَّدَ بْنَ إِبْرَاهِيمَ التَّيْمِيَّ أَخْبَرَهُ , أَنَّ الزُّبَيْرَ بْنَ الْعَوَّامِ , قَدِمَ خَيْبَرَ فَإِذَا هُوَ بِفِتْيَانٍ أَعَجَبَهُ ظُرْفُهُمْ وَجَلَدُهُمْ , فَقَالَ : \"مَنْ هَؤُلاءِ ؟ \" , فَقِيلَ لَهُ : مَوَالٍ لِرَافِعِ بْنِ خَدِيجٍ , قَالَ : \" وَمِنْ أَيْنَ ؟ \" , قَالُوا : نَكَحَ غُلامٌ لِلأَعْرَابِ مَوْلاةً لَهُ , فَجَاءَتْ بِهَؤُلاءِ , فَابْتَاعَ الزُّبَيْرُ ذَلِكَ الْعَبْدَ أَبَاهُمْ بِخَمْسِينَ دِرْهَمًا فَأَعْتَقَهُ , ثُمَّ أَخْرَجَهُمْ مِنْ مَالِ رَافِعٍ , وَجَعَلَهُمْ فِي مَالِهِ , ثُمَّ قَدِمَ الْمَدِينَةَ , فَأَرْسَلَ إِلَى رَافِعِ بْنِ خَدِيجٍ فَأَخْبَرَهُ الْخَبَرَ , وَأَنَّهُمْ مَوَالِي , فَإِنْ كَانَ لَكَ خُصُومَةٌ فَأْتِ عُثْمَانَ , فَجَاءَ عُثْمَانُ فَأَخْبَرَهُ الْخَبَرَ ، وَأَخْبَرَهُ مَا صَنَعَ الزُّبَيْرُ وَمَا قَالَ : قَالَ : فَقَالَ عُثْمَانُ : صَدَقَ الزُّبَيْرُ , هُمْ مَوَالِيهِ , قَالَ : \" فَهُمْ مَوَالِيهِ حَتَّى الْيَوْمِ ""","","","","","Book of Wala' (Clientage)"
"15802","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عُمَرُ بْنُ عَبْدِ اللَّهِ بْنِ عُرْوَةَ ، عَنِ الزُّبَيْرِ ، أَنَّهُ قَدِمَ أَرْضًا لَهُ بِخَيْبَرَ , َإِذَا بِفِتْيَانٍ فِي أَرْضِهِ , فَقَالَ : \"مَنْ هَؤُلاءِ ؟ فَقِيلَ لَهُ : أُمُّهُمْ مَوْلاةٌ لِرَافِعِ بْنِ خَدِيجٍ , وَأَبُوهُمْ عَبْدٌ , فَابْتَاعَ أَبَاهُمْ فَأَعْتَقَهُ ، ثُمَّ اخْتَصَمَا إِلَى عُثْمَانَ فَقَضَى بِوَلائِهِمْ لِلزُّبَيْرِ \" , قَالَ : فَبَنَوُهُمْ أَحْيَاءٌ الْيَوْمَ","","","","","Book of Wala' (Clientage)"
"15803","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ , قَالَ : \" مَرَّ الزُّبَيْرُ بِمَوَالٍ لِرَافِعٍ فَأَعْجَبُوهُ , فَقَالَ : \"لِمَنْ هَؤُلاءِ ؟ \" , قَالُوا : مَوَالٍ لِرَافِعِ بْنِ خَدِيجٍ ، قَالَ : \" وَمِنْ أَيْنَ ؟ \" , قِيلَ : أُمُّهُمْ مَوْلاةٌ لِرَافِعٍ , وَأَبُوهُمْ عَبْدٌ لِفُلانٍ رَجُلٍ مِنَ الأَعْرَابِ , فَاشْتَرَى الزُّبَيْرُ أَبَاهُمْ فَأَعْتَقَهُ , ثُمَّ قَالَ لَهُمْ : \" أَنْتُمْ مَوَالِيَّ \" , فَاخْتَصَمَ الزُّبَيْرُ , وَرَافِعٌ , إِلَى عُثْمَانَ , فَقَضَى بِوَلائِهِمْ لِلزُّبَيْرِ. قَالَ هِشَامٌ : فَلَمَّا كَانَ مُعَاوِيَةُ خَاصَمُوهُ فِيهِمْ أَيْضًا فَقَضَى لَنَا فِيهِمْ مُعَاوِيَةُ , فَقَالَ : \" فَإِنَّهُمْ لَنَا مَوَالٍ حَتَّى الْيَوْمِ ""","","","","","Book of Wala' (Clientage)"
"15804","عَنِ الثَّوْرِيِّ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ عُرْوَةَ ، وَحُمَيْدٍ الأَعْرَجِ ، عَنْ إِبْرَاهِيمَ التَّيْمِيِّ : أَنَّ رَافِعَ بْنَ خَدِيجٍ \"خَاصَمَ الزُّبَيْرَ فِي مَوْلاةٍ لِرَافِعٍ كَانَ زَوْجُهَا مَمْلُوكًا , فَاشْتَرَاهُ الزُّبَيْرُ فَأَعْتَقَهُ , فَاخْتَصَمَا إِلَى عُثْمَانَ فَقَضَى بِالْوَلاءِ لِلزُّبَيْرِ \". عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، وَعَنْ رَجُلٍ ، عَنِ الْحَسَنِ ، أَنَّهُمَا كَانَا يَقُولانِ مِثْلَ قَوْلِ عُثْمَانَ","","","","","Book of Wala' (Clientage)"
"15805","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي سَفَرٍ ، عَنِ الشَّعْبِيِّ , قَالَ : \"الْجَدُّ يَجُرُّ الْوَلاءَ \" , يَقُولُ : الْوَلاءُ رَجُلٌ مَاتَ , وَتَرَكَ أَبَاهُ عَبْدًا , وَجَدَهُ حُرًّا, قَالَ : \" يَجُرُّ الْجَدُّ الْوَلاءَ ""","","","","","Book of Wala' (Clientage)"
"15806","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"إِذَا أَدَّى الْمُكَاتِبُ النِّصْفَ , جَرَّ الْوَلاءَ ""","","","","","Book of Wala' (Clientage)"
"15807","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي مُلَيْكَةَ ، أَنَّ عَبْدَ اللَّهِ بْنَ الْمُسَيِّبِ بْنِ أَبِي السَّائِبِ ، وَمُحَمَّدَ بْنَ الْمُطَّلِبِ بْنِ أَزْهَرَ أَخْبَرَاهُ , أَنَّ مَرْوَانَ ، قَضَى فِي الْعَبْدِ يَتَزَوَّجُ الْحُرَّةَ فَتَلِدُ لَهُ , وَهُوَ عَبْدٌ ، ثُمَّ يُعْتَقُ أَنَّ وَلَدَهَا لأَهْلِ أَبِيهِمْ , قُلْنَا لِعَبْدِ اللَّهِ , فَلَعَلَّهُ قَضَى أَنَّهُ لا 000 مَا عَاشَ ؟ قَالَ : لا , بَلْ : \"جَرَّ وَلاءَهُمْ حِينَ عَتَقَ إِلَى مَوَالِي أَبِيهِمْ ""","","","","","Book of Wala' (Clientage)"
"15808","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قَالَ لَنَا ابْنُ أَبِي مُلَيْكَةَ , أَخْبَرَنِي عُرْوَةُ بْنُ عِيَاضٍ ، أَنَّهُ حَضَرَ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ , أَتَاهُ رَجُلٌ , فَقَالَ : إِنَّمَوْلاةً لَنَا تَزَوَّجَهَا رَجُلٌ عَبْدٌ لِفُلانٍ , فَوَلَدَتْ لَهُ أَوْلادًا ، ثُمَّ إِنَّ فُلانًا ابْتَاعَهُ فَأَعْتَقَهُ , وَزَعَمَ أَنَّ وَلاءَ مَوَالِينَا لَهُ , فَقَالَ : \" صَدَقَ وَلاؤُهُمْ لَهُ \" , قَالَ : فَوَاللَّهِ مَا ابْتَاعَهُ إِلا بِأَرْبَعِمِائَةِ دِرْهَمٍ , قَالَ : \" وَلَوِ ابْتَاعَهُ بِمِائَةِ دِرْهَمٍ , وَلَوْ شِئْتَ ابْتَعْتَهُ فَأَعْتَقْتَهُ ""","","","","","Book of Wala' (Clientage)"
"15809","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : \"وَلاؤُهُمْ لأَهْلِ أُمِّهِمْ \". وَقَالَ لِي عَمْرُو بْنُ دِينَارٍ : كُنَّا نَسْمَعُ ذَلِكَ , قَالَ لِي عَطَاءٌ : \" وَإِنْ أَعْتَقَ أَبَاهُمْ , وَلَكِنْ أَبُوهُمْ يَرِثُهُمْ ""","","","","","Book of Wala' (Clientage)"
"15810","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :الْمَرْأَةُ ذَاتُ ذُكُورٍ مَنْ يَعْقِلُ عَنْهَا ؟ قَالَ : \" عَصَبَتُهَا \" , قُلْتُ : وَيَرِثُهَا وَلَدُهَا الذُّكُورُ ؟ قَالَ : \" نَعَمْ \" ، قُلْتُ : فَمَوْلاتُهَا مَاتَتْ , وَلَهَا وَلَدٌ ذُكُورٌ , مَنْ يَعْقِلُ عَنْهُمْ ؟ قَالَ : \" وَلَدُهَا لَهُمُ الآنَ , وَلاؤُهُمْ يَعْقِلُونَ عَنْهُمْ وَيَرِثُونَهُ ""","","","","","Book of Wala' (Clientage)"
"15811","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : \"لا يَتَحَوَّلُ وَلاؤُهُمْ إِلَى مَوَالِي أُمِّهِمْ \", عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ عِكْرِمَةَ بْنِ خَالِدٍ مِثْلَ ذَلِكَ , قَالَ مَعْمَرٌ : وَبَلَغَنِي عَنْ مَيْمُونِ بْنِ مِهْرَانَ ، وَعُمَرَ بْنِ عَبْدِ الْعَزِيزِ مِثْلُ ذَلِكَ","","","","","Book of Wala' (Clientage)"
"15812","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ شِهَابٍ , قَالَ : أَخْبَرَنِي رَجَاءُ بْنُ حَيْوَةَ , أَنَّهُ بَيْنَا هُوَ عِنْدَ عَبْدِ الْمَلِكِ فِي آخِرِ خِلافَتِهِ ,اخْتَصَمَ إِلَيْهِ رَجُلانِ فِي مَوَالٍ ، أُمُّهُمْ حُرَّةٌ وَأَبُوهُمْ مَمْلُوكٌ ، ثُمَّ أُعْتِقَ أَبُوهُمْ بَعْدَ ذَلِكَ , فَأَرَادَ عَبْدُ الْمَلِكِ أَنْ يَقْضِيَ بِوَلائِهِمْ لأَهْلِ أَبِيهِمْ , فَقَالَ لَهُ قَبِيصَةُ بْنُ ذُؤَيْبٍ : إِنَّ عُمَرَ بْنَ الْخَطَّابِ : \" قَدْ قَضَى بِهِ لأَهْلِ أُمِّهِمْ \", فَقَالَ لَهُ عَبْدُ الْمَلِكِ : اعْلَمُ مَا تَقُولُ يَا قَبِيصُ ! فَقَدْ كَانَ فِي ذَلِكَ مَا تَعْلَمُ يُرِيدُ قَضَاءَ مَرْوَانَ , فَقَالَ قَبِيصَةُ : إِنَّ ذَلِكَ حَقٌّ وَسَأَنْظُرُ , قَالَ رَجُلٌ : فَلَمْ أَدْرِ مَا رَاجَعَ بِهِ قَبِيصَةُ , عَبْدَ الْمَلِكِ , غَيْرَ أَنِّي شَهِدْتُ عَبْدَ الْمَلِكِ قَضَى بَيْنَ ذَيْنِكِ الرَّجُلَيْنِ : \" أَنَّ الْوَلاءَ لأَهْلِ أُمِّهِمْ ""","","","","","Book of Wala' (Clientage)"
"15813","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ : أَنَّ عَلِيًّا وَالزُّبَيْرَاخْتَصَمَا فِي مَوْلًى لِصَفِيَّةَ , فَقَضَى عُمَرُ \" بِالْعَقْلِ عَلَى عَلِيٍّ , وَبِالْمِيرَاثِ لِلزُّبَيْرِ ""","","","","","Book of Wala' (Clientage)"
"15814","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، وَمُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِيِّ , قَالَ : \"إِذَا مَاتَتِ الْمَرْأَةُ وَتَرَكَتْ مَوَالِيَ , فَالْمِيرَاثُ لِوَلَدِهَا , وَالْعَقْلُ عَلَيْهِمْ \", قَالَ : وَكَانَ ابْنُ أَبِي لَيْلَى يَقْضِي بِهِ","","","","","Book of Wala' (Clientage)"
"15815","عَنْ سُفْيَانَ , فِي امْرَأَةٍ مَاتَتْ , وَتَرَكَتْ أَبَاهَا ، وَابْنَهَا ، وَمَوَالِيَهَا , قَالَ مُغِيرَةُ ، عَنْ إِبْرَاهِيمَ \"لِلأَبِ سُدُسُ الْوَلاءِ ، وَسَائِرُهُ لِلابْنِ ""","","","","","Book of Wala' (Clientage)"
"15816","عَنِ الْحَكَمِ , الْوَلاءِ لِلابْنِ , وَبَلَغَنِي عَنْ زَيْدِ بْنِ ثَابِتٍ , أَنَّهُ قَالَ : \"الْوَلاءُ لِلابْنِ \", قَالَ ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ ، وَهُوَ أَحَبُّ إِلَى سُفْيَانَ","","","","","Book of Wala' (Clientage)"
"15817","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنَا ابْنُ خُثَيْمٍ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , وَمُجَاهِدٍ , قَالا : \"الْوَلاءُ لأَهْلِ أُمَّهِمْ أَبَدًا ، غَيْرَ أَنَّ الأَبَ يَجُرُّ الْوَلاءَ مَا كَانَ حَيًّا ""","","","","","Book of Wala' (Clientage)"
"15818","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ :رَجُلٌ تُوُفِّي وَتَرَكَ جَدَّهُ , وَأَخَاهُ , ثُمَّ مَاتَ مَوْلَى الْمَيِّتِ , أَلَيْسَ مَالُ الْمَوْلَى بَيْنَ الْجَدِّ وَالأَخِ ؟ قَالَ : \" بَلَى ""","","","","","Book of Wala' (Clientage)"
"15819","وَقَالَ عَطَاءٌ : فِيرَجُلٍ تُوُفِّي وَتَرَكَ أَبَاهُ وَبَنِيهِ , قَالَ : \" وَلاءُ الْمَوْلَى لِبَنِيهِ ""","","","","","Book of Wala' (Clientage)"
"15820","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ،فِي رَجُلٍ تُوُفِّي , وَتَرَكَ جَدَّهُ وَأَخَاهُ , وَمَاتَ مَوْلًى لِلْمَيِّتِ ، قَالَ : \" أَرَاهُ لِلْجَدِّ \" , قَالَ الزُّهْرِيُّ : \" وَقَدْ كَانَ عُمَرُ بْنُ الْخَطَّابِ يُنَازِعُهُ رَأْيَهُ أَنَّهُ أَبٌ , وَقَدْ عَلَى ذَلِكَ أَشْرَكَ بَيْنَهُ وَبَيْنَ الأَخِ فِي الْمِيرَاثِ \", قَالَ مَعْمَرٌ : وَسَمِعْتُ غَيْرَ الزُّهْرِيِّ , يَقُولُ : \" هُوَ بَيْنَهُمَا نِصْفَانِ ""","","","","","Book of Wala' (Clientage)"
"15821","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، أَنَّهُ سُئِلَ عَنْرَجُلٍ أَذِنَ لأَمَتِهِ فَأَعْتَقَتْ عَبْدًا ثُمَّ اشْتَرَاهَا قَوْمٌ آخَرُونَ , قَالَ : \" الْوَلاءُ لِلأَوَّلِينَ الَّذِينَ بَاعُوهَا ""","","","","","Book of Wala' (Clientage)"
"15822","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، أَنَّهُ سُئِلَ عَنْرَجُلٍ وَابْنِهِ ، أَعْتَقَ الأَبَ قَوْمٌ , وَالابْنَ قَوْمٌ آخَرُونَ , قَالَ : \" يَتَوَارَثَانِ بِالأَرْحَامِ , وَيَكُونُ الْعَقْلُ عَلَى مَنْ أَعْتَقَ ""","","","","","Book of Wala' (Clientage)"
"15823","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ جَعْفَرَ بْنَ مُحَمَّدٍ يُحَدِّثُ , عَنْ أَبِيهِ , قَالَ : وُجِدَ فِي نَعْلِ سَيْفِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَنَّأَعْدَى النَّاسِ عَلَى اللَّهِ ثَلاثَةٌ : مَنْ قَتَلَ غَيْرَ قَاتِلِهِ ، أَوْ ضَرَبَ غَيْرَ ضَارِبِهِ , أَوْ آوَى مُحْدِثًا , فَلا يَقْبَلُ اللَّهُ مِنْهُ صَرْفًا ، وَلا عَدْلا , وَمَنْ تَوَلَّى غَيْرَ مَوَالِيهِ , فَهُوَ كَافِرٌ بِمَا أَنْزَلَ اللَّهُ عَلَى رَسُولِهِ ""","","","","","Book of Wala' (Clientage)"
"15824","عَنْ إِبْرَاهِيمَ ، عَنْ شَرِيكِ بْنِ أَبِي نَمِرٍ ، أَنَّهُ سَمِعَ ابْنَ الْمُسَيِّبِ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَنْ تَوَالَى غَيْرَ مَوَالِيهِ , فَعَلَيْهِ لَعْنَةُ اللَّهِ وَالْمَلائِكَةِ وَالنَّاسِ أَجْمَعِينَ , لا يَقْبَلُ اللَّهُ مِنْهُ صَرْفًا , وَلا عَدْلا ""","","","","","Book of Wala' (Clientage)"
"15825","عَنْ مَعْمَرٍ ، عَنْ مَطَرٍ الْوَرَّاقِ ، عَنْ شَهْرِ بْنِ حَوْشَبٍ ، عَنْ عَمْرِو بْنِ خَارِجَةَ , قَالَ : كُنْتُ تَحْتَ جِرَانِ نَاقَةِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَإِنَّهَا لَتَقْصَعُ بِجِرَّتِهَا , وَإِنَّ لُعَابَهَا لَيَسِيلُ عَلَى كَتِفَيْ , فَسَمِعْتُهُ يَقُولُ وَهُوَ يَخْطُبُ بِمِنًى , يَقُولُ : \" إِنَّاللَّهَ قَدْ أَعْطَى كُلَّ ذِي حَقٍّ حَقَّهُ , وَإِنَّهُ لَيْسَ لِوَارِثٍ وَصِيَّةٌ ، الْوَلَدُ لِلْفِرَاشِ ، وَلِلْعَاهِرِ الْحَجَرُ ، مَنِ ادَّعَى إِلَى غَيْرِ أَبِيهِ , أَوِ انْتَمَى إِلَى غَيْرِ مَنْ أَنْعَمَ اللَّهُ بِهِ , عَلَيْهِ فَعَلَيْهِ لَعْنَةُ اللَّهِ , وَالْمَلائِكَةِ , وَالنَّاسِ أَجْمَعِينَ ""","","","","","Book of Wala' (Clientage)"
"15826","عَنِ الثَّوْرِيِّ ، عَنْ لَيْثٍ ، عَنْ شَهْرِ بْنِ حَوْشَبٍ , قَالَ : أَخْبَرَنِي مَنْ /سَمِعَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَإِنَّ لُعَابَ نَاقَةِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَيَسِيلُ عَلَى فَخِذِهِ , قَالَ : خَطَبَنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ عَلَى نَاقَتِهِ , فَقَالَ : \" إِنَّالصَّدَقَةَ لا تَحِلُّ لِي , وَلا لأَهْلِ بَيْتِي \" ، وَأَخَذَ وَبَرَةً مِنْ كَاهِلِ نَاقَتِهِ , فَقَالَ : \" لا وَاللَّهِ , وَلا مَا يُسَاوِي هَذَا , وَلا مَا يَزِنُ هَذَا","","","","","Book of Wala' (Clientage)"
"15827","لَعَنَ اللَّهُ مَنِ ادَّعَى إِلَى غَيْرِ أَبِيهِ , أَوْ تَوَلَّى إِلَى غَيْرِ مَوَالِيهِ ، الْوَلَدُ لِلْفِرَاشِ ، وَلِلْعَاهِرِ الْحَجَرُ ، إِنَّ اللَّهَ قَدْ أَعْطَى كُلَّ ذِي حَقٍّ حَقَّهُ , فَلا وَصِيَّةَ لِوَارِثٍ ""","","","","","Book of Wala' (Clientage)"
"15828","عَنْ إِسْمَاعِيلَ بْنِ عَيَّاشٍ ، عَنْ شُرَحْبِيلَ بْنِ مُسْلِمٍ الْخَوْلانِيِّ ، عَنْ أَبِي أُمَامَةَ الْبَاهِلِيِّ ، قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ عَامَ حَجَّةِ الْوَدَاعِ , يَقُولُ : \" إِنَّاللَّهَ قَدْ أَعْطَى كُلَّ ذِي حَقٍّ حَقَّهُ , فَلا وَصِيَّةَ لِوَارِثٍ , الْوَلَدُ لِلْفِرَاشِ , وَلِلْعَاهِرِ الْحَجَرُ , وَحِسَابُهُمْ عَلَى اللَّهِ , وَمَنِ ادَّعَى إِلَى غَيْرِ أَبِيهِ , أَوْ تَوَالَى إِلَى غَيْرِ مَوَالِيهِ , فَعَلَيْهِ لَعْنَةُ اللَّهِ التَّابِعَةُ إِلَى يَوْمِ الْقِيَامَةِ ، لا تُنْفِقُ امْرَأَةٌ شَيْئًا مِنْ بَيْتِهَا , إِلا بِإِذْنِ زَوْجِهَا \" , قِيلَ : يَا رَسُولَ اللَّهِ , وَلا الطَّعَامَ ؟ قَالَ : \" ذَلِكَ أَفْضَلُ أَمْوَالِنَا ""","","","","","Book of Wala' (Clientage)"
"15829","ثُمَّ قَالَ :\" الْعَارِيَةُ مُؤَدَّاةٌ ، وَالْمَنِيحَةُ مَرْدُودَةٌ ، وَالدَّيْنُ يُقْضَى وَالزَّعِيمُ غَارِمٌ ""","","","","","Book of Wala' (Clientage)"
"15830","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنْ عَلِيٍّ , أَنُّهُ قَالَ : \"مَنْ تَوَلَّى مَوْلَى قَوْمٍ بِغَيْرِ إِذْنِ مَوَالِيهِمْ , فَعَلَيْهِمْ لَعْنَةُ اللَّهِ , وَالْمَلائِكَةِ , وَالنَّاسِ , لا يَقْبَلُ اللَّهُ مِنْهُ صَرْفًا ، وَلا عَدْلا \", قَالَ : وَيَقُولُ : \" الصَّرْفُ , وَالْعَدْلُ : التَّطَوُّعُ , وَالْفَرِيضَةُ ""","","","","","Book of Wala' (Clientage)"
"15831","أَخْبَرَنَا مَعْمَرٌ ، عَنْ عَاصِمِ بْنِ سُلَيْمَانَ , قَالَ : حَدَّثَنَا أَبُو عُثْمَانَ النَّهْدِيُّ ، أَنَّهُ سَمِعَ سَعْدَ بْنَ أَبِي وَقَّاصٍ ، وَأَبَا بَكْرَةَ , يَقُولانِ : سَمِعَا رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : \"مَنِ ادَّعَى إِلَى أَبٍ غَيْرِ أَبِيهِ , وَهُوَ يَعْلَمُ أَنَّهُ غَيْرُ أَبِيهِ , حَرَّمَ اللَّهُ عَلَيْهِ الْجَنَّةَ \", قَالَ عَاصِمٌ : فَقُلْتُ لأَبِي عُثْمَانَ : لَقَدْ شَهِدَ عِنْدَكَ رَجُلانِ حَسْبُكَ بِهِمَا , قَالَ : أَجَلْ , أَمَّا أَحَدُهُمَا يَعْنِي : سَعْدًا , فَأَوَّلُ مَنْ رَمَى بِسَهْمٍ فِي سَبِيلِ اللَّهِ ، وَأَمَّا الآخَرُ يَعْنِي : أَبَا بَكْرَةَ , فَإِنَّهُ نَزَلَ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُحَاصِرٌ لأَهْلِ الطَّائِفِ بِثَلاثَةٍ وَعِشْرِينَ مِنْ رَقَيقِهِمْ , حَسِبْتُهُ قَالَ : فَأَعْتَقَهُمْ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","","","","","Book of Wala' (Clientage)"
"15832","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّهُ سَمِعَ عُمَرَ , يَقُولُ : \" قَدْ كُنَّانَقْرَأُ لا تَرْغَبُوا عَنْ آبَائِكُمْ فَإِنَّهُ كُفْرٌ بِكُمْ أَوْ إِنَّ كُفْرًا بِكُمْ أَنْ تَرْغَبُوا عَنْ آبَائِكُمْ ""","","","","","Book of Wala' (Clientage)"
"15833","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي الْعَبَّاسُ , عَنْ رَجُلِ مِنَ الأَنْصَارِ , قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : \"مَنِ ادَّعَى إِلَى غَيْرِ أَبِيهِ , فَعَلَيْهِ لَعْنَةُ اللَّهِ ""","","","","","Book of Wala' (Clientage)"
"15834","عَنْ مَعْمَرٍ ، عَنْ عَاصِمِ بْنِ سُلَيْمَانَ ، عَنْ أَبِي عُثْمَانَ ، عَنْ سَعْدِ بْنِ أَبِي وَقَّاصٍ ، قَالا : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَنِ ادَّعَى إِلَى غَيْرِ أَبِيهِ , وَهُوَ يَعْلَمُ أَنَّهُ غَيْرَ أَبِيهِ , حَرَّمَ اللَّهُ عَلَيْهِ الْجَنَّةَ \", قَالَ عَاصِمٌ : فَقُلْتُ لأَبِي عُثْمَانَ : لَقَدْ شَهِدَ عِنْدَكَ رَجُلانِ حَسْبُكَ بِهِمَا","","","","","Book of Wala' (Clientage)"
"15835","عَنِ الثَّوْرِيِّ ، عَنْ عَاصِمِ بْنِ سُلَيْمَانَ , قَالَ : حَدَّثَنِي أَبُو عُثْمَانَ النَّهْدِيُّ , قَالَ : سَمِعْتُ ابْنَ مَالِكٍ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَنِ ادَّعَى إِلَى غَيْرِ أَبِيهِ , وَهُوَ يَعْلَمُ أَنَّهُ غَيْرَ أَبِيهِ , فَالْجَنَّةُ عَلَيْهِ حَرَامٌ ""","","","","","Book of Wala' (Clientage)"
"15836","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللَّهِ بْنِ مُرَّةَ ، عَنْ أَبِي مَعْمَرٍ الأَزْدِيِّ وَهُوَ : عَبْدُ اللَّهِ بْنُ شِخِّيرٍ , قَالَ : قَالَ أَبُو بَكْرٍ الصِّدِّيقُ\" كَفَرَ بِاللَّهِ تَعَالَى مَنِ ادَّعَى إِلَى نَسَبٍ غَيْرِ نَسَبِهِ ، وَتَبَرَّأَ مِنْ نَسَبٍ , وَإِنْ دَقَّ \". عَنْ مَعْمَرٍ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللَّهِ بْنِ مُرَّةَ ، عَنْ أَبِي مَعْمَرٍ ، عَنِ أَبِي بَكْرٍ مِثْلَهُ","","","","","Book of Wala' (Clientage)"
"15837","عَنْ عَبْدِ اللَّهِ بْنِ كَثِيرٍ ، عَنْ شُعْبَةَ , قَالَ : أَخْبَرَنِي الْحَكَمُ ، عَنْ مُجَاهِدٍ , قَالَ : ادَّعَى مُعَاوِيَةُ ، أَنْ يُدْعَى رَجُلٌ مِنَ الأَزْدِ يُقَالُ لَهُ : عَبْدُ اللَّهِ بْنُ عَمْرٍو :مَنِ ادَّعَى إِلَى غَيْرِ أَبِيهِ , فَلَنْ يَرِحْ رَائِحَةَ الْجَنَّةِ ، وَإِنَّ رَائِحَتَهَا لَتُوجَدُ مِنْ مَسِيرَةِ خَمْسِمِائَةِ عَامٍ , وَقِيلَ سَبْعُونَ عَامًا ""","","","","","Book of Wala' (Clientage)"
"15838","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ عَدِيِّ بْنِ عَدِيٍّ ، عَنْ أَبِيهِ ، أَوْ عَنْ عَمِّهِ ، أَنَّ مَمْلُوكًا ، كَانَ يُقَالُ لَهُ : كَيْسَانُ , فَسَمَّى نَفْسَهُ قَيْسًا , وَادَّعَى إِلَى مَوَالِيهِ , وَلَحِقَ بِالْكُوفَةِ , فَرَكِبَ أَبُوهُ إِلَى عُمَرَ بْنِ الْخَطَّابِ , فَقَالَ : يَا أَمِيرَ الْمُؤْمِنِينَ ,وُلِدَ عَلَى فِرَاشِي ، ثُمَّ رَغِبَ عَنِّي , وَادَّعَى إِلَى مَوَالِيهِ , وَمَوْلايَ ، فَقَالَ عُمَرُ : أَزَيْدُ بْنُ ثَابِتٍ أَلَمْ تَعْلَمْ أَنَّا كُنَّا نَقْرَأُ : \" لا تَرْغَبُوا عَنْ آبَائِكُمْ فَإِنَّهُ كُفْرٌ بِكُمْ ، فَقَالَ زَيْدٌ : بَلَى ، فَقَالَ عُمَرُ : \" لَعَلَّ اللَّهَ انْطَلِقْ , فَافْرُقِ ابْنَكَ إِلَى بَعِيرِكَ , ثُمَّ انْطَلِقْ بِهِ فَاضْرِبْ بَعِيرَكَ سَوْطًا ، وَابْنَكَ سَوْطًا حَتَّى تَأْتِيَ أَهْلَكَ ""","","","","","Book of Wala' (Clientage)"
"15839","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ مُحَمَّدِ بْنِ سِيرِينَ ، عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ : \"كَانُوا يَكْتُبُونَ فِي صُدُورِ وَصَايَاهُمْ : بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , هَذَا مَا أَوْصَى بِهِ فُلانٌ : إِنَّهُ يَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ وَحْدَهُ لا شَرِيكَ لَهُ , وَأَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ,  وَأَنَّ السَّاعَةَ آتِيَةٌ لا رَيْبَ فِيهَا وَأَنَّ اللَّهَ يَبْعَثُ مَنْ فِي الْقُبُورِ , وَأَوْصَى مَنْ تَرَكَ مِنْ أَهْلِهِ , أَنْ يَتَّقُوا اللَّهَ وَيُصْلِحُوا ذَاتَ بَيْنِهِمْ ، وَيُطِيعُوا اللَّهَ وَرَسُولَهُ إِنْ كَانُوا مُؤْمِنِينَ , وَأَوْصَاهُمْ بِمَا أَوْصَى إِبْرَاهِيمُ بَنِيهِ , وَيَعْقُوبُ  إِنَّ اللَّهَ اصْطَفَى لَكُمُ الدِّينَ فَلا تَمُوتُنَّ إِلا وَأَنْتُمْ مُسْلِمُونَ \", وذَكَرَهُ عَبْدُ الرَّزَّاقِ عَنْ هِشَامٍ ، عَنِ ابْنِ سِيرِينَ , عَنْ أَنَسٍ مِثْلَهُ","","","","","Book of Wills"
"15840","عَنِ الثَّوْرِيِّ , قَالَ : سَمِعْتُ أَبِي يَذْكُرُ وَصِيَّةَ رَبِيعِ بْنِ خُثَيْمٍ \"هَذَا مَا أَقَرَّ بِهِ رَبِيعُ بْنُ خُثَيْمٍ عَلَى نَفْسِهِ ، وَأَشْهَدَ اللَّهَ عَلَيْهِ , وَكَفَى بِاللَّهِ شَهِيدًا ، وَجَازِيًا لِعِبَادِهِ الصَّالِحِينَ ، وَمُثِيبًا بِأَنِّي رَضِيتُ بِاللَّهِ رَبًّا , وَبِالإِسْلامِ دِينًا , وَبِمُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَبِيًّا , فَأُوصِي لِنَفْسِي ، وَمَنْ أَطَاعَنِي , بِأَنْ أَعْبُدَهُ فِي الْعَابِدِينَ ، وَأَحْمَدُهُ فِي الْحَامِدِينَ ، وَأَنْ أَنْصَحَ لِجَمَاعَةِ الْمُسْلِمِينَ ""","","","","","Book of Wills"
"15841","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ عُمَارَةَ بْنِ الْقَعْقَاعِ ، عَنْ أَبِي زُرْعَةَ ، قَالَ : قَالَ رَجُلٌ : يَا رَسُولَ اللَّهِ ,أَيُّ الصَّدَقَةِ أَعْظَمُ أَجْرًا ؟ قَالَ : \" أَنْ تُؤْتِيَهُ وَأَنْتَ صَحِيحٌ , شَحِيحٌ , تَأْمَلُ الْعَيْشَ , وَتَخْشَى الْفَقْرَ ، وَلا تُمْهِلُ حَتَّى إِذَا بَلَغَتِ الْحُلْقُومَ \" , قُلْتَ : لِفُلانٍ كَذَا , وَلِفُلانٍ كَذَا , وَقَدْ كَانَ لِفُلانٍ","","","","","Book of Wills"
"15842","أَخْبَرَنَا الثَّوْرِيُّ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللَّهِ بْنِ سِنَانٍ الأَسْلَمِيِّ ، عَنِ ابْنِ مَسْعُودٍ , قَالَ : \"تَانِكَ الْمُرَّيَانِ : الإِمْسَاكُ فِي الْحَيَاةِ ، وَالتَّبْذِيرُ عِنْدَ الْمَوْتِ ""","","","","","Book of Wills"
"15843","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ مَسْرُوقٍ ، أَنَّهُ قَالَ : \"مَا أُحِبُّ أَنْ أَرَى الرَّجُلَ شَحِيحًا , صَحِيحًا , حَرِيصًا فِي حَيَاتِهِ , جَوَادًا عِنْدَ مَوْتِهِ ""","","","","","Book of Wills"
"15844","عَنِ الثَّوْرِيِّ ، عَنْ زُبَيْدٍ ، عَنْ مُرَّةَ , فِي قَوْلِهِ : وَآتَى الْمَالَ عَلَى حُبِّهِ , قَالَ : قَالَ ابْنُ مَسْعُودٍ : \" أَنْ تُؤْتِيَهُ وَأَنْتَ صَحِيحٌ , شَحِيحٌ , تَأْمَلُ الْعَيْشَ , وَتَخْشَى الْفَقْرَ ""","","","","","Book of Wills"
"15845","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ سُلَيْمَانَ بْنَ مُوسَى , يَقُولُ : سَمِعْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \"جُعِلَتُ لَكُمْ ثُلُثُ أَمْوَالِكُمْ زِيَادَةً فِي أَعْمَالِكُمْ ""","","","","","Book of Wills"
"15846","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمِ بْنِ عَبْدِ اللَّهِ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \"مَا حَقُّ امْرِئٍ مُسْلِمٍ تَمُرُّ عَلَيْهِ ثَلاثٌ إِلا وَوَصِيَّتُهُ عِنْدَهُ \", قَالَ سَالِمٌ : قَالَ ابْنُ عُمَرَ : مَا مَرَّتْ عَلَيَّ ثَلاثُ لَيَالٍ قَطُّ إِلا وَوَصِيَّتِي عِنْدِي , يَعْنِي : يَنْظُرُ مَا لَهُ وَمَا عَلَيْهِ","","","","","Book of Wills"
"15847","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" فِيمَا يُحَدِّثُ عَنِ اللَّهِ تَبَارَكَ وَتَعَالَى : يَا ابْنَ آدَمَ ,خَصْلَتَانِ أَعْطَيْتُكَهُمَا لَمْ تَكُنْ لِغَيْرِكَ وَاحِدَةٌ مِنْهُمَا : جَعَلْتُ لَكَ طَائِفَةً مِنْ مَالِكَ عِنْدَ مَوْتِكِ أَرْحَمُكَ بِهِ \" , أَوْ قَالَ : \" أُطَهِّرُكَ بِهِ , وَصَلاةَ عِبَادِي عَلَيْكَ بَعْدَ مَوْتِكِ ""","","","","","Book of Wills"
"15848","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، وَابْنُ عُيَيْنَةَ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ، أَنَّهُ سَمِعَ طَاوُسًا , يَقُولُ : \"مَا مِنْ مُسْلِمٍ يَمُوتُ , وَلَمْ يُوصِ إِلا أَهْلَهُ , مَحْقُوقُونً أَنْ يُوصُوا عَنْهُ \", قَالَ ابْنُ جُرَيْجٍ : فَعَرَضْتُ عَلَى طَاوُسٍ مَا أَخْبَرَنِي بِهِ إِبْرَاهِيمُ عَنِ الْوَصِيَّةِ , فَقُلْتُ : كَذَلِكَ ؟ قَالَ : نَعَمْ","","","","","Book of Wills"
"15849","عَنْ إِسْمَاعِيلَ ، عَنْ دَاوُدَ بْنِ أَبِي هِنْدٍ ، عَنِ الشَّعْبِيِّ , قَالَ : \" إِنَّمَاالْوَصِيَّةُ تَمَامٌ لِمَا تَرَكَ مِنَ الصَّدَقَةِ ""","","","","","Book of Wills"
"15850","عَنْ إِسْمَاعِيلَ ، عَنْ دَاوُدَ ، أَيْضًا عَنِ الْقَاسِمِ بْنِ فُلانٍ , أَوْ فُلانِ بْنِ الْقَاسِمِ , قَالَ : قَالَ لِي ابْنُ حَرِيٍّ الْقُشَيْرِيُّ : \" أَوْصَى أَبُوكَ ؟ \" ، قُلْتُ : لا , قَالَ : \" فَلا تَدَعْهُ حَتَّى تُوصِي عَنْهُ \" , قَالَ لِي : \" إِنَّالْوَصِيَّةَ تَمَامٌ لِمَا تَرَكَ مِنَ الزَّكَاةِ , أَوِ الصَّدَقَةِ ""","","","","","Book of Wills"
"15851","عَنْ إِسْمَاعِيلَ , قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ عَوْنٍ , يَقُولُ : \" إِنَّمَاالْوَصِيَّةُ بِمَنْزِلَةِ الصَّدَقَةِ , فَأَحَبُّ إِلَيَّ إِذَا كَانَ الْمُوصَى لَهُ غَنِيًّا أَنْ يَدَعَهَا ""","","","","","Book of Wills"
"15852","عَنِ الثَّوْرِيِّ ، عَنِ الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ ، عَنْ إِبْرَاهِيمَ النَّخَعِيِّ , قَالَ : ذَكَرْنَا أَنَّ زُبَيْرًا ، وَطَلْحَةَ , كَانَا يُشَدِّدَانِ فِي الْوَصِيَّةِ عَلَى الرِّجَالِ , فَقَالَ : \" وَمَا كَانَ عَلَيْهِمَا أَلا يَفْعَلا ؟تُوُفِّي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَمَا أَوْصَى, وَأَوْصَى أَبُو بَكْرٍ , فَإِنْ أَوْصَى فَحَسَنٌ ، وَإِنْ لَمْ يُوصِ فَلا بَأْسَ ""","","","","","Book of Wills"
"15853","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \" سَأَلَ سَعْدُ بْنُ عُبَادَةَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْنَذْرٍ كَانَ عَلَى أُمِّهِ ، فَأَمَرَ بِقَضَائِهِ ""","","","","","Book of Wills"
"15854","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ , قَالَ : جَاءَ سَعْدُ بْنُ عُبَادَةَ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنَّأُمِّي كَانَ عَلَيْهَا نَذْرٌ أَفَأَقْضِيهُ ؟ قَالَ : \" نَعَمْ \" قَالَ : أَيَنْفَعُهَا ذَلِكَ ؟ قَالَ : \" نَعَمْ ""","","","","","Book of Wills"
"15855","حَدَّثَنَا ابْنُ عُيَيْنَةَ ، عَنْ عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ , قَالَ : سَمِعْتُ عُبَيْدَ اللَّهِ بْنَ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، يَذْكُرُ أَنَّأُمَّهُ مَاتَتْ , وَقَدْ كَانَ عَلَيْهَا اعْتِكَافٌ , قَالَ : فَبَادَرْتُ إِخْوَتِي إِلَى ابْنِ عَبَّاسٍ فَسَأَلْتُهُ , فَقَالَ : \" اعْتَكِفْ عَنْهَا وَصُمْ ""","","","","","Book of Wills"
"15856","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِبْرَاهِيمُ بْنُ مَيْسَرَةَ ، أَنَّهُ قَالَ لِطَاوُسٍ :الصَّدَقَةُ لِلْمَيِّتِ ، فَقَالَ : \" بَخٍ بَخٍ ! وَعَجِبَ مِنْ ذَلِكَ ""","","","","","Book of Wills"
"15857","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي يَعْلَى ، أَنَّهُ سَمِعَ عِكْرِمَةَ مَوْلَى ابْنِ عَبَّاسٍ , يَقُولُ : أَخْبَرَنَا ابْنُ عَبَّاسٍ ، أَنَّ سَعْدَ بْنَ عُبَادَةَ تُوُفِّيَتْ أُمُّهُ وَهُوَ غَائِبٌ عَنْهَا ، فَأَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللَّهِ , إِنَّأُمِّي تُوُفِّيَتْ وَأَنَا غَائِبٌ عَنْهَا , فَهَلْ يَنْفَعُهَا إِنْ تَصَدَّقْتُ بِشَيْءٍ عَنْهَا ؟ فَقَالَ : \" نَعَمْ \" ، فَقَالَ : أُشْهِدُكَ أَنَّ حَائِطَ الْمِخْرَافِ صَدَقَةٌ عَنْهَا","","","","","Book of Wills"
"15858","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّ عِكْرِمَةَ مَوْلَى ابْنِ عَبَّاسٍ أَخْبَرَهُ ، أَنَّ رَجُلا ، قَالَ : يَا رَسُولَ اللَّهِ , إِنَّأُمِّي تُوُفِّيَتْ وَلَمْ تَتَصَدَّقْ بِشَيْءٍ , أَفَلَهَا أَجْرٌ إِنْ تَصَدَّقْتُ عَنْهَا ؟ قَالَ : \" نَعَمْ \" , قَالَ : فَإِنَّهَا قَدْ تَرَكَتْ مِخْرَافًا , فَأَنَا أُشْهِدُكَ أَنِّي قَدْ تَصَدَّقْتُ بِهِ عَنْهَا","","","","","Book of Wills"
"15859","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَطَاءً يَسْأَلُ \"هَلْ لِلْمَيِّتِ أَجْرٌ فِيمَا يُتَصَدَّقُ بِهِ عَنْهُ الْحَيُّ ؟ قَالَ : فَقَدْ بَلَغَنَا ذَلِكَ ""","","","","","Book of Wills"
"15860","عَنِ الثَّوْرِيِّ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ , قَالَ : قَالَ رَجُلٌ : يَا رَسُولَ اللَّهِ ,أُعْتِقُ عَنْ أُمِّي وَقَدْ مَاتَتْ ؟ فَقَالَ : \" نَعَمْ ""","","","","","Book of Wills"
"15861","عَنِ ابْنِ جُرَيْجٍ ، وَمَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ : أَنَّ رَجُلا جَاءَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللَّهِ , إِنَّأُمِّي تُوُفِّيَتْ , وَلَمْ تُوصِ أَفَأُوصِي عَنْهَا ؟ قَالَ : \" نَعَمْ \" , قَالَ : وَجَاءَ رَجُلٌ مِنْ خَثْعَمٍ , فَقَالَ : يَا رَسُولَ اللَّهِ , إِنَّ أَبِي شَيْخٌ كَبِيرٌ لا يَسْتَطِيعُ أَنْ يَحُجَّ إِلا مُعْتَرِضًا عَلَى بَعِيرِهِ أَفَأَحُجَّ عَنْهُ ؟ قَالَ : \" نَعَمْ ""","","","","","Book of Wills"
"15862","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عُمَيْرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبْدٍ ، عَنِ ابْنِ عُمَيْرٍ , قَالَ : تُوُفِّيَتْ أُمُّ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ وَهُوَ غَائِبٌ عَنْهَا وَلَمْ تُوصِ , فَقَالَ : يَا رَسُولَ اللَّهِ , إِنَّأُمِّي تُوُفِّيَتْ , وَأَنَا غَائِبٌ وَلَمْ تُوصِ , وَلَمْ يَمْنَعْهَا أَنْ تُوصِيَ إِلا غَيْبَتِي , أَرَأَيْتَ إِنْ تَصَدَّقْتُ لَهَا , أَوْ أَعْتَقْتُ لَهَا , أَلَهَا أَجْرٌ ؟ قَالَ : \" نَعَمْ \" , قَالَ : فَأَعْتَقَ عَنْهَا عَشْرَ رِقَابٍ","","","","","Book of Wills"
"15863","حَدَّثَنَا مَعْمَرٌ ، وَالثَّوْرِيُّ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ , قَالَ : جَاءَ رَجُلٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ ، فَقَالَ : يَا رَسُولَ اللَّهِ , إِنَّأُمِّي افْتَلَتَتْ نَفْسَهَا ، وَقَدْ عَلِمَتْ أَنَّهَا لَوْ تَكَلَّمَتْ تَصَدَّقَتْ , أَفَأَتَصَدَّقُ عَنْهَا ؟ قَالَ : \" نَعَمْ ""","","","","","Book of Wills"
"15864","عَنِ الثَّوْرِيِّ ، عَنْ سَالِمٍ الأَفْطَسِ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قَالَ : \"لَوْ أَنَّ رَجُلا ، تَصَدَّقَ عَنْ مَيِّتٍ بِكِرَاعٍ , تَقَبَّلَهُ اللَّهُ مِنْهُ ""","","","","","Book of Wills"
"15865","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، قَالَ :مَاتَ عَبْدُ الرَّحْمَنِ بْنُ أَبِي بَكْرٍ فِي مَنَامٍ لَهُ \" فَأَعْتَقَتْ عَنْهُ عَائِشَةُ تِلادًا مِنْ تِلادِهِ ""","","","","","Book of Wills"
"15866","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : \"لا يُصَلِّيَنَّ أَحَدٌ عَنْ أَحَدٍ ، وَلا يَصُومَنَّ أَحَدٌ عَنْ أَحَدٍ , وَلَكِنْ إِنْ كُنْتَ فَاعِلا تَصَدَّقْتَ عَنْهُ , أَوْ أَهْدَيْتَ ""","","","","","Book of Wills"
"15867","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنِ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ , قَالَ : \" ذُكِرَ لَنَا أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَأَعْتَقَ عَنِ امْرَأَةٍ مَاتَتْ وَلَمْ تُوصِ وَلِيدَةً , وَتَصَدَّقَ عَنْهَا بِمَتَاعٍ ""","","","","","Book of Wills"
"15868","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، أَنَّ الْعَاصَ بْنَ وَائِلٍ كَانَعَلَيْهِ رِقَابٌ , فَسَأَلَ ابْنَاهُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَمْرٌو , وَهِشَامٌ , هَلْ لَنَا أَجْرٌ فِيمَا أَعْتَقْنَا عَنْهُ ؟ قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا","","","","","Book of Wills"
"15869","حَدَّثَنَا مَعْمَرٌ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , قَالَ : أَحْسَبُهُ عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : كَانَ عَلَى الْعَاصِ بْنِ وَائِلٍ مِائَةُ رَقَبَةٍ يَعْتِقُهَا , فَجَعَلَ عَلَى ابْنِهِ هِشَامٍ خَمْسِينَ رَقَبَةً , وَعَلَى ابْنِهِ عَمْرٍو خَمْسِينَ رَقَبَةً , فَذَكَرَ ذَلِكَ عَمْرٌو لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّهُلا يُعْتَقُ عَنْ كَافِرٍ , وَلَوْ كَانَ مُسْلِمًا فَأَعْتَقْتَ عَنْهُ , أَوْ تَصَدَّقْتَ , أَوْ حَجَجْتَ بَلَغَهُ ذَلِكَ ""","","","","","Book of Wills"
"15870","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ : أَنَّأَبَا لَهَبٍ أَعْتَقَ جَارِيَةً لَهَا ، يُقَالُ لَهَا : ثُوَيْبَةُ , وَكَانَتْ قَدْ أَرْضَعَتِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَرَأَى أَبَا لَهَبٍ بَعْضُ أَهْلِهِ فِي النَّوْمِ , فَسَأَلَهُ مَا وَجَدَ ؟ فَقَالَ : \" مَا وَجَدْتُ بَعْدَكُمْ رَاحَةً غَيْرَ أَنِّي سُقِيتُ فِي هَذِهِ مِنِي , وَأَشَارَ إِلَى النُّقْرَةِ الَّتِي تَحْتَ إِبْهَامِهِ , فِي عِتْقِي ثُوَيْبَةَ ""","","","","","Book of Wills"
"15871","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ , قَالَ : دَخَلَ عَلِيٌّ عَلَى مَوْلًى لَهُمْ فِي الْمَوْتِ , فَقَالَ : يَا عَلِيُّ ,أَلا أُوصِي ؟ فَقَالَ عَلِيٌّ : \" لا , إِنَّمَا قَالَ اللَّهُ تَبَارَكَ وَتَعَالَى :  إِنْ تَرَكَ خَيْرًا , وَلَيْسَ لَكَ كَثِيرُ مَالٍ \", قَالَ : وَكَانَ لَهُ سَبْعُمِائَةِ دِرْهَمٍ","","","","","Book of Wills"
"15872","عَنِ الثَّوْرِيِّ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ عُرْوَةَ , قَالَ : دَخَلَ عَلِيُّ بْنُ أَبِي طَالِبٍ , عَلَى رَجُلٍ مِنْ بَنِي هَاشِمٍ يَعُودُهُ , فَقَالَ :أُوصِي ؟ فَقَالَ عَلِيٌّ : \" إِنَّمَا قَالَ اللَّهُ تَبَارَكَ وَتَعَالَى :  إِنْ تَرَكَ خَيْرًا , وَإِنَّمَا تَرَكْتَ مَالا يَسِيرًا , فَدَعْهُ لِوَلَدِكِ , فَمَنَعَهُ أَنْ يُوصِيَ ""","","","","","Book of Wills"
"15873","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنَا ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ , أَنَّهُ كَانَ يَقُولُ : \"لا يَجُوزُ لِمَنْ كَانَ لَهُ مَالٌ قَلِيلٌ وَوَرَثَتْهُ كَثِيرٌ أَنْ يُوصِيَ بِثُلُثِ مَالِهِ \" , قَالَ : وَسُئِلَ ابْنُ عَبَّاسٍ عَنْ ثَمَانِمِائَةِ دِرْهَمٍ , فَقَالَ : قَلِيلٌ ذَلِكَ. فَقُلْتُ لابْنِ طَاوُسٍ : فَكَانَ سَمَّى حِينَئِذٍ شَيْئًا ؟ قَالَ : لا يَصْلُحُ ، كَانَ أَبِي يُصْلِحُ بَيْنَهُمْ","","","","","Book of Wills"
"15874","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ مَنْصُورِ بْنِ صَفِيَّةَ ، قَالَ : حَدَّثَنَا عَبْدُ اللَّهِ بْنُ عُبَيْدِ بْنِ عُمَيْرٍ ، أَنَّ عَائِشَةَ ، سُئِلَتْ عَنْرَجُلٍ مَاتَ وَلَهُ أَرْبَعُمِائَةِ دِينَارٍ , وَلَهُ عِدَّةٌ مِنَ الْوَلَدِ ، فَقَالَتْ عَائِشَةُ : \" مَا فِي هَذَا فَضْلٌ عَنْ وَلَدِهِ \". أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مَنْصُورُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أُمِّهِ ، عَنْ عَائِشَةَ ، مِثْلَ حَدِيثِ الثَّوْرِيِّ , إِلا أَنَّهُ قَالَ : فَلامَتْهُ عَائِشَةُ , وَقَالَتْ : إِنَّ ذَلِكَ لَقَلِيلٌ , أَوْ نَحْوَ ذَلِكَ","","","","","Book of Wills"
"15875","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : \"إِذَا كَانَ وَرَثَتُهُ قَلِيلٌ , وَمَالُهُ كَثِيرٌ , فَلا بَأْسَ أَنْ يَبْلُغَ الثُّلُثَ فِي وَصِيَّتِهِ ، فَإِنْ كَانَ مَالُهُ قَلِيلا , وَوَرَثَتُهُ كَثِيرًا , فَلا يَنْبَغِي لَهُ أَنْ يَبْلُغَ الثُّلُثَ ""","","","","","Book of Wills"
"15876","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عَامِرِ بْنِ سَعْدِ بْنِ أَبِي وَقَّاصٍ ، عَنْ أَبِيهِ , قَالَ : كُنْتُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي حَجَّةِ الْوَدَاعِ , فَمَرِضْتُ مَرَضًا أَشْفَى عَلَى الْمَوْتِ , قَالَ : فَعَادَنِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقُلْتُ : يَا رَسُولَ اللَّهِ , إِنَّ لِي مَالا كَثِيرًا , وَلَيْسَ يَرِثُنِي إِلا ابْنَةٌ لِي , أَفَأُوصِي بِثُلُثَيْ مَالِي ؟ قَالَ : لا , قُلْتُ : فَبِشَطْرِ مَالِي ؟ قَالَ : لا , قُلْتُ : فَبِثُلُثِ مَالِي ؟ قَالَ :\" الثُّلُثُ , وَالثُّلُثُ كَثِيرٌ , إِنَّكَ يَا سَعْدُ , أَنْ تَدَعَ وَرَثَتُكَ أَغْنِيَاءَ خَيْرٌ لَكَ مِنْ أَنْ تَدَعَهُمْ فُقَرَاءَ يَتَكَفَّفُونَ النَّاسَ , إِنَّكَ يَا سَعْدُ , لَنْ تُنْفِقَ نَفَقَةً تَبْتَغِي بِهَا وَجْهَ اللَّهِ , إِلا ازْدَدْتَ دَرَجَةً وَرِفْعَةً ، وَلَعَلَّكَ أَنْ تُخَلَّفَ حَتَّى يَنْفَعَ اللَّهُ بِكَ أَقْوَامًا وَيَضُرَّ بِكَ الآخَرِينَ ، اللَّهُمَّ أَمْضِ لأَصْحَابِي هِجْرَتَهُمْ , وَلا تَرُدَّهُمْ عَلَى أَعْقَابِهِمْ \", لَكِنِ الْبَائِسُ سَعْدُ بْنُ خَوْلَةَ , رَثَى لَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَكَانَ مَاتَ بِمَكَّةَ","","","","","Book of Wills"
"15877","عَنِ الثَّوْرِيِّ ، عَنْ سَعْدِ بْنِ إِبْرَاهِيمَ ، عَنْ عَامِرِ بْنِ سَعْدٍ ، عَنْ سَعْدٍ , قَالَ : جَاءَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَعُودُهُ وَهُوَ يَكْرَهُ أَنْ يَمُوتَ بِالأَرْضِ الَّتِي هَاجَرَ مِنْهَا , قَالَ : يَا رَسُولَ اللَّهِ , أُوصِي بِمَالِي كُلِّهِ ؟ قَالَ : لا , قَالَ : فَالشَّطْرُ ؟ قَالَ : لا , قَالَ : فَالثُّلُثُ ؟ قَالَ :\" الثُّلُثُ , وَالثُّلُثُ كَثِيرٌ , إِنَّكَ أَنْ تَدَعَ وَرَثَتَكَ أَغْنِيَاءَ بِخَيْرٍ خَيْرٌ لَكَ مِنْ أَنْ تَدَعَهُمْ عَالَةً يَتَكَفَّفُونَ النَّاسَ , مَا فِي أَيْدِيهِمْ مَهْمَا أَنْفَقْتَ مِنْ نَفَقَةٍ فَإِنَّهَا صَدَقَةٌ , حَتَّى اللُّقْمَةِ تَدْفَعُهَا إِلَى فِي امْرَأَتِكِ ""","","","","","Book of Wills"
"15878","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو بَكْرِ بْنِ حَفْصٍ , قَالَ : اشْتَكَى سَعْدُ بْنُ أَبِي وَقَّاصٍ بِمَكَّةَ , فَحَجَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَجَّةَ الْوَدَاعِ , فَجَاءَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ : يَا رَسُولَ اللَّهِ , أَتَدَعُنِي بِمَكَّةَ ؟ فَأَقَامَ عَلَيْهِ يومًا , ثُمَّ جَاءَهُ مِنَ الْغَدِ فَسَلَّمَ عَلَيْهِ , فَقَالَ : أَمَيِّتٌ أَنَا يَا نَبِيَّ اللَّهِ بِمَكَّةَ ؟ قَالَ :إِنِي لأَطْمَعُ أَنْ لا تَمُوتَ بِمَكَّةَ حَتَّى يَنْفَعَ اللَّهُ بِكَ أَقْوَامًا ، وَيَضُرُّ بِكَ آخَرِينَ , قَالَ : فَدَعَا سَعْدُ أَنْ لا يَمُوتَ بِمَكَّةَ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : اللَّهُمَّ اسْتَجِبْ دَعْوَةَ سَعْدٍ , قَالَ : فَذَلِكَ حِينَ قَالَ : يَا نَبِيَّ اللَّهِ , إِنَّهُ لَيْسَ لِي وَلَدٌ إِلا جَارِيَةً , وَأَنَا ذُو مَالٍ كَثِيرٍ , أَفَأُوصِي فِي إِخْوَانِي يَعْنِي : الْمُهَاجِرِينَ بِالثُّلُثَيْنِ ؟ قَالَ : لا , قَالَ : فَالشَّطْرُ ؟ قَالَ : لا , قَالَ : فَالثُّلُثُ ؟ قَالَ : الثُّلُثُ , وَالثُّلُثُ كَثِيرٌ","","","","","Book of Wills"
"15879","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ ، أَنَّ سَعْدَ بْنَ أَبِي وَقَّاصٍ , قَالَ : يَا رَسُولَ اللَّهِ , إِنَّلِي مَالا , وَلَيْسَ لِي وَلَدٌ إِلا جَارِيَةَ , أَفَأُوصِي بِالثُّلُثَيْنِ ؟ فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" ذَلِكَ كَثِيرٌ \" , قَالَ : فَالنَّصْفُ ؟ قَالَ : \" ذَلِكَ كَثِيرٌ \" , قَالَ : فَالثُّلُثُ ؟ قَالَ : \" فَسَكَتَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَمَضَى بِذَلِكَ الأَمْرِ ""","","","","","Book of Wills"
"15880","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ , قَالَ : \"لأَنْ أُوصِيَ بِالْخُمُسِ أَحَبُّ إِلَيَّ مَنْ أَنْ أُوصِيَ بِالرُّبُعِ ، وَأَنْ أُوصِيَ بِالرُّبُعِ , أَحَبُّ إِلَيَّ مِنْ أَنْ أُوصِي بِالثُّلُثِ ، وَمَنْ أَوْصَى بِالثُّلُثِ , فَلَمْ يَتْرُكْ شَيْئًا ""","","","","","Book of Wills"
"15881","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ قَالَ : قَالَ إِبْرَاهِيمُ : \" لأَنْأُوصِيَ بِالْخُمُسِ , أَحَبُّ إِلَيَّ مِنْ أَنْ أُوصِيَ بِالرُّبُعِ ، وَأَنْ أُوصِيَ بِالرُّبُعِ , أَحَبُّ إِلَيَّ مِنْ أَنْ أُوصِيَ بِالثُّلُثِ ، وَمَنْ أَوْصَى بِالثُّلُثِ , فَلَمْ يَتْرُكْ شَيْئًا ""","","","","","Book of Wills"
"15882","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّ أَبَا بَكْرٍ ،أَوْصَى بِالْخُمُسِ ، وَقَالَ : \" أُوصِي بِمَا رَضِيَ اللَّهُ بِهِ لِنَفْسِهِ , ثُمَّ تَلا  وَاعْلَمُوا أَنَّمَا غَنِمْتُمْ مِنْ شَيْءٍ فَأَنَّ لِلَّهِ خُمُسَهُ \" . وَأَوْصَى عُمَرُ بِالرُّبُعِ","","","","","Book of Wills"
"15883","عَنِ الثَّوْرِيِّ ، عَمَّنْ سَمِعَ الْحَسَنَ ، وَأَبَا قِلابَةَ , يَقُولانِ : \"أَوْصَى أَبُو بَكْرٍ بِالْخُمُسِ ""","","","","","Book of Wills"
"15884","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ , قَالَ : \" كَانَالْخُمُسُ أَحَبُّ إِلَيْهِمْ مِنَ الرُّبُعِ ، وَالرُّبُعُ أَحَبُّ إِلَيْهِمْ مِنَ الثُّلُثِ ""","","","","","Book of Wills"
"15885","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : \"إِذَا كَانَ وَرَثَةُ الرَّجُلِ قَلِيلا ، فَلا بَأْسَ أَنْ يَبْلُغَ الثُّلُثَ فِي وَصِيَّتِهِ ""","","","","","Book of Wills"
"15886","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : \"الثُّلُثُ وَسَطٌ لا بَخْسَ وَلا شَطَطَ ""","","","","","Book of Wills"
"15887","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"ابْتَاعُوا أَنْفُسَكُمْ مِنْ رَبِّكُمْ أَيُّهَا النَّاسُ , أَلا إِنَّهُ لَيْسَ لامْرِئٍ شَيْءٌ ، أَلا لا أَعْرِفَنَّ امْرَأً بَخِيلٍ بِحَقِّ اللَّهِ عَلَيْهِ حَتَّى إِذَا حَضَرَهُ الْمَوْتُ أَخَذَ يُدَعْدِعُ مَالَهُ هَاهُنَا وَهَهُنَا \", قَالَ : ثُمَّ يَقُولُ قَتَادَةُ : وَيْلَكَ يَا ابْنَ آدَمَ كُنْتَ بَخِيلا مُمْسِكًا , حَتَّى إِذَا حَضَرَكَ الْمَوْتُ أَخَذْتَ تُدَعْدِعُ مَالَكَ وَتُفَرِّقُهُ ، ابْنَ آدَمَ , اتَّقِ اللَّهَ ، اتَّقِ اللَّهَ ، وَلا تَجْمَعْ إِسَاءَتَيْنِ فِي مَالِكَ إِسَاءَةً فِي الْحَيَاةِ ، وَإِسَاءَةً عِنْدَ الْمَوْتِ , انْظُرْ قَرَابَتَكَ الَّذِينَ يَحْتَاجُونَ وَلا يَرِثُونَ , فَأَوْصِ لَهُمْ مِنْ مَالِكَ بِالْمَعْرُوفِ","","","","","Book of Wills"
"15888","عَنْ مَعْمَرٍ ، عَنِ ابْنِ سِيرِينَ ، عَنْ شُرَيْحٍ , قَالَ : \"الثُّلُثُ جَهْدٌ , وَهُوَ جَائِزٌ ""","","","","","Book of Wills"
"15889","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ عُبَيْدَةَ السَّلْمَانِيِّ , قَالَ : \"إِذَا مَاتَ الرَّجُلُ , وَلَيْسَ عَلَيْهِ عَقْدٌ لأَحَدٍ , وَلا عَصَبَةٌ يَرِثُونَهُ , فَإِنَّهُ يُوصِي بِمَالِهِ كُلِّهِ حَيْثُ شَاءَ ""","","","","","Book of Wills"
"15890","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ الْهَمَدَانِيِّ ، عَنْ أَبِي مَيْسَرَةَ عَمْرِو بْنِ شُرَحْبِيلَ , قَالَ : قَالَ لِي عَبْدُ اللَّهِ بْنُ مَسْعُودٍ :\" إِنَّكُمْ مِنْ أَحْرَى حَيٍّ بِالْكُوفَةِ , أَنْ يَمُوتَ أَحَدُكُمْ ، وَلا يَدَعْ عَصَبَةً ، وَلا رَحِمًا , فَمَا يَمْنَعُهُ إِذَا كَانَ كَذَلِكَ أَنْ يَضَعَ مَالَهُ فِي الْفُقَرَاءِ وَالْمَسَاكِينِ ""","","","","","Book of Wills"
"15891","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : \"رَأَتِ امْرَأَةٌ عَلَى عَهْدِ أَبِي مُوسَى الأَشْعَرِيِّ أَنَّهَا تَمُوتُ يَوْمَ كَذَا وَكَذَا , فَقَسَمَتْ مَالَهَا كُلَّهُ , ثُمَّ مَاتَتْ لِذَلِكَ الْوَقْتَ , فَجَاءَ زَوْجُهَا إِلَى الأَشْعَرِيِّ فَأَخْبَرَهُ , فَقَالَ : أَيُّ امْرَأَةٍ كَانَتِ امْرَأَتُكَ ؟ قَالَ : كَانَتَ أَحَقَّ النِّسَاءِ أَنْ تَدْخُلَ الْجَنَّةَ , إِلا الشَّهِيدَ فِي سَبِيلِ اللَّهِ , قَالَ أَبُو مُوسَى : أَفَتَأْمُرُنِي أَنْ أَرُدَّ أَمْرَ هَذِهِ ؟ فَأَجَازَهُ ""","","","","","Book of Wills"
"15892","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنِ الشَّعْبِيِّ ، عَنْ مَسْرُوقٍ , أَنَّهُ قَالَ : \"فَيمَنْ لَيْسَ لَهُ مَوْلًى عَتَاقَةً \" , قَالَ : \" يَضَعُ مَالَهُ حَيْثُ شَاءَ , فَإِنْ لَمْ يَفْعَلْ فَهُوَ فِي بَيْتِ الْمَالِ ""","","","","","Book of Wills"
"15893","عَنْ مَعْمَرٍ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، أَنَّ ابْنَ مَسْعُودٍ , قَالَ لِرَجُلٍ : \" يَا مَعْشَرَ أَهْلِ الْيَمَنِ ,مِمَّا يَمُوتُ الرَّجُلُ مِنْكُمُ الَّذِي لا يَعْلَمُ أَنَّ أَصْلَهُ مِنَ الْعَرَبِ , وَلا يَدْرِي مِمَّنْ هُوَ ، فَمَنْ كَانَ كَذَلِكَ فَحَضَرَهُ الْمَوْتُ , فَإِنَّهُ يُوصِي بِمَالِهِ كُلِّهِ حَيْثُ شَاءَ ""","","","","","Book of Wills"
"15894","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ مِنْ أَهْلِ الْجَزِيرَةِ يُقَالُ لَهُ : إِسْحَاقُ بْنُ رَاشِدٍ , قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ \" فِيالَّذِي يَتَصَدَّقُ بِمَالِهِ كُلِّهِ ، إِذَا وَضَعَ مَالَهُ فِي حَقٍّ , فَلا أَحَدَ أَحَقُّ بِمَالِهِ كُلِّهِ ، وَإِذَا أَعْطَى الْوَرَثَةَ بَعْضَهُمْ دُونَ بَعْضٍ , فَلَيْسَ لَهُ إِلا الثُّلُثُ ""","","","","","Book of Wills"
"15895","عَنْ مَعْمَرٍ ، عَنْ مَطَرٍ الْوَرَّاقِ ، عَنْ شَهْرِ بْنِ حَوْشَبٍ ، عَنْ عَمْرِو بْنِ خَارِجَةَ , قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : \"لا وَصِيَّةَ لِوَارِثٍ ""","","","","","Book of Wills"
"15896","عَنِ الثَّوْرِيِّ , عَنْرَجُلٍ كَانَ مَرِيضًا , فَقَالَ لامْرَأَةٍ : تَزَوَّجِي ابْنِي هَذَا ! وَصَدَاقُكِ عَلَيَّ أَلْفُ دِرْهَمٍ , وَصَدَاقُ مِثْلِهَا خَمْسُمِائَةِ دِرْهَمٍ ، ثُمَّ مَاتَ مِنْ مَرَضِهِ ذَلِكَ , قَالَ : \" هُوَ لَهَا فِي مَالِهِ , وَيَأْخُذُهُ الْوَرَثَةُ مِنِ ابْنِهِ , فَإِنَّمَا هُوَ كَفِيلُ ابْنِهِ أَنْ يُزَوِّجَهُ أَوَ لَمْ يَأْمُرْهُ ""","","","","","Book of Wills"
"15897","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : سَمِعْتُ عَطَاءً , يَقُولُ : \"يُعَادُ فِي كُلِّ وَصِيَّةٍ ""","","","","","Book of Wills"
"15898","حَدَّثَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : \"مِلاكُ الْوَصِيَّةِ آخِرُهَا \". قَالَ مَعْمَرٌ : وَكَانَ قَتَادَةُ , يَقُولُ : هُوَ مُخَيَّرٌ فِي وَصِيَّتِهِ فِي الْعِتْقِ ، وَغَيْرِهِ يُغَيِّرُ فِيهَا مَا شَاءَ , قَالَ مَعْمَرٌ : بَلَغَنِي أَنَّهُ ذَكَرَهُ عَنْ عَمْرِو بْنِ شُعَيْبٍ ، عَنِ الْحَارِثِ بْنِ عَبْدِ اللَّهِ ، عَنْ عُمَرَ ، حَدَّثَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، مِثْلَ قَوْلِ قَتَادَةَ ""","","","","","Book of Wills"
"15899","عَنْ مَعْمَرٍ ، عَنْ عَمْرِو بْنِ مُسْلِمٍ ، عَنْ طَاوُسٍ , قَالَ : \"يَعُودُ الرَّجُلُ فِي مُدَبَّرِهِ ""","","","","","Book of Wills"
"15900","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ : سَمِعْتُ طَاوُسًا ، وَعَطَاءً ، وَأَبَا الشَّعْثَاءِ , يَقُولُونَ \"آخِرُ عَهْدِ الرَّجُلِ أَحَقُّ مِنْ أَوَّلِهِ \" , يَقُولُونَ : \" يُغَيِّرُ الرَّجُلُ مِنْ وَصِيَّتِهِ مَا شَاءَ فِي الْعِتْقِ وَغَيْرِهِ ""","","","","","Book of Wills"
"15901","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ عَطَاءٍ ، وَطَاوُسٍ ، قَالُوا : \"يُغَيِّرُ الرَّجُلُ مِنْ وَصِيَّتِهِ مَا شَاءَ فِي الْعِتْقِ وَغَيْرِهِ ""","","","","","Book of Wills"
"15902","عَنْ مَعْمَرٍ ، عَنْ سَعِيدِ بْنِ عَبْدِ الرَّحْمَنِ الْجَحْشِيِّ ، عَنِ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، أَنَّ نَافِعَ بْنَ عَلْقَمَةَ كَتَبَ إِلَى عَبْدِ الْمَلِكِ , يَسْأَلُهُ \" عَنْرَجُلٍ أَوْصَى بِوَصِيَّةٍ فَأُعْتِقَ فِيهَا ، ثُمَّ رَجَعَ فِي وَصِيَّتِهِ مَا كَانَ حَيًّا ""","","","","","Book of Wills"
"15903","عَنْ مَعْمَرٍ ، عَنِ ابْنِ شُبْرُمَةَ ، وَغَيْرِهِ مِنْ عُلَمَاءِ الْكُوفَةِ , قَالُوا : \"كُلُّ صَاحِبِ وَصِيَّةٍ يَرْجِعُ فِيهَا مَا كَانَ حَيًّا , إِلا الْعِتَاقَةَ \". عَنِ الثَّوْرِيِّ ، عَنْ سُلَيْمَانَ الشَّيْبَانِيِّ ، عَنِ الشَّعْبِيِّ مِثْلَهُ","","","","","Book of Wills"
"15904","عَنِ الثَّوْرِيِّ ، فِي امْرَأَةٍتَرَكَتْ خَمْسَةً وَعِشْرِينَ دِرْهَمًا , وَشَاةً قِيمَتُهَا خَمْسَةُ دَرَاهِمَ , فَأَوْصَتْ لِرَجُلٍ بِالشَّاةِ , وَأَوْصَتْ لِرَجُلٍ بِسُدُسِ مَالِهَا , قَالَ بَعْضُنَا يَقُولُ : \" السُّدُسُ يَدْخُلُ عَلَى صَاحِبِ الشَّاةِ وَيَكُونُ لَهُ نِصْفُ سُدُسِ الشَّاةِ \" , وَبَعْضُنَا يَقُولُ : \" لِصَاحِبِ السُّدُسِ سَبْعُ الشَّاةِ \" , هَذَا أَمْرُ الْعَامَّةِ","","","","","Book of Wills"
"15905","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : \"يُغَيِّرُ الرَّجُلُ فِي وَصِيَّتِهِ مَا شَاءَ ، وَإِنْ كَانَ عِتْقًا ""","","","","","Book of Wills"
"15906","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيالرَّجُلِ يُوصِي بِالْوَصِيَّةِ , ثُمَّ يُوصِي بِأُخْرَى , قَالَ : \" إِنْ لَمْ يُغَيِّرْ مِنَ الأُولَى شَيْئًا , فَهُمَا جَائِزَتَانِ فِي ثُلُثِ مَالِهِ ""","","","","","Book of Wills"
"15907","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : \" إِنْأَوْصَى إِنْسَانٌ بِثُلُثِهِ ، ثُمَّ أَوْصَى بِوَصَايَا بَعْدَ ذَلِكَ , تَحَاصَّوْا فِي الثُّلُثِ ""","","","","","Book of Wills"
"15908","عَنِ الثَّوْرِيِّ ، قَالَ :إِذَا قَالَ \" عَبْدِي لِفُلانٍ \" , ثُمَّ قَالَ : \" نِصْفُ عَبْدِي لِفُلانٍ \" ، مِنَّا مَنْ يَقُولُ : \" ثَلاثَةُ أَرْبَاعٍ وَرُبُعٌ \" ، وَمِنَّا مَنْ يَقُولُ : \" ثُلُثٌ وَثُلُثَانِ ، وَأَحَبُّهُ إِلَيَّ , الثُّلُثُ وَالثُّلُثَانِ \". قَالَهُ : ابْنُ أَبِي لَيْلَى , وَالْعَامَّةُ","","","","","Book of Wills"
"15909","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ , قَالَ : \"إِنْ غَيَّرَ مِنْ وَصِيَّتِهِ شَيْئًا , فَقَدْ رَجَعَ فِيهَا كُلِّهَا \". قَالَ مَعْمَرٌ : فَسَأَلْتُ ابْنَ شُبْرُمَةَ , فَقَالَ : لا يَنْتَقِصُ مِنْهَا إِلا مَا غَيَّرَ","","","","","Book of Wills"
"15910","وَسَمِعْتُ مَعْمَرًا ، وَسُئِلَ عَنْ رَجُلٍ , قَالَ : \"ثُلُثُ مَالِي لِفُلانٍ , وَلِفُلانٍ نَفَقَتُهُ حَتَّى يَمُوتَ \" , قَالَ : \" يُوقَفُ لَهُ نِصْفُ الثُّلُثِ بِنَفَقَتِهِ ""","","","","","Book of Wills"
"15911","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ هِشَامِ بْنِ حُجَيْرٍ ، عَنْ طَاوُسٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَثَلُ الَّذِي يُعْطِي مَالَهُ كُلَّهُ ، ثُمَّ يَقْعُدُ , كَأَنَّهُ وَرِثَ كَلالَةً ""","","","","","Book of Wills"
"15912","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ كَعْبِ بْنِ مَالِكٍ ، عَنْ أَبِيهِ ، أَنَّهُ لَمَّا تَابَ اللَّهُ عَلَيْهِ , قَالَ : يَا نَبِيَّ اللَّهِ , إِنَّ مِنْ تَوْبَتِي أَنْ لا أُحَدِّثَ إِلا صِدْقًا , وَأَنْ أَنْخَلِعَ مِنْ مَالِي كُلِّهِ صَدَقَةً إِلَى اللَّهِ وَإِلَى رَسُولِهِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"أَمْسِكْ عَلَيْكَ بَعْضَ مَالِكَ فَهُوَ خَيْرٌ لَكَ \", قَالَ : فَإِنِّي أُمْسِكُ سَهْمِي الَّذِي بِخَيْبَرَ . عَنِ ابْنِ جُرَيْجٍ ، عَنِ الزُّهْرِيِّ نَحْوَهُ","","","","","Book of Wills"
"15913","عَنِ ابْنِ جُرَيْجٍ ، وَمَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنَّ أَبَا لُبَابَةَ لَمَّا تَابَ اللَّهُ عَلَيْهِ , قَالَ : يَا نَبِيَّ اللَّهِ ، إِنَّمِنْ تَوْبَتِي أَنْ أَهْجُرَ دَارَ قَوْمِي الَّتِي أَصَبْتُ فِيهَا الذَّنْبَ , حَسِبْتُ أَنَّهُ قَالَ : أُجَاوِرُكَ وَأَنْخَلِعُ مِنْ مَالِي صَدَقَةً إِلَى اللَّهِ وَإِلَى رَسُولِهِ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" يُجْزِئُكَ مِنْ ذَلِكَ الثُّلُثُ يَا أَبَا لُبَابَةَ ""","","","","","Book of Wills"
"15914","عَنْ مَعْمَرٍ , قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ فِيالرَّجُلِ يَتَصَدَّقُ بِمَالِهِ كُلِّهِ , قَالَ : \" إِذَا وَضَعَ مَالَهُ فِي حَقٍّ فَلا أَحَدَ أَحَقُّ بِمَالِهِ مِنْهُ ، وَإِذَا أَعْطَى الْوَرَثَةَ بَعْضَهُمْ دُونَ بَعْضٍ فَلَيْسَ لَهُ إِلا الثُّلُثَ \", ذَكَرَهُ عَنِ الزُّهْرِيِّ","","","","","Book of Wills"
"15915","عَنِ ابْنِ جُرَيْجٍ , قَالَ : \" زَعِمَ ابْنُ شِهَابٍ أَنَّهَاكَانَتْ مِنْ أَبِي لُبَابَةَ ذُنُوبٌ كَثِيرَةٌ ""","","","","","Book of Wills"
"15916","عَنِ ابْنِ جُرَيْجٍ , قَالَ : ، قُلْتُ لِعَطَاءٍ : \"الرَّجُلُ غَيْرُ السَّفِيهِ يُعْطِي مَالَهُ كُلَّهُ فِي حَقِّ الْحُورِ , وَكَذَلِكَ قَالَ : \" لا يُنْهَى عَنِ الْحَرَائِحِ ، وَلَكِنِ الثُّلُثُ ""","","","","","Book of Wills"
"15917","عَنْ مَعْمَرٍ , قَالَ : \"إِذَا حَضَرَ الْقِتَالُ , وَوَقَعَ الطَّاعُونُ , وَرُكِبَ الْبَحْرُ , لَمْ يَجُزْ إِلا الثُّلُثُ ، وَإِنْ عَاشَ وَكَانَ قَدْ أَعْتَقَ جَازَ عِتْقُهُ ""","","","","","Book of Wills"
"15918","حَدَّثَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، يَبْلُغُ بِهِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \"مَثَلُ الَّذِي يُعْطِي مَالَهُ كُلَّهُ ، ثُمَّ يَقْعُدُ , كَأَنَّهُ وَرِثَ كَلالَةً ""","","","","","Book of Wills"
"15919","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ :\" الصَّدَقَةُ عَنْ ظَهْرِ غِنًى , وَابْدَأْ بِمَنْ تَعُولُ , وَالْيَدُ الْعُلْيَا خَيْرٌ مِنَ الْيَدِ السُّفْلَى \", قَالَ : قُلْتُ : مَا قَوْلُهُ عَنْ ظَهْرِ غِنًى ؟ قَالَ : \" لا تُعْطِي الَّذِي لَكَ وَتَجْلِسُ تَسْأَلُ النَّاسَ ""","","","","","Book of Wills"
"15920","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"خَيْرُ الصَّدَقَةِ مَا كَانَ عَنْ ظَهْرِ غِنًى ، وَابْدَأْ بِمَنْ تَعُولُ , وَالْيَدُ الْعُلْيَا خَيْرٌ مِنَ الْيَدِ السُّفْلَى \". قَالَ : قُلْتُ لأَيُّوبَ : مَا عَنْ ظَهْرِ غِنًى ؟ قَالَ : عَنْ فَضْلِ عِيَالِكَ , عَنْ مَعْمَرٍ ، عَنْ هَمَّامٍ ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ يُحَدِّثُ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَ حَدِيثِ أَيُّوبَ","","","","","Book of Wills"
"15921","عَنْ مَعْمَرٍ ، عَنْ سِمَاكِ بْنِ الْفَضْلِ ، عَنْ عُرْوَةَ بْنِ مُحَمَّدٍ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ , قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : \"الْيَدُ الْمُعْطِيَةُ خَيْرٌ مِنَ الْيَدِ السُّفْلَى ""","","","","","Book of Wills"
"15922","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ , قَالَ : أَعْطَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَكِيمَ بْنَ حِزَامٍ يَوْمَ حُنَيْنٍ عَطَاءً , فَاسْتَقَلَّهُ فَزَادَهُ , فَقَالَ : يَا رَسُولَ اللَّهِ , أَيُّ أُعْطِيَتِكَ خَيْرٌ ؟ قَالَ : الأُولَى , قَالَ : فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" يَا حَكِيمُ بْنَ حِزَامٍ , إِنَّهَذَا الْمَالَ خَضِرَةٌ حُلْوَةٌ , فَمَنْ أَخَذَهُ بِسَخَاوَةِ نَفْسٍ وَحُسْنِ أَكْلَةٍ بُورِكَ لَهُ فِيهِ ، وَمَنْ أَخَذَهُ بِاسْتِشْرَافِ نَفْسٍ ، وَسُوءِ أَكْلَةٍ , لَمْ يُبَارِكْ لَهُ فِيهِ ، وَكَانَ كَالَّذِي يَأْكُلُ وَلَمْ يَشْبَعْ , وَالْيَدُ الْعُلْيَا خَيْرٌ مِنَ الْيَدِ السُّفْلَى \" , قَالَ : وَمِنْكَ يَا رَسُولَ اللَّهِ ؟ قَالَ : \" وَمِنِّي \" , قَالَ : فَوَالَّذِي بَعَثَكَ بِالْحَقِّ لا أَرْزَأُ بَعْدَكَ أَحَدًا شَيْئًا أَبَدًا , قَالَ : \" فَلَمْ يَقْبَلُ دُيوَانًا , وَلا عَطَاءً حَتَّى مَاتَ \". قَالَ : وَكَانَ عُمَرُ بْنُ الْخَطَّابِ , يَقُولُ : اللَّهُمَّ إِنِّي أُشْهِدُكَ عَلَى حَكِيمِ بْنِ حِزَامٍ , أَنِّي أَدْعُوهُ لِحَقِّهِ مِنْ هَذَا الْمَالِ وَهُوَ يَأْبَى , فَقَالَ : إِنِّي وَاللَّهِ لا أَرْزَؤُكَ وَلا غَيْرَكَ شَيْئًا","","","","","Book of Wills"
"15923","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَا يَمْنَعُ أَحَدَكُمْ أَنْ يَكُونَ كَأَبِي فُلانٍ كَانَ إِذَا خَرَجَ , قَالَ : اللَّهُمَّ إِنِي قَدْ تَصَدَّقْتُ بِعِرْضِي عَلَى عِبَادِكَ فَإِنْ شَتَمَهُ أَحَدٌ لَمْ يَشْتِمْهُ ""","","","","","Book of Wills"
"15924","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ : أَنَّ عَمْرَو بْنَ سُلَيْمٍ الْغَسَّانِيَّ \"أَوْصَى وَهُوَ ابْنُ عَشْرٍ , أَوْ ثِنْتَيْ عَشْرَةَ , بِبِئْرٍ لَهُ قُوِّمَتْ بِثَلاثِينَ أَلْفًا , فَأَجَازَ عُمَرُ بْنُ الْخَطَّابِ وَصِيَّتَهُ ""","","","","","Book of Wills"
"15925","عَنِ ابْنِ عُيَيْنَةَ , قَالَ : حَدَّثَنَا ابْنُ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، أَنَّ عَمْرَو بْنَ سُلَيْمٍ الْغَسَّانِيَّ قَالَ : بَلَغَ عُمَرَ أَنَّ غُلامًا مِنْ غَسَّانَ يَمُوتُ , فَقَالَ : \"مُرُوهُ فَلْيُوصِ , فَأَوْصَى بِبِئْرِ جُشَمٍ , فَبِيعَتْ بِثَلاثِينَ أَلْفًا , وَهُوَ ابْنُ عَشْرِ سِنِينَ , أَوْ ثِنْتَيْ عَشْرَةَ , وَقَدْ قَارَبَ ""","","","","","Book of Wills"
"15926","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرِ بْنِ عَمْرِو بْنِ حَزْمٍ ، عَنْ أَبِيهِ , قَالَ : \"أَوْصَى غُلامٌ مِنَّا لَمْ يَحْتَلِمْ لِعَمَّةٍ لَهُ بِالشَّامِ بِمَالٍ كَثِيرٍ , قِيمَتُهُ ثَلاثُونَ أَلْفًا , فَرَفَعَ أَبُو إِسْحَاقَ ذَلِكَ إِلَى عُمَرَ بْنِ الْخَطَّابِ فَأَجَازَ وَصِيَّتِهِ ""","","","","","Book of Wills"
"15927","حَدَّثَنَا مَعْمَرٌ ، عَنْ أَبِي إِسْحَاقَ , قَالَ : \"خَاصَمْتُ إِلَى شُرَيْحٍ فِي صَبِيٍّ أَوْصَى لِظِئْرٍ لَهُ بِأَرْبَعِينَ دِرْهَمًا , فَأَجَازَهُ شُرَيْحٌ ""","","","","","Book of Wills"
"15928","حَدَّثَنَا الثَّوْرِيُّ ، عَنْ أَبِي إِسْحَاقَ , قَالَ : \"أَوْصَى غُلامٌ مِنَّا يُقَالُ لَهُ : مَرْثَدٌ , حِينَ أَثغر , لِظِئْرٍ لَهُ مِنْ أَهْلِ الْحِيرَةِ , فَأَجَازَ شُرَيْحٌ وَصِيَّتَهُ \" , وَقَالَ : \" إِذَا أَصَابَ الصَّغِيرُ الْحَقَّ أَجَزْنَاهُ ""","","","","","Book of Wills"
"15929","عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، عَنْ شُرَيْحٍ , قَالَ : \"مَنْ أَصَابَ الْحَقَّ مِنْ صَغِيرٍ أَوْ كَبِيرٍ أَجَزْنَاهُ ، وَمَنْ أَخْطَأَ الْحَقَّ مِنْ صَغِيرٍ أَوْ كَبِيرٍ رَدَدْنَاهُ ""","","","","","Book of Wills"
"15930","حَدَّثَنَا مَعْمَرٌ ، وَالثَّوْرِيُّ , عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : أُتِيَ عَبْدُ اللَّهِ بْنُ عُتْبَةَ , فِي جَارِيَةٍ أَوْصَتْ , فَجَعَلُوا يُصَغَّرُونَهَا , فَقَالَ عَبْدُ اللَّهِ بْنُ عُتْبَةَ : \"مَنْ أَصَابَ الْحَقَّ أَجَزْنَا وَصِيَّتَهُ ""","","","","","Book of Wills"
"15931","حَدَّثَنَا مَعْمَرٌ ، عَنْ سِمَاكِ بْنِ الْفَضْلِ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ ، كَانَ يَقُولُ فِيالْغُلامِ الَّذِي لَمْ يَبْلُغِ الْحُلَمَ : \" لا أَرَى أَنْ يَبْلُغَ ثُلُثَ مَالِهِ كُلِّهِ فِي وَصِيَّتِهِ \" , قَالَ : \" وَيَجُوزُ لَهُ قَرِيبٌ مِنْ ذَلِكَ ""","","","","","Book of Wills"
"15932","حَدَّثَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ , قَالَ : \"وَصِيَّةُ الْغُلامِ جَائِزَةٌ إِذَا عَقِلَ ""","","","","","Book of Wills"
"15933","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \"هَلْ تَعْلَمُ 000 إِذَا بَلَغَهُ الصَّغِيرُ وَالصَّغِيرَةُ جَازَتْ وَصِيَّتُهُمَا ؟ قَالَ \" مَا أَعْلَمُهُ ""","","","","","Book of Wills"
"15934","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي سُلَيْمَانُ بْنُ مُوسَى ، أَنَّ عَبْدَ الْمَلِكِ ، قَضَى فِي غُلامٍ مِنْ أَهْلِ دِمَشْقَ أَوْصَى ، فَقَالَ : \"إِذَا بَلَغَ ثِنْتَيْ عَشْرَةَ سَنَةً جَازَتْ وَصِيَّتُهُ \", قَالَ : فَلَمْ يَزَلْ يَعْمَلْ بِذَلِكَ وَيَقْضِي بِهِ حَتَّى كَانَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ فَخَشَيْنَا أَنْ يَرُدَّهُ , فَقَضَى بِهِ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ أَيْضًا فَلَمْ يَزَلْ عَلَيْهِ بَعْدُ , قَالَ : وَلا نَعْلَمُ أَحَدًا قَضَى بِهِ قَبْلَ عَبْدِ الْمَلِكِ","","","","","Book of Wills"
"15935","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : \"إِذَا وَضَعَ الْغُلامُ الْوَصِيَّةَ مَوْضِعَهَا جَازَتْ ""","","","","","Book of Wills"
"15936","عَنْ إِبْرَاهِيمَ بْنِ أَبِي يَحْيَى ، عَنِ الْحَجَّاجِ بْنِ أَرْطَاةَ ، عَنْ عَطَاءٍ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : \"لا تَجُوزُ وَصِيَّةُ الْغُلامِ حَتَّى يَحْتَلِمَ ""","","","","","Book of Wills"
"15937","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :الأَحْمَقُ كَهَيْئَتِهِ , قَالَ : وَالْمُوَسْوِسُ أَتَجُوزُ وَصِيَّتُهُمَا ؟ وَإِنْ أَوْصِيَا وَهُمَا مَغْلُوبَانِ عَلَى عَقْلِهِمَا ؟ قَالَ : \" مَا أَحْسِبُ لَهُمَا وَصِيَّةً \", وَقَالَهَا : عَمْرُو بْنُ دِينَارٍ","","","","","Book of Wills"
"15938","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ , قَالَ : \"لا تَجُوزُ وَصِيَّةُ الْغُلامِ حَتَّى يَحْتِلَمَ ""","","","","","Book of Wills"
"15939","أَخْبَرَنَا هُشَيْمٌ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"لا تَجُوزُ وَصِيَّةٌ ، وَلا عَطِيَّةٌ ، وَلا هِبَةٌ ، وَلا عَتَاقَةٌ , حَتَّى يَحْتَلِمَ ، وَالْجَارِيَةُ حَتَّى تَحِيضَ ""","","","","","Book of Wills"
"15940","وَذَكَرَ الثَّوْرِيُّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"لا تَجُوزُ وَصِيَّةُ الْغُلامِ حَتَّى يَحْتَلِمَ ""","","","","","Book of Wills"
"15941","أَخْبَرَنَا هِشَامٌ ، عَنِ الْحَسَنِ ، وَالأَوْزَاعِيُّ ، عَنْ وَاصِلٍ ، عَنْ مُجَاهِدٍ , قَالَ : \"لا تَجُوزُ وَصِيَّةُ الْغُلامِ حَتَّى يَحْتَلِمَ ""","","","","","Book of Wills"
"15942","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : \"مَنْ أَوْصَى لِقَوْمٍ وَسَمَّاهُمْ , وَتَرَكَ ذَوِي قَرَابَتِهِ مُحْتَاجِينَ , انْتُزِعَتْ مِنْهُمْ وَرُدَّتْ عَلَى ذَوِي قَرَابَتِهِ , فَإِنْ لَمْ يَكُنْ فِي أَهْلِهِ فُقَرَاءُ , فَلأَهْلِ الْفُقَرَاءِ مَنْ كَانُوا ، وَإِنْ أَوْصَى 000 الَّذِي وَصَّى لَهُمْ بِهَا \". عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، بِمِثْلَهُ","","","","","Book of Wills"
"15943","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : \"إِذَا أَوْصَى لِمَسَاكِينَ بُدِئَ بِمَسَاكِينَ ذِي قَرَابَتِهِ , فَإِنْ أَوْصَى لِقَوْمٍ وَسَمَّاهُمْ , أَعْطَيْنَا مَنْ سَمَّى لَهُ \". عَنْ مَعْمَرٍ ، وَقَالَهُ قَتَادَةُ ، عَنِ ابْنِ الْمُسَيِّبِ ، مِثْلَ قَوْلِ الزُّهْرِيِّ","","","","","Book of Wills"
"15944","عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ عُبَيْدِ اللَّهِ بْنِ يَعْمُرَ ،قَاضٍ كَانَ لأَهْلِ الْبَصْرَةِ , قَالَ : \" مَنْ أَوْصَى فَسَمَّى أَعْطَيْنَا مَنْ سَمَّى \" , وَإِنْ قَالَ : \" يَضَعُهَا حَيْثُ أَمَرَ اللَّهُ أَعْطَيْنَا قَرَابَتَهُ ""","","","","","Book of Wills"
"15945","عَنْ مَعْمَرٍ ، عَمَّنْ سَمِعَ الْحَسَنَ , يَقُولُ : \"مَنْ أَوْصَى بِثُلُثِهِ , وَلَهُ ذَوُو قَرَابَةٍ مُحْتَاجُونَ , أُعْطُوا ثُلُثَ الثُّلُثِ ""","","","","","Book of Wills"
"15946","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلَ سُلَيْمَانُ بْنُ مُوسَى , عَطَاءً وَأَنَا أَسْمَعُ ، عَنْرَجُلٍ أَوْصَى لِمَوْلاةٍ لَهُ , فَقَالَ : هِيَ وَارِثٌ , قَالَ عَطَاءٌ : \" لا تَكُونُ وَارِثًا , إِنَّمَا الْوَارِثُ مَنْ جَعَلَ اللَّهُ لَهُ مِيرَاثًا ، وَلَكِنْ يُجْعَلُ لَهَا مِنْهُ سَهْمُ امْرَأَةٍ ، فَإِنْ كَانَ سَهْمُ تِلْكَ الْمَرْأَةِ أَكْثَرَ مِنَ الثُّلُثِ , رَجَعَتْ إِلَى الثُّلُثِ ، وَإِنْ كَانَ الْمَيِّتُ قَدْ أَوْصَى فِي ثُلُثِهِ بِشَيْءٍ حُوِّصَتْ \" , قَالَ : \" فَإِنْ أَوْصَى إِنْسَانٌ لِمَوْلاةٍ سَهْمًا مِنْ مِيرَاثِهِ ، وَالْمَالُ عَلَى ثَمَانِيَةِ أَسْهُمٍ فَإِنَّ لَهَا مِثْلَ سَهْمِ رَجُلٍ ، وَصِيَّةً مِثْلَ هَذِهِ الْوَصِيَّةِ الأُخْرَى ""","","","","","Book of Wills"
"15947","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ , قَالَ : \"إِذَا أَوْصَى فِي غَيْرِ أَقَارِبِهِ بِالثُّلُثِ , جَازَ لَهُمْ ثُلُثُ الثُّلُثِ , وَرَدَّ عَلَى قَرَابَتِهِ ثُلُثَا الثُّلُثِ ""","","","","","Book of Wills"
"15948","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : \"مَنْ أَوْصَى فَسَمَّى أَعْطَيْنَا مَنْ سَمَّى ""","","","","","Book of Wills"
"15949","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :الْوَصِيَّةُ أَوْصَى إِنْسَانٌ فِي أَمْرٍ ، فَرَأَيْتُ غَيْرَهُ خَيْرًا مِنْهُ , قَالَ : \" فَافْعَلِ الَّذِي هُوَ خَيْرٌ مَا لَمْ يُسَمِّ إِنْسَانًا بِاسْمِهِ ، وَإِنْ قَالَ لِلْمَسَاكِينِ , وَفِي سَبِيلِ اللَّهِ , فَرَأَيْتَ خَيْرًا مِنْ ذَلِكَ فَافْعَلِ الَّذِي هُوَ خَيْرٌ \"، ثُمَّ رَجَعَ عَنْ ذَلِكَ فَقَالَ : لَيُنَفَّذْ قَوْلُهُ , قَالَ : وَقَوْلُهُ الأَوَّلُ أَعْجَبُ إِلَيَّ","","","","","Book of Wills"
"15950","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ : \"لا وَصِيَّةَ لِمَيِّتٍ ""","","","","","Book of Wills"
"15951","عَنِ الثَّوْرِيِّ ، قَالَ : يَقُولُونَ : \"إِذَا أَوْصَى أَنْ يُقْضَى عَنْ فُلانٍ دِينُهُ , وَقَدْ كَانَ مَاتَ , فَهُوَ جَائِزٌ , لأَنَّهُ أَوْصَى لِلْغُرَمَاءِ ""","","","","","Book of Wills"
"15952","عَنِ الثَّوْرِيِّ , قَالَ : \"لَيْسَ لِقَاتِلٍ وَصِيَّةٌ \" , فَقَالَ : \" إِذَا قُتِلَ الْقَاتِلُ فَلَيْسَتْ لَهُ وَصِيَّةٌ , وَإِذَا أَوْصَى أَنْ يُعْفَى عَنْهُ كَانَ الثُّلُثُ لِلْعَاقِلَةِ , وَغُرِّمَ الثُّلُثَيْنِ ""","","","","","Book of Wills"
"15953","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيرَجُلٍ أَوْصَى لِرَجُلٍ بِوَصِيَّةٍ , أَوْ وَهَبَ لَهُ هِبَةً , وَهُوَ غَائِبٌ , فَمَاتَ الْمُوصَى لَهُ أَوِ الْمَوْهُوبُ لَهُ , قَبْلَ الَّذِي أَوْصَى لَهُ , قَالَ : \" لَيْسَ لَهُ وَلا لِوَرَثَتِهِ شَيْءٌ \", قَالَ مَعْمَرٌ : وَسَمِعْتُ عُثْمَانَ الْبَتِّيَّ يَقُولُ مِثْلَ ذَلِكَ , عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، مِثْلَ قَوْلِ الزُّهْرِيِّ","","","","","Book of Wills"
"15954","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , فِيرَجُلٍ بَعَثَ بِهَدِيَّةٍ مَعَ رَجُلٍ إِلَى آخَرَ , فَهَلَكَ الْمُهْدِي قَبْلَ أَنْ يَصِلَ لِلَّذِي أُهْدِيَتْ لَهُ , قَالَ : \" فَهِيَ لِوَرَثَةِ الَّذِي أَهْدَاهَا , إِلا أَنْ يَدْفَعَهَا إِلَى وَصِيٍّ أَوْ جَرِيٍّ ""","","","","","Book of Wills"
"15955","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ فُضَيْلٍ ، عَنْ أَبِي حَرِيزٍ ، عَنِ الشَّعْبِيِّ ، أَنَّ رَجُلا أَهْدَى لِرَجُلٍ , فَمَاتَ قَبْلَ أَنْ يَصِلَ إِلَيْهِ , فَأَرْسَلَ إِلَى عُبَيْدَةَ السَّلْمَانِيِّ , فَقَالَ : \"إِنْ كَانَ أَهْدَاهَا إِلَى الرَّجُلِ قَبْلَ أَنْ يَمُوتَ , فَالْهَدِيَّةُ لِوَرَثَةِ الْمَيِّتِ ، وَإِنْ كَانَ أَهْدَاهَا إِلَيْهِ وَقَدْ مَاتَ , فَالْهَدِيَّةُ تَرْجِعُ إِلَى الْحَيِّ فَإِنَّ الْحَيَّ لا يَهْدِي إِلَى الْمَيِّتِ ""","","","","","Book of Wills"
"15956","عَنْ عَبْدِ اللَّهِ بْنِ كَثِيرٍ ، عَنْ شُعْبَةَ , قَالَ : سَأَلْتُ الْحَكَمَ بْنَ عُتَيْبَةَ , قَالَ : \"إِذَا أَرْسَلَ بِهَا مَعَ رَسُولِ الْمَيِّتِ , فَهِيَ لِرَسُولِ الْمَيِّتِ ، وَإِنْ كَانَ مَعَ رَسُولِ الَّذِي أَهْدَاهَا , فَهِيَ لِلَّذِي أَهْدَاهَا ""","","","","","Book of Wills"
"15957","عَنِ ابْنِ جُرَيْجٍ , قَالَ : ، قُلْتُ لِعَطَاءٍ :الرَّجُلُ يُوصِي لِلرَّجُلِ فَيَمُوتُ الَّذِي أَوْصَى لَهُ , فَيَعْلَمُ ذَلِكَ الْمُوصِي بِمَوْتِهِ , فَلا يُحَدِّثُ فِيمَا أَوْصَى لَهُ بِهِ شَيْئًا , قَالَ : ثُمَّ يَمُوتُ الْمُوصِي , قَالَ : \" فَالْوَصِيَّةُ لأَهْلِ الْمُوصَى لَهُ \" ، قُلْتُ 000 يُعْلِمُونَهُ ؟ قَالَ : \" لا ""","","","","","Book of Wills"
"15958","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ : \"مَا صَنَعَتِ الْحَامِلُ فِي حَمْلِهَا فَهُوَ وَصِيَّةٌ \" , قُلْتُ : أَرَأْيٌ ؟ قَالَ : بَلْ سَمِعْنَاهُ ، قَالَ عَطَاءٌ : \" هِيَ وَالْمُرْضِعُ تُفْطِرَانِ فِي شَهْرِ رَمَضَانَ إِنْ خَافَتَا عَلَى أَوْلادِهِمَا ""","","","","","Book of Wills"
"15959","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : \"مَا صَنَعِتِ الْحَامِلُ فِي حَمْلِهَا فَهُوَ وَصِيَّةٌ \", قَالَ مَعْمَرٌ : وَأَخْبَرَنِي مَنْ سَمِعَ عِكْرِمَةَ , يَقُولُ مِثْلَ ذَلِكَ","","","","","Book of Wills"
"15960","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، عَنْ شُرَيْحٍ \" أَنَّهُ كَانَ يَرَىمَا صَنَعَتِ الْحَامِلُ فِي حَمْلِهَا وَصِيَّةً مِنَ الثُّلُثِ \". قَالَ الثَّوْرِيُّ : وَنَحْنُ لا نَأْخُذُ بِذَلِكَ , نَقُولُ : مَا صَنَعَتِ فَهُوَ جَائِزٌ , إِلا أَنْ تَكُونَ مَرِيضَةً مَرَضًا مِنْ غَيْرِ الْحَمْلِ , أَوْ يَدْنُو مَخَاضُهَا","","","","","Book of Wills"
"15961","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، فِيالْحَامِلِ , قَالَ : \" إِذَا أَوْصَتْ فَهُوَ فِي الثُّلُثِ ""","","","","","Book of Wills"
"15962","أَخْبَرَنَا مَعْمَرٌ ، عَنْ دَاوُدَ بْنِ أَبِي هِنْدَ ، عَنِ الشَّعْبِيِّ ، عَنْ شُرَيْحٍ ، أَنَّهُ قَالَ فِيالرَّجُلِ يَسْتَأْذِنُ وَرَثَتَهُ عِنْدَ مَوْتِهِ فِي الْوَصِيَّةِ فَيَأْذَنُونَ لَهُ , قَالَ : \" هُمْ بِالْخِيَارِ إِذَا نَفَضُوا أَيْدِيَهُمْ مِنْ قَبْرِهِ ""","","","","","Book of Wills"
"15963","عَنْ مَعْمَرٍ ، وَابْنِ جُرَيْجٍ , عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : \"هُمْ بِالْخِيَارِ إِذَا رَجَعُوا ""","","","","","Book of Wills"
"15964","عَنِ ابْنِ جُرَيْجٍ ، أَنَّ عَطَاءً ، كَانَ يَقُولُ : \"جَازَتْ إِذَا أَذِنُوا ""","","","","","Book of Wills"
"15965","عَنْ مَعْمَرٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ , قَالَ : \"إِذَا أَذِنُوا فَقَدْ جَازَ عَلَيْهِمْ ""","","","","","Book of Wills"
"15966","عَنْ سُفْيَانَ , قَالَ : \"إِذَا أَوْصَى الْمَيِّتُ لِوَارِثٍ , فَطَيَّبَ ذَلِكَ الْوَرَثَةُ فِي حَيَاتِهِ , فَهُمْ بِالْخِيَارِ ، إِذَا مَاتَ إِنْ شَاءُوا رَجَعُوا , لأَنَّهُمْ أَجَازُوا لِمَا لَمْ يَقَعْ لَهُمْ وَلَمْ يَمْلِكُوهُ إِنَّمَا مَلَكُوهُ بَعْدَ الْمَوْتِ ، فَإِذَا أَجَازُوا بَعْدَ مَوْتِهِ فَهُوَ جَائِزٌ ، وَلَيْسَ لَهُمْ أَنْ يَرُدُّوهُ قُبِضَ أَوْ لَمْ يُقْبَضْ ""","","","","","Book of Wills"
"15967","وَسَأَلْتُ حَمَّادَ بْنَ أَبِي حَنِيفَةَ , قُلْتُ : كَيْفَ كَانَ أَبُوكَ يَقُولُ فِيالرَّجُلِ يُوصِي لِبَعْضِ وَرَثَتِهِ ؟ فَيَقُولُ : \" إِنْ أَجَازَهُ الْوَرَثَةُ ، وَإِلا فَهُوَ لِفُلانٍ , أَوْ لِلْمَسَاكِينِ \", قَالَ : كَانَ يَرَاهُ جَائِزًا , وَيَقُولُ : قَالَهُ رَجُلٌ مِنَ الْفُقَهَاءِ فَحَدَّثُ بِهِ مَعْمَرٌ , قَالَ : جَائِزٌ عَلَى مَا قَالَ","","","","","Book of Wills"
"15968","عَنْ مَعْمَرٍ ، عَنْ أَشْعَثَ بْنِ عَبْدِ اللَّهِ ، عَنْ شَهْرِ بْنِ حَوْشَبٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّالرَّجُلَ لَيَعْمَلُ بِعَمَلِ الْخَيْرِ سَبْعِينَ سَنَةً ، فَإِذَا أَوْصَى حَافَ فِي وَصِيَّتِهِ , فَيُخْتَمُ لَهُ بِسُوءِ عَمَلِهِ فَيَدْخُلُ النَّارَ ، وَإِنَّ الرَّجُلَ لَيَعْمَلُ بِعَمَلِ الشَّرِّ سَبْعِينَ سَنَةً , فَيَعْدِلُ فِي وَصِيَّتِهِ , فَيُخْتَمُ لَهُ بِخَيْرِ عَمَلِهِ فَيَدْخُلُ الْجَنَّةَ \", قَالَ : ثُمَّ يَقُولُ أَبُو هُرَيْرَةَ : وَاقْرَءُوا إِنْ شِئْتُمْ  تِلْكَ حُدُودُ اللَّهِ  إِلَى وَلَهُ عَذَابٌ مُهِينٌ سورة النساء آية 13ـ14 ","","","","","Book of Wills"
"15969","عَنِ الثَّوْرِيِّ ، عَنْ دَاوُدَ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : \"الضِّرَارُ فِي الْوَصِيَّةِ مِنَ الْكَبَائِرِ , ثُمَّ قَالَ :  وَتِلْكَ حُدُودُ اللَّهِ وَمَنْ يَتَعَدَّ حُدُودَ اللَّهِ ","","","","","Book of Wills"
"15970","عَنِ الثَّوْرِيِّ , فِي قَوْلِهِ : \" فَمَنْ بَدَّلَهُ بَعْدَمَا سَمِعَهُ ، قَالَ : بَلَغَنَا أَنَّ الرَّجُلَ إِذَا أَوْصَى , لَمْ يُغَيِّرْ وَصِيَّتَهُ , حَتَّى نَزَلَتْ  فَمَنْ خَافَ مِنْ مُوصٍ جَنَفًا أَوْ إِثْمًا فَأَصْلَحَ بَيْنَهُمْ فَلا إِثْمَ عَلَيْهِ , فَرَدَّهُ إِلَى الْحَقِّ ""","","","","","Book of Wills"
"15971","عَنِ الثَّوْرِيِّ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ , قَالَ : \"أَوْصَى عُمَرُ بْنُ الْخَطَّابِ لأُمَّهَاتِ أَوْلادِهِ ""","","","","","Book of Wills"
"15972","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِي \" أَنَّهُأَوْصَى لأُمِّ وَلَدِهِ ""","","","","","Book of Wills"
"15973","عَنِ ابْنِ التَّيْمِي ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ , قَالَ : \"إِذَا أَعْطَى الرَّجُلُ أُمَّ وَلَدِهِ شَيْئًا , فَمَاتَ فَهُوَ لَهَا \", وَأَخْبَرَنِي إِيَّاي عَبْدُ اللَّهِ , عَنْ شُعْبَةَ , عَنِ الْحَكَمِ , عَنْ إِبْرَاهِيمَ , مِثْلَ ذَلِكَ","","","","","Book of Wills"
"15974","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيرَجُلٍ أَوْصَى لأُمَّهَاتِ أَوْلادِهِ بِأَرْضٍ يَأْكُلْنَهَا مَا لَمْ يُنْكَحْنَ , فَإِذَا نُكِحْنَ فَهِيَ رَدٌّ عَلَى الْوَرَثَةِ , قَالَ : \" تَجُوزُ وَصِيَّتُهُ عَلَى شَرْطِهِ ""","","","","","Book of Wills"
"15975","عَنِ الثَّوْرِيِّ , قَالَ : \"لَوْ أَنَّ إِنْسَانًا ، أَوْصَى لأُمَّهِ , وَهِيَ أُمُّ وَلَدٍ لأَبِيهِ , أَوْ لأُمِّ وَلَدِ ابْنِهِ بِوَصِيَّةٍ , لَمْ يَجُزْ , لأَنَّهَا مَمْلُوكَةٌ لابْنِهِ , وَالْمِيرَاثُ يَرْجَعُ لِلْوَارِثِ ""","","","","","Book of Wills"
"15976","عَنِ الثَّوْرِيِّ , قَالَ : \"إِذَا أَوْصَى رَجُلٌ لِعَبْدِهِ ثُلُثَ مَالِهِ , أَوْ رُبُعُ مَالِهِ ، فَالْعَبْدُ مِنَ الثُّلُثِ يُعْتَقُ ، وَإِذَا أَوْصَى لَهُ بِدَرَاهِمَ مُسَمَّاةٍ لَمْ يَجُزْ ""","","","","","Book of Wills"
"15977","وَسَمِعْتُ رَجُلا يُحَدِّثُ , عَنِ الْحَسَنِ ، أَنَّهُ قَالَ : \"إِذَا أَوْصَى لِعَبْدِ غَيْرِهِ فَهُوَ جَائِزٌ ""","","","","","Book of Wills"
"15978","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ شَبِيبِ بْنِ غَرْقَدَةَ ، عَنْ جُنْدَبٍ , قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍأَيُوصِي الْعَبْدُ ؟ قَالَ : \" لا , إِلا بِإِذْنِ مَوَالِيهِ ""","","","","","Book of Wills"
"15979","عَنِ الثَّوْرِيِّ , فِي الَّذِي يُوصَى لَهُ بِشَيْءٍ فَتَهْلَكُ الْوَصِيَّةُ , قَالَ : \"فَلَيْسَ لِلَّذِي أَوْصِي لَهُ شَيْءٌ ، فَإِنْ هَلَكَ الْمَالُ كُلُّهُ , إِلا الْوَصِيَّةَ شَارَكَهُ الْوَرَثَةُ فِي تِلْكَ الْوَصِيَّةِ ""","","","","","Book of Wills"
"15980","عَنِ الثَّوْرِيِّ , فِيرَجُلٍ أَعْتَقَ عَبْدًا لَهُ عِنْدَ مَوْتِهِ , ثُمَّ قَالَ : \" مَا بَقِي مِنَ الثُّلُثِ فَهُوَ لِفُلانٍ , فَإِذَا الْعَبْدُ قَدْ كَانَ حُرًّا قَبْلَ ذَلِكَ \" , قَالَ : \" الثُّلُثُ كُلُّهُ لِلَّذِي أَوْصَى لَهُ ""","","","","","Book of Wills"
"15981","قَالَ الثَّوْرِيُّ :إِذَا قَالَ رَجُلٌ : ثُلُثُ مَالِي لِبَنِي فُلانٍ وَبَنِي فُلانٍ ، وَالأَوَّلُونَ عَشَرَةٌ , وَالآخَرُونَ سَبْعَةٌ , قَالَ : \" ثُلُثُهُ بَيْنَهُمْ شَطْرَانِ \" ، فَإِذَا قَالَ : \" هُوَ بَيْنَ فُلانٍ وَبَنِي فُلانٍ , فَهُوَ عَلَى الْعَدَدِ ""","","","","","Book of Wills"
"15982","عَنِ الثَّوْرِيِّ , فِيرَجُلٍ قَالَ : ثُلُثُ مَالِي لِبَنِي فُلانٍ فَوَجَدُوهُ وَاحِدًا , قَالَ بَعْضُهُمْ : \" لَهُ ثُلُثُ الثُّلُثِ \" , وَكَانَ بَعْضُهُمْ يَقُولُ : \" لَهُ نِصْفُ الثُّلُثِ \" , وَإِنَّمَا أُخِذَ مِنْ قَوْلِ اللَّهِ تَبَارَكَ وَتَعَالَى :  فَإِنْ كَانَ لَهُ إِخْوَةٌ فَلأُمِّهِ السُّدُسُ ","","","","","Book of Wills"
"15983","عَنِ الثَّوْرِيِّ ، فِيرَجُلٍ أَوْصَى لأَرَامِلَ بَنِي فُلانٍ , قَالَ الشَّعْبِي : \" هُوَ لِلرِّجَالِ وَالنِّسَاءِ , يُقَالُ لِلرَّجُلِ : أَرْمَلُ ""","","","","","Book of Wills"
"15984","عَنِ الثَّوْرِيِّ , قَالَ : \"إِذَا أَوْصَى بِثُلُثِ مَالِهِ , فَقَالَ : هُوَ لِفُلانٍ وَلِفُلانٍ ، ثُمَّ مَاتَ أَحَدُهُمْ , فَهُوَ لِلْبَاقِي ، وَإِذَا قَالَ : هُوَ بَيْنَ فُلانٍ وَبَيْنَ فُلانٍ , فَمَاتَ أَحَدُهُمَا , فَلِلآخَرِ النِّصْفُ ، وَإِذَا قَالَ : هُوَ لِفُلانٍ وَلِهَذَا الْحَدَثِ فَهُوَ لِلرَّجُلِ كُلِّهِ ، وَلَيْسَ لِلْحَدَثِ شَيْءٌ , وَإِذَا أَوْصَى بِثَوْبِ فُلانٍ لِفُلانٍ ، ثُمَّ اشْتَرَاهُ , فَلَيْسَ بِشَيْءٍ , لأَنَّهُ أَوْصَى بِهِ وَلَيْسَ لَهُ ""","","","","","Book of Wills"
"15985","عَنِ الثَّوْرِيِّ , قَالَ : \"إِذَا أَوْصَى رَجُلٌ , فَقَالَ : لِبَنِي فُلانٍ , فَلَيْسَ لِبَنِي الْبَنَاتِ شَيْءٌ ""","","","","","Book of Wills"
"15986","عَنِ الثَّوْرِيِّ ، قَالَ :إِذَا قَالَ : عَبْدِي لِفُلانٍ , ثُمَّ قَالَ بَعْدُ : نِصْفُ عَبْدِي لِفُلانٍ , مِنَّا مَنْ يَقُولُ : \" ثَلاثَةُ أَرْبَاعٍ وَرُبُعُ \" , وَمِنَّا مَنْ يَقُولُ : \" ثُلُثٌ وَثُلُثَيْنِ \", وَقَالَهُ : ابْنُ أَبِي لَيْلَى , وَالْعَامَّةُ","","","","","Book of Wills"
"15987","عَنِ الثَّوْرِيِّ , قَالَ : \"إِذَا أَوْصَى الرَّجُلُ بِوَصِيَّةٍ ، ثُمَّ رَدَّهَا قَبْلَ أَنْ يَمُوتَ الْمُوصِي , فَلَيْسَ رَدُّهُ بِشَيْءٍ ، يَرْجِعُ فِيهَا إِنْ شَاءَ , لأَنَّهُ رَدَّ شَيْئًا لَمْ يَقَعْ لَهُ بَعْدُ ، وَإِنْ رَدَّهُ بَعْدَ مَوْتِ الْمُوصِي , فَقَدْ مَضَى الرَّدُّ , وَلَيْسَ لَهُ أَنْ يَرْجِعَ فِيهِ ، وَإِنْ مَاتَ الْمُوصَى لَهُ بَعْدَ مَوْتِ الْمُوصِي , فَقَالَ وَرَثَةُ الْمُوصَى لَهُ : لا نَقْبَلُهَا ، فَلَيْسَ بِرَدٍّ , لأَنَّ الْوَصِيَّةَ لَمْ تَكُنْ لَهُمْ وَإِنَّمَا كَانَ مَالٌ وَرِثُوهُ ""","","","","","Book of Wills"
"15988","عَنِ الثَّوْرِيِّ , قَالَ : \"إِذَا أَوْصَى رَجُلٌ بِأَخٍ لَهُ , أَوْ ذِي قَرَابَةِ مَحْرَمٍ \" , فَقَالَ : \" لا أَقْبَلُ , فَهُوَ جَائِزٌ , لَيْسَ لَهُ رَدُّ شَيْءٍ , لأَنَّهُ حِينَ أَوْصَى لَهُ وَقَعَتِ الْعِتَاقَةُ , وَلَيْسَ رَدُّهُ قَبْلَ مَوْتِ الْمُوصِي وَبَعْدَهُ بِشَيْءٍ ""","","","","","Book of Wills"
"15989","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِي ، فِيالرَّجُلِ يَشْتَرِي وَيَبِيعُ وَهُوَ مَرِيضٌ , قَالَ : \" هُوَ فِي الثُّلُثِ , وَإِنْ مَكَثَ عَشْرَ سِنِينَ ""","","","","","Book of Wills"
"15990","عَنِ الثَّوْرِيِّ ، قَالَ :إِذَا قَالَ : \" كُلُّ مَرِيضٍ بَاعَ فِي مَرَضِهِ ثَمَنَ مِائَةٍ بِخَمْسِينَ , فَالْفَضْلُ وَصِيَّةٌ , أَوِ اشْتَرَى ثَمَنَ خَمْسِينَ بِمِائَةٍ , فَالْفَضْلُ وَصِيَّةٌ ""","","","","","Book of Wills"
"15991","عَنِ الثَّوْرِيِّ ، قَالَ :إِذَا قَالَ : \" كَاتِبُوا عَبْدِي عَلَى أَلْفِ دِرْهَمٍ , وَثَمَنُهُ خَمْسُ مِائَةِ دِرْهَمٍ , فَلَمْ يُوصِ بِشَيْءٍ \" , أَوْ قَالَ : \" بِيعُوا دَارِي بِأَلْفِ دِرْهَمٍ وَثَمَنُهَا أَلْفٌ , فَلَيْسَ بِشَيْءٍ , لَمْ يُوصِ بِشَيْءٍ \" , وَإِذَا قَالَ : \" كَاتِبُوا عَبْدِي أَوْ بِيعُوا دَارِي بِأَلْفِ دِرْهَمٍ , وَقِيمَتُهَا أَلْفٌ وَمِائَةٌ , فَهُوَ جَائِزٌ , لأَنَّهُ جَعَلَ الْوَصِيَّةَ الْمِائَةَ ""","","","","","Book of Wills"
"15992","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ أَبِي إِسْحَاقَ ، عَنْ صِلَةَ بْنِ زُفَرَ , قَالَ : جَاءَ عَبْدَ اللَّهِ بْنَ مَسْعُودٍ ,رَجُلٌ مِنْ هَمْدَانَ عَلَى فَرَسٍ أَبْلَقَ , فَقَالَ : إِنَّ رَجُلا أَوْصَى إِلِي تَرِكَةً لَهُ , وَإِنَّ هَذَا مِنْ تَرِكَتِهِ , أَفَأَشْتَرِيهِ ؟ قَالَ : \" لا , وَلا تَشْتَرِ مِنْ مَالِهِ شَيْئًا ""","","","","","Book of Wills"
"15993","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ أَشْعَثَ ، عَنْ نَافِعٍ \" أَنَّهُكَانَ يَسْتَقْرِضُ مِنْ مَالِ الْيَتِيمِ , وَيَسْتَوْدِعُهُ , وَيُعْطِيهِ مُضَارَبَةً ""","","","","","Book of Wills"
"15994","عَنِ الثَّوْرِيِّ ، عَنْ مُجَاهِدٍ , فِي قَوْلِهِ : \" وَلا تَقْرَبُوا مَالَ الْيَتِيمِ ، قَالَ : \" لا تُقْرِضُ مِنْهُ \". حَدَّثَنَا عَبْدُ اللَّهِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ مِثْلَهُ","","","","","Book of Wills"
"15995","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَعَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قَالا : \"إِذَا أَوْصَى الرَّجُلُ بِشَيْءٍ يَكُونُ عَلَيْهِ وَاجِبٌ حَجٌّ , أَوْ كَفَّارَةُ يَمِينٍ , أَوْ صِيَامٌ , أَوْ ظِهَارٌ , أَوْ نَحْوُ هَذَا , فَهُوَ مِنْ جَمِيعِ الْمَالِ ""","","","","","Book of Wills"
"15996","حَدَّثَنَا هِشَامُ بْنُ حَسَّانَ ، عَنِ الْحَسَنِ , فِيالرَّجُلِ يُوصِي بِشَيْءٍ وَاجِبٍ عَلَيْهِ , حَجٍّ , أَوْ ظِهَارٍ , أَوْ يَمِينٍ , أَوْ شِبْهِ هَذَا , قَالَ : \" هُوَ مِنْ جَمِيعِ الْمَالِ \". قَالَ : وَقَالَ ابْنُ سِيرِينَ : \" هُوَ مِنَ الثُّلُثِ ""","","","","","Book of Wills"
"15997","عَنْ مَعْمَرٍ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"هُوَ فِي الثُّلُثِ \", وَقَالَهُ الثَّوْرِي , عَنْ إِبْرَاهِيمَ","","","","","Book of Wills"
"15998","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : \"الْوَصِيَّةُ حَيْثُ يَضَعُهَا صَاحِبُهَا , إِلا أَنْ يَكُونَ الْمُوصَى إِلَيْهِ مُتَّهَمًا , فَيُحَوِّلُهَا السُّلْطَانُ \" , قَالَ : وَقَالَ : \" لا بَأْسَ أَنْ يُوصِيَ الرَّجُلُ إِلَى الْمَرْأَةِ إِذَا لَمْ تَكُنْ مُتَّهَمَةً ""","","","","","Book of Wills"
"15999","حَدَّثَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ , قَالَ : \"لا تَجُوزُ وَصِيَّةُ الْمَعْتُوهِ ، وَلا الْمُبَرْسَمِ ، وَلا الْمُوَسْوَسِ ، وَلا صَدَقَتُهُ ، وَلا عَتَاقُهُ , إِلا أَنْ يُشْهَدَ عَلَيْهِ أَنَّهُ كَانَ يَعْقِلُ ""","","","","","Book of Wills"
"16000","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، فيرَجُلٌ يُوصِي لِرَجُلٍ بِثُلُثِ مَالِهِ , ثُمَّ يُقْتَلُ خَطَا , قَالَ : \" يَعْقِلُ الَّذِي أَوْصَى لَهُ ثُلُثَ الدِّيَةِ أَيْضًا ""","","","","","Book of Wills"
"16001","عَنْ عَبْدِ اللَّهِ بْنِ مُحَرَّرٍ , قَالَ : أَخْبَرَنِي الْحَكَمُ بْنُ عُتَيْبَةَ , قَالَ : \" إِنَّرَجُلا خَرَجَ مُسَافِرًا , فَأَوْصَى لِرَجُلٍ بِثُلُثِ مَالِهِ ، فَقُتِلَ الرَّجُلُ فِي سَفَرِهِ ذَلِكَ , فَرُفِعَ أَمْرُهُ إِلَى عَلِيِّ بْنِ أَبِي طَالِبٍ , فَأَعْطَاهُ ثُلُثَ الْمَالِ وَثُلُثَ الدِّيَةِ ""","","","","","Book of Wills"
"16002","عَنْ مَعْمَرٍ ، عَنْ سِمَاكِ بْنِ الْفَضْلِ , قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ فِيرَجُلٍ يُوصِي لِرَجُلٍ بِعَبْدٍ وَلَهُ رَقِيقٍ , وَلَمْ يُسَمِّهِ , فَكَتَبَ : أَنْ يُعْطَى أَخَسُّهُمْ , يَقُولُ : \" شَرُّهُمْ ""","","","","","Book of Wills"
"16003","حَدَّثَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ النُّعْمَانِ بْنِ بَشِيرٍ ، وَحُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، عَنِ النُّعْمَانِ بْنِ بَشِيرٍ , قَالَ : ذَهَبَ بِي أَبِي بَشِيرُ بْنُ سَعْدٍ , إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِيُشْهِدَهُ عَلَى نُحْلٍ عَلَيْهِ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"أَكُلَّ بَنِيكِ نَحَلْتَ مِثْلَ هَذَا ؟ \" , فَقَالَ : لا , قَالَ : \" فَارْجِعْهَا ""","","","","","Book of Wills"
"16004","عَنِ ابْنِ جُرَيْجٍ , قَالَ ابْنُ شِهَابٍ : عَنْ حُمَيْدِ ابْنِ عَبْدِ الرَّحْمَنِ ، وَمُحَمَّدِ بْنِ النُّعْمَانِ ، عَنِ النُّعْمَانِ بْنِ بَشِيرٍ , قَالَ : ذَهَبَ بِي بَشِيرُ بْنُ سَعْدٍ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللَّهِ , إِنِّي نَحَلْتُ ابْنِي هَذَا غُلامًا , فَجِئْتُكَ لأُشْهِدَكَ عَلَيْهِ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"أَوَ كُلَّ وَلَدِكَ نَحَلْتَ ؟ \" , فَقَالَ : لا , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" فَلا ""","","","","","Book of Wills"
"16005","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ الزُّهْرِيِّ , قَالَ : سَمِعْتُهُ يُحَدِّثُ أَنَّ مُحَمَّدَ بْنَ النُّعْمَانِ ، وَحُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ يُحَدِّثَانِ , عَنِ النُّعْمَانِ بْنِ بَشِيرٍ , قَالَ : ذَهَبَ أَبِي بَشِيرٌ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللَّهِ , إِنِي نَحَلْتُ ابْنِي هَذَا غُلامَا , فَجِئْتُكَ لأُشْهِدَكَ عَلَيْهِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"أَكُلَّ وَلَدِكَ نَحَلْتَ ؟ \" , قَالَ : لا ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" فَلا ""","","","","","Book of Wills"
"16006","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي عَوْنُ بْنُ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، عَنِ الشَّعْبِي ، أَنَّ النُّعْمَانَ بْنَ بَشِيرٍ , قَالَتْ أُمُّهُ : يَا بَشِيرُ , انْحَلِ النُّعْمَانَ , وَزَعِمُوا أَنَّ أُمَّ النُّعْمَانِ ابْنَةَ عَبْدِ اللَّهِ بْنِ رَوَاحَةَ , فَلَمْ تَزَلْ بِهِ حَتَّى نَحَلَهُ , فَقَالَتْ : أَشْهِدْ عَلَيْهِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَذَهَبَ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ لَهُ الشَّهَادَةَ عَلَيْهِ , فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"أَنَحَلْتَ بَنِيكَ مِثْلَ ذَلِكَ ؟ \" , قَالَ : لا , قَالَ : \" فَإِنِي لا أَشْهَدُ عَلَى الْجَوْرِ \" , قَالَ لِي عَوْنٌ : وَأَمَّا أَنَا فَسَمِعْتُ أَبِي يَقُولُ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" فَسَوِّ بَيْنَهُمْ ""","","","","","Book of Wills"
"16007","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : جَاءَ بَشِيرُ بْنُ سَعْدٍ , بِابْنِهِ النُّعْمَانِ , إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِيُشْهِدَهُ عَلَى نُحْلٍ نَحَلَهُ إِيَّاهُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"أُكُلَّ بَنْيَكَ نَحَلْتَ مِثْلَ هَذَا ؟ \" , فَقَالَ : لا ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" قَارِبُوا بَيْنَ أَبْنَائِكُمْ , وَأَبَى أَنْ يَشْهَدَ ""","","","","","Book of Wills"
"16008","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَرَّ بِبَشِيرِ بْنِ سَعْدٍ أَبِي النُّعْمَانِ , وَمَعَهُ ابْنُهُ النُّعْمَانُ , فَقَالَ : اشْهَدْ أَنِّي قَدْنَحَلْتُهُ عَبْدًا أَوْ أَمَةً , فَقَالَ : \" أَلَكَ وَلَدٌ غَيْرَهُ ؟ \" , قَالَ : نَعَمْ , قَالَ : \" فَنَحَلْتَهُمْ مَا نَحَلْتَهُ ؟ \" , قَالَ : لا , قَالَ : \" فَإِنِي لا أَشْهَدُ إِلا عَلَى الْحَقِّ , لا أَشْهَدُ بِهَذَا \", قُلْتُ : أَسَمِعْتَهُ مِنْ أَبِيكَ ؟ قَالَ : لا","","","","","Book of Wills"
"16009","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَحَقٌّ تَسْوِيَةُ النُّحْلِ بَيْنَ الْوَلَدِ عَلَى كِتَابِ اللَّهِ ؟ قَالَ : نَعَمْ , قَدْ بَلَغَنَا ذَلِكَ عَنْ نَبِيِّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ : \"أَسَوَّيْتَ بَيْنَ وَلَدِكَ ؟ \", قُلْتُ : فِي النُّعْمَانِ بْنِ بَشِيرٍ , قُلْتُ : وَفِي غَيْرِهِ","","","","","Book of Wills"
"16010","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ : أَنَّ سَعْدَ بْنَ عُبَادَةَقَسَمَ مَالَهُ بَيْنَ بَنِيهِ فِي حَيَاتِهِ , فَوُلِدَ لَهُ وَلَدٌ بَعْدَ مَا مَاتَ , فَلَقِي عُمَرُ أَبَا بَكْرٍ , فَقَالَ : \" مَا نِمْتُ اللَّيْلَةَ مِنْ أَجْلِ ابْنِ سَعْدٍ هَذَا الْمَوْلُودِ ، وَلَمْ يَتْرُكْ لَهُ شَيْئًا \" , فَقَالَ أَبُو بَكْرٍ : \" وَأَنَا وَاللَّهِ مَا نِمْتُ اللَّيْلَةَ \" , أَوْ كَمَا قَالَ : مِنْ أَجْلِهِ , فَانْطَلِقْ بِنَا إِلَى قَيْسِ بْنِ سَعْدٍ , نُكَلِّمُهُ فِي أَخِيهِ , فَأَتَيَاهُ فَكَلَّمَاهُ , فَقَالَ قَيْسُ : أَمَّا شَيْءٌ أَمْضَاهُ سَعْدٌ فَلا أَرُدُّهُ أَبَدًا , وَلَكِنْ أُشْهِدُكُمَا أَنَّ نَصِيبِي لَهُ","","","","","Book of Wills"
"16011","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ : أَنَّ سَعْدَ بْنَ عُبَادَةَقَسَمَ مَالَهُ بَيْنَ بَنِيهِ , ثُمَّ تُوُفِّي , وَامْرَأَتُهُ حُبْلَى لَمْ يَعْلَمْ بِحَمْلِهَا , فَوَلَدَتْ غُلامًا , فَأَرْسَلَ أَبُو بَكْرٍ ، وَعُمَرُ فِي ذَلِكَ إِلَى قَيْسِ بْنِ سَعْدِ بْنِ عُبَادَةَ , قَالَ : \" أَمَّا أَمْرٌ قَسَمَهُ سَعْدٌ وَأَمْضَاهُ فَلَنْ أَعُودَ فِيهِ , وَلَكِنْ نَصِيبِي لَهُ \" ، قُلْتُ : أَعَلَى كِتَابِ اللَّهِ قَسَمَ ؟ قَالَ : \" لا نَجِدُهُمْ كَانُوا يَقْسِمُونَ إِلا عَلَى كِتَابِ اللَّهِ ""","","","","","Book of Wills"
"16012","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ ذَكْوَانَ ، أَنَّ ذَكْوَانَ أَبَا صَالِحٍ أَخْبَرَهُ هَذَا الْخَبَرَ : خَبَرَ قَيْسٍ \" أَنَّهُقَسَمَ مَالَهُ بَيْنَ بَنِيهِ , ثُمَّ انْطَلَقَ إِلَى الشَّامِ فَمَاتَ ""","","","","","Book of Wills"
"16013","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مَنْ لا أَتَّهِمُ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : دَعَاهُ رَجُلٌ مِنَ الأَنْصَارِ ,فَجَاءَ ابْنٌ لَهُ , فَقَبَّلَهُ وَضَمَّهُ , وَأَجْلَسَهُ إِلَيْهِ , ثُمَّ جَاءَتْهُ ابْنَةٌ لَهُ , فَأَخَذَ بِيَدِهَا فَأَجْلَسَهَا ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لَوْ عَدَلْتَ كَانَ خَيْرًا لَكَ , قَارِبُوا بَيْنَ أَبْنَائِكُمْ وَلَوْ فِي الْقُبَلِ ""","","","","","Book of Wills"
"16014","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :وَارِثٌ يَنْحِلُ بَنِيهِ , أَيُسَوِّي بَيْنَهُمْ , وَبَيْنَ أَبٍ أَوْ زَوْجَةٍ ؟ أَيَحِقُّ عَلَيْهِ أَنْ يَنْحِلَ أَبَاهُ وَزَوْجَتَهُ عَلَى كِتَابِ اللَّهِ عَزَّ وَجَلَّ مَعَ وَلَدِهِ ؟ قَالَ : \" لَمْ يَذْكُرْ إِلا الْوَلَدَ \", لَمْ أَسْمَعَ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ غَيْرَ ذَلِكَ","","","","","Book of Wills"
"16015","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ ، أَنَّهُ قَالَ : \"لا تُفَضِّلُ أَحَدًا عَلَى أَحَدٍ بِشَعْرَةٍ \" , وَكَانَ يَقُولُ : \" النُّحْلُ بَاطِلٌ , إِنَّمَا هُوَ عَمَلُ الشَّيْطَانِ \" , وَكَانَ يَقُولُ : \" اعْدِلْ بَيْنَهُمْ \" , قُلْتُ : هَلَكَ بَعْضُ نُحْلِهِمْ يَوْمَ مَاتَ أَبُوهُمْ , قَالَ : \" لِلَّذِي نَحَلَهُ مِثْلُهُ مِنْ مَالِ أَبِيهِ \" , قَالَ : وَأَقُولُ أَنَا : لا , قَدِ انْقَطَعَ النُّحْلُ , وَوَجَبَ إِذَا عَدَلَ بَيْنَهُمْ","","","","","Book of Wills"
"16016","عَنْ زُهَيْرِ بْنِ نَافِعٍ , قَالَ : سَأَلْنَا عَطَاءَ بْنَ أَبِي رَبَاحٍ , قُلْتُ : أَرَدْتُ أَنْأُفَضِّلَ بَعْضَ وَلَدِي فِي نُحْلٍ أَنَحَلُهُ ؟ قَالَ : \" لا , وَأَبَى عَلَيَّ إِبَاءً شَدِيدًا \" , وَقَالَ : \" سَوِّ بَيْنَهُمْ ""","","","","","Book of Wills"
"16017","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : \"النُّحْلُ عِنْدَ الْمَوْتِ فِي الثُّلُثِ ""","","","","","Book of Wills"
"16018","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ طَاوُسٍ ، \"كَرِهَ أَنْ يُفَضِّلَ بَعْضَهُمْ عَلَى بَعْضٍ , وَرَخَّصَ فِي ذَلِكَ أَبُو الشَّعْثَاءِ","","","","","Book of Wills"
"16019","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ , قَالَتْ : لَمَّا حَضَرَتْ أَبَا بَكْرٍ الْوَفَاةُ ؟ قَالَ : \" أَيْ بُنَيَّةُ ،لَيْسَ أَحَدٌ أَحَبَّ إِلَيَّ غِنًى مِنْكِ , وَلا أَعَزَّ عَلَيَّ فَقْرًا مِنْكِ , وَإِنِي قَدْ كُنْتُ نَحَلْتُكِ جِدَادَ عِشْرِينَ وَسْقًا مِنْ أَرْضِي الَّتِي بِالْغَابَةِ , وَإِنَّكِ لَوْ كُنْتِ حُزْتِيهِ كَانَ لَكِ , فَإِذْ لَمْ تَفْعَلِي فَإِنَّمَا هُوَ لِلْوَارِثِ ، وَإِنَّمَا هُوَ أَخَوَاكِ وَأُخْتَاكِ \" , قَالَتْ عَائِشَةُ : هَلْ هِيَ إِلا أُمُّ عَبْدِ اللَّهِ ؟ قَالَ : \" نَعَمْ ، وَذُو بَطْنِ ابْنَةِ خَارِجَةَ , قَدْ أُلْقِي فِي نَفْسِي أَنَّهَا جَارِيَةٌ , فَأَحْسِنُوا إِلَيْهَا ""","","","","","Book of Wills"
"16020","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي مُلَيْكَةَ ، أَنَّ الْقَاسِمَ بْنَ مُحَمَّدِ بْنِ أَبِي بَكْرٍ أَخْبَرَهُ , أَنَّ أَبَا بَكْرٍ , قَالَ لِعَائِشَةَ : \" يَا بُنَيَّةُ ،إِنِي نَحَلْتُكِ نُحْلا مِنْ خَيْبَرَ , وَإِنِي أَخَافُ أَنْ أَكُونَ آثَرْتُكِ عَلَى وَلَدِي , وَإِنَّكِ لَمْ تَكُونِي حُزْتِيهِ فَرُدِّيهِ عَلَى وَلَدِي \" , فَقَالَتْ عَائِشَةُ : يَا أَبَتَاهُ ، لَوْ كَانَتْ لِي خَيْبَرُ بِجِدَادِهَا لَرَدَدْتُهَا","","","","","Book of Wills"
"16021","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ , قَالَ : أَخْبَرَنِي الْمِسْوَرُ بْنُ مَخْرَمَةَ ، وَعَبْدُ الرَّحْمَنِ بْنُ عَبْدٍ الْقَارِي ، أَنَّهُمَا سَمِعَا عُمَرَ بْنَ الْخَطَّابِ , يَقُولُ : \"مَا بَالُ أَقْوَامٍ يَنْحِلُونَ أَبْنَاءَهُمْ , فَإِذَا مَاتَ الابْنُ قَالَ الأَبُ : مَالِي , وَفِي يَدِي , وَإِذَا مَاتَ الأَبُ قَالَ : قَدْ كُنْتُ نَحَلْتُ ابْنِي كَذَا وَكَذَا ، لا نَحْلَ إِلا لِمَنْ حَازَهُ , وَقَبَضَهُ عَنْ أَبِيهِ ""","","","","","Book of Wills"
"16022","عَنْ مَعْمَرٍ , قَالَ الزُّهْرِي : فَأَخْبَرَنِي سَعِيدُ بْنُ الْمُسَيِّبِ , قَالَ : فَلَمَّا كَانَ عُثْمَانُ شُكِيَ ذَلِكَ إِلَيْهِ , فَقَالَ عُثْمَانُ :\" نَظَرْنَا فِي هَذِهِ النُّحُولِ , فَرَأَيْنَا أَنَّ أَحَقَّ مَنْ يَحُوزُ عَلَى الصَّبِيِّ أَبُوهُ ""","","","","","Book of Wills"
"16023","عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : سُئِلَ شُرَيْحٌمَا يَجُوزُ لِلصَّبِيِّ مِنَ النَّحْلِ ؟ قَالَ : \" إِذَا أُشْهِدَ وَأُعْلِمَ \" , قِيلَ : فَإِنَّ أَبَاهُ يَحُوزُ عَلَيْهِ ؟ , قَالَ : \" هُوَ أَحَقُّ مَنْ حَازَ عَلَى ابْنِهِ ""","","","","","Book of Wills"
"16024","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" هَلْ يَجُوزُ مِنَ النُّحْلِ إِلا مَا دُفِعَ إِلَى مَنْ قَدْ بَلَغَ الْحَوْزَ ، وَإِنْ لَمْ يَكُنْ نَكَحَ , إِذَا لَمْ يَكُنْ سَفِيهًا ؟ قَالَ : كَذَلِكَ زَعِمُوا \" , قَالَ : وَأُخْبِرْتُ عَنْ عَائِشَةَ ، أَنَّ أَبَا بَكْرٍنَحَلَ عَائِشَةَ نُحْلا , فَلَمَّا حَضَرَتْهُ الْوَفَاةُ دَعَاهَا , فَقَالَ : \" أَيُّ هَنْتَاهُ , إِنَّكِ أَحَبُّ النَّاسِ إِلِي , وَإِنِي أُحِبُّ أَنْ تَرُدِّي إِلِي مَا نَحَلْتُكِ \" , قَالَتْ : نَعَمْ","","","","","Book of Wills"
"16025","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : وَزَعَمَ سُلَيْمَانُ بْنُ مُوسَى , أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ كَتَبَ لَهُ : \"أَيُّمَا رَجُلٍ نَحَلَ مَنْ قَدْ بَلَغَ الْحَوْزَ , فَلَمْ يَدْفَعْهُ إِلَيْهِ , فَتِلْكَ النِّحْلَةُ بَاطِلَةٌ \"، وَزَعِمُوا أَنَّ أَخْذَهُ مِنْ نَحْلِ أَبِي بَكْرٍ عَائِشَةَ , فَلَمْ يُبِنْهَا بِهِ , فَرَدَّهُ حِينَ حَضَرَهُ الْمَوْتُ","","","","","Book of Wills"
"16026","عَنْ مَعْمَرٍ ، عَنْ سِمَاكِ بْنِ الْفَضْلِ , قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ \" أَنَّهُلا يَجُوزُ مِنَ النُّحْلِ إِلا مَا عُزِلَ , وَأُفْرِدَ , وَأُعْلِمَ ""","","","","","Book of Wills"
"16027","عَنْ مَعْمَرٍ ، عَنِ ابْنِ شُبْرُمَةَ , فِيرَجُلٍ نَحَلَ ابْنَهُ ثُلُثَ أَرْضِهِ , أَوْ رُبُعَهَا , وَلَمْ يُقَاسِمْهُ إِلا بِالْفَرْقِ , قَالَ : \" لَيْسَ لَهُ إِلا مَا أَخَذَ مِنَ الْقَوْمِ \", قَالَ مَعْمَرٌ : وَأَخْبَرَنِي بَعْضُ أَصْحَابِنَا , عَنْ إِبْرَاهِيمَ النَّخَعِي , أَنَّهُ كَانَ يَرَاهُ جَائِزًا , وَيَقُولُ : الْفَرْقُ حِيَازَةٌ","","","","","Book of Wills"
"16028","عَنْ مَعْمَرٍ ، عَنْ عُثْمَانَ الْبَتِّي , فِيرَجُلٍ نَحَلَ ابْنًا لَهُ سَهْمًا مَعْرُوفًا كَانَ لَهُ فِي أَرْضٍ ، وَلَمْ يَكُنْ قَاسَمَ أَصْحَابَهُ , قَالَ : \" إِذَا كَانَ قَدْ خَرَجَ مِنْ جَمِيعِ حَقِّهِ إِلَيْهِ فَهُوَ جَائِزٌ ، إِذَا كَانَ يَحُوزُ مَعَ شُرَكَائِهِ ، وَإِنْ لَمْ يُقْسِمْ ""","","","","","Book of Wills"
"16029","عَنْ مَعْمَرٍ , قَالَ : وَسَأَلْتُ ابْنَ شُبْرُمَةَ عَنْهُ , فَقَالَ : \"لا يَجُوزُ حَتَّى يُقَسَّمَ \", قَالَ مَعْمَرٌ : وَقَوْلُ عُثْمَانَ الْبَتِّي أَحَبُّ إِلِي , وَقَالَ : \" مَا يُرِيدُونَ إِلا أَنْ يُغْنُوا الْقَسَّامَ ""","","","","","Book of Wills"
"16030","عَنْ مَعْمَرٍ ، عَنِ ابْنِ شُبْرُمَةَ : \" كَانَلا يَرَى حَوْزَ بَعْضِ الْوَرَثَةِ شَيْئًا \", قَالَ مَعْمَرٌ : وَكَانَ الزُّهْرِيُّ يُجِيزُهُ","","","","","Book of Wills"
"16031","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ :\" مَنْ وَهَبَ هِبَةً يَرْجُو ثَوَابَهَا فَهِيَ رَدٌّ عَلَى صَاحِبِهَا , أَوْ يُثَابُ عَلَيْهَا ، وَمَنْ أَعْطَى فِي حَقٍّ , أَوْ قَرَابَةٍ , أَجَزْنَا عَطِيَّتَهُ \", عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ عُمَرَ مِثْلَهُ","","","","","Book of Gifts"
"16032","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : وَهَبَ رَجُلٌ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَثَابَهُ , فَلَمْ يَرْضَ , فَزَادَهُ , فَلَمْ يَرْضَ , فَزَادَهُ , أَحْسَبُهُ قَالَ : ثَلاثَ مَرَّاتٍ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"لَقَدْ هَمَمْتُ أَنْ لا أَقْبَلَ هِبَةً \", ورُبَّمَا قَالَ مَعْمَرٌ : أَلا أتَّهِبَ إِلا مِنْ قُرَشِيٍّ , أَوْ أَنْصَارِيٍّ , أَوْ ثَقَفِيٍّ , عَنْ مَعْمَرٍ ، وَابْنِ عُيَيْنَةَ , عَنِ ابْنِ عَجْلانَ ، عَنْ سَعِيدٍ ، عَنْ أَبِي هُرَيْرَةَ , مِثْلَهُ وَزَادَ : \" أَوْ دَوْسِيٍّ ""","","","","","Book of Gifts"
"16033","عَنْ مَعْمَرٍ ، وَابْنِ جُرَيْجٍ , عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ شُرَيْحٍ , قَالَ : \"مَنْ أَعْطَى فِي صِلَةٍ , أَوْ قَرَابَةٍ , أَوْ حَقٍّ , أَوْ مَعْرُوفٍ , أَجَزْنَا عَطِيَّتَهُ ، وَالْجَانِبُ الْمُسْتَغْزِرُ تُرَدُّ إِلَيْهِ هِبَتُهُ , أَوْ يُثَابُ مِنْهَا ""","","","","","Book of Gifts"
"16034","عَنْ يَزَيْدَ بْنِ زِيَادٍ ، عَنْ زَيْدِ بْنِ وَهْبٍ , قَالَ : كَتَبَ عُمَرُ بْنُ الْخَطَّابِ \" أَنَّالْمُسْلِمَ يَنْكِحُ النَّصْرَانِيَّةَ , وَالنَّصْرَانِي لا يَنْكِحُ الْمُسْلِمَةَ ، وَيَتَزَوَّجُ الْمُهَاجِرُ الأَعْرَابِيَّةَ ، وَلا يَتَزَوَّجُ الأَعْرَابِيُّ الْمُهَاجِرَةَ , لِيُخْرِجَهَا مِنْ دَارِ هِجْرَتِهَا ، وَمَنْ وَهَبَ هِبَةً لِذِي رَحِمٍ جَازَتْ هِبَتُهُ ، وَمَنْ وَهَبَ لِذِي رَحِمٍ فَلَمْ يُثِبْهُ مِنْ هِبَتِهِ , فَهُوَ أَحَقُّ بِهَا ""","","","","","Book of Gifts"
"16035","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"مَنْ وَهَبَ هِبَةً لِذِي رَحِمٍ , فَلَيْسَ لَهُ أَنْ يَرْجِعَ فِيهَا ، وَمَنْ وَهَبَ هِبَةً لِغَيْرِ ذِي رَحِمٍ , فَلَهُ أَنْ يَرْجِعَ فِيهَا , إِلا أَنْ يُثَابَ ""","","","","","Book of Gifts"
"16036","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ أَبْزَى ، عَنْ عَلِيٍّ , قَالَ : \"مَنْ وَهَبَ هِبَةً لِذِي رَحِمٍ فَلَمْ يُثَبْ مِنْهَا , فَهُوَ أَحَقُّ بِهِبَتِهِ ""","","","","","Book of Gifts"
"16037","عَنِ الأَسْلَمِي , قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ أَبِي بَكْرٍ ، عَنْ أَبِيهِ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : \"مَنْ أَعْطَى شَيْئًا وَلَمْ يَسْأَلْ فَلَيْسَ لَهُ ثَوَابٌ مِنْ هِبَتِهِ ، وَإِنْ سُئِلَ فَأَعْطَى فَهُوَ أَحَقُّ بِهِبَتِهِ , حَتَّى يُثَابَ مِنْهَا حَتَّى يَرْضَى ""","","","","","Book of Gifts"
"16038","وَقَالَ : عَنِ الْحَجَّاجِ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : \"مَنْ وَهَبَ هِبَةً لِغَيْرِ ذِي رَحِمٍ يَقْبِضُهَا , فَهُوَ أَحَقُّ بِهَا أَنْ يَرْجِعَ فِيهَا مَا لَمْ يُثَبْ عَلَيْهَا , أَوْ يُسْتَهْلَكُ , أَوْ يَمُوتَ أَحَدُهُمَا ""","","","","","Book of Gifts"
"16039","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"الْهِبَةُ لا تَجُوزُ حَتَّى تُقْبَضَ , وَالصَّدَقَةُ تَجُوزُ قَبْلَ أَنْ تُقْبَضَ ""","","","","","Book of Gifts"
"16040","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : سَأَلْتُهُ عَنِالرَّجُلِ يَكُونُ شَرِيكًا لابْنِهِ فِي مَالٍ , فَيَقُولُ أَبُوهُ : لَكَ مِائَةُ دِينَارٍ مِنَ الْمَالِ الَّذِي بَيْنِي وَبَيْنَكَ , قَالَ \" قَضَى أَبُو بَكْرٍ ، وَعُمَرُ أَنَّهُ لا يَجُوزُ , حَتَّى يَحُوزَهُ مِنَ الْمَالِ وَيَعْزِلَهُ ""","","","","","Book of Gifts"
"16041","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ ابْنَ شُبْرُمَةَ عَنْهُ , فَقَالَ : \"إِذَا سَمَّى فَجَعَلَ لَهُ مِائَةَ دِينَارٍ مِنْ مَالِهِ فَهُوَ جَائِزٌ ، وَإِنْ سَمَّى ثُلُثًا أَوْ رُبُعًا لَمْ يَجُزْ حَتَّى يُقَسِّمَهُ ""","","","","","Book of Gifts"
"16042","عَنْ مَعْمَرٍ ، عَنْ عُثْمَانَ , فِيرَجُلٍ وَهَبَ لآخَرَ هِبَةً فَقَبَضَهَا ، ثُمَّ رَجَعَ فِيهَا الْوَاهِبُ , قَالَ الْمَوْهُوبُ لَهُ : فَإِنِي قَدْ رَدَدْتُهَا عَلَيْكَ , فَمَاتَ الْوَاهِبُ قَبْلَ أَنْ يَقْبِضَهَا مِنَ الَّذِي وَهَبَهَا لَهُ , قَالَ : \" فَلَيْسَ بِشَيْءٍ , هِيَ لِلْمَوْهُوبِ لَهُ حَتَّى يَقْبِضَهَا كَمَا قُبِضَتْ مِنْهُ ""","","","","","Book of Gifts"
"16043","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \"الْوَاهِبُ مَا وَهَبَ لِذِي رَحِمٍ لا يُرِيدُ ثَوَابًا فَلا ثَوَابَ لَهُ , وَمَنْ وَهَبَ مَنْ 000 يُرِيدُ الْمَثُوبَةَ أَحَقُّ بِمَا وَهَبَ حَتَّى يُثَابَ \" ، قُلْتُ : كَذَلِكَ تَقُولُ ؟ قَالَ : \" نَعَمْ ""","","","","","Book of Gifts"
"16044","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ ، أَنَّهُ قَالَ : \" مَنْ وَهَبَ هِبَةً لَيْسَ يَشْتَرِطُ فِيهَا شَرْطًا فَهُوَ جَائِزٌ \" , وَقَالَ مُعَاذٌ مِنْ أَهْلِ الْيَمَنِ قَضَى : \"أَيُّمَا رَجُلٍ وَهَبَ أَرْضًا عَلَى أَنَّكَ تَسْمَعُ لِي وَتُطِيعُ , فَسَمِعَ وَأَطَاعَ , فَهِيَ لِلْمَوْهُوبِ لَهُ ، وَأَيُّمَا رَجُلٍ وَهَبَ كَذَا وَكَذَا إِلَى أَجَلٍ ، ثُمَّ رَجَعَ إِلَيْهِ , فَهِيَ لِلْوَاهِبِ إِذَا جَاءَ الأَجَلُ ، وَأَيُّمَا رَجُلٍ وَهَبَ أَرْضًا ، وَلَمْ يَشْتَرِطْ , فَهِيَ لِلْمَوْهُوبِ لَهُ , هَكَذَا فِي الشَّرْطِ , قَضَى بِهِ مُعَاذٌ بَيْنَهُمْ فِي الإِسْلامِ ""","","","","","Book of Gifts"
"16045","عَنِ الثَّوْرِيِّ ، قَالَ : وَنَقُولُ :ذُو الرَّحِمِ ذُو الرَّحِمِ , قَالَ : وَنَقُولُ لا يَكُونُ الثَّوَابُ حَتَّى يَهِبَهُ , وَيَقُولُ : \" هَذَا ثَوَابُ مَا أَعْطَيْتَنِي ، وَإِنْ أَعْطَاهُ مِثْلَ ذَلِكَ ""","","","","","Book of Gifts"
"16046","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"لَيْسَ لَنَا مَثَلُ السَّوْءِ الْعَائِدُ فِي هِبَتِهِ كَالْكَلْبِ يَعُودُ فِي قَيْئِهِ ""","","","","","Book of Gifts"
"16047","عَنِ الثَّوْرِيِّ ، عَنْ أَيُّوبَ ، عَنْ عِكْرِمَةَ , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"الْعَائِدُ فِي هِبَتِهِ كَالْكَلْبِ يَعُودُ فِي قَيْئِهِ , لَيْسَ لَنَا مَثَلُ السَّوْءِ ""","","","","","Book of Gifts"
"16048","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"الْعَائِدُ فِي هِبَتِهِ كَالْكَلْبِ يَعُودُ فِي قَيْئِهِ \", قَالَ مَعْمَرٌ : وَأَخْبَرَنِي مَنْ سَمِعَ الْحَسَنَ يُحَدِّثُ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ , قَالَ : فَكَانَ الْحَسَنُ , يَقُولُ : لا يَعُودُ فِي الْهِبَةِ","","","","","Book of Gifts"
"16049","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، قَالَ : \"كَيْفَ يَعُودُ الرَّجُلُ فِي هِبَتِهِ ؟ ""","","","","","Book of Gifts"
"16050","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي حَسَنُ بْنُ مُسْلِمٍ ، عَنْ طَاوُسٍ , قَالَ : كُنْتُ أَسْمَعُ وَأَنَا غُلامٌ الْغِلْمَانَ ، يَقُولُونَ : الَّذِي يَعُودُ فِي هِبَتِهِ كَالْكَلْبِ يَعُودُ فِي قَيْئِهِ , وَلا أَشْعُرُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ضَرَبَ ذَلِكَ مَثَلا , حَتَّى أُخْبِرْتُ بِهِ بَعْدُ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" إِنَّمَامَثَلُ الَّذِي يَهِبُ ثُمَّ يَعُودُ فِي هِبَتِهِ مَثَلُ الْكَلْبِ يَقِيءُ ثُمَّ يَأْكُلُ قَيْئَهُ ""","","","","","Book of Gifts"
"16051","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي الْحَسَنُ بْنُ مُسْلِمٍ ، عَنْ طَاوُسٍ , أَنَّهُ قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"لا يَحِلُّ لأَحَدٍ أَنْ يَهِبَ لأَحَدٍ شَيْئًا , ثُمَّ يَأْخُذَهُ مِنْهُ إِلا الْوَالِدَ ""","","","","","Book of Gifts"
"16052","عَنْ إِسْمَاعِيلَ ، عَنِ خَالِدٍ الْحَذَّاءِ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"الْعَائِدُ فِي هِبَتِهِ كَالْكَلْبِ يَعُودُ فِي قَيْئِهِ ، إِلا الْوَالِدَ مِنْ وَلَدِهِ ""","","","","","Book of Gifts"
"16053","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : سَمِعْتُ سُلَيْمَانَ بْنَ مُوسَى , يَقُولُ لِعَطَاءٍ وَأَنَا أَسْمَعُ :رَجُلٌ وَهَبَ مُهْرًا , فَنَمَا عِنْدَهُ , ثُمَّ عَادَ فِيهِ الْوَاهِبُ قَالَ : أَرَى أَنْ يُقَوَّمَ قِيمَتُهُ يَوْمَ وَهَبَهُ، فَقَالَ سُلَيْمَانُ بْنُ مُوسَى : فَعَلَ ذَلِكَ رَجُلٌ بِالشَّامِ , فَكَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ \" إِنَّمَا يَعُودُ فِي الْمَوَاهِبِ النِّسَاءُ وَشِرَارِ الرِّجَالِ , قِفِ الْوَاهِبَ عَلانِيَةً ، فَإِنْ عَادَ فِيهِ فَأَقِمْهُ قِيمَةً يَوْمَ وَهَبَهُ , أَوْ شَرْوَى الْمُهْرِ يَوْمَ وَهَبَهُ , فَلْيَدْفَعْهُ إِلَى الْوَاهِبِ ""","","","","","Book of Gifts"
"16054","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ مِنْ أَهْلِ الْجَزِيرَةِ , أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ \"كَتَبَ فِي رَجُلٍ وَهَبَ هِبَةً لِرَجُلٍ , فَاسْتَرْجَعَهَا صَاحِبُهَا ، فَكَتَبَ أَنْ يُرَدَّ إِلَيْهِ عَلانِيَةً كَمَا وَهَبَهَا عَلانِيَةً ""","","","","","Book of Gifts"
"16055","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زِيَادٍ , قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ \"مَنْ وَهَبَ هِبَةً لِغَيْرِ ذِي رَحِمٍ فَلا يَرْجِعُ فِيهَا , وَلَهُ شَرْوَى هِبَتِهِ يَوْمَ وَهَبَهَا إِذَا نَمَتْ \", قَالَ سُفْيَانُ : يَعْنِي يَقُولُ : لا يَرْجِعُ فِيهَا إِلا عَلانِيَةً عِنْدَ السُّلْطَانِ , قَالَ : وَكَانَ ابْنُ أَبِي لَيْلَى , يَقُولُ : يَرْجِعُ فِيهَا دُونَ الْقَاضِي","","","","","Book of Gifts"
"16056","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَسُئِلَ عَنْرَجُلٍ وَهَبَ لابْنِهِ نَاقَةً , فَرَجَعَ فِيهَا , فَرُفِعَ ذَلِكَ إِلَى عُمَرَ بْنِ الْخَطَّابِ \" فَرَدَّهَا عَلَيْهِ بِعَيْنِهَا , وَجَعَلَ نَمَاءَهَا لابْنِهِ ""","","","","","Book of Gifts"
"16057","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، وَعَبْدِ الْكَرِيمِ الْجَزَرِي ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ \" كَتَبَ فِيرَجُلٍ وَهَبَ لِرَجُلٍ هِبَةً وَقَدْ هَلَكَتْ , فَكَتَبَ أَنْ يَرُدَّ قِيمَةَ هِبَتِهِ يَوْمَ وَهَبَهَا ""","","","","","Book of Gifts"
"16058","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : \"يَرْجِعُ الرَّجُلُ فِي هِبَتِهِ , فَإِنْ كَانَتْ قَدِ اسْتُهْلِكَتْ فَلَهُ قِيمَةُ هِبَتِهِ يَوْمَ وَهَبَهَا ""","","","","","Book of Gifts"
"16059","عَنِ الثَّوْرِيِّ ، عَنِ أَبِي بَكْرٍ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، وَعَنْ طَاوُسٍ ، عَنِ الشَّعْبِي ، قَالا فِيالْهِبَةِ : \" إِذَا اسْتُهْلِكَتْ فَلا رُجُوعَ فِيهَا ""","","","","","Book of Gifts"
"16060","عَنْ سُفْيَانَ , قَالَ : \"تَفْسِيرُ اسْتِهْلاكِ الْهِبَةِ أَنْ يَبِيعَهَا ، أَوْ يَهِبَهَا , أَوْ يَأْكُلَهَا , أَوْ يَخْرُجَ مَنْ يَدِهِ إِلَى غَيْرِهِ , فَهَذَا اسْتِهْلاكٌ \" , قَالَ سُفْيَانُ : وَكَانَ بَعْضُ مَنْ يُشَارُ إِلَيْهِ , يَقُولُ : \" إِذَا تَغَيَّرَتْ أَوْ أَحْدَثَ فِيهَا حَدَثًا , فَلا رُجُوعَ فِيهَا , مِنْ نَحْوِ أَرْضٍ وُهِبَتْ لَهُ فَزَرَعَ فِيهَا زَرْعًا , أَوْ ثَوْبًا صَبَغَهُ , أَوْ دَارًا بَنَاهَا , أَوْ جَارِيَةً وَلَدَتْ , أَوْ بَهِيمَةً وَلَدَتْ , فَرَجَعَ فِيهَا وَاهِبُهَا إِذَا كَانَتْ عِنْدَ الْمَوْهُوبِ لَهُ , وَلا يَرْجِعُ فِي أَوْلادِهَا ، لأَنَّهُمْ إِنَّمَا وُلِدُوا عِنْدَ الْمَوْهُوبِ لَهُ , وَلَمْ يَكُونُوا فِيمَا وَهَبَ ""","","","","","Book of Gifts"
"16061","عَنْ سُفْيَانَ , قَالَ : \"إِذَا وَهَبَ رَجُلٌ لِرَجُلٍ دَرَاهِمَ ، ثُمَّ إِنَّ الْوَاهِبَ قَالَ لِلَّذِي وَهَبَ لَهُ : أَقْرِضْنِيهَا , فَأَقْرَضَهَا لَهُ , فَقَدْ صَارَتْ دَيْنًا لِلْمَوْهُوبِ لَهُ عَلَى الْوَاهِبِ , فَهِيَ بِمَنْزِلَةِ الاسْتِهْلاكِ , لا رُجُوعَ فِيهَا \"عَنْ سُفْيَانَ , قَالَ : \" لا يَرْجِعُ الْوَاهِبُ فِي هِبَتِهِ إِذَا كَانَ الْمَوْهُوبُ لَهُ غَائِبًا ""","","","","","Book of Gifts"
"16062","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قَالَ سُلَيْمَانُ بْنُ مُوسَى لِعَطَاءٍ وَأَنَا أَسْمَعُ : \"أَتَعُودُ الْمَرْأَةُ فِي إِعْطَائِهَا زَوْجَهَا , مَهْرَهَا أَوْ غَيْرَهُ ؟ قَالَ : لا ""","","","","","Book of Gifts"
"16063","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"إِذَا وَهَبَتْ لَهُ , أَوْ وَهَبَ لَهَا , فَهُوَ جَائِزٌ لِكُلِّ وَاحِدٍ مِنْهُمَا عَطِيَّتُهُ \", يَعْنِي : الزَّوْجَيْنِ يُعْطِي أَحَدُهُمَا الآخَرَ , عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زِيَادٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ , قَالَ : مِثْلَ قَوْلِ إِبْرَاهِيمَ","","","","","Book of Gifts"
"16064","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : كَانَ شُرَيْحٌ إِذَا جَاءَتْهُامْرَأَةٌ وَهَبَتْ لِزَوْجِهَا هِبَةً , ثُمَّ رَجَعَتْ فِيهَا , يَقُولُ : \" بَيِّنَتُكَ أَنَّمَا وَهَبَتْهَا لَكَ طَيِّبَةً بِهَا نَفْسُهَا , مِنْ غَيْرِ كُرْهٍ وَلا هَوَانٍ , وَإِلا فَيَمِينُهَا بِاللَّهِ مَا وَهَبَتْهَا لَكَ بِطِيبِ نَفْسِهَا , إِلا بَعْدَ كُرْهٍ لَهَا وَهَوَانٍ ""","","","","","Book of Gifts"
"16065","عَنِ الثَّوْرِيِّ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِي ، عَنْ شُرَيْحٍ , قَالَ : كَانَ يَقُولُ فِيالْمَرْأَةِ تُعْطِي زَوْجَهَا , وَالزَّوْجِ يُعْطِي امْرَأَتَهُ , قَالَ : \" أَقِيلُهَا , وَلا أَقِيلُهُ ""","","","","","Book of Gifts"
"16066","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ , قَالَ : \"مَا رَأَيْتُ الْقُضَاةَ إِلا يُقِيلُونَ الْمَرْأَةَ فِيمَا وَهَبَتْ لِزَوْجِهَا ، وَلا يُقِيلُونَ الزَّوْجَ فِيمَا وَهَبَ لامْرَأَتِهِ ""","","","","","Book of Gifts"
"16067","أَخْبَرَنَا الثَّوْرِيُّ عَنْ سُلَيْمَانَ الشَّيْبَانِي ، عَنْ أَبِي الضُّحَى ، عَنْ شُرَيْحٍ ، أَنَّامْرَأَةً جَاءَتْ تُخَاصِمُ زَوْجَهَا فِي صَدَقَةٍ تَصَدَّقَتْ عَلَيْهِ مِنْ صَدَاقِهَا ، فَقَالَ شُرَيْحٌ : \" لَوْ طَابَتْ نَفْسُهَا لَمْ تَجِئْ تَطْلُبُهُ فَلَمْ يُجِزْهُ ""","","","","","Book of Gifts"
"16068","عَنْ سُفْيَانَ الثَّوْرِيُّ ، عَنْ سُلَيْمَانَ التَّيْمِيُّ ، عَنْ أَبِي جَعْفَرٍ , قَالَ : رَأَيْتُ شُرَيْحًا وَجَاءَتْهُامْرَأَةٌ تُخَاصِمُ زَوْجَهَا , فَادَّعَى أَنَّهَا أَبْرَأَتْهُ ، فَقَالَ شُرَيْحٌ لِلْبَيِّنَةِ : \" هَلْ رَأَيْتُمُ الْوَرَقَ ؟ \" , قَالُوا : لا : \" فَلَمْ يُجِزْهُ ""","","","","","Book of Gifts"
"16069","عَنِ الثَّوْرِيِّ ، عَنْ سُلَيْمَانَ الشَّيْبَانِي ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللَّهِ الثَّقَفِي , قَالَ : كَتَبَ عُمَرُ بْنُ الْخَطَّابِ \" أَنَّالنِّسَاءَ يُعْطِينَ رَغْبَةً وَرَهْبَةً ، فَأَيُّمَا امْرَأَةٍ أَعْطَتْ زَوْجَهَا فَشَاءَتْ أَنْ تَرْجِعَ رَجَعَتْ ""","","","","","Book of Gifts"
"16070","أَخْبَرَنَا الثَّوْرِي ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِي ، عَنْ شُرَيْحٍ ، أَنَّهُ كَانَ يَقُولُ : \"تَرْجِعُ الْمَرْأَةُ فِيمَا أَعْطَتْ زَوْجَهَا مَا كَانَ حَيَّيْنِ ، فَإِذَا مَاتَا فَلا رَجْعَةَ لَهُمَا ""","","","","","Book of Gifts"
"16071","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ سُلَيْمَانَ الشَّيْبَانِي ، عَنِ الشَّعْبِي ، عَنْ شُرَيْحٍ , قَالَ : \" 000الرَّجُلُ امْرَأَتَهُ وَعَبْدَهُ ""","","","","","Book of Gifts"
"16072","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ رَجُلٍ ، عَنْ مُجَاهِدٍ , فِي قَوْلِهِ : \" فَإِنْ طِبْنَ لَكُمْ عَنْ شَيْءٍ مِنْهُ نَفْسًا , قَالَ : \" حَتَّى الْمَمَاتِ \", عَنِ ابْنِ مُجَاهِدٍ ، عَنْ أَبِيهِ مِثْلَهُ","","","","","Book of Gifts"
"16073","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ شُبْرُمَةَ , فِيالْمَرْأَةِ تَهِبُ لِزَوْجِهَا , ثُمَّ تَرْجِعُ , قَالَ : \" تُسْتَحْلَفُ مَا وَهَبَتْ لَهُ بِطِيبِ نَفْسِهَا ، ثُمَّ يُرَدُّ إِلَيْهَا مَالُهَا \" , قَالَ : \" فَأَمَّا الْمَرْأَةُ تَرَكَتْ لِزَوْجِهَا شَيْئًا قَبْلَ أَنْ يَدْخُلَ بِهَا فَإِنَّهُ جَائِزٌ \", قَالَ مَعْمَرٌ : وَلا أَعْلَمُ أَحَدًا اخْتَلَفَ فِيهِ","","","","","Book of Gifts"
"16074","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ , قَالَ : \"لَيْسَ بَيْنَ الرَّجُلِ وَامْرَأَتِهِ حِيَازَةٌ , إِذَا وَهَبَتْ لَهُ , أَوْ وَهَبَ لَهَا ""","","","","","Book of Gifts"
"16075","أَخْبَرَنَا مَعْمَرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"لَيْسَ بَيْنَهُمَا حِيَازَةٌ ""","","","","","Book of Gifts"
"16076","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ شُبْرُمَةَ , قَالَ : \"إِنْ لَمْ يَحُزْ كُلُّ وَاحِدٍ مِنْهُمَا مَا وَهَبَ لَهُ صَاحِبُهُ فَلَيْسَ بِشَيْءٍ ""","","","","","Book of Gifts"
"16077","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي لَيْلَى , قَالَ : اجْتَمَعْتُ أَنَا ، وَحَمَّادُ ، وَابْنُ شُبْرُمَةَ عند ابن نوف أمير الكوفة فيامرأة أعطاها زوجها شيئا , قَالَ ابْنُ أَبِي لَيْلَى : فَقُلْتُ أَنَا ، وَحَمَّادٌ : \" قَبْضُهَا إِعْلامُهُ ، هِيَ فِي عِيَالِهِ \" , وَقَالَ ابْنُ شُبْرُمَةَ : \" لَيْسَ لَهَا شَيْءٌ حَتَّى تَقْبِضَهُ \", قَالَ سُفْيَانُ : وَقَوْلُ ابْنِ شُبْرُمَةَ أَحَبُّ إِلَيَّ","","","","","Book of Gifts"
"16078","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ : أَنَّ عُمَرَ حَمَلَ رَجُلا عَلَى فَرَسٍ فِي سَبِيلِ اللَّهِ , ثُمَّ رَآهَا تُبَاعُ ، فَأَرَادَ عُمَرُ أَنْ يَشْتَرِيهَا , فَقَالَ لَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"لا تَعُدْ فِي صَدَقَتِكَ ""","","","","","Book of Charity"
"16079","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، كَانَتَصَدَّقَ بِفَرَسٍ , أَوْ حَمَلَ عَلَيْهَا , فَوَجَدَ بَعْضَ نِتَاجِهَا يُبَاعُ ، فَسَأَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَأَشْتَرِيهِ ؟ فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" دَعْهَا تَلْقَاهَا وَوَلَدَهَا ""","","","","","Book of Charity"
"16080","عَنْ مَعْمَرٍ ، عَنْ عَاصِمِ بْنِ سُلَيْمَانَ ، عَنْ أَبِي عُثْمَانَ النَّهْدِي , قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ :الصَّدَقَةُ لِيَوْمِهَا ، وَالسَّائِبَةُ لِيَوْمِهَا \", يَعْنِي : يَوْمَ الْقِيَامَةِ , قَالَ مَعْمَرٌ : يَعْنِي : أَنْ لَيْسَ فِيهَا رَجْعَةٌ وَلا ثَوَابٌ","","","","","Book of Charity"
"16081","عَنِ الثَّوْرِيِّ ، عَنْ سُلَيْمَانَ التَّيْمِي ، عَنْ أَبِي عُثْمَانَ النَّهْدِي ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : \"الصَّدَقَةُ وَالسَّائِبَةُ لِيَوْمِهَا \", يَعْنِي : يَوْمَ الْقِيَامَةِ","","","","","Book of Charity"
"16082","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ , قَالَ : \"يَرْجِعُ الرَّجُلُ فِي هِبَتِهِ إِذَا وَهَبَهَا ، وَهُوَ يُرِيدُ الثَّوَابَ ، وَلا يَرْجِعُ فِي صَدَقَتِهِ ""","","","","","Book of Charity"
"16083","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ , قَالَ : كَانَ ابْنُ عُمَرَ :لا يَعْتِقُ يَهُودِيًّا ، وَلا نَصْرَانِيًّا , إِلا أَنَّهُ تَصَدَّقَ مَرَّةً عَلَى ابْنِهِ بِعَبْدٍ نَصْرَانِي , فَمَاتَ ابْنُهُ ذَلِكَ , فَوَرِثَ ابْنُ عُمَرَ ذَلِكَ الْعَبْدَ النَّصْرَانِي , فَأَعْتَقَهُ مِنْ أَجْلِ أَنَّهُ كَانَ تَصَدَّقَ بِهِ \". عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : \" مَا عَلِمْنَا بِهِ بَأْسًا , وَمَا عَلِمْنَا أَحَدًا كَانَ يَكْرَهُهُ إِلا ابْنَ عُمَرَ ""","","","","","Book of Charity"
"16084","قَالَ مَعْمَرٌ عَنْ عَاصِمٍ ، عَنِ الشَّعْبِي , قَالَ : \"مَا رَدَّ عَلَيْكَ كَاتِبٌ فَهُوَ حَلالٌ ""","","","","","Book of Charity"
"16085","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : \"مَا رَدَّ عَلَيْكَ كِتَابُ اللَّهِ فَهُوَ حَلالٌ ""","","","","","Book of Charity"
"16086","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ مِنْ جُلَسَاءِ أَبِي إِسْحَاقَ , قَالَ : أَخْبَرَنِي أَنَّهُ سَأَلَ الشَّعْبِيَّ عَنْخَادِمٍ تَصَدَّقَ بِهَا عَلَى أُمِّهِ , قَالَ : وَكَانَ قِيلَ لِي : لا يَحِلُّ لَكَ أَنْ تَسْتَخْدِمَهَا , قَالَ : فَسَأَلْتُ الشَّعْبِيَّ , فَقَالَ : \" بَلَى فَاسْتَخْدِمْهَا ، وَإِذَا مَاتَتْ أُمُّكَ فَهِيَ لَكَ مِيرَاثٌ ""","","","","","Book of Charity"
"16087","عَنِ الثَّوْرِيِّ ، عَنْ عَاصِمٍ ، وَدَاوُدَ , عَنِ الشَّعْبِي ، عَنْ مَسْرُوقٍ , قَالَ : \"مَا رَدَّ عَلَيْكَ كِتَابُ اللَّهِ فَكُلْ ""","","","","","Book of Charity"
"16088","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ حُمَيْدِ بْنِ هِلالٍ : أَنَّرَجُلا تَصَدَّقَ عَلَى أُمِّهِ بِغُلامٍ , فَكَاتَبَتْهُ أُمُّهُ , فَأَدَّى طَائِفَةً مِنْ كِتَابَتِهِ , ثُمَّ مَاتَتْ أُمُّهُ , فَسَأَلَ عِمْرَانَ بْنَ الْحُصَيْنِ , فَقَالَ : \" هُوَ لَكَ , وَأَنْتَ أَحَقُّ بِهِ إِنْ شِئْتَ أَمْضَيْتَهُ لِوَجْهِ اللَّهِ الَّذِي كُنْتَ جَعَلَتَهُ لَهُ ""","","","","","Book of Charity"
"16089","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : سُئِلَ عِمْرَانُ بْنُ الْحُصَيْنِ , وَأَنَا أَسْمَعُ , أَوْ قَالَ : سَأَلْتُ عِمْرَانَ بْنَ الْحُصَيْنِ عَنْرَجُلٍ تَصَدَّقَ عَلَى أُمِّهِ بِغُلامٍ فَأَكَلَ مِنْ غَلَّتِهِ , قَالَ : \" لَيْسَ لَهُ أَجْرٌ مَا أَكَلَ مِنْهُ , أَوْ شِبْهَ هَذَا ""","","","","","Book of Charity"
"16090","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ فِيالصَّدَقَةِ : \" أَكْرَهُ أَنْ تُوَرَّثُ إِلا أَنْ يَجْعَلَهَا الْوَارِثُ فِي تِلْكَ السَّبِيلِ \", ثُمَّ ذَكَرَ لِي عَطَاءٌ شَأْنَ عَلْقَمَةَ , قَدْ كَتَبْتُهُ فِي الْوَلاءِ","","","","","Book of Charity"
"16091","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"أَحَبُّ إِلِي أَنْ لا يَأْكُلَ الصَّدَقَةَ الَّتِي تَصَدَّقَ بِهَا , وَيَأْخُذُ مِنَ الْمَالِ غَيْرَهَا ""","","","","","Book of Charity"
"16092","عَنْ عَبْدِ اللَّهِ بْنِ عَطَاءٍ ، عَنِ ابْنِ بُرَيْدَةَ ، عَنْ أَبِيهِ , قَالَ : جَاءَتِ امْرَأَةٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَتْ : يَا رَسُولَ اللَّهِ ,تَصَدَّقْتُ عَلَى أُمِّي بِجَارِيَةٍ , فَمَاتَتْ أُمِّي , فَقَالَ : \" لَكِ أَجْرُكَ , وَرَدَّهَا عَلَيْكِ الْمِيرَاثُ ""","","","","","Book of Charity"
"16093","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنِ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ : أَنَّ رَجُلا مِنَ الأَنْصَارِتَصَدَّقَ بِحَائِطٍ لَهُ , فَجَاءَ أَبُوهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ مِنْ حَاجَتِهِمْ لَهُ : فَأَعْطَاهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَبَاهُ ، ثُمَّ مَاتَ الأَبُ فَوَرِثَهَا ابْنُهُ","","","","","Book of Charity"
"16094","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، وَعَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ ، وَحُمَيْدٍ الأَعْرَجِ ، كُلُّهُمْ عَنِ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، أَنَّ عَبْدَ اللَّهِ بْنَ زَيْدٍ الأَنْصَارِي ،تَصَدَّقَ بِحَائِطٍ لَهُ , فَجَاءَ أَبُوهُ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ مِنْ حَاجَتِهِمْ , أَوْ نَحْوَ هَذَا : فَرَدَّهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى أَبِيهِ , ثُمَّ مَاتَ أَبُوهُ , فَرَدَّهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","","","","","Book of Charity"
"16095","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِي ، وَحَمَّادٍ ، وَابْنِ شُبْرُمَةَ , قَالُوا : \"لا تَجُوزُ الصَّدَقَةُ حَتَّى تُقْبَضَ ""","","","","","Book of Charity"
"16096","عَنْ هُشَيْمِ بْنِ بَشِيرٍ ، عَنِ الْمُجَالِدِ ، عَنِ الشَّعْبِي ، أَنَّ شُرَيْحًا ، وَمَسْرُوقًا \" كَانَالا يُجِيزَانِ الصَّدَقَةَ حَتَّى تُقْبَضَ ""","","","","","Book of Charity"
"16097","عَنْ هُشَيْمِ بْنِ بَشِيرٍ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنِ الشَّعْبِي , قَالَ : \"لا تَجُوزُ الصَّدَقَةُ إِلا صَدَقَةً مَقْبُوضَةً ""","","","","","Book of Charity"
"16098","عَنْ إِبْرَاهِيمَ بْنِ عُمَرَ ، عَنْ عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ , قَالَ : حَدَّثَنِي يَحْيَى بْنُ جَعْدَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : \"اللاعِبُ وَالْجَادُّ فِي الصَّدَقَةِ سَوَاءٌ \", عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ نُجَيٍّ ، عَنْ عَلِي مِثْلَهُ","","","","","Book of Charity"
"16099","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ عَلِيًّا ، وَابْنَ مَسْعُودٍ كَانَا \"يُجِيزَانِ الصَّدَقَةَ وَإِنْ لَمْ تُقْبَضْ \" , قَالَ : وَكَانَ مُعَاذُ بْنُ جَبَلٍ , وَشُرَيْحٌ : \" لا يُجِيزَانِهَا حَتَّى تُقْبَضَ \", وَقَوْلُ مُعَاذٍ , وَشُرَيْحٍ , أَحَبُّ إِلَى سُفْيَانَ","","","","","Book of Charity"
"16100","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"إِذَا أُعْلِمَتِ الصَّدَقَةُ فَهِيَ جَائِزَةٌ ، وَإِنْ لَمْ تُقْبِضْ \", يَقُولُ : عَبْدًا , قَرَّ , أَوْ أَمَةً , أَوْ دَارًا , وَهَذَا النَّحْوُ","","","","","Book of Charity"
"16101","عَنْ سُفْيَانَ , قَالَ :لَوْ قَالَ رَجُلٌ لِرَجُلٍ : \" تَصَدَّقْ بِمَالِي عَلَى مَنْ شِئْتَ , لَمْ يَكُنْ لَهُ لِيَأْخُذَهُ لِنَفْسِهِ ، وَلَكِنْ لِيُعْطِيَهُ ذَا رَحِمٍ , أَوْ وَلَدًا إِنْ شَاءَ ""","","","","","Book of Charity"
"16102","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ , \"فِي رَجُلٍ تَصَدَّقَ عَلَى قَوْمٍ وَهُوَ مَرِيضٌ بِشَيْءٍ فَلَمْ يَقْبِضُوهُ حَتَّى مَاتَ الْمَتَّصَدِّقُ , قَالَ : \" هُوَ فِي الثُّلُثِ \", عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِي , قَالَ : لَيْسَ بِشَيْءٍ","","","","","Book of Charity"
"16103","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : \"لا تَجُوزُ لامْرَأَةٍ عَطِيَّةٌ فِي مَالِهَا حَتَّى تَلِدَ , أَوْ تَبْلُغَ إِنَاهُ ، وَذَلِكَ سُنَّةٌ ، وَحَتَّى تُحِبَّ الْمَالَ وَاحْتِجَابَهُ ، وَحَتَّى تُحِبَّ الرِّبْحَ , وَتَكْرَهُ الْغَبْنَ ""","","","","","Book of Charity"
"16104","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ , قَالَ : \"لا تَجُوزُ لامْرَأَةٍ عَطِيَّةٌ فِي مَالِهَا حَتَّى تَلِدَ , أَوْ تَبْلُغَ إِنَاهُ , وَذَلِكَ سُنَّةً \", عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ مِثْلَهُ","","","","","Book of Charity"
"16105","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ : \"بَلَغَنِي أَنَّهُ لا يَجُوزُ لامْرَأَةٍ حَدَثٌ فِي مَالِهَا حَتَّى تَلِدَ , أَوْ يَمْضِي عَلَيْهَا حَوْلٌ فِي بَيْتِهَا , بَعْدَمَا يَدْخُلَ عَلَيْهَا \" , قُلْتُ : وَلا عَطَاءٌ , وَلا عَتَاقَةٌ ، وَلا شَيْءٌ فِي سَبِيلِ اللَّهِ إِلا بِرَأْيِ الْوَالِدِ ؟ قَالَ : \" نَعَمْ \" ، قُلْتُ لِعَطَاءٍ : أَثَبَتَ ؟ قَالَ : \" نَعَمْ , زَعِمُوا ""","","","","","Book of Charity"
"16106","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّ أَبَا الشَّعْثَاءِ , قَالَ : \"لا يَجُوزُ لِعَانِقٍ عَطَاءٌ حَتَّى تَلِدَ شِرْوَاهَا \", قُلْتُ لِعَمْرٍو : أَفَرَأَيْتَ الْعِتَاقَةُ ؟ قَالَ : سَوَاءٌ كُلُّ ذَلِكَ","","","","","Book of Charity"
"16107","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : إِنْكَبِرَتْ وَعَنَسَتْ يَعْنِي بِالْعَنْسِ : الْكِبَرَ وَهِيَ عَانِقٌ لَمْ تُزَوَّجْ بَعْدُ فِي بَيْتِهَا , وَلَمْ تُنْكَحْ كَيْفَ ؟ قَالَ : \" يَجُوزُ لَهَا , إِنَّمَا ذَلِكَ فِي الْجَارِيَةِ الْحَدِيثَةِ , فَإِذَا كَبُرَتْ وَعَلِمَتْ جَازَ لَهَا ""","","","","","Book of Charity"
"16108","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : \"إِذَا أَعْطَتِ الْمَرْأَةُ الْحَدِيثَةُ ذَاتُ الزَّوْجِ قَبْلَ السَّنَةِ عَطِيَّةً ، وَلَمْ تَرْجِعْ حَتَّى تَمُوتَ فَهُوَ جَائِزٌ \", قَالَ أَيُّوبُ : وَمَا رَأَيْتُ النَّاسَ تَابَعُوهُ عَلَى ذَلِكَ","","","","","Book of Charity"
"16109","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"لا يَجُوزُ لامْرَأَةٍ شَيْءٌ فِي مَالِهَا إِلا بِإِذْنِ زَوْجِهَا , إِذَا هُوَ مَلَكَ عِصْمَتِهَا ""","","","","","Book of Charity"
"16110","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ , قَالَ : قَضَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُلَيْسَ لِذَاتِ زَوْجٍ وَصِيَّةً فِي مَالِهَا شَيْئًا إِلا بِإِذْنِ زَوْجِهَا","","","","","Book of Charity"
"16111","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : جَعَلَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ لِلْمَرْأَةِإِذَا اخْتَلَفَتْ هِيَ وَزَوْجُهَا فِي مَالِهَا , فَقَالَتْ : أُرِيدُ أَنْ أَصِلَ مَا أَمَرَ اللَّهُ بِهِ , وَقَالَ هُوَ : تُضَارُّنِي \" فَأَجَازَ لَهَا الثُّلُثَ فِي حَيَاتِهَا ""","","","","","Book of Charity"
"16112","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : \"إِذَا أَعْطَتِ الْمَرْأَةُ مِنْ مَالِهَا مِنْ غَيْرِ سَفَهٍ ، وَلا ضَرَرٍ جَازَتْ عَطِيَّتُهَا ، وَإِنْ كَرِهَ زَوْجُهَا ""","","","","","Book of Charity"
"16113","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سِمَاكٍ , قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ فِيامْرَأَةٍ أَعْطَتْ مِنْ مَالِهَا \" إِنْ كَانَتْ غَيْرَ سَفِيهَةٍ ، وَلا مُضَارَّةٍ فَأَجِزْ عَطِيَّتَهَا ""","","","","","Book of Charity"
"16114","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ عَائِشَةَ , قَالَتْ : جَاءَتْ هِنْدٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَتْ : يَا رَسُولَ اللَّهِ , وَاللَّهِمَا كَانَ عَلَى ظَهْرِ الأَرْضِ أَهْلُ خِبَاءٍ أَحَبَّ إِلَيَّ أَنْ يُذِلَّهُمُ اللَّهُ مِنْ أَهْلِ خِبَائِكَ , وَمَا عَلَى ظَهْرِ الأَرْضِ أَهْلُ خِبَاءٍ أَحَبُّ إِلَيَّ أَنْ يُعِزَّهُمُ اللَّهُ مِنْ أَهْلِ خِبَائِكَ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : وَأَيْضًا وَالَّذِي نَفْسِي بِيَدِهِ, قَالَ مَعْمَرٌ : يَعْنِي لَتَزْدَادِنَّ","","","","","Book of Charity"
"16115","ثُمَّ قَالَتْ : يَا رَسُولَ اللَّهِ , إِنَّ أَبَا سُفْيَانَرَجُلٌ مُمْسِكٌ فَهَلْ عَلَيَّ جَنَاحٌ أَنْ أُنْفِقَ عَلَى عِيَالِهِ مِنْ مَالِهِ بِغَيْرِ إِذْنِهِ ؟ فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لا حَرَجَ عَلَيْكِ أَنْ تُنْفِقِي عَلَيْهِمْ بِالْمَعْرُوفِ""","","","","","Book of Charity"
"16116","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ ، عَنْ أَبِيهِ حَدَّثَهُ ، عَنْ عَائِشَةَ : أَنَّ هِنْدَ أُمَّ مُعَاوِيَةَ ، جَاءَتْ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَتْ : يَا رَسُولَ اللَّهِ , إِنَّ أَبَا سُفْيَانَرَجُلٌ شَحِيحٌ , وَإِنَّهُ لا يُعْطِينِي إِلا مَا أَخَذْتُ مِنْهُ وَهُوَ لا يَعْلَمُ , قَالَتْ : فَهَلْ عَلَيَّ فِي ذَلِكَ شَيْءٌ ؟ قَالَ : \" خُذِي مَا يَكْفِيكِ وَبَنِيكِ بِالْمَعْرُوفِ ""","","","","","Book of Charity"
"16117","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ أَبِي مُلَيْكَةَ ، أَنَّ أَسْمَاءَ ابْنَةَ أَبِي بَكْرٍ ، قَالَتْ : يَا رَسُولَ اللَّهِ , مَا لِي شَيْءٌ إِلا مَا يُدْخِلُ عَلَيَّ الزُّبَيْرُ , أَفَأُنْفِقُ مِنْهُ ؟ فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"أَنْفِقِي وَلا تُوكِي فَيُوكِيَ عَلَيْكِ ""","","","","","Book of Charity"
"16118","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :لا يَحِلُّ لامْرَأَةٍ مِنْ مَالِ زَوْجِهَا إِلا الرُّطَبُ, قَالَ قَتَادَةُ : يَعْنِي : مَا لا يُدَّخَرُ , الْخُبْزُ , وَاللَّحْمُ , وَالصُّبْغُ","","","","","Book of Charity"
"16119","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ , قَالَ : قَالَ رَجُلٌ : يَا رَسُولَ اللَّهِ , إِنَّامْرَأَتِي تُعْطِي مِنْ مَالِي بِغَيْرِ إِذْنِي , قَالَ : \" فَأَنْتُمَا شَرِيكَانِ فِي الأَجْرِ \" , قَالَ : فَإِنِّي أَمْنَعُهَا , قَالَ : \" فَلَكَ مَا بَخَلْتَ بِهِ , وَلَهَا مَا أَحْسَنَتْ ""","","","","","Book of Charity"
"16120","عَنْ إِسْرَائِيلَ , قَالَ : حَدَّثَنِي سِمَاكُ بْنُ حَرْبٍ ، عَنْ عِكْرِمَةَ مَوْلَى ابْنِ عَبَّاسٍ , قَالَ : كُنْتُ عِنْدَ ابْنِ عَبَّاسٍ , فَأَتَتْهُ امْرَأَةٌ ، فَقَالَتْ :أَيَحِلُّ لِي أَنْ آخُذَ مِنْ دَرَاهِمَ زَوْجِي ؟ قَالَ : \" يَحِلُّ لَهُ أَنْ يَأْخُذَ مِنْ حُلِيَّكِ ؟ \" , قَالَتْ : لا ، قَالَ : \" فَهُوَ أَعْظَمُ عَلَيْكَ حَقًّا ""","","","","","Book of Charity"
"16121","عَنْ عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ، عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّهُ سُئِلَ عَنِالْمَرْأَةِ تَصَدَّقُ مِنْ مَالِ زَوْجِهَا , قَالَ : \" لا , إِلا مِنْ قُوتِهَا , وَالأَجْرُ بَيْنَهَا وَبَيْنَ زَوْجِهَا ، وَلا يَحِلُّ لَهَا أَنْ تَصَدَّقَ بِشَيْءٍ مِنْ مَالِ زَوْجِهَا إِلا بِإِذْنِهِ ""","","","","","Book of Charity"
"16122","أَخْبَرَنَا الثَّوْرِيُّ , عَنِ الأَعْمَشِ ، عَنْ شَقِيقٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَةَ , قَالَتْ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"إِذَا أَنْفَقَتِ الْمَرْأَةُ مِنْ طَعَامِ زَوْجِهَا غَيْرَ مُفْسِدَةٍ كَانَ لَهَا أَجْرُهَا ، وَلِزَوْجِهَا مِثْلُ ذَلِكَ , وَلا يُنْقِصُ أَحَدٌ مِنْهُمَا صَاحِبَهُ شَيْئًا ، وَلِلْخَازِنِ مِثْلُ ذَلِكَ , لَهَا بِمَا أَنْفَقَتْ , وَلَهُ بِمَا اكْتَسَبَ ""","","","","","Book of Charity"
"16123","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنْ قَيْسِ بْنِ أَبِي حَازِمٍ ، عَنِ امْرَأَةٍ : أَنَّهَا كَانَتْ عِنْدَ عَائِشَةَ فَسَأَلَتْهَا امْرَأَةٌأَتَصَدَّقُ الْمَرْأَةُ مِنْ بَيْتِ زَوْجِهَا ؟ قَالَتْ : \" نَعَمْ , مَا لَمْ تَقِ مَالَهَا بِمَالِهِ ""","","","","","Book of Charity"
"16124","عَنْ إِسْمَاعِيلَ بْنِ عَيَّاشٍ ، عَنْ شُرَحْبِيلَ بْنِ مُسْلِمٍ الْخَوْلانِيِّ ، عَنْ أَبِي أُمَامَةَ الْبَاهِلِيِّ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : \"لا تُنْفِقُ امْرَأَةٌ شَيْئًا مِنْ بَيْتِ زَوْجِهَا إِلا بِإِذْنِ زَوْجِهَا \" , قِيلَ : يَا رَسُولَ اللَّهِ , وَلا الطَّعَامَ , قَالَ : \" ذَلِكَ أَفْضَلُ أَمْوَالِنَا ""","","","","","Book of Charity"
"16125","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ , قَالَ : كَتَبَ عُمَرُ بْنُ الْخَطَّابِ :\" يَعْتَصِرُ الرَّجُلُ مِنْ وَلَدِهِ مَا أَعْطَاهُ مِنْ مَالِهِ , مَا لَمْ يَمُتْ أَوْ يَسْتَهْلِكْهُ , أَوْ يَقَعْ فِيهِ دَيْنٌ \", أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ عِكْرِمَةَ , قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ بِمِثْلِ ذَلِكَ","","","","","Book of Charity"
"16126","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : \"يَعْتَصِرُ الرَّجُلُ مِنْ وَلَدِهِ مَا أَعْطَاهُ مِنْ مَالِهِ ، وَلا يَعْتَصِرُ الْوَلَدُ الْوَالِدَ مَا أَعْطَاهُ مِنْ مَالِهِ لِحَقِّهِ عَلَيْهِ ""","","","","","Book of Charity"
"16127","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ , قَالَ : \"يَأْخُذُ الرَّجُلُ مِنْ مَالِ ابْنِهِ مَا شَاءَ ، وَإِنْ كَانَتْ جَارِيَةً تَسَرَّاهَا إِنْ شَاءَ \", قَالَ قَتَادَةُ : لا يُعْجِبُنِي مَا قَالَ فِي الْجَارِيَةِ","","","","","Book of Charity"
"16128","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ , قَالَ : \"لا يَأْخُذُ الرَّجُلُ مِنْ مَالِ وَلَدِهِ شَيْئًا إِلا أَنْ يَحْتَاجَ , فَيَسْتَنْفِقُ بِالْمَعْرُوفِ , يَعُولُهُ ابْنُهُ كَمَا كَانَ الأَبُ يَعُولُهُ ، فَأَمَّا إِذَا كَانَ الأَبُ مُوسِرًا فَلَيْسَ لَهُ أَنْ يَأْخُذَ مَالَ ابْنِهِ , فَيَقِي بِهِ مَالَهُ , أَوْ يَضَعَهُ فِيمَا لا يَحِلُّ ""","","","","","Book of Charity"
"16129","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , أَوْ قَالَ أَبُو بَكْرٍ ، أَوْ قَالَ عُمَرُ ,لِرَجُلٍ عَابَ عَلَى ابْنِهِ شَيْئًا مَنَعَهُ : \" ابْنُكَ سَهْمٌ مِنْ كِنَانَتِكَ ""","","","","","Book of Charity"
"16130","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ الْمُنْكَدِرِ ، قَالَ : جَاءَ رَجُلٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنَّ لِي مَالا ، وَإِنَّ لِي عِيَالا ، وَإِنَّ لأَبِي مَالا ، وَعِيَالا , وَأَبِي يُرِيدُ أَنْ يَأْخُذَ مَالِي , قَالَ : \"أَنْتَ وَمَالُكَ لأَبِيكَ ""","","","","","Book of Charity"
"16131","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : فَأَبُوهُ غَنِيٌّ عَنْهُ ؟ قَالَ : \"فَلا يُضَارَّهُ أَبُوهُ وَابْنُهُ كَارِهٌ \" , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَادَ أَبُوهُ أَنْ يَزْدَادَ فِي نِسَائِهِ , وَفِي طَعَامِهِ , وَعَيْشِهِ , قَالَ : \" أَبُوهُ أَحَقُّ بِهِ مَا لَمْ يَذْهَبْ بِهِ إلى غَيْرُهُ \" , رَاجَعْتُهُ فِيهَا , فَقَالَ : هَكَذَا ، وَرَدَدْتُهَا عَلَيْهِ ، فَقَالَ : \" أَبُوهُ أَحَقُّ بِهِ ""","","","","","Book of Charity"
"16132","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ : كَانَ يُقَالُ \" مَا أَغْنَى عَنْهُ مَالُهُ وَمَا كَسَبَ , \" وَلَدُهُ كَسْبُهُ \", وَمُجَاهِدٌ , وَعَائِشَةُ قَالاهُ","","","","","Book of Charity"
"16133","عَنْ مَعْمَرٍ ، عَنِ ابْنِ خُثَيْمٍ ، عَنْ أَبِي الطُّفَيْلِ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : \"وَلَدُهُ كَسْبُهُ ""","","","","","Book of Charity"
"16134","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : \"يَنَالُ الرَّجُلُ مِنْ مَالِ ابْنِهِ بِالْمَعْرُوفِ ""","","","","","Book of Charity"
"16135","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : سَمِعْتُ عَطَاءً , يَقُولُ : \"لِيُؤَاجِرُ الرَّجُلُ ابْنَهُ فِي الْعَمَلِ إِذَا كَانَ أَبُوهُ ذَا حَاجَةٍ ""","","","","","Book of Charity"
"16136","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَ رَجُلٌ مِنْ أَهْلِ الْعِلْمِ عَطَاءً , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :مَالُ الْوَلَدِ طَيِّبُهُ أَطْيَبُ الطِّيبَةِ","","","","","Book of Charity"
"16137","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ ابْنَ حُسَيْنٍ , يَقُولُ :رَجُلٌ خَاصَمَ أَبَاهُ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَنْتَ وَمَالُكَ لَهُ \" ، ثُمَّ أَمَرَ بِهِ , قُلْتُ لَهُ : ثُمَّ قَالَ : \" انْطَلِقْ بِهِ , فَإِنْ غَلَبَكَ فَأَطْلِعْنِي عَلَى ذَلَكَ , أُعِنْكَ عَلَيْهِ \", قَالَ : ثُمَّ انْطَلَقَ رَجُلٌ خَاصَمَ أَبَاهُ إِلَى عَلِيٍّ كَمِثْلِ هَذِهِ الْقِصَّةِ","","","","","Book of Charity"
"16138","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ : أَنَّ رَجُلا قَالَ : يَا رَسُولَ اللَّهِ , إِنَّأَبِي يَسْأَلُنِي مَالِي , قَالَ : \" فَأَعْطِهِ إِيَّاهُ \" , قَالَ : فَإِنَّهُ يُرِيدُ أَنْ أَخْرُجَ لَهُ مِنْهُ , قَالَ : \" فَاخْرُجْ لَهُ مِنْهُ \" , قَالَ : وَقَالَ رَجُلٌ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُوصِيهِ : \" لا تَعْصِ وَالِدَيْكَ , فَإِنْ سَأَلاكَ أَنْ تَنْخَلِعَ لَهُمَا مِنْ دُنْيَاكَ , فَانْخَلِعْ لَهُمَا مِنْهَا ""","","","","","Book of Charity"
"16139","عَنْ مَعْمَرٍ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ : أَنَّ رَجُلا قَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُوصِيهِ : \"بِرَّ بِوَالِدَيْكَ ، وَإِنْ أَمَرَاكَ أَنْ تَخْتَلِعَ مِنْ مَالِكِ كُلِّهِ فَافْعَلْ ""","","","","","Book of Charity"
"16140","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :سُنَّةُ الْجَدِّ فِيمَا يَنَالُ مِنْ مَالِ ابْنِ ابْنِهِ كَسُنَّةِ الأبِ فِيمَا يَنَالُ مِنْ مَالِ ابْنِهِ كَارِهًا ؟ قَالَ : \" إنِ احْتِيجَ فَنَعَمْ , يَأْخُذُ صَاحِبُهُ قَطُّ \" , قُلْتُ : وَإِنْ كَانَ مُغْرَمًا ؟ قَالَ : \" نَعَمْ , فَأَمَّا مِنْ غَيْرِ حَاجَةٍ فَلَيْسَ كَهَيْئَةِ الأبِ ""","","","","","Book of Charity"
"16141","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : وَلايَأْخُذُ الْجَدُّ مِنْ مَالِ ابْنِ ابْنِهِ كَارِهًا وَهُوَ غَنِيٌّ عَنْهُ , وَإِنْ لَمْ يَذْهَبْ بِهِ إِلَى غَيْرِهِ ؟ قَالَ : \" لا , وَلَيْسَ كَهَيْئَةِ الْوَالِدِ ""","","","","","Book of Charity"
"16142","عَنِ الثَّوْرِيِّ , قَالَ : \"يُجْبَرُ الرَّجُلُ عَلَى نَفَقَةِ جَدِّهِ أَبِي أَبِيهِ ""","","","","","Book of Charity"
"16143","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ , قَالَ : \"إِذَا كَانَتْ أُمُّ الْيَتِيمِ مُحْتَاجَةً أَنْفَقَ عَلَيْهَا مِنْ مَالِهِ , يَدُهَا مَعَ يَدِهِ \" ، قِيلَ فَالْمُوسِرَةُ ؟ قَالَ : \" لا شَيْءَ لَهَا ""","","","","","Book of Charity"
"16144","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :الْيَتِيمُ أُمُّهُ مُحْتَاجَةٌ أَيُنْفِقُ عَلَيْهَا مِنْ مَالِهِ ؟ قَالَ عَطَاءٌ : \" أَلَيْسَ لَهَا شَيْءٌ ؟ \" ، قُلْتُ : لا , قَالَ : \" نَعَمْ ، لا يَأْكُلُ مَالَهُ أَحَقُّ مِنْهَا \" , قَالَ : قُلْتُ لِعَطَاءٍ : فَكَانَتْ أَمَةً لَمْ تُعْتَقْ ، أَتُعْتَقُ فِيهِ ؟ قَالَ : \" نَعَمْ يُكْرَهُ عَلَى إعْتَاقِهَا إِنْ لَمْ يَتَمَتَّعُوا بِهَا وَيَحْتَاجُوهُ ""","","","","","Book of Charity"
"16145","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ عُمَارَةَ بْنِ عُمَيْرٍ ، عَنْ عَمَّةٍ لَهُ , سَأَلْتُ عَائِشَةَ عَنْ يَتِيمٍ فِي حِجْرِهَا تُصِيبُ مِنْ مَالِهِ ؟ فَقَالَتْ عَائِشَةُ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّأَطْيَبَ مَا أَكَلَ الرَّجُلُ مِنْ كَسْبِهِ ، وَإِنَّ وَلَدَهُ مِنْ كَسْبِهِ ""","","","","","Book of Charity"
"16146","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، عَنْ خَالٍ لَهُ ، سَأَلَ سَعِيدَ بْنَ جُبَيْرٍ :وَرِثَ مِنِ امْرَأَتِهِ خَادِمًا هُوَ وَوَلَدُهُ , فَأَرَادَ أَنْ يَقَعَ عَلَى الْخَادِمِ ، فَقَالَ سَعِيدٌ : \" اكْتُبْ ثَمَنَهَا عَلَيْكَ دَيْنًا لِوَلَدِكِ , ثُمَّ تَقَعُ عَلَيْهَا ""","","","","","Book of Charity"
"16147","عَنْ بَكَّارٍ ، أَنَّهُ سَمِعَ وَهْبًا ، يَقُولُ لِرَجُلٍ مِثْلَ قَوْلِ سَعِيدِ بْنِ جُبَيْرٍ : \"اكْتُبْ ثَمَنَهَا لِوَلَدِكَ , ثُمَّ قَعْ عَلَيْهَا ""","","","","","Book of Charity"
"16148","أَخْبَرَنَا الثَّوْرِيُّ عَنْ عَمْرِو بْنِ قَيْسٍ ، عَنْ جَدَّةٍ لَهُ , قَالَتْ : خَاصَمْتُ إِلَى شُرَيْحٍ فِيخَادِمٍ لِي أَصْدَقَهَا أَبِي امْرَأَتَهُ , فَخَاصَمْتُهُ إِلَى شُرَيْحٍ \" فَقَضَى لِي بِالخَادِمِ , وَقَضَى لِي أَنْ أَدْفَعَ إِلَى امْرَأَتِهِ قِيمَتَهَا ""","","","","","Book of Charity"
"16149","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :أَيَنَالُ الرَّجُلُ مِنْ مَالِ ابْنِهِ بِغَيْرِ أَمْرِ ابْنِهِ شَيْئًا ؟ ابْنُهُ مُحْتَاجٌ , وَأَبُوهُ يَسْتَخْدِمُهُ ؟ قَالَ : \" لا , وَلْيَتَّقِ اللَّهَ عَزَّ وَجَلَّ أَبُوهُ فِيهِ ""","","","","","Book of Charity"
"16150","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , أَنَّ أَبَا الشَّعْثَاءِ \" كَانَلا يَرَى بَأْسًا بِأَنْ يَأْكُلَ الرَّجُلُ مِنْ مَالِ ابْنِهِ مَا يَأْكُلُ قَطُّ بِغَيْرِ ابْنِهِ إِذَا أَعْيَاهُ أَبُوهُ فَلَمْ يُنْفِقْ عَلَيْهِ ""","","","","","Book of Charity"
"16151","عَنِ الثَّوْرِيِّ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ , قَالَ : \"كُلُّ وَارِثٍ يُجْبَرُ عَلَى وَارِثِهِ فِي النَّفَقَةِ إِنْ لَمْ تَكُنْ لَهُ حِيلَةٌ ""","","","","","Book of Charity"
"16152","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ , قَالَ : \"يُجْبَرُ الرَّجُلُ عَلَى نَفَقَةِ وَالِدَيْهِ وَإِنْ كَانَا مُشْرِكَيْنِ , وَعَلَى نَفَقَةِ جَدِّهِ أَبِي أَبِيهِ ، وَعَلَى نَفَقَةِ وَلَدِهِ مَا كَانُوا صِغَارًا , فَإِذَا بَلَغُوا الْحُلُمَ لَمْ يُجْبَرْ عَلَى نَفَقَتِهِمْ \" , قَالَ : \" وَالأُمُّ لا تُجْبَرُ عَلَى نَفَقَةِ وَلَدِهِا صِغَارًا كَانُوا أَمْ كِبَارًا , وَإِنْ كَانَتْ غَنِيَّةً ""","","","","","Book of Charity"
"16153","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"المُدَبَّرُ مِنَ الثُّلُثِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16154","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبْجَرَ ، عَنِ الشَّعْبِيِّ ، عَنْ شُرَيْحٍ \" أَنَّهُكَانَ يَجْعَلُ الْمُدَبَّرَ مِنَ الثُّلُثِ \"، وَأَنَّ مَسْرُوقًا : \" كَانَ يُخْرِجُهُ فَارِغًا مِنْ غَيْرِ الثُّلُثِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16155","عَنِ الثَّوْرِيِّ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِي ، أَنَّ عَلِيًّا \"جَعَلَ الْمُدَبَّرَ مِنَ الثُّلُثِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16156","عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ ، وَحَمَّادٍ , قَالُوا : \"الْمُدَبَّرُ فِي الثُّلُثِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16157","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، وَعُمَرَ بْنِ عَبْدِ الْعَزِيزِ , قَالا : \"الْمُدَبَّرُ وَصِيَّةٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16158","عَنِ الثَّوْرِيِّ , فِيالْعَبْدِ بَيْنَ الرَّجُلَيْنِ يُدَبِّرُهُ أَحَدُهُمَا , وَيُمْسِكُ الآخَرُ , قَالَ : \" أَحَبُّ إِلَيْنَا تَعْجِيلُ الْقِيمَةِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16159","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ : أَنَّرَجُلا أَعْتَقَ غُلامًا لَهُ عَنْ دُبُرٍ مِنْهُ فَجَعَلَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنَ الثُّلُثِ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16160","عَنِ الثَّوْرِيِّ ، عَنْ خَالِدٍ ، عَنْ أَبِي قِلابَةَ : أَنَّ رَجُلا مِنَ الأَنْصَارِدَبَّرَ غُلامًا لَهُ لَمْ يَدَعْ غَيْرَهُ فَأَعْتَقَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثُلُثَهَ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16161","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَيُدَبِّرُ الرَّجُلُ عَبْدَهُ لَيْسَ لَهُ مَالٌ غَيْرُهُ ؟ قَالَ : لا , ثُمَّ ذَكَرَ مَقَالَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيالْعَبْدِ الَّذِي دُبِّرَ عَلَى عَهْدِهِ , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : اللَّهُ أَغْنَى عَنْهُ مِنْ فُلانٍ, ثُمَّ تَلا عَطَاءٌ :  وَالَّذِينَ إِذَا أَنْفَقُوا لَمْ يُسْرِفُوا وَلَمْ يَقْتُرُوا , وَذَكَرَ مَا قَالَ فِي الرَّجُلِ يَتَصَدَّقُ بِمَالِهِ كُلِّهِ , وَيَجْلِسُ لا مَالَ لَهُ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16162","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"بَاعَ مُدَبَّرًا احْتَاجَ سَيِّدُهُ إِلَى ثَمَنِهِ \", عَنْ مَعْمَرٍ ، عَنِ ابْنِ الْمُنْكَدِرِ مِثْلَهُ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16163","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ :أُعْتِقَ رَجُلٌ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَبْدًا لَهُ , لَيْسَ لَهُ مَالٌ غَيْرُهُ عَنْ دُبُرٍ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَنْ يَبْتَاعَهُ مِنِّي ؟ \" , فَقَالَ نُعَيْمُ بْنُ عَبْدِ اللَّهِ الْعَدَوِيُّ : أَنَا أَبْتَاعَهُ , فَابْتَاعَهُ, قَالَ عَمْرٌو : قَالَ جَابِرٌ : غُلامًا قِبْطِيًّا مَاتَ عَامَ أَوَّلَ , وَزَادَ فِيهِ أَبُو الزُّبَيْرِ , يُقَالُ لَهُ : يَعْقُوبُ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16164","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ : سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ :دَبَّرَ رَجُلٌ مِنَ الأَنْصَارِ غُلامًا لَهُ لَمْ يَكُنْ لَهُ مَالٌ غَيْرُهُ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَنْ يَبْتَاعُهُ مِنِّي ؟ \" , فَاشْتَرَاهُ رَجُلٌ مِنْ بَنِي عَدِيِّ بْنِ كَعْبِ بْنِ النَّحَّامِ. قَالَ عَمْرٌو : قَالَ جَابِرٌ : غُلامًا قِبْطِيًّا , مَاتَ عَامَ أَوَّلَ فِي إِمَارَةِ ابْنِ الزُّبَيْرِ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16165","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ , قَالَ :أَعْتَقَ أَبُو مَذْكُورٍ غُلامًا لَهُ , يُقَالُ لَهُ : يَعْقُوبُ القِبْطِيُّ , عَنْ دُبُرٍ مِنْهُ , فَبَلَغَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : \" أَلَهُ مَالٌ غَيْرُهُ ؟ \" , قَالُوا : لا , قَالَ : \" مَنْ يَشْتَرِيهِ مِنِّي ؟ \" , قَالَ : فَاشْتَرَاهُ نُعَيْمُ بْنُ النَّحَّامِ خَتِنِ عُمَرَ بْنِ الْخَطَّابِ بِثَمَانِمِائَةٍ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَنْفِقْ عَلَى نَفْسِكِ , فَإِنْ كَانَ فَضْلٌ فَعَلَى أَهْلِكَ ، وَإِنْ كَانَ فَضْلٌ فَعَلَى أَقَارِبِكَ ، وَإِنْ كَانَ فَضْلٌ فَاقْسِمْ هَاهُنَا وَهَهُنَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16166","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : يُدَبِّرُ الرَّجُلُ عَبْدَهُ لَيْسَ لَهُ مَالٌ غَيْرُهُ ؟ قَالَ : لا , ثُمَّ ذَكَرَ مَا قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيالْعَبْدِ الَّذِي دَبَّرَ عَلَى عَهْدِهِ , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : اللَّهُ أَغْنَى عَنْهُ مِنْ فُلانٍ, ثُمَّ تَلا عَطَاءٌ :  وَالَّذِينَ إِذَا أَنْفَقُوا لَمْ يُسْرِفُوا وَلَمْ يَقْتُرُوا , وَذَكَرَ مَا قَالَ : فِي الرَّجُلِ يَتَصَدَّقُ بِمَالِهِ , وَيَجْلِسُ لا مَالَ لَهُ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16167","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ , قَالَ : سَأَلَنِي ابْنُ الْمُنْكَدِرِ عَنِالْمُدَبَّرِ , قَالَ : \" كَيْفَ كَانَ أَبُوكَ يَقُولُ فِيهِ ؟ هَلْ كَانَ يَبِيعُهُ صَاحِبُهُ ؟ \" , قَالَ : نَعَمْ, قَالَ : قُلْتُ : \" إِنِ احْتَاجَ ؟ \" , فَقَالَ ابْنُ الْمُنْكَدِرِ : \" وَإِنْ لَمْ يَحْتَجْ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16168","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَمَّنْ حَدَّثَهُ ، عَنْ عَمْرَةَ , قَالَتْ : مَرِضَتْ عَائِشَةُ فَتَطَاوَلَ مَرَضُهَا , قَالَتْ : فَذَهَبَ بَنُو أَخِيهَا إِلَى رَجُلٍ فَذَكَرُوا مَرَضَهَا , فَقَالَ : إِنَّكُمْ تُخْبِرُونِي خَبَرَ امْرَأَةٍ مَطْبُوبَةٍ , قَالَ : فَذَهَبُوا يَنْظُرُونَ , فَإِذَاجَارِيَةٌ لَهَا سَحَرَتْهَا , وَكَانَتْ قَدْ دَبَّرَتْهَا , فَدَعَتْهَا فَسَأَلَتْهَا , فَقَالَتْ : \" مَاذَا أَرَدْتِ ؟ \" , قَالَتْ : أَرَدْتُ أَنْ تَمُوتِي حَتَّى أَعْتَقَ , قَالَتْ : \" فَإِنَّ لِلَّهِ عَلَيَّ أَنْ تُبَاعِي مِنْ أَشَدِّ الْعَرَبِ مِلْكَةً , فَبَاعَتْهَا , وَأَمَرَتْ بِثَمَنِهَا فَجُعِلَ فِي مِثْلِهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16169","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ \"بَاعَ مُدَبَّرًا أَحَاطَ دَيْنُ صَاحِبِهِ بِرَقَبَتِهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16170","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : \"إِذَا كَانَ عَلَى سَيِّدِهِ دَيْنٌ اسْتَسْعَى فِي ثَمَنِهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16171","عَنْ مَعْمَرٍ ، عَنْ عَمْرِو بْنِ مُسْلِمٍ ، عَنْ طَاوُسٍ , قَالَ : \"يَعُودُ الرَّجُلُ فِي مُدَبَّرِهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16172","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّ طَاوُسًا \" كَانَلا يَرَى بَأْسًا أَنْ يَعُودَ الرَّجُلُ فِي عَتَاقَتِهِ \", قَالَ عَمْرٌو : وَأَمَرَنِي أَنْ أَكْتُبَ لِسَرِيَّةٍ لَهُ تَدْبِيرًا , فَقُلْتُ لَهُ : أَتَشْتَرِطُ إِلا أَنْ تَرَى رَأْيَكَ ؟ قَالَ : وَلِمَ ؟ فَعَرَفْتُ أَنَّهُ يَقُولُ : أَوَ لَيْسَ يَحِقُّ لِي أَنْ أَرْجِعَ فِيهَا إنْ شِئْتُ ؟ فَقُلْتُ لَهُ : إِنَّ الْقُضَاةَ لا يَقْضُونَ بِذَلِكَ الْيَوْمَ , فأَمَرَنِي أَنْ أَكْتُبَ لَهُ مَا قُلْتُ لَهُ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16173","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، وَعُمَرَ بْنِ عَبْدِ الْعَزِيزِ , قَالا : \"الْمُدَبَّرُ وَصِيَّةٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16174","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ : \"الْمُدَبَّرُ وَصِيَّةٌ يَرْجِعُ فِيهِ صَاحِبُهُ مَتَى شَاءَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16175","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ : \"يُكْرَهُ بَيْعُ الْمُدَبَّرِ \" , وَسَمِعْتُهُ يَقُولُ : \" يُعَادُ فِي الْمُدَبَّرِ وَفِي كُلِّ وَصِيَّةٍ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16176","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الْكَرِيمِ ، عَنْ إِبْرَاهِيمَ ، وَالشَّعْبِيِّ : \"أَنَّهُمَا كَرِهَا بَيْعَ الْمُدَبَّرِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16177","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الشَّعْبِيِّ , قَالَ : \"يَبِيعُهُ الْجَرِيءُ وَيَرِعُ عَنْهُ الْوَرِعُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16178","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : \"لا يُبَاعُ الْمُدَبَّرُ \", قَالَ مَعْمَرٌ : وَأَخْبَرَنِي مَنْ سَمِعَ الْحَسَنَ , يَقُولُ مِثْلَ ذَلِكَ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16179","عَنْ مَعْمَرٍ , قَالَ : جَاءَهُ رَجُلٌ , فَقَالَ : إِنِّي أُرْسِلْتُ إِلَيْكَ مِنَ الْكُوفَةِ أَسْأَلُكَ عَنْرَجُلٍ دَبَّرَ جَارِيَةً لَهُ ، ثُمَّ بَاعَهَا , وَوَطِئَهَا الْمُشْتَرِي , فَقَالَ : \" تُرَدُّ الْجَارِيَةُ وَيَغْرَمُ الَّذِي وَطِئَهَا الْعَقْرَ , وَتُتْرَكُ عَلَى حَالِهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16180","عَنِ ابْنِ عُيَيْنَةَ ، أَوْ عَنْ غَيْرِهِ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : \"لا يُعَادُ فِي الْمُدَبَّرِ \", عَنِ ابْنِ عُيَيْنَةَ ، وَابْنِ أَبِي يَحْيَى","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16181","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيرَجُلٍ اشْتَرَى جَارِيَةً مُدَبَّرَةً , فَأَعْتَقَهَا , قَالَ : \" جَازَ عِتْقُهُ , وَيَبْتَاعُ هَذَا الَّذِي بَاعَهَا بِثَمَنِهَا جَارِيَةً فَيُدَبِّرُهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16182","عَنْ أَيُّوبَ ، عَنْ أَبِي الزُّبَيْرِ , قَالَ : سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ يُحَدِّثُ : أَنَّ رَجُلا مِنَ الأَنْصَارِ يُقَالُ لَهُ : أَبُو مَذْكُورٍ ,أَعْتَقَ غُلامًا لَهُ عَنْ دُبُرٍ مِنْهُ , وَلَمْ يَكُنْ لَهُ مَالٌ غَيْرُهُ , يُقَالُ لَهُ : يَعْقُوبُ , فَبَلَغَ ذَلَكَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : \" مَنْ يَشْتَرِيهِ مِنِّي ؟ \" , فَاشْتَرَاهُ النُّعَيْمُ بْنُ عَبْدِ اللَّهِ الْعَدَوِيُّ بِثَمَانِمِائَةِ دِرْهَمٍ , فَدَفَعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثَمَنَهُ إِلَيْهِ , وَقَالَ : \" إِذَا كَانَ أَحَدُكُمْ فَقِيرًا فَلْيَبْدَأْ بِنَفْسِهِ ، فَإِنْ كَانَ فَضْلٌ فَبِعِيَالِهِ ، فَإِنْ كَانَ فَضْلٌ فَبِقَرَابَتِهِ ، فَإِنْ كَانَ فَضْلٌ فَهَهُنَا وَهَهُنَا , وَأَشَارَ عَنْ يَمِينِهِ وَشِمَالِهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16183","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , قَالَ : \"أَوْلادُ الْمُدَبَّرَةِ بِمَنْزِلَةِ أُمِّهِمْ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16184","عَنْ مَعْمَرٍ ، عَنْ سَعِيدِ بْنِ عَبْدِ الرَّحْمَنِ الْجَحْشِيِّ ، عَنْ يَزِيدَ بْنِ عَبْدِ اللَّهِ بْنِ قُسَيْطٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : \"وَلَدُ الْمُدَبَّرَةِ بِمَنْزِلَتِهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16185","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : \"وَلَدُ الْمُدَبَّرَةِ بِمَنْزِلَةِ أُمِّهِمْ , إِذَا وَلَدَتْهُمْ بَعْدَمَا دَبَّرَتْ فَهُمْ بِمَنْزِلَتِهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16186","عَنْ مَعْمَرٍ ، عَنِ الْحَسَنِ ، وَقَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : \"وَلَدُ الْمُدَبَّرَةِ بِمَنْزِلَتِهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16187","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ , قَالَ : \"أَوْلادُ الْمُدَبَّرَةِ بِمَنْزِلَةِ أُمِّهِمْ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16188","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , \"فِي الْمُدَبَّرَةِ تَمُوتُ , وَتَتْرُكُ وَلَدًا وَلَدَتْهُمْ بَعْدَمَا دُبِّرَتْ , قَالَ : بِمَنْزِلَةِ أُمِّهِمْ \", قَالَ مَعْمَرٌ : وَأَخْبَرَنِي مَنْ سَمِعَ عِكْرِمَةَ يَقُولُ : \" لا عِتْقَ عَلَيْهِمْ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16189","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ ، أَنَّ أَبَا الشَّعْثَاءِ ، كَانَ يَقُولُ فِيالْمُدَبَّرِ : \" وَلَدُهُ عَبِيدٌ كِالحَائطِ تَصَدَّقُ بِهِ إِذَا مِتَّ ، وَلَكَ ثَمَرَتُهُ مَا عِشْتَ \", عَنِ ابْنِ عُيَيْنَةَ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، عَنْ أَبِي الشَّعْثَاءِ ، مِثْلَ ذَلَكَ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16190","أَخْبَرَنَا ابْنُ جُرَيْجٍ قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّ أَبَا الشَّعْثَاءِ ، كَانَ يَقُولُ : \"أَوْلادُ الْمُدَبَّرِ عَبِيدٌ ، وَإِنْ كَانَتْ حُبْلَى يَوْمَ تُدَبَّرُ فَوَلَدُهَا كَالْمُدَبَّرِ , كَأَنَّهُ عُضْوٌ مِنْهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16191","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ عِكْرِمَةَ بْنَ خَالِدٍ , قَالَ : حَضَرْتُ عَبْدَ الْمَلِكِ بْنَ مَرْوَانَ , وَاخْتَصَمَ إِلَيْهِ فِيأَوْلادِ الْمُدَبَّرَةِ , فَاسْتَشَارَ مَنْ حَوْلَهُ , فَقَالَ لَهُ رَجُلٌ : تُبَاعُ أَوَلادُهَا , فَإِنَّ الرَّجُلَ يَتَصَدَّقُ بِالنَّخْلِ فَيَأْكُلُ ثَمَرَهَا , وَقَالَ الآخَرُ : نَقْضًا لِلَّذِي قَالَ صَاحِبُهُ , قَالَ : الْمُدَبَّرَةُ يَكُونُ وَلَدُهَا بِمَنْزِلَتِهَا , قَالَ : حَسِبْتُ أَنَّهُ قَالَ : \" قَدْ يُهْدِي الرَّجُلُ الْبَدَنَةَ فَتَنْتِجُ , فَيُنَحَرُ وَلَدُهَا مَعَهَا \". قَالَ عِكْرِمَةُ : فَقَامَ وَلَمْ يَقْضِ فِيهِمْ بِشَيْءٍ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16192","أَخْبَرَنَا مَعْمَرٌ ، عَنْ سِمَاكِ بْنِ الْفَضْلِ , قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ \"أَنْ تُبَاعَ أَوْلادُ الْمُدَبَّرَةِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16193","عَنْ إِسْمَاعِيلَ بْنِ عَبْدِ اللَّهِ , قَالَ : أَخْبَرَنِي ابْنُ عَوْنٍ , قَالَ : كُنْتُ عِنْدَ الْقَاسِمِ بْنِ مُحَمَّدٍ , فَسَأَلَهُ أَعْرَابِيٌّ , فَقَالَ : رَجُلٌ أَعْتَقَ مَاهَتَهُ لَهُ عَنْ دُبُرٍ مِنْهُ ، مَا سَبِيلُ وَلَدِهَا ؟ قَالَ : فَالْتَوَى عَلَيْهِ الْقَاسِمُ ، فَقَالَ رَجُلٌ مِنَ الْقَوْمِ : قَضَى عُمَرُ بْنُ عَبْدِ الْعَزِيزِ أَنَّ وَلَدَهَا بِمَنْزِلَتِهَا , يُعْتَقُونَ بِعِتْقِهَا , فَقَالَ الْقَاسِمُ : \" هَذَا رَأْيٌ مِنْهُ , وَلا أَرَى كُلَّ شَيْءٍ وَلَدَتْ بَعْدَمَا دَبَّرَتْ , وَكَانَتِالْمُدَبَّرَةُ وَوَلَدُهَا مِنَ الثُّلُثِ , فَإِنْ مَاتَ سَيِّدُ أُمِّ الْوَلَدِ عَتَقَتْ وَعَتَقَ , إِنَّهُ فِي هَذَا إِلا مُعْدَلا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16194","عَنِ الثَّوْرِيِّ , قَالَ : \"إِذَا زَوَّجَ الرَّجُلُ أُمَّ وَلَدِهِ أَوْ مُدَبَّرَتَهِ , فَمَا وَلَدَتَا مِنْ وَلَدٍ فَهُوَ بِمَنْزِلَتِهَا , لا يُبَاعُونَ ، وَلا يُوهَبُونَ ، وَلا يُورَثُونَ ، فَإِنْ مَاتَ الَّذِي دَبَّرَ عَتَقَتْ , وَعَتَقَ كُلُّ شَيْءٍ وَلَدَتْ بَعْدَمَا دُبِّرَتْ , وَكَانَتِ الْمُدَبَّرَةُ وَوَلَدُهَا مِنَ الثُّلُثِ ، فَإِنْ مَاتَ سَيِّدُ أُمِّ الْوَلَدِ عَتَقَتْ , وَعَتَقَ وَلَدُهَا , مَا كَانَتْ وَلَدَتْ مِنْ وَلَدٍ فَهُوَ بِمَنْزِلَتِهَا , لا يُبَاعُونَ بَعْدَمَا وَلَدَتْ مِنْ سَيِّدِهَا ، وَلا يَكُونُونَ مِنَ الثُّلُثِ ، وَلا يُسْتَسْعَونَ فِي شَيْءٍ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16195","عَنْ إِسْمَاعِيلَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْقَاسِمِ ، وَعُمَرِ بْنِ عَبْدِ الْعَزِيزِ , قَالا : \"أَوْلادُ الْمُدَبَّرَةِ بِمَنْزِلَةِ أُمِّهِمْ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16196","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ ، أَنَّ ابْنَ عَبَّاسٍ ، وَابْنَ عُمَرَ , وَغَيْرَهُمَا , قَالُوا : \"يُصِيبُ الرَّجُلُ وَلِيدَتَهُ إِذَا دَبَّرَهَا إِنْ أَحَبَّ \", قَالَ ابْنُ جُرَيْجٍ : وَسَمِعْتُ عَطَاءً يَقُولُهُ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16197","أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ :\" دَبَّرَ جَارِيَتَيْنِ لَهُ , فَكَانَ يَطَؤُهُمَا ، ثُمَّ أَعْتَقَ إِحْدَاهُمَا فَزَوَّجَهَا نَافِعًا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16198","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، وَعَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ :\" دَبَّرَ جَارِيَتَيْنِ لَهُ , فَكَانَ يَطَؤُهُمَا حَتَّى دُبِّرَتْ إِحْدَاهُمَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16199","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ , قَالَ : \"لا بَأْسَ بِأَنْ يَطَأَ الرَّجُلُ مُدَبَّرَتَهِ , وَلا يَعُودُ فِيهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16200","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ،كَرِهَ أَنْ يَطَأَ الرَّجُلُ مُدَبَّرَتَهُ , قَالَ : قُلْتُ لَهُ : لِمَ تَكْرَهُهُ ؟ قَالَ : لِقَوْلِ عُمَرَ بْنِ الْخَطَّابِ : \" لا تَقْرَبْهَا وَلأَحَدٍ فِيهَا شَرْطٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16201","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عُمَرَ : \" أَنَّهُأَعْتَقَ وَلِيدَةً لَهُ عَنْ دُبُرٍ ، ثُمَّ وَطِئَهَا بَعْدَ ذَلِكَ سَبْعَ سِنِينَ , ثُمَّ أَعْتَقَهَا وَهِيَ حُبْلَى ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16202","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ , قَالَ : \"يَطَأُ الرَّجُلُ جَارِيَتَهُ مُدَبَّرَةً ، وَلا يَبِيعُهَا , وَلا يَرْجِعُ فِيهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16203","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّ عَمْرَو بْنَ الْعَاصٍ , قَالَ : \"لا بَأْسَ أَنْ يَطَأَ الرَّجُلُ مُدَبَّرَتَهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16204","عَنْ مَالِكٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : \"لا بَأْسَ أَنْ يَطَأَ الرَّجُلُ مُدَبَّرَتَهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16205","أَخْبَرَنَا عُمَرُ بْنُ حَوْشَبٍ , قَالَ : أَخْبَرَنِي إِسْمَاعِيلُ بْنُ أُمَيَّةَ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ , قَالَ : كَانَ لَهُمْ غُلامٌ يُقَالُ لَهُ : طَهْمَانُ أَوْ ذَكْوَانُ ,فَأَعْتَقَ جَدُّهُ نِصْفَهُ , فَجَاءَ الْعَبْدُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرَهُ , فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" تَعْتِقُ فِي عِتْقِكَ ، وَتَرِقُّ فِي رِقِّكَ \", فَكَانَ يَخْدُمُ سَيِّدَهُ حَتَّى مَاتَ , قَالَ إِسْمَاعِيلُ : وَإِنَّمَا يُعْتَقُ الْعَبْدُ كُلُّهُ إِذَا أَعْتَقَ عَبْدًا لَهُ نِصْفَهُ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16206","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، فِيرَجُلٍ أَعْتَقَ نِصْفَ عَبْدٍ , قَالَ : \" يَعْتِقُ فِي عِتْقِهِ , وَيَرِقُّ فِي رِقِّهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16207","عَنِ الثَّوْرِيِّ ، عَنْ أَشْعَثَ ، عَنِ الْحَكَمِ ، عَنْ عَلِيٍّ أَنَّهُ : \"إِذَا أُعْتِقَ نِصْفُهُ فَبِحِسَابِ مَا عَتَقِ وَيُسْتَسْعَى \", قَالَ الثَّوْرِيُّ : وَكَانَ حَمَّادٌ يَقُولُ ذَلِكَ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16208","عَنِ الثَّوْرِيِّ ، عَنْ خَالِدِ بْنِ سَلَمَةَ الِفَأْفَأَ , قَالَ : جَاءَ رَجُلٌ إِلَى ابْنِ عُمَرَ فَقَالَ لَهُ : كَانَلِي عَبْدٌ , أَعْتَقْتُ ثُلُثَهُ , فَقَالَ ابْنُ عُمَرَ : \" عَتَقَ كُلُّهُ لَيْسَ لِلَّهِ شَرِيكٌ \", قَالَ الثَّوْرِيُّ : وَنَحْنُ نَأْخُذُ بِهَا","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16209","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ قَالَ : كُنْتُ عِنْدَ الْحَسَنِ فَجَاءَهُ رَجُلٌ , فَقَالَ :امْرَأَةٌ لَهَا عَبْدَانِ , أَعْتَقَتْ نِصْفَ كُلِّ وَاحِدٍ مِنْهُمَا كَيْمَا يَدْخُلا عَلَيْهَا , فَقَالَ الْحَسَنُ : \" لا شَرِيكَ لِلِّهِ , لا شَرِيكَ لِلِّهِ , هُمَّا حُرَّانِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16210","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِي , قَالَ : \"إِذَا كَانَ لَهُ عَبْدٌ فَأَعْتَقَ مِنْهُ عُضْوًا عَتَقَ كُلُّهُ , مِيرَاثُهِ مِيرَاثُ حُرٍّ , وَشَهَادَتُهُ شَهَادَةُ حُرٍّ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16211","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : \"إِذَا قَالَ الرَّجُلُ لِعَبْدِهِ : إصْبُعَكَ , أَوْ ظُفْرُكَ , أَوْ عُضْوٌ مِنْكَ حُرٌّ , عَتَقَ كُلُّهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16212","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \"مَنْ أَعْتَقَ شِرْكًا لَهُ فِي عَبْدٍ أُقِيمَ مَا بَقِي مِنْهُ فِي مَالِهِ ، إِذَا كَانَ لَهُ مَا يَبْلُغُ ثَمَنَ الْعَبْدِ \", لا يُدْرَى قَوْلُهُ : \" إِذَا كَانَ لَهُ مَا بَلَغَ ثَمَنَ الْعَبْدِ \" , أَفِي حَدِيثِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَمْ شَيْءٌ قَالَهُ الزُّهْرِيُّ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16213","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَنْ أَعْتَقَ نَصِيبًا لَهُ فِي عَبْدٍ , عَتَقَ الْعَبْدُ فِي مَالِهِ إِنْ كَانَ لَهُ مَالٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16214","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِسْمَاعِيلُ بْنُ أُمَيَّةَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \"مَنْ أَعْتَقَ شِرْكًا لَهُ فِي عَبْدٍ أُقِيمَ عَلَى الَّذِي أَعْتَقَهُ ، يُدْفَعُ ثَمَنُهُ إِلَى شُرَكَائِهِ ، وَيَعْتِقُ فِي مَالِ الَّذِي أَعْتَقَهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16215","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَنْ أَعْتَقَ نَصِيبًا لَهُ فِي عَبْدٍ أُعْتِقَ مَا بَقِيَ فِي مَالِهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16216","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي مِجْلَزٍ ، أَنَّأَخَوَيْنِ مِنْ جُهَيْنَةَ كَانَ بَيْنَهُمَا عَبْدٌ , فَأَعْتَقَ أَحَدُهُمَا نَصِيبَهُ \" فَضَمَّنَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَتَّى بَاعَ غَنِيمَةً لَهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16217","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنْ بَشِيرِ بْنِ نُهَيْكٍ ، عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَنْ أَعْتَقَ شِرْكًا لَهُ فِي عَبْدٍ أَعْتَقَ مَا بَقِيَ فِي مَالِهِ ، فَإِنْ لَمْ يَكُنْ لَهُ مَالٌ اسْتُسْعِي الْعَبْدُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16218","عَنْ مَعْمَرٍ ، عَنِ خَالِدٍ الْحَذَّاءِ ، عَنْ أَبِي قِلابَةَ ، قَالَ :أَعْتَقَ رَجُلٌ عَبْدًا لَهُ , لَيْسَ لَهُ مَالٌ غَيْرُهُ عِنْدَ مَوْتِهِ فَأَعْتَقَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثُلُثَهُ ، وَاسْتَسْعَاهُ فِي الثُّلُثَيْنِ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16219","عَنْ هُشَيْمِ بْنِ بَشِيرٍ ، قَالَ : أَخْبَرَنِي خَالِدٌ الْحَذَّاءُ ، عَنْ أَبِي قِلابَةَ ، عَنْ رَجُلٍ مِنْ عَذْرَةَ : أَنَّرَجُلا مِنْهُمْ أَعْتَقَ عِنْدَ مَوْتِهِ غُلامًا لَهُ , لَمْ يَكُنْ لَهُ مَالٌ ، فَرُفِعَ ذَلِكَ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" فَأَعْتَقَ ثُلُثَهُ ، وَأَمَرَهُ أَنْ يَسْعَى فِي الثُّلُثَيْنِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16220","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"إِذَا كَانَ بَيْنَهُمَا عَبْدٌ ، فَأَعْتَقَ أَحَدُهُمَا نَصِيبَهُ ضَمِنَ إِنْ كَانَ لَهُ يَسَارٌ ، فَإِنْ لَمْ يَكُنْ لَهُ يَسَارٌ سَعَى الْعَبْدُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16221","عَنِ الثَّوْرِيِّ , قَالَ : أَخْبَرَنِي أُسَامَةُ بْنُ زَيْدٍ ، أَنَّهُ سَمِعَ سُلَيْمَانَ بْنَ يَسَارٍ , يَقُولُ : \"إِذَا أَعْتَقَ الرَّجُلُ شِقْصًا فِي عَبْدٍ , فَإِنَّهُ يَضْمَنُ بَقِيَّتَهُ إِنْ كَانَ لَهُ مَالٌ ، فَإِنْ لَمْ يَكُنْ لَهُ مَالٌ اسْتَسْعَى الْعَبْدُ فِي بَقِيَّتِهِ \" , قَالَ : فَقُلْتُ لِسُلَيْمَانَ : أَرَأَيْتَ إِنْ كَانَ الْعَبْدُ صَغِيرًا ؟ قَالَ : \" كَذَلِكَ جَاءَتِ السُّنَّةُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16222","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ , أَنَّهُ كَانَ يَقُولُ : \"إِنْ كَانَ لَهُ مِنَ الْمَالِ تَمَامُ نَصِيبِ صَاحِبِهِ الَّذِي ضَمِنَ لَهُ ضُمِنَ ، وَلَيْسَ عَلَى الْعَبْدِ سَعَايَةٌ ، وَإِنْ نَقَصَ مِنْهُ دِرْهَمًا فَمَا فَوْقَهُ سَعْيٌ الْعَبْدُ فِي نِصْفِ ثَمَنِهِ , فَلَيْسَ عَلَى الْمُعْتِقُ ضَمَانٌ ، وَإِنْ أَعْتَقَهُ وَهُوَ مُوسِرٌ ، فَلَمْ يَقْضِ الْقَاضِي حَتَّى أَفْلَسَ , فَهُوَ ضَامِنٌ , وَلَيْسَ عَلَى الْعَبْدِ شَيْءٌ ، وَإِنْ كَانَ أَعْتَقَ وَهُوَ مُفْلِسٌ , فَلَمْ يَقْضِ الْقَاضِي حَتَّى أَيْسَرَ ، فَالسَّعَايَةُ عَلَى الْعَبْدِ \" , قَالَ : وَكَانَ حَمَّادٌ يَقُولُ : \" إِذَا سَعَى فَالْوَلاءُ بَيْنَهُمَا \", عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، وَزَكَرِيَّا ، وَجَابِرٍ ، عَنِ الشَّعْبِي , قَالَ : الْوَلاءُ لِلَّذِي 00 وَقَالَهُ ابْنُ أَبِي لَيْلَى : وَقَوْلُ حَمَّادٍ أَحَبُّ إِلَيَّ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16223","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ : \"إِنْ كَانَ عَبْدٌ بَيْنَ رَجُلَيْنِ , فَأَعْتَقَ أَحَدُهُمَا نَصِيبَهُ بِغَيْرِ أَمْرِ شَرِيكِهِ , أُقِيمَ مَا بَقِي مِنْهُ , ثُمَّ أُعْتِقَ فِي مَالِ الَّذِي أَعْتَقَهُ ، ثُمَّ اسْتُسْعِي هَذَا الْعَبْدُ بِمَا غُرِمَ فِيمَا أَعْتَقَ عَلَيْهِ مِنَ الْعَبْدِ \" , قُلْتُ : يُسْتَسْعَى الْعَبْدُ بِذَلِكَ إنْ كَانَ مُفْلِسًا أَوْ غَنِيًّا ؟ قَالَ : \" زَعَمُوا \" , قَالَ : وَأَقُولُ أَنَا : \" لا يُسْتَسْعَى الْعَبْدُ ، إِلا أَنْ يَكُونَ الَّذِي أَعْتَقَهُ مُفْلِسًا , فَيُسْتَسْعَى الْعَبْدُ حِينَئِذٍ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16224","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، وَقَالَ : \"لا يَتْبَعُ السَّيِّدُ الْعَبْدَ فِيمَا غُرِمَ عَلَيْهِ فِي عِتَاقِهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16225","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : إِنْأَرَادَ أَنْ أَعْتِقَ عَنْهُ مَا أَعْتِقُ بِغَيْرِ أَمْرِهِ أَنْ يَجْلِسَ عَلَى حَقِّهِ مِنَ الْعَبْدِ ، فَقَالَ الْعَبْدُ : أَنَا أَقْضِي قِيمَتِي , قَالَ : بَعْدُ هُوَ , وَعَمْرُو بْنُ دِينَارٍ إِنَّ سَيِّدَهُ أَحَقُّ بِمَا بَقِيَ , يَجْلِسُ عَلَيْهِ إِنْ شَاءَ , قَالَ : وَأَقُولُ أَنَا : قَضَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ يَعْتِقُ ، وَلا بُدَّ مِنْ ذَلِكَ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16226","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَبْدُ اللَّهِ بْنُ أَبِي مَرْثَدٍ : \"مَنْ أَعْتَقَ شِرْكًا لَهُ عَلَى شُرَكَائِهِ ، وَكَانَ الْعَبْدُ مُفْلِسًا , فَأَرَادَ أَنْ يَأْخُذَ نَفْسَهُ بِقِيمَتِهِ , فَإِنِي أُرَاهُ أَحَقَّ بِهَا إِنْ نَقَدَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16227","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \"فَكَانَ الَّذِي أَعْتَقَ مُفْلِسًا ، وَكَانَ الْعَبْدُ ذَا مَالٍ , فَقَالَ الَّذِي أَعْتَقَ عَلَيْهِ \" أَنَا آخُذُ الْعَبْدَ بِذَلِكَ , فَأَبَى الْعَبْدُ \" , قَالَ : \" فَلا يُكْرَهُ الْعَبْدُ حِينَئِذٍ عَلَى شَيْءٍ لَهُ , مِنْ نَفْسِهِ يَوْمٌ , وَلِسَيِّدِهِ يَوْمٌ \" , قَالَ : قُلْتُ لِعَطَاءٍ : وَإِنْ كَاتَبَهُ أَحَدُ الشُّرَكَاءِ , أَوْ قَاطَعَهُ بِأَمْرِ شُرَكَائِهِ ، فَبِمَنْزِلَةِ الْعِتْقِ ؟ قَالَ : \" نَعَمْ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16228","عَنْ مَعْمَرٍ ، عَنِ ابْنِ شُبْرُمَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، قَالَلِرَجُلٍ لَهُ نَصِيبٌ فِي عَبْدٍ : \" لا تُفْسِدْ عَلَى أَصْحَابِكَ فَتَضْمَنَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16229","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , \" فِيرَجُلٍ أَعْتَقَ شِرْكًا لَهُ فِي عَبْدٍ , قَالَ : يَقُومُ يَوْمَ أَعْتَقَهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16230","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، سُئِلَ عَنِ امْرَأَةٍ , قَالَتْ :إِنْ تَزَوَّجَ زَوْجُهَا فَكُلُّ عَبْدٍ لَهَا حُرٌّ ، فَتَزَوَّجَ , قَالَ : \" لا تُقَالُ السَّفِيهَةُ فِي الْعِتْقِ ، الْعِتْقُ جَائِزٌ مِنْ كُلِّ سَفِيهَةٍ وَسَفِيهٍ ، إِلا أَنْ يَكُونَ لَهَا شِرْكٌ فِي عَبْدٍ ، فَلا يُعْتَقُ حَتَّى يَكُونَ لَهَا كُلُّهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16231","عَنْ مَعْمَرٍ ، عَنْ أَبِي حَمْزَةَ ، عَنِ النَخَعِي : أَنَّرَجُلا أَعْتَقَ شِرْكًا لَهُ فِي عَبْدٍ , وَلَهُ شُرَكَاءُ يَتَامَى ، فَقَالَ عُمَرُ بْنُ الْخَطَّابِ : \" يَنْتَظِرُ بِهِمْ حَتَّى يَبْلُغُوا ، فَإِنْ أَحَبُّوا أَنْ يَعْتِقُوا أَعْتَقُوا ، وَإِنْ أَحَبُّوا أَنْ يَضْمَنَ لَهُمْ ضَمِنَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16232","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ عَمْرِو بْنِ سَعِيدٍ , قَالَ : \"كَانَ لآلِ أَبِي الْعَاصِ غُلامٌ وَرِثُوهُ , فَأَعْتَقُوهُ إِلا رَجُلٌ مِنْهُمْ , فَاسْتَشْفَعَ بِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَوَهَبَهُ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \" فَأَعْتَقَهُ \" , فَكَانَ يَقُولُ : أَنَا مَوْلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16233","عَنْ مَعْمَرٍ , فِي عَبْدٍ بَيْنَ رَجُلَيْنِ , أَعْتَقَ أَحَدُهُمَا نَصِيبَهُ ، ثُمَّ أَعْتَقَ الآخَرُ بَعْدَمَا قَالَ , أَمَّا نَحْنُ فَنَقُولُ : وَلاؤُهُ وَمِيرَاثُهُ بَيْنَهُمَا , قَالَ : سَمِعْتُ الزُّهْرِيَّ , وَعَمْرَو بْنَ دِينَارٍ , فِيالْعَبْدِ يَكُونُ بَيْنَ رَجُلَيْنِ , فَيُعْتِقُ أَحَدُهُمَا ، ثُمَّ يُعْتِقُهُ الآخَرُ بَعْدُ ، قَالا : الْمِيرَاثُ وَالْوَلاءُ بَيْنَهُمَا نِصْفَانِ ، وَلا ضَمَانَ عَلَيْهِ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16234","قَالَ : وَقَالَ ابْنُ شُبْرُمَةَ : إِنَّ عُمَرَ بْنَ الْخَطَّابِ ،قَالَ لِرَجُلٍ لَهُ نَصِيبٌ فِي عَبْدٍ : \" لا تُفْسِدْ عَلَى أَصْحَابِكَ فَتَضْمَنَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16235","عَنْ مَعْمَرٍ ، عَنِ ابْنِ شُبْرُمَةَ , قَالَ : \"الضَّمَانُ عَلَى الأَوَّلِ ، وَلَهُ الْمِيرَاثُ وَالْوَلاءُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16236","عَنِ الثَّوْرِيِّ , فِيرَجُلٍ اشْتَرَى بَعْضَ أَخِيهِ مِنْ رَجُلٍ كَانَ لَهُ الْعَبْدُ كُلُّهُ , قَالَ : \" يَعْتِقُ إِذَا مَلِكَهُ , وَيَضْمَنُ الأَخُ إِنْ كَانَ مُوسِرًا ، وَإِلا اسْتُسْعِي الْعَبْدُ ، وَإِنْ كَانَ مِيرَاثًا لَمْ يَضْمَنْ , لأَنَّهُ وَقَعَ عَلَيَّ وَهُوَ كَارِهٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16237","عَنِ الثَّوْرِيِّ , فِيعَبْدٍ بَيْنَ رَجُلَيْنِ , فَاشْتَرَى مِنْ أَحَدِهِمَا نِصْفَ نَفْسِهِ , قَالَ : \" يُعْتَقُ , وَيَضْمَنُ الَّذِي بَاعَهُ مِنْ نَفْسِهِ لِصَاحِبِهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16238","عَنِ الثَّوْرِيِّ , فِيعَبْدٍ بَيْنَ رَجُلَيْنِ , بَاعَ أَحَدُهُمَا نَصِيبَهُ مِنْ أَبِ الْعَبْدِ , وَأَبُو الْعَبْدِ مُفْلِسٌ , قَالَ : \" إِنْ شَاءَ ضَمِنَ الْبَائِعُ ، وَإِنْ شَاءَ ضَمِنَ أَبَا الْعَبْدِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16239","عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"إِذَا أَعْتَقَ الْعَبْدُ شِرْكًا لَهُ فِي عَبْدٍ , أَعْتَقَ مَا بَقِي فِي مَالِهِ ، فَإِنْ لَمْ يَكُنْ لَهُ مَالٌ اسْتُسْعِي الْعَبْدُ \" , قَالَ : \" وَإِذَا كَانَ يَسْعَى فَهُوَ بِمَنْزِلَةِ الْعَبْدِ , وَمِيرَاثُهُ وَوَلاؤُهُ لِلَّذِي يَسْعَى لَهُ \", قَالَ مَعْمَرٌ : وَقَالَ قَتَادَةُ : مِيرَاثُهُ وَوَلاؤُهُ بِالْحِصَصِ , وَقَالَهُ حَمَّادٌ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16240","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ أَبِي حَبِيبَةَ الطَّائِيِّ ، عَنْ أَبِي الدَّرْدَاءِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَثَلُ الَّذِي يُعْتِقُ عِنْدَ الْمَوْتِ كَمَثَلِ الَّذِي يُهْدِي إِذَا شَبِعَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16241","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"إِذَا كَانَتْ عَتَاقَةٌ وَوَصِيَّةٌ بُدِئَ بِالعَتَاقَةِ \", عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنِ الْحَكَمِ ، عَنْ شُرَيْحٍ ، مِثْلَ قَوْلِ إِبْرَاهِيمَ : \" يُبْدَأُ بِالْعِتْقِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16242","عَنِ الثَّوْرِيِّ ، عَنْ أَشْعَثَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّهُ قَالَ : \"يُبْدَأُ بِالْعِتْقِ \", قَالَ الثَّوْرِيُّ وَأَصْحَابُهُ : يُبْدَأُ بِالْعِتْقِ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16243","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، وَعَطَاءٍ الْخُرَاسَانِيِّ , فيرجل أعتق ثلث عبد له , وأوصى ببقية الثلث لناس سماهم , قَالا : \" يُبْدَأُ بِالْعِتْقِ , فَيُعْتَقُ الْعَبْدُ كَامِلا ، فَإِنْ بَقِي بَعْدُ عِتْقِهِ شَيْءٌ فَحَيْثُ سَمَّى ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16244","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، وَمُطَرِّفٍ ، عَنِ الشَّعْبِي , قَالَ : \"إِذَا كَانَتِ الْعَتَاقَةُ وَوَصِيَّةٌ فَبِالْحِصَصِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16245","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ , عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، أَنَّهُ قَالَ : \"بِالْحِصَصِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16246","عَنْ مَعْمَرٍ ، عَنِ ابْنِ شُبْرُمَةَ , قَالَ : \"يَكُونُ الْعِتْقُ كَمَا سَمَّى , وَوَصِيَّتُهُ لِمَنْ سَمَّى ، وَلَكِنَّ الْعَبْدُ يَسْعَى فِيمَا بَقِي عَلَيْهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16247","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : \"يُرَدُّ عَلَى أَهْلِ الْعَتَاقَةُ الْعَوْلُ ، وَيُرْجَعُ فِي الْوَصِيَّةِ \", وَقَالَهُ عَمْرُو بْنُ دِينَارٍ , وَيَقُوَلانِ : يُبْدَأُ بِالْعِتْقِ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16248","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، عَنْ عِمْرَانَ بْنِ الْحُصَيْنِ , قَالَ :تُوُفِّي رَجُلٌ وَأَعْتَقَ سِتَّةَ مَمْلُوكِينَ , لَيْسَ لَهُ مَالٌ غَيْرُهُمْ , فَبَلَغَ ذَلِكَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : \" لَوْ أَدْرَكْتُهُ مَا دُفِنَ مَعَ الْمُسْلِمِينَ ، فَأَقْرَعَ بَيْنَهُمْ ، فَأَعْتَقَ اثْنَيْنِ , وَاسْتَرَقَّ أَرْبَعَةً ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16249","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ عِكْرِمَةَ بْنِ خَالِدٍ , قَالَ :أَعْتَقَ رَجُلٌ مَمْلُوكَيْنِ لَهُ ثَلاثَةٌ , لَيْسَ لَهُ مَالٌ غَيْرُهُمْ فَأَقْرَعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَيْنَهُمْ فَأَعْتَقَ أَحَدَهُمْ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16250","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي قَيْسُ بْنُ سَعْدٍ ، أَنَّهُ سَمِعَ مَكْحُوَلا , يَقُولُ : سَمِعْتُ ابْنَ الْمُسَيِّبِ , يَقُولُ :أَعْتَقَتِ امْرَأَةٌ أَوْ رَجُلٌ , سِتَّةَ أَعْبُدٍ لَهَا عِنْدَ الْمَوْتِ , لَمْ يَكُنْ لَهَا مَالٌ غَيْرُهُمْ ، فَأُتِيَ فِي ذَلِكَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : فَأَقْرَعَ بَيْنَهُمْ, وَعَطَاءٌ يَسْمَعُ ، فَقَالَ : كُنَّا نَقُولُ : يُسْتَسْعَونَ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16251","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي سُلَيْمَانُ بْنُ مُوسَى , قَالَ : سَمِعْتُ مَكْحُوَلا , يَقُولُ :أَعْتَقَتِ امْرَأَةٌ مِنَ الأَنْصَارِ تُوُفِّيَتْ أَعْبُدًا لَهَا سِتَّةً , لَمْ يَكُنْ لَهَا مَالٌ ، فَلَمَّا بَلَغَ ذَلِكَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ فِي ذَلِكَ قَوَلا شَدِيدًا , ثُمَّ : أَمَرَ بِسِتَّةِ قِدَاحٍ , فَأَقْرَعَ بَيْنَهُمْ , فَأَعْتَقَ اثْنَيْنِ, قُلْتُ : عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ؟ قَالَ : مَا كَانَ يَأْثِرُهُ عَنْ أَحَدٍ دُونَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ لِي قَيْسٌ : أَشَهِدَهُ لأَثَرِهِ عَنِ ابْنِ الْمُسَيِّبِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ سُلَيْمَانُ : فَلا نَأْخُذُ الآنَ بِذَلِكَ , وَلا يُقْضَى بِهِ عِنْدَنَا , وَلَكِنَّا نَسْتَسْعِيهُمْ فِي الثُّلُثَيْنِ الْبَاقِيَيْنِ , قَالَ : كُنْتُ أُرَاجِعُ مَكْحُوَلا إِنْ كَانَ عَبْدٌ ثُمِّنَ أَلْفَ دِينَارٍ , أَصَابَتْهُ الْقُرْعَةُ فَذَهَبَ الْمَالُ , قَالَ : نَقِفُ عِنْدَ أَمْرِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قُلْتُ لِسُلَيْمَانَ : الأَمْرُ مُسْتَقِيمٌ عَلَى مَا قَالَ مَكْحُولٌ , قَالَ : فَكَيْفَ تُقَامُ قِيمَةٌ ؟ فَإِنْ زَادَ اللَّذَانِ أُعْتِقَا عَلَى الثُّلُثِ أُخِذَ مِنْهُمَا , فَإِنْ نَقَصَ أُعْتِقَ أَيْضًا مَا بَقِي مِنَ الْقُرْعَةِ , فَإِنْ فَضَلَ عَلَى أَحَدٍ شَيْءٌ أُخِذَ مِنْهُ , قَالَ : ثُمَّ بَلَغَنَا أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَقَامَهُمْ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16252","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : وَقَالَ عَطَاءٌ : إِنْ قَالَ : \"ثُلُثُ رَقِيقِي أَحْرَارٌ فَلَيْسَ بِشَيْءٍ حَتَّى يُسَمِّي \" , فَيَقُولُ : فُلانٌ حُرٌ , وَلَكِنْ ذَلِكَ كَانَ يُوصِي بِثُلُثِ رَقِيقِهِ ، فُلانٌ حُرٌ لِفُلانٍ , مِنْ كُلِّ عَبْدٍ ثَلاثَةٌ , أَوْ كَانَ يُورَثُ رَقِيقَهُ , فَلْيَأْخُذْ مِنْ كُلِّ عَبْدٍ ثُلُثَهُ , قَالَ : فَإِنْ قَالَ : \" أُعْتِقُ ثُلُثَ رَقِيقِي أُقِيمَ قِيمَةً ، ثُمَّ أُقْرِعَتْ بَيْنَهُمْ , فَأُعْتِقَ ثُلُثُهُمْ , فَإِنْ كَانَ عَوْلٌ أَخَذْتَهُ مِنْ ذَا الْعَوْلِ الزَّيَادَةَ وَالْفَضْلَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16253","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بنِ عَبْدِ اللَّهِ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ , قَالَ :اشْتَرَى رَجُلٌ جَارِيَةً وَهُوَ مَرِيضٌ , فَأَعْتَقَهَا عِنْدَ مَوْتِهِ ، فَجَاءَ الَّذِينَ بَاعُوهَا لِثَمَنِهَا , فَلَمْ يَجِدُوا لَهُ مَالا ، فَرَفَعُوا ذَلِكَ إِلَى ابْنِ مَسْعُودٍ , فَقَالَ لَهَا : \" اسْعِي فِي ثَمَنِكِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16254","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ ، عَنِ الْقَاسِمِ ، قَالَ : سُئِلَ ابْنُ مَسْعُودٍ عَنْرَجُلٍ أَعْتَقَ عَبْدَهُ عِنْدَ الْمَوْتِ , لَيْسَ لَهُ مَالٌ غَيْرُهُ , وَعَلَيْهِ دَيْنٌ ، فَقَالَ : \" سَعَى الْعَبْدُ فِي ثَمَنِهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16255","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ , قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ فِيالَّذِي يَكُونُ عَلَيْهِ دَيْنٌ ، وَلَيْسَ لَهُ إِلا عَبْدٌ , فَأَعْتَقَهُ عِنْدَ مَوْتِهِ , فَكَتَبَ أَنْ \" يُبَاعَ الْعَبْدُ ، وَيُقْضَى دَيْنُهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16256","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : \"إِذَا أَعْتَقَ الرَّجُلُ عَبْدًا لَهُ عِنْدَ الْمَوْتِ , لَيْسَ لَهُ مَالٌ غَيْرُهُ , اسْتُسْعِي فِي الثُّلُثَيْنِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16257","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , فِيرَجُلٍ أَعْتَقَ ثَلاثَةً مَمْلُوكِينَ , لَيْسَ لَهُ مَالٌ غَيْرُهُمْ , ثَمَنُ أَحَدِهِمْ أَلْفُ دِينَارٍ ، وَثَمَنُ الآخَرِ أَلْفَانِ ، وَثَمَنُ الآخَرِ ثَلاثَةُ آلافٍ , قَالَ : \" أَقْرِعْ بَيْنَهُمْ ، فَإِنْ خَرَجَ الَّذِي ثَمَنُهُ الأَلْفُ , أَقْرَعْ بَيْنَ الآخَرَيْنِ ، ثُمَّ أُخِذَ الْفَضْلُ مِنْ أَيِّهِمَا أَصَابَتْهُ الْقُرْعَةُ ، وَإِنْ خَرَجَ الَّذِي ثَمَنُهُ أَلْفَانِ فَهُوَ الثُّلُثُ ، وَإِنْ خَرَجَ الَّذِي ثَمَنُهُ ثَلاثَةُ آلافٍ أُخِذَ مِنْهُ الْفَضْلُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16258","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ ، وَعُبَيْدِ اللَّهِ بْنِ أَبِي يَزِيدَ , فيرجل أعتق ثلث عبد له عند موته ، قَالا : \" يُقَامُ فِي ثُلُثِهِ مَا بَقِيَ مِنَ الْعَبْدِ , فَيُعْتِقُ كُلُّهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16259","وَسَمِعْتُ الثَّوْرِيَّ , أَوْ هَشِيمًا , أَوْ بَعْضَهُمْ يُحَدِّثُ ، عَنْ مُطْرَفٍ ، عَنِ الشَّعْبِيِّ ، وَعَنْ يُونُسَ ، عَنِ الْحَسَنِ , قَالا : \"إِذَا أَعْتَقَ ثُلُثَ عَبْدِهِ عِنْدَ الْمَوْتِ , أَعْتَقَ ثُلُثَهُ ، وَاسْتُسْعِيَ الْعَبْدُ فِي الثُّلُثَيْنِ ، وَلَمْ يَضْمِنِ الْمَيِّتُ \", قَالَ الثَّوْرِيُّ : وَقَوْلُ عَطَاءٍ الْمُعَوَّلُ بِهِ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16260","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلْتُ عَطَاءً عَنِالرَّجُلِ إِذَا أَعْتَقَ ثُلُثَ عَبْدٍ لَهُ عِنْدَ الْمَوْتِ , قَالَ : \" يُقَامُ فِي ثُلُثِهِ مَا بَقِي , فَيُعْتَقُ \" , قُلْتُ : إِنَّهُ قَدْ أَوْصَى بِثُلُثِهِ , فَقَالَ : \" يُقَامُ فِي ثُلُثِهِ ، ثُمَّ يُعْتَقُ ، ثُمَّ يُسْتَسْعَى الْعَبْدُ \" , قَالَ : وَقَالَ : إِنْ أَعْتَقَ مَرِيضٌ ثُلُثَ عَبْدٍ لَهُ عِنْدَ الْمَوْتِ , قَالَ : \" يُقَامُ فِي ثُلُثِهِ , فَسَمَّى ثُلُثُ فُلانٍ حُرٌّ وَصِيَّةٌ ، ثُمَّ مَاتَ , أُقِيمَ عَلَيْهِ ثُلُثَاهُ عَلَى الْمُوصِي فِي ثُلُثِهِ ، وَأُعْتِقَ كُلُّهُ وَخَلَصَ ثَمَنُ ثُلُثَيْهِ لِلْوَارِثِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16261","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي دَاوُدُ بْنُ أَبِي عَاصِمٍ , قَالَ : أَتَى ابْنُ الْمُسَيِّبِ وَأَنَا جَالِسٌ عِنْدَهُ , وَلَيْسَ مَعَهُ أَحَدٌ , فَقِيلَ لَهُ :رَجُلٌ مَاتَ وَلَمْ يَدَعْ مَالا غَيْرَ غُلامٍ , فَأَعْتَقَهُ , قَالَ : \" إِنَّمَا لَهُ ثُلُثُهُ , وَيُقَامُ الْعَبْدُ قِيمَتَهُ , فَيُسْتَسْعَى فِي الثُّلُثَيْنِ ، فَإِنْ عَجَزَ فَلَهُ مِنْ نَفْسِهِ يَوْمٌ , وَلَهُمْ يَوْمَانِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16262","أَخْبَرَنَا الثَّوْرِيُّ , عَنِ خَالِدٍ الْحَذَّاءِ ، عَنِ الْحَسَنِ ، عَنْ عِمْرَانَ بْنِ الْحُصَيْنِ , قَالَ :أَعْتَقَ رَجُلٌ سِتَّةَ مَمْلُوكَينَ لَهُ عِنْدَ مَوْتِهِ \" فَأَقْرَعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَيْنَهُمْ ، فَأَعْتَقَ اثْنَيْنِ مِنْهُمْ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16263","عَنِ الثَّوْرِيِّ ، عَنْ إِسْمَاعِيلَ ، عَنِ الشَّعْبِيِّ , فِيرَجُلٍ أَعْتَقَ سِتَّةَ أَعْبُدٍ لَهُ مَمْلُوكِينَ عِنْدَ مَوْتِهِ , قَالَ : \" يَقُومُونَ كُلُّهُمْ , فَيُعْتِقُ ثُلُثُهُمْ ، وَيَسْتَسْعَونَ فِي الثُّلُثَيْنِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16264","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , فِيرَجُلٍ أَعْتَقَ عَبْدَهُ عِنْدَ الْمَوْتِ , وَتَرَكَ دَيْنًا , وَلَيْسَ لَهُ مَالٌ , قَالَ : \" يُسْتَسْعَى الْعَبْدُ فِي ثَمَنِهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16265","عَنِ الأَسْلَمِيِّ ، عَنِ الْحَجَّاجِ بْنِ أَرْطَاةَ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ ، عَنْ عَلِيٍّ , فِيرَجُلٍ أَعْتَقَ عَبْدَهُ عِنْدَ الْمَوْتِ , وَتَرَكَ دَيْنًا , وَلَيْسَ لَهُ مَالٌ , قَالَ : يُسْتَسْعَى الْعَبْدُ فِي قِيمَتِهِ, قَالَ : وَأَخْبَرَنِي الْحَجَّاجُ أَيْضًا , عَنِ الْعَلاءِ بْنِ بَدْرٍ , عَنْ أَبِي يَحْيَى الأَعْرَجِ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16266","عَنِ الثَّوْرِيِّ , فِيرَجُلٍ لَهُ عَبْدٌ مُدَبَّرٌ , وَعَبْدٌ لَيْسَ بِمُدَبَّرٍ , فَقِيلَ لَهُ : مَا هَذَانِ الْعَبْدَانِ ؟ قَالَ : \" أَحَدُهُمَا حُرٌّ ، ثُمَّ مَاتَ , فَجَاءَ الْعَبْدَانِ يَدَّعِي كُلُّ وَاحِدٍ مِنْهُمَا أَنَّهُ حُرٌّ ، وَلَيْسَ لَهُ مَالٌ غَيْرُهُمَا ، وَثَمَنُ كُلِّ وَاحِدٍ مِنْهُمَا ثَلاثُ مِائَةِ دِرْهَمٍ \" , قَالَ : \" أَمَّا غَيْرُ الْمُدَبَّرِ فَيُسْتَسْعَى فِي خَمْسِينَ وَمِائَةٍ ، وَأَمَّا الْمُدَبَّرُ فَيَسْعَى فِي خَمْسِينَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16267","عَنِ الثَّوْرِيِّ , فِيرَجُلٍ شَهِدَ عَلَيْهِ اثْنَانِ أَنَّهُ أَعْتَقَ أَحَدَ غُلامَيْهِ , لا يُدْرَى أَيُّهُمَا هُوَ , قَالَ : \" يُسْتَسْعَيَانِ فِي النِّصْفِ إِنْ قَيَّمْتَهُمَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16268","عَنِ الثَّوْرِيِّ , فِيرَجُلٍ أَوْصَى أَنْ يُعْتَقَ مُكَاتِبٌ لَهُ , وَأَوْصَى بِوَصَايَا , قَالَ : \" إِنْ كَانَ مَا عَلَى الْمُكَاتِبِ خَيْرًا لَهُ ضَرَبْنَا لَهُ بِهِ ، وَإِنْ كَانَتِ الْقِيمَةُ أَنْقَصُ ضَرَبْنَا لَهُ بِالْقِيمَةِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16269","عَنِ الثَّوْرِيِّ , \" فِيعَبْدٍ شَهِدَ رَجُلانِ أَنَّ سَيِّدَهُ أَعْتَقَهُ , وَقَدْ مَاتَ سَيِّدُهُ , فَسُئِلا أَفِي صَحَّتِهِ أَوْ فِي مَرَضِهِ ؟ قَالا : لا نَدْرِي , قَالَ \" هُوَ مِنَ الثُّلُثِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16270","قَالَ الثَّوْرِيُّ : \" فِيامْرَأَةٍ تُوُفِّيَتْ وَتَرَكَتْ أُخْتَهَا وَزَوْجَهَا ، وَأَعْتَقَتْ غُلامًا ثَمَنُهُ خَمْسُ مِائَةٍ ، وَعَلَى زَوْجِهَا سَبْعُ مِائَةٍ , فَإِذَا الزَّوْجُ مُفْلِسٌ , قَالَتِ الأُخْتُ لِلْعَبْدِ : إِنَّمَا أَنَا وَأَنْتَ شَرِيكَانِ , لَيْسَ لَكَ إِلا أَرْبَعُ مِائَةِ دِرْهَمٍ إِنْ خَرَجَ الْمَالُ , فَقَدْ تَوِيَ الَّذِي عَلَى الزَّوْجِ , وَتُعْطِي مِائَتَيْنِ مِنَ الأَرْبَعِ الَّتِي كَانَتْ لَكَ فِي الثُّلُثِ ، وَتُعْطِي خَمْسِينَ مِنَ الْمِائَةِ الَّتِي بَقِيَتْ عَلَيْكَ ، وَتَطْلُبُ الزَّوْجَ بِخَمْسِينَ وَمِائَةٍ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16271","قَالَ سُفْيَانُ : \" فِيرَجُلٍ أَعْتَقَ غُلامَيْنِ لَهُ , ثَمَنُ أَحَدِهِمَا أَرْبَعُ مِائَةٍ ، وَثَمَنُ الآخَرِ مِائَتَانِ , فَمَاتَ الَّذِي ثَمَنُهُ أَرْبَعُ مِائَةٍ , الْفَرِيضَةُ تِسْعَةُ أَسْهُمٍ , فَلِلْوَرَثَةِ سِتُّ مِائَةٍ ، وَلِصَاحِبِ الثُّلُثِ ثَلاثُ مِائَةٍ , فَمَاتَ صَاحِبُ الأَرْبَعِ مِائَةِ فَلَهُ سَهْمَانِ ، وَلِصَاحِبِ الْمِائَتَيْنِ سَهْمٌ , يَضْرِبُ الْوَرَثَةُ بِسِتَّةِ أَسْهُمٍ ، وَصَاحِبُ الدَّيْنِ بِسَهْمٍ , فَلَهُ سَبْعُ مِائَةٍ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16272","عَنِ الثَّوْرِيِّ , \" فِيرَجُلٍ تَرَكَ أَرْبَعَةَ أَعْبُدٍ , قِيمَةُ كُلِّ عَبْدٍ مِائَةُ دِينَارٍ ، وَأَعْتَقَ مِنْهُمْ عَبْدَيْنِ , فَمَاتَ أَحَدُهُمَا بَعْدَ مَوْتِ سَيِّدِهِ , فَالسِّهَامُ لِلْمَيِّتِ سَهْمٌ , وَمَا بَقِي فَعَلَى خَمْسَةِ أَسْهُمٍ , لِلْمُعْتَقُ مِنْ ذَلِكَ سَهْمٌ ، وَلِلْوَرَثَةِ أَرْبَعَةُ أَسْهُمٍ ، وَلِلْوَرَثَةِ خَمْسِ ثُلُثِ مِائَةٍ مِائَةٍ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16273","عَنِ الثَّوْرِيِّ ، قَالَ : فِيعَبْدٍ كُوتِبَ عَلَى أَلْفِ دِرْهَمٍ , فَمَاتَ سَيِّدُهُ وَأَوْصَى بِخَمْسِينَ دِرْهَمًا مِنْ كِتَابَتِهِ ، وَأَعْتَقَ رَقِيقًا , وَأَوْصَى بِوَصَايَا , قَالَ : \" لا يُبَاعُ الْمُكَاتِبُ , وَلا يُقَوَّمُ , وَيَبِيعُ كُلُّ إِنْسَانٍ الْمُكَاتِبَ بِحِصَتِهِ ، وَيَضْرِبُ الْمُكَاتِبُ بِمَا أَوْصَى لَهُ مَعَهُمْ , إِلا أَنَّهُ يَبْدَأُ بِالْعِتْقِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16274","عَنْ سُفْيَانَ , فِيرَجُلٍ مَاتَ وَتَرَكَ مُكَاتِبًا عَلَيْهِ أَرْبَعُ مِائَةِ دِرْهَمٍ ، وَأَعْتَقَ غُلامًا لَهُ ثَمَنُ مِائَتَيْ دِرْهَمٍ , قَالَ : \" يُعْطِيهُمِ الْعَبْدُ الَّذِي لَيْسَ بِمُكَاتِبٍ ثُلُثَيْ قِيمَتِهِ ، وَيَبِيعُ الْعَبْدُ الْمُكَاتِبُ بِمِا أَعْطَى الْوَرَثَةَ بِالثُّلُثَيْنِ مِنْ قِيمَتِهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16275","عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ , فِيعَبْدٍ بَيْنَ رَجُلَيْنِ , شَهِدَ أَحَدُهُمَا عَلَى الآخَرِ أَنَّهُ أَعْتَقَهُ , وَأَنْكَرَ الآخَرُ , قَالَ : \" إِنْ كَانَ الْمَشْهُودُ عَلَيْهِ مُعْسِرًا سَعَى لَهُ الْعَبْدُ ، وَإِنْ كَانَ مُوسِرًا سَعَى لَهُمَا جَمِيعًا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16276","وَسَأَلْتُ الثَّوْرِيَّ عَنْهَا , فَقَالَ : مِثْلَ قَوْلِ حَمَّادٍ , قَالَ مَعْمَرٌ : وَسَأَلْتُ ابْنَ شُبْرُمَةَ , فَقَالَ : \"يُعْتَقُ الْعَبْدُ وَلَيْسَ عَلَيْهِ سَعَايَةٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16277","عَنْ مُحَمَّدِ بْنِ عُمَارَةَ ، أَنَّهُ سَمِعَ أَبَا حَنِيفَةَ , يَقُولُ : \"إِنْ كَانَ الْمَشْهُودُ عَلَيْهِ مُعْسِرًا سَعَى الْعَبْدُ , وَالْوَلاءُ بَيْنَهُمَا ، وَإِنْ كَانَ الْمَشْهُودُ عَلَيْهِ مُوسِرًا كَانَ وَلاءُ نِصْفِهِ مَوْقُوفًا , فَإِنِ اعْتَرَفَ أَنَّهُ أَعْتَقَ اسْتَحَقَّ الْوَلاءَ ، وَإِلا فَإِنَّ وَلاءَهُ لِبَيْتِ الْمَالِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16278","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ , قَالَ : \"أَعْتَقَ عُمَرُ بْنُ الْخَطَّابِ كُلَّ مُسْلِمٍ مِنْ رَقِيقِ الإِمَارَةِ ، وَشَرَطَ أَنَّكُمْ تَخْدِمُونَ الْخَلِيفَةَ مِنْ بَعْدِي بِثَلاثِ سِنِينَ ، وَأَنَّهُ يَصْحَبُكُمْ بِمَا كُنْتُ أَصْحَبُكُمْ بِهِ , قَالَ : \" فَابْتَاعَ الْخِيَارُ خِدْمَتَهُ مِنْ عُثْمَانَ الثَّلاثَ سِنِينَ , بِغُلامِهِ أَبِي فَرْوَةَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16279","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ :\" أَعْتَقَ فِي وَصِيَّتِهِ كُلَّ مَنْ صَلَّى رَكْعَتَيِنِ مِنْ رَقِيقِ الْمَالِ ، وَأَعْتَقَ رَقِيقًا مِنْ رَقِيقِ الْمَالِ , كَانُوا يَحْفِرُونَ لِلنَّاسِ الْقُبُورَ ، وَشَرَطَ عَلَيْهِمُ أَنَّكُمْ تَخْدِمُونَ الْخَلِيفَةَ بَعْدِي ثَلاثَ سِنِينَ ، وَأَنَّهُ يَصْحَبُكُمْ بِمَا كُنْتُ أَصْحَبُكُمْ بِهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16280","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَيُّوبُ بْنُ سُلَيْمَانَ , قَالَ : أَخْبَرَنِي نَافِعٌ ، عَنْ عَبْدِ اللَّهِ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ :\" أَعْتَقَ كُلَّ مَنْ صَلَّى مِنْ سَبْيِ الْعَرَبِ ، فَبَتَّ عِتْقَهُمْ ، وَشَرَطَ عَلَيْهِمْ أَنَّكُمْ تَخْدِمُونَ الْخَلِيفَةَ بَعْدِي ثَلاثَ سَنَوَاتٍ ، وَشَرَطَ لَهُمْ أَنَّهُ يَصْحَبُكُمْ بِمِثْلِ مَا كُنْتُ أَصْحَبُكُمْ بِهِ , فَابْتَاعَ الْخِيَارُ خِدْمَتَهُ تِلْكَ الثَّلاثَ سَنَوَاتٍ مِنْ عُثْمَانَ بَأَبِي فَرْوَةَ , وَخَلَّى عُثْمَانُ سَبِيلَ الْخِيَارِ , فَانْطَلَقَ وَقَبَضَ عُثْمَانُ أَبَا فَرْوَةَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16281","عَنِ ابْنِ جُرَيْجٍ ، عَنْ مُوسَى بْنِ عُقْبَةَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أَنَّهُأَعْتَقَ غُلامًا لَهُ , وَشَرَطَ عَلَيْهِ أَنَّ لَهُ عَمَلَهُ ثَلاثَ سِنِينَ , فَرَعَى لَهُ بَعْضَ سَنَةٍ ، ثُمَّ قَدِمَ عَلَيْهِ بَعْضُ نَحِلِهِ , إِمَّا فِي حَجٍّ ، وَإِمَّا فِي عُمْرَةٍ , فَقَالَ لَهُ عَبْدُ اللَّهِ : \" قَدْ تَرَكْتُ لَكَ الَّذِي اشْتَرَطْتُ عَلَيْكَ , وَأَنْتَ حُرٌّ , وَلَيْسَ عَلَيْكَ عَمَلٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16282","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ , قَالَ : \"لا بَأْسَ أَنْ يَشْتَرِيَ الْعَبْدُ خِدْمَتَهُ مِنْ سَيِّدِهِ بِشَيْءٍ يُقَاطِعُهُ عَلَيْهِ , كَمَا صَنَعَ الْخِيَارُ \", قَالَ الثَّوْرِيُّ فِي رَجُلٍ قَالَ لِعَبْدِهِ : أَخْدِمْنِي عَشْرَ سِنِينَ وَأَنْتَ حُرٌّ , فَمَاتَ السَّيِّدُ قَبْلَهُ , قَالَ : هُوَ عَبْدٌ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16283","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ : \" كَانَ عَلِيٌّتَصَدَّقَ بِبَعْضِ أَرْضِهِ , جَعَلَهَا صَدَقَةً بَعْدَ مَوْتِهِ ، وَأَعْتَقَ رَقِيقًا مِنْ رَقِيقِهِ ، وَشَرَطَ عَلَيْهِمْ أَنَّكُمْ تَعْمَلُونَ فِيهَا خَمْسَ سِنِينَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16284","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، أَنَّ عَلِيًّا \"تَصَدَّقَ بِبَعْضِ أَرْضِهِ , جَعَلَهَا صَدَقَةً بَعْدَ مَوْتِهِ ، وَأَعْتَقَ رَقِيقًا مِنْ رَقِيقِهِ ، وَشَرَطَ عَلَيْهِمْ أَنَّكُمْ تَعْمَلُونَ فِي تِلْكَ الأَرْضِ خَمْسَ سِنِينَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16285","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، أَوْ غَيْرِهِ , عَنِ ابْنِ الْمُسَيِّبِ , قَالَ :إِذَا قَالَ : \" أَنْتَ حُرٌّ فَأَبَتَّ الْعِتْقَ , فَكُلُّ شَرْطٍ بَعْدَهُ بَاطِلٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16286","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ شُبْرُمَةَ , قَالَ :\" إِذَا قَالَ الرَّجُلُ لِعَبْدِهِ : أَنْتَ حُرٌّ عَلَى أَنْ تَخْدِمُنِي عَشْرَ سِنِينَ , فَلَهُ شَرْطُهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16287","وَسَمِعْتُ أَبَا حَنِيفَةَ ، سُئِلَ عَنْرَجُلٍ قَالَ لِغُلامِهِ : إِذَا أَدَّيْتَ إِلَيَّ مِائَةَ دِينَارٍ فَأَنْتَ حُرٌّ , قَالَ : \" فَأَدَّاهَا فَهُوَ حُرٌّ , وَيَأْخُذُ سَيِّدُهُ بَقِيَّةَ مَالِهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16288","عَنِ الثَّوْرِيِّ , فِيرَجُلٍ أَعْتَقَ عَبْدَهُ عَلَى أَنْ يَخْدِمَهُ عَشْرَ سِنِينَ , قَالَ : \" لَهُ شَرْطُهُ إِذَا رَضِي بِذَلِكَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16289","عَنِ الثَّوْرِيِّ , فِيرَجُلٍ نَكَحَ أَمَتَهُ رَجُلا , وَاشْتَرَطَ عَلَيْهِ الرَّجُلُ أَنَّهَا مَا وَلَدَتْ مِنِّي فَهُوَ حُرٌّ , قَالَ : \" لَهُ شَرْطُهُ , حَتَّى يَبِيعَهَا سَيِّدُهَا أَوْ يَمُوتَ , فَيَصِيرُ لِغَيْرِهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16290","عَنْ هِشَامِ ، عَنِ ابْنِ سِيرِينَ , قَالَ : جَاءَتِ امْرَأَةٌ إِلَى شُرَيْحٍ , فَقَالَتْ :أَعْتَقْتُ غُلامِي هَذَا عَلَى أَنْ يُؤَدِّيَ إِلَيَّ عَشَرَةَ الدَّرَاهِمَ فِي كُلِّ شَهْرٍ مَا عِشْتُ ، فَقَالَ شُرَيْحٌ : \" جَازَتْ عِتَاقَتُكِ , وَبَطَلَ شَرْطُكِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16291","عَنِ الثَّوْرِيِّ , \" فِيرَجُلٍ قَالَ لأَمَتِهِ إِنْ وَلَدْتِ غُلامًا فَهُوَ حُرٌّ , فَوَلَدَتْ غُلامًا ، ثُمَّ مَكَثَتْ سَاعَةً فَوَلَدَتْ آخَرَ , قَالَ : يُعْتَقُ الأَوَّلُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16292","عَنِ الثَّوْرِيِّ , قَالَ : فِيرَجُلٍ قَالَ لأَمَتِهِ \" أَوَّلُ غُلامٍ تَلِدِينِهِ فَهُوَ حُرٌّ , فَوَلَدَتْهُ مَيِّتًا ، فَلَيْسَ شَيْءٌ حَتَّى تَلِدَ بَطْنًا آخَرَ ، فَإِنْ وَلَدَتْ غُلامًا فَهُوَ حُرٌّ ، فَإِنْ شَاءَ بَاعَ هَذِهِ الَّتِي لَهَا الشَّرْطُ , لا تَقَعُ الْعَتَاقَةُ عَلَى الْمَوْتَى ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16293","وَسَمِعْتُ أَبَا حَنِيفَةَ ، وَسُئِلَ عَنْ رَجُلٍ , قَالَ : \"أَوَّلُ مَمْلُوكٍ أَمْلُكُهُ فَهُوَ حُرٌّ , فَمَلِكَ اثْنَيْنِ جَمِيعًا \" , أَخْبَرَنِي حَمَّادٌ , عَنْ إِبْرَاهِيمَ , قَالَ : \" يُعْتِقُ أَيُّهُمَا شَاءَ \" , قَالَ أَبُو حَنِيفَةَ : وَأَقُولُ أَنَا : \" لا يَعْتِقُ وَاحِدٌ مِنْهُمَا لأَنَّهُ لَيْسَ هُمَا أَوَّلَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16294","عَنِ الثَّوْرِيِّ , فِيرَجُلٍ قَالَ لِرَجُلٍ : أَعْتِقْ عَبْدَكَ وَلَكَ عَلَيَّ أَلْفُ دِرْهَمٍ , قَالَ : \" نَرَى عَتْقَهُ جَائِزًا , وَلَيْسَ عَلَى الَّذِي أَمَرَهُ شَيْءٌ , لا يَكُونُ الْوَلاءُ لِلَّذِي أَعْتَقَ ، وَيَكُونُ الْغُرْمُ عَلَى الَّذِي أَمَرَهُ الْعَبْدُ الَّذِي أُعْتِقَ , وَيُرَدُّ إِلَيْهِ مَالُهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16295","عَنِ الثَّوْرِيِّ , فِيرَجُلٍ قَالَ لِرَجُلٍ : أَعْتِقْ عَنِّي عَبْدَكَ , فَأَعْتَقَهُ عَنْهُ , قَالَ \" الْوَلاءُ لِلأَمْرِ \" , وَقَالَ : فِي رَجُلٍ قَالَتْ لَهُ أُمُّهُ : أَعْتِقْ عَنِّي عَبْدَكَ , فَأَعْتَقَهُ عَنْهَا , قَالَ : \" الْوَلاءُ لَهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16296","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، قَالَ :لَوْ قَالَ رَجُلٌ لِرَجُلٍ : أَعْتِقْ غُلامَكَ هَذَا , وَعَلَيَّ ثَمَنُهُ , قَالَ : \" هُوَ جَائِزٌ , وَوَلاؤُهُ لِسَيِّدِهِ كَمَا أَعْتَقَهُ ، وَعَلَى الْحَمِيلِ مَا تَحَمَّلَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16297","عَنِ الثَّوْرِيِّ , فِيرَجُلٍ قَالَ لِعَبْدِهِ : إنْ مِتُّ فَجْأَةً فَأَنْتَ حُرٌّ , فَقُتِلَ السَّيِّدُ , قَالَ : \" لَيْسَ الْقَتْلُ بِفُجَاءَةٍ , لا يُعْتَقُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16298","عَنِ الثَّوْرِيِّ ، قَالَ :إِذَا قَالَ لِعَبْدِهِ : \" إِذَا أَدَّيْتَ إِلَيَّ أَلْفَ دِرْهَمٍ فَأَنْتَ حُرٌّ ، ثُمَّ بَدَا لَهُ أَنْ لا يَقْبَلَ مِنْهُ شَيْئًا , كَانَ ذَلِكَ لِلسَّيِّدِ ، وَمِثْلُهُ إِذَا قَالَ : \" إِذَا سَبَّ هَذَا النَّاسِبَ فَأَنْتَ حُرٌّ ، ثُمَّ بَدَا لِلسَّيِّدِ أَنْ لا شَيْءٌ \" , قَالَ : لَيْسَ بِشَيْءٍ , وَإِذَا قَالَ : \" أَنْتَ حُرٌّ وَأَدِّ إِلَيَّ كَذَا وَكَذَا , فَإِنْ أَقَرَّ الْعَبْدُ ، وَأَدَّى إِلَيْهِ فَهُوَ حُرٌّ , وَإِنْ لَمْ يُقِرَّ أَنْ يُؤَدِّيَ إِلَيْهِ فَهُوَ 000 لَيْسَ عَلَيْهِ شَيْءٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16299","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"إِذَا أَعْتَقَ الرَّجُلُ أَمَتَهُ ، وَاسْتَثْنَى مَا فِي بَطْنِهَا , فَلَهُ مَا اسْتَثْنَى \", قَالَ سُفْيَانُ : وَنَحْنُ لا نَأْخُذُ بِذَلِكَ , نَقُولُ : \" إِذَا اسْتَثْنَى مَا فِي بَطْنِهَا عَتَقَتْ كُلُّهَا , إِنَّمَا وَلَدُهَا كَعُضْوٍ مِنْهَا , وَإِذَا أَعْتَقَ مَا فِي بَطْنِهَا وَلَمْ يَعْتِقْهَا , لَمْ يُعْتَقْ إِلا مَا فِي بَطْنِهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16300","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ , قَالا : فِيرَجُلٍ أَعْتَقَ جَارِيَةٍ لَهُ حَامِلا ، وَاسْتَثْنَى مَا فِي بَطْنِهَا , قَالا : \" لَيْسَ كَذَلِكَ بِشَيْءٍ , هِيَ وَوَلَدُهَا حُرَّانِ \", أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ ، وَالثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالا : \" شَرْطُهُ جَائِزٌ \" , مِثْلَ قَوْلِ إِبْرَاهِيمَ , عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي مَنْ سَمِعَ الْحَكَمَ بْنَ عُتَيْبَةَ , وَالْحَسَنَ , يَقُولانِ : \" هِيَ وَوَلَدُهَا حُرَّانِ \" , عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ الْمُسَيِّبِ ، مِثْلَ ذَلِكَ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16301","أَخْبَرَنَا مَعْمَرٌ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : سَأَلْتُهُ عَنْ رَجُلٍ اشْتَرَى ابْنَهُ وَهُوَ مَرِيضٌ ، ثُمَّ مَاتَ الأَبُ مِنْ مَرَضِهِ ذَلِكَ , قَالَ : \"إِنْ خَرَجَ الابْنُ مِنَ الثُّلُثِ وَرِثَ أَبَاهُ ، وَإِنْ لَمْ يَخْرُجْ مِنَ الثُّلُثِ سَعَى وَلَمْ يَرِثْ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16302","عَنْ سُفْيَانَ , فِيرَجُلٍ قَالَ لِعَبْدِهِ : يَوْمَ أَبِيعُكَ فَأَنْتَ حُرٌّ , قَالَ : \" لَيْسَ بِشَيْءٍ , وَهُوَ عَبْدُهُ \" , وَمَنْ قَالَ : إِذَا بِعْتُكَ فَأَنْتَ حُرٌّ , فَسَوَاءٌ ، قَالَ سُفْيَانُ : إِنَّمَا مَعْنَاهُ حِينَ أَفْعَلُ ذَلِكَ , قَالَ : وَمِثْلُ ذَلِكَ أَنْ يَقُولُ الرَّجُلُ : \" يَوْمَ أَمُوتَ فَأَنْتَ حُرٌّ , فَيَمُوتُ لَيْلا أَوْ نَهَارًا فَهُوَ حُرٌّ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16303","عَنْ سُفْيَانَ , \" فِيرَجُلٍ يَقُولُ لِعَبْدِهِ : هُوَ حُرٌّ يَوْمَ يَبِيعُهُ, قَالَ : كَانَ ابْنُ أَبِي لَيْلَى , وَابْنُ شُبْرُمَةَ , يَسْتَوْقِفَانِ ذَلِكَ عَلَيْهِ , قَالَ سُفْيَانُ : \" وَلا نَرَاهُ شَيْئًا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16304","عَنْ سُفْيَانَ فِيرَجُلٍ حَلَفَ بِعِتْقِ عَبْدِهِ إِنْ فَارَقْتُكَ أَوْ فَارَقْتَنِي , قَالَ : \" إِنْ قَالَ فَارَقْتُكَ فَعَلَيْهِ فَسَتَهُ إِنْ كَانَ عَلَيْهِ فَلَيْسَ عَلَيْهِ شَيْءٌ ، وَإِنْ قَالَ فَارَقْتَنِي فَعَلَيْهِ الْعَبْدُ فَهُوَ حُرٌّ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16305","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , فِيعَبْدٍ دَسَّ إِلَى رَجُلٍ مَالا , فَاشْتَرَاهُ فَأَعْتَقَهُ , قَالَ : \" الْبَيْعُ وَالْعِتقُ جَائِزٌ ، وَيَأْخُذُ سَيِّدُهُ مِنَ الْمُبْتَاعِ الثَّمَنَ الَّذِي كَانَ ابْتَاعَهُ , وَالْوَلاءُ لِمَنْ أَعْتَقَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16306","عَنْ سُفْيَانَ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , فِيرَجُلٍ يَبِيعُ عَبْدَهُ مِنْ قَوْمٍ , وَيَشْتَرِطُ عَلَيْهِمْ أَنْ يُعْتِقُوهُ , وَيَقُولُ لِعَبْدِهِ : أَنْ تُعْطِيَ كَذَا وَكَذَا , قَالَ : \" لَيْسَ عَلَى الْعَبْدِ شَيْءٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16307","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : \"لا يُقْضَى عَلَى الْعَبْدِ بِشَيْءٍ , إِلا أَنْ يَتَحَرَّجَ فَيُعْطِيهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16308","عَنْ أَبِي سُفْيَانَ , عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنِ الشَّعْبِي , فِيرَجُلٍ أَعْطَاهُ عَبْدُهُ مَالا , فَاشْتَرَاهُ فَأَعْتَقَهُ , قَالَ : \" لَوْ أَخَذْتُهُ لَعَاقَبْتُهُ عُقُوبَةً شَدِيدَةً ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16309","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ :ضَرَبَ حَمْزَةُ بْنُ عَبْدِ الْمُطِّلِبِ وَجْهَ جَارِيَتَهُ , فَجَاءَ بِهَا إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" سُبْحَانَ اللَّهِ ! مَا حَمَلَكَ عَلَى هَذَا ؟ \" , قَالَ : يَا رَسُولَ اللَّهِ , لَوْ أَعْلَمُ أَنَّهَا مُؤْمِنَةٌ أَعْتِقُهَا , قَالَ : فَسَأَلَهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ قَالَ : \" أَعْتِقْهَا فَإِنَّهَا مُؤْمِنَةٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16310","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِجَاءَ بِأَمَةٍ سَوْدَاءَ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللَّهِ , إِنَّ عَلَيَّ رَقَبَةً مُؤْمِنَةً , فَإِنْ كُنْتَ تَرَى هَذِهِ مُؤْمِنَةً , فَقَالَ لَهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَتَشْهَدِينَ أَنْ لا إِلَهَ إِلا اللَّهُ ؟ \" , قَالَتْ : نَعَمْ , قَالَ : \" أَتَشْهَدِينَ أَنِّي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ \" , قَالَتْ : نَعَمْ , قَالَ : \" أَتُؤْمِنِينَ بِالْبَعْثِ بَعْدَ الْمَوْتِ ؟ \" , قَالَتْ : نَعَمْ , قَالَ : \" أَعْتِقْهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16311","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ : أَنَّرَجُلا كَانَتْ لَهُ جَارِيَةٌ فِي غَنَمٍ تَرْعَاهَا ، وَكَانَتْ شَاةَ صَفِيٍّ , يَعْنِي غَزِيرَةً , فِي غَنَمِهِ تِلْكَ , فَأَرَادَ أَنْ يُعْطِيَهَا نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَجَاءَ السَّبُعُ فَانْتَزَعَ ضِرْعَهَا , فَغَضِبَ الرَّجُلُ فَصَكَّ وَجْهَ جَارِيَتِهِ , فَجَاءَ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ ذَلِكَ لَهُ , وَذَكَرَ أَنَّهَا كَانَتْ عَلَيْهِ رَقَبَةٌ مُؤْمِنَةٌ وَافِيَةٌ , قَدْ هَمَّ أَنْ يَجْعَلَهَا إِيَّاهَا حِينَ صَكَّهَا , فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" ائْتِنِي بِهَا ! \" , فَسَأَلَهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَتَشْهَدِينَ أَنْ لا إِلَهَ إِلا اللَّهُ ؟ \" , قَالَتْ : نَعَمْ : \" وَأَنَّ مُحَمَّدًا عَبْدُ اللَّهِ وَرَسُولُهُ ؟ \" , قَالَتْ : نَعَمْ : \" وَأَنَّ الْمَوْتَ وَالْبَعْثَ حَقٌّ ؟ \" , قَالَتْ : نَعَمْ : \" وَأَنَّ الْجَنَّةَ وَالنَّارَ حَقٌّ ؟ \" , قَالَتْ : نَعَمْ ، فَلَمَّا فَرَغَ قَالَ : \" أَعْتِقْ أَوْ أَمْسِكْ ؟ \", قُلْتُ : أَثَبَتَ هَذَا ؟ قَالَ : نَعَمْ ، وَزَعَمُوا , وَحَدَّثَنِيهِ أَبُو الزُّبَيْرِ , فَوَلَدَتْ بَعْدَ ذَلِكَ فِي قُرَيْشٍ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16312","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , قَالَ :صَكَّ رَجُلٌ جَارِيَةً لَهُ , فَجَاءَ بِهَا النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَسْتَشِيرُهُ فِي عِتْقِهَا , فَقَالَ لَهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَيْنَ رَبُّكِ ؟ \" , فَأَشَارَتْ إِلَى السَّمَاءِ , قَالَ : \" مَنْ أَنَا ؟ \" , قَالَتْ : أَنْتَ رَسُولُ اللَّهِ , قَالَ : أَحْسِبُهُ أَيْضًا ذَكَرَ الْبَعْثَ بَعْدَ الْمَوْتِ ، وَالْجَنَّةَ ، وَالنَّارَ ثُمَّ قَالَ : \" أَعْتِقْهَا فَإِنَّهَا مُؤْمِنَةٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16313","أَخْبَرَنَا مَعْمَرٌ ، وَالثَّوْرِيُّ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ أَبِي مَرَاوِحٍ الْغَفَّارِيِّ ، عَنْ أَبِي ذَرٍّ ، قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ ,أَيُّ الرِّقَابِ أَفْضَلُ ؟ قَالَ : \" أَنْفَسُهَا عِنْدَ أَهْلِهَا ، وَأَفْضَلُهَا ، وَأَغْلاهَا ثَمَنًا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16314","عَنِ الثَّوْرِيِّ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِيِّ ، \" أَنَّ رَجُلا سَأَلَهُ عَنْوَلَدِ زِنَا , وَعَنْ وَلَدِ رَشِدَةٍ أَيُّهُمَا يُعْتَقُ ؟ فَقَالَ : انْظُرْ أَكْثَرَهُمَا ثَمَنًا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16315","عَنِ الثَّوْرِيِّ ، عَنْ عُمَرَ بْنِ عَبْدِ الرَّحْمَنِ الْقُرَشِيِّ ، أَنَّ ابْنَ عَبَّاسٍ ، \"سُئِلَ عَنْ وَلَدِ زِنَا , وَوَلَدِ رَشِدَةٍ , فَقَالَ : \" انْظُرُوا أَكْثَرَهُمَا ثَمَنًا \", عَنِ الثَّوْرِيِّ ، عَنْ عُمَرَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ , قَالَ : \" كَانَ يَرَى وَلَدَ الزِّنَا بِمَنْزِلَةِ غَيْرِهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16316","عَنْ مَعْمَرٍ ، عَنِ الْحَسَنِ ، وَقَتَادَةَ , قَالا : \"يَجُوزُ فِي الرَّقَبَةِ الْوَاجِبَةِ وَلَدُ الزِّنَا , لأَنَّ كُلَّ مَوْلُودٍ يُولَدُ عَلَى الْفِطْرَةِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16317","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : \"لا يُجْزِئُ وَلَدُ الزِّنَا فِي الرَّقَبَةِ الْوَاجِبَةِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16318","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : \"لا يُجْزِئُ وَلَدُ بَغِيَّةٍ ، وَلا أُمُّ وَلَدٍ ، وَلا مُدَبَّرٌ ، وَلا يَهُودِيٌّ ، وَلا نَصْرَانِيٌّ ، وَلا مُشْرِكٌ , فِي رَقَبَةٍ وَاجِبَةٍ \", قَالَ : وَلا أَعْلَمُ الزُّهْرِيَّ إِلا قَالَ : \" يُجْزِئُ الْمُكَاتِبُ فِي الرَّقَبَةِ الْوَاجِبَةِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16319","عَنْ مَعْمَرٍ ، عَنْ أَبِي عُمَرَ الْمَدَنِيِّ ، قَالَ : سَأَلْنَا ابْنُ عُمَرَ عَنْ قِرَاءَةِ النِّهَارِ ، فَقَامَ يُصَلِّي , فَرُبَّمَا أَسْمَعَنَا الآيَةَ , قَالَ : ثُمَّ خَرَجَ إِلَى السُّوقِ فَمَشَيْنَا مَعَهُ , فَجَعَلَ لا يَمُرُّ بِصَغِيرٍ وَلا كَبِيرٍ إِلا سَلَّمَ عَلَيْهِ ابْنُ عُمَرَ , حَتَّى أَتَى سُوقَ الظَّهْرِ وَمَعَهُ عَصَاهُ فِي يَدِهِ , فَجَعَلَ يَنْخُسُ بِعَصَاهُ فِي جَنْبِ الْبَعِيرِ , ثُمَّ يَقُولُ : بِكَمْ هَذَا ؟ قَالَ : ثُمَّ يُسَاوِمُ الآخَرَ , قَالَ : فَجَاءَهُ رَجُلٌ ، فَقَالَ : إِنَّهَاكَانَتْ عَلَيَّ رَقَبَةٌ ، ثُمَّ ابْتَعْتُهَا مِنْ رَجُلٍ رَقَبَةً ، فَأَعْتَقْتُهَا , ثُمَّ أُخْبِرْتُ أَنَّ صَاحِبَهَا الْتَقَطَهَا الْتِقَاطًا ، فَقَالَ ابْنُ عُمَرَ : \" لَمْ يَقْبَلِ اللَّهُ مِنْكَ رَقَبَتَكَ فَاذْهَبْ فَخُذْ وَرَقَكَ \" , قَالَ : فَإِنِّي قَدْ أَعْتَقْتُهَا , قَالَ : \" قَدْ أَمَرْتُكَ , هُوَ ذَاكَ , لا تُجْزِئُ عَنْكَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16320","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :\" وَلَدُ الزِّنَا صَغِيرٌ أَيْجَزِئُ فِي رَقَبَةٍ مُؤْمِنَةٍ , إِذَا لَمْ يَبْلُغِ الْحَنَثَ , قَالَ : \" لا , وَلَكِنَّ كَبِيرًا رَجُلا صَدَقَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16321","عَنِ الثَّوْرِيِّ ، عَنْ لَيْثٍ ، عَنْ طَاوُسٍ , قَالَ : \"تُجْزِئُ أُمُّ الْوَلَدِ وَالْمُدَبَّرَةِ مِنْ رَقَبَةٍ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16322","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"تُجْزِئُ أُمُّ الْوَلَدِ وَالْمُدَبَّرَةُ مِنْ رَقَبَةٍ \", وَجَابِرٍ ، عَنِ الشَّعْبِيِّ , مِثْلَ ذَلِكَ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16323","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"مَنْ أَعْتَقَ مِنْ عَمَلٍ فَإِنَّهُ يُجْزِئُ ، إِذَا قَالَ : إِذَا كَانَ يَعْمَلُ عَمَلا فَأَعْتَقَ فَإِنَّهُ يُجْزِئُ إِذَا كَانَتْ لَهُ مَنْفَعَةٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16324","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ , قَالَ : \"لا يُجْزِئُ فِي الرَّقَبَةِ الْوَاجِبَةِ مُقْعَدٌ ، وَلا أَعْدَمُ ، وَلا أَجْذَمُ ، وَلا عَظِيمُ الْبَلاءِ \", وَنَحْوُ هَذَا","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16325","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :قَتْلُ النَّفْسِ خَطَأً , قَالَ : \" لا يَجُوزُ إِلا رَقَبَةً مُؤْمِنَةً كَمَا قَالَ اللَّهُ عَزَّ وَجَلَّ \" , قَالَ عَطَاءٌ : \" إِنْ قَالَ رَجُلٌ لِغُلامِهِ هُوَ حُرٌّ , فَلا يَكُونُ حُرًّا حَتَّى يَقُولُ : لِلَّهِ , لَعَلَّهُ لَمْ يُرِدِ الْعَتَاقَةَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16326","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : \"لا يَجُوزُ فِي قَتْلِ الْخَطَإِ صَبِيٌّ مُرْضَعٌ , إِلا مَنْ صَلَّى ، فَإِنَّ فِي حَرْفِ أُبَيِّ بْنِ كَعْبٍ :  فَتَحْرِيرُ رَقَبَةٍ مُؤْمِنَةٍ , لا يَجُوزُ فِيهَا صَبِيٌّ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16327","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :أَتَجُوزُ فِي قَتْلِ النَّفْسِ خَطَأً رَقَبَةٌ مُؤْمِنَةٌ غَيْرُ سَوِيَّةٍ وَهُوَ يَنْتَفِعُ بِهَا , أَعْرَجُ , وَأَشَلُّ ؟ \" فَاسْتَحِلَّ السَّوِيَّةَ ، وَذَكَرَ الْبُدْنَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16328","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : \"يَجُوزُ فِي الظِّهَارِ صَبِيٌّ مُرْضَعٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16329","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :الْيَمِينُ فِي التَّظَاهُرِ , فَإِنَّهُ لَمْ يَذْكُرْ مُؤْمِنَةً ، أَتُجْزِئُ رَقَبَةٌ غَيْرُ مُؤْمِنَةٍ ؟ قَالَ : \" مَا نَرَى فِيهَا إِلا مُؤْمِنَةً \", وَقَالَهَا عَمْرُو بْنُ دِينَارٍ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16330","أَخْبَرَنَا الثَّوْرِيُّ عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ عَطَاءٍ , قَالَ : \"يُجْزِئُ فِي الظِّهَارِ وَالْيَمِينِ , الْيَهُودِيُّ ، وَالنَّصْرَانِيُّ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16331","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :الرَّقَبَةُ الْمُؤْمِنَةُ أَيَجُوزُ فِيهَا صَبِيٌّ ؟ قَالَ : \" نَعَمْ \" , قُلْتُ : فَكَيْفَ وَلَمْ يُصَلِّ , وَلَمْ أَدْرِ مُسْلِمٌ هُوَ أَمْ لا ؟ فَقَالَ ذَلِكَ , فَرَاجَعْتُهُ بَعْدَ أَيَّامٍ فِيهِ , فَقَالَ : \" مَا أُرَاهُ إِلا مُسْلِمًا \", قَالَ : وَقَالَ : عَمْرُو بْنُ دِينَارٍ : مَا أُرَاهُ إِلا الَّذِي قَدْ بَلَغَ وَأَسْلَمَ ، قُلْتُ لِعَطَاءٍ : وَإِنَّ الَّذِي بَلَغَ دِينُهُ دِينُ مُسْلِمٍ ؟ قَالَ : \" أَجَلْ ! وَيُصَلَّى عَلَيْهِ \" ، قُلْتُ لِعَطَاءٍ : فَسُبِي أَعْجَمًا لَمْ يَبْلُغِ الْحَنَثَ , قَالَ : \" مَنْ وَلَدَهَا هُنَا أَحَبُّ إِلَيْهِ , وَلَعَلَّهُ أَنْ يَقْضِيَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16332","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :أَتُحِبُّ أَنْ يُؤَخَّرَ الْمُرْضَعُ سَنَتَيْنِ أَوْ ثَلاثَةً حَتَّى يُعْلَمَ أَنَّهُ صَحِيحٌ ؟ قَالَ : \" نَعَمْ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16333","عَنْ مَعْمَرٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ , قَالَ : \"يُجْزِئُ الأَعْوَرُ فِي الرَّقَبَةِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16334","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ : \"يَجُوزُ الأَعْمَى مِنْ رَقَبَةٍ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16335","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : قُلْتُ لَهُ : فَالأَحْوَلُ ؟ قَالَ : \"الأَحْوَلُ أَهْوَنُ مِنَ الأَعْرَجِ , فَهُوَ يَقْضِي ، وَالسَّوِيُّ أَحَبُّ إِلَيَّ \", قَالَ : وَقَالَ عَمْرُو بْنُ دِينَارٍ : أَرَى أَنْ يَجُوزَ الأَعْوَرُ وَالأَشَلُّ إِذَا أُومِنَ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
