hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"14029","(۱۴۰۲۹) حدَّثَنَا عَبْدُ الأَعْلَی بْنِ عَبْدِ الأَعْلَی ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ یَحُجُّ بِصِبْیَانِہِ فَمَنِ اسْتَطَاعَ مِنْہُمْ أَنْ یَرْمِیَ رَمَی ، وَمَنْ لَمْ یَسْتَطِعْ رَمَی عَنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 14029","","","كتاب الحج"
"14030","(۱۴۰۳۰) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ حَبِیبٍ الْمُعَلِّمِ ، عَنْ عَطَائٍ قَالَ : أَفَیُرْمَی عَنْہُ الْجِمَارَ ؟ قَالَ : نَعَمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 14030","","","كتاب الحج"
"14031","(۱۴۰۳۱) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ عَبْدِ الْمَلِکَ، عَنْ عَطَائٍ ؛ فِی الصَّبِیِّ یُحْرِمُ ، قَالَ: یُلَبِّی عَنْہُ وَالِدُہُ ، أَوْ وَلِیُّہُ۔","","Musannaf Ibn Abi Shaybah 14031","","","كتاب الحج"
"14032","(۱۴۰۳۲) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی حَسَّانٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَشْعَرَ الْہَدْیَ فِی السَّنَامِ الأَیْمَنِ ، وَأَمَاطَ عَنْہُ الدَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 14032","","","كتاب الحج"
"14033","(۱۴۰۳۳) حدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ إذَا أَرَادَ أَنْ یُشْعِرَ الْبَدَنَۃَ أَشْعَرَہَا مِنَ الْجَانِبِ الأَیْمَنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14033","","","كتاب الحج"
"14034","(۱۴۰۳۴) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إذَا کَانَتْ بَدَنَۃٌ وَاحِدَۃٌ أَشْعَرَہَا فِی شِقِّہَا الأَیْسَرِ بِیَدِہِ الْیُمْنَی ، وَإِذَا کَانَتْ بَدَنَتَیْنِ أَشْعَرَ إحْدَاہُمَا فِی الشِّقِّ الأَیْمَنِ ، وَالأُخْرَی فِی الأَیْسَرِ۔","Sahih","Musannaf Ibn Abi Shaybah 14034","","","كتاب الحج"
"14035","(۱۴۰۳۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ قَالَ : یُشْعِرُ فِی الأَیْمَنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14035","","","كتاب الحج"
"14036","(۱۴۰۳۶) حدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ الرَّازِیّ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ؛ أَنَّہُ کَانَ یُشْعِرُ فِی الأَیْمَنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14036","","","كتاب الحج"
"14037","(۱۴۰۳۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ قَالَ : أَشْعِرہَا مِنْ حَیْثُ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 14037","","","كتاب الحج"
"14038","(۱۴۰۳۸) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عِکْرِمَۃَ ، قَالَ : کَانَ أُنَاسٌ یَقْدُمُونَ مَکَّۃَ بِغَیْرِ زَادٍ ، فَنَزَلَتْ : {وَتَزَوَّدُوا فَإِنَّ خَیْرَ الزَّادِ التَّقْوَی}۔","","Musannaf Ibn Abi Shaybah 14038","","","كتاب الحج"
"14039","(۱۴۰۳۹) حدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عَطَائٍ الْبَکَّائِیِّ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنْ قَوْلِہِ تَعَالَی : {وَتَزَوَّدُوا فَإِنَّ خَیْرَ الزَّادِ التَّقْوَی}؟ قَالَ : الطَّعَامُ ، وَالطَّعَامُ یَوْمَئِذٍ قَلِیلٌ ، قُلْتُ : وَمَا الطَّعَامُ ؟ قَالَ : السَّوِیقُ وَالتَّمْرُ۔","","Musannaf Ibn Abi Shaybah 14039","","","كتاب الحج"
"14040","(۱۴۰۴۰) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ ابْنِ سُوقَۃَ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ؛ {وَتَزَوَّدُوا} قَالَ: الْخُشْکِنَانْجُ وَالسَّوِیقُ۔","","Musannaf Ibn Abi Shaybah 14040","","","كتاب الحج"
"14041","(۱۴۰۴۱) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ نَاسٌ مِنْ أَہْلِ الْیَمَنِ إذَا حَجُّوا لَمْ یَتَزَوَّدُوا ، حَتَّی یَبْلُغُوا عَقَبَۃَ کَذَا وَکَذَا ، فَنَزَلَتْ : {وَتَزَوَّدُوا فَإِنَّ خَیْرَ الزَّادِ التَّقْوَی}۔","No Data Available","Musannaf Ibn Abi Shaybah 14041","","","كتاب الحج"
"14042","(۱۴۰۴۲) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانُوا لاَ یَتَزَوَّدُونَ فِی حَجِّہِمْ حَتَّی نَزَلَتْ : {وَتَزَوَّدُوا فَإِنَّ خَیْرَ الزَّادِ التَّقْوَی} فَتَزَوَّدُوا الطَّعَامَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14042","","","كتاب الحج"
"14043","(۱۴۰۴۳) حدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَمَرَ الصُّبَیَّ بْنَ مَعْبَدٍ حَیْثُ ، أَوْ حِینَ قَرَنَ أَنْ یَذْبَحَ کَبْشًا۔","","Musannaf Ibn Abi Shaybah 14043","","","كتاب الحج"
"14044","(۱۴۰۴۴) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : الشَّاۃُ تُجْزِئُ عَنِ الْقَارِنِ مِنْ ہَدْیِہِ وَأُضحَاہُ۔","","Musannaf Ibn Abi Shaybah 14044","","","كتاب الحج"
"14045","(۱۴۰۴۵) حدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ عَلِیٍّ ، عَنْ عِکْرِمَۃَ ، قَالَ : یُجْزِئُ ہَدْیَہُ مِنْ أُضْحِیَّتِہِ۔","","Musannaf Ibn Abi Shaybah 14045","","","كتاب الحج"
"14046","(۱۴۰۴۶) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، قَالَ : سُئِلَ طَاوُوس عَنِ امْرَأَۃٍ تَمَتَّعَتْ فَلَمْ تَذْبَحْ وَضَحَّتْ ؟ قَالَ : تُجْزِئْہَا۔","","Musannaf Ibn Abi Shaybah 14046","","","كتاب الحج"
"14047","(۱۴۰۴۷) حدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عُمَرَ بْنِ عبْدِ الْعَزِیزِ ؛ أَنَّہُ کَانَ یَأْمُرُ بِالْمُتْعَۃِ وَیَحُثُّ عَلَیْہَا وَیَقُولُ : تُجْزِیئُ عَنْہُ شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 14047","","","كتاب الحج"
"14048","(۱۴۰۴۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، قَالَ : مَنْ أُحْصِرَ بِالْحَرْبِ نَحَرَ مِنْ حَیْثُ حُبِسَ ، وَحَلَّ مِنَ النِّسَائِ وَمِنْ کُلِّ شَیْئٍ ، کَمَا صَنَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 14048","","","كتاب الحج"
"14049","(۱۴۰۴۹) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ فِی الْمُحْصَرِ ، قَالَ: یَبْعَثُ بِہَدْیِہِ ، فَإِذَا ذُبِحَ حَلَّ۔","","Musannaf Ibn Abi Shaybah 14049","","","كتاب الحج"
"14050","(۱۴۰۵۰) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَأَلَنِی سَعِیدُ بْنُ جُبَیْرٍ عَنْ ہَذا ؟ فَأَخْبَرْتُہُ، فَقَالَ : بِیَدِہِ : ہَکَذَا قَالَ ابْنُ عَبَّاسٍ۔","Sahih","Musannaf Ibn Abi Shaybah 14050","","","كتاب الحج"
"14051","(۱۴۰۵۱) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامِ بْنِ حَسَّانٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ قَالَ فِی الْمُحْصَرِ : إِذَا رَجَعَ لاَ یَحِلُّ مِنْہُ إِلاَّ رَأْسُہُ۔","","Musannaf Ibn Abi Shaybah 14051","","","كتاب الحج"
"14052","(۱۴۰۵۲) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ عَطَائٍ ، قَالَ : قدْ حَلَّ مِنْ کُلِّ شَیْئٍ ، فَہُوَ بِمَنْزِلَۃِ الْحَلاَلِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14052","","","كتاب الحج"
"14053","(۱۴۰۵۳) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا نُحِرَ ہَدْیُہُ حَلَّ۔","Sahih","Musannaf Ibn Abi Shaybah 14053","","","كتاب الحج"
"14054","(۱۴۰۵۴) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ؛ أَنَّ رَجُلاً مِنْ وَہْبِیل أُحْصِرَ ، فَقَالَ عَبْدُ اللہِ : إذَا ذُبِحَ ہَدْیُہُ حَلَّ مِنْ کُلِّ شَیْئٍ۔","Da'if","Musannaf Ibn Abi Shaybah 14054","","","كتاب الحج"
"14055","(۱۴۰۵۵) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الْمُحْصَرِ ، قَالَ : یَبْعَثُ بِالْہَدْیِ ، فَإِذَا نُحِرَ حَلَّ ، وَعَلَیْہِ حَجٌّ مِنْ قَابِلٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 14055","","","كتاب الحج"
"14056","(۱۴۰۵۶) حدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ یَقُولُ : إذَا فَرَضَ الرَّجُلُ الْحَجَّ فَأَصَابَہُ حَصْرٌ ، فَإِنَّہُ یَبْعَثُ بِہَدْیِہِ ، فَإِذَا بَلَغَ الْہَدْیُ مَحِلَّہُ ، فَإِنَّہُ إِنْ شَائَ رَجَعَ وَحَلَّ مِنْ أَشْیَائَ وَحَرُمَ مِنْ أُخْرَی۔","","Musannaf Ibn Abi Shaybah 14056","","","كتاب الحج"
"14057","(۱۴۰۵۷) حدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ سَالِمًا ، وَالْقَاسِمَ عَنِ الْمُحْصَرِ ؟ فَقَالاَ فِیہِ قَوْلَ مُحَمَّدٍ۔","","Musannaf Ibn Abi Shaybah 14057","","","كتاب الحج"
"14058","(۱۴۰۵۸) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : إِذَا ذُبِحَ ہَدْیُ الْمُحْصَرِ حَلَّ لَہُ کُلُّ شَیْئٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 14058","","","كتاب الحج"
"14059","(۱۴۰۵۹) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ عَلْقَمَۃَ ، وَالأَسْوَدِ ؛ أَنَّہُمَا قَالاَ : إِنَّ مِنْ تَمَامِ الْحَجِّ أَنْ یَشْہَدَ الصَّلاَتَیْنِ مَعَ الإِمَامِ بِعَرَفَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14059","","","كتاب الحج"
"14060","(۱۴۰۶۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ أَنْ یُصَلُّوا الصَّلاَتَیْنِ ؛ الظُّہْرَ ، وَالْعَصْرَ مَعَ الإِمَامِ بِعَرَفَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14060","","","كتاب الحج"
"14061","(۱۴۰۶۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ ابْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یُصَلِّی الصَّلاَتَیْنِ مَعَ الإِمَامِ بِعَرَفَۃَ ، الظُّہْرَ وَالْعَصْرَ۔","","Musannaf Ibn Abi Shaybah 14061","","","كتاب الحج"
"14062","(۱۴۰۶۲) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ عَمْرِو بْنِ عَبْدِ اللہِ بْنِ صَفْوَانَ ، عَنْ یَزِیدَ بْنِ شَیْبَانَ، قَالَ: کُنَّا وُقُوفًا فِی مَکَان بَعِیدٍ، نُبَاعِدُہُ مِنَ الْمَوْقِفِ، فَأَتَانَا ابْنُ مِرْبَعٍ، فَقَالَ: إنِّی رَسُولُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَیْکُمْ یَقُولُ: کُونُوا عَلَی مَشَاعِرِکُمْ، فَإِنَّکُمَ عَلَی إرْثٍ مِنْ إرْثِ إبْرَاہِیمَ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔n(ترمذی ۸۸۳۔ ابوداؤد ۱۹۱۴)","Sahih","Musannaf Ibn Abi Shaybah 14062","","","كتاب الحج"
"14063","(۱۴۰۶۳) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ الْمُنْکَدِرِ ، وَزَیْدِ بْنِ أَسْلَمَ ؛ قَالاَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَرَفَۃُ کُلُّہَا مَوْقِفٌ ، وَارْتَفِعُوا عَنْ بَطْنِ عُرَنَۃَ۔ (احمد ۴/۸۲۔ بزار ۳۴۴۳)","","Musannaf Ibn Abi Shaybah 14063","","","كتاب الحج"
"14064","(۱۴۰۶۴) حدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَرَفَۃُ کُلُّہَا مَوْقِفٌ۔ (ابوداؤد ۱۹۳۲۔ دارمی ۱۸۷۹)","Hasan","Musannaf Ibn Abi Shaybah 14064","","","كتاب الحج"
"14065","(۱۴۰۶۵) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ سَمِعَہُ یَقُولُ : عَرَفَۃُ کُلُّہَا مَوْقِفٌ ، فَمَنْ شَائَ بَلَغَ مَوْقِفَ الإِمَامِ ، وَمَنْ شَائَ فَدُونَہُ۔","","Musannaf Ibn Abi Shaybah 14065","","","كتاب الحج"
"14066","(۱۴۰۶۶) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ الزُّبَیْرِ، قَالَ: عَرَفَۃُ کُلُّہَا مَوْقِفٌ، إِلاَّ بَطْنَ عُرَنَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 14066","","","كتاب الحج"
"14067","(۱۴۰۶۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، قَالَ : حدَّثَنِی مَنْ رَأَی ابْنَ عَبَّاسٍ وَاقِفًا عِنْدَ الْحِیَاضِ ، یَعْنِی بِعَرَفَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 14067","","","كتاب الحج"
"14068","(۱۴۰۶۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامِ بْنِ حَسَّانٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ قَالَ : عَرَفَۃُ کُلُّہَا مَوْقِفٌ ، إِلاَّ بَطْنَ عُرَنَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 14068","","","كتاب الحج"
"14069","(۱۴۰۶۹) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یُحِبُّونَ أَنْ یَقِفَ الرَّجُلُ قَرِیبًا مِنَ الإِمَامِ ، قَالَ عَبْدُ اللہِ بْنُ عُمَرَ : یَا أَیُّہَا النَّاسُ ، لاَ تَقْتُلُوا أَنْفُسَکُمْ ، فَإِنَّ کُلَّ مَا ہَاہُنَا مَوْقِفٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14069","","","كتاب الحج"
"14070","(۱۴۰۷۰) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، سَمِعَ سَعِیدَ بْنَ عَبْدِ الرَّحْمَنِ بْنَ یَرْبُوعٍ یُخْبِرُ ، عَنْ جُبَیِْرِ بْنِ الْحُوَیْرِثِ ، سَمِعْتُ أَبَا بَکْرٍ وَہُوَ وَاقِفٌ عَلَی قُزَحٍ وَہُوَ یَقُولُ: یَا أَیُّہَا النَّاسُ ، أَصْبِحُوا، أَصْبِحُوا، ثُمَّ دَفَعَ ، فَکَأَنِّی أَنْظُرُ إلَی فَخِذِہِ قَدِ انْکَشَفَت مِمَّا یُحَرِّشُ بَعِیرَہُ بِمِحْجَنِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 14070","","","كتاب الحج"
"14071","(۱۴۰۷۱) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ الزُّبَیْرِ ، قَالَ : الْمُزْدَلِفَۃُ کُلُّہَا مَوْقِفٌ ، إِلاَّ بَطْنَ مُحَسِّرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 14071","","","كتاب الحج"
"14072","(۱۴۰۷۲) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ قَالَ : جَمْعٌ کُلُّہَا مَوْقِفٌ ، إِلاَّ بَطْنَ مُحَسِّرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 14072","","","كتاب الحج"
"14073","(۱۴۰۷۳) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، قَالَ : قُلْتُ لَہُ : أَیْنَ کَانَ ابْنُ عُمَرَ یَقِفُ مِنْ جَمْعٍ ؟ قَالَ : کَانَ لاَ یَنْتَہِی یَتَخَلَّصُ حَتَّی یَقِفَ عَلَی قُزَحٍ۔","Sahih","Musannaf Ibn Abi Shaybah 14073","","","كتاب الحج"
"14074","(۱۴۰۷۴) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَأَلْتُ عَطَائً : أَیْنَ مِنًی ؟ فَقَالَ : مَا بَیْنَ الْعَقَبَۃِ إلَی مُحَسِّرٍ، فَمَا أُحِبُّ أَنْ یَنْزِلَ أَحَدٌ إِلاَّ فِیمَا بَیْنَ الْعَقَبَۃِ إلَی مُحَسِّرٍ۔","","Musannaf Ibn Abi Shaybah 14074","","","كتاب الحج"
"14075","(۱۴۰۷۵) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حُسَیْنِ بْنِ عُقَیْلٍ ، عَنِ الضَّحَّاکِ ، قَالَ : قِفْ خَلْفَ الْمَشْعَرِ الْحَرَامِ، فَإِنْ لَمْ تَقْدِرْ ، فَإِذَا حَاذَیْتَ بِہِ ذَکَرْتَ اللَّہَ وَدَعَوْتہ ، فَإِنَّہُ تَعَالَی قَالَ : {اُذْکُرُوا اللَّہَ عِنْدَ الْمَشْعَرِ الْحَرَامِ}۔","","Musannaf Ibn Abi Shaybah 14075","","","كتاب الحج"
"14076","(۱۴۰۷۶) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حُسَینٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ أَنْ یَقِفُوا بِالْمُزْدَلِفَۃِ ، حِیَالَ الْجَبَلِ۔","Hasan","Musannaf Ibn Abi Shaybah 14076","","","كتاب الحج"
"14077","(۱۴۰۷۷) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ ضَحَّی بِالْمَدِینَۃِ ، وَحَلَقَ رَأْسَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 14077","","","كتاب الحج"
"14078","(۱۴۰۷۸) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مُحَمَّدِ بْنِ أَبِی إسْمَاعِیلَ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَمِعْتُہُ یَقُولُ : لَیْسَ الْحَلْقُ إِلاَّ بِمَکَّۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14078","","","كتاب الحج"
"14079","(۱۴۰۷۹) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ نَافِعٍ ، أَوْ عَبْدِ اللہِ بْنِ أَبِی سَلَمَۃَ ؛ أَنَّ ابْنَ عُمَرَ کَانَ إذَا لَمْ یَحُجَّ حَلَقَ رَأْسَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 14079","","","كتاب الحج"
"14080","(۱۴۰۸۰) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ؛ أَنَّ الْحَسَنَ کَانَ یَحْلِقُ رَأْسَہُ یَوْمَ النَّحْرِ بِالْبَصْرَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14080","","","كتاب الحج"
"14081","(۱۴۰۸۱) حدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لِمُحَمَّدٍ : کَانُوا یَسْتَحِبُّونَ أَنْ یَأْخُذَ الرَّجُلُ مِنْ شَعْرِہِ یَوْمَ النَّحْرِ ؟ قَالَ : نَعَمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 14081","","","كتاب الحج"
"14082","(۱۴۰۸۲) حدَّثَنَا حَاتِم بْنُ إسْمَاعِیلَ، عَنْ جَعْفَرٍ، عَنْ أَبِیہِ، عَنْ جَابِرٍ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَاقَ مِئَۃ بَدَنَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 14082","","","كتاب الحج"
"14083","(۱۴۰۸۳) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ الأَشْعَرِیَّ أَہْدَی بُدْنًا مُجَلَّلَۃً۔","","Musannaf Ibn Abi Shaybah 14083","","","كتاب الحج"
"14084","(۱۴۰۸۴) حدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ؛ أَنَّہُ أَہْدَی بَدَنَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 14084","","","كتاب الحج"
"14085","(۱۴۰۸۵) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ؛ أَنَّ ابْنَ الزُّبَیْرِ سَاقَ عَشْرَ بَدَنَاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 14085","","","كتاب الحج"
"14086","(۱۴۰۸۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُہْدِی فِی الْحَجِّ بَدَنَتَیْنِ ، وَفِی الْعُمْرَۃِ بَدَنَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 14086","","","كتاب الحج"
"14087","(۱۴۰۸۷) حدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ أَبِی جَعْفَرٍ مَوْلَی ابْنِ عَیَّاشٍ ، قَالَ : رَأَیْتُ عَبْدَ اللہِ بْنَ عَیَّاشٍ أَہْدَی مَرَّۃً بَدَنَتَیْنِ ، إحْدَاہُمَا بُخْتِیَّۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 14087","","","كتاب الحج"
"14088","(۱۴۰۸۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ؛ أَنَّہُ أَہْدَی بَدَنَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 14088","","","كتاب الحج"
"14089","(۱۴۰۸۹) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ سُلَیْمَانَ بْنِ عَمْرِو بْنِ الأَحْوَص الأَزْدِیِّ ، عَنْ أُمِّہِ، قَالَتْ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لاَ یَقْتُلُ بَعْضُکُمْ بَعْضًا ، وَإِذَا رَمَیْتُمُ الْجَمْرَۃَ فَارْمُوا بِمِثْلِ حَصَی الْخَذْفِ۔ (ابوداؤد ۱۹۶۱۔ احمد ۵/۳۷۶)","Da'if","Musannaf Ibn Abi Shaybah 14089","","","كتاب الحج"
"14090","(۱۴۰۹۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، رَفَعَہُ ، قَالَ : ارْمُوہَا بِمِثْلِ حَصَی الْخَذْفِ۔n(ترمذی ۸۸۶۔ احمد ۳/۳۰۱)","Sahih","Musannaf Ibn Abi Shaybah 14090","","","كتاب الحج"
"14091","(۱۴۰۹۱) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ حُمَیْدٍ الأَعْرَجِ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن رَجُلٍ مِنْ قَوْمِہِ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَلِّمُ النَّاسَ مَنَاسِکَہُمْ ، قَالَ : ثُمَّ قَالَ : ارْمُوا الْجَمْرَۃَ بِمِثْلِ حَصَی الْخَذْفِ۔ (ابوداؤد ۱۹۵۲۔ احمد ۴/۶۱)","Sahih","Musannaf Ibn Abi Shaybah 14091","","","كتاب الحج"
"14092","(۱۴۰۹۲) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جابر ، قَالَ : ارْمُوا الْجَمْرَۃَ بِمِثْلِ حَصَی الْخَذْفِ۔","","Musannaf Ibn Abi Shaybah 14092","","","كتاب الحج"
"14093","(۱۴۰۹۳) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا نَلْتَقِطُ حَصَی الْخَذْفِ۔","","Musannaf Ibn Abi Shaybah 14093","","","كتاب الحج"
"14094","(۱۴۰۹۴) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَأَلْتُ عَطَائً عَنْ حَصَی رَمْیِ الْجِمَارِ ؟ قَالَ : کَانَ یُقَالُ: حَصًی بَیْنَ الْحَصَاتَیْنِ ، قَالَ : قُلْتُ : مَا ہُوَ ؟ قَالَ : حَصَی الَّذِی یُخْذَفُ بِہِ۔","","Musannaf Ibn Abi Shaybah 14094","","","كتاب الحج"
"14095","(۱۴۰۹۵) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : الْحَصَی الَّذِی تُرْمَی بِہِ الْجِمَارُ مِثْلُ حَصَی الْخَذْفِ۔","","Musannaf Ibn Abi Shaybah 14095","","","كتاب الحج"
"14096","(۱۴۰۹۶) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ أَبِی مَعْبَدٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ الْفَضْلِ بْنِ عَبَّاسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : ارْمُوا الْجَمْرَۃَ بِمِثْلِ حَصَی الْخَذْفِ۔n(مسلم ۲۶۸۔ دارمی ۱۸۹۱)","Hasan","Musannaf Ibn Abi Shaybah 14096","","","كتاب الحج"
"14097","(۱۴۰۹۷) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَوْفٍ ، عَنْ زِیَادِ بْنِ الْحُصَیْنِ ، قَالَ : حدَّثَنِی أَبُو الْعَالِیَۃِ عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ غَدَاۃَ الْعَقَبَۃِ : اُلْقُطْ لِی حَصًی ، قَالَ : فَلَقَطْتُ لَہُ حَصَیَاتٍ ، ہُنَّ حَصَی الْخَذْفِ ، قَالَ : فَقَالَ : بِمِثْلِ ہَذَا فَارْمُوا : ثُمَّ قَالَ : إیَّاکُمْ وَالْغُلُوَّ فِی الدِّینِ۔","Sahih","Musannaf Ibn Abi Shaybah 14097","","","كتاب الحج"
"14098","(۱۴۰۹۸) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ یَحْیَی بْنِ قِمْطَۃَ ، عَنْ سَالِمٍ ، قَالَ : تُجْزِئُ الْمَکْتُوبَۃُ مِنْ رَکْعَتَیِ الطَّوَافِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14098","","","كتاب الحج"
"14099","(۱۴۰۹۹) حدَّثَنَا غُنْدَرٌ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : تُجْزِئُ الْمَکْتُوبَۃُ مِنْ رَکْعَتَیِ الطَّوَافِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14099","","","كتاب الحج"
"14100","(۱۴۱۰۰) حدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : تُجْزِئُ الْمَکْتُوبَۃُ مِنْ رَکْعَتَیِ الطَّوَافِ۔","","Musannaf Ibn Abi Shaybah 14100","","","كتاب الحج"
"14101","(۱۴۱۰۱) حدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : طُفْتُ بِالْبَیْتِ وَحَضَرْتُ الْمَکْتُوبَۃَ ، فَأَرَدْتُ أَنْ أُصَلِّیَ رَکْعَتَیْنِ، وَثَمَّ أُنَاسٌ جُلُوسٌ ، فَأَتَیْتُ حَلْقَۃً فَسَأَلْتُہُمْ ؟ فَقَالَ لِی شَیْخٌ : أَمَا تَرْضَی بِابْنِ عُمَرَ ؟ رَأَیْتُہُ یَفْعَلُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 14101","","","كتاب الحج"
"14102","(۱۴۱۰۲) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ مُجَاہِدٍ (ح) وَعَنْ إسْمَاعِیلَ بْنِ عبْدِ الْمَلِکِ ، عَنْ عَطَائٍ (ح) وَعَنْ مِسْعَرٍ ، عَنْ وَبَرَۃَ ، عَنِ ابْنِ الأَسْوَدِ (ح) وَعَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ قَالُوا : تُجْزِئُ الْمَکْتُوبَۃُ مِنْ رَکْعَتَیِ الطَّوَافِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14102","","","كتاب الحج"
"14103","(۱۴۱۰۳) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : مَضَتِ السُّنَّۃُ أَنَّ مَعَ کُلِّ سُبُوعٍ رَکْعَتَیْنِ ، لاَ یُجْزِئُ مِنْہُمَا تَطَوُّعٌ ، وَلاَ فَرِیضَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 14103","","","كتاب الحج"
"14104","(۱۴۱۰۴) حدثنا ابْنُ یَمَانٍ، عَنْ لَیْثٍ، عَنْ عَطَائٍ، وَطَاوُوسٍ، وَمُجَاہِدٍ، قَالُوا: تُجْزِئُ الْمَکْتُوبَۃُ مِنْ رَکْعَتَیِ الطَّوَافِ۔","","Musannaf Ibn Abi Shaybah 14104","","","كتاب الحج"
"14105","(۱۴۱۰۵) حدَّثَنَا عَبْدُاللہِ بْنُ نُمَیْرٍ، عَنْ عَبْدِالْمَلِکِ بْنِ أَبِی سُلَیْمَانَ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُؤْخَذَ مِنْ طِیبِ الْکَعْبَۃِ شَیْئٌ یُسْتَشْفَی بِہِ ، وَکَانَ إذَا رَأَی الْخَادِمَ تَأْخُذُ مِنْہ قَفَدَہَا قَفْدۃً لاَ یَأْلُو أَنْ یُوَجِعَہَا۔n قَالَ عَطَائٌ : کَانَ أَحَدُنَا إذَا أَرَادَ أَنْ یَسْتَشْفِیَ بِہِ ، جَائَ بِطِیبٍ مِنْ عِنْدِہِ یَمْسَحُ بِہِ الْحَجَرَ ، ثُمَّ أَخَذَہُ۔","","Musannaf Ibn Abi Shaybah 14105","","","كتاب الحج"
"14106","(۱۴۱۰۶) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ یُحَتُّ الْخَلُوقُ مِنَ الْبَیْتِ ، إِلاَّ أَنْ یُوہَبَ لَہُ۔","","Musannaf Ibn Abi Shaybah 14106","","","كتاب الحج"
"14107","(۱۴۱۰۷) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، قَالَ : سَأَلْتُ مُجَاہِدًا ، وَعَطَائً عَنِ الْمُحْرِمِ یَتَوَضَّأُ فَتَقَعُ الشَّعَرَاتُ ؟ فَقَالاَ : لَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 14107","","","كتاب الحج"
"14108","(۱۴۱۰۸) حدَّثَنَا وَکِیعٌ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، قَالَ : سَمِعْتُ سَالِمًا وَسَأَلَہُ رَجُلٌ عَنْ رَجُلٍ مَسَّ لِحْیَتَہُ فَوَقَعَتْ مِنْہَا شَعَرَاتٌ ؟ قَالَ : أُفّ ، أُفّ۔","","Musannaf Ibn Abi Shaybah 14108","","","كتاب الحج"
"14109","(۱۴۱۰۹) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ مُحَمَّدِ بْنِ عَلِیٍّ ، وابْنِ الأَسْوَدِ ؛ فِی الرَّجُلِ یَتَوَضَّأُ فَیَمْسَح لِحْیَتَہُ فَتَقَعُ الشَّعَرَاتُ ؟ فَقَالاَ : لَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 14109","","","كتاب الحج"
"14110","(۱۴۱۱۰) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا مِنْ أَیَّامٍ أَحَبَّ إلَی اللہِ فِیہِنَّ الْعَمَلُ مِنْ ہَذِہِ الأَیَّامِ ، أَیَّامِ الْعَشْرِ ، فَأَکْثِرُوا فِیہِنَّ التَّکْبِیرَ وَالتَّہْلِیلَ وَالتَّحْمِیدَ۔ (احمد ۷۵۔ بیہقی ۳۴۷۵)","Da'if","Musannaf Ibn Abi Shaybah 14110","","","كتاب الحج"
"14111","(۱۴۱۱۱) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْکِینٍ عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : سَمِعْتُ مُجَاہِدًا ، وَکَبَّرَ رَجُلٌ أَیَّامَ الْعَشْرِ ، فَقَالَ مُجَاہِدٌ : أَفَلاَ رَفَعَ صَوْتَہُ ، فَلَقَدْ أَدْرَکْتُہُمْ وَإِنَّ الرَّجُلَ لَیُکَبِّرُ فِی الْمَسْجِدِ فَیَرْتَجُّ بِہَا أَہْلُ الْمَسْجِدِ ، ثُمَّ یَخْرُجُ الصَّوْتُ إلَی أَہْلِ الْوَادِی حَتَّی یَبْلُغَ الأَبْطُحَ، فَیَرْتَجُّ بِہَا أَہْلُ الأَبْطُحِ، وَإِنَّمَا أَصْلُہَا مِنْ رَجُلٍ وَاحِدٍ۔","","Musannaf Ibn Abi Shaybah 14111","","","كتاب الحج"
"14112","(۱۴۱۱۲) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ التَّکْبِیرِ أَیَّامَ الْعَشْرِ ؟ فَقَالاَ : مُحْدَثٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14112","","","كتاب الحج"
"14113","(۱۴۱۱۳) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَقْدَمُ مَکَّۃَ فَیَطُوفُ ، ثُمَّ یَرْجِعُ فَیُقِیلُ ، فَإِذَا کَانَ بِالْعَشِیِّ رَاحَ فَطَافَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","","Musannaf Ibn Abi Shaybah 14113","","","كتاب الحج"
"14114","(۱۴۱۱۴) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عُبَیْدِ اللہ ، عَنِ الْقَاسِمِ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 14114","","","كتاب الحج"
"14115","(۱۴۱۱۵) حدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ أَیُّوبَ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ إذَا طَافَ أَنْ یُؤَخِّرَ السَّعْیَ حَتَّی یُبْرِدَ۔","","Musannaf Ibn Abi Shaybah 14115","","","كتاب الحج"
"14116","(۱۴۱۱۶) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مِسْعَرٍ ، قَالَ : أَخْبَرَنِی إِسْحَاقُ مَوْلًی لِقُرَیْشٍ ، قَالَ : قَدِمَ عَلَیْنَا سَعِیدُ بْنُ جُبَیْرٍ فَطَافَ بِالْبَیْتِ سَبْعًا ، وَصَلَّی رَکْعَتَیْنِ ، ثُمَّ أَخَّرَ السَّعْیَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ إلَی الْعَشِی۔","No Data Available","Musannaf Ibn Abi Shaybah 14116","","","كتاب الحج"
"14117","(۱۴۱۱۷) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُفَرِّقَ بَیْنَ الطَّوَافِ وَالسَّعْیِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14117","","","كتاب الحج"
"14118","(۱۴۱۱۸) حدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یَعْتَدُّ بِہِ ، یَطُوفُ بِالْبَیْتِ ، ثُمَّ یَطُوفُ بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، فَإِنْ لَمْ یَفْعَلْ حَتَّی یَمْسی ، قَالَ : قَدْ قَضَی مَا عَلَیْہِ ، وَلاَ شَیْئَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 14118","","","كتاب الحج"
"14119","(۱۴۱۱۹) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ بَدَأَ بِالصَّفَا وَالْمَرْوَۃِ قَبْلَ الْبَیْتِ ، قَالَ : یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 14119","","","كتاب الحج"
"14120","(۱۴۱۲۰) حدَّثَنَا زَیْدُ بْنُ حُبَابٍ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ مُحْرِمًا وَعَلَیْہِ حُلَّۃُ حِبَرَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 14120","","","كتاب الحج"
"14121","(۱۴۱۲۱) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : یُحْرِمُ فِیمَا شَائَ ، إِنْ شَائَ ثَوْبَیْنِ أَبْیَضَیْنِ ، وَإِنْ شَائَ فِی ثَوْبَیْنِ غَسِیلَیْنِ ، وَإِنْ شَائَ فِی ثَوْبیْ حِبَرَۃٍ۔","","Musannaf Ibn Abi Shaybah 14121","","","كتاب الحج"
"14122","(۱۴۱۲۲) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَسْعَی فِی بَطْنِ الْمَسِیلِ ، إِذَا طَافَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ ۔ وَکَانَ ابْنُ عُمَرَ یَفْعَلُ ذَلِکَ۔n(بخاری ۱۶۱۷۔ دارمی ۱۸۴۱)","Sahih","Musannaf Ibn Abi Shaybah 14122","","","كتاب الحج"
"14123","(۱۴۱۲۳) حدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : یَسْعَی الرَّجُلُ بَیْنَ الصَّفَا وَالْمَرْوَۃِ فِی بَطْنِ الْمَسِیلِ ، وَلاَ یَشُدَّ السَّعْیَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14123","","","كتاب الحج"
"14124","(۱۴۱۲۴) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، قَالَ : سَعَیْتُ مَعَ ابْنِ عُمَرَ فِی بَطْنِ الْمَسِیلِ۔","Hasan","Musannaf Ibn Abi Shaybah 14124","","","كتاب الحج"
"14125","(۱۴۱۲۵) حدَّثَنَا جَرِیرُ بْنُ عَبْدِ الحمِید ، عَنْ لَیْثٍ، عَنْ عَطَائٍ، قَالَ: إِنْ شَائَ سَعَی فِی الْوَادِی، وَإِنْ شَائَ لَمْ یَسْعَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14125","","","كتاب الحج"
"14126","(۱۴۱۲۶) حدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَسْعَی فِی بَطْنِ الْمَسِیلِ وَحْدَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14126","","","كتاب الحج"
"14127","(۱۴۱۲۷) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یَسْعَی فِی الْمَسِیلِ۔","","Musannaf Ibn Abi Shaybah 14127","","","كتاب الحج"
"14128","(۱۴۱۲۸) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّ الزُّبَیْرَ کَانَ یُوکی مَا بَیْنَ الصَّفَا وَالْمَرْوَۃِ سَعْیًا۔","Sahih","Musannaf Ibn Abi Shaybah 14128","","","كتاب الحج"
"14129","(۱۴۱۲۹) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ ، قَالَ : رَأَیْتُہمَا یَسْعَیَانِ مِنْ خَوْخَۃِ بَنِی عَبَّادٍ إلَی زُقَاقِ بَنِی أَبِی حُسَیْنٍ ، فَقُلْتُ لِمُجَاہِدٍ ؟ فَقَالَ : ہَذَا بَطْنُ الْمَسِیلِ الأَوَّلُ ، وَلَکِنَّ النَّاسَ انْتَقَصُوا مِنْہُ۔","","Musannaf Ibn Abi Shaybah 14129","","","كتاب الحج"
"14130","(۱۴۱۳۰) حدَّثَنَا الثَّقَفِیُّ ، عَنْ حَبِیبٍ الْمُعَلِّمِ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ طَافَ فَکَانَ مِنْ طَوَافِہِ دُخُولٌ فِی الْحِجْرِ ، قَالَ : لاَ یَعْتَدُّ بِمَا کَانَ مِنْ دُخُولِ الْحِجْرِ۔","","Musannaf Ibn Abi Shaybah 14130","","","كتاب الحج"
"14131","(۱۴۱۳۱) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ رَأَی سَالِمًا یَطُوفُ وَمَعَہُ ہِشَامٌ ، فَأَرَادَ ہِشَامٌ أَنْ یَدْخُلَ الْحِجْرَ فَمَنَعَہُ سَالِمٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14131","","","كتاب الحج"
"14132","(۱۴۱۳۲) حدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ طَافَ الطَّوَافَ الْوَاجِبَ ،فَجَعَلَ یَجْتَازُ فِی الْحِجْرِ ، قَالَ : یُعِیدُ الطَّوَافَ ، فَإِنْ کَانَ حَلَّ وَغَشِیَ النِّسَائَ أَہْرَقَ لِذَلِکَ دَمًا۔","","Musannaf Ibn Abi Shaybah 14132","","","كتاب الحج"
"14133","(۱۴۱۳۳) حدَّثَنَا حَفْصُ بن غَیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ؛ أَنَّ عُمَرَ جَمَّعَ بِمِنًی۔","","Musannaf Ibn Abi Shaybah 14133","","","كتاب الحج"
"14134","(۱۴۱۳۴) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : رَأَیْتُ النَّاسَ یُجَمِّعُونَ بِمِنًی وَیَدْعُونَ۔","","Musannaf Ibn Abi Shaybah 14134","","","كتاب الحج"
"14135","(۱۴۱۳۵) حدَّثَنَا حَفْصٌ، عَنْ عَبْدِالْمَلِکِ، عَنْ عَطَائٍ، قَالَ: سَمِعْتُہُ وَسُئِلَ عَلَی أَہْلِ مِنًی جُمُعَۃٌ؟ قَالَ: إنَّمَا ہُمْ سَفَرٌ۔","","Musannaf Ibn Abi Shaybah 14135","","","كتاب الحج"
"14136","(۱۴۱۳۶) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ، عَنْ خَالِدِ بْنِ أَبِی عُثْمَانَ، قَالَ: شَہِدْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ لاَ یَجْمِّعُ بِمِنًی۔","","Musannaf Ibn Abi Shaybah 14136","","","كتاب الحج"
"14137","(۱۴۱۳۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ اللہِ بْنِ کَثِیرٍ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَوْمَ الصَّدَرِ وَوَافَقَ یَوْمَ جُمُعَۃٍ، فَأَقَامَ فَخَطَبَ بِالأَرْضِ قِبَلَ الْبَیْتِ، ثُمَّ تَکَلَّمَ بِکَلِمَاتٍ، ثُمَّ صَلَّی الْجُمُعَۃَ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 14137","","","كتاب الحج"
"14138","(۱۴۱۳۸) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ صَلَّی بِالْحَصْبَۃِ الْجُمُعَۃَ ، وَلَمْ یُجَمِّعْ بِہَا ، وَجَمَّعَ أَہْلُ الْبَلَدِ ، قَالَ ابْنُ أَبِی ذِئْبٍ : جَعَلَہَا ظُہْرًا۔","","Musannaf Ibn Abi Shaybah 14138","","","كتاب الحج"
"14139","(۱۴۱۳۹) حدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ یَزِیدَ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ، قَالَ : قَالَ عَبْدُ اللہِ : لَیْسَ عَلَی الْمُسْلِمِینَ جُمُعَۃٌ فِی سَفَرِہِمْ ، وَلاَ وَیَوْمَ نَفْرِہِمْ۔","","Musannaf Ibn Abi Shaybah 14139","","","كتاب الحج"
"14140","(۱۴۱۴۰) حدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، فِی الرَّجُلِ یَقْطَعُ مِنْ شَجَرِ الْحَرَمِ ، قَالَ : فِی الْقَضِیبِ دِرْہَمٌ ، وَفِی الدَّوْحَۃِ بَقَرَۃ۔","","Musannaf Ibn Abi Shaybah 14140","","","كتاب الحج"
"14141","(۱۴۱۴۱) حدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنْ إسْمَاعِیلَ بْنِ مُسْلِمٍ ، عَنِ الْحَارِثِ ، وَحَمَّادٍ ؛ قَالاَ : فِی الَّذِی یَعْضُدُ مِنْ شَجَرِ الْحَرَمِ ، قَالاَ : عَلَیْہِ قِیمَتُہُ۔","","Musannaf Ibn Abi Shaybah 14141","","","كتاب الحج"
"14142","(۱۴۱۴۲) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : لاَ بَأْسَ بِالْغِنَائِ ، وَالْحُدَائِ ، وَالشِّعْرِ لِلْمُحْرِمِ مَا لَمْ یَکُنْ فُحْشًا۔","","Musannaf Ibn Abi Shaybah 14142","","","كتاب الحج"
"14143","(۱۴۱۴۳) حدَّثَنَا جَرِیرٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : کَانَ عُمَرُ یَأْمُرُ رَجُلاً فَیَحْدُو۔","Da'if","Musannaf Ibn Abi Shaybah 14143","","","كتاب الحج"
"14144","(۱۴۱۴۴) حدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ الْقَاسِمِ ، قَالَ : سَمِعْتُ الْحَسَنَ وَسُئِلَ عَنِ الْحُدَائِ ؟ قَالَ : کَانَ الْمُسْلِمُونَ یَفْعَلُونَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14144","","","كتاب الحج"
"14145","(۱۴۱۴۵) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، قَالَ : کَانَ سُوَیْد بْنُ غَفَلَۃَ یَأْمُرُ غُلاَمًا لَہُ فَیَحْدُو لَنَا۔","","Musannaf Ibn Abi Shaybah 14145","","","كتاب الحج"
"14146","(۱۴۱۴۶) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ حَسَنِ بْنِ أَبِی جَعْفَرٍ ، عَنْ یَزِیدَ الأَعْرَجِ ، قَالَ : سَمِعْتُ مُوَرِّقاً یَحْدُو فِی طَرِیقِ مَکَّۃَ وَہُوَ یَقُولُ : لَوْ تَکَلَّمْنَ لاَشْتَکَیْنَ رَاشِدًا۔","","Musannaf Ibn Abi Shaybah 14146","","","كتاب الحج"
"14147","(۱۴۱۴۷) حدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدِ ، عْن زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِیہِ ، قَالَ : سَمِعَ عُمَرُ بْنُ الْخَطَّابِ رَجُلاً بِفَلاَۃٍ مِنَ الأَرْضِ وَہُوَ یَحْدُو بِغِنَائِ الرُّکْبَانِ ، فَقَالَ عُمَرُ : إنَّ ہَذَا مِنْ زَادِ الرَّاکِبِ۔","Da'if","Musannaf Ibn Abi Shaybah 14147","","","كتاب الحج"
"14148","(۱۴۱۴۸) حدَّثَنَا عَبَّادُ بْنُ عَوَّامِ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَقِیَ قَوْمًا فِیہِمْ حَادٍ یَحْدُو ، فَلَمَّا رَأَوُا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَکَتَ حَادِیہُمْ ، فَقَالَ : مَنِ الْقَوْمُ ؟ فَقَالُوا : مِنْ مُضَرَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : وَأَنا مِنْ مُضَرَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا شَأْنُ حَادِیکُمْ لاَ یَحْدُو ؟ فَقَالُوا : یَا رَسُولَ اللہِ ، إنَّا أَوَّلُ الْعَرَبِ حُدَائً ، قَالَ : وَمِمَّ ذَلِکَ ؟ قَالُوا : إنَّ رَجُلاً مِنَّا وَسَمَّوْہُ لَہُ ، عزَبَ عَنْ إبِلِہِ فِی أَیَّامِ الرَّبِیعِ ، فَبَعَثَ غُلاَمًا لَہُ مَعَ الإِبِلِ ، قَالَ : فَأَبْطَأَ الْغُلاَمُ ، فَضَرَبَہُ بِعَصًا عَلَی یَدِہِ ، وَانْطَلَقَ الْغُلاَمُ وَہُوَ یَقُولُ : یَا یَدَاہُ ، یَا یَدَاہُ ، قَالَ : فَتَحَرَّکَتِ الإِبِلُ لِذَلِکَ وَنَشِطَتْ ، قَالَ : فَقَالَ لَہُ : أَمْسِکْ ، أَمْسِکْ ، قَالَ : فَافْتَتَحَ النَّاسُ الْحُدَائَ۔ (بیہقی ۲۲۸۔ بزار ۲۱۱۳)","","Musannaf Ibn Abi Shaybah 14148","","","كتاب الحج"
"14149","(۱۴۱۴۹) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ تَسْتَلِمِ الْحَجَرَ عَنْ یَمِینِہِ ، وَلاَ عَنْ شِمَالِہِ ، وَلَکِنِ اسْتَقْبِلْہُ اسْتِقْبَالاً۔","No Data Available","Musannaf Ibn Abi Shaybah 14149","","","كتاب الحج"
"14150","(۱۴۱۵۰) حدَّثَنَا وَکِیعٌ ، عَنْ ربَاحِ بْنِ أَبِی مَعْرُوفٍ ، قَالَ : حدَّثَنِی مَنْ رَأَی مُجَاہِدًا یَدُورُ حَتَّی یَسْتَقْبِلَ الْحَجَرَ مِنْ وَجْہِہِ۔","","Musannaf Ibn Abi Shaybah 14150","","","كتاب الحج"
"14151","(۱۴۱۵۱) حدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی عَمَّارٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : جَعَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الضَّبُعِ کَبْشًا یُصِیبُہُ الْمُحْرِمُ ، وَجَعَلَہُ مِنَ الصَّیْدِ۔ (ابوداؤد ۳۷۹۵۔ ترمذی ۸۵۱)","Sahih","Musannaf Ibn Abi Shaybah 14151","","","كتاب الحج"
"14152","(۱۴۱۵۲) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : قتَلَ رَجُلٌ ضَبُعًا وَہُوَ مُحْرِمٌ ، فَأَتَی عَلِیًّا فَسَأَلَہُ ؟ فَجَعَلَ فِیہِ کَبْشًا۔","","Musannaf Ibn Abi Shaybah 14152","","","كتاب الحج"
"14153","(۱۴۱۵۳) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَلِیٍّ ؛فِی الضَّبُعِ إذَا عَدَا عَلَی الْمُحْرِمِ فَلیَقْتُلْہُ ، فَإِنْ قَتَلَہُ مِنْ غَیْرِ أَنْ یَعْدُوَ عَلَیْہِ ، فَفِیہِ شَاۃٌ مُسِنَّۃٌ۔","","Musannaf Ibn Abi Shaybah 14153","","","كتاب الحج"
"14154","(۱۴۱۵۴) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنِ أَبِی الزبیر ، عَنْ جَابِرِ ، عَنْ عُمَرَ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 14154","","","كتاب الحج"
"14155","(۱۴۱۵۵) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَلِیٍّ ؛ فِی الضَّبُعِ إذَا لَمْ یَعْدُ کَبْشٌ، وَقَالَ عَطَائٌ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 14155","","","كتاب الحج"
"14156","(۱۴۱۵۶) حدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنْ سِمَاکٍ، عَنْ عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ؛ أَنَّ مَرْوَانَ سَأَلَہُ؟ فَقَالَ: فِیہِ کَبْشٌ۔","","Musannaf Ibn Abi Shaybah 14156","","","كتاب الحج"
"14157","(۱۴۱۵۷) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ فِی شَیْئٍ مِنَ الْجِمَارِ دَمٌ ، إِلاَّ فِی جَمْرَۃِ الْعَقَبَۃِ ، إِنْ قَدَّمَ شَیْئًا قَبْلَہَا ، ہِیَ قَبْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14157","","","كتاب الحج"
"14158","(۱۴۱۵۸) حدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَرْمِی جَمْرَۃً قَبْلَ الأُخْرَی الَّتِی یَنْبَغِی أَنْ یَبْدَأَ بِہَا ، قَالَ : لَیْسَ عَلَیْہِ شَیْئٌ فِیہَا۔","","Musannaf Ibn Abi Shaybah 14158","","","كتاب الحج"
"14159","(۱۴۱۵۹) حدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ یَزِیدَ، عَنْ مُجَاہِدٍ، عَنِ ابْنِ عَبَّاسٍ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَخَّصَ فِی الإِذْخِرِ۔","Da'if","Musannaf Ibn Abi Shaybah 14159","","","كتاب الحج"
"14160","(۱۴۱۶۰) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ بِمَا سَقَطَ مِنْ شَجَرِ الْحَرَمِ أَنْ یُلْتَقَطَ۔","","Musannaf Ibn Abi Shaybah 14160","","","كتاب الحج"
"14161","(۱۴۱۶۱) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، وَابْنِ الأَسْوَدِ ؛ قَالاَ : لاَ بَأْسَ بِمَا سَقَطَ مِنْ شَجَرِ الْحَرَمِ۔","","Musannaf Ibn Abi Shaybah 14161","","","كتاب الحج"
"14162","(۱۴۱۶۲) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَتَی عَرَفَاتٍ حَتی إذَا زَاغَتِ الشَّمْسُ أَمَرَ بِالْقَصْوَائِ فَرُحِلَتْ لَہُ ، فَأَتَی بَطْنَ الْوَادِی فَخَطَبَ النَّاسَ۔","Sahih","Musannaf Ibn Abi Shaybah 14162","","","كتاب الحج"
"14163","(۱۴۱۶۳) حدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أُخْبِرْتُ عَنْ مُحَمَّدِ بْنِ قَیْسِ بْنِ الْمُطَّلِبِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَ بِعَرَفَۃَ۔ (طبرانی ۲۸)","Da'if","Musannaf Ibn Abi Shaybah 14163","","","كتاب الحج"
"14164","(۱۴۱۶۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَخْطُبُ یَوْمَ النَّحْرِ ، فَشُغِلَت الأُمَرَائُ فَأَخَّرُوہُ إلَی الْغَدِ۔","","Musannaf Ibn Abi Shaybah 14164","","","كتاب الحج"
"14165","(۱۴۱۶۵) حدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ طَارِقٍ ، عَنْ مُجَاہِدٍ ، قَالَ : خَطَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ النَّحْرِ النَّاسَ بَیْنَ الْجَمْرَتَیْنِ أَیَّامَ التَّشْرِیقِ۔","","Musannaf Ibn Abi Shaybah 14165","","","كتاب الحج"
"14166","(۱۴۱۶۶) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ خَطَبَہُمْ قَبْلَ التَّرْوِیَۃِ بِیَوْمٍ ضُحًی ، وَأَنَّ ابْنَ الزُّبَیْرِ کَانَ یَخْطُبُ الْعَشْرَ کُلَّہَا۔","","Musannaf Ibn Abi Shaybah 14166","","","كتاب الحج"
"14167","(۱۴۱۶۷) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عِجْلاَنَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : رَأَیْتُ أَبِی صَعِدَ إلَی ابْنِ الزُّبَیْرِ بِعَرَفَۃَ وَہُوَ عَلَی الْمِنْبَرِ ، فَلَمَّا نَزَلَ لَبَّی ابْنُ الزُّبَیْرِ ، فَقُلْتُ لأَبِی : مَا قُلْتَ لَہُ ؟ قَالَ : قُلْتُ لَہُ : سَمِعْت عُمَرَ یُلَبِّی ہَاہُنَا عَلَی الْمِنْبَرِ۔","Hasan","Musannaf Ibn Abi Shaybah 14167","","","كتاب الحج"
"14168","(۱۴۱۶۸) حدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، قَالَ : خَطَبَہُمُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ النَّحْرِ۔","","Musannaf Ibn Abi Shaybah 14168","","","كتاب الحج"
"14169","حدَّثَنَا أَبُو مُحَمَّدٍ عَبْدُ اللہِ بْنُ یُونُسَ ، قَالَ : حدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا أَبُو بَکْرٍ عَبْدُ اللہِ بْنُ مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ ، قَالَ :n(۱۴۱۶۹) حدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَنْ عَلِیِّ بْنِ زَیْدِ بْنِ جُدْعَانَ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : حَجَجْتُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلَمْ یُصَلِّ إِلاَّ رَکْعَتَیْنِ حَتَّی رَجَعَ إلَی الْمَدِینَۃِ ، وَحَجَجْتُ مَعَ أَبِی بَکْرٍ فَلَمْ یُصَلِّ إِلاَّ رَکْعَتَیْنِ حَتَّی رَجَعَ إلَی الْمَدِینَۃِ ، وَحَجَجْتُ مَعَ عُمَرَ حَجَّاتٍ ، فَلَمْ یُصَلِّ إِلاَّ رَکْعَتَیْنِ حَتَّی رَجَعَ إلَی الْمَدِینَۃِ ، وَحَجَّ عُثْمَانُ سَبْعَ سِنِینَ مِنْ إمَارَتِہِ لاَ یُصَلِّی إِلاَّ رَکْعَتَیْنِ ، ثُمَّ صَلاَّہَا بِمِنًی أَرْبَعًا۔","Da'if","Musannaf Ibn Abi Shaybah 14169","","","كتاب الحج"
"14170","(۱۴۱۷۰) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَکْعَتَیْن ، وَأَبُو بَکْرٍ بَعْدَہُ ، وَعُمَرُ بَعْدَ أَبِی بَکْرٍ ، وَعُثْمَانُ صَدْرًا مِنْ خِلاَفَتِہِ ، ثُمَّ إِنَّ عُثْمَانَ صَلَّی بَعْدُ أَرْبَعًا ، فَکَانَ ابْنُ عُمَرَ إذَا صَلَّی مَعَ الإِمَامِ صَلَّی أَرْبَعًا ، وَإِذَا صَلاَہَا وَحْدَہُ صَلاَہَا رَکْعَتَیْنِ۔n(بخاری ۱۰۸۲۔ مسلم ۱۷)","Sahih","Musannaf Ibn Abi Shaybah 14170","","","كتاب الحج"
"14171","(۱۴۱۷۱) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : أَخْبَرَنِی حَارِثَۃُ بْنُ وَہْبٍ ، قَالَ : صَلَّیْتُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِنًی أَکْثَرَ مَا کَانَ النَّاسُ ، وَآمنہ رَکْعَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 14171","","","كتاب الحج"
"14172","(۱۴۱۷۲) حدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنْ بُکَیْرِ بْنِ الأَشَجِّ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ بْنِ أَبِی سُلَیْمٍ، عَنْ أَنَسٍ ، قَالَ : صَلَّیْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِنًی رَکْعَتَیْنِ ، وَمَعَ أَبِی بَکْرٍ ، وَمَعَ عُمَرَ ، وَمَعَ عُثْمَانَ صَدْرًا مِنْ إمَارَتِہِ۔ (احمد ۳/۱۴۴۔ ابویعلی ۴۲۵۵)","Hasan","Musannaf Ibn Abi Shaybah 14172","","","كتاب الحج"
"14173","(۱۴۱۷۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ ، قَالَ : صَلَّیْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِنًی رَکْعَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 14173","","","كتاب الحج"
"14174","(۱۴۱۷۴) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : صَلَّی عُثْمَانَ بِمِنًی أَرْبَعَ رَکَعَاتٍ ، فَقَالَ عَبْدُ اللہِ : صَلَّیْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِنًی رَکْعَتَیْنِ ، وَمَعَ أَبِی بَکْرٍ رَکْعَتَیْنِ ، وَمَعَ عُمَرَ رَکْعَتَیْنِ ، ثُمَّ تَفَرَّقَتْ بِکُمَ الطُّرُقُ ، وَلَوَدِدْتُ أَنَّ لِی مِنْ أَرْبَعِ رَکَعَاتٍ رَکْعَتَیْنِ مُتَقَبَّلَتَیْنِ ۔ قَالَ الأَعْمَش : فَحَدَّثَنِی مُعَاوِیَۃُ بْنُ قُرَّۃَ ، أَنَّ عَبْدَ اللہِ صَلَّی بَعْدُ أَرْبَعًا ، فَقِیلَ لَہُ : عِبْتَ عَلَی عُثْمَانَ ، ثُمَّ تُصَلِی أَرْبَعًا ، قَالَ : فَقَالَ عَبْدُ اللہِ : الْخِلاَفُ شَرّ۔","Sahih","Musannaf Ibn Abi Shaybah 14174","","","كتاب الحج"
"14175","(۱۴۱۷۵) حدَّثَنَا جَرِیرٌ ، وَہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، قَالَ : صَحِبَنَا رَجُلٌ مِنْ أَہْلِ الْیَمَامَۃِ ، فَحدَّثَنَا ؛أَنَّہُ رَأَی ابْنَ عُمَرَ صَلَّی خَلْفَ ابْنِ الزُّبَیْرِ بِمِنًی رَکْعَتَیْنِ ، قَالَ : وَرَأَیْتُہُ صَلَّی خَلْفَ الْحَجَّاجِ أَرْبَعًا۔","Da'if","Musannaf Ibn Abi Shaybah 14175","","","كتاب الحج"
"14176","(۱۴۱۷۶) حدَّثَنَا وَکِیعٌ ، عَنْ حَنْظَلَۃَ ، عَنِ الْقَاسِمِ ، وَسَالِمٍ ، وَطَاوُوسٍ ؛ قَالُوا : اقصُر بِمِنًی۔","","Musannaf Ibn Abi Shaybah 14176","","","كتاب الحج"
"14177","(۱۴۱۷۷) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : الصَّلَوَاتُ بِمِنًی رَکْعَتَانِ ، أَیَّامَ التَّشْرِیقِ۔","","Musannaf Ibn Abi Shaybah 14177","","","كتاب الحج"
"14178","(۱۴۱۷۸) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ خُصَیْفٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ ، قَالَ الْفَضْلُ بْنُ عَبَّاسٍ : کُنْتُ رِدْفَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَمَا زِلْتُ أَسْمَعُہُ یُلَبِّی حَتَّی رَمَی جَمْرَۃَ الْعَقَبَۃِ ، فَلَمَّا رَمَاہَا قَطَعَ۔n(بخاری ۱۶۸۵۔ مسلم ۲۶۶)","Da'if","Musannaf Ibn Abi Shaybah 14178","","","كتاب الحج"
"14179","(۱۴۱۷۹) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ : حدَّثَنِی أَبَانُ بْنُ صَالِحٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : دَفَعْتُ مَعَ حُسَیْنٍ بْنِ عَلِیِّ مِنَ الْمُزْدَلِفَۃِ ، فَلَمْ أَزَلْ أَسْمَعُہُ یُلَبِّی یَقُولُ : لَبَّیْکَ حَتَّی انْتَہَی إلَی الْجَمْرَۃِ ، فَقُلْتُ لَہُ : مَا ہَذَا الإِہْلاَلُ ، یَا أَبَا عَبْدِ اللہِ ؟ ، قَالَ : سَمِعْتُ أَبِی عَلِیَّ بْنَ أَبِی طَالِبٍ یُہِلُّ حَتَّی انْتَہَی إلَی الْجَمْرَۃِ ، وَحَدَّثَنِی : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَہَلَّ حَتَّی انْتَہَی إلَیْہَا۔ (احمد ۱/۱۱۴۔ بزار ۵۰۰)","Hasan","Musannaf Ibn Abi Shaybah 14179","","","كتاب الحج"
"14180","(۱۴۱۸۰) حدَّثَنَا صَفْوَانُ بْنُ عِیسَی ، عَنِ الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی ذُبَابٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ سَخْبَرَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : خَرجْتُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَمَا تَرَکَ التَّلْبِیَۃَ حَتَّی أَتَی الْعَقَبَۃَ إِلاَّ أَنْ یَخْلِطَہَا بِتَکْبِیرٍ ، أَوْ تَہْلِیلٍ۔ (احمد ۱/۴۱۷۔ ابن خزیمۃ ۲۸۰۶)","Hasan","Musannaf Ibn Abi Shaybah 14180","","","كتاب الحج"
"14181","(۱۴۱۸۱) حدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیِّ بْنِ حُسَیْنٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ الْفَضْلِ بْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمْ یَزَلْ یُلَبِّی حَتَّی رَمَی جَمْرَۃَ الْعَقَبَۃِ ، فَرَمَاہَا بِسَبْعِ حَصَیَاتٍ ، یُکَبِّرُ مَعَ کُلِّ حَصَاۃٍ۔ (ابن خزیمۃ ۲۸۸۷۔ طبرانی ۶۷۲)","Sahih","Musannaf Ibn Abi Shaybah 14181","","","كتاب الحج"
"14182","(۱۴۱۸۲) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَبَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی رَمَی جَمْرَۃَ الْعَقَبَۃِ۔ (طبرانی ۱۰۹۹۰)","Da'if","Musannaf Ibn Abi Shaybah 14182","","","كتاب الحج"
"14183","(۱۴۱۸۳) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : حجَجْتُ مَعَ عُمَرَ سَنَتَیْنِ ، إحْدَاہُمَا فِی السَّنَۃِ الَّتِی أُصِیبَ فِیہَا ، کُلُّ ذَلِکَ یُلَبِّی حَتَّی رَمَی جَمْرَۃَ الْعَقَبَۃِ مِنْ بَطْنِ الْوَادِی۔","Sahih","Musannaf Ibn Abi Shaybah 14183","","","كتاب الحج"
"14184","(۱۴۱۸۴) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِلاَلِ بْنِ خَبَّابِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ عُمَرَ لَبَّی حَتَّی رَمَی الْعَقَبَۃَ ، وَأَنَّ ابْنَ عَبَّاسٍ کَانَ یُلَبِّی حَتَّی یَرْمِیَ جَمْرَۃَ الْعَقَبَۃِ ، وَقَالَ : إنَّمَا نَفْتَتِح الْحِلَّ الآنَ۔","Sahih","Musannaf Ibn Abi Shaybah 14184","","","كتاب الحج"
"14185","(۱۴۱۸۵) حدَّثَنَا شَرِیکٌ ، عَنْ عَامِرِ بْنِ شَقِیقٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ لَبَّی حَتَّی رَمَی جَمْرَۃَ الْعَقَبَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 14185","","","كتاب الحج"
"14186","(۱۴۱۸۶) حدَّثَنَا حَفْصٌ ، وَوَکِیعٌ ، وَمَرْوَانُ بْنُ مُعَاوِیَۃَ ، وَعَلِیُّ بْنُ ہَاشِمٍ ، عَنْ مُحَمَّدِ بْنِ شَرِیکٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَ عَلِیٌّ یُلَبِّی ، یَقْطَعُ التَّلْبِیَۃَ إذَا رَمَی جَمْرَۃَ الْعَقَبَۃِ۔","","Musannaf Ibn Abi Shaybah 14186","","","كتاب الحج"
"14187","(۱۴۱۸۷) حدَّثَنَا ابْنِ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ اللہِ ، أِنَّہُ کَانَ لاَ یَتْرُکُ التَّلْبِیَۃَ حَتَّی یَرْمِیَ جَمْرَۃَ الْعَقَبَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 14187","","","كتاب الحج"
"14188","(۱۴۱۸۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ الْحَسَنِ ، عَنْ عِکْرِمَۃَ ؛ قَالَ : أَرْسَلَنِی ابْنُ عَبَّاسٍ مَعَ حُسَیْنِ بْنِ عَلِیٍّ ، فَلَبَّی حَتَّی رَمَی جَمْرَۃَ الْعَقَبَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 14188","","","كتاب الحج"
"14189","(۱۴۱۸۹) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، قَالَ : قَالَ سَعِیدُ بْنُ الْمُسَیَّبِ : الإِہْلاَلُ فِی الْحَجِّ حَتَّی تَرُوحَ إلَی الْمَوْقِفِ عَشِیَّۃَ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 14189","","","كتاب الحج"
"14190","(۱۴۱۹۰) حدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، قَالَ : رَأَیْتُ الْقَاسِمَ یَقْطَعُ التَّلْبِیَۃَ إذَا رَاحَ إلَی الْمَوْقِفِ ، قَالَ : وَکَانَتْ عَائِشَۃُ تَفْعَلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 14190","","","كتاب الحج"
"14191","(۱۴۱۹۱) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ لاَ یَقْطَعُ التَّلْبِیَۃَ فِی الْحَجِّ ، حَتَّی یَرُوحَ إلَی عَرَفَاتٍ۔","","Musannaf Ibn Abi Shaybah 14191","","","كتاب الحج"
"14192","(۱۴۱۹۲) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ ابْنُ عُمَرَ یُمْسِکُ عَنِ التَّلْبِیَۃِ فِی الْحَجِّ إذَا دَخَلَ الْحَرَمَ ، فَإِذَا طَافَ بِالْبَیْتِ لَبَّی۔","Da'if","Musannaf Ibn Abi Shaybah 14192","","","كتاب الحج"
"14193","(۱۴۱۹۳) حدَّثَنَا غُنْدَرٌ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ،وَالأَسْوَدِ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ لاَ یَقْطَعُ التَّلْبِیَۃَ حَتَّی یَرْمِیَ جَمْرَۃَ الْعَقَبَۃِ فِی أَوَّلِ حَصَاۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 14193","","","كتاب الحج"
"14194","(۱۴۱۹۴) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ : سَأَلَ أَبِی عِکْرِمَۃَ وَأَنَا أَسْمَعُ عَنِ الإِہْلاَلِ مَتَی یَنْقَطِعُ ؟ فَسَمِعْتُہُ یَقُولُ : أَہَلَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی رَمَی الْجَمْرَۃَ ، وَأَبُو بَکْرٍ ، وَعُمَرُ۔","","Musannaf Ibn Abi Shaybah 14194","","","كتاب الحج"
"14195","(۱۴۱۹۵) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنِ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عَامِرِ بْنِ شَقِیقٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ لَبَّی حَتَّی رَمَی جَمْرَۃَ الْعَقَبَۃِ ، وَقَطَعَ بِأَوَّلِ حَصَاۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 14195","","","كتاب الحج"
"14196","(۱۴۱۹۶) حدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، رَفَعَہُ ؛ أَنَّہُ کَانَ یُمْسِکُ عَنِ التَّلْبِیَۃِ فِی الْعُمْرَۃِ إذَا اسْتَلَمَ الْحَجَرَ۔ (ابوداؤد ۱۸۱۳۔ ترمذی ۹۱۹)","Da'if","Musannaf Ibn Abi Shaybah 14196","","","كتاب الحج"
"14197","(۱۴۱۹۷) حدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَسَنٌ وَزُہَیْرٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَبَّی فِی الْعُمْرَۃِ حَتَّی اسْتَلَمَ الْحَجَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 14197","","","كتاب الحج"
"14198","(۱۴۱۹۸) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : اعْتَمَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَلاَثَ عُمَرَ ، کُلَّ ذَلِکَ لاَ یَقْطَعُ التَّلْبِیَۃَ حَتَّی یَسْتَلِمَ الْحَجَرَ۔ (احمد ۲/۱۸۰)","","Musannaf Ibn Abi Shaybah 14198","","","كتاب الحج"
"14199","(۱۴۱۹۹) حدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ قَالَ : الْمُعْتَمِرُ یُمْسِکُ عَنِ التَّلْبِیَۃِ إذَا اسْتَلَمَ الْحَجَرَ ، وَالْحَاجُّ إذَا رَمَی الْجَمْرَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 14199","","","كتاب الحج"
"14200","(۱۴۲۰۰) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، وَعَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ یُلَبِّی فِی الْعُمْرَۃِ حَتَّی یَسْتَلِمَ الْحَجَرَ ، وَکَانَ ابْنُ عُمَرَ یَقْطَعُ إذَا دَخَلَ الْحَرَمَ۔","Sahih","Musannaf Ibn Abi Shaybah 14200","","","كتاب الحج"
"14201","(۱۴۲۰۱) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : حتَّی یَسْتَلِمَ الْحَجَرَ ۔ وَقَالَ عَطَائٌ : یَقْطَعُ إذَا دَخَلَ الْقَرْیَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 14201","","","كتاب الحج"
"14202","(۱۴۲۰۲) حدَّثَنَا غُنْدَرٌ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، وَمُجَاہِدٍ؛ أَنَّہُمَا کَانَا إذَا أَہَلاَّ بِعُمْرَۃٍ لَمْ یُمْسِکَا عَنِ التَّلْبِیَۃِ حَتَّی یَسْتَلِمَا الْحَجَرَ۔","","Musannaf Ibn Abi Shaybah 14202","","","كتاب الحج"
"14203","(۱۴۲۰۳) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَبْدُ الْحَمِیدِ بْنُ جُبَیْرِ بْنِ شَیْبَۃَ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، وَأَبَانَ بْنَ عُثْمَانَ یُلَبِّیَانِ بِذِی طُوَی فِی الْعُمْرَۃِ۔","","Musannaf Ibn Abi Shaybah 14203","","","كتاب الحج"
"14204","(۱۴۲۰۴) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَقْطَعُ إذَا دَخَلَ الْحَرَمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14204","","","كتاب الحج"
"14205","(۱۴۲۰۵) حدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : یَقْطَعُ إذَا رَأَی عُرُوشَ مَکَّۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14205","","","كتاب الحج"
"14206","(۱۴۲۰۶) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ یَقْطَعَ الْمُعْتَمِرُ حَتَّی یَسْتَلِمَ الْحَجَرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14206","","","كتاب الحج"
"14207","(۱۴۲۰۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ ابْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 14207","","","كتاب الحج"
"14208","(۱۴۲۰۸) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ یَقْطَعُ التَّلْبِیَۃَ فِی الْعُمْرَۃِ إذَا دَخَلَ الْحَرَمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14208","","","كتاب الحج"
"14209","(۱۴۲۰۹) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، قَالَ : قَالَ سَعِیدُ بْنُ الْمُسَیَّبِ : الإِہْلاَلُ فِی الْعُمْرَۃِ حَتَّی یَنْظُرَ إلَی عُرُوشِ مَکَّۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14209","","","كتاب الحج"
"14210","(۱۴۲۱۰) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : یَقْطَعُ إذَا رَأَی بُیُوتَ مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 14210","","","كتاب الحج"
"14211","(۱۴۲۱۱) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ یُلَبُّونَ فِی الْعُمْرَۃِ حَتَّی یَسْتَلِمُوا الْحَجَرَ۔","","Musannaf Ibn Abi Shaybah 14211","","","كتاب الحج"
"14212","(۱۴۲۱۲) حدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : یَقْطَعُ فِی الْعُمْرَۃِ إذَا اسْتَلَمَ الْحَجَرَ۔","","Musannaf Ibn Abi Shaybah 14212","","","كتاب الحج"
"14213","(۱۴۲۱۳) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ أَبِیہِ ، قَالَ : أَفَضْتُ مَعَ عَبْدِ اللہِ ، فَرَمَی سَبْعَ حَصَیَاتٍ یُکَبِّرُ مَعَ کُلِّ حَصَاۃٍ ، وَاسْتَبْطَنَ الْوَادِیَ حَتَّی إذَا فَرَغَ ، قَالَ : اللَّہُمَّ اجْعَلْہُ حَجًّا مَبْرُورًا وَذَنْبًا مَغْفُورًا ۔ ثُمَّ قَالَ : ہَکَذَا رَأَیْتُ الَّذِی أُنْزِلَ عَلَیْہِ سُورَۃُ الْبَقَرَۃِ صَنَعَ۔(بیہقی ۱۲۹۔ احمد ۱/۴۲۷)","Da'if","Musannaf Ibn Abi Shaybah 14213","","","كتاب الحج"
"14214","(۱۴۲۱۴) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْہَیْثُمِ بْنِ حَنَشٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ حِینَ رَمَی الْجِمَارَ یَقُولُ : اللَّہُمَّ اجْعَلْہُ حَجًّا مَبْرُورًا وَذَنْبًا مَغْفُورًا۔","Da'if","Musannaf Ibn Abi Shaybah 14214","","","كتاب الحج"
"14215","(۱۴۲۱۵) حدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ قَالَ : لَیْسَ عَلَی الْوُقُوفِ عِنْدَ الْجَمْرَتَیْنِ دُعَائٌ مُوَقَّتٌ ، فَادْعُ بِمَا شِئْتَ۔","","Musannaf Ibn Abi Shaybah 14215","","","كتاب الحج"
"14216","(۱۴۲۱۶) حدَّثَنَا ابْنُ أَبِی عَدِیٍّ، عَنْ أَشْعَثَ، قَالَ: کَانَ الْحَسَنُ یَقُولُ: یَدْعُو عِنْدَ الْجِمَارِ کُلِّہَا ، وَلاَ یُوَقِّتُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 14216","","","كتاب الحج"
"14217","(۱۴۲۱۷) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَہُ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : مَا أَقُولُ إذَا رَمَیْتُ الْجَمْرَۃَ ؟ قَالَ : قُلْ : اللَّہُمَّ اجْعَلْہُ حَجًّا مَبْرُورًا وَذَنْبًا مَغْفُورًا ، قَالَ : قُلْتُ : أَقُولُہُ مَعَ کُلِّ حَصَاۃٍ ؟ قَالَ : نَعَمْ إِنْ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 14217","","","كتاب الحج"
"14218","(۱۴۲۱۸) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : فِی الْجَمْرَۃِ شَیْئٌ مُوَقَّتٌ لاَ یُزَادُ عَلَیْہِ ؟ قَالَ : لاَ ، إِلاَّ قَوْلُ جَابِرٍ۔","Hasan","Musannaf Ibn Abi Shaybah 14218","","","كتاب الحج"
"14219","(۱۴۲۱۹) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ ، وَحَبِیبَ بْنَ أَبِی ثَابِتٍ ، وَرَجُلاً مِنْ قُرَیْشٍ بَعْدَ مَا أَفَاضَ الإِمَامُ عَشِیَّۃَ عَرَفَۃَ ، فَقَامَ سَعِیدُ بْنُ جُبَیْرٍ فَأَذَّنَ ، وَأَمَّ الْقُرَشِیَّ بَعْدَ مَا أَفَاضَ الإِمَامُ۔","","Musannaf Ibn Abi Shaybah 14219","","","كتاب الحج"
"14220","(۱۴۲۲۰) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی شَرْقِیٍّ ، عَنْ أَبِی عُثْمَانَ النَّہْدِیِّ ؛ أَنَّہُ صَلَّی مَعَ عُمَرَ سَنَتَیْنِ الْمَغْرِبَ دُونَ جَمْعٍ۔","Da'if","Musannaf Ibn Abi Shaybah 14220","","","كتاب الحج"
"14221","(۱۴۲۲۱) حدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ صَلَّی دُونَ جَمْعٍ بِالأَجْبَالِ۔","Sahih","Musannaf Ibn Abi Shaybah 14221","","","كتاب الحج"
"14222","(۱۴۲۲۲) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؟ قَالَ : لاَ صَلاَۃَ إِلاَّ بِجَمْعٍ۔","","Musannaf Ibn Abi Shaybah 14222","","","كتاب الحج"
"14223","(۱۴۲۲۳) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ خَالِدِ بْنِ أَبِی عُثْمَانَ ، قَالَ : رَأَیْتُ أَبَانَ بْنَ عُثْمَانَ صَلَّی الْمَغْرِبَ فِی الشِّعْبِ قَبْلَ أَنْ یَأْتِیَ جَمْعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 14223","","","كتاب الحج"
"14224","(۱۴۲۲۴) حدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ؟ قَالَ : لاَ أَعْلَمُ الصَّلاَۃَ لَیْلَۃَ جَمْعٍ إِلاَّ بِجَمْعٍ۔","","Musannaf Ibn Abi Shaybah 14224","","","كتاب الحج"
"14225","(۱۴۲۲۵) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنِ السَّکَنِ بْنِ الْمُغِیرَۃِ ، قَالَ : صَلَّی بِنَا سَالِمٌ الْمَغْرِبَ قَبْلَ أَنْ یَأْتِیَ جَمْعًا۔","","Musannaf Ibn Abi Shaybah 14225","","","كتاب الحج"
"14226","(۱۴۲۲۶) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ تُصَلَّی الْمَغْرِبُ إِلاَّ بِجَمْعٍ ، إِلاَّ أَنْ تُخْطِئَ طَرِیقًا ، أَوْ تُضِلَّ رَاحِلَتَک۔","","Musannaf Ibn Abi Shaybah 14226","","","كتاب الحج"
"14227","(۱۴۲۲۷) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : أَرَأَیْتَ إِنْ صَلاَّہُمَا بِالطَّرِیقِ ؟ قَالَ : لاَ بَأْسَ ، قُلْتُ : أَرَأَیْتَ إِنْ صَلَّی الْمَغْرِبَ فِی الطَّرِیقِ ، وَالْعِشَائَ بِجَمْعٍ ؟ قَالَ : لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 14227","","","كتاب الحج"
"14228","(۱۴۲۲۸) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : کَانَ عمَرُ بْنُ عَبْدِ الْعَزِیزِ وَاقِفًا بِعَرَفَۃَ ، فَقَالَ : أَیُّہَا النَّاسُ ، قَدْ جِئْتُمْ مِنَ الْقَرِیبِ وَالْبَعِیدِ ، وَإِنَّکُمْ وَفْدٌ غَیْرُ وَاحِدٍ ، وَإِنَّ السَّابِقَ لَیْسَ الَّذِی تَسْبِقُ دَابَّتُہُ ، وَلاَ بَعِیرُہُ ، وَإِنَّ السَّابِقَ مَنْ غَفَرَ اللَّہُ لَہُ ذَنْبَہُ ۔ فَنَادَاہُ رَجُلٌ : أَیْنَ أُصَلِّی الْمَغْرِبَ ؟ قَالَ : أَیْنَ أَدْرَکْتَ مِنْ وَادِیکَ ہَذَا۔","","Musannaf Ibn Abi Shaybah 14228","","","كتاب الحج"
"14229","(۱۴۲۲۹) حدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ إذَا أَفَاضَ مِنْ عَرَفَاتٍ رُبَّمَا صَلَّی فِی الشِّعْبِ الأَیْسَرِ عَلَی الْجَبَلِ۔","","Musannaf Ibn Abi Shaybah 14229","","","كتاب الحج"
"14230","(۱۴۲۳۰) حدَّثَنَا ابْنُ أَبِی عَدِیٍّ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ ، قَالَ: یُکْرَہُ أَنْ یُصَلِّیَ دُونَ جَمْعٍ ، فَإِنْ فَعَلَ أَجْزَأَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 14230","","","كتاب الحج"
"14231","(۱۴۲۳۱) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یَکْرَہُ الصَّلاَۃَ دُونَ الْمُزْدَلِفَۃِ ، إِلاَّ مِنْ ضَرُورَۃٍ۔","","Musannaf Ibn Abi Shaybah 14231","","","كتاب الحج"
"14232","(۱۴۲۳۲) حدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ إبْرَاہِیمَ بْنِ عُقْبَۃَ ، عَنْ کُرَیْبٍ ، قَالَ : أَخْبَرَنِی أُسَامَۃُ بْنُ زَیْدٍ ، قَالَ : أَفَضْتُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ عَرَفَاتٍ، فَلَمَّا کَانَ بِبَعْضِ الطَّرِیقِ قُلْتُ: الصَّلاَۃَ، فَقَالَ: الصَّلاَۃُ أَمَامَکَ۔n(بخاری ۱۳۹۔ ابوداؤد ۱۹۲۰)","Sahih","Musannaf Ibn Abi Shaybah 14232","","","كتاب الحج"
"14233","(۱۴۲۳۳) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عُمَرَ ؛ أَنَّہُ صَلاَّہُمَا بِجَمْعٍ۔","Sahih","Musannaf Ibn Abi Shaybah 14233","","","كتاب الحج"
"14234","(۱۴۲۳۴) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ أَبِی رَوَّادٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا فَاتَتْہُ الصَّلاَۃُ مَعَ الإِمَامِ بِعَرَفَۃَ، جَمَعَ بَیْنَ الظُّہْرِ وَالْعَصْرِ فِی رَحْلِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 14234","","","كتاب الحج"
"14235","(۱۴۲۳۵) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا صَلَّیْت فِی رَحْلِکَ بِعَرَفَۃَ ، فَصَلِّ کُلَّ وَاحِدَۃٍ مِنْہُمَا لِوَقْتِہَا ، وَاجْعَلْ لِکُلِّ وَاحِدَۃٍ مِنْہُمَا أَذَانًا وَإِقَامَۃً۔","","Musannaf Ibn Abi Shaybah 14235","","","كتاب الحج"
"14236","(۱۴۲۳۶) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا صَلَّیْتَ فِی رَحْلِکَ ، فَإِنْ شِئْتَ فَاجْمَعْ بَیْنَہُمَا ، وَإِنْ شِئْتَ فَصَلِّ کُلَّ وَاحِدَۃٍ مِنْہُمَا لِوَقْتِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 14236","","","كتاب الحج"
"14237","(۱۴۲۳۷) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : مَا صَلَّی أَبِی قَطُّ مَعَ الإِمَامِ بِعَرَفَۃَ، وَکَانَ یَجْمَعُ بَیْنَہُمَا ، وَکَانَ یَتَطَوَّعُ بَیْنَہُمَا ، وَکَانَ یَفْعَلُ ذَلِکَ مِنَ الْجَنَدِ حَتَّی یَأْتِیَ مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 14237","","","كتاب الحج"
"14238","(۱۴۲۳۸) حدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : تُصَلَّی کُلُّ صَلاَۃٍ لِوَقْتِہَا۔","","Musannaf Ibn Abi Shaybah 14238","","","كتاب الحج"
"14239","(۱۴۲۳۹) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنْ أَبِی أَیُّوبَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَمَعَ بَیْنَ الْمَغْرِبِ وَالْعِشَائِ بِالْمُزْدَلِفَۃِ۔ (احمد ۵/۴۱۸۔ دارمی ۱۸۸۳)","Sahih","Musannaf Ibn Abi Shaybah 14239","","","كتاب الحج"
"14240","(۱۴۲۴۰) حدَّثَنَا شَرِیکٌ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ جَمَعَ بَیْنَ الصَّلاَتَیْنِ بِجَمْعٍ ، ثُمَّ قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَلَہُ۔ (بخاری ۱۶۷۳۔ ابوداؤد ۱۹۲۱)","Hasan","Musannaf Ibn Abi Shaybah 14240","","","كتاب الحج"
"14241","(۱۴۲۴۱) حدَّثَنَا سَلاَّمُ أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنِ النُّعْمَانِ بْنِ حُمَیْدٍ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ الْخَطَّابِ جَمَعَ الْمَغْرِبَ وَالْعِشَائَ بِجَمْعٍ۔","Da'if","Musannaf Ibn Abi Shaybah 14241","","","كتاب الحج"
"14242","(۱۴۲۴۲) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ، وَأَبُو الأَحْوَص، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : صَلَّیْتُ مَعَ عَبْدِ اللہِ الْمَغْرِبَ بِجَمْعٍ ، بِأَذَانٍ وَإِقَامَۃٍ ، ثُمَّ أَتَیْنَا بِعَشَائٍ فَتَعَشَّیْنَا ، ثُمَّ صَلَّی بِنَا الْعِشَائَ بِأَذَانٍ وَإِقَامَۃٍ۔n زَادَ فِیہِ أَبُو بَکْرِ بْنُ عَیَّاشٍ : قَالَ أَبُو إِسْحَاقَ : فَلَقِیتُ أَبَا جَعْفَرٍ فَأَخْبَرْتُہُ ، فَقَالَ : وَکَذَلِکَ یَفْعَلُ أَہْلُ الْبَیْتِ۔","Sahih","Musannaf Ibn Abi Shaybah 14242","","","كتاب الحج"
"14243","(۱۴۲۴۳) حدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدِ ، قَالاَ : مِنَ السُّنَّۃِ أَنْ یُجْمَعَ بَیْنَہُمَا۔","Hasan","Musannaf Ibn Abi Shaybah 14243","","","كتاب الحج"
"14244","(۱۴۲۴۴) حدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ إذَا أَفَاضَ مِنْ عَرَفَاتٍ إنَّمَا یُصَلِّی فِی الشِّعْبِ الأَیْسَرِ ، وَعَلَی الْجَبَلِ ، وَأَنَّہُ کَانَ یَجْمَعُ بَیْنَ الْمَغْرِبِ وَالْعِشَائِ الآخِرَۃَ۔","","Musannaf Ibn Abi Shaybah 14244","","","كتاب الحج"
"14245","(۱۴۲۴۵) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حُسَیْنِ بْنِ عُقَیْلٍ ، عَنِ الضَّحَّاکِ ، قَالَ : یُجْمَعُ بَیْنَہُمَا بِجَمْعٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 14245","","","كتاب الحج"
"14246","(۱۴۲۴۶) حدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی جَعْفَرٍ ؛ أَنَّ عَلِیًّا جَمَعَ بَیْنَہُمَا بِجَمْعٍ۔","","Musannaf Ibn Abi Shaybah 14246","","","كتاب الحج"
"14247","(۱۴۲۴۷) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَغْرِبَ وَالْعِشَائَ بِأَذَانٍ وَاحِدٍ وَإِقَامَتَیْنِ ، وَلَمْ یُسَبِّحْ بَیْنَہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 14247","","","كتاب الحج"
"14248","(۱۴۲۴۸) حدَّثَنَا ابْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنْ أَبِی أَیُّوبَ ، قَالَ: صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْمُزْدَلِفَۃِ الْمَغْرِبَ وَالْعِشَائَ بِإِقَامَۃٍ۔n(طبرانی ۳۸۷۱۔ احمد ۵/۴۲۱)","Da'if","Musannaf Ibn Abi Shaybah 14248","","","كتاب الحج"
"14249","(۱۴۲۴۹) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : قَالَ سَعِیدُ بْنُ جُبَیْرٍ : أَفَضْنَا مَعَ ابْنِ عُمَرَ حَتَّی أَتَیْنَا جَمْعًا ، فَصَلَّی بِنَا الْمَغْرِبَ وَالْعِشَائَ بِإِقَامَۃٍ وَاحِدَۃٍ ، ثُمَّ انْصَرَفَ ، فَقَالَ : ہَکذَا صَلَّی بِنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ہَذَا الْمَکَانِ۔ (مسلم ۲۹۱۔ ابوداؤد ۱۹۲۶)","Sahih","Musannaf Ibn Abi Shaybah 14249","","","كتاب الحج"
"14250","(۱۴۲۵۰) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : صَلَّیْتُ مَعَہُ الْمَغْرِبَ وَالْعِشَائَ بِإِقَامَۃٍ وَاحِدَۃٍ ، وَقَالَ : فَعَلْتُہُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 14250","","","كتاب الحج"
"14251","(۱۴۲۵۱) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : اتَّفَقَ عَلِیٌّ ، وَعَبْدُ اللہِ أَنَّ کُلَّ صَلاَۃٍ تُجْمَعُ بِأَذَانٍ وَإِقَامَۃٍ۔","","Musannaf Ibn Abi Shaybah 14251","","","كتاب الحج"
"14252","(۱۴۲۵۲) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُحَمَّدِ بْن أَبِی إسْمَاعِیلَ ، قَالَ : صَلَّیْتُ بِجَمْعٍ مَعَ سَعِیدِ بْنِ جُبَیْرٍ الْمَغْرِبَ وَالْعِشَائَ بِإِقَامَۃٍ وَاحِدَۃٍ۔","","Musannaf Ibn Abi Shaybah 14252","","","كتاب الحج"
"14253","(۱۴۲۵۳) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ صَلَّی الصَّلاَتَیْنِ بِجَمْعٍ بِإِقَامَۃٍ وَاحِدَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 14253","","","كتاب الحج"
"14254","(۱۴۲۵۴) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ سِمَاک، عَنِ النُّعْمَان بْنِ حُمَیْدٍ؛ أَنَّ عُمَرَ صَلَّی الْمَغْرِبَ وَالْعِشَائَ بِإِقَامَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 14254","","","كتاب الحج"
"14255","(۱۴۲۵۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّ الأَسْوَدَ أَقَامَ الصَّلاَۃَ وَصَلَّی الْمَغْرِبَ بِالْمُزْدَلِفَۃِ ، ثُمَّ تَعَشَّی ، ثُمَّ صَلَّی الْعِشَائَ۔","","Musannaf Ibn Abi Shaybah 14255","","","كتاب الحج"
"14256","(۱۴۲۵۶) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْکَرِیمِ ، قَالَ : صَلَّیْتُ خَلْفَ سَالِمٍ الْمَغْرِبَ وَالْعِشَائَ بِجَمْعٍ ، بِأَذَانٍ وَاحِدٍ وَإِقَامَتَیْنِ ، فَلَقِیتُ نَافِعًا فَقُلْتُ لَہُ : ہَکَذَا کَانَ یَصْنَعُ عَبْدُ اللہِ ؟ قَالَ : ہَکَذَا ، فَلَقِیتُ عَطَائً فَقُلْتُ : قَدْ کُنْتُ أَقُولُ لَہُمْ لاَ صَلاَۃَ إِلاَّ بِإِقَامَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 14256","","","كتاب الحج"
"14257","(۱۴۲۵۷) حدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : عَلَیْہِ ہَدْیٌ آخَرُ۔","","Musannaf Ibn Abi Shaybah 14257","","","كتاب الحج"
"14258","(۱۴۲۵۸) حدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : عَلَیْہِ ہَدْیٌ آخَرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14258","","","كتاب الحج"
"14259","(۱۴۲۵۹) حدَّثَنَا ہُشَیْمٌ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 14259","","","كتاب الحج"
"14260","(۱۴۲۶۰) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذِرٍّ ، عَنْ مُجَاہِدٍ، قَالَ: إذَا حَلَقَ قَبْلَ أَنْ یَذْبَحَ ہَدْیَہُ، قَالَ: عَلَیْہِ ہَدْیٌ آخَرُ۔","","Musannaf Ibn Abi Shaybah 14260","","","كتاب الحج"
"14261","(۱۴۲۶۱) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : علَیْہِ دَمٌ ، قَالَ الأَعْمَشُ : فَذَکَرْتُ ذَلِکَ لإِبْرَاہِیمَ ، فَقَالَ : حَدَّثَنِی سَعِیدُ بْنُ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، بِمِثْلِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14261","","","كتاب الحج"
"14262","(۱۴۲۶۲) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَذْبَحُ شَاۃً ، أَوْ یُطْعِمُ سِتَّۃَ مَسَاکِینَ ، أَوْ یَصُومُ ثَلاَثَۃَ أَیَّامٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 14262","","","كتاب الحج"
"14263","(۱۴۲۶۳) حدَّثَنَا جَرِیرٌ ، عَنْ صَدَقَۃَ بْنِ یَسَارٍ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، قَالَ : وَقَّتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَہْلِ الْمَدِینَۃِ ذَا الْحُلَیْفَۃِ ، وَلأَہْلِ الشَّامِ الْجُحْفَۃَ ، وَلأَہْلِ الْیَمَنِ یَلَمْلَمَ ، وَلأَہْلِ نَجْدٍ قَرْنًا ، فَقَالَ رَجُلٌ : فَلأَہْلِ الْعِرَاقِ ؟ قَالَ : لاَ عِرَاقَ یَوْمَئِذٍ۔ (بخاری ۷۳۴۴۔ احمد ۲/۱۴۰)","Sahih","Musannaf Ibn Abi Shaybah 14263","","","كتاب الحج"
"14264","(۱۴۲۶۴) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : جَائَ رَجُلٌ ، فَقَالَ : یَا رَسُولَ اللہِ ، مِنْ أَیْنَ نُہِلُّ ؟ قَالَ : یُہِلُّ أَہْلُ الْمَدِینَۃِ مِنْ ذِی الْحُلَیْفَۃِ ، وَأَہْلُ الشَّامِ مِنَ الْجُحْفَۃِ ، وَأَہْلُ نَجْدٍ مِنْ قَرْنٍ ، فَقَالَ : ابْنُ عُمَرَ : وَیَقُولُونَ : وَأَہْلُ الْیَمَنِ مِنْ یَلَمْلَمَ۔ (بخاری ۱۵۲۵۔ ترمذی ۸۳۱)","Sahih","Musannaf Ibn Abi Shaybah 14264","","","كتاب الحج"
"14265","(۱۴۲۶۵) حدَّثَنَا ابْنُ نُمَیْرٍ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ، عَنْ جَابِرٍ، قَالَ: وَقَّتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَہْلِ الْمَدِینَۃِ ذَا الْحُلَیْفَۃِ ، وَلأَہْلِ الشَّامِ الْجُحْفَۃَ ، وَلأَہْلِ الْیَمَنِ یَلَمْلَمَ وَتِہَامَۃَ ، وَلأَہْلِ نَجْدٍ قَرْنًا ، وَلأَہْلِ الْعِرَاقِ ذَاتَ عِرْقٍ۔ (مسلم ۸۴۰۔ احمد ۳/۳۳۳)","","Musannaf Ibn Abi Shaybah 14265","","","كتاب الحج"
"14266","(۱۴۲۶۶) حدَّثَنَا یَحْیَی بن آدم ، قَالَ : حدَّثَنَا وُہَیْبٌ ، قَالَ : حدَّثَنَا عَبْدُ اللَّہِ بْنُ طَاوُوس ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقَّتَ لأَہْلِ الْمَدِینَۃِ ذَا الْحُلَیْفَۃِ ، وَلأَہْلِ الشَّامِ الْجُحْفَۃَ ، وَلأَہْلِ نَجْدٍ قَرْنَ الْمَنَازِلِ ، وَلأَہْلِ الْیَمَنِ یَلَمْلَمَ ، وَقَالَ : ہُنَّ لَہُمْ ، وَلِکُلِّ آتٍ أَتَی عَلَیْہِنَّ مِنْ غَیْرِہِمْ ، مِمَنْ أَرَادَ الْحَجَّ وَالْعُمْرَۃَ ، وَمَنْ کَانَ دُونَ ذَلِکَ فَمِنْ حَیْثُ أَنْشَأَ ، حَتَّی أَہْلُ مَکَّۃَ مِنْ مَکَّۃَ۔n(بخاری ۱۵۲۶۔ ابوداؤد ۱۷۳۵)","Sahih","Musannaf Ibn Abi Shaybah 14266","","","كتاب الحج"
"14267","(۱۴۲۶۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : وَقَّتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَہْلِ الْمَشْرِقِ الْعَقِیقَ۔ (ترمذی ۸۳۲۔ ابوداؤد ۱۷۳۷)","Da'if","Musannaf Ibn Abi Shaybah 14267","","","كتاب الحج"
"14268","(۱۴۲۶۸) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : وَقَّتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَہْلِ الْعِرَاقِ ذَاتَ عِرْقٍ۔","","Musannaf Ibn Abi Shaybah 14268","","","كتاب الحج"
"14269","(۱۴۲۶۹) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی کَثِیرٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قُلْتُ لَہُ : مِنْ أَیْنَ نُہِلُّ ؟ قَالَ : مِنَ الْبَیْدَائِ ، مِنْہَا أَہَلَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِحَجَّۃٍ ، وَمِنْہَا أَہَلَّ لِعُمْرَتِہِ۔","","Musannaf Ibn Abi Shaybah 14269","","","كتاب الحج"
"14270","(۱۴۲۷۰) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنْ عُبَیْدِاللہِ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّ عُمَرَ وَقَّتَ لأَہْلِ الْعِرَاقِ ذَاتَ عِرْقٍ۔","Sahih","Musannaf Ibn Abi Shaybah 14270","","","كتاب الحج"
"14271","(۱۴۲۷۱) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ عُمَرُ لأَہْلِ الْعِرَاقِ : اُنْظُرُوا حِذَائَ قَرْنٍ ، فَوَجَدُوا حِذَائَہَا ذَاتَ عِرْقٍ ، وَقَرْنٌ أَقْرَبُ إلَی مَکَّۃَ مِنْ ذَاتِ عِرْقٍ ، قَالَ : فَجَعَلَہُ لأَہْلِ الْعِرَاقِ۔","Da'if","Musannaf Ibn Abi Shaybah 14271","","","كتاب الحج"
"14272","(۱۴۲۷۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ لاَ یَدَعُ أَحَدًا مِنْ أَہْلِہِ یُجَاوِزُ الْعَقِیقَ ، إِلاَّ وَہُوَ مُحْرِمٌ۔","","Musannaf Ibn Abi Shaybah 14272","","","كتاب الحج"
"14273","(۱۴۲۷۳) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : حُدَّ لِلنَّاسِ خَمْسَۃً : لأَہْلِ الْمَدِینَۃِ ذُو الْحُلَیْفَۃِ ، وَلأَہْلِ مَکَّۃَ التَّنْعِیمُ ، وَلأَہْلِ الشَّامِ الْجُحْفَۃُ ، وَلأَہْلِ الْیَمَنِ یَلَمْلَمُ ، وَلأَہْلِ نَجْدٍ قَرْنٌ ، أَوْ قَالَ : لأَہْلِ الْعِرَاقِ قَرْنٌ ، فَلَمَّا کَانَ بَعْدُ قَالُوا لابْنِ عَبَّاسٍ : لَیْسَ لَنَا طَرِیقٌ عَلَی قَرْنٍ ، قَالَ : إزَائَہُ ذَاتُ عِرْقٍ۔","","Musannaf Ibn Abi Shaybah 14273","","","كتاب الحج"
"14274","(۱۴۲۷۴) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُمَارَۃَ بْنِ زَاذَانَ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ؛ أَنَّہُ کَانَ یُحْرِمُ مِنْ ذَاتِ عِرْقٍ ، وَلاَ یُکَلِّمُ أَحَدًا مِنَ النَّاسِ حَتَّی یَطُوفَ بِالْبَیْتِ ، إِلاَّ مَا لاَ بُدَّ مِنْہُ۔","Hasan","Musannaf Ibn Abi Shaybah 14274","","","كتاب الحج"
"14275","(۱۴۲۷۵) حدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ ثُوَیْرٍ، قَالَ: حجَجْتُ مَعَ سَعِیدِ بْنِ جُبَیْرٍ، وَمُجَاہِدٍ فَأَحْرَمْنَا مِنَ الْعَقِیقِ۔","","Musannaf Ibn Abi Shaybah 14275","","","كتاب الحج"
"14276","(۱۴۲۷۶) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : خَرَجْتُ مَعَ ابْنِ عُمَرَ فَأَحْرَمَ مِنْ ذَاتِ عِرْقٍ۔","","Musannaf Ibn Abi Shaybah 14276","","","كتاب الحج"
"14277","(۱۴۲۷۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : سَمِعْتُ مَسْرُوقًا یَقُولُ : لأَہْلِ الْعِرَاقِ الْعَقِیقُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14277","","","كتاب الحج"
"14278","(۱۴۲۷۸) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ أَنَسٍ ، قَالَ : إذَا خَرَجْتَ وَأَنْتَ تُرِیدُ الْحَجَّ فَلاَ تَقُلْ : إنِّی حَاجٌّ حَتَّی تُہِلَّ ، قَالَ : فَقُلْت : أَیُّ شَیْئٍ أَقُولُ ؟ قَالَ : قُلْ : إنِّی مُسَافِرٌ۔","Sahih","Musannaf Ibn Abi Shaybah 14278","","","كتاب الحج"
"14279","(۱۴۲۷۹) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ خَیْثَمَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ أَرَادَ ہَذَا الْوَجْہَ فَلاَ یَقُلْ إنِّی حَاجٌّ ، إِنَّمَا الْحَاجُّ الْمُحْرِمُ ، وَلْیَقُلْ إنِّی وَافِدٌ۔","Sahih","Musannaf Ibn Abi Shaybah 14279","","","كتاب الحج"
"14280","(۱۴۲۸۰) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَحُجُّ فَیَبْدُو لَہُ أَنْ یَرْجِعَ قَبْلَ أَنْ یُحْرِمَ ، قَالَ : لاَ بَأْسَ أَنْ یَرْجِعَ قَبْلَ أَنْ یُحْرِمَ۔","","Musannaf Ibn Abi Shaybah 14280","","","كتاب الحج"
"14281","(۱۴۲۸۱) حدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : إذَا خَرَجَ الرَّجُلُ إلَی مَکَّۃَ ثُمَّ بَدَا لَہُ أَنْ یَرْجِعَ ، رَجَعَ مَا لَمْ یُہِلَّ بِالْحَجِّ۔","","Musannaf Ibn Abi Shaybah 14281","","","كتاب الحج"
"14282","(۱۴۲۸۲) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاووُسٍ قَالاَ : إِنْ شَائَ تَمَّ ، وإنْ شَائَ رَجَعَ۔","","Musannaf Ibn Abi Shaybah 14282","","","كتاب الحج"
"14283","(۱۴۲۸۳) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِلاَلِ بْنِ خَبَّابٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ ضُبَاعَۃَ ابْنَۃَ الزُّبَیْرِ بْنِ عَبْدِ الْمُطَّلِبِ أَتَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : یَا رَسُولَ اللِہ ، إِنِّی أُرِیدُ الْحَجَّ ، أَفَأَشْتَرِطُ ؟ قَالَ : نَعَمْ اِشْتَرِطِی ، قَالَتْ : کَیْفَ أَقُولُ ؟ قَالَ : قُولِی : لَبَّیْکَ اللَّہُمَّ لَبَّیْکَ ، مَحِلِّی مِنَ الأَرْضِ حَیْثُ حَبَسْتَنِی۔ n(مسلم ۱۰۶۔ احمد ۱/۳۳۷)","Sahih","Musannaf Ibn Abi Shaybah 14283","","","كتاب الحج"
"14284","(۱۴۲۸۴) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : کَانَ عَطَائٌ یُلَبِّی وَلَیْسَ بِمُحْرِمٍ۔","","Musannaf Ibn Abi Shaybah 14284","","","كتاب الحج"
"14285","(۱۴۲۸۵) حدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ شُعْبَۃَ، عَنِ الْحَکَمِ؛ فِی الرَّجُلِ یُعَلِّمُ الرَّجُلَ التّ??لْبِیَۃَ وَہُوَ حَلاَلٌ، قَالَ: لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14285","","","كتاب الحج"
"14286","(۱۴۲۸۶) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 14286","","","كتاب الحج"
"14287","(۱۴۲۸۷) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ شُعْبَۃَ ، عَنْ أَیُّوبَ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ أَہْلُونَا یُعَلِّمُونَا ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 14287","","","كتاب الحج"
"14288","(۱۴۲۸۸) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، وَعَطَائٍ قَالَ : کَانَا لاَ یَرَیَانِ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 14288","","","كتاب الحج"
"14289","(۱۴۲۸۹) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، وَابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ سَابِطٍ ، عَنْ عَیَّاشِ بْنِ أَبِی رَبِیعَۃَ الْمَخْزُومِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَزَالُ ہَذِہِ الأُمَّۃُ بِخَیْرٍ مَا عَظَّمُوا ہَذِہِ الْحُرْمَۃَ حَقَّ تَعْظِیمِہَا ، فَإِذَا ضَیَّعُوا ذَلِکَ ہَلَکُوا۔ (ابن ماجہ ۳۱۱۰۔ احمد ۴/۳۴۷)","Da'if","Musannaf Ibn Abi Shaybah 14289","","","كتاب الحج"
"14290","(۱۴۲۹۰) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ہَذِہِ حَرَمٌ - یَعْنِی مَکَّۃَ - حَرَّمَہا اللہ یَوْمَ خَلَقَ السَّمَاوَاتِ وَالأَرْضِ ، وَوَضَعَ ہَذَیْنِ الأَخْشَبَیْنِ لَم تَحِلَّ لأَحَدٍ قَبْلِی ، وَلاَ تَحِلُّ لأَحَدٍ بَعْدِی ، وَلَمْ تَحِلَّ لِی إلاَّ سَاعَۃً مِنْ نَہَارٍ ، وَلاَ یُخْضَدُ شَوْکُہَا ، وَلاَ یُنَفَّرُ صَیْدُہَا ، وَلاَ یُخْتَلَی خَلاَہَا ، وَلاَ تُرْفَعُ لُقَطَتُہَا إِلاَّ لِمُنْشِدٍ ، فَقَالَ الْعَبَّاسُ : یَا رَسُولَ اللہِ ، إِنَّ أَہْلَ مَکَّۃَ لاَ صَبْرَ لَہُمْ عَنِ الإِذْخِرِ ، لِقَیْنِہِم وَلِبِنَائِہِم ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِلاَّ الإِذْخِرَ۔n(بخاری ۱۵۸۷۔ مسلم ۹۸۶)","Da'if","Musannaf Ibn Abi Shaybah 14290","","","كتاب الحج"
"14291","(۱۴۲۹۱) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ طَلْقِ بْنِ حَبِیبٍ ، قَالَ : قَالَ عُمَرُ : یَا أَہْلَ مَکَّۃَ ، اتَّقُوا اللَّہَ فِی حَرَمِ اللہِ ، أَتَدْرُونَ مَنْ کَانَ سَاکِنَ ہَذَا الْبَلَدِ ؟ کَانَ بِہِ بَنُو فُلاَنٍ فَأَحَلُّوا حُرَمَہُ فَأُہْلِکُوا ، وَکَانَ بِہِ بَنُو فُلاَنٍ فَأَحَلُّوا حُرَمَہُ فَأُہْلِکُوا ، حَتَّی ذَکَرَ مَا شَائَ اللَّہُ مِنْ قَبَائِلِ الْعَرَبِ أَنْ یَذْکُرَ ، ثُمَّ قَالَ : لأَنْ أَعْمَلَ عَشْرَ خَطَایَا بِرُکْبۃِ ، أَحَبَّ إلَیَّ مِنْ أَنْ أَعْمَلَ ہَاہُنَا خَطِیئَۃً وَاحِدَۃً۔","","Musannaf Ibn Abi Shaybah 14291","","","كتاب الحج"
"14292","(۱۴۲۹۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَنْ مُرَّۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَنْ ہَمَّ بِسَیِّئَۃٍ لَمْ تُکْتَبْ عَلَیْہِ حَتَّی یَعْمَلَہَا ، وَإِنْ ہَمَّ بِعَدَنٍ أَبْیَنَ أَنْ یَقْتُلَ عِنْدَ الْمَسْجِدِ الْحَرَامِ ، أَذَاقَہُ اللَّہُ مِنْ عَذَابٍ أَلِیمٍ ، ثُمَّ قَرَأَ : {وَمَنْ یُرِدْ فِیہِ بِإِلْحَادٍ بِظُلْمٍ}۔","Hasan","Musannaf Ibn Abi Shaybah 14292","","","كتاب الحج"
"14293","(۱۴۲۹۳) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُلَیْمَانَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : إنَّ الْحَرَمَ مُحَرَّمٌ فِی السَّمَاوَاتِ السَّبْعِ مِقْدَارُہُ مِنَ الأَرْضِ، وَإِنَّ الْبَیْتَ الْمُقَدَّسَ مُقَدَّسُ فِی السَّمَاوَاتِ السَّبْعِ مِقْدَارُہُ مِنَ الأَرْضِ۔","Da'if","Musannaf Ibn Abi Shaybah 14293","","","كتاب الحج"
"14294","(۱۴۲۹۴) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنِ ابْنِ سَابِطٍ ، قَالَ : کَانَ النَّاسُ إذَا کَانَ الْمَوْسِمُ بِالْجَاہِلِیَّۃِ خَرَجُوا فَلَمْ یَبْقَ أَحَدٌ بِمَکَّۃَ ، وَإِنَّہُ تَخَلَّفَ رَجُلٌ سَارِقٌ فَعَمَدَ إلَی قِطْعَۃٍ مِنْ ذَہَبٍ فَوَضَعَہَا ، ثُمَّ دَخَلَ لِیَأْخُذَ أَیْضًا ، فَلَمَّا أَدْخَلَ رَأْسَہُ صَرَّہُ الْبَابُ ، فَوَجَدُوا رَأْسَہُ فِی الْبَیْتِ ، وَاسْتَہُ خَارِجًا ، فَأَلْقَوْہُ لِلْکِلاَبِ وَأَصْلَحُوا الْبَیْتَ۔","","Musannaf Ibn Abi Shaybah 14294","","","كتاب الحج"
"14295","(۱۴۲۹۵) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، أَنَّہُ کَانَ لَہُ فُسْطَاطَانِ ؛ أَحَدُہُمَا فِی الْحَرَمِ وَالآخَرُ فِی الْحِلِّ ، فَإِذَا أَرَادَ أَنْ یُصَلِّیَ صَلَّی فِی الَّذِی فِی الْحَرَمِ ، وَإِذَا کَانَتْ لَہُ الْحَاجَۃُ إلَی أَہْلِہِ ، جَائَ إلَی الَّذِی فِی الْحِلِّ ، فَقِیلَ لَہُ فِی ذَلِکَ ؟ فَقَالَ : إنَّ مَکَّۃَ مَکَّۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 14295","","","كتاب الحج"
"14296","(۱۴۲۹۶) حدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : قُلْتُ لَہُ : مَا لاَ یُنَفَّرُ صَیْدُہَا ؟ قَالَ : تُحَوِّلُہُ مِنَ الظِّلِّ إلَی الشَّمْسِ ، وَتَنْزِلُ مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 14296","","","كتاب الحج"
"14297","(۱۴۲۹۷) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ زِیَادِ بْنِ سَعْدٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ سَمِعَ أَبَا ہُرَیْرَۃَ یَقُولُ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یُخَرِّبُ الْکَعْبَۃَ ذُو السُّوَیْقَتَیْنِ مِنَ الْحَبَشَۃِ۔n(بخاری ۱۵۹۱۔ مسلم ۵۷)","Sahih","Musannaf Ibn Abi Shaybah 14297","","","كتاب الحج"
"14298","(۱۴۲۹۸) حدَّثَنَا إسْحَاقُ الأَزْرَقُ ، عَنْ ہِشَامِ بْنِ حَسَّانَ ، عَنْ حَفْصَۃَ ، عَنْ أَبِی الْعَالِیَۃِ ، عَنْ عَلِیِّ بْنِ أَبِی طَالِبٍ ، قَالَ : کَأَنِّی أَنْظُرُ إلَی رَجُلٍ مِنَ الْحَبَشِ ، أَصْلَعَ ، أَصْمَعَ ، حَمْشِ السَّاقَیْنِ ، جَالِسٌ عَلَیْہَا وَہُوَ یَہْدِمُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 14298","","","كتاب الحج"
"14299","(۱۴۲۹۹) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ سَمِعَ ابْنَ عَمْرٍو یَقُولُ : کَأَنِّی بِہِ أُصَیْلِعٌ ، أُفَیْدِعٌ ، قَائِمٌ عَلَیْہَا یَہْدِمُہَا بِمِسْحَاتِہِ ، فَلَمَّا ہَدَمَہَا ابْنُ الزُّبَیْرِ جَعَلْتُ أَنْظُرُ إِلَی صِفَۃِ ابْنِ عَمْرٍو فَلَمْ أَرَہَا۔n(احمد ۲۲۰)","Sahih","Musannaf Ibn Abi Shaybah 14299","","","كتاب الحج"
"14300","(۱۴۳۰۰) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ دَاوُدَ بْنِ شَابُورَ ، عَنْ مُجَاہِدٍ ، قَالَ : لَمَّا أَجْمَعَ ابْنُ الزُّبَیْرِ عَلَی ہَدْمِہَا ، خَرَجْنَا إلَی مِنًی ثَلاَثًا نَنْتَظِرُ الْعَذَابَ۔","Sahih","Musannaf Ibn Abi Shaybah 14300","","","كتاب الحج"
"14301","(۱۴۳۰۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ أَبِی صَادِقٍ ، عَنْ حَنشٍ الْکِنَانِیِّ ، عَنْ عَلِیمٍ الْکِنْدِیِّ ، عَنْ سَلْمَانَ ، قَالَ : لَیُحْرَقَنَّ ہَذَا الْبَیْتُ عَلَی یَدَیْ رَجُلٍ مِنْ آلِ الزُّبَیْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 14301","","","كتاب الحج"
"14302","(۱۴۳۰۲) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ مُجَاہِدٍ ، قَالَ : لَمَّا ہُدِمَ الْبَیْتُ ، وُجِدَ فِیہِ صَخْرَۃٌ مَکْتُوبٌ فِیہَا : أَنَا اللَّہُ ذُو بَکَّۃَ ، صُغْتُہُ یَوْمَ صُغْتُ الشَّمْسَ وَالْقَمَرَ ، حَفَفْتُہُ بِسَبْعَۃِ أَمْلاَکٍ حُنَفَائَ ، بَارَکْتُ لأَہْلِہِ فِی السَّمْنِ وَالسَّمِینِ ، لاَ یَزُولُ حَتَّی یَزُولَ الأَخْشَبَانِ ، یَعْنِی الْجَبَلَیْنِ ، وَأَوَّلُ مَنْ یَحِلُّہَا أَہْلُہَا۔","","Musannaf Ibn Abi Shaybah 14302","","","كتاب الحج"
"14303","(۱۴۳۰۳) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَلَمَۃُ بْنُ نُبَیْطٍ ، عَنِ الضَّحَّاکِ بْنِ مُزَاحِمٍ ، قَالَ : لَمَّا کُسِرَ الْبَیْتُ ، جَائَ سَیْلٌ فَقَلَبَ حَجَرًا مِنْ حِجَارَۃِ الْبَیْتِ ، فَإِذَا مَکْتُوبٌ فِیہِ : أَنَا اللَّہُ ذُو بَکَّۃَ ، صُغْتُہُ یَوْمَ صُغْتُ الْجَبَلَیْنِ ، بَنَیْتُہُ عَلَی وَجْہِ سَبْعَۃِ أَمْلاَکٍ حُنَفَائَ ، لَیْسُوا یَہُودًا ، وَلاَ نَصَارَی۔","","Musannaf Ibn Abi Shaybah 14303","","","كتاب الحج"
"14304","(۱۴۳۰۴) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : حَدَّثَنِی مَنْ قَرَأَ کِتَابًا فِی بحتخہ فِی سَقْفِ الْبَیْتِ، أَوْ أَسْفَلَ مَقَامِ إبْرَاہِیمَ : أَنَا اللَّہُ ذُو بَکَّۃَ ، بَنَیْتُہُ عَلَی و??جُوہِ سَبْعَۃِ أَمْلاَکٍ حُنَفَائَ ، بَارَکْتُ لأَہْلِہِ فِی اللَّحْمِ وَالْمَائِ ، وَجَعَلْت رِزْقَ أَہْلِہِ مِنْ ثَلاَثَۃِ سُبُلٍ ، وَلاَ یَسْتَحِلَّ حُرْمَتَہُ أَوَّلُ مَنْ أَہَلَّہُ۔","","Musannaf Ibn Abi Shaybah 14304","","","كتاب الحج"
"14305","(۱۴۳۰۵) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ سُلَیْمَانَ بْنِ مِینَائَ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ عَمْرٍو یَقُولُ : إذَا رَأَیْتُمْ قُرَیْشًا قَدْ ہَدَمُوا الْبَیْتَ ، ثُمَّ بَنُوہُ فَزَوَّقُوہُ ، فَإِنَ اسْتَطَعْتَ أَنْ تَمُوتَ فَمُتْ۔","Da'if","Musannaf Ibn Abi Shaybah 14305","","","كتاب الحج"
"14306","(۱۴۳۰۶) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ آخُذًا بِلِجَامِ دَابَّۃِ عَبْدِ اللہِ بْنِ عَمْرٍو، فَقَالَ: کَیْفَ أَنْتُمْ إذَا ہَدَمْتُمْ ہَذَا الْبَیْتَ، فَلَمْ تَدَعُوا حَجَرًا عَلَی حَجَرٍ؟ قَالُوا: وَنَحْنُ عَلَی الإِسْلاَمِ؟ قَالَ: وَنَحْنُ عَلَی الإِسْلاَمِ ، قُلْتُ : ثُمَّ مَاذَا ؟ قَالَ : ثُمَّ یُبْنَی أَحْسَنَ مَا کَانَ ، فَإِذَا رَأَیْتَ مَکَّۃَ قَدْ بُعِجَتْ کَظَائِم ، وَرَأَیْتَ الْبِنَائَ یَعْلُو رُؤُوسَ الْجِبَالِ ، فَاعْلَمْ أَنَّ الأَمْرَ قَدْ أَظَلَّک۔","Da'if","Musannaf Ibn Abi Shaybah 14306","","","كتاب الحج"
"14307","(۱۴۳۰۷) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ الْمُزَنِیّ ، عنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : تَمَتَّعُوا مِنْ ہَذَا الْبَیْتِ قَبْلَ أَنْ یُرْفَعَ ، فَإِنَّہُ سَیُرْفَعُ وَیُہْدَمُ مَرَّتَیْنِ ، وَیُرْفَعُ فِی الثَّالِثَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 14307","","","كتاب الحج"
"14308","(۱۴۳۰۸) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ کَانَ عِنْدَنَا سَعَۃٌ لَہَدَمْتُ الْکَعْبَۃَ ، وَلَبَنَیْتُہَا وَجَعَلْتُ لَہَا بَابَیْنِ ؛ بَابًا یَدْخُلُ مِنْہُ النَّاسُ ، وَبَابًا یَخْرُجُونَ مِنْہُ ، قَالَ : فَلَمَّا وَلِیَ ابْنُ الزُّبَیْرِ ہَدَمَہَا ، فَجَعَلَ لَہَا بَابَیْنِ ، فَکَانَتْ کَذَلِکَ ، فَلَمَّا ظَہَرَ الْحَجَّاجُ عَلَیْہِ ہَدَمَہَا وَأَعَادَ بِنَائَہَا الأَوَّلَ۔ (بخاری ۱۵۸۳۔ مسلم ۹۶۸)","Da'if","Musannaf Ibn Abi Shaybah 14308","","","كتاب الحج"
"14309","(۱۴۳۰۹) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی الْبَدَّاحِ بْنِ عَدِیٍّ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَخَّصَ لِلرِّعَائِ أَنْ یَرْمُوا یَوْمًا ، وَیَدَعُوا یَوْمًا۔ (ابوداؤد ۱۹۷۰۔ ابن ماجہ ۳۰۳۶)","Sahih","Musannaf Ibn Abi Shaybah 14309","","","كتاب الحج"
"14310","(۱۴۳۱۰) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَخَّصَ لِلرِّعَائِ أَنْ یَرْمُوا لَیْلاً۔ (بیہقی ۱۵۱)","","Musannaf Ibn Abi Shaybah 14310","","","كتاب الحج"
"14311","(۱۴۳۱۱) حدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ عَطَائٍ ؛ أَنَّ عُمَرَ رَخَّصَ لِلرِّعَائِ أَنْ یَبِیتُوا عَنْ مِنًی ، قَالَ : فَذَکَرْتُ ذَلِکَ لِلزُّہْرِیِّ ؟ فَقَالَ : الرِّعَائُ یَرْمُونَ لَیْلاً ، وَلاَ یَبِیتُونَ۔","","Musannaf Ibn Abi Shaybah 14311","","","كتاب الحج"
"14312","(۱۴۳۱۲) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَجْعَلُ رَمْیَ الْجِمَارِ نَوَائِبَ بَیْنَ رِعَائِ الإِبِلِ ، یَأْمُرُ الَّذِینَ عِنْدَہُ فَیَرْمُونَ إِذَا زَالَتِ الشَّمْسُ ، ثُمَّ یَذْہَبُونَ إلَی الإِبِلِ ، وَیَأْتِی الَّذِینَ فِی الإِبِلِ فَیَرْمُونَ ، ثُمَّ یَمْکُثُونَ حَتَّی یَرْمُوہَا مِنَ الْغَدِ إِذَا زَالَتِ الشَّمْسُ۔","Sahih","Musannaf Ibn Abi Shaybah 14312","","","كتاب الحج"
"14313","(۱۴۳۱۳) حدَّثَنَا شَرِیکٌ ، عَنْ مُحَمَّدِ بْنِ أَبِی إسْمَاعِیلَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَرْکَبُ الْمَاشِی إذَا رَمَی الْجَمْرَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 14313","","","كتاب الحج"
"14314","(۱۴۳۱۴) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ، قَالَ: لاَ یَرْکَبُ الْمَاشِی حَتَّی یَقْضِی الْمَنَاسِکَ کُلَّہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 14314","","","كتاب الحج"
"14315","(۱۴۳۱۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : لاَ یَرْکَبُ الْمَاشِی حَتَّی یَصْدُرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14315","","","كتاب الحج"
"14316","(۱۴۳۱۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُثَنَّی ، عَنْ عَطَائٍ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 14316","","","كتاب الحج"
"14317","(۱۴۳۱۷) حدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ الطَّائِفِیُّ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ ، قَالَ : سَمِعْتُ مُجَاہِدًا ، وَسَعِیدَ بْنَ جُبَیْرٍ یَقُولاَنِ : کُنَّا نَرَی عَبْدَ اللہِ بْنَ عَبَّاسٍ إِذَا رَمَی الْجَمْرَۃَ یَرْفَعُ یَدَیْہِ حَتَّی یُسَاوِیَ رَأْسَہُ ، وَیُرَی بَیَاضُ إبْطَیْہِ ، وَکَانَ حَصَاہُ مِثْلَ البُنْدُقَۃِ الْحَادِرَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 14317","","","كتاب الحج"
"14318","(۱۴۳۱۸) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ خُثَیْمٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا رَمَی الْجَمْرَۃَ فَلْیَرْفَعْ یَدَیْہِ حَتَّی یُرَی بَیَاضُ إبْطَیْہِ۔","","Musannaf Ibn Abi Shaybah 14318","","","كتاب الحج"
"14319","(۱۴۳۱۹) حدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : أَخْبَرَنِی الْوَلِیدُ بْنُ دِینَارٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إذَا رَمَی الْجَمْرَۃَ تَقَدَّمَ أَمَامَہَا ، فَدَعَا اللَّہَ وَرَفَعَ یَدَیْہِ وَرَفَعْنَا مَعَہُ ، فَمَا یَضَعُ یَدَیْہِ حَتَّی نَمَلَّ وَنَضَعَ أَیْدِینَا ، وَہُوَ کَمَا ہُوَ۔","","Musannaf Ibn Abi Shaybah 14319","","","كتاب الحج"
"14320","(۱۴۳۲۰) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ قَالَ : تُرْفَعُ الأَیْدِی عِنْدَ الْجِمَارِ۔","Da'if","Musannaf Ibn Abi Shaybah 14320","","","كتاب الحج"
"14321","(۱۴۳۲۱) حدَّثَنَا وَکِیعٌ، عَنْ أَشْعَثَ، عَنْ نَافِعٍ، قاَلَ: کَانَ أَصْحَابُ عَبْدِاللہِ یَقُولُونَ: تُرْفَعُ الأَیْدِی عِنْدَ الْجَمْرَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 14321","","","كتاب الحج"
"14322","(۱۴۳۲۲) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ (ح) وَعَنِ ابْنِ أَبِی لَیْلَی، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالاَ : تُرْفَعُ الأَیْدِی عِنْدَ الْجِمَارِ۔","Da'if","Musannaf Ibn Abi Shaybah 14322","","","كتاب الحج"
"14323","(۱۴۳۲۳) حدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَحُجُّ فَیَمُوتُ قَبْلَ أَنْ یَقْضِیَ نُسُکَہُ ، قَالَ : یُقْضَی عَنْہُ مَا بَقِیَ مِنْ نُسُکِہِ۔","","Musannaf Ibn Abi Shaybah 14323","","","كتاب الحج"
"14324","(۱۴۳۲۴) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی نَہِیکٍ ، قَالَ : سَأَلْتُ طَاوُوسًا عَنِ امْرَأَۃٍ تُوُفِّیَتْ وَقَدْ بَقِیَ عَلَیْہَا مِنْ نُسُکِہَا ؟ قَالَ : یُقْضَی عَنْہَا ، وَسَأَلْتُ الْقَاسِمَ ؟ فَقَالَ : لاَ عِلْمَ لِی بِمَا قَالَ طَاوُوس ، قَالَ اللَّہُ : (لاَ تَزِرُ وَازِرَۃٌ وِزْرَ أُخْرَی)۔","","Musannaf Ibn Abi Shaybah 14324","","","كتاب الحج"
"14325","(۱۴۳۲۵) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ أَبِی مَالِکٍ ، قَالَ : مَوْضِعُ الْبَیْتِ بَکَّۃُ ، وَمَا سِوَی ذَلِکَ مَک??َۃُ۔","","Musannaf Ibn Abi Shaybah 14325","","","كتاب الحج"
"14326","(۱۴۳۲۶) حدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : سَمِعْتُ عِکْرِمَۃَ یَقُولُ : بَکَّۃُ مَا حَوْلَ الْبَیْتِ ، وَمَکَّۃُ مَا وَرَائَ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14326","","","كتاب الحج"
"14327","(۱۴۳۲۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ الزُّبَیْرِ ، قَالَ : إنَّمَا سُمِّیَتْ بَکَّۃَ لأَنَّ النَّاسَ یَجِیؤُنَہَا مِنْ کُلِّ جَانِبٍ حُجَّاجًا۔","Da'if","Musannaf Ibn Abi Shaybah 14327","","","كتاب الحج"
"14328","(۱۴۳۲۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ وَسُئِلَ : لِمَ سُمِّیَتْ بَکَّۃَ ؟ قَالَ : لأَنَّہُمْ یَتَبَاکَّوْنَ فِیہَا۔","","Musannaf Ibn Abi Shaybah 14328","","","كتاب الحج"
"14329","(۱۴۳۲۹) حدَّثَنَا مُحَمَّدُ بْنُ مَیْمَونٍ ، عَنْ عَمْرِو بْنِ سَعِیدٍ ، قَالَ : إنَّمَا سُمِّیَتْ بَکَّۃَ لأَنَّ النَّاسَ یَتَبَاکَّوْنَ بِہَا۔","","Musannaf Ibn Abi Shaybah 14329","","","كتاب الحج"
"14330","(۱۴۳۳۰) حدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ مِسْعَرٍ ، عَنْ عُتْبَۃَ بْنِ قَیْسٍ ، عَنِ ابْنِ عمَرَ ، قَالَ : مَکَّۃَ بُکَّتْ بَکًا ، الذَّکَرُ فِیہَا کَالأُنْثَی۔","Hasan","Musannaf Ibn Abi Shaybah 14330","","","كتاب الحج"
"14331","(۱۴۳۳۱) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ ، قَالَ : إنَّمَا سُمِّیَتْ بَکَّۃَ لأَنَّ النَّاسَ یَبُکَّ بَعْضُہُمْ بَعْضًا ، وَإِنَّہُ یَحِلُّ فِیہَا مَا لاَ یَحِلُّ فِی غَیْرِہَا۔","","Musannaf Ibn Abi Shaybah 14331","","","كتاب الحج"
"14332","(۱۴۳۳۲) حدَّثَنَا وَکِیعٌ ، عَنْ فُضَیْلٍ ، عَنْ عَطِیَّۃَ ، قَالَ : بَکَّۃُ مَوْضِعُ الْبَیْتِ ، وَمَا حَوْلَہُ مَکَّۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14332","","","كتاب الحج"
"14333","(۱۴۳۳۳) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ؛ أَنَّ جِبْرِیلَ أَتَی بِإِبْرَاہِیمَ عَرَفَاتٍ، فَقَالَ: عَرَفْتَ؟ قَالَ : نَعَمْ ، قَالَ : فَمِنْ ثَمَّ سُمِّیَتْ عَرَفَاتٍ۔","","Musannaf Ibn Abi Shaybah 14333","","","كتاب الحج"
"14334","(۱۴۳۳۴) حدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : إنَّمَا سُمِّیَتْ عَرَفَاتٍ لأَنَّ جِبْرِیلَ کَانَ یُرِی إبْرَاہِیمَ الْمَنَاسِکَ فَیَقُولُ : عَرَفْتَ ؟ ثُمَّ یُرِیہِ فَیَقُولُ : عَرَفْتَ ؟ فَسُمِّیَتْ عَرَفَاتٍ۔","","Musannaf Ibn Abi Shaybah 14334","","","كتاب الحج"
"14335","(۱۴۳۳۵) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَنْ عَبْدِ اللہِ بْنِ الصَّامِتِ ، عَنْ أَبِی ذَرٍّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّہَا مُبَارَکَۃٌ ، یَعْنِی زَمْزَمَ ، طَعَامُ مَنْ طَعِمَ۔","Sahih","Musannaf Ibn Abi Shaybah 14335","","","كتاب الحج"
"14336","(۱۴۳۳۶) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ قَالَ فِی مَائِ زَمْزَمَ : طَعَامُ مَنْ طَعِمَ ، وَشِفَائُ مَنْ سَقِمَ۔","Da'if","Musannaf Ibn Abi Shaybah 14336","","","كتاب الحج"
"14337","(۱۴۳۳۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْعَلاَئِ بْنِ أَبِی الْعَبَّاسِ ، عَنْ أَبِی الطُّفَیْلِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کُنَّا نُسَمِّی زَمْزَمَ شَبَّاعَۃً ، وَنَزْعُمُ أَنَّہَا نِعْمَ الْعَوْنُ عَلَی الْعِیَالِ۔","Sahih","Musannaf Ibn Abi Shaybah 14337","","","كتاب الحج"
"14338","(۱۴۳۳۸) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، قَالَ : حدَّثَنِی رَجُلٌ مِنْ أَہْلِ الشَّامِ ، عَنْ کَعْبٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : إنَّ فِی کِتَابِ اللہِ الْمُنَزَّلِ : أَنَّ مَائَ زَمْزَمَ طَعَامُ طُعْمٍ ، وَشِفَائُ سُقْمٍ۔","Da'if","Musannaf Ibn Abi Shaybah 14338","","","كتاب الحج"
"14339","(۱۴۳۳۹) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، قَالَ : أَخْبَرَنَا أَبُو إِسْحَاقَ ، عَنْ قَیْسِ بْنِ کُرْکُمٍ ، قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ فَقُلْتُ : أَخْبِرْنِی عَنْ مَائِ زَمْزَمَ ؟ فَقَالَ : أُخْبِرُکَ بِعَلَمٍ ، لاَ تُنْزَحُ ، وَلاَ تُنْزَفُ ، وَلاَ تُذَمُّ طَعَامُ مَنْ طَعِمَ، وَشِفَائُ مَنْ سَقِمَ۔","Da'if","Musannaf Ibn Abi Shaybah 14339","","","كتاب الحج"
"14340","(۱۴۳۴۰) حدَّثَنَا سَعِیدُ بْنُ زَکَرِیَّا ، وَزَیْدُ بْنُ الْحُبَابِ ، عَنْ عَبْدِ اللہِ بْنِ الْمُؤَمَّلِ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَائُ زَمْزَمَ لِمَا شُرِبَ لَہُ۔ (احمد ۳/۳۵۷۔ بیہقی ۱۴۸)","Da'if","Musannaf Ibn Abi Shaybah 14340","","","كتاب الحج"
"14341","(۱۴۳۴۱) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُمَرَ بْنِ أَبِی عُثْمَانَ ، عَنْ طَاوُوسٍ ، قَالَ : نِیَّتہ۔","","Musannaf Ibn Abi Shaybah 14341","","","كتاب الحج"
"14342","(۱۴۳۴۲) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، وَحَفْصٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ القَاسِمِ قَالَ : نِیَّتِہِ۔","","Musannaf Ibn Abi Shaybah 14342","","","كتاب الحج"
"14343","(۱۴۳۴۳) حدَّثَنَا شَرِیکٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ (ح) وَعَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ قَالُوا : نِیَّتہ۔","No Data Available","Musannaf Ibn Abi Shaybah 14343","","","كتاب الحج"
"14344","(۱۴۳۴۴) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، قَالَ : انْطَلَقْتُ مُعْتَمِرًا فِی رَجَبَ ، فَأَرَدْتُ أَنْ أُہِلَّ بِعُمْرَۃٍ فَأَہْلَلْتُ بِالْحَجِّ ، فَسَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنْ ذَلِکَ ؟ فَضَحِکَ ، وَقَالَ : لاَ شَیْئَ عَلَیْک ، وَقَالَ الْحَسَنُ مِثْلَ قَوْلِ سَعِیدِ بْنِ جُبَیْرٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 14344","","","كتاب الحج"
"14345","(۱۴۳۴۵) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ أَرَادَ الْعُمْرَۃَ فَلَبَّی بِالْحَجِّ ، قَالَ : لَیْسَ الْحَجُّ عَلَیْہِ بِوَاجِبٍ۔","","Musannaf Ibn Abi Shaybah 14345","","","كتاب الحج"
"14346","(۱۴۳۴۶) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنِ ابْنِ جُرَیْجٍ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ، عَنْ طَاوُوسٍ؛ فِی الرَّجُلِ یَقْدَمُ مُعْتَمِرًا یَوْمَ عَرَفَۃَ ، فَیَطُوفُ بِالْبَیْتِ وَیَسْعَی بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، قَالَ : لاَ یَأْتِ النِّسَائَ وَالنَّاسُ وُقُوفٌ بِعَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 14346","","","كتاب الحج"
"14347","(۱۴۳۴۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجَ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14347","","","كتاب الحج"
"14348","(۱۴۳۴۸) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ خَالِدِ بْنِ عَرْعَرَۃَ ، عَنْ عَلِیٍّ ؛ أَنَّ إبْرَاہِیمَ عَلَیْہ السَلاَم قَالَ لابْنِہِ: ابْغِنِی حَجَرًا ، قَالَ : فَذَہَبَ ، ثُمَّ جَائَ وَقَدْ رَکِبَہُ ، فَقَالَ : مِنْ أَیْنَ ہَذَا ؟ قَالَ : جَائَنِی بِہِ مَنْ لَمْ یَتَّکِلْ عَلَی بِنَائِکَ ، جَائَنِی بِہِ جِبْرِیلُ مِنَ السَّمَائِ۔","Hasan","Musannaf Ibn Abi Shaybah 14348","","","كتاب الحج"
"14349","(۱۴۳۴۹) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الْحَجَرُ مِنْ حِجَارَۃِ الْجَنَّۃِ ، وَلَوْلاَ مَا مَسَّہُ مِنْ أَنْجَاسِ أَہْلِ الْجَاہِلِیَّۃِ ، مَا مَسَّہُ مِنْ ذِی عَاہَۃٍ إِلاَّ بَرَأَ۔","Da'if","Musannaf Ibn Abi Shaybah 14349","","","كتاب الحج"
"14350","(۱۴۳۵۰) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : لَقَدْ نَزَلَ الْحَجَرُ مِنَ الْجَنَّۃِ، وَإِنَّہُ أَشَدُّ بَیَاضًا مِنَ الثَّلْجِ ، فَمَا سَوَّدَہُ إِلاَّ خَطَایَا بَنِی آدَمَ۔","Sahih","Musannaf Ibn Abi Shaybah 14350","","","كتاب الحج"
"14351","(۱۴۳۵۱) حدَّثَنَا عَبْدَۃُ ، عَن?? ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، قَالَ : سُئِلَ کَعْبٌ عَنِ الْحَجَرِ الأَسْوَدِ ؟ فَقَالَ : حَجَرٌ مِنْ حِجَارَۃِ الْجَنَّۃِ۔","","Musannaf Ibn Abi Shaybah 14351","","","كتاب الحج"
"14352","(۱۴۳۵۲) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : الْحَجَرُ مِنْ حِجَارَۃِ الْجَنَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 14352","","","كتاب الحج"
"14353","(۱۴۳۵۳) حدَّثَنَا وَکِیعٌ ، عَنْ سَوَادَۃَ بْنِ أَبِی الأَسْوَدِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : حُجُّوا ہَذَا الْبَیْتَ ، وَاسْتَلِمُوا ہَذَا الْحَجَرَ ، فَوَاللَّہِ لَیُرْفَعَنَّ ، أَوْ لَیُصِیبَنَّہُ أَمْرٌ مِنَ السَّمَائِ ، إِنْ کَانَا لَحَجَرَیْنِ أُہْبِطَا مِنَ الْجَنَّۃِ ، فَرُفِعَ أَحَدُہُمَا وَسَیُرْفَعُ الآخَرُ ، وَإِنْ لَمْ یَکُنْ کَمَا قُلْتُ ، فَمَنْ مَرَّ عَلَی قَبْرِی فَلْیَقُلْ : ہَذَا قَبْرُ عَبْدِ اللہِ بْنِ عَمْرٍو الْکَذَّابِ۔","Hasan","Musannaf Ibn Abi Shaybah 14353","","","كتاب الحج"
"14354","(۱۴۳۵۴) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ زِیَادٍ مَوْلَی بَنِی مَخْزُومٍ ، قَالَ : لَوْلاَ مَا مَسَّ الْحَجَرَ مِنْ ذُنُوبِ بَنِی آدَمَ ، مَا مَسَّہُ مِنْ ذِی عَاہَۃٍ إِلاَّ بَرَأَ۔","","Musannaf Ibn Abi Shaybah 14354","","","كتاب الحج"
"14355","(۱۴۳۵۵) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ {وَمَنْ یُعَظِّمْ شَعَائِرَ اللہِ فَإِنَّہَا مِنْ تَقْوَی الْقُلُوبِ} قَالَ : فِی الاسْتِئْذَانِ وَالاسْتِحْسَانِ وَالاسْتِعْظَامِ۔","Da'if","Musannaf Ibn Abi Shaybah 14355","","","كتاب الحج"
"14356","(۱۴۳۵۶) حدَّثَنَا یَزِید ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی مُوسَی ، قَالَ فِی قَوْلِہِ تَعَالَی : {وَمَنْ یُعَظِّمْ شَعَائِرَ اللہِ فَإِنَّہَا مِنْ تَقْوَی الْقُلُوبِ} قَالَ : الْوُقُوفُ بِعَرَفَۃَ مِنْ شَعَائِرِ اللہِ ، وَبجَمْعٍ مِنْ شَعَائِرِ اللہِ ، وَالْبُدْنُ مِنْ شَعَائِرِ اللہِ ، وَالْحَلْقُ مِنْ شَعَائِرِ اللہِ ، وَالرَّمْیُ مِنْ شَعَائِرِ اللہِ ، فَمَنْ یُعَظِّمْہَا فَإِنَّہَا مِنْ تَقْوَی الْقُلُوبِ۔","","Musannaf Ibn Abi Shaybah 14356","","","كتاب الحج"
"14357","(۱۴۳۵۷) حدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ حَبِیبٍ الْمُعَلِّمِ ، عَنْ عَطَائٍ ؛ أَنَّہُ سُئِلَ عَنْ شَعَائِرِ اللہِ ؟ فَقَالَ : حرُمَاتُ اللہِ ، اجْتِنَابُ سَخَطِ اللہِ وَاتِّبَاعُ طَاعَتِہِ ، فَذَلِکَ شَعَائِرُ اللہِ۔","","Musannaf Ibn Abi Shaybah 14357","","","كتاب الحج"
"14358","(۱۴۳۵۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ غَیْلاَنَ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ : (وَمَنْ یُعَظِّمْ شَعَائِرَ اللہِ) قَالَ : اسْتِعْظَامُہَا وَاسْتِحْسَانُہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 14358","","","كتاب الحج"
"14359","(۱۴۳۵۹) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَنْزِلُ الأَبْطَحَ أَوَّلَ مَا یَقْدَمُ۔","Da'if","Musannaf Ibn Abi Shaybah 14359","","","كتاب الحج"
"14360","(۱۴۳۶۰) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ بْنِ خُثیم ، عَنْ یُوسُفَ بْنِ مَاہَکٍ ، أَنَّ عَبْدَ اللہِ بْنَ السَّائِبِ حَدَّثَہُ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَدِمَ مَکَّۃَ فَنَزَلَ بِأَعْلَی مَکَّۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 14360","","","كتاب الحج"
"14361","(۱۴۳۶۱) حدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، عَنِ الْقَاسِمِ ، بْنِ أَبِی بَزَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ؛ أَنَّہُ نَزَلَ دَارَ أُمِّ ہَانِیئٍ۔","","Musannaf Ibn Abi Shaybah 14361","","","كتاب الحج"
"14362","(۱۴۳۶۲) حدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ نَزَلَ دَارَ أُمِّ ہَانِیئٍ فِی شَہْرِ رَمَضَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 14362","","","كتاب الحج"
"14363","(۱۴۳۶۳) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ؛ أََنَّ عَائِشَۃَ کَانَتْ تَنْزِلُ بِمَکَّۃَ بِالأَبْطَحِ ، وَتُدْعَی إلَی الدُّورِ فَتَأْبَی۔","Da'if","Musannaf Ibn Abi Shaybah 14363","","","كتاب الحج"
"14364","(۱۴۳۶۴) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا بَلَغَتِ الْبَدَنَۃُ الْحَرَمَ فَقَدْ وَفَّتْ۔","No Data Available","Musannaf Ibn Abi Shaybah 14364","","","كتاب الحج"
"14365","(۱۴۳۶۵) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : کُلُّ ہَدْیٍ دَخَلَ الْحَرَمَ فَقَدْ وَفَّی عَنْ صَاحِبِہِ ، إِلاَّ ہَدْیَ الْمُتْعَۃِ ، فَإِنَّہُ لاَ بُدَّ لَہُ مِنْ نَسِیکَۃٍ یَحِلُّ بِہَا یَوْمَ النَّحْرِ۔","","Musannaf Ibn Abi Shaybah 14365","","","كتاب الحج"
"14366","(۱۴۳۶۶) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ أَنَّہُمْ قَالُوا : الْقَارِنُ وَالْمُتَمَتِّعُ ہَدْیُہُمَا وَطَوَافُہُمَا وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 14366","","","كتاب الحج"
"14367","(۱۴۳۶۷) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ حَجَّاجٍ، عَنْ أَبِی جَعْفَرٍ؛ أَنَّ ابْنَ عَبَّاسٍ، وَعَلِیَّ بْنَ حُسَیْنٍ کَانَا لاَ یَرْمُلاَنِ۔","","Musannaf Ibn Abi Shaybah 14367","","","كتاب الحج"
"14368","(۱۴۳۶۸) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : إِنْ شَائَ رَمَلَ ، وَإِنْ شَائَ لَمْ یَرْمُلْ ، قَالَ : وَکَانَ عَطَائٌ یَرَاہُ وَاسِعًا ، إِنْ شَائَ رَمَلَ ، وَإنْ شَائَ لَمْ یَرْمُلْ ، وَکَانَ الرَّمَلُ أَحَبَّ إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 14368","","","كتاب الحج"
"14369","(۱۴۳۶۹) حدَّثَنَا ابْنُ مُبَارَکٍ، عَنْ سَعِیدِ بْنِ عَبْدِالْعَزِیزِ، عَنْ عَطَائٍ؛ فِی الرَّجُلِ یَنْسَی الرَّمَلَ، قَالَ: لَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 14369","","","كتاب الحج"
"14370","(۱۴۳۷۰) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ لاَ یَرْمُلُ إذَا أَہَلَّ مِنْ مَکَّۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 14370","","","كتاب الحج"
"14371","(۱۴۳۷۱) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ سَعِیدُ بْنُ جُبَیْرٍ : لاَ یَحِلُّ الْمُحْصَرُ إِلاَّ بِدَمٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 14371","","","كتاب الحج"
"14372","(۱۴۳۷۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یَحِلُّ الْمُحْصَرُ إِلاَّ بِدَمٍ۔","","Musannaf Ibn Abi Shaybah 14372","","","كتاب الحج"
"14373","(۱۴۳۷۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یَصُومُ عَشْرَۃَ أَیَّامٍ۔","","Musannaf Ibn Abi Shaybah 14373","","","كتاب الحج"
"14374","(۱۴۳۷۴) حدَّثَنَا وَکِیعٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ: لاَ یُرْفَعُ الصَّوْتُ بِالْقِرَائَ ۃِ عَشِیَّۃَ عَرَفَۃَ ، فِی الظُّہْرِ وَالْعَصْرِ۔","","Musannaf Ibn Abi Shaybah 14374","","","كتاب الحج"
"14375","(۱۴۳۷۵) حدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : حضَرْتُ إبْرَاہِیمَ بْنَ ہِشَامٍ یَوْمَ عَرَفَۃَ وَافَقَ یَوْمَ جُمُعَۃٍ، فَجَہَرَ بِالْقِرَائَ ۃِ ، فَقَالَ سَالِمٌ بِیَدِہِ ، أَیْ اُسْکُتْ۔","No Data Available","Musannaf Ibn Abi Shaybah 14375","","","كتاب الحج"
"14376","(۱۴۳۷۶) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، أَوْ طَاوُوسٍ قَالَ : لاَ یَجْہَرُ الإِمَامُ عَشِیَّۃَ عَرَفَۃَ، وَلَوْ وَافَقَ ذَلِکَ یَوْمَ جُمُعَۃٍ۔","","Musannaf Ibn Abi Shaybah 14376","","","كتاب الحج"
"14377","(۱۴۳۷۷) حدَّثَنَا ابْنُ مَہْدِی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، مِثْلَہُ ، قَالَ : وَہُوَ رَأْیُ سُفْیَانَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14377","","","كتاب الحج"
"14378","(۱۴۳۷۸) حدَّثَنَا زَیْدُ بْنُ حُبَابٍ، عَنْ لَیْثِ بْنِ سَعْدٍ، ??َنِ الزُّہْرِیِّ؛ أَنَّ الإِمَامَ لاَ یَجْہَرُ فِی الظُّہْرِ وَالْعَصْرِ بِالْقِرَائَۃِ یَوْمَ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 14378","","","كتاب الحج"
"14379","(۱۴۳۷۹) حدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حَمَّادٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُدْخِلُ غِلْمَانَہُ الْحَرَمَ بِغَیْرِ إحْرَامٍ ، یَنْتَفِعُ بِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 14379","","","كتاب الحج"
"14380","(۱۴۳۸۰) حدَّثَنَا عُمَرُ بْنُ عَلِیِّ بْنِ عَطَائِ بْنِ مُقَدَّمٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ؛ أَنَّ أَبَاہُ کَانَ یُدْخِلُ غِلْمَانَہُ الْحَرَمَ ، وَہُمْ غَیْرُ مُحْرِمِینَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14380","","","كتاب الحج"
"14381","(۱۴۳۸۱) حدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَمْنَعَ الرَّجُلُ غُلاَمَہُ مِنَ الإِحْرَامِ ، وَقَالَ ابْنُ سِیرِینَ : لاَ أَعْلَمُ ذَلِکَ مِنَ الإِحْسَانِ۔","","Musannaf Ibn Abi Shaybah 14381","","","كتاب الحج"
"14382","(۱۴۳۸۲) حدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : رَأَیْتُ سَالِمًا یُخْرِجُ غِلْمَانَہُ إلَی الْحَجِّ ، فَلاَ یُحْرِمُونَ مِنْ ذِی الْحُلَیْفَۃِ ، یُحْرِمُونَ مِنْ أَمَامِ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14382","","","كتاب الحج"
"14383","(۱۴۳۸۳) حدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ زَیْدِ بْنِ السَّائِبِ ، قَالَ : رَأَیْتُ خَارِجَۃَ بْنَ زَیْدٍ یُخْرِجُ غِلْمَانَہُ ، فَیُہِلُّونَ مَعَہُ مِنْ ذِی الْحُلَیْفَۃِ۔","","Musannaf Ibn Abi Shaybah 14383","","","كتاب الحج"
"14384","(۱۴۳۸۴) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ تَعَجَّلَ فِی یَوْمَیْنِ فَأَصَابَ صَیْدًا ، قَالَ : کَانَ لاَ یَرَی عَلَیْہِ شَیْئًا۔","No Data Available","Musannaf Ibn Abi Shaybah 14384","","","كتاب الحج"
"14385","(۱۴۳۸۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ بیان ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ تَعَجَّلَ فِی یَوْمَیْنِ ، یَصْطَادُ ؟ قَالَ : إذَا خَرَجَ مِنَ الْحَرَمِ فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 14385","","","كتاب الحج"
"14386","(۱۴۳۸۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَرُدُّہُمْ إلَی الْمَوَاقِیتِ ؛ الَّذِینَ یَدْخُلُونَ مَکَّۃَ بِغَیْرِ إحْرَامٍ۔","Sahih","Musannaf Ibn Abi Shaybah 14386","","","كتاب الحج"
"14387","(۱۴۳۸۷) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : کَتَبَ أَبُو الْخَلِیلِ إلَی سَعِیدِ بْنِ جُبَیْرٍ یُخْبِرُہُ : أَنَّہُ إنَّمَا یُہِلُّ مِنْ مَکَّۃَ مَنْ دَخَلَہَا بِغَیْرِ إحْرَامٍ۔","","Musannaf Ibn Abi Shaybah 14387","","","كتاب الحج"
"14388","(۱۴۳۸۸) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ جَابِرٍ ، قَالَ : بَصُرَ عَیْنِی رَأَیْتُ ابْنَ عَبَّاسٍ یَرُدُّہُمْ إلَی الْمَوَاقِیتِ۔","Sahih","Musannaf Ibn Abi Shaybah 14388","","","كتاب الحج"
"14389","(۱۴۳۸۹) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرٍوَ قَالَ : مَرَّ جَابِرُ بْنُ زَیْدٍ بِامْرَأَۃٍ تَبْکِی ، فَقَالَ : مَا یُبْکِیک ؟ قَالَتْ : مَرَرْت بِمِیقَاتِی وَأَنَا حَائِضٌ فَجَاوَزْتُہُ ، وَلَمْ أُہِلَّ ، قَالَ : لِمَ ؟ قَالَتْ : نَہَوْنِی ، قَالَ : فَاخْرُجِی فَأَہِلِّی مِنْ مَکَان آخَرَ۔","","Musannaf Ibn Abi Shaybah 14389","","","كتاب الحج"
"14390","(۱۴۳۹۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، عَنْ إبْرَاہِیمَ ؛ فِی رَجُلٍ دَخَلَ مَکَّۃَ لاَ حَاجًّا ، وَلاَ مُعْتَمِرًا وَہُوَ یَخَافُ إِنْ خَرَجَ إلَی الْوَقْتِ أَنْ یَفُوتَہُ ، قَالَ : یُہِلُّ مِنْ مَکَانِہِ ، وَلَمْ یَذْکُرْ دَمًا۔","No Data Available","Musannaf Ibn Abi Shaybah 14390","","","كتاب الحج"
"14391","(۱۴۳۹۱) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ وَبَرَۃَ ، قَالَ : دَخَلَ رَجُلٌ مَکَّۃَ وَعَلَیْہِ ثِیَابُہُ ، وَحَضَرَ الْحَجُّ ، وَخَافَ إِنْ رَجَعَ أَنْ یَفُوتَہُ ، فَأَمَرَہُ ابْنُ الزُّبَیْرِ أَنْ یُہِلَّ مِنْ مَکَانِہِ ، فَإِذَا قَضَی الْحَجَّ خَرَجَ إلَی الْوَقْتِ فَأَہَلَّ بِعُمْرَۃٍ۔","","Musannaf Ibn Abi Shaybah 14391","","","كتاب الحج"
"14392","(۱۴۳۹۲) حدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ جَہِلَ حَتَّی دَخَلَ مَکَّۃَ ، أَنَّہُ کَانَ عُظْمُ قَوْلہِ یُہِلُّ مِنْ مَکَانِہِ ، وَقَدْ قَالَ الْحَسَنُ : إِنَّمَا یَرْجِعُ إلَی حَدِّہِ لِیُہِلَّ مِنْہُ ، إِلاَّ أَنْ یَخْشَی الْفَوْتَ ، فَإِنْ خَشِیَ الْفَوْتَ أَہَلَّ مِنْ مَکَانِہِ وَمَضَی ، وَلاَ شَیْئَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 14392","","","كتاب الحج"
"14393","(۱۴۳۹۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یُہِلّ مِنْ مَکَانِہِ وَعَلَیْہِ دَمٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14393","","","كتاب الحج"
"14394","(۱۴۳۹۴) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عُمَرُ یَحُجُّ فَلاَ یَذْبَحُ شَیْئًا حَتَّی یَرْجِعَ۔","","Musannaf Ibn Abi Shaybah 14394","","","كتاب الحج"
"14395","(۱۴۳۹۵) حدَّثَنَا عَبْدَۃُ ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، قَالَ : قَالَ نَافِعُ بْنُ جُبَیْرٍ : مَا ضَحَّیْتُ بِمَکَّۃَ قَطُّ۔","","Musannaf Ibn Abi Shaybah 14395","","","كتاب الحج"
"14396","(۱۴۳۹۶) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ أَصْحَابُنَا یَحُجُّونَ وَمَعَہُمُ الأَوْرَاقُ وَالذَّہَبُ ، فَمَا یَذْبَحُونَ شَیْئًا ، وَکَانُوا یَتْرُکُونَہُ مَخَافَۃَ أَنْ یَشْغَلَہُمْ عَنْ شَیْئٍ مِنَ الْمَنَاسِکِ۔","","Musannaf Ibn Abi Shaybah 14396","","","كتاب الحج"
"14397","(۱۴۳۹۷) حدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ تَحُجُّ فَلاَ تُضَحِّی عَنْ بَنِی أَخِیہَا۔","Sahih","Musannaf Ibn Abi Shaybah 14397","","","كتاب الحج"
"14398","(۱۴۳۹۸) حدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ أَبِی الدَّرْدَاء ، عَنْ مُجَاہِدٍ ، قَالَ: مَانُصَلِّی ہَاہُنَا، وَمَا یُضَحِّی یَوْمَ النَّحْرِ۔","","Musannaf Ibn Abi Shaybah 14398","","","كتاب الحج"
"14399","(۱۴۳۹۹) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ وَبَرَۃَ ؛ أَنَّ الأَسْوَدَ ، وَعَبْدَ الرَّحْمَن بْنَ یَزِیدَ کَانَا یَحُجَّانِ ، وَلاَ یُضَحِّیَانِ۔","","Musannaf Ibn Abi Shaybah 14399","","","كتاب الحج"
"14400","(۱۴۴۰۰) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ بَیَانٍ ؛ أَنَّ عَلْقَمَۃَ کَانَ یَحُجُّ ، وَلاَ یُضَحِّی۔","","Musannaf Ibn Abi Shaybah 14400","","","كتاب الحج"
"14401","(۱۴۴۰۱) حدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ أَبِی الزَّعْرَائِ ، عَنْ أَبِی الأَحْوَص ؛ أَنَّہُ لَمْ یَکُنْ یُضَحِّی فِی الْحَجِّ ، فَلَمَّا کَانَ أَیَّامُ التَّشْرِیقِ ، قَالَ : اشْتَرُوا بَقَرَۃً فَقَدِّدُوہَا نَتَزَوَّدُہَا فِی سَفَرِنَا۔","","Musannaf Ibn Abi Shaybah 14401","","","كتاب الحج"
"14402","(۱۴۴۰۲) حدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْمُسْتَنِیرِ الْمُسْلِیِّ ، عَنْ وَبَرَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ شَیْخٍ مِنَ التَّیْمِ ، قَالَ : کُنَّا مَعَ سَعْدٍ بِمِنًی فَلَمْ یُضَحِّ ، ثُمَّ أَرْسَلَ إلَی جِیرَانٍ لَہُ : أَطْعِمُونَا مِنْ أُضْحِیَّتِکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 14402","","","كتاب الحج"
"14403","(۱۴۴۰۳) حدَّثَنَا حَفْصٌ ، عَنْ کُلَیْبِ بْنِ وَائِلٍ ، عَنْ عَمِّہِ قَیْسٍ ، عَنْ سَعْدٍ ، بِنَحْوِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 14403","","","كتاب الحج"
"14404","(۱۴۴۰۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ صَالِحٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : حجَجْتُ ثَلاَثَ حِجَجٍ ، مَا أَہْرَقْتُ دَمًا۔","","Musannaf Ibn Abi Shaybah 14404","","","كتاب الحج"
"14405","(۱۴۴۰۵) حدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدٍ ؛ أَنَّہُ کَانَ یَکُونُ مَعَ سَالِمٍ فِی الْحَجِّ ، فَلاَ یُضَحِّی بِمِنًی۔","No Data Available","Musannaf Ibn Abi Shaybah 14405","","","كتاب الحج"
"14406","(۱۴۴۰۶) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَطَائٍ ، وَمُجَاہِدٍ قَالاَ : قَالَ ابْنُ عَبَّاسٍ : مَنْ حَجَّ فَأَہْدَی ہَدْیًا ، رَجَعَ إلَی أَہْلِہِ بِحَجَّۃٍ وَعُمْرَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 14406","","","كتاب الحج"
"14407","(۱۴۴۰۷) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَتْرُکُ الصَّفَا وَالْمَرْوَۃَ ، قَالَ : عَلَیْہِ دَمٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14407","","","كتاب الحج"
"14408","(۱۴۴۰۸) حدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ؛ أَنَّ دَاوُد بْنَ أَبِی عَاصِمٍ قَدِمَ فَتَرَکَ الصَّفَا وَالْمَرْوَۃَ ، فَقَالَ عَطَائٌ : أَہْرِقْ دَمًا ، وَقَالَ طَاوُوس : اُدْخُلْ مُعْتَمِرًا۔","","Musannaf Ibn Abi Shaybah 14408","","","كتاب الحج"
"14409","(۱۴۴۰۹) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إِسْمَاعِیِل ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ مُجَاہِدٍ (ح) وَعَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالاَ : إِذَا نَسِیَ الطَّوَافَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ وَہُوَ حَاجٌّ ، فَعَلَیْہِ الْحَجُّ ، فَإِنْ کَانَ مُعْتَمِرًا فَعَلَیْہِ الْعُمْرَۃُ ، وَلاَ یُجْزِئہِ إِلاَّ الطَّوَافُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 14409","","","كتاب الحج"
"14410","(۱۴۴۱۰) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إِنْ شَائَ سَعَی بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، وَإِنْ شَائَ لَمْ یَسْعَ۔","","Musannaf Ibn Abi Shaybah 14410","","","كتاب الحج"
"14411","(۱۴۴۱۱) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ لاَ یَرَی عَلَی مَنْ لَمْ یَسْعَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ شَیْئًا ، قُلْتُ : قدْ تَرَکَ شَیْئًا مِنْ سُنَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَیْسَ عَلَیْہِ ، وَکَانَ یُفْتِی فِی الْعَلاَنِیَۃِ بِدَمٍ۔","","Musannaf Ibn Abi Shaybah 14411","","","كتاب الحج"
"14412","(۱۴۴۱۲) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃ ، قَالَتْ : مَا أَتَمَّ اللَّہُ حَجَّ مَنْ لَمْ یَسْعَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، ثُمَّ قَرَأَتْ : (إِنَّ الصَّفَا وَالْمَرْوَۃَ مِنْ شَعَائِرِ اللہِ)۔","Sahih","Musannaf Ibn Abi Shaybah 14412","","","كتاب الحج"
"14413","(۱۴۴۱۳) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ ، عَنْ صَفِیَّۃَ ابْنَۃِ شَیْبَۃَ ؛ أَنَّہَا سَمِعَتْ عَائِشَۃَ ، وَقِیلَ لَہَا : إِنَّ بَعْضَ بَنَاتِ أَخِیکِ یَکْرَہْنَ أَنْ یَلْبَسْنَ حُلِیَّہُنَّ وَہُنَّ مُحْرِمَاتٌ ، فَأَقْسَمَتْ عَلَیْہَا لَتَلْبَسِنَّ حُلِیَّہَا کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 14413","","","كتاب الحج"
"14414","(۱۴۴۱۴) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ؛ أَنَّ نِسَائَ عَبْدِ اللہِ بْنِ عُمَرَ وَبَنَاتِہِ کُنَّ یَلْبَسْنَ الْحُلِیَّ وَہُنَّ مُحْرِمَاتٌ۔","","Musannaf Ibn Abi Shaybah 14414","","","كتاب الحج"
"14415","(۱۴۴۱۵) حدَّثَنَا أَزْہَرُ السَّمَّانُ، عَنِ ابْنِ عَوْنٍ، عَنْ مُحَمَّدٍ، قَالَ: کَانُوا یَکْرَہُونَ التَّعَطُّلَ لِلْمَرْأَۃِ فِی الْحِلِّ وَالإِحْرَامِ۔","","Musannaf Ibn Abi Shaybah 14415","","","كتاب الحج"
"14416","(۱۴۴۱۶) حدَّثَنَا حَکَّامٌ الرَّازِیُّ ، عَنْ سَعِیدٍ الزُّبَیْدِیِّ ، قَالَ : سَأَلَتُ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الْحُلِیِّ وَالْحَرِیرِ لِلْمُحْرِمَۃِ، أَتَلْبَسُہُ ؟ قَالَ : إِنْ کَانَتْ تَلْبَسُہُ وَہِیَ حَلاَلٌ ، فَلْتَلْبِسْہُ وَہِیَ مُحْرِمَۃٌ۔","","Musannaf Ibn Abi Shaybah 14416","","","كتاب الحج"
"14417","(۱۴۴۱۷) حدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ سُئِلَ عَنِ الْمُحْرِمَۃِ ، مَا تُظْہِرُ مِنَ الْحُلِیِّ ؟ قَالَ : الْخَاتَمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14417","","","كتاب الحج"
"14418","(۱۴۴۱۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : تَلْبَسُ الْمُحْرِمَۃُ الْحُلِیَّ الْخَفِیَّ وَتُوَارِیہِ۔","","Musannaf Ibn Abi Shaybah 14418","","","كتاب الحج"
"14419","(۱۴۴۱۹) حدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنِ الأَسْوَدِ ، وَعَلْقَمَۃَ قَالاَ : تَلْبَسُ الْمُحْرِمَۃُ مَا کَانَتْ تَلْبَسُ وَہِیَ مُحِلَّۃٌ ، مِنْ خَزِّہَا وَقَزِّہَا۔","","Musannaf Ibn Abi Shaybah 14419","","","كتاب الحج"
"14420","(۱۴۴۲۰) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، قَالَ : سَأَلْتُ ابْنَ الأَسْوَدِ : ما تَلْبَسُ الْمُحْرِمَۃُ مِنَ الْحُلِیِّ؟ فَقَالَ : مَا کَانَتْ تَلْبَسُ وَہِیَ مُحِلَّۃٌ۔","","Musannaf Ibn Abi Shaybah 14420","","","كتاب الحج"
"14421","(۱۴۴۲۱) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَ یُکْرَہُ لِلْمُحْرِمَۃِ أَنْ تَلْبَسَ الْحُلِیَّ الْمَشْہُورَ ، قَالَ : قُلْتُ : فَالْعِقْدُ ؟ قَالَ : إِنْ کَانَ عِقْدًا مَشْہُورًا فَلاَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14421","","","كتاب الحج"
"14422","(۱۴۴۲۲) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ تَتَزَیَّنُ الْمُحْرِمَۃُ ، وَلاَ تَکْتَحِلُ لِزِینَۃٍ۔","","Musannaf Ibn Abi Shaybah 14422","","","كتاب الحج"
"14423","(۱۴۴۲۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَرِہَ الْحُلِیَّ لِلْمُحْرِمَۃِ۔","","Musannaf Ibn Abi Shaybah 14423","","","كتاب الحج"
"14424","(۱۴۴۲۴) حدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : کَانَ یُکْرَہُ أَنْ تَلْبَسَ الْمُحْرِمَۃُ الْحُلِیَّ۔","","Musannaf Ibn Abi Shaybah 14424","","","كتاب الحج"
"14425","(۱۴۴۲۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْہَیْثُمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَأَلْتُُہُ عَنْہُ ، یَعْنِی الْخَاتَمَ لِلْمُحْرِم ؛ فَقَالَ : لاَ بَأْسَ ، قَدْ کُنَّا نَطُوفُ بِالْبَیْتِ وَہُوَ عَلَیْنَا ، نَحْفَظُ بِہِ الأُسْبُوعَ۔","","Musannaf Ibn Abi Shaybah 14425","","","كتاب الحج"
"14426","(۱۴۴۲۶) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ الْغَازِ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِالْخَاتَمِ لِلْمُحْرِمِ۔","","Musannaf Ibn Abi Shaybah 14426","","","كتاب الحج"
"14427","(۱۴۴۲۷) حدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ بِالْخَاتَمِ لِلْمُحْرِمِ۔","Hasan","Musannaf Ibn Abi Shaybah 14427","","","كتاب الحج"
"14428","(۱۴۴۲۸) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبۃ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ؛ قَالَ : لاَ بَأْسَ بِالْخَاتَمِ لِلْمُحْرِمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14428","","","كتاب الحج"
