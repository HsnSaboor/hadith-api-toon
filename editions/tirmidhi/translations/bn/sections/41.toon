hadiths[85]{hadithnumber,text}:
"2645","। ইবনু আব্বাস (রাযিঃ) হতে বর্ণিত আছে যে"
"2646","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2647","আনাস ইবনু মালিক (রাঃ) হতে বর্ণিত আছে"
"2648","। সাখবারা (রাঃ) হতে বর্ণিত আছে"
"2649","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2650","। আবূ হারূন আল-আবদী (রাহঃ) হতে বর্ণিত আছে"
"2651","। আবূ সাঈদ আল-খুদরী (রাঃ) হতে বর্ণিত আছে"
"2652","। আবদুল্লাহ ইবনু আমর ইবনুল আস (রাযিঃ) হতে বর্ণিত"
"2653","। আবূদ দারদা (রাযিঃ) হতে বর্ণিত"
"2654","। কাব ইবনু মালিক (রাযিঃ) হতে বর্ণিত"
"2655","। ইবনু উমার (রাযি.) হতে বর্ণিত আছে। রসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে ব্যক্তি আল্লাহ তা'আলার সন্তুষ্টি অর্জনের উদ্দেশ্য ব্যতীত অন্য কোন উদ্দেশ্যে জ্ঞানার্জন করে অথবা এর দ্বারা আল্লাহ তা'আলার সন্তুষ্টি ব্যতীত অন্য কিছু অর্জনের ইচ্ছা করে সে যেন তার বাসস্থান জাহান্নামে নির্দিষ্ট করে নেয়। (য’ঈফ; ইবনু মাযাহ-হাঃ নং- ২৫৮) এ অনুচ্ছেদে জাবির (রাযি.) হতেও হাদীস বর্ণিত আছে। আবূ ঈসা বলেনঃ এ হাদীসটি হাসান গারীব। উপরিউক্ত সূত্র ব্যতীত আইয়ুবের কোন হাদীস আমাদের জানা নেই।"
"2656","। আবান ইবনু উসমান (রহঃ) হতে বর্ণিত"
"2657","। আবদুল্লাহ ইবনু মাসউদ (রাযিঃ) হতে বর্ণিত"
"2658","। আবদুল্লাহ ইবনু মাসউদ (রাযিঃ) হতে বর্ণিত আছে যে"
"2659","। আবদুল্লাহ ইবনু মাসউদ (রাযিঃ) হতে বর্ণিত"
"2660","। আলী ইবনু আবী তালিব (রাযিঃ) হতে বর্ণিত"
"2661","। আনাস ইবনু মালিক (রাযিঃ) হতে বর্ণিত"
"2662","। মুগীরাহ ইবনু শুবাহ (রাযিঃ) হতে বর্ণিত আছে যে"
"2663","। আবূ রাফি' (রাযিঃ) হতে বর্ণিত"
"2664","। মিকদাম ইবনু মাদীকারিব (রাযিঃ) হতে বর্ণিত"
"2665","। আবূ সাঈদ আল-খুদরী (রাযিঃ) হতে বর্ণিত"
"2666","। আবূ হুরাইরাহ (রাযি.) হতে বর্ণিত আছে। তিনি বলেন"
"2667","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2668","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত। তিনি বলতেন"
"2669","আবদুল্লাহ ইবনু আমর (রাযিঃ) হতে বর্ণিত"
"2670","। আনাস ইবনু মালিক (রাযিঃ) হতে বর্ণিত"
"2671","। আবূ মাসউদ আল-বদরী (রাযিঃ) হতে বর্ণিত আছে যে"
"2672","। আবূ মূসা আল-আশ'আরী (রাযিঃ) হতে বর্ণিত আছে যে"
"2673","। আবদুল্লাহ ইবনু মাসউদ (রাযিঃ) হতে বর্ণিত"
"2674","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2675","। জারীর ইবনু আবদুল্লাহ (রাযিঃ) হতে বর্ণিত"
"2676","। ইরবায ইবনু সারিয়াহ (রাযিঃ) হতে বর্ণিত"
"2677","। কাসীর ইবনু আবদুল্লাহ (রাহঃ) হতে পর্যায়ক্রমে তার পিতা ও দাদার সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বিলাল ইবনুল হারিসকে বলেনঃ তুমি জেনে রাখ। তিনি বললেন"
"2678","। আনাস ইবনু মালিক (রাঃ) বলেন"
"2679","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2680","। আবূ হুরাইরাহ (রাযি.) হতে বর্ণিত আছে। রসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ অচিরেই মানুষ উটে চড়ে ইলম অন্বেষণের উদ্দেশ্যে দুনিয়া ঘুরে বেড়াবে। কিন্তু তারা মদীনার আলিমদের অপেক্ষা বিজ্ঞ আলিম আর কোথাও খুঁজে পাবে না। (য’ঈফ; মিশকাত— হাঃ নং- ২৪৬; তা’লীক 'আলা তানকীল- হাঃ নং- ১/৩৮৫; য’ঈফাহ-হাঃ নং- ৪৮৩৩) আবূ ঈসা বলেনঃ এ হাদীসটি হাসান। এটা ইবনু উয়াইনার রিওয়ায়াত। এ প্রসঙ্গে তিনি আরো বলেনঃ মাদীনার আলিম হলেন মালিক ইবনু আনাস (রাহ.)। ইসহাক ইবনু মূসা বলেনঃ আমি ইবনু উয়াইনাকে আরো বলতে শুনেছি"
"2681","। ইবনু আব্বাস (রাযি.) হতে বর্ণিত আছে। তিনি বলেন"
"2682","। কাইস ইবনু কাসীর (রহঃ) হতে বর্ণিত"
"2683","। ইয়াযীদ ইবনু সালামা (রাঃ) বলেন"
"2684","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2685","। আবূ উমামাহ্ আল-বাহিলী (রাযিঃ) হতে বর্ণিত"
"2686","। আবূ সাঈদ আল-খুদরী (রাঃ) হতে বর্ণিত আছে"
"2687","। আবূ হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"2715","। যাইদ ইবনু সাবিত (রাযিঃ) হতে বর্ণিত"
"2716","। আনাস ইবনু মালিক (রাযিঃ) হতে বর্ণিত আছে যে"
"2717","। ইবনু আব্বাস (রাযিঃ) হতে বর্ণিত"
"2718","। আনাস ইবনু মালিক (রাযিঃ) হতে বর্ণিত"
"2719","। মিক্‌দাদ ইবনুল আসওয়াদ (রাযিঃ) হতে বর্ণিত"
"2720","। ইবনু উমার (রাযিঃ) হতে বর্ণিত"
"2721","। আবূ তামীম আল-হুজাইমী (রাযিঃ) হতে তার বংশের জনৈক ব্যক্তির সূত্রে বর্ণিত"
"2722","। জাবির ইবনু সুলাইম (রাযিঃ) হতে বর্ণিত"
"2723","। আনাস ইবনু মালিক (রাযিঃ) হতে বর্ণিত আছে যে"
"2724","। আবূ ওয়াকিদ আল-লাইসী (রাযিঃ) হতে বর্ণিত আছে যে"
"2725","। জাবির ইবনু সামুরাহ (রাযিঃ) হতে বর্ণিত"
"2726","। বারাআ (রাযিঃ) হতে বর্ণিত আছে যে"
"2727","। বারাআ ইবনু আযিব (রাযিঃ) হতে বর্ণিত"
"2728","। আনাস ইবনু মালিক (রাযিঃ) হতে বর্ণিত"
"2729","। কাতাদাহ্ (রহঃ) হতে বর্ণিত"
"2730","। ইবনু মাসউদ (রাঃ) হতে বর্ণিত আছে"
"2731","। আবূ উমামা (রাঃ) হতে বর্ণিত আছে"
"2732","। আইশা (রাঃ) হতে বর্ণিত আছে"
"2733","। সাফওয়ান ইবনু আসসাল (রাঃ) হতে বর্ণিত আছে"
"2734","। উম্মু হানী (রাযিঃ) হতে বর্ণিত"
"2735","। ইকরিমা ইবনু আবূ জাহল (রাঃ) হতে বর্ণিত আছে"
"2736","। আলী (রাঃ) হতে বর্ণিত আছে"
"2737","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2738","। নাফি’ (রহঃ) হতে বর্ণিত"
"2739","। আবূ মূসা (রাযিঃ) হতে বর্ণিত"
"2740","। সালিম ইবনু উবাইদ (রহঃ) হতে বর্ণিত আছে"
"2741","। আবূ আইয়ূব (রাযিঃ) হতে বর্ণিত আছে যে"
"2742","। আনাস ইবনু মালিক (রাযিঃ) হতে বর্ণিত আছে যে"
"2744","। উমার ইবনু ইসহাক ইবনু আবূ তালহা (রহঃ)-এর নানা বলেন"
"2745","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত আছে যে"
"2746","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত আছে যে"
"2747","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত। তিনি বলেন"
"2748","। আদী ইবনু সাবিত (রহঃ) হতে পালাক্রমে তার পিতা ও তার দাদার সূত্রে মারফু হিসেবে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ নামাযের মধ্যে হাঁচি"
"2749","। ইবনু উমর (রাযিঃ) হতে বর্ণিত আছে যে"
"2750","। ইবনু উমর (রাযিঃ) হতে বর্ণিত"
"2751","। ওয়াহহাব ইবনু হুযাইফাহ্ (রাযিঃ) হতে বর্ণিত আছে যে"
"2752","। আবদুল্লাহ ইবনু আমর (রাযিঃ) হতে বর্ণিত আছে যে"
"2753","। আবূ মিজলায (রহঃ) হতে বর্ণিত আছে"
"2754","। আনাস (রাযিঃ) হতে বর্ণিত"
"2755","। আবূ মিজলায (রহঃ) হতে বর্ণিত"
"2756","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2757","। আয়িশাহ্ (রাযিঃ) হতে বর্ণিত আছে যে"