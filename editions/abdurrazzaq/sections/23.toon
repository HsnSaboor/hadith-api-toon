hadiths[605]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"13311","عَنِ الثَّوْرِيِّ ، عَنِ أشْعَثَ ، عَنِ الشَّعْبِيِّ ، قَالَ :  سُئِلَ عَنِالْقَوْمِ يَشْهَدُونَ أَنَّ فُلانًا لَيْسَ بِابْنِ فُلانٍ ، قَالَ : إِذَا أَثْبَتَ نَسَبَهُ ، فَلَوْ جَاءَ بِمِثْلِ رَبِيعَةَ وَمُضَرَ يَشْهَدُونَ لَمْ يُخْرِجُوهُ مِنْ نَسَبِهِ ""","","","","","Book of Wills"
"13312","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : مَنْ قَذَفَ صَبِيًّا أَوْ صَبِيَّةً ، فَلا حَدَّ عَلَيْهِ ""","","","","","Book of Wills"
"13313","عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ ، قَالَ : لَيْسَ عَلَى قَاذِفِ الصَّبِيِّ وَالصَّبِيَّةِ حَدٌّ ""","","","","","Book of Wills"
"13314","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ :التَّعْرِيضُ ؟ قَالَ : لَيْسَ فِيهِ حَدٌّ , قَالَ هُوَ وَعُمَرُ : "" فِيهِ نَكَالٌ "" ، قَالَ : قُلْتُ لَهُ : "" يُسْتَحْلَفُ مَا أَرَادَ كَذَا وَكَذَا ؟""","","","","","Book of Wills"
"13315","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ ، قَالَ رَجُلٌ لأَخِيهِ إِنَّ ابْنَهُ لَيْسَ بِأَخِي ، قَالَ : لا يُحَدُّ ""","","","","","Book of Wills"
"13316","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ عُمَرَ ،  كَانَيَحُدَّ فِي التَّعْرِيضِ بِالْفَاحِشَةِ ""","","","","","Book of Wills"
"13317","عَنْ مَعْمَرٍ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ ، قَالَ : قَذَفَ رَجُلٌ رَجُلا فِي هِجَاءٍ ، أَوْ عِرْضٍ لَهُ فِيهِ ، فَاسْتَأْدَى عَلَيْهِ عُمَرَ بْنَ الْخَطَّابِ ، فَقَالَ لَهُ : لَمْ أَعْنِ هَذِهِ إِنَّمَا أَرَدْتُ شَيْئًا آخَرَ ، قَالَ الرَّجُلُ : فَيُسَمِّي لَكَ مَنْ عَنَى ، قَالَ عُمَرُ : صَدَقَ ، قَدْ أَقْرَرْتَ عَلَى نَفْسِكَ بِالْقَبِيحِ , أَوْ قَالَ : بِالأَمْرِ الْقَبِيحِ ، فَوَرِّكْهُ عَلَى مَنْ شِئْتَ ، فَلَمْ يَذْكُرْ أَحَدًا فَجَلَدَهُ الْحَدَّ "", أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي ابْنُ أَبِي مُلَيْكَةَ ، عَنْ صَفْوَانَ ، وَأَيُّوبَ ، أَنَّهُ حُدَّ فِي التَّعْرِيضِ ، وَالَّذِي كَانَ يَحُدُّ فِي التَّعْرِيضِ : عُمَرُ بْنُ الْخَطَّابِ , عِكْرِمَةَ بْنَ عَامِرِ بْنِ هَاشِمِ بْنِ عَبْدِ مَنَافِ بْنِ عَبْدِ الدَّارِ , هَجَا وَهْبَ بْنَ زَمْعَةَ بْنَ الأَسْوَدِ بْنِ عَبْدِ الْمُطَّلِبِ بْنِ أَسَدٍ , فَتَعَرَّضَ لَهُ فِي هِجَائِهِ ، قَالَ ابْنُ جُرَيْجٍ : وَسَمِعْتُ ابْنَ أَبِي مُلَيْكَةَ يُحَدِّثُ ذَلِكَ""","","","","","Book of Wills"
"13318","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ،  فِيرَجُلٍ , قَالَ لآخَرَ : "" يَا ابْنَ الْعَبْدِ ، أَوْ أَيُّهَا الْعَبْدُ ، قَالَ : إِنَّمَا عَنَيْتُ عَبْدَ اللَّهِ يُسْتَحْلَفُ بِاللَّهِ مَا أَرَادَ إِلا ذَلِكَ ، وَلا حَدَّ عَلَيْهِ ، وَإِنْ نَكَلَ ، عَنْ ذَلِكَ جُلِدَ ""","","","","","Book of Wills"
"13319","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ،  فِيرَجُلٍ , قَالَ لآخَرَ : يَا ابْنَ الْحَائِكِ ، يَا ابْنَ الْخَيَّاطِ ، يَا ابْنَ الإِسْكَافِ ، يُعَيِّرُهُ بِبَعْضِ الأَعْمَالِ ، قَالَ : يُسْتَحْلَفُ بِاللَّهِ مَا أَرَادَ نَفْيَهُ ، وَمَا عَنَى إِلا عَمَلَ أَبِيهِ ، فَإِنْ حَلَفَ تُرِكَ ، وَإِنْ نَكَلَ حُدَّ ""","","","","","Book of Wills"
"13320","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، قَالَ :  فِيالتَّعْرِيضِ عُقُوبَةٌ ""","","","","","Book of Wills"
"13321","عَنِ الثَّوْرِيِّ ، عَنْ إِبْرَاهِيمَ بْنِ عَامِرِ بْنِ مَسْعُودٍ ، عَنِ ابْنِ الْمُسَيِّبِ ،  أَنَّرَجُلا قَالَ لِرَجُلٍ : "" يَا ابْنَ أَبِي كِرَانَةَ ، قَالَ : يُضْرَبُ الْحَدَّ إِلا أَنْ يُقِيمَ الْبَيِّنَةَ أَنَّهُ لَقَبٌ ""","","","","","Book of Wills"
"13322","عَنِ الثَّوْرِيِّ ، عَنْ إِسْمَاعِيلَ ، عَنِ الشَّعْبِيِّ ،  سُئِلَ عَنْرَجُلٍ قَالَ لِرَجُلٍ : إِنَّكَ الدَّعِيُّ ، قَالَ : لَيْسَ عَلَيْهِ حَدٌّ ، وَلَوْ قَالَ : ادَّعَاكَ سِتَّةٌ لَمْ يَكُنْ عَلَيْهِ حَدٌّ ""","","","","","Book of Wills"
"13323","عَنْ سُفْيَانَ ،  فِيرَجُلٍ قَالَ لِرَجُلٍ : يَا ابْنَ الزِّنْجِيِّ ، قَالَ : يُضْرَبُ إِذَا نَقَلَ نَسَبًا إِلَى نَسَبٍ ""","","","","","Book of Wills"
"13324","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : لَوْ قَالَ رَجُلٌ لآخَرَ : إِنِّي أَرَاكَ زَانِيًا عُزِّرَ ، وَلَمْ يُحَدَّ ، وَالتَّعْرِيضُ كُلُّهُ يُعَزَّرُ فِيهِ ""، فِي قَوْلِ قَتَادَةَ""","","","","","Book of Wills"
"13325","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ :  إِنَّمَاالْحَدُّ عَلَى مَنْ نَصَبَ الْحَدَّ نَصْبًا ""","","","","","Book of Wills"
"13326","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ،  أَنَّهُ سُئِلَ عَنْرَجُلٍ قَالَ لِرَجُلٍ : يَا ابْنَ الْجَزَّارِ ، قَالَ : لَيْسَ بِشَيْءٍ مَا نَعْلَمُ الْحَدَّ إِلا فِي الْقَذْفِ الْبَيِّنِ ، وَالنَّفْيِ الْبَيِّنِ ""","","","","","Book of Wills"
"13327","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ ابْنِ مَسْعُودٍ ، قَالَ : لا حَدَّ إِلا فِي اثْنَتَيْنِ : رَجُلٍ نَفَى مِنْ أَبِيهِ ، أَوْ قَذَفَ مُحْصَنَةً "". عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللَّهِ ، عَنِ الْقَاسِمِ ، عَنِ ابْنِ مَسْعُودٍ مِثْلَهُ""","","","","","Book of Wills"
"13328","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : ، قَالَ زِيَادٌ : مَنْ عَرَّضَ عَرَّضْنَا لَهُ ، وَمَنْ صَرَّحَ صَرَّحْنَا لَهُ ""، قَالَ : وَقَالَ قَتَادَةُ : "" يُعَزَّرُ فِي التَّعْرِيضِ""","","","","","Book of Wills"
"13329","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أُخْبِرْتُ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ ، قَالَ : مَنْ عَرَّضَ عَرَّضْنَا لَهُ بِالسِّيَاطِ ، وَكَانَ يَجْلِدُ فِي التَّعْرِيضِ ""","","","","","Book of Wills"
"13330","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : سَمِعْتُ حَفْصَ بْنَ عُمَرَ بْنِ رَفِيعٍ , يَقُولُ :  كَانَبَيْنَ أَبِي وَبَيْنَ يَهُودِيٍّ مُدَافَعَةٌ فِي الْقَوْلِ فِي شُفْعَةٍ ، فَقَالَ أَبِي لِلْيَهُودِيِّ : يَهُودِيٌّ ابْنُ يَهُودِيٍّ ، فَقَالَ : أَجَلْ ، وَاللَّهِ إِنِّي لَيَهُودِيٌّ ابْنُ يَهُودِيٍّ إِذْ لا يَعْرِفُ رِجَالٌ كَثِيرٌ آبَاءَهُمْ ، فَكَتَبَ عَامِلُ الأَرْضِ إِلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ وَهُوَ عَامِلٌ عَلَى الْمَدِينَةِ بِذَلِكَ فَكَتَبَ : إِنْ كَانَ الَّذِي قَالَ لَهُ ذَلِكَ يُعْرِفُ أَبُوهُ ، فَحُدَّ الْيَهُودِيَّ ، فَضَرَبَهُ ثَمَانِينَ سَوْطًا ""","","","","","Book of Wills"
"13331","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ هِشَامٍ , يَقُولُ : قَالَ رَجُلٌ فِي إِمَارَةِ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ لِرَجُلٍ : إِنَّكَ لَتُسَرِّي عَلَى جَارَاتِكَ ، فَقَالَ : وَاللَّهِ مَا أَرَدْتُ إِلا نَخْلاتٍ كَانَ يَسْرِقُهُنَّ ، فَحَدَّهُ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ ""","","","","","Book of Wills"
"13332","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ رَجُلٌ لِرَجُلٍ : يَا ابْنَ الْمُطَوَّقِ ، فَكَتَبَ فِيهِ هِشَامٌ ، إِلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، فَكَتَبَ : إِنْ لَمْ يَكُنْ أَبُوهُ مُطَوَّقَا فَاحْدُدْهُ ""","","","","","Book of Wills"
"13333","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سُئِلَ ابْنُ شِهَابٍ ، عَنْرَجُلٍ قِيلَ لَهُ : يَا ابْنَ الْقَيْنِ ، وَلَمْ يَكُنْ أَبُوهُ قَيْنًا ، قَالَ :  نَهَى أَنْ يُجْلَدَ الْحَدَّ ""","","","","","Book of Wills"
"13334","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ ابْنِ شِهَابٍ ،  فِيرَجُلٍ قَالَ لِرَجُلٍ : يَا مَوْلًى ، يَا دَعِيُّ ، قَالَ : يُجْلَدُ الْحَدَّ ""","","","","","Book of Wills"
"13335","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ،  فِيرَجُلٍ قَالَ لآخَرَ : "" إِنَّمَا الْتُقِطَتْ أُمُّكَ لَقْطًا ، قَالَ : يُجْلَدُ حَدَّ الْفِرْيَةِ لأَنَّهُ نَفَى امْرَأَةً مِنْ أَبِيهَا ""","","","","","Book of Wills"
"13336","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي يَحْيَى بْنُ سَعِيدٍ ، قَالَ :  إِنَّ رَجُلا فِي زَمَنِ عُمَرَ بْنِ الْخَطَّابِ ، قَالَ لِرَجُلٍ :مَا أُمِّي بِزَانِيَةٍ ، وَلا أَبِي بِزَانٍ ، قَالَ عُمَرُ : مَاذَا تَرَوْنَ ؟ قَالُوا : رَجُلٌ مَدَحَ نَفْسَهُ ، قَالَ : بَلْ هُوَ ، انْظُرُوا ، فَإِنْ كَانَ بِالآخَرِ بَأْسٌ فَقَدْ مَدَحَ نَفْسَهُ ، وَإِنْ لَمْ يَكُنْ بِهِ بَأْسٌ ، فَلِمَ قَالَهَا ؟ فَوَاللَّهِ لأَحُدَّنَّهُ ، فَحَدَّهُ ""","","","","","Book of Wills"
"13337","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللَّهِ ، عَنْ مَكْحُولٍ ، أَنَّ مُعَاذَ بْنَ جَبَلٍ ، وَعَبْدَ اللَّهِ بْنَ عَمْرِو بْنِ الْعَاصِ ، قَالا : لَيْسَ الْحَدُّ إِلا فِي الْكَلِمَةِ الَّتِي لَيْسَ لَهَا مَصْرَفٌ ، وَلَيْسَ لَهَا إِلا وَجْهٌ وَاحِدٌ ""","","","","","Book of Wills"
"13338","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ صَاحِبٍ لَهُ ، عَنِ الضَّحَّاكِ بْنِ مُزَاحِمٍ ، عَنْ عَلِيٍّ ، قَالَ : إِذَا بَلَغَ فِي الْحُدُودِ لَعَلَّ وَعَسَى , فَالْحَدُّ مُعَطَّلٌ ""","","","","","Book of Wills"
"13339","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قَالَ عَطَاءٌ : لا حَدَّ فِي أَنْ يُقَالَ : يَا سَكْرَانُ ، وَلا يَا سَارِقُ ، وَلَكِنْ جَلْدٌ ""","","","","","Book of Wills"
"13340","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ ،قَالَ لآخَرَ ، حَتَّى يَقُولَ :  إِنَّكَ لَتَصْنَعُ بِفُلانٍ ""","","","","","Book of Wills"
"13341","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ،  فِيرَجُلٍ قَالَ لِرَجُلٍ : يَا لُوطِيُّ ، قَالَ : نِيَّتُهُ يُسْأَلُ مَاذَا أَرَادَ بِذَلِكَ ""","","","","","Book of Wills"
"13342","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ،  فِيرَجُلٍ قَالَ لآخَرَ : لَقَدْ جُلِدْتَ فِي الزِّنَا ، قَالَ : يُجْلَدُ ثَمَانِينَ حَدَّ الْفِرْيَةِ ، قَالَ : فَإِنْ قَالَ : جُلِدْتَ حَدًّا فِي الْخَمْرِ ، نُكِّلَ نَكَالا ""","","","","","Book of Wills"
"13343","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ،  فِيرَجُلٍ يَقُولُ لآخَرَ : يَا ابْنَ الْبَرْبَرِيَّةِ ، يَا ابْنَ الْحَبَشِيَّةِ ، وَأُمُّهُ عَرَبِيَّةٌ ، قَالَ : لَيْسَ عَلَيْهِ جَلْدٌ ، قَالَ : فَإِنْ قَالَ : يَا ابْنَ فُلانٍ لِغَيْرِ أَبِيهِ الَّذِي يُدْعَى لَهُ ضُرِبِ الْحَدَّ ""","","","","","Book of Wills"
"13344","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ ،  فِيرَجُلٍ قَالَ لِرَجُلٍ : يَا لُوطِيُّ ، قَالا : لا يُحَدُّ ""","","","","","Book of Wills"
"13345","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ،  فِيرَجُلٍ قَالَ لآخَرَ : مَا أُمُّكَ فُلانَةَ ، قَالَ : لا يُحَدُّ حَتَّى يَنْفِيَهِ مِنْ أُمِّهِ هَذِهِ كَذْبَةً ""","","","","","Book of Wills"
"13346","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ،  فِيرَجُلٍ قَالَ لِرَجُلٍ : لَسْتَ بِابْنِ فُلانَةَ ، قَالَ : لَيْسَ بِشَيْءٍ ""","","","","","Book of Wills"
"13347","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ،  فِيرَجُلٍ قَالَ : هُوَ زَانٍ إِنْ لَمْ يَفْعَلْ كَذَا وَكَذَا ، ثُمَّ لَمْ يَفْعَل ، قَالَ : أَرَى أَنْ يُضْرَبَ حَدًّا ""","","","","","Book of Wills"
"13348","عَنِ الثَّوْرِيِّ ، عَنْ إِسْمَاعِيلَ ، عَنِ الشَّعْبِيِّ ،  أَنَّهُ سُئِلَ عَنْرَجُلٍ , قَالَ لِرَجُلٍ عَرَبِيٍّ : يَا نَبَطِيُّ ، قَالَ : كُلُّنَا نَبَطِيٌّ لَيْسَ فِي هَذَا حَدٌّ ""","","","","","Book of Wills"
"13349","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قَالَ عَطَاءٌ : لا حَدَّ فِي أَنْ يُقَالَ : يَا سَكْرَانُ ، وَلا يَا سَارِقُ ، وَلَكِنْ جَلْدٌ ""","","","","","Book of Wills"
"13350","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي سُلَيْمَانُ بْنُ مُوسَى ، عَنْ رَجَاءِ بْنِ حَيْوَةَ ، قَالَ :  اسْتَقَامَ سُلَيْمَانُ بِنَا فِي خِلافَتِهِ ، وَمَعَهُ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ , فَقَالَ : كَيْفَ تَقُولُونَ فِي رَجُلٍ قَالَ لِرَجُلٍ : يَا شَارِبَ الْخَمْرِ ؟ قَالَ : قُلْنَا يُحَدُّ ، قَالَ عُمَرُ : سُبْحَانَ اللَّهِ ،مَا الْحَدُّ إِلا عَلَى مَنْ قَذَفَ مُسْلِمًا ""","","","","","Book of Wills"
"13351","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ ، قَالا : إِذَا قَالَ : يَا سَارِقُ ، يَا مُنَافِقُ ، يَا كَافِرُ ، يَا شَارِبَ الْخَمْرِ ، قَالَ : فِي هَذَا كُلِّهُ تَعْزِيرٌ ""","","","","","Book of Wills"
"13352","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : إِذَا قَالَ رَجُلٌ لآخَرَ : إِنَّ فُلانًا يَزْعُمُ أَنَّكَ زَانٍ ، قَالَ : يُسْأَلُ فُلانٌ عَنْ ذَلِكَ ، فَإِنْ أَقَرَّ ، وَإِلا عُزِّرَ الَّذِي بَلَّغَهُ ""","","","","","Book of Wills"
"13353","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : رَجُلٌ قَالَ لِرَجُلٍ : إِنَّ فُلانَا يَقُولُ : إِنَّكَ زَانٍ ، قَالَ : إِنْ جَاءَ بِبَيِّنَةٍ عَلَى أَنَّ ذَلِكَ قَدْ قَالَهُ ، فَلَيْسَ عَلَيْهِ شَيْءٌ إِلا أَنَّهُ بِئْسَ مَا مَشَى بِهِ ، وَإِنْ لَمْ يَأْتِ عَلَى ذَلِكَ بِبَيِّنَةٍ جُلِدَ الْمُبَلِّغُ "". وَقَالَ رَجُلٌ مِنْ أَهْلِ الْكُوفَةِ ، وَنَحْنُ مَعَ عَطَاءٍ ، إِنَّ أَهْلَ الْكُوفَةِ يَرَوْنَ إِذَا شَهِدَ أَرْبَعَةٌ عَلَى رَجُلٍ بِالزِّنَا ، فَتَقَدَّمَ أَحَدُهُمْ إِلَى الإِمَامِ , يَقُولُونَ : هُوَ بِمَنْزِلَةِ خَصْمٍ ، وَلا يَجْعَلُونَهُ شَاهِدًا ، وَإِنْ أَتَوْا مَرَّةً وَاحِدَةً جَازَتْ شَهَادَتُهُمْ ، فَوَافَقَهُمْ عَلَى ذَلِكَ عَطَاءٌ ، قَالَ ابْنُ جُرَيْجٍ وَأَقُولُ : أَنَا وَشَأْنُ الْمُغِيرَةِ""","","","","","Book of Wills"
"13354","عَنِ ابْنِ جُرَيْجٍ ، قَالَ :  بَلَغَنِي عَنْ عَمْرِو بْنِ الْعَاصِ وَهُوَ أَمِيرُ مِصْرَ ، قَالَ لِرَجُلٍ مِنْ تُجِيبُ يُقَالُ لَهُ قَنْبَرَةُ :يَا مُنَافِقُ ، قَالَ : فَأتَى عُمَرَ بْنَ الْخَطَّابِ ، فَكَتَبَ عُمَرُ إِلَى عَمْرٍو : إِنْ أَقَامَ الْبَيِّنَةَ عَلَيْكَ جَلَدْتُكَ تِسْعِينَ "" ، فَنَشَدَ النَّاسَ ، فَاعْتَرَفَ عَمْرٌو حِينَ شَهِدَ عَلَيْهِ زَعَمُوا أَنَّ عُمَرَ , قَالَ لِعَمْرٍو : أَكْذِبْ نَفْسَكَ عَلَى الْمِنْبَرِ ، فَفَعَلَ ، فَأَمْكَنَ عَمْرٌو قَنْبَرَةَ مِنْ نَفْسِهِ ، فَعَفَا عَنْهُ للَّهِ عَزَّ وَجَلَّ""","","","","","Book of Wills"
"13355","عَنْ إِبْرَاهِيمَ ، عَنْ دَاوُدَ بْنِ الْحُصَيْنِ ، عَنْ أَبِي سُفْيَانَ : مَنْ قَالَ لِرَجُلٍ : يَا مُخَنَّثُ ، فَاضْرِبُوهُ عِشْرِينَ ""","","","","","Book of Wills"
"13356","أَخْبَرَنَا إِبْرَاهِيمُ ، عَنْ دَاوُدَ بْنِ الْحُصَيْنِ ، عَنْ أَبِي سُفْيَانَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ قَالَ لِرَجُلٍ مِنَ الأَنْصَارِ يَا يَهُودِيُّ ، فَاضْرِبُوهُ عِشْرِينَ ""","","","","","Book of Wills"
"13357","عَنْ عَبْدِ اللَّهِ بْنِ كَثِيرٍ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، قَالَ : حَدَّثَنَا أَبُو سَلَمَةَ ، عَنْ أَبِي نَضْرَةَ ، عَنْ سِنَانِ بْنِ سَلَمَةَ بْنِ مُحَبِّقٍ ،   وَكَانَ سَلَمَةُ قَدْ أَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :قَالَ رَجُلٌ لِرَجُلٍ : يَا لُوطِيُّ ، فَرُفِعَ ذَلِكَ إِلَى سِنَانِ بْنِ سَلَمَةَ , فَقَالَ : نِعْمَ الرَّجُلُ أَنْتَ إِنْ كُنْتَ مِنْ قَوْمِ لُوطٍ ""","","","","","Book of Wills"
"13358","قَالَ سُفْيَانَ ،  فِيرَجُلٍ قَالَ لِرَجُلٍ : زَنَيْتَ فِي الشِّرْكِ ، قَالَ : يُضْرَبُ الْحَدَّ إِلا أَنْ يَأْتِيَ بِالْبَيِّنَةِ , لأَنَّهُ إِنَّمَا قَذَفَهُ حِينَئِذٍ ، وَإِنْ قَالَ : زَنَيْتَ وَأَنْتَ مَمْلُوكٌ ضُرِبَ الْحَدَّ ، فَإِنْ قَالَ : زَنَيْتَ وَأَنْتَ صَبِيٌّ لَمْ يُضْرَبْ , لأَنَّ الصَّبِيِّ لا يَزْنِي ""","","","","","Book of Wills"
"13359","عَنْ سُفْيَانَ ،  فِيرَجُلٍ قَالَ لامْرَأَةٍ كَانَتْ أَمَةً ، ثُمَّ عُتِقَتْ قَدْ زَنَيْتِ ، وَأَنْتِ أَمَةٌ ، قَالَ : يُسْأَلُ الْبَيِّنَةَ عَنْ ذَلِكَ ، وَإِلا ضُرِبَ الْحَدَّ لأَنَّهُ إِنَّمَا قَذَفَهَا وَهِيَ حُرَّةٌ ""","","","","","Book of Wills"
"13360","قَالَ سُفْيَانُ ،  فِي الَّذِي يَقُولُ : زَنَيْتُ بِفُلانَةٍ ، قَالَ : تُسْأَلُ ، فَإِنْ أَنْكَرَتْ ضُرِبَ الْحَدَّ بِقَذْفِهِ إِيَّاهَا ، ثُمَّ قِيلَ لَهُ :إِنْ شَهِدْتَ عَلَى نَفْسِكَ أَرْبَعَ شَهَادَاتٍ أَقَمْنَا عَلَيْكَ الْحَدَّ ، وَإِنْ لَمْ تَشْهَدْ لَمْ نُقِمْ عَلَيْكَ الْحَدَّ ""","","","","","Book of Wills"
"13361","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : رَجُلٌ قَالَ لامْرَأَةٍ كَانَتْ أَمَةً ثُمَّ عُتِقَتْ : قَدْ زَنَيْتِ ، وَأَنْتِ بَيِّعَةٌ ، فَلَمْ يَأْتِ بِبَيِّنَةٍ عَلَى ذَلِكَ ، قَالَ : يُجْلَدُ إِذَا قَالَ ذَلِكَ ، وَلَمْ يَأْتِ عَلَيْهِ بِبَيِّنَةٍ , قِيلَ لَهُ : فَكَانَتْ قَدْ زَنَتْ وَهِيَ أَمَةٌ ، قَالَ : فَلا حَدَّ ""","","","","","Book of Wills"
"13362","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : رَجُلٌ قَالَ لِرَجُلٍ أَرْبَعَ مَرَّاتٍ : قَدْ زَنَيْتَ بِفُلانَةٍ ، وَسَمَّاهَا ، قَالَ : يُجْلَدُ مِائَةً إِنْ كَانَ بِكْرًا ، وَيُنْفَى سَنَةً ، وَيُرْجَمُ إِنْ كَانَ ثَيِّبًا ، قُلْتُ : أَفَلا يُحَدُّ بِمَا قَالَ ؟ قَالَ : حَسْبُهُ حَدٌّ وَاحِدٌ ، قُلْتُ : فَإِنَّهُمْ يَقُولُونَ : لا تُحَدُّ هِيَ ، وَلا بُدَّ إِنْ صَدَّقَتْهُ عَلَى نَفْسِهِ صَدَّقَتْهُ عَلَيْهَا ، قَالَ : بَلْ أُصَدِّقُهُ عَلَى نَفْسِهِ ، وَلا أُصَدِّقُهُ عَلَيْهِا ""","","","","","Book of Wills"
"13363","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ،  فِيامْرَأَةٍ قَذَفَتْ رَجُلا بِنَفْسِهَا , أَنَّهُ غَلَبَهَا عَلَى نَفْسِهَا ، وَالرَّجُلُ يُنْكِرُ ذَلِكَ ، وَلَيْسَ لَهَا بَيِّنَةٌ ، قَالَ : تُضْرَبُ حَدَّ الْفِرْيَةِ ""، قَالَ مَعْمَرٌ : وَقَالَ الزُّهْرِيُّ أَيْضًا""","","","","","Book of Wills"
"13364","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ،  فِيرَجُلٍ قَالَ لامْرَأَتِهِ : قَدْ زَنَيْتُ بِكِ قَبْلَ أَنْ أَتَزَوَّجَكِ ، قَالَ : يُجْلَدُ الْحَدَّ ""","","","","","Book of Wills"
"13365","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ،  فِيالرَّجُلِ يَقُولُ : زَنَيْتُ بِفُلانةٍ ، قَالَ : إِنِ اسْتَقَامَ عَلَى قَوْلِهِ أُقِيمَ عَلَيْهِ حَدُّ الْفِرْيَةِ ، وَحَدُّ الزِّنَا ""","","","","","Book of Wills"
"13366","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : عَلَى الَّذِي يُشِيعُ الْفَاحِشَةَ نَكَالٌ ، وَإِنْ صَدَقَ ""","","","","","Book of Wills"
"13367","قَالَ سُفْيَانُ :  فِيالرَّجُلِ يُجْلَدُ الْحَدَّ ، فَيَقُولُ لَهُ رَجُلٌ : يَا زَانٍ ، قَالَ : يُسْتَحَبُّ الدَّرْأُ بِعُذْرٍ ، وَمِنَّا مَنْ يَقُولُ : إِذَا أُقِيمَ عَلَيْهِ الْحَدُّ جُلِدَ مِنْ قَذَفَهُ ، وَمَنْ لَمْ يَجْلِدْهُ ابْنُ أَبِي لَيْلَى ""","","","","","Book of Wills"
"13368","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : سُئِلَ ابْنُ الْمُسَيِّبِ ،  عَنِالرَّجُلِ يُصِيبُ الْحَدَّ ، ثُمَّ يُعَيِّرُهُ بِهِ رَجُلٌ بَعْدَ ذَلِكَ ، قَالَ : إِنْ كَانَ قَدْ أُونِسَ مِنْهُ تَوْبَةٌ , عُزِّرَ الَّذِي عَيَّرَهُ ""","","","","","Book of Wills"
"13369","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ،  فِيرَجُلٍ قَالَ لِرَجُلٍ : يَا زَانٍ ، وَلامْرَأَةٍ يَا زَانِيَةُ ، وَقَدْ كَانَا حُدَّا قَبْلَ ذَلِكَ ، قَالا : يُنَكَّلُ بِأَذَاهُمَا لِحُرْمَةِ الْمُسْلِمِ ""، ذَكَرَهُ عَنِ ابْنِ الْمُسَيِّبِ""","","","","","Book of Wills"
"13370","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، قَالَ : لا يُؤَجَّلُ فِي الْحُدُودِ إِلا قَدْرَ مَا يُقَوِّمُ الْقَاضِي ""","","","","","Book of Wills"
"13371","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مِسْعَرٍ ، عَنِ أَبِي عَوْنٍ ، قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : أَيُّمَا رَجُلٍ شَهِدَ عَلَى حَدٍّ ، لَمْ يَكُنْ بِحَضْرَتِهِ ، فَإِنَّمَا ذَلِكَ عَنْ ضِغْنٍ ""","","","","","Book of Wills"
"13372","عَنِ الثَّوْرِيِّ ، عَنْ جَبَّارٍ ، وَمُطَرِّفٍ ، ، عَنِ الشَّعْبِيِّ ، قَالَ : لا تَجُوزُ شَهَادَةُ رَجُلٍ عَلَى شَهَادَةٍ فِي حَدٍّ ، وَلا يُكْفُلُ فِي حَدٍّ ""","","","","","Book of Wills"
"13373","عَنْ إِسْرَائِيلَ ، عَنْ جَابِرٍ ، وَعَنْ عَامِرٍ ، قَالَ : كَانَ شُرَيْحٌ ، وَمَسْرُوقٌ : لا يُجِيزَانِ شَهَادَةً عَلَى شَهَادَةٍ فِي حَدٍّ ، وَلا يُكْفُلانِ صَاحِبَ حَدٍّ ""","","","","","Book of Wills"
"13374","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالَ : إِذَا افْتَرَى عَلَيْهِمْ جَمِيعًا , فَحُدٌّ وَاحِدٌ ""","","","","","Book of Wills"
"13375","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سَأَلْتُ عَطَاءً ،  عَنْرَجُلٍ افْتَرَى عَلَى جَمَاعَةٍ ، قَالَ : حَدٌّ وَاحِدٌ ""","","","","","Book of Wills"
"13376","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ : إِنَّهُ سَأَلَ طَاوُسًا ، قَالَ : قُلْتُ لَهُ : رَجُلٌ دَخَلَ عَلَى أَهْلِ بَيْتٍ فَقَذَفَهُمْ ، قَالَ : حَدٌّ وَاحِدٌ ""","","","","","Book of Wills"
"13377","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : إِذَا افْتَرَى رَجُلٌ عَلَى جَمَاعَةٍ فَحَدٌّ وَاحِدٌ ""","","","","","Book of Wills"
"13378","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : إِنْ قَذَفَهُمْ جَمِيعًا ، فَحَدٌّ وَاحِدٌ ، وَإِنْ جَاءُوا مُجْتَمِعِينَ أَوْ مُفْتَرِقِينَ ""","","","","","Book of Wills"
"13379","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ :  قَالَ فِيقَوْلِ وَاحِدٍ : يَا فُلانُ ، أَنْتَ لَبَغِيَّةٌ ، قَالَ : حَدٌّ وَاحِدٌ ، قَالَ ابْنُ جُرَيْجٍ : وَأَقُولُ أَنَا : حَدَّانِ ، قُلْتُ لِعَطَاءٍ : فَحَلَفَ عَلَى أُمُورٍ شَتَّى فِي قَوْلٍ وَاحِدٍ فَحَنَثَ ؟ قَالَ : كَفَّارَتَانِ ""","","","","","Book of Wills"
"13380","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : إِذَا افْتَرَى عَلَى جَمَاعَةٍ سَمَّى كُلَّ إِنْسَانٍ بِاسْمِهِ ، حُدَّ لِكُلِّ إِنْسَانٍ مِنْهُمْ حَدًّا ""","","","","","Book of Wills"
"13381","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، قَالَ : قُلْتُ لِطَاوُسٍ : لَقِيَ نَاسًا فُرَادَى فَقَذَفَهُمْ ؟ قَالَ : حَدٌّ وَاحِدٌ ""","","","","","Book of Wills"
"13382","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : افْتَرَى عَلَى إِنْسَانٍ ، ثُمَّ خَرَجَ فَلَقِيَ إِنْسَانًا آخَرَ ، فَافْتَرَى عَلَيْهِ ، قَالَ : حَدَّانِ ""","","","","","Book of Wills"
"13383","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، عَنْ أَصْحَابِ ابْنِ مَسْعُودٍ ، أَنَّهُمْ يَقُولُونَ : إِنِ افْتَرَى رَجُلٌ عَلَى رَجُلٍ ، ثُمَّ مَكَثَ ، ثُمَّ افْتَرَى عَلَى آخَرَ ، فَإِنَّمَا هُوَ حَدٌّ وَاحِدٌ مَا لَمْ يُحَدَّ ""","","","","","Book of Wills"
"13384","عَنِ الثَّوْرِيِّ ، عَنْ سُلَيْمَانَ الشَّيْبَانِيِّ ، وَجَابِرٍ ، وَفِرَاسٍ ، كُلِّهِمْ ، عَنِ الشَّعْبِيِّ ،  فِيالرَّجُلِ يَقْذِفُ الْقَوْمَ جَمِيعًا ، قَالَ : إِنْ فَرَّقَ ضُرِبَ لِكُلِّ إِنْسَانٍ مِنْهُمْ ، وَإِنْ جَمَعَ فَحَدٌّ وَاحِدٌ "". عَنِ الثَّوْرِيِّ ، عَنْ إِبْرَاهِيمَ ، مِثلَ قَوْلِ الشَّعْبِيِّ عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ ، مِثْلَ قَوْلِ الشَّعْبِيِّ""","","","","","Book of Wills"
"13385","قَالَ الثَّوْرِيُّ : وَضَرَبَ ابْنُ أَبِي لَيْلَى امْرَأَةً , حُدُودًا فِي مَجَالِسَ , ثَلاثَةَ حُدُودٍ أَوْ أَرْبَعَةً ""","","","","","Book of Wills"
"13386","أَخْبَرَنَا مَعْمَرٌ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، قَالَ : إِذَا جَاءُوا جَمِيعًا فَحَدٌّ وَاحِدٌ ، وَإِنْ جَاءُوا مُتَفَرِّقِينَ حُدَّ لِكُلِّ إِنْسَانٍ مِنْهُمْ لِحِدَةٍ "". أَخْبَرَنَا مَعْمَرٌ ، وَابْنُ جُرَيْجٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ مِثْلَهُ ، وَزَادَ فِيهِ قَالَ : وَقَالَ عُرْوَةُ : وَالسَّارِقُ كَذَلِكَ""","","","","","Book of Wills"
"13387","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، جَلَدَ الْحَدَّ رَجُلا , فِي أُمِّ رَجُلٍ هَلَكَتْ فِي الْجَاهِلِيَّةِ قَذَفَهَا ""","","","","","Book of Wills"
"13388","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ،  أَنَّرَجُلا قَالَ لِرَجُلٍ : يَا ابْنَ ذَاتِ الرَّايَةِ ، وَكَانَتْ أُمُّهُ هَلَكَتْ فِي الْجَاهِلِيَّةِ ، فَقَالَ لَهُ مَرْوَانُ : لَتَأْتِيَنَّ بِالْبَيِّنَةِ أَنَّهَا كَانَتْ ذَاتَ رَايَةٍ ، وَإِلا جَلَدْتُكَ ، فَلَمْ يَأْتِ بِبَيِّنَةٍ ، فَجَلَدَهُ مِنْ أَجْلِ إِنَّهُ كَانَ , يُقَالُ لِلْبَغِيِّ : ذَاتُ الرَّايَةِ ""","","","","","Book of Wills"
"13389","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : إِذَا كَانَ لَهَا وَلَدٌ مُسْلِمٌ جُلِدَ قَاذِفُهَا لِحُرْمَةِ الْمُسْلِمِ ""","","","","","Book of Wills"
"13390","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ :  كَانَ أَبُو بَكْرٍ وَمَنْ بَعْدَهُ مِنَ الْخُلَفَاءِيَجْلِدُونَ مَنْ دَعَا أُمَّ رَجُلٍ زَانِيَةً ، وَإِنْ كَانَتْ يَهُودِيَّةً أَوْ نَصْرَانِيَّةً لِحُرْمَةِ الْمُسْلِمِ، حَتَّى أُمِّرَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ عَلَى الْمَدِينَةِ ، فَلَمْ يَكُنْ سَمِعَ فِي ذَلِكَ بِشَيْءٍ ، فَاسْتَشَارَ فِي ذَلِكَ ، فَقَالَ لَهُ عَبْدُ اللَّهِ بْنُ عُبَيْدِ اللَّهِ بْنِ عُمَرَ بْنِ الْخَطَّابِ : لا نَرَى أَنْ تَحُدَّ مُسْلِمًا فِي كَافِرٍ ، فَتَرَكَ الْحَدَّ بَعْدَ ذَلِكَ الْيَوْمِ ""","","","","","Book of Wills"
"13391","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي يَحْيَى بْنُ الْمُغِيرَةِ ،  أَنَّ مَخْرَمَةَ بْنَ نَوْفَلٍافْتَرَى عَلَى أُمِّ رَجُلٍ فِي الْجَاهِلِيَّةِ ، فَقَالَ : أَنَا صَنَعْتُ بِأُمِّكَ فِي الْجَاهِلِيَّةِ ، وَإِنَّ عُمَرَ بْنَ الْخَطَّابِ بَلَغَهُ ذَلِكَ ، فَقَالَ : لا يَعُدْ لَهَا أَحَدٌ بَعْدَ ذَلِكَ ""","","","","","Book of Wills"
"13392","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ،  فِيرَجُلٍ قَذَفَ نَصْرَانِيَّةً تَحْتَ مُسْلِمٍ ، قَالَ : يُنَكَّلَ وَلا يُحَدُّ ، وَقَالَ : إِنِ افْتَرَى عَلَى مُشْرِكٍ ، فَعُقُوبَةٌ وَلا حَدٌّ ""","","","","","Book of Wills"
"13393","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي سَلَمَةَ ،  أَنَّرَجُلا عَيَّرَ رَجُلا بِفَاحِشَةٍ عَمِلَتْهَا أُمُّهُ فِي الْجَاهِلِيَّةِ ، فَرُفِعَ ذَلِكَ إِلَى عُمَرَ بْنِ الْخَطَّابِ ، فَقَالَ : لا حَدَّ عَلَيْهِ ""","","","","","Book of Wills"
"13394","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : إِنِ افْتَرَى عَبْدٌ عَلَى حُرٍّ جُلِدَ أَرْبَعِينَ , أَحْصَنَ بِنِكَاحِ حُرَّةٍ ، أَوْ لَمْ يُحْصَنْ ، قُلْتُ : فَإِنَّهُمْ يَقُولُونَ : يُجْلَدُ ثَمَانِينَ ، فَأَنْكَرَ ذَلِكَ ، وَتَلا :  وَالَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ ثُمَّ لَمْ يَأْتُوا بِأَرْبَعَةِ شُهَدَاءَ فَاجْلِدُوهُمْ ثَمَانِينَ جَلْدَةً وَلا تَقْبَلُوا لَهُمْ شَهَادَةً أَبَدًا , وَلا شَهَادَةَ لِعَبْدٍ ""","","","","","Book of Wills"
"13395","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى ،  عَنْرَجُلٍ انْطَلَقَ إِلَى عَبْدِ الْمَلِكِ ، يَسْأَلُهُ عَنْ أَشْيَاءَ قَدْ سَمَّاهَا لِي ، فَعَرَضَ عَبْدُ الْمَلِكِ عَلَى قَبِيصَةَ الْكِتَابَ فِيهِ : الْعَبْدُ يَفْتَرِي عَلَى الْحُرِّ ، فَقَالَ قَبِيصَةُ : يُجْلَدُ ثَمَانِينَ ""","","","","","Book of Wills"
"13396","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سَمِعْتُ جَعْفَرَ بْنَ مُحَمَّدِ بْنِ عَلِيٍّ ، يُحَدِّثُ عَنْ أَبِيهِ إِنَّهُ أَخْبَرَهُ ، عَنْ عَلِيِّ بْنِ أَبِي طَالِبٍ ،  إِنَّهُضَرَبَ عَبْدًا افْتَرَى عَلَى حُرٍّ أَرْبَعِينَ ""، عَنِ الثَّوْرِيِّ ، عَنْ جَعْفَرٍ ، عَنِ أَبِيهِ ، عَنْ عَلِيٍّ مِثْلَهُ""","","","","","Book of Wills"
"13397","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عُمَرُ بْنُ عَطَاءٍ ، عَنْ عِكْرِمَةَ مَوْلَى ابْنِ عَبَّاسٍ ، إِنَّهُ كَانَ يَقُولُ : حَدُّ الْعَبْدِ يَفْتَرِي عَلَى الْحُرِّ أَرْبَعُونَ ""","","","","","Book of Wills"
"13398","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ ، قَالَ : إِنِ افْتَرَى عَبْدٌ عَلَى حُرٍّ جُلِدَ أَرْبَعِينَ ""","","","","","Book of Wills"
"13399","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ : يُجْلَدُ أَرْبَعِينَ "". قَالَ مَعْمَرٌ : وَمَا رَأَيْتُ عَامَّتَهُمْ , إِلا يَقُولُونَ ذَلِكَ""","","","","","Book of Wills"
"13400","عَنِ الثَّوْرِيِّ ، عَنْ ذَكْوَانَ ، عَنْ عَبْدِ اللَّهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ ، قَالَ : أَدْرَكْتُ عُمَرَ ، وَعُثْمَانَ ،  وَمَنْ بَعْدَهُمْ مِنَ الْخُلَفَاءِ :لا يَضْرِبُونَ الْمَمْلُوكَ فِي الْقَذْفِ إِلا أَرْبَعِينَ ""","","","","","Book of Wills"
"13401","عَنْ مَالِكٍ ، عَنْ أَبِي الزِّنَادِ ،  أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ ، ""جَلَدَ عَبْدًا فِي فِرْيَةٍ ثَمَانِينَ ""، قَالَ : أَبُو الزِّنَادِ ، فَسَأَلْتُ عَبْدَ اللَّهِ بْنَ عَامِرٍ عَنْ ذَلِكَ ؟ فَقَالَ : أَدْرَكْتُ عُمَرَ وَالْخُلَفَاءَ هَلُمَّ جَرَّا ، "" فَمَا رَأَيْتُ أَحَدًا ضَرَبَ فِي الْفِرْيَةِ أَكْثَرَ مِنْ أَرْبَعِينَ""","","","","","Book of Wills"
"13402","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ،  فِيالْعَبْدِ يَفْتَرِي عَلَى الْحُرِّ ، قَالَ : يُجْلَدُ ثَمَانِينَ ""","","","","","Book of Wills"
"13403","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : رَجُلٌ افْتَرَى عَلَى عَبْدٍ أَوْ أمَةٍ ، قَالَ : لا حَدَّ ، وَلا نَكَالَ ، وَلا شَيْءَ ، وَإِنْ نَكَحَتِ الأَمَةُ حُرًّا ، فَكَذَلِكَ لَيْسَ عَلَى مَنْ قَذَفَ أَمَةً ، أَوْ نَصْرَانِيَّةً تَحْتَ مُسْلِمٍ حُدَّ , إِلا أَنْ يُعَاقِبَهُ السُّلْطَانُ , إِلا أَنْ يَرَى ذَلِكَ ""","","","","","Book of Wills"
"13404","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ،  فِيرَجُلٍ افْتَرَى عَلَى عَبْدٍ ، أَوْ أَمَةٍ ، قَالَ : يُعَزَّرُ ""","","","","","Book of Wills"
"13405","عَنْ مَعْمَرٍ ، قَالَ : سَأَلْتُ الزُّهْرِي ،  عَنِالرَّجُلِ يَقْذِفُ رَجُلا وَهُوَ سَكْرَانُ ، قَالَ : يُحَدُّ حَدَّ الْفِرْيَةِ ، وَحَدَّ السُّكْرِ ""","","","","","Book of Wills"
"13406","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ،  أَنَّ أَمِيرًا مِنَ الأُمَرَاءِ سَأَلَ ابْنَ عُمَرَ ، عَنْرَجُلٍ قَذَفَ أُمَّ وَلَدٍ لِرَجُلٍ ، قَالَ : يُضْرِبُ الْحَدَّ صَاغِرًا ""","","","","","Book of Wills"
"13407","عَنْ عُمَرَ بْنِ رَاشِدٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ عِكْرِمَةَ ، قَالَ : سُئِلَ ابْنُ عُمَرَ ، عَنْقَاذِفِ أُمِّ الْوَلَدِ ، فَقَالَ ابْنُ عُمَرَ : يُسْأَلُ عَنْهَا ، فَإِنْ كَانَ لا يُطْعَنُ عَلَيْهَا حُدَّ قَاذِفُهَا ""","","","","","Book of Wills"
"13408","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، وَالشَّعْبِيِّ ، قَالا : يُضْرَبُ قَاذِفُ أُمِّ الْوَلَدِ "", قَالَ الثَّوْرِيُّ : وَقَالَ غَيْرُهُ ، عَنِ الشَّعْبِيِّ : "" إِذَا نَفَى ابْنَ أُمِّ الْوَلَدِ مِنْ نَسَبِهِ ، فَقَالَ : لَسْتَ لأَبِيكَ , ضُرِبَ""","","","","","Book of Wills"
"13409","عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، قَالَ : إِذَا قَالَ الرَّجُلُ لابْنِ أُمِّ الْوَلَدِ : لَسْتَ بِابْنِ فُلانٍ ، فَأَخْرَجَهُ مِنْ نَسَبِهِ , جُلِدَ الْحَدَّ ، وَإِنْ كَانَتْ أُمُّهُ لَمْ تَمُتْ ""","","","","","Book of Wills"
"13410","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قَالَ لِي ابْنُ شِهَابٍ :  فِيأُمِّ الْوَلَدِ تَزْنِي ، وَسُئِلَ أَيَبِيعُهَا سَيِّدُهَا ؟ قَالَ : لا يَصْلُحُ لَهُ أَنْ يَبِيعَهَا , وَلَكِنْ يُقَامُ عَلَيْهَا حَدُّ الأَمَةِ ""","","","","","Book of Wills"
"13411","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، قَالَ : إِذَا قَالَ رَجُلٌ لِرَجُلٍ أُمُّهُ أُمُّ وَلَدٍ أَوْ نَصْرَانِيَّةٌ : لَسْتَ لأَبِيكَ , لَمْ يُضْرَبْ , لأَنَّ النَّفْيَ إِنَّمَا وَقَعَ عَلَى الأُمِّ ، وَلَوْ أَنَّ رَجُلا قَالَ لِرَجُلٍ : لَسْتَ مِنْ بَنِي تَمِيمٍ , لَمْ يُضْرَبْ لأَنَّ النَّفْيَ إِنَّمَا وَقَعَ عَلَى مُشْرِكٍ ""، وَقَالَ الْحَكَمُ بْنُ عُتَيْبَةَ : "" يُضْرَبُ""","","","","","Book of Wills"
"13412","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ :  أَرَادَ عُبَيْدُ اللَّهِ بْنُ زِيَادٍ ، "" أَنْيَضْرِبَ قَاذِفَ أُمِّ وَلَدٍ ، فَلَمْ يُتَابِعْهُ عَلَى ذَلِكَ أَحَدٌ ""","","","","","Book of Wills"
"13413","أَخْبَرَنَا ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : إِنِ افْتَرَى الأَبُ عَلَى ابْنِهِ ، فَلا يُحَدُّ ""","","","","","Book of Wills"
"13414","قَالَ : وَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : تَعَافَوْا فِيمَا بَيْنَكُمْ ، فَمَا بَلَغَنِي مِنْ حَدٍّ فَقَدْ وَجَبَ ""","","","","","Book of Wills"
"13415","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : إِذَا بَلَغَتِ الْحُدُودُ السُّلْطَانَ ، فَلا يَحِلُّ لأَحَدٍ أَنْ يَعْفُوَ عَنْهَا ""، عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ شِهَابٍ مِثْلَهُ""","","","","","Book of Wills"
"13416","عَنِ الثَّوْرِيِّ ، عَمَّنْ سَمِعَ الْحَسَنَ ، وَعَطَاءً ، يقولان : لَيْسَ عَلَى الأَبِ لابْنِهِ حَدٌّ ""","","","","","Book of Wills"
"13417","عَنِ الثَّوْرِيِّ ، عَنْ لَيْثٍ ، عَنْ مُجَاهِدٍ ، قَالَ : لا يُقَادُ وَالِدٌ مِنْ وَلَدِهِ ""","","","","","Book of Wills"
"13418","عَنِ الثَّوْرِيِّ ، عَنْ خَالِدٍ الْحَذَّاءِ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ ، دَفَعَ رَجُلا إِلَى ابْنِهِ ""","","","","","Book of Wills"
"13419","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي رُزَيْقٌ صَاحِبُ أَيْلَةَ ، إِنَّهُ كَتَبَ إِلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ،  فِيرَجُلٍ افْتَرَى عَلَى ابْنِهِ ، فَكَتَبَ : بِحَدِّ الأَبِ إِلا أَنْ يَعْفُوَ عَنْهُ ابْنُهُ ""","","","","","Book of Wills"
"13420","عَنِ ابْنِ عُيَيْنَةَ ، قَالَ : أَخْبَرَنِي رُزَيْقٌ ، قَالَ : قَذَفَ رَجُلٌ ابْنَهُ عِنْدِي ، فَأَرَدْتُ أَنْ أَحُدَّهُ ، فَقَالَ : إِنْ أَنْتَ حَدَدْتَ أَبِي اعْتَرَفْتُ ، فَمَا أَدْرِ كَيْفَ أَصْنَعُ , فَكَتَبْتُ فِيهِ إِلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ , فَكَتَبَ : أَنْ حُدَّهُ إِلا أَنْ يَعْفُوَ عَنْهُ ""","","","","","Book of Wills"
"13421","عَنْ سُفْيَانَ ،  فِيالأَبِ يَفْتَرِي عَلَى ابْنِهِ ، أَمَّا الابْنُ فَلا يُشَكُّ إِنَّهُ يُحَدُّ لأَبِيهِ ، وَأَمَّا الأَبُ فَإِنَّهُمْ يَسْتَحِبُّونَ الدَّرْأَ ""","","","","","Book of Wills"
"13422","قَالَ سُفْيَانُ ،  فِيالْمَرْأَةِ تَزْنِي ، وَتَقْتُلُ وَلَدَهَا وَلَمْ تُحَصَّنْ ، قَالَ : يُدْرَأُ عَنْهَا الْحَدُّ ""","","","","","Book of Wills"
"13423","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ ابْنُ عُمَرَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ، قَالَ : لا عَفْوَ عَنِ الْحُدُودِ عَنْ شَيْءٍ مِنْهَا بَعْدَ أَنْ يَبْلُغَ الإِمَامَ ، فَإِنَّ إِقَامَتَهَا مِنَ السُّنَّةِ ""","","","","","Book of Wills"
"13424","عَنْ مَعْمَرٍ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ ، قَالَ : أَخْبَرَنِي رُزَيْقٌ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ ،  كَتَبَ إِلَيْهِ فِيرَجُلٍ قَذَفَ ابْنَهُ : أَنِ اجْلِدْهُ إِلا أَنْ يَعْفُوَ ابْنُهُ عَنْهُ ، قَالَ : فَظَنَنْتُ أَنَّهَا لِلأَبِ خَاصَّةً ، فَكَتَبْتُ إِلَيْهِ , فَقَالَ : أَنَّهَا لِلنَّاسِ عَامَّةً ""","","","","","Book of Wills"
"13425","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ،  أَنَّ عُتْبَةَ بْنَ أَبِي وَقَّاصٍ ، قَالَ لأَخِيهِ سَعْدٍ : أَتَعْلَمُ أَنَّ وَلَدَ جَارِيَةِ زَمْعَةَ ابْنِي ؟ قَالَتْ عَائِشَةُ : فَلَمَّا كَانَ يَوْمُ الْفَتْحِ رَأَى سَعْدٌ الْغُلامَ فَعَرَفَهُ بِالشَّبَهِ ، فَاعْتَنَقَهُ إِلَيْهِ ، قَالَ ابْنُ أَخِي : وَرَبِّ الْكَعْبَةِ ، فَجَاءَهُ عَبْدُ بْنُ زَمْعَةَ ، فَقَالَ : بَلْ هُوَ أَخِي وُلِدَ عَلَى فِرَاشِ أَبِي مِنْ جَارِيَتِهِ ، فَانْطَلَقَا إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ سَعْدٌ : يَا رَسُولَ اللَّهِ ، ابْنُ أَخِي انْظُرْ إِلَى شَبَهِهِ بِعُتْبَةَ ، فَقَالَ عَبْدُ بْنُ زَمْعَةَ : بَلْ هُوَ أَخِي وُلِدَ عَلَى فِرَاشِ أَبِي مِنْ جَارِيَتِهِ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :الْوَلَدُ لِلْفِرَاشِ , وَاحْتَجِبِي مِنْهُ يَا سَوْدَةَ ""، قَالَتْ عَائِشَةُ : فَوَاللَّهِ مَا رَآهَا حَتَّى مَاتَ ، أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنِ ابْنِ شِهَابٍ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ نَحْوَهُ""","","","","","Book of Wills"
"13426","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاهِدٍ ، عَنِ ابْنِ الزُّبَيْرِ ،  أَنَّ زَمْعَةَ كَانَتْلَهُ جَارِيَةً ، وَكَانَ يَتَّطِئُهَا وَكَانُوا يَتَّهِمُونَهَا ، فَوَلَدَتْ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِسَوْدَةَ : أَمَّا الْمِيرَاثُ فَلَهُ ، وَأَمَّا أَنْتِ فَاحْتَجِبِي مِنْهُ يَا سَوْدَةُ لَيْسَ لَكِ بِأَخٍ ""","","","","","Book of Wills"
"13427","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ، وَأَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : الْوَلَدُ لِلْفِرَاشِ ، وَلِلْعَاهِرِ الْحَجَرُ ""","","","","","Book of Wills"
"13428","عَنْ سُفْيَانَ ،  فِيالرَّجُلَيْنِ يَتَنَازَعَانِ فِي الْوَلَدِ , وُلِدَ عَلَى فِرَاشِ أَحَدِهِمَا ، فَقَالَ : هُوَ لِلَّذِي فِي يَدِهِ إِذَا وَضَعَتْ فِي سِتَّةِ أَشْهُرٍ ، فَإِنْ كَانَ دُونَ سِتَّةِ أَشْهُرٍ فَهُوَ لِلأَوَّلِ ، إِلا أَنْ يَكُونَ يَوْمًا وَاحِدًا أَوْ يَوْمَيْنِ ، هَذَا فِي الرَّجُلِ يَبِيعُ الْجَارِيَةَ مِنَ الرَّجُلِ ""","","","","","Book of Wills"
"13429","عَنْ سُفْيَانَ ،  فِيالْوَلَدِ يَدَّعِيهِ الرَّجُلانِ , يَرِثُ مِنْ كُلِّ وَاحِدٍ مِنْهُمَا نَصِيبَ ذَكَرٍ تَامٍّ ، وَهُمَا جَمِيعًا يَرِثَانِهِ السُّدُسَ ، فَإِذَا مَاتَ أَحَدُهُمَا فَهُوَ لِلْبَاقِي مِنْهُمَا ، وَمَنْ نَفَاهُ مِنْ أَحَدِهِمَا لَمْ يُضْرَبْ ، حَتَّى يَنْفِيَهُ مِنْهُمَا جَمِيعًا ، فَإِذَا صَارَ لِلْبَاقِي مِنْهُمَا ، فَإِنَّهُ يَرِثُ إِخْوَتَهُ مِنَ الْمَيِّتِ ، وَلا يَرِثُونَهُ حَجَبَهُ أَبُوهُ هَذَا الْحَيُّ عَنْ أَنْ يَرِثَهُ الإِخْوَةُ مِنَ الْمَيِّتِ وَيَرِثُهُمْ هُوَ ، لأَنَّهُ أَخُوهُمْ وَيَكُونُ مِيرَاثُهُ لِلْبَاقِي وَعَقْلُهُ عَلَيْهِ ، فَإِذَا مَاتَ الآخَرُ مِنَ الأَبَوَيْنِ صَارَ عَقْلُهُ وَمِيرَاثُهُ لإِخْوَتِهِ مِنَ الأَبَوَيْنِ جَمِيعًا ""","","","","","Book of Wills"
"13430","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ , قَالَتْ :  اخْتَصَمَ سَعْدُ بْنُ أَبِي وَقَّاصٍ ، وَعَبْدُ بْنُ زَمْعَةَ فِي غُلامٍ ، فَقَالَ سَعْدٌ : يَا رَسُولَ اللَّهِ ، أَخِي عُتْبَةُ بْنُ أَبِي وَقَّاصٍ عَهِدَ إِلَيَّ إِنَّهُ ابْنَهُ ، انْظُرْ إِلَى شَبَهِهِ ، قَالَ عَبْدُ بْنُ زَمْعَةَ : هَذَا أَخِي يَا رَسُولَ اللَّهِ وُلِدَ عَلَى فِرَاشِ أَبِي مِنْ وَلِيدَتِهِ ، قَالَ : فَنَظَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى شَبَهِهِ ، فَرَأَى شَبَهًا بَيِّنًا بِعُتْبَةَ ، فَقَالَ : هُوَ لَكَ يَا عَبْدُ ،الْوَلَدُ لِلْفِرَاشِ ، وَلِلْعَاهِرِ الْحَجَرُ ، وَاحْتَجِبِي مِنْهُ يَا سَوْدَةُ بِنْتُ زَمْعَةَ ""، قَالَتْ : فَلَمْ يُرَ سَوْدَةُ قَطُّ""","","","","","Book of Wills"
"13431","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : رَجُلٌ وُجِدَ يَأْكُلُ لَحْمَ الْخِنْزِيرِ ، وَقَالَ : أَشْتَهِيهِ ، أَوْ مَرَّتْ بِهِ بَدَنَةٌ فَنَحَرَهَا ، وَقَدْ عَلِمَ أَنَّهَا بَدَنَةٌ ، أَوِ امْرَأَةٌ أَفْطَرَتْ فِي رَمَضَانَ ، فَقَالَتْ أَنَا حَائِضٌ ، فَنَظَرَ إِلَيْهَا النِّسَاءُ فَإِذَا هِيَ غَيْرُ حَائِضٍ ، أَوْ رَجُلٌ وَاقَعَ امْرَأَتَهُ فِي رَمَضَانَ ، أَوْ أَصَابَ امْرَأَتَهُ حَائِضًا ، أَوْ قَتَلَ صَيْدًا فِي الْحَرَمِ مُتَعَمِّدًا ، أَوْ شَرِبَ خَمْرًا ، أَوْ تَرَكَ بَعْضَ الصَّلاةِ فَذَكَرْتُهُنَّ لَهُ ، فَقَالَ : مَا كَانَ اللَّهُ نَسِيًّا لَوْ شَاءَ جَعَلَ فِي ذَلِكَ شَيْئًا يُسَمِّيهِ ، مَا سَمِعْتُ فِي ذَلِكَ بِشَيْءٍ ، ثُمَّ رَجَعَ إِلَى , أَنْ قَالَ : إِنْ فَعَلَ ذَلِكَ مَرَّةً ، فَلَيْسَ عَلَيْهِ شَيْءٌ ، فَإِنْ عَاوَدَ ذَلِكَ فَلْيُنَكَّلَ ، وَذَكَرَ الرَّجُلَ الَّذِي قَبَّلَ الْمَرْأَةَ ، وَأَقُولُ : الَّذِي أَصَابَ أَهْلَهُ فِي رَمَضَانَ ""","","","","","Book of Wills"
"13432","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : إِذَا أَكَلَ لَحْمَ الْخِنْزِيرِ , عُرِضَتْ عَلَيْهِ التَّوْبَةُ ، فَإِنْ تَابَ , وَإِلا قُتِلَ ""","","","","","Book of Wills"
"13433","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ،  فِيرَجُلٍ أَفْطَرَ فِي شَهْرِ رَمَضَانَ ، قَالَ : إِذَا كَانَ فَاسِقًا مِنَ الْفُسَّاقِ نُكِّلَ نَكَالا مُوجِعًا ، وَيُكَفِّرُ أَيْضًا ، وَإِنْ كَانَ يَفْعَلُ ذَلِكَ انْتِحَالَ دِينٍ غَيْرِ الإِسْلامِ عُرِضَتْ عَلَيْهِ التَّوْبَةُ ""","","","","","Book of Wills"
"13434","عَنِ الثَّوْرِيِّ ،  فِيأَكْلِ لَحْمِ الْخَنْزِيرِ ، قَالَ : لَيْسَ فِيهِ حَدٌّ ، وَلا يُعَزَّرُ ""","","","","","Book of Wills"
"13435","أَخْبَرَنَا إِسْرَائِيلُ بْنُ يُونُسَ ، عَنْ سِمَاكِ بْنِ حَرْبٍ ، إِنَّهُ سَمِعَ إِبْرَاهِيمَ , يُحَدِّثُ عَنْ عَلْقَمَةَ ، وَالأَسْوَدِ ، عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ ، قَالَ :  جَاءَ رَجُلٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللَّهِ ! إِنِّيأَخَذْتُ امْرَأَةً فِي الْبُسْتَانِ ، فَفَعَلْتُ بِهَا كُلَّ شَيْءٍ غَيْرَ أَنِّي لَمْ أُجَامِعْهَا ، قَبَّلْتُهَا وَلَزِمْتُهَا وَلَمْ أَفْعَلْ غَيْرَ ذَلِكَ ، فَافْعَلْ بِي مَا شِئْتَ ، قَالَ : فَلَمْ يَقُلْ لَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ شَيْئًا : فَذَهَبَ الرَّجُلُ ، فَقَالَ عُمَرُ : لَقَدْ سَتَرَ اللَّهُ عَلَيْهِ لَوْ سَتَرَ عَلَى نَفْسِهِ ، فَأَتْبَعَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَصَرَهُ ، ثُمَّ قَالَ : رُدُّوهُ عَلَيَّ ، فَرُدُّوهُ ، فَقَرَأَ عَلَيْهِ :  وَأَقِمِ الصَّلاةَ طَرَفَيِ النَّهَارِ  ، حَتَّى بَلَغَ لِلذَّاكِرِينَ ، قَالَ : فَقَالَ مُعَاذُ بْنُ جَبَلٍ أَلَهُ وَحْدَهَ يَا نَبِيَّ اللَّهِ ، أَمْ لِلنَّاسِ كَافَّةً ؟ قَالَ : بَلْ لِلنَّاسِ كَافَّةً ""","","","","","Book of Wills"
"13436","عَنْ مَعْمَرٍ ، عَنْ سُلَيْمَانَ التَّيْمِيِّ ، عَنْ أَبِي عُثْمَانَ النَّهْدِيِّ ، أحْسَبُهُ عَنِ ابْنِ مَسْعُودٍ ، قَالَ : قَبَّلَ رَجُلٌ امْرَأَةً فَجَاءَ عُمَرَ بْنَ الْخَطَّابِ ، فَذَكَرَ لَهُ إِنَّهُ كَانَ يَسْأَلُهُ عَنْ كَفَّارَتِهِ ؟ فَقَالَ عُمَرُ : أَمُعْزِبَةٌ هِيَ ؟ فَقَالَ : نَعَمْ ، فَقَالَ عُمَرُ : لا أَدْرِي , يُقَالُ : جَاءَ الرَّجُلُ أَبَا بَكْرٍ فَذَكَرَ لَهُ أَيْضًا ، فَرَدَّ عَلَيْهِ كَمَا رَدَّ عَلَيْهِ ، فَجَاءَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَسْأَلُهُ ، فَقَالَ : أَمُعْزِبَةٌ هِيَ ؟ قَالَ : نَعَمْ ، قَالَ : فَصَمَتَ عَنْهُ ، فَأَنْزَلَ اللَّهُ عَزَّ وَجَلَّ :  وَأَقِمِ الصَّلاةَ طَرَفَيِ النَّهَارِ  إِلَى لِلذَّاكِرِينَ ""","","","","","Book of Wills"
"13437","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ يَحْيَى بْنِ جَعْدَةَ ،  أَنَّ رَجُلا مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ,ذَكَرَ امْرَأَةً وَهُوَ جَالِسٌ مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَاسْتَأْذَنَهُ لِحَاجَةٍ ، فَأَذِنَ لَهُ ، فَذَهَبَ فِي طَلَبِهَا ، فَلَمْ يَجِدْهَا ، فَأَقْبَلَ الرَّجُلُ يُرِيدُ أَنْ يُبَشِّرَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالْمَطَرِ ، فَوَجَدَ الْمَرْأَةَ جَالِسَةً عَلَى غَدِيرٍ فَدَفَعَ فِي صَدْرِهَا ، فَجَلَسَ بَيْنَ رِجْلَيْهَا ، فَصَارَ ذَكَرُهُ مِثْلَ الْهُدْبَةِ ، فَقَامَ نَادِمًا ، فَأَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَأَخْبَرَهُ بِمَا صَنَعَ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : اسْتَغْفِرْ رَبَّكَ ، وَصَلِّ أَرْبَعَ رَكَعَاتٍ ، ثُمَّ قَرَأَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  وَأَقِمِ الصَّلاةَ طَرَفَيِ النَّهَارِ ""","","","","","Book of Wills"
"13438","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ بَيَانٍ ، عَنْ قَيسِ بْنِ أَبِي حَازِمٍ ، قَالَ :  جَاءَرَجُلٌ يُبَايِعُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَقَدْ كَانَ حَدَّثَ امْرَأَةً بِالأَمْسِ ، قَالَ : فَبَايَعَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِكَفِّهِ ، أَوْ قَالَ : بِأَطْرَافِ أَصَابِعِهِ ، وَقَالَ : أَنْتَ صَاحِبُ الْحَدِيثِ بِالأَمْسِ ""","","","","","Book of Wills"
"13439","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ،  أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَدَخَلَ عَلَيْهَا مَسْرُورًا تَبْرُقُ أَسَارِيرُ وَجْهِهِ ، فَقَالَ : أَلَمْ تَسْمَعِي مَا قَالَ مُجَزِّرٌ الْمُدْلَجِيُّ لِزَيْدٍ ، وَأُسَامَةَ ؟ وَرَأَى أَقْدَامَهُمَا ، فَقَالَ : إِنَّ هَذِهِ الأَقْدَامَ بَعْضُهَا مِنْ بَعْضٍ ""، عَنِ ابْنِ عُيَيْنَةَ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ نَحْوَهُ ، وَزَادَ فِيهِ : "" وَهُمَا فِي قَطِيفَةٍ قَدْ غَطَّيَا رُءُوسَهُمَا ، وَبَدَتْ أَقْدَامُهُمَا ، وَلَمْ يَذْكُرْ بَرِيقَ أَسَارِيرِ وَجْهِهِ""","","","","","Book of Wills"
"13440","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ عَنْ زِيَادٍ ، قَالَ :  كُنْتُ مَعَ ابْنِ عَبَّاسٍ ، فَجَاءَهُ رَجُلٌ أَظُنُّهُ مِنْ بَنِي كُرْزٍ ،فَرَأَى ابْنَ عَبَّاسٍ يَسُبُّ الْغُلامَ ، وَأُمَّهُ تَتَنَاوِلُهُ ، فَقَالَ : إِنَّهُ لابْنُكَ ، قَالَ : فَدَعَاهُ ابْنُ عَبَّاسٍ وَحَمَلَ أُمَّهُ عَلَى رَاحِلَتِهِ ، وَكَانَ ابْنُ عَبَّاسٍ انْتَفَى مِنْهُ ""","","","","","Book of Wills"
"13441","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ , قَالَتْ :  دَخَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَيْهَا مَسْرُورًا ، فَقَالَ :أَلَمْ تَسْمَعِي مَا قَالَ الْمُدْلَجِيُّ ، وَرَأَى أُسَامَةَ وَزَيْدًا نَائِمَيْنِ فِي ثَوْبٍ وَاحِدٍ أَوْ فِي قَطِيفَةٍ قَدْ خَرَجَتْ أَقْدَامُهُمَا ، فَقَالَ : إِنَّ هَذِهِ الأَقْدَامَ بَعْضُهَا مِنْ بَعْضٍ ""","","","","","Book of Wills"
"13442","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ :  رَأَى عُمَرُ بْنُ الْخَطَّابِ رَجُلا ، فَقَالَ :مِمَّنْ أَنْتَ ؟ فَقَالَ : مَنْ بَنِي فُلانٍ ، قَالَ : هَلْ لَكَ مِنْ نَسَبٍ بِنَجْرَانَ ؟ ، قَالَ : لا ، قَالَ عُمَرُ : بَلَى ، قَالَ الرَّجُلُ : لا ، قَالَ عُمَرُ : أُذَكِّرُ اللَّهَ رَجُلا كَانَ يَعْرِفُ لِهَذَا الرَّجُلِ نَسَبًا بِنَجْرَانَ ، إِلا أَخْبَرْنَاهُ ، فَقَالَ رَجُلٌ : أَنَا أَعْرِفُهُ يَا أَمِيرَ الْمُؤْمِنِينَ , وَلَدَتْهُ امْرَأَةٌ مِن أَهْلِ نَجْرَانَ ، فَقَالَ عُمَرُ : مَهُ ، إِنَّا نَقُوفُ الآثَارَ ""","","","","","Book of Wills"
"13443","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ :  أَخْبَرَنِي أَنَّ رَجُلا حَدَّثَهُ إِنَّهُجَاءَ إِلَى أَهْلِهِ ، وَقَدِ الْتَقَطُوا مَنْبُوذًا ، فَذُهِبَ بِهِ إِلَى عُمَرَ فَذُكِرَ لَهُ , فَقَالَ عُمَرُ : عَسَى الْغُوَيْرُ أَبْؤُسًا ، كَأَنَّهُ اتَّهَمَهُ ، فَقَالَ الرَّجُلُ : مَا الْتَقَطُوهُ إِلا وَأَنَا غَائِبٌ ، وَسَأَلَ عَنْهُ عُمَرُ ، فَأُثْنِيَ عَلَيْهِ خَيْرًا ، فَقَالَ لَهُ عُمَرُ : فَوَلاؤُهُ لَكَ ، وَنَفَقَتُهُ عَلَيْنَا مِنْ بَيْتِ الْمَالِ ""، عَنِ ابْنِ عُيَيْنَةَ مِثْلَهُ إِلا , إِنَّهُ قَالَ : حَدَّثَنِي الزُّهْرِي ، عَنْ سُنَيْنٍ أَبِي جَمِيلَةَ""","","","","","Book of Wills"
"13444","عَنْ مَعْمَرٍ ، عَنِ ابْنِ شِهَابٍ ، قَالَ : حَدَّثَنِي أَبُو جَمِيلَةَ ،  إِنَّهُوَجَدَ مَنْبُوذًا عَلَى عَهْدِ عُمَرَ بْنِ الْخَطَّابِ ، فَأَتَاهُ فَاتَّهَمَهُ ، فَأُثْنِي عَلَيْهِ خَيْرًا ، فَقَالَ عُمَرُ : هُوَ حُرٌّ ، وَوَلاؤُهُ لَكَ ، وَنَفَقَتُهُ مِنْ بَيْتِ الْمَالِ ""","","","","","Book of Wills"
"13445","عَنِ الثَّوْرِيِّ ، عَنْ زُهَيْرِ بْنِ أَبِي ثَابِتٍ ، عَنْ ذُهْلِ بْنِ أَوْسٍ ، عَنْ تَمِيمٍ ، إِنَّهُ وَجَدَ لَقِيطًا ، فَأَتَى بِهِ إِلَى عَلِيٍّ ، فَأَلْحَقَهُ عَلِيٌّ عَلَى مِئَةٍ ""","","","","","Book of Wills"
"13446","عَنِ الثَّوْرِيِّ ، عَنِ الشَّعْبِيِّ ، وَإِبْرَاهِيمَ ،  فياللقيط ، قَالا : "" هُوَ حُرٌّ ""","","","","","Book of Wills"
"13447","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ،  فِيالرَّجُلِ عِنْدَ اللَّقِيطِ ، ثُمَّ يُنْفِقُ عَلَيْهِ ، قَالَ : لَيْسَ لَهُ مِنْ نَفَقَتِهِ شَيْءٌ ، إِنَّمَا هُوَ شَيْءٌ احْتُسِبَ بِهِ عَلَيْهِ ""","","","","","Book of Wills"
"13448","عَنْ أَبِي حَنِيفَةَ عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ : لَوْ أَنَّ رَجُلا الْتَقَطَ وَلَدَ زِنًا ، فَأَرَادَ أَنْ يُنْفِقَ عَلَيْهِ وَهُوَ لَهُ عَلَيْهِ دَيْنٌ ، فَلْيُشْهِدْ ، وَإِنْ كَانَ يُرِيدُ أَنْ يَحْتَسِبَ عَلَيْهِ ، فَلا يُشْهِدْ ""، قَالَ أَبُو حَنِيفَةَ : وَأَقُولُ أَنَا : "" لَيْسَ لَهُ شَيْءٌ , إِلا أَنْ يَفْرِضَ عَلَيْهِ السُّلْطَانُ""","","","","","Book of Wills"
"13449","عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنِ الْحَكَمِ ،  أَنَّامْرَأَةً الْتَقَطَتْ صَبِيًّا ، فَأَنْفَقَتْ عَلَيْهِ ، ثُمَّ جَاءَتْ شُرَيْحًا تَطْلُبُ نَفَقَتَهَا ، فَقَالَ : لا لَكِ ، وَوَلاؤُهُ لَكِ ""، قَالَ سُفْيَانُ فِي مِيرَاثِ اللَّقِيطِ : "" عَنِ أَصْحَابِهِ فِي بَيْتِ الْمَالِ""","","","","","Book of Wills"
"13450","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ :  إِنَّمَاوَلَدُ الزِّنَا الَّذِي يُلْتَقَطُ إِمَّا حُرٌّ ، وَإِمَّا عَبْدُ قَوْمٍ ، فَلا يُسْتَرَقُّ حُرٌّ ، وَلا عَبْدُ قَوْمِ آخَرِينَ ، فَهُوَ يُنْكِرُ أَنْ يُسْتَرَقَّ ""، وَعَمْرُو بْنُ دِينَارٍ قَالَ ذَلِكَ""","","","","","Book of Wills"
"13451","أَخْبَرَنَا مَعْمَرٌ ، قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ ،  عَنْوَلَدِ الزِّنَا يُلْتَقَطُ ؟ قَالَ : هُوَ حُرٌّ ""، قَالَ ابْنُ جُرَيْجٍ : "" وَأَعْتَقَهُمْ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ فِي خِلافَتِهِ بِأَرْضِنَا""","","","","","Book of Wills"
"13452","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، عَنِ ابْنِ شِهَابٍ ،  أَنَّوَلَدَ زِنًا ، فَقَالَ عُمَرُ : رَجُلا الْتَقَطَ ، اسْتَرْضِعْهُ وَلَكَ وَلاؤُهُ ، وَرَضَاعُهُ مِنْ بَيْتِ الْمَالِ ""","","","","","Book of Wills"
"13453","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَعَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ،  فِيالَّذِي يَدِّعِي الْوَلَدَ مِنَ الأَمَةِ ، أَوِ الْحُرَّةِ ، لا يُنَازِعُهُ فِيهِ أَحَدٌ ، قَالا : لا يَرِثُهُ ، إِنَّهُ كَانَ سِفَاحًا ""","","","","","Book of Wills"
"13454","عَنِ الثَّوْرِيِّ ، عَنْ جَبَّارٍ ، عَنِ الشَّعْبِيِّ ، قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : لا يَجُوزُ دَعْوَاهُ وَلَدَ الزِّنَا فِي الإِسْلامِ ""","","","","","Book of Wills"
"13455","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ عَهَرَ بِامْرَأَةٍ حُرَّةٍ ، أَوْ بِأَمَةِ قَوْمٍ ، فَالْوَلَدُ وَلَدُ زِنًا لا يَرِثُ ، وَلا يُورَثُ ""","","","","","Book of Wills"
"13456","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَعْقُوبَ بْنِ عَطَاءٍ ، قَالَ : سَمِعْتُ عَمْرَو بْنَ شُعَيْبٍ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ عَهَرَ بِأَمَةِ قَوْمٍ ، أَوْ زَنَى بِامْرَأَةٍ حُرَّةٍ ، فَالْوَلَدُ وَلَدُ زِنًا لا يَرِثُ ، وَلا يُورَثُ ""","","","","","Book of Wills"
"13457","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : سَأَلْتُ ابْنَ طَاوُسٍ :  كَيْفَ كَانَ أَبُوكَ , يَقُولُ فِيوَلَدِ الزِّنَا ؟ يعتقه سيده ، ثم يستلحقه أبوه ، ويخلي مواليه بينه وبين أبيه ؟ قَالَ : كَانَ يَقُولُ : لا يَرِثُ ""","","","","","Book of Wills"
"13458","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سُئِلَ عَطَاءٌ ،  عَنْوَلَدَتْهُ أَمَةٌ ، فَأَعْتَقَهُ سَادَةُ الأُمِّ ، ثُمَّ إِنَّ أَبَاهُ اسْتَلْحَقَهُ ، وَعَرَفَ مَوَالِيَهِ إِنَّهُ ابْنُهُ ، ثُمَّ مَاتَ ، أَيَرِثُهُ أَبُوهُ ؟ قَالَ : وَلَدِ الزِّنَا : نَعَمْ ""، وَعَمْرُو بْنُ دِينَارٍ عَنْ مَعْمَرٍ ، أَوْ غَيْرِهِ يُحَدِّثُ عَنِ الْحَسَنِ ، مِثْلَ قَوْلِ عَطَاءٍ""","","","","","Book of Wills"
"13459","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : إِنْ عَرَفَ مَوَالِيهِ إِنَّهُ ابْنُهُ فَخَاصَمُوهُ فِي مِيرَاثِهُ ، قَالَ : يَرِثُهُ أَبُوهُ إِذَا عَرَفُوا إِنَّهُ ابْنُهُ ، وَلَكِنْ إِنْ أَنْكَرُوا إِنَّهُ ابْنُهُ كَانَ مِيرَاثُهُ لَهُمْ ""","","","","","Book of Wills"
"13460","قَالَ سُفْيَانُ :  فِيمِيرَاثِ اللَّقِيطِ عَنْ أَصْحَابِهِ , إِنَّهُ قَالَ : فِي بَيْتِ الْمَالِ ""","","","","","Book of Wills"
"13461","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، وَمَعْمَرٌ ، قَالا : أَخْبَرَنَا ابْنُ طَاوُسٍ ،  أَنَّ أَبَاهُ كَانَ يَقُولُ : "" فِيمَعَادِ وَلَدِ الزِّنَا قَوْلا شَدِيدًا ""","","","","","Book of Wills"
"13462","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمِ بْنِ أَبِي الْجَعْدِ ، عَنْ جَابَانَ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا يَدْخُلُ الْجَنَّةَ عَاقٌّ لِوَالِدَيْهِ ، وَلا مُدْمِنُ خَمْرٍ ، وَلا مَنَّانٌ ، وَلا وَلَدُ زِنًا ""","","","","","Book of Wills"
"13463","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ ،  كَانَتْإِذَا قِيلَ لَهَا : هُوَ شَرُّ الثَّلاثَةِ ، عَابَتْ ذَلِكَ ، وَقَالَتْ : مَا عَلَيْهِ مِنْ وِزْرِ أَبَوَيْهِ ، قَالَ اللَّهُ :  وَلا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى ""","","","","","Book of Wills"
"13464","عَنِ الثَّوْرِيِّ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ , قَالَتْ : مَا عَلَيْهِ مِنْ وِزْرِ أَبَوَيْهِ ؟ قَالَ اللَّهُ :  وَلا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى ""","","","","","Book of Wills"
"13465","عَنْ أَبِي مَعْشَرٍ , عَنْ مُحَمَّدِ بْنِ كَعْبٍ ، عَنْ مَيْمُونِ بْنِ مِهْرَانَ ،  إِنَّهُ شَهِدَ ابْنَ عُمَرَ ،صَلَّى عَلَى وَلَدِ زِنًا ، فَقَالَ لَهُ : إِنَّ أَبَا هُرَيْرَةَ لَمْ يُصِلِّ عَلَيْهِ ، وَقَالَ : هُوَ شَرُّ الثَّلاثَةِ ، فَقَالَ لَهُ ابْنُ عُمَرَ : هُوَ خَيْرُ الثَّلاثَةِ ""","","","","","Book of Wills"
"13466","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي حَازِمٌ ، عَنْ عِكْرِمَةَ مَوْلَى ابْنِ عَبَّاسٍ ، إِنَّهُ قَالَ : هُوَ خَيْرُ الثَّلاثَةِ لِلابْنِ ""","","","","","Book of Wills"
"13467","أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، قَالَ :  كَانَأَبُو وَلَدِ زِنًا قَدْ عُرِفَ ذَلِكَ يُكْثِرُ أَنْ يَمُرَّ بِالنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَيَقُولُ النَّاسُ : هُوَ رَجُلُ سُوءٍ ! فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : هُوَ خَيْرُ الثَّلاثَةِ لِلأَبِ ، فَحَوَّلَهُ النَّاسُ , فَقَالُوا : الْوَلَدُ هُوَ شَرُّ الثَّلاثَةِ""","","","","","Book of Wills"
"13468","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، قَالَ : قَالَ عُمَرُ : لا تَجُوزُ دَعْوَةٌ لِوَلَدِ الزِّنَا فِي الإِسْلامِ ""","","","","","Book of Wills"
"13469","عَنِ ابْنِ التَّيْمِيِّ ، قَالَ : حَدَّثَنَا خَالِدٌ الرَّبَعِيُّ ، قَالَ :  وَكَانَ عِنْدَنَا مِثْلُ وَهْبٍ عِنْدَكُمْ فِي بَعْضِ الْكُتُبِ , إِنَّهُ قَرَأَ فِي بَعْضِ الْكُتُبِ : أَنَّوَلَدَ الزِّنَا لا يَدْخُلُ الْجَنَّةَ إِلَى سَبْعَةٍ ، فَخَفَّفَ اللَّهُ عَنْ هَذِهِ الأُمَّةِ ، فَجَعَلَهَا إِلَى خَمْسَةِ آبَاءٍ ""","","","","","Book of Wills"
"13470","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : بَلَغَنِي ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، كَانَ يَقُولُ : لأَنْ أُحْمَلَ عَلَى نَعْلَيْنِ فِي سَبِيلِ اللَّهِ أَحَبُّ إِلَيَّ مِنْ أَنْ أَعْتِقَ وَلَدَ الزِّنَا ""","","","","","Book of Wills"
"13471","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : كَانَ عَطَاءٌ ، يَأْمُرُ بِعَتَاقَتِهِ ، وَكَفَالَتِهِ يَعْنِي وَلَدَ الزِّنَا""","","","","","Book of Wills"
"13472","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّ الزُّبَيْرَ بْنَ مُوسَى بْنِ مِينَاءَ أَخْبَرَهُ ، أَنَّ أُمَّ صَالِحٍ بِنْتَ عَلْقَمَةَ بْنِ الْمُرْتَفِعِ أَخْبَرَتْهُ ، أَنَّهَا سَأَلَتْ عَائِشَةَ أُمَّ الْمُؤْمِنِينَ ،  عَنْعِتْقِ أَوْلادِ الزِّنَا ؟ فَقَالَتْ : أَعْتِقُوهُمْ وَأَحْسِنُوا إِلَيْهِمْ ""، عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنِ الزُّبَيْرِ بْنِ مُوسَى ، عَنْ أُمِّ حَكِيمِ بِنْتِ طَارِقٍ ، عَنْ عَائِشَةَ مِثْلَهُ""","","","","","Book of Wills"
"13473","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَمْرٌو أَيْضًا ، أَنَّ سُلَيْمَانَ بْنَ يَسَارٍ ، أَخْبَرَهُ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ،  كَانَيُوصِي بِأَوْلادِ الزِّنَا خَيْرًا ""","","","","","Book of Wills"
"13474","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ،  كَانَيَعْتِقُ وَلَدَ الزِّنَا , يَتَطَوَّعُ بِهِ ""","","","","","Book of Wills"
"13475","عَنْ عُبَيْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ ، أَعْتَقَ وَلَدَ الزِّنَا وَأُمَّهَ ""","","","","","Book of Wills"
"13476","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ أَبِي إِسْحَاقَ ، عَنْ سَالِمٍ ، قَالَ : أَعْتَقَ ابْنُ عُمَرَ وَلَدَ زِنًا وَأُمَّهَ ""","","","","","Book of Wills"
"13477","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، قَالَ فِيأَوْلادِ الزِّنَا :  أَعْتِقُوهُمْ وَأَحْسِنُوا إِلَيْهِمْ ""","","","","","Book of Wills"
"13478","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ نَافِعٍ ، قَالَ : أَعْتَقَ ابْنُ عُمَرَ بَغِيًّا وَابْنَهَا ""","","","","","Book of Wills"
"13479","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ لَيْثٍ ، عَنْ مُجَاهِدٍ ،  فِيوَلَدِ الزِّنَا ، قَالَ : لا يَعْتِقُهُ ، وَلا يَشْتَرِيهِ ، وَلا يَأْكُلُ ثَمَنَهُ ""","","","","","Book of Wills"
"13480","عَنْ عُمَرَ بْنِ رَاشِدٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ،  أَنَّ رَجُلا حَدَّثَهُ ، أَنَّ مَوْلاةً لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَدَّثَتْهُ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَعْطَاهَا جَارِيَةً ، وَأَنَّ تِلْكَالْجَارِيَةَ وَلَدَتْ مِنَ الزِّنَا ، فَسَأَلَتْ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ عِتْقِ وَلَدِهَا ذَلِكَ ؟ فَقَالَ لَهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِنَّكِ أَنْ تَصَدَّقِي بِصَدَقَةٍ خَيْرٌ مِنْ أَنْ تَعْتِقِيهَا ""","","","","","Book of Wills"
"13481","قَالَ يَحْيَى بْنُ أَبِي كَثِيرٍ :  وَكَانَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ : ""لا يُجِيزُ شَهَادَةَ وَلَدِ الزِّنَا ""","","","","","Book of Wills"
"13482","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَبْدِ الْكَرِيمِ ، أَنَّ نَافِعًا ، قَالَ : أَعْتَقَ ابْنُ عُمَرَ وَلَدَ زِنًا ""","","","","","Book of Wills"
"13483","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنِ ابْنِ الْمُنْكَدِرِ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللَّهُ عَنْهُ ، قَالَ : أَكْرِمْهُ وَأَحْسِنْ إِلَيْهِ يَعْنِي وَلَدَ الزِّنَا ""","","","","","Book of Wills"
"13484","عَنِ ابْنِ عُيَيْنَةَ ,عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، قَالَ فِيأَوْلادِ الزِّنَا :  أَعْتِقُوهُمْ ، وَأَحْسِنُوا إِلَيْهِمْ ""","","","","","Book of Wills"
"13485","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : سَمِعْتُ عَطَاءً ، يَسْأَلُ ، قَالَ لَهُ رَجُلٌ : سَقَتْنِي امْرَأَةٌ مِنْ لَبَنِهَا بَعْدَ مَا كُنْتُ رَجُلا كَبِيرًا ، أَأَنْكِحُهَا ؟ قَالَ : لا ، قُلْتُ : وَذَلِكَ رَأْيُكَ ؟ قَالَ : نَعَمْ ، قَالَ عَطَاءٌ : كَانَتْ عَائِشَةُ : تَأْمُرُ بِذَلِكَ بَنَاتِ أَخِيهَا ""","","","","","Book of Wills"
"13486","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ عُبَيْدِ اللَّهِ بْنِ أَبِي مُلَيْكَةَ ، أَنَّ الْقَاسِمَ بْنَ مُحَمَّدِ بْنِ أَبِي بَكْرٍ ، أَخْبَرَهُ ، أَنَّ عَائِشَةَ ،  أَخْبَرَتْهُ أَنَّ سَهْلَةَ بِنْتَ سُهَيْلِ بْنِ عَمْرٍو ، جَاءَتْ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَتْ : يَا رَسُولَ اللَّهِ ، إِنَّسَالِمًا مَوْلَى أَبِي حُذَيْفٍ مَعَنَا فِي بَيْتِنَا ، وَقَدْ بَلَغَ مَا يَبْلُغُ الرِّجَالَ ، وَعَلِمَ مَا يَعْلَمُ الرِّجَالُ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَرْضِعِيهِ ، تَحْرُمِي عَلَيْهِ ""، قَالَ ابْنُ أَبِي مُلَيْكَةَ : فَمَكَثْتُ سَنَةً أَوْ قَرِيبًا مِنْهَا لا أُحَدِّثُ بِهِ رَهْبَةً لَهُ ، ثُمَّ لَقِيتُ الْقَاسِمَ , فَقُلْتُ : لَقَدْ حَدَّثَتْنِي حَدِيثًا مَا حَدَّثَتْهُ بَعْدُ ، قَالَ : "" وَمَا هُوَ ؟ "" فَأَخْبَرْتُهُ ؟ , فَقَالَ : "" حَدِّثْ بِهِ عَنِّي أَنَّ عَائِشَةَ أَخْبَرْتِنِي بِهِ""","","","","","Book of Wills"
"13487","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ , قَالَتْ :  جَاءَتْ سَهْلَةُ بِنْتُ سُهَيْلِ بْنِ عَمْرٍو إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَتْ : إِنَّسَالِمًا كَانَ يُدْعَى لأَبِي حُذَيْفَةَ ، وَإِنَّ اللَّهَ عَزَّ وَجَلَّ قَدْ أَنْزَلَ فِي كِتَابِهِ :  ادْعُوهُمْ لآبَائِهِمْ وَكَانَ يَدْخُلُ عَلَيَّ وَأَنَا فَضْلٌ ، وَنَحْنُ فِي مَنْزِلٍ ضَيِّقٍ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَرْضِعِي سَالِمًا ، تَحْرُمِي عَلَيْهِ ""، قَالَ الزُّهْرِي : "" قَالَتْ بَعْضُ أَزْوَاجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لا نَدْرِي لَعَلَّ هَذِهِ كَانَتْ رُخْصَةً لِسَالِمٍ خَاصَّةً "" ، قَالَ الزُّهْرِي : وَكَانَتْ عَائِشَةُ "" تُفْتِي بِأَنَّهُ يَحْرُمُ الرَّضَاعُ بَعْدَ الْفِصَالِ حَتَّى مَاتَتْ""","","","","","Book of Wills"
"13488","عَنْ مَالِكٍ ، عَنِ ابْنِ شِهَابٍ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ،  أَنَّ أَبَا حُذَيْفَةَ بْنَ عُتْبَةَ بْنِ رَبِيعَةَ وَكَانَ بَدْرِيًّا ، وَكَانَ قَدْ تَبَنَّى سَالِمًا الَّذِي يُقَالُ لَهُ : سَالِمٌ مَوْلَى أَبِي حُذَيْفَةَ ، كَمَا تَبَنَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ زَيْدًا ، وَأَنْكَحَ أَبُو حُذَيْفَةَ سَالِمًا , وَهُوَ يَرَى إِنَّهُ ابْنُهُ , ابْنَةَ أَخِيهِ فَاطِمَةَ بِنْتَ الْوَلِيدِ بْنِ عُتْبَةَ ، وَهِيَ مِنَ الْمُهَاجِرَاتِ الأُوَلِ ، وَهِيَ يَوْمَئِذٍ مِنْ أَفْضَلِ أَيَامَى قُرَيْشٍ ، فَلَمَّا أَنْزَلَ اللَّهُ عَزَّ وَجَلَّ ذَلِكَ مَا أَنْزَلَ :  ادْعُوهُمْ لآبَائِهِمْ الآيَةَ ، رَدَّ كُلَّ وَاحِدٍ مِنْ أُولَئِكَ إِلَى أَبِيهِ ، فَإِنْ لَمْ يَعْلَمْ أَبُوهُ رَدَّ إِلَى مَوَالِيهِ ، فَجَاءَتْ سَهْلَةُ بِنْتُ سُهَيْلٍ وَهِيَ امْرَأَةُ أَبِي حُذَيْفَةَ وَهِيَ مِنْ بَنِي عَامِرِ بْنِ لُؤَيٍّ ، فَقَالَتْ : يَا رَسُولَ اللَّهِ ، كُنَّا نَرَى أَنَّ سَالِمًا وُلِدَ ، وَكَانَ يَدْخُلُ عَلَيَّ ، وَأَنَا فَضْلٌ ، وَلَيْسَ لَنَا إِلا بَيْتٌ وَاحِدٌ فِمَاذَا تَرَى ؟ قَالَ الزُّهْرِي : فَقَالَ لَهَا فِيمَا بَلَغَنَا وَاللَّهُ أَعْلَمُ :أَرْضِعِيهِ خَمْسَ رَضَعَاتٍ ، فَتَحْرُمُ بِلَبَنِهَا، وَكَانَتْ تَرَاهُ ابْنًا مِنَ الرَّضَاعَةِ ، فَأَخَذَتْ بِذَلِكَ عَائِشَةُ ، فِيمَنْ كَانَتْ تُرِيدُ أَنْ يَدْخُلَ عَلَيْهَا مِنَ الرِّجَالِ ، فَكَانَتْ تَأْمُرُ أُمَّ كُلْثُومٍ ابْنَةَ أَبِي بَكْرٍ ، وَبَنَاتَ أَخِيهَا يُرْضِعْنَ لَهَا مَنْ أَحَبَّتْ أَنْ يَدْخُلَ عَلَيْهَا مِنَ الرِّجَالِ ، وَأَبَى سَائِرُ أَزْوَاجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يَدْخُلَ عَلَيْهِنَّ بِتِلْكَ الرَّضَاعَةِ , قُلْنَ : وَاللَّهِ مَا نَرَى الَّذِي أَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِهِ سَهْلَةَ إِلا رُخْصَةً فِي رَضَاعَةِ سَالِمٍ وَحْدَهُ ""","","","","","Book of Wills"
"13489","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ , قَالَ : أَخْبَرَنِي عُرْوَةُ ، عَنْ عَائِشَةَ ،  أَنَّ أَبَا حُذَيْفَةَ تَبَنَّى سَالِمًا وَهُوَ مَوْلَى امْرَأَةٍ مِنَ الأَنْصَارِ ، كَمَا تَبَنَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ زَيْدًا ، وَكَانَ مَنْ تَبَنَّى رَجُلا فِي الْجَاهِلِيَّةِ دَعَاهُ النَّاسُ ابْنَهُ ، وَوَرِثَ مِنْ مِيرَاثِهِ ، حَتَّى أَنْزَلَ اللَّهُ عَزَّ وَجَلَّ :  ادْعُوهُمْ لآبَائِهِمْ هُوَ أَقْسَطُ عِنْدَ اللَّهِ فَإِنْ لَمْ تَعْلَمُوا آبَاءَهُمْ فَإِخْوَانُكُمْ فِي الدِّينِ ، فَرُدُّوا إِلَى آبَائِهِمْ ، وَمَنْ لَمْ يُعْرَفْ لَهُ أَبٌ ، فَمَوْلًى وَأَخٌ فِي الدِّينِ ، فَجَاءَتْ سَهْلَةُ ، فَقَالَتْ : يَا رَسُولَ اللَّهِ ، إِنَّا كُنَّا نَرَى سَالِمًا وَلَدًا يَأْوِي مَعِي ، وَمَعَ أَبِي حُذَيْفَةَ وَيَرَانِي فَضْلا ، وَقَدْ أَنْزَلَ اللَّهُ عَزَّ وَجَلَّ فِيهِ مَا عَلِمْتَ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :أَرْضِعِيهِ خَمْسَ رَضَعَاتٍ ، وَكَانَ بِمَنْزِلَةِ وَلَدِهَا مِنَ الرَّضَاعَةِ ""","","","","","Book of Wills"
"13490","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، أَنَّ سَالِمَ بْنَ أَبِي الْجَعْدِ ، مَوْلَى الأَشْجَعِيِّ أَخْبَرَهُ ، وَمُجَاهِدٌ ، أَنَّ أَبَاهُ أَخْبَرَهُ ،  إِنَّهُ سَأَلَ عَلِيَّا ، فَقَالَ : إِنِّيأَرَدْتُ أَنْ أَتَزَوَّجَ امْرَأَةً قَدْ سَقَتْنِي مِنْ لَبَنِهَا ، وَأَنَا كَبِيرٌ تَدَاوَيْتُ ، قَالَ عَلِيٌّ : لا تَنْكِحْهَا وَنَهَاهُ عَنْهَا ""","","","","","Book of Wills"
"13491","أَنَّهُ قَالَ ، عَنْ عَلِيٍّ ، أَيْضًا كَانَ يَقُولُ : سَقَتْهُ امْرَأَتُهُ مِنْ لَبَنِ سَرِيَّتِهِ أَوْ سَرِيَّتِهِ مِنْ لَبَنِ امْرَأَتِهِ لَتُحَرِّمَهَا عَلَيْهِ , فَلا يُحَرِّمُهَا ذَلِكَ ""","","","","","Book of Wills"
"13492","أَخْبَرَنِي ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ ، إِنَّهُ ، سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ :  جَاءَ رَجُلٌ إِلَى عُمَرَ بْنِ الْخَطَّابِ , فَقَالَ : "" إِنَّامْرَأَتِي أَرْضَعَتْ سَرِيَّتِي لِتُحَرِّمَهَا عَلَيَّ ، فَأَمَرَ عُمَرُ بِالْمَرْأَةِ أَنْ تُجْلَدَ ، وَأَنْ يَأْتِيَ سَرِيَّتَهُ بَعْدَ الرَّضَاعِ ""","","","","","Book of Wills"
"13493","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ،  أَنَّامْرَأَةً أَرْضَعَتْ جَارِيَةً لِزَوْجِهَا لِتُحَرِّمَهَا عَلَيْهِ ، فَأَتَى عُمَرُ فَذُكِرَ ذَلِكَ لَهُ ، فَقَالَ : عَزَمْتُ عَلَيْكَ لَمَا رَجَعْتَ ، فَأَوْجَعْتَ ظَهْرَ امْرَأَتِكَ وَوَاقَعْتَ جَارِيَتَكَ ""","","","","","Book of Wills"
"13494","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أُخْبِرْتُ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، جَاءَهُ أَعْرَابِيٌّ ، فَقَالَ :  إِنَّامْرَأَتِي , قَالَتْ : خَفِّفْ عَنِّي مِنْ لَبَنِي ، فَقَالَ : أَخْشَى أَنْ يُحَرِّمَكَ عَلَيَّ ، فَقَالَتْ : لا ، فَخَفَّفَ عَنْهَا ، وَلَمْ يُدْخِلْ بَطْنَهُ ، وَقَدْ وَجَدَ حَلاوَتَهُ فِي حَلْقِهِ ، فَقَالَتِ : اعْرِفْ فَقَدْ حَرُمْتُ عَلَيْكَ ، فَقَالَ عُمَرُ : هِيَ امْرَأَتُكَ فَاضْرِبْهَا ""","","","","","Book of Wills"
"13495","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : بَلَغَنِي ،  أَنَّ رَجُلا مِنَ الأَنْصَارِ مِنْ بَنِي حَارِثَةَ كَانَتْلَهُ وَلِيدَةٌ يَطَؤُهَا ، فَخَرَجَ يَوْمًا يُصَلِّي مَعَ عُمَرَ بْنِ الْخَطَّابِ فَأَرْضَعَتِ امْرَأَتُهُ وَلِيدَتَهُ ، وَأَكْرَهَتْهَا ، فَحُدِّثَ ذَلِكَ عُمَرُ ، فَقَالَ عُمَرُ : لَتَرْجِعَنَّ إِلَى وَلِيدَتِكَ فَلْتَطَأَنَّهَا ، وَلَتُوجِعَنَّ ظَهْرَ امْرَأَتِكَ ""، "" وَاسْمُهُ عِيسَى بْنُ حَزْمِ بْنِ عَمْرِو بْنِ زَيْدِ بْنِ حَارِثَةَ ""","","","","","Book of Wills"
"13496","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَرْسَلْتُ إِلَى عَطَاءٍ إِنْسَانًا فِيسَعُوطِ اللَّبْنِ الصَّغِيرِ وَكَحْلِهِ بِهِ , أَيَحْرُمُ ؟ قَالَ : مَا سَمِعْنَا إِنَّهُ يَحْرُمُ ""","","","","","Book of Wills"
"13497","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ سُلَيْمَانَ الشَّيْبَانِيِّ ، عَنِ الشَّعْبِيِّ ، قَالَ : كُلُّ سَعُوطٍ ، أَوْ وَجُورٍ ، أَوْ رَضَاعٍ يُرْضَعُ قَبْلَ الْحَوْلَيْنِ ، فَهُوَ يُحَرِّمُ ، وَمَا كَانَ بَعْدَ الْحَوْلَيْنِ ، فَلا يُحَرِّمُ ""، قَالَ عَبْدُ الرَّزَّاقِ : "" وَالنَّاسُ عَلَى هَذَا""","","","","","Book of Wills"
"13498","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي حُصَيْنٍ ، عَنِ أَبِي عَطِيَّةَ الْوَادِعِيِّ ، قَالَ :  جَاءَ رَجُلٌ إِلَى ابْنِ مَسْعُودٍ ، فَقَالَ : إِنَّهَا كَانَتْ مَعِي امْرَأَتِي ، فَحُصِرَ لَبَنُهَا فِي ثَدْيِهَا ، فَجَعَلْتُ أَمَصُّهُ ثُمَّ أَمَجُّهُ ، فَأَتَيْتُ أَبَا مُوسَى فَسَأَلْتُهُ ، فَقَالَ : حَرُمَتْ عَلَيْكَ ، قَالَ : فَقَامَ وَقُمْنَا مَعَهُ ، حَتَّى انْتَهَى إِلَى أَبِي مُوسَى ، فَقَالَ : مَا أَفْتَيْتَ هَذَا ؟ فَأَخْبَرَهُ بِالَّذِي أَفْتَاهُ ، فَقَالَ ابْنُ مَسْعُودٍ ، وَأَخَذَ بِيَدِ : أَرِضِيعًا تَرَى هَذَا ! إِنَّمَاالرَّضَاعُ مَا أَنْبَتَ اللَّحْمَ وَالدَّمَ ""، فَقَالَ أَبُو مُوسَى : لا تَسْأَلُونِي عَنْ شَيْءٍ مَا كَانَ هَذَا الْحَبْرُ بَيْنَ أَظْهُرِكُمْ""","","","","","Book of Wills"
"13499","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ،  وَاللَّهِلا أُفْتِيكُمْ مَا كَانَ بِهَا ""","","","","","Book of Wills"
"13500","عَنْ مَعْمَرٍ ، عَنْ جُوَيْبِرٍ ، عَنِ الضَّحَّاكِ بْنِ مُزَاحِمٍ ، عَنِ النَّزَّالِ ، عَنْ عَلِيٍّ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لا رَضَاعَ بَعْدَ الْفِصَالِ ""","","","","","Book of Wills"
"13501","عَنِ الثَّوْرِيِّ ، عَنْ جُوَيْبِرَ ، عَنِ الضَّحَّاكِ ، عَنِ النَّزَّالِ ، عَنْ عَلِيٍّ ، قَالَ : لا رَضَاعَ بَعْدَ الْفِصَالِ ""، وَسَمِعْتُهُ , يَقُولُ لِمَعْمَرٍ : "" إِنَّهُ لَمْ يَبْلُغْ بِهِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ مَعْمَرٌ : "" بَلَى""","","","","","Book of Wills"
"13502","أَخْبَرَنَا مَعْمَرٌ ، عَنْ حَرَامِ بْنِ عُثْمَانَ ، عَنْ عَبْدِ الرَّحْمَنِ ، وَمُحَمَّدٍ ابْنَيْ جَابِرٍ ، عَنْ أَبِيهِمَا جَابِرِ بْنِ عَبْدِ اللَّهِ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لا يَمِينَ لِوَلَدٍ مَعَ يَمِينِ وَالِدٍ ، وَلا يَمِينَ لِزَوْجَةٍ مَعَ يَمِينِ زَوْجٍ ، وَلا يَمِينَ لِمَمْلُوكٍ مَعَ يَمِينِ مَالِكٍ ، وَلا يَمِينَ فِي قَطِيعَةٍ ، وَلا نَذْرَ فِي مَعْصِيَةٍ ، وَلا طَلاقَ قَبْلَ نِكَاحٍ ، وَلا عَتَاقَةَ قَبْلَ مِلْكٍ ، وَلا صَمْتَ يَوْمٍ إِلَى اللَّيْلِ ، وَلا مُوَاصَلَةَ فِي الصِّيَامِ ، وَلا يُتْمَ بَعْدَ حُلُمٍ ، وَلا رَضَاعَ بَعْدَ الْفِطَامِ ، وَلا تَعُرَّبَ بَعْدَ الْهِجْرَةِ ، وَلا هِجْرَةَ بَعْدَ الْفَتْحِ ""","","","","","Book of Wills"
"13503","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنَّ ابْنَ عُمَرَ ، أَوِ ابْنَ عَبَّاسٍ ، قَالَ : لا رَضَاعَ بَعْدَ الْفِصَالِ الْحَوْلَيْنِ ""","","","","","Book of Wills"
"13504","عَنْ مَعْمَرٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : لا رَضَاعَ بَعْدَ فِصَالِ سَنَتَيْنِ ""","","","","","Book of Wills"
"13505","عَنِ الثَّوْرِيِّ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَمَّنْ ، سَمِعَ ابْنَ عَبَّاسٍ , يَقُولُ : لا رَضَاعَ بَعْدَ الْفِطَامَ ""","","","","","Book of Wills"
"13506","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، قَالَ : كَانَ ابْنُ عَبَّاسٍ , يَقُولُ : لا رَضَاعَ إِلا مَا كَانَ فِي الْحَوْلَيْنِ ""","","","","","Book of Wills"
"13507","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ ، قَالَ : لا أَعْلَمُ الرَّضَاعَ ، إِلا مَا كَانَ فِي الصِّغَرِ ""","","","","","Book of Wills"
"13508","عَنْ مَالِكٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، إِنَّهُ قَالَ : لا رَضَاعَ إِلا لِمَنْ أُرْضِعَ فِي الصِّغَرِ ، وَلا رَضَاعَةَ لِكَبِيرٍ ""","","","","","Book of Wills"
"13509","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي مُوسَى بْنُ عُقْبَةَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ ، كَانَ يَقُولُ : لا نَعْلَمُ الرَّضَاعَ ، إِلا مَا أُرْضِعَ فِي الصِّغَرِ ""","","","","","Book of Wills"
"13510","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ : لا رَضَاعَ إِلا مَا كَانَ فِي الْمَهْدِ ""","","","","","Book of Wills"
"13511","عَنْ مَعْمَرٍ ، عَنِ الْحَسَنِ ، وَالزُّهْرِيِّ ، وَقَتَادَةَ , قَالُوا : لا رَضَاعَ بَعْدَ الْفِصَالِ ""","","","","","Book of Wills"
"13512","عَنْ مَعْمَرٍ ، عَمَّنْ ، سَمِعَ عِكْرِمَةَ , يَقُولُ : الرَّضَاعُ بَعْدَ الْفِطَامِ ، مِثْلُ الْمَاءِ الْجَارِي يَشْرَبُهُ ""","","","","","Book of Wills"
"13513","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، وَمَعْمَرٌ ، قَالا : حَدَّثَنَا هِشَامُ بْنُ عُرْوَةَ ، عَنْ عُرْوَةَ ، عَنِ الْحَجَّاجِ بْنِ الْحَجَّاجِ الأَسْلَمِيِّ ،  إِنَّهُ اسْتَفْتَى أَبَا هُرَيْرَةَ ، فَقَالَ : ""لا يُحِرِّمُ إِلا مَا فَتَقَ الأَمْعَاءُ ""","","","","","Book of Wills"
"13514","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قَالَ عَطَاءٌ : يُحَرِّمُ مِنْهَا مَا قَلَّ وَمَا كَثُرَ ""","","","","","Book of Wills"
"13515","قَالَ : وَقَالَ ابْنُ عُمَرُ : لَمَّا بَلَغَهُ ، عَنِ ابْنِ الزُّبَيْرِ ، إِنَّهُ يَأْثِرُ عَنْ عَائِشَةَ ،  فِيالرَّضَاعِ إِنَّهُ قَالَ : لا يُحَرِّمُ مِنْهَا دُونَ سَبْعِ رَضَعَاتٍ ، قَالَ : اللَّهُ خَيْرٌ مِنْ عَائِشَةَ , قَالَ اللَّهُ تَعَالَى :  وَأَخَوَاتُكُمْ مِنَ الرَّضَاعَةِ ، وَلَمْ يَقُلْ رَضْعَةً وَلا رَضْعَتَيْنِ ""","","","","","Book of Wills"
"13516","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عَائِشَةَ , قَالَتْ : لا يُحَرِّمُ دُونَ خَمْسِ رَضَعَاتٍ مَعْلُومَاتٍ ""","","","","","Book of Wills"
"13517","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ عَمْرَةَ ، عَنْ عَائِشَةَ , قَالَتْ : نَزَلَ الْقُرْآنُ بِعَشْرِ رَضَعَاتٍ مَعْلُومَاتٍ ، ثُمَّ صِرْنَ إِلَى خَمْسٍ ""","","","","","Book of Wills"
"13518","عَنْ مَعْمَرٍ ، قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالَ :  كَانَلأَزْوَاجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَضَعَاتٌ مَعْلُومَاتٌ ، قَالَ : ثُمَّ تُرِكَ ذَلِكَ بَعْدُ فَكَانَ قَلِيلُهُ ، وَكَثِيرُهُ يُحَرِّمُ ""","","","","","Book of Wills"
"13519","عَنْ مَعْمَرٍ ،  أَنَّ أَزْوَاجَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ،إِذَا أَرْضَعْنَ الْكَبِيرَ دَخَلَ عَلَيْهِنَّ ، فَكَانَ ذَلِكَ لأَزْوَاجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَاصَّةً ، وَلِسَائِرِ النَّاسِ لا يَكُونُ إِلا مَا كَانَ فِي الصِّغَرِ ""","","","","","Book of Wills"
"13520","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، عَنْ طَاوُسٍ ، قَالَ : قُلْتُ لَهُ :  إِنَّهُمْ يَزْعُمُونَ إِنَّهُلا يَحْرُمُ مِنَ الرَّضَاعِ دُونَ سَبْعِ رَضَعَاتٍ ، ثُمَّ صَارَ ذَلِكَ إِلَى خَمْسٍ ، فَقَالَ طَاوُسٌ : قَدْ كَانَ ذَلِكَ فَحَدَثَ بَعْدَ ذَلِكَ أَمْرٌ جَاءَ التَّحْرِيمُ ، الْمَرَّةُ الْوَاحِدَةُ تُحَرِّمُ ""","","","","","Book of Wills"
"13521","عَنِ الثَّوْرِيِّ ، وَابْنِ عُيَيْنَةَ ، عَنْ عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ ، عَنْ طَاوُسٍ ، قَالَ : تُحَرِّمُ مِنَ الرَّضَاعَةِ الْمَرَّةُ الْوَاحِدَةُ ""","","","","","Book of Wills"
"13522","أَخْبَرَنِي ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ ، إِنَّهُ قَالَ : تُحَرِّمُ الْمَرَّةُ الْوَاحِدَةُ ، قُلْتُ : هِيَ الْمَصَّةُ ؟ قَالَ : نَعَمْ ""","","","","","Book of Wills"
"13523","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّهُ سَمِعَ ابْنَ عُمَرَ ، سَأَلَهُ رَجُلٌ :أَتُحَرِّمُ رَضْعَةٌ أَوْ رَضْعَتَانِ ؟ فَقَالَ : مَا نَعْلَمُ الأُخْتَ مِنَ الرَّضَاعَةِ إِلا حَرَامًا ، فَقَالَ رَجُلٌ : إِنَّ أَمِيرَ الْمُؤْمِنِينَ يُرِيدُ ابْنَ الزُّبَيْرِ يَزْعُمُ إِنَّهُ لا تُحَرِّمُ رَضْعَةٌ ، وَلا رَضْعَتَانِ ، فَقَالَ ابْنُ عُمَرَ : قَضَاءُ اللَّهِ خَيْرٌ مِنْ قَضَائِكَ وَقَضَاءِ أَمِيرِ الْمُؤْمِنِينَ . عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنِ ابْنِ عُمَرَ ، وَابْنِ الزُّبَيْرِ مِثْلَهُ""","","","","","Book of Wills"
"13524","عَنْ مَعْمَرٍ ، عَنْ إِبْرَاهِيمَ بْنِ عُقْبَةَ ، قَالَ : أَتَيْتُ عُرْوَةَ بْنَ الزُّبَيْرِ فَسَأَلْتُهُ عَنْ صَبِيٍّ شَرِبَ قَلِيلا مِنْ لَبَنِ امْرَأَةٍ ؟ فَقَالَ لِي عُرْوَةُ : كَانَتْ عَائِشَةُ ، تَقُولُ : لا يُحَرِّمُ دُونَ سَبْعِ رَضَعَاتٍ ، أَوْ خَمْسٍ ""، قَالَ : فَأَتَيْتُ ابْنَ الْمُسَيِّبِ ، فَسَأَلْتُهُ ، قَالَ : لا أَقُولُ قَوْلَ عَائِشَةَ ، وَلا أَقُولُ قَوْلَ ابْنِ عَبَّاسٍ وَلَكِنْ لَوْ دَخَلَتْ بَطْنَهُ قَطْرَةٌ بَعْدَ أَنْ يَعْلَمَ أَنَّهَا دَخَلَتْ بَطْنَهُ حَرُمَ""","","","","","Book of Wills"
"13525","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، أَنَّ ابْنَ الزُّبَيْرِ ، كَانَ يَقُولُ : لا تُحَرِّمُ الْمَصَّةُ ، وَالْمَصَّتَانِ "" ، يَرْوِي ابْنُ الزُّبَيْرِ ذَلِكَ ، عَنْ عَائِشَةَ""","","","","","Book of Wills"
"13526","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ ، عمن ، سَمِعَ الْحَسَنَ ، قَالُوا فِيالرَّضَاعِ :  قَلِيلُهُ وَكَثِيرُهُ سَوَاءٌ ""","","","","","Book of Wills"
"13527","عَنِ الثَّوْرِيِّ ، عَنْ لَيْثٍ ، عَنْ مُجَاهِدٍ ، عَنْ عَلِيٍّ ، وَابْنِ مَسْعُودٍ ، قَالا فِيالرَّضَاعِ :  يُحَرِّمُ قَلِيلُهُ وَكَثِيرُهُ ""، فَحَدَّثْتُ مَعْمَرًا ، فَقَالَ : صَدَقَ""","","","","","Book of Wills"
"13528","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ ، عَنْ عُرْوَةَ ، عَنْ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ ، إِنَّهُ حَدَّثَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، إِنَّهُ قَالَ : لا تُحَرِّمُ الْمَصَّةُ مِنَ الرَّضَاعَةِ ، وَلا الْمَصَّتَانِ ""","","","","","Book of Wills"
"13529","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي الْخَلِيلِ ، عَنْ عَبْدِ اللَّهِ بْنِ الْحَارِثِ ، عَنْ أُمِّ الْفَضْلِ ،  أَنَّ امْرَأَةً طَلَّقَهَا زَوْجُهَا ، ثُمَّ تَزَوَّجَ الرَّجُلُ امْرَأَةً أُخْرَى ، فَزَعَمَ أَنَّ امْرَأَتَهُ أَرْضَعَتْهَا ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِنَّهَالا تُحَرِّمُ الْمَلْجَةُ ، وَلا الْمَلْجَتَانِ ""","","","","","Book of Wills"
"13530","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنَّ عَائِشَةَ ،  أَمَرَتْ أُمَّ كُلْثُومٍ ، أَنْتُرْضِعَ سَالِمًا ، فَأَرْضَعَتْهُ خَمْسَ رَضَعَاتٍ ، ثُمَّ مَرِضَتْ ، فَلَمْ يَكُنْ يَدْخُلُ سَالِمٌ عَلَى عَائِشَةَ ""","","","","","Book of Wills"
"13531","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : سَمِعْتُ نَافِعًا ، يُحَدِّثُ ، أَنَّ سَالِمَ بْنَ عَبْدِ اللَّهِ ، حَدَّثَهُ ، أَنَّ عَائِشَةَ زَوْجَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ،  أَرْسَلَتْ بِهِ إِلَى أُخْتِهَا أُمِّ كُلْثُومٍ ابْنَةِ أَبِي بَكْرٍلِتُرْضِعَهُ عَشْرَ رَضَعَاتٍ , لِيَلِجَ عَلَيْهَا إِذَا كَبِرَ ، فَأَرْضَعَتْهُ ثَلاثَ مَرَّاتٍ ، ثُمَّ مَرِضَتْ ، فَلَمْ يَكُنْ سَالِمٌ يَلِجُ عَلَيْهَا ، قَالَ : زَعَمُوا أَنَّ عَائِشَةَ , قَالَتْ : لَقَدْ كَانَ فِي كِتَابِ اللَّهِ عَزَّ وَجَلَّ : عَشْرُ رَضَعَاتٍ ، ثُمَّ رُدَّ ذَلِكَ إِلَى خَمْسٍ ، وَلَكِنْ مِنْ كِتَابِ اللَّهِ مَا قُبِضَ مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Wills"
"13532","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : سَمِعْتُ نَافِعًا مَوْلَى ابْنِ عُمَرَ ، يُحَدِّثُ ، أَنَّ ابْنَةَ أَبِي عُبَيْدٍ امْرَأَةَ ابْنِ عُمَرَ أَخْبَرَتْهُ ،  أَنّ حَفْصَةَ بِنْتَ عُمَرَ زَوْجَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، ""أَرْسَلَتْ بِغُلامٍ نَفِيسٍ لِبَعْضِ مَوَالِي عُمَرَ إِلَى أُخْتِهَا فَاطِمَةَ بِنْتِ عُمَرَ : فَأَمَرَتْهَا أَنْ تُرْضِعَهُ عَشْرَ مَرَّاتٍ "" ، فَفَعَلَتْ فَكَانَ يَلِجُ عَلَيْهَا بَعْدَ أَنْ كَبِرَ، قَالَ ابْنُ جُرَيْجٍ : "" وَأُخْبَرْتُ أَنَّ اسْمَهُ عَاصِمُ بْنُ عَبْدِ اللَّهِ بْنِ سَعْدٍ مَوْلَى عُمَرَ "" ، أَخْبَرَنِيهِ مُوسَى ، عَنْ نَافِعٍ""","","","","","Book of Wills"
"13533","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنِ ابْنِ عَجْلانَ ، قَالَ : أُخْبِرْتُ ، أَنَّ عُمَرَ ، أُتِيَ بِغُلامٍ ، وَجَارِيَةٍ أَرَادُوا أَنْ يُنَاكِحُوا بَيْنَهُمَا ، فَأُعْلِمُوا أَنْ قَدْ أَرْضَعَتْ إِحْدَاهُمَا ، قَالَ : فَكَيْفَ أَرْضَعَتِ الأُخْرَى ؟ قَالَ : مَرَّتْ بِهِ وَهُوَ يَبْكِي فَأَرْضَعَتْهُ ، أَوْ أَمَصْصَتْهُ ، فَعَلاهُمَا بِالدِّرَةِ ، ثُمَّ قَالَ : نَاكِحُوا بَيْنَهُمَا ، فَإِنَّمَا الرَّضَاعَةُ الْحَضَانَةُ ""","","","","","Book of Wills"
"13534","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ ثَوْرٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، أَنَّ سُفْيَانَ بْنَ عَبْدِ اللَّهِ ،  كَتَبَ إِلَى عُمَرَ ، يَسْأَلُهُمَا يُحَرِّمُ مِنَ الرَّضَاعِ ؟ فَكَتَبَ إِلَيْهِ : إِنَّهُ لا يُحَرِّمُ مِنْهَا الضِّرَارُ ، وَالْعَفَافَةُ ، وَالْمَلْجَةُ ، وَالضِّرَارُ : أَنْ تُرْضِعَ الْوَلَدَيْنِ كَيْ يَحْرُمَ بَيْنَهُمَا ، وَالْعَفَافَةُ : الشَّيْءُ الْيَسِيرُ الَّذِي يَبْقَى فِي الثَّدْيِ ، وَالْمَلْجَةُ : اخْتِلاسُ الْمَرْأَةِ وَلَدَ غَيْرِهَا فَتُلْقِمْهُ ثَدْيَهَا ""","","","","","Book of Wills"
"13535","أَخْبَرَنَا مَعْمَرٌ ، وَابْنُ جُرَيْجٍ عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، إِنَّهُ قَالَ : لا يُحَرِّمُ لَبَنُ الأَبِ ، وَكَانَ يُسِمِّيهِ لَبَنَ الْفَحْلِ ""","","","","","Book of Wills"
"13536","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : لَبَنُ الْفَحْلِ أَيُحَرِّمُ ؟ قَالَ : نَعَمْ ، قَالَ اللَّهُ :  وَأَخَوَاتُكُمْ مِنَ الرَّضَاعَةِ , فَهِيَ أُخْتُكَ مِنْ أَبِيكَ ""","","","","","Book of Wills"
"13537","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، إِنَّهُ ، سَمِعَ أَبَا الشَّعْثَاءِ :  يَرَىلَبَنَ الْفَحْلِ يُحَرِّمُ ""","","","","","Book of Wills"
"13538","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاهِدٍ :  إِنَّهُ كَانَيَكْرَهُ لَبَنَ الْفَحْلِ ""","","","","","Book of Wills"
"13539","عَنِ الثَّوْرِيِّ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، وَالْحَسَنِ ، أنهماكَرِهَا لَبَنَ الْفَحْلِ أَيْضًا""","","","","","Book of Wills"
"13540","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ , قَالَتْ :  جَاءَ أَفْلَحُ أَخُو أَبِي الْقَعِيسِ يَسْتَأْذِنُ عَلَيْهَا ، فَقَالَ : إِنِّي عَمُّهَا ، فَأَبَتْ أَنْ تَأْذَنَ لَهُ ، فَلَمَّا دَخَلَ عَلَيْهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ذَكَرَتْ ذَلِكَ لَهُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :أَفَلا أَذِنْتِ لِعَمِّكَ , قَالَتْ : يَا رَسُولَ اللَّهِ ، إِنَّمَا أَرْضَعَتْنِي الْمَرْأَةُ ، وَلَمْ يُرْضِعْنِي الرَّجُلُ ، قَالَ : فَأْذَنِي لَهُ ، فَإِنَّهُ عَمُّكِ تَرِبَتْ يَمِينُكِ ، قَالَ : وَكَانَ أَبُو الْقَعِيسِ زَوْجَ الْمَرْأَةِ الَّتِي أَرْضَعَتْ عَائِشَةَ ""، عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ نَحْوَهُ""","","","","","Book of Wills"
"13541","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : أَخْبَرَنِي عُرْوَةُ بْنُ الزُّبَيْرِ ، أَنَّ عَائِشَةَ ، أَخْبَرَتْهُ قَالَتْ :اسْتأذَنَ عَلَيَّ عَمِّي مِنَ الرَّضَاعَةِ أَبُو الْجَعْدِ فَرَدَدْتُهُ ،  قَالَ ابْنُ جُرَيْجٍ ، قَالَ لِي هِشَامٌ :  إِنَّمَا هُوَ أَبُو الْقَعِيسِ ، فَلَمَّا جَاءَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَخْبَرَتْهُ بِذَلِكَ ، قَالَ : فَهَلا أَذِنتني لَهُ تَرِبَتْ يَمِينُكِ , أَوْ قَالَ : يَدُكِ ""","","","","","Book of Wills"
"13542","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي هِشَامٌ ، عَنِ أَبِيهِ ، عَنْ عَائِشَةَ , قَالَتْ : جَاءَ عَمِّي مِنَ الرَّضَاعَةِ بَعْدَ مَا ضُرِبَ عَلَيَّ الْحِجَابُ ، فَاسْتَأْذَنَ عَلَيَّ ، فَقُلْتُ : وَاللَّهِ لا آذَنُ لَكَ حَتَّى يَأْتِيَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَسْتَأْذِنَهُ ، قَالَ لَهَا : فَلْيَلِجْ عَلَيْكِ عَمُّكِ , قَالَتْ : إِنَّمَا أَرْضَعَتْنِي الْمَرْأَةُ ، وَلَمْ يُرْضِعْنِي الرَّجُلُ ، قَالَ : إِنَّمَا هُوَ عَمُّكِ فَلْيَلِجْ عَلَيْكِ "". عَنِ الثَّوْرِيِّ ، عَنْ هِشَامٍ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ نَحْوَهُ ، وَبِهِ يَأْخُذُ الثَّوْرِيُّ""","","","","","Book of Wills"
"13543","عَنْ مَالِكٍ ، عَنِ ابْنِ شِهَابٍ ، عَنْ عَمْرِو بْنِ الشَّرِيدِ ، قَالَ : سُئِلَ ابْنُ عَبَّاسٍ ،  عَنْرَجُلٍ تَزَوَّجَ امْرَأَتَيْنِ ، فَأَرْضَعَتِ الْوَاحِدَةُ جَارِيَةً ، وَأَرْضَعَتِ الأُخْرَى غُلامًا ، هَلْ يَتَزَوَّجُ الْغُلامَ الْجَارِيَةَ ؟ فَقَالَ : لا ، اللِّقَاحُ وَاحِدٌ لا تَحِلُّ لَهُ ""","","","","","Book of Wills"
"13544","عَنِ الثَّوْرِيِّ ، عَنْ خُصَيْفٍ ، عَنْ سَالِمِ بْنِ عَبْدِ اللَّهِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لا بَأْسَ بِلَبَنِ الْفَحْلِ "". قَالَ مُحَمَّدٌ : وَأَخْبَرَنِي مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ رَجُلٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , إِنَّهُ قَالَ : "" لا بَأْسَ بِهِ""","","","","","Book of Wills"
"13545","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، قَالَ : لا بَأْسَ بِهِ ""","","","","","Book of Wills"
"13546","وَقَوْلُهُ : يَحْرُمُ مِنَ الرَّضَاعِ مَا يَحْرُمُ مِنَ النَّسَبِ ، إِذَا شَرِبَتْ مَعَكَ جَارِيَةٌ لَبَنَ أُمِّكَ لَمْ تَحِلَّ لَكَ , وَلا لأَحَدٍ مِنْ إِخْوَانِكَ ، وَإِمَّا إِذَا رَضَعْتَ لَبَنَ أُخْرَى مَعَ جَارِيَةٍ فَهِيَ حَلالٌ لأَخِيكَ ، إِذَا لَمْ يَرْضِعْ أَخُوكَ مِنْ أُمِّهَا ""","","","","","Book of Wills"
"13547","عَنِ الثَّوْرِيِّ ، عَنْ عَلِيِّ بْنِ زَيْدِ بْنِ جُدْعَانَ ، عَنِ ابْنِ الْمُسَيِّبِ ، عَنْ عَلِيٍّ ، قَالَ : قُلْتُ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَلا أَدُلُّكَ عَلَى أَحْسَنِ فَتَاةٍ مِنْ قُرَيْشٍ ؟ قَالَ : مَنْ هِيَ ؟ قُلْتُ : ابْنَةُ حَمْزَةَ ، قَالَ : إِنَّهَا ابْنَةُ أَخِي مِنَ الرَّضَاعَةِ ، أَمَا عَلِمْتَ أَنَّاللَّهَ حَرَّمَ مِنَ الرَّضَاعَةِ مَا حَرَّمَ مِنَ النَّسَبِ ""","","","","","Book of Wills"
"13548","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، وَمَعْمَرٌ ، قَالا : حَدَّثَنَا هِشَامُ بْنُ عُرْوَةَ ، عَنْ عُرْوَةَ ، عَنْ زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ، عَنْ أُمِّ حَبِيبَةَ ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْتُ : هَلْ لَكَ فِي أُخْتِي ابْنَةِ أَبِي سُفْيَانَ ؟ قَالَ : أفْعَلُ مَاذَا ؟ قُلْتُ : تَنْكِحُهَا ، قَالَ : أُخْتُكِ ؟ قَالَتْ : نَعَمْ ، قَالَ : أَوَ تُحِبِّينَ ذَلِكَ ؟ قَالَتْ : نَعَمْ ، لَسْتُ لَكَ بِمُخْلِيَةٍ ، وَأُحِبُّ ، أَوْ قَالَتْ : وَأَحَقُّ مِنْ شِرْكَتِي فِي خَيْرٍ أُخْتِي ، قَالَ : فَإنَّهَا لا تَحِلُّ لِي ، قَالَتْ : وَاللَّهِ ، لَقَدْ خُبِّرْتُ أَنَّكَ تَخْطُبُ دُرَّةَ بِنْتَ أَبِي سَلَمَةَ ، قَالَ : بِنْتُ أُمِّ سَلَمَةَ ؟ قَالَتْ : نَعَمْ ، قَالَ : فَوَاللَّهِلَوْ لَمْ تَكُنْ رَبِيبَتِي فِي حِجْرِي مَا حَلَّتْ لِي ، إِنَّهَا ابْنَةُ أَخِي مِنَ الرَّضَاعَةِ ، أَرْضَعَتْنِي وَأَبَاهَا ثُوَيْبَةُ ، فَلا تَعْرِضُنَّ عَلَيَّ بَنَاتَكُنَّ وَلا أَخَوَاتِكُنَّ ""","","","","","Book of Wills"
"13549","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، وَجَابِرٍ الْجُعْفِيِّ ، عَنْ عِكْرِمَةَ ، قَالَ : عُرِضَتِ ابْنَةُ حَمْزَةَ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ : إِنَّهَا ابْنَةُ أَخِي مِنَ الرَّضَاعَةِ ""","","","","","Book of Wills"
"13550","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ , قَالَتْ : يَحْرُمُ مِنَ الرَّضَاعَةِ مَا يَحْرُمُ مِنَ الْوِلادَةِ ""","","","","","Book of Wills"
"13551","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ ، إِنَّهُ كَانَ يَقُولُ : يَحْرُمُ مِنَ الرَّضَاعَةِ مَا يَحْرُمُ مِنَ النَّسَبِ ""","","","","","Book of Wills"
"13552","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ ، عَنْ سِمَاكِ بْنِ حَرْبٍ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : يَحْرُمُ مِنَ الرَّضَاعَةِ مَا يَحْرُمُ مِنَ النَّسَبِ ""","","","","","Book of Wills"
"13553","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، وَإِبْرَاهِيمَ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ ، عَنْ عَمْرَةَ ، عَنْ عَائِشَةَ ، أَنّ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : يَحْرُمُ مِنَ الرَّضَاعَةِ مَا يَحْرُمُ مِنَ الْوِلادَةِ ""","","","","","Book of Wills"
"13554","عَنْ عُمَرَ بْنِ حَبِيبٍ ، قَالَ : حَدَّثَنِي شَيْخٌ ، قَالَ : جَلَسْتُ إِلَى ابْنِ عُمَرَ ، فَقَالَ : أَمِنْ بَنِي فُلانٍ أَنْتَ ؟ قُلْتُ : لا ، وَلَكِنَّهُمْ أَرْضَعُونِي ، قَالَ : أَمَا إِنِّي ، سَمِعْتُ عُمَرَ , يَقُولُ :  إِنَّاللَّبَنِ يُشْبِهُ عَلَيْهِ ""","","","","","Book of Wills"
"13555","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي مُسْلِمُ بْنُ أَبِي مَرْيَمَ ، عَنْ عُرْوَةَ بْنَ الزُّبَيْرِ ، عَنْ عَائِشَةَ ، أَنَّهَا كَانَتْ , تَقُولُ : يَحْرُمُ مِنَ الرَّضَاعَةِ مَا يَحْرُمُ مِنَ الْوِلادَةِ ""","","","","","Book of Wills"
"13556","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : أَخْبَرَنِي عُرْوَةُ بْنُ الزُّبَيْرِ ، عَنْ زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ، أَنَّ أُمَّ حَبِيبَةَ زَوْجَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَتْ :  يَا رَسُولَ اللَّهِ ، انْكِحْ أُخْتِي ابْنَةَ أَبِي سُفْيَانَ ، فَقَالَ لَهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَتُحِبِّينَ ذَلِكَ ؟ فَقَالَتْ : نَعَمْ ، وَمَا أَنَا لَكَ بِمُخْلِيَةٍ ، وَخَيْرُ مَنْ شَرَكَنِي فِي خَيْرٍ أُخْتِي ، قَالَ : فَإِنَّ ذَلِكَ لا يَحِلُّ ، قَالَتْ : فَوَاللَّهِ إِنَّا لَنَتَحَدَّثُ أَنَّكَ تُرِيدُ أَنْ تَنْكِحَ دُرَّةَ بِنْتَ أَبِي سَلَمَةَ ، قَالَ : ابْنَةُ أُمِّ سَلَمَةَ ؟ قَالَتْ : فَقُلْتُ : نَعَمْ ، قَالَ : فَوَاللَّهِلَوْ لَمْ تَكُنْ رَبِيبَتِي مَا حَلَّتْ لِي ، إِنَّهَا لابْنَةُ أَخِي مِنَ الرَّضَاعَةِ ، لَقَدْ أَرْضَعَتْنِي وَأَبَاهَا ثُوَيْبَةُ ، فَلا تَعْرِضُنَّ عَلَيَّ بَنَاتِكُنَّ وَأَخَوَاتِكُنَّ "". قَالَ عُرْوَةُ : وَكَانَتْ ثُوَيْبَةُ مَوْلاةً لأَبِي لَهَبٍ ، كَانَ أَبُو لَهَبٍ أَعْتَقَهَا ، فَأَرْضَعَتْ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا مَاتَ أَبُو لَهَبٍ رَآهُ بَعْضُ أَهْلِهِ فِي النَّوْمِ ، فَقَالَ لَهُ : مَاذَا لَقِيتَ ؟ , أَوْ قَالَ : وَجَدْتَ ؟ , قَالَ أَبُو لَهَبٍ لَمْ أَلْقَ أَوْ أَجِدْ بَعْدَكُمْ رَخَاءً , أَوْ قَالَ : رَاحَةً غَيْرَ أَنِّي سَقَيْتُ فِي هَذِهِ مِنِّي لِعِتْقِي ثُوَيْبَةَ , وَأَشَارَ إِلَى النَّقْرَةِ الَّتِي تَلِي الإِبْهَامَ وَالَّتِي تَلِيهَا""","","","","","Book of Wills"
"13557","عَنْ مَعْمَرٍ ، وَابْنِ جُرَيْجٍ ، وَالثَّوْرِيِّ , قَالُوا : حَدَّثَنَا هِشَامُ بْنُ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنِ الْحَجَّاجِ الأَسْلَمِيِّ ، عَنْ أَبِيهِ ، إِنَّهُ قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ ،مَا يُذْهِبُ عَنْهُ مَذَمَّةَ الرَّضَاعِ ؟ قَالَ : غُرَّةُ عَبْدٍ أَوْ أَمَةٍ . قَالَ مَعْمَرٌ : "" وَلَهَا بَعْدَ ذَلِكَ حَقٌّ فِي الصِّلَةِ ""","","","","","Book of Wills"
"13558","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ :  سَأَلْتُهُ عَنِامْرَأَةٍ مُرْضِعٍ بِلَبَنِ وَلَدِ الزِّنَا ؟ قَالَ : لا بَأْسَ بِهِ الْيَهُودِيَّةُ وَالنَّصْرَانِيَّةُ وَالْمَجُوسِيَّةُ تُرْضِعُ الْمُسْلِمَ ، قَالَ إِبْرَاهِيمُ : "" وَقَدْ كَانُوا يَسْتَحِبُّونَ أَنْ يُرْضَخَ لِلْمُرْضِعِ عِنْدَ الْفِصَالِ بِشَيْءٍ ""","","","","","Book of Wills"
"13559","عَنْ أَبِي بَكْرِ بْنِ أَبِي سَبْرَةَ عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللَّهِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، عَنْ بَعْضِ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : جَاءَتْ أُخْتُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ السَّعْدِيَّةُ إِلَيْهِ مَرْجِعَهُ مِنْ حُنَيْنٍ ، فَلَمَّا رَآهَا ، رَحَّبَ بِهَا وَبَسَطَ لَهَا رِدَاءً لأَنْ تَجْلِسَ عَلَيْهِ ، فَأَعْظَمَتْ ذَلِكَ فَعَزَمَ عَلَيْهَا ، فَجَلَسَتْ فَذَرَفَتْ عَيْنَا رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، حَتَّى بَلَّتْ لِحْيَتَهُ دُمُوعُهُ ، فَقَالَ رَجُلٌ مِنَ الْقَوْمِ : أَتَبْكِي يَا رَسُولَ اللَّهِ ! قَالَ : نَعَمْ ، لِرَحْمَتِهَا وَمَا دَخَلَ عَلَيْهَا ، لَوْ كَانَ لأَحَدِكُمْ أُحُدٌ ذَهَبًا فَأَعْطَاهُ فِي حَقِّ رَضَاعِهِ مَا أَدَّى حَقَّهَا ، أَمَّا حَقِّي الَّذِي آخُذُ مِنْكِ فَلَكِ ، وَأَمَّا مَا لِلْمُسْلِمِينَ فَلَسْتُ بِآخَذٍ بِهِ ، إِلا أَنْ يَطِيبُوا بِهِ نَفْسًا , قَالَتْ : فَلَمْ يَبْقَ أَحَدٌ مِنَ الْمُسْلِمِينَ إِلا أَدَّى إِلَيْهَا مَا أَخَذَ مِنْهَا""","","","","","Book of Wills"
"13560","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَالْحَسَنِ ، وَقَتَادَةَ ،  كانوالا يَرَوْنَ بَأْسًا أَنْ يَنْكِحَ الرَّجُلُ ابْنَةَ امْرَأَةٍ كَانَ أَبُوهُ قَدْ أَصَابَهَا ""","","","","","Book of Wills"
"13561","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : كَانَ عَطَاءٌ , يَقُولُ : رَجُلٌ طَلَّقَ امْرَأَةً ، فَنَكَحَتْ رَجُلا فَوَلَدَتْ لَهُ جَارِيَةً ، وَكَانَ لِزَوْجِهَا الأَوَّلِ ابْنٌ ، قَالَ : لا بَأْسَ أَنْ يَنْكِحَ ابْنَهُ ابْنَةَ امْرَأَتِهِ مِنَ الرَّجُلِ الَّذِي كَانَ تَزَوَّجَهَا بَعْدَهُ ""","","","","","Book of Wills"
"13562","عَنِ الثَّوْرِيِّ ، قَالَ : لا بَأْسَ بِهِ ""، وَذَكَرَ لَيْثٌ ، عَنْ مُجَاهِدٍ ، إِنَّهُ كَانَ "" يَكْرَهُهُ فَلَمْ يُعْجِبْنَا ذَلِكَ""","","","","","Book of Wills"
"13563","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ،  إِنَّهُ كَانَيَكْرَهُ أَنْ يَنْكِحَ الرَّجُلُ ابْنَةَ امْرَأَةٍ ، قَدْ كَانَ أَبُوهُ وَطِئَهَا ، فَمَا وَلَدَتْ مِنْ وَلَدٍ قَبْلَ أَنْ يَطَأَهَا أَبُوهُ ، فَلا بَأْسَ أَنْ يَنْكِحَهَا ، وَمَا وَلَدَتْ مِنْ وَلَدٍ بَعْدَ أَنْ وَطِئَهَا أَبُوهُ فَلا يَتَزَوَّجُ شَيْئًا مِنْ وَلَدِهَا "". عَنْ مَعْمَرٍ ، قَالَ : قُلْتُ : لابْنِ أَبِي نَجِيحٍ أَعَلِمْتَ أَحَدًا يَكْرَهُ ذَلِكَ ؟ ، قَالَ : كَانَ مُجَاهِدٌ يَكْرَهُهُ ، قَالَ مَعْمَرٌ : وَلَمْ أَجِدْ أَحَدًا كَرِهَهُ إِلا مَا ذُكِرَ ، عَنْ طَاوُسٍ ، وَمُجَاهِدٍ""","","","","","Book of Wills"
"13564","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : لا بَأْسَ أَنْ يَتَزَوَّجَ الرَّجُلُ ابْنَةَ الرَّجُلِ وَامْرَأَتَهُ إِذَا كَانَتِ ابْنَتُهُ مِنْ غَيْرِهَا ""","","","","","Book of Wills"
"13565","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : جَمَعَ عَبْدُ اللَّهِ بْنُ جَعْفَرٍ بَيْنَ امْرَأَةِ عَلِيٍّ وَابْنَتِهِ مِنْ غَيْرِهَا تَزَوَّجَهُمَا جَمِيعًا ""","","","","","Book of Wills"
"13566","عَنِ الثَّوْرِيِّ ،  وَقَدْ سُئِلَ عَنِالرَّجُلِ يَتَزَوَّجُ امْرَأَةَ رَجُلٍ وَابْنَتَهُ يَجْمَعُ بَيْنَهُمَا مِنْ غَيْرِهَا ، قَالَ : لا بَأْسَ بِذَلِكَ وَفَعَلَهُ بَعْضُ مَنْ يُشَارُ إِلَيْهِ ""","","","","","Book of Wills"
"13567","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي ابْنُ أَبِي مُلَيْكَةَ ، أَنَّ عُقْبَةَ بْنَ الْحَارِثِ بْنِ عَامِرٍ ، أَخْبَرَهُ أَوْ سَمِعَهُ مِنْهُ إِنْ لَمْ يَكُنْ خَصَّهُ بِهِ : إِنَّهُنَكَحَ أُمَّ يَحْيَى بِنْتَ أَبِي إِهَابٍ , فَقَالَتِ امْرَأَةٌ سَوْدَاءُ : قَدْ أَرْضَعْتُكُمَا ، قَالَ : فَجِئْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَذَكَرْتُ ذَلِكَ لَهُ : فَأَعْرَضَ عَنِّي ، فَجِئْتُ إِلَيْهِ الثَّانِيَةَ فَذَكَرْتُ ذَلِكَ لَهُ , فَقَالَ : كَيْفَ وَقَدْ زَعَمَتْ أَنْ قَدْ أَرْضَعَتْكُمَا فَنَهَاهُ عَنْهَا ""","","","","","Book of Wills"
"13568","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ أَبِي مُلَيْكَةَ ، عَنْ عُبَيْدِ بْنِ أَبِي مَرْيَمَ ، عَنْ عُقْبَةَ بْنِ الْحَارِثِ ،  قَالَ ابْنُ أَبِي مُلَيْكَةَ : وَقَدْ سَمِعْتُهُ مِنْ عُقْبَةَ أَيْضًا ، قَالَ : تَزَوَّجَتِ امْرَأَةٌ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَجَاءَتِ امْرَأَةٌ سَوْدَاءُ ، فَزَعَمَتْ أَنَّهَا أَرْضَعَتْنَا جَمِيعًا ، قَالَ : فَأَتَيْتُ بِهَا النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرْتُ ذَلِكَ لَهُ , وَقُلْتُ : إِنَّهَا كَاذِبَةٌ , فَأَعْرَضَ عَنِّي ، ثُمَّ تَحَوَّلَتْ مِنَ الْجَانِبِ الآخَرِ , فَقُلْتُ : يَا رَسُولَ اللَّهِ إِنَّهَا كَاذِبَةٌ ، قَالَ : فَكَيْفَ تَصْنَعُ بِقَوْلِ هَذِهِ ؟ دَعْهَا عَنْكَ ""، قَالَ مَعْمَرٌ : وَسَمِعْتُ غَيْرَهُ , يَقُولُ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : كَيْفَ بِكَ قَدْ قِيلَ ؟""","","","","","Book of Wills"
"13569","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنَّ عُثْمَانَ ، فَرَّقَ بَيْنَ أَهْلِ أَبْيَاتٍ بِشَهَادَةِ امْرَأَةٍ ""","","","","","Book of Wills"
"13570","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنِ ابْنِ شِهَابٍ ، قَالَ : جَاءَتِ امْرَأَةٌ سَوْدَاءُ فِي إِمَارَةِ عُثْمَانَ إِلَى أَهْلِ ثَلاثَةِ أَبْيَاتٍ قَدْ تَنَاكَحُوا ، فَقَالَتْ : أَنْتُمْ بَنِيَّ ، وَبَنَاتِي فَفُرِّقَ بَيْنَهُمْ ""","","","","","Book of Wills"
"13571","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ أَبِي الشَّعْثَاءِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : شَهَادَةُ الْمَرْأَةِ الْوَاحِدَةِ جَائِزَةٌ فِي الرَّضَاعِ إِذَا كَانَتْ مَرْضِيَّةً وَتُسْتَحْلَفُ مَعَ شَهَادتِهَا ، قَالَ : وَجَاءَ ابْنَ عَبَّاسٍ رَجُلٌ ، فَقَالَ : زَعَمَتْ فُلانَةُ أَنَّهَا أَرْضَعَتْنِي وَامْرَأَتِي , وَهِيَ كَاذِبَةٌ , فَقَالَ ابْنُ عَبَّاسٍ : انْظُرُوا فَإِنْ كَانَتْ كَاذِبَةً فَسَيُصِيبُهَا بَلاءٌ ، قَالَ : فَلَمْ يَحُلِ الْحَوْلُ حَتَّى بَرَصَ ثَدْيُهَا ""","","","","","Book of Wills"
"13572","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : تَجُوزُ شَهَادَةُ النِّسَاءِ عَلَى كُلِّ شَيْءٍ لا يُنْظُرُ إِلَيْهِ إِلا هُنَّ ، وَلا تَجُوزُ مِنْهُنَّ دُونَ أَرْبَعِ نِسْوَةٍ ""","","","","","Book of Wills"
"13573","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : لا تَجُوزُ شَهَادَتُهُنَّ ، إِلا أَنْ يَكُنَّ أَرْبَعًا ""","","","","","Book of Wills"
"13574","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَعَنْ رَجُلٍ ، عَنِ الْحَسَنِ ، قَالا : تَجُوزُ شَهَادَةُ الْوَاحِدَةِ الْمَرْضِيَّةِ فِي الرَّضَاعِ وَالنِّفَاسِ ""","","","","","Book of Wills"
"13575","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالَ : تَجُوزُ شَهَادَةُ الْمَرْأَةِ الْوَاحِدَةِ فِي الرَّضَاعِ "". عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ مِثْلَهُ ، وَزَادَ فِيهِ : "" وَإِنْ كَانَتْ سَوْدَاءَ""","","","","","Book of Wills"
"13576","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، قَالَ :  كَانَتِالْقُضَاةُ يُفَرِّقُونَ بِشَهَادَةِ امْرَأَةٍ فِي الرَّضَاعِ ""","","","","","Book of Wills"
"13577","عَنِ الثَّوْرِيِّ ، قَالَ : أَخْبَرَنِي أَشْعَثُ ، عَنِ الشَّعْبِيِّ ، تَجُوزُ شَهَادَةُ الْمَرْأَةِ الْوَاحِدَةِ فِيمَا لا يَطِّلِعُ عَلَيْهِ الرِّجَالُ ""، عَنِ الثَّوْرِيِّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، مِثْلَ قَوْلِ الشَّعْبِيِّ""","","","","","Book of Wills"
"13578","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنِ الْحَكَمِ ، قَالَ : امْرَأَتَيْنِ ""","","","","","Book of Wills"
"13579","عَنِ الثَّوْرِيِّ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، أَنَّ عُمَرَ ، لَمْ يَأْخُذْ بِشَهَادَةِ امْرَأَةٍ فِي رَضَاعٍ ""، قَالَ : وَكَانَ ابْنُ أَبِي لَيْلَى لا يَأْخُذُ بِشَهَادَةِ امْرَأَةٍ فِي رَضَاعٍ""","","","","","Book of Wills"
"13580","عَنْ شَيْخٍ مِنْ أَهْلِ نَجْرَانَ ، قَالَ : سَمِعْتُ ابْنَ الْبَيْلَمَانِيِّ يُحَدِّثُ ، عَنْ أَبِيهِ ، عَنِ ابْنِ عُمَرَ ، قَالَ :  سُئِلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :مَا الَّذِي يَجُوزُ فِي الرَّضَاعِ مِنَ الشُّهُودِ ؟ فَقَالَ : رَجُلٌ أَوِ امْرَأَةٌ ""","","","","","Book of Wills"
"13581","عَنْ عَبْدِ اللَّهِ بْنِ كَثِيرٍ ، عَنْ شُعْبَةَ ، عَنْ أَبِي الْبَخْتَرِيِّ ، قَالَ : سَمِعْتُ الشَّعْبِيَّ , يَقُولُ : تَجُوزُ شَهَادَةُ النِّسَاءِ عَلَى مَا لا يَرَاهُ الرِّجَالُ ، أَرْبَعٍ "", قَالَ شُعْبَةُ : وَسَمِعْتُ الْحَكَمَ ، قَالَ : "" اثْنَتَيْنِ "" ، وَسَأَلْتُ حَمَّادًا , فَقَالَ : "" وَاحِدَةٍ""","","","","","Book of Wills"
"13582","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : وَاحِدَةٍ ""","","","","","Book of Wills"
"13583","عَنْ أَبِي بَكْرِ بْنِ أَبِي سَبْرَةَ عَنْ أَبِي الزِّنَادِ ، يَحْيَى بْنِ رَبِيعَةَ ،  أَنَّشَهَادَةَ الْمَرْأَةِ الْوَاحِدَةِ إِذَا كَانَتْ مَرْضِيَّةً ، وَسُمِعَ ذَلِكَ مِنْهَا قَبْلَ النِّكَاحِ , جَازَتْ وَحْدَهَا فِي الرَّضَاعِ وَالاسْتِهْلالِ ""","","","","","Book of Wills"
"13584","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ نُجَيٍّ ، عَنْ عَلِيٍّ ، وَعَنْ عَبْدِ الأَعْلَى عَنْ شُرَيْحٍ ، وَعَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ،  أَنَّهُمْأَجَازُوا شَهَادَةَ امْرَأَةٍ وَاحِدَةٍ فِي الاسْتِهْلالِ ""","","","","","Book of Wills"
"13585","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَنْبَسَةُ مَوْلَى طَلْحَةَ بْنِ دَاوُدَ ، إِنَّهُ سَمِعَ طَلْحَةَ بْنَ دَاوُدَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : نِعْمَ الْمُرْضِعُونَ أَهْلُ عُمَانَ ""","","","","","Book of Wills"
"13586","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي ابْنُ نَوْفَلِ بْنِ أَنَسٍ ،  أَنَّ أُمَّهُ أَرْضَعَتْ أُمَّ سَلَمَةَ بِنْتَ حَمْزَةَ بْنِ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ , قَالَتْ : "" فَجَاءَتْ بِهَا إِلَى أَسْمَاءَ بِنْتِ أَبِي بَكْرٍ ، فَقَالَتْ : مِمَّنْ أَنْتِ يَا بُنَيَّةُ ؟ قَالَتْ : مِنْ هُذَيْلٍ ، قَالَتْ : إِنَّ أَبَا بَكْرٍ ، قَالَ : إِنَّخَيْرَ مَرَاضَعٍ أَثْقَلْنَ رِقَابَ الإِبِلِ نِسَاءَ هُذَيْلٍ ""","","","","","Book of Wills"
"13587","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ عَطَاءٌ ،  فِيالإِيغَالِ ، بَدَا لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَنَهَى عَنْهُ , فَقَالَ : لَوْ كَانَ ضَائِرًا ضَرَّ الرُّومَ وَفَارِسَ ""","","","","","Book of Wills"
"13588","عَنِ الثَّوْرِيِّ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ ، قَالَ :  جَاءَ رَجُلٌ فَشَكَا امْرَأَتَهُ إِلَى ابْنِ الْمُسَيِّبِ ، فَقَالَ ابْنُ الْمُسَيِّبِ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : ""أَيُّمَا امْرَأَةٍ لَمْ تَسْتَغْنِ عَنْ زَوْجِهَا ، وَلَمْ تَشْكُرْ لَهُ ، لَمْ يَنْظُرِ اللَّهُ عَزَّ وَجَلَّ إِلَيْهَا يَوْمَ الْقِيَامَةِ ، فَقَالَ رَجُلٌ عِنْدَ ابْنِ الْمُسَيِّبِ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَيَّتُمَا امْرَأَةٍ أَقْسَمَ عَلَيْهَا زَوْجُهَا قَسَمَ حَقٍّ ، فَلَمْ تُبْرِرْهُ حُطَّتْ عَنْهَا سَبْعُونَ صَلاةً ، قَالَ : فَقَالَ رَجُلٌ آخَرُ عِنْدَ ابْنِ الْمُسَيِّبِ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَيُّمَا امْرَأَةٍ أَلْحَقَتْ بِقَوْمٍ نَسَبًا لَيْسَ مِنْهُمْ لَمْ يَعْدِلْ وَزْنَهَا يَوْمَ الْقِيَامَةِ مِثْقَالَ ذَرَّةٍ ""","","","","","Book of Wills"
"13589","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ شُرَيْكِ بْنِ أَبِي نَمِرٍ ، عَنِ عُمَرَ بْنِ الْحَكَمِ بْنِ ثَوْبَانَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :الَّذِي يُوَرِّثُ الْمَالَ غَيْرَ أَهْلِهِ عَلَيْهَا نِصْفُ عَذَابِ الأُمَّةِ","","","","","Book of Wills"
"13590","أَخْبَرَنِي إِسْمَاعِيلُ ، أَنَّ عَائِشَةَ ، كَانَتْ تَنْهَى الْمَرْأَةَ ذَاتَ الزَّوْجِ أَنْ تَدَعَ سَاقَيْهَا لا تَجْعَلَ فِيهَا شَيْئًا ، وَأَنَّهَا كَانَتْ تَقُولُ لا تَدَعِ الْمَرْأَةُ الخِضَابِ ، فَإِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَكْرَهُ الرَّجْلَةَ ""","","","","","Book of Wills"
"13591","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ ، عَنْ فَاطِمَةَ بِنْتِ الْمُنْذِرِ ، أَنَّهَا قَالَتْ : مَا رَأَيْتُ أَسْمَاءَ لَبِسَتْ إِلا مُعَصْفَرَةً حَتَّى لَقِيَتِ اللَّهَ ، وَإِنْ كَانَتْ لَتَلْبَسُ الدِّرْعَ يَقُومُ قَائِمًا مِنَ الْمُعَصْفَرِ ""","","","","","Book of Wills"
"13592","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي حَرَامُ بْنُ عُطْلَة ،  أَنَّ خَالَتَهُ أَخْبَرَتْهُ أَنَّهَارَأَتْ عَائِشَةَ أُمَّ الْمُؤْمِنِينَ ، مُخَضَّبَةً عَلَيْهَا ثِيَابُ مُضْرَجَةٌ ، قَالَ : وَرَأَيْتُ أَنَا صَفِيَّةَ بِنْتَ شَيْبَةَ مُخَضَّبَةً , عَلَيْهَا ثِيَابٌ مُعَصْفَرَةٌ ""","","","","","Book of Wills"
"13593","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : أَزْوَاجُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : خَدِيجَةُ بِنْتُ خُوَيْلِدٍ ، وَعَائِشَةُ بِنْتُ أَبِي بَكْرٍ ، وَأُمُّ سَلَمَةَ بِنْتُ أَبِي أُمَيَّةَ ، وَحَفْصَةُ بِنْتُ عُمَرَ ، وَأُمُّ حَبِيبَةَ بِنْتُ أَبِي سُفْيَانَ ، وَجُوَيْرِيَّةُ بِنْتُ الْحَارِثِ ، وَمَيْمُونَةُ بِنْتُ الْحَارِثِ ، وَزَيْنَبُ بِنْتُ جَحْشٍ ، وَسَوْدَةُ بِنْتُ زَمْعَةَ ، وَصَفِيَّةُ بِنْتُ حُيَيٍّ ، اجْتَمَعْنَ عِنْدَهُ تِسْعَةً بَعْدَ خَدِيجَةَ ، وَالْكِنْدِيَّةُ مِنْ بَنِي الْجَوْنِ ، وَالْعَالِيَةُ بِنْتُ ظَبْيَانَ مِنْ بَنِي عَامِرِ بْنِ كِلابٍ ، وَزَيْنَبُ بِنْتُ خُزَيْمَةَ امْرَأَةٌ مِنْ بَنِي هِلالٍ ""","","","","","Book of Wills"
"13594","قَالَ مَعْمَرٌ , وَأَخْبَرَنِي الزُّهْرِي ، عَنْ عُرْوَةَ بْنَ الزُّبَيْرِ ،  لَمَّادَخَلَتِ الْكِنْدِيَّةُ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَتْ : أَعُوذُ بِاللَّهِ مِنْكَ ! فَقَالَ : لَقَدْ عُذْتِ بِعَظِيمٍ الْحَقِي بِأَهْلِكِ ""","","","","","Book of Wills"
"13595","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، طَلَّقَ الْعَالِيَةَ بِنْتَ ظَبْيَانَ , فَتَزَوَّجَهَا ابْنُ عَمٍّ لَهَا , وَذَلِكَ قَبْلَ أَنْ يَحْرُمَ نِكَاحُهُنَّ عَلَى النَّاسِ ، وَوَلَدَتْ لَهُ ""","","","","","Book of Wills"
"13596","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، قَالَ : أَوَّلُ امْرَأَةٍ تَزَوَّجَهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : خَدِيجَةُ ، ثُمَّ تَزَوَّجَ سَوْدَةَ بِنْتَ زَمْعَةَ ، ثُمَّ نَكَحَ عَائِشَةَ بِمَكَّةَ ، وَبَنَى بِهَا بِالْمَدِينَةِ ، وَنَكَحَ بِالْمَدِينَةِ زَيْنَبَ بِنْتَ خُزَيْمَةَ الْهِلالِيَّةَ ، ثُمَّ نَكَحَ أُمَّ سَلَمَةَ ، ثُمَّ نَكَحَ جُويْرِيَّةَ بِنْتَ الْحَارِثِ ، وَكَانَتْ مِمَا أَفَاءَ اللَّهُ عَلَيْهِ ، ثُمَّ نَكَحَ مَيْمُونَةَ بِنْتَ الْحَارِثِ ، وَهِيَ الَّتِي وَهَبَتْ نَفْسَهَا لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ نَكَحَ صَفِيَّةَ بِنْتَ حُيَيٍّ وَهِيَ مِمَّا أَفَاءَ اللَّهُ عَلَيْهِ يَوْمَ خَيْبَرَ ، ثُمَّ نَكَحَ زَيْنَبَ بِنْتَ جَحْشٍ ، وَكَانَتِ امْرَأَةَ زَيْدِ بْنِ حَارِثَةَ ، وَتُوفِّيتْ زَيْنَبُ بِنْتُ خُزَيْمَةَ عِنْدَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَخَدِيجَةُ أَيْضًا تُوُفِّيَتْ بِمَكَّةَ ، وَنَكَحَ امْرَأَةً مِنْ بَنِي كِلابِ بْنِ رَبِيعَةَ , يُقَالُ لَهَا : الْعَالِيَةُ بِنْتُ ظَبْيَانَ , فَطَلَّقَهَا حِينَ أُدْخِلَتْ عَلَيْهِ ، وَجُويْرِيَّةُ مِنْ بَنِي الْمُصْطَلِقِ مِنْ خُزَاعَةَ ، وَحَفْصَةُ ، وَأُمُّ حَبِيبَةَ ، وَامْرَأَةٌ مِنْ كَلْبٍ ، فَكَانَ جَمِيعُ مَا تَزَوَّجَ أَرْبَعَ عَشْرَةَ مِنْهُنَّ الْكِنْدِيَّةَ ""","","","","","Book of Wills"
"13597","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ ، وَعَمْرٍو ، قَالا : اجْتَمَعْنَ عِنْدَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَقَدْ أَمَرَ أَنْ يَضْرِبَ عَلَى صَفِيَّةَ الْحِجَابَ ، خَدِيجَةُ ، وَعَائِشَةُ ، وَأُمُّ سَلَمَةَ ، وَحَفْصَةُ ، وَأُمُّ حَبِيبَةَ ، وَجُويْرِيَةُ الْمُصْطَلِقِيَّةُ ، وَمَيْمُونَةُ ، وَزَيْنَبُ بِنْتُ جَحْشٍ مِنْ بَنِي أَسَدٍ ، فِي بَنِي حَرْبٍ ، وَسَوْدَةُ مِنْ بَنِي عَامِرِ بْنِ لُؤَيٍّ ، وَصَفِيَّةُ بِنْتُ حُيَيٍّ ""","","","","","Book of Wills"
"13598","عَنِ الْمُجَالِدِ ، عَنْ رَجُلٍ ، عَنِ الشَّعْبِيِّ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : تَزَوَّجَ امْرَأَةً مِنْ كِنْدَةَ ، فَجِيءَ بِهَا بَعْدَ مَا مَاتَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Wills"
"13599","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قَالَ ابْنُ أَبِي مُلَيْكَةَ ، وَعَمْرُو : اجْتَمَعَ عِنْدَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تِسْعُ نِسْوَةٍ بَعْدَ خَدِيجَةَ ، وَمَاتَ عَنْهُنَّ كُلِّهِنَّ "". قَالَ : وَزَادَ عُثْمَانُ بْنُ أَبِي سُلَيْمَانَ : "" امْرَأَتَيْنِ سِوَى التِّسْعِ مِنْ بَنِي عَامِرِ بْنِ صَعْصَعَةَ كِلْتَاهُمَا جَمَعَ ، كَانَتْ إِحْدَاهُمَا تُدْعَى أُمَّ الْمَسَاكِينَ كَانَتْ خَيْرَ نِسَائِهِ لِلْمَسَاكِينَ ، وَنَكَحَ امْرَأَةً مِنْ بَنِي الْجُونِ ، فَلَمَّا جَاءَتْهُ اسْتَعَاذَتْ مِنْهُ فَطَلَّقَهَا ، وَنَكَحَ امْرَأَةً أُخْرَى مِنْ كِنْدَةَ وَلَمْ يَجْمَعْهَا ، فَتَزَوَّجَتْ بَعْدَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَفَرَّقَ عُمَرُ بَيْنَهُمَا ، وَضَرَبَ زَوْجَهَا ، فَقَالَتْ : اتَّقِ اللَّهَ فِيَّ يَا عُمَرُ ، فَإِنْ كُنْتُ مِنْ أُمَّهَاتِ الْمُؤْمِنِينَ فَاضْرِبْ عَلَيَّ الْحِجَابَ ، وَأَعْطِنِي مِثْلَ مَا أَعْطَيْتَهُنَّ ، قَالَ : أَمَّا هُنَالِكَ فَلا , قَالَتْ : فَدَعْنِي أُنْكَحْ ، قَالَ : لا وَلا نِعْمَةُ عَيْنٍ وَلا أُطِيعُ فِي ذَلِكَ أَحَدًا""","","","","","Book of Wills"
"13600","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ ، أَنَّ عَائِشَةَ , قَالَتْ : مَا مَاتَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَتَّى أُحِلَّ لَهُ أَنْ يَنْكِحَ مَا شَاءَ ""، قُلْتُ : عَمَّنْ تَأْثِرُ هَذَا ؟ قُلْتُ : لا أَدْرِي ، حَسِبْتُ أَنِّي سَمِعْتُ عَبْدًا يَقُولُ ذَلِكَ ، قَالَ : وَقَالَ لِي عَمْرٌو : سَمِعْتُ عَطَاءً مُنْذُ حِينٍ , يَقُولُ : "" مَا مَاتَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَتَّى أُحِلَّ لَهُ أَنْ يَنْكِحَ مَا شَاءَ ""","","","","","Book of Wills"
"13601","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : مَاتَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَمَا نَعْلُمُهُ يَنْكِحُ النِّسَاءَ ""","","","","","Book of Wills"
"13602","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، قَالَ : تُوُفِّيَتْ خَدِيجَةُ قَبْلَ مَخْرَجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِثَلاثِ سِنِينَ أَوْ نَحْوِ ذَلِكَ ، وَتَزَوَّجَ عَائِشَةَ قَرِيبًا مِنْ مَوْتِ خَدِيجَةَ ، وَلَمْ يَتَزَوَّجْ عَلَى خَدِيجَةَ حَتَّى مَاتَتْ ""","","","","","Book of Wills"
"13603","عَنْ مَعْمَرٍ ، عَمَّنْ ، سَمِعَ الْحَسَنَ , يَقُولُ :  لَمَّاخَيَّرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نِسَاءَهُ خِرْنَ , فَاخْتَرْنَ اللَّهَ وَرَسُولَهُ فَصَبَرَ عَلَيْهِنَّ ، فَقَالَ اللَّهُ :  لا يَحِلُّ لَكَ النِّسَاءُ مِنْ بَعْدُ الآيَةَ ""","","","","","Book of Wills"
"13604","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : لا أَعْلَمُهُ إِلا أَخْبَرَنِي ، قَالَ : كَانَلِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سُرِّيَّتَيْنِ : الْقِبْطِيَّةُ ، وَرَيْحَانَةُ ابْنَةُ شَمْعُونَ ""","","","","","Book of Wills"
"13605","أَخْبَرَنَا مَعْمَرٌ ، وَابْنُ جُرَيْجٍ عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ عَبْدِ اللَّهِ بْنِ جَعْفَرٍ ، أَنَّ عَلِيَّ بْنَ أَبِي طَالِبٍ ، قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , يَقُولُ : خَيْرُ نِسَائِهَا مَرْيَمُ ، وَخَيْرُ نِسَائِهَا خَدِيجَةُ بِنْتُ خُوَيْلِدٍ ""","","","","","Book of Wills"
"13606","عَنْ مَعْمَرٍ ، قَالَ : سَمِعْتُ الزُّهْرِي , يَقُولُ : لَمْ يَتَزَوَّجِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى خَدِيجَةَ حَتَّى مَاتَتْ ، وَقَالَتْ عَائِشَةُ : مَا رَأَيْتُ خَدِيجَةَ قَطُّ ، وَمَا غِرْتُ عَلَى امْرَأَةٍ قَطُّ أَشَدَّ مِنْ غَيْرَتِي عَلَى خَدِيجَةَ ، وَذَلِكَ مِنْ كَثْرَةِ مَا كَانَ يَذْكُرُهَا ""","","","","","Book of Wills"
"13607","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَطَاءٌ ،  أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :لَمْ يَنْكِحْ عَلَى خَدِيجَةَ حَتَّى مَاتَتْ ""","","","","","Book of Wills"
"13608","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : وَلَدتْ خَدِيجَةُ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : الْقَاسِمَ ، وَطَاهِرًا ، وَفَاطِمَةَ ، وَزَيْنَبَ ، وَأُمَّ كُلْثُومٍ ، وَرُقَيَّةَ ""، قَالَ الزُّهْرِي : وَإِنَّ رِجَالا مِنَ الْعُلَمَاءِ , لَيَقُولُونَ : "" مَا نَعْلَمُ خَدِيجَةَ وَلَدَتْ لَهُ ذَكَرًا إِلا الْقَاسِمَ""","","","","","Book of Wills"
"13609","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : وَلدَتْ لَهُ الْقِبْطِيَّةُ ، قَالَ الزُّهْرِي : وَلَمْ تَلِدْ لَهُ امْرَأَةٌ مِنْ نِسَائِهِ إِلا خَدِيجَةُ ""","","","","","Book of Wills"
"13610","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ لِي غَيْرُ وَاحِدٍ : وَلَدَتْ لَهُ خَدِيجَةُ أَرْبَعَ نِسْوَةٍ ، وَعَبْدَ اللَّهِ ، وَالْقَاسِمَ ، وَوَلَدَتْ لَهُ الْقِبْطِيَّةُ إِبْرَاهِيمَ ، وَكَانَتْ زَيْنَبُ كُبْرَى بَنَاتِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَكَانَتْ فَاطِمَةُ أَصْغَرَهُنَّ وَأَحَبَّهُنَّ إِلَيْهِ ، وَكَانَ تَرَكَهَا عِنْدَ أُمِّ هَانِئٍ ، وَنَكَحَ عَلِيٌّ وَعُثْمَانُ فِي الإِسْلامِ ، وَنَكَحَتْ زَيْنَبُ فِي الْجَاهِلِيَّةِ ""","","","","","Book of Wills"
"13611","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قَالَ مُجَاهِدٌ ، قَالَ : مَكَثَ الْقَاسِمُ ابْنُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سَبْعَ لَيَالٍ ، ثُمَّ مَاتَ ""","","","","","Book of Wills"
"13612","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي الضُّحَى ، عَنِ الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ : تُوُفِّيَ إِبْرَاهِيمُ ابْنُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ابْنَ سِتَّةَ عَشَرَ شَهْرًا ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : ادْفِنُوهُ بِالْبَقِيعِ ، فَإِنَّ لَهُ مُرْضِعًا تُتِمُّ رَضَاعَهُ فِي الْجَنَّةِ ""","","","","","Book of Wills"
"13613","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ،  أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :صَلَّى عَلَى ابْنِ مَارِيَّةَ الْقِبْطِيَّةِ ، وَهُوَ ابْنُ سِتَّةَ عَشَرَ شَهْرًا ""","","","","","Book of Wills"
"13614","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنْيَطْرُقَ الرَّجُلُ أَهْلَهُ بَعْدَ الْعَتْمَةِ ""","","","","","Book of Wills"
"13615","عَنْ عُبَيْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَفَلَ مِنْ غَزْوَةٍ فَلَمَّا جَاءَ الْجُرُفُ ، قَالَ : لا تَطْرُقُوا النِّسَاءَ ، وَلا تَغْتَرُّوهُنَّ ، وَبَعَثَ رَاكِبًا إِلَى الْمَدِينَةِ , يُخْبِرُهُمْ أَنَّ النَّاسَ يَدْخُلُونَ بِالْغَدَاةِ ""","","","","","Book of Wills"
"13616","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : بَعَثَ عُمَرُ بْنُ الْخَطَّابِ ، مَقْدِمَهُ مِنَ الشَّامِ أَسْلَمَ مَوْلاهُ إِلَى أَهْلِ الْمَدِينَةِ يُؤْذِنُهُمْ ، إِنَّا قَادِمُونَ عَلَيْكُمْ لِكَذَا وَكَذَا ""","","","","","Book of Wills"
"13617","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَةَ ، قَالَ : لَمَّا نَزَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالْمُعَرَّسِ ، أَمَرَ مُنَادِيًا فَنَادَى :لا تَطْرُقُوا النِّسَاءَ ، قَالَ : فَتَعَجَّلَ رَجُلانِ فَكِلاهُمَا وَجَدَ مَعَ امْرَأَتِهِ رَجُلا , فَذُكِرَ ذَلِكَ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : قَدْ  نَهَيْتُكُمْ أَنْ تَطْرُقُوا النِّسَاءَ ""","","","","","Book of Wills"
"13618","عَنِ ابْنِ جُرَيْجٍ ، عَنْ مُحَمَّدٍ بْنِ إِبْرَاهِيمَ التَّيْمِيِّ ، أَنَّ ابْنَ رَوَاحَةَ ، كَانَفِي سَرِيَّةٍ فَقَفَلَ فَأَتَى بِيتَهُ مُتَوَشِّحًا السَّيْفَ ، فَإِذَا هُوَ بِالْمِصْبَاحِ فَارْتَابَ فَتَسَوَّرَ ، فَإِذَا امْرَأَتُهُ عَلَى سَرِيرٍ مُضْجِعَةً إِلَى جَنْبِهَا فِيمَا يُرَى رَجُلا ثَائِرًا شَعْرَ الرَّأْسِ , فَهَمَّ أَنْ يَضْرِبَهُ ، ثُمَّ أَدْرَكَهُ الْوَرَعُ ، فَغَمَزَ امْرَأَتَهُ فَاسْتَيْقَظَتْ ، فَقَالَتْ : وَرَاءَكَ وَرَاءَكَ ، قَالَ : وَيْلَكِ مَنْ هَذَا ؟ قَالَتْ : هَذِهِ أُخْتِي ظَلَّتْ عِنْدِي فَغَسَلَتْ رَأْسَهَا ، فَلَمَّا بَلَغَ ذَلِكَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ طُرُوقِ النِّسَاءِ ، فَعَصَاهُ رَجُلانِ فَطَرَقَا أَهْلَيْهِمَا فَوَجَدَ كُلُّ وَاحِدٍ مِنْهُمَا مَعَ امْرَأَتِهِ رَجُلا ، فَلَمَّا بَلَغَ ذَلِكَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : أَلَمْ أَنْهَكُمْ عَنْ طُرُوقِ النِّسَاءِ","","","","","Book of Wills"
"13619","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ عُثْمَانَ بْنِ خُثَيْمٍ ، قَالَ :  كَانَتْ بِمَكَّةَ امْرَأَةٌ عِرَاقِيَّةٌ تَنَسَّكُ جَمِيلَةٌ لَهَا ابْنٌ , يُقَالُ لَهُ : أَبُو أُمَيَّةَ ، وَكَانَ سَعِيدُ بْنُ جُبِيرٍ يُكْثِرُ الدُّخُولَ عَلَيْهَا ، قُلْتُ : يَا أَبَا عَبْدِ اللَّهِ !مَا أَكْثَرَ مَا تَدْخُلُ عَلَى هَذِهِ الْمَرْأَةِ ، قَالَ : إِنَّا قَدْ نَكَحْنَاهَا ذَلِكَ النِّكَاحَ لِلْمُتْعَةِ ، قَالَ : وَأَخْبَرَنِي أَنَّ سَعِيدًا ، قَالَ لَهُ : هِيَ أَحَلُّ مِنْ شُرْبِ الْمَاءِ لِلْمُتْعَةِ ""","","","","","Book of Wills"
"13620","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : لأَوَّلُ مَنْ سَمِعْتُ مِنْهُ الْمُتْعَةَ صَفْوَانُ بْنُ يَعْلَى ، قَالَ : أَخْبَرَنِي ، عَنْ يَعْلَى ،  أَنَّ مُعَاوِيَةَ اسْتَمْتَعَ بِامْرَأَةٍ بِالطَّائِفِ فَأَنْكَرَتْ ذَلِكَ عَلَيْهِ ، فَدَخَلْنَا عَلَى ابْنِ عَبَّاسٍ ، فَذَكَرَ لَهُ بَعْضُنَا ، فَقَالَ لَهُ : نَعَمْ ، فَلَمْ يَقِرَّ فِي نَفْسِي حَتَّى قَدِمَ جَابِرُ بْنُ عَبْدِ اللَّهِ ، فَجِئْنَاهُ فِي مَنْزِلِهِ ، فَسَأَلَهُ الْقَوْمُ عَنْ أَشْيَاءَ ، ثُمَّ ذَكَرُوا لَهُ الْمُتْعَةَ ، فَقَالَ : نَعَمْ ،اسْتَمْتَعْنَا عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""، وَأَبِي بَكْرٍ وَعُمَرَ ، حَتَّى إِذَا كَانَ فِي آخِرِ خِلافَةِ عُمَرَ ، اسْتَمْتَعَ عَمْرُو بْنُ حُرَيْثٍ بِامْرَأَةٍ سَمَّاهَا جَابِرٌ فَنَسِيتُهَا ، فَحَمَلَتِ الْمَرْأَةُ , فَبَلَغَ ذَلِكَ عُمَرَ , فَدَعَاهَا فَسَأَلَهَا ، فَقَالَتْ : نَعَمْ ، قَالَ : مَنْ أَشْهَدَ ؟ قَالَ : عَطَاءٌ لا أَدْرِي , قَالَتْ : أُمِّي أُمَّ وَلِيِّهَا ، قَالَ : فَهَلا غَيْرَهُمَا ، قَالَ : خَشِيَ أَنْ يَكُونَ دَغْلا الآخَرُ ، قَالَ عَطَاءٌ : وَسَمِعْتُ ابْنَ عَبَّاسٍ , يَقُولُ : يَرْحَمُ اللَّهُ عُمَرَ ، مَا كَانَتِ الْمُتْعَةُ إِلا رُخْصَةً مِنَ اللَّهِ عَزَّ وَجَلَّ , رَحِمَ بِهَا أُمَّةَ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَلَوْلا نَهْيُهُ عَنْهَا مَا احْتَاجَ إِلَى الزِّنَا إِلا شَقِيُّ ، قَالَ : كَأَنِّي وَاللَّهِ أَسْمَعُ قَوْلَهُ : إِلا شَقِيٌّ ، عَطَاءٌ الْقَائِلُ , قَالَ عَطَاءٌ : فَهِيَ الَّتِي فِي سُورَةِ النِّسَاءِ :  فَمَا اسْتَمْتَعْتُمْ بِهِ مِنْهُنَّ ، إِلَى كَذَا وَكَذَا مِنَ الأَجَلِ عَلَى كَذَا وَكَذَا لَيْسَ يُتَشَاوَرُ ، قَالَ : بَدَا لَهُمَا أَنْ يَتَرَاضِيَا بَعْدَ الأَجَلِ ، وَأَنْ يَتَفَرَّقَا , فَنَعَمَ وَلَيْسَ بِنِكَاحٍ ""","","","","","Book of Wills"
"13621","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَطَاءٌ  ، إِنَّهُ سَمِعَ ابْنَ عَبَّاسٍ ،يَرَاهَا الآنَ حَلالا ، وَأَخْبَرَنِي أَنَّهُ كَانَ يَقْرَأُ : فَمَا اسْتَمْتَعْتُمْ بِهِ مِنْهُنَّ إِلَى أجَلٍ فَآتُوهُنَّ أُجُورَهُنَّ ، وَقَالَ ابْنُ عَبَّاسٍ : فِي حَرْفِ إِلَى أَجَلٍ ""، قَالَ عَطَاءٌ : وَأَخْبَرَنِي مَنْ شِئْتُ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ : "" لَقَدْ كَانَ أَحَدُنَا يَسْتَمْتِعُ بِمِلْءِ الْقَدَحِ سُوَيْقًا "" . وَقَالَ صَفْوَانُ : هَذَا ابْنُ عَبَّاسٍ يُفْتِي بِالزِّنَا , فَقَالَ ابْنُ عَبَّاسٍ : "" إِنِّي لا أُفْتِي بِالزِّنَا , أَفَنَسِيَ صَفْوَانُ أُمَّ أَرَاكَةَ , فَوَاللَّهِ إِنَّ ابْنَهَا لَمِنْ ذَلِكَ أَفَزِنًا هُوَ ؟ ، قَالَ : وَاسْتَمْتَعَ بِهَا رَجُلٌ مِنْ بَنِي جُمَحٍ""","","","","","Book of Wills"
"13622","قَالَ ابْنِ جُرَيْجٍ : وَأَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، عَنْ حَسَنِ بْنِ مُحَمَّدِ بْنِ عَلِيٍّ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، وَسَلَمَةَ بْنِ الأَكْوَعِ ،  رَجُلٍ مِنْ أَسْلَمَ , مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , أَنَّهُمَا قَالا :كُنَّا فِي غَزْوَةٍ ، فَجَاءَ رَسُولُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ : إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , يَقُولُ : اسْتَمْتِعُوا ""","","","","","Book of Wills"
"13623","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، عَنْ طَاوُسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَمْ يُرَعْ عُمَرُ أَمِيرُ الْمُؤْمِنِينَ إِلا أُمَّ أَرَاكَةَ ، قَدْ خَرَجَتْ حُبْلَى , فَسَأَلَهَا عُمَرُ عَنْ حَمْلِهَا ؟ فَقَالَتِ : اسْتَمْتَعَ بِي سَلَمَةُ بْنُ أُمَيَّةَ بْنِ خَلَفٍ ، فَلَمَّا أَنْكَرَ صَفْوَانُ عَلَى ابْنِ عَبَّاسٍ بَعْضَ مَا يَقُولُ فِي ذَلِكَ ، قَالَ : فَسَلْ عَمَّكَ هَلِ اسْتَمْتَعَ ""","","","","","Book of Wills"
"13624","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ ، قَالَ : سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ : اسْتَمْتَعْنَا أَصْحَابَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَتَّى نُهِيَ عَمْرُو بْنُ حُرَيْثٍ ، قَالَ : وَقَالَ جَابِرٌ : إِذَا انْقَضَى الأَجَلُ ، فَبَدَا لَهُمَا أَنْ يَتَعَاوَدَا فَلْيُمْهِرُهَا مَهْرًا آخَرَ ، قَالَ : وَسَأَلَهُ بَعْضُنَا كَمْ تَعْتَدُّ ؟ قَالَ : حَيْضَةً وَاحِدَةً كُنَّ يَعْتَدِدْنَهَا لِلْمُسْتَمْتِعِ مِنْهُنَّ ""","","","","","Book of Wills"
"13625","وَقَالَ أَبُو الزُّبَيْرِ ، وَسَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ : اسْتَمْتَعَ مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ , مَقْدِمَهُ مِنَ الطَّائِفِ عَلَى ثَقِيفَ ، بِمَوْلاةِ ابْنِ الْحَضْرِمِيِّ , يُقَالُ لَهَا : مُعَانَةَ "" . قَالَ جَابِرٌ : ثُمَّ أَدْرَكَتْ مُعَانَةُ خِلافَةَ مُعَاوِيَةَ حَيَّةً ، فَكَانَ مُعَاوِيَةُ يُرْسِلُ إِلَيْهَا بِجَائِزَةٍ فِي كُلِّ عَامٍ , حَتَّى مَاتَتْ""","","","","","Book of Wills"
"13626","قَالَ أَبُو الزُّبَيْرِ : وَسَمِعْتُ طَاوُسًا , يَقُولُ : قَالَ ابْنُ صَفْوَانَ : يُفْتِي ابْنُ عَبَّاسٍ بِالزِّنَا ، قَالَ : فَعَدَّدَ ابْنُ عَبَّاسٍ رِجَالا كَانُوا مِنْ أَهْلِ الْمُتْعَةِ ، قَالَ : فَلا أَذْكُرُ مِمَّنْ عَدَّدَ غَيْرَ مَعْبَدِ بْنِ أُمَيَّةَ ""","","","","","Book of Wills"
"13627","قَالَ أَبُو الزُّبَيْرِ ، سَمِعْتُ جَابِرًا , يَقُولُ :  كُنَّانَسْتَمْتِعُ بِالْقَبْضَةِ مِنَ التَّمْرِ وَالدَّقِيقِ أَيَّامَ عَهْدِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَأَبِي بَكْرٍ حَتَّى نُهِيَ النَّاسُ فِي شَأْنِ عَمْرِو بْنِ حُرَيْثٍ ""","","","","","Book of Wills"
"13628","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ ، إِنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ : قَدِمَ عَمْرُو بْنُ حُرَيْثٍ مِنَ الْكُوفَةِ فَاسْتَمْتَعَ بِمَوْلاةٍ ، فَأُتِيَ بِهَا عُمَرَ وَهِيَ حُبْلَى فَسَأَلَهَا ، فَقَالَتِ : اسْتَمْتَعَ بِي عَمْرُو بْنُ حُرَيْثٍ فَسَأَلَهُ ، فَأَخْبَرَهُ بِذَلِكَ أَمْرًا ظَاهِرًا ، قَالَ : فَهَلا غَيْرَهَا فَذَلِكَ حِينَ نَهَى عَنْهَا ""","","","","","Book of Wills"
"13629","قَالَ ابْنُ جُرَيْجٍ : وَأَخْبَرَنِي مَنْ أُصَدِّقُ ، أَنَّ عَلِيًّا ، قَالَ بِالْكُوفَةِ :لَوْلا مَا سَبَقَ مِنْ رَأْيِ عُمَرَ بْنِ الْخَطَّابِ , أَوْ قَالَ : مِنْ رَأْيِ ابْنِ الْخَطَّابِ لأَمَرْتُ بِالْمُتْعَةِ ، ثُمَّ مَا زَنَا إِلا شَقِيٌّ ""","","","","","Book of Wills"
"13630","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سَأَلْتُ عَطَاءً : أَيَسْتَمْتِعُ الرَّجُلُ بِأَكْثَرَ مِنْ أَرْبَعٍ جَمِيعًا ؟ وَهَلِ الاسْتِمْتَاعُ إِحْصَانٌ ؟ وَهَلْ يَحِلُّ اسْتِمْتَاعُ الْمَرْأَةِ لِزَوْجِهَا إِنْ كَانَ بَتَّهَا ؟ فَقَالَ : مَا سَمِعْتُ فِيهِنَّ بِشَيْءٍ ، وَمَا رَاجَعْتُ فِيهِنَّ أَصْحَابِي ""","","","","","Book of Wills"
"13631","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ عُثْمَانَ بْنِ خُثَيْمٍ ، أَنَّ مُحَمَّدَ بْنَ الأَسْوَدِ بْنِ خَلَفٍ أَخْبَرَهُ ،  أَنَّ عَمْرَو بْنَ حَوْشَبٍ ، اسْتَمْتَعَ بِجَارِيَةٍ بِكْرٍ مِنْ بَنِي عَامِرِ بْنِ لُؤَيٍّ ، فَحَمَلَتْ ، فَذُكِرَ ذَلِكَ لِعُمَرَ فَسَأَلَهَا ؟ فَقَالَتِ : اسْتَمْتَعَ مِنْهَا عَمْرُو بْنُ حَوْشَبٍ فَسَأَلَهُ ؟ فَاعْتَرَفَ ، فَقَالَ عُمَرُ : مَنْ أَشْهَدْتَ ؟ قَالَ : لا أَدْرِي أَقَالَ : أُمَّهَا ، أَوْ أُخْتَهَا ، أَوْ أَخَاهَا وَأُمَّهَا ، فَقَامَ عُمَرُ عَلَى الْمِنْبَرِ ، فَقَالَ :مَا بَالُ رِجَالٍ يَعْمَلُونَ بِالْمُتْعَةِ وَلا يُشْهَدُونَ عُدُولا ، وَلَمْ يُبَيِّنُهَا إِلا حَدَدَتْهُ ""، قَالَ : أَخْبَرَنِي هَذَا الْقَوْلَ عَنْ عُمَرَ مَنْ كَانَ تَحْتَ مِنْبَرِهِ سَمِعَهُ حِينَ يَقُولُهُ ، قَالَ : فَتَلَقَّاهُ النَّاسُ مِنْهُ""","","","","","Book of Wills"
"13632","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنَّ حَسَنًا ، وَعَبْدَ اللَّهِ ابْنَيْ مُحَمَّدٍ ، أَخْبَرَاهُ ، عَنْ أَبِيهِمَا مُحَمَّدِ بْنِ عَلِيٍّ ، إِنَّهُ سَمِعَ أَبَاهُ عَلِيَّ بْنَ أَبِي طَالِبٍ ، يَقُولُ لابْنِ عَبَّاسٍ ، وَبَلَغَهُ أَنَّهُيُرَخِّصُ فِي الْمُتْعَةِ ، فَقَالَ لَهُ عَلِيٌّ : إِنَّكَ امْرُؤٌ تَائِهٌ ، إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : نَهَى عَنْهَا يَوْمَ خَيْبَرَ ، وَعَنْ لُحُومِ الْحُمُرِ الإِنْسِيَّةِ ""","","","","","Book of Wills"
"13633","عَنْ مَعْمَرٍ ، قَالَ : أَخْبَرَنِي الزُّهْرِي ، عَنْ خَالِدِ بْنِ الْمُهَاجِرِ بْنِ خَالِدٍ ، قَالَ :  أَرْخَصَ ابْنُ عَبَّاسٍ فِي الْمُتْعَةِ ، فَقَالَ لَهُ ابْنُ أَبِي عَمْرَةَ الأَنْصَارِيُّ : مَا هَذَا يَا أَبَا عَبَّاسٍ ؟ فَقَالَ ابْنُ عَبَّاسٍ : فَعَلْتُ مَعَ إِمَامِ الْمُتَّقِينَ ، فَقَالَ ابْنُ أَبِي عَمْرَةَ : اللَّهُمَّ غُفْرًا ، إِنَّمَاكَانَتِ الْمُتْعَةُ رُخْصَةً كَالضُّرُورَةِ إِلَى الْمَيْتَةِ ، وَالدَّمِ ، وَلَحْمِ الْخِنْزِيرِ ، ثُمَّ أَحْكَمَ اللَّهُ تَعَالَى الدِّينَ بَعْدُ ""","","","","","Book of Wills"
"13634","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ الرَّبِيعِ بْنِ سَبْرَةَ ، عَنْ أَبِيهِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : حَرَّمَ مُتْعَةَ النِّسَاءِ ""","","","","","Book of Wills"
"13635","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، قِيلَ لابْنِ عُمَرَ : إِنَّ ابْنَ عَبَّاسٍيُرَخِّصُ فِي مُتْعَةِ النِّسَاءِ ! فَقَالَ : مَا أَظُنُّ ابْنَ عَبَّاسٍ يَقُولُ هَذَا ، قَالُوا : بَلَى ، وَاللَّهِ إِنَّهُ لَيَقُولُهُ ، قَالَ : أَمَا وَاللَّهِ مَا كَانَ لِيَقُولَ هَذَا فِي زَمَنِ عُمَرَ ، وَإِنْ كَانَ عُمَرُ ، لَيُنَكِّلُكُمْ عَنْ مِثْلِ هَذَا ، وَمَا أَعْلَمُهُ إِلا السِّفَاحَ ""","","","","","Book of Wills"
"13636","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، قَالَ :  إِنِّيلأَرَى تَحْرِيمَهَا فِي الْقُرْآنِ ، قَالَ : فَقُلْتُ : أَيْنَ ؟ قَالَ : فَقَرَأَ عَلَيَّ هَذِهِ الآيَةَ :  وَالَّذِينَ هُمْ لِفُرُوجِهِمْ حَافِظُونَ { 5 } إِلا عَلَى أَزْوَاجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَانُهُمْ ""","","","","","Book of Wills"
"13637","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، قَالَ  : سُئِلَ الْقَاسِمُ ، "" عَنِالْمُتْعَةِ ، قَالَ : فَتَلا هَذِهِ الآيَةَ :  إِلا عَلَى أَزْوَاجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَانُهُمْ ""","","","","","Book of Wills"
"13638","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : أَخْبَرَنِي عُرْوَةُ بْنُ الزُّبَيْرِ ،  أَنَّ رَبِيعَةَ بْنَ أُمَيَّةَ بْنَ خَلَفٍ ، تَزَوَّجَ مُوَلَّدَةً مِنْ مُوَلَّدَاتِ الْمَدِينَةِ , بِشَهَادَةِ امْرَأَتَيْنِ إِحْدَاهُمَا خَوْلَةُ بِنْتُ حَكِيمٍ ، وَكَانَتِ امْرَأَةً صَالِحَةً ، فَلَمْ يَفْجَأْهُمْ إِلا الْوَلِيدَةُ قَدْ حَمَلَتْ ، فَذَكَرَتْ ذَلِكَ خَوْلَةُ لِعُمَرَ بْنِ الْخَطَّابِ , فَقَامَ يَجُرُّ صَنِفَةَ رِدَائِهِ مِنَ الْغَضَبِ حَتَّى صَعِدَ الْمِنْبَرَ ، فَقَالَ : إِنَّهُ بَلَغَنِي أَنَّرَبِيعَةَ بْنَ أُمَيَّةَ تَزَوَّجَ مُولَّدَةً مِنْ مُولَّدَاتِ الْمَدِينَةِ بِشَهَادَةِ امْرَأَتَيْنِ ، وَإِنِّي لَوْ كُنْتُ تَقَدَّمْتُ فِي هَذَا لَرَجَمْتُ ""","","","","","Book of Wills"
"13639","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : ازْدَادَتِ الْعُلَمَاءُ لَهَا مِفْتَاحًا حِينَ "" , قَالَ الشَّاعِرُ : يَا صَاحِ هَلْ لَكَ فِي فُتْيَا ابْنِ عَبَّاسٍ""","","","","","Book of Wills"
"13640","عَنْ مَعْمَرٍ ، وَالْحَسَنِ ، قَالا : مَا حَلَّتِ الْمُتْعَةُ قَطُّ إِلا ثَلاثًا فِي عُمْرَةِ الْقَضَاءِ ، مَا حَلَّتْ قَبْلَهَا وَلا بَعْدَهَا ""","","","","","Book of Wills"
"13641","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، عَنْ رَبِيعِ بْنِ سَبْرَةَ ، عَنْ أَبِيهِ ، قَالَ :  خَرَجْنَا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنَ الْمَدِينَةِ فِي حَجَّةِ الْوَدَاعِ حَتَّى إِذَا كُنَّا بِعُسْفَانَ , قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِنَّ الْعُمْرَةَ قَدْ دَخَلَتْ فِي الْحَجِّ , فَقَالَ لَهُ سُرَاقَةُ : يَا رَسُولَ اللَّهِ , عَلِّمْنَا تَعْلِيمَ قَوْمٍ كَأَنَّمَا وُلِدُوا الْيَوْمَ ، عُمْرَتُنَا هَذِهِ أَلِعَامِنَا هَذَا أَمْ لِلأَبَدِ ؟ قَالَ : بَلْ لِلأَبَدِ ، فَلَمَّا قَدِمْنَا مَكَّةَ ، طُفْنَا بِالْبَيْتِ ، وَبَيْنَ الصَّفَا وَالْمَرْوَةِ ، ثُمَّ أَمَرَنَا بِمُتْعَةِ النِّسَاءِ ، فَرَجَعَنْا إِلَيْهِ , فَقُلْنَا : أَنْ قَدْ أَبَيْنَ إِلا إِلَى أَجَلٍ مُسَمًّى ، قَالَ : فَافْعَلُوا ، قَالَ : فَخَرَجْتُ أَنَا وَصَاحِبٌ لِي , عَلَيَّ بُرْدٌ وَعَلَيْهِ بُرْدٌ ، فَدَخَلْنَا عَلَى امْرَأَةٍ فَعَرَضْنَا عَلَيْهَا أَنْفُسَنَا فَجَعَلَتْ تَنْظُرُ إِلَى بُرْدِ صَاحِبِي فَتَرَاهُ أَجْوَدَ مِنْ بُرْدِي ، وَتَنْظُرُ إِلَيَّ فَتَرَانِي أَشَبَّ مِنْهُ ، فَقَالَتْ : بُرْدٌ مَكَانَ بُرْدٍ وَاخْتَارَتْنِي فَتَزَوَّجْتُهَا بِبُرْدِي ، فَبِتَّ مَعَهَا تِلْكَ اللَّيْلَةَ فَلَمَّا أَصْبَحْتُ غَدَوْتُ إِلَى الْمَسْجِدِ , فَإِذَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، عَلَى الْمِنْبَرِ , يَقُولُ :مَنْ كَانَ تَزَوَّجَ امْرَأَةً إِلَى أَجَلٍ فَلْيُعْطِهَا مَا سَمَّى لَهَا ، وَلا يَسْتَرْجِعْ مِمَّا أَعْطَاهَا شَيْئًا ، وَيُفَارِقُهَا , فَإِنَّ اللَّهَ عَزَّ وَجَلَّ قَدْ حَرَّمَهَا عَلَيْكُمْ إِلَى يَوْمِ الْقِيَامَةِ ""","","","","","Book of Wills"
"13642","عَنِ الثَّوْرِيِّ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي أُمَيَّةَ ،  عَنْ رَجُلٍ ، قَالَ : سُئِلَ ابْنُ عُمَرَ عَنِالْمُتْعَةِ ؟ فَقَالَ : هُوَ السِّفَاحُ ""","","","","","Book of Wills"
"13643","عَنِ الثَّوْرِيِّ ، عَنْ مَالكِ بْنِ مُغَوِّلٍ ، عَنِ الْحَسَنِ ، قَالَ : مَا كَانَتِ الْمُتْعَةُ إِلا ثَلاثَةَ أَيَّامٍ , حَتَّى حَرَّمَهَا اللَّهُ عَزَّ وَجَلَّ ، وَرَسُولُهُ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Wills"
"13644","عَنِ الثَّوْرِيِّ ، عَنْ صَاحِبٍ لَهُ ، عَنِ الْحَكَمِ ، قَالَ : قَالَ ابْنُ مَسْعُودٍ : نَسَخَهَا الطَّلاقُ ، وَالْعِدَّةُ ، وَالْمِيرَاثُ ""","","","","","Book of Wills"
"13645","عَنِ الثَّوْرِيِّ ، عَنْ دَاوُدَ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ : نَسَخَهَا الْمِيرَاثُ ""","","","","","Book of Wills"
"13646","وَسَمِعْتُ رَجُلا ، يُحَدِّثُ مَعْمَرًا ، قَالَ : أَخْبَرَنِي الأَشْعَثُ ، وَالْحَجَّاجُ بْنُ أَرْطَأَةَ ، أَنَّهُمَا سَمِعَا أَبَا إِسْحَاقَ يُحَدِّثُ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ ، إِنَّهُ قَالَ : نَسَخَ رَمَضَانُ كُلَّ صَوْمٍ ، وَنَسَخَتِ الزَّكَاةُ كُلَّ صَدَقَةٍ ، وَنَسَخَ الْمُتْعَةَ الطَّلاقُ وَالْعِدَّةُ وَالْمِيرَاثُ ""، قَالَ : وَسَمِعْتُ غَيْرَ الْحَجَّاجِ يُحَدِّثُ ، عَنْ مُحَمَّدٍ ، عَنْ عَلِيٍّ ، قَالَ : "" وَنَسَخَتِ الضَّحِيَّةُ كُلَّ ذَبْحٍ""","","","","","Book of Wills"
"13647","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ ، عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ الأَعْلَى ، عَنْ سُوَيْدِ بْنِ غَفْلَةَ ، قَالَ : سَمِعْتُ عُمَرَ : يَنْهَى عَنْ مُتْعَةِ النِّسَاءِ ""","","","","","Book of Wills"
"13648","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ إِسْمَاعِيلَ ، عَنْ قَيسٍ ، عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ ، قَالَ :  كُنَّا نَغْزُو مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ،فَتَطُولُ غُرْبَتُنَا , فَقُلْنَا : أَلا نَتَخَصَّى يَا رَسُولَ اللَّهِ ؟ فَنَهَانَا ، ثُمَّ رَخَّصَ أَنْ نَتَزَوَّجَ الْمَرْأَةَ إِلَى أَجَلٍ بِالشَّيْءِ ، ثُمَّ نَهَانَا عَنْهَا يَوْمَ خَيْبَرَ ، وَعَنْ لُحُومِ الْحُمُرِ الإِنْسِيَّةِ ""","","","","","Book of Wills"
"13649","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أُعْطِيَ قُوَّةَ أَرْبَعِينَ ، أَوْ خَمْسَةٍ وَأَرْبَعِينَ فِي الْجِمَاعِ ""، أَنَا أَشُكُّ""","","","","","Book of Wills"
"13650","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَلِيِّ بْنِ زَيْدِ بْنِ جُدْعَانَ ، قَالَ : سَمِعْتُ سَعِيدَ بْنَ الْمُسَيِّبِ , يَقُولُ : أُعْطِيَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قُوَّةَ بُضْعِ خَمْسَةٍ وَأَرْبَعِينَ رَجُلا ""","","","","","Book of Wills"
"13651","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أُخْبِرْتُ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ : أُعْطِيَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بُضْعَ خَمْسَةٍ وَأَرْبَعِينَ رَجُلا ، وَإِنَّهُ لَمْ يَكُنْ يُقِيمُ عِنْدَ امْرَأَةٍ مِنْهُنَّ يَوْمًا تَامًّا كَانَ يَأْتِي هَذِهِ السَّاعَةَ وَهَذِهِ السَّاعَةَ يَتَنَقَّلُ بَيْنَهُنَّ كَذَلِكَ الْيَوْمَ حَتَّى إِذَا كَانَ اللَّيْلُ قَسَمَ لِكُلِّ امْرَأَةٍ مِنْهُنَّ لَيْلَتَهَا ""","","","","","Book of Wills"
"13652","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أُخْبِرْتُ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أُعْطِيتُ الْكَفِيتُ ، قِيلَ : وَمَا الْكَفِيتُ ؟ قَالَ : قُوَّةُ ثَلاثِينَ رَجُلا فِي الْبُضَاعِ , وَكَانَ لَهُ تِسْعُ نِسْوَةٍ وَكَانَ يَطُوفُ عَلَيْهِنَّ جَمِيعًا فِي لَيْلَةٍ "". قَالَ ابْنُ جُرَيْجٍ : قَالَ سُلَيْمَانُ بْنُ مُوسَى : سَأَلْتُ هَلْ كَانَ أَزْوَاجُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أُرْخِصَ لَهُنَّ أَنْ يُصَلِّينَ عَلَى ظُهُورِ الْبُيُوتِ ؟ , فَقِيلَ لِي : لَمْ يَكُنَّ يُصَلِّينَ إِلا بِالأَرْضِ ""","","","","","Book of Wills"
"13653","عَنْ مَعْمَرٍ ، وَغَيْرِهِ ، يَقُولُ : وَيْحَكَ مَعْنَى وَيْلَكَ ، وَالْوَيْلُ وَوَيْلَكَ مِثْلُ وَيْحَكَ ، مِثْلُ وَيْحَكَ ""","","","","","Book of Wills"
"13654","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الْحَسَنِ ، وَقَتَادَةَ فيالرجل يموت وعليه دين إلى أجل ، قَالا :  إِذَا أَفْلَسَ أَوْ مَاتَ حُلَّ دَيْنُهُ ""","","","","","Book of Wills"
"13655","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ شُرَيْحٍ ، وَعَنْ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالا : إِذَا جَعَلُوا الدَّيْنَ فِي ثِقَةٍ فَهُوَ إِلَى أَجَلِهِ ""","","","","","Book of Wills"
"13656","أَخْبَرَنَا الثَّوْرِيُّ ، فِيالرَّجُلِ يَمُوتُ وَيَتْرُكُ الدَّيْنَ ، ثُمَّ يَقْتَسِمُ وَرَثَتُهُ مَالَهُ ، ثُمَّ يُفْلِسُ بَعْضُهُمْ ، قَالَ :  يُبْدَأُ بِالَّذِي وُجِدَ عِنْدَهُ الْمَالُ مِنْهُمْ ، وَيَتَحَوَّلُ الْوَرَثَةُ بَعْضُهُمْ عَلَى بَعْضٍ ""، قَالَ ابْنُ جُرَيْجٍ : عَنْ عَطَاءٍ ، وَعَمْرِو بْنِ دِينَارٍ ، مِثْلَ ذَلِكَ""","","","","","Book of Wills"
"13657","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، قَالَ : قَدِمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْمَدِينَةَ وَهُمْ يُسْلِفُونَ فِي الثِّمَارِ ، فَقَالَ : مَنْ سَلَّفَ فِي ثَمَرِهِ فَهُوَ رِبًا ، إِلا بِكَيْلٍ مَعْلُومٍ إِلَى أَجَلٍ مَعْلُومٍ ""","","","","","Book of Wills"
"13658","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ أَبِي نُجَيْحٍ ، عَنْ عَبْدِ اللَّهِ بْنِ كَثِيرٍ ، عَنْ أَبِي الْمِنْهَالِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَدِمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْمَدِينَةَ وَهُمْ يُسْلِفُونَ فِي الثِّمَارِ ، السَّنَتَيْنِ ، وَالثَّلاثِ سِنِينَ ، فَقَالَ : النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ سَلَّفَ بِثَمَرِهِ فَبِكَيْلٍ مَعْلُومٍ إِلَى أَجَلٍ مَعْلُومٍ ""، أَخْبَرَنَا الثَّوْرِيُّ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ عَبْدِ اللَّهِ بْنِ كَثِيرٍ ، عَنْ أَبِي الْمِنْهَالِ ، عَنِ ابْنِ عَبَّاسٍ مِثْلَهُ ، إِلا أَنَّهُ قَالَ : فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" فِي كَيْلٍ مَعْلُومٍ وَوَزْنٍ مَعْلُومٍ ""","","","","","Book of Wills"
"13659","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، وَعَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ :  أَنَّهُ كَانَلا يَرَى بَأْسًا أَنْ يُسَلِّفَ الرَّجُلُ الْوَرَقَ فِي الشَّيْءِ إِلَى أَجَلٍ مَعْلُومٍ ، وَكَيْلٍ مَعْلُومٍ ""","","","","","Book of Wills"
"13660","أَخْبَرَنَا مَعْمَرٌ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، قَالَ : أَخْبَرَنِي مَنْ ، سَمِعَ ابْنَ عُمَرَ ، يَقُولُ : وَدَدْتُ أَنَّ رَجُلا قَدْ أَخَذَ مِنِّي دِينَارًا بِطَعَامٍ ، وَيَأْتِينِي بِهِ مِنَ الشَّامِ ""","","","","","Book of Wills"
"13661","وَأَخْبَرَنَا مَعْمَرٌ ، قَالَ : سَأَلَ رَجُلٌ قَتَادَةَ ، فَقَالَ :رَجُلٌ لِي عَلَيْهِ طَعَامٌ ، لَمْ يَكُنْ عِنْدَهُ فَاشْتَرَاهُ مِنَ السُّوقِ ، قَالَ :  لا أَدْرِي ، يَأْتِينِي بِهِ مِنْ حَيْثُ شَاءَ ""","","","","","Book of Wills"
"13662","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، عَنْ أَبِي حَسَّانَ الأَعْرَجِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ :  أَشْهَدُ أَنَّالسَّلَفَ الْمَضْمُونَ إِلَى أَجَلٍ قَدْ أَحَلَّهُ اللَّهُ ، وَأَذِنَ فِيهِ ، فَلِمَ قَالَ اللَّهُ :  إِذَا تَدَايَنْتُمْ بِدَيْنٍ إِلَى أَجَلٍ مُسَمًّى ""","","","","","Book of Wills"
"13663","أَخْبَرَنَا مَعْمَرٌ ، عَمَّنْ ، سَمِعَ إِبْرَاهِيمُ ، يَقُولُ : فِيرَجُلٍ سَلَّفَ فِي بُرٍّ حَدِيثٍ الْعَامَ فَمَطَلَهُ فِي الْعَامِ الآخَرِ ، قَالَ :  يُعْطِيهِ مِنْ حَدِيثٍ الْعَامَ الَّذِي مَطَلَهُ إِلَيْهِ ""","","","","","Book of Wills"
"13664","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ :  أَنَّهُكَرِهَ إِلَى الأَنْدَرِ ، وَالْعَصِيرِ ، وَالْعَطَاءِ أَنْ يُسَلَّفَ إِلَيْهِ ، وَلَكِنْ يُسَمِّي شَهْرًا ""","","","","","Book of Wills"
"13665","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ : كَرِهَ أَنْ يُسَلِّفَ إِلا إِلَى شَهْرٍ مَعْلُومٍ ""","","","","","Book of Wills"
"13666","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ عَلْقَمَةَ بْنِ مَرْثَدٍ ، عَنْ رَزِينٍ ، عَنِ ابْنِ الْمُسَيِّبِ ، سُئِلَ عَنْ :سَلَفِ الْحِنْطَةِ ، وَالْكَرَابِيسِ ، وَالثِّيَابِ ، فَقَالَ :  ذَرْعٌ مَعْلُومٌ إِلَى أَجَلٍ مَعْلُومٍ ، وَالْحِنْطَةُ بِكَيْلٍ مَعْلُومٍ إِلَى أَجَلٍ مَعْلُومٍ ""","","","","","Book of Wills"
"13667","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، قَالَ :  إِنَّمَارُخِّصَ فِي التَّسْلِيفِ ، لأَنَّ الأَسْعَارَ تَخْتَلِفُ ، لا تَدْرِي أَيْكُونُ عَلَيْكَ أَمْ لا ""","","","","","Book of Wills"
"13668","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ : أَنَّهُ كَانَيَكْرَهُ أَنْ يَشْتَرِيَ مِنَ الرَّجُلِ ، وَيَشْتَرِطَ عَلَيْهِ بِأَكْثَرِ ، أَوْ بِأَقَلِّ مِنَ السِّعْرِ ، يَقُولُ :  هُوَ لِي كَيْفَ مَا قَامَ مِنَ السِّعْرِ ""","","","","","Book of Wills"
"13669","قَالَ الثَّوْرِيُّ : إِذَا سَلَّفْتَ سَلَفًا فَبَيِّنْهُ إِلَى أَجَلٍ مَعْلُومٍ ، وَفِي مَكَانٍ مَعْلُومٍ ، فَإِنْ سَمَّيْتَ الأَجَلَ ، وَلَمْ تُسَمِّ الْمَكَانَ فَهُوَ مَرْدُودٌ ، حَتَّى تُسَمِّيَ حَيْثُ يُوَفِّيكَ الطَّعَامَ ""","","","","","Book of Wills"
"13670","أَخْبَرَنَا الثَّوْرِيُّ ، عَنِ الأَسْوَدِ بْنِ قَيْسٍ ، عَنْ نُبَيْحٍ ، عَنْ أَبِي سَعِيدٍ ، قَالَ : السَّلَمُ كَمَا يَقُومُ مِنَ السِّعْرِ رِبًا ، وَلَكِنْ تُسَمِّي بِدَرَاهِمَكَ كَيْلا مَعْلُومًا ، وَاسْتَكْثِرْ بِهَا مَا اسْتَطَعْتَ ""","","","","","Book of Wills"
"13671","أَخْبَرَنَا إِبْرَاهِيمُ بْنُ عُمَرَ ، عَنْ عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ ، عَنِ ابْنِ سِيرِينَ :  أَنَّهُ كَانَيَكْرَهُ أَنْ يُسَلِّفَ فِي الطَّعَامِ حَتَّى يَنْزِلَ ""","","","","","Book of Wills"
"13672","قَالَ عَبْدُ الْكَرِيمِ : وَقَالَ الْحَسَنُ : لا بَأْسَ بِالتَّسْلِيفِ ، إِذَا كَانَ كَيْلا مَعْلُومًا إِلَى أَجَلٍ مَعْلُومٍ ""","","","","","Book of Wills"
"13673","قَالَ : وَكَانَ ابْنُ طَاوُسٍ يَقُولُ : لا يُسَلَّفُ إِلا مَنْ لَهُ حَرْثٌ أَوْ نَخْلٌ ""","","","","","Book of Wills"
"13674","قُلْتُ لِلثَّوْرِيِّ وَأَنَا بِمَكَّةَ : إِنِّي أُقِيمُ فِي هَذِهِ الأَرْضِ ، وَأَحْتَاجُ إِلَى الْفَاكِهَةِ ،وَأَسْتَلِفُ الدِّرْهَمَ فِي الرُّمَّانِ ، وَالْقِثَّاءِ ، وَالْمَوزِ ، وَأَشْبَاهِهِ ، فَكَرِهَهُ وَقَالَ :  لا تَفْعَلْ فَإِنَّهُ مُتَفَاوِتٌ ""","","","","","Book of Wills"
"13675","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ سُلَيْمَانَ الشَّيْبَانِيِّ ، عَنْ مُحَمَّدِ بْنِ أَبِي الْمُجَالِدِ ، قَالَ : أَرْسَلَنِي ابْنُ أَبِي بُرْدَةَ ، وَعَبْدُ اللَّهِ بْنُ شَدَّادٍ ، إِلَى عَبْدِ الرَّحْمَنِ بْنِ أَبْزَى الْخُزَاعِيِّ ، وَإِلَى عَبْدِ اللَّهِ بْنِ أَبِي أَوْفَى الأَسْلَمِيِّ ، فَسَأَلْتُهُمَا عَنِ التَّسْلِيفِ ، فَقَالا :  كُنَّا نُصِيبُ الْمَغَانِمَ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَيَأْتِينَا أَنْبَاطٌ مِنْ أَنْبَاطِ الشَّامِ ،فَنُسَلِّفُهُمْ فِي الْحِنْطَةِ ، وَالشَّعِيرِ ، وَالزَّبِيبِ ، إِلَى أَجَلٍ مَعْلُومٍ "" ، قَالَ : قُلْتُ : "" لَهُمْ زَرْعٌ ؟ "" ، قَالا : "" مَا كُنَّا نَسْأَلُهُمْ عَنْ ذَلِكَ ""، قَالَ عَبْدُ الرَّزَّاقِ : وَبِهِ نَأْخُذُ""","","","","","Book of Wills"
"13676","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ :  أَنَّهُكَرِهَ الدِّيَاسَ ، وَالْعَطَاءَ ، وَالرِّزْقَ ، وَالْجَزَازَ ، وَالْحَصَادَ ، وَلَكِنْ لِيُسَمِّ شَهْرًا ""، الْجَزَازُ يَعْنِي : جُدَادُ النَّخْلِ ، عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ مِثْلَهُ ، وَبِهِ يَأْخُذُ عَبْدُ الرَّزَّاقِ""","","","","","Book of Wills"
"13677","أَخْبَرَنَا مَعْمَرٌ ، قَالَ : أَخْبَرَنِي عَلِيُّ ابْنُ بَذِيمَةَ ، أَنَّهُ سَمِعَ سَعِيدَ بْنَ جُبَيْرٍ ، وَسُئِلَ عَنِالرَّهْنِ ، وَالْكَفِيلِ فِي السَّلَفِ فَكَرِهَهُ ، وَقَالَ :  ذَلِكَ الرِّبْحُ الْمَضْمُونَ ""","","","","","Book of Wills"
"13678","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ :  أَنَّهُكَرِهَ الرَّهْنَ ، وَالْكَفِيلَ فِي السَّلَفِ ""","","","","","Book of Wills"
"13679","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي يَزِيدَ ، عَنْ أَبِي عِيَاضٍ ، عَنْ عَلِيِّ بْنِ أَبِي طَالِبٍ رَضِيَ اللَّهُ عَنْهُ :  أَنَّهُكَرِهَ الرَّهْنَ ، وَالْكَفِيلَ فِي السَّلَفِ ""","","","","","Book of Wills"
"13680","عَنِ الثَّوْرِيِّ ، عَنْ مُحَمَّدِ بْنِ قَيْسٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ يُسْأَلُ عَنِالتَّسْلِيفِ ، جِرْبَانًا مَعْلُومًا إِلَى أَجَلٍ مَعْلُومٍ ، فَلَمْ يَرَ بِهِ بَأْسًا ، فَقِيلَ لَهُ :  أَخَذَ رَهْنًا "" ، فَقَالَ : "" ذَلِكَ السَّكُّ الْمَضْمُونُ ""","","","","","Book of Wills"
"13681","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ هِشَامِ ابْنِ هَجِيرٍ ، قَالَ : سَمِعْتُ الْحَسَنَ الْبَصْرِيَّ ، يَقُولُ :  كَانَ الْمُسْلِمُونَ يَقُولُونَ :مَنْ سَلَّفَ سَلَفًا ، فَلا يَأْخُذُ رَهْنًا ، وَلا صَبِيرًا ""","","","","","Book of Wills"
"13682","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : إِنْ كَانَ التَّسْلِيفُ لَيْسَ بِهِ فِي الأَصْلِ بَأْسٌ ، فَلا بَأْسَ بِالرَّهْنِ ، وَالْحَمِيلِ فِيهِ ""","","","","","Book of Wills"
"13683","أَخْبَرَنَا مَعْمَرٌ ، عَنْ مَنْصُورٍ ، وَغَيْرِهِ ، عَنْ إِبْرَاهِيمَ ، وَالشَّعْبِيِّ :  أَنَّهُمَا كَانَالا يَرَيَانِ بَأْسًا أَنْ يُسَلِّفَ وَيَأْخُذَ رَهْنًا أَوْ حَمِيلا ""","","","","","Book of Wills"
"13684","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، قَالَ : لا بَأْسَ بِالرَّهْنِ ، وَالْكَفِيلِ فِي السَّلَفِ ""، عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، وَالأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، مِثْلَهُ""","","","","","Book of Wills"
"13685","أَخْبَرَنَا مُحَمَّدُ بْنُ رَاشِدٍ ، أَنَّهُ سَمِعَ مَكْحُولا ، يَقُولُ : لا بَأْسَ بِالرَّهْنِ ، وَالْكَفِيلِ فِي السَّلَفِ ""","","","","","Book of Wills"
"13686","عَنِ الثَّوْرِيِّ ، عَنْ يَزِيدَ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّهُ كَانَلا يَرَى بِالرَّهْنِ ، وَالْكَفِيلِ فِي السَّلَفِ بَأْسًا ""","","","","","Book of Wills"
"13687","أَخْبَرَنَا مَعْمَرٌ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، أَنَّ رَجُلا كَانَ يَطْلُبُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِحَقٍّ ، فَأَغْلَظَ لَهُ ، فَقَالَ : فَأَرْسَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى يَهُودِيٍّ لِلتَّسْلِيفِ مِنْهُ ، فَأَبَى أَنْ يُسَلِّفَهُ إِلا بِرَهْنٍ ، فَبَعَثَ إِلَيْهِ بِدِرْعِهِ ، وَقَالَ :  وَاللَّهِإِنِّي لأَمِينٌ فِي الأَرْضِ ، أَمِينٌ فِي السَّمَاءِ ""","","","","","Book of Wills"
"13688","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، قَالَ : سَمِعْتُ شَيْخًا مِنْ بَجِيلَةَ ، يَقُولُ : سَمِعْتُ الشَّعْبِيَّ ، يَقُولُ : وَسُئِلَ عَنِالرَّهْنِ ، وَالْكَفِيلِ فِي السَّلَفِ ، فَقَالَ :  هُوَ أَحَلُّ مِنْ مَاءِ الْفُرَاتِ ""","","","","","Book of Wills"
"13689","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ عَبْدِ اللَّهِ ، قَالَ : حَدَّثَنِي ابْنُ عَوْنٍ ، قَالَ : سَأَلْتُ عَنْهُ الشَّعْبِيَّ ، فَقَالَ : وَمَنْ يَكْرَهُهُ ؟، فَقُلْتُ : أَلا أُحَدِّثُكَ ؟ ، قَالَ : أَعَنِ الأَحْيَاءِ ، أَوْ عَنِ الأَمْوَاتِ ؟ ، قُلْتُ : بَلْ عَنِ الأَحْيَاءِ ، قَالَ : لا حَاجَةَ لَنَا فِي حَدِيثِكَ عَنِ الأَحْيَاءِ ""","","","","","Book of Wills"
"13690","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ بْنِ يَزِيدَ ، عَنْ عَائِشَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : ابْتَاعَ مِنْ يَهُودِيٍّ أَصْوَعًا مِنْ دَقِيقٍ ، وَرَهَنَهُ دِرْعَهُ ""","","","","","Book of Wills"
"13691","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، وَعَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ : كَرِهَا أَنْ يُسَلِّفَ الرَّجُلُ فِي السِّلْعَةِ ، وَيَأْخُذَ بَعْضَ سِلْعَتِهِ ، وَبَعْضَ رَأْسِ مَالِهِ ""","","","","","Book of Wills"
"13692","عَنِ الثَّوْرِيِّ ، عَنْ مُطَرِّفٍ ، وَجَابِرٍ ، عَنِ الشَّعْبِيِّ أَنَّهُ :  كَانَيَكْرَهُ بَعْضَ سَلَفِهِ دَرَاهِمَ وَبَعْضَهُ طَعَامًا ""","","","","","Book of Wills"
"13693","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، وَالأَعْمَشِ ، عَنْ إِبْرَاهِيمَ : أَنَّهُ كَانَيَكْرَهُ إِذَا أَسْلَفَ لِرَجُلٍ فِي طَعَامٍ أَنْ يَأْخُذَ بَعْضَهُ طَعَامًا ، وَبَعْضَهُ دَرَاهِمَ  ، قَالَ : "" فَإِنْ أَرَادَ الإِحْسَانَ إِلَيْهِ فَلْيَبْتَعْ بِالدَّرَاهِمَ ، وَلْيَدَعْ لَهُ مَا بَقِيَ ""، أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، وَمَنْصُورٍ ، عَنْ إِبْرَاهِيمَ مِثْلَهُ ، عَنِ الثَّوْرِيِّ ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ ، مِثْلَهُ سَوَاءً ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، وَالزُّهْرِيِّ ، مِثْلَ قَوْلِ الْحَسَنِ وَإِبْرَاهِيمَ""","","","","","Book of Wills"
"13694","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الأَعْلَى ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّهُ كَانلا يَرَى بَأْسًا إِذَا سَلَّفَ الرَّجُلُ فِي طَعَامٍ أَنْ يَأْخُذَ بَعْضَهُ طَعَامًا ، وَبَعْضَهُ دَرَاهِمَ ، وَيَقُولُ : هُوَ الْمَعْرُوفُ ""","","","","","Book of Wills"
"13695","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ سَلَمَةَ بْنِ مُوسَى ، قَالَ : سَأَلْتُ سَعِيدَ بْنَ جُبَيْرٍ ، عَنِالرَّجُلِ يَأْخُذُ بَعْضَ رَأْسِ مَالِهِ ، وَبَعْضَ سَلَفِهِ ، فَقَالَ : قَالَ ابْنُ عَبَّاسٍ : ذَلِكَ الْمَعْرُوفُ ""","","","","","Book of Wills"
"13696","أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ كَثِيرٍ ، عَنْ شُعْبَةَ ، عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ ، عَنْ مُحَمَّدِ بْنِ الْحَنَفِيَّةِ ، أَنَّهُ قَالَ : لا بَأْسَ بِهِ ، هُوَ الْمَعْرُوفُ ""، قَالَ : وَكَانَ الْحَكَمُ لا يَرَى بِهِ بَأْسًا""","","","","","Book of Wills"
"13697","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ أَبِي السَّوْدَاءِ ، قَالَ : تَقَدَّمْتُ أَنَا وَأَخٌ لِي إِلَى شُرَيْحٍ ، فَسَأَلْتُهُ عَنْرَجُلٍ أَسْلَمْنَا إِلَيْهِ سِلْمًا ، فَلَمَّا حَلَّ الأَجَلُ ، قَالَ : لَيْسَ عِنْدِي كُلُّ الطَّعَامِ ، فَإِنْ شِئْتُمْ أَنْ تَأْخُذُوا مِنْ بَعْضِ الطَّعَامِ ، وَبَعْضِ رَأْسِ مَالِكُمْ ، وَتُحْسِنُوا ، قَالَ : قُلْنَا : نَسْأَلُ عَنْ ذَلِكَ ، قَالَ : فَسَأَلْنَا شُرَيْحًا ، فَقَالَ :  إِمَّا أَنْ تَأْخُذُوا الطَّعَامَ ، وَإِمَّا أَنْ تَأْخُذُوا رَأْسَ مَالِكُمْ "" . أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ جَابِرٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : "" أَنَّهُ لَمْ يَرَ بِهِ بَأْسًا ""","","","","","Book of Wills"
"13698","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إِذَا سَلَّفْتَ فِي شَيْءٍ فَلا تَأْخُذْ إِلا رَأْسَ مَالِكَ ، أَوِ الَّذِي سَلَّفْتَ فِيهِ ""","","","","","Book of Wills"
"13699","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا سَلَّفْتَ سَلَفًا ، فَلا تَصْرِفْهُ فِي شَيْءٍ حَتَّى تَقْبِضَهُ ""، أَخْبَرَنَا إِبْرَاهِيمُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ الْكَرِيمِ ، عَنِ الْحَسَنِ ، وَابْنِ سِيرِينَ مِثْلَهُ""","","","","","Book of Wills"
"13700","عَنِ الثَّوْرِيِّ ، عَنِ الْحَسَنِ بْنِ عَطِيَّةَ الْعَوْفِيِّ ، عَنْ أَبِيهِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إِذَا سَلَّفْتَ سَلَفًا ، فَلا تَصْرِفْهُ فِي شَيْءٍ حَتَّى تَقْبِضَهُ ""","","","","","Book of Wills"
"13701","أَخْبَرَنَا هِشَامُ بْنُ حَسَّانَ ، عَنْ مُحَمَّدٍ ، وَالْحَسَنُ :  أَنَّهُمَاكَرِهَا إِذَا سَلَّفْتَ فِي وَزْنٍ أَنْ تَأْخُذَ كَيْلا ، أَوْ فِي كَيْلٍ أَنْ تَأْخُذَ وَزْنًا ""، وَذَكَرَهُ الثَّوْرِيُّ ، عَنْ هِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ مِثْلَهُ""","","","","","Book of Wills"
"13702","عَنِ الثَّوْرِيِّ ، عَنْ أَسْلَمَ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ : أَنَّهُ كَانَيَكْرَهُ أَنْ يُسَلِّفَ الرَّجُلُ فِي أَصْنَافٍ ، وَيَقُولُ :  إِنْ كَانَ بُرًّا أَعْطَيْتَنِي عَشَرَةَ أَذْهَابٍ ، وَإِنْ كَانَ شَعِيرًا أَعْطَيْتَنِي عِشْرِينَ ، وَإِنْ كَانَ تَمْرًا أَعْطَيْتَنِي ثَلاثِينَ ""","","","","","Book of Wills"
"13703","أَخْبَرَنَا مَعْمَرٌ ، عَنْ عَمْرِو بْنِ سُلَيْمٍ ، قَالَ : سَأَلْنَا طَاوُسًا ، فَقُلْتُ :سَلَّفْتُ فِي شَيْءٍ أَصْرِفُهُ فِي غَيْرِهِ ؟ ، فَقَالَ :  لا بَأْسَ أَنْ تَصْرِفَهُ فِي غَيْرِهِ بِالْقِيمَةِ ، إِلا أَنْ تَقْبَلَهُ فَتَأْخُذَ بِالدَّنَانِيرِ مَا شِئْتَ ""، وَبِهِ يَأْخُذُ أَبُو بَكْرٍ""","","","","","Book of Wills"
"13704","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِكِ بْنِ مَيْسَرَةَ ، عَنْ طَاوُسٍ ، قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ ، عَنْرَجُلٍ سَلَّفَ فِي حَالٍ دِقًّ فَلَمْ يَجِدْهَا عِنْدَ صَاحِبِهِ ، أَيَأْخُذُ حِلَلا بِقِيمَتِهَا ؟ ، فَكَرِهَهُ ، قَالَ :  لا يَأْخُذُ مِنْهُ غَيْرَ ذَلِكَ ""","","","","","Book of Wills"
"13705","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، قَالَ : سَمِعْتُ أَبَا الشَّعْثَاءِ ، يَقُولُ : إِذَا سَلَّفْتَ فِي شَيْءٍ فَلا تَأْخُذْ إِلا الَّذِي سَلَّفْتَ فِيهِ ، أَوْ رَأْسَ مَالِكَ ""","","","","","Book of Wills"
"13706","أَخْبَرَنَا إِسْمَاعِيلُ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِيرِينَ ، أَنَّ ابْنَ عُمَرَ : كَرِهَ ذَلِكَ الْكَلِمَةَ أَنْ يَقُولَ : أَسْلَمْتُ فِي كَذَا وَكَذَا ، يَقُولُ : إِنَّمَا الإِسْلامُ لِلَّهِ رَبِّ الْعَالَمِينَ ""","","","","","Book of Wills"
"13707","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : إِذَا بِعْتَ شَيْئًا بِدِينَارٍ ، فَحَلَّ الأَجَلُ ، فَخُذْ بِالدِّينَارِ مَا شِئْتَ مِنْ ذَلِكَ النَّوْعِ وَغَيْرِهِ ""","","","","","Book of Wills"
"13708","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، وَابْنِ سِيرِينَ ، فيرجل باع طعاما بدينار إلى أجل ، قَالا :  يَأْخُذُ طَعَامَهُ ، أَوْ غَيْرَهُ إِذَا حَلَّ ""","","","","","Book of Wills"
"13709","أَخْبَرَنَا مَعْمَرٌ ، قَالَ : أَخْبَرَنِي تَمِيمُ بْنُ خُوَيْصٍ ، عَنْ أَبِي الشَّعْثَاءِ ، قَالَ : إِذَا بِعْتَ بِدِينَارٍ إِلَى أَجَلٍ ، فَحَلَّ الأَجَلُ فَخُذْ بِالدِّينَارِ مَا شِئْتَ ، مِنْ ذَلِكَ النَّوْعِ الَّذِي أَسْلَفْتَ فِيهِ ، أَوْ غَيْرِهِ ""، وَبِهِ يَأْخُذُ عَبْدُ الرَّزَّاقِ""","","","","","Book of Wills"
"13710","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ ، قَالَ : سَمِعْتُهُ يُحَدِّثُ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّهُ سُئِلَ عَنْرَجُلٍ بَاعَ بُزًّا ، أَيَأْخُذُ مَكَانَهُ بُرًّا ؟ ، قَالَ :  لا بَأْسَ بِهِ ""","","","","","Book of Wills"
"13711","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ طَاوُسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إِذَا أَسْلَفْتَ فِي طَعَامٍ فَحَلَّ الأَجَلُ ، فَلَمْ تَجِدْ طَعَامًا ، فَخُذْ مِنْهُ عَرَضًا بِأَنْقَصِ ، وَلا تَرْبَحْ عَلَيْهِ مَرَّتَيْنِ ""","","","","","Book of Wills"
"13712","قَالَ : أَخْبَرَنَا جَعْفَرُ بْنُ سُلَيْمَانَ ، قَالَ : أَخْبَرَنِي ابْنُ خَالَةٍ لِي ، أَنَّهُ سَأَلَ مُجَاهِدًا ، قَالَ : قُلْتُ : بِعْتُ مِنْ رَجُلٍ حَرِيرًا بِدِينَارٍ إِلَى أَجَلٍ فَلَمَّا حَلَّ الأَجَلُ ، وَجَدْتُ مَعَهُ حَرِيرًا ، آخُذُهُ مِنْهُ ؟ "" ، فَقَالَ : "" لا تَأْخُذْهُ إِلا بِأَكْثَرَ مِمَّا بِعْتَهُ مِنْهُ ""، قَالَ ابْنُ طَاوُسٍ : "" إِلا أَنْ يَكُونَ قَدْ خَرَجَ مِنْ يَدِهِ إِلَى غَيْرِهِ فَلا بَأْسَ أَنْ تَبْتَاعَهُ بِمَا شِئْتَ ""","","","","","Book of Wills"
"13713","أَخْبَرَنَا مَعْمَرٌ ، وَغَيْرُهُ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالَ : إِذَا حَلَّتْ لَكَ ذَهَبٌ فِي سِلْعَةٍ ، فَدَعَاكَ إِلَى أَنْ تَبْتَاعَ مِنْهُ بِهَا مِنْ غَيْرِ وَجْهِ السِّلْعَةِ الَّتِي كَانَتْ فِيهَا الذَّهَبُ ، فَافْعَلْ مَا لَمْ تَرْبَحْ رِبْحًا آخَرَ ، فَإِنْ فَعَلْتَ فَلا تَنْظِرَهُ ، وَإِنْ أَقَلْتُهُ فِيهَا فَلا بَأْسَ ""","","","","","Book of Wills"
"13714","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، قَالَ : قُلْتُ لِعَمْرِو بْنِ دِينَارٍ : أَرَأَيْتَلَوْ أَنِّي بِعْتُ طَعَامًا بِذَهَبٍ ، فَحَلَّتِ الذَّهَبُ ، فَجِئْتُ أَطْلُبُهُ ، فَقَالَ : لَيْسَ عِنْدِي ، خُذْ مِنِّي طَعَامًا ، فَقَالَ :  كَرِهَهُ طَاوُسٌ أَنْ يَأْخُذَ طَعَامًا ""، وَقَالَ أَبُو الشَّعْثَاءِ : "" إِذَا حَلَّ دَيْنُكَ فَخُذْ مَا شِئْتَ ""","","","","","Book of Wills"
"13715","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ : إِذَا بِعْتَ شَيْئًا مِمَّا يُكَالُ ، أَوْ يُوزَنُ بِدِينَارٍ ، فَلا تَأْخُذْ شَيْئًا مِمَّا يُكَالُ ، أَوْ يُوزَنُ إِلا أَنْ يَصْرِفَكَ إِلَى غَيْرِ ذَلِكَ ، وَإِنْ بِعْتَ شَيْئًا مِمَّا يُكَالُ فَصَرَفَكَ إِلَى شَيْءٍ مِمَّا يُوزَنُ فَخُذْهُ ، إِلا أَنْ يَكُونَ طَعَامًا ""","","","","","Book of Wills"
"13716","قَالَ : أَخْبَرَنَا مَالِكٌ ، عَنْ أَبِي الزِّنَادِ ، عَنِ ابْنِ الْمُسَيِّبِ ، وَسُلَيْمَانَ بْنِ يَسَارٍ ، أنهما : كَرِهَا إِذَا بِعْتَ طَعَامًا بِدِينَارٍ إِلَى أَجَلٍ ، فَحَلَّ الأَجَلُ ، أَنْ تَأْخُذَ بِهِ طَعَامًا قَبْلَ أَنْ تَقْبِضَ الذَّهَبَ ""","","","","","Book of Wills"
"13717","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : شَهِدْتُ شُرَيْحًا وَجَاءَهُرَجُلانِ بَاعَ أَحَدُهُمَا صَاحِبَهُ بَعِيرًا ، فَقَالَ :  أَقِلْنِي ، وَلَكَ ثَلاثُونَ دِرْهَمًا "" قَالَ : "" حَتَّى أَسْأَلَ شُرَيْحًا "" ، فَسَأَلَهُ ، فَلا أَدْرِي مَا رَدَّ عَلَيْهِ ، غَيْرَ أَنِّي سَمِعْتُ الرَّجُلَ ، يَقُولُ : "" قَدْ قَبِلْتُ بَعِيرِي ، وَقَبِلْتُ الثَّلاثِينَ ""","","","","","Book of Wills"
"13718","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، وَعَنْ عَلِيِّ بْنِ بَذِيمَةَ ، قَالَ : سَمِعْتُ سَعِيدَ بْنَ جُبَيْرٍ ، وَسَأَلَهُ رَجُلٌ عَنْرَجُلٍ اشْتَرَى سِلْعَةً مِنْ رَجُلٍ ، فَنَدِمَ فِيهَا ، فَقَالَ : أَقِلْنِي وَلَكَ كَذَا وَكَذَا ! فَقَالَ :  لا بَأْسَ بِهِ ""","","","","","Book of Wills"
"13719","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، وَعَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، قَالَ : اشْتَرَى طَاوُسٌ غُلامًا ، فَلَمْ يَمْكُثْ عِنْدَهُ إِلا يَسِيرًا حَتَّى رَدَّهُ إِلَى أَهْلِهِ ، وَأَعْطَاهُمْ عَشَرَةَ دَنَانِيرَ ، فَلَمْ يَقْبَلُوهُ حَتَّى أَعْطَاهُمُ الدَّنَانِيرَ ""","","","","","Book of Wills"
"13720","أَخْبَرَنَا مَعْمَرٌ ، قَالَ : سَأَلْتُ حَمَّادًا ، عَنْرَجُلٍ اشْتَرَى مِنْ رَجُلٍ سِلْعَةً فَنَدِمَ فِيهَا ، فَقَالَ :  أَقِلْنِي وَلَكَ كَذَا وَكَذَا ! فَكَرِهَهُ ""","","","","","Book of Wills"
"13721","أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ كَثِيرٍ ، عَنْ شُعْبَةَ ، قَالَ : سَأَلْتُ الْحَكَمَ بْنَ عُتَيْبَةَ فَكَرِهَهُ ، قَالَ الْحَكَمُ وَأَخْبَرَنِي مُغِيرَةُ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ :  أَنَّهُبَاعَ نَاقَةً ، فَقَالَ لَهُ الَّذِي اشْتَرَاهَا مِنْهُ : خُذْهَا ، وَلَكَ أَرْبَعُونَ دِرْهَمًا ! فَلَمْ يَأْخُذِ الأَسْوَدُ الدَّرَاهِمَ وَكَرِهَهُ ""","","","","","Book of Wills"
"13722","أَخْبَرَنَا مَعْمَرٌ ، وَالثَّوْرِيُّ ، عَنِ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ ، أَنَّهُكَرِهَ أَنْ يَرُدَّهَا ، وَيَرُدَّ مَعَهَا شَيْئًا ، هَذَا فِي الَّذِي يَشْتَرِي السِّلْعَةَ ، فَيَقُولُ :  أَقِلْنِي وَلَكَ كَذَا وَكَذَا ! ""","","","","","Book of Wills"
"13723","أَخْبَرَنَا ابْنُ مُجَاهِدٍ ، عَنْ أَبِيهِ ، عَنِ ابْنِ عُمَرَ :  أَنَّهُ كَانَلا يَرَى بِهِ بَأْسًا ""، قَالَ ابْنُ مُجَاهِدٍ : "" وَكَانَ عَطَاءٌ يَكْرَهُهُ ""","","","","","Book of Wills"
"13724","أَخْبَرَنَا مَعْمَرٌ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الْحَيَوَانِ بِالْحَيَوَانِ نَسِيئَةً ""","","","","","Book of Wills"
"13725","أَخْبَرَنَا الثَّوْرِيُّ ، وَإِسْرَائِيلُ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ رَفِيعٍ ، قَالَ :  سَمِعْتُ مُحَمَّدَ بْنَ الْحَنَفِيَّةِ : ""يَكْرَهُ الْحَيَوَانَ بِالْحَيَوَانِ نَسِيئَةً ""","","","","","Book of Wills"
"13726","أَخْبَرَنَا مَعْمَرٌ ، عَمَّنْ سَمِعَ عِكْرِمَةَ ، وَسُئِلَ عَنْرَجُلٍ بَاعَ بَعِيرًا بِغَنَمٍ إِلَى أَجَلٍ ، فَقَالَ :  تِلْكَ الرُّءُوسِ لا يَصْلُحُ شَيْءٌ مِنْهَا بِشَيْءٍ نَسِيئَةٌ ""","","","","","Book of Wills"
"13727","قَالَ مَعْمَرٌ : وَقَالَ الْحَسَنُ : إِذَا اخْتَلَفَا فَلا بَأْسَ بِهِ إِلَى أَجَلٍ ، يَقُولُ : الْغَنَمُ بِالْبَقَرِ ، وَالْبَقَرُ بِالإِبِلِ ، وَأَشَبَاهُ هَذَا ""","","","","","Book of Wills"
"13728","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، سَأَلْتُهُ عَنِ الْحَيَوَانِ بِالْحَيَوَانِ نَسِيئَةً ، فَقَالَ : سُئِلَ ابْنُ الْمُسَيِّبِ عَنْهُ ، فَقَالَ : لا رِبَا فِي الْحَيَوَانِ ، وَقَدْ نَهَيْ عَنِ الْمَضَامِينِ ، وَالْمَلاقِيحِ وَحَبَلِ الْحَبَلَةِ ""، وَالْمَضَامِينُ : مَا فِي أَصْلابِ الإِبِلِ ، وَالْمَلاقِيحُ مَا فِي بُطُونِهَا ، وَحَبَلُ الْحَبَلَةِ : وَلَدُ وَلَدِ هَذِهِ النَّاقَةِ ، أَخْبَرَنَا مَعْمَرٌ ، وَابْنُ عُيَيْنَةَ ، عَنْ أَيُّوبَ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ""","","","","","Book of Wills"
"13729","أَخْبَرَنَا مَالِكٌ ، عَنْ أَبِي الزِّنَادِ ، عَنِ ابْنِ الْمُسَيِّبِ ، أَنَّهُ قَالَ : لا رِبَا إِلا فِي الذَّهَبِ ، وَالْفِضَّةِ ، أَوْ فِيمَا يُكَالُ ، أَوْ يُوزَنُ مِمَّا يُؤْكَلُ وَيُشْرَبُ ""","","","","","Book of Wills"
"13730","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنِ أَبِيهِ ، قَالَ : أَخْبَرَنِي أَنَّهُ سَأَلَ ابْنِ عُمَرَ عَنْبَعِيرٍ بِبَعِيرَيْنِ نَظِرَةً ، فَقَالَ : لا ، وَكَرِهَهُ ، فَسَأَلَ أَبِي ابْنَ عَبَّاسٍ ، فَقَالَ :  قَدْ يَكُونُ الْبَعِيرُ خَيْرًا مِنَ الْبَعِيرَيْنِ ""","","","","","Book of Wills"
"13731","أَخْبَرَنَا مَعْمَرٌ ، عَنْ بُدَيْلٍ الْعُقَيْلِيِّ ، عَنْ مُطَرِّفِ بْنِ عَبْدِ اللَّهِ بْنِ الشِّخِّيرِ ، أَنَّ رَافِعَ بْنَ خَدَيْجٍ :اشْتَرَى مِنْهُ بَعِيرًا بِبَعِيرَيْنِ ، فَأَعْطَاهُ أَحَدَهُمَا ، وَقَالَ :  آتِيكَ غَدًا بِالآخَرِ رَهْوًا ""","","","","","Book of Wills"
"13732","أَخْبَرَنِي الأَسْلَمِيُّ ، وَمَالِكٌ ، عَنْ صَالِحِ بْنِ كَيْسَانَ ، عَنِ الْحَسَنِ بْنِ مُحَمَّدِ بْنِ عَلِيٍّ ، قَالَ : بَاعَ عَلِيُّ جَمَلا لَهُ يُقَالُ لَهُ : عُصَيْفِيرٌ ، بِعِشْرِينَ جَمَلا نَسِيئَةً ""","","","","","Book of Wills"
"13733","قَالَ الأَسْلَمِيُّ : وَأَخْبَرَنِي عَبْدُ اللَّهِ بْنُ أَبِي بَكْرٍ ، عَنِ ابْنِ أَبِي قُسَيْطٍ ، عَنِ ابْنِ الْمُسَيِّبِ ، عَنْ عَلِيٍّ :  أَنَّهُكَرِهَ بَعِيرًا بِبَعِيرَيْنِ نَسِيئَةً ""","","","","","Book of Wills"
"13734","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، قَالَ : أَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَبْدَ اللَّهِ بْنَ عَمْرٍو أَنْ يُجَهِّزَ جَيْشًا ، فَقَالَ : لَيْسَ عِنْدَنَا ظَهْرٌ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : ابْتَعْ لِي ظَهْرًا إِلَى خُرُوجِ الْمَصْدَقِ "" ، فَابْتَاعَ عَبْدُ اللَّهِ الْبَعِيرَ بِالْبَعِيرَيْنِ وَبِالأَبْعِرَةِ إِلَى خُرُوجِ الْمَصْدَقِ""","","","","","Book of Wills"
"13735","أَخْبَرَنَا مَعْمَرٌ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، عَنْ زِيَادِ بْنِ أَبِي مَرْيَمَ ، قَالَ : بَعَثَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مُصَدِّقًا فَجَاءَهُ بِإبِلٍ مِسَانٍ ، فَلَمَّا رَآهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  هَلَكْتَ وَأَهْلَكْتَ "" ، قَالَ : يَا رَسُولَ اللَّهِ ! إِنِّي كُنْتُأَبِيعُ الْبِكْرَ بِالْبِكْرَيْنِ ، وَالثَّلاثَةَ بِالْبَعِيرِ الْمُسِنِّ يَدًا بِيَدٍ ، وَعَلِمْتُ حَاجَتَكَ إِلَى الظَّهْرِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" فَذَاكَ إِذًا ، أَوْ فَلا عَلَيْكَ إِذًا ""","","","","","Book of Wills"
"13736","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، وَعَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالا : لا بَأْسَ بِبَعِيرٍ بِبَعِيرَيْنِ ، وَدِرْهَمٍ الدِّرْهَمُ نَسِيئَةٌ "" ، قَالا : "" فَإِنْ كَانَ أَحَدُ الْبَعِيرَيْنِ نَسِيئَةً فَهُوَ مَكْرُوهٌ ""","","","","","Book of Wills"
"13737","أَخْبَرَنَا مَعْمَرٌ ، عَنْ حَمَّادٍ ، وَغَيْرِهِ ، عَنْ إِبْرَاهِيمَ ، قَالَ :  أُتِيَ عَبْدُ اللَّهِ بْنُ مَسْعُودٍ بِرَجُلٍسَلَّفَ فِي قِلاصٍ لأَجَلٍ ، فَنَهَاهُ ""","","","","","Book of Wills"
"13738","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ :  أَنَّ عَبْدَ اللَّهِكَرِهَ السَّلَفَ فِي الْحَيَوَانِ ""","","","","","Book of Wills"
"13739","أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ كَثِيرٍ ، عَنْ شُعْبَةٍ ، قَالَ : أَخْبَرَنِي قَيْسُ بْنُ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِهَابٍ ، قَالَ : أَسْلَمَ زَيْدُ بْنُ خُلَيْدَةَ إِلَى عِتْرِيسِ بْنِ عُرْقُوبٍ فِي قِلاصٍ ، كُلِّ قَلُوصٍ بِخَمْسِينَ ، فَلَمَّا حَلَّ الأَجَلُ جَاءَ يَتَقَاضَاهُ ، فَأَتَى ابْنَ مَسْعُودٍ يَسْتَنْظِرُهُ لَهُ ، فَنَهَاهُ عَبْدُ اللَّهِ عَنْ ذَلِكَ ، وَأَمَرَهُ أَنْ يَأْخَذَ رَأْسَ مَالِهِ ""، عَنِ الثَّوْرِيِّ ، عَنْ قَيْسٍ ، عَنْ طَارِقٍ مِثْلَهُ""","","","","","Book of Wills"
"13740","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، وَقَتَادَةَ ، عَنِ الشَّعْبِيِّ ، قَالَ :  إِنَّمَاكَرِهَهُ عَبْدُ اللَّهِ ، لأَنَّهُ شَرْطٌ مِنْ نِتَاجِ أَبِي فُلانٍ ، وَمِنْ فَحْلِ أَبِي فُلانٍ ""","","","","","Book of Wills"
"13741","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ :  أَنَّ عُمَرَكَرِهَهُ، قَالَ : وَكَانَ شُرَيْحٌ يَكْرَهُهُ ""","","","","","Book of Wills"
"13742","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، قَالَ : سَمِعْتُ مَسْرُوقًا ، يَقُولُ : سَلَّفَ شُرَيْحٌ فِي عَبْدَيْنِ صَحِيحَيْنِ فَصِيحَيْنِ مِنْ لُغَتِهُمَا بِأَلْفِ دِرْهَمٍ ، فَجَاءَ الرَّجُلُ بِالْعَبْدَيْنِ فَبَاعَهُمَا شُرَيْحٌ بِأَلْفٍ وَأَرْبَعِ مِائَةٍ ، فَأَخَذَ الأَلْفَ وَرَدَّ الأَرْبَعَ مِائَةٍ عَلَى صَاحِبِ الْعَبْدَيْنِ ""","","","","","Book of Wills"
"13743","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ عُمَرَ :  كَانَلا يَرَى بَأْسًا أَنْ يُسَلِّفَ الرَّجُلُ فِي الْحَيَوَانِ إِلَى أَجَلٍ مَعْلُومٍ ""","","","","","Book of Wills"
"13744","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ : لا بَأْسَ أَنْ يُسَلِّفَ الرَّجُلُ فِي الْحَيَوَانِ إِلَى أَجَلٍ مَعْلُومٍ ""، أَخْبَرَنَا مَعْمَرٌ ، عَنِ الْحَسَنِ ، وَالزُّهْرِيِّ مِثْلَهُ""","","","","","Book of Wills"
"13745","عَنِ الثَّوْرِيِّ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : جَاءَ أَعْرَابِيٌّ يَتَقَاضَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَعِيرًا ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  الْتَمِسُوا لَهُ سِنًّا مِثْلَ سِنِّ بَعِيرِهِ "" ، فَالْتَمَسُوا ، فَلَمْ يَجِدُوا إِلا فَوْقَ سِنِّ بَعِيرِهِ ، فَقَالَ الأَعْرَابِيُّ : أَوْفَيْتَنِي أَوْفَاكَ اللَّهُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّخَيْرَكُمْ خَيْرُكُمْ قَضَاءً ""","","","","","Book of Wills"
"13746","أَخْبَرَنَا مَالِكٌ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، عَنْ أَبِي رَافِعٍ مَوْلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : اسْتَسْلَفَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ رَجُلٍ بِكْرًا ، فَجَاءَتْهُ إِبْلٌ مِنَ الصَّدَقَةِ ، فَقَالَ أَبُو رَافِعٍ : فَأَمَرَنِي النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ أَقْضِيَهُ بِكْرًا ، فَقُلْتُ : لَمْ أَجِدْ إِلا جَمَلا خِيَارًا رِبَاعِيًّا ، فَقَالَ :  اقْضِهِ إِيَّاهُ ، فَإنَّخَيْرَ النَّاسِ أَحْسَنُهُمْ قَضَاءً ""، أَخْبَرَنَا مَعْمَرٌ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، بِإِسْنَادِهِ مِثْلَهُ ، إِلا أَنَّهُ قَالَ : أَمَرَ بِلالا أَنْ يَقْضِيَهُ""","","","","","Book of Wills"
"13747","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ عَمَّارٍ الدُّهَنِيِّ ، قَالَ : سَأَلْتُ سَعِيدَ بْنَ جُبَيْرٍ ، عَنِالسَّلْمِ فِي الْحَيَوَانِ ، فَقَالَ :  كَرِهَهُ ابْنُ مَسْعُودٍ، فَقُلْتُ : "" أَفَلا تَنْهَى هَؤُلاءِ عَنْهُ ؟ "" فَقَالَ : "" إِنَّكَ إِذَا ذَهَبْتَ تَنْشُرُ سِلْعَتَكَ عَلَى مَنْ لا يُرِيدُهَا كَسَرَهَا ""","","","","","Book of Wills"
"13748","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللَّهِ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ :  إِنَّكُمْتَزْعُمُونَ أَنَّا لا نَعْلَمُ أَبْوَابَ الرِّبَا ، وَلأَنْ أَكُونَ أَعْلَمُهَا أَحَبَّ إِلَيَّ مِنْ أَنْ يَكُونَ لِي مِثْلُ مِصْرَ وَكُوَرِهَا ، وَمِنَ الأُمُورِ أُمُورٌ لا يَكُنَّ يُخْفَيْنَ عَلَى أَحَدٍ : هُوَ أَنْ يَبْتَاعَ الذَّهَبَ بِالْوَرِقِ نَسِيئًا ، وَأَنْ يَبْتَاعَ الثَّمَرَةَ وَهِيَ مُعَصْفَرَةٌ لَمْ تَطِبْ ، وَأَنْ يُسْلِمَ فِي سِنٍّ ""","","","","","Book of Wills"
"13749","أَخْبَرَنَا مَعْمَرٌ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنِ ابْنِ الْمُسَيِّبِ :  أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ بَيْعِ اللَّحْمِ بِالشَّاةِ الْحَيَّةِ ""، قَالَ زَيْدٌ : يَقُولُ : "" نَظِرَةً أَوْ يَدًا بِيَدٍ ""","","","","","Book of Wills"
"13750","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ ابْنِ الْمُسَيِّبِ :  أَنَّهُكَرِهَ أَنْ يُبَاعَ ، حَيٌّ بِمَيِّتٍ ""، يَعْنِي الشَّاةَ الْقَائِمَةَ بِالْمَذْبُوحِ ، قَالَ سُفْيَانُ : "" وَلا نَرَى بِهِ بَأْسًا ""","","","","","Book of Wills"
"13751","أَخْبَرَنَا مَعْمَرٌ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لا بَأْسَ أَنْ يُبَاعَ اللَّحْمُ بِالشَّاةِ ""","","","","","Book of Wills"
"13752","أَخْبَرَنَا الأَسْلَمِيُّ ، عَنْ صَالِحٍ ، مَوْلَى التَّوْءَمَةِ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّجَزُورًا عَلَى عَهْدِ أَبِي بَكْرٍ ، قُسِّمَتْ عَلَى عَشَرَةِ أَجْزَاءٍ ، فَقَالَ رَجُلٌ : أَعْطُونِي جُزْءًا بِشَاةٍ ، فَقَالَ أَبُو بَكْرٍ :  لا يَصْلُحُ هَذَا ""","","","","","Book of Wills"
"13753","عَنِ الثَّوْرِيِّ ، عَنْ أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ، عَنْ عُبَيْدِ بْنِ نَضْلَةَ الْخُزَاعِيِّ ، قَالَ : نَحَرَ رَجُلٌ جَزُورًا ، فَأَخَذَ مِنْهَا رَجُلٌ عِشْرِينَ بِحَقَّةٍ مِنْ نِتَاجِ نِتَاجٍ ، فَأَمَرَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِرَدِّهِ ""","","","","","Book of Wills"
"13754","أَخْبَرَنَا إِسْرَائِيلُ ، عَنْ عَبْدِ اللَّهِ بْنِ عِصْمَةَ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ يُسْأَلُ عَنْرَجُلٍ اشْتَرَى عُضْوًا مِنْ جَزُورٍ بِرِجْلِ عُنَاقٍ ، وَاشْتَرَطَ عَلَى صَاحِبِهَا أَنْ يُرْضِعَهَا أُمَّهَا حَتَّى تُفْطَمَ ، فَقَالَ ابْنُ عَبَّاسٍ :  لا يَصْلُحُ ""","","","","","Book of Wills"
"13755","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، أَنَّ زَيْدَ بْنَ ثَابِتٍ ، وَابْنَ عُمَرَ : كَانَالا يَرَيَانِ بِبَيْعِ الْقُطُوطِ ، إِذَا خَرَجَتْ ، بَأْسًا ، قَالَ :  وَلَكِنْ لا يَحِلُّ لِمَنِ ابْتَاعَهَا أَنْ يَبِيعَهَا حَتَّى يَقْبِضَهَا ""","","","","","Book of Wills"
"13756","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ :  كَانَلا يَرَى بَأْسًا بِبَيْعِهَا إِذَا أُمِرَ بِهَا ، وَكَرِهَ لِمَنِ اشْتَرَاهَا أَنْ يَبِيعَهَا حَتَّى يَقْبِضَهَا ""","","","","","Book of Wills"
"13757","أَنْبَأَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ :  أَنَّ حَكِيمَ بْنَ حِزَامٍ كَانَيَشْتَرِي الأَرْزَاقَ فِي عَهْدِ عُمَرَ مِنَ الْجَارِ ، فَنَهَاهُ عُمَرُ : أَنْ يَبِيعَهَا حَتَّى يَقْبِضَهَا ""","","","","","Book of Wills"
"13758","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ :  كَانَيَكْرَهُ أَنْ يَقُولَ : أَبِيعَكَ إِلَى سَنَةٍ ، فَإِنْ قَالَ : خَرَجَ لَكَ الْعَطَاءُ قَبْلَ سَنَةٍ ، حَلَّ حَقِّي ""","","","","","Book of Wills"
"13759","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ :  أَنَّهُلَمْ يَكُنْ يَرَى بَأْسًا أَنْ يَقُولَ الْعَامِلُ لِصَاحِبِ الرِّزْقِ : أُعْطِيكَ جَرِيبَيْنِ مِنْ شَعِيرٍ بِجَرِيبٍ مِنْ بُرٍّ ""","","","","","Book of Wills"
"13760","قَالَ الثَّوْرِيُّ عَنْ يَحْيَى بْنِ قَيْسٍ الْكِنْدِيِّ ، عَنْ جَدَّتِهِ ، قَالَ :  سَأَلْتُ شُرَيْحًا عَنْبَيْعِ الزِّيَادَةِ فِي الْعَطَاءِ بِالْعُرُوصِ ، فَكَرِهَهُ ، وَلَمْ يَرَ بِهِ بَأْسًا فِي الْحَيَوَانِ ""","","","","","Book of Wills"
"13761","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ :  أَنَّهُ كَانَيَكْرَهُ الطَّعَامَ أَنْ يَبَاعَ شَيْءٌ مِنْهُ بِشَيْءٍ نَظِرَةً ""","","","","","Book of Wills"
"13762","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَا اخْتَلَفَتْ أَلْوَانُهُ مِنَ الطَّعَامِ فَلا بَأْسَ بِهِ يَدًا بِيَدٍ ، الْبُرُّ بِالتَّمْرِ ، وَالزَّبِيبُ بِالشَّعِيرِ ، وَكَرِهَهُ نَسِيئَةً ""","","","","","Book of Wills"
"13763","عَنِ الثَّوْرِيِّ ، عَنْ مُوسَى بْنِ أَبِي عَايِشَةَ ، عَنْ إِبْرَاهِيمَ ، قَالَ : مَا كَانَ مِنْ شَيْءٍ وَاحِدٍ يُكَالُ ، فَمِثْلٌ بِمِثْلٍ ، فَإِذَا اخْتَلَفَ فَزِدْ وَازْدَدْ ، يَدًا بِيَدٍ ""","","","","","Book of Wills"
"13764","أَخْبَرَنَا مَعْمَرٌ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، وَعَنْ رَجُلٍ ، عَنِ الْحَسَنِ ، وَقَالَ الثَّوْرِيُّ : عَنْ إِبْرَاهِيمَ ، قَالا : أَسْلِفْ مَا يُكَالُ فِيمَا يُوزَنُ وَلا يُكَالُ ، وَأَسْلِفْ مَا يُوزَنُ ، وَلا يُكَالُ فِيمَا يُكَالُ وَلا يُوزَنُ ""","","","","","Book of Wills"
"13765","عَنِ الثَّوْرِيِّ ، عَنْ لَيْثٍ ، عَنْ مُجَاهِدٍ :  كَانَلا يَرَى بَأْسًا بِالْحِنْطَةِ بِالدَّقِيقِ ، وَالدَّقِيقِ بِالْخُبْزِ ""","","","","","Book of Wills"
"13766","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، قَالَ : لا يَصْلُحُ مُدُّ دَقِيقٍ بِمُدِّ بُرٍّ إِلا وَزْنًا ""، سَمِعْتُ الثَّوْرِيَّ يُفْتِي بِقَوْلِ قَتَادَةَ وَبِهِ يَأْخُذُ""","","","","","Book of Wills"
"13767","وَسَأَلْنَا مَعْمَرًا عَنِالدَّقِيقِ مُدًّا بِمُدَّيْنِ ، فَقَالَ :  كَانَ الْحَسَنُ ، وَقَتَادَةُ : "" لا يَرَيَانِ بِهِ بَأْسًا إِذَا اخْتَلَفَ ""","","","","","Book of Wills"
"13768","أَخْبَرَنَا عَبْدُ اللَّهِ ، عَنْ شُعْبَةَ ، قَالَ : سَأَلْتُ الْحَكَمَ ، وَحَمَّادًا عَنْ :مُدِّ بُرٍّ بِمُدِّ دَقِيقٍ ، فَكَرِهَاهُ ""","","","","","Book of Wills"
"13769","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، قَالَ : لا بَأْسَ بِالدَّقِيقِ بِالْخُبْزِ ، وَالْبُرِّ بِالْخُبْزِ ، يَدًا بِيَدٍ ، قَالَ : إِنَّهُ قَدْ خَرَجَ مِنَ الْكَيْلِ ""","","","","","Book of Wills"
"13770","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ : أَنَّهُكَرِهَ السَّوِيقَ بِالْحِنْطَةِ مِثْلا بِمِثْلٍ ، لأَنَّ فِيهِ فَضْلا ، قَالَ سُفْيَانُ : "" يُكَرَهُ نَسِيئَةً الْحِنْطَةُ بِالدَّقِيقِ ، وَلا يَرَى بَأْسًا بِنَسِيئَةِ الْخُبِزِ بِالدَّقِيقِ ""","","","","","Book of Wills"
"13771","أَخْبَرَنَا مَالِكٌ ، عَنْ عَبْدِ اللَّهِ بْنِ يَزِيدَ مَوْلَى الأَسْوَدِ بْنِ سُفْيَانَ ، أَنَّ زَيْدًا أَبَا عَيَّاشٍ مَوْلَى أَبِي زُهْرَةَ ، أَخْبَرَهُ أَنَّهُ سَأَلَ سَعْدَ بْنَ أَبِي وَقَّاصٍ عَنِ الْبَيْضَاءِ بِالسُّلْتِ ، فَقَالَ لَهُ سَعْدٌ : أَيُّهُمَا أَفْضَلُ ؟ ، فَقَالَ : الْبَيْضَاءُ ، قَالَ : فَنَهَانِي عَنْهُ ، وَقَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُسْأَلُ عَنِاشْتِرَاءِ التَّمْرِ بِالرُّطَبِ ، فَقَالَ :  أَيَنْقُصُ الرُّطَبُ إِذَا يَبِسَ ؟ "" ، فَقَالُوا : نَعَمْ ، فَنَهَى عَنْهُ""","","","","","Book of Wills"
"13772","عَنِ الثَّوْرِيِّ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ ، عَنْ عَبْدِ اللَّهِ بْنِ يَزِيدَ عَنْ زَيْدٍ أَبِي عَيَّاشٍ ، مَوْلَى بَنِي زُهْرَةَ ، عَنْ سَعْدٍ ، قَالَ : سُئِلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِالرُّطَبِ بِالتَّمْرِ ، فَقَالَ لِمَنْ حَوْلَهُ :  أَيَنْقُصُ إِذَا يَبِسَ ؟ "" ، قِيلَ : نَعَمْ ، فَنَهَى عَنْهُ، قَالَ : وَسُئِلَ سَعْدٌ عَنِ السُّلْتِ بِالْبَيْضَاءِ ، فَحَدَّثَ هَذَا""","","","","","Book of Wills"
"13773","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ طَارِقٍ ، عَنِ ابْنِ الْمُسَيِّبِ : كُرِهَ قَفِيزٌ مِنْ رُطَبٍ بِقَفِيزٍ مِنْ جَافٍّ ""","","","","","Book of Wills"
"13774","أَخْبَرَنَا مَعْمَرٌ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، قَالَ : أَعْطَى آلُ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ صَاعًا مِنْ حِنْطَةٍ بِصَاعَيْنِ مِنْ شَعِيرٍ عَلَفًا لِفَرَسِهِ ، فَأَمَرَهُمْ أَنْ يَرُدُّوهُ ""","","","","","Book of Wills"
"13775","عَنِ الثَّوْرِيِّ ، عَنْ إِبْرَاهِيمَ ، وَرَجُلٍ ، عَنِ ابْنِ الْمُسَيِّبِ : أَنَّتَمْرًا كَانَ عِنْدَ بِلالٍ فَتَغَيَّرَ ، فَخَرَجَ بِهِ بِلالٌ إِلَى السُّوقِ فَبَاعَهُ صَاعَيْنِ بِصَاعٍ ، فَلَمَّا بَلَغَ ذَلِكَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْكَرَهُ ، وَقَالَ : مَا هَذَا يَا بِلالُ ؟ فَأَخْبَرَهُ ، فَقَالَ : أَرْبَيْتَ ، ارْدُدْ عَلَيْنَا تَمْرَنَا","","","","","Book of Wills"
"13776","أَخْبَرَنَا مَالِكٌ ، عَنْ نَافِعٍ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، أَنَّ عَبْدَ الرَّحْمَنِ بْنَ الأَسْوَدِ بْنِ عَبْدِ يَغُوثٍ فَنَيْ عَلَفُ دَابَّتِهِ ، فَقَالَ لِغُلامِهِ : خُذْ مِنْ حِنْطَةِ أَهْلِكَ ، فَابْتَعْ بِهَا شَعِيرًا ، وَلا تَأْخُذْ إِلا مِثْلَهُ ""","","","","","Book of Wills"
"13777","أَخْبَرَنَا مَعْمَرٌ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي سَلَمَةَ ، عَنِ أَبِي سَعِيدٍ ، قَالَ : دَخَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى بَعْضِ أَهْلِهِ ، فَوَجَدَ عِنْدَهُمْ تَمْرًا أَجْوَدَ مِنْ تَمْرِهُمْ ، فَقَالَ :  مِنْ أَيْنَ هَذَا ؟ "" ، فَقَالُوا : أَبْدَلَنَا صَاعَيْنِ بِصَاعٍ ، فَقَالَ : ""لا صَاعَيْنِ بِصَاعٍ ، وَلا دِرْهَمَيْنِ بِدِرْهَمٍ ""","","","","","Book of Wills"
"13778","قَالَ الثَّوْرِيُّ فِيتَمْرَةٍ بِتَمْرَتَيْنِ :  هُوَ مَكْرُوهٌ ، لأَنَّ أَصْلَهُ كَيْلٌ ""","","","","","Book of Wills"
"13779","قَالَ الثَّوْرِيُّ : عَنْ أَبِي . . . . . . . . . . . ، عَنْ أَبِي قِلابَةَ ، عَنْ أَبِي الأَشْعَثِ ، عَنْ عُبَادَةَ بْنِ الصَّامِتِ ، قَالَ : كَانَ مُعَاوِيَةُ يَبِيعُ الآنِيَةَ مِنَ الْفِضَّةِ بِأَكْثَرَ مِنْ وَزْنِهَا ، فَقَالَ عُبَادَةُ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : الذَّهَبُ بِالذَّهَبِ وَزْنٌ بِوَزْنٍ ، وَالْفِضَّةُ بِالْفِضَّةِ وَزْنٌ بِوَزْنٍ ، وَالْبُرُّ بِالْبُرِّ مِثْلٌ بِمِثْلٍ ، وَالشَّعِيرِ بِالشَّعِيرِ مِثْلٌ بِمِثْلٍ ، وَالتَّمْرُ بِالتَّمْرِ مِثْلٌ بِمِثْلِ ، وَالْمِلْحُ بِالْمِلْحِ مِثْلٌ بِمِثْلٍ ، وَبِيعُوا الذَّهَبَ بِالْفِضَّةِ يَدًا بِيَدٍ كَيْفَ شِئْتُمْ ، وَالْبُرَّ بِالشَّعِيرِ يَدًا بِيَدٍ كَيْفَ شِئْتُمْ ""، أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ نَحْوَ هَذَا ، فَبَلَغَ ذَلِكَ مُعَاوِيَةَ ، فَقَالَ : "" مَا بَالُ أَقْوَامٍ يُحَدِّثُونَ بِأَحَادِيثٍ قَدْ كُنَّا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَلَمْ نَسْمَعْهَا "" ، فَقَالَ عُبَادَةُ : "" نُحَدِّثُ بِمَا سَمِعْنَا مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَإِنْ رَغِمَ أَنْفُ مُعَاوِيَةَ ""","","","","","Book of Wills"
"13780","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ :  أَنَّهُ كَانَيَكْرَهُ اللَّحْمَ بِالْبُرِّ نَسِيئَةً ""","","","","","Book of Wills"
"13781","سَأَلْنَا الثَّوْرِيَّ ، فَقَالَ : هَذَا أَحْسَنُ الْبُيُوعِ عِنْدَنَا ""","","","","","Book of Wills"
"13782","أَخْبَرَنَا مَعْمَرٌ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، وَأَخْبَرَنَا الثَّوْرِيُّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، كَانَلا يَرَى بَأْسًا بِالثَّوْبِ بِالثَّوْبَيْنِ نَسِيئَةً إِذَا اخْتَلَفَا ، وَيَكْرَهُهُ مِنْ شَيْءٍ وَاحِدٍ ، قَالَ الثَّوْرِيُّ : عَنْ مُغِيرَةَ : "" لا بَأْسَ بِالنَّسْمَةِ بِالنَّسْمَتَيْنِ إِذَا اخْتَلَفَتَا ""","","","","","Book of Wills"
"13783","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ :  كَانَلا يَرَى بِهِ بَأْسًا ""","","","","","Book of Wills"
"13784","قَالَ مَعْمَرٌ ، وَالثَّوْرِيُّ ، عَنْ إِسْمَاعِيلَ ابْنِ أُمَيَّةَ ، عَنِ ابْنِ الْمُسَيِّبِ فِي قِبْطِيَّةٍ بِقِبْطِيَّتَيْنِ نَسِيئَةً ، كَانَ لا يَرَى بِهِ بَأْسًا ، وَقَالَ :  إِنَّمَاالرِّبَا فِيمَا يُكَالُ أَوْ يُوزَنُ ""","","","","","Book of Wills"
"13785","أَخْبَرَنَا مَعْمَرٌ ، عَنْ رَجُلٍ ، عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ ، قَالَ : لا يُمْنَعُ ثَوْبَيْنِ بِثَوْبٍ نَظِرَةً "" ، وَذَلِكَ أَنَّهُ سُئِلَ عَنْ طَاقٍ بِكَرْبَاسَتَيْنِ، وَقَالَهُ ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ""","","","","","Book of Wills"
"13786","قَالَ عَمْرٌو : عَمَّنْ سَمِعَ الْحَسَنَ ، يَقُولُ : إِذَا اخْتَلَفَ النَّوْعَانِ مِنَ الْعُرُوضِ مِمَّا لا يُكَالُ ، وَلا يُوزَنُ ، فَلا بَأْسَ أَنْ يَبِيعَ طَاقًا بِكَرْبَاسَتَيْنِ ، يُعَجِّلُ إِحْدَى الْبَيْعَتَيْنِ ""","","","","","Book of Wills"
"13787","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : أَعْيَانِي أَنْ أَدْرِي ، مَا الْعُرُوضُ إِذَا بِيعَ بَعْضُهَا بِبَعْضٍ نَظِرَةً ""","","","","","Book of Wills"
"13788","سَأَلْتُ مَعْمَرًا ، عَنِالثَّوْبِ بِالْغَزْلِ نَسِيئَةً ، كِلاهُمَا مِنْ عُطُبٍ ، فَقَالَ :  كَانَ الْحَسَنُ يَكْرَهَهُ ، وَلا يَرَى بَأْسًا بِغَزْلٍ مِنْ عُطُبٍ بِثَوْبٍ مِنْ كَرَابِيسَ نَسِيئَةً ""","","","","","Book of Wills"
"13789","أَخْبَرَنَا ابْنُ التَّيْمِيِّ ، عَنْ أَبِيهِ ، قَالَ : سَأَلْتُ طَاوُسًا ، عَنِ :السَّلَفِ فِي الْعُرُوضِ ، فَقَالَ :  لا بَأْسَ بِهِ "" ، وَسَأَلْتُهُ عَنِ السَّلَفِ فِي الْحَرِيرِ ، فَقَالَ : "" لا أَدْرِي مَا الْحَرِيرُ ""","","","","","Book of Wills"
"13790","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ ، وَجَابِرِ بْنِ زَيْدٍ ، قَالا : لا بَأْسَ بِالْحَدِيدِ بِالنُّحَاسِ نَسِيئَةً ""، قَالَ : "" وَكَانَ الْحَسَنُ يَكْرَهَهُ ""","","","","","Book of Wills"
"13791","عَنِ الثَّوْرِيِّ فِيالْحَدِيدِ بِالنُّحَاسِ ، قَالَ :  لا بَأْسَ بِهِ يَدًا بِيَدٍ وَهُوَ نَسِيئَةٌ مَكْرُوهٌ ""","","","","","Book of Wills"
"13792","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، قَالَ : كُلُّ شَيْءٍ يُوزَنُ فَهُوَ مَجْرِيٌّ ، مَجْرَى الذَّهَبِ وَالْفِضَّةِ ، وَكُلُّ شَيْءٍ يُكَالُ فَهُوَ يَجْرِي مَجْرَى الْبُرِّ وَالشَّعِيرِ ""","","","","","Book of Wills"
"13793","أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ كَثِيرٍ ، عَنْ شُعْبَةَ ، قَالَ : سَأَلْتُ الْحَكَمَ ، وَحَمَّادًا عَنِالْحَدِيدِ بِالنُّحَاسِ نَسِيئَةً ، فَقَالَ :  لا بَأْسَ بِهِ "" ، وَكَرِهَهُ حَمَّادٌ""","","","","","Book of Wills"
"13794","عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ ، قَالَ : لا بَأْسَ بِالْفِلْسِ بِالْفِلْسَيْنِ ""","","","","","Book of Wills"
"13795","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنِ ابْتَاعَ طَعَامًا ، فَلا يَبِعُهُ حَتَّى يَقْبِضَهُ ""، قَالَ ابْنُ عَبَّاسٍ : "" فَأَحْسَبُ كُلَّ شَيْءٍ بِمَنْزِلَةِ الطَّعَامِ "" ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ طَاوُسٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ إِلا أَنَّهُ قَالَ : "" حَتَّى يَسْتَوْفِيَهُ ""","","","","","Book of Wills"
"13796","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ يُوسُفَ بْنِ مَاهِكٍ ، عَنْ رَجُلٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ لِحَكِيمِ بْنِ حِزَامٍ : لا تَبِعْ مَا لَيْسَ عِنْدَكَ ""، قَالَ عَبْدُ الرَّزَّاقِ : وَكَانَ ابْنُ سِيرِينَ يُحَدِّثُ بِهِ ، عَنْ أَيُّوبَ""","","","","","Book of Wills"
"13797","أَخْبَرَنَا مَعْمَرٌ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، أَنَّ عُثْمَانَ بْنَ عَفَّانَ ، وَحَكِيمَ بْنَ حِزَامٍ ، كَانَايَبْتَاعَانِ التَّمْرَ ، وَيَجْعَلانِهِ فِي غَرَائِرَ ، ثُمَّ يَبِيعَانِهِ بِذَلِكَ الْكَيْلِ ، فَنَهَاهُمُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يَبِيعَاهُ حَتَّى يَكِيلاهُ لِمَنِ ابْتَاعَهُ مِنْهُمَا ""","","","","","Book of Wills"
"13798","أَخْبَرَنَا عُمَرُ بْنُ رَاشِدٍ ، أَوْ غَيْرُهُ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ يُوسُفَ بْنِ مَاهِكٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عِصْمَةَ ، عَنْ حَكِيمِ بْنِ حِزَامٍ ، قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ ! إِنِّي أَشْتَرِي بُيُوعًا ، فَمَا يَحِلُّ لِي مِنْهَا ، وَمَا يُحَرَّمُ عَلَيَّ ؟ ، قَالَ :  يَا ابْنَ أَخِي !إِذَا اشْتَرَيْتَ مِنْهَا بَيْعًا ، فَلا تَبِعْهُ حَتَّى تَقْبِضَهُ ""","","","","","Book of Wills"
"13799","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، عَنْ أَبِيهِ ، قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ سَلَفٍ وَبَيْعٍ ، وَعَنْ شَرْطَيْنِ فِي بَيْعٍ وَاحِدٍ ، وَعَنْ بَيْعِ مَا لَيْسَ عِنْدَكَ ، وَعَنْ رِبْحٍ مَا لَمْ تَضْمَنْ ""","","","","","Book of Wills"
"13800","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ عَمْرِو ابْنِ دِينَارٍ ، وَعَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، قَالَ : سَمِعْتُ نَافِعَ بْنَ جُبَيْرٍ ، يَقُولُ :بِعْتُ مِنْ عَمْرِو بْنِ عُثْمَانَ طَعَامًا ، الطَّعَامُ مُعَجَّلٌ وَالنَّقْدُ مُؤَخَّرٌ ، مِنْهُ مَا هُوَ عِنْدِي ، وَمِنْهُ مَا لَيْسَ عِنْدِي ، فَأَرْسَلْتُ إِلَى ابْنِ عَبَّاسٍ ، وَابْنِ عُمَرَ ، فَأَتَانِي رَسُولٌ مِنْ عِنْدِهُمَا :  أَمَّا مَا كَانَ عِنْدَكَ فَأَخِّرْهُ ، وَمَا لَمْ يَكُنْ عِنْدَكَ فَارْدُدْ ""","","","","","Book of Wills"
"13801","أَخْبَرَنَا مَعْمَرٌ ، قَالَ : قُلْتُ لِقَتَادَةَ :اشْتَرَيْتُ طَعَامًا وَرَجُلٌ يَنْظِرُ إِلَيَّ وَأَنَا أَكْتَالُهُ ، أَأَبِيعُهُ إِيَّاهُ بِكَيْلِهِ ؟ ، قَالَ :  لا ، حَتَّى يَكْتَالَهُ مِنْكَ ""","","","","","Book of Wills"
"13802","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِيِّ ، قَالَ : عِنْدَ كُلِّ بَيْعَةٍ كَيْلُهُ ""، وَبِهِ يَأْخُذُ عَبْدُ الرَّزَّاقِ ، قَالَ الثَّوْرِيُّ فِي رَجُلَيْنِ يَتَبَايَعَانِ الطَّعَامَ يَكْتَالانِهِ ، ثُمَّ يَرْبَحُ أَحَدُهُمَا صَاحِبَهُ ، قَالَ : "" لا ، حَتَّى يَكْتَالَهُ كَيْلا آخَرَ ، يَكِيلُ كُلُّ وَاحِدٍ مِنْهُمَا نَصِيبَهُ ، ثُمَّ يَكِيلُ نَصِيبَهُ لِلَّذِي رَبِحَهُ ""","","","","","Book of Wills"
"13803","أَخْبَرَنَا مَعْمَرٌ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ فِي الرَّجُلِ يَبْتَاعُ التَّمْرَ فِي رُءُوسِ النَّخْلِ : لا يَبِيعُهُ حَتَّى يَصْرِمَهُ ""، قَالَ : وَقَالَ سُلَيْمَانُ بْنُ يَسَارٍ : "" لا بَأْسَ بِهِ ""","","","","","Book of Wills"
"13804","أَخْبَرَنَا جَعْفَرُ بْنُ سُلَيْمَانَ ، عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنِ الزُّبَيْرِ بْنِ خِرِّيتٍ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ : كَرِهَ إِذَا ابْتَاعَ الرَّجُلُ التَّمْرَةَ عَلَى رُءُوسِ النَّخْلِ ، أَنْ يَبِيعَهُ حَتَّى يَصْرِمَهُ ""","","","","","Book of Wills"
"13805","أَخْبَرَنَا ابْنُ التَّيْمِيِّ ، عَنْ رَجُلٍ ، سَمِعَ قَتَادَةَ يُحَدِّثُ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، أَنَّ زَيْدَ بْنَ ثَابِتٍ ، وَالزُّبَيْرَ بْنَ الْعَوَّامِ ، قَالا : إِذَا ابْتَاعَ الرَّجُلُ التَّمْرَةَ عَلَى رُءُوسِ النَّخْلِ فَلا بَأْسَ أَنْ يَبِيعَهَا قَبْلَ أَنْ يَصْرِمَهَا ""","","","","","Book of Wills"
"13806","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ الْخُرَاسَانِيِّ أَنَّ عَبْدَ اللَّهِ بْنَ عَمْرِو بْنِ الْعَاصِ ، قَالَ : يَا رَسُولَ اللَّهِ ، إِنَّا نَسْمَعُ مِنْكَ أَحَادِيثَ ، أَفَتَأْذَنُ لِي فَأَكْتُبَهَا ؟ ، قَالَ :  نَعَمْ "" ، قَالَ : فَكَانَ أَوَّلُ مَا كَتَبَ بِهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى أَهْلِ مَكَّةَ كِتَابًا : ""لا يَجُوزُ شَرْطَانِ فِي بَيْعٍ وَاحِدٍ ، وَبَيْعٌ وَسَلَفٌ جَمِيعًا ، وَبَيْعٌ مَا لَمْ يَضْمَنْ ، وَمَنْ كَانَ مُكَاتِبًا عَلَى مِائَةِ دِرْهَمٍ ، فَقَضَاهَا كُلَّهَا إِلا دِرْهَمًا فَهُوَ عَبْدٌ ، أَوْ عَلَى مِائَةِ أُوقِيَّةٍ ، فَقَضَاهَا . . . . كُلَّهَا إِلا أُوقِيَّةً ، فَهُوَ عَبْدٌ ""","","","","","Book of Wills"
"13807","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ : الْمُوَاصَفَةُ هُوَ الْمُوَاطَأَةُ ، وَبِهِ قَالَ :  كَانَيَكْرَهُ الْمُوَاصَفَةَ ، وَالْمُوَاصَفَةُ أَنْ يُواصِفَ الرَّجُلُ بِالسِّلْعَةِ لَيْسَ عِنْدَهُ ، وَكَرِهَ أَيْضًا أَنْ تَأْتِيَ الرَّجُلَ بِالثَّوْبِ لَيْسَ لَكَ ، فَتَقُولَ : مِنْ حَاجَتِكَ هَذَا ؟ ، فَإِذَا قَالَ : نَعَمْ ، اشْتَرَيْتَهُ لِتَبِيعَهُ مِنْهُ نَظِرَةً ""","","","","","Book of Wills"
"13808","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، أَنَّهُ سَأَلَهُ عَنْ رَجُلٍ ، قَالَ :ابْتَعْ بُزَّ كَذَا وَكَذَا ، وَأَشْتَرِيهِ مِنْكَ ، فَكَرِهَهُ ""","","","","","Book of Wills"
"13809","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، أَوْ غَيْرِهِ ، عَنِ الْحَسَنِ :  كَانَيَكْرَهُ أَنْ يَأْتِيَكَ الرَّجُلُ يُسَاوِمُكَ بِشَيْءٍ لَيْسَ عِنْدَكَ ، فَتَقُولَ : ارْجِعْ إِلَيَ غَدًا ، وَأَنْتَ تَنْوِي أَنْ تَبْتَاعَهُ لَهُ ""","","","","","Book of Wills"
"13810","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالَ : لا تُؤَامِرْهُ ، وَلا تُوَاعِدْهُ ، قُلْ : لَيْسَ عِنْدِي ""","","","","","Book of Wills"
"13811","أَخْبَرَنَا مَعْمَرٌ ، قَالَ : سَمِعْتُ جَعْفَرَ بْنَ بُرْقَانَ يَسَأَلُ الزُّهْرِيَّ ، قَالَ :يَأْتِينِي الرَّجُلُ يَطْلُبُ عِنْدِي الْمَتَاعَ ، فَلا يَكُونُ عِنْدِي ، فَأَبْعَثُ إِلَى رَجُلٍ وَهُوَ عِنْدَهُ ، فَيُرْسِلُ إِلَيَّ بِهِ ، فَأُرِيَهُ الرَّجُلَ ، فَأَقُولُ : هَذَا مِنْ حَاجَتِكَ ؟ ، فَيَقُولَ : نَعَمْ ، فَأَشْتَرِيَهُ مِنْ صَاحِبِهِ ، فَأَبِيعَهُ مِنْهُ ، فَكَرِهَهُ، فَقَالَ جَعْفَرٌ :  مَا كُنَّا نَرَاهُ إِلا مِنْ أَحْسَنِ الْبُيُوعِ "" ، فَقَالَ الزُّهْرِيُّ : "" هُوَ مَكْرُوهٌ ""","","","","","Book of Wills"
"13812","أَخْبَرَنَا مَعْمَرٌ ، أَنَّ الْحَسَنَ ، وَقَتَادَةَ :  كَانَايَكْرَهَانِ الْمُوَاصَفَةَ كُلَّهَا عِنْدَهُ فِي الطَّعَامِ وَغَيْرِهِ ""","","","","","Book of Wills"
"13813","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي زَيْدُ بْنُ أَسْلَمَ ، قَالَ : كُنْتُ مَعَ ابْنِ عُمَرَ إِذْ سَأَلَهُ نَخَّاسٌ ، فَقَالَ :يَأْتِي الرَّجُلُ فِي بَعِيرٍ لَيْسَ لِي ، فَيُسَاوِمُنِي فَأَبِيعُهُ مِنْهُ ، ثُمَّ أَبْتَاعُهُ بِنَقْدٍ ، فَقَالَ ابْنُ عُمَرَ :  لا ""","","","","","Book of Wills"
"13814","فَقَالَ ابْنُ جُرَيْجٍ : وَأَخْبَرَنِي أَبُو الزُّبَيْرِ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ يَكْرَهُهُ ، وَيْقُولُ : لا تَبِعْ بَيْعًا حَتَّى تَقْبِضَهُ ""","","","","","Book of Wills"
"13815","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : لا بَأْسَ أَنْ يَشْتَرِيَ شَيْئًا لا يُكَالُ ، وَلا يُوزَنُ بِنَقْدٍ ، ثُمَّ يَبِيعَهُ قَبْلَ أَنْ يَقْبِضَهُ ""، أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ مِثْلَهُ""","","","","","Book of Wills"
"13816","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ : كَرِهَهُ ""","","","","","Book of Wills"
"13817","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنِ ابْنِ شُبْرُمَةَ ، قَالَ : لا بَأْسَ بِهِ ""","","","","","Book of Wills"
"13818","أَخْبَرَنَا مَالِكٌ ، وَابْنُ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، قَالَ : كُنْتُ عِنْدَ ابْنِ عَبَّاسٍ ، فَأَتَاهُرَجُلٌ أَسْلَفَ فِي سَبَائِبَ ، أَيَبِيعُهَا قَبْلَ أَنْ يَقْبِضَهَا ؟ ، فَقَالَ ابْنُ عَبَّاسٍ  لا ، إِنَّمَا تِلْكَ وَرَقٌ بِوَرَقٍ ، وَذَهَبٌ بِذَهَبٍ ""","","","","","Book of Wills"
"13819","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ ، قَالَ : لا تَبِعْ بَيْعًا حَتَّى تَقْبِضَهُ ""","","","","","Book of Wills"
"13820","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، قَالَ : سَمِعْتُ ابْنَ الْمُسَيِّبِ ، يَقُولُ : إِذَا اشْتَرَيْتَ شَيْئًا مِمَّا يُكَالُ ، أَوْ يُوزَنُ فَلا تَبِعْهُ حَتَّى تَقْبِضَهُ ""","","","","","Book of Wills"
"13821","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : إِذَا ابْتَاعَ رَجُلٌ مِنْكَ شَيْئًا عَلَى صِفَةٍ فَلَمْ تُخَالِفْ مَا وَصَفْتَ لَهُ ، فَقَدْ وَجَبَ عَلَيْهِ الْبَيْعُ ""، قَالَ أَيُّوبُ : وَقَالَ الْحَسَنُ : "" هُوَ بِالْخِيَارِ إِذَا رَآهُ ""","","","","","Book of Wills"
"13822","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : شَهِدْتُ شُرَيْحًا وَجَاءَهُ رَجُلانِ ، فَقَالَ أَحَدُهُمَا : إِنَّ هَذَابَاعَنِي مِثْلَ هَذَا الثَّوْبِ بِكَذَا وَكَذَا ، فَجَاءَنِي بِهِ وَإِنِّمَا اشْتَرَيْتُ مِنْهُ مِثْلَهُ ، وَلَمْ أَشْتَرِهِ مِنْهُ ، فَقَالَ :  وَهَلْ تَجِدُ شَيْئًا أَشْبَهَ بِهِ مِنْهُ ؟ "" ، فَأَجَازَهُ عَلَيْهِ""","","","","","Book of Wills"
"13823","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : مَرَّتْ غَنَمٌ عَلَى رَجُلٍ ، فَقَالَ : لِمَنْ هَذِهِ ؟ قَالُوا : لِفُلانٍ اشْتَرَاهَا مِنْ فُلانٍ ، فَأَتَاهُ فَقَالَ :بِعْنِي غَنَمَكَ الَّتِي اشْتَرِيتَ مِنْ فُلانٍ ، قَالَ : نَعَمْ ، فَبَاعَهَا مِنْهُ ، فَخَاصَمَهُ إِلَى شُرَيْحٍ بَعْدَ ذَلِكَ ، فَقَالَ : إِنِّي رَأَيْتُ غَنَمًا سِمَانًا عِظَامًا ، قَالَ الآخَرُ : لا أَدْرِي مَا يَقُولُ هَذَا ، وَلَكِنَّهُ اشْتَرَى مِنِّي غَنَمِي الَّتِي اشْتَرِيتُ مِنْ فُلانٍ ، فَقَالَ شُرَيْحٌ :  لَكَ غَنْمُ فُلانٍ الَّتِي اشْتَرَيْتَ مِنْ فُلانٍ ""","","","","","Book of Wills"
"13824","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ : قَالَ أَصْحَابُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : وَدَدْنَا لَوْ أَنَّ عُثْمَانَ بْنَ عَفَّانَ ، وَعَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ تَبَايَعَا ، حَتَّى نَنْظُرَ أَيُّهُمَا أَعْظَمُ جَدًّا فِي التِّجَارَةِ ، قَالَ :فَاشْتَرَى عَبْدُ الرَّحْمَنِ مِنْ عُثْمَانَ فَرَسًا مِنْ أَرْضٍ أُخْرَى بِأَرْبَعِينَ أَلْفَ دِرْهَمٍ ، أَوْ أَرْبَعَةِ آلافٍ ، أَوْ نَحْوَ ذَلِكَ ، إِنْ أَدْرَكَتْهَا الصَّفْقَةُ وَهِيَ سَالِمَةٌ ، ثُمَّ أَجَازَ قَلِيلا ، فَرَجَعَ ، فَقَالَ :  أُزِيدُكَ سِتَّةَ آلافٍ إِنْ وَجَدَهَا رَسُولِي سَالِمَةً ؟ "" ، قَالَ : نَعَمْ ، فَوَجَدَهَا رَسُولُ عَبْدِ الرَّحْمَنِ قَدْ هَلَكَتْ ، وَخَرَجَ مِنْهَا بِالشَّرْطِ الآخَرِ، قَالَ رَجُلٌ لِلزُّهْرِيِّ : فَإِنْ لَمْ يَشْرُطْ ؟ ، قَالَ : "" هِيَ مِنْ مَالِ الْبَائِعِ ""","","","","","Book of Wills"
"13825","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالَ : لا بَأْسَ أَنْ يَشْتَرِيَ الرَّجُلُ الدَّابَّةَ الْغَائِبَةَ إِذَا كَانَ عَرِفَهَا ، إِنْ كَانَتِ الْيَوْمَ صَحِيحَةً فَهِيَ مِنِّي ""","","","","","Book of Wills"
"13826","أَخْبَرَنَا الثَّوْرِيُّ ، قَالَ : كُلُّ صَفْقَةٍ وُصِفَتْ فَإِنْ لَمْ يَكُنْ مِثْلَهَا ، فَصَاحِبُهُ بِالْخِيَارِ إِذَا رَآهُ ""","","","","","Book of Wills"
"13827","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالَ : مَنِ ابْتَاعَ شَيْئًا وَبَتَّ بِهِ ، فَأَرَادَ الْمُبْتَاعُ أَنْ يَقْبِضَهُ ، فَقَالَ الْبَايِعُ : لا أَعْطِيكَهُ حَتَّى تَقْضِيَنِي ، فَهَلَكَ ، فَهُوَ مِنْ مَالِ الْبَائِعِ لأَنَّهُ ارْتَهَنَهُ ، فَإِنْ قَالَ : خُذْ مَتَاعَكْ ، فَقَالَ : دَعْهُ حَتَّى أُرْسِلَ إِلَيْكَ مَنْ يَقْبِضَهُ فَهَلَكَ ، فَهُوَ مِنْ مَالِ الْمُبْتَاعِ ""، قَالَ مَعْمَرٌ : "" فَإِنْ سَكَتَا جَمِيعًا فَإنَّ حَمَّادًا ، وَابْنَ شُبْرُمَةَ ، وَغَيْرَهُ لا يَرَونَهُ شَيْئًا حَتَّى يَقْبِضَهُ "" ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، مِثْلَ قَوْلِ طَاوُسٍ ، عَنِ الثَّوْرِيِّ""","","","","","Book of Wills"
"13828","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إِبْرَاهِيمَ فِيرَجُلٍ يَبِيعُ الرَّجُلَ السِّلْعَةَ ، فَيَقُولُ : خُذْهَا ، فَيَقُولُ الْمُبْتَاعُ : دَعْهَا عِنْدَكَ ، فَيَمُوتُ ، قَالَ :  إِذَا عَرَضَهَا عَلَيْهِ وَلَمْ يَقْبَلْهَا فَهِيَ مِنْ مَالِ الْمُشْتَرِي ""، قَالَ سُفْيَانُ : "" وَأَمَّا أَصْحَابُنَا فَيَقُولُونَ : لا ، حَتَّى يَقْبِضَهَا ""","","","","","Book of Wills"
"13829","أَخْبَرَنَا ابْنُ التَّيْمِيِّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَابْنِ سِيرِينَ ، قَالا : الضَّمَانُ عَلَى الْبَائِعِ حَتَّى يَقْبِضَهُ الْمُبْتَاعُ ""","","","","","Book of Wills"
"13830","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ شُبْرُمَةَ ، قَالَ : مَنِ اشْتَرَى جَارِيَةً فَوَضَعَهَا عَلَى يَدَيْ رَجُلٍ يَسْتَبْرِئُهَا ، فَمَاتَتْ قَبْلَ أَنْ تَحِيضَ ، فَهِيَ مِنْ مَالِ الْبَائِعِ ""","","","","","Book of Wills"
"13831","قَالَ الثَّوْرِيُّ : فِيالْجَارِيَةِ يَضَعُهَا الْبَيْعَانُ تَسْتَبْرِئُ فَهَلَكَتْ ، قَالَ :  إِذَا لَمْ يَقْبِضْهَا الْمُبْتَاعُ فَهِيَ مِنْ مَالِ الْبَائِعِ ""، عَنْ أَصْحَابِنَا""","","","","","Book of Wills"
"13832","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، قَالَ : هِيَ مِنْ مَالِ الْمُبْتَاعِ ، مَا لَمْ يَتَبَيَّنْ حَمْلُهَا ""","","","","","Book of Wills"
"13833","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ :  هِيَمَنِ اشْتُرِطَ عَلَيْهِ الضَّمَانُ ، الْبَائِعُ ، وَالْمُبْتَاعُ ""","","","","","Book of Wills"
"13834","قَالَ الثَّوْرِيُّ : فِيرَجُلٍ بَاعَ ثَوْبًا ، فَلَمْ يَقْبِضْهُ الْمُبْتَاعَ حَتَّى خَلَفَهُ آخَرٌ ، فَقَوَّمَ الثَّوْبَ عَشَرَةَ دَرَاهِمَ ، وَقَوَّمَ الثَّوْبَ بِخَمْسَةٍ ، قَالَ :  ثَمَنُهُ لِلْبَائِعِ ، لأَنَّ الْمُبْتَاعَ لَمْ يَكُنْ ضَمِنَهُ ، فَلا يَكُونُ لَهُ رِبْحُ مَا لَمْ يَضْمَنْ ""","","","","","Book of Wills"
"13835","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، قَالَ : التَّوْلِيَةُ بَيْعٌ فِي الطَّعَامِ ، وَغَيْرِهِ ""","","","","","Book of Wills"
"13836","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ الْحَسَنِ ، قَالَ : لا بَأْسَ بِالتَّوْلِيَةِ ، إِنِّمَا هُوَ مَعْرُوفٌ ""","","","","","Book of Wills"
"13837","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ جَابِرٍ ، وَزَكَرِيَّا ، عَنِ الشَّعْبِيِّ ، وَعَنْ سُلَيْمَانَ التَّيْمِيِّ ، عَنِ الْحَسَنِ ، وَابْنِ سِيرِينَ ، وعن فطر ، عَنِ الْحَكَمِ ، قَالُوا : التَّوْلِيَةُ بَيْعٌ ""، قَالَ الثَّوْرِيُّ : وَنَحْنُ نَقُولُ : "" وَالشِّرْكَةُ بَيْعٌ ، وَلا يُشَرَّكُ حَتَّى يَقْبِضَ ""","","","","","Book of Wills"
"13838","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالَ : لا بَأْسَ بِالتَّوْلِيَةِ إِنِّمَا هُوَ مَعْرُوفٌ ""، قَالَ : وَقَالَ ابْنُ سِيرِينَ : "" لا ، حَتَّى يَقْبِضَ وَيُكَالَ ""","","","","","Book of Wills"
"13839","أَخْبَرَنَا ابْنُ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ : كَرِهَا التَّوْلِيَةَ إِلا أَنْ يُكْتَالَ ""","","","","","Book of Wills"
"13840","أَخْبَرَنَا مَعْمَرٌ ، عَنْ رَبِيعَةَ ، عَنِ ابْنِ الْمُسَيِّبِ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : التَّوْلِيَةُ ، وَالإِقَالَةُ ، وَالشِّرْكَةُ سَوَاءٌ لا بَأْسَ بِهِ ""","","","","","Book of Wills"
"13841","وَأَمَّا ابْنُ جُرَيْجٍ ، فَقَالَ : أَخْبَرَنِي رَبِيعَةُ بْنُ أَبِي عَبْدِ الرَّحْمَنِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَدِيثًا مُسْتَفَاضًا بِالْمَدِينَةِ ، قَالَ : مَنِ ابْتَاعَ طَعَامًا فَلا يَبِعْهُ حَتَّى يَقْبِضَهُ وَيَسْتَوْفِيَهُ ، إِلا أَنْ يُشْرَكَ فِيهِ أَوْ يُوَلِّيَهُ أَوْ يُقِيلَهُ ""","","","","","Book of Wills"
"13842","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ فِيشَرِيكَيْنِ ابْتَاعَا سِلْعَةً ، ثُمَّ أَخْرَجَ أَحَدُهُمَا الأَخَرَ بِشَفٍّ ، قَالَ :  لا بَأْسَ بِذَلِكَ فِيمَا لا يُكَالُ ، وَلا يُوزَنُ ""","","","","","Book of Wills"
"13843","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : لا بَأْسَ فِي شَرِيكَيْنِ بَيْنَهُمَا مَتَاعٌ ، أَوْ عَرْضٌ لا يُكَالَ ، وَلا يُوزَنُ ، لا بَأْسَ بِأَنْ يَسْتَبْرِئَهُ مِنْهُ قَبْلَ أَنْ يَقْتَسِمَا ""","","","","","Book of Wills"
"13844","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، قَالَ :  سَأَلْتُ ابْنَ الْمُسَيِّبِ عَنْ رَجُلٍ لَهُ سَهْمٌ فِي غَنَمٍ ، أَيَبِيعُهُ قَبْلَ أَنْ يُقَسَّمَ ؟ "" قَالَ : "" نَعَمْ "" ، فَقُلْتُ : "" قَدْنَهَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الْمَغَانِمِ حَتَّى تُقَسَّمَ ""، قَالَ : "" إِنَّ الْمَغَانِمَ يَكُونُ فِيهَا الذَّهَبُ وَالْفِضَّةُ "" ، قَالَ مَعْمَرٌ : "" وَلا يَدْرِي كَمْ سَهْمُهُ مِنَ الْمَغَانِمِ ""","","","","","Book of Wills"
"13845","أَخْبَرَنَا مَعْمَرٌ ، وَابْنُ عُيَيْنَةَ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالَ : ابْتَاعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَبْلَ النُّبُوَّةِ مِنْ أَعْرَابِيٍّ بَعِيرًا أَوْ غَيْرَ ذَلِكَ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَعْدَ الْبَيْعِ :  اخْتَرْ "" ، فَنَظَرَ إِلَيْهِ الأَعْرَابِيُّ ، فَقَالَ : عَمَّرَكَ اللَّهُ مَنْ أَنْتَ ؟ ، فَلَمَّا كَانَ الإِسْلامُجَعَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْخِيَارَ بَعْدَ الْبَيْعِ""","","","","","Book of Wills"
"13846","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : الْبَيْعَانُ بِالْخِيَارِ ، مَا لَمْ يَفْتَرِقَا ، أَوْ يَكُنْ بَيْعُ خِيَارٍ ""، أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ""","","","","","Book of Wills"
"13847","أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ مُحَرَّرٍ ، قَالَ : أَخْبَرَنِي ثَابِتُ بْنُ الْحَجَّاجِ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي أَوْفَى ، قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : الْبَيْعُ عَنْ تَرَاضٍ ، وَالتَّخْيِيرُ عَنْ صَفْقَةٍ ""","","","","","Book of Wills"
"13848","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : كُلُّ بَيْعَيْنِ فَلا بَيْعَ بَيْنَهُمَا حَتَّى يَتَفَرَّقَا ، إِلا بَيْعَ الْخِيَارِ ""","","","","","Book of Wills"
"13849","أَخْبَرَنَا مَعْمَرٌ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ ، عَنْ نَافِعٍ ، قَالَ :  كَانَ ابْنُ عُمَرَإِذَا اشْتَرَى شَيْئًا مَشَى سَاعَةً قَلِيلا لِيَقْطَعَ الْبَيْعَ ، ثُمَّ يَرْجِعَ ""","","","","","Book of Wills"
"13850","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ أَبِي عَتَّابٍ ، عَنْ أَبِي زُرْعَةَ ، أَنَّ رَجُلا سَاوَمَهُ بِفَرَسٍ لَهُ ، فَلَمَّا بَاعَهُ خَيَّرَهُ ثَلاثًا ، ثُمَّ قَالَ : اخْتَرْ ! فَخَيَّرَ كُلُّ وَاحِدٍ مِنْهُمَا صَاحِبَهُ ثَلاثًا ، ثُمَّ قَالَ أَبُو زُرْعَةَ سَمِعْتُ أَبَا هُرَيْرَةَ ، يَقُولُ :  هَكَذَاالْبَيْعُ عَنْ تَرَاضٍ ""","","","","","Book of Wills"
"13851","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، قَالَ : جَاءَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى أَهْلِ الْبَقِيعِ فَنَادَى بِصَوْتِهِ :  يَا أَهْلَ الْبَقِيعِ !لا يَتَفَرَّقُ بَيِّعَانِ إِلا عَنْ رِضًا ""","","","","","Book of Wills"
"13852","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ شُرَيْحٍ ، قَالَ : شَهِدْتُهُ يُخْتَصَمُ إِلَيْهِ فِي رَجُلٍ اشْتَرَى مِنْ رَجُلٍ بَيْعًا ، فَقَالَ : إِنِّي لَمْ أَرْضَهُ ، فَقَالَ الآخَرُ : بَلْ قَدْ رَضِيتَهُ ، قَالَ : بَيِّنَتُكَ أَنَّكُمَا صَادَرْتُمَا عَنْ رِضًا بَعْدَ الْبَيْعِ ، أَوْ خِيَارٍ ، أَوْ يَمِينُهُ بِاللَّهِ مَا تَصَادَرْتُمَا عَنْ تَرَاضٍ بَعْدَ الْبَيْعِ وَلا خِيَارٍ ""","","","","","Book of Wills"
"13853","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ سُلَيْمَانَ الأَحْوَلِ ، قَالَ : سَمِعْتُ طَاوُسًا :  يَحْلِفُ بِاللَّهِمَا التَّخْيِيرُ إِلا بَعْدَ الْبَيْعِ ""","","","","","Book of Wills"
"13854","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي السَّفْرِ ، عَنِ الشَّعْبِيِّ ، عَنْ شُرَيْحٍ ، قَالَ : الْبَيِّعَانِ بِالْخِيَارِ مَا لَمْ يَتَفَرَّقَا ""","","","","","Book of Wills"
"13855","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، قَالَ :  كَانَ إِبْرَاهِيمُيَرَى الْبَيْعَ جَائِزًا بِالْكَلامِ إِذَا تَبَايَعَا ، وَإِنْ لَمْ يَتَفَرَّقَا ""","","","","","Book of Wills"
"13856","عَنِ الثَّوْرِيِّ ، عَنِ الْحَجَّاجِ ، يَرْفَعُهُ إِلَى عُمَرَ ، أَنَّ عُمَرَ ، قَالَ بِمَنًى حِينَ وَضَعَ رِجْلَهُ فِي الْغَرْزِ :  إِنَّ النَّاسَ قَائِلُونَ غَدًا : مَاذَا قَالَ عُمَرُ ؟ ، أَلا وَإِنَّمَاالْبَيْعُ عَنْ صَفْقَةٍ ، أَوْ خِيَارٍ ، وَالْمُسْلِمُ عِنْدَ شَرْطِهِ ""، قَالَ سُفْيَانُ : "" وَالصَّفْقَةُ بِاللِّسَانِ ""","","","","","Book of Wills"
"13857","أَخْبَرَنَا هُشَيْمٌ ، عَنِ الْحَجَّاجِ ، عَنْ مُحَمَّدِ بْنِ خَالِدِ بْنِ الزُّبَيْرِ ، عَنْ رَجُلٍ مِنْ كِنَانَةَ ، قَالَ : قَالَ عُمَرُ حِينَ وَضَعَ رِجْلَهُ فِي الْغَرْزِ وَهُمْ بِمِنًى :  اسْمَعُوا مَا أَقُولُ لَكُمْ ، وَلا تَقُولُوا : قَالَ عُمَرُ ، وَقَالَ عُمَرُ !الْبَيْعُ عَنْ صَفْقَةٍ أَوْ خِيَارٍ ، وَلَكُلِّ مُسْلِمٍ شَرْطُهُ ""","","","","","Book of Wills"
"13858","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، فِيالرَّجُلِ يَشْتَرِي السِّلْعَةَ عَلَى الرِّضَا ، قَالَ :  الْخِيَارُ لِكِلَيْهِمَا حَتَّى يَتَفَرَّقَا عَنْ رِضًا ""","","","","","Book of Wills"
"13859","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ ، يَقُولُ : كُنْتُ أَبْتَاعُ إِنْ رَضِيتُ حَتَّى ابْتَاعَ عَبْدَ اللَّهِ بْنَ مُطِيعٍ بُخْتِيَّةً إِنْ رَضِيَهَا ، قَالَ : إِنَّ الرَّجُلَ يَرْضَى ، ثُمَّ يَدَعُ ، فَكَأَنَّمَا أَيْقَظَنِي ، فَكَانَ يَبْتَاعُ ، ثُمَّ يَقُولُ : هَا إِنْ أَخَذْتَ ""","","","","","Book of Wills"
"13860","قَالَ الثَّوْرِيُّ فِي رَجُلٍ بَاعَ ثَوْبًا ، فَقَالَ : قَدْ أَخَذْتُهُ بِكَذَا وَكَذَا ، أَيَشْتَرِطُ إِنْ رَضِيتُهُ ؟ ، قَالَ : إِذَا لَمْ يُوَقَّتْ لِلرِّضَى أَجَلا فَالْبَيْعُ مَرْدُودٌ ، أَيُّهُمَا شَاءَ رَدَّهُ ""","","","","","Book of Wills"
"13861","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : إِذَا بِعْتَ شَيْئًا عَلَى الرِّضَا ، وَنَقَدَكَ الْوَرِقَ ، فَلا تَخْلِطْهَا بِغَيْرِهَا حَتَّى تَنْظُرَ ، أَيَأْخُذُ أَمْ يَرُدُّ ؟ ""","","","","","Book of Wills"
"13862","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ :اشْتَرَى رَجُلٌ مِنْ رَجُلٍ بَيْعًا ، فَقَالَ : إِنْ جِئْتَنِي بِالنَّقْدِ إِلَى يَوْمِ كَذَا وَكَذَا ، وَإِلا فَلا بَيْعَ بَيْنِي وَبَيْنَكَ ، فَجَاءَهُ مِنَ الْغَدِ فَاخْتَصَمَا إِلَى شُرَيْحٍ ، فَقَالَ شُرَيْحٌ :  أَنْتَ أَخْلَفْتَهُ ""، أَخْبَرَنَا ابْنُ جُرَيْجٍ ، وَقَالَ عَطَاءٌ : "" لَيْسَ هَذَا بَيْعٌ ""","","","","","Book of Wills"
"13863","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، فِيرَجُلٍ اشْتَرَى سِلْعَةً عَلَى الرِّضَا ، وَسَمَّى الثَّمَنَ فَهَلَكَتْ ، قَالَ :  يَضْمَنُ ""","","","","","Book of Wills"
"13864","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، قَالَ : يَحْلِفُ بِاللَّهِ مَا رَضِيَ ، فَإِنْ حَلَفَ فَلا ضَمَانَ عَلَيْهِ ""","","","","","Book of Wills"
"13865","عَنِ الثَّوْرِيِّ ، قَالَ : إِذَا ذَهَبَ عَلَى سَوْمٍ ، وَلَمْ يُسَمِّ الثَّمَنَ ، فَهَلَكَتْ ، فَلا ضَمَانَ عَلَيْهِ ""","","","","","Book of Wills"
"13866","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ سَلْمَانَ بْنِ رَبِيعَةَ ، سُئِلَ عَنْرَجُلٍ اشْتَرَى مِنْ رَجُلٍ سِلْعَةً عَلَى أَنْ يَنْظُرَ إِلَيْهَا ، وَقَطَعَ الثَّمَنَ ، فَمَاتَتْ ، قَالَ :  يَضْمَنُ ""","","","","","Book of Wills"
"13867","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، وَعَنْ عَمْرِو بْنِ مُسْلِمٍ ، عَنْ طَاوُسٍ فِيرَجُلٍ أَخَذَ ثَوْبًا مِنْ رَجُلٍ ، فَقَالَ : اذْهَبْ بِهِ فَإِنْ رَضِيتَهُ أَخَذْتَهُ ، فَبَاعَهُ قَبْلَ أَنْ يَرْجِعَ إِلَى الرَّجُلِ ، فَقَالَ :  هُوَ جَائِزٌ عَلَيْهِ حِينَ بَاعَهُ ""، قَالَ عَمْرٌو : فَسَأَلْتُ عِكْرِمَةَ ، فَقَالَ : "" لا يَحِلُّ لَهُ الرِّبْحُ "" ، قَالَ مَعْمَرٌ : "" وَقَوْلُ طَاوُسٍ أَحَبُّ إِلَيَّ ""","","","","","Book of Wills"
"13868","أَخْبَرَنَا بَكَّارٌ ، قَالَ : سَمِعْتُ وَهْبَ بْنَ مُنَبِّهٍ يَسْأَلُ عَنْهَا ، فَقَالَ :  هُوَجَائِزٌ عَلَيْهِ حِينَ بَاعَهُ ""","","","","","Book of Wills"
"13869","أَخْبَرَنَا الثَّوْرِيُّ :  فِيرَجُلٍ بَاعَ شَيْئًا بِرِضًى ، فَسَمَّى الْمُشْتَرِي أَجَلا يَرُدُّهُ فِيهِ ، فَإِنْ حَبِسَهُ فَوْقَ الشَّرْطِ الَّذِي ضَرَبَهُ لَهُ فَقَدْ لَزِمَهُ الْبَيْعُ ، وَإِنْ هَلَكَ الْمُشْتَرِي فِي الشَّرْطِ قَبْلَ أَنْ يُعْلَمَ رَضِيَ أَوْ لَمْ يَرْضَ لَزِمَ وَرَثَتُهُ ، فَإِنْ مَاتَ الْبَائِعُ وَالْمُشْتَرِي فِي أَجَلِهِ ، فَهُوَ عَلَى شَرْطِهِ يَرُدُّهُ عَلَى وَرَثَةِ الْبَائِعِ إِنْ شَاءَ ""","","","","","Book of Wills"
"13870","أَخْبَرَنَا الثَّوْرِيُّ ، فِيرَجُلٍ أَخَذَ مِنْ رَجُلٍ ثَوْبَيْنِ عَلَى أَنْ يَرْضَى أَحَدُهُمَا ، فَهَلَكَا جَمِيعًا وَقَدْ سَمَّيَا الثَّمَنَ ، قَالَ :  يُغَرَمُ أَنْصَافُ أَثْمَانِهِمَا ، فَإِنْ هَلَكَ أَحَدُهُمَا ضَمِنَهُ ""","","","","","Book of Wills"
"13871","أَخْبَرَنَا مَعْمَرٌ ، وَالثَّوْرِيُّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ : كُلُّ بَيْعٍ فِيهِ شَرْطٌ ، فَالشَّرْطُ بَاطِلٌ إِلا الْعِتَاقَةَ ، وَكُلُّ نِكَاحٍ فِيهِ شَرْطٌ ، فَالشَّرْطُ بَاطِلٌ إِلا الطَّلاقَ ""","","","","","Book of Wills"
"13872","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ أَبِي نُجَيْحٍ ، قَالَ : مَنِ اشْتَرَطَ شَرْطًا ، وَنَقَصَ مِنْهُ مِنَ الثَّمَنِ ، فَالشَّرْطُ بَاطِلٌ ، وَيُرَدُّ إِلَيْهِ مَا نَقَصَ ""","","","","","Book of Wills"
"13873","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، قَالَ : أَرَادَ ابْنُ مَسْعُودٍ أَنْيَشْتَرِيَ مِنِ امْرَأَتِهِ جَارِيَةً يَتَسَرَّى بِهَا ، فَقَالَتْ : لا ، أَبِيعَكَهَا حَتَّى أَشْتَرِطَ عَلَيْكَ أَنَّكَ إِنْ تَبِيعَهَا بِعْتَنِي ، فَأَنَا أَوْلَى بِهَا بِالثَّمَنِ ، قَالَ : حَتَّى أَسْأَلَ عُمَرَ ، فَسَأَلَهُ ، فَقَالَ :  لا تَقْرَبْهَا وَفِيهَا شَرْطٌ لأَحَدٍ ""","","","","","Book of Wills"
"13874","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ عَاصِمِ بْنِ عُبَيْدِ اللَّهِ ، عَنِ الْقَاسِمِ ، أَنَّ عَائِشَةَ :كَرِهَتْ أَنْ تُبَاعَ الأَمَةُ بِشَرْطٍ ""","","","","","Book of Wills"
"13875","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، قَالَ : بِعْتُجَارِيَةً لأَبِي ، وَشَرَطْتُ أَنْ لا تُبَاعَ وَلا تُوهَبَ ، فَقُلْتُ لابْنِ طَاوُسٍ : فَإنَّ عُمَرَ ، قَالَ :  لا تَقْرَبْهَا وَلأَحَدٍ فِيهَا شَرْطٌ "" ، قَالَ : "" لَيْسَ فِيهَا شَرْطٌ ، إِنِّمَا هُوَ لِنَفْسِهَا ""","","","","","Book of Wills"
"13876","أَخْبَرَنَا مَعْمَرٌ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ عِكْرِمَةَ فِيالرَّجُلِ يَشْتَرِي الْبَيْعَ ، فَيَقُولُ الْبَايِعُ لِلْمُشْتَرِي : لَيْسَ عَلَيْكَ غُرْمٌ إِنْ وَضَعْتَ ، قَالَ :  لَيْسَ هَذَا بَيْعٌ ""","","","","","Book of Wills"
"13877","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ رَفِيعٍ ، قَالَ : خَاصَمْتُ إِلَى شُرَيْحٍ فِيجَارِيَةٍ بِعْتُهَا مِنْ رَجُلٍ ، فَبَلَغَنِي عَنْهُ الإِفْلاسَ ، فَقُلْتُ : خُذْ لِي مِنْهُ كَفِيلا ، قَالَ :  مَالُكَ حَيْثُ وَضَعْتَهُ "" ، قُلْتُ : إِنِّي اشْتَرَطْتُ أَنِّي إِنْ أَدْرَكَتْنِي فَهَا نَفْسِي ، قَالَ : "" قَدْ أَقْرَرْتَ بِالْبَيْعِ ، فَبَيِّنَتُكَ عَلَى الشَّرْطِ ""","","","","","Book of Wills"
"13878","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ عَبْدِ اللَّهِ قَالَ : أَخْبَرَنِي عُبَيْدُ اللَّهِ بْنُ الْعِيزَارِ قَالَ : خَاصَمْتُ إِلَى شُرَيْحٍ فِي . . . . لِي عَلَى رَجُلٍ ، فَقُلْتُ : خُذْ لِي مِنْهُ كَفِيلا حَتَّى آتِي بِشُهُودٍ ، فَقَالَ : أَتَيَتْ شُهُودُكَ فَلَمْ يَثْبُتْ عَلَيْهِ شَيْءٌ بَعْدَ ذَلِكَ ""","","","","","Book of Wills"
"13879","أَخْبَرَنَا أَبُو سُفْيَانَ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، قَالَ : جَاءَتِ امْرَأَةٌ إِلَى الشَّعْبِيِّ ، فَقَالَتْ : إِنَّابْنَتِي بِيعَتْ عَلَى أَنْ لا تُبَاعَ ، قَالَ :  ابْنَتُكِ عَلَى شَرْطِهَا ""","","","","","Book of Wills"
"13880","قَالَ : وَأَخْبَرَنِي الثَّوْرِيُّ ، عَنْ شَبِيبِ بْنِ غَرْقَدَةَ ، قَالَ : سَمِعْتُ شُرَيْحًا ، يَقُولُ : لِكُلِّ مُسْلِمٌ شَرْطُهُ ""","","","","","Book of Wills"
"13881","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ فِيالرَّجُلِ يَبِيعُ الرَّجُلَ الْجَارِيَةَ عَلَى أَنَّكَ تَتَسَرَّاهَا ، وَلا تَبِيعُهَا ، وَلا تَعْزِلُهَا ، وَعَلَى أَنَّكَ إِنْ جِئْتَ بِالنَّقْدِ إِلَى يَوْمِ كَذَا وَكَذَا ، وَإِلا فَلا بَيْعَ بَيْنِي وَبَيْنَكَ ، قَالَ :  لَيْسَ هَذَا بَيْعٌ ، هِيَ مِنَ الْبَائِعِ ، وَكُلُّ بَيْعٍ فِيهِ شَرْطٌ فَلَيْسَ بِيعًا ""، قَالَ : وَقَالَ عَمْرُو بْنُ دِينَارٍ : "" لا بَأْسَ بِذَلِكَ ""","","","","","Book of Wills"
"13882","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، وَحَمَّادٍ في رجل ، قَالَ لِرَجُلٍ : أَكْتَرِي مِنْكَ إِلَى مَكَّةَ بِكَذَا وَكَذَا ، فَإِنْ سِرْتُ شَهْرًا أَوْ كَذَا وَكَذَا فَلَكَ زِيَادَةُ كَذَا وَكَذَا ، فَلَمْ يَرَيَا بِهِ بَأْسًا ، وَكُرِهَ أَنْ يَقُولَ : أَكْتَرِي مِنْكَ بِكَذَا وَكَذَا عَلَى أَنْ تَسِيرَ شَهْرًا ، فَإِنْ سِرْتُ أَقَلَّ مِنْ شَهْرٍ نَقَصْتَ مِنْ كَذَلِكَ كَذَا وَكَذَا ""","","","","","Book of Wills"
"13883","أَخْبَرَنَا مَعْمَرٌ ، قَالَ : سَأَلْتُ الزُّهْرِيَّ عَنْ رَجُلٍ اكْتَرَى مِنْ رَجُلٍ طَعَامًا لَهُ إِلَى بَعْضِ هَذِهِ الْمَعَادِنِ ، فَقَالَ :أَكْتَرِي مِنْكَ بِكَذَا وَكَذَا عَلَى أَنْ تَسِيرَ شَهْرًا ، فَإِنْ سِرْتَ أَكْثَرَ مِنْ شَهْرٍ فَطَعَامِي عَلَيْكَ بَيْعٌ ، كُلُّ صَاعٍ بِدِرْهَمٍ ، قَالَ :  لا يَجُوزُ هَذَا الشَّرْطُ ""","","","","","Book of Wills"
"13884","أَخْبَرَنَا الثَّوْرِيُّ ، فِيرَجُلٍ يَتَكَارَى الطَّعَامَ إِلَى مَعْدَنٍ ، كُلُّ بَعِيرٍ بِدِينَارَيْنِ ، عَلَى أَنْ تُوافِينِي يَوْمَ كَذَا وَكَذَا ، فَإِنْ لَمْ تُوافِينِي فِي يَوْمِ كَذَا ، وَكَذَا فَعَلَيْكَ طَعَامِي بَيْعٌ ، بِكَذَا وَكَذَا ، قَالَ :  هَذَا لا يَصْلُحُ ""","","","","","Book of Wills"
"13885","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : اخْتُصِمَ إِلَى شُرَيْحٍ فِي رَجُلٍ اكْتَرَى مِنْ رَجُلٍ ظَهْرَهُ ، فَقَالَ : إِنْ لَمْ أَخْرُجْ يَوْمَ كَذَا وَكَذَا فَلَكَ زِيَادَةُ كَذَا وَكَذَا ، فَلَمْ يَخْرُجْ يَوْمَئِذٍ وَحَبَسَهُ ، فَقَالَ شُرَيْحٌ : مَنْ شَرَطَ عَلَى نَفْسِهِ شَرْطًا طَائِعًا غَيْرَ مُكْرَهٍ ، أَجَزْنَاهُ عَلَيْهِ ""","","","","","Book of Wills"
"13886","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : قُلْتُ لَهُ :الرَّجُلُ يَكْتَرِي إِلَى مَكَّةَ مُقْبِلا وَمُدْبِرًا بِكَذَا وَكَذَا ، فَإِنْ جَلَسْتَ فَلِي مِنَ الْكِرَاءِ كَذَا ، قَالَ :  لا ""","","","","","Book of Wills"
"13887","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنِ الْمُطَّلِبِ بْنِ عَبْدِ اللَّهِ بْنِ حَنْطَبٍ :  أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَاشْتَرَى مِنْ جَابِرِ بْنِ عَبْدِ اللَّهِ بَعِيرًا ، وَأَفْقَرَهُ ظَهْرَهُ إِلَى الْمَدِينَةِ ""","","","","","Book of Wills"
"13888","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، أَنَّ عُمَرَ :  كَانَيَكْرَهُ أَنْ يُسْتَوضَعَ بَعْدَمَا يَجِبُ الْبَيْعُ ""","","","","","Book of Wills"
"13889","أَخْبَرَنَا مَعْمَرٌ ، عَنْ هَارُونَ بْنِ رِئَابٍ ، قَالَ :اشْتَرَى ابْنُ عُمَرَ بَعِيرًا فَمَرَّ بِهِ عَلَى قَوْمٍ ، فَأَخْبَرَهُمْ بِكَمْ أَخَذَهُ ، فَقَالُوا لَهُ : ارْجِعْ فَاسْتَوْضِعْ صَاحِبَهُ ، فَإِنَّهُ سَيَضَعُ لَكَ ، فَقَالَ :  لا ، قَدْ رَضِيتُهُ ""","","","","","Book of Wills"
"13890","عَنْ ثَوْرٍ ، عَنْ جَابِرٍ ، قَالَ : مَنْ رَأَى ابْنَ عُمَرَ ، يَقُولُ لِخَادِمِهِ : إِذَا ابْتَعْتَ لَحْمًا بِدِرْهَمٍ فَلا تَسْتَزِدْ شَيْئًا ""","","","","","Book of Wills"
"13891","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ طَاوُسٍ ، عَنْ يُونُسَ بْنِ أَبِي إِسْحَاقَ ، عَنْ رَجُلٍ قَالَ :مَرَّ عَلِيٌّ بِجَارِيَةٍ تَشْتَرِي لَحْمًا مِنْ قَصَّابٍ وَهِيَ تَقُولُ : زِدْنِي ، فَقَالَ عَلِيٌّ :  زِدْهَا فَإِنَّهُ أَبْرَكُ لِلْبَيْعِ ""","","","","","Book of Wills"
"13892","عَنِ الثَّوْرِيِّ ، عَنِ أَبِي سِنَّانَ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي الْهُذَيْلِ ، قَالَ الثَّوْرِيُّ : وَحَدَّثَنِيهِ أَجْلَحٌ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي الْهُذَيْلِ ، قَالَ :  رَأَيْتُ عَمَّارَ بْنَ يَاسِرٍاشْتَرَى قِثَّاءً بِدَرَاهِمَ ، فَرَأَيْتُهُ يُنَازِعُ صَاحِبَهُ عَلَى حَبْلٍ بَعْدَ مَا وَجَبَ الْبَيْعُ ، فَلا أَدْرِي أَيُّهُمَا غَلَبَ عَلَيْهِ ، ثُمَّ أَخَذَهُ فَاحْتَمَلَهُ عَلَى ظَهْرِهِ حَتَّى أَبْلَغَهُ الْقَصْرَ ""","","","","","Book of Wills"
"13893","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ شُرَيْحٍ ، قَالَ : سَمِعْتُهُ يَقُولُ فِيرَجُلٍ يَضَعُ مِنْ حَقِّهِ طَائِفَةً ثُمَّ يَرْجِعُ فِيهِ ، سَمِعْتُهُ يَقُولُ لِلَّذِي تَرَكَ لَهُ الْحَقَّ :  بَيِّنَتُكَ أَنَّهُ تَرَكَهُ وَهُوَ يَقْدِرُ عَلَى أَنْ يَأْخَذَهُ ، وَلا يُجِيزُ الاضْطِهَادَ وَلا الضَّغْطَةَ ""","","","","","Book of Wills"
"13894","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، قَالَ : كَتَبَ عُرْوَةُ بْنُ مُحَمَّدٍ إِلَى رَجُلٍ بِالْجُنْدِ أَنْ يَقْضِيَ بَيْنَ رَجُلَيْنِ ، وَكَتَبَ إِلَيْهِ أَنْ لا يَقْضِيَ بَيْنَهُمَا حَتَّى يَسْأَلَ طَاوُسًا ، فَسَأَلَهُ فَلا أَدْرِي مَا كَانَ بَيْنَهُمَا غَيْرَ أَنِّي سَمِعْتُ أَبِي ، يَقُولُ :  أَعْلَمُ أَنَّهُلا يَجُوزُ بَيْعٌ مُكْرَهٌ ""","","","","","Book of Wills"
"13895","عَنْ إِسْرَائِيلَ ، عَنْ أَبِي الْهَيْثَمِ ، قَالَ : قُلْتُ لإِبْرَاهِيمَ :الرَّجُلُ يُعْذِبُ ، اشْتَرِي مِنْهُ ؟ ، قَالَ :  لا ""","","","","","Book of Wills"
"13896","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ التَّمْرَةِ بِالتَّمْرَةِ ، وَعَنْ بَيْعِ الثَّمَرَةِ حَتَّى يَبْدُوَ صَلاحُهَا ""","","","","","Book of Wills"
"13897","أَخْبَرَنَا مَالِكٌ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الثَّمَرَةِ حَتَّى يَبْدُوَ صَلاحُهَا ، الْبَائِعَ وَالْمُبْتَاعَ ""","","","","","Book of Wills"
"13898","أَخْبَرَنَا مَعْمَرٌ ، وَابْنُ عُيَيْنَةَ ، عَنِ الزُّهْرِيِّ ، عَنْ خَارِجَةَ بْنِ زَيْدٍ ، عَنْ زَيْدِ بْنِ ثَابِتٍ ، قَالَ وَهُوَ بِالْمَدِينَةِ : لا تَبْتَاعُوا الثَّمَرَةَ حَتَّى تَطْلُعَ الثُّرَيَّا ""، قَالَ الزُّهْرِيُّ : فَذَكَرْتُ ذَلِكَ لِسَالِمِ بْنِ عَبْدِ اللَّهِ ، فَقَالَ : "" إِنَّ الْعَاهَةَ لَتَكُونَ بَعْدَ ذَلِكَ ""","","","","","Book of Wills"
"13899","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : نَهِيَ عَنْ بَيْعِ الثَّمَرَةِ حَتَّى يَبْدُوَ صَلاحُهَا ، وَعَنِ السُّنْبُلِ حَتَّى يَبِيضَ ، وَعَنِ الْبُسْرِ حَتَّى يَزْهُوَ ""، قَالَ : وَيْقُولُ بَعْضُهُمْ : "" حَتَّى يُفْرَكَ الطَّعَامُ ""","","","","","Book of Wills"
"13900","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ طَاوُسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لا أَدْرِي أَبَلَّغَ بِهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : نَهَى عَنْ بَيْعِ الثَّمَرَةِ حَتَّى تُطْعَمَ ""، قَالَ : وَقَالَ ابْنُ عُمَرَ : "" حَتَّى يَبْدُوَ صَلاحُهَا ""","","","","","Book of Wills"
"13901","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الْبُرِّ حَتَّى يَشْتَدَّ فِي أَكْمَامِهِ ""","","","","","Book of Wills"
"13902","عَنِ الثَّوْرِيُّ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ النَّجْرَانِيِّ ، عَنِ ابْنِ عُمَرَ ، قَالَ : ابْتَاعَ رَجُلٌ مِنْ رَجُلٍ نَخْلا فَلَمْ تُخْرِجِ السَّنَةُ شَيْئًا ، فَاخْتَصَمَا إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  بِمَ تَسْتَحِلُّ دَرَاهِمَهُ ؟ ،ارْدُدْ إِلَيْهِ دَرَاهِمَهُ ، وَلا تُسَلِّفَنَّ فِي نَخْلٍ حَتَّى يَبْدُوَ صَلاحُهُ ""، قَالَ : فَسَأَلْتُ مَسْرُوقًا مَا صَلاحُهُ ؟ ، فَقَالَ : "" يَحْمَارُّ ، وَيَصْفَارُّ ""","","","","","Book of Wills"
"13903","عَنِ الثَّوْرِيِّ ، عَنِ شَيْخٍ لَهُمْ ، عَنْ أَنَسٍ ، قَالَ : نَهَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ النَّخْلِ حَتَّى يَزْهُوَ ، وَعَنْ بَيْعِ الْحَبِّ حَتَّى يَفْرُكَ ، وَعَنْ بَيْعِ الثِّمَارِ حَتَّى تُطْعَمَ ""","","","","","Book of Wills"
"13904","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنِ الْعَوْفِيِّ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا تَبْتَاعُوا الثَّمَرَةَ حَتَّى يَبْدُوَ صَلاحُهَا "" ، قَالَ : وَمَتَى يَبْدُو صَلاحُهَا ؟ ، قَالَ : "" حَتَّى تَذْهَبَ عَاهَتُهَا ، وَيَخْلُصَ طَيِّبُهَا ""","","","","","Book of Wills"
"13905","أَخْبَرَنَا هِشَامُ بْنُ حَسَّانٍ ، عَنْ أَنَسِ بْنِ سِيرِينَ ، عَنِ ابْنِ عَبَّاسٍ : قَالَ : إِذَا احْمَرَّ بَعْضُ النَّخْلِ أَجْزَأَهُ أَنْ يَبِيعَهُ ""، عَنِ الثَّوْرِيِّ ، وَهِشَامٍ ، وَغَيْرِهِ ، عَنْ أَنَسِ بْنِ سِيرِينَ ، عَنِ ابْنِ عَبَّاسٍ مِثْلَهُ""","","","","","Book of Wills"
"13906","قَالَ سُفْيَانُ فِيالَّذِي يَشْتَرِي الثَّمَرَةَ ، ثُمَّ تُثْمِرُ أُخْرَى ، قَالَ لَهُ :  مَا خَرَجَ أَوَّلَ مَرَّةٍ ""","","","","","Book of Wills"
"13907","أَخْبَرَنَا مَعْمَرٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، أَنَّ عُمَرَ ، وَابْنَ مَسْعُودٍ ، قَالا : لا يُبَاعُ ثَمَرُ النَّخْلِ حَتَّى يَحْمَارَّ وَيَصْفَارَّ ""","","","","","Book of Wills"
"13908","أَخْبَرَنَا مُحَمَّدُ بْنُ رَاشِدٍ ، عَنْ يَزِيدَ بْنِ يَعْفُرَ أَنَّهُ سَمِعَ الْحَسَنَ ، يَقُولُ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يُبَاعَ الْبُسْرُ حَتَّى يَصْفَرَّ ، وَالْعِنَبُ حَتَّى يَسْوَدَّ ، وَالْحَبُّ حَتَّى يَشْتَدَّ فِي أَكْمَامِهِ ""","","","","","Book of Wills"
"13909","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، قَالَ : إِذَا أُطْعِمَ الثَّمَرُ حَلَّ بَيْعُهُ "" ، قَالَ : "" وَإِذَا كَانَ مَطْعَمُهُ أَكْثَرَ مِنَ الآخَرِ حَلَّ بَيْعُهُ ""","","","","","Book of Wills"
"13910","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنِ الْحَسَنِ ابْنِ عُمَارَةَ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ ، قَالَ فِيالْفِرْسِكِ ، وَالتُّفَّاحِ ، وَالْكُمِّثْرَى ، وَأَشْبَاهِهِ :  يُبَاعُ إِذَا عُقِدَ "" ، يَقُولُ : "" إِذَا صَارَ حَبًّا ""","","","","","Book of Wills"
"13911","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، قَالَ : سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ : قَدْنَهَيْتُ ابْنَ الزُّبَيْرِ عَنْ بَيْعِ النَّخْلِ مُعَاوَمَةً","","","","","Book of Wills"
"13912","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ أَبِي جَعْفَرٍ ، قَالَ :كَتَبَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَدَقَةً إِلَيَّ، فَأَتَيْتُ مَحْمُودَ بْنَ لَبِيدٍ فَسَأَلْتُهُ ، فَقَالَ : كَانَ عُمَرُ بْنُ الْخَطَّابِ يَبِيعُ مَالَ يَتِيمٍ عِنْدَهُ ثَلاثُ سِنِينَ يَعْنِي ثَمَرَهُ","","","","","Book of Wills"
"13913","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، أَنَّ عُمَرَ :  كَانَيَبِيعُ مَالَ يَتِيمٍ عِنْدَهُ ثَلاثُ سِنِينَ ""، يَعْنِي ثَمَرَهُ""","","","","","Book of Wills"
"13914","أَخْبَرَنَا مَعْمَرٌ ، عَمَّنْ ، سَمِعَ عِكْرِمَةَ ، يَقُولُ : إِيَّاكُمْ وَبَيْعَ السِّرَارِ ! فَإنَّ بَيْعَ السِّرَارِ لا يَصْلُحُ ، وَهُوَ يَرْجِعُ إِلَى غُرْمٍ وَنَدَامَةٍ ""","","","","","Book of Wills"
"13915","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، قَالَ :  كَانَيَنْهَى عَنْ إِلْقَاءِ الْحَجَرِ ""","","","","","Book of Wills"
