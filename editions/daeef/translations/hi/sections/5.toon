hadiths[493]{hadithnumber,text}:
"1009","[AI-translation] ((सलाम हमारी उम्मत के लिए तोहफ़ा है और हमारे ज़िम्मियों के लिए हिफ़ाज़त है))।"
"1010","[AI-translation] ((ग़ीबत करने वाला और ग़ीबत सुनने वाला दोनों गुनाह में शरीक हैं))।"
"1011","[AI-translation] ((जिसकी तूने ग़ीबत की उसके लिए कफ़्फ़ारा यह है कि तू उसके लिए मग़फ़िरत माँगे))।"
"1012","[AI-translation] ((हासिद और चुग़लख़ोर का मुझसे कोई ताल्लुक़ नहीं))।"
"1013","[AI-translation] ((ग़ुस्सा शैतान से है, और शैतान आग से पैदा किया गया, और आग पानी से बुझती है; तो जब तुममें से कोई ग़ुस्सा हो तो वह वुज़ू करे))।"
"1014","[AI-translation] ((ग़ुस्सा एक अंगारा है जो आदम के बेटे के दिल में जलता है))।"
"1015","[AI-translation] ((मोमिन जल्दी ग़ुस्सा होता है और जल्दी राज़ी होता है))।"
"1016","[AI-translation] ((मेरी उम्मत के बेहतरीन लोग वे हैं जो ग़ुस्सा हों तो पलट आएँ))।"
"1017","[AI-translation] ((सबसे बड़ी ख़ियानत यह है कि तू अपने भाई से कोई बात कहे, वह तेरा यक़ीन करे, लेकिन तू उससे झूठ बोल रहा हो))।"
"1018","[AI-translation] ((झूठ से बचो, क्योंकि झूठ ईमान से दूर ले जाता है))।"
"1019","[AI-translation] ((ऊँट की तरह एक साँस में न पियो, बल्कि दो या तीन घूँटों में पियो, और जब पीना शुरू करो तो बिस्मिल्लाह कहो, और जब फ़ारिग़ होकर उठो तो अलहम्दुलिल्लाह कहो))।"
"1020","[AI-translation] ((उसके [यानी अपने बाप के] आगे न चल, उससे पहले न बैठ, और उसे नाम से न पुकार))।"
"1021","[AI-translation] ((सब गुनाहों में से अल्लाह जिसे चाहे उसकी सज़ा क़ियामत के दिन तक मुअख़्खर करता है, सिवाय वालिदैन की नाफ़रमानी के; बेशक अल्लाह वालिदैन के नाफ़रमान को मौत से पहले इस दुनिया में सज़ा देता है))।"
"1022","[AI-translation] ((बेशक सदक़े और सिला-रहमी के ज़रिए अल्लाह तआला उम्र बढ़ाता है और बुरी मौत से हिफ़ाज़त करता है))।"
"1023","[AI-translation] ((अल्लाह तआला सिला-रहमी की बरकत से लोगों के इलाक़े आबाद करता है और उनका माल बढ़ाता है))।"
"1024","[AI-translation] ((जिसमें तीन ख़स्लतें हों, अल्लाह तआला उससे आसान हिसाब लेगा और अपनी रहमत से उसे जन्नत में दाख़िल करेगा [और वे हैं]: जो तुझे महरूम करे उसे दे, जो तुझसे ताल्लुक़ तोड़े उससे जोड़े, और जो तुझ पर ज़ुल्म करे उसे माफ़ कर))।"
"1025","[AI-translation] ((जब कोई जुमा से लौटकर अपने भाई से मिले तो कहे «تقبل الله منا و منك», यानी: अल्लाह हमसे और तुमसे क़ुबूल करे))।"
"1026","[AI-translation] ((एक-दूसरे को तोहफ़े दो, क्योंकि वे मुहब्बत पैदा करते हैं और कीना दूर करते हैं))।"
"1027","[AI-translation] ((एक-दूसरे को तोहफ़े दो, तोहफ़े दिल की बीमारियाँ और शक दूर करते हैं))।"
"1028","[AI-translation] ((एक-दूसरे से मुसाफ़हा करो; इससे तुम्हारे दिलों से कीना और धोखा दूर होगा))।"
"1029","[AI-translation] ((जब दो मुसलमान मिलकर मुसाफ़हा करें और अल्लाह की हम्द करें और उससे मग़फ़िरत माँगें, अल्लाह उन्हें बख़्श देता है))।"
"1030","[AI-translation] ((जब मोमिन दूसरे मोमिन से मुसाफ़हा करे तो दोनों पर सौ रहमतें उतरती हैं))।"
"1031","[AI-translation] ((अपने मुसलमान भाई से झगड़ा न कर, उसका मज़ाक़ न उड़ा, और उससे कोई वादा करके फिर तोड़ न))।"
"1032","[AI-translation] ((दो ख़स्लतें मोमिन में जमा नहीं हो सकतीं: बुख़्ल और बुरे अख़लाक़))।"
"1033","[AI-translation] ((धोखेबाज़, बख़ील और बदअख़लाक़ शख़्स जन्नत में दाख़िल न होगा))।"
"1034","[AI-translation] ((नहूसत बदमिज़ाजी की वजह से है))।"
"1035","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) आईने में देखते वक़्त [यह दुआ] पढ़ते: «اللهم كما حسنت خلقي فحسن خلقي» यानी ऐ अल्लाह! जैसे तूने मेरी सूरत ख़ूबसूरत बनाई, मेरे अख़लाक़ भी ख़ूबसूरत बना))।"
"1036","[AI-translation] ((जो नौजवान बूढ़े की उम्र की वजह से इज़्ज़त करे, अल्लाह तआला कोई मुक़र्रर करेगा जो बुढ़ापे में उसकी इज़्ज़त करेगा))।"
"1037","[AI-translation] ((एक दिन नबी (सल्लल्लाहु अलैहि वसल्लम) बैठे थे जब आपके रज़ाई वालिद आए, तो नबी (सल्लल्लाहु अलैहि वसल्लम) ने अपने कपड़े का एक हिस्सा उनके लिए बिछाया और वह उस पर बैठे। फिर आपकी रज़ाई वालिदा आईं, तो नबी (सल्लल्लाहु अलैहि वसल्लम) ने दूसरी तरफ़ से अपना कपड़ा बिछाया और वह उस पर बैठीं। फिर आपके रज़ाई भाई आए, तो नबी (सल्लल्लाहु अलैहि वसल्लम) उनके लिए खड़े हुए और उन्हें अपने सामने बिठाया))।"
"1038","[AI-translation] ((सिर्फ़ गधा इज़्ज़त और एहतराम का इनकार करता है))।"
"1039","[AI-translation] ((अगर हया कोई शख़्स होती तो अच्छी शख़्स होती, और अगर बेहयाई कोई शख़्स होती तो बुरी शख़्स होती))।"
"1040","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) की मुबारक ज़बान पर लानत है वह शख़्स जो मजलिस के बीच में बैठे))।"
"1041","[AI-translation] ((आदमी का जमाल उसकी ज़बान की फ़साहत है))।"
"1042","[AI-translation] ((मेरी हदीसों में से अपने पैरोकारों के सामने सिर्फ़ वे बयान करो जिन्हें उनकी अक़्लें समझ सकें))।"
"1043","[AI-translation] ((जब भी नबी (सल्लल्लाहु अलैहि वसल्लम) कोई हदीस बयान करते तो मुस्कुराते))।"
"1044","[AI-translation] ((मैं खेल-कूद से नहीं, न खेल-कूद का मुझसे कोई ताल्लुक़ है))।"
"1045","[AI-translation] ((मुसलमान को न डराओ, क्योंकि मुसलमान को डराना बड़ा ज़ुल्म है))।"
"1046","[AI-translation] ((फ़राइज़ के बाद अल्लाह तआला को सबसे महबूब अमल मुसलमान को ख़ुशी पहुँचाना है))।"
"1047","[AI-translation] ((जो मुसलमान घराने को ख़ुशी पहुँचाए, अल्लाह तआला बदले में उसे जन्नत देकर राज़ी होगा))।"
"1048","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने कभी जमाही नहीं ली))।"
"1049","[AI-translation] ((अल्लाह तआला छींक और जमाही के वक़्त आवाज़ बुलन्द करना नापसन्द करता है))।"
"1050","[AI-translation] ((जो छींके या डकारे, या किसी को छींकते-डकारते सुनकर कहे: «الحمد لله على كل حال من الاحوال», तो अल्लाह तआला उससे सत्तर बीमारियाँ दूर करेगा, जिनमें सबसे हल्की कोढ़ है))।"
"1051","[AI-translation] ((जब भी मुसलमान छींके और «الحمد لله» कहे, अल्लाह तआला उसकी छींक से एक फ़रिश्ता पैदा करता है जो क़ियामत के दिन तक अल्लाह की हम्द करता रहता है))।"
"1052","[AI-translation] ((नंगे होने से बचो, क्योंकि तुम्हारे साथ एक है जो तुम्हें कभी नहीं छोड़ता [यानी फ़रिश्ता], सिवाय क़ज़ा-ए-हाजत के वक़्त और जब मर्द अपनी बीवी से ख़लवत में हो))।"
"1053","[AI-translation] ((जन्नती अरबी में बात करेंगे))।"
"1054","[AI-translation] ((इन तीन चीज़ों में से कोई नहीं बचती: बदगुमानी, बदशुगूनी और हसद))।"
"1055","[AI-translation] ((जैसे सलाम का जवाब देना हक़ है, वैसे ही ख़त का जवाब देना भी हक़ है))।"
"1056","[AI-translation] ((जो अपने भाई का ख़त बग़ैर इजाज़त देखे, गोया उसने आग में देखा))।"
"1057","[AI-translation] ((दुनिया मुर्दार है, और उसके तालिब कुत्ते हैं))।"
"1058","[AI-translation] ((जिसके पास चीज़ों की कसरत हो उसकी फ़िक्रें ज़्यादा होंगी; जिसकी फ़िक्रें ज़्यादा हों उसका लालच ज़्यादा होगा; जिसका लालच ज़्यादा हो उसकी बेचैनी ज़्यादा होगी; और जिसकी बेचैनी ज़्यादा हो वह अपने रब से ग़ाफ़िल होगा))।"
"1059","[AI-translation] ((अगर तुम अल्लाह तआला से इस हाल में मिलना चाहते हो कि वह तुमसे राज़ी हो, तो जो तुम्हें दिया गया उसे न छुपाओ, और जो तुमसे माँगा जाए उसे न रोको))।"
"1060","[AI-translation] ((जो सुबह दुनिया की फ़िक्र के साथ करे उसका अल्लाह तआला से कोई ताल्लुक़ नहीं))।"
"1061","[AI-translation] ((उस शख़्स में कोई भलाई नहीं जो सिला-रहमी, अमानतें अदा करने और अल्लाह की मख़लूक़ से बेनियाज़ी के लिए माल जमा न करे))।"
"1062","[AI-translation] ((अल्लाह उस ग़रीब पर लानत करे जो महज़ माल की वजह से अमीर के सामने आजिज़ी करे))।"
"1063","[AI-translation] ((जो मालदार के सामने महज़ उसके माल की वजह से आजिज़ी करे, उसके दीन के दो तिहाई जाते रहे))।"
"1064","[AI-translation] ((हर क़ौम की कुंजी वहाँ है, और जन्नत की कुंजी ग़रीब और मुहताज हैं; ये लोग क़ियामत के दिन अल्लाह की मजलिस में होंगे))।"
"1065","[AI-translation] ((मुझसे अपनी नीयतों के साथ मिलो, अपने आमाल के साथ नहीं))।"
"1066","[AI-translation] ((नाफ़रमानी की छोटाई न देखो, बल्कि उसकी अज़मत देखो जिसकी तुम नाफ़रमानी कर रहे हो))।"
"1067","[AI-translation] ((तोहमत की जगहों से बचो))।"
"1068","[AI-translation] ((जब बन्दा आजिज़ी करे तो अल्लाह तआला उसे सातवें आसमान की तरफ़ उठाता है))।"
"1069","[AI-translation] ((मज़बूत और सख़्त बनो, तीरअन्दाज़ी की मश्क़ करो, और नंगे पैर चलो))।"
"1070","[AI-translation] ((दुआ इबादत का मग़्ज़ है))।"
"1071","[AI-translation] ((दुआ माँगने में कमज़ोरी न दिखाओ, क्योंकि दुआ माँगने से कोई कभी हलाक नहीं होता))।"
"1072","[AI-translation] ((दुआ मोमिन का हथियार, दीन का सुतून और आसमानों-ज़मीन का नूर है))।"
"1073","[AI-translation] ((किसी शख़्स के लिए जायज़ नहीं कि लोगों की इमामत करे फिर सिर्फ़ अपने लिए दुआ करे, दूसरों को छोड़ दे; अगर ऐसा करे तो उसने यक़ीनन लोगों से ख़ियानत की))।"
"1074","[AI-translation] ((तुममें से हर कोई अपने रब से अपनी सब हाजतें माँगे, चाहे जूते का तस्मा टूट जाए, वह भी उसी से माँगे))।"
"1075","[AI-translation] ((जब रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) दुआ के लिए हाथ उठाते तो उन्हें चेहरे पर फेरने से पहले न उतारते))।"
"1076","[AI-translation] ((जब माँगो [दुआ में] तो हथेलियों के अन्दरूनी हिस्से फैलाओ; बाहरी हिस्सों से न माँगो, और जब [दुआ से] फ़ारिग़ हो तो हथेलियाँ चेहरों पर फेरो))।"
"1077","[AI-translation] ((बेशक अल्लाह तआला दुआ में लगे रहने वालों से मुहब्बत करता है))।"
"1078","[AI-translation] रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: जब अल्लाह बन्दे की रूह उसे लौटाता है [सुबह], फिर वह यह दुआ «لا اله الا الله وحده لا شريك له له الملك وله الحمد وهو على كل شىء قدير» पढ़े, तो अल्लाह उसके सब गुनाह बख़्श देता है, चाहे समन्दर की झाग जितने हों।"
"1079","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: जो नींद से जागकर यह दुआ पढ़े: «الحمد لله الذى خلق النوم واليقظة ، الحمد لله الذى بعثنى سالما سويا ، أشهد أن الله يحى الموتى وهو على كل شىء قدير» अल्लाह तआला जवाब में फ़रमाता है कि मेरे बन्दे ने सच कहा))।"
"1080","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने एक आदमी को सोने से पहले सूरत-ए-हश्र पढ़ने की वसीयत की, और आप (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया कि अगर [यह सूरत पढ़कर] मर जाए तो शहीद की मौत पाएगा))।"
"1081","[AI-translation] रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: ((जो यह दुआ सुबह पढ़े उसने उस दिन का शुक्र अदा किया, और जो शाम को पढ़े उसने उस रात का शुक्र अदा किया))।"
"1082","[AI-translation] रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: जो सुबह या शाम एक बार यह दुआ पढ़े: «اللهم انى اصبحت اشهدك واشهد حملة عرشك و ملائكتك و جميع خلقك ، أنت الله لا اله الا انت وأن محمدا عبدك ورسولك», अल्लाह उसके चौथाई हिस्से को जहन्नम की आग से आज़ाद करेगा। जो यह दुआ दो बार पढ़े, अल्लाह उसके आधे को जहन्नम की आग से आज़ाद करेगा। जो तीन बार पढ़े, अल्लाह उसके तीन चौथाई को जहन्नम की आग से आज़ाद करेगा। और जो चार बार पढ़े, अल्लाह उसे [मुकम्मल] जहन्नम की आग से आज़ाद करेगा।"
"1083","[AI-translation] रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: जो सुबह ये आयतें पढ़े: «فسبحان الله حين تمسون وحين تصبحون ، وله الحمد فى السموات والارض وعشيا وحين تظهرون ، يخرج الحي من الميت ويخرج الميت من الحي ويحي الارض بعد موتها وكذلك تخرجون» तो उस दिन की जो ख़ैर और बरकत उससे रह गई हो वह उसे पा लेगा; और जो शाम को ये आयतें पढ़े तो जो ख़ैर और बरकत रह गई हो वह उसे पा लेगा।"
"1084","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: जो यह दुआ सुबह पढ़े वह शाम तक महफ़ूज़ रहेगा, और जो शाम को पढ़े वह सुबह तक महफ़ूज़ रहेगा। «سبحان الله وبحمده لا قوة الا بالله ما شاء الله كان وما لم يشأ لم يكن»))।"
"1085","[AI-translation] रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: जो सुबह «اعوز بالله السميع العليم من الشيطان الرجيم» तीन बार पढ़े फिर सूरत-ए-हश्र की आख़िरी तीन आयतें पढ़े, अल्लाह उसके लिए सत्तर हज़ार फ़रिश्ते मुक़र्रर करेगा जो शाम तक उसके लिए दुआ करेंगे, और अगर वह उस दिन मर जाए तो शहादत का दर्जा पाएगा। और जो शाम को यह कहे, उसके लिए सुबह तक ऐसा ही होगा।"
"1086","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: हर दिन जब बन्दे सुबह में दाख़िल होते हैं तो एक पुकारने वाला [अल्लाह की तरफ़ से] बुलन्द आवाज़ से पुकारता है «سبحان الملك القدوس» और दूसरी रिवायत में है: हर सुबह एक पुकारने वाला पुकारता है: ऐ मख़लूक़! बादशाह, पाक ज़ात [अल्लाह] की तस्बीह करो))।"
"1087","[AI-translation] ((एक रिवायत में है कि रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) सुबह ये कलिमात कहते: «أصبحنا وأصبح الملك لله والحمد لله والكبرياء والعظمة لله والخلق والأمر واليل والنهار وما سكن فيهما لله ، اللهم اجعل أول هذا النهار صلاحا و أوسطه نجاحا واخره فلاحا ، يا أرحم الراحمين»))।"
"1088","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) सुबह-शाम यह दुआ पढ़ते « اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ فَجْأَةِ الْخَيْرِ ، وَأَعُوذُ بِكَ مِنْ فَجْأَةِ الشَّرِّ »))।"
"1089","[AI-translation] ((बलाओं और मुसीबतों से हिफ़ाज़त के लिए रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने एक आदमी को सुबह पढ़ने की यह दुआ सिखाई: «باسم الله على نفسى وأهلي ومالي فانه لا يذهب لك شىء»))।"
"1090","[AI-translation] ((एक रिवायत में है कि जो जुमा की सुबह फ़ज्र की नमाज़ से पहले तीन बार यह दुआ «استغفر الله الذى لا إله إلا هو الحي القيوم و أتوب إليه» पढ़े, उसके सब गुनाह बख़्श दिए जाएँगे, चाहे समन्दर की झाग जितने हों))।"
"1091","[AI-translation] ((जब हज़रत ज़ैद इब्ने साबित (रज़ियल्लाहु अन्हु) ने रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) से बेख़्वाबी की शिकायत की तो आप (सल्लल्लाहु अलैहि वसल्लम) ने उन्हें यह दुआ सिखाई: «اللهم غارت النجوم وهدأت العيون وأنت حي قيوم لا تأخذك سنة ولا نوم يا حي يا قيوم أهدىء ليلى وانى عيني»))।"
"1092","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) बैत-उल-ख़ला में दाख़िल होते वक़्त यह दुआ पढ़ते: «اللهم أني أعوذبك من الرجس النجس الخبيث المخبث : الشيطان الرجيم»))।"
"1093","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) बैत-उल-ख़ला से निकलते वक़्त यह दुआ पढ़ते... « اَلْحَمْدُ لِلّٰهِ الَّذِيْ اَذْهَبَ عَنِّي الْاَذٰي وَعَافَانِيْْ »))।"
"1094","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) बैत-उल-ख़ला से निकलते वक़्त यह दुआ पढ़ते... «الحمد لله الذى أذاقني لذته وأبقي فى قوته ودفع عني أذاه»))।"
"1095","[AI-translation] ((वुज़ू मुकम्मल करने के बाद आसमान की तरफ़ देखकर यह दुआ पढ़नी चाहिए: «أشهد أن لا اله الا الله وحده لا شريك له وأشهد أن محمدا عبده ورسوله»))।"
"1096","[AI-translation] ((«حي على الفلاح» के जवाब में नबी (सल्लल्लाहु अलैहि वसल्लम) ये कलिमात कहते: «اللهم اجعلنا من المفلحين»))।"
"1097","[AI-translation] ((एक रिवायत में है कि अगर किसी को मस्जिद में शायरी पढ़ते देखो तो उसे तीन बार लानत करो «فض الله فاك», यानी अल्लाह तेरा मुँह तोड़े))।"
"1098","[AI-translation] ((जो फ़र्ज़ नमाज़ के बाद आयत-उल-कुर्सी पढ़े वह अगली नमाज़ तक अल्लाह की हिफ़ाज़त में रहेगा))।"
"1099","[AI-translation] ((एक रिवायत में है कि नमाज़ से फ़ारिग़ होकर रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) अपना दायाँ हाथ पेशानी पर फेरते और कहते: «أشهد أن لا اله الا الله الرحمن الرحيم ، اللهم أذهب عنى الهم والحزن»))।"
"1100","[AI-translation] ((एक रिवायत में है कि हज़रत इब्ने अम्र (रज़ियल्लाहु अन्हु) इफ़्तार के वक़्त यह दुआ पढ़ते: «اللهم انى أسألك برحمتك التى وسعت كل شىء أن تغفرلي»))।"
"1101","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) दुश्मन से मुक़ाबले के वक़्त यह कहते: «يا مالك يوم الدين اياك نعبد واياك أستعين»))।"
"1102","[AI-translation] ((एक रिवायत में सलाम के ये अलफ़ाज़ हैं: «وعليك السلام ورحمة االله وبركاته ومغفرته ورضوانه»))।"
"1103","[AI-translation] ((जब रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) घर में दाख़िल होते तो यह दुआ पढ़ते: «اللهم أني أسألك خير المولج و خير المخرج بسم الله ولجنا وبسم الله خرجنا وعلي الله ربنا توكلنا»))।"
"1104","[AI-translation] ((जब तेज़ हवाएँ चलतीं तो नबी (सल्लल्लाहु अलैहि वसल्लम) घुटनों पर बैठ जाते और दुआ करते: «اللهم اجعلها رحمة ولا تجعلها عذابا ، اللهم اجعلها رياحا ولا تجعلها ريحا»))।"
"1105","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) बादल की गरज सुनकर यह दुआ पढ़ते: «اللهم لا تقتلنا بغضبك ولا تهلكنا بعذابك وعافنا قبل ذٰلك »))।"
"1106","[AI-translation] ((जब नबी (सल्लल्लाहु अलैहि वसल्लम) को कोई मामला परेशान करता तो आसमान की तरफ़ देखते और कहते: « سبحان الله وبحمده»))।"
"1107","[AI-translation] ((एक रिवायत में है कि जब कोई काम आदमी पर ग़ालिब आए तो यह दुआ पढ़े: «حسبي الله ونعم الوكيل »))।"
"1108","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: जब आग की लपट देखो तो «الله اكبر» कहो, क्योंकि तकबीर कहना उसे बुझा देगा))।"
"1109","[AI-translation] ((जब बीमार की इयादत करो तो उससे अपने लिए दुआ कराओ, क्योंकि उसकी दुआ फ़रिश्तों की दुआ जैसी है))।"
"1110","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) के फ़रमान के मुताबिक़ जो नए कपड़े पहनते वक़्त यह दुआ «الحمد لله الذى كساني ما اواري به عورتي وأتجمل به فى حياتي» पढ़े वह अल्लाह की हिफ़ाज़त में आएगा))।"
"1111","[AI-translation] रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: ((जब मेरी उम्मत के लोग कश्ती पर सवार हों तो डूबने से बच सकते हैं अगर यह दुआ पढ़ें: «بسم الله مجريها و مرساها ان ربي لغفور رحيم ، وما قدروا الله حق قدره . . .»))।"
"1112","[AI-translation] ((एक रिवायत में है कि जब हज़रत इब्ने अब्बास (रज़ियल्लाहु अन्हुमा) ज़मज़म का पानी पीते तो यह दुआ पढ़ते: «اللهم اني أسألك علما نافعا ورزقا واسعا وشفاء من كل داء»))।"
"1113","[AI-translation] ((क्या मैं तुम्हें तुम्हारी बीमारी और उसका इलाज न बताऊँ? ख़बरदार! तुम्हारी बीमारी गुनाह हैं और तुम्हारा इलाज इस्तिग़फ़ार है))।"
"1114","[AI-translation] ((जो इस्तिग़फ़ार [मग़फ़िरत माँगना] को अपने ऊपर लाज़िम करे, अल्लाह तआला उसे हर मुश्किल से निकलने का रास्ता देगा, उसका हर ग़म दूर करेगा, और उसे वहाँ से देगा जहाँ से वह सोच भी न सकता हो))।"
"1115","[AI-translation] ((जो [गुनाह के बाद] मग़फ़िरत माँगे उसने गुनाह पर इसरार नहीं किया, चाहे दिन में सत्तर बार गुनाह करे))।"
"1116","[AI-translation] ((जो नबी (सल्लल्लाहु अलैहि वसल्लम) पर दुरूद न भेजे, उसका वुज़ू दुरुस्त नहीं))।"
"1117","[AI-translation] ((जो जुमा को मुझ पर अस्सी (80) बार दुरूद भेजे, अल्लाह तआला उसके अस्सी (80) साल के गुनाह बख़्श देगा))।"
"1118","[AI-translation] ((नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) पर दुरूद भेजना ग़ुलाम आज़ाद करने से बेहतर है))।"
"1119","[AI-translation] ((जब मुझ पर दुरूद भेजो तो सबको शामिल करो))।"
"1120","[AI-translation] ((अपनी मजलिसों को मुझ पर दुरूद भेजकर ज़ीनत दो, क्योंकि मुझ पर तुम्हारा दुरूद भेजना क़ियामत के दिन तुम्हारे लिए नूर होगा))।"
"1121","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) पर दुरूद रद्द नहीं होता))।"
"1122","[AI-translation] ((जो हर जुमा मुझ पर चालीस बार दुरूद भेजे, अल्लाह तआला उसके चालीस साल के गुनाह मिटा देता है))।"
"1123","[AI-translation] ((जब अल्लाह के ख़लील [यानी इब्राहीम (अलैहिस्सलाम)] और मेरा ज़िक्र हो तो [पहले] उन पर दुरूद भेजो फिर मुझ पर; और जब [दूसरे] अम्बिया का ज़िक्र हो तो [पहले] मुझ पर दुरूद भेजो फिर उन पर))।"
"1124","[AI-translation] ((बेशक अल्लाह तआला ने मुझे जहानों के लिए रहमत और हिदायत बनाकर भेजा है, और मुझे मूसिक़ी के आले मिटाने का हुक्म दिया है))।"
"1125","[AI-translation] ((मूसिक़ी दिल में निफ़ाक़ उगाती है जैसे पानी सब्ज़ा उगाता है))।"
"1126","[AI-translation] ((जो गाने वाली को ग़ौर से सुने, क़ियामत के दिन उसके कानों में पिघला सीसा डाला जाएगा))।"
"1127","[AI-translation] ((मूसिक़ी ज़िना का मंत्र है))।"
"1128","[AI-translation] ((जो ज़िन्दगी में बाँसुरी बजाए वह ख़ुश नहीं रहता))।"
"1129","[AI-translation] ((जो गाने की आवाज़ ग़ौर से सुने, उसे जन्नत में रूहानी हस्तियों की आवाज़ें सुनने की इजाज़त न होगी))।"
"1130","[AI-translation] ([अबू बर्ज़ा (रज़ियल्लाहु अन्हु) से रिवायत है कि हम नबी (सल्लल्लाहु अलैहि वसल्लम) के साथ थे जब आपने गाने की आवाज़ सुनी, तो फ़रमाया: देखो यह क्या है? इस पर मैं चढ़ा और देखा कि मुआविया और अम्र इब्ने-उल-आस गा रहे थे। मैंने नबी (सल्लल्लाहु अलैहि वसल्लम) को इसकी ख़बर दी, तो आपने उनके ख़िलाफ़ दुआ की, फ़रमाया:] ऐ अल्लाह! उन्हें आज़माइश में डाल और आग में धकेल)।"
"1131","[AI-translation] ((अल्लाह तआला ने गाने और गाने वालों पर लानत की है))।"
"1132","[AI-translation] ((बेशक मुहब्बत गुनाहों का कफ़्फ़ारा है))।"
"1133","[AI-translation] ([एक दिन इब्ने ज़ुबैर (रज़ियल्लाहु अन्हु) ने अपने साथियों से कहा: क्या तुम जानते हो इस हदीस का मतलब क्या है: जो मुझ पर झूठ बाँधे, वह जहन्नम में अपनी जगह बनाए? एक आदमी किसी औरत के इश्क़ में पड़ा। एक शाम वह औरत के घरवालों के पास आया और कहा: मैं नबी (सल्लल्लाहु अलैहि वसल्लम) का क़ासिद हूँ। नबी (सल्लल्लाहु अलैहि वसल्लम) ने मुझे तुम्हारे पास भेजा है ताकि मैं तुम्हारे जिस घर में चाहूँ रहूँ। उसने शाम का इंतिज़ार किया। उनमें से एक नबी (सल्लल्लाहु अलैहि वसल्लम) के पास गया और कहा: फ़लाँ हमारे पास आया है और कहता है कि आपने उसे हुक्म दिया है कि वह हमारे जिस घर में चाहे रात गुज़ारे। नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: उसने झूठ बोला। ऐ फ़लाँ! इस आदमी के साथ जा, और अगर अल्लाह तुझे उस पर क़ुदरत दे तो उसे क़त्ल कर और आग में जला। लेकिन मेरा ख़याल है मौत उसके लिए काफ़ी होगी। फिर आसमान से बारिश हुई। वह वुज़ू के लिए बाहर गया, और साँप ने उसे काट लिया। जब नबी (सल्लल्लाहु अलैहि वसल्लम) को इसकी ख़बर दी गई तो फ़रमाया: वह जहन्नम में है))।"
"1134","[AI-translation] ((आशिक़ों से मशवरा न माँगो; उनकी कोई राय नहीं। ख़बरदार! उनके दिल जले हुए हैं और उनकी अक़्लें छीन ली गई हैं))।"
"1135","[AI-translation] ((किसी चीज़ की मुहब्बत अंधा और बहरा बनाती है))।"
"1136","[AI-translation] ((मुहब्बत करने वालों की मजलिसें कभी कम नहीं होतीं))।"
"1137","[AI-translation] ((उन हदों को हटाओ जिन्हें हटाने की ताक़त पाओ))।"
"1138","[AI-translation] ((मुसलमानों से सज़ाएँ हटाओ जहाँ तक हो सके))।"
"1139","[AI-translation] ((जब चोर पर हद्द क़ायम की जाए तो माल की ज़िम्मेदारी उस पर नहीं रहती))।"
"1140","[AI-translation] ((अगर कोई औरत मुर्तद हो जाए तो उसे क़त्ल न करो))।"
"1141","[AI-translation] ((बदकारों के चेहरे आग में शोले मारे जाएँगे))।"
"1142","[AI-translation] ((ज़िना न करो; तुम्हारी औरतों की लज़्ज़त जाती रहेगी))।"
"1143","[AI-translation] ((जो यहूदी या ईसाई औरत से ज़िना करे, अल्लाह तआला उसे क़ब्र में जलाएगा))।"
"1144","[AI-translation] ((अल्लाह तआला क़ियामत के दिन पड़ोसी की बीवी से ज़िना करने वाले की तरफ़ रहमत से न देखेगा, न उसे पाक करेगा, और उससे कहेगा: उनमें दाख़िल हो जो जहन्नम में दाख़िल हो रहे हैं))।"
"1145","[AI-translation] ((जो ज़िना करे उसने उसी चीज़ से ज़िना किया, चाहे वह अपने ही घर की दीवार से हो))।"
"1146","[AI-translation] ((ज़िना की औलाद क़ियामत के दिन बन्दरों और सूअरों की सूरत में उठाई जाएगी))।"
"1147","[AI-translation] ((जो ज़िना के लिए एक दिरहम ख़र्च करे उसने छह सौ दिरहम गँवाए))।"
"1148","[AI-translation] ((अपने बेटे अबू शहमा की मौत के बाद हज़रत उमर (रज़ियल्लाहु अन्हु) ने उस पर हद्द क़ायम की))।"
"1149","[AI-translation] ((अगर लौंडेबाज़ [लड़कों से बदफ़ेली करने वाला] बग़ैर तौबा मरे तो क़ब्र में सूअर की सूरत में बदल दिया जाता है))।"
"1150","[AI-translation] ((जो लड़के को शहवत से बोसा दे, अल्लाह उस पर लानत करता है; अगर शहवत से मुसाफ़हा करे तो उसकी नमाज़ क़ुबूल नहीं होती; अगर शहवत से गले लगाए तो उसे जहन्नम की आग के कोड़ों से मारा जाएगा; और अगर उसके साथ नाफ़रमानी करे तो अल्लाह उसे आग में दाख़िल करेगा))।"
"1151","[AI-translation] ((कोई मर्द उससे कम हयादार नहीं जो अपने दुबुर में दाख़िला होने दे))।"
"1152","[AI-translation] ((जो जानबूझकर अपने मुसलमान भाई की शर्मगाह देखे, अल्लाह चालीस दिन उसकी नमाज़ क़ुबूल नहीं करता))।"
"1153","[AI-translation] ((जो अपनी आँखें हराम से भरे, अल्लाह तआला उसकी आँखें जहन्नम के अंगारों से भरेगा))।"
"1154","[AI-translation] ((अब्दुल-क़ैस का वफ़्द रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) के पास आया। उनमें एक रोशन-ख़ूबसूरत चेहरे वाला लड़का था, तो नबी (सल्लल्लाहु अलैहि वसल्लम) ने उसे अपने पीछे बिठाया और फ़रमाया: दाऊद (अलैहिस्सलाम) का गुनाह सिर्फ़ एक निगाह थी))।"
"1155","[AI-translation] ((मालदारों के बच्चों के साथ न बैठो, क्योंकि उनका फ़ितना कुँवारी लड़कियों के फ़ितने से भी ज़्यादा सख़्त है))।"
"1156","[AI-translation] ((जो शतरंज खेले वह मलऊन है))।"
"1157","[AI-translation] ((जो शतरंज खेले वह ऐसा है जैसे सूअर का गोश्त खाए))।"
"1158","[AI-translation] ((गर्दन में तलवार लटकाए मर्द की नमाज़ बग़ैर तलवार लटकाए मर्द से सात सौ गुना अफ़ज़ल है))।"
"1159","[AI-translation] ((फ़रिश्ते मुजाहिद के लिए लगातार रहमत की दुआ करते हैं जब तक कमरबन्द उसकी गर्दन पर रहे))।"
"1160","[AI-translation] ((जो ख़ुद अल्लाह के रास्ते में जिहाद में शरीक हुआ, अल्लाह तआला उसे बख़्श देगा))।"
"1161","[AI-translation] ((जो अपने लिए जहन्नम की आग से डरे वह चालीस दिन साहिल पर पहरा दे))।"
"1162","[AI-translation] ((जो अल्लाह के रास्ते में एक तकबीर कहे, तो [क़ियामत के दिन] वह उसकी तराज़ू में चट्टान जैसी होगी, जो सात आसमानों से भारी होगी))।"
"1163","[AI-translation] ((जब लोग इस्लाम क़ुबूल करें तो उन्होंने अपना ख़ून और माल महफ़ूज़ कर लिया))।"
"1164","[AI-translation] ((जो दो घोड़ों के दरमियान [तीसरा] घोड़ा डाले, और उसे यक़ीन न हो कि वह जीतेगा, तो कोई हर्ज नहीं; लेकिन अगर यक़ीन हो तो यह जुआ है))।"
"1165","[AI-translation] ((बेशक हाकिम अल्लाह का साया और ज़मीन पर उसका नेज़ा है))।"
"1166","[AI-translation] ((जब अल्लाह तआला ख़िलाफ़त के लिए कोई मख़लूक़ पैदा करना चाहे तो अपना दायाँ हाथ उसके माथे पर फेरता है))।"
"1167","[AI-translation] ((लोग अपने बादशाहों के दीन पर होते हैं))।"
"1168","[AI-translation] ((क़रीब मुस्तक़बिल में आख़िरी ज़माने में ज़ालिम हुक्मरान होंगे; जो उनके कोड़े और तलवार से डरे, वह उन्हें [अच्छाई का] हुक्म न दे न [बुराई से] मना करे))।"
"1169","[AI-translation] ((मज़लूम की दुआ क़ुबूल होती है जब तक वे ज़ालिमों से तादाद में ज़्यादा न हों, और अगर वे उनसे तादाद में ज़्यादा हों तो उनकी दुआ क़ुबूल नहीं होती))।"
"1170","[AI-translation] ((जो ज़ालिम की मदद करे, अल्लाह तआला उस [ज़ालिम] को उस पर मुसल्लत करता है))।"
"1171","[AI-translation] ((जो बादशाह के सामने जल्दबाज़ी दिखाएँ, फ़ौज के सिपाही और ज़ालिमों के मददगार जहन्नम के कुत्ते हैं))।"
"1172","[AI-translation] ((अल्लाह का ग़ज़ब उस पर सख़्त होता है जो उस शख़्स पर ज़ुल्म करे जिसका अल्लाह के सिवा कोई मददगार न हो))।"
"1173","[AI-translation] ((ऐ अबू हुरैरा! हुक्मरानों पर लानत न करो, क्योंकि अल्लाह तआला ने एक गिरोह को जहन्नम में इसलिए भेजा कि वे अपने हुक्मरानों पर लानत करते थे))।"
"1174","[AI-translation] ((बारह फ़िरऔन हैं: पाँच पिछली उम्मतों में थे और सात मेरी उम्मत में होंगे))।"
"1175","[AI-translation] ((जिससे कोई अपनी इज़्ज़त बचाए, वह उसके लिए सदक़ा है))।"
"1176","[AI-translation] ((जो ज़िम्मी को नुक़सान पहुँचाए, क़ियामत के दिन मैं उसका मुख़ालिफ़ हूँगा))।"
"1177","[AI-translation] ((अगर दसवाँ [टैक्स] वसूल करने वाले से मिलो तो उसे क़त्ल कर दो))।"
"1178","[AI-translation] ((अल्लाह तआला फ़रमाता है: जो क़ुरआन में इतना मशग़ूल हो कि वह मेरे ज़िक्र और मुझसे माँगने से ग़ाफ़िल हो जाए [यानी जो इतना क़ुरआन पढ़े कि उसे अल्लाह से माँगने का मौक़ा ही न मिले], तो मैं उसे माँगने वालों को देने से बेहतर दूँगा, और अल्लाह के कलाम की सब कलामों पर फ़ज़ीलत ऐसी है जैसी मख़लूक़ पर अल्लाह की फ़ज़ीलत है))।"
"1179","[AI-translation] ((क़ुरआन का कोई हिस्सा इतना काफ़ी नहीं जितना सूरत-ए-फ़ातिहा काफ़ी है, और अगर सूरत-ए-फ़ातिहा तराज़ू के एक पल्ले में और पूरा क़ुरआन दूसरे पल्ले में रखा जाए तो सूरत-ए-फ़ातिहा क़ुरआन से सात गुना भारी होगी))।"
"1180","[AI-translation] ((सूरत-ए-फ़ातिहा में ज़हर का इलाज है))।"
"1181","[AI-translation] ((जब अपने बिस्तर पर लेटो और सूरत-ए-फ़ातिहा और 'क़ुल हुवल्लाहु अहद' पढ़ो, तो मौत के सिवा हर चीज़ से महफ़ूज़ हो))।"
"1182","[AI-translation] ((जो घर में सूरत-ए-फ़ातिहा और आयत-उल-कुर्सी पढ़े, उस दिन उसे किसी इंसान या जिन्न की नज़र न लगेगी))।"
"1183","[AI-translation] ((सूरत-ए-फ़ातिहा क़ुरआन के दो तिहाई के बराबर है))।"
"1184","[AI-translation] ((दो आयतें क़ुरआन से हैं; दोनों शफ़ाअत करेंगी, अल्लाह उनसे मुहब्बत करता है, और दोनों सूरत-ए-बक़रा की आख़िरी आयतें हैं))।"
"1185","[AI-translation] ((जो सूरत-ए-बक़रा पढ़े उसे जन्नत में ताज पहनाया जाएगा))।"
"1186","[AI-translation] ((हर चीज़ का कोहान [यानी सबसे ऊँचा मक़ाम] है, और क़ुरआन का कोहान सूरत-ए-बक़रा है))।"
"1187","[AI-translation] ((जो जुमा को वह सूरत पढ़े जिसमें आले-इमरान का ज़िक्र है, अल्लाह तआला सूरज डूबने तक उस पर रहमत भेजेगा, और फ़रिश्ते उसके लिए रहमत की दुआ करेंगे))।"
"1188","[AI-translation] ((अल्लाह का इस्म-ए-आज़म, जिससे दुआ की जाए तो दुआ क़ुबूल होती है, सूरत आले-इमरान की इस आयत में है: «قل اللهم مالك الملك تؤتى الملك من تشاء . . . الخ»))।"
"1189","[AI-translation] ((जो मुश्किल जानवर पर सवार हो और उसके कान में यह आयत [सूरत आले-इमरान से] पढ़े, वह अल्लाह के हुक्म से ठहर जाएगा। «افغير دين الله يبغون وله اسلم من فى السموات والأرض طوعا وكرها واليه يرجعون»))।"
"1190","[AI-translation] ((अल्लाह तआला उस बन्दे को महरूम न करेगा जो रात में नमाज़ के लिए खड़ा हो और सूरत-ए-बक़रा और सूरत आले-इमरान से शुरू करे। सूरत-ए-बक़रा और सूरत आले-इमरान आदमी का बेहतरीन ख़ज़ाना हैं))।"
"1191","[AI-translation] ((जुमों को सूरत हूद पढ़ो))।"
"1192","[AI-translation] ((सूरत हूद और उसके जैसी दूसरी सूरतों [जिनमें क़ियामत के दिन की सिफ़तें हैं] जैसे अल-वाक़िआ, अल-क़ारिआ, अल-हाक़्क़ा, इज़श-शम्सु कुव्विरत और साअला साइल वग़ैरा ने मुझे बूढ़ा कर दिया))।"
"1193","[AI-translation] ((तौरात में सूरत कहफ़ का नाम 'हाइला' है क्योंकि यह सूरत उसके पढ़ने वाले और जहन्नम की आग के दरमियान रुकावट बनती है))।"
"1194","[AI-translation] ((जो सूरत-ए-कहफ़ की पहली तीन आयतें पढ़े वह दज्जाल के फ़ितने से महफ़ूज़ रहेगा))।"
"1195","[AI-translation] ((क्या मैं तुम्हें वह सूरत न बताऊँ जिसकी अज़मत आसमानों-ज़मीन के दरमियान भर देती है, और जो उसे पढ़े उसके लिए बराबर सवाब है, और जो उसे पढ़े उसके गुनाह अगले जुमा तक और तीन दिन और बख़्श दिए जाएँगे? सहाबा (रज़ियल्लाहु अन्हुम) ने कहा: ज़रूर बताइए। तो आप (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: सूरत-ए-कहफ़))।"
"1196","[AI-translation] ((अल्लाह तआला ने आसमानों-ज़मीन की पैदाइश से हज़ार साल पहले सूरत ताहा और सूरत यासीन पढ़ीं। जब फ़रिश्तों ने क़ुरआन सुना तो कहा: ख़ुशख़बरी उस उम्मत के लिए जिस पर यह क़ुरआन उतारा जाएगा))।"
"1197","[AI-translation] ((जो अल्लाह की रज़ा के लिए सूरत यासीन पढ़े, अल्लाह तआला उसके पिछले गुनाह बख़्श देगा))।"
"1198","[AI-translation] ((जो दिन का आग़ाज़ सूरत यासीन पढ़कर करे, उसकी हाजतें पूरी होंगी))।"
"1199","[AI-translation] ((जो जुमा की रात सूरत अद-दुख़ान पढ़े उसे बख़्श दिया जाएगा))।"
"1200","[AI-translation] ((जो रात को सूरत अद-दुख़ान पढ़े, सत्तर हज़ार फ़रिश्ते उसके लिए मग़फ़िरत माँगने लगते हैं))।"
"1201","[AI-translation] ((जो पूरी सूरत दुख़ान, हा-मीम ग़ाफ़िर की इब्तिदाई आयतें «واليه المصير» तक, और आयत-उल-कुर्सी शाम को पढ़े, उनके ज़रिए सुबह तक महफ़ूज़ रहेगा; और जो सुबह पढ़े शाम तक महफ़ूज़ रहेगा))।"
"1202","[AI-translation] ((जो सुबह तीन बार: «اعوذ بالله السميع العليم من الشيطان الرجيم» कहे और सूरत-ए-हश्र की आख़िरी तीन आयतें पढ़े, अल्लाह तआला उसके लिए सत्तर हज़ार फ़रिश्ते मुक़र्रर करेगा जो शाम तक उसके लिए रहमत की दुआ करेंगे, और अगर वह उस दिन मर जाए तो शहीद की मौत मरेगा। और जो शाम को ये कलिमात कहे वह भी यह दर्जा पाएगा))।"
"1203","[AI-translation] ((जो रात या दिन में सूरत-ए-हश्र की आख़िरी आयतें पढ़े, फिर उसी रात या दिन मर जाए, उसके लिए जन्नत वाजिब हो गई))।"
"1204","[AI-translation] ((अल्लाह तआला का इस्म-ए-आज़म सूरत-ए-हश्र की आख़िरी छह आयतों में है))।"
"1205","[AI-translation] ((जब अपने बिस्तर पर लेटो तो सूरत हश्र पढ़ो। [फिर] अगर मर जाओ तो शहीद की मौत मरोगे))।"
"1206","[AI-translation] ((अपनी औरतों को सूरत-ए-वाक़िआ सिखाओ; बेशक वह दौलत और ख़ुशहाली की सूरत है))।"
"1207","[AI-translation] ((जो सूरत वाक़िआ पढ़े और सीखे वह ग़ाफ़िलों में न लिखा जाएगा, और उसका घर मुहताज न होगा))।"
"1208","[AI-translation] ((जो हर रात सूरत-ए-वाक़िआ पढ़े उसे कभी फ़क़्र न होगा))।"
"1209","[AI-translation] ((सूरत «اذا زلزلت» आधे क़ुरआन के बराबर है))।"
"1210","[AI-translation] ((जो फ़ज्र की नमाज़ में सूरत «الم نشرح» और सूरत «الم تركيف» पढ़े वह हलाक न होगा))।"
"1211","[AI-translation] ((वुज़ू के बाद सूरत «انا انزلناه» पढ़ना))।"
"1212","[AI-translation] ((जो वुज़ू के बाद एक बार सूरत «انا انزلناه فى ليلة القدر» पढ़े वह सादिक़ीन में होगा। जो दो बार पढ़े वह शुहदा में लिखा जाएगा, और जो तीन बार पढ़े, अल्लाह तआला उसे अम्बिया के साथ उठाएगा))।"
"1213","[AI-translation] ((जो आख़िरी बीमारी में सूरत इख़लास पढ़े वह क़ब्र में आज़माया न जाएगा))।"
"1214","[AI-translation] ((जो बीस बार सूरत इख़लास पढ़े, अल्लाह तआला उसके लिए जन्नत में महल बनाएगा))।"
"1215","[AI-translation] ((जो दो सौ बार सूरत इख़लास पढ़े, अल्लाह तआला उसके दो सौ साल के गुनाह बख़्श देगा))।"
"1216","[AI-translation] ((जो दिन में दो सौ बार सूरत इख़लास पढ़े, अल्लाह तआला उसके लिए पन्द्रह सौ नेकियाँ लिखता है, जब तक वह क़र्ज़दार न हो))।"
"1217","[AI-translation] ((जो क़ब्रों के पास से गुज़रे और ग्यारह बार सूरत इख़लास पढ़े, फिर उसका सवाब मुर्दों को बख़्शे, उसे मुर्दों की तादाद के बराबर सवाब मिलेगा))।"
"1218","[AI-translation] ((जो जुमा की नमाज़ के बाद सात बार सूरत-ए-इख़लास, सूरत-ए-फ़लक़ और सूरत-ए-नास पढ़े, अल्लाह तआला अगले जुमा तक उसे बुराई से महफ़ूज़ रखेगा))।"
"1219","[AI-translation] ((क़ियामत के दिन हर रिश्ता और नसब कट जाएगा सिवाय मेरे रिश्ते और नसब के))।"
"1220","[AI-translation] ((जिब्रील (अलैहिस्सलाम) मेरे पास उतरे और कहा कि अल्लाह तआला आपको सलाम कहता है और फ़रमाता है: मैंने आग को उन सुल्ब [अब्दुल्लाह] पर हराम किया जिससे तू निकला, उस रहम [आमिना] पर जिसने तुझे उठाया, और उस गोद [अब्दुल-मुत्तलिब] पर जिसने तेरी परवरिश की))।"
"1221","[AI-translation] ((जिब्रील (अलैहिस्सलाम) मेरे पास उतरे और कहा: ऐ मुहम्मद! अल्लाह तआला आपको सलाम कहता है और फ़रमाता है: ऐ मेरे महबूब! मैंने यूसुफ़ (अलैहिस्सलाम) को अपने अर्श के पाए के नूर से जमाल से नवाज़ा, और तेरे चेहरे को अपने अर्श के नूर से जमाल से नवाज़ा))।"
"1222","[AI-translation] ((जिब्रील (अलैहिस्सलाम) नबी (सल्लल्लाहु अलैहि वसल्लम) के पास अंगूर का ख़ोशा लेकर आए और कहा: अल्लाह तआला आपको सलाम कहता है और मुझे इस ख़ोशे के साथ भेजा है ताकि तू इसे खाए))।"
"1223","[AI-translation] ((मेरी शफ़ाअत इन लोगों के लिए क़ुबूल हुई: मेरे वालिद, मेरे चचा अबू तालिब, और मेरे रज़ाई भाई इब्ने सादिय्या))।"
"1224","[AI-translation] ((अल्लाह तआला ने मूसा (अलैहिस्सलाम) को कलाम का तोहफ़ा दिया, लेकिन मुझे दीदार [यानी अपनी रुएत] अता किया, और मुझे मक़ाम-ए-महमूद और हौज़-ए-मवरूद से नवाज़ा))।"
"1225","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने एक आदमी को बाज़ुओं का पसीना दिया, और उसने उसे शीशी में डाला यहाँ तक कि भर गई। फिर वह उसे इत्र की तरह इस्तेमाल करता, और मदीना वाले उससे अच्छी ख़ुशबू पाते))।"
"1226","[AI-translation] ((जब यह आयत «اذا جاء نصرالله والفتح» उतरी तो मुहम्मद (सल्लल्लाहु अलैहि वसल्लम) ने कहा: ऐ जिब्रील! मुझे मेरी रूह की मौत की ख़बर दी गई है))।"
"1227","[AI-translation] (([ऐ नबी!] जो दिन-रात में तुझ पर सौ बार दुरूद भेजे, मैं उस पर दो हज़ार बार रहमत भेजूँगा, और उसकी हज़ार हाजतें पूरी होंगी))।"
"1228","[AI-translation] ((जो मेरी क़ब्र पर मुझ पर दुरूद भेजे, मैं उसे सुनता हूँ))।"
"1229","[AI-translation] ((मैं पैदाइश के लिहाज़ से पहला नबी हूँ और भेजे जाने के लिहाज़ से आख़िरी))।"
"1230","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) वफ़ात न पाए यहाँ तक कि पढ़ना-लिखना सीख लिया))।"
"1231","[AI-translation] ((क़ुरआन में मेरा नाम मुहम्मद है, इंजील में अहमद है, और तौरात में आहिद है))।"
"1232","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने वफ़ात से दो महीने पहले तसर्रुफ़ से मना किया))।"
"1233","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) वफ़ात से दो महीने पहले इबादत के लिए गोशानशीन हुए और औरतों से भी अलग हुए))।"
"1234","[AI-translation] ((पहचान मेरी हक़ीक़ी दौलत है, अक़्ल मेरे दीन की बुनियाद है, और नसब मेरी असल है))।"
"1235","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) की शहादत की उँगली [यानी बीच वाली के पास की] बीच वाली उँगली से लम्बी थी))।"
"1236","[AI-translation] ((मैं आदिल बादशाह [यानी नौशेरवाँ] के दौर में पैदा हुआ))।"
"1237","[AI-translation] ((मुझे सवार के प्याले जैसा न बनाओ [यानी मेरा ज़िक्र करने में देर न करो, क्योंकि सवार अपना प्याला सवारी की पीठ पर लटकाता है। अल-निहाया]))।"
"1238","[AI-translation] ((अगर बच्चे का नाम मुहम्मद रखो तो उसकी इज़्ज़त और एहतराम करो [उसे ज़लील न करो]))।"
"1239","[AI-translation] ((आले-मुहम्मद नुबुव्वत का दरख़्त, रहमत का ख़ानदान और रिसालत का मक़ाम है))।"
"1240","[AI-translation] ((जो हम अहले-बैत से दुश्मनी रखे, अल्लाह तआला उसे यहूदी बनाकर उठाएगा, चाहे वह नमाज़-रोज़े का पाबन्द हो))।"
"1241","[AI-translation] ((हमारी जमाअत के लोग क़ियामत के दिन अपनी क़ब्रों से उठेंगे, अपने गुनाहों और ऐबों के बावजूद, चौदहवीं के चाँद जैसे चमकते चेहरों के साथ))।"
"1242","[AI-translation] ((अल्लाह का ग़ज़ब उस पर सख़्त है जिसने मेरा ख़ून बहाया और मेरे घरवालों को तकलीफ़ दी))।"
"1243","[AI-translation] ((अल्लाह तआला ने हर नबी की औलाद उसकी अपनी सुल्ब से पैदा की, लेकिन मेरी औलाद उसने अली की सुल्ब से पैदा की))।"
"1244","[AI-translation] ((अगर इब्राहीम ज़िन्दा रहते तो नबी होते))।"
"1245","[AI-translation] ((अल्लाह तआला तुमसे फ़रमाता है कि तुम अबू बक्र की बेटी [आइशा (रज़ियल्लाहु अन्हा)] से शादी करो))।"
"1246","[AI-translation] (([आइशा (रज़ियल्लाहु अन्हा) से रिवायत है कि] मैंने नबी-ए-मुहम्मद (सल्लल्लाहु अलैहि वसल्लम) से नातमाम बच्चा जना, तो आपने उसका नाम अब्दुल्लाह रखा और मुझे उम्मे-अब्दुल्लाह की कुन्नियत दी))।"
"1247","[AI-translation] ((ऐ आइशा! तू दूध से ज़्यादा अफ़ज़ल है))।"
"1248","[AI-translation] (([आइशा (रज़ियल्लाहु अन्हा) ने रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) से पूछा] मुझसे आपकी मुहब्बत कैसी है? नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: रस्सी की गाँठ जैसी))।"
"1249","[AI-translation] ((अपना आधा दीन हुमैरा [यानी आइशा (रज़ियल्लाहु अन्हा)] से हासिल करो))।"
"1250","[AI-translation] ((ऐ अली! अल्लाह तआला ने मुझे हुक्म दिया है कि अबू बक्र को बाप, उमर को मुशीर, उस्मान को पुश्त, और तुझे, ऐ अली!, मददगार बनाऊँ))।"
"1251","[AI-translation] ((क़ियामत के दिन अर्श के नीचे एक पुकारने वाला एलान करेगा: मुहम्मद के साथी कहाँ हैं? फिर अबू बक्र, उमर, उस्मान और अली (रज़ियल्लाहु अन्हुम) लाए जाएँगे))।"
"1252","[AI-translation] ((अबू बक्र मेरे वज़ीर हैं और मेरे बाद मेरी उम्मत के निगराँ; उमर मेरे महबूब हैं, मेरी तरफ़ से बोलने वाले; उस्मान मुझसे हैं; और अली मेरे भाई और मेरे झंडे के हामिल हैं))।"
"1253","[AI-translation] ((क़ियामत के दिन अल्लाह तआला सारी मख़लूक़ पर आम तौर पर तजल्ली फ़रमाएगा, और [ऐ अबू बक्र!] तुझ पर ख़ास तौर पर तजल्ली फ़रमाएगा))।"
"1254","[AI-translation] ((ऐ अबू बक्र! ख़ुश हो, क्योंकि जिसने तुझे नमाज़ के लिए वुज़ू कराया वह जिब्रील (अलैहिस्सलाम) थे))।"
"1255","[AI-translation] ((जब अल्लाह तआला ने रूहें पैदा कीं तो बाक़ी रूहों में से अबू बक्र (रज़ियल्लाहु अन्हु) की रूह चुनी, और उनकी मिट्टी जन्नत से ली गई))।"
"1256","[AI-translation] ((अल्लाह तआला ने अबू बक्र (रज़ियल्लाहु अन्हु) के लिए इल्लिय्यीन के आला मक़ाम में सफ़ेद याक़ूत का ख़ेमा बनाया है))।"
"1257","[AI-translation] ((जब अबू बक्र (रज़ियल्लाहु अन्हु) पैदा हुए तो अल्लाह तआला जन्नत-ए-अदन के क़रीब आया और फ़रमाया: मेरी इज़्ज़त और मेरे जलाल की क़सम, मैं तुझमें सिर्फ़ उसे दाख़िल करूँगा जो इस बच्चे से मुहब्बत करे))।"
"1258","[AI-translation] ((अल्लाह तआला ने अबू बक्र (रज़ियल्लाहु अन्हु) को दीन और वह्य पर मेरा जानशीन बनाया है, तो तुम उनकी इताअत करो))।"
"1259","[AI-translation] ((जिब्रील (अलैहिस्सलाम) ने नबी (सल्लल्लाहु अलैहि वसल्लम) से अबू बक्र (रज़ियल्लाहु अन्हु) के बारे में कहा: ज़मीन पर उनकी शोहरत आसमानों से कम है))।"
"1260","[AI-translation] ((अबू बक्र (रज़ियल्लाहु अन्हु) जैसा कौन हो सकता है? क्योंकि जब लोगों ने मेरा इनकार किया तो उन्होंने मेरी तस्दीक़ की और मुझ पर ईमान लाए))।"
"1261","[AI-translation] ((क़ियामत के दिन अबू बक्र (रज़ियल्लाहु अन्हु) के लिए कुर्सी रखी जाएगी और वह उस पर बैठेंगे))।"
"1262","[AI-translation] ((मुझे आसमान की तरफ़ उठाया गया, और जब भी किसी आसमान से गुज़रा, मैंने अपना नाम मुहम्मद रसूलुल्लाह और उसके पीछे अबू बक्र सिद्दीक़ का नाम लिखा पाया))।"
"1263","[AI-translation] ((किसी क़ौम के लिए जायज़ नहीं कि अबू बक्र उनके दरमियान मौजूद हों और कोई और उनकी इमामत करे))।"
"1264","[AI-translation] ((अगर अबू बक्र (रज़ियल्लाहु अन्हु) के ईमान को ज़मीन के सब लोगों के ईमान से तौला जाए तो उनका ईमान भारी होगा))।"
"1265","[AI-translation] ((जो कुछ अल्लाह तआला ने मेरे सीने में रखा है, वही अबू बक्र के सीने में भी रखा है))।"
"1266","[AI-translation] ((उमर (रज़ियल्लाहु अन्हु) ने कहा कि नबी (सल्लल्लाहु अलैहि वसल्लम) अबू बक्र (रज़ियल्लाहु अन्हु) से बातें करते और मैं उनके दरमियान हबशी जैसा होता))।"
"1267","[AI-translation] ((अल्लाह तआला आसमानों में नापसन्द करता है कि अबू बक्र सिद्दीक़ से कोई ख़ता हो))।"
"1268","[AI-translation] ((अगर मैं तुम्हारे दरमियान न भेजा जाता तो उमर भेजे जाते))।"
"1269","[AI-translation] ((जब मुझे शबे-मेराज में ले जाया गया तो मैंने आसमानों में [ख़ूबसूरत परों वाला, सुर्ख़ याक़ूत के सिर वाला घोड़ा] देखा... मैंने जिब्रील (अलैहिस्सलाम) से पूछा: यह किसके लिए है? उन्होंने जवाब दिया: उन लोगों के लिए जो अबू बक्र और उमर (रज़ियल्लाहु अन्हुमा) से मुहब्बत करते हैं))।"
"1270","[AI-translation] ((इस उम्मत में सबसे पहले जिसे दाएँ हाथ में आमालनामा दिया जाएगा वह उमर (रज़ियल्लाहु अन्हु) होंगे))।"
"1271","[AI-translation] ((ऐ अबू-उल-हसन! [यानी अली (रज़ियल्लाहु अन्हु)] दोनों से [यानी अबू बक्र और उमर (रज़ियल्लाहु अन्हुमा) से] मुहब्बत करो। उन दोनों से तुम्हारी मुहब्बत की वजह से तुम जन्नत में दाख़िल होगे))।"
"1272","[AI-translation] ((इस दुनिया के आसमान में अस्सी हज़ार फ़रिश्ते हैं जो अबू बक्र और उमर (रज़ियल्लाहु अन्हुमा) से मुहब्बत करने वालों के लिए मग़फ़िरत माँगते हैं))।"
"1273","[AI-translation] ((जो उमर (रज़ियल्लाहु अन्हु) को बुरा कहे, उसका ठिकाना जहन्नम है))।"
"1274","[AI-translation] ((जो अबू बक्र और उमर (रज़ियल्लाहु अन्हुमा) को बुरा कहे उसे क़त्ल किया जाए, और उससे तौबा न माँगी जाए))।"
"1275","[AI-translation] ((शबे-मेराज में मैंने अर्श पर एक हरी शाख़ देखी जिस पर सफ़ेद नूर से लिखा था: अल्लाह के सिवा कोई माबूद नहीं, मुहम्मद अल्लाह के रसूल हैं, अबू बक्र सिद्दीक़ हैं और उमर फ़ारूक़ हैं))।"
"1276","[AI-translation] (([शबे-मेराज में नबी (सल्लल्लाहु अलैहि वसल्लम) ने एक हूर से पूछा:] तू किसके लिए है? उसने जवाब दिया: उस्मान इब्ने अफ़्फ़ान के लिए, जो शहादत पाएँगे))।"
"1277","[AI-translation] (([नबी (सल्लल्लाहु अलैहि वसल्लम) ने एक आदमी की नमाज़-ए-जनाज़ा नहीं पढ़ाई, तो जब सहाबा ने वजह पूछी तो आपने वज़ाहत की:] यह शख़्स उस्मान (रज़ियल्लाहु अन्हु) से बुग़्ज़ रखता था, तो अल्लाह भी उससे बुग़्ज़ रखता है))।"
"1278","[AI-translation] ((जब उस्मान (रज़ियल्लाहु अन्हु) एक जगह से दूसरी जगह जाते हैं तो जन्नत उनके लिए चमकती है))।"
"1279","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) खड़े हुए, उस्मान (रज़ियल्लाहु अन्हु) को मज़बूती से पकड़ा, फिर फ़रमाया: तू दुनिया और आख़िरत में मेरा दोस्त है))।"
"1280","[AI-translation] ((हर नबी का अपनी उम्मत में एक जिगरी दोस्त [ख़लील] है, और मेरा जिगरी दोस्त उस्मान (रज़ियल्लाहु अन्हु) है))।"
"1281","[AI-translation] ((जन्नत के दरख़्तों के हर पत्ते पर [मेरे नाम के साथ] 'उस्मान ज़ू-उन-नूरैन' लिखा है))।"
"1282","[AI-translation] ((मैं, हारून इब्ने इमरान, यह्या इब्ने ज़करिय्या और अली इब्ने अबी तालिब सब एक ही मिट्टी से पैदा किए गए))।"
"1283","[AI-translation] ((मैं और अली एक ही नूर से पैदा किए गए))।"
"1284","[AI-translation] ((अली (रज़ियल्लाहु अन्हु) ने कहा: मैं अल्लाह का बन्दा, रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) का भाई, और सबसे बड़ा सच्चा [सिद्दीक़-ए-अकबर] हूँ))।"
"1285","[AI-translation] (([ऐ अली!] तू सबसे पहला शख़्स है जो मुझ पर ईमान लाया, और तू सबसे पहला शख़्स होगा जो क़ियामत के दिन मुझसे मुसाफ़हा करेगा, और तू यक़ीनन सिद्दीक़-ए-अकबर और फ़ारूक़ है))।"
"1286","[AI-translation] ((अगर वे उनकी [यानी अली (रज़ियल्लाहु अन्हु) की] इताअत करें तो सब जन्नत में दाख़िल होंगे))।"
"1287","[AI-translation] ((मेरा भाई, मेरा वज़ीर, मेरे घरवालों में मेरा जानशीन, और सबसे बेहतर जिसे मैं अपने क़र्ज़ों की अदायगी और वादों की तकमील के लिए अपने बाद छोड़ूँ वह अली है))।"
"1288","[AI-translation] ((तुममें सबसे पहले मेरे पास हौज़ पर आने वाला और तुममें सबसे पहले इस्लाम क़ुबूल करने वाला अली इब्ने अबी तालिब है))।"
"1289","[AI-translation] ((जो अली को लोगों में सबसे बेहतर न समझे उसने यक़ीनन कुफ़्र किया))।"
"1290","[AI-translation] ((अली मख़लूक़ में सबसे बेहतर हैं))।"
"1291","[AI-translation] ((मैं हिकमत का घर हूँ और अली उसका दरवाज़ा है))।"
"1292","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) पर वह्य उतर रही थी और आपका सिर [सल्लल्लाहु अलैहि वसल्लम] अली (रज़ियल्लाहु अन्हु) की गोद में था। उन्होंने [अली ने] अस्र की नमाज़ नहीं पढ़ी थी यहाँ तक कि सूरज डूब गया। नबी (सल्लल्लाहु अलैहि वसल्लम) ने उनसे पूछा: क्या तूने नमाज़ पढ़ी? उन्होंने इनकार में जवाब दिया। इस पर नबी (सल्लल्लाहु अलैहि वसल्लम) ने अल्लाह से दुआ की, तो डूबने के बाद सूरज अली (रज़ियल्लाहु अन्हु) के लिए फिर निकाल दिया गया))।"
"1293","[AI-translation] (([ऐ अली!] मेरे नज़दीक तेरा मक़ाम ऐसा है जैसा मूसा के नज़दीक हारून का था))।"
"1294","[AI-translation] ((अली को देखना भी इबादत है))।"
"1295","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने हुक्म दिया कि अली (रज़ियल्लाहु अन्हु) के दरवाज़े के सिवा मस्जिद की तरफ़ खुलने वाले सब दरवाज़े बन्द कर दिए जाएँ))।"
"1296","[AI-translation] ((ऐ अली! मेरे और तेरे सिवा किसी के लिए इस मस्जिद में नापाकी की हालत में रहना जायज़ नहीं))।"
"1297","[AI-translation] ((अली की मुहब्बत गुनाहों को ऐसे खा जाती है जैसे आग लकड़ी को खा जाती है))।"
"1298","[AI-translation] ((जो आदम का इल्म, नूह की समझ, इब्राहीम का हिल्म, यह्या इब्ने ज़करिय्या का ज़ुहद और मूसा इब्ने इमरान की मज़बूती, अलैहिमुस्सलाम, देखना चाहे वह अली इब्ने अबी तालिब को देखे))।"
"1299","[AI-translation] ((क़ुरआन में मेरा नाम «والشمس وضحاها» है और अली का नाम «والقمر اذ تلاها» है))।"
"1300","[AI-translation] ((सबसे बेहतर जिसे मैं अपने बाद अपना जानशीन मुक़र्रर करूँ वह अली है))।"
"1301","[AI-translation] ((अली (रज़ियल्लाहु अन्हु) ने कहा: लोगों ने अबू बक्र (रज़ियल्लाहु अन्हु) की बैअत की, हालाँकि अल्लाह की क़सम, मैं उनसे ज़्यादा हक़दार था))।"
"1302","[AI-translation] ((इस दरवाज़े से दाख़िल होने वाला सबसे पहला शख़्स अमीर-उल-मोमिनीन और रसूलों का सरदार होगा। [अनस (रज़ियल्लाहु अन्हु) से रिवायत है कि] अचानक अली (रज़ियल्लाहु अन्हु) उससे दाख़िल हुए))।"
"1303","[AI-translation] ((जो मरे और उसके दिल में अली इब्ने अबी तालिब (रज़ियल्लाहु अन्हु) के लिए बुग़्ज़ हो, तो वह यहूदी या ईसाई होकर मरे))।"
"1304","[AI-translation] ((अल्लाह तआला अली (रज़ियल्लाहु अन्हु) से बुग़्ज़ की वजह से इस उम्मत से बारिश रोकता है))।"
"1305","[AI-translation] ((जो उस शाख़ को थामना चाहे जो अल्लाह तआला ने अपने हाथ से लगाई है, वह अली की मुहब्बत को मज़बूती से थामे))।"
"1306","[AI-translation] (([ऐ अल्लाह के रसूल!] क़ियामत के दिन आपका झंडा कौन उठाएगा? फ़रमाया: अली))।"
"1307","[AI-translation] ((ऐ अल्लाह! अली को ऐसी फ़ज़ीलत दे जो तूने न उससे पहले किसी को दी न उसके बाद किसी को देगा))।"
"1308","[AI-translation] ((अली (रज़ियल्लाहु अन्हु) के बारे में तीन सौ आयतें उतरीं))।"
"1309","[AI-translation] ((ऐ अली! अल्लाह तआला ने तुझे, तेरी औलाद को, तेरे वालिदैन को, तेरे घरवालों को, तेरे शिया [गिरोह] को और तेरे शिया से मुहब्बत करने वालों को बख़्श दिया))।"
"1310","[AI-translation] ((जो मुझसे मुहब्बत करे वह अली से मुहब्बत करे, और जो अली से दुश्मनी रखे उसने मुझसे दुश्मनी रखी))।"
"1311","[AI-translation] ((वह मरेगा नहीं सिवाय इसके कि शहीद होगा; इससे मुराद अली (रज़ियल्लाहु अन्हु) हैं))।"
"1312","[AI-translation] ((अली (रज़ियल्लाहु अन्हु) ने कहा: मैंने नबी (सल्लल्लाहु अलैहि वसल्लम) को ग़ुस्ल दिया, और वह पानी पिया जो आपकी आँखों के हल्क़ों से बहा, तो मुझे अव्वलीन-आख़िरीन के इल्म का वारिस बनाया गया))।"
"1313","[AI-translation] ((क़ियामत के दिन अल्लाह तआला मुझसे और अली से कहेगा: तुम दोनों से मुहब्बत करने वालों को जन्नत में दाख़िल करो, और तुम दोनों से बुग़्ज़ रखने वालों को जहन्नम में दाख़िल करो))।"
"1314","[AI-translation] ((ऐ अली! तू और तेरा शिया [तेरा गिरोह] जन्नत में होंगे))।"
"1315","[AI-translation] ((मेरी मिसाल दरख़्त जैसी है: मैं उसकी जड़ [असल] हूँ, और अली उसकी शाख़ [तना वग़ैरा] है))।"
"1316","[AI-translation] ((अल्लाह तआला ने नबी (सल्लल्लाहु अलैहि वसल्लम) को हुक्म दिया कि जन्नत की ताज़ा खजूरें उस थाल से खाएँ जो जिब्रील (अलैहिस्सलाम) उनके पास लाए, फिर ख़दीजा (रज़ियल्लाहु अन्हा) से सोहबत करें। [तो ऐसा किया], और ख़दीजा (रज़ियल्लाहु अन्हा) को फ़ातिमा (रज़ियल्लाहु अन्हा) का हमल हुआ))।"
"1317","[AI-translation] ((जब मुझे आसमानों की सैर कराई गई तो जिब्रील (अलैहिस्सलाम) ने मुझे जन्नत में दाख़िल किया और सेब दिया। मैंने खाया, और वह मेरी पीठ में नुतफ़ा बना। जब मैं उतरा तो ख़दीजा से सोहबत की, और फ़ातिमा उसी नुतफ़े से हैं))।"
"1318","[AI-translation] ((मैं, फ़ातिमा और अली जन्नत में सफ़ेद ख़ेमे में होंगे जिसकी छत रहमान का अर्श होगी))।"
"1319","[AI-translation] ((अल्लाह तआला ने मुझे फ़ातिमा का निकाह अली से करने का हुक्म दिया है, तो मैंने कर दिया))।"
"1320","[AI-translation] ((ऐ अली! अल्लाह तआला ने तेरा निकाह फ़ातिमा से किया है और उसका महर ज़मीन मुक़र्रर किया है; इसलिए जो तुझसे बुग़्ज़ रखते हुए उस पर चलेगा, वह उस पर नाजायज़ चलेगा))।"
"1321","[AI-translation] ((जब नबी-ए-मुहम्मद (सल्लल्लाहु अलैहि वसल्लम) ने फ़ातिमा का निकाह अली से किया तो ख़ुत्बा इस तरह दिया «الحمد لله المحمود بنعمته المعبود بقدرته . . . »))।"
"1322","[AI-translation] ((जिब्रील (अलैहिस्सलाम) ने आसमानों में ख़ुत्बा दिया और फ़ातिमा का निकाह अली से किया))।"
"1323","[AI-translation] ((जब फ़ातिमा (रज़ियल्लाहु अन्हा) को अली (रज़ियल्लाहु अन्हु) के पास भेजा गया तो जिब्रील (अलैहिस्सलाम) नबी (सल्लल्लाहु अलैहि वसल्लम) के सामने दाईं तरफ़ थे, मीकाईल (अलैहिस्सलाम) बाईं तरफ़ थे, और सत्तर हज़ार फ़रिश्ते उनके पीछे थे, सुबह तक अल्लाह तआला की तस्बीह और तक़दीस करते))।"
"1324","[AI-translation] ((मेरी बेटी फ़ातिमा इंसानी हूर है; उसे कभी हैज़ नहीं आया, और उसका नाम फ़ातिमा [बचाने वाली] है क्योंकि अल्लाह तआला ने उन्हें और उनसे मुहब्बत करने वालों को जहन्नम से आज़ाद किया है [यानी रिहा किया है]))।"
"1325","[AI-translation] ((फ़ातिमा (रज़ियल्लाहु अन्हा) ने अपनी इज़्ज़त की हिफ़ाज़त की; इसलिए अल्लाह ने उनके लिए और उनकी नस्ल के लिए जहन्नम की आग हराम की))।"
"1326","[AI-translation] (([मेरी बेटी फ़ातिमा अर्श के पाए को पकड़ेगी और कहेगी: ऐ आदिल-मुंसिफ़ रब! मेरे और मेरे बेटे के क़ातिल के दरमियान फ़ैसला कर]))।"
"1327","[AI-translation] ((क़ियामत के दिन पर्दों के पीछे से एक पुकारने वाला एलान करेगा: ऐ इस मजलिस वालो! अपनी निगाहें नीची रखो यहाँ तक कि फ़ातिमा बिन्ते मुहम्मद (सल्लल्लाहु अलैहि वसल्लम) गुज़र जाएँ))।"
"1328","[AI-translation] ((जिब्रील (अलैहिस्सलाम) मेरे पास आए और कहा कि अल्लाह तआला फ़ातिमा (रज़ियल्लाहु अन्हा) से मुहब्बत करता है))।"
"1329","[AI-translation] ((जो मुझसे मुहब्बत करे वह अली से मुहब्बत करे, और जो अली से मुहब्बत करे वह फ़ातिमा से मुहब्बत करे))।"
"1330","[AI-translation] (([क़ियामत के दिन] जन्नत कहेगी: ऐ रब! क्या तूने मुझसे वादा नहीं किया था कि तू मुझे अपने दो सुतूनों से ज़ीनत देगा? फिर अल्लाह तआला फ़रमाएगा: क्या मैंने तुझे हसन और हुसैन से ज़ीनत नहीं दी?))।"
"1331","[AI-translation] ((ऐ जिब्रील! मैंने [अपने बेटे] इब्राहीम को हुसैन के बदले फ़िदया दिया है))।"
"1332","[AI-translation] (([ऐ हुसैन!] अल्लाह तेरे क़ातिल पर लानत करे। जाबिर (रज़ियल्लाहु अन्हु) ने पूछा: उसे कौन क़त्ल करेगा? नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: मेरी अपनी उम्मत का एक शख़्स जो मेरी नस्ल से बुग़्ज़ रखेगा; उसे मेरी शफ़ाअत न मिलेगी))।"
"1333","[AI-translation] ((अब्बास इब्ने अब्दुल-मुत्तलिब मेरे वालिद, मेरे चचा, मेरे वसी और मेरे वारिस हैं))।"
"1334","[AI-translation] ((मेरे चचा अब्बास ने जाहिलिय्यत और इस्लाम दोनों में अपनी शर्मगाह पाक रखी; इसलिए अल्लाह तआला ने उनका जिस्म आग पर हराम किया))।"
"1335","[AI-translation] ((मैंने अब्दुर्रहमान इब्ने औफ़ (रज़ियल्लाहु अन्हु) को जन्नत में चूतड़ों के बल घिसटते दाख़िल होते देखा))।"
"1336","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने अली के हाथ से क़लम लिया और मुआविया को दे दिया))।"
"1337","[AI-translation] ((बनू-हाशिम के एक गिरोह ने रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) से दरख़्वास्त की कि मुआविया को वह्य लिखने से फ़ारिग़ करें, तो उनकी तैनाती के बारे में वह्य उतरी))।"
"1338","[AI-translation] ((इस उम्मत में रब के सामने सबसे पहले झगड़ने वाले अली और मुआविया (रज़ियल्लाहु अन्हुमा) होंगे))।"
"1339","[AI-translation] (([जिब्रील (अलैहिस्सलाम) ने नबी (सल्लल्लाहु अलैहि वसल्लम) से कहा कि अल्लाह तआला फ़रमाता है] ऐ मेरे महबूब! मैंने यह क़लम अपने अर्श के ऊपर से मुआविया के लिए तोहफ़े के तौर पर भेजा है))।"
"1340","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने मुआविया (रज़ियल्लाहु अन्हु) के बारे में जिब्रील (अलैहिस्सलाम) से मशवरा किया, तो उन्होंने कहा: उन्हें [वह्य] लिखवाओ, वह अमानतदार हैं))।"
"1341","[AI-translation] ((अल्लाह के नज़दीक तीन अमानतदार हैं: मैं, जिब्रील (अलैहिस्सलाम) और मुआविया (रज़ियल्लाहु अन्हु)))।"
"1342","[AI-translation] ((मुआविया (रज़ियल्लाहु अन्हु) को मेरे पास बुलाओ... बेशक वह मज़बूत और अमानतदार हैं))।"
"1343","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने मुआविया (रज़ियल्लाहु अन्हु) को नेज़ा दिया और फ़रमाया: इसे थामे रख यहाँ तक कि जन्नत में इसके साथ मुझसे मिले))।"
"1344","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने मुआविया (रज़ियल्लाहु अन्हु) को तीन रजिस्टर दिए और फ़रमाया: तू इनके साथ जन्नत में मुझसे मिलेगा))।"
"1345","[AI-translation] ((मुआविया (रज़ियल्लाहु अन्हु) क़ियामत के दिन उठाए जाएँगे और उन पर ईमान के नूर की चादर होगी))।"
"1346","[AI-translation] ((हर उम्मत का एक फ़िरऔन है, और इस उम्मत का फ़िरऔन मुआविया है))।"
"1347","[AI-translation] ((जब मुआविया को मेरे मिम्बर से ख़ुत्बा देते देखो तो उसे क़त्ल कर दो))।"
"1348","[AI-translation] ((मुआविया इब्ने अबी सुफ़ियान (रज़ियल्लाहु अन्हु) मेरी उम्मत में सबसे ज़्यादा बुर्दबार और सख़ी हैं))।"
"1349","[AI-translation] ((बेशक मेरी उम्मत के लिए जहन्नम की गर्मी हम्माम की गर्मी जैसी होगी))।"
"1350","[AI-translation] ((जन्नत सब उम्मतों पर हराम रहेगी यहाँ तक कि मैं और मेरी उम्मत उसमें दाख़िल हों))।"
"1351","[AI-translation] ((मेरी उम्मत बाबरकत उम्मत है; आख़िरत में उसके लिए कोई अज़ाब नहीं [बल्कि] उन्हें सिर्फ़ इस दुनिया में ज़लज़लों और फ़ितनों [वग़ैरा] की सूरत में सज़ा दी जाती है))।"
"1352","[AI-translation] ((अरबों से तीन वजहों से मुहब्बत करो: मैं अरबी हूँ, क़ुरआन अरबी में है, और जन्नत वालों की ज़बान अरबी है))।"
"1353","[AI-translation] ((बेहतरीन लोग अरब हैं, अरबों में बेहतरीन क़ुरैश हैं, और क़ुरैश में बेहतरीन बनू-हाशिम हैं))।"
"1354","[AI-translation] ((आसमानों-ज़मीन में अल्लाह के लश्कर हैं; अल्लाह के आसमानी लश्कर फ़रिश्ते हैं, जबकि ज़मीन पर लश्कर ख़ुरासान वाले हैं))।"
"1355","[AI-translation] ((अल्लाह के नज़दीक बदतरीन बोली फ़ारसी है))।"
"1356","[AI-translation] ((जब अल्लाह तआला राज़ी होता है तो अरबी में वह्य करता है, और जब नाराज़ होता है तो फ़ारसी में वह्य करता है))।"
"1357","[AI-translation] ((तुममें जो अच्छी अरबी बोल सकता हो वह कभी फ़ारसी न बोले, क्योंकि फ़ारसी निफ़ाक़ की तरफ़ ले जाती है))।"
"1358","[AI-translation] ((ग़ैर-अरबों के रिवाज मिटाओ और अरबों के रिवाज ज़िन्दा करो))।"
"1359","[AI-translation] ((जो हबशी को अपने घर दाख़िल होने दे, अल्लाह तआला उसके घर में बरकतें लाएगा))।"
"1360","[AI-translation] ((जब हबशी सेर हो तो ज़िना करता है, और जब भूखा हो तो चोरी करता है))।"
"1361","[AI-translation] ((यहूदियों और हिन्दुओं से बचो, चाहे सत्तर पेटों से हो))।"
"1362","[AI-translation] ((अल्लाह के कुछ फ़रिश्ते हैं जो मुर्दे को मुन्तक़िल करते हैं))।"
"1363","[AI-translation] ((अल्लाह का एक फ़रिश्ता है जिसकी दोनों आँखों के कोनों के दरमियान पाँच सौ साल का सफ़र है))।"
"1364","[AI-translation] ((अल्लाह का एक फ़रिश्ता है जिसका ऊपरी आधा बर्फ़ का है और निचला आधा आग का है))।"
"1365","[AI-translation] ((आसमान वालों का मुअज़्ज़िन जिब्रील (अलैहिस्सलाम) है, और उनका इमाम मीकाईल (अलैहिस्सलाम) है))।"
"1366","[AI-translation] ((तहबन्द ऐसे बाँधो जैसे मैंने फ़रिश्तों को अपने रब के सामने बाँधते देखा, आधी पिंडली तक))।"
"1367","[AI-translation] ((अपनी दाढ़ियों में ख़िज़ाब लगाओ, क्योंकि फ़रिश्ते मोमिन के ख़िज़ाब से ख़ुश होते हैं))।"
"1368","[AI-translation] ((जब तुममें से कोई अपनी बीवी के पास [सोहबत के लिए] जाए तो पर्दा करे, क्योंकि अगर पर्दा न करे तो फ़रिश्ते हया से चले जाते हैं और शैतान हाज़िर होता है। फिर अगर उनके लिए बच्चा मुक़द्दर हो तो शैतान का उसमें हिस्सा होगा))।"
"1369","[AI-translation] ((जब अल्लाह तआला किसी बन्दे से मुहब्बत करता है तो फ़रिश्तों के दिलों में भी उसकी मुहब्बत डालता है))।"
"1370","[AI-translation] ((जब तुममें से कोई छींके और 'अलहम्दुलिल्लाह' कहे तो फ़रिश्ते कहते हैं 'रब्ब-उल-आलमीन'। और अगर वह 'रब्ब-उल-आलमीन' भी कहे तो फ़रिश्ते कहते हैं 'अल्लाह तुझ पर रहम करे'))।"
"1371","[AI-translation] ((जुमा के दिन शैतान सुबह बाज़ारों की तरफ़ जाते हैं, लोगों पर धोखे और मक्कारी के जाल डालते हैं और उन्हें जुमा की नमाज़ से रोकते हैं। और फ़रिश्ते आते हैं और सुबह मस्जिदों के दरवाज़ों पर बैठते हैं [और जुमा की नमाज़ वालों के नाम लिखते हैं]))।"
"1372","[AI-translation] ((जब कोई मरता है तो फ़रिश्ते कहते हैं: उसने आगे क्या भेजा? और लोग कहते हैं: उसने पीछे क्या छोड़ा?))।"
"1373","[AI-translation] ((जो कसरत से दुआ करे, फ़रिश्ते कहते हैं: आवाज़ पहचानी गई, दुआ क़ुबूल हुई, और हाजत पूरी हुई))।"
"1374","[AI-translation] ((इमाम सोच-समझकर चुनो; जो तुम्हारी इमामत करे वह तुममें सबसे बेहतर हो। बेशक अल्लाह फ़रिश्तों और इंसानों में से रसूल भी चुनता है))।"
"1375","[AI-translation] ((पहरे [यानी निगरानी] की बेहतरीन सूरत नमाज़ और ज़िक्र की मजलिसों से चिमटना है, और जो नमाज़ के बाद जाए-नमाज़ पर बैठा रहे, जब तक वुज़ू न टूटे या खड़ा न हो, फ़रिश्ते उसके लिए रहमत की दुआ करते रहते हैं))।"
"1376","[AI-translation] ((आदम (अलैहिस्सलाम) के लिए बग़ली क़ब्र बनाई गई, और उन्हें ताक़ अदद में पानी से नहलाया गया। तो फ़रिश्तों ने कहा: यह उनके बाद बनी-आदम के लिए सुन्नत है))।"
"1377","[AI-translation] ((फ़रिश्तों ने आदम (अलैहिस्सलाम) को पानी और बेरी के पत्तों से नहलाया, कफ़न दिया, उनके लिए बग़ली क़ब्र बनाई, और कहा: ऐ बनी-आदम! यह अपने मुर्दों के बारे में तुम्हारी सुन्नत है))।"
"1378","[AI-translation] ((जब कोई रोज़ेदार के सामने खाए तो फ़रिश्ते उसके लिए रहमत की दुआ करते हैं))।"
"1379","[AI-translation] ((ऐ बिलाल! जब रोज़ेदार के सामने खाया जाए तो उसकी हड्डियाँ तस्बीह करती हैं और फ़रिश्ते उसके लिए मग़फ़िरत माँगते हैं))।"
"1380","[AI-translation] ((अल्लाह तआला इबादतगुज़ार नौजवान पर फ़रिश्तों के सामने फ़ख़्र करता है और फ़रमाता है: मेरे बन्दे को देखो; उसने मेरी ख़ातिर अपनी ख़्वाहिशें छोड़ दीं))।"
"1381","[AI-translation] ((फ़रिश्ते हाजियों में सवारों से मुसाफ़हा करते हैं और पैदल चलने वालों से गले मिलते हैं))।"
"1382","[AI-translation] ((जब सर्दी का मौसम जाता है तो फ़रिश्ते ख़ुश होते हैं, गर्मी की शिद्दत की वजह से ग़रीब मुसलमानों पर रहम करते हैं))।"
"1383","[AI-translation] ((जब तक तुम्हारा दस्तरख़्वान बिछा रहे, फ़रिश्ते तुम्हारे लिए रहमत की दुआ करते रहते हैं))।"
"1384","[AI-translation] ((फ़रिश्ते उन लोगों पर नहीं उतरते जिनमें कोई सिला-रहमी तोड़ने वाला हो))।"
"1385","[AI-translation] ((क़ियामत के दिन लोग तीन गिरोहों की सूरत में उठाए जाएँगे [उनमें से एक] वह गिरोह है जिसे फ़रिश्ते मुँह के बल घसीटेंगे))।"
"1386","[AI-translation] ((हम [जन्नत में] एक बाज़ार में आएँगे जहाँ फ़रिश्ते सफ़ों में खड़े होंगे; किसी आँख ने ऐसा बाज़ार कभी न देखा होगा, न कानों ने सुना होगा, न दिलों ने सोचा होगा))।"
"1387","[AI-translation] ((मैंने फ़रिश्तों को हंज़ला इब्ने अबी आमिर को आसमान-ज़मीन के दरमियान चाँदी के बर्तन में बादलों के पानी से नहलाते देखा))।"
"1388","[AI-translation] ((मैंने फ़रिश्तों को हमज़ा को नहलाते देखा))।"
"1389","[AI-translation] ((जो मेरे बाद मेरी उम्मत के मामलात का निगराँ बनेगा उसे क़ियामत के दिन पुल-सिरात पर खड़ा किया जाएगा, और फ़रिश्ते उसका आमालनामा खोलेंगे। अगर वह आदिल हो तो अल्लाह तआला उसे उसके अद्ल की वजह से नजात देगा))।"
"1390","[AI-translation] ((फ़रिश्तों का तोहफ़ा मस्जिदों को ख़ुशबूदार रखना है))।"
"1391","[AI-translation] ((तीन आवाज़ों से अल्लाह फ़रिश्तों के सामने फ़ख़्र करता है: अज़ान, अल्लाह के रास्ते में तकबीर, और तलबिया की बुलन्द आवाज़ से तिलावत))।"
"1392","[AI-translation] ((हूरें फ़रिश्तों की तस्बीह से पैदा की गई हैं))।"
"1393","[AI-translation] ((मैंने देखा कि ज़्यादातर फ़रिश्ते जिन्हें मैंने देखा अमामे पहने थे))।"
"1394","[AI-translation] ((मैंने अपने रब से माँगा कि मेरी उम्मत पर दुहा की नमाज़ फ़र्ज़ करे, लेकिन उसने जवाब दिया: यह फ़रिश्तों की नमाज़ है; जो चाहे पढ़े, और जो चाहे छोड़े))।"
"1395","[AI-translation] (([अपने बच्चों के] अम्बिया के नामों पर नाम रखो, लेकिन फ़रिश्तों के नामों पर नाम न रखो))।"
"1396","[AI-translation] ((दज्जाल के ज़माने में मोमिनों का खाना फ़रिश्तों के खाने जैसा होगा, और वह तस्बीह [पाकी बयान] और तक़दीस [पाकीज़गी बयान] है))।"
"1397","[AI-translation] (([अल्लाह तआला फ़रमाता है] जब मेरा बन्दा सत्तर साल का हो जाए तो फ़रिश्ते उससे मुहब्बत करने लगते हैं, और जब नब्बे साल का हो जाए तो फ़रिश्ते कहते हैं: यह ज़मीन पर अल्लाह का क़ैदी है। फिर अल्लाह तआला उसके अगले-पिछले सब गुनाह बख़्श देता है और उसके घरवालों के बारे में उसकी शफ़ाअत भी क़ुबूल करता है))।"
"1398","[AI-translation] ((बद्र की जंग के दिन फ़रिश्तों की निशानी काले अमामे थे, जबकि उहुद की जंग के दिन सुर्ख़ अमामे थे))।"
"1399","[AI-translation] ((नमाज़ की तीन ख़स्लतें हैं [उनमें से एक यह है कि] फ़रिश्ते उसे उसके पैरों से आसमान तक घेरे होते हैं))।"
"1400","[AI-translation] ((फ़रिश्ते तुम्हारे साथ सिर्फ़ दो खेलों में हाज़िर होते हैं: घुड़दौड़ और तीरअन्दाज़ी के मुक़ाबलों में))।"
"1401","[AI-translation] ((जिन घरों की तरफ़ शाम को बकरियों का रेवड़ लौटे, फ़रिश्ते सुबह तक उनके लिए रहमत की दुआ करते रहते हैं))।"
"1402","[AI-translation] ((जो ऐबदार चीज़ बेचे और उसका ऐब ज़ाहिर न करे, वह लगातार अल्लाह के ग़ज़ब में रहता है, और फ़रिश्ते लगातार उस पर लानत करते हैं))।"
"1403","[AI-translation] ((जो दिन के शुरू में क़ुरआन का ख़त्म करे, फ़रिश्ते शाम तक उसके लिए रहमत की दुआ करते हैं; और जो दिन के आख़िर में ख़त्म करे, फ़रिश्ते सुबह तक उसके लिए रहमत की दुआ करते हैं))।"
"1404","[AI-translation] ((जो किसी को बग़ैर नाम लिए पुकारे, फ़रिश्ते उस पर लानत करते हैं))।"
"1405","[AI-translation] ((मोमिन अल्लाह के नज़दीक कुछ फ़रिश्तों से ज़्यादा इज़्ज़त वाला है))।"
"1406","[AI-translation] ((जिस घर में घंटी हो उसमें फ़रिश्ते दाख़िल नहीं होते))।"
"1407","[AI-translation] ((जो सुबह इल्म की तलाश में निकले, फ़रिश्ते उसके लिए रहमत की दुआ करते हैं और उसके रिज़्क़ में बरकतें रखी जाती हैं))।"
"1408","[AI-translation] ((ऐ अबू हुरैरा! लोगों को क़ुरआन सिखाओ और ख़ुद भी सीखो। फिर अगर तुम इस हाल में मरो तो फ़रिश्ते तुम्हारी क़ब्र की ज़ियारत करेंगे जैसे बैत-उल-अतीक़ [काबा] की ज़ियारत की जाती है))।"
"1409","[AI-translation] ((जो रमज़ान में हलाल कमाई से रोज़ेदार का रोज़ा खुलवाए, फ़रिश्ते रमज़ान की तमाम रातों में उसके लिए रहमत की दुआ करते हैं))।"
"1410","[AI-translation] ((मिसवाक के इस्तेमाल से चिमटे रहो; मिसवाक बेहतरीन चीज़ है... फ़रिश्ते मिसवाक वाले की तारीफ़ करते हैं। [मिसवाक इस्तेमाल करने से] रब राज़ी होता है और शैतान नाराज़ होता है))।"
"1411","[AI-translation] ((फ़रिश्ते नोहा करने वाली औरत के लिए रहमत की दुआ नहीं करते))।"
"1412","[AI-translation] ((ईद-उल-फ़ित्र की सुबह फ़रिश्ते रास्तों के किनारों पर खड़े होते हैं और पुकारते हैं: ऐ लोगो! सवाब और बदले के लिए निकलो। तुम्हारे रब ने तुम्हें रोज़े रखने का हुक्म दिया था, और तुमने रोज़े रखे; अब उसका सवाब लो। फिर जब लोग ईद की नमाज़ पढ़ लें तो आसमानों में एक पुकारने वाला एलान करता है: अपने घरों को हिदायत पाए लौटो; मैंने तुम्हें बख़्श दिया। आसमानों में इस दिन का नाम यौम-उल-जज़ा है))।"
"1413","[AI-translation] ((हज़रत हव्वा (अलैहस्सलाम) की औलाद में से कोई न बचता। जब वह हामिला हुईं तो इबलीस उनके गिर्द घूमा और कहा: उसका नाम अब्दुल-हारिस रखो। उन्होंने उसका नाम अब्दुल-हारिस रखा, और वह बच गया))।"
"1414","[AI-translation] ((तकब्बुर से बचो, क्योंकि तकब्बुर ने इबलीस को आदम (अलैहिस्सलाम) को सज्दा करने से इनकार पर उकसाया))।"
"1415","[AI-translation] ((जब अल्लाह के दुश्मन इबलीस को मालूम हुआ कि अल्लाह तआला ने मेरी दुआ क़ुबूल की और मेरी उम्मत को बख़्श दिया, तो वह अपने सिर पर मिट्टी डालने लगा))।"
"1416","[AI-translation] ((इबलीस के लिए सबसे ज़्यादा कमरतोड़ वह आलिम-ए-दीन है जो लोगों में निकले))।"
"1417","[AI-translation] ((लहसुन, प्याज़ और गन्दना [बदबूदार सब्ज़ी] शैतान की ख़ुशबू हैं))।"
"1418","[AI-translation] ((जब तुममें से कोई मस्जिद से निकले तो इबलीस का लश्कर उसकी तरफ़ मुतवज्जेह होता है और मक्खियों की तरह उसके गिर्द जमा होता है। इसलिए जब कोई मस्जिद से निकलने लगे तो वह इबलीस और उसके लश्करों से ज़रूर पनाह माँगे))।"
"1419","[AI-translation] ((कलिमा ला-इलाहा-इल्लल्लाह पढ़ो और कसरत से इस्तिग़फ़ार करो, क्योंकि इबलीस कहता है: मैंने लोगों को गुनाहों से हलाक किया, और लोगों ने मुझे कलिमा ला-इलाहा-इल्लल्लाह और इस्तिग़फ़ार से हलाक किया))।"
"1420","[AI-translation] ((जो अपने माल का अच्छा इंतिज़ाम करे, शैतान उसकी तरफ़ अपना सबसे मज़बूत और ताक़तवर साथी भेजता है))।"
"1421","[AI-translation] ((शायरी इबलीस का आला है))।"
"1422","[AI-translation] ((दुनिया से बचो और औरतों से बचो। बेशक शैतान बहुत चौकस और घात में है, और मुत्तक़ियों में उसके शिकार के लिए औरतों से बढ़कर कोई जाल नहीं))।"
"1423","[AI-translation] इबलीस ने अल्लाह तआला से कहा: ((ऐ मेरे रब! आदम [ज़मीन पर] उतारा गया, और मैं जानता हूँ कि जल्द उसे किताबें और रसूल दिए जाएँगे; तो उसकी किताबें और रसूल क्या हैं?)) अल्लाह तआला ने फ़रमाया: ((उसके रसूल फ़रिश्ते और उनमें से चुने हुए नबी हैं, और उसकी किताबें तौरात, इंजील, ज़बूर और फ़ुरक़ान हैं))। उसने कहा: ((और मेरी किताब क्या है?)) अल्लाह तआला ने फ़रमाया: ((तेरी किताब शाख़ों के पत्ते हैं, तेरा क़ुरआन शायरी है, तेरे रसूल काहिन हैं, तेरा खाना वह है जिस पर अल्लाह का नाम नहीं लिया गया, हर नशावर चीज़ तेरा शरबत है, तेरा सच झूठ है, तेरा घर हम्माम हैं, तेरी घात की जगहें औरतें हैं, तेरे मुअज़्ज़िन मूसिक़ी के आले हैं, और तेरी मस्जिद बाज़ार है))।"
"1424","[AI-translation] ((जहन्नम के लिबास सबसे पहले इबलीस को पहनाए जाएँगे))।"
"1425","[AI-translation] ((इबलीस सबसे पहले नोहा करने वाला था और सबसे पहले गाने वाला था))।"
"1433","[AI-translation] ((जब वुज़ू करो तो हाथ न झटको क्योंकि ये [छींटें] शैतान के पंखे हैं))।"
"1434","[AI-translation] ((औरतें शैतान का जाल हैं))।"
"1435","[AI-translation] ((जो सफ़ शैतान को सबसे ज़्यादा रोकती है वह पहली सफ़ है))।"
"1436","[AI-translation] ((बेहयाई और बदकारी शैतान से हैं; ये दोनों काम जहन्नम के क़रीब और जन्नत से दूर करते हैं))।"
"1437","[AI-translation] ((शैतान बहुत हस्सास और चाटने का शौक़ीन है, तो अपनी जानों पर उसके हमलों से बचो। जो रात गुज़ारे और उसके हाथ पर चर्बी की बू हो, फिर उसे कोई नुक़सान पहुँचे, तो वह सिर्फ़ अपने को मलामत करे))।"
"1438","[AI-translation] ((शैतान इंसानों के लिए भेड़िया है जैसे भेड़िया बकरियों के लिए है; वह उस बकरी को पकड़ता है जो रेवड़ से अलग हो। तो अलग होने से बचो, और जमाअत, आम जगहों और मस्जिद से चिमटे रहो))।"
"1439","[AI-translation] ((शैतान एक और दो मर्दों को तकलीफ़ देता है, लेकिन जब तीन मर्द हों तो वह उन्हें तकलीफ़ नहीं दे सकता))।"
"1440","[AI-translation] ((जब से उमर (रज़ियल्लाहु अन्हु) इस्लाम लाए, जब भी शैतान उनसे मिला, वह मुँह के बल गिरा))।"
"1441","[AI-translation] ((शैतान आदम के बेटे के दिल पर अपनी लगाम रखता है; अगर वह अल्लाह को याद करे तो शैतान हट जाता है, लेकिन अगर भूले तो शैतान उसका दिल निगल जाता है))।"
"1442","[AI-translation] ((शैतान सुर्ख़ रंग से मुहब्बत करता है, तो सुर्ख़ और शोहरत के हर लिबास से बचो))।"
"1443","[AI-translation] ((सुर्ख़ रंग से बचो, क्योंकि वह शैतान को सबसे महबूब ज़ीनत है))।"
