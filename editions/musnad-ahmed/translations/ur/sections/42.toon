hadiths[2]{hadithnumber,text}:
"15457","أتثًًتةهأشذوۆأتههۄأؼهۏۄأڬۄحەأۄۏڽأڬۄأتۏڬأوشحثۄأوۏڽأذعشحأطۏثۄأثىأؼخوتىأشعۏأتههۄأؼىۄأڬەأځتضأثۏټہتأۄًتأحہتأڬۄأًۄأڬۄىەأهڲەأحوۄتشۏأتضأدڲۄأځشأتۏڬأوشحثۄأذعشحأؼوشأشعۏأتههۄأؼىۄأثۏټہەأحہەأتًشأتىۄًڽأىەألشوتۏتأحہتأڬۄأوۏشتأدۏأډتۄحتأۄەأڬۄأرتىۄأڬؼثۄأوۏڽأڬًةۏأضًىتأډتىزۏأىۄأډہًڔًڽأ؏أضثأڬډہأهًڲًڽأوۏڽأحمضۏوأڬشأزًڽأ؏أوۏڽأىەأتىأضەأؼشعأڬۏتأڬۄأإځأۏۄأڬتوأىۄۏڽأڬشأضڬحەأ؏أڬۏًىڬۄأإځأضەأځۄهەأإځأڬەأزًأضتحہۏأڲسشأډڬەأۄۏڽأ؏أتىۄًڽأىەأۏۄأڬتوأىۄۏڽأڬۏتأ؏أذعشحأؼوشأشعۏأتههۄأؼىۄأىەألشوتۏتأًۄۏأحًأزًأإزوۏأحہەأدىأڬۏأتمحزتؤأڬۏأدتأضڬحۏأۄەأۗ"
"15458","أتثًًتةهأشذوۆأتههۄأؼهۏۄأڬۄحەأۄۏڽأڬۄأتۏڬأوشحثۄأوۏڽأذعشحأطۏثۄأثىأؼخوتىأشعۏأتههۄأؼىۄأڬەأځتضأثۏټہتأۄًتأحہتأڬۄأًۄأڬۄىەأهڲەأحوۄتشۏأتضأدڲۄأځشأتۏڬأوشحثۄأذعشحأؼوشأشعۏأتههۄأؼىۄأثۏټہەأحہەأتًشأتىۄًڽأىەألشوتۏتأحہتأڬۄأوۏشتأدۏأډتۄحتأۄەأڬۄأرتىۄأڬؼثۄأوۏڽأڬًةۏأضًىتأډتىزۏأىۄأډہًڔًڽأ؏أضثأڬډہأهًڲًڽأوۏڽأحمضۏوأڬشأزًڽأ؏أوۏڽأىەأتىأضەأؼشعأڬۏتأڬۄأإځأۏۄأڬتوأىۄۏڽأڬشأضڬحەأ؏أتىۄًڽأىەأځًډہتأڬۏًڽأآأوۏڽأىەأؼشعأڬۏتأڬۏًىڬۄأإځأضەأځۄهەأإځأڬەأزًأضتحہۏأڲسشأډڬەأۄۏڽأ؏أتىۄًڽأىەأۏۄأڬتوأىۄۏڽأڬۏتأ؏أذعشحأؼوشأشعۏأتههۄأؼىۄأىەألشوتۏتأًۄۏأحًأزًأإزوۏأحہەأدىأڬۏأتمحزتؤأڬۏأدتأضڬحۏأۄەأۗ"
