hadiths[22]{hadithnumber,text}:
"484","[AI-translation] ((ஸய்யிதுனா அபூ ஹுரைரா (ரழியல்லாஹு அன்ஹு) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — அவர்கள் கூறினார்கள்: ""உம்ரா (ஒருவருக்கு அவர் வாழ்நாளுக்கு ஒன்றை அன்பளிப்பது) அவர் வாரிசுகளுக்கு மரபு. அல்லது அவர் வாரிசுகளுக்கு அனுமதி.""))"
"485","[AI-translation] ((ஷுரைஹ் அறிவித்தார்கள்: அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) உம்ரா பற்றி அது அனுமதி என்று தீர்ப்பளித்தார்கள்.))"
"486","[AI-translation] ((ஸய்யிதுனா அபூ ஹுரைரா (ரழியல்லாஹு அன்ஹு) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — அவர்கள் கூறினார்கள்: ""உம்ரா அனுமதி.""))"
"487","[AI-translation] ((கதாதா (ரஹிமஹுல்லாஹ்) அறிவித்தார்கள் — ஹஸன் (ரஹிமஹுல்லாஹ்) கூறினார்கள்: கூறுவர்: 'உம்ரா அனுமதி.' ))"
"488","[AI-translation] ((இமாம் ஸுஹ்ரீ (ரஹிமஹுல்லாஹ்) கூறினார்கள்: உம்ரா ஒருவர்: ""இது அவருக்கு — அவருக்குப் பிறகு அவர் சந்ததிக்கு"" என்று கூறுவது. அது யாருக்கு நிபந்தனை விதிக்கிறாரோ அவருக்கே.))"
"489","[AI-translation] ((ஸய்யிதுனா ஜாபிர் பின் அப்துல்லாஹ் (ரழியல்லாஹு அன்ஹு) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — அவர்கள் கூறினார்கள்: ""உம்ரா அனுமதி.""))"
"490","[AI-translation] ((இமாம் ஸுஹ்ரீ (ரஹிமஹுல்லாஹ்) கூறினார்கள்: கலீஃபாக்கள் இவ்விஷயத்தைத் தீர்மானிப்பர். அதா (ரஹிமஹுல்லாஹ்) கூறினார்கள்: அப்துல் மலிக் பின் மர்வான் இவ்விஷயத்தைத் தீர்மானித்தார்கள்.))"
"491","[AI-translation] ((ஸய்யிதுனா ஜாபிர் பின் அப்துல்லாஹ் (ரழியல்லாஹு அன்ஹு) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — அவர்கள் கூறினார்கள்: ""உம்ரா அனுமதி.""))"
"492","[AI-translation] ((ஸய்யிதுனா அபூ ஹுரைரா (ரழியல்லாஹு அன்ஹு) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — அவர்கள் கூறினார்கள்: ""யாருக்குக் கேட்காமல் ஒன்று கொடுக்கப்பட்டு அதை ஏற்றால் அது அல்லாஹ் அவருக்கு அனுப்பிய உணவு.""))"
"493","[AI-translation] ((ஸய்யிதுனா அபூ ஹுரைரா (ரழியல்லாஹு அன்ஹு) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — அவர்கள் கூறினார்கள்: ""முன்னங்கால் அன்பளிக்கப்பட்டால் ஏற்பேன்; கால் விருந்துக்கு அழைக்கப்பட்டால் அந்த அழைப்பையும் ஏற்பேன்.""))"
"494","[AI-translation] ((அஃமஷ் (ரஹிமஹுல்லாஹ்) இதே சங்கிலியுடன் முந்தைய ஹதீஸ் போன்று அறிவித்தார்கள்.))"
"495","[AI-translation] ((ஸய்யிதுனா அபூ ஹுரைரா (ரழியல்லாஹு அன்ஹு) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — அவர்கள் கூறினார்கள்: ""முன்னங்கால் இறைச்சி அன்பளிக்கப்பட்டால் ஏற்பேன்."" ஜரீர் (ரஹிமஹுல்லாஹ்) அறிவித்தார்கள்: அவர்கள் (ஸல்லல்லாஹு அலைஹி வஸல்லம்): ""முன்னங்கால் இறைச்சிக்கு அழைக்கப்பட்டால் ஏற்பேன்"" என்று கூறியதாக நினைக்கிறேன்.))"
"496","[AI-translation] ((அபூ ஹுரைரா (ரழியல்லாஹு அன்ஹு) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — கூறினார்கள்: ""தன் அன்பளிப்பைத் திரும்பப் பெறுபவர் நிறையும் வரை உண்டு, பின்னர் வாந்தி எடுத்து, பின்னர் வாந்தியை உண்ணத் தொடங்கும் நாய் போன்றவர்.""))"
"497","[AI-translation] ((ஸய்யிதுனா அபூ ஹுரைரா (ரழியல்லாஹு அன்ஹு) அறிவித்தார்கள்: தம் வீடல்லாத வீட்டில் அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களுக்கு உணவு கொண்டுவரப்பட்டால் கேட்பார்கள்: ""இது அன்பளிப்பா தர்மமா?"" தர்மம் என்று கூறப்பட்டால் அதிலிருந்து உண்ணமாட்டார்கள் — தோழர்கள் உண்பர். அன்பளிப்பு என்று கூறப்பட்டால் அதிலிருந்து உண்பார்கள்.))"
"498","[AI-translation] ((ஸய்யிதுனா இப்னு அப்பாஸ் (ரழியல்லாஹு அன்ஹுமா) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — அவர்கள் கூறினார்கள்: ""தன் அன்பளிப்பைத் திரும்பப் பெறுபவர் வாந்தி எடுத்துப் பின்னர் அதை நக்கும் நாய் போன்றவர்.""))"
"499","[AI-translation] ((ஸய்யிதுனா இப்னு அப்பாஸ் (ரழியல்லாஹு அன்ஹுமா) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — அவர்கள் கூறினார்கள்: ""தன் அன்பளிப்பைத் திரும்பப் பெறுபவர் வாந்தி எடுத்துப் பின்னர் அதை நக்கும் நாய் போன்றவர்.""))"
"500","[AI-translation] ((ஸய்யிதுனா இப்னு அப்பாஸ் (ரழியல்லாஹு அன்ஹுமா) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) கூறியதாக அறிவித்தார்கள்: ""அன்பளிப்புக் கொடுத்துப் பின்னர் திரும்பப் பெறுவது யாருக்கும் ஹலால் அல்ல — மகனுக்குக் கொடுக்கும் தந்தையைத் தவிர. அன்பளிப்புக் கொடுத்துப் பின்னர் திரும்பப் பெறுபவரின் உதாரணம் வாந்தி எடுத்துப் பின்னர் அதை நக்கும் நாய் போன்றது.""))"
"501","[AI-translation] ((தாவூஸ் (ரஹிமஹுல்லாஹ்) அறிவித்தார்கள் — அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) கூறினார்கள்: ""அன்பளிப்புக் கொடுத்துப் பின்னர் திரும்பப் பெறுவது யாருக்கும் ஹலால் அல்ல — தந்தையைத் தவிர (மகனுக்குக் கொடுத்ததைத் திரும்பப் பெறலாம்).\"))"
"502","[AI-translation] ((அதா (ரஹிமஹுல்லாஹ்) அறிவித்தார்கள் — அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) கூறினார்கள்: ""தன் அன்பளிப்பைத் திரும்பப் பெறுபவர் தன் வாந்தியை நக்குபவர் போன்றவர்.""))"
"503","[AI-translation] ((ஸய்யிதுனா இப்னு அப்பாஸ் (ரழியல்லாஹு அன்ஹுமா) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — அவர்கள் கூறினார்கள்: ""உங்களில் ஒருவருக்கு அன்பளிப்புக் கொடுக்கப்பட்டு அவருடன் சிலர் இருந்தால் அவர்களும் அதில் பங்கு பெறுவர்.""))"
"504","[AI-translation] ((ஸய்யிதுனா இப்னு அப்பாஸ் (ரழியல்லாஹு அன்ஹுமா) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — கூறினார்கள்: ""எங்களுக்குக் கெட்ட உதாரணம் இல்லை (இந்த உதாரணத்தால் விவரிக்கப்படுபவர்களில் இருக்கமாட்டோம்); தன் அன்பளிப்பைத் திரும்பப் பெறுபவர் வாந்தி எடுத்துப் பின்னர் அதை நக்கும் நாய் போன்றவர்.""))"
"505","[AI-translation] ((ஸய்யிதுனா இப்னு அப்பாஸ் (ரழியல்லாஹு அன்ஹுமா) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து முந்தைய ஹதீஸ் போன்று அறிவித்தார்கள்.))"
