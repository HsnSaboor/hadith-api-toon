hadiths[75]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3197","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ عُيَيْنَةَ، عَنْ عَلِيِّ بْنِ مُسْهِرٍ، عَنْ أَشْعَثَ، عَنْ الشَّعْبِيِّ، عَنْ عَلِيٍّ، وَعُمَرَ، وَزَيْدٍ، قَالُوا: الْوَالِدُ يَجُرُّ وَلَاءَ وَلَدِهِ"".""","Da'if","Sunan al-Darimi 3197","","","55. حق ولاء اپنی طرف کھینچنے کا بیان"
"3198","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ عُيَيْنَةَ، عَنْ عَلِيِّ بْنِ مُسْهِرٍ، عَنْ أَشْعَثَ، عَنْ الشَّعْبِيِّ، قَالَ: الْجَدُّ يَجُرُّ الْوَلَاءَ"".""","Sahih","Sunan al-Darimi 3198","","","55. حق ولاء اپنی طرف کھینچنے کا بیان"
"3199","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ عُيَيْنَةَ، عَنْ عَلِيِّ بْنِ مُسْهِرٍ، عَنْ أَشْعَثَ، عَنْ ابْنِ سِيرِينَ، عَنْ شُرَيْحٍ، قَالَ: الْوَالِدُ يَجُرُّ وَلَاءَ وَلَدِهِ"".""","Da'if","Sunan al-Darimi 3199","","","55. حق ولاء اپنی طرف کھینچنے کا بیان"
"3200","(حديث مقطوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا زَكَرِيَّا، عَنْ عَامِرٍ:فِي مَمْلُوكٍ تُوُفِّيَ وَلَهُ أَبٌ حُرٌّ، وَلَهُ بَنُونَ مِنْ امْرَأَةٍ حُرَّةٍ، لِمَنْ وَلَاءُ وَلَدِهِ؟ قَالَ: لِمَوَالِي الْجَدِّ"".""","Sahih","Sunan al-Darimi 3200","","","55. حق ولاء اپنی طرف کھینچنے کا بیان"
"3201","(حديث مقطوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا إِسْرَائِيلُ، عَنْ مُغِيرَةَ، عَنْ إِبْرَاهِيمَ:فِي مُكَاتَبٍ مَاتَ وَقَدْ أَدَّى نِصْفَ مُكَاتَبَتِهِ، وَلَهُ وَلَدٌ مِنْ امْرَأَةٍ حُرَةٍ، قَالَ: مَا أُرَاهُ إِلَّا قَدْ جَرَّ وَلَاءَ وَلَدِهِ"".""","Sahih","Sunan al-Darimi 3201","","","55. حق ولاء اپنی طرف کھینچنے کا بیان"
"3202","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا شُعْبَةُ، عَنْ الْحَكَمِ، عَنْ إِبْرَاهِيمَ، قَالَ:كَانَ شُرَيْحٌ لَا يَرْجِعُ عَنْ قَضَاءٍ يَقْضِي بِهِ، فَحَدَّثَهُ الْأَسْوَدُ: أَنَّ عُمَرَ، قَالَ: إِذَا تَزَوَّجَ الْمَمْلُوكُ الْحُرَّةَ، فَوَلَدَتْ أَوْلَادًا أَحْرَارًا، ثُمَّ عُتِقَ بَعْدَ ذَلِكَ، رَجَعَ الْوَلَاءُ لِمَوَالِي أَبِيهِمْ""، فَأَخَذَ بِهِ شُرَيْحٌ.""","Sahih","Sunan al-Darimi 3202","","","55. حق ولاء اپنی طرف کھینچنے کا بیان"
"3203","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا يَعْلَى، عَنْ الْأَعْمَشِ، عَنْ إِبْرَاهِيمَ، قَالَ: قَالَ عُمَر:الْمَمْلُوكِ يَكُونُ تَحْتَهُ الْحُرَّةُ، يُعْتَقُ الْوَلَدُ بِعِتْقِ أُمِّهِ، فَإِذَا عُتِقَ الْأَبُ، جَرَّ الْوَلَاءَ"".""","","Sunan al-Darimi 3203","","","55. حق ولاء اپنی طرف کھینچنے کا بیان"
"3204","(حديث مقطوع) حَدَّثَنَا مُسْلِمٌ، حَدَّثَنَا عَبْدُ الْوَارِثِ، عَنْ كَثِيرِ بْنِ شِنْظِيرٍ، عَنْ عَطَاءٍ:فِي الْحُرَّةِ تَحْتَ الْعَبْدِ، قَالَ: أَمَّا مَا وَلَدَتْ مِنْهُ وَهُوَ عَبْدٌ، فَوَلَاؤُهُمْ لِأَهْلِ نِعْمَتِهَا، وَمَا وَلَدَتْ مِنْهُ وَهُوَ حُرٌّ، فَوَلَاؤُهُمْ لِأَهْلِ نِعْمَتِهِ"".""","Sahih","Sunan al-Darimi 3204","","","55. حق ولاء اپنی طرف کھینچنے کا بیان"
"3205","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، عَنْ الْأَعْمَشِ، عَنْ إِبْرَاهِيمَ، قَالَ: قَالَ عُمَرُ: إِذَا كَانَتْ الْحُرَّةُ تَحْتَ الْمَمْلُوكِ، فَوَلَدَتْ لَهُ غُلَامًا، فَإِنَّهُ يُعْتَقُ بِعِتْقِ أُمِّهِ، وَوَلَاؤُهُ لِمَوَالِي أُمِّهِ، فَإِذَا أُعْتِقَ الْأَبُ، جَرَّ الْوَلَاءَ إِلَى مَوَالِي أَبِيهِ"".""","","Sunan al-Darimi 3205","","","55. حق ولاء اپنی طرف کھینچنے کا بیان"
"3206","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا الْحَكَمُ بْنُ الْمُبَارَكِ، حَدَّثَنَا مُحَمَّدُ بْنُ سَلَمَةَ، عَنْ ابْنِ إِسْحَاق، عَنْ الْعَلَاءِ بْنِ عَبْدِ الرَّحْمَنِ، عَنْ أَبِيهِ، قَالَ: كَانَتْ أُمِّي مَوْلَاةً لِلْحُرَقَةِ، وَكَانَ أَبِي يَعْقُوبُ مُكَاتَبًا لِمَالِكِ بْنِ أَوْسِ بْنِ الْحَدَثَانِ النَّصْرِيِّ، ثُمَّ إِنَّ أَبِي أَدَّى كِتَابَتَهُ، فَدَخَلَ الْحُرَقِيُّ عَلَى عُثْمَانَ، يَسْأَلُ الْحَقَّ يَعْنِي: الْعَطَاءَ، وَعِنْدَهُ مَالِكُ بْنُ أَوْسٍ، فَقَالَ: ذَاكَ مَوْلَايَ، فَاخْتَصَمَا إِلَى عُثْمَانَ، فَقَضَى بِهِ لِلْحُرَقِيِّ"".""","","Sunan al-Darimi 3206","","","55. حق ولاء اپنی طرف کھینچنے کا بیان"
"3207","(حديث مقطوع) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يَزِيدَ، حَدَّثَنَا حَيْوَةُ، أَخْبَرَنِي سَهْمُ بْنُ يَزِيدَ الْحَمْرَاوِيُّ:أَنَّ رَجُلًا تُوُفِّيَ وَلَيْسَ لَهُ وَارِثٌ، فَكُتِبَ فِيهِ إِلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ وَهُوَ خَلِيفَةٌ، فَكَتَبَ: أَنْ اقْتَسِمُوا مِيرَاثَهُ عَلَى مَنْ كَانَ يَأْخُذُ مَعَهُمْ الْعَطَاءَ، فَقُسِمَ مِيرَاثُهُ عَلَى مَنْ كَانَ يَأْخُذُ مَعَهُمْ الْعَطَاءَ فِي عِرَافَتِهِ"".""","Sahih","Sunan al-Darimi 3207","","","56. جب کوئی آدمی مر جائے اس کے عصبہ بھی نہ ہوں تو وارث کون ہو گا؟"
"3208","(حديث مرفوع) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَيْدٍ، أَخْبَرَنَا عُبَيْدُ اللَّهِ، عَنْ نَافِعٍ، عَنْ ابْنِ عُمَرَ: أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: مَاحَقُّ امْرِئٍ مُسْلِمٍ يَبِيتُ لَيْلَتَيْنِ وَلَهُ شَيْءٌ يُوصِي فِيهِ، إِلَّا وَوَصِيَّتُهُ مَكْتُوبَةٌ عِنْدَهُ"".""","Sahih","Sunan al-Darimi 3208","","","1. وصیت کرنا مستحب ہے"
"3209","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا عَفَّانُ، حَدَّثَنَا أَبُو الْأَشْهَبِ، حَدَّثَنَا الْحَسَنُ، قَالَ: الْمُؤْمِنُ لَا يَأْكُلُ فِي كُلِّ بَطْنِهِ، وَلَا تَزَالُ وَصِيَّتُهُ تَحْتَ جَنْبِهِ"".""","Hasan","Sunan al-Darimi 3209","","","1. وصیت کرنا مستحب ہے"
"3210","(حديث مقطوع) أَخْبَرَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ دَاوُدَ بْنِ أَبِي هِنْدٍ، عَنْ الْقَاسِمِ بْنِ عُمَرَ، قَالَ:قَالَ لِي ثُمَامَةُ بْنُ حَزْنٍ: مَا فَعَلَ أَبُوكَ؟ قُلْتُ: مَاتَ، قَالَ: فَهَلْ أَوْصَى؟ فَإِنَّهُ كَانَ يُقَالُ: إِذَا أَوْصَى الرَّجُلُ، كَانَتْ وَصِيَّتُهُ تَمَامًا لِمَا ضَيَّعَ مِنْ زَكَاتِهِ"". قَالَ أَبُو مُحَمَّد، وقال غَيْرُهُ: الْقَاسِمُ بْنُ عَمْرٍو.""","Sahih","Sunan al-Darimi 3210","","","2. وصیت کی فضیلت کا بیان"
"3211","(حديث مقطوع) حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، حَدَّثَنَا دَاوُدُ بْنُ أَبِي هِنْدٍ، عَنْ الشَّعْبِيِّ، قَالَ: كَانَ يُقَالُ: مَنْ أَوْصَى بِوَصِيَّةٍ فَلَمْ يَجُرْ، وَلَمْ يَحِفْ، كَانَ لَهُ مِنْ الْأَجْرِ مِثْلُ مَا أَنْ لَوْ تَصَدَّقَ بِهِ فِي حَيَاتِهِ"".""","Sahih","Sunan al-Darimi 3211","","","2. وصیت کی فضیلت کا بیان"
"3212","(حديث مقطوع) أَخْبَرَنَا سَهْلُ بْنُ حَمَّادٍ، حَدَّثَنَا شُعْبَةُ، عَنْ أَبِي يُونُسَ، عَنْ قَزَعَةَ، قَالَ: قِيلَ لِهَرِمِ بْنِ حَيَّانَ: أَوْصِهْ، قَالَ: أُوصِيكُمْ بِالْآيَاتِ الْأَوَاخِرِ مِنْ سُورَةِ النَّحْلِ، وَقَرَأَ ابْنُ حَيَّانَ: ادْعُ إِلَى سَبِيلِ رَبِّكَ بِالْحِكْمَةِ إِلَى قَوْلِهِ: وَالَّذِينَ هُمْ مُحْسِنُونَ سورة النحل آية 125 - 128"".""","","Sunan al-Darimi 3212","","","2. وصیت کی فضیلت کا بیان"
"3213","(حديث مرفوع) حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، عَنْ مَالِكِ بْنِ مِغْوَلٍ، عَنْ طَلْحَةَ بْنِ مُصَرِّفٍ الْيَامِيِّ، قَالَ: سَأَلْتُ عَبْدَ اللَّهِ بْنَ أَبِي أَوْفَى: أَوْصَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ؟ قَالَ: لَا، قُلْت: فَكَيْفَ كُتِبَ عَلَى النَّاسِ الْوَصِيَّةُ أَوْ: أُمِرُوا بِالْوَصِيَّةِ؟ فَقَالَ: أَوْصَى بِكِتَابِ اللَّهِ. وقَالَ هُزَيْلُ بْنُ شُرَحْبِيلَ: أَبُو بَكْرٍ كَانَ يَتَأَمَّرُ عَلَى وَصِيِّ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَدَّ أَبُو بَكْرٍ أَنَّهُ وَجَدَ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَهْدًا، فَخَزَمَ أَنْفَهُ بِخِزَامَةٍ ذلِكَ.","Sahih","Sunan al-Darimi 3213","","","3. جو کوئی وصیت نہ کرے اس کا بیان"
"3214","(حديث مقطوع) أَخْبَرَنَا يَزِيدُ، أنبأنا هَمَّامٌ، عَنْ قَتَادَةَ:كُتِبَ عَلَيْكُمْ إِذَا حَضَرَ أَحَدَكُمُ الْمَوْتُ إِنْ تَرَكَ خَيْرًا الْوَصِيَّةُ لِلْوَالِدَيْنِ وَالأَقْرَبِينَ بِالْمَعْرُوفِ حَقًّا عَلَى الْمُتَّقِينَ سورة البقرة آية 180، قَالَ: ""الْخَيْرُ: الْمَالُ، كَانَ يُقَالُ: أَلْفًا فَمَا فَوْقَ ذَلِكَ"".""","Sahih","Sunan al-Darimi 3214","","","3. جو کوئی وصیت نہ کرے اس کا بیان"
"3215","(حديث مقطوع) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أَخْبَرَنَا ابْنُ عَوْنٍ، عَنْ مُحَمَّدِ بْنِ سِيرِينَ:أَنَّهُ أَوْصَى ذِكْرُ مَا أَوْصَى بِهِ، أَوْ هَذَا ذِكْرُ مَا أَوْصَى بِهِ مُحَمَّدُ بْنُ أَبِي عَمْرَةَ بَنِيهِ وَأَهْلَ بَيْتِهِ: فَاتَّقُوا اللَّهَ وَأَصْلِحُوا ذَاتَ بَيْنِكُمْ وَأَطِيعُوا اللَّهَ وَرَسُولَهُ إِنْ كُنْتُمْ مُؤْمِنِينَ سورة الأنفال آية 1، وَأَوْصَاهُمْ بِمَا أَوْصَى بِهِ إِبْرَاهِيمُ بَنِيهِ، وَيَعْقُوبُ: يَا بَنِيَّ إِنَّ اللَّهَ اصْطَفَى لَكُمُ الدِّينَ فَلا تَمُوتُنَّ إِلا وَأَنْتُمْ مُسْلِمُونَ سورة البقرة آية 132، وَأَوْصَاهُمْ أَنْ لَا يَرْغَبُوا أَنْ يَكُونُوا مَوَالِيَ الْأَنْصَارِ وَإِخْوَانَهُمْ فِي الدِّينِ، وَأَنَّ الْعِفَّةَ وَالصِّدْقَ خَيْرٌ وَأَتْقَى مِنْ الزِّنَا وَالْكَذِبِ، إِنْ حَدَثَ بِهِ حَدَثٌ فِي مَرَضِي هَذَا قَبْلَ أَنْ أُغَيِّرَ وَصِيَّتِي هَذِهِ، ثُمَّ ذَكَرَ حَاجَتَهُ"".""","Sahih","Sunan al-Darimi 3215","","","4. وصیت نامے کے الفاظ اور شہادت کا بیان"
"3216","(حديث موقوف) أَخْبَرَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ، حَدَّثَنَا أَبُو بَكْرٍ، حَدَّثَنَا هِشَامُ بْنُ حَسَّانَ، عَنْ ابْنِ سِيرِينَ، عَنْ أَنَسٍ، قَالَ:هَكَذَا كَانُوا يُوصُونَ: هَذَا مَا أَوْصَى بِهِ فُلَانُ بْنُ فُلَانٍ، أَنَّهُ يَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، وَأَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ، وَأَنَّ السَّاعَةَ آتِيَةٌ لَا رَيْبَ فِيهَا، وَأَنَّ اللَّهَ يَبْعَثُ مَنْ فِي الْقُبُورِ، وَأَوْصَى مَنْ تَرَكَ بَعْدَهُ مِنْ أَهْلِهِ أَنْ يَتَّقُوا اللَّهَ وَيُصْلِحُوا ذَاتَ بَيْنِهِمْ، وَأَنْ يُطِيعُوا اللَّهَ وَرَسُولَهُ إِنْ كَانُوا مُؤْمِنِينَ، وَأَوْصَاهُمْ بِمَا أَوْصَى بِهِ إِبْرَاهِيمُ بَنِيهِ وَيَعْقُوبُ: يَا بَنِيَّ إِنَّ اللَّهَ اصْطَفَى لَكُمُ الدِّينَ فَلا تَمُوتُنَّ إِلا وَأَنْتُمْ مُسْلِمُونَ سورة البقرة آية 132، وَأَوْصَى إِنْ حَدَثَ بِهِ حَدَثٌ مِنْ وَجَعِهِ هَذَا، أَنَّ حَاجَتَهُ كَذَا وَكَذَا"".""","Hasan","Sunan al-Darimi 3216","","","4. وصیت نامے کے الفاظ اور شہادت کا بیان"
"3217","(حديث مقطوع) حَدَّثَنَا الْحَكَمُ بْنُ الْمُبَارَكِ، أَخْبَرَنَا الْوَلِيدُ، عَنْ حَفْصِ بْنِ غَيْلَانَ، عَنْ مَكْحُولٍ حِينَ أَوْصَى، قَالَ:نَشَهُّدُ هَذَا فَاشْهَدْ بِهِ: نَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، وَأَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ، وَيُؤْمِنُ بِاللَّهِ، وَيَكْفُرُ بِالطَّاغُوتِ عَلَى ذَلِكَ يَحْيَا إِنْ شَاءَ اللَّهُ، وَيَمُوتُ، وَيُبْعَثُ، وَأَوْصَى فِيمَا رَزَقَهُ اللَّهُ فِيمَا تَرَكَ إِنْ حَدَثَ بِهِ حَدَثٌ وَهُوَ كَذَا وَكَذَا، إِنْ لَمْ يُغَيِّرْ شَيْئًا مِمَّا فِي هَذِهِ الْوَصِيَّةِ"".""","","Sunan al-Darimi 3217","","","4. وصیت نامے کے الفاظ اور شہادت کا بیان"
"3218","(حديث مقطوع) حَدَّثَنَا الْحَكَمُ، حَدَّثَنَا الْوَلِيدُ، قَالَ: أَخْبَرَنِي ابْنُ ثَوْبَانَ، عَنْ أَبِيهِ، عَنْ مَكْحُولٍ، قَالَ: هَذِهِ وَصِيَّةُ أَبِي الدَّرْدَاءِ.","Hasan","Sunan al-Darimi 3218","","","4. وصیت نامے کے الفاظ اور شہادت کا بیان"
"3219","(حديث مقطوع) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، حَدَّثَنَا أَبُو حَيَّانَ التَّيْمِيُّ، عَنْ أَبِيهِ، قَالَ: كَتَبَ الرَّبِيعُ بْنُ خُثَيْمٍ وَصِيَّتَهُ: بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ:هَذَا مَا أَوْصَى بِهِ الرَّبِيعُ بْنُ خُثَيْمٍ وَأَشْهَدَ اللَّهَ عَلَيْهِ، وَكَفَى بِاللَّهِ شَهِيدًا، وَجَازِيًا لِعِبَادِهِ الصَّالِحِينَ وَمُثِيبًا بِأَنِّي رَضِيتُ بِاللَّهِ رَبًّا، وَبِالْإِسْلَامِ دِينًا، وَبِمُحَمَّدٍ نَبِيًّا، وَإِنِّي آمُرُ نَفْسِي وَمَنْ أَطَاعَنِي أَنْ نَعْبُدَ اللَّهَ فِي الْعَابِدِينَ، وَنَحْمَدَهُ فِي الْحَامِدِينَ، وَأَنْ نَنْصَحَ لِجَمَاعَةِ الْمُسْلِمِينَ"".""","Sahih","Sunan al-Darimi 3219","","","4. وصیت نامے کے الفاظ اور شہادت کا بیان"
"3220","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، عَنْ هِشَامٍ، عَنْ أَبِيهِ:أَنَّ عَلِيًّا دَخَلَ عَلَى مَرِيضٍ، فَذَكَرُوا لَهُ الْوَصِيَّةَ، فَقال عَلِيٌّ: قَالَ اللَّهُ: إِنْ تَرَكَ خَيْرًا سورة البقرة آية 180، وَلَا أُرَاهُ تَرَكَ خَيْرًا"". قَالَ حَمَّادٌ: فَحَفِظْتُ أَنَّهُ تَرَكَ أَكْثَرَ مِنْ سَبْعِ مِائَةٍ.""","Sahih","Sunan al-Darimi 3220","","","5. تھوڑے سے مال میں بعض کے نزدیک وصیت کی ضرورت نہیں"
"3221","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا مُحَمَّدُ بْنُ كُنَاسَةَ، حَدَّثَنَا هِشَامٌ، عَنْ أَبِيهِ، قَالَ:دَخَلَ عَلِيُّ بْنُ أَبِي طَالِبٍ عَلَى رَجُلٍ مِنْ قَوْمِهِ يَعُودُهُ، فَقَالَ: أُوصِي؟ قَالَ: لا، لَمْ تَدَعْ مَالًا، فَدَعْ مَالَكَ لِوَلَدِكَ"".""","Sahih","Sunan al-Darimi 3221","","","5. تھوڑے سے مال میں بعض کے نزدیک وصیت کی ضرورت نہیں"
"3222","(حديث مقطوع) حَدَّثَنَا أَبُو زَيْدٍ، حَدَّثَنَا شُعْبَةُ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاهِيمَ:فِي رَجُلٍ أَوْصَى وَالْوَرَثَةُ شُهُودٌ مُقِرُّونَ، فَقَالَ: لَا يَجُوزُ"". قَالَ أَبُو مُحَمَّد: يَعْنِي: إِذَا أَنْكَرُوا بَعْدُ.""","Sahih","Sunan al-Darimi 3222","","","6. ایک تہائی مال سے زیادہ کی وصیت کا بیان"
"3223","(حديث مقطوع) حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا شُعْبَةُ، قَالَ: سَأَلْتُ الحَكَمَ، وَحَمَّادًا:عَنِ الْأَوْلِيَاءِ يُجِيزُونَ الْوَصِيَّةَ، فَإِذَا مَاتَ لَمْ يُجِيزُوا؟ قَالَا: لَا يَجُوزُ"".""","Sahih","Sunan al-Darimi 3223","","","6. ایک تہائی مال سے زیادہ کی وصیت کا بیان"
"3224","(حديث مقطوع) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، عَنْ دَاوُدَ بْنِ أَبِي هِنْدٍ، عَنْ عَامِرٍ، عَنْ شُرَيْحٍ:فِي الرَّجُلِ يُوصِي بِأَكْثَرَ مِنْ ثُلُثِهِ، قَالَ: إِنْ أَجَازَتْهُ الْوَرَثَةُ، أَجَزْنَاهُ، وَإِنْ قَالَتِ الْوَرَثَةُ: أَجَزْنَاهُ، فَهُمْ بِالْخِيَارِ إِذَا نَفَضُوا أَيْدِيَهُمْ مِنْ الْقَبْرِ"".""","Sahih","Sunan al-Darimi 3224","","","6. ایک تہائی مال سے زیادہ کی وصیت کا بیان"
"3225","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا الْمَسْعُودِيُّ، عَنْ أَبِي عَوْنٍ، عَنْ الْقَاسِمِ:أَنَّ رَجُلًا اسْتَأْذَنَ وَرَثَتَهُ أَنْ يُوصِيَ بِأَكْثَرَ مِنَ الثُّلُثِ، فَأَذِنُوا لَهُ، ثُمَّ رَجَعُوا فِيهِ بَعْدَ مَا مَاتَ، فَسُئِلَ عَبْدُ اللَّهِ عَنْ ذَلِكَ، فَقَالَ: هَذَا التَّكَرُّهُ لَا يَجُوزُ"".""","Da'if","Sunan al-Darimi 3225","","","6. ایک تہائی مال سے زیادہ کی وصیت کا بیان"
"3226","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، عَنْ هِشَامٍ، عَنْ الْحَسَنِ:فِي الرَّجُلِ يُوصِي بِأَكْثَرَ مِنْ الثُّلُثِ فَرَضِيَ الْوَرَثَةُ، قَالَ: هُوَ جَائِزٌ"". قَالَ أَبُو مُحَمَّد: أَجَزْنَاهُ يَعْنِي فِي الْحَيَاةِ.""","Hasan","Sunan al-Darimi 3226","","","6. ایک تہائی مال سے زیادہ کی وصیت کا بیان"
"3227","(حديث مرفوع) حَدَّثَنَا أَبُو الْوَلِيدِ الطَّيَالِسِيُّ، حَدَّثَنَا هَمَّامٌ، حَدَّثَنَا قَتَادَةُ، عَنْ يُونُسَ بْنِ جُبَيْرٍ، عَنْ مُحَمَّدِ بْنِ سَعْدٍ، عَنْ أَبِيهِ: أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ دَخَلَ عَلَيْهِ وَهُوَ بِمَكَّةَ، وَلَيْسَ لَهُ إِلَّا ابْنَةٌ، فَقُلْتُ لَهُ:إِنَّهُ لَيْسَ لِي إِلَّا ابْنَةٌ وَاحِدَةٌ، فَأُوصِي بِمَالِي كُلِّهِ؟ فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: لَا، قُلْتُ: فَأُوصِي بِالنِّصْفِ؟ فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: لَا، قَالَ: فَأُوصِي بِالثُّلُثِ؟ قَالَ: فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: الثُّلُثُ، وَالثُّلُثُ كَثِيرٌ"".""","Sahih","Sunan al-Darimi 3227","","","7. ایک تہائی کی وصیت کا بیان"
"3228","(حديث مرفوع) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، حَدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاق، عَنْ الزُّهْرِيِّ، عَنْ عَامِرِ بْنِ سَعْدٍ، عَنْ أَبِيهِ، قَالَ:اشْتَكَيْتُ مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي حَجَّةِ الْوَدَاعِ حَتَّى أُدْنِفْتُ، فَدَخَلَ عَلَيَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَعُودُنِي، فَقُلْتُ: يَا رَسُولَ اللَّهِ، مَا أُرَانِي إِلَّا أَلَمَّ بِي وَأَنَا ذُو مَالٍ كَثِيرٍ، وَإِنَّمَا يَرِثُنِي ابْنَةٌ لِي، أَفَأَتَصَدَّقُ بِمَالِي كُلِّهِ؟ قَالَ: لَا، قُلْتُ: فَبِنِصْفِهِ؟ قَال: لَا، قُلْتُ: فَالثُّلُثِ؟ قَالَ: الثُّلُثُ، وَالثُّلُثُ كَثِيرٌ، إِنَّكَ إِنْ تَتْرُكْ وَرَثَتَكَ أَغْنِيَاءَ، خَيْرٌ مِنْ أَنْ تَتْرُكَهُمْ فُقَرَاءَ يَتَكَفَّفُونَ النَّاسَ بِأَيْدِيهِمْ، وَإِنَّكَ لَا تُنْفِقُ نَفَقَةً إِلَّا آجَرَكَ اللَّهُ فِيهَا، حَتَّى مَا تَجْعَلُ فِي فِي امْرَأَتِكَ"".""","Da'if","Sunan al-Darimi 3228","","","7. ایک تہائی کی وصیت کا بیان"
"3229","(حديث مقطوع) حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، عَنْ إِسْحَاق بْنِ سُوَيْدٍ، عَنْ الْعَلَاءِ بْنِ زِيَادٍ:أَنَّ أَبَاهُ زِيَادَ بْنَ مَطَرٍ أَوْصَى، فَقَالَ: وَصِيَّتِي مَا اتَّفَقَ عَلَيْهِ فُقَهَاءُ أَهْلِ الْبَصْرَةِ، فَسَأَلْتُ، فَاتَّفَقُوا عَلَى الْخُمُسِ"".""","Sahih","Sunan al-Darimi 3229","","","8. ایک تہائی سے کم کی وصیت کرنے کا بیان"
"3230","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، عَنْ إِسْحَاق بْنِ سُوَيْدٍ، عَنْ الْعَلَاءِ بْنِ زِيَادٍ: أَنَّ رَجُلًا سَأَلَ عُمَرَ بْنَ الْخَطَّابِ، فَقَالَ:إِنَّ وَارِثِي كَلَالَةٌ، فَأُوصِي بِالنِّصْفِ؟ قَالَ: لَا، قَالَ: فَالثُّلُثِ؟ قَالَ: لَا، قَالَ: فَالرُّبُع؟ قَالَ: لَا، قَالَ: فَالْخُمُس؟ قَالَ: لَا، حَتَّى صَارَ إِلَى الْعُشْرِ، فَقَالَ: أَوْصِ بِالْعُشْرِ"".""","","Sunan al-Darimi 3230","","","8. ایک تہائی سے کم کی وصیت کرنے کا بیان"
"3231","(حديث مقطوع) حَدَّثَنَا يَعْلَى، حَدَّثَنَا إِسْمَاعِيل، عَنْ عَامِرٍ، قَالَ: إِنَّمَا كَانُوا يُوصُونَ بِالْخُمُسِ وَالرُّبُعِ، وَكَانَ الثُّلُثُ مُنْتَهَى الْجَامِحِ. قَالَ أَبُو مُحَمَّد: يَعْنِي بِالْجَامِحِ: الْفَرَسَ الْجَمُوحَ.""","Sahih","Sunan al-Darimi 3231","","","8. ایک تہائی سے کم کی وصیت کرنے کا بیان"
"3232","(حديث مقطوع) حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ حُمَيْدٍ، عَنْ بَكْرٍ، قَالَ:أَوْصَيْتُ إِلَى حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ، فَقَالَ: مَا كُنْتُ لِأَقْبَلَ وَصِيَّةَ رَجُلٍ لَهُ وَلَدٌ يُوصِي بِالثُّلُثِ"".""","Sahih","Sunan al-Darimi 3232","","","8. ایک تہائی سے کم کی وصیت کرنے کا بیان"
"3233","(حديث مقطوع) حَدَّثَنَا قَبِيصَةُ، أَخْبَرَنَا سُفْيَانُ، عَنْ هِشَامٍ، عَنْ مُحَمَّدِ بْنِ سِيرِينَ، عَنْ شُرَيْحٍ، قَالَ: الثُّلُثُ جَهْدٌ وَهُوَ جَائِزٌ"".""","Hasan","Sunan al-Darimi 3233","","","8. ایک تہائی سے کم کی وصیت کرنے کا بیان"
"3234","(حديث مقطوع) حَدَّثَنَا عُبَيْدُ اللَّهِ، عَنْ إِسْرَائِيلَ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاهِيمَ، قَالَ: كَانَ السُّدُسُ أَحَبَّ إِلَيْهِمْ مِنْ الثُّلُثِ"".""","Sahih","Sunan al-Darimi 3234","","","8. ایک تہائی سے کم کی وصیت کرنے کا بیان"
"3235","(حديث مقطوع) حَدَّثَنَا أَبُو الْوَلِيدِ، حَدَّثَنَا شَرِيكٌ، عَنْ مُغِيرَةَ، عَنْ إِبْرَاهِيمَ، قَالَ: الْوَصِيُّ أَمِينٌ فِيمَا أُوصِيَ إِلَيْهِ بِهِ"".""","Hasan","Sunan al-Darimi 3235","","","9. وصی کے لئے کیا جائز ہے اور کیا ناجائز ہے؟"
"3236","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ الْمُبَارَكِ، حَدَّثَنَا يَحْيَى بْنُ حَمْزَةَ، عَنْ أبي وَهْبٍ، عَنْ مَكْحُولٍ، قَالَ: أَمْرُ الْوَصِيِّ جَائِزٌ فِي كُلِّ شَيْءٍ، إِلَّا فِي الِابْتِيَاعِ، وَإِذَا بَاعَ بَيْعًا لَمْ يُقِلْ""، وَهُوَ رَأْيُ يَحْيَى بْنِ حَمْزَةَ.""","Sahih","Sunan al-Darimi 3236","","","9. وصی کے لئے کیا جائز ہے اور کیا ناجائز ہے؟"
"3237","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ الْمُبَارَكِ، حَدَّثَنَا الْوَلِيدُ، عَنْ الْأَوْزَاعِيِّ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ، قَالَ: الْوَصِيُّ أَمِينٌ فِي كُلِّ شَيْءٍ، إِلَّا فِي الْعِتْقِ، فَإِنَّ عَلَيْهِ أَنْ يُقِيمَ الْوَلَاءَ"".""","Da'if","Sunan al-Darimi 3237","","","9. وصی کے لئے کیا جائز ہے اور کیا ناجائز ہے؟"
"3238","(حديث مقطوع) حَدَّثَنَا عُبَيْدُ اللَّهِ، عَنْ إِسْرَائِيلَ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاهِيمَ:فِي مَالِ الْيَتِيمِ يَعْمَلُ بِهِ الْوَصِيُّ إِذَا أَوْصَى إِلَى الرَّجُلِ"".""","Sahih","Sunan al-Darimi 3238","","","9. وصی کے لئے کیا جائز ہے اور کیا ناجائز ہے؟"
"3239","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا مُحَمَّدُ بْنُ الصَّلْتِ، حَدَّثَنَا مُوسَى بْنُ مُحَمَّدٍ، عَنْ إِسْمَاعِيل، عَنْ الْحَسَنِ، قَالَ: وَصِيُّ الْيَتِيمِ يَأْخُذُ لَهُ بِالشُّفْعَةِ، وَالْغَائِبُ عَلَى شُفْعَتِهِ"".""","Da'if","Sunan al-Darimi 3239","","","9. وصی کے لئے کیا جائز ہے اور کیا ناجائز ہے؟"
"3240","(حديث مقطوع) أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُبَارَكِ، حَدَّثَنَا يَحْيَى بْنُ حَمْزَةَ، عَنْ عِكْرِمَةَ شَيْخٍ مِنْ أَهْلِ دِمَشْقَ، قَالَ:كُنْتُ عِنْدَ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ، وَعِنْدَهُ سُلَيْمَانُ بْنُ حَبِيبٍ، وَأَبُو قِلَابَةَ، إِذْ دَخَلَ غُلَامٌ، فَقَالَ: أَرْضُنَا بِمَكَانِ كَذَا وَكَذَا، بَاعَكُمْ الْوَصِيُّ وَنَحْنُ أَطْفَالٌ، فَالْتَفَتَ إِلَى سُلَيْمَانَ بْنِ حَبِيبٍ، فَقَالَ: مَا تَقُولُ؟ قَالَ: فَأَضْجَعَ فِي الْقَوْلِ، فَالْتَفَتَ إِلَى أَبِي قِلَابَةَ، فَقَالَ: مَا تَقُولُ؟ قَالَ: رُدَّ عَلَى الْغُلَامِ أَرْضَهُ، قَالَ: إِذًا يَهْلِكُ مَالُنَا؟ قَالَ: أَنْتَ أَهْلَكْتَهُ"".""","","Sunan al-Darimi 3240","","","9. وصی کے لئے کیا جائز ہے اور کیا ناجائز ہے؟"
"3241","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا إِبْرَاهِيمُ بْنُ مُوسَى، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللَّهِ، عَنْ أَشْعَثَ، عَنْ الْحَسَنِ:فِي رَجُلٍ أَوْصَى لِرَجُلٍ بِنِصْفِ مَالِهِ، وَلِآخَرَ بِثُلُثِ مَالِهِ، قَالَ: يَضْرِبَانِ بِذَلِكَ فِي الثُّلُثِ: هَذَا بِالنِّصْفِ، وَهَذَا بِالثُّلُث"".""","Sahih","Sunan al-Darimi 3241","","","10. جب مرنے والا کسی کے لئے آدھے مال اور کسی کے لئے تہائی مال کی وصیت کرے"
"3242","(حديث مقطوع) حَدَّثَنَا أَبُو الْوَلِيدِ الطَّيَالِسِيُّ، حَدَّثَنَا زَائِدَةُ، عَنْ الشَّيْبَانِيِّ، عَنْ الشَّعْبِيِّ، قَالَ: يُغَيِّرُ صَاحِبُ الْوَصِيَّةِ مِنْهَا مَا شَاءَ، غَيْرَ الْعَتَاقَةِ"".""","Sahih","Sunan al-Darimi 3242","","","11. وصیت سے رجوع کرنے کا بیان"
"3243","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا أَبُو الْوَلِيدِ الطَّيَالِسِيُّ، حَدَّثَنَا هَمَّامٌ، حَدَّثَنَا قَتَادَةُ، عَنْ عَمْرِو بْنِ شُعَيْبٍ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي رَبِيعَةَ:أَنَّ عُمَرَ بْنَ الْخَطَّابِ، قَالَ: ""يُحْدِثُ الرَّجُلُ فِي وَصِيَّتِهِ مَا شَاءَ، وَمِلَاكُ الْوَصِيَّةِ آخِرُهَا"".""","","Sunan al-Darimi 3243","","","11. وصیت سے رجوع کرنے کا بیان"
"3244","(حديث مقطوع) حَدَّثَنَا سَهْلُ بْنُ حَمَّادٍ، حَدَّثَنَا هَمَّامٌ، قَالَ: حَدَّثَنِي قَتَادَةُ، قَالَ: حَدَّثَنِي عَمْرُو بْنُ دِينَارٍ:أَنَّ أَبَاهُ أَعْتَقَ رَقِيقًا لَهُ فِي مَرَضِهِ، ثُمَّ بَدَا لَهُ أَنْ يَرُدَّهُمْ وَيُعْتِقَ غَيْرَهُمْ، قَالَ: فَخَاصَمُونِي إِلَى عَبْدِ الْمَلِكِ بْنِ مَرْوَانَ، فَأَجَازَ عِتْقَ الْآخِرِينَ، وَأَبْطَلَ عِتْقَ الْأَوَّلِينَ"".""","Da'if","Sunan al-Darimi 3244","","","11. وصیت سے رجوع کرنے کا بیان"
"3245","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا سَهْلُ بْنُ حَمَّادٍ، حَدَّثَنَا هَمَّامٌ، عَنْ عَمْرِو بْنِ شُعَيْبٍ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي رَبِيعَةَ، عَنْ الشَّرِيدِ بْنِ سُوَيْدٍ، قَالَ: قَالَ عُمَرُ: يُحْدِثُ الرَّجُلُ فِي وَصِيَّتِهِ مَا شَاءَ، وَمِلَاكُ الْوَصِيَّةِ آخِرُهَا"". قَالَ أَبُو مُحَمَّد: هَمَّامٌ لَمْ يَسْمَعْ مِنْ عَمْرٍو، وَبَيْنَهُمَا قَتَادَةُ.""","","Sunan al-Darimi 3245","","","11. وصیت سے رجوع کرنے کا بیان"
"3246","(حديث مقطوع) حَدَّثَنَا سَعِيدُ بْنُ الْمُغِيرَةِ، قَالَ: ابْنُ الْمُبَارَكِ حَدَّثَنَا، عَنْ مَعْمَرٍ، عَنِ الزُّهْرِيِّ:فِي الرَّجُلِ يُوصِي بِوَصِيَّةٍ ثُمَّ يُوصِي بِأُخْرَى، قَالَ: هُمَا جَائِزَتَانِ فِي مَالِهِ"".""","Sahih","Sunan al-Darimi 3246","","","11. وصیت سے رجوع کرنے کا بیان"
"3247","(حديث موقوف) حَدَّثَنَا سَعِيدٌ، عَنْ ابْنِ الْمُبَارَكِ، عَنْ مَعْمَرٍ، عَنْ قَتَادَةَ، قَالَ: قَالَ عُمَرُ بْنُ الْخَطَّابِ: مِلَاكُ الْوَصِيَّةِ آخِرُهَا"".""","","Sunan al-Darimi 3247","","","11. وصیت سے رجوع کرنے کا بیان"
"3248","(حديث مقطوع) أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُبَارَكِ، حَدَّثَنَا الْوَلِيدُ، عَنْ الْأَوْزَاعِيِّ، عَنْ يَحْيَى، قَالَ: إِذَا اتَّهَمَ الْقَاضِي الْوَصِيَّ لَمْ يَعْزِلْهُ، وَلَكِنْ يُوَكِّلُ مَعَهُ غَيْرَهُ"" وَهُوَ رَأْيُ الْأَوْزَاعِيِّ.""","Hasan","Sunan al-Darimi 3248","","","12. متہم وصی کا بیان"
"3249","(حديث مقطوع) حَدَّثَنَا أَبُو الْوَلِيدِ، حَدَّثَنَا شَرِيكٌ، عَنْ الشَّيْبَانِيِّ، عَنْ عَامِرٍ، قَالَ: يَجُوزُ بَيْعُ الْمَرِيضِ وَشِرَاؤُهُ وَنِكَاحُهُ، وَلَا يَكُونُ مِنَ الثُّلُثِ"".""","Hasan","Sunan al-Darimi 3249","","","13. بیمار کی وصیت کا بیان"
"3250","(حديث مقطوع) حَدَّثَنَا أَبُو الْوَلِيدِ، حَدَّثَنَا أَبُو عَوَانَةَ، عَنْ مُطَرِّفٍ، عَنْ الْحَارِثِ الْعُكْلِيِّ، قَالَ: مَا حَابَى بِهِ الْمَرِيضُ فِي مَرَضِهِ مِنْ بَيْعٍ أَوْ شِرَاءٍ، فَهُوَ فِي ثُلُثِهِ قِيمَةُ عَدْلٍ"".""","Sahih","Sunan al-Darimi 3250","","","13. بیمار کی وصیت کا بیان"
"3251","(حديث مقطوع) حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، عَنْ يَحْيَى هُوَ ابْنُ سَعِيدٍ، قَالَ: أَعْطَتِ امْرَأَةٌ مِنْ أَهْلِنَا وَهِيَ حَامِلٌ، فَسُئِلَ الْقَاسِمُ، فَقَالَ:هُوَ مِنْ جَمِيعِ الْمَالِ، قَالَ يَحْيَى: وَنَحْنُ نَقُولُ: إِذَا ضَرَبَهَا الْمَخَاضُ فَمَا أَعْطَتْ، فَمِنْ الثُّلُثِ"".""","Sahih","Sunan al-Darimi 3251","","","13. بیمار کی وصیت کا بیان"
"3252","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ، حَدَّثَنَا أَبُو شِهَابٍ، عَنْ عَمْرٍو، عَنْ الْحَسَنِ:فِي رَجُلٍ قَالَ لِغُلَامِهِ: إِنْ دَخَلْتُ دَارَ فُلَانٍ، فَغُلَامِي حُرٌّ، ثُمَّ دَخَلَهَا وَهُوَ مَرِيضٌ، قَالَ: يُعْتَقُ مِنْ الثُّلُثِ، وَإِنْ دَخَلَ فِي صِحَّتِهِ، عُتِقَ مِنْ جَمِيعِ الْمَالِ"".""","Da'if","Sunan al-Darimi 3252","","","13. بیمار کی وصیت کا بیان"
"3253","(حديث مقطوع) أخبرنا مَرْوَانُ بْنُ مُحَمَّدٍ، حَدَّثَنَا يَحْيَى بْنُ حَمْزَةَ، حَدَّثَنَا النُّعْمَانُ بْنُ الْمُنْذِرِ، عَنْ مَكْحُولٍ، قَالَ: إِذَا كَانَ الْوَرَثَةُ مَحَاوِيجَ، فَلَا أَرَى بَأْسًا أَنْ يُرَدَّ عَلَيْهِمْ مِنْ الثُّلُثِ""، قَالَ يَحْيَى: فَذَكَرْتُ ذَلِكَ لِلْأَوْزَاعِيِّ فَأَعْجَبَهُ.""","Sahih","Sunan al-Darimi 3253","","","14. تہائی میں سے بھی بعض کے نزدیک وارثین حصہ لے سکتے ہیں"
"3254","(حديث مقطوع) أخبرنا أَبُو النُّعْمَانِ، حَدَّثَنَا هُشَيْمٌ، حَدَّثَنَا يُونُسُ، عَنْ الْحَسَنِ. ح وأَخْبَرَنَا مُغِيرَةُ، عَنْ إِبْرَاهِيمَ، قَالَا: إِذَا شَهِدَ شَاهِدَانِ مِنْ الْوَرَثَةِ، جَازَ عَلَى جَمِيعِهِمْ، وَإِذَا شَهِدَ وَاحِدٌ، فَفِي نَصِيبِهِ بِحِصَّتِهِ"".""","Sahih","Sunan al-Darimi 3254","","","15. وارثین میں سے دو قرض کی شہادت دیں"
"3255","(حديث مقطوع) حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا هُشَيْمٌ، حَدَّثَنَا مُطَرِّفٌ: أَنَّهُ سَمِعَ الشَّعْبِيَّ، يَقُولُ: إِذَا شَهِدَ رَجُلٌ مِنْ الْوَرَثَةِ، فَفِي نَصِيبِهِ بِحِصَّتِهِ، ثُمَّ قَالَ: بَعْدَ ذَلِكَ فِي جَمِيعِ حِصَّتِهِ"".""","Sahih","Sunan al-Darimi 3255","","","15. وارثین میں سے دو قرض کی شہادت دیں"
"3256","(حديث مقطوع) حَدَّثَنَا أَبُو الْوَلِيدِ الطَّيَالِسِيُّ، حَدَّثَنَا أَبُو شِهَابٍ عَبْدُ رَبِّهِ بْنُ نَافِعٍ، عَنْ الْأَعْمَشِ، عَنْ إِبْرَاهِيمَ، قَالَ: إِذَا أَوْصَى الرَّجُلُ بِالثُّلُثِ، وَالرُّبُعِ، فَفِي الْعَيْنِ وَالدَّيْنِ، وَإِذَا أَوْصَى بِخَمْسِينَ أَوْ سِتِّينَ إِلَى الْمِائَةِ، فَفِي الْعَيْنِ حَتَّى يَبْلُغَ الثُّلُثَ"".""","Sahih","Sunan al-Darimi 3256","","","16. مال معین میں اور قرض میں سے وصیت کا بیان"
"3257","(حديث مرفوع) أَخْبَرَنَا مَرْوَانُ بْنُ مُحَمَّدٍ، حَدَّثَنَا سُلَيْمَانُ بْنُ بِلَالٍ، حَدَّثَنَا جَعْفَرُ بْنُ مُحَمَّدٍ، عَنْ يَزِيدَ بْنِ عَبْدِ اللَّهِ بْنِ قُسَيْطٍ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: الْمَرْءُ أَحَقُّ بِثُلُثِ مَالِهِ، يَضَعُهُ فِي أَيِّ مَالِهِ شَاءَ"".""","","Sunan al-Darimi 3257","","","17. جس کو وصیت کرنا پسند ہو یا ناپسند ہو اس کا بیان"
"3258","(حديث مرفوع) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ، حَدَّثَنَا شُعْبَةُ، حَدَّثَنَا أَبُو إِسْحَاق، عَنْ أَبِي حَبِيبَةَ، قَالَ: سَأَلْتُ أَبَا الدَّرْدَاءِ عَنْ رَجُلٍ جَعَلَ دَرَاهِمَ فِي سَبِيلِ اللَّهِ، فَقَالَ أَبُو الدَّرْدَاءِ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: مَثَلُ الَّذِي يَتَصَدَّقُ عِنْدَ مَوْتِهِ أَوْ يُعْتِقُ، كَالَّذِي يُهْدِي بَعْدَ مَا شَبِعَ"".""","Sahih","Sunan al-Darimi 3258","","","17. جس کو وصیت کرنا پسند ہو یا ناپسند ہو اس کا بیان"
"3259","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا الْمُعَلَّى بْنُ أَسَدٍ، حَدَّثَنَا وُهَيْبٌ، عَنْ يُونُسَ، عَنْ الْحَسَنِ:فِي الرَّجُلِ يُوصِي بِأَشْيَاءَ وَمِنْهَا الْعِتْقُ، فَيُجَاوِزُ الثُّلُثَ، قَالَ: يُبْدَأُ بِالْعِتْقِ"".""","Sahih","Sunan al-Darimi 3259","","","18. وصیت کی تنفیذ میں ابتداء کس وصیت سے کریں"
"3260","(حديث موقوف) حَدَّثَنَا الْمُعَلَّى بْنُ أَسَدٍ، حَدَّثَنَا وُهَيْبٌ، عَنْ أَيُّوبَ، عَنْ مُحَمَّدٍ، قَالَ: بِالْحِصَصِ.","Sahih","Sunan al-Darimi 3260","","","18. وصیت کی تنفیذ میں ابتداء کس وصیت سے کریں"
"3261","(حديث مقطوع) حَدَّثَنَا الْحَسَنُ بْنُ بِشْرٍ، حَدَّثَنَا الْمُعَافَى، عَنْ عُثْمَانَ بْنِ الْأَسْوَدِ، عَنْ عَطَاءٍ، قَالَ: مَنْ أَوْصَى أَوْ أَعْتَقَ، فَكَانَ فِي وَصِيَّتِهِ عَوْلٌ، دَخَلَ الْعَوْلُ عَلَى أَهْلِ الْعَتَاقَةِ، وَأَهْلِ الْوَصِيَّةِ"". قَالَ عَطَاءٌ: إِنَّ أَهْلَ الْمَدِينَةِ غَلَبُونَا، يَبْدَءُونَ بِالْعَتَاقَةِ قَبْلُ.""","Sahih","Sunan al-Darimi 3261","","","18. وصیت کی تنفیذ میں ابتداء کس وصیت سے کریں"
"3262","(حديث مقطوع) حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، قَالَ: قَالَ عَمْرُو بْنُ دِينَارٍ فِي الَّذِي يُوصِي بِعِتْقٍ، وَغَيْرِهِ فَيَزِيدُ عَلَى الثُّلُثِ، قَالَ: بِالْحِصَصِ"".""","Sahih","Sunan al-Darimi 3262","","","18. وصیت کی تنفیذ میں ابتداء کس وصیت سے کریں"
"3263","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، عَنْ كَثِيرِ بْنِ شِنْظِيرٍ، عَنْ الْحَسَنِ:فِي رَجُلٍ أَوْصَى بِأَكْثَرَ مِنْ الثُّلُثِ وَفِيهِ عِتْقٌ؟ قَالَ: يُبْدَأُ بِالْعِتْقِ"".""","Sahih","Sunan al-Darimi 3263","","","18. وصیت کی تنفیذ میں ابتداء کس وصیت سے کریں"
"3264","(حديث مقطوع) حَدَّثَنَا عُبَيْدُ اللَّهِ، عَنْ إِسْرَائِيلَ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاهِيمَ، قَالَ: يُبْدَأُ بِالْعَتَاقَةِ قَبْلَ الْوَصِيَّةِ"".""","Sahih","Sunan al-Darimi 3264","","","18. وصیت کی تنفیذ میں ابتداء کس وصیت سے کریں"
"3265","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا الْمُعَلَّى بْنُ أَسَدٍ، قَالَ: حَدَّثَنَا وُهَيْبٌ، عَنْ يُونُسَ، عَنْ الْحَسَنِ:فِي الرَّجُلِ يُوصِي لِبَنِي فُلَانٍ، قَالَ: غَنِيُّهُمْ وَفَقِيرُهُمْ وَذَكَرُهُمْ وَأُنْثَاهُمْ سَوَاءٌ"".""","Sahih","Sunan al-Darimi 3265","","","19. کوئی آدمی اپنے مال کے کچھ حصے کی کسی کے لئے وصیت کرے"
"3266","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ، حَدَّثَنَا أَبُو شِهَابٍ، عَنْ عَمْرٍو، عَنْ الْحَسَنِ، قَالَ: إِذَا أَوْصَى لِبَنِي فُلَانٍ، فَالذَّكَرُ وَالْأُنْثَى فِيهِ سَوَاءٌ"".""","Hasan","Sunan al-Darimi 3266","","","19. کوئی آدمی اپنے مال کے کچھ حصے کی کسی کے لئے وصیت کرے"
"3267","(حديث مقطوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا زَائِدَةُ بْنُ مُوسَى الْهَمْدَانِيُّ، حَدَّثَنِي سَيَّارُ بْنُ أَبِي كَرِبٍ:أَنَّ آتِيًا أَتَى شُرَيْحًا، فَسَأَلَهُ عَنْ رَجُلٍ أَوْصَى بِسَهْمٍ مِنْ مَالِهِ، قَالَ: تُحْسَبُ الْفَرِيضَةُ، فَمَا بَلَغَ سِهَامَهَا، أُعْطِيَ الْمُوصَى لَهُ سَهْمًا كَأَحَدِهَا"".""","Sahih","Sunan al-Darimi 3267","","","19. کوئی آدمی اپنے مال کے کچھ حصے کی کسی کے لئے وصیت کرے"
"3268","(حديث مقطوع) أَخْبَرَنَا مَرْوَانُ بْنُ مُحَمَّدٍ، حَدَّثَنَا سَعِيدٌ، عَنْ مَكْحُولٍ، قَالَ: إِذَا تَصَدَّقَ الرَّجُلُ عَلَى بَعْضِ وَرَثَتِهِ وَهُوَ صَحِيحٌ بِأَكْثَرَ مِنْ النِّصْفِ، رُدَّ إِلَى الثُّلُثِ، وَإِذَا أَعْطَى النِّصْفَ، جَازَ لَهُ ذَلِكَ"". قَالَ سَعِيدٌ: وَكَانَ قُضَاةُ أَهْلِ دِمَشْقَ يَقْضُونَ بِذَلِكَ.""","Sahih","Sunan al-Darimi 3268","","","20. کوئی آدمی اپنے بعض وارثین پر صدقہ کرے؟"
"3269","(حديث مقطوع) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ أَبِي شَيْبَةَ، حَدَّثَنَا حَفْصٌ، عَنْ إِسْمَاعِيل بْنِ أَبِي خَالِدٍ، عَنِ الْحَكَمِ، عَنْ إِبْرَاهِيمَ، قَالَ: الْكَفَنُ مِنْ جَمِيعِ الْمَالِ"".""","Sahih","Sunan al-Darimi 3269","","","21. کفن کا خرچ تمام مال میں سے ہو گا"
"3270","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا إِبْرَاهِيمُ بْنُ مُوسَى، عَنْ مُعَاذٍ، عَنْ أَشْعَثَ، عَنْ الْحَسَنِ:فِي رَجُلٍ مَاتَ وَتَرَكَ قِيمَةَ أَلْفَيْ دِرْهَمٍ، وَعَلَيْهِ مِثْلُهَا أَوْ أَكْثَرُ، قَالَ: يُكَفَّنُ مِنْهَا، وَلَا يُعْطَى دَيْنُهُ"".""","Hasan","Sunan al-Darimi 3270","","","21. کفن کا خرچ تمام مال میں سے ہو گا"
"3271","(حديث مقطوع) حَدَّثَنَا قَبِيصَةُ، حَدَّثَنَا سُفْيَانُ، عَمَّنْ سَمِعَ إِبْرَاهِيمَ، قَالَ: يُبْدَأُ بِالْكَفَنِ، ثُمَّ الدَّيْنِ، ثُمَّ الْوَصِيَّةِ"".""","Da'if","Sunan al-Darimi 3271","","","21. کفن کا خرچ تمام مال میں سے ہو گا"
