hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"1210","عَنْ أَبِي رَاشِدٍ الْحِبْرَانِيِّ رَحِمَهُ اللَّهُ قَالَ: أَتَيْتُ عَبْدَ اللَّهِ بْنَ عَمْرٍو رَضِيَ اللَّهُ عَنْهُمَا فَقُلْتُ: حَدِّثْنِي بِحَدِيثٍ سَمِعْتَهُ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ. فَأَعْطَانِي صَحِيفَةً فَقَالَ: هَذِهِ صَحِيفَةٌ كَتَبَهَا لِي النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ. فَنَظَرْتُ فِيهَا فَإِذَا فِيهَا: إِنَّ أَبَا بَكْرٍ الصِّدِّيقَ رَضِيَ اللَّهُ عَنْهُ سَأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَالَ: يَا رَسُولَ اللَّهِ، عَلِّمْنِي دُعَاءً أَدْعُو بِهِ فِي الصَّبَاحِ وَالْمَسَاءِ. فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \يَا أَا بَكْرٍ، قُلِ: اللَّهُمَّ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ، عَالِمَ الْغَيْبِ وَالشَّهَادَةِ، رَبَّ كُلِّ شَيْءٍ وَمَلِيكَهُ، أَعُوذُ بِكَ مِنْ شَرِّ نَفْسِي وَمِنْ شَرِّ الشَّيْطَانِ وَشِرْكِهِ، وَأَنْ أَقْتَرِفَ سُوءًا عَلَى نَفْسِي أَوْ أَجُرَّهُ إِلَى مُسْلِمٍ.""""""","Sahih","Al-Adab Al-Mufrad 1210","","","كتاب النوم والمبيت"
"1211","عَنْ حُذَيْفَةَ رَضِيَ اللَّهُ عَنْهُ قَالَ: كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا أَرَادَ أَنْ يَنَامَ قَالَ: \بِاسْمِكَ اللَّهُمَّ أَمُوتُ وَأَحْيَا.\"" وَإِذَا اسْتَيْقَظَ مِنْ نَوْمِهِ قَالَ: \""الْحَمْدُ لِلَّهِ الَّذِي أَحْيَانَا بَعْدَ مَا أَمَاتَنَا وَإِلَيْهِ النُّشُورُ.""""""","Sahih","Al-Adab Al-Mufrad 1211","","","كتاب النوم والمبيت"
"1212","عن أنس رضي الله عنه قال: كان النبي صلى الله عليه وسلم إذا أتى فراشه قال: \الحمد لله الذي أطعمنا وسقانا وكفانا وآوانا فكم ممن لا كافي له ولا مؤوي.""""""","Sahih","Al-Adab Al-Mufrad 1212","","","كتاب النوم والمبيت"
"1213","عن جابر رضي الله عنه قال: كان رسول الله صلى الله عليه وسلم لا ينام حتى يقرأ سورة السجدة وسورة الملك. قال أبو الزبير: إن هاتين السورتين ليفضلان كل سورة من كتاب الله بسبعين حسنة، فمن قرأهما كُتب له سبعون حسنة ورُفع له سبعون درجة ومُحيت عنه سبعون سيئة.","Sahih","Al-Adab Al-Mufrad 1213","","","كتاب النوم والمبيت"
"1214","عن عبد الله رضي الله عنه قال: ذكر النوم عند الذكر من الشيطان، إن شئتم فجربوا: إذا جاء أحدكم إلى فراشه وأراد أن ينام فليذكر الله عز وجل.","Sahih","Al-Adab Al-Mufrad 1214","","","كتاب النوم والمبيت"
"1215","عن جابر رضي الله عنه قال: كان النبي صلى الله عليه وسلم لا ينام حتى يقرأ تبارك الذي بيده الملك وآلم تنزيل السجدة.","Sahih","Al-Adab Al-Mufrad 1215","","","كتاب النوم والمبيت"
"1216","عن أبي هريرة رضي الله عنه أن رسول الله صلى الله عليه وسلم قال: \إذا اضطجع أحدكم على فراشه فليأخذ إزار إزاره فلينفض به فراشه فإنه لا يدري ما خلفه عليه، وليضطجع على جنبه الأيمن وليقل: باسمك وضعت جنبي اللهم إن قبضت نفسي فارحمها، وإن أ释放تها فاحفظها بما تحفظ به صالح عبادك\"" أو قال: \""بما تحفظ به عبادك الصالحين.""""""","Sahih","Al-Adab Al-Mufrad 1216","","","كتاب النوم والمبيت"
"1217","عَنِ ابْنِ عَبَّاسٍ رَضِيَ اللَّهُ عَنْهُمَا قَالَ: بِتُّ عِنْدَ خَالَتِي مَيْمُونَةَ فَقَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي فَقُمْتُ عَنْ يَسَارِهِ فَأَخَذَ بِرَأْسِي فَأَقَامَنِي عَنْ يَمِينِهِ.","Sahih","Al-Adab Al-Mufrad 1217","","","كتاب النوم والمبيت"
"1218","عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا أَوَى إِلَى فِرَاشِهِ قَالَ: اللَّهُمَّ رَبَّ السَّمَاوَاتِ وَرَبَّ الْأَرْضِ وَرَبَّ كُلِّ شَيْءٍ فَالِقَ الْحَبَّةِ وَالنَّوَى وَمُنْزِلَ التَّوْرَاةِ وَالْإِنْجِيلِ وَالْقُرْآنِ أَعُوذُ بِكَ مِنْ شَرِّ كُلِّ ذِي شَرٍّ أَنْتَ آخِذٌ بِنَاصِيَتِهِ أَنْتَ الْأَوْلُ فَلَيْسَ قَبْلَكَ شَيْءٌ وَأَنْتَ الْآخِرُ فَلَيْسَ بَعْدَكَ شَيْءٌ وَأَنْتَ الظَّاهِرُ فَلَيْسَ فَوْقَكَ شَيْءٌ وَأَنْتَ الْبَاطِنُ فَلَيْسَ دُونَكَ شَيْءٌ اقْضِ عَنِّي الدَّيْنَ وَأَغْنِنِي مِنَ الْفَقْرِ.","Sahih","Al-Adab Al-Mufrad 1218","","","كتاب النوم والمبيت"
"1219","عَنِ الْبَرَاءِ بْنِ عَازِبٍ رَضِيَ اللَّهُ عَنْهُمَا أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا أَوَى إِلَى فِرَاشِهِ اضْطَجَعَ عَلَى شِقِّهِ الْأَيْمَنِ ثُمَّ قَالَ: اللَّهُمَّ أَسْلَمْتُ نَفْسِي إِلَيْكَ وَوَجَّهْتُ وَجْهِي إِلَيْكَ وَفَوَّضْتُ أَمْرِي إِلَيْكَ وَأَلْجَأْتُ ظَهْرِي إِلَيْكَ رَغْبَةً فِيكَ وَرَهْبَةً إِلَيْكَ لَا مَلْجَأَ وَلَا مَنْجَا مِنْكَ إِلَّا إِلَيْكَ آمَنْتُ بِكِتَابِكَ الَّذِي أَنْزَلْتَ وَبِنَبِيِّكَ الَّذِي أَرْسَلْتَ. فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: مَنْ قَالَ هَذِهِ الْكَلِمَاتِ ثُمَّ مَاتَ مِنْ تِلْكَ اللَّيْلَةِ مَاتَ عَلَى الْفِطْرَةِ.","Sahih","Al-Adab Al-Mufrad 1219","","","كتاب النوم والمبيت"
"1220","عَنْ جَابِرٍ رَضِيَ اللَّهُ عَنْهُ قَالَ: إِذَا دَخَلَ الرَّجُلُ بَيْتَهُ أَوْ أَوَى إِلَى فِرَاشِهِ عُجِّلَ إِلَيْهِ مَلَكٌ وَشَيْطَانٌ فَيَقُولُ الْمَلِكُ: اخْتِمْ عَلَى خَيْرٍ وَيَقُولُ الشَّيْطَانُ: اخْتِمْ عَلَى شَرٍّ. فَإِنْ حَمِدَ اللَّهَ وَذَكَرَهُ نَحَّى الْمَلَكُ الشَّيْطَانَ وَحَفِظَهُ طُولَ لَيْلَتِهِ. فَإِذَا اسْتَيْقَظَ عُجِّلَ إِلَيْهِ الْمَلَكُ وَالشَّيْطَانُ فَقَالَا مِثْلَ ذَلِكَ. فَإِنْ ذَكَرَ اللَّهَ وَقَالَ: الْحَمْدُ لِلَّهِ الَّذِي رَدَّ عَلَيَّ رُوحِي بَعْدَ مَوْتِهَا وَلَمْ يُمِتْهَا فِي مَنَامِهَا الْحَمْدُ لِلَّهِ الَّذِي يُمْسِكُ السَّمَاوَاتِ وَالْأَرْضَ أَنْ تَزُولَا وَلَئِنْ زَالَتَا إِنْ أَمْسَكَهُمَا مِنْ أَحَدٍ مِنْ بَعْدِهِ إِنَّهُ كَانَ حَلِيمًا غَفُورًا الْحَمْدُ لِلَّهِ الَّذِي يُمْسِكُ السَّمَاءَ أَنْ تَقَعَ عَلَى الْأَرْضِ إِلَّا بِإِذْنِهِ إِنَّهُ كَانَ بِالْعِبَادِ رَحِيمًا رَؤُوفًا. فَإِنْ مَاتَ مَاتَ شَهِيدًا وَإِنْ قَامَ فَصَلَّى صَلَاةً عَظِيمَةَ الْفَضْلِ.","Da'if","Al-Adab Al-Mufrad 1220","","","كتاب النوم والمبيت"
"1221","عَنِ الْبَرَاءِ رَضِيَ اللَّهُ عَنْهُ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا أَرَادَ أَنْ يَنَامَ وَضَعَ يَدَهُ تَحْتَ خَدِّهِ الْأَيْمَنِ وَقَالَ: اللَّهُمَّ قِنِي عَذَابَكَ يَوْمَ تَبْعَثُ عِبَادَكَ. وَرُوِيَ عَنِ الْبَرَاءِ مِنْ وَجْهٍ آخَرَ نَحْوُهُ.","Sahih","Al-Adab Al-Mufrad 1221","","","كتاب النوم والمبيت"
"1222","عن عبد الله بن عمرو رضي الله عنهما أن النبي صلى الله عليه وسلم قال: \ما من مسلم يُداوم على ركعتين من الضحى إلا أحبهما الله\"". قالوا: يا رسول الله، وما هما؟ قال: \""يسبح أحدكم في دبر كل صلاة عشر تسبيحات، وعشر حمَدات، وعشر تكبيرات، فتلك مائة وخمسون على اللسان، وألف وخمسمائة في الميزان\"". قال: فجعل صلى الله عليه وسلم يعدهن بيده. قال: ثم يضطجع فيُسبّح ثلاثاً وثلاثين، ويحمد ثلاثاً وثلاثين، ويكبر أربعاً وثلاثين، فتلك مائة على اللسان، وألف في الميزان. \""فأيكم يعمل في اليوم والليلتين خمسمائة سيئة؟\"" قالوا: يا رسول الله، كيف لا يُطبّق أحدهم هذا؟ قال: \""إن الشيطان يأتي أحدكم في صلاته فيُذكّره حاجات الدنيا، فلا يذكر التسبيح\"".""","Sahih","Al-Adab Al-Mufrad 1222","","","كتاب النوم والمبيت"
"1223","عن أبي هريرة رضي الله عنه أن النبي صلى الله عليه وسلم قال: \إذا أتى أحدكم فراشه فليأخذ كفة إزاره فلينفض بها فراشه وليُسمّ الله، فإنه لا يدري ما خلّفه على فراشه بعده. ثم ليضطجع على شقه الأيمن ثم ليقل: سبحانك اللهم وبحمدك، أجرت نفسي، ورفعت جَنبي، وتوفّني في مضجعي. اللهم إن قبضت نفسي فاغفر لها، وإن أبقيتها فاحفظها بما تحفظ به عبادك الصالحين\"".""","Sahih","Al-Adab Al-Mufrad 1223","","","كتاب النوم والمبيت"
"1224","عن ربيعة بن كعب رضي الله عنه قال: كنت أبيت على باب النبي صلى الله عليه وسلم أسمعه إذا تهجّد يقول: \سمع الله لمن حمده\""، وأسمعه إذا انصرف من صلاته يقول: \""الحمد لله رب العالمين\"".""","Sahih","Al-Adab Al-Mufrad 1224","","","كتاب النوم والمبيت"
"1225","عن ابن عباس رضي الله عنهما أن النبي صلى الله عليه وسلم قال: \من نام وفي يده غمر ولم يغسله فأصابه شيء فلا يلومنّ إلا نفسه\"".""","Sahih","Al-Adab Al-Mufrad 1225","","","كتاب النوم والمبيت"
"1226","عن أبي هريرة رضي الله عنه أن النبي صلى الله عليه وسلم قال: \من نام وفي يده غمر فأصابه شيء فلا يلومنّ إلا نفسه\"".""","Sahih","Al-Adab Al-Mufrad 1226","","","كتاب النوم والمبيت"
"1227","عن جابر بن عبد الله رضي الله عنه أن رسول الله صلى الله عليه وسلم قال: \أغلقوا الأبواب بالليل، وأوكوا القرب، وأكفئوا الآنية أو غطوها، وأطفئوا المصابيح، فإن الشيطان لا يفتح باباً مغلقاً، ولا يحل وكاءً، ولا يكشف غطاءً، وإن الفويسقة هي التي تحرق بيت القوم.""""""","Sahih","Al-Adab Al-Mufrad 1227","","","كتاب النوم والمبيت"
"1228","عن ابن عباس رضي الله عنهما قال: جاءت فأرة فجعلت تسحب الفتيلة، فذهبت الجارية تكفها، فقال النبي صلى الله عليه وسلم: \دعوها.\"" فأتت بالفتيلة فألقتها على البساط الذي كان عليه رسول الله صلى الله عليه وسلم فاحترق منه موضع درهم، فقال رسول الله صلى الله عليه وسلم: \""إذا نمتم فأطفئوا مصابيحكم، فإن الشيطان يدل مثل هذا على هبلكم فتحرقكم.""""""","Sahih","Al-Adab Al-Mufrad 1228","","","كتاب النوم والمبيت"
"1229","عن أبي سعيد رضي الله عنه قال: بات النبي صلى الله عليه وسلم ساهراً، فأبصر فأرة تحمل فتيلة تصعد بها السطح لتوقد عليهم البيت، فلعنها النبي صلى الله عليه وسلم وأحل قتلها في الحرم.","Da'if","Al-Adab Al-Mufrad 1229","","","كتاب النوم والمبيت"
"1230","عن ابن عمر رضي الله عنهما أن النبي صلى الله عليه وسلم قال: \لا تتركوا النار في بيوتكم حين تنامون.""""""","Sahih","Al-Adab Al-Mufrad 1230","","","كتاب النوم والمبيت"
"1231","عن عمر رضي الله عنه قال: \إن النار عدو فاحذروها.\"" فكان ابن عمر رضي الله عنهما يتعاهد النار في بيته ويطفئها قبل أن ينام.""","Sahih","Al-Adab Al-Mufrad 1231","","","كتاب النوم والمبيت"
"1232","عن ابن عمر رضي الله عنهما قال: سمعت النبي صلى الله عليه وسلم يقول: «لا تُتركوا النار في بيوتكم توقّد بالليل فإنها عدوّ لكم.»","Sahih","Al-Adab Al-Mufrad 1232","","","كتاب النوم والمبيت"
"1233","عن أبي موسى رضي الله عنه قال: احترق بيت بالمدينة الطيبة في الليل مع أهله، فذُكر ذلك للنبي صلى الله عليه وسلم فقال: «هذه النار عدوّ لكم، فإذا نمتم فأطفئوها.»","Sahih","Al-Adab Al-Mufrad 1233","","","كتاب النوم والمبيت"
"1234","عن ابن عباس رضي الله عنه قال: كان إذا نزل المطر قال: يا جارية أخرجي سرجي وثيابي، ويقرأ: «وَأَنزَلْنَا مِنَ السَّمَاءِ مَاءً مُبَارَكًا.»","Sahih","Al-Adab Al-Mufrad 1234","","","كتاب النوم والمبيت"
"1235","عن ابن عباس رضي الله عنهما قال: أمر النبي صلى الله عليه وسلم أن يُعلَّق القذر في البيت.","Sahih","Al-Adab Al-Mufrad 1235","","","كتاب النوم والمبيت"
"1236","عن جابر بن عبد الله رضي الله عنه أن رسول الله صلى الله عليه وسلم قال: «إذا كان الليل فاسكنوا ولا تمشوا، فإنه لا يدري أحدكم ما يُسيّر الله من خلقه، وأغلقوا الأبواب وأوكوا القرب وغطّوا الأواني وأطفئوا السرُج.»","Hasan","Al-Adab Al-Mufrad 1236","","","كتاب النوم والمبيت"
