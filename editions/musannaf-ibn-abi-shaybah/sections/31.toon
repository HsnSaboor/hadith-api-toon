hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"30061","(۳۰۰۶۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن یُونُسَ ، عَن حُمَیْدِ بْنِ ہِلالٍ ، عَنْ أَبِی بُرْدَۃَ ، قَالَ : جَلَسْت إِلَی شَیْخٍ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَسْجِدِ الْکُوفَۃِ فَحَدَّثَنِی ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَوْ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا أَیُّہَا النَّاسُ ، تُوبُوا إِلَی اللہِ وَاسْتَغْفِرُوہُ فَإِنِّی أَتُوبُ إِلَی اللہِ وَأَسْتَغْفِرُ فِی کُلِّ یَوْمٍ مِئَۃ مَرَّۃٍ ، قَالَ : قُلْتُ : اللَّہُمَّ إنِّی أَسْتَغْفِرُک اثْنَتَیْنِ ، قَالَ : ہُوَ مَا أَقُولُ لَک۔ (نسائی ۱۰۲۷۸۔ احمد ۲۶۰)","Sahih","Musannaf Ibn Abi Shaybah 30061","","","كتاب الدعاء"
"30062","(۳۰۰۶۲) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ رَجُلٍ ، عَن مُعَاذِ بْنِ جَبَلٍ ، قَالَ : مَنْ قَا[corrupt]َ أَسْتَغْفِرُ اللَّہَ الَّذِی لاَ إلَہَ إِلاَّ ہُوَ الْحَیُّ الْقَیُّومُ وَأَتُوبُ إلَیْہِ ثَلاثًا غُفِرَ لَہُ ، وَإِنْ کَانَ فَرَّ مِنَ الزَّحْفِ۔","Da'if","Musannaf Ibn Abi Shaybah 30062","","","كتاب الدعاء"
"30063","(۳۰۰۶۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی سِنَانٍ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، قَالَ : مَنْ قَالَ أَسْتَغْفِرُ اللَّہَ الَّذِی لاَ إلَہَ إِلاَّ ہُوَ الْحَیُّ الْقَیُّومُ وَأَتُوبُ إلَیْہِ ثَلاثًا غُفِرَ لَہُ ، وَإِنْ کَانَ فَرَّ مِنَ الزَّحْفِ۔","Sahih","Musannaf Ibn Abi Shaybah 30063","","","كتاب الدعاء"
"30064","(۳۰۰۶۴) حَدَّثَنَا أَبُو دَاوُدَ الْحَفَرِیُّ عُمَرُ بْنُ سَعْدٍ ، عَن یُونُسَ بْنِ الْحَارِثِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : مَنْ قَالَ سُبْحَانَ اللہِ الْعَظِیمِ وَبِحَمْدِہِ غُرِسَ لَہُ بِہَا نَخْلَۃٌ فِی الْجَنَّۃِ۔ n(طبرانی ۳۵۲۔ احمد ۲۳۹)","Da'if","Musannaf Ibn Abi Shaybah 30064","","","كتاب الدعاء"
"30065","حدثنا أبو عبد الرحمن قَالَ حدثنا أبو بکر بن أبی شیبۃ قَالَ :n(۳۰۰۶۵) حَدَّثَنَا سُلَیْمَانُ بْنُ حَیَّانَ حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن یَحْیَی بْنِ سَعِیدٍ، عَنْ أَبِی الزُّبَیْرِ، عَن طَاوُوس، عَن مُعَاذٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا عَمِلَ ابْنُ آدَمَ عَمَلاً أَنْجَی لَہُ مِنَ النَّارِ مِنْ ذِکْرِ اللہِ ، قَالُوا : یَا رَسُولَ اللہِ ، وَلا الْجِہَادُ فِی سَبِیلِ اللہِ ؟ قَالَ : وَلا الْجِہَادُ فِی سَبِیلِ اللہِ ، إلاَّ أن تَضْرِبَ بِسَیْفِکَ حَتَّی یَنْقَطِعَ ، ثُمَّ تَضْرِبُ بہ حَتَّی یَنْقَطِعَ ، ثُمَّ تَضْرِبُ بِہِ حَتَّی یَنْقَطِعَ۔","","Musannaf Ibn Abi Shaybah 30065","","","كتاب الدعاء"
"30066","(۳۰۰۶۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، أَخْبَرَنَا مُعَاوِیَۃُ بْنُ صَالِحٍ ، قَالَ : أَخْبَرَنِی عَمْرُو بْنُ قَیْسٍ الْکِنْدِیُّ ، عَنْ عَبْدِ اللہِ بْنِ بُسْرٍ ، أَنَّ أَعْرَابِیًّا ، قَالَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا رَسُولَ اللہِ ، إنَّ شَرَائِعَ الإِسْلامِ قَدْ کَثُرَتْ ، فَأَنْبِئْنِی فیہ بِأَمْرٍ أَتَشَبَّثُ بِہِ ، قَالَ : لاَ یَزَالُ لِسَانُک رَطْبًا بِذِکْرِ اللہِ۔ (ترمذی ۲۳۲۹۔ احمد ۱۸۸)","Sahih","Musannaf Ibn Abi Shaybah 30066","","","كتاب الدعاء"
"30067","(۳۰۰۶۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن دَاوُد ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ أَبِی أَیُّوبَ الأَنْصَارِیِّ ، عَن رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ قَالَ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ بِیَدِہِ الْخَیْرُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ عَشْرَ مَرَّاتٍ ، کُنْ لَہُ کَعَدْلِ عَشْرِ رَقَباتٍ ، أَوْ رَقَبَۃٍ۔ (مسلم ۲۰۷۱۔ احمد ۴۲۲)","Shadh","Musannaf Ibn Abi Shaybah 30067","","","كتاب الدعاء"
"30068","(۳۰۰۶۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن لَیْثٍ ، عَن طَلْحَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَۃَ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَالَ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ ، وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، کَانَ کَعِتْقِ رَقَبَۃٍ۔ (احمد ۲۸۵۔ حاکم ۵۰۱)","Da'if","Musannaf Ibn Abi Shaybah 30068","","","كتاب الدعاء"
"30069","(۳۰۰۶۹) حَدَّثَنَا ہُشَیْمٌ ، عَن یَعْلَی بْنِ عَطَائٍ ، عَن بِشْرِ بْنِ عَاصِمٍ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، قَالَ : ذِکْرُ اللہِ بِالْغَدَاۃِ وَالْعَشِیِّ أَعْظَمُ مِنْ حَطْمِ السُّیُوفِ فِی سَبِیلِ اللہِ ، وَإِعْطَائِ الْمَالِ سَحًّا۔","Da'if","Musannaf Ibn Abi Shaybah 30069","","","كتاب الدعاء"
"30070","(۳۰۰۷۰) حَدَّثَنَا یَحْیَی بْنُ وَاضِحٍ ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ اللہِ الْقَرَّاظِ ، عَن مُعَاذِ بْنِ جَبَلٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَحَبَّ أَنْ یَرْتَعَ فِی رِیَاضِ الْجَنَّۃِ فَلْیُکْثِرْ ذِکْرَ اللہِ۔ (طبرانی ۳۲۶)","Da'if","Musannaf Ibn Abi Shaybah 30070","","","كتاب الدعاء"
"30071","(۳۰۰۷۱) حَدَّثَنَا وَکِیعٌ، عَن مِسْعَرٍ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ، عَنِ ابْنِ سَابِطٍ، عَن مُعَاذٍ، قَالَ: لأَنْ أَذْکُرَ اللَّہَ مِنْ غُدْوَۃٍ حَتَّی تَطْلُعَ الشَّمْسُ أَحَبُّ إلَیَّ مِنْ أَنْ أُحْمَلَ عَلَی الْجِہَادِ فِی سَبِیلِ اللہِ مِنْ غُدْوَۃٍ حَتَّی تَطْلُعَ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 30071","","","كتاب الدعاء"
"30072","(۳۰۰۷۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، حَدَّثَنَا مُعَاوِیَۃُ ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ جُبَیْرِ بْنِ نُفَیْرٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : إنَّ الَّذِینَ لاَ تَزَالُ أَلْسِنَتُہُمْ رَطْبَۃً مِنْ ذِکْرِ اللہِ یَدْخُلُونَ الْجَنَّۃَ وَہُمْ یَضْحَکُونَ۔","Hasan","Musannaf Ibn Abi Shaybah 30072","","","كتاب الدعاء"
"30073","(۳۰۰۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا مِسْعَرٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَن ہِلالِ بْنِ یَِسَافٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ، عَنِ الرَّبِیعِ بْنِ خُثَیْمٍ ، عَنْ عَبْدِ اللہِ ، قَالَ: مَنْ قَالَ عَشْرَ مَرَّاتٍ: لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، کُنَّ لہ کَعَدْلِ أَرْبَعِ رِقَابٍ ، أُرَاہُ قَالَ : مِنْ وَلَدِ إسْمَاعِیلَ۔","Sahih","Musannaf Ibn Abi Shaybah 30073","","","كتاب الدعاء"
"30074","(۳۰۰۷۴) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَن ہِلالٍ ، عَن أُمِّ الدَّرْدَائِ قَالَتْ : مَنْ قَالَ مِئَۃ مَرَّۃٍ غَدْوَۃً وَمِئَۃَ مَرَّۃٍ عَشِیَّۃً : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، لَمْ یَجِئْ أَحَدٌ یَوْمَ الْقِیَامَۃِ بِمِثْلِ مَا جَائَ بِہِ إِلاَّ مَنْ قَالَ مِثْلَہُنَّ ، أَوْ زَادَ۔","","Musannaf Ibn Abi Shaybah 30074","","","كتاب الدعاء"
"30075","(۳۰۰۷۵) حَدَّثَنَا شَرِیکٌ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ مُعَاذُ بْنُ جَبَلٍ : لَوْ أَنَّ رَجُلَیْنِ یَحْمِلُ أَحَدُہُمَا عَلَی الْجِیَادِ فِی سَبِیلِ اللہِ وَالآخَرُ یَذْکُرُ اللَّہَ لَکَانَ أَفْضَلَ ، أَوْ أَعْظَمَ أَجْرًا الذَّاکِرُ۔","","Musannaf Ibn Abi Shaybah 30075","","","كتاب الدعاء"
"30076","(۳۰۰۷۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَن مُفَضَّلٍ ، عَن مَنْصُورٍ ، عَن مُجَاہِدٍ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الحارث بن ہِشَامٍ ، عَن کَعْبٍ ، قَالَ : قَالَ مُوسَی : یَا رَبِّ دُلَّنِی عَلَی عَمَلٍ إذَا عَمِلْتہ کَانَ شُکْرًا لَکَ فِیمَا اصْطَنَعْت إلَیَّ ، قَالَ : یَا مُوسَی قُلْ : لاَ إلَہَ إِلاَّ اللَّہُ ، أَوْ قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، قَالَ : فَکَأَنَّ مُوسَی أَرَادَ مِنَ الْعَمَلِ مَا ہُوَ أَنْہَکُ لِجِسْمِہِ مِمَّا أُمِرَ بِہِ ، قَالَ : فَقَالَ لَہُ : یَا مُوسَی لَوْ أَنَّ السَّمَاوَاتِ السَّبْعَ وَالأَرْضِینَ السَّبْعَ وُضِعَتْ فِی کِفَّۃٍ ، وَوُضِعَتْ لاَ إلَہَ إِلاَّ اللَّہُ فِی کِفَّۃٍ لَرَجَحَتْ بِہِنَّ۔","","Musannaf Ibn Abi Shaybah 30076","","","كتاب الدعاء"
"30077","(۳۰۰۷۷) حَدَّثَنَا شَرِیکٌ ، عَنِ الأَعْمَشِ ، عَن سَالِمٍ ، قَالَ ، قِیلَ لأَبِی الدَّرْدَائِ : إنَّ أَبَا سَعْدِ بْنَ مُنَبِّہٍ جَعَلَ فِی مَالِہِ مِئَۃ مُحَرَّرَۃً ، فَقَالَ : إنَّ مِئَۃ مُحَرَّرَۃً فِی مَالِ رَجُلٍ لَکَثِیرٌ ، أَلا أُخْبِرُکُمْ بِأَفْضَلَ مِنْ ذَلِکَ ، إیمَانًا بلْزُومِ اللَّیْلِ وَالنَّہَارِ ، وَلا یَزَالُ لِسَانُک رَطْبًا مِنْ ذِکْرِ اللہِ۔","","Musannaf Ibn Abi Shaybah 30077","","","كتاب الدعاء"
"30078","(۳۰۰۷۸) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَن مُسْلِمٍ ، عَن سُوَیْد بْنِ جُہَیْلٍ ، قَالَ : مَنْ قَالَ بَعْدَ الْعَصْرِ : لاَ إلَہَ إِلاَّ اللَّہُ لَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، قَاتَلْنَ عَن قَائِلِہَا إِلَی مِثْلِہَا مِنَ الْغَدِ۔","","Musannaf Ibn Abi Shaybah 30078","","","كتاب الدعاء"
"30079","(۳۰۰۷۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَن مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَن مُسْلِمٍ مَوْلَی سُوَیْد بْنِ جُہَیْلٍ ، عَن سُوَیْد ، قَالَ : کَانَ مِنْ أَصْحَابِ عُمَرَ ، ثُمَّ ذَکَرَ نَحْوَ حَدِیثِ وَکِیعٍ۔","","Musannaf Ibn Abi Shaybah 30079","","","كتاب الدعاء"
"30080","(۳۰۰۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ حَدَّثَنَا مِسْعَرٌ ، عَن سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی عُبَیْدَۃَ ، قَالَ : الْعَبْدُ مَا ذُکِرَ اللَّہَ ، فَہُوَ فِی صَلاۃٍ۔","","Musannaf Ibn Abi Shaybah 30080","","","كتاب الدعاء"
"30081","(۳۰۰۸۱) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَن سَالِمٍ ، عَن مَسْرُوقٍ ، قَالَ : مَا دَامَ قَلْبُ الرَّجُلِ یَذْکُرُ اللَّہَ ، فَہُوَ فِی صَلاۃٍ ، وَإِنْ کَانَ فِی السُّوقِ۔","","Musannaf Ibn Abi Shaybah 30081","","","كتاب الدعاء"
"30082","(۳۰۰۸۲) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَن ہِلالٍ عَن أَبِی عُبَیْدَۃَ قَالَ : مَا دَامَ قَلْبُ الرَّجُلِ یَذْکُرُ اللہ ، فَہُوَ فِی صَلاۃٍ ، وَإِنْ کَانَ فِی السُّوقِ ، وَإِنْ یُحَرِّکْ بِہِ شَفَتَیْہِ ، فَہُوَ أَفْضَلُ۔","","Musannaf Ibn Abi Shaybah 30082","","","كتاب الدعاء"
"30083","(۳۰۰۸۳) حَدَّثَنَا مَرْحُومُ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ أَبِی نَعَامَۃَ السَّعْدِیِّ ، عَنْ أَبِی عُثْمَانَ النَّہْدِیِّ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : خَرَجَ مُعَاوِیَۃُ عَلَی حَلْقَۃٍ فِی الْمَسْجِدِ فَقَالَ : مَا أَجْلَسَکُمْ قَالُوا : جَلَسْنَا نَذْکُرُ اللَّہَ وَنَحْمَدُہُ عَلَی مَا ہَدَانَا لِلإِسْلامِ وَمَنَّ عَلَیْنَا بِہِ ، قَالَ : آللہِ مَا أَجْلَسَکُمْ إِلاَّ ذَاکَ ، قَالُوا : وَاللہِ مَا أَجْلَسَنَا إِلاَّ ذَاکَ ، فَقَالَ : أَمَّا إنِّی لَمْ أَسْتَحْلِفْکُمْ تُہْمَۃً لَکُمْ ، وَمَا مِنْ أَحَدٍ بِمَنْزِلَۃٍ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَقَلَّ عَنْہُ حَدِیثًا مِنِّی ، وَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَرَجَ عَلَی حَلْقَۃٍ مِنْ أَصْحَابِہِ فَقَالَ : مَا أَجْلَسَکُمْ ؟ فَقَالُوا : جَلَسْنَا نَذْکُرُ اللَّہَ وَنَحْمَدُہُ عَلَی مَا ہَدَانَا لِلإِسْلامِ وَمَنَّ عَلَیْنَا بِہِ ، قَالَ : آللہِ مَا أَجْلَسَکُمْ إِلاَّ ذَاکَ ، قَالُوا : وَاللہِ مَا أَجْلَسَنَا إِلاَّ ذَاکَ ، فَقَالَ : أَمَّا إنِّی لَمْ أَسْتَحْلِفْکُمْ تُہْمَۃً لَکُمْ وَلَکِنِّی أَتَانِی جِبْرِیلُ فَأَخْبَرَنِی ، أَنَّ اللَّہَ یُبَاہِی بِکُمَ الْمَلائِکَۃَ۔ (مسلم ۲۰۷۵۔ ترمذی ۳۳۷۹)","Sahih","Musannaf Ibn Abi Shaybah 30083","","","كتاب الدعاء"
"30084","(۳۰۰۸۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَن مُحَمَّدِ بْنِ إبْرَاہِیمَ ، قَالَ : قَالَ عبَادَۃُ بْنُ الصَّامِتِ : لأَنْ أَکُونَ فِی قَوْمٍ یَذْکُرُونَ اللَّہَ مِنْ حِینَ یُصَلُّونَ الْغَدَاۃَ إِلَی حِینَ تَطْلُعُ الشَّمْسُ أَحَبُّ إلَیَّ مِنْ أَنْ أَکُونَ عَلَی مُتُونِ الْخَیْلِ أُجَاہِدُ فِی سَبِیلِ اللہِ إِلَی أَنْ تَطْلُعَ الشَّمْسُ ، وَلأَنْ أَکُونَ فِی قَوْمٍ یَذْکُرُونَ مِنْ حِینَ یُصَلُّونَ الْعَصْرَ حَتَّی تَغْرُبَ الشَّمْسُ أَحَبُّ إلَیَّ مِنْ أَنْ أَکُونَ عَلَی مُتُونِ الْخَیْلِ أُجَاہِدُ فِی سَبِیلِ اللہِ حَتَّی تَغْرُبَ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 30084","","","كتاب الدعاء"
"30085","(۳۰۰۸۵) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَن سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، عَن سَلْمَانَ ، قَالَ : لَوْ بَاتَ رَجُلٌ یُعْطِی الْقنَان الْبِیضَ وَبَاتَ آخَرُ یَقْرَأُ الْقُرْآنَ أَوْ یَذْکُرُ اللَّہَ تعالی لَرَأَیْت أَنَّ ذَلِکَ ، أَوْ قَالَ : أَنَّ ذَاکِرَ اللہِ أَفْضَلُ۔","Sahih","Musannaf Ibn Abi Shaybah 30085","","","كتاب الدعاء"
"30086","(۳۰۰۸۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَبِی ہِلالٍ ، عَنْ أَبِی الْوَازِعِ جَابِرٍ الرَّاسِی ، عَنْ أَبِی بَرْزَۃَ ، قَالَ : لَوْ أَنَّ رَجُلَیْنِ أَحَدُہُمَا فِی حِجْرِہِ دَنَانِیرَ یُعْطِیہَا ، وَالآخَرُ یَذْکُرُ اللَّہَ ، کَانَ ذَاکِرُ اللہِ أَفْضَلَ۔","Hasan","Musannaf Ibn Abi Shaybah 30086","","","كتاب الدعاء"
"30087","(۳۰۰۸۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا مِسْعَرٌ ، قَالَ : حدَّثَنِی ثَعْلَبَۃُ بْنُ عَمْرٍو ، عَنْ عَمْرِو بْنِ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : لَوْ أَنَّ رَجُلَیْنِ أَقْبَلَ أَحَدُہُمَا مِنَ الْمَشْرِقِ وَالآخَرُ مِنَ الْمَغْرِبِ ، مَعَ أَحَدِہِمَا ذَہَبٌ لاَ یَضَعُ مِنْہُ شَیْئًا إِلاَّ فِی حَقٍّ وَالآخَرُ یَذْکُرُ اللَّہَ حَتَّی یَلْتَقِیَا فِی طَرِیقٍ کَانَ الَّذِی یَذْکُرُ اللَّہَ أَفْضَلَہُمَا۔","","Musannaf Ibn Abi Shaybah 30087","","","كتاب الدعاء"
"30088","(۳۰۰۸۸) حَدَّثَنَا شَرِیکٌ ، عَن مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : مَا مِنْ شَیْئٍ أَحَبَّ إلی اللہ مِنَ الشُّکْرِ وَالذِّکْرِ۔","","Musannaf Ibn Abi Shaybah 30088","","","كتاب الدعاء"
"30089","(۳۰۰۸۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، حَدَّثَنَا عَمَّارُ بْنُ رُزَیْقٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَغَرِّ أَبِی مُسْلِمٍ، عَنْ أَبِی ہُرَیْرَۃَ، وَأَبِی سَعِیدٍ یَشْہَدَانِ بِہِ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ قَالَ: مَا جَلَسَ قَوْمٌ مُسْلِمُونَ مَجْلِسًا یَذْکُرُونَ اللَّہَ فِیہِ إِلاَّ حَفَّتْہُمُ الْمَلائِکَۃُ وَتَغَشَّتْہُمُ الرَّحْمَۃُ ، وَنَزَلَتْ عَلَیْہِمُ السَّکِینَۃُ ، وَذَکَرَہُمَ اللَّہُ فِیمَنْ عِنْدَہُ۔ (ترمذی ۳۳۷۸۔ ابن ماجہ ۳۷۹۱)","Sahih","Musannaf Ibn Abi Shaybah 30089","","","كتاب الدعاء"
"30090","(۳۰۰۹۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، أَخْبَرَنِی مَالِکُ بْنُ أَنَسٍ ، قَالَ : أَخْبَرَنِی سُمِیٌّ مَوْلَی أَبِی بَکْرٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَالَ فِی یَوْمٍ مِئَۃ مَرَّۃٍ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، کَانَ لَہُ کَعَدْلِ عَشْرِ رِقَابٍ ، وَکُتِبَتْ لَہُ مِئَۃ حَسَنَۃٍ ، وَمُحِیَ عَنْہُ مِئَۃ سَیِّئَۃٍ ، وَکَانت لَہُ حِرْزًا مِنَ الشَّیْطَانِ سَائِرَ یَوْمہ إِلَی اللَّیْلِ ، وَلَمْ یَأْتِ أَحَدٌ بِأَفْضَلَ مِمَّا أَتَی بِہِ إِلاَّ مَنْ قَالَ أَکْثَرَ۔ (بخاری ۳۲۹۳۔ مسلم ۲۰۷۱)","Sahih","Musannaf Ibn Abi Shaybah 30090","","","كتاب الدعاء"
"30091","(۳۰۰۹۱) حَدَّثَنَا عَفَّانُ حَدَّثَنَا أَبَانُ بْنُ یَزِیدَ الْعَطَّارُحَدَّثَنَا قَتَادَۃُ ، قَالَ : حدَّثَ أَبُو الْعَالِیَۃِ الرِّیَاحِیُّ ، عَن حَدِیثِ سُہَیْلِ بْنِ حَنْظَلَۃَ الْعَبْشَمِیِّ ، أَنَّہُ قَالَ : مَا اجْتَمَعَ قَوْمٌ قط یَذْکُرُونَ اللَّہَ إِلاَّ نَادَی مُنَادٍ مِنَ السَّمَائِ : قُومُوا مَغْفُورًا لَکُمْ ، قَدْ بُدِّلَتْ سَیِّئَاتُکُمْ حَسَنَاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30091","","","كتاب الدعاء"
"30092","(۳۰۰۹۲) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ مَنْصُورٍ ، عَن ہِلالِ بْنِ یَِسَافٍ ، قَالَ : کَانَتِ امْرَأَۃٌ مِنْ ہَمْدَانَ تُسَبِّحُ وَتُحْصِیہِ بِالْحَصْباء ، أَوِ النَّوَی فَمَرَّتْ عَلَی عَبْدِ اللہِ ، فَقِیلَ لَہُ : ہَذِہِ الْمَرْأَۃُ تُسَبِّحُ وَتُحْصِیہِ بِالْحَصَی ، أَوِ النَّوَی ، فَدَعَاہَا فَقَالَ : لَہَا : أَنْتِ الَّتِی تُسَبِّحِینَ وَتُحْصِینَ ؟ فَقَالَتْ : نَعَمْ إنِّی لأَفْعَلُ ، فَقَالَ : أَلا أَدُلُّک عَلَی خَیْرٍ مِنْ ذَلِکَ ، تَقُولِینَ : اللَّہُ أَکْبَرُ کَبِیرًا ، وَالْحَمْدُ للہِ کَثِیرًا ، وَسُبْحَانَ اللہِ بُکْرَۃً وَأَصِیلاً۔","Sahih","Musannaf Ibn Abi Shaybah 30092","","","كتاب الدعاء"
"30093","(۳۰۰۹۳) حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الأَغَرِّ أَبِی مُسْلِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِیمَا یُحَدِّثُ ، عَن رَبِّہِ ، قَالَ : مَنْ ذَکَرَنِی فِی نَفْسِہِ ذَکَرْتہ فِی نَفْسِی ، وَمَنْ ذَکَرَنِی فِی مَلأٍ مِنَ النَّاسِ ذَکَرْتہ فِی مَلأٍ أَکثر مِنْہُمْ وَأَطْیَبَ۔ (احمد ۳۵۴۔ ابن حبان ۳۲۸)","Sahih","Musannaf Ibn Abi Shaybah 30093","","","كتاب الدعاء"
"30094","(۳۰۰۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، عَن سَلْمَانَ ، قَالَ : إذَا کَانَ الْعَبْدُ یَحْمَدُ اللَّہَ فِی السَّرَّائِ وَیَحْمَدُہُ فِی الرَّخَائِ فَأَصَابَہُ ضُرٌّ فَدَعَا اللَّہَ قَالَتِ الْمَلائِکَۃُ : صَوْتٌ مَعْرُوفٌ مِنَ امْرِئٍ ضَعِیفٍ فَیَشْفَعُونَ لَہُ وَإِذَا کَانَ الْعَبْدُ لاَ یَذْکُرُ اللَّہَ فِی السَّرَّائِ ، وَلا یَحْمَدُہُ فِی الرَّخَائِ فَأَصَابَہُ ضُرٌّ فَدَعَا اللَّہَ قَالَتِ الْمَلائِکَۃُ : صَوْتٌ مُنْکَرٌ۔","Sahih","Musannaf Ibn Abi Shaybah 30094","","","كتاب الدعاء"
"30095","(۳۰۰۹۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الأَصْبَغِ بْنِ زَیْدٍ ، عَن ثَوْرٍ ، عَن خَالِدِ بْنِ مَعْدَانَ ، قَالَ : إنَّ اللَّہَ یَتَصَدَّقُ کُلَو یَوْمٍ بِصَدَقَۃٍ فَمَا تَصَدَّقَ عَلَی عَبْدِہِ بِشَیْئٍ أَفْضَلَ مِنْ ذِکْرِہِ۔","","Musannaf Ibn Abi Shaybah 30095","","","كتاب الدعاء"
"30096","(۳۰۰۹۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَنْ قَالَ فِی یَوْمٍ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ ، وَلَہُ الْحَمْدُ ، وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، کُنَّ لَہُ عَدْلَ أَرْبَعِ رَقَابات یُعْتِقُہُنَّ مِنْ وَلَدِ إسْمَاعِیلَ۔","Sahih","Musannaf Ibn Abi Shaybah 30096","","","كتاب الدعاء"
"30097","(۳۰۰۹۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ، عَن زَائِدَۃَ، عَن مَنْصُورٍ، عَن طَلْحَۃَ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَۃَ، عَنِ الْبَرَائِ بْنِ عَازِبٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ قَالَ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، عَشْرَ مَرَّاتٍ کُنَّ لَہُ کَعَدْلِ نَسَمَۃٍ۔ (نسائی ۹۹۵۳۔ طبرانی ۱۷۱۷)","Sahih","Musannaf Ibn Abi Shaybah 30097","","","كتاب الدعاء"
"30098","(۳۰۰۹۸) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ حَدَّثَنَا إسْمَاعِیلُ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، عَنْ أَبِی رُعَافَۃَ رَجُلٌ مِنَ الأَنْصَارِ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : مَنْ قَالَ فِی الْیَوْمِ مِئَۃ مَرَّۃٍ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، لَمْ یَجِئْ أَحَدٌ مِنْ أَہْلِ الدُّنْیَا بِأَفْضَلَ مِمَّا جَائَ بِہِ إِلاَّ إنْسَانٌ یَزِیدُ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30098","","","كتاب الدعاء"
"30099","(۳۰۰۹۹) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، أَنَّ عُمَرَ خَرَجَ یَسْتَسْقِی فَصَعِدَ الْمِنْبَرَ فَقَالَ : {اسْتَغْفِرُوا رَبَّکُمْ إِنَّہُ کَانَ غَفَّارًا یُرْسِلِ السَّمَائَ عَلَیْکُمْ مِدْرَارًا وَیُمْدِدْکُمْ بِأَمْوَالٍ وَبَنِینَ وَیَجْعَلْ لَکُمْ جَنَّاتٍ وَیَجْعَلْ لَکُمْ أَنْہَارًا} وَ {اسْتَغْفِرُوا رَبَّکُمْ إِنَّہُ کَانَ غَفَّارًا} ثُمَّ نَزَلَ فَقِیلَ لَہُ : یَا أَمِیرَ الْمُؤْمِنِینَ ، لَوِ اسْتَسْقَیْت فَقَالَ : لَقَدْ طَلَبْت بِمَجَادِیحِ السَّمَائِ الَّتِی یُسْتَنْزَلُ بِہَا الْقَطْرُ۔","","Musannaf Ibn Abi Shaybah 30099","","","كتاب الدعاء"
"30100","(۳۰۱۰۰) حَدَّثَنَا وَکِیعٌ ، عَن عِیسَی بْنِ حَفْصٍ ، عَنْ عَطَائِ بْنِ أَبِی مَرْوَانَ ، عَنْ أَبِیہِ ، قَالَ : خَرَجْنَا مَعَ عُمَرَ بْنِ الْخَطَّابِ نَسْتَسْقِی فَمَا زَادَ عَلَی الاسْتِغْفَارِ۔","Hasan","Musannaf Ibn Abi Shaybah 30100","","","كتاب الدعاء"
"30101","(۳۰۱۰۱) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَن زَیْدِ الْعَمِّیِّ ، عَنْ أَبِی الصِّدِّیقِ النَّاجِی ، أَنَّ سُلَیْمَانَ بْنَ دَاوُد خَرَجَ بِالنَّاسِ یَسْتَسْقِی فَمَرَّ عَلَی نَمْلَۃٍ مُسْتَلْقِیَۃٍ عَلَی قَفَاہَا رَافِعَۃٍ قَوَائِمَہَا إِلَی السَّمَائِ وَہِیَ تَقُولُ ، اللَّہُمَّ إنَّا خَلْقٌ مِنْ خَلْقِکَ لَیْسَ لَنَا غِنًی عَن رِزْقِکَ ، فَإِمَّا أَنْ تَسْقِیَنَا وَإِمَّا أَنْ تُہْلِکَنَا، فَقَالَ: سُلَیْمَانُ لِلنَّاسِ: ارْجِعُوا، فَقَدْ سُقِیتُمْ بِدَعْوَۃِ غَیْرِکُمْ۔","","Musannaf Ibn Abi Shaybah 30101","","","كتاب الدعاء"
"30102","(۳۰۱۰۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن مُسْلِمٍ ، عَن مَسْرُوقٍ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَوِّذُ بِہَذِہِ الْکَلِمَاتِ : أَذْہِبِ الْبَأْسَ رَبَّ النَّاسِ وَاشْفِ أَنْتَ الشَّافِی لاَ شِفَائَ إِلاَّ شِفَاؤُک شِفَائً لاَ یُغَادِرُ سَقَمًا ، قَالَتْ : فَلَمَّا ثَقُلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَرَضِہِ الَّذِی مَاتَ فِیہِ أَخَذْت بِیَدِہِ فَجَعَلْتُ أَمْسَحُہَا وَأَقُولُہَا ، قَالَتْ : فَنَزَعَ یَدَہُ مِنْ یَدَیْ ، وَقَالَ : اللَّہُمَّ اغْفِرْ لِی وَأَلْحِقْنِی بِالرَّفِیقِ ، قَالَتْ : فَکَانَ ہَذَا آخِرَ مَا سَمِعْت مِنْ کَلامِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30102","","","كتاب الدعاء"
"30103","(۳۰۱۰۳) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ أَبِی الضُّحَی ، عَن مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِ حَدِیثِ أَبِی مُعَاوِیَۃَ إِلاَّ أَنَّہُ لَمْ یَقُلْ : فَلَمَّا ثَقُلَ۔ (مسلم ۱۷۲۲۔ ابن ماجہ ۳۵۲۰)","Sahih","Musannaf Ibn Abi Shaybah 30103","","","كتاب الدعاء"
"30104","(۳۰۱۰۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَن سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَن مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کان یَقُولُ لِلْمَرِیضِ : أَذْہِبَ الْبَأْسَ رَبَّ النَّاسِ وَاشْفِ أَنْتَ الشَّافِی لاَ شِفَائَ إِلاَّ شِفَاؤُک شِفَائً لاَ یُغَادِرُ سَقَمًا ، قَالَ سُفْیَانُ : فَذَکَرْتہ لِمَنْصُورٍ فَحَدَّثَنِی ، عَنْ إبْرَاہِیمَ ، عَن مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔ (بخاری ۵۷۵۰۔ مسلم ۱۷۲۲)","Sahih","Musannaf Ibn Abi Shaybah 30104","","","كتاب الدعاء"
"30105","(۳۰۱۰۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا دَخَلَ عَلَی مَرِیضٍ ، قَالَ : أَذْہِبِ الْبَأْسَ رَبَّ النَّاسِ وَاشْفِ أَنْتَ الشَّافِی لاَ شَافِیَ إِلاَّ أَنْتَ۔","Da'if","Musannaf Ibn Abi Shaybah 30105","","","كتاب الدعاء"
"30106","(۳۰۱۰۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ رَبِّہِ ، عَنْ عَمْرَۃَ ، عَنْ عَائِشَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ مِمَّا یَقُولُ لِلْمَرِیضِ ، بِبُزَاقِہِ بِإِصْبَعِہِ ، بِسْمِ اللہِ تُرْبَۃُ أَرْضِنَا بَرِیقَۃُ بَعْضِنَا یُشْفَی سَقِیمُنَا بِإِذْنِ رَبِّنَا۔","Sahih","Musannaf Ibn Abi Shaybah 30106","","","كتاب الدعاء"
"30107","(۳۰۱۰۷) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، عَن زِیَادِ بْنِ ثُوَیْبٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : دَخَلَ عَلَیَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا أَشْتَکِی ، فَقَالَ : أَلا أَرْقِیک بِرُقْیَۃٍ عَلَّمَنِیہَا جِبْرِیلُ : بِسْمِ اللہِ أَرْقِیک ، وَاللَّہُ یَشْفِیک مِنْ کُلِّ أَرِبٍ یُؤْذِیک ، وَمِنْ شَرِّ النَّفَّاثَاتِ فِی الْعُقَدِ وَمِنْ شَرِّ حَاسِدٍ إذَا حَسَدَ۔","Da'if","Musannaf Ibn Abi Shaybah 30107","","","كتاب الدعاء"
"30108","(۳۰۱۰۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن حَجَّاجٍ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ دَخَلَ عَلَی مَرِیضٍ لَمْ تَحْضُرْ وَفَاتُہُ فَقَالَ : أَسْأَلُ اللَّہَ الْعَظِیمِ رَبَّ الْعَرْشِ الْعَظِیمِ أَنْ یَشْفِیَک سَبْعَ مَرَّاتٍ شُفِیَ۔","","Musannaf Ibn Abi Shaybah 30108","","","كتاب الدعاء"
"30109","(۳۰۱۰۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ، قَالَ : أَخْبَرَنِی عُمَیْرُ بْنُ ہَانِئٍ ، قَالَ : سَمِعْتُ جُنَادَۃَ بْنَ أَبِی أُمِّیَّۃَ یَقُولُ : سَمِعْت عُبَادَۃَ بْنَ الصَّامِتِ یُحَدِّثُ ، عَن رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّ جِبْرِیلَ رَقَاہُ وَہُوَ یُوعَکُ فَقَالَ : بِسْمِ اللہِ أَرْقِیک مِنْ کُلِّ دَائٍ یُؤْذِیک مِنْ کُلِّ حَاسِدٍ إذَا حَسَدَ وَمِنْ کُلِّ عَیْنٍ ، وَاسْمُ اللہِ یَشْفِیک۔","Da'if","Musannaf Ibn Abi Shaybah 30109","","","كتاب الدعاء"
"30110","(۳۰۱۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، حَدَّثَنَا زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ ، حَدَّثَنَا سِمَاکٌ ، عَن مُحَمَّدِ بْنِ حَاطِبٍ ، قَالَ : تَنَاوَلْت قِدْرًا لَنَا فَاحْتَرَقَتْ یَدَیَّ فَانْطَلَقَتْ بِی أُمِّی إِلَی رَجُلٍ جَالِسٍ فِی الْجَبَّانَۃِ ، فَقَالَتْ لَہُ : یَا رَسُولَ اللہِ ، فَقَالَ : لَبَّیْکَ وَسَعْدَیْکَ ، ثُمَّ أَدْنَتْنِی مِنْہُ فَجَعَلَ یَنْفُثُ وَیَتَکَلَّمُ لاَ أَدْرِی مَا ہُوَ ، فَسَأَلْت أُمِّی بَعْدَ ذَلِکَ مَا کَانَ یَقُولُ ؟ قَالَتْ : کَانَ یَقُولُ : أَذْہِبِ الْبَأْسَ رَبَّ النَّاسِ وَاشْفِ أَنْتَ الشَّافِی لاَ شَافِیَ إِلاَّ أَنْتَ۔","Hasan","Musannaf Ibn Abi Shaybah 30110","","","كتاب الدعاء"
"30111","(۳۰۱۱۱) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَن مَنْصُورٍ ، عَنِ الْمِنْہَالِ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابن عباس أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُعَوِّذُ الْحَسَنَ وَالْحُسَیْنَ بِہَؤُلائِ الْکَلِمَاتِ : أُعِیذُکُمَا بِکَلِمَاتِ اللہِ التَّامَّۃِ مِنْ شَرِّ کُلِّ شَیْطَانٍ وَہَامَّۃٍ وَشَرِّ کُلِّ عَیْنٍ لامَّۃٍ ، قَالَ : وَکَانَ إبْرَاہِیمُ یُعَوِّذُ بِہَا إسْمَاعِیلَ وَإِسْحَاقَ۔","Sahih","Musannaf Ibn Abi Shaybah 30111","","","كتاب الدعاء"
"30112","(۳۰۱۱۲) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، حَدَّثَنَا سُفْیَانُ ، عَن مَنْصُورٍ ، عَنِ الْمِنْہَالِ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَوِّذُ الْحَسَنَ وَالْحُسَیْنَ ، ثُمَّ ذَکَرَ مِثْلَہُ إِلاَّ أَنَّہُ لَمْ یَقُلْ : وَشَرِّ۔","Sahih","Musannaf Ibn Abi Shaybah 30112","","","كتاب الدعاء"
"30113","(۳۰۱۱۳) حَدَّثَنَا وَکِیعٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَنْ عَلِیٍّ ، قَالَ : اشْتَکَیْت فَدَخَلَ عَلَیَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا أَقُولُ : اللَّہُمَّ إِنْ کَانَ أَجَلِی قَدْ حَضَرَ فَأَرِحْنِی ، وَإِنْ کَانَ مُتَأَخِّرًا فَاشْفِنِی ، أَوْ عَافِنِی ، وَإِنْ کَانَ بَلائً فَصَبِّرْنِی ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَیْفَ قُلْتَ ؟ قَالَ : فَقُلْتُ لَہُ ، فَمَسَحَنِی بِیَدِہِ ، ثم قَالَ : اللَّہُمَّ اشْفِہِ ، أَوْ عَافِہِ فَمَا اشْتَکَیْت ذَلِکَ الْوَجَعَ بَعْدُ۔","Hasan","Musannaf Ibn Abi Shaybah 30113","","","كتاب الدعاء"
"30114","(۳۰۱۱۴) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، حَدَّثَنَا زُہَیْرُ بْنُ مُحَمَّدٍ ، عَن یَزِیدَ بْنِ خُصَیْفَۃَ ، عَنْ عُمَرَ بْنِ عَبْدِ اللہِ بْنِ کَعْبٍ ، عَن نَافِعِ بْنِ جُبَیْرٍ، عَن عُثْمَانَ بْنِ أَبِی الْعَاصِ الثَّقَفِیِّ، قَالَ: قدِمْت عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَبِی وَجَعٌ قَدْ کَادَ یبطلنی ، فَقَالَ لی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اجْعَلْ یَدَکَ الْیُمْنَی عَلَیْہِ ، ثُمَّ قُلِ : بِسْمِ اللہِ أَعُوذُ بِعِزَّۃِ اللہِ وَقُدْرَتِہِ مِنْ شَرِّ مَا أَجِدُ ، سَبْعَ مَرَّاتٍ ، فَفَعَلْتُ ، فَشَفَانِی اللَّہُ عَزَّ وَجَلَّ۔","Sahih","Musannaf Ibn Abi Shaybah 30114","","","كتاب الدعاء"
"30115","(۳۰۱۱۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ إبْرَاہِیمَ بْنِ إسْمَاعِیلَ بْنِ أَبِی حَبِیبَۃَ ، قَالَ : حدَّثَنِی دَاوُد بْنُ الْحُصَیْنِ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ ، کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَلِّمُنَا مِنَ الأَوْجَاعِ کُلِّہَا وَالْحُمَّی ہَذَا الدُّعَائَ : بِسْمِ اللہِ الْکَبِیرِ أَعُوذُ بِاللہِ الْعَظِیمِ مِنْ شَرِّ کُلِّ عِرْقٍ نَعَّار ، وَمِنْ شَرِّ حَرِّ النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 30115","","","كتاب الدعاء"
"30116","(۳۰۱۱۶) حَدَّثَنَا مُحَمَّدُ بْنُ الْفُضَیْلِ ، عَنِ الْعَلائِ بْنِ الْمُسَیَّبِ ، عَنِ الْفُضَیْلِ بْنِ عَمْرٍو ، قَالَ : جَائَ رَجُلٌ إِلَی عَلِیٍّ، قَالَ : إنَّ فُلانًا شَاکٍ ، قَالَ : یَسُرُّک أَنْ یَبْرَأَ قَالَ : نَعَمْ ، قَالَ : قُلْ : یَا حَلِیمُ یَا کَرِیمُ اشْفِ ثَلاثًا۔","","Musannaf Ibn Abi Shaybah 30116","","","كتاب الدعاء"
"30117","(۳۰۱۱۷) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللہِ حَدَّثَنَا أَبُو شِہَابٍ ، عَن دَاوُد ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : اشْتَکَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَرَقَاہُ جِبْرِیلُ فَقَالَ : بِسْمِ اللہِ أَرْقِیک مِنْ کُلِّ شَیْئٍ یُؤْذِیک مِنْ کُلِّ حَاسِدٍ وَعَیْنٍ ، وَاللَّہُ یَشْفِیک۔","Sahih","Musannaf Ibn Abi Shaybah 30117","","","كتاب الدعاء"
"30118","(۳۰۱۱۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَمْرَۃَ بِنْتِ عَبْدِ الرَّحْمَنِ قَالَتْ : اشْتَکَتْ عَائِشَۃُ أُمُّ الْمُؤْمِنِینَ ، وَإِنَّ أَبَا بَکْرٍ دَخَلَ عَلَیْہَا وَیَہُودِیَّۃ تَرْقِیہَا فَقَالَ : ارْقِیہَا بِکِتَابِ اللہِ۔","","Musannaf Ibn Abi Shaybah 30118","","","كتاب الدعاء"
"30119","(۳۰۱۱۹) حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن حُمَیْدٍ ، عَنْ أَنَسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا دَخَلَ عَلَی مَرِیضٍ ، قَالَ : أَذْہِبَ الْبَأْسَ رَبَّ النَّاسِ وَاشْفِ أَنْتَ الشَّافِی لاَ شَافِیَ إِلاَّ أَنْتَ شِفَائً لاَ یُغَادِرُ سَقَمًا۔ (بخاری ۵۷۴۲۔ ابوداؤد ۳۸۸۶)","Sahih","Musannaf Ibn Abi Shaybah 30119","","","كتاب الدعاء"
"30120","(۳۰۱۲۰) حَدَّثَنَا عَبْدُاللہِ بْنُ نُمَیْرٍ حَدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ، عَن حَکِیمِ بْنِ حَکِیمٍ، عَنْ عَلِیِّ بْنِ عَبْدِالرَّحْمَنِ، عَن حُذَیْفَۃَ بْنِ الْیَمَانِ، قَالَ: خَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلَی حَرَّۃِ بَنِی مُعَاوِیَۃَ واتَّبَعْت أَثَرَہُ حَتَّی ظَہَرَ عَلَیْہَا فَصَلَّی الضُّحَی ، ثَمَانِ رَکَعَاتٍ طَوَّلَ فِیہِنَّ ، ثُمَّ انْصَرَفَ فَقَالَ : یَا حُذَیْفَۃُ طَوَّلْت عَلَیْک ، قُلْتُ: اللَّہُ وَرَسُولُہُ أَعْلَمُ ، قَالَ : إنِّی سَأَلْت اللَّہَ فِیہَا ثَلاثًا فَأَعْطَانِی اثْنَتَیْنِ وَمَنَعَنِی وَاحِدَۃً ، سَأَلْتُہُ أَنْ لاَ یُظْہِرَ عَلَی أُمَّتِی غَیْرَہَا فَأَعْطَانِی ، وَسَأَلْتُہُ أَنْ لاَ یُہْلِکَہَا بِالسِّنِینَ ، فَأَعْطَانِی وَسَأَلْتُہُ أَنْ لاَ یَجْعَلَ بَأْسَہَا بَیْنَہَا، فَمَنَعَنِی۔","Da'if","Musannaf Ibn Abi Shaybah 30120","","","كتاب الدعاء"
"30121","(۳۰۱۲۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن رَجَائٍ الأَنْصَارِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، عَن مُعَاذِ بْنِ جَبَلٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمًا صَلاۃً فَأَطَالَ فِیہَا ، فَلَمَّا انْصَرَفَ قُلْتُ : یَا رَسُولَ اللہِ ، لَقَدْ أَطَلْت الْیَوْمَ الصَّلاۃَ ، قَالَ : إنِّی صَلَّیْت صَلاۃَ رَغْبَۃٍ وَرَہْبَۃٍ وَسَأَلْت اللَّہَ لأُمَّتِی ثَلاثًا ، فَأَعْطَانِی ثِنْتَیْنِ وَرَدَّ عَلَیَّ وَاحِدَۃً ، سَأَلْتُہُ أَنْ لاَ یُسَلِّطَ عَلَیْہِمْ عَدُوًّا مِنْ غَیْرِہِمْ فَأَعْطَانِیہَا ، وَسَأَلْتُہُ أَنْ لاَ یُہْلِکَہُمْ غَرَقًا فَأَعْطَانِیہَا ، وَسَأَلْتُہُ أَنْ لاَ یَجْعَلَ بَأْسَہُمْ بَیْنَہُمْ ، فَرُدَّت عَلَیَّ۔ (احمد ۲۴۰۔ ابن خزیمہ ۱۲۱۸)","Da'if","Musannaf Ibn Abi Shaybah 30121","","","كتاب الدعاء"
"30122","(۳۰۱۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، حَدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ حَدَّثَنَا ثَابِتٌ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَن صُہَیْبٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا صَلَّی ہَمَسَ شَیْئًا لاَ یُخْبِرُنَا بِہِ ، فقُلْنَا : یَا رَسُولَ اللہِ ، إنَّک مِمَّا إذَا صَلَّیْت ہَمَسْت شَیْئًا لاَ نَفْقَہُہُ ، قَالَ ، فَطِنْتُمْ بِی ؟ قُلْتُ : نَعَمْ ، قَالَ : ذَکَرْت نَبِیًّا مِنَ الأَنْبِیَائِ أُعْطِیَ جُنُودًا مِنْ قَوْمِہِ ، فَنَظَرَ إِلَیْہِمْ ، فَقَالَ : مَنْ یُکَافِئُ ہَؤُلائِ ، قَالَ : فَقِیلَ لَہُ : اخْتَرْ لِقَوْمِکَ إحْدَی ثَلاثٍ : إمَّا أَنْ یُسَلِّطَ عَلَیْہِمْ عَدُوًّا مِنْ غَیْرِہِمْ ، أَوِ الْجُوعَ ، أَوِ الْمَوْتَ ، قَالَ : فَعَرَضَ ذَلِکَ عَلَی قَوْمِہِ ، قَالَ : فَقَالُوا : أَنْتَ نَبِیُّ اللہِ فَاخْتَرْ لَنَا ، قَالَ : فَقَامَ إِلَی الصَّلاۃِ ، قَالَ : وَکَانُوا مِمَّا إذَا فَزِعُوا فَزِعُوا إِلَی الصَّلاۃِ فَصَلَّی فَقَالَ : اللَّہُمَّ أما أن تُسَلِّطْ عَلَیْہِمْ مِنْ غَیْرِہِمْ فَلا ، أَو الْجُوعُ فَلا ، وَلَکِنَّ الْمَوْتَ ، قَالَ : فَسَلَّطَ عَلَیْہِمَ الْمَوْتَ ، فَمَاتَ مِنْہُمْ سَبْعُونَ أَلْفًا فِی ثَلاثَۃِ أَیَّامٍ ، قَالَ : فَہَمْسِی الَّذِی تَسْمَعُونَ أنی أَقُولُ : اللَّہُمَّ بِکَ أُحَاوِلُ وَبِکَ أُصَاوِلُ ، وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِکَ۔ (نسائی ۱۰۴۵۰۔ احمد ۳۳۳)","Sahih","Musannaf Ibn Abi Shaybah 30122","","","كتاب الدعاء"
"30123","(۳۰۱۲۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، حَدَّثَنَا عُثْمَانُ بْنُ حَکِیمٍ ، أَخْبَرَنَا عَامِرُ بْنُ سَعْدٍ ، عَنْ أَبِیہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَقْبَلَ ذَاتَ یَوْمٍ مِنَ الْعَالِیَۃِ حَتَّی إذَا مَرَّ بِمَسْجِدِ بَنِی مُعَاوِیَۃَ دَخَلَ فَرَکَعَ فِیہِ رَکْعَتَیْنِ وَصَلَّیْنَا مَعَہُ ، وَدَعَا رَبَّہُ طَوِیلاً ، ثُمَّ انْصَرَفَ إلَیْنَا فَقَالَ : سَأَلْتُ رَبِّی ثَلاثًا ، فَأَعْطَانِی اثْنَتَیْنِ وَرَدَّ عَلَیَّ وَاحِدَۃً ، سَأَلْت رَبِّی أَنْ لاَ یُہْلِکَ أُمَّتِی بِالسَّنَۃِ فَأَعْطَانِیہَا ، وَسَأَلْتُہُ أَنْ لاَ یُہْلِکَ أُمَّتِی بِالْغَرَقِ فَأَعْطَانِیہَا ، وَسَأَلْتُہُ أَنْ لاَ یَجْعَلَ بَأْسَہُمْ بَیْنَہُمْ ، فَمَنَعَنِیہَا۔ (مسلم ۲۲۱۶۔ احمد ۱۸۱)","Sahih","Musannaf Ibn Abi Shaybah 30123","","","كتاب الدعاء"
"30124","(۳۰۱۲۴) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَن کَثِیرِ بْنِ زَیْدٍ ، عَنِ الْمُطَّلِبِ بْنِ عَبْدِ اللہِ ، أَنَّ أَبَا بَکْرٍ کَانَ یَقُولُ : اللَّہُمَّ اجْعَلْ خَیْرَ عُمْرِی أَخِیرَہُ ، وَخَیْرَ عَمَلِی خَوَاتِمَہُ ، وَخَیْرَ أَیَّامِی یَوْمَ أَلْقَاک ، قَالَ : وَکَانَ عُمَرُ یَقُولُ : اللَّہُمَّ اعْصِمْنِی بِحَبْلِکَ وَارْزُقْنِی مِنْ فَضْلِکَ وَاجْعَلْنِی أَحْفَظُ أَمْرَک۔","","Musannaf Ibn Abi Shaybah 30124","","","كتاب الدعاء"
"30125","(۳۰۱۲۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ أَوَّلُ کَلامٍ تَکَلَّمَ بِہِ عُمَرُ أَنْ ، قَالَ : اللَّہُمَّ إنِّی ضَعِیفٌ فَقَوِّنِی وَإِنِّی شَدِیدٌ فَلَیِّنِی وَإِنِّی بَخِیلٌ فَسَخِّنِی۔","Da'if","Musannaf Ibn Abi Shaybah 30125","","","كتاب الدعاء"
"30126","(۳۰۱۲۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ حَدَّثَنَا إسْرَائِیلُ، عَنْ أَبِی إِسْحَاقَ عَن حَسَّانَ بْنِ فَائِدٍ الْعَبْسِیِّ، عَن عُمَرَ، أَنَّہُ کَانَ یَدْعُو : اللَّہُمَّ اجْعَلْ غِنَایَا فِی قَلْبِی وَرَغْبَتِی فِیمَا عِنْدَکَ وَبَارِکْ لِی فِیمَا رَزَقْتَنِی وَأَغْنِنِی عَمَّا حَرَّمْت عَلَیَّ۔","Hasan","Musannaf Ibn Abi Shaybah 30126","","","كتاب الدعاء"
"30127","(۳۰۱۲۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ حَدَّثَنَا مِسْعَرٌ ، عَنِ الرُّکَیْنِ ، عَنْ أَبِیہِ ، عَن عُمَرَ ، أَنَّہُ کَانَ یَقُولُ : اللَّہُمَّ أَسْتَغْفِرُک لِذَنْبِی ، وَأَسْتَہْدِیک لِمَرَاشِدِ أَمْرِی ، وَأَتُوبُ إلَیْک فَتُبْ عَلَیَّ إنَّک أَنْتَ رَبِّی ، اللَّہُمَّ فَاجْعَلْ رَغْبَتِی إِلَیْکَ ، وَاجْعَلْ غِنَایَا فِی صَدْرِی ، وَبَارِکْ لِی فِیمَا رَزَقْتَنِی ، وَتَقَبَّلْ مِنِّی إِنَّکَ أَنْتَ رِبِّی۔","","Musannaf Ibn Abi Shaybah 30127","","","كتاب الدعاء"
"30128","(۳۰۱۲۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : قَالَ رَجُلٌ عِنْدَ عُمَرَ اللَّہُمَّ اجْعَلْنِی مِنَ الْقَلِیلِ ، قَالَ ، فَقَالَ : عُمَرُ : مَا ہَذَا الَّذِی تَدْعُو بِہِ ؟ فَقَالَ : إنِّی سَمِعْت اللَّہَ یَقُولُ : وَقَلِیلٌ مِنْ عِبَادِی الشَّکُورُ فَأَنَا أَدْعُو أَنْ یَجْعَلَنِی مِنْ أُولَئِکَ الْقَلِیلِ ، قَالَ : فَقَالَ : عُمَرُ : کُلُّ النَّاسِ أَعْلَمُ مِنْ عُمَرَ۔","","Musannaf Ibn Abi Shaybah 30128","","","كتاب الدعاء"
"30129","(۳۰۱۲۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنْ أَبِی خَلْدَۃَ، عَنْ أَبِی الْعَالِیَۃِ قَالَ سَمِعْت عُمَرَ یَقُولُ اللَّہُمَّ عَافِنَا وَاعْفُ عَنَّا۔","Sahih","Musannaf Ibn Abi Shaybah 30129","","","كتاب الدعاء"
"30130","(۳۰۱۳۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن طُعْمَۃَ بْنِ عَبْدِ اللہِ ، عَن رَجُلٍ یُقَالُ لَہُ مِیکَائِیلُ شَیْخٌ مِنْ أَہْلِ خُرَاسَانَ ، قَالَ : کَانَ عُمَرُ إذَا قَامَ مِنَ اللَّیْلِ یقول : قَدْ تَرَی مَقَامِی وتعلم حَاجَتِی فَارْجِعْنِی مِنْ عِنْدِکَ یَا اللَّہُ بِحَاجَتِی مُفَلَّجًا مُنَجَّحًا مُسْتَجِیبًا مُسْتَجَابًا لِی ، قَدْ غَفَرْت لِی وَرَحِمَتْنِی فَإِذَا قَضَی صَلاتَہُ ، قَالَ : اللَّہُمَّ لاَ أَرَی شَیْئًا مِنَ الدُّنْیَا یَدُومُ ، وَلا أَرَی حَالاً فِیہَا یَسْتَقِیمُ ، اللَّہُمَّ اجْعَلْنِی أنْطِقُ فِیہَا بِعِلْمٍ وَأَصْمُتُ بِحُکْمٍ ، اللَّہُمَّ لاَ تُکْثِرْ لِی مِنَ الدُّنْیَا فَأَطْغَی ، وَلا تُقِلَّ لِی مِنْہَا فَأَنْسَی ، فَإِنَّہُ مَا قَلَّ وَکَفَی خَیْرٌ مِمَّا کَثُرَ وَأَلْہَی۔","Da'if","Musannaf Ibn Abi Shaybah 30130","","","كتاب الدعاء"
"30131","(۳۰۱۳۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن لَیْثٍ ، عَن سُلَیْمِ بْنِ حَنْظَلَۃَ ، عَن عُمَرَ ، أَنَّہُ کَانَ یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ أَنْ تَأْخُذَنِی عَلَی غِرَّۃٍ ، أَوْ تَذَرَنِی فِی غَفْلَۃٍ ، أَوْ تَجْعَلَنِی مِنَ الْغَافِلِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 30131","","","كتاب الدعاء"
"30132","(۳۰۱۳۲) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَنْ عَلِیٍّ ، أَنَّہُ کَانَ یَدْعُو : اللَّہُمَّ ثَبِّتْنَا عَلَی کَلِمَۃِ الْعَدْلِ بِالرِّضَی وَالصَّوَابِ ، وَقِوَامِ الْکِتَابِ ، ہَادِینَ مَہْدِیِّینَ رَاضِینَ مَرْضِیِّینَ ، غَیْرَ ضَالِّینَ، وَلا مُضِلِّینَ۔","Hasan","Musannaf Ibn Abi Shaybah 30132","","","كتاب الدعاء"
"30133","(۳۰۱۳۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَنِ الْوَلِیدِ بْنِ أَبِی الْوَلِیدِ عَمَّنْ حَدَّثَہُ ، عَنْ عَلِیٍّ ، أَنَّہُ کَانَ یَقُولُ فِی دُعَائِہِ : اللَّہُمَّ إنِّی أَسْأَلُک بِرَحْمَتِکَ الَّتِی وَسِعْت بِہَا کُلَّ شَیْئٍ ، وَبِعِزَّتِکَ الَّتِی أَذْلَلْتَ بِہَا کُلَّ شَیْئٍ ، وَخَضَعَ لَکَ بِہَا کُلَّ شَیْئٍ ، وَذَلَّ لَکَ بِہَا کُلَّ شَیْئٍ ، وَبِجَبَرُوتِکَ الَّتِی غَلَبْت بِہَا کُلَّ شَیْئٍ ، وَبِعَظَمَتِکَ الَّتِی غَلَبْت بِہَا کُلَّ شَیْئٍ ، وَبِسُلْطَانِکَ الَّذِی مَلأَت بِہِ کُلَّ شَیْئٍ ، وَبِقُوَّتِکَ الَّتِی لاَ یَقُومُ لَہَا شَیْئٌ ، وَبِنُورِکَ الَّذِی أَضَائَ لَہُ کُلُّ شَیْئٍ وَبِعِلْمِکَ الَّذِی أَحَاطَ بِکُلِّ شَیْئٍ ، وَبِاسْمِکَ الَّذِی یُبتدأ بِہِ کُلَّ شَیْئٍ ، وَبِوَجْہِکَ الْبَاقِی بَعْدَ فَنَائِ کُلِّ شَیْئٍ ، یَا نُورُ یَا قُدُّوسُ یَا نُورُ یَا قُدُّوسُ ثَلاثًا ، یَا أَوَّلَ الأَوَّلِینَ وَیَا آخِرَ الآخِرِینَ ، وَیَا اللَّہُ یَا رَحْمَانُ یَا رَحِیمُ ، اغْفِرْ لِی الذُّنُوبَ الَّتِی تُنْزِلُ النِّقَمَ ، وَاغْفِرْ لِی الذُّنُوبَ الَّتِی تہتک العصم ، وَاغْفِرْ لِی الذُّنُوبَ الَّتِی تُورِثُ النَّدَمَ ، وَاغْفِرْ لِی الذُّنُوبَ الَّتِی تَحْبِسُ الْقَسَمَ وَاغْفِرْ لِی الذُّنُوبَ الَّتِی تُغَیِّرُ النِّعَمَ ، وَاغْفِرْ لِی الذُّنُوبَ الَّتِی تُنْزِلُ الْبَلائَ ، وَتُدِیلُ الأَعْدَائَ ، وَاغْفِرْ لِی الذُّنُوبَ الَّتِی تَحْبِسُ غَیْثَ السَّمَائِ ، وَتُعَجِّلُ الْفَنَائَ ، وَتُظْلِمُ الْہَوَائَ ، وَتَرُدُّ الدُّعَائَ ، وَاغْفِرْ لِی الذُّنُوبَ الَّتِی ترِد إِلَی النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 30133","","","كتاب الدعاء"
"30134","(۳۰۱۳۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَبْدِ اللہِ الأَسَدِیِّ ، عَن رَجُلٍ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ یَقُولُ : اللَّہُمَّ یَا دَاحِیَ الْمَدحُوَّاتِ وَیَا بَانِیَ الْمَبْنِیَّاتِ وَیَا مُرْسِیَ الْمُرَسِّیَاتِ ، وَیَا جَبَّارَ الْقُلُوبِ عَلَی فِطْرَتِہَا شَقِیِّہَا وَسَعِیدِہَا ، وَبَاسِطَ الرَّحْمَۃِ لِلْمُتَّقِینَ ، اجْعَلْ شَرَائِفَ صَلَوَاتِکَ وَنَوَامِی بَرَکَاتِکَ وَرَأْفَاتِ تحننک ، وَعَوَاطِفَ زَوَاکِی رَحْمَتِکَ عَلَی مُحَمَّدٍ عَبْدِکَ وَرَسُولِکَ ، الْفَاتِحِ لِمَا أُغْلِقَ ، وَالْخَاتَمِ لِمَا سَبَقَ وَفَالِجِ الْحَقِّ بِالْحَقِ ، وَدَامِغِ جَاشِیَاتِ الأَبَاطِیلِ کَمَا حَمَّلْتَہُ ، فَاضْطَلَعَ بِأَمْرِکَ مُسْتَنْصِرًا فِی رِضْوَانِکَ غَیْرَ نَاکِلٍ عَن قَدَمٍ ، وَلا مُثْنِی عَنْ عَزْمٍ ، حَافِظٍ لِعَہْدِکَ ، مَاضٍ لِنَفَاذِ أَمْرِکَ ، حَتَّی أَورَی قبسا لقلبس آلاء اللہ تصل بآلہ أسبابہ بہ ہُدِیت الْقُلُوبِ ، بَعْدَ خَوْضَاتِ الْفِتَنِ والأثم وأنہج موضحات الأعلام إِلَی ودائرات الأَحْکَامِ ، فَہُوَ أَمِینُک الْمَأْمُونُ ، وَشَاہِدُک یَوْمَ الدِّینِ ، وَبَعِیثُکَ رَحْمَۃً لِلْعَالَمِینَ ، اللَّہُمَّ افْسَحْ لَہُ مُفْسَحًا عِنْدَکَ ، وَأَعْطِہِ بَعْدَ رِضَاہُ الرِّضَی مِنْ فَوْزِ ثَوَابِکَ الْمَحْلُولِ ، وَعَظِیمِ جَزَائِکَ الْمَعْلُولِ ، اللَّہُمَّ أَتْمِمْ لَہُ مَوْعِدَک بِابْتعَاثِکَ إیَّاہُ مَقْبُولَ الشَّفَاعَۃِ عَدْلَ الشَّہَادَۃِ مَرَضِیَّ الْمَقَالَۃِ ذَا مَنْطِقٍ عَدْلٍ وَخَطِیبٍ فَصْلٍ ، وَحُجَّۃٍ وَبُرْہَانٍ عَظِیمٍ ، اللَّہُمَّ اجْعَلْنَا سَامِعِینَ مُطِیعِینَ وَأَوْلِیَائَ مُخْلِصِینَ وَرُفَقَائَ مُصَاحِبِینَ ، اللَّہُمَّ أبْلِغْہُ مِنَّا السَّلامَ ، وَارْدُدْ عَلَیْنَا مِنْہُ السَّلامَ۔","Da'if","Musannaf Ibn Abi Shaybah 30134","","","كتاب الدعاء"
"30135","(۳۰۱۳۵) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ أَبِی جَعْفَرٍ مُحَمَّدٍ الْبَصْرِیِّ ، عَن رَجُلٍ یُدْعَی سَالِمًا ، قَالَ : کَانَ مِنْ دُعَائِ عَلِیٍّ : اللَّہُمَّ اجْعَلْنِی مِمَّنْ رَضِیتَ عَمَلَہُ وَقَصَّرْت أَمَلَہُ ، وَأَطَلْت عُمُرَہُ ، وَأَحْیَیْتہ بَعْدَ الْمَوْتِ حَیَاۃً طَیِّبَۃً وَرَزَقْتہ اللَّہُمَّ إنِّی أَسْأَلُک نَعِیمًا لاَ یَنْفَدُ ، وَفَرْحَۃً لاَ تَرْتَدُ ، وَمُرَافَقَۃَ نَبِیِّکَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَإِبْرَاہِیمَ فِی أَعْلَی جَنَّۃِ الْخُلْدِ ، اللَّہُمَّ ہَبْ لِی شفقا یَوْجَلُ لَہُ قَلْبِی ، وَتَدْمَعُ لَہُ عَیْنِی ، وَیَقْشَعِرُّ لَہُ جِلْدِی وَیَتَجَافَی لَہُ جَنْبِی ، وَأَجِدُ نَفْعَہُ فِی قَلْبِی ، اللَّہُمَّ طَہِّرْ قَلْبِی مِنَ النِّفَاقِ ، وَصَدْرِی مِنَ الْغِلِ ، وَأَعْمَالِی مِنَ الرِّیَائِ ، وَعَیْنِی مِنَ الْخِیَانَۃِ ، وَلِسَانِی مِنَ الْکَذِبِ ، وَبَارِکْ لِی فِی سَمْعِی وَقَلْبِی ، وَتُبْ عَلَیَّ إنَّک أَنْتَ التَّوَّابُ الرَّحِیمُ ، اللَّہُمَّ إنِّی أَعُوذُ بِوَجْہِکَ الْکَرِیمِ الَّذِی أَشْرَقَتْ لَہُ السَّمَاوَاتُ السَّبْعُ وَکُشِفَتْ بِہِ الظُّلُمَاتُ وَصَلُحَ عَلَیْہِ أَمْرُ الأَوَّلِینَ وَالآخِرِینَ مِنْ أَنْ یَحِلَّ عَلَیَّ غَضَبُک ، أَوْ یَنْزِلَ بِی سَخَطُک ، أَوْ أَتَّبِعَ ہَوَایَ بِغَیْرِ ہُدًی مِنْک ، أَوْ أَقُولَ لِلَّذِینَ کَفَرُوا {ہَؤُلائِ أَہْدَی مِنَ الَّذِینَ آمَنُوا سَبِیلاً} اللَّہُمَّ کُنْ بِی بَرًّا رَؤُوفًا رَحِیمًا بِحَاجَتِی حَفِیًّا ، اللَّہُمَّ اغْفِرْ لِی یَا غَفَّارُ ، وَتُبْ عَلَیَّ یَا تَوَّابُ ، وَارْحَمْنِی یَا رَحْمَنُ ، وَاعْفُ عَنِّی یَا حَلِیمُ ، اللَّہُمَّ ارْزُقْنِی زَہَادَۃً وَاجْتِہَادًا فِی الْعِبَادَۃِ ، وَلَقِّنِی إیَّاکَ عَلَی شَہَادَۃٍ یسبق بُشْرَاہَا وَجَعَہَا وَفَرْحُہَا جَزَعہَا ، یَا رَبِّ لَقِّنِّی عِنْدَ الْمَوْتِ نَضْرَۃً وَبَہْجَۃً وَقُرَّۃَ عَیْنٍ وَرَاحَۃً فِی الْمَوْتِ ، اللَّہُمَّ لَقِّنِّی فِی قَبْرِی ثَبَاتَ الْمَنْطِقِ وَقُرَّۃَ عَیْنِ الْمَنْظَرِ وَسَعَۃً فِی الْمَنْزِلِ ، اللَّہُمَّ قفنی مِنْ عَمَلِ یَوْمِ الْقِیَامَۃِ مَوْقِفًا تُبَیِّضُّ بِہِ وَجْہِی ، وتُثَبِّتُ بِہِ مَقَالَتِی ، وَتُقَرُّ بِہِ عَیْنِی ، وَتَنْزِلُ بِہِ عَلَی أمنتی ، وَتَنْظُرُ إلَیَّ بِوَجْہِکَ نَظْرَۃً أَسْتَکْمِلُ بِہَا الْکَرَامَۃَ فِی الرَّفِیقِ الأَعْلَی فِی أَعْلَی عِلِّیِّینَ ، فَإِنَّ نِعْمَتَکَ تُتِمُّ الصَّالِحَاتِ ، اللَّہُمَّ إنِّی ضَعِیفٌ مِنْ ضَعْفٍ خَلَقْتَنِی إِلَی ضَعْف مَا أَصِیرُ ، فَمَا شِئْت لاَ مَا شئنا ، فَشَأْ لِی أَنْ أَسْتَقِیمَ۔","Da'if","Musannaf Ibn Abi Shaybah 30135","","","كتاب الدعاء"
"30136","(۳۰۱۳۶) حَدَّثَنَا عَفَّانُ حَدَّثَنَا شُعْبَۃُ أَخْبَرَنِی مَنْصُورُ بْنُ الْمُعْتَمِرِ ، قَالَ : سَمِعْتُ رِبْعِیَّ بْنَ خِرَاشٍ ، عَنْ عَلِیٍّ ، قَالَ : ما مِنْ کَلِمَاتٍ أَحَبُّ إِلَی اللہِ أَنْ یَقُولَہُنَّ الْعَبْدُ : اللَّہُمَّ لاَ إلَہَ إِلاَّ أَنْتَ اللَّہُمَّ لاَ أَعْبُدُ إِلاَّ إیَّاکَ ، اللَّہُمَّ لاَ أُشْرِکُ بِکَ شَیْئًا ، اللَّہُمَّ إنِّی قَدْ ظَلَمْت نَفْسِی فَاغْفِرْ لِی ذُنُوبِی ، إِنَّہُ لاَ یَغْفِرُ الذُّنُوبَ إِلاَّ أَنْتَ۔","Sahih","Musannaf Ibn Abi Shaybah 30136","","","كتاب الدعاء"
"30137","(۳۰۱۳۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ وَعَلْقَمَۃَ ، قَالا : قَالَ عَبْدُ اللہِ : إنَّ فِی کِتَابِ اللہِ آیَتَیْنِ مَا أَصَابَ عَبْدٌ ذَنْبًا فَقَرَأَہُمَا ، ثُمَّ اسْتَغْفَرَ اللَّہَ إِلاَّ غَفَرَ لَہُ {وَالَّذِینَ إذَا فَعَلُوا فَاحِشَۃً أَوْ ظَلَمُوا أَنْفُسَہُمْ } إِلَی آخِرِ الآیَۃِ وَ {مَنْ یَعْمَلْ سُوئًا أَوْ یَظْلِمْ نَفْسَہُ}۔","Sahih","Musannaf Ibn Abi Shaybah 30137","","","كتاب الدعاء"
"30138","(۳۰۱۳۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن شَقِیقٍ ، قَالَ : کَانَ مِنْ دُعَائِ عَبْدِ اللہِ رَبَّنَا أَصْلِحْ ذَاتَ بَیْنِنَا وَاہْدِنَا سُبُلَ الإِسْلامِ وَأَخْرِجْنَا مِنَ الظُّلُمَاتِ إِلَی النُّورِ ، وَاصْرِفْ عَنَّا الْفَوَاحِشَ مَا ظَہَرَ مِنْہَا ، وَمَا بَطَنَ ، وَبَارِکْ لَنَا فِی أَسْمَاعِنَا وَأَبْصَارِنَا وَقُلُوبِنَا وَأَزْوَاجِنَا وَذُرِّیَّاتِنَا وَتُبْ عَلَیْنَا وَعَلَیْہِمْ إنَّک أَنْتَ التَّوَّابُ الرَّحِیمُ، وَاجْعَلْنَا لأَنْعُمِکَ شَاکِرِینَ مُثْنِینَ بِہَا قَائِلِینَ بِہَا وَأَتْمِمْہَا عَلَیْنَا۔","Sahih","Musannaf Ibn Abi Shaybah 30138","","","كتاب الدعاء"
"30139","(۳۰۱۳۹) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَن مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : کَانَ عَبْدُ اللہِ یَقُولُ ، اللَّہُمَّ أَصْلِحْ ذَاتَ بَیْنِنَا ، ثُمَّ ذَکَرَ نَحْوًا مِنْ حَدِیثِ الأَعْمَشِ۔","Sahih","Musannaf Ibn Abi Shaybah 30139","","","كتاب الدعاء"
"30140","(۳۰۱۴۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی فَاخِتَۃَ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، قَالَ : قَالَ عَبْدُ اللہِ : یَقُولُ اللَّہُ تعالی مَنْ کَانَ لَہُ عِنْدِی عَہْدٌ فَلْیَقُمْ قَالُوا : یَا أَبَا عَبْدِ الرَّحْمَنِ ، فَعَلِّمْنَا ، قَالَ : قُولُوا : اللَّہُمَّ فَاطِرَ السَّمَاوَاتِ وَالأَرْضِ عَالِمَ الْغَیْبِ وَالشَّہَادَۃِ إنِّی أَعْہَدُ إلَیْک عَہْدًا فِی ہَذِہِ الْحَیَاۃِ الدُّنْیَا إنَّک إِنْ تَکِلْنِی إِلَی عملی تُقَرِّبُنِی مِنَ الشَّرِّ وَتُبَاعِدُنِی مِنَ الْخَیْرِ ، وَأَنِّی لاَ أَثِقُ إِلاَّ بِرَحْمَتِکَ فَاجْعَلْہُ لِی عِنْدَکَ عَہْدًا تُؤَدِّیہِ إلَیَّ یَوْمَ الْقِیَامَۃِ إنَّک لاَ تُخْلِفُ الْمِیعَادَ۔","Sahih","Musannaf Ibn Abi Shaybah 30140","","","كتاب الدعاء"
"30141","(۳۰۱۴۱) حَدَّثَنَا عَفَّانُ حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ أَخْبَرَنَا عَطَائُ بْنُ السَّائِبِ ، عَنْ أَبِی الأَحْوَصِ ، أَنَّ ابْنَ مَسْعُودٍ کَانَ إذَا دَعَا لأَصْحَابِہِ ، یقول : اللَّہُمَّ اہْدِنَا ، وَیَسِّرْ ہُدَاک لَنَا ، اللَّہُمَّ یَسِّرْنَا لِلْیُسْرَی وَجَنِّبْنَا الْعُسْرَی وَاجْعَلْنَا مِنْ أُولِی النُّہَی اللَّہُمَّ لَقِّنَّا نَضْرَۃً وَسُرُورًا ، وَاکْسُنَا سُنْدُسًا وَحَرِیرًا وَحَلِّنَا أَسَاوِرَ إلَہِ الْحَقِّ اللَّہُمَّ اجْعَلْنَا شَاکِرِینَ لِنِعْمَتِکَ مُثْنِینَ بِہَا قَائِلِیہَا وَتُبْ عَلَیْنَا إنَّک أَنْتَ التَّوَّابُ الرَّحِیمُ۔","Sahih","Musannaf Ibn Abi Shaybah 30141","","","كتاب الدعاء"
"30142","(۳۰۱۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ حَدَّثَنَا مِسْعَرٌ، عَنِ جواب التیمی عن الحارث بن سوید قَالَ: قَالَ عَبْدُ اللہِ إن مِنْ أَحَبُّ الْکَلامِ إِلَی اللہِ أَنْ یَقُولَ الْعَبْدُ اللَّہُمَّ أَبُوئُ بِالنِّعْمَۃِ وَأَبُوئُ بِالذَّنْبِ فَاغْفِرْ لِی إنَّہُ لاَ یَغْفِرُ الذُّنُوبَ إِلاَّ أَنْتَ۔","Hasan","Musannaf Ibn Abi Shaybah 30142","","","كتاب الدعاء"
"30143","(۳۰۱۴۳) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَن مِسْعَرٍ ، عَن مَعْنٍ قَالَ : کَانَ عَبْدُ اللہِ مِمَّا یَدْعُو یَقُولُ اللَّہُمَّ أَعِنِّی عَلَی أَہَاوِیلِ الدُّنْیَا وَبَوَائِقِ الدَّہْرِ وَمَصَائِبِ اللَّیَالِیِ وَالأَیَّامِ ، وَاکْفِنِی شَرَّ مَا یَعْمَلُ الظَّالِمُونَ فِی الأَرْضِ ، اللَّہُمَّ اصْحَبْنِی فِی سَفَرِی وَاخْلُفْنِی فِی حَضَرِی وَإِلَیْک فَحَبِّبْنِی ، وَفِی أَعْیُنِ النَّاسِ فَعَظِّمْنِی ، وَفِی نَفْسِکَ فَاذْکُرْنِی ، وَفِی نَفْسِی لَکَ فَذَلِّلْنِی ، وَمِنْ شَرِّ الأَخْلاقِ فَجَنِّبْنِی یَا رَحْمَنُ ، إِلَی مَنْ تَکِلُنِی ، أَنْتَ رَبِّی ، إِلَی بَعِیدٍ یَتَجَہَّمُنِی أَمْ إِلَی قَرِیبٍ قَلَّدْْتہ أَمْرِی۔","","Musannaf Ibn Abi Shaybah 30143","","","كتاب الدعاء"
"30144","(۳۰۱۴۴) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : کَانَ عَبْدُ اللہِ إذَا اجْتَہَدَ فِی الدُّعَائِ ، قَالَ اللَّہُمَّ إنِّی أَسْأَلُک مِنْ فَضْلِکَ الَّذِی أَفَضَلْت عَلَی ، وَبَلائِکَ الْحَسَنِ الَّذِی ابْتَلَیْتنِی ، وَنَعْمَائِکَ الَّتِی أَنْعَمْت عَلَیَّ أَنْ تُدْخِلَنِی الْجَنَّۃَ ، اللَّہُمَّ أَدْخِلْنِی الْجَنَّۃَ بِرَحْمَتِکَ وَمَغْفِرَتِکَ وَفَضْلِک۔","","Musannaf Ibn Abi Shaybah 30144","","","كتاب الدعاء"
"30145","(۳۰۱۴۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، قَالَ : مَا دَعَا عَبْدٌ قَطُّ بِہَذِہِ الدَّعَوَاتِ إِلاَّ وَسَّعَ اللَّہُ عَلَیْہِ فِی مَعِیشَتِہِ یَا ذَا الْمَنِّ فَلا یُمَنَّ عَلَیْک یَا ذَا الْجَلالِ وَالإِکْرَامِ یَا ذَا الطَّوْلِ لاَ إلَہَ إِلاَّ أَنْتَ ، ظَہْرُ اللاجِئِینَ وَجَارُ الْمُسْتَجِیرِینَ وَمَأْمَنُ الْخَائِفِینَ ، إِنْ کُنْتَ کَتَبْتنِی عِنْدَکَ فِی أُمِّ الْکِتَابِ شَقِیًّا فَامْحُ عَنِّی اسْمَ الشَّقَائِ ، وَأَثْبِتْنِی عِنْدَکَ سَعِیدًا ، وَإِنْ کُنْتَ کَتَبْتَنِی فِی أُمِّ الْکِتَابِ مُقترًا عَلَی رِزْقِی ، فَامْحُ حِرْمَانِی ، وَتَقْتِیر رِزْقِی ، وَاثْبِتْنِی عِنْدَک سَعِیدًا مُوَفَّقًا لِلْخَیْرِ ، فَإِنَّک تَقُولُ فِی کِتَابِکَ {یَمْحُو اللَّہُ مَا یَشَائُ وَیُثْبِتُ وَعِنْدَہُ أُمُّ الْکِتَابِ}۔","Da'if","Musannaf Ibn Abi Shaybah 30145","","","كتاب الدعاء"
"30146","(۳۰۱۴۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ، عَنْ أَبِی إِسْحَاقَ، عَنْ أَبِی عُبَیْدَۃَ، قَالَ سُئِلَ عَبْدُاللہِ: مَا الدُّعَائُ الَّذِی دَعَوْت بِہِ لَیْلَۃَ ، قَالَ لَکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سَلْ تُعْطَہُ ، قَالَ : قُلْتُ اللَّہُمَّ إنِّی أَسْأَلُک إیمَانًا لاَ یَرْتَدُّ ، وَنَعِیمًا لاَ یَنْفَدُ ، وَمُرَافَقَۃَ نَبِیِّکَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی أَعْلَی دَرَجَۃِ الْجَنَّۃِ جَنَّۃِ الْخُلْدِ۔","","Musannaf Ibn Abi Shaybah 30146","","","كتاب الدعاء"
"30147","(۳۰۱۴۷) حَدَّثَنَا ہُشَیْمٌ ، أَخْبَرَنَا حُصَیْنٌ ، عَنْ أَبِی الْیَقْظَانِ حُصَیْنِ بْنِ یَزِیدَ الثَّعْلَبِیِّ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، أَنَّہُ کَانَ یَقُولُ : إذَا فَرَغَ مِنَ الصَّلاۃِ : اللَّہُمَّ إنِّی أَسْأَلُک مُوجِبَاتِ رَحْمَتِکَ وَعَزَائِمَ مَغْفِرَتِکَ وَأَسْأَلُکَ الْغَنِیمَۃَ مِنْ کُلِّ بِرٍّ وَالسَّلامَۃَ مِنْ کُلِّ إِثْمٍ ، اللَّہُمَّ إنِّی أَسْأَلُک الْفَوْزَ بِالْجَنَّۃِ وَالْجَوَارَ مِنَ النَّارِ ، اللَّہُمَّ لاَ تَدَعْ ذَنْبًا إِلاَّ غَفَرْتہ ، وَلا ہَمًّا إِلاَّ فَرَّجْتہ ، وَلا حَاجَۃً إِلاَّ قَضَیْتہَا۔","Da'if","Musannaf Ibn Abi Shaybah 30147","","","كتاب الدعاء"
"30148","(۳۰۱۴۸) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، أَنَّہُ کَانَ یَدْعُو اللَّہُمَّ أَلْبِسْنَا لِبَاسَ التَّقْوَی ، وَأَلْزِمْنَا کَلِمَۃَ التَّقْوَی ، وَاجْعَلْنَا مِنْ أُولِی النُّہَی ، وَأَمِتْنَا حِینَ تَرْضَی ، وَأَدْخِلْنَا جَنَّۃَ الْمَأْوَی ، وَاجْعَلْنَا مِمَّنْ بَرَّ وَاتَّقَی ، وَصَدَّقَ بِالْحُسْنَی ، وَنَہَی النَّفْسَ عَنِ الْہَوَی ، وَاجْعَلْنَا مِمَّنْ تُیَسِّرُہُ لِلْیُسْرَی ، وَتُجَنِّبُہُ الْعُسْرَی ، وَاجْعَلْنَا مِمَّنْ یَتَذَکَّرُ فَتَنْفَعُہُ الذِّکْرَی ، اللَّہُمَّ اجْعَلْ سَعْیَنَا مَشْکُورًا وَذَنْبَنَا مَغْفُورًا ، وَلَقِّنَّا نَضْرَۃً وَسُرُورًا ، وَاکْسُنَا سُنْدُسًا وَحَرِیرًا ، وَاجْعَلْ لَنَا أَسَاوِرَ مِنْ ذَہَبٍ وَلُؤْلُؤٍ وَحَرِیرًا۔","Sahih","Musannaf Ibn Abi Shaybah 30148","","","كتاب الدعاء"
"30149","(۳۰۱۴۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَطِیَّۃَ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ قَالَ : اللَّہُمَّ اغْفِرْ لَنَا وَارْحَمْنَا وَعَافِنَا وَاہْدِنَا وَارْزُقْنَا ، قَالَ : فَقَالُوا لَہُ : لَوْ زِدْتنَا ، قَالَ : أَعُوذُ بِاللہِ أَنْ أَکُونَ مِنَ الْمُسْہَبِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 30149","","","كتاب الدعاء"
"30150","(۳۰۱۵۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ حَدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَن عُمَارَۃَ بْنِ غَزِیَّۃَ عَن یَحْیَی بْنِ رَاشِدٍ ، قَالَ : حجَجْنَا ، فَلَمَّا قَضَیْنَا نُسُکَنَا قُلْنَا : لَوْ أَتَیْنَا ابْنَ عُمَرَ فَحَدَّثْنَا ، فَأَتَیْنَا فَخَرَجَ إلَیْنَا فَجَلَسَ بَیْنَنَا فَصَمَتَ لِنَسْأَلَہُ ، وَصَمَتْنَا لِیُحَدِّثَنَا ، فَلَمَّا أَطَالَ الصَّمْتَ ، قَالَ : مَا لَکُمْ لاَ تَکَلَّمُونَ ، أَلا تَقُولُونَ : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ ، وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ ، الْحَسَنَۃُ بِعَشْرِ أَمْثَالِہَا إِلَی سَبْعِمِئَۃِ ضِعْفٍ ، فَإِنْ زِدْتُمْ خَیْرًا زَادَکُمَ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 30150","","","كتاب الدعاء"
"30151","(۳۰۱۵۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَن سُفْیَانَ ، عَن عُبَیْدِ اللہِ ، عَن نَافِعٍ ، أَنَّ ابْنَ عُمَرَ کَانَ یَقُولُ : اللَّہُمَّ لاَ تَنْزِعْ مِنِّی الإِیمَانَ کَمَا أَعْطَیْتنِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30151","","","كتاب الدعاء"
"30152","(۳۰۱۵۲) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَن سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : رَبِّ بِمَا أَنْعَمْتَ عَلَیَّ فَلَنْ أَکُونَ ظَہِیرًا لِلْمُجْرِمِینَ ، فَلَمَّا صَلَّی ، قَالَ : مَا صَلَّیْت صَلاۃً إِلاَّ وَأَنَا أَرْجُو أَنْ تَکُونَ کَفَّارَۃً لِمَا أَمَامَہَا یَعْنِی ، قَالَہَا وَہُوَ رَاکِعٌ۔","Sahih","Musannaf Ibn Abi Shaybah 30152","","","كتاب الدعاء"
"30153","(۳۰۱۵۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، عَن مُحَمَّدٍ ، عَنْ أَبِی مُوسَی ، أَنَّہُ کَانَ یَقُولُ فِی دُعَائِہِ : اللَّہُمَّ إنِّی أَسْأَلُک مِنَ الْخَیْرِ کُلِّہِ مَا یَنْبَغِی أَنْ أَسْأَلَک مِنْہُ ، وَأَعُوذُ بِکَ مِنَ الشَّرِّ کُلِّہِ مَا یَنْبَغِی أَنْ أَتَعَوَّذَ بِکَ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30153","","","كتاب الدعاء"
"30154","(۳۰۱۵۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ حَدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو ، عن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُک بِنُورِ وَجْہِکَ الَّذِی أَشْرَقَتْ لَہُ السَّمَاوَاتُ وَالأَرْضُ أَنْ تَجْعَلَنِی فِی حِرْزِکَ وَحِفْظِکَ وَجِوَارِکَ وَتَحْتَ کَنَفِک۔","Sahih","Musannaf Ibn Abi Shaybah 30154","","","كتاب الدعاء"
"30155","(۳۰۱۵۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَن سُفْیَانَ ، عَن طَارِقٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنْ أَبِی ہَیَّاجٍ الأَسَدِیِّ، قَالَ : سَمِعْتُ شَیْخًا یَطُوفُ خَلْفَ الْبَیْتِ وَہُوَ یَقُولُ : اللَّہُمَّ قِنِی شُحَّ نَفْسِی ، فَلَمْ أَدْرِ مَنْ ہُوَ ، فَلَمَّا انْصَرَفَ ، اتَّبَعْتُہُ ، فَسَأَلْتُ عَنْہُ ؟ فَقَالُوا : عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30155","","","كتاب الدعاء"
"30156","(۳۰۱۵۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن الجریری عن ثمامۃ بن حزن قَالَ ، سمعت شیخاً یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ شَرٍّ لاَ یُخْلَطُ مَعَہُ غَیْرُہُ ، قَالَ : قُلْتُ : مَنْ ہَذَا الشَّیْخُ ، قَالَ : أَبُو الدَّرْدَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 30156","","","كتاب الدعاء"
"30157","(۳۰۱۵۷) حَدَّثَنَ[corrupt] أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن حَبِیبٍ ، عَن عُرْوَۃَ بْنِ عَامِرٍ ، قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الطِّیَرَۃِ فَقَالَ : أَصْدَقُہَا الْفَأْلُ ، وَلا تَرُدُّ مُسْلِمًا ، فَإِذَا رَأَیْتُمْ مِنَ الطِّیَرَۃِ شَیْئًا تَکْرَہُونَہُ فَقُولُوا : اللَّہُمَّ لاَ یَأْتِی بِالْحَسَنَاتِ إِلاَّ أَنْتَ ، وَلا یَذْہَبُ بِالسَّیِّئَاتِ إِلاَّ أَنْتَ ، وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ۔","","Musannaf Ibn Abi Shaybah 30157","","","كتاب الدعاء"
"30158","(۳۰۱۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَن حَبِیبٍ ، عَن عُرْوَۃَ بْنِ عَامِرٍ ، قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الطِّیَرَۃِ ، ثُمَّ ذَکَرَ مِثْلَ حَدِیثِ أَبِی مُعَاوِیَۃَ إِلاَّ أَنَّہُ قَالَ : وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِک۔","","Musannaf Ibn Abi Shaybah 30158","","","كتاب الدعاء"
"30159","(۳۰۱۵۹) حَدَّثَنَا وَکِیعٌ ، عَن أُسَامَۃَ بْنِ زَیْدٍ ، عَن نَافِعِ بْنِ جُبَیْرٍ ، قَالَ : قَالَ کَعْبٌ لِعَبْدِ اللہِ بْنِ عَمْرٍو : ہَلْ تَطَیَّرُ ؟ قَالَ : نَعَمْ ، قَالَ : فَمَا تَقُولُ : قَالَ : أَقُولُ : اللَّہُمَّ لاَ طَیْرَ إِلاَّ طَیْرُک ، وَلا خَیْرَ إِلاَّ خَیْرُک ، وَلا رَبَّ غَیْرُک ، قَالَ : أَنْتَ أَفْقَہُ الْعَرَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 30159","","","كتاب الدعاء"
"30160","(۳۰۱۶۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی قَتَادَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الرُّؤْیَا مِنَ اللہِ ، وَالْحُلْمُ مِنَ الشَّیْطَانِ ، فَإِذَا رَأَی أَحَدُکُمْ مَا یَکْرَہُ فَلْیَنْفُثْ عَن یَسَارِہِ وَلْیَتَعَوَّذْ مِنْ شَرِّہَا فَإِنَّہَا لن تَضُرَّہُ۔ (بخاری ۵۷۴۷۔ مسلم ۱۷۷۲)","Sahih","Musannaf Ibn Abi Shaybah 30160","","","كتاب الدعاء"
"30161","(۳۰۱۶۱) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللہِ بْنِ یُونُسَ ، عَن لَیْثِ بْنِ سَعْدٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا رَأَی أَحَدُکُمَ الرُّؤْیَا یَکْرَہُہَا فَلْیَبْصُقْ ، عَن یَسَارِہِ ثَلاثًا وَلْیَسْتَعِذْ بِاللہِ مِنَ الشَّیْطَانِ ثَلاثًا ، وَیَتَحَوَّلُ ، عَنْ جَنْبِہِ الَّذِی کَانَ عَلَیْہِ۔ (مسلم ۱۷۷۲۔ ابوداؤد ۴۹۸۳)","Sahih","Musannaf Ibn Abi Shaybah 30161","","","كتاب الدعاء"
"30162","(۳۰۱۶۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنْ إبْرَاہِیمَ النَّخَعِیِّ ، قَالَ : کَانُوا إذَا رَأَی أَحَدُہُمْ فِی مَنَامِہِ مَا یَکْرَہُ ، قَالَ : أَعُوذُ بِمَا عَاذَتْ بِہِ مَلائِکَۃُ اللہِ وَرَسُولِہِ مِنْ شَرِّ مَا رَأَیْت فِی مَنَامِی أَنْ یُصِیبَنِی مِنْہُ شَیْئٌ أَکْرَہُہُ فِی الدُّنْیَا وَالآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 30162","","","كتاب الدعاء"
"30163","(۳۰۱۶۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، حَدَّثَنَا عَبْدُ الْمَلِکِ بْنُ أَبِی سُلَیْمَانَ ، عَنْ أَبِی عَلِیٍّ رَجُلٍ مِنْ بَنِی کَاہِلٍ ، قَالَ: خَطَبَنَا أَبُو مُوسَی الأَشْعَرِیُّ فَقَالَ : خَطَبَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ یَوْمٍ فَقَالَ : أَیُّہَا النَّاسُ ، اتَّقُوا ہَذَا الشِّرْکَ فَإِنَّہُ أَخْفَی مِنْ دَبِیبِ النَّمْلِ ، فَقَالَ مَنْ شَائَ أَنْ یَقُولَ : وَکَیْفَ نَتَّقِیہِ وَہُوَ أَخْفَی مِنْ دَبِیبِ النَّمْلِ یَا رَسُولَ اللہِ ؟ قَالَ قُولُوا : اللَّہُمَّ إنَّا نَعُوذُ بِکَ مِنْ أَنْ نُشْرِکَ بِکَ شَیْئًا نَعْلَمُہُ وَنَسْتَغْفِرُک لِمَا لاَ نَعْلَمُ۔n(بخاری ۵۰۹۔ احمد ۴۰۳)","Da'if","Musannaf Ibn Abi Shaybah 30163","","","كتاب الدعاء"
"30164","(۳۰۱۶۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَن عُبَیْدِ اللہِ بْنِ الْمُغِیرَۃِ بْنِ مُعَیْقِیبٍ ، عَنْ عَمْرِو بْنِ سُلَیْمٍ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: اللَّہُمَّ أَتَّخِذُ عِنْدَکَ عَہْدًا تُؤَدِّیہِ إِلَیَّ یَوْمَ الْقِیَامَۃِ ، إنَّک لاَ تُخْلِفُ الْمِیعَادَ ، فَإِنَّمَا أَنَا بَشَرٌ فَأَیَّ الْمُسْلِمِینَ آذَیْتہ ، أَوْ شَتَمْتہ ، أَوْ قَالَ ضَرَبْتہ ، أَوْ سَبَبْتہ فَاجْعَلْہَا لَہُ صَلاۃً وَاجْعَلْہَا لَہُ زَکَاۃً وَقُرْبَۃً تُقَرِّبُہُ بِہَا إلَیْک یَوْمَ الْقِیَامَۃِ۔(احمد ۴۴۹۔ ابویعلی ۱۲۵۷)","","Musannaf Ibn Abi Shaybah 30164","","","كتاب الدعاء"
"30165","(۳۰۱۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، عَنْ عُمَرَ بْنِ قَیْسٍ ، عَنْ عَمْرِو بْنِ أَبِی قُرَّۃَ ، عَن سَلْمَانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ وَلَدِ آدَمَ أَنَا ، فَأَیُّمَا عَبْدٍ مِنْ أُمَّتِی لَعَنْتہ لَعْنَۃً ، أَوْ سَبَبْتہ سَبَّۃً فِی غَیْرِ کُنْہِہِ ، فَاجْعَلْہَا عَلَیْہِ صَلاۃً۔ (بخاری ۲۳۴۔ ابوداؤد ۴۶۲۶)","Sahih","Musannaf Ibn Abi Shaybah 30165","","","كتاب الدعاء"
"30166","(۳۰۱۶۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : اللَّہُمَّ أَیُّمَا مُؤْمِنٍ لَعَنْتہ ، أَوْ سَبَبْتہ ، أَوْ جَلَدْتہ فَاجْعَلْہَا لَہُ زَکَاۃً وَأَجْرًا۔ (مسلم ۲۰۰۸۔ احمد ۳۹۱)","Hasan","Musannaf Ibn Abi Shaybah 30166","","","كتاب الدعاء"
"30167","(۳۰۱۶۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اللَّہُمَّ إنَّمَا بَشَرٌ فَأَیُّما رَجُلٍ مِنَ الْمُسْلِمِینَ سَبَبْتہ ، أَوْ لَعَنْتہ ، أَوْ جَلَدْتہ فَاجْعَلْہَا زَکَاۃً وَرَحْمَۃً۔ (مسلم ۲۰۰۷۔ احمد ۳۹۰)","Sahih","Musannaf Ibn Abi Shaybah 30167","","","كتاب الدعاء"
"30168","(۳۰۱۶۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَہُ غَیْرَ أَنَّہُ قَالَ : زَکَاۃً وَأَجْرًا۔ (مسلم ۲۰۰۷۔ دارمی ۲۷۶۶)","Hasan","Musannaf Ibn Abi Shaybah 30168","","","كتاب الدعاء"
"30169","(۳۰۱۶۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَن مَسْرُوقٍ ، عَنْ عَائِشَۃَ قَالَتْ : اسْتَأْذَنَ عَلَی النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلانِ فَأَغْلَظَ لَہُمَا وَسَبَّہُمَا ، قَالَتْ : قُلْتُ : یَا رَسُولَ اللہِ مَنْ أَصَابَ مِنْک خَیْرًا فما أَصَابَ ہَذَانِ مِنْک خَیْرًا ، قَالَ : أَوَ مَا عَلِمْت مَا عَاہَدْت عَلَیْہِ رَبِّی ؟ قَالَتْ لَہُ : وَمَا عَاہَدْت عَلَیْہِ رَبَّک ؟ قَالَ : قُلْتُ : اللَّہُمَّ أَیُّمَا مُؤْمِنٍ سَبَبْتہ ، أَوْ لَعَنْتہ ، أَوْ جَلَدْتہ فَاجْعَلْہَا لَہُ مَغْفِرَۃً وَعَافِیَۃً وَکَذَا وَکَذَا۔n(مسلم ۲۰۰۷۔ احمد ۴۵)","Sahih","Musannaf Ibn Abi Shaybah 30169","","","كتاب الدعاء"
"30170","(۳۰۱۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن حَبِیبٍ ، عَن بَعْضِ أَشْیَاخِہِ، قَالَ: کَانَ إذَا أَتَاہُ الأَمْرُ مِمَّا یُعْجِبُہُ، قَالَ : الْحَمْدُ لِلَّہِ الْمُنْعِمِ الْمُفْضِلِ ، الَّذِی بِنِعْمَتِہِ تَتِمُّ الصَّالِحَاتِ ، وَإِذَا أَتَاہُ الأَمْر مِمَّا یَکْرَہُہُ ، قَالَ : الْحَمْدُ لِلَّہِ عَلَی کُلِّ حَالٍ۔ (ابن ماجہ ۳۸۰۳)","","Musannaf Ibn Abi Shaybah 30170","","","كتاب الدعاء"
"30171","(۳۰۱۷۱) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، عَن سَلْمَانَ ، قَالَ : إنَّ اللَّہَ یَسْتَحْیِی أَنْ یَبْسُطَ إلَیْہِ عَبْدُہُ یَدَیْہِ یَسْأَلُہُ بِہِمَا خَیْرًا فَیَرُدَّہُمَا خَائِبَتَیْنِ۔ (ابوداؤد ۱۴۸۳۔ ترمذی ۳۵۵۶)","Sahih","Musannaf Ibn Abi Shaybah 30171","","","كتاب الدعاء"
"30172","(۳۰۱۷۲) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَغَرِّ أَبِی مُسْلِمٍ یَشْہَدُ بہ عَلَی أَبِی ہُرَیْرَۃَ ، وَأَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالا : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ یُمْہِلُ حَتَّی یَذْہَبَ ثُلُثُ اللَّیْلِ ، ثُمَّ یَنْزِلُ إِلَی السَّمَائِ الدُّنْیَا فَیَقُولُ : ہَلْ مِنْ مُسْتَغْفِرٍ ؟ ہَلْ مِنْ تَائِبٍ ؟ ہَلْ مِنْ دَاعٍ ؟ ہَلْ مِنْ سَائِلٍ ؟ حَتَّی یَنْفَجِرَ الْفَجْرُ۔ (بخاری ۶۳۲۱۔ مسلم ۵۲۳)","Sahih","Musannaf Ibn Abi Shaybah 30172","","","كتاب الدعاء"
"30173","(۳۰۱۷۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَن لَیْثٍ ، عَن شَہْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ ، عَنْ أَبِی ذَرٍّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَقُولُ اللَّہُ : یَا عِبَادِی ، کُلُّکُمْ مُذْنِبٌ إِلاَّ مَنْ عَافَیْتہ ، فَاسْتَغْفِرُونِی أَغْفِرْ لَکُمْ ، وَمَنْ عَلِمَ أَنِّی ذُو قُدْرَۃٍ عَلَی أَنْ أَغْفِرَ لَہُ غَفَرْت لَہُ ، وَلا أُبَالِی ، یَا عِبَادِی ، کُلُّکُمْ ضَالٌّ إِلاَّ مَنْ ہَدَیْتہ فَاسْتَہْدُونِی أَہْدِکُمْ ، یَا عِبَادِی ، کُلُّکُمْ فَقِیرٌ إِلاَّ مَنْ أَغْنَیْتہ فَاسْأَلُونِی أُعْطِکُمْ۔n(ترمذی ۲۴۹۵۔ احمد ۱۵۴)","Da'if","Musannaf Ibn Abi Shaybah 30173","","","كتاب الدعاء"
"30174","(۳۰۱۷۴) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَن مَنْصُورٍ ، عَن رِبْعِیِّ بْنِ حِرَاشٍ ، قَالَ : قَالَ عَبْدُ اللہِ بْنُ رَوَاحَۃَ : اللَّہُمَّ إنِّی أَسْأَلُک قُرَّۃَ عَیْنٍ لاَ تَرْتَدُّ وَنَعِیمًا لاَ یَنْفَدُ۔","","Musannaf Ibn Abi Shaybah 30174","","","كتاب الدعاء"
"30175","(۳۰۱۷۵) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عن منصور ، عَن رِبْعِیِّ بْنِ حِرَاشٍ ، قَالَ : قَالَ عَبْدُ اللہِ بْنُ رَوَاحَۃَ : اللَّہُمَّ إنِّی أَسْأَلُک قُرَّۃَ عَیْنٍ لاَ تَرْتَدُّ ، وَنَعِیمًا لاَ یَنْفَدُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ مِنْ ہَاتَیْنِ شَیْئٌ فِی الدُّنْیَا۔","","Musannaf Ibn Abi Shaybah 30175","","","كتاب الدعاء"
"30176","(۳۰۱۷۶) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْعَلائِ بْنِ الْمُسَیَّبِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا فَرَغَ مِنْ طَعَامِہِ ، قَالَ : الْحَمْدُ لِلَّہِ الَّذِی مَنَّ عَلَیْنَا فَہَدَانَا، وَالْحَمْدُ لِلَّہِ الَّذِی أَشْبَعَنَا وَأَرْوَانَا، وَکُلُّ بَلائٍ حَسَنٍ ، أَوْ صَالِحٍ أَبْلانَا۔ (نسائی ۱۰۱۳۳۔ ابن حبان ۵۲۱۹)","","Musannaf Ibn Abi Shaybah 30176","","","كتاب الدعاء"
"30177","(۳۰۱۷۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ، عَن حَجَّاجٍ ، عَن رِیَاحِ بْنِ عَبِیْدَۃَ مَوْلَی أَبِی سَعِیدٍ، عَنْ أبِی سَعِیدٍ ، قَالَ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَکَلَ طَعَامًا ، قَالَ : الْحَمْدُ لِلَّہِ الَّذِی أَطْعَمَنَا وَسَقَانَا وَجَعَلَنَا مُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 30177","","","كتاب الدعاء"
"30178","(۳۰۱۷۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنِ الْحَارِثِ بْنِ سُوَیْد ، قَالَ کَانَ سَلْمَانُ إذَا طَعِمَ ، قَالَ : الْحَمْدُ لِلَّہِ الَّذِی کَفَانَا الْمُؤْنَۃَ ، وَأَوْسَعَ لَنَا الرِّزْقَ۔","Sahih","Musannaf Ibn Abi Shaybah 30178","","","كتاب الدعاء"
"30179","(۳۰۱۷۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن حُصَیْنٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی سَعِیدٍ ، قَالَ : کَانَ أَبُو سَعِیدٍ إذَا وُضِعَ لَہُ الطَّعَامُ ، قَالَ : الْحَمْدُ لِلَّہِ الَّذِی أَطْعَمَنَا وَسَقَانَا وَجَعَلَنَا مُسْلِمِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 30179","","","كتاب الدعاء"
"30180","(۳۰۱۸۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی الْوَرْدِ ، عَنِ ابْنِ أَعْبَدَ ، أَو ابْنِ مَعْبَدٍ ، قَالَ ، قَالَ عَلِیٌّ : تَدْرِی مَا حَقُّ الطَّعَامِ ؟ قَالَ : قُلْتُ : وَمَا حَقُّہُ ؟ قَالَ : تَقُولُ : بِسْمِ اللہِ اللَّہُمَّ بَارِکْ لَنَا فِیمَا رَزَقْتنَا ، قَالَ: تَدْرِی مَا شُکْرُہُ ؟ قُلْتُ : وَمَا شُکْرُہُ ؟ قَالَ : تَقُولُ : الْحَمْدُ لِلَّہِ الَّذِی أَطْعَمَنَا وَسَقَانَا۔","Da'if","Musannaf Ibn Abi Shaybah 30180","","","كتاب الدعاء"
"30181","(۳۰۱۸۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَاصِمِ بْنِ أَبِی النَّجُودِ ، عَن ذَکْوَانَ أَبِی صَالِحٍ ، عَنْ عَائِشَۃَ ، أَنَّہُ قُدِّمَ إلَیْہَا طَعَامٌ فَقَالَتْ : ائْدِمُوہُ ، فَقَالُوا : وَمَا إدَامُہُ ؟ قَالَتْ : تَحْمَدُونَ اللَّہَ عَلَیْہِ إذَا فَرَغْتُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 30181","","","كتاب الدعاء"
"30182","(۳۰۱۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَأَبُو أُسَامَۃَ ، عَن زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَن سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إنَّ اللَّہَ لَیَرْضَی عَنِ الْعَبْدِ أَنْ یَأْکُلَ الأَکْلَۃَ فَیَحْمَدَہُ عَلَیْہَا ، أَوْ یَشْرَبَ الشَّرْبَۃَ فَیَحْمَدَہُ عَلَیْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 30182","","","كتاب الدعاء"
"30183","(۳۰۱۸۳) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ عَبْدِالرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ حَدَّثَنَا بِشْرُ بْنُ زِیَادٍ، عَن سُلَیْمَانَ بْنِ عَبْدِاللہِ، عَن عِتْرِیسِ بْنِ عُرْقُوبَ ، قَالَ : قَالَ عَبْدُ اللہِ: مَنْ قَالَ حِینَ یُوضَعُ طَعَامُہُ: بِسْمِ اللہِ، خَیْرُ الأَسْمَائِ فِی الأَرْضِ وَفِی السَّمَائِ لاَ یَضُرُّ مَعَ اسْمِہِ دَائٌ ، اللَّہُمَّ اجْعَلْ فِیہِ بَرَکَۃً وَعَافِیَۃً وَشِفَائً فَلا یَضُرُّہُ ذَلِکَ الطَّعَامُ مَا کَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 30183","","","كتاب الدعاء"
"30184","(۳۰۱۸۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن ہِشَامٍ ، قَالَ : کَانَ أَبِی لاَ یُؤْتَی بِطَعَامٍ وَلا شَرَابٍ حَتَّی الشَّرْبَۃِ مِنَ الدَّوَائِ فَیَشْرَبُہُ ، أَوْ یَطْعَمُہُ حَتَّی یَقُولَ : الْحَمْدُ لِلَّہِ الَّذِی ہَدَانَا وَأَطْعَمَنَا وَسَقَانَا وَنَعَّمَنَا ، اللَّہُ أَکْبَرُ ، اللَّہُمَّ أَلْفَتْنَا نِعْمَتَکَ بِکُلِّ شَرٍّ ، فَأَصْبَحْنَا وَأَمْسَیْنَا مِنْہَا بِکُلِّ خَیْرٍ نَسْأَلُک تَمَامَہَا وَشُکْرَہَا ، لاَ خَیْرَ إِلاَّ خَیْرُک ، وَلا إلَہَ غَیْرُک ، إلَہَ الصَّالِحِینَ وَرَبَّ الْعَالَمِینَ ، الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ ، لاَ إلَہَ إِلاَّ اللَّہُ ، مَا شَائَ اللَّہُ ، لاَ قُوَّۃَ إِلاَّ بِاللہِ ، اللَّہُمَّ بَارِکْ لَنَا فِیمَا رَزَقْتنَا وَقِنَا عَذَابَ النَّارِ۔","","Musannaf Ibn Abi Shaybah 30184","","","كتاب الدعاء"
"30185","(۳۰۱۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَن مِسْعَرٍ ، عَن ہِلالٍ ، عَن عُرْوَۃَ ، أَنَّہُ کَانَ إذَا وَضَعَ الطَّعَامَ ، قَالَ : سُبْحَانَک مَا أَحْسَنَ مَا تُبْلِینَا ، سُبْحَانَک مَا أَحْسَنَ مَا تُعْطِینَا ، رَبَّنَا وَرَبَّ آبَائِنَا الأَوَّلِینَ ، ثُمَّ یُسَمِّی اللَّہَ وَیَضَعُ یَدَہُ۔","","Musannaf Ibn Abi Shaybah 30185","","","كتاب الدعاء"
"30186","(۳۰۱۸۶) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ اللہِ ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَن تَمِیمِ بْنِ سَلَمَۃَ ، قَالَ : حُدِّثْتُ أَنَّ الرَّجُلَ إذَا ذَکَرَ اسْمَ اللہِ عَلَی طَعَامِہِ وَحَمِدَہُ عَلَی آخِرِہِ لَمْ یُسْأَلْ عَن نَعِیمِ ذَلِکَ الطَّعَامِ۔","","Musannaf Ibn Abi Shaybah 30186","","","كتاب الدعاء"
"30187","(۳۰۱۸۷) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَن حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : سُئِلَ ہَلْ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَرْفَعُ یَدَیْہِ ؟ قَالَ : نَعَمْ ، شَکَا النَّاسُ إلَیْہِ ذَاتَ جُمُعَۃٍ فَقَالُوا : یَا رَسُولَ اللہِ ، قُحِطَ الْمَطَرُ ، وَأَجْدَبَتِ الأَرْضُ ، وَہَلَکَ الْمَالُ ، قَالَ : فَرَفَعَ یَدَیْہِ حَتَّی رَأَیْت بَیَاضَ إبْطَیْہِ ، وَمَا فِی السَّمَائِ قَزَعَۃُ سَحَابٍ ، فَمَا صَلَّیْنَا حَتَّی إنَّ الشَّابَّ الْقَوِیَّ الْقَرِیبَ الْمَنْزِلِ لَیَہُمُّہُ الرُّجُوعُ إِلَی مَنْزِلِہِ ، قَالَ : فَدَامَتْ عَلَیْنَا جُمُعَۃٌ قَالَ فقالوا یا رسول اللہ تَہَدَّمَتِ الدُّورُ وَاحْتَبَسَ الرُّکْبَانُ ، قَالَ : فَتَبَسَّمَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ سُرْعَۃِ مَلالَۃِ ابْنِ آدَمَ فَقَالَ : اللَّہُمَّ حَوَالَیْنَا لاَ عَلَیْنَا ، قَالَ فأصحت السماء ۔","Sahih","Musannaf Ibn Abi Shaybah 30187","","","كتاب الدعاء"
"30188","(۳۰۱۸۸) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن مَنْصُورٍ ، عَنْ عَبْدِ اللہِ بْنِ یَسَارٍ ، عَن حُذَیْفَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ تَقُولُوا : مَا شَائَ اللَّہُ وَشَائَ فُلانٌ ، وَلَکِنْ قُولُوا : مَا شَائَ اللَّہُ ، ثُمَّ شَائَ فُلانٌ۔","Sahih","Musannaf Ibn Abi Shaybah 30188","","","كتاب الدعاء"
"30189","(۳۰۱۸۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَن یَزَیْدَ بْنِ الأَصَمِّ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَمِعَ رَجُلاً یَقُولُ : مَا شَائَ اللَّہُ وَشَائَ فُلانٌ ، فَقَالَ : جَعَلْتنِی لِلَّہِ عَدْلا ، قُلْ : مَا شَائَ اللَّہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30189","","","كتاب الدعاء"
"30190","(۳۰۱۹۰) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَن تَمِیمِ بْنِ طَرَفَۃَ الطَّائِیِّ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، أَنَّ رَجُلاً خَطَبَ عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : مَنْ یُطِعِ اللَّہَ وَرَسُولَہُ ، فَقَدْ رَشَدَ ، وَمَنْ یَعْصِہِمَا ، فَقَدْ غَوَی ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : بِئْسَ الْخَطِیبُ أَنْتَ ، قُلْ : وَمَنْ یَعْصِ اللَّہَ وَرَسُولَہُ۔ (مسلم ۵۹۴۔ ابوداؤد ۱۰۹۲)","Sahih","Musannaf Ibn Abi Shaybah 30190","","","كتاب الدعاء"
"30191","(۳۰۱۹۱) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَن مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: خَطَبَ رَجُلٌ عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ: مَنْ یُطِعَ اللَّہَ وَرَسُولَہُ ، فَقَدْ رَشَدَ ، وَمَنْ یَعْصِہِمَا ، فَقَدْ غَوَی ، قَالَ : فَتَغَیَّرَ وَجْہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَکَرِہَ ذَلِکَ، فَقَالَ: إبْرَاہِیمُ: فَکَانُوا یَکْرَہُونَ أَنْ یَقُولَ: وَمَنْ یَعْصِہِمَا، وَلَکِنْ یَقُولُ: مَنْ یَعْصِ اللَّہَ وَرَسُولَہُ۔","","Musannaf Ibn Abi Shaybah 30191","","","كتاب الدعاء"
"30192","(۳۰۱۹۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ دَعَا عَلَی مَنْ ظَلَمَہُ ، فَقَدِ انْتَصَرَ۔ (ترمذی ۳۵۵۲۔ ابویعلی ۴۴۳۷)","Da'if","Musannaf Ibn Abi Shaybah 30192","","","كتاب الدعاء"
"30193","(۳۰۱۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن حَبِیبٍ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ قَالَتْ : سَرَقَہَا سَارِقٌ فَدَعَتْ عَلَیْہِ ، فَقَالَ : لَہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُسَبِّخِی عَنْہُ۔ (ابوداؤد ۱۴۹۲۔ احمد ۱۳۶)","Sahih","Musannaf Ibn Abi Shaybah 30193","","","كتاب الدعاء"
"30194","(۳۰۱۹۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَن عُثْمَانَ بْنِ عَبْدِ اللہِ بْنِ مُوہِبٍ ، عَن مُوسَی بْنِ طَلْحَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَلِمَاتٌ إذَا قَالَہُنَّ الْعَبْدُ وَضَعَہُنَّ مَلَکُ فی جَنَاحِہِ ، ثُمَّ عَرَجَ بِہِنَّ فَلا یَمُرُّ عَلَی مَلأٍ مِنَ الْمَلائِکَۃِ إِلاَّ صَلَّوْا عَلَیْہِنَّ وَعَلَی قَائِلِہِنَّ حَتَّی یُوضَعن بَیْنَ یَدَیِ الرَّحْمَن : سُبْحَانَ اللہِ ، وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ ، وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ وَسُبْحَانَ اللہِ أنزاہ اللَّہُ عَنِ السُّوئِ۔ (طبرانی ۶۷۴۱)","","Musannaf Ibn Abi Shaybah 30194","","","كتاب الدعاء"
"30195","(۳۰۱۹۵) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَن حُصَیْنٍ ، قَالَ : الْتَقَی إبْرَاہِیمُ ، وَمُجَاہِدٌ فَقَالا : جَائَ أَعْرَابِیٌّ إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَشَکَا إلَیْہِ الْجُوعَ ، قَالَ : فَدَخَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلَی بُیُوتِہِ ، ثُمَّ خَرَجَ فَقَالَ : مَا وَجَدْت لَکَ فِی بُیُوتِ آلِ مُحَمَّدٍ شَیْئًا ، قَالَ : فَبَیْنَمَا ہُوَ کَذَلِکَ إذْ جَائَتْہُ شَاۃٌ مَصْلِیَّۃٌ ، وَقَالَ الآخَرُ جَائَتْہُ قَصْعَۃٌ مِنْ ثَرِیدٍ ، فَوُضِعَتْ بَیْنَ یَدَیَ الأَعْرَابِی ، فَقَالَ لہ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اطْعَمْ ، قَالَ : فَأَکَلَ ، فَقَالَ : یَا رَسُولَ اللہِ أَصَابَنِی الَّذِی أَصَابَنِی ، فَرَزَقَنِی اللَّہُ عَلَی یَدَیْک ، أَفَرَأَیْت إِنْ أَصَابَنِی ، وَأَنَا لَسْت عِنْدَکَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قُلِ : اللَّہُمَّ إنِّی أَسْأَلُک مِنْ فَضْلِکَ وَرَحْمَتِکَ ، فَإِنَّہُ لاَ یَمْلِکُہُمَا إِلاَّ أَنْتَ ، فَإِنَّ اللَّہَ رَازِقُک۔ (طبرانی ۱۰۳۷۹)","","Musannaf Ibn Abi Shaybah 30195","","","كتاب الدعاء"
"30196","(۳۰۱۹۶) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، حَدَّثَنَا وَائِلُ بْنُ دَاوُد ، قَالَ : سَمِعْتُ الْحَسَنَ الْبَصْرِیَّ یُحَدِّثُ ، قَالَ : بَیْنَمَا رَجُلٌ رَأَی فِی الْمَنَامِ ، أَنَّ مُنَادِیًا یُنَادِی فِی السَّمَائِ ، أَیُّہَا النَّاسُ ، خُذُوا سِلاحَ فَزَعِکُمْ ، فَعَمَدَ النَّاسُ فَأَخَذُوا السِّلاحَ حَتَّی إنَّ الرَّجُلَ یَجِیئُ، وَمَا مَعَہُ عَصًا ، فَنَادَی مُنَادٍ مِنَ السَّمَائِ : لَیْسَ ہَذَا سِلاحَ فَزَعِکُمْ، فَقَالَ رَجُلٌ مِنْ أَہْلِ الأَرْضِ: مَا سِلاحُ فَزَعِنَا ، فَقَالَ : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ۔","","Musannaf Ibn Abi Shaybah 30196","","","كتاب الدعاء"
"30197","(۳۰۱۹۷) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ عَن سُلَیْمَانَ بْنِ صُرَدٍ ، أَنَّ رَجُلَیْنِ تَلاحَیَا فَاشْتَدَّ غَضَبُ أَحَدِہِمَا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی لأعْرِفُ کَلِمَۃً لَوْ قَالَہَا ذَہَبَ غَضَبُہُ : أَعُوذُ بِاللہِ مِنَ الشَّیْطَانِ الرَّجِیمِ۔ (مسلم ۲۰۱۵۔ نسائی ۱۰۲۲۴)","Sahih","Musannaf Ibn Abi Shaybah 30197","","","كتاب الدعاء"
"30198","(۳۰۱۹۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَن مُعَاذِ بْنِ جَبَلٍ ، قَالَ : اسْتَبَّ رَجُلانِ عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَغَضِبَ أَحَدُہُمَا غَضَبًا شَدِیدًا حَتَّی إنِّی لَیُخَیَّلُ إلَیَّ أَنَّ أَنْفَہُ تَمَزَّعَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی لأَعْرِفُ کَلِمَۃً لَوْ قَالَہَا ہَذَا الْغَضْبَانُ ذَہَبَ غَضَبُہُ : أَعُوذُ بِاللہِ مِنَ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 30198","","","كتاب الدعاء"
"30199","(۳۰۱۹۹) حَدَّثَنَا قُرَادٌ أَبُو نُوحٍ حَدَّثَنَا عِکْرِمَۃُ بْنُ عَمَّارٍ حَدَّثَنَا سِمَاکٌ الْحَنَفِیُّ ، قَالَ أَبُو زَمِیلٍ حَدَّثَنِی ابْنُ عَبَّاسٍ ، قَالَ : حدَّثَنِی عُمَرُ بْنُ الْخَطَّابِ ، قَالَ : لَمَّا کَانَ یَوْمُ بَدْرٍ اسْتَقْبَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْقِبْلَۃَ ، ثُمَّ مَدَّ یَدَیْہِ ثُمَّ قَالَ : اللَّہُمَّ أَنْجِزْ لِی مَا وَعَدْتنِی ، اللَّہُمَّ ائْتِنِی مَا وَعَدْتنِی ، اللَّہُمَّ إنَّک إِنْ تُہْلِکْ ہَذِہِ الْعِصَابَۃَ مِنْ أَہْلِ الإِسْلامِ فَلا تُعْبَدْ فِی الأَرْضِ أَبَدًا ، فَمَا زَالَ یَسْتَغِیثُ رَبَّہُ وَیَدْعُو حَتَّی سَقَطَ رِدَاؤُہُ ، فَأَنْزَلَ اللَّہُ عَزَّ وَجَلَّ : {إذْ تَسْتَغِیثُونَ رَبَّکُمْ فَاسْتَجَابَ لَکُمْ أَنِّی مُمِدُّکُمْ بِأَلْفٍ مِنَ الْمَلائِکَۃِ مُرْدِفِینَ}۔n(مسلم ۱۳۸۳۔ ترمذی ۳۰۸۱)","Sahih","Musannaf Ibn Abi Shaybah 30199","","","كتاب الدعاء"
"30200","(۳۰۲۰۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : کَانَ من دعاء النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ حُنَیْنٍ : اللَّہُمَّ إنَّک إِنْ تَشَأْ لاَ تُعْبَدْ بَعْدَ الْیَوْمِ۔ (مسلم ۱۳۶۳۔ احمد ۱۲۱)","Sahih","Musannaf Ibn Abi Shaybah 30200","","","كتاب الدعاء"
"30201","(۳۰۲۰۱) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا لَقِیَ الْعَدُوَّ ، قَالَ : اللَّہُمَّ أَنْتَ عَضُدِی وَنَصِیرِی ، بِکَ أُحَاوِلُ وَبِکَ أَصُولُ وَبِکَ أُقَاتِلُ۔n(ابوداؤد ۲۶۲۵۔ ترمذی ۳۵۸۴)","","Musannaf Ibn Abi Shaybah 30201","","","كتاب الدعاء"
"30202","(۳۰۲۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، قَالَ : سَمِعْتُ ابْنَ أَبِی أَوْفَی یَقُولُ : دَعَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی الأَحْزَابِ فَقَالَ : اللَّہُمَّ مُنْزِلَ الْکِتَابِ ، سَرِیعَ الْحِسَابِ ، ہَازِمَ الأَحْزَابِ ، اہْزِمْہُمْ وَزَلْزِلْہُمْ۔ (بخاری ۶۳۹۲۔ مسلم ۱۳۶۳)","Sahih","Musannaf Ibn Abi Shaybah 30202","","","كتاب الدعاء"
"30203","(۳۰۲۰۳) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَن مُطَرِّفٍ ، عَنْ عَطِیَّۃَ ، عَنِ ابْنِ عَبَّاسٍ فِی قولہ تعالی : {فَإِذَا نُقِرَ فِی النَّاقُورِ} قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَیْفَ أَنْعَمُ وَصَاحِبُ الْقَرْنِ قَدِ الْتَقَمَ الْقَرْنَ وَحَنَی جَبْہَتَہُ یَسْتمِعُ مَتَی یُؤْمَرُ ، فَیَنْفُخُ ، فَقَالَ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَیْفَ نَقُولُ ؟ قَالَ : قُولُوا : {حَسْبُنَا اللَّہُ وَنِعْمَ الْوَکِیلُ} عَلَی اللہِ تَوَکَّلْنَا۔ (طبرانی ۱۲۶۷۰)","Da'if","Musannaf Ibn Abi Shaybah 30203","","","كتاب الدعاء"
"30204","(۳۰۲۰۴) حَدَّثَنَا وَکِیعٌ ، عَن زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : لَمَّا أُلْقِیَ إبْرَاہِیمُ عَلَیْہِ السَّلامُ فِی النَّارِ ، قَالَ : حَسْبُنَا اللَّہُ وَنِعْمَ الْوَکِیلُ۔","Sahih","Musannaf Ibn Abi Shaybah 30204","","","كتاب الدعاء"
"30205","(۳۰۲۰۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : التَّوَکُّلُ عَلَی اللہِ جِمَاعُ الإِیمَانِ۔","","Musannaf Ibn Abi Shaybah 30205","","","كتاب الدعاء"
"30206","(۳۰۲۰۶) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، عَن مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سَلِ اللَّہَ لِی الْوَسِیلَۃَ لاَ یَسْأَلُہَا لِی مُؤْمِنٌ فِی الدُّنْیَا إِلاَّ کُنْت لَہُ شَہِیدًا ، أَوْ شَفِیعًا یَوْمَ الْقِیَامَۃِ۔ (بخاری ۶۱۴۔ ابوداؤد ۵۳۰)","Da'if","Musannaf Ibn Abi Shaybah 30206","","","كتاب الدعاء"
"30207","(۳۰۲۰۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی الْعَلائِ ، عَن عُثْمَانَ بْنِ أَبِی الْعَاصِ ، أَنَّہُ أتَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : یَا رَسُولَ اللہِ ، إنَّ الشَّیْطَانَ حَالَ بَیْنَ صَلاتِی وَقِرَائَتِی ، فَقَالَ : ذَاکَ شَیْطَانٌ یُقَالُ لَہُ : خَنْزَبُ فَإِذَا أَحْسَسْت بِہِ فَاتْفُلْ عَلَی یَسَارِکَ ثَلاثًا وَتَعَوَّذْ بِاللہِ مِنْ شَرِّہِ","Sahih","Musannaf Ibn Abi Shaybah 30207","","","كتاب الدعاء"
"30208","(۳۰۲۰۸) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی جَعْفَرٍ الْخِطْمِیِّ ، عَن مُحَمَّدِ بْنِ کَعْبٍ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ الْخِطْمِیِّ ، أَنَّہُ کَانَ یَقُولُ : اللَّہُمَّ ارْزُقْنِی حُبَّک وَحُبَّ مَنْ یَنْفَعُنِی حُبُّہُ عِنْدَکَ ، اللَّہُمَّ وَارْزُقْنِی مَا أُحِبُّ وَاجْعَلْہُ قُوَّۃً لِی فِیمَا تُحِبُّ ، وَمَا زَوَیْت عَنِّی مِمَّا أُحِبُّ فَاجْعَلْہُ لِی فَرَاغًا فِیمَا تُحِبُّ۔","Sahih","Musannaf Ibn Abi Shaybah 30208","","","كتاب الدعاء"
"30209","(۳۰۲۰۹) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَن حُصَیْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ مِنَّا رَجُلٌ یُقَالُ لَہُ ہَمَّامُ بْنُ الْحَارِثِ ، وَکَانَ لاَ یَنَامُ إِلاَّ قَاعِدًا فِی مَسْجِدِہِ فِی صَلاتِہِ ، وَکَانَ یَقُولُ : اللَّہُمَّ اشْفِنِی مِنَ النَّوْمِ بِیَسِیرٍ وَارْزُقْنِی سَہَرًا فِی طَاعَتِک۔","","Musannaf Ibn Abi Shaybah 30209","","","كتاب الدعاء"
"30210","(۳۰۲۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَأَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، قَالَ : حدَّثَنَا زِیَادُ بْنُ عِلاقَۃَ ، عَنْ عَمِّہِ قُطْبَۃَ بْنِ مَالِکٍ، أَنَّہُ کَانَ یَقُولُ اللَّہُمَّ جَنِّبْنِی مُنْکَرَاتِ الأَعْمَالِ وَالأَخْلاقِ وَالأَہْوَائِ وَالأَدْوَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 30210","","","كتاب الدعاء"
"30211","(۳۰۲۱۱) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنِ الْہَیْثَمِ عَن طَلْحَۃَ ، عَن مُجَاہِدٍ ، قَالَ : کَانَ یَتَعَوَّذُ مِنَ الأَسَدِ وَالأَسْوَدِ وَرُوحِ الأَذَی۔","","Musannaf Ibn Abi Shaybah 30211","","","كتاب الدعاء"
"30212","(۳۰۲۱۲) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنِ الأَعْمَشِ ، عَن طَلْحَۃَ الْیَامِیِّ ، عَنْ أَبِی إدْرِیسَ رَجُلٌ مِنْ أَہْلِ الْیَمَنِ قَالَ : کَانَ یَقُولُ : اللَّہُمَّ اجْعَلْ نَظَرِی عِبَرًا وَصَمْتِی تَفَکُّرًا وَمَنْطِقِی ذِکْرًا۔","","Musannaf Ibn Abi Shaybah 30212","","","كتاب الدعاء"
"30213","(۳۰۲۱۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلابَۃَ ، أَنَّہُ قَالَ فِی دُعَائِہِ : اللَّہُمَّ إنِّی أَسْأَلُک الطَّیِّبَاتِ وَتَرْکَ الْمُنْکَرَاتِ وَحُبَّ الْمَسَاکِینِ وَأَنْ تَتُوبَ عَلَی ، وَإِذَا أَرَدْت بِعِبَادِکَ فِتْنَۃً فَتَوَفَّنِی غَیْرَ مَفْتُونٍ۔","","Musannaf Ibn Abi Shaybah 30213","","","كتاب الدعاء"
"30214","(۳۰۲۱۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، حَدَّثَنَا مُوسَی بْنُ مُسْلِمٍ الطَّحَّانُ عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ، قَالَ : کَانَ نَفَرٌ مُتَوَاخِینَ ، قَالَ : فَفَقَدُوا رَجُلاً مِنْہُمْ أَیَّامًا ، ثُمَّ أَتَاہُمْ فَقَالُوا : أَیْنَ کُنْت ؟ فَقَالَ : دَیْنٌ کَانَ عَلَیَّ فَقَالَ : ہَلاَّ دَعَوْت بہَؤُلائِ الدَّعَوَاتِ : اللَّہُمَّ مُنَفِّسَ کُلِّ کَرْبٍ وَفَارِجَ کُلِّ ہَمٍّ وَکَاشِفَ کُلِّ غَمٍّ وَمُجِیبَ دَعْوَۃِ الْمُضْطَرِّینَ رَحْمَنَ الدُّنْیَا وَالآخِرَۃِ وَرَحِیمَہُمَا ، أَنْتَ رَحْمَانِی فَارْحَمْنِی یَا رَحْمَنُ رَحْمَۃً تُغْنِینِی بِہَا عَن رَحْمَۃِ مَنْ سِوَاک۔","","Musannaf Ibn Abi Shaybah 30214","","","كتاب الدعاء"
"30215","(۳۰۲۱۵) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَن دَاوُد ، عَنِ الشَّعْبِیِّ ، قَالَ : دَخَلْنَا عَلَی رَبِیعِ بْنِ خُثَیْمٍ ، فَدَعَا بِہَذِہِ الدَّعَوَاتِ : اللَّہُمَّ لَکَ الْحَمْدُ کُلُّہُ وَبِیَدِکَ الْخَیْرُ کُلُّہُ ، وَإِلَیْک یَرْجِعُ الأَمْرُ کُلُّہُ ، وَأَنْتَ إلَہُ الْخَلْقِ کُلِّہِ ، نَسْأَلُک مِنَ الْخَیْرِ کُلِّہِ ، وَنَعُوذُ بِکَ مِنَ الشَّرِّ کُلِّہِ۔","","Musannaf Ibn Abi Shaybah 30215","","","كتاب الدعاء"
"30216","(۳۰۲۱۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا عَلِیُّ بْنُ مَسْعَدَۃَ ، عَنْ عَبْدِ اللہِ الرُّومِیِّ ، قَالَ : کُنَّا عنْدَ أَنَسِ بْنِ مَالِکٍ فَقَالَ لَہُ رَجُلٌ : یَا أَبَا حَمْزَۃَ ، إنَّ إخْوَانَک یُحِبُّونَ أَنْ تَدْعُوَ لَہُمْ ، فَقَالَ : اللَّہُمَّ اغْفِرْ لَنَا وَارْحَمْنَا وَآتِنَا فِی الدُّنْیَا حَسَنَۃً وَفِی الآخِرَۃِ حَسَنَۃً وَقِنَا عَذَابَ النَّارِ ، قَالُوا : زِدْنَا یَا أَبَا حَمْزَۃَ ، فَرَدَّہَا عَلَیْہِمْ ، قَالُوا : زِدْنَا یَا أَبَا حَمْزَۃَ ، قَالَ : حَسْبُنَا اللَّہُ یَا أَبَا فُلانٍ ، إِنْ أُعْطِینَاہَا ، فَقَدْ أُعْطِینَا خَیْرَ الدُّنْیَا وَالآخِرَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 30216","","","كتاب الدعاء"
"30217","(۳۰۲۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ ، عَن تُبَیْعٍ ، عَن کَعْبٍ ، قَالَ : لَوْلا کَلِمَاتٌ أَقُولُہُنَّ لَجَعَلَتْنِی الْیَہُودُ أَصِیحُ مَعَ الْحُمْرِ النَّاہِقَۃِ وَأَعْوِی مَعَ الْکِلابِ الْعَاوِیَۃِ ، أَعُوذُ بِوَجْہِکَ الْکَرِیمِ وَبِاسْمِکَ الْعَظِیمِ وَبِکَلِمَاتِکَ التَّامَّۃِ الَّتِی لاَ یُجَاوِزُہُنَّ بَرٌّ ، وَلا فَاجِرٌ ، الَّذِی لاَ یَخْفِرُ جَارُہُ مِنْ شَرِّ مَا یَنْزِلُ مِنَ السَّمَائِ ، وَمَا یَعْرُجُ فِیہَا ، وَمِنْ شَرِّ مَا خَلَقَ وَذَرَأَ وَبَرَأَ۔","","Musannaf Ibn Abi Shaybah 30217","","","كتاب الدعاء"
"30218","(۳۰۲۱۸) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ عَوْنٍ ، قَالَ : قالَتْ أَسْمَائُ بِنْتُ أَبِی بَکْرٍ : مَنْ قَرَأَ بَعْدَ الْجُمُعَۃِ فَاتِحَۃَ الْکِتَابِ وَ(قُلْ ہُوَ اللَّہُ أَحَدٌ) وَ(قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ) وَ(قُلْ أَعُوذُ بِرَبِّ النَّاسِ) حَفِظَ مَا بَیْنَہُ وَبَیْنَ الْجُمُعَۃِ الأخری۔","Sahih","Musannaf Ibn Abi Shaybah 30218","","","كتاب الدعاء"
"30219","(۳۰۲۱۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَن فِرَاسٍ ، عَن شَیْبَانَ ، عَنِ الشَّعْبِیِّ ، عَنْ أَبِی مُسْلِمٍ ، أَنَّہُ کَانَ یَقُولُ فِی آخِرِ قَوْلِہِ : وَصَلَ اللَّہُ بِالإِیمَانِ أُخُوَّتَکُمْ وَقَرَّبَ بِرَحْمَتِہِ مَوَدَّتَکُمْ ، وَمَکَّنَ بِإِحْسَانِہِ کَرَامَتَکُمْ ، وَنَوَّرَ بِالْقُرْآنِ صُدُورَکُمْ۔","","Musannaf Ibn Abi Shaybah 30219","","","كتاب الدعاء"
"30220","(۳۰۲۲۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، سُلَیْمَانُ بْنُ حَیَّانَ ، عَن مُحَمَّدِ بْنِ عَجْلانَ ، عَن سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَن عُقْبَۃَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا سَأَلَ سَائِلٌ ، وَلا اسْتَعَاذَ مُسْتَعِیذٌ بِمِثْلِہِمَا، یَعْنِی الْمُعَوِّذَتَیْنِ۔ (ابوداؤد ۱۴۵۸۔ دارمی ۳۴۴۰)","Hasan","Musannaf Ibn Abi Shaybah 30220","","","كتاب الدعاء"
"30221","(۳۰۲۲۱) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، أَنَّ الْحَسَنَ بْنَ عَلِیِّ بْنِ أَبِی طَالِبٍ کَانَ یَقُولُ إذَا طَلَعَتِ الشَّمْسُ : سَمِعَ سَامِعٌ بِحَمْدِ اللہِ الأَعْظَمِی ، لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، سَمِعَ سَامِعٌ بِحَمْدِ اللہِ الأَکْبَرِی ، لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، سَمِعَ سَامِعٌ بِحَمْدِ اللہِ الأَمْجَدِی ، لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، یَتْبَعُ ہَذَا النَّحْوَ۔","Sahih","Musannaf Ibn Abi Shaybah 30221","","","كتاب الدعاء"
"30222","(۳۰۲۲۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن سِمَاکٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَرَادَ أَنْ یَخْرُجَ فِی سَفَرٍ قَالَ : اللَّہُمَّ أَنْتَ الصَّاحِبُ فِی السَّفَرِ وَالْخَلِیفَۃُ فِی الأَہْلِ اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْضُّبْنَۃِ فِی السَّفَرِ ، وَالْکَآبَۃِ فِی الْمُنْقَلَبِ ، اللَّہُمَّ اقْبِضْ لَنَا الأَرْضَ وَہَوِّنْ عَلَیْنَا السَّفَرَ۔ (احمد ۲۹۹۔ ابن حبان ۲۷۱۶)","","Musannaf Ibn Abi Shaybah 30222","","","كتاب الدعاء"
"30223","(۳۰۲۲۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَاصِمٍ ، عَنْ عَبْدِ اللہِ بْنِ سَرْجِسَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا خَرَجَ مُسَافِرًا یَتَعَوَّدُ مِنْ وَعْثَائِ السَّفَرِ وَکَآبَۃِ الْمُنْقَلَبِ وَالْحَوْرِ بَعْدَ الْکَوْرِ ، وَمِنْ دَعْوَۃِ الْمَظْلُومِ وَمِنْ سُوئِ الْمَنْظَرِ فِی الأَہْلِ وَالْمَالِ۔ (مسلم ۹۷۹۔ احمد ۸۳)","Sahih","Musannaf Ibn Abi Shaybah 30223","","","كتاب الدعاء"
"30224","(۳۰۲۲۴) حَدَّثَنَا وَکِیعٌ ، عَن أُسَامَۃَ بْنِ زَیْدٍ ، عَن سَعِیدٍ الْمَقْبُرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أَرَادَ رَجُلٌ سَفَرًا فَأَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : أَوْصِنِی ، فَقَالَ : أُوصِیک بِتَقْوَی اللہِ وَالتَّکْبِیرِ عَلَی کُلِّ شَرَفٍ۔ (ترمذی ۳۴۴۵۔ احمد ۴۴۳)","Hasan","Musannaf Ibn Abi Shaybah 30224","","","كتاب الدعاء"
"30225","(۳۰۲۲۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ عَجْلانَ ، قَالَ : حدَّثَنِی عَوْنُ بْنُ عَبْدِ اللہِ ، أَنَّ رَجُلاً أَتَی ابْنَ مَسْعُودٍ فَقَالَ : إنِّی أُرِیدُ سَفَرًا فَأَوْصِنِی ، فَقَالَ : إذَا تَوَجَّہْت فَقُلْ : بِسْمِ اللہِ حَسْبِی اللَّہُ وَتَوَکَّلْت عَلَی اللہِ فَإِنَّک إذَا قُلْتَ : بِسْمِ اللہِ ، قَالَ الْمَلَکُ : ہُدِیْتَ وَإِذَا قُلْتَ : حَسْبِی اللَّہُ ، قَالَ الْمَلَک ، حُفِظْت ، وَإِذَا قُلْتَ : تَوَکَّلْت عَلَی اللہِ ، قَالَ الْمَلَکُ : کُفِیت۔","","Musannaf Ibn Abi Shaybah 30225","","","كتاب الدعاء"
"30226","(۳۰۲۲۶) حَدَّثَنَا ہُشَیْمٌ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَقُولُونَ فِی السَّفَرِ : اللَّہُمَّ بَلاغًا یُبَلِّغُ خَیْرًا مَغْفِرَتِکَ مِنْک وَرِضْوَانًا ، بِیَدِکَ الْخَیْرُ ، إنَّک عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، اللَّہُمَّ أَنْتَ الصَّاحِبُ فِی السَّفَرِ وَالْخَلِیفَۃُ عَلَی الأَہْلِ ، اللَّہُمَّ اطْوِ لَنَا الأَرْضَ وَہَوِّنْ عَلَیْنَا السَّفَرَ ، اللَّہُمَّ إنَّا نَعُوذُ بِکَ مِنْ وَعْثَائِ السَّفَرِ وَکَآبَۃِ الْمُنْقَلَبِ وَسُوئِ الْمَنْظَرِ فِی الأَہْلِ وَالْمَالِ۔","","Musannaf Ibn Abi Shaybah 30226","","","كتاب الدعاء"
"30227","(۳۰۲۲۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن یَزِیدَ ، عَن مُجَاہِدٍ ، قَالَ : سَافَرْت مَعَ ابْنِ عُمَرَ فَإِذَا کَانَ مِنَ السَّحَرِ نَادَی : سَمِعَ سَامِعٌ بِحَمْدِ اللہِ وَنِعْمَتِہِ وَحُسْنِ بَلائِہِ عِنْدَنَا ، اللَّہُمَّ صَاحِبْنَا فَأَفْضِلْ عَلَیْنَا ثَلاثًا اللَّہُمَّ عَائِذٌ بِکَ مِنْ جَہَنَّمَ ثَلاثًا۔","Da'if","Musannaf Ibn Abi Shaybah 30227","","","كتاب الدعاء"
"30228","(۳۰۲۲۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن سِمَاکٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا أَرَادَ الرُّجُوعَ ، یعنی مِنَ السَّفَرِ قَالَ : تَائِبُونَ عَابِدُونَ لِرَبِّنَا حَامِدُونَ ، وَإِذَا دَخَلَ عَلَی أَہْلِہِ ، قَالَ : تَوْبًا تَوْبًا لِرَبِّنَا أَوْبًا لاَ یُغَادِرُ عَلَیْنَا حَوْبًا۔","","Musannaf Ibn Abi Shaybah 30228","","","كتاب الدعاء"
"30229","(۳۰۲۲۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا قَفَلَ مِنْ سَفَرٍ ، قَالَ : آیِبُونَ تَائِبُونَ عَابِدُونَ لِرَبِّنَا حَامِدُونَ۔ (احمد ۳۰۰۔ طیالسی ۷۱۶)","Sahih","Musannaf Ibn Abi Shaybah 30229","","","كتاب الدعاء"
"30230","(۳۰۲۳۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، حَدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ کَانَ إذَا رَجَعَ مِنَ الْجَیْشِ ، أَوِ السَّرَایَا ، أَوِ الْحَجِّ ، أَوِ الْعُمْرَۃِ ، قَالَ کُلَّمَا أَوْفَی عَلَی ثَنِیَّۃٍ ، أَوْ فَدْفَدٍ کَبَّرَ ثَلاثًا ، ثُمَّ قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ صَدَقَ وَعْدَہُ تَائِبُونَ عَابِدُونَ لِرَبِّنَا حَامِدُونَ۔ (بخاری ۱۷۹۷۔ مسلم ۹۸۰)","Sahih","Musannaf Ibn Abi Shaybah 30230","","","كتاب الدعاء"
"30231","(۳۰۲۳۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، حَدَّثَنَا عُبَیْدُ اللہِ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ ذَکَرَ مِثْلَہُ ، أَوْ نَحْوَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30231","","","كتاب الدعاء"
"30232","(۳۰۲۳۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، حَدَّثَنَا سَعِیدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن یَحْیَی بْنِ أَبِی إِسْحَاقَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، أَنَّہُ کَانَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا کَانَ بِظَہْرِ الْبَیْدَائَ ، أَو بالْحَرَّۃَ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ آیِبُونَ تَائِبُونَ عَابِدُونَ إِنْ شَائَ اللَّہُ لِرَبِّنَا حَامِدُونَ۔ (بخاری ۳۰۸۵۔ مسلم ۹۸۰)","Sahih","Musannaf Ibn Abi Shaybah 30232","","","كتاب الدعاء"
"30233","(۳۰۲۳۳) حَدَّثَنَا ہُشَیْمٌ ، أَخْبَرَنَا الْعَوَّامُ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : کَانُوا إذَا قَفَلُوا قَالُوا : آیِبُونَ إِنْ شَائَ اللَّہُ تَائِبُونَ لِرَبِّنَا حَامِدُونَ۔","","Musannaf Ibn Abi Shaybah 30233","","","كتاب الدعاء"
"30234","(۳۰۲۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : حدَّثَنَا مَکْحُولٌ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمَّا دَخَلَ مَکَّۃَ تَلَقَّتْہُ الْجِنُّ بِالشَّرَرِ یَرْمُونَہُ ، فَقَالَ جِبْرِیلُ : تَعَوَّذْ یَا مُحَمَّدُ ، فَتَعَوَّذَ بِہَؤُلائِ الْکَلِمَاتِ فَدُحِرُوا عَنْہُ ، أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّاتِ الَّتِی لاَ یُجَاوِزُہُنَّ بَرٌّ ، وَلا فَاجِرٌ ، مِنْ شَرِّ مَا یَنْزِلُ مِنَ السَّمَائِ ، وَمَا یَعْرُجُ فِیہَا ، وَمِنْ شَرِّ مَا بُثَّ فِی الأَرْضِ ، وَمَا یَخْرُجُ مِنْہَا ، وَمِنْ شَرِّ اللَّیْلِ وَالنَّہَارِ ، وَمِنْ کُلِّ طَارِقٍ یَطْرُقُ بِخَیْرٍ یَا رَحْمَنُ۔","","Musannaf Ibn Abi Shaybah 30234","","","كتاب الدعاء"
"30235","(۳۰۲۳۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَن مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، أَنَّ الْوَلِیدَ بْنَ الْوَلِیدِ بْنِ الْمُغِیرَۃِ الْمَخْزُومِیَّ شَکَا إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَدِیثَ نَفْسٍ وَجَدَہُ وَأَنَّہُ قَالَ لَہُ : إذَا أَتَیْتَ إِلَی فِرَاشِکَ فَقُلْ : أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّۃِ مِنْ غَضَبِہِ وَعِقَابِہِ ، وَشَرِّ عِبَادِہِ ، وَمِنْ ہَمَزَاتِ الشَّیَاطِینِ وَأَنْ یَحْضُرُونِ ، فَو الَّذِی نَفْسِی بِیَدِہِ لاَ یَضُرُّک شَیْئٌ حَتَّی تُصْبِحَ۔","","Musannaf Ibn Abi Shaybah 30235","","","كتاب الدعاء"
"30236","(۳۰۲۳۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَن زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَن مُصْعَبٍ ، عَن یَحْیَی بْنِ جَعْدَۃَ ، قَالَ : کَانَ خَالِدُ بْنُ الْوَلِیدِ یَفْزَعُ مِنَ اللَّیْلِ حَتَّی یَخْرُجَ ، وَمَعَہُ سَیْفُہُ فَخُشِیَ عَلَیْہِ أَنْ یُصِیبَ أَحَدًا ، فَشَکَا ذَلِکَ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : إنَّ جِبْرِیلَ ، قَالَ لِی : إنَّ عِفْرِیتًا مِنَ الْجِنِّ یَکِیدُک ، فَقُلْ أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّۃِ الَّتِی لاَ یُجَاوِزُہُنَّ بَرٌّ ، وَلا فَاجِرٌ ، مِنْ شَرِّ مَا یَنْزِلُ مِنَ السَّمَائِ ، وَمَا یَعْرُجُ فِیہَا ، وَمِنْ شَرِّ مَا ذَرَأَ فِی الأَرْضِ ، وَمَا یَخْرُجُ مِنْہَا ، وَشَرِّ فِتَنِ اللَّیْلِ وَالنَّہَارِ ، وَکُلِّ طَارِقٍ إِلاَّ طَارِقًا یَطْرُقُ بِخَیْرٍ یَا رَحْمَنُ فَقَالَہُنَّ خَالِدٌ فَذَہَبَ ذَلِکَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 30236","","","كتاب الدعاء"
"30237","(۳۰۲۳۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا فَزِعَ أَحَدُکُمْ مِنْ نَوْمِہِ فَلْیَقُلْ : بِسْمِ اللہِ أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّۃِ مِنْ غَضَبِہِ وَسُوئِ عِقَابِہِ وَشَرِّ عِبَادِہِ وَمِنْ شَرِّ الشَّیَاطِینِ ، وَمَا یَحْضُرُونِ۔","","Musannaf Ibn Abi Shaybah 30237","","","كتاب الدعاء"
"30238","(۳۰۲۳۸) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ ، حَدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، حَدَّثَنَا أَبُو التَّیَّاحِ ، قَالَ : سَأَلَ رَجُلٌ عَبْدَ اللہ بْنَ خَنْبَش : کَیْفَ صَنَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ کَادَتْہُ الشَّیَاطِینُ ؟ قَالَ : جَائَتِ الشَّیَاطِینُ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنَ الأَوْدِیَۃِ ، وَتَحَدَّرَتْ عَلَیْہِ مِنَ الْجِبَالِ ، وَفِیہِمْ شَیْطَانٌ مَعَہُ شُعْلَۃُ نَارٍ یُرِیدُ أَنْ یَحْرِقَ بِہَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأُرْعِبَ مِنْہُمْ ، قَالَ جَعْفَرٌ : أَحْسَبُہُ ، قَالَ : جَعَلَ یَتَأَخَّرُ ، قَالَ : وَجَائَہُ جِبْرِیلُ فَقَالَ : یَا مُحَمَّدُ ، قُلْ ، قَالَ : مَا أَقُولُ ؟ قَالَ : قُلْ : أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّاتِ الَّتِی لاَ یُجَاوِزُہُنَّ بَرٌّ ، وَلا فَاجِرٌ مِنْ شَرِّ مَا خَلَقَ وَذَرَأَ وَبَرَأَ ، وَمِنْ شَرِّ مَا یَنْزِلُ مِنَ السَّمَائِ ، وَمِنْ شَرِّ مَا یَعْرُجُ فِیہَا ، وَمِنْ شَرِّ مَا ذَرَأَ فِی الأَرْضِ وَمِنْ شَرِّ مَا یَخْرُجُ مِنْہَا وَمِنْ شَرِّ فِتَنِ اللَّیْلِ وَالنَّہَارِ ، وَمِنْ شَرِّ کُلِّ طَارِقٍ إِلاَّ طَارِقًا یَطْرُقُ بِخَیْرٍ یَا رَحْمَنُ ، قَالَ : فَطُفِئَتْ نَارُ الشَّیْطَانِ ، قَالَ : وَہَزَمَہُمَ اللَّہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30238","","","كتاب الدعاء"
"30239","(۳۰۲۳۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ حَدَّثَنَا مِسْعَرٌ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنِ ابْنِ سَابِطٍ ، قَالَ : أَصَابَ خَالِدَ بْنَ الْوَلِیدِ أَرَقٌ فَقَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَلا أُعَلِّمُک کَلِمَاتٍ إذَا قُلْتہنَّ نِمْت اللَّہُمَّ رَبَّ السَّمَاوَاتِ، وَمَا أَظَلَّتْ ، وَرَبَّ الأَرْضِینَ ، وَمَا أَقَلَّتْ وَرَبَّ الشَّیَاطِینِ ، وَمَا أَضَلَّتْ ، کُنْ لِی جَاری مِنْ شَرِّ خَلْقِکَ کُلِّہِمْ جَمِیعًا أَنْ یَفْرُطَ عَلَیَّ أَحَدٌ مِنْہُمْ ، أَوْ یَبْغِی ، عَزَّ جَارُک ، وَلا إلَہَ غَیْرُک۔ (ترمذی ۳۵۲۳۔ طبرانی ۹۸۴)","","Musannaf Ibn Abi Shaybah 30239","","","كتاب الدعاء"
"30240","(۳۰۲۴۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن رَجُلٍ مِنْ أَہْلِ الشَّامِ ، عَن مَکْحُولٍ ، أن النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا رَأَی الْبَیْتَ قَالَ : اللَّہُمَّ زِدْ ہَذَا الْبَیْتَ تَشْرِیفًا وَتَعْظِیمًا وَمَہَابَۃً ، وَزِدْ مَنْ حَجَّہُ ، أَو اعْتَمَرَہُ تَشْرِیفًا وَتَعْظِیمًا وَتَکْرِیمًا وَبِرًّا۔ (بیہقی ۷۳)","Da'if","Musannaf Ibn Abi Shaybah 30240","","","كتاب الدعاء"
"30241","(۳۰۲۴۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ سَعِیدٍ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ، أَنَّہُ کَانَ إذَا دَخَلَ مَسْجِدَ الْکَعْبَۃَ، وَنَظَرَ إِلَی الْبَیْتِ، قَالَ: اللَّہُمَّ أَنْتَ السَّلامُ وَمِنْک السَّلامُ فَحَیِّنَا رَبَّنَا بِالسَّلامِ۔","","Musannaf Ibn Abi Shaybah 30241","","","كتاب الدعاء"
"30242","(۳۰۲۴۲) حَدَّثَنَا جَرِیرٌ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَوَّلُ مَا تَدْخُلُ مکۃ فَانْتَہَیْت إِلَی الْحِجْرِ فَاحْمَدَ اللَّہَ عَلَی حُسْنِ تَیْسِیرِہِ وَبَلاغِہِ۔","","Musannaf Ibn Abi Shaybah 30242","","","كتاب الدعاء"
"30243","(۳۰۲۴۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَن مُحَمَّدِ بْنِ سَعِیدٍ ، عَنْ أَبِیہِ ، أَنَّ عُمَرَ کَانَ إذَا دَخَلَ الْبَیْتَ ، قَالَ : اللَّہُمَّ أَنْتَ السَّلامُ وَمِنْک السَّلامُ فَحَیِّنَا رَبَّنَا بِالسَّلامِ۔","Da'if","Musannaf Ibn Abi Shaybah 30243","","","كتاب الدعاء"
"30244","(۳۰۲۴۴) حَدَّثَنَا وَکِیعٌ ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، عَن وَہْبِ بْنِ وَہْبٍ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ ، عَن عُمَرَ ، أَنَّہُ کَانَ یَقُولُ إذَا اسْتَلَمَہُ یَعْنِی الْحَجَرَ : آمَنْت بِاللہِ وَکَفَرْت بِالطَّاغُوتِ۔","","Musannaf Ibn Abi Shaybah 30244","","","كتاب الدعاء"
"30245","(۳۰۲۴۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْمَسْعُودِیِّ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ یَقُولُ إذَا اسْتَلَمَ الْحَجَرَ : اللَّہُمَّ تَصْدِیقًا بِکِتَابِکَ وَسُنَّۃِ نَبِیِّک۔","Da'if","Musannaf Ibn Abi Shaybah 30245","","","كتاب الدعاء"
"30246","(۳۰۲۴۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن عُبَیْدٍ الْمُکْتِبِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا اسْتَلَمْت الْحَجَرَ فَقُلْ : لاَ إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ۔","","Musannaf Ibn Abi Shaybah 30246","","","كتاب الدعاء"
"30247","(۳۰۲۴۷) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَن شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، عَن مُجَاہِدٍ ، قَالَ : کَانَ یُسْتَحَبُّ أَنْ یُقَالَ عِنْدَ اسْتِلامِ الْحَجَرِ : اللَّہُمَّ تَصْدِیقًا بِکِتَابِکَ وَسُنَّۃِ نَبِیِّک۔","","Musannaf Ibn Abi Shaybah 30247","","","كتاب الدعاء"
"30248","(۳۰۲۴۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَن یَحْیَی بْنِ عُبَیْدٍ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ السَّائِبِ ، قَالَ سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ بَیْنَ الرُّکْنِ وَالْحَجَرِ : {رَبَّنَا آتِنَا فِی الدُّنْیَا حَسَنَۃً وَفِی الآخِرَۃِ حَسَنَۃً وَقِنَا عَذَابَ النَّارِ}۔","Da'if","Musannaf Ibn Abi Shaybah 30248","","","كتاب الدعاء"
"30249","(۳۰۲۴۹) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ، عَنْ عَطَائٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ: کَانَ مِنْ دُعَائِ ابْنِ عَبَّاسٍ الَّذِی لاَ یَدَعُ بَیْنَ الرُّکْنِ وَالْمَقَامِ أَنْ یَقُولَ : اللَّہُمَّ قَنِّعْنِی بِمَا رَزَقْتنِی وَبَارِکْ لِی فِیہِ وَاخْلُفْ عَلَیَّ کُلَّ غَائِبَۃٍ لِی بِخَیْرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 30249","","","كتاب الدعاء"
"30250","(۳۰۲۵۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مَنْصُورٍ ، عَن ہِلالِ بْنِ یَِسَافٍ ، عَنْ أَبِی شُعْبَۃَ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ عِنْدَ الرُّکْنِ أو الْحَجَرِ : {رَبَّنَا آتِنَا فِی الدُّنْیَا حَسَنَۃً وَفِی الآخِرَۃِ حَسَنَۃً وَقِنَا عَذَابَ النَّارِ}۔","Da'if","Musannaf Ibn Abi Shaybah 30250","","","كتاب الدعاء"
"30251","(۳۰۲۵۱) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ ہُرْمُزَ ، عَن مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : عَلَی الرُّکْنِ الْیَمَانِیِّ مَلَکٌ یَقُولُ آمِینَ ، فَإِذَا مَرَرْتُمْ بِہِ فَقُولُوا : اللَّہُمَّ رَبَّنَا آتِنَا فِی الدُّنْیَا حَسَنَۃً وَفِی الآخِرَۃِ حَسَنَۃً وَقِنَا عَذَابَ النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 30251","","","كتاب الدعاء"
"30252","(۳۰۲۵۲) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ بَدَأَ بِالصَّفَا فَرَقَیَ عَلَیْہِ حَتَّی رَأَی الْبَیْتَ وَوَحَّدَ اللَّہَ وَکَبَّرَہُ ، وَقَالَ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْک، وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ، لاَ إلَہَ إِلاَّ اللَّہُ وحدہ أَنْجَزَ وَعْدَہُ وَنَصَرَ عَبْدَہُ وَہَزَمَ الأَحْزَابَ وَحْدَہُ، ثُمَّ دَعَا بَیْنَ ذَلِکَ فَقَالَ: مِثْلَ ہَذَا ثَلاثَ مَرَّاتٍ، ثُمَّ أَتَی الْمَرْوَۃَ فَفَعَلَ عَلَی الْمَرْوَۃِ کَمَا فَعَلَ عَلَی الصَّفَا۔","Sahih","Musannaf Ibn Abi Shaybah 30252","","","كتاب الدعاء"
"30253","(۳۰۲۵۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَن سُفْیَانَ ، عَن فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، عَنْ وَہْبِ بْنِ الأَجْدَعِ ، قَالَ سَمِعْت عُمَرَ یَقُولُ : إذَا قُمْتُمْ عَلَی الصَّفَا فَکَبِّرُوا سَبْعَ تَکْبِیرَاتٍ ، بَیْنَ کُلِّ تَکْبِیرَتَیْنِ حَمْدُ اللہِ وَثَنَاؤٌ عَلَیْہِ وَصَلاۃ اللہِ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَدُعَائٌ لِنَفْسِکَ ، وَعَلَی الْمَرْوَۃِ مِثْلُ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 30253","","","كتاب الدعاء"
"30254","(۳۰۲۵۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، عَن وَہْبِ بْنِ الأَجْدَعِ أَنَّہُ سَمِعَ عُمَرَ یَقُولُ : یَبْدَأُ بِالصَّفَا وَیَسْتَقْبِلُ الْقِبْلَۃَ الْبَیْتَ ، ثُمَّ یُکَبِّرُ سَبْعَ تَکْبِیرَاتٍ ، بَیْنَ کُلِّ تَکْبِیرَتَیْنِ حَمْدُ اللہِ ، وَصَلاۃٌ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَسْأَلَۃٌ لِنَفْسِکَ ، وَعَلَی الْمَرْوَۃِ مِثْلُ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 30254","","","كتاب الدعاء"
"30255","(۳۰۲۵۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَن عُبَیْدِ اللہِ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا صَعِدَ علی الصَّفَا اسْتَقْبَلَ الْبَیْتَ ، ثُمَّ کَبَّرَ ثَلاثًا ، ثُمَّ قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، یَرْفَعُ بِہَا صَوْتَہُ ، ثُمَّ یَدْعُو قَلِیلاً ، ثُمَّ یَفْعَلُ ذَلِکَ عَلَی الْمَرْوَۃِ حَتَّی یَفْعَلَ ذَلِکَ سَبْعَ مَرَّاتٍ فَیَکُونُ التَّکْبِیرُ واحِدًا وَعِشْرِینَ تَکْبِیرَۃً ، فَمَا یَکَادُ یَفْرُغُ حَتَّی یَشُقَّ عَلَیْنَا وَنَحْنُ شَبَابٌ۔","Sahih","Musannaf Ibn Abi Shaybah 30255","","","كتاب الدعاء"
"30256","(۳۰۲۵۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الأَصْبَغِ بْنِ یَزِیدَ ، عَنِ الْقَاسِمِ بْنِ أَبِی أَیُّوبَ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ کَانَ یقول : یَقُومُ الرجل عَلَی الصَّفَا وَالْمَرْوَۃِ قَدْرَ قِرَائَۃِ سُورَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 30256","","","كتاب الدعاء"
"30257","(۳۰۲۵۷) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن مُغِیرَۃَ ، قَالَ : قَالَ الْحَکَمُ لإِبْرَاہِیمَ ، رَأَیْت أَبَا بَکْرِ بْنَ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ یَقُومُ عَلَی الصَّفَا قَدْرَ مَا یَقْرَأُ الرَّجُلُ عِشْرِینَ وَمِئَۃَ آیَۃٍ فَقَالَ : إِنَّہُ لَفَقِیہٌ۔","","Musannaf Ibn Abi Shaybah 30257","","","كتاب الدعاء"
"30258","(۳۰۲۵۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ عَلَی الصَّفَا وَالْمَرْوَۃِ دُعَائٌ مُؤقَّتٌ فَادْعُ مَا شِئْت۔","","Musannaf Ibn Abi Shaybah 30258","","","كتاب الدعاء"
"30259","(۳۰۲۵۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، قَالَ: لَمْ أَسْمَعْ، أَنَّ عَلَی الصَّفَا وَالْمَرْوَۃِ دُعَائً مُوَقَّتًا۔","","Musannaf Ibn Abi Shaybah 30259","","","كتاب الدعاء"
"30260","(۳۰۲۶۰) حَدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : لَیْسَ فِیہَا دُعَائٌ مُوَقَّتٌ فَادْعُ بِمَا شِئْت وَسَلْ مَا شِئْت۔","","Musannaf Ibn Abi Shaybah 30260","","","كتاب الدعاء"
"30261","(۳۰۲۶۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَن مُعَاذِ بْنِ الْعَلائِ ، قَالَ : شَہِدْت عِکْرِمَۃَ بْنَ خَالِدٍ المخزومی یَقُولُ : لاَ أَعْلَمُ عَلَی الصَّفَا وَالْمَرْوَۃِ دُعَائً مُؤَقَّتًا۔","","Musannaf Ibn Abi Shaybah 30261","","","كتاب الدعاء"
"30262","(۳۰۲۶۲) حَدَّثَنَا مُحَمَّدُ بْنُ فضیل ، عَنِ الْعَلائِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ ، قَالَ : کَانَ عُمَرُ إذَا مَرَّ بِالْوَادِی بَیْنَ الصَّفَا وَالْمَرْوَۃِ یَسْعَی فِیہِ ویَقُولُ : رَبِّ اغْفِرْ وَارْحَمْ ، وَأَنْتَ الأَعَزُّ الأَکْرَمُ۔","","Musannaf Ibn Abi Shaybah 30262","","","كتاب الدعاء"
"30263","(۳۰۲۶۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الأَعْمَشِ ، عَن شَقِیقٍ ، عَن مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : کَانَ إذَا سَعَی فِی بَطْنِ الْوَادِی ، قَالَ : رَبِّ اغْفِرْ وَارْحَمْ إنَّک أَنْتَ الأَعَزُّ الأَکْرَمُ۔","Hasan","Musannaf Ibn Abi Shaybah 30263","","","كتاب الدعاء"
"30264","(۳۰۲۶۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ حَجَّاجِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْہَیْثمِ بْنِ حَنَشٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ : رَبّ اغْفِرْ وَارْحَمْ ، وأَنْتَ الأَعَزُّ الأَکْرَمُ۔","Da'if","Musannaf Ibn Abi Shaybah 30264","","","كتاب الدعاء"
"30265","(۳۰۲۶۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، أَنَّ أَبَاہُ کَانَ یَقُولُ وَہُوَ یَسْعَی بَیْنَ الصَّفَا وَالْمَرْوَۃِ اللَّہُمَّ إنَّ ہَذَا وَاحِدٌ إِنْ تَما أَتَمَّہ اللہ ، وَقَد أَتَمَّا۔","","Musannaf Ibn Abi Shaybah 30265","","","كتاب الدعاء"
"30266","(۳۰۲۶۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَن لَیْثٍ ، عَن مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ أبِیہِ ، قَالَ : أَفَضْت مَعَ عَبْدِ اللہِ فَرَمَی سَبْع حَصَیَاتٍ ، یُکَبِّرُ مَعَ کُلِّ حَصَاۃٍ ، وَاسْتَبْطَنَ الْوَادِی حَتَّی إذَا فَرَغَ ، قَالَ : اللَّہُمَّ اجْعَلْہُ حَجًّا مَبْرُورًا ، وَذَنْبًا مَغْفُورًا ، ثُمَّ قَالَ : ہَکَذَا رَأَیْت الَّذِی أُنْزِلَتْ عَلَیْہِ سُورَۃُ الْبَقَرَۃِ صَنَعَ۔","Da'if","Musannaf Ibn Abi Shaybah 30266","","","كتاب الدعاء"
"30267","(۳۰۲۶۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْہَیْثمِ بْنِ حَنَشٍ ، قَالَ سَمِعْت ابْنَ عُمَرَ حِینَ رَمَی الْجِمَارَ یَقُولُ : اللَّہُمَّ اجْعَلْہُ حَجًّا مَبْرُورًا وَذَنْبًا مَغْفُورًا۔","Da'if","Musannaf Ibn Abi Shaybah 30267","","","كتاب الدعاء"
"30268","(۳۰۲۶۸) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَن مُغِیرَۃَ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : مَا أَقُولُ إذَا رَمَیْت الْجَمْرَۃَ ؟ قَالَ : قُلِ : اللَّہُمَّ اجْعَلْہُ حَجًّا مَبْرُورًا وَذَنْبًا مَغْفُورًا ، قَالَ : قلت أَقُولُہُ مَعَ کُلِّ حَصَاۃٍ ؟ قَالَ : نَعَمْ إِنْ شِئْت۔","","Musannaf Ibn Abi Shaybah 30268","","","كتاب الدعاء"
"30269","(۳۰۲۶۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ عَلَی الْوُقُوفِ عِنْدَ الْجَمْرَتَیْنِ دُعَائٌ مُوَقَّتٌ فَادْعُ بِمَا شِئْت۔","","Musannaf Ibn Abi Shaybah 30269","","","كتاب الدعاء"
"30270","(۳۰۲۷۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، قَالَ : کَانَ الْحَسَنُ یَقُولُ : یَدْعُو عِنْدَ الْجِمَارِ کُلِّہَا ، وَلا یُؤقِّتُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 30270","","","كتاب الدعاء"
"30271","(۳۰۲۷۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ فِی الْجَمْرَۃِ شَیْئٌ مُؤقَّتٌ ، لاَ یُزَادُ عَلَیْہِ ؟ قَالَ : لاَ إِلاَّ قَوْلَ جَابِرٍ۔","","Musannaf Ibn Abi Shaybah 30271","","","كتاب الدعاء"
"30272","(۳۰۲۷۲) حَدَّثَنَا وَکِیعٌ ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ أَخِیہِ ، عَنْ عَلِیٍّ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَکْثَرُ دُعَائِی وَدُعَائِ الأَنْبِیَائِ قَبْلِی بِعَرَفَۃَ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، اللَّہُمَّ اجْعَلْ فِی قَلْبِی نُورًا وَفِی سَمْعِی نُورًا وَفِی بَصَرِی نُورًا ، اللَّہُمَّ اشْرَحْ لِی صَدْرِی وَیَسِّرْ لِی أَمْرِی ، وَأَعُوذُ بِکَ مِنْ وَسْوَاسِ الصَّدْرِ ، وَشَتَاتِ الأَمْرِ ، وَفِتْنَۃِ الْقَبْرِ ، اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ شَرِّ مَا یَلِجُ فِی اللَّیْلِ ، وَشَرِّ مَا یَلِجُ فِی النَّہَارِ ، وَشَرِّ مَا تَہُبُّ بِہِ الرِّیَاحُ۔","Da'if","Musannaf Ibn Abi Shaybah 30272","","","كتاب الدعاء"
"30273","(۳۰۲۷۳) حَدَّثَنَا وَکِیعٌ ، عَن نَضْرِ بْنِ عَرَبِیٍّ ، عَنِ ابْنِ أَبِی حُسَیْنٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَکْثَرُ دُعَائِی وَدُعَائِ الأَنْبِیَائِ قَبْلِی بِعَرَفَۃَ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ یُحْیِی وَیُمِیتُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ۔","","Musannaf Ibn Abi Shaybah 30273","","","كتاب الدعاء"
"30274","(۳۰۲۷۴) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَن ہِلالٍ ، عَنْ أَبِی شُعْبَۃَ ، قَالَ : کُنْتُ بِجَنْبِ ابْنِ عُمَرَ بِعَرَفَۃَ وَإِنَّ رُکْبَتَیَّ لَتَمَسُّ رُکْبَتَہُ ، أَوْ فَخِذِی تَمَسُّ فَخِذَہُ ، فَمَا سَمِعْتہ یَزِیدُ عَلَی ہَؤُلائِ الْکَلِمَاتِ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ حَتَّی أَفَاضَ مِنْ عَرَفَۃَ إِلَی جَمْعٍ۔","Da'if","Musannaf Ibn Abi Shaybah 30274","","","كتاب الدعاء"
"30275","(۳۰۲۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ شَترٍ ، قَالَ : قُلْتُ لابْنِ الْحَنَفِیَّۃِ : مَا خَیْرُ مَا نَقُولُ فِی حَجِّنَا ، قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ۔","","Musannaf Ibn Abi Shaybah 30275","","","كتاب الدعاء"
"30276","(۳۰۲۷۶) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَن رَجُلٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ مِثْلُہُ۔","","Musannaf Ibn Abi Shaybah 30276","","","كتاب الدعاء"
"30277","(۳۰۲۷۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن سَعِیدِ بْنِ السَّائِبِ ، عَن دَاوُد بْنِ أَبِی عَاصِمٍ ، قَالَ : وَقَفْت مَعَ سَالِمِ بْنِ عَبْدِ اللہِ بِعَرَفَۃَ أَنْظُرُ کَیْفَ یَصْنَعُ ، فَکَانَ فِی الذِّکْرِ وَالدُّعَائِ حَتَّی أَفَاضَ۔","","Musannaf Ibn Abi Shaybah 30277","","","كتاب الدعاء"
"30278","(۳۰۲۷۸) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مَنْصُورٍ ، عَن ہِلالٍ ، عَنْ أَبِی شُعْبَۃَ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ حَوْلَ الْبَیْتِ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ۔","Da'if","Musannaf Ibn Abi Shaybah 30278","","","كتاب الدعاء"
"30279","(۳۰۲۷۹) حَدَّثَنَا وَکِیعٌ ، عَن أُسَامَۃَ بْنِ زَیْدٍ ، عَنِ ابْنِ أَبِی لَبِیبَۃَ ، عَنْ سَعْدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَیْرُ الذِّکْرِ الْخَفِیُّ۔ (احمد ۱۷۲)","Da'if","Musannaf Ibn Abi Shaybah 30279","","","كتاب الدعاء"
"30280","(۳۰۲۸۰) حَدَّثَنَا أَبُو دَاوُدَ ، عَن ہِشَامٍ ، عَن یَحْیَی ، عَن رَجُلٍ ، عَنْ عَائِشَۃَ قَالَتْ : الذِّکْرُ الْخَفِیُّ الَّذِی لاَ یَکْتُبُہُ الْحَفَظَۃُ یُضَاعَفُ عَلَی مَا سِوَاہُ مِنَ الذِّکْرِ سَبْعِینَ ضِعْفًا۔","Da'if","Musannaf Ibn Abi Shaybah 30280","","","كتاب الدعاء"
"30281","(۳۰۲۸۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، عَنْ أَبِی مُوسَی ، قَالَ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ فَجَعَلَ النَّاسَ یَجْہَرُونَ بِالتَّکْبِیرِ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ارْبَعُوا عَلَی أَنْفُسِکُمْ فَإِنَّکُمْ لیس تَدْعُونَ أَصَمَّ ، وَلا غَائِبًا ، إنَّکُمْ تَدْعُونَہُ سَمِیعًا قَرِیبًا وَہُوَ مَعَکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 30281","","","كتاب الدعاء"
"30282","(۳۰۲۸۲) حَدَّثَنَا عَلِیُّ بْنُ ہَاشم ، عَنِ ابْنِ أَبِی لَیْلَی ، عَن صَدَقَۃَ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ : إنَّ الْمُصَلِّیَ إذا صلی یُنَاجِی رَبَّہُ فَلْیَعْلَمْ بِمَا یُنَاجِیہِ ، وَلا یَجْہَرْ بَعْضُکُمْ عَلَی بَعْضٍ۔","Da'if","Musannaf Ibn Abi Shaybah 30282","","","كتاب الدعاء"
"30283","(۳۰۲۸۳) حَدَّثَنَا وَکِیعٌ ، عَن عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أَیُّہَا النَّاسُ إنَّکُمْ لاَ تَدْعُونَ أَصَمَّ ، وَلا غَائِبًا یَعْنِی فِی رَفْعِ الصَّوْتِ فِی الدُّعَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 30283","","","كتاب الدعاء"
"30284","(۳۰۲۸۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ نسیب ، قَالَ : صَلَّیْت إِلَی جَنْبِ سَعِیدِ بْنِ الْمُسَیَّبِ ، فَلَمَّا جَلَسْت فِی الرَّکْعَۃِ الثَّانِیَۃِ رَفَعْت صَوْتِی بِالدُّعَائِ فَانْتَہَرَنِی ، فَلَمَّا انْصَرَفَت قُلْتُ لَہُ : مَا کَرِہْت مِنِّی ؟ قَالَ: ظَنَنْت أَنَّ اللَّہَ لَیْسَ بِقَرِیبٍ مِنْک۔","","Musannaf Ibn Abi Shaybah 30284","","","كتاب الدعاء"
"30285","(۳۰۲۸۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ ، عَن مُجَاہِدٍ ، أَنَّہُ سَمِعَ رَجُلاً یَرْفَعُ صَوْتَہُ فِی الدُّعَائِ فَرَمَاہُ بِالْحَصَی۔","","Musannaf Ibn Abi Shaybah 30285","","","كتاب الدعاء"
"30286","(۳۰۲۸۶) حَدَّثَنَا وَکِیعٌ ، عَن رَبِیعٍ ، عَن یَزِیدَ بْنِ أَبَانَ ، عَنْ أَنَسٍ ، وَعَنْ رَبِیعٍ ، عَنِ الْحَسَنِ أَنَّہُمَا کَرِہَا أَنْ یُسْمِعَ الرَّجُلُ جَلِیسَہُ شَیْئًا مِنَ الدُّعَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 30286","","","كتاب الدعاء"
"30287","(۳۰۲۸۷) حَدَّثَنَا وَکِیعٌ ، عَن مُبَارَکٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانُوا یَجْتَہِدُونَ فِی الدُّعَائِ ، وَلا تَسْمَعُ إِلاَّ ہَمْسًا۔","","Musannaf Ibn Abi Shaybah 30287","","","كتاب الدعاء"
"30288","(۳۰۲۸۸) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ مُعَاوِیَۃَ ، عَنِ ابْنِ أَبِی ذُبَابٍ ، عَن سَہْلِ بْنِ سَعْدٍ قَالَ : مَا رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شَاہِرًا یَدَہُ فِی الدُّعَائِ عَلَی مِنْبَرٍ ، وَلا غَیْرِہِ ، وَلَقَدْ رَأَیْت یَدَیْہِ حَذْوَ مَنْکِبَیْہِ یَدْعُو۔","Da'if","Musannaf Ibn Abi Shaybah 30288","","","كتاب الدعاء"
"30289","(۳۰۲۸۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَن سَعِیدٍ ، عَن قَتَادَۃَ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ لاَ یَرْفَعُ یَدَیْہِ فِی شَیْئٍ مِنَ الدُّعَائِ إِلاَّ فِی الاسْتِسْقَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 30289","","","كتاب الدعاء"
"30290","(۳۰۲۹۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَن تَمِیمِ بْنِ طَرَفَۃَ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : خَرَجَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَا لِی أَرَاکُمْ رَافِعِی أَیْدِیکُمْ کَأَنَّہَا أَذْنَابُ خَیْلٍ شُمْسٍ ، اسْکُنُوا فِی الصَّلاۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 30290","","","كتاب الدعاء"
"30291","(۳۰۲۹۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَن سُلَیمَانَ بْنِ عَمْرِو بْنِ الأَحْوَصِ ، قَالَ : أَخْبَرَنَا أَبُو ہِلالٍ ، عَنْ أَبِی بَرَزَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَعَا عَلَی رَجُلَیْنِ فَرَفَعَ یَدَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30291","","","كتاب الدعاء"
"30292","(۳۰۲۹۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَن حَیَّانَ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَمُرَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَفَعَ یَدَیْہِ حیث صَلَّی فِی الْکُسُوفِ۔","Sahih","Musannaf Ibn Abi Shaybah 30292","","","كتاب الدعاء"
"30293","(۳۰۲۹۳) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَن حُمَیْدٍ ، قَالَ : سُئِلَ أَنَسٌ : ہَلْ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَرْفَعُ یَدَیْہِ یَعْنِی فِی الدُّعَائِ فَقَالَ : نَعَمْ ، شَکَا النَّاسُ إلَیْہِ ذَاتَ جُمُعَۃٍ فَقَالُوا : یَا رَسُولَ اللہِ ، قَحَطَ الْمَطَرُ وَأَجْدَبَتِ الأَرْضُ وَہَلَکَ الْمَالُ ،قال: فَرَفَعَ یَدَیْہِ حَتَّی رَأَیْت بَیَاضَ إبْطَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30293","","","كتاب الدعاء"
"30294","(۳۰۲۹۴) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ حَدَّثَنَا شُعْبَۃُ ، عَن ثَابِتٍ ، عَنْ أَنَسٍ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَرْفَعُ یَدَیْہِ فِی الدُّعَائِ حَتَّی یُرَی بَیَاضُ إبْطَیْہِ۔ (مسلم ۶۱۲۔ طیالسی ۲۰۴۷)","Sahih","Musannaf Ibn Abi Shaybah 30294","","","كتاب الدعاء"
"30295","(۳۰۲۹۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَن وَائِلِ بْنِ حُجْرٍ ، قَالَ : رَأَیْتُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَضَعَ حَدَّ مِرْفَقِہِ الأَیْمَنِ عَلَی فَخِذِہِ الْیُمْنَی وَحَلَّقَ بِالإِبْہَامِ وَالْوُسْطَی وَرَفَعَ الَّتِی تَلِی الإِبْہَامَ یَدْعُو بِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 30295","","","كتاب الدعاء"
"30296","(۳۰۲۹۶) حَدَّثَنَا وَکِیعٌ ، عَن عِصَامِ بْنِ قُدَامَۃَ ، عَن مَالِکِ بْنِ نُمَیْرٍ الْخُزَاعِیِّ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَالِسًا فِی الصَّلاۃِ وَاضِعًا یَدَہُ الْیُمْنَی عَلَی فَخِذِہِ یشیر بِإِصْبَعِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30296","","","كتاب الدعاء"
"30297","(۳۰۲۹۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ، عَنِ ابْنِ عَجْلاَنَ، عَنْ عَامِرِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ، عَنْ أَبِیہِ، قَالَ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، إِذَا قَعَدَ یَدْعُو ، وَضَعَ یَدَہُ الْیُمْنَی عَلَی فَخِذِہِ الْیُمْنَی ، وَیَدَہُ الْیُسْرَی عَلَی فَخِذِہِ الْیُسْرَی، وَأَشَارَ بِإِصْبَعِہِ السَّبَّابَۃِ، وَوَضَعَ إِبْہَامَہُ عَلَی إِصْبَعِہِ الْوُسْطَی، وَیُلْقِمُ کَفَّہُ الْیُسْرَی رُکْبَتَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30297","","","كتاب الدعاء"
"30298","(۳۰۲۹۸) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَن رَاشِدٍ أَبِی سَعْدٍ ، عَن سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا جَلَسَ فِی الصَّلاۃِ وَضَعَ یَدَہُ عَلَی فَخِذِہِ وَیُشِیرُ بِإِصْبَعِہِ فِی الدُّعَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 30298","","","كتاب الدعاء"
"30299","(۳۰۲۹۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أَبْصَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَعْدًا وَہُوَ یَدْعُو بِأَصَابِعِہِ فَقَالَ : یَا سَعْدُ ، أَحِّدْ أَحِّدْ۔","Sahih","Musannaf Ibn Abi Shaybah 30299","","","كتاب الدعاء"
"30300","(۳۰۳۰۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ التَّمِیمِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ہُوَ الإِخْلاصُ یَعْنِی الدُّعَائَ بِإِصْبَعٍ۔","Da'if","Musannaf Ibn Abi Shaybah 30300","","","كتاب الدعاء"
"30301","(۳۰۳۰۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَن مُحَمَّدِ عن کَثِیرِ بْنِ أَفْلَحَ ، قَالَ : صَلَّیْت ، قَالَ : فَلَمَّا کَانَ فِی آخِرِ الْقَعْدَۃِ قُلْتُ ہَکَذَا وأَشَارَ ابْنُ عُلَیَّۃَ بِإِصْبَعَیْہِ فَقَبَضَ ابْنُ عُمَرَ ہَذِہِ یَعْنِی الْیُسْرَی۔","Sahih","Musannaf Ibn Abi Shaybah 30301","","","كتاب الدعاء"
"30302","(۳۰۳۰۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یُشِیرُ بِإِصْبَعِہِ فِی الصَّلاۃِ۔","","Musannaf Ibn Abi Shaybah 30302","","","كتاب الدعاء"
"30303","(۳۰۳۰۳) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ أَبِی عَلْقَمَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : إنَّ اللَّہَ وِتْرٌ یُحِبُّ الْوِتْرَ أَنْ یُدْعَا ہَکَذَا وَأَشَارَتْ بِإِصْبَعٍ وَاحِدَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 30303","","","كتاب الدعاء"
"30304","(۳۰۳۰۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَن ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّہُ رَأَی رَجُلاً یَدْعُو بِإِصْبَعَیْہِ کِلَیْہِمَا فَنَہَاہُ ، وَقَالَ : بِإِصْبَعٍ وَاحِدٍ بِالْیُمْنَی۔","Sahih","Musannaf Ibn Abi Shaybah 30304","","","كتاب الدعاء"
"30305","(۳۰۳۰۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلانَ ، عَن سُلَیْمَانَ بْنِ أَبِی یَحْیَی ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْخُذُ بَعْضُہُمْ عَلَی بَعْضٍ یَعْنِی الإِشَارَۃَ بِإِصْبَعٍ فِی الدُّعَائِ۔","Hasan","Musannaf Ibn Abi Shaybah 30305","","","كتاب الدعاء"
"30306","(۳۰۳۰۶) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنِ ابْنِ الزُّبَیْرِ ، قَالَ : إنَّکُمْ لَتَدْعُونَ ، أَفْضَلُ الدُّعَائِ ہَکَذَا وَأَشَارَ بِإِصْبَعِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30306","","","كتاب الدعاء"
"30307","(۳۰۳۰۷) حَدَّثَنَا وَکِیعٌ، عَن مِسْعَرٍ، عن معبد بن خالد عن قیس بن سعد قَالَ: کان لاَ یزاد ہَکَذَا وَأَشَارَ بِإِصْبَعِہِ۔","","Musannaf Ibn Abi Shaybah 30307","","","كتاب الدعاء"
"30308","(۳۰۳۰۸) حَدَّثَنَا جَرِیرٌ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَشَارَ الرَّجُلُ بِإِصْبَعِہِ فِی الصَّلاۃِ ، فَہُوَ حَسَنٌ وَہُوَ التَّوْحِیدُ ، وَلَکِنْ لاَ یُشِیرُ بِإِصْبَعَیْہِ فَإِنَّہُ یُکْرَہُ۔","","Musannaf Ibn Abi Shaybah 30308","","","كتاب الدعاء"
"30309","(۳۰۳۰۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَن طَلْحَۃَ ، عَن خَیْثَمَۃَ ، أَنَّہُ کَانَ یعقد ثَلاثًا وَخَمْسِینَ ، وَیُشِیرُ بِإِصْبَعِہِ۔","","Musannaf Ibn Abi Shaybah 30309","","","كتاب الدعاء"
"30310","(۳۰۳۱۰) حَدَّثَنَا حَفص بْنُ غِیَاثٍ ، عَن عُثْمَانَ بْنِ الأَسْوَدِ ، عَن مُجَاہِدٍ ، أَنَّہُ قَالَ : الدُّعَائُ ہَکَذَا وَأَشَارَ بِإِصْبَعٍ وَاحِدَۃٍ مَقْمَعَۃٌ لِلشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 30310","","","كتاب الدعاء"
"30311","(۳۰۳۱۱) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا إذَا رَأَوْا إنْسَانًا یَدْعُو بِإِصْبَعَیْہِ ضَرَبُوا إحْدَاہُمَا ، وَقَالُوا : إنَّمَا ہُوَ إلَہٌ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 30311","","","كتاب الدعاء"
"30312","(۳۰۳۱۲) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إسْرَائِیلَ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَن رَجُلٍ مِنَ الأَنْصَارِ حَدَّثَہُ ، عَنْ جَدِّہِ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ عَلَیْہِ وَہُوَ یَدْعُو بِیَدَیْہِ فَقَالَ: أَحِّدْ فَإِنَّہُ أَحَدٌ۔ (مسند ۶۶۹)","Da'if","Musannaf Ibn Abi Shaybah 30312","","","كتاب الدعاء"
"30313","(۳۰۳۱۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، أَنَّ أَبَاہُ کَانَ یُشِیرُ بِإِصْبَعِہِ فِی الدُّعَائِ ، وَلا یُحَرِّکُہَا۔","","Musannaf Ibn Abi Shaybah 30313","","","كتاب الدعاء"
"30314","حدثنا بقی بن مخلد ، قَالَ : حدثنا أبو بکر ، قَالَ :n(۳۰۳۱۴) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ قَالَ : لاَ تَقُومُوا تَدْعُونَ کَمَا تَصْنَعُ الْیَہُودُ فِی کَنَائِسِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 30314","","","كتاب الدعاء"
"30315","(۳۰۳۱۵) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنِ ابْنِ الأَصْبَہَانِیِّ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، أَنَّہُ رَأَی رَجُلاً یَدْعُو قَائِمًا بَعْدَ مَا انْصَرَفَ فَسَبَّہُ ، أَوْ شَتَمَہُ۔","","Musannaf Ibn Abi Shaybah 30315","","","كتاب الدعاء"
"30316","(۳۰۳۱۶) حَدَّثَنَا وَکِیعٌ، عَن مِسْعَرٍ ، عَنِ الْحَکَمِ ، عَنْ عَبْدَۃَ بْنِ أَبِی لُبَابَۃَ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ، أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 30316","","","كتاب الدعاء"
"30317","(۳۰۳۱۷) حَدَّثَنَا أَبُو مُعَاوِیَۃُ ، عَن حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ ، قَالَ : ثِنْتَانِ بِدْعَۃٌ : أَنْ یَقُومَ الرَّجُلُ بَعْدَ مَا یَفْرُغُ مِنْ صَلاتِہِ مُسْتَقْبِلَ الْقِبْلَۃِ یَدْعُو ، وَأَنْ یَسْجُدَ السَّجْدَۃَ الثَّانِیَۃَ فَیَرَی أَنَّ حَقًّا عَلَیْہِ أَنْ یَلْزَقَ أَلْیَتَیْہِ بِالأَرْضِ قَبْلَ أَنْ یَنْہَضَ۔","","Musannaf Ibn Abi Shaybah 30317","","","كتاب الدعاء"
"30318","(۳۰۳۱۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ ، أَنَّہُ کَرِہَ الْقِیَامَ بَعْدَہَا تَشَبُّہًا بِالْیَہُودِ۔","","Musannaf Ibn Abi Shaybah 30318","","","كتاب الدعاء"
"30319","(۳۰۳۱۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَن جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، عَنْ عَبْدِ اللہِ ، أَنَّہُ بَلَغَہُ ، أَنَّ قَوْمًا یَذْکُرُونَ اللَّہَ قِیَامًا ، قَالَ : فَأَتَاہُمْ فَقَالَ : مَا ہَذَہ النُّکْراء ۔","Da'if","Musannaf Ibn Abi Shaybah 30319","","","كتاب الدعاء"
"30320","(۳۰۳۲۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ جَمِیلِ بْنِ زَیْدٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ دَخَلَ الْبَیْتَ وَصَلَّی رَکْعَتَیْنِ ، ثُمَّ خَرَجْت وَتَرَکْتہ قَائِمًا یَدْعُو وَیُکَبِّرُ۔","Da'if","Musannaf Ibn Abi Shaybah 30320","","","كتاب الدعاء"
"30321","(۳۰۳۲۱) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، قَالَ : قُلْتُ لِمُغِیرَۃَ : کَانَ إبْرَاہِیمُ یَکْرَہُ إذَا انْصَرَفَ أَنْ یَقُومَ مُسْتَقْبِلَ الْقِبْلَۃِ یَرْفَعُ یَدَیْہِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 30321","","","كتاب الدعاء"
"30322","(۳۰۳۲۲) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ، عَنْ أَشْعَثَ، قَالَ: رَأَیْتُ الْحَسَنَ یَرْفَعُ بَصَرَہُ إِلَی السَّمَائِ فِی الصَّلاۃِ یَدْعُو وَہُوَ قَائِمٌ۔","","Musannaf Ibn Abi Shaybah 30322","","","كتاب الدعاء"
"30323","(۳۰۳۲۳) حَدَّثَنَا شَرِیکُ بْنُ عَبْدِ اللہِ ، عَنْ أَبِی إِسْحَاقَ ، عَن بُرَیْدِ بْنِ أَبِی مَرْیَمَ ، عْن أَبِی الْحَوْرَائِ ، عَنِ الْحَسَنِ بْنِ عَلِیٍّ قَالَ : عَلَّمَنِی جَدِّی کَلِمَاتٍ أَقُولُہُنَّ فِی قُنُوتِ الْوِتْرِ : اللَّہُمَّ اہْدِنِی فِیمَنْ ہَدَیْت ، وَعَافِنِی فِیمَنْ عَافَیْت ، وَتَوَلَّنِی فِیمَنْ تَوَلَّیْت ، وَقِنِی شَرَّ مَا قَضَیْت ، وَبَارِکْ لِی فِیمَا أَعْطَیْت ، إنَّک تَقْضِی ، وَلا یُقْضَی عَلَیْک ، فَإِنَّہُ لاَ یَذِلُّ مَنْ وَالَیْت ، تَبَارَکْت وَتَعَالَیْت۔","Hasan","Musannaf Ibn Abi Shaybah 30323","","","كتاب الدعاء"
"30324","(۳۰۳۲۴) حَدَّثَنَا وَکِیعٌ ، عَن حَسَنِ بْنِ صَالِحٍ ، عَن مَنْصُورٍ ، عَن شَیْخٍ یُکَنَّی أَبَا مُحَمَّدٍ ، أَنَ الْحُسَیْنَ بْنَ عَلِیٍّ کَانَ یَقُولُ فِی قُنُوتِ الْوِتْرِ : اللَّہُمَّ إنَّک تَرَی ، وَلا تُرَی ، وَأَنْتَ بِالْمَنْظَرِ الأَعْلَی ، وَإِنَّ إلَیْک الرُّجْعَی ، وَإِنَّ لَکَ الآخِرَۃَ وَالأُولَی ، اللَّہُمَّ إنَّا نَعُوذُ بِکَ أَنْ نَذِلَّ وَنَخْزَی۔","Da'if","Musannaf Ibn Abi Shaybah 30324","","","كتاب الدعاء"
"30325","(۳۰۳۲۵) حَدَّثَنَا وَکِیعٌ ، عَن ہَارُونَ بْنِ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ یَقُولُ فِی قُنُوتِ الْوِتْرِ : لَکَ الْحَمْدُ مِلْئَ السَّمَاوَاتِ السَّبْعِ ، وَمِلْئَ الأَرَضِینَ السَّبْعِ ، وَمِلْئَ مَا بَیْنَہُمَا مِنْ شَیْئٍ بَعْدُ ، أَہْلُ الثَّنَائِ وَالْمَجْدِ أَحَقُّ مَا قَالَ الْعَبْدُ ، کُلُّنَا لَکَ عَبْدٌ : لاَ مَانِعَ لِمَا أَعْطَیْت ، وَلا مُعْطِیَ لِمَا مَنَعْت ، وَلا یَنْفَعُ ذَا الْجَدِّ مِنْک الْجَدُّ۔","Sahih","Musannaf Ibn Abi Shaybah 30325","","","كتاب الدعاء"
"30326","(۳۰۳۲۶) حَدَّثَنَا محمد بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : عَلَّمَنَا ابْنُ مَسْعُودٍ أَنْ نَقُولَ فِی الْقُنُوتِ یَعْنِی فِی الْوِتْرِ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنَسْتَغْفِرُک وَنُثْنِی عَلَیْک الخیر، وَلا نَکْفُرُک وَنَخْلَعُ وَنَتْرُکُ مَنْ یَفْجُرُکَ اللَّہُمَّ إیَّاکَ نَعْبُدُ وَلَک نُصَلِّی وَنَسْجُدُ وَإِلَیْک نَسْعَی وَنَحْفِدُ وَنَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَک إنَّ عَذَابَکَ بِالْکُفَّارِ مُلْحَقٌ۔","Da'if","Musannaf Ibn Abi Shaybah 30326","","","كتاب الدعاء"
"30327","(۳۰۳۲۷) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ، قَالَ : قلْ فِی قُنُوتِ الْوِتْرِ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنَسْتَغْفِرُک۔","","Musannaf Ibn Abi Shaybah 30327","","","كتاب الدعاء"
"30328","(۳۰۳۲۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ قَالَ : لَیْسَ فِی قُنُوتِ الْوِتْرِ شَیْئٌ مُوَقَّتٌ ، إنَّمَا ہُوَ دُعَائٌ وَاسْتِغْفَارٌ۔","","Musannaf Ibn Abi Shaybah 30328","","","كتاب الدعاء"
"30329","(۳۰۳۲۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ، عَنْ عَلِیٍّ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ فِی آخِرِ وِتْرِہِ: اللَّہُمَّ إنِّی أَعُوذُ بِرِضَاک مِنْ سَخَطِکَ، وَأَعُوذُ بِمُعَافَاتِکَ مِنْ عُقُوبَتِکَ ، وَأَعُوذُ بِکَ مِنْک ، لاَ أُحْصِی ثَنَائً علَیْک أَنْتَ کَمَا أَثْنَیْت عَلَی نَفْسِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 30329","","","كتاب الدعاء"
"30330","(۳۰۳۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زُبَیْدٍ ، عَنْ ذَرٍّ ، عَن سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أبیہ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُوتِرُ ویقول فِی آخِرِ صَلاتِہِ إذَا جَلَسَ : سُبْحَانَ الْمَلِکِ الْقُدُّوسِ ثَلاثًا ، یَمُدُّ بِہَا صَوْتَہُ فِی الآخِرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 30330","","","كتاب الدعاء"
"30331","(۳۰۳۳۱) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عُبَیْدَۃَ ، قَالَ : حدَّثَنَا أَبِی ، عَنِ الأَعْمَشِ ، عَن طَلْحَۃَ ، عَن ذَرٍّ ، عَن سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ ، عَن أُبَیِّ بْنِ کَعْبٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ فِی آخِرِ صَلاتِہِ : سُبْحَانَ الْمَلِکِ الْقُدُّوسِ ثَلاثًا۔","Sahih","Musannaf Ibn Abi Shaybah 30331","","","كتاب الدعاء"
"30332","(۳۰۳۳۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ابْنُ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَن عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : صَلَّیْت خَلْفَ عُمَرَ بْنِ الْخَطَّابِ الْغَدَاۃَ فَقَالَ فِی قُنُوتِہِ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنَسْتَغْفِرُک وَنُثْنِی عَلَیْک الْخَیْرَ ، وَلا نَکْفُرُک ، وَنَخْلَعُ وَنَتْرُکُ مِنْ یَفْجُرُکَ ، اللَّہُمَّ إیَّاکَ نَعْبُدُ وَلَک نُصَلِّی وَنَسْجُدُ ، وَإِلَیْک نَسْعَی وَنَحْفِدُ ، وَنَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَک ، إنَّ عَذَابَک بِالْکَافِرِینَ مُلْحَقٌ۔","Da'if","Musannaf Ibn Abi Shaybah 30332","","","كتاب الدعاء"
"30333","(۳۰۳۳۳) حَدَّثَنَا ہُشَیْمٌ ، أَخْبَرَنَا حُصَیْنٌ ، عَن ذَرٍّ ، عَن سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ قَالَ : إِنَّہُ کَانَ صَلَّی خَلْفَ عُمَرَ فَصَنَعَ مِثْلَ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 30333","","","كتاب الدعاء"
"30334","(۳۰۳۳۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، قَالَ : صَلَّیْت الْغَدَاۃَ ذَاتَ یَوْمٍ وَصَلَّی خَلْفِی عُثْمَانُ بْنُ زِیَادٍ ، قَالَ : فَقَنَتُّ فِی صَلاۃِ الصُّبْحِ ، قَالَ : فَلَمَّا قَضَیْت صَلاتِی ، قَالَ لِی : مَا قُلْتَ فِی قُنُوتِکَ ؟ فَقُلْتُ : ذَکَرْت ہَؤُلائِ الْکَلِمَاتِ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنَسْتَغْفِرُک وَنُثْنِی عَلَیْک الْخَیْرَ ، وَلا نَکْفُرُک ، وَنَخْلَعُ وَنَتْرُکُ مَنْ یَفْجُرُکَ ، اللَّہُمَّ إیَّاکَ نَعْبُدُ وَلَک نُصَلِّی وَنَسْجُدُ ، وَإِلَیْک نَسْعَی وَنَحْفِدُ ، وَنَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَک الجد ، إنَّ عَذَابَک بِالْکَافِرِینَ مُلْحَقٌ ، قَالَ : قَالَ لِی عُثْمَانُ : کَذَا کَانَ یَصْنَعُ عُمَرُ بْنُ الْخَطَّابِ وَعُثْمَانُ بْنُ عَفَّانَ۔","","Musannaf Ibn Abi Shaybah 30334","","","كتاب الدعاء"
"30335","(۳۰۳۳۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سُوَیْد الْکَاہِلِیِّ ، أَنَّ عَلِیًّا قَنَتَ فِی الْفَجْرِ بِہَاتَیْنِ السُّورَتَیْنِ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنَسْتَغْفِرُک وَنُثْنِی عَلَیْک الْخَیْرَ ، وَلا نَکْفُرُک ، وَنَخْلَعُ وَنَتْرُکُ مَنْ یَفْجُرُکَ ، اللَّہُمَّ إیَّاکَ نَعْبُدُ ، وَلَک نُصَلِّی وَنَسْجُدُ وَإِلَیْک نَسْعَی وَنَحْفِدُ وَنَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَک ، إنَّ عَذَابَک بِالْکَافِرِینَ مُلْحَقٌ۔","Da'if","Musannaf Ibn Abi Shaybah 30335","","","كتاب الدعاء"
"30336","(۳۰۳۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ ، عَن مَیْمُونِ بْنِ مِہْرَانَ ، قَالَ فِی قِرَائَ ۃِ أُبَیِّ بْنِ کَعْبٍ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنَسْتَغْفِرُک وَنُثْنِی عَلَیْک الْخَیْرَ ، وَلا نَکْفُرُک ، وَنَخْلَعُ وَنَتْرُکُ مَنْ یَفْجُرُکَ ، اللَّہُمَّ إیَّاکَ نَعْبُدُ، وَلَک نُصَلِّی وَنَسْجُدُ ، وَإِلَیْک نَسْعَی وَنَحْفِدُ ، وَنَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَک إنَّ عَذَابَک بِالْکَافِرِینَ مُلْحِقٌ۔","","Musannaf Ibn Abi Shaybah 30336","","","كتاب الدعاء"
"30337","(۳۰۳۳۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَن عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : سَمِعْتُ عُمَرَ یَقْنُتُ فِی الْفَجْرِ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنُؤْمِنُ بِکَ وَنَتَوَکَّلُ عَلَیْک وَنُثْنِی عَلَیْک الْخَیْرَ ، وَلا نَکْفُرُک ، اللَّہُمَّ إیَّاکَ نَعْبُدُ وَلَک نُصَلِّی وَنَسْجُدُ وَإِلَیْک نَسْعَی وَنَحْفِدُ ، نَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَک ، إنَّ عَذَابَک بِالْکَافِرِینَ مُلْحَقٌ ، اللَّہُمَّ عَذِّبْ کَفَرَۃَ أَہْلِ الْکِتَابِ الَّذِینَ یَصُدُّونَ عَن سَبِیلِک۔","","Musannaf Ibn Abi Shaybah 30337","","","كتاب الدعاء"
"30338","(۳۰۳۳۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلانَ ، عَن عُمَرَ بْنِ کَثِیرِ بْنِ أَفْلَحَ عَنِ ابْنِ عُمَرَ فِی الضَّالَّۃِ یَتَوَضَّأُ وَیُصَلِّی رَکْعَتَیْنِ وَیَتَشَہَّدُ وَیَقُولُ : بِسْمِ اللہِ یَا ہَادِیَ الضَّالِّ ، وَرَادَّ الضَّالَّۃِ ارْدُدْ عَلَیَّ ضَالَّتِی بِعِزَّتِکَ وَسُلْطَانِکَ فَإِنَّہَا مِنْ عَطَائِکَ وَفَضْلِک۔","Hasan","Musannaf Ibn Abi Shaybah 30338","","","كتاب الدعاء"
"30339","(۳۰۳۳۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن أُسَامَۃَ ، عَنْ أَبَانَ بْنِ صَالِحٍ ، عَن مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إنَّ لِلَّہِ مَلائِکَۃً فَضْلاً سِوَی خَلْقِہِ یَکْتُبُونَ وَرَقِ الشَّجَرِ ، فَإِذَا أَصَابَتْ أَحَدَکُمْ عَرْجَۃٌ فِی سَفَرٍ فَلِیُنَادِ : أَعِینُوا عِبَادَ اللہِ رَحِمَکُمُ اللَّہُ۔ (بزار ۳۱۲۸)","Hasan","Musannaf Ibn Abi Shaybah 30339","","","كتاب الدعاء"
"30340","(۳۰۳۴۰) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَلَی ذِرْوَۃِ کُلِّ بَعِیرٍ شَیْطَانٌ فَإِذَا رَکِبْتُمُوہَا فَقُولُوا کَمَا أَمَرَکُمُ اللَّہُ {سُبْحَانَ اللہِ الَّذِی سَخَّرَ لَنَا ہَذَا وَمَا کُنَّا لَہُ مُقْرِنِینَ} وَامْتَہِنُوہَا لأَنْفُسِکُمْ فَإِنَّمَا یَحْمِلُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 30340","","","كتاب الدعاء"
"30341","(۳۰۳۴۱) حَدَّثَنَا وَکِیعٌ ، عَن أُسَامَۃَ بْنِ زَیْدٍ ، عَن مُحَمَّدِ بْنِ حَمْزَۃَ بن عَمْرٍو ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ عَلَی ذِرْوَۃِ کُلِّ بَعِیرٍ شَیْطَانٌ ، فَإِذَا رَکِبْتُموہا فَامْتَہِنُوہَا ، وَاذْکُرُوا اسْمَ اللہِ ، ثم لاَ تقصروا عن حوائجکم۔ (احمد ۴۹۴۔ دارمی ۲۶۶۷)","Hasan","Musannaf Ibn Abi Shaybah 30341","","","كتاب الدعاء"
"30342","(۳۰۳۴۲) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَن حبیب، عَن عبد الرحمن بن أبی عمرۃ قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِن عَلَی ذِرْوَۃِ کُلِّ بَعِیرٍ شَیْطَانًا ، فَإِذَا رَکِبْتُمْ فَاذْکُرُوا اسْمَ اللہِ وَامْتَہِنُوہَا فَإِنَّمَا یَحْمِلُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 30342","","","كتاب الدعاء"
"30343","(۳۰۳۴۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَن سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ أَبِی مِجْلَزٍ ، أَنَّ حُسَیْنَ بْنَ عَلِیٍّ رَأَی رَجُلاً رَکِبَ دَابَّۃً فَقَالَ : {سُبْحَانَ الَّذِی سَخَّرَ لَنَا ہَذَا وَمَا کُنَّا لَہُ مُقْرِنِینَ} ، قَالَ أَفَبِہَذَا أُمِرْت ، قَالَ : کَیْفَ أَقُولُ ؟ قَالَ : الْحَمْدُ لِلَّہِ الَّذِی ہَدَانِی لِلإِسْلامِ الْحَمْدُ لِلَّہِ الَّذِی مَنَّ عَلَیَّ بِمُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، الْحَمْدُ لِلَّہِ الَّذِی جَعَلَنِی فِی خَیْرِ أُمَّۃٍ أُخْرِجَتْ لِلنَّاسِ ، ثُمَّ تَقُولُ: {سُبْحَانَ الَّذِی سَخَّرَ لَنَا ہذا}۔","Sahih","Musannaf Ibn Abi Shaybah 30343","","","كتاب الدعاء"
"30344","(۳۰۳۴۴) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن زُبَیْدٍ ، عَن مُرَّۃَ قَالَ : قَالَ عَبْدُ اللہِ : مَنْ جَبُنَ مِنْکُمْ عَنِ الْعَدُوِّ أَنْ یُجَاہِدَہُ ، وَاللَّیْلِ أَنْ یُکَابِدَہُ وَضَنَّ بِالْمَالِ أَنْ یُنْفِقَہُ فَلْیُکْثِرْ مِنْ سُبْحَانَ اللہِ ، وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ۔","Sahih","Musannaf Ibn Abi Shaybah 30344","","","كتاب الدعاء"
"30345","(۳۰۳۴۵) حَدَّثَنَا شَبَابَۃُ ، عَن شُعْبَۃَ ، عَنْ أَبِی التَّیَّاحِ ، عَن مُوَرِّقٍ الْعِجْلِیّ ، عَن عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : إِنْ عَجَزْتُمْ عَنِ اللَّیْلِ أَنْ تُکَابِدُوہُ ، وَعَنِ الْعَدُوِّ أَنْ تُجَاہِدُوہُ ، وَعَنِ الْمَالِ أَنْ تُنْفِقُوہُ ، فَأَکْثِرُوا مِنْ سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ فَإِنَّہُنَّ أَحَبُّ إلَیَّ مِنْ جَبَلَیْ ذَہَبٍ وَفِضَّۃٍ۔","","Musannaf Ibn Abi Shaybah 30345","","","كتاب الدعاء"
"30346","(۳۰۳۴۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الْعَوَّامِ ، أَنَّہُ سَمِعَ إبْرَاہِیمَ التَّیْمِیَّ یَقُولُ : إذَا قَالَ : الْحَمْدُ لِلَّہِ وَسُبْحَانَ اللہِ قَالَتِ الْمَلائِکَۃُ وَبِحَمْدِہِ ، فَإذَا قَالَ : سُبْحَانَ اللہِ وَبِحَمْدِہِ ، قَالَتِ الْمَلائِکَۃُ : رَحِمَکَ اللَّہُ ، فَإذَا قَالَ : اللَّہُ أَکْبَرُ ، قَالَتِ الْمَلائِکَۃُ کَبِیرًا ، فَإذَا قَالَ : اللَّہُ أَکْبَرُ کَبِیرًا ، قَالَتِ الْمَلائِکَۃُ : رَحِمَک اللَّہُ ، فَإذَا قَالَ : الْحَمْدُ لِلَّہِ ، قَالَتِ الْمَلائِکَۃُ : رَبِّ الْعَالَمِینَ ، وَإذَا قَالَ : رَبِّ الْعَالَمِینَ ، قَالَتِ الْمَلائِکَۃُ : رَحِمَک اللَّہُ۔","","Musannaf Ibn Abi Shaybah 30346","","","كتاب الدعاء"
"30347","(۳۰۳۴۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ الْجُعْفِیُّ ، عَنْ إسْرَائِیلَ ، عَن زِیَادٍ الْمصفِّر ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَبِی بَکْرٍ : أَلا أَدُلُّک عَلَی صَدَقَۃٍ تَمْلأ مَا بَیْنَ السَّمَائِ وَالأَرْضِ : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ ، وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ فِی یَوْمٍ ثَلاثِینَ مَرَّۃً۔","Hasan","Musannaf Ibn Abi Shaybah 30347","","","كتاب الدعاء"
"30348","(۳۰۳۴۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلانَ ، عَنْ عَبْدِ الْجَلِیلِ ، عَن خَالِدِ بْنِ أَبِی عِمْرَانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خُذُوا جُنَّتَکُمْ ، قَالُوا : یَا رَسُولَ اللہِ ، مِنْ عَدُوٍّ حَضَرَ ؟ قَالَ : لاَ بَلْ مِنَ النَّارِ ، قُلْنَا : مَا جُنَّتُنَا مِنَ النَّارِ ، قَالَ : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ ، وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ ، فَإِنَّہُنَّ یَأْتِینَ یَوْمَ الْقِیَامَۃِ مُقَدِّمَاتٍ وَمُعَقِّبَاتٍ وَمُجَنِّبَاتٍ ، وَہُنَّ {الْبَاقِیَاتُ الصَّالِحَاتُ}۔n(نسائی ۱۰۶۸۴۔ حاکم ۵۴۱)","","Musannaf Ibn Abi Shaybah 30348","","","كتاب الدعاء"
"30349","(۳۰۳۴۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن وقاء ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : رَأَی عُمَرُ بْنُ الْخَطَّابِ إنْسَانًا یُسَبِّحُ بِتَسَابِیحَ معہ ، فَقَالَ عُمَرُ : رحمہ اللہ إنَّمَا یُجْزِیہِ مِنْ ذَلِکَ أَنْ یَقُولَ : سُبْحَانَ اللہِ مِلْئَ السَّمَاوَاتِ وَمِلْئَ الأَرْضِ وَمِلْئَ مَا شَائَ مِنْ شَیْئٍ بَعْدُ ، وَیَقُولَ : الْحَمْدُ للہِ مِلْئَ السَّمَاوَاتِ وَمِلْئَ الأَرْضِ وَمِلْئَ مَا شَائَ مِنْ شَیْئٍ بَعْدُ ، وَیَقُولُ : اللَّہُ أَکْبَرُ مِلْئَ السَّمَاوَاتِ وَمِلْئَ الأَرْضِ وَمِلْئَ مَا شَائَ مِنْ شَیْئٍ بَعْدُ۔","","Musannaf Ibn Abi Shaybah 30349","","","كتاب الدعاء"
"30350","(۳۰۳۵۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، قَالَ : اجْتَمَعَ ابْنُ مَسْعُودٍ ، وَعَبْدُ اللہِ بْنُ عَمْرٍو ، قَالَ ابْنُ مَسْعُودٍ : لأَنْ أَقُول إذَا خَرَجْت حَتَّی أَبْلُغُ حَاجَتِی سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ أَحَبُّ إلَیَّ مِنْ أَنْ أَحْمِلَ عَلَی عَدَدِہِنَّ مِنَ الْجِیَادِ فِی سَبِیلِ اللہِ ، وَقَالَ عَبْدُ اللہِ بْنُ عَمْرٍو : لأَنْ أَقُولَہُنَّ أَحَبُّ إلَیَّ مِنْ أَنْ أُنْفِقَ عَدَدَہُنَّ دَنَانِیرَ فِی سَبِیلِ اللہِ عَزَّ وَجَلَّ۔","","Musannaf Ibn Abi Shaybah 30350","","","كتاب الدعاء"
"30351","(۳۰۳۵۱) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَن مَنْصُورٍ ، عَن سَالِمٍ ، عَن کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ أَنَّ أَحَدَکُمْ إذَا أَرَادَ أَنْ یَأْتِیَ أَہْلَہُ ، قَالَ : بِسْمِ اللہِ اللَّہُمَّ جَنِّبْنَا الشَّیْطَانَ وَجَنِّبَ الشَّیْطَانَ مَا رَزَقْتَنَا ، فَإِنَّہُ إِنْ یُقَدَّرْ بَیْنَہُمَا وَلَدٌ فِی ذَلِکَ لَمْ یَضُرَّہُ شَیْطَانٌ أَبَدًا۔","Sahih","Musannaf Ibn Abi Shaybah 30351","","","كتاب الدعاء"
"30352","(۳۰۳۵۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَن دَاوُد ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ مَوْلَی أَبِی أسَیْدَ : تَزَوَّجْت وَأَنَا مَمْلُوکٌ فَدَعَوْت نَفَرًا مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ منہم أبو مَسْعُودٍ ، وَأَبُو ذَرٍّ وَحُذَیْفَۃُ یُعَلِّمُونَنِی ، فَقَالَ : إذَا دَخَلَ عَلَیْک أَہْلُک فَصَلِّ رَکْعَتَیْنِ ، ثُمَّ سَلِ اللَّہَ مِنْ خَیْرِ مَا دَخَلَ عَلَیْک ، ثُمَّ تَعَوَّذْ بِہِ مِنْ شَرِّہِ ، ثُمَّ شَأْنُکَ وَشَأْنُ أَہْلِک۔","Da'if","Musannaf Ibn Abi Shaybah 30352","","","كتاب الدعاء"
"30353","(۳۰۳۵۳) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ ابْنِ أَخِی عَلْقَمَۃَ بْنِ قَیْسٍ ، عَنْ عَلْقَمَۃَ ، أَنَّ ابْنَ مَسْعُودٍ کَانَ إذَا غَشِیَ أَہْلَہُ فَأَنْزَلَ ، قَالَ : اللَّہُمَّ لاَ تَجْعَلْ لِلشَّیْطَانِ فِیمَا رَزَقْتَنِی نَصِیبًا۔","Da'if","Musannaf Ibn Abi Shaybah 30353","","","كتاب الدعاء"
"30354","(۳۰۳۵۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَن بَکْرٍ ، قَالَ : کَانَ یُقَالُ : إنَّ سَتْرَ مَا بَیْنَ عَوْرَاتِ بَنِی آدَمَ وَبَیْنَ أَعْیُنِ الْجِنِّ وَالشَّیَاطِینِ أَنْ یَقُولَ أَحَدُکُمْ إذَا وَضَعَ ثِیَابَہُ بِسْمِ اللہِ۔ (ترمذی ۶۰۶)","","Musannaf Ibn Abi Shaybah 30354","","","كتاب الدعاء"
"30355","(۳۰۳۵۵) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ الْقَہْرَمَانِیِّ ، عَن سَالِمِ بْنِ عَبْدِ اللہِ بْنِ عُمَرَ ، عَنْ أَبِیہِ ، قَالَ : مَا مِنْ رَجُلٍ یَرَی مُبْتَلًی فَیَقُولُ : الْحَمْدُ لِلَّہِ الَّذِی عَافَانِی مِمَّا ابْتَلاک بِہِ وَفَضَّلَنِی عَلَیْک ، وَعَلَی کَثِیرٍ مِنْ خَلْقِہِ تَفْضِیلاً إِلاَّ عَافَاہُ اللَّہُ مِنْ ذَلِکَ الْبَلائِ کَائِنًا مَا کَانَ۔ (ترمذی ۳۴۳۱۔ ابن ماجہ ۳۸۹۲)","Da'if","Musannaf Ibn Abi Shaybah 30355","","","كتاب الدعاء"
"30356","(۳۰۳۵۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : لَمَّا بُعِثَ مُوسَی إِلَی فِرْعَوْنَ ، قَالَ : رَبِّ أَیَّ شَیْئٍ أَقُولُ ؟ قَالَ : قُلْ : ہَیَّا شَرًّا ہَیَّا ، قَالَ الأَعْمَشُ : تَفْسِیرُ ذَلِکَ : الْحَیُّ قَبْلَ کُلِّ شَیْئٍ ، وَالْحَیُّ بَعْدَ کُلِّ شَیْئٍ۔","","Musannaf Ibn Abi Shaybah 30356","","","كتاب الدعاء"
"30357","(۳۰۳۵۷) حَدَّثَنَا وَکِیعٌ ، عَنِ أبی العمیس ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ عُتْبَۃَ ، عَنِ ابْنِ حُذَیْفَۃَ ، عَنْ أَبِیہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا دَعَا لِرَجُلٍ أَصَابَتْہُ وَأَصَابَتْ وَلَدَہُ وَوَلَدَ وَلَدِہِ۔ (احمد ۳۸۵)","Da'if","Musannaf Ibn Abi Shaybah 30357","","","كتاب الدعاء"
"30358","(۳۰۳۵۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إنَّ الرَّجُلَ لَیُرْفَعُ بِدُعَائِ وَلَدِہِ مِنْ بَعْدِہِ۔","","Musannaf Ibn Abi Shaybah 30358","","","كتاب الدعاء"
"30359","(۳۰۳۵۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَاصِمِ بْنِ بَہْدَلَۃَ عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ الرَّجُلَ لَتُرْفَعُ لَہُ الدَّرَجَۃُ فِی الْجَنَّۃِ فَیَقُولُ : یَا رَبِّ أَنَّی لِی ہَذِہِ ؟ فَیُقَالُ : بِاسْتِغْفَارِ وَلَدِک۔ (احمد ۵۰۹)","Sahih","Musannaf Ibn Abi Shaybah 30359","","","كتاب الدعاء"
"30360","(۳۰۳۶۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن ہِشَامِ بْنِ حَسَّانَ ، عَنِ الْحَسَنِ ، عَنْ جَابِرِ بْنِ عبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا تَغَوَّلَتْ لکُمَ الْغِیلانُ فَنَادُوا بِالأَذَانِ۔ (نسائی ۱۰۷۹۱)","Hasan","Musannaf Ibn Abi Shaybah 30360","","","كتاب الدعاء"
"30361","(۳۰۳۶۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الشَّیْبَانِیِّ ، عَن یُسَیْرِ بْنِ عَمْرٍو ، قَالَ : ذُکِرَتِ الْغِیلانُ عِنْدَ عُمَر رحمہ اللہ فَقَالَ : إِنَّہُ لَیْسَ مِنْ شَیْئٍ یَسْتَطِیعُ أن یتغیر عَن خَلْقِ اللہِ خَلْقَہُ ، وَلَکِنْ لَہُمْ سَحَرَۃٌ کَسَحَرَتِکُمْ ، فَإِذَا رَأَیْتُمْ مِنْ ذَلِکَ شَیْئًا فَأَذِّنُوا۔","Sahih","Musannaf Ibn Abi Shaybah 30361","","","كتاب الدعاء"
"30362","(۳۰۳۶۲) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ عن سفیان ، عَنِ ابْنِ أَبِی لَیْلَی عَنْ أَخِیہِ عِیسَی بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ أَبِی أَیُّوبَ ، أَنَّہُ کَانَ فِی سَہْوَۃٍ لَہُ فَکَانَتِ الْغُولُ تَجِیئُ ، فَشَکَاہَا إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : إذَا رَأَیْتہَا فَقُلْ : بِسْمِ اللہِ أَجِیبِی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: فَجَائَتْہُ فَقَالَ : لَہَا فَأَخَذَہَا فَقَالَتْ لَہُ : إنِّی لاَ أَعُودُ ، فَأَرْسَلِہَا ، فَجَائَ فَقَالَ لَہُ : النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا فَعَلَ أَسِیرُک ؟ فَقَالَ : أَخَذْتہَا فَقَالَتْ : إنِّی لاَ أَعُودُ ، فَأَرْسَلْتہَا ، فَقَالَ : إِنَّہَا عَائِدَۃٌ ، فَأَخَذْتہَا مَرَّتَیْنِ، أَوْ ثَلاثًا کُلَّ ذَلِکَ تَقُولُ: لاَ أَعُودُ، وَیَجِیئُ إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَیَقُولُ: مَا فَعَلَ أَسِیرُک؟ فَیَقُولُ : أَخَذْتہَا فَتَقُولُ : لاَ أَعُودُ ، فَیَقُولُ : إِنَّہَا عَائِدَۃٌ فَأَخَذْتہَا فَقَالَتْ : أَرْسِلْنِی وَأُعَلِّمُک شَیْئًا تَقُولُہُ لاَ یَقْرَبُک شَیْئٌ، آیَۃَ الْکُرْسِی، فَأَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرَہُ فَقَالَ: صَدَقَتْ وَہِیَ کَذُوبٌ۔ (ترمذی ۲۸۸۰۔ احمد ۴۲۳)","Da'if","Musannaf Ibn Abi Shaybah 30362","","","كتاب الدعاء"
"30363","(۳۰۳۶۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ عُمَرَ ، قَالَ : حدَّثَنِی مَنْ لاَ أَتَّہِمُ مِنْ أَہْلِ الشَّامِ ، عَن عُبَادَۃَ بْنِ الصَّامِتِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا رَأَی الْہِلالَ ، قَالَ : اللَّہُ أَکْبَرُ اللَّہُ أَکْبَرُ الْحَمْدُ لِلَّہِ لاَ حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ ، اللَّہُمَّ إنِّی أَسْأَلُک خَیْرَ ہَذَا الشَّہْرِ وَأَعُوذُ بِکَ مِنْ شَرِّ الْقَدَرِ وَأَعُوذُ بِکَ مِنْ شَرِّ یَوْمِ الْحَشْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 30363","","","كتاب الدعاء"
"30364","(۳۰۳۶۴) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، قَالَ : انْصَرَفْت مَعَ سَعِیدِ بْنِ الْمُسَیَّبِ فَقُلْنَا: ہَذَا الْہِلالُ یَا أَبَا مُحَمَّدٍ ، فَلَمَّا أَبْصَرَہُ ، قَالَ : آمَنْت بِالَّذِی خَلَقَک فَسَوَّاک فَعَدَلَک ، ثُمَّ الْتَفَتَ إلَیَّ فَقَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا رَأَی الْہِلالَ ، قَالَ ہَکَذَا۔","","Musannaf Ibn Abi Shaybah 30364","","","كتاب الدعاء"
"30365","(۳۰۳۶۵) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبِیدَۃَ ، عَنْ عَلِیٍّ رضی اللہ عنہ ، قَالَ : إذَا رَأَی أَحَدُکُمَ الْہِلالَ فَلا یَرْفَعْ بِہِ رَأْسًا إنما یَکْفِی أَحَدَکُمْ أَنْ یَقُولَ : رَبِّی وَرَبُّک اللَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30365","","","كتاب الدعاء"
"30366","(۳۰۳۶۶) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، أَنَّ عَلِیًّا کَانَ یَقُولُ إذَا رَأَی الْہِلالَ : اللَّہُمَّ ارْزُقْنَا خَیْرَہُ وَنَصْرَہُ وَبَرَکَتَہُ وَنُورَہُ وَنَعُوذُ بِکَ مِنْ شَرِّہِ وَشَرِّ مَا بَعْدَہُ۔","","Musannaf Ibn Abi Shaybah 30366","","","كتاب الدعاء"
"30367","(۳۰۳۶۷) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، قَالَ : حدَّثَنَا حُجَّاجُ بْنُ دِینَارٍ ، عَن مَنْصُورٍ ، عَن مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَرِہَ أَنْ یَنْتَصِبَ لِلْہِلالِ وَلَکِنْ یَعْتَرِضُ فَیَقُولُ : اللَّہُ أَکْبَرُ الْحَمْدُ لِلَّہِ الَّذِی ذَہَبَ بِہِلالِ کَذَا وَکَذَا ، وَجَائَ بِہِلالِ کَذَا وَکَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 30367","","","كتاب الدعاء"
"30368","(۳۰۳۶۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَن قَتَادَۃَ ، أَنَّ نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا رَأَی الْہِلالَ ، قَالَ : ہِلالُ خَیْرٍ وَرُشْدٍ ، ہِلالُ رُشْدٍ وَخَیْرٍ ، ہِلالُ خَیْرٍ وَرُشْدٍ ، آمَنْت بِالَّذِی خَلَقَک ثَلاثًا ، الْحَمْدُ لِلَّہِ ذَہَبَ بہِلالِ کَذَا وَکَذَا ، وَجَائَ بِہِلالِ کَذَا وَکَذَا۔","Da'if","Musannaf Ibn Abi Shaybah 30368","","","كتاب الدعاء"
"30369","(۳۰۳۶۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، قَالَ : سَأَلْتُ ہِشَامَ بْنَ حَسَّانَ : أَیُّ شَیْئٍ کَانَ الْحَسَنَ یَقُولُ إذَا رَأَی الْہِلالَ ؟ قَالَ : کَانَ یَقُولُ : اللَّہُمَّ اجْعَلْہُ شَہْرَ بَرَکَۃٍ وَنُورٍ وَأَجْرٍ وَمُعَافَاۃٍ اللَّہُمَّ إنَّک قَاسِمٌ بَیْنَ عِبَادٍ مِنْ عِبَادِکَ فِیہِ خَیْرًا فَاقْسِمْ لَنَا فِیہِ مِنْ خَیْرِ مَا تَقْسِمُ لِعِبَادِکَ الصَّالِحِینَ۔","","Musannaf Ibn Abi Shaybah 30369","","","كتاب الدعاء"
"30370","(۳۰۳۷۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، قَالَ : سَأَلْتُ ابْنَ جُرَیْجٍ فَذَکَرَ عَنْ عَطَائٍ ، أَنَّ رَجُلاً أَہَلَّ ہِلالاً بِفَلاۃٍ مِنَ الأَرْضِ ، قَالَ : فَسَمِعَ قَائِلاً یَقُولُ : اللَّہُمَّ أَہِلَّہُ عَلَیْنَا بِالأَمْنِ وَالإِیمَانِ وَالسَّلامَۃِ وَالإِسْلامِ وَالْہُدَی وَالْمَغْفِرَۃِ وَالتَّوْفِیقِ لِمَا تَرْضَی وَالْحِفْظِ مِمَّا تَسْخَطُ ، رَبِّی وَرَبُّک اللَّہُ ، قَالَ : فَلَمْ یُتِمَّہُنَّ حَتَّی حَفِظْتہنَّ وَلَمْ أَرَ أَحَدًا۔","","Musannaf Ibn Abi Shaybah 30370","","","كتاب الدعاء"
"30371","(۳۰۳۷۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُعْجِبُہُمْ إذَا رَأَی الرَّجُلُ الْہِلالَ أَنْ یَقُولَ : رَبِّی وَرَبُّک اللَّہُ۔","","Musannaf Ibn Abi Shaybah 30371","","","كتاب الدعاء"
"30372","(۳۰۳۷۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا أَصَبْغُ بْنُ زَیْدٍ حَدَّثَنَا أَبُو الْعَلائِ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : لَبِسَ عُمَرُ بْنُ الْخَطَّابِ ثَوْبًا جَدِیدًا فَقَالَ : الْحَمْدُ لِلَّہِ الَّذِی کَسَانِی مَا أُوَارِی بِہِ عَوْرَتِی وَأَتَجَمَّلُ بِہِ فِی حَیَاتِی ثُمَّ قَالَ سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ لَبِسَ ثَوْبًا جَدِیدًا فَقَالَ : الْحَمْدُ لِلَّہِ الَّذِی کَسَانِی مَا أُوَارِی بِہِ عَوْرَتِی وَأَتَجَمَّلُ بِہِ فِی حَیَاتِی ، ثُمَّ عَمَدَ إِلَی الثَّوْبِ الَّذِی أَخْلَقَ ، أَوْ قَالَ : أَلْقَی ، فَتَصَدَّقَ بِہِ کَانَ فِی کَنَفِ اللہِ وَفِی حِفْظِ اللہِ وَفِی سِتْرِ اللہِ حَیًّا وَمَیِّتًا قَالَہَا ثَلاثًا۔","Da'if","Musannaf Ibn Abi Shaybah 30372","","","كتاب الدعاء"
"30373","(۳۰۳۷۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَخِیہِ عِیسَی ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا لَبِسَ أَحَدُکُمْ ثَوْبًا جَدِیدًا فَلْیَقُلْ : الْحَمْدُ لِلَّہِ الَّذِی کَسَانِی مَا أُوَارِی بِہِ عَوْرَتِی وَأَتَجَمَّلُ بِہِ فِی النَّاسِ۔","Da'if","Musannaf Ibn Abi Shaybah 30373","","","كتاب الدعاء"
"30374","(۳۰۳۷۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِی الأَشْہَبِ ، عَن رَجُلٍ مِنْ مُزَیْنَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی عَلَی عُمَرَ ثَوْبًا غَسِیلاً فَقَالَ : أجَدِیدٌ ثَوْبُک ہَذَا ؟ قَالَ : غَسِیلٌ یَا رَسُولَ اللہِ ، قَالَ : فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْبَسْ جَدِیدًا وَعِشْ حَمِیدًا وَتَوَفَّ شَہِیدًا یُعْطِکَ اللَّہُ قُرَّۃَ عَیْنٍ فِی الدُّنْیَا وَالآخِرَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 30374","","","كتاب الدعاء"
"30375","(۳۰۳۷۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی وَہْبٍ ، عَن مَنْصُورٍ عَن سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ : إذَا لَبِسَ الإِنْسَاْن الثَّوْبَ الْجَدِیدَ فَقَالَ : اللَّہُمَّ اجْعَلْہَا ثِیَابًا مُبَارَکَۃً نَشْکُرُ فِیہَا نِعْمَتَکَ ، وَنُحْسِنُ فِیہَا عِبَادَتَکَ ، وَنَعْمَلُ فِیہَا بِطَاعَتِکَ ، لَمْ تُجَاوِزْ تَرْقُوَتَہُ حَتَّی یَغْفِرَ لَہُ۔","","Musannaf Ibn Abi Shaybah 30375","","","كتاب الدعاء"
"30376","(۳۰۳۷۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا مِسْعَرٌ ، قَالَ : حدَّثَنَا عَوْنُ بْنُ عَبْدِ اللہِ ، قَالَ : لَبِسَ رَجُلٌ ثَوْبًا جَدِیدًا فَحَمِدَ اللَّہَ ، فَأُدْخِلَ الْجَنَّۃَ ، أَوْ غُفِرَ لَہُ ، قَالَ : فَقَالَ لَہُ رَجُلٌ : أَرْجِعُ إِلَی أَہْلِی حَتَّی أَلْبَسَ ثَوْبًا جَدِیدًا وَأَحْمَدُ اللَّہَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 30376","","","كتاب الدعاء"
"30377","(۳۰۳۷۷) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، قَالَ : کَانَ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا رَأَوْا عَلَی أَحَدِہِمَ الثَّوْبَ الْجَدِیدَ قَالُوا : تُبْلِی وَیُخْلِفُ اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30377","","","كتاب الدعاء"
"30378","(۳۰۳۷۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا الْجُرَیْرِیُّ ، عَنْ أَبِی نَضْرَۃَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا لَبِسَ ثَوْبًا جَدِیدًا سَمَّاہُ بِاسْمِہِ إِنْ کَانَ قَمِیصًا ، أَوْ إزَارًا ، أَوْ عِمَامَۃً یَقُولُ اللَّہُمَّ لَکَ الْحَمْدُ أَنْتَ کَسَوْتنِی ہَذَا ، أَسْأَلُک مِنْ خَیْرِہِ وَخَیْرِ مَا صُنِعَ لَہُ وَأَعُوذُ بِکَ مِنْ شَرِّہِ وَشَرِّ مَا صُنِعَ لَہُ۔","","Musannaf Ibn Abi Shaybah 30378","","","كتاب الدعاء"
"30379","(۳۰۳۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا [corrupt]ِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ فِی قَوْلِہِ : (وَلا تَجْہَرْ بِصَلاتِکَ وَلا تُخَافِتْ بِہَا) قَالَتْ : الدُّعَائُ۔","Sahih","Musannaf Ibn Abi Shaybah 30379","","","كتاب الدعاء"
"30380","(۳۰۳۸۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن عُبَیْدٍ الْمُکْتِبِ ، عَنْ إبْرَاہِیمَ وَعَنْ سُفْیَانَ ، عَن سِمَاکِ بْنِ عُبَیْدٍ ، عَنْ عَطَائٍ ، قَالَ : الدُّعَائُ۔","","Musannaf Ibn Abi Shaybah 30380","","","كتاب الدعاء"
"30381","(۳۰۳۸۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ الْہَجَرِیِّ ، عَنْ أَبِی عِیَاضٍ ، قَالَ : الدُّعَائُ۔","","Musannaf Ibn Abi Shaybah 30381","","","كتاب الدعاء"
"30382","(۳۰۳۸۲) حَدَّثَنَا بَکْرُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : حدَّثَنَا عِیسَی بْنُ الْمُخْتَارِ ، عَن مُحَمَّدٍ ، عَنِ الْحَکَمِ ، عَن مُجَاہِدٍ فِی ہَذِہِ الآیَۃِ : {وَلا تَجْہَرْ بِصَلاتِکَ وَلا تُخَافِتْ بِہَا} قَالَ : ذَلِکَ فِی الدُّعَائِ وَالْمَسْأَلَۃِ۔","","Musannaf Ibn Abi Shaybah 30382","","","كتاب الدعاء"
"30383","(۳۰۳۸۳) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، وَأَبُو مُعَاوِیَۃَ ، عَن لَیْثٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَسَنِ ، عَن أُمِّہِ ، عَن فَاطِمَۃَ بِنْتِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا دَخَلَ الْمَسْجِدَ یَقُولُ : بِسْمِ اللہِ وَعَلَی سُنَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اللَّہُمَّ اغْفِرْ لِی ذُنُوبِی وَافْتَحْ لِی أَبْوَابَ رَحْمَتِکَ ، وَإِذَا خَرَجَ ، قَالَ : بِسْمِ اللہِ وَالسَّلامُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، اللَّہُمَّ اغْفِرْ لِی ذُنُوبِی ، وَافْتَحْ لِی أَبْوَابَ فَضْلِک۔","Da'if","Musannaf Ibn Abi Shaybah 30383","","","كتاب الدعاء"
"30384","(۳۰۳۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، عَنْ أَبِی ہِنْدٍ ، عَنْ عَمْرِو بْنِ عَمْرٍو الْمَدَنِیِّ ، عَنِ الْمُطَّلِبِ بْنِ عَبْدِ اللہِ بْنِ حَنْطَبٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا دَخَلَ الْمَسْجِدَ ، قَالَ : اللَّہُمَّ افْتَحْ لِی أَبْوَابَ رَحْمَتِکَ وَیَسِّرْ لِی أَبْوَابَ رِزْقِک۔","","Musannaf Ibn Abi Shaybah 30384","","","كتاب الدعاء"
"30385","(۳۰۳۸۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ النُّعْمَانِ بْنِ سَعْدٍ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ إذَا دَخَلَ الْمَسْجِدَ ، قَالَ : اللَّہُمَّ اغْفِرْ لِی ذُنُوبِی وَافْتَحْ لِی أَبْوَابَ رَحْمَتِکَ ، وَإِذَا خَرَجَ ، قَالَ : اللَّہُمَّ اغْفِرْ لِی ذُنُوبِی وَافْتَحْ لِی أَبْوَابَ فَضْلِک۔","Da'if","Musannaf Ibn Abi Shaybah 30385","","","كتاب الدعاء"
"30386","(۳۰۳۸۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلانَ ، عَن سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ لِی کَعْبُ بْنُ عُجْرَۃَ : إذَا دَخَلْت الْمَسْجِدَ الْحَرَامَ فَسَلِّمْ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقُلِ : اللَّہُمَّ افْتَحْ لِی أَبْوَابَ رَحْمَتِکَ ، وَإِذَا خَرَجْت فَسَلِّمْ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقُلِ : اللَّہُمَّ احْفَظْنِی مِنَ الشَّیْطَانِ الرَّجِیمِ۔","","Musannaf Ibn Abi Shaybah 30386","","","كتاب الدعاء"
"30387","(۳۰۳۸۷) حَدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَن یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَن مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ عَبْدَ اللہِ بْنَ سَلامٍ کَانَ إذَا دَخَلَ الْمَسْجِدَ سَلَّمَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقَالَ : اللَّہُمَّ افْتَحْ لِی أَبْوَابَ رَحْمَتِکَ ، وَإِذَا خَرَجَ سَلَّمَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَتَعَوَّذَ مِنَ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 30387","","","كتاب الدعاء"
"30388","(۳۰۳۸۸) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَن سَعِیدِ بْنِ ذِی حُدَّانِ ، عَنْ عَلْقَمَۃَ ، أَنَّہُ کَانَ إذَا دَخَلَ الْمَسْجِدَ ، قَالَ : سَلامٌ عَلَیْک أَیُّہَا النَّبِیُّ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ ، صَلَّی اللَّہُ وَمَلائِکَتُہُ عَلَی مُحَمَّدٍ۔","","Musannaf Ibn Abi Shaybah 30388","","","كتاب الدعاء"
"30389","(۳۰۳۸۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ کَانَ إذَا دَخَلَ الْمَسْجِدَ ، قَالَ : بِسْمِ اللہِ وَالسَّلامُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 30389","","","كتاب الدعاء"
"30390","(۳۰۳۹۰) حَدَّثَنَا حَبِیبُ بْنُ أَبِی حَبِیبٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَکَمِ ، قَالَ : مَنْ سَمِعَ الْمُنَادِیَ یُنَادِی بِإِقَامَۃِ الصَّلاۃِ فَقَالَ : اللَّہُمَّ رَبَّ ہَذِہِ الدَّعْوَۃِ التَّامَّۃِ وَالصَّلاۃِ الْقَائِمَۃِ أَعْطِ مُحَمَّدًا سُؤْلَہُ یَوْمَ الْقِیَامَۃِ إِلاَّ کَانَ مِمَّنْ یَشْفَعُ لَہُ۔","","Musannaf Ibn Abi Shaybah 30390","","","كتاب الدعاء"
"30391","(۳۰۳۹۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی حَمْزَۃَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا سَمِعْت الْمُؤَذِّنَ ، قَالَ قَدْ قَامَتِ الصَّلاۃُ فَقُلِ : اللَّہُمَّ رَبَّ ہَذِہِ الدَّعْوَۃِ التَّامَّۃِ وَالصَّلاۃِ الْقَائِمَۃِ أَعْطِ مُحَمَّدًا صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُؤْلَہُ یَوْمَ الْقِیَامَۃِ لاَ یَقُولُہَا رَجُلٌ حِینَ یَقُومُ الْمُؤَذِّنُ إِلاَّ أَدْخَلَہُ اللَّہُ فِی شَفَاعَۃِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 30391","","","كتاب الدعاء"
"30392","(۳۰۳۹۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن سَعِیدٍ ، عَن قَتَادَۃَ ، أَنَّ عُثْمَانَ کَانَ إذَا سَمِعَ الْمُؤَذِّنَ ، قَالَ قَدْ قَامَتِ الصَّلاۃُ ، قَالَ : مَرْحَبًا بِالْقَائِلِینَ عَدْلاً وَبِالصَّلاۃِ مَرْحَبًا وَأَہْلاً ، ثُمَّ یَنْہَضُ إِلَی الصَّلاۃِ۔","","Musannaf Ibn Abi Shaybah 30392","","","كتاب الدعاء"
"30393","(۳۰۳۹۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ عَمَّنْ أَخْبَرَہُ ، عَن مُجَاہِدٍ ، أَنَّہُ کَانَ إذَا قَالَ الْمُؤَذِّنُ حَیَّ عَلَی الصَّلاۃِ ، قَالَ : الْمُسْتَعَانُ اللہ ، فَإذَا قَالَ : حَیَّ عَلَی الْفَلاحِ ، قَالَ : لاَ حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ۔","","Musannaf Ibn Abi Shaybah 30393","","","كتاب الدعاء"
"30394","(۳۰۳۹۴) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، عَن عُبَیْدِ اللہ بنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ أَبِیہِ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ مِثْلَ مَا یَقُولُ الْمُؤَذِّنُ ، فَإذَا قَالَ حَیَّ عَلَی الصَّلاۃِ حَیَّ عَلَی الْفَلاحِ ، قَالَ : لاَ حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30394","","","كتاب الدعاء"
"30395","(۳۰۳۹۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنَا مُعَاوِیَۃُ بْنُ صَالِحٍ ، قَالَ : حَدَّثَنِی حَبِیبُ بْنُ عُبَیْدٍ الْکَلاعِیُّ ، عَن جُبَیْرِ بْنِ نُفَیْرٍ الْحَضْرَمِیِّ ، عَنْ عَوْفِ بْنِ مَالِکٍ الأَشْجَعِیِّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ عَلَی الْمَیِّتِ : اللَّہُمَّ اغْفِرْ لَہُ وَارْحَمْہُ وَعَافِہِ وَاعْفُ عَنْہُ وَأَکْرِمْ نُزُلَہُ وَأَوْسِعْ مُدْخَلَہُ وَاغْسِلْہُ بِالْمَائِ وَالثَّلْجِ وَالْبَرَدِ ، وَنَقِّہِ مِنَ الْخَطَایَا کَمَا یُنَقَّی الثَّوْبُ الأَبْیَضَ مِنَ الدَّنَسِ ، اللَّہُمَّ أَبْدِلْہُ دَارًا خَیْرًا مِنْ دَارِہِ ، وَزَوْجًا خَیْرًا مِنْ زَوْجِہِ ، وَأَہْلاً خَیْرًا مِنْ أَہْلِہِ وَأَدْخِلْہُ الْجَنَّۃَ ، وَنَجِّہِ مِنَ النَّارِ ، أَوْ قَالَ : وَقِہ عَذَابَ النَّارِ ، حَتَّی تَمَنَّیْت أَنْ أَکُونَ أَنَا ہُوَ۔","Sahih","Musannaf Ibn Abi Shaybah 30395","","","كتاب الدعاء"
"30396","(۳۰۳۹۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتوَائِیُّ ، عَن یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی إبْرَاہِیمَ الأَنْصَارِیِّ ، عَنْ أَبِیہِ ، أَنَّہُ سَمِعَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یقول فِی الصَّلاۃِ عَلَی الْمَیِّتِ : اللَّہُمَّ اغْفِرْ لِحَیِّنَا وَمَیِّتِنَا وَشَاہِدِنَا وَغَائِبِنَا وَذَکَرِنَا وَأُنْثَانَا وَصَغِیرِنَا وَکَبِیرِنَا۔","Da'if","Musannaf Ibn Abi Shaybah 30396","","","كتاب الدعاء"
"30397","(۳۰۳۹۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن شُعْبَۃَ ، عَنِ الْجُلاسِ ، عَن عُثْمَانَ بْنِ شَمَّاسٍ ، قَالَ : کُنَّا عِنْدَ أَبِی ہُرَیْرَۃَ فَمَرَّ بِہِ مَرْوَانُ فَقَالَ لہ : بَعْضَ حَدِیثَکَ عَن رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ مَضَی ، ثُمَّ رَجَعَ فَقُلْنَا : الآنَ یَقَعُ بِہِ ، فَقَالَ : کَیْفَ سمعت رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی عَلَی الْجَِنَازَۃِ ؟ ، قَالَ : سَمِعْتُہُ یَقُولُ أَنْتَ ہَدَیْتہَا لِلإِسْلامِ وَأَنْتَ قَبَضْت رُوحَہَا ، تَعْلَمُ سِرَّہَا وَعَلانِیَتَہَا ، جِئْنَاک شُفَعَائَ فَاغْفِرْ لَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 30397","","","كتاب الدعاء"
"30398","(۳۰۳۹۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَن رَجُلٍ مِنْ أَہْلِ مَکَّۃَ ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ فِی الصَّلاۃِ عَلَی الْجِنَازَۃِ : اللَّہُمَّ اغْفِرْ لِحَیِّنَا وَمَیِّتِنَا وَذَکَرِنَا وَأُنْثَانَا وَشَاہِدِنَا وَغَائِبِنَا وَصَغِیرِنَا وَکَبِیرِنَا اللَّہُمَّ مَنْ أَحْیَیْتہ مِنَّا فَأَحْیِہِ عَلَی الإِسْلامِ ، وَمَنْ تَوَفَّیْتہ مِنَّا فَتَوَفَّہُ عَلَی الإِسْلامِ۔","Da'if","Musannaf Ibn Abi Shaybah 30398","","","كتاب الدعاء"
"30399","(۳۰۳۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن حُصَیْنٍ ، عَنْ أَبِی مَالِکٍ ، قَالَ : کَانَ أَبُو بَکْرٍ إذَا صَلَّی عَلَی الْمَیِّتِ ، قَالَ : اللَّہُمَّ عَبْدُک أَسْلَمَہُ الأَہْلَ وَالْمَالَ وَالْعَشِیرَۃَ ، وَالذَّنْبُ عَظِیمٌ وَأَنْتَ غَفُورٌ رَحِیمٌ۔","","Musannaf Ibn Abi Shaybah 30399","","","كتاب الدعاء"
"30400","(۳۰۴۰۰) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَن طَارِقٍ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ، قَالَ: کَانَ عُمَرُ یَقُولُ فِی الصَّلاۃِ إِنْ کَانَ مسائ، قَالَ : اللَّہُمَّ أَمْسَی عَبْدُک ، وَإِنْ کَانَ صَبَاحًا ، قَالَ : اللَّہُمَّ أَصْبَحَ عَبْدُک قَدْ تَخَلَّی مِنَ الدُّنْیَا وَتَرَکَہَا لأَہْلِہَا وَاسْتَغْنَتْ عَنْہُ وَافْتَقَرَ إلَیْک کَانَ یَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ أَنْتَ وَأَنَّ مُحَمَّدًا عَبْدُک وَرَسُولُک فَاغْفِرْ لہ ذُنُوبَہُ۔","","Musannaf Ibn Abi Shaybah 30400","","","كتاب الدعاء"
"30401","(۳۰۴۰۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن مَنْصُورٍ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی قَالَ : کَانَ عَلِیٌّ یَقُولُ فِی الصَّلاۃِ عَلَی الْمَیِّتِ : اللَّہُمَّ اغْفِرْ لأَحْیَائِنَا وَأَمْوَاتِنَا وَأَلِّفْ بَیْنَ قُلُوبِنَا ، وَأَصْلِحْ ذَاتَ بَیْنِنَا وَاجْعَلْ قُلُوبَنَا عَلَی قُلُوبِ خِیَارِنَا ، اللَّہُمَّ اغْفِرْ لَہُ اللَّہُمَّ ارْحَمْہُ اللَّہُمْ أَرْجِعْہُ إِلَی خَیْرٍ مِمَّا کَانَ فِیہِ ، اللَّہُمَّ عَفْوَک۔","","Musannaf Ibn Abi Shaybah 30401","","","كتاب الدعاء"
"30402","(۳۰۴۰۲) حَدَّثَنَا عَبْدُالْوَہَّابِ الثَّقَفِیُّ، عَن خَالِدٍ، قَالَ: کُنْتُ فِی جَِنَازَۃِ غُنَیْمٍ فَحَدَّثَنِی رَجُلٌ عَنْہُ، أَنَّہُ، قَالَ: سَمِعْتُ أَبَا مُوسَی صَلَّی عَلَی مَیِّتٍ فَکَبَّرَ فَقَالَ : اللَّہُمَّ اغْفِرْ لَہُ کَمَا اسْتَغْفَرَک وَأَعْطِہِ مَا سَأَلَک وَزِدْہُ مِنْ فَضْلِک۔","Da'if","Musannaf Ibn Abi Shaybah 30402","","","كتاب الدعاء"
"30403","(۳۰۴۰۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ بْنُ سَلامٍ الصَّلاۃُ عَلَی الْجِنَازَۃِ أَنْ تَقُولَ : اللَّہُمَّ اغْفِرْ لِحَیِّنَا وَمَیِّتِنَا وَصَغِیرِنَا وَکَبِیرِنَا وَذَکَرِنَا وَأُنْثَانَا وَشَاہِدِنَا وَغَائِبِنَا ، اللَّہُمَّ مَنْ تَوَفَّیْتہ مِنَّا فَتَوَفَّہُ عَلَی الإِیمَانِ ، وَمَنْ أَبْقَیْتہ مِنَّا فَأَبْقِہِ عَلَی الإِسْلامِ۔","Hasan","Musannaf Ibn Abi Shaybah 30403","","","كتاب الدعاء"
"30404","(۳۰۴۰۴) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن زَیْدٍ الْعَمِّیِّ ، عَنْ أَبِی الصِّدِّیقِ النَّاجِی ، قَالَ : سَأَلْتُ أَبَا سَعِیدٍ ، عَنِ الصَّلاۃِ عَلَی الْجِنَازَۃِ ، فقَالَ : کُنَّا نَقُولُ : اللَّہُمَّ رَبَّنَا وَرَبَّہُ خَلَقْتہ وَرَزَقْتہ وَأَحْیَیْتہ وَکَفَیْتہ فَاغْفِرْ لَنَا وَلَہُ ، وَلا تَحْرِمْنَا أَجْرَہُ ، وَلا تُضِلَّنَا بَعْدَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30404","","","كتاب الدعاء"
"30405","(۳۰۴۰۵) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، قَالَ : حَدَّثَنَا خَالِدٌ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنِ ابْنِ عَمْرِو بْنِ غَیْلانَ ، عَنْ أَبِی الدَّرْدَائِ ، أَنَّہُ کَانَ یَقُولُ فِی الصَّلاۃِ عَلَی الْمَیِّتِ : اللَّہُمَّ اغْفِرْ لأَحْیَائِنَا وَأَمْوَاتِنَا الْمُسْلِمِینَ اللَّہُمَّ اغْفِرْ لِلْمُؤْمِنِینَ وَالْمُؤْمِنَاتِ وَالْمُسْلِمِینَ وَالْمُسْلِمَاتِ وَأَصْلِحْ ذَاتَ بَیْنِہِمْ ، وَأَلِّفْ بَیْنَ قُلُوبِہِمْ ، وَاجْعَلْ قُلُوبَہُمْ عَلَی قُلُوبِ أخْیَارِہِمَ اللَّہُمَّ اغْفِرْ لِفُلانِ بْنِ فُلانٍ ذَنْبَہُ ، وَأَلْحِقْہُ بِنَبِیِّہِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، اللَّہُمَّ ارْفَعْ دَرَجَتَہُ فِی الْمُہْتَدِینَ وَاخْلُفْہُ فِی عَقِبِہِ فِی الْغَابِرِینَ ، وَاجْعَلْ کِتَابَہُ فِی عَلِیَّیْنِ، وَاغْفِرْ لَنَا وَلَہُ یَا رَبَّ الْعَالَمِینَ ، اللَّہُمَّ لاَ تَحْرِمْنَا أَجْرَہُ ، وَلا تضِلنا بَعْدَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30405","","","كتاب الدعاء"
"30406","(۳۰۴۰۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ فِی الْجِنَازَۃِ إذَا صَلَّی عَلَیْہِ : اللَّہُمَّ بَارِکْ فِیہِ وَصَلِّ عَلَیْہِ وَاغْفِرْ لَہُ ، وَأَوْرِدْہُ حَوْضَ رَسُولِکَ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ فِی قِیَامٍ کَثِیرٍ وَکَلام کَثِیرٍ لَمْ أَفْہَمْ مِنْہُ غَیْرَ ہَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 30406","","","كتاب الدعاء"
"30407","(۳۰۴۰۷) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ حَرِیزٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی عَوْفٍ ، عَنِ ابْنِ لُحَیٍّ الْہَوْزَنِیِّ ، أَنَّہُ شَہِدَ جِنَازَۃَ شُرَحْبِیلَ بْنِ السِّمْطِ فَقَدِمَ عَلَیْہَا حَبِیبُ بْنُ مَسْلَمَۃَ الْفِہْرِیُّ فَأَقْبَلَ عَلَیْنَا کَالْمُشْرِفِ عَلَیْنَا مِنْ طُولِہِ فَقَالَ : اجْتَہِدُوا لأَخِیکُمْ فِی الدُّعَائِ ، وَلْیَکُنْ مِمَّا تَدْعُونَ لَہُ اللَّہُمَّ اغْفِرْ لِہَذِہِ النَّفْسِ الْحَنَفِیَّۃِ المسلمۃ وَاجْعَلْہَا مِنَ الَّذِینَ تَابُوا وَاتَّبَعُوا سَبِیلَک ، وَقِہَا عَذَابَ الْجَحِیمِ وَاسْتَنْصِرُوا عَلَی عَدُوِّکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 30407","","","كتاب الدعاء"
"30408","(۳۰۴۰۸) حَدَّثَنَا حَفْصٌ ، عَن حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : مَا بَاحَ لَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلا أَبُو بَکْرٍ ، وَلا عُمَرُ فِی الصَّلاۃِ عَلَی الْمَیِّتِ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 30408","","","كتاب الدعاء"
"30409","(۳۰۴۰۹) حَدَّثَنَا حَفْصٌ ، عَن حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَن ثَلاثِینَ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُمْ لَمْ یُقِیمُوا فِی أَمْرِ الصَّلاۃِ عَلَی الْجِنَازَۃِ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 30409","","","كتاب الدعاء"
"30410","(۳۰۴۱۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ لَیْسَ فِی الصَّلاۃِ عَلَی الْمَیِّتِ دُعَائٌ مُؤقَّتٌ۔","","Musannaf Ibn Abi Shaybah 30410","","","كتاب الدعاء"
"30411","(۳۰۴۱۱) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَن دَاوُد ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ وَالشَّعْبِیِّ ، قَالا : لَیْسَ عَلَی الْمَیِّتِ دُعَائٌ مُوَقَّتٌ۔","","Musannaf Ibn Abi Shaybah 30411","","","كتاب الدعاء"
"30412","(۳۰۴۱۲) حَدَّثَنَا غُنْدَرٌ ، عَن عِمْرَانَ بْنِ حُدَیْرٍ ، قَالَ : سَأَلْتُ مُحَمَّدًا ، عَنِ الصَّلاۃِ عَلَی الْمَیِّتِ فَقَالَ : مَا نَعْلَمُ لَہُ شَیْئًا یُؤقَّت ادْعُ بِأَحْسَنِ مَا تَعْلَمُ۔","","Musannaf Ibn Abi Shaybah 30412","","","كتاب الدعاء"
"30413","(۳۰۴۱۳) حَدَّثَنَا مُعْتَمِرٌ، عَنْ إِسْحَاقَ بْنِ سُوَیْد، عَن بَکْرِ بْنِ عَبْدِاللہِ، قَالَ: لَیْسَ فِی الصَّلاۃِ عَلَی الْمَیِّتِ شَیْئٌ یُؤقَّتٌ۔","","Musannaf Ibn Abi Shaybah 30413","","","كتاب الدعاء"
"30414","(۳۰۴۱۴) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَن مُوسَی الْجُہَنِیِّ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ وَالْحَکَمَ ، وَعَطَائً وَمُجَاہِدًا فِی الصَّلاۃِ عَلَی الْمَیِّتِ شَیْئٌ مُؤقَّتٌ ؟ قَالُوا : لاَ ، إنَّمَا أَنْتَ شَفِیعٌ فَاشْفَعْ بِأَحْسَنِ مَا تَعْلَمُ۔","","Musannaf Ibn Abi Shaybah 30414","","","كتاب الدعاء"
"30415","(۳۰۴۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَن مُغِیثِ بْنِ سُمَیٍّ ، قَالَ : کَانَ رَجُلٌ مِمَّنْ کَانَ قَبْلَکُمْ یَعْمَلُ بالْمَعَاصِیَ فَادَّکَرَ یَوْمًا فَقَالَ : اللَّہُمَّ غُفْرَانَک غُفْرَانَک ، فَغَفَرَ لَہُ۔","","Musannaf Ibn Abi Shaybah 30415","","","كتاب الدعاء"
"30416","(۳۰۴۱۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن حَجَّاجٍ ، عَنْ إبْرَاہِیمَ السَّکْسَکِیِّ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : جَائَ أَعْرَابِیٌّ إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : یَا رَسُولَ اللہِ ، عَلِّمْنِی شَیْئًا یُجْزِینِی مِنَ الْقُرْآنِ فَإِنِّی لاَ أُحْسِنُ شَیْئًا مِنَ الْقُرْآنِ ، فَقَالَ لَہُ رَسُولُ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قُلْ سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ ، وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ ، فَعَدَّہَا الأَعْرَابِیُّ فِی یَدِہِ خَمْسًا ، ثُمَّ وَلَّی ہُنَیْہَۃً ، ثُمَّ رَجَعَ فَقَالَ : یَا رَسُولَ اللہِ، ہَذَا لِرَبِّی فَمَا لِی ؟ قَالَ : قُلِ : اللَّہُمَّ اغْفِرْ لِی وَارْحَمْنِی وارزقنی وَعَافَنِی وَاہْدِنِی ، فَعَدَّہَا الأَعْرَابِیُّ فِی یَدِہِ خَمْسًا ، ثُمَّ انْطَلَقَ فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَقَدْ مَلأَ الأَعْرَابِیُّ یَدَیْہِ مِنَ الْخَیْرِ إِنْ ہُوَ وَفَّی بِمَا قَالَ۔","Sahih","Musannaf Ibn Abi Shaybah 30416","","","كتاب الدعاء"
"30417","(۳۰۴۱۷) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَن عبد العزیز بن رُفَیْعٍ ، عَنْ أَبِی صَالِحٍ ، قَالَ : لُدِغَ رَجُلٌ مِنَ الأَنْصَارِ، فَلَمَّا أَصْبَحَ أَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ یَا رَسُولَ اللہِ ، مَا زِلْت الْبَارِحَۃَ سَاہِرًا مِنْ لَدْغَۃِ عَقْرَبٍ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَمَا إنَّک لَوْ قُلْتَ حِینَ أَمْسَیْت أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّۃِ مِنْ شَرِّ مَا خَلَقَ مَا ضَرَّک عَقْرَبٌ حَتَّی تُصْبِحَ ، قَالَ أَبُو صَالِحٍ : فَعَلَّمْتہَا ابْنَتِی وَابْنِی فَلَدَغَتْہُمَا فَلَمْ یَضُرَّہُمَا بِشَیْئٍ۔ (نسائی ۱۰۴۳۳)","","Musannaf Ibn Abi Shaybah 30417","","","كتاب الدعاء"
"30418","(۳۰۴۱۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامُ بْنُ حَسَّانَ ، عَن سُہَیْلِ بْنِ أَبِی صَالِحٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَالَ حِینَ یُمْسِی ثَلاثَ مَرَّاتٍ أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّۃِ مِنْ شَرِّ مَا خَلَقَ لَمْ یَضُرَّہُ لَسْعَۃٌ تِلْکَ اللَّیْلَۃَ ، قَالَ سُہَیْلٌ : فَکَانَ أَہْلُہُ قَدِ اعْتَادُوا أَنْ یَقُولُوہَا فَلُسِعَتِ امْرَأَۃٌ فَلَمْ تَجِدْ لَہَا وَجَعًا۔ (ترمذی ۳۶۰۰۔ احمد ۲۹۰)","Sahih","Musannaf Ibn Abi Shaybah 30418","","","كتاب الدعاء"
"30419","(۳۰۴۱۹) حَدَّثَنَا عَبْدُ الرحمن بْنُ سُلَیْمَانَ ، عَن حَجَّاجٍ ، عَنِ الزُّہْرِیِّ ، عَن طَارِقِ بْنِ أَبِی مخَاشِنِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أُتِیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِرَجُلٍ قَدْ لَدَغَتْہُ عَقْرَبٌ ، فَقَالَ : أَمَا إِنَّہُ لَوْ قَالَ أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّۃِ مِنْ شَرِّ مَا خَلَقَ لَمْ یُلْدَغْ ، أَوْ لَمْ یَضُرَّہُ۔","","Musannaf Ibn Abi Shaybah 30419","","","كتاب الدعاء"
"30420","(۳۰۴۲۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن مُطَرِّفٍ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو عَن مُحَمَّدِ بْنِ عَلِیٍّ ، عَنْ عَلِیٍّ ، قَالَ : بَیْنَمَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ لَیْلَۃٍ یُصَلِّی فَوَضَعَ یَدَہُ عَلَی الأَرْضِ فَلَدَغَتْہُ عَقْرَبٌ فَتَنَاوَلَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَعْلِہِ فَقَتَلَہَا ، فَلَمَّا انْصَرَفَ ، قَالَ : أَخْزَی اللَّہُ الْعَقْرَبَ ، مَا تَدَعُ مُصَلِّیًا ، وَلا غَیْرَہُ ، أَوْ مُؤْمِنًا ، وَلا غَیْرَہُ ، ثُمَّ دَعَا بِمِلْحٍ وَمَائٍ فَجَعَلَہُ فِی إنَائٍ وَجَعَلَ یَصُبُّہُ عَلَی إصْبَعِہِ حَیْثُ لَدَغَتْہُ وَیَمْسَحُہَا وَیُعَوِّذُہَا بِالْمُعَوِّذَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 30420","","","كتاب الدعاء"
"30421","(۳۰۴۲۱) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَنِ الْقَعْقَاعِ، عَنْ إبْرَاہِیمَ، قَالَ: رُقْیَۃُ الْعَقْرَبِ شَجَّۃُ قَرْنِیَّۃٍ مَلِحَۃٍ بحر قفطا۔","","Musannaf Ibn Abi Shaybah 30421","","","كتاب الدعاء"
"30422","(۳۰۴۲۲) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ الْمُغِیرَۃِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : عَرَضْتہَا عَلَی عَائِشَۃَ فَقَالَتْ : ہَذِہِ مَوَاثِیقُ۔","Sahih","Musannaf Ibn Abi Shaybah 30422","","","كتاب الدعاء"
"30423","(۳۰۴۲۳) حَدَّثَنَا مُعَاوِیَۃ بْن ہِشَامٍ، قَالَ: حدَّثَنَا سُفْیَانُ، عَن قُدَامَۃَ بْنِ حَمَاطَۃَ ، عَن زِیَادِ بْنِ حُدَیْرٍ، قَالَ: سَمِعْتُ الْعَلائَ بْنَ الْحَضْرَمِیِّ یُحَدِّثُ خَالَہُ ، أَنَّہُ کَانَ مِنْ دُعَائِہِ حِینَ خَاضَ الْبَحْرَ : اللَّہُمَّ یَا حَلِیمُ یَا عَلِیُّ یَا عَظِیمُ۔","Hasan","Musannaf Ibn Abi Shaybah 30423","","","كتاب الدعاء"
"30424","(۳۰۴۲۴) حَدَّثَنَا قُتَیْبَۃُ بْنُ سَعِیدٍ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ جَعْفَرِ بْنِ رَبِیعَۃَ ، عَنِ الأَعْرَجِ، عَنْ أَبِی ہُرَیْرَۃَ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا سَمِعْتُمَ الدِّیکَۃ فَسَلُوا اللَّہَ مِنْ فَضْلِہِ فَإِنَّہَا رَأَتْ مَلَکًا ، وَإِذَا سَمِعْتُمْ نَہِیقَ الْحِمَارِ فَتَعَوَّذُوا بِاللہِ مِنَ الشَّیْطَانِ الرَّجِیمِ فَإِنَّہَا رَأَتْ شَیْطَانًا۔ (بخاری ۳۳۰۳۔ مسلم ۲۰۹۲)","Sahih","Musannaf Ibn Abi Shaybah 30424","","","كتاب الدعاء"
"30425","(۳۰۴۲۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَن مُحَمَّدِ بْنِ إبْرَاہِیمَ بْنِ الْحَارِثِ ، عَنْ عَطَائِ بْنِ یَسَارٍ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، یقول : إذَا سَمِعْتُمْ نُبَاحَ الْکِلابِ، أَوْ نُہَاقَ الْحِمَارِ مِنَ اللَّیْلِ فَتَعَوَّذُوا بِاللہِ فَإِنَّہُنَّ یَرَیْنَ مَا لاَ تَرَوْنَ۔ (بخاری ۱۲۳۴۔ احمد ۳۰۶)","Hasan","Musannaf Ibn Abi Shaybah 30425","","","كتاب الدعاء"
"30426","(۳۰۴۲۶) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَن طَلْحَۃَ بْنِ عَمْرٍو ، عَنْ عَطَائٍ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ إذَا سَمِعَ نُہَاقَ الْحِمَارِ ، قَالَ : بسم اللہ الرَّحْمَن الرحیم أَعُوذُ بِاللہِ السَّمِیعِ الْعَلِیمِ مِنَ الشَّیْطَانِ الرَّجِیمِ۔","Da'if","Musannaf Ibn Abi Shaybah 30426","","","كتاب الدعاء"
"30427","(۳۰۴۲۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن یُونُسَ بْنِ عَمْرٍو ، عَن برید بْنِ أَبِی مَرْیَمَ ، عْن أَنَسِ بْنِ مَالِکٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا مِنْ عَبْدٍ یَسْأَلُ اللَّہَ الْجَنَّۃَ ثَلاثَ مَرَّاتٍ ، إِلاَّ قَالَتِ الجنۃ : اللَّہُمَّ أدخلہ الجنۃ ، وما من عبد یستعیذوا باللہ من النار ثَلاثَ مَرَّاتٍ إلا قالت النار اللہم أجرہ مِنِّی۔ (ترمذی ۲۵۷۲۔ ابن حبان ۱۰۱۴)","Hasan","Musannaf Ibn Abi Shaybah 30427","","","كتاب الدعاء"
"30428","(۳۰۴۲۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَن مِسْعَرٍ ، عَنْ عَبْدِ الأَعْلَی التَّیْمِیِّ ، قَالَ : الْجَنَّۃُ وَالنَّارُ لَقِنَتَا السَّمْعَ مِنْ بَنِی آدَمَ ، فَإِذَا سَأَلَ الرَّجُلُ الْجَنَّۃَ قَالَتِ الْجَنَّۃُ : اللَّہُمَّ أَدْخِلْہُ فِیَّ ، وَإِذَا اسْتَعَاذَ مِنَ النَّارِ قَالَتْ : اللَّہُمَّ أَعِذْہُ مِنِّی۔","","Musannaf Ibn Abi Shaybah 30428","","","كتاب الدعاء"
"30429","(۳۰۴۲۹) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عَامِرِ بْنِ شَقِیقٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : مَا شَہِدَ عَبْدُ اللہِ مَجْمَعًا ، وَلا مَأْدُبَۃً فَیَقُومُ حَتَّی یَحْمَدَ اللَّہَ وَیُصَلِّیَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَإِنْ کَانَ مِمَّا یتبع أَغْفَلَ مَکَان فِی السُّوقِ فَیَجْلِسُ فِیہِ فَیَحْمَدُ اللَّہَ وَیُصَلِّی عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Hasan","Musannaf Ibn Abi Shaybah 30429","","","كتاب الدعاء"
"30430","(۳۰۴۳۰) حَدَّثَنَا طَلْقُ بْنُ غَنَّامٍ ، قَالَ : حدَّثَنَا شَیْبَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَن حبَّۃ الْعُرَنِی ، عَنْ عَلِیٍّ ، قَالَ : مَنْ قَالَ عِنْدَ کُلِّ عَطْسَۃٍ یَسْمَعُہَا الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ عَلَی کُلِّ حَالٍ مَا کَانَ لَمْ یَجِدْ وَجَعَ ضِرْسٍ ، وَلا أُذُنٍ أَبَدًا۔","Da'if","Musannaf Ibn Abi Shaybah 30430","","","كتاب الدعاء"
"30431","(۳۰۴۳۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، قَالَ : أَبْطَأَ عَلَی عُمَرَ خَبَرُ نَہَاوَنْدَ وَخَبَرُ النُّعْمَانِ بْنِ مُقَرِّنٍ فَجَعَلَ یَسْتَنْصِرُ۔","Hasan","Musannaf Ibn Abi Shaybah 30431","","","كتاب الدعاء"
"30432","(۳۰۴۳۲) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَن حَجَّاجِ بْنِ دِینَارٍ ، عَنِ الْحَکَمِ بْنِ جَحْلٍ ، عَن رَجُلٍ حَدَّثَہُ عَنْ عَلِیٍّ ، أَنَّہُ قَالَ : مَنْ قَرَأَ بَعْدَ الْفَجْرِ {قُلْ ہُوَ اللَّہُ أَحَدٌ} عَشْرَ مَرَّاتٍ لَمْ یَلْحَقْ بِہِ ذَلِکَ الْیَوْمَ ذَنْبٌ ، وَإِنْ جَہَدَتہ الشَّیَاطِینُ۔","Da'if","Musannaf Ibn Abi Shaybah 30432","","","كتاب الدعاء"
"30433","(۳۰۴۳۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن لَیْثٍ ، عَن ہِلالٍ ، قَالَ : مَنْ قَرَأَ {قُلْ ہُوَ اللَّہُ أَحَدٌ} عَشْرَ مَرَّاتٍ بُنِیَ لَہُ بُرْجٌ فِی الْجَنَّۃِ۔","","Musannaf Ibn Abi Shaybah 30433","","","كتاب الدعاء"
"30434","(۳۰۴۳۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن سَعِیدِ بْنِ سَعِیدٍ ، قَالَ : لَحِقَنِی نَافِعُ بْنُ جُبَیْرٍ حِینَ انْصَرَفْت مِنَ الْمَغْرِبِ ، فَقُلْتُ : مَا شَأْنُکَ ؟ فَقَالَ : إذَا مَرَرْت عَلَی قَبْرِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقُلْ : السَّلامُ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَرَحْمَۃُ اللہِ ، فَإِنَّ الشَّیْطَانَ یَقُولُ : لاَ صُحْبَۃَ ، فَإِذَا دَخَلْتُ عَلَی أَہْلِکَ فَقُلْ : السَّلامُ عَلَیْکُمْ ، فَإِنَّ الشَّیْطَانَ یَقُولُ : لاَ مَبِیتَ ، فَإِذَا أُتِیتَ بِعَشَائِکَ فَقُلْ : بِسْمِ اللہِ ، فَإِنَّ الشَّیْطَانَ یُوَلِّی خَاسِئًا یَقُولُ لأَصْحَابِہِ : لاَ مَبِیتَ ، وَلا عَشَائَ۔","","Musannaf Ibn Abi Shaybah 30434","","","كتاب الدعاء"
"30435","(۳۰۴۳۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن لَیْثٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یَنَامُ حَتَّی یَقْرَأَ : {الم تَنْزِیلُ} وَ {تَبَارَکَ الَّذِی بِیَدِہِ الْمُلْکُ}۔ (بخاری ۱۲۰۹۔ دارمی ۳۴۱۱)","Da'if","Musannaf Ibn Abi Shaybah 30435","","","كتاب الدعاء"
"30436","(۳۰۴۳۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن لَیْثٍ ، عَن طَاوُوس ، قَالَ : فُضِّلَتْ : {الم تَنْزِیلُ} وَ{تَبَارَکَ الَّذِی بِیَدِہِ الْمُلْکُ} عَلَی سَائِرِ الْقُرْآنِ بِسِتِّینَ حَسَنَۃً۔ (ترمذی ۲۸۹۲۔ دارمی ۳۴۱۲)","","Musannaf Ibn Abi Shaybah 30436","","","كتاب الدعاء"
"30437","(۳۰۴۳۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن ہِشَامٍ ، عَنْ أَبِی یُونُسَ ، عَن طَاوُوس ، قَالَ : مَنْ قَرَأَ فی لیلۃ : {الم تَنْزِیلُ السَّجْدَۃَ} وَ {تَبَارَکَ الَّذِی بِیَدِہِ الْمُلْکُ} کَانَ مِثْلُ أَجْرِ لَیْلَۃِ الْقَدْرِ ، قَالَ : فَمَرَّ عَطَائٌ فَقُلْنَا لِرَجُلٍ مِنَّا : ائْتِہِ فَسَلْہُ ، فَقَالَ : صَدَقَ ، مَا تَرَکْتہمَا مُنْذُ سَمِعْتہمَا۔","","Musannaf Ibn Abi Shaybah 30437","","","كتاب الدعاء"
"30438","(۳۰۴۳۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ إِسْحَاقَ عَنْ أَبَانَ بْنِ صَالِحٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا نَفَرَتْ دَابَّۃُ أَحَدِکُمْ ، أَوْ بَعِیرُہُ بِفَلاۃٍ مِنَ الأَرْضِ لاَ یَرَی بِہَا أَحَدًا فَلْیَقُلْ : أَعِینُوا عِبَادَ اللہِ ، فَإِنَّہُ سَیُعَانُ۔ (ابویعلی ۵۲۴۷)","","Musannaf Ibn Abi Shaybah 30438","","","كتاب الدعاء"
"30439","(۳۰۴۳۹) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَن مِسْعَرٍ ، عَن ذَکْوَانَ ، عَنْ أَبِی ہُرَیْرَۃً ، قَالَ : دَعْوَۃُ الْمُسْلِمِ مُسْتَجَابَۃٌ مَا لَمْ یَدْعُ بِظُلْمٍ ، أَوْ قَطِیعَۃِ رَحِمٍ ، أَوْ یَقُلْ : قَدْ دَعَوْت فَلَمْ أُجَبْ۔","Sahih","Musannaf Ibn Abi Shaybah 30439","","","كتاب الدعاء"
"30440","(۳۰۴۴۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَن سُفْیَانَ ، عَنْ عَاصِمٍ ، عَن عُبَیْدٍ مَوْلَی أَبِی رُہْمٍ ، قَالَ : مَرَرْت مَعَ أَبِی ہُرَیْرَۃَ عَلَی نَخْلٍ فَقَالَ : اللَّہُمَّ أَطْعِمْنَا مِنْ تَمْرٍ لاَ یَأْبرُہُ بَنُو آدم۔","Da'if","Musannaf Ibn Abi Shaybah 30440","","","كتاب الدعاء"
"30441","(۳۰۴۴۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن مَنْصُورٍ ، عَن مُجَاہِدٍ ، قَالَ : کَانَ یُقَالُ : إذَا خَرَجَ الرَّجُلُ مِنَ الْمَسْجِدِ فَلْیَقُلْ : بِسْمِ اللہِ تَوَکَّلْت عَلَی اللہِ اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ شَرِّ مَا خَرَجْت لَہُ۔","","Musannaf Ibn Abi Shaybah 30441","","","كتاب الدعاء"
"30442","(۳۰۴۴۲) حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ ، قَالَ : حدَّثَنِی عزرۃ بْنُ قَیْسٍ صَاحِبُ الطَّعَامِ ، قَالَ : حَدَّثَتْنِی أُمُّ الفیض ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ قَالَ ہَؤُلائِ الْکَلِمَاتِ لَیْلَۃَ عَرَفَۃَ أَلْفَ مَرَّۃٍ، لَمْ یَسْأَلَ اللَّہَ شَیْئًا إِلاَّ أَعْطَاہُ إیَّاہُ ، لَیْسَ فِیہِ إِثْمَ ، وَلا قَطِیعَۃُ رَحِمٍ ، سُبْحَانَ اللہِ الَّذِی فِی السَّمَائِ عَرْشُہُ ، سُبْحَانَ اللہِ الَّذِی فِی الأَرْضِ مَوْطِئُہُ ، سُبْحَانَ اللہ الَّذِی فِی الْبَحْرِ سَبِیلُہُ ، سُبْحَانَ اللہ الَّذِی فِی الْجَنَّۃِ رَحْمَتُہُ ، سُبْحَانَ اللہ الَّذِی فِی النَّارِ سُلْطَانُہُ ، سُبْحَانَ اللہ الَّذِی فِی الْہَوَائِ رَحْمَتُہُ ، سُبْحَانَ اللہ الَّذِی فِی الْقُبُورِ قَضَاؤُہُ ، سُبْحَانَ اللہ الَّذِی رَفَعَ السَّمَائَ ، سُبْحَانَ اللہ الَّذِی وَضَعَ الأَرْضَ ، سُبْحَانَ اللہِ الَّذِی لاَ مَنْجَی مِنْہُ إِلاَّ إلَیْہِ۔ (ابویعلی ۳۵۶۴۔ طبرانی ۴۱۲)","Da'if","Musannaf Ibn Abi Shaybah 30442","","","كتاب الدعاء"
"30443","(۳۰۴۴۳) حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ ، عَنْ عَبْدِ الْوَاحِدِ بْن زِیَادٍ ، قَالَ : حدَّثَنِی عَبْدُ الرَّحْمَانِ بْنُ زِیَادٍ ، قَالَ : حَدَّثَنِی شَیْخٌ مِنْ قُرَیْشٍ ، عَنِ ابْنِ عُکَیم ، قَالَ : قَالَ لِی عُمَرُ بْنُ الْخَطَّابِ : قَالَ لَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا ابْنَ الْخَطَّابِ ، قُلِ : اللَّہُمَّ اجْعَلْ سَرِیرَتِی خَیْرًا مِنْ عَلانِیَتِی ، وَاجْعَلْ عَلانِیَتِی صَالِحَۃً۔n(ترمذی ۳۵۸۶)","Da'if","Musannaf Ibn Abi Shaybah 30443","","","كتاب الدعاء"
"30444","(۳۰۴۴۴) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ مِنْ دُعَائِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اللَّہُمَّ أَعِنِّی عَلَی ذِکْرِکَ وَشُکْرِکَ وَحُسْنِ عِبَادَتِک۔ (ابوداؤد ۱۵۱۷۔ احمد ۲۴۷)","","Musannaf Ibn Abi Shaybah 30444","","","كتاب الدعاء"
"30445","(۳۰۴۴۵) حَدَّثَ[corrupt]َا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا سَلِمَۃُ بْنُ وَرْدَانَ ، قَالَ : سَمِعْتُ أَنَسًا ، قَالَ : أَتَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ امْرَأَۃٌ تَشْکُو إلَیْہِ الْحَاجَۃَ فَقَالَ : أَدُلُّک عَلَی خَیْرٍ مِنْ ذَلِکَ ، تُہَلِّلِینَ اللَّہَ ثَلاثًا وَثَلاثِینَ عِنْدَ مَنَامِکَ وَتُسَبِّحِینَہُ ثَلاثًا وَثَلاثِینَ ، وَتَحْمَدِینَہُ أَرْبَعًا وَثَلاثِینَ ، قَالَ : تِلْکَ مِئَۃ مَرَّۃٍ خَیْرٌ مِنَ الدُّنْیَا ، وَمَا فِیہَا۔n (بخاری ۶۳۵)","Da'if","Musannaf Ibn Abi Shaybah 30445","","","كتاب الدعاء"
"30446","(۳۰۴۴۶) حَدَّثَنَا مُصْعَبُ بْنُ الْمِقْدَامِ ، قَالَ : حدَّثَنِی إسْرَائِیلُ ، عَنْ أَبِی سِنَانٍ ضِرَارِ بْنِ مُرَّۃَ ، عَنْ أَبِی صَالِحٍ الْحَنَفِیِّ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، وَأَبِی ہُرَیْرَہُ ، قَالا : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ اصْطَفَی مِنَ الْکَلامِ أَرْبَعًا : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ ، ثُمَّ قَالَ : مَنْ قَالَ سُبْحَانَ اللہِ ، کُتِبَ لَہُ عِشْرُونَ حَسَنَۃً ، وَحُطَّ عَنْہُ عِشْرُونَ سَیِّئَۃً ، وَمَنْ قَالَ : اللَّہُ أَکْبَرُ فَمِثْلُ ذَلِکَ ، وَمَنْ قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ فَمِثْلُ ذَلِکَ ، وَمَنْ قَالَ الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ مِنْ قِبَلِ نَفْسِہِ کُتِبَتْ لَہُ ثَلاثُونَ حَسَنَۃً وَحُطَّ عَنْہُ ثَلاثُونَ سَیِّئَۃً۔ (عبدالرزاق ۳۱۰)","Hasan","Musannaf Ibn Abi Shaybah 30446","","","كتاب الدعاء"
"30447","(۳۰۴۴۷) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، قَالَ : أَخْبَرَنَا ہِشَامُ بْنُ الْغَازِ ، عَن مَکْحُولٍ ، قَالَ : مَنْ قَالَ لاَ حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ ، وَلا مَلْجَأَ مِنَ اللہِ إِلاَّ إلَیْہِ ، دَفَعَ اللَّہُ عَنْہُ سَبْعِینَ بَابًا مِنَ الضُّرِّ أَدْنَاہَا الْفَقْرُ۔","","Musannaf Ibn Abi Shaybah 30447","","","كتاب الدعاء"
"30448","(۳۰۴۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، قَالَ : حَدَّثَنَا شَرِیکُ بْنُ عَبْدِ اللہِ بْنِ أَبِی نَمِرٍ ، قَالَ : دَخَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَسْجِدَ ، وَرَجُلٌ یَقُولُ : اللَّہُمَّ لاَ إلَہَ إِلاَّ أَنْتَ ، وَعْدُک حَقٌّ ، وَلِقَاؤُک حَقٌّ ، وَالْجَنَّۃُ حَقٌّ ، وَالنَّارُ حَقٌّ ، وَالنَّبِیُّونَ حَقٌّ ، وَمُحَمَّدٌ حَقٌّ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سَلْ تُعْطَہُ۔ (طبرانی ۸۴۱۹)","","Musannaf Ibn Abi Shaybah 30448","","","كتاب الدعاء"
"30449","(۳۰۴۴۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ بَکْرٍ السَّہْمِیُّ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیّ ، عَن یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی جَعْفَرٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ثَلاثُ دَعَوَاتٍ مُسْتَجَاباتٌ لَہُنَّ لاَ شَکَّ فِیہِنَّ : دَعْوَۃُ الْمَظْلُومِ ، وَدَعْوَۃُ الْمُسَافِرِ ، وَدَعْوَۃُ الْوَالِدِ عَلَی وَلَدِہِ۔ (احمد ۲۵۸۔ ابوداؤد ۱۵۳۱)","Da'if","Musannaf Ibn Abi Shaybah 30449","","","كتاب الدعاء"
"30450","(۳۰۴۵۰) حَدَّثَنَا جَرِیرٌ ، عَن مُغِیرَۃَ ، عَنِ الأَسْلَعِ بْنِ حَیٍّ ، قَالَ : کُنْتُ بِالْمَدِینَۃِ أَطْلُبُ دَمًا لِی ، فَقُلْتُ لأَبِی ہُرَیْرَۃَ ادْعُ اللَّہَ أَنْ یَنْصُرَنِی ، فَقَالَ : اللَّہُمَّ إِنْ کَانَ مَظْلُومًا فَانْصُرْہُ ، وَإِنْ کَانَ ظَالِمًا فَانْصُرْ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30450","","","كتاب الدعاء"
"30451","(۳۰۴۵۱) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : جَائَ رَجُلٌ یَہُودِیٌّ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : ادْعُ اللہ لِی ، فَقَالَ : أَکْثَرَ اللَّہُ مَالَک وَوَلَدَک وَأَصَحَّ جِسْمَک وَأَطَالَ عُمْرَک۔","","Musannaf Ibn Abi Shaybah 30451","","","كتاب الدعاء"
"30452","(۳۰۴۵۲) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَقُولَ لِلْیَہُودِیِّ وَالنَّصْرَانِیِّ : ہَدَاکَ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 30452","","","كتاب الدعاء"
"30453","(۳۰۴۵۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَن مَعْمَرٍ ، عَن قَتَادَۃَ ، أَنَّ یَہُودِیًّا حَلَبَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَاقَۃً فَقَالَ : اللَّہُمَّ جَمِّلْہُ ، فَاسْوَدَّ شَعْرُہُ۔","","Musannaf Ibn Abi Shaybah 30453","","","كتاب الدعاء"
"30454","(۳۰۴۵۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَن حَسَّانَ بْنِ عَطِیَّۃَ ، قَالَ : لاَ بَأْسَ أَنْ یُؤَمِّنَ الْمُسْلِمُ عَلَی دُعَائِ الرَّاہِبِ ، فَقَالَ : إنَّہُمْ یُسْتَجَابُ لَہُمْ فِینَا ، وَلا یُسْتَجَابُ لَہُمْ فِی أَنْفُسِہِمْ۔","","Musannaf Ibn Abi Shaybah 30454","","","كتاب الدعاء"
"30455","(۳۰۴۵۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَن سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّہُ کَانَ یَقُومُ عَلَی الْمَنْفُوسِ مِنْ وَلَدِہِ الَّذِی لَمْ یَعْمَلْ خَطِیئَۃً فَیَقُولُ : اللَّہُمَّ أَجِرْہُ مِنْ عَذَابِ النَّارِ۔","Sahih","Musannaf Ibn Abi Shaybah 30455","","","كتاب الدعاء"
"30456","(۳۰۴۵۶) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَن یُونُسَ ، عَن زِیَادِ بْنِ جُبَیْرٍ ، عَنْ أَبِیہِ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، قَالَ : السِّقْطُ یدعی لِوَالِدَیْہِ بِالْعَافِیَۃِ وَالْمَغْفِرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 30456","","","كتاب الدعاء"
"30457","(۳۰۴۵۷) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَن سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ : اللَّہُمَّ اجْعَلْہُ لَنَا فَرَطًا وَذُخْرًا وَأَجْرًا۔","","Musannaf Ibn Abi Shaybah 30457","","","كتاب الدعاء"
"30458","(۳۰۴۵۸) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، قَالَ : حدَّثَنَا الْجُلاَسُ السُّلَمِیُّ ، قَالَ : سَمِعْتُ عَلِیَّ بْنَ جِحَاشٍ ، قَالَ سَمِعْت سَمُرَۃَ بْنَ جُنْدَبٍ وَمَاتَ ابْنٌ لَہُ صَغِیرٌ فَقَالَ : اذْہَبُوا فَادْفِنُوہُ ، وَلا تُصَلُّوا عَلَیْہِ فَإِنَّہُ لَیْسَ عَلَیْہِ إِثْم، وَادْعُوا اللَّہَ لِوَالِدَیْہِ أَنْ یَجْعَلَہُ لَہُمَا فَرَطًا وَأَجْرًا ، أَوْ نَحْوَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30458","","","كتاب الدعاء"
"30459","(۳۰۴۵۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حُسَیْن عَنْ أَبِی بِشْرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : تَسْبِیحَۃٌ فِی رَمَضَانَ أَفْضَلُ مِنْ أَلْفٍ فِی غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 30459","","","كتاب الدعاء"
"30460","(۳۰۴۶۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا وَضَعَ الْمَیِّتَ فِی الْقَبْرِ ، قَالَ : بِسْمِ اللہِ وَبِاللہِ وَعَلَی سُنَّۃِ رَسُولِ اللہِ۔","","Musannaf Ibn Abi Shaybah 30460","","","كتاب الدعاء"
"30461","(۳۰۴۶۱) حَدَّثَنَا وَکِیعٌ ، عَن ہَمَّامٍ ، عَن قَتَادَۃَ ، عَنْ أَبِی الصِّدِّیقِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا وَضَعْتُمْ مَوْتَاکُمْ فِی قُبُورِہِمْ ، فَقُولُوا : بِسْمِ اللہِ ، وَعَلَی سُنَّۃِ رَسُولِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30461","","","كتاب الدعاء"
"30462","(۳۰۴۶۲) حَدَّثَنَا وَکِیعٌ ، عَن شُعْبَۃُ ، عَن قَتَادَۃَ ، عَنْ أَبِی الصِّدِّیقِ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ مِثْلَ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 30462","","","كتاب الدعاء"
"30463","(۳۰۴۶۳) حَدَّثَنَا شَرِیکٌ ، وَأَبُو الأَحْوَصِ ، عَن مَنْصُورٍ ، عن أَبِی مُدْرِکٍ ، عَنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ إذَا أَدْخَلَ الْمَیِّتَ قَبْرَہُ ، وَقَالَ أَبُو الأَحْوَصِِ : إذَا سَوَّوْا عَلَیْہِ : اللَّہُمَّ أَسْلَمَہُ إلَیْک الْمَالُ وَالأَہْلُ وَالْعَشِیرَۃُ وَالذَّنْبُ الْعَظِیمُ فَاغْفِرْ لَہُ۔","","Musannaf Ibn Abi Shaybah 30463","","","كتاب الدعاء"
"30464","(۳۰۴۶۴) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَن سُفْیَانَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَن خَیْثَمَۃَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ إذَا وُضِعَ الْمَیِّتُ فِی الْقَبْرِ أَنْ یَقُولُوا : بِسْمِ اللہِ وَفِی سَبِیلِ اللہِ وَعَلَی مِلَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اللَّہُمَّ أَجِرْہُ مِنْ عَذَابِ الْقَبْرِ وَعَذَابِ النَّارِ وَشَرِّ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 30464","","","كتاب الدعاء"
"30465","(۳۰۴۶۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ ، أَنَّہُ کَانَ یَقُولُ : بِسْمِ اللہِ وَفِی سَبِیلِ اللہِ وَعَلَی مِلَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اللَّہُمَّ افْسَحْ لَہُ فِی قَبْرِہِ وَنَوِّرْ لَہُ فِیہِ ، وَأَلْحِقْہُ بِنَبِیِّہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنْتَ عَنْہُ رَاضٍ غَیْرُ غَضْبَانَ۔","","Musannaf Ibn Abi Shaybah 30465","","","كتاب الدعاء"
"30466","(۳۰۴۶۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الْعَلائِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ ، قَالَ : إذَا وَضْعت الْمَیِّتُ فِی قَبْرِہِ فَلا تَقُلْ : بِسْمِ اللہِ ، وَلَکِنْ قُلْ : فِی سَبِیلِ اللہِ ، وَعَلَی مِلَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَعَلَی مِلَّۃِ إبْرَاہِیمَ حَنِیفًا مسلما ، وَمَا کَانَ مِنَ الْمُشْرِکِینَ ، اللَّہُمَّ ثَبِّتْہُ بِالْقَوْلِ الثَّابِتِ فِی الآخِرَۃِ ، اللَّہُمَّ اجْعَلْہُ فِی خَیْرٍ مِمَّا کَانَ فِیہِ ، اللَّہُمَّ لاَ تَحْرِمْنَا أَجْرَہُ ، وَلا تَفْتِنَّا بَعْدَہُ ، قَالَ : وَنَزَلَتْ ہَذِہِ الآیَۃُ فِی صَاحِبِ الْقَبْرِ : {یُثَبِّتُ اللَّہُ الَّذِینَ آمَنُوا بِالْقَوْلِ الثَّابِتِ فِی الْحَیَاۃِ الدُّنْیَا وَفِی الآخِرَۃِ}۔","","Musannaf Ibn Abi Shaybah 30466","","","كتاب الدعاء"
"30467","(۳۰۴۶۷) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمٍ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ یَقُولُ عِنْدَ الْمَنَامِ إذَا نَامَ : بِسْمِ اللہِ وَفِی سَبِیلِ اللہِ وَعَلَی مِلَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَیَقُولُہُ إذَا أُدْخِلَ الرَّجُلَ قَبْرَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30467","","","كتاب الدعاء"
"30468","(۳۰۴۶۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا وَضَعْت الْمَیِّتَ فِی الْقَبْرِ فَقُلْ : بِسْمِ اللہِ وَعَلَی سُنَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 30468","","","كتاب الدعاء"
"30469","(۳۰۴۶۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْن سُلَیْمَان عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَن جُبَیْرِ بْنِ عَدِیٍّ ، قَالَ : أُخْبِرْت ، أَنَّ عَلِیَّ بْنَ أَبِی طَالِبٍ کَانَ یَقُولُ إذَا أُدْخِلَ الْمَیِّتَ فِی قَبْرِہِ : بِسْمِ اللہِ ، وَعَلَی مِلَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَتَصْدِیقِ کِتَابِکَ وَرُسُلِکَ وَبالْیَقِینِ بِالْبَعْثِ بَعْدَ الْمَوْتِ ، اللَّہُمَّ ارْحَبْ عَلَیْہِ قَبْرَہُ ، وَبَشِّرْہُ بِالْجَنَّۃِ۔","","Musannaf Ibn Abi Shaybah 30469","","","كتاب الدعاء"
"30470","(۳۰۴۷۰) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَن حُصَیْنٍ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : إذَا وُضِعَ الْمَیِّتُ فِی الْقَبْرِ فَقُلْ : بِسْمِ اللہِ وَإِلَی اللہِ ، وَعَلَی سُنَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 30470","","","كتاب الدعاء"
"30471","(۳۰۴۷۱) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَن عبد اللہِ بْنِ أَبِی بَکْرٍ ، قَالَ : کَانَ أَنَسُ بْنُ مَالِکٍ إذَا سُوِّیَ عَلَی الْمَیِّتِ قَبْرُہُ قَامَ عَلَیْہِ ، ثُمَّ قَالَ : اللَّہُمَّ عَبْدُک رُدَّ عَلَیْک ، فَارْأَفْ بِہِ وَارْحَمْہُ ، اللَّہُمَّ جَافِ الأَرْضَ عَنْ جَنْبَیْہِ وَافْتَحْ أَبْوَابَ السَّمَائِ لِرُوحِہِ ، وَتَقَبَّلْہُ مِنْک بِقَبُولٍ حَسَنٍ ، اللَّہُمَّ إِنْ کَانَ مُحْسِنًا فَضَاعِفْ لَہُ فِی إحْسَانِہِ ، وَإِنْ کَانَ مُسِیئًا فَتَجَاوَزْ عَن سَیِّئَاتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30471","","","كتاب الدعاء"
"30472","(۳۰۴۷۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَن حَجَّاجٍ ، عَن عُمَیْرِ بْنِ سَعِیدٍ ، أَنَّ عَلِیًّا کَبَّرَ عَلَی یَزِیدَ بْنِ مُکَفَّفٍ أَرْبَعًا ، ثُمَّ قَامَ عَلَی الْقَبْرِ فَقَالَ : اللَّہُمَّ عَبْدُک ، وَابْنُ عَبْدِکَ نَزَلَ بِکَ الْیَوْمَ ، وَأَنْتَ خَیْرُ مَنْزُولٍ بِہِ ، اللَّہُمَّ وَسِّعْ لَہُ مُدْخَلَہُ وَاغْفِرْ لَہُ ذَنْبَہُ فَإِنَّا لاَ نَعْلَمُ إِلاَّ خَیْرًا وَأَنْتَ أَعْلَمُ بِہِ۔","","Musannaf Ibn Abi Shaybah 30472","","","كتاب الدعاء"
"30473","(۳۰۴۷۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : لَمَّا فُرِغَ مِنْ قَبْرِ عَبْدِ اللہِ بْنِ السَّائِبِ قَامَ ابْنُ عَبَّاسٍ عَلَی الْقَبْرِ فَوَقَفَ عَلَیْہِ ، ثُمَّ دَعَا ، ثُمَّ انْصَرَفَ۔","","Musannaf Ibn Abi Shaybah 30473","","","كتاب الدعاء"
"30474","(۳۰۴۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، قَالَ : رَأَیْتُ أَیُّوبَ یَقُومُ عَلَی الْقَبْرِ فَیَدْعُو لِلْمَیِّتِ ، وَرُبَّمَا رَأَیْتہ یَدْعُو لَہُ وَہُوَ فِی الْقَبْرِ قَبْلَ أَنْ یَخْرُجَ۔","","Musannaf Ibn Abi Shaybah 30474","","","كتاب الدعاء"
"30475","(۳۰۴۷۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ ، عَن قَیْسٍ ، قَالَ : دَخَلْنَا عَلَی خَبَّابٍ وَقَدِ اکْتَوَی سَبْعَ کَیَّاتٍ فِی بَطْنِہِ فَقَالَ : لَوْلا أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَانَا أَنْ نَدْعُوَ بِالْمَوْتِ لَدَعَوْت بِہِ۔ (بخاری ۵۶۷۲۔ مسلم ۲۰۶۴)","Sahih","Musannaf Ibn Abi Shaybah 30475","","","كتاب الدعاء"
"30476","(۳۰۴۷۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ ابْنِ عُمَرَ قَالَ: فَسَمِعَ رَجُلاً یَتَمَنَّی الْمَوْتَ ، قَالَ : فَرَفَعَ إلَیْہِ ابْنُ عُمَرَ بَصَرَہُ فَقَالَ : لاَ تَمَنَّ الْمَوْتَ فَإِنَّک مَیِّتٌ ، وَلَکِنْ سَلِ اللَّہَ الْعَافِیَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 30476","","","كتاب الدعاء"
"30477","(۳۰۴۷۷) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَن حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَتَمَنَّی أَحَدُکُمُ الْمَوْتَ لِضُرٍّ نَزَلَ بِہِ فِی الدُّنْیَا۔","Sahih","Musannaf Ibn Abi Shaybah 30477","","","كتاب الدعاء"
"30478","(۳۰۴۷۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَن یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَن عُرْوَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : کُنْت إِلَی جَنْبِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَفَقَدْتہ فَابْتَغَیْتُہُ فَإِذَا ہُوَ بِالْبَقِیعِ رَافِعًا یَدَیْہِ یَدْعُو فَقَالَ : یَا بنت أَبِی بَکْرٍ ، أَخَشِیت أَنَّ یَحِیفَ اللَّہُ عَلَیْک وَرَسُولُہُ ، إنَّ اللَّہَ یَنْزِلُ فِی ہَذِہِ اللَّیْلَۃِ ، لَیْلَۃ النِّصْفِ مِنْ شَعْبَانَ ، فَیَغْفِرُ فِیہَا مِنَ الذُّنُوبِ أَکْثَرَ مِنْ عَدَدِ شَعْرِ مَعْزِ کَلْبٍ۔ (ترمذی ۷۳۹۔ احمد ۲۳۸)","","Musannaf Ibn Abi Shaybah 30478","","","كتاب الدعاء"
"30479","(۳۰۴۷۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَن مَکْحُولٍ ، عَن کَثِیرِ بْنِ مُرَّۃَ الْحَضْرَمِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ یَنْزِلُ لَیْلَۃَ النِّصْفِ مِنْ شَعْبَانَ فَیَغْفِرُ فِیہَا الذُّنُوبَ إِلاَّ لِمُشْرِکٍ ، أَوْ مُشَاحِنٍ۔ (عبدالرزاق ۷۹۲۳)","","Musannaf Ibn Abi Shaybah 30479","","","كتاب الدعاء"
"30480","(۳۰۴۸۰) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَن مُوسَی بْنِ عُبَیْدَۃَ، عَنْ أَبِی بَکْرِ بْنِ أَنَسِ بْنِ مَالِکٍ، قَالَ: کَانَ لَہُ مَجُوسٌ یَعْمَلُونَ لَہُ فِی أَرْضِہِ وَکَانَ یَقُولُ لَہُمْ : أَطَالَ اللَّہُ أَعْمَارَکُمْ ، وَأَکْثَرَ أَمْوَالَکُمْ ، فَکَانُوا یَفْرَحُونَ بِذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 30480","","","كتاب الدعاء"
"30481","(۳۰۴۸۱) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ سُوقَۃَ ، عَن نَافِعٍ قَالَ : کَانَ ابْنُ عمَرَ إذَا قَدِمَ حَاجًّا ، أَوْ مُعْتَمِرًا طَافَ بِالْبَیْتِ وَصَلَّی رَکْعَتَیْنِ ، وَکَانَ جُلُوسُہُ فِیہَا أَطْوَلَ مِنْ قِیَامِہِ ثَنَائً عَلَی رَبِّہِ وَمَسْأَلَۃً ، فَکَانَ یَقُولُ حِینَ یَفْرُغُ مِنْ رَکْعَتَیْہِ وَبَیْنَ الصَّفَا وَالْمَرْوَۃِ : اللَّہُمَّ اعْصِمْنِی بِدِینِکَ وَطَاعَتِکَ وَطَاعَۃِ رَسُولِکَ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، اللَّہُمَّ جَنِّبْنِی حُدُودَک، اللَّہُمَّ اجْعَلْنِی مِمَّنْ یُحِبُّک وَیُحِبُّ مَلائِکَتَکَ وَرُسُلَک وَعِبَادَک الصَّالِحِینَ ، اللَّہُمَّ حَبِّبْنِی إلَیْک وَإِلَی مَلائِکَتِکَ وَرُسُلِکَ ، اللَّہُمَّ آتِنِی مِنْ خَیْرِ مَا تُؤْتِی عِبَادَک الصَّالِحِینَ فِی الدُّنْیَا وَالآخِرَۃِ ، اللَّہُمَّ یَسِّرْنِی لِلْیُسْرَی وَجَنِّبْنِی الْعُسْرَی ، وَاغْفِرْ لِی فِی الآخِرَۃِ وَالأُولَی ، اللَّہُمَّ أَوْزِعْنِی أَنْ أَفِیَ بِعَہْدِکَ الَّذِی عَاہَدْتنِی عَلَیْہِ ، اللَّہُمَّ اجْعَلْنِی مِنْ أَئِمَّۃِ الْمُتَّقِینَ ، وَاجْعَلْنِی مِنْ وَرَثَۃِ جَنَّۃِ النَّعِیمِ ، وَاغْفِرْ لِی خَطِیئَتِی یَوْمَ الدِّینِ۔","Sahih","Musannaf Ibn Abi Shaybah 30481","","","كتاب الدعاء"
"30482","(۳۰۴۸۲) حَدَّثَنَا یَعْلَی ، قَالَ : حدَّثَنَا عُثْمَانُ بْنُ حَکِیمٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ أَبِی الشَّعْثَائِ ، قَالَ : إذَا أَتَیْتَ یَوْمَ الْجُمُعَۃِ فَاقْعُدْ عَلَی بَابِ الْمَسْجِدِ وَقُلِ : اللَّہُمَّ اجْعَلْنِی الْیَوْمَ أَوْجَہَ مَنْ تَوَجَّہَ إلَیْک ، وَأَقْرَبَ مَنْ تَقَرَّبَ إلَیْک ، وَأَنْجَحَ مَنْ دَعَا وَطَلَبَ ، ثُمَّ ادْخُلْ وَسَلْ تُعْطَہُ۔","","Musannaf Ibn Abi Shaybah 30482","","","كتاب الدعاء"
"30483","(۳۰۴۸۳) حَدَّثَنَا شُعْبَۃُ ، عَنْ عَاصِمٍ مَوْلَی لقُرَیْبَۃِ بِنْتِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرٍ ، قَالَ : سَمِعْتُ قُرَیْبَۃَ تُحَدِّثُ عَنْ عَائِشَۃَ ، أَنَّہَا قَالَتْ : لاَ تَقُولِی لِلْمِسْکِینِ : بِوَرِکِ فِیہِ ، فَإِنَّہُ یَسْأَلُ الْبَرُّ وَالْفَاجِرُ ، وَلَکِنْ قَوْلِی : یَرْزُقُنَا اللَّہُ وَإِیَّاکَ۔","Da'if","Musannaf Ibn Abi Shaybah 30483","","","كتاب الدعاء"
"30484","(۳۰۴۸۴) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَن صُبَیْحٍ مَوْلَی بَنِی مَرْوَانَ ، عَن مَکْحُولٍ ، قَالَ : سَمِعْتُہُ یَقُولُ فِی الرَّہْصَۃِ : بِسْمِ اللہِ ، أَنْتَ الْوَاقِی وَأَنْتَ الشَّافِی وَأَنْتَ الْبَاقِی ، ثُمَّ یَعْقِدُ فِی خَیْطِ قِنَّبٍ جَدِیدٍ ، أَوْ شَعْرٍ ، ثُمَّ یَرْبِطُ بِہِ الدَّابَّۃَ لِلرَّہْصَۃِ۔","","Musannaf Ibn Abi Shaybah 30484","","","كتاب الدعاء"
"30485","(۳۰۴۸۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن سُفْیَانَ ، عَن مُحَمَّدِ بْنِ سَعِیدٍ ، أَوْ سَعِیدِ بْنِ مُحَمَّدٍ ، قَالَ : کَانَ مِنْ دُعَائِ طَاوُوس ، یَقُولُ : اللَّہُمَّ امْنَعْنِی الْمَالَ وَالْوَلَدَ ، وَارْزُقْنِی الأَمْوَال وَالْعَمَلَ۔","","Musannaf Ibn Abi Shaybah 30485","","","كتاب الدعاء"
"30486","(۳۰۴۸۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا فِطْرٌ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدْعُو بِہَؤُلائِ الْکَلِمَاتِ وَیُعَظِّمُہُنَّ : اللَّہُمَّ یا فَارِجَ الْغَمِّ ، وَکَاشِفَ الْکَرْبِ ، وَمُجِیبَ الْمُضْطَرِّینَ ، وَرَحْمَنَ الدُّنْیَا وَالآخِرَۃِ وَرَحِیمَہُمَا ، ارْحَمْنِی الْیَوْمَ رَحْمَۃً تُغْنِینِی بِہَا عَن رَحْمَۃِ مَنْ سِوَاک۔ (طبرانی ۵۵۸۔ بزار ۳۱۷۷)","","Musannaf Ibn Abi Shaybah 30486","","","كتاب الدعاء"
"30487","(۳۰۴۸۷) حَدَّثَنَا وَکِیعٌ وَالْفَضْلُ بْنُ دُکَیْنٍ ، عَن سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْجَعْدِ ، عَن ثَوْبَانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یَرُدُّ الْقَدَرَ إِلاَّ الدُّعَائُ ، وَلا یَزِیدُ فِی الْعُمُرِ إِلاَّ الْبِرُّ۔ (احمد ۲۸۰۔ حاکم ۴۹۳)","","Musannaf Ibn Abi Shaybah 30487","","","كتاب الدعاء"
"30488","(۳۰۴۸۸) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَن مَنْصُورٍ ، عَن ہِلالِ بْنِ یَِسَافٍ ، عَن رَبِیعِ بْنِ عُمَیْلَۃَ ، عَن سَمُرَۃَ بْنِ جُنْدَبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَحَبُّ الْکَلامُ إِلَی اللہِ أَرْبَعٌ : سبحان اللہ ، وَالْحَمْدُ للہِ ، وَلاَ إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ ، لاَ یَضُرُّک بِأَیِّہِنَّ بَدَأْت۔ (مسلم ۱۶۸۵۔ احمد ۱۰)","Sahih","Musannaf Ibn Abi Shaybah 30488","","","كتاب الدعاء"
"30489","(۳۰۴۸۹) حَدَّثَنَا وَکِیعٌ ، وَأَبُو دَاوُد ، عَنْ سُفْیَانَ ، عَن سَلَمَۃَ بْنِ کُہَیْلٍ ، عَن ہِلالٍ ، عَن سَمُرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَفْضَلُ الْکَلامُ أَرْبَعٌ : سُبْحَانَ اللہِ ، وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ ، لاَ عَلَیْک بِأَیِّہِنَّ بَدَأْت۔ (ابن ماجہ ۳۸۱۱۔ احمد ۱۱)","","Musannaf Ibn Abi Shaybah 30489","","","كتاب الدعاء"
"30490","(۳۰۴۹۰) حَدَّثَنَا شَرِیکٌ ، عَن مُغِیرَۃَ ، عَن سُرِّیَّۃٍ لِعَبْدِ اللہِ بْنِ جَعْفَرٍ قَالَتْ: مَرَرْت بِعَلِیٍّ وَأَنَا حُبْلَی فَمَسَحَ بَطْنِی، وَقَالَ : اللَّہُمَّ اجْعَلْہُ ذَکَرًا مُبَارَکًا ، قَالَتْ : فَوَلَدْت غُلامًا۔","Da'if","Musannaf Ibn Abi Shaybah 30490","","","كتاب الدعاء"
"30491","(۳۰۴۹۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا سُفْیَانُ بْنِ أُمَیَّۃَ ، عَن دَاوُد بْنِ شَابُورَ ، قَالَ : قَالَ رَجُلٌ لِطَاوُوسٍ: ادْعُ لَنَا ، فَقَالَ : مَا أَجِدُ لِقَلْبِی خَشْیَۃ الآنَ۔","","Musannaf Ibn Abi Shaybah 30491","","","كتاب الدعاء"
"30492","(۳۰۴۹۲) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ ، قَالَ : حدَّثَنَا مَہْدِیُّ بْنُ مَیْمُونٍ ، عَن غَیْلانَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ إذَا نَعَبَ الْغُرَابُ ، قَالَ : اللَّہُمَّ لاَ طَیْرَ إِلاَّ طَیْرُک ، وَلا خَیْرَ إِلاَّ خَیْرُک ، وَلا إلَۃَ غَیْرُک۔","","Musannaf Ibn Abi Shaybah 30492","","","كتاب الدعاء"
"30493","(۳۰۴۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن یَحْیَی بْنِ وَثَّابٍ ، قَالَ : سَمِعْتُہُ یَقُولُ فِی قُنُوتِہِ : اللَّہُمَّ عَذِّبْ کَفَرَۃَ أَہْلِ الْکِتَابِ ، اللَّہُمَّ اجْعَلْ قُلُوبَہُمْ عَلَی قُلُوبِ نِسَائٍ کَوَافِرَ۔","","Musannaf Ibn Abi Shaybah 30493","","","كتاب الدعاء"
"30494","(۳۰۴۹۴) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حدَّثَنَا حُمَیْدٌ ، عَنِ الْحَسَنِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : کُنَّا نَدْعُو قِیَامًا وَقُعُودًا وَنُسَبِّحُ رُکُوعًا وَسُجُودًا۔","Sahih","Musannaf Ibn Abi Shaybah 30494","","","كتاب الدعاء"
"30495","(۳۰۴۹۵) حَدَّثَنَا سُفْیَانُ ، عَن مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، قَالَ : جَائَ رَجُلٌ یَشْکُو امْرَأَتَہُ إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخَذَ بِرُؤُوسِہِمَا ، وَقَالَ : اللَّہُمَّ آدِمْ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 30495","","","كتاب الدعاء"
"30496","(۳۰۴۹۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن صَالِحِ بْنِ حَیَّانَ ، قَالَ : سَمِعْتُ أَبَا وَائِلٍ یَقُولُ : أَعْطَانِی عُمَرُ أَرْبَعَ أَعْطِیَۃٍ بِیَدِہِ ، وَقَالَ : التَّکْبِیرُ خَیْرٌ مِنَ الدُّنْیَا ، وَمَا فِیہَا۔","Sahih","Musannaf Ibn Abi Shaybah 30496","","","كتاب الدعاء"
"30497","(۳۰۴۹۷) حَدَّثَنَا سُلَیْمَانُ بْنُ حَرْبٍ ، قَالَ : حدَّثَنَا شُعْبَۃُ بْنُ الْحَجَّاجِ ، عَن یَزِیدَ بْنِ خُمَیْرٍ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ بُسْرٍ ، قَالَ : جَائَ رَجُلٌ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَنَزَلَ ، فَأَتَاہُ بِطَعَامٍ ؛ سَوِیقٍ وَحَیْسٍ ، فَأَکَلَ ، وَأَتَاہُ بِشَرَابٍ فَشَرِبَ ، فَنَاوَلَ مَنْ عَن یَمِینِہِ ، وَکَانَ إذَا أَکَلَ تَمْرًا أَلْقَی النَّوَی ہَکَذَا - وَأَشَارَ بِإِصْبَعَیْہِ عَلَی ظَہْرِہِمَا - قَالَ : فَلَمَّا رَکِبَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَامَ أَبِی فَأَخَذَ بِلِجَامِہِ ، فَقَالَ : یَا رَسُولَ اللہِ ، ادْعُ اللَّہَ لَنَا ، فَقَالَ : اللَّہُمَّ بَارِکْ لَہُمْ فِیمَا رَزَقْتَہُمْ ، وَاغْفِرْ لَہُمْ ، وَارْحَمْہُمْ۔ (احمد ۱۸۷)","Sahih","Musannaf Ibn Abi Shaybah 30497","","","كتاب الدعاء"
"30498","(۳۰۴۹۹) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ قَالَ : حدَّثَنَا أَبُو عَقِیلٍ ، قَالَ : حَدَّثَنَا عَمْرُو بْنُ خَالِدٍ ، قَالَ : سَمِعْتُ زَیْدَ بْنَ عَلِیٍّ یُحَدِّثُ عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : کَانَ إذَا رَأَی الْکَوْکَبَ مُنْقَضًّا ، قَالَ : اللَّہُمَّ صَوِّبْہُ وَأَصِبْ بِہِ وَقِنَا شَرَّ مَا یَتَّبِعُ۔","Da'if","Musannaf Ibn Abi Shaybah 30498","","","كتاب الدعاء"
"30499","(۳۰۴۹۹) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا أَبُو عَقِیلٍ ، قَالَ : حَدَّثَنَا مُجَالِدٌ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ إذَا اشْتَرَی مَمْلُوکًا ، قَالَ اللَّہُمَّ بَارِکْ لَنَا فِیہِ ، وَاجْعَلْہُ طَوِیلَ الْعُمُرِ کَثِیرَ الرِّزْق۔","Da'if","Musannaf Ibn Abi Shaybah 30499","","","كتاب الدعاء"
"30500","(۳۰۵۰۰) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا أَبُو عَقِیلٍ ، عَن شَیْخٍ حَدَّثَہُ قَالَ : سَأَلْتُ ابْنَ سِیرِینَ : مَا أَقُولُ فِی الْبَرْقِ إذَا رَأَیْتہ ؟ قَالَ تُغْمِضُ عَیْنَیْک وَتَذْکُرُ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 30500","","","كتاب الدعاء"
"30501","(۳۰۵۰۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ: حدَّثَنِی عَبْدُ اللہِ بْنُ الْوَلِیدِ ، عَن زِیَادٍ ، عَنِ الْحَسَنِ ، قَالَ: مَنْ قَالَ إذَا قَالَ الْمُؤَذِّنُ أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ،اکفنی من أبی وَأَشْہَدُ مَعَ مَنْ شَہِدَ کَانَ لَہُ أَجْرُ مَنْ شَہِدَ وَمَنْ لَمْ یَشْہَدْ۔","","Musannaf Ibn Abi Shaybah 30501","","","كتاب الدعاء"
"30502","(۳۰۵۰۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ أَبِی جَعْفَرٍ بَیَّاعِ الطَّعَامِ ، قَالَ: کَانَ أَبُو جَعْفَرٍ یَقُولُ: أَعُوذُ بِاللہِ مِنْ شَرِّ الشَّیْطَانِ وَالسُّلْطَانِ ، وَشَرِّ النَّبَطِیِّ إذَا اسْتَعْرَبَ ، وَشَرِّ الْعَرَبِیِّ إذَا اسْتَنْبَطَ ، فَقِیلَ: وَکَیْفَ یَسْتَنْبِطُ الْعَرَبِیُّ ؟ قَالَ: إذَا أَخَذَ بِأَخْذِہِمْ وَزِیِّہِمْ۔","","Musannaf Ibn Abi Shaybah 30502","","","كتاب الدعاء"
"30503","(۳۰۵۰۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ عَن رَجُلٍ مِنْ أَہْلِ الْبَصْرَۃِ ، قَالَ: أُتِیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِہَدِیَّۃٍ وَعَائِشَۃُ قَائِمَۃٌ تُصَلِّی فَأَعْجَبَہُ أَنْ تَأْکُلَ مَعَہُ ، فَقَالَ: یَا عَائِشَۃُ اجْمَعِی وَأَوْجِزِی ، قَالَ: قُولِی: اللَّہُمَّ إنِّی أَسْأَلُک مِنَ الْخَیْرِ کُلِّہِ عَاجِلِہِ وَآجِلِہِ ، وَأَعُوذُ بِکَ مِنَ الشَّرِّ کُلِّہِ عَاجِلِہِ وَآجِلِہِ ، وَمَا قَضَیْت مِنْ قَضَائٍ فَبَارِکْ لِی فِیہِ ،وَاجْعَلْ عَاقِبَتَہُ إِلَی خَیْرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 30503","","","كتاب الدعاء"
"30504","(۳۰۵۰۴) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَن رَجُلٍ ، عَن مَکْحُولٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَا مِنْ رَجُلٍ یُحَمُّ فَیَغْتَسِلُ ثَلاثَۃَ أَیَّامٍ مُتَتَابِعَۃً ،یَقُولُ عِنْدَ کُلِّ غُسْلٍ: بِسْمِ اللہِ اللَّہُمَّ إِنِّی إنَّمَا اغْتَسَلْت الْتِمَاسَ شِفَائِکَ وَتَصْدِیقَ نَبِیِّکَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلاَّ کُشِفَ عَنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30504","","","كتاب الدعاء"
"30505","(۳۰۵۰۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ: حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَن زَیْدٍ الْعَمِّیِّ ، قَالَ: لَمَّا رَأَی یُوسُفُ عَزِیزَ مِصْرَ ، قَالَ: اللَّہُمَّ إنِّی أَسْأَلُک بِخَیْرِکَ مِنْ خَیْرِہِ وَأَعُوذُ بِقُوَّتِکَ مِنْ شَرِّہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30505","","","كتاب الدعاء"
"30506","(۳۰۵۰۶) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن حُمَیْدٍ ، أَنَّ سَعِیدَ بْنَ أَبِی الْحَسَنِ کَانَ یَقُولُ: اللَّہُمَّ سَوِّمْنَا سِیمَائَ الإِیمَانِ وَأَلْبِسْنَا لِبَاسَ التَّقْوَی۔","","Musannaf Ibn Abi Shaybah 30506","","","كتاب الدعاء"
"30507","(۳۰۵۰۷) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، قَالَ: کُنَّا فِی مَکَان لاَ تَنْفذُہُ الدَّوَابُّ فَقُمْت وَأَنَا أَقْرَأُ ہَؤُلائِ الآیَاتِ {غَافِرِ الذَّنْبِ وَقَابِلِ التَّوْبِ شَدِیدِ الْعِقَابِ}، قَالَ فَمَرَّ شَیْخٌ عَلَی بَغْلَۃٍ شَہْبَائَ ، قَالَ: قُلْ: یَا غَافِرَ الذَّنْبِ اغْفِرْ ذَنْبِی ، یَا قَابِلَ التَّوْبِ اقْبَلْ تَوْبَتِی ، یَا شَدِیدَ الْعِقَابِ اعْفُ عَنی عِقَابِی ، یَا ذَا الطَّوْلِ طُل عَلَیَّ بِخَیْرٍ ، قَالَ: فَقُلْتہَا ، ثُمَّ نَظَرْت فَلَمْ أَرَہُ۔","","Musannaf Ibn Abi Shaybah 30507","","","كتاب الدعاء"
"30508","(۳۰۵۰۸) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن ثَابِتٍ ، عَن عُبَیْدِ اللہِ بْنِ عُبَیْدٍ ، أَنَّ جِبْرِیلَ مُوَکَّلُ بِالْحَوَائِجِ ،فَإِذَا سَأَلَ الْمُؤْمِنُ رَبَّہُ ، قَالَ: احْبِسَ احْبِسْ حُبًّا لِدُعَائِہِ أَنْ یَزْدَادَ ، وَإِذَا سَأَلَ الْکَافِرُ ، قَالَ: أَعْطِہِ أَعْطِہِ بُغْضًا لِدُعَائِہِ۔","","Musannaf Ibn Abi Shaybah 30508","","","كتاب الدعاء"
"30509","(۳۰۵۰۹) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادٌ ، عَن ثَابِتٍ ، قَالَ: کَانَ أَنَسٌ یَقُولُ: لَقَدْ تَرَکْت بَعْدِی عَجَائِزَ یُکْثِرْنَ أَنْ یَدْعِینَ اللَّہَ أَنْ یُورِدَہُنَّ حَوْضَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 30509","","","كتاب الدعاء"
"30510","(۳۰۵۱۰) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ: أَخْبَرَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَن عُمَرَ بْنِ الْحَکَمِ الأَنْصَارِیِّ ، قَالَ: سَأَلْتُہ: ہَلْ صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَسْجِدِ الْفَتْحِ الَّذِی یُقَالُ لَہُ: مَسْجِدُ الأَحْزَابِ ؟ قَالَ : لَمْ یُصَلِّ فِیہِ وَلَکِنَّہُ دَعَا ، فَکَانَ مِنْ دُعَائِہِ أَنْ ، قَالَ : اللَّہُمَّ لَکَ الْحَمْدُ لاَ ہَادِیَ لِمَنْ أَضْلَلْت ، وَلا مُضِلَّ لِمَنْ ہَدَیْت، وَلا مُہِینَ لِمَنْ أَکْرَمْت ، وَلا مُکْرِمَ لِمَنْ أَہَنْت ، وَلا نَاصِرَ لِمَنْ خَذَلْت ، وَلا خَاذِلَ لِمَنْ نَصَرْت ، وَلا مُعِزَّ لِمَنْ أَذْلَلْت ، وَلا مُذِلَّ لِمَنْ أَعْزَزْت ، وَلا رَازِقَ لِمَنْ حَرَمْت ، وَلا حَارِمَ لِمَنْ رَزَقْت ، وَلا مَانِعَ لِمَا أَعْطَیْت ، وَلا مُعْطِیَ لِمَا مَنَعْت ، وَلا رَافِعَ لِمَنْ خَفَضْت ، وَلا سَاتِرَ لِمَا خَرَقْت ، وَلا خَارِقَ لِمَا سَتَرْت ، وَلا مُقَرِّبَ لِمَا بَاعَدْت، وَلا مُبَاعِدَ لِمَنْ قَرَّبْت ، ثُمَّ دَعَا عَلَیْہِمْ فَلَمْ یُصْبِحْ فِی الْمَدِینَۃِ کرَّاب مِنَ الأَحْزَابِ ، وَلا مِنَ الْمُشْرِکِینَ إِلاَّ أَہْلَکَہُ اللَّہُ غَیْرَ حُیَیِّ بْنِ أَخْطَبَ وَقُرَیْظَۃَ قَتَلَہَا اللَّہُ وَشُتِّتَ۔ (احمد ۳۹۳)","Da'if","Musannaf Ibn Abi Shaybah 30510","","","كتاب الدعاء"
"30511","(۳۰۵۱۱) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الأسدی ، قَالَ: حدَّثَنَا یَحْیَی بْنُ الْمُہَلَّبِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ اللہِ الْجَدَلِیِّ ، قَالَ: کَانَ دَاوُد النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ جَارٍ عَیْنُہُ تَرَانِی وَقَلْبُہُ یَرْعَانِی ، إِنْ رَأَی خَیْرًا دَفَنَہُ ، وَإِنْ رَأَی شَرًّا أَشَاعَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30511","","","كتاب الدعاء"
"30512","(۳۰۵۱۲) حَدَّثَنَا سَعِیدُ بْنُ زَکَرِیَّا ، عَنْ عَبْدِ اللہِ بْنِ مُؤَمَّلٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ: کَانَ ابْنُ عَبَّاسٍ إذَا أُتِیَ بِفِطْرٍ دَعَا قَبْلَ ذَلِکَ ، وَبَلَغَنَا أَنَّ الدُّعَائَ قَبْلَ ذَلِکَ یُسْتَجَابُ۔","Hasan","Musannaf Ibn Abi Shaybah 30512","","","كتاب الدعاء"
"30513","(۳۰۵۱۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ الْوَاسِطِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَن قَیْسِ بْنِ عُبَادٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ قَالَ: مَنْ قَالَ إذَا فَرَغَ مِنْ وُضُوئِہِ سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ،أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ أَنْتَ، أَسْتَغْفِرُک وَأَتُوبُ إلَیْک ،خُتِمَتْ بِخَاتَمٍ ، ثُمَّ رُفِعَتْ تَحْتَ الْعَرْشِ ،فَلَمْ تُکْسَرْ إِلَی یَوْمِ الْقِیَامَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 30513","","","كتاب الدعاء"
"30514","(۳۰۵۱۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، وَعَبْدُ اللہِ بْنُ دَاوُد ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَن سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ: کَانَ عَلِیٌّ یَقُولُ إذَا فَرَغَ مِنْ وُضُوئِہِ: أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ رَبِّ اجْعَلْنِی مِنَ التَّوَّابِینَ ، وَاجْعَلْنِی مِنَ الْمُتَطَہِّرِینَ۔","Hasan","Musannaf Ibn Abi Shaybah 30514","","","كتاب الدعاء"
"30515","(۳۰۵۱۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ: حدَّثَنَا عَمْرُو بْنُ عبد اللہِ بْنِ وَہْبٍ النَّخَعِیُّ ، عَن زَیْدٍ الْعَمِّیِّ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: مَنْ تَوَضَّأَ فَقَالَ: أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ،وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ثَلاثَ مَرَّاتٍ ، فُتِحَتْ لَہُ ثَمَانیَۃُ أَبْوَابِ الْجَنَّۃِ یَدْخُلُ مِنْ أَیِّہَا شَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 30515","","","كتاب الدعاء"
"30516","(۳۰۵۱۶) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِیئُ ، عَن سَعِیدِ بْنِ أَبِی أَیُّوبَ ، قَالَ: حدَّثَنِی زَہْرَۃُ بْنُ مَعْبَدٍ أَبُو عَقِیلٍ ، أَنَّ ابْنَ عَمٍّ لَہُ أَخْبَرَہُ ، أَنَّہُ سَمِعَ عُقْبَۃَ بْنَ عَامِرٍ یَقُولُ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ تَوَضَّأَ فَأَتَمَّ وُضُوئَہُ ، ثُمَّ رَفَعَ رَأْسَہُ إِلَی السَّمَائِ فَقَالَ: أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ وَأَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، فُتِحَتْ لَہُ ثَمَانیَۃُ أَبْوَابٍ مِنَ الْجَنَّۃِ یَدْخُلُ مِنْ أَیِّہَا شَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 30516","","","كتاب الدعاء"
"30517","(۳۰۵۱۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ: کَانَ حُذَیْفَۃُ إذَا تَطَہَّرَ ، قَالَ: أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، اللَّہُمَّ اجْعَلْنِی مِنَ التَّوَّابِینَ وَاجْعَلْنِی مِنَ الْمُتَطَہِّرِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 30517","","","كتاب الدعاء"
"30518","(۳۰۵۱۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ صُہَیْبٍ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ: کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا دَخَلَ الْخَلائَ ، قَالَ: أَعُوذُ بِاللہِ مِنَ الْخُبْثِ وَالْخَبَائِثِ۔","Sahih","Musannaf Ibn Abi Shaybah 30518","","","كتاب الدعاء"
"30519","(۳۰۵۱۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَن قَتَادَۃَ ، عَن قَاسِمٍ الشَّیْبَانِیِّ ، عَن زَیْدِ بْنِ أَرْقَمَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إنَّ ہَذِہِ الْحُشُوشَ مُحْتَضِرَۃٌ ، فَإِذَا دَخَلَ أَحَدُکُمْ الخلاء فَلْیَقُلِ: اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْخُبْثِ وَالْخَبَائِثِ۔","","Musannaf Ibn Abi Shaybah 30519","","","كتاب الدعاء"
"30520","(۳۰۵۲۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُمَرَ ، قَالَ: حدَّثَنِی الْحَسَنُ بْنُ مُسْلِمِ بْنِ یَنَّاقَ ، عَن رَجُلٍ مِنْ أَصْحَابِ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، قَالَ: قَالَ عَبْدُ اللہِ: إذَا دَخَلْت الْغَائِطَ فَأَرَدْت التَّکَشُّفَ فَقُلِ: اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الرِّجْسِ وَالنَّجَسِ وَالْخُبْثِ وَالْخَبَائِثِ وَالشَّیْطَانِ الرَّجِیمِ۔","Da'if","Musannaf Ibn Abi Shaybah 30520","","","كتاب الدعاء"
"30521","(۳۰۵۲۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن جُوَیْبِرٍ ، عَنِ الضِّحَاکِ ، قَالَ: کَانَ حُذَیْفَۃُ إذَا دَخَلَ الْخَلائَ ، قَالَ: أَعُوذُ بِاللہِ مِنَ الشَّیْطَانِ الرَّجِیمِ الرِّجْسِ النَّجَسِ الْخَبِیثِ الْمُخَبَّثِ الشَّیْطَانِ الرَّجِیمِ۔","Da'if","Musannaf Ibn Abi Shaybah 30521","","","كتاب الدعاء"
"30522","(۳۰۵۲۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی طَلْحَۃَ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا دَخَلَ الْکَنِیفَ ، قَالَ: بِسْمِ اللہِ اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْخُبْثِ وَالْخَبَائِثِ۔","Da'if","Musannaf Ibn Abi Shaybah 30522","","","كتاب الدعاء"
"30523","(۳۰۵۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنِ الزِّبْرِقَانِ الْعَبْدِیِّ ، عَنِ الضَّحَّاکِ ، قَالَ: إذَا دَخَلْت الْخَلائَ فَقُلِ: اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الرِّجْسِ النَّجَسِ الْخَبِیثِ الْمُخْبِثِ الشَّیْطَانِ الرَّجِیمِ۔","","Musannaf Ibn Abi Shaybah 30523","","","كتاب الدعاء"
"30524","(۳۰۵۲۴) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ: حدَّثَنَا إسْرَائِیلُ ، قَالَ: أَخْبَرَنَا یُوسُفُ بْنُ أَبِی بُرْدَۃَ ، قَالَ: سَمِعْتُ أَبِی یَقُولُ: دَخَلْتُ عَلَی عَائِشَۃَ فَسَمِعْتہَا تَقُولُ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا خَرَجَ مِنَ الْغَائِطِ ، قَالَ: غُفْرَانَک۔","Sahih","Musannaf Ibn Abi Shaybah 30524","","","كتاب الدعاء"
"30525","(۳۰۵۲۵) حَدَّثَنَا ہُشَیْمُ بْنُ الْعَوَّامِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، أَنَّ نُوحًا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا فَرَغَ مِنَ الْغَائِطِ ، قَالَ: الْحَمْدُ لِلَّہِ الَّذِی أَذْہَبَ عَنِّی الأَذَی وَعَافَانِی۔","","Musannaf Ibn Abi Shaybah 30525","","","كتاب الدعاء"
"30526","(۳۰۵۲۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا عَوَّامٌ ، قَالَ: حُدِّثْت أَنَّ نُوحًا عَلَیْہِ السَّلامُ کَانَ یَقُولُ: الْحَمْدُ لِلَّہِ الَّذِی أَذَاقَنِی لَذَّتَہُ وَأَبْقَی فِی مَنْفَعَتَہُ وَأَذْہَبَ عَنِّی أَذَاہُ۔","","Musannaf Ibn Abi Shaybah 30526","","","كتاب الدعاء"
"30527","(۳۰۵۲۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، وَوَکِیعٌ ، عَن سُفْیَانَ ، عَن مَنْصُورٍ ، عَنْ أَبِی عَلِیٍّ ، أَنَّ أَبَا ذَرٍّ کَانَ یَقُولُ إذَا خَرَجَ مِنَ الْخَلائِ: الْحَمْدُ لِلَّہِ الَّذِی أَذْہَبَ عَنِّی الأَذَی وَعَافَانِی۔","Da'if","Musannaf Ibn Abi Shaybah 30527","","","كتاب الدعاء"
"30528","(۳۰۵۲۸) حَدَّثَنَا وَکِیعٌ، عَن زَمْعَۃَ، عَن سَلَمَۃَ بْنِ وَہْرَامٍ، عَن طَاوُوس، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إذَا خَرَجَ أَحَدُکُمْ مِنَ الْخَلائِ فَلْیَقُلَ الْحَمْدُ لِلَّہِ الَّذِی أَذْہَبَ عَنِّی مَا یُؤْذِینِی وَأَمْسَکَ عَلَیَّ مَا یَنْفَعُنِی۔","Da'if","Musannaf Ibn Abi Shaybah 30528","","","كتاب الدعاء"
"30529","(۳۰۵۲۹) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ: حدَّثَنَا ہُرَیْمٌ ، عَن لَیْثٍ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو ، قَالَ: کَانَ أَبُو الدَّرْدَائِ إذَا خَرَجَ مِنَ الْخَلائِ ، قَالَ: الْحَمْدُ لِلَّہِ الَّذِی أَمَاطَ عَنِّی الأَذَی وَعَافَانِی۔","Da'if","Musannaf Ibn Abi Shaybah 30529","","","كتاب الدعاء"
"30530","(۳۰۵۳۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ: کَانَ حُذَیْفَۃُ یَقُولُ إذَا خَرَجَ: الْحَمْدُ لِلَّہِ الَّذِی أَذْہَبَ عَنِّی الأَذَی وَعَافَانِی۔","Da'if","Musannaf Ibn Abi Shaybah 30530","","","كتاب الدعاء"
"30531","(۳۰۵۳۱) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ: حدَّثَنَا أَبُو عَقِیلٍ ، قَالَ: حَدَّثَنَا مُجَالِدٌ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ ، قَالَ: کَانَ ابْنُ مَسْعُودٍ إذَا اشْتَرَی مَمْلُوکًا ، قَالَ: اللَّہُمَّ بَارِکْ فِیہِ ،وَاجْعَلْہُ طَوِیلَ الْعُمُرِ کَثِیرَ الرِّزْقِ۔","Da'if","Musannaf Ibn Abi Shaybah 30531","","","كتاب الدعاء"
"30532","(۳۰۵۳۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ أَبِی شَیْبَۃَ ، قَالَ: حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الْمَقْبُرِیِّ ، عَنْ جَدِّہِ ، عَن أَبِی ہُرَیْرَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أَعْرِبُوا الْقُرْآنَ وَالْتَمِسُوا غَرَائِبَہُ۔ (ابویعلی ۶۵۲۹۔ احمد ۴۴۵)","Da'if","Musannaf Ibn Abi Shaybah 30532","","","كتاب فضائل القرآن"
"30533","(۳۰۵۳۳) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَن لَیْثٍ، عَن طَلْحَۃَ، عَنْ إِبْرَاہِیمَ، عَن عَلْقَمَۃَ، عَنْ عَبْدِ اللہِ، قَالَ: أَعْرِبُوا الْقُرْآنَ۔","Da'if","Musannaf Ibn Abi Shaybah 30533","","","كتاب فضائل القرآن"
"30534","(۳۰۵۳۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَن ثَوْرٍ ، عَنْ عُمَر بْنِ زَیْدٍ قَالَ: کَتَبَ عُمَرُ إِلَی أَبِی مُوسَی: أَمَّا بَعْدُ فَتَفَقَّہُوا فِی السُّنَّۃِ ،وَتَفَقَّہُوا فِی الْعَرَبِیَّۃِ ،وَأَعْرِبُوا الْقُرْآنَ فَإِنَّہُ عَرَبِیٌّ ،وَتَمَعْدَدُوا فَإِنَّکُمْ مَعْدِیُّونَ۔","Da'if","Musannaf Ibn Abi Shaybah 30534","","","كتاب فضائل القرآن"
"30535","(۳۰۵۳۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، قَالَ: حَدَّثَنَا وَاصِلٌ مَوْلَی أَبِی عُیَیْنَۃَ ، عَن یَحْیَی بْنِ عَقِیلٍ ، عَن یَحْیَی بْنِ یَعْمَُرَ ، عَن أُبَیِّ بْنِ کَعْبٍ ، قَالَ: تَعَلَّمُوا الْعَرَبِیَّۃَ کَمَا تَعَلَّمُونَ حِفْظَ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30535","","","كتاب فضائل القرآن"
"30536","(۳۰۵۳۶) حَدَّثَنَا مُعْتَمِرٌ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ: أَعْرِبُوا الْقُرْآنَ۔","Da'if","Musannaf Ibn Abi Shaybah 30536","","","كتاب فضائل القرآن"
"30537","(۳۰۵۳۷) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن عُقْبَۃَ الأَسَدِیِّ ، عَنْ أَبِی الْعَلائِ ، قَالَ: قَالَ عَبْدُ اللہِ: أَعْرِبُوا الْقُرْآنَ فَإِنَّہُ عَرَبِیٌّ۔","Da'if","Musannaf Ibn Abi Shaybah 30537","","","كتاب فضائل القرآن"
"30538","(۳۰۵۳۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَن یُوسُفَ بْنِ صُہَیْبٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَن رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: لأَنْ أَقْرَأَ الآیَۃَ بِإِعْرَابٍ أَحَبُّ إلَیَّ مِنْ أَنْ أَقْرَأَ کَذَا وَکَذَا آیَۃً بِغَیْرِ إعْرَابٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30538","","","كتاب فضائل القرآن"
"30539","(۳۰۵۳۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن عُبَیْدِ اللہِ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَضْرِبُ وَلَدَہُ عَلَی اللَّحْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 30539","","","كتاب فضائل القرآن"
"30540","(۳۰۵۴۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی مُوسَی ، قَالَ: قَالَ رَجُلٌ لِلْحَسَنِ: یَا أَبَا سَعِیدٍ ، وَاللہ مَا أَرَاک تَلْحَنُ ، فَقَالَ: یَا ابْنَ أَخِی ، إنِّی سَبَقْت اللَّحْنَ۔","","Musannaf Ibn Abi Shaybah 30540","","","كتاب فضائل القرآن"
"30541","(۳۰۵۴۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن عُمَرَ بْنِ حَمْزَۃَ ، قَالَ: أَخْبَرَنِی سَالِمٌ ، أَنَّ زَیْدَ بْنَ ثَابِتٍ اسْتَشَارَ عُمَرَ فِی جَمْعِ الْقُرْآنِ فَأَبِیَ عَلَیْہِ فَقَالَ: أَنْتُمْ قَوْمٌ تَلْحَنُونَ ، وَاسْتَشَارَ عُثْمَانَ فَأَذِنَ لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30541","","","كتاب فضائل القرآن"
"30542","(۳۰۵۴۲) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَن شُعْبَۃَ ، عَنْ أَبِی رَجَائٍ ، قَالَ: سَأَلْت مُحَمَّدًا عَن نَقْطِ الْمَصَاحِفِ فَقَالَ: أَخَافُ أَنْ تَزِیدُوا فِی الْحُرُوفِ ، أَوْ تُنْقِصُوا مِنْہَا ، وَسَأَلْت الْحَسَنَ فَقَالَ: أَمَا بَلَغَک مَا کَتَبَ بِہِ عُمَرُ أَنْ تَعَلَّمُوا الْعَرَبِیَّۃَ وَحُسْنَ الْعِبَادَۃِ وَتَفَقَّہوا فِی الدِّینِ۔","","Musannaf Ibn Abi Shaybah 30542","","","كتاب فضائل القرآن"
"30543","(۳۰۵۴۳) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَن مُعَاوِیَۃَ بْنِ یَحْیَی ، عَن یُونُسَ بْنِ مَیْسَرَۃَ الْجُبْلانِیِّ ، عَن أُمِّ الدَّرْدَائِ قَالَتْ: إنِّی لأحِبّ أَنْ أَقْرَأَہُ کَمَا أُنْزِلَ یَعْنِی إعْرَابَ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30543","","","كتاب فضائل القرآن"
"30544","(۳۰۵۴۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَن یَزِیدَ بْنِ حَازِمٍ ، عَن سُلَیْمَانَ بْنِ یَسَارٍ ، قَالَ: انْتَہَی عُمَرُ إِلَی قَوْمٍ یُقْرِئُ بَعْضُہُمْ بَعْضًا ، فَلَمَّا رَأَوْا عُمَرَ سَکَتُوا فَقَالَ: مَا کُنْتُمْ تُرَاجِعُونَ قُلْنَا: کان یُقْرِئُ بَعْضُنَا بَعْضًا ،فَقَالَ: اقْرَؤُوا ، وَلا تَلْحَنُوا۔","","Musannaf Ibn Abi Shaybah 30544","","","كتاب فضائل القرآن"
"30545","(۳۰۵۴۵) حَدَّثَنَا جَرِیرٌ ، عَن ثَعْلَبَۃَ ، عَن مُقَاتِلِ بْنِ حَیَّانَ ، قَالَ: کَلامُ أَہْلِ السَّمَائِ الْعَرَبِیَّۃُ ، ثُمَّ قَرَأَ: (حم وَالْکِتَابِ الْمُبِینِ إنَّا جَعَلْنَاہُ قُرْآنًا عَرَبِیًّا لَعَلَّکُمْ تَعْقِلُونَ ،وَإِنَّہُ فِی أُمِّ الْکِتَابِ لَدَیْنَا لَعَلِیٌّ حَکِیمٌ) ۔","","Musannaf Ibn Abi Shaybah 30545","","","كتاب فضائل القرآن"
"30546","(۳۰۵۴۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَن مُوَرِّقٍ ، قَالَ: قَالَ عُمَرُ: تَعَلَّمُوا اللَّحْنَ وَالْفَرَائِضَ فَإِنَّہُ مِنْ دِینِکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 30546","","","كتاب فضائل القرآن"
"30547","(۳۰۵۴۷) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ ، قَالَ: حدَّثَنَا جَعْفَرٌ الأَحْمَرُ ، عَن مُطَرِّفٍ ، عَن سَوَادَۃَ بْنِ الْجَعْدِ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ: مِنْ فِقْہِ الرَّجُلِ عِرْفَانُہُ اللَّحْنَ۔","","Musannaf Ibn Abi Shaybah 30547","","","كتاب فضائل القرآن"
"30548","(۳۰۵۴۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَن خُلَیْدٍ الْعَصَرِیِّ ، قَالَ: لَمَّا قَدِمَ عَلَیْنَا سَلْمَانُ أَتَیْنَاہُ لیَسْتَقْرِئُنَا الْقُرْآنَ ،فَقَالَ: الْقُرْآنُ عَرَبِیٌّ فَاسْتَقْرِئُوہُ رَجُلاً عَرَبِیًّا ، فَاسْتَقْرَأْنَا زَیْدَ بْنَ صُوحَانَ ، فَکَانَ إذَا أَخْطَأَ أَخَذَ عَلَیْہِ سَلْمَانُ ، فَإِذَا أَصَابَ ، قَالَ: أَیْمُ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30548","","","كتاب فضائل القرآن"
"30549","(۳۰۵۴۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ: حَدَّثَنَا مَنْ کَانَ یُقْرِئُنَا مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُمْ کَانُوا یَقْتَرِئُونَ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَشْرَ آیَاتٍ ، وَلا یَأْخُذُونَ فِی الْعَشْرِ الأُخْرَی حَتَّی یَعْلَمُوا مَا فِی ہَذِہِ مِنَ الْعَمَلِ وَالْعِلْمِ ، قَالَ: فَعَلِمْنَا الْعَمَلَ وَالْعِلْمَ۔ (احمد ۴۱۰۔ ابن سعد ۱۷۲)","Da'if","Musannaf Ibn Abi Shaybah 30549","","","كتاب فضائل القرآن"
"30550","(۳۰۵۵۰) حَدَّثَنَا وَکِیعٌ ، عَن خَالِدِ بْنِ دِینَارٍ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ: تَعَلَّمُوا الْقُرْآنَ خَمْسَ آیَاتٍ خَمْسَ آیَاتٍ ، فَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَأْخُذُہُ خَمْسًا خَمْسًا۔ (بیہقی ۱۹۵۸)","","Musannaf Ibn Abi Shaybah 30550","","","كتاب فضائل القرآن"
"30551","(۳۰۵۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، قَالَ: کَانَ أَبُو عَبْدِ الرَّحْمَنِ یُعَلِّمُنَا خَمْسًا خَمْسًا۔","","Musannaf Ibn Abi Shaybah 30551","","","كتاب فضائل القرآن"
"30552","(۳۰۵۵۲) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبْجَرَ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو ، عَن قَیْسِ بْنِ سَکَنٍ ، قَالَ: قَالَ عَبْدُ اللہِ: تَعَلَّمُوا الْقُرْآنَ فَإِنَّہُ یُکْتَبُ بِکُلِّ حَرْفٍ مِنْہُ عَشْرُ حَسَنَاتٍ وَیُکَفَّرُ بِہِ عَشْرُ سَیِّئَاتٍ ، أَمَا إنِّی لاَ أَقُولُ: (الم) وَلَکِنْ أَقُولُ: أَلِفٌ عَشْرٌ وَلامٌ عَشْرٌ وَمِیمٌ عَشْرٌ۔ (حاکم ۵۵۵)","Sahih","Musannaf Ibn Abi Shaybah 30552","","","كتاب فضائل القرآن"
"30553","(۳۰۵۵۳) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ: حدَّثَنَا مُحَمَّدُ بْنُ کَعْبٍ ، عَنْ عَوْفِ بْنِ مَالِکٍ الأَشْجَعِیِّ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ قَرَأَ حَرْفًا مِنْ کِتَابِ اللہِ کُتِبَ لَہُ حَسَنَۃ ، لاَ أَقُولُ: {الم ذَلِکَ الْکِتَابُ} وَلَکِنَّ الْحُرُوفَ مُقَطَّعَۃٌ عَنِ الأَلِفِ وَاللامِ وَالْمِیمِ۔ (بزار ۲۳۲۳۔ طبرانی ۳۱۶)","Da'if","Musannaf Ibn Abi Shaybah 30553","","","كتاب فضائل القرآن"
"30554","(۳۰۵۵۴) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنْ أَبِی الأَحْوَصِ، عَنْ عَبْدِاللہِ، قَالَ: تَعَلَّمُوا الْقُرْآنَ وَاتْلُوہُ فَإِنَّ اللَّہَ یَأْجُرُکُمْ عَلَی تِلاوَتِہِ بِکُلِّ حَرْفٍ عَشْرَ حَسَنَاتٍ ، أَمَا إنِّی لاَ أَقُولُ: (الم) وَلَکِنْ أَلِفٌ وَلامٌ وَمِیمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 30554","","","كتاب فضائل القرآن"
"30555","(۳۰۵۵۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ: حدَّثَنَا مِسْعَرٌ ، عَن سُلَیْمَانَ الضَّبِّیِّ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، أَو الأَسْوَدِ ، عَنْ عَبْدِ اللہِ ، قَالَ: مَنْ قَرَأَ الْقُرْآنَ یَبْتَغِی بِہِ وَجْہَ اللہِ کَانَ لَہُ بِکُلِّ حَرْفٍ عَشْرُ حَسَنَاتٍ وَمَحْوُ عَشْرِ سَیِّئَاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30555","","","كتاب فضائل القرآن"
"30556","(۳۰۵۵۶) حَدَّثَنَا حفص بْنُ غِیَاثٍ ، وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَن طَلْحَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَۃَ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: زَیِّنُوا الْقُرْآنَ بِأَصْوَاتِکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 30556","","","كتاب فضائل القرآن"
"30557","(۳۰۵۵۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: دَخَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَسْجِدَ فَسَمِعَ قِرَائَۃَ رَجُلٍ فَقَالَ: مَنْ ہَذَا ؟ فقیل عَبْدُ اللہِ بْنُ قَیْسٍ ، فَقَالَ: لَقَدْ أُوتِیَ ہَذَا مِنْ مَزَامِیر آلِ دَاوُد۔ (احمد ۳۵۴۔ نسائی ۱۰۹۲)","Hasan","Musannaf Ibn Abi Shaybah 30557","","","كتاب فضائل القرآن"
"30558","(۳۰۵۵۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَن مَالِکِ بْنِ مِغْوَلٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لَقَدْ أُوتِیَ الأَشْعَرِیُّ مِزْمَارًا مِنْ مَزَامِیرِ آلِ دَاوُد۔ (بخاری ۱۰۸۷۔ مسلم ۵۴۶)","Sahih","Musannaf Ibn Abi Shaybah 30558","","","كتاب فضائل القرآن"
"30559","(۳۰۵۵۹) حَدَّثَنَا شَبَابَۃُ ، عَن لَیْثِ بْنِ سَعْدٍ ، عَنِ ابْنِ شِہَابٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ کَعْبِ بْنِ مَالِکٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لأَبِی مُوسَی وَسَمِعَہُ یَقْرَأُ الْقُرْآنَ: لَقَدْ أُوتِیَ أَخُوکُمْ مِنْ مَزَامِیرِ آلِ دَاوُد۔","","Musannaf Ibn Abi Shaybah 30559","","","كتاب فضائل القرآن"
"30560","(۳۰۵۶۰) حَدَّثَنَا أَبُو بَکْرٍ ،بَلَغَنِی عَنِ ابْنِ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَن عُرْوَۃَ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ ، أَوْ نَحْوِہِ۔ (دارمی ۱۴۸۹۔ احمد ۱۶۷)","","Musannaf Ibn Abi Shaybah 30560","","","كتاب فضائل القرآن"
"30561","(۳۰۵۶۱) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ أَبِی حَنِیفَۃَ، عَن حَمَّادٍ، عَنْ إبْرَاہِیمَ، قَالَ: قَالَ عُمَرُ: حَسِّنُوا أَصْوَاتَکُمْ بِالْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30561","","","كتاب فضائل القرآن"
"30562","(۳۰۵۶۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی نَہِیکٍ ، عَن سَعْدٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لَیْسَ مِنَّا مَنْ لَمْ یَتَغَنَّ بِالْقُرْآنِ۔","Sahih","Musannaf Ibn Abi Shaybah 30562","","","كتاب فضائل القرآن"
"30563","(۳۰۵۶۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَمْرٍو، عَنْ أَبِی سَلَمَۃَ رِوَایَۃً، قَالَ: مَا أَذِنَ اللَّہُ لِشَیْئٍ کَإِذْنِہِ لِعَبْدٍ یَتَرَنَّمُ بِالْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30563","","","كتاب فضائل القرآن"
"30564","(۳۰۵۶۴) حَدَّثَنَا حَفْصٌ ، عَن لَیْثٍ ، عَن طَاوُوس ، قَالَ: کَانَ یُقَالُ: أَحْسَنُ النَّاسِ صَوْتًا بِالْقُرْآنِ أَخْشَاہُمْ لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 30564","","","كتاب فضائل القرآن"
"30565","(۳۰۵۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَن طَاووس ،سُئِلَ مَنْ أَقْرَأُ النَّاسِ ؟ قَالَ: مَنْ إذَا قَرَأَ رَأَیْتہ یَخْشَی اللَّہَ ، قَالَ: وَکَانَ طَلْقٌ مِنْ أُولَئِکَ۔","","Musannaf Ibn Abi Shaybah 30565","","","كتاب فضائل القرآن"
"30566","(۳۰۵۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی الضُّحَی ، عَن مَسْرُوقٍ ، قَالَ: کُنَّا مَعَ أَبِی مُوسَی فَجنَّنَا اللَّیْلَ إِلَی بُسْتَانٍ خَرِبٍ ، قَالَ: فَقَامَ مِنَ اللَّیْلِ فَقَرَأَ قِرَائَۃً حَسَنَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 30566","","","كتاب فضائل القرآن"
"30567","(۳۰۵۶۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن ثَابِتٍ ، عَنْ أَنَسٍ ، أَنَّ أَبَا مُوسَی کَانَ یَقْرَأُ ذَاتَ لَیْلَۃٍ ، وَنِسَائُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْتَمِعْنَ فَقِیلَ لَہُ ، فَقَالَ: لَوْ عَلِمْت لَحَبَّرْت تَحْبِیرًا ، أَوْ لَشَوَّقْت تَشْوِیقًا۔","Sahih","Musannaf Ibn Abi Shaybah 30567","","","كتاب فضائل القرآن"
"30568","(۳۰۵۶۸) حَدَّثَنَا عَفَّان ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ: أَخْبَرَنَا عِمْرَانُ بْنُ عَبْدِ اللہِ بْنِ طَلْحَۃَ ، أَنَّ رَجُلاً قَرَأَ فِی مَسْجِدِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی رَمَضَانَ فَطَرَّبَ فَأَنْکَرَ ذَلِکَ الْقَاسِمُ ، وَقَالَ یَقُولُ اللَّہُ تَعَالَی: {وَإِنَّہُ لَکِتَابٌ عَزِیزٌ لاَ یَأْتِیہِ الْبَاطِلُ مِنْ بَیْنِ یَدَیْہِ وَلا مِنْ خَلْفِہِ تَنْزِیلٌ مِنْ حَکِیمٍ حَمِیدٍ}۔","","Musannaf Ibn Abi Shaybah 30568","","","كتاب فضائل القرآن"
"30569","(۳۰۵۶۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، أَنَّ رَجُلاً قَرَأَ عِنْدَ أَنَسٍ فَطَرَّبَ فَکَرِہَ ذَلِکَ أَنَسٌ۔","","Musannaf Ibn Abi Shaybah 30569","","","كتاب فضائل القرآن"
"30570","(۳۰۵۷۰) حَدَّثَنَا عَفَّان ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ: أَخْبَرَنَا عُبَیْدُ اللہِ بْنُ أَبِی بَکْرٍ ، أَنَّ زِیَادًا النُّمَیْرِیَّ جَائَ مَعَ الْقُرَّائِ إِلَی أَنَسِ بْنِ مَالِکٍ فقیل لَہُ: اقْرَأْ ، فَرَفَعَ صَوْتَہُ ، وَکَانَ رَفِیعَ الصَّوْتِ ، فَکَشَفَ أَنَسٌ عَن وَجْہِہِ الْخِرْقَۃَ ، وَکَانَ عَلَی وَجْہِہِ خِرْقَۃٌ سَوْدَائُ ،فَقَالَ: مَا ہَذَا ؟ مَا ہَکَذَا کَانُوا یَفْعَلُونَ ، وَکَانَ إذَا رَأَی شَیْئًا یُنْکِرُہُ کَشَفَ الْخِرْقَۃَ عَن وَجْہِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30570","","","كتاب فضائل القرآن"
"30571","(۳۰۵۷۱) حَدَّثَنَا جَرِیرٌ ، عَن لَیْثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ: کَانَ أَحَدُہُمْ یَمُدُّ بِالآیَۃِ فِی جَوْفِ اللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 30571","","","كتاب فضائل القرآن"
"30572","(۳۰۵۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ السَّدُوسِیُّ ، عَن مِعْفَسِ بْنِ عِمْرَانَ ، عَن أُمِّ الدَّرْدَائِ قَالَتْ: دَخَلْتُ عَلَی عَائِشَۃَ ، فَقُلْتُ: مَا فَضْلُ مَنْ قَرَأَ الْقُرْآنَ عَلَی مَنْ لَمْ یَقْرَأْہُ مِمَّنْ دَخَلَ الْجَنَّۃَ ، فَقَالَتْ عَائِشَۃُ: إنَّ عَدَدَ دَرَجِ الْجَنَّۃِ عَلَی عَدَدِ آیِ الْقُرْآنِ ، فَلَیْسَ أَحَدٌ مِمَّنْ دَخَلَ الْجَنَّۃَ أَفْضَلَ مِمَّنْ قَرَأَ الْقُرْآنَ۔","Da'if","Musannaf Ibn Abi Shaybah 30572","","","كتاب فضائل القرآن"
"30573","(۳۰۵۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا إسْمَاعِیلُ بْنُ رَافِعٍ ، عَن رَجُلٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ: مَنْ قَرَأَ الْقُرْآنَ فَکَأَنَّمَا اسْتُدْرِجَتِ النُّبُوَّۃُ بَیْنَ جَنْبَیْہِ إِلاَّ أَنَّہُ لاَ یُوحَی إلَیْہِ۔ (حاکم ۵۵۲)","Da'if","Musannaf Ibn Abi Shaybah 30573","","","كتاب فضائل القرآن"
"30574","(۳۰۵۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا عِمْرَانُ أَبُو بِشْرٍ الْحَلَبِیُّ ، عَنِ الْحَسَنِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ فَاقَۃَ لِعَبْدٍ یَقْرَأُ الْقُرْآنَ ، وَلا غِنَی لَہُ بَعْدَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30574","","","كتاب فضائل القرآن"
"30575","(۳۰۵۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِیہِ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: مَنْ قَرَأَ الْقُرْآنَ وَاتَّبَعَ مَا فِیہِ ،ہَدَاہُ اللَّہُ مِنَ الضَّلالَۃِ ،وَوَقَاہُ یَوْمَ الْقِیَامَۃِ سُوئَ الْحِسَابِ ، وَذَلِکَ بِأَنَّ اللَّہَ یَقُولُ: {فَمَنَ اتَّبَعَ ہُدَایَ فَلا یَضِلُّ وَلا یَشْقَی}۔","Da'if","Musannaf Ibn Abi Shaybah 30575","","","كتاب فضائل القرآن"
"30576","(۳۰۵۷۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن عمرو بن قیس عن عکرمۃ عن ابن عباس قَالَ: ضَمِنَ اللَّہُ لمن قَرَأَ الْقُرْآنَ أَلاَّ یَضِلَّ فِی الدُّنْیَا وَلا یَشْقَی فِی الآخِرَۃِ ثم تلا: {فَمَنَ اتَّبَعَ ہُدَایَ فَلا یَضِلُّ وَلا یَشْقَی}۔","Hasan","Musannaf Ibn Abi Shaybah 30576","","","كتاب فضائل القرآن"
"30577","(۳۰۵۷۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْحَکَمِ بْنِ ہِشَامٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ: کَانَ یُقَالُ: إنَّ أَبْقَی النَّاسِ عُقُولاً قَرَأَۃُ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30577","","","كتاب فضائل القرآن"
"30578","(۳۰۵۷۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَاصِمٍ ، عَن عِکْرِمَۃَ ، قَالَ: مَنْ قَرَأَ الْقُرْآنَ لَمْ یُرَدَّ إِلَی أَرْذَلِ الْعُمُرِ ، ثُمَّ قَرَأَ: {لِکَیْ لاَ یَعْلَمَ بَعْدَ عِلْمٍ شَیْئًا}۔","","Musannaf Ibn Abi Shaybah 30578","","","كتاب فضائل القرآن"
"30579","(۳۰۵۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَن مُحَمَّدِ بْنِ کَعْبٍ ، قَالَ: مَنْ قَرَأَ الْقُرْآنَ فَکَأَنَّمَا رَأَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ قَرَأَ: {وَمَنْ بَلَغَ أَئِنَّکُمْ لَتَشْہَدُونَ}۔","","Musannaf Ibn Abi Shaybah 30579","","","كتاب فضائل القرآن"
"30580","(۳۰۵۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ یَزِیدَ ، عَنِ الزُّہْرِیِّ ، عَن مُعَاذِ بْنِ جَبَلٍ ، قَالَ: مَنِ اسْتَظْہَرَ الْقُرْآنَ کَانَتْ لَہُ دَعْوَۃٌ إِنْ شَائَ یُعَجِّلُہَا لِدُنْیَا ، وَإِنْ شَائَ لآخِرَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 30580","","","كتاب فضائل القرآن"
"30581","(۳۰۵۸۱) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، قَالَ: أَخْبَرَنَا إبْرَاہِیمُ بْنُ إسْمَاعِیلَ الأَنْصَارِیُّ ، قَالَ: أَخْبَرَنَا ابْنُ شِہَابٍ ، عَن عُبَیْدِ بْنِ السَّبَّاقِ ، أَنَّ عُثْمَانَ ، قَالَ: إنَّمَا نَزَلَ بِلِسَانِ قُرَیْشٍ یَعْنِی الْقُرْآنَ۔","Da'if","Musannaf Ibn Abi Shaybah 30581","","","كتاب فضائل القرآن"
"30582","(۳۰۵۸۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ: حدَّثَنَا سَلَمَۃ بْن نُبَیْطٍ ، عَنِ الضَّحَّاکِ ، قَالَ: نَزَلَ الْقُرْآنُ بِکُلِّ لِسَانٍ۔","","Musannaf Ibn Abi Shaybah 30582","","","كتاب فضائل القرآن"
"30583","(۳۰۵۸۳) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی مَیْسَرَۃَ ، قَالَ: نَزَلَ الْقُرْآنُ بِکُلِّ لِسَانٍ۔","","Musannaf Ibn Abi Shaybah 30583","","","كتاب فضائل القرآن"
"30584","(۳۰۵۸۴) حَدَّثَنَا زَیْدِ بْنِ الْحُبَابِ، عَن سیف، قَالَ: سَمِعْتُ مُجَاہِدًا یَقُولُ: نَزَلَ الْقُرْآنُ بِلِسَانِ قُرَیْشٍ، وَبِہِ کَلامُہُمْ۔","","Musannaf Ibn Abi Shaybah 30584","","","كتاب فضائل القرآن"
"30585","(۳۰۵۸۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ: {الْمَاعُونُ} بِلِسَانِ قُرَیْشٍ: الْمَالُ۔","","Musannaf Ibn Abi Shaybah 30585","","","كتاب فضائل القرآن"
"30586","(۳۰۵۸۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ، عَنْ جَرِیرِ بْنِ حَازِمٍ، عَن عِکْرِمَۃَ بْنِ خَالِدٍ، قَالَ: نَزَلَ الْقُرْآنُ بِلِسَانِنَا یَعْنِی قُرَیْش۔","","Musannaf Ibn Abi Shaybah 30586","","","كتاب فضائل القرآن"
"30587","(۳۰۵۸۷) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَن حُسَیْنِ بْنِ وَاقِدٍ ، عَنِ ابْنِ بُرَیْدَۃَ: أَنَّ لِسَانَ جُرْہُمٍ کَانَ عَرَبِیًّا۔","","Musannaf Ibn Abi Shaybah 30587","","","كتاب فضائل القرآن"
"30588","(۳۰۵۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَن سَعدِ بْنِ عِیَاضٍ: { کَمِشْکَاۃٍ } قَالَ: کَکُوَّۃٍ بِلِسَانِ الْحَبَشَۃِ۔","","Musannaf Ibn Abi Shaybah 30588","","","كتاب فضائل القرآن"
"30589","(۳۰۵۸۹) حَدَّثَنَا وَکِیعٌ ، عَن عُمَرَ بْنِ أَبِی زَائِدَۃَ ، عَن عِکْرِمَۃَ ، قَالَ: (طَہ) بِالْحَبَشِیَّۃِ: یَا رَجُلُ۔","","Musannaf Ibn Abi Shaybah 30589","","","كتاب فضائل القرآن"
"30590","(۳۰۵۹۰) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ أَبِی إِسْحَاقَ، عَن سَعِیدِ بْنِ جّبَیر قَالَ: ہُوَ بِلِسَانِ الْحَبَشَۃِ: إذا قام نشأ۔","","Musannaf Ibn Abi Shaybah 30590","","","كتاب فضائل القرآن"
"30591","(۳۰۵۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ أَبِی مُوسَی {یُؤْتِکُمْ کِفْلَیْنِ مِنْ رَحْمَتِہِ} قَالَ: أَجْرَیْنِ بِلِسَانِ الْحَبَشَۃِ۔","","Musannaf Ibn Abi Shaybah 30591","","","كتاب فضائل القرآن"
"30592","(۳۰۵۹۲) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی سِنَانٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ ، عَنْ عَبْدِ اللہِ {إنَّ نَاشِئَۃَ اللَّیْلِ} قَالَ: ہُوَ بالْحَبَشَۃِ قِیَامُ اللَّیْلِ۔","Hasan","Musannaf Ibn Abi Shaybah 30592","","","كتاب فضائل القرآن"
"30593","(۳۰۵۹۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ جَابِرٍ ، عَن مُجَاہِدٍ فِی قَوْلِہِ: {وَزِنُوا بِالْقِسْطَاسِ الْمُسْتَقِیمِ} قَالَ: الْعَدْلُ بِالرُّومِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 30593","","","كتاب فضائل القرآن"
"30594","(۳۰۵۹۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن عِکْرِمَۃَ {وَأَنْتُمْ سَامِدُونَ} قَالَ: ہُوَ الْغِنَائُ بِالْحِمْیَرِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 30594","","","كتاب فضائل القرآن"
"30595","(۳۰۵۹۵) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَن مُجَاہِدٍ ، قَالَ: {الْقِسْطَاسُ} الْعَدْلُ بِالرُّومِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 30595","","","كتاب فضائل القرآن"
"30596","(۳۰۵۹۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن سَالِمٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ: (طَہ) بِالنَّبَطِیَّۃِ: ایطہ یَا رَجُلُ۔","","Musannaf Ibn Abi Shaybah 30596","","","كتاب فضائل القرآن"
"30597","(۳۰۵۹۷) حَدَّثَنَا وَکِیعٌ ، عَن قُرَّۃَ بْنِ خَالِدٍ ، عَنِ الضَّحَّاک ، قَالَ: (طَہ) یَا رَجُلُ بِالنَّبَطِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 30597","","","كتاب فضائل القرآن"
"30598","(۳۰۵۹۸) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن خُصَیْفٍ ، عَن عِکْرِمَۃَ ، قَالَ: (طَہ) یَا رَجُلُ بِالنَّبَطِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 30598","","","كتاب فضائل القرآن"
"30599","(۳۰۵۹۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن سَلَمَۃَ بْنِ سَابُورَ ، عَنْ عَطِیَّۃَ عَنِ ابْنِ عَبَّاسٍ: {ہَیْتَ لَک} قَالَ: ہِیَ بِالنَّبَطِیَّۃِ: ہَلُمَّ لَک۔","Da'if","Musannaf Ibn Abi Shaybah 30599","","","كتاب فضائل القرآن"
"30600","(۳۰۶۰۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ {حِجَارَۃً مِنْ سِجِّیلٍ} قَالَ: ہِیَ بِالْفَارِسِیَّۃِ سنْک ، وَکِلْ حَجَرٍ وَطِینٍ۔","Hasan","Musannaf Ibn Abi Shaybah 30600","","","كتاب فضائل القرآن"
"30601","(۳۰۶۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنِ ابْنِ سَابِطٍ {حِجَارَۃً مِنْ سِجِّیلٍ} قَالَ: ہِیَ بِالْفَارِسِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 30601","","","كتاب فضائل القرآن"
"30602","(۳۰۶۰۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَن مُسْلِمٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ {یَوَدُّ أَحَدُہُمْ لَوْ یُعَمَّرُ أَلْفَ سَنَۃٍ} قَالَ: ہُوَ کَقَوْلِ الأَعَاجِمِ زہر ہَزَارُسَالَ ،أَیْ عِشْ أَلْف سَنَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30602","","","كتاب فضائل القرآن"
"30603","(۳۰۶۰۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ جَعْفَرٍ ، عَنِ الْقَاسِمِ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ: إنَّ الْمَلائِکَۃَ الَّذِینَ یَحْمِلُونَ الْعَرْشَ یَتَکَلَّمُونَ الْفَارِسِیَّۃِ الدُّرِّیِّۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 30603","","","كتاب فضائل القرآن"
"30604","(۳۰۶۰۴) حَدَّثَنَا جَرِیرٌ ، عَن بَیَانٍ ، عَنِ الشَّعْبِیِّ ، قَالَ: کَلامُ النَّاسِ یَوْمَ الْقِیَامَۃِ السُّرْیَانِیَّۃُ۔","","Musannaf Ibn Abi Shaybah 30604","","","كتاب فضائل القرآن"
"30605","(۳۰۶۰۵) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَن مِسْمَعِ بْنِ مَالِکٍ ، قَالَ: سَمِعْتُ عِکْرِمَۃَ ، قَالَ: کَانَ ابْنُ عَبَّاسٍ إذَا سُئِلَ عَن الشَّیْئِ مِنَ الْقُرْآنِ أَنْشَدَ أشْعَارًا مِنْ أَشْعَارِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 30605","","","كتاب فضائل القرآن"
"30606","(۳۰۶۰۶) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَن قَتَادَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: مَا کُنْت أَدْرِی مَا قَوْلُہُ: {رَبَّنَا افْتَحْ بَیْنَنَا وَبَیْنَ قَوْمِنَا بِالْحَقِّ} حَتَّی سَمِعْت بِنْتَ ذِی یَزِنَ تَقُولُ: تَعَالَ أُفَاتِحْک۔","Sahih","Musannaf Ibn Abi Shaybah 30606","","","كتاب فضائل القرآن"
"30607","(۳۰۶۰۷) حَدَّثَنَا شَرِیکٌ ، عَن بَیَانٍ ، عَنْ عَامِرٍ {فَإِذَا ہُمْ بِالسَّاہِرَۃِ} قَالَ: بِالأَرْضِ ، ثُمَّ أَنْشَدَ أَبْیَاتًا لأُمَیَّۃِ: وَفِیہَا لَحْمُ سَاہِرَۃٍ وَبَحْرٍ۔","","Musannaf Ibn Abi Shaybah 30607","","","كتاب فضائل القرآن"
"30608","(۳۰۶۰۸) حَدَّثَنَا شَرِیکٌ ، عَن فُرَاتٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ: الْقَانِعَ السَّائِلَ ، ثُمَّ أَنْشَدَ أَبْیَاتًا لِلشَمَّاخ: nلَمَالُ الْمَرْئِ یُصْلِحُہُ فَیُغْنِی مَفَاقِرَہُ أَعَفُّ مِنَ الْقَنُوعِ","","Musannaf Ibn Abi Shaybah 30608","","","كتاب فضائل القرآن"
"30609","(۳۰۶۰۹) حَدَّثَنَا وَکِیعٌ ، عَن ثَابِتَ بْنِ أَبِی صَفِیَّۃَ ، عَن شَیْخٍ یُکَنَّی أَبَا عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: الزَّنِیمُ اللَّئِیمُ الْمُلَزَّقُ ، ثُمَّ أَنْشَدَ ہَذَا الْبَیْتَ: nزَنِیمٌ تَدَاعَاہُ الرِّجَالُ زِیَادَۃً کَمَا زِیدَ فِی عَرْضِ الأَدِیمِ الأَکَارِعُ","Da'if","Musannaf Ibn Abi Shaybah 30609","","","كتاب فضائل القرآن"
"30610","(۳۰۶۱۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَبِی المعلی ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ یَقْرَأُ: (دَرَسْتَ) ، وَیَتَمَثَّلُ: دَارِسٌ کَطَعْمِ الصَّابِّ وَالْعَلْقَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 30610","","","كتاب فضائل القرآن"
"30611","(۳۰۶۱۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الکَہْفِ ، عَنْ أَبِیہِ {فَمِنْہُمْ مَنْ قَضَی نَحْبَہُ} قَالَ: نَذَرہ ، وَقَالَ الشَّاعِرُ: قَضَتْ مِنْ یَثْرِب نَحْبَہَا فَاسْتَمَرَّتْ۔","","Musannaf Ibn Abi Shaybah 30611","","","كتاب فضائل القرآن"
"30612","(۳۰۶۱۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن عُبَیْدِ اللہِ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَثَلُ الْقُرْآنِ مَثَلُ الإِبِلِ الْمَعْقُولَۃِ ،إِنْ عَقَلَہَا صَاحِبُہَا أَمْسَکَہَا ، وَإِنْ تَرَکَہَا ذَہَبَتْ۔","Hasan","Musannaf Ibn Abi Shaybah 30612","","","كتاب فضائل القرآن"
"30613","(۳۰۶۱۳) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَن مُوسَی بْنِ عُلَیٍّ ، قَالَ: سَمِعْتُ أَبِی یَقُولُ: ، قَالَ: سَمِعْتُ عُقْبَۃَ بْنَ عَامِرٍ یَقُولُ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: تَعَلَّمُوا الْقُرْآنَ وَاقْتَنُوہُ وَالَّذِی نَفْسِی بِیَدِہِ لَہُوَ أَشَدُّ تَفَصِّیًا مِنَ الْمَخَاضِ مِنْ عُقُلِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 30613","","","كتاب فضائل القرآن"
"30614","(۳۰۶۱۴) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَن بُرَیْدِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: تَعَاہَدُوا الْقُرْآنَ فَوَالَّذِی نَفْسِی بِیَدِہِ لَہُوَ أَشَدُّ تَفَصِّیًا مِنْ قُلُوبِ الرِّجَالِ مِنَ الإِبِلِ مِنْ عُقُلِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 30614","","","كتاب فضائل القرآن"
"30615","(۳۰۶۱۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن شَقِیقٍ ، قَالَ: قَالَ عَبْدُ اللہِ: تَعَاہَدُوا ہَذِہِ الْمَصَاحِفَ وَرُبَّمَا قَالَ: الْقُرْآنَ فَلَہُوَ أَشَدُّ تَفَصِّیًا مِنْ قُلُوبِ الرِّجَالِ مِنَ النَّعَمِ مِنْ عُقُلِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 30615","","","كتاب فضائل القرآن"
"30616","(۳۰۶۱۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَن مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ: قَالَ عَبْدُ اللہِ: تَعَاہَدُوا ہَذَا الْقُرْآنَ فَلَہُوَ أَشَدُّ تَفَصِّیًا مِنَ النَّعَمِ مِنْ عُقُلِہِ ، قَالَ: وَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: بِئْسَ مَا لأَحَدِہِمْ أَنْ یَقُولَ: نَسِیت آیَۃَ کَیْتَ وَکَیْتَ بَلْ ہُوَ نُسِّیَ۔ (بخاری ۵۰۳۲۔ ترمذی ۲۹۴۲)","Sahih","Musannaf Ibn Abi Shaybah 30616","","","كتاب فضائل القرآن"
"30617","(۳۰۶۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَن عِیسَی بْنِ فَائِدٍ ، قَالَ: حدَّثَنِی فُلانٌ ، عَن سَعْدِ بْنِ عُبَادَۃَ ، قَالَ: حَدَّثَنِیہِ ، عَن رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَا مِنْ أَحَدٍ یَقْرَأُ الْقُرْآنَ ، ثُمَّ یَنْسَاہُ إِلاَّ لَقِیَ اللَّہَ وَہُوَ أَجْذَمُ۔ (احمد ۲۸۴۔ طبرانی ۵۳۸۷)","Da'if","Musannaf Ibn Abi Shaybah 30617","","","كتاب فضائل القرآن"
"30618","(۳۰۶۱۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی رَوَّاد ، عَنِ الضَّحَّاکِ ، قَالَ: مَا تَعَلَّمَ رَجُلٌ الْقُرْآنَ ، ثُمَّ نَسِیَہُ إِلاَّ بِذَنْبٍ ، ثُمَّ قَرَأَ الضَّحَّاکُ: {وَمَا أَصَابَکُمْ مِنْ مُصِیبَۃٍ فَبِمَا کَسَبَتْ أَیْدِیکُمْ} ثُمَّ قَالَ الضَّحَّاکُ: وَأَیُّ مُصِیبَۃٍ أَعْظَمُ مِنْ نِسْیَانِ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30618","","","كتاب فضائل القرآن"
"30619","(۳۰۶۱۹) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ أَبِی أُمَیَّۃَ ، عَن طَلْقِ بْنِ حَبِیبٍ ، قَالَ: مَنْ تَعَلَّمَ الْقُرْآنَ ، ثُمَّ نَسِیَہُ مِنْ غَیْرِ عُذْرٍ حُطَّ عَنْہُ بِکُلِّ آیَۃٍ دَرَجَۃٌ ، وَجَائَ یَوْمَ الْقِیَامَۃِ مَخْصُومًا۔","","Musannaf Ibn Abi Shaybah 30619","","","كتاب فضائل القرآن"
"30620","(۳۰۶۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ یَزِیدَ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ اللہِ بْنِ أَبِی مُغِیثٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: عُرِضَتْ عَلَیَّ الذُّنُوبُ فَلَمْ أَرَ فِیہَا شَیْئًا أَعْظَمَ مِنْ حَامِلِ الْقُرْآنِ وَتَارِکِہِ۔ (ابوداؤد ۴۶۲۔ ترمذی ۲۹۱۶)","Da'if","Musannaf Ibn Abi Shaybah 30620","","","كتاب فضائل القرآن"
"30621","(۳۰۶۲۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن وَاقِدٍ ، عَن زَاذَانَ ، قَالَ: مَنْ قَرَأَ الْقُرْآنَ لِیَتَأَکَّلَ بِہِ النَّاسَ لَقِیَ اللَّہَ وَلَیْسَ عَلَی وَجْہِہِ مُزْعَۃُ لَحْمٍ۔","","Musannaf Ibn Abi Shaybah 30621","","","كتاب فضائل القرآن"
"30622","(۳۰۶۲۲) حَدَّثَنَا وَکِیعٌ ، عَن یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، قَالَ: قَالَ عُمَرُ: اقَرَؤُوا الْقُرْآنَ وَاسْأَلُوا اللَّہَ بِہِ ،قَبْلَ أَنْ یَقْرَأَہ قَوْمٌ یَسْأَلُونَ النَّاسَ بِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 30622","","","كتاب فضائل القرآن"
"30623","(۳۰۶۲۳) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ الْجَرِیرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی فِرَاسٍ ، قَالَ: قَالَ عُمَرُ: قَدْ أَتَی عَلَیَّ زَمَانٌ وَأَنَا أَحْسِبُ مَنْ قَرَأَ الْقُرْآنَ یُرِیدُ بِہِ اللہ ، فَقَدْ خُیِّلَ لِی الآنَ بِأَخَرِۃٍ أَنِّی أَرَی قَوْمًا قَدْ قَرَؤُوہُ یُرِیدُونَ بِہِ النَّاسَ ، فَأَرِیدُوا اللَّہَ بِقِرَائَتِکُمْ ،وَأَرِیدُوا اللَّہَ بِأَعْمَالِکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 30623","","","كتاب فضائل القرآن"
"30624","(۳۰۶۲۴) حَدَّثَنَا الزُّبَیْرِیُّ مُحَمَّدُ بْنُ عَبْدِ اللہِ ، عَن سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَن خَیْثَمَۃَ ، عَنِ الْحَسَنِ ، عَن عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ: سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: مَنْ قَرَأَ الْقُرْآنَ فَلْیَسْأَلَ اللَّہَ بِہِ ،فَإِنَّہُ سَیَجِیئُ قَوْمٌ یَقْرَؤُونَ الْقُرْآنَ یَسْأَلُونَ النَّاسَ بِہِ۔ (ترمذی ۲۹۱۷۔ احمد ۴۳۹)","Da'if","Musannaf Ibn Abi Shaybah 30624","","","كتاب فضائل القرآن"
"30625","(۳۰۶۲۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ: قَالَ عُمَرُ: اقَرَؤُوا الْقُرْآنَ وَاطْلُبُوا بِہِ مَا عِنْدَ اللہ ،قَبْلَ أَنْ یَقْرَأَہُ أَقْوَامٌ یَطْلُبُونَ بِہِ مَا عِنْدَ النَّاسِ۔","Hasan","Musannaf Ibn Abi Shaybah 30625","","","كتاب فضائل القرآن"
"30626","(۳۰۶۲۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: اقَرَؤُوا الْقُرْآنَ وَسَلُوا اللَّہَ بِہِ فَإِنَّہُ سَیَقْرَؤُہُ أَقْوَامٌ یُقِیمُونَہُ إقَامَۃَ الْقَدَحِ یَتَعَجَّلُونَہُ ، وَلا یَتَأَجَّلُونَہُ۔n(ابوداؤد ۸۲۷۔ احمد ۳۳۸)","","Musannaf Ibn Abi Shaybah 30626","","","كتاب فضائل القرآن"
"30627","(۳۰۶۲۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ: حدَّثَنَا عَبْدُ اللہِ بْنُ الْوَلِیدِ ، قَالَ: أَخْبَرَنِی عُمَرُ بْنُ أَیُّوبَ ، قَالَ: أَخْبَرَنِی أَبُو إیَاسٍ مُعَاوِیَۃُ بْنُ قُرَّۃَ ، قَالَ: کُنْتُ نَازِلاً عَلَی عَمْرِو بْنِ النُّعْمَانِ بْنِ مُقَرِّنٍ ، فَلَمَّا حَضَرَ رَمَضَانُ جَائَہُ رَجُلٌ بِأَلْفَیْ دِرْہَمٍ مِنْ قِبَلِ مُصْعَبِ بْنِ الزُّبَیْرِ فَقَالَ: إنَّ الأَمِیرَ یُقْرِئُک السَّلامَ ، وَیَقُولُ: إنَّا لَمْ نَدَعَ قَارِئًا شَرِیفًا إِلاَّ وَقَدْ وَصَلَ إلَیْہِ مِنَّا مَعْرُوفٌ ، فَاسْتَعِنْ بِہَذَیْنِ عَلَی نَفَقَۃِ شَہْرِکَ ہَذَا ، فَقَالَ عَمْرٌو: اقْرَأْ عَلَی الأَمِیرِ السَّلامَ وَقُلْ لَہُ: إنا وَاللہ مَا قَرَأْنَا الْقُرْآنَ نُرِیدُ بِہِ الدُّنْیَا ، وَرُدَّہ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 30627","","","كتاب فضائل القرآن"
"30628","(۳۰۶۲۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَن سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی شُرَیْحٍ الْخُزَاعِیِّ ، قَالَ: خَرَجَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ: أَبْشِرُوا أَبْشِرُوا أَلَیْسَ تَشْہَدُونَ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ وَأَنِّی رَسُولُ اللہِ ؟ قَالُوا: نَعَمْ ، قَالَ: فَإِنَّ ہَذَا الْقُرْآنَ سَبَبٌ طَرَفُہُ بِیَدِ اللہِ وَطَرَفُہُ بِأَیْدِیکُمْ فَتَمَسَّکُوا بِہِ ، فَإِنَّکُمْ لَنْ تَضِلُّوا وَلَنْ تَہْلِکُوا بَعْدَہُ أَبَدًا۔ (ابن حبان ۱۲۲۔ عبد بن حمید ۴۸۳)","Hasan","Musannaf Ibn Abi Shaybah 30628","","","كتاب فضائل القرآن"
"30629","(۳۰۶۲۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن حَمْزَۃَ الزَّیَّاتِ ، عَنْ أَبِی الْمُخْتَارِ الطَّائِیِّ ، عَنِ ابْنِ أَخِی الْحَارِثِ الأَعْوَرِ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ: سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: کِتَابُ اللہِ فِیہِ خَبَرُ مَا قَبْلَکُمْ وَنَبَأُ مَا بَعْدَکُمْ وَحُکْمُ مَا بَیْنَکُمْ ، ہُوَ الْفَصْلُ لَیْسَ بِالْہَزْلِ ، ہُوَ الَّذِی لاَ تَزِیغُ بِہِ الأَہْوَائُ ، وَلا تَشْبَعُ مِنْہُ الْعُلَمَائُ ، وَلا یَخْلَقُ عَن کَثْرَۃِ رَدٍّ ، وَلا تَنْقَضِی عَجَائِبُہُ ، ہُوَ الَّذِی مَنْ تَرَکَہُ مِنْ جَبَّارٍ قَصَمَہُ اللَّہُ ، وَمَنِ ابْتَغَی الْہُدَی فِی غَیْرِہِ أَضَلَّہُ اللَّہُ ، ہُوَ حَبْلُ اللہِ الْمَتِینُ ،وَہُوَ الذِّکْرُ الْحَکِیمُ ،وَہُوَ الصِّرَاطُ الْمُسْتَقِیمُ ، ہُوَ الَّذِی مَنْ عَمِلَ بِہِ أُجِرَ ، وَمَنْ حَکَمَ بِہِ عَدَلَ ، وَمَنْ دَعَا إلَیْہِ دعا إِلَی صِرَاطٍ مُسْتَقِیمٍ ، خُذْہَا إلَیْک یَا أَعْوَرُ۔ (ترمذی ۲۹۰۶۔ احمد ۹۱)","Da'if","Musannaf Ibn Abi Shaybah 30629","","","كتاب فضائل القرآن"
"30630","(۳۰۶۳۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الْہَجَرِیِّ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ،قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إنَّ ہَذَا الْقُرْآنَ مَأْدُبَۃُ اللہِ فَتَعَلَّمُوا مِنْ مَأْدُبَۃِ اللہِ مَا اسْتَطَعْتُمْ ، إنَّ ہَذَا الْقُرْآنَ حَبْلُ اللہِ ،وَہُوَ النُّورُ الْبَیِّنُ ،وَالشِّفَائُ النَّافِعُ ، عِصْمَۃٌ لِمَنْ تَمَسَّکَ بِہِ ، وَنَجَاۃٌ لِمَنْ تَبِعَہُ ،لاَ یَعْوَجُّ فَیُقَوَّمُ ، وَلا یَزِیغُ فَیَسْتَعْتِبُ ، وَلا تَنْقَضِی عَجَائِبُہُ ، وَلا یَخْلَقُ عن کَثْرَۃِ الرَّدِّ۔ (حاکم ۵۵۵)","Da'if","Musannaf Ibn Abi Shaybah 30630","","","كتاب فضائل القرآن"
"30631","(۳۰۶۳۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا أَبَانُ بْنُ إِسْحَاقَ ، قَالَ: حَدَّثَنِی رَجُلٌ مِنْ بَجِیلَۃَ ، قَالَ: خَرَجَ جُنْدَبٌ الْبَجَلِیُّ فِی سَفَرٍ لَہُ ، قَالَ: فَخَرَجَ مَعَہُ نَاسٌ مِنْ قَوْمِہِ حَتَّی إذَا کَانُوا بِالْمَکَانِ الَّذِی یُوَدِّعُ بَعْضُہُمْ بَعْضًا ، قَالَ: أَیْ قَوْمِ ، عَلَیْکُمْ بِتَقْوَی اللہِ ، عَلَیْکُمْ بِہَذَا الْقُرْآنِ فَالْزَمُوہُ عَلَی مَا کَانَ مِنْ جَہْدٍ وَفَاقَۃٍ ، فَإِنَّہُ نُورٌ بِاللَّیْلِ الْمُظْلِمِ وَہُدًی بِالنَّہَارِ۔","Da'if","Musannaf Ibn Abi Shaybah 30631","","","كتاب فضائل القرآن"
"30632","(۳۰۶۳۲) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَن زَیْدِ بْنِ جُبَیْرٍ، قَالَ: قَالَ لِی أَبُو الْبَخْْتَرِیِّ الطَّائِیُّ: اتَّبِعْ ہَذَا الْقُرْآنَ فَإِنَّہُ یَہْدِیک۔","","Musannaf Ibn Abi Shaybah 30632","","","كتاب فضائل القرآن"
"30633","(۳۰۶۳۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَن ہَارُونَ بْنِ عَنْتَرَۃَ عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، قَالَ: قَالَ عَبْدُ اللہِ: إنَّ ہَذِہِ الْقُلُوبَ أَوْعِیَۃٌ فَاشْغَلُوہَا بِالْقُرْآنِ ، وَلا تَشْغَلُوہَا بِغَیْرِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30633","","","كتاب فضائل القرآن"
"30634","(۳۰۶۳۴) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ: قَالَ عَبْدُ اللہِ: إنَّ ہَذَا الْقُرْآنَ مَأْدُبَۃُ اللہ فمَنْ دَخَلَ فِیہِ ، فَہُوَ آمِنٌ۔","Sahih","Musannaf Ibn Abi Shaybah 30634","","","كتاب فضائل القرآن"
"30635","(۳۰۶۳۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن لَیْثٍ ، عَنْ شِہَابٍ ، قَالَ: قَالَ عُمَرُ: تَعَلَّمُوا کِتَابَ اللہِ ،تُعْرَفُوا بِہِ ،وَاعْمَلُوا بِہِ تَکُونُوا مِنْ أَہْلِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30635","","","كتاب فضائل القرآن"
"30636","(۳۰۶۳۶) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن زِیَادِ بْنِ مِخْرَاقٍ ، عَنْ أَبِی إیَاسٍ ، عَنْ أَبِی کِنَانَۃَ ، عَنْ أَبِی مُوسَی ، أَنَّہُ قَالَ: إنَّ ہَذَا الْقُرْآنَ کَائِنٌ لَکُمْ ذِکْرًا أو کَائِنٌ لَکُمْ أَجْرًا ، أَوْ کَائِنٌ عَلَیْکُمْ وِزْرًا ،فَاتَّبِعُوا الْقُرْآنَ ، وَلا یَتَّبِعْکُمُ الْقُرْآنُ ،فَإِنَّہُ مَنْ یَتَّبِعِ الْقُرْآنَ یَہْبِطْ بِہِ عَلَی رِیَاضِ الْجَنَّۃِ ، وَمَنْ یَتَّبِعْہُ الْقُرْآنُ یَزُخُّ فِی قَفَاہُ فَیَقْذِفُہُ فِی جَہَنَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 30636","","","كتاب فضائل القرآن"
"30637","(۳۰۶۳۷) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ: حدَّثَنَا الأَخْنَسُ بْنُ أَبِی الأَخْنَسِ ، عَن زُبَیْدٍ الْمُرَادِیِّ ، قَالَ: شَہِدْت ابْنَ مَسْعُودٍ وَقَامَ خَطِیبًا فَقَالَ: الْزَمُوا الْقُرْآنَ وَتَمَسَّکُوا بِہِ ، حَتَّی جَعَلَ یَقْبِضُ عَلَی یَدَیْہِ جَمِیعًا کَأَنَّہُ أَخَذَ بِسَبَبِ شَیْئٍ۔","Da'if","Musannaf Ibn Abi Shaybah 30637","","","كتاب فضائل القرآن"
"30638","(۳۰۶۳۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ عَنِ الأَعْمَشِ عَنْ خَیْثَمَۃ قَالَ: مَرَّتْ بِعِیسَی امْرَأَۃٌ ، فَقَالَتْ: طُوبَی لِبَطْنٍ حَمَلَک ، وَلِثَدْیٍ أَرْضَعَک ، قَالَ: فَقَالَ: عِیسَی طُوبَی لِمَنْ قَرَأَ الْقُرْآنَ وَاتَّبَعَ مَا فِیہِ۔","","Musannaf Ibn Abi Shaybah 30638","","","كتاب فضائل القرآن"
"30639","(۳۰۶۳۹) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِی ، عَن سُفْیَانَ ، عَنْ وَاصل عَنْ إِبْرَاہِیم قَالَ: مَرَّتِ امْرَأَۃٌ بِعِیسَی ابْنِ مَرْیَمَ ، ثُمَّ ذَکَرَ نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 30639","","","كتاب فضائل القرآن"
"30640","(۳۰۶۴۰) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَن مُغِیرَۃَ بِنْتِ حَسَّانَ قَالَتْ: سَمِعْت أَنَسًا یَقُولُ: {فَقَدِ اسْتَمْسَکَ بِالْعُرْوَۃِ الْوُثْقَی} ، قَالَ: الْقُرْآنُ۔","Da'if","Musannaf Ibn Abi Shaybah 30640","","","كتاب فضائل القرآن"
"30641","(۳۰۶۴۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَن مُرَّۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ: مَنْ أَرَادَ الْعِلْمَ فَلْیَقْرَإِ الْقُرْآنَ فَإِنَّ فِیہِ عِلْمَ الأَوَّلِینَ وَالآخِرِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 30641","","","كتاب فضائل القرآن"
"30642","(۳۰۶۴۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن خَیْثَمَۃَ ، عَنِ الأَسْوَدِ ، قَالَ: قَالَ عَبْدُ اللہِ: عَلَیْکُمْ بِالشِّفَائَیْنِ: الْقُرْآنِ وَالْعَسَلِ۔","Sahih","Musannaf Ibn Abi Shaybah 30642","","","كتاب فضائل القرآن"
"30643","(۳۰۶۴۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأحوص ، عَنْ عَبْدِ اللہِ ، قَالَ: الْعَسَلُ شِفَائٌ مِنْ کُلِّ دَائٍ ، وَالْقُرْآنُ شِفَائٌ لِمَا فِی الصُّدُورِ۔","Sahih","Musannaf Ibn Abi Shaybah 30643","","","كتاب فضائل القرآن"
"30644","(۳۰۶۴۴) حَدَّثَنَا الْمُحَارِبِیُّ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ (شِفَائٌ لِلنَّاسِ) قَالَ: الشِّفَائُ فِی الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30644","","","كتاب فضائل القرآن"
"30645","(۳۰۶۴۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی الأ[corrupt]حْوَصِ ، عَنْ عَبْدِ اللہِ ، قَالَ: الْبَیْتُ الَّذِی لاَ یُقْرَأُ فِیہِ الْقُرْآنُ کَمَثَلِ الْبَیْتِ الْخَرِبِ الَّذِی لاَ عَامِرَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30645","","","كتاب فضائل القرآن"
"30646","(۳۰۶۴۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبَّادٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ: الْبَیْتُ الَّذِی یُقْرَأُ فِیہِ الْقُرْآنُ تَحْضُرُہُ الْمَلائِکَۃُ وَتَخْرُجُ مِنْہُ الشَّیَاطِینُ وَیَتَّسِعُ بِأَہْلِہِ وَیَکْثُرُ خَیْرُہُ ، وَالْبَیْتُ الَّذِی لاَ یُقْرَأُ فِیہِ الْقُرْآنُ تَحْضُرُہُ الشَّیَاطِینُ ، وَتَخْرُجُ مِنْہُ الْمَلائِکَۃُ ، وَیَضِیقُ بِأَہْلِہِ وَیَقِلُّ خَیْرُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30646","","","كتاب فضائل القرآن"
"30647","(۳۰۶۴۷) حَدَّثَنَا عَبِیْدَۃُ ، عَنْ أَبِی الزَّعْرَائِ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ: سَمِعْتُ ابْنَ مَسْعُودٍ یَقُولُ: إنَّ أَصْفَرَ الْبُیُوتِ الیت الَّذِی صَفِرَ مِنْ کِتَابِ اللہِ۔","","Musannaf Ibn Abi Shaybah 30647","","","كتاب فضائل القرآن"
"30648","(۳۰۶۴۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن لَیْثٍ ، عَنِ ابْنِ سَابِطٍ ، قَالَ: إنَّ الْبُیُوتَ الَّتِی یُقْرَأُ فِیہَا الْقُرْآنُ لَتُضِیئُ لأَہْلِ السَّمَائِ کَمَا تُضِیئُ السَّمَائُ لأَہْلِ الأَرْضِ ، قَالَ: وَإِنَّ الْبَیْتَ الَّذِی لاَ یُقْرَأُ فِیہِ الْقُرْآنُ لَیَضِیقُ عَلَی أَہْلِہِ وَتَحْضُرُہُ الشَّیَاطِینُ وَتَنْفِرُ مِنْہُ الْمَلائِکَۃُ ، وَإِنَّ أَصْفَرَ الْبُیُوتِ لَبَیْتٌ صَفِرَ مِنْ کِتَابِ اللہِ۔","","Musannaf Ibn Abi Shaybah 30648","","","كتاب فضائل القرآن"
"30649","(۳۰۶۴۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ: کَانَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ إذَا دَخَلَ مَنْزِلَہُ قَرَأَ فِی زَوَایَاہُ آیَۃَ الْکُرْسِیِّ۔","","Musannaf Ibn Abi Shaybah 30649","","","كتاب فضائل القرآن"
"30650","(۳۰۶۵۰) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، قَالَ: حَدَّثَنَا ثَابِتٌ ، قَالَ: کَانَ أَبُو ہُرَیْرَۃَ یَقُولُ فی الْبَیْتُ إذَا تُلِیَ فِیہِ کِتَابُ اللہِ اتَّسَعَ بِأَہْلِہِ وَکَثُرَ خَیْرُہُ وَحَضَرَتْہُ الْمَلائِکَۃُ ، وَخَرَجَتْ مِنْہُ الشَّیَاطِینُ ، وَالْبَیْتُ إذا لَمْ یُتْلَ فِیہِ کِتَابُ اللہِ ضَاقَ بِأَہْلِہِ ، وَقَلَّ خَیْرُہُ ،وَحَضَرَتْہُ الشَّیَاطِینُ۔","","Musannaf Ibn Abi Shaybah 30650","","","كتاب فضائل القرآن"
"30651","(۳۰۶۵۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ وَحَفْص ، عَنِ الأَعْمَش ، عَن شقیق ، قَالَ: قَالَ عَبْدُ اللہِ: إنِّی قَدْ تَسَمَّعْتُ إِلَی الْقَرَأَۃِ فَوَجَدْتہمْ مُتَقَارِبِینَ فَاقْرَؤُوہُ کَمَا عَلِمْتُمْ ، وَإِیَّاکُمْ وَالتَّنَطُّعَ وَالاخْتِلافَ زَادَ أَبُو مُعَاوِیَۃَ: إنَّمَا ہُوَ کَقَوْلِ أَحَدِکُمْ ہَلُمَّ وَتَعَالَ۔","Sahih","Musannaf Ibn Abi Shaybah 30651","","","كتاب فضائل القرآن"
"30652","(۳۰۶۵۲) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ: اقْرَؤُوا الْقُرْآنَ صِبْیَانِیَّۃ وَلا تَنَطَّعُوا فِیہِ۔","","Musannaf Ibn Abi Shaybah 30652","","","كتاب فضائل القرآن"
"30653","(۳۰۶۵۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ ، عَن حَکِیمِ عَنْ جَابِرٍ ، قَالَ: قَالَ حُذَیْفَۃُ: إنَّ أَقْرَأَ النَّاسِ الْمُنَافِقُ الَّذِی لاَ یَدَعُ وَاوًا ، وَلا أَلِفًا ، یَلْفِت کَمَا تَلْفِت الْبَقَرُ أَلْسِنَتَہَا ، لاَ یُجَاوِزُ تَرْقُوَتَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30653","","","كتاب فضائل القرآن"
"30654","(۳۰۶۵۴) حَدَّثَنَا أَبُو أُسَامَۃَ، قَالَ: أَخْبَرَنِی الثَّوْرِیُّ، عَنِ الْحَسَنِ بْنِ عَمْرٍو عَن فُضَیْلٍ، عَنْ إبْرَاہِیمَ: کَانُوا یَکْرَہُونَ أَنْ یُعَلِّمُوا الصَّبِیَّ الْقُرْآنَ حَتَّی یَعْقِلَ۔","","Musannaf Ibn Abi Shaybah 30654","","","كتاب فضائل القرآن"
"30655","(۳۰۶۵۵) حَدَّثَنَا أَبُو أُسَامَۃَ حَدَّثَنِی الثَّوْرِیُّ، قَالَ: حدَّثَنَا أَسْلَمُ الْمُنْقِرِیُّ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی، عَنْ أَبِیہِ، عَن أُبَیٍّ، قَالَ: کِتَابُ اللہِ مَا اسْتَبَانَ مِنْہُ فَاعْمَلْ بِہِ ، وَمَا اشْتَبَہَ عَلَیْک فَآمِنْ بِہِ ،وَکِلْہُ إِلَی عَالِمِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30655","","","كتاب فضائل القرآن"
"30656","(۳۰۶۵۶) حَدَّثَنَا یَعْلَی ، قَالَ: حدَّثَنَا إسْمَاعِیلُ ، عَن زُبَیْدٍ ، قَالَ: قَالَ عَبْدُ اللہِ إنَّ لِلْقُرْآنِ مَنَارًا کَمَنَارِ الطَّرِیقِ ، فَمَا عَرَفْتُمْ فَتَمَسَّکُوا بِہِ ، وَمَا اشْتَبَہَ عَلَیْکُمْ فَذَرُوہُ۔","","Musannaf Ibn Abi Shaybah 30656","","","كتاب فضائل القرآن"
"30657","(۳۰۶۵۷) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِیہِ ، عَن بَعْضِ أَصْحَابِہِ ، عَنِ الرَّبِیعِ بْنِ خُثَیْمٍ ، قَالَ: اضْطَرُّوا ہَذَا الْقُرْآنَ إِلَی اللہِ وَرَسُولِہِ۔","","Musannaf Ibn Abi Shaybah 30657","","","كتاب فضائل القرآن"
"30658","(۳۰۶۵۸) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَن مُعَاذٍ ، أَنَّہُ قَالَ: أَمَّا الْقُرْآنُ فَمَنَارٌ کَمَنَارِ الطَّرِیقِ ، لاَ یَخْفَی عَلَی أَحَدٍ ، فَمَا عَرَفْتُمْ مِنْہُ فَلا تَسْأَلُوا عَنْہُ أَحَدًا ، وَمَا شَکَکْتُمْ فِیہِ فَکِلُوہُ إِلَی عَالِمہ۔","Hasan","Musannaf Ibn Abi Shaybah 30658","","","كتاب فضائل القرآن"
"30659","(۳۰۶۵۹) حَدَّثَنَا وَکِیعٌ ، عَن ہِشَامٍ الدَّسْتَوَائِیِّ ، عَن قَتَادَۃَ ، عَن زُرَارَۃَ بْنِ أَوْفَی ، عَن سَعْدِ بْنِ ہِشَامٍ ، عَنْ عَائِشَۃَ قَالَتْ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: الَّذِی یَقْرَأُ الْقُرْآنَ وَہُوَ مَاہِرٌ بِہِ مَعَ السَّفَرَۃِ الْکِرَامِ الْبَرَرَۃِ ، وَالَّذِی یَقْرَؤُہُ وَہُوَ یَشْتَدُّ عَلَیْہِ لَہُ أَجْرَانِ۔ (بخاری ۴۹۳۷۔ مسلم ۲۴۴)","Sahih","Musannaf Ibn Abi Shaybah 30659","","","كتاب فضائل القرآن"
"30660","(۳۰۶۶۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ: الَّذِی یَہُونُ عَلَیْہِ الْقُرْآنُ مَعَ السَّفَرَۃِ الْکِرَامِ ، وَالَّذِی یَنْفَلِتُ مِنْہُ وَیَشُقُّ عَلَیْہِ لَہُ عِنْدَ اللہِ أَجْرَانِ۔","","Musannaf Ibn Abi Shaybah 30660","","","كتاب فضائل القرآن"
"30661","(۳۰۶۶۱) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَن قَتَادَۃَ ، عَنْ أَنَسٍ ، أَنَّہُ کَانَ إذَا خَتَمَ جَمَعَ أَہْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30661","","","كتاب فضائل القرآن"
"30662","(۳۰۶۶۲) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ: یُذْکَرُ ، أَنَّہُ یُصَلَّی عَلَیْہِ إذَا خَتَمَ۔","","Musannaf Ibn Abi Shaybah 30662","","","كتاب فضائل القرآن"
"30663","(۳۰۶۶۳) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنِ الْحَکَمِ ، قَالَ: کَانَ مُجَاہِدٌ ، وَعَبْدَۃُ بْنُ أَبِی لُبَابَۃَ وَنَاسٌ یَعْرِضُونَ الْمَصَاحِفَ ، فَلَمَّا کَانَ الْیَوْمُ الَّذِی أَرَادُوا أَنْ یَخْتِمُوا أَرْسَلُوا إلَیَّ وَإِلَی سَلَمَۃَ بْنِ کُہَیْلٍ فَقَالُوا: إنَّا کُنَّا نَعْرِضُ الْمَصَاحِفَ فَأَرَدْنَا أَنْ نَخْتِمَ الْیَوْمَ فَأَحْبَبْنَا أَنْ تَشْہَدُونَا ، إِنَّہُ کَانَ یُقَالُ: إذَا خُتِمَ الْقُرْآنُ نَزَلَتِ الرَّحْمَۃُ عِنْدَ خَاتِمَتِہِ ، أَوْ حَضَرَتِ الرَّحْمَۃُ عِنْدَ خَاتِمَتِہِ۔","","Musannaf Ibn Abi Shaybah 30663","","","كتاب فضائل القرآن"
"30664","(۳۰۶۶۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ بْنِ حَوْشَبٍ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، أَنَّہُ کَانَ یَخْتِمُ الْقُرْآنَ فِی ثَلاثٍ ، وَیُصْبِحُ الْیَوْمَ الَّذِی یَخْتِمُ فِیہِ صَائِمًا۔","","Musannaf Ibn Abi Shaybah 30664","","","كتاب فضائل القرآن"
"30665","(۳۰۶۶۵) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَن مَنْصُورٍ، عَنِ الْحَکَمِ، عَن مُجَاہِدٍ، قَالَ: الرَّحْمَۃُ تَنْزِلُ عِنْدَ خَتْمِ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30665","","","كتاب فضائل القرآن"
"30666","(۳۰۶۶۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنِ التَّیْمِیِّ ، عَن رَجُلٍ ، عَنْ أَبِی الْعَالِیَۃِ ، أَنَّہُ کَانَ إذَا أَرَادَ أَنْ یَخْتِمَ الْقُرْآنَ مِنْ آخِرِ النَّہَارِ أَخَّرَہُ إِلَی أَنْ یُمْسِی ، وَإِذَا أَرَادَ أَنْ یَخْتِمَہُ مِنْ آخِرِ اللَّیْلِ أَخَّرَہُ إِلَی أَنْ یُصْبِحَ۔","","Musannaf Ibn Abi Shaybah 30666","","","كتاب فضائل القرآن"
"30667","(۳۰۶۶۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ ، سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقول: یُمَثَّلُ الْقُرْآنُ یَوْمَ الْقِیَامَۃِ رَجُلاً فَیُؤْتَی بِالرَّجُلِ قَدْ حَمَلَہُ فَخَالَفَ فی أَمْرِہِ فَیَتَمَثَّلُ خَصْمًا لَہُ فَیَقُولُ: یَا رَبِّ حَمَّلْتہ إیَّایَ فَشَرُّ حَامِلٍ تَعَدَّی حُدُودِی وَضَیَّعَ فَرَائِضِی ، وَرَکِبَ مَعْصِیَتِی وَتَرَکَ طَاعَتِی ، فَمَا یَزَالُ یَقْذِفُ عَلَیْہِ بِالْحُجَجِ حَتَّی یُقَالَ: فَشَأْنُک بِہِ ، فَیَأْخُذُ بِیَدِہِ ، فَمَا یُرْسِلُہُ حَتَّی یَکُبَّہُ عَلَی صَخْرَۃٍ فِی النَّارِ ، وَیُؤْتَی بِرَجُلٍ صَالِحٍ قَدْ کَانَ حَمَلَہُ وَحَفِظَ أَمْرَہُ فَیَتَمَثَّلُ خَصْمًا دُونَہُ فَیَقُولُ: یَا رَبِّ حَمَّلْتہ إیَّایَ فَخَیْرُ حَامِلٍ ، حَفِظَ حُدُودِی وَعَمِلَ بِفَرَائِضِی وَاجْتَنَبَ مَعْصِیَتِی وَاتَّبَعَ طَاعَتِی ، فَمَا یَزَالُ یَقْذِفُ لَہُ بِالْحُجَجِ حَتَّی یُقَالَ: شَأْنُک بِہِ ، فَیَأْخُذُ بِیَدِہِ فَمَا یُرْسِلُہُ حَتَّی یُلْبِسَہُ حُلَّۃَ الإِسْتَبْرَقِ وَیَعْقِدَ عَلَیْہِ تَاجَ الْمُلْکِ وَیَسْقِیَہُ کَأْسَ الْخَمْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 30667","","","كتاب فضائل القرآن"
"30668","(۳۰۶۶۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ: حدَّثَنَا بَشِیرُ بْنُ الْمُہَاجِرِ ، قَالَ:حَدَّثَنِی عَبْدُ اللہِ بْنُ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ: کُنْتُ عِنْدَ النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَمِعْتہ یَقُولُ: إنَّ الْقُرْآنَ یَلْقَی صَاحِبَہُ یَوْمَ الْقِیَامَۃِ حِینَ یَنْشَقُّ عَنْہُ قَبْرُہُ کَالرَّجُلِ الشَّاحِبِ فیَقُولُ لَہُ: ہَلْ تَعْرِفُنِی ؟ فَیَقُولُ: مَا أَعْرِفُک ، فَیَقُولُ لَہُ: أَنَا صَاحِبُک الْقُرْآنُ الَّذِی أَظْمَأْتُک فِی الْہَوَاجِر ،وَأَسْہَرْت لَیْلَک ، وَإِنَّ کُلَّ تَاجِرٍ مِنْ وَرَائِ تِجَارَتِہِ ، وَإِنَّک الْیَوْمَ مِنْ وَرَائِ کُلِّ تِجَارَۃٍ ، قَالَ: فَیُعْطَی الْمُلْکَ بِیَمِینِہِ وَالْخُلْدَ بِشِمَالِہِ ، وَیُوضَعُ عَلَی رَأْسِہِ تَاجُ الْوَقَارِ ، وَیُکْسَی وَالِدَاہُ حُلَّتَیْنِ ، لاَ یَقُومُ لَہُمَا أَہْلُ الدُّنْیَا ، فَیَقُولانِ: بِمَ کُسِینَا ہَذَا ؟ قَالَ: فَیُقَالُ لَہُمَا: بِأَخْذِ وَلَدِکُمَا الْقُرْآنَ ، ثُمَّ یُقَالُ لَہُ: اقْرَأْ وَاصْعَدْ فِی دَرَجِ الْجَنَّۃِ وَغُرَفِہَا ، فَہُوَ فِی صُعُودٍ مَا دَامَ یَقْرَأُ ہَذًّا کَانَ ، أَوْ تَرْتِیلاً۔ (ابن ماجہ ۳۷۸۱۔ احمد ۳۵۲)","Da'if","Musannaf Ibn Abi Shaybah 30668","","","كتاب فضائل القرآن"
"30669","(۳۰۶۶۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ: حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃَ الرَّبَذِیُّ ، قَالَ: حَدَّثَنَا سَعِیدُ بْنُ أَبِی سَعِیدٍ الْمَقْبُرِیُّ ، عَن عُثْمَانَ بْنِ الْحَکَمِ ، عَن کَعْبٍ ، أَنَّہُ قَالَ: یُمَثَّلُ الْقُرْآنُ لِمَنْ کَانَ یَعْمَلُ بِہِ فِی الدُّنْیَا یَوْمَ الْقِیَامَۃِ کَأَحْسَنِ صُورَۃٍ رَآہَا وَأَحْسَنِہَا وَجْہًا وَأَطْیَبِہَا رِیحًا فَیَقُومُ بِجَنْبِ صَاحِبِہِ فَکُلَّمَا جَائَہُ رَوْعٌ ہَدَّأَ رَوْعَہُ وَسَکَّنَہُ وَبَسَطَ لَہُ أَمَلَہُ فَیَقُولُ لَہُ: جَزَاک اللَّہُ خَیْرًا مِنْ صَاحِبٍ ، فَمَا أَحْسَنَ صُورَتَکَ وَأَطْیَبَ رِیحَک، فَیَقُولُ لَہُ: أَمَا تَعْرِفُنِی: تَعَالَ ارْکَبْنِی ، فَطَالَمَا رَکِبْتُک فِی الدُّنْیَا ، أَنَا عَمَلُک ، إنَّ عَمَلَک کَانَ حَسَنًا ، فَتَرَی صُورَتِی حَسَنَۃً ، وَکَانَ طَیِّبًا فَتَرَی رِیحِی طَیِّبَۃً ، فَیَحْمِلُہُ فَیُوَافِی بِہِ الرَّبَّ تَبَارَکَ وَتَعَالَی فَیَقُولُ: یَا رَبِّ ہَذَا فُلانٌ وَہُوَ أَعْرَفُ بِہِ مِنْہُ قَدْ شَغَلْتہ فِی أَیَّامِہِ فِی حَیَاتِہِ فِی الدُّنْیَا ، أَظْمَأْت نَہَارَہُ وَأَسْہَرْت لَیْلَہُ ، فَشَفِّعْنِی فِیہِ ، فَیُوضَعُ تَاجُ الْمُلْکِ عَلَی رَأْسِہِ ، وَیُکْسَی حُلَّۃَ الْمُلْک ، فَیَقُولُ: یَا رَبِّ قَدْ کُنْت أَرْغَبُ لَہُ عَن ہَذَا وَأَرْجُو لَہُ مِنْک أَفْضَلَ مِنْ ہَذَا ، فَیُعْطَی الْخُلْدَ بِیَمِینِہِ وَالنِّعْمَۃَ بِشِمَالِہِ ، فَیَقُولُ: یَا رَبّ إنَّ کُلَّ تَاجِرٍ قَدْ دَخَلَ عَلَی أَہْلِہِ مِنْ تِجَارَتِہِ ، فَیُشَفَّعُ فِی أَقَارِبِہِ ، وَإِذا کَانَ کَافِرًا مُثِّلَ لَہُ عَمَلُہُ فِی أَقْبَحِ صُورَۃٍ رَآہَا ،وَأَنْتَنَہُ ،فَکُلَّمَا جَائَہُ رَوْعٌ زَادَہُ رَوْعًا فَیَقُولُ: قَبَّحَک اللَّہُ مِنْ صَاحِبٍ فَمَا أَقْبَحَ صُورَتَکَ، وَمَا أَنْتَنَ رِیحَک ، فَیَقُولُ: مَنْ أَنْتَ ؟ قَالَ: أَمَا تَعْرِفُنِی ، أَنَا عَمَلُک ، إنَّہ کَانَ قَبِیحًا فَتَرَی صُورَتِی قَبِیحَۃً ، وَکَانَ مُنْتِنًا فَتَرَی رِیحِی مُنْتِنَۃً ، فَیَقُولُ: تَعَالَ حتی أَرْکَبُک ، فَطَالَمَا رَکِبْتنِی فِی الدُّنْیَا ، فَیَرْکَبُہُ فَیُوَافِی بِہِ اللَّہَ فَلا یُقِیمُ لَہُ وَزْنًا۔","Hasan","Musannaf Ibn Abi Shaybah 30669","","","كتاب فضائل القرآن"
"30670","(۳۰۶۷۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: نِعْمَ الشَّفِیعُ الْقُرْآنُ یَوْمَ الْقِیَامَۃِ ، قَالَ: یَقُولُ: یَا رَبِّ قَدْ کُنْت أَمْنَعُہُ شَہْوَتَہُ فِی الدُّنْیَا فَأَکْرِمْہُ ، قَالَ: فَیُلْبَسُ حُلَّۃَ الْکَرَامَۃِ ، قَالَ: فَیَقُولُ: أَیْ رَبِّ زِدْہُ ، قَالَ: فَیُحَلَّی حُلَّۃَ الْکَرَامَۃِ فَیَقُولُ أَیْ رَبِّ زِدْہُ ، قَالَ: فَیُکْسَی تَاجَ الْکَرَامَۃِ ، قَالَ: فَیَقُولُ: یَا رَبِّ زِدْہُ ، قَالَ: فَیَرْضَی مِنْہُ فَلَیْسَ بَعْدَ رِضَی اللہِ عَنْہُ شَیْئٌ۔ (ترمذی ۲۹۱۵)","Sahih","Musannaf Ibn Abi Shaybah 30670","","","كتاب فضائل القرآن"
"30671","(۳۰۶۷۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ أَبِی صَالِحٍ ، قَالَ: یَشْفَعُ الْقُرْآنُ لِصَاحِبِہِ یَوْمَ الْقِیَامَۃِ فَیُکْسَی حُلَّۃَ الْکَرَامَۃِ فَیَقُولُ: أَیْ رَبِّ زِدْہُ ، فَإِنَّہُ فَإِنَّہُ ، قَالَ: فَیُکْسَی تَاجَ الْکَرَامَۃِ ، قَالَ: فَیَقُولُ: أَیْ رَبِّ زِدْہُ فَإِنَّہُ فَإِنَّہُ ، فَیَقُولُ: رِضَای۔","","Musannaf Ibn Abi Shaybah 30671","","","كتاب فضائل القرآن"
"30672","(۳۰۶۷۲) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَن مُجَاہِدٍ ، أَنَّہُ قَالَ: الْقُرْآنُ یَشْفَعُ لِصَاحِبِہِ یَوْمَ الْقِیَامَۃِ یَقُولُ: یَا رَبِّ جَعَلْتنِی فِی جَوْفِہِ فَأَسْہَرْت لَیْلَہُ وَمَنَعْتہ من کَثِیرٍ مِنْ شَہَوَاتِہِ ، وَلِکُلِّ عَامِلٍ مِنْ عَمَلِہِ عِمَالَۃٌ ، فَیُقَالُ لَہُ ابْسُطْ یَدَک ، قَالَ فَتُمْلأ مِنْ رِضْوَان اللہ ، فَلا سَخَطٌ عَلَیْہِ بَعْدَہُ ، ثُمَّ یُقَالُ لَہُ: اقْرَأْ وَارْقَہُ ، قَالَ: فَیُرْفَعُ لَہُ بِکُلِّ آیَۃٍ دَرَجَۃٌ وَیُزَادُ بِکُلِّ آیَۃٍ حَسَنَۃٌ۔","","Musannaf Ibn Abi Shaybah 30672","","","كتاب فضائل القرآن"
"30673","(۳۰۶۷۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، قَالَ: قَالَ مَنْصُورٌ: حُدِّثْت عَن مُجَاہِدٍ ، قَالَ: یَجِیئُ الْقُرْآنُ یَوْمَ الْقِیَامَۃِ بَیْنَ یَدَیْ صَاحِبِہِ حَتَّی إذَا انْتَہَیَا إِلَی رَبِّہِمَا قَالَ الْقُرْآنُ: یَا رَبِّ ، إِنَّہُ لَیْسَ مِنْ عَامِلٍ إِلاَّ لَہُ مِنْ عِمَالَتِہِ نَصِیبٌ ،وَإِنَّک جَعَلْتنِی فِی جَوْفِہِ فَکُنْت أَنْہَاہُ عَن شَہَوَاتِہِ ، قَالَ: فَیُقَالُ لَہُ: ابْسُطْ یَمِینَک ، قَالَ: فَتُمْلأَ مِنْ رِضْوَانِ اللہِ ، ثُمَّ یُقَالُ لَہُ: ابْسُطْ شِمَالَک ، فَتُمْلأَ مِنْ رِضْوَانِ اللہِ ، فَلا یَسْخَطُ اللہ عَلَیْہِ بَعْدَ ذَلِکَ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 30673","","","كتاب فضائل القرآن"
"30674","(۳۰۶۷۴) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَن مُجَاہِدٍ فِی قَوْلِہِ {وَالَّذِی جَائَ بِالصِّدْقِ وَصَدَّقَ بِہِ} ، قَالَ: الَّذِینَ یَجِیئُونَ بِالْقُرْآنِ یَوْمَ الْقِیَامَۃِ فَیَقُولُونَ: ہَذَا الَّذِی أَعْطَیْتُمُونَا قَدِ اتَّبَعْنَا مَا فِیہِ۔","","Musannaf Ibn Abi Shaybah 30674","","","كتاب فضائل القرآن"
"30675","(۳۰۶۷۵) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَن مَنْصُورٍ ، عَنْ أَبِی جَعْفَرٍ ، عَن زَاذَانَ ، قَالَ: یُقَالُ: إنَّ الْقُرْآنَ شَافِعٌ مُشَفَّعٌ وَمَاحِلٌ مُصَدَّقٌ۔","","Musannaf Ibn Abi Shaybah 30675","","","كتاب فضائل القرآن"
"30676","(۳۰۶۷۶) حَدَّثَنَا عَفَّانُ، قَالَ: حدَّثَنَا ہَمَّامٌ، قَالَ: حَدَّثَنَا عَاصِمُ بْنُ بَہْدَلَۃَ، عَنِ الشَّعْبِیِّ، عَنِ ابْنِ مَسْعُودٍ، قَالَ: یَجِیئُ الْقُرْآنُ یَوْمَ الْقِیَامَۃِ فَیَشْفَعُ لِصَاحِبِہِ فَیَکُونُ قَائِدًا إِلَی الْجَنَّۃِ ، أو یَشْہَدُ عَلَیْہِ فَیَکُونُ سَائِقًا لَہُ إ[corrupt]لَی النَّارِ۔","","Musannaf Ibn Abi Shaybah 30676","","","كتاب فضائل القرآن"
"30677","(۳۰۶۷۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، عَن زُبَیْدٍ ، قَالَ: قَالَ عَبْدُ اللہِ: الْقُرْآنُ شَافِعٌ مُشَفَّعٌ ومَاحِلٌ مُصَدَّقٌ ، فَمَنْ جَعَلَہُ إمَامَہُ قَادَہُ إِلَی الْجَنَّۃِ ، وَمَنْ جَعَلَہُ خَلْفَ ظَہْرِہِ قَادَہُ إِلَی النَّارِ۔n(بزار ۱۲۲۔ ابن حبان ۱۲۲)","","Musannaf Ibn Abi Shaybah 30677","","","كتاب فضائل القرآن"
"30678","(۳۰۶۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی سَعِیدٍ ، أَوْ عَنْ أَبِی ہُرَیْرَۃَ شَکَّ الأَعْمَشُ ، قَالَ: یُقَالُ لِصَاحِبِ الْقُرْآنِ: یَوْمَ الْقِیَامَۃِ اقْرَأْ وَارْقَہُ ، فإن مَنْزِلُک عِنْدَ آخِرِ آیَۃٍ تَقْرَؤُہَا۔","Da'if","Musannaf Ibn Abi Shaybah 30678","","","كتاب فضائل القرآن"
"30679","(۳۰۶۷۹) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو بِمِثْلِہِ ، وَزَادَ فِیہِ: وَرَتِّلْ کَمَا کُنْت تُرَتِّلُ فِی الدُّنْیَا۔ (ابوداؤد ۱۴۵۹۔ ترمذی ۲۹۱۴)","Da'if","Musannaf Ibn Abi Shaybah 30679","","","كتاب فضائل القرآن"
"30680","(۳۰۶۸۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ: یُقَالُ لِصَاحِبِ الْقُرْآنِ حِینَ یَدْخُلُ الْجَنَّۃَ اقْرَأْ وَارْقَہُ فِی الدَّرَجَاتِ وَرَتِّلْ کَمَا کُنْت تُرَتِّلُ فِی الدُّنْیَا فَإِنَّ مَنْزِلَک من الدَّرَجَاتِ عِنْدَ آخِرِ مَا تَقْرَأُ۔","Da'if","Musannaf Ibn Abi Shaybah 30680","","","كتاب فضائل القرآن"
"30681","(۳۰۶۸۱) حَدَّثَنَا غُنْدَرٌ ، حَدَّثَنَا شُعْبَۃُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَن مُجَاہِدٍ ، قَالَ: یُقَالُ: اقْرَأْ وَارْقَہُ ، قَالَ: فَیُرْفَعُ لَہُ بِکُلِّ آیَۃٍ دَرَجَۃٌ وَیُزَادُ بِکُلِّ آیَۃٍ حَسَنَۃٌ۔","","Musannaf Ibn Abi Shaybah 30681","","","كتاب فضائل القرآن"
"30682","(۳۰۶۸۲) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ أَبِی الضُّحَی ، قَالَ: کَانَ الضَّحَّاکُ بْنُ قَیْسٍ یَقُولُ: یَا أَیُّہَا النَّاسُ عَلِّمُوا أَوْلادَکُمْ وَأَہَالِیکُمَ الْقُرْآنَ فَإِنَّہُ مَنْ کُتِبَ لَہُ مِنْ مُسْلِمٍ یُدْخِلُہُ اللَّہُ الْجَنَّۃَ أَتَاہُ مَلَکَانِ فَاکْتَنَفَاہُ فَقَالا لَہُ: إقرأ وَارْتَقِ فِی دَرَجِ الْجَنَّۃِ حَتَّی یَنْزِلانہِ حَیْثُ انْتَہَی عِلْمُہُ مِنَ الْقُرْآنِ۔","Sahih","Musannaf Ibn Abi Shaybah 30682","","","كتاب فضائل القرآن"
"30683","(۳۰۶۸۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن شُعْبَۃَ ، عَن قَتَادَۃَ ، قَالَ: سَمِعْتُ أَنَسًا یَقُولُ: قَرَأَہُ مُعَاذٌ وَأُبَیُّ وَسَعْدٌ ، وَأَبُو زَیْدٍ ، قَالَ: قُلْتُ: مَنْ أَبُو زَیْدٍ قَالَ أَحَدُ عُمُومَتِی عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔n(بخاری ۳۸۱۰۔ مسلم ۱۹۱۴)","Sahih","Musannaf Ibn Abi Shaybah 30683","","","كتاب فضائل القرآن"
"30684","(۳۰۶۸۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ: قَرَؤُوا الْقُرْآنِ فِی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُبَیٌّ وَمُعَاذٌ وَزَیْدٌ ، وَأَبُو زَیْدٍ ، وَأَبُو الدَّرْدَائِ وَسَعِیدُ بْنُ عُبَیْدٍ ، وَلَمْ یَقْرَأْہ أَحَدٌ مِنَ الْخُلَفَائِ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلاَّ عُثْمَانُ ، وَقَرَأَہُ مُجَمِّعُ ابْنُ جَارِیَۃَ إِلاَّ سُورَۃً ، أَوْ سُورَتَیْنِ۔n(ابن سعد ۳۵۵۔ طبرانی ۲۰۹۲)","","Musannaf Ibn Abi Shaybah 30684","","","كتاب فضائل القرآن"
"30685","(۳۰۶۸۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، قَالَ: جَائَ مُعَاذٌ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ: یَا رَسُولَ اللہِ أَقْرِئْنِی ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: یا عبد اللہ أَقْرِئْہُ ، فَأَقْرَأْتہ مَا کَانَ مَعِی ، ثُمَّ اخْتَلَفْت أَنَا وَہُوَ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَرَأَہُ مُعَاذٌ ، وَکَانَ مُعَلِّمًا مِنَ الْمُعَلِّمِینَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 30685","","","كتاب فضائل القرآن"
"30686","(۳۰۶۸۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَن خمیر بْنِ مَالِکٍ ، عَنْ عَبْدِ اللہِ ، قَالَ: قرَأْت مِنْ فِی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَبْعِینَ سُورَۃً وَإِنَّ زَیْدَ بْنَ ثَابِتٍ لَہُ ذُؤَابَتَانِ فِی الْکتابِ۔ (احمد ۳۸۹)","Da'if","Musannaf Ibn Abi Shaybah 30686","","","كتاب فضائل القرآن"
"30687","(۳۰۶۸۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: جَمَعْت الْمُحْکَمَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَعْنِی الْمُفَصَّلَ۔ (بخاری ۵۰۳۶۔ احمد ۳۳۷)","Sahih","Musannaf Ibn Abi Shaybah 30687","","","كتاب فضائل القرآن"
"30688","(۳۰۶۸۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن ہِشَامٍ ، عَن مُحَمَّدٍ ، قَالَ: کَانَ أَصْحَابُنَا لاَ یَخْتَلِفُونَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قُبِضَ وَلَمْ یَقْرَأَ الْقُرْآنَ مِنْ أَصْحَابِہِ إِلاَّ أَرْبَعَۃٌ کُلُّہُمْ مِنَ الأَنْصَارِ: مُعَاذُ بْنُ جَبَلٍ وَأُبَیُّ بْنُ کَعْبٍ وَزَیْدٌ ، وَأَبُو زَیْدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30688","","","كتاب فضائل القرآن"
"30689","(۳۰۶۸۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن حَجَّاجٍ ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ فِی قول اللہ تعالی (قُلْ بِفَضْلِ اللہِ وَبِرَحْمَتِہِ فَبِذَلِکَ فَلْیَفْرَحُوا) قَالَ: (بِفَضْلِ اللہِ) الْقُرْآنُ ، (وَبِرَحْمَتِہِ) أَنْ جُعِلْتُمْ مِنْ أَہْلِہِ ۔","Da'if","Musannaf Ibn Abi Shaybah 30689","","","كتاب فضائل القرآن"
"30690","(۳۰۶۹۰) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَن ہِلالٍ ، عَن مَنْصُورٍ ، عَن ہِلالِ بْنِ یَِسَافٍ فِی قَوْلِہِ: {قُلْ بِفَضْلِ اللہِ وَبِرَحْمَتِہِ فَبِذَلِکَ فَلْیَفْرَحُوا ہُوَ خَیْرٌ مِمَّا یَجْمَعُونَ}۔قَالَ: کِتَابُ اللہِ وَالإِسْلامُ ہُوَ خَیْرٌ مِمَّا یَجْمَعُونَ۔","","Musannaf Ibn Abi Shaybah 30690","","","كتاب فضائل القرآن"
"30691","(۳۰۶۹۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَنْ عَطِیَّۃَ ، عَنِ ابْنِ عَبَّاسٍ فِی قَوْلِ اللہِ قُلْ بِفَضْلِ اللہِ وَبِرَحْمَتِہِ ، قَالَ: بِفَضْلِ اللہِ: الإِسْلامُ ، وَبِرَحْمَتِہِ: أَنْ جَعَلَکُمْ مِنْ أَہْلِ الْقُرْآنِ۔","Da'if","Musannaf Ibn Abi Shaybah 30691","","","كتاب فضائل القرآن"
"30692","(۳۰۶۹۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَنِ الْقَاسِمِ ، عَن مُجَاہِدٍ ، قَالَ: الْقُرْآنُ۔","","Musannaf Ibn Abi Shaybah 30692","","","كتاب فضائل القرآن"
"30693","(۳۰۶۹۳) حَدَّثَنَا أَبُو خَالِدٍ، عَنْ عَمْرِو بْنِ قَیْسٍ، عَن مَنْصُورٍ، عَن سَالِمٍ، قَالَ: بِفَضْلِ اللہِ وَبِرَحْمَتِہِ الإِسْلامُ وَالْقُرْآنُ۔","","Musannaf Ibn Abi Shaybah 30693","","","كتاب فضائل القرآن"
"30694","(۳۰۶۹۴) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ: حدَّثَنَا شُعْبَۃُ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، قَالَ ، عَن سَعْدِ بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَن عُثْمَانَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: خِیَارُکُمْ مَنْ تَعَلَّمَ الْقُرْآنَ وَعَلَّمَہُ۔ (بخاری ۵۰۲۷۔ ابوداؤد ۱۴۴۷)","Sahih","Musannaf Ibn Abi Shaybah 30694","","","كتاب فضائل القرآن"
"30695","(۳۰۶۹۵) حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ زِیَادٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ النُّعْمَانِ بْنِ سَعْدٍ ، عَنْ عَلِیٍّ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: خِیَارُکُمْ مَنْ تَعَلَّمَ الْقُرْآنَ وَعَلَّمَہُ۔n(ترمذی ۲۹۰۹۔ دارمی ۳۳۳۷)","Da'if","Musannaf Ibn Abi Shaybah 30695","","","كتاب فضائل القرآن"
"30696","(۳۰۶۹۶) حَدَّثَنَا وَکِیعٌ قَالَ: حَدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أَیُحِبُّ أَحَدُکُمْ إذَا رَجَعَ إِلَی أَہْلِہِ أَنْ یَجِدَ فِیہِ ثَلاثَ خَلِفَاتٍ عِظَامٍ سِمَانٍ ، قَالَ: قُلْنَا: نَعَمْ ، قَالَ: فثلاث آیَاتٍ یَقْرَأُ بِہِنَّ أَحَدُکُمْ فِی صَلاتِہِ خَیْرٌ لَہُ مِنْ ثَلاثِ خَلِفَاتٍ سِمَانٍ عِظَامٍ۔n(مسلم ۵۵۲۔ احمد ۴۶۶)","Sahih","Musannaf Ibn Abi Shaybah 30696","","","كتاب فضائل القرآن"
"30697","(۳۰۶۹۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ: حدَّثَنَا مُوسَی بْنُ عُلَیٍّ ، قَالَ: سَمِعْتُ أَبِی یُحَدِّثُ ، عَن عُقْبَۃَ بْنِ عَامِرٍ ، قَالَ: خَرَجَ إلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَنَحْنُ فِی الصُّفَّۃِ فَقَالَ: أَیُّکُمْ یُحِبُّ أَنْ یَغْدُوَ کُلَّ یَوْمٍ إِلَی بطْحَانَ ، أَو الْعَقِیقِ فَیَأْتِیَ مِنْہُ بِنَاقَتَیْنِ کَوْمَاوَیْنِ فِی غَیْرِ إِثْمَ وَلا قَطِیعَۃِ رَحِمٍ قُلْنَا: یَا رَسُولَ اللہِ ، کُلُّنَا نُحِبُّ ذَلِکَ ، قَالَ: فَلأَنْ یَغْدُو أَحَدُکُمْ إِلَی الْمَسْجِدِ فَیُعَلِّمُ ، أَوْ یَقْرَأُ آیَتَیْنِ مِنْ کِتَابِ اللہِ خَیْرٌ لَہُ مِنْ نَاقَتَیْنِ وَثَلاثٍ خَیْرٌ لَہُ مِنْ ثلاث ، وَأَرْبَعٌ خَیْرٌ لَہُ مِنْ أَرْبَعٍ وَمِثْل أَعْدَادِہِنَّ مِنَ الإِبِلِ۔ (ابوداؤد ۱۴۵۱۔ احمد ۱۵۴)","Sahih","Musannaf Ibn Abi Shaybah 30697","","","كتاب فضائل القرآن"
"30698","(۳۰۶۹۸) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ: أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، قَالَ: لَوْ جُعِلَ لأَحَدٍ خَمْسُ قَلائِصَ إِنْ صَلَّی الْغَدَاۃَ بالقریۃ لَبَاتَ یَقُولُ لأَہْلِہِ: لَقَدْ أَنَی لِی أَنْ أَنْطَلِقَ ، وَاللہ لأَنْ یَقْعُدُ أَحَدُکُمْ فَیَتَعَلَّمُ خَمْسَ آیَاتٍ مِنْ کِتَابِ اللہِ فَلَہُنَّ خَیْرٌ لَہُ مِنْ خَمْسِ قَلائِصَ وَخَمْسِ قَلائِصَ۔","Sahih","Musannaf Ibn Abi Shaybah 30698","","","كتاب فضائل القرآن"
"30699","(۳۰۶۹۹) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ: أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ: کَانَ یُقْرِیء الْقُرْآنَ فَیَمُرُّ بِالآیَۃِ فَیَقُولُ لِلرَّجُلِ: خُذْہَا فَوَاللہ لَہِیَ خَیْرٌ مِمَّا عَلَی الأَرْضِ مِنْ شَیْئٍ ، قَالَ: فَیَرَی الرَّجُلُ أَنَّمَا یَعْنِی تِلْکَ الآیَۃَ حَتَّی یَفْعَلَہُ بِالْقَوْمِ کُلِّہِمْ۔ (عبدالرزاق ۵۹۹۲)","","Musannaf Ibn Abi Shaybah 30699","","","كتاب فضائل القرآن"
"30700","(۳۰۷۰۰) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: تَرَکْت فِیکُمْ مَا لن تَضِلُّوا بَعْدَہُ إنِ اعْتَصَمْتُمْ بِہِ کِتَابُ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30700","","","كتاب فضائل القرآن"
"30701","(۳۰۷۰۱) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَسَّانُ بْنُ إبْرَاہِیمَ ، عَن سَعِیدِ بْنِ مَسْرُوقٍ ، عَن یَزِید بْنِ حَیَّان ، عَن زَیْدِ بْنِ أَرْقَمَ ، قَالَ: دَخَلْنَا عَلَیْہِ فَقُلْنَا لَہُ قَدْ رَأَیْت خَیْرًا ، صَحِبْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَصَلَّیْت خَلْفَہُ، فَقَالَ: نَعَمْ ، وَإِنَّہُ خَطَبَنَا فَقَالَ: إنِّی تَارِکٌ فِیکُمْ کِتَابَ اللہِ ہُوَ حَبْلُ اللہِ ، مَنِ اتَّبَعَہُ کَانَ عَلَی الْہُدَی وَمَنْ تَرَکَہُ کَانَ عَلَی الضَّلالَۃِ۔ (مسلم ۱۸۷۴۔ احمد ۳۶۶)","Sahih","Musannaf Ibn Abi Shaybah 30701","","","كتاب فضائل القرآن"
"30702","(۳۰۷۰۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: أَخْبَرَنَا جَرِیرٌ ، قَالَ: حَدَّثَنَا سُلَیْمَانُ بْنُ شُرَحْبِیلَ الْجبلانِیُّ ، قَالَ: سَمِعْتُ أَبَا أُمَامَۃَ یَقُولُ: اقَرَؤُوا الْقُرْآنَ وَلا تَغُرَّنَّکُمْ ہَذِہِ الْمَصَاحِفُ الْمُعَلَّقَۃُ فَإِنَّ اللَّہَ لَمْ یُعَذِّبْ قَلْبًا وَعَی الْقُرْآنَ۔","Hasan","Musannaf Ibn Abi Shaybah 30702","","","كتاب فضائل القرآن"
"30703","(۳۰۷۰۳) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ: قَالَ عَبْدُ اللہِ: مَنْ قَرَأَ الْقُرْآنَ فَلْیُبْشِرْ۔","Sahih","Musannaf Ibn Abi Shaybah 30703","","","كتاب فضائل القرآن"
"30704","(۳۰۷۰۴) حَدَّثَنَا محمد بن بشر حَدَّثَنَا زَکَرِیَّا ، قَالَ: حدَّثَنِی عَطِیَّۃُ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: إنِّی تَارِکٌ فِیکُمَ الثَّقَلَیْنِ ، أَحَدُہُمَا أَکْبَرُ مِنَ الآخَرِ کِتَابُ اللہِ حَبْلٌ مَمْدُودٌ مِنَ السَّمَائِ إِلَی الأَرْضِ۔ (احمد ۱۴۔ ترذی ۳۷۸۸)","Da'if","Musannaf Ibn Abi Shaybah 30704","","","كتاب فضائل القرآن"
"30705","(۳۰۷۰۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ: أَخْبَرَنِی مُحَمَّدُ بْنُ إبْرَاہِیمَ بْنِ الْحَارِثِ ، عَن یُحَنَّسَ أَبِی مُوسَی ، عَن رَاشِدِ بْنِ سَعْدٍ أَخٍ لأُمِّ الدَّرْدَائِ عَنْ أَبِی الدَّرْدَائِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ قَرَأَ مِئَۃ آیَۃٍ فِی لَیْلَۃٍ لَمْ یُکْتَبْ مِنَ الْغَافِلِینَ ، وَمَنْ قَرَأَ بِمِئَتَیْ آیَۃٍ کُتِبَ مِنَ الْقَانِتِینَ وَمَنْ قَرَأَ خَمْسَمِئَۃِ آیَۃٍ إِلَی أَلْفِ آیَۃٍ أَصْبَحَ لَہُ قِنْطَارٌ مِنَ الأَجْرِ وَالْقِیرَاطُ منہ مِثْلُ التَّلِّ الْعَظِیمِ۔ (عبد بن حمید ۲۰۰)","Da'if","Musannaf Ibn Abi Shaybah 30705","","","كتاب فضائل القرآن"
"30706","(۳۰۷۰۶) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن مَنْصُورٍ ، عَن سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَن مُعَاذٍ ، أَنَّہُ قَالَ: مَنْ قَرَأَ فِی لَیْلَۃٍ بثَلاثِ مِئَۃ آیَۃٍ کُتِبَ مِنَ الْقَانِتِینَ ، وَمَنْ قَرَأَ بِأَلْفِ آیَۃٍ کَانَ لَہُ قِنْطَاران الْقِیرَاطَ مِنْہُ أَفْضَلُ مِمَّا عَلَی الأَرْضِ مِنْ شَیْئٍ۔","","Musannaf Ibn Abi Shaybah 30706","","","كتاب فضائل القرآن"
"30707","(۳۰۷۰۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنِ الأَعْمَشِ ، عَن مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ ضَمْرَۃَ ، عَن کَعْبٍ ، قَالَ: مَنْ قَرَأَ فِی لَیْلَۃٍ مِئَۃ آیَۃٍ کُتِبَ مِنَ الْقَانِتِینَ۔","","Musannaf Ibn Abi Shaybah 30707","","","كتاب فضائل القرآن"
"30708","(۳۰۷۰۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ: حدَّثَنَا مِسْعَرٌ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: مَنْ قَرَأَ مِئَۃ آیَۃٍ فِی لَیْلَۃٍ لَمْ یُکْتَبْ مِنَ الْغَافِلِینَ ، وَمَنْ قَرَأَ مِئَتَیْنِ کُتِبَ مِنَ الْقَانِتِینَ۔n(ابن خزیمۃ ۱۱۴۳۔ حاکم ۳۰۸)","Sahih","Musannaf Ibn Abi Shaybah 30708","","","كتاب فضائل القرآن"
"30709","(۳۰۷۰۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن فِطْرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عبْدِ اللہِ ، قَالَ: مَنْ قَرَأَ فِی لَیْلَۃٍ خَمْسِینَ آیَۃً لَمْ یُکْتَبْ مِنَ الْغَافِلِینَ ، وَمَنْ قَرَأَ مِئَۃ آیَۃٍ کُتِبَ مِنَ الْقَانِتِینَ ، وَمَنْ قَرَأَ ثَلاثُ مِئَۃ آیَۃٍ کُتِبَ لَہُ قِنْطَارٌ ، وَمَنْ قَرَأَ تِسْعَ مِئَۃِ آیَۃٍ فُتِحَ لَہُ۔ (دارمی ۳۴۴۶)","Sahih","Musannaf Ibn Abi Shaybah 30709","","","كتاب فضائل القرآن"
"30710","(۳۰۷۱۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: مَنْ قَرَأَ فِی لَیْلَۃٍ بِمِئَۃِ آیَۃٍ لَمْ یُکْتَبْ مِنَ الْغَافِلِینَ ، وَمَنْ قَرَأَ بِمِئَتَیْ آیَۃٍ کُتِبَ مِنَ الْقَانِتِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 30710","","","كتاب فضائل القرآن"
"30711","(۳۰۷۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْجَدَلِی عن ابْنِ عُمَرَ ، قَالَ: مَنْ قَرَأَ بِعَشْرِ آیَاتٍ فِی لَیْلَۃٍ لَمْ یُکْتَبْ مِنَ الْغَافِلِینَ۔ (ابوداؤد ۱۳۹۳۔ ابن حبان ۲۵۷۲)","Da'if","Musannaf Ibn Abi Shaybah 30711","","","كتاب فضائل القرآن"
"30712","(۳۰۷۱۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن مَنْصُورٍ ، قَالَ: قَالَ عَبْدُ اللہِ: لَوْ أَنَّ رَجُلاً بَاتَ یَحْمِلُ عَلَی الْجِیَادِ فِی سَبِیلِ اللہِ وَبَاتَ رَجُلٌ یَتْلُو کِتَابَ اللہِ لَکَانَ ذَاکِرُ اللہِ أَفْضَلَہُمَا قَالَ: وَقَالَ عَبْدُ اللہِ بْنُ عَمْرو: لَوْ بَاتَ رَجُلٌ یُنْفِقُ دِینَارًا دِینَارًا وَدِرْہَمًا دِرْہَمًا وَیَحْمِلُ عَلَی الْجِیَادِ فِی سَبِیلِ اللہِ حَتَّی یُصْبِحَ مُتَقَبَّلاً مِنْہُ، وَبِتُّ أَتْلُو کِتَابَ اللہِ حَتَّی أُصْبِحَ مُتَقَبَّلاً مِنِّی لَمْ أُحِبَّ ، أَنَّ لِی عَمَلَہُ بِعَمَلِی۔","","Musannaf Ibn Abi Shaybah 30712","","","كتاب فضائل القرآن"
"30713","(۳۰۷۱۳) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ: حدَّثَنَا التَّیْمِیُّ ، عَنْ أَبِی عُثْمَانَ ، عَن سَلْمَانَ ، قَالَ: لَوْ بَاتَ رَجُلٌ یُعْطِی الْقیَانِ الْبِیضَ وَبَاتَ آخَرُ یَقْرَأُ الْقُرْآنَ وَیَذْکُرُ اللَّہَ لَرَأَیْت ، أَنَّ ذَاکِرَ اللہِ أَفْضَلُ۔","Sahih","Musannaf Ibn Abi Shaybah 30713","","","كتاب فضائل القرآن"
"30714","(۳۰۷۱۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن شَقِیقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ: قرَائَۃُ الْقُرْآنِ أَحَبُّ إلَیَّ مِنَ الصَّوْمِ۔","Sahih","Musannaf Ibn Abi Shaybah 30714","","","كتاب فضائل القرآن"
"30715","(۳۰۷۱۵) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَن شَقِیقٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی رَزِینٍ ، قَالَ: قَالَ رَجُلٌ لِحَبَّۃَ بْنِ سَلَمَۃَ ،وَکَانَ مِنْ أَصْحَابِ عَبْدِ اللہِ: قَرَأْت الْقُرْآنَ کُلَّہُ: قَالَ: وَمَا أَدْرَکْت مِنْہُ۔","","Musannaf Ibn Abi Shaybah 30715","","","كتاب فضائل القرآن"
"30716","(۳۰۷۱۶) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، قَالَ حَدَّثَنَا أَیُّوبُ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَقُولَ: قَرَأْت الْقُرْآنَ کُلَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30716","","","كتاب فضائل القرآن"
"30717","(۳۰۷۱۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَن سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، قَالَ: قَالَ حُذَیْفَۃُ: مَا تَقْرَؤُونَ رُبُعَہَا یَعْنِی بَرَائَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 30717","","","كتاب فضائل القرآن"
"30718","(۳۰۷۱۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن عُبَیْدِ اللہِ ، عَن نَافِعٍ ، أن ابْنِ عُمَرَ کَرِہَ أَنْ یَقُولَ: الْمُفَصَّلُ ، وَیَقُولُ: الْقُرْآنُ کُلُّہُ مُفَصَّلٌ ، وَلَکِنْ قُولُوا: قِصَارُ الْقُرْآنِ۔","Sahih","Musannaf Ibn Abi Shaybah 30718","","","كتاب فضائل القرآن"
"30719","(۳۰۷۱۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَر بْنِ حَمْزَۃَ ، عَن سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ: سَأَلَنِی عُمَرُ ، کَمْ مَعَک مِنَ الْقُرْآنِ ؟ قُلْتُ: عَشْرُ سُوَرٍ ، فَقَالَ لِعُبَیْدِ اللہِ بْنِ عُمَرَ: کَمْ مَعَک مِنَ الْقُرْآنِ ؟ قَالَ: سُورَۃٌ ، قَالَ عَبْدُ اللہِ: فَلَمْ یَنْہَنَا وَلَمْ یَأْمُرْنَا غَیْرَ ، أَنَّہُ قَالَ: فَإِنْ کُنْتُمْ مُتَعَلِّمِینَ مِنْہُ بِشَیْئٍ فَعَلَیْکُمْ بِہَذَا الْمُفَصَّلِ فَإِنَّہُ أَحْفَظُ۔","Da'if","Musannaf Ibn Abi Shaybah 30719","","","كتاب فضائل القرآن"
"30720","(۳۰۷۲۰) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سیرین قَالَ: لاَ تقل سورۃ قصیرۃ ، ولا سورۃ خفیفۃ ، قَالَ فکیف أقول ؟ قَالَ: سورۃ یسیرۃ ؛ فإن اللہ تبارک وتعالی قَالَ: {وَلَقَدْ یَسَّرْنَا الْقُرْآنَ لِلذِّکْرِ فَہَلْ مِن مُّدَّکِرٍ} ولا تقل خفیفۃ ؛ فإن اللہ قَالَ {سَنُلْقِی عَلَیْکَ قَوْلاً ثَقِیلاً}۔","","Musannaf Ibn Abi Shaybah 30720","","","كتاب فضائل القرآن"
"30721","(۳۰۷۲۱) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْعَالِیَۃِ ذَکَرَ نَحْوَہُ إِلاَّ أَنَّہُ خَالَفَہُ فِی بَعْضِ الْکَلامِ۔","","Musannaf Ibn Abi Shaybah 30721","","","كتاب فضائل القرآن"
"30722","(۳۰۷۲۲) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَن مَنْصُورٍ ، عَن ہِلالِ بْنِ یَِسَافٍ عَن فَرْوَۃَ بْنِ نَوْفَلٍ ، قَالَ: قَالَ خَبَّابُ بْنُ الأَرَتِّ وَأَقْبَلْت مَعَہُ مِنَ الْمَسْجِدِ إِلَی مَنْزِلِہِ فَقَالَ لِی: إنِ اسْتَطَعْت أَنْ تَقَرَّبَ إِلَی اللہِ فَإِنَّک لاَ تَقَرَّبُ إلَیْہِ بِشَیْئٍ أَحَبَّ إلَیْہِ مِنْ کَلامِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30722","","","كتاب فضائل القرآن"
"30723","(۳۰۷۲۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ: سَأَلْتُ عَبِیدَۃَ ، عَن آیَۃٍ فِی کِتَابِ اللہِ ؟ فَقَالَ: عَلَیْک بِتَقْوَی اللہِ وَالسَّدَادِ ، فَقَدْ ذَہَبَ الَّذِینَ کَانُوا یَعْلَمُونَ فِیمَ أُنْزِلَ الْقُرْآنُ۔","","Musannaf Ibn Abi Shaybah 30723","","","كتاب فضائل القرآن"
"30724","(۳۰۷۲۴) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ: سَأَلَ رَجُلٌ سَعِیدَ بْنَ الْمُسَیَّبِ ، عَن آیَۃٍ مِنَ الْقُرْآنِ فَقَالَ: لاَ تَسْأَلْنِی عَنِ الْقُرْآنِ ، وَسَلْ عَنْہُ مَنْ یَزْعُمُ ، أَنَّہُ لاَ یَخْفَی عَلَیْہِ مِنْہُ شَیْئٌ یَعْنِی عِکْرِمَۃَ۔","","Musannaf Ibn Abi Shaybah 30724","","","كتاب فضائل القرآن"
"30725","(۳۰۷۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الأَعْلَی ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: مَنْ قَالَ فِی الْقُرْآنِ بِغَیْرِ عِلْمٍ فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 30725","","","كتاب فضائل القرآن"
"30726","(۳۰۷۲۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مُغِیرَۃَ ، قَالَ: کَانَ إبْرَاہِیمُ یَکْرَہُ أَنْ یَتَکَلَّمَ فِی الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30726","","","كتاب فضائل القرآن"
"30727","(۳۰۷۲۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنِ الشَّعْبِیِّ ، قَالَ: أَدْرَکْت أَصْحَابَ عَبْدِ اللہِ وَأَصْحَابَ عَلِیٍّ وَلَیْسَ ہُمْ لِشَیْئٍ مِنَ الْعِلْمِ أَکْرَہُ مِنْہُمْ لِتَفْسِیرِ الْقُرْآنِ ، قَالَ: وَکَانَ أَبُو بَکْرٍ یَقُولُ: أَیُّ سَمَائٍ تُظِلُّنِی وَأَیُّ أَرْضٍ تُقِلُّنِی إذَا قُلْتُ فِی کِتَابِ اللہِ مَا لاَ أَعْلَمُ۔","","Musannaf Ibn Abi Shaybah 30727","","","كتاب فضائل القرآن"
"30728","(۳۰۷۲۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ: حدَّثَنِی عَبْدُ اللہِ بْنُ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، قَالَ: سَأَلْتُ طَاوُوسًا ، عَن تَفْسِیرِ ہَذِہِ الآیَۃِ: {شَہَادَۃُ بَیْنِکُمْ إذَا حَضَرَ أَحَدَکُمَ الْمَوْتُ} فَأَرَادَ أَنْ یَبْطِشَ حَتَّی قِیلَ ہَذَا ابْنُ حَبِیبٍ کَرَاہِیَۃً لِتَفْسِیرِ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30728","","","كتاب فضائل القرآن"
"30729","(۳۰۷۲۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: أَخْبَرَنَا حُمَیْدٌ ، عَنْ أَنَسٍ ، أَنَّ عُمَرَ ، قَرَأَ عَلَی الْمِنْبَرِ: {وَفَاکِہَۃً وَأَبًّا} ثُمَّ قَالَ: ہَذِہِ الْفَاکِہَۃُ قَدْ عَرَفْنَاہَا فَمَا الأَبُّ ؟ ثُمَّ رَجَعَ إِلَی نَفْسِہِ فَقَالَ: إنَّ ہَذَا لَہُوَ التَّکَلُّفُ یَا عُمَرُ۔","Sahih","Musannaf Ibn Abi Shaybah 30729","","","كتاب فضائل القرآن"
"30730","(۳۰۷۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ: کَتَبَ رَجُلٌ مُصْحَفًا وَکَتَبَ عِنْدَ کُلِّ آیَۃٍ تَفْسِیرَہَا ، فَدَعَا بِہِ عُمَرُ فَقَرَضَہُ بِالْمِقْرَاضَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 30730","","","كتاب فضائل القرآن"
"30731","(۳۰۷۳۱) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الْعَوَّامِ بْنِ حَوْشَبٍ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، أَنَّ أَبَا بَکْرٍ سُئِلَ عَن (وفَاکِہَۃً وَأَبًّا) فَقَالَ: أَیُّ سَمَائٍ تُظِلُّنِی وَأَیُّ أَرْضٍ تُقِلُّنِی إذَا قُلْتُ فِی کِتَابِ اللہِ مَا لاَ أَعْلَمُ۔","","Musannaf Ibn Abi Shaybah 30731","","","كتاب فضائل القرآن"
"30732","(۳۰۷۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ عبد اللہِ الزُّبَیْرِیُّ ، عَن سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی وَائِلٍ ، قَالَ: کَانَ إذَا سُئِلَ عَن شَیْئٍ مِنَ الْقُرْآنِ ، قَالَ: قَدْ أَصَابَ اللَّہُ مَا أَرَادَ۔","","Musannaf Ibn Abi Shaybah 30732","","","كتاب فضائل القرآن"
"30733","(۳۰۷۳۳) حَدَّثَنَا الثَّقَفِیُّ ، عَن شُعَیْبٍ ، قَالَ: کَانَ أَبُو الْعَالِیَۃِ یُقْرِئُ النَّاسَ الْقُرْآنَ ، فَإِذَا أَرَادَ أَنْ یُغَیِّرَ علی الرجل لَمْ یَقُلْ: لَیْسَ کَذَا وَکَذَا ، وَلَکِنَّہُ یَقُولُ: اقْرَأْ آیَۃَ کَذَا ، فَذَکَرْتہ لإِبْرَاہِیمَ فَقَالَ: أَظُنُّ صَاحِبَکُمْ قَدْ سَمِعَ ، أَنَّہُ مَنْ کَفَرَ بِحَرْفٍ مِنْہُ ، فَقَدْ کَفَرَ بِہِ کُلِّہِ۔","","Musannaf Ibn Abi Shaybah 30733","","","كتاب فضائل القرآن"
"30734","(۳۰۷۳۴) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ: أَمْسَکْت عَلَی عَبْدِ اللہِ فِی الْمُصْحَفِ فَقَالَ: کَیْفَ رَأَیْت ؟ قُلْتُ: قَرَأْتہَا کَمَا ہِیَ فِی الْمُصْحَفِ إِلاَّ حَرْفَ کَذَا قَرَأْتُہُ کَذَا وَکَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 30734","","","كتاب فضائل القرآن"
"30735","(۳۰۷۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، قَالَ: کُنْتُ أَقْرَأُ عَلَی إبْرَاہِیمَ فَإِذَا مَرَرْت بِحَرْفٍ یُنْکِرُہُ لَمْ یَقُلْ لِی: لَیْسَ کَذَا وَکَذَا ، وَیَقُولُ: کَانَ عَلْقَمَۃُ یَقْرَأُہ کَذَا وَکَذَا۔","","Musannaf Ibn Abi Shaybah 30735","","","كتاب فضائل القرآن"
"30736","(۳۰۷۳۶) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنِ الأَعْمَشِ ، قَالَ: قَالَ لِی إبْرَاہِیمُ: إنَّ إبْرَاہِیمَ التَّیْمِیَّ یُرِیدُ أَنْ تُقْرِئَہُ قِرَائَۃَ عَبْدِ اللہِ ، قُلْتُ: لاَ أَسْتَطِیعُ ، قَالَ: بَلَی ، فَإِنَّہُ قَدْ أَرَادَ ذَاکَ ، قَالَ: فَلَمَّا رَأَیْتہ قَدْ ہَوِی ذَاکَ ، قُلْتُ: فَیَکُونُ ہَذَا بِمَحْضَرٍ مِنْک فَنَتَذَاکَرُ حُرُوفَ عَبْدِ اللہِ فَقَالَ: اکفنی ہَذَا ، قُلْتُ: وَمَا تَکْرَہُ مِنْ ہَذَا ؟ قَالَ أَکْرَہُ أَنْ أَقُولَ لِشَیْئٍ ہُوَ ہَکَذَا ، وَلَیْسَ ہُوَ ہَکَذَا ، أَوْ أَقُولُ فِیہَا وَاوٌ وَلَیْسَ فِیہَا وَاوٌ۔","","Musannaf Ibn Abi Shaybah 30736","","","كتاب فضائل القرآن"
"30737","(۳۰۷۳۷) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ: سَأَلَ رَجُلٌ ابْنَ مَسْعُودٍ: {وَالَّذِینَ آمَنُوا وَاتَّبَعَتْہُمْ ذُرِّیَّتُہُمْ} فَجَعَلَ الرَّجُلُ یَقُولُ: ذُرِّیَاتُہُم ، فَجَعَلَ الرَّجُلُ یُرَدِّدُہَا وَیُرَدِّدُہَا ، وَلا یَقُولُ: لَیْسَ کَذَا۔","","Musannaf Ibn Abi Shaybah 30737","","","كتاب فضائل القرآن"
"30738","(۳۰۷۳۸) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ: إنِّی لأَکْرَہُ أَنْ أَشْہَدَ عَرْضَ الْقُرْآنِ فَأَقُولُ کَذَا وَلَیْسَ کَذَا۔","","Musannaf Ibn Abi Shaybah 30738","","","كتاب فضائل القرآن"
"30739","(۳۰۷۳۹) حَدَّثَنَا جَرِیرٌ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَانَ یَکْرَہُ أَنْ یَقْرَأَ الْقُرْآنَ یَعْرِضُ مِنْ أَمْرِ الدُّنْیَا۔","","Musannaf Ibn Abi Shaybah 30739","","","كتاب فضائل القرآن"
"30740","(۳۰۷۴۰) حَدَّثَنَا حَفْصٌ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ: کَانَ أَبِی إذَا رَأَی شَیْئًا مِنْ أَمْرِ الدُّنْیَا یُعْجِبُہُ ، قَالَ: لاَ تَمُدَّنَّ عَیْنَیْکَ إِلَی مَا مَتَّعْنَا بِہِ أَزْوَاجًا مِنْہُمْ۔","","Musannaf Ibn Abi Shaybah 30740","","","كتاب فضائل القرآن"
"30741","(۳۰۷۴۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَن عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، عَنْ أَبِیہِ ، عَن أُمِّ أَیُّوبَ قَالَتْ: قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: نَزَلَ الْقُرْآنُ عَلَی سَبْعَۃِ أَحْرُفٍ أَیُّہَا قَرَأْت أَصَبْت۔ (احمد ۴۳۳۔ حمیدی ۳۴۰)","Sahih","Musannaf Ibn Abi Shaybah 30741","","","كتاب فضائل القرآن"
"30742","(۳۰۷۴۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: نَزَلَ الْقُرْآنُ عَلَی سَبْعَۃِ أَحْرُفٍ کُلٌّ شَافٍ کَافٍ۔ (طبری ۱۹)","","Musannaf Ibn Abi Shaybah 30742","","","كتاب فضائل القرآن"
"30743","(۳۰۷۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ: حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: نَزَلَ الْقُرْآنُ عَلَی سَبْعَۃِ أَحْرُفٍ عَلِیمًا حَکِیمًا ، غَفُورًا رَحِیمًا۔n(احمد ۳۳۲۔ ابن حبان ۷۴۳)","Hasan","Musannaf Ibn Abi Shaybah 30743","","","كتاب فضائل القرآن"
"30744","(۳۰۷۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ: حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، قَالَ: حَدَّثَنِی عَبْدُ اللہِ بْنُ عِیسَی ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ ، أَخْبَرَنِی أُبَیّ بْنُ کَعْبٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ: إنَّ رَبِّی أَرْسَلَ إلَیَّ: أَنِ اقْرَإِ الْقُرْآنَ عَلَی سَبْعَۃِ أَحْرُفٍ۔ (مسلم ۵۶۲۔ ابن حبان ۷۴۰)","Sahih","Musannaf Ibn Abi Shaybah 30744","","","كتاب فضائل القرآن"
"30745","(۳۰۷۴۵) حَدَّثَنَا غُنْدَر ، عَنْ شُعْبَۃ ، عَنِ الحَکْم ، عَنْ مُجَاہِدْ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ أُبَیِّ بْنِ کَعْبٍ ، أَنَّ النَّبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَتَاہُ جِبْرِیلُ فَقَالَ: إنَّ اللَّہَ یَأْمُرُک أَنْ تُقْرِئَ أُمَّتُک الْقُرْآنَ عَلَی سَبْعَۃِ أَحْرُفٍ فَأَیُّمَا حَرْفٍ قَرَؤُوا عَلَیْہِ ، فَقَدْ أَصَابُوا۔ (مسلم ۵۶۲۔ ابوداؤد ۱۴۷۳)","Sahih","Musannaf Ibn Abi Shaybah 30745","","","كتاب فضائل القرآن"
"30746","(۳۰۷۴۶) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنِ الْہَجَرِیِّ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: نَزَلَ الْقُرْآنُ عَلَی سَبْعَۃِ أَحْرُفٍ۔ (ابن حبان ۷۵۔ طبری ۱۲)","Da'if","Musannaf Ibn Abi Shaybah 30746","","","كتاب فضائل القرآن"
"30747","(۳۰۷۴۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدِ بْنِ جُدْعَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرٍ ، عَنْ أَبِیہِ ، أَنَّ جِبْرِیلَ ، قَالَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: اقْرَإِ الْقُرْآنَ عَلَی حَرْفٍ ، فَقَالَ لَہُ مِیکَائِیلُ: اسْتَزِدْہُ ، فَقَالَ: عَلَی حَرْفَیْنِ ، ثُمَّ قَالَ: اسْتَزِدْہُ ، حَتَّی بَلَغَ سَبْعَۃَ أَحْرُفٍ ، کُلُّہَا شَافٍ کَافٍ کَقَوْلِکَ: ہَلُمَّ وَتَعَالَ ، مَا لَمْ یَخْتِمْ آیَۃَ رَحْمَۃٍ بِآیَۃِ عَذَابٍ ، أَوْ آیَۃَ عَذَابٍ بِرَحْمَۃٍ۔ (احمد ۴۱)","Da'if","Musannaf Ibn Abi Shaybah 30747","","","كتاب فضائل القرآن"
"30748","(۳۰۷۴۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن حُمَیْدٍ ، عَنْ أَنَسٍ ، عَن أُبَیٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ اقْرَإِ الْقُرْآنَ عَلَی سَبْعَۃِ أَحْرُفٍ ، کُلٌّ شَافٍ کَافٍ۔ (احمد ۱۱۴۔ ابن حبان ۷۴۲)","Sahih","Musannaf Ibn Abi Shaybah 30748","","","كتاب فضائل القرآن"
"30749","(۳۰۷۴۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی عَنْ إِسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ عَنْ سُقَیْرٍ الْعَبْدِیِّ عَنْ سُلَیْمَانَ بْنِ صُرَدٍ عَنْ أُبَیٍّ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ: اقْرَأْہُ عَلَی سَبْعَۃِ أَحْرُفٍ۔ (ابوداؤد ۱۴۷۲۔ احمد ۱۲۴)","Da'if","Musannaf Ibn Abi Shaybah 30749","","","كتاب فضائل القرآن"
"30750","(۳۰۷۵۰) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَن سَمُرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: نَزَلَ الْقُرْآنُ عَلَی ثَلاثَۃِ أَحْرُفِ۔ (احمد ۱۶۔ طبرانی ۶۸۵۳)","Hasan","Musannaf Ibn Abi Shaybah 30750","","","كتاب فضائل القرآن"
"30751","(۳۰۷۵۱) حَدَّثَنَا خَالِدُ بْنُ مِجْلَزٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ الْعَزِیزِ الأَنْصَارِیِّ ، عَنِ الزُّہْرِیِّ ، عَن عُرْوَۃَ بْنِ الزُّبَیْرِ ، عَنِ الْمِسْوَرِ بْنِ مَخْرَمَۃَ ، وَعَبْدِ الرَّحْمَنِ بْنِ عَبْد الْقَارِی ، قَالا: سَمِعْنَا عُمَرَ بْنَ الْخَطَّابِ یَقُولُ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إنَّ الْقُرْآنَ نَزَلَ عَلَی سَبْعَۃِ أَحْرُفٍ فَاقْرَؤُوا مَا تَیَسَّرَ مِنْہُ۔n(بخاری ۲۴۱۹۔ مسلم ۵۶۰)","Sahih","Musannaf Ibn Abi Shaybah 30751","","","كتاب فضائل القرآن"
"30752","(۳۰۷۵۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، عَن أُبَیٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أنَّ جِبْرِیلَ لقیہ فَقَالَ: مُرْہُمْ فَلْیَقْرَؤُوہُ عَلَی سَبْعَۃِ أَحْرُفٍ۔ (ترمذی ۲۹۴۴۔ ابن حبان ۷۳۹)","Da'if","Musannaf Ibn Abi Shaybah 30752","","","كتاب فضائل القرآن"
"30753","(۳۰۷۵۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن شَقِیقٍ ، عَن مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: خُذُوا الْقُرْآنَ مِنْ أَرْبَعَۃٍ مِنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ وَمُعَاذِ بْنِ جَبَلٍ وَأُبَیُّ بْنِ کَعْبٍ وَسَالِمٍ مَوْلَی أَبِی حُذَیْفَۃَ۔ (بخاری ۳۷۶۰۔ مسلم ۱۹۱۴)","Sahih","Musannaf Ibn Abi Shaybah 30753","","","كتاب فضائل القرآن"
"30754","(۳۰۷۵۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ: قرَأْت عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ لِی: أَحْسَنْت۔ (مسلم ۵۵۱۔ احمد ۴۲۴)","Sahih","Musannaf Ibn Abi Shaybah 30754","","","كتاب فضائل القرآن"
"30755","(۳۰۷۵۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، عَن حَبِیبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ خَطَبَنَا عُمَرُ فَقَالَ: عَلِیٌّ أَقْضَانَا وَأُبَیٌّ أَقْرَؤُنَا ، وَإِنَّا نَتْرُکُ أَشْیَائَ مِمَّا یَقْرَأُ أُبَیٌّ وَإِنَّ أُبَیًّا یَقُولُ: سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلا أَتْرُکُ قَوْلَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِشَیْئٍ ، وَقَدْ نَزَلَ بَعْدَ أُبَیٍّ کِتَابٌ۔","Sahih","Musannaf Ibn Abi Shaybah 30755","","","كتاب فضائل القرآن"
"30756","(۳۰۷۵۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَن قَبِیصَۃَ بْنِ جَابِرٍ ، قَالَ: مَا رَأَیْت أَحَدًا کَانَ أَقْرَأَ لِکِتَابِ اللہِ ، وَلا أَفْقَہَ فِی دِینِ اللہِ ، وَلا أَعْلَمَ بِاللہِ مِنْ عُمَرَ۔","Hasan","Musannaf Ibn Abi Shaybah 30756","","","كتاب فضائل القرآن"
"30757","(۳۰۷۵۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَن دَاوُد بْنِ شَابُورَ ، عَن مُجَاہِدٍ ، قَالَ: کُنَّا نَفْخَرُ عَلَی النَّاسِ بِقَارِئنَا عَبْدِ اللہِ بْنِ السَّائِبِ۔","","Musannaf Ibn Abi Shaybah 30757","","","كتاب فضائل القرآن"
"30758","(۳۰۷۵۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنِ ابْنِ عُیَیْنَۃَ ، عَن دَاوُد بْنِ شَابُورَ ، عَن مُجَاہِدٍ ، قَالَ: کُنْتُ أفخر النَّاسَ بِالْحِفْظِ لِلْقُرْآنِ حَتَّی صَلَّیْت خَلْفَ مَسْلَمَۃَ بْنِ مَخْلَدٍ ، فَافْتَتَحَ الْبَقَرَۃَ فَمَا أَخْطَأَ فِیہَا وَاوًا ، وَلا أَلِفًا۔","","Musannaf Ibn Abi Shaybah 30758","","","كتاب فضائل القرآن"
"30759","(۳۰۷۵۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَمْرٍو ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ سَرَّہُ أَنْ یَقْرَأَ الْقُرْآنَ رَطْبًا کَمَا أُنْزِلَ فَلْیَقْرَأْ عَلَی قِرَائَۃِ ابْنِ أُمِّ عَبْدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30759","","","كتاب فضائل القرآن"
"30760","(۳۰۷۶۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ: حدَّثَنَا عِیسَی بْنُ دِینَارٍ مَوْلَی عَمْرِو بْنِ الْحَارِثِ ، قَالَ: حَدَّثَنَا أَبِی ، قَالَ: سَمِعْتُ عَمْرَو بْنَ الْحَارِثِ یَقُولُ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ سَرَّہُ أَنْ یَقْرَأَ الْقُرْآنَ کَمَا أُنْزِلَ غَضًّا فَلْیَقْرَأْہُ عَلَی قِرَائَۃِ ابْنِ أُمِّ عَبْدٍ۔ (بخاری ۱۹۲)","Da'if","Musannaf Ibn Abi Shaybah 30760","","","كتاب فضائل القرآن"
"30761","(۳۰۷۶۱) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ عَمَّارِ بْنِ أَبِی عَمَّارٍ ، قَالَ: سَمِعْتُ أَبَا حَبَّۃَ الْبَدْرِیَّ قَالَ: لَمَّا نَزَلَتْ: {لَمْ یَکُنِ الَّذِینَ کَفَرُوا مِنْ أَہْلِ الْکِتَابِ} إِلَی آخِرِہَا ، قَالَ جِبْرِیلُ: یَا رَسُولَ اللہِ ، إنَّ رَبَّک یَأْمُرُک أَنْ تُقْرِئَہَا أُبَیًّا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأُبَیٍّ: إنَّ جِبْرِیلَ أَمَرَنِی أَنْ أُقْرِئَک ہَذِہِ السُّورَۃَ ، قَالَ أُبَیٌّ: أَذَکَرَنِی یَا رَسُولَ اللہِ ؟ قَالَ: نَعَمْ۔ (احمد ۴۸۹۔ مسند ۷۲۳)","Da'if","Musannaf Ibn Abi Shaybah 30761","","","كتاب فضائل القرآن"
"30762","(۳۰۷۶۲) حَدَّثَنَا مُعَاوِیَۃُ بْنُ عَمْرو ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: مَنْ أَحَبَّ أَنْ یَقْرَأَ الْقُرْآنَ غَضًّا کَمَا أُنْزِلَ فَلْیَقْرَأْہُ عَلَی قِرَائَۃِ ابْنِ أُمِّ عَبْدٍ۔ (احمد ۴۴۵۔ ابن حبان ۷۰۶۶)","Da'if","Musannaf Ibn Abi Shaybah 30762","","","كتاب فضائل القرآن"
"30763","(۳۰۷۶۳) حَدَّثَنَا مُصْعَبُ بْنُ الْمِقْدَامِ ، عَنْ إسْرَائِیلَ ، عَن مُغِیرَۃَ ، أَنَّہُ سَمِعَ إبْرَاہِیمَ یَقُولُ: قدْ قَرَأَ عَبْدُ اللہِ القرآن عَلَی ظَہْرِ لِسَانِہِ۔","","Musannaf Ibn Abi Shaybah 30763","","","كتاب فضائل القرآن"
"30764","(۳۰۷۶۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن مَنْصُورِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ الشَّعْبِیِّ ، قَالَ: مَاتَ أَبُو بَکْرٍ ، وَعُمَرُ وَعَلِیٌّ وَلَمْ یَجْمَعُوا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 30764","","","كتاب فضائل القرآن"
"30765","(۳۰۷۶۵) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَن مَنْصُورٍ، عَن مُجَاہِدٍ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: أُنْزِلَتْ فَاتِحَۃُ الْکِتَابِ بِالْمَدِینَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 30765","","","كتاب فضائل القرآن"
"30766","(۳۰۷۶۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ: مَا کَانَ مِنْ حَجٍّ ، أَوْ فَرِیضَۃٍ فَإِنَّہُ نَزَلَ بِالْمَدِینَۃِ ، وَمَا کَانَ مِنْ ذِکْرِ الأُمَمِ وَالْقُرُونِ وَالْعَذَابِ فَإِنَّہُ أُنْزِلَ بِمَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 30766","","","كتاب فضائل القرآن"
"30767","(۳۰۷۶۷) حَدَّثَنَا وَکِیعٌ ، عَن سَلَمَۃَ ، عَنِ الضَّحَّاکِ: یَا أَیُّہَا الَّذِینَ آمَنُوا فِی الْمَدِینَۃِ۔","","Musannaf Ibn Abi Shaybah 30767","","","كتاب فضائل القرآن"
"30768","(۳۰۷۶۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عن علقمۃ قَالَ: کُلُّ شَیْئٍ فِی الْقُرْآنِ یَا أَیُّہَا الَّذِینَ آمَنُوا أُنْزِلَ بِالْمَدِینَۃِ ، وَکُلُّ شَیْئٍ فِی الْقُرْآنِ یَا أَیُّہَا النَّاسُ أُنْزِلَ بِمَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 30768","","","كتاب فضائل القرآن"
"30769","(۳۰۷۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ ، قَالَ: قَرَأْنَا الْمُفَصَّلَ حُجَجًا وَنَحْنُ بِمَکَّۃَ لَیْسَ فِیہَا یَا أَیُّہَا الَّذِینَ آمَنُوا۔","Sahih","Musannaf Ibn Abi Shaybah 30769","","","كتاب فضائل القرآن"
"30770","(۳۰۷۷۰) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَیُّوبَ ، عَن عِکْرِمَۃَ ، قَالَ: کُلُّ سُورَۃٍ فِیہَا یَا أَیُّہَا الَّذِینَ آمَنُوا فَہِیَ مَدَنِیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 30770","","","كتاب فضائل القرآن"
"30771","(۳۰۷۷۱) حَدَّثَنَا أَبُو أُسَامَۃَ، عَن زَائِدَۃَ، عَن مَنْصُورٍ، عَن مُجَاہِدٍ، قَالَ: الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ أُنْزِلَتْ بِالْمَدِینَۃِ۔","","Musannaf Ibn Abi Shaybah 30771","","","كتاب فضائل القرآن"
"30772","(۳۰۷۷۲) حَدَّثَنَا قَبِیصَۃُ ، عَن سُفْیَانَ ، عَن لَیْثٍ ، عَن شَہْرٍ ، قَالَ: الأَنْعَامُ مَکِّیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 30772","","","كتاب فضائل القرآن"
"30773","(۳۰۷۷۳) حَدَّثَنَا أَبُو أَحْمَدَ ، عَنْ مِسْعَر ، عَنِ النَّضْرِ بْنِ قَیْسٍ ، عَن عُرْوَۃَ: مَا کَانَ {یَا أَیُّہَا النَّاسُ} بِمَکَّۃَ ، وَمَا کَانَ {یَا أَیُّہَا الَّذِینَ آمَنُوا} بِالْمَدِینَۃِ۔","","Musannaf Ibn Abi Shaybah 30773","","","كتاب فضائل القرآن"
"30774","(۳۰۷۷۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ: ذَکَرُوا عِنْدَ الشَّعْبِیِّ قَوْلَہُ: {وَشَہِدَ شَاہِدٌ مِنْ بَنِی إسْرَائِیلَ علی مثلہ} فَقِیلَ: عَبْدُ اللہِ بْنُ سَلامٍ ، فَقَالَ: کَیْفَ یَکُونُ ابْنُ سَلامٍ وَہَذِہِ السُّورَۃُ مَکِّیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 30774","","","كتاب فضائل القرآن"
"30775","(۳۰۷۷۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَن ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ: إنِّی لأَعْلَمُ مَا نَزَلَ مِنَ الْقُرْآنِ بِمَکَّۃَ ، وَمَا أُنْزِلَ بِالْمَدِینَۃِ ، فَأَمَّا مَا نَزَلَ بِمَکَّۃَ فَضَرْبُ الأَمْثَالِ وَذِکْرُ الْقُرُونِ ، وَأَمَّا مَا نَزَلَ بِالْمَدِینَۃِ فَالْفَرَائِضُ وَالْحُدُودُ وَالْجِہَادُ۔","","Musannaf Ibn Abi Shaybah 30775","","","كتاب فضائل القرآن"
"30776","(۳۰۷۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَن قَتَادَۃَ ، قَالَ: سَأَلْتُ أَنَسًا ، عَن قِرَائَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ: یَمُدُّ بِہَا صَوْتَہُ مَدًّا۔","Sahih","Musannaf Ibn Abi Shaybah 30776","","","كتاب فضائل القرآن"
"30777","(۳۰۷۷۷) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَن أُمِّ سَلَمَۃَ قَالَتْ: کَانَت قِرَائَ ۃُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ} فَذَکَرَتْ حَرْفًا حَرْفًا۔","","Musannaf Ibn Abi Shaybah 30777","","","كتاب فضائل القرآن"
"30778","(۳۰۷۷۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَانَ عَلْقَمَۃُ یَقْرَأُ عَلَی عَبْدِ اللہِ فَقَالَ: رَتِّلْ فِدَاک أَبِی وَأُمِّی فَإِنَّہُ زَیْنُ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30778","","","كتاب فضائل القرآن"
"30779","(۳۰۷۷۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، قَالَ: کَانَ ابْنُ سِیرِینَ إذَا قَرَأَ یَمْضِی فِی قِرَائَتِہِ۔","","Musannaf Ibn Abi Shaybah 30779","","","كتاب فضائل القرآن"
"30780","(۳۰۷۸۰) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ، عَن عُثْمَانَ بْنِ الأَسْوَدِ، عَن مُجَاہِدٍ، وَعَطَائٍ أَنَّہُمَا کَانَا یَہُذَّانِ الْقِرَائَۃَ ہَذًّا۔","","Musannaf Ibn Abi Shaybah 30780","","","كتاب فضائل القرآن"
"30781","(۳۰۷۸۱) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَن سَلَمَۃَ بْنِ کُہَیْلٍ، عَن حُجْرِ بْنِ عَنْبَسَ، عَن وَائِلِ بْنِ حُجْرٍ، قَالَ سَمِعْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ: {وَلا الضَّالِّینَ} فَقَالَ: آمِینَ یَمُدُّ بِہَا صَوْتَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30781","","","كتاب فضائل القرآن"
"30782","(۳۰۷۸۲) حَدَّثَنَا وَکِیعٌ ، عَن عِیسَی ، عَنِ الشَّعْبِیِّ ، قَالَ: قَالَ عَبْدُ اللہِ لاَ تَہُذُّوا الْقُرْآنَ کَہَذِّ الشِّعْرِ ، وَلا تَنْثُرُوہُ نَثْرَ الدَّقَلِ۔","","Musannaf Ibn Abi Shaybah 30782","","","كتاب فضائل القرآن"
"30783","(۳۰۷۸۳) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَن مَنْصُورٍ، عَن مُجَاہِدٍ: {وَرَتِّلِ الْقُرْآنَ تَرْتِیلاً} قَالَ: بَعْضُہُ عَلَی أَثَرِ بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 30783","","","كتاب فضائل القرآن"
"30784","(۳۰۷۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَن مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ: {وَرَتِّلِ الْقُرْآنَ تَرْتِیلاً} قَالَ بَیِّنْہُ تَبْیِینًا۔","Da'if","Musannaf Ibn Abi Shaybah 30784","","","كتاب فضائل القرآن"
"30785","(۳۰۷۸۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن عُبَیْدٍ الْمُکَتِّبِ ، قَالَ: سُئِلَ مُجَاہِدٌ ، عَن رَجُلَیْنِ قَرَأَ أَحَدُہُمَا الْبَقَرَۃَ وَقَرَأَ آخَرُ الْبَقَرَۃَ وَآلَ عِمْرَانَ ، فَکَانَ رُکُوعُہُمَا وَسُجُودُہُمَا وَجُلُوسُہُمَا سَوَائً أَیُّہُمَا أَفْضَلُ ؟ قَالَ: الَّذِی قَرَأَ الْبَقَرَۃَ ، ثُمَّ قَرَأَ مُجَاہِدٌ: {وَقُرْآنًا فَرَقْنَاہُ لِتَقْرَأَہُ عَلَی النَّاسِ عَلَی مُکْثٍ وَنَزَّلْنَاہُ تَنْزِیلاً}۔","","Musannaf Ibn Abi Shaybah 30785","","","كتاب فضائل القرآن"
"30786","(۳۰۷۸۶) حَدَّثَنَا وَکِیعٌ قَالَ: حَدَّثَنَا عُبَیْدُاللہِ بْنُ عَبْدِالرَّحْمَنِ بْنُ مَوْہَبٍ، قَالَ: سَمِعْتُ مُحَمَّدَ بْنَ کَعْبٍ الْقُرَظِیَّ یَقُولُ: لأَنْ أَقْرَأَ: {إذَا زُلْزِلَتْ} وَ {الْقَارِعَۃُ} أُرَدِّدُہُمَا وَأَتَفَکَّرُ فِیہِمَا أَحَبُّ إلَیَّ مِنْ أَنْ أَہُذَّ الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 30786","","","كتاب فضائل القرآن"
"30787","(۳۰۷۸۷) حَدَّثَنَا مَعْنُ بْنُ عِیسَی، عَن ثَابِتِ بْنِ قَیْسٍ، قَالَ: سَمِعْتُ عُمَرَ بْنَ عَبْدِالْعَزِیزِ إذَا قَرَأَ تَرَسَّلَ فِی قِرَائَتِہِ۔","","Musannaf Ibn Abi Shaybah 30787","","","كتاب فضائل القرآن"
"30788","(۳۰۷۸۸) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلابَۃَ ، أَنَّ أُنَاسًا مِنْ أَہْلِ الْکُوفَۃِ أتوا أبَا الدَّرْدَائِ، فَقَالُوا: إنَّ إخْوَانًا لک مِنْ أَہْلِ الْکُوفَۃِ یُقْرِئُ وْنَک السَّلامَ وَیَأْمُرُونَک أَنْ تُوصِیَہُمْ ، قَالَ: فَأَقْرِئُ وْہُمُ السَّلامَ وَمُرُوہُمْ فَلْیُعْطُوا الْقُرْآنَ خَزَائِمَہُ ، فَإِنَّہُ یَحْمِلُہُمْ عَلَی الْقَصْدِ وَالسُّہُولَۃِ ، وَیُجَنِّبُہُمُ الْجَوْرَ وَالْحُزُونَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 30788","","","كتاب فضائل القرآن"
"30789","(۳۰۷۸۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلابَۃَ ، قَالَ: قَالَ أَبُو الدَّرْدَائِ: لاَ تَفْقَہُ کُلَّ الْفِقْہِ حَتَّی تَرَی لِلْقُرْآنِ وُجُوہًا کَثِیرَۃً۔","","Musannaf Ibn Abi Shaybah 30789","","","كتاب فضائل القرآن"
"30790","(۳۰۷۹۰) حَدَّثَنَا ہَوْذَۃُ بْنُ خَلِیفَۃ ، قَالَ: حدَّثَنَا عَوْفٌ ، عَن زِیَادِ بْنِ مِخْرَاقٍ ، عَنْ أَبِی کِنَانَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ: أَعْطُوا الْقُرْآنَ خَزَائِمَہُ ، یَأْخُذْ بِکُمُ الْقَصْدَ وَالسُّہُولَۃَ وَیُجَنِّبْکُمُ الْجَوْرَ وَالْحُزُونَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 30790","","","كتاب فضائل القرآن"
"30791","(۳۰۷۹۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، عَن مُحَمَّدِ بْنِ إبْرَاہِیمَ ، عَن سَعْدٍ مَوْلَی عَمْرِو بْنِ الْعَاصِ ، قَالَ: تَشَاجَرَ رَجُلانِ فِی آیَۃٍ فَارْتَفَعَا إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: لاَ تُمَاروا فِیہِ فَإِنَّ مراء فِیہِ کُفْرٌ۔ (احمد ۲۰۴۔ بیہقی ۲۲۶۶)","","Musannaf Ibn Abi Shaybah 30791","","","كتاب فضائل القرآن"
"30792","(۳۰۷۹۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃَ ، قَالَ: أَخْبَرَنِی عَبْدُ اللہِ بْنُ یَزِیدَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: دَعُوا الْمِرَائَ فِی الْقُرْآنِ فَإِنَّ الأُمَمَ قَبْلَکُمْ لَمْ یُلْعَنُوا حَتَّی اخْتَلَفُوا فِی الْقُرْآنِ ، فَإِنَّ مِرَائً فِی الْقُرْآنِ کُفْرٌ۔","Da'if","Musannaf Ibn Abi Shaybah 30792","","","كتاب فضائل القرآن"
"30793","(۳۰۷۹۳) حَدَّثَنَا مَالِکٌ ، حَدَّثَنَا أَبُو قُدَامَۃَ ، قَالَ: حدَّثَنَا أَبُو عِمْرَانَ الْجَوْنِیُّ ، عَن جُنْدُبِ بْنِ عَبْدِ اللہِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: اقْرَؤُوا الْقُرْآنَ مَا ائْتَلَفَتْ عَلَیْہِ قُلُوبُکُمْ ، فَإِذَا اخْتَلَفْتُمْ فِیہِ فَقُومُوا۔n(بخاری ۵۰۶۱۔ مسلم ۲۰۵۳)","Sahih","Musannaf Ibn Abi Shaybah 30793","","","كتاب فضائل القرآن"
"30794","(۳۰۷۹۴) حَدَّثَنَا حَفْص ، عَن لَیْثٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: لاَ تَضْرِبُوا الْقُرْآنَ بَعْضَہُ بِبَعْضٍ فَإِنَّ ذَلِکَ یُوقِعُ الشَّکَّ فِی الْقُلُوبِ۔","Da'if","Musannaf Ibn Abi Shaybah 30794","","","كتاب فضائل القرآن"
"30795","(۳۰۷۹۵) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی التَّیْمِیُّ ، عَن مَنْصُورٍ ، عَن سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: جِدَالٌ فِی الْقُرْآنِ کُفْرٌ۔ (احمد ۴۷۸۔ ابویعلی ۵۹۹۰)","Sahih","Musannaf Ibn Abi Shaybah 30795","","","كتاب فضائل القرآن"
"30796","(۳۰۷۹۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن شُعْبَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، قَالَ: سَمِعْتُ النَّزَّالَ یَقُولُ: قَالَ عَبْدُ اللہِ: سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: إنَّ مَنْ قَبْلَکُمُ اخْتَلَفُوا فِیہِ فَأَہْلَکَہُمْ فَلا تَخْتَلِفُوا فِیہِ یَعْنِی فی الْقُرْآنِ۔ (بخاری ۲۴۱۰۔ احمد ۳۹۳)","Sahih","Musannaf Ibn Abi Shaybah 30796","","","كتاب فضائل القرآن"
"30797","(۳۰۷۹۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ: مَثَلُ الَّذِی جَمَعَ الإِیمَانَ وَجَمَعَ الْقُرْآنَ مِثْلُ الأُتْرُجَّۃِ الطَّیِّبَۃِ الطَّعْمِ ، وَمَثَلُ الَّذِی لَمْ یَجْمَعِ الإِیمَانَ وَلَمْ یَجْمَعِ الْقُرْآنَ مِثْلُ الْحَنْظَلَۃِ خَبِیثَۃُ الطَّعْمِ وَخَبِیثَۃُ الرِّیحِ۔ (دارمی ۳۳۶۲)","Da'if","Musannaf Ibn Abi Shaybah 30797","","","كتاب فضائل القرآن"
"30798","(۳۰۷۹۸) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا ہَمَّامٌ ، قَالَ: حَدَّثَنَا قَتَادَۃُ ، عَنْ أَنَسٍ ، أَنَّ أَبَا مُوسَی حَدَّثَہُ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ: مَثَلُ الْمُؤْمِنِ الَّذِی لاَ یَقْرَأُ الْقُرْآنَ کَمَثَلِ التَّمْرَۃِ طَعْمُہَا طَیِّبٌ ، وَلا رِیحَ لَہَا ، وَمَثَلُ الْمُؤْمِنِ الَّذِی یَقْرَأُ الْقُرْآنَ کَمَثَلِ الأُتْرُجَّۃِ طَیِّبَۃُ الطَّعْمِ طَیِّبَۃُ الرِّیحِ ، وَمَثَلُ الْفَاجِرِ الَّذِی لاَ یَقْرَأُ الْقُرْآنَ کَمَثَلِ الْحَنْظَلَۃِ طَعْمُہَا مُرٌّ ، وَلا رِیحَ لَہَا۔ (بخاری ۵۰۲۰۔ ابن حبان ۷۷۰)","Sahih","Musannaf Ibn Abi Shaybah 30798","","","كتاب فضائل القرآن"
"30799","(۳۰۷۹۹) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنِ الأَعْمَشِ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ، قَالَ: الْقُرْآنُ وَحْشِیٌّ، وَلا یَصْلُحُ مَعَ اللَّغَطِ۔","","Musannaf Ibn Abi Shaybah 30799","","","كتاب فضائل القرآن"
"30800","(۳۰۸۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیّ ، عَن قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَن قَیْسِ بْنِ عُبَادٍ ، قَالَ: کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَکْرَہُونَ رَفْعَ الصَّوْتِ عِنْدَ الذِّکْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 30800","","","كتاب فضائل القرآن"
"30801","(۳۰۸۰۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنِ الْحَسَنِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَکْرَہُ رَفْعَ الصَّوْتِ عِنْدَ قِرَائَۃِ الْقُرْآنِ۔","Da'if","Musannaf Ibn Abi Shaybah 30801","","","كتاب فضائل القرآن"
"30802","(۳۰۸۰۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن خَیْثَمَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ: انْتَہَیْت إلَیْہِ وَہُوَ یَنْظُرُ فِی الْمُصْحَفِ ، قَالَ: قُلْتُ: أَیُّ شَیْئٍ تَقْرَأُ فِی الْمُصْحَفِ ؟ قَالَ: حِزْبِی الَّذِی أَقُومُ بِہِ اللَّیْلَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 30802","","","كتاب فضائل القرآن"
"30803","(۳۰۸۰۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، قَالَ: قَالَ عَبْدُ اللہِ: أَدِیمُوا النَّظَرَ فِی الْمَصَاحِفِ۔","Da'if","Musannaf Ibn Abi Shaybah 30803","","","كتاب فضائل القرآن"
"30804","(۳۰۸۰۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی مُوسَی ، عَنِ الْحَسَنِ ، قَالَ: دَخَلُوا عَلَی عُثْمَانَ وَالْمُصْحَفُ فِی حِجْرِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 30804","","","كتاب فضائل القرآن"
"30805","(۳۰۸۰۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُس ، قَالَ: کَانَ من خُلُقُ الأَوَّلِینَ النَّظَرَ فِی الْمَصَاحِفِ ، وَکَانَ الأَحْنَفُ بْنُ قَیْسٍ إذَا خَلا نَظَرَ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 30805","","","كتاب فضائل القرآن"
"30806","(۳۰۸۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَن سُرِّیَّۃَ الرَّبِیعِ قَالَتْ: کَانَ الرَّبِیعُ یَقْرَأُ فِی الْمُصْحَفِ ، فَإِذَا دَخَلَ إنْسَانٌ غَطَّاہُ ، وَقَالَ: لاَ یَرَی ہَذَا أَنِّی أَقْرَأُ فِیہِ کُلَّ سَاعَۃٍ۔","","Musannaf Ibn Abi Shaybah 30806","","","كتاب فضائل القرآن"
"30807","(۳۰۸۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، قَالَ: کَانَ إبْرَاہِیمُ یَقْرَأُ فِی الْمُصْحَفِ فَإِذَا دَخَلَ عَلَیْہِ إنْسَانٌ غَطَّاہُ ، وَقَالَ: لاَ یَرَی ہَذَا أَنِّی أَقْرَأُ فِیہِ کُلَّ سَاعَۃٍ۔","","Musannaf Ibn Abi Shaybah 30807","","","كتاب فضائل القرآن"
"30808","(۳۰۸۰۸) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ قَالَتْ: إنِّی لأَقْرَأُ جزئی ، أَوْ عَامَّۃَ جزئی ، وَأَنَا مُضْطَجِعَۃٌ عَلَی فِرَاشِی۔","Sahih","Musannaf Ibn Abi Shaybah 30808","","","كتاب فضائل القرآن"
"30809","(۳۰۸۰۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن مُوسَی بْنِ عُلَیٍّ ، قَالَ: سَمِعْتُ أَبِی ، قَالَ: أَمْسَکْت عَلَی فَضَالَۃَ بْنِ عُبَیْدٍ الْقُرْآنَ حَتَّی فَرَغَ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30809","","","كتاب فضائل القرآن"
"30810","(۳۰۸۱۰) حَدَّثَنَا سُلَیْمَانُ بْنُ حَرْبٍ ، قَالَ: حدَّثَنَا أَبُو ہِلالٍ ، قَالَ: حَدَّثَنَا أَبُو صَالِحٍ الْعُقَیْلِیُّ ، قَالَ: کَانَ أَبُو الْعَلائِ یَزِیدُ بْنُ عَبْدِ اللہِ بْنِ الشِّخِّیرِ یَقْرَأُ فِی الْمُصْحَفِ حَتَّی یُغْشَی عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 30810","","","كتاب فضائل القرآن"
"30811","(۳۰۸۱۱) حَدَّثَنَا مُعْتَمِرٌ ، عَن لَیْثٍ ، قَالَ: رَأَیْتُ طَلْحَۃَ یَقْرَأُ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 30811","","","كتاب فضائل القرآن"
"30812","(۳۰۸۱۲) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَن مَنْصُورٍ، عَنْ إبْرَاہِیمَ کَرِہَ أَنْ یَقُولَ: قرَائَۃُ فُلانٍ وَیَقُولُ: کَمَا یَقْرَأُ فُلانٌ۔","","Musannaf Ibn Abi Shaybah 30812","","","كتاب فضائل القرآن"
"30813","(۳۰۸۱۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَن دَاوُد ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: نَزَلَ الْقُرْآنُ جُمْلَۃً مِنَ السَّمَائِ الْعُلْیَا إِلَی السَّمَائِ الدُّنْیَا فِی رَمَضَانَ ، فَکَانَ اللَّہُ إذَا أَرَادَ أَنْ یُحْدِثَ شَیْئًا أَحْدَثَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30813","","","كتاب فضائل القرآن"
"30814","(۳۰۸۱۴) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلابَۃَ ، قَالَ: نَزَلَتِ التَّوْرَاۃُ لِسِتٍّ خَلَوْنَ مِنْ رَمَضَانَ ، وَأُنْزِلَ الْقُرْآنُ لأَرْبَعٍ وَعِشْرِینَ۔","","Musannaf Ibn Abi Shaybah 30814","","","كتاب فضائل القرآن"
"30815","(۳۰۸۱۵) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَن سُفْیَانَ ، عَن خَالِدٍ ، عَنْ أَبِی قِلابَۃَ ، قَالَ: نَزَلَتِ الْکُتُبُ کلہا لَیْلَۃَ أَرْبَعٍ وَعِشْرِینَ مِنْ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 30815","","","كتاب فضائل القرآن"
"30816","(۳۰۸۱۶) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ: حدَّثَنَا عَمَّارُ بْنُ رُزَیْقٍ ، عَنِ الأَعْمَشِ ، عَن حَسَّانَ بْنِ أَبِی الأَشْرَسِ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ فِی قَوْلِہِ: إنَّا أَنْزَلْنَاہُ فِی لَیْلَۃِ الْقَدْرِ ، قَالَ: دُفِعَ إِلَی جِبْرِیلَ لَیْلَۃَ الْقَدْرِ جُمْلَۃً ،فوضع فِی بَیْتِ الْعِزَّۃِ ثم جَعَلَ یَنْزِلُہ تَنْزِیلاً۔","Hasan","Musannaf Ibn Abi Shaybah 30816","","","كتاب فضائل القرآن"
"30817","(۳۰۸۱۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن سُفْیَانَ ، قَالَ: أَخْبَرَنِی مَنْ سَمِعَ أَبَا الْعَالِیَۃَ یَذْکُرُ ، عَنْ أَبِی الْجَلْدِ ، قَالَ: نَزَلَتْ صُحُفُ إبْرَاہِیمَ أَوَّلَ لَیْلَۃٍ مِنْ رَمَضَانَ ، وَنَزَلَت الزَّبُورُ فِی سِتٍّ ، وَالإِنْجِیلُ فِی ، ثَمَانِ عَشْرَۃَ ، وَالْقُرْآنُ فِی أَرْبَعٍ وَعِشْرِینَ۔","","Musannaf Ibn Abi Shaybah 30817","","","كتاب فضائل القرآن"
"30818","(۳۰۸۱۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَبِی إِسْحَاقَ الشَّیْبَانِیِّ ، عَن وَاصِلِ بْنِ حَیَّانَ ، عَن شَقِیقِ بْنِ سَلَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ: کَیْفَ أَنْتُمْ إذَا أُسْرِیَ عَلَی کِتَابِ اللہِ فَذُہِبَ بِہِ ؟ قَالَ: یَا أَبَا عَبْدِ الرَّحْمَنِ ، کَیْفَ بِمَا فِی أَجَْوَافِ الرِّجَالِ ، قَالَ: یَبْعَثُ اللَّہُ رِیحًا طَیِّبَۃً فَتَکْفِتُ کُلَّ مُؤْمِنٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30818","","","كتاب فضائل القرآن"
"30819","(۳۰۸۱۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَن شَدَّادِ بْنِ مَعْقِلٍ ، قَالَ: قَالَ عَبْدُ اللہِ: إنَّ ہَذَا الْقُرْآنَ الَّذِی بَیْنَ أَظْہُرِکُمْ یُوشِکُ أَنْ یُنْزَعَ مِنْکُمْ ، قَالَ: قُلْتُ: کَیْفَ یُنْزَعُ مِنَّا وَقَدْ أثْبَتَہُ اللَّہُ فِی قُلُوبِنَا وَأَثْبَتْنَاہُ فِی مَصَاحِفِنَا قَالَ: یُسْرَی عَلَیْہِ فِی لَیْلَۃٍ وَاحِدَۃٍ فَیَنْتزِعُ مَا فِی الْقُلُوبِ وَیَذْہَبُ مَا فِی الْمَصَاحِفِ وَیُصْبِحُ النَّاسُ مِنْہُ فُقَرَائَ ، ثُمَّ قَرَأَ {وَلَئِنْ شِئْنَا لَنَذْہَبَنَّ بِالَّذِی أَوْحَیْنَا إلَیْک} ۔ (عبدالرزاق ۵۹۸۱)","Da'if","Musannaf Ibn Abi Shaybah 30819","","","كتاب فضائل القرآن"
"30820","(۳۰۸۲۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن سِمَاکٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لَیَقْرَأَنَّ الْقُرْآنَ أَقْوَامٌ مِنْ أُمَّتِی یَمْرُقُونَ مِنَ الإِسْلامِ کَمَا یَمْرُقُ السَّہْمُ مِنَ الرَّمِیَّۃِ۔ (ابن ماجہ ۱۷۱۔ احمد ۲۵۶)","","Musannaf Ibn Abi Shaybah 30820","","","كتاب فضائل القرآن"
"30821","(۳۰۸۲۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَن یُسَیْرِ بْنِ عَمْرٍو ، قَالَ: سَأَلْتُ سَہْلَ بْنَ حُنَیْفٍ: مَا سَمِعْتَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَذْکُرُ ہَؤُلائِ الْخَوَارِجَ ؟ ، قَالَ: سَمِعْتُہُ وَأَشَارَ بِیَدِہِ نَحْوَ الْمَشْرِقِ: یَخْرُجُ مِنْہُ قَوْمٌ یَقْرَؤُونَ الْقُرْآنَ بِأَلْسِنَتِہِمْ لاَ یَعْدُو تَرَاقِیَہُمْ ، یَمْرُقُونَ مِنَ الدِّینِ کَمَا یَمْرُقُ السَّہْمُ مِنَ الرَّمِیَّۃِ۔ (بخاری ۶۹۳۴۔ مسلم ۷۵۰)","Sahih","Musannaf Ibn Abi Shaybah 30821","","","كتاب فضائل القرآن"
"30822","(۳۰۸۲۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ: حدَّثَنِی قرۃ بْنُ خَالِدٍ السَّدُوسِیُّ ، قَالَ: حَدَّثَنِی أَبُو الزُّبَیْرِ ، عَنْ جَابِرٍ قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَجِیئُ قَوْمٌ یَقْرَؤُونَ الْقُرْآنَ لاَ یُجَاوِزُ تَرَاقِیَہُمْ ، یَمْرُقُونَ مِنَ الدِّینِ کَمَا یَمْرُقُ السَّہْمُ مِنَ الرَّمِیَّۃِ عَلَی فُوقِہِ۔ (مسلم ۱۴۲۔ احمد ۳۵۳)","Sahih","Musannaf Ibn Abi Shaybah 30822","","","كتاب فضائل القرآن"
"30823","(۳۰۸۲۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: یَخْرُجُ فِی آخِرِ الزَّمَانِ قَوْمٌ أَحْدَاثُ الأَسْنَانِ سُفَہَائُ الأَحْلامِ یَقْرَؤُونَ الْقُرْآنَ لاَ یُجَاوِزُ حَنَاجِرَہُمْ۔ (ترمذی ۲۱۸۸۔ احمد ۴۰۴)","Da'if","Musannaf Ibn Abi Shaybah 30823","","","كتاب فضائل القرآن"
"30824","(۳۰۸۲۴) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّد ٍحَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنِ الأَزْرَقِ بْنِ قَیْسٍ ، عَن شَرِیکِ بْنِ شِہَابٍ الْحَارِثِیِّ ، عَنْ أَبِی بَرْزَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: یَخْرُجُ قَوْمٌ مِنَ قبل الْمَشْرِقِ یَقْرَؤُونَ الْقُرْآنَ لاَ یُجَاوِزُ تَرَاقِیَہُمْ یَمْرُقُونَ مِنَ الدِّین[corrupt] کَمَا یَمْرُقُ السَّہْمُ مِنَ الرَّمِیَّۃِ لاَ یَرْجِعُونَ إلَیْہِ۔ (احمد ۴۲۱۔ حاکم ۱۴۶)","Da'if","Musannaf Ibn Abi Shaybah 30824","","","كتاب فضائل القرآن"
"30825","(۳۰۸۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، عَن سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَن زِیَادِ بْنِ لَبِیدٍ ، قَالَ: ذَکَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شَیْئًا فَقَالَ: وَذَاکَ عِنْدَ أَوانِ ذَہَابِ الْعِلْمِ ، قَالَ: قُلْتُ: یَا رَسُولَ اللہِ ، کَیْفَ یَذْہَبُ الْعِلْمُ وَنَحْنُ نَقْرَأُ الْقُرْآنَ وَنُقْرِئُہُ أَبْنَائَنَا وَیُقْرِئُہُ أَبْنَاؤُنَا أَبْنَائَہُمْ إِلَی یَوْمِ الْقِیَامَۃِ ، قَالَ: ثَکِلَتْک أُمُّک زِیَادُ ، إِنْ کُنْت لأرَاک مِنْ أَفْقَہِ رَجُلٍ بِالْمَدِینَۃِ ، أَو لَیْسَ ہَذِہِ الْیَہُودُ وَالنَّصَارَی یَقْرَؤُونَ التَّوْرَاۃَ وَالإِنْجِیلَ، لاَ یَعْمَلُونَ بِشَیْئٍ مِمَّا فِیہِمَا۔ (احمد ۱۶۰۔ طبرانی ۵۲۹۱)","","Musannaf Ibn Abi Shaybah 30825","","","كتاب فضائل القرآن"
"30826","(۳۰۸۲۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ أَبِی سِنَان ، عَنْ أَبِی الْمبَارکِ ، عَنْ عَطَائٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَا آمَنَ بِالْقُرْآنِ مَنِ اسْتَحَلَّ مَحَارِمَہُ۔ (عبد بن حمدع ۱۰۰۳)","Da'if","Musannaf Ibn Abi Shaybah 30826","","","كتاب فضائل القرآن"
"30827","(۳۰۸۲۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ سِنَانٍ ، عَنْ أَبِی الْمبَارکِ ، عَن صُہَیْبٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔ (ترمذی ۲۹۱۸)","Da'if","Musannaf Ibn Abi Shaybah 30827","","","كتاب فضائل القرآن"
"30828","(۳۰۸۲۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، قَالَ: قُلْتُ لأُبَیٍّ: إنَّ ابْنَ مَسْعُودٍ لاَ یَکْتُبُ الْمُعَوِّذَتَیْنِ فِی مُصْحَفِہِ ، فَقَالَ: إنِّی سَأَلْت عَنْہُمَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ: قِیلَ لِی ، فَقُلْتُ: فَقَالَ: أُبَیٌّ: وَنَحْنُ نَقُولُ کَمَا قِیلَ لَنَا۔ (بخاری ۴۹۷۶۔ ابن حبان ۴۴۲۹)","Da'if","Musannaf Ibn Abi Shaybah 30828","","","كتاب فضائل القرآن"
"30829","(۳۰۸۲۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، قَالَ: الْمُعَوِّذَتَانِ مِنَ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30829","","","كتاب فضائل القرآن"
"30830","(۳۰۸۳۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن حُصَیْنٍ ، عَنِ الشَّعْبِیِّ بِنَحْوٍ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 30830","","","كتاب فضائل القرآن"
"30831","(۳۰۸۳۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ: رَأَیْتُ عَبْدَ اللہِ یَحک الْمُعَوِّذَتَیْنِ مِنْ مَصَاحِفِہِ ، وقال: لاَ تَخْلِطُوا فِیہِ مَا لَیْسَ مِنْہُ۔ (احمد ۱۲۹۔ طبرانی ۹۱۴۸)","Sahih","Musannaf Ibn Abi Shaybah 30831","","","كتاب فضائل القرآن"
"30832","(۳۰۸۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ: قُلْتُ لِلأََسْوَدِ: مِنَ الْقُرْآنِ ہُمَا ؟ قَالَ: نَعَمْ یَعْنِی الْمُعَوِّذَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 30832","","","كتاب فضائل القرآن"
"30833","(۳۰۸۳۳) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، عَنْ إبْرَاہِیمَ بْنِ رَافِعٍ ، قَالَ: سَمِعْتُ سُلَیْمَانَ مَوْلَی أُمِّ عَلِیٍّ ، أَنَّ مُجَاہِدًا کَانَ یَکْرَہُ أَنْ یَقْرَأَ بِالْمُعَوِّذَاتِ وَحْدَہَا حَتَّی یَجْعَلَ مَعَہَا سُورَۃً أُخْرَی۔","","Musannaf Ibn Abi Shaybah 30833","","","كتاب فضائل القرآن"
"30834","(۳۰۸۳۴) حَدَّثَنَا مُطَّلِبُ بْنُ زِیَادٍ ، عَن مُحَمَّدِ بْنِ سَالِمٍ ، قَالَ: قُلْتُ لأَبِی جَعْفَرٍ: إنَّ ابْنَ مَسْعُودٍ مَحَا الْمُعَوِّذَتَیْنِ مِنْ مُصْحَفِہِ ، فَقَالَ: اقْرَأْ بِہِمَا۔","Da'if","Musannaf Ibn Abi Shaybah 30834","","","كتاب فضائل القرآن"
"30835","(۳۰۸۳۵) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا أَبُو ہِلالٍ ، قَالَ: حدَّثَنَا مَنْصُورٌ الْقَصَّابُ ، قَالَ: سَأَلْتُ الْحَسَنَ قُلْتُ: یَا أَبَا سَعِیدٍ ، أَقْرَأُ الْمُعَوِّذَتَیْنِ فِی صَلاۃِ الْفَجْرِ ؟ فقَالَ: نَعَمْ إِنْ شِئْتَ ، سُورَتَانِ مُبَارَکَتَانِ طَیِّبَتَانِ۔","","Musannaf Ibn Abi Shaybah 30835","","","كتاب فضائل القرآن"
"30836","(۳۰۸۳۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن سُفْیَانَ ، عَن مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ جُبَیْرٍ ، عَنْ أَبِیہِ ، عَن عُقْبَۃَ بْنِ عَامِرٍ ، أَنَّہُ سَأَلَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمُعَوِّذَتَیْنِ ، قَالَ: فَأَمَّنَا بِہِمَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی صَلاۃِ الْفَجْرِ۔ (ابویعلی ۱۷۲۸۔ حاکم ۲۴۰)","Sahih","Musannaf Ibn Abi Shaybah 30836","","","كتاب فضائل القرآن"
"30837","(۳۰۸۳۷) حَدَّثَنَا وَکِیعٌ ، عَن ہِشَامِ بْنِ الْغَازِ ، عَن سُلَیْمَانَ بْنِ مُوسَی ، عَن عُقْبَۃَ بْنِ عَامِرٍ ، قَالَ: کُنْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ ، فَلَمَّا طَلَعَ الْفَجْرُ أَذَّنَ وَأَقَامَ ، ثُمَّ أَقَامَنِی عَن یَمِینِہِ وَقَرَأَ بِالْمُعَوِّذَتَیْنِ فَلَمَّا انْصَرَفَ ، قَالَ: کَیْفَ رَأَیْت ؟ قُلْتُ: قَدْ رَأَیْت یَا رَسُولَ اللہِ ، قَالَ: فَاقْرَأْ بِہِمَا کُلَّمَا نِمْت وَکُلَّمَا قُمْت۔","","Musannaf Ibn Abi Shaybah 30837","","","كتاب فضائل القرآن"
"30838","(۳۰۸۳۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ: کَانَ ابْنُ مَسْعُودٍ لاَ یَکْتُبُ الْمُعَوِّذَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 30838","","","كتاب فضائل القرآن"
"30839","(۳۰۸۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ ، قَالَ ، آخِرُ سُورَۃٍ نَزَلَتْ کَامِلَۃً بَرَائَۃٌ ، وَآخِرُ آیَۃٍ نَزَلَتْ فِی الْقُرْآنِ: {یَسْتَفْتُونَک قُلَ اللَّہُ یُفْتِیکُمْ فِی الْکَلالَۃِ} ۔ (مسلم ۴۶۵۴)","Sahih","Musannaf Ibn Abi Shaybah 30839","","","كتاب فضائل القرآن"
"30840","(۳۰۸۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ السُّدِّیِّ ، قَالَ: آخِرُ آیَۃٍ نَزَلَتْ: {وَاتَّقُوا یَوْمًا تُرْجَعُونَ فِیہِ إِلَی اللہِ ثُمَّ تُوَفَّی کُلُّ نَفْسٍ مَا کَسَبَتْ وَہُمْ لاَ یُظْلَمُونَ}۔","","Musannaf Ibn Abi Shaybah 30840","","","كتاب فضائل القرآن"
"30841","(۳۰۸۴۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ عَطِیَّۃَ الْعَوْفِیِّ ، قَالَ: آخِرُ آیَۃٍ نَزَلَتْ: {وَاتَّقُوا یَوْمًا تُرْجَعُونَ فِیہِ إِلَی اللہِ ثُمَّ تُوَفَّی کُلُّ نَفْسٍ مَا کَسَبَتْ وَہُمْ لاَ یُظْلَمُونَ} ۔","","Musannaf Ibn Abi Shaybah 30841","","","كتاب فضائل القرآن"
"30842","(۳۰۸۴۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا بَشِیرٌ ، قَالَ: مَالِکٌ ، عَنْ أَبِی السَّفَرِ ، عَنِ الْبَرَائِ ، قَالَ: آخِرُ آیَۃٍ نَزَلَتْ: {یَسْتَفْتُونَک قُلَ اللَّہُ یُفْتِیکُمْ فِی الْکَلالَۃِ} ۔ (مسلم ۱۲۳۶۔ طبری ۴۲)","Hasan","Musannaf Ibn Abi Shaybah 30842","","","كتاب فضائل القرآن"
"30843","(۳۰۸۴۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ: ہی أَوَّلُ سُورَۃٍ نَزَلَتْ: {اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ} ثُمَّ (ن) ۔","","Musannaf Ibn Abi Shaybah 30843","","","كتاب فضائل القرآن"
"30844","(۳۰۸۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ ، قَالَ: آخِرُ آیَۃٍ نَزَلَتْ فِی الْقُرْآنِ: {یَسْتَفْتُونَک قُلِ اللَّہُ یُفْتِیکُمْ فِی الْکَلالَۃِ}۔","Sahih","Musannaf Ibn Abi Shaybah 30844","","","كتاب فضائل القرآن"
"30845","(۳۰۸۴۵) حَدَّثَنَا وَکِیعٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ: سَمِعْتُ عُبَیْدَ بْنَ عُمَیْرٍ یَقُولُ: أَوَّلُ مَا نَزَلَ مِنَ الْقُرْآنِ: (اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ) ثُمَّ (ن) ۔","Sahih","Musannaf Ibn Abi Shaybah 30845","","","كتاب فضائل القرآن"
"30846","(۳۰۸۴۶) حَدَّثَنَا وَکِیعٌ ، عَن قُرَّۃَ ، عَنْ أَبِی رَجَائٍ ، قَالَ: أَخَذْت مِنْ أَبِی مُوسَی: {اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ} وَہِیَ أَوَّلُ سُورَۃٍ أُنْزِلَتْ عَلَی مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 30846","","","كتاب فضائل القرآن"
"30847","(۳۰۸۴۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِیہِ ، قَالَ: کَانَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ لاَ یَفْرِضُ إِلاَّ لِمَنْ قَرَأَ الْقُرْآنَ ، قَالَ: وَکَانَ أَبِی مِمَّنْ قَرَأَ الْقُرْآنَ فَفَرَضَ لَہُ۔","","Musannaf Ibn Abi Shaybah 30847","","","كتاب فضائل القرآن"
"30848","(۳۰۸۴۸) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ الشَّیْبَانِیِّ ، عَن یُسَیْرِ بْنِ عَمْرٍو ، قَالَ: أَرَادَ سَعْدٌ أَنْ یُلْحِقَ مَنْ قَرَأَ الْقُرْآنَ عَلَی أَلْفَیْنِ أَلْفَیْنِ ، فَکَتَبَ إلَیْہِ عُمَرُ: تُعْطِی عَلَی کِتَابِ اللہِ أَجْرًا۔","Sahih","Musannaf Ibn Abi Shaybah 30848","","","كتاب فضائل القرآن"
"30849","(۳۰۸۴۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَن مُحَمَّدٍ ، قَالَ: جَمَعَ نَاسٌ الْقُرْآنَ حَتَّی بَلَغُوا عِدَّۃً ، فَکَتَبَ أَبُو مُوسَی إِلَی عُمَرَ بِذَلِکَ ، فَکَتَبَ إلَیْہِ عُمَرُ: إنَّ بَعْضَ النَّاسِ أَرْوَی لَہُ مِنْ بَعْضٍ ، وَلَعَلَّ بَعْضَ مَنْ یَقْرَؤُہُ أَنْ یَقُومَ الْمَقَامَ خَیْرٌ مِنْ قِرَائَۃِ الآخَرِ آخرَ مَا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 30849","","","كتاب فضائل القرآن"
"30850","(۳۰۸۵۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إِبْرَاہِیمَ، عَن عَلِیٍّ، أَنَّہُ کَرِہَ أَنْ یُکْتَبَ الْقُرْآنُ فِی الْمُصْحَفِ الصَّغِیرِ۔","","Musannaf Ibn Abi Shaybah 30850","","","كتاب فضائل القرآن"
"30851","(۳۰۸۵۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ بِمِثْلِہِ إِلاَّ أَنَّہُ قَالَ: الْمَصَاحِفِ۔","","Musannaf Ibn Abi Shaybah 30851","","","كتاب فضائل القرآن"
"30852","(۳۰۸۵۲) حَدَّثَنَا وَکِیعٌ قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَانَ یُقَالَ: عَظِّمُوا الْقُرْآنَ یَعْنِی: کَبِّرُوا الْمَصَاحِفَ۔","","Musannaf Ibn Abi Shaybah 30852","","","كتاب فضائل القرآن"
"30853","(۳۰۸۵۳) حَدَّثَنَا وَکِیعٌ قَالَ: حدَّثَنَا عَبْدُ الْمَلِکَ بْنُ شَدَّادٍ الأَزْدِیُّ ، عَن عُبَیْدِ اللہ بْنِ سُلَیْمَانَ الْعَبْدِیِّ ، عَنْ أَبِی حَکِیمَۃَ الْعَبْدِیِّ ، قَالَ: کُنَّا نَکْتُبُ الْمَصَاحِفَ بِالْکُوفَۃِ فَیَمُرُّ عَلَیْنَا عَلِیٌّ وَنَحْنُ نَکْتُبُ فَیَقُومُ فَیَقُولُ: أَجِلَّ قَلَمَکَ ، قَالَ: فَقَطَطْت مِنْہُ ، ثُمَّ کَتَبْتُ ، فَقَالَ: ہَکَذَا نَوِّرُوا مَا نَوَّرَ اللَّہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30853","","","كتاب فضائل القرآن"
"30854","(۳۰۸۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ: حَدَّثَنَا عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ أَبِی حَکِیمَۃَ الْعَبْدِیِّ ، قَالَ: کُنَّا نَکْتُبُ الْمَصَاحِفَ بِالْکُوفَۃِ فَیَمُرُّ عَلَیْنَا عَلِیٌّ فیقوم فَیَنْظُرُ وَیُعْجِبُہُ خَطُّنَا وَیَقُولُ: ہَکَذَا نَوِّرُوا مَا نَوَّرَ اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30854","","","كتاب فضائل القرآن"
"30855","(۳۰۸۵۵) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِاللہِ بْنِ الزُّبَیْرِ، عَن سُفْیَانَ، عَن لَیْثٍ، عَن مُجَاہِدٍ، أَنَّہُ کَرِہَ أَنْ یقال: مُصَیْحِفٌ۔","","Musannaf Ibn Abi Shaybah 30855","","","كتاب فضائل القرآن"
"30856","(۳۰۸۵۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَنْ عَبْدِ خَیْرٍ ، قَالَ: قَالَ عَلِیٌّ: یَرْحَمُ اللَّہُ أَبَا بَکْرٍ ہُوَ أَوَّلُ مَنْ جَمَعَ بَیْنَ اللَّوْحَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 30856","","","كتاب فضائل القرآن"
"30857","(۳۰۸۵۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: أَخْبَرَنَا ابْنُ عَوْنٍ ، عَن مُحَمَّدٍ ، قَالَ: لَمَّا اسْتُخْلِفَ أَبُو بَکْرٍ قَعَدَ عَلِیٌّ فِی بَیْتِہِ فَقِیلَ لأَبِی بَکْرٍ فَأَرْسَلِ إلَیْہِ: أَکَرِہْت خِلافَتِی ، قَالَ: لاَ ، لَمْ أَکْرَہْ خِلافَتَکَ ، وَلَکِنْ کَانَ الْقُرْآنُ یُزَادُ فِیہِ ، فَلَمَّا قُبِضَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَعَلْت عَلَیّ أَنْ لاَ أَرْتَدِیَ إِلاَّ لِصَلاۃٍ حَتَّی أَجْمَعَہُ لِلنَّاسِ، فَقَالَ أَبُو بَکْرٍ: نِعْمَ مَا رَأَیْت۔","","Musannaf Ibn Abi Shaybah 30857","","","كتاب فضائل القرآن"
"30858","(۳۰۸۵۸) حَدَّثَنَا قَبِیصَۃُ ، قَالَ: حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَن مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَن صَعْصَعَۃَ ، قَالَ: أَوَّلُ مَنْ جَمَعَ بَیْنَ اللَّوْحَیْنِ وَوَرَّثَ الْکَلالَۃَ أَبُو بَکْرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 30858","","","كتاب فضائل القرآن"
"30859","(۳۰۸۵۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن مُحَمَّدِ بْنِ عَجْلانَ ، عَن سَعِیدِ بْنِ أَبِی سَعِیدٍ ، قَالَ: قَالَ أُبَیٌّ: إذَا حَلَّیْتُمْ مَصَاحِفَکُمْ وَزَوَّقْتُمْ مَسَاجِدَکُمْ فَالدَّبَارُ عَلَیْکُمْ۔","","Musannaf Ibn Abi Shaybah 30859","","","كتاب فضائل القرآن"
"30860","(۳۰۸۶۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: حدَّثَنَا قُطْبَۃُ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ عَاصِمٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ رَأَی مُصْحَفًا یُحَلَّی فَقَالَ: تُغْرُونَ بِہِ السُّرَّاقَ ، زِینَتُہُ فِی جَوْفِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 30860","","","كتاب فضائل القرآن"
"30861","(۳۰۸۶۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یُحَلَّی الْمُصْحَفُ۔","","Musannaf Ibn Abi Shaybah 30861","","","كتاب فضائل القرآن"
"30862","(۳۰۸۶۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی وَائِلٍ ، قَالَ: أُتِیَ عَبْدُ اللہِ بِمُصْحَفٍ قَدْ زُیِّنَ بِالذَّہَبِ فَقَالَ عَبْدُ اللہِ: إنَّ أَحْسَنَ مَا زُیِّنَ بِہِ الْمُصْحَفُ تِلاوَتُہُ فی الْحَقِّ۔","Hasan","Musannaf Ibn Abi Shaybah 30862","","","كتاب فضائل القرآن"
"30863","(۳۰۸۶۳) حَدَّثَنَا عَبْدَۃُ ، عَنِ الزِّبْرِقَانِ ، قَالَ: قُلْتُ لأَبِی رَزِینٍ: إنَّ عِنْدِی مُصْحَفًا أُرِیدُ أَنْ أَخْتِمَہُ بِالذَّہَبِ ، قَالَ: لاَ تَزِیدَنَّ فِیہِ شَیْئًا مِنْ أَمْرِ الدُّنْیَا قَلَّ ، وَلا کَثُرَ۔","","Musannaf Ibn Abi Shaybah 30863","","","كتاب فضائل القرآن"
"30864","(۳۰۸۶۴) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَن سعید بن أَبِی سعید ، قَالَ: قَالَ أَبُو ذَرٍّ: إذا زَوَّقْتُمْ مَسَاجِدَکُمْ وَحَلَّیْتُمْ مَصَاحِفَکُمْ فَالدَّبَارُ عَلَیْکُمْ۔","","Musannaf Ibn Abi Shaybah 30864","","","كتاب فضائل القرآن"
"30865","(۳۰۸۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَحْوَصِ بْنِ حَکِیمٍ ، عَنْ أَبِی الزَّاہِرِیَّۃِ ، عَنْ أَبِی أُمَامَۃَ ، أَنَّہُ کَرِہَ أَنْ یُحَلَّی الْمُصْحَفُ۔","Da'if","Musannaf Ibn Abi Shaybah 30865","","","كتاب فضائل القرآن"
"30866","(۳۰۸۶۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ ابن أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ: أَتَیْتُ عَبْدَ الرَّحْمَن بْنَ أَبِی لَیْلَی بِتِبْرٍ فَقَالَ: ہَلْ عَسَیْت أَنْ تُحَلِّی بِہِ مُصْحَفًا۔","","Musannaf Ibn Abi Shaybah 30866","","","كتاب فضائل القرآن"
"30867","(۳۰۸۶۷) حَدَّثَنَا مُعَاذٌ ، عَنِ ابْنِ عَوْنٍ ، عَن مُحَمَّدٍ ، قَالَ: لاَ بَأْسَ أَنْ یُحَلَّی الْمُصْحَفُ۔","","Musannaf Ibn Abi Shaybah 30867","","","كتاب فضائل القرآن"
"30868","(۳۰۸۶۸) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، عَن یَحْیَی ، عَن مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، أَنَّہُ کَرِہَ التَّعْشِیرَ فِی الْمُصْحَفِ۔","Sahih","Musannaf Ibn Abi Shaybah 30868","","","كتاب فضائل القرآن"
"30869","(۳۰۸۶۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَانَ یَکْرَہُ التَّعْشِیرَ فِی الْمُصْحَفِ وَأَنْ یُکْتَبَ فِیہِ شَیْئٌ مِنْ غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 30869","","","كتاب فضائل القرآن"
"30870","(۳۰۸۷۰) حَدَّثَنَا أَبُو خَالِدٍ ، عَن حَجَّاجٍ ، عَن حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 30870","","","كتاب فضائل القرآن"
"30871","(۳۰۸۷۱) حَدَّثَنَا الْمُحَارِبِیُّ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یُکْتَبَ تَعْشِیرٌ ، أَوْ تَفْصِیلٌ ، وَیَقُولُ: سُورَۃُ الْبَقَرَۃِ ، وَیَقُولُ: السُّورَۃُ الَّتِی تُذْکَرُ فِیہَا الْبَقَرَۃُ۔","","Musannaf Ibn Abi Shaybah 30871","","","كتاب فضائل القرآن"
"30872","(۳۰۸۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ ، أَنَّہُ کَرِہَ التَّعْشِیرَ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 30872","","","كتاب فضائل القرآن"
"30873","(۳۰۸۷۳) حَدَّثَنَا عَبْدَۃُ ، عَنِ الزِّبْرِقَانِ ، قَالَ: قُلْتُ لأَبِی رَزِینٍ: إنَّ عِنْدِی مُصْحَفًا أُرِیدُ أَنْ أَخْتِمَہُ بِالذَّہَبِ ، وَأَکْتُبَ عِنْدَ أَوَّلِ سُورَۃٍ آیَۃُ کَذَا وَکَذَا ، فقَالَ أَبُو رَزِینٍ: لاَ تَزِیدَنَّ فِیہِ شَیْئًا مِنْ أَمْرِ الدُّنْیَا قَلَّ ، وَلا کَثُرَ۔","","Musannaf Ibn Abi Shaybah 30873","","","كتاب فضائل القرآن"
"30874","(۳۰۸۷۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن ہِشَامٍ ، عَن مُحَمَّدٍ ، أَنَّہُ کَانَ یَکْرَہُ الْفَوَاتِحَ وَالْعَوَاشِرَ الَّتِی فِیہَا قَافٌ وَکَافٌ۔","","Musannaf Ibn Abi Shaybah 30874","","","كتاب فضائل القرآن"
"30875","(۳۰۸۷۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ التَّعْشِیرَ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 30875","","","كتاب فضائل القرآن"
"30876","(۳۰۸۷۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ النَّقْطَ وَخَاتِمَۃَ سُورَۃِ کَذَا وَکَذَا۔","","Musannaf Ibn Abi Shaybah 30876","","","كتاب فضائل القرآن"
"30877","(۳۰۸۷۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَن حَجَّاجٍ ، عَن شَیْخٍ ، عَنْ عَبْدِ اللہِ ، أَنَّہُ رَأَی خَطَأً فِی الْمُصْحَفِ فَحَکَّہُ ، وَقَالَ: لاَ تَخْلِطُوا فِیہِ غَیْرَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30877","","","كتاب فضائل القرآن"
"30878","(۳۰۸۷۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن حَجَّاجٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَانَ یَکْرَہُ التَّعْشِیرَ فِی الْمُصْحَفِ ، وَأَنْ یُکْتَبَ فِیہِ شَیْئٌ مِنْ غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 30878","","","كتاب فضائل القرآن"
"30879","(۳۰۸۷۹) حَدَّثَنَا عَفَّانُ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ، عَن شُعَیْبِ بْنِ الْحَبْحَابِ، أَنَّ أَبَا الْعَالِیَۃِ کَانَ یَکْرَہُ الْعَوَاشِرَ۔","","Musannaf Ibn Abi Shaybah 30879","","","كتاب فضائل القرآن"
"30880","(۳۰۸۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَن سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ أَبِی الزَّعْرَائِ ، عَنْ عَبْدِ اللہِ ، قَالَ: جَرِّدُوا الْقُرْآنَ ، وَلا تُلْبِسُوا بِہِ مَا لَیْسَ مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30880","","","كتاب فضائل القرآن"
"30881","(۳۰۸۸۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ: قَالَ عَبْدُ اللہِ: جَرِّدُوا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 30881","","","كتاب فضائل القرآن"
"30882","(۳۰۸۸۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَانَ یُقَالُ: جَرِّدُوا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 30882","","","كتاب فضائل القرآن"
"30883","(۳۰۸۸۳) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ: قُلْتُ لِعَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ: مَا یَمْنَعُک أَنْ تَکُونَ سَأَلْت کَمَا سَأَلَ إبْرَاہِیمُ ؟ قَالَ: فَقَالَ: کَانَ یُقَالُ: جَرِّدُوا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 30883","","","كتاب فضائل القرآن"
"30884","(۳۰۸۸۴) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَن حُمَیْدٍ الطَّوِیلِ ، عَن مُعَاوِیَۃَ بْنِ قُرَّۃَ ، عَنْ أَبِی الْمُغِیرَۃِ ، قَالَ: قرَأَ رَجُلٌ عِنْدَ ابْنِ مَسْعُودٍ فَقَالَ: أَسْتَعِیذُ بِالسَّمِیعِ الْعَلِیمِ مِنَ الشَّیْطَانِ الرَّجِیمِ فَقَالَ عَبْدُ اللہِ: جَرِّدُوا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 30884","","","كتاب فضائل القرآن"
"30885","(۳۰۸۸۵) حَدَّثَنَا مَالِکٌ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ، عَن شُعَیْبِ بْنِ الْحَبْحَابِ، أَنَّ أَبَا الْعَالِیَۃِ، قَالَ: جَرِّدُوا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 30885","","","كتاب فضائل القرآن"
"30886","(۳۰۸۸۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ عَوْفٍ ، عَنْ زِیَادِ بْنِ مِخْرَاقٍ ، عَنْ أَبِی کِنَانَۃَ ، عَنْ أَبِی مُوسَی الأَشْعَرِیِّ ، قَالَ: إِنَّ مِنْ إجْلالِ اللہِ إکْرَامُ حَامِلِ الْقُرْآنِ غَیْرِ الْغَالِی فِیہِ ، وَلا الْجَافِی عَنْہُ۔ (ابوداؤد ۴۸۱۰۔ بیہقی ۱۶۳)","Da'if","Musannaf Ibn Abi Shaybah 30886","","","كتاب فضائل القرآن"
"30887","(۳۰۸۸۷) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ: مَرَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی بِلالٍ وَہُوَ یَقْرَأُ مِنْ ہَذِہِ السُّورَۃِ وَمِنْ ہَذِہِ السُّورَۃِ ، فَقَالَ: مَرَرْتُ بِکَ یَا بِلالُ وَأَنْتَ تَقْرَأُ مِنْ ہَذِہِ السُّورَۃِ وَمِنْ ہَذِہِ السُّورَۃِ ، فَقَالَ: بِأَبِی أَنْتَ یَا رَسُولَ اللہِ إنِّی أَرَدْت أَنْ أَخْلِطَ الطَّیِّبَ بِالطَّیِّبِ: فَقَالَ: اقْرَأ السُّورَۃَ عَلَی نَحْوِہَا۔","","Musannaf Ibn Abi Shaybah 30887","","","كتاب فضائل القرآن"
"30888","(۳۰۸۸۸) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ: کَانَ مُعَاذٌ یَخْلِطُ مِنْ ہَذِہِ السُّورَۃِ وَمِنْ ہَذِہِ السُّورَۃِ ، فَقِیلَ لَہُ، فَقَالَ: أَتَرُونِی أَخْلِطُ فِیہِ مَا لَیْسَ مِنْہُ ؟۔","","Musannaf Ibn Abi Shaybah 30888","","","كتاب فضائل القرآن"
"30889","(۳۰۸۸۹) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَن زَیْدِ بْنِ یُثَیْعٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ بِبِلالٍ ، ثُمَّ ذَکَرَ نَحْوًا مِنْ حَدِیثِ حَاتِمٍ۔","Hasan","Musannaf Ibn Abi Shaybah 30889","","","كتاب فضائل القرآن"
"30890","(۳۰۸۹۰) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ: سُئِل محمد عَن الذی یَقْرَأَ من ہَاہُنَا ومن ہَاہُنَا ؟ فقَالَ: لیتق لاَ یأثم إثم عظیم وہو لاَ یشعر۔","","Musannaf Ibn Abi Shaybah 30890","","","كتاب فضائل القرآن"
"30891","(۳۰۸۹۱) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَن أشعث ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَقْرَأَ فِی سُورَتَیْنِ حَتَّی یَخْتِمَ آخِرَتَہَا ، ثُمَّ یَأْخُذُ فِی الأُخْرَی۔","","Musannaf Ibn Abi Shaybah 30891","","","كتاب فضائل القرآن"
"30892","(۳۰۸۹۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، قَالَ: حدَّثَنِی الْوَلِیدُ بْنُ جُمَیْعٍ، قَالَ: حَدَّثَنِی رَجُلٌ، أَنَّہُ أَمَّ النَّاسَ بِالْحِیرَۃِ خَالِدُ بْنُ الْوَلِیدِ ، ثُمَّ قَرَأَ مِنْ سُوَرٍ شَتَّی ، ثُمَّ الْتَفَتَ إلَیْنَا حِینَ انْصَرَفَ فَقَالَ: شَغَلَنَا الْجِہَادُ ، عَن تَعْلِیمِ الْقُرْآنِ۔","Da'if","Musannaf Ibn Abi Shaybah 30892","","","كتاب فضائل القرآن"
"30893","(۳۰۸۹۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْہُذَیْلِ ، قَالَ: کَانُوا یَکْرَہُونَ أَنْ یَقَرَؤُوا بَعْضَ الآیَۃِ وَیَتْرُکُوا بَعْضَہَا۔","","Musannaf Ibn Abi Shaybah 30893","","","كتاب فضائل القرآن"
"30894","(۳۰۸۹۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن سُفْیَانَ ، عَنْ عَطَائٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، أَنَّہُ کَرِہَ أَنْ یَقُولَ: أَسْقَطْت آیَۃَ کَذَا وَکَذَا۔","","Musannaf Ibn Abi Shaybah 30894","","","كتاب فضائل القرآن"
"30895","(۳۰۸۹۵) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا سَعِیدُ بْنُ زَیْد ، قَالَ: حَدَّثَنَا عَمْرُو بْنُ مَالِکٍ ، عَنْ أَبِی الْجَوْزَائِ ، قَالَ: نَقْلُ الْحِجَارَۃِ أَہْوَنُ عَلَی الْمُنَافِقِ مِنْ قِرَائَۃِ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30895","","","كتاب فضائل القرآن"
"30896","(۳۰۸۹۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، قَالَ: حدَّثَنِی زَیْدُ بْنُ عَلِیٍّ ، قَالَ: مَرَرْت بِأَبِی جَعْفَرٍ وَہُوَ فِی دَارِہِ وَہُوَ یَقُولُ: اللَّہُمَّ اغْفِرْ لِی بِالْقُرْآنِ اللَّہُمَّ ارْحَمْنِی بِالْقُرْآنِ اللَّہُمَّ اہْدِنِی بِالْقُرْآنِ اللَّہُمَّ ارْزُقْنِی بِالْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30896","","","كتاب فضائل القرآن"
"30897","(۳۰۸۹۷) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ أَبِی إِسْحَاقَ، عَن عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: قَالَ أَبُو بَکْرٍ: یَا رَسُولَ اللہِ، مَا شَیَّبَکَ؟ قَالَ: شَیَّبَنِی ہُودٌ وَالْوَاقِعَۃُ وَالْمُرْسَلاتُ وَعَمَّ یَتَسَائَلُونَ وَإذَا الشَّمْسُ کُوِّرَتْ۔ (ابویعلی ۱۰۲)","","Musannaf Ibn Abi Shaybah 30897","","","كتاب فضائل القرآن"
"30898","(۳۰۸۹۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ وَقَبِیصَۃُ ، عَن سُفْیَانَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، عَن حُذَیْفَۃَ ، قَالَ: یَقُولُونَ سُورَۃُ التَّوْبَۃِ وَہِیَ سُورَۃُ الْعَذَابِ یَعْنِی بَرَائَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 30898","","","كتاب فضائل القرآن"
"30899","(۳۰۸۹۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَن عِکْرِمَۃَ ، قَالَ: مَا زَالَتْ بَرَائَۃُ تَنْزِلُ حَتَّی أَشْفَقَ مِنْہَا أصحاب مُحَمَّدٌ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَکَانَتْ تُسَمَّی الْفَاضِحَۃَ۔","","Musannaf Ibn Abi Shaybah 30899","","","كتاب فضائل القرآن"
"30900","(۳۰۹۰۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنِ الْمُسَیَّبِ ، قَالَ: قَالَ عَبْدُ اللہِ: الطُّوَّلُ کَالتَّوْرَاۃِ ، وَالْمِئِونَ کَالإِنْجِیلِ ، وَالْمَثَانِی کَالزَّبُورِ ، وَسَائِرُ الْقُرْآنِ فَضْلٌ۔","","Musannaf Ibn Abi Shaybah 30900","","","كتاب فضائل القرآن"
"30901","(۳۰۹۰۱) حَدَّثَنَا وَکِیعٌ، عَنِ الأَعْمَشِ، عَن سَعِیدِ بْنِ جُبَیْرٍ: {وَلَقَدْ کَتَبْنَا فِی الزَّبُورِ} قَالَ: الْقُرْآنُ والتَّوْرَاۃُ وَالإِنْجِیلُ۔","","Musannaf Ibn Abi Shaybah 30901","","","كتاب فضائل القرآن"
"30902","(۳۰۹۰۲) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَن دَاوُد ، عَنِ الشَّعْبِیِّ: {وَلَقَدْ کَتَبْنَا فِی الزَّبُورِ مِنْ بَعْدِ الذِّکْرِ} قَالَ: زَبُورِ دَاوُد مِنْ بَعْدِ ذِکْرِ مُوسَی۔","","Musannaf Ibn Abi Shaybah 30902","","","كتاب فضائل القرآن"
"30903","(۳۰۹۰۳) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا ہَمَّامٌ ، قَالَ سَمِعْت أَبَا عِمْرَانَ الْجَوْنِیَّ ، قَالَ: حَدَّثَنَا عَبْدُ اللہِ بْنُ رَبَاحٍ ، قَالَ: سَمِعْتُ کَعْبًا یَقُولُ: فَاتِحَۃُ التَّوْرَاۃِ فَاتِحَۃُ سُورَۃِ الأَنْعَامِ ، وَخَاتِمَۃُ التَّوْرَاۃِ خَاتِمَۃُ سُورَۃِ ہُودٍ۔","","Musannaf Ibn Abi Shaybah 30903","","","كتاب فضائل القرآن"
"30904","(۳۰۹۰۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَن دَاوُد ، عَنِ الشَّعْبِیِّ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ: إذَا شَکَکْتُمْ فِی الْیَائِ وَالتَّائِ فَاجْعَلُوہَا یَائً فَإِنَّ الْقُرْآنَ ذَکَرٌ فَذَکِّرُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30904","","","كتاب فضائل القرآن"
"30905","(۳۰۹۰۵) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ: حدَّثَنَا أَبُو نِزَارٍ الْمُرَادِیُّ ، عَنْ عَمْرِو بْنِ مَیْسَرَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ السُّلَمِیِّ ، قَالَ: إذَا اخْتَلَفْتُمْ فِی الْقُرْآنِ فِی یَائٍ ، أَوْ تَائٍ فَاجْعَلُوہَا یَائً فَإِنَّ الْقُرْآنَ نَزَلَ عَلَی الْیَائِ۔","","Musannaf Ibn Abi Shaybah 30905","","","كتاب فضائل القرآن"
"30906","(۳۰۹۰۶) حَدَّثَنَا مُعَاوِیَۃُ بْنُ عُمَر ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ: إذَا تَمَارَیْتُمْ فِی الْقُرْآنِ فِی یَائٍ ، أَوْ تَائٍ فَاجْعَلُوہَا یَائً وَذَکِّرُوا الْقُرْآنَ فَإِنَّہُ مُذَکَّرٌ۔","Da'if","Musannaf Ibn Abi Shaybah 30906","","","كتاب فضائل القرآن"
"30907","(۳۰۹۰۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَن یَحْیَی بْنِ جَعْدَۃَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ: الْقُرْآنُ ذَکَرٌ فَذَکِّرُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30907","","","كتاب فضائل القرآن"
"30908","(۳۰۹۰۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ: کَانَ الْغُلامُ إذَا أَفْصَحَ مِنْ بَنِی عَبْدِ الْمُطَّلِبِ عَلَّمَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ہَذِہِ الآیَۃَ سَبْعًا: {الْحَمْدُ لِلَّہِ الَّذِی لَمْ یَتَّخِذْ وَلَدًا وَلَمْ یَکُنْ لَہُ شَرِیکٌ فِی الْمُلْکِ وَلَمْ یَکُنْ لَہُ وَلِیٌّ مِنَ الذُّلِّ وَکَبِّرْہُ تَکْبِیرًا}۔","","Musannaf Ibn Abi Shaybah 30908","","","كتاب فضائل القرآن"
"30909","(۳۰۹۰۹) حَدَّثَنَا عُمَرُ بْنُ سَعْدٍ أَبُو دَاوُدَ ، عَن سُفْیَانَ ، عَنِ الْحَسَنِ بْنِ عَمْرِو: جَاء بی أبی إلی سعید بن جبیر وأنا صغیر ، فقال: تُعَلِّمْ ہذا الْقُرْآنَ ؟۔","","Musannaf Ibn Abi Shaybah 30909","","","كتاب فضائل القرآن"
"30910","(۳۰۹۱۰) حَدَّثَنَا عُمَرُ بْنُ سَعْدٍ ، عَن سُفْیَانَ ، عَنِ الْحَسَنِ بْنِ عَمْرِو ، عَن فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَانُوا یَکْرَہُونَ أَنْ یُعَلِّمُوا أَوْلادَہُم الْقُرْآنَ حَتَّی یَعْقِلُوا۔","","Musannaf Ibn Abi Shaybah 30910","","","كتاب فضائل القرآن"
"30911","(۳۰۹۱۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَن سَالِمٍ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: لاَ حَسَدَ إِلاَّ فِی اثْنَتَیْنِ: رَجُلٍ آتَاہُ اللَّہُ مَالاً ، فَہُوَ یُنْفِقُہُ آنَائَ اللَّیْلِ وَأَنَائَ النَّہَارِ ، وَرَجُلٍ عَلَّمَہُ اللَّہُ الْقُرْآنَ ، فَہُوَ یَقُومُ بِہِ آنَائَ اللَّیْلِ وَآنَائَ النَّہَارِ۔ (بخاری ۵۰۲۵۔ مسلم ۵۵۸)","Sahih","Musannaf Ibn Abi Shaybah 30911","","","كتاب فضائل القرآن"
"30912","(۳۰۹۱۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: حدَّثَنَا یَزِیدُ بْنُ عَبْدِ الْعَزِیزِ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی سَعِیدٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ حَسَدَ إِلاَّ فِی اثْنَتَیْنِ: رَجُلٍ آتَاہُ اللَّہُ الْقُرْآنَ ، فَہُوَ یَتْلُوہُ آنَائَ اللَّیْلِ وَآنَائَ النَّہَارِ ، فَیَقُولُ الرَّجُلُ: لَوْ آتَانِی اللَّہُ مِثْلَ مَا آتَی فُلانًا فَعَلْت مِثْلَ مَا یَفْعَلُ ، وَرَجُلٍ آتَاہُ اللَّہُ مَالاً ، فَہُوَ یُنْفِقُہُ فِی حَقِّہِ فَیَقُولُ الرَّجُلُ: لَوْ آتَانِی اللَّہُ مِثْلَ مَا آتَی فُلانًا فَعَلْت مِثْلَ مَا یَفْعَلُ۔ (احمد ۴۷۹۔ ابویعلی ۱۰۸۰)","Sahih","Musannaf Ibn Abi Shaybah 30912","","","كتاب فضائل القرآن"
"30913","(۳۰۹۱۳) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ: قَالَ عَبْدُ اللہِ: (حم) دِیبَاجُ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 30913","","","كتاب فضائل القرآن"
"30914","(۳۰۹۱۴) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَن مِسْعَرٍ ، عَن سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ: کُنَّ الْحَوَامِیمُ یُسَمَّیْنَ الْعَرَائِسَ۔","","Musannaf Ibn Abi Shaybah 30914","","","كتاب فضائل القرآن"
"30915","(۳۰۹۱۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَوَکِیعٌ ، عَن مِسْعَرٍ ، عَن مَعْنِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ: قَالَ عَبْدُ اللہِ: إذَا وَقَعَتْ فِی آلْ (حم) وَقَعْتُ فِی رَوْضَاتٍ دَمِثَاتٍ أَتَأَنَّقُ فِیہِنَّ۔","","Musannaf Ibn Abi Shaybah 30915","","","كتاب فضائل القرآن"
"30916","(۳۰۹۱۶) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ ، عَن حَبِیبٍ ، عَن رَجُلٍ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ: مَرَّ عَلَیْہِ وَہُوَ یَبْنِی مَسْجِدًا فَقَالَ: مَا ہَذَا ؟ قَالَ: ہَذَا لآلِ (حم) ۔","Da'if","Musannaf Ibn Abi Shaybah 30916","","","كتاب فضائل القرآن"
"30917","(۳۰۹۱۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن شِبْلٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ: عَرَضْت الْقُرْآنَ عَلَی ابْنِ عَبَّاسٍ ثَلاثَ عَرْضَاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 30917","","","كتاب فضائل القرآن"
"30918","(۳۰۹۱۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا محمد بن إسحاق عن أبان بن صالح ، عَن مُجَاہِدٍ ، قَالَ: عَرَضْت الْقُرْآنَ عَلَی ابْنِ عَبَّاسٍ مِنْ فَاتِحَتِہِ إِلَی خَاتِمَتِہِ ثَلاثَ عَرْضَاتٍ أَقفہُ عِنْدَ کُلِّ آیَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 30918","","","كتاب فضائل القرآن"
"30919","(۳۰۹۱۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَعْرِضُ الْقُرْآنَ فِی کُلِّ رَمَضَانَ مَرَّۃً إِلاَّ الْعَامَ الَّذِی قُبِضَ فِیہِ فَإِنَّہُ عُرِضَ عَلَیْہِ مَرَّتَیْنِ بِحَضْرَۃِ عَبْدِ اللہِ فَشَہِدَ مَا نُسِخَ مِنْہُ ، وَمَا بُدِّلَ۔ (احمد ۳۶۲۔ ابویعلی ۲۵۵)","Sahih","Musannaf Ibn Abi Shaybah 30919","","","كتاب فضائل القرآن"
"30920","(۳۰۹۲۰) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَن عُبَیْدِ اللہِ بْنِ عبْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَعْرِضُ الْکِتَابَ فِی کُلِّ رَمَضَانَ عَلَی جِبْرِیلَ ، فَلَمَّا کَانَ الشَّہْرُ الَّذِی ہَلَکَ فِیہِ عَرَضَہُ عَلَیْہِ عَرْضَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 30920","","","كتاب فضائل القرآن"
"30921","(۳۰۹۲۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ: حدَّثَنَا مُوسَی بْنُ عُلَیٍّ ، قَالَ: سَمِعْتُ أَبِی یَقُولُ: أَمْسَکْت عَلَی فَضَالَۃَ بْنِ عُبَیْدٍ الْقُرْآنَ حَتَّی فَرَغَ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30921","","","كتاب فضائل القرآن"
"30922","(۳۰۹۲۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنِ ابْنِ عُیَیْنَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، وَعَنِ ابْنِ سِیرِینَ ، عَن عَبِیْدَۃَ ، قَالَ: الْقِرَائَۃُ الَّتِی عُرِضَتْ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْعَامِ الَّذِی قُبِضَ فِیہِ ہِیَ الْقِرَائَۃُ الَّتِی یَقْرَؤُہَا النَّاسُ الْیَوْمَ۔","","Musannaf Ibn Abi Shaybah 30922","","","كتاب فضائل القرآن"
"30923","(۳۰۹۲۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ: کَانَ جِبْرِیلُ یَعْرِضُ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْقُرْآنَ فِی کُلِّ عَامٍ مَرَّۃً فِی رَمَضَانَ ، فَلَمَّا کَانَ الْعَامُ الَّذِی قُبِضَ فِیہِ عَرَضَہُ عَلَیْہِ مَرَّتَیْنِ۔n(بخاری ۳۶۲۴۔ مسلم ۱۹۰۵)","","Musannaf Ibn Abi Shaybah 30923","","","كتاب فضائل القرآن"
"30924","(۳۰۹۲۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ ، عَن فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، عَنْ فَاطِمَۃَ ، قَالَتْ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَعْرِضُ الْقُرْآنَ عَلَی جِبْرِیلَ فِی کُلِّ عَامٍ مَرَّۃً ، فَلَمَّا کَانَ الْعَامُ الَّذِی قُبِضَ فِیہِ عَرَضَہُ عَلَیْہِ مَرَّتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 30924","","","كتاب فضائل القرآن"
"30925","(۳۰۹۲۵) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، قَالَ: لِکُلِّ شَیْئٍ لُبَابٌ وَإِنَّ لُبَابَ الْقُرْآنِ الْمُفَصَّلُ۔","Sahih","Musannaf Ibn Abi Shaybah 30925","","","كتاب فضائل القرآن"
"30926","(۳۰۹۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، عَن سُلَیْمَانَ بْنِ مَیْسَرَۃَ ، عَن طَارِقِ بْنِ شِہَابٍ ، قَالَ: قَالَ سَلْمَانُ لِزَیْدِ بْنِ صُوحَانَ: کَیْفَ أَنْتَ إذَا اقْتَتَلَ الْقُرْآنُ وَالسُّلْطَانُ ؟ قَالَ: إذًا أَکُونُ مَعَ الْقُرْآنِ ، قَالَ: نِعْمَ الزُّویَیْدُ: إذًا أَنْتَ۔","Sahih","Musannaf Ibn Abi Shaybah 30926","","","كتاب فضائل القرآن"
"30927","(۳۰۹۲۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن شِمْرٍ ، عَن شَہْرِ بْنِ حَوْشَبٍ ، عَن کَعْبٍ ، قَالَ: یَقْتَتِلُ الْقُرْآنُ وَالسُّلْطَانُ قَالَ: فَیَطَأُ السُّلْطَانُ عَلَی صِمَاخِ الْقُرْآنِ فَلأْیًا بِلأْیِ ،وَلأْیًا بِلأی ،مَا تَنْفَلتُنَّ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 30927","","","كتاب فضائل القرآن"
"30928","(۳۰۹۲۸) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ: حدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللہِ بن مسعود ، قَالَ: أَتَی ابْنَ مَسْعُودٍ رَجُلٌ فَقَالَ: یَا أَبَا عَبْدِ الرَّحْمَنِ ، عَلِّمْنِی کَلِمَاتٍ جَوَامِعَ نَوَافِعَ ، قَالَ تَعَبَّدَ اللَّہَ ، وَلا تُشْرِکْ بِہِ شَیْئًا وَتَزُولُ مَعَ الْقُرْآنِ حَیْثُ زَال۔","","Musannaf Ibn Abi Shaybah 30928","","","كتاب فضائل القرآن"
"30929","(۳۰۹۲۹) حَدَّثَنَا مُعَاوِیَۃَ بْنَ ہِشَامٍ ، قَالَ: حَدَّثَنَا سُفْیَانُ ، عَنْ جَبَلَۃَ بْنِ سُحَیْمٍ ، عَنْ عَامِرِ بْنِ مَطَرٍ ، قَالَ: کُنْتُ مَعَ حُذَیْفَۃَ فَقَالَ: کَیْفَ أَنْتَ یَا عَامِرُ بْنُ مَطَرٍ إذَا أَخَذَ النَّاسُ طَرِیقًا وَالْقُرْآنُ طَرِیقًا مَعَ أَیِّہِمَا تَکُونُ ؟ فَقُلْتُ: مَعَ الْقُرْآنِ أَحْیَا مَعَہُ ، أو أَمُوتُ ، قَالَ: فَأَنْتَ إذًا۔","Sahih","Musannaf Ibn Abi Shaybah 30929","","","كتاب فضائل القرآن"
"30930","(۳۰۹۳۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، قَالَ: حدَّثَنَا مَعْنٌ ، قَالَ: أَتَی رَجُلٌ ابْنَ مَسْعُودٍ فَقَالَ: عَلِّمْنِی کَلِمَاتٍ جَوَامِعَ نَوَافِعَ ، قَالَ: تَعَبَّدَ اللَّہَ ، وَلا تُشْرِکْ بِہِ شَیْئًا ، وَتَزُولُ مَعَ الْقُرْآنِ حَیْثُ زَالَ۔","","Musannaf Ibn Abi Shaybah 30930","","","كتاب فضائل القرآن"
"30931","(۳۰۹۳۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَانَ أَصْحَابُ عَبْدِ اللہِ الَّذِینَ یُفْتُونَ وَیَقْرَؤُونَ الْقُرْآنَ: عَلْقَمَۃَ وَالأَسْوَدَ وَعُبَیْدَۃَ وَمَسْرُوقًا وَعَمْرَو بْنَ شُرَحْبِیلَ وَالْحَارِثَ بْنَ قَیْسٍ۔","","Musannaf Ibn Abi Shaybah 30931","","","كتاب فضائل القرآن"
"30932","(۳۰۹۳۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَن مَسْرُوقٍ ، قَالَ: کَانَ عَبْدُ اللہِ یُقْرِئُنَا الْقُرْآنَ فِی الْمَسْجِدِ ، ثُمَّ یَجْلِسُ بَعْدَہُ یثبت النَّاسَ۔","Sahih","Musannaf Ibn Abi Shaybah 30932","","","كتاب فضائل القرآن"
"30933","(۳۰۹۳۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ حُمَیْدٍ ، قَالَ سَمِعْت أَبَا إِسْحَاقَ یَقُولُ: أَقْرَأَ أَبُو عَبْدِ الرَّحْمَنِ السُّلَمِیُّ الْقُرْآنَ فِی الْمَسْجِدِ أَرْبَعِینَ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 30933","","","كتاب فضائل القرآن"
"30934","(۳۰۹۳۴) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَن عَبِیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ: قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: اقْرَأْ عَلَیَّ الْقُرْآنَ ، فَقُلْتُ: أَقْرَأُ عَلَیْک وَعَلَیْک أُنْزِلَ ، قَالَ: إنِّی أَشْتَہِی أَنْ أَسْمَعَہُ مِنْ غَیْرِی ، قَالَ: فَقَرَأْت عَلَیْہِ النِّسَائَ حَتَّی بَلَغْت: {فَکَیْفَ إذَا جِئْنَا مِنْ کُلِّ أُمَّۃٍ بِشَہِیدٍ وَجِئْنَا بِکَ عَلَی ہَؤُلائِ شَہِیدًا} رَفَعْت رَأْسِی ، أَوْ غَمَزَنِی رَجُلٌ إِلَی جَنْبِی فَرَفَعْت رَأْسِی فَرَأَیْتُ عَیْنَیْہِ تَسِیلُ۔n(بخاری ۴۵۸۲۔ مسلم ۵۵۱)","Sahih","Musannaf Ibn Abi Shaybah 30934","","","كتاب فضائل القرآن"
"30935","(۳۰۹۳۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن حُصَیْنٍ ، عَن ہِلالِ بْنِ یَسَافٍ ، عَنْ أَبِی حَیَّانَ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوٍ مِنْ حَدِیثِ الأَعْمَشِ۔ (احمد ۳۷۴۔ ابویعلی ۵۱۲۸)","Da'if","Musannaf Ibn Abi Shaybah 30935","","","كتاب فضائل القرآن"
"30936","(۳۰۹۳۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، عَنْ عَبْدِ اللہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لَہُ: اقْرَأ ، فَافْتَتَحَ سُورَۃَ النِّسَائِ حَتَّی إذَا بَلَغَ إِلَی قولہ تعالی: {فَکَیْفَ إذَا جِئْنَا مِنْ کُلِّ أُمَّۃٍ بِشَہِیدٍ وَجِئْنَابِکَ عَلَی ہَؤُلائِ شَہِیدًا} الآیۃ قَالَ: فَدَمَعَتْ عَیْنَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ: حَسْبُک۔n(نسائی ۸۰۷۷۔ طبرانی ۸۴۵۹)","Da'if","Musannaf Ibn Abi Shaybah 30936","","","كتاب فضائل القرآن"
"30937","(۳۰۹۳۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَجْلَحِ ، عَنِ ابْنِ أَبْزَی ، عَنْ أَبِیہِ ، قَالَ: سَمِعْتُ أُبَیَّ بْنَ کَعْبٍ یَقُولُ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أُمِرْت أَنْ أَعْرِضَ عَلَیْک الْقُرْآنَ ، قَالَ: سَمَّانِی لَکَ ربک ، قَالَ: نَعَمْ ، فَقَالَ: أُبَیٌّ: {بِفَضْلِ اللہِ وَبِرَحْمَتِہِ فَبِذَلِکَ فَلْیَفْرَحُوا ہُوَ خَیْرٌ مِمَّا یَجْمَعُونَ}۔ (بخاری ۴۲۳۔ احمد ۱۲۲)","Hasan","Musannaf Ibn Abi Shaybah 30937","","","كتاب فضائل القرآن"
"30938","(۳۰۹۳۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن شَقِیقٍ ، قَالَ: قیلَ لِعَبْدِ اللہِ: إنَّ فُلانًا یَقْرَأُ الْقُرْآنَ مَنْکُوسًا ، فَقَالَ عَبْدُ اللہِ: ذَاکَ مَنْکُوسُ الْقَلْبِ۔","Sahih","Musannaf Ibn Abi Shaybah 30938","","","كتاب فضائل القرآن"
"30939","(۳۰۹۳۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن ہَارُونَ بْنِ عَنْتَرَۃَ ، عَنْ أَبِیہِ ، قَالَ سَأَلْتُ ابْنَ عَبَّاسٍ: أَیُّ الْعَمَلِ أَفْضَلُ ، قَالَ: ذِکْرُ اللہِ أکبر ، وَمَا جَلَسَ قَوْمٌ فِی بَیْتٍ یَتَعَاطَوْنَ فِیہِ کِتَابَ اللہِ فِیمَا بَیْنَہُمْ وَیَتَدَارَسُونَہُ إِلاَّ أَظَلَّتْہُمُ الْمَلائِکَۃُ بِأَجْنِحَتِہَا ، وَکَانُوا أَضْیَافَ اللہِ مَا دَامُوا فِیہِ حَتَّی یُفِیضُوا فِی حَدِیثٍ غَیْرِہِ۔ (دارمی ۳۵۶)","Sahih","Musannaf Ibn Abi Shaybah 30939","","","كتاب فضائل القرآن"
"30940","(۳۰۹۴۰) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَن شُعْبَۃَ ، عَنْ أَبِی رَجَائٍ ، قَالَ: سَأَلْت مُحَمَّدًا عَن نَقْطِ الْمَصَاحِفِ ؟ فَقَالَ: إنِّی أَخَافُ أَنْ یَزِیدُوا فِی الْحُرُوفِ ، أَوْ یُنْقِصُوا۔","","Musannaf Ibn Abi Shaybah 30940","","","كتاب فضائل القرآن"
"30941","(۳۰۹۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ خَارِجَۃَ ، عَنْ خَالدٍ ، قَالَ: رَأَیْتُ ابْنِ سِیرِینَ یَقرأ فی مُصْحَفِ مَنْقُوط۔","","Musannaf Ibn Abi Shaybah 30941","","","كتاب فضائل القرآن"
"30942","(۳۰۹۴۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ النُّقَطَ۔","","Musannaf Ibn Abi Shaybah 30942","","","كتاب فضائل القرآن"
"30943","(۳۰۹۴۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الہُذَلی ، عَنِ الْحَسَنِ قَالَ: لاَ بَأْسَ بِنُقَطِہَا بِالأَحْمَرِ۔","","Musannaf Ibn Abi Shaybah 30943","","","كتاب فضائل القرآن"
"30944","(۳۰۹۴۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالدٍ ، أَوْ غَیْرَہُ قَالَ: رَأَیْتُ ابْنِ سِیرِینَ یَقرأ فی مُصْحَفِ مَنْقُوط۔","","Musannaf Ibn Abi Shaybah 30944","","","كتاب فضائل القرآن"
"30945","(۳۰۹۴۵) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَبِی حَیَّانَ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمًا بَارِزًا لِلنَّاسِ فَأَتَاہُ رَجُلٌ ، فَقَالَ: یَا رَسُولَ اللہِ ، مَا الإِیمَانُ ؟ فَقَالَ: الإِیمَانُ أَنْ تُؤْمِنَ بِاللہِ وَمَلائِکَتِہِ وَکُتُبِہِ وَلِقَائِہِ وَرُسُلِہِ وَتُؤْمِنَ بِالْبَعْثِ الآخِرِ ، قَالَ: یَا رَسُولَ اللہِ ، مَا الإسْلامُ ، قَالَ: أَنْ تَعْبُدَ اللَّہَ ، وَلا تُشْرِکَ بِہِ شَیْئًا وَتُقِیمَ الصَّلاۃَ الْمَکْتُوبَۃَ وَتُؤْتِیَ الزَّکَاۃَ الْمَفْرُوضَۃَ وَتَصُومَ رَمَضَانَ ، قَالَ: یَا رَسُولَ اللہِ ، مَا الإِحْسَانُ ؟ قَالَ: أَنْ تَعْبُدَ اللَّہَ کَأَنَّک تَرَاہُ فَإِنَّک إِنْ لاَ تَرَاہُ فَإِنَّہُ یَرَاک۔ (مسلم ۵۔ احمد ۴۲۶)","Sahih","Musannaf Ibn Abi Shaybah 30945","","","كتاب الإيمان"
"30946","(۳۰۹۴۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی جَمْرَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ وَفْدَ عَبْدِ الْقَیْسِ أَتَوْا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنِ الْوَفْدُ ، أَوْ مَنِ الْقَوْمُ ، قَالُوا: رَبِیعَۃُ ، قَالَ: مَرْحَبًا بِالْقَوْمِ ، أَوْ بِالْوَفْدِ غَیْرَ خَزَایَا ، وَلا نَدَامَی ، فَقَالُوا: یَا رَسُولَ اللہِ ، إنَّا نَأْتِیک مِنْ شُقَّۃٍ بَعِیدَۃٍ ، وَإِنَّ بَیْنَنَا وَبَیْنَکَ ہَذَا الْحَیَّ مِنْ کُفَّارِ مُضَرَ ، وَإِنَّا لاَ نَسْتَطِیعُ أَنْ نَأْتِیَک إلاَّ فِی الشَّہْرِ الْحَرَامِ ، فَمُرْنَا بِأَمْرٍ فَصْلٍ نُخْبِرُ بِہِ مَنْ وَرَائَنَا نَدْخُلُ بِہِ الْجَنَّۃَ ، قَالَ: فَأَمَرَہُمْ بِأَرْبَعٍ وَنَہَاہُمْ عَنْ أَرْبَعٍ: أَمَرَہُمْ بِالإِیمَانِ بِاللہِ وَحْدَہُ ، وَقَالَ: ہَلْ تَدْرُونَ مَا الإِیمَانُ بِاللہِ ، قَالُوا: اللَّہُ وَرَسُولُہُ أَعْلَمُ ، قَالَ: شَہَادَۃُ أَنْ لاَ إلَہَ إلاَّ اللَّہُ ، وَأَنَّ مُحَمَّدًا رَسُولُ اللہِ وَإِقَامُ الصَّلاۃِ وَإِیتَائُ الزَّکَاۃِ وَصَوْمُ رَمَضَانَ ، وَأَنْ تُعْطُوا الْخُمُسَ مِنَ الْمَغْنَمِ ، فَقَالَ: احْفَظُوہُ وَأَخْبِرُوا بِہِ مَنْ وَرَائَکُمْ۔ (بخاری ۸۷۔ مسلم ۲۴)","Sahih","Musannaf Ibn Abi Shaybah 30946","","","كتاب الإيمان"
"30947","(۳۰۹۴۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ عَطِیَّۃَ مَوْلَی بَنِی عَامِرٍ ، عَنْ یَزِیدَ بْنِ بِشْر السَّکْسَکِیِّ ، قَالَ: قدِمْت الْمَدِینَۃَ فَدَخَلْتُ عَلَی عَبْدِ اللہِ بْنِ عُمَرَ ، فَأَتَاہُ رَجُلٌ مِنْ أَہْلِ الْعِرَاقِ ، فَقَالَ: یَا عَبْدَ اللہِ ، مَالَک تَحُجُّ وَتَعْتَمِرُ وَتَرَکْت الْغَزْوَ فِی سَبِیلِ اللہِ ، فَقَالَ: وَیْلَک إنَّ الإِیمَانَ بُنِیَ عَلَی خَمْسٍ: تَعْبُدُ اللَّہَ وَتُقِیمُ الصَّلاۃَ وَتُؤْتِی الزَّکَاۃَ وَتَحُجُّ الْبَیْتَ وَتَصُومُ رَمَضَانَ قَالَ: فَرَدَّہَا عَلَیْہِ ، فَقَالَ: یَا عَبْدَ اللہِ ، تَعْبُدُ اللَّہَ وَتُقِیمُ الصَّلاۃَ وَتُؤْتِی الزَّکَاۃَ وَتَحُجُّ الْبَیْتَ وَتَصُومُ رَمَضَانَ قَالَ: فَرَدَّہَا عَلَیْہِ ، فَقَالَ: یَا عَبْدَ اللہِ ، تَعْبُدُ اللَّہَ وَتُقِیمُ الصَّلاۃَ وَتُؤْتِی الزَّکَاۃَ وَتَحُجُّ الْبَیْتَ وَتَصُومُ رَمَضَانَ ، کَذَلِکَ ، قَالَ لَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 30947","","","كتاب الإيمان"
"30948","(۳۰۹۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عُمَارَۃَ ، عَنْ أَبِی زُرْعَۃَ ، قَالَ عُمَرُ: عُرَی الإِیمَانِ أَرْبَعٌ: الصَّلاۃُ وَالزَّکَاۃُ وَالْجِہَادُ وَالأَمَانَۃُ۔","","Musannaf Ibn Abi Shaybah 30948","","","كتاب الإيمان"
"30949","(۳۰۹۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ صِلَۃَ ، قَالَ: قَالَ حُذَیْفَۃُ: الإسْلامُ ، ثَمَانیَۃُ أَسْہُمٍ: الصَّلاۃُ سَہْمٌ وَالزَّکَاۃُ سَہْمٌ وَالْجِہَادُ سَہْمٌ وَصَوْمُ رَمَضَانَ سَہْمٌ وَالأَمْرُ بِالْمَعْرُوفِ سَہْمٌ وَالنَّہْیُ عَنِ الْمُنْکَرِ سَہْمٌ وَالإِسْلامُ سَہْمٌ ، وَقَدْ خَابَ مَنْ لاَ سَہْمَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 30949","","","كتاب الإيمان"
"30950","(۳۰۹۵۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ: سَمِعْتُ عُرْوَۃَ بْنَ النَّزَّالِ یُحَدِّثُ عَنْ مُعَاذِ بْنِ جَبَلٍ ، قَالَ: أَقْبَلْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ غَزْوَۃِ تَبُوکَ ، فَلَمَّا رَأَیْتہ خَالِیًا قُلْتُ: یَا رَسُولَ اللہِ ، أَخْبِرْنِی بِعَمَلٍ یُدْخِلُنِی الْجَنَّۃَ ، فقَالَ: بَخٍ ، لَقَدْ سَأَلْت عَنْ عَظِیمٍ ، وَہُوَ یَسِیرٌ عَلَی مَنْ یَسَّرَہُ اللَّہُ عَلَیْہِ: تُقِیمُ الصَّلاۃَ الْمَکْتُوبَۃَ وَتُؤَدِّی الزَّکَاۃَ الْمَفْرُوضَۃَ وَتَلْقَی اللَّہَ لاَ تُشْرِکُ بِہِ شَیْئًا ، أَوَلا أَدُلُّک عَلَی رَأْسِ الأَمْرِ وَعَمُودِہِ وَذِرْوَۃِ سَنَامِہِ ؟ أَمَّا رَأْسُ الأَمْرِ فَالإِسْلام مَنْ أَسْلَمَ سَلِمَ ، وَأَمَّا عَمُودہ فَالصَّلاۃ ، وَأَمَّا ذِرْوَتہ وَسَنَامہ فَالْجِہَادُ فِی سَبِیلِ اللہِ۔","Da'if","Musannaf Ibn Abi Shaybah 30950","","","كتاب الإيمان"
"30951","(۳۰۹۵۱) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنِ الْحَکَمِ ، عَنِ الأَعْمَشِ ، عَنْ مَیْمُونِ بْنِ أَبِی شبیب ، عَنْ مُعَاذِ بْنِ جَبَلٍ ، قَالَ: خَرَجْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ غَزْوَۃَ تَبُوکَ ۔۔۔ثُمَّ ذَکَرَ نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 30951","","","كتاب الإيمان"
"30952","(۳۰۹۵۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ رِبْعِیٍّ ، عَنْ رَجُلٍ مِنْ بَنِی أَسَدٍ ، عَنْ عَلِیٍّ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أَرْبَعٌ لَنْ یَجِدَ رَجُلٌ طَعْمَ الإِیمَانِ حَتَّی یُؤْمِنَ بِہِنَّ: لاَ إلَہَ إلاَّ اللَّہُ وَحْدَہُ ،وَأَنِّی رَسُولُ اللہِ بَعَثَنِی بِالْحَقِّ وَبِأَنَّہُ مَیِّتٌ ، ثُمَّ مَبْعُوثٌ مِنْ بَعْدِ الْمَوْتِ وَیُؤْمِنَ بِالْقَدَرِ کُلِّہِ۔n(ترمذی ۲۱۴۵۔ احمد ۱۳۳)","Da'if","Musannaf Ibn Abi Shaybah 30952","","","كتاب الإيمان"
"30953","(۳۰۹۵۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: جَائَ أَعْرَابِیٌّ إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ: السَّلامُ عَلَیْک یَا غُلامَ بَنِی عَبْدِ الْمُطَّلِبِ ، فَقَالَ: وَعَلَیْک ، فَقَالَ: إنِّی رَجُلٌ مِنْ أَخْوَالِکَ مِنْ بَنِی سَعْدِ بْنِ بَکْرٍ وَأَنَا رَسُولُ قَوْمِی إلَیْک وَوَافِدُہُمْ وَأَنَا سَائِلُک فَمُشْتَدَّۃٌ مَسْأَلَتِی إیاک ، وَمُنَاشِدُک فَمُشْتَدَّۃٌ مُنَاشَدَتِی إیَّاکَ ، قَالَ: خُذْ یَا أَخَا بَنِی سَعْدٍ ، قَالَ: مَنْ خَلَقَک وَہُوَ خَالِقُ مَنْ قَبْلَک وَہُوَ خَالِقُ مَنْ بَعْدَکَ ؟ قَالَ: اللَّہُ ، قَالَ: نَشَدْتُک بِذَلِکَ أَہُوَ أَرْسَلَک ؟ قَالَ: نَعَمْ ، قَالَ: مَنْ خَلَقَ السَّمَاوَاتِ السَّبْعَ وَالأَرْضِینَ السَّبْعَ وَأَجْرَی بَیْنَہُنَّ الرِّزْقَ ؟ قَالَ: اللَّہُ ، قَالَ: نَشَدْتُک بِذَلِکَ أَہُوَ أَرْسَلِکَ ؟ قَالَ: نَعَمْ ، قَالَ: فَإِنَّا وَجَدْنَا فِی کِتَابِکَ وَأَمَرَتْنَا رُسُلُک أَنْ نُصَلِّیَ فِی الْیَوْمِ وَاللَّیْلَۃِ خَمْسَ صَلَوَاتٍ لِمَوَاقِیتِہَا فَنَشَدْتُک بِذَلِکَ أَہُوَ أَمَرَک بِہِ ؟ قَالَ: نَعَمْ ، قَالَ: فَإِنَّا وَجَدْنَا فِی کِتَابِکَ وَأَمَرَتْنَا رُسُلُک أَنْ نَأْخُذَ مِنْ حَوَاشِی أَمْوَالِنَا فَنَرُدَّہَا عَلَی فُقَرَائِنَا فَنَشَدْتُک بِذَلِکَ أَہُوَ أَمَرَک بِذَلِکَ ؟ قَالَ: نَعَمْ ، ثُمَّ قَالَ: أَمَّا الْخَامِسَۃُ فَلَسْت سَائلک عنہا ، وَلا أَرَبَ لِی فِیہَا ، قَالَ: ثُمَّ قَالَ: أَمَا وَالَّذِی بَعَثَک بِالْحَقِّ لأَعْمَلَنَّ بِہَا وَمَنْ أَطَاعَنِی مِنْ قَوْمِی ، ثُمَّ رَجَعَ فَضَحِکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی بَدَتْ نَوَاجِذُہُ ، ثُمَّ قَالَ: وَالَّذِی نَفْسِی بِیَدِہِ لَئِنْ صَدَقَ لَیَدْخُلَنَّ الْجَنَّۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 30953","","","كتاب الإيمان"
"30954","(۳۰۹۵۴) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ: حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، قَالَ: کُنَّا قَدْ نُہِینَا أَنْ نَسْأَلَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ شَیْئٍ ، فَکَانَ یُعْجِبُنَا أَنْ یَأْتِیَ الرَّجُلُ مِنْ أَہْلِ الْبَادِیَۃِ الْعَاقِلُ فَیَسْأَلُہُ وَنَحْنُ نَسْمَعُ ، فَجَائَ رَجُلٌ مِنْ أَہْلِ الْبَادِیَۃِ ، فَقَالَ: یَا مُحَمَّدُ أَتَانَا رَسُولُک فَزَعَمَ أَنَّ اللَّہَ أَرْسَلِکَ ، فقَالَ: صَدَقَ ، قَالَ: فَمَنْ خَلَقَ السَّمَائَ ؟ قَالَ: اللَّہُ ، قَالَ: فَمَنْ خَلَقَ الأَرْضَ ؟ قَالَ: اللَّہُ ، قَالَ: فَمَنْ نَصَبَ ہَذِہِ الْجِبَالَ ؟ قَالَ: اللَّہُ ، قَالَ: فَبِالَّذِی خَلَقَ السَّمَائَ وَخَلَقَ الأَرْضَ وَنَصَبَ الْجِبَالَ آللَّہُ أرسلک ؟ قَالَ: نَعَمْ، قَالَ: وَزَعَمَ رَسُولُک أَنَّ عَلَیْنَا خمس صلوات فی یومنا ولیلتنا قَالَ صدق ،قَالَ: فَبِالَّذِی أرسلک آللَّہُ أمرک بہذا قَالَ نعم: قَالَ: وزَعَمَ رَسُولُک أَنَّ عَلَیْنَا زکاۃ فی أموالنا قَالَ صدق ،قَالَ: فَبِالَّذِی أرسلک آللَّہُ أمرک بہذا قَالَ نعم: قَالَ: فزَعَمَ رَسُولُک أَنَّ عَلَیْنَا صَوْمَ شَہْر رَمَضَانَ فِی سَنَتِنَا ، قَالَ: صَدَقَ ، قَالَ: فَبِالَّذِی خَلَقَ السَّمَائَ وَخَلَقَ الأَرْضَ وَنَصَبَ الْجِبَالَ آللَّہُ أَمَرَک بِہَذَا ؟ قَالَ: نَعَمْ ، قَالَ: وزَعَمَ رَسُولُک ، أَنَّ عَلَیْنَا الْحَجَّ لِمَنِ اسْتَطَاعَ إلَیْہِ سَبِیلاً ، قَالَ صَدَقَ ، قَالَ: فَبِالَّذِی خَلَقَ السَّمَائَ وَخَلَقَ الأَرْضَ وَنَصَبَ الْجِبَالَ آللَّہُ أَمَرَک بِہَذَا ؟ قَالَ: نَعَمْ ، ثُمَّ وَلَّی ، وَقَالَ: وَالَّذِی بَعَثَک بِالْحَقِّ لاَ أَزْدَادُ عَلَیْہِ شَیْئًا ، وَلا أَنْقُصُ مِنْہُ شَیْئًا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إِنْ صَدَقَ دَخَلَ الْجَنَّۃَ۔ (مسلم ۴۱۔ ترمذی ۶۱۹)","Sahih","Musannaf Ibn Abi Shaybah 30954","","","كتاب الإيمان"
"30955","(۳۰۹۵۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ عَلِیِّ بْنِ مَسْعَدَۃَ ، قَالَ: حدَّثَنَا قَتَادَۃُ ، قَالَ: حَدَّثَنَا أَنَسُ بْنُ مَالِکٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: الإسْلامُ عَلانِیَۃٌ وَالإِیمَانُ فِی الْقَلْبِ ، ثُمَّ یُشِیرُ بِیَدِہِ إِلَی صَدْرِہِ: التَّقْوَی ہَاہُنَا التَّقْوَی ہَاہُنَا۔ (احمد ۱۳۴۔ بزار ۲۰)","Da'if","Musannaf Ibn Abi Shaybah 30955","","","كتاب الإيمان"
"30956","(۳۰۹۵۶) حَدَّثَنَا مُصْعَبُ بْنُ الْمِقْدَامِ ، قَالَ: حدَّثَنَا أَبُو ہِلالٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ إیمَانَ لِمَنْ لاَ أَمَانَۃَ لَہُ۔ (احمد ۱۳۵۔ ابن حبان ۱۹۴)","Da'if","Musannaf Ibn Abi Shaybah 30956","","","كتاب الإيمان"
"30957","(۳۰۹۵۷) حَدَّثَنَا أَبُو أُسَامَۃَ، قَالَ: حدَّثَنَا عَوْفٌ، عَنْ عَبْدِ اللہِ بْنِ عَمْرِو ابْنِ ہِنْدٍ الْجَمَلِیِّ، قَالَ: قَالَ عَلِیٌّ: الإِیمَانُ یَبْدَأُ نُقْطَۃً بَیْضَائَ فِی الْقَلْبِ ، کُلَّمَا ازْدَادَ الإِیمَانُ ازْدَادَتْ بَیَاضًا حَتَّی یَبْیَضَّ الْقَلْبُ کُلُّہُ ، وَالنِّفَاقُ یَبْدَأُ نُقْطَۃً سَوْدَائَ فِی الْقَلْبِ کُلَّمَا ازْدَادَ النِّفَاقُ ازْدَادَتْ سَوَادًا حَتَّی یَسْوَدَّ الْقَلْبُ کُلُّہُ ، وَالَّذِی نَفْسِی بِیَدِہِ لَوْ شَقَقْتُمْ ، عَنْ قَلْبِ مُؤْمِنٍ لَوَجَدْتُمُوہُ أَبْیَضَ ، وَلَوْ شَقَقْتُمْ ، عَنْ قَلْبِ مُنَافِقٍ لَوَجَدْتُمُوہُ أَسْوَدَ الْقَلْب ۔","Da'if","Musannaf Ibn Abi Shaybah 30957","","","كتاب الإيمان"
"30958","(۳۰۹۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، عَنْ سُلَیْمَانَ بْنِ مَیْسَرَۃَ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ: قَالَ عَبْدُ اللہِ: إنَّ الرَّجُلَ لَیُذْنِبُ الذَّنْبَ فَیُنْکَتُ فِی قَلْبِہِ نُکْتَۃٌ سَوْدَائُ ، ثُمَّ یُذْنِبُ الذَّنْبَ فَتُنْکَتُ أُخْرَی حَتَّی یَصِیرَ قَلْبُہُ لَوْن الشَّاۃِ الرَّبْدَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 30958","","","كتاب الإيمان"
"30959","(۳۰۹۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، قَالَ: قَالَ ہِشَامٌ ، عَنْ أَبِیہِ: مَا نَقَصَتْ أَمَانَۃُ عَبْدٍ قَطُّ إلاَّ نَقَصَ إیمَانہ۔","","Musannaf Ibn Abi Shaybah 30959","","","كتاب الإيمان"
"30960","(۳۰۹۶۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ: الإِیمَانُ ہَیوبٌ۔","","Musannaf Ibn Abi Shaybah 30960","","","كتاب الإيمان"
"30961","(۳۰۹۶۱) ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ نَافِعِ بْنِ جُبَیْرٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعَثَ بشر بْنَ سُحَیْمٍ الْغِفَارِیَّ یَوْمَ النَّحْرِ یُنَادِی فِی النَّاسِ ، إِنَّہُ لاَ یَدْخُلُ الْجَنَّۃَ إلاَّ نَفْسٌ مُؤْمِنَۃٌ۔","","Musannaf Ibn Abi Shaybah 30961","","","كتاب الإيمان"
"30962","(۳۰۹۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃ ، عَنْ أَبِیہِ ، قَالَ: لاَ تَغُرَّنَّکُمْ صَلاۃُ امْرِئٍ ، وَلا صِیَامُہُ ، مَنْ شَائَ صَامَ وَمَنْ شَائَ صَلَّی ، أَلا لاَ دِینَ لِمَنْ لاَ أَمَانَۃَ لَہُ۔","","Musannaf Ibn Abi Shaybah 30962","","","كتاب الإيمان"
"30963","(۳۰۹۶۳) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أبی جَعْفَرٍ الْخطْمِیِّ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ عُمَیْرِ بْنِ حَبِیبِ بْنِ خُمَاشَۃَ ، أَنَّہُ قَالَ: الإِیمَانُ یَزِیدُ وَیَنْقُصُ ، قِیلَ لَہُ: وَمَا زِیَادَتُہُ ، وَمَا نُقْصَانُہُ ، قَالَ: إذَا ذَکَرْنَاہُ وَخَشِینَاہُ فَذَلِکَ زِیَادَتُہُ ، وَإِذَا غَفَلْنَا وَنَسِینَا وَضَیَّعْنَا فَذَلِکَ نُقْصَانُہُ۔","","Musannaf Ibn Abi Shaybah 30963","","","كتاب الإيمان"
"30964","(۳۰۹۶۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ: اللَّہُمَّ لاَ تَنْزِعْ مِنِّی الإِیمَانَ کَمَا أَعْطَیْتنیہ۔","Sahih","Musannaf Ibn Abi Shaybah 30964","","","كتاب الإيمان"
"30965","(۳۰۹۶۵) حَدَّثَنَا حَمَّادُ بْنُ مَعْقِل ، عَنْ غَالِبِ عَنْ بَکْرٍ ، قَالَ: لَوْ سُئلتُ عَنْ أَفْضَلِ أَہْلِ ہَذَا الْمَسْجِدِ فَقَالُوا: تَشْہَدُ أَنَّہُ مُؤْمِنٌ مُسْتَکْمِلُ الإِیمَانِ بَرِیئٌ مِنَ النِّفَاقِ ، لَمْ أَشْہَدْ ، وَلَوْ شَہِدْت لَشَہِدْت ، أَنَّہُ فِی الْجَنَّۃِ ، وَلَوْ سُئِلْت عَنْ رَجُلٍ ، أَشَرِّ أَو أَخْبَثِ ، الشَّکُّ مِنْ أَبِی بَکْرٍ ، رَجُلٍ فَقَالُوا: نَشْہَدُ أَنَّہُ مُنَافِقٌ مُسْتَکْمِلُ النِّفَاقِ بَرِیئٌ مِنَ الإِیمَانِ ، لَمْ أَشْہَدْ ، وَلَوْ شَہِدْت لَشَہِدْت أَنَّہُ فِی النَّارِ۔","","Musannaf Ibn Abi Shaybah 30965","","","كتاب الإيمان"
"30966","(۳۰۹۶۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا فُضَیْلُ بْنُ غَزْوَانَ ، قَالَ: حَدَّثَنَا عُثْمَان بْنُ أَبِی صَفِیَّۃَ الأَنْصَارِیُّ ، قَالَ: قَالَ عَبْدُ اللہِ بْنُ عَبَّاسٍ لِغُلامٍ مِنْ غِلْمَانِہِ: أَلا أُزَوِّجُک فَمَا مِنْ عَبْدٍ یَزْنِی إلاَّ نَزَعَ اللَّہُ مِنْہُ نُورَ الإِیمَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 30966","","","كتاب الإيمان"
"30967","(۳۰۹۶۷) حَدَّثَنَا سُلَیْمَانُ بْنُ حَرْبٍ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ، عن ہشام عَنْ أَبِیہِ، عَنْ عَائِشَۃَ، قَالَتْ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ یَزْنِی الزَّانِی حِینَ یَزْنِی وَہُوَ مُؤْمِنٌ، وَلا یَسْرِقُ حِینَ یَسْرِقُ وَہُوَ مُؤْمِنٌ۔ (بزار ۱۱۲)","Sahih","Musannaf Ibn Abi Shaybah 30967","","","كتاب الإيمان"
"30968","(۳۰۹۶۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ ثَعْلَبَۃَ ، عَنْ أَبِی قِلابَۃَ قَالَ: حدَّثَنِی الرَّسُولُ الَّذِی سَأَلَ عَبْدُ اللہِ بْنُ مَسْعُودٍ ، قَالَ: أَسْأَلُک بِاللہِ أَتَعْلَمُ ، أَنَّ النَّاسَ کَانُوا فِی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی ثَلاثَۃِ أَصْنَافٍ مُؤْمِنِ السَّرِیرَۃِ وَمُؤْمِنِ الْعَلانِیَۃِ ، وَکَافِرِ السَّرِیرَۃِ کَافِرِ الْعَلانِیَۃِ ، وَمُؤْمِنِ الْعَلانِیَۃِ کَافِرِ السَّرِیرَۃِ ، قَالَ: فَقَالَ عَبْدُ اللہِ: اللَّہُمَّ نَعَمْ ، قَالَ: فَأَنْشُدُک بِاللہِ: مِنْ أَیِّہِمْ کُنْت ، فَقَالَ: اللَّہُمَّ مُؤْمِنُ السَّرِیرَۃِ مُؤْمِنُ الْعَلانِیَۃِ ، أَنَا مُؤْمِنٌ ، قَالَ أَبُو إِسْحَاقَ: فَلَقِیت عَبْدَ اللہِ بْنَ مَعْقِلٍ ، فَقُلْتُ: إنَّ أُنَاسًا مِنْ أَہْلِ الصَّلاحِ یَعِیبُونَ عَلَیَّ أَنْ أَقُولَ: أَنَا مُؤْمِنٌ ، فَقَالَ عَبْدُ اللہِ بْنُ مَعْقِلٍ: لَقَدْ خِبْتَ وَخَسِرْت إِنْ لَمْ تَکُنْ مُؤْمِنًا۔","Da'if","Musannaf Ibn Abi Shaybah 30968","","","كتاب الإيمان"
"30969","(۳۰۹۶۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُوسَی بْنِ مُسْلِمٍ الشَّیْبَانِیِّ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ: وَمَا عَلَی أَحَدِکُمْ أَنْ یَقُولَ: أَنَا مُؤْمِنٌ ، فَوَاللہِ لَئِنْ کَانَ صَادِقًا لاَ یُعَذِّبُہُ اللَّہُ عَلَی صِدْقِہِ ، وَإِنْ کَانَ کَاذِبًا لَمَا دَخَلَ عَلَیْہِ مِنَ الْکُفْرِ أَشَدُّ عَلَیْہِ مِنَ الْکَذِبِ۔","","Musannaf Ibn Abi Shaybah 30969","","","كتاب الإيمان"
"30970","(۳۰۹۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إِبْرَاہِیمَ، عَن عَلْقَمَۃَ، قَالَ: قَالَ لَہُ رَجُلٌ: أَمُؤْمِنٌ أَنْتَ، قَالَ: أَرْجُو۔","","Musannaf Ibn Abi Shaybah 30970","","","كتاب الإيمان"
"30971","(۳۰۹۷۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنِ الْحَارِثِ بْنِ عَمِیرۃَ الزُّبَیْدِیِّ ، قَالَ: وَقَعَ الطَّاعُونُ بِالشَّامِ فَقَامَ مُعَاذٌ بِحِمْصٍ فَخَطَبَہُمْ ، فَقَالَ: n إنَّ ہَذَا الطَّاعُونَ رَحْمَۃُ رَبِّکُمْ وَدَعْوَۃُ نَبِیِّکُمْ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَوْتُ الصَّالِحِینَ قَبْلَکُمْ ، اللَّہُمَّ اقْسِمْ لآلِ مُعَاذٍ نُصِیبَہُمُ الأَوْفَی مِنْہُ ، قَالَ: فَلَمَّا نَزَلَ ، عَنِ الْمِنْبَرِ أَتَاہُ آتٍ ، فَقَالَ: إنَّ عَبْدَ الرَّحْمَن بْنَ مُعَاذٍ قَدْ أُصِیبَ ، فَقَالَ: إنَّا لِلَّہِ وَإِنَّا إلَیْہِ رَاجِعُونَ ، قَالَ: ثُمَّ انْطَلَقَ نَحْوَہُ ، قَالَ: فَلَمَّا رَآہُ عَبْدُ الرَّحْمَنِ مُقْبِلاً ، قَالَ: إِنَّہُ {الْحَقُّ مِنْ رَبِّکَ فَلا تَکُونَنَّ مِنَ الْمُمْتَرِینَ} ، قَالَ: فَقَالَ: یَا بُنَیَّ سَتَجِدُنِی إِنْ شَائَ اللَّہُ مِنَ الصَّابِرِینَ قَالَ: فَمَاتَ آلُ مُعَاذٍ إنْسَانًا إنْسَانًا حَتَّی کَانَ مُعَاذٌ آخِرَہُمْ ، قَالَ: فَأُصِیبَ ، فَأَتَاہُ الْحَارِثُ بْنُ عَمِیرَۃَ الزُّبَیْدِیُّ ، قَالَ: فَأُغْشِیَ عَلَی مُعَاذٍ غَشْیَۃً ، قَالَ: فَأَفَاقَ مُعَاذٌ وَالْحَارِثُ یَبْکِی ، قَالَ: فَقَالَ مُعَاذٌ: مَا یُبْکِیک ؟ قَالَ: فَقَالَ: أَبْکِی عَلَی الْعِلْمِ الَّذِی یُدْفَنُ مَعَک، قَالَ: فَقَالَ: إِنْ کُنْت طَالِبَ الْعِلْمِ لاَ مَحَالَۃَ فَاطْلُبْہُ مِنْ عَبْدِاللہِ بْنِ مَسْعُودٍ وَمِنْ عُوَیْمِرٍ أَبِی الدَّرْدَائِ وَمِنْ سَلْمَانَ الْفَارِسِیِّ ، قَالَ: وَإِیَّاکَ وَزَلَّۃَ الْعَالِمِ ، قَالَ: قُلْتُ: وَکَیْف لِی أَصْلَحَک اللَّہُ أَنْ أَعْرِفَہَا ، قَالَ: إنَّ لِلْحَقِّ نُورًا یُعْرَفُ بِہِ ، قَالَ: فَمَاتَ مُعَاذٌ وَخَرَجَ الْحَارِثُ یُرِیدُ عَبْدَ اللہِ بْنَ مَسْعُودٍ بِالْکُوفَۃِ، قَالَ: فَانْتَہَی إِلَی بَابِہِ فَإِذَا عَلَی الْبَابِ نَفَرٌ مِنْ أَصْحَابِ عَبْدِ اللہِ یَتَحَدَّثُونَ، قَالَ: فَجَرَی بَیْنَہُمَ الْحَدِیثُ حَتَّی ، قَالُوا: یَا شَامِیُّ أَمُؤْمِنٌ أَنْتَ ؟ قَالَ: نَعَمْ ، فَقَالُوا: مِنْ أَہْلِ الْجَنَّۃِ ؟ قَالَ: فَقَالَ: إنَّ لِی ذُنُوبًا لاَ أَدْرِی مَا یَصْنَعُ اللَّہُ فِیہَا فَلَوْ أنی أَعْلَمُ، أَنَّہَا غُفِرَتْ لِی لأَنْبَأْتُکُمْ أَنِّی مِنْ أَہْلِ الْجَنَّۃِ ، قَالَ: فَبَیْنَمَا ہُمْ کَذَلِکَ إذْ خَرَجَ عَلَیْہِمْ عَبْدُ اللہِ ، فَقَالُوا لَہُ: أَلا تَعْجَبُ مِنْ أَخِینَا ہَذَا الشَّامِیِّ یَزْعُمُ أَنَّہُ مُؤْمِنٌ ، ولا یَزْعُمُ أَنَّہُ مِنْ أَہْلِ الْجَنَّۃِ ، قَالَ: فَقَالَ عَبْدُ اللہِ: لَوْ قُلْتُ إحْدَاہُمَا لاتَّبَعَتُہَا الأُخْرَی ، قَالَ: فَقَالَ الْحَارِثُ: {إنَّا لِلَّہِ وَإِنَّا إلَیْہِ رَاجِعُونَ} صَلَّی اللَّہُ عَلَی مُعَاذٍ ، قَالَ: وَیْحَک وَمَنْ مُعَاذٌ ، قَالَ: مُعَاذُ بْنُ جَبَلٍ ، قَالَ: وَمَا قَالَ؟ قَالَ: إیَّاکَ وَزَلَّۃَ الْعَالِمِ فَأحْلِفُ بِاللہِ ، أَنَّہَا مِنْک لَزَلَّۃٌ یَا ابْنَ مَسْعُودٍ ، وَمَا الإِیمَانُ إلاَّ أَنَّا نُؤْمِنُ بِاللہِ وَمَلائِکَتِہِ وَکُتُبِہِ وَرُسُلِہِ وَالْیَوْمِ الآخِرِ وَالْجَنَّۃِ وَالنَّارِ وَالْبَعْثِ وَالْمِیزَانِ، وَإِنَّ لَنَا ذُنُوبًا لاَ نَدْرِی مَا یَصْنَعُ اللَّہُ فِیہَا ، فَلَوْ أنا نَعْلَمُ أَنَّہَا غُفِرَتْ لَنَا لَقُلْنَا: إنَّا مِنْ أَہْلِ الْجَنَّۃِ ، فَقَالَ عَبْدُ اللہِ: صَدَقْت وَاللہِ إِنْ کَانَتْ مِنِّی لَزَلَّۃً۔n(ابوداؤد ۴۵۹۶۔ حاکم ۴۶۰)","","Musannaf Ibn Abi Shaybah 30971","","","كتاب الإيمان"
"30972","(۳۰۹۷۲) حَدَّثَنَا مُعْصَبُ بْنُ الْمِقْدَامِ ، قَالَ: حدَّثَنَا عِکْرِمَۃُ بْنُ عَمَّارٍ ، قَالَ: حَدَّثَنِی أَبُو زُمَیْلٍ ، عَنْ مَالِکِ بْنِ مَرْثَدٍ الزِّمَّانِیِّ ، عَنْ أَبِیہِ ، قَالَ: قَالَ أَبُو ذَرٍّ: سَأَلْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَاذَا یُنَجِّی الْعَبْدَ مِنَ النَّارِ ، فَقَالَ: الإِیمَانُ بِاللہِ ، قَالَ: قُلْتُ: یَا نَبِیَّ اللَّہُ أَوَ مَعَ الإِیمَانِ عَمَلٌ ، فَقَالَ: تَرْضَخُ مِمَّا رَزَقَک اللَّہُ ، أَوْ یَرْضَخُ مِمَّا رَزَقَہُ اللَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 30972","","","كتاب الإيمان"
"30973","(۳۰۹۷۳) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ أُمِّ مُحَمَّدٍ ، أَنَّ رَجُلاً قَالَ لِعَائِشَۃَ: مَا الإِیمَانُ ؟ قَالَتْ: أُفَسِّرُ أَمْ أُجْمِلُ ، قَالَ: لاَ بَلْ أَجْمِلِی ، فقَالَتْ: مَنْ سَرَّتْہُ حَسَنَتُہُ وَسَائَتْہُ سَیِّئَتُہُ فَہُوَ مُؤْمِنٌ۔n(ترمذی ۲۱۶۵۔ احمد ۴۴۶)","Da'if","Musannaf Ibn Abi Shaybah 30973","","","كتاب الإيمان"
"30974","(۳۰۹۷۴) حَدَّثَنَا مُحَمَّدُ بْنُ سابق ، قَالَ: حدَّثَنَا إسْرَائِیلُ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن علْقَمَۃَ ، عَنْ عَبْدِ اللہِ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لَیْسَ الْمُؤْمِنُ بِالطَّعَّانِ ، وَلا اللَّعَّانِ ، وَلا بِالْفَاحِشِ ، وَلا بِالْبَذِیئ۔ (ترمذی ۱۹۷۷۔ احمد ۴۰۴)","Hasan","Musannaf Ibn Abi Shaybah 30974","","","كتاب الإيمان"
"30975","(۳۰۹۷۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، عَنْ سَعْدٍ ، قَالَ: الْمُؤْمِنُ یُطْبَع عَلَی الْخِلالِ کُلِّہَا إلاَّ الْخِیَانَۃَ وَالْکَذِبَ۔","Sahih","Musannaf Ibn Abi Shaybah 30975","","","كتاب الإيمان"
"30976","(۳۰۹۷۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ، عَنْ مَالِکِ بْنِ الْحَارِثِ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ، عَنْ عَبْدِ اللہِ ، قَالَ: الْمُؤْمِنُ یُطْوَی عَلَی الْخِلالِ کُلِّہَا غَیْرَ الْخِیَانَۃِ وَالْکَذِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 30976","","","كتاب الإيمان"
"30977","(۳۰۹۷۷) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، قَالَ: حُدِّثْت عن أَبِی أُمَامَۃَ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: یُطْوی الْمُؤْمِنُ عَلَی کُلِّ شیئٍ إلاَّ الْخِیَانَۃَ وَالْکَذِبَ۔","Da'if","Musannaf Ibn Abi Shaybah 30977","","","كتاب الإيمان"
"30978","(۳۰۹۷۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، عَنْ أَبِی مُوسَی ، عن النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: تَکُونُ فِی آخِرِ الزَّمَانِ فِتَنٌ کَقِطَعِ اللَّیْلِ الْمُظْلِمِ ، یُصْبِحُ الرَّجُلُ مُؤْمِنًا وَیُمْسِی کَافِرًا وَیُمْسِی مُؤْمِنًا وَیُصْبِحُ کَافِرًا۔","Sahih","Musannaf Ibn Abi Shaybah 30978","","","كتاب الإيمان"
"30979","(۳۰۹۷۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حَجَّاجِ بْنِ أَبِی عُثْمَانَ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ ہِلالِ بْنِ أَبِی مَیْمُونَۃَ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ مُعَاوِیَۃَ بْنِ الْحَکَمِ السُّلَمِیِّ ، قَالَ: کَانَتْ لِی جَارِیَۃٌ تَرْعَی غَنَمًا لِی فِی قِبَلِ أُحُدٍ وَالْجَوَّانِیَّۃ ، فَاطَّلَعْتہَا ذَاتَ یَوْمٍ وَإِذَا الذِّئْبُ قَدْ ذَہَبَ بِشَاۃٍ مِنْ غَنَمِہَا ، قَالَ: وَأَنَا رَجُلٌ مِنْ بَنِی آدَمَ آسَفُ کَمَا یَأْسَفُونَ ، لَکِنِّی صَکَکْتہَا صَکَّۃً فَأَتَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَظَّمَ ذَلِکَ عَلَیَّ ، فَقُلْتُ یَا رَسُولَ اللہِ ، أَفَلا أُعْتِقُہَا قَالَ: ائْتِنِی بِہَا ، فَقَالَ لَہَا: أَیْنَ اللَّہُ ؟ قَالَتْ فِی السَّمَائِ ، قَالَ: مَنْ أَنَا ؟ قَالَتْ: أَنْتَ رَسُولُ اللہِ ، قَالَ: أَعْتِقْہَا ، فَإِنَّہَا مُؤْمِنَۃٌ۔ (مسلم ۳۳۔ ابوداؤد ۹۲۷)","Sahih","Musannaf Ibn Abi Shaybah 30979","","","كتاب الإيمان"
"30980","(۳۰۹۸۰) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْمِنْہَالِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ الْحَکَمِ یَرْفَعُہُ ، أَنَّ رَجُلاً أَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ: إنَّ عَلَی أُمِّی رَقَبَۃً مُؤْمِنَۃً ، وَعِنْدِی رَقَبَۃٌ سَوْدَائُ أَعْجَمِیَّۃٌ ، فَقَالَ: ائْتِ بِہَا ، فَقَالَ: أَتَشْہَدِینَ أَنْ لاَ إلَہَ إلاَّ اللَّہُ وَأَنِّی رَسُولُ اللہِ ؟ قَالَتْ: نَعَمْ ، قَالَ: فَأَعْتِقْہَا۔ (بزار ۱۳۔ طبرانی ۱۳۳۶۹)","Da'if","Musannaf Ibn Abi Shaybah 30980","","","كتاب الإيمان"
"30981","(۳۰۹۸۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَثَلُ الْمُؤْمِنِ مَثَلُ الزَّرْعِ لاَ تَزَالُ الرِّیحُ تُمِیلُہُ ، وَلا یَزَالُ الْمُؤْمِنُ یُصِیبُہُ بَلائٌ ، وَمَثَلُ الْکَافِرِ کَمَثَلِ شَجَرَۃِ الأَرْزِ لاَ تَہْتَزُّ حَتَّی تَسْتَحْصِدَ ۔ (مسلم ۲۱۶۳۔ ترمذی ۲۸۶۶)","Sahih","Musannaf Ibn Abi Shaybah 30981","","","كتاب الإيمان"
"30982","(۳۰۹۸۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا زَکَرِیَّا ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ: أَخْبَرَنِی ابْنُ کَعْبِ بْنِ مَالِکٍ ، عَنْ أَبِیہِ کعب ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مثل الْمُؤْمِنُ کَمَثَلِ الخَامَۃِ من الزَّرْعِ تَفِیئُہَا الرِّیحُ تَصْرَعُہَا مَرَّۃً وَتَعْدِلُہَا أُخْرَی حَتَّی تَہِیجَ ، وَمَثَلُ الْکَافِرِ کَمَثَلِ الأَرْزَۃِ الْمُجْذِیَۃِ عَلَی أَصلہَا لاَ یَفِیئُہَا شَیْئٌ حَتَّی یَکُونَ انْجِعَافُہَا مَرَّۃً وَاحِدَۃً۔ (بخاری ۵۶۴۳۔ مسلم ۵۹)","Sahih","Musannaf Ibn Abi Shaybah 30982","","","كتاب الإيمان"
"30983","(۳۰۹۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ یحیی بْنِ سعید ، عَنْ بَشِیرِ بْنِ نَہِیکٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: مَثَلُ الْمُؤْمِنِ الضَّعِیفِ کَمَثَلِ الْخَامَۃِ مِنَ الزَّرْعِ تُمِیلُہَا الرِّیحُ مَرَّۃً وَتُقِیمُہَا مَرَّۃً ، قَالَ: قُلْتُ: فَالْمُؤْمِنُ الْقَوِیُّ ، قَالَ: مِثْلُ النَّخْلَۃِ تُؤْتِی أُکُلَہَا کُلَّ حِینٍ فِی ظِلِّہَا ذَلِکَ ، وَلا تُمِیلُہَا الرِّیحُ۔","Sahih","Musannaf Ibn Abi Shaybah 30983","","","كتاب الإيمان"
"30984","(۳۰۹۸۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ: مَثَلُ الْمُؤْمِنِ کَمَثَلِ النَّحْلَۃِ تَأْکُلُ طَیِّبًا وَتَضَعُ طَیِّبًا۔","Da'if","Musannaf Ibn Abi Shaybah 30984","","","كتاب الإيمان"
"30985","(۳۰۹۸۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ بُرَیْدِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی بُرْدَۃَ عَنْ أَبِی مُوسَی ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: الْمُؤْمِنُ لِلْمُؤْمِنِ کَالْبُنْیَانِ یَشُدُّ بَعْضُہُ بَعْضًا۔ (بخاری ۴۸۱۔ مسلم ۱۹۹۹)","Sahih","Musannaf Ibn Abi Shaybah 30985","","","كتاب الإيمان"
"30986","(۳۰۹۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی عَمَّارٍ ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إنَّ عَمَّارًا مُلِئَ إیمَانًا إِلَی مُشَاشِہِ۔","","Musannaf Ibn Abi Shaybah 30986","","","كتاب الإيمان"
"30987","(۳۰۹۸۷) حَدَّثَنَا عَثَّامُ بْنُ عَلِیٍّ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہَانِئِ بْنِ ہَانِئٍ ، قَالَ: کُنَّا جُلُوسًا عِنْدَ عَلِیٍّ فَدَخَلَ عَمَّارٌ ، فَقَالَ: مَرْحَبًا بِالطَّیِّبِ الْمُطَیَّبِ ، سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: إنَّ عَمَّارًا مُلِئَ إیمَانًا إِلَی مَشَاشِہِ۔ (ابن ماجہ ۱۴۷)","Hasan","Musannaf Ibn Abi Shaybah 30987","","","كتاب الإيمان"
"30988","(۳۰۹۸۸) حَدَّثَنَا عَفَّان ، قَالَ: حَدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ: حدَّثَنَا زَکَرِیَّا ، قَالَ: سَمِعْتُ الْحَسَنَ یَقُولُ: إنَّ الإِیمَانَ لَیْسَ بِالتَّحَلِّی ، وَلا بِالتَّمَنِّی ، إنَّمَا الإِیمَانُ مَا وَقَرَ فِی الْقَلْبِ وَصَدَّقَہُ الْعَمَلُ۔ (ابن عدی ۲۲۹۰)","","Musannaf Ibn Abi Shaybah 30988","","","كتاب الإيمان"
"30989","(۳۰۹۸۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ قَالَ لِغِلْمَانِہِ: مَنْ أَرَادَ مِنْکُمُ الْبَائَۃَ زَوَّجْنَاہُ ، فَلا یَزْنِی مِنْکُمْ زَانٍ إلاَّ نَزَعَ اللَّہُ مِنْہُ نُورَ الإِیمَانِ ، فَإِنْ شَائَ أَنْ یَرُدَّہُ، وَإِنْ شَائَ أَنْ یَمْنَعَہُ إیَّاہُ مَنَعَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30989","","","كتاب الإيمان"
"30990","(۳۰۹۹۰) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ ، عَجَبًا لإخْوَانِنَا مِنْ أَہْلِ الْعِرَاقِ یُسَمُّونَ الْحَجَّاجَ مُؤْمِنًا۔","","Musannaf Ibn Abi Shaybah 30990","","","كتاب الإيمان"
"30991","(۳۰۹۹۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الأَجْلَحِ ، عَنِ الشَّعْبِیِّ ، قَالَ: أَشْہَدُ أَنَّہُ مُؤْمِنٌ بِالطَّاغُوتِ کَافِرٌ بِاللہِ ، یَعْنِی الْحَجَّاجَ۔","","Musannaf Ibn Abi Shaybah 30991","","","كتاب الإيمان"
"30992","(۳۰۹۹۲) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ،قَالَ: یَأْتِی عَلَی النَّاسِ زَمَانٌ یَجْتَمِعُونَ وَیُصَلُّونَ فِی الْمَسَاجِدِ وَلَیْسَ فِیہِمْ مُؤْمِنٌ۔","Sahih","Musannaf Ibn Abi Shaybah 30992","","","كتاب الإيمان"
"30993","(۳۰۹۹۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، قَالَ: قلْنَا لِطَلْقِ بْنِ حَبِیبٍ: صِفْ لَنَا التَّقْوَی ، قَالَ: التَّقْوَی عَمَلٌ بِطَاعَۃِ اللہِ رَجَائَ رَحْمَۃِ اللہِ عَلَی نُورٍ مِنَ اللہ[corrupt] ، وَالتَّقْوَی تَرْکُ مَعْصِیَۃِ اللہِ مَخَافَۃَ اللہِ عَلَی نُورٍ مِنَ اللہِ۔","","Musannaf Ibn Abi Shaybah 30993","","","كتاب الإيمان"
"30994","(۳۰۹۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ إذَا ذَکَرَ الْحَجَّاجَ ، قَالَ: أَلا لَعَنْۃُ اللہِ عَلَی الظَّالِمِینَ۔","","Musannaf Ibn Abi Shaybah 30994","","","كتاب الإيمان"
"30995","(۳۰۹۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَفَی بِمَنْ شَکَّ فِی الْحَجَّاجِ لَحَاہُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 30995","","","كتاب الإيمان"
"30996","(۳۰۹۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی بَشِیرٍ ، عَنْ عَبْدِ اللہِ بْنِ مِساور ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَا یُؤْمِنُ مَنْ بَاتَ شَبْعَانَ وَجَارُہُ طاوٍ إِلَی جَنْبِہِ۔n(ابویعلی ۲۶۹۱۔ حاکم ۱۶۷)","Da'if","Musannaf Ibn Abi Shaybah 30996","","","كتاب الإيمان"
"30997","(۳۰۹۹۷) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی التَّیْمِیُّ ، عَنْ مَنْصُورٍ ، عَنْ طَلْقِ بْنِ حَبِیبٍ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ: ثَلاثٌ مَنْ کُنَّ فِیہِ وَجَدَ طَعْمَ الإِیمَانِ وَحَلاوَتَہُ: أَنْ یَکُونَ اللَّہُ وَرَسُولُہُ أَحَبَّ إلَیْہِ مِمَّا سِوَاہُمَا ، وَأَنْ یُحِبَّ فِی اللہِ وَیُبْغِضَ فِی اللہِ ، وَذَکَرَ الشِّرْکَ۔","Sahih","Musannaf Ibn Abi Shaybah 30997","","","كتاب الإيمان"
"30998","(۳۰۹۹۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، عَنِ الْمِسْوَرِ بْنِ مَخْرَمَۃَ ، وَابْنِ عَبَّاسٍ أَنَّہُمَا دَخَلا عَلَی عُمَرَ حِینَ طُعِنَ ، فَقَالاَ: الصَّلاۃُ ، فَقَالَ: إِنَّہُ لاَ حَظَّ لأَحَدٍ فِی الإسْلامِ أَضَاعَ الصَّلاۃَ فَصَلَّی وَجُرْحُہُ یَثْعَبُ دَمًا۔ (بیہقی ۳۵۷)","Sahih","Musannaf Ibn Abi Shaybah 30998","","","كتاب الإيمان"
"30999","(۳۰۹۹۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِیہِ ، عَنْ شباک ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، أَنَّہُ کَانَ یَقُولُ لأَصْحَابِہِ : امْشُوا بِنَا نَزْدَاد إیمَانًا۔","","Musannaf Ibn Abi Shaybah 30999","","","كتاب الإيمان"
"31000","(۳۱۰۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَنِ الأَسْوَدِ بْنِ ہِلالٍ الْمُحَارِبِیِّ ، قَالَ : قَالَ لِی مُعَاذٌ اجْلِسْ بِنَا نُؤْمِنُ سَاعَۃً ، یَعْنِی نَذْکُرُ اللَّہَ۔","Sahih","Musannaf Ibn Abi Shaybah 31000","","","كتاب الإيمان"
"31001","(۳۱۰۰۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مَہْدِیِّ بْنِ مَیْمُونٍ ، عَنْ عِمْرَانَ الْقَصِیرِ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : کَانَ أَبُو الدَّرْدَائِ یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُک إیمَانًا دَائِمًا وَعِلْمًا نَافِعًا وَہَدْیًا قَیِّمًا ، قَالَ مُعَاوِیَۃُ : فَنُرَی أَنَّ مِنَ الإِیمَانِ إیمَانًا لَیْسَ بِدَائِمٍ وَمِنَ الْعِلْمِ عِلْمًا لاَ یَنْفَعُ وَمِنَ الْہَدْیِ ہَدْیًا لَیْسَ بِقَیِّمٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31001","","","كتاب الإيمان"
"31002","(۳۱۰۰۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَعْمَشِ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَنِ الأَسْوَدِ بْنِ ہِلالٍ : قَالَ : کَانَ مُعَاذٌ یَقُولُ لِرَجُلٍ مِنْ إخْوَانِہِ : اجْلِسْ بِنَا فَلْنُؤْمِنْ سَاعَۃً ، فَیَجْلِسَانِ یَتَذَاکَرَانِ اللَّہَ وَیَحْمَدَانِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31002","","","كتاب الإيمان"
"31003","(۳۱۰۰۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ طَلْحَۃَ ، عَنْ زُبَیْدٍ ، عَنْ زِرٍّ ، قَالَ : کَانَ عُمَرُ مِمَّا یَأْخُذُ بِیَدِ الرَّجُلِ وَالرَّجُلَیْنِ مِنْ أَصْحَابِہِ فَیَقُولُ : قُمْ بِنَا نَزْدَاد إیمَانًا۔","Sahih","Musannaf Ibn Abi Shaybah 31003","","","كتاب الإيمان"
"31004","(۳۱۰۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ سُلَیْمَانَ بْنِ مَیْسَرَۃَ وَالْمُغِیرَۃِ بْنِ شِبْلٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ الأَحْمَسِیِّ ، عَنْ سَلْمَانَ ، قَالَ : إنَّ مَثَلَ الصَّلَوَاتِ الْخَمْسِ کَمَثَلِ سِہَامِ الْغَنِیمَۃِ ، فَمَنْ یَضْرِبُ فِیہَا بِخَمْسَۃٍ خَیْرٌ مِمَّنْ یَضْرِبُ فِیہَا بِأَرْبَعَۃٍ وَمَنْ یَضْرِبُ فِیہَا بِأَرْبَعَۃٍ خَیْرٌ مِمَّنْ یَضْرِبُ فِیہَا بِثَلاثَۃٍ ، وَمَنْ یَضْرِبُ فِیہَا بِثَلاثَۃٍ خَیْرٌ مِمَّنْ یَضْرِبُ فِیہَا بِسَہْمَیْنِ ، وَمَنْ یَضْرِبُ فِیہَا بِسَہْمَیْنِ خَیْرٌ مِمَّنْ یَضْرِبُ فِیہَا بِسَہْمٍ ، وَمَا جَعَلَ اللَّہُ مَنْ لَہُ سَہْمٌ فِی الإسْلامِ کَمَنْ لاَ سَہْمَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31004","","","كتاب الإيمان"
"31005","(۳۱۰۰۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، عَنْ عَلِیِّ بْنِ مُدْرِکٍ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیرَۃَ ، قَالَ الإِیمَانُ نُورٌ ، فَمَنْ زَنَا فَارَقَہُ الإِیمَانُ ، فَمَنْ لامَ نَفْسَہُ وَرَاجَعَ رَاجَعَہُ الإِیمَانُ۔","Sahih","Musannaf Ibn Abi Shaybah 31005","","","كتاب الإيمان"
"31006","(۳۱۰۰۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَکْمَلُ الْمُؤْمِنِینَ إیمَانًا أَحْسَنُہُمْ خُلُقًا۔","Hasan","Musannaf Ibn Abi Shaybah 31006","","","كتاب الإيمان"
"31007","(۳۱۰۰۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَکْمَلُ الْمُؤْمِنِینَ إیمَانًا وَأَفْضَلُ الْمُؤْمِنِینَ إیمَانًا أَحْسَنُہُمْ خُلُقًا۔","Hasan","Musannaf Ibn Abi Shaybah 31007","","","كتاب الإيمان"
"31008","(۳۱۰۰۸) حَدَّثَنَا حَفْصُ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلابَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَکْمَلُ الْمُؤْمِنِینَ إیمَانًا أَحْسَنُہُمْ خُلُقًا۔","Sahih","Musannaf Ibn Abi Shaybah 31008","","","كتاب الإيمان"
"31009","(۳۱۰۰۹) حَدَّثَنَا الْمُقْرِیئُ ، عَنْ سَعِیدِ بْنِ أَبِی أَیُّوبَ ، عَنِ ابْنِ عَجْلانَ عَنِ الْقَعْقَاعِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَکْمَلُ الْمُؤْمِنِینَ أَحْسَنُہُمْ خُلُقًا۔","Hasan","Musannaf Ibn Abi Shaybah 31009","","","كتاب الإيمان"
"31010","(۳۱۰۱۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ یَعْلَی بْنِ حَکِیمٍ ، قَالَ : أَکْبَرُ ظَنِّی ، أَنَّہُ قَالَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : قَالَ ابْنُ عُمَرَ : إن الْحَیَائُ وَالإِیمَانُ قُرِنَا جَمِیعًا ، فَإِذَا رُفِعَ أَحَدُہُمَا رُفِعَ الآخَرُ۔","Sahih","Musannaf Ibn Abi Shaybah 31010","","","كتاب الإيمان"
"31011","(۳۱۰۱۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَلَمَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : قَالَ رَجُلٌ عِنْدَ عَبْدِ اللہِ : إنِّی مُؤْمِنٌ ، فَقَالَ : قُلْ : إنِّی فِی الْجَنَّۃِ ، وَلَکِنَّا نُؤْمِنُ بِاللہِ وَمَلائِکَتِہِ وَکُتُبِہِ وَرُسُلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31011","","","كتاب الإيمان"
"31012","(۳۱۰۱۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : قیلَ لَہُ : أَمُؤْمِنٌ أَنْتَ ، قَالَ : أَرْجُو۔","","Musannaf Ibn Abi Shaybah 31012","","","كتاب الإيمان"
"31013","(۳۱۰۱۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ سِمَاکِ بْنِ سَلَمَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عِصْمَۃَ ، أَنَّ عَائِشَۃَ ، قَالَتْ : أَنْتُمُ الْمُؤْمِنُونَ إِنْ شَائَ اللَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31013","","","كتاب الإيمان"
"31014","(۳۱۰۱۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : إذَا سُئِلَ أَحَدُکُمْ : أَمُؤْمِنٌ أَنْتَ ، فَلا یَشُکَّنَّ۔","","Musannaf Ibn Abi Shaybah 31014","","","كتاب الإيمان"
"31015","(۳۱۰۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ زِیَادِ بْنِ عِلاقَۃَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : إذَا سُئِلَ أَحَدُکُمْ : أَمُؤْمِنٌ ا[corrupt]َنْتَ ؟ فَلا یَشُکُّ فِی إیمَانِہِ۔","","Musannaf Ibn Abi Shaybah 31015","","","كتاب الإيمان"
"31016","(۳۱۰۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ مُوسَی بْنِ أَبِی کَثِیرٍ ، عَنْ رَجُلٍ لَمْ یُسَمِّہِ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ ابْنَ مَسْعُودٍ یَقُولُ : أَنَا مُؤْمِنٌ۔","Da'if","Musannaf Ibn Abi Shaybah 31016","","","كتاب الإيمان"
"31017","(۳۱۰۱۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی وَائِلٍ ، قَالَ : جَائَ رَجُلٌ ، فَقَالَ : لَقِیت رَکْبًا ، فَقُلْتُ : مَنْ أَنْتُمْ ، قَالُوا : نَحْنُ الْمُؤْمِنُونَ ، قَالَ : أَفَلا قَالُوا : نَحْنُ فِی الْجَنَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 31017","","","كتاب الإيمان"
"31018","(۳۱۰۱۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، وَعَنْ مُحِلٍّ ، عَنْ إبْرَاہِیمَ أَنَّہُمَا کَانَا إذَا سُئِلا قَالا : آمَنَّا بِاللہِ وَمَلائِکَتِہِ وَکُتُبِہِ وَرُسُلہ۔","","Musannaf Ibn Abi Shaybah 31018","","","كتاب الإيمان"
"31019","(۳۱۰۱۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : لَقِیت عَبْدَ اللہِ بْنَ مَعْقِلٍ ، فَقُلْتُ لَہُ : إنَّ أُنَاسًا مِنْ أَہْلِ الصَّلاحِ یَعِیبُونَ عَلَیَّ أَنْ أَقُولَ : أَنَا مُؤْمِنٌ ، فَقَالَ عَبْدُ اللہِ بْنَ مَعْقِلٍ : لَقَدْ خِبْتَ وَخَسِرْتَ إِنْ لَمْ تَکُنْ مُؤْمِنًا۔","","Musannaf Ibn Abi Shaybah 31019","","","كتاب الإيمان"
"31020","(۳۱۰۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عَمْرِو بْنِ مُنَبِّہٍ ، عَنْ سَوَّارِ بْنِ شَبِیبٍ ، قَالَ : جَائَ رَجُلٌ إِلَی ابْنِ عُمَرَ ، فَقَالَ : إنَّ ہَاہُنَا قَوْمًا یَشْہَدُونَ عَلَیَّ بِالْکُفْرِ ، فَقَالَ : أَلا تَقُولُ : لاَ إلَہَ إلاَّ اللَّہُ فَتُکَذِّبُہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 31020","","","كتاب الإيمان"
"31021","(۳۱۰۲۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی قِلابَۃَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ الأَنْصَارِیِّ ، قَالَ : تَسَمَّوْا بِأَسْمَائِکُمَ الَّتِی سَمَّاکُمَ اللَّہُ بِالْحَنِیفِیَّۃِ وَالإِسْلامِ وَالإِیمَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 31021","","","كتاب الإيمان"
"31022","(۳۱۰۲۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ سَلَمَۃَ بْنِ سَبْرَۃَ ، قَالَ : خَطَبَنَا مُعَاذٌ ، فَقَالَ : أَنْتُمُ الْمُؤْمِنُونَ وَأَنْتُمْ أَہْلُ الْجَنَّۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 31022","","","كتاب الإيمان"
"31023","(۳۱۰۲۳) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : کَتَبَ إلَیْنَا عُمَرُ بْنُ عَبْدِ الْعَزِیزِ أَمَّا بَعْدُ فَإِنَّ عُرَی الدِّینِ وَقِوَامَ الإسْلامِ الإِیمَانُ بِاللہِ وَإِقَامُ الصَّلاۃِ وَإِیتَائُ الزَّکَاۃِ فَصَلُّوا الصَّلاۃَ لِوَقْتِہَا۔","","Musannaf Ibn Abi Shaybah 31023","","","كتاب الإيمان"
"31024","(۳۱۰۲۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، أَنَّ نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یَخْرُجُ مِنَ النَّارِ مَنْ قَالَ لاَ إلَہَ إلاَّ اللَّہُ ، وَکَانَ فِی قَلْبِہِ مِنَ الْخَیْرِ شَعِیرَۃً ، ثُمَّ قَالَ الثَّانِیَۃَ : یَخْرُجُ مِنَ النَّارِ مَنْ قَالَ لاَ إلَہَ إلاَّ اللَّہُ ، وفِی قَلْبِہِ مِنَ الْخَیْرِ مَا یَزِنُ بُرَّۃً ، ثُمَّ قَالَ : یَخْرُجُ مِنَ النَّارِ مَنْ قَالَ لاَ إلَہَ إلاَّ اللَّہُ، وَکَانَ فِی قَلْبِہِ مِنَ الْخَیْرِ مَا یَزِنُ ذَرَّۃ۔","Sahih","Musannaf Ibn Abi Shaybah 31024","","","كتاب الإيمان"
"31025","(۳۱۰۲۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عَامِرِ بْنِ سَعْدٍ ، عَنْ أَبِیہِ ، أَنَّ نَفَرًا أَتَوْا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَعْطَاہُمْ إلاَّ رَجُلاً مِنْہُمْ ، فَقَالَ سَعْدٌ : یَا رَسُولَ اللہِ ، أَعْطَیْتَہُمْ وَتَرَکْتَ فُلانًا وَاللہِ إنِّی لأُرَاہُ مُؤْمِنًا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوْ مُسْلِمًا ، فَقَالَ سَعْدٌ : وَاللہِ إنِّی لأرَاہُ مُؤْمِنًا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوْ مُسْلِمًا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَلِکَ ثَلاثًا۔","Sahih","Musannaf Ibn Abi Shaybah 31025","","","كتاب الإيمان"
"31026","(۳۱۰۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، عَنْ سَلْمَانَ ، قَالَ : یُقَالُ لَہُ : سَلْ تُعْطَہُ ، یَعْنِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَاشْفَعْ تُشَفَّعْ وَادْعُ تُجَبْ ، فَیَرْفَعُ رَأْسَہُ فَیَقُولُ : أُمَّتِی أُمَّتِی مَرَّتَیْنِ ، أَوْ ثَلاثًا فَقَالَ سَلْمَانُ یَشْفَعُ فِی کُلِّ مَنْ فِی قَلْبِہِ مِثْقَالُ حَبَّۃِ حِنْطَۃٍ مِنْ إیمَانٍ ، أَوْ مِثْقَالُ شَعِیرَۃٍ مِنْ إیمَانٍ ، أَوْ مِثْقَالُ حَبَّۃِ خَرْدَلٍ مِنْ إیمَانٍ ، قَالَ سَلْمَانُ : فَذَلِکُمُ الْمَقَامُ الْمَحْمُودُ۔","Sahih","Musannaf Ibn Abi Shaybah 31026","","","كتاب الإيمان"
"31027","(۳۱۰۲۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَزْنِی الزَّانِی حِینَ یَزْنِی وَہُوَ مُؤْمِنٌ ، وَلا یَسْرِقُ حِینَ یَسْرِقُ وَہُوَ مُؤْمِنٌ، وَلا یَشْرَبُ الْخَمْرَ حِینَ یَشْرَبُ وَہُوَ مُؤْمِنٌ، وَلا یَنْتَہِبُ نُہْبَۃً یَرْفَعُ النَّاسُ فِیہَا أَبْصَارَہُمْ وَہُوَ مُؤْمِنٌ۔","Hasan","Musannaf Ibn Abi Shaybah 31027","","","كتاب الإيمان"
"31028","(۳۱۰۲۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدٌ ، عَنْ یَحْیَی بْنِ عَبَّادِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لاَ یَزْنِی الزَّانِی حِینَ یَزْنِی وَہُوَ مُؤْمِنٌ ، وَلا یَسْرِقُ حِینَ یَسْرِقُ وَہُوَ مُؤْمِنٌ ، وَلا یَشْرَبُ ، یَعْنِی الْخَمْرَ حِینَ یَشْرَبُ وَہُوَ مُؤْمِنٌ فَإِیَّاکُمْ إیَّاکُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 31028","","","كتاب الإيمان"
"31029","(۳۱۰۲۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُدْرِکٍ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَزْنِی الزَّانِی حِینَ یَزْنِی وَہُوَ مُؤْمِنٌ ، وَلا یَسْرِقُ حِینَ یَسْرِقُ وَہُوَ مُؤْمِنٌ ، وَلا یَشْرَبُ الْخَمْرَ حِینَ یَشْرَبُہَا وَہُوَ مُؤْمِنٌ ، وَلا یَنْتَہِبُ نُہْبَۃً ذَاتَ شَرَفٍ یَرْفَعُ الْمُسْلِمُونَ إلَیْہَا رُؤُوسَہُمْ وَہُوَ مُؤْمِنٌ۔","Da'if","Musannaf Ibn Abi Shaybah 31029","","","كتاب الإيمان"
"31030","(۳۱۰۳۰) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ فِرَاسٍ ، عَنْ مُدْرِکٍ ، عَنِ ابْنِ أَبِی أَوْفَی ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ۔۔۔ نَحْوَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 31030","","","كتاب الإيمان"
"31031","(۳۱۰۳۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ، قَالَ: حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَیَائُ مِنَ الإِیمَانِ وَالإِیمَانُ فِی الْجَنَّۃِ وَالْبَذَائِ مِنَ الْجَفَائِ وَالْجَفَائُ فِی النَّارِ۔","Hasan","Musannaf Ibn Abi Shaybah 31031","","","كتاب الإيمان"
"31032","(۳۱۰۳۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، أَنَّہُ قَالَ : قیلَ : یَا رَسُولَ اللہِ ، أَیُّ الأَعْمَالِ أَفْضَلُ ، قَالَ : الصَّبْرُ وَالسَّمَاحَۃُ ، قِیلَ : أَیُّ الْمُؤْمِنِینَ أَکْمَلُ إیمَانًا ، قَالَ أَحْسَنُہُمْ خُلُقًا۔","Sahih","Musannaf Ibn Abi Shaybah 31032","","","كتاب الإيمان"
"31033","(۳۱۰۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : بَیْنَ الْعَبْدِ وَبَیْنَ الْکُفْرِ تَرْکُ الصَّلاۃِ۔ (ابوداؤد ۴۶۴۵۔ ترمذی ۲۶۲۰)","Sahih","Musannaf Ibn Abi Shaybah 31033","","","كتاب الإيمان"
"31034","(۳۱۰۳۴) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ، عَنِ الأَعْمَشِ، عَنْ أَبِی سُفْیَانَ، عَنْ جَابِرٍ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔۔۔ نَحْوَہُ۔ (مسلم ۸۸۔ ترمذی ۲۶۱۹)","Sahih","Musannaf Ibn Abi Shaybah 31034","","","كتاب الإيمان"
"31035","(۳۱۰۳۵) حَدَّثَنَا یَحْیَی بْنُ وَاضِحٍ ، عَنْ حُسَیْنِ بْنِ وَاقِدٍ ، قَالَ : سَمِعْتُ ابْنَ بُرَیْدَۃَ یَقُولُ : سَمِعْت أَبِی یَقُولُ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یقول : الْعَہْدُ الَّذِی بَیْنَنَا وَبَیْنَہُمَ الصَّلاۃُ ، فَمَنْ تَرَکَہَا فَقَدْ کَفَرَ۔n(ترمذی ۲۶۲۱۔ احمد ۳۴۶)","Hasan","Musannaf Ibn Abi Shaybah 31035","","","كتاب الإيمان"
"31036","(۳۱۰۳۶) حَدَّثَنَا شَرِیکٌ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَنْ لَمْ یُصَلِّ فَلا دِینَ لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31036","","","كتاب الإيمان"
"31037","(۳۱۰۳۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی ، عَنْ أَبِی قِلابَۃَ ، عَنْ أَبِی الْمَلِیحِ ، عَنِ بُرَیْدَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ تَرَکَ الْعَصْرَ فَقَدْ حَبِطَ عَمَلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31037","","","كتاب الإيمان"
"31038","(۳۱۰۳۸) حَدَّثَنَا عِیسَی ، وَوَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی قِلابَۃَ ، عَنْ أَبِی الْمُہَاجِرِ ، عَنْ بُرَیْدَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ تَرَکَ الْعَصْرَ فَقَدْ حَبِطَ عَمَلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31038","","","كتاب الإيمان"
"31039","(۳۱۰۳۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَبَّادُ بْنُ مَیْسَرَۃَ الْمُنْقِرِیُّ ، عَنْ أَبِی قِلابَۃَ ، وَالْحَسَنِ ، أَنَّہُمَا کَانَا جَالِسَیْنِ، فَقَالَ أَبُو قِلابَۃَ : قَالَ أَبُو الدَّرْدَائِ : مَنْ تَرَکَ الْعَصْرَ حَتَّی تَفُوتَہُ مِنْ غَیْرِ عُذْرٍ فَقَدْ حَبِطَ عَمَلُہُ ، قَالَ: وَقَالَ الْحَسَنُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ تَرَکَ صَلاۃً مَکْتُوبَۃً حَتَّی تَفُوتَہ مِنْ غَیْرِ عُذْرٍ فَقَدْ حَبِطَ عَمَلُہُ۔","","Musannaf Ibn Abi Shaybah 31039","","","كتاب الإيمان"
"31040","(۳۱۰۴۰) حَدَّثَنَا ہَوْذَۃُ بْنُ خَلِیفَۃَ ، قَالَ : حدَّثَنَا عَوْفٌ ، عَنْ قَسَامَۃَ بْنِ زُہَیْرٍ ، قَالَ : لاَ إیمَانَ لِمَنْ لاَ أَمَانَۃَ لَہُ ، وَلا دِینَ لِمَنْ لاَ عَہْدَ لَہُ۔","","Musannaf Ibn Abi Shaybah 31040","","","كتاب الإيمان"
"31041","(۳۱۰۴۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، قَالَ : إنَّ أَفْضَلَ الْعِبَادَۃِ الرَّأْیُ الْحَسَنُ۔","","Musannaf Ibn Abi Shaybah 31041","","","كتاب الإيمان"
"31042","(۳۱۰۴۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ یُوسُفَ بْنِ مَیْمُونٍ ، قَالَ : قُلْتُ لِعَطَائٍ إنَّ قِبَلَنَا قَوْمًا نَعُدُّہُمْ مِنْ أَہْلِ الصَّلاحِ إِنْ قُلْنَا نَحْنُ مُؤْمِنُونَ عَابُوا ذَلِکَ عَلَیْنَا ، قَالَ : فَقَالَ عَطَائٌ نَحْنُ الْمُسْلِمُونَ الْمُؤْمِنُونَ ، وَکَذَلِکَ أَدْرَکْنَا أَصْحَابَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 31042","","","كتاب الإيمان"
"31043","(۳۱۰۴۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی الْبَخْتَرِیِّ ، عَنْ حُذَیْفَۃَ ، قَالَ : الْقُلُوبُ أَرْبَعَۃٌ : قَلْبٌ مُصَفَّحٌ ، فَذَلِکَ قَلْبُ الْمُنَافِقِ ، وَقَلْبٌ أَغْلَفُ ، فَذَلِکَ قَلْبُ الْکَافِرِ ، وَقَلْبٌ أَجْرَدُ ، کَأَنَّ فِیہِ سِرَاجًا یُزْہِرُ ، فَذَاکَ قَلْبُ الْمُؤْمِنِ ، وَقَلْبٌ فِیہِ نِفَاقٌ وَإِیمَانٌ ، فَمَثَلُہُ کَمَثَلِ قُرْحَۃٍ یَمُدُّ بِہَا قَیْحٌ وَدَمٌ ، وَمَثَلُہُ کَمَثَلِ شَجَرَۃٍ یَسْقِیہَا مَائٌ خَبِیثٌ وَمَائٌ طَیِّبٌ ، فَأَیُّ مَائٍ غَلَبَ عَلَیْہَا غَلَبَ۔ (طبری ۴۰۶)","","Musannaf Ibn Abi Shaybah 31043","","","كتاب الإيمان"
"31044","(۳۱۰۴۴) أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُکْثِرُ أَنْ یَقُولَ : یَا مُقَلِّبَ الْقُلُوبِ ، ثَبِّتْ قَلْبِی عَلَی دِینِکَ قَالُوا : یَا رَسُولَ اللہِ : آمَنَّا بِکَ وَبِمَا جِئْت بِہِ فَہَلْ تَخَافُ عَلَیْنَا ، قَالَ : إنَّ الْقُلُوبَ بَیْنَ إصْبَعَیْنِ مِنْ أَصَابِعِ اللہِ یُقَلِّبُہَا۔","Hasan","Musannaf Ibn Abi Shaybah 31044","","","كتاب الإيمان"
"31045","(۳۱۰۴۵) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : أَخْبَرَنَا أَبُو کَعْبٍ صَاحِبُ الْحَرِیرِ ، قَالَ : حَدَّثَنَا شَہْرُ بْنُ حَوْشَبٍ ، قَالَ : قُلْتُ لأمِّ سَلَمَۃَ : یَا أُمَّ الْمُؤْمِنِینَ مَا کَانَ أَکْثَرُ دُعَائِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا کَانَ عِنْدَکَ ، قَالَ : قُلْتُ : کَانَ أَکْثَرُ دُعَائِہِ : یَا مُقَلِّبَ الْقُلُوبِ ثَبِّتْ قَلْبِی عَلَی دِینِکَ ، قُلْتُ : یا رسول اللہ ، مَا أَکْثَرُ دُعَائِکَ یَا مُقَلِّبَ الْقُلُوب ثَبِّتْ قَلْبِی عَلَی دِینِکَ قَالَ : یَا أُمَّ سَلَمَۃَ : إِنَّہُ لَیْسَ من آدَمِیٌّ إلاَّ وَقَلْبُہُ بَیْنَ إصْبَعَیْنِ مِنْ أَصَابِعِ اللہِ مَا شَائَ أَقَامَ ، وَمَا شَائَ أَزَاغَ۔","Hasan","Musannaf Ibn Abi Shaybah 31045","","","كتاب الإيمان"
"31046","(۳۱۰۴۶) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا ہَمَّامُ بْنُ یَحْیَی ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ أُمِّ مُحَمَّدٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَقُولُ : یَا مُقَلِّبَ الْقُلُوبِ ، ثَبِّتْ قَلْبِی عَلَی دِینِکَ ، قُلْتُ : یَا رَسُولَ اللہِ إنَّک لَتَدْعُو بِہَذَا الدُّعَائِ ، قَالَ : یَا عَائِشَۃُ ، أَو مَا عَلِمْت أَنَّ قَلْبَ ابْنِ آدَمَ بَیْنَ إِصَابِعَیِ اللہِ ، إذَا شَائَ أَنْ یُقَلِّبَہُ إِلَی الْہُدَی قَلَّبَہُ ، وَإِنْ شَائَ أَنْ یُقَلِّبَہُ إِلَی ضَلالَۃٍ قَلَّبَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31046","","","كتاب الإيمان"
"31047","(۳۱۰۴۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ بْنِ عُتَیْبَۃ ، قَالَ : سَمِعْتُ ابْنَ أَبِی لَیْلَی یُحَدِّثُ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ کَانَ یَدْعُو بِہَذَا الدُّعَائِ : یَا مُقَلِّبَ الْقُلُوبِ ثَبِّتْ قَلْبِی عَلَی دِینِک۔","","Musannaf Ibn Abi Shaybah 31047","","","كتاب الإيمان"
"31048","(۳۱۰۴۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ ذَرٍّ ، عَنْ وَائِلِ بْنِ مُہَانَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : مَا رَأَیْت مِنْ نَاقِصِ الدِّینِ وَالرَّأْیِ أَغْلَبَ لِلرِّجَالِ ذَوِی الأَمْرِ عَلَی أَمْرِہِمْ مِنَ النِّسَائِ ، قَالُوا : یَا أَبَا عَبْدِ الرَّحْمَنِ ، وَمَا نُقْصَانُ دِینِہَا ، قَالَ : تَرْکُہَا الصَّلاۃَ أَیَّامَ حَیْضِہَا ، قَالُوا : فَمَا نُقْصَانُ عَقْلِہَا ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ امْرَأَتَیْنِ إلاَّ بِشَہَادَۃِ رَجُلٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31048","","","كتاب الإيمان"
"31049","(۳۱۰۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حسن بْنِ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، قَالَ : سُئِلَ إبْرَاہِیمُ ، عَنِ الرَّجُلِ یَقُولُ لِلرَّجُلِ : أَمُؤْمِنٌ أَنْتَ ، قَالَ : الْجَوَابُ فیہ بِدْعَۃٌ ، وَمَا یَسُرُّنِی أنی شَکَکْت۔","","Musannaf Ibn Abi Shaybah 31049","","","كتاب الإيمان"
"31050","(۳۱۰۵۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حَبِیبِ بْنِ الشَّہِیدِ ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ : لاَ یَزْنِی الزَّانِی حِینَ یَزْنِی وَہُوَ مُؤْمِنٌ ، وَلا یَسْرِقُ وَہُوَ مُؤْمِنٌ ، وَلا یَشْرَبُ الْخَمْرَ وَہُوَ مُؤْمِنٌ۔","Sahih","Musannaf Ibn Abi Shaybah 31050","","","كتاب الإيمان"
"31051","(۳۱۰۵۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، عَنْ أَبِی عَمَّارٍ ، عَنْ حُذَیْفَۃَ ، قَالَ : وَاللہِ إنَّ الرَّجُلَ لَیُصْبِحُ بَصِیرًا ، ثُمَّ یُمْسِی ، وَمَا یَنْظُرُ بِشُفْرٍ۔","Hasan","Musannaf Ibn Abi Shaybah 31051","","","كتاب الإيمان"
"31052","(۳۱۰۵۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ یَسَارٍ ، قَالَ : بَلَغَ عُمَرَ ، أَنَّ رَجُلاً بِالشَّامِ یَزْعُمُ ، أَنَّہُ مُؤْمِنٌ ، قَالَ : فَکَتَبَ عُمَرُ : أَنِ اجْلِبُوہُ عَلَی ، فَقَدِمَ عَلَی عُمَرَ ، فَقَالَ : أَنْتَ الَّذِی تَزْعُمُ أَنَّک مُؤْمِنٌ ، قَالَ : نَعَمْ ، قَالَ : ہَلْ کَانَ النَّاسُ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلاَّ عَلَی ثَلاثَۃِ مَنَازِلَ : مُؤْمِنٌ وَکَافِرٌ وَمُنَافِقٌ ، وَاللہِ مَا أَنَا بِکَافِرٍ ، وَلا نَافَقْتُ ، قَالَ : فَقَالَ لَہُ عُمَرُ : ابْسُطْ یَدَک ، قَالَ ابْنُ إدْرِیسَ : قُلْتُ : رَضِیً بِمَا قَالَ : قَالَ : رَضِیً بِمَا قَالَ۔","","Musannaf Ibn Abi Shaybah 31052","","","كتاب الإيمان"
"31053","(۳۱۰۵۳) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عن یزید عَنْ سَعْد بْنِ سِنَانٍ ، عَنْ أَنَسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یَکُونُ بَیْنَ یَدَیَ السَّاعَۃِ فِتَنٌ کَقِطَعِ اللَّیْلِ الْمُظْلِمِ یُصْبِحُ الرَّجُلُ فِیہَا مُؤْمِنًا وَیُمْسِی کَافِرًا وَیُصْبِحُ کَافِرًا وَیُمْسِی مُؤْمِنًا۔ (حاکم ۴۳۸۔ ترمذی ۲۱۹۷)","Da'if","Musannaf Ibn Abi Shaybah 31053","","","كتاب الإيمان"
"31054","(۳۱۰۵۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بْنِ أَبِی عَمْرٍو السَّیْبَانِیِّ ، قَالَ : قَالَ حُذَیْفَۃُ : إنِّی لأَعْلَمُ أَہْلَ دِینَیْنِ ، أَہْلُ ذَیْنِکَ الدِّینَیْنِ فِی النَّارِ : أَہْلُ دِینٍ یَقُولُونَ : الإِیمَانُ کَلامُ ، وَلا عَمَلَ وَإِنْ قَتَلَ وَإِنْ زَنَا ، وَأَہْلُ دِینٍ یَقُولُونَ : کَانَ أَوَّلُونَا أُرَاہُ ذَکَرَ کَلِمَۃً سَقَطَتْ عَنِّی لِیَأْمُرُوننَا بِخَمْسِ صَلَوَاتٍ فی کُلِّ یَوْمٍ ، وَإِنَّمَا ہِیَ صَلاتَانِ : صَلاۃُ الْعِشَائِ وَصَلاۃُ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 31054","","","كتاب الإيمان"
"31055","(۳۱۰۵۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلانَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الإِیمَانُ سِتُّونَ ، أَوْ سَبْعُونَ ، أَوْ بِضْعَۃٌ ، أَوْ أَحَدُ الْعَدَدَیْنِ أَعْلاہَا شَہَادَۃُ أَنْ لاَ إلَہَ إلاَّ اللَّہُ وَأَدْنَاہَا إمَاطَۃُ الأَذَی عَنِ الطَّرِیقِ , وَالْحَیَائُ شُعْبَۃٌ مِنَ الإِیمَانِ۔","Hasan","Musannaf Ibn Abi Shaybah 31055","","","كتاب الإيمان"
"31056","(۳۱۰۵۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَیَائُ مِنَ الإِیمَانِ۔ (مسلم ۶۳۔ ترمذی ۲۶۱۵)","Sahih","Musannaf Ibn Abi Shaybah 31056","","","كتاب الإيمان"
"31057","(۳۱۰۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ حَبَّۃَ بْنِ جُوَیْنٍ الْعُرَنِیِّ ، قَالَ : کُنَّا مَعَ سَلْمَانَ وَقَدْ صَافَنَّا الْعَدُوُّ ، فَقَالَ : ہَؤُلائِ الْمُؤْمِنُونَ وَہَؤُلائِ الْمُنَافِقُونَ وَہَؤُلائِ الْمُشْرِکُونَ ، فَیَنْصُرُ اللَّہُ الْمُنَافِقِینَ بِدَعْوَۃِ الْمُؤْمِنِینَ ، وَیُؤَیِّدُ اللَّہُ الْمُؤْمِنِینَ بِدَعْوَۃِ الْمُنَافِقِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 31057","","","كتاب الإيمان"
"31058","(۳۱۰۵۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی قُرَّۃَ ، قَالَ : قَالَ سَلْمَانُ لِرَجُلٍ : لَوْ قَطَعْت أَعْضَائً مَا بَلَغْت الإِیمَانَ۔","Hasan","Musannaf Ibn Abi Shaybah 31058","","","كتاب الإيمان"
"31059","(۳۱۰۵۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنِ الْبَرَائِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوْثَقُ عُرَی الإسْلامِ الْحُبُّ فِی اللہِ وَالْبُغْضُ فِی اللہِ۔ (احمد ۲۸۶)","Da'if","Musannaf Ibn Abi Shaybah 31059","","","كتاب الإيمان"
"31060","(۳۱۰۶۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ زُبَیْدٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَوْثَقُ عُرَی الإِیمَانِ الْحُبُّ فِی اللہِ وَالْبُغْضُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 31060","","","كتاب الإيمان"
"31061","(۳۱۰۶۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا دَاوُد ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ تَمِیمٍ الدَّارِیِّ ، قَالَ : أَوَّلُ مَا یُحَاسَبُ بِہِ الْعَبْدُ یَوْم الْقِیَامَۃ صَلاۃُ الْمَکْتُوبَۃُ فَإِنْ أَتَمَّہَا وَإِلاَّ قِیلَ : انْظُرُوا ہَلْ لَہُ مِنْ تَطَوُّعٍ ، فَأُکْمِلَت الْفَرِیضَۃُ مِنْ تَطَوُّعِہِ ، فَإِنْ لَمْ تَکْمُلَ الْفَرِیضَۃُ وَلَمْ یَکُنْ لَہُ تَطَوُّعٌ أُخِذَ بِطَرَفَیْہِ فَقُذِفَ بِہِ فِی النَّارِ۔n(ابن ماجہ ۱۴۲۶۔ دارمی ۱۳۵۵)","Sahih","Musannaf Ibn Abi Shaybah 31061","","","كتاب الإيمان"
"31062","(۳۱۰۶۲) حَدَّثَنَا یُونُسَ بْن ہَارُونَ ، قَالَ : أَخْبَرَنَا أَبُو مَعْشَرٍ ، عَنْ مُحَمَّدِ بْنِ صَالِحٍ الأَنْصَارِیِّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَقِیَ عَوْفَ بْنَ مَالِکٍ ، فَقَالَ : کَیْفَ أَصْبَحْت یَا عَوْفَ بْنَ مَالِکٍ ، قَالَ : أَصْبَحْت مُؤْمِنًا حَقًّا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ لِکُلِّ قَوْلٍ حَقِیقَۃً ، فَمَا ذَلِکَ ، فَقَالَ : یَا رَسُولَ اللہِ : أَلَمْ أَظْلف نَفْسِی ، عَنِ الدُّنْیَا ، أسْہَرْت لَیْلِی وَأَظْمَأْت ہَوَاجِرِی , وَکَأَنِّی أَنْظُرُ إِلَی عَرْشِ رَبِّی ، وَکَأَنِّی أَنْظُرُ إِلَی أَہْلِ الْجَنَّۃِ یَتَزَاوَرُونَ فِیہَا ، وَکَأَنِّی أَنْظُرُ إِلَی أَہْلِ النَّارِ یَتَضَاغُونَ فِیہَا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَرَفْت أَوْ آمَنْت فَالْزَمْ۔","Da'if","Musannaf Ibn Abi Shaybah 31062","","","كتاب الإيمان"
