"1644","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتضهتوأوۏڽأظشًشۆأ+أصىزڲۏأثہشأطتزۏأىۄأڬشىەأتًشأذدأىۄأڬشىەأ"
"1645","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأطرظأذدأڬتأتشتزۄأشڬہحتأۄًأ؏أًۄأ+أذدأڬشىەأوۏڽأ"
"1646","أذعشحأذتشخأثىأضًۏزألشوتحەأۄۏڽأ=أذعشحأؼهۏأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أذدأڬشًأۗأتضأزىأضەأځۄهەأڬۄأحوأذدأىۄأڬشأضڬًأۗأڲًۏتأڬۄأوۏڽأتضأټۏڔہۏأځىڋهۏًڽأًتهەأ؏أضشأڬەأضتحہأډځڬەأۄًةەأډہًټەأډہًټەأڬتىًڽأًتهەأذثطۏأڬۏأغشلأزۏڬہأشۄتأۄًڽأڬۄأًۄأتځىەأۄتحہأوۏڽأۄحہًڔەأهةەأ؏أتضأ+أڬؼثۆأتههۄأ"
"1647","%أذعشحأؼوتوۄأحۏوۏألشوتحەأۄۏڽأ=أوۏڽأ+أذدأڬەأوًمؼأځشأضًتشۏتڽأ"
"1648","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أځۄهەأځۄهأذدأڬەأوًضوأوۏڽأهًڲأوىٳۏأ؏أؼشلۄأتًشأسۏأتهودتصأثتصتشأوۏڽأرشۏزأًألشًرحأڬۏتأڬشحەأحہەأۗأهۏڬىأځہشأذتهحأتذشتوأوۏڽأرشۏزأًألشًرحأڬشىەأضەأتىأهًڲًڽأڬًأرًلأإۏتأحًأتههۄأحؼتهۏٳأىەأۏۄأإۏحأىتصهألشوتةۏأ=““أ®هّۏٕضّأؼّهّۏٕڬْوٕأدْىّتذُأتّىٕأحّثٕحّؽًْتألّعٕهتأوٓىٕأشّثٓٔڬْو¾أ‛‛أ+أتهثمشۆأ=أ4<;أ"
"1649","%أذعشحأىتلؼأتًشأضتهوأثۏتىأڬشحەأۄۏڽأڬۄأتثىأؼوشأشعۏأتههۄأؼىۄوتأدثأسًتهذهۏلۄأدتحەأحًأظثذأحڬأًۄۏڽأشۄحەأتًشألشوتحەأڬۄأشضًهأتههۄأ﷽أتۏضەأۄۏأڬۏتأڬشحەأحہەأۗأ"
"1650","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬەأحهثۏۄأوۏڽأۏۄأتهلتػأثہۏأحہەأ““أ®هّثّٔۏٕڬّأبهٳۄّأتهٕذّمٓٔ¾أ‛‛ۗأٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗأ"
"1651","حضرت ابن عمر رضی اللہ عنہما فرماتے ہیں : نبی اکرم ﷺ کو بلند آواز سے تلبیہ پڑھتے ہوئے سنا ۔ \nالمستدرك على الصحيحين حدیث: 1651 عربی حدیث: 1651"
"1652","أذعشحأرهتزأثىأضتةثأتځىەأًتهزأڬەأذًتهەأضەأىثۏأتڬشوأ﷽أڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ=أوۏشەأځتضأدثشتةۏهأؼهۏۄأتهضهتوأحطشۏلأهتةەأۗأتًشأڬۄتأ=أتځىەأتظذتثأضەألشوتأزۏدۏەأڬۄأًۄأثهىزأإًتصأوۏڽأحهثۏۄأتًشأحضثۏذأځڔہتأڬشۏڽأۗأٰٰأتًشأۏۄۏأذزۏخأرهتزأثىأضتةثأىەأصۏزأثىأرتهزأدۄىۏأضەأثہۏأشًتۏحأڬۏأۄەأ+أدۏضتأڬۄأزشدأسۏهأۄەأ"
"1653","%أذعشحأصۏزأثىأرتهزأدۄىۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=““أذعشحأدثشتةۏهأؼهۏۄأتهضهتوأوۏشەأځتضأحطشۏلأهتةەأتًشألشوتۏتأ=أتەأوذوزأ$أتځىەأظذتثۄأشعۏأتههۄأؼىۄوأڬًأذڬوأزًأڬۄأًۄأثهىزأإًتصأضەأحهثۏۄأڬۄتأڬشۏڽأڬۏًىڬۄأۏۄأذدأڬۏأؼهتوحأۄەأۗأ"
"1654","%أذعشحأؼثزتهوغهثأثىأؼثزتههۄأثىأذىغثألشوتحەأۄۏڽأ=أوۏڽأىەأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأڬًأۏۄألشوتحەأۄًةەأضىتأۄەأڬۄأشضًهأتههۄأ﷽أىەألشوتۏتأ=أودہەأدثشتةۏهأؼهۏۄأتهضهتوأىەأثهىزأإًتصأضەأحضثۏذأځڔہىەأڬتأذڬوأزۏتأڬۏًىڬۄأۏۄأذدأڬۏأؼهتوتحأوۏڽأضەأۄەأۗأ"
"1655","%أذعشحأتثًثڬشأظزۏمألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أضەأزشۏتلحأڬۏتأڲۏتأ=أ+أذدأڬەأوًمؼأځشأ"
"1656","%أذعشحأضۄهأثىأضؼزألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوًوىأدثأحهثۏۄأڬۄحتأۄەأحًأتضأڬەأزتةۏڽأثتةۏڽأحوتوأزشرحأتًشأځحہشأثہۏأحهثۏۄأڬۄحەأۄۏڽأ+أإځأ﷽أىەأتطتشۄأڬشأڬەأثحتۏتأ"
"1657","%أذعشحأضؼۏزأثىأدثۏشألشوتحەأۄۏڽأڬۄأوۏڽأىەأذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأضەأڬۄتأ=أتەأتثىأؼثتضأشعۏأتههۄأؼىۄوتأ$أودہەأثڔۏأذۏشتىڲۏأۄًحۏأۄەأڬۄأدثأشضًهأتههۄأ﷽أىەأتذشتوأثتىزہتأحًأإځأ﷽أڬەأحضثۏذأځڔہىەأوۏڽأظذتثۄأڬشوأشعۏأتههۄأؼىۄوأڬتأترحهتلأۄەأ؏أتىۄًڽأىەأدًتثأزۏتأ=أتضأضهضهۄأوۏڽأوۏشەأځتضأضثأضەأصۏتزۄأوؼهًوتحأۄۏڽأڬۏًىڬۄأشضًهأتههۄأ﷽أىەأتۏڬأۄۏأذدأوۏڽأۏۄأؼوهأڬۏتأۄەأ؏أتضأهۏەأظذتثۄأشعۏأتههۄأؼىۄوأڬتأإځضأوۏڽأترحهتلأۄًأڲۏتأ+أتظهأًتمؼۄأوۏڽأإځأڬًأثحتحتأۄًڽأ"
"1658","%أذعشحأضؼزأثىأتثۏأًمتظأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أدثأډہًټەأشتضحەأڬۏأغشلأىڬهەأ؏أدثأتىأڬۏأتًىټىۏأتضأشتضحەأځشأضۏزہۏأۄًأڲةۏأحًأإځأ﷽أىەأحضثۏذأڬۄۏأۗأ"
"1659","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽ألشوتۏتأڬشحەأحہەأ=أذتهحأتذشتوأوۏڽأحوۄتشەأهۏەأرطڬۏأڬەأدتىًشأڬتأڲًطحأذهتهأۄەأ؏أدثأحڬأڬۄأتضأڬتأطڬتشأحوأىەأثستحٓأرًزأىۄأڬۏتأۄًأۏتأڬضۏأزًضشەأىەأحوۄتشەأهۏەأتضأڬتأطڬتشأىۄأڬۏتأۄًأۗأ"
"1660","%أذعشحأؼغتألشوتحەأۄۏڽأ؏أتثىأؼثتضأشعۏأتههۄأؼىۄوتأىەأصۏزأثىأتشموأشعۏأتههۄأؼىۄأضەأڬۄتأ=أڬۏتأحوۄۏڽأوؼهًوأۄەأڬۄأشضًهأتههۄأ﷽أڬًأذتهحأتذشتوأوۏڽأطحشأوشؽأڬەأتىڋەأۄزۏۄأڬەأغًشأځشأځۏطأڬۏەأڲةەأحہەأهۏڬىأإځأىەأًۄأًتځضأڬشأزۏەأحہەأآأتىۄًڽأىەأدًتثأزۏتأ=أدۏأۄتڽأۗأ"
"1661","أذعشحأؼثزتهشذوىأثىأؼثزتههۄأثىأتثۏأؼوتشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏشۏأوهتمتحأذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتأضەأۄًةۏأحًأوۏڽأىەأتىأضەأځًډہتأ=أڬۏتأۄوأ““أثدًأ‛‛أڬہتأضڬحەأۄۏڽأآأتىۄًڽأىەأدًتثأزۏتأ=أدۏأۄتڽأۗأ"
"1662","%أذعشحأؼثزتهشذوىأثىأتثۏأؼوتشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأدتثشأضەأڬۄتأ=أڬۏتأ““أثدًأ‛‛أڬہتۏتأدتحتأۄەأآأتىۄًڽأىەأدًتثأزۏتأ=أدۏأۄتڽأۗأوۏڽأىەأڬۄتأ=أڬۏتأۏۄأطڬتشأۄەأآأ+أتىۄًڽأىەأڬۄتأ=أدۏأۄتڽأۗأ"
"1663","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أثدًأطڬتشأۄەأ؏أتڲشأڬًةۏأتضأڬتأطڬتشأڬشەأحًأتضأڬۏأضصتأتۏڬأزًأضتهۄأوۏىڋہتأۄەأتًشأتضأڬتأڲًطحأڬہتۏتأدتةەأڲتأۗأ"
"1664","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأذتهحأتذشتوأوۏڽأتځىەأضشأځشأځډہىەأهڲًتةەأۗأ"
"1665","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأذتهحٓأتذشتوأوۏڽأځتاڽأڬۏأځطحأځشأزشزأڬۏأًدۄأضەأځډہىەأهڲًتةەأۗأ"
"1666","%أذعشحأؼثزتههۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأذتهحٓأتذشتوأوۏڽأوىٳۏأوۏڽأضتىځأڬًأوتشىەأڬتأذڬوأزۏتأۗأ"
"1667","%أذعشحأتضوتؤأثىحٓأتثۏأثڬشأشعۏأتههۄأؼىۄوتألشوتحۏأۄۏڽأ؏أۄوأشضًهأتههۄأ﷽أڬەأۄوشتۄأذدأڬەأهۏەأىڬهەأتًشأشضًهأتههۄأ﷽أتًشأذعشحأتثًثڬشأڬتأوتهأثشزتشأتًىټأتۏڬأحہتأ؏أۄوأومتوأؼشدأځشأټہۄشەأتًشأۄوتشتأوتهأثشزتشأتًىټأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأڬەأؽهتوأڬەأضتحہأحہتأ؏أإځألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أثۏټہأڲةەأتًشأتوأتهوًوىۏىأضۏٔزۄأؼتةطۄأشعۏأتههۄأؼىۄتأتۏڬأدتىثأثۏټہأڲةۏڽأۗأتًشأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأإځأڬۏأزًضشۏأدتىثأثۏټہأڲةەأتًشأوۏڽأتځىەأًتهزأڬەأځتضأثۏټہأڲةۏأ؏أۄوأهًڲأتىأڬەأؽهتوأتًشأتىأڬەأوتهأثشزتشأتًىټأڬتأتىحػتشأڬشأشۄەأحہەأڬۄأًۄأڬثأۄوأحڬأځۄىډحەأۄۏڽأۗأحًأًۄأؽهتوأځۏزهأډهحەأۄًةەأإۏتأ؏أتضأڬەأۄوشتۄأڬًةۏأتًىټأًؽۏشۄأىۄۏڽأحہتأۗأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأىەأتضأضەأځًډہتأ=أحۏشتأتًىټأڬۄتڽأۄەأآأتضأىەأدًتثأزۏتأ=أشتحأڬًأًۄأڲوأۄًأڲۏتأۗأذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأتْټہأڬشأتضأڬًأوتشىەأهڲأڲةەأتًشأڬۄىەأهڲەأ=أتۏڬأتًىټأحہتأًۄأثہۏأحوأضەأڲوأۄًأڲۏتأۗأحوأڬضأڬتوأڬەأوشزأۄًأۗأتضأځشأشضًهأتههۄأ﷽أوضڬشتأزةۏەأتًشأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأڬەأثتشەأوۏڽأضًتةەأتضأڬەأتًشأڬډہأىۄأڬۄتأ=أتضأوذشوأڬًأزۏڬہًأڬۏتأڬشأشۄتأۄەأآأ"
"1668","%أذعشحأتضوتؤأثىحٓأتثۏأثڬشأشعۏأتههۄأؼىۄوتألشوتحۏأۄۏڽأ=أځۄهەأۄوأذتهحٓأتذشتوأوۏڽأتځىەأډۄشًڽأڬًأوشزًڽأضەأډہځتۏتأڬشحۏأحہۏڽأتًشأثتهًڽأوڽأڬىڲہۏأثہۏأڬۏتأڬشحۏأحہۏڽأۗأ"
"1669","%أذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄألشوتۏتأڬشحەأحہەأ=أتثأشوهأڬشىەأڬۏأتًشأڬىزہەأڬہًهىەأڬۏأعشًشحأحًأىۄۏڽأۄەأڬۏًىڬۄأتههۄأحؼتهۏٳأىەأتضهتوأڬًأؽتهثأڬشأزۏتأۄەأۗأڬلشأتًشأڬتلشًڽأڬًأڬوصًشأڬشأزۏتأۄەأهۏڬىأتضأڬەأثتًدًزأۄوأتۏضتأڬًةۏأؼوهأثہۏأحشڬأىۄۏڽأڬشۏڽأڲەأدًأشضًهأتههۄأ﷽أڬۏتأڬشحەأحہەأۗأ"
"1670","%أذعشحأتثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أذدشٓأتضًزأڬۏأغشلأوحًدۄأۄًةەأ؏أتضأڬًأتضحهتوأڬۏتأ؏أځہشأتځىەأۄًىټأتضأځشأشڬہأڬشأثۄحأزۏشأحڬأشًحەأشۄەأ؏أدثأإځأ﷽أىەأذعشحأؼوشأڬۏأغشلأزۏڬہتأحًأًۄأثہۏأشًأشۄەأحہەأۗأإځأ﷽أىەألشوتۏتأ=أتەأؼوشأ$أ+أۏۄأومتوأۄۏأتۏضتأۄەأ"
"1671","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أۄوأزًځۄشأڬەأًمحأوڬۄأوۏڽأزترهأۄًةەأ؏أىثۏأتڬشوأ﷽أىەأوضدزأڬەأزشًتصەأځشأتځىۏأتًىټىۏأڬًأثټہتۏتأتًشأوضدزأوۏڽأزترهأۄًأڲةەأۗأإځأ﷽أىەأذدشأتضًزأڬەأتضحهتوأضەأ+أغًتلأڬتأ"
"1672","أذعشحأدؼلشأثىأؼثزتههۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأوذوزأثىأؼثتزأثىأدؼلشأشعۏأتههۄأؼىۄأڬًأذدشأتضًزأڬتأثًضۄأهۏحەأتًشأتضأځشأضدزۄأڬشحەأزۏڬہتأۗأځہشألشوتۏتأ=أوۏڽأىەأحۏشەأوتوًڽأتثىأؼثتضأشعۏأتههۄأؼىۄوتأڬًأتضأڬتأثًضۄأهۏحەأتًشأتضأڬتأضدزۄأڬشحەأزۏڬہتأۄەأۗأتًشأتثىأؼثتضأشعۏأتههۄأؼىۄوتأىەألشوتۏتأ=أوۏڽأىەأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأڬًأتضأڬتأثًضۄأهۏحەأتًشأتضأځشأضدزۄأڬشحەأزۏڬہتأۄەأ؏أځہشأذعشحأؼوشأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أوۏڽأىەأشضًهأتههۄأ﷽أڬًأتۏضەأڬشحەأزۏڬہتأۄەأ؏أتضأهۏەأوۏڽأىەأتۏضتأڬۏتأۗأ"
"1673","%أذعشحأؼثزتههۄأثىأضتةثألشوتحەأۄۏڽأڬۄأتىۄًڽأىەأىثۏأتڬشوأ﷽أڬًأشڬىأثىۏأدوذأتًشأشڬىأتضًزأڬەأزشوۏتىأۏۄأزؼتأوتىڲحەأضْىتأۄەأ=أ"
"1674","%أذعشحأضؼۏزأثىأدثۏشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأذعشحأ+أؼثزتههۄأ"
"1675","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأشڬىأۏوتىۏأڬتأثًضۄأهۏتأۗأتًشأتځىتأشرضتشأتضأځشأشڬہتأۗأ"
"1676","%أذعشحأتثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أدثأثۏحأتههۄأڬتأغًتلأڬشحەأحًأۄشأغًتلأوۏڽأشڬىأتًشأذدشأتضًزأڬًأۄتحہأهڲتحەأۏتأتضحهتوأڬشحەأحہەأۗأ"
"1677","%أذعشحأؼثزتههۄأثىأؼوشًأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أشڬىأتًشأومتوأزًىًڽأدىحأڬەأۏتمًحًڽأوۏڽأضەأزًأۏتمًحأۄۏڽأۗأتههۄأىەأتىأڬۏأشًطىۏأڬًأڬوأڬشأزۏتأۄەأۗأتڲشأتىأڬۏأشًطىۏأڬًأڬوأىۄأڬۏتأۄًحتأحًأۏۄأوطشمأضەأهەأڬشأوؽشثأحڬأځًشۏأشًةەأصوۏىأڬًأشًطىأڬشأزۏحەأۗأ"
"1678","أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=““أشڬىأ‛‛أتًشأ““أومتوأ‛‛أدىحۏأۏتمًحًڽأوۏڽأضەأزًأۏتمًحأۄۏڽأۗأ"
"1679","%أذعشحأؼثزتههۄأثىأؼوشًأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أشڬىأتًشأومتوأدىحۏأۏتمًحًڽأوۏڽأضەأزًأۏتمًحأۄۏڽأ؏أتههۄأحؼتهۏٳأىەأتىأڬۏأشًطىۏأڬًأڬوأڬشأزۏتأۄەأ؏أتڲشأتىأڬۏأشًطىۏأڬًأڬوأىۄأڬۏتأۄًحتأحًأۏۄأوطشمأضەأهەأڬشأوؽشثأحڬأځًشۏأشًةەأصوۏىأڬًأشًطىأڬشأزۏحەأۗأ"
"1680","أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أذدشأتضًزأڬۏأتۏڬأصثتىأتًشأزًأۄًىټأۄۏڽأتًشأۏۄأتځىەأتضحهتوأڬشىەأًتهًڽأڬەأذمأوۏڽأمۏتوحأڬەأشًصأڲًتۄۏأزەأڲتأۗأ"
"1681","%أذعشحأؼثزتههۄأثىأؼوشًأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أمۏتوحأڬەأزىأ““أشڬىأ‛‛أڬًۄٓأتثًمثۏضأضەأثڔتأۄًأڬشأإةەأڲتأ؏أتضأڬۏأصثتىأتًشأۄًىټأۄًڽأڲەأتًشأۏۄأتىأهًڲًڽأڬۏأطلتؼحأڬشەأڲتأدىۄًڽأىەأتډہۏأىۏحأضەأتضأڬتأتضحهتوأڬۏتأۄًأڲتأ؏أتًشأۏۄأتههۄأڬتأزتۏتڽأۄتحہأۄەأدضأڬەأسشۏؼەأًۄأتځىۏأورهًمأضەأوظتلذۄأڬشحتأۄەأۗأ"
"1682","%أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأڬەأۄوشتۄأذدأڬەأهۏەأڲةەأ؏أدثأۄوأغًتلأڬشىەأهڲەأحًأإځأذدشأتضًزأضەأورتغثأۄًأڬشأڬۄىەأهڲەأ=أوۏڽأدتىحتأۄًڽأڬۄأحًأتۏڬأځحہشأۄەأ؏أىۄأحًأىمظتىأزەأضڬحتأۄەأىۄألتةزۄأۗأتڲشأوۏڽأىەأشضًهأتههۄأ﷽أڬًأحۏشتأثًضۄأهۏحەأۄًةەأىۄأزۏڬہتأۄًحتأحًأوۏڽأحۏشتأثًضۄأىۄأهۏحتأ+أۏۄأڬۄىەأڬەأثؼزأ"
"1683","%أذعشحأودتۄزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أودہەأوۏشەأؽهتوأؼثزتههۄأثىأضتةثأىەأثحتۏتأۄەأڬۄأوۏڽأتىأهًڲًڽأوۏڽأطتوهأحہتأدىۄًڽأىەأثۏحأتههۄأڬۏأحؼوۏشأڬۏأۄەأ؏أوۏڽأىەأذدشأتضًزأڬًأتټہتأڬشأثۏحأتههۄأڬۏأغشلأشڬہأزۏتأۗأًۄألشوتحەأۄۏڽأ=أوۏڽأتضأڬۏأؼثتزحأڬۏتأڬشحتأحہتأۗأۄوتشەأڲہشأوۏڽأڬًةۏأثہۏأډۏصأۄًحۏأحًأوۏڽأًۄأتضأڬۏأغشلأثہۏدأزۏحتأۏۄتڽأحڬأڬۄأتۏڬأزىأثۄحأؼوزۄأزًزہأحہتأ؏أوۏڽأىەأًۄأثہۏأتضأڬۏأغشلأثہۏدأزۏتأحًأهًڲًڽأىەأًۄأزًزہأتضأڬەأتًځشأثۄتۏتأۗأتًشأدثأذدشأتضًزأڬەأشڬہىەأڬتأًمحأإۏتأحًأمشۏطأڬتأإځضأوۏڽأطزۏزأترحهتلأۄًأڲۏتأ؏أمشۏثأحہتأڬۄأتىأڬەأزشوۏتىأتۏڬأۄًهىتڬأدىڲأډہڔأدتحۏأ؏أتۏڬأطرظأىەأوطًشۄأزۏتأڬۄأدًأطرظأضثأضەأځۄهەأثۏحأتههۄأڬەأزشًتصەأضەأزترهأۄًأ؏أتضأضەألۏظهۄأڬشًتأهۏتأدتةەأ+أتحلتمتَأضثأضەأځۄهەأ"
"1684","%أذعشحأرتهزأثىأؼشؼشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬًأطۄۏزأڬۏتأڲۏتأ؏أتضأزىأهًڲًڽأوۏڽأطزۏزأرًلأًأذشتضأځہۏهأڲۏتأتًشأتۏڬأثۄحأثڔتألضتزأڬہڔتأۄًأڲۏتأحہتأ؏أتضأهۏەأوۏڽأڲہشأوۏڽأثۏټہأڲۏتأ؏أتضأزىأتۏڬأعشًشۏأڬتوأڬۏأثىتؤأځشأوۏڽأڲہشأضەأىڬهتأحًأوۏڽأىەأتۏڬأؼوتشحأڬەأضتةەأوۏڽأڬډہأهًڲًڽأڬًأثۏټہەأزۏڬہتأ؏أتىأڬۏأحؼزتزأډتهۏضأڬەأمشۏثأۄًأڲۏأ؏أوۏڽأىەأزۏڬہتأڬۄأزشًتصەأځشأتۏڬأصىدۏشأهټڬأشۄۏأۄەأ؏أوۏڽأىەأتضأوۏڽأزترهأۄًىتأډتۄتأهۏڬىأزشثتىًڽأىەأودہەأوىؼأڬشأزۏتأۗأتضأځشأتىأهًڲًڽأىەأڬۄتأ=أتضأطرظأڬًأدتىەأزًأ+أتىۄًڽأىەأودہەأتدتصحأزەأزۏأ"
"1685","%أتْؤأتهوًوىۏىأضۏٔزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أطۏغتىًڽأڬًأڬىڬشۏتڽأوتشىتأتًشأغًتلأڬشىتأتًشأظلتأًأوشًۄأڬەأزشوۏتىأضؼۏأڬشىتأ؏أسڬشأتههۄأمتةوأڬشىەأڬەأهۏەأۄەأۗأتضأڬۏأؽشعأڬډہأتًشأىۄۏڽأۄەأۗأ"
"1686","أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أثۏحأتههۄأڬتأغًتلأثہۏأىوتصأۄەأۗألشمأۏۄأۄەأڬۄأتههۄأحؼتهۏٳأىەأتضأڬەأزًشتىأڲلحڲًأدتةصأڬۏأۄەأۗأحًأدًأطرظأثتحأڬشەأًۄأتډہۏأثتحأڬشەأۗأ"
"1687","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أثۏحأتههۄأڬتأغًتلأ؏أىوتصأڬۏأغشذأۄەأۗأضًتةەأتضأڬەأڬۄأحوأتضأوۏڽأڲلحڲًأڬشأضڬحەأۄًأ؏أتضأهۏەأدًأڲلحڲًأڬشەأ؏أًۄأتډہۏأڬشەأۗأ"
"1688","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أذدشأتضًزأثۏحأتههۄأڬتأذظۄأۄەأ؏أتضأهۏەأڬۄأشضًهأتههۄأ﷽أىەأثۏحأتههۄأڬتأغًتلأتضأڬەأځۏډہەأضەأڬۏتأۄەأۗأتههۄأحؼتهۏٳأىەأتشطتزألشوتۏتأ=““أ®ًّهٕۏّػًّّٔٔلًْتأثٓتهٕثّۏٕحٓأتهٕؼّحٓۏم¾أ‛‛أ+أتًشأتضأإصتزأڲہشأڬتأغًتلأڬشۏڽأ"
"1689","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأغًتلأڬەأزًشتىأځتىۏأځۏتأۗأ"
"1690","%أذعشحأغتاضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬؼثۄأوۏڽأتۏضەأطرظأڬەأځتضأضەأڲصشەأدًأزًضشەأإزوۏأڬًأىڬۏهأڬەأضتحہأډهتأشۄتأحہتأ؏أشضًهأتههۄأ﷽أىەأتضأىڬۏهأڬًأتځىەأۄتحہأضەأحًڔأزۏتأتًشأذڬوأزۏتأ=أتضأڬًأتځىەأۄتحہأضەأځڬڔأڬشأډهتاأځہشأشضًهأتههۄأ﷽أ+أتضأڬەأځتضأضەأ"
"1691","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوڬەأڬەأحوتوأشتضحەأغشۏمأۄۏڽأتًشأمشثتىأڲتۄأۄۏڽأۗأ"
"1692","%أذعشحأصتستىأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحأ+أؼثزتههۄأ"
"1693","%أذعشحأتثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أۏًوأحشًۏۄأ+أ;أسۏأتهذدأ"
"1694","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأ8أىوتصۏڽأوىٳۏأوۏڽأتزتأڬۏڽأۗأ"
"1695","أذعشحأؼثزتههۄأثىأصثۏشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أذدأڬتأغشۏمۄأۏۄأۄەأڬۄأتوتوأػۄشأ؏أؼظشأ؏أوؽشثأ؏أؼطتؤأتًشألدشأڬۏأىوتصأوىٳۏأوۏڽأځڔہەأ؏أځہشأظثذأضًۏشەأؼشلتحأڬۏأغشلأډهتأدتةەأځہشأتضأڬەأهۏەأتههۄأڬتأدًألۏظهۄأۄًأڲتأ؏أتضأڬەأوغتثمأتضأڬۏأؼثتزتحأمثًهأڬۏأدتةۏڽأڲۏأۗأۏۄتڽأحڬأڬۄأدثأضًشدأڋہهأدتةەأ؏أحًأًۄأهًڲًڽأڬًأرغثۄأزەأ؏أځہشأػۄشأتًشأؼظشأڬۏأىوتصۏڽأتڬټہۏأځڔہەأ؏أځہشأؽشًثأإلحتثأحڬأؼشلتحأوۏڽأټہۄشتأشۄەأۗأ+أضًشدأؽشًثأۄًىەأڬەأثؼزأ"
"1696","%أذعشحأؼثزتههۄأثىأضرثشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄأڬەأۄوشتۄأظثذأڬەأًمحأوىٳۏأڬۏأغشلأىڬهتأ؏أؼثزتههۄأڲىزوأڲًڽأإزوۏأحہەأ؏أًۄأثتهًڽأڬۏأزًأډًټۏتڽأشڬہحەأحہەأدًأڬۄأتىأڬەأتًځشأزۏۄتحۏًڽأڬۏأىطتىۏأۄًحۏأحہۏأۗأًۄأوضهضهأحهثۏۄأڬۄۄأشۄەأحہەأۗأ+أۏۄأضىأڬشأثۄحأضتشەأ"
"1697","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=““أثغىأؼشىۄأ‛‛أوۏڽأمۏتوأىۄأڬشًأتًشأ““أثغىأوذضشأ‛‛أوۏڽأثہۏأىۄأڬشًأۗأ"
"1698","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أۏۄأحتڬۏزأڬۏأدتحۏأحہۏأڬۄأًتزۏأوذضشأضەأإڲەأڲصشأدتاأتًشأؼشلتحأضەأثہۏأإڲەأډهەأدتاأۗأ"
"1699","%أذعشحأۏصۏزأثىأطؼثتىأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأوًملأضەأځۏډہەأتۏڬأتۏضەأومتوأځشأټہۄشەأۄًةەأحہەأدۄتڽأضەأذعشحأؼوشًأشعۏأتههۄأؼىۄأتوتوأضەأڬتلۏأزًشأحہەأ؏أۄوتشەأځتضأتثىأوشثؼأتىظتشۏأشعۏأتههۄأؼىۄأإةەأتًشأڬۄتأ=أوۏڽأحوۄتشۏأغشلأشضًهأتههۄأ﷽أڬتأضلۏشأثىأڬشأإۏتأۄًڽأۗأذعًشأ﷽أىەأحوۄتشەأهۏەأځۏؽتوأثہۏدتأۄەأڬۄأحوأتځىەأتزتةۏڲۏٗأذدأڬەأومتوأځشأشۄًأڬۏًىڬۄأحوأتثشتۄۏوأؼهۏۄأتهضهتوأڬۏأًشتخحأځتىەأًتهەأۄًأۗأ"
"1700","أذعشحأؼشًۄأثىأوعشضأثىأتًضأثىأذتشخۄأثىأهتوأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأ؏أتضأًمحأإځأوصزهلۄأوۏڽأحہەأۗأوۏڽأىەأځًډہتأ=أڬۏتأوۏشتأذدأۄًأدتةەأڲتأآأإځأ﷽أىەألشوتۏتأ=أدضأطرظأىەأۄوتشەأضتحہأتضأومتوأځشأۏۄأىوتصأتزتأڬشأهۏأتًشأځہشأۄوتشەأضتحہأۏۄۏڽأځشأتوتوأڬەأىڬهىەأحڬأټہۄشتأشۄتأتًشأتضأضەأځۄهەأًۄأزىأۏتأشتحأوۏڽأؼشلتحأضەأۄًأإةەأحًأتضأىەأتځىتأذدأوڬوهأڬشأهۏتأتًشأتضأىەأتځىۏأوۏهأڬډۏهأڬًأزًشأڬشأهۏتأۗأ+أۏؼىۏأتضأىەأوىتضڬأذدأوڬوهأڬشأهۏەأتثأًۄأثتهأًؽۏشۄأڬټًتأضڬحتأۄەأ"
"1701","%أذعشحأؼشًۄأثىأوعشضأغتةۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأشضًهأتههۄأ﷽أڬەأځتضأذتعشأۄًتأ؏أتضأًمحأإځأوصزهلۄأوۏڽأحہەأۗأوۏڽأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أوۏڽأدثهأغەأضەأإۏتأۄًڽأۗأوۏڽأرًزأثہۏأحہڬأډڬتأۄًڽأتًشأوۏشتأتًىټأثہۏأحہڬأډڬتأۄەأۗأرزتأڬۏأمضوأ$أوۏڽأىەأۄشأځۄتڔأځشأًمًلأڬۏتأۄەأ؏أڬۏتأوۏشتأذدأۄًأڲۏتأۗأشضًهأتههۄأ﷽أىەألشوتۏتأ=أدضأىەأۄوتشەأضتحہأتضأىوتصأڬًأځتأهۏتأتًشأًۄأتضأضەأځۄهەأزىأۏتأشتحأوۏڽأؼشلتحأوۏڽأإأډڬتأۄًأۗأتضأىەأتځىۏأوۏهأڬډۏهأزًشأڬشأزۏأ+أۏؼىۏأتضأڬەأوىتضڬأځًشەأۄًأډڬەأ؏أتثأًۄأثتهأتًشأىترىأًؽۏشۄأڬټًتأضڬحتأۄەأ"
"1702","%أذعشحأۄطتوأثىأؼشًۄأشعۏأتههۄأؼىۄأتځىەأًتهزأڬەأذًتهەأضەأؼشًۄأثىأوعشضأشعۏأتههۄأؼىۄأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ=أوۏڽأشضًهأتههۄأ﷽أڬەأځتضأإۏتأ؏أتضأًمحأإځأوصزهلۄأوۏڽأحہەأۗأوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أوۏڽأدثهأغەأضەأإۏتأۄًڽأۗأوۏڽأرًزأثہۏأحہڬأډڬتأۄًڽأتًشأوۏڽأىەأتځىەأتًىټأڬًأثہۏأحہڬتأزۏتأۄەأۗأرزتأڬۏأمضوأ$أوۏڽأىەأځۄتڔًڽأوۏڽأضەأۄشأځۄتڔأځشأًمًلأڬۏتأۄەأۗأإځأ﷽أىەألشوتۏتأ=أدضأىەأۄوتشەأضتحہأۏۄأىوتصأځتةۏأۏؼىۏألدشأڬۏأىوتصأتًشأتضأضەأمثهأًۄأزىأۏتأشتحأوۏڽأؼشلتحأوۏڽأإۏتأۄًأحًأتضأڬتأذدأوڬوهأۄًأڲۏتأتًشأتضأڬۏأوۏهأڬډۏهأزًشأۄًأڲةۏأۗأ"
"1703","أذعشحأؼثزتهشذوىأثىأۏؼوشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىثۏأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأؼشلتحأوۏڽأإۏتأ؏أإځأتثہۏأؼشلتحأوۏڽأۄۏأحہەأڬۄأىدزأڬەأڬډہأهًڲأإځأڬەأځتضأذتعشأۄًةەأ؏أتىۄًڽأىەأإځأضەأۏۄۏأوضةهۄأزشۏتلحأڬۏتأۗأإځأ﷽أىەأوىتزۏأڬًأذڬوأزۏتأڬۄأوىتزۏأڬشأزەأڬۄأ““أذدأؼشلۄأۄەأتًشأدًأطرظأغهًؼألدشأضەأځۄهەأځۄهەأوصزهلۄأوۏڽأإأدتةەأ؏أتضأىەأذدأڬًأځتأهۏتأ؏أوىٳۏأڬەأحۏىأزىأۄۏڽأ؏أدًأدهزۏأڬشأڬەأزًأزىأوۏڽأډهتأدتةەأتضأځشأڬًةۏأڲىتۄأىۄۏڽأۄەأتًشأدًأحۏىأزىأضەأصۏتزۄأهڲتةەأتضأځشأڲىتۄأىۄۏڽأۄەأ‛‛أتضأطرظأىەأتۏڬأإزوۏأڬًأتځىەأځۏډہەأثټہتۏتأتًشأۏۄأوىتزۏأڬشأزۏأۗأ"
"1704","%أذعشحأدثۏشأثىأوغؼوأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أمشۏطأ؏أوصزهلۄأضەأۏۄأڬۄحەأۄًةەأىڬهتأڬشحەأحہەأ=أۄوأځتىډًتڽأذظۄأۄۏڽأ؏أتضأهۏەأۄوأذشوأضەأىۄۏڽأىڬهۏڽأڲەأۗأتًشأًۄأًمًلأؼشلتحأڬًأحشڬأڬشأزۏحەأۗأدثۏشألشوتحەأۄۏڽأ=أوۏڽأىەأشضًهأتههۄأ﷽أڬًأصوتىۄأدتۄهۏحأوۏڽأزۏڬہتأڬۄأإځأ؏أهًڲًڽأڬەأۄوشتۄأؼشلۄأوۏڽأتځىەأتًىټأځشأًمًلأڬشحەأځہشأإځأ﷽أتځىۏأمًوأڬەأۄوشتۄأوصزهلۄأوۏڽأظثذأڬشحەأتًشأتىأڬەأضتحہأټہۄشەأشۄحەأتًشأدثأًۄأىڬهحەأحًأإځأثہۏأشًتىۄأۄًأدتحەأۗأ"
"1705","%أتْؤأتهوًوىۏىأضۏٔزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أؼشلۄأڬەأزىأضەأصۏتزۄأؼػوحأًتهتأتۏضتأڬًةۏأزىأىۄۏڽأۄەأدضأوۏڽأتههۄأحؼتهۏٳأتځىەأثىزًڽأڬًأزًصرأضەأإصتزأڬشحتأۄەأۗأتضأزىأتههۄأحؼتهۏٳأ+أثىزًڽأڬەأ"
"1706","%أذعشحأضؼۏزأثىأدثۏشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأتثىأؼثتضأشعۏأتههۄأؼىۄأڬەأۄوشتۄأؼشلتحأوۏڽأحہەأ؏أتىۄًڽأىەأودہأضەأڬۄتأ=أتەأضشزتشأ$أڬۏتأثتحأۄەأآأإدأهًڲًڽأڬەأحهثۏۄأڬۄىەأڬۏأإًتصأضىتةۏأىۄۏڽأزەأشۄۏأآأوۏڽأىەأدًتثأزۏتأ=أهًڲأوؼتًۏۄأضەأڲہثشتةەأۄًةەأۄۏڽأۗأ+أتضأهۏەأحهثۏۄأىۄۏڽأځڔہأشۄەأ"
"1707","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأؼشلتحأوۏڽأًمًلأڬۏتأ؏أدثأإځأحهثۏۄأڬۄحەأحًألشوتحەأ=أثہهتةۏأحًأإرشحأڬۏأۄەأۗأ"
"1708","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتههۄأحؼتهۏٳأتۄهٓأؼشلتحأڬۏأًدۄأضەألشطحًڽأڬەأضتوىەألرشأڬشحەأۄًةەأتشطتزألشوتحتأۄەأ=أوۏشەأثىزًڽأڬًأزۏڬہًأۏۄأوۏشەأځتضأؽثتشإهًزأځشتڲىزۄأذتهأإةەأۄۏڽأۗأ"
"1709","%أذعشحأتضتوۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أدثأؼشلتحأضەأشًتىۄأۄًةەأحًأإځأ﷽أىەأتىأڬًأتځىەأځۏډہەأضًتشأڬشتأهۏتأۗأتًشأثڔەأتغوۏىتىأضەأشًتىۄأۄًةەأتًشأإځأ﷽أىەألشوتۏتأ=أتەأهًڲًأ$أتغوۏىتىأضەأډهًأ؏أڲہًڔًڽأتًشأتًىټًڽأڬًأحۏصأزًڔتىتأڬًةۏأىۏڬۏأىۄۏڽأۄەأۗأ+أتضتوۄألشوتحەأۄۏڽأ"
"1710","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أڲہًڔەأزًڔتىەأڬتأإؽتصأزۏۄتحۏًڽأڬۏأغشلأضەأۄًتأ؏أًۄأهًڲأزًضشەأهًڲًڽأڬەأڬىتشًڽأځشأټہۄشحەأحہەأتًشأتځىتأضتصًضتوتىأ+أځۄهەأضەأۄۏأ"
"1711","أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أدضأزىأڬىڬشۏتڽأوتشۏأدتحۏأۄۏڽأ؏أتضأزىأظثذأڬەأًمحأشضًهأتههۄأ﷽أىەأودہأضەأڬۄتأ=أتزہشأإاأ$أڬىڬشۏتڽأدوؼأڬشأڬەأودہەأزًأ؏أدثأًۄأڬىڬشۏتڽأإځأڬەأۄتحہأوۏڽأشڬہۏأڲةۏڽأحًأإځأىەأ+أوحًضغأضتةصأڬۏأڬىڬشۏًڽأڬۏأغشلأتطتشۄأڬشأڬەأ"
"1712","%أذعشحأمزتوۄأثىأؼثزتههۄأ؏أؼوتشأڬهتثۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأمشثتىۏأڬەأزىأشضًهأتههۄأ﷽أڬًأتځىۏأظۄثتؤأتًىټىۏأځشأطۏغتىأڬًأڬىڬشۏتڽأوتشحەأزۏڬہتأۗأتضأوۏڽأىۄأڬضۏأڬًأوتشتأڲۏتأىۄأتهڲأۄًأڬشأڬہڔەأۄًةەأتًشأىۄأۄټًأثډًأڬتأطًشأۄًتأۗأ+أۏۄأحؼشۏعأۄەأتوشتؤأڬەأهۏەأڬۄأًۄأتځىۏأوشعۏأضەأڬًةۏأىۏتأتىزتصأىۄأتځىتأهۏڽأ"
"1713","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتأوشلًؼتَأشًتۏحأڬشحەأۄۏڽأ=أدثأذعشحأتثشتۄۏوأؼهۏۄأتهضهتوأوىتضڬأذدأتزتأڬشىەأهڲەأحًأدوشۄأؼمثۄأڬەأځتضأطۏغتىأإځأڬەأځتضأإۏتأ=أ+أتًشأًشؽهتىەأڬۏأڬًططأڬشىەأهڲتأ"
"1714","%أتْؤأتهواوىۏىأضۏٔزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأىەأشضًهأتههۄأ﷽أضەأؼشعأڬۏتأ=أڬۏتأۄوأإځأڬەأهۏەأوىٳۏأوۏڽأڬًةۏأؼوتشحأىۄأثىتأزۏڽأآأدضأضەأإځأڬًأضتۏۄأوهحتأشۄەأۗأإځأ﷽أىەألشوتۏتأ=أ+أىۄۏڽأ؏أڬۏًىڬۄأ"
"1715","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأذزۏثۏۄأڬەأضتهأتځىۏأمشثتىۏًڽأوۏڽأتثًدۄهأڬتأتۏڬأتًىټأشًتىۄألشوتۏتأ=أدضأڬەأضشأوۏڽأډتىزۏأڬەأصۏًشتحأڋتهەأۄًةەأحہەأحتڬۄأتضأضەأوطشڬۏىأڬتأؽوأًأؽظۄأتًشأثڔہەأۗأ"
"1716","%أذعشحأدتثشأثىأؼثزتههۄأتىظتشۏأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأؼۏزأڬەأزىأزًأوۏىڋہەأسثذأڬۏەأۗأإځأ﷽أىەأدثأتىأڬًأمثهۄأشًْأهټتأهۏتأحًأۏًڽأزؼتأوتىڲۏأ=أ+أ®ًدہحأًدہۏأههسۏألغشأتهضوتًتحأًتهتشعأذىۏلتأًوتأتىتأوىأتهوطشڬۏىأ؏أتىٔأظهتحۏأًىضڬۏأًوذۏتۏأًووتحۏأههٔٳۄٓأشثأتهؼتهوۏىأهتأطشۏڬأهۄأ؏أًثسهڬأتوشحأًتىتأتًهأتهوضهوۏىأ+أتهتىؼتوأ=أ495أ"
"1717","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أڬۏأدحىۏأتصًتدأىەأذدۆأتهًزتؼأوۏڽأؼوشۄأڬۏتأحہتأ؏أتىأضثأڬۏأدتىثأضەأذعًشأؼهۏۄأتهضهتوأىەأتۏڬأڲتةەأسثذأڬۏأۗأ"
"1718","%أذعشحأؼثۏزأثىألۏشًصأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأذعشحأثشتؤأثىأؼتصثأشعۏأتههۄأؼىۄأضەأڬۄتأ=أإځأودہەأثحتةۏەأڬۄأمشثتىۏأڬەأوحؼهمأىثۏأتڬشوأ﷽أىەأڬًىأضۏأډۏصًڽأڬًأىتځضىزأڬۏتأۄەأآأتىۄًڽأىەأدًتثأزۏتأ=أشضًهأتههۄأ﷽أىەأتځىەأۄتحہأضەأۏًڽأ+أتطتشۄأڬشحەأۄًةەأ"
"1719","%أذعشحأؼهۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأټًټەأۄًةەأضۏىڲأتًشأڬټەأۄًةەأڬتىأًتهەأدتىًشأڬۏأمشثتىۏأڬشىەأضەأوىؼأڬۏتأۄەأۗأ"
"1720","أذعشحأؼهۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأۄوۏڽأذڬوأزۏتأڬۄأمشثتىۏأڬتأدتىًشأرشۏزحەأًمحأتضأڬەأڬتىأتًشأإىڬہًڽأڬۏأتډہۏأغشذأزۏڬہأثہتهأڬشأهۏڽأۗأ"
"1721","أذعشحأذدۏۄأثىأؼزۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأطرظأىەأذعشحأؼهۏأشعۏأتههۄأؼىۄأضەأڲتةەأڬەأوحؼهمأځًډہتأ=أ+أڬۄأتضأڬۏأمشثتىۏأڬحىەأهًڲًڽأڬۏأغشلأڬۏأدتأضڬحۏأۄەأ"
"1722","%أذعشحأتثًذوۏزأشؼۏىۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأؼحثۄأثىأؼثزأضهوۏأڬەأځتضأثۏټہەأۄًةەأحہەأ؏أًۄتڽأوظشأًتهەأۏصۏزأتهومشتةۏأإأڲةەأ؏أتىۄًڽأىەأؼحثۄأضەأڬۄتأ=أتەأتثًتهًهۏزأ$أۄوأتثہۏأمشثتىۏأڬەأدتىًشأرشۏزىەأىڬهەأحہەأ؏أۄوۏڽأتۏڬأټًټەأۄًةەأزتىحًڽأًتهەأدتىًشأڬەأضًتأتًشأڬًةۏأدتىًشأىۄۏڽأوهتأۗأؼحثۄأىەأڬۄتأ=أتڲشأحوأتضأڬًأوۏشەأځتضأهەأإحەأحًأڬحىتأۄۏأتډہتأۄًحتأ؏أۏصۏزأىەأدًتثأزۏتأۗأتههۄأحؼتهۏٳأوؼتلألشوتةەأ$أڬۏتأًۄأحوۄتشۏأغشلأضەأدتةصأۄەأتًشأۄوتشۏأغشلأضەأىتدتةصأۄەأآأتىۄًڽأىەأڬۄتأ=أدۏأۄتڽأۗأۏصۏزأىەأڬۄتأ=أڬۏًڽأآأؼحثۄأىەأڬۄتأ=أحوأطڬأڬشحەأۄًأتًشأودہەأىۄۏڽأۄەأۗأتثًذوۏزألشوتحەأۄۏڽأ=أځہشأؼحثۄأىەأتځىتأۄتحہأىڬتهتأتًشأڬۄتأ=أشضًهأتههۄأ﷽أىەأځتىډأدتىًشًڽأضەأوىؼأڬۏتأۄەأ=أ"
"1723","%أتْؤأتهوًوىۏىأضۏٔزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتْؤأضهوۄأشعۏأتههۄأؼىۄتأڬًأمشثتىۏأًتهۏأشتحأ““أشوۏأ‛‛أڬشىەأڬەأهۏەأثہۏدتأحًأتىۄًڽأىەألدشأضەأځۄهەأ““أشوۏأ‛‛أڬۏأۗأځہشأإځأشوۏأوڬوهأڬشىەأڬەأثؼزأًتځضأډهۏأڲةۏڽأۗأتوأتهوًوىۏىأذعشحأتْؤأضهوۄأشعۏأتههۄأؼىۄتأڬەأضتحہأشضًهأتڬشوأ﷽أڬەأىڬتذأڬتأۏۄأزًضشتأزىأحہتأۗأ"
"1724","%أذعشحأتثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أدثأحوأوۏڽأضەأڬًةۏأطرظأ+أذدأڬەأهۏەأ"
"1725","%أذعشحأذدتدأثىأؼوشًأتىظتشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدضأڬەأځتاڽأځشأډًټأهڲأڲةۏأۏتأمزشحۏأغًشأځشأًۄأهىڲڔتأۄًأڲۏتأ؏أًۄأذهتهۏأۄًأڲۏتأتًشأتضأځشأتڲهەأضتهأڬتأذدألشعأۄەأ؏أؼڬشوۄألشوتحەأۄۏڽأ=أوۏڽأىەأۏۄأثتحأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأتًشأتثىأؼثتضأشعۏأتههۄأؼىۄوتأضەأځًډہۏأ؏أحًأتىۄًڽأىەأثہۏأتضأڬۏأحظزۏمأڬۏأۗأ"
"1726","%أذعشحأدتثشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأۄدشحأضەأځۄهەأزًأذدأڬۏەأتًشأۄدشحأڬەأثؼزأتۏڬأذدأڬۏتأهۏڬىأتضأڬەأۄوشتۄأؼوشۄأثہۏأڬۏتأۗأ"
"1727","أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتأضەأشًتۏحأۄەأڬۄأذعشحأتمشؼأثىأذتثضأشعۏأتههۄأؼىۄأىەأشضًهأتههۄأ﷽أضەأځًډہتأ=أڬۏتأۄشأضتهأذدألشعأۄەأآأإځأ﷽أىەألشوتۏتأ=أىۄۏڽأۗأثهڬۄأصىزڲۏأثہشأوۏڽأظشلأتۏڬأثتشأذدألشعأۄەأتًشأتڲشأوۏڽأۄتڽأڬۄۄأزۏحتأحًأحوأتضأڬًأتزتأىۄأڬشأځتحەأۗأ"
"1728","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتأضەأشًتۏحأۄەأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتەأمًوأ$أحوأځشأذدألشعأڬۏتأڲۏتأۄەأۗأحًأذعشحأتمشؼأثىأذتثضأشعۏأتههۄأؼىۄأثًهەأ=أۏتأشضًهأتههۄأ﷽أڬۏتأۄشأضتهأ+أذدألشعأۄەأآأ"
"1729","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أذدأتًشأؼوشۄأزًىًڽأتۄهأوڬۄأڬەأضًتأحوتوأهًڲًڽأځشألشعأۄەأڬۏًىڬۄأتۄهأوڬۄأڬتأغًتلأۄۏأؼوشۄأۄەأ؏أتىأڬًأډتۄۏەأڬۄأومتوأحىؼۏوأڬۏأغشلأىڬهأدتةۏڽأځہشأًۄتڽأضەأزترهأۄًڽأ؏أڬۏًىڬۄأرزتأڬۏأمضوأ$أشضًهأتههۄأ﷽أًۄتڽأضەأظشلأذدأتًشأؼوشۄأڬشىەأڬەأهۏەأۄۏأزترهأۄًةەأۗأ"
"1730","%أذعشحأصۏزأثىأختثحأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أذدأتًشأؼوشۄأزًىًڽألشعأ+أۏؼىۏأؼثتزحأ"
"1731","أذعشحأوذوزأثىأضۏشۏىأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأصۏزأثىأختثحأشعۏأتههۄأؼىۄأضەأمثهأتصأذدأ؏أؼوشۄأڬشىەأڬەأوحؼهمأځًډہتأڲۏتأحًأتىۄًڽأىەألشوتۏتأ=أزًىًڽأىوتصۏڽأۄۏڽأڬضۏأضەأثہۏأتثحزتؤأڬشأهۏڽأڬًةۏأذشدأىۄۏڽأۄەأۗأ"
"1732","%أذعشحأتثىأؼوشأشعۏأتههۄأؼىۄوتأڬەأؽهتوأىتلؼأثۏتىأڬشحەأۄۏڽأ=أؼثزتههۄأتثىأؼوشأشعۏأتههۄأؼىۄوتألشوتۏتأڬشحەأحہەأ=أۄشأتضأطرظأځشأذدأتًشأؼوشۄألشعأۄەأ؏أدضأڬًأتههۄأحؼتهۏٳأىەأځۏزتأڬۏتأۄەأتًشأًۄأذدأڬۏأتضحغتؼحأشڬہحتأۄًأتًشأتڲشأڬًةۏأطرظأتضأڬەأثؼزأتعتلۏأذدأڬشەأحًأثۄحشأۄەأتًشأتضأڬەأهۏەأًۄأىلهۏأذدأًأؼوشۄأۄًأڲتأۗأتثىأدشۏدألشوتحەأۄۏڽأ=أودہەأتثىأؼثتضأشعۏأتههۄأؼىۄوتأىەأثحتۏتأۄەأڬۄأظتذثأتضحغتؼحأځشأدضأغشذأذدألشعأۄەأتضۏأغشذأؼوشۄأثہۏأًتدثأۄەأۗأ"
"1733","%أتْؤأتهوًوىۏىأضۏٔزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتىأڬًأتىأڬەأؼوشۄأڬەأوحؼهمألشوتۏتأ=أحۏشەأحہڬتًټأتًشأرشډأڬۏأوىتضثحأضەأحۏشەأهۏەأتدشأۄەأۗأ"
"1734","أتْوٕأتهوًوىۏىأضۏٔزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتىأڬًأتىأڬەأؼوشۄأڬەأوحؼهمأڬۄتأ=أحۏشەأؼوشەأڬتأخًتثأحۏشەأىلمۄأڬۏأومزتشأڬەأوغتثمأۄەأۗأ"
"1735","%أذعشحأضؼۏزأثىأوضۏٔثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحأؼهۏأشعۏأتههۄأؼىۄأتًشأذعشحأؼخوتىأشعۏأتههۄأؼىۄأىەأذدأڬۏتأ؏أتثہۏأًۄأتۏڬأشتضحەأوۏڽأحہەأڬۄأذعشحأؼخوتىأشعۏأتههۄأؼىۄأىەأذدأڬەأۄوشتۄأؼوشۄأڬشىەأضەأوىؼأڬۏتأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأضەأڬضۏأىەأڬۄتأ=أذعشحأؼخوتىأىەأتىأڬًأحوحؼأضەأشًڬتأۄەأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أدثأحوأتىأڬًأزۏڬہًأڬۄأۏۄأڬًډأڬشأڲةەأۄۏڽأحًأتىأڬەأثؼزأحوأڬًډأڬشىتأځہشأذعشحأؼهۏأشعۏأتههۄأؼىۄأتًشأتىأڬەأضتحہۏًڽأىەأؼوشۄأڬتأحهثۏۄأڬۄتأ؏أتًشأذعشحأؼخوتىأشعۏأتههۄأؼىۄأىەأتىأڬًأوىؼأىۄۏڽأڬۏتأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أڬۏتأودہەأۏۄأرثشأىۄۏڽأزۏأڲةۏأحہۏأڬۄأإځأىەأحوحؼأثتهؼوشۄأضەأوىؼأڬۏتأۄەأآأتىۄًڽأىەأڬۄتأ=أدۏأۄتڽأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أڬۏتأإځأىەأۏۄأىۄۏڽأضىتأڬۄأشضًهأتههۄأ﷽أىەأحوحؼأثتهؼوشۄأڬۏتأحہتأآأتىۄًڽأىەأدًتثأزۏتأ=أدۏأۄتڽأۗأ"
"1736","أذعشحأتىضأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأذدأتًشأؼوشۄأڬتأتڬټہتأحهثۏۄأڬۄتأۗأحثظشځأ=أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗأ"
"1737","%أذعشحأؼثزتههۄأثىأمحتزۄأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأثۏتىأىمهأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأذدأتًشأؼوشۄأتڬټہەأتزتأڬۏەأڬۏًىڬۄأإځأدتىحەأحہەأڬۄأتضأڬەأثؼزأإځأڬًأذدأڬتأوًمؼۄأىۄۏڽأوهەأڲتأۗأ"
"1738","%أذعشحأؼخوتىأثىأتضًزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأطرظأتثىأؼثتضأشعۏأتههۄأؼىۄوتأڬەأځتضأإۏتأۗأإځأىەأتضأضەأځًډہتأ=أحوأڬۄتڽأضەأإةەأۄًأآأتضأىەأدًتثأزۏتأ=أوۏڽأإثٓأصوأصوأځۏأڬشأإۏتأۄًڽأۗأتثىأؼثتضأشعۏأتههۄأؼىۄوتأىەأتضأضەأڬۄتأ=أڬۏتأحوأىەأتضأڬەأإزتثأڬتأهذتػأشڬہحەأۄًةەأځۏتأۄەأآأتضأىەأڬۄتأ=أتضأڬەأإزتثأڬۏتأۄۏڽأآأإځأىەألشوتۏتأ=أدثأإثٓأصوأصوأځۏىەأهڲًأحًأمثهۄأشًأۄًأدتاأ؏أثضوأتههۄأځڔہًأ؏أحۏىأضتىضًڽأوۏڽأځۏةًأتًشأضۏشأۄًأڬشأځۏةًأ؏أدثألتشؽأۄًأدتاأحًأتهذوزههٔٳۄأځڔہًأڬۏًىڬۄأشضًهأتههۄأ﷽أىەأتضأڬًأۄوتشەأتًشأوىتلمًڽأڬەأوتثۏىألشمأمشتشأزۏتأۄەأۗأڬۏًىڬۄأوىتلمۏىأصوأصوأڬتأځتىۏأضۏشأۄًأڬشأىۄۏڽأځۏحەأۄۏڽأۗأ"
"1739","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أإثٓأصوأصوأځۏىەأضەأوشتزۏڽأځًشۏأۄًحۏأۄۏڽأۗأتڲشأحوأتضأڬًأذظًهٓأطلتأڬۏأىۏحأضەأځۏةًأڲەأحًأتههۄأحؼتهۏٳأتضأڬەأسشۏؼەأحوۄۏڽأطلتأزەأڲتأتًشأتڲشأحوأتضەأذظًهأځىتۄأڬۏأىۏحأضەأځۏةًأڲەأحًأتههۄأحؼتهۏٳأتضأڬەأسشۏؼەأحوۄۏڽأځىتۄأزەأڲتأتًشأتڲشأحوأتضەأظشلأځۏتضأثدہتىەأڬەأهۏەأځۏةًأڲەأحًأۏۄأحوۄتشۏأ+أظشلأ"
"1740","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتأشًتۏحأڬشحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأځحہشأځشأضدزۄأڬۏتأۗأ"
"1741","%أذعشحأتثًؼتوشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأذدۆأتهًزتؼأڬەأوًمؼأځشأشضًهأتههۄأ﷽أڬًأتځىۏأدزؼتؤأتًىټىۏأځشأهًڲًڽأڬًأرغثۄأزۏحەأۄًةەأضىتأۄەأۗأإځأ﷽ألشوتأشۄەأحہەأ=أتەأهًڲًأ$أتځىەأشثأڬۏأتغتؼحأڬشًأ؏أىوتصأځىدڲتىۄأتزتأڬشًأ؏أتځىەأتوًتهأڬۏأصڬًۆأتزتأڬشًأتًشأوتۄٓأشوعتىأڬەأشًصەأشڬہًأتًشأتځىەأتوۏشأڬۏأتغتؼحأڬشًأحًأحوأتځىەأشثأڬۏأدىحأوۏڽأزترهأۄًأڲەأ+أضهۏوأثىأؼتوشألشوتحەأۄۏڽأ"
"1742","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أهًڲًڽأوۏڽأډۄأوۏڲًةۏتڽأصۏتزۄأۄًأڲةۏڽأڬۏًىڬۄأۄوأذدأڬشىەأڬەأهۏەأىڬهەأحہەأحمشۏثتَأحوتوأوىتضڬأذدأتزتأڬشأهۏەأحہەأتًشأتذشتوأڬہًهىەأوۏڽأتثہۏأډىزأزىأثتمۏأحہەأۗأهۏڬىأتضأڬەأثتًدًزأشضًهأتههۄأ﷽أىەأۄوۏڽأتذشتوأڬہًهىەأڬتأذڬوأزەأزۏتأ؏أ+أتۏڬأظذتثۏأىەأڬۄتأ"
"1743","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأدثأطۏغتىأڬًأڬىڬشۏتڽأوتشأهۏڽأتًشأتځىتأمشثتىۏأڬتأدتىًشأسثذأڬشأهۏتأتًشأذهمأڬشًتأهۏتأحًأتثًغهذۄأڬًأثهتأڬشأًۄأ+أوًةەأوثتشڬأ"
"1744","%أذعشحأوذوزأثىأؼثزتههۄأثىأصۏزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتىأڬەأًتهزأتًشأتۏڬأتىظتشۏأظذتثۏأشعۏأتههۄأؼىۄأمشثتىأڲتۄأوۏڽأشضًهأتههۄأ﷽أڬەأځتضأذتعشأۄًةەأۗأشضًهأتههۄأ﷽أىەأذهمأڬشًتأڬشأثتهأتۏڬأڬځڔەأوۏڽأڋتهأڬشأتىأڬًأزەأزۏەأتًشأتىۄًڽأىەأًۄأثتهأهًڲًڽأوۏڽأحمضۏوأڬشأزۏەأۗأتًشأإځأىەأتځىەأىترىأحشتطأڬشأتۏڬأظذتثۏأڬًأؼغتألشوتةەأۗأظذتثۄأشعۏأتههۄأؼىۄوألشوتحەأۄۏڽأ=أًۄأثتهأتثأثہۏأۄوتشەأځتضأڬحوأتًشأوۄىزۏأضەأشىڲەأۄًةەأوًدًزأۄۏڽأۗأ"
"1745","%أذعشحأتثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأمشثتىۏأڬەأزىأغًتلأصۏتشحأڬۏتأځہشأهًټأڬشأإةەأتًشأوىٳۏأوۏڽأػۄشأڬۏأىوتصأځڔہۏأۗأىتلؼألشوتحەأۄۏڽأ؏أتثىأؼوشأشعۏأتههۄأؼىۄوتأمشثتىۏأڬەأزىأغًتلأصۏتشحأڬۏتأڬشحەأحہەأځہشأهًټحەأتًشأػۄشأڬۏأىوتصأوىٳۏأوۏڽأتزتأڬشحەأتًشأڬۄتأڬشحەأحہەأڬۄأىثۏأتڬشوأ﷽أڬتأۏۄۏأؼوهأحہتأۗأ"
"1746","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأغًتلأصۏتشحأڬەأضتحأډڬشًڽأوۏڽأضەأڬضۏأوۏڽأثہۏأشوهأىۄۏڽأڬۏتأۗأتًشأؼغتؤألشوتحەأۄۏڽأ=أتضأوۏڽأشوهأىۄۏڽأۄەأۗأ"
"1747","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أذًعأڬەأځتضأإةەأتًشأځتىۏأځۏىتأډتۄتأحًأذعشحأؼثتضأشعۏأتههۄأؼىۄأىەأڬۄتأ=أتەألعهأ$أتځىۏأًتهزۄأڬەأځتضأدتاأتًشأتىأضەأشضًهأتههۄأ﷽أڬەأهۏەأځتىۏأهەأڬشأإاأۗأإځأ﷽أىەألشوتۏتأ=أودہەأځتىۏأځهتاأ؏أتىۄًڽأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أهًڲًڽأىەأتضأوۏڽأۄتحہأڋتهەأۄۏڽأ=أإځأ﷽أىەألشوتۏتأ=أودہەأځتىۏأځهتاأځہشأإځأ﷽أىەأتضأذًعأضەأځتىۏأځۏتأځہشأإثٓأصوأصوأځشأحطشۏلأهتةەأ؏أتضأًمحأهًڲأًۄتڽأضەأځتىۏأځۏأشۄەأحہەأتًشأتضأوۏڽأڬتوأثہۏأڬشأشۄەأحہەأ؏أإځأ﷽أىەألشوتۏتأ=أحوأڬتوأڬشحەأشۄًأڬۏًىڬۄأحوأىۏڬأڬتوأڬشأشۄەأۄًأ؏أځہشأإځأ﷽أىەألشوتۏتأ=أتڲشأحوۄتشەأوؽهًثأۄًىەأڬتأرزطۄأىۄأۄًحتأ+أتضأغشذأڬۄأۏۄتڽأځشأهًڲأڬخشحأضەأإةۏڽأتًشأؼًتوأڬۏأثہۏڔأڬۏأًدۄأضەأحوأوؽهًثأۄًأدتاأ"
"1748","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتأشًتۏحأڬشحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أذتهحأتذشتوأوۏڽأحوۄتشەأهۏەأرطڬۏأڬەأدتىًشأڬتأڲًطحأذهتهأۄەأدثأحڬأڬۄأحوأرًزأتضأڬتأطڬتشأىۄأڬشًأۏتأًۄأحوۄتشەأهۏەأطڬتشأىۄۏڽأڬۏتأدتةەأۗأ"
"1749",""" حضرت مالک بن انس رضی اللہ عنہ کی سند کے ہمراہ نبی اکرم ﷺ کا اسی جیسا فرمان منقول ہے ۔\nسلمان بن بلال کی حدیث :"" \nالمستدرك على الصحيحين حدیث: 1749 عربی حدیث: 1749"
"1750","%أذعشحأضهۏوتىأثىأثهتهأشعۏأتههۄأؼىۄأڬۏأضىزأڬەأۄوشتۄأىثۏأتڬشوأ﷽أڬتأتضۏأدۏضتألشوتىأوىمًهأۄەأۗأ"
"1751","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أهًڲأوىٳۏأضەأ+أۄۏأ"
"1752","%أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أۏۄأڬىڬشۏتڽأدًأۄوأوتشحەأۄۏڽأ+أۏۄأحًأثۄحأصۏتزۄأۄًحۏأۄۏڽأهۏڬىأدوشتحأڬەأځتضأتْحىۏأومزتشأوۏڽأڬىڬشۏتڽأوًدًزأىۄۏڽأۄًحۏڽأثهڬۄأ"
"1753","%أتْؤأتهوًوىۏىأضۏٔزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأطرظأذدأځًشتأڬشأهەأًۄأتځىەأڲہشأًتهًڽأڬەأځتضأإأدتةەأۗأڬۏًىڬۄأتضأوۏڽأتضأڬەأهۏەأثۄحأثڔتأتدشأۄەأۗأ"
"1754","أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أذعشحأدثشتةۏهأؼهۏۄأتهضهتوأتههۄأڬەأشضًهأ+أذعشحأتثشتۄۏوأ"
"1755","%أذعشحأؼغتؤأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأصًتهأضەأځۄهەأشوۏأىۄۏڽأڬشحتأۄًڽأ؏أثۏطڬأذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أمشثتىۏأڬەأزىأصًتهأضەأځۄهەأتًشأتضأڬەأثؼزأًتهەأزىًڽأوۏڽأصًتهأڬەأًمحأشوۏأڬۏتأڬشحەأحہەأۗأ"
"1756","%أتْؤأتهوًوىۏىأضۏٔزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أىەأإرشۏأزىأػۄشأڬۏأىوتصأځڔہأڬشأغًتلأصۏتشحأڬۏتأځہشأهًټأإةەأتًشأوىٳۏأوۏڽأتۏتوأحطشۏمأڬۏأحۏىأشتحۏڽأټہۄشەأ؏أدثأضًشدأڋہهحتأحًأإځأ﷽أشوۏألشوتحەأ؏أۄشأدوشۄأڬًأضتحأڬىڬشۏتڽأوتشحەأتًشأۄشأڬىڬشۏأځہۏىڬحەأًمحأحڬثۏشأڬۄحەأۗأځۄهەأتًشأزًضشەأدوشۄأڬەأځتضأټہۄشحەأ؏أًۄتڽأغًۏهأمۏتوأڬشحەأتًشأرًثأڲڔڲڔتحەأځہشأحۏضشەأدوشۄأڬۏأشوۏأڬشحەأهۏڬىأتضأڬەأځتضأڬہڔەأىۄأۄًحەأۗأ"
"1757","%أذعشحأصۄشۏأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أدثأشوۏأڬشحەأحًأتضأدوشۄأضەأإؽتصأڬشحەأدًأوىٳۏأوۏڽأوضدزأضەأوحظهأۄەأ؏أإځأتضأڬًأضتحأڬىڬشۏتڽأوتشحەأتًشأۄشأڬىڬشۏأڬًأوتشحەأۄًةەأحڬثۏشأڬۄحەأځہشأحہًڔتأإڲەأڬۏأدتىثأثڔہأڬشأمثهۄأشًأڬہڔەأۄًأدتحەأتًشأۄتحہأثهىزأڬشأڬەأزؼتأوتىڲتأڬشحەأحہەأتًشأإځأثۄحأزۏشأحڬأۏۄتڽأڬہڔەأشۄحەأځہشأإځأزًضشەأدوشۄأڬەأځتضأإحەأ؏أتضأڬًأضتحأڬىڬشۏتڽأوتشحەأ؏أۄشأڬىڬشۏأوتشحەأۄًةەأحڬثۏشأځڔہحەأۄًةەأځہشأثتةۏڽأدتىثأۄټأڬشأًتزۏأڬەأضتحہأوحظهأمثهۄأشًأۄًأڬشأۄتحہأثهىزأڬۏەأثۄحأزۏشأحڬأڬہڔەأشۄحەأځہشأتضأدوشۄأڬەأځتضأإحەأدًأؼمثۄأڬەأمشۏثأۄەأ؏أتضأڬًأضتحأڬىڬشۏتڽأوتشحەأ؏أۄشأڬىڬشۏأوتشحەأۄًةەأحڬثۏشأڬۄحەأ؏أځہشأځهټأدتحەأتًشأتضأڬەأځتضأىۄأټہۄشحەأۗأصۄشۏألشوتحەأۄۏڽأ=أوۏڽأىەأضتهوأثىأؼثزتههۄأشعۏأتههۄأؼىۄأڬًأىثۏأتڬشوأ﷽أڬەأذًتهەأضەأتضۏأدۏضۏأذزۏخأثۏتىأڬشحەأۄًةەأضىتأۄەأ؏أإځألشوتحەأۄۏڽأڬۄأتثىأؼوشأشعۏأتههۄأؼىۄوتأتضأڬۏأغشلأشرأڬشأڬەأڬہڔەأۄًحەأحہەأۗأ"
"1758","%أذعشحأتثًتهثزتذأثىأؼزۏأشعۏأتههۄأؼىۄأتځىەأًتهزأضەأشًتۏحأڬشحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأډشًتۄًڽأڬًأۏۄأشرظحأزۏأحہۏأڬۄأًۄأتۏڬأزىأشوۏأڬشۏڽأتًشأزًضشەأزىأىتؽۄأڬشأهۏڽأۗأ"
"1759","حضرت ابنِ عاصم بن عدی رضی اللہ عنہ اپنے والد کے حوالے سے بیان کرتے ہیں کہ رسول اللہ ﷺ نے اونٹوں کے نگہبانوں کو رات گزارنے کی رخصت عنایت فرمائی کہ وہ نحر والے دن رمی کریں ، پھر اگلے دن یا اس سے اگلے دن رمی کریں پھر روانگی کے دن رمی کریں ۔ \nالمستدرك على الصحيحين حدیث: 1759 عربی حدیث: 1759"
"1760","%أذعشحأتثًدذۏلۄأشعۏأتههۄأؼىۄأتځىەأًتهزأڬەأذًتهەأضەأشًتۏحأڬشحەأۄۏڽأ=أوۏڽأىەأشضًهأتههۄأ﷽أڬًأومتوٓأتثغذأ+أوڬۄأتًشأوىٳۏأڬەأزشوۏتىأتۏڬأًتزۏأ"
"1761","%أذعشحأضتهوأثىأؼثزتههۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتْؤأتهوًوىۏىأضۏٔزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتۏتأڬشحۏأحہۏڽأ=أذۏشتىڲۏأۄەأتضأوضهوتىأطرظأځشأدًأڬؼثۄأوۏڽأډہحأڬۏأدتىثأىڲتۄۏڽأتټہتةەأزترهأۄًحتأۄەأ؏أتضأڬًأډتۄۏەأڬۄأًۄأتههۄأحؼتهۏٳأڬۏأحؼػۏوأتًشأثصشڲۏأڬەأځۏطأىػشأىڲتۄٓأتًىډۏأڬشىتأډہًڔأزەأۗأشضًهأتههۄأ﷽أڬؼثۄأوۏڽأزترهأۄًةەأإځأىەأىڬهىەأحڬأومتوٓأضدزۄأضەأىڲتۄۏڽأتًځشأىۄۏڽأتټہتةۏڽأۗأ"
"1762","%أتْؤأتهوًوىۏىأضۏٔزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأوۏشەأځتضأضەأڲةەأحًأثۄحأوغوةىأتًشأځشضڬًىأڲةەأحہەأځہشأدثأإځأهًټأڬشأوۏشەأځتضأإةەأحًأثۄحأځشۏطتىأحہەأ؏أوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أ$أإځأوۏشەأځتضأضەأڲةەأحًأثۄحأۄطتطأثطتطأحہەأآأإځأ﷽أىەألشوتۏتأ=أوۏڽأڬؼثۄأوۏڽأزترهأۄًتأتًشأوۏڽأډتۄحتأحہتأڬۄأوۏڽأۏۄأؼوهأىۄأڬشًڽأحتڬۄأتضأضەأوۏشەأثؼزأوۏشۏأتوحأوطمحأوۏڽأوثحهتأىۄأۄًأدتةەأۗأ"
"1763","%أذعشحأتثىأدشۏدأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأؼغتأؤأضەأځًډہتأ=أڬۏتأإځأىەأتثىٓأؼثتضأڬتأۏۄأتشطتزأضىتأۄەأآأ““أحوۄۏڽأ+أڬؼثۆأتههۄأڬەأ"
"1764","%أتْؤأتهوًوىۏىأضۏٔزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أىەأودہأضەأڬۄتأ=أتەأؼتةطۄأ$أتڲشأحۏشۏأمًوأدتۄهۏحأڬەأصوتىەأڬەأمشۏثأحشۏىأىۄأۄًحۏأ+أۏؼىۏأتڲشأحۏشۏأمًوأىةۏأىةۏأوضهوتىأىۄأۄًةۏأۄًحۏأ"
"1765","%أذعشحأتثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأذدۆأتهًزتؼأڬەأوًمؼۄأځشأضشأوىڋتۏتأ؏أتثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أهًڲأثہۏأذدأوۏڽأضشأوىڋتأهۏتأڬشحەأحہەأ؏أځہشأشًتىڲۏأڬەأًمحأؼوشۄأڬۏتأڬشحەأحہەأ؏أؼوشۄأڬەأًمحأًۄأځًډہحەأڬۄأتثأذهمأڬۏضەأڬشًتةۏڽأ+أڬۏًىڬۄأضشأځۄهەأضەأۄۏأوىڋەأۄًةەأۄۏڽأ"
"1766","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتأضەأشًتۏحأۄەأڬۄأىثۏأتڬشوأ﷽أىەأسۏأتهذدۄأوۏڽأًتزۏأوذظثأوۏڽأټہۄشىەأڬۏأشتحأ+أوىٳۏأضەأشًتىڲۏأڬەأثؼزأوىٳۏأتًشأوڬۄأڬەأزشوۏتىأًتزۏأوذظثأوۏڽأشتحأڲصتشۏأدتحۏأۄەأ"
"1767","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأتۏڬأطۏرأىەأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًأڬشأؼشعأڬۏأ=أوۏشتأًتهزأثًڔہتأۄەأ؏أًۄأوضهوتىأۄًأڲۏتأۄەأهۏڬىأًۄأذدأىۄۏڽأڬشأضڬتأتًشأًۄأضًتشۏأځشأضًتشأىۄۏڽأۄًأضڬحتأتًشأتڲشأتضأڬًأضًتشۏأځشأثټہتأڬشأشضۏأضەأثتىزہأزًڽأحًأتضأڬەأوشأدتىەأڬتأرزطۄأۄەأحًأشضًهأتههۄأ﷽أىەألشوتۏتأ=أتځىەأًتهزأڬۏأغشلأضەأحوأذدأڬشأهًأۗأ"
"1768","%أذعشحأؼوشًأثىأتًضأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأتثًشصۏىأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أ$أوۏشتأثتځأثًڔہتأطرظأۄەأًۄأذدأۏتأؼوشۄأىۄۏڽأڬشأضڬحتأتًشأىۄأۄۏأًۄأضلشأڬشأضڬحتأۄەأۗأإځأ﷽أىەألشوتۏتأ=أتځىەأًتهزأڬۏأغشلأضەأحوأذدأڬشأهًأۗأ"
"1769","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەألشوتۏتأ=أدثأثډۄأذدأڬشەأحًأًۄأتضأڬەأهۏەأتۏڬأذدأۄەأۏۄتڽأحڬأڬۄأثتهؽأۄًأدتةەأتًشأدثأًۄأثتهؽأۄًأدتةەأحًأتضأڬەأسوۄأزًضشتأذدأهتصوأۄەأتًشأدثأتؼشتثۏأذدأڬشەأحًأًۄأتضأڬەأهۏەأتۏڬأذدأۄەأتًشأدثأًۄأۄدشحأڬشأهەأحًأتضأځشأتۏڬأتًشأذدأهتصوأۄەأۗأ"
"1770","%أذعشحأضؼۏزأثىأدثۏشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأطرظأتثىأؼثتضأشعۏأتههۄأؼىۄوتأڬەأځتضأإۏتأتًشأڬۄىەأهڲتأ=أوۏڽأتۏڬأمثۏهەأڬتأتدشحأځشأڬتوأڬشحتأۄًڽأ؏أوۏڽأىەأتىأڬًأتځىۏأڬډہأتدشحأتضأؽشعأضەأډہًڔأزۏأۄەأحتڬۄأًۄأودہەأذدأڬشىەأڬۏأتدتصحأزەأزۏڽأۗأڬۏتأوۏشەأهۏەأۏۄأدتةصأۄەأآأحًأذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأىەألشوتۏتأ=أۏۄأطرظأتىأهًڲًڽأوۏڽأضەأۄەأدىأڬەأوحؼهمأتههۄأحؼتهۏٳأىەألشوتۏتأۄەأ=أ"
"1771","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أهًڲأذدأڬەأوًضوأوۏڽأذدأضەأځۄهەأوىٳۏأ؏أؼشلۄأ؏أتًأسۏأتهودتصأثتصتشأوۏڽأرشۏزأًألشًرحأڬۏتأڬشحەأحہەأ؏أتىأڬًأذتهحأتذشتوأوۏڽأرشۏزأًألشًرحأضەأځشۏطتىۏأۄًىەأهڲۏأحًأتههۄأحؼتهۏٳأىەأۏۄأإۏحأىتصهألشوتةۏأ=أ"
"1772","%أذعشحأدثۏشأثىأوغؼوأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأشضًهأتههۄأ﷽أڬًأىصًهأمشإىأضەأځۄهەأهًڲًڽأڬەأۄوشتۄأوۏزتىأؼشلتحأوۏڽأتځىەأتًىټأځشأضًتشأڬہڔەأزۏڬہتأتًشأإځأ﷽أًۄتڽأضەأهًڲًڽأڬۏأوؼۏحأوۏڽأۄۏأشًتىۄأۄًحەأتًشأۏۄأحوتوأؼوهأوذعأتههۄأڬۏأحًلۏمأۄۏأضەأۄًحتأۄەأۗأ"
"1773","%أذعشحأدثۏشأثىأوغؼوأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أؼشلۄأڬەأزىأوۏشتأتًىټأڲوأۄًأڲۏتأ؏أوۏڽأوۏزتىأؼشلتحأوۏڽأتضأڬًأڋہًىڋحتأځہشأشۄتأحہتأڬۄأتډتىڬأوۏشۏأىػشأوذوزأ﷽أځشأځڔۏأدًأڬۄأؼشلۄأڬۏأطتوأڬًأهًڲًڽأڬەأۄوشتۄأتځىەأتًىټأځشأضًتشأڬہڔەأحہەأتًشأۏۄأ+أتضأزىأدًأًذۏأىتصهأۄًةۏأحہۏأتضأڬەأ"
"1774","%أذعشحأتثًثڬشأثىأؼثزتهشذوىأثىأذتشخأثىأۄطتوأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوشًتىأىەأتىأڬًأتْؤأوؼمهأڬۏأغشلأثہۏدتأڬۄأتىأضەأتضأذزۏخأضەأوحؼهمأزشۏتلحأڬشًڽأ؏أوۏڽأىەأتىأضەأدتأڬشأځًډہتأحًأتىۄًڽأىەأثحتۏتأ=أتىأڬەأطًۄشأىەأشتۄأرزتأوۏڽأضلشأځشأدتىەأڬەأهۏەأتًىټأحۏتشأڬۏتأدثڬۄأتىأ+أتوأوؼمهأ"
"1775","%أذعشحأذدتدأثىأؼوشًأتىظتشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەألشوتۏتأ=أدضأڬۏأۄڋۏأټًټأدتةەأۏتأځتاڽأوۏڽأصروأإأدتةەأ؏أحًأتضأڬەأهۏەأتذشتوأرحوأڬشأزۏىتأدتةصأۄەأۗأتًشأتضأځشأتۏڬأتًشأذدألشعأۄەأ+أؼڬشوۄألشوتحەأۄۏڽأ"
"1776","أتْؤأضهوۄأشعۏأتههۄأؼىۄتأڬەأؽهتوأؼثزتههۄأثىأشتلؼألشوتحەأۄۏڽأ=أوۏڽأىەأذدتدأثىأؼوشًأتىظتشۏأشعۏأتههۄأؼىۄأضەأوضهوتىأڬۏأڲشلحتشۏأ+أۏؼىۏأدضأوضهوتىأڬًأزطوىأڲشلحتشأڬشأهەأ"
"1777","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أمشۏطأڬًأذوضأڬۄتأدتحتأحہتأ+أڬۏًىڬۄأًۄأزۏىۏأوؼتوهتحأوۏڽأثۄحأطزحأځضىزأحہەأ"
