hadiths[132]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3750","«صاحب الدابة أحق بصدرها»","صحيح","Sahih al-Jami al-Saghir 3750","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3751","«صاحب الدابة أحق بصدرها، إلا من أذن»","صحيح","Sahih al-Jami al-Saghir 3751","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3752","«صاحب الصور واضع الصور على فيه منذ خلق ينتظر متى يؤمر أن ينفخ فيه فينفخ»","صحيح","Sahih al-Jami al-Saghir 3752","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3753","«صاحب العلم يستغفر له كل شيء حتى الحوت في البحر»","صحيح","Sahih al-Jami al-Saghir 3753","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3754","«صبيحة ليلة القدر تطلع الشمس لا شعاع لها كأنها طست حتى ترتفع»","صحيح","Sahih al-Jami al-Saghir 3754","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3755","«صدق ابن مسعود زوجك وولدك أحق من تصدقت به عليهم»","صحيح","Sahih al-Jami al-Saghir 3755","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3756","«صدق الله فصدقه»","صحيح","Sahih al-Jami al-Saghir 3756","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3757","«صدق الله ورسوله: {إِنَّمَا أَمْوَالُكُمْ وَأولادُكُمْ فِتْنَةٌ} نظرت إلى هذين الصبيين يمشيان ويعثران فلم أصبر حتى قطعت حديثي ورفعتهما»","صحيح","Sahih al-Jami al-Saghir 3757","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3758","«صدقت المسلم أخوالمسلم»","صحيح","Sahih al-Jami al-Saghir 3758","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3759","«صدقة السر تطفئ غضب الرب»","صحيح","Sahih al-Jami al-Saghir 3759","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3760","«صدقة السر تطفئ غضب الرب وصلة الرحم تزيد في العمر وفعل المعروف يقي مصارع السوء»","صحيح","Sahih al-Jami al-Saghir 3760","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3761","«صدقة الفطر صاع من تمر أو صاع من شعير أو مدان من حنطة عن كل صغير وكبير وحر وعبد»","صحيح","Sahih al-Jami al-Saghir 3761","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3762","«صدقة تصدق الله بها عليكم فاقبلوا صدقته»","صحيح","Sahih al-Jami al-Saghir 3762","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3763","«صدقة ذي الرحم على ذي الرحم صدقة وصلة»","حسن","Sahih al-Jami al-Saghir 3763","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3764","«صغاركم دعاميص الجنة يتلقى أحدهم أباه فيأخذ بثوبه فلا ينتهي حتى يدخله الله وأباه الجنة»","صحيح","Sahih al-Jami al-Saghir 3764","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3765","«صفوة الله من أرضه الشام وفيها صفوته من خلقه وعباده وليدخلن الجنة من أمتي ثلة لا حساب عليهم ولا عذاب»","صحيح","Sahih al-Jami al-Saghir 3765","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3766","«صلة الرحم تزيد في العمر وصدقة السر تطفئ غضب الرب»","صحيح","Sahih al-Jami al-Saghir 3766","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3767","«صلة الرحم وحسن الخلق وحسن الجوار يعمرن الديار ويزدن في الأعمار»","صحيح","Sahih al-Jami al-Saghir 3767","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3768","«صلة القرابة مثراة في المال محبة في الأهل منسأة في الأجل»","صحيح","Sahih al-Jami al-Saghir 3768","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3769","«صل من قطعك وأحسن إلى من أساء إليك وقل الحق ولو على نفسك»","صحيح","Sahih al-Jami al-Saghir 3769","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3770","«صل الصلاة لوقتها فإن أدركت الإمام يصلي بهم فصل معهم وقد أحرزت صلاتك وإلا فهي نافلة لك»","صحيح","Sahih al-Jami al-Saghir 3770","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3771","«صل الصلاة لوقتها فإن أدركت معهم فصل ولا تقل إني قد صليت فلا أصلي»","صحيح","Sahih al-Jami al-Saghir 3771","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3772","«صل بـ {الشَّمْسِ وَضُحَاهَا} ونحوها من السور»","صحيح","Sahih al-Jami al-Saghir 3772","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3773","«صل بصلاة أضعف القوم ولا تتخذ مؤذنا يأخذ على أذانه أجرا»","صحيح","Sahih al-Jami al-Saghir 3773","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3774","«صل ركعتين تجوز فيهما وإذا جاء أحدكم والإمام يخطب يوم الجمعة فليصل ركعتين وليخففهما»","صحيح","Sahih al-Jami al-Saghir 3774","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3775","صل صلاة الصبح ثم أقصر عن الصلاة حتى تطلع الشمس حتى ترتفع فإنها تطلع حين تطلع بين قرني شيطان وحينئذ يسجد لها الكفار ثم صل فإن الصلاة مشهودة محضورة حتى يستقل الظل بالرمح ثم أقصر عن الصلاة فإن حينئذ تسجر جهنم فإذا أقبل الفيء فصل فإن الصلاة مشهودة محضورة حتى تصلي العصر ثم أقصر عن الصلاة حتى تغرب الشمس فإنها تغرب بين قرني شيطان وحينئذ يسجد لها الكفار","صحيح","Sahih al-Jami al-Saghir 3775","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3776","«صل صلاة مودع كأنك تراه فإن كنت لا تراه فإنه يراك وايأس مما في أيدي الناس تعش غنيا وإياك وما يعتذر منه»","حسن","Sahih al-Jami al-Saghir 3776","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3777","«صل قائما إلا أن تخاف الغرق»","صحيح","Sahih al-Jami al-Saghir 3777","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3778","«صل قائما فإن لم تستطع فقاعدا فإن لم تستطع فعلى جنب»","صحيح","Sahih al-Jami al-Saghir 3778","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3779","«صلوا أيها الناس في بيوتكم فإن أفضل الصلاة صلاة المرء في بيته إلا المكتوبة»","صحيح","Sahih al-Jami al-Saghir 3779","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3780","«صلوا صلاة المغرب مع سقوط الشمس بادروا بها طلوع النجم»","صحيح","Sahih al-Jami al-Saghir 3780","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3781","«صلوا على النبيين إذا ذكرتموني فإنهم قد بعثوا كما بعثت»","حسن","Sahih al-Jami al-Saghir 3781","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3782","«صلوا على أنبياء الله ورسله فإن الله بعثهم كما بعثني»","حسن","Sahih al-Jami al-Saghir 3782","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3783","«صلوا علي واجتهدوا في الدعاء وقولوا: اللهم صل على محمد وعلى آل محمد وبارك على محمد وآل محمد كما باركت على إبراهيم وآل إبراهيم إنك حميد مجيد»","صحيح","Sahih al-Jami al-Saghir 3783","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3784","«صلوا في بيوتكم ولا تتخذوها قبورا»","صحيح","Sahih al-Jami al-Saghir 3784","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3785","«صلوا في بيوتكم ولا تتخذوها قبورا ولا تتخذوا بيتي عيدا وصلوا علي وسلموا فإن صلاتكم تبلغني حيثما كنتم»","صحيح","Sahih al-Jami al-Saghir 3785","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3786","«صلوا في بيوتكم ولا تتركوا النوافل فيها»","صحيح","Sahih al-Jami al-Saghir 3786","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3787","«صلوا في مرابض الغنم ولا تصلوا في أعطان الإبل»","صحيح","Sahih al-Jami al-Saghir 3787","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3788","«صلوا في مرابض الغنم ولا تصلوا في أعطان الإبل فإنها خلقت من الشياطين»","صحيح","Sahih al-Jami al-Saghir 3788","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3789","«صلوا في مراح الغنم وامسحوا رغامها فإنها من دواب الجنة»","صحيح","Sahih al-Jami al-Saghir 3789","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3790","«صلوا في نعالكم ولا تشبهوا باليهود»","صحيح","Sahih al-Jami al-Saghir 3790","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3791","«صلوا قبل المغرب ركعتين صلوا قبل المغرب ركعتين لمن شاء»","صحيح","Sahih al-Jami al-Saghir 3791","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3792","«صلي في الحجر إن أردت دخول البيت فإنما هوقطعة من البيت ولكن قومك استقصروه حين بنوا الكعبة فأخرجوه من البيت»","صحيح","Sahih al-Jami al-Saghir 3792","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3793","«صم أفضل الصيام صيام داود صوم يوم وفطر يوم»","صحيح","Sahih al-Jami al-Saghir 3793","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3794","«صم شهر الصبر رمضان صم شهر الصبر وثلاثة أيام من كل شهر..... ... »","صحيح","Sahih al-Jami al-Saghir 3794","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3795","«صنائع المعروف تقي مصارع السوء والآفات والهلكات وأهل المعروف في الدنيا هم أهل المعروف في الآخرة»","صحيح","Sahih al-Jami al-Saghir 3795","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3796","«صنائع المعروف تقي مصارع السوء والصدقة خفيا تطفئ غضب الرب وصلة الرحم زيادة في العمر وكل معروف صدقة وأهل المعروف في الدنيا هم أهل المعروف في الآخرة وأهل المنكر في الدنيا هم أهل المنكر في الآخرة,........ ... »","صحيح","Sahih al-Jami al-Saghir 3796","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3797","«صنائع المعروف تقي مصارع السوء وصدقة السر تطفئ غضب الرب وصلة الرحم تزيد في العمر»","حسن","Sahih al-Jami al-Saghir 3797","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3798","«صنفان من أمتي لن تنالهما شفاعتي: إمام ظلوم غشوم وكل غال مارق»","حسن","Sahih al-Jami al-Saghir 3798","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3799","«صنفان من أهل النار لم أرهما بعد: قوم معهم سياط كأذناب البقر يضربون بها الناس ونساء كاسيات عاريات مميلات مائلات رءوسهن كأسنمة البخت المائلة لا يدخلن الجنة ولا يجدن ريحها وإن ريحها ليوجد من مسيرة كذا وكذا»","صحيح","Sahih al-Jami al-Saghir 3799","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3800","«صوت أبي طلحة في الجيش خير من ألف رجل»","صحيح","Sahih al-Jami al-Saghir 3800","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3801","«صوتان ملعونان في الدنيا والآخرة: مزمار عند نعمة. ورنة عند مصيبة»","حسن","Sahih al-Jami al-Saghir 3801","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3802","«صوم ثلاثة أيام من كل شهر ورمضان إلى رمضان صوم الدهر وإفطاره»","صحيح","Sahih al-Jami al-Saghir 3802","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3803","«صوم شهر الصبر وثلاثة أيام من كل شهر صوم الدهر»","صحيح","Sahih al-Jami al-Saghir 3803","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3804","«صوم شهر الصبر وثلاثة أيام من كل شهر يذهبن وحر الصدر»","صحيح","Sahih al-Jami al-Saghir 3804","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3805","«صوم يوم عرفة كفارة السنة الماضية والسنة المستقبلة»","صحيح","Sahih al-Jami al-Saghir 3805","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3806","«صوم يوم عرفة يكفر سنتين ماضية ومستقبلة وصوم عاشوراء يكفر سنة ماضية»","صحيح","Sahih al-Jami al-Saghir 3806","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3807","«صومكم يوم تصومون وأضحاكم يوم تضحون»","صحيح","Sahih al-Jami al-Saghir 3807","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3808","«صوموا الشهر وسرره»","حسن","Sahih al-Jami al-Saghir 3808","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3809","«صوموا لرؤيته وأفطروا لرؤيته فإن حال بينكم وبينه سحاب فأكملوا عدة شعبان ولا تستقبلوا الشهر استقبالا ولا تصلوا رمضان بيوم من شعبان»","صحيح","Sahih al-Jami al-Saghir 3809","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3810","«صوموا لرؤيته وأفطروا لرؤيته فإن غم عليكم فأكملوا شعبان ثلاثين»","صحيح","Sahih al-Jami al-Saghir 3810","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3811","«صوموا لرؤيته وأفطروا لرؤيته وانسكوا لها فإن غم عليكم فأتموا ثلاثين فإن شهد شاهدان مسلمان فصوموا وأفطروا»","صحيح","Sahih al-Jami al-Saghir 3811","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3812","«صوموا من وضح إلى وضح»","حسن","Sahih al-Jami al-Saghir 3812","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3813","«صومي عن أختك»","صحيح","Sahih al-Jami al-Saghir 3813","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3814","«صلاة أحدكم في بيته أفضل من صلاته في مسجدي هذا إلا المكتوبة»","صحيح","Sahih al-Jami al-Saghir 3814","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3815","«صلاة الأوابين حين ترمض الفصال»","صحيح","Sahih al-Jami al-Saghir 3815","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3816","«صلاة الجالس على النصف من صلاة القائم»","صحيح","Sahih al-Jami al-Saghir 3816","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3817","«صلاة الجماعة أفضل من صلاة أحدكم وحده خمسة وعشرين جزءا»","صحيح","Sahih al-Jami al-Saghir 3817","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3818","«صلاة الجماعة تعدل خمسا وعشرين من صلاة الفذ»","صحيح","Sahih al-Jami al-Saghir 3818","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3819","«صلاة الجماعة تفضل صلاة الفذ بخمس وعشرين درجة»","صحيح","Sahih al-Jami al-Saghir 3819","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3820","«صلاة الجماعة تفضل صلاة الفذ بسبع وعشرين درجة»","صحيح","Sahih al-Jami al-Saghir 3820","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3821","«صلاة الرجل تطوعا حيث لا يراه الناس تعدل صلاته على أعين الناس خمسا وعشرين»","صحيح","Sahih al-Jami al-Saghir 3821","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3822","«صلاة الرجل في جماعة تزيد على صلاة الرجل وحده....... خمسا وعشرين درجة»","صحيح","Sahih al-Jami al-Saghir 3822","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3823","«صلاة الرجل في جماعة تزيد على صلاته في بيته وصلاته في سوقه خمسا وعشرين درجة وذلك أن أحدكم إذا توضأ فأحسن الوضوء ثم أتى المسجد لا يريد إلا الصلاة لم يخط خطوة إلا رفعه الله بها درجة وحط عنه بها خطيئة حتى يدخل المسجد فإذا دخل المسجد كان في صلاة ما كانت الصلاة تحبسه وتصلي الملائكة عليه ما دام في مجلسه الذي يصلي فيه يقولون: اللهم اغفر له اللهم ارحمه اللهم تب عليه ما لم يؤذ فيه أو يحدث فيه»","صحيح","Sahih al-Jami al-Saghir 3823","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3824","صلاة الرجل في جماعة تزيد على صلاته وحده خمسا وعشرين درجة فإذا صلاها بأرض فلاة فأتم وضوءها وركوعها وسجودها بلغت صلاته خمسين درجة","صحيح","Sahih al-Jami al-Saghir 3824","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3825","«صلاة الرجل قائما أفضل من صلاته قاعدا وصلاته قاعدا على النصف من صلاته قائما وصلاته نائما على النصف من صلاته قاعدا»","صحيح","Sahih al-Jami al-Saghir 3825","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3826","«صلاة الرجل قاعدا نصف الصلاة ولكني لست كأحد منكم»","صحيح","Sahih al-Jami al-Saghir 3826","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3827","«صلاة الضحى صلاة الأوابين»","صحيح","Sahih al-Jami al-Saghir 3827","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3828","«صلاة القاعد نصف صلاة القائم»","صحيح","Sahih al-Jami al-Saghir 3828","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3829","«صلاة الليل مثنى مثنى فإذا خشي أحدكم الصبح صلى ركعة واحدة توتر له ما قد صلى»","صحيح","Sahih al-Jami al-Saghir 3829","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3830","«صلاة الليل مثنى مثنى والوتر ركعة من آخر الليل»","صحيح","Sahih al-Jami al-Saghir 3830","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3831","«صلاة الليل والنهار مثنى مثنى»","صحيح","Sahih al-Jami al-Saghir 3831","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3833","«صلاة المرأة في بيتها أفضل من صلاتها في حجرتها وصلاتها في مخدعها أفضل من صلاتها في بيتها»","صحيح","Sahih al-Jami al-Saghir 3833","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3834","«صلاة المغرب وتر النهار»","صحيح","Sahih al-Jami al-Saghir 3834","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3835","«صلاة الوسطى صلاة العصر»","صحيح","Sahih al-Jami al-Saghir 3835","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3836","«صلاة رجلين يؤم أحدهما صاحبه أزكى عند الله من صلاة أربعة تترى وصلاة أربعة يؤمهم أحدهم أزكى عند الله من صلاة ثمانية تترى وصلاة ثمانية يؤمهم أحدهم أزكى عند الله من صلاة مائة تترى»","حسن","Sahih al-Jami al-Saghir 3836","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3837","«صلاة في إثر صلاة لا لغوبينهما كتاب في عليين»","حسن","Sahih al-Jami al-Saghir 3837","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3838","«صلاة في مسجدي أفضل من ألف صلاة فيما سواه إلا المسجد الحرام وصلاة في المسجد الحرام أفضل من مائة ألف صلاة فيما سواه»","صحيح","Sahih al-Jami al-Saghir 3838","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3839","«صلاة في مسجدي هذا أفضل من ألف صلاة فيما سواه من المساجد إلا المسجد الحرام»","صحيح","Sahih al-Jami al-Saghir 3839","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3840","«صلاة في مسجدي هذا أفضل من ألف صلاة فيما سواه من المساجد إلا المسجد الحرام فإني آخر الأنبياء وإن مسجدي آخر المساجد»","صحيح","Sahih al-Jami al-Saghir 3840","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3841","«صلاة في مسجدي هذا أفضل من ألف صلاة فيما سواه من المساجد إلا المسجد الحرام وصلاة في المسجد الحرام أفضل من صلاة في مسجدي هذا بمائة صلاة»","صحيح","Sahih al-Jami al-Saghir 3841","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3842","«صلاة مع الإمام أفضل من خمس وعشرين صلاة يصليها وحده»","صحيح","Sahih al-Jami al-Saghir 3842","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3843","«صلاتان لا يصلى بعدهما: الصبح حتى تطلع الشمس والعصر حتى تغرب الشمس»","صحيح","Sahih al-Jami al-Saghir 3843","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3844","صلاتكن في بيوتكن أفضل من صلاتكن في حجركن وصلاتكن في حجركن أفضل من صلاتكن في دوركن وصلاتكن في دوركن أفضل من صلاتكن في مسجد الجماعة","حسن","Sahih al-Jami al-Saghir 3844","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3845","«صلاح أول هذه الأمة بالزهد واليقين ويهلك آخرها بالبخل والأمل»","حسن","Sahih al-Jami al-Saghir 3845","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3846","«صياح المولود حين يقع نزغة من الشيطان»","صحيح","Sahih al-Jami al-Saghir 3846","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3847","«صيام المرء في سبيل الله يبعده من جهنم مسيرة سبعين عاما»","صحيح","Sahih al-Jami al-Saghir 3847","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3848","«صيام ثلاثة أيام من كل شهر صيام الدهر وإفطاره»","صحيح","Sahih al-Jami al-Saghir 3848","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3849","«صيام ثلاثة أيام من كل شهر صيام الدهر وهي أيام البيض: صبيحة ثلاث عشرة وأربع عشرة وخمس عشرة»","حسن","Sahih al-Jami al-Saghir 3849","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3850","«صيام حسن صيام ثلاثة أيام من الشهر»","صحيح","Sahih al-Jami al-Saghir 3850","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3851","«صيام شهر رمضان بعشرة أشهر وصيام ستة أيام بعده بشهرين فذلك صيام السنة»","صحيح","Sahih al-Jami al-Saghir 3851","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3852","«صيام يوم السبت لا لك ولا عليك»","صحيح","Sahih al-Jami al-Saghir 3852","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3853","«صيام يوم عرفة إني أحتسب على الله أن يكفر السنة التي قبله والسنة التي بعده وصيام يوم عاشوراء إني أحتسب على الله أن يكفر السنة التي قبله»","صحيح","Sahih al-Jami al-Saghir 3853","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3854","«الصائم المتطوع أمير نفسه إن شاء صام وإن شاء أفطر»","صحيح","Sahih al-Jami al-Saghir 3854","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3855","«الصابر الصابر عند الصدمة الأولى»","صحيح","Sahih al-Jami al-Saghir 3855","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3856","«الصبر عند الصدمة الأولى»","صحيح","Sahih al-Jami al-Saghir 3856","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3857","«الصبر عند أول صدمة»","صحيح","Sahih al-Jami al-Saghir 3857","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3858","«الصدقة على المسكين صدقة وهي على ذي الرحم اثنتان: صدقة وصلة»","صحيح","Sahih al-Jami al-Saghir 3858","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3859","«الصرعة كل الصرعة الذي يغضب فيشتد غضبه ويحمر وجهه ويقشعر شعره فيصرع غضبه»","حسن","Sahih al-Jami al-Saghir 3859","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3860","الصعيد الطيب وضوء المسلم وإن لم يجد الماء عشر سنين","صحيح","Sahih al-Jami al-Saghir 3860","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3861","«الصعيد وضوء المسلم وإن لم يجد الماء عشر سنين فإذا وجد الماء فليتق الله وليمسه بشرته فإن ذلك خير»","صحيح","Sahih al-Jami al-Saghir 3861","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3862","«الصلح جائز بين المسلمين إلا صلحا أحل حراما أو حرم حلالا»","صحيح","Sahih al-Jami al-Saghir 3862","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3863","«الصور قرن ينفخ فيه»","صحيح","Sahih al-Jami al-Saghir 3863","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3864","«الصورة الرأس فإذا قطع الرأس فلا صورة»","صحيح","Sahih al-Jami al-Saghir 3864","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3865","«الصوم جنة»","صحيح","Sahih al-Jami al-Saghir 3865","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3866","«الصوم جنة من عذاب الله»","صحيح","Sahih al-Jami al-Saghir 3866","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3867","«الصوم جنة يستجن بها العبد من النار»","حسن","Sahih al-Jami al-Saghir 3867","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3868","«الصوم في الشتاء الغنيمة الباردة»","حسن","Sahih al-Jami al-Saghir 3868","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3869","«الصوم يوم تصومون والفطر يوم تفطرون والأضحى يوم تضحون»","صحيح","Sahih al-Jami al-Saghir 3869","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3870","«الصلاة خير موضوع فمن استطاع أن يستكثر فليستكثر»","حسن","Sahih al-Jami al-Saghir 3870","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3871","«الصلاة في جماعة تعدل خمسا وعشرين صلاة فإذا صلاها في فلاة فأتم ركوعها وسجودها بلغت خمسين صلاة»","صحيح","Sahih al-Jami al-Saghir 3871","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3872","«الصلاة في مسجد قباء كعمرة»","صحيح","Sahih al-Jami al-Saghir 3872","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3873","«الصلاة وما ملكت أيمانكم الصلاة وما ملكت أيمانكم»","صحيح","Sahih al-Jami al-Saghir 3873","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3874","«الصلوات الخمس كفارة لما بينهن ما اجتنبت الكبائر والجمعة إلى الجمعة وزيادة ثلاثة أيام»","صحيح","Sahih al-Jami al-Saghir 3874","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3875","«الصلوات الخمس والجمعة إلى الجمعة ورمضان إلى رمضان مكفرات لما بينهن إذا اجتنبت الكبائر»","صحيح","Sahih al-Jami al-Saghir 3875","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3876","«الصيام جنة»","صحيح","Sahih al-Jami al-Saghir 3876","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3877","«الصيام جنة وإذا كان أحدكم صائما فلا يرفث ولا يجهل وإن امرؤ قاتله أو شاتمه فليقل: إني صائم مرتين والذي نفسي بيده لخلوف فم الصائم أطيب عند الله من ريح المسك يترك طعامه وشرابه وشهوته من أجلي الصيام لي وأنا أجزي به والحسنة بعشر أمثالها»","صحيح","Sahih al-Jami al-Saghir 3877","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3878","«الصيام جنة من النار فمن أصبح صائما فلا يجهل يومئذ وإن امرؤ جهل عليه فلا يشتمه ولا يسبه وليقل إني صائم والذي نفس محمد بيده لخلوف فم الصائم أطيب عند الله من ريح المسك»","صحيح","Sahih al-Jami al-Saghir 3878","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3879","«الصيام جنة من النار كجنة أحدكم من القتال»","صحيح","Sahih al-Jami al-Saghir 3879","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3880","«الصيام جنة وحصن حصين من النار»","حسن","Sahih al-Jami al-Saghir 3880","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3881","«الصيام جنة وهو حصن من حصون المؤمن وكل عمل لصاحبه إلا الصيام يقول الله: الصيام لي وأنا أجزي به»","حسن","Sahih al-Jami al-Saghir 3881","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
"3882","«الصيام والقرآن يشفعان للعبد يوم القيامة يقول الصيام: أي رب إني منعته الطعام والشهوات بالنهار فشفعني فيه يقول القرآن: رب منعته النوم بالليل فشفعني فيه فيشفعان»","صحيح","Sahih al-Jami al-Saghir 3882","","","الأحاديث المبدوءة بحرف الصاد Hadith Beginning with the Letter Sad (ص)"
