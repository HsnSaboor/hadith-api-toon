sections[1073]{id,name,name_ar,name_bn,name_en,name_fr,name_id,name_ru,name_tr,name_ur,hadith_first,hadith_last,arabic_first,arabic_last}:

"1","صحيح ابن خزيمة","","","","","","","","صحيح ابن خزيمة","1","1","1","1"

"2","بَابُ ذِكْرِ فَضَائِلِ الْوُضُوءِ يَكُونُ بَعْدَهُ صَلَاةٌ مَكْتُوبَةٌاس","بَابُ ذِكْرِ فَضَائِلِ الْوُضُوءِ يَكُونُ بَعْدَهُ صَلَاةٌ مَكْتُوبَةٌاس","","","","","","","وضو ک
"3","بَابُ ذِكْرِ فَضْلِ الْوُضُوءِ ثَلَاثًا ثَلَاثًا يَكُونُ بَعْدَهُ صَلَاةُ تَطَوُّعٍ، لَا يُحَدِّثُ الْمُصَلِّي فِيهَا نَفْسَهُاس","بَابُ ذِكْرِ فَضْلِ الْوُضُوءِ ثَلَاثًا ثَلَاثًا يَكُونُ بَعْدَهُ صَلَاةُ تَطَوُّعٍ، لَا يُحَدِّثُ الْمُصَلِّي فِيهَا نَفْسَهُاس","","","","","","","وضو کی فضیلت کا بیان جس می
"4","بَابُ ذِكْرِ حَطِّ الْخَطَايَا بِالْوُضُوءِ مِنْ غَيْرِ ذِكْرِ صَلَاةٍ تَكُونُ بَعْدَهُبغیر","بَابُ ذِكْرِ حَطِّ الْخَطَايَا بِالْوُضُوءِ مِنْ غَيْرِ ذِكْرِ صَلَاةٍ تَكُونُ بَعْدَهُبغیر","","","","","","","نماز پ
"5","بَابُ ذِكْرِ حَطِّ الْخَطَايَا، وَرَفْعِ الدَّرَجَاتِ فِي الْجَنَّةِ بِإِسْبَاغِ الْوُضُوءِ عَلَى الْمَكَارِهِ، وَإِعْطَاءِ مُنْتَظِرِ الصَّلَاةِ بَعْدَ الصَّلَاةِ أَجْرَ الْمُرَابِطِ فِي سَبِيلِ اللَّهِمشقت","بَابُ ذِكْرِ حَطِّ الْخَطَايَا، وَرَفْعِ الدَّرَجَاتِ فِي الْجَنَّةِ بِإِسْبَاغِ الْوُضُوءِ عَلَى الْمَكَارِهِ، وَإِعْطَاءِ مُنْتَظِرِ الصَّلَاةِ بَعْدَ الصَّلَاةِ أَجْرَ الْمُرَابِطِ فِي سَبِيلِ اللَّهِمشقت","","","","","","","اور تکلیف ک
"6","بَابُ ذِكْرِ عَلَامَةِ أُمَّةِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الَّذِينَ جَعَلَهُمُ اللَّهُ خَيْرَ أُمَّةٍ أُخْرِجَتْ لِلنَّاسِ بِآثَارِ الْوُضُوءِ يَوْمَ الْقِيَامَةِ، عَلَامَةً يُعْرَفُونَ بِهَا فِي ذَلِكَ الْيَوْمِ.نبی","بَابُ ذِكْرِ عَلَامَةِ أُمَّةِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الَّذِينَ جَعَلَهُمُ اللَّهُ خَيْرَ أُمَّةٍ أُخْرِجَتْ لِلنَّاسِ بِآثَارِ الْوُضُوءِ يَوْمَ الْقِيَامَةِ، عَلَامَةً يُعْرَفُونَ بِهَا فِي ذَلِكَ الْيَوْمِ.نبی","","","","","","","کریم صلی اللہ علیہ وسلم کی امت، جس
"7","بَابُ اسْتِحْبَابِ تَطْوِيلِ التَّحْجِيلِ بِغَسْلِ الْعَضُدَيْنِ فِي الْوُضُوءِ إِذِ الْحِلْيَةُ تَبْلُغُ مَوَاضِعَ الْوُضُوءِ يَوْمَ الْقِيَامَةِ بِحُكْمِ النَّبِيِّ الْمُصْطَفَى صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَوضو,"بَابُ اسْتِحْبَابِ تَطْوِيلِ التَّحْجِيلِ بِغَسْلِ الْعَضُدَيْنِ فِي الْوُضُوءِ إِذِ الْحِلْيَةُ تَبْلُغُ مَوَاضِعَ الْوُضُوءِ يَوْمَ الْقِيَامَةِ بِحُكْمِ النَّبِيِّ الْمُصْطَفَى صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَوضو,"","","","","","","(کند
"8","بَابُ نَفْيِ قَبُولِ الصَّلَاةِ بِغَيْرِ وُضُوءٍ، بِذِكْرِ خَبَرٍ مُجْمَلٍ غَيْرِ مُفَسِّرٍ.وضو","بَابُ نَفْيِ قَبُولِ الصَّلَاةِ بِغَيْرِ وُضُوءٍ، بِذِكْرِ خَبَرٍ مُجْمَلٍ غَيْرِ مُفَسِّرٍ.وضو","","","","","","","ک
"9","بَابُ ذِكْرِ الْخَبَرِ الْمُفَسِّرِ لِلَّفْظَةِ الْمُجْمَلَةِ الَّتِي ذَكَرْتُهَا,"بَابُ ذِكْرِ الْخَبَرِ الْمُفَسِّرِ لِلَّفْظَةِ الْمُجْمَلَةِ الَّتِي ذَكَرْتُهَا,"","","","","","","مجمل روایت کی مفسر روایت کا بیان","11","130","11","130"

"100","بَابُ الْأَمْرِ بِتَسْمِيَةِ اللَّهِ- عَزَّ وَجَلَّ- عِنْدَ تَخْمِيرِ الْأَوَانِي، وَالْعِلَّةُ الَّتِي مِنْ أَجْلِهَا أَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِتَخْمِيرِ,"بَابُ الْأَمْرِ بِتَسْمِيَةِ اللَّهِ- عَزَّ وَجَلَّ- عِنْدَ تَخْمِيرِ الْأَوَانِي، وَالْعِلَّةُ الَّتِي مِنْ أَجْلِهَا أَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِتَخْمِيرِ,"","","","","","","کو
"102","بَابُ بَدْءِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالسِّوَاكِ عِنْدَ دُخُولِ مَنْزِلِهِنبی","بَابُ بَدْءِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالسِّوَاكِ عِنْدَ دُخُولِ مَنْزِلِهِنبی","","","","","","","اکرم صلی اللہ علیہ وسلم کا اپن
"103","بَابُ فَضْلِ السِّوَاكِ وَتَطْهِيرِ الْفَمِ بِهِمسواک","بَابُ فَضْلِ السِّوَاكِ وَتَطْهِيرِ الْفَمِ بِهِمسواک","","","","","","","کی فضیلت اور اس س
"104","بَابُ اسْتِحْبَابِ التَّسَوُّكِ عِنْدَ الْقِيَامِ مِنَ النَّوْمِ لِلتَّهَجُّدِتہجد","بَابُ اسْتِحْبَابِ التَّسَوُّكِ عِنْدَ الْقِيَامِ مِنَ النَّوْمِ لِلتَّهَجُّدِتہجد","","","","","","","ک
"105","بَابُ فَضْلِ السِّوَاكِ وَتَضْعِيفِ فَضْلِ الصَّلَاةِ الَّتِي يُسْتَاكُ لَهَا عَلَى الصَّلَاةِ الَّتِي لَا يُسْتَاكُ لَهَا- إِنْ صَحَّ الْخَبَرُجس","بَابُ فَضْلِ السِّوَاكِ وَتَضْعِيفِ فَضْلِ الصَّلَاةِ الَّتِي يُسْتَاكُ لَهَا عَلَى الصَّلَاةِ الَّتِي لَا يُسْتَاكُ لَهَا- إِنْ صَحَّ الْخَبَرُجس","","","","","","","نماز ک
"106","بَابُ الْأَمْرِ بِالسِّوَاكِ عِنْدَ كُلِّ صَلَاةٍ أَمْرُ نَدْبٍ وَفَضِيلَةٍ لَا أَمْرُ وُجُوبٍ وَفَرِيضَةٍہر","بَابُ الْأَمْرِ بِالسِّوَاكِ عِنْدَ كُلِّ صَلَاةٍ أَمْرُ نَدْبٍ وَفَضِيلَةٍ لَا أَمْرُ وُجُوبٍ وَفَرِيضَةٍہر","","","","","","","نماز ک
"107","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ الْأَمْرَ بِالسِّوَاكِ أَمْرُ فَضِيلَةٍ لَا أَمْرُ فَرِيضَةٍاس","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ الْأَمْرَ بِالسِّوَاكِ أَمْرُ فَضِيلَةٍ لَا أَمْرُ فَرِيضَةٍاس","","","","","","","بات کی دلیل کا بیان کہ مسواک کرن
"108","بَابُ صِفَةِ اسْتِيَاكِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنبی","بَابُ صِفَةِ اسْتِيَاكِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنبی","","","","","","","اکرم صلی اللہ علیہ وسلم ک
"109","بَابُ إِيجَابِ إِحْدَاثِ النِّيَّةِ لِلْوُضُوءِ وَالْغُسْلِوضو","بَابُ إِيجَابِ إِحْدَاثِ النِّيَّةِ لِلْوُضُوءِ وَالْغُسْلِوضو","","","","","","","اور غسل ک
"110",")- بَابُ ذِكْرِ تَسْمِيَةِ اللَّهِ- عَزَّ وَجَلَّ- عِنْدَ الْوُضُوءِوضو",")- بَابُ ذِكْرِ تَسْمِيَةِ اللَّهِ- عَزَّ وَجَلَّ- عِنْدَ الْوُضُوءِوضو","","","","","","","کرت
"111","بَابُ الْأَمْرِ بِغَسْلِ الْيَدَيْنِ ثَلَاثًا، عِنْدَ الِاسْتِيقَاظِ مِنَ النَّوْمِ قَبْلَ إِدْخَالِهِمَا الْإِنَاءَ.نیند","بَابُ الْأَمْرِ بِغَسْلِ الْيَدَيْنِ ثَلَاثًا، عِنْدَ الِاسْتِيقَاظِ مِنَ النَّوْمِ قَبْلَ إِدْخَالِهِمَا الْإِنَاءَ.نیند","","","","","","","س
"112","بَابُ كَرَاهَةِ مُعَارَضَةِ خَبَرِ النَّبِيِّ- عَلَيْهِ السَّلَامُ- بِالْقِيَاسِ وَالرَّأْيِقیاس","بَابُ كَرَاهَةِ مُعَارَضَةِ خَبَرِ النَّبِيِّ- عَلَيْهِ السَّلَامُ- بِالْقِيَاسِ وَالرَّأْيِقیاس","","","","","","","اور شخصی رائ
"113","بَابُ صِفَةِ غَسْلِ الْيَدَيْنِ قَبْلَ إِدْخَالِهِمَا الْإِنَاءَ. وَصِفَةِ وُضُوءِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ,"بَابُ صِفَةِ غَسْلِ الْيَدَيْنِ قَبْلَ إِدْخَالِهِمَا الْإِنَاءَ. وَصِفَةِ وُضُوءِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ,"","","","","","","ہات
"114","بَابُ إِبَاحَةِ الْمَضْمَضَةِ وَالِاسْتِنْشَاقِ مِنْ غَرْفَةٍ وَاحِدَةٍ، وَالْوُضُوءُ مَرَّةً مَرَّةًایک,"بَابُ إِبَاحَةِ الْمَضْمَضَةِ وَالِاسْتِنْشَاقِ مِنْ غَرْفَةٍ وَاحِدَةٍ، وَالْوُضُوءُ مَرَّةً مَرَّةًایک,"","","","","","","س
"115","بَابُ الْأَمْرِ بِالِاسْتِنْشَاقِ عِنْدَ الِاسْتِيقَاظِ مِنَ النَّوْمِ، وَذِكْرُ الْعِلَّةِ الَّتِي مِنْ أَجْلِهَا أَمَرَ بِهِنیند","بَابُ الْأَمْرِ بِالِاسْتِنْشَاقِ عِنْدَ الِاسْتِيقَاظِ مِنَ النَّوْمِ، وَذِكْرُ الْعِلَّةِ الَّتِي مِنْ أَجْلِهَا أَمَرَ بِهِنیند","","","","","","","س
"116","بَابُ الْأَمْرِ بِالْمُبَالَغَةِ فِي الِاسْتِنْشَاقِ إِذَا كَانَ الْمُتَوَضِّئُ مُفْطِرًا غَيْرَ صَائِمٍوضو","بَابُ الْأَمْرِ بِالْمُبَالَغَةِ فِي الِاسْتِنْشَاقِ إِذَا كَانَ الْمُتَوَضِّئُ مُفْطِرًا غَيْرَ صَائِمٍوضو","","","","","","","کرن
