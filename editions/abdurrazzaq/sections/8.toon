hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"4236","عَنْ مَعْمَرٍ , وَالثَّوْرِيِّ , قَالَ سُلَيْمَانُ التَّيْمِيُّ : عَنْ أَبِي مِجْلَزٍ , قَالَ : قُلْتُ لابْنِ عُمَرَ : أَدْرَكْتُ رَكْعَةً مِنْ صَلاةِ الْمُقِيمِينَ وَأَنَا مُسَافِرٌ ؟ , قَالَ : \" صَلِّ بِصَلاتِهِمْ ""","","","","","Book of Prayer"
"4237","عَنْ هِشَامِ بْنِ حَسَّانَ , عَنِ الْحَسَنِ فِي مُسَافِرٍ أَدْرَكَ رَكْعَةً مِنْ صَلاةِ الْمُقِيمِينَ فِي الظُّهْرِ , قال : يَزِيدُ إِلَيْهَا ثَلاثًا , وَإِنْ أَدْرَكَهُمْ جُلُوسًا صَلَّى رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4238","عَنْ أَبِي حَنِيفَةَ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , قال : \" إِذَا دَخَلْتَ مَعَ قَوْمٍ فَصَلِّ بِصَلاتِهِمْ ""","","","","","Book of Prayer"
"4239","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , وَقَتَادَةَ في مسافر يدرك من صلاة المقيمين ركعة , قَالا : \" يُصَلِّي بِصَلاتِهِمْ , فَإِنْ أَدْرَكَهُمْ جُلُوسًا صَلَّى رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4240","عَنْ مَعْمَرٍ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , وَعَنْ عَمْرٍو , عَنِ الْحَسَنِ , قَالا : \" إِذَا أَدْرَكَهُمْ جُلُوسًا صَلَّى رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4241","عَنْ مَعْمَرٍ , وَالثَّوْرِيِّ , قَالا : \" إِذَا أَدْرَكَهُمْ جُلُوسًا صَلَّى بِصَلاتِهِمْ \" , عَنْ مَعْمَرٍ , عَنْ رَجُلٍ , عَنْ عِكْرِمَةَ , مِثْلُ قَوْلِ الزُّهْرِيِّ وَقَتَادَةَ","","","","","Book of Prayer"
"4242","عَنِ الثَّوْرِيِّ , قال : مَنْ نَسِيَ صَلاةً فِي الْحَضَرِ فَذَكَرَ فِي السَّفَرِ صَلَّى أَرْبَعًا , وَإِنْ نَسِيَ صَلاةً فِي السَّفَرِ ذَكَرَ فِي الْحَضَرِ صَلَّى رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4243","عَنْ مَعْمَرٍ , عَمَّنْ , سَمِعَ الْحَسَنَ , يَقُولُ : \" مَنْ نَسِيَ صَلاةَ الْحَضَرِ حَتَّى سَافَرَ يُصَلِّيهَا أَرْبَعًا , وَإِنْ نَسِيَ صَلاةً فِي السَّفَرِ حَتَّى يَأْتِيَ الْحَضَرَ صَلَّى أَرْبَعًا \" , وَقَالَ حَمَّادٌ : \" يُصَلِّي رَكْعَتَيْنِ \" , وَقَوْلُ الْحَسَنِ أَحَبُّ إِلَى مَعْمَرٍ : \" يُتِمُّ حَتَّى لا يَكُونَ فِي شَكٍّ ""","","","","","Book of Prayer"
"4244","عَنْ مَعْمَرٍ , عَنْ حَمَّادٍ , قال : \" إِنْ نَسِيَ صَلاةَ الْحَضَرِ فَذَكَرَ وَهُوَ مُسَافِرٌ صَلَّى أَرْبَعًا ""","","","","","Book of Prayer"
"4245","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ : \" فِي رَجُلٍ جَهِلَ فَصَلَّى الْمَغْرِبَ رَكْعَتَيْنِ رَكْعَتَيْنِ حَتَّى رَجَعَ , قَالَ : يُعِيدُ مَا ذَكَرَ ""","","","","","Book of Prayer"
"4246","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , عَنِ ابْنِ عُمَرَ , قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا أَعْجَلَ فِي السَّيْرِ جَمَعَ بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ \" , عَنِ ابْنِ عُيَيْنَةَ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , عَنِ ابْنِ عُمَرَ , مِثْلُهُ . عَنْ مَالِكٍ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلُهُ","","","","","Book of Prayer"
"4247","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ حَفْصِ بْنِ عُبَيْدِ اللَّهِ بْنِ أَنَسٍ , عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَجْمَعُ بَيْنَ الظُّهْرِ , وَالْعَصْرِ , وَالْمَغْرِبِ , وَالْعِشَاءِ فِي السَّفَرِ ""","","","","","Book of Prayer"
"4248","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ عِكْرِمَةَ , \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ جَمَعَ بَيْنَ الظُّهْرِ , وَالْعَصْرِ فِي السَّفَرِ بِنَهَارٍ ""","","","","","Book of Prayer"
"4249","عَنْ مَالِكٍ , عَنْ دَاوُدَ بْنِ الْحُصَيْنِ , عَنِ الأَعْرَجِ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : \" جَمَعَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَيْنَ الظُّهْرِ , وَالْعَصْرِ , وَالْمَغْرِبِ , وَالْعِشَاءِ فِي غَزْوَتِهِ إِلَى تَبُوكَ ""","","","","","Book of Prayer"
"4250","عَنِ الثَّوْرِيِّ , عَنْ أَبِي الزُّبَيْرِ , عَنْ أَبِي الطُّفَيْلِ , أَنَّ مُعَاذَ بْنَ جَبَلٍ , قَالَ : جَمَعَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَيْنَ الظُّهْرِ , وَالْعَصْرِ , وَالْمَغْرِبِ , وَالْعِشَاءِ فِي غَزْوَةِ تَبُوكَ ""","","","","","Book of Prayer"
"4251","عَنْ مَالِكٍ , عَنْ أَبِي الزُّبَيْرِ , عَنْ أَبِي الطُّفَيْلِ , أَنَّ مُعَاذَ بْنَ جَبَلٍ أَخْبَرَهُمْ , أَنَّهُمْ خَرَجُوا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى تَبُوكَ , قَالَ : فَكَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَجْمَعُ بَيْنَ الظُّهْرِ , وَالْعَصْرِ , وَالْمَغْرِبِ , وَالْعِشَاءِ , قَالَ : فَأَخَّرَ الصَّلاةَ يَوْمًا , ثُمَّ خَرَجَ فَصَلَّى الظُّهْرَ , وَالْعَصْرَ جَمِيعًا , ثُمَّ خَرَجَ فَصَلَّى الْمَغْرِبَ , وَالْعِشَاءَ جَمِيعًا , ثُمَّ قَالَ : \" إِنَّكُمْ سَتَأْتُونَ إِنْ شَاءُ اللَّهُ غَدًا عَيْنَ تَبُوكَ , وَإِنَّكُمْ تَأْتُونَهَا بِضُحَى النَّهَارِ , فَمَنْ جَاءَهَا فَلا يَمَسَّ مِنْ مَائِهَا شَيْئًا حَتَّى آتِيَ \" , قَالَ : فَجِئْنَاهَا وَقَدْ سَبَقَ إِلَيْهَا رَجُلانِ , وَالْعَيْنُ مِثْلُ الشِّرَاكِ تَبِضُّ بِشَيْءٍ مِنْ مَاءٍ , فَسَأَلَهُمَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" هَلْ مَسَسْتُمَا مِنْ مَائِهَا ؟ \" , قَالا : نَعَمْ , قَالَ : فَسَبَّهُمَا , وَقَالَ لَهُمَا : مَا شَاءَ اللَّهُ أَنْ يَقُولَ , ثُمَّ غَرَفُوا مِنَ الْعَيْنِ بِأَيْدِيهِمْ قَلِيلا حَتَّى اجْتَمَعَ فِي إِنَاءٍ , ثُمَّ غَسَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيهِ وَجْهَهُ وَيَدَيْهِ , ثُمَّ أَعَادَهُ فِيهَا , فَجَرَتِ الْعَيْنُ بِمَاءٍ كَثِيرٍ , فَاسْتَقَى النَّاسُ , ثُمَّ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" يُوشِكُ يَا مُعَاذُ, إِنْ طَالَتْ بِكَ حَيَاتُكَ , أَنْ تَرَى هَا هُنَا قَدْ مُلِئَ جِنَانًا ""","","","","","Book of Prayer"
"4252","عَنْ عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ , عَنْ نَافِعٍ , قَالَ : أَخْبَرَنِي ابْنُ عُمَرَ , أَنَّ صَفِيَّةَ بِنْتَ أَبِي عُبَيْدٍ امْرَأَتَهُ تَمُوتُ , قَالَ : سَارَ حَتَّى أَظْلَمْنَا وَظَنَنَّا , أَنَّهُ قَدْ نَسِيَ , قَالَ : فَجَعَلْنَا نَقُولُ : الصَّلاةَ , وَهُوَ لا يُجِيبُنَا , حَتَّى ذَهَبَ نَحْوٌ مِنْ رُبْعِ اللَّيْلِ , قَدْرَ مَا يَسِيرُ الْمُثْقَلُونَ مِنْ عَرَفَةَ إِلَى مُزْدَلِفَةَ , ثُمَّ نَزَلَ فَصَلَّى الْمَغْرِبَ , ثُمَّ أَقْبَلَ عَلَيْنَا , فَقَالَ : \" إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا عَجَّلَهُ الْمَسِيرُ , أَوْ أَزْمَعَ بِهِ الْمَسِيرُ جَمَعَ بَيْنَ هَاتَيْنِ الصَّلاتَيْنِ , ثُمَّ صَلَّى الْعِشَاءَ ""","","","","","Book of Prayer"
"4253","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ , قَالَ : جَمَعَ ابْنُ عُمَرَ بَيْنَ الصَّلاتَيْنِ مَرَّةً وَاحِدَةً , قَالَ : جَاءَهُ خَبَرٌ عَنْ صَفِيَّةَ بِنْتِ أَبِي عُبَيْدٍ أَنَّهَا وَجِعَةٌ , فَارْتَحَلَ بَعْدَ أَنْ صَلَّى الْعَصْرَ , ثُمَّ أَسْرَعَ السَّيْرَ , فَسَارَ حَتَّى حَانَتْ صَلاةُ الْمَغْرِبِ , فَكَلَّمَهُ رَجُلٌ مِنْ أَصْحَابِهِ , فَقَالَ : الصَّلاةَ , فَلَمْ يَرْجِعْ إِلَيْهِ , ثُمَّ كَلَّمَهُ آخَرُ فَلَمْ يَرْجِعْ إِلَيْهِ , وَكَلَّمَهُ آخَرُ فَلَمْ يَرْجِعْ إِلَيْهِ شَيْئًا , ثُمَّ كَلَّمَهُ آخَرُ , فَقال : إِنِّي رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا اسْتَعْجَلَ أَخَّرَ هَذِهِ الصَّلاةَ حَتَّى يَجْمَعَ بَيْنَ الصَّلاتَيْنِ ""","","","","","Book of Prayer"
"4254","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , وَمُوسَى بْنِ عُقْبَةَ , عَنْ نَافِعٍ , قَالَ : أُخْبِرَ ابْنُ عُمَرَ بِوَجَعِ امْرَأَتَهِ وَهُوَ فِي سَفَرٍ , فَأَخَّرَ الْمَغْرِبَ , فَقِيلَ لَهُ : الصَّلاةَ , فَسَكَتَ وَأَخَّرَهَا بَعْدَ ذَهَابِ الشَّفَقِ حَتَّى ذَهَبَ هَوِيٌّ مِنَ اللَّيْلِ , ثُمَّ نَزَلَ فَصَلَّى الْمَغْرِبَ , وَالْعِشَاءَ , ثُمَّ قَالَ : هَكَذَا كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُ إِذَا أَجَدَّ بِهِ السَّيْرُ , أَوْ أَجَدَّ بِهِ الْمَسِيرُ ""","","","","","Book of Prayer"
"4255","عَنْ مَعْمَرٍ , عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ , عَنْ نَافِعٍ , أَنَّ ابْنَ عُمَرَ كَانَ يُصَلِّي فِي السَّفَرِ كُلَّ صَلاةٍ لِوَقْتِهَا إِلا صَلاةً أُخْبِرَ بِوَجَعِ امْرَأَتِهِ , فَإِنَّهُ جَمَعَ بَيْنَ الْمَغْرِبِ , وَالْعِشَاءِ , فَقِيلَ لَهُ , فَقَالَ : \" هَكَذَا كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُ , إِذَا جَدَّ بِهِ الْمَسِيرُ جَمَعَ بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ \" , فَكَانَ فِي بَعْضِ حَدِيثِهِمْ إِلَى الرُّبُعِ مِنَ اللَّيْلِ أَخَّرَهُمَا جَمِيعًا","","","","","Book of Prayer"
"4256","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ , عَنْ عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ , عَنْ عَطَاءٍ , وَمُجَاهِدٍ , عَنِ ابْنِ عَبَّاسٍ , \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَجْمَعُ بَيْنَ الصَّلاتَيْنِ فِي السَّفَرِ , الظُّهْرِ , وَالْعَصْرِ , وَالْمَغْرِبِ , وَالْعِشَاءِ , وَلَيْسَ يَطْلُبُ عَدُوًّا وَلا يَطْلُبُهُ عَدُوٌّ ""","","","","","Book of Prayer"
"4257","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي حُسَيْنُ بْنُ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ , عَنْ عِكْرِمَةَ , وَعَنْ كُرَيْبٍ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : أَلا أُخْبِرُكُمْ عَنْ صَلاةِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي السَّفَرِ ؟ , قُلْنَا : بَلَى , قَالَ : \" كَانَ إِذَا زَاغَتْ لَهُ الشَّمْسُ فِي مَنْزِلِهِ جَمَعَ بَيْنَ الظُّهْرِ , وَالْعَصْرِ قَبْلَ أَنْ يَرْكَبَ , وَإِذَا لَمْ تَزُغْ لَهُ فِي مَنْزِلِهِ سَارَ حَتَّى إِذَا حَانَتِ الْعَصْرُ نَزَلَ فَجَمَعَ بَيْنَ الظُّهْرِ , وَالْعَصْرِ , وَإِذَا حَانَتْ لَهُ الْمَغْرِبُ وَهُوَ فِي مَنْزِلِهِ جَمَعَ بَيْنَهَا وَبَيْنَ الْعِشَاءِ , وَإِذَا لَمْ تَحِنْ لَهُ فِي مَنْزِلِهِ رَكِبَ حَتَّى إِذَا حَانَتِ الْعِشَاءُ نَزَلَ فَجَمَعَ بَيْنَهُمَا \" قَالَ : وَقَالَ لِيَ الْمِقْدَامُ : \" مَا سَمِعْنَا هَذَا مِنِ ابْنِ جُرَيْجٍ , وَلا جَاءَ بِهِ غَيْرُكَ ""","","","","","Book of Prayer"
"4258","عَنْ مَعْمَرٍ , عَنْ عَاصِمِ بْنِ سُلَيْمَانَ , عَنْ أَبِي عُثْمَانَ النَّهْدِيِّ , قَالَ : \" اصْطَحَبْتُ أَنَا وَسَعْدُ بْنُ أَبِي وَقَّاصٍ مِنَ الْكُوفَةِ إِلَى مَكَّةَ , وَخَرَجْنَا مُوَافِدَيْنِ , فَجَعَلَ سَعْدٌ يَجْمَعُ بَيْنَ الظُّهْرِ , وَالْعَصْرِ , وَالْمَغْرِبِ , وَالْعِشَاءِ , يُقَدِّمُ مِنْ هَذِهِ قَلِيلا , وَيُؤَخِّرُ مِنْ هَذِهِ قَلِيلا حَتَّى جِئْنَا مَكَّةَ ""","","","","","Book of Prayer"
"4259","عَنِ الثَّوْرِيِّ , عَنْ سُلَيْمَانَ التَّيْمِيِّ , عَنْ أَبِي عُثْمَانَ , قَالَ : \" خَرَجَ سَعِيدُ بْنُ زَيْدٍ , وَأُسَامَةُ فَكَانَا يَجْمَعَانِ الظُّهْرَ , وَالْعَصْرَ , وَالْمَغْرِبَ , وَالْعِشَاءَ ""","","","","","Book of Prayer"
"4260","عَنْ مَعْمَرٍ , عَنْ طَاوُسٍ , عَنْ أَبِيهِ , أَنَّ ابْنَ عَبَّاسٍ , قَالَ : كُنَّا نَجْمَعُ بَيْنَ الظُّهْرِ وَالْعَصْرِ فِي السَّفَرِ ""","","","","","Book of Prayer"
"4261","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ , \" أَنَّ ابْنَ عَبَّاسٍ جَمَعَ بَيْنَ الْمَغْرِبِ , وَالْعِشَاءِ لَيْلَةَ خَرَجَ مِنْ أَرْضِهِ \" , قَالَ : \" فَكَانَ مَنْ جَمَعَ بَيْنَهُمَا يُؤَخِّرُ مِنَ الظُّهْرِ وَيُعَجِّلُ مِنَ الْعَصْرِ ثُمَّ يُجْمَعَانِ , وَيُؤَخِّرُ مِنَ الْمَغْرِبِ وَيُعَجِّلُ مِنَ الْعِشَاءِ ثُمَّ يُجْمَعَانِ ""","","","","","Book of Prayer"
"4262","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" أَرَأَيْتَ إِنْ صَلاهُمَا الْمَرْءُ عِنْدَ وَقْتِ إِحْدَاهُمَا , قَالَ : لا يَضُرُّهُ ""","","","","","Book of Prayer"
"4263","عَنِ ابْنِ جُرَيْجٍ , وَزَمْعَةَ بْنِ صَالِحٍ , عَنِ ابْنِ طَاوُسٍ , قال : كَانَ طَاوُسٌ يَجْمَعُ بَيْنَ الصَّلاتَيْنِ مِنَ الْجَنَدِ حَتَّى يَصِلَ مَكَّةَ , وَيُصَلِّي بَيْنَهُمَا وَمَعَهُمَا مَا كَانَ يُصَلِّي فِي الْحَضَرِ ""","","","","","Book of Prayer"
"4264","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ أَبِي قِلابَةَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" إِذَا كَانَ الْقَوْمُ فِي السَّفَرِ فَلَمْ يَتَهَيَّأْ لَهُمُ الْمَنْزِلُ سَارُوا حَتَّى بَلَغُوا الْمَنْزِلَ وَأَخَّرُوا شَيْئًا , ثُمَّ نَزَلُوا فَجَمَعُوا بَيْنَ الصَّلاتَيْنِ , وَإِذَا أَبْطَئُوا فِي الْمَنْزِلِ فَكَذَلِكَ ""","","","","","Book of Prayer"
"4265","عَنْ مَعْمَرٍ , عَنْ عَمْرِو بْنِ قَتَادَةَ , قَالَ : كُنْتُ أَجِيرًا لِسَالِمِ بْنِ عَبْدِ اللَّهِ , قَالَ : \" فَيَرْتَحِلُ مِنَ الْمَدِينَةِ إِلَى مَكَّةَ , فَكَانَ سَالِمٌ يَأْمُرُ نِسَاءَهُ يَجْمَعْنَ بَيْنَ الظُّهْرِ وَالْعَصْرِ , ثُمَّ أَسِيرُ بِهِمْ , وَيَتَخَلَّفُ هُوَ فِي الْمَنْزِلِ , فَلا أَدْرِي مَا يَصْنَعُ ""","","","","","Book of Prayer"
"4266","عَنْ مَالِكٍ , عَنِ ابْنِ شِهَابٍ , قَالَ : سَأَلْتُ سَالِمَ بْنَ عَبْدِ اللَّهِ : هَلْ يُجْمَعُ بَيْنَ الظُّهْرِ , وَالْعَصْرِ فِي السَّفَرِ ؟ , فَقَالَ : \" لا بَأْسَ بِذَلِكَ , أَلَمْ تَرَ إِلَى صَلاةِ النَّاسِ بِعَرَفَةَ ""","","","","","Book of Prayer"
"4267","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , قَالَ : جَاءَتِ امْرَأَةٌ إِلَى طَاوُسٍ , فَقَالَتْ : إِنِّي أَكْرَهُ أَبِي , حَمَلَنِي عَلَى أَنْ أَجْمَعَ بَيْنَ الصَّلاتَيْنِ , قَالَ : \" لا يَضُرُّكِ , أَمَا تَرَيْنَ أَنَّ النَّاسَ يَجْمَعُونَ بَيْنَ الْهَاجِرَةِ وَالْعَصْرِ بِعَرَفَةَ , وَالْمَغْرِبِ , وَالْعِشَاءِ بِجَمْعٍ ""","","","","","Book of Prayer"
"4268","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ مُحَمَّدِ بْنِ الْمُنْكَدِرِ , عَنْ أُمِّ ذَرَّةَ , عَنْ عَائِشَةَ , \" أَنَّهَا كَانَتْ تَأْمُرُ النِّسَاءَ بِالْجَمْعِ بَيْنَ الصَّلاتَيْنِ فِي السَّفَرِ ""","","","","","Book of Prayer"
"4269","عَنْ مَعْمَرٍ , قال : سَمِعْتُ أَنَّ الصَّلاةَ جُمِعَتْ لِقَوْلِهِ :  أَقِمِ الصَّلاةَ لِدُلُوكِ الشَّمْسِ إِلَى غَسَقِ اللَّيْلِ , فَغَسَقُ اللَّيْلِ الْمَغْرِبُ , وَالْعِشَاءُ ""","","","","","Book of Prayer"
"4270","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : قَوْمٌ لَيْسُوا فِي حَجٍّ , وَلا عُمْرَةٍ , وَلا غَزْوَةٍ يَجْمَعُونَ بَيْنَ الصَّلاتَيْنِ ؟ , قَالَ : \" نَعَمْ , سُبْحَانَ اللَّهِ ! أَنَا أَطُوفُ هَا هُنَا السَّبْعَ , ثُمَّ أُصَلِّي الْعِشَاءَ أَوِ السَّبْعِينَ ""","","","","","Book of Prayer"
"4271","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , قال : \" كَانَ أَبِي يَنْزِلُ يُرَاقِبُ الشَّمْسَ حَتَّى يَحْضُرَ الْعَصْرُ ""","","","","","Book of Prayer"
"4272","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ عُمَارَةَ بْنِ عُمَيْرٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ , عَنِ ابْنِ مَسْعُودٍ , قَالَ : \" مَا رَأَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى صَلاةً قَطُّ إِلا لِوَقْتِهَا , إِلا أَنَّهُ جَمَعَ بَيْنَ الظُّهْرِ , وَالْعَصْرِ بِعَرَفَةَ , وَالْمَغْرِبِ , وَالْعِشَاءِ بِجَمْعٍ \" , عَنِ ابْنِ عُيَيْنَةَ , عَنِ الأَعْمَشِ , عَنْ عِمَارَةَ بْنِ عُمَيْرٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ , عَنِ ابْنِ مَسْعُودٍ مِثْلُهُ , قَالَ : \" وَصَلَّى الْفَجْرَ يَوْمَئِذٍ قَبْلَ وَقْتِهَا ""","","","","","Book of Prayer"
"4273","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ قَتَادَةَ , عَنْ أَبِي الْعَالِيَةِ , \" أَنَّ عُمَرَ كَتَبَ إِلَى أَبِي مُوسَى , وَاعْلَمْ أَنَّ جَمْعًا بَيْنَ الصَّلاتَيْنِ مِنَ الْكَبَائِرِ إِلا مِنْ عُذْرٍ ""","","","","","Book of Prayer"
"4274","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ أَيُّوبٍ ، وَقَتَادَةَ , عَنْ أَبِي الْعَالِيَةِ , \" أَنَّهُ كَانَ يُصَلِّي فِي السَّفَرِ كُلَّ صَلاةٍ لِوَقْتِهَا ""","","","","","Book of Prayer"
"4275","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , عَنِ الأَسْوَدِ , قال : \" كَانَ يَنْزِلُ لِوَقْتِ كُلِّ صَلاةٍ , وَلَوْ كَانَ يَنْزِلُ عَلَى حُجْرٍ ""","","","","","Book of Prayer"
"4276","عَنْ مَعْمَرٍ , عَنْ جَابِرٍ الْجُعْفِيِّ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ , عَنْ أَبِيهِ , \" أَنَّهُ كَانَ يُصَلِّي كُلَّ صَلاةٍ لِوَقْتِهَا فِي السَّفَرِ ""","","","","","Book of Prayer"
"4277","عَنْ هِشَامٍ , عَنِ الْحَسَنِ , أَنَّهُ كَانَ يَقُولُ : \" صَلُّوا كُلَّ صَلاةٍ لِوَقْتِهَا \" , عَنْ مَعْمَرٍ , عَمَّنْ , سَمِعَ الْحَسَنَ , يَقُولُ مِثْلَ ذَلِكَ","","","","","Book of Prayer"
"4278","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ , عَنْ مَكْحُولٍ : \" أَنَّهُ كَرِهَ الْجَمْعَ بَيْنَ الصَّلاتَيْنِ فِي السَّفَرِ ""","","","","","Book of Prayer"
"4279","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ \" لا يَجْمَعُونَ فِي السَّفَرِ , وَلا يُصَلُّونَ إِلا رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4280","عَنْ هَمَّامٍ , عَنْ هَارُونَ بْنِ قَيْسٍ , عَنْ سَالِمِ بْنِ عَبْدِ اللَّهِ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" رَحِمَ اللَّهُ عَبْدَ اللَّهِ بْنَ رَوَاحَةَ كَانَ يَنْزِلُ فِي السَّفَرِ عِنْدَ وَقْتِ كُلِّ صَلاةٍ ""","","","","","Book of Prayer"
"4281","عَنِ الثَّوْرِيِّ , عَنْ يَحْيَى بْنِ سَعِيدٍ , عَنْ سَالِمٍ , قَالَ : قُلْتُ : مَا أَبْعَدُ مَا أَخَّرَ ابْنُ عُمَرَ الْمَغْرِبَ ؟ , قَالَ : \" مِنْ ذَاتِ الْجَيْشِ إِلَى ذَاتِ السُّفُوقِ , وَبَيْنَهُمَا ثَمَانِيَةُ أَمْيَالٍ ""","","","","","Book of Prayer"
"4282","عَنْ إِبْرَاهِيمَ بْنِ يَزِيدَ , عَنْ أَبِي الزُّبَيْرِ , عَنْ جَابِرٍ , \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ غَرَبَتْ لَهُ الشَّمْسُ وَهُوَ بِسَرِفٍ , فَلَمْ يُصَلِّ الْمَغْرِبَ حَتَّى دَخَلَ مَكَّةَ \" , وَذَكَرَهُ الْحَجَّاجُ بْنُ أَرْطَأَةَ مِثْلَهُ , عَنْ أَبِي الزُّبَيْرِ","","","","","Book of Prayer"
"4283","عَنْ يَحْيَى بْنِ عَبْدِ اللَّهِ ، وَغَيْرِهِ , أَنَّ وَهْبَ بْنَ مُنَبِّهٍ كَانَتْ تَغْرُبُ لَهُ الشَّمْسُ وَهُوَ بِقَرْيَةِ الرَّحَبَةِ , فَيَرْكَبُ دَابَّتَهُ حَتَّى يَأْتِيَ مَنْزِلَهُ بِصَنْعَاءَ","","","","","Book of Prayer"
"4284","عَنْ دَاوُدَ بْنِ قَيْسٍ , عَنْ صَالِحٍ مَوْلَى التَّوْأَمَةِ , أَنَّهُ سَمِعَ ابْنَ عَبَّاسٍ , يَقُولُ : \" جَمَعَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَيْنَ الظُّهْرِ , وَالْعَصْرِ , وَالْمَغْرِبِ , وَالْعِشَاءِ بِالْمَدِينَةِ فِي غَيْرِ سَفَرٍ وَلا مَطَرٍ \" , قَالَ : قُلْتُ لابْنِ عَبَّاسٍ : لِمَ تَرَاهُ فَعَلَ ذَلِكَ ؟ , قَالَ : \" أَرَاهُ لِلتَّوْسِعَةِ عَلَى أُمَّتِهِ ""","","","","","Book of Prayer"
"4285","عَنِ الثَّوْرِيِّ , عَنْ أَبِي الزُّبَيْرِ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" جَمَعَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَيْنَ الظُّهْرِ , وَالْعَصْرِ بِالْمَدِينَةِ فِي غَيْرِ سَفَرٍ وَلا خَوْفٍ \" , قَالَ : قُلْتُ لابْنِ عَبَّاسٍ : وَلِمَ تَرَاهُ فَعَلَ ذَلِكَ ؟ , قَالَ : \" أَرَادَ أَنْ لا يُحْرِجَ أَحَدًا مِنْ أُمَّتِهِ ""","","","","","Book of Prayer"
"4286","قَالَ : أَخْبَرَنَا ابْنُ جُرَيْجٍ , وَمَعْمَرٌ , عَنْ عَمْرِو بْنِ دِينَارٍ , أَنَّ أَبَا الشَّعْثَاءِ أَخْبَرَهُ , أَنَّ ابْنَ عَبَّاسٍ أَخْبَرَهُ , قَالَ : صَلَّيْتُ وَرَاءَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثَمَانِيًا جَمِيعًا , وَسَبْعًا جَمِيعًا بِالْمَدِينَةِ \" , قَالَ ابْنُ جُرَيْجٍ : فَقُلْتُ لأَبِي الشَّعْثَاءِ : \" إِنِّي لأَظُنُّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَخَّرَ مِنَ الظُّهْرِ قَلِيلا وَقَدَّمَ مِنَ الْعَصْرِ قَلِيلا , قَالَ أَبُو الشَّعْثَاءِ : وَأَنَا أَظُنُّ ذَلِكَ ""","","","","","Book of Prayer"
"4287","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَالَ عَبْدُ اللَّهِ : جَمَعَ لَنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مُقِيمًا غَيْرَ مُسَافِرٍ بَيْنَ الظُّهْرِ وَالْعَصْرِ وَالْمَغْرِبِ , فَقَالَ رَجُلٌ لابْنِ عُمَرَ : لِمَ تَرَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَعَلَ ذَلِكَ ؟ , قَالَ : لأَنْ لا يُحْرِجَ أُمَّتَهُ إِنْ جَمَعَ رَجُلٌ","","","","","Book of Prayer"
"4288","عَنْ مَالِكٍ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , قَالَ : \" كَانَ الأُمَرَاءُ إِذَا جَمَعُوا بَيْنَ الصَّلاتَيْنِ , الْمَغْرِبِ , وَالْعِشَاءِ فِي الْمَطَرِ جَمَعَ مَعَهُمْ ""","","","","","Book of Prayer"
"4289","عَنْ دَاوُدَ بْنِ قَيْسٍ , قَالَ : سَمِعْتُ رَجَاءَ بْنَ حَيْوَةَ يَسْأَلُ نَافِعًا : \" أَكَانَ ابْنُ عُمَرَ يَجْمَعُ مَعَ النَّاسِ بَيْنَ الصَّلاتَيْنِ إِذَا جَمَعُوا فِي اللَّيْلَةِ الْمَطِيرَةِ ؟ , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"4290","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ صَفْوَانَ بْنِ سُلَيْمٍ , قَالَ : \" جَمَعَ عُمَرُ بْنُ الْخَطَّابِ بَيْنَ الظُّهْرِ , وَالْعَصْرِ فِي يَوْمٍ مَطِيرٍ ""","","","","","Book of Prayer"
"4291","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , \" أَنَّ أَهْلَ الْمَدِينَةِ كَانُوا يَجْمَعُونَ بَيْنَ الْمَغْرِبِ , وَالْعِشَاءِ فِي اللَّيْلَةِ الْمَطِيرَةِ , فَيُصَلِّي مَعَهُمُ ابْنُ عُمَرَ لا يَعِيبُ ذَلِكَ عَلَيْهِمْ ""","","","","","Book of Prayer"
"4292","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ لَوْ جَمَعْتُ بَيْنَ الصَّلاتَيْنِ فِي السَّفَرِ أَيَجْزِي أَنْ لا أَتَكَلَّمَ بَيْنَهُمَا ؟ قَالَ : \" أَمَّا أَنَا فَأُحِبُّ أَنْ أَفْصِلَ بَيْنَهُمَا ""","","","","","Book of Prayer"
"4293","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , قَالَ : حَدَّثَنِي عِيسَى بْنُ عَاصِمٍ , عَنْ أَبِيهِ , قَالَ : صَلَّى ابْنُ عُمَرَ صَلاةً مِنْ صَلاةِ النَّهَارِ فِي السَّفَرِ , فَرَأَى بَعْضَهُمْ يُسَبِّحُ , فَقَالَ ابْنُ عُمَرَ : مَا يَصْنَعُونَ ؟ , قِيلَ لَهُ : يُسَبِّحُونَ , قَالَ : لَوْ كُنْتُ مُسَبِّحًا لأَتْمَمْتُ الصَّلاةَ , حَجَجْتُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَكَانَ لا يُسَبِّحُ بِالنَّهَارِ , وَحَجَجْتُ مَعَ أَبِي بَكْرٍ فَكَانَ لا يُسَبِّحُ بِالنَّهَارِ , وَحَجَجْتُ مَعَ عُمَرَ , فَكَانَ لا يُسَبِّحُ بِالنَّهَارِ , وَحَجَجْتُ مَعَ عُثْمَانَ فَكَانَ لا يُسَبِّحُ بِالنَّهَارِ , ثُمَّ قَالَ ابْنُ عُمَرَ :  لَقَدْ كَانَ لَكُمْ فِي رَسُولِ اللَّهِ أُسْوَةٌ حَسَنَةٌ ","","","","","Book of Prayer"
"4294","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ , عَنْ ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ , \" أَنَّ عَلِيًّا كَانَ لا يَتَطَوَّعُ فِي السَّفَرِ قَبْلَهَا وَلا بَعْدَهَا ""","","","","","Book of Prayer"
"4295","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ : \" أَنَّهُ كَانَ لا يَتَطَوَّعُ فِي السَّفَرِ , وَكَانَ يَقُولُ : لَوْ تَطَوَّعْتُ لأَتْمَمْتُ , وَكَانَ يُصَلِّي فِي السَّفَرِ سُبْحَةَ اللَّيْلِ ""","","","","","Book of Prayer"
"4296","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ , قَالَ : \" كَانَ ابْنُ عُمَرَ يَتَطَوَّعُ بِاللَّيْلِ , وَلا يَتَطَوَّعُ بِالنَّهَارِ فِي السَّفَرِ , وَكَانَ يُصَلِّي إِلَى بَعِيرِهِ ""","","","","","Book of Prayer"
"4297","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , وَأَيُّوبَ , عَنْ نَافِعٍ , \" أَنَّ ابْنَ عُمَرَ كَانَ لا يَتَطَوَّعُ فِي السَّفَرِ فِي صَلاةِ النَّهَارِ ""","","","","","Book of Prayer"
"4298","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , قَالَ : كَانَ ابْنُ عُمَرَ لا يَرْكَعُ رَكْعَتَيِ الْفَجْرِ فِي السَّفَرِ , وَلا يَتْرُكُهُمَا فِي الْحَضَرِ ""","","","","","Book of Prayer"
"4299","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ عِكْرِمَةَ بْنِ خَالِدٍ , عَنْ عَبْدِ اللَّهِ بْنِ وَاقِدٍ , قَالَ : \" كَانَ ابْنُ عُمَرَ لا يُصَلِّي رَكْعَتَيِ الْفَجْرِ فِي السَّفَرِ , وَلا يَدَعُهُمَا فِي الْحَضَرِ ""","","","","","Book of Prayer"
"4300","عَنْ إِسْرَائِيلَ , عَنْ ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ , قَالَ : \" صَحِبْتُ مُجَاهِدًا فِي السَّفَرِ مِرَارًا , فَكَانَ لا يَتَطَوَّعُ قَبْلَهَا وَلا بَعْدَهَا ""","","","","","Book of Prayer"
"4301","عَنْ مَعْمَرٍ , قال : \" سَافَرْتُ مَعَ أَيُّوبَ فَكَانَ لا يَتَطَوَّعُ فِي الظُّهْرِ , وَالْعَصْرِ بِشَيْءٍ لا يَزِيدُ عَلَى رَكْعَتَيْنِ رَكْعَتَيْنِ , غَيْرَ أَنَّهُ كَانَ يُصَلِّي قَبْلَ الْفَجْرِ رَكْعَتَيْنِ , وَبَعْدَ الْمَغْرِبِ رَكْعَتَيْنِ , وَكَانَ يُصَلِّي رَكَعَاتٍ بَعْدَ الْعِشَاءِ , وَكَانَ يُوتِرُ قَبْلَ أَنْ يَنَامَ ""","","","","","Book of Prayer"
"4302","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قُلْتُ : إِذَا سَافَرْتُ فَقَصَرْتُ الصَّلاةَ أُصَلِّي قَبْلَهَا إِنْ شِئْتُ , أَوْ بَعْدَهَا ؟ , قَالَ : \" نَعَمْ , آخُذُ بِالرُّخْصَةِ وَالسُّنَّةِ فَأَقْصُرُ , ثُمَّ أُحِبُّ زِيَادَةَ الْخَيْرِ فَأَتَطَوَّعُ ""","","","","","Book of Prayer"
"4303","عَنِ ابْنِ جُرَيْجٍ , وَمَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , \" أَنَّهُ كَانَ يَتَطَوَّعُ فِي السَّفَرِ كَمَا يَتَطَوَّعُ فِي الْحَضَرِ , وَكَانَ يَجْمَعُ بَيْنَ الصَّلاتَيْنِ ""","","","","","Book of Prayer"
"4304","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , أَنَّ عُمَرَ , وَابْنَ مَسْعُودٍ كَانَا يُصَلِّيَانِ فِي السَّفَرِ قَبْلَ الْمَكْتُوبَةِ وَبَعْدَهَا , قَالَ عَبْدُ الرَّزَّاقِ \" وَرَأَيْتُ أَنَا الثَّوْرِيَّ يَفْعَلُهُ ""","","","","","Book of Prayer"
"4305","عَنْ إِسْرَائِيلَ , عَنْ عِيسَى بْنِ أَبِي عَزَّةَ , قَالَ : \" رَأَيْتُ عَامِرًا الشَّعْبِيَّ يَتَطَوَّعُ فِي السَّفَرِ قَبْلَهَا وَبَعْدَهَا ""","","","","","Book of Prayer"
"4306","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ , قال : \" رَأَيْتُ مَكْحُولا يَتَطَوَّعُ فِي السَّفَرِ قَبْلَهَا وَبَعْدَهَا ""","","","","","Book of Prayer"
"4307","\" وَرَأَيْتُ أَنَا الثَّوْرِيَّ يَتَطَوَّعُ قَبْلَهَا وَبَعْدَهَا ""","","","","","Book of Prayer"
"4308","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , قال : \" رَأَيْتُ أَنَا الْقَاسِمَ بْنَ مُحَمَّدٍ يَتَطَوَّعُ فِي السَّفَرِ , وَرَأَيْتُ سَالِمًا لا يَتَطَوَّعُ ""","","","","","Book of Prayer"
"4309","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : لا أَعْلَمُ أَحَدًا مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُوفِي الصَّلاةَ فِي السَّفَرِ إِلا سَعْدَ بْنَ أَبِي وَقَّاصٍ , قَالَ : \" وَكَانَتْ عَائِشَةُ تُوُفِي الصَّلاةَ فِي السَّفَرِ وَتَصُومُ \" , قَالَ : وَسَافَرَ سَعْدُ بْنُ أَبِي وَقَّاصٍ فِي نَفَرٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَوْفَى سَعْدٌ الصَّلاةَ وَصَامَ , وَقَصَرَ الْقَوْمُ وَأَفْطَرُوا , فَقَالُوا لِسَعْدٍ : كَيْفَ يُفْطِرُونَ وَيَقْصُرُونَ وَأَنْتَ تُتِمُّهَا وَتَصُومُ ؟ , قَالَ : \" دُونَكُمْ أَمْرَكُمْ ؛ فَإِنِّي أَعْلَمُ بِشَأْنِي \" , قَالَ : فَلَمْ يُحَرِّمْهُ عَلَيْهِمْ سَعْدٌ وَلَمْ يَنْهَهُمْ عَنْهُ","","","","","Book of Prayer"
"4310","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : فَأَيُّ ذَلِكَ أَحَبُّ إِلَيْكَ ؟ , قَالَ : \" قَصْرُهَا , وَكُلُّ ذَلِكَ قَدْ فَعَلَ الصَّالِحُونَ وَالأَخْيَارُ ""","","","","","Book of Prayer"
"4311","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ عُرْوَةَ , عَنْ عَائِشَةَ , قَالَ : كَانَتْ تَصُومُ فِي السَّفَرِ وَتُصَلِّي أَرْبَعًا \" , أَوْ قَالَ : \" وَتُتِمُّ ""","","","","","Book of Prayer"
"4312","عَنِ الثَّوْرِيِّ , عَنْ هِشَامٍ , عَنْ عُرْوَةَ , عَنْ عَائِشَةَ : \" أَنَّهَا كَانَتْ تُتِمُّ فِي السَّفَرِ ""","","","","","Book of Prayer"
"4313","عَنِ ابْنِ مُحَرَّرٍ , عَنْ مَيْمُونِ بْنِ مِهْرَانَ , عَنْ عَائِشَةَ , قَالَتْ : \" مَنْ صَلَّى أَرْبَعًا فِي السَّفَرِ فَحَسَنٌ , وَمَنْ صَلَّى رَكْعَتَيْنِ فَحَسَنٌ , إِنَّ اللَّهَ لا يُعَذِّبُكُمْ عَلَى الزِّيَادَةِ , وَلَكِنْ يُعَذِّبُكُمْ عَلَى النُّقْصَانِ ""","","","","","Book of Prayer"
"4314","عَنِ الثَّوْرِيِّ , عَنْ عَاصِمٍ , عَنْ أَبِي قِلابَةَ , قَالَ : كَانَ يَقُولُ : \" إِنْ صَلَّيْتَ فِي السَّفَرِ أَرْبَعًا فَقَدْ صَلَّى مَنْ لا بَأْسَ بِهِ ""","","","","","Book of Prayer"
"4315","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : جَاءَ رَجُلٌ إِلَى ابْنِ عُمَرَ , فَقَالَ : إِنِّي كُنْتُ أَنَا وَصَاحِبٌ لِي فِي سَفَرٍ , فَأَتْمَمْتُ أَنَا وَقَصَرَ هُوَ , فَقَالَ ابْنُ عُمَرَ : \" بَلْ أَتَمَّ هُوَ , وَقَصَرْتَ أَنْتَ ""","","","","","Book of Prayer"
"4316","عَنْ غَالِبِ بْنِ عُبَيْدِ اللَّهِ , قَالَ : أَخْبَرَنِي حَمَّادٌ , عَنْ إِبْرَاهِيمَ , أَنَّ ابْنَ مَسْعُودٍ , قَالَ : مَنْ صَلَّى فِي السَّفَرِ أَرْبَعًا أَعَادَ الصَّلاةَ ""","","","","","Book of Prayer"
"4317","قَالَ غَالِبٌ : وَأَخْبَرَنِي ذَلِكَ السَّخْتِيَانِيُّ , أَنَّ ابْنَ عَبَّاسٍ , قَالَ : \" إِنَّ اللَّهَ أَنْزَلَهُ جُمْلَةَ الصَّلاةِ , وَأَنَّهُ فَرَضَ لِلْمُسَافِرِ صَلاةً , وَلِلْمُقِيمِ صَلاةً , فَلا يَنْبَغِي لِلْمُقِيمِ أَنْ يُصَلِّيَ صَلاةَ الْمُسَافِرِ , وَلا يَنْبَغِي لِلْمُسَافِرِ أَنْ يُصَلِّيَ صَلاةَ الْمُقِيمِ ""","","","","","Book of Prayer"
"4318","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ صَفْوَانَ بْنِ عَبْدِ اللَّهِ , عَنْ أُمِّ الدَّرْدَاءِ , عَنْ كَعْبِ بْنِ عَاصِمٍ الأَشْعَرِيِّ , وَكَانَ مِنْ أَصْحَابِ السَّفِينَةِ , قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لَيْسَ مِنَ الْبِرِّ الصِّيَامُ فِي السَّفَرِ ""","","","","","Book of Prayer"
"4319","عَنْ مَعْمَرٍ , قَالَ : كَانَ الزُّهْرِيُّ , يَقُولُ : \" يُفْطِرُ الْمُسَافِرُ إِذَا أَمْعَنَ , وَذَلِكَ مَسِيرَةُ يَوْمَيْنِ ""","","","","","Book of Prayer"
"4320","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي ابْنُ شِهَابٍ , أَنَّ صَفْوَانَ بْنَ عَبْدِ اللَّهِ بْنِ صَفْوَانَ حَدَّثَهُ , عَنْ أُمِّ الدَّرْدَاءِ , عَنْ كَعْبِ بْنِ عَاصِمٍ الأَشْعَرِيِّ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" لَيْسَ مِنَ الْبِرِّ الصِّيَامُ فِي السَّفَرِ ""","","","","","Book of Prayer"
"4321","عَنْ عَبْدِ الْوَهَّابِ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ أَبِي حَمِيدٍ , عَنْ مُحَمَّدِ بْنِ الْمُنْكَدِرِ , عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لَيْسَ مِنَ الْبِرِّ الصِّيَامُ فِي السَّفَرِ ""","","","","","Book of Prayer"
"4322","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَامَ الْفَتْحِ فِي شَهْرِ رَمَضَانَ , فَصَامَ حَتَّى بَلَغَ الْكَدِيدَ , ثُمَّ أَفْطَرَ \" , قَالَ الزُّهْرِيُّ : فَكَانَ الْفِطْرُ آخِرَ الأَمْرَيْنِ","","","","","Book of Prayer"
"4323","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ , عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَامَ الْفَتْحِ فِي شَهْرِ رَمَضَانَ , فَصَامَ حَتَّى بَلَغَ الْكَدِيدَ , ثُمَّ أَفْطَرَ \" , قَالَ : فَكَانُوا يَتَّبِعُونَ الأَخِيرَ مِنْ أَمْرِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَالآخِرَ مِنْ أَمْرِهِ","","","","","Book of Prayer"
"4324","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ عِكْرِمَةَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَامَ الْفَتْحِ فِي شَهْرِ رَمَضَانَ , فَصَامَ حَتَّى مَرَّ بِغَدِيرٍ فِي الطَّرِيقِ , وَذَلِكَ فِي نَحْرِ الظَّهِيرَةِ , قَالَ : فَعَطِشَ النَّاسُ وَجَعَلُوا يَمُدُّونَ أَعْنَاقَهُمْ وَتَتُوقُ أَنْفُسُهُمْ إِلَيْهِ , قَالَ : فَدَعَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِقَدَحٍ فِيهِ مَاءٌ فَأَمْسَكَهُ عَلَى يَدَهِ حَتَّى رَآهُ النَّاسُ , ثُمَّ شَرِبَ , فَشَرِبَ النَّاسُ ""","","","","","Book of Prayer"
"4325","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي جَعْفَرُ بْنُ مُحَمَّدٍ , عَنْ أَبِيهِ , قَالَ : لَمَّا أَنْ كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي مَخْرَجِهِ لِلْفَتْحِ بِعُسْفَانَ , أَوْ بِالْكَدِيدِ  عَبْدُ الْمَلِكِ شَكَّ نُوِّلَ قَدَحًا , وَهُوَ عَلَى رَاحِلَتِهِ فِي شَهْرِ رَمَضَانَ , فَجَعَلْتِ الرِّفَاقُ تَمُرُّ بِهِ , وَالْقَدَحُ عَلَى يَدَهِ ثُمَّ شَرِبَ , فَبَلَغَهُ بَعْدَ ذَلِكَ أَنَّ نَاسًا صَامُوا , فَقَالَ : أُولَئِكَ العَاصُونَ ثَلاثَ مَرَّاتٍ","","","","","Book of Prayer"
"4326","عَنْ عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ , عَنْ نَافِعٍ , قَالَ : \" كَانَ ابْنُ عُمَرَ لا يَصُومُ فِي السَّفَرِ , وَلا يَزِيدُ عَلَى رَكْعَتَيْنِ بِالنَّهَارِ , وَكَانَ يُحْيِي اللَّيْلَ ""","","","","","Book of Prayer"
"4327","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , قَالَ : مَا رَأَيْتُ ابْنَ عُمَرَ صَامَ فِي السَّفَرِ قَطُّ إِلا يَوْمًا وَاحِدًا , فَإِنِّي رَأَيْتُهُ أَفْطَرَ حِينَ أَمْسَى , فَقُلْنَا : كُنْتَ صَائِمًا ؟ , قَالَ : \" نَعَمْ , كُنْتُ أَرَى أَنِّي سَأَدْخُلُ مَكَّةَ الْيَوْمَ , فَكَرِهْتُ أَنْ يَكُونَ النَّاسُ صِيَامًا وَأَنَا مُفْطِرٌ , وَذَلِكَ فِي رَمَضَانَ ""","","","","","Book of Prayer"
"4328","عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدٍ , عَنْ إِسْمَاعِيلَ بْنِ رَافِعٍ , عَنِ ابْنِ عُمَرَ , أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سَأَلَهُ رَجُلٌ عَنِ الصَّلاةِ وَالْفِطْرِ فِي شَهْرِ رَمَضَانَ فِي السَّفَرِ , فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَفْطِرْ , قَالَ : إِنِّي أَقْوَى عَلَى الصَّوْمِ يَا رَسُولَ اللَّهِ , قَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَنْتَ أَقْوَى أَمِ اللَّهُ ؟ إِنَّ اللَّهَ تَصَدَّقَ بِإِفْطَارِ الصَّائِمِ عَلَى مَرْضَى أُمَّتِي وَمُسَافِرِيهِمْ , أَفَيُحِبُّ أَحَدُكُمْ أَنْ يَتَصَدَّقَ عَلَى أَحَدِكُمْ بِصَدَقَةٍ ثُمَّ يَظَلُّ يَرُدُّهَا عَلَيْهِ ؟","","","","","Book of Prayer"
"4329","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ أَبِي قِلابَةَ , عَنْ رَجُلٍ مِنْ بَنِي عَامِرٍ , أَنَّ رَجُلا يُقَالُ لَهُ : أَنَسٌ , حَدَّثَهُ أَنَّهُ قَدِمَ الْمَدِينَةَ فَدَخَلَ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِحَاجَةٍ , فَوَجَدَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَأْكُلُ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" ادْنُ \" , فَقَالَ الرَّجُلُ : إِنِّي صَائِمٌ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّ الْمُسَافِرَ قَدْ وُضِعَ عَنْهُ الصَّوْمُ وَشَطْرُ الصَّلاةِ , وَعَنِ الْحَامِلِ وَالْمُرْضِعِ \" , عَنْ عَبْدِ اللَّهِ بْنِ مُحَرَّرٍ , عَنْ أَيُّوبَ , عَنْ أَبِي قِلابَةَ , عَنْ رَجُلٍ مِنْ بَنِي عَامِرٍ , عَنْ رَجُلٍ يُقَالُ لَهُ : أَنَسٌ , مِثْلَ حَدِيثِ مَعْمَرٍ","","","","","Book of Prayer"
"4330","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَةَ , عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : كُنْتُ عِنْدَهُ فَأَتَاهُ قَوْمٌ مِنْ أَهْلِ الْجَزِيرَةِ , فَقَالُوا : يَا أَبَا مُحَمَّدٍ , إِنَّا نُسَافِرُ فِي الْمَحَامِلِ , وَإِنَّا نَكْفَى , أَفَنَصُومُ ؟ , قَالَ \" لا \" , قَالُوا : إِنَّا نَقْوَى عَلَى ذَلِكَ , قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , كَانَ أَقْوَى وَخَيْرًا مِنْكُمْ , قَالَ : خِيَارُكُمُ الَّذِينَ إِذَا سَافَرُوا قَصَرُوا الصَّلاةَ , وَلَمْ يَصُومُوا ""","","","","","Book of Prayer"
"4331","عَنْ أَبِي سَعِيدِ بْنِ حَبِيبٍ , أَنَّ عُرْوَةَ بْنَ رُوَيْمٍ حَدَّثَهُ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" خِيَارُ أُمَّتِي مَنْ شَهِدَ أَنْ لا إِلَهَ إِلا اللَّهُ , وَحْدَهُ لا شَرِيكَ لَهُ , وَأَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ , وَالَّذِينَ إِذَا أَحْسَنُوا اسْتَبْشَرُوا , وَإِذَا أَسَاءُوا اسْتَغْفَرُوا , وَإِذَا سَافَرُوا قَصَرُوا وَأَفْطَرُوا , وَشِرَارُ أُمَّتِي الَّذِينَ وُلِدُوا فِي النَّعِيمِ وَغُذُّوا بِهِ , هِمَّتُهُمْ , أَوْ قَالَ : مُهِمَّتُهُمْ لَيِّنُ الثِّيَابِ , طَيِّبُ الطَّعَامِ , وَالْفُسُوقُ فِي الْكَلامِ ""","","","","","Book of Prayer"
"4332","عَنْ يَاسِينَ بْنِ أَبِي بِسْطَامٍ , عَنْ ضَحَّاكِ بْنِ مُزَاحِمٍ , قَالَ : قَالَ لِي ابْنُ عَبَّاسٍ \" مَهْمَا عَصَيْتَنِي فِيهِ مِنْ شَيْءٍ فَلا تَعْصِيَنِّي فِي ثَلاثٍ إِذَا خَرَجْتَ مُسَافِرًا فَصَلِّ رَكْعَتَيْنِ حَتَّى تَرْجِعَ إِلَى أَهْلِيكَ , وَلا تَصُومَنَّ حَتَّى تَرْجِعَ إِلَى بَيْتِكَ , وَلا تَدْخُلْ مَكَّةَ إِلا بِإِحْرَامٍ ""","","","","","Book of Prayer"
"4333","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَاصِمِ بْنِ عُبَيْدِ اللَّهِ , عَنْ عَبْدِ اللَّهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ , \" أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَمَرَ رَجُلا صَامَ شَهْرَ رَمَضَانَ فِي السَّفَرِ أَنْ يَقْضِيَهُ \" , قَالَ ابْنُ عُيَيْنَةَ : وَأَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , عَنْ كُلْثُومِ بْنِ جَبْرٍ , عَنْ رَجُلٍ , عَنْ عُمَرَ مِثْلَهُ","","","","","Book of Prayer"
"4334","عَنْ يَحْيَى بْنِ رَبِيعَةَ , قَالَ : سَأَلْتُ عَطَاءَ بْنَ أَبِي رَبَاحٍ , عَنِ الصَّائِمِ فِي السَّفَرِ , فَقَالَ : \" أَمَّا الْمَفْرُوضُ فَلا , وَأَمَّا التَّطَوُّعُ فَلا بَأْسَ ""","","","","","Book of Prayer"
"4335","عَنْ هِشَامِ بْنِ حَسَّانَ , قَالَ : سَمِعْتُ الْقَاسِمَ يُحَدِّثُ , عَنِ ابْنِ عُمَرَ , قَالَ : كَانَ يَقُولُ : \" مَنْ صَحِبَنَا فَلا يَصُمْ \" , قَالَ : وَكَانَ لا يَصُومُ فِي السَّفَرِ","","","","","Book of Prayer"
"4336","عَنْ مَعْمَرٍ , عَنِ الْحَسَنِ , وَقَتَادَةَ , قَالا : \" يُفْطِرُ الْمُسَافِرُ , وَيَقْصُرُ الصَّلاةَ ""","","","","","Book of Prayer"
"4337","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , قَالَ : كَانَ مَعَهُ رَجُلٌ يَصُومُ يَوْمَ السَّفَرِ , فَكَانَ ابْنُ عُمَرَ يَأْمُرُ بِسَحُورِهِ فَيُعْمَلُ لَهُ , وَإِذَا كَانَ عِنْدَ الْفِطْرِ نَزَلَ وَاحْتَبَسَ عَلَيْهِ حَتَّى يُفْطِرَ , قَالَ : فَأَصَابَ الرَّجُلُ يَوْمًا جَهْدًا شَدِيدًا مِنَ الْعَطَشِ , فَقَالَ لَهُ ابْنُ عُمَرَ : لَئِنْ دَخَلْتَ النَّارَ بَعْدَمَا أَرَى لَقَدْ رَأَيْتُ نَقِيًّا ""","","","","","Book of Prayer"
"4338","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , قال : دَعَا عُمَرُ بْنُ عَبْدِ الْعَزِيزِ سَالِمَ بْنَ عَبْدِ اللَّهِ وَعُرْوَةَ بْنَ الزُّبَيْرِ فَسَأَلَهُمَا عَنِ الْمُسَافِرِ فِي رَمَضَانَ : أَيَصُومُ أَمْ يُفْطِرُ ؟ , فَقَالَ عُرْوَةُ : إِنِّي إِنَّمَا أَخَذْتُ عَنْ عَائِشَةَ , وَقَالَ سَالِمٌ : وَإِنَّمَا أَخَذْتُ عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , قَالَ : فَلَمَّا امْتَرَيَا وَارْتَفَعَتْ أَصْوَاتُهُمَا , قَالَ عُمَرُ : اللَّهُمَّ اغْفِرْ ! اللَّهُمَّ اغْفِرْ أَصُومُهُ فِي الْيُسْرِ , وَأُفْطِرُهُ فِي الْعُسْرِ ""","","","","","Book of Prayer"
"4339","عَنْ مُقَاتِلٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ شُعَيْبٍ , عَنْ أَبِيهِ , عَنْ جَدِّهِ , عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو , قَالَ : رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مُفْطِرًا وَصَائِمًا","","","","","Book of Prayer"
"4340","\" وَرَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي حَافِيًا وَمُتَنَعِّلا ""","","","","","Book of Prayer"
"4341","\" وَرَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَشْرَبُ قَائِمًا وَقَاعِدًا ""","","","","","Book of Prayer"
"4342","عَنِ ابْنِ جُرَيْجٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَامَ فِي السَّفَرِ وَأَفْطَرَ , فَلا يُعَابُ عَلَى مَنْ صَامَ , وَلا عَلَى مَنْ أَفْطَرَ , فَمَنْ صَامَ خَيْرٌ مِمَّنْ أَفْطَرَ \" , عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , عَنِ ابْنِ عَبَّاسٍ مِثْلَهُ , وَقَالَ : \" خُذْ بِأَيْسَرِهِمَا عَلَيْكَ \" , قَالَ اللَّهُ تَبَارَكَ وَتَعَالَى :  يُرِيدُ اللَّهُ بِكُمُ الْيُسْرَ وَلا يُرِيدُ بِكُمُ الْعُسْرَ ","","","","","Book of Prayer"
"4343","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ , وَأَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ , أنهم خرجوا إلى مكة ومعهم الأسود بن يزيد , فأدركهم هلال شهر رمضان فصاموا في الطريق , قال : \" وَمَرَرْنَا بِبِئْرِ مَيْمُونٍ فَأَمَرَهُمْ أَنْ يَغْتَسِلُوا ""","","","","","Book of Prayer"
"4344","عَنْ إِسْرَائِيلَ , عَنْ عَامِرِ بْنِ شَقِيقٍ , عَنْ شَقِيقِ بْنِ سَلَمَةَ , قَالَ : \" أَهْلَلْنَا هِلالَ رَمَضَانَ بِحُلْوَانَ , أَوْ بِالْمَدَائِنِ , وَفِينَا رِجَالٌ مِنْ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَنَادَى أَمِيرُهُمْ مَنْ شَاءَ مِنْكُمْ أَنْ يَصُومَ فَلْيَصُمْ , وَمَنْ شَاءَ مِنْكُمْ أَنْ يُفْطِرَ فَلْيُفْطِرْ , فَإِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَدْ صَامَ فِي السَّفَرِ وَأَفْطَرَ ""","","","","","Book of Prayer"
"4345","عَنِ ابْنِ عُيَيْنَةَ , عَنْ مِسْعَرٍ , عَنِ الْحَسَنِ بْنِ سَعْدٍ , عَنْ أَبِيهِ , قَالَ : أَقْبَلْتُ مَعَ عَلِيِّ بْنِ أَبِي طَالِبٍ مِنْ يَنْبُعَ , قَالَ : فَصَامَ عَلِيٌّ , وَكَانَ عَلِيٌّ رَاكِبًا , وَأَفْطَرْتُ لأَنِّي كُنْتُ مَاشِيًا , حَتَّى قَدِمْنَا الْمَدِينَةَ لَيْلا فَمَرَرْنَا بِدَارِ عُثْمَانَ بْنِ عَفَّانَ , فَإِذَا هُوَ يَقْرَأُ , قَالَ : فَوَقَفَ عَلِيٌّ يَسْتَمِعُ قِرَاءَتَهُ , ثُمَّ قَالَ عَلِيٌّ : \" إِنَّهُ يَقْرَأُ وَهُوَ فِي سُورَةِ , أَوْ قَالَ : فِي سُورَةِ النَّحْلِ \" , قَالَ أَبُو بَكْرٍ : \" أُخْبِرْتُ أَنَّ بَيْنَ يَنْبُعَ وَبَيْنَ الْمَدِينَةِ أَرْبَعَةُ أَيَّامٍ ""","","","","","Book of Prayer"
"4346","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ عُرْوَةَ , عَنْ عَائِشَةَ : \" أَنَّهَا كَانَتْ تَصُومُ فِي السَّفَرِ ""","","","","","Book of Prayer"
"4347","عَنِ ابْنِ أَبِي نَجِيحٍ , عَنْ مُجَاهِدٍ , قال : إِنَّمَا كُرِهَ الصَّوْمُ لِلْمُسَافِرِ لأَنَّ الْقَوْمَ يَقُولُونَ : ارْحَلُوا لَهُ , فَإِنَّهُ صَائِمٌ , وَاعْلِفُوا لَهُ دَابَّتَهُ , فَإِنَّهُ صَائِمٌ ""","","","","","Book of Prayer"
"4348","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ , عَنْ طَاوُسٍ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : لا نَعِيبُ عَلَى مَنْ صَامَ فِي السَّفَرِ , وَلا عَلَى مَنْ أَفْطَرَ , قَالَ اللَّهُ :  يُرِيدُ اللَّهُ بِكُمُ الْيُسْرَ وَلا يُرِيدُ بِكُمُ الْعُسْرَ ""","","","","","Book of Prayer"
"4349","عَنْ مَعْمَرٍ , عَنْ حُمَيْدٍ , عَنِ الأَعْرَجِ , قَالَ : سَمِعْتُ مُجَاهِدًا , يَقُولُ : \" خُذْ بِأَيْسَرِهِمَا عَلَيْكَ , لَمْ يُرِدِ اللَّهُ إِلا الْيُسْرَ ""","","","","","Book of Prayer"
"4350","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : صَامَ بَعْضُ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي السَّفَرِ , وَأَفْطَرَ بَعْضُهُمْ , فَلَمْ يَعِبْ بَعْضُهُمْ عَلَى بَعْضٍ , قَالَ : \" أَخَذَ هَذَا بِرُخْصَةِ اللَّهِ , وَأَدَّى هَذَا فَرِيضَةَ اللَّهِ ""","","","","","Book of Prayer"
"4351","عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ , عَنْ هِشَامٍ , قال : كَانَ ابْنُ سِيرِينَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا فِي الْحَضَرِ وَالسَّفَرِ ""","","","","","Book of Prayer"
"4352","عَنْ مَعْمَرٍ , عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ , قَالَ : جَاءَ رَجُلٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ : يَا رَسُولَ اللَّهِ , إِنِّي كُنْتُ أَسْرُدُ الصَّوْمَ وَأَنَا أُرِيدُ أَنْ أُسَافِرَ , قَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنْ شِئْتَ فَصُمْ , وَإِنْ شِئْتَ فَأَفْطِرْ ""","","","","","Book of Prayer"
"4353","عَنِ ابْنِ جُرَيْجٍ , عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ , أَنَّ حَمْزَةَ الأَسْلَمِيَّ سَأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الصِّيَامِ فِي السَّفَرِ , فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنْ شِئْتَ فَصُمْ , وَإِنْ شِئْتَ فَأَفْطِرْ ""","","","","","Book of Prayer"
"4354","أَخْبَرَنَا عَبْدُ الرَّزَّاقِ , قَالَ : أَخْبَرَنَا مَعْمَرٌ , عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ , قال : \" إِذَا خَرَجَ الرَّجُلُ مُسَافِرًا فِي شَهْرِ رَمَضَانَ , وَقَدْ أَصْبَحَ صَائِمًا أَفْطَرَ إِنْ شَاءَ حِينَ يَخْرُجُ ""","","","","","Book of Prayer"
"4355","عَنْ مَعْمَرٍ , عَنْ مَنْ سَمِعَ الْحَسَنَ , يَقُولُ : \" لا يُفْطِرُ الصَّائِمُ الْيَوْمَ إِلا أَنْ يَشْتَدَّ عَلَيْهِ الْعَطَشُ , فَإِنْ خَافَ عَلَى نَفْسِهِ أَفْطَرَ ""","","","","","Book of Prayer"
"4356","عَنْ إِسْرَائِيلَ , عَنْ جَابِرٍ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , قال : \" لا يُفْطِرُ ذَلِكَ الْيَوْمَ ""","","","","","Book of Prayer"
"4357","عَنْ إِسْرَائِيلَ , عَنْ جَابِرٍ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , \" أَنَّ عَمْرَو بْنَ شُرَحْبِيلَ خَرَجَ مُسَافِرًا نَهَارًا , فَلَمَّا جَاوَزَ الْفُرَاتَ أَمَرَ غُلامَهُ فَسَقَاهُ فَأَفْطَرَ ""","","","","","Book of Prayer"
"4358","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" لا يُصَلِّي الرَّجُلُ الْمَكْتُوبَةَ عَلَى الدَّابَّةِ مُقْبِلا إِلَى الْبَيْتِ , وَلا مُدْبِرًا عَنْهُ , إِلا أَنْ يَكُونَ مَرِيضًا أَوْ خَائِفًا , فَلْيُصَلِّ عَلَى دَابَّتِهِ مُقْبِلا إِلَى الْبَيْتِ غَيْرَ مُدْبِرٍ عَنْهُ ""","","","","","Book of Prayer"
"4359","عَنِ ابْنِ جُرَيْجٍ , قال : قُلْتُ لِعَطَاءٍ : قَوْمٌ مُسَافِرُونَ , أَمَامَهُمْ مَطَرٌ , يُصَلُّونَ عَلَى دَوَابِّهِمْ ؟ , قَالَ : نَعَمْ , إِنْ شَاءُوا \" , قُلْتُ : أَيَمْسَحُونَ بِالتُّرَابِ إِذَا لَمْ يَجِدُوا مَاءً ؟ قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"4360","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ مُحَمَّدِ بْنِ ثَوْبَانَ , عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا أَرَادَ أَنْ يُصَلِّيَ الْمَكْتُوبَةَ نَزَلَ عَنْ رَاحِلَتِهِ وَاسْتَقْبَلَ الْقِبْلَةَ ""","","","","","Book of Prayer"
"4361","عَنْ هِشَامِ بْنِ حَسَّانَ , عَنْ أَنَسِ بْنِ سِيرِينَ , قَالَ : \" كُنْتُ مَعَ أَنَسِ بْنِ مَالِكٍ فِي يَوْمٍ مَطِيرٍ حَتَّى إِذَا كُنَّا بِأَطِيطٍ , وَالأَرْضُ فَضْفَاضٌ , صَلَّى بِنَا عَلَى حِمَارِهِ صَلاةَ الْعَصْرِ , يُومِئُ بِرَأْسِهِ إِيمَاءً , وَجَعَلَ السُّجُودَ أَخْفَضَ مِنَ الرُّكُوعِ ""","","","","","Book of Prayer"
"4362","عَنْ مَعْمَرٍ , عَنْ عَاصِمٍ الأَحْوَلِ , قَالَ : سَمِعْتُ أَنَسَ بْنَ مَالِكٍ , يَقُولُ : \" إِنَّهُ كَانَ يَسِيرُ فِي مَاءٍ وَطِينٍ , فَحَضَرَتِ الصَّلاةُ الْمَكْتُوبَةُ فَلَمْ يَسْتَطِعْ أَنْ يَخْرُجَ مِنْ ذَلِكَ الْمَاءِ \" , قَالَ : \" وَخَشِينَا أَنْ تَفُوتَنَا الصَّلاةُ فَاسْتَخَرْنَا اللَّهَ وَاسْتَقْبَلْنَا الْقِبْلَةَ , فَأَوْمَأْنَا عَلَى دَوَابِّنَا إِيمَاءً ""","","","","","Book of Prayer"
"4363","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ : أَخْبَرَنِي مَنْ رَأَى أَبَا الشَّعْثَاءِ يُومِئُ فِي الصَّلاةِ فِي مَاءٍ وَطِينٍ","","","","","Book of Prayer"
"4364","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قال : كَانُوا يُصَلُّونَ عَلَى ظُهُورِ دَوَابِّهِمْ حَيْثُ تَوَجَّهُوا غَيْرَ الْفَرِيضَةِ وَالْوِتْرِ ""","","","","","Book of Prayer"
"4365","عَنْ مَنْصُورٍ , عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" كَانَ إِنْسَانٌ فِي مَاءٍ لا يَسْتَطِيعُ أَنْ يَخْرُجَ مِنْهُ , فَلْيُصَلِّ وَلْيُومِئْ بِرَأْسِهِ إِيمَاءً وَلا يَسْجُدْ ""","","","","","Book of Prayer"
"4366","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ , عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي عَلَى رَاحِلَتِهِ تَطَوُّعًا حَيْثُ تَوَجَّهَتْ بِهِ , فَإِذَا أَرَادَ أَنْ يُصَلِّيَ الْمَكْتُوبَةَ نَزَلَ عَنْ رَاحِلَتِهِ وَاسْتَقْبَلَ الْقِبْلَةَ ""","","","","","Book of Prayer"
"4367","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ عَامِرِ بْنِ رَبِيعَةَ , عَنْ أَبِيهِ , قَالَ : \" رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي عَلَى ظَهْرِ رَاحِلَتِهِ فِي كُلِّ جِهَةٍ ""","","","","","Book of Prayer"
"4368","عَنْ عُبَيْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , أَنَّهُ كَانَ يُصَلِّي عَلَى رَاحِلَتِهِ تَطَوُّعًا حَيْثُ تَوَجَّهَتْ بِهِ , وَيُخْبِرُهُمْ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَفْعَلُهُ , قَالَ : سَأَلْتُ نَافِعًا كَيْفَ كَانَ الْوِتْرُ ؟ , قَالَ : \" كَانَ يُوتِرُ عَلَى رَاحِلَتِهِ , وَرُبَّمَا نَزَلَ فَأَوْتَرَ بِالأَرْضِ ""","","","","","Book of Prayer"
"4369","عَنِ الثَّوْرِيِّ , عَنْ عَمْرِو بْنِ يَحْيَى , قَالَ : حَدَّثَنَا سَعِيدُ بْنُ يَسَارٍ , عَنِ ابْنِ عُمَرَ , قَالَ : \" رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي عَلَى حِمَارِهِ تَطَوُّعًا , وَهُوَ مُتَوَجِّهٌ إِلَى خَيْبَرَ ""","","","","","Book of Prayer"
"4370","عَنِ ابْنِ مُجَاهِدٍ , عَنْ أَبِيهِ , عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُصَلِّي عَلَى رَاحِلَتِهِ تَطَوُّعًا حَيْثُ تَوَجَّهَتْ بِهِ , وَيَجْعَلُ السُّجُودَ أَخْفَضَ مِنَ الرُّكُوعِ ""","","","","","Book of Prayer"
"4371","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ , أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ : \" رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي وَهُوَ عَلَى رَاحِلَتِهِ النَّوَافِلَ فِي كُلِّ جِهَةٍ , وَلَكِنَّهُ يَخْفِضُ السُّجُودَ مِنَ الرَّكْعَةِ , يُومِئُ إِيمَاءً ""","","","","","Book of Prayer"
"4372","عَنِ الثَّوْرِيِّ , عَنْ أَبِي الزُّبَيْرِ , عَنْ جَابِرٍ , قَالَ : بَعَثَنِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِحَاجَةٍ , فَجِئْتُ وَهُوَ يُصَلِّي نَحْوَ الْمَشْرِقِ , وَيُومِئُ بِرَأْسِهِ إِيمَاءً عَلَى رَاحِلَتِهِ , السُّجُودُ أَخْفَضُ مِنَ الرُّكُوعِ , فَسَلَّمْتُ فَلَمْ يَرُدَّ عَلَيَّ , فَلَمَّا قَضَى صَلاتَهُ , قَالَ : \" مَا فَعَلْتَ فِي حَاجَةِ كَذَا وَكَذَا ؟ \" إِني كنتُ أُصلِّي","","","","","Book of Prayer"
"4373","عَنْ مَالِكٍ , عَنْ يَحْيَى بْنِ سَعِيدٍ , قَالَ : \" رَأَيْتُ أَنَسَ بْنَ مَالِكٍ فِي سَفَرٍ , وَهُوَ يُصَلِّي عَلَى حِمَارٍ وَهُوَ مُتَوَجِّهٌ إِلَى غَيْرِ الْقِبْلَةِ , يَرْكَعُ وَيَسْجُدُ إِيمَاءً بِرَأْسِهِ مِنْ غَيْرِ أَنْ يَضَعَ وَجْهَهُ عَلَى شَيْءٍ ""","","","","","Book of Prayer"
"4374","عَنِ ابْنِ عُيَيْنَةَ , عَنْ يَحْيَى بْنِ سَعِيدٍ , قَالَ : رَأَيْتُ أَنَسَ بْنَ مَالِكٍ يُصَلِّي عَلَى رَاحِلَتِهِ تَطَوُّعًا وَهُوَ مُتَوَجِّهٌ إِلَى الشَّامِ ""","","","","","Book of Prayer"
"4375","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ : أَخْبَرَنِي مَنْ لا أُكَذِّبُ , عَنِ ابْنِ عُمَرَ , \" أَنَّهُ كَانَ يُصَلِّي عَلَى الدَّابَّةِ فِي السَّفَرِ قِبَلَ وَجْهِهِ ""","","","","","Book of Prayer"
"4376","عَنِ ابْنِ جُرَيْجٍ , وَمَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قال : \" يُصَلِّي عَلَى دَابَّتِهِ فِي كُلِّ جِهَةٍ ""","","","","","Book of Prayer"
"4377","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : يُصَلِّي الْمَرْءُ عَلَى دَابَّتِهِ مُدْبِرًا إِلَى الشَّامِ وَالْيَمَنِ \" , قَالَ : قُلْتُ : وَإِنْ كَانَ فِي سَفَرٍ لِلدُّنْيَا ؟ , قَالَ : \" نَعَمْ , يَسْتَفْتِحُ فَيُكَبِّرُ , ثُمَّ يَقْرَأُ , ثُمَّ يَرْكَعُ , ثُمَّ يَسْجُدُ , ثُمَّ يَتَشَهَّدُ ""","","","","","Book of Prayer"
"4378","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : يُصَلِّي عَلَى الدَّوَابِّ كُلِّهَا : عَلَى الْبَعِيرِ , وَالْفَرَسِ , وَالْبَغْلَةِ , وَالْحِمَارِ \" , قَالَ : قُلْتُ : وَعَلَى الْحِمَارِ ؟ , قَالَ : \" نَعَمْ ""","","","","","Book of Prayer"
"4379","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ عَطَاءٍ : \" إِذَا رَكَعْتَ وَضَعْتَ يَدَيْكَ عَلَى رُكْبَتَيْكَ ثُمَّ رَكَعْتَ فَخَفَضْتَ رَأْسَكَ , ثُمَّ تَجْعَلُ السَّجْدَةَ أَخْفَضَ مِنَ الرَّكْعَةِ \" , قُلْتُ : كَرُكُوعِ الْمَرِيضِ وَسُجُودِهِ ؟ , قَالَ : \" نَعَمْ ""","","","","","Book of Prayer"
"4380","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَجَاءَكُمْ بِذَلِكَ ثَبْتٌ بِالصَّلاةِ عَلَى الدَّابَّةِ مُدْبِرًا عَنِ الْقِبْلَةِ ؟ , قَالَ : \" نَعَمْ \" , ثُمَّ قَالَ عِنْدَ ذَلِكَ :  وَلِلَّهِ الْمَشْرِقُ وَالْمَغْرِبُ فَأَيْنَمَا تُوَلُّوا فَثَمَّ وَجْهُ اللَّهِ , قَالَ ابْنُ جُرَيْجٍ : \" ذُكِرَ ذَلِكَ لِيَحْيَى بْنِ جَعْدَةَ فَكَادَ يُنْكِرُ , ثُمَّ انْطَلَقَ فَإِذَا هُوَ مُسْتَفَاضٌ بِالْمَدِينَةِ , فَرَجَعَ إِلَيْنَا وَهُوَ يَعْرِفُ ذَلِكَ ""","","","","","Book of Prayer"
"4381","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , أَنَّ ابْنَ عُمَرَ كَانَ يُصَلِّي فِي السَّفَرِ عَلَى رَاحِلَتِهِ تَطَوُّعًا حَيْثُ تَوَجَّهَتْ بِهِ","","","","","Book of Prayer"
"4382","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" أُوتِرُ وَأَنَا مُدْبِرٌ عَنِ الْقِبْلَةِ عَلَى دَابَّتِي ؟ , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"4383","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ نَافِعًا , يَقُولُ : \" كَانَ ابْنُ عُمَرَ يُوتِرُ عَلَى رَاحِلَتِهِ ""","","","","","Book of Prayer"
"4384","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , \" أَنَّ ابْنَ عُمَرَ كَانَ يُوتِرُ عَلَى رَاحِلَتِهِ , وَرُبَّمَا أَوْتَرَ بِالأَرْضِ ""","","","","","Book of Prayer"
"4385","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , وَأَيُّوبَ , عَنْ نَافِعٍ , \" أَنَّ ابْنَ عُمَرَ كَانَ يُوتِرُ عَلَى رَاحِلَتِهِ ""","","","","","Book of Prayer"
"4386","عَنْ أَبِي مَعْشَرٍ , قَالَ : سَمِعْتُ نَافِعًا , يَقُولُ : تَخَلَّفَ رَجُلٌ وَنَحْنُ فِي السَّفَرِ , فَقَالَ لَهُ ابْنُ عُمَرَ : مَا خَلَّفَكَ ؟ , قَالَ : أَوْتَرْتُ , قَالَ : قَدْ أَوْتَرَ عَلَى بَعِيرٍ مَنْ كَانَ خَيْرًا مِنْكَ , رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Prayer"
"4387","عَنْ مُقَاتِلٍ , عَنِ الزُّهْرِيِّ , قَالَ : أَوْتَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى دَابَّتِهِ","","","","","Book of Prayer"
"4388","عَنِ الثَّوْرِيِّ , عَنْ ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ , عَنْ أَبِيهِ , قَالَ : كَانَ عَلِيٌّ يُوتِرُ عَلَى دَابَّتِهِ ""","","","","","Book of Prayer"
"4389","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ اللَّهِ بْنِ عَوْنٍ , عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ , \" أَنَّ عُمَرَ كَانَ يُوتِرُ بِالأَرْضِ ""","","","","","Book of Prayer"
"4390","عَنْ هِشَامِ بْنِ حَسَّانَ , عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ , \" أَنَّ ابْنَ عُمَرَ كَانَ يُوتِرُ عَلَى رَاحِلَتِهِ إِذَا كَانَ السَّحَرُ فَيُصَلِّي الْوِتْرَ ""","","","","","Book of Prayer"
"4391","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , \" أَنَّ ابْنَ عُمَرَ كَانَ إِذَا أَرَادَ يُوتِرُ نَزَلَ عَنْ رَاحِلَتِهِ فَأَوْتَرَ بِالأَرْضِ ""","","","","","Book of Prayer"
"4392","عَنِ ابْنِ جُرَيْجٍ , قال : قُلْتُ لِعَطَاءٍ : أَيُوتِرُ الرَّجُلُ وَهُوَ جَالِسٌ ؟ , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"4393","أَخْبَرَنَا مَعْمَرٌ , قال : \" قُلْتُ لِقَتَادَةَ : أَيُصَلِّي الرَّجُلُ وَهُوَ يَسُوقُ دَابَّتَهُ إِلَى غَيْرِ الْقِبْلَةِ ؟ , قَالَ : لا , إِلا أَنْ يَكُونَ خَائِفًا ""","","","","","Book of Prayer"
"4394","قَالَ مَعْمَرٌ وَحَدَّثَنِي مَنْ سَمِعَ الْحَسَنَ , يَقُولُ : \" يُصَلِّي الْمَرْءُ كَذَلِكَ فَإِذَا أَرَادَ الرُّكُوعَ وَالسُّجُودَ اسْتَقْبَلَ الْقِبْلَةَ \" , قَالَ مَعْمَرٌ : \" وَقَوْلُ الْحَسَنِ أَعْجَبُ إِلَيَّ ""","","","","","Book of Prayer"
"4395","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : قُلْتُ لَهُ : قَوْمٌ فِي سَفِينَةٍ يَقْصُرُونَ ؟ , قَالَ : لا , إِلا أَنْ يَخَافُوا الْغَرَقَ , قَالَ : قُلْتُ : فَمَنْ كَانَ فِيهَا يَعْمَلُ , أَيَقْصُرُ ؟ , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"4396","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ , عَنْ أَنَسِ بْنِ مَالِكٍ : \" أَنَّهُ قَصَرَ فِي سَفِينَةٍ فَصَلَّى فِيهَا جَالِسًا , وَصَلَّى مَنْ مَعَهُ جُلُوسًا ""","","","","","Book of Prayer"
"4397","عَنْ هِشَامِ بْنِ حَسَّانَ , أَنَّ أَنَسَ بْنَ سِيرِينَ أَخْبَرَهُ , قَالَ : \" صَلَّى بِنَا أَنَسُ بْنُ مَالِكٍ فِي السَّفِينَةِ قُعُودًا عَلَى بِسَاطٍ , وَقَصَرَ الصَّلاةَ ""","","","","","Book of Prayer"
"4398","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , \" أَنَّ ابْنَ سِيرِينَ قَصَرَ فِي السَّفِينَةِ , فَلَمَّا قَدِمَ وَاسِطَ أَتَمَّ الصَّلاةَ ""","","","","","Book of Prayer"
"4399","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , أَنَّ أَنَسَ بْنَ مَالِكٍ قَصَرَ فِي السَّفِينَةِ","","","","","Book of Prayer"
"4400","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" يُصَلُّونَ فِي السَّفِينَةِ قِيَامًا , إِلا أَنْ يَخَافُوا أَنْ يَغْرَقُوا فَيُصَلُّونَ جُلُوسًا يَتَّبِعُونَ الْقِبْلَةَ حَيْثُمَا زَالَتْ ""","","","","","Book of Prayer"
"4401","عَنِ ابْنِ جُرَيْجٍ , قال : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْ كَانَ قُرْبِي سَاحِلٌ , أَأَنْزِلُ فَأُصَلِّي فِيهِ ؟ , قَالَ : إِنْ لَمْ تَحْبِسْ أَصْحَابَكَ فَنَعَمْ ""","","","","","Book of Prayer"
"4402","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" صَلِّ فِي السَّفِينَةِ , وَلا تَشُقَّ عَلَى أَصْحَابِكَ ""","","","","","Book of Prayer"
"4403","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ , قال : \" تُصَلِّي فِي السَّفِينَةِ قَائِمًا , فَإِنْ لَمْ تَسْتَطِعْ فَقَاعِدًا تَتَّبِعُ الْقِبْلَةَ حَيْثُمَا مَالَتْ ""","","","","","Book of Prayer"
"4404","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : تُصَلِّي فِي السَّفِينَةِ إِنْ شِئْتَ قَائِمًا , وَإِنْ شِئْتَ قَاعِدًا , تَسْجُدُ عَلَى قَرَارٍ مِنْهَا , أَوْ عَلَى بِسَاطٍ ""","","","","","Book of Prayer"
"4405","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , وَعَاصِمِ بْنِ سُلَيْمَانَ , أَنَّ أَنَسَ بْنَ مَالِكٍ صَلَّى بِأَصْحَابِهِ فِي السَّفِينَةِ قَاعِدًا عَلَى بِسَاطٍ","","","","","Book of Prayer"
"4406","عَنِ الثَّوْرِيِّ , عَنْ حُصَيْنٍ , عَنْ مُجَاهِدٍ , قال : \" كُنَّا نُصَلِّي فِي السَّفِينَةِ قُعُودًا \" , عَنْ هِشَامٍ , عَنْ أَنَسِ بْنِ سِيرِينَ مِثْلُ ذَلِكَ","","","","","Book of Prayer"
"4407","عَنِ الثَّوْرِيِّ , عَنْ حُمَيْدٍ الطَّوِيلِ , عَنْ عَبْدِ اللَّهِ بْنِ أَبِي عُتْبَةَ , قَالَ : كُنْتُ مَعَ جَابِرِ بْنِ عَبْدِ اللَّهِ , وَأَبِي سَعِيدٍ الْخُدْرِيِّ , وَأَبِي الدَّرْدَاءِ , وَأُرَاهُ ذَكَرَ أَبَا هُرَيْرَةَ فِي سَفِينَةٍ , فَأَمَّنَا الَّذِي أَمَّنَا قَائِمًا , وَلَوْ شِئْنَا أَنْ نَخْرُجَ لَخَرَجْنَا ""","","","","","Book of Prayer"
"4408","عَنِ الثَّوْرِيِّ , عَنْ مَالِكِ بْنِ مِغْوَلٍ , عَنِ الشَّعْبِيِّ , قال : \" يُصَلِّي فِي السَّفِينَةِ قَائِمًا ""","","","","","Book of Prayer"
"4409","عَنِ الثَّوْرِيِّ , عَنْ عَاصِمٍ , عَنِ ابْنِ سِيرِينَ , أَنَّ مَسْرُوقًا كَانَ يَحْمِلُ مَعَهُ لَبِنَةً فِي السَّفِينَةِ لِيَسْجُدَ عَلَيْهَا","","","","","Book of Prayer"
"4410","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" يُصَلِّي فِي السَّفِينَةِ تَطَوُّعًا , وَيَنْحَرِفُ إِلَى الْقِبْلَةِ إِذَا انْحَرَفَتْ ""","","","","","Book of Prayer"
"4411","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سُئِلَ عَطَاءٌ عَنِ الرَّجُلِ يَخْرُجُ مِنَ الْبَحْرِ عُرْيَانًا , قَالَ : \" يُصَلِّي قَاعِدًا ""","","","","","Book of Prayer"
"4412","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ آخَرُونَ : \" إِنْ أَمَّهُمْ أَحَدُهُمْ فَلْيَقُمْ إِمَامُهُمْ فِي الصَّلاةِ فِي الصَّفِّ وَسَطِهِ , وَيَجْعَلُوهُ صَفًّا وَاحِدًا إِنْ شَاءُوا قِيَامًا وَإِنْ شَاءُوا قُعُودًا , وَلْيُغْضِضْ بَعْضُهُمْ عَنْ بَعْضٍ الْبَصَرَ ""","","","","","Book of Prayer"
"4413","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" إِذَا خَرَجَ الرَّجُلُ مِنَ الْبَحْرِ عُرْيَانًا صَلَّى جَالِسًا ""","","","","","Book of Prayer"
"4414","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" إِذَا خَرَجَ نَاسٌ مِنَ الْبَحْرِ عُرَاةً فَأَمَّهُمْ أَحَدُهُمْ صَلَّوْا قُعُودًا , وَكَانَ إِمَامُهُمْ مَعَهُمْ فِي الصَّفِّ , وَيُومِئُونَ إِيمَاءً \" , قَالَ مَعْمَرٌ : \" وَإِنْ كَانَ عَلَى أَحَدِهِمْ ثَوْبٌ أَمَّهُمْ قَائِمًا , وَيَقُومُ فِي الصَّفِّ وَهُمْ خَلْفَهُ قُعُودًا صَفًّا وَاحِدًا ""","","","","","Book of Prayer"
"4415","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ دَاوُدَ بْنِ الْحُصَيْنِ , عَنْ عِكْرِمَةَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" الَّذِي يُصَلِّي فِي السَّفِينَةِ , وَالَّذِي يُصَلِّي عُرْيَانًا , يُصَلِّي جَالِسًا ""","","","","","Book of Prayer"
"4416","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ إِسْحَاقَ بْنِ عَبْدِ اللَّهِ , عَنْ مَيْمُونِ بْنِ مِهْرَانَ , قَالَ : سُئِلَ عَلِيٌّ عَنْ صَلاةِ الْعُرْيَانِ , فَقال : إِنْ كَانَ حَيْثُ يَرَاهُ النَّاسُ صَلَّى جَالِسًا , وَإِنْ كَانَ حَيْثُ لا يَرَاهُ النَّاسُ صَلَّى قَائِمًا ""","","","","","Book of Prayer"
"4417","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \" أَوَاجِبٌ الْوِتْرُ ، وَالرَّكْعَتَانِ أَمَامَ الصُّبْحِ ، أَوْ شَيْءٌ مِنَ الصَّلاةِ قَبْلَ الْمَكْتُوبَةِ ، أَوْ بَعْدَهَا ؟ قَالَ : لا ""","","","","","Book of Prayer"
"4418","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ يُوسُفَ ، وَصَالِحُ بْنُ كَيْسَانَ ، وَمُحَمَّدُ بْنُ إِسْمَاعِيلَ ، عَنْ سَعْدِ بْنِ أَبِي وَقَّاصٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" الْوِتْرُ حَقٌّ ، وَلَيْسَ كَالْمَغْرِبِ ""","","","","","Book of Prayer"
"4419","عَنْ مَعْمَرٍ ، وَالثَّوْرِيُّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ ، قَالَ \" الْوِتْرُ لَيْسَ بِحَتْمٍ كَهَيْئَةِ الْمَكْتُوبَةِ ، وَلَكِنَّهَا سُنَّةٌ سَنَّهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Prayer"
"4420","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : سَأَلَ رَجُلٌ ابْنَ الْمُسَيِّبِ عَنِ الْوِتْرِ ؟ فَقَالَ : \" أَوْتَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَإِنْ تَرَكْتَ فَلَيْسَ عَلَيْكَ ، وَصَلِّ صَلاةَ الضُّحَى ، وَإِنْ تَرَكْتَ فَلَيْسَ عَلَيْكَ ، وَصَلِّ رَكْعَتَيْنِ قَبْلَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَهَا ، وَإِنْ تَرَكْتَ فَلَيْسَ عَلَيْكَ ، وَضَحَّى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَإِنْ تَرَكْتَ فَلَيْسَ عَلَيْكَ \" ، قَالَ : قُلْتُ : يَا أَبَا مُحَمَّدٍ ، هَذَا كُلُّهُ قَدْ عَرَفْنَاهُ مَا خَلا الْوِتْرَ ، قَالَ : بَلَغَنِي , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" فَإِنَّ اللَّهَ وِتْرٌ يُحِبُّ الْوِتْرَ ""","","","","","Book of Prayer"
"4421","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّةَ الْجَمَلِيِّ ، عَنْ أَبِي عُبَيْدَةَ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَوْتِرُوا يَا أَهْلَ الْقُرْآنِ ، فَإِنَّ اللَّهَ وِتْرٌ يُحِبُ الْوِتْرَ \" ، فَقَالَ أَعْرَابِيٌّ : مَا يَقُولُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لَيْسَتْ لَكَ وَلأَصْحَابِكَ ""","","","","","Book of Prayer"
"4422","عَنْ عَبْدِ اللَّهِ بْنِ مُحَمَّدٍ ، عَنْ قَتَادَةَ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أُمِرْتُ بِالْوِتْرِ وَالأضَاحِيِّ ، وَلَمْ يُعْزَمْ عَلَيَّ ""","","","","","Book of Prayer"
"4423","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ ، عَنْ عِكْرِمَةَ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" ثَلاثٌ هُنَّ عَلَيَّ فَرِيضَةٌ ، وَلَكُمْ تَطَوُّعٌ : الضَّحِيَّةُ ، وَصَلاةُ الضُّحَى ، وَالْوِتْرُ ""","","","","","Book of Prayer"
"4424","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، عَنْ عِكْرِمَةَ ، قَالَ : سَأَلَ أُبَيُّ بْنُ كَعْبٍ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الْوِتْرِ ؟ فَقَالَ : \" الْوِتْرُ عَلَى أَهْلِ الْقُرْآنِ ""","","","","","Book of Prayer"
"4425","عَنْ مَعْمَرٍ ، أَوِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ يَحْيَى بْنِ حَبَّانَ ، عَنِ ابْنِ مُحَيْرِيزٍ الْجُمَحِيِّ مِنْ أَهْلِ الشَّامِ ، عَنِ الْمُخَدَّجِيِّ ، قَالَ : قِيلَ لِعُبَادةَ بْنِ الصَّامِتِ ، أَوْ قُلْتُ لَهُ : إِنَّ أَبَا مُحَمَّدٍ ، يَقُولُ إِنَّ الْوِتْرَ وَاجِبٌ ، فَقَالَ عُبَادَةُ كَذَبَ أَبُو مُحَمَّدٍ ، سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : \" خَمْسُ صَلَوَاتٍ كتَبَهُنَّ اللَّهُ عَلَى الْعِبَادِ ، فَمَنْ أَتَى بِهِنَّ لَمْ يَنْقُصْ مِنْهُنَّ شَيْئًا اسْتِحْقَارًا بِحَقِّهِنَّ ، كَانَ حَقًّا عَلَى اللَّهِ أَنْ يُدْخِلَهُ الْجَنَّةَ ، وَمَنْ لَمْ يَأْتِ بِهِنَّ لَيْسَ لَهُ عِنْدَ اللَّهِ عَهْدٌ ، إِنْ شَاءَ غَفَرَ لَهُ ، وَإِنْ شَاءَ عَذَّبَهُ ""","","","","","Book of Prayer"
"4426","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، قَالَ : قُلْتُ لإِبْرَاهِيمَ : فِي ابْنَةِ سِتِّ سِنِينَ أَوْ خَمْسٍ : أَتَأْمُرُهَا بِالْوِتْرِ ؟ قَالَ : رَكْعَتَانِ بَعْدَ الْعِشَاءِ ، كَانَ يُقَالُ \" الْوِتْرُ عَلَى أَهْلِ الْقُرْآنِ ""","","","","","Book of Prayer"
"4427","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمَّارٍ الدُّهْنِيِّ ، عَنْ سَالِمِ بْنِ أَبِي الْجَعْدِ ، قَالَ : قَالَ حُذَيْفَةُ بْنُ الْيَمَانِ : \" لا وِتْرَ إِلا عَلَى مَنْ تَلا الْقُرْآنَ ""","","","","","Book of Prayer"
"4428","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، قَالَ : أَخْبَرَنِي مُخْبِرٌ ، عَنِ ابْنِ عُمَرَ ، قَالَ : \" مَا أُحِبُّ أَنِّي تَرَكْتُ الْوِتْرَ لَيْلَةً ، وَلِي حُمُرُ النَّعَمِ ""","","","","","Book of Prayer"
"4429","عَنْ مَعْمَرٍ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّ اللَّهَ وِتْرٌ يُحِبُّ الْوِتْرَ ، فَمَنْ لَمْ يُوتِرْ فَلَيْسَ مِنَّا ""","","","","","Book of Prayer"
"4430","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : كَانَ أَبُو هُرَيْرَةَ ، يَقُولُ : \" إِنَّ اللَّهَ وِتْرٌ يُحِبُّ الْوِتْرَ ""","","","","","Book of Prayer"
"4431","قَالَ أَيُّوبُ ، أَوْ غَيْرُهُ \" فَكَانَ ابْنُ سِيرِينَ يَسْتَحِبُّ الْوِتْرَ مِنْ كُلِّ شَيْءٍ ، حَتَّى إِنْ كَانَ لَيَأْكُلُ وِتْرًا ""","","","","","Book of Prayer"
"4432","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : حدَّثَنِي عَبْدُ الْكَرِيمِ \" أَنَّ عَلِيًّا كَانَ يُحَقِّقُ الْوِتْرَ ""","","","","","Book of Prayer"
"4433","عَنِ الْمُثَنَّى ، قَالَ : أَخْبَرَنِي عَمْرُو بْنُ شُعَيْبٍ ، قَالَ : خَرَجَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى أَصْحَابِهِ ، فَقَالَ : \" إِنَّ اللَّهَ زَادَكُمْ صَلاةً إِلَى صَلاتِكُمْ ، فَحَافِظُوا عَلَيْهَا ، وَهِيَ الْوِتْرُ \" ، وَذَكَرَهُ ابْنُ جُرَيْجٍ ، عَنِ الْمُثَنَّى ، عَنْ عَمْرِو بْنِ شُعَيْبٍ","","","","","Book of Prayer"
"4434","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ، عَنْ مُجَاهِدٍ وَاجِبٌ الْوِتْرُ \" ، وَلَمْ يَكْتُبْ , وَقَالَهُ عَنِ ابْنِ جُرَيْجٍ ، عَنْ مُجَاهِدٍ","","","","","Book of Prayer"
"4435","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ أَنَّهُ كَانَ يُوجِبُ الْوِتْرَ ، وَيَقُولُ : \" مَنْ فَاتَهُ الْوِتْرُ حَتَّى يُصْبِحَ ، فَلْيُوتِرْ حِينَ يَذْكُرُ ""","","","","","Book of Prayer"
"4436","عَنِ الثَّوْرِيِّ ، عَنْ لَيْثٍ ، عَنْ طَاوُسٍ ، قَالَ \" يُقْضَى الْوِتْرُ ""","","","","","Book of Prayer"
"4437","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ ، قَالَ \" الْوِتْرُ وَاجِبٌ يُعَادُ إِلَيْهِ إِذَا نُسِيَ ""","","","","","Book of Prayer"
"4438","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالَ \" تُصَلِّي الْوِتْرَ ، وَإِنْ صَلَّيْتَ الصُّبْحَ \" ، قَالَ الثَّوْرِيُّ : \" فَمَنْ نَسِيَ الْعِشَاءَ ، وَصَلَّى الْوِتْرَ بَعْدَ أَنْ غَابَ الشَّفَقُ \" ، قَالَ : \" يُصَلِّي الْعِشَاءَ إِذَا ذَكَرَهَا ، وَلا يُعِيدُ الْوِتْرَ ""","","","","","Book of Prayer"
"4439","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي نَضْرَةَ ، عَنْ أَبِي سَعِيدٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَوْتِرُوا قَبْلَ أَنْ تُصْبِحُوا ""","","","","","Book of Prayer"
"4440","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، قَالَ : سَمِعْتُ سَعِيدَ بْنَ جُبَيْرٍ سُئِلَ عَنْ رَجُلٍ لَمْ يُوتِرْ حَتَّى أَصْبَحَ ؟ فَقَالَ \" سَوْفَ يُوتِرُ الْيَوْمَ الآخَرَ ""","","","","","Book of Prayer"
"4441","عَنْ جَعْفَرٍ ، عَنْ سُلَيْمَانَ ، عَنْ أَبِي هَارُونَ الْعَبْدِيِّ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ : لا أَعْلَمُهُ قَالَ : إِلا رَفَعَهُ ، قَالَ : \" مَنْ أَدْرَكَهُ الْفَجْرُ , وَلَمْ يُوتِرْ ، فَلا وِتْرَ لَهُ ""","","","","","Book of Prayer"
"4442","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، سُئِلَ عَنْ رَجُلٍ لَمْ يُوتِرْ حَتَّى فَجَرَ الْفَجْرُ ؟ قَالَ : \" قَدْ فَاتَهُ الْوِتْرُ فَلا يُوتِرُ \" ، قِيلَ لَهُ : أَعِلْمٌ أَمْ رَأْيٌ ؟","","","","","Book of Prayer"
"4443","فَحَدَّثَ حُمَيْدٌ ، عَنْ سُلَيْمَانَ أَوْ مِينَاءَ ، عَنِ ابْنِ عُمَرَ ، قَالَ \" إِنَّمَا هُمَا رَكْعَتَانِ ، إِذَا طَلَعَ الْفَجْرُ لا صَلاةَ إِلا رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4444","ثُمَّ أَخْبَرَنِي بَعْدَ ذَلِكَ , أَنَّ ابْنَ عَبَّاسٍ ، قَالَ لِغُلامٍ لَهُ : انْظُرْ , أَضَاءَ الْفَجْرُ ؟ فَرَجَعَ إِلَيْهِ , فَقَالَ : النَّاسُ فِي الصَّلاةِ ، فَقَامَ ابْنُ عَبَّاسٍ ، فَأَوْتَرَ بِرَكْعَةٍ ، ثُمَّ رَكَعَ رَكْعَتَيْنِ قَبْلَ الصُّبْحِ ، وَحَدِيثُ قَتَادَةَ ، عَنِ ابْنِ عَبَّاسٍ فِي تَفْرِيطِ الصَّلَوَاتِ","","","","","Book of Prayer"
"4445","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، قَالَ \" إِذَا صَلَّيْتَ الْفَجْرَ فَلا وِتْرَ ""","","","","","Book of Prayer"
"4446","عَنْ عَبْدِ اللَّهِ بْنِ مُحَرَّرٍ ، عَنْ قَتَادَةَ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \" أَوْتِرْ مَا لَمْ تَطْلُعِ الشَّمْسُ ""","","","","","Book of Prayer"
"4447","عَنْ مَعْمَرٍ ، عَنِ الْحَسَنِ ، وَقَتَادَةَ ، قَالا : \" لا وِتْرَ بَعْدَ صَلاةِ الصُّبْحِ ""","","","","","Book of Prayer"
"4448","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، عَنْ عَطَاءٍ ، أَنَّ ابْنَ عَبَّاسٍ \" أَوْتَرَ بَعْدَ طُلُوعِ الْفَجْرِ ""","","","","","Book of Prayer"
"4449","عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالَ \" تُصَلِّي الْوِتْرَ ، وَإِنْ صَلَّيْتَ الصُّبْحَ \" ، عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ مِثْلَهُ","","","","","Book of Prayer"
"4450","عَنِ الثَّوْرِيِّ ، عَنْ أَشْعَثَ ، وَابْنُ عَوْنٍ ، عَنِ الشَّعْبِيِّ ، قَالَ \" أَوْتِرْ وَلَوْ نِصْفَ النَّهَارِ إِذَا نَسِيتَ ""","","","","","Book of Prayer"
"4451","وَذَكَرَ الثَّوْرِيُّ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي السَّفَرِ ، عَنِ الشَّعْبِيِّ ، قَالَ \" الْوِتْرُ أَشْرَفُ التَّطَوُّعِ ، لا يَصْلُحُ تَرْكُهُ ، وَلا يُقْضَى ""","","","","","Book of Prayer"
"4452","عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ ، قَالَ \" أَوْتِرْ ، وَإِنْ طَلَعَتِ الشَّمْسُ ""","","","","","Book of Prayer"
"4453","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، قَالَ : جَاءَ نَفَرٌ إِلَى أَبِي مُوسَى الأَشْعَرِيِّ ، فَسَأَلُوهُ عَنِ الْوِتْرِ ؟ فَقَالَ \" لا وِتْرَ بَعْدَ الأَذَانِ \" ، فَأَتَوْا عَلِيًّا ، فَأَخْبَرُوهُ ، فَقَالَ : \" لَقَدْ أَغْرَقَ فِي النَّزْعِ ، وَأَفْرَطَ فِي الْفُتْيَا ، الْوِتْرُ مَا بَيْنَكَ وَبَيْنَ صَلاةِ الْغَدَاةِ ""","","","","","Book of Prayer"
"4454","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، قَالَ : جَاءَ رَجُلٌ إِلَى عَلِيٍّ ، فَقَالَ : إِنَّ أَبَا مُوسَى ، يَقُولُ : \" لا وِتْرَ بَعْدَ الأَذَانِ \" ، فَقَالَ لَهُ عَلِيٌّ : \" لَقَدْ أَغْرَقَ النَّزْعَ ، وَأَفْرَطَ الْفُتْيَا ، الْوِتْرُ مَا بَيْنَ الصَلاتَيْنِ ""","","","","","Book of Prayer"
"4455","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أُخْبِرْتُ ، عَنْ أَبِي الدَّرْدَاءِ ، قَالَ : لا وِتْرَ لِمَنْ أَدْرَكَهُ الصُّبْحُ ، فَذُكِرَ ذَلِكَ لِعَائِشَةَ ، فَقَالَتْ : كَذَبَ أَبُو الدَّرْدَاءِ ، \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصْبِحُ فَيُوتِرُ ""","","","","","Book of Prayer"
"4456","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، أَنَّ ابْنَ مَسْعُودٍ ، قَالَ : \" الْوِتْرُ مَا بَيْنَ الصَّلاتَيْنِ ""","","","","","Book of Prayer"
"4457","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ، وَأَبِي حُصَيْنٍ ، عَنِ الأَسْوَدِ بْنِ هِلالٍ ، قَالَ : قَالَ عَبْدُ اللَّهِ : الْوِتْرُ مَا بَيْنَ الصَّلاتَيْنِ \" ، عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ بْنِ هِلالٍ ، عَنْ عَبْدِ اللَّهِ ، مِثْلَ ذَلِكَ","","","","","Book of Prayer"
"4458","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ خَالِدِ بْنِ أَبِي كَرِيمَةَ ، قَالَ : سَمِعْتُ مُعَاوِيَةَ بْنَ قُرَّةَ ، يَقُولُ : أَتَى رَجُلٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنِّي لَمْ أُوتِرْ حَتَّى أَصْبَحْتُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّمَا الْوِتْرُ بِاللَّيْلِ ، فَأَعَادَ عَلَيْهِ فَأَمَرَهُ أَنْ يُوتِرَ ""","","","","","Book of Prayer"
"4459","عَنِ الثَّوْرِيِّ ، عَنْ آدَمَ بْنِ عَلِيٍّ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ ، يَقُولُ : \" مَنْ أَصْبَحَ عَلَى غَيْرِ وِتْرٍ ، أَصْبَحَ عَلَى رَأْسِهِ جَرِيرٌ قَدْرَ سَبْعِينَ ذِرَاعًا ""","","","","","Book of Prayer"
"4460","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ أَبِي نَضْرَةَ ، قَالَ : احْتُبِسَ سَعْدُ بْنُ أَبِي وَقَّاصٍ يَوْمًا عَنِ الصَّلاةِ ، فَقِيلَ لَهُ : أَبْطَأْتَ عَلَى النَّاسِ ، فَقَالَ لَهُ : \" أَدْرَكَنِي الصُّبْحُ ، قَبْلَ أَنْ أُوتِرَ فَأَوْتَرْتُ ""","","","","","Book of Prayer"
"4461","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ عَاصِمِ بْنِ عُبَيْدِ اللَّهِ ابْنِ عَاصِمٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ ، قَال : \" رُبَّمَا أَوْتَرَ وَإِنَّهُ يَسْمَعُ الإِقَامَةَ ""","","","","","Book of Prayer"
"4462","عَنِ الثَّوْرِيِّ ، عَنِ الزُّبَيْرِ بْنِ عَدِيٍّ ، عَنْ إِبْرَاهِيمَ ، قَالَ \" سَأَلْتُ عُبَيْدَةَ عَنِ الرَّجُلِ يَسْتَيْقِظُ عِنْدَ الإِقَامَةِ ، وَلَمْ يُوتِرْ ؟ قَالَ : يُوتِرُ ""","","","","","Book of Prayer"
"4463","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، أَنَّ رَجُلا سَأَلَ ابْنَ عُمَرَ عَنِ الْوِتْرِ ؟ فَقَالَ \" بَيْنَا ابْنُ عُمَرَ يَطُوفُ بِالْبَيْتِ لَيْلَةً ، فَاجَأَهُ الصُّبْحُ فَأَوْتَرَ ""","","","","","Book of Prayer"
"4464","عَنِ ابْنِ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" إِذَا طَلَعَ الْفَجْرُ , فَقَدْ ذَهَبَ كُلُّ صَلاةِ اللَّيْلِ وَالْوِتْرِ ، فَأَوْتِرُوا قَبْلَ الْفَجْرِ ""","","","","","Book of Prayer"
"4465","عَنْ مَعْمَرٍ ، عَنِ الأَعْمَشِ ، عَنْ تَمِيمِ بْنِ سَلَمَةَ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي مِنَ اللَّيْلِ فَإِذَا انْصَرَفَ ، قَالَ لِي : \" قُومِي ، فَأَوْتِرِي ""","","","","","Book of Prayer"
"4466","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ ، عَنِ ابْنِ الْمُسَيِّبِ ، أَنَّ أَبَا بَكْرٍ ، وَعُمَرَ ، تَذَاكَرَا الْوِتْرَ عِنْدَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ أَبُو بَكْرٍ : \" أَمَّا أَنَا فَأَنَامُ عَلَى وِتْرٍ ، فَإِنِ اسْتَيْقَظْتُ صَلَّيْتُ شَفْعًا حَتَّى الصَّبَاحِ \" ، وَقَالَ عُمَرُ : \" لَكِنِّي أَنَامُ عَلَى شَفْعٍ ، ثُمَّ أُوتِرُ مِنَ السَّحَرِ \" ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لأَبِي بَكْرٍ : \" حَذِرَ هَذَا \" ، وَقَالَ لِعُمَرَ : \" قَوِيَ هَذَا ""","","","","","Book of Prayer"
"4467","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنَّ أَبَا بَكْرٍ كَانَ يُوتِرُ أَوَّلَ اللَّيْلِ ، وَعُمَرُ آخِرَ اللَّيْلِ ، فَسَأَلَهُمَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، عَنْ وِتْرِهِمَا ؟ فَأَخْبَرَاهُ ، فَقَالَ : \" قَوِيَ هَذَا ، وَحَذِرَ هَذَا \" ، قَالَ : وَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَضْرِبُ لَكُمَا مَثَلَ رَجُلَيْنِ أَخَذَا فِي مَفَازَةٍ لَيْلا ، فَقَالَ أَحَدُهُمَا : مَا أُرِيدُ أَنْ أَنَامَ حَتَّى أقْطَعَهَا ، وَقَالَ الآخَرُ : أَنَامُ نَوْمَةً , ثُمَّ أَقُومُ فَأَقْطَعُهَا ، فَأصْبَحَا فِي الْمَنْزِلِ جَمِيعًا ""","","","","","Book of Prayer"
"4468","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرنِي مُحَمَّدُ بْنُ يُوسُفَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ لأَبِي بَكْرٍ : \" مَتَى تُوتِرُ ؟ قَالَ : قَبْلَ أَنْ أَرْقُدَ ، قَالَ : قَدْ أَخَذْتَ بِالْوُثْقَى ، وَقَالَ لِعُمَرَ : مَتَى تُوتِرُ ؟ قَالَ : آخِرَ اللَّيْلِ حِينَ أَفْرُغَ مِنْ صَلاتِي ، قَالَ : فِعْلُ ذَوِي الْقُوَّةِ فَعَلْتَ ""","","","","","Book of Prayer"
"4469","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : \" أَوْصَانِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، بِثَلاثٍ لَسْتُ بِتَارِكِهِنَّ فِي حَضَرٍ وَلا سَفَرٍ : نَوْمٍ عَلَى وِتْرٍ ، وَصِيَامِ ثَلاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ ، وَرَكْعَتَيِ الضُّحَى \" ، قَالَ : ثُمَّ أَوَهِمَ الْحَسَنُ بَعْدَ ذَلِكَ ، فَجَعَلَ مَكَانَ رَكْعَتَيِ الضُّحَى : \" غُسْلَ يَوْمِ الْجُمُعَةِ ""","","","","","Book of Prayer"
"4470","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّ أَبَا بَكْرٍ ، كَانَ يُوتِرُ أَوَّلَ اللَّيْلِ ، يَقُولُ : \" وَاحَرَّ وَاسِعِي النَّوَافِلِ ""","","","","","Book of Prayer"
"4471","عَنْ مَعْمَرٍ ، عَنْ أَبِي عَمْرٍو النَّدَبِيِّ ، قَالَ : سَمِعْتُ رَافِعَ بْنَ خَدِيجٍ ، يُسْأَلُ عَنِ الْوِتْرِ ؟ فَقَالَ : \" أَمَّا أَنَا فَإِنِّي أُوتِرُ مِنْ أَوَّلِ اللَّيْلِ ، فَإِنْ رُزِقْتُ شَيْئًا مِنْ آخِرِهِ ، صَلَّيْتُ رَكْعَتَيْنِ رَكْعَتَيْنِ حَتَّى أُصْبِحَ \" ، أَوْ قَالَ : \" حَتَّى يُدْرِكَنِي الصُّبْحُ ""","","","","","Book of Prayer"
"4472","عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ ، عَنْ مَالِكِ بْنِ دِينَارٍ ، قَالَ : حَدَّثَنَا خِلاسُ بْنُ عَمْرٍو ، قَالَ : كُنْتُ جَالِسًا عِنْدَ عَمَّارِ بْنِ يَاسِرٍ فَسَأَلَهُ رَجُلٌ ، فَقَالَ : يَا أَبَا الْيَقْظَانِ ، كَيْفُ تَقُولُ فِي الْوِتْرِ ؟ فَقَالَ عَمَّارٌ : \" أَمَّا أَنَا فَأُوتِرُ قَبْلَ أَنْ أَنَامَ ، فَإِنْ رَزَقَنِي اللَّهُ شَيْئًا ، صَلَّيْتُ شَفْعًا شَفْعًا حَتَّى الصُّبْحِ ""","","","","","Book of Prayer"
"4473","عَنْ مَالِكٍ ، وَابْنِ زَيْدِ بْنِ أَسْلَمَ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ أَبِي مُرَّةَ مَوْلَى عَقِيلٍ ، قَالَ : سَأَلْتُ أَبَا هُرَيْرَةَ ، فَقُلْتُ حدِّثْنِي كَيْفَ كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُوتِرُ ؟ فَسَكَتَ ، ثُمَّ سَأَلْتُهُ الثَّانِيَةَ ، فَسَكَتَ ، ثُمَّ سَأَلْتُهُ الثَّالِثَةَ ، فَقَالَ : إِنْ شِئْتَ حَدَّثْتُكَ عَنْ أَبِي هُرَيْرَةَ ، أَمَّا أَنَا ، فَأُوتِرُهَا هُنَا بِخَمْسٍ ، ثُمَّ أَرْجِعُ فَأَرْقُدُ ، فَإِنِ اسْتَيْقَظْتُ صَلَّيْتُ شَفْعًا حَتَّى أُصْبِحَ","","","","","Book of Prayer"
"4474","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي سُفْيَانَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا سَجَدَ أَحَدُكُمْ فَلْيَعْتَدِلْ ، وَلا يَفْتَرِشْ ذَرَاعَيْهِ افْتِرَاشَ الْكَلْبِ ""","","","","","Book of Prayer"
"4475","قَالَ : وَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَنْ خَافَ مِنْكُمْ أَنْ لا يَسْتَيْقِظَ مِنْ آخِرِ اللَّيْلِ ، فَلْيُوتِرْ مِنْ أَوَّلِ اللَّيْلِ ، وَمَنْ طَمِعَ مِنْكُمْ أَنَّ يَسْتَيْقِظَ مِنْ آخِرِ اللَّيْلِ ، فَلْيُوتِرْ مِنْ آخِرِ اللَّيْلِ ، فَإِنَّ قِرَاءَةَ آخِرِ اللَّيْلِ مَحْضُورَةٌ ، وَذَلِكَ أَفْضَلُ ""","","","","","Book of Prayer"
"4476","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي الضُّحَى ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَةَ ، قَالَتْ : \" كُلَّ اللَّيْلِ قَدْ أَوْتَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، مِنْ أَوَّلِهِ وَأَوْسَطِهِ , وَآخِرِهِ ، وَانْتَهَى وِتْرُهُ إِلَى السَّحَرِ ""","","","","","Book of Prayer"
"4477","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ \" أَنَّهُ كَانَ يُوتِرُ عِنْدَ الأَذَانِ ""","","","","","Book of Prayer"
"4478","وَذَكَرَهُ الْحَسَنُ بْنُ عُمَارَةَ ، عَنْ إِسْرَائِيلَ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَنَّهُ كَانَ يُوتِرُ عِنْدَ الأَذَانِ ""","","","","","Book of Prayer"
"4479","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ ، قَالَ : سَأَلْتُهُ وَكَانَ يَبِيتُ عِنْدَ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ ، مَتَى كَانَ عَبْدُ اللَّهِ يُوتِرُ ؟ قَالَ : \" كَانَ يُوتِرُ حِينَ يَبْقَى عَلَيْهِ مِنَ اللَّيْلِ مِثْلُ مَا ذَهَبَ مِنَ اللَّيْلِ حِينَ صَلَّى الْمَغْرِبَ ، قَالَ : وَكَانَ عَبْدُ اللَّهِ يَسْمَعُ قِرَاءَتَهُ أَهْلُ الدَّارِ مِنَ اللَّيْلِ","","","","","Book of Prayer"
"4480","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الأَسْوَدِ بْنِ يَزِيدَ ، قَالَ : \" سَأَلْتُ عَائِشَةَ : مَتَى تُوتِرِينَ ؟ قَالَتْ : بَيْنَ الأَذَانِ وَالإِقَامَةِ ، قَالَ : وَمَا يُؤَذِّنُونَ حَتَّى يُصبِحُوا ""","","","","","Book of Prayer"
"4481","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : سُئِلَ عَنِ الْوِتْرِ ، فَقَالَ \" وِتْرُ الأَكْيَاسِ أَوَّلَ اللَّيْلِ ، وَوِتْرُ الأَقْوِيَاءِ آخِرَ اللَّيْلِ \" ، قُلْتُ : فَكَيْفَ تَصْنَعُ ؟ قَالَ : \" أَمَّا أَنَا إِنِ اسْتَطَعْتُ أَنْ أَكُونَ مِنَ الأَكْيَاسِ كُنْتُ ""","","","","","Book of Prayer"
"4482","عَنِ الثَّوْرِيِّ ، عَنْ عَاصِمِ بْنِ أَبِي النَّجُودِ ، عَنْ أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ، قَالَ : خَرَجَ عَلِيٌّ حِينَ ثَوَّبَ ابْنُ النَّبَّاحِ ، فَقَالَ : \"  وَاللَّيْلِ إِذَا عَسْعَسَ { 17 } وَالصُّبْحِ إِذَا تَنَفَّسَ { 18 } ، نِعْمَ سَاعَةُ الْوِتْرِ هَذِهِ ، أَيْنَ السَّائِلُونَ عَنِ الْوِتْرِ ؟ ""","","","","","Book of Prayer"
"4483","عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَبْدِ خَيْرٍ ، قَالَ : خَرَجَ عَلَيْنَا عَلِيٌّ حِينَ طَلَعَ الْفَجْرُ ، فَقَالَ \"  وَاللَّيْلِ إِذَا عَسْعَسَ ، وَأَشَارَ بِيَدِهِ إِلَى الْمَشْرِقِ ، ثُمَّ قَالَ : أَيْنَ السَّائِلُونَ عَنِ الْوِتْرِ ؟ نِعْمَ سَاعَةُ الْوِتْرِ هَذِهِ ""","","","","","Book of Prayer"
"4484","عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، قَالَ : \" كَانَ ابْنُ مَسْعُودٍ يُوتِرُ بَعْدَ الْفَجْرِ ، قَالَ : وَكَانَ أَبِي يُوتِرُ قَبْلَ الْفَجْرِ ""","","","","","Book of Prayer"
"4485","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عَطَاءِ بْنِ يَزِيدَ اللَّيْثِيِّ ، عَنْ أَبِي أَيُّوبَ الأَنْصَارِيِّ ، قَالَ : \" الْوِتْرُ حَقٌّ عَلَى كُلِّ مُسْلِمٍ ، فَمَنْ أَحَبَّ أَنْ يُوتِرَ بِخَمْسِ رَكَعَاتٍ فَلْيَفْعَلْ ، وَمَنْ أَحَبَّ أَنْ يُوتِرَ بِثَلاثٍ فَلْيَفْعَلْ ، وَمَنْ أَحَبَّ أَنْ يُوتِرَ بِوَاحِدَةٍ فَلْيَفْعَلْ ، وَمَنْ لَمْ يَسْتَطِعْ إِلا أَنْ يُومِئَ إِيمَاءً فَلْيَفْعَلْ \" ، عَنْ مَنْ سَمِعَ أَنَسًا يُحِدِّثُ مِثْلَ ذَلِكَ","","","","","Book of Prayer"
"4486","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ مَالِكِ بْنِ الْحَارِثِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ : \" وِتْرُ اللَّيْلِ كَوِتْرِ النَّهَارِ ، صَلاةُ الْمَغْرِبِ ثَلاثٌ \" قَوْلُ ابْنِ مَسْعُودٍ","","","","","Book of Prayer"
"4487","عَنْ مَعْمَرٍ ، عَنْ ثَابِتٍ الْبُنَانِيِّ ، قَالَ : صَلَّيْتُ مَعَ أَنَسٍ وَبِتُّ عِنْدَهُ ، قَالَ : \" فَرَأَيْتُهُ يُصَلِّي مَثْنَى مَثْنَى ، حَتَّى إِذَا كَانَ فِي آخِرِ صَلاتِهِ أَوْتَرَ بِثَلاثٍ مِثْلَ الْمَغْرِبِ ""","","","","","Book of Prayer"
"4488","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللَّهِ ، عَنْ عَمْرِو بْنِ مُرَّةَ ، عَنْ أَبِي عُبَيْدَةَ ، قَالَ : \" كَانَ عَبْدُ اللَّهِ يُوتِرُ بِثَلاثٍ فَأَعْلَى ""","","","","","Book of Prayer"
"4489","عَنْ مَعْمَرٍ ، وَالثَّوْرِيُّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، قَالَ \" الْوِتْرُ ثَلاثٌ ، وَخَمْسٌ ، وَسَبْعٌ ، وَتِسْعٌ ، وَإِحْدَى عَشْرَةَ ""","","","","","Book of Prayer"
"4490","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي إِسْمَاعِيلُ بْنُ مُحَمَّدِ بْنِ سَعْدِ بْنِ أَبِي وَقَّاصٍ ، أَنَّ سَعِيدَ بْنَ عُبَيْدِ بْنِ السَّبَّاقِ الثَّقَفِيَّ أَخْبَرَهُ ، أَنَّ عُمَرَ لَمَّا دَفَنَ أَبَا بَكْرٍ وَفرَغَ مِنْهُ ، وَقَدْ كَانَ صَلَّى صَلاةَ الْعِشَاءِ الآخِرَةِ ، أَوْتَرَ بِثَلاثِ رَكَعَاتٍ ، وَأَوْتَرَ مَعَهُ نَاسٌ مِنَ الْمُسْلِمِينَ ""","","","","","Book of Prayer"
"4491","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ \" ثَلاثُ رَكَعَاتٍ أَحَبُّ إِلَيَّ أَنْ أُوتِرَ بِهِنَّ مِنْ رَكْعَةٍ وَاحِدَةٍ ""","","","","","Book of Prayer"
"4492","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عُتْبَةُ بْنُ مُحَمَّدِ بْنِ الْحَارِثِ ، أَنَّ عِكْرِمَةَ مَوْلَى ابْنِ عَبَّاسٍ أَخْبَرَهُ ، قَالَ : وَفَدَ ابْنُ عَبَّاسٍ عَلَى مُعَاوِيَةَ بِالشَّامِ ، فَكَانَا يَسْمُرَانِ حَتَّى شَطْرِ اللَّيْلِ فَأَكْثَرَ ، قَالَ : فَشَهِدَ ابْنُ عَبَّاسٍ مَعَ مُعَاوِيَةَ الْعِشَاءَ الآخِرَةَ ذَاتَ لَيْلَةٍ فِي الْمَقْصُورَةِ ، فَلَمَّا فَرَغَ مُعَاوِيَةُ رَكَعَ رَكْعَةً وَاحِدَةً ، ثُمَّ لَمْ يَزِدْ عَلَيْهَا ، وَأَنَا أَنْظُرُ إِلَيْهِ ، قَالَ : فَجِئْتُ ابْنَ عَبَّاسٍ ، فَقُلْتُ لَهُ : أَلا أَضْحَكُ مِنْ مُعَاوِيَةَ ؟ صَلَّى الْعِشَاءَ , ثُمَّ أَوْتَرَ بِرَكْعَةٍ لَمْ يَزِدْ عَلَيْهَا ، قَالَ : أَصَابَ أَيْ بُنَيَّ ، لَيْسَ أَحَدٌ مِنَّا أَعْلَمُ مِنْ مُعَاوِيَةَ إِنَّمَا هِيَ وَاحِدَةٌ ، أَوْ خَمْسٌ ، أَوْ سَبْعٌ ، أَوْ أَكْثَرُ مِنْ ذَلِكَ ، يُوتِرُ بِمَا شَاءَ ، فَأَخْبَرْتُ عَطَاءً خَبَرَ عُتْبَةَ هَذَا ، فَقَالَ : إِنَّمَا سَمِعْنَا أَنَّهُ قَالَ : أَصَابَ ، أَوَ لَيْسَ الْمَغْرِبُ عَطَاءٌ الْقَائِلُ ثَلاثَ رَكَعَاتٍ ؟ ""","","","","","Book of Prayer"
"4493","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سُئِلَ عَطَاءٌ عَنْ رَكْعَةٍ يُوتِرُ فِيهَا ، قَالَ حَسَنٌ : بَلَغَنِي ، \" أَنَّ سَعْدَ بْنَ أَبِي وَقَّاصٍ ، كَانَ يُوتِرُ بِرَكْعَةٍ ""","","","","","Book of Prayer"
"4494","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرنِي أَبُو بَكْرِ بْنُ حَفْصِ بْنِ عُمَرَ بْنِ سَعْدِ بْنِ أَبِي وَقَّاصٍ ، قَالَ : \" كَانَ سَعْدٌ يُصَلِّي الْعِشَاءَ ، ثُمَّ يُوتِرُ بِرَكْعَةٍ وَاحِدَةٍ ""","","","","","Book of Prayer"
"4495","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنَّ سَعْدَ بْنَ أَبِي وَقَّاصٍ ، كَانَ يُصَلِّي بَعْدَهَا رَكْعَةً ، ثُمَّ يُوتِرُ بِهَا ، ثُمَّ يَنَامُ حَتَّى يَقُومَ مِنْ جَوْفِ اللَّيْلِ ، قَالَ مَعْمَرٌ : وَصَلَّيْتُ مَعَ ابْنِ سَعْدِ بْنِ أَبِي وَقَّاصٍ الْعِشَاءَ ، فَلَمَّا فَرَغَ مِنَ الْمَكْتُوبَةِ قَامَ فَصَلَّى رَكْعَةً ، فَقُلْتُ حِينَ انْصَرَفَ : أَوْهَمْتَ فِي صَلاتِكَ ؟ قَالَ : لا ، قُلْتُ : إِنَّكَ صَلَّيْتَ رَكْعَةً ، قَالَ : إِنَّا نَفْعَلُ ذَلِكَ أَهْلَ الْبَيْتِ ""","","","","","Book of Prayer"
"4496","عَنِ الثَّوْرِيِّ ، عَنْ عَطَاءِ بْنِ السَّائِبِ ، عَنْ أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ : \" أَنَّ سَعْدًا كَانَ يُوتِرُ بِرَكْعَةٍ ""","","","","","Book of Prayer"
"4497","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَزِيدَ بْنِ خُصَيْفَةَ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ شُرَحْبِيلَ ، يَقُولُ : \" رَأَيْتُ سَعْدَ بْنَ مَالِكٍ صَلَّى الْعِشَاءَ ، ثُمَّ صَلَّى بَعْدَهَا رَكْعَةً أَوْتَرَ بَعْدَهَا ""","","","","","Book of Prayer"
"4498","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ إِسْمَاعِيلَ بْنِ مُحَمَّدِ بْنِ سَعْدٍ ، قَالَ : سَمِعْتُ مُصْعَبَ بْنَ سَعْدِ بْنِ أَبِي وَقَّاصٍ ، يَقُولُ لِسَعْدٍ : إِنَّكَ تُوتِرُ بِرَكْعَةٍ وَاحِدَةٍ ، قَالَ : \" نَعَمْ ، أُخَفِّفُ عَلَى نَفْسِي ، ثَلاثٌ أَحَبُّ إِلَيَّ مِنْ وَاحِدَةٍ ، وَخَمْسٌ أَحَبُّ إِلَيَّ مِنْ ثَلاثٍ ، وَسَبْعٌ أَحَبُّ إِلَيَّ مِنْ خَمْسٍ ""","","","","","Book of Prayer"
"4499","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ الأَعْمَشِ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \" الْوِتْرُ سَبْعٌ أَوْ خَمْسٌ ، الثَّلاثُ بُتَيْرَاءُ ، وَإِنِّي لأَكْرَهُ أَنْ تَكُونَ بُتَيْرَاءَ ""","","","","","Book of Prayer"
"4500","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ \" ثَلاثٌ أَحَبُّ إِلَيَّ مِنْ وَاحِدَةٍ ، وَسَبْعٌ أَحَبُّ إِلَيَّ مِنْ خَمْسٍ ، وَمَا كَثُرَ فَهُوَ أَحَبُّ إِلَيَّ ""","","","","","Book of Prayer"
"4501","عَنِ الثَّوْرِيِّ ، قَالَ \" الْوِتْرُ رَكْعَةٌ ، وَثَلاثٌ ، وَخَمْسٌ ، وَسَبْعٌ ، وَتِسْعٌ ، وَإِحْدَى عَشْرَةَ فَأَعْجَبُهُنَّ إِلَيَّ الثَّلاثُ ""","","","","","Book of Prayer"
"4502","عَنْ رَجُلٍ ، عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ : قَالَ عَبْدُ اللَّهِ بْنُ مَسْعُودٍ لِسَعْدِ بْنِ أَبِي وَقَّاصٍ \" تُوتِرُ بِوَاحِدَةٍ ؟ قَالَ : أوَلَيْسَ إِنَّمَا الْوِتْرُ وَاحِدَةٌ ؟ فَقَالَ عَبْدُ اللَّهِ : بَلَى ، وَلَكِنْ ثَلاثٌ أَفْضَلُ ، قَالَ : فَإِنِّي لا أَزِيدُ عَلَيْهَا ، قَالَ : فَغَضِبَ عَبْدُ اللَّهِ ، فَقَالَ سَعْدٌ : أَتَغْضَبُ عَلَى أَنْ أُوتِرَ بِرَكْعَةٍ ، وَأَنْتَ تُوَرِّثُ ثَلاثَ جَدَّاتٍ ، أَفَلا تُوَرِّثُ حَوَّاءَ امْرَأَةَ آدَمَ ؟ \" أَخْبَرَنِيهِ يَحْيَى ، عَنِ الثَّوْرِيِّ","","","","","Book of Prayer"
"4503","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عُبَيْدِ اللَّهِ بْنِ أَبِي يَزِيدَ ، قَالَ : \" رَأَيْتُ مُعَاوِيَةَ صَلَّى الْعِشَاءَ ، ثُمَّ أَوْتَرَ بَعْدَهَا بِرَكْعَةٍ \" ، فَذَكَرْتُ ذَلِكَ لابْنِ عَبَّاسٍ ، فَقَالَ : \" أَصَابَ ""","","","","","Book of Prayer"
"4504","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي يَزِيدُ بْنُ خُصَيْفَةَ ، عَنِ السَّائِبِ بْنِ يَزِيدَ ، \" أَنَّ رَجُلا سَأَلَ عَبْدَ الرَّحْمَنِ بْنَ عُثْمَانَ التَّيْمِيَّ عَنْ صَلاةِ طَلْحَةَ بْنِ عُبَيْدِ اللَّهِ ، قَالَ : إِنْ شِئْتَ أَخْبَرْتُكَ عَنْ صَلاةِ عُثْمَانَ بْنِ عَفَّانَ ، قَالَ : نَعَمْ ، قَالَ : قُلْتُ : لأَغْلِبَنَّ اللَّيْلَةَ النَّفْرَ عَلَى الْحِجْرِ يُرِيدُ الْمَقَامَ ، قَالَ : فَلَمَّا قُمْتُ إِذَا رَجُلٌ يَزْحَمُنِي مُتَقَنِّعًا ، قَالَ : فَنَظَرْتُ فَإِذَا هُوَ عُثْمَانُ فَتَأَخَّرْتُ عَنْهُ ، فَصَلَّى ، فَإِذَا هُوَ يَسْجُدُ سُجُودَ الْقُرْآنِ ، حَتَّى إِذَا قُلْتُ : هَذَا هُوَ أَذَانُ الْفَجْرِ ، أَوْتَرَ بِرَكْعَةٍ لَمْ يُصَلِّ غَيْرَهَا ثُمَّ انْطَلَقَ ""","","","","","Book of Prayer"
"4505","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَزِيدَ بْنِ خُصَيْفَةَ ، عَنِ السَّائِبِ بْنِ يَزِيدَ ، عَنْ رَجُلٍ مِنْ قُرَيْشٍ ، قَالَ : \" كُنْتُ أُصَلِّي خَلْفَ الْمَقَامِ ، فَجَاءَ رَجُلٌ مُقَنَّعٌ فَقَرَأَ السَّبْعَ الطِّوِالَ ، ثُمَّ رَكَعَ رَكْعَتَيْنِ ، ثُمَّ انْفَتَلَ فَنَظَرْتُ ، فَإِذَا هُوَ عُثْمَانُ ""","","","","","Book of Prayer"
"4506","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ رَجُلٌ ، \" رَأَيْتُ عُثْمَانَ لَيْلَةً وَهُوَ يُصَلِّي ، حَتَّى إِذَا كَانَ فِي آخِرِ اللَّيْلِ ، أَوْتَرَ ، فَاتَّبَعْتُهُ لِنَنْظُرَ مَنْ هُوَ ، فَإِذَا هُوَ عُثْمَانُ ""","","","","","Book of Prayer"
"4507","عَنْ عَبْدِ اللَّهِ ، عَمَّنْ سَمِعَهُ ، عَنِ الْحَكَمِ ، قَالَ : قُلْتُ لِمِقْسَمٍ \" إِنِّي أُوتِرُ بِثَلاثٍ ، ثُمَّ أَخْرُجُ إِلَى الصُّبْحِ خَشْيَةَ أَنْ تَفُوتَنِي الصَّلاةُ ، فَكَرِهَ ذَلِكَ أَنْ يُوتِرَ إِلا بِخَمْسٍ أَوْ سَبْعٍ \" ، قُلْتُ : عَمَّنْ هَذَا ؟ قَالَ : عَنِ الثِّقَةِ ، عَنْ مَيْمُونَةَ ، وَعَائِشَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","","","","","Book of Prayer"
"4508","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : \" سَأَلَ إِنْسَانٌ عَطَاءً عَنْ أَدْنَى مَا يَكْفِي لِلْمُسَافِرِ ؟ قَالَ : رَكْعَةٌ وَاحِدَةٌ إِنْ شَاءَ ، قَالَ : قُلْتُ : فَالْمُقِيمُ ؟ قَالَ : وَرَكْعَةٌ تَكْفِيهِ إِنْ شَاءَ لَمْ يَزِدْ عَلَيْهِمَا ""","","","","","Book of Prayer"
"4509","عَنْ إِسْمَاعِيلَ بْنِ عَبْدِ اللَّهِ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : سَمَرَ عَبْدُ اللَّهِ بْنُ مَسْعُودٍ ، وَحُذَيْفَةُ بْنُ الْيَمَانِ عِنْدَ الْوَلِيدِ بْنِ عُقْبَةَ بْنِ أَبِي مُعَيْطٍ ، ثُمَّ خَرَجَا مِنْ عِنْدِهِ ، \" فَقَامَا يَتَحَادَثَانِ حَتَّى رَأَيَا تَبَاشِيرَ الْفَجْرِ ، فَأَوْتَرَ كُلُّ وَاحِدٍ مِنْهُمَا بِرَكْعَةٍ ""","","","","","Book of Prayer"
"4510","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ ، قَالَ : \" كَانَ أُبَيُّ بْنُ كَعْبٍ يُوتِرُ بِثَلاثٍ لا يُسَلِّمُ إِلا فِي الثَّالِثَةِ مِثْلَ الْمَغْرِبِ \" ، عَنْ هِشَامٍ ، عَنِ الْحَسَنِ ، عَنْ أَبِي مِثْلَهُ","","","","","Book of Prayer"
"4511","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عِمْرَانَ بْنِ مُوسَى ، عَنْ يَزِيدَ بْنِ خُصَيْفَةَ ، عَنِ السَّائِبِ بْنِ يَزِيدَ \" أَنَّ أُبَيَّ بْنَ كَعْبٍ كَانَ يُوتِرُ بِثَلاثٍ ""","","","","","Book of Prayer"
"4512","عَنْ مَعْمَرٍ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ أَنَّهُ : \" أَوْتَرَ بِثَلاثٍ ""","","","","","Book of Prayer"
"4513","عَنْ مَعْمَرٍ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ أَنَّهُ : \" أَوْتَرَ بِثَلاثٍ مِثْلَ الْمَغْرِبِ ""","","","","","Book of Prayer"
"4514","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : أَفْصِلُ بَيْنِ الْوِتْرِ وَبَيْنِ مَا قَبْلَهُ بِتَسْلِيمٍ ؟ قَالَ \" كَأَنَّكُمْ أَعْرَابٌ ، أَوَلَسْتَ تُسَلِّمُ تَسْلِيمَ الْفِرَاقِ ، كُلُّ شَيْءٍ فَهُوَ يَكْفِيكَ ، فَإِنْ شِئْتَ فَصَلِّ مِائَةَ رَكْعَةٍ ، أَوْ فَلا تَفْصِلْ بَيْنِ الْوِتْرِ وَبَيْنِ مَا قَبْلَهُ مِنَ الرُّكُوعِ \" ، قَالَ : قُلْتُ : وَالإِمَامُ أَيْضًا كَذَلِكَ فِي شَهْرِ رَمَضَانَ ؟ قَالَ : \" نَعَمْ ""","","","","","Book of Prayer"
"4515","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ يُوسُفَ ، عَنْ عُرْوَةَ \" أَنَّهُ أَوْتَرَ بِخَمْسٍ مَا جَلَسَ إِلا فِي الْوِتْرِ ""","","","","","Book of Prayer"
"4516","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَطَاءٌ \" أَنَّهُ رَأَى عُرْوَةَ بْنَ الزُّبَيْرِ ، أَوْتَرَ بِخَمْسٍ أَوْ سَبْعٍ مَا جَلَسَ لِلْمَثْنَى ""","","","","","Book of Prayer"
"4517","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ عَائِشَةَ ، \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُوتِرُ بِخَمْسٍ مَا يَقْعُدُ بَيْنَهُنَّ ""","","","","","Book of Prayer"
"4518","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنِ الْحَكَمِ ، عَنْ مِقْسَمٍ ، عَنْ أُمِّ سَلَمَةَ ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُوتِرُ بِخَمْسٍ أَوْ سَبْعٍ ، لا يَفْصِلُ بَيْنَهُنَّ بِكَلامٍ وَلا بِتَسْلِيمٍ ""","","","","","Book of Prayer"
"4519","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ أَنَّهُ كَانَ \" يُوتِرُ بِثَلاثٍ لا يَقْعُدُ بَيْنَهُنَّ ""","","","","","Book of Prayer"
"4520","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، \" أَنَّ ابْنَ عُمَرَ كَانَ يَأْمُرُ بِحَاجَتِهِ فِي رَكْعَتَيْنِ قَبْلَ الْوِتْرِ ""","","","","","Book of Prayer"
"4521","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ لَيْثٍ ، عَنْ عَطَاءٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : \" الْوِتْرُ مِثْلُ صَلاةِ الْمَغْرِبِ ، إِلا أَنَّهُ لا يُجْلَسُ إِلا فِي الثَّالِثَةِ ""","","","","","Book of Prayer"
"4522","عَنْ عَبْدِ اللَّهِ بْنِ مُحَرَّرٍ ، عَنْ قَتَادَةَ ، \" أَنَّ أَبَا مُوسَى الأَشْعَرِيَّ ، وَأَبَا هُرَيْرَةَ ، وَابْنَ عُمَرَ كَانُوا يُسَلِّمُونَ فِيهَا بَيْنَ الرَّكْعَتَيْنِ وَالْوِتْرِ ""","","","","","Book of Prayer"
"4523","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي نَافِعٌ ، عَنِ ابْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" مَنْ قَامَ مِنَ اللَّيْلِ ، فَلْيَجْعَلْ آخِرَهُ وِتْرًا قَبْلَ الصُّبْحِ ""","","","","","Book of Prayer"
"4524","عَنْ عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سُئِلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ صَلاةِ اللَّيْلِ ، فَقَالَ : \" مَثْنَى مَثْنَى ، فَإِذَا خِفْتَ الصُّبْحَ ، فَأَوْتِرْ بِوَاحِدَةٍ تُوتِرُ مَا قَبْلَهَا ""","","","","","Book of Prayer"
"4525","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنِ ابْنِ سِيرِينَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" صَلاةُ اللَّيْلِ مَثْنَى مَثْنَى ، وَالْوِتْرُ رَكْعَةٌ مِنْ آخِرِ اللَّيْلِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" الْمَغْرِبُ وِتْرُ صَلاةِ النَّهَارِ ، فَأَوْتِرُوا صَلاةَ اللَّيْلِ \" ، قَالَ هِشَامٌ ، وَقَالَ ابْنُ سِيرِينَ : مَا رَأَيْتُ أَحَدًا مِمَّنْ يُؤْخَذُ عَنْهُ يَرَى ، إِلا أَنَّ الْوِتْرَ مِنْ آخِرِ اللَّيْلِ أَفْضَلُ لِمَنْ أَطَاقَهُ","","","","","Book of Prayer"
"4526","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" صَلاةُ اللَّيْلِ مَثْنَى مَثْنَى ، وَالْوِتْرُ رَكْعَةٌ مِنْ آخِرِ اللَّيْلِ \" ، قَالَ : وَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" صَلاةُ الْمَغْرِبِ وِتْرُ النَّهَارِ ، فَأَوْتِرُوا صَلاةَ اللَّيْلِ ""","","","","","Book of Prayer"
"4527","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : حَدَّثَنِي ابْنُ شِهَابٍ ، عَنْ سَالِمِ بْنِ عَبْدِ اللَّهِ ، عَنْ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ رَجُلا سَأَلَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ صَلاةِ اللَّيْلِ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" صَلاةُ اللَّيْلِ مَثْنَى مَثْنَى ، فَإِذَا خِفْتَ الصُّبْحَ فَأَوْتِرْ بِوَاحِدَةٍ ""","","","","","Book of Prayer"
"4528","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" صَلاةُ اللَّيْلِ مَثْنَى مَثْنَى ، فَإِذَا خِفْتَ الصُّبْحَ فَأَوْتِرْ بِوَاحِدَةٍ ""","","","","","Book of Prayer"
"4529","عَنِ الثَّوْرِيِّ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ طَاوُسٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سُئِلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ صَلاةِ اللَّيْلِ ، فَقَالَ : \" مَثْنَى مَثْنَى ، فَإِذَا خِفْتَ الصُّبْحَ فَوَاحِدَةً ""","","","","","Book of Prayer"
"4530","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سُئِلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ صَلاةِ اللَّيْلِ ، فَقَالَ : \" يُصَلِّي أَحَدُكُمْ مَثْنَى مَثْنَى ، حَتَّى إِذَا خَشِيَ الصُّبْحَ أَوْتَرَ بِوَاحِدَةٍ ، تُوتِرُ لَهُ مَا قَدْ صَلَّى ""","","","","","Book of Prayer"
"4531","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" صَلاةُ اللَّيْلِ مَثْنَى مَثْنَى ، فَإِذَا خِفْتَ الصُّبْحَ ، فَأَوْتِرْ بِوَاحِدَةٍ ""","","","","","Book of Prayer"
"4532","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، \" أَنَّهُ كَانَ إِذَا نَامَ عَلَى وِتْرٍ ، ثُمَّ قَامَ يُصَلِّي مِنَ اللَّيْلِ ، صَلَّى رَكْعَةً إِلَى وِتْرِهِ فَيَشْفَعُ لَهُ ، ثُمَّ أَوْتَرَ بَعْدُ فِي آخِرِ صَلاتِهِ \" ، قَالَ الزُّهْرِيُّ : فَبَلَغَ ذَلِكَ ابْنَ عَبَّاسٍ فَلَمْ يُعْجِبْهِ ، فَقَالَ : \" إِنَّ ابْنَ عُمَرَ ، لَيُوتِرُ فِي اللَّيْلَةِ ثَلاثَ مَرَّاتٍ ""","","","","","Book of Prayer"
"4533","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ \" لا بَأْسَ أَنْ يُوتِرَ الرَّجُلُ ثُمَّ يَنَامُ ، فَإِذَا قَامَ مِنَ اللَّيْلِ ، شَفَعَ بِرَكْعَةٍ إِلَى وِتْرِهِ ، ثُمَّ يُوتِرُ فِي آخِرِ صَلاتِهِ \" ، قَالَ : وَكَانَ الْحَسَنُ يَكْرَهُ ذَلِكَ","","","","","Book of Prayer"
"4534","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنْ أَبِي هَارُونَ الْعَبْدِيِّ ، عَنْ حِطَّانَ الرَّقَاشِيِّ ، عَنْ عَلِيِّ بْنِ أَبِي طَالِبٍ ، قَالَ : \" إِنْ شِئْتَ إِذَا أَوْتَرْتَ قُمْتَ فَشَفَعْتَ بِرَكْعَةٍ ، ثُمَّ أَوْتَرْتَ بَعْدَ ذَلِكَ ، وَإِنْ شِئْتَ صَلَّيْتَ بَعْدَ الْوِتْرِ رَكْعَتَيْنِ ، وَإِنْ شِئْتَ أَخَّرْتَ الْوِتْرَ حَتَّى تُوتِرَ مِنْ آخِرِ اللَّيْلِ ""","","","","","Book of Prayer"
"4535","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ ، يَقُولُ : \" إِذَا أَوْتَرَ أَوَّلَ اللَّيْلِ ، فَلا يَشْفَعْ بِرَكْعَةٍ ، وَصَلَّى شَفْعًا حَتَّى يُصْبِحَ \" ، قَالَ : فَكَانَ عَطَاءٌ ، يُفْتِي يَقُولُ : \" إِذَا أَوْتَرَ مِنْ أَوَّلِ اللَّيْلِ ، ثُمَّ اسْتَيْقَظَ بَعْدُ ، فَلْيُصَلِّ شَفْعًا حَتَّى يُصْبِحَ ""","","","","","Book of Prayer"
"4536","عَنِ الثَّوْرِيِّ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ عَطَاءٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \" إِذَا أَوْتَرْتَ مِنْ أَوَّلِ اللَّيْلِ ، فَصَلِّ شَفْعًا حَتَّى تُصْبِحَ ""","","","","","Book of Prayer"
"4537","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَةَ ، عَنْ أَبِي عَطِيَّةَ ، عَنْ عَائِشَةَ ، قَالَ : ذُكِرَ لَهَا الرَّجُلُ يُوتِرُ ، ثُمَّ يَسْتَيْقِظُ ، فَيَشْفَعُ بِرَكْعَةٍ ، قَالَتْ : \" ذَلِكَ يَلْعَبُ بِوِتْرِهِ ""","","","","","Book of Prayer"
"4538","قَالَ : وَسَأَلْتُ عَائِشَةَ عَنِ الالْتِفَاتِ فِي الصَّلاةِ ، فَقَالَتْ : \" هُوَ اخْتِلاسٌ يخْتَلِسُهُ الشَّيْطَانُ مِنَ الصَّلاةِ ""","","","","","Book of Prayer"
"4539","عَنِ الثَّوْرِيِّ ، عَنِ الزُّبَيْرِ بْنِ عَدِيٍّ ، عَنْ إِبْرَاهِيمَ ، قَالَ : قُلْتُ لَهُ \" الرَّجُلُ يُوتِرُ مِنَ اللَّيْلِ ، ثُمَّ يَسْتَيْقِظُ وَعَلَيْهِ لَيْلٌ \" ، قَالَ حَسَنٌ : وَقَدْ كَانُوا يَسْتَحِبُّونَ أَنْ يَكُونَ آخِرُ صَلاتِهِمُ الْوِتْرَ","","","","","Book of Prayer"
"4540","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالَ : \" كَانَ إِذَا أَوْتَرَ مِنَ اللَّيْلِ ، صَلَّى شَفْعًا حَتَّى يُصْبِحَ ""","","","","","Book of Prayer"
"4541","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : \" كَانَ طَاوُسٌ إِذَا أَوْتَرَ مِنَ اللَّيْلِ لَمْ يَشْفَعْ ، صَلَّى شَفْعًا حَتَّى يُصْبِحَ ""","","","","","Book of Prayer"
"4542","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : \" كَانَ طَاوُسٌ إِذَا أَوْتَرَ مِنَ اللَّيْلِ لَمْ يَشْفَعْ ، وَرُبَّمَا أَوْتَرَ أَوَّلَهُ مَرَّةً وَاحِدَةً وَآخِرَهُ مَرَّةً أُخْرَى \" ، ذَكَرَهُ عَنْ أَبِيهِ","","","","","Book of Prayer"
"4543","عَنِ الثَّوْرِيِّ ، قَالَ : أَخْبَرَنِي ابْنُ قَيْسٍ الأَوْدِيُّ ، قَالَ : سَأَلْتُ عَمْرَو بْنَ مَيْمُونٍ الأَوْدِيَّ عَنْ نقْصِ الْوِتْرِ ؟ فَقَالَ \" إِذَا أَوْتَرْتَ ، ثُمَّ قُمْتَ مِنَ اللَّيْلِ ، فَاشْفَعْ بِرَكْعَةٍ \" ، قَالَ : فَذَكَرْتُ ذَلِكَ لِعَلْقَمَةَ ، فَقَالَ : \" إِنَّ عَمْرو لا يَدْرِي ، إِنَّمَا الْوِتْرُ وَاحِدَةٌ ، فَإِذَا أَوْتَرْتَ ، ثُمَّ اسْتَيْقَظْتَ مِنَ اللَّيْلِ ، فَصَلِّ شَفْعًا حَتَّى تُصْبِحَ ""","","","","","Book of Prayer"
"4544","عَنْ مَعْمَرٍ ، عَنْ شَيْخٍ ، عَنْ مَسْرُوقٍ ، أَنَّهُ قَالَ : \" إِذَا نَامَ عَلَى وِتْرٍ ، ثُمَّ اسْتَيْقَظَ ، صَلَّى شَفْعًا حَتَّى يُصْبِحَ \" ، وَحَدِيثُ عَمَّارٍ ، وَرَافِعِ بْنِ خَدِيجٍ ، وَأَبِي هُرَيْرَةَ ، وَأَبِي بَكْرٍ مِثْلُ هَذَا","","","","","Book of Prayer"
"4545","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنْ أَبِي مِجْلَزٍ ، عَنْ قَيْسِ بْنِ عَبَّادٍ ، قَالَ \" كَانَ إِذَا أَوْتَرَ وَعَلَيْهِ لَيْلٌ ، قَعَدَ يَقْرَأُ حَتَّى يُصْبِحَ ""","","","","","Book of Prayer"
"4546","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، عَنْ سَعِيدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَى ، عَنْ أَبِيهِ ، \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، كَانَ يُوتِرُ بِ سَبِّحِ اسْمَ رَبِّكَ الأَعْلَى ، وَ قُلْ يَأَيُّهَا الْكَافِرُونَ ، وَ قُلْ هُوَ اللَّهُ أَحَدٌ ""","","","","","Book of Prayer"
"4547","عَنِ الثَّوْرِيِّ ، عَنْ زُبَيْدٍ الْيَامِيِّ ، عَنْ ذَرِّ بْنِ عَبْدِ اللَّهِ الْمُرْهِبِيِّ ، عَنْ سَعِيدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَى ، عَنْ أَبِيهِ ، قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُوتِرُ بِ سَبِّحِ اسْمَ رَبِّكَ الأَعْلَى ، وَ قُلْ يَأَيُّهَا الْكَافِرُونَ ، وَ قُلْ هُوَ اللَّهُ أَحَدٌ ، فَإِذَا أَرَادَ أَنْ يَنْصَرِفَ مِنَ الْوِتْرِ ، قَالَ : سُبْحَانَ اللَّهِ الْمَلِكِ الْقُدُّوسِ ، ثَلاثَ مَرَّاتٍ ، ثُمَّ يَرْفَعُ صَوْتَهُ فِي الثَّالِثَةِ \" . عَنْ عَمْرِو بْنِ ذَرٍّ ، عَنْ أَبِيهِ ، عَنْ سَعِيدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِيهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","","","","","Book of Prayer"
"4548","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أُخْبِرْتُ ، عَنْ عَائِشَةَ ، \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقْرَأُ فِي الثَّلاثِ رَكَعَاتٍ الأَوَاخِرِ فِي الأُولَى : بِ سَبِّحِ اسْمَ رَبِّكَ الأَعْلَى ، وَفِي الثَّانِيَةِ : قُلْ يَأَيُّهَا الْكَافِرُونَ ، وَفِي الثَّالِثَةِ : قُلْ هُوَ اللَّهُ أَحَدٌ ، وَ قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ ، وَ قُلْ أَعُوذُ بِرَبِّ النَّاسِ ""","","","","","Book of Prayer"
"4549","عَنِ الثَّوْرِيِّ ، عَنْ سَلْمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ زَاذَانَ ، عَنْ عَلِيٍّ \" أَنَّهُ كَانَ يُوتِرُ بـ إِنَّا أَنْزَلْنَاهُ فِي لَيْلَةِ الْقَدْرِ ، وَ إِذَا زُلْزِلَتِ ، وَ قُلْ هُوَ اللَّهُ أَحَدٌ ""","","","","","Book of Prayer"
"4550","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، وَغَيْرُهُ عَنْ إِبْرَاهِيمَ \" أَنَّهُ كَانَ يَسْتَحِبُّ أَنْ يَقْرَأَ فِي الرَّكْعَةِ الآخِرَةِ مِنَ الْوِتْرِ : قُلْ هُوَ اللَّهُ أَحَدٌ ، وَ  آمَنَ الرَّسُولُ بِمَا أُنْزِلَ إِلَيْهِ مِنْ رَبِّهِ ""","","","","","Book of Prayer"
"4551","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، قَالَ \" اقْرَأْ فِيهِنَّ مَا شِئْتَ ، لَيْسَ فِيهِنَّ شَيْءٌ مَوْقُوتٌ ""","","","","","Book of Prayer"
"4552","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، وَغَيْرُهُ عَنْ إِبْرَاهِيمَ ، قَالَ \" تُكَبِّرْ ، إِذَا فَرَغْتَ مِنَ الْقِرَاءَةِ فِي الرَّكْعَةِ الآخِرَةِ مِنَ الْوِتْرِ ، ثُمَّ تَقْنُتْ وَتَرْفَعْ صَوْتَكَ ، ثُمَّ إِذَا أَرَدْتَ أَنْ تَرْكَعَ كَبَّرْتَ ""","","","","","Book of Prayer"
"4553","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ لِي عَطَاءٌ ، بَلَغَنِي ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، كَانَ يُوتِرُ بِثَلاثَ عَشْرَةَ رَكْعَةً ، فِيهَا رَكْعَتَانِ أَمَامَ الصُّبْحِ \" ، قُلْتُ : كَيْفَ كَانَ يُصَلِّيهِنَّ ؟ قَالَ : \" لا أَدْرِي ""","","","","","Book of Prayer"
"4554","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يُصَلِّي مِنَ اللَّيْلِ إِحْدَى عَشْرَةَ رَكْعَةً ، فَإِذَا فَجَرَ الْفَجْرُ صَلَّى رَكْعَتَيْنِ خَفِيفَتَيْنِ ، ثُمَّ اتَّكَى عَلَى شِقِّهِ الأَيْمَنِ حَتَّى يَأْتِيَهُ الْمُؤَذِّنُ يُؤْذِنُهُ لِلصَّلاةِ ""","","","","","Book of Prayer"
"4555","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : حَدَّثَنِي يَحْيَى بْنُ سَعِيدٍ ، عَنْ مَوْلَى لِلأَنْصَارِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ : قَالَ مُعَاذُ بْنُ جَبَلٍ : \" مَنْ يَتَقَدَّمُ فَيَسْتَقِي لَنَا ؟ قَالَ : قُلْتُ : أَنَا ، وَذَلِكَ مَرْجِعَهُمْ مِنَ الْحُدَيْبِيَةِ ، قَالَ جَابِرٌ : فَوَرَدْتُ أَثَايَةَ فَاسْتَقَيْتُ وَمَلأْتُ الْحَوْضَ ، فَوَرَدَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : \" أَتَسْقِي ؟ \" قُلْتُ : نَعَمْ ، بِأَبِي أَنْتَ ، فَسَقَى ثُمَّ أَخَذْتُ خِطَامَهُ أَوْ زِمَامَهُ ، فَعَمَدْتُ بِهِ إِلَى بَطْحَاءَ ، نَزَلَ بِهَا ، فَصَلَّى ثَلاثَ عَشْرَةَ رَكْعَةً ، وَأَنَا مَعَهُ إِلَى جَنْبِهِ بَعْدَ الْعِشَاءِ الآخِرَةِ ، قَالَ : حَسِبْتُ أَنَّهُ قَالَ : صَلَّى الْعِشَاءَ الآخِرَةَ ثُمَّ صَلاهَا ""","","","","","Book of Prayer"
"4556","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ عِكْرِمَةَ بْنِ خَالِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : كُنْتُ فِي بَيْتِ مَيْمُونَةَ ، \" فَقَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي مِنَ اللَّيْلِ ، فَقُمْتُ مَعَهُ عَلَى يَسَارِهِ ، فَأَخَذَ بِيَدِي فَجَعَلَنِي عَنْ يَمِينِهِ ، ثُمَّ صَلَّى ثَلاثَ عَشْرَةَ رَكْعَةً حَتَّى حَزَرْتُ قَدْرَ قِيَامِهِ فِي كُلِّ رَكْعَةٍ قَدْرَ يَأَيُّهَا الْمُزَّمِّلُ ""","","","","","Book of Prayer"
"4557","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنْ كُرَيْبٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \" نِمْتُ عِنْدَ خَالَتِي مَيْمُونَةَ بِنْتِ الْحَارِثِ ، فَقَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنَ اللَّيْلِ ، فَأَتَى الْحَاجَةَ ثُمَّ جَاءَ فَغَسَلَ وَجْهَهُ وَيَدَيْهِ ، ثُمَّ نَامَ ، ثُمَّ قَامَ مِنَ اللَّيْلِ فَأَتَى الْقِرْبَةَ فَأَطْلَقَ شِنَاقَهَا ، فَتَوَضَّأَ وُضُوءًا بَيْنَ الْوُضُوءَيْنِ لَمْ يُكْثِرْ وَقَدْ أَبْلَغَ ، ثُمَّ قَامَ يُصَلِّي فَتَمَطَّيْتُ كرَاهِيَةَ أَنْ يَرَى أَنِّي كُنْتُ أَبْغِيهِ يَعْنِي أُرَاقِبُهُ ، قَالَ : ثُمَّ قُمْتُ فَفَعَلْتُ كَمَا فَعَلَ ، فَقُمْتُ عَنْ يَسَارِهِ ، فَأَخَذَ بِمَا يَلِي أُذُنِي حَتَّى أَدَارَنِي فَكُنْتُ عَنْ يَمِينِهِ ، فَتَتَامَّتْ صَلاتُهُ إِلَى ثَلاثَ عَشْرَةَ رَكْعَةً مِنْهَا رَكْعَتَا الصُّبْحِ ، ثُمَّ اضْطَجَعَ فَنَامَ حَتَّى نَفَخَ ، ثُمَّ جَاءَ بِلالٌ فَآذَنَهُ بِالصَّلاةِ ، فَقَامَ فَصَلَّى وَلَمْ يَتَوَضَّأْ \" . قَالَ سُفْيَانُ : فَذُكِرَ لَنَا عَنِ ابْنِ عَبَّاسٍ ، أَنَّهُ ذُكِرَ لَهُ ذَلِكَ ، فَقَالَ : \" إِنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُحْفَظُ \" ، قَالَ : وَقَالَ بَعْضُ الْفُقَهَاءِ : \" النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تَنَامُ عَيْنُهُ ، وَلا يَنَامُ قَلْبُهُ ""","","","","","Book of Prayer"
"4558","وَزَادَنِي يَحْيَى ، عَنِ الثَّوْرِيِّ ، قَالَ ابْنُ عَبَّاسٍ : فَكَانَ فِي دُعَائِهِ ، يَقُولُ : \" اللَّهُمَّ اجْعَلْ فِي قَلْبِي نُورًا ، وَفِي سَمْعِي نُورًا ، وَفِي لِسَانِي نُورًا ، وَفِي بَصَرِي نُورًا ، وَعَنْ يَسَارِي نُورًا ، وَمِنْ فَوْقِي نُورًا ، وَمِنْ تَحْتِي نُورًا ، وَمِنْ بَيْنِ يَدَيَّ نُورًا ، وَمِنْ خَلْفِي نُورًا ، وَأَعْظِمْ لِي نُورًا \" ، قَالَ كُرَيْبٌ : وَسِتٌّ عِنْدِي فِي التَّابُوتِ : وَعَصَبِي ، وَمُخِّي ، وَدَمِي ، وَشَعْرِي ، وَبَشَرِي ، وَعِظَامِي","","","","","Book of Prayer"
"4559","أَخْبَرَنَا مَالِكٌ ، عَنْ مَخْرَمَةَ بْنِ سُلَيْمَانَ ، عَنْ كُرَيْبٍ ، أَنَّ ابْنَ عَبَّاسٍ ، أَخْبَرَهُ ، \" أَنَّهُ بَاتَ عِنْدَ خَالَتِهِ مَيْمُونَةَ ، قَالَ : فَاضْطَجَعْتُ فِي عَرْضِ الْوِسَادَةِ ، وَاضْطَجَعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَهْلُهُ فِي طُولِهَا ، فَبَاتَ حَتَّى انْتَصَفَ اللَّيْلُ ، أَوْ قَبْلَهُ بِقَلَيْلٍ ، أَوْ بَعْدَهُ بِقَلَيْلٍ ، ثُمَّ اسْتَيْقَظَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَجَلَسَ فَمَسَحَ النَّوْمَ عَنْ وَجْهِهِ ، ثُمَّ قَرَأَ الْعَشْرَ الآيَاتِ الْخَوَاتِمَ مِنْ سُورَةِ آلِ عِمْرَانَ ، ثُمَّ قَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى شَنٍّ مُعَلَّقَةٍ ، فَتَوَضَّأَ ، فَأَحْسَنَ الْوُضُوءَ ، ثُمَّ قَامَ فَصَلَّى ، فَقُمْتُ ، فَصَنَعْتُ مِثْلَ مَا صَنَعَ ، ثُمَّ ذَهَبْتُ إِلَى جَنْبِهِ ، فَوَضَعَ يَدَهُ عَلَى رَأْسِي وَأَخَذَ بِأُذُنِي يَفْتِلُهَا ، فَصَلَّى رَكْعَتَيْنِ ، ثُمَّ رَكْعَتَيْنِ ، ثُمَّ رَكْعَتَيْنِ ، ثُمَّ أَوْتَرَ ، ثُمَّ اضْطَجَعَ حَتَّى جَاءَهُ الْمُؤَذِّنُ ، ثُمَّ قَامَ فَصَلَّى رَكْعَتَيْنِ خَفِيفَتَيْنِ ، ثُمَّ خَرَجَ فَصَلَّى الصُّبْحَ ""","","","","","Book of Prayer"
"4560","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي مُلَيْكَةَ ، قَالَ : أَخْبَرَنِي يَعْلَى بْنُ مَمْلَكٍ ، أَنَّهُ سَأَلَ أُمَّ سَلَمَةَ زَوْجَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ صَلاةِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِاللَّيْلِ ، فَقَالَتْ : \" كَانَ يُصَلِّي الْعِشَاءَ الآخِرَةَ ، ثُمَّ يُسَبِّحُ ، ثُمَّ يُصَلِّي بَعْدَهَا مَا شَاءَ مِنَ اللَّيْلِ ، ثُمَّ يَنْصَرِفُ فَيَرْقُدُ مِثْلَ مَا صَلَّى ، ثُمَّ يَسْتَيْقِظُ مِنْ نَوْمَتِهِ تِلْكَ فَيُصَلِّي مِثْلَ مَا نَامَ ، وَصَلاتُهُ تِلْكَ الآخِرَةُ تَكُونُ إِلَى الصُّبْحِ ""","","","","","Book of Prayer"
"4561","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يُصَلِّي سَبْعَ عَشْرَةَ رَكْعَةً مِنَ اللَّيْلِ ""","","","","","Book of Prayer"
"4562","عَنْ مَالِكٍ ، عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّهُ سَأَلَ عَائِشَةَ : كَيْفَ كَانَتْ صَلاةُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي رَمَضَانَ ؟ فَقَالَتْ : \" مَا كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَزِيدُ فِي رَمَضَانَ ، وَلا فِي غَيْرِهِ عَلَى إِحْدَى عَشْرَةَ رَكْعَةً ، يُصَلِّي أَرْبَعًا ، فَلا تَسْأَلُ عَنْ حُسْنِهِنَّ وَطُولِهِنَّ , ثُمَّ يُصَلِّي أَرْبَعًا ، فَلا تَسْأَلُ عَنْ حُسْنِهِنَّ وَطُولِهِنَّ ، ثُمَّ يُصَلِّي ثَلاثًا ، قَالَتْ عَائِشَةُ ، فَقُلْتُ : يَا رَسُولَ اللَّهِ أَتَنَامُ قَبْلَ أَنْ تُوتِرَ ؟ فَقَالَ : \" يَا عَائِشَةُ ، عَيْنَايَ تَنَامَانِ ، وَلا يَنَامُ قَلْبِي ""","","","","","Book of Prayer"
"4563","قَالَ مَالِكٌ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ ، عَنْ أَبِيهِ ، عَنْ عَبْدِ اللَّهِ بْنِ قَيْسِ بْنِ مَخْرَمَةَ ، عَنْ زَيْدِ بْنِ خَالِدٍ الْجُهَنِيِّ ، أَنَّهُ قَالَ : \" لأَرْمُقَنَّ صَلاةَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : فَتَوَسَّدْتُ عَتَبَتَهُ ، أَوْ فُسْطَاطَهُ ، فَقَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَصَلَّى رَكْعَتَيْنِ خَفِيفَتَيْنِ ، ثُمَّ صَلَّى رَكْعَتَيْنِ طَوِيلَتَيْنِ ، ثُمَّ صَلَّى رَكْعَتَيْنِ دُونَ اللَّتَيْنِ قَبْلَهُمَا ، ثُمَّ أَوْتَرَ فَتِلْكَ ثَلاثَ عَشْرَةَ رَكْعَةً ""","","","","","Book of Prayer"
"4564","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ ، قَالَ : أَخْبَرَنِي سَعْدُ بْنُ هِشَامٍ ، أَنَّهُ سَمِعَ عَائِشَةَ ، تَقُولُ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُوتِرُ بِتِسْعِ رَكَعَاتٍ ، رَكْعَتَيْنِ وَهُوَ جَالِسٌ ، فَلَمَّا ضَعُفَ أَوْتَرَ بِسَبْعٍ ، رَكْعَتَيْنِ وَهُوَ جَالِسٌ ""","","","","","Book of Prayer"
"4565","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنْ زُرَارَةَ بْنِ أَوْفَى ، أَنَّ سَعْدَ بْنَ هِشَامِ بْنِ عَامِرٍ كَانَ جَارًا لَهُ فَأَخْبَرَهُ أَنَّهُ طَلَّقَ امْرَأَتَهُ ، ثُمَّ ارْتَحَلَ إِلَى الْمَدِينَةِ لِيَبِيعَ عَقَارًا لَهُ وَمَالا يَجْعَلَهُ فِي السِّلاحِ وَالْكُرَاعِ ، لِمَنْ يُجَاهِدُ الرُّومَ حَتَّى يَمُوتَ ، فَلَقِيَهُ رَهْطٌ مِنْ قَوْمِهِ فَنَهَوْهُ عَنْ ذَلِكَ ، وَأَخْبَرُوهُ أَنَّ رَهْطًا مِنْهُمْ سِتَّةً أَرَادُوا ذَلِكَ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَنَهَاهُمْ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَقَالَ لَهُمْ : \" أَلَيْسَ لَكُمْ فِيَّ أُسْوَةٌ ؟ \" فَلَمَّا حَدَّثُوهُ بِذَلِكَ رَاجَعَ امْرَأَتَهُ","","","","","Book of Prayer"
"4566","فَلَمَّا قَدِمَ عَلَيْنَا أُخْبِرَ أَنَّهُ أَتَى ابْنَ عَبَّاسٍ فَسَأَلَهُ عَنِ الْوِتْرِ ، فَقَالَ ابْنُ عَبَّاسٍ : أَوَلا أُنْبِئُكَ ، أَوَ أَلا أَدُلُّكَ بِأَعْلَمِ أَهْلِ الأَرْضِ بِوِتْرِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ قُلْتُ : مَنْ ؟ قَالَ : عَائِشَةُ ، فَأْتِهَا فَسَلْهَا عَنْ ذَلِكَ ، ثُمَّ ارْجَعْ إِلَيَّ فَأَخْبِرْنِي بِرَدِّهَا عَلَيْكَ ، قَالَ سَعْدُ بْنُ هِشَامٍ : فَأَتَيْتُ حَكِيمَ بْنَ أَفْلَحَ فَاسْتَلْحَقْتُهُ إِلَيْهَا ، فَقَالَ : مَا أَنَا بِقَارِبِهَا ، إِنِّي نَهَيْتُهَا أَنْ تَقُولَ بَيْنَ الشِّيعَتَيْنِ شَيْئًا فَأَبَتْ إِلا مُضِيًّا فِيهَا ، فَأَقْسَمَتُ عَلَيْهِ فَجَاءَ مَعِي ، فَسَلَّمْنَا عَلَيْهَا ، فَدَخَلَ فَعَرَفَتْهُ ، فَقَالَتْ : أَحَكِيمٌ ؟ فَقَالَ : نَعَمْ ، فَقَالَتْ : مَنْ هَذَا مَعَكَ ؟ قَالَ : سَعْدُ بْنُ هِشَامٍ ، قَالَتْ : مَنْ هِشَامٌ ؟ قَالَ : ابْنُ عَامِرٍ ، قَالَتْ : نِعْمَ الْمَرْءُ كَانَ عَامِرٌ ، أُصِيبَ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمَ أُحُدٍ ، قَالَ : فَقُلْتُ : يَا أُمَّ الْمُؤْمِنِينَ ، أَنْبِئِينِي عَنْ خُلُقِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَتْ : أَمَا تَقْرَأُ الْقُرْآنَ ؟ قُلْتُ : بَلَى ، قَالَتْ : \" فَإِنَّ خُلُقَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ الْقُرْآنَ ""","","","","","Book of Prayer"
"4567","قَالَ : فَهَمَمْتُ أَنْ أَقُومَ فَبَدَا لِي ، فَقُلْتُ لَهَا : أَنْبِئِينِي عَنْ قِيَامِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَالَتْ : أَمَا تَقْرَأُ هَذِهِ السُّورَةَ \" يَأَيُّهَا الْمُزَّمِّلُ \" ؟ قَالَ : قُلْتُ : بَلَى ، قَالَتْ : فَإِنَّ اللَّهَ افْتَرَضَ الْقِيَامَ فِي أَوَّلِ هَذِهِ السُّورَةِ ، فَقَامَ نَبِيُّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابُهُ حَوْلا ، حَتَّى انْتَفَخَتْ أَقْدَامُهُمْ ، وَأَمْسَكَ اللَّهُ خَاتِمَتَهَا اثْنَيْ عَشَرَ شَهْرًا ، ثُمَّ أَنْزَلَ اللَّهُ التَّخْفِيفَ فِي آخِرِ السُّورَةِ ، فَصَارَ قِيَامُ اللَّيْلِ تَطَوُّعًا ، بَعْدَ إِذْ كَانَ فَرِيضَةً فَهَمَمْتُ أَنْ أَقُومَ فَبَدَا لِي فَسَأَلْتُهَا ، فَقُلْتُ : يَا أُمَّ الْمُؤْمِنِينَ ، أَنْبِئِينِي عَنْ وِتْرِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَتْ : كُنَّا نُعِدُّ لَهُ سِوَاكَهُ ، وَطَهُورَهُ مِنَ اللَّيْلِ ، فَيَبْعَثُهُ اللَّهُ مَا شَاءَ أَنْ يَبْعَثَهُ ، ثُمَّ يَتَسَوَّكُ وَيَتَوَضَّأُ ثُمَّ يُصَلِّي تِسْعَ رَكَعَاتٍ ، لا يَقْعُدُ فِيهِنَّ إِلا عِنْدَ الثَّامِنَةِ ، فَيَحْمَدُ اللَّهَ وَيَذْكُرُهُ وَيَدْعُوهُ ، ثُمَّ يَنْهَضُ وَلا يُسَلِّمُ حَتَّى يُصَلِّيَ التَّاسِعَةَ ، فَيَقْعُدُ وَيَحْمَدُ اللَّهَ وَيَذْكُرُهُ وَيَدْعُوهُ ، ثُمَّ يُسَلِّمُ تَسْلِيمًا يُسْمِعُنَا ، ثُمَّ يُصَلِّي رَكْعَتَيْنِ ، وَهُوَ قَاعِدٌ بَعْدَمَا يُسَلِّمُ ، فَتِلْكَ إِحْدَى عَشْرَةَ رَكْعَةً أَيْ بُنَيَّ ! فَلَمَّا أَسَنَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَخَذَهُ اللَّحْمُ ، أَوْتَرَ بِسَبْعٍ صَلَّى رَكْعَتَيْنِ وَهُوَ قَاعِدٌ بَعْدَمَا يُسَلِّمُ ، فَتِلْكَ تِسْعٌ أَيْ بُنَيَّ ! وَكَانَ نَبِيُّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا صَلَّى صَلاةً أَحَبَّ أَنْ يُدَاوِمَ عَلَيْهَا ، وَكَانَ نَبِيُّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا غَلَبَهُ عَنْ قِيَامِ اللَّيْلِ نَوْمٌ أَوْ وَجَعٌ ، صَلَّى مِنَ النَّهَارِ اثْنَتَيْ عَشْرَةَ رَكْعَةً ، وَلا أَعْلَمُ نَبِيَّ اللَّهَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَرَأَ الْقُرْآنَ فِي لَيْلَةٍ ، وَلا قَامَ لَيْلَةً حَتَّى أَصْبَحَ ، وَلا قَامَ شَهْرًا غَيْرَ رَمَضَانَ \" ، قَالَ : فَأَتَيْتُ عَلَى ابْنِ عَبَّاسٍ ، فَأَنْبَأْتُهُ بِحَدِيثِهَا ، فَقَالَ : صَدَقْتَ ، أَمَا أَنِّي لَوْ كُنْتُ أَدْخُلُ عَلَيْهَا ، لَشَافَهْتُهَا بِهِ مُشَافَهَةً ، قَالَ حَكِيمُ بْنُ أَفْلَحَ : أَمَا إِنِّي لَوْ عَلِمْتُ أَنَّكَ مَا تَدْخُلُ عَلَيْهَا مَا أَنْبَأْتُكَ بِحَدِيثِهَا","","","","","Book of Prayer"
"4568","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَةَ ، عَنْ يَحْيَى بْنِ الْجَزَّارِ ، عَنْ عَائِشَةَ ، قَالَتْ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يُصَلِّي مِنَ اللَّيْلِ تِسْعًا ، فَلَمَّا ثَقُلَ وَأَسَنَّ صَلَّى سَبْعًا ""","","","","","Book of Prayer"
"4569","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : قُلْتُ لَهُ : أَنَقْتَصِرُ عَلَى وِتْرِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : \" بَلْ زِيَادَةُ الْخَيْرِ أَحَبُّ إِلَيَّ ""","","","","","Book of Prayer"
"4570","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ \" كَانُوا يَسْتَحِبُّونَ بَعْدَ الْوِتْرِ ضَجْعَةً ، أَوْ نَوْمَةً ""","","","","","Book of Prayer"
"4571","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ أَبِي النَّضْرِ أَوْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِي سَلَمَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي مِنَ اللَّيْلِ ، فَإِذَا أَرَادَ أَنْ يُوتِرَ فَإِنْ كُنْتُ مُسْتَيْقِظَةً حدَّثَنِي وَإِلا اضْطَجَعَ ""","","","","","Book of Prayer"
"4572","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، \" أَنَّ أَبَا مُوسَى الأَشْعَرِيَّ ، وَرَافِعَ بْنَ خَدِيجٍ ، وَأَنَسَ بْنَ مَالِكٍ ، كَانُوا يَضْطَجِعُونَ عِنْدَ رَكْعَتَيِ الْفَجْرِ ، وَيَأْمُرُونَ بِذَلِكَ ""","","","","","Book of Prayer"
"4573","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، إِذَا طَلَعَ الْفَجْرُ يُصَلِّي رَكْعَتَيْنِ خَفِيفَتَيْنِ ، ثُمَّ يَضْطَجِعُ عَلَى شِقِّهِ الأَيْمَنِ حَتَّى يَأْتِيَهُ الْمُؤَذِّنُ ، فَيُؤْذِنَهُ بِالصَّلاةِ ""","","","","","Book of Prayer"
"4574","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي مَنْ أُصَدِّقُ ، أَنَّ عَائِشَةَ ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا طَلَعَ الْفَجْرُ ، يُصَلِّي رَكْعَتَيْنِ خَفِيفَتَيْنِ ، ثُمَّ يَضْطَجِعُ عَلَى شِقِّهِ الأَيْمَنِ حَتَّى يَأْتِيَهُ الْمُؤَذِّنُ ، فَيُؤْذِنَهُ بِالصَّلاةُ ، لَمْ يَضْطَجِعْ لِسُنَّةٍ ، وَلَكِنَّهُ كَانَ يَدْأَبُ لَيْلَةً فَيَسْتَرِيحُ \" ، قَالَ : \" فَكَانَ ابْنُ عُمَرَ يَحْصِبُهُمْ إِذَا رَآهُمْ يَضْطَجِعُونَ عَلَى أَيْمَانِهِمْ ""","","","","","Book of Prayer"
"4575","عَنْ مَعْمَرٍ ، وَابْنِ جُرَيْجٍ ، قَالا : حَدَّثَنَا ابْنُ شِهَابٍ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَيْلَةً مِنْ جَوْفِ اللَّيْلِ فَصَلَّى فِي الْمَسْجِدِ ، فَثَابَ رِجَالٌ فَصَلَّوْا مَعَهُ بِصَلاتِهِ ، فَلَمَّا أَصْبَحَ ، تَحَدَّثُوا أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَدْ خَرَجَ فَصَلَّى فِي الْمَسْجِدِ مِنْ جَوْفِ اللَّيْلِ ، فَاجْتَمَعَ اللَّيْلَةَ الْمُقَبِلَةَ أَكْثَرُ مِنْهُمْ ، فَخَرَجَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ جَوْفِ اللَّيْلِ ، فَاجْتَمَعَ فَصَلَّى فَصَلَّوْا مَعَهُ بِصَلاتِهِ ، ثُمَّ أَصْبَحُوا فَتَحدَّثُوا بِذَلِكَ ، فَاجْتَمَعَ إِلَيْهِ اللَّيْلَةَ الثَّالِثَةَ نَاسٌ كَثِيرٌ حَتَّى كَثُرَ أَهْلُ الْمَسْجِدِ ، قَالَتْ : فَخَرَجَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ جَوْفِ اللَّيْلِ ، فَصَلَّى فَصَلَّوْا مَعَهُ ، قَالَتْ : فَلَمَّا كَانَ اللَّيْلَةُ الرَّابِعَةُ ، اجْتَمَعَ النَّاسُ حَتَّى كَادَ الْمَسْجِدُ يَعْجِزُ عَنْ أَهْلِهِ ، قَالَتْ : فَجَلَسَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَلَمْ يَخْرُجْ ، قَالَتْ : حَتَّى سَمِعْتُ نَاسًا مِنْهُمْ ، يَقُولُونَ : الصَّلاةَ ، فَلَمْ يَخْرُجْ إِلَيْهِمُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا صَلَّى صَلاةَ الْفَجْرِ سَلَّمَ ، ثُمَّ قَامَ فِي النَّاسِ فَتَشَهَدَّ ، ثُمَّ قَالَ : \" أَمَّا بَعْدُ ، فَإِنَّهُ لَمْ يَخْفَ عَلَيَّ شَأَنُكُمُ اللَّيْلَةَ ، وَلَكِنِّي خَشِيتُ أَنْ تُفْرَضَ عَلَيْكُمْ فَتَعْجِزُوا عَنْهَا ""","","","","","Book of Prayer"
"4576","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، قَالَ : \" بَلَغَنِي أَنَّهَا نَزَلَتْ  لَيْسُوا سَوَاءً مِنْ أَهْلِ الْكِتَابِ أُمَّةٌ قَائِمَةٌ فِيمَا بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ ""","","","","","Book of Prayer"
"4577","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِيهِ الأَسْوَدِ بْنِ يَزِيدَ ، قَالَ : قَالَ عَبْدُ اللَّهِ : \" نِعْمَ سَاعَةُ الْغَفْلَةِ فِيمَا بَيْنَ الْمَغْرِبِ ، وَالْعِشَاءِ ، يَعْنِي الصَّلاةَ ""","","","","","Book of Prayer"
"4578","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنِ الْعَلاءِ بْنِ بَدْرٍ ، عَنْ رَجُلٍ ، عَنْ سَلْمَانَ ، قَالَ : \" صَلُّوا فِيمَا بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ ، فَإِنَّهُ يُخَفَّفُ عَنْ أَحَدِكُمْ مِنْ حِزْبِهِ ، وَيَذْهَبُ عَنْهُ مَلْغَاةُ أَوَّلِ اللَّيْلِ ، فَإِنَّ مَلْغَاةَ أَوَّلِ اللَّيْلِ مَهْدَنَةٌ لآخِرِهِ ""","","","","","Book of Prayer"
"4579","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنْ عَطَاءٍ ، عَنْ تُبَيْعٍ ، قَالَ \" مَنْ صَلَّى بَعْدَ الْعِشَاءِ أَرْبَعَ رَكَعَاتٍ يُحْسِنُ فِيهِمَا الْقِرَاءَةَ وَالرُّكُوعَ وَالسُّجُودَ ، كَانَ لَهُ مِثْلُ أَجْرِ لَيْلَةِ الْقَدْرِ ""","","","","","Book of Prayer"
"4580","عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدٍ ، عَنْ مُوسَى بْنِ عُبَيْدَةَ ، عَنْ أَيُّوبَ بْنِ خَالِدٍ ، عَنِ ابْنِ عُمَرَ ، لا أَعْلَمُهُ إِلا رَفَعَهُ ، قَالَ : \" مَنْ رَكَعَ بَعْدَ الْمَغْرِبِ أَرْبَعَ رَكَعَاتٍ ، كَانَ كَالْمُعْقِبِ غَزْوَةً بَعْدَ غَزْوَةٍ ""","","","","","Book of Prayer"
"4581","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، قَالَ : \" رَأَى الْحَسَنُ بْنُ عَلِيٍّ رَجُلا يُصَلِّي بَعْدَ الْمَغْرِبِ أَرْبَعَ رَكَعَاتٍ ، فَقَالَ لَهُ : أَفَاتَكَ شَيْءٌ مِنَ الْمَكْتُوبَةِ ؟ قَالَ : لا ، قَالَ : فَإِنَّهُمَا رَكْعَتَانِ أَدْبَارَ السُّجُودِ \" ، وَبِهِ كَانَ يَأْخُذُ مَعْمَرٌ","","","","","Book of Prayer"
"4582","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ \" إِنَّمَا التَّهَجُّدُ بَعْدَ النَّوْمِ ""","","","","","Book of Prayer"
"4583","عَنْ مُحَمَّدِ بْنِ مُسْلِمِ ، عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ قَال : \" رَآنِي مُجَاهِدٌ صَلَّى بَعْدَ الْمَغْرِبِ ، فَقَالَ : إِنَّمَا هُمَا رَكْعَتَانِ ، قَالَ إِبْرَاهِيمُ : وَمَا رَأَيْتُ طَاوُسًا يَزِيدُ عَلَى رَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ""","","","","","Book of Prayer"
"4584","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ فِي قَوْلِهِ :  إِنَّ نَاشِئَةَ اللَّيْلِ هِيَ أَشَدُّ ، قَالَ \" إِذَا قَامَ يُصَلِّي مِنَ اللَّيْلِ فَهِيَ نَاشِئَةٌ ""","","","","","Book of Prayer"
"4585","قَالَ الثَّوْرِيُّ ، وَقَالَ لَيْثٌ ، عَنْ مُجَاهِدٍ \" مَا كَانَ بَعْدَ الْعِشَاءِ ، فَهُوَ نَاشِئَةٌ ""","","","","","Book of Prayer"
"4586","عَنْ مَعْمَرٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ \" مَا كَانَ بَعْدَ الْعِشَاءِ ، فَهُوَ نَاشِئَةٌ ""","","","","","Book of Prayer"
"4587","عَنِ النُّعْمَانِ بْنِ أَبِي شَيْبَةَ ، عَنْ سَلَمَةَ بْنِ وَهْرَامَ ، وَعَبْدِ الرَّحْمَنِ بْنِ بُوذَوَيْهِ ، أَنَّهُمَا سَمِعَا طَاوُسًا ، قَالَ \" مَنْ صَلَّى قَبْلَ الْفَجْرِ رَكْعَتَيْنِ ، كَانَ مِنَ الْمُسْتَغْفِرِينَ بِالأَسْحَارِ ""","","","","","Book of Prayer"
"4588","عَنِ الثَّوْرِيِّ ، عَنْ زُبَيْدٍ ، عَنْ مُرَّةَ ، قَالَ : قَالَ عَبْدُ اللَّهِ : \" فَضْلُ صَلاةِ اللَّيْلِ عَلَى صَلاةِ النَّهَارِ ، كَفَضْلِ صَدَقَةِ السِّرِّ عَلَى صَدَقَةِ الْعَلانِيَةِ \" ، قَالَ : وَقَالَ عَبْدُ اللَّهِ : \" إِنَّكَ مَا كُنْتَ فِي صَلاةٍ كَأَنَّكَ تَقْرَعُ بَابَ الْمَلِكِ ، وَمَنْ قَرَعَ بَابَ الْمَلِكِ يُوشَكُ أَنْ يُفْتَحَ لَهُ ""","","","","","Book of Prayer"
"4589","عَنْ شَيْخٍ ، مِنْ أَهْلِ الْمَدِينَةِ ، عَنِ ابْنِ شِهَابٍ ، قَالَ \" فَضْلُ صَلاةِ اللَّيْلِ عَلَى صَلاةِ النَّهَارِ ، كَفَضْلِ صَلاةِ الْمَكْتُوبَةِ عَلَى صَلاةِ التَّطَوُّعِ ""","","","","","Book of Prayer"
"4590","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ أَبِيهِ ، عَنِ الْمُغِيرَةِ بْنِ شُبَيْلٍ ، عَنْ طَارِقِ بْنِ شِهَابٍ ، أَنَّهُ بَاتَ عِنْدَ سَلْمَانَ يَنْظُرُ مَا اجْتِهَادُهُ ، قَالَ : فَقَامَ يُصَلِّي مِنْ آخِرِ اللَّيْلِ فَكَأَنَّهُ لَمْ يَرَ الَّذِي كَانَ يَظُنُّ ، فَذُكِرَ ذَلِكَ لَهُ فَقَالَ سَلْمَانُ : \" حَافِظُوا عَلَى هَذِهِ الصَّلَوَاتِ الْخَمْسِ ؛ فَإِنَّهُنَّ كَفَّارَاتٌ لِهَذِهِ الْجَرَّاجَاتِ مَا لَمْ تُصَبِ الْمَقْتَلَةُ ، فَإِذَا صَلَّى النَّاسُ الْعِشَاءَ صَدَرُوا عَلَى ثَلاثِ مَنَازِلَ : مِنْهُمْ مَنْ عَلَيْهِ وَلا لَهُ ، وَمِنْهُمْ مَنْ لَهُ وَلا عَلَيْهِ ، وَمِنْهُمْ مَنْ لا لَهُ وَلا عَلَيْهِ ، فَأَمَّا الَّذِي عَلَيْهِ وَلا لَهُ فَرَجُلٌ اغْتَنَمَ ظُلْمَةَ اللَّيْلِ وَغَفْلَةَ النَّاسِ فَكَبَّ رَأْسَهُ فِي الْمَعَاصِي , فَذَلِكَ عَلَيْهِ وَلا لَهُ ، وَأَمَّا الَّذِي لَهُ وَلا عَلَيْهِ فَرَجُلٌ اغْتَنَمَ ظُلْمَةَ اللَّيْلِ وَغَفْلَةَ النَّاسِ فَقَامَ يُصَلِّي فَذَلِكَ لَهُ وَلا عَلَيْهِ ، وَأَمَّا الَّذِي لا لَهُ وَلا عَلَيْهِ فَرَجُلٌ صَلَّى وَنَامَ فَذَلِكَ لا لَهُ وَلا عَلَيْهِ ، وَإِيَّاكَ وَالْحَقْحَقَةَ ، وَعَلَيْكَ بِالْقَصْدِ وَدَوَامٍ ""","","","","","Book of Prayer"
"4591","عَنِ الثَّوْرِيِّ ، عَنْ عَلِيِّ بْنِ الأقْمَرِ ، عَنِ الأَغَرِّ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ : \" إِذَا قَامَ الرَّجُلُ مِنَ اللَّيْلِ فَأَيْقَظَ امْرَأَتَهُ فَصَلَّيَا رَكْعَتَيْنِ ، كُتِبَا تِلْكَ اللَّيْلَةَ مِنَ الذَّاكِرِينَ اللَّهَ كَثِيرًا وَالذَّاكِرَاتِ ""","","","","","Book of Prayer"
"4592","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ الْمُنْكَدِرِ ، قَالَ : حَدَّثَنِي مَنْ ، سَمِعَ أَبَا هُرَيْرَةَ ، لا أُرَاهُ إِلا رَفَعَهُ ، يَقُولُ : \" إِذَا قَامَ أَحَدُكُمْ مِنَ اللَّيْلِ فَلْيُوقِظْ أَهْلَهُ ، فَإِنْ لَمْ يَسْتَيْقِظْ فَلْيَنْضَحْ وَجْهَهَا بِالْمَاءِ ""","","","","","Book of Prayer"
"4593","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ مِنْ قُرَيْشٍ ، وَغَيْرِهِ يُرْجِعُونَهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : قَالَ اللَّهُ : \" إِنَّ أَحَبَّ عِبَادِي إِلَيَّ الْمُتَحَابُّونَ فِي الدِّينِ يُعَمِّرُونَ مَسَاجِدِي ، وَيَسْتَغْفِرُونَ بِالأَسْحَارِ ، أُولَئِكَ الَّذِينَ إِذَا ذَكَرْتُ خَلْقِي بِعَذَابٍ ذَكَرْتُهُمْ فَصَرَفْتُ عَذَابِي عَنْ خَلْقِي ""","","","","","Book of Prayer"
"4594","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ رَجُلٍ ، عَنْ عَلِيٍّ ، فِي قَوْلِهِ :  قُوا أَنْفُسَكُمْ ، قَالَ \" عَلِّمُوا أَنْفُسَكُمُ الْخَيْرَ ""","","","","","Book of Prayer"
"4595","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَةَ ، عَنْ أَبِي الأَحْوَصِ ، عَنْ عَبْدِ اللَّهِ ، قَالَ : \" تعَوَّدُوا الْخَيْرَ ، فَإِنَّمَا الْخَيْرُ بِالْعَادَةِ ""","","","","","Book of Prayer"
"4596","عَنْ مَالِكٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ أَبِيهِ ، \" أَنَّ عُمَرَ كَانَ يُصَلِّي مِنَ اللَّيْلِ مَا شَاءَ اللَّهُ أَنْ يُصَلِّيَ ، حَتَّى إِذَا كَانَ مِنْ آخِرِ اللَّيْلِ أَيْقَظَ أَهْلَهُ ، وَيَقُولُ : \" الصَّلاةَ الصَّلاةَ ، وَيَتْلُو هَذِهِ الآيَةَ :  وَأْمُرْ أَهْلَكَ بِالصَّلاةِ وَاصْطَبِرْ عَلَيْهَا لا نَسْأَلُكَ رِزْقًا نَحْنُ نَرْزُقُكَ وَالْعَاقِبَةُ لِلتَّقْوَى ""","","","","","Book of Prayer"
"4597","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ مِنْ قُرَيْشٍ ، قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا دَخَلَ عَلَيْهِ بَعْضُ الضِّيقِ فِي الرِّزْقِ ، أَمَرَ أَهْلَهُ بِالصَّلاةِ ، ثُمَّ قَرَأَ هَذِهِ الآيَةَ :  وَأْمُرْ أَهْلَكَ بِالصَّلاةِ وَاصْطَبِرْ عَلَيْهَا ""","","","","","Book of Prayer"
"4598","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ ، ذَكَرَهُ عَنْ بَعْضِهِمْ ، قَالَ : \" إِذَا اسْتَيْقَظَ الرَّجُلُ مِنَ اللَّيْلِ فَذَكَرَ اللَّهَ , وَقَامَ فَتَوَضَّأَ وَصَلَّى وَدَعَا اللَّهَ اسْتَجَابَ لَهُ ""","","","","","Book of Prayer"
"4599","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ زِيَادِ بْنِ عِلاقَةَ ، عَنِ الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي حَتَّى تَتَفَطَّرَ قَدَمَاهُ \" ، فَقِيلَ لَهُ : أَلَيْسَ قَدْ غَفَرَ لَكَ اللَّهُ مَا تَقَدَّمَ مِنْ ذَنْبِكَ وَمَا تَأَخَّرَ ؟ قَالَ : \" أَفَلا أَكُونُ عَبْدًا شَكُورًا ؟ ""","","","","","Book of Prayer"
"4600","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ بَعْضِ أَصْحَابِهِ ، قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي حَتَّى تَوَرَّمَ قَدَمَاهُ \" ، فَقَالُوا : يَا رَسُولَ اللَّهِ ، تَفْعَلُ هَذَا وَقَدْ تَوَرَّمَ قَدَمَاكَ وَاللَّهُ تَعَالَى قَدْ غَفَرَ لَكَ مَا تَقَدَّمَ مِنْ ذَنْبِكَ وَمَا تَأَخَّرَ ؟ قَالَ : \" أَفَلا أَكُونُ عَبْدًا شَكُورًا ؟ ""","","","","","Book of Prayer"
"4601","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَبْدٍ الْقَارِيِّ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، قَالَ : \" مَنْ نَامَ عَنْ حِزْبِهِ  \" ، أَوْ قَالَ : \" عَنْ جُزْئِهِ مِنَ اللَّيْلِ فَقَرَأَهُ فِيمَا بَيْنَ صَلاةِ الْفَجْرِ إِلَى صَلاةِ الظُّهْرِ ، فَكَأَنَّمَا قَرَأَهُ مِنَ اللَّيْلِ ""","","","","","Book of Prayer"
"4602","عَنِ الثَّوْرِيِّ ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ ، أَنَّ رَجُلا رَأَى عُمَرَ بْنَ الْخَطَّابِ يُصَلِّي فِي حِينَ لَمْ يَكُنْ يُصَلِّي فِيهِ مِنَ النَّهَارِ ، فَقَالَ لَهُ : فَقَالَ : \" فَاتَنِي مِنَ اللَّيْلِ \" ، وَقَدْ قَالَ اللَّهُ :  وَهُوَ الَّذِي جَعَلَ اللَّيْلَ وَالنَّهَارَ خِلْفَةً لِمَنْ أَرَادَ أَنْ يَذَّكَّرَ أَوْ أَرَادَ شُكُورًا ","","","","","Book of Prayer"
"4603","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ \" كَانَ يُعْجِبُهُمُ الزِّيَادَةَ فِي الْعَمَلِ ، وَيَكْرَهُونَ النُّقْصَانَ ، وَالأَقْسَامَ دِيمَةً ، وَإِذَا فَاتَهُمْ شَيْءٌ مِنَ اللَّيْلِ قَضَوْهُ بِالنَّهَارِ ""","","","","","Book of Prayer"
"4604","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ أَبَانَ بْنِ أَبِي عَيَّاشٍ ، عَنْ زُرَارَةَ بْنِ أَوْفَى ، عَنْ عَائِشَةَ ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا لَمْ يُصَلِّ مِنَ اللَّيْلِ شَيْئًا ، صَلَّى مِنَ النَّهَارِ اثْنَيْ عَشَرَ رَكْعَةً ""","","","","","Book of Prayer"
"4605","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي الْمَشْرَفِيِّ ، قَالَ : سَمِعْتُ الْحَسَنَ ، يَقُولُ : \" إِذَا فَاتَ رَجُلا شَيْءٌ مِنَ اللَّيْلِ فَلَمْ يُصَلِّ فَلا بَأْسَ أَنْ يُطِيلَ فِي رَكْعَتَيِ الْفَجْرِ ""","","","","","Book of Prayer"
"4606","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سَأَلْتُ عَطَاءً \" أَتَكْرَهُ الصَّلاةَ إِذَا انْتَشَرَ الْفَجْرُ عَلَى رُءُوسِ الْجِبَالِ إِلا رَكْعَتَيِ الْفَجْرِ ؟ قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"4607","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي ابْنُ مِينَا أَبُو عَبْدِ الرَّحْمَنِ بْنُ مِينَا ، أَوْ سُلَيْمٍ مَوْلَى سَعِيدٍ ، قَالَ : وَكِلاهُمَا مَا عَلِمْتُ كَانَ مُصَلِّيًا ، قَالَ : فَأَخْبَرَنِي أَحَدُهُمَا ، قَالَ : قُلْتُ : \" جِئْتُ الْمَسْجِدَ بَعْدَ الْفَجْرِ ، قَالَ : فَجَعَلْتُ أُصَلِّي أُتَابِعُ ، فَقَالَ ابْنُ عُمَرَ : مَا هَذَا ؟ قَالَ : قُلْتُ : إِنِّي لَمْ أُصَلِّ الْبَارِحَةَ ، فَقَالَ ابْنُ عُمَرَ : أَتُرِيدُ أَنْ تُخْبِرَنِي الآنَ ! إِنَّمَا هُمَا رَكْعَتَانِ ""","","","","","Book of Prayer"
"4608","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي رِيَاحٍ ، عَنِ ابْنِ الْمُسَيِّبِ أَنَّهُ رَأَى رَجُلا يُكَرِّرُ الرُّكُوعَ بَعْدَ طُلُوعِ الْفَجْرِ فَنَهَاهُ ، فَقَالَ : \" يَا أَبَا مُحَمَّدٍ أَيُعَذِّبُنِي اللَّهُ عَلَى الصَّلاةِ ؟ قَالَ : لا ، وَلَكِنْ يُعَذِّبُكَ عَلَى خِلافِ السُّنَّةِ ""","","","","","Book of Prayer"
"4609","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَةَ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لا صَلاةَ بَعْدَ النِّدَاءِ ، إِلا رَكْعَتَيِ الْفَجْرِ ""","","","","","Book of Prayer"
"4610","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زِيَادٍ ، عَنْ عَبْدِ اللَّهِ بْنِ يَزِيدَ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لا صَلاةَ بَعْدَ طُلُوعِ الْفَجْرِ ، إِلا رَكْعَتَيِ الْفَجْرِ ""","","","","","Book of Prayer"
"4611","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ مُجَاهِدٌ : \" كَانَ ابْنُ عَبَّاسٍ لا يُبْصِرُ ، وَكَانَ يُبْصَرُ لَهُ ، فَإِذَا طَلَعَ الْفَجْرُ ، رَكَعَ رَكْعَتَيْنِ ثُمَّ جَلَسَ ""","","","","","Book of Prayer"
"4612","قَالَ : \" وَكَانَ ابْنُ عُمَرَ يَنْظُرُ ، فَإِذَا طَلَعَ الْفَجْرُ رَكَعَ رَكْعَتَيْنِ ثُمَّ جَلَسَ ""","","","","","Book of Prayer"
"4613","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، قَالَ : قَالَ مُجَاهِدٌ لِطَاوُسٍ \" يَا أَبَا عَبْدِ الرَّحْمَنِ ، إِنِّي رَأَيْتُ ابْنَ عَبَّاسٍ بَعْدَمَا ذَهَبَ بَصَرُهُ يَسْأَلُ غُلامَهُ عَنِ الْفَجْرِ ، فَإِذَا أَخْبَرَهُ أَنَّهُ قَدْ طَلَعَ صَلَّى رَكْعَتَيْنِ ثُمَّ جَلَسَ ""","","","","","Book of Prayer"
"4614","\" وَرَأَيْتُ ابْنَ عُمَرَ يَلْتَفِتُ ، فَإِذَا رَأَى الْفَجْرَ صَلَّى رَكْعَتَيْنِ ثُمَّ جَلَسَ \" ، قَالَ : فَقَالَ لَهُ طَاوُسٌ : \" أَتَعْقِلُ ؟ إِذَا طَلَعَ الْفَجْرُ فَصَلِّ مَا شِئْتَ ""","","","","","Book of Prayer"
"4615","عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدٍ ، عَنْ مُوسَى بْنِ عُقْبَةَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لا صَلاةَ بَعْدَ طُلُوعِ الْفَجْرِ ، إِلا رَكْعَتَيِ الْفَجْرِ ""","","","","","Book of Prayer"
"4616","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنِ الْحَسَنِ ، قَالَ \" صَلِّ بَعْدَ طُلُوعِ الْفَجْرِ مَا شِئْتَ ""","","","","","Book of Prayer"
"4617","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ أَبُو أُمَيَّةَ ، قَالَ \" رَأَيْتُ طَاوُسًا دَخَلَ مَسْجِدَ مِنًى بَعْدَمَا طَلَعَ الْفَجْرَ ، فَصَلَّى ثَمَانِ رَكَعَاتٍ فَسَأَلْتُهُ ، عَنْ ذَلِكَ ، فَقَالَ : صَلاةٌ مِنَ اللَّيْلِ كُنْتُ أُصَلِّيهَا نِمْتُ عَنْهَا ""","","","","","Book of Prayer"
"4618","قَالَ : \" ثُمَّ رَأَيْتُ عَطَاءً بَعْدَ ذَلِكَ دَخَلَ مَسْجِدَ مِنًى بَعْدَ طُلُوعِ الْفَجْرِ ، فَصَلَّى ثَمَانِ رَكَعَاتٍ \" ، فَسَأَلْتُهُ ، فَقَالَ مِثْلَ مَا قَالَ طَاوُسٌ","","","","","Book of Prayer"
"4619","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ وَبَرَةَ ، \" أَنَّ ابْنَ عُمَرَ أَعَادَ رَكْعَتَيِ الْفَجْرِ فِي لَيْلَةٍ ثَلاثَ مَرَّاتٍ لأَنَّهُ صَلاهَا بِلَيْلٍ ""","","","","","Book of Prayer"
"4620","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : \" مَتَى كَانَ يُسْتَحَبُّ أَنْ تُرْكَعَ تَانِكَ الرَّكْعَتَانِ ؟ فَقَالَ : مَعَ الْفَجْرِ أَوْ بَعْدَهُ وَافْصِلْ بَيْنَهُمَا وَبَيْنَ مَا صَلَّيْتَ قَبْلَهُمَا ""","","","","","Book of Prayer"
"4621","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، أَنَّهُ سَمِعَ ابْنَ عَبَّاسٍ ، يَقُولُ : \" هُمَا الْفَجْرَانِ ، فَأَمَّا الْفَجْرُ الَّذِي يَسْطَعُ فِي السَّمَاءِ ، فَلَيْسَ بِشَيْءٍ وَلا يُحِرِّمُ شَيْئًا ، وَلَكِنَّ الْفَجْرَ الَّذِي يَنْتَشِرُ عَلَى رُءُوسِ الْجِبَالِ فَهُوَ الَّذِي يُحَرِّمُ \" ، فَقَالَ عَطَاءٌ : فَأَمَّا إِذَا سَطَعَ سُطُوعًا فِي السَّمَاءِ ، وَسُطُوعُهُ أَنْ يَذْهَبَ فِي السَّمَاءِ طُولا ، فَإِنَّهُ لا يُحَرَّمُ لَهُ فِي الشَّرَابِ لِصِيَامٍ وَلا صَلاةٍ ، وَلا يَفُوتُ لَهُ حَجٌّ ، وَلَكِنْ إِذَا انْتَشَرَ عَلَى رُءُوسِ الْجِبَالِ ، حَرُمَ الشَّرَابُ عَلَى الصَّوْمِ ، وَفَاتَ لَهُ الْحَجُّ","","","","","Book of Prayer"
"4622","وَقَالَ عُمَرُ : \" الْفَجْرُ الَّذِي كَأَنَّهُ ذَهَبُ السِّرْحَانِ \" يَقُولُ : \" ذَلِكَ السَّاطِعُ فِي السَّمَاءِ ""","","","","","Book of Prayer"
"4623","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ لَوْ جِئْتُ الْمَسْجِدَ حِينَ انْتَشَرَ الْفَجْرُ أُطَوِّلُهُمَا أَمْ أَحْذِفُهُمَا ؟ قَالَ \" طَوِّلْهُمَا إِنْ شِئْتَ ، مَا لَمْ يَخْرُجِ الإِمَامُ ""","","","","","Book of Prayer"
"4624","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي لَبِيدٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ \" كَانَتَا تُخَفِّفَانِ الرَّكْعَتَانِ قَبْلَ صَلاةِ الْفَجْرِ ""","","","","","Book of Prayer"
"4625","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ عَوْفٍ ، عَنِ ابْنِ سِيرِينَ ، قَالَ \" الْوِتْرُ مِنَ اللَّيْلِ ، وَيُسْتَحَبُّ أَنْ يَكُونَ مِنْ آخِرِ اللَّيْلِ ، وَيُسْتَحَبُّ التَّكْبِيرُ عِنْدَ الْفَجْرِ بِالرَّكْعَتَيْنِ ، وَهُمَا مِنْ صَلاةِ النَّهَارِ ""","","","","","Book of Prayer"
"4626","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنْ حَفْصَةَ ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا طَلَعَ الْفَجْرُ صَلَّى رَكْعَتَيْنِ خَفِيفَتَيْنِ ، ثُمَّ اضْطَجَعَ عَلَى شِقِّهِ الأَيْمَنِ ""","","","","","Book of Prayer"
"4627","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي إِذَا طَلَعَ الْفَجْرُ رَكْعَتَيْنِ خَفِيفَتَيْنِ ، ثُمَّ يَضْطَجِعُ عَلَى شِقِّهِ الأَيْمَنِ ""","","","","","Book of Prayer"
"4628","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أَخْبَرَتْنِي حَفْصَةُ \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا طَلَعَ الْفَجْرُ ، صَلَّى رَكْعَتَيْنِ خَفِيفَتَيْنِ ""","","","","","Book of Prayer"
"4629","عَنْ إِسْرَائِيلَ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ ، قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي رَكْعَتَيِ الْفَجْرِ عِنْدَ الإِقَامَةِ ""","","","","","Book of Prayer"
"4630","عَنْ مَالِكٍ ، عَنْ مُحَمَّدِ بْنِ مَخْرَمَةَ بْنِ سُلَيْمَانَ ، عَنْ كُرَيْبٍ ، عَنِ ابْنِ عَبَّاسٍ \" أَنَّ الْمُؤَذِّنَ جَاءَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَصَلَّى رَكْعَتَيْنِ خَفِيفَتَيْنِ ، ثُمَّ خَرَجَ فَصَلَّى الصُّبْحَ ""","","","","","Book of Prayer"
"4631","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ عَمْرَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُخَفِّفُهُمَا \" ، يَعْنِي رَكْعَتَيِ الْفَجْرِ","","","","","Book of Prayer"
"4632","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ \" أَنَّهُ كَانَ يَرْكَعُهُمَا عِنْدَ الإِقَامَةِ ""","","","","","Book of Prayer"
"4633","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \" أَوَاجِبَتَانِ رَكْعَتَا الضُّحَى ، أَوِ الْوِتْرِ ، أَوْ شَيْءٌ مِنَ التَّطَوُّعِ قَبْلَ الصَّلَوَاتِ أَوْ بَعْدَهُنَّ ؟ قَالَ : لا ""","","","","","Book of Prayer"
"4634","عَنِ الثَّوْرِيِّ ، عَنْ حَكِيمِ بْنِ جُبَيْرٍ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، عَنْ عَائِشَةَ ، قَالَتْ : \" مَا رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى شَيْءٍ أَسْرَعُ مِنْهُ إِلَى رَكْعَتَيْنِ قَبْلَ صَلاةِ الْغَدَاةِ ، وَلا إِلَى غَنِيمَةٍ يَطْلُبُهَا ""","","","","","Book of Prayer"
"4635","عَنْ عُثْمَانَ بْنِ مَطَرٍ ، عَنْ سَعِيدٍ ، عَنْ قَتَادَةَ ، عَنْ زُرَارَةَ بْنِ أَوْفَى ، عَنْ عَائِشَةَ ، قَالَتْ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" رَكْعَتَا الْفَجْرِ أَحَبُّ إِلَيَّ مِنَ الدُّنْيَا وَمَا فِيهَا ""","","","","","Book of Prayer"
"4636","عَنْ عَبْدِ اللَّهِ بْنِ مُحَرَّرٍ ، عَنْ قَتَادَةَ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" رَكْعَتَا الْفَجْرِ أَحَبُّ إِلَيَّ مِنَ الدُّنْيَا وَمَا فِيهَا \" ، قَالَ : وَقَالَ عُمَرُ بْنُ الْخَطَّابِ : \" هُمَا أَحَبُّ إِلَيَّ مِنْ حُمُرِ النَّعَمِ ""","","","","","Book of Prayer"
"4637","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مُهَاجِرِ بْنِ الْقُطْبِيَّةِ ، قَالَ : \" فَاتَتْ عَبْدَ اللَّهِ بْنَ أَبِي رَبِيعَةَ رَكْعَتَا الْفَجْرِ ، فَأَعْتَقَ رَقَبَةً ""","","","","","Book of Prayer"
"4638","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، قَالَ ابْنُ عُمَرَ لِحُمْرَانَ : \" يَا حُمْرَانُ ، اتَّقِ اللَّهَ , وَ لا تَمُتْ وَعَلَيْكَ دَيْنٌ فِيُؤْخَذَ مِنْ حَسَنَاتِكَ لا دِينَارَ ثَمَّ وَلا دِرْهَمَ ، وَلا تَنْتَفِي مِنْ وَلَدِكَ فَتَفَضْحَهُ ، فَيَفْضَحَكَ اللَّهُ بِهِ يَوْمَ الْقِيَامَةِ ، وَعَلَيْكَ بِرَكْعَتَيِ الْفَجْرِ , فَإِنَّ فِيهِمَا رَغَبَ الدَّهْرِ ""","","","","","Book of Prayer"
"4639","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، قَالَ \" إِنْ لَمْ تَقْضِ رَكْعَتَيِ الْفَجْرِ ، فَلَيْسَ عَلَيْكَ شَيْءٌ \" ، يَقُولُ : إِذَا فَاتَتْكَ","","","","","Book of Prayer"
"4640","عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَمْرٍو الأَوْزَاعِيِّ ، عَنْ عُرْوَةَ بْنِ رُوَيْمٍ ، قَالَ \" مَنْ صَلَّى رَكْعَتَيِ الْفَجْرِ ، وَصَلَّى الصُّبْحَ فِي جَمَاعَةٍ ، كُتِبَتْ صَلاتُهُ يَوْمئذٍ فِي صَلاةِ الأَوَّابِينَ ، وَكُتِبَ يَوْمَئِذٍ فِي وَفْدِ الْمُتَّقِينَ ""","","","","","Book of Prayer"
"4641","عَنِ الثَّوْرِيِّ ، عَنْ زِيَادِ بْنِ فَيَّاضٍ ، عَنْ أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ، قَالَ : سَمِعْتُهُ ، يَقُولُ : \" لَوْ أَنَّ رَجُلا صَلَّى رَكْعَتَيْنِ قَبْلَ صَلاةِ الْغَدَاةِ ، ثُمَّ مَاتَ كَانَ قَدْ صَلَّى الْغَدَاةَ ""","","","","","Book of Prayer"
"4642","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ ، \" أَنَّهُ كَانَ يُوتِرُ عِنْدَ الأَذَانِ ، وَيَرْكَعُ رَكْعَتَيِ الْفَجْرِ عِنْدَ الإِقَامَةِ ""","","","","","Book of Prayer"
"4643","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنْ زُرَارَةَ بْنِ أَوْفَى ، عَنْ عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" رَكْعَتَا الْفَجْرِ أَحَبُّ إِلَيَّ مِنَ الدُّنْيَا وَمَا فِيهَا ""","","","","","Book of Prayer"
"4644","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : \" كَانَ يُسْتَحَبُّ أَنْ يُقْرَأَ فِي رَكْعَتَيِ الْفَجْرِ : قُلْ يَأَيُّهَا الْكَافِرُونَ ، وَ قُلْ هُوَ اللَّهُ أَحَدٌ ""","","","","","Book of Prayer"
"4645","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنْ مُحَمَّدِ بْنِ سِيرِينَ ، عَنْ عَائِشَةَ ، قَالَتْ : \" أَسَرَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْقِرَاءَةَ فِي رَكْعَتَيِ الْفَجْرِ وَقَرَأَ فِيهِمَا : قُلْ يَأَيُّهَا الْكَافِرُونَ ، وَ قُلْ هُوَ اللَّهُ أَحَدٌ \" وَذَكَرَهُ الثَّوْرِيُّ ، عَنْ هِشَامٍ","","","","","Book of Prayer"
"4646","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ مُجَاهِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : \" رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَكْثَرَ مِنْ خَمْسٍ وَعِشْرِينَ أَوْ قَالَ : أَكْثَرَ مِنْ عِشْرِينَ مَرَّةً  ، شَكَّ أَبُو بَكْرٍ ، يَقْرَأُ فِي رَكْعَتَيِ الْفَجْرِ : قُلْ يَأَيُّهَا الْكَافِرُونَ ، وَ قُلْ هُوَ اللَّهُ أَحَدٌ ""","","","","","Book of Prayer"
"4647","عَنِ ابْنِ جُرَيْجٍ ، عَنْ رَجُلٍ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، أَنَّهُ سَأَلَ ابْنُ عَبَّاسٍ ، أَوْ سُئِلَ ابْنُ عَبَّاسٍ : \" مَا تَقْرَأُ فِي رَكْعَتَيِ الْفَجْرِ ؟ فَقَالَ : \" قُلْ يَأَيُّهَا الْكَافِرُونَ ، وَ قُلْ هُوَ اللَّهُ أَحَدٌ ""","","","","","Book of Prayer"
"4648","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنُ سَعِيدٍ ، عَمَّنْ سَمِعَ عَمْرَةَ يُحَدِّثُ ، عَنْ عَائِشَةَ ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي رَكْعَتَيِ الْفَجْرِ ، فَأَقُولُ لَكَ هَلْ قَرَأَ بِفَاتِحَةِ الْكِتَابِ ، أَمْ لا ؟ ""","","","","","Book of Prayer"
"4649","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ عَمْرَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُومُ لِرَكْعَتَيِ الْفَجْرِ ، فَأَقُولُ : هَلْ قَرَأَ فِيهِمَا بِأُمِّ الْقُرْآنِ ، أَمْ لا لِخِفَّتِهِ إِيَّاهُمَا ؟ ""","","","","","Book of Prayer"
"4650","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : \" يُكْرَهُ الْحَدِيثُ فِي قُبُلِ الصُّبْحِ ، قُلْتُ : أَمِنْ بَيْنِ الصَّلَوَاتِ ؟ قَالَ : نَعَمْ ، قُلْتُ : لِمَ ؟ قَالَ : أَوَ لا تَسْمَعُهُ يَقُولُ : وَقُرْآنَ الْفَجْرِ إِنَّ قُرْآنَ الْفَجْرِ كَانَ مَشْهُودًا مِنْ أَجْلِ أَنَّهُ يُشْهَدُ وَيُحْضَرُ ، قُلْتُ : فِيُخْبِرُ قَبْلَ الْفَجْرِ ؟ فَكَرِهَ ذَلِكَ أَيْضًا ""","","","","","Book of Prayer"
"4651","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : خَرَجَ ابْنُ مَسْعُودٍ عَلَى قَوْمٍ يَتَحَدَّثُونَ ، فَنَهَاهُمْ عَنِ الْحَدِيثِ ، وَقَالَ : \" إِنَّمَا جِئْتُمُ لِلصَّلاةِ إِمَّا أَنْ تُصَلُّوا ، وَإِمَّا أَنْ تَسْكُتُوا ""","","","","","Book of Prayer"
"4652","عَنْ يَحْيَى ، عَنِ الثَّوْرِيِّ ، وَابْنِ التَّيْمِيِّ ، عَنْ لَيْثٍ ، عَنْ مُجَاهِدٍ ، قَالَ : مَرَّ ابْنُ مَسْعُودٍ بِرَجُلَيْنِ يَتَكَلَّمَانِ بَعْدَ طُلُوعِ الْفَجْرِ , فَقَالَ \" يَا هَذَانِ ، إِمَّا أَنَّ تُصَلِّيَا ، وَإِمَّا أَنْ تَسْكُتَا ""","","","","","Book of Prayer"
"4653","عَنِ الثَّوْرِيِّ ، عَنْ عَمْرِو بْنِ مُرَّةَ ، عَنْ أَبِي عُبَيْدَةَ بْنِ عَبْدِ اللَّهِ ، قَالَ : \" كَانَ عَزِيزًا عَلَى عَبْدِ اللَّهِ بْنِ مَسْعُودٍ ، أَنْ يَتَكَلَّمَ بَعْدَ طُلُوعِ الْفَجْرِ إِلا بِذِكْرِ اللَّهِ ""","","","","","Book of Prayer"
"4654","عَنِ الثَّوْرِيِّ ، وَمَعْمَرٍ ، عَنِ الأَعْمَشِ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِيهِ ، قَالَ : جَاء عَبْدُ اللَّهِ عِنْدَ الْفَجْرِ وَهُمْ مُسْتَنِدُونَ ظُهُورُهُمْ إِلَى الْقِبْلَةِ ، فَقَالَ : \" تَأَخَّرُوا عَنِ الْقِبْلَةِ ، لا تَحُولُوا بَيْنَ الْمَلائِكَةِ ، وَبَيْنِ الْقِبْلَةِ ، فَإِنَّهَا صَلاةُ الْمَلائِكَةِ ""","","","","","Book of Prayer"
"4655","عَنْ مَعْمَرٍ ، عَنِ الأَعْمَشِ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِيهِ ، قَالَ : دَخَلَ ابْنُ مَسْعُودٍ الْمَسْجِدَ قَبْلَ صَلاةِ الْفَجْرِ ، فَرَأَى قَوْمًا قَدِ اسْتَنَدُوا ظُهُورُهُمْ إِلَى الْقِبْلَةِ ، وَاستقْبَلُوا النَّاسَ ، فَقَالَ : \" لا تَحُولُوا بَيْنَ الْمَلائِكَةِ وَبَيْنَ صَلاتِهَا ، فَإِنَّهَا صَلاةُ الْمَلائِكَةِ ""","","","","","Book of Prayer"
"4656","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، \" أَنَّ ابْنَ مَسْعُودٍ كَانَ يَكْرَهُ الْكَلامَ ، إِذَا صَلَّى رَكْعَتَيِ الْفَجْرِ ""","","","","","Book of Prayer"
"4657","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ خُصَيْفٍ ، قَالَ : سَأَلْتُ سَعِيدَ بْنَ جُبَيْرٍ عَنْ آيَةٍ بَعْدَ الرَّكْعَتَيْنِ ، فَلَمْ يُجِبْنِي ، قَالَ : فَلَمَّا صَلَّى ، قَالَ \" إِنَّهُ لَيَكْرَهُ الْكَلامُ بَعْدَ الرَّكْعَتَيْنِ \" ، قُلْتُ : يَقُولُ الرَّجُلُ لأَهْلِهِ الصَّلاةَ ؟ قَالَ : \" لا بَأْسَ ""","","","","","Book of Prayer"
"4658","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عُثْمَانَ بْنِ أَبِي سُلَيْمَانَ ، قَالَ \" إِذَا طَلَعَ الْفَجْرُ ، فَلْيَسْكُتُوا ، وَإِنْ كَانُوا رُكْبَانًا ، وَإِنْ لَمْ يَرْكَعُوهُمَا فَلْيَسْكُتُوا \" ، وَذُكِرَ أَنَّ ابْنَ الْمُسَيِّبِ ، كَانَ يَقُولُ : أَنَا إِذًا أَحْمَقُ مِنَ الَّذِي يَتَكَلَّمُ ، بَعْدَمَا يَطْلُعُ الْفَجْرُ","","","","","Book of Prayer"
"4659","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : أَسْمَعُهُمْ يَذْكُرُونَ رَكْعَتَيْنِ قَبْلَ الظُّهْرِ وَبَعْدَهَا ، وَبَعْدَ الْمَغْرِبِ رَكْعَتَيْنِ ، وَبَعْدَ الْعِشَاءِ ، فَقَالَ \" لَقَدْ بَلَغَنِي أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُصَلِّي بَعْدَ الْعِشَاءِ الآخِرَةِ ثَلاثَ عَشْرَةَ رَكْعَةً ، مِنْهُنَّ رَكْعَتَانِ قَبْلَ الصُّبْحِ ""","","","","","Book of Prayer"
"4660","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : عُبَيْدُ بْنُ عُمَيْرٍ ، يَقُولُ : جَاءَ رَجُلٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : كَمِ الصَّلَوَاتُ ؟ قَالَ : خَمْسٌ ، فَسَمَّاهُنَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : وَرَمَضَانُ ، قَالَ السَّائِلُ : لا أَزِيدُ عَلَيْهِمْ أَبَدًا ، ثُمَّ وَلَّى ، فَضَحِكُوا مِنْهُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِنْ يَكُنْ صَادِقًا ، يَدْخُلِ الْجَنَّةَ ، قَالَ عَطَاءٌ : إِنْ أَقَامَهُنَّ دَخَلَ الْجَنَّةَ","","","","","Book of Prayer"
"4661","عَنِ ابْنِ جُرَيْجٍ ، قَالَ قُلْتُ لِعَطَاءٍ \" هَلْ شَيْءٌ مِنَ التَّطَوُّعِ وَاجِبٌ ؟ قَالَ : لا ""","","","","","Book of Prayer"
"4662","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ ، قَالَ : قُلْنَا لَهُ : حَدِّثْنَا عَنْ تَطَوُّعِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : وَمَنْ يُطِيقُهُ ؟ قَالَ : قُلْنَا لَهُ : حَدِّثْنَا نُطِيقُ مِنْهُ مَا أطَقْنَا ، قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُمْهِلُ ، فَإِذَا ارْتَفَعَتِ الشَّمْسُ وَطَلَعَتْ وَكَانَ مِقْدَارُهَا مِنَ الْعَصْرِ مِنْ قِبَلِ الْمَشْرِقِ ، صَلَّى رَكْعَتَيْنِ يَفْصِلُ فِيهِمَا بِتَسْلِيمٍ عَلَى الْمَلائِكَةِ الْمُقَرَّبِينَ وَالنَّبِيِّينَ وَمَنْ تَبِعَهُ مِنَ الْمُؤْمِنِينَ وَالْمُسْلِمِينَ ، ثُمَّ يُمْهِلُ حَتَّى إِذَا ارْتَفَعَ الضُّحَى وَكَانَ مِقْدَارُهَا مِنَ الظُّهُرِ مِنْ قِبَلِ الْمَشْرِقِ ، صَلَّى أَرْبَعًا يَفْصِلُ فِيهَا بِالتَّسْلِيمِ كَمَا فَعَلَ فِي الأَوَّلِ ، فَإِذَا زَالَتِ الشَّمْسُ ، قَامَ فَصَلَّى أَرْبَعًا يَفْصِلُ فِيهَا بِتَسْلِيمٍ عَلَى الْمَلائِكَةِ الْمُقَرَّبِينَ وَالنَّبِيِّينَ وَمَنْ تَبِعَهُ مِنَ الْمُؤْمِنِينَ وَالْمُسْلِمِينَ ، ثُمَّ يُصَلِّي بَعْدَ الظُّهُرِ رَكْعَتَيْنِ مِثْلَ ذَلِكَ ، ثُمَّ يُصَلِّي قَبْلَ الْعَصْرِ أَرْبَعَا فَيَفْعَلُ بِمِثْلِ ذَلِكَ ""","","","","","Book of Prayer"
"4663","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، قَالَ : سَأَلْنَا عَلِيَّ بْنَ أَبِي طَالِبٍ عَنْ صَلاةِ رَسُولِ اللَّهِ تَطَوُّعًا بِالنَّهَارِ ، فَقَالَ : إِنَّكُمْ لا تُطِيقُونَ مَا كَانَ يُطِيقُ ، قَالُوا : عَلَى ذَلِكَ حَدِّثْنَا ، فَذَكَرَ مِثْلَ حَدِيثِ الثَّوْرِيِّ ، إِلا أَنَّهُ لَمْ يقُلْ : يَفْصِلُ بِالتَّسْلِيمِ عَلَى الْمَلائِكَةِ الْمُقَرَّبِينَ قَالَ : وَيُصَلِّي قَبْلَ الظُّهُرِ أَرْبَعًا وَبَعْدَهَا رَكْعَتَيْنِ ، وَقَبْلَ الْعَصْرِ أَرْبَعًا ، فَهَذِهِ سِتَّ عَشْرَةَ رَكْعَةً","","","","","Book of Prayer"
"4664","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّ ابْنَ شِهَابٍ أَخْبَرَهُ ، عَنِ ابْنِ عُمَرَ ، قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي قَبْلَ الظُّهُرِ رَكْعَتَيْنِ وَبَعْدَهَا رَكْعَتَيْنِ ، وَبَعْدَ الْجُمُعَةِ رَكْعَتَيْنِ ، وَبَعْدَ الْمَغْرِبِ رَكْعَتَيْنِ ، وَبَعْدَ الْعِشَاءِ رَكْعَتَيْنِ \" ، وَذُكِرَ لِي ابْنُ عُمَرَ الْقَائِلُ : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُصَلِّي قَبْلَ الصُّبْحِ رَكْعَتَيْنِ وَلَمْ أَرَهُ ""","","","","","Book of Prayer"
"4665","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : بَلَغَنِي عَنْ نَافِعٍ ، قَالَ : قَالَ ابْنُ عُمَرَ : \" صَلَّيْتُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَبْلَ الظُّهُرِ رَكْعَتَيْنِ وَبَعْدَ الظُّهْرِ رَكْعَتَيْنِ ، وَبَعْدَ الْمَغْرِبِ رَكْعَتَيْنِ ، وَبَعْدَ الْعِشَاءِ رَكْعَتَيْنِ ، وَبَعْدَ الْجُمُعَةِ رَكْعَتَيْنِ ، فَأَمَّا الْجُمُعَةُ وَالْمَغْرِبُ وَالْعِشَاءُ فَفِي بَيْتِهِ ""","","","","","Book of Prayer"
"4666","عَنْ مَالِكٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُصَلِّي رَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ فِي بَيْتِهِ ، وَكَانَ لا يُصَلِّي بَعْدَ الْجُمُعَةِ شَيْئًا ، حَتَّى يَدْخُلَ بَيْتَهُ فِيُصَلِّيَ فِيهِ رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4667","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : \" حَفِظْتُ عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَشْرَ رَكَعَاتٍ كَانَ يُصَلِّيهَا بِاللَّيْلِ وَالنَّهَارِ : رَكْعَتَيْنِ قَبْلَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَهَا ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَرَكْعَتَيْنِ بَعْدَ الْعِشَاءِ الآخِرَةِ ""","","","","","Book of Prayer"
"4668","وَحَدَّثَتْنِي حَفْصَةُ : \" أَنَّهُ كَانَ يُصَلِّي بَعْدَ الصُّبْحِ رَكْعَتَيْنِ \" ، أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ مِثْلَهُ","","","","","Book of Prayer"
"4669","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سَمِعْتُ أَيُّوبَ بْنَ أَبِي تَمِيمَةَ يُحَدِّثُ ، عَنِ ابْنِ عُمَرَ ، قَالَ \" صَلَّيْتُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَبْلَ الظُّهْرِ رَكْعَتَيْنِ وَبَعْدَهَا رَكْعَتَيْنِ ، وَبَعْدَ الْمَغْرِبِ رَكْعَتَيْنِ ، وَبَعْدَ الْعِشَاءِ رَكْعَتَيْنِ \" ، قَالَ : وَقَالَتْ حَفْصَةُ : \" وَكَانَ يُصَلِّي رَكْعَتَيْنِ إِذَا نَادَى ، وَكَانَ لا يَدْخُلُ عَلَيْهِ حِينَئِذٍ أَحَدٌ ""","","","","","Book of Prayer"
"4670","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَيَّبِ بْنِ أَيُّوبَ ، عَنْ رَجُلٍ ، عَنْ أَبِي رَافِعٍ الأَنْصَارِيِّ ، قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي قَبْلَ الظُّهْرِ أَرْبَعًا \" ، فَقِيلَ لَهُ : إِنَّكَ تُصَلِّي صَلاةً تُدِيمُهَا ، فَقَالَ : \" إِنَّ أَبْوَابَ السَّمَاءِ تُفْتَحُ إِذَا زَالَتِ الشَّمْسُ ، فَلا تُرْتَجُ حَتَّى تُصَلَّى الظُّهْرُ ، فَأُحِبُّ أَنْ يَصْعَدَ لِي إِلَى السَّمَاءِ خَيْرٌ ""","","","","","Book of Prayer"
"4671","عَنِ الثَّوْرِيِّ ، عَنْ عَمْرِو بْنِ مُرَّةَ ، عَنْ أَبِي عُبَيْدَةَ ، قَالَ : \" كَانَ تَطَوُّعُ عَبْدِ اللَّهِ الَّذِي لا يَنْقُصُ مِنْهُ : أَرْبَعًا قَبْلَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَهَا ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَرَكْعَتَيْنِ بَعْدَ الْعِشَاءِ ، وَرَكْعَتَيْنِ قَبْلَ صَلاةِ الْغَدَاةِ ""","","","","","Book of Prayer"
"4672","عَنْ مَعْمَرٍ ، قَالَ : \" بَلَغَنِي ، أَنَّ ابْنَ مَسْعُودٍ كَانَ يُصَلِّي قَبْلَ الظُّهْرِ أَرْبَعَ رَكَعَاتٍ وَبَعْدَهَا رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4673","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ صَفْوَانَ بْنِ سُلَيْمٍ ، عَنْ أَبِي بُسْرَةَ ، عَنِ الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ : \" غَزَوْتُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثَمَانِيَ عَشْرَةَ غَزْوَةً ، فَمَا رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تَرَكَ رَكْعَتَيْنِ حِينَ تَزِيغُ الشَّمْسُ فِي حَضَرٍ وَلا سَفَرٍ ""","","","","","Book of Prayer"
"4674","عَنْ إِبْرَاهِيمِ بْنِ مُحَمَّدٍ ، عَنْ دَاوُدَ بْنِ الْحُصَيْنِ ، عَنْ أَبِي سُفْيَانَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا فَاءَتِ الأَفْيَاءُ ، وَهَبَّتِ الأَرْوَاحُ ، فَاذْكُرُوا حَوَائِجَكُمْ ، فَإِنَّهَا سَاعَةُ الأَوَّابِينَ ""","","","","","Book of Prayer"
"4675","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ سُلَيْمَانَ بْنِ مُسْهِرٍ ، عَنْ خَرَشَةَ ، \" أَنَّ عُمَرَ كَانَ يَكْرَهُ أَنْ يُصَلِّيَ عَلَى إِثْرِ صَلاةٍ مَكْتُوبَةٍ مِثْلَهَا ""","","","","","Book of Prayer"
"4676","عَنْ مَعْمَرٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ سُلَيْمَانَ بْنِ مُسْهِرٍ ، عَنْ خَرَشَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، قَالَ : \" لا تُصَلِّيَنَّ دُبُرَ كُلِّ صَلاةٍ مَكْتُوبَةٍ مِثْلَهَا ""","","","","","Book of Prayer"
"4677","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ : \" إِذَا سَلَّمْتَ فَلَيْسَ مِثْلَهَا ""","","","","","Book of Prayer"
"4678","عَنْ إِسْرَائِيلَ ، عَنْ ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ ، عَنْ أَبِيهِ ، \" أَنَّ عَلِيًّا كَانَ يُصَلِّي بَعْدَ الْعِشَاءِ رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4679","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ ، قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي عَلَى إِثْرِ كُلِّ صَلاةٍ مَكْتُوبَةٍ رَكْعَتَيْنِ إِلا الْفَجْرَ وَالْعَصْرَ ""","","","","","Book of Prayer"
"4680","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : \" حَفِظْتُ عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ كَانَ يُصَلِّي قَبْلَ الظُّهْرِ رَكْعَتَيْنِ وَبَعْدَهَا رَكْعَتَيْنِ ، وَبَعْدَ الْجُمُعَةِ رَكْعَتَيْنِ ، وَبَعْدَ الْمَغْرِبِ رَكْعَتَيْنِ ، وَبَعْدَ الْعِشَاءِ رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4681","قَالَ : وَحَدَّثَتْنِي حَفْصَةُ : \" أَنَّهُ إِذَا طَلَعَ الْفَجْرَ صَلَّى رَكْعَتَيْنِ خَفِيفَتَيْنِ ""","","","","","Book of Prayer"
"4682","عَنْ يَحْيَى بْنِ الْعَلاءِ ، عَنْ شُعَيْبِ بْنِ خَالِدٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَبْدِ اللَّهِ بْنِ بُدَيْلٍ ، قَالَ : حَدَّثَنِي أَبْطَنُ النَّاسِ \" بَعَبْدِ اللَّهِ بْنِ مَسْعُودٍ أَنَّهُ كَانَ إِذَا زَالَتِ الشَّمْسُ قَامَ فَرَكَعَ أَرْبَعَ رَكَعَاتٍ ، فَقَرَأَ فِيهِنَّ السُّورَتَيْنِ مِنَ الْمِئِينِ ، فَإِذَا تَجَاوَبَ الْمُؤَذِّنُونَ شَدَّ عَلَيْهِ ثِيَابَهُ , ثُمَّ خَرَجَ إِلَى الصَّلاةِ ""","","","","","Book of Prayer"
"4683","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مُحَمَّدِ بْنِ قَيْسٍ ، عَنْ عَوْنِ بْنِ عَبْدِ اللَّهِ ، عَنْ أَبِيهِ ، قَالَ : \" رَأَيْتُ عُمَرَ بْنَ الْخَطَّابِ فِي بَيْتِهِ يُصَلِّي أَرْبَعًا قَبْلَ الظُّهْرِ ""","","","","","Book of Prayer"
"4684","عَنْ إِسْرَائِيلَ ، عَنْ مَجْزَأَةَ بْنِ زَاهِرٍ ، عَنْ عَمْرِو بْنِ الْحَارِثِ أَخِي جُوَيْرِيَةَ الْخُزَاعِيِّ ، قَالَ : \" مَا صَلاةٌ بَعْدَ صَلاةِ الْمَكْتُوبَةِ أَفْضَلَ مِنْ أَرْبَعِ رَكَعَاتٍ قَبْلَ الظُّهْرِ ""","","","","","Book of Prayer"
"4685","عَنْ إِسْرَائِيلَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللَّهِ بْنِ الْمُهَاجِرِ ، عَنْ عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ، عَنْ أُمِّ حَبِيبَةَ : أَنَّهَا سَمِعَتِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : \" مَنْ صَلَّى قَبْلَ الظُّهْرِ أَرْبَعَ رَكَعَاتٍ حَرَّمَ اللَّهُ عَلَيْهِ النَّارَ ""","","","","","Book of Prayer"
"4686","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ : \" لَمْ يَكُنْ أَصْحَابُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى شَيْءٍ أَشَدَّ مُثَابَرَةً مِنْهُمْ عَلَى أَرْبَعِ رَكَعَاتٍ قَبْلَ الظُّهْرِ ، وَرَكْعَتَيْنِ قَبْلَ الْغَدَاةِ ""","","","","","Book of Prayer"
"4687","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ \" كَانُوا يَعُدُّونَ مِنَ السُّنَّةِ أَرْبَعًا قَبْلَ الظُّهْرِ وَرَكْعَتَيْنِ بَعْدَهَا \" ، قَالَ : \" وَكَانُوا يَرْكَعُونَ قَبْلَ الْعَصْرِ رَكْعَتَيْنِ وَلا يَعُدُّونَهَا مِنَ السُّنَّةِ ، وَبَعْدَ الْمَغْرِبِ رَكْعَتَيْنِ ، وَبَعْدَ الْعِشَاءِ رَكْعَتَيْنِ ، وَقَبْلَ الْفَجْرِ رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4688","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ \" كَانَ يُسْتَحَبُّ إِذَا فَاتَتْهُ الأَرْبَعُ قَبْلَ الظُّهْرِ ، أَنْ يُصَلِّيَ تِلَكَ الأَرْبَعِ بَعْدَ الظُّهْرِ ""","","","","","Book of Prayer"
"4689","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ الْقَاسِمِ الشَّيْبَانِيِّ ، عَنْ زَيْدِ بْنِ أَرْقَمَ أَنَّهُ رَأَى قَوْمًا يُصَلُّونَ بَعْدَمَا طَلَعَتِ الشَّمْسُ ، فَقَالَ : \" لَوْ أَدْرَكَ هَؤُلاءِ السَّلَفَ الأُوَلَ عَلِمُوا أَنَّ غَيْرَ هَذِهِ الصَّلاةِ خَيْرٌ مِنْهَا صَلاةُ الأَوَّابِينَ ، إِذَا رَمَضَتِ الْفِصَالُ ""","","","","","Book of Prayer"
"4690","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، قَالَ : سَمِعْتُ مَكْحُولا وَجِئْتُ أُسَلِّمُ عَلَيْهِ ، فَقَالَ : بَلَغَنِي ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" مَنْ صَلَّى رَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، قَبْلَ أَنْ يَتَكَلَّمَ كُتِبَا أَوْ رُفِعَتَا فِي عِلِّيِّينَ ""","","","","","Book of Prayer"
"4691","عَنِ الثَّوْرِيِّ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ \" كَانُوا يَسْتَحِبُّونَ أَنْ يَرْكَعُوا بَعْدَ الْمَغْرِبِ : قُلْ يَأَيُّهَا الْكَافِرُونَ ، وَ قُلْ هُوَ اللَّهُ أَحَدٌ ، وَبَعْدَ الْعِشَاءِ فِي رَكْعَتَيْنِ بِآخِرِ سُورَةِ الْبَقَرَةِ  آمَنَ الرَّسُولُ وَبِـ قُلْ هُوَ اللَّهُ أَحَدٌ ، وَقَبْلَ الْفَجْرِ بِـ قُلْ يَأَيُّهَا الْكَافِرُونَ ، وَ قُلْ هُوَ اللَّهُ أَحَدٌ ""","","","","","Book of Prayer"
"4692","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ هِلالِ بْنِ يَسَافٍ ، عَنْ ضَمْرَةَ بْنِ حَبِيبِ بْنِ صُهَيْبٍ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" تَطُوُّعُ الرَّجُلِ فِي بَيْتِهِ يَزِيدُ عَلَى تَطَوُّعِهِ عِنْدَ النَّاسِ ، كَفَضْلِ صَلاةِ الْجَمَاعَةِ عَلَى صَلاةِ الرَّجُلِ وَحْدَهُ \" ، عَنْ مَعْمَرٍ ، عَنِ الأَعْمَشِ ، عَنْ هِلالِ بْنِ يَسَافٍ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ","","","","","Book of Prayer"
"4693","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي سُفْيَانَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ : حَدَّثَنَا أَبُو سَعِيدٍ الْخُدْرِيُّ ، قَالَ \" إِذَا صَلَّى أَحَدُكُمْ صَلاةً فِي الْمَسْجِدِ ، فَلْيَجْعَلْ لِبَيْتِهِ نَصِيبًا مِنْ صَلاتِهِ ، إِنَّ اللَّهَ جَاعِلٌ فِي بَيْتِهِ مِنْ صَلاتِهِ خَيْرًا ""","","","","","Book of Prayer"
"4694","عَنْ يَحْيَى بْنِ الْعَلاءِ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمِ بْنِ صُبَيْحٍ ، عَنْ مَسْرُوقٍ ، قَالَ : كُنَّا نَقْعُدُ فِي الْمَسْجِدِ بَعْدَ قِيَامِ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ نُثَبِّتُ النَّاسَ عَلَى الْقِرَاءَةِ ، فَإِذَا أَرَدْنَا أَنْ نَرْجِعَ صَلَّيْنَا رَكْعَتَيْنِ ، فَبَلَغَ ذَلِكَ عَبْدَ اللَّهِ ، فَقَالَ \" تُحَمِّلُونَ النَّاسَ مَا لا يُحَمِّلُهُمُ اللَّهُ ، يَرَوْنَكُمْ تُصَلُّونَ ، فَيَرَوْنَ ذَلِكَ وَاجِبًا عَلَيْهِمْ ، إِنْ كُنْتُمْ لا بُدَّ فَاعِلِينَ فَفِي الْبُيُوتِ ""","","","","","Book of Prayer"
"4695","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ عَجْلانَ ، عَنْ رَجُلٍ يُقَالُ لَهُ : سُهَيْلٌ ، عَنِ الْحَسَنِ بْنِ عَلِيٍّ ، قَالَ : رَأَى قَوْمًا عِنْدَ الْقَبْرِ فَنَهَاهُمْ ، وَقَالَ : إِنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" لا تَتَّخِذُوا بَيْتِي عِيدًا ، وَلا تَتَّخِذُوا بُيُوتَكُمْ قُبُورًا ، وَصَلُّوا عَلَيَّ حَيْثُمَا كُنْتُمْ فَإِنَّ صَلاتَكُمْ تَبْلُغُنِي ""","","","","","Book of Prayer"
"4696","عَنِ الثَّوْرِيِّ ، عَنْ نُسَيْرِ بْنِ ذُعْلُوقٍ ، قَالَ : \" مَا رَأَيْتُ الرَّبِيعَ بْنَ خُثَيْمٍ ، مُتَطَوِّعًا فِي مَسْجِدِ الْحَيِّ قَطُّ ""","","","","","Book of Prayer"
"4697","عَنْ أَبِي بَكْرِ بْنِ عَيَّاشٍ ، عَنْ عَطَاءِ بْنِ السَّائِبِ ، قَالَ \" رَأَيْتُ خِيَارَ أَصْحَابِ عَلِيٍّ : زَاذَانَ ، وَمَيْسَرَةَ ، وَأَبَا الْبَخْتَرِيِّ ، يُؤْثِرُونَ الْمَسْجِدَ فِي شَهْرِ رَمَضَانَ عَلَى أَهْلِيهِمْ ، يَعْنِي يَقُومُونَ مَعَ النَّاسِ ""","","","","","Book of Prayer"
"4698","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَبِي غَالِبٍ ، قَالَ : سَأَلْتُ أَبَا أُمَامَةَ عَنِ النَّافِلَةِ ، فَقَالَ : \" كَانَتْ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَافِلَةٌ ، وَلَكُمْ فَضِيلَةٌ ""","","","","","Book of Prayer"
"4699","عَنْ مَعْمَرٍ ، عَمَّنْ سَمِعَ الْحَسَنَ ، يَقُولُ : قَالَ رَجُلٌ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" يَا رَسُولَ اللَّهِ , أَيُّ الْمُؤْمِنِينَ أَفْضَلُ إِيمَانًا ؟ قَالَ : أَحْسَنُهُمْ أَخْلاقًا ، قَالَ : فَأَيُّ الإِيمَانِ أَفْضَلُ ؟ قَالَ : الصَّبْرُ وَالسَّمَاحَةُ ، قَالَ : فَأَيُّ الْهِجْرَةِ أَفْضَلُ ؟ قَالَ : مَنْ هَجَرَ مَا نَهَاهُ اللَّهُ عَنْهُ ، قَالَ : فَأَيُّ الْجِهَادِ أَفْضَلُ ؟ قَالَ : مَنْ عُقِرَ جَوَادُهُ وَأُهْرِيقَ دَمُهُ ، قَالَ : فَأَيُّ الصَّدَقَةِ أَفْضَلُ ؟ قَالَ : جَهْدُ الْمُقِلِّ ، قَالَ : فَأَيُّ الصَّلاةِ أَفْضَلُ ؟ قَالَ : طُولُ الْقُنُوتِ \" ، ذَكَرَهُ مَعْمَرٌ ، عَنْ عَمْرٍو","","","","","Book of Prayer"
"4700","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، قَالَ : سَمِعْتُ عُبَيْدَ بْنَ عُمَيْرٍ ، يُحَدِّثُ قَالَ : قِيلَ : \" أَيُّ الْجِهَادِ أَفْضَلُ ؟ قَالَ : مَنْ عُقِرَ جَوَادُهُ وَأُهْرِيقَ دَمُهُ ، قِيلَ : فَأَيُّ الصَّلَوَاتِ أَفْضَلُ ؟ قَالَ : طُولُ الْقُنُوتِ ، قِيلَ : فَأَيُّ الصَّدَقَةِ أَفْضَلُ ؟ قَالَ : جَهْدُ الْمُقِلِّ ، قِيلَ : فَأَيُّ الْهِجْرَةِ أَفْضَلُ ؟ قَالَ : مَنْ هَجَرَ مَا نَهَاهُ اللَّهُ عَنْهُ وَرَسُولُهُ ، قِيلَ : فَأَيُّ النَّاسِ أَحْكَمُ ؟ قَالَ : الَّذِي يَحْكُمُ لِلنَّاسِ كَمَا يَحْكُمُ لِنَفْسِهِ ، قِيلَ : فَأَيُّ النَّاسِ أَعْلَمُ ؟ قَالَ : الَّذِي يَجْمَعُ عِلْمَ النَّاسِ إِلَى عِلْمِهِ \" ، قَالَ : لا أَعْلَمُ عُبَيْدًا إِلا رَفَعَهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","","","","","Book of Prayer"
"4701","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي سَعِيدٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ : سُئِلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَيُّ الصَّلاةِ أَفْضَلُ ؟ قَالَ : \" طُولُ الْقُنُوتِ ""","","","","","Book of Prayer"
"4702","عَنِ الأَوْزَاعِيِّ ، عَنِ الْوَلِيدِ بْنِ هِشَامٍ ، عَنْ رَجُلٍ ، قَالَ : قُلْتُ لِثَوْبَانَ حَدِّثْنِي بِحَدِيثٍ لَعَلَّ اللَّهَ أَنْ يَنْفَعَنِي بِهِ ، قَالَ : قُلْتُ لَهُ ذَلِكَ ثَلاثَ مَرَّاتٍ ، فَقَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : \" مَا مِنْ عَبْدٍ يَسْجُدُ لِلَّهُ سَجْدَةً ، إِلا رَفَعَهُ اللَّهُ بِهَا دَرَجَةً وَحَطَّ عَنْهُ بِهَا خَطِيئَةً ""","","","","","Book of Prayer"
"4703","عَنِ الأَوْزَاعِيِّ ، عَنْ هَارُونَ ، عَنِ الأَحْنَفِ بْنِ قَيْسٍ ، عَنْ أَبِي ذَرٍّ ، قَالَ : أَخْبَرَنِي حِبِّي أَبُو الْقَاسِمِ ، ثُمَّ بَكَا ، قَالَهَا ثَلاثًا ، وَهُوَ يَبْكِي ، ثُمَّ قَالَ الثَّالِثَةَ أَخْبَرَنِي حِبِّي أَبُو الْقَاسِمِ \" مَا مِنْ عَبْدٍ يَسْجُدُ لِلَّهِ سَجْدَةً ، إِلا رَفَعَهُ اللَّهُ بِهَا دَرَجَةً ، وَحَطَّ عَنْهُ بِهَا خَطِيئَةً ، وَكُتِبَ لَهُ بِهَا حَسَنَةٌ ""","","","","","Book of Prayer"
"4704","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ ابْنِ مَسْعُودٍ قَالَ : \" إِذَا رَأَى الشَّيْطَانُ ابْنَ آدَمَ سَاجِدًا ، قَالَ : يَا وَيْلَهُ ، وَيْلٌ لِلشَّيْطَانِ ، أَمَرَ اللَّهُ ابْنَ آدَمَ أَنْ يَسْجُدَ وَلَهُ الْجَنَّةُ فَأَطَاعَ ، وَأَمَرَنِي أَنْ أَسْجُدَ فَعَصَيْتُ فَلِيَ النَّارُ ""","","","","","Book of Prayer"
"4705","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَطَاءٌ ، أَنَّ أَبَا هُرَيْرَةَ ، قَالَ : \" ثَلاثٌ لا أَدَعُهُنَّ حَتَّى أَلْقَى أَبَا الْقَاسِمِ أَنْ أَبِيتَ كُلَّ لَيْلَةٍ عَلَى وِتْرٍ ، وَأَنْ أَصُومَ مِنْ كُلِّ شَهْرٍ ثَلاثَةَ أَيَّامٍ ، وَصَلاةُ الضُّحَى \" ، قَالَ ابْنُ جُرَيْجٍ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْ زِدْتُ عَلَى ثَلاثَةِ أَيَّامٍ ، فَقَالَ : فَهُوَ خَيْرٌ","","","","","Book of Prayer"
"4706","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : أَوْصَانِي النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، بِثَلاثٍ لَسْتُ بِتَارِكِهِنَّ ، لا فِي سَفَرٍ وَلا حَضَرٍ : \" نَوْمٌ عَلَى وِتْرٍ ، وَصِيَامُ ثَلاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ ، وَصَلاةُ الضُّحَى \" ، قَالَ : ثُمَّ وَهِمَ الْحَسَنُ بَعْدُ ؛ فَجَعَلَ مَكَانَ الضُّحَى غُسْلَ يَوْمِ الْجُمُعَةِ","","","","","Book of Prayer"
"4707","عَنْ إِسْرَائِيلَ ، عَنْ يُونُسَ ، عَنْ سِمَاكِ بْنِ حَرْبٍ ، عَنْ أَبِي الرَّبِيعِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : \" عَهِدَ إِلَيَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي ثَلاثٍ لا أَدَعُهُنَّ أَبَدًا : أَنْ لا أَنَامَ إِلا عَلَى وِتْرٍ ، وَصَلاةُ الضُّحَى ، وَصِيَامُ ثَلاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ ""","","","","","Book of Prayer"
"4708","عَنْ عَمْرِو بْنِ دِينَارٍ ، قَالَ : سَمِعْتُ مُجَاهِدًا ، يَقُولُ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي الضُّحَى رَكْعَتَيْنِ ، وَأَرْبَعًا وَسِتًّا وَثَمَانِيًا ""","","","","","Book of Prayer"
"4709","وَمَعْمَرٌ ، عَنْ قَتَادَةَ ، عَنْ مُعَاذَةَ الْعَدَوِيَّةِ ، عَنْ عَائِشَةَ ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي صَلاةَ الضُّحَى أَرْبَعَ رَكَعَاتٍ ، وَيَزِيدُ مَا شَاءَ اللَّهُ ""","","","","","Book of Prayer"
"4710","عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ ، عَنْ أَبَانَ ، عَنِ الْحَسَنِ ، \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُصَلِّي صَلاةَ الضُّحَى \" ، فَقِيلَ : مَا هَذِهِ ؟ قَالَ : \" صَلاةُ رَغْبَةٍ ، وَرَهْبَةٍ ""","","","","","Book of Prayer"
"4711","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ ، عَنْ سُلَيْمَانَ بْنِ قَيْسٍ ، عَنْ عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ، عَنْ أُمِّ حَبِيبَةَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" مَنْ صَلَّى فِي يَوْمٍ اثْنَتَيْ عَشْرَةَ رَكْعَةً ، بَنَى اللَّهُ لَهُ بَيْتًا فِي الْجَنَّةِ ، وَمَنْ بَنَى مَسْجِدًا ، بَنَى اللَّهُ لَهُ أَوْسَعَ مِنْهُ ""","","","","","Book of Prayer"
"4712","عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ : قَالَ اللَّهُ \" يَا ابْنَ آدَمَ ، أتَعْجِزُ أَنْ تُصَلِّيَ أَرْبَعَ رَكَعَاتٍ فِي أَوَّلِ النَّهَارِ أَكْفِكَ آخِرَهُ ""","","","","","Book of Prayer"
"4713","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنَا عَطَاءٌ ، عَنْ أُمِّ هَانِئٍ بِنْتِ أَبِي طَالِبٍ ، \" أَنَّهَا دَخَلَتْ عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَوْمَ الْفَتْحِ وَهُوَ فِي قُبَّةٍ لَهُ ، فَوَجَدْتُهُ قَدِ اغْتَسَلَ بِمَاءٍ كَانَ فِي صَحْفَةٍ ، إِنِّي لأَرَى فِيهَا أَثَرَ الْعَجِينِ ، وَرَأَيْتُهُ يُصَلِّي الضُّحَى ""","","","","","Book of Prayer"
"4714","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : حَدَّثَنَا ابْنُ شِهَابٍ ، عَنْ عَبْدِ اللَّهِ بْنِ الْحَارِثِ ، عَنْ أُمِّ هَانِئٍ وَكَانَ نَازِلا عَلَيْهَا \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سُتِرَ عَلَيْهِ ، فَاغْتَسَلَ فِي الضُّحَى ، فَصَلَّى ثَمَانِ رَكَعَاتٍ لا يُدْرَى أَقِيَامُهَا أَطْوَلُ أَمْ رُكُوعُهَا أَمْ سُجُودُهَا ؟ ""","","","","","Book of Prayer"
"4715","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ أُمِّ هَانِئٍ \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى ثَمَانِ رَكَعَاتٍ فِي الضُّحَى ، قِيَامُهُنَّ وَرُكُوعُهُنَّ وَسُجُودُهُنَّ قَرِيبٌ مِنَ السَّوَاءِ ""","","","","","Book of Prayer"
"4716","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنِ الْمُطَلِّبِ بْنِ عَبْدِ اللَّهِ بْنِ حَنْطَبٍ ، عَنْ أُمِّ هَانِئٍ ، قَالَتْ : \" نَزَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمَ الْفَتْحِ بِأَعْلَى مَكَّةَ فَأَتَيْتُهُ ، فَجَاءَهُ أَبُو ذَرٍّ بِجَفْنَةٍ فِيهَا مَاءٌ \" ، قَالَتْ : إِنِّي لأَرَى فِيهَا أَثَرَ الْعَجِينِ ، قَالَ : \" فَسَتَرَهُ أَبُو ذَرٍّ ، فَاغْتَسَلَ ، ثُمَّ سَتَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَبَا ذَرٍّ ، فَاغْتَسَلَ ، ثُمَّ صَلَّى ثَمَانِ رَكَعَاتٍ وَذَلِكَ ضُحًى ""","","","","","Book of Prayer"
"4717","عَنْ مَالِكٍ ، عَنْ مَيْمُونِ بْنِ مَيْسَرَةَ ، عَنْ أَبِي مُرَّةَ مَوْلَى عَقِيلٍ ، عَنْ أُمِّ هَانِئٍ ، قَالَ : سَمِعْتُهَا ، تَقُولُ : \" ذَهَبْتُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَامَ الْفَتْحِ ، فَوَجَدْتُهُ يَغْتَسِلُ ، وَفَاطِمَةُ ابْنَتُهُ تَسْتُرُهُ بِثَوْبٍ ، فَسَلَّمْتُ ، وَذَلِكَ فِي الضُّحَى ، فَقَالَ : مَنْ هَذَا ؟ فَقُلْتُ : أُمُّ هَانِئٍ بِنْتُ أَبِي طَالِبٍ ، قَالَ : مَرْحَبًا بِأُمِّ هَانِئٍ ، فَلَمَّا فَرَغَ مِنْ غُسْلِهِ ، صَلَّى ثَمَانِ رَكَعَاتٍ مُلْتَحِفًا فِي ثَوْبٍ وَاحِدٍ ، ثُمَّ انْصَرَفَ ، فَقُلْتُ : يَا رَسُولَ اللَّهِ ، زَعَمَ ابْنُ أُمِّي أَنَّهُ قَاتَلَ فُلانَ ابْنَ أُمَيَّةَ رَجُلا قَدْ أَجَرْتُهُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : قَدْ أَجَرْنَا مَنْ أَجَارَتْ أُمُّ هَانِئٍ ""","","","","","Book of Prayer"
"4718","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : سَأَلْتُهُ عَنْ صَلاةِ الضُّحَى ، فَقَالَ : كَانَ أَصْحَابُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلُّونَ بِالْهَوَاجِرِ ، أَوْ قَالَ : بِالْهَجِيرِ ، \" وَلَمْ يُصَلِّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاةَ الضُّحَى قَطُّ إِلا يَوْمَ فَتْحِ مَكَّةَ ، وَإِذَا قَدِمَ مِنْ سَفَرٍ ""","","","","","Book of Prayer"
"4719","عَنِ الزُّهْرِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ كَعْبِ بْنِ مَالِكٍ ، عَنْ أَبِيهِ \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَدِمَ مِنْ غَزْوَةِ تَبُوكَ الْمَدِينَةَ ضُحًى فَصَلَّى فِي الْمَسْجِدِ رَكْعَتَيْنِ \" ، قَالَ : وَكَانَ إِذَا جَاءَ مِنْ سَفَرٍ فَعَلَ ذَلِكَ","","","","","Book of Prayer"
"4720","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : حَدَّثَنِي ابْنُ شِهَابٍ ، أَنَّ عَبْدَ الرَّحْمَنِ بْنَ عَبْدِ اللَّهِ بْنِ كَعْبِ بْنِ مَالِكٍ حَدَّثَهُ ، عَنْ أَبِيهِ عَبْدِ اللَّهِ بْنِ كَعْبٍ ، وعَنْ عَمِّهِ عُبَيْدِ اللَّهِ بْنِ كَعْبٍ ، عَنْ كَعْبِ بْنِ مَالِكٍ ، قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لا يَقْدَمُ مِنْ سَفَرٍ إِلا نَهَارًا فِي الضُّحَى ، فَإِذَا قَدِمَ بَدَأَ بِالْمَسْجِدِ فَصَلَّى فِيهِ رَكْعَتَيْنِ ، ثُمَّ جَلَسَ فِيهِ ""","","","","","Book of Prayer"
"4721","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : حَدَّثِنِي جَعْفَرُ بْنُ مُحَمَّدٍ ، أَنَّ عَلِيَّ بْنَ أَبِي طَالِبٍ ، كَانَ يُذْكَرُ لَهُ هَذِهِ الصَّلاةُ الَّتِي أَحْدَثَ النَّاسُ ، فَيَقُولُ : \" صَلُّوا مَا اسْتَطَعْتُمْ , فَإِنَّ اللَّهَ لا يُعَذِّبُ عَلَى الصَّلاةِ ""","","","","","Book of Prayer"
"4722","عَنْ مَالِكٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، \" أَنَّ عَائِشَةَ كَانَتْ تُصَلِّي الضُّحَى ثَمَانِ رَكَعَاتٍ ، وَتَقُولُ : لَوْ نُشِرَ لِي أَبِي مَا تَرَكْتُهُنَّ ""","","","","","Book of Prayer"
"4723","عَنْ مَعْمَرٍ ، عَنِ ابْنِ شِهَابٍ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، كَانَتْ تَقُولُ : مَا كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُسَبِّحُ سُبْحَةَ الضُّحَى ، قَالَ : وَكَانَتْ عَائِشَةُ تُسَبِّحُهَا ، وَكَانَتْ تَقُولُ : \" إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَتْرُكُ الْعَمَلَ خَشْيَةَ أَنْ يَسْتَنَّ بِهِ النَّاسُ ، فِيُفْرَضَ عَلَيْهِمْ ، وَكَانَ يُحِبُّ مَا خَفَّ عَلَى النَّاسِ ""","","","","","Book of Prayer"
"4724","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ \" لَقَدْ قُتِلَ عُثْمَانُ وَمَا أَحَدٌ يُسَبِّحُهَا ، وَمَا أَحْدَثَ النَّاسُ شَيْئًا أَحَبَّ إِلَيَّ مِنْهَا ""","","","","","Book of Prayer"
"4725","عَنِ ابْنِ جُرَيْجٍ ، أَوْ مَعْمَرٍ ، قَالَ : قَالَ ابْنُ شِهَابٍ : حَدَّثَنِي سَالِمُ بْنُ عَبْدِ اللَّهِ ، عَنِ ابْنِ عُمَرَ أَنَّهُ ، قَالَ : \" قَدْ أُصِيبَ عُثْمَانُ ، وَمَا أَحَدٌ يُسَبِّحُهَا ، وَإِنَّهَا لَمِنْ أَحَبِّ مَا أَحْدَثَ النَّاسُ إِلَيَّ \" ، قَالَ : قَالَ ابْنُ جُرَيْجٍ ، وَقَالَ نَاسٌ : أَوَّلُ مَنْ صَلاهَا أَهْلُ الْبَوَادِي يَدْخُلُونَ الْمَسْجِدَ ، إِذَا فَرِغُوا مِنْ أَسْوَاقِهِمْ","","","","","Book of Prayer"
"4726","عَنْ مَعْمَرٍ ، عَنْ عَطَاءٍ الْخُرَاسَانِيِّ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ \" لَمْ يَزَلْ فِي نَفْسِي مِنْ صَلاةِ الضُّحَى شَيْءٌ حَتَّى قَرَأْتُ :  سَخَّرْنَا الْجِبَالَ مَعَهُ يُسَبِّحْنَ بِالْعَشِيِّ وَالإِشْرَاقِ ""","","","","","Book of Prayer"
"4727","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي سُلَيْمَانُ الأَحْوَلُ ، أَنَّهُ سَمِعَ عَطَاءً الْخُرَاسَانِيَّ ، يَقُولُ لِطَاوُسٍ : إِنَّ ابْنَ عَبَّاسٍ ، يَقُولُ : \" صَلاةُ الضُّحَى فِي الْقُرْآنِ ، وَلَكِنْ لا يَغُوصُ عَلَيْهَا إِلا غَائِصٌ ، ثُمَّ قَرَأَ :  يُسَبِّحْنَ بِالْعَشِيِّ وَالإِشْرَاقِ \" ، قَالَ طَاوُسٌ : وَاللَّهُ مَا صَلاهَا ابْنُ عَبَّاسٍ حَتَّى مَاتَ ، إِلا أَنْ يَطُوفَ بِالْبَيْتِ","","","","","Book of Prayer"
"4728","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي سُلَيْمَانُ أَيْضًا أَنَّهُ سَمِعَ طَاوُسًا ، يَقُولُ : \" إِنَّ أَوَّلَ مَنْ صَلاهَا الأَعْرَابُ ، إِذَا بَاعَ أَحَدُهُمْ بِضَاعَةً يَأْتِي الْمَسْجِدَ فَيُكَبِّرُ ، وَيَسْجُدُ \" ، إِلا أَنَّ طَاوُسًا ، يَقُولُ : \" اللَّهُ أَكْبَرُ ، اللَّهُ أَكْبَرُ ، اللَّهُ أَكْبَرُ ، ثُمَّ يَسْجُدُ الأَعْرَابِيُّ ""","","","","","Book of Prayer"
"4729","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّ ابْنَ عَبَّاسٍ ، قَالَ : \" صَلاةُ الضُّحَى إِذَا انْقَطَعَتِ الظِّلالُ ""","","","","","Book of Prayer"
"4730","عَنِ ابْنِ عُيَيْنَةَ ، قَالَ : أَخْبَرَنِي شَيْخٌ مِنْ بَجِيلَةَ ، قَالَ : سَمِعْتُ الشَّعْبِيَّ ، يَقُولُ : \" كَانَ عَبْدُ اللَّهِ بْنُ مَسْعُودٍ لا يُصَلِّي الضُّحَى ، وَيُصَلِّي مَا بَيْنَ الظُّهْرِ وَالْعَصْرِ مَعَ عُقْبَةَ مِنَ اللَّيْلِ طَوِيلَةً ""","","","","","Book of Prayer"
"4731","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مُجَالِدِ بْنِ سَعِيدٍ ، عَنِ الشَّعْبِيِّ ، عَنْ عَمِّهِ قَيْسِ بْنِ عَبْدٍ ، قَالَ : \" اخْتَلَفْتُ إِلَى عَبْدِ اللَّهِ بْنِ مَسْعُودٍ سَنَةً ، فَمَا رَأَيْتُهُ مُصَلِّيًا صَلاةَ الضُّحَى ، وَلا صَائِمًا يَوْمًا مِنْ غَيْرِ رَمَضَانَ ، قَالَ : فَبَيْنَا نَحْنَ عِنْدَهُ ذَاتَ لَيْلَةٍ ، أُتِيَ فَقِيلَ لَهُ : هَذَا رَسُولُ الْوَلِيدِ ، فَقَالَ عَبْدُ اللَّهِ : أَطْفِئُوا الْمِصْبَاحَ ، فَدَخَلَ , فَقَالَ لَهُ : إِنَّ الأَمِيرَ ، يَقُولُ لَكَ : اتْرُكْ هَؤُلاءِ الْكَلِمَاتِ الَّتِي تَقُولُ ، قَالَ : وَمَا هُنَّ ؟ قَالَ : هَذِهِ الْكَلِمَاتُ ؟ قَالَ : فَلَمْ يَزَلْ يُرَدِّدُهُنَّ ، قَالَ : قَوْلُكَ : كُلُّ مُحْدَثَةٍ بِدْعَةٌ ، قَالَ : إِنِّي لَنْ أَتْرُكَهُنَّ ، قَالَ : فَإِنَّهُ يَقُولُ لَكَ : فَاخْرُجْ ، قَالَ : فَإِنِّي خَارِجٌ ، قَالَ : فَخَرَجَ إِلَى الْمَدِينَةِ \" . عَنْ رَجُلٍ ، عَنْ شُعْبَةَ ، عَنْ سَعْدِ بْنِ إِبْرَاهِيمَ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، قَالَ : \" مَا رَأَيْتُهُ صَلاهَا ""","","","","","Book of Prayer"
"4732","عَنْ عَبْدِ الرَّحْمَنِ بْنِ زَيْدِ بْنِ أَسْلَمَ ، عَنْ أَبِيهِ ، عَنْ سَالِمِ بْنِ عَبْدِ اللَّهِ ، قَالَ : قُلْتُ لِعَبْدِ اللَّهِ بْنِ عُمَرَ : مَا لِي لا أَرَاكَ تُصَلِّي الضُّحَى ؟ قَالَ : لَمْ أَرَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّيهَا","","","","","Book of Prayer"
"4733","عَنْ أَبِيهِ ، عَنْ خَلادِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، وَمُجَاهِدٍ ، قَالا : \" مَنْ صَلَّى الضُّحَى ثَمَانِ رَكَعَاتٍ ، كُتِبَ مِنَ الأَوَّابِينَ ، إِنَّهُ كَانَ لِلأَوَّابِينَ غَفُورًا","","","","","Book of Prayer"
"4734","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ إِسْمَاعِيلَ ، عَنِ الشَّعْبِيِّ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ ، يَقُولُ : \" مَا صَلَّيْتُ الضُّحَى مُنْذُ أَسْلَمْتُ ""","","","","","Book of Prayer"
"4735","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنْ نُعَيْمِ بْنِ أَبِي هِنْدَ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ، أَنَّهُ قَالَ فِي الرَّجُلِ يُصَلِّي بِصَلاةِ الإِمَامِ ، قَالَ : \" إِذَا كَانَ بَيْنَهُمَا نَهَرٌ أَوْ طَرِيقٌ أَوْ جِدَارٌ ، فَلا يَأْتَمُّ بِهِ ""","","","","","Book of Prayer"
"4736","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ ، عَنْ عِيسَى ، قَالَ : سَأَلْتُ عَامِرًا الشَّعْبِيَّ \" عَنِ الْمَرْأَةِ تُصَلِّي بِصَلاةِ الإِمَامِ بَيْنَهُمَا طَرِيقٌ ، قَالَ : لَيْسَ ذَلِكَ لَهَا ""","","","","","Book of Prayer"
"4737","عَنِ ابْنِ الْمُجَالِدِ ، عَنْ أَبِيهِ ، عَنْ إِبْرَاهِيمَ النَّخَعِيِّ \" أَنَّهُ قَالَ فِي الرَّجُلِ يُصَلِّي بِصَلاةِ الإِمَامِ بَيْنَهُمَا حَائِطٌ قَالَ : حَسَنٌ ، مَا لَمْ يَكُنْ بَيْنَهُمَا طَرِيقٌ أَوْ نِسَاءٌ ""","","","","","Book of Prayer"
"4738","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ عَبْدِ الْحَمِيدِ بْنِ سُهَيْلٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ عَائِشَةَ \" أَنَّهَا كَانَتْ تُصَلِّي بِصَلاةِ الإِمَامِ فِي بَيْتِهَا ، وَهُوَ فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"4739","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنْ أَبِي مِجْلَزٍ ، قَالَ \" تُصَلِّي الْمَرْأَةُ بِصَلاةِ الإِمَامِ ، وَإِنْ كَانَ بَيْنَهُمَا طَرِيقٌ أَوْ جِدَارٌ بَعْدَ أَنْ تَسْمَعَ التَّكْبِيرَ فَلا بَأْسَ ""","","","","","Book of Prayer"
"4740","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، قَالَ \" جِئْتُ أَنَا ، وَأَبِي مُرَّةَ ، فَوَجَدْنَا الْمَسْجِدَ قَدِ امْتَلأَ ، فَصَلَّيْنَا بِصَلاةِ الإِمَامِ فِي دَارٍ عِنْدَ الْمَسْجِدِ بَيْنَهُمَا طَرِيقٌ \" ، عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ مِثْلَهُ ، إِلا أَنَّهُ قَالَ : صَلَّيْنَا فِي دَارِ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ","","","","","Book of Prayer"
"4741","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ عَبْدِ الْحَمِيدِ بْنِ سُهَيْلٍ ، عَنْ صَالِحِ بْنِ إِبْرَاهِيمَ ، أَنَّهُ \" رَأَى أَنَسَ بْنَ مَالِكٍ صَلَّى الْجُمُعَةَ فِي دَارِ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ بِصَلاةِ الْوَلِيدِ بْنِ عَبْدِ الْمَلِكِ وَبَيْنَهُمَا طَرِيقٌ ""","","","","","Book of Prayer"
"4742","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ صَالِحٍ مَوْلَى التَّوْأَمَةِ ، أَنَّهُ رَأَى أَبَا هُرَيْرَةَ ، \" يُصَلِّي عَلَى ظَهْرِ الْمَسْجِدِ بِصَلاةِ الإِمَامِ وَهُوَ تَحْتَهُ ""","","","","","Book of Prayer"
"4743","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عَبَّادِ بْنِ تَمِيمٍ ، عَنْ عَمِّهِ ، قَالَ \" خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالنَّاسِ يَسْتَسْقِي ، فَصَلَّى بِهِمْ رَكْعَتَيْنِ جَهْرًا بِالْقِرَاءَةِ فِيهِمَا ، وَحَوَّلَ رِدَاءَهُ وَدَعَا وَاسْتَقْبَلَ الْقِبْلَةَ ""","","","","","Book of Prayer"
"4744","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمِ ، عَنْ عَبَّادِ بْنِ تَمِيمٍ ، عَنْ عَمِّهِ \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اسْتَسْقَى ، فَاسْتَقْبَلَ الْقِبْلَةَ وَحَوَّلَ رِدَاءَهُ ""","","","","","Book of Prayer"
"4745","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ صَالِحٍ مَوْلَى التَّوْأَمَةِ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ ، يَقُولُ : \" اسْتَمْطَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَصَلَّى بِالْمُصَلَّى رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4746","عَنْ مَعْمَرٍ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ ، رَفَعَهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : إِنَّ اللَّهَ لَيَضْحَكُ مِنْكُمْ أَزِلِينَ بقُرْبِ الْغَيْثِ مِنْكُمْ ، قَالَ : فَقَالَ رَجُلٌ مِنْ بَاهِلَةَ : يَا رَسُولَ اللَّهِ ، إِنَّ رَبَّنَا لَيَضْحَكُ ؟ قَالَ : نَعَمْ ، قَالَ : فَوَاللَّهِ , لا عَدِمْنَا الْخَيْرَ مِنْ رَبٍّ يَضْحَكُ","","","","","Book of Prayer"
"4747","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ إِسْحَاقَ بْنِ عَبْدِ اللَّهِ بْنِ كِنَانَةَ ، قَالَ : حَدَّثَنِي أَبِي ، قَالَ : أَرْسَلَنِي أَمِيرٌ مِنَ الأُمَرَاءِ إِلَى ابْنِ عَبَّاسٍ أَسْأَلَهُ عَنِ الاسْتِسْقَاءِ ، فَقَالَ ابْنُ عَبَّاسٍ : \" خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مُتَوَاضِعًا مُتَضَرِّعًا مُتَذَلِّلا فَخَطَبَ ، وَلَمْ يَخْطُبْ كَخُطْبَتِكُمْ هَذِهِ ، فَدَعَا وَصَلَّى كَمَا يُصَلِّي فِي الْعِيدِ رَكْعَتَيْنِ \" ، قَالَ سُفْيَانُ : فَقُلْتُ : أَقَبْلَ الْخُطْبَةِ صَلَّى ، أَمْ بَعْدَهَا ؟ قَالَ : \" لا أَدْرِي ""","","","","","Book of Prayer"
"4748","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ أَبِي الْحُوَيْرِثِ ، عَنْ ابْنِ إِسْحَاقَ بْنِ عَبْدِ اللَّهِ بْنِ كِنَانَةَ ، عَنْ أَبِيهِ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَظُنُّ أَنَّهُ كَانَ يُكَبِّرُ فِي الْفِطْرِ وَالأَضْحَى وَالاسْتِسْقَاءِ ، سَبْعًا فِي الأُولَى ، وَخَمْسًا فِي الآخِرَةِ ""","","","","","Book of Prayer"
"4749","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، عَنْ أَبِيهِ ، قَالَ : \" كَانَ عَلِيٌّ يُكَبِّرُ فِي الْفِطْرِ وَالأَضْحَى وَالاسْتِسْقَاءِ ، سَبْعًا فِي الأُولَى ، وَخَمْسًا فِي الأُخْرَى ، وَيُصَلِّي قَبْلَ الْخُطْبَةِ ، وَيَجْهَرُ بِالْقِرَاءَةِ \" ، قَالَ : وَكَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَأَبُو بَكْرٍ ، وَعُمَرَ وَعُثْمَانَ ، يَفْعَلُونَ ذَلِكَ","","","","","Book of Prayer"
"4750","عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ : \" سُنَّةُ الاسْتِسْقَاءِ ، كَسُنَّةِ الْفِطْرِ وَالأَضْحَى فِي التَّكْبِيرِ ""","","","","","Book of Prayer"
"4751","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : حُدِّثْتُ ، \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حِينَ اسْتَسْقَى حَوَّلَ رِدَاءَهُ الأَيْمَنَ عَلَى شِقِّهِ الأَيْسَرِ ، وَالأَيْسَرَ عَلَى شِقِّهِ الأَيْمَنِ ، ثُمَّ اسْتقْبَلَ الْقِبْلَةَ ، ثُمَّ نَزَلَ فَصَلَّى رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4752","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سَمِعْتُ عَبْدَ الرَّحْمَنِ بْنَ الْحَارِثِ ، يُحَدِّثُ : \" أَنَّهُ حَضَرَ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ ، إِذْ هُوَ عَامِلٌ عَلَى الْمَدِينَةِ اسْتَسْقَى عَلَى الْمِنْبَرِ ، ثُمَّ نَزَلَ فَصَلَّى ""","","","","","Book of Prayer"
"4753","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَبْدِ اللَّهِ بْنِ يَزِيدَ الْخَطْمِيِّ ، أَنَّ ابْنَ الزُّبَيْرِ \" خَرَجَ يَسْتَسْقِي بِالنَّاسِ ، فَخَطَبَ ، ثُمَّ صَلَّى بِغَيْرِ أَذَانٍ وَلا إِقَامَةٍ ، قَالَ : وَفي النَّاسِ يَوْمَئِذٍ الْبَرَاءُ بْنُ عَازِبٍ ، وَزَيْدُ بْنُ أَرْقَمَ ""","","","","","Book of Prayer"
"4754","عَنْ رَبَاحِ بْنِ عُبَيْدِ اللَّهِ بْنِ عُمَرَ ، قَالَ : أَخْبَرَنِي يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ حُنَيْنٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : \" كَانَ يَقْرَأُ فِي رَكْعَتَيِ الاسْتِسْقَاءِ : وَالشَّمْسِ وَضُحَاهَا ، وَاللَّيْلِ إِذَا يَغْشَى ""","","","","","Book of Prayer"
"4755","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سَأَلَ سُلَيْمَانُ بْنُ مُوسَى عَطَاءً : أَفِي الاسْتِسْقَاءِ صَلاةٌ ؟ فَلَمْ يُفَرِّقْ لَهُ عَمَّنْ مَضَى شَيْئًا ، قَالَ سُلَيْمَانُ : فَذَكَرَ لَنَا \" أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، خَرَجَ بِالنَّاسِ إِلَى الْمُصَلَّى وَدَعَا وَاسْتَغْفَرَ ، ثُمَّ نَزَلَ ، فَانْقَلَبَ وَلَمْ يُصَلِّ ""","","","","","Book of Prayer"
"4756","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِيِّ ، قَالَ : خَرَجَ عُمَرُ بْنُ الْخَطَّابِ يَسْتَسْقِي بِالنَّاسِ ، فَمَا زَادَ عَلَى الاسْتِغْفَارِ حَتَّى رَجَعَ ، فَقَالُوا : يَا أَمِيرَ الْمُؤْمِنِينَ مَا رَأَيْنَاكَ اسْتسْقَيْتَ ، قَالَ : \" لَقَدْ طَلَبْتُ الْمَطَرَ بِمَجَادِيحِ السَّمَاءِ الَّتِي تُسْتَنْزَلُ بِهَا الْمَطَرُ :  فَقُلْتُ اسْتَغْفِرُوا رَبَّكُمْ إِنَّهُ كَانَ غَفَّارًا { 10 } يُرْسِلِ السَّمَاءَ عَلَيْكُمْ مِدْرَارًا { 11 } وَيُمْدِدْكُمْ بِأَمْوَالٍ وَبَنِينَ ،  اسْتَغْفِرُوا رَبَّكُمْ ثُمَّ تُوبُوا إِلَيْهِ يُرْسِلِ السَّمَاءَ عَلَيْكُمْ مِدْرَارًا وَيَزِدْكُمْ قُوَّةً إِلَى قُوَّتِكُمْ ""","","","","","Book of Prayer"
"4757","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ إِلَى مَيْمُونِ بْنِ مِهْرَانَ \" إِنِّي كَتَبْتُ إِلَى أَهْلِ الأمْصَارِ أَنْ يَخْرُجُوا يَوْمَ كَذَا مِنْ شَهْرِ كَذَا لِيَسْتَسْقُوا ، وَمَنِ اسْتَطَاعَ أَنْ يَصُومَ وَيَتَصَدَّقَ فَلْيَفْعَلْ ، فَإِنَّ اللَّهَ يَقُولُ :  قَدْ أَفْلَحَ مَنْ تَزَكَّى { 14 } وَذَكَرَ اسْمَ رَبِّهِ فَصَلَّى { 15 } ، وَقُولُوا كَمَا قَالَ أَبَوَاكُمْ :  رَبَّنَا ظَلَمْنَا أَنْفُسَنَا وَإِنْ لَمْ تَغْفِرْ لَنَا وَتَرْحَمْنَا لَنَكُونَنَّ مِنَ الْخَاسِرِينَ ، وَقُولُوا كَمَا قَالَ نُوحٌ :  وَإِلا تَغْفِرْ لِي وَتَرْحَمْنِي أَكُنْ مِنَ الْخَاسِرِينَ ، وَقُولُوا كَمَا قَالَ مُوسَى :  إِنِّي ظَلَمْتُ نَفْسِي فَاغْفِرْ لِي فَغَفَرَ لَهُ إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ ، وَقُولُوا كَمَا قَالَ يُونُسُ عَلَيْهِ السَّلامُ :  لا إِلَهَ إِلا أَنْتَ سُبْحَانَكَ إِنِّي كُنْتُ مِنَ الظَّالِمِينَ ""","","","","","Book of Prayer"
"4758","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ حُسَيْنِ بْنِ عَبْدِ اللَّهِ بْنِ ضُمَيْرَةَ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ ، عَنْ عَلِيٍّ ، أَنَّهُ قَالَ فِي الاسْتِسْقَاءِ : \" إِذَا خَرَجْتُمْ فَاحْمَدُوا اللَّهَ وَأَثْنُوا عَلَيْهِ بِمَا هُوَ أَهْلَهُ ، وَصَلُّوا عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَاسْتَغْفِرُوا فَإِنَّ الاسْتِسْقَاءَ الاسْتِغْفَارُ ""","","","","","Book of Prayer"
"4759","قَالَ : وَقَالَ عَلِيٌّ : \" إِنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَوَّلَ رِدَاءَهُ وَهُوَ قَائِمٌ ، حِينَ أَرَادَ أَنْ يَدْعُوَ ""","","","","","Book of Prayer"
"4760","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي وَائِلٍ ، عَنِ ابْنِ مَسْعُودٍ \" أَنَّ رَجُلا بَيْنَا هُوَ يَسْقِي زَرْعًا ، إِذْ رَأَى عَنَانَةً تَرَهْيَأُ فِيهَا صَوْتٌ : أَنِ اسْقِ أَرْضَ فُلانٍ , فَاتَّبَعَ الصَّوْتَ حَتَّى انْتَهَى إِلَى الأَرْضِ الَّتِي سُمِّيَتْ , فَسَأَلَ صَاحِبَهَا : مَا عَمَلُكَ فِيهَا ؟ فَقَالَ : إِنِّي أُعِيدُ فِيهَا ثُلُثًا ، وَأَتَصَدَّقُ بِثُلُثٍ ، وَأَحْتَبِسُ لأَهْلِي ثُلُثًا \" ، عَنِ الثَّوْرِيِّ ، عَنْ إِبْرَاهِيمَ بْنِ الْمُهَاجِرِ ، عَنِ النَّخَعِيِّ ، عَنْ مَسْرُوقٍ ، أَنَّ ابْنَ مَسْعُودٍ ، كَانَ يَبْعَثُهُ إِلَى أَرْضِهِ فَيَأْمُرُهُ أَنْ يَفْعَلَ فِيهَا كَذَلِكَ","","","","","Book of Prayer"
"4761","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي حَبِيبُ بْنُ أَبِي ثَابِتٍ ، أَنَّهُ بَلَغَهُ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" اللَّهُمَّ أَعِنِّي عَلَى مُضَرَ بِالسَّنَةِ \" ، فَجَاءَهُ مُضَرِيٌّ ، فَقَالَ : يَا نَبِيَّ اللَّهِ ، وَاللَّهِ مَا يَخْطِرُ لَنَا جَمَلٌ ، وَلا يُتَزَوَّدُ لَنَا رَاعٍ ، فَأَعَادَ فِي قَوْلَهُ ، فَأَعْرَضَ عَنْهُ ، ثُمَّ مَكَثَ مَا شَاءَ اللَّهُ ، ثُمَّ دَعَا الْمُضَرِيَّ ، فَقَالَ : قُلْتَ مَاذَا ؟ فَأَعَادَ عَلَيْهِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" اللَّهُمَّ دَعَوْتُكَ فَاسْتَجَبْتَ لِي ، وَسَأَلْتُكَ فَأَعْطَيْتَنِي ، اللَّهُمَّ اسْقِنَا غَيْثًا مُغِيثًا ، مَرِيئًا ، مَرِيعًا مُطْبِقًا ، عَاجِلا غَيْرَ رَائِثٍ ، نَافِعًا غَيْرَ ضَارٍّ \" ، فَمَا كَانَ عَشِيٌّ ، حَتَّى أُلْبِسَتِ السَّمَاءُ السَّحَابَ وَأَمْطَرَتْ ، فَمَا أَتَى أَحَدٌ مِنْ وَجْهٍ إِلا خَبَّرَ بِالْمَطَرِ ، قُلْنَا لَهُ : فَمَا يُخْطِرُ ؟ قَالَ : يَهْدِرُ","","","","","Book of Prayer"
"4762","عَنْ مَعْمَرٍ ، عَنِ الأَعْمَشِ ، أَنَّ رَجُلا أَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللَّهِ ، إِنَّ مُضَرَ قَدْ هَلَكَتْ ، فَاسْتَسْقِ اللَّهَ لَهُمْ ، أَوْ قَالَ : ادْعُ لَهُمْ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عِنْدَ ذَلِكَ : \" اللَّهُمَّ اسْقِنَا غَيْثًا مَرِيئًا هَنِيئًا ، مَرِيعًا ، طَبَقًا ، عَاجِلا غَيْرَ رَائِثٍ ، نَافِعًا غَيْرَ ضَارٍّ \" ، قَالَ : فَمَا مَكَثُوا إِلا جُمُعَةً ، حَتَّى أَحْيَا النَّاسَ","","","","","Book of Prayer"
"4763","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ سَعِيدٍ ، أَوْ غَيْرِهِ ، عَنْ سَالِمِ بْنِ أَبِي الْجَعْدِ ، قَالَ : قَامَ رَجُلٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللَّهِ , دَعَوْتَ عَلَى مُضَرَ بِالسَّنَةِ فَمَا يَغِطُّ لَهُمْ بَعِيرٌ ، وَمَا يَصِيحُ لَهُمْ صَبِيٌّ ، قَالَ : فَقَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى الْمِنْبَرِ ، فَقَالَ : \" اللَّهُمَّ اسْقِنَا غَيْثًا مُغِيثًا ، مَرِيعًا ، مُبَارَكًا مَرِيئًا ، نَافِعًا طَبَقًا ، عَاجِلا غَيْرَ رَائِثٍ \" ، قَالَ : فَمَا مَضَى ذَلِكَ الْيَوْمُ حَتَّى مُطِرُوا ، أَوْ مَا مَضَتْ سَابِعَةٌ ، حَتَّى أَعْطَنَ النَّاسُ بِالْعُشْبِ","","","","","Book of Prayer"
"4764","عَنْ مَعْمَرٍ ، عَنْ شَيْخٍ لَهُمْ ، عَنْ أَنَسٍ ، قَالَ : اسْتَسْقَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَرَّةً ، فَمُطِرَ النَّاسُ ثَلاثًا أَوْ مَا شَاءَ اللَّهُ ، ثُمَّ لَمْ يُقْلِعْ عَنْهُمْ \" ، قَالَ : فَقِيلَ : يَا رَسُولَ اللَّهِ ، تَهَدَّمَتِ الْحِيطَانُ ، وَتَقَطَّعَتِ الرُّكْبَانُ ، وَخَشِينَا الْغَرَقَ ، قَالَ : فَدَعَا ، فَقَالَ : \" اللَّهُمَّ حَوَالَيْنَا وَلا عَلَيْنَا \" ، قَالَ : فَرَأَيْتُ السَّحَابَ انْصَدَعَ مِنَ الْمَدِينَةِ ، حَتَّى كَانَتْ مِنْهُ مِثْلُ الطَّوْقِ ، وَمَا حَوْلَهُ مُظْلِمٌ أَعْلَمُ أَنَّهُ مَمْطُورٌ","","","","","Book of Prayer"
"4765","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : حُدِّثْتُ ، عَنْ أَنَسٍ ، قَالَ : \" حَضَرْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَتَاهُ رَجُلٌ فَاشْتَكَى إِلَيْهِ الْجَدْبَ ، وَهُوَ عَلَى الْمِنْبَرِ فَاسْتَسْقَى ، وَلَمْ يَذْكُرْ كَلامَهُ ، فَالْتَبَسَتِ السَّمَاءُ سَحَابًا ، فَأُمْطِرَ حَتَّى الْجُمُعَةِ الْمُقْبِلَةِ ، فَقِيلَ لَهُ : أَيْ رَسُولَ اللَّهِ ، غَرِقْنَا ، وَهَلَكَتِ الْمَاشِيَةُ ، وَلا يَخْرُجُ الْمُسَافِرُ ، فَضَحِكَ ، , ثُمَّ قَالَ : \" اللَّهُمَّ حَوَالَيْنَا وَلا عَلَيْنَا \" ، قَالَ : فَرَأَيْتُهُ حِينَ يَنْجَابُ السَّحَابُ عَنِ الْمَدِينَةِ وَيَتَفَرَّقُ ، حَتَّى أَنَا مِنْهُ لَفِي جَوْبَةٍ ""","","","","","Book of Prayer"
"4766","عَنِ ابْنِ التَّيْمِيِّ ، قَالَ : سَمِعْتُ يَحْيَى بْنَ سَعِيدٍ ، أَحْسَبُهُ ذَكَرَهُ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، أَنَّ نَبِيَّ اللَّهُ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَسْتَسْقِي ، يَقُولُ : \" اللَّهُمَّ اسْقِ عِبَادَكَ وَبَهَائِمَكَ ، وَانْشُرْ رَحْمَتَكَ ، وَأَحْيِي بَلَدَكَ الْمَيِّتَ ""","","","","","Book of Prayer"
"4767","قَالَ : وَسَمِعْتُهُ يَقُولُ : كَانَ عُمَرُ بْنُ الْخَطَّابِ إِذَا اشْتَدَّ الْمَطَرُ ، يَقُولُ : اللَّهُمَّ , جَنِّبْهَا بُيُوتَ الْمَدَرِ ، اللَّهُمَّ عَلَى ظُهُورِ الآكَامِ ، وَبُطُونِ الأَوْدِيَةِ ، وَمَنَابِتِ الشَّجَرِ","","","","","Book of Prayer"
"4768","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ حُسَيْنِ بْنِ عَبْدِ اللَّهِ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ عُمَرَ اسْتَسْقَى بِالْمُصَلَّى ، فَقَالَ لِلْعَبَّاسِ : قُمْ فَاسْتَسْقِ ، فَقَامَ الْعَبَّاسُ ، فَقَالَ : \" اللَّهُمَّ إِنَّ عِنْدَكَ سَحَابًا ، وَإِنَّ عِنْدَكَ مَاءً فَانْشُرِ السَّحَابَ , ثُمَّ أَنْزِلْ فِيهِ الْمَاءَ ، ثُمَّ أَنْزِلَهُ عَلَيْنَا ، فَاشْدُدْ بِهِ الأَصْلَ ، وَأَطِلْ بِهِ الزَّرْعَ ، وَأَدِرَّ بِهِ الضَّرْعَ ، اللَّهُمَّ شَفِّعْنَا فِي أَنْفُسِنَا وَأَهْلِينَا ، اللَّهُمَّ إِنَّا شَفَعْنَا إِلَيْكَ عَمَّنْ لا مَنْطِقَ لَهُ عَنْ بَهَائِمِنَا وَأَنْعَامِنَا ، اللَّهُمَّ اسْقِنَا سَقْيًا وَادِعَةً بِالِغَةً ، طَبَقًا ، عَامًّا ، مُحْيِيًا ، اللَّهُمَّ لا نَرْغَبُ إِلا إِلَيْكَ وَحْدَكَ لا شَرِيكَ لَكَ ، اللَّهُمَّ إِنَّا نَشْكُو إِلَيْكَ سَغَبَ كُلِّ سَاغِبٍ ، وَغُرْمَ كُلِّ غَارِمٍ ، وَجُوعَ كُلِّ جَائِعٍ ، وَعُرْيَ كُلِّ عَارٍ ، وَخَوْفَ كُلِّ خَائِفٍ فِي دُعَاءِ لَهُ ""","","","","","Book of Prayer"
"4769","عَنْ مَعْمَرٍ ، عَنْ إِسْمَاعِيلَ أَبِي الْمِقْدَامِ ، عَنْ عَبْدِ اللَّهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ ، قَالَ : أَصَابَ النَّاسَ سَنَةٌ ، وَكَانَ رَجُلٌ فِي بَادِيَةٍ ، فَخَرَجَ ، فَصَلَّى بِأَصْحَابِهِ رَكْعَتَيْنِ ، وَاسْتَسْقَى ثُمَّ نَامَ ، فَرَأَى فِي الْمَنَامِ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَتَاهُ ، وَقَالَ : أَقْرِئْ عُمَرَ السَّلامَ , وَأَخْبِرْهُ أَنَّ اللَّهَ قَدِ اسْتَجَابَ لَكُمْ ، وَكَانَ عُمَرُ قَدْ خَرَجَ فَاسْتَسْقَى أَيْضًا ، وَأْمُرْهُ فَلْيُوَفِّ الْعَهْدَ ، وَلْيَشُدَّ الْعَقْدَ ، قَالَ : فَانْطَلَقَ الرَّجُلُ حَتَّى أَتَى عُمَرَ ، فَقَالَ : اسْتأْذِنُوا لِرَسُولِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : فَسَمِعَهُ عُمَرُ ، فَقَالَ : مَنْ هَذَا الْمُفْتَرِي عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ الرَّجُلُ : لا تَعْجَلْ عَلَيَّ يَا أَمِيرَ الْمُؤْمِنِينَ ، فَأَخْبَرَهُ الْخَبَرَ ، فَبَكَى عُمَرُ ""","","","","","Book of Prayer"
"4770","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ أَبِي جَعْفَرٍ ، قَالَ : دَعَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِقَوْمٍ أَنْ يُمْطَرُوا ، فَلَمْ يُمْطَرُوا ، فَقَالَ : إِنِّي دَعَوْتُ لَكُمْ ، وَفي نَفْسِي عَلَيْكُمْ شَيْءٌ فَلَمْ تُمْطَرُوا ، وَلَكِنِ الآنَ تُمْطَرُوا ، فَدَعَا لَهُمْ فَمُطِرُوا","","","","","Book of Prayer"
"4771","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ شَهْرِ بْنِ حَوْشَبٍ \" أَنَّ عِيسَى ابْنَ مَرْيَمَ ، خَرَجَ يَسْتَسْقِي ، فَخَرَجَ بِالنَّاسِ ، ثُمّ قَالَ لَهُمْ \" مَنْ كَانَ مِنْكُمْ أَذْنَبَ ذَنْبًا فَلْيَرْجِعْ \" ، قَالَ : فَجَعَلَ النَّاسُ يَرْجِعُونَ ، حَتَّى لَمْ يَبْقَ إِلا رَجُلٌ أَعْوَرُ ، فَقَالَ لَهُ عِيسَى : \" فَادْعُ وَأَنَا أُؤَمِّنُ \" ، قَالَ : فَدَعَا ، وَأَمَّنَ عِيسَى فَسَقَاهُمُ اللَّهُ","","","","","Book of Prayer"
"4772","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ سُلَيْمَانَ بْنِ عَبْدِ اللَّهِ بْنِ عُوَيْمِرٍ ، عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ ، أَنَّهُ قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا رَأَى أَحَدُكُمُ الْبَرْقَ ، أَوِ الْوَدْقَ ، فَلا يُشِرْ إِلَيْهِ ، وَلْيَصِفْ أَوْ لِيَنْعَتْ","","","","","Book of Prayer"
"4773","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : حُدِّثْتُ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، \" نَهَى أَنْ يُشَارَ إِلَى الْمَطَرِ ""","","","","","Book of Prayer"
"4774","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَطَاءٌ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ ذَاتَ يَوْمٍ : أَيْنَ تِبْنَيْنِ ؟ قَالُوا : وَادٍ مِنْ أَوْدِيَةِ الْيَمَنِ ، قَالَ : هَذِهِ سَحَابَةٌ يُؤْمَرُ بِهَا إِلَى تِبْنَيْنِ ، كَيْفَ يَفْعَلُ بِهَا صَاحِبُهَا فِيهَا ؟ فَقَالُوا : يَقْسِمُ ثَمَرَهُ ثَلاثًا : ثُلُثٌ لَهُ وَلأَهْلِهِ ، وَثُلُثٌ لِصَدَقَتِهِ ، وَثُلُثٌ يُعِيدُ فِيهَا ، قَالَ : كُلُّ ذَلِكَ فِي سَبِيلِ اللَّهِ","","","","","Book of Prayer"
"4775","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِي عَوَانَةَ ، وَعَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنْ مُجَاهِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \" السُّكُوتُ فِي ثَلاثِ مَوَاطِنَ : فِي الْجُمُعَةِ ، وَالاسْتِسْقَاءِ ، وَالْعِيدَيْنِ \" ، وَذَكَرَهُ قَيْسُ بْنُ الرَّبِيعِ ، عَنْ سَلَمَةَ ، عَنْ مُجَاهِدٍ ، عَنِ ابْنِ عَبَّاسٍ مِثْلَهُ","","","","","Book of Prayer"
"4776","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ \" أَنَّ سُلَيْمَانَ بْنَ دَاوُدَ خَرَجَ هُوَ وَأَصْحَابُهُ يَسْتَسْقُونَ ، فَرَأَى نَمْلَةً قَائِمَةً رَافِعَةً إِحْدَى قَوَائِمَهَا تَسْتَسْقِي ، فَقَالَ لأَصْحَابِهِ \" ارْجِعُوا فَقَدْ سُقِيتُمْ ، إِنَّ هَذِهِ النَّمْلَةَ اسْتَسْقَتْ ، فَاسْتُجِيبَ لَهَا ""","","","","","Book of Prayer"
"4777","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : خَسَفَتِ الشَّمْسُ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، \" فَصَلَّى بِالنَّاسِ فَأَطَالَ الْقِرَاءَةَ ، ثُمَّ رَكَعَ فَأَطَالَ الرُّكُوعَ ، ثُمَّ رَفَعَ رَأْسَهُ فَأَطَالَ الْقِرَاءَةَ ، وَهُوَ دُونَ قِرَاءَتِهِ الأُولَى ، ثُمَّ رَكَعَ فَأَطَالَ الرُّكُوعَ ، وَهُوَ دُونَ رُكُوعِهِ الأَوَّلِ ، ثُمَّ رَفَعَ رَأْسَهُ فَسَجَدَ سَجْدَتَيْنِ ، ثُمَّ قَامَ فَفَعَلَ فِي الرَّكْعَةِ الثَّانِيَةِ مِثْلَ ذَلِكَ ، ثُمَّ انْصَرَفَ ، فَقَالَ : \" إِنَّ الشَّمْسَ وَالْقَمَرَ لا يَخْسِفَانِ لِمَوْتِ أَحَدٍ وَلا لِحَيَاتِهِ ، وَلَكِنَّهُمَا آيَتَانِ مِنْ آيَاتِ اللَّهِ ، فَإِذَا رَأَيْتُمْ ذَلِكَ فَافْزَعُوا لِلصَّلاةِ \" ، قَالَ مَعْمَرٌ : وَأَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ ، مِثْلَ هَذَا وَزَادَ ، قَالَ : \" فَإِذَا رَأَيْتُمْ ذَلِكَ ، فَتَصَدَّقُوا وَصَلُّوا ""","","","","","Book of Prayer"
"4778","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ عَمْرَةَ ، عَنْ عَائِشَةَ ، \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَامَ فَصَلَّى بِهِمْ ، فَقَامَ فَرَكَعَ ، ثُمَّ رَفَعَ رَأْسَهُ ، فَقَامَ دُونَ الْقِيَامِ الأَوَّلِ ، ثُمَّ رَكَعَ ، ثُمَّ رَفَعَ رَأْسَهُ ثُمَّ سَجَدَ ، ثُمَّ قَامَ فَفَعَلَ مِثْلَ ذَلِكَ فِي الثَّانِيَةِ ، إِلا أَنَّ قِيَامَهَا وَرُكُوعَهَا دُونَ الأَوَّلِ فِي كُلِّ رَكْعَةٍ رَكْعَتيْنِ ""","","","","","Book of Prayer"
"4779","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ عَمْرَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : \" جَاءَتْنِي يَهُودِيَّةٌ ، فَقَالَتْ : أَعَاذَكَ اللَّهُ مِنْ عَذَابِ الْقَبْرِ ، قَالَتْ : فَدَخَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْتُ : يَا رَسُولَ اللَّهِ ، أَنُعَذَّبُ فِي قُبُورِنَا ؟ قَالَ : كَذَبَتْ يَهُودُ ، ثُمَّ إِنَّ رَسُولَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَكِبَ ذَاتَ يَوْمٍ مَرْكَبًا ، فَخَسَفتِ الشَّمْسُ ، قَالَتْ : فَخَرَجْتُ مَعَ نِسْوَةٍ ، فَكُنَّا بَيْنَ الْحَجَرِ ، إِذْ جَاءَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ مَرْكَبِهِ فَأَتَى مُصَلاهُ ، فَقَامَ قِيَامًا طَوِيلا فَطَوَّلَ ، ثُمَّ رَكَعَ رُكُوعًا طَوِيلا فَطَوَّلَ رُكُوعَهُ ، ثُمَّ رَفَعَ فَقَامَ قِيَامًا طَوِيلا ، وَهُوَ أَدْنَى مِنْ قِيَامِهِ الأَوَّلِ ، ثُمَّ رَكَعَ رُكُوعًا طَوِيلا ، وَهُوَ أَدْنَى مِنْ رُكُوعِهِ الأَوَّلِ ، ثُمَّ رَفَعَ ، ثُمَّ سَجَدَ سُجُودًا طَوِيلا ، ثُمَّ قَامَ قِيَامًا طَوِيلا ، وَهُوَ أَدْنَى مِنْ قِيَامِهِ الأَوَّلِ ، فَفَعَلَ كَمَا فَعَلَ فِي الأُولَى ، ثُمَّ جَلَسَ ، قَالَتْ : ثُمَّ سَمِعْتُهُ يَسْتَعِيذُ مِنْ عَذَابِ الْقَبْرِ ""","","","","","Book of Prayer"
"4780","عَنْ مَالِكٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : خَسَفَتِ الشَّمْسُ فَصَلَّى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَالنَّاسُ مَعَهُ ، فَقَامَ قِيَامًا طَوِيلا نَحْوًا مِنْ سُورَةِ الْبَقَرَةِ ، ثُمَّ رَكَعَ رُكُوعًا طَوِيلا ، ثُمَّ رَفَعَ ، فَقَامَ قِيَامًا طَوِيلا وَهُوَ دُونَ الْقِيَامِ الأَوَّلِ ، ثُمَّ رَكَعَ رُكُوعًا دُونَ الرُّكُوعِ الأَوَّلِ ، ثُمَّ سَجَدَ ، ثُمَّ قَامَ فَصَنَعَ فِي الرَّكْعَةِ الثَّانِيَةِ مِثْلَ ذَلِكَ ، وَلَكِنَّ قِيَامَهُ فِيهَا دُونَ الْقِيَامِ الأَوَّلِ ، وَرُكُوعَهُ وَسُجُودَهُ دُونَ مَا صَنَعَ فِي الرَّكْعَةِ الأُولَى ، ثُمَّ انْصَرَفَ وَتَجَلَّى الشَّمْسُ ، ثُمَّ قَالَ : \" إِنَّ الشَّمْسَ وَالْقَمَرَ آيَتَانِ مِنْ آيَاتِ اللَّهِ تَعَالَى ، لا يَخْسِفَانِ لِمَوْتِ أَحَدٍ وَلا لِحَيَاتِهِ ، فَإِذَا رَأَيْتُمْ ذَلِكَ فَاذْكُرُوا اللَّهَ \" ، قَالُوا : يَا رَسُولَ اللَّهِ ، رَأَيْنَاكَ تَنَاوَلْتَ شَيْئًا مِنْ مَقَامِكَ هَذَا ، ثُمَّ رَأَيْنَاكَ تَكَعْكَعْتَ ، قَالَ : \" إِنِّي أُرِيتُ الْجَنَّةَ أَوْ رَأَيْتُ الْجَنَّةَ ، فَتَنَاوَلْتُ مِنْهَا عُنْقُودًا ، وَلَوْ أَخَذْتُهُ لأَكَلْتُمْ مِنْهَا مَا بَقِيَتِ الدُّنْيَا ، وَرَأَيْتُ النَّارَ فَلَمْ أَرَ كَالْيَوْمِ مَنْظَرًا قَطُّ ، فَرَأَيْتُ أَكْثَرَ أَهْلِهَا النِّسَاءُ \" ، قِيلَ : لِمَ يَا رَسُولَ اللَّهِ ؟ قَالَ : \" بِكُفْرِهِنَّ \" ، قِيلَ : أَيَكْفُرْنَ بِاللَّهِ ؟ قَالَ : \" يَكْفُرْنَ الْعَشِيرَ ، وَيَكْفُرْنَ الإِحْسَانَ ، وَلَوْ أَحْسَنْتَ إِلَى إِحْدَاهُنَّ الدَّهْرَ ثُمَّ رَأَتْ مِنْكَ شَيْئًا ، قَالَتْ : مَا رَأَيْتُ مِنْكَ خَيْرًا قَطُّ ""","","","","","Book of Prayer"
"4781","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سَمِعْتُ عَطَاءً ، يَقُولُ : سَمِعْتُ عُبَيْدَ بْنَ عُمَيْرٍ ، يَقُولُ : أَخْبَرَنِي مَنْ أُصَدِّقُ ، فَظَنَنْتُ أَنَّهُ يُرِيدُ عَائِشَةَ ، أَنَّهَا قَالَتْ : \" كَسَفَتِ الشَّمْسُ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَامَ بِالنَّاسِ قِيَامًا شَدِيدًا ، يَقُومُ بِالنَّاسِ ثُمَّ يَرْكَعُ ، وَيَقُومُ ثُمَّ يَرْكَعُ ، وَيَقُومُ ثُمَّ يَرْكَعُ ، فَرَكَعَ رَكْعَتَيْنِ ، فِي كُلِّ رَكْعَةٍ ثَلاثُ رَكَعَاتٍ ، يَرْكَعُ الثَّالِثَةَ ثُمَّ يَسْجُدُ ، فَلَمْ يَنْصَرِفْ حَتَّى تَجَلَّتِ الشَّمْسُ ، وَحَتَّى أَنَّ رِجَالا يَوْمَئِذٍ لَيُغْشَى عَلَيْهِمْ ، حَتَّى أَنَّ سِجَالَ الْمَاءِ لَيُصَبُّ عَلَيْهِمْ مِمَّا قَامَ بِهِمْ ، وَيَقُولُ إِذَا رَكَعَ : اللَّهُ أَكْبَرُ ، وَإِذَا رَفَعَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ ، ثُمَّ قَامَ فَحَمِدَ اللَّهَ وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ : \" إِنَّ الشَّمْسَ وَالْقَمَرَ لا يَخْسِفَانِ لِمَوْتِ أَحَدٍ ، وَلا لِحَيَاتِهِ ، وَلَكِنَّهَا آيَتَانِ مِنْ آيَاتِ اللَّهِ يُخَوِّفُكُمْ بِهِمَا ، فَإِذَا كَسَفَهُمَا ، فَافْزَعُوا إِلَى ذِكْرِ اللَّهِ حَتَّى ينْجَلِيَ \" ، وَزِيدَ عَلَى عَطَاءٍ فِي هَذِهِ الْخُطْبَةِ : وَلَكِنَّهُ رُبَّمَا مَاتَ الْخِيَارُ بِأَطْرَافٍ مِنَ الأَرْضِ ، فَأَذَاعَتْ بِذَلِكَ الْجِنُّ ، فَكَانَ لِذَلِكَ الْقَتَرُ ، قَالَ : فَأَخْبَرَنِي غَيْرُ عُبَيْدٍ : يَقُولُ : قَالَ : عُرِضَتِ الْجَنَّةُ وَالنَّارُ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ فِي صَلاتِهِ يَوْمَ كَسَفَتِ الشَّمْسُ ، فَتَأَخَّرَ عَنْ مُصَلاهُ ، وَرَاءَهُ حَتَّى أَنَّ النَّاسَ لَيَرْكَبُ بَعْضُهُمْ عَلَى بَعْضٍ ، وَيَقُولُ : أَيْ رَبِّ وَأَنَا ، أَيْ رَبِّ وَأَنَا ، ثُمَّ عَادَ يَسِيرُ حَتَّى رَجَعَ فِي مُصَلاهُ ، فَرَأَى إِذْ عُرِضَتْ عَلَيْهِ النَّارُ أَبَا خُزَاعَةَ عَمْرَو بْنَ لُحَيٍّ فِي النَّارِ يَجُرُّ قَصَبَهُ ، قَالَ : وَكَانُوا زَعَمُوا يَسْرِقُ الْحَاجَّ بِمِحْجَنٍ لَهُ ، وَيَقُولُ : أَيْ رَبِّ ، لا أَسْرِقُ إِنَّمَا يَسْرِقُ مِحْجَنِي ، قَالَ : وَصَاحِبَةُ الْهِرَّةِ امْرَأَةٌ رَبَطَتْهَا فَلَمْ تُطْعِمْهَا ، وَلَمْ تُرْسِلْهَا ، وَلَمْ تَسْقِهَا ، فَتَأْكُلُ وَتَشَرَبُ حَتَّى مَاتَتْ هُزَالا ، وَإِذَا رَجَعَ عُرِضَتْ عَلَيْهِ الْجَنَّةُ ، فَذَهَبَ يَمْشِي حَتَّى رَجَعَ فِي مُصَلاهُ ، ثُمَّ قَالَ : أَرَدْتُ أَنْ آخُذَ مِنْهَا قَطْفًا لأُرِيكُمُوهُ ، فَلَمْ يَقْدِرْ ، قَالَ ابْنُ جُرَيْجٍ ، وَقَالَ الْحَسَنُ : فَزِعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمَئِذٍ حَتَّى أَنَّهُ يَجُرُّ رِدَاءَهُ ، قَالَ عَبْدُ الرَّزَّاقِ : أَذَاعَتْ يَعْنِي أَخْبَرَتِ الْجِنُّ بَعْضُهَا بَعْضًا ، وَيَعْنِي الْقَتَرَةَ : الْحُمْرَةُ الَّتِي تَكُونُ فِي الْقَمَرِ ، وَالذي يَجُرُّ قَصَبَهُ يَعْنِي : حَشَاهُ ""","","","","","Book of Prayer"
"4782","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي مَنْصُورُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أُمِّهِ صَفيَّةَ بِنْتِ شَيْبَةَ ، عَنْ أَسْمَاءَ بِنْتِ أَبِي بَكْرٍ ، قَالَتْ : خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمَ كَسَفَتِ الشَّمْسُ ، فَأَخَذَ دِرْعًا فَلَبِسَهُ ، حَتَّى أُدْرِكَ بِرِدَائِهِ ، فَقَامَ بِالنَّاسِ قِيَامًا طَوِيلا يَقُومُ ثُمَّ يَرْكَعُ ، فَلَوْ جَاءَ إِنْسَانٌ بَعْدَمَا رَكَعَ لَمْ يَكُنْ عَلِمَ أَنَّهُ رَكَعَ شَيْئًا مَا حَدَّثَ نَفْسَهُ أَنَّهُ رَكَعَ مِنْ طُولِ الْقِيَامِ ، قَالَتْ : فَجَعَلْتُ أَنْظُرُ إِلَى الْمَرْأَةِ الَّتِي هِيَ أَكْبَرُ ، وَإِلَى الْمَرْأَةِ الَّتِي هِيَ أَسْقَمُ مِنِّي قَائِمَةً ، فَأَقُولُ : \" أَنَا أَحَقُّ أَنْ أَصْبِرَ عَلَى طُولِ الْقِيَامِ مِنْكِ ""","","","","","Book of Prayer"
"4783","عَنْ بَكَّارٍ ، عَنْ عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ ، عَنْ يَعْلَى بْنِ حَكِيمٍ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، أَنَّ ابْنَ عَبَّاسٍ : \" قَرَأَ فِي الرَّكْعَةِ الأُولَى فِي الْكُسُوفِ : الْحَمْدُ ، وَالْبَقَرَةُ ، وَفِي الثَّانِيَةِ : الْحَمْدُ ، وَآلُ عِمْرَانَ ""","","","","","Book of Prayer"
"4784","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، وَعَاصِمٍ الأَحْوَلِ ، عَنْ عَبْدِ اللَّهِ بْنِ الْحَارِثِ ، عَنِ ابْنِ عَبَّاسٍ ، \" أَنَّهُ صَلَّى فِي الزَّلْزَلَةِ بِالْبَصْرَةِ ، فَأَطَالَ الْقُنُوتَ ، ثُمَّ رَكَعَ ، ثُمَّ رَفَعَ رَأْسَهُ فَأَطَالَ الْقُنُوتَ ، ثُمَّ رَكَعَ ، ثُمَّ رَكَعَ ، ثُمَّ سَجَدَ ، ثُمَّ صَلَّى الثَّانِيَةَ كَذَلِكَ ، فَصَارَتْ صَلاتُهُ ثَلاثَ رَكَعَاتٍ وَأَرْبَعَ سَجَدَاتٍ \" ، وَقَالَ : هَكَذَا صَلاةُ الآيَاتِ  ، وَقَالَ مَعْمَرٌ : أَخْبَرَنِي بَعْضُ أَصْحَابِنَا أَنَّ ابْنَ عَبَّاسٍ : \" قَرَأَ فِي الرَّكْعَةِ الأُولَى بِالْبَقَرَةِ ، وَفي الآخِرَةِ بِآلِ عِمْرَانَ ""","","","","","Book of Prayer"
"4785","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : \" صَلَّى حُذَيْفَةُ بِالْمَدَائِنِ بِأَصْحَابِهِ ، مِثْلَ صَلاةِ ابْنِ عَبَّاسٍ فِي الآيَاتِ ""","","","","","Book of Prayer"
"4786","عَنِ الثَّوْرِيِّ ، عَنْ خَالِدٍ الْحَذَّاءِ ، أَوْ عَاصِمٍ الأَحْوَلِ ، عَنْ عَبْدِ اللَّهِ بْنِ الْحَارِثِ ، عَنِ ابْنِ عَبَّاسٍ ، \" أَنَّهُ صَلَّى فِي الزَّلْزَلَةِ بِالْبَصْرَةِ ، فَاتَّفَقَا عَلَى أَنَّهُ رَكَعَ فِي رَكْعَتَيْنِ سِتَّ رَكَعَاتٍ ، ثَلاثٌ فِي كُلِّ رَكْعَةٍ \" ، وَاخْتَلَفَا فَقَالَ عَاصِمٌ : \" قَرَأَ مَا بَيْنِ كُلِّ رَكْعَتَيْنِ \" ، وَقَالَ خَالِدٌ : \" قَرَأَ فِي الأُولَى مِنْ كُلِّ رَكْعَةٍ مِنْهَا \" ، ثُمَّ عَادَ بَعْدُ عَنِ الثَّوْرِيِّ ، قَالَ : أَخْبَرَنِي هِشَامٌ ، عَنْ رَجُلٍ ، عَنْ عَبْدِ اللَّهِ بْنِ الْحَارِثِ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّهُ حِينَ صَلَّى بِهِمْ ، قَالَ : \" هَكَذَا صَلاةُ الآيَاتِ ""","","","","","Book of Prayer"
"4787","عَنْ بَكَّارٍ ، عَنْ عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ ، عَنْ يَعْلَى بْنِ حَكِيمٍ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، عَنِ ابْنِ عَبَّاسٍ \" أَنَّهُ قَرَأَ فِي الرَّكْعَةِ الأُولَى بِسُورَةِ الْبَقَرَةِ ، وَفي الآخِرَةِ بِآلِ عِمْرَانَ \" ، وَذَكَرَهُ مَعْمَرٌ ، عَنِ ابْنِ عَبَّاسٍ","","","","","Book of Prayer"
"4788","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي سُلَيْمَانُ الأَحْوَلُ ، أَنَّ طَاوُسًا أَخْبَرَهُ ، أَنَّ ابْنَ عَبَّاسٍ وَكَسَفَتِ الشَّمْسُ فَصَلَّى عَلَى ظَهْرِ صُفَّةِ زَمْزَمَ رَكْعَتَيْنِ ، فِي كُلِّ رَكْعَةٍ أَرْبَعُ رَكَعَاتٍ ""","","","","","Book of Prayer"
"4789","عَنِ الثَّوْرِيِّ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ \" أَنَّهُ صَلَّى لِكُسُوفِ الشَّمْسِ ، فَقَرَأَ ، ثُمَّ رَكَعَ أَرْبَعَ رَكَعَاتٍ فِي كُلِّ سَجْدَةٍ ، إِلا أَنَّهُ لَمَّا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ ، قَرَأَ ثُمَّ سَجَدَ ، ثُمَّ قَامَ فَفَعَلَ فِي الثَّانِيَةِ مِثْلَ مَا فَعَلَ فِي الأُولَى ""","","","","","Book of Prayer"
"4790","عَنِ الثَّوْرِيِّ ، عَنْ سُلَيْمَانَ الشَّيْبَانِيِّ ، عَنِ الْحَكَمِ ، عَنْ حَنَشٍ ، عَنْ عَلِيٍّ أَنَّهُ ، أَمَّ النَّاسَ فِي الْمَسْجِدِ لِكُسُوفِ الشَّمْسِ ، قَالَ : \" فَجَهَرَ بِالْقِرَاءَةِ ، فَقَامَ فَقَرَأَ ، ثُمَّ رَكَعَ ، ثُمَّ قَامَ ، فَدَعَا ، ثُمَّ رَكَعَ أَرْبَعَ رَكَعَاتٍ فِي سَجْدَةٍ ، يَدْعُو فِيهِنَّ بَعْدَ الرُّكُوعِ ، ثُمَّ فَعَلَ فِي الثَّانِيَةِ مِثْلَ ذَلِكَ \" ، قَالَ سُفْيَانُ : وَسَمِعْتُهُمْ يَحْزِرُونَ قِيَامَ عَلِيٍّ فِي الْقِرَاءَةِ ، قَدْرَ الرُّومِ ، أَوْ يَاسِينَ ، أَوِ الْعَنْكُبُوتِ","","","","","Book of Prayer"
"4791","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، قَالَ \" الصَّلاةُ لِكُسُوفِ الشَّمْسِ وَالْقَمَرِ ، رَكْعَتَيْنِ نَحْوًا مِنْ صَلاتِنَا ""","","","","","Book of Prayer"
"4792","عَنِ الثَّوْرِيِّ ، عَنْ عَطَاءِ بْنِ السَّائِبِ ، عَنْ أَبِيهِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى بِهِمْ يَوْمَ كَسَفَتِ الشَّمْسُ يَوْمَ مَاتَ إِبْرَاهِيمُ ابْنُهُ ، فَقَامَ بِالنَّاسِ ، فَقِيلَ : لا يَرْكَعُ وَرَكَعَ ، فَقِيلَ : لا يَرْفَعُ وَرَفَعَ ، فَقِيلَ : لا يَسْجُدُ وَسَجَدَ ، فَقِيلَ : لا يَرْفَعُ وَجَلَسَ ، فَقِيلَ : لا يَسْجُدُ وَسَجَدَ ، فَقِيلَ : لا يَرْفَعُ ، ثُمَّ قَامَ فِي الثَّانِيَةِ فَفَعَلَ مِثْلَ ذَلِكَ وَتَجَلَّتِ الشَّمْسُ ""","","","","","Book of Prayer"
"4793","عَنْ إِسْمَاعِيلَ بْنِ عَبْدِ اللَّهِ ، قَالَ : حَدَّثَنِي زَكَرِيَّا بْنُ أَبِي زَائِدَةَ ، عَنِ الشَّعْبِيِّ ، قَالَ : وَالْمُغِيرَةُ بْنُ شُعْبَةَ عَلَى الْكُوفَةِ ، كَسَفَتِ الشَّمْسُ فَقَامَ فَصَلَّى بِالنَّاسِ ، فَكُنْتُ حَيْثُ لا أَسْمَعُ ، فَحَزَرْتُ قَدْرَ سُورَةٍ مِنَ الْمِائَتَيْنِ ، ثُمَّ رَكَعَ ، ثُمَّ رَفَعَ ، فَقَرَأَ ، ثُمَّ رَكَعَ ، ثُمَّ تَجَلَّتِ الشَّمْسُ ، فَرَكَعَ وَسَجَدَ ، ثُمَّ قَامَ فِي الثَّانِيَةِ ، فَقَرَأَ قِرَاءَةً خَفِيفَةً ، ثُمَّ رَكَعَ وَسَجَدَ ""","","","","","Book of Prayer"
"4794","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ إِنْسَانٌ لِعَطَاءٍ \" أَرَأَيْتَ إِذَا كَسَفَ الْقَمَرُ أُصَلِّي ، كَمَا صَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا كَسَفَتِ الشَّمْسُ ، قَالَ : نَعَمْ ، إِلا أَنْ تَكُونَ صَلاةٌ جَامِعَةٌ ""","","","","","Book of Prayer"
"4795","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، عَنْ عِكْرِمَةَ مَوْلَى ابْنِ عَبَّاسٍ ، قَالَ : \" كَسَفَ الْقَمَرُ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا : سُحِرَ الْقَمَرُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  اقْتَرَبَتِ السَّاعَةُ وَانْشَقَّ الْقَمَرُ  ، إِلَى مُسْتَمِرٌّ ""","","","","","Book of Prayer"
"4796","عَنْ مَعْمَرٍ ، قَالَ : سَأَلْتُ الزُّهْرِيَّ ، عَنِ الآيَةِ تَكُونُ بَعْدَ الْعَصْرِ ؟ قَالَ \" الدُّعَاءُ ، وَلَيْسَ فِيهَا صَلاةٌ بَعْدَ الْعَصْرِ \" ، قُلْتُ : عَمَّنْ تُحَدِّثُ ؟ قَالَ : \" كَذَلِكَ كَانُوا يَصْنَعُونَ ""","","","","","Book of Prayer"
"4797","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، قَالَ \" إِنَّ الشَّمْسَ وَالْقَمَرَ لا يَخْسِفَانِ لِمَوْتِ أَحَدٍ وَلا لِحَيَاتِهِ ، وَلِكَنَّ رَبَّنَا تَبَارَكَ وَتَعَالَى إِذَا تَجَلَّى لأَحَدٍ مِنْ خلْقِهِ خَضَعَ لَهُ ""","","","","","Book of Prayer"
"4798","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كُلَّمَا رَكَعَ رَكْعَةً وَرَفَعَ رَأْسَهُ ، أَرْسَلَ رَجُلا يَنْظُرُ هَلْ تَجَلَّتْ ""","","","","","Book of Prayer"
"4799","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : كَانَ يَقُولُ : مِنْ أَيْنَ أَخَذَ النَّاسُ الْقُنُوتَ ؟ وَتَعَجَّبَ ، وَيَقُولُ \" إِنَّمَا قَنَتَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَيَّامًا ، ثُمَّ تَرَكَ ذَلِكَ ""","","","","","Book of Prayer"
"4800","عَنْ عَبْدِ اللَّهِ بْنِ مُحَرَّرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : \" قُبِضَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَبُو بَكْرٍ ، وَعُمَرُ ، وَهُمْ لا يَقْنُتُونَ ""","","","","","Book of Prayer"
"4801","عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ ، وَالأَسْوَدِ أَنَّهُمَا ، قَالا : \" صَلَّى بِنَا عُمَرُ زَمَانًا لَمْ يَقْنُتْ ""","","","","","Book of Prayer"
"4802","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، وَالأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ بْنِ يَزِيدَ ، وَعَمْرِو بْنِ مَيْمُونٍ الأَوْدِيِّ ، قَالا : \" صَلَّيْنَا خَلْفَ عُمَرَ بْنِ الْخَطَّابِ الْفَجْرَ ، فَلَمْ يَقْنُتْ ""","","","","","Book of Prayer"
"4803","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَلْقَمَةَ بْنِ قَيْسٍ ، \" أَنَّ ابْنَ مَسْعُودٍ كَانَ لا يَقْنُتُ فِي صَلاةِ الْفَجْرِ ""","","","","","Book of Prayer"
"4804","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، \" أَنَّ ابْنَ عُمَرَ ، كَانَ لا يَقْنُتُ فِي الصُّبْحِ ، وَلا فِي الْوِتْرِ أَيْضًا ""","","","","","Book of Prayer"
"4805","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ عُثْمَانَ التَّيْمِيِّ ، قَالَ : سَمِعْتُ عَمْرَو بْنَ مَيْمُونٍ ، يَقُولُ : \" صَلَّيْتُ خَلْفَ عُمَرَ الْفَجْرَ ، فَلَمْ يَقْنُتْ فِيهَا ""","","","","","Book of Prayer"
"4806","عَنْ مَالِكٍ ، عَنْ نَافِعٍ ، \" أَنَّ ابْنَ عُمَرَ ، كَانَ لا يَقْنُتُ فِي الْفَجْرِ ""","","","","","Book of Prayer"
"4807","عَنْ هُشَيْمٍ ، عَنْ رَجُلٍ سَمَّاهُ ، قَالَ : أَحْسَبُهُ قَالَ : سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ \" أَنَّ ابْنَ عَبَّاسٍ صَلَّى الْغَدَاةَ ، فَلَمْ يَقْنُتْ ""","","","","","Book of Prayer"
"4808","وَقَالَ ابْنُ الْمُجَالِدِ ، عَنْ أَبِيهِ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ ، وَالأَسْوَدِ ، قَالا : \" مَا قَنَتَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي شَيْءٍ مِنَ الصَّلَوَاتِ ، إِلا إِذَا حَارَبَ ، فَإِنَّهُ كَانَ يَقْنُتُ فِي الصَّلَوَاتِ كُلِّهِنَّ ، وَلا قَنَتَ أَبُو بَكْرٍ ، وَلا عُمَرُ وَلا عُثْمَانُ ، حَتَّى مَاتُوا ، حَتَّى لا قَنَتَ عَلِيٌّ حَتَّى حَارَبَ أَهْلَ الشَّامِ ، فَكَانَ يَقْنُتُ فِي الصَّلَوَاتِ كُلِّهِنَّ \" ، وَكَانَ مُعَاوِيَةُ يَقْنُتُ أَيْضًا فَيَدْعُو كُلُّ وَاحِدٍ مِنْهُ مَا عَلَى صَاحِبِهِ","","","","","Book of Prayer"
"4809","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، وَالأَعْمَشُ ، عَنْ إِبْرَاهِيمَ ، عَنْ أَبِي الشَّعْثَاءِ ، قَال : \" سَأَلْتُ ابْنَ عُمَرَ عَنِ الْقُنُوتِ فِي الْفَجْرِ ، فَقَالَ : مَا شَعُرْتُ أَنَّ أَحَدًا يَفْعَلُهُ ""","","","","","Book of Prayer"
"4810","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، قَالَ : سَأَلْتُ سَالِمَ بْنَ عَبْدِ اللَّهِ \" هَلْ كَانَ عُمَرُ بْنُ الْخَطَّابِ يَقْنُتُ فِي الصُّبْحِ ؟ قَالَ : لا ، إِنَّمَا هُوَ شَيْءٌ أَحْدَثَهُ النَّاسُ بَعْدُ ""","","","","","Book of Prayer"
"4811","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنْ مُسْلِمِ بْنِ صُبَيْحٍ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ : \" لَمْ يَكُنْ عُمَرُ يَقْنُتُ فِي الصُّبْحِ ""","","","","","Book of Prayer"
"4812","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي مَنْ ، سَمِعَ ابْنَ عَبَّاسٍ ، وَمُحَمَّدَ بْنَ عَلِيٍّ بِالْخَيْفِ ، يَقُولانِ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقْنُتُ بِهَؤُلاءِ الْكَلِمَاتِ فِي صَلاةِ الصُّبْحِ ، وَفي الْوِتْرِ بِاللَّيْلِ : \" اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ ، وَعَافِنِي فِيمَنْ عَافَيْتَ ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ ، وَقِنِي شَرَّ مَا قَضَيْتَ ، إِنَّكَ تَقْضِي وَلا يُقْضَى عَلَيْكَ ، وَإِنَّهُ لا يَذِلُّ مَنْ وَالَيْتَ ، تَبَارَكْتَ رَبَّنَا وَتَعَالَيْتَ ""","","","","","Book of Prayer"
"4813","عَنِ الثَّوْرِيِّ ، عَنْ نُسَيْرِ بْنِ ذُعْلُوقٍ ، قَالَ \" صَلَّيْتُ خَلْفَ رَبِيعِ بْنِ خُثَيْمٍ ، فَقَنَتَ قَبْلَ الرَّكْعَةِ ""","","","","","Book of Prayer"
"4814","عَنِ الثَّوْرِيِّ ، عَنْ مُخَارِقٍ ، عَنْ طَارِقِ بْنِ شِهَابٍ ، \" أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، صَلَّى الصُّبْحَ ، فَلَمَّا فَرَغَ مِنَ الْقِرَاءَةِ قَنَتَ ، ثُمَّ كَبَّرَ حِينَ يَرْكَعُ ""","","","","","Book of Prayer"
"4815","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الأَعْلَى ، عَنْ أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ، \" أَنَّ عَلِيًّا كَبَّرَ حِينَ قَنَتَ فِي الْفَجْرِ ، ثُمَّ كَبَّرَ حِينَ يَرْكَعُ ""","","","","","Book of Prayer"
"4816","عَنِ الثَّوْرِيِّ ، عَنْ مُطَرِّفِ بْنِ طَرِيفٍ ، عَنْ أَبِي الْجَهْمِ ، عَنِ الْبَرَاءِ بْنِ عَازِبٍ \" أَنَّهُ قَنَتَ فِي الْفَجْرِ ، فَكَبَّرَ حِينَ فَرَغَ مِنَ الْقِرَاءَةِ ، ثُمَّ كَبَّرَ حِينَ فَرَغَ مِنَ الْقُنُوتِ ""","","","","","Book of Prayer"
"4817","عَنْ أَبِي جَعْفَرٍ ، عَنْ قَتَادَةَ ، قَالَ : \" قَنَتَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي صَلاةِ الْفَجْرِ ، وَأَبُو بَكْرٍ ، وَعُمَرُ بَعْدَ الرُّكُوعِ ، فَلَمَّا كَانَ عُثْمَانُ قَنَتَ قَبْلَ الرُّكُوعِ ، لأَنْ يُدْرِكَ النَّاسُ الرَّكْعَةَ ""","","","","","Book of Prayer"
"4818","عَنْ أَبِي جَعْفَرٍ ، عَنْ عَاصِمٍ ، عَنْ أَنَسٍ ، قَالَ : \" قَنَتَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الصُّبْحِ بَعْدَ الرُّكُوعِ يَدْعُو عَلَى أَحْيَاءٍ مِنْ أَحْيَاءِ الْعَرَبِ ، وَكَانَ قُنُوتُهُ قَبْلَ ذَلِكَ وَبَعْدَهُ قَبْلَ الرُّكُوعِ ""","","","","","Book of Prayer"
"4819","عَنْ أَبِي جَعْفَرٍ ، عَنِ الرَّبِيعِ بْنِ أَنَسٍ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، قَالَ : \" مَا زَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقْنُتُ فِي الْفَجْرِ ، حَتَّى فَارَقَ الدُّنْيَا ""","","","","","Book of Prayer"
"4820","عَنْ عُثْمَانَ بْنِ مَطَرٍ ، قَالَ : حَدَّثَنِي حَنْظَلَةُ ، أَنَّهُ سَمِعَ أَنَسًا ، يَقُولُ : \" قَنَتَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْفَجْرِ بَعْدَ الرُّكُوعِ ""","","","","","Book of Prayer"
"4821","عَنْ أَبِي جَعْفَرٍ ، عَنْ حُمَيْدٍ ، عَنْ أَنَسٍ ، قَالَ : قُلْتُ لَهُ : \" كَيْفَ كُنْتُمْ تَقْنُتُونَ ؟ قَالَ : كُلُّ ذَلِكَ قَبْلَ الرُّكُوعِ وَبَعْدَهُ ""","","","","","Book of Prayer"
"4822","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَلْقَمَةَ ، وَالأَسْوَدِ \" أَنَّ ابْنَ مَسْعُودٍ كَانَ لا يَقْنُتُ فِي صَلاةِ الْغَدَاةِ ""","","","","","Book of Prayer"
"4823","عَنْ مَعْمَرٍ ، عَنْ عَلِيِّ بْنِ زَيْدِ بْنِ جُدْعَانَ ، عَنْ أَبِي رَافِعٍ ، قَالَ : صَلَّيْتُ خَلْفَ عُمَرَ بْنِ الْخَطَّابِ الصُّبْحَ فَقَنَتَ بَعْدَ الرُّكُوعِ ، قَالَ : فَسَمِعْتُهُ يَقُولُ : \" اللَّهُمَّ إِنَّا نَسْتَعِينُكَ ، وَنَسْتَغْفِرُكَ ، وَنُثْنِي عَلَيْكَ وَلا نَكْفُرُكَ ، وَنُؤْمِنُ بِكَ وَنَخْلَعُ وَنَتْرُكُ مَنْ يَفْجُرُكَ ، اللَّهُمَّ إِيَّاكَ نَعْبُدُ ، وَلَكَ نُصَلِّي وَنَسْجُدُ ، وَإِلَيْكَ نَسْعَى وَنَحْفِدُ ، وَنَرْجُو رَحْمَتَكَ وَنَخَافُ عَذَابَكَ إِنَّ عَذَابَكَ بِالْكَفَّارِينَ مُلْحَقٌ ، اللَّهُمَّ عَذِّبِ الْكَفَرَةَ ، وَأَلْقِ فِي قُلُوبِهِمُ الرُّعْبَ ، وَخَالِفْ بَيْنِ كَلِمَتِهِمْ ، وَأَنْزِلْ عَلَيْهِمْ رِجْزَكَ وَعَذَابَكَ ، اللَّهُمَّ عَذِّبِ الْكَفَرَةَ أَهْلَ الْكِتَابِ الَّذِينَ يَصُدُّونَ عَنْ سَبِيلِكَ ، وَيُكَذِّبُونَ رُسُلَكَ وَيُقَاتِلُونَ أَوْلِيَاءَكَ ، اللَّهُمَّ اغْفِرْ لِلْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ وَالْمُسْلِمِينَ وَالْمُسْلِمَاتِ وَأَصْلِحْ ذَاتَ بَيْنِهِمْ ، وَأَلِّفْ بَيْنَ قُلُوبِهِمْ ، وَاجْعَلْ فِي قُلُوبِهِمُ الإِيمَانَ وَالْحِكْمَةَ ، وَثَبِّتْهُمْ عَلَى مِلَّةِ نَبِيِّكَ ، وَأَوْزِعْهُمْ أَنْ يُوَفُّوا بِالْعَهْدِ الَّذِي عَاهَدْتَهُمْ عَلَيْهِ ، وَانْصُرْهُمْ عَلَى عَدُوِّكَ وَعَدُوِّهِمْ ، إِلَهَ الْحَقِّ ، وَاجْعَلْنَا مِنْهُمْ \" . قَالَ عَبْدُ الرَّزَّاقِ : وَلَوْ كُنْتُ إِمَامًا قُلْتُ هَذَا الْقَوْلَ ، ثُمَّ قُلْتُ : اللَّهُمَّ اهْدِنَا فِيمَنْ هَدَيْتَ","","","","","Book of Prayer"
"4824","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَطَاءٌ ، أَنَّهُ سَمِعَ عُبَيْدَ بْنَ عُمَيْرٍ ، يَأْثِرُ عَنْ عُمَرَ بْنِ الْخَطَّابِ فِي الْقُنُوتِ : أَنَّهُ كَانَ يَقُولُ : \" اللَّهُمَّ اغْفِرْ لِلْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ ، وَالْمُسْلِمِينَ وَالْمُسْلِمَاتِ ، وَأَلِّفْ بَيْنَ قُلُوبِهِمْ ، وَأَصْلِحْ ذَاتَ بَيْنِهِمْ ، وَانْصُرْهُمْ عَلَى عَدُوِّكَ وَعَدُوِّهِمْ ، اللَّهُمَّ الْعَنْ كَفَرَةَ أَهْلِ الْكِتَابِ الَّذِينَ يُكَذِّبُونَ رُسُلَكَ وَيُقَاتِلُونَ أَوْلِيَاءَكَ ، اللَّهُمَّ خَالِفْ بَيْنَ كَلِمَتِهِمْ ، وَزَلْزِلْ أَقْدَامَهُمْ ، وَأَنْزِلْ بِهِمْ بَأْسَكَ الَّذِي لا تَرُدُّهُ عَنِ الْقَوْمِ الْمُجْرِمِينَ ، بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ ، اللَّهُمَّ إِنَّا ، نَسْتَعِينُكَ ، وَنَسْتَغْفِرُكَ ، وَنُثْنِي عَلَيْكَ وَلا نَكْفُرُكَ ، وَنَخْلَعُ وَنَتْرُكُ مَنْ يَفْجُرُكَ ، بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ ، اللَّهُمَّ إِيَّاكَ نَعْبُدُ ، وَلَكَ نُصَلِّي وَنَسْجُدُ ، وَإِلَيْكَ نَسْعَى وَنَحْفِدُ ، نَرْجُو رَحْمَتَكَ ، وَنَخَافُ عَذَابَكَ ، إِنَّ عَذَابَكَ بِالْكُفَّارِ مُلْحَقٌ \" ، قَالَ : وَسَمِعْتُ عُبَيْدَ بْنَ عُمَيْرٍ ، يَقُولُ : الْقُنُوتُ قَبْلَ الرَّكْعَةِ الآخِرَةِ مِنَ الصُّبْحِ ، وَذُكِرَ أَنَّهُ بَلَغَهُ أَنَّهُمَا سُورَتَانِ مِنَ الْقُرْآنِ فِي مُصْحَفِ ابْنِ مَسْعُودٍ ، وَأَنَّهُ يُوتِرُ بِهِمَا كُلَّ لَيْلَةٍ ، وَذُكِرَ أَنَّهُ يَجْهَرُ بِالْقُنُوتِ فِي الصُّبْحِ ، قُلْتُ : فَإِنَّكَ تَكْرَهُ الاسْتِغْفَارَ ، فِي الْمَكْتُوبَةِ ، فَهَذَا عُمَرُ قَدِ اسْتغْفَرَ ، قَالَ : قَدْ فَرَغَ ، هُوَ فِي الدُّعَاءِ فِي آخِرِهَا","","","","","Book of Prayer"
"4825","عَنِ الثَّوْرِيِّ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مَيْمُونِ بْنِ مِهْرَانَ ، عَنْ أُبَيِّ بْنِ كَعْبٍ ، أَنَّهُ كَانَ يَقُولُ : \" اللَّهُمَّ إِنَّا نَسْتَعِينُكَ ، وَنَسْتَغْفِرُكَ ، وَنُثْنِي عَلَيْكَ فَلا نَكْفُرُكَ ، وَنَخْلَعُ وَنَتْرُكُ مَنْ يَفْجُرُكُ ، اللَّهُمَّ إِيَّاكَ نَعْبُدُ ، وَلَكَ نُصَلِّي وَنَسْجُدُ ، وَإِلَيْكً نَسْعَى وَنَحْفِدُ ، نَخْشَى عَذَابَكَ ، وَنَرْجُو رَحْمَتَكَ ، إِنَّ عَذَابَكَ بِالْكُفَّارِ مُلْحَقٌ ""","","","","","Book of Prayer"
"4826","عَنْ مُبَارَكٍ ، عَنْ عَاصِمِ بْنِ سُلَيْمَانَ ، عَنْ أَبِي عُثْمَانَ النَّهْدِيِّ ، \" أَنَّ عُمَرَ كَانَ يَقْنُتُ فِي الصُّبْحِ ، قَدْرَ مِائَةِ آيَةٍ مِنَ الْقُرْآنِ ""","","","","","Book of Prayer"
"4827","عَنْ رَجُلٍ ، عَنْ شُعْبَةَ ، عَنِ الْحَكَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ \" أَنَّ عُمَرَ كَانَ يَقْنُتُ فِي الْفَجْرِ بِسُورَتَيْنِ ""","","","","","Book of Prayer"
"4828","عَنْ جَعْفَرٍ ، عَنْ عَوْفٍ ، قَالَ : حَدَّثَنِي أَبُو رَجَاءٍ الْعُطَارِدِيُّ ، قَالَ \" صَلَّى بِنَا ابْنُ عَبَّاسٍ صَلاةَ الْغَدَاةِ فِي إِمَارَتِهِ عَلَى الْبَصْرَةِ ، فَقَنَتَ قَبْلَ الرُّكُوعِ ""","","","","","Book of Prayer"
"4829","عَنْ جَعْفَرٍ ، عَنْ عَطَاءِ بْنِ السَّائِبِ ، عَنْ عَبْدِ اللَّهِ بْنِ حَبِيبٍ ، \" أَنَّ عَلِيًّا كَانَ يَقْنُتُ فِي صَلاةِ الْغَدَاةِ قَبْلَ الرُّكُوعِ ، وَفي الْوِتْرِ قَبْلَ الرُّكُوعِ \" ، قَالَ : وَأَخْبَرَنِي عَوْفٌ ، أَنَّ عَلِيًّا كَانَ يَقْنُتُ قَبْلَ الرُّكُوعِ","","","","","Book of Prayer"
"4830","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ عَمْرِو بْنِ مُرَّةَ ، قَالَ : سَمِعْتُ عَبْدَ الرَّحْمَنِ بْنَ أَبِي لَيْلَى يُحَدِّثُ ، عَنِ الْبَرَاءِ بْنِ عَازِبٍ \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، كَانَ يَقْنُتُ فِي الْفَجْرِ وَالْمَغْرِبِ ""","","","","","Book of Prayer"
"4831","عَنْ يَحْيَى ، عَنِ الثَّوْرِيِّ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنْ عَبْدِ اللَّهِ بْنِ مَعْقِلٍ ، \" أَنَّ عَلِيًّا قَنَتَ فِي الْمَغْرِبِ ، فَدَعَا عَلَى نَاسٍ وَعَلَى أشْيَاعِهِمْ ، وَقَنَتَ قَبْلَ الرُّكُوعِ ""","","","","","Book of Prayer"
"4832","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَبْدِ الْكَرِيمِ بْنِ أَبِي الْمُخَارِقِ ، قَالَ : رَأَيْتَ الْحَسَنَ ، لَقِيَ أَبَا رَافِعٍ الصَّائِغَ ، فَقَالَ : إِنِّي بَيْنَهُمَا ، فَقَالَ الْحَسَنُ : \" الْقُنُوتُ قَبْلَ الرُّكُوعِ \" ، فَقَالَ أَبُو رَافِعٍ : \" لا ، بَعْدَ الرُّكُوعِ \" ، فَعَلْنَا مَعَ عُمَرَ ، فَقَالَ الْحَسَنُ : كَمْ ؟ قَالَ : شَهْرَيْنِ ، قَالَ أَبُو رَافِعٍ : بَلْ سَنَتَيْنِ ، قَالَ : وَأَشَارَ عَبْدُ الْكَرِيمِ بِإِصْبِعِهِ ، يَعْنِي فِي الصُّبْحِ ""","","","","","Book of Prayer"
"4833","عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ الْكَاهِلِيِّ ، \" أَنَّ عَلِيًّا كَانَ يَقْنُتُ بِهَاتَيْنِ السُّورَتَيْنِ فِي الْفَجْرِ ، غَيْرَ أَنَّهُ يُقَدِّمُ الآخِرَةَ ، وَيَقُولُ : \" اللَّهُمَّ إِيَّاكَ نَعْبُدُ ، وَلَكَ نُصَلِّي وَنَسْجُدُ ، وَإِلَيْكَ نَسْعَى وَنَحْفِدُ ، نَرْجُو رَحْمَتَكَ ، وَنَخَافُ عَذَابَكَ ، إِنَّ عَذَابَكَ بِالْكَافِرِينَ مُلْحَقٌ ، اللَّهُمَّ إِنَّا نَسْتَعِينُكَ ، وَنَسْتَهْدِيكَ ، وَنُثْنِي عَلَيْكَ الْخَيْرَ كُلَّهُ ، وَنَشْكُرُكَ وَلا نَكْفُرُكَ وَنُؤْمِنُ بِكَ ، وَنَخْلَعُ وَنَتْرُكُ مَنْ يَفْجُرُكَ ""","","","","","Book of Prayer"
"4834","قَالَ الْحَكَمُ : وَأَخْبَرَنِي طَاوُسٌ ، أَنَّهُ سَمِعَ ابْنَ عَبَّاسٍ ، يَقُولُ : \" قَنَتَ عُمَرُ قَبْلَ الرَّكْعَةِ بِهَاتَيْنِ السُّورَتَيْنِ ، إِلا أَنَّهُ قَدَّمَ الَّتِي أَخَّرَ عَلِيٌّ ، وَأَخَّرَ الَّتِي قَدَّمَ عَلِيٌّ ، وَالْقَوْلُ سَوَاءٌ ""","","","","","Book of Prayer"
"4835","عَنِ بْنِ عُيَيْنَةَ ، عَنِ الْمُخَارِقِ ، قَالَ : سَمِعْتُ طَارِقَ بْنَ شِهَابٍ ، يَقُولُ : قَنَتَ عُمَرُ ، قَالَ : فَأَخْبَرَنِي أَصْحَابُنَا عَنِ الْمُخَارِقِ ، عَنْ طَارِقِ \" أَنَّهُ كَبَّرَ حِينَ قَنَتَ ، يَقُولُ حِينَ فَرَغَ مِنَ الْقِرَاءَةِ ثُمَّ كَبَّرَ حِينَ خَرَّ ""","","","","","Book of Prayer"
"4836","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ سَعِيدٍ ، عَنْ قَتَادَةَ ، عَنْ أَبِي رَافِعٍ ، قَالا : \" صَلَّيْنَا خَلْفَ عُمَرَ الْفَجْرَ فَقَنَتَ بَعْدَ الرُّكُوعِ \" ، قَالَ أَحَدُهُمَا : رَفَعَ يَدَهُ ، وَقَالَ الآخَرُ : لَمْ يَرْفَعْ يَدَهُ ""","","","","","Book of Prayer"
"4837","عَنْ عُمَرَ بْنِ رَاشِدٍ ، أَوْ غَيْرِهِ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ \" أَنَّهُ كَانَ يَقْنُتُ فِي الرَّكْعَةِ الآخِرَةِ مِنْ صَلاةِ الظُّهْرِ ، وَصَلاةِ الْعِشَاءِ الآخِرَةِ ، وَصَلاةِ الصُّبْحِ بَعْدَمَا يَقُولُ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ ، فَيَدْعُو لِلْمُؤْمِنِينَ وَيلْعَنُ الْكَافِرِينَ \" ، وَيَذْكُرُ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَفْعَلَهُ","","","","","Book of Prayer"
"4838","عَنْ مَعْمَرٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، يَقُولُ : الْقُنُوتُ فِي الْوِتْرِ وَالصُّبْحِ \" اللَّهُمَّ إِنَّا نَسْتَعِينُكَ ، وَنَسْتَغْفِرُكَ ، وَنُثْنِي عَلَيْكَ الْخَيْرَ ، وَلا نَكْفُرُكَ ، وَنُؤْمِنُ بِكَ ، وَنَخْلَعُ وَنَتْرُكُ مَنْ يَفْجُرُكَ ، اللَّهُمَّ إِيَّاكَ نَعْبُدُ ، وَلَكَ نُصَلِّي وَنَسْجُدُ ، وَإِلَيْكَ نَسْعَى وَنَحْفِدُ ، نَرْجُو رَحْمَتَكَ ، وَنَخْشَى عَذَابَكَ الْجِدَّ ، إِنَّ عَذَابَكَ الْجِدَّ بِالْكُفَّارِ مُلْحَقٌ ، اللَّهُمَّ عَذِّبِ الْكَفَرَةَ وَالْمُشْرِكِينَ ، وَأَلْقِ فِي قُلُوبِهِمُ الرُّعْبَ ، وَخَالِفْ بَيْنَ كَلِمَتِهِمْ ، وَأَنْزِلْ عَلَيْهِمْ رِجْزَكَ وَعَذَابَكَ ، اللَّهُمَّ عَذِّبِ كَفَرَةَ أَهْلِ الْكِتَابِ الَّذِينَ يَصُدُّونَ عَنْ سَبِيلِكَ وَيُكَذِّبُونَ رُسُلَكَ ، اللَّهُمَّ اغْفِرْ لِلْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ ، وَالْمُسْلِمِينَ وَالْمُسْلِمَاتِ ، اللَّهُمَّ أَصْلِحْ ذَاتَ بَيْنِهِمْ ، وَأَلِّفْ بَيْنَ قُلُوبِهِمْ ، وَاجْعَلْ فِي قُلُوبِهِمُ الإِيمَانَ وَالْحِكْمَةَ ، وَأَوْزِعْهُمْ أَنْ يَشْكُرُوا نِعْمَتَكَ الَّتِي أَنْعَمْتَ عَلَيْهِمْ ، وَأَنْ يُوَفُّوا بِالْعَهْدِ الَّذِي عَاهَدْتَهُمْ عَلَيْهِ ، وَانْصُرْهُمْ عَلَى عَدُوِّكَ وَعَدُوِّهِمْ إِلَهَ الْحَقِّ وَاجْعَلْنَا مِنْهُمْ \" ، فَكَانَ يَقُولُ هَذَا ، ثُمَّ يَخِرُّ سَاجِدًا ، وَكَانَ لا يَزِيدُ عَلَى هَذَا شَيْئًا مِنَ الصَّلاةِ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَكَانَ بَعْضُ مَنْ يَسْأَلُهُ ، يَقُولُ : يَا أَبَا سَعِيدٍ ، أيَزِيدُ عَلَى هَذَا شَيْئًا مِنَ الصَّلاةِ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَالدُّعَاءِ ، وَالتَّسْبِيحِ ، وَالتَّكْبِيرِ ؟ فَيَقُولُ : \" لا أَنْهَاكُمْ ، وَلَكِنِّي سَمِعْتُ أَصْحَابَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، لا يَزِيدُونَ عَلَى هَذَا شَيْئًا ، وَيَغْضَبُ إِذَا أَرَادُوهُ عَلَى الزِّيَادَةِ","","","","","Book of Prayer"
"4839","عَنِ ابْنِ جُرَيْجٍ ، وَمَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالَ \" إِنَّمَا الْقُنُوتُ طَاعَةٌ لِلَّهِ ، وَكَانَ يَقْنُتُ بِأَرْبَعِ آيَاتٍ مِنْ أَوَّلِ الْبَقَرَةِ ، ثُمَّ  إِنَّ فِي خَلْقِ السَّمَوَاتِ وَالأَرْضِ ، هَذِهِ الآيَةَ و َ  اللَّهُ لا إِلَهَ إِلا هُوَ الْحَيُّ الْقَيُّومُ ، وَهَذِهِ الآيَةُ  لَهُ مَا فِي السَّمَوَاتِ وَمَا فِي الأَرْضِ ، حَتَّى يَخْتِمَ الْبَقَرَةَ ، ثُمَّ قُلْ هُوَ اللَّهُ أَحَدٌ ، ثُمَّ قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ ، ثُمَّ قُلْ أَعُوذُ بِرَبِّ النَّاسِ ، ثُمَّ يَقُولُ : اللَّهُمَّ إِيَّاكَ نَعْبُدُ ، وَلَكَ نُصَلِّي وَنَسْجُدُ ، وَإِلَيْكَ نَسْعَى وَنَحْفِدُ ، نَخْشَى عَذَابَكَ وَنَرْجُو رَحْمَتَكَ ، إِنَّ عَذَابَكَ بِالْكَافِرِينَ مُلْحَقٌ ، اللَّهُمَّ إِنَّا نَسْتَعِينُكَ ، وَنَسْتَغْفِرُكَ ، وَنُثْنِي عَلَيْكَ فَلا نَكْفُرُكَ ، وَنُؤْمِنُ بِكَ وَنَخْلَعُ وَنَتْرُكُ مَنْ يَكْفُرُكَ ، وَذَكَرُوا أَنَّهَا سُورَتَانِ مِنَ الْبَقَرَةِ ، وَأَنَّ مَوْضِعَهُمَا بَعْدَ قُلْ هُوَ اللَّهُ أَحَدٌ \" ، قَالَ ابْنُ جُرَيْجٍ فِي حَدِيثِهِ ، عَنِ ابْنِ طَاوُسٍ ، قَالَ : \" كَانَ يَقُولُهُمَا أَبِي فِي الصُّبْحِ ، وَكَانَ لا يَجْهَرُ بِهِ ، وَكَانَ يَقُولُ هُوَ فِي الظُّهْرِ وَالْعَصْرِ وَالْعِشَاءِ الآخِرَةِ ، فَيَقُولُ فِي الرَّكْعَتَيْنِ الأُخْرَيَيْنِ مِنَ الظُّهْرِ وَالْعَصْرِ وَالْعِشَاءِ ، وَيَقُولُ فِي الرَّكْعَةِ الأُولَى مِنَ الأُخْرَيَيْنِ مِنَ الظُّهْرِ مَا فِي الْبَقَرَةِ ، وَيَقُولُ فِي الآخِرَةِ مِنَ الأُخْرَيَيْنِ مِنَ الظُّهْرِ مَا سِوَى ذَلِكَ ، وَكَذَلِكَ فِي الْعَصْرِ وَالْعِشَاءِ الآخِرَةِ ، وَكَانَ يُوتِرُ ، وَكَانَ يَجْعَلُ الْقِرَاءَةَ فِي الْوِتْرِ ""","","","","","Book of Prayer"
"4840","عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، قَالَ : أَخْبَرَنِي بُرَيْدُ بْنُ أَبِي مَرْيَمَ ، عَنْ أَبِي الْحَوْرَاءِ ، قَالَ : قُلْتُ لِلْحَسَنِ بْنِ عَلِيٍّ : مِثْلَ مَنْ كُنْتَ يَوْمَ مَاتَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَمَا تَعْقِلُ عَنْهُ ؟ قَالَ : عَقَلْتُ أَنَّ رَجُلا جَاءَهُ يَوْمًا فَسَأَلَهُ عَنْ شَيْءٍ ، فَقَالَ : دَعْ مَا يَرِيبُكَ إِلَى مَا لا يَرِيبُكَ ، فَإِنَّ الشَّرَّ يَرِيبُكَ ، وَإِنَّ الْخَيْرَ طُمَأْنِينَةٌ","","","","","Book of Prayer"
