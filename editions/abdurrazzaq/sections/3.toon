hadiths[605]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"1211","عَنْ مَالِكٍ ، عَنْ نَافِعٍ , قَالَ :  كُنَّ جَوَارِيَ عَبْدِ اللَّهِ بْنِ عُمَرَ"" يَغْسِلْنَ رِجْلَيْهِ وَهُنَّ حُيَّضٌ ، وَيُلْقِينَ إِلَيْهِ الْخُمُرَةَ ""","","","","","Book of Prayer"
"1212","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : أَرْسَلَتْ أُمِّي إِلَى عَلْقَمَةَ : أَتُمَرِّضُ الْحَائِضُ ؟ , قَالَ : "" نَعَمْ ، إِذَا حُضِرْتِ فَلْتَقُمْ مِنْ عِنْدِكِ "" , قَالَ : قُلْتُ : تُغَسِّلُنِي إِذَا مِتُّ ؟ , قَالَ : لا ""","","","","","Book of Prayer"
"1213","عَنْ عَبْدِ اللَّهِ , قَالَ : كَانَ ابْنُ عُمَرَ يَغْسِلُ قَدَمَيْهِ الْحَائِضُ ، وَكَانَ يُصَلِّي عَلَى الْحَائِضِ ""","","","","","Book of Prayer"
"1214","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ ثَابِتِ بْنِ عُبَيْدٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ عَائِشَةَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ لَهَا : نَاوِلِينِي الْخُمْرَةَ "" , قَالَتْ : أَنَا حَائِضٌ , قَالَ : "" إِنَّهَا لَيْسَتْ فِي يَدِكِ ""","","","","","Book of Prayer"
"1215","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، أَنَّ أَبَا ظَبْيَانَ , أَرْسَلَ إِلَى إِبْرَاهِيمَ يَسْأَلُهُ ، عَنِ الْحَائِضِ تُوَضِّئُنِي ، ثُمَّ أَسْتَنِدُ إِلَيْهَا فَأُصَلِّي , قَالَ : لا ""","","","","","Book of Prayer"
"1216","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، عَنْ مَسْرُوقٍ , قَالَ : دَخَلْتُ عَلَى عَائِشَةَ ، فَقُلْتُ : يَا أُمَّ الْمُؤْمِنِينَ ! مَا يَحِلُّ لِلرَّجُلِ مِنِ امْرَأَتِهِ حَائِضًا ؟ , قَالَتْ : "" مَا دُونَ الْفَرْجِ "" , قَالَ : فَغَمَزَ مَسْرُوقٌ بِيَدِهِ رَجُلا كَانَ مَعَهُ أَيِ اسْمَعْ , قَالَ : قُلْتُ : فَمَا يَحِلُّ لِي مِنْهَا صَائِمًا ؟ , قَالَتْ : "" كُلُّ شَيْءٍ , إِلا الْجِمَاعَ "", قَالَ مَعْمَرٌ : "" بَلَغَنِي أَنَّ امْرَأَةً مِنْ نِسَاءِ ابْنِ عُمَرَ كَانَتْ تُنَاوِلُهُ الْخُمْرَةَ حَائِضًا ""","","","","","Book of Prayer"
"1217","عَنْ مَعْمَرٍ ، عَنْ خُصَيْفٍ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : إِنْ أَصَابَهَا حَائِضًا تَصَدَّقَ بِدِينَارٍ ""","","","","","Book of Prayer"
"1218","عَنِ ابْنِ جُرَيْجٍ ، عَنْ خُصَيْفٍ ، عَنْ مِقْسَمٍ مَوْلَى عَبْدِ اللَّهِ بْنِ الْحَارِثِ أَخْبَرَهُ ، أَنَّ رَجُلا جَاءَ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَصَابَ امْرَأَتَهُ حَائِضًا , فَأَمَرَ أَنْ يَتَصَدَّقَ بِنِصْفِ دِينَارٍ "", قَالَ ابْنُ جُرَيْجٍ : وَكَانَ الْحَكَمُ بْنُ عُتَيْبَةَ ، عَنْ مِقْسَمٍ , يَقُولُ : لا أَدْرِي , قَالَ مِقْسَمٌ : "" دِينَارًا ، أَوْ قَالَ : نِصْفَ دِينَارٍ ""","","","","","Book of Prayer"
"1219","عَنِ الثَّوْرِيِّ ، عَنْ خُصَيْفٍ ، وَعَلِيِّ بْنِ بَذِيمَةَ ، عَنْ مِقْسَمٍ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَمَرَ رَجُلا أَتَى امْرَأَتَهُ حَائِضًا , أَنْ يَتَصَدَّقَ بِنِصْفِ دِينَارٍ ""","","","","","Book of Prayer"
"1220","أَخْبَرَنَا مَعْمَرُ بْنُ رَاشِدٍ ، وَابْنُ جُرَيْجٍ ، قَالا : أَخْبَرَنَا عَبْدُ الْكَرِيمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ أَتَى امْرَأَتَهُ فِي حَيْضَتِهَا , فَلْيَتَصَدَّقْ بِدِينَارٍ ، وَمَنْ أَتَاهَا وَقَدْ أَدْبَرَ الدَّمُ عَنْهَا ، فَلَمْ تَغْتَسِلْ , فَنِصْفُ دِينَارٍ ""كُلُّ ذَلِكَ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : أَخْبَرَنَا مَعْمَرُ بْنُ رَاشِدٍ ، عَنْ عَبْدِ الْكَرِيمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ""","","","","","Book of Prayer"
"1221","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنَا عَبْدُ الْكَرِيمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ جَعَلَ فِي الْحَائِضِ نِصَابَ دِينَارٍ , إِذَا أَصَابَهَا قَبْلَ أَنْ تَغْتَسِلَ ""","","","","","Book of Prayer"
"1222","أَخْبَرَنَا هِشَامٌ ، عَنِ الْحَسَنِ أَنَّهُ كَانَيَقِيسُهُ بَالَّذِي يَقَعُ عَلَى أَهْلِهِ فِي رَمَضَانَ, قَالَ : قَالَ هِشَامٌ ، وَقَالَ ابْنُ سِيرِينَ :  لَيْسَ عَلَيْهِ شَيْءٌ ، يَسْتَغْفِرُ اللَّهَ "" , وَقَالَهُ مَعْمَرٌ ، عَنِ الْحَسَنِ""","","","","","Book of Prayer"
"1223","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، وَعَنْ مَنْصُورٍ ، وَالأَعْمَشِ ، عَنْ إِبْرَاهِيمَ , قَالا : لَيْسَ عَلَيْهِ شَيْءٌ يَسْتَغْفِرُ اللَّهَ ""","","","","","Book of Prayer"
"1224","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : سَأَلْتُهُ  عَنِالْحَائِضِ يُصِيبُهَا زَوْجُهَا , قَالَ : لَمْ أَسْمَعْ فِيهِ بِكَفَّارَةٍ مَعْلُومَةٍ ، فَلْيَسْتَغْفِرِ اللَّهَ ""","","","","","Book of Prayer"
"1225","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، أَنَّ رَجُلا , قَالَ لأَبِي بَكْرٍ الصِّدِّيقِ :رَأَيْتُ فِي الْمَنَامِ أَبُولُ دَمًا , قَالَ :  أَنْتَ رَجُلٌ تَأْتِي امْرَأَتَكَ وَهِيَ حَائِضٌ فَاسْتَغْفِرِ اللَّهَ ، وَلا تَعُدْ ""","","","","","Book of Prayer"
"1226","أَخْبَرَنَا مُحَمَّدُ بْنُ رَاشِدٍ , قَالَ : سَمِعْتُ مَكْحُولا ، يُسْأَلُ عَنِ الرَّجُلِ يَأْتِي امْرَأَتَهُ حَائِضًا , قَالَ : يَسْتَغْفِرُ اللَّهَ , وَيَتُوبُ إِلَيْهِ ""","","","","","Book of Prayer"
"1227","عَنْ عُمَرَ بْنِ حَبِيبٍ ، عَنْ مُجَاهِدٍ فِي قَوْلِهِ :  وَلا تَقْرَبُوهُنَّ حَتَّى يَطْهُرْنَ فَإِذَا تَطَهَّرْنَ فَأْتُوهُنَّ مِنْ حَيْثُ , قَالَ : لِلنِّسَاءِ طُهْرَانِ : طُهْرُ قَوْلِهِ :  حَتَّى يَطْهُرْنَ , يَقُولُ : إِذَا تَطَهَّرْنَ مِنَ الدَّمِ قَبْلَ أَنْ يَغْتَسِلْنَ ، وَقَوْلِهِ :  فَإِذَا تَطَهَّرْنَ أَيْ إِذَا اغْتَسَلْنَ ، وَلا تَحِلُّ لِزَوْجِهَا حَتَّى تَغْتَسِلَ , يَقُولُ :  فَأْتُوهُنَّ مِنْ حَيْثُ أَمَرَكُمُ اللَّهُ مِنْ حَيْثُ يَخْرُجُ الدَّمُ ، فَإِنْ لَمْ يَأْتِهَا مِنْ حَيْثُ أُمِرَ ، فَلَيْسَ مِنَ التَّوَّابِينَ ، وَلا مِنَ الْمُتَطَهِّرَينَ ""","","","","","Book of Prayer"
"1228","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلَ إِنْسَانٌ عَطَاءً , قَالَ : الْحَائِضُ تَرَى الطُّهْرَ وَلا تَغْتَسِلُ أَتَحِلُّ لِزَوْجِهَا ؟ , قَالَ : "" لا ، حَتَّى تَغْتَسِلَ ""","","","","","Book of Prayer"
"1229","عَنْ مَالِكٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ ، أَنَّ سَالِمَ بْنَ عَبْدِ اللَّهِ ، وَسُلَيْمَانَ بْنَ يَسَارٍ ،سئلا  عَنِ الْحَائِضِ , هَلْ يُصِيبُهَا زَوْجُهَا إِذَا رَأَتِ الطُّهْرَ قَبْلَ أَنْ تَغْتَسِلَ ؟ , فَقَالا : "" لا ، حَتَّى تَغْتَسِلَ ""","","","","","Book of Prayer"
"1230","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : قُلْتُ لَهُ : أَتَقْضِي الْحَائِضُ الصَّلاةَ ؟ , قَالَ : "" لا ، ذَلِكَ بِدْعَةٌ ""","","","","","Book of Prayer"
"1231","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ عِكْرِمَةَ , قَالَ :  سُئِلَأَتَقْضِي الْحَائِضُ الصَّلاةَ ؟ , قَالَ : "" لا ، ذَلِكَ بِدْعَةٌ ""","","","","","Book of Prayer"
"1232","عَنْ مَعْمَرٍ ، عَنْ عَاصِمٍ الأَحْوَلِ ، عَنْ مُعَاذَةَ الْعَدَوِيَّةِ , قَالَتْ : سَأَلْتُ عَائِشَةَ ، فَقُلْتُ : مَا بَالُ الْحَائِضِ تَقْضِي الصَّوْمَ وَلا , تَقْضِي الصَّلاةَ ؟ فَقَالَتْ :  أَحَرُورِيَّةٌ أَنْتِ ؟ "" , قُلْتُ : لَسْتُ بِحَرُورِيَّةٍ ، وَلَكِنِّي أَسْأَلُ , قَالَتْ : "" قَدْ كَانَ يُصِيبُنَا ذَلِكَ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَفَنُؤْمَرُ بِقَضَاءِ الصَّوْمِ ، وَلا نُؤْمَرُ بِقَضَاءِ الصَّلاةِ "", عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، عَنْ مُعَاذَةَ ، عَنْ عَائِشَةَ , مِثْلَهُ""","","","","","Book of Prayer"
"1233","عَنِ الثَّوْرِيِّ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَائِشَةَ , قَالَتْ :  كُنَّا عِنْدَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ,فَلَمْ يَأْمُرِ امْرَأَةً مِنَّا أَنْ تَقْضِيَ الصَّلاةَ ""","","","","","Book of Prayer"
"1234","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : الْحَائِضُ تَقْضِي الصَّوْمَ "" ، قُلْتُ : عَمَّنْ ؟ , قَالَ : "" هَذَا مَا اجْتَمَعَ النَّاسُ عَلَيْهِ , وَلَيْسَ فِي كُلِّ شَيْءٍ نَجِدُ الإِسْنَادَ ""","","","","","Book of Prayer"
"1235","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، وَمَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالا : إِذَا طَهُرَتِ الْحَائِضُ قَبْلَ اللَّيْلِ صَلَّتِ الْعَصْرَ وَالظُّهْرَ ، وَإِذَا طَهُرَتْ قَبْلَ الْفَجْرِ صَلَّتْ بِالْمَغْرِبِ وَالْعِشَاءِ "", عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنِ الْحَكَمِ ، وَعَنْ لَيْثٍ ، وَعَنْ طَاوُسٍ , مِثْلَهُ , عَنْ إِسْرَائِيلَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , مِثْلَهُ""","","","","","Book of Prayer"
"1236","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : إِنْ طَهُرَتْ فِي أَوَّلِ النَّهَارِ فَلْتُتِمَّ صَوْمَهَا , وَإِلا فَلا ""","","","","","Book of Prayer"
"1237","أَخْبَرَنَا عَنِ ابْنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ , قَالَ : إِذَا طَهُرَتِ الْمَرْأَةُ قَبْلَ غُرُوبِ الشَّمْسِ صَلَّتْ صَلاةَ النَّهَارِ كُلَّهَا ، وَإِذَا طَهُرَتْ قَبْلَ طُلُوعِ الْفَجْرِ صَلَّتْ صَلاةَ اللَّيْلِ كُلَّهَا ""","","","","","Book of Prayer"
"1238","عَنِ الثَّوْرِيِّ ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ , قَالَ : إِذَا طَهُرَتْ فِي وَقْتِ الْعَصْرِ , صَلَّتِ الْعَصْرَ وَلَمْ تُصَلِّ الظُّهْرَ ""","","","","","Book of Prayer"
"1239","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : إِذَا طَهُرَتِ الْحَائِضُ فِي وَقْتِ صَلاةٍ صَلَّتْ تِلْكَ الصَّلاةَ ، وَإِذَا لَمْ تَطْهُرْ فِي وَقْتِهَا لَمْ تُصَلِّ تِلْكَ الصَّلاةَ ""","","","","","Book of Prayer"
"1240","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : إِذَا رَأَتِ الْمَرْأَةُ الطُّهْرَ فِي وَقْتِ صَلاةٍ فَلَمْ تَغْتَسِلْ حَتَّى يَذْهَبَ وَقْتُهَا , فَلْتُعِدْ تِلْكَ الصَّلاةَ تَقْضِيهَا "", وَقَالَهُ الثَّوْرِيُّ""","","","","","Book of Prayer"
"1241","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ شُبْرُمَةَ ، عَنِ الشَّعْبِيِّ ، قَالَ : إِذَا حَاضَتِ الْمَرْأَةُ فِي وَقْتِ صَلاةٍ لَمْ تَكُنْ صَلَّتْ تِلْكَ الصَّلاةَ , قَضَتْهَا إِذَا طَهُرَتْ ""","","","","","Book of Prayer"
"1242","أَخْبَرَنَا مَعْمَرٌ ، قَالَ : سُئِلَ قَتَادَةُ  عَنِامْرَأَةٍ نَامَتْ عَنِ الْعِشَاءِ الآخِرَةِ ، فَاسْتَيْقَظَتْ وَهِيَ حَائِضٌ , قَالَ : إِذَا طَهُرَتْ فَلْتَقْضِهَا ""","","","","","Book of Prayer"
"1243","عَنِ الثَّوْرِيِّ ، عَنْ يَعْقُوبَ بْنِ عَطَاءٍ ، عَنْ أَبِيهِ ، قَالَ : فِيالْحَائِضِ تَرَى الطُّهْرَ مِنَ اللَّيْلِ , فَلا تَغْتَسِلُ حَتَّى تُصْبِحَ ، قَالَ :  تَغْتَسِلُ ، وَتُتِمُّ صَوْمَهَا , وَلَيْسَ عَلَيْهَا قَضَاءٌ ""","","","","","Book of Prayer"
"1244","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : الْمَرْأَةُ تُصْبِحُ حَائِضًا ، ثُمَّ تَطْهُرُ فِي بَعْضِ النَّهَارِ أَتُتِمُّهُ ؟ , قَالَ : "" لا هِيَ قَاضِيَةٌ "", عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، مِثْلَ قَوْلِ عَطَاءٍ""","","","","","Book of Prayer"
"1245","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، سَمِعَ عِكْرِمَةَ , يَقُولُ : إِذَا حَاضَتْ قَبْلَ غُرُوبِ الشَّمْسِ فِي رَمَضَانَ أَكَلَتْ , وَشَرِبَتْ ""","","","","","Book of Prayer"
"1246","عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ ، وَقَتَادَةَ ، قَالا : إِذَا حَاضَتْ بَعْدَ الْعَصْرِ وَهِيَ صَائِمَةٌ أَفْطَرَتْ , وَقَضَتْ ""","","","","","Book of Prayer"
"1247","عَنْ مَعْمَرٍ ، وَقَتَادَةَ ، قال : إِذَا حَاضَتْ قَبْلَ اللَّيْلِ , فَلا صَوْمَ لَهَا ، وَإِذَا أَصْبَحَتْ حَائِضًا ، ثُمَّ طَهُرَتْ بَعْضَ النَّهَارِ , فَلا صَوْمَ لَهَا ""","","","","","Book of Prayer"
"1248","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : امْرَأَةٌ أَصْبَحَتْ حَائِضًا فَلَمْ تَرَ شَيْئًا حَتَّى طَهُرَتْ , قَالَ : "" تُبْدِلُهُ "" ، قُلْتُ : فَامْرَأَةٌ تَحِيضُ مِنْ آخِرِ النَّهَارِ أَتُتِمُّ مَا بَقِيَ ؟ , قَالَ : "" لا ، قَدْ حَاضَتْ , فَتُبْدِلُهُ لا بُدَّ ""","","","","","Book of Prayer"
"1249","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ،  أَنَّالرَّجُلَ يُصِيبُ امْرَأَتَهُ فَلا تَغْتَسِلَ حَتَّى تَحِيضَ ، قَالَ : "" تَغْتَسِلُ "" , وَقَدْ قَالَ : "" فِي الْحَيْضَةِ أَشَدَّ مِنَ الْجَنَابَةِ ، إِنَّ الْجُنُبَ لَتَمُرُّ فِي الْمَسْجِدِ , وَلا تَمُرُّ الْحَائِضُ ""","","","","","Book of Prayer"
"1250","عَنِ الثَّوْرِيِّ ، عَنِ الْعَلاءِ ، عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ ، وَسَأَلْتُهُ عَنْهُ , قَالَ : الْحَيْضُ أَكْبَرُ ""","","","","","Book of Prayer"
"1251","عَنْ مَعْمَرٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، وَعَنِ الثَّوْرِيِّ ، عَنْ هِشَامٍ ، عَنِ الْحَسَنِ , قَالَ : تَغْتَسِلُ ""","","","","","Book of Prayer"
"1252","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : تَغْسِلُ فَرْجَهَا ، ثُمَّ يَكْفِيهَا ذَلِكَ ""","","","","","Book of Prayer"
"1253","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ الزُّهْرِيَّ  عَنِالْحَائِضِ وَالْجُنُبِ أَيَذْكُرَانِ اللَّهَ ؟ , قَالَ : "" نَعَمْ "" ، قُلْتُ : أَفَيَقْرَآنِ الْقُرْآنَ ؟ , قَالَ : "" لا ""","","","","","Book of Prayer"
"1254","قَالَ مَعْمَرٌ : وَكَانَ الْحَسَنُ ، وَقَتَادَةُ ، يَقُولانِ : لا يَقْرَآنِ شَيْئًا مِنَ الْقُرْآنِ ""","","","","","Book of Prayer"
"1255","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :مَا تَقْرَأُ الْحَائِضُ , وَالْجُنُبُ مِنَ الْقُرْآنِ ؟ , فَقَالَ :  أَمَّا الْحَائِضُ فَلا تَقْرَأُ شَيْئًا ، وَأَمَّا الْجُنُبُ فَالآيَةُ . . . . ""","","","","","Book of Prayer"
"1256","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الْحَائِضُ , وَالْجُنُبُ يَذْكُرَانِ اللَّهَ ؟ , قَالَ "" نَعَمْ ""","","","","","Book of Prayer"
"1257","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ : الْحَائِضُ وَالْجُنُبُ يَذْكُرَانِ اللَّهَ , وَيُسَمِّيَانِ ""","","","","","Book of Prayer"
"1258","عَنِ الثَّوْرِيِّ ، عَنْ عَامِرٍ الشَّعْبِيِّ , قَالَ : سَمِعْتُ أَبَا الْغَرِيفِ الْهَمْدَانِيَّ , يَقُولُ : شَهِدْتُ عَلِيَّ بْنَ أَبِي طَالِبٍ بَالَ ، ثُمَّ قَالَ : اقْرَءُوَا الْقُرْآنَ مَا لَمْ يَكُنْ أَحَدُكُمْ جُنُبًا ، فَإِذَا كَانَ جُنُبًا فَلا وَلا حَرْفًا وَاحِدًا "", وَبِهِ يَأْخُذُ عَبْدُ الرَّزَّاقِ""","","","","","Book of Prayer"
"1259","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي وَائِلٍ ، عَنْ عَبِيدَةَ السَّلْمَانِيِّ , قَالَ : كَانَ عُمَرُ بْنُ الْخَطَّابِ يَكْرَهُ أَنْ يَقْرَأَ الْقُرْآنَ وَهُوَ جُنُبٌ ""","","","","","Book of Prayer"
"1260","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مُحَمَّدِ بْنِ طَارِقٍ , قَالَ : سَأَلْتُ ابْنَ الْمُسَيِّبِ أَيَقْرَأُ الْجُنُبُ شَيْئًا مِنَ الْقُرْآنِ ؟ , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"1261","عَنْ هِشَامِ بْنِ حَسَّانَ , قَالَ : الْجُنُبُ يُسَبِّحُ وَيَحْمَدُ اللَّهَ ، وَيَدْعُو ، وَلا يَقْرَأُ آيَةً وَاحِدَةً ""","","","","","Book of Prayer"
"1262","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : مَا يَقْرَأُ غَيْرُ الْمُتَوَضِّئِ ؟ , قَالَ : "" الْخَمْسَ آيَاتٍ , وَالأَرْبَعَ ""","","","","","Book of Prayer"
"1263","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ , قَالَ : يَقْرَأُ غَيْرُ الْمُتَوَضِّئِ الآيَاتِ ، وَكَانَ لا يُسَمِّي عِدَّتَهِنَّ "", قَالَ : وَقَالَهُ ابْنُ جُرَيْجٍ ، عَنِ ابْنِ طَاوُسٍ""","","","","","Book of Prayer"
"1264","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَادَ رَجُلٌ أَنْ يَسْتَعْرِضَ الْقُرْآنَ فَيَقْرَأَ فِي غَيْرِ صَلاةٍ , أَيَتَوَضَّأُ كَوُضُوءِ الصَّلاةِ فِي الإِسْبَاغِ وَمَسْحِ الرَّأْسِ ؟ , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"1265","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : كَانَ ابْنُ عَبَّاسٍ يُرَخِّصُ لِغَيْرِ الْمُتَوَضِّئِ أَنْ يَقْرَأَ غَيْرَ الآيَةِ , وَالآيَتَيْنِ ""","","","","","Book of Prayer"
"1266","عَنْ مَالِكٍ ، عَنْ نَافِعٍ , قَالَ : كَانَ ابْنُ عُمَرَ لا يَقْرَأُ الْقُرْآنَ إِلا طَاهِرًا "", عَنْ مَعْمَرٍ ، عَمَّنْ ، سَمِعَ الْحَسَنَ ، يَقُولُ : مِثْلَ قَوْلِ ابْنِ عُمَرَ""","","","","","Book of Prayer"
"1267","عَنِ الثَّوْرِيِّ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قَالَ : سَمِعْتُ ابْنَ عُمَرَ ، وَابْنَ عَبَّاسٍ ، قَالا : إِنَّا لَنَقْرَأُ أَجْزَاءَنَا مِنَ الْقُرْآنِ بَعْدَ الْحَدَثِ , مَا نَمَسُّ مَاءً ""","","","","","Book of Prayer"
"1268","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ , يَقُولُ : رُبَّمَا سَمِعْتُ أَبَا هُرَيْرَةَ : يَقْرَأُ يَحْدُرُ السُّورَةَ ، وَإِنَّهُ لَغَيْرُ مُتَوَضِّئٍ ""","","","","","Book of Prayer"
"1269","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : خَرَجَ عُمَرُ بْنُ الْخَطَّابِ مِنَ الْخَلاءِ فَقَرَأَ آيَةً أَوْ آيَاتٍ ، قَالَ لَهُ أَبُو مَرْيَمَ الْحَنَفِيُّ : أَخَرَجْتَ مِنَ الْخَلاءِ وَأَنْتَ تَقْرَأُ ؟ , قَالَ لهُ عمرُ : "" أَمُسَيْلِمَةُ أَفْتَاكَ بِهَذَا ! ! ؟ "", وَكَانَ مَعَ مُسَيْلِمَةَ""","","","","","Book of Prayer"
"1270","عَنْ مَعْمَرٍ ، عَنْ عَطَاءٍ الْخُرَاسَانِيِّ , قَالَ : كَانَ ابْنُ مَسْعُودٍ يَفْتَحُ عَلَى الرَّجُلِ وَهُوَ يَقْرَأُ ، ثُمَّ قَامَ فَبَالَ , فَأَمْسَكَ الرَّجُلُ عَنِ الْقِرَاءَةِ , فَقَالَ لَهُ ابْنُ مَسْعُودٍ : اقْرَأْ""","","","","","Book of Prayer"
"1271","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِيَاسٍ مُعَاوِيَةَ بْنِ قُرَّةَ ، أَنَّ أَبَا مُوسَى الأَشْعَرِيَّ ، كَانَ يَقْرَأُ عَلَى غَيْرِ وُضُوءٍ ""","","","","","Book of Prayer"
"1272","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ , قَالَ : اقْرَإِ الْقُرْآنَ عَلَى كُلِّ حَالٍ , مَا لَمْ تَكُنْ جُنُبًا ""","","","","","Book of Prayer"
"1273","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ , قَالَ : قَالَتْ عَائِشَةُ إِنِّي لأَقْرَأُ جُزْئِي "" , أَوْ قَالَتْ : "" حِزْبِي ، وَإِنِّي لَمُضْطَجِعَةٌ عَلَى السَّرِيرِ ""","","","","","Book of Prayer"
"1274","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : اقْرَإِ الْقُرْآنَ عَلَى كُلِّ حَالٍ مَا لَمْ تَكُنْ جُنُبًا ، وَادْخُلِ الْمَسْجِدَ عَلَى كُلِّ حَالٍ إِلا أَنْ تَكُونَ جُنُبًا ""","","","","","Book of Prayer"
"1275","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ أَبِي إِسْحَاقَ ، قَالَ : سَمِعْتُ عَلْقَمَةَ بْنَ قَيْسٍ , يَقُولُ : قَالَ : دَخَلْنَا عَلَى سَلْمَانَ ، فَقَرَأَ عَلَيْنَا آيَاتٍ مِنَ الْقُرْآنِ , وَهُوَ عَلَى غَيْرِ وُضُوءٍ ""","","","","","Book of Prayer"
"1276","عَنْ يَحْيَى بْنِ الْعَلاءِ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ , قَالَ : أَتَيْنَا سَلْمَانَ الْفَارِسِيَّ ,فَخَرَجَ عَلَيْنَا مِنْ كَنِيفٍ لَهُ , فَقُلْنَا لَهُ لَوْ تَوَضَّأتَ يَا أَبَا عَبْدِ اللَّهِ ، ثُمَّ قَرَأْتَ عَلَيْنَا سُورَةَ كَذَا وَكَذَا , فَقَالَ :  إِنَّمَا قَالَ اللَّهُ :  فِي كِتَابٍ مَكْنُونٍ { 78 } لا يَمَسُّهُ إِلا الْمُطَهَّرُونَ { 79 } وَهُوَ الذِّكْرُ الَّذِي فِي السَّمَاءِ , لا يَمَسُّهُ إِلا الْمَلائِكَةُ "" ، ثُمَّ قَرَأَ عَلَيْنَا مِنَ الْقُرْآنِ مَا شِئْنَا""","","","","","Book of Prayer"
"1277","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ زُرْزُرٍ ، قَالَ : سَمِعْتُ عَطَاءَ بْنَ أَبِي رَبَاحٍ ، يُسْأَلُ عَنِالرَّجُلِ يَقْرَأُ فَتَكُونُ مِنْهُ الرِّيحُ ؟ , قَالَ :  لِيُمْسِكْ عَنِ الْقِرَاءَةِ , حَتَّى يَذْهَبَ مِنْهُ الرِّيحُ ""","","","","","Book of Prayer"
"1278","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : قَضَيْتُ الْحَاجَةَ فِي بَعْضِ هَذِهِ الشِّعَابِ ، أَفَأَتَمَسَّحُ بِالتُّرَابِ ، ثُمَّ أَقْرَأُ ؟ , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"1279","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ ، عَنْ أَبِيهِ , قَالَ : فِي كِتَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِعَمْرِو بْنِ حَزْمٍ : لا يُمَسُّ الْقُرْآنُ إِلا عَلَى طُهْرٍ "", عَنِ ابْنِ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى , مِثْلَهُ""","","","","","Book of Prayer"
"1280","عَنْ مَعْمَرٍ ، عَمَّنْ سَمِعَ الْحَسَنَ , يَقُولُ : لا بَأْسَ أَنْ يَأْخُذَ الْمُصْحَفَ غَيْرُ الْمُتَوَضِّئِ , فَيَصْعَدَ مِنْ مَكَانٍ إِلَى مَكَانٍ ""","","","","","Book of Prayer"
"1281","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، أَنَّ رَجُلا , قَالَ لابْنِ عَبَّاسٍ : أَضَعُ الْمُصْحَفَ عَلَى فِرَاشٍ ، أُجَامِعُ عَلَيْهِ ، وَأَحْتَلِمُ فِيهِ ، وَأَعْرَقُ عَلَيْهِ ؟ "" قَالَ : "" نَعَمْ ""","","","","","Book of Prayer"
"1282","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَيَمَسُّ الْجُنُبُ وَالْحَائِضُ , الْمُصْحَفَ وَهُوَ فِي خِبَائِهِ ؟ , قَالَ : "" لا "" , قُلْتُ : فَبَيْنَ أَيْدِيهِمَا , وَبَيْنَ أَخْبِيَتِهِ ثَوْبٌ ؟ , قَالَ : "" لا ، وَلا الْخِبَاءُ أَكَفُّ مِنَ الثَّوْبِ "" , قُلْتُ : فَغَيْرُ الْمُتَوَضِّئِ وَهُوَ فِي خِبَائِهِ ؟ , قَالَ : "" نَعَمْ ، لا يَضُرُّهُ "" , قُلْتُ : فَيَأْخُذُهُ مُطْبَقًا ؟ , قَالَ : "" نَعَمْ ""","","","","","Book of Prayer"
"1283","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : لا يُمَسُّ الْمُصْحَفُ مُفْضِيًا إِلَيْهِ غَيْرُ مُتَوَضِّئٍ "" , قُلْتُ : فَبَيْنَ أَيْدِيهِمَا , وَبَيْنَ أَخْبِيَتِهِ ثَوْبٌ ؟ , قَالَ : "" وَلا الْخِبَاءُ أَكَفُّ مِنَ الثَّوْبِ ؟ "" , قُلْتُ : غَيْرُ الْمُتَوَضِّئِ وَهُوَ فِي خِبَائِهِ ؟ , قَالَ : "" نَعَمْ ، لا يَضُرُّهُ "" , قُلْتُ : فَيَأْخُذُهُ مُطْبَقًا ؟ , قَالَ : "" نَعَمْ ""","","","","","Book of Prayer"
"1284","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، وَطَاوُسٍ ، وَالْقَاسِمِ بْنِ مُحَمَّدٍ كَرِهُوَا أَنْ يَمَسَّ الْمُصْحَفَ وَهُوَ عَلَى غَيْرِ وُضُوءٍ ""","","","","","Book of Prayer"
"1285","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : أُحِبُّ أَنْ لا تُمَسَّ الدَّرَاهِمُ وَالدَّنَانِيرُ إِلا عَلَى وُضُوءٍ ، وَلَكِنْ لا بُدَّ لِلنَّاسِ مِنْ مَسِّهَا ، جُبِلُوَا عَلَى ذَلِكَ "", قَالَ ابْنُ جُرَيْجٍ ، وَكَرِهَ عَطَاءٌ أَنْ تَمَسَّ الْحَائِضُ , وَالْجُنُبُ الدَّنَانِيرَ وَالدَّرَاهِمَ""","","","","","Book of Prayer"
"1286","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : لا تُمَسُّ الدَّرَاهِمُ الَّتِي فِيهَا الْقُرْآنُ , إِلا عَلَى وُضُوءٍ ""","","","","","Book of Prayer"
"1287","وَقَالَ مَعْمَرٌ : وَكَانَ الْحَسَنُ ، وَقَتَادَةُ ،لا يَرَيَانِ بِهِ بَأْسًا يَقُولُونَ :  جُبِلُوَا عَلَى ذَلِكَ ""","","","","","Book of Prayer"
"1288","عَنْ هِشَامِ بْنِ حَسَّانَ , قَالَ : أَرْسَلَنِي ابْنُ سِيرِينَ , أَسْأَلُ الْقَاسِمَ بْنَ مُحَمَّدٍ , عَنِالدَّرَاهِمِ الَّتِي فِيهَا ذِكْرُ اللَّهِ أَيَبْتَاعُ بِهَا النَّاسُ ، وَفِيهَا الْكِتَابُ ؟ , وَسَأَلْتُهُ ، فَقَالَ :  لا بَأْسَ بِالْكِتَابِ يَتَبَايَعُونَ ، إِنَّمَا يَتَبَايَعُونَ بِالذَّهَبِ وَالْفِضَّةِ ، لَوْ ذَهَبْتَ بِالْكِتَابِ فِي رُقْعَةٍ مَا أَعْطَوْكَ شَيْئًا ، وَلَكِنْ لا تَمَسُّ الدَّرَاهِمُ الَّتِي فِيهَا ذِكْرُ اللَّهِ , إِلا عَلَى وُضُوءٍ ""","","","","","Book of Prayer"
"1289","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ لا تُمَسُّ الدَّرَاهِمُ الَّتِي فِيهَا ذِكْرُ اللَّهِ , إِلا عَلَى وُضُوءٍ ""","","","","","Book of Prayer"
"1290","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : لا يَمَسُّ الدَّرَاهِمَ غَيْرُ مُتَوَضِّئٍ "", عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، مِثْلَ ذَلِكَ , إِلا أَنَّهُ قَالَ : "" مِنْ وَرَاءِ الثَّوْبِ ""","","","","","Book of Prayer"
"1291","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، أَنَّهُسُئِلَ  عَنِ الْهِمْيَانِ فِيهِ الدَّرَاهِمُ , فَيَأْتِي الْخَلاءَ , قَالَ : لا بُدَّ لِلنَّاسِ مِنْ نَفَقَاتِهِمْ ""","","","","","Book of Prayer"
"1292","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ , قَالَ : سَأَلْتُ إِبْرَاهِيمَ : أَكْتُبُ الرَّسَالَةَ عَلَى غَيْرِ وُضُوءٍ ؟ قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"1293","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ : يُكْرَهُ أَنْ يَكْتُبَ الْجُنُبُ بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ ""","","","","","Book of Prayer"
"1294","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : لَقَدْ كَانَ يُسْتَحَبُّ أَنْ لا يُقْرَأَ الأَحَادِيثُ الَّتِي عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , إِلا عَلَى وُضُوءٍ "", عَنْ مَعْمَرٍ ، عَنْ صَدَقَةَ بْنِ يَسَارٍ , قَالَ : سُئِلَ ابْنُ الْمُسَيِّبِ , عَنْ ذَلِكَ فَلَمْ يَرَ بِهِ بَأْسًا""","","","","","Book of Prayer"
"1295","عَنْ شَيْخٍ مِنْ أَهْلِ مَكَّةَ ، قَالَ : سَمِعْتُ سُفْيَانَ الْعُصْفُرِيَّ , يَقُولُ : رَأَيْتُ سَعِيدَ بْنَ جُبَيْرٍ بَالَ ، ثُمَّ غَسَلَ وَجْهَهُ ، ثُمَّ أَخَذَ الْمُصْحَفَ فَقَرَأَ فِيهِ "", قَالَ أَبُو بَكْرٍ : وَسَمِعْتُهُ مِنْ مَرْوَانَ بْنِ مُعَاوِيَةَ الْفَزَارِيِّ""","","","","","Book of Prayer"
"1296","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الْقُرْآنُ كَانَ عَلَى امْرَأَةٍ فَحَاضَتْ , أَوْ أَصَابَتْهَا جَنَابَةٌ أَتَنْزَعُهَا ؟ , قَالَ : "" إِذَا كَانَ فِي قَصَبَةٍ فَلا بَأْسَ "" , قُلْتُ : فَكَانَ فِي رُقْعَةٍ ؟ , فَقَالَ : "" هَذِهِ أَبْغَضُ إِلَيَّ "" ، قُلْتُ : فَلِمَ يَخْتَلِفَانِ ؟ , قَالَ : "" إِنَّ الْقَصَبَةَ هِيَ أَكَفُّ مِنَ الرُّقْعَةِ "" , قَالَ ابْنُ جُرَيْجٍ : وَسَمِعْتُهُ قَبْلَ ذَلِكَ يُسْأَلُ : أَيُجْعَلُ عَلَى صَبِيٍّ الْقُرْآنُ ؟ , قَالَ : "" إِذَا كَانَ فِي قَصَبَةٍ مِنْ حَدِيدٍ ، أَوْ قَصَبَةٍ مَا كَانَتْ فَنَعَمْ ، وَأَمَّا رُقْعَةٌ فَلا "" , فَقَالَ : فِي الشَّقِيقَةِ وَهُوَ اللَّوْحُ فِي قِلادَةِ الصَّبِيِّ ؟ , فَيَقُولُ : "" لا تَطْهُرُ ""","","","","","Book of Prayer"
"1297","أَخْبَرَنِي مَعْمَرٌ , قَالَ : أَخْبَرَنِي عَلْقَمَةُ بْنُ أَبِي عَلْقَمَةَ , قَالَ : سَأَلْتُ ابْنَ الْمُسَيِّبِ ، عَنِ الاسْتِعَاذَةِ تَكُونُ عَلَى الْحَائِضِ , وَالْجُنُبِ ؟ , فَقَالَ : "" لا بَأْسَ بِهِ إِذَا كَانَ فِي قَصَبَةٍ , أَوْ رُقْعَةٍ يَجُوزُ عَلَيْهَا ""","","","","","Book of Prayer"
"1298","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ ، وَعَنْ مَعْمَرٍ ، عَنْ مَنْصُورٍ ، قَالا :  كَانَوَايَكْرَهُونَ أَنْ يُعَلِّقُوَا مَعَ الْقُرْآنِ شَيْئًا ""","","","","","Book of Prayer"
"1299","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :خَاتَمٌ فِي يَدِ حَائِضٍ , أَوْ جُنُبٍ ؟ , قَالَ :  لا يَضُرُّهُ , إِنَّمَا فِي الْخَاتَمِ الْحَرْفُ ، أَوِ الشَّيْءُ الْيَسِيرُ "" , قُلْتُ : فَغَيْرُ الْمُتَوَضِّئِ وَيَأْتِي الْخَلاءَ وَهُوَ فِي يَدِهِ ؟ , قَالَ : "" لا يَضُرُّهُ ""","","","","","Book of Prayer"
"1300","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، وَمَعْمَرٌ ، عَنْ صَدَقَةَ بْنِ يَسَارٍ , قَالَ : سُئِلَ ابْنُ الْمُسَيِّبِ ، عَنِ الْخَاتَمِ فِيهِ اسْمُ اللَّهِ وَهِيَ تُصِيبُهُ الْجَنَابَةُ , قَالَ : "" لا بَأْسَ بِهِ "" , قُلْتُ : فَإِنِّي أَدْخُلُ الْكُنُفَ ، وَتُصِيبُنِي الْجَنَابَةُ , قَالَ : "" لا بَأْسَ بِهِ "", وَقَالَ : أَفْتَانِي سَعِيدُ بْنُ الْمُسَيِّبِ""","","","","","Book of Prayer"
"1301","أَخْبَرَنَا مَعْمَرٌ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ , قَالَ : كَانَ نَقْشُ خَاتَمِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مُحَمَّدٌ ""","","","","","Book of Prayer"
"1302","عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ ، عَنْ أَبِي جَعْفَرٍ , قَالَ : كَانَ فِي خَاتَمِ عَلِيٍّ تَعَالَى اللَّهُ الْمَلِكُ ""","","","","","Book of Prayer"
"1303","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنْ أَبِي جَعْفَرٍ , قَالَ : كَانَ فِي خَاتَمِ عَلِيٍّ تَعَالَى اللَّهُ الْمَلِكُ ""","","","","","Book of Prayer"
"1304","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ  أَنَّهُكَانَ نَقْشُ خَاتَمِهِ : لا إِلَهَ إِلا اللَّهُ , وَكَانَ لا يَلْبَسُهُ ""","","","","","Book of Prayer"
"1305","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ نَقَشَ فِي خَاتَمِهِ اسْمَهُ , وَكَانَ لا يَلْبَسُهُ ""","","","","","Book of Prayer"
"1306","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ كَرِهَ أَنْ يُكْتَبَ فِي الْخَاتَمِ آيَةٌ تَامَّةٌ إِلا بَعْضَهَا ""","","","","","Book of Prayer"
"1307","عَنْ مَعْمَرٍ , قَالَ : أَخْرَجَ إِلَيْنَا عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ عَقِيلٍ , خَاتَمًا نَقْشُهُ تِمْثَالٌ وَأَخْبَرَنَا ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ "" لَبِسَهُ مَرَّةً أَوْ مَرَّتَيْنِ "" , قَالَ : "" فَغَسَلَهُ بَعْضُ مَنْ كَانَ مَعَنَا , فَشَرِبَهُ ""","","","","","Book of Prayer"
"1308","عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ , قَالَ :  كَانَفِي خَاتَمِ ابْنِ مَسْعُودٍ شَجَرَةٌ أَوْ بَيْنَ ذُبَابَيْنِ ""","","","","","Book of Prayer"
"1309","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ :  كَانَنَقْشُ خَاتَمِ أَبِي مُوسَى الأَشْعَرِيِّ أَسَدٌ بَيْنَ رَجُلَيْنِ ""","","","","","Book of Prayer"
"1310","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ :  كَانَنَقْشُ خَاتَمِ أَنَسِ بْنِ مَالِكٍ كَرْكِيٌّ أَوْ قَالَ : طَائِرٌ لَهُ رَأْسَانِ، وَكَانَ نَقْشُ خَاتَمِ أَبِي عُبَيْدَةَ بْنِ الْجَرَّاحِ الْخُمُسُ لِلَّهِ ""","","","","","Book of Prayer"
"1311","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَبْدِ الْكَرِيمِ , قَالَ : سَأَلْتُ سَعِيدَ بْنَ جُبَيْرٍ عَنِ الْخَاتَمِ يُكْتَبُ فِيهِ ذِكْرُ اللَّهِ "" فَكَرِهَهُ ""","","","","","Book of Prayer"
"1312","عَنْ رَجُلٍ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، عَنْ أَبِيهِ ، أَنَّ الْحَسَنَ ، وَالْحُسَيْنَ نَقَشَا فِي خَوَاتِيمِهِمَا ذِكْرَ اللَّهِ ""","","","","","Book of Prayer"
"1313","أَخْبَرَنَا أَبُو سَعِيدٍ أَحْمَدُ بْنُ مُحَمَّدِ بْنِ زِيَادٍ الأَعْرَابِيُّ , قَالَ : حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ أَبُو يَعْقُوبَ الدَّبَرِيُّ , قَالَ : قَرَأْنَا عَلَى عَبْدِ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، وَابْنِ جُرَيْجٍ ، عَنِ الزُّهْرِيِّ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي هُرَيْرَةَ , أَنَّ رَجُلا ، قَالَ : يَا رَسُولَ اللَّهِ !  هَلْ يُصَلِّي الرَّجُلُ فِي الثَّوْبِ الْوَاحِدِ ؟ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" أَوَ لَكُمْ ثَوْبَانِ "" , قَالَ ابْنُ جُرَيْجٍ فِي حَدِيثِهِ : "" لأَتْرُكُ ثِيَابِي عَلَى الْمِشْجَبِ , وَأُصَلِّي فِي الثَّوْبِ الْوَاحِدِ""","","","","","Book of Prayer"
"1314","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ عُمَرَ بْنِ أَبِي سَلَمَةَ ، أَنَّهُ قَالَ : رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  يُصَلِّي فِي ثَوْبٍ وَاحِدٍ مُتَوَشِّحًا بِهِ قَدْ خَالَفَ بَيْنَ طَرَفَيْهِ "" , قَالَ الثَّوْرِيُّ فِي حَدِيثِهِ : "" فِي بَيْتِ أُمِّ سَلَمَةَ ""","","","","","Book of Prayer"
"1315","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , قَالَ : رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  يُصَلِّي فِي ثَوْبٍ وَاحِدٍ مُتَوَشِّحًا بِهِ ""","","","","","Book of Prayer"
"1316","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ حُمَيْدٍ الطَّوِيلِ ، عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ :  آخِرُ صَلاةٍ صَلاهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي ثَوْبٍ وَاحِدٍ مُخَالِفًا بَيْنَ طَرَفَيْهِ خَلْفَ أَبِي بَكْرٍ ""","","","","","Book of Prayer"
"1317","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ ، عَنْ مُحَمَّدِ بْنِ عَلِيٍّ , قَالَ :  آخِرُ صَلاةٍ صَلاهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي مِلْحَفَةٍ مُوَرَّسَةٍ مُتَوَشِّحًا بِهَا ""","","","","","Book of Prayer"
"1318","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنِ الْحُسَيْنِ بْنِ عَبْدِ اللَّهِ ابْنِ عُبَيْدِ اللَّهِ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  صَلَّى فِي كِسَاءٍ مُخَالِفٍ بَيْنَ طَرَفَيْهِ فِي يَوْمٍ بَارِدٍ يَتَّقِي بَالْكِسَاءِ خَصَرَ الأَرْضِ كَهَيْئَةِ الْحَافِزِ ""","","","","","Book of Prayer"
"1319","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبِي , عَنْ مُحَمَّدِ بْنِ مَسْحٍ أَخْبَرَهُ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي بَعْضِ أَسْفَارِهِ عَرَّسَ إِلَى مَاءٍ , فَجَاءَ مُعَاذُ بْنُ جَبَلٍ وَهُوَ مَاشٍ فَعَرَّسَ إِلَى ذَلِكَ الْمَاءِ , فَهَبَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : مَنْ ذَا ؟ , فَقَالَ : أَنَا مُعَاذٌ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : يَا مُعَاذُ ! مَا لَكَ بَعِيرٌ ؟ , قَالَ : لا ، قَالَ : فَتَوَضَّأَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ قَامَ فَصَلَّى , فَكَأَنَّهُ يَتَعَرَّ إِزَارَهُ , فَاتَّزَرَ فَصَلَّى فِي مُتَّزَرِهِ ، ثُمَّ قَالَ لِمُعَاذٍ : قُمْ فَارْحَلْ ، وَأَحْسِنِ الْحَقِيقَةَ ، وَاجْعَلْ لِنَفْسِكَ مِقْعَدًا , فَقَالَ : مَا أُحْسِنُ يَا رَسُولَ اللَّهِ ، فَقَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَرَحَلَ ، وَجَعَلَ لَهُ مَجْلِسًا وَأَرْدَفَهُ مَعَهُ","","","","","Book of Prayer"
"1320","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللَّهِ ، عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللَّهِ ، عَنْ أَبِيهِ ، عَنْ عَلِيِّ بْنِ أَبِي طَالِبٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  إِذَا كَانَ الثَّوْبُ وَاسِعًا فَصَلِّ فِيهِ مُتَوَشِّحًا ، وَإِذَا كَانَ صَغِيرًا فَصَلِّ فِيهِ مُتَّزِرًا ""","","","","","Book of Prayer"
"1321","عَنْ إِبْرَاهِيمَ ، عَنِ الزُّهْرِيِّ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، رَأَى رَجُلا يُصَلِّي فِي ثَوْبٍ وَاحِدٍ مُلْتَحِفًا بِهِ ، فَقَالَ :  لا تَشَبَّهَوَا بِالْيَهُودِ , إِذَا لَمْ يَجِدْ أَحَدُكُمْ إِلا ثَوْبًا وَاحِدًا , فَلْيَتَّزِرْهُ ""","","","","","Book of Prayer"
"1322","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ قَيْسِ بْنِ طَلْقٍ ، أَنَّ رَجُلا , قَالَ : يَا رَسُولَ اللَّهِ ! أُصَلِّي أَحْيَانًا فِي ثَوْبٍ وَاحِدٍ , فَقَالَ :  فَسَكَتَ عَنْهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَتَّى أُقِيمَتِ الصَّلاةُ , فَطَابَقَ بَيْنَ ثَوْبَيْهِ ، ثُمَّ صَلَّى فِيهِمَا "" , فَقَالَ أَبُو بَكْرٍ : فَحَدَّثْتُ بِهِ مَعْمَرًا ، فَقَالَ : قَدْ سَمِعْتُ يَحْيَى , يَذْكُرُهُ""","","","","","Book of Prayer"
"1323","أَخْبَرَنَا مَعْمَرٌ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ عِكْرِمَةَ ، عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِذَا صَلَّى أَحَدُكُمْ فِي ثَوْبٍ وَاحِدٍ , فَلْيُخَالِفْ بَيْنَ طَرَفَيْهِ عَلَى عَاتِقِهِ ""","","","","","Book of Prayer"
"1324","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ أَبِي الزِّنَادِ ، عَنِ الأعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  لا يُصَلِّيَنَّ أَحَدُكُمْ فِي الثَّوْبِ الْوَاحِدِ , لَيْسَ عَلَى عَاتِقِهِ مِنْهُ شَيْءٌ ""","","","","","Book of Prayer"
"1325","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي حَسَنُ بْنُ مُسْلِمٍ ، عَنْ رَجُلٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّهُ كَانَ يَقُولُ :  كَانَوَا يَقُولُونَ : إِذَا كَانَ الإِزَارُ صَغِيرًا لا يَسْتَطِيعُ أَنْ يُوَشِّحَهُ , فَلْيُصَلِّ بِمِئْزَرٍ ""","","","","","Book of Prayer"
"1326","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَطَاءً , يَقُولُ :  يُصَلِّي الْمَرْءُ فِي الثَّوْبِ ، وَإِنْ كَانَ ذَا سَعَةٍ وَلَكِنْ لِيَتَوَشَّحْ بِهِ ، وَأَحَبُ إِلَيَّ أَنْ يُصَلِّيَ فِي الرِّدَاءِ مَعَ الإِزَارِ ""","","","","","Book of Prayer"
"1327","ثُمَّ أَخْبَرَنَا خَبَرًا أَخْبَرَهُ إِيَّاهُ مُحَمَّدُ بْنُ عَلِيٍّ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، وَكَانَ مِنْ آخِرِ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَوْتًا , قَالَ : فَكُنَّا نَأْتِيهِ فِي بَيْتِهِ فَأَمَّنَا فِي بَيْتِهِ , فِي بَنِي سَلَمَةَ , وَنَحْنُ نَفَرٌ ، فَقَامَ فَأَمَّنَا ، وَإِنَّ مِشْجَبَهُ لَمَوْضُوعٌ عَلَيْهِ رِدَاؤُهُ , قَالَ : فَتَوَشَّحَ ثَوْبًا , قَالَ : مَا تَطْلُعُ عَلَى مَنْكِبَيْهِ ، قَالَ مُحَمَّدٌ : حَسِبْتُ أَنَّهُ , قَالَ :  نِسَاجَةً "" , قَالَ : فَمَا رَأَيْتُهُ إِلا يُرِينَا أَنَّ ذَلِكَ لا بَأْسَ بِهِ""","","","","","Book of Prayer"
"1328","قَالَ ابْنُ جُرَيْجٍ : قَالَ عَطَاءٌ : قَالَ جَابِرٌ :  أَنَا , وَأَبِي , وَخَالِي مِنْ أَصْحَابِ الْعَقَبَةِ ""","","","","","Book of Prayer"
"1329","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ , قَالَ : صَلَّى بِنَا جَابِرُ بْنُ عَبْدِ اللَّهِ  فِي ثَوْبٍ وَاحِدٍ "" , قَالَ : أَحْسَبُهُ قَالَ : "" اتَّزَرَ بِهِ ""","","","","","Book of Prayer"
"1330","عَنْ دَاوُدَ بْنِ قَيْسٍ ، عَنْ عُبَيْدِ اللَّهِ بْنِ مِقْسَمٍ , قَالَ : رَأَيْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ يُصَلِّي فِي ثَوْبٍ وَاحِدٍ , قَالَ : فَقُلْتُ :  أَتُصَلِّي فِي ثَوْبٍ وَاحِدٍ , وَالثِّيَابُ إِلَى جَنْبِكَ ؟ , قَالَ : نَعَمْ ، مِنْ أَجْلِ أَحْمَقَ مِثْلِكَ ""","","","","","Book of Prayer"
"1331","عَنْ مُحَمَّدِ بْنِ أَبِي حُمَيْدٍ , قَالَ : أَخْبَرَنِي ابْنُ الْمُنْكَدِرِ , قَالَ : رَأَيْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ  يُصَلِّي فِي ثَوْبٍ وَاحِدٍ مُخَالِفًا بَيْنَ طَرَفَيْهِ ""","","","","","Book of Prayer"
"1332","عَنْ أَبِيهِ ، عَنْ خَلادِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، أَنَّ ابْنَ عَبَّاسٍ  أَمَّهُمْ فِي ثَوْبٍ وَاحِدٍ مُخَالِفًا بَيْنَ طَرَفَيْهِ ""","","","","","Book of Prayer"
"1333","عَنِ الثَّوْرِيِّ ، عَنْ رَجُلٍ ، عَنْ مَسْعُودِ بْنِ حِرَاشٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ  أَمَّهُمْ فِي ثَوْبٍ وَاحِدٍ مُتَوَشِّحًا بِهِ ""","","","","","Book of Prayer"
"1334","عَنِ الثَّوْرِيِّ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنْ قَيْسِ بْنِ أَبِي حَازِمٍ ، أَمَّنَا خَالِدُ بْنُ الْوَلِيدِ فِي مُسَفَّرَةٍ مُتَوَشِّحًا بِهَا  . وَالْمُسَفَّرَةُ : الْمِلْحَفَةُ""","","","","","Book of Prayer"
"1335","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ , قَالَ : اخْتَلَفَ أُبَيُّ بْنُ كَعْبٍ ، وَابْنُ مَسْعُودٍ فِي الرَّجُلِ يُصَلِّي فِي الثَّوْبِ الْوَاحِدِ ، فَقَالَ أُبَيٌّ :  يُصَلِّي فِي الثَّوْبِ الْوَاحِدِ "" ، وَقَالَ ابْنُ مَسْعُودٍ : "" فِي ثَوْبَيْنِ "" فَبَلَغَ ذَلِكَ عُمَرَ , فَأَرْسَلَ إِلَيْهِمَا , فَقَالَ : "" اخْتَلَفْتُمَا فِي أَمْرٍ ، ثُمَّ تَفَرَّقْتُمَا فَلَمْ يَدْرِ النَّاسُ بِأَيِّ ذَلِكَ يَأْخُذُونَ لَوْ أَتَيْتُمَا لَوَجَدْتُمَا عِنْدِي عِلْمًا "" , "" الْقَوْلُ مَا قَالَ أُبَيٌّ ، وَلَمْ يَأْلُ ابْنُ مَسْعُودٍ ""","","","","","Book of Prayer"
"1336","عَنِ الْحَسَنِ ، أَنَّ أُبَيَّ بْنَ كَعْبٍ ، وَعَبْدَ اللَّهِ بْنَ مَسْعُودٍ , اخْتَلَفَا فِي الصَّلاةِ فِي الثَّوْبِ الْوَاحِدِ , فَقَالَ أُبَيٌّ :  لا بَأْسَ بِهِ ، قَدْ صَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي ثَوْبٍ وَاحِدٍ , فَالصَّلاةُ فِيهِ جَائِزَةٌ "" , وَقَالَ ابْنُ مَسْعُودٍ : "" إِنَّمَا كَانَ ذَلِكَ , إِذْ كَانَ النَّاسُ لا يَجِدُونَ الثِّيَابَ ، وَأَمَّا إِذْ وَجَدُوهَا فَالصَّلاةُ فِي ثَوْبَيْنِ "" ، فَقَامَ عُمَرُ عَلَى الْمِنْبَرِ , فَقَالَ : "" الْقَوْلُ مَا قَالَ أُبَيٌّ ، وَلَمْ يَأْلُ ابْنُ مَسْعُودٍ ""","","","","","Book of Prayer"
"1337","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : قَامَ رَجُلٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللَّهِ  أَيُصَلِّي الرَّجُلُ فِي الثَّوْبِ الْوَاحِدِ ؟ , قَالَ : "" أَوَ كُلُّكُمْ تَجِدُونَ ثَوْبَيْنِ ؟ ""","","","","","Book of Prayer"
"1338","حَتَّى إِذَا كَانَ فِي زَمَنِ عُمَرَ بْنِ الْخَطَّابِ , قَامَ إِلَيْهِ رَجُلٌ , فَقَالَ : أُصَلِّي الْعَصْرَ فِي ثَوْبٍ وَاحِدٍ ؟ فَقَالَ عُمَرُ :  إِذَا وَسَّعَ اللَّهُ عَلَيْكُمْ فَوَسِّعُوَا عَلَى أَنْفُسِكُمْ ، جَمَعَ الرَّجُلُ عَلَيْهِ ثِيَابَهُ يُصَلِّي الرَّجُلُ فِي إِزَارٍ وَرِدَاءٍ فِي قَمِيصٍ ، وَإِزَارٍ فِي إِزَارٍ ، وَقِبَاءٍ فِي سَرَاوِيلَ وَقِبَاءٍ , قَالَ : وَأَحْسَبُهُ قَالَ : فِي تُبَّانٍ , وَرِدَاءٍ فِي تُبَّانٍ ، وَقَمِيصٍ فِي تُبَّانٍ , وَقِبَاءٍ ""","","","","","Book of Prayer"
"1339","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  مَا أَدْنَى مَا أُصَلِّي فِيهِ مِنَ الثِّيَابِ صَلاةَ التَّطَوُّعِ ؟ , قَالَ : "" فِي ثَوْبٍ "" , قُلْتُ : مُتَوَشِّحًا ؟ , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"1340","عَنْ مَالِكٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ ، قَالَ فِي الْكِتَابِ الَّذِي كَتَبَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِعَمْرِو بْنِ حَزْمٍ :  لا يُصَلِّيَنَّ أَحَدُكُمْ فِي الثَّوْبِ الْوَاحِدِ , إِلا مُخَالِفًا بَيْنَ طَرَفَيْهِ ""","","","","","Book of Prayer"
"1341","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ , قَالَتْ : صَلَّى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي خَمِيصَةٍ ذَاتِ أَعْلامٍ ، فَلَمَّا قَضَى صَلاتَهُ , قَالَ :  اذْهَبُوَا بِهَذِهِ الْخَمِيصَةِ إِلَى أَبِي جَهْمِ بْنِ حُذَيْفَةَ ، وَأْتُونِي بِأَنْبِجَانِيَّةٍ ، فَإِنَّهَا أَلْهَتْنِي آنِفًا عَنْ صَلاتِي ""","","","","","Book of Prayer"
"1342","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ ، أَنَّ ابْنَ عُمَرَ , كَسَاهُ ثَوْبَيْنِ وَهُوَ غُلامٌ , قَالَ : فَدَخَلَ الْمَسْجِدَ , فَوَجَدَهُ يُصَلِّي مُتَوَشِّحًا بِهِ فِي ثَوْبٍ , فَقَالَ :  أَلَيْسَ لَكَ ثَوْبَانِ تَلْبَسُهُمَا ؟ "" فَقُلْتُ : بَلَى , فَقَالَ : "" أَرَأَيْتَ لَوْ أَنِّي أَرْسَلْتُكَ إِلَى وَرَاءِ الدَّارِ لَكُنْتَ لابِسَهُمَا ؟ "" , قَالَ : نَعَمْ , قَالَ : "" فَاللَّهُ أَحَقُّ أَنْ تَتَزَيَّنَ لَهُ أَمِ النَّاسُ ؟ "" , قَالَ نَافِعٌ : فَقُلْتُ : بَلِ اللَّهُ""","","","","","Book of Prayer"
"1343","فَأَخْبَرَهُ عَنْ رَسُولِ اللَّهِ أَوْ عَنْ عُمَرَ , قَدِ اسْتَيْقَنَ نَافِعٌ ، أَنَّهُ عَنْ أَحَدِهِمَا ، وَمَا أُرَاهُ إِلا عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ :  لا يَشْتَمِلُ أَحَدُكُمْ فِي الصَّلاةِ اشْتِمَالَ الْيَهُودِ لِيَتَوَشَّحْ بِهِ ، مَنْ كَانَ لَهُ ثَوْبَانِ فَلْيَتَّزِرْ ، ثُمَّ لِيُصَلِّ ""","","","","","Book of Prayer"
"1344","قَالَ لِي نَافِعٌ : وَكَانَ عَبْدُ اللَّهِ  لا يَرَى لأَحَدٍ أَنْ يُصَلِّيَ بِغَيْرِ إِزَارٍ وَسَرَاوِيلَ ، وَإِنْ كَانَتْ جُبَّةً وَرِدَاءً دُونَ إِزَارٍ وَسَرَاوِيلَ ""","","","","","Book of Prayer"
"1345","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ , قَالَ : رَآنِي ابْنُ عُمَرَ أُصَلِّي فِي ثَوْبٍ وَاحِدٍ , فَقَالَ :  أَلَمْ أَكْسِكَ ثَوْبَيْنِ ؟ "" , فَقُلْتُ : بَلَى , قَالَ : "" أَرَأَيْتَ لَوْ أَرْسَلْتُكَ إِلَى فُلانٍ , أَكُنْتَ ذَاهِبًا فِي هَذَا الثَّوْبِ ؟ "" , فَقُلْتُ : لا ، فَقَالَ : "" اللَّهُ أَحَقُّ مَنْ تَزَيَّنُ لَهُ أَوْ مَنْ تَزَيَّنْتَ لَهُ ""","","","","","Book of Prayer"
"1346","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَشْتَمِلُ فِي الثَّوْبِ ؟ , قَالَ :  لا , التَّوَشُّحُ أَسْتَرُ ، يَرُدُّ الْمَرْءُ إِزَارَهُ عَلَى فَرْجِهِ مَرَّتَيْنِ ، وَكَانَ يَكْرَهُ أَنْ يَأْتَزِرَ بِهِ , فَيُصَلِّيَ فِيهِ فَقَطْ إِذَا صَغُرَ "" , قُلْتُ : أَرَأَيْتَ لَوْ كَانَ رَجُلانِ عَلَيْهِمَا إِزَارٌ , وَعِنْدَهُمَا رِدَاءٌ وَاحِدٌ فَقَامَا يُصَلِّيَانِ , أَحَبُّ إِلَيْكَ أَنْ يَرْتَدِيَا ذَلِكَ الرِّدَاءَ عَلَيْهِمَا جَمِيعًا وَعَلَيْهِمَا إِزَارُهُمَا , أَوْ يَتَوَشَّحَانِ إِزَارَيْهِمَا وَيَدَعَانِ الرِّدَاءَ , قَالَ : بَلْ يُصَلِّيَانِ فِي إِزَارَيْهِمَا ، وَالرِّدَاءُ جَمِيعًا أَحَبُّ إِلَيَّ ""","","","","","Book of Prayer"
"1347","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ الأَحْوَصِ بْنِ الْحَكِيمِ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنْ عُبَادَةَ بْنِ صَامِتٍ : أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  صَلَّى فِي شَمْلَةٍ ، أَوْ بُرْدَةٍ عَقَدَهَا عَلَيْهِ ""","","","","","Book of Prayer"
"1348","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مِسْعَرٍ , قَالَ : كَانَ يَقُولُ :  إِذَا صَلَّى الرَّجُلُ فِي ثَوْبٍ مُثْنِيًا عَلَى الْفَرْجِ , فَلا بَأْسَ ""","","","","","Book of Prayer"
"1349","عَنْ مَعْمَرٍ , قَالَ : رَأَيْتُ ابْنَ طَاوُسٍ ، يُصَلِّي فِي جُبَّةٍ وَلَيْسَ عَلَيْهِ إِزَارٌ وَلا رِدَاءٌ فَسَأَلْتُهُ ، فَأَخْبَرَنِي أَنَّ أَبَاهُ ، كَانَ  لا يَرَى بَأْسًا أَنْ لا يُصَلِّيَ فِي جُبَّةٍ وَحْدَهَا ، وَالْقَمِيصِ وَحْدَهُ , إِذَا كَانَ لا يَصِفُهُ ""","","","","","Book of Prayer"
"1350","عَنِ ابْنِ جُرَيْجٍ , قَالَ : كَانَ طَاوُسٌ إِذَا سُئِلَ عَنِ الثَّوْبِ الْوَاحِدِ فِي الصَّلاةِ , فَقَالَ :  أَكُلُّ إِنْسَانٍ يَجِدُ ثَوْبَيْنِ ؟ "" , فَكَانَ يَقُولُ : "" يُصَلِّي الرَّجُلُ فِي الْجُبَّةِ وَحْدَهَا ، وَالْقَمِيصِ وَحْدَهُ إِذَا كَانَ كَثِيفًا ، وَإِذَا صَغُرَ الإِزَارُ فَلَمْ يَبْلُغْ أَنْ يَتَّشِحَهُ فَلْيَتَّزِرْهُ ""","","","","","Book of Prayer"
"1351","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  الْقَمِيصُ أُصَلِّي فِيهِ وَحْدَهُ ؟ , قَالَ : "" نَعَمْ ، إِذَا كَانَ كَثِيفًا "" , قَالَ : قُلْتُ : الْفَرْوُ أَصْلِيٌّ فِيهِ ؟ , قَالَ : "" نَعَمْ ، وَمَا بَأْسُهُ قَدْ دُبِغَ ""","","","","","Book of Prayer"
"1352","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ , قَالَ :  يُصَلِّي الرَّجُلُ فِي الْقَمِيصِ الْوَاحِدِ إِذَا كَانَ ضَيِّقًا , لا بَأْسَ بِهِ ""","","","","","Book of Prayer"
"1353","عَنِ ابْنِ التَّيْمِيِّ ، عَنِ الصَّبَّاحِ , قَالَ : دَخَلَ عَطَاءٌ , وَمُجَاهِدٌ عَلَى عَبْدِ الْحَمِيدِ بْنِ عَبْدِ اللَّهِ بْنِ عَمْرٍو فَسَأَلَهُمَا :  الرَّجُلُ يُصَلِّي فِي الْقَمِيصِ الْوَاحِدِ ؟ , فَقَالَ عَطَاءٌ : "" نَعَمْ "" ، وَقَالَ مُجَاهِدٌ : "" أَحَبُّ إِلَيَّ أَنْ يَشُدَّ عَلَى حَقْوَيْهِ شَيْئًا ""","","","","","Book of Prayer"
"1354","عَنْ إِسْرَائِيلَ ، عَنْ رَجُلٍ سَمَّاهُ ، وَعَنْ أَبِيهِ ، أَنَّ جَابِرَ بْنَ عَبْدِ اللَّهِ , أَمَّهُمْ فِي قَمِيصٍ لَيْسَ عَلَيْهِ إِزَارٌ وَلا رِدَاءٌ ، وَقَالَ جَابِرٌ : رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  يُصَلِّي فِي قَمِيصٍ ""","","","","","Book of Prayer"
"1355","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : سُئِلَ عَنِ الْقِبَاءِ وَأَنَا أَسْمَعُ : أَيُصَلِّي فِيهِ الْمَرْءُ وَحْدَهُ ؟ ,  الْقِبَاءُ مُفَرَّجٌ ، وَلَوْلا ذَلِكَ صَلَّى فِيهِ وَحْدَهُ , وَلَكِنْ لِيَتَّزِرْ عَلَيْهِ ، أَوْ تَحْتَهُ إِزَارٌ "" ، قُلْتُ لَهُ : أَفَيُصَلِّي الرَّجُلُ فِي السَّرَاوِيلِ وَحْدَهَا ؟ , فَقَالَ : "" لا ، إِلا أَنْ لا يَجِدَ غَيْرَهَا "" , وَفِي حَدِيثِ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ عَمْرٍو , فِي ذَلِكَ بَيَانٌ""","","","","","Book of Prayer"
"1356","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ  أُصَلِّي فِي ثَوْبٍ أُعِرْتُهُ , لا أَدْرِي أَطَاهِرٌ أَمْ لا ؟ , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"1357","عَنِ الثَّوْرِيِّ , قَالَ :  إِنِ اشْتَرَى رَجُلٌ مِنَ الْمُسْلِمِينَ ثَوْبًا مِنْ مُشْرِكٍ , أَوِ اسْتَعَارَهُ فَلْيُصَلِّ فِيهِ ، وَلا يَغْسِلُهُ , إِلا أَنْ يَعْرِفَ فِيهِ شَيْئًا ""","","","","","Book of Prayer"
"1358","سَمِعْتُ الثَّوْرِيَّ , يَقُولُ :  لا بَأْسَ أَنْ يُصَلِّيَ الرَّجُلُ فِي ثَوْبِ النَّصْرَانِيِّ , وَالْمَجُوسِيِّ , وَالْيَهُودِيِّ ، إِلا أَنْ يَعْلَمَ فِيهِ شَيْئًا ""","","","","","Book of Prayer"
"1359","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ :  كَانَوَا يَرَوْنَ السَّيْفَ رِدَاءً ""","","","","","Book of Prayer"
"1360","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي سَعِيدٍ ، قَالَ : سَمِعْتُ الْحَسَنَ , يَقُولُ :  الْقَوْسُ رِدَاءٌ ""","","","","","Book of Prayer"
"1361","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ إِبْرَاهِيمَ , قَالَ :  كَانَ الرَّجُلُ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا لَمْ يَجِدْ رِدَاءً يُصَلِّي فِيهِ طَرَحَ عَلَى كَتِفَيْهِ أَوْ قَالَ : عَلَى عَاتِقِهِ عِقَالا ""","","","","","Book of Prayer"
"1362","عَنِ ابْنِ جُرَيْجٍ , قَالَ : رَأَيْتُ عَطَاءً  يَسْدُلُ ثَوْبَهُ وَهُوَ فِي الصَّلاةِ ""","","","","","Book of Prayer"
"1363","عَنِ الثَّوْرِيِّ ، عَنْ ثَوْرٍ الْهَمْدَانِيِّ ، عَنْ عَطَاءٍ , أَنَّهُ كَانَ يَقُولُ :  لا بَأْسَ بِالسَّدْلِ ""","","","","","Book of Prayer"
"1364","عَنْ مَعْمَرٍ ، عَنْ إِبْرَاهِيمَ  كَرِهَ السَّدْلَ ""","","","","","Book of Prayer"
"1365","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ النَّخَعِيِّ  أَنَّهُ كَانَ يَسْدُلُ ""","","","","","Book of Prayer"
"1366","عَنْ هِشَامِ بْنِ حَسَّانَ , قَالَ : رَأَيْتُ الْحَسَنَ ، وَابْنَ سِيرِينَ  يَسْدُلانِ عَلَى قَمِيصِهِمَا "" , عَنْ مَعْمَرٍ ، عَمَّنْ رَأَى الْحَسَنَ ، وَابْنَ سِيرِينَ , يَفْعَلانِ ذَلِكَ""","","","","","Book of Prayer"
"1367","عَنِ الثَّوْرِيِّ ، عَنْ لَيْثٍ ، عَنْ مُجَاهِدٍ :  كَانَ يَكْرَهُ أَنْ يَلُفَّ الرَّجُلُ رِدَاءَهُ عَلَى مَنْكِبَيْهِ , قَالَ : يَنْشُرُهُ ""","","","","","Book of Prayer"
"1368","عَنْ أَبِي حَنِيفَةَ ، عَنْ عَلِيِّ بْنِ الأَقْمَرِ , قَالَ :  مَرَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِرَجُلٍ قَدْ سَدَلَ ثَوْبَهُ وَهُوَ يُصَلِّي فَعَطَفَ ثَوْبَهُ عَلَيْهِ "" , عَنِ الثَّوْرِيِّ ، عَنْ رَجُلٍ ، عَنْ أَبِي عَطِيَّةَ الْوَادِعِيِّ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ""","","","","","Book of Prayer"
"1369","عَنْ بِشْرِ بْنِ رَافِعٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي عُبَيْدَةَ بْنِ عَبْدِ اللَّهِ ، أَنَّ أَبَاهُ ،  كَرِهَ السَّدْلَ فِي الصَّلاةِ "" , قَالَ أَبُو عُبَيْدَةَ ، وَكَانَ أَبِي يَذْكُرُ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَنْهَى عَنْهُ""","","","","","Book of Prayer"
"1370","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ الْطَائِفِيِّ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ  أَنَّهُ كَرِهَ السَّدْلَ فِي الصَّلاةِ "" , قَالَ : وَلا أَعْلَمُهُ إِلا رَفَعَهُ , عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، عَنْهُمَا أَنَّهُمَا يَكْرَهَانَهُ ، مُجَاهِدٌ أَحْسَبُهُ قَالَ : وَطَاوُسٌ""","","","","","Book of Prayer"
"1371","عَنِ الثَّوْرِيِّ ، عَنْ لَيْثٍ ، عَنْ مُجَاهِدٍ  أَنَّهُ كَانَ يَكْرَهُ السَّدْلَ ""","","","","","Book of Prayer"
"1372","عَنْ أَبِي حَنِيفَةَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ  أَنَّهُ كَرِهَ السَّدْلَ , إِلا أَنْ يَمْسِكَ بِطَرَفَيْهِ "" , قَالَ عَبْدُ الرَّزَّاقِ : وَرَأَيْتُ الثَّوْرِيَّ إِذَا صَلَّى , ضَمَّ طَرَفَيِ الثَّوْبِ بِيَدِهِ إِلَى صَدْرِهِ""","","","","","Book of Prayer"
"1373","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ  أَنَّهُ كَرِهَ السَّدْلَ ""","","","","","Book of Prayer"
"1374","عَنِ الثَّوْرِيِّ ، عَنْ خَالِدٍ الْحَذَّاءِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَعِيدٍ ، عَنْ عَلِيِّ بْنِ أَبِي طَالِبٍ , قَالَ :  رَأَى قَوْمًا سَادِلِينَ , فَقَالَ : كَأَنَّهُمُ الْيَهُودُ خَرَجُوَا مِنْ فِهْرِهِمْ "" , قُلْنَا لِعَبْدِ الرَّزَّاقِ : مَا فِهْرُهُمْ ؟ , قَالَ : كَنَائِسُهُمْ""","","","","","Book of Prayer"
"1375","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , قَالَ : سَمِعْتُ مُجَاهِدًا , يَقُولُ :  إِذَا يَرْأَى الإِسْبَالَ وَهُوَ يُصَلِّي , فَلْيُرْخِ عَلَيْهِ رِدَاءَهُ "" , فَذَكَرْتُ ذَلِكَ لِطَاوُسٍ , فَقَالَ : ذَلِكَ خَيْرٌ وَأَحْسَنُ""","","","","","Book of Prayer"
"1376","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , قَالَ : رَأَيْتُ طَاوُسًا  يُصَلِّي وَقَدْ وَضَعَ رِدَاءَهُ تَحْتَ عَضُدِهِ ""","","","","","Book of Prayer"
"1377","عَنْ مَعْمَرٍ ، عَنْ أَبِي مَعْشَرٍ ، عَنْ إِبْرَاهِيمَ  أَنَّهُ كَانَ لا يَرَى بَأْسًا أَنْ يَسْدُلَ الرَّجُلُ إِذَا كَانَ عَلَيْهِ قَمِيصٌ ، فَأَمَّا إِذَا كَانَ عَلَيْهِ إِزَارٌ فَلا يَسْدُلُ ""","","","","","Book of Prayer"
"1378","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ , قَالَ : أَحْسَبُهُ عَامِرًا الأَحْوَلَ ، عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  أَنَّهُ كَانَ يَكْرَهُ السَّدْلَ وَيَرْفَعُ فِي ذَلِكَ حَدِيثًا ، ثُمَّ ذَكَرَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Prayer"
"1379","عَنْ مَالِكٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ  أَنَّهُ كَانَ يُصَلِّي فِي الثَّوْبِ الَّذِي يَعْرَقُ فِيهِ الْجُنُبُ ""","","","","","Book of Prayer"
"1380","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي سَعِيدٍ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : سُئِلَ ابْنُ عُمَرَ : أَيُصَلَّى فِي الثَّوْبِ الَّذِي يُجَامِعُ فِيهِ ؟ فَقَالَ ابْنُ عُمَرَ :  قَدْ جَامَعْتُ فِي ثَوْبِي الَّذِي عَلَيَّ الْبَارِحَةَ وَأَنَا أُصَلِّي فِيهِ ""","","","","","Book of Prayer"
"1381","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ :  لا بَأْسَ أَنْ يُصَلَّى فِي الثَّوْبِ الَّذِي يَعْرَقُ فِيهِ الْجُنُبُ ""","","","","","Book of Prayer"
"1382","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ , قَالَ : سَأَلْتُ عَائِشَةَ , عَنِ الرَّجُلِ يُصِيبُ الْمَرْأَةَ فِي الثَّوْبِ فَيَعْرَقُ فِيهِ , فَقَالَتْ :  قَدْ كَانَتِ الْمَرْأَةُ إِذَا كَانَ ذَلِكَ تَعُدُّ خِرْقَةً , أَوِ الْخِرَقَ فَتَمْسَحُ بِهِ ، وَيَمْسَحُ بِهِ الرَّجُلُ وَلَمْ يَرَ بِهِ بَأْسًا "" تَعْنِي : أَنْ يُصَلَّى فِيهِ""","","","","","Book of Prayer"
"1383","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنْ أُمِّ الْهُذَيْلِ ، أَنَّ عَائِشَةَ ، سُئِلَتَ عَنِ  الثَّوْبِ تَعْرَقُ فِيهِ الْحَائِضُ ؟ , فَقَالَتْ : لا بَأْسَ بِهِ "" تَعْنِي : أَنْ تُصَلِّيَ فِيهِ""","","","","","Book of Prayer"
"1384","عَنْ رَجُلٍ ، مِنْ قُرَيْشٍ ، عَنْ سَعِيدِ بْنِ أَبِي عَرُوبَةَ ، عَنْ قَتَادَةَ ، عَنْ مُعَاذَةَ الْعَدَوِيَّةِ ، عَنْ عَائِشَةَ : أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى أَنْ يُصَلَّى فِي شِعَارِ الْمَرْأَةِ , قَالَ : وَسَمِعْتُ هِشَامَ بْنَ عُرْوَةَ يُحَدِّثُ ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ , أَنَّهَا كَانَتْ تَكْرَهُ أَنْ يُصَلَّى فِيهِ","","","","","Book of Prayer"
"1385","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  الْمَرْءُ يُصِيبُ أَهْلَهُ ، ثُمَّ يَلْبَسُ ثَوْبَهُ ، ثُمَّ يَغْسِلُ فَرْجَهُ , فَلَعَلَّ ثَوْبَهُ أَنْ يُصِيبَهُ مِنَ الْمَنِيِّ شَيْءٌ ، ثُمَّ يَغْتَسِلُ لِلصَّلاةِ فَيُجَفِّفُ فِي ذَلِكَ الثَّوْبَ , قَالَ : لا بَأْسَ بِهِ ""","","","","","Book of Prayer"
"1386","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ ، أَنَّ رَجُلا قَالَ لابْنِ عَبَّاسٍ :  أَضَعُ الْمُصْحَفَ عَلَى فِرَاشِي ، أُجَامِعُ عَلَيْهِ ، وَأَحْتَلِمُ عَلَيْهِ ، وَأَعْرَقُ عَلَيْهِ ؟ "" , قَالَ : "" نَعَمْ ""","","","","","Book of Prayer"
"1387","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ  لَيْسَ عَلَى ثَوْبِ الْحَائِضِ وَالْجُنُبِ غُسْلٌ ، وَلا رَشٌّ ""","","","","","Book of Prayer"
"1388","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ عَطَاءٍ ، عَنِ ابْنِ عَبَّاسٍ ,  فِي الْمَنِيِّ يُصِيبُ الثَّوْبَ , فَقَالَ : إِنْ لَمْ تُقَذِّرْهُ , فَأَمِطْهُ بِإِذْخِرَةٍ ""","","","","","Book of Prayer"
"1389","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي يَعْنِي عَطَاءً سَقَطَ عَطَاءٌ مِنْ كِتَابِ ابْنِ الأَعْرَابِيِّ ، أَنَّهُ سَمِعَ ابْنَ عَبَّاسٍ , يَقُولُ :  إِذَا احْتَلَمْتَ فِي ثَوْبِكَ فَأَمِطْهُ بِإِذْخِرَةٍ أَوْ خِرْقَةٍ ، وَلا تَغْسِلْهُ إِنْ شِئْتَ , إِلا أَنْ تُقَذِّرَ أَوْ تَكْرَهَ أَنْ يُرَى فِي ثَوْبِكَ ""","","","","","Book of Prayer"
"1390","عَنِ الثَّوْرِيِّ ، وَابْنِ عُيَيْنَةَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ هَمَّامِ بْنِ الْحَارِثِ , قَالَ : أَرْسَلَتْ عَائِشَةُ إِلَى ضَيْفٍ لَهَا تَدْعُوهُ , فَقَالُوا لَهَا :  هُوَ يَغْسِلُ جَنَابَةً فِي ثَوْبِهِ ، فَقَالَتْ : "" وَلِمَ يَغْسِلُهُ ؟ لَقَدْ كُنْتُ أَفْرُكُهُ مِنْ ثَوْبِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Prayer"
"1391","عَنِ الثَّوْرِيِّ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ :  تُمِيطُ الْمَنِيَّ بِإِذْخِرَةٍ ، أَوْ حَجَرَ عَنْ ثَوْبِكَ ""","","","","","Book of Prayer"
"1392","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ طَلْحَةَ بْنِ عَبْدِ اللَّهِ بْنِ عَوْفٍ ابْنِ أَخِي عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ , قَالَ : أَنَا سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ :  إِذَا عَلِمْتَ أَنْ قَدِ احْتَلَمْتَ فِي ثَوْبِكَ ، وَلَمْ تَدْرِ أَيْنَ هُوَ ، فَاغْسِلِ الثَّوْبَ كُلَّهُ ، فَإِنْ لَمْ تَدْرِ أَصَابَهُ أَوْ لَمْ يُصِبْهُ فَانْضَحْهُ بِالْمَاءِ نَضْحًا "" , عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , مِثْلَهُ , عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , مِثْلَهُ , عَنْ مَعْمَرٍ ، عَنِ الْحَسَنِ , مِثْلَهُ , قَالَ الْحَسَنُ : "" فَإِنِ اسْتَيْقَنْتَ أَنَّهُ فِي نَاحِيَةٍ مِنَ الثَّوْبِ , غَسَلْتَ تِلْكَ النَّاحِيَةَ وَرَشَشْتَ النَّاحِيَةَ الأُخْرَى ""","","","","","Book of Prayer"
"1393","عَنِ ابْنِ جُرَيْجٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ يَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ، حَدَّثَهُ أَنَّهُ : اعْتَمَرَ مَعَ عُمَرَ بْنِ الْخَطَّابِ فِي رَكْبٍ فِيهِمْ عَمْرُو بْنُ الْعَاصِ ، وَأَنَّ عُمَرَ عَرَّسَ فِي بَعْضِ الطَّرِيقِ قَرِيبًا مِنَ الْمِيَاهِ ، فَاحْتَلَمَ فَاسْتَيْقَظَ ، وَقَدْ كَادَ أَنْ يُصْبِحَ فَرَكِبَ ، وَكَانَ الرَّفْعُ حَتَّى جَاءَ الْمَاءَ , فَجَلَسَ عَلَى الْمَاءِ يَغْسِلُ مَا رَأَى مِنَ الاحْتِلامِ , حَتَّى أَسْفَرَ ، فَقَالَ عَمْرٌو : أَصْبَحْتَ وَمَعَنَا ثِيَابٌ أَلْبَسُهَا وَدَعْ ثَوْبَكَ يُغْسَلُ ، فَقَالَ عُمَرُ :  وَا عَجَبًا لَكَ يَا عَمْرُو ! لَئِنْ كُنْتَ تَجِدُ الثِّيَابَ أَفَكُلُّ النَّاسِ يَجِدُونَ الثِّيَابَ ؟ فَوَاللَّهِ لَوْ فَعَلْتُ لَكَانَتْ سُنَّةً ، لا بَلْ أَغْسِلُ مَا رَأَيْتُ , وَأَنْضَحُ مَا لَمْ أَرَ ""","","","","","Book of Prayer"
"1394","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ يَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ، عَنْ أَبِيهِ ، أَنَّ عُمَرَ أَصَابَتْهُ جَنَابَةٌ وَهُوَ فِي سَفَرٍ ، فَلَمَّا أَصْبَحَ , قَالَ :  أَتَرَوْنَا نُدْرِكُ الْمَاءَ قَبْلَ طُلُوعِ الشَّمْسِ ؟ "" , قَالُوا : نَعَمْ ، فَأَسْرَعَ السَّيْرَ حَتَّى أَدْرَكَ , فَاغْتَسَلَ وَجَعَلَ يَغْسِلُ مَا رَأَى مِنَ الْجَنَابَةِ فِي ثَوْبِهِ ، فَقَالَ عَمْرُو بْنُ الْعَاصِ : لَوْ لَبِسْتُ ثَوْبًا غَيْرَ هَذَا , وَصَلَّيْتُ ؟ فَقَالَ لَهُ عُمَرُ : "" إِنْ وَجَدْتَ ثَوْبًا وَجَدَهُ كُلُّ إِنْسَانٍ أَنِّي لَوْ فَعَلْتُ لَكَانَتْ سُنَّةً , وَلَكِنِّي أَغْسِلُ مَا رَأَيْتُ ، وَأَنْضَحُ مَا لَمْ أَرَهْ ""","","","","","Book of Prayer"
"1395","عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ , قَالَ : حَدَّثَنِي مَنْ كَانَ مَعَ عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللَّهُ عَنْهُ فِي سَفَرٍ , وَلَيْسَ مَعَهُ مَاءٌ فَأَصَابَتْهُ جَنَابَةٌ , فَقَالَ  أَتَرَوْنَا لَوْ رَفَعْنَا نُدْرِكُ الْمَاءَ قَبْلَ طُلُوعِ الشَّمْسِ ؟ "" , فَاغْتَسَلَ عُمَرُ ، وَأَخَذَ يَغْسِلُ مَا أَصَابَ ثَوْبَهُ مِنَ الْجَنَابَةِ , فَقَالَ لَهُ عَمْرُو بْنُ الْعَاصِ أَوِ الْمُغِيرَةُ : يَا أَمِيرَ الْمُؤْمِنِينَ ! لَوْ صَلَّيْتَ فِي هَذَا الثَّوْبِ ؟ فَقَالَ : "" يَا ابْنَ عَمْرٍو أَوِ الْمُغِيرَةِ , أَتُرِيدُ أَنْ لا أُصَلِّيَ فِي ثَوْبٍ أَصَابَتْهُ جَنَابَةٌ ؟ "" , فَيُقَالُ : إِنَّ عُمَرَ لَمْ يُصَلِّ فِي ثَوْبٍ أَصَابَتْهُ جَنَابَةٌ ، لا بَلِ أَغْسِلُ مَا رَأَيْتُ ، وَأَرَشُّ مَا لَمْ أَرَ ""","","","","","Book of Prayer"
"1396","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ ، عَنْ يَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ، عَنْ أَبِيهِ ، أَنَّهُ اعْتَمَرَ مَعَ عُمَرَ بْنِ الْخَطَّابِ فِي رَكْبٍ فِيهِمْ عَمْرُو بْنُ الْعَاصِ , فَعَرَّسَ قَرِيبًا مِنْ بَعْضِ الْمِيَاهِ ، فَاحْتَلَمَ فَاسْتَيْقَظَ وَقَدْ أَصْبَحَ , فَلَمْ يَجِدْ فِي الرَّكْبِ مَاءً فَرَكِبَ ، وَكَانَ الرَّفْعُ حَتَّى جَاءَ الْمَاءَ , فَجَلَسَ عَلَى الْمَاءِ يَغْسِلُ مَا فِي ثَوْبِهِ مِنَ الاحْتِلامِ فَلَمَّا أَسْفَرَ ، قَالَ لَهُ عَمْرُو بْنُ الْعَاصِ : أَصْبَحْتَ دَعْ ثَوْبَكَ يُغْسَلُ ، وَالْبَسْ بَعْضَ ثِيَابِنَا , فَقَالَ :  وَا عَجَبًا لَكَ يَا عَمْرُو ! لَئِنْ كُنْتَ تَجِدُ الثِّيَابَ , أَفَكُلُّ الْمُسْلِمِينَ يَجِدُونَ الثِّيَابَ ؟ فَوَاللَّهِ لَوْ فَعَلْتُهَا لَكَانَتْ سُنَّةً ، بَلِ أَغْسِلُ مَا رَأَيْتُ ، وَأَنْضَحُ مَا لَمْ أَرَ ""","","","","","Book of Prayer"
"1397","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ :  إِذَا احْتَلَمْتَ فِي ثَوْبِكَ فَلَمْ تَعْلَمْ مَكَانَهُ , فَارْشُشْهُ بِالْمَاءِ ""","","","","","Book of Prayer"
"1398","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ :  لَيْسَ عَلَى الثَّوْبِ جَنَابَةٌ ""","","","","","Book of Prayer"
"1399","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ ، عَنْ سِمَاكِ بْنِ حَرْبٍ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ,  فِي الْمَنِيِّ يُصِيبُ الثَّوْبَ فَلا يُعْلَمُ مَكَانُهُ , قَالَ : يُنْضَحُ الثَّوْبُ ""","","","","","Book of Prayer"
"1400","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ :  الْقَيْحُ , وَالدَّمُ , وَالْبَوْلُ , وَالْمَذْيُ يُصِيبُ الثَّوْبَ سَوَاءٌ كُلُّهُ ، حُكَّهُ ، ثُمَّ ارْشُشْهُ بِالْمَاءِ ""","","","","","Book of Prayer"
"1401","عَنْ مَعْمَرٍ , قَالَ : قُلْتُ لِلزُّهْرِيِّ : الرَّجُلُ يَرَى فِي ثَوْبِهِ الدَّمَ الْقَلِيلَ أَوِ الْكَثِيرَ , فَقَالَ أَخْبَرَنِي سَالِمٌ ، أَنَّ ابْنَ عُمَرَ ،  كَانَ يَنْصَرِفُ لِقَلِيلِهِ وَكَثِيرِهِ ، ثُمَّ يَبْنِي عَلَى مَا قَدْ صَلَّى إِلا أَنْ يَتَكَلَّمَ فَيُعِيدُ ""","","","","","Book of Prayer"
"1402","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : هَلْ لِلثَّوْبِ مِنْ غُسْلٍ ؟ فَإِنَّكَ أَخْبَرْتَنِي ، عَنْ عَائِشَةَ  أَنَّهَا كَانَتْ تَحُكُّ الدَّمَ حَتَّى , قَالَ : فَحَسْبُهُ ذَلِكَ , قُلْتُ : فَالدَّمُ وَالْقَيْحُ وَكُلُّ شَيْءٍ عَلَى نَحْوِ ذَلِكَ , إِذَا حُكَّ فَحَسْبُهُ ؟ , قَالَ : "" نَعَمْ , حُكَّهُ ، ثُمَّ انْضَحْهُ وَحَسْبُكَ "" , قُلْتُ لَهُ : حَكَكْتُ الدَّمَ مِنْ ثَوْبِي فَغَلَبَنِي لا يَخْرُجُ , قَالَ : "" فَارْشُشْ عَلَيْهِ وَحَسْبُهُ ، وَإِنْ لَمْ تَغْسِلْهُ ""","","","","","Book of Prayer"
"1403","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلَ إِنْسَانٌ عَطَاءً , فَقَالَ :  فِي ظَهْرِي جِلْدٌ فِيهِ قُرُوحٌ قَدْ مَلأَ قَيْحُهَا ثِيَابِي ، وَعَنَانِي الْغُسْلُ ، فَقَالَ : "" أَمَا تَقْدِرُ أَنْ تَجْعَلَ عَلَيْهِ ذَرُورًا يُجِفُّهَا ؟ "" , قَالَ : لا , قَالَ : "" فَصَلِّ , وَلا تَغْسِلْ ثَوْبَكَ , فَاللَّهُ أَعْذَرَ بَالْعُذْرِ ""","","","","","Book of Prayer"
"1404","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ :  فِي الثَّوْبِ يُصِيبُهُ الدَّمُ , قَالَ : "" إِنْ كَانَ فَاحِشًا انْصَرَفَ ، وَإِنْ كَانَ قَلِيلا لَمْ يَنْصَرِفْ "" , قَالَ : وَكَانَ يَقُولُ : "" مَوْضِعُ الدِّرْهَمِ فَاحِشٌ ""","","","","","Book of Prayer"
"1405","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ , قَالَ :  لَمْ يَكُنْ يَرَى بِدَمِ الْبَرَاغِيثِ بَأْسًا "" , عَنْ هُشَيْمٍ ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ مِثْلَهُ""","","","","","Book of Prayer"
"1406","عَنِ الثَّوْرِيِّ ، عَنْ حُرَيْثٍ ، عَنِ الشَّعْبِيِّ  أَنَّهُ لَمْ يَرَ بِدَمِ الْبَرَاغِيثِ بَأْسًا ""","","","","","Book of Prayer"
"1407","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ  أَنَّهُ سُئِلَ عَنْ دَمِ الْبَرَاغِيثِ فِي الثَّوْبِ ؟ , فَقَالَ : لا بَأْسَ بِهِ ""","","","","","Book of Prayer"
"1408","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ  أَنَّهُ لَمْ يَرَ بِدَمِ الْبَرَاغِيثِ بَأْسًا "" , عَنْ هُشَيْمٍ ، عَنِ الْحَجَّاجِ بْنِ أَرْطَاةَ ، عَنْ أَبِي جَعْفَرٍ مُحَمَّدِ بْنِ عَلِيٍّ , مِثْلَهُ""","","","","","Book of Prayer"
"1409","عَنِ الثَّوْرِيِّ ، عَنِ الْعَلاءِ بْنِ الْمُسَيَّبِ ، عَنْ رَجُلٍ ، عَنْ إِبْرَاهِيمَ أَنَّهُ سُئِلَ عَنْ  دَمِ الْبَرَاغِيثِ فِي ثَوْبٍ ، فَقَالَ : اغْسِلْ مَا اسْتَطَعْتَ ""","","","","","Book of Prayer"
"1410","عَنْ مَعْمَرٍ ، عَنِ الْحَسَنِ ، وَقَتَادَةَ ، قالا :  الْقَيْحُ بِمَنْزِلَةِ الدَّمِ ""","","","","","Book of Prayer"
"1411","عَنْ نُعْمَانَ بْنِ أَبِي شَيْبَةَ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ،  أَنَّهُ كَانَ إِذَا صَلَّى فِي ثَوْبٍ وَفِيهِ دَمٌ , لَمْ يُعِدِ الصَّلاةَ ""","","","","","Book of Prayer"
"1412","عَنِ ابْنِ عُيَيْنَةَ ، وَغَيْرِهِ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : كَانَ عَلَى عَلْقَمَةَ بُرْدٌ أَوْ قَالَ : ثَوْبًا فِيهِ أَثَرُ دَمٍ قَدْ غُسِلَ ، فَلَمْ يَذْهَبْ وَكَانَ يُصَلِّي فِيهِ , فَقِيلَ لَهُ لَوْ وَضَعْتَهُ وَلَبِسْتَ غَيْرَهُ , فَقَالَ :  إِنَّ مِمَّا حُبِّبَ إِلَيَّ الصَّلاةُ فِيهِ إِنِّي أَرَى دَمَ مِعْضَدٍ فِيهِ "" , قَالَ : كُنَّا مُحَاصِرِينَ قَصْرًا بِأَذْرِبِيجَانَ , فَرُمِيَ بِحَجَرٍ فَأَصَابَهُ فَشَجَّهُ , وَسَالَ الدَّمُ عَلَى وَجْهِهِ , فَأَقْسَمْتُ عَلَيْهِ فَأَخَذَ بُرْدِي هَذَا فَاعْتَجَرَ بِهِ وَجَعَلَ يَمْسَحُ الدَّمَ , وَيَقُولُ : "" وَاللَّهِ إِنَّهَا لَصَغِيرَةٌ , وَإِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى يُبَارِكُ فِي الصَّغِيرَةِ "" , قَالَ : "" وَإِنَّ هَامَتَهُ فُلِقَتْ بَالسَّيْفِ "" , قَالَ : فَمَاتَ مِعْضَدٌ مِنْ جُرْحِهِ ذَلِكَ""","","","","","Book of Prayer"
"1413","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ  فِي الثَّوْبِ يُصِيبُهُ الدَّمُ قَالَ : "" إِنْ كَانَ فَاحِشًا انْصَرَفَ ، وَإِنْ كَانَ قَلِيلا لَمْ يَنْصَرِفْ "" , وَكَانَ يَقُولُ : "" مَوْضِعُ الدِّرْهَمِ فَاحِشٌ ""","","","","","Book of Prayer"
"1414","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ , قَالَ :  إِذَا كَانَ مَوْضِعُ الدِّرْهَمِ فِي ثَوْبِكَ , فَأَعِدِ الصَّلاةَ ""","","","","","Book of Prayer"
"1415","عَنْ مَعْمَرٍ ، عَنْ عَطَاءٍ الْخُرَاسَانِيِّ , قَالَ : قَالَ لِي عَطَاءٌ  لَقَدْ صَلَّيْتُ فِي ثَوْبِي هَذَا مِرَارًا فِيهِ دَمٌ فَنَسِيتُ أَنْ أَغْسِلَهُ ""","","","","","Book of Prayer"
"1416","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : رَأَيْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ  خَلَعَ قَمِيصَهُ فِي دَمٍ "" , فَنَسِيتُ أَنْ أَغْسِلَهُ رَأَى فِيهِ , قَالَ مَعْمَرٌ : وَكَانَ الْحَسَنُ "" يَنْصَرِفُ إِذَا رَأَى فِي ثَوْبِهِ الدَّمَ ""","","","","","Book of Prayer"
"1417","عَنِ الثَّوْرِيِّ ، عَنْ حُرَيْثٍ , قَالَ : سُئِلَ الشَّعْبِيُّ ، عَنْ  بَوْلِ الْخُفَّاشِ فِي الْمَسْجِدِ , فَلَمْ يَرَ بِهِ بَأْسًا ""","","","","","Book of Prayer"
"1418","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ إِسْرَائِيلَ بْنِ مُوسَى , قَالَ : كُنْتُ مَعَ ابْنِ سِيرِينَ فَسَقَطَ عَلَيْهِ بَوْلُ الْخُفَّاشِ فَنَضَحَهُ ، وَقَالَ :  مَا كُنْتُ أَرَى النَّضْحَ شَيْئًا حَتَّى بَلَغَنِي عَنْ سِتَّةٍ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Prayer"
"1419","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ حَمَّادًا  عَنْ خَرْءِ الدَّجَاجِ يُصِيبُ الثَّوْبَ ، فَقَالَ : إِذَا يَبِسَ فَلْيَفْرُكْهُ ""","","","","","Book of Prayer"
"1420","عَنْ أَبِي حَنِيفَةَ ، عَنْ حَمَّادٍ ، عَنْ مُجَاهِدٍ , قَالَ :  سُئِلَ عَنْ طِينِ الْمَطَرِ يُصِيبُ الثَّوْبَ , قَالَ : يُصَلِّي فِيهِ , فَإِذَا جَفَّ فَلْيَحُكَّهُ ""","","","","","Book of Prayer"
"1421","عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ :  لا بَأْسَ بَالرَّوْثِ يَكُونُ فِي النَّعْلَيْنِ ، ثُمَّ يُصَلِّي فِيهِمَا ""","","","","","Book of Prayer"
"1422","عَنْ مَعْمَرٍ , قَالَ :  سَأَلْتُ عَنْ رَجُلٍ وَطِئَ رَوْثًا رَطْبًا ، فَقَالَ : إِنْ شَاءَ مَسَحَ رِجْلَيْهِ بَالأَرْضِ ""","","","","","Book of Prayer"
"1423","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ :  سُئِلَ عَنِ الرَّجُلِ يَمْشِي خَلْفَ الإِبِلِ فَيُصِيبُهُ النَّضْحُ مِنْ أَبْوَالِهَا , قَالَ : يَنْضَحُ ""","","","","","Book of Prayer"
"1424","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ :  كَانَ لا يَرَى بِأَرْوَاثِ الدَّوَابِّ شَيْئًا "" , قَالَ مَعْمَرٌ : "" وَأَبْوَالُ الْبَقَرِ وَالْغَنَمِ بِمَنْزِلَةِ الإِبِلِ ""","","","","","Book of Prayer"
"1425","عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ :  لا بَأْسَ بِأَبْوَالِ الإِبِلِ كَانَ بَعْضُهُمْ يَسْتَنْشِقُ مِنْهَا "" , قَالَ : "" وَكَانَوَا لا يَرَوْنَ بَأْسًا بِالْبَقَرِ وَالْغَنَمِ ""","","","","","Book of Prayer"
"1426","عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ , قَالَ :  لا بَأْسَ بِأَبْوَالِ الْبَهَائِمِ , إِلا الْمُسْتَنْقَعَ ""","","","","","Book of Prayer"
"1427","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ :  مَا أَكَلْتَ لَحْمَهُ فَلا بَأْسَ بِبَوْلِهِ "" , عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، عَنْ عَطَاءٍ , مِثْلَهُ""","","","","","Book of Prayer"
"1428","عَنِ الثَّوْرِيِّ ، عَنْ أَبَانَ ، عَنْ أَنَسٍ , قَالَ :  لا بَأْسَ بِبَوْلِ ذَاتِ الْكَرِشِ ""","","","","","Book of Prayer"
"1429","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أَرَأَيْتَ مَا كُنْتَ آكِلَهُ , أَتَغْسِلُ ثَوْبَكَ مِنْ سَلْحِهِ أَوْ بَوْلِهِ ؟ , قَالَ : "" وَمَا ذَلِكَ ؟ "" , قُلْتُ : الإِبِلُ , قُلْتُ : وَالْبَقَرُ وَالشَّاءُ وَالصَّيْدُ وَالطَّيْرُ , قَالَ : "" لَمْ أَكُنْ لأَغْسِلَ ثَوْبِي مِنْ ذَلِكَ إِلا أَنْ أُقَذِّرَ رِيحَهُ , أَوْ يُرَى فِي ثَوْبِي "" , قُلْتُ : فَالْفَرَسُ , فَإِنَّهُ قَدْ كَانَ يُؤْكَلُ لَحْمُهُ , قَالَ : "" لَعَلِّي أَنْ أَغْسِلَ ثَوْبِي مِنْ رَوْثِهِ , أَوْ بَوْلِهِ وَمَا عَلَيَّ فِي ذَلِكَ لَوْ تَرَكْتُ مِنْ بَأْسٍ "" , قَالَ : "" امْسَحْهُ وَارْشُشْهُ ""","","","","","Book of Prayer"
"1430","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، عَنْ أُمِّ قَيْسِ بِنْتِ مِحْصَنٍ الأَسَدِيَّةِ أُخْتِ عُكَّاشَةَ ، قَالَتْ : جَاءَتْ بَابْنٍ لَهَا قَدْ أَعْلَقَتْ عَلَيْهِ تَخَافُ أَنْ يَكُونَ بِهِ الْعُذْرَةُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  عَلَى مَاذَا تَدْغَرُونَ أَوْلادَكُمْ بِهَذِهِ الْعِلَقِ ؟ عَلَيْكُمْ بِهَذَا الْعُودِ الْهِنْدِيِّ يَعْنِي الْكُسْتَ فَإِنَّ فِيهِ أَرْبَعَةَ أَشْفِيَةٍ ، مِنْهَا ذَاتُ الجُنُبِ "" , ثُمَّ أَخَذَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَبِيَّهَا ، فَوَضَعَهُ فِي حِجْرِهِ , فَبَالَ عَلَيْهِ فَدَعَا بِمَاءٍ فَنَضَحَهُ وَلَمْ يَكُنِ الصَّبِيُّ بَلَغَ أَنْ يَأْكُلَ الطَّعَامَ , قَالَ الزُّهْرِيُّ : فَيُسْتَسْعَطُ لِلْعُذْرَةِ ، وَيُلَدُّ مِنْ ذَاتِ الْجُنُبِ ، قَالَ الزُّهْرِيُّ : فَمَضَتِ السُّنَّةُ أَنْ يُرَشَّ بَوْلُ الصَّبِيِّ وَيُغْسَلُ بَوْلُ الْجَارِيَةِ""","","","","","Book of Prayer"
"1431","عَنِ ابْنِ جُرَيْجٍ ، وَابْنِ عُيَيْنَةَ ، عَنِ ابْنِ شِهَابٍ , قَالَ : أَخْبَرَنِي عُبَيْدُ اللَّهِ بْنُ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، أَنَّ أُمَّ قَيْسِ بِنْتَ مِحْصَنٍ ، كَانَتْ مِنَ الْمُهَاجِرَاتِ الأُوَلِ اللاتِي بَايَعْنَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : فَأَخْبَرَتْنِي أَنَّهَا أَتَتِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَابْنٍ لَهَا , لَمْ يَبْلُغْ أَنْ يَأْكُلَ الطَّعَامَ , وَقَدْ أَعْلَقَتْ عَلَيْهِ مِنَ الْعُذْرَةِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  عَلَى مَا تَدْغَرْنَ أَوْلادَكُمْ بِهَذِهِ الْعَلائِقِ ؟ ، عَلَيْكُمْ بِهَذَا الْعُودِ الْهِنْدِيِّ يَعْنِي الْكُسْتَ , فَإِنَّ فِيهِ سَبْعَةَ أَشْفِيَةٍ ، مِنْهَا ذَاتُ الْجُنُبِ ""","","","","","Book of Prayer"
"1432","قَالَ عُبَيْدُ اللَّهِ : فَأَخْبَرَتْنِي أُمُّ قَيْسٍ , أَنَّ ابْنَهَا ذَلِكَ بَالَ فِي حِجْرِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  فَدَعَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمَاءٍ فَصَبَّهُ عَلَى بَوْلِهِ , وَلَمْ يَغْسِلْهُ فَمَضَتِ السُّنَّةُ بِذَلِكَ مِنَ النَّضْحِ عَلَى بَوْلِ مَنْ لَمْ يَأْكُلْ مِنَ الْغِلْمَانِ ، وَيُغْسَلُ بَوْلُ مَنْ أَكَلَ مِنْهُمْ ""","","","","","Book of Prayer"
"1433","عَنِ الثَّوْرِيِّ ، عَنْ سِمَاكِ بْنِ حَرْبٍ ، عَنْ قَابُوسَ بْنِ الْمُخَارِقِ ، يَرْفَعُهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يُغْسَلُ بَوْلُ الْجَارِيَةِ ، وَيُنْضَحُ بَوْلُ الصَّبِيِّ "" , قَالَ سُفْيَانُ : "" وَنَحْنُ نَقُولُ : مَا لَمْ يَطْعَمِ الطَّعَامَ ""","","","","","Book of Prayer"
"1434","عَنْ عُثْمَانَ بْنِ مَطَرٍ ، عَنْ سَعِيدِ بْنِ أَبِي عَرُوبَةَ ، عَنْ قَتَادَةَ ، عَنْ أَبِي حَرْبِ بْنِ أَبِي الأَسْوَدِ الدِّيلِيِّ ، عَنْ عَلِيِّ بْنِ أَبِي طَالِبٍ , قَالَ :  يُغْسَلُ بَوْلُ الْجَارِيَةِ , وَيُنْضَحُ بَوْلُ الْغُلامِ مَا لَمْ يَطْعَمْ ""","","","","","Book of Prayer"
"1435","عَنِ الثَّوْرِيِّ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ عَائِشَةَ , قَالَتْ :  أُتِيَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , بِصَبِيٍّ فَبَالَ عَلَيْهِ فَصَبَّ عَلَيْهِ الْمَاءَ ""","","","","","Book of Prayer"
"1436","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ دَاوُدَ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ  فِي بَوْلِ الصَّبِيِّ , قَالَ : يُصَبُّ عَلَيْهِ مِثْلُهُ مِنَ الْمَاءِ "" , قَالَ : كَذَلِكَ صَنَعَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِبَوْلِ الْحُسَيْنِ بْنِ عَلِيٍّ ""","","","","","Book of Prayer"
"1437","عَنْ حُسَيْنِ بْنِ مِهْرَانَ الْكُوفِيِّ , قَالَ : أَخْبَرَنِي لَيْثُ بْنُ أَبِي سُلَيْمٍ ، قَالَ : حَدَّثَنِي الْحُدَيْبُ مَوْلًى لِزَيْنَبَ بِنْتِ جَحْشٍ ، عَنْ زَيْنَبَ بِنْتِ جَحْشٍ , قَالَتْ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَائِمًا فِي بَيْتِي , فَجَاءَ حُسَيْنُ بْنُ عَلِيٍّ يُدْرِجُ فَخَشِيتُ أَنْ يُوقِظَهُ فَعَلَّلْتُهُ بِشَيْءٍ , قَالَتْ : ثُمَّ غَفَلْتُ عَنْهُ , فَقَعَدَ عَلَى بَطْنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَوَضَعَ طَرَفَ ذَكَرِهِ فِي سُرَّةِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَبَالَ فِيهَا , قَالَتْ : فَفَزِعْتُ لِذَلِكَ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  هَاتِي مَاءً فَصُبِّهِ عَلَيْهِ "" , ثُمَّ قَالَ : "" يُنْضَحُ بَوْلُ الْغُلامِ ، وَيُغْسَلُ بَوْلُ الْجَارِيَةِ ""","","","","","Book of Prayer"
"1438","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  الصَّبِيُّ مَا لَمْ يَأْكُلِ الطَّعَامَ ، أَتَغْسِلُ بَوْلَهُ أَوْ سَلْحَةً مِنْ ثَوْبِكَ ؟ قَالَ : "" لا , أَرُشُّ عَلَيْهِ , أَوْ أَصْبُبُ عَلَيْهِ ؟ "" , قُلْتُ : الصَّبِيُّ يَلْعَقُ قَبْلَ أَنْ يَأْكُلَ الطَّعَامَ بِالسَّمْنِ وَالْعَسَلِ وَذَلِكَ طَعَامُهُ , قَالَ : "" ارْشُشْ , أَوِ اصْبُبْ ""","","","","","Book of Prayer"
"1439","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : هَمَّ عُمَرُ بْنُ الْخَطَّابِ  أَنْ يَنْهَى عَنِ الْحِبَرَةِ مِنْ صِبَاغِ الْبَوْلِ "" , فَقَالَ لَهُ رَجُلٌ : أَلَيْسَ قَدْ رَأَيْتَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَدْ لَبِسَهَا ؟ قَالَ عُمَرُ : "" بَلَى "" ، قَالَ الرَّجُلُ : أَلَمْ يَقُلِ اللَّهُ :  لَقَدْ كَانَ لَكُمْ فِي رَسُولِ اللَّهِ أُسْوَةٌ , فَتَرَكَهَا عُمَرُ""","","","","","Book of Prayer"
"1440","عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : هَمَّ عُمَرُ  أَنْ يَنْهَى عَنْ ثِيَابِ حِبَرَةَ لِصَبْغِ الْبَوْلِ "" ، ثُمَّ قَالَ : "" كُنَّا نُهِينَا عَنِ التَّعَمُّقِ ""","","","","","Book of Prayer"
"1441","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ , قَالَ : قَالَ عُمَرُ  لَوْ نُهِينَا عَنْ هَذَا الْعَصَبِ , فَإِنَّهُ يُصْبَغُ بِالْبَوْلِ "" ، فَقَالَ أُبَيُّ بْنُ كَعْبٍ : وَاللَّهِ مَا ذَلِكَ لِكَ ؟ , قَالَ : مَا ؟ , قَالَ : "" إِنَّا لَبِسْنَاهَا عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَالْقُرْآنُ يَنْزِلُ ، وَكُفِّنَ فِيهِ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ "" فَقَالَ عُمَرُ : صَدَقْتَ""","","","","","Book of Prayer"
"1442","عَنْ مَعْمَرٍ , قَالَ : رَأَيْتُ الزُّهْرِيَّ  يَلْبَسُ مَا صُبِغَ بِالْبَوْلِ ""","","","","","Book of Prayer"
"1443","عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ كَانَ  يَصْطَنِعُ الْحُلَلَ لأَصْحَابِ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , تَبْلُغُ الْحُلَّةُ السَّبْعَ مِائَةٍ إِلَى أَلْفِ دِرْهَمٍ ""","","","","","Book of Prayer"
"1444","أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ ، أَوْ عُمَرَ كَانَ  يَنْهَى أَنْ يُصْبَغَ بِالْبَوْلِ "" , قَالَ : وَكَانَ عُمَرُ : "" يَسْتَنْسِجُ بِحُلَلٍ لأَصْحَابِ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَبَلَغَتِ الْحُلَّةُ أَلْفَ دِرْهَمٍ أَوْ أَكْثَرَ مِنْ ذَلِكَ ""","","","","","Book of Prayer"
"1445","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ  كَانَ يَنْهَى أَنْ يُصْبَغَ بِالْبَوْلِ ، وَكَانَ يَسْتَنْسِجُ لأَصْحَابِ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَبَلَغَتِ الْحُلَّةُ مِنْهَا أَلْفَ دِرْهَمٍ أَوْ أَكْثَرَ مِنْ ذَلِكَ ""","","","","","Book of Prayer"
"1446","عَنْ مَعْمَرٍ ، عَنْ سَعِيدٍ الْجُرَيْرِيِّ ، عَنْ أَبِي الْعَلاءِ بْنِ عَبْدِ اللَّهِ بْنِ الشِّخِّيرِ ، عَنْ أَبِيهِ , قَالَ : رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  يُصَلِّي فِي نَعْلَيْهِ ""","","","","","Book of Prayer"
"1447","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَيُصَلِّي فِي النَّعْلَيْنِ الرَّجُلُ ؟ قَالَ نَعَمْ ، قَدْ بَلَغَنِي ذَلِكَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَنَّهُ  صَلَّى فِيهِمَا وَمَا بَأْسُهُمَا ، وَفِي الْخُفَّيْنِ أَيْضًا ""","","","","","Book of Prayer"
"1448","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ، عَنْ أَبِي هُرَيْرَةَ , قَالَ : وَرَبِّ هَذِهِ الْبِنْيَةِ , لَقَدْ رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  يَدْخُلُ الْمَسْجِدَ ، وَنَعْلاهُ فِي رِجْلَيْهِ ، وَهُوَ يُصَلِّي كَذَلِكَ ، ثُمَّ يَخْرُجُ مِنَ الْمَسْجِدِ ، وَهُوَ كَذَلِكَ مَا خَلَعَهُمَا ""","","","","","Book of Prayer"
"1449","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ، عَنْ رَجُلٍ , قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ : رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  يُصَلِّي مُتَنَعِّلا ، وَحَافِيًا ، وَرَأَيْتُهُ يَنْفَتِلُ عَنْ يَمِينِهِ وَشِمَالِهِ ""","","","","","Book of Prayer"
"1450","عَنِ ابْنِ التَّيْمِيِّ ، قَالَ : حَدَّثَنَا عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ , قَالَ : حَدَّثَنِي أَبُو الأَوْبَرِ ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ ! وَقَالَ لَهُ رَجُلٌ : يَا أَبَا هُرَيْرَةَ ، أَنْتَ نَهَيْتَ النَّاسَ أَنْ يَصُوَمُوا يَوْمَ الْجُمُعَةِ ؟ , فَقَالَ : لا لَعَمْرُكَ , مَا أَنَا نَهَيْتُ النَّاسَ أَنْ يَصُوَمُوا يَوْمَ الْجُمُعَةِ غَيْرَ أَنِّي وَرَبِّ هَذِهِ الْحُرْمَةِ ، قَالَهَا ثَلاثًا , لَقَدْ سَمِعْتُ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  لا يَخُصَّنَّ أَحَدُكُمْ يَوْمَ الْجُمُعَةِ بِصَوْمٍ إِلا أَنْ يَصُوَمُوا أيَّامًا أُخَرَ ""","","","","","Book of Prayer"
"1451","قَالَ : فَلَمْ أَبْرَحْ مَعَهُ حَتَّى جَاءَهُ آخَرُ ، فَقَالَ : يَا أَبَا هُرَيْرَةَ ! أَنْتَ نَهَيْتَ النَّاسَ أَنْ يُصَلُّوا فِي نِعَالِهِمْ ؟ , فَقَالَ : لا , لَعَمْرُ اللَّهِ ! مَا نَهَيْتُ النَّاسَ أَنْ يُصَلُّوا فِي نِعَالِهِمْ , غَيْرَ أَنِّي وَرَبِّ هَذِهِ الْحُرْمَةِ , حَتَّى قَالَهَا : ثَلاثًا ، لَقَدْ رَأَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، هَهُنَا عِنْدَ الْمَقَامِ  يُصَلِّي وَعَلَيْهِ نَعْلاهُ ، ثُمَّ انْصَرَفَ وَهُمَا عَلَيْهِ ""","","","","","Book of Prayer"
"1452","عَنِ الثَّوْرِيِّ ، عَنِ السُّدِّيِّ ، قَالَ : أَخْبَرَنِي مَنْ ، سَمِعَ عَمْرَو بْنَ حُرَيْثٍ , يَقُولُ : رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  يُصَلِّي فِي نَعْلَيْنِ مَخْصُوفَتَيْنِ ""","","","","","Book of Prayer"
"1453","ابْنُ يَزِيدَ قَالَ : حَدَّثَنِي مُحَمَّدُ بْنُ عَبَّادِ بْنِ جَعْفَرٍ ، عَنْ شَيْخٍ مِنْهُمْ , قَالَ : رَأَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  يُصَلِّي فِي نَعْلَيْهِ ، وَأَشَارَ إِلَى الْمَقَامِ ""","","","","","Book of Prayer"
"1454","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ أَبِي الأَحْوَصِ ، عَنِ ابْنِ مَسْعُودٍ ، أَنَّ أَبَا مُوسَى  أَمَّهُمْ فَخَلَعَ نَعْلَيْهِ ، فَقَالَ لَهُ عَبْدُ اللَّهِ "" لِمَ خَلَعْتَ نَعْلَيْكَ ؟ أَبِالْوَادِي الْمُقَدَّسِ أَنْتَ ؟ ""","","","","","Book of Prayer"
"1455","عَنْ هُشَيْمٍ , قَالَ : أَخْبَرَنِي أَبُو حَمْزَةَ مَوْلَى بَنِي أَسَدٍ , قَالَ : رَأَيْتُ ابْنَ عَبَّاسٍ  يُصَلِّي فِي نَعْلَيْهِ ""","","","","","Book of Prayer"
"1456","عَنِ ابْنِ مُجَاهِدٍ ، عَنْ أَبِيهِ ،  أَنَّهُ كَانَ يُصَلِّي فِي نَعْلَيْهِ ""","","","","","Book of Prayer"
"1457","عَنِ الثَّوْرِيِّ ، عَنْ رَجُلٍ مِنَ النَّخْعِ ، أَنَّ إِبْرَاهِيمَ  كَانَ إِذَا أُقِيمَتِ الصَّلاةُ لَبِسَ نَعْلَيْهِ , فَيُصَلِّي فِيهِمَا ""","","","","","Book of Prayer"
"1458","عَنْ دَاوُدَ بْنِ إِبْرَاهِيمَ ، قَالَ : رَأَيْتُ وَهْبَ بْنَ مُنَبِّهٍ  يُصَلِّي فِي نَعْلَيْهِ ""","","","","","Book of Prayer"
"1459","عَنْ مُقَاتِلٍ , قَالَ : أَخْبَرَنَا عَمْرُو بْنُ شُعَيْبٍ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو , قَالَ : رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  يُصَلِّي حَافِيًا ، وَمُتَنَعِّلا ""","","","","","Book of Prayer"
"1460","عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ ، عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ : أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , صَلَّى بِالنَّاسِ فَخَلَعَ نَعْلَيْهِ ، فَخَلَعَ النَّاسُ نِعَالَهُمْ فَلَمَّا انْصَرَفَ , قَالَ :  مَا شَأْنُكُمْ ؟ "" , فَقَالُوا : لَقَدْ رَأَيْنَاكَ خَلَعْتَ فَخَلَعْنَا ، فَقَالَ : "" مَنْ شَاءَ فَلْيُصَلِّ فِي نَعْلَيْهِ ، وَمَنْ شَاءَ فَلْيَخْلَعْهُمَا ""","","","","","Book of Prayer"
"1461","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : حُدِّثْتُ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى فِي نَعْلَيْهِ ، ثُمَّ خَلَعَهُمَا فَوَضَعَهُمَا عَلَى يَسَارِهِ , فَلَمَّا انْصَرَفَ , قَالَ :  لِمَ خَلَعْتُمْ نِعَالَكُمْ ؟ "" , فَقَالُوا : رَأَيْنَاكَ خَلَعْتَ نَعْلَيْكَ , فَخَلَعْنَا نِعَالَنَا , قَالَ : "" إِنَّمَا خَلَعْتُهُمَا أَنَّ جِبْرَائِيلَ جَاءَنِي ، فَقَالَ : إِنَّ فِيهَا خَبَثًا , فَإِذَا جِئْتُمْ أَبْوَابَ الْمَسْجِدِ أَوِ الْمَسَاجِدَ فَتَعَاهَدُوهَا , فَإِنْ كَانَ بِهَا خَبَثٌ فَحُكُّوهَا ، ثُمَّ ادْخُلُوا فَصَلُّوا فِي نِعَالِكُمْ ""","","","","","Book of Prayer"
"1462","عَنْ يَحْيَى بْنِ الْعَلاءِ ، عَنْ طَلْحَةَ ، عَنْ عَطَاءٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  تَعَاهَدُوا نِعَالَكُمْ عِنْدَ أَبْوَابِ الْمَسْجِدِ ""","","","","","Book of Prayer"
"1463","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ رَجُلٍ حَدَّثَهُ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : بَيْنَا هُوَ يُصَلِّي يَوْمًا خَلَعَ نَعْلَيْهِ , فَخَلَعَ النَّاسُ نِعَالَهُمْ فَلَمَّا انْصَرَفَ , قَالَ :  مَا شَأْنُكُمْ خَلَعْتُمْ نِعَالَكُمْ ؟ "" , قَالُوا : رَأَيْنَاكَ خَلَعْتَ , فَخَلَعْنَا ، فَقَالَ : "" إِنَّ جَبْرَئِيلَ أَتَانِي , فَأَخْبَرَنِي أَنَّ بِهِمَا قَذَرًا ، فَإِذَا جَاءَ أَحَدُكُمُ الْمَسْجِدِ فَلْيَنْظُرْ نَعْلَيْهِ ، فَإِنْ كَانَ بِهِمَا قَذَرٌ فَلْيَدْلُكْهُمَا بِالأَرْضِ "" , عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ : عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مِثْلَ ذَلِكَ""","","","","","Book of Prayer"
"1464","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، أَوْ غَيْرِهِ , قَالَ : قَالَ عَبْدُ اللَّهِ بْنُ السَّائِبِ :  صَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمَ الْفَتْحِ فَخَلَعَ نَعْلَيْهِ , فَخَلَعَهُمَا ، عَنْ يَسَارِهِ ""","","","","","Book of Prayer"
"1465","عَنْ عَبْدِ اللَّهِ بْنِ زِيَادِ بْنِ سَمْعَانَ ، قَالَ : أَخْبَرَنِي سَعِيدُ بْنُ أَبِي سَعِيدٍ الْمَقْبُرِيِّ ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِذَا صَلَّى أَحَدُكُمْ فِي نَعْلَيْهِ فَأَرَادَ أَنْ يَخْلَعَهُمَا فَلْيَخْلَعْهُمَا بَيْنَ رِجْلَيْهِ ، وَلا يَضَعُهُمَا إِلَى جَنْبِهِ يُؤْذِي بِهِمَا أَحَدًا ""","","","","","Book of Prayer"
"1466","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، أَنَّ ابْنَ مُنَبِّهٍ ، قَالَ لَهُ :  لِمَ تَضَعُ نَعْلَيْكَ عَلَى يَسَارِكَ ، وَتُؤْذِي بِهِمَا صَاحِبَكَ ؟ فَسَمِعَ ذَلِكَ أَبُوهُ , فَقَالَ : أَجَلْ , ضَعْهُمَا بَيْنَ رِجْلَيْكَ , فَكَانَ ابْنُ طَاوُسٍ "" لا يَضَعُهُمَا أَبَدًا إِلا بَيْنَ رِجْلَيْهِ ""","","","","","Book of Prayer"
"1467","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ  يَكْرَهُ أَنْ يَطَّلِعَ مِنْ نَعْلَيْهِ شَيْئًا مِنْ قَدَمَيْهِ ""","","","","","Book of Prayer"
"1468","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، أَنَّهُ كَانَ  يَنْظُرُ نَعْلَيْهِ إِذَا جَاءَ بَابَ الْمَسْجِدِ أَبِهِمَا قَشْبٌ ؟ ""","","","","","Book of Prayer"
"1469","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْنَا لِعَطَاءٍ :  يُصَلِّي فِي الْمَضْرِبَةِ الَّتِي يَرْمِي الإِنْسَانُ ، وَهِيَ عَلَيْهِ ، وَالْحِلَقِ ؟ , قَالَ : "" يَنْزَعْهُمَا "" ، قُلْنَا : إِنَّ فِي ذَلِكَ عَنَاءٌ فِي رَبْطِ الْمَضْرِبَةِ , قَالَ : "" وَلَوْ إِنَّمَا هِيَ الْمَكْتُوَبَةُ ، وَإِنْ صَلَّى فِيهِمَا فَلا حَرَجَ ، وَأَحَبُّ إِلَيَّ أَنْ لا يَفْعَلَ "" , قَالَ : قُلْتُ لَهُ : مَا الْمَضْرِبَةُ ؟ , قَالَ : "" هِيَ النَّدْوَةُ "" ، قُلْنَا : فَالْحِلَقُ ؟ , قَالَ : "" الأَصَابِعُ الَّتِي تَكُونُ فِي الأَصَابِعِ إِذَا رُمِيَتْ ""","","","","","Book of Prayer"
"1470","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أُصَلِّي وَفِي حُجْزَتِي غَزْلٌ ؟ , قَالَ : "" نَعَمْ ، إِنَّمَا هِيَ مِثْلُ ثَوْبِكَ "" ، قُلْتُ : فَسِوَاهُ ، فَعُودٌ فَصُحُفٌ فِيهَا كُتُبُ حَقٍّ ؟ , قَالَ : "" نَعَمْ ، وَأَحَبُّ إِلَيَّ أَنْ يَضَعَهُ فِي الأَرْضِ ""","","","","","Book of Prayer"
"1471","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أُصَلِّي وَفِي حُجْزَتِي ذَهَبٌ أَوْ وَرِقٌ ؟ , قَالَ : "" لا ، اجْعَلْهُمَا فِي الأَرْضِ ، وَإِنْ كَانَتْ فِي صُوانٍ "" ، قُلْتُ : إِنَّهَا مَنْثُورَةٌ فِي حُجْزَتِي , قَالَ : "" اصْبُبْهَا عَلَى نَعْلَيْكَ "" ، قُلْتُ : فَمَا شَأْنُ الذَّهَبِ ، وَالْوَرِقِ مِنْ بَيْنِ ذَلِكَ ؟ , قَالَ : "" لأَنَّ لَهُمَا هَيْئَةٌ لَيْسَتْ لِذَلِكَ ""","","","","","Book of Prayer"
"1472","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  السُّيُوفُ الْمُحَلاةُ أُصَلِّي فِيهَا ؟ , قَالَ : "" أَكْرَهُهَا بِمَكَّةَ ، وَأَمَّا بِغَيْرِهَا فَلا أَكْرَهُ أَنْ يُصَلِّيَ فِيهَا "" ، قُلْتُ : وَإِنْ لَمْ يَكُنْ فِي مَخَافَةٍ ؟ , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"1473","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أُصَلِّي عَلَى الصَّفَا وَأَنَا أَجِدُ إِنْ شِئْتُ بَطْحَاءَ قَرِيبًا مِنِّي ؟ , قَالَ : "" لا "" ، قُلْتُ : أَفَتُجْزِئُ عَنِّي مِنَ الْبَطْحَاءِ أَرْضٌ لَيْسَ فِيهَا بَطْحَاءُ مِدْرَاةٌ فِيهَا تُرَابٌ ، وَأَنَا أَجِدُ إِنْ شِئْتُ بَطْحَاءَ قَرِيبًا مِنِّي , قَالَ : إِنْ كَانَ التُّرَابُ فَحَسْبُكَ ""","","","","","Book of Prayer"
"1474","عَنْ مَعْمَرٍ ، عَنْ خَالِدٍ الْحَذَّاءِ , قَالَ : رَأَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صُهَيْبًا يَسْجُدُ كَأَنَّهُ يَتَّقِي التُّرَابَ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : تَرِّبْ وَجْهَكَ يَا صُهَيْبُ","","","","","Book of Prayer"
"1475","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أُصَلِّي فِي بَيْتِي فِي مَسْجِدٍ مَشِيدٍ ، أَوْ بِمَرْمَرٍ لَيْسَ فِيهِ تُرَابٌ ، وَلا بَطْحَاءُ ؟ , قَالَ : "" أُحِبُّ ذَلِكَ ، الْبَطْحَاءُ أَحَبُّ إِلَيَّ "" ، قُلتُ : أَرَأَيْتَ لَوْ كَانَ فِيهِ حَيْثُ أَضَعُ وَجْهِي فَقَطْ ، قَبْضَةَ بَطْحَاءَ أَيَكْفِينِي ؟ , قَالَ : "" نَعَمْ ، إِذَا كَانَ قَدْرُ وَجْهِهِ أَوْ أَنْفِهِ ، وَجَبِينِهِ "" ، قُلتُ : وَإِنْ لَمْ يَكُنْ تَحْتَ يَدَيْهِ بَطْحَاءُ ؟ , قَالَ : "" نَعَمْ "" ، قُلْتُ : فَأَحَبُّ إِلَيَّ أَنْ أَجْعَلَ السُّجُودَ كُلَّهُ بَطْحَاءَ ؟ , قَالَ : "" نَعَمْ ""","","","","","Book of Prayer"
"1476","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِنَافِعٍ مَوْلَى ابْنِ عُمَرَ : أَكَانَ ابْنُ عُمَرَ  يَكْرَهُ أَنْ يُصَلِّيَ فِي الْمَكَانِ الْجَدَدِ ، وَيَتَتَبَّعَ الْبَطْحَاءَ وَالتُّرَابَ ؟ , قَالَ : لَمْ يَكُنْ يُبَالِي ""","","","","","Book of Prayer"
"1477","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ إِنْسَانٌ لِعَطَاءٍ :  أَرَأَيْتَ إِنْ صَلَّيْتُ فِي مَكَانٍ جَدَدٍ أَفْحَصُ ، عَنْ وَجْهِي التُّرَابَ ؟ "" , قَالَ : "" نَعَمْ ""","","","","","Book of Prayer"
"1478","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أَعْمِدُ مَكَانًا مِنْ بَيْتِي لَيْسَ فِيهِ مَسْجِدٌ ، لا أَعْلَمُ بِهِ بَأْسًا فَأُصَلِّي فِيهِ ؟ , قَالَ : "" نَعَمْ "" ، قُلْتُ : وَلا أَرُشُّ ؟ , قَالَ : "" لا ، إِلا أَنْ تَخْشَى أَنْ يَكُونَ بِهِ بَأْسٌ ، فَإِنْ شِئْتَ فَارْشُشْهُ ""","","","","","Book of Prayer"
"1479","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : اتَّخِذْ فِي بَيْتِكَ مَسْجِدًا ، فَإِنَّ زَيْدَ بْنَ خَالِدٍ الْجُهَنِيَّ , قَالَ :  لا تَتَّخِذُوا بُيُوتَكُمْ مَقَابِرَ ، وَاتخِذُوا فِيهَا مَسَاجِدَ ""","","","","","Book of Prayer"
"1480","عَنِ ابْنِ عُيَيْنَةَ , قَالَ : حُدِّثْتُ عَنْ أَنَسِ بْنِ مَالِكٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  أَكْرِمُوا بُيُوتَكُمْ بِبَعْضِ صَلاتِكُمْ ، وَلا تَتَّخِذُوهَا قُبُورًا ""","","","","","Book of Prayer"
"1481","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أَرَأَيْتَ صَلاةَ الإِنْسَانِ عَلَى الْخُمْرَةِ ، وَالْوِطَاءِ ؟ , قَالَ : "" لا بَأْسَ بِذَلِكَ إِذَا لَمْ يَكُنْ تَحْتَ وَجْهِهِ ، وَيَدَيْهِ ، وَإِنْ كَانَ تَحْتَ رُكْبَتَيْهِ مِنْ أَجْلِ أَنَّهُ يَسْجُدُ عَلَى حُرِّ وَجْهِهِ ""","","","","","Book of Prayer"
"1482","عَنِ ابْنِ عُيَيْنَةَ , قَالَ : قُلْتُ لِعَطَاءٍ :  أَرَأَيْتَ إِنْسَانًا يُصَلِّي ، وَعَلَيْهِ طَاقٌ فِي بَرْدٍ فَجَعَلَ يَسْجُدُ عَلَى طَاقِهِ ، وَلا يُخْرِجُ يَدَيْهِ , قَالَ : "" لا يَضُرُّهُ "" ، قُلْتُ : فَلِغَيْرِ بَرْدٍ , قَالَ : "" أَحَبُّ إِلَيَّ أَنْ يُسَوِّيَ بَيْنَهُمَا ، وَبَيْنَ الأَرْضِ , فَإِنْ لَمْ يَفْعَلْ فَلا حَرَجَ "" ، قُلْتُ : أَحَبُّ إِلَيْكَ أَنْ لا يُصَلِّيَ عَلَى شَيْءٍ إِلا عَلَى الأَرْضِ , وَيَدَعُ ذَلِكَ كُلَّهُ ؟ , قَالَ : "" نَعَمْ ""","","","","","Book of Prayer"
"1483","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ ، أَنَّ ابْنَ عُمَرَ  كَانَ يُصَلِّي عَلَى خُمْرَةٍ تَحْتَهَا حَصِيرُ بَيْتِهِ فِي غَيْرِ مَسْجِدٍ فَيَسْجُدُ عَلَيْهَا ، وَيَقُوَمُ عَلَيْهَا ""","","","","","Book of Prayer"
"1484","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ الزُّهْرِيَّ ، عَنِ السُّجُودِ عَلَى الطَّنْفَسَةِ ؟ , قَالَ : لا بَأْسَ بِذَاكَ , كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  يُصَلِّي عَلَى الْخُمْرَةِ ""","","","","","Book of Prayer"
"1485","عَنْ مَالِكٍ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي طَلْحَةَ ، عَنْ أَنَسٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  صَلَّى عَلَى حَصِيرٍ ""","","","","","Book of Prayer"
"1486","عَنِ الثَّوْرِيِّ ، عَنْ تَوْبَةَ ، عَنْ عِكْرِمَةَ بْنِ خَالِدٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عَامِرٍ , قَالَ : رَأَيْتُ عُمَرَ بْنَ الْخَطَّابِ  يُصَلِّي عَلَى عَبْقَرِيٍّ "" ، قُلْتُ : مَا الْعَبْقَرِيُّ ؟ , قَالَ : "" لا أَدْرِي ""","","","","","Book of Prayer"
"1487","عَنْ مَعْمَرٍ ، عَنْ يَزِيدَ بْنِ أَبِي زِيَادٍ ، عَنْ مِقْسَمٍ , قَالَ :  صَلَّى ابْنُ عَبَّاسٍ عَلَى طَنْفَسَةٍ أَوْ بِسَاطٍ قَدْ طَبَّقَ بَيْتَهُ "" , عَنِ ابْنِ عُيَيْنَةَ ، عَنِ الأَعْمَشِ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، عَنِ ابْنِ عَبَّاسٍ , مِثْلَهُ , عَنْ أَبِيهِ ، عَنْ خَلادِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، عَنِ ابْنِ عَبَّاسٍ , مِثْلَهُ""","","","","","Book of Prayer"
"1488","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قَالَ :  صَلَّى ابْنُ عَبَّاسٍ عَلَى طَنْفَسَةٍ طَبَّقَ الْبَيْتَ ""","","","","","Book of Prayer"
"1489","أَخْبَرَنِي أَبِي ، عَنْ خَلادِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ جُنْدَةَ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، أَنَّ ابْنَ عَبَّاسٍ  أَمَّهُمْ فِي ثَوْبٍ وَاحِدٍ , مُخَالِفًا بَيْنَ طَرَفَيْهِ عَلَى طَنْفَسَةٍ قَدْ طَبَّقَتِ الْبَيْتَ ""","","","","","Book of Prayer"
"1490","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ , قَالَ :  لا بَأْسَ أَنْ يُصَلَّى عَلَى الطَّنْفَسَةِ وَالْخُمْرَةِ ""","","","","","Book of Prayer"
"1491","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ , قَالَ : كَانَ ابْنُ عُمَرَ  يَغْسِلُ قَدَمَيْهِ الْحَائِضُ ، وَكَانَ يُصَلِّي عَلَى الْخُمْرَةِ "" , عَنْ مَالِكٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , مِثْلَهُ""","","","","","Book of Prayer"
"1492","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي وَائِلٍ ، أَنَّ ابْنَ مَسْعُودٍ  صَلَّى عَلَى مِسْحٍ ""","","","","","Book of Prayer"
"1493","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ , قَالَ : رَأَيْتُ أَبِي  بُسِطَ لَهُ بِسَاطٌ فَصَلَّى عَلَيْهِ ، فَظَننتُ أَنَّ ذَلِكَ لِقَذَرِ الْمَكَانِ ""","","","","","Book of Prayer"
"1494","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ جَعْفَرِ بْنِ عُمَرَ ، أَوْ غَيْرِهِ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  كَانَ فِي بَيْتٍ ، وَكَفَّ عَلَيْهِ فَاجْتَذَبَ نَطْعًا فَصَلَّى عَلَيْهِ ""","","","","","Book of Prayer"
"1495","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ , قَالَ : بَلَغَنِي أَنَّ أَبَا بَكْرٍ الصِّدِّيقَ ، كَانَ  يَسْجُدُ ، أَوْ يُصَلِّي عَلَى الأَرْضِ مُفْضِيًا إِلَيْهَا ""","","","","","Book of Prayer"
"1496","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، عَنْ أَبِي عُبَيْدَةَ ، قَالَ : كَانَ ابْنُ مَسْعُودٍ  لا يَسْجُدُ أَوْ قَالَ : لا يُصَلِّي إِلا عَلَى الأَرْضِ ""","","","","","Book of Prayer"
"1497","قَالَ الثَّوْرِيُّ وَأَخْبَرَنِي مُحِلٌّ ، عَنْ إِبْرَاهِيمَ ، أَنَّهُ كَانَ  يَقُوَمُ عَلَى الْبَرْدِيِّ ، وَيَسْجُدُ عَلَى الأَرْضِ "" , قُلْنَا : مَا الْبَرْدِيُّ ؟ , قَالَ : "" الْحَصِيرُ ؟ ""","","","","","Book of Prayer"
"1498","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مَالِكِ بْنِ مِغْوَلٍ , عَمَّنْ ، سَمِعَ ابْنَ شُرَيْحِ بْنِ هَانِئٍ ، عَنْ أَبِيهِ يُحَدِّثُ ، عَنْ عَائِشَةَ , قَالَتْ : مَا رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مُتَّقِيًا وَجْهَهُ بِشَيْءٍ , تَعْنِي فِي السُّجُودِ","","","","","Book of Prayer"
"1499","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الشَّعْبِيِّ ، أَنَّ عُمَرَ , قَالَ :  إِنِ اشْتَدَّ الزِّحَامُ يَوْمَ الْجُمُعَةِ , فَلْيَسْجُدْ أَحَدُكُمْ عَلَى ظَهْرِ أَخِيهِ ""","","","","","Book of Prayer"
"1500","عَنْ مَعْمَرٍ ، عَنِ الأَعْمَشِ ، عَنْ مُسَيِّبِ بْنِ رَافِعٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ :  مَنْ آذَاهُ الْحَرُّ يَوْمَ الْجُمُعَةِ فَلْيَبسُطْ ثَوْبَهُ فَلْيَسْجُدْ عَلَيْهِ ، وَمَنْ زَحِمَهُ النَّاسُ يَوْمَ الْجُمُعَةِ حَتَّى لا يَسْتَطِيعَ أَنْ يَسْجُدَ عَلَى الأَرْضِ , فَلْيَسْجُدْ عَلَى ظَهْرِ رَجُلٍ ""","","","","","Book of Prayer"
"1501","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ فُضَيْلٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : قَالَ عُمَرُ :  إِذَا آذَى أَحَدَكُمُ الْحَرُّ يَوْمَ الْجُمُعَةِ , فَلْيَسْجُدْ عَلَى ثَوْبِهِ ""","","","","","Book of Prayer"
"1502","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ :  إِذَا آذَى أَحَدَكُمُ الْحَرُّ يَوْمَ الْجُمُعَةِ , فَلْيَسْجُدْ عَلَى ثَوْبِهِ ""","","","","","Book of Prayer"
"1503","عَنِ الثَّوْرِيِّ ، عَنِ الْعَلاءِ ، عَنْ مُجَاهِدٍ , قَالَ :  إِذَا كَانَ الزِّحَامُ فَلْيَسْجُدْ عَلَى رَجُلٍ "" ، قَالَ سُفْيَانُ : "" وَإِنْ لَمْ يُطِقْ أَنْ يَسْجُدَ عَلَى رَجُلٍ مَكَثَ حَتَّى يَقُوَمَ الْقَوْمُ ، ثُمَّ يَسْجُدُ وَيَتَّبِعُهُمْ ""","","","","","Book of Prayer"
"1504","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ :  إِذَا آذَانِي الْحَرُّ لَمْ أُبَالِ أَنْ أَسْجُدَ عَلَى ثَوْبِي , فَأَمَّا أَنْ أَسْجُدَ عَلَى إِنْسَانٍ فَلا ""","","","","","Book of Prayer"
"1505","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ، عَنْ طَاوُسٍ , قَالَ :  إِذَا اشْتَدَّ الزِّحَامُ فَأَوِّمْ بِرَأْسِكَ مَعَ الإِمَامِ ، ثُمَّ اسْجُدْ عَلَى أَخِيكَ "" ، وَقَالَهُ ابْنُ جُرَيْجٍ : عَنْ طَاوُسٍ""","","","","","Book of Prayer"
"1506","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ , قَالَ :  لا بَأْسَ بِالسُّجُودِ عَلَى : كَوْرِ الْعِمَامَةِ ""","","","","","Book of Prayer"
"1507","أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ مُحَرَّرٍ , قَالَ : أَخْبَرَنِي يَزِيدُ بْنُ الأَصَمِّ ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  يَسْجُدُ عَلَى كَوْرِ عِمَامَتِهِ "" , قَالَ ابْنُ مُحَرَّرٍ : وَأَخْبَرَنِي سُلَيْمَانُ بْنُ مُوسَى ، عَنْ مَكْحُولٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , مِثْلَ ذَلِكَ""","","","","","Book of Prayer"
"1508","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ , قَالَ : رَأَيْتُ مَكْحُولا ،  يَسْجُدُ عَلَى عِمَامَتِهِ ، فَقُلْتُ : لِمَ تَسْجُدُ عَلَيْهَا ؟ , فَقَالَ : "" أَتَّقِي الْبَرْدَ عَلَى إِنْسَانِي ""","","","","","Book of Prayer"
"1509","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنِ الْحَسَنِ , قَالَ :  أَدْرَكْنَا الْقَوْمَ وَهُمْ يَسْجُدُونَ عَلَى عَمَائمِهِمْ ، وَيَسْجُدُ أَحَدُهُمْ ، وَيَدَيْهِ فِي قَمِيصِهِ ""","","","","","Book of Prayer"
"1510","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي الضُّحَى ، أَنَّ شُرَيْحًا كَانَ  يَسْجُدُ عَلَى بُرْنُسِهِ "" ، وَعَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ ، كَانَ "" يَسْجُدُ عَلَى عِمَامَتِهِ ""","","","","","Book of Prayer"
"1511","عَنِ الثَّوْرِيِّ ، عَنِ الزُّبَيْرِ ، عَنْ إِبْرَاهِيمَ  أَنَّهُ سَأَلَهُ أَيَسْجُدُ عَلَى كَوْرِ الْعِمَامَةِ ؟ , فَقَالَ : "" أَسْجُدُ عَلَى جَبِينِي أَحَبُّ إِلَيَّ ""","","","","","Book of Prayer"
"1512","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ :  أَصَابَتْنِي شَجَّةٌ فِي وَجْهِي فَعَصَبْتُ عَلَيْهَا ، فَسَأَلْتُ عُبَيْدَةَ السَّلْمَانِيَّ أَسْجُدُ عَلَيْهَا ؟ , فَقَالَ : "" انْزِعِ الْعِصَابَ ""","","","","","Book of Prayer"
"1513","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ  كَانَ يَكْرَهُ أَنْ يَسْجُدَ عَلَى كَوْرِ عِمَامَتِهِ حَتَّى يَكْشِفَهَا ""","","","","","Book of Prayer"
"1514","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ :  كَانُوا يُصَلُّونَ فِي مَسَاتِقِهِمْ ، وَبَرَانِسِهِمْ ، وَطَيَالِسِهِمْ مَا يُخْرِجُونَ أَيْدِيَهُمْ مِنْهَا "" ، قُلْنَا لَهُ : مَا الْمِسْتَقَةُ ؟ , قَالَ : "" هِيَ جُبَّةٌ يَعْمَلُهَا أَهْلُ الشَّامِ وَلَهَا كُمَّانِ طَوِيلانِ ، وَلَبِنُهَا عَلَى الصَّدْرِ يَلْبَسُونَهَا ، وَيَعْقِدُونَ كُمَّيْهَا إِذَا لَبِسُوهَا ""","","","","","Book of Prayer"
"1515","أَخْبَرَنَا بِشْرُ بْنُ رَافِعٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي عُبَيْدَةَ ، عَنْ أَبِيهِ , قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يَكْشِفَ سِتْرًا ، أَوْ يَكُفَّ شَعْرًا ، أَوْ يُحْدِثَ وُضُوءًا , قَالَ : قُلْتُ لِيَحْيَى : مَا قَوْلُهُ : أَوْ يُحْدِثُ وُضُوءًا ؟ , قَالَ : إِذَا وَطِئَ نَتْنًا ، وَكَانَ مُتَوَضِّئًا ، وَقَوْلُهُ : لا يَكْشِفُ سِتْرًا , لا يَكْشِفُ الثَّوْبَ عَنْ يَدَيْهِ إِذَا سَجَدَ","","","","","Book of Prayer"
"1516","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنِ ابْنِ مَسْعُودٍ , قَالَ :  مَا كُنَا نَكْشِفُ ثَوْبًا "" , قَالَ : "" وَكَانَ ابْنُ عُمَرَ يُخْرِجُ يَدَيْهِ ، وَكَانَ الْحَسَنُ لا يَفْعَلُهُ ""","","","","","Book of Prayer"
"1517","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، وَحُصَيْنٍ , أَوْ أَحَدِهِمَا ، عَنِ ابْنِ أَبِي حَازِمٍ ، عَنْ مَوْلاةٍ لَهُ يُقَالُ لَهَا عَزَّةُ , قَالَتْ : خَطَبَنَا أَبُو بَكْرٍ :  فَنَهَانَا أَوْ نَهَى , أَنْ نُصَلِّيَ عَلَى الْبَرَادِعِ ""","","","","","Book of Prayer"
"1518","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَنَّ عَلِيًّا ، كَانَ  يَنْهَى أَنْ يُصَلَّى عَلَى جَوَادِ الطَّرِيقِ ""","","","","","Book of Prayer"
"1519","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ مِنْ أَهْلِ الْجَزِيرَةِ ، أَنَّ ابْنَ عُمَرَ : كَانَ  يَكْرَهُ أَنْ يُتَغَوَّطَ عَلَى الطَّرِيقِ , أَوْ يُصَلَّى عَلَيْهَا ""","","","","","Book of Prayer"
"1520","عَنِ الثَّوْرِيِّ ، عَنْ هِشَامِ بْنِ عَائِذٍ الأَسَدِيِّ , قَالَ : كُنْتُ مَعَ إِبْرَاهِيمَ فَأَمَّنِي فِي الْفَجْرِ , فَأَقَامَنِي عَنْ يَمِينِهِ ، وَتَنَحَّى عَنِ الطَّرِيقِ ، قَالَ سُلَيْمَانُ :  كَانَ يُسْتَحَبُّ أَنْ يَنْزِلَ الرَّجُلُ عَنْ يَمِينِ الطَّرِيقِ , أَوْ يُصَلِّيَ عَنْ يَمِينِ الطَّرِيقِ ""","","","","","Book of Prayer"
"1521","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنْ أَبِي ذَرٍّ , قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ !  أَيُّ مَسْجِدٍ وُضِعَ فِي الأَرْضِ أَوَّلُ ؟ , قَالَ : "" الْمَسْجِدُ الْحَرَامُ "" ، قُلْتُ : ثُمَّ أَيُّ ؟ , قَالَ : "" ثُمَّ الْمَسْجِدُ الأقْصَى "" , قَالَ : قُلْتُ : كَمْ بَيْنَهُمَا ؟ , قَالَ : "" أَرْبَعُونَ سَنَةً "" , قَالَ : "" ثُمَّ حَيْثُمَا أَدْرَكَتْكَ الصَّلاةُ فَصَلِّ فَهُوَ مَسْجِدٌ "" , قَالَ : "" فَكَانَ أَبِي يُمْسِكُ الْمُصْحَفَ فِي الطَّرِيقِ ، وَيَقْرَأُ السُّجُودَ ، وَيَسْجُدُ كَمَا هُوَ فِي الطَّرِيقِ ""","","","","","Book of Prayer"
"1522","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَتَكْرَهُ أَنْ نُصَلِّيَ فِي وَسَطِ الْقُبُورِ ، أو في مسجد إلى قبر ؟ , قال :  نَعَمْ ، كَانَ يُنْهَى عَنْ ذَلِكَ "" , قَالَ : أَرَأَيْتَ إِنْ كَانَ قَبْرٌ وَبَيْنِي ، وَبَيْنَهُ سَعَةٌ غَيْرُ بُعْدٍ أَوْ عَلَى مَسْجِدٍ ذِرَاعٌ فَصَاعِدًا ؟ , قَالَ : "" يُكْرَهُ أَنْ يُصَلَّى وَسَطَ الْقُبُورِ ""","","","","","Book of Prayer"
"1523","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ :  لا تُصَلِّ ، وَبَيْنَكَ ، وَبَيْنَ الْقِبْلَةِ قَبْرٌ ، وَإِنْ كَانَ بَيْنَكَ ، وَبَيْنَهُ سِتْرُ ذِرَاعٍ فَصَلِّ ""","","","","","Book of Prayer"
"1524","عَنْ مَعْمَرٍ ، عَنْ ثَابِتٍ الْبَنَانِيِّ ، عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ : رَآنِي عُمَرُ بْنُ الْخَطَّابِ : وَأَنَا أُصَلِّي عِنْدَ قَبْرٍ ، فَجَعَلَ يَقُولُ :  الْقَبْرُ "" , قَالَ : "" فَحَسِبْتُهُ يَقُولُ : الْقَمَرُ "" , قَالَ : فَجَعَلْتُ أَرْفَعُ رَأْسِي إِلَى السَّمَاءِ فَأَنْظُرُ , فَقَالَ : "" إِنَّمَا أَقُولُ : الْقَبْرُ لا تُصَلِّ إِلَيْهِ "" , قَالَ ثَابِتٌ : فَكَانَ أَنَسُ بْنُ مَالِكٍ يَأْخُذُ بِيَدِي إِذَا أَرَادَ أَنْ يُصَلِّيَ فَيَتَنَحَّى عَنِ الْقُبُورِ""","","","","","Book of Prayer"
"1525","عَنِ الثَّوْرِيِّ ، عَنْ عَمْرِو بْنِ يَحْيَى ، عَنْ أَبِيهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  الأَرْضُ كُلُّهَا مَسْجِدٌ , إِلا الْقَبْرَ وَالْحَمَّامَ ""","","","","","Book of Prayer"
"1526","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالُوا :  كَانُوا يَكْرَهُونَ أَنْ يَتَّخِذُوا ثَلاثَةَ أَبْيَاتٍ قِبْلَةً : الْقَبْرَ ، وَالْحَمَّامَ ، وَالْحَشَّ ""","","","","","Book of Prayer"
"1527","عَنِ الثَّوْرِيِّ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ :  لا تُصَلِّيَنَّ إِلَى حَشٍّ ، وَلا حَمَّامٍ ، وَلا فِي الْمَقْبَرَةِ ""","","","","","Book of Prayer"
"1528","عَنِ الثَّوْرِيِّ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ أَبِي ظَبْيَانَ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ :  لا تُصَلِّيَنَّ إِلَى حَشٍّ ، وَلا فِي الْحَمَّامِ ، وَلا فِي الْمَقْبَرَةِ ""","","","","","Book of Prayer"
"1529","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، وَالْحَارِثِ ، عَنْ عَلِيٍّ ، وَأَحْسَبُ مَعْمَرًا رَفَعَهُ , قَالَ :  مِنْ شِرَارِ النَّاسِ مَنْ يَتَّخِذُ الْقُبُورَ مَسَاجِدَ ""","","","","","Book of Prayer"
"1530","عَنْ مَعْمَرٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  اللَّهُمْ لا تَجْعَلْ قَبْرِي وَثنا يُصَلَّى إِلَيْهِ ، فَإِنَّهُ اشْتَدَّ غَضَبُ اللَّهِ عَلَى قَوْمٍ اتَّخَذُوا قُبُوَرَ أَنْبِيَائِهِمْ مَسَاجِدَ ""","","","","","Book of Prayer"
"1531","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : أَخْبَرَنِي عُبَيْدُ اللَّهِ بْنُ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، أَنَّ ابْنَ عَبَّاسٍ أَخْبَرَهُ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، لَمَّا حَضَرَتْهُ الْوَفَاةُ جَعَلَ يُلْقِي عَلَى وَجْهِهِ طَرَفَ خَمِيصِهِ ، فَإِذَا اغْتَمَّ بِهَا كَشَفَهَا ، عَنْ وَجْهِهِ وَيَقُولُ :  لَعْنَةُ اللَّهِ عَلَى الْيَهُودِ , وَالنَّصَارَى اتَّخَذُوا قُبُوَرَ أَنْبِيَائِهِمْ مَسَاجِدَ "" , قَالَ : تَقُولُ عَائِشَةُ : "" يُحَذِّرُ مِثْلَ الَّذِي صَنَعُوا ""","","","","","Book of Prayer"
"1532","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ , قَالَ : حَدَّثَنِي ابْنُ الْمُسَيِّبِ ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ :  قَاتَلَ اللَّهُ الْيَهُودَ , اتَّخَذُوا قُبُوَرَ أَنْبِيَائِهِمْ مَسَاجِدَ ""","","","","","Book of Prayer"
"1533","عَنْ نَافِعِ بْنِ جُبَيْرٍ ، أَنَّهُ قَالَ :  يُنْهَى أَنْ يُصَلَّى : وَسَطَ الْقُبُورِ ، أَوِ الْحَمَّامَاتِ ، وَالْجُبَّانِ ""","","","","","Book of Prayer"
"1534","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، وَسُئِلَ عَنِ الصَّلاةِ وَسَطَ الْقُبُورِ ؟ قَالَ : ذُكِرَ لِي ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كَانَتْ بَنُو إِسْرَائِيلَ اتَّخَذُوا قُبُوَرَ أَنْبِيَائِهِمْ مَسَاجِدَ , فَلَعَنَهُمُ اللَّهُ تَعَالَى ""","","","","","Book of Prayer"
"1535","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ :  لا أَعْلَمُهُ إِلا كَانَ يَكْرَهُ الصَّلاةَ وَسَطَ الْقُبُورِ كَرَاهَةً شَدِيدَةً ""","","","","","Book of Prayer"
"1536","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِنَافِعٍ : أَكَانَ ابْنُ عُمَرَ يَكْرَهُ أَنْ يُصَلِّيَ وَسَطَ الْقُبُورِ ؟ قَالَ :  لَقَدْ صَلَّيْنَا عَلَى عَائِشَةَ ، وَأُمِّ سَلَمَةَ وَسَطَ الْبَقِيعِ "" , قَالَ : "" وَالإِمَامُ يَوَمَ صَلَّيْنَا عَلَى عَائِشَةَ رَضِيَ اللَّهُ عَنْهَا أَبُو هُرَيْرَةَ ، وَحَضَرَ ذَلِكَ عَبْدُ اللَّهِ بْنُ عُمَرَ ""","","","","","Book of Prayer"
"1537","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  يُصَلِّي فِي مُرَاحِ الإِبِلِ ؟ , قَالَ : "" نَعَمْ "" ، قُلْتُ : أَيُكْرَهُ أَنْ أُصَلِّيَ فِي أَعْطَانِ الإِبِلِ مِنْ أَجْلِ أَنَّهُ يَبُولُ الرَّجُلُ إِلَى الْبَعِيرِ الْبَارِكِ ، وَلَوْلا ذَلِكَ لَكَانَ بِمَنْزِلَةِ مُرَاحِهَا , قَالَ : "" فَكُفَّ عَنْهُ إِذًا ، فَإِنْ لَمْ تُحِسَّ ذَلِكَ فَهُوَ بِمَنْزِلَةِ مُرَاحِهَا ""","","","","","Book of Prayer"
"1538","عَنْ مَعْمَرٍ ، عَنِ الْحَسَنِ ، وَقَتَادَةَ ، قَالا : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  يُصَلِّي فِي مَرَابِضِ الْغَنَمِ ، وَلا يُصَلِّي فِي أَعْطَانِ الإِبِلِ ""","","","","","Book of Prayer"
"1539","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ، عَنِ الْبَرَاءِ بْنِ عَازِبٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سُئِلَ :  أَنُصَلِّي فِي أَعْطَانِ الإِبِلِ ؟ , قَالَ : "" لا "" , قَالَ : أَفَنُصَلِّي فِي مَرَابِضِ الْغَنَمِ ؟ , قَالَ : "" نَعَمْ "" , قَالَ : أَنَتَوَضَّأُ مِنْ لُحُومِ الْغَنَمِ ؟ , قَالَ : "" لا "" , عَنْ مَعْمَرٍ ، عَنِ الأَعْمَشِ ، عَنْ رَجُلٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ، عَنِ الْبَرَاءِ بْنِ عَازِبٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ""","","","","","Book of Prayer"
"1540","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنْ أَبِي سَبْرَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ،  أَكَلَ مِنْ لُحُومِ الإِبِلِ ثُمَّ صَلَّى ، وَلمْ يَتَوَضَّأْ ""","","","","","Book of Prayer"
"1541","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ رَجُلٍ مِنْ قُرَيْشٍ ، قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  صَلُّوا فِي مَرَابِضِ الْغَنَمِ ، وَامْسَحُوا رُعَامَهَا , فَإِنَّهَا مِنْ دَوَابِّ الْجَنَّةِ "" , قَالَ : يَعْنِي : الضَّأْنَ مِنْهَا ، قُلْنَا : مَا رُعَامُهَا ؟ , قَالَ : "" مَا يَكُونُ فِي مَنَاخِرِهَا ""","","","","","Book of Prayer"
"1542","عَنْ شَيْخٍ مِنْ أَهْلِ الْمَدِينَةِ يُقَالُ لَهُ : عَبْدُ اللَّهِ بْنُ سَعِيدِ بْنِ أَبِي هِنْدٍ ، قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ عَمْرِو بْنِ أَبِي حَلْحَلَةَ الدِّيلِيِّ ، عَنْ حُمَيْدِ بْنِ مَالِكٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّهُ قَالَ :  أَحْسِنْ إِلَى غَنَمِكَ ، وَامْسَحْ عَنْهَا الرُّعَامَ ، وَصَلِّ فِي نَاحِيَتِهَا , أَوْ قَالَ : فِي مَرَابِضِهَا , فَإِنَّهَا مِنْ دَوَابِّ الْجَنَّةِ ""","","","","","Book of Prayer"
"1543","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ أَبِي حَيَّانَ ، قَالَ : سَمِعْتُ رَجُلا بِالْمَدِينَةِ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  صَلُّوا فِي مَرَابِضِ الْغَنَمِ ، وَامْسَحُوا رُعَامَهَا , فَإِنَّهَا مِنْ دَوَابِّ الْجَنَّةِ ""","","","","","Book of Prayer"
"1544","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ عُبَيْدٍ ، عَنِ الْحَسَنِ ، عَنْ عَبْدِ اللَّهِ بْنِ مُغَفَّلٍ , قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  إِذَا أَدْرَكَتْكَ الصَّلاةُ فِي مَرَابِضِ الْغَنَمِ فَصَلِّ ، وَإِذَا أَدْرَكَتْكَ فِي أَعْطَانِ الإِبِلِ فَابْتَرِزْ , فَإِنَّهَا مِنْ خِلْقَةِ الشَّيْطَانِ أَوْ قَالَ : مِنْ عِيَانِ الشَّيْطَانِ ""","","","","","Book of Prayer"
"1545","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أُصَلِّي فِي مُرَاحِ الشَّاةِ ؟ , قَالَ : "" نَعَمْ "" ، قُلْتُ : أَتَكْرَهُهُ مِنْ أَجْلِ بَوْلِ الْكَلْبِ بَيْنَ أَظْهُرِهَا ؟ , قَالَ : "" فَلا تُصَلِّ فِيهِ ""","","","","","Book of Prayer"
"1546","عَنْ لَيْثٍ ، عَنْ طَاوُسٍ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ :  أَدْرِكُوا عَنْ صَلاتِكُمْ مَا اسْتَطَعْتُمْ ، وَأَشَدُّ مَا يُتَّقَى عَلَيْهَا مَرَابِضُ الْكِلابِ ""","","","","","Book of Prayer"
"1547","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أَيُصَلَّى فِي مُرَاحِ الْبَقَرِ ؟ , قَالَ : "" نَعَمْ "" , قَالَ : أَرَأَيْتَ إِذَا صَلَّيْتُ فِي الْمُرَاحِ كَذَلِكَ , أَسْجُدُ عَلَى الْبَعْرِ أَمْ أَفْحَصُ لِوَجْهِي ؟ , قَالَ : "" بَلِ , افْحَصْ لِوَجْهِكَ ""","","","","","Book of Prayer"
"1548","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ مَالِكِ بْنِ الْحَارِثِ ، عَنْ أَبِيهِ , قَالَ : صَلَّى بِنَا أَبُو مُوسَى الأَشْعَرِيُّ  فِي دَارِ الْبَرِيدِ عَلَى مَكَانٍ فِيهِ سِرْقِينٌ ""","","","","","Book of Prayer"
"1549","عَنْ نُعْمَانَ بْنِ أَبِي شَيْبَةَ ، عَنِ ابْنِ طَاوُسٍ ، وَسَلَمَةَ بْنَ بَهْرَامَ ، أَنَّهُمْ كَانُوا مَعَ طَاوُسٍ ، فِي سَفَرٍ ,  فَأَرَادُوا أَنْ يَنْزِلُوا فِي مَكَانٍ , فَرَأَى أَثَرَ كَلْبٍ ، فَكَرِهَ أَنْ يَنْزِلَ فِيهِ وَمَضَى أَوْ قَالَ : فَتَنَحَّى عَنْهُ ""","","","","","Book of Prayer"
"1550","عَنِ الثَّوْرِيِّ ، عَنْ خُصَيْفٍ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّهُ كَانَ  يَكْرَهُ أَنْ يُصَلَّى فِي الْكَنِيسَةِ إِذَا كَانَ فِيهَا تَمَاثِيلُ ""","","","","","Book of Prayer"
"1551","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي عَطَاءِ بْنِ دِينَارٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ :  لا تَعَلَّمُوا رَطَانَةَ الأعَاجِمِ ، وَلا تَدْخُلُوا عَلَيْهِمْ فِي كَنَائِسِهِمْ يَوْمَ عِيدِهِمْ ، فَإِنَّ السَّخْطَةَ تَنْزِلُ عَلَيْهِمْ ""","","","","","Book of Prayer"
"1552","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنْ أَسْلَمَ مَوْلَى عُمَرَ , قَالَ : لَمَّا قَدِمَ عُمَرُ الشَّامَ , صَنَعَ لَهُ رَجُلٌ مِنْ عُظَمَاءِ النَّصَارَى طَعَامًا وَدَعَاهُ ، فَقَالَ عُمَرُ :  إِنَّا لا نَدْخُلُ كَنَائِسَكُمْ مِنَ الصُّوَرِ الَّتِي فِيهَا "" يَعْنِي : التَّمَاثِيلَ""","","","","","Book of Prayer"
"1553","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنْ أَسْلَمَ ، أَنَّ عُمَرَ حِينَ قَدِمَ الشَّامَ , صَنَعَ لَهُ رَجُلٌ مِنَ النَّصَارَى طَعَامًا ، وَقَالَ لِعُمَرَ : إِنِّي أُحِبُّ أَنْ تَجِيئَنِي ، وَتُكْرِمَنِي أَنْتَ وَأَصْحَابُكَ وَهُوَ رَجُلٌ مِنْ عُظَمَاءِ النَّصَارَى ، فَقَالَ عُمَرُ :  إِنَّا لا نَدْخُلُ كَنَائِسَكُمْ مِنْ أَجْلِ الصُّوَرِ الَّتِي فِيهَا "" يَعْنِي التَّمَاثِيلَ""","","","","","Book of Prayer"
"1554","عَنِ الثَّوْرِيِّ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ نَافِعِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ، أَنَّ سَلْمَانَ الْفَارِسِيَّ ، كَانَ يَلْتَمِسُ مَكَانًا يُصَلِّي فِيهِ ، فَقَالَتْ لَهُ عِلْجَةُ :  الْتَمِسْ قَلْبًا طَاهِرًا ، وَصَلِّ حَيْثُ شِئتَ ، فَقَالَ : "" فَقُهْتِ ""","","","","","Book of Prayer"
"1555","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، عَنْ أَبِي عُبَيْدَةَ بْنِ عَبْدِ اللَّهِ ، عَنِ ابْنِ مَسْعُودٍ  أَنَّهُ كَانَ يُرَخِّصُ لِلجُنُبِ أَنْ يَمُرَّ فِي الْمَسْجِدِ مُجْتَازًا ، وَلا أَعْلَمُهُ إِلا قَالَ :  وَلا جُنُبًا إِلا عَابِرِي سَبِيلٍ ""","","","","","Book of Prayer"
"1556","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ :  يَمُرُّ الْجُنُبُ فِي الْمَسْجِدِ "" ، قُلْتُ لِعَمْرٍو : مِنْ أَيْنَ تَأْخُذُ ذَلِكَ ؟ , قَالَ : مِنْ قَوْلِ :  وَلا جُنُبًا إِلا عَابِرِي سَبِيلٍ مُسَافِرِينَ لا يَجِدُونَ مَاءً "" , وَقَالَ : ذَلِكَ مُجَاهِدٌ أَيْضًا""","","","","","Book of Prayer"
"1557","عَنْ مَعْمَرٍ ، عَنْ مُجَاهِدٍ مِثْلَهُ , فِي قَوْلِهِ :   وَلا جُنُبًا إِلا عَابِرِي سَبِيلٍ , قَالَ : مُسَافِرِينَ لا يَجِدُونَ مَاءً ""","","","","","Book of Prayer"
"1558","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أَيَمُرُّ الْجُنُبُ فِي الْمَسْجِدِ ؟ "" , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"1559","عَنْ مَعْمَرٍ ، عَنْ حَوْشَبٍ , قَالَ : سَمِعْتُ عَطَاءً , يَقُولُ :  لا يَدْخُلُ الْجُنُبُ الْمَسْجِدَ , إِلا أَنْ يُضْطَرَّ ذَلِكَ ""","","","","","Book of Prayer"
"1560","عَنِ الثَّوْرِيِّ , قَالَ  لا يَمُرُّ الْجُنُبُ فِي الْمَسْجِدِ , إِلا أَنْ لا يَجِدَ بُدًّا يَتَيَمَّمُ ، وَيَمُرُّ فِيهِ ""","","","","","Book of Prayer"
"1561","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ :  اقْرَإِ الْقُرْآنَ عَلَى كُلِّ حَالٍ مَا لَمْ تَكُنْ جُنُبًا ، وَادْخُلِ الْمَسْجِدَ عَلَى كُلِّ حَالٍ مَا لَمْ تَكُنْ جُنُبًا ""","","","","","Book of Prayer"
"1562","عَنِ الثَّوْرِيِّ ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ , قَالَ : جَاءَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَهْطٌ مِنْ ثَقِيفٍ فَأُقِيمَتِ الصَّلاةُ ، فَقِيلَ : يَا نَبِيَّ ! اللَّهِ إِنَّ هَؤُلاءِ مُشْرِكُونَ , قَالَ :  إِنَّ الأَرْضَ لا يُنَجِّسُهَا شَيْءٌ ""","","","","","Book of Prayer"
"1563","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عُثْمَانُ بْنُ أَبِي سُلَيْمَانَ ،  أَنَّ مُشْرِكِي قُرَيْشٍ حِينَ أَتَوُا النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالْمَدِينَةِ فِي أُسَرَائِهِمُ الَّذِينَ أُسِرُوا بِبَدْرٍ ، كَانُوا يَبِيتُونَ فِي مَسْجِدِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيهِمْ جُبَيْرُ بْنُ مُطْعِمٍ ، فَكَانَ جُبَيْرُ يَسْمَعُ قِرَاءةَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَجُبَيْرُ يَوْمَئِذٍ مُشْرِكٌ ""","","","","","Book of Prayer"
"1564","عَنِ ابْنِ جُرَيْجٍ , قَالَ :  أَنْزَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَفْدَ ثَقِيفٍ فِي الْمَسْجِدِ ، وَبَنَى لَهُمْ فِيهِ الخِيَامَ يَرَوْنَ النَّاسَ حِينَ يُصَلُّونَ ، وَيَسْمَعُونَ الْقُرْآنَ ""","","","","","Book of Prayer"
"1565","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ شَرِيكٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي الْمُحِلِّ , قَالَ : مَرَرْنَا مَعَ عَلِيٍّ ، بِالْخَسْفِ الَّذِي بِبَابِلَ  فَكَرِهَ أَنْ يُصَلِّيَ فِيهِ حَتَّى جَاوَزَهُ ""","","","","","Book of Prayer"
"1566","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، أَنَّ ابْنَ عُمَرَ , قَالَ : لَمَّا مَرَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالْحِجَرِ , قَالَ :  لا تَدْخُلُوا مَسَاكِنَ الَّذِينَ ظَلَمُوا أَنْفُسَهُمْ إِلا أَنْ تَكُونُوا بَاكِينَ أَنْ يُصِيبَكُمْ ، مِثْلُ الَّذِي أَصَابَهُمْ "" ، ثُمَّ قَنَّعَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَأْسَهُ ، وَأَسْرَعَ السَّيْرَ حَتَّى أَجَازَ الْوَادِيَ""","","","","","Book of Prayer"
"1567","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : لَمَّا مَرَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالْحِجْرِ ، قَالَ لَنَا :  لا تَدْخُلُوا عَلَى هَؤُلاءِ الْمُعَذَّبِينَ إِلا أَنْ تَكُونُوا بَاكِينَ ، فَإِنْ لَمْ تَكُونُوا بَاكِينَ فَلا تَدْخُلُوا عَلَيْهِمْ , فَيُصِيبَكُمْ مِثْلُ مَا أَصَابَهُمْ ""","","","","","Book of Prayer"
"1568","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أَرَأَيْتَ الْكَلْبَ يَمُرُّ فِي الْمَسْجِدِ أَيُرَشُّ أَثَرُهُ ؟ ""","","","","","Book of Prayer"
"1569","سَمِعْتُ الثَّوْرِيَّ , قَالَ :  فِي الْكَلْبِ يَمُرُّ فِي الْمَسْجِدِ يُرَشُّ ""","","","","","Book of Prayer"
"1570","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  الْحَائِضُ تَمُرُّ فِي الْمَسْجِدِ ؟ , قَالَ : "" لا "" ، قُلْتُ : أَتَدْخُلُ مَسْجِدَهَا فِي الْبَيْتِ ؟ , قَالَ : "" لا ، لِتَعْتَزِلْهُ "" ، قُلْتُ : دَخَلتْ فَتَرُشُّهُ بِالْمَاءِ ؟ , قَالَ : "" لا ""","","","","","Book of Prayer"
"1571","عَنِ الثَّوْرِيِّ , قَالَ  يُكْرَهُ أَنْ تَدْخُلَ الْمَرْأَةُ ، وَهِيَ حَائِضٌ مَسْجِدَهَا , وَلَكِنْ تَضَعُ فِيهِ مَا شَاءَتْ ""","","","","","Book of Prayer"
"1572","عَنْ مَالِكٍ ، عَنْ نَافِعٍ , قَالَ : كَانَ جَوَارِي عَبْدِ اللَّهِ بْنِ عُمَرَ  يُلْقِينَ لَهُ الْخُمْرَةَ فِي الْمَسْجِدِ ، وَهُنَّ حُيَّضٌ ""","","","","","Book of Prayer"
"1573","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  فَغَيْرُ مُتَوَضِّئٍ أَيَمُرُّ فِي الْمَسْجِدِ ؟ قَالَ : لا يَضُرُّهُ ""","","","","","Book of Prayer"
"1574","عَنِ الثَّوْرِيِّ ، عَنْ لَيْثٍ , قَالَ :  يُكْرَهُ أَنْ يَدْخُلَ ""","","","","","Book of Prayer"
"1575","عَنْ أَبِي هُبَيْرَةَ ، عَنْ أَبِي الدَّرْدَاءِ ، أَنَّهُ كَانَ  يَبُولُ ، ثُمَّ يَدْخُلُ الْمَسْجِدَ ""","","","","","Book of Prayer"
"1576","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّ ابْنَ سِيرِينَ :  كَانَ يَقْعُدُ عَلَى طَرَفِ الْمَسْجِدِ إِذَا خَرَجَ مِنَ الْخَلاءِ وَرِجْلاهُ فِي الأَرْضِ ، ثُمَّ يَتَوَضَّأُ ""","","","","","Book of Prayer"
"1577","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ , قَالَ : رَأَيْتُ ابْنَ سِيرِينَ  خَرَجَ مِنَ الْخَلاءِ ، وَقَعَدَ عَلَى جِدَارِ الْمَسْجِدِ ، وَقَدْ أَخْرَجَ رِجْلَيْهِ ، وَهُوَ يَتَوَضَّأُ ""","","","","","Book of Prayer"
"1578","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : كَانَ الْحَسَنُ ، وَابْنُ سِيرِينَ  يَكْرَهَانِ الرَّجُلَ إِذَا بَالَ أَنْ يَجْلِسَ فِي الْمَسْجِدِ ، وَهُوَ عَلَى غَيْرِ طُهْرٍ ، وَلَكِنَّهُ يَمُرُّ ، وَلا يَقْعُدُ "" , قَالَ : وَكَانَ جَابِرُ بْنُ زَيْدٍ "" لا يَرَى بِذَلِكَ بَأْسًا أَنْ يَقْعُدَ فِيهِ ، وَهُوَ عَلَى غَيْرِ وُضُوءٍ ""","","","","","Book of Prayer"
"1579","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ :  ادْخُلِ الْمَسْجِدَ عَلَى كُلِّ حَالٍ مَا لَمْ تَكُنْ جُنُبًا ""","","","","","Book of Prayer"
"1580","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ إِنْسَانٌ لِعَطَاءٍ :  يَخْرُجُ إِنْسَانٌ فَيَبُولُ ، ثُمَّ يَأْتِي زَمْزَمَ فَيَتَوَضَّأُ , قَالَ : "" لا بَأْسَ بِذَلِكَ ، وَأَنْ يَتَخَلَّى فَلْيَدْخُلْ , إِنْ شَاءَ فَلْيَتَوَضَّأْ فِي زَمْزَمَ ، الدِّينُ سَمْحٌ سَهْلٌ "" ، قَالَ لَهُ إِنْسَانٌ : إِنِّي أَرَى نَاسًا يَتَوَضَّئُونَ فِي الْمَسْجِدِ , قَالَ : "" اجْلِسْ لَيْسَ بِذَلِكَ بَأْسٌ "" ، قُلْتُ : فَتَتَوَضَّأُ أَنْتَ فِيهِ ؟ , قَالَ : "" نَعَمْ "" ، قُلْتُ : تَمَضْمَضُ وَتَسْتَنْشِقُ ؟ , قَالَ : "" نَعَمْ ، وَأُسْبِغُ وُضُوئِي فِي مَسْجِدِ مَكَّةَ ""","","","","","Book of Prayer"
"1581","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ جُرَيْجٍ , قَالَ : رَأَيْتُ أَبَا بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ  يَتَوَضَّأُ فِي مَسْجِدِ مَكَّةَ ، وَكَانَ طَاوُسٌ يَتَوَضَّأُ فِي الْمَسْجِدِ الْحَرَامِ ""","","","","","Book of Prayer"
"1582","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ أَنَّ ابْنَ عُمَرَ ، كَانَ  يَتَوَضَّأُ فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1583","عَنِ الثَّوْرِيِّ  فِي الْوُضُوءِ فِي الْمَسْجِدِ , قَالَ : إِذَا لَمْ يَكُنْ بَوْلا , فَلا بَأْسَ بِهِ ""","","","","","Book of Prayer"
"1584","عَنِ الثَّوْرِيِّ , قَالَ : وَأَخْبَرَنِي أَبُو هَارُونَ الْعَبْدِيُّ ، أَنَّهُ رَأَى ابْنَ عُمَرَ  يَتَوَضَّأُ فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1585","أَخْبَرَنِي أَبِي ، قَالَ : رَأَيْتُ عَبْدَ الرَّحْمَنِ بْنَ الْبَيْلَمَانِيِّ  يَتَوَضَّأُ فِي مَسْجِدِ صَنْعَاءَ الأَعْظَمِ ""","","","","","Book of Prayer"
"1586","عَنِ ابْنِ أَبِي رَوَّادٍ , قَالَ : رَأَيْتُ طَاوُسًا  يَتَوَضَّأُ فِي الْمَسْجِدِ "" , قَالَ أَبُو بَكْرٍ : وَرَأَيْتُ أَنَا ابْنَ جُرَيْجٍ "" يَتَوَضَّأُ فِي الْمَسْجِدِ الْحَرَامِ , وَهُوَ قَاعِدٌ عَلَى طَنْفَسَةٍ لَهُ , تَمَضْمَضَ وَاسْتَنْثَرَ ""","","","","","Book of Prayer"
"1587","عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، أَنَّ أَبَاهُ : كَانَ  يَتَوَضَّأُ فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1588","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : كَانَ الرَّجُلُ فِي حَيَاةِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، إِذَا رَأَى رُؤْيَا قَصَّهَا عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : فَتَمَنَّيْتُ رُؤْيَا أَقُصُّهَا عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : وَكُنْتُ غُلامًا عَزْبًا , فَكُنْتُ أَنَامُ فِي الْمَسْجِدِ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَرَأَيْتُ فِي النَّوْمِ كَأَنَّ مَلَكَيْنِ أَخَذَانِي فَذَهَبَا بِيَ النَّارَ ، فَإِذَا هِيَ مَطْوِيَّةٌ كَطَيِّ الْبِئْرِ ، وَإِذَا لِلنَّارِ شَيْءٌ كَقَرْنَيِ الْبِئْرِ يَعْنِي قَرْنَيِ الْبِئْرِ : السَّارَتَيْنِ لِلْبِئْرِ ، وَإِذَا فِيهَا نَاسٌ قَدْ عَرَفْتُهُمْ فَجَعَلْتُ أَقُولُ : أَعُوذُ بِاللَّهِ مِنَ النَّارِ ، فَلَقِيَهُمَا مَلَكٌ آخَرُ , فَقَالَ : لَنْ تُرَعْ ، فَقَصَصْتُهَا عَلَى حَفْصَةَ ، فَقَصَّتْهَا حَفْصَةُ عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  نِعْمَ الرَّجُلُ عَبْدُ اللَّهِ ، لَوْ كَانَ يُصَلِّي مِنَ اللَّيْلِ "" , قَالَ سَالِمٌ : فَكَانَ عَبْدُ اللَّهِ "" بَعْدُ لا يَنَامُ مِنَ اللَّيْلِ إِلا قَلِيلا ""","","","","","Book of Prayer"
"1589","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ  كَانَ لا يَرَى بِالنَّوْمِ فِي الْمَسْجِدِ بَأْسًا "" , قَالَ : "" كَانَ يَنَامُ فِيهِ ""","","","","","Book of Prayer"
"1590","عَنِ الثَّوْرِيِّ ، عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنِ الْحَسَنِ , قَالَ :  لا بَأْسَ بِالنَّوْمِ فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1591","عَنِ الثَّوْرِيِّ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ , قَالَ : حَدَّثَنَا الْمُغِيرَةُ بْنُ حَكِيمٍ الصَّنْعَانِيُّ , قَالَ : أَرْسَلَنِي أَبِي إِلَى سَعِيدِ بْنِ الْمُسَيِّبِ يَسْأَلُهُ عَنِ  النَّوْمِ فِي الْمَسْجِدِ ، فَقَالَ : فَأَيْنَ كَانَ أَهْلُ الصُّفَّةِ يَنَامُونَ ؟ وَلمْ يَرَ بِهِ بَأْسًا ""","","","","","Book of Prayer"
"1592","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ مَعْمَرٌ : وَحَدَّثَهُ رَجُلٌ ، عَنْ عَلْقَمَةَ الْمُزَنِيِّ , قَالَ : كَانَ أَهْلُ الصُّفَّةِ يَبِيتُونَ فِي الْمَسْجِدِ ، قَالَ عَلْقَمَةُ فَتُوُفِّيَ رَجُلٌ مِنْهُمْ فَفَتَحَ إِزَارَهُ , فَوَجَدَ فِيهِ دِينَارَانِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  كَيَّتَانِ ""","","","","","Book of Prayer"
"1593","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أَتَكْرَهُ أَنْ يُبَاتَ بِالْمَسْجِدِ ؟ , قَالَ : "" بَلْ ، أُحِبُّهُ حُبَّ أَنْ يُرْقَدَ فِيهِ ""","","","","","Book of Prayer"
"1594","عَنِ ابْنِ جُرَيْجٍ , قَالَ : كَانَ عَطَاءٌ  ثَلاثِينَ سَنَةً يَنَامُ فِي الْمَسْجِدِ ، ثُمَّ يَقُوَمُ لِلطَّوَافِ وَالصَّلاةِ ""","","","","","Book of Prayer"
"1595","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي الْهَيْثَمِ , قَالَ : نَهَانِي مُجَاهِدٌ  عَنِ النَّوْمِ فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1596","عَنِ الثَّوْرِيِّ ، عَنْ لَيْثٍ ، عَنْ خُلَيْدٍ أَبِي إِسْحَاقَ , قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ  عَنِ النَّوْمِ فِي الْمَسْجِدِ ؟ , فَقَالَ : "" إِنْ كُنْتَ تَنَامُ لِصَلاةٍ وَطَوَافٍ , فَلا بَأْسَ ""","","","","","Book of Prayer"
"1597","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ , قَالَ : سَمِعْتُ أَبَا عَمْرٍو الشَّيْبَانِيَّ , يَقُولُ : كَانَ عَبْدُ اللَّهِ بْنُ مَسْعُودٍ  يَعُسُّ الْمَسْجِدَ فَلا يَدَعُ سَوَادًا إِلا أَخْرَجَهُ , إِلا رَجُلا مُصَلِّيًا ""","","","","","Book of Prayer"
"1598","عَنْ يَحْيَى بْنِ الْعَلاءِ ، عَنْ حَرَامِ بْنِ عُثْمَانَ ، عَنِ ابْنَيْ جَابِرٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , قَالَ : أَتَانَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَنَحْنُ مُضْطَجِعُونَ فِي مَسْجِدِهِ , فَضَرَبَنَا بِعَسِيبٍ كَانَ فِي يَدِهِ ، وَقَالَ :  قُوَمُوا لا تَرْقُدُوا فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1599","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ رَجُلٍ مِنْ أَهْلِ الصُّفَّةِ , قَالَ : دَعَانِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَرَهْطٌ مَعِي مِنْ أَهْلِ الصُّفَّةِ فَتَعَشَّيْنَا عِنْدَهُ ، ثُمَّ قَالَ :  إِنْ شِئْتُمْ رَقَدْتُمْ هَهُنَا ، وَإِنْ شِئْتُمْ فِي الْمَسْجِدِ "" ، فَقُلْنَا : فِي الْمَسْجِدِ ؟ , قَالَ : "" فَكُنَا نَنَامُ فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1600","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أَحْدَثَ الرَّجُلُ فِي مَسْجِدِ مَكَّةَ , أَوْ مَسْجِدِهِ فِي الْبَيْتِ عَمْدًا غَيْرَ رَاقِدٍ , قَالَ : أَحَبُّ إِلَيَّ أَنْ لا يَفْعَلَ "" ، قُلْتُ : فَفَعَلَ فَهَلْ مِنْ رَشٍّ ؟ , قَالَ : لا ""","","","","","Book of Prayer"
"1601","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، أَنَّ أَعْرَابِيًّا بَالَ فِي الْمَسْجِدِ , فَقَامَ إِلَيْهِ الْقَوْمُ فَانْتَهَرُوهُ ، وَأَغْلَظُوا لَهُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  دَعُوهُ ، وَأَهْرِيقُوا عَلَى بَوْلِهِ سِجِلا مِنْ مَاءٍ أَوْ دَلْوًا مِنْ مَاءٍ ، فَإِنَّمَا بُعِثْتُمْ مُيَسِّرِينَ ، وَلمْ تُبْعَثُوا مُعَسِّرِينَ "" ، ثُمَّ قَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَالأعْرَابِيُّ خَلْفَهُ فَبَيْنَا هُمْ يُصَلُّونَ , إِذْ قَالَ الأعْرَابِيُّ : اللَّهُمُ ارْحَمْنِي ، وَمُحَمَّدًا ، وَلا تَرْحَمْ مَعَنَا أَحَدًا ، فَلَمَّا انْصَرَفَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ لَهُ : "" لَقَدْ تَحَجَّرْتَ وَاسِعًا ""","","","","","Book of Prayer"
"1602","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ طَاوُسٍ , قَالَ : بَالَ أَعْرَابِيٌّ فِي الْمَسْجِدِ فَأَرَادُوا أَنْ يَضْرِبُوهُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  احْفُرُوا مَكَانَهُ ، وَاطْرَحُوا عَلَيْهِ دَلْوًا مِنْ مَاءٍ ، عَلِّمُوا , وَيَسِّرُوا , وَلا تُعَسِّرُوا ""","","","","","Book of Prayer"
"1603","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، أَنَّهُ سَمِعَ أَنَسَ بْنَ مَالِكٍ , يَقُولُ : بَيْنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْمَسْجِدِ إِذْ دَخَلَ أَعْرَابِيٌّ فَبَالَ فِي نَاحِيَةِ الْمَسْجِدِ , فَصَاحَ بِهِ أَصْحَابُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَأَرَادُوا أَنْ يُقِيمُوهُ , فَنَهَاهُمُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، حَتَّى إِذَا فَرَغَ , أَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأُهْرِيقَ عَلَى بَوْلِهِ مَاءٌ ، أَوْ قِيلَ سِجِلا مِنْ مَاءٍ ، ثُمَّ قَالَ :  إِنَّ هَذَا مَكَانٌ لا يُبَالُ فِيهِ , إِنَّمَا بُنِيَ لِلصَّلاةِ ""","","","","","Book of Prayer"
"1604","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ شَرِيكِ بْنِ أَبِي نَمِرٍ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، أَنَّ أَعْرَابِيًّا بَالَ فِي الْمَسْجِدِ , فَقَامَ إِلَيْهِ أَصْحَابُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  لا تُعَجِّلُوهُ , فَلَمَّا فَرَغَ , أَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : بِسِجِلٍّ مِنْ مَاءٍ , فَأُهْرِيقَ عَلَى بَوْلِهِ "" , قَالَ : قَالَ إِبْرَاهِيمُ : وَأَخْبَرَنِي كَثِيرُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ , مِثْلَهُ""","","","","","Book of Prayer"
"1605","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : بَالَ أَعْرَابِيٌّ فِي الْمَسْجِدِ فَهَمَّ بِهِ الْقَوْمُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  احْفُرُوا مَكَانَهُ ، وَاطْرَحُوا عَلَيْهِ دَلْوًا مِنْ مَاءٍ ، عَلِّمُوا , وَيَسِّرُوا ، وَلا تُعَسِّرُوا ""","","","","","Book of Prayer"
"1606","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي هَارُونُ بْنُ أَبِي عَائِشَةَ ، عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا دَخَلَ الْمَسْجِدَ ، قَالَ :  السَّلامُ عَلَى النَّبِيِّ وَرَحْمَةُ اللَّهِ ، اللَّهُمَ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ وَالْجَنَّةَ "" ، وَإِذَا خَرَجَ قَالَ : "" السَّلامُ عَلَى النَّبِيِّ وَرَحْمَةُ اللَّهِ ، اللَّهُمْ أَعِذْنِي مِنَ الشَّيْطَانِ ، وَمِنَ الشَّرِّ كُلِّهِ ""","","","","","Book of Prayer"
"1607","عَنْ قَيْسِ بْنِ رَبِيعٍ ، عَنْ عَبْدِ اللَّهِ بْنِ الْحَسَنِ ، عَنْ فَاطِمَةَ بِنْتِ حُسَيْنٍ ، عَنْ فَاطِمَةَ الْكُبْرَى , قَالَتْ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا دَخَلَ الْمَسْجِدَ ، قَالَ :  اللَّهُمْ صَلِّ عَلَى مُحَمَّدٍ ، اللَّهُمُ اغْفِرْ لِي ذُنُوبِي ، وَافْتَحْ لِي أَبْوَابَ رَحْمَتِكَ "" ، وَإِذَا خَرَجَ ، قَالَ مِثْلَهَا , إِلا أَنَّهُ يَقُولُ : "" أَبْوَابَ فَضْلِكَ ""","","","","","Book of Prayer"
"1608","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ عُمَارَةَ بْنِ غَزِيَّةَ ، فَذَكَرَ مِثْلَهَا ، إِلا أَنَّهُ يَقُولُ عَنْ عَبْدِ الْمَلِكِ بْنِ سَعِيدٍ ، عَنْ أَبِي حُمَيْدٍ السَّاعِدِيِّ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِذَا دَخَلْتُمُ الْمَسْجِدَ فَقُولُوا : اللَّهُمُ افْتَحْ لَنَا أَبْوَابَ رَحْمَتِكَ ، وَإِذَا خَرَجْتُمْ فَقُولُوا : اللَّهُمْ إِنَّا نَسْأَلُكَ مِنْ فَضْلِكَ ""","","","","","Book of Prayer"
"1609","عَنْ يَحْيَى بْنِ الْعَلاءِ ، عَنْ عَمْرِو بْنِ أَبِي عَمْرٍو ، عَنِ الْمُطَّلِبِ بْنِ عَبْدِ اللَّهِ بْنِ حَنْطَبٍ , قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا دَخَلَ الْمَسْجِدَ , قَالَ :  بِسْمِ اللَّهِ , اللَّهُمُ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ ، وَسَهِّلْ عَلَيَّ أَبْوَابَ رِزْقِكَ ""","","","","","Book of Prayer"
"1610","أَخْبَرَنَا مَعْمَرٌ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، أَنَّ ابْنَ عَبَّاسٍ : كَانَ إِذَا دَخَلَ الْمَسْجِدَ , قَالَ :  السَّلامُ عَلَيْنَا وَعَلَى عِبَادِ اللَّهِ الصَّالِحِينَ ""","","","","","Book of Prayer"
"1611","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ , قَالَ :  إِذَا دَخَلْتَ الْمَسْجِدَ ، فَسَلِّمْ عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَإِذَا دَخَلْتَ عَلَى أَهْلِكَ قُلْ : السَّلامُ عَلَيْكُمْ ، وَإِذَا دَخَلْتَ بَيْتًا لَيْسَ فِيهِ أَحَدٌ فَقُلِ : السَّلامُ عَلَيْنَا ، وَعَلَى عِبَادِ اللَّهِ الصَّالِحِينَ ""","","","","","Book of Prayer"
"1612","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ سَعِيدِ بْنِ ذِي حُدَّانَ , قَالَ : سَأَلْتُ عَلْقَمَةَ ، قُلْتُ :  مَا تَقُولُ إِذَا دَخَلْتَ الْمَسْجِدَ ؟ , قَالَ : "" أَقُولُ السَّلامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ , وَصَلَّى اللَّهُ ، وَمَلائِكَتُهُ عَلَى مُحَمَّدٍ ""","","","","","Book of Prayer"
"1613","عَنْ أَبِي مَعْشَرٍ الْمَدَنِيِّ ، عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ ، أَنَّ كَعْبًا ، قَالَ لأَبِي هُرَيْرَةَ :  احْفَظْ عَلَيَّ اثْنَتَيْنِ ، إِذَا دَخَلْتَ الْمَسْجِدَ سَلِّمْ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَقُلِ : اللَّهُمُ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ ، وَإِذَا خَرَجْتَ قُلِ : اللَّهُمْ صَلِّ عَلَى مُحَمَّدٍ ، اللَّهُمْ أَعِذْنِي مِنَ الشَّيْطَانِ "" , عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مُحَمَّدِ بْنِ عَجْلانَ ، عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ , مِثْلَهُ""","","","","","Book of Prayer"
"1614","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاهِدٍ , قَالَ :  إِذَا خَرَجْتَ مِنَ الْمَسْجِدِ فَقُلْ : بِسْمِ اللَّهِ تَوَكَّلْتُ عَلَى اللَّهِ , أَعُوذُ بِاللَّهِ مِنْ شَرِّ مَا خَلَقَ ""","","","","","Book of Prayer"
"1615","عَنْ عَامِرِ بْنِ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ ، عَنْ عَمْرِو بْنِ سُلَيْمٍ , قَالَ : سَمِعْتُ أَبَا قَتَادَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِذَا دَخَلَ أَحَدُكُمُ الْمَسْجِدَ , فَلا يَجْلِسْ حَتَّى يُصَلِّيَ رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"1616","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ أَبِي النَّضْرِ ، قَالَ : قَالَ لِي أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ  مَا يَمْنَعُ مَوْلاكَ إِذَا دَخَلَ الْمَسْجِدَ أَنْ يُصَلِّيَ رَكْعَتَيْنِ , فَإِنَّهُ مِنَ السُّنَّةِ ""","","","","","Book of Prayer"
"1617","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ رَجُلٍ ، عَنِ الشَّعْبِيِّ , قَالَ :  إِذَا دَخَلْتَ الْمَسْجِدَ فَرَكَعْتَ ، ثُمَّ خَرَجْتَ ، ثُمَّ دَخَلْتَ أَيْضًا , كَفَاكَ الرُّكُوعُ الأَوَّلُ ""","","","","","Book of Prayer"
"1618","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ إِنْسَانٌ لِعَطَاءٍ : أَكَانَ يُقَالُ :  إِذَا مَرَّ الرَّجُلُ بِالْمَسْجِدِ فَلْيَرْكَعْ فِيهِ رَكْعَتَيْنِ ؟ , فَقَالَ : "" لَمْ أَسْمَعْ فِيهِ ذَلِكَ ، وَذَلِكَ حَسَنٌ ""","","","","","Book of Prayer"
"1619","عَنْ مَعْمَرٍ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، عَنْ عَامِرِ بْنِ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ , قَالَ : دَخَلَ الْمَسْجِدَ رَجُلٌ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا تَجْلِسْ حَتَّى تُصَلِّيَ رَكْعَتَيْنِ","","","","","Book of Prayer"
"1620","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، وَغَيْرِهِ مِنْ أَهْلِ الْكُوفَةِ ، عَنِ ابْنِ مَسْعُودٍ , قَالَ :  مِنْ أَشْرَاطِ السَّاعَةِ أَنْ يَمُرَّ الرَّجُلُ فِي الْمَسْجِدِ فَلا يَرْكَعُ رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"1621","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنِ الْعَلاءِ بْنِ عَبْدِ الرَّحْمَنِ , قَالَ : رَأَيْتُ ابْنَ عُمَرَ  دَخَلَ الْمَسْجِدَ ، وَخَرَجَ مِنْهُ فَلَمْ يُصَلِّ فِيهِ ""","","","","","Book of Prayer"
"1622","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ :  إِذَا صَلَّيْتَ فَإِنَّكَ تُنَاجِي رَبَّكَ فَلا تَبْصُقْ أَمَامَكَ ، وَلا عَنْ يَمِينِكَ ، وَلَكِنْ عَنْ شِمَالِكَ ، فَإِنْ كَانَ عَنْ شِمَالِكَ مَا يَشْغَلُكَ , فَابْصُقْ تَحْتَ قَدَمِكَ ""","","","","","Book of Prayer"
"1623","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  رَأَى نُخَامَةً فِي قِبْلَةِ الْمَسْجِدِ فَحَكَّهَا بِمَدَرَةٍ أَوْ بِشَيْءٍ ، ثُمَّ قَالَ : إِذَا قَامَ أَحَدُكُمْ إِلَى الصَّلاةِ فَلا يَتَنَخَّمَنَّ أَمَامَهُ ، وَلا عَنْ يَمِينِهِ , فَإِنَّ عَنْ يَمِينِهِ مَلَكًا ، وَلَكِنْ لِيَتَنَخَّمْ عَنْ يَسَارِهِ , أَوْ تَحْتَ قَدَمِهِ الْيُسْرَى ""","","","","","Book of Prayer"
"1624","عَنْ عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : صَلَّى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْمَسْجِدِ , فَرَأَى فِي الْقِبْلَةِ نُخَامَةً , فَلَمَّا قَضَى صَلاتَهُ ، قَالَ :  إِنَّ أَحَدَكُمْ إِذَا صَلَّى فَإِنَّهُ يُنَاجِي رَبَّهُ ، وَإِنَّ اللَّهَ يَسْتَقْبِلُهُ بِوَجْهِهِ ، فَلا يَتَنَخَّمَنَّ أَحَدُكُمْ فِي الْقِبْلَةِ ، وَلا عَنْ يَمِينِهِ "" , ثُمَّ دَعَا بِعُودٍ فَحَكَّهُ بِهِ ، ثُمَّ دَعَا بِخَلُوقٍ فَحَسْبُهُ""","","","","","Book of Prayer"
"1625","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : حَتَّهَا ، ثُمَّ نَضَحَ أَثَرَهَا بِزَعْفَرَانٍ دَعَا بِهِ , فَلِذَلِكَ صُنِعَ الزَّعْفَرَانُ فِي الْمَسَاجِدِ","","","","","Book of Prayer"
"1626","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ الزُّهْرِيَّ  عَنِ الزَّعْفَرَانِ فِي الْمَسْجِدِ , فَقَالَ : حَسَنٌ ، هُوَ طِيبُ الْمَسْجِدِ ""","","","","","Book of Prayer"
"1627","عَنِ ابْنِ أَبِي رَوَّادٍ ، عَنْ مَنْصُورِ بْنِ طَلْحَةَ الْحَجَبِيِّ , قَالَ : صَلَّى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْمَسْجِدِ ، فَرَأَى فِي الْقِبْلَةِ نُخَامَةً , فَلَمَّا قَضَى صَلاتَهُ ، قَالَ : إِنَّ أَحَدَكُمْ إِذَا صَلَّى فَإِنَّهُ يُنَاجِيهِ رَبُّهُ ، فَقَالَ : مَنْ إِمَامِكُمْ ؟ , فَقَالُوا أَبُو فُلانٍ : فَنَزَعَهُ ، ثُمَّ أُخْبِرَتِ امْرَأَتُهُ , فَأَمَرَتْ بِمَاءٍ فَغَسَلَتْهُ ، وَهَيَّأَتْهُ ، وَحَسِبْتُ أَنَّهُ قَالَ : وَجَمَّرَتِ الْمَسْجِدَ ، فَلَمَّا دَخَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْمَسْجِدَ ، فَقَالَ : مَنْ صَنَعَ هَذَا ؟ , فَقَالُوا : امْرَأَةُ فُلانٍ ، فَرَدَّ زَوْجُهَا إِمَامًا","","","","","Book of Prayer"
"1628","عَنْ مَعْمَرٍ ، عَنْ هَمَّامِ بْنِ مُنَبِّهٍ ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِذَا قَامَ أَحَدُكُمْ إِلَى الصَّلاةِ فَلا يَبْزُقْ أَمَامَهُ ، إِنَّهُ يُنَاجِي اللَّهَ مَا دَامَ فِي مُصَلاهُ ، وَلا عَنْ يَمِينِهِ فَعَنْ يَمِينِهِ مَلَكٌ ، وَلَكِنْ لِيَبْصُقْ عَنْ يَسَارِهِ ، أَوْ تَحْتَ رِجْلَيْهِ ""","","","","","Book of Prayer"
"1629","أَخْبَرَنَا مَعْمَرٌ ، عَنْ سَعِيدٍ الْجُرَيْرِيِّ ، عَنْ أَبِي الْعَلاءِ بْنِ عَبْدِ اللَّهِ بْنِ الشِّخِّيرِ ، عَنْ أَبِيهِ , قَالَ : رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  يُصَلِّي ، ثُمَّ تَنَخَّمَ تَحْتَ قَدَمِهِ ، ثُمَّ دَلَكَهَا بِنَعْلِهِ وَهِيَ فِي رِجْلِهِ ""","","","","","Book of Prayer"
"1630","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ مَنْصُورٍ ، عَنْ رِبْعِيِّ بْنِ حِرَاشٍ ، عَنْ طَارِقِ بْنِ عَبْدِ اللَّهِ , قَالَ : قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِذَا صَلَّيْتَ فَلا تَبْصُقْ بَيْنَ يَدَيْكَ ، وَلا عَنْ يَمِينِكَ ، وَابْصُقْ تِلْقَاءَ شِمَالِكَ إِنْ كَانَ فَارِغًا ، وَإِلا فَتَحْتَ قَدَمِكَ ، وَأَشَارَ بِرِجْلِهِ فَفَحَصَ الأَرْضَ ""","","","","","Book of Prayer"
"1631","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي وَائِلٍ ، قَالَ : كُنَّا عِنْدَ حُذَيْفَةَ ، فَقَامَ شَبَثُ بْنُ رِبْعِيٍّ يُصَلِّي فَبَصَقَ بَيْنَ يَدَيْهِ , فَلَمَّا انْصَرَفَ , قَالَ :  يَا شَبَثُ ! لا تَبْصُقْ بَيْنَ يَدَيْكَ ، وَلا عَنْ يَمِينِكَ ، فَإِنَّ عنْ يَمِينِكَ كَاتِبَ الْحَسَنَاتِ ، وَابْصُقْ عَنْ شِمَالِكَ ، وَخَلْفَكَ فَإِنَّ الرَّجُلَ إِذَا تَوَضَّأَ فَأَحْسَنَ الْوُضُوءَ ، وَقَامَ إِلَى الصَّلاةِ , اسْتَقْبَلَهُ اللَّهُ بِوَجْهِهِ يُنَاجِيهِ فَلا يَنْصَرِفُ عَنْهُ حَتَّى يَكُونَ هُوَ يَنْصَرِفُ ، أَوْ يُحْدِثُ حَدَثَ سَوْءٍ ""","","","","","Book of Prayer"
"1632","عَنِ ابْنِ عُيَيْنَةَ ، وَمُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ : سَمِعْتُ رَجُلا مِنْ أَهْلِ الشَّامِ , يُقَالُ لَهُ : عَبْدُ اللَّهِ , يَقُولُ :  أَبْصَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نُخَامَةً فِي قِبْلَةِ الْمَسْجِدِ , فَحَكَّهَا بِحَصَاةٍ أَوْ بِشَيْءٍ ، ثُمَّ قَالَ : مَا يُؤْمِنُ هَذَا أَنْ تَكُونَ كَيَّةً بَيْنَ عَيْنَيْهِ "" ، قَالَ أَحَدُهُمَا : "" ثُمَّ دَعَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِخَلُوقٍ , أَوْ بِزَعْفَرَانٍ , فَلَطَّخَهُ بِهِ""","","","","","Book of Prayer"
"1633","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ أَبِي الْوَسْمِيِّ ، عَنْ رجُلٍ مِنْ بَنِي فَزَارَةَ , يُقَالُ لَهُ : زِيَادُ بْنُ مِلْقَطٍ , قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ :  إِنَّ الْمَسْجِدَ لَيَنْزَوِيَ مِنَ النُّخَامَةِ كَمَا تَنْزَوِي الْبُضْعَةُ , أَوِ الْجِلْدَةُ فِي النَّارِ ""","","","","","Book of Prayer"
"1634","عَنِ ابْنِ التَّيْمِيِّ ، قَالَ : أَخْبَرَنِي حُمَيْدٌ الطَّوِيلُ , أَنَّهُ سَمِعَ أَنَسَ بْنَ مَالِكٍ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِذَا صَلَّى أَحَدُكُمْ فَلا يَبْصُقْ أَمَامَهُ ، وَلا عَنْ يَمِينِهِ ، وَلَكِنْ عَنْ يَسَارِهِ ، فَإِنْ لَمْ يَفْعَلْ فَلْيَبْصُقْ فِي طَرَفِ ثَوْبِهِ "" ، وَقَالَ : "" هَكَذَا "" ، وَعَطَفَ ثَوْبَهُ , فَدَلَكَهُ فِيهِ""","","","","","Book of Prayer"
"1635","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ :  لِيَبْصُقِ الرَّجُلُ فِي الصَّلاةِ عَنْ يَسَارِهِ ، فَإِنْ لَمْ يَجِدْ مَكَانًا فَلْيَرْفَعْ رِجْلَهُ الْيُسْرَى , فَيَبْصُقُ تَحْتَهَا ""","","","","","Book of Prayer"
"1636","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , قَالَ : كَانَ طَاوُسٌ ،  إِذَا بَصَقَ فِي الْمَسْجِدِ حَفَرَ لَهَا خَدًّا ، ثُمَّ دَفَنَهَا ""","","","","","Book of Prayer"
"1637","عَنْ إِسْرَائِيلَ ، عَنِ الرُّكَيْنِ بْنِ الرَّبِيعِ ، عَنْ أَسْمَاءَ بْنِ الْحَكَمِ الْفَزَارِيِّ , قَالَ : سَأَلْتُ رَجُلا مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  عَنِ الْبُصَاقِ فِي الْمَسْجِدِ , فَقَالَ : هِيَ خَطِيئَةٌ ، وَكَفَّارَتُهَا دَفْنُهَا ""","","","","","Book of Prayer"
"1638","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ , قَالَ :  تَنَخَّمَ رَجُلٌ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، لَيْلا فَجَاءَ بِمِصْبَاحٍ , فَدَفَنَهَا ""","","","","","Book of Prayer"
"1639","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنْ أَنَسٍ , قَالَ :  النُّخَامَةُ فِي الْمَسْجِدِ خَطِيئَةٌ ، وَكَفَّارَتُهَا دَفْنُهَا ""","","","","","Book of Prayer"
"1640","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ , قَالَ :  كَانَ إِذَا تَفَلَ فِي الْمَسْجِدِ أَعْمَقَ لَهَا ، ثُمَّ دَفَنَهَا ""","","","","","Book of Prayer"
"1641","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ , قَالَ : كُنَّا مَعَ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ , فَأَرَادَ أَنْ يَبْصُقَ وَمَا عَنْ يَمِينِهِ فَارِغٌ ،  فَكَرِهِ أَنْ يَبْصُقَ عَنْ يَمِينِهِ وَهُوَ لَيْسَ فِي الصَّلاةِ ""","","","","","Book of Prayer"
"1642","عَنِ الثَّوْرِيِّ ، عَنْ خَالِدٍ الْحَذَّاءِ ، عَنْ أَبِي نَضْرَةَ ، عَنْ عَبْدِ اللَّهِ بْنِ الصَّامِتِ ، عَنْ مُعَاذِ بْنِ جَبَلٍ , قَالَ : كَانَ مَرِيضًا فَبَصَقَ عَنْ يَمِينِهِ ، أَوْ أَرَادَ أَنْ يَبْصُقَ ، فَقَالَ :  مَا بَصَقتُ عَنْ يَمِينِي مُنْذُ أَسْلَمْتُ ""","","","","","Book of Prayer"
"1643","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ نُعَيْمٍ ، أَنَّهُ سَمِعَ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ , يَقُولُ : لابْنِهِ عَبْدِ الْمَلِكِ وَقَدْ بَصَقَ ، عَنْ يَمِينِهِ ، وَهُوَ فِي مَسِيرٍ فَنَهَاهُ ، عَنْ ذَلِكَ وَقَالَ :  إِنَّكَ تُؤْذِي صَاحِبَكَ ، ابْصُقْ عَنْ شِمَالِكَ ""","","","","","Book of Prayer"
"1644","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ عِكْرِمَةَ , قَالَ :  لا تُقَامُ الْحُدُودُ فِي الْمَسَاجِدِ "" , قَالَ : وَلا أَعْلَمُهُ إِلا قَالَ : "" وَلا يُضْرَبُ فِيهَا ، أَيِ الاقْتِصَاصُ ""","","","","","Book of Prayer"
"1645","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ إِنْسَانٌ لِعَطَاءٍ :  أَكَانَ يُنْهَى عَنِ الْجَلْدِ فِي الْمَسْجِدِ ؟ "" , قَالَ : "" نَعَمْ ""","","","","","Book of Prayer"
"1646","عَنْ مَعْمَرٍ ، وَابْنِ عُيَيْنَةَ ، عَنِ ابْنِ شُبْرُمَةَ , قَالَ :  رَأَيْتُ الشَّعْبِيَّ "" يَجْلِدُ يَهُودِيًّا حَدًّا فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1647","عَنْ إِسْرَائِيلَ ، عَنْ عِيسَى بْنِ أَبِي عَزَّةَ , قَالَ : رَأَيْتُ الشَّعْبِيَّ  ضَرَبَ رَجُلا افْتَرَى عَلَى رَجُلٍ فِي الرَّحْبَةِ ، وَلمْ يَضْرِبْهُ فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1648","عَنِ الثَّوْرِيِّ ، عَنْ قَيْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِهَابٍ , قَالَ : أُتِيَ عُمَرُ بِرَجُلٍ فِي شَيْءٍ ، فَقَالَ :  أَخْرِجَاهُ مِنَ الْمَسْجِدِ , فَاضْرِبَاهُ ""","","","","","Book of Prayer"
"1649","عَنِ الثَّوْرِيِّ ، قَالَ : سَمِعْتُهُ أَوْ أَخْبَرَنِي مَنْ سَمِعَهُ يُحَدِّثُ ، عَنْ جَابِرٍ ، عَنْ أَبِي الضُّحَى , قَالَ : سُئِلَ مَرْوَانُ ، عَنِ الضَّرْبِ فِي الْمَسْجِدِ , قَالَ :  إِنَّ لِلْمَسْجِدِ حُرْمَةً ""","","","","","Book of Prayer"
"1650","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَمْرُو بْنُ دِينَارٍ  سَمِعْنَا أَنَّهُ يُنْهَى أَنْ يُضْرَبَ فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1651","أَخْبَرَنِي مَنْ ، سَمِعَ عَمْرَو بْنَ دِينَارٍ يُحَدِّثُ ، عَنْ نَافِعِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ , قَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ تُنْشَدَ الأشْعَارَ ، وَأَنْ يُتَآسَ الْجِرَاحَاتُ ، وَأَنْ تُقَامَ الْحُدُودُ فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1652","أَخْبَرَنَا يَحْيَى بْنُ الْعَلاءِ ، وَمُحَمَّدُ بْنُ مُسْلِمٍ ، عَنْ عَمْرٍو ، عَنْ طَاوُسٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  لا تُقَامُ الْحُدُودُ فِي الْمَسَاجِدِ ""","","","","","Book of Prayer"
"1653","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ عَجْلانَ ، عَنْ نَافِعٍ , قَالَ : كَانَ عُمَرُ بْنُ الْخَطَّابِ , يَقُولُ :  لا تُكْثِرُوا اللَّغَطَ "" يَعْنِي : فِي الْمَسْجِدِ , قَالَ : فَدَخَلَ الْمَسْجِدَ ذَاتَ يَوْمٍ , فَإِذَا هُوَ بِرَجُلَيْنِ قَدِ ارْتَفَعَتْ أَصْوَاتُهُمَا , فَبَادَرَاهُ فَأَدْرَكَ أَحَدَهُمَا فَضَرَبَهُ , وَقَالَ : "" مِمَّنْ أَنْتَ ؟ "" , قَالَ : مِنْ ثَقِيفٍ , قَالَ : "" إِنَّ مَسْجِدَنَا هَذَا لا يُرْفَعُ فِيهِ الصَّوْتُ ""","","","","","Book of Prayer"
"1654","عَنْ عَبْدِ الْقُدُّوسِ , قَالَ : أَخْبَرَنَا نَافِعٌ ، عَنِ ابْنِ عُمَرَ , قَالَ : سَمِعَ عُمَرُ رَجُلا رَفَعَ صَوْتَهُ , فَقَالَ :  مِمَّنْ أَنْتَ ؟ "" , قَالَ : مِنْ ثَقِيفٍ , قَالَ : "" مِنْ أَيِّ الأَرْضِ ؟ "" , قَالَ : مِنْ أَهْلِ الطَّائِفِ , قَالَ : "" أَمَا أَنَّكَ لَوْ أَنَّكَ كُنْتَ مِنْ أَهْلِ بَلَدِنَا هَذَا لأَوْجَعْتُكَ ضَرْبًا ، إِنَّ مَسْجِدَنَا هَذَا لا يُرْفَعُ فِيهِ الصَّوْتُ ""","","","","","Book of Prayer"
"1655","عَنِ ابْنِ جُرَيْجٍ , قَالَ : بَلَغَنِي عَنْ نَافِعٍ ، أَنَّ عُمَرَ ، كَانَ إِذَا خَرَجَ إِلَى الصَّلاةِ , نَادَى فِي الْمَسْجِدِ إِيَّاكُمْ وَاللَّغَطَ , وَإِنَّهُ كَانَ يَقُولُ :  ارْتَفِعُوا فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1656","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  الصِّيَاحُ فِي الْمَسْجِدِ , قَالَ : "" أَمَّا قَوْلُ : لَيْسَ فِيهِ بَأْسٌ ، وَأَمَّا قَوْلُ فَحَشَ ، أَوْ سَبَّ فَلا ""","","","","","Book of Prayer"
"1657","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَاصِمٍ الأَحْوَلِ ، عَنِ ابْنِ سِيرِينَ , قَالَ : سَمِعَ أُبَيُّ بْنُ كَعْبٍ ،  رَجُلا يَعْتَرِي ضَالَّةً فِي الْمَسْجِدِ , قَالَ : "" فَعَضَّهُ "" ، قَالَ أَبَا الْمُنْذِرِ : مَا كُنْتَ فَاحِشًا , قَالَ : "" إِنَّا أُمِرْنَا بِذَلِكَ ""","","","","","Book of Prayer"
"1658","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : أَنْشَدَ حَسَّانُ بْنُ ثَابِتٍ فِي الْمَسْجِدِ ، فَمَرَّ بِهِ عُمَرُ فَلَحَظَهُ ، فَقَالَ حَسَّانُ :  وَاللَّهِ لَقَدْ أَنْشَدْتُ فِيهِ مَنْ هُوَ خَيْرٌ مِنْكَ ، فَخَشِيَ أَنْ يَرْمِيَهُ بِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَجَازَ ، وَتَرَكَهُ ""","","","","","Book of Prayer"
"1659","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنِ ابْنِ الْمُنْكَدِرِ ، عَنْ أُسَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ شَاعِرًا جَاءَ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ فِي الْمَسْجِدِ , فَقَالَ : أُنْشِدُكَ يَا رَسُولَ اللَّهِ ؟ , قَالَ : لا , قَالَ : بَلَى , فَأْذَنْ لِي ، قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : فَاخْرُجْ مِنَ الْمَسْجِدِ ، فَخَرَجَ مِنَ الْمَسْجِدِ , قَالَ : فَأَعْطَاهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثَوْبًا , وَقَالَ : هَذَا بَدَلُ مَا مَدَحْتَ بِهِ رَبَّكَ","","","","","Book of Prayer"
"1660","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ :  يُكْرَهُ أَنْ يُتَسَوَّكَ فِي الْمَسْجِدِ ، وَأَنْ يُقَلَّمَ فِيهِ الأَظْفَارُ ""","","","","","Book of Prayer"
"1661","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ إِنْسَانٌ لِعَطَاءٍ :  أَتَخَلَّلُ فِي الْمَسْجِدِ ؟ فَفَزِعَ , وَقَالَ : "" أَفِي الصَّلاةِ ؟ "" , قَالَ الآخَرُ : لا , قَالَ : "" نَعَمْ ، إِنْ شَاءَ ""","","","","","Book of Prayer"
"1662","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّهُ سَمِعَ طَاوُسًا , يَقُولُ : نَشَدَ رَجُلٌ ضَالَّتَهُ فِي الْمَسْجِدِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  لا وَجَدَ ضَالَّتَهُ ""","","","","","Book of Prayer"
"1663","عَنِ الثَّوْرِيِّ ، عَنْ عَلْقَمَةَ بْنِ مَرْثَدٍ ، عَنْ سُلَيْمَانَ بْنِ بُرَيْدَةَ ، عَنْ أَبِيهِ , قَالَ : سَمِعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , رَجُلا يَنْشُدُ ضَالَّةً جَمَلا لَهُ أَحْمَرَ فِي الْمَسْجِدِ , يَقُولُ : مَنْ دَعَا إِلَى الْجَمَلِ الأحْمَرِ ؟ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  لا وَجَدْتَ , إِنَّمَا بُنِيَتِ الْمَسَاجِدُ لِمَا بُنِيَتْ لَهُ ""","","","","","Book of Prayer"
"1664","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ مُصْعَبِ بْنِ مُحَمَّدٍ ، عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدٍ ، قَالَ : سَمِعَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , رَجُلا يَنْشُدُ ضَالَّةً فِي الْمَسْجِدِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَيُّهَا النَّاشِدُ ! غَيْرُكَ الْوَاجِدُ لَيْسَ لِهَذَا بُنِيَتِ الْمَسَاجِدُ ""","","","","","Book of Prayer"
"1665","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْكَدِرِ , قَالَ : سَمِعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , رَجُلا يَنْشُدُ ضَالَّةً فِي الْمَسْجِدِ ، فَقَالَ :  أَيُّهَا النَّاشِدُ ! غَيْرُكَ الْوَاجِدُ ""","","","","","Book of Prayer"
"1666","عَنْ مَعْمَرٍ ، عَنْ عَاصِمِ بْنِ سُلَيْمَانَ ، عَنِ ابْنِ سِيرِينَ ، أَوْ غَيْرِهِ , قَالَ : سَمِعَ ابْنُ مَسْعُودٍ ،  رَجُلا يَنْشُدُ ضَالَّةً فِي الْمَسْجِدِ , فَأَمْسَكَهُ وَانْتَهَرَهُ , وَقَالَ : "" قَدْ نُهُيِنَا عَنْ هَذَا ""","","","","","Book of Prayer"
"1667","عَنِ الثَّوْرِيِّ ، عَنْ يَزِيدَ بْنِ خُصَيْفَةَ , قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ , يَقُولُ : كَانَ يُقَالُ : إِذَا نَشَدَ النَّاشِدُ الضَّالَّةَ فِي الْمَسْجِدِ , قَالَ :  لا رَدَّهَا اللَّهُ عَلَيْكَ , فَإِذَا اشْتَرَى أَوْ بَاعَ فِي الْمَسْجِدِ , قِيلَ : لا أَرْبَحَ اللَّهُ تِجَارَتَكَ ""","","","","","Book of Prayer"
"1668","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ عَبْدِ رَبِّهِ بْنِ عَبْدِ اللَّهِ ، عَنْ مَكْحُولٍ ، عَنْ مُعَاذِ بْنِ جَبَلٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  جَنِّبُوا مَسَاجِدَكُمْ مَجَانِينَكُمْ ، وَصِبْيَانَكُمْ ، وَرَفْعَ أَصْوَاتِكُمْ ، وَسَلَّ سُيُوفِكُمْ ، وَبَيْعَكُمْ ، وَشِرَاءَكُمْ ، وَإِقَامَةَ حُدُودِكُمْ ، وَخُصُوَمَتَكُمْ ، وَجَمِّرُوهَا يَوْمَ جُمَعِكُمْ ، وَاجْعَلُوا مَطَاهِرَكُمْ عَلَى أَبْوَابِهَا ""","","","","","Book of Prayer"
"1669","عَنْ عَبْدِ الْقُدُّوسِ بْنِ حَبِيبٍ ، قَالَ : سَمِعْتُ مَكْحُولا , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  جَنِّبُوا مَسَاجِدَكُمُ الصِّبْيَانَ ، وَالْمَجَانِينَ ""","","","","","Book of Prayer"
"1670","عَنْ عَبْدِ اللَّهِ بْنِ مُحَرَّرٍ ، أَنَّ يَزِيدَ بْنِ الأَصَمِّ أَخْبَرَهُ ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  جَنِّبُوا مَسَاجِدَكُمُ الصِّبْيَانَ ، وَالْمَجَانِينَ "" , عَنِ الثَّوْرِيِّ ، عَنْ ثَوْرٍ ، عَنْ رَجُلَيْنِ بَيْنَهُ , وَبَيْنَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , مِثْلُ حَدِيثِ ابْنِ مُحَرَّرٍ""","","","","","Book of Prayer"
"1671","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْكَرِيمِ بْنِ مَالِكٍ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ :  لَوْ كَانَ إِلَيَّ مِنْ أَمْرِ النَّاسِ شَيْءٌ , مَا تَرَكْتُ اثْنَيْنِ يَخْتَصِمَانِ فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1672","عَنْ مَعْمَرٍ , قَالَ أَخْبَرَنِي الْحَكَمُ بْنُ عُتَيْبَةَ ، أَنَّهُ رَأَى شُرَيْحًا  يَقْضِي فِي الْمَسْجِدِ "" ، وَرَأَيْتُ أَنَا ابْنُ أَبِي لَيْلَى "" يَقْضِي فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1673","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ إِنْسَانٌ لِعَطَاءٍ : أَكَانَ يُنْهَى عَنْ سَلِّ السَّيْفِ فِي الْمَسْجِدِ ؟ , فَقَالَ :  نَعَمْ ، وَكَانَ يُنْهَى أَنْ يُمَرَّ بَالنَّبْلِ فِي الْمَسْجِدِ , إِلا مُمْسَكًا عَلَى نِصَالِهَا ""","","","","","Book of Prayer"
"1674","عَنِ ابْنِ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى , قَالَ : سُئِلَ جَابِرُ بْنُ عَبْدِ اللَّهِ , عَنْ سَلِّ السَّيْفِ فِي الْمَسْجِدِ ، فَقَالَ : قَدْ كُنَّا نَكْرَهُ ذَلِكَ ، وَقَدْ كَانَ رَجُلٌ يَتَصَدَّقُ بَالنَّبْلِ فِي الْمَسْجِدِ , فَأَمَرَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  لا يَمُرُّ بِهَا فِي الْمَسْجِدِ , إِلا وَهُوَ قَابِضٌ عَلَى نِصَالِهَا جَمِيعًا ""","","","","","Book of Prayer"
"1675","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ أَسْلَمَ ، عَنِ ابْنِ أَبْزَى , قَالَ : كَانَ  يُكْرَهُ سَلُّ السَّيْفِ فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1676","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ لَيْثٍ ، عَنْ أَبِي بُرْدَةَ ، عَنْ أَبِي مُوسَى ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِذَا مَرَرْتُمْ بَالسِّهَامِ فِي أَسْوَاقِ الْمُسْلِمِينَ أَوْ مَسَاجِدِهِمْ , فَأَمْسِكُوا بَالنِّصَالِ لا تَجْرَحُوا بِهَا أَحَدًا ""","","","","","Book of Prayer"
"1677","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ : سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَكَلَ مِنْ هَذِهِ الشَّجَرَةِ يُرِيدُ الثُّومَ ، فَلا يَغْشَى مَسْجِدِي هَذَا "" قَالَ : أَرَاهُ يَرَى النَّيَّةَ الَّتِي لَمْ تُطْبَخْ""","","","","","Book of Prayer"
"1678","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أَرَأَيْتَ الَّذِي ذَكَرْتَ أَنَّهُ يَنْهَى عَنْهُ فِي الْمَسْجِدِ , أَفِي الْمَسَاجِدِ كُلِّهَا ؟ أَمْ فِي الْمَسْجِدِ الْحَرَامِ خَاصَّةً دُونَهَا ؟ , قَالَ : "" بَلْ فِي الْمَسَاجِدِ كُلِّهَا ""","","","","","Book of Prayer"
"1679","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ، عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَكَلَ مِنْ هَذِهِ الشَّجَرَةِ , يَعْنِي الثُّومَ , فَلا يُؤْذِينَا فِي مَسْجِدِنَا ""","","","","","Book of Prayer"
"1680","عَنْ مَعْمَرٍ ، عَنْ أَبِي هَارُونَ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَكَلَ هَذِهِ الشَّجَرَةَ , يَعْنِي الثُّومَ , فَلا يَقْرَبَنَّ مَسْجِدِي هَذَا , وَلا يَأْتِينَا يَمْسَحُ جَبْهَتَهُ "" , قَالَ : قُلْتُ : يَا أَبَا سَعِيدٍ : أَحَرَامٌ هِيَ ؟ , قَالَ : "" لا ، إِنَّمَا كَرِهَهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , مِنْ أَجْلِ رِيحِهَا ""","","","","","Book of Prayer"
"1681","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَابِسٍ ، عَنِ الْعَلاءِ بْنِ عَبْدِ اللَّهِ بْنِ خَبَّابٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  مَنْ أَكَلَ هَذِهِ الشَّجَرَةَ الْخَبِيثَةَ , فَلا يَقْرَبَنَّ مَسْجِدَنَا هَذَا ""","","","","","Book of Prayer"
"1682","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ صَفْوَانَ بْنِ سُلَيْمٍ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَكَلَ هَذِهِ الشَّجَرَةَ الْخَبِيثَةَ , فَلا يُؤْذِينَا فِي مَسْجِدِنَا , وَلْيَقْعُدْ فِي بَيْتِهِ ""","","","","","Book of Prayer"
"1683","قَالَ ابْنُ عُيَيْنَةَ : فَسَمِعْتُ أَبَا الزُّبَيْرِ يُحَدِّثُ ، عَنْ جَابِرٍ , قَالَ :  مَا كَانَ الثُّومُ بِأَرْضِنَا إِذْ ذَاكَ ""","","","","","Book of Prayer"
"1684","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ :  إِذَا طَيَّنْتَ مَسْجِدًا فِيهِ مَدَرٌ بِرَوْثٍ , فَلا تُصَلِّ فِيهِ حَتَّى تَغْسِلَهُ , إِذَا كَانَ طَاهِرًا لَهَا ""","","","","","Book of Prayer"
"1685","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ يُوسُفَ بْنِ مَاهَكَ ، أَنَّ عُبَيْدَ بْنَ عُمَيْرٍ ،  رَأَى عَلَى ابْنِ عُمَرَ "" قَمْلَةً فِي الْمَسْجِدِ فَأَخَذَهَا فَدَفَنَهَا ، وَابْنُ عُمَرَ يَنظُرُ إِلَيْهِ وَلمْ يُنْكِرْ عَلَيْهِ ذَلِكَ ""","","","","","Book of Prayer"
"1686","عَنْ مَعْمَرٍ ، فَحَدَّثْتُ بِهِ يَحْيَى بْنَ أَبِي كَثِيرٍ ، فَقَالَ : يَرْحَمُكَ اللَّهُ , أَتَرَى كُلَّ حَدِيثِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَدْ بَلَغَ ابْنَ عُمَرَ ؟ ، ثُمَّ قَالَ يَحْيَى : بَلَغَنِي ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  إِذَا رَأَى أَحَدُكُمُ الْقَمْلَةَ فَلا يَقْتُلْهَا فِي الْمَسْجِدِ ، وَلَكِنْ لِيَصُرَّهَا فِي ثَوْبِهِ , فَإِذَا خَرَجَ فَلْيَقْتُلْهَا ""","","","","","Book of Prayer"
"1687","عَنْ مَعْمَرٍ ، عَنْ أَبِي غَالِبٍ ، أَنَّ أَبَا أُمَامَةَ  رَأَى عَلَى ثِيَابِهِ قَمْلَةً ، وَهُوَ فِي الْمَسْجِدِ فَأَخَذَهَا فَدَفَنَهَا فِي الْمَسْجِدِ , وَأَبُو غَالِبٍ يَنْظُرُ إِلَيْهِ ""","","","","","Book of Prayer"
"1688","عَنِ الثَّوْرِيِّ ، عَنْ فِطْرٍ ، عَنْ شِمْرِ بْنِ عَطِيَّةَ ، عَنْ شَهْرِ بْنِ حَوْشَبٍ ، عَنْ أَبِي أُمَامَةَ أَنَّهُ كَانَ  يَتَفَلَّى فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1689","عَنِ الثَّوْرِيِّ ، عَنْ مُسْلِمٍ ، عَنْ زَاذَانَ ، عَنِ الرَّبِيعِ بْنِ خُثَيْمٍ ، أَنَّ ابْنَ مَسْعُودٍ :  أَخَذَ قَمْلَةً فَدَفَنَهَا فِي الْمَسْجِدِ ، ثُمَّ قَالَ : ""  أَلَمْ نَجْعَلِ الأَرْضَ كِفَاتًا { 25 } أَحْيَاءً وَأَمْوَاتًا { 26 } ""","","","","","Book of Prayer"
"1690","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ :  كَانُوا لا يَرَوْنَ بَأْسًا بِدَفْنِ الْقَمْلَةِ فِي الأَرْضِ , وَهُوَ فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"1691","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ عَمَّنْ ، رَأَى أَبَا أيُّوَبَ الأَنْصَارِيَّ  يَقْتُلُ قَمْلَةً فِي الْمَسْجِدِ بَيْنَ حَصَاتَيْنِ ""","","","","","Book of Prayer"
"1692","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ صَالِحٍ ، مَوْلَى التَّوْأَمَةِ أَنَّهُ : رَأَى أَبَا هُرَيْرَةَ  يَدْفِنُ الْقَمْلَةَ فِي الْمَسْجِدِ ، وَيَقُولُ : "" النُّخَامَةُ شَرٌّ مِنْهَا ""","","","","","Book of Prayer"
"1693","عَنِ الثَّوْرِيِّ ، عَنْ حُصَيْنٍ , قَالَ : سَأَلْتُ إِبْرَاهِيمَ ، عَنِ  الرَّجُلِ يَقْتُلُ الْقَمْلَةَ فِي الصَّلاةِ ؟ "" , قَالَ : "" لَيْسَ بِشَيْءٍ ""","","","","","Book of Prayer"
"1694","عَنْ ثَوْرِ بْنِ يَزِيدَ ، عَنْ رَاشِدِ بْنِ سَعْدٍ ، عَنْ مَالِكِ ابْنِ يُخَامِرَ , قَالَ : رَأَيْتُ مُعَاذَ بْنَ جَبَلٍ ،  يَقْتُلُ الْقَمْلَةَ ، وَالْبَرَاغِيثَ فِي الصَّلاةِ ""","","","","","Book of Prayer"
"1695","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنِ الْحَسَنِ , قَالَ :  لَيْسَ فِي قَتْلِ الْقَمْلَةِ وُضُوءٌ "" , قَالَ : "" وَكَانَ ابْنُ سِيرِينَ يَرَى الْوُضُوءَ ""","","","","","Book of Prayer"
"1696","أَخْبَرَنَا مَعْمَرٌ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ ضَمْضَمٍ ، عَنْ أَبِي هُرَيْرَةَ , قَالَ :  أَمَرَنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ نَقْتُلَ الأَسْوَدَيْنِ فِي الصَّلاةِ الْحَيَّةَ ، وَالْعَقْرَبَ ""","","","","","Book of Prayer"
"1697","عَنْ إِسْمَاعِيلَ بْنِ مُسْلِمٍ ، عَنِ الْحَسَنِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  اقْتُلُوا الْعَقْرَبَ ، وَالْحَيَّةَ عَلَى كُلِّ حَالٍ ""","","","","","Book of Prayer"
"1698","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ :  سُئِلَ عَنِ الرَّجُلِ يَقْتُلُ الْعَقْرَبَ فِي الصَّلاةِ ؟ , قَالَ : "" إِنَّ فِي الصَّلاةِ لَشُغْلا ""","","","","","Book of Prayer"
"1699","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنِ الْحَسَنِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  لا تُزَاحِمُوا الأَخْبَثَيْنِ فِي الصَّلاةِ الْغَائِطَ ، وَالْبَوْلَ ""","","","","","Book of Prayer"
"1700","عَنْ هِشَامِ بْنِ حَسَّانَ ، أَنَّهُ سَمِعَ عِكْرِمَةَ يُحَدِّثُ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ :  لأَنْ أَحْمِلَهُ فِي نَاحِيَةِ رِدَائِي , أَحَبُّ إِلَيَّ مِنْ أَنْ أُزَاحِمَ الْغَائِطَ ، وَالْبَوْلَ ""","","","","","Book of Prayer"
"1701","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ , قَالَ : كُنَّا مَعَ عَبْدِ اللَّهِ بْنِ الأَرْقَمِ الزُّهْرِيِّ , فَأُقِيمَتِ الصَّلاةُ ، ثُمَّ ذَهَبَ الْغَائِطُ ، فَقِيلَ لَهُ : مَا هَذَا ؟ , فَقَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا أُقِيمتِ الصَّلاةُ وَأَرَادَ أَحَدُكُمُ الْغَائِطَ , فَلْيَبْدَأْ بِالْغَائِطِ ""","","","","","Book of Prayer"
"1702","عَنِ الثَّوْرِيِّ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ عَبْدِ اللَّهِ بْنِ الأَرْقَمِ , قَالَ : كُنَا مَعَهُ فِي سَفَرٍ ، وَكَانَ يَؤُمُّهُمْ , فَلَمَّا حَضَرَتِ الصَّلاةُ , قَالَ : لِيَؤُمَّكُمْ بَعْضُكُمْ ، فَإِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا حَضَرَتِ الصَّلاةُ ، وَأَرَادَ أَحَدُكُمُ الْحَاجَةَ فَلْيَبْدَأْ بِالْحَاجَةِ ""","","","","","Book of Prayer"
"1703","عَنِ ابْنِ جُرَيْجٍ ، عَنْ أَيُّوبَ بْنِ مُوسَى ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، قَالَ : خَرَجْنَا فِي حَجٍّ أَوْ عُمْرَةٍ , مَعَ عَبْدِ اللَّهِ بْنِ الأَرْقَمِ الزُّهْرِيِّ , فَأَقَامَ الصَّلاةَ ، ثُمَّ قَالَ : صَلُّوا وَذَهَبَ لِحَاجَتِهِ ، فَلَمَّا رَجَعَ , قَالَ : إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا أُقِيمَتِ الصَّلاةُ ، وَأَرَادَ أَحَدُكُمُ الْغَائِطَ فَلْيَبْدَأْ بِالْغَائِطِ ""","","","","","Book of Prayer"
"1704","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ لَيْثٍ ، عَنْ مُجَاهِدٍ , قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ :  لا تَدْفَعُوا الأَخْبَثَيْنِ فِي الصَّلاةِ ، الْغَائِطَ ، وَالْبَوْلَ ""","","","","","Book of Prayer"
"1705","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ لَيْثٍ ، عَنْ مُجَاهِدٍ ، عَنْ حُذَيْفَةَ , قَالَ :  إِنِّي لأَتَّقِي أَحَدَهُمَا كَمَا أَتَّقِي الآخَرَ الْغَائِطَ ، وَالْبَوْلَ ""","","","","","Book of Prayer"
"1706","عَنِ الثَّوْرِيِّ ، عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ، عَنْ طَاوُسٍ , قَالَ :  إِنَّا لَنَصُرُّهُ صَرًّا ""","","","","","Book of Prayer"
"1707","عَنِ الثَّوْرِيِّ ، عَنِ الْحَسَنِ بْنِ عَبْدِ اللَّهِ ، عَنْ إِبْرَاهِيمَ , قَالَ :  مَا لَمْ يُعْجِلْكَ الْغَائِطُ ، وَالْبَوْلُ فِي الصَّلاةِ فَلا بَأْسَ ""","","","","","Book of Prayer"
"1708","عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ النَّخَعِيِّ أَنَّهُ كَانَ  لا يَرَى بِذَلِكَ بَأْسًا مَا لَمْ يَخَفْ أَنْ يَشْغَلَهُ ، عَنْ صَلاتِهِ أَنْ يَسْبِقَهُ ""","","","","","Book of Prayer"
"1709","عَنْ أَيُّوبَ ، عَنْ حُمَيْدِ بْنِ هِلالٍ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ :  لا يُصَلِّيَنَّ أَحَدُكُمْ ، وَهُوَ يُدَافِعُ بَوْلا ، وَطَوْفًا "" يَعْنِي : الْغَائِطَ""","","","","","Book of Prayer"
"1710","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ :  فُرِضَتِ الصَّلاةُ خَمْسِينَ ، ثُمَّ نُقِصَتْ حَتَّى جُعِلَتْ خَمْسًا ، ثُمَّ نُودِيَ : يَا مُحَمَّدُ ، إِنَّهُ لا يُبَدَّلُ الْقَوْلُ لَدَيَّ ، وَإِنَّ لَكَ بِهَذِهِ الْخَمْسِ خَمْسِينَ ""","","","","","Book of Prayer"
"1711","عَنْ مَعْمَرٍ ، عَنْ أَبِي هَارُونَ الْعَبْدِيِّ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ , قَالَ :  فُرِضَتْ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : الصَّلاةُ لَيْلَةَ أُسْرِيَ بِهِ الصَّلاةُ خَمْسِينَ ، ثُمَّ نُقِصَتْ حَتَّى جُعِلَتْ خَمْسًا ، فَقَالَ اللَّهُ : فَإِنَّ لَكَ بِالْخَمْسِ خَمْسِينَ الْحَسَنَةُ بِعَشَرَةِ أَمْثَالِهَا ""","","","","","Book of Prayer"
"1712","عَنْ مَعْمَرٍ ، عَمَّنْ ، سَمِعَ الْحَسَنَ , يَذْكُرُ أَنَّهَا  فُرِضَتْ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَيْلَةَ أُسْرِيَ بِهِ خَمْسُونَ ، ثُمَّ رُدَّتْ إِلَى خَمْسٍ "" ، قَالَ الْحَسَنُ : "" فَنُودِيَ أَنِّي قَدْ أَمْضَيْتُ فَرِيضَتِي ، وَخَفَّفْتُ عَنْ عِبَادِي ، وَأَنَّ لَكَ بِهَذِهِ الْخَمْسِ خَمْسِينَ ""","","","","","Book of Prayer"
"1713","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ قُرَّةَ بْنِ خَالِدٍ , قَالَ : سَمِعْتُ الْحَسَنَ , يَقُولُ :   وَأَقِمِ الصَّلاةَ طَرَفَيِ النَّهَارِ حَتَّى خَتَمَ الآيَةَ , قَالَ : "" فَكَانَتْ أَوَّلُ صَلاةٍ صَلاهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الظُّهْرَ , فَأَتَاهُ جِبْرِيلُ , فَقَالَ :  وَإِنَّا لَنَحْنُ الصَّافُّونَ ،  وَإِنَّا لَنَحْنُ الْمُسَبِّحُونَ قَالَ : فَقَامَ جَبْرَئِيلُ بَيْنَ يَدَيْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَلْفَهُ ، ثُمَّ النَّاسُ خَلْفَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَالنِّسَاءُ خَلْفَ الرِّجَالِ ، قَالَ : فَصَلَّى بِهِمِ الظُّهْرَ أَيْ أَرْبَعًا ، حَتَّى إِذَا كَانَ الْعَصْرُ قَامَ جِبْرِيلُ فَفَعَلَ مِثْلَهَا ، ثُمَّ جَاءَ جِبْرِيلُ حِينَ غَابَتِ الشَّمْسُ فَصَلَّى بِهِمْ ثَلاثًا يَقْرَأُ فِي الرَّكْعَتَيْنِ الأُولَيَيْنِ يَجْهَرُ فِيهِمَا ، وَلمْ يُسْمَعْ فِي الثَّالِثَةِ "" ، قَالَ الْحَسَنُ : وَهِيَ وِتْرُ صَلاةِ النَّهَارِ , قَالَ : "" حَتَّى إِذَا كَانَ عِنْدَ الْعِشَاءِ ، وَغَابَ الشَّفَقُ وَأَعْتَمَ جَاءَهُ جِبْرِيلُ , فَقَامَ بَيْنَ يَدَيْهِ فَصَلَّى بِالنَّاسِ أَرْبَعَ رَكَعَاتٍ ، يَجْهَرُ بَالْقِرَاءَةِ فِي الرَّكْعَتَيْنِ ، حَتَّى إِذَا أَصْبَحَ لَيْلَتَهُ ، فَصَلَّى بِهِ وَالنَّاسُ مَعَهُ كَنَحْوِ مَا فَعَلَ ، فَصَلَّى بِهِمْ رَكْعَتَيْنِ ، يَقْرَأُ فِيهِمَا وَيُطِيلُ الْقِرَاءَةَ ، فَلَمْ يَمُتِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَتَّى حَدَّ لِلنَّاسِ صَلاتَهُمْ "" ، ثُمَّ ذَكَرَ الْحَسَنُ الْجُمُعَةَ , قَالَ : "" فَصَلَّى بِهِمْ رَكْعَتَيْنِ , وَوَضَعَ عَنْهُمْ رَكْعَتَيْنِ لاجْتِمَاعِ النَّاسِ يَوْمَئِذٍ وَلِلخُطْبَةِ "" ، قَالَ اللَّهُ :  وَأَقِمِ الصَّلاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ ذَلِكَ ذِكْرَى لِلذَّاكِرِينَ ، وَذَكَرَ طَرَفَيِ النَّهَارِ : مِنْ صَلاةِ الْغَدَاةِ إِلَى صَلاةِ الْفَجْرِ ،  وَزُلَفًا مِنَ اللَّيْلِ : الْمَغْرِبَ وَالْعِشَاءَ ""","","","","","Book of Prayer"
"1714","عَنِ الثَّوْرِيِّ ، عَنْ عَاصِمٍ ، عَنْ أَبِي رَزِينٍ , قَالَ : خَاصَمَ نَافِعُ بْنُ الأَزْرَقِ ابْنِ الْعَبَّاسِ ، فَقَالَ : هَلْ تَجِدِ الصَّلَوَاتِ الْخَمْسَ فِي الْقُرْآنِ ؟ , فَقَالَ :  نَعَمْ ، ثُمَّ قَرَأَ عَلَيْهِ :  فَسُبْحَانَ اللَّهِ حِينَ تُمْسُونَ وَحِينَ تُصْبِحُونَ , الْمَغْرِبُ وَالْفَجْرُ ،  وَعَشِيًّا الْعَصْرُ ,  وَحِينَ تُظْهِرُونَ الظُّهْرُ , قَالَ : وَمِنْ بَعْدِ صَلاةِ الْعِشَاءِ""","","","","","Book of Prayer"
"1715","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ نَافِعُ بْنُ جُبَيْرٍ ، وَغَيْرُهُ : لَمَّا أَصْبَحَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنَ اللَّيْلَةِ الَّتِي أُسْرِيَ بِهِ فِيهَا لَمْ يَرُعْهُ إِلا جِبْرِيلُ يَتَدَلَّى حِينَ زَاغَتِ الشَّمْسُ ، وَلِذَلِكَ سُمِّيَتِ الأُولَى ، فَأَمَرَ فَصِيحَ فِي النَّاسِ : الصَّلاةُ جَامِعَةٌ ، فَاجْتَمَعُوا , فَصَلَّى جِبْرِيلُ بَالنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَصَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِلنَّاسِ طَوَّلَ الرَّكْعَتَيْنِ الأُولَيَيْنِ ، ثُمَّ قَصَّرَ الْبَاقِيَتَيْنِ ، ثُمَّ سَلَّمَ جِبْرِيلُ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَسَلَّمَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى النَّاسِ ، ثُمَّ فِي الْعَصْرِ عَلَى مِثْلِ ذَلِكَ ، فَفَعَلُوا كَمَا فَعَلُوا فِي الظُّهْرِ ، ثُمَّ نَزَلَ فِي أَوَّلِ اللَّيْلِ فَصِيحَ : الصَّلاةُ جَامِعَةٌ ، فَصَلَّى جِبْرِيلُ بَالنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَصَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَرَأَ فِي الأُولَيَيْنِ وَطَوَّلَ وَجَهَرَ ، وَقَصَّرَ فِي الْبَاقِيَتَيْنِ ، ثُمَّ سَلَّمَ جِبْرِيلُ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ سَلَّمَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى النَّاسِ","","","","","Book of Prayer"
"1716","أَخْبَرَنَا أَبُو سَعِيدٍ أَحْمَدُ بْنُ مُحَمَّدِ بْنِ زِيَادِ بْنِ بِشْرٍ الْعُبْرِيُّ الْبَصْرِيُّ , قَالَ : حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ عَبَّادٍ الدَّبَرِيُّ ، قَالَ : قَرَأْنَا عَلَى عَبْدِ الرَّزَّاقِ بْنِ هَمَّامٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : كَانَ الْمُسْلِمُونَ يَهُمُّهُمْ شَيْءٌ يَجْمَعُونَ بِهِ لِصَلاتِهِمْ ، فَقَالَ : بَعْضُهُمْ نَاقُوسٌ ، وَقَالَ : بَعْضُهُمْ بُوقٌ ، فَأُرِيَ عَبْدُ اللَّهِ بْنُ زَيْدٍ الأَنْصَارِيُّ فِي الْمَنَامِ أَنَّ رَجُلا مَرَّ بِهِ مَعَهُ نَاقُوسٌ , فَقَالَ لَهُ عَبْدُ اللَّهِ : تَبِيعُ هَذَا ؟ , فَقَالَ الرَّجُلُ : وَمَا تَصْنَعُ بِهِ ؟ , قَالَ : نَضْرِبُ بِهِ لِصَلاتِنَا , قَالَ : أَفَلا أَدُلُّكَ عَلَى خَيْرٍ ؟ , قَالَ : بَلَى ! قَالَ : تَقُولُ : اللَّهُ أَكْبَرُ ، اللَّهُ أَكْبَرُ ، أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ ، أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ أَشْهَدُ ، أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ ، أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ ، حَيَّ عَلَى الصَّلاةِ ، حَيَّ عَلَى الصَّلاةِ ، حَيَّ عَلَى الْفَلاحِ ، حَيَّ عَلَى الْفَلاحِ ، اللَّهُ أَكْبَرُ ، اللَّهُ أَكْبَرُ ، لا إِلَهَ إِلا اللَّهُ  , قَالَ : وَرَأَى عُمَرُ بْنُ الْخَطَّابِ فِي مَنَامِهِ مِثْلَ ذَلِكَ ، فَلَمَّا صَلَّى عَبْدُ اللَّهِ الصُّبْحَ غَدَا إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِيُخْبِرَهُ ، وَغَدَا عُمَرُ فَوَجَدَ الأَنْصَارِيَّ قَدْ سَبَقَهُ ، وَوَجَدَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" قَدْ أَمَرَ بِلالا بِالأَذَانِ ""","","","","","Book of Prayer"
"1717","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ ، سَمِعْتُ عُبَيْدَ بْنَ عُمَيْرٍ , يَقُولُ : إِيتَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابُهُ كَيْفَ يَجْعَلُونَ شَيْئًا إِذَا أَرَادُوا جَمْعَ الصَّلاةِ اجْتَمَعُوا لَهَا , فَائْتَمَرُوا بِالنَّاقُوسِ , قَالَ : فَبَيْنَا عُمَرُ بْنُ الْخَطَّابِ يُرِيدُ أَنْ يَشْتَرِيَ خَشَبَتَيْنِ لِلنَّاقُوسِ ، إِذْ رَأَى فِي الْمَنَامِ أَنْ لا تَجْعَلُوا النَّاقُوسَ ، بَلْ أَذِّنُوا بِالصَّلاةِ , قَالَ : فَذَهَبَ عُمَرُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِيُخْبِرَهُ بَالَّذِي رَأَى ، وَقَدْ جَاءَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْوَحْيُ بِذَلِكَ ، فَمَا رَاعَ عُمَرَ ، إِلا بِلالٌ يُؤَذِّنُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  قَدْ سَبَقَكَ بِذَلِكَ الْوَحْيُ "" ، حِينَ أَخْبَرَهُ بِذَلِكَ عُمَرُ""","","","","","Book of Prayer"
"1718","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ ، أَنَّ ابْنَ عُمَرَ ، كَانَ يَقُولُ : كَانَ الْمُسْلِمُونَ حِينَ قَدِمُوا الْمَدِينَةَ يَجْتَمِعُونَ فَيَتَحَيَّنُونَ الصَّلاةَ لَيْسَ يُنَادِي بِهَا أَحَدٌ فَتَكَلَّمُوا يَوْمًا فِي ذَلِكَ ، فَقَالَ بَعْضُهُمْ لِبَعْضٍ : اتَّخِذُوا نَاقُوسًا مِثْلَ نَاقُوسِ النَّصَارَى ، وَقَالَ بَعْضُهُمْ : بَلْ بُوقًا مِثْلَ بُوقِ الْيَهُودِ ، فَقَالَ عُمَرُ : أَوَلا تَبْعَثُونَ رَجُلا يُنَادِي بِالصَّلاةِ ؟ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  يَا بِلالُ ، قُمْ فَأَذِّنْ بِالصَّلاةِ ""","","","","","Book of Prayer"
"1719","عَنْ عُمَرَ بْنِ ذَرٍّ , قَالَ : سَمِعْتُ إِبْرَاهِيمَ النَّخَعِيَّ , يَقُولُ :  آخِرُ الأَذَانِ اللَّهُ أَكْبَرُ , اللَّهُ أَكْبَرُ , لا إِلَهَ إِلا اللَّهُ ""","","","","","Book of Prayer"
"1720","عَنْ مَعْمَرٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ أَنَّهُ :  كَانَ يَقُولُ : فِي آخِرِ أَذَانِ بِلالٍ "" اللَّهُ أَكْبَرُ , اللَّهُ أَكْبَرُ , لا إِلَهَ إِلا اللَّهُ ""","","","","","Book of Prayer"
"1721","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي عُثْمَانُ مَوْلاهُمْ ، عَنْ أَبِيهِ الشَّيْخِ ، مَوْلَى أَبِي مَحْذُورَةَ ، وَأُمِّ عَبْدِ الْمَلِكِ بْنِ أَبِي مَحْذُورَةَ , قَالَ : قَالَ : خَرَجْتُ فِي عَشَرَةِ فِتْيَانٍ مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى حُنَيْنٍ وَهُوَ أَبْغَضُ النَّاسِ إِلَيْنَا ، فَأَذَّنُوا وَقُمْنَا نُؤَذِّنُ نَسْتَهْزِئُ بِهِمْ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِيتُونِي بِهَؤُلاءِ الْفِتْيَانِ ؟ "" , فَقَالَ : "" أَذِّنُوا "" ، فَأَذَّنُوا وَكُنْتُ آخِرَهُمْ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" نِعْمَ ، هَذَا الَّذِي سَمِعْتُ صَوْتَهُ , اذْهَبْ فَأَذِّنْ لأَهْلِ مَكَّةَ وَقُلْ لِعَتَّابِ بْنِ أُسَيْدٍ : أَمَرَنِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ أُأَذِّنَ لأَهْلِ مَكَّةَ "" , وَمَسَحَ عَلَى نَاصِيَتِهِ ، وَقَالَ : "" قُلْ : اللَّهُ أَكْبَرُ , اللَّهُ أَكْبَرُ , اللَّهُ أَكْبَرُ , اللَّهُ أَكْبَرُ ، أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ , أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ ، مَرَّتَيْنِ ، أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ , أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ مَرَّتَيْنِ ، حَيَّ عَلَى الصَّلاةِ ، حَيَّ عَلَى الصَّلاةِ ، حَيَّ عَلَى الْفَلاحِ ، حَيَّ عَلَى الْفَلاحِ مَرَّتَيْنِ ، اللَّهُ أَكْبَرُ ، اللَّهُ أَكْبَرُ ، لا إِلَهَ إِلا اللَّهُ ، وَإِذَا أَذَّنْتَ بِالأُولَى مِنَ الصُّبْحِ , فَقُلْ : الصَّلاةُ خَيْرٌ مِنَ النَّوْمِ مَرَّتَيْنِ ، وَإِذَا أَقَمْتَ فَقُلْهَا مَرَّتَيْنِ : قَدْ قَامَتِ الصَّلاةُ , قَدْ قَامَتِ الصَّلاةُ ، سَمِعْتَ "" , قَالَ : فَكَانَ أَبُو مَحْذُورَةَ لا يَجُزُّ نَاصِيَتَهُ وَلا يُفَرِّقُهَا ، لأَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَسَحَ عَلَيْهَا""","","","","","Book of Prayer"
"1722","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّهُ سَمِعَ ابْنَ سَعْدٍ الْقَرَظِ فِي إِمَارَةِ ابْنِ الزُّبَيْرِ :  يُؤَذِّنُ الأُولَى : أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ ، أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ ، أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ ، أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ ، حَيَّ عَلَى الصَّلاةِ مَرَّتَيْنِ ، حَيَّ عَلَى الْفَلاحِ مَرَّتَيْنِ "" , قُلْتُ لِعَمْرٍو : فِي الإِقَامَةِ مَرَّتَيْنِ ؟ , قَالَ : "" لا أَدْرِي كَيْفَ كَانُوا يَقُولُونَ الإِقَامَةَ ؟ ""","","","","","Book of Prayer"
"1723","عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ الطَّائِفِيِّ ، عَنْ عَبْدِ رَبِّهِ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لِعُثْمَانَ بْنِ أَبِي الْعَاصِ حِينَ اسْتَعْمَلَهُ عَلَى الطَّائِفِ : وَإِنْ أَتَاكَ رَجُلٌ يُرِيدُ أَنْ يُؤَذِّنَ , فَلا تَمْنَعْهُ , قَالَ : وَذَكَرَ ابْنُ جُرَيْجٍ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ لِعُثْمَانَ : مِثْلَ ذَلِكَ","","","","","Book of Prayer"
"1724","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنِ ابْنِ أَبِي مُلَيْكَةَ , قَالَ :  أَذَّنَ مُؤَذِّنٌ لِمُعَاوِيَةَ بِمَكَّةَ , فَاحْتَمَلَهُ أَبُو مَحْذُورَةَ فَأَلْقَاهُ فِي بِئْرِ زَمْزَمَ ""","","","","","Book of Prayer"
"1725","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : مَرَّ ابْنُ عُمَرَ بِمُؤَذِّنٍ , فَقَالَ :  أَوْتِرْ أَذَانَكَ ، فَإِنَّ الأَذَانَ وِتْرٌ ""","","","","","Book of Prayer"
"1726","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ , قَالَ : كَانَ ابْنُ عُمَرَ , يَقُولُ :  الأَذَانُ ثَلاثًا ثَلاثًا ""","","","","","Book of Prayer"
"1727","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ رَجُلٍ ، أَنَّ ابْنَ عُمَرَ كَانَ إِذَا قَالَ فِي الأَذَانِ : حَيَّ عَلَى الْفَلاحِ , قَالَ :  حَيَّ عَلَى الْعَمَلِ "" ، ثُمَّ يَقُولُ : "" اللَّهُ أَكْبَرُ , اللَّهُ أَكْبَرُ , لا إِلَهَ إِلا اللَّهُ ""","","","","","Book of Prayer"
"1728","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ أَبِي جَابِرٍ الْبَيَاضِيِّ ، عَنْ سَعِيدٍ ، عَنْ عَبْدِ اللَّهِ بْنِ زَيْدٍ أَخِي بَنِي الْحَارِثِ بْنِ الْخَزْرَجِ أَنَّهُ :  بَيْنَا هُوَ نَائِمٌ إِذْ رَأَى رَجُلا مَعَهُ خَشَبَتَانِ , قَالَ : فَقُلْتُ لَهُ فِي الْمَنَامِ : إِنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُرِيدُ أَنْ يَشْتَرِيَ هَذَيْنِ الْعُودَيْنِ ، يَجْعَلُهُمَا نَاقُوسًا يُضْرَبُ بِهِ لِلصَّلاةِ , قَالَ : فَالْتَفَتَ إِلَى صَاحِبِ الْعُودَيْنِ بِرَأْسِهِ ، فَقَالَ : أَنَا أَدُلُّكُمْ عَلَى مَا هُوَ خَيْرٌ مِنْ هَذَا ، فَبَلَّغَهُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَمَرَهُ بَالتَّأْذِينِ ، فَاسْتَيْقَظَ عَبْدُ اللَّهِ بْنُ زَيْدٍ , قَالَ : وَرَأَى عُمَرُ مِثْلَ رُؤْيَا عَبْدِ اللَّهِ بْنِ زَيْدٍ , فَسَبَقَهُ عَبْدُ اللَّهِ بْنُ زَيْدٍ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرَهُ بِذَلِكَ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" قُمْ فَأَذِّنْ "" ، فَقَالَ : يَا رَسُولَ اللَّهِ ! إِنِّي فَظِيعُ الصَّوْتِ ، فَقَالَ لَهُ : "" فَعَلِّمْ بِلالا مَا رَأَيْتَ "" ، فَعَلَّمَهُ , فَكَانَ بِلالٌ يُؤَذِّنُ""","","","","","Book of Prayer"
"1729","عَنِ الثَّوْرِيِّ ، عَنْ عَمْرِو بْنِ مُرَّةَ ، وَحُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّهُمَا سَمِعَا عَبْدَ الرَّحْمَنِ بْنَ أَبِي لَيْلَى , يَقُولُ : كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : قَدْ أَهَمَّهُ الأَذَانُ حَتَّى هَمَّ أَنْ يَأْمُرَ رِجَالا فَيَقُومُونَ عَلَى آطَامِ الْمَدِينَةِ فَيُنَادُونَ لِلصَّلاةِ حَتَّى نَقَّسُوا ، أَوْ كَادُوا أَنْ يُنَقِّسُوا , قَالَ : فَرَأَى رَجُلٌ مِنَ الأَنْصَارِ , يُقَالُ لَهُ : عَبْدُ اللَّهِ بْنُ زَيْدٍ رَجُلا عَلَى حَائِطِ الْمَسْجِدِ عَلَيْهِ بُرْدَانِ أَخْضَرَانِ , وَهُوَ يَقُولُ :  اللَّهُ أَكْبَرُ , اللَّهُ أَكْبَرُ ، أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ ، أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ ، أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ ، أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ ، حَيَّ عَلَى الصَّلاةِ ، حَيَّ عَلَى الصَّلاةِ ، حَيَّ عَلَى الْفَلاحِ ، حَيَّ عَلَى الْفَلاحِ ، اللَّهُ أَكْبَرُ , اللَّهُ أَكْبَرُ ، لا إِلَهَ إِلا اللَّهُ "" ، ثُمَّ قَعَدَ قَعْدَةً ، ثُمَّ عَادَ , فَقَالَ : مِثْلَهَا ، ثُمَّ قَالَ : قَدْ قَامَتِ الصَّلاةُ مَرَّتَيْنِ الإِقَامَةُ ، فَغَدَا عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَحَدَّثَهُ فَقَالَ : "" عَلِّمْهَا بِلالا "" ، ثُمَّ قَامَ عُمَرُ , فَقَالَ : لَقَدْ أَطَافَ بِيَ اللَّيْلَةَ الَّذِي أَطَافَ بِهِ عَبْدُ اللَّهِ , وَلَكِنَّهُ سَبَقَنِي "" , قَالَ : سَمِعْتُ الثَّوْرِيَّ ، وَأَذَّنَ لَنَا بِمِنًى , فَقَالَ : "" اللَّهُ أَكْبَرُ , اللَّهُ أَكْبَرُ , أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ مَرَّتَيْنِ ، أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَرَّتَيْنِ ، فَصَنَعَ كَمَا ذُكِرَ فِي حَدِيثِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى فِي الأَذَانِ ، وَالإِقَامَةِ بِتَمَامٍ مِثْلَ الْحَدِيثِ""","","","","","Book of Prayer"
"1730","أَخْبَرَنَا مَعْمَرٌ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ بْنِ يَزِيدَ ، أَنَّ بِلالا كَانَ  يُثَنِّي الأَذَانَ ، وَيُثَنِّي الإِقَامَةَ ، وَأَنَّهُ كَانَ يَبْدَأُ بِالتَّكْبِيرِ ، وَيَخْتِمُ بِالتَّكْبِيرِ ""","","","","","Book of Prayer"
"1731","أَخْبَرَنَا عَنِ الثَّوْرِيِّ ، عَنْ أَبِي مَعْشَرٍ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ ، عَنْ بِلالٍ , قَالَ :  كَانَ أَذَانُهُ ، وَإِقَامَتُهُ مَرَّتَيْنِ مَرَّتَيْنِ ""","","","","","Book of Prayer"
"1732","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي عَمْرٍو ، عَنْ مُسْلِمٍ الْبَطِينِ , قَالَ : أَخْبَرَنِي مَنْ ، سَمِعَ مُؤَذِّنَ عَلِيٍّ  يَجْعَلُ الإِقَامَةَ مَرَّتَيْنِ مَرَّتَيْنِ ""","","","","","Book of Prayer"
"1733","عَنِ الثَّوْرِيِّ ، عَنْ فِطْرٍ ، عَنْ مُجَاهِدٍ , قَالَ : ذَكَرَ لَهُ الإِقَامَةَ مَرَّةً مَرَّةً ، فَقَالَ :  هَذَا شَيْءٌ قَدِ اسْتَخَفَّتْهُ الأُمَرَاءُ ، الإِقَامَةُ مَرَّتَيْنِ مَرَّتَيْنِ ""","","","","","Book of Prayer"
"1734","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، عَنْ أَنَسٍ , قَالَ : كَانَ بِلالٌ  يُثَنِّي الأَذَانَ ، وَيُوتِرُ الإِقَامَةَ ، إِلا قَوْلَهُ : قَدْ قَامَتِ الصَّلاةُ , قَدْ قَامَتِ الصَّلاةُ ""","","","","","Book of Prayer"
"1735","عَنِ الثَّوْرِيِّ ، عَنْ خَالِدٍ ، عَنْ أَبِي قِلابَةَ ، عَنْ أَنَسٍ , قَالَ : أُمِرَ بِلالٌ  أَنْ يُشْفِعَ الأَذَانَ ، وَيُوتِرَ الإِقَامَةَ ""","","","","","Book of Prayer"
"1736","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عُمَرُ بْنُ حَفْصٍ ، أَنَّ سَعْدًا ، أذَّنَ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِقِبَاءٍ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَحْسَنْتَ يَا بُنَيَّ إِذَا جِئتَ فَأَذِّنْ "" , فَكَانَ سَعْدٌ يُؤَذِّنُ بِقِبَاءٍ , وَلا يُؤَذِّنُ بِلالٌ""","","","","","Book of Prayer"
"1737","عَنِ ابْنِ جُرَيْجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّهُ كَانَ  يُقِيمُ الصَّلاةَ فِي السَّفَرِ يَقُولُهَا مَرَّتَيْنِ أَوْ ثَلاثًا , يَقُولُ : حَيَّ عَلَى الصَّلاةِ ، حَيَّ عَلَى الصَّلاةِ ، حَيَّ عَلَى خَيْرِ الْعَمَلِ ""","","","","","Book of Prayer"
"1738","عَنْ مَعْمَرٍ ، عَنِ الْحَسَنِ , قَالَ :  كَانَ يَقُولُ : إِذَا أذَّنَ يَقُولُ : اللَّهُ أَكْبَرُ , اللَّهُ أَكْبَرُ ، يَرْفَعُ بِهَا صَوْتَهُ ، ثُمَّ يَقُولُ خَافِضًا صَوْتَهُ : أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ ، وَأَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ ، حَيَّ عَلَى الصَّلاةِ ، حَيَّ عَلَى الْفَلاحِ ، ثُمَّ يَرْجِعُ فَيَرْفَعُ صَوْتَهُ , فَيَقُولُ : أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ ، أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ ، أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ ، أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ ، حَيَّ عَلَى الصَّلاةِ ، حَيَّ عَلَى الصَّلاةِ ، حَيَّ عَلَى الصَّلاةِ ، حَيَّ عَلَى الْفَلاحِ ، حَيَّ عَلَى الْفَلاحِ ، اللَّهُ أَكْبَرُ ، اللَّهُ أَكْبَرُ ، لا إِلَهَ إِلا اللَّهُ "" , قَالَ : وَكَانَ ابْنُ سِيرِينَ , يَقُولُ نَحْوَ ذَلِكَ""","","","","","Book of Prayer"
"1739","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ  حَقٌّ ، وَسُنَّةٌ مَسْنُونَةٌ ، أَنْ لا يُؤَذِّنَ مُؤَذِّنٌ إِلا مُتَوَضِّئًا "" , قَالَ : "" هُوَ مِنَ الصَّلاةِ ، وَهُوَ فَاتِحَةُ الصَّلاةِ , فَلا يُؤَذِّنُ إِلا مُتَوَضِّئًا ""","","","","","Book of Prayer"
"1740","عَنْ مَعْمَرٍ ، عَنْ أيُّوَبَ ، عَنِ ابْنِ سِيرِينَ ، أَوْ غَيْرِهِ , قَالَ :  لا يُؤَذِّنُ الرَّجُلُ إِلا عَلَى وُضُوءٍ ""","","","","","Book of Prayer"
"1741","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ :  كَانُوا لا يَرَوْنَ بَأْسًا أَنْ يُؤَذِّنَ الْمُؤَذِّنُ عَلَى غَيْرِ وُضُوءٍ ""","","","","","Book of Prayer"
"1742","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَيُؤَذِّنُ الْمُؤَذِّنُ مُسْتَقْبِلَ الْقِبْلَةِ ؟ , قَالَ :  نَعَمْ ، فَإِنْ كَانَ فِي قَرْيَةٍ فَإِنَّهُ يَلْتَفِتُ عَنْ يَمِينِهِ , وَيَسَارِهِ وَوَرَاءَهُ ، فَيَدْعُو النَّاسَ بَالنِّدَاءِ ، فَإِنْ كَانَ فِي سَفَرٍ لَيْسَ مَعَهُ بَشَرٌ كَثِيرٌ مَعَ خَلِيفَةٍ , أَوْ لَمْ يَكُنْ فِي النَّاسِ مَنْ يَدْعُوهُمْ إِلَى الأَذَانِ ، فَلْيَسْتَقْبِلِ الْقِبْلَةَ فِي نِدَائِهِ أَجْمَعَ ""","","","","","Book of Prayer"
"1743","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ :  إِذَا أَذَّنَ وَلَيْسَ فِي جَمَاعَةٍ فَلا يَلْتَفِتْ ، وَإِذَا أَذَّنَ فِي جَمَاعَةٍ يَدْعُو بِأَذَانِهِ أَحَدًا فَلْيَسْتَقْبِلِ الْبَيْتَ ، حَتَّى يَسْتَفْتِحَ فَيَسْتَقْبِلَهُ ، حَتَّى يَقُولَ : أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ ، ثُمَّ يَلْتَفِتُ بَعْدُ فَيَدْعُو يَمِينًا ، وَشِمَالا إِنْ شَاءَ "" , وَذَكَرَهُ عَبْدُ الْكَرِيمِ ، عَنِ النَّخَعِيِّ""","","","","","Book of Prayer"
"1744","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ :  إِذَا أَذَّنَ الْمُؤَذِّنُ اسْتَقْبَلَ الْقِبْلَةَ حَتَّى إِذَا أَرَادَ أَنْ يَقُولَ : حَيَّ عَلَى الصَّلاةِ دَارَ ، ثُمَّ اسْتَقْبَلَ الْقِبْلَةَ إِذَا قَالَ : اللَّهُ أَكْبَرُ , اللَّهُ أَكْبَرُ ، لا إِلَهَ إِلا اللَّهُ ""","","","","","Book of Prayer"
"1745","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ :  كَانُوا يَقُولُونَ : مُسْتَقْبِلَ الْقِبْلَةِ بِالتَّكْبِيرِ ، وَالشَّهَادَةِ "" , قَالَ إِبْرَاهِيمُ : قَدَمَاهُ مَكَانَهُمَا""","","","","","Book of Prayer"
"1746","عَنِ الثَّوْرِيِّ ، عَنْ عَوْنِ بْنِ أَبِي جُحَيْفَةَ ، عَنْ أَبِيهِ , قَالَ : رَأَيْتُ بِلالا يُؤَذِّنُ وَيَدُورُ ، فَأَتَتَبَّعُ فَاهُ هَاهُنَا , وَهَهُنَا ، وَإِصْبَعَاهُ فِي أُذُنَيْهِ , قَالَ : وَرَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي قُبَّةٍ لَهُ حَمْرَاءُ  , قَالَ : "" فَخَرَجَ بِلالٌ بَيْنَ يَدَيْهِ بَالْعَنْزَةِ , فَرَكَّزَهَا بِالأَبْطَحِ ، فَصَلَّى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَيْهَا الظُّهْرَ , وَالْعَصْرَ يَمُرُّ بَيْنَ يَدَيْهِ الْكَلْبُ وَالْحِمَارُ وَالْمَرْأَةُ وَعَلَيْهِ حُلَّةٌ حَمْرَاءُ ، كَأَنِّي أَنْظُرُ إِلَى بَرِيقِ سَاقَيْهِ "" , قَالَ سُفْيَانُ : "" نَرَى الْقُبَّةَ مِنْ أَدَمٍ ، وَالْحُلَّةَ حِبَرَةً ""","","","","","Book of Prayer"
"1747","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنِ الْحَسَنِ ، وَابْنِ سِيرِينَ  أَنَّ الْمُؤَذِّنَ يَضَعُ سَبَّابَتَهُ فِي أُذُنَيْهِ ""","","","","","Book of Prayer"
"1748","عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنْ طَلْحَةَ بْنِ مُصَرِّفٍ ، عَنْ سُوَيْدِ بْنِ غَفْلَةَ , قَالَ : كَانَ بِلالٌ ، وَأَبُو مَحْذُورَةَ  يَجْعَلُونَ أَصَابَعَهُمَا فِي آذَانِهِمَا بِالأَذَانِ ""","","","","","Book of Prayer"
"1749","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ :  كَانُوا يَكْرَهُونَ لِلْمُؤَذِّنِ إِذَا أَخَذَ فِي أَذَانِهِ أَنْ يَتَكَلَّمَ حَتَّى يَفْرُغَ ، وَفِي الإِقَامَةِ كَذَلِكَ ، وَيَسْتَقْبِلَ الْقِبْلَةَ بِالتَّكْبِيرِ وَالشَّهَادَةِ "" , قَالَ إِبْرَاهِيمُ : "" وَقَدَمَاهُ مَكَانَهُمَا ""","","","","","Book of Prayer"
"1750","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ :  يَسْتَقْبِلُ الْقِبْلَةَ فِي الأَذَانِ ، وَالإِقَامَةِ ، وَلا يَتَكَلَّمُ فِيهِمَا ""","","","","","Book of Prayer"
"1751","عَنْ مَعْمَرٍ ، عَمَّنْ سَمِعَ الْحَسَنَ , يَقُولُ :  يَتَكَلَّمُ الْمُؤَذِّنُ بَيْنَ ظَهْرَانَيْ أَذَانِهِ لِلْحَاجَةِ الَّتِي لا بُدَّ مِنْهَا ""","","","","","Book of Prayer"
"1752","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  هَلْ يَتَكَلَّمُ الْمُؤَذِّنُ بَيْنَ ظَهْرَانَيْ أَذَانِهِ ؟ , قَالَ : "" خَيْرٌ لَهُ ، أَنْ لا يَتَكَلَّمَ , فَإِنْ تَكَلَّمَ فَلا بَأْسَ ""","","","","","Book of Prayer"
"1753","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ , قَالَ :  يُكْرَهُ لِلْمُؤَذِّنِ أَنْ يُؤَذِّنَ وَهُوَ قَاعِدٌ ، وَيُكْرَهُ لِلصَبِيِّ أَنْ يُؤَذِّنَ حَتَّى يَحْتَلِمَ ""","","","","","Book of Prayer"
"1754","عَنِ الثَّوْرِيِّ  سُئِلَ عَنِ الْغُلامِ غَيْرِ الْمُحْتَلِمِ , هَلْ يُؤَذِّنُ لِلنَّاسِ ، وَيُقِيمُ الصَّلاةَ ؟ "" , فَقَالَ : "" نَعَمْ ""","","","","","Book of Prayer"
"1755","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  هَلْ يُؤَذِّنُ الْمُؤَذِّنُ غَيْرَ قَائِمٍ ؟ "" , قَالَ : "" لا ، إِلا مِنْ وَجَعٍ "" ، قُلْتُ : "" مِنْ نُعَاسٍ أَوْ كَسَلٍ ؟ "" , قَالَ : "" لا "" ، قُلْتُ : "" هَلْ يُؤَذِّنُ الْغُلامُ غَيْرَ مُحْتَلِمٍ ؟ "" , قَالَ : "" لا ""","","","","","Book of Prayer"
"1756","عَنِ الثَّوْرِيِّ ، عَنْ نُسَيْرِ بْنِ ذُعْلُوقٍ , قَالَ : رَأَيْتُ ابْنَ عُمَرَ  يُؤَذِّنُ وَهُوَ رَاكِبٌ "" , قَالَ : قُلْتُ لَهُ : أَوَاضِعٌ إِصْبَعَيْهِ فِي أُذُنَيْهِ ؟ , قَالَ : "" لا ""","","","","","Book of Prayer"
"1757","عَنْ يَحْيَى بْنِ الْعَلاءِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زِيَادٍ ، عَنْ زِيَادِ بْنِ نُعَيْمٍ ، عَنْ زِيَادِ بْنِ الْحَارِثِ الصُّدَائِيِّ , قَالَ : كُنْتُ مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ , فَحَضَرَتْ صَلاةُ الصُّبْحِ , فَقَالَ :  أَذِّنْ يَا أَخَا صُدَاءَ "" ، فَأَذَّنْتُ ، وَأَنَا عَلَى رَاحِلَتِي""","","","","","Book of Prayer"
"1758","عَنِ الثَّوْرِيِّ ، عَنْ وَاصِلٍ الأَحْدَبِ ، عَنْ قَبِيصَةَ بْنِ بُرْمَةَ الأَسَدِيِّ ، عَنِ ابْنِ مَسْعُودٍ , أَنَّهُ قَالَ :  مَا أُحِبُّ أَنْ يَكُونَ ، مُؤَذِّنُوكُمْ عُمْيَانَكُمْ , حَسِبْتُهُ قَالَ : وَلا قُرَّاءَكُمْ ""","","","","","Book of Prayer"
"1759","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ، أَنَّ ابْنَ أُمِّ مَكْتُومٍ ، كَانَ  يُؤَذِّنُ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَهُوَ أَعْمَى فَكَانَ لا يُؤَذِّنُ , حَتَّى يُقَالَ لَهُ : أَصْبَحْتَ ! "" , قَالَ : عَبْدُ الرَّزَّاقِ ، فَأَمَّا مَالِكٌ فَذَكَرَهُ ، عَنِ ابْنِ شِهَابٍ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ , مِثْلَهُ""","","","","","Book of Prayer"
"1760","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  إِنَّ بِلالا يُؤَذِّنُ بِلَيْلٍ فَمَنْ أَرَادَ الصَّوْمَ ، فَلا يَمْنَعُهُ أَذَانُ بِلالٍ حَتَّى يُؤَذِّنَ ابْنُ أُمِّ مَكْتُومٍ "" , قَالَ : وَكَانَ أَعْمَى , فَكَانَ لا يُؤَذِّنُ حَتَّى يُقَالَ لَهُ : أَصْبَحْتَ ، فَلَمَّا كَانَ ذَاتَ لَيْلَةٍ أَذَّنَ بِلالٌ ، ثُمَّ جَاءَ يُؤَذِّنُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقِيلَ لَهُ : إِنَّهُ نَائِمٌ ، فَنَادَى بِلالٌ : الصَّلاةُ خَيْرٌ مِنَ النَّوْمِ ، فَأُقِرَّتْ فِي الصُّبْحِ""","","","","","Book of Prayer"
"1761","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي جَعْفَرٍ ، عَنْ أَبِي سَلْمَانَ ، عَنْ أَبِي مَحْذُورَةَ , قَالَ :  كُنْتُ أُؤَذِّنُ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي صَلاةِ الْفَجْرِ , فَأَقُولُ : إِذَا قُلْتُ فِي الأَذَانِ الأَوَّلِ : حَيَّ عَلَى الْفَلاحِ : الصَّلاةُ خَيْرٌ مِنَ النَّوْمِ ، الصَّلاةُ خَيْرٌ مِنَ النَّوْمِ ""","","","","","Book of Prayer"
"1762","عَنِ الثَّوْرِيِّ ، عَنْ مُحَمَّدِ بْنِ عَجْلانَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّهُ كَانَ يَقُولُ :  حَيَّ عَلَى الْفَلاحِ ، الصَّلاةُ خَيْرٌ مِنَ النَّوْمِ ""","","","","","Book of Prayer"
"1763","عَنْ مَعْمَرٍ ، عَنْ صَاحِبٍ لَهُ ، عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَمَرَ بِلالا أَنْ يُثَوِّبَ فِي صَلاةِ الْفَجْرِ ، وَلا يُثَوِّبَ فِي غَيْرِهَا","","","","","Book of Prayer"
"1764","عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنِ الْحَكَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ، عَنْ بِلالٍ , قَالَ :  أَمَرَنِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنْ أُثَوِّبَ فِي الْفَجْرِ ، وَنَهَانِي أَنْ أُثَوِّبَ فِي الْعِشَاءِ ""","","","","","Book of Prayer"
"1765","عَنْ إِسْرَائِيلَ ، عَنْ عِيسَى بْنِ أَبِي عَزَّةَ ، عَنْ عَامِرٍ ، أَنَّهُ كَانَ :  يَنْهَى مُؤَذِّنَهُ أَنْ يُثَوِّبَ إِلا فِي الْعِشَاءِ ، وَالْفَجْرِ ""","","","","","Book of Prayer"
"1766","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنَّهُ كَانَ يَقُولُ فِي التَّثْوِيبِ :  إِذَا قَالَ فِي الأَذَانِ : حَيَّ عَلَى الْفَلاحِ ، حَيَّ عَلَى الْفَلاحِ , قَالَ : الصَّلاةُ خَيْرٌ مِنَ النَّوْمِ ""","","","","","Book of Prayer"
"1767","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ مُسْلِمٍ ، أَنَّ رَجُلا سَأَلَ طَاوُسًا جَالِسًا مَعَ الْقَوْمِ , فَقَالَ : يَا أَبَا عَبْدِ الرَّحْمَنِ ، مَتَى قِيلَ الصَّلاةُ خَيْرٌ مِنَ النَّوْمِ ؟ , فَقَالَ طَاوُسٌ :  أَمَا إِنَّهَا لَمْ تُقَلْ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَلَكِنَّ بِلالا , سَمِعَهَا فِي زَمَانِ أَبِي بَكْرٍ بَعْدَ وَفَاةِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُهَا : رَجُلٌ غَيْرُ مُؤَذِّنٍ ، فَأَخَذَهَا مِنْهُ ، فَأَذَّنَ بِهَا فَلَمْ يَمْكُثْ أَبُو بَكْرٍ إِلا قَلِيلا , حَتَّى إِذَا كَانَ عُمَرُ , قَالَ : "" لَوْ نَهَيْنَا بِلالا عَنْ هَذَا الَّذِي أَحْدَثَ ، وَكَأَنَّهُ نَسِيَهُ فَأَذَّنَ بِهِ النَّاسُ حَتَّى الْيَوْمَ ""","","","","","Book of Prayer"
"1768","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلْتُ عَطَاءً  مَتَى قِيلَ : الصَّلاةُ خَيْرٌ مِنَ النَّوْمِ ؟ "" , قَالَ : "" لا أَدْرِي ""","","","","","Book of Prayer"
"1769","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عُمَرُ بْنُ حَفْصٍ ، أَنَّ سَعْدًا , أَوَّلُ مَنْ قَالَ : الصَّلاةُ خَيْرٌ مِنَ النَّوْمِ فِي خِلافَةِ عُمَرَ ، فَقَالَ  بِدْعَةٌ "" ، ثُمَّ تَرَكَهُ ، وَإِنَّ بِلالا لَمْ يُؤَذِّنْ لِعُمَرَ""","","","","","Book of Prayer"
"1770","عَنْ إِسْرَائِيلَ ، عَنْ سِمَاكِ بْنِ حَرْبٍ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ سَمُرَةَ , يَقُولُ :  كَانَ مُؤَذِّنُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُمْهِلُ ، فَلا يُقِيمُ حَتَّى إِذَا رَأَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَدْ خَرَجَ أَقَامَ الصَّلاةَ حِينَ يَرَاهُ ""","","","","","Book of Prayer"
"1771","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  فَمَا حُكِيَ عَلَيْكَ إِذَا أَذَّنَ الْمُؤَذِّنُ بَاللَّيْلِ ، وَالنَّهَارِ مَكَثَ سَاعَةً بَعْدَمَا يَفْرُغُ مِنَ التَّأْذِينِ ، ثُمَّ يُنَادِي بِصَوْتِهِ أَلا حَيَّ عَلَى الصَّلاةِ مِرَارًا ؟ , قَالَ "" لَمْ أَعْلَمْ ، وَلمْ يَبْلُغْنِي ""","","","","","Book of Prayer"
"1772","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ لَيْثٍ ، عَنْ مُجَاهِدٍ , قَالَ : كُنْتُ مَعَ ابْنِ عُمَرَ , فَسَمِعَ رَجُلا يُثَوِّبُ فِي الْمَسْجِدِ ، فَقَالَ :  اخْرُجْ بِنَا مِنْ عِنْدِ هَذَا الْمُبْتَدِعِ ""","","","","","Book of Prayer"
"1773","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زِيَادٍ ، عَنْ زِيَادِ بْنِ نُعَيْمٍ ، عَنْ زِيَادِ بْنِ الْحَارِثِ الصُّدَائِيِّ , قَالَ : كُنْتُ مَعَ رَسُولِ اللَّهِ فَأَمَرَنِي ، فَأَذَّنْتُ الْفَجْرَ فَجَاءَ بِلالٌ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  يَا بِلالُ ، إِنَّ أَخَا صُدَاءَ قَدْ أَذَّنَ ، وَمَنْ أَذَّنَ فَهُوَ يُقِيمُ ""","","","","","Book of Prayer"
"1774","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ عِكْرِمَةَ بْنِ خَالِدٍ ، أَنَّ عُمَرَ قَالَ لأَبِي مَحْذُورَة :  إِذَا أَذَّنْتَ الأُولَى أَذِّنْ ، ثُمَّ ثَوِّبْ آتِكَ ""","","","","","Book of Prayer"
"1775","عَنْ رَجُلٍ ، عَنْ حَنْظَلَةَ , قَالَ : حَدَّثَنِي ابْنُ أَبِي سُفْيَانَ ، أَنَّ عُمَرَ ، قَالَ : لأَبِي مَحْذُورَةَ :  إِذَا أَذَّنْتَ الأُولَى فَصَلِّ رَكْعَتَيْنِ ، ثُمَّ أَقِمْ فَإِنِّي سَأَخْرُجُ إِلَيْكَ "" , قَالَ : "" وَكَانَ يُؤَذِّنُ عَلَى صُفَّةِ زَمْزَمَ ""","","","","","Book of Prayer"
"1776","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ هِلالِ بْنِ يَسَافٍ ، عَنْ أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ، قَالَ : قَالَ عَلِيٌّ :  الْمُؤَذِّنُ أَمْلَكُ بِالأَذَانِ ، وَالإِمَامُ أَمْلَكُ بِالإِقَامَةِ "" , قَالَ سُفْيَانُ : يَعْنِي يَقُولُ : الإِمَامُ لِلْمُؤَذِّنِ : "" تَأَخَّرْ حَتَّى أَتَوَضَّأَ , أَوْ أُصَلِّيَ رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"1777","عَنْ إِسْرَائِيلَ ، عَنْ سِمَاكِ بْنِ حَرْبٍ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ سَمُرَةَ , يَقُولُ :  كَانَ مُؤَذِّنُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُؤَذِّنُ ، ثُمَّ يُمْهِلُ فَلا يُقِيمُ , حَتَّى إِذَا رَأَى نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَدْ خَرَجَ أَقَامَ الصَّلاةَ حِينَ يَرَاهُ ""","","","","","Book of Prayer"
"1778","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ ذَكْوَانَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  الإِمَامُ ضَامِنٌ ، وَالْمُؤَذِّنُ أَمِينٌ اللَّهُمْ أَرْشِدِ الأَئِمَّةَ ، وَاغْفِرْ لِلْمُؤَذِّنِينَ ""","","","","","Book of Prayer"
"1779","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  الْمُؤَذِّنُونَ الأُمَنَاءُ ، وَالأَئِمَّةُ ضُمَنَاءُ أَرْشَدَ اللَّهُ الأَئِمَّةَ ، وَيَغْفِرُ لِلْمُؤَذِّنِينَ ""","","","","","Book of Prayer"
"1780","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّ ابْنَ عُمَرَ , قَالَ :  الإِمَامُ ضَامِنٌ إِنْ قَدَّمَ أَوْ أَخَّرَ ، وَأَحْسَنَ أَوْ أَسَاءَ "" , قَالَ مَعْمَرٌ : "" لَيْسَ كُلُّ الْحَدِيثِ عَنِ ابْنِ عُمَرَ ""","","","","","Book of Prayer"
"1781","عَنِ ابْنِ جُرَيْحٍ ، قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، عَنْ مُحَمَّدِ بْنِ عَلِيٍّ ،  أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، كَانَ إِذَا سَمِعَ الْمُؤَذِّنَ , قَالَ : كَمَا يَقُولُ ، وَإِذَا قَالَ : أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ , قَالَ : وَأَنَا ""","","","","","Book of Prayer"
"1782","عَنْ مَعْمَرٍ ، وَمَالِكٍ ، عَنِ ابْنِ شِهَابٍ ، عَنْ عَطَاءِ بْنِ يَزِيدَ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِذَا سَمِعْتُمُ النِّدَاءَ ، فَقُولُوا : كَمَا يَقُولُ الْمُؤَذِّنُ ""","","","","","Book of Prayer"
"1783","عَنِ الثَّوْرِيِّ ، عَنْ عَاصِمِ بْنِ عُبَيْدِ اللَّهِ بْنِ عَاصِمٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ عَبْدِ اللَّهِ بْنِ الْحَارِثِ بْنِ نَوْفَلٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا سَمِعَ الْمُؤَذِّنَ يُؤَذِّنُ ، قَالَ : اللَّهُ أَكْبَرُ , قَالَ :  اللَّهُ أَكْبَرُ "" ، وَإِذَا قَالَ : أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ , قَالَ : "" أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ "" ، وَإِذَا قَالَ : أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ ، قَالَ مِثْلَ ذَلِكَ ، وَإِذَا قَالَ : حَيَّ عَلَى الصَّلاةِ , قَالَ : "" لا حَوْلَ وَلا قُوَّةَ إِلا بِاللَّهِ الْعَلِيِّ الْعَظِيمِ ""","","","","","Book of Prayer"
"1784","أَخْبَرَنَا مَعْمَرٌ ، وَغَيْرُهُ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ بْنِ الْحَارِثِ التَّيْمِيِّ ، عَنْ عِيسَى بْنِ طَلْحَةَ , قَالَ : دَخَلْنَا عَلَى مُعَاوِيَةَ  فَنَادَى الْمُنَادِي لِلصَّلاةِ ، فَقَالَ : اللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ ، فَقَالَ مُعَاوِيَةُ كَمَا قَالَ : فَقَالَ : أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ ، فَقَالَ مِثْلَ ذَلِكَ أَيْضًا ، فَقَالَ : أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ ، فَقَالَ مِثْلَ ذَلِكَ ، ثُمَّ قَالَ : "" هَكَذَا سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ ""","","","","","Book of Prayer"
"1785","عَنْ مَعْمَرٍ ، عَنْ مُجَمِّعٍ الأَنْصَارِيِّ ، أَنَّهُ سَمِعَ أَبَا أُمَامَةَ بْنِ سَهْلِ بْنِ حَنِيفٍ ،  حِينَ سَمِعَ الْمُؤَذِّنَ ، كَبَّرَ وَتَشَهَّدَ بِمَا تَشَهَّدَ بِهِ ، ثُمَّ قَالَ : هَكَذَا حَدَّثَنَا مُعَاوِيَةُ أَنَّهُ : سَمِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : "" مَا قَالَ الْمُؤَذِّنُ ، فَإِذَا قَالَ : أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ قَالَ : وَأَنَا أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ "" ، ثُمَّ سَكَتَ""","","","","","Book of Prayer"
"1786","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ أَبِي جَعْفَرٍ قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ،  إِذَا سَمِعَ الْمُؤَذِّنَ , قَالَ : كَمَا يَقُولُ ""","","","","","Book of Prayer"
"1787","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ رَجُلٍ ،  لَمَّا قَالَ الْمُؤَذِّنُ : حَيَّ عَلَى الصَّلاةِ ، حَيَّ عَلَى الْفَلاحِ , قَالَ : لا حَوْلَ ، وَلا قُوَّةَ إِلا بِاللَّهِ الْعَلِيِّ الْعَظِيمِ ، ثُمَّ قَالَ : هَكَذَا سَمِعْنَا نَبِيَّكُمْ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ ""","","","","","Book of Prayer"
"1788","عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ الْجُعْفِيِّ ، عَنْ مُحَمَّدِ بْنِ عَلِيٍّ ، أَنَّهُ قَالَ :  مَنْ قَالَ كَمَا يَقُولُ الْمُؤَذِّنُ ، فَإِذَا قَالَ : أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ قَالَ : وَأَنَا أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ ، إِنَّ الَّذِينَ يَجْحَدُونَ بِمُحَمَّدٍ كَاذِبُونَ ، كَانَ لَهُ مِنَ الأَجْرِ عِدْلُ مَنْ كَذَّبَ بِمُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Prayer"
"1789","عَنِ ابْنِ جُرَيْجٍ , قَالَ :  حُدِّثْتُ أَنَّ نَاسًا كَانُوا فِيمَا مَضَى كَانُوا يَنْصِتُونَ لِلتَّأْذِينِ كَإِنْصَاتِهِمْ لِلْقُرْآنِ ، فَلا يَقُولُ الْمُؤَذِّنُ شَيْئًا إِلا قَالُوا مِثْلَهُ ، حَتَّى إِذَا قَالَ : حَيَّ عَلَى الصَّلاةِ , قَالُوا : لا حَوْلَ وَلا قُوَّةَ إِلا بِاللَّهِ الْعَلِيِّ الْعَظِيمِ ، فَإِذَا قَالَ : حَيَّ عَلَى الْفَلاحِ , قَالُوا : مَا شَاءَ اللَّهُ ""","","","","","Book of Prayer"
"1790","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِي عَامِرٍ ، عَنْ مُعَاوِيَةَ ابْنِ قُرَّةَ , وقَالُوا :  كَانُوا يَكْرَهُونَ أَنْ يَنْهَضَ ، الرَّجُلُ إِلَى الصَّلاةِ , حِينَ يَأْخُذُ الْمُؤَذِّنُ فِي إِقَامَتِهِ ""","","","","","Book of Prayer"
"1791","عَنِ ابْنِ التَّيْمِيِّ ، عَنِ الصَّلْتِ ، عَنْ عَلْقَمَةَ ، عَنْ أُمِّهِ ، عَنْ أُمِّ حَبِيبَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  كَانَ فِي بَيْتِهَا فَسَمِعَ الْمُؤَذِّنَ , فَقَالَ كَمَا يَقُولُ : فَلَمَّا قَالَ : حَيَّ عَلَى الصَّلاةِ ، نَهَضَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى الصَّلاةِ ""","","","","","Book of Prayer"
"1792","عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ , قَالَ : سَمِعْتُ يَحْيَى الْبَكَّاءَ , يَقُولُ : رَأَيْتُ ابْنَ عُمَرَ سَعَى بَيْنَ الصَّفَا وَالْمَرْوَةَ وَمَعَهُ نَاسٌ , فَجَاءَهُ رَجُلٌ طَوِيلُ اللِّحْيَةِ , فَقَالَ : يَا أَبَا عَبْدِ الرَّحْمَنِ ! إِنِّي لأُحِبُّكَ فِي اللَّهِ ، فَقَالَ ابْنُ عُمَرَ :  لَكِنِّي أُبْغِضُكَ فِي اللَّهِ "" ، فَكَانَ أَصْحَابُ ابْنِ عُمَرَ لامُوهُ وَكَلَّمُوهُ ، فَقَالَ : "" إِنَّهُ يَبْغِي فِي أَذَانِهِ ، وَيَأْخُذُ عَنْهُ أَجْرًا ""","","","","","Book of Prayer"
"1793","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الضَّحَّاكِ بْنِ قَيْسٍ ، أَنَّ رَجُلا , قَالَ : إِنِّي لأُحِبُّكَ فِي اللَّهِ ، قَالَ لَهُ :  وَلَكِنِّي أُبْغِضُكَ فِي اللَّهِ "" , قَالَ : لِمَ ؟ , قَالَ : "" إِنَّكَ تَبْغِي فِي أَذَانِكَ ، وَتَأْخُذُ الأَجْرَ عَلَى كِتَابِ اللَّهِ ""","","","","","Book of Prayer"
"1794","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ عِكْرِمَةَ بْنِ خَالِدٍ ، أَنَّ عُمَرَ قَدِمَ مَكَّةَ , فَأَذَّنَ أَبُو مَحْذُورَةَ ، فَقَالَ لَهُ عُمَرُ :  مَا خَشِيتَ أَنْ يَنْخَرِقَ ؟ "" , قَالَ : يَا أَمِيرَ الْمُؤْمِنِينَ , قَدِمْتَ فَأَحْبَبْتُ أَنْ أُسْمِعَكَ , فَقَالَ عُمَرُ : "" إِنَّ أَرْضَكُمْ مَعْشَرَ أَهْلِ تِهَامَةَ أَرْضٌ حَارَّةٌ فَأَبْرِدْ "" ، ثُمَّ أَبْرِدْ , يَعْنِي : صَلاةَ الظُّهْرِ , ثُمَّ أَذِّنْ ، ثُمَّ ثَوِّبْ آتِكَ""","","","","","Book of Prayer"
"1795","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللَّهِ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ اللَّهِ , قَالَ :  لا يُؤْخَذُ عَلَى الأَذَانِ رِزْقٌ ""","","","","","Book of Prayer"
"1796","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّهُ كَانَ  يَكْرَهُ أَنْ يَأْخُذَ الْجُعْلَ فِي أَذَانِهِ , إِلا أَنْ يُعْطَى شَيْئًا بِغَيْرِ شَرْطٍ ""","","","","","Book of Prayer"
"1797","عَنِ الأَسْلَمِيِّ بْنِ مُحَمَّدٍ ، عَنْ إِسْحَاقَ بْنِ مُحَمَّدٍ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي فَرْوَةَ , قَالَ :  أَوَّلُ مَنْ رَزَقَ الْمُؤَذِّنِينَ عُثْمَانُ ""","","","","","Book of Prayer"
"1798","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنَّ أَبَا بَكْرٍ الصِّدِّيقَ , قَالَ :  الأَذَانُ شِعَارُ الإِيمَانِ ""","","","","","Book of Prayer"
"1799","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَطَاءً , يَقُولُ :  الْمُؤَذِّنُونَ أَطْوَلُ النَّاسِ يَوْمَ الْقِيَامَةِ أَعْنَاقًا ""","","","","","Book of Prayer"
"1800","عَنِ ابْنِ مُجَاهِدٍ ، عَنْ أَبِيهِ , قَالَ :  الْمُؤَذِّنُونَ أَطْوَلُ النَّاسِ أَعْنَاقًا يَوْمَ الْقِيَامَةِ ، وَلا يَدُودُونَ فِي قُبُورِهِمْ ""","","","","","Book of Prayer"
"1801","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنْ رَجُلٍ ، عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  الْمُؤَذِّنُونَ أَطْوَلُ النَّاسِ أَعْنَاقًا يَوْمَ الْقِيَامَةِ ""","","","","","Book of Prayer"
"1802","عَنِ الثَّوْرِيِّ ، عَنْ طَلْحَةَ بْنِ يَحْيَى ، عَنْ عِيسَى بْنِ طَلْحَةَ ، عَنْ رَجُلٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  أَطْوَلُ النَّاسِ أَعْنَاقًا يَوْمَ الْقِيَامَةِ الْمُؤَذِّنُونَ ""","","","","","Book of Prayer"
"1803","أَخْبَرَنَا مَعْمَرٌ ، عَنْ مَنْصُورٍ ، عَنْ عَبَّادِ بْنِ أُنَيْسٍ ، عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الْمُؤَذِّنَ يُغْفَرُ لَهُ مَدَى صَوْتِهِ ، وَيُصَدِّقُهُ كُلُّ رَطْبٍ وَيَابِسٍ سَمِعَهُ ، وَالشَّاهِدُ عَلَيْهِ خَمْسٌ وَعِشْرُونَ حَسَنَةً ""","","","","","Book of Prayer"
"1804","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ صَفْوَانَ بْنِ سُلَيْمٍ ، عَنْ عَطَاءِ بْنِ يَسَارٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  يَغْفِرُ اللَّهُ لِلْمُؤَذِّنِ مَدَى صَوْتِهِ ، وَيُصَدِّقُهُ كُلُّ رَطْبٍ وَيَابِسٍ سَمِعَهُ ""","","","","","Book of Prayer"
"1805","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ الأَنْصَارِيِّ ، عَنْ أَبِيهِ , قَالَ : كُنْتُ فِي حِجْرِ أَبِي سَعِيدٍ الْخُدْرِيِّ , فَقَالَ : أيْ بُنَيَّ إِذَا كُنْتَ فِي الْبَوَادِي , فَارْفَعْ صَوْتَكَ بِالأَذَانِ فَإِنِّي سَمِعْتُهُ ، يَعْنِي النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  مَا مِنْ جِنٍّ ، وَلا إِنْسٍ ، وَلا حَجَرٍ ، وَلا شَجَرٍ إِلا شَهِدَ لَهُ ""","","","","","Book of Prayer"
"1806","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ ، عَنِ الْحَسَنِ , قَالَ : بَيْنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي مَسِيرٍ لَهُ , سَمِعَ رَجُلا , يَقُولُ : اللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  عَلَى الْفِطْرَةِ عَلَى الْفِطْرَةِ هَذَا "" ، فَقَالَ : أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" بَرِئَ مِنَ الشِّرْكِ هَذَا "" ، فَقَالَ : أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" دَخَلَ الْجَنَّةَ هَذَا "" ، فَقَالَ : حَيَّ عَلَى الصَّلاةِ ، حَيَّ عَلَى الْفَلاحِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" ظَهَرَ الإِسْلامُ أَوْ قَالَ : الإِيمَانُ ، وَرَبِّ الْكَعْبَةِ تَجِدُونَ هَذَا رَاعِيًا أَوْ صَاحِبَ صَيْدٍ ، أَوْ رَجُلا خَرَجَ مُتَبَدِّيًا مِنْ أَهْلِهِ "" , قَالَ : "" فَابْتَدَرَ الْقَوْمُ لِيُخْبِرُوهُ بَالَّذِي سَمِعُوا , فَوَجَدُوهُ رَجُلا مِنْ أَسْلَمَ خَرَجَ مُتَبَدِّيًا مِنْ أَهْلِهِ ""","","","","","Book of Prayer"
"1807","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنْ مُحَمَّدِ بْنِ الْحَنَفِيَّةِ , قَالَ :  الْمُؤَذِّنُ الْمُحْتَسِبُ , كَالشَّاهِرِ سَيْفَهُ فِي سَبِيلِ اللَّهِ ""","","","","","Book of Prayer"
"1808","عَنِ الثَّوْرِيِّ ، عَنْ شَيْخٍ ، عَنْ عُمَرَ , قَالَ :  لُحُومٌ مُحَرَّمَةٌ عَلَى النَّارِ "" ، ثُمَّ ذَكَرَ الْمُؤَذِّنِينَ . قَالَ الثَّوْرِيُّ : وَسَمِعْتُ مَنْ يَذْكُرُ : "" أَنَّ أَهْلَ السَّمَاءِ لا يَسْمَعُونَ مِنْ أَهْلِ الأَرْضِ إِلا الأَذَانَ ""","","","","","Book of Prayer"
"1809","عَنِ الثَّوْرِيِّ ، عَنْ بَيَانٍ ، عَنْ قَيْسِ بْنِ أَبِي حَازِمٍ , قَالَ : قَالَ عُمَرُ :  لَوْ كُنْتُ أُطِيقُ الأَذَانَ مَعَ الْخِلِّيفَا لأَذَّنْتُ ""","","","","","Book of Prayer"
"1810","عَنْ إِسْرَائِيلَ ، عَنْ أَبِي سِنَانٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي الْهُذَيْلِ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ :  لَوْلا أَنِّي أَخَافُ أَنْ يَكُونَ سُنَّةً مَا تَرَكْتُ الأَذَانَ ""","","","","","Book of Prayer"
"1811","عَنِ الثَّوْرِيِّ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنْ شُبَيْلِ بْنِ عَوْفٍ , قَالَ : قَالَ عُمَرُ :  مَنْ مُؤَذِّنُوكُمُ الْيَوْمَ ؟ "" , قَالُوا : مَوَالِينَا ، وَعَبِيدُنَا , قَالَ : "" إِنَّ ذَلِكَ بِكُمْ لَنَقْصٌ كَثِيرٌ ""","","","","","Book of Prayer"
"1812","عَنِ الأسْلَمِيِّ ، عَنْ دَاوُدَ بْنِ الْحُصَيْنِ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ :  لا يَؤُمُّ الْغُلامُ حَتَّى يَحْتَلِمَ ، وَلْيُؤَذِّنْ لَكُمْ خِيَارُكُمْ ""","","","","","Book of Prayer"
"1813","عَنْ صَفْوَانَ بْنِ سُلَيْمٍ ، عَنْ مُحَمَّدِ بْنِ يُوسُفَ بْنِ عَبْدِ اللَّهِ بْنِ سَلامٍ ، عَنْ عَبْدِ اللَّهِ بْنِ سَلامٍ , قَالَ :  مَا أُذِّنَ فِي قَوْمٍ بِلَيْلٍ إِلا أُمِنُوا الْعَذَابَ حَتَّى يُصْبِحُوا ، وَلا نَهَارًا إِلا أُمِنُوا الْعَذَابَ حَتَّى يُمْسُوا ""","","","","","Book of Prayer"
"1814","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ :  مَا أُحِبُّ أَنْ أَؤُمَّ أَحَدًا أَبَدًا , إِلا أَهْلَ بَيْتِي مِنْ أَجْلِ أَنَّهُ إِنْ نَقَصَ مِنَ الصَّلاةِ , فَإِنَّ عَلَيْهِ إِثْمَ مَا نَقَصَ مِنْ صَلاتِهِ ، وَصَلاتِهِمْ ، وَأَشْيَاءُ يَحِقُّ عَلَى الإِمَامِ ، وَرَآهُ يَخْشَى أَنْ لا يُؤَدِّيَهَا ""","","","","","Book of Prayer"
"1815","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ، أَوْ غَيْرِهِ , قَالَ : خَرَجَ مُجَاهِدٌ ، وَرَجُلٌ مَعَهُ إِلَى الطَّائِفِ  فَكَرِهَ كُلُّ وَاحِدٍ مِنْهُمَا ، أَنْ يُصَلِّيَ بِصَاحِبِهِ , فَصَلَّى كُلُّ وَاحِدٍ وَحْدَهُ حَتَّى رَجَعَا ""","","","","","Book of Prayer"
