"1021","بَابُ فَضْلِ تَلْيِينِ الْمَنَاكِبِ فِي الْقِيَامِ فِي الصُّفُوفِصفوں","بَابُ فَضْلِ تَلْيِينِ الْمَنَاكِبِ فِي الْقِيَامِ فِي الصُّفُوفِصفوں","","","","","","","میں کھڑے ہوتے وقت کندھوں کو نرم رکھنے کی فضیلت کا بیان","1566","1566","1566","1566"
"1022","بَابُ طَرْدِ الْمُصْطَفِّينَ بَيْنَ السَّوَارِي عَنْهَاستونوں","بَابُ طَرْدِ الْمُصْطَفِّينَ بَيْنَ السَّوَارِي عَنْهَاستونوں","","","","","","","کے درمیان صفیں بنانے والوں کو وہاں سے ہٹانے کا بیان","1567","1567","1567","1567"
"1023","بَابُ النَّهْيِ عَنِ الِاصْطِفَافِ بَيْنَ السَّوَارِيستونوں","بَابُ النَّهْيِ عَنِ الِاصْطِفَافِ بَيْنَ السَّوَارِيستونوں","","","","","","","کے درمیان صفیں بنانا منع ہے","1568","1568","1568","1568"
"1024","بَابُ الزَّجْرِ عَنْ صَلَاةِ الْمَأْمُومِ خَلْفَ الصَّفِّ وَحْدَهُمقتدی","بَابُ الزَّجْرِ عَنْ صَلَاةِ الْمَأْمُومِ خَلْفَ الصَّفِّ وَحْدَهُمقتدی","","","","","","","کا صف کے پیچھے اکیلے نماز پڑھنا منع ہے","1569","1570","1569","1570"
"1025","بَابُ الرُّخْصَةِ فِي رُكُوعِ الْمَأْمُومِ قَبْلَ اتِّصَالِهِ بِالصَّفِّ، وَدَبِيبِهِ رَاكِعًا حَتَّى يَتَّصِلَ بِالصَّفِّ فِي رُكُوعِهِصف","بَابُ الرُّخْصَةِ فِي رُكُوعِ الْمَأْمُومِ قَبْلَ اتِّصَالِهِ بِالصَّفِّ، وَدَبِيبِهِ رَاكِعًا حَتَّى يَتَّصِلَ بِالصَّفِّ فِي رُكُوعِهِصف","","","","","","","میں پہنچنے سے پہلے مقتدی کو رکوع کرنے اور رکوع ہی کی حالت میں آہستہ آہستہ چل کر صف میں پہنچنے کی رخصت کا بیان","1571","1571","1571","1571"
"1026","بَابُ ذِكْرِ الْبَيَانِ أَنَّ أُولِي الْأَحْلَامِ وَالنُّهَى أَحَقُّ بِالصَّفِّ الْأَوَّلِ إِذِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَمَرَ بِأَنَ يَلُوهُ.اس بات کا بیان کہ عقل و تمیز والے افراد پہلی صف میں کھڑے ہونے کا زیادہ حق رکھتے ہیں کیونکہ نبی کریم صلی اللہ علیہ وسلم نے انہی افراد کو اپنے قریب کھڑے ہونے کا حُکم","بَابُ ذِكْرِ الْبَيَانِ أَنَّ أُولِي الْأَحْلَامِ وَالنُّهَى أَحَقُّ بِالصَّفِّ الْأَوَّلِ إِذِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَمَرَ بِأَنَ يَلُوهُ.اس بات کا بیان کہ عقل و تمیز والے افراد پہلی صف میں کھڑے ہونے کا زیادہ حق رکھتے ہیں کیونکہ نبی کریم صلی اللہ علیہ وسلم نے انہی افراد کو اپنے قریب کھڑے ہونے کا حُکم","","","","","","","دیا تھا","1572","1572","1572","1572"
"1027","اگر پہلی صف میں نو عمر کھڑے ہوجائیں پھر بعد میں کوئی صاحب عقل و تمیز والے آئیں تو بچّوں کو ہٹاکر انہیں پچھلی صف میں کھڑنا جائز ہے اور اگلی صف میں وہ کھڑا ہو جسے نبی کریم صلی اللہ علیہ وسلم نے کھڑے ہونے کا حُکم","اگر پہلی صف میں نو عمر کھڑے ہوجائیں پھر بعد میں کوئی صاحب عقل و تمیز والے آئیں تو بچّوں کو ہٹاکر انہیں پچھلی صف میں کھڑنا جائز ہے اور اگلی صف میں وہ کھڑا ہو جسے نبی کریم صلی اللہ علیہ وسلم نے کھڑے ہونے کا حُکم","","","","","","","دیا ہے اور عقل و تمیز سے عاری نو عمر کو پچھلی صف میں کھڑا کیا جائے","1573","1573","1573","1573"
"1028","بَابُ الرُّخْصَةِ فِي شَقِّ أُولِي الْأَحْلَامِ، وَالنُّهَى لِلصُّفُوفِ إِذَا كَانُوا قَدِ اصْطَفُّوا عِنْدَ حُضُورِهِمْ لِيَقُومُوا فِي الصَّفِّ الْأَوَّلِ.اہل دانش اور عقل و تمیز والے اشخاص کو صفوں کو چیر کر پہلی میں کھڑے ہونا جائز ہے جبکہ لوگ اُن","بَابُ الرُّخْصَةِ فِي شَقِّ أُولِي الْأَحْلَامِ، وَالنُّهَى لِلصُّفُوفِ إِذَا كَانُوا قَدِ اصْطَفُّوا عِنْدَ حُضُورِهِمْ لِيَقُومُوا فِي الصَّفِّ الْأَوَّلِ.اہل دانش اور عقل و تمیز والے اشخاص کو صفوں کو چیر کر پہلی میں کھڑے ہونا جائز ہے جبکہ لوگ اُن","","","","","","","کے آنے پر صفیں بناچکے ہوں","1574","1574","1574","1574"
"1029","بَابُ أَمْرِ الْمُؤْمِنِينَ بِالِاقْتِدَاءِ بِالْإِمَامِ، وَالنَّهْيِ عَنْ مُخَالَفَتِهِمْ إِيَّاهُ.مقتدیوں کو امام کی اقتداء کرنے کا حُکم","بَابُ أَمْرِ الْمُؤْمِنِينَ بِالِاقْتِدَاءِ بِالْإِمَامِ، وَالنَّهْيِ عَنْ مُخَالَفَتِهِمْ إِيَّاهُ.مقتدیوں کو امام کی اقتداء کرنے کا حُکم","","","","","","","اور امام کی مخالفت کرنے کی ممانعت کا بیان","1575","1575","1575","1575"
"1030","بَابُ الزَّجْرِ عَنْ مُبَادَرَةِ الْمَأْمُومِ الْإِمَامَ بِالتَّكْبِيرِ، وَالرُّكُوعِ، وَالسُّجُودِ.تکبیر،","بَابُ الزَّجْرِ عَنْ مُبَادَرَةِ الْمَأْمُومِ الْإِمَامَ بِالتَّكْبِيرِ، وَالرُّكُوعِ، وَالسُّجُودِ.تکبیر،","","","","","","","رکوع اور سجدے میں مقتدی کا امام سے پہل کرنا منع ہے","1576","1576","1576","1576"
"1031","بَابُ ذِكْرِ الْبَيَانِ أَنَّ الْمَأْمُومَ إِنَّمَا يُكَبِّرُ بَعْدَ فَرَاغِ الْإِمَامِ مِنَ التَّكْبِيرِاس بات کا بیان کہ مقتدی تکبیر اُس","بَابُ ذِكْرِ الْبَيَانِ أَنَّ الْمَأْمُومَ إِنَّمَا يُكَبِّرُ بَعْدَ فَرَاغِ الْإِمَامِ مِنَ التَّكْبِيرِاس بات کا بیان کہ مقتدی تکبیر اُس","","","","","","","وقت کہے گا جب امام تکبیر کہہ کر فارغ ہوجائے گا","1577","1577","1577","1577"
"1032","بَابُ سُكُوتِ الْإِمَامِ قَبْلَ الْقِرَاءَةِ، وَبَعْدَ تَكْبِيرَةِ الِافْتِتَاحِ.تکبیر","بَابُ سُكُوتِ الْإِمَامِ قَبْلَ الْقِرَاءَةِ، وَبَعْدَ تَكْبِيرَةِ الِافْتِتَاحِ.تکبیر","","","","","","","افتتاح کے بعد اور قراءت سے پہلے امام کے خاموش رہنے کا بیان","1578","1578","1578","1578"
"1033","بَابُ ذِكْرِ الْبَيَانِ أَنَّ اسْمَ السَّاكِتِ قَدْ يَقَعُ عَلَى النَّاطِقِ سِرًّااس","بَابُ ذِكْرِ الْبَيَانِ أَنَّ اسْمَ السَّاكِتِ قَدْ يَقَعُ عَلَى النَّاطِقِ سِرًّااس","","","","","","","بات کا بیان کہ کبھی آہستہ بولنے والے پر بھی ساکت و خاموش کا اطلاق ہو جاتا ہے","1579","1579","1579","1579"
"1034","بَابُ تَطْوِيلِ الْإِمَامِ الرَّكْعَةَ الْأُولَى مِنَ الصَّلَوَاتِ لِيَتَلَاحَقَ الْمَأْمُومُونُ.مقتدیوں","بَابُ تَطْوِيلِ الْإِمَامِ الرَّكْعَةَ الْأُولَى مِنَ الصَّلَوَاتِ لِيَتَلَاحَقَ الْمَأْمُومُونُ.مقتدیوں","","","","","","","کو نماز میں شریک کرنے کے لئے امام کا نمازوں کی پہلی رکعت کو لمبا کرنے کا بیان","1580","1580","1580","1580"
"1035","بَابُ الْقِرَاءَةِ خَلْفَ الْإِمَامِ، وَإِنْ جَهَرَ الْإِمَامُ بِالْقِرَاءَةِ وَالزَّجْرِ عَنْ أَنْ يَزِيدَ الْمَأْمُومُ عَلَى قِرَاءَةِ فَاتِحَةِ الْكِتَابِ إِذَا جَهَرَ الْإِمَامُ بِالْقِرَاءَةِ.امام","بَابُ الْقِرَاءَةِ خَلْفَ الْإِمَامِ، وَإِنْ جَهَرَ الْإِمَامُ بِالْقِرَاءَةِ وَالزَّجْرِ عَنْ أَنْ يَزِيدَ الْمَأْمُومُ عَلَى قِرَاءَةِ فَاتِحَةِ الْكِتَابِ إِذَا جَهَرَ الْإِمَامُ بِالْقِرَاءَةِ.امام","","","","","","","کے پیچھے قراءت کرنے کا بیان اگرچہ امام جہری قراءت کر رہا ہو۔ جب امام جہری قراءت کررہا ہو تو مقتدی کے لئے سورة الفاتحة سے زائد قراءت کرنا منع ہے","1581","1581","1581","1581"
"1036","بَابُ تَأْمِينِ الْمَأْمُومِ عِنْدَ فَرَاغِ الْإِمَامِ مِنْ قِرَاءَةِ فَاتِحَةِ الْكِتَابِ فِي الصَّلَاةِ الَّتِي يَجْهَرُ فِيهَا الْإِمَامُ بِالْقِرَاءَةِ، وَإِنْ نَسِيَ إِمَامٌ وَجَهِلَ، وَلَمْ يُؤَمِّنْ.جس","بَابُ تَأْمِينِ الْمَأْمُومِ عِنْدَ فَرَاغِ الْإِمَامِ مِنْ قِرَاءَةِ فَاتِحَةِ الْكِتَابِ فِي الصَّلَاةِ الَّتِي يَجْهَرُ فِيهَا الْإِمَامُ بِالْقِرَاءَةِ، وَإِنْ نَسِيَ إِمَامٌ وَجَهِلَ، وَلَمْ يُؤَمِّنْ.جس","","","","","","","نماز میں امام جہری قراءت کررہا ہو، اس میں امام کے سورة الفاتحة کی قراءت سے فارغ ہونے کے بعد مقتدی آمین کہے گا، اگرچہ امام بھولنے یا جہالت کی وجہ سے آمین نہ کہے","1582","1582","1582","1582"
"1037","بَابُ فَضْلِ تَأْمِينِ الْمَأْمُومِجب","بَابُ فَضْلِ تَأْمِينِ الْمَأْمُومِجب","","","","","","","امام آمین کہے تو مقتدی کے آمین کہنے کی فضیلت کا بیان","1583","1583","1583","1583"
"1038","بَابُ ذِكْرِ إِجَابَةِ الرَّبِّ- عَزَّ وَجَلَّ- الْمُؤْمِنَ عِنْدَ فَرَاغِ قِرَاءَةِ فَاتِحَةِ الْكِتَابِسورة","بَابُ ذِكْرِ إِجَابَةِ الرَّبِّ- عَزَّ وَجَلَّ- الْمُؤْمِنَ عِنْدَ فَرَاغِ قِرَاءَةِ فَاتِحَةِ الْكِتَابِسورة","","","","","","","الفاتحة کی قراءت سے فارغ ہونے پر اللہ تعالیٰ کی طرف سے مومن کی دعا قبول ہونے کا بیان","1584","1584","1584","1584"
"1039","بَابُ ذِكْرِ حَسَدِ الْيَهُودِ الْمُؤْمِنِينَ عَلَى تَأْمِينِهِمْیہودیوں","بَابُ ذِكْرِ حَسَدِ الْيَهُودِ الْمُؤْمِنِينَ عَلَى تَأْمِينِهِمْیہودیوں","","","","","","","کا مؤمنوں سے آمین کہنے کی وجہ سے حسد کرنے کا بیان","1585","1585","1585","1585"
"1040","بَابُ ذِكْرِ مَا كَانَ اللَّهُ- عَزَّ وَجَلَّ- خَصَّ نَبِيَّهُ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالتَّأْمِينِاس","بَابُ ذِكْرِ مَا كَانَ اللَّهُ- عَزَّ وَجَلَّ- خَصَّ نَبِيَّهُ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالتَّأْمِينِاس","","","","","","","بات کا بیان کہ اللہ تعالی نے اپنے نبی صلی اللہ علیہ وسلم کو آمین کے ساتھ خاص فرمایا ہے۔","1586","1586","1586","1586"
"1041","بَابُ السُّنَّةِ فِي جَهْرِ الْإِمَامِ بِالْقِرَاءَةِ، وَاسْتِحْبَابِ الْجَهْرِ بِالْقِرَاءَةِ جَهْرًا بَيْنَ الْمُخَافَتَةِ، وَبَيْنَ الْجَهْرِ الرَّفِيعِ.امام کے جہری قراءت کرنے میں سنّت","بَابُ السُّنَّةِ فِي جَهْرِ الْإِمَامِ بِالْقِرَاءَةِ، وَاسْتِحْبَابِ الْجَهْرِ بِالْقِرَاءَةِ جَهْرًا بَيْنَ الْمُخَافَتَةِ، وَبَيْنَ الْجَهْرِ الرَّفِيعِ.امام کے جہری قراءت کرنے میں سنّت","","","","","","","کا بیان۔ بہت زیادہ بلند آواز اور بالکل پست آواز کے درمیان آواز سے قراءت کرنا مستحب ہے","1587","1587","1587","1587"
"1042","بَابُ ذِكْرِ مُخَافَتَةِ الْإِمَامِ الْقِرَاءَةَ فِي الظُّهْرِ وَالْعَصْرِ، وَإِبَاحَةِ الْجَهْرِ بِبَعْضِ الْآيِ أَحْيَانًا فِيمَا يُخَافِتُ بِالْقِرَاءَةِ فِي الصَّلَاةِنماز ظہر اور عصر میں امام کا پوشیدہ آواز سے قراءت کرنے کا بیان کبھی کبھار سری نماز میں آیت کا کچھ حصّہ","بَابُ ذِكْرِ مُخَافَتَةِ الْإِمَامِ الْقِرَاءَةَ فِي الظُّهْرِ وَالْعَصْرِ، وَإِبَاحَةِ الْجَهْرِ بِبَعْضِ الْآيِ أَحْيَانًا فِيمَا يُخَافِتُ بِالْقِرَاءَةِ فِي الصَّلَاةِنماز ظہر اور عصر میں امام کا پوشیدہ آواز سے قراءت کرنے کا بیان کبھی کبھار سری نماز میں آیت کا کچھ حصّہ","","","","","","","بلند آواز سے پڑھنا جائز ہے","1588","1588","1588","1588"
"1043","بَابُ جَهْرِ الْإِمَامِ بِالْقِرَاءَةِ فِي صَلَاةِ الْمَغْرِبِنمازِ","بَابُ جَهْرِ الْإِمَامِ بِالْقِرَاءَةِ فِي صَلَاةِ الْمَغْرِبِنمازِ","","","","","","","مغرب میں امام کا بلند آواز سے قراءت کرنا","1589","1589","1589","1589"
"1044","بَابُ جَهْرِ الْإِمَامِ بِالْقِرَاءَةِ فِي صَلَاةِ الْعِشَاءِنمازِ","بَابُ جَهْرِ الْإِمَامِ بِالْقِرَاءَةِ فِي صَلَاةِ الْعِشَاءِنمازِ","","","","","","","عشاء میں امام کا جہری قراءت کرنا","1590","1590","1590","1590"
"1045","بَابُ جَهْرِ الْإِمَامِ بِالْقِرَاءَةِ فِي صَلَاةِ الْغَدَاةِنمازِ","بَابُ جَهْرِ الْإِمَامِ بِالْقِرَاءَةِ فِي صَلَاةِ الْغَدَاةِنمازِ","","","","","","","فجر میں امام کا بلند آواز سے قراءت کرنا","1591","1591","1591","1591"
"1046","بَابُ ذِكْرِ الْخَبَرِ الْمُفَسِّرِ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِنَّمَا كَانَ يَجْهَرُ فِي الْأُولَيَيْنِ مِنَ الْمَغْرِبِ، وَالْأُولَيَيْنِ مِنَ الْعِشَاءِ، لَا فِي جَمِيعِ الرَّكَعَاتِ كُلِّهَا،یہ","بَابُ ذِكْرِ الْخَبَرِ الْمُفَسِّرِ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِنَّمَا كَانَ يَجْهَرُ فِي الْأُولَيَيْنِ مِنَ الْمَغْرِبِ، وَالْأُولَيَيْنِ مِنَ الْعِشَاءِ، لَا فِي جَمِيعِ الرَّكَعَاتِ كُلِّهَا،یہ","","","","","","","تفسیر کرنے والی روایت کا بیان کہ نبی کریم صلی اللہ علیہ وسلم نماز مغرب اور عشاء کی پہلی دو رکعتوں میں بلند آواز سے قراءت کرتے تھے۔ آپ ان کی تمام رکعات میں بلند آواز سے قراءت نہیں کرتے تھے","1592","1592","1592","1592"
"1047","بَابُ الْأَمْرِ بِمُبَادَرَةِ الْإِمَامِ الْمَأْمُومَ بِالرُّكُوعِ وَالسُّجُودِامام کو مقتدی سے پہلے رکوع و سجود کرنے کا حُکم","بَابُ الْأَمْرِ بِمُبَادَرَةِ الْإِمَامِ الْمَأْمُومَ بِالرُّكُوعِ وَالسُّجُودِامام کو مقتدی سے پہلے رکوع و سجود کرنے کا حُکم","","","","","","","کا بیان","1593","1593","1593","1593"
"1048","بَابُ النَّهْيِ عَنْ مُبَادَرَةِ الْإِمَامِ الْمَأْمُومَ بِالرُّكُوعِ،مقتدی","بَابُ النَّهْيِ عَنْ مُبَادَرَةِ الْإِمَامِ الْمَأْمُومَ بِالرُّكُوعِ،مقتدی","","","","","","","کا امام سے پہلے رکوع میں جانا منع ہے۔","1594","1594","1594","1594"
"1049","بَابُ ذِكْرِ الْوَقْتِ الَّذِي فِيهِ الْمَأْمُومُ مُدْرِكًا لِلرَّكْعَةِ إِذَا رَكَعَ إِمَامُهُ قَبْلُاُس وقت کا بیان جس میں مقتدی رکعت کو پانے والا شمار ہوگا، جبکہ اُس","بَابُ ذِكْرِ الْوَقْتِ الَّذِي فِيهِ الْمَأْمُومُ مُدْرِكًا لِلرَّكْعَةِ إِذَا رَكَعَ إِمَامُهُ قَبْلُاُس وقت کا بیان جس میں مقتدی رکعت کو پانے والا شمار ہوگا، جبکہ اُس","","","","","","","کے امام نے اس سے پہلے رکوع کرلیا ہو","1595","1595","1595","1595"
"1050","بَابُ رَفْعِ الْإِمَامِ رَأْسَهُ مِنَ الرُّكُوعِ قَبْلَ الْمَأْمُومِامام کا مقتدی سے پہلے رکوع سے سر اُٹھانا","بَابُ رَفْعِ الْإِمَامِ رَأْسَهُ مِنَ الرُّكُوعِ قَبْلَ الْمَأْمُومِامام کا مقتدی سے پہلے رکوع سے سر اُٹھانا","","","","","","","","1596","1596","1596","1596"
"1051","بَابُ الْأَمْرِ بِتَحْمِيدِ الْمَأْمُومِ رَبَّهُ- عَزَّ وَجَلَّ- عِنْدَ رَفْعِ الرَّأْسِ مِنَ الرُّكُوعِ، وَرَجَاءُ مَغْفِرَةِ ذُنُوبِهِ إِذَا وَافَقَ تَحْمِيدُهُ تَحْمِيدَ الْمَلَائِكَةِرکوع سے سر اُٹھانے کے بعد مقتدی کا اللہ تعالیٰ کی حمد وثناء بیان کرنے اور اُسے","بَابُ الْأَمْرِ بِتَحْمِيدِ الْمَأْمُومِ رَبَّهُ- عَزَّ وَجَلَّ- عِنْدَ رَفْعِ الرَّأْسِ مِنَ الرُّكُوعِ، وَرَجَاءُ مَغْفِرَةِ ذُنُوبِهِ إِذَا وَافَقَ تَحْمِيدُهُ تَحْمِيدَ الْمَلَائِكَةِرکوع سے سر اُٹھانے کے بعد مقتدی کا اللہ تعالیٰ کی حمد وثناء بیان کرنے اور اُسے","","","","","","","اپنے گناہوں کی بخشش کی امید رکھنے کا بیان جبکہ اس کی حمد وثناء فرشتوں کی حمد وثنا کے موافق ہوجائے","1597","1597","1597","1597"
"1052","بَابُ مُبَادَرَةِ الْإِمَامِ الْمَأْمُومَ بِالسُّجُودِ، وَثُبُوتِ الْمَأْمُومِ قَائِمًا، وَتَرْكِهِ الِانْحِنَاءَ لِلسُّجُودِ حَتَّى يَسْجُدَ إِمَامُهُسجدہ","بَابُ مُبَادَرَةِ الْإِمَامِ الْمَأْمُومَ بِالسُّجُودِ، وَثُبُوتِ الْمَأْمُومِ قَائِمًا، وَتَرْكِهِ الِانْحِنَاءَ لِلسُّجُودِ حَتَّى يَسْجُدَ إِمَامُهُسجدہ","","","","","","","کرتے وقت امام کا مقتدی سے پہلے سجدے میں جانا اور مقتدی کا کھڑے رہنا، اور اس وقت تک سجدے کے لئے نہ جھکنا جب تک امام سجدے میں نہ چلا جائے","1598","1599","1598","1599"
"1053","بَابُ التَّغْلِيظِ فِي مُبَادَرَةِ الْمَأْمُومِ الْإِمَامَ بِرَفْعِ الرَّأْسِ مِنَ السُّجُودِسجدے سے امام سے پہلے سر اُٹھانے","بَابُ التَّغْلِيظِ فِي مُبَادَرَةِ الْمَأْمُومِ الْإِمَامَ بِرَفْعِ الرَّأْسِ مِنَ السُّجُودِسجدے سے امام سے پہلے سر اُٹھانے","","","","","","","پر مقتدی کے لئے سخت وعید کا بیان","1600","1600","1600","1600"
"1054","بَابُ ذِكْرِ إِدْرَاكِ الْمَأْمُومِ مَا فَاتَهُ مِنْ سُجُودِ الْإِمَامِ بَعْدَ رَفْعِ الْإِمَامِ رَأْسَهُ.اس بات کی بیان کہ امام کے سجدے کا جو حصّہ مقتدی سے فوت ہوجائے گا مقتدی اسے امام کے سر اُٹھانے","بَابُ ذِكْرِ إِدْرَاكِ الْمَأْمُومِ مَا فَاتَهُ مِنْ سُجُودِ الْإِمَامِ بَعْدَ رَفْعِ الْإِمَامِ رَأْسَهُ.اس بات کی بیان کہ امام کے سجدے کا جو حصّہ مقتدی سے فوت ہوجائے گا مقتدی اسے امام کے سر اُٹھانے","","","","","","","کے بعد پالے گا","1601","1601","1601","1601"
"1055","بَابُ النَّهْيِ عَنْ مُبَادَرَةِ الْمَأْمُومِ الْإِمَامَ بِالْقِيَامِ وَالْقُعُودِ.قیام","بَابُ النَّهْيِ عَنْ مُبَادَرَةِ الْمَأْمُومِ الْإِمَامَ بِالْقِيَامِ وَالْقُعُودِ.قیام","","","","","","","اور قعود (بیٹھنے) میں مقتدی کا امام سے جلدی کرنا منع ہے","1602","1602","1602","1602"
"1056","بَابُ افْتِتَاحِ الْإِمَامِ الْقِرَاءَةَ فِي الرَّكْعَةِ الثَّانِيَةِ فِي الصَّلَاةِ الَّتِي يَجْهَرُ فِيهَا مِنْ غَيْرِ سَكْتٍ قَبْلَهَاجہری","بَابُ افْتِتَاحِ الْإِمَامِ الْقِرَاءَةَ فِي الرَّكْعَةِ الثَّانِيَةِ فِي الصَّلَاةِ الَّتِي يَجْهَرُ فِيهَا مِنْ غَيْرِ سَكْتٍ قَبْلَهَاجہری","","","","","","","قراءت والی نماز میں امام دوسری رکعت میں بغیر سکتے کے قراءت شروع کرے گا","1603","1603","1603","1603"
"1057","بَابُ تَخْفِيفِ الْإِمَامِ الصَّلَاةَ مَعَ الْإِتْمَامِ.امام کا ہلکی اور مکمّل","بَابُ تَخْفِيفِ الْإِمَامِ الصَّلَاةَ مَعَ الْإِتْمَامِ.امام کا ہلکی اور مکمّل","","","","","","","نماز پڑھانا","1604","1604","1604","1604"
"1058","بَابُ النَّهْيِ عَنْ تَطْوِيلِ الْإِمَامِ الصَّلَاةَ مَخَافَةَ تَنْفِيرِ الْمَأْمُومِينَ وَقُنُوتِهِمْ.مقتدیوں","بَابُ النَّهْيِ عَنْ تَطْوِيلِ الْإِمَامِ الصَّلَاةَ مَخَافَةَ تَنْفِيرِ الْمَأْمُومِينَ وَقُنُوتِهِمْ.مقتدیوں","","","","","","","کے متنفر ہونے اور ان کے فتنے میں مبتلا ہونے کے ڈر سے امام کا لمبی نماز پڑھانا منع ہے","1605","1605","1605","1605"
"1059","بَابُ قَدْرِ قِرَاءَةِ الْإِمَامِ الَّذِي لَا يَكُونُ تَطْوِيلًا.امام","بَابُ قَدْرِ قِرَاءَةِ الْإِمَامِ الَّذِي لَا يَكُونُ تَطْوِيلًا.امام","","","","","","","کی قراءت کی اس مقدار کا بیان جو طویل شمار نہیں ہوگی","1606","1607","1606","1607"
"1060","بَابُ تَقْدِيرِ الْإِمَامِ الصَّلَاةَ بِضُعَفَاءِ الْمَأْمُومِينَ، وَكِبَارِهِمْ، وَذَوِي الْحَوَائِجِ مِنْهُمْ.امام","بَابُ تَقْدِيرِ الْإِمَامِ الصَّلَاةَ بِضُعَفَاءِ الْمَأْمُومِينَ، وَكِبَارِهِمْ، وَذَوِي الْحَوَائِجِ مِنْهُمْ.امام","","","","","","","کا کمزور، عمر رسیدہ اور ضرورت مند مقتدیوں کا خیال رکھتے ہوئے نماز پڑھانے کا بیان","1608","1608","1608","1608"
"1061","بَابُ تَخْفِيفِ الْإِمَامِ الْقِرَاءَةَ لِلْحَاجَةِ تَبْدُو لِبَعْضِ الْمَأْمُومِينَ.کسی","بَابُ تَخْفِيفِ الْإِمَامِ الْقِرَاءَةَ لِلْحَاجَةِ تَبْدُو لِبَعْضِ الْمَأْمُومِينَ.کسی","","","","","","","مقتدی کو کوئی ضرورت پیش آنے پر امام کا قراءت مختصر کردینے کا بیان","1609","1609","1609","1609"
