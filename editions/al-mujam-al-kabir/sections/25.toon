hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"14401","14363  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي غَنِيَّةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي جَنَابٍ ،  عَنْ         [13/491]      عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  دَخَلْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَتَوَضَّأُ وُضُوءًا  مَكِيثًا  ، فَقَالَ :  يَا  عَبْدَ اللهِ بْنَ عَمْرٍو  ، سِتُّ خِصَالٍ كَائِنَةٌ فِيكُمْ "" ، قُلْتُ : مَا هِيَ بِأَبِي يَا نَبِيَّ اللهِ ، جَعَلَنِي اللهُ فِدَاكَ ؟ قَالَ : "" قَبْضُ نَبِيِّكُمْ  ، فَكَأَنَّمَا انْسَلَخَ قَلْبِي ، "" قُلْ : وَاحِدَةً "" ، فَقُلْتُ : وَاحِدَةً ، قَالَ : ""  وَفَيْضُ  الْمَالِ حَتَّى يَصِيرَ إِلَى أَحَدِكُمْ أَلْفُ دِينَارٍ فَيَظَلَّ يَتَسَخَّطُهَا ، قُلِ : اثْنَتَيْنِ "" ، فَقُلْتُ : اثْنَتَيْنِ ، "" وَفِتْنَةٌ تَكُونُ فِي بَيْتِ كُلِّ امْرِئٍ مِنْكُمْ ، قُلْ : ثَلَاثًا "" ، فَقُلْتُ : ثَلَاثًا ، "" وَمَوْتٌ  كَقُعَاصِ  الْغَنَمِ ، قُلْ : أَرْبَعًا "" ، فَقُلْتُ : أَرْبَعًا ، "" وَهُدْنَةٌ تَكُونُ بَيْنَكُمْ وَبَيْنَ  بَنِي الْأَصْفَرِ  ، يَجْمَعُوا لَكُمْ حَمْلَ الْمَرْأَةِ ، وَيَكُونُونَ أَوْلَى بِالْغَدْرِ مِنْكُمْ ، قُلْ : خَمْسًا "" ، فَقُلْتُ : خَمْسًا ، "" وَفَتْحُ الْمَدِينَةِ ، قُلْ : سِتًّا "" ، فَقُلْتُ : يَا نَبِيَّ اللهِ جَعَلَنِي اللهُ فِدَاكَ ، وَأَيُّ مَدِينَةٍ ؟ قَالَ : ""  الْقُسْطَنْطِينِيَّةُ  .","","Al-Mu'jam al-Kabir 14363","","عبد الله بن عمرو بن العاص عن يحيى بن أبي حية عن عبد الملك بن حميد الخزاعي عن يحيى بن عبد الملك بن حميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14402","14364  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  غُنْدَرٌ ،  ثَنَا  شُعْبَةُ ،  عَنِ  النُّعْمَانِ بْنِ سَالِمٍ قَالَ :  سَمِعْتُ         [13/492]      يَعْقُوبَ بْنَ عَاصِمٍ يُحَدِّثُ  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَخْرُجُ  الدَّجَّالُ  فِي أُمَّتِي فَيَمْكُثُ فِيهَا  أَرْبَعِينَ "" ، لَا أَدْرِي قَالَ : يَوْمًا ، أَوْ شَهْرًا ، أَوْ سَنَةً  . "" فَيَبْعَثُ اللهُ  عِيسَى  كَأَنَّهُ  عُرْوَةُ بْنُ مَسْعُودٍ الثَّقَفِيُّ  ، فَيَطْلُبُهُ فَيُهْلِكُهُ ، ثُمَّ يَمْكُثُ النَّاسُ سَبْعَ سِنِينَ لَيْسَ بَيْنَ اثْنَيْنِ عَدَاوَةٌ ، ثُمَّ يُرْسِلُ اللهُ رِيحًا بَارِدَةً مِنَ السَّمَاءِ ، فَلَا يَبْقَى أَحَدٌ فِي قَلْبِهِ  مِثْقَالُ  حَبَّةٍ  مِنْ إِيمَانٍ إِلَّا قَبَضَتْهُ  .","","Al-Mu'jam al-Kabir 14364","","عبد الله بن عمرو بن العاص عن يعقوب بن عاصم بن عروة بن مسعود الثقفي عن النعمان بن سالم الطائفي عن شعبة بن الحجاج عن غندر ربيب شعبة عن يحيى بن معين عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14403","14365  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَبَنَا  شُعْبَةُ .         [13/493]      وَحَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  يَحْيَى بْنِ الْقِمْطَةِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو فِي قَوْلِهِ :         {      فَلَنُوَلِّيَنَّكَ قِبْلَةً تَرْضَاهَا         }      ، قَالَ : نَحْوَ مِيزَابِ  الْكَعْبَةِ  .","","Al-Mu'jam al-Kabir 14365","","عبد الله بن عمرو بن العاص عن يحيى بن قمطة الحجازي عن يعلى بن عطاء الطائفي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سفيان بن عوف عن عبد الله"
"14404","14366  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  عَنْ  شُعْبَةَ ،  أَبَنَا  يَعْلَى بْنُ عَطَاءٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ  رَجُلًا  قَالَ : يَا رَسُولَ اللهِ ، أَتَأْذَنُ لِي فِي  الْجِهَادِ  ؟ قَالَ :  أَلَكَ وَالِدَانِ ؟ "" قَالَ : نَعَمْ ، قَالَ : "" اذْهَبْ فَبِرَّهُمَا  ، فَذَهَبَ وَهُوَ يَتَخَلَّلُ الرِّكَابَ  .","","Al-Mu'jam al-Kabir 14366","","عبد الله بن عمرو بن العاص عن عطاء الطائفي عن يعلى بن عطاء الطائفي عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن الفضل بن الحباب الجمحي عن الطبراني","سفيان بن عوف عن عبد الله"
"14405","[13/494]      14367  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  رِضَا الرَّبِّ فِي رِضَا الْوَالِدِ ،  وَسَخَطُ  الرَّبِّ عَزَّ وَجَلَّ فِي  سَخَطِ  الْوَالِدِ  .  وَلَمْ يَرْفَعْهُ .","","Al-Mu'jam al-Kabir 14367","","عبد الله بن عمرو بن العاص عن عطاء الطائفي عن يعلى بن عطاء الطائفي عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14406","14368  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْقَاسِمُ بْنُ سُلَيْمٍ الصَّوَّافُ ، قَالَ :  شَهِدَ  الْوَاسِطِيَّانِ  أَبُو بِسْطَامٍ  وَأَبُو مُعَاوِيَةَ  - يَعْنِي شُعْبَةَ وَهُشَيْمًا -  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو         [13/495]      قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  رِضَا الرَّبِّ فِي رِضَا الْوَالِدَيْنِ ،  وَسَخَطُ  الرَّبِّ فِي سَخَطِهِمَا  .","","Al-Mu'jam al-Kabir 14368","","عبد الله بن عمرو بن العاص عن عطاء الطائفي عن يعلى بن عطاء الطائفي عن هشيم بن بشير عن القاسم بن سليم الصواف عن بشر بن موسى بن صالح الأسدي عن الطبراني","سفيان بن عوف عن عبد الله"
"14407","14369  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَبْدُ الْغَفَّارِ بْنُ عَبْدِ اللهِ الْمَوْصِلِيُّ ،  ثَنَا  الْمُعَافَى بْنُ عِمْرَانَ ،  ثَنَا  سُفْيَانُ وَالْحَسَنُ بْنُ عُمَارَةَ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَتْلُ الْمُؤْمِنِ عِنْدَ اللهِ أَعْظَمُ مِنْ زَوَالِ الدُّنْيَا  .","","Al-Mu'jam al-Kabir 14369","","عبد الله بن عمرو بن العاص عن عطاء الطائفي عن يعلى بن عطاء الطائفي عن الحسن بن عمارة عن المعافى بن عمران عن عبد الغفار بن عبد الله بن الزبير الزبيري عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14408","[13/496]      14370  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  دَاوُدُ بْنُ شَبِيبٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ  رَجُلًا  جَاءَ وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي ، فَقَالَ : اللهُ أَكْبَرُ ، الْحَمْدُ لِلهِ  مِلْءَ  السَّمَاوَاتِ وَالْأَرْضِ ، وَقَالَ أَشْيَاءَ لَمْ يَحْفَظْهَا  عَطَاءٌ  ، فَلَمَّا قَضَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاتَهُ ، قَالَ : "" أَيُّكُمُ الْمُتَكَلِّمُ بِالْكَلِمَاتِ ؟ "" ، فَقَالَ الرَّجُلُ : أَنَا يَا رَسُولَ اللهِ ، قَالَ :  لَقَدْ رَأَيْتُ الْمَلَائِكَةَ يُبَادِرُ بَعْضُهَا بَعْضًا  .","","Al-Mu'jam al-Kabir 14370","","عبد الله بن عمرو بن العاص عن عطاء الطائفي عن يعلى بن عطاء الطائفي عن حماد بن سلمة عن داود بن شبيب عن الفضل بن الحباب الجمحي عن الطبراني","سفيان بن عوف عن عبد الله"
"14409","[13/497]      14371  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي ،  أَبَنَا  أَبُو خَالِدٍ الْأَحْمَرُ سُلَيْمَانُ بْنُ حَيَّانَ .  وَحَدَّثَنَا  الْقَاسِمُ بْنُ زَكَرِيَّا ،  ثَنَا  أَبُو كُرَيْبٍ ،  أَبَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنْ  حَجَّاجٍ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  أَبْصَرَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَجُلَيْنِ فِي  مَسْجِدِ الْخَيْفِ  فِي أُخْرَيَاتِ النَّاسِ فَأَمَرَ بِهِمَا فَجِيءَ بِهِمَا  تُرْعَدُ  فَرَائِصُهُمَا ،  فَقَالَ :  مَا مَنَعَكُمَا مِنَ الصَّلَاةِ مَعَنَا  ؟ "" قَالَ : صَلَّيْنَا فِي رِحَالِنَا ، قَالَ : "" أَفَلَا صَلَّيْتُمْ مَعَنَا فَتَكُونُ تَطَوُّعًا ، وَصَلَاتُكُمُ الْأُولَى هِيَ الْفَرِيضَةُ ؟ ! "" .         [13/498]      هَكَذَا رَوَاهُ  الْحَجَّاجُ  ، عَنْ  يَعْلَى بْنِ عَطَاءٍ  ، عَنْ أَبِيهِ ، عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  ، وَخَالَفَ النَّاسَ فِي  إِسْنَادِهِ  .  وَرَوَاهُ  شُعْبَةُ  ،  وَأَبُو عَوَانَةَ  ،  وَهُشَيْمٌ  ،  وَإِبْرَاهِيمُ بْنُ ذِي حِمَايَةٍ  ،  وَالثَّوْرِيُّ  ،  وَهِشَامُ بْنُ حَسَّانَ  ، عَنْ  يَعْلَى بْنِ عَطَاءٍ  ، عَنْ  جَابِرِ بْنِ يَزِيدَ بْنِ الْأَسْوَدِ السُّوَائِيِّ  ، عَنْ أَبِيهِ .","","Al-Mu'jam al-Kabir 14371","","عبد الله بن عمرو بن العاص عن عطاء الطائفي عن يعلى بن عطاء الطائفي عن حجاج بن أرطاة عن سليمان بن حيان الأحمر عن أبو كريب محمد بن العلاء عن القاسم بن زكريا المطرز عن الطبراني","سفيان بن عوف عن عبد الله"
"14410","[13/499]      14372  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الْأَصْبَهَانِيُّ ،  ثَنَا  أَبُو مَسْعُودٍ ،  حَدَّثَنَا  هِشَامُ بْنُ بِلَالٍ ،  عَنْ  مُحَمَّدِ بْنِ مُسْلِمٍ الطَّائِفِيِّ ،  عَنْ  عَبَّادِ بْنِ مُوسَى ،  عَنْ  مُسْلِمِ بْنِ رِئَابٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّهُ أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنِّي سَائِلُكَ عَنْ ثَلَاثٍ ، فَقَالَ : "" سَلْ عَمَّا شِئْتَ "" ، فَقَالَ : كَمْ مُقَامُ النَّاسِ بَيْنَ يَدَيْ رَبِّ الْعَالَمِينَ يَوْمَ الْقِيَامَةِ ؟ وَمَاذَا يَشُقُّ عَلَى الْمُؤْمِنِ مِنْ ذَلِكَ الْمَقَامِ ؟ وَهَلْ بَيْنَ الْجَنَّةِ وَالنَّارِ مَنْزِلٌ ؟ فَقَالَ :  أَمَّا قَوْلُكَ فِي مُقَامِ النَّاسِ بَيْنَ يَدَيْ رَبِّ الْعَالَمِينَ يَوْمَ الْقِيَامَةِ فَأَلْفُ سَنَةٍ لَا يُؤْذَنُ لَهُمْ .  وَأُمَّا قَوْلُكَ : مَا يَشُقُّ عَلَى الْمُؤْمِنِ مِنْ ذَلِكَ الْمَقَامِ ؟ فَإِنَّ الْمُؤْمِنِينَ فَرِيقَانِ : فَأَمَّا السَّابِقُونَ فَكَالرَّجُلَيْنِ تَنَاجَيَا فَطَالَتْ  نَجْوَاهُمَا  ثُمَّ انْصَرَفَا فَأُدْخِلَا الْجَنَّةَ "" ، فَقُلْتُ : مَا أَيْسَرَ هَذَا ! هَلْ بَيْنَ الْجَنَّةِ وَالنَّارِ         [13/500]      مَنْزِلٌ ؟ قَالَ : "" بَيْنَهُمَا حَوْضِي ، شُرُفَاتُهُ عَلَى الْجَنَّةِ ، وَتَضْرِبُ شُرُفَاتُهُ عَلَى النَّارِ ، طُولُهُ شَهْرٌ وَعَرْضُهُ شَهْرٌ ، أَشَدُّ بَيَاضًا مِنَ اللَّبَنِ وَأَحْلَى مِنَ الْعَسَلِ ، فِيهِ  أَقْدَاحٌ  مِنْ فِضَّةٍ وَقَوَارِيرَ ، مَنْ شَرِبَ مِنْهُ كَأْسًا لَمْ يَجِدْ عَطَشًا وَلَا غَرَثًا ، حَتَّى يُقْضَى بَيْنَ الْعِبَادِ فَيُدْخَلَ الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 14372","","عبد الله بن عمرو بن العاص عن مسلم بن رئاب عن عباد بن موسى عن محمد بن مسلم بن سوسن الطائفي عن هشام بن بلال عن أحمد بن الفرات الضبي عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","سفيان بن عوف عن عبد الله"
"14411","14373  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ قَالَا :  ثَنَا  شُعْبَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اسْتَقْرِئُوا الْقُرْآنَ مِنْ أَرْبَعَةٍ : مِنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  ،  وَأُبَيِّ بْنِ كَعْبٍ  ،  وَمُعَاذِ بْنِ جَبَلٍ  ،  وَسَالِمٍ مَوْلَى أَبِي حُذَيْفَةَ  .","","Al-Mu'jam al-Kabir 14373","","عبد الله بن عمرو بن العاص عن مسروق بن الأجدع عن شقيق بن سلمة عن الأعمش عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14412","[13/501]      14374  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، قَالَا :  ثَنَا  شُعْبَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  لَمْ يَكُنْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَاحِشًا  وَلَا مُتَفَحِّشًا ، وَقَالَ :  إِنَّ مِنْ أَحَبِّكُمْ إِلَيَّ أَحَاسِنَكُمْ  أَخْلَاقًا  .","","Al-Mu'jam al-Kabir 14374","","عبد الله بن عمرو بن العاص عن مسروق بن الأجدع عن شقيق بن سلمة عن الأعمش عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14413","[13/502]      14375  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَبَنَا  عَبْدُ الرَّزَّاقِ ،  أَبَنَا  الثَّوْرِيُّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنْ  مَسْرُوقٍ ،  عَنْ         [13/503]      عَبْدِ اللهِ بْنِ عَمْرٍو -  أَظُنُّهُ قَدْ  رَفَعَهُ  - ، قَالَ :  أَرْبَعٌ مَنْ كُنَّ فِيهِ كَانَ مُنَافِقًا خَالِصَ النِّفَاقِ : إِذَا حَدَّثَ كَذَبَ  ، وَإِذَا اتُّمِنَ خَانَ ، وَإِذَا عَاهَدَ غَدَرَ ، وَإِذَا خَاصَمَ فَجَرَ ; فَمَنْ كَانَ فِيهِ وَاحِدَةٌ مِنْهُنَّ فَفِيهِ  خَصْلَةٌ  مِنَ النِّفَاقِ حَتَّى يَتُوبَ "" .","","Al-Mu'jam al-Kabir 14375","","عبد الله بن عمرو بن العاص عن مسروق بن الأجدع عن عبد الله بن مرة الخارفي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14414","14376  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا         [13/504]      يَحْيَى بْنُ عِيسَى وَعَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَثَلَ حَدِيثِ  الثَّوْرِيِّ  .","","Al-Mu'jam al-Kabir 14376","","عبد الله بن عمرو بن العاص عن مسروق بن الأجدع عن عبد الله بن مرة الخارفي عن الأعمش عن عبد الله بن نمير عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سفيان بن عوف عن عبد الله"
"14415","14377  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَبَنَا  شُعْبَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَرْبَعٌ مَنْ كُنَّ فِيهِ كَانَ مُنَافِقًا خَالِصًا  ، وَإِنْ كَانَتْ فِيهِ  خَصْلَةٌ  مِنْهُنَّ كَانَتْ فِيهِ خَلَّةٌ مِنَ النِّفَاقِ حَتَّى يَتْرُكَهَا : إِذَا حَدَّثَ كَذَبَ ، وَإِذَا وَعَدَ  أَخْلَفَ ،  وَإِذَا ايْتُمِنَ خَانَ ، وَإِذَا خَاصَمَ فَجَرَ "" .","","Al-Mu'jam al-Kabir 14377","","عبد الله بن عمرو بن العاص عن مسروق بن الأجدع عن عبد الله بن مرة الخارفي عن الأعمش عن شعبة بن الحجاج عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","سفيان بن عوف عن عبد الله"
"14416","14378  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  يَحْيَى         [13/505]      بْنُ يَمَانٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ،  عَنْ  أَبِيهِ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَضُرُّ مَعَ الْإِسْلَامِ ذَنْبٌ  ، كَمَا لَا يَنْفَعُ مَعَ  الشِّرْكِ  عَمَلٌ  .","","Al-Mu'jam al-Kabir 14378","","عبد الله بن عمرو بن العاص عن مسروق بن الأجدع عن محمد بن المنتشر بن الأجدع الوادعي عن إبراهيم بن محمد بن المنتشر الهمداني عن سفيان الثوري عن يحيى بن يمان العجلي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14417","14379  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُحَمَّدُ بْنُ عَمَّارٍ الْمَوْصِلِيُّ ،  ثَنَا  يَحْيَى بْنُ يَمَانٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ قَالَ : لَا إِلَهَ إِلَّا اللهُ ، لَمْ يَضُرَّهُ مَعَهَا خَطِيئَةٌ  ، كَمَا لَوْ  أَشْرَكَ  بِاللهِ لَمْ تَنْفَعْهُ مَعَهَا حَسَنَةٌ "" .  هَكَذَا رَوَاهُ  يَحْيَى بْنُ يَمَانٍ  ، وَخَالَفَهُ النَّاسُ .","","Al-Mu'jam al-Kabir 14379","","عبد الله بن عمرو بن العاص عن مسروق بن الأجدع عن محمد بن المنتشر بن الأجدع الوادعي عن إبراهيم بن محمد بن المنتشر الهمداني عن سفيان الثوري عن يحيى بن يمان العجلي عن محمد بن عبد الله بن عمار الغامدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14418","14380  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،         [13/506]      عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ،  عَنْ  أَبِيهِ  قَالَ :  جَاءَ  رَجُلٌ  أَوْ  شَيْخٌ مِنْ أَهْلِ الْمَدِينَةِ  وَنَزَلَ عَلَى مَسْرُوقٍ ، فَقَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ...  فَذَكَرَ مِثْلَ حَدِيثِ  يَحْيَى بْنِ يَمَانٍ  .","","Al-Mu'jam al-Kabir 14380","","عبد الله بن عمرو بن العاص عن مسروق بن الأجدع عن محمد بن المنتشر بن الأجدع الوادعي عن إبراهيم بن محمد بن المنتشر الهمداني عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14419","14381  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ السَّوْطِيُّ ،  ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ  أَنَّهُ سَمِعَ  إِبْرَاهِيمَ  يُحَدِّثُ عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اسْتَقْرِئُوا الْقُرْآنَ مِنْ أَرْبَعَةٍ :  عَبْدِ اللهِ بْنِ مَسْعُودٍ  ،  وَمُعَاذٍ  ،  وَأُبَيِّ بْنِ كَعْبٍ  ،  وَسَالِمٍ مَوْلَى أَبِي حُذَيْفَةَ  .","","Al-Mu'jam al-Kabir 14381","","عبد الله بن عمرو بن العاص عن مسروق بن الأجدع عن إبراهيم النخعي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن عفان بن مسلم الصفار عن أحمد بن يحيى السوطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14420","[13/507]      14382  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يُقَالُ لِصَاحِبِ الْقُرْآنِ : اقْرَأْ وَارْتَقِي  ، وَرَتِّلْ كَمَا كُنْتَ  تُرَتِّلُ  فِي الدُّنْيَا ; فَإِنَّ مَنْزِلَكَ عِنْدَ آخِرِ آيَةٍ تَقْرَؤُهَا  .         [13/508]","","Al-Mu'jam al-Kabir 14382","","عبد الله بن عمرو بن العاص عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14421","14383  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ وَحَمَّادُ بْنُ شُعَيْبٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14383","","عبد الله بن عمرو بن العاص عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن شعيب الحماني عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14422","14384  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  الرَّبِيعُ بْنُ يَحْيَى الْأُشْنَانِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ وَعَبْدِ اللهِ بْنِ أَبِي السَّفَرِ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  ، وَالْمُهَاجِرُ مَنْ هَجَرَ مَا نَهَى اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 14384","","عبد الله بن عمرو بن العاص عن الشعبي عن عبد الله بن أبي السفر الهمداني عن شعبة بن الحجاج عن الربيع بن يحيى المرئي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14423","[13/509]      14385  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  ، وَالْمُهَاجِرُ مَنْ هَجَرَ مَا نَهَى اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 14385","","عبد الله بن عمرو بن العاص عن الشعبي عن إسماعيل بن أبي خالد عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14424","[13/510]      14386  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ أَعْيَنَ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  ، وَالْمُهَاجِرُ مَنْ هَجَرَ مَا نَهَى اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 14386","","عبد الله بن عمرو بن العاص عن الشعبي عن مجالد بن سعيد عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عاصم بن علي الواسطي عن محمد بن جعفر بن أعين البغدادي عن الطبراني","سفيان بن عوف عن عبد الله"
"14425","14387  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  ثَنَا  أَبَانُ بْنُ يَزِيدَ ،  عَنْ  عَاصِمٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  ، وَالْمُهَاجِرُ مَنْ هَاجَرَ مَا نَهَى اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 14387","","عبد الله بن عمرو بن العاص عن الشعبي عن عاصم بن بهدلة عن أبان بن يزيد العطار عن موسى بن إسماعيل التبوذكي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14426","[13/511]      14388  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  زَكَرِيَّا بْنُ أَبِي زَائِدَةَ ،  حَدَّثَنِي  عَامِرٌ الشَّعْبِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  ، وَالْمُهَاجِرُ مَنْ هَجَرَ مَا نَهَى اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 14388","","عبد الله بن عمرو بن العاص عن الشعبي عن زكريا بن أبي زائدة الوادعي عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14427","14389  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  حَدَّثَنِي  عَامِرٌ الشَّعْبِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  ، وَالْمُهَاجِرُ مَنْ هَجَرَ مَا نَهَى اللهُ عَنْهُ "" .","","Al-Mu'jam al-Kabir 14389","","عبد الله بن عمرو بن العاص عن الشعبي عن زكريا بن أبي زائدة الوادعي عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14428","[13/512]      14390  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  ثَنَا  عَبِيدَةُ بْنُ حُمَيْدٍ ،  حَدَّثَنِي  بَيَانٌ ،  عَنْ  عَامِرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  ، وَالْمُهَاجِرُ مَنْ هَجَرَ مَا نَهَى اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 14390","","عبد الله بن عمرو بن العاص عن الشعبي عن بيان بن بشر الأحمسي عن عبيدة بن حميد بن صهيب التيمي عن سريج بن يونس المروزي عن موسى بن هارون الحمال عن الطبراني","سفيان بن عوف عن عبد الله"
"14429","14391  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هِشَامِ بْنِ أَبِي الدُّمَيْكِ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُطِيعٍ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  سِنَانٍ  ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْمُهَاجِرُ مَنْ هَجَرَ السُّوءَ  ، وَالْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  .  كذا في طبعة الجريسي ، وهو تصحيف ، والصواب : (بيان) كما في الحديث الذي قبله .","","Al-Mu'jam al-Kabir 14391","","عبد الله بن عمرو بن العاص عن الشعبي عن بيان بن بشر الأحمسي عن هشيم بن بشير عن عبد الله بن مطيع بن راشد البكري عن ابن أبى الدميك محمد بن هشام بن علي عن الطبراني","سفيان بن عوف عن عبد الله"
"14430","14392  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ حَفْصٍ الْأُبُلِّيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُغِيرَةَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  ، وَالْمُهَاجِرُ مَنْ هَجَرَ مَا نَهَى اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 14392","","عبد الله بن عمرو بن العاص عن الشعبي عن المغيرة بن مقسم الضبي عن سليمان بن طرخان عن معتمر بن سليمان عن إسماعيل بن حفص بن عمر بن دينار الأبلي عن الساجي عن الطبراني","سفيان بن عوف عن عبد الله"
"14431","[13/513]      14393  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  ، وَالْمُهَاجِرُ مَنْ هَاجَرَ مَا نَهَى اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 14393","","عبد الله بن عمرو بن العاص عن الشعبي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14432","14394  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَبَنَا  يَحْيَى بْنُ سَعِيدِ بْنِ حَيَّانَ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ  أَنَّ ثَلَاثَةَ نَفَرٍ دَخَلُوا عَلَى  مَرْوَانَ بْنِ الْحَكَمِ  ، فَحَدَّثَهُمْ أَنَّ أَوَّلَ الْآيَاتِ خُرُوجُ :  الدَّجَّالِ  ، فَخَرَجُوا مِنْ عِنْدِهِ فَدَخَلُوا عَلَى عَبْدِ اللهِ بْنِ عَمْرٍو ، فَأَخْبَرُوهُ بِقَوْلِ  مَرْوَانَ  ،  فَقَالَ  : لَمْ يَقُلْ شَيْئًا ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ أَوَّلَ الْآيَاتِ خُرُوجًا :         [13/514]      طُلُوعُ الشَّمْسِ مِنْ مَغْرِبِهَا  ، وَالدَّابَّةُ عَلَى أَثَرِهَا تَخْرُجُ قَرِيبًا "" ، ثُمَّ قَالَ : إِنَّ الشَّمْسَ إِذَا غَرَبَتْ أَتَتْ تَحْتَ الْعَرْشِ فَسَجَدَتْ ، فَيُقَالُ لَهَا : اطْلُعِي مِنْ حَيْثُ كُنْتِ تَطْلُعِينَ ، فَإِذَا كَانَتْ تِلْكَ اللَّيْلَةُ اسْتَأْذَنَتْ فَلَا يُرَدُّ عَلَيْهَا ، فَإِذَا ذَهَبَ مِنَ اللَّيْلِ مَا ذَهَبَ ، وَكَانَ الْأُفُقُ كَالطَّوْقِ ، وَظَنَّتْ أَنَّهَا لَوْ أُذِنَ لَهَا لَمْ تَبْلُغْ ، فَتَقُولُ : أَيْ رَبِّ ، مَا أَبْعَدَ الْمَشْرِقَ مِنَ الْمَغْرِبِ ! فَيُقَالُ لَهَا : اطْلُعِي مِنْ حَيْثُ غَرَبْتِ ; وَذَلِكَ قَوْلُ اللهِ جَلَّ ثَنَاؤُهُ :         {      هَلْ يَنْظُرُونَ إِلا أَنْ تَأْتِيَهُمُ الْمَلائِكَةُ أَوْ يَأْتِيَ رَبُّكَ أَوْ يَأْتِيَ بَعْضُ آيَاتِ رَبِّكَ         }      الْآيَةَ  .","","Al-Mu'jam al-Kabir 14394","","عبد الله بن عمرو بن العاص عن الشعبي عن يحيى بن سعيد التيمي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14433","14395  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  فِرَاسٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ         [13/515]      بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْكَبَائِرُ : الْإِشْرَاكُ بِاللهِ  ،  وَعُقُوقُ  الْوَالِدَيْنِ ، أَوْ قَتْلُ النَّفْسِ  -  شُعْبَةُ  الشَّاكُّ  - ، وَيَمِينُ  الْغَمُوسِ  .","","Al-Mu'jam al-Kabir 14395","","عبد الله بن عمرو بن العاص عن الشعبي عن فراس بن يحيى الخارفي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14434","[13/516]      14396  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ الْفَزَارِيُّ ،  ثَنَا  عُثْمَانُ بْنُ الْحَارِثِ ابْنِ بِنْتِ الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  سَأَلْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي كَمْ أَقْرَأُ ؟ قَالَ : "" اقْرَأْهُ فِي أَرْبَعَ عَشْرَةَ  ، فَلَمْ أَزَلْ أُخْبِرُهُ أَنِّي أُطِيقُهُ فِي أَقَلَّ مِنْ ذَلِكَ ، حَتَّى قَالَ : "" اقْرَأْهُ فِي أَرْبَعٍ "" ، فَمَا فَارَقَنِي بَعْدَ ذَلِكَ ، وَلَوَدِدْتُ أَنِّي كُنْتُ قَبِلْتُ الرُّخْصَةَ  .","","Al-Mu'jam al-Kabir 14396","","عبد الله بن عمرو بن العاص عن عثمان بن الحارث الكوفي عن مروان بن معاوية الفزاري عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14435","14397  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي سَهْمٍ الْأَنْطَاكِيُّ ( 1 ) ،  ثَنَا  أَبُو إِسْحَاقَ الْفَزَارِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ         [13/517]      شَوْذَبٍ ،  حَدَّثَنِي  عَامِرُ بْنُ عَبْدِ الْوَاحِدِ الْأَحْوَلُ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا أَصَابَ مَغْنَمًا أَمَرَ  بِلَالًا  فَنَادَى فِي النَّاسِ ثَلَاثًا ، فَيَجِيءُ النَّاسُ بِغَنَائِمِهِمْ وَيُقَسِّمُهُ ، فَأَتَاهُ  رَجُلٌ  بَعْدَ ذَلِكَ بِزِمَامٍ مِنْ شَعَرٍ ، فَقَالَ : يَا رَسُولَ اللهِ ، هَذَا مَا كُنَّا أَصَبْنَا مِنَ الْغَنِيمَةِ ، فَقَالَ : "" أَمَا سَمِعْتَ  بِلَالًا  يُنَادِي ثَلَاثًا ؟ "" قَالَ : نَعَمْ ، قَالَ : "" فَمَا مَنَعَكَ أَنْ تَجِيءَ بِهِ ؟ "" ، وَاعْتَذَرَ إِلَيْهِ ، فَقَالَ :  كُنْ أَنْتَ الَّذِي تَجِيءُ بِهِ يَوْمَ الْقِيَامَةِ ، فَلَنْ أَقْبَلَهُ مِنْكَ  !  .","","Al-Mu'jam al-Kabir 14397","","عبد الله بن عمرو بن العاص عن عبد الله بن بريدة عن عامر بن عبد الواحد الأحول عن عبد الله بن شوذب عن أبو إسحاق الفزاري عن محمد بن عبد الرحمن بن حكيم الأنطاكي عن موسى بن هارون الحمال عن الطبراني","سفيان بن عوف عن عبد الله"
"14436","14398  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  أَحْمَدُ بْنُ عَبْدَةَ ،  ثَنَا  حُسَيْنٌ الْأَشْقَرُ ،  ثَنَا  شَرِيكٌ ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ،  عَنْ         [13/518]      أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَيَّامُ  التَّشْرِيقِ  أَيَّامُ أَكْلٍ  وَشُرْبٍ  ; فَلَا يَصُومَنَّهَا أَحَدٌ  .","","Al-Mu'jam al-Kabir 14398","","عبد الله بن عمرو بن العاص عن سليم بن أسود المحاربي عن أشعث بن أبي الشعثاء عن شريك بن عبد الله النخعي عن الحسين بن الحسن الأشقر عن أحمد بن عبدة الضبي عن إبراهيم بن هاشم البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14437","14399  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ الدُّورِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ الرَّازِيُّ ،  ثَنَا  سَلَمَةُ بْنُ الْفَضْلِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  حَكِيمِ بْنِ جُبَيْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَشْقَى النَّاسِ ثَلَاثَةٌ  : عَاقِرُ نَاقَةِ  ثَمُودَ  ،  وَابْنُ آدَمَ  الَّذِي قَتَلَ أَخَاهُ ; مَا  سُفِكَ  عَلَى الْأَرْضِ مِنْ دَمٍ إِلَّا لَحِقَهُ مِنْهُ ; لِأَنَّهُ أَوَّلُ مَنْ سَنَّ الْقَتْلَ  .","","Al-Mu'jam al-Kabir 14399","","عبد الله بن عمرو بن العاص عن سعيد بن جبير الأسدي عن حكيم بن جبير الأسدي عن محمد بن إسحاق عن سلمة بن الفضل الأبرش عن محمد بن حميد الرازي عن الهيثم بن خلف الدوري عن الطبراني","سفيان بن عوف عن عبد الله"
"14438","[13/519]      14400  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  يَعْلَى بْنُ عُبَيْدٍ .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سَعِيدٍ الْأَزْدِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  .","","Al-Mu'jam al-Kabir 14400","","عبد الله بن عمرو بن العاص عن أبو سعد ، ويقال عن الأعمش عن يعلى بن عبيد الطنافسي عن محمد بن عبد الله بن نمير عن عبيد بن غنام النخعي عن الطبراني","سفيان بن عوف عن عبد الله"
"14439","14401  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  مُحَاضِرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي السَّفَرِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  مَرَّ بِنَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَنَحْنُ نَبْنِي  قُبَّةً  ، فَقَالَ :  الْأَمْرُ لَأَسْرَعُ مِنْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 14401","","عبد الله بن عمرو بن العاص عن سعيد بن يحمد الهمداني عن الأعمش عن محاضر بن المورع الهمداني عن محمد بن عبد الله بن نمير عن عبيد بن غنام النخعي عن الطبراني","سفيان بن عوف عن عبد الله"
"14440","[13/520]      14402  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي السَّفَرِ سَعِيدِ بْنِ يُحْمِدَ ،  عَنْ         [13/521]      عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  مَرَّ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَنَحْنُ نُصْلِحُ  خُصًّا  لَنَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا هَذَا ؟ "" فَقُلْنَا :  خُصًّا  لَنَا  وَهَى  فَنَحْنُ نُصْلِحُهَا ، قَالَ :  مَا أَرَى الْأَمْرَ إِلَّا أَعْجَلَ مِنْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 14402","","عبد الله بن عمرو بن العاص عن سعيد بن يحمد الهمداني عن الأعمش عن أبو معاوية الضرير عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14441","14403  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  بَكْرُ بْنُ خَلَفٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ بَكْرٍ السَّهْمِيُّ ،  عَنْ  حَاتِمِ بْنِ أَبِي صَغِيرَةَ ،  عَنْ  أَبِي بَلْجٍ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ الْأَوْدِيِّ  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا عَلَى الْأَرْضِ مِنْ رَجُلٍ يَقُولُ : لَا إِلَهَ إِلَّا اللهُ ، وَاللهُ أَكْبَرُ  ، وَسُبْحَانَ اللهِ ، وَالْحَمْدُ لِلهِ ، وَلَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ ; إِلَّا كُفِّرَتْ ذُنُوبُهُ ، وَلَوْ كَانَتْ أَكْثَرَ مِنْ زَبَدِ الْبَحْرِ  .","","Al-Mu'jam al-Kabir 14403","","عبد الله بن عمرو بن العاص عن عمرو بن ميمون الأودي عن أبو بلج يحيى بن سليم الفزاري عن حاتم بن أبي صغيرة القشيري عن عبد الله بن بكر بن حبيب عن بكر بن خلف عن محمد بن علي بن زيد الصائغ عن الطبراني","سفيان بن عوف عن عبد الله"
"14442","[13/522]      14404  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  يَحْيَى بْنُ مُحَمَّدِ بْنِ السَّكَنِ ،  ثَنَا  يَحْيَى بْنُ كَثِيرٍ الْعَنْبَرِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي بَلْجٍ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ         [13/523]      رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ لَمْ تُذْنِبُونَ لَخَلَقَ اللهُ خَلْقًا يُذْنِبُونَ ثُمَّ يَغْفِرُ لَهُمْ  .","","Al-Mu'jam al-Kabir 14404","","عبد الله بن عمرو بن العاص عن عمرو بن ميمون الأودي عن أبو بلج يحيى بن سليم الفزاري عن شعبة بن الحجاج عن يحيى بن كثير العنبري عن يحيى بن محمد بن السكن البزاز عن محمد بن صالح النرسي عن الطبراني","سفيان بن عوف عن عبد الله"
"14443","14405  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ وَالْحَسَنُ بْنُ الْعَبَّاسِ الرَّازِيَّانِ ، قَالَا :  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ الْبَكَّائِيُّ ،  عَنْ  لَيْثٍ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  خَيْثَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،         [13/524]      عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ سَرَّهُ أَنْ يُزَحْزَحَ عَنِ النَّارِ وَأَنْ يَدْخُلَ الْجَنَّةَ ; فَلْتَأْتِهِ مَنِيَّتُهُ وَهُوَ يَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ  وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، وَيُحِبُّ أَنْ يَأْتِيَ إِلَى النَّاسِ مَا يُحِبُّ أَنْ يُؤْتَى إِلَيْهِ  .","","Al-Mu'jam al-Kabir 14405","","عبد الله بن عمرو بن العاص عن خيثمة بن عبد الرحمن الجعفي عن طلحة بن مصرف الهمداني عن ليث بن أبي سليم عن زياد بن عبد الله البكائي عن سهل بن عثمان العسكري عن الجمال الحسن بن العباس عن الطبراني","سفيان بن عوف عن عبد الله"
"14444","14406  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  سَعِيدُ بْنُ مُحَمَّدٍ الْجَرْمِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْمَلِكِ بْنِ أَبْجَرَ ،  عَنْ  أَبِيهِ  ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  خَيْثَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَفَى إِثْمًا أَنْ يَحْبِسَ عَمَّنْ  يَعُولُ  قُوتَهُ  .","","Al-Mu'jam al-Kabir 14406","","عبد الله بن عمرو بن العاص عن خيثمة بن عبد الرحمن الجعفي عن طلحة بن مصرف الهمداني عن عبد الملك بن سعيد بن حيان عن عبد الرحمن بن عبد الملك الكناني عن سعيد بن محمد الجرمي عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14445","[13/525]      14407  -  حَدَّثَنَا  جَعْفَرُ بْنُ أَحْمَدَ بْنِ سِنَانٍ الْوَاسِطِيُّ وَمُحَمَّدُ بْنُ أَبَانَ الْأَصْبَهَانِيُّ ; قَالَا :  ثَنَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ ،  ثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  ثَنَا  الْحَرِيشُ بْنُ سُلَيْمٍ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  خَيْثَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اقْرَأِ الْقُرْآنَ فِي شَهْرٍ  ، قُلْتُ : يَا رَسُولَ اللهِ زِدْنِي ، قَالَ : "" اقْرَأْ فِي ثَلَاثٍ "" ، فَاسْتَزَدْتُهُ فَأَبَى .","","Al-Mu'jam al-Kabir 14407","","عبد الله بن عمرو بن العاص عن خيثمة بن عبد الرحمن الجعفي عن طلحة بن مصرف الهمداني عن حريش بن سليم الجعفي عن أبو داود الطيالسي عن الفلاس عن محمد بن أبان الأصبهاني عن الطبراني","سفيان بن عوف عن عبد الله"
"14446","14408  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  مُحَمَّدُ بْنُ طَلْحَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  خَيْثَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  خُذُوا الْقُرْآنَ مِنْ أَرْبَعَةٍ  : مِنِ  ابْنِ أُمِّ عَبْدٍ  ،  وَأُبَيِّ بْنِ كَعْبٍ  ،  وَمُعَاذِ بْنِ جَبَلٍ  ،  وَسَالِمٍ مَوْلَى أَبِي حُذَيْفَةَ  .","","Al-Mu'jam al-Kabir 14408","","عبد الله بن عمرو بن العاص عن خيثمة بن عبد الرحمن الجعفي عن الأعمش عن محمد بن طلحة بن مصرف الهمداني عن سليمان بن حرب الواشحي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14447","[13/526]      14409  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ زُنْبُورٍ ،  ثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  خَيْثَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  لَا أَزَالُ أُحِبُّ  ابْنَ مَسْعُودٍ  بَعْدَمَا بَدَأَ بِهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  خُذُوا الْقُرْآنَ مِنْ أَرْبَعَةٍ  : مِنِ  ابْنِ أُمِّ عَبْدٍ  ،  وَأُبَيِّ بْنِ كَعْبٍ  ،  وَمُعَاذِ بْنِ جَبَلٍ  ،  وَسَالِمٍ مَوْلَى أَبِي حُذَيْفَةَ  .","","Al-Mu'jam al-Kabir 14409","","عبد الله بن عمرو بن العاص عن خيثمة بن عبد الرحمن الجعفي عن الأعمش عن الفضيل بن عياض عن محمد بن زنبور الهاشمي عن الساجي عن الطبراني","سفيان بن عوف عن عبد الله"
"14448","14410  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  عَنْ  شَرِيكٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  خَيْثَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،  رَفَعَ  الْحَدِيثَ ، قَالَ :  مَثَلُ الَّذِي يَجْلِسُ         [13/527]      عَلَى فِرَاشِ  الْمُغِيبَةِ  ; مَثَلُ الَّذِي يَنْهَشُهُ أَسْوَدُ مِنْ  أَسَاوِدِ  يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 14410","","عبد الله بن عمرو بن العاص عن خيثمة بن عبد الرحمن الجعفي عن الأعمش عن شريك بن عبد الله النخعي عن إسحاق بن يوسف الأزرق عن زكريا بن يحيى زحمويه عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14449","14411  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ ،  ثَنَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ ،  ثَنَا  الْمُحَارِبِيُّ قَالَ :  سَمِعْتُ  الْأَعْمَشَ وَالْعَلَاءُ بْنُ الْمُسَيِّبِ ;  ذَكَرَا عَنْ  خَيْثَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  يَرْفَعُهُ  ، قَالَ :  سَبَّابُ  الْمَيِّتِ -  وَقَالَ مَرَّةً : الْمَوْتَى  - كَالْمُشْرِفِ عَلَى الْهَلَكَةِ  .","","Al-Mu'jam al-Kabir 14411","","عبد الله بن عمرو بن العاص عن خيثمة بن عبد الرحمن الجعفي عن الأعمش عن عبد الرحمن بن محمد المحاربي عن يحيى بن سليمان بن يحيى عن روح بن الفرج القطان عن الطبراني","سفيان بن عوف عن عبد الله"
"14450","[13/528]      14412  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  خَالِدُ بْنُ يَزِيدَ بْنِ صَفْوَانَ الرَّمْلِيُّ ،  حَدَّثَنَا  عَبْدُ الْغَفَّارِ بْنُ الْحَسَنِ .  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ أَبِي سُفْيَانَ ،  ثَنَا  عَبْدُ الْغَفَّارِ بْنُ الْحَسَنِ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  خَيْثَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَا يَقْبِضُ الْعِلْمَ انْتِزَاعًا يَنْتَزِعُهُ مِنَ النَّاسِ  ، وَلَكِنْ يَقْبِضُ الْعُلَمَاءَ ، حَتَّى إِذَا لَمْ يُبْقِ عَالِمًا اتَّخَذَ النَّاسُ رُؤُوسًا جُهَّالًا ، فَسُئِلُوا فَأَفْتَوْا بِغَيْرِ عِلْمٍ فَضَلُّوا وَأَضَلُّوا  .","","Al-Mu'jam al-Kabir 14412","","عبد الله بن عمرو بن العاص عن خيثمة بن عبد الرحمن الجعفي عن الأعمش عن سفيان الثوري عن عبد الغفار بن الحسن بن دينار الرملي عن خالد بن يزيد بن صفوان الرملي عن إبراهيم بن دحيم الدمشقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14451","14413  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  ثَنَا  عَلِيُّ بْنُ سُلَيْمَانَ بْنِ أَبِي الرِّقَاعِ الْمِصْرِيُّ ،  ثَنَا  أَبُو الْفَضْلِ الْقُرَشِيُّ مِنْ وَلَدِ عُقْبَةَ بْنِ أَبِي         [13/529]      مُعَيْطٍ ،  ثَنَا  الْأَعْمَشُ ،  عَنْ  خَيْثَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُؤَذِّنُ الْمُؤَذِّنُ وَيُقِيمُ الصَّلَاةَ قَوْمٌ وَمَا هُمْ بِمُؤْمِنِينَ  .","","Al-Mu'jam al-Kabir 14413","","عبد الله بن عمرو بن العاص عن خيثمة بن عبد الرحمن الجعفي عن الأعمش عن أبو الفضل القرشي من ولد عقبة بن أبي معيط عن على بن سليمان بن بشر الإخميمي عن روح بن الفرج القطان عن الطبراني","سفيان بن عوف عن عبد الله"
"14452","14414  -  حَدَّثَنَا  الْقَاسِمُ بْنُ زَكَرِيَّا ، قَالَ :  أَعْطَانِي عَبْدُ الرَّحِيمِ بْنُ مُحَمَّدٍ السُّكَّرِيُّ كِتَابًا ، فَكَتَبْتُ مِنْهُ  :  حَدَّثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  ثَنَا  أَبَانُ بْنُ تَغْلِبَ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  خَيْثَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ سَمَّعَ النَّاسَ بِعَمَلِهِ سَمَّعَ اللهُ بِهِ  سَامِعَ  خَلْقِهِ ، وَصَغَّرَهُ وَحَقَّرَهُ "" .","","Al-Mu'jam al-Kabir 14414","","عبد الله بن عمرو بن العاص عن خيثمة بن عبد الرحمن الجعفي عن عمرو بن مرة المرادي عن أبان بن تغلب بن رياح عن عباد بن العوام الكلابي عن عبد الرحيم بن محمد السكري عن القاسم بن زكريا المطرز عن الطبراني","سفيان بن عوف عن عبد الله"
"14453","[13/530]      14415  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  جَرِيرٌ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  خَيْثَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  لَعَنَ اللهُ الْخَمْرَ ، وَعَاصِرَهَا  ، وَشَارِبَهَا ، وَسَاقِيَهَا ، وَبَائِعَهَا ، وَمُبْتَاعَهَا ، وَحَامِلَهَا ، وَالْمَحْمُولَةَ إِلَيْهِ ، وَآكِلَ ثَمَنِهَا .","","Al-Mu'jam al-Kabir 14415","","عبد الله بن عمرو بن العاص عن خيثمة بن عبد الرحمن الجعفي عن طلحة بن مصرف الهمداني عن ليث بن أبي سليم عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14454","14416  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنْ  أَبِي يَحْيَى ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأَى قَوْمًا يَتَوَضَّؤُونَ ، فَرَأَى أَعْقَابَهُمْ تَلُوحُ ، فَقَالَ :  وَيْلٌ  لِلْأَعْقَابِ  مِنَ النَّارِ  ! أَسْبِغُوا الْوُضُوءَ  "" .","","Al-Mu'jam al-Kabir 14416","","عبد الله بن عمرو بن العاص عن مصدع المعرقب عن هلال بن يساف الأشجعي عن منصور بن المعتمر عن سفيان الثوري عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14455","[13/531]      14417  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنْ  أَبِي يَحْيَى ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  مَرَّ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى قَوْمٍ يَتَوَضَّؤُونَ فِي سَفَرٍ ، فَقَالَ :  أَسْبِغُوا الْوُضُوءَ ، وَيْلٌ  لِلْأَعْقَابِ  مِنَ النَّارِ  !  .","","Al-Mu'jam al-Kabir 14417","","عبد الله بن عمرو بن العاص عن مصدع المعرقب عن هلال بن يساف الأشجعي عن منصور بن المعتمر عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن عثمان بن عمر الضبي عن الطبراني","سفيان بن عوف عن عبد الله"
"14456","14418  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَبَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنْ  أَبِي يَحْيَى ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ الْقَاعِدِ عَلَى النِّصْفِ مِنْ صَلَاةِ الْقَائِمِ  .","","Al-Mu'jam al-Kabir 14418","","عبد الله بن عمرو بن العاص عن مصدع المعرقب عن هلال بن يساف الأشجعي عن منصور بن المعتمر عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن عثمان بن حفص الضبي عن الطبراني","سفيان بن عوف عن عبد الله"
"14457","[13/532]      14419  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنْ  أَبِي يَحْيَى ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُصَلِّي جَالِسًا ، فَقُلْتُ : يَا رَسُولَ اللهِ ، حُدِّثْتُ أَنَّكَ قُلْتَ :  صَلَاةُ الْقَاعِدِ عَلَى النِّصْفِ مِنْ صَلَاةِ الْقَائِمِ "" ، وَأَنْتَ تُصَلِّي قَاعِدًا ؟ ! قَالَ : "" أَجَلْ ، وَلَكِنِّي لَسْتُ كَأَحَدِكُمْ  .","","Al-Mu'jam al-Kabir 14419","","عبد الله بن عمرو بن العاص عن مصدع المعرقب عن هلال بن يساف الأشجعي عن منصور بن المعتمر عن سفيان الثوري عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14458","14420  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنْ  أَبِي يَحْيَى ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : بَلَغَنِي أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ الرَّجُلِ جَالِسًا نِصْفُ الصَّلَاةِ  ، فَدَخَلْتُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ جَالِسٌ يُصَلِّي ! فَقُلْتُ :         [13/533]      يَا رَسُولَ اللهِ ، بَلَغَنِي أَنَّكَ قُلْتَ : "" صَلَاةُ الرَّجُلِ جَالِسًا نِصْفُ الصَّلَاةِ "" وَأَنْتَ تُصَلِّي جَالِسًا ؟! قَالَ : "" أَجَلْ ، وَلَكِنِّي لَسْتُ كَأَحَدِكُمْ  .","","Al-Mu'jam al-Kabir 14420","","عبد الله بن عمرو بن العاص عن مصدع المعرقب عن هلال بن يساف الأشجعي عن منصور بن المعتمر عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","سفيان بن عوف عن عبد الله"
"14459","14421  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  زِيَادِ بْنِ فَيَّاضٍ ،  عَنْ  أَبِي عِيَاضٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صُمْ مِنْ كُلِّ شَهْرٍ يَوْمًا وَلَكَ أَجْرُ مَا بَقِيَ  ، وَصُمْ يَوْمَيْنِ وَلَكَ أَجْرُ مَا بَقِيَ ، وَصُمْ ثَلَاثَةَ أَيَّامٍ وَلَكَ أَجْرُ مَا بَقِيَ ، وَصُمْ أَرْبَعَةَ أَيَّامٍ وَلَكَ أَجْرُ مَا بَقِيَ "" ، قَالَ : "" فَصِيَامُ أَفْضَلِ الصَّوْمِ : صِيَامُ يَوْمٍ وَإِفْطَارُ يَوْمٍ  .","","Al-Mu'jam al-Kabir 14421","","عبد الله بن عمرو بن العاص عن عمرو أو عمير بن الأسود الداراني عن زياد بن فياض الخزاعي عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14460","[13/534]      14422  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  مُحَمَّدُ بْنُ سَعِيدٍ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  زِيَادِ بْنِ فَيَّاضٍ ،  عَنْ  أَبِي عِيَاضٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو .  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  شَرِيكٌ ،  عَنْ  زِيَادِ بْنِ فَيَّاضٍ ،  عَنْ  أَبِي عِيَاضٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو - رَفَعَهُ - ، قَالَ :  نَهَى عَنِ  الدُّبَّاءِ  وَالْحَنْتَمِ  وَالْمُزَفَّتِ  ، فَقَالَ  أَعْرَابِيٌّ  : لَا ظُرُوفَ ! فَقَالَ : "" اشْرَبُوا ، وَاجْتَنِبُوا كُلَّ مُسْكِرٍ "" .","","Al-Mu'jam al-Kabir 14422","","عبد الله بن عمرو بن العاص عن عمرو أو عمير بن الأسود الداراني عن زياد بن فياض الخزاعي عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن سعيد حمدان عن بشر بن موسى بن صالح الأسدي عن الطبراني","سفيان بن عوف عن عبد الله"
"14461","14423  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  ثَنَا  الثَّوْرِيُّ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  جَابَانَ ،  عَنْ         [13/535]      عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَدْخُلُ الْجَنَّةَ عَاقٌّ  ، وَلَا  مُدْمِنُ  خَمْرٍ ، وَلَا مَنَّانٌ ، وَلَا وَلَدُ زِنًى  .","","Al-Mu'jam al-Kabir 14423","","عبد الله بن عمرو بن العاص عن جابان عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14462","[13/536]      14424  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ عِمْرَانَ بْنِ أَبِي لَيْلَى ،  حَدَّثَنِي  أَبِي  ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  جَابَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَدْخُلُ الْجَنَّةَ أَرْبَعَةٌ  :  الْمُدْمِنُ  الْخَمْرَ ، وَالْعَاقُّ وَالِدَيْهِ ، وَوَلَدُ الزِّنَى ، وَالْمَنَّانُ "" .","","Al-Mu'jam al-Kabir 14424","","عبد الله بن عمرو بن العاص عن جابان عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن عثمان بن أبي شيبة عن الطبراني","سفيان بن عوف عن عبد الله"
"14463","14425  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  يَحْيَى بْنِ هَانِئٍ  أَنَّ رَجُلًا قَالَ لِعَبْدِ اللهِ بْنِ عَمْرٍو :  عَلِيٌّ  كَانَ أَوْلَى أَمْ  مُعَاوِيَةُ  ؟ قَالَ : لَا ، بَلْ  عَلِيٌّ  .  قُلْتُ : فَمَا أَخْرَجَكَ ؟ قَالَ : أَمَا إِنِّي لَمْ أَضْرِبْ بِسَيْفٍ وَلَمْ أَرْمِ بِسَهْمٍ ، وَلَكِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَطِعْ أَبَاكَ  ، فَأَطَعْتُهُ  .","","Al-Mu'jam al-Kabir 14425","","عبد الله بن عمرو بن العاص عن يحيى بن هانئ بن عروة المرادي عن سفيان الثوري عن وكيع بن الجراح عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14464","14426  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  جَنْدَلُ بْنُ         [13/537]      وَالِقٍ ،  ثَنَا  مِنْدَلُ بْنُ عَلِيٍّ ،  عَنْ  أَبِي سِنَانٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي الْهُذَيْلِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ أَكْبَرَ الْإِثْمِ عِنْدَ اللهِ أَنْ يُضَيِّعَ الرَّجُلُ مَنْ  يَقُوتُ  .","","Al-Mu'jam al-Kabir 14426","","عبد الله بن عمرو بن العاص عن عبد الله بن أبي الهذيل الغنوي عن ضرار بن مرة الشيباني عن مندل بن علي عن جندل بن والق التغلبي عن محمد بن عثمان بن أبي شيبة عن الطبراني","سفيان بن عوف عن عبد الله"
"14465","14427  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  خَالِدٌ ،  عَنْ  أَبِي سِنَانٍ ضِرَارِ بْنِ مُرَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي الْهُذَيْلِ ،  عَنْ  شَيْخٍ مِنَ النَّخَعِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : سَمِعْتُ نَبِيَّكُمْ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  أَعُوذُ بِكَ مِنْ نَفْسٍ لَا تَشْبَعُ  ، وَمِنْ قَلْبٍ لَا يَخْشَعُ ، وَمِنْ دُعَاءٍ لَا  يُسْمَعُ  ، وَمَنْ عِلْمٍ لَا يَنْفَعُ ، أَعُوذُ بِكَ مِنْ هَؤُلَاءِ الْأَرْبَعِ  .","","Al-Mu'jam al-Kabir 14427","","عبد الله بن عمرو بن العاص عن شيخ من النخع عن عبد الله بن أبي الهذيل الغنوي عن ضرار بن مرة الشيباني عن خالد بن عبد الله الطحان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14466","14428  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هِشَامِ بْنِ أَبِي الدُّمَيْكِ الْمُسْتَمْلِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُطِيعٍ ،  ثَنَا  هُشَيْمٌ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنِ  الْأَسْوَدِ بْنِ         [13/538]      مَسْعُودٍ ،  عَنْ  حَنْظَلَةَ بْنِ خُوَيْلِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ  لِعَمَّارٍ  :  تَقْتُلُكَ  الْفِئَةُ  الْبَاغِيَةُ  .","","Al-Mu'jam al-Kabir 14428","","عبد الله بن عمرو بن العاص عن حنظلة بن خويلد الغنوي عن الأسود بن مسعود العنزي عن العوام بن حوشب عن هشيم بن بشير عن عبد الله بن مطيع بن راشد البكري عن ابن أبى الدميك محمد بن هشام بن علي عن الطبراني","سفيان بن عوف عن عبد الله"
"14467","14429  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  حَدَّثَنَا  عَوْنُ بْنُ سَلَّامٍ ،  ثَنَا  عِيسَى بْنُ عَبْدِ الرَّحْمَنِ السُّلَمِيُّ ،  عَنْ  أَبِي الْحَارِّ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو - وَلَا أَظُنُّهُ إِلَّا  رَفَعَهُ  - ، قَالَ :  مَنْ قَالَ كُلَّ يَوْمٍ مِائَةَ مَرَّةٍ : لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ  ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، كُتِبَ أَفْضَلَ أَهْلِ ذَلِكَ الْيَوْمِ عَمَلًا إِلَّا مَنْ قَالَ مِثْلَ مَا قَالَ : أَوْ أَكْثَرَ "" .","","Al-Mu'jam al-Kabir 14429","","عبد الله بن عمرو بن العاص عن أبو الحار عن عيسى بن عبد الرحمن السلمي عن عون بن سلام الهاشمي عن موسى بن هارون الحمال عن الطبراني","سفيان بن عوف عن عبد الله"
"14468","[13/539]      14430  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  مُسْلِمٍ الْأَعْوَرِ ،  عَنْ  حَبَّةَ الْعُرَنِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  قَاتِلُ عَمَّارٍ وَسَالِبُهُ فِي النَّارِ  .","","Al-Mu'jam al-Kabir 14430","","عبد الله بن عمرو بن العاص عن حبة بن جوين العرني عن مسلم بن كيسان البراد عن محمد بن فضيل بن غزوان عن سفيان بن وكيع بن الجراح عن محمد بن عثمان بن أبي شيبة عن الطبراني","سفيان بن عوف عن عبد الله"
"14469","14431  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  هَارُونُ بْنُ         [13/540]      حَاتِمٍ ،  ثَنَا  عَبِيدَةُ بْنُ حُمَيْدٍ ،  عَنْ  عَمَّارٍ الدُّهْنِيِّ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَدْخُلُ الْجَنَّةَ عَاقٌّ  ، وَلَا مَنَّانٌ ، وَلَا  مُدْمِنُ  الْخَمْرِ ، وَلَا وَلَدُ زِنًى  .","","Al-Mu'jam al-Kabir 14431","","عبد الله بن عمرو بن العاص عن هلال بن يساف الأشجعي عن عمار بن معاوية الدهني عن عبيدة بن حميد بن صهيب التيمي عن هارون بن حاتم البزاز عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14470","14432  -  حَدَّثَنَا  الْقَاسِمُ بْنُ زَكَرِيَّا وَعَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ; قَالَا :  ثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ ،  ثَنَا  هَارُونُ بْنُ الْمُغِيرَةِ ،  عَنْ  عَمْرِو بْنِ أَبِي قَيْسٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا رَأَيْتُمُ الْمَدَّاحِينَ  فَاحْثُوا  فِي وُجُوهِهِمُ  التُّرَابَ  .","","Al-Mu'jam al-Kabir 14432","","عبد الله بن عمرو بن العاص عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن عمرو بن أبي قيس عن هارون بن المغيرة المروزي عن محمد بن حميد الرازي عن علي بن سعيد بن بشير عليك عن الطبراني","سفيان بن عوف عن عبد الله"
"14471","14433  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ وَعَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ زَنْجَلَةَ ،  ثَنَا  أَبُو زُهَيْرٍ عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ ،         [13/541]      عَنِ  ابْنِ أَبْجَرَ ،  عَنْ  نُعَيْمِ بْنِ أَبِي هِنْدٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اتَّقُوا هَذِهِ الْمَذَابِحَ  ،  يَعْنِي : الْمَحَارِيبَ  .","","Al-Mu'jam al-Kabir 14433","","عبد الله بن عمرو بن العاص عن سالم بن أبي الجعد الغطفاني عن نعيم بن أبي هند الأشجعي عن عبد الملك بن سعيد بن حيان عن عبد الرحمن بن مغراء الدوسي عن سهل بن أبي سهل الأشتر عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","سفيان بن عوف عن عبد الله"
"14472","14434  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَبَنَا  خَالِدٌ ،  عَنْ  مُطَرِّفِ بْنِ طَرِيفٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو .         [13/542]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  جَرِيرٌ ،  عَنْ  مُطَرِّفٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْتُ :  إِنِّي خَتَمْتُ الْقُرْآنَ ، فَفِي كَمْ أَقْرَؤُهُ ؟ قَالَ : "" فِي شَهْرٍ  ، قُلْتُ : إِنِّي أُطِيقُ ، قَالَ : "" فَفِي خَمْسٍ وَعِشْرِينَ "" ، فَقُلْتُ : إِنِّي أُطِيقُ ، قَالَ : "" فَفِي عِشْرِينَ "" ، قُلْتُ : إِنِّي أُطِيقُ ، قَالَ : "" فَفِي خَمْسَ عَشْرَةَ "" ، قُلْتُ : إِنِّي أُطِيقُ ، قَالَ : "" فَفِي خَمْسٍ "" ، قُلْتُ : إِنِّي أُطِيقُ ، فَقَالَ : "" لَا "" .","","Al-Mu'jam al-Kabir 14434","","عبد الله بن عمرو بن العاص عن أبو بردة بن أبي موسى الأشعري عن أبو إسحاق السبيعي عن مطرف بن طريف عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","سفيان بن عوف عن عبد الله"
"14473","14435  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى وَمُوسَى بْنُ هَارُونَ ،  ثَنَا  يَزِيدُ بْنُ مِهْرَانَ أَبُو خَالِدٍ الْخَبَّازُ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  أَبِي حَصِينٍ ،  عَنِ  الْقَاسِمِ بْنِ مُخَيْمِرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الْعَبْدَ إِذَا اشْتَكَى يَقُولُ اللهُ لِمَلَائِكَتِهِ :  اكْتُبُوا لِعَبْدِي مَا كَانَ         [13/543]      يَعْمَلُ طُلُقًا حَتَّى يَبْدُوَ لِي أَقْبِضُهُ أَمْ أُطْلِقُهُ  .","","Al-Mu'jam al-Kabir 14435","","عبد الله بن عمرو بن العاص عن القاسم بن مخيمرة عن عثمان بن عاصم بن حصين عن أبو بكر بن عياش عن يزيد بن مهران الخباز عن موسى بن هارون الحمال عن الطبراني","سفيان بن عوف عن عبد الله"
"14474","14436  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  وَكِيعٌ ،  عَنْ  مِسْعَرٍ ،  عَنْ  أَبِي حَصِينٍ ،  عَنِ  الْقَاسِمِ بْنِ مُخَيْمِرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14436","","عبد الله بن عمرو بن العاص عن القاسم بن مخيمرة عن عثمان بن عاصم بن حصين عن مسعر بن كدام عن وكيع بن الجراح عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14475","14437  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ،  ثَنَا  قَبِيصَةُ بْنُ عُقْبَةَ .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى وَمُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنِ  الْقَاسِمِ بْنِ مُخَيْمِرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا أَحَدٌ مِنَ الْمُسْلِمِينَ يُصَابُ بِبَلَاءٍ فِي جَسَدِهِ إِلَّا أَمَرَ اللهُ الْحَفَظَةَ الَّذِينَ يَحْفَظُونَهُ ، فَيَقُولُ :  اكْتُبُوا لِعَبْدِي كُلَّ يَوْمٍ وَلَيْلَةٍ مِثْلَ مَا كَانَ يَعْمَلُ مِنَ الْخَيْرِ  ، مَا دَامَ مَحْبُوسًا فِي وَثَاقِي  .","","Al-Mu'jam al-Kabir 14437","","عبد الله بن عمرو بن العاص عن القاسم بن مخيمرة عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن محمد بن كثير العبدي عن محمد بن محمد بن حيان التمار عن الطبراني","سفيان بن عوف عن عبد الله"
"14476","[13/544]      14438  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَبُو بَكْرٍ الْأَعْيَنُ مُحَمَّدُ بْنُ أَبِي عَتَّابٍ ،  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ، قَالَ :  سَمِعْتُ  أَبِي  ، قَالَ :  سَمِعْتُ  الْأَعْمَشَ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ رَبِّ الْكَعْبَةِ ، قَالَ :  جَلَسْنَا إِلَى  عَبْدِ اللهِ بْنِ عَمْرٍو فَقَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ ، فَإِذَا مُنَادِي رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُنَادِي : الصَّلَاةَ جَامِعَةً  ، فَقَامَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَخَطَبَنَا فَقَالَ : "" أَمَّا  بَعْدُ  ... "" .","","Al-Mu'jam al-Kabir 14438","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن عبد رب الكعبة العائذي عن زيد بن وهب الجهني عن الأعمش عن جرير بن حازم عن وهب بن جرير بن حازم عن محمد بن أبي عتاب الأعين عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14477","[13/545]      14439  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ رَبِّ الْكَعْبَةِ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يُحَدِّثُ فِي ظِلِّ  الْكَعْبَةِ  ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ ، فَمِنَّا مَنْ  يَنْتَضِلُ  وَمِنَّا مَنْ هُوَ فِي مَجْشَرِهِ ، وَمِنَّا مَنْ يُصْلِحُ خِبَاءَهُ ، فَنُودِيَ : الصَّلَاةَ جَامِعَةً فَاجْتَمَعْنَا إِلَيْهِ ، فَإِذَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ :  إِنَّهُ لَمْ يَكُنْ نَبِيٌّ قَبْلِي إِلَّا كَانَ حَقًّا لِلهِ عَلَيْهِ أَنْ يَدُلَّ أُمَّتَهُ عَلَى مَا يَعْلَمُ أَنَّهُ خَيْرٌ لَهُمْ  وَيُنْذِرَهُمْ مَا يَعْلَمُ أَنَّهُ شَرٌّ لَهُمْ ، وَإِنَّ هَذِهِ الْأُمَّةَ جُعِلَتْ عَافِيَتُهَا فِي         [13/546]      أَوَّلِهَا ، وَسَيُصِيبُ آخِرَهَا بَلَاءٌ ، وَتَرْدُفُ الْفِتَنُ بَعْضُهَا بَعْضًا ، فَتَجِيءُ فِتْنَةٌ فَيَقُولُ : هَذِهِ مُهْلِكَتِي . ثُمَّ تَنْكَشِفُ ثُمَّ تَجِيءُ فَيَقُولُ : هَذِهِ مُهْلِكَتِي . ثُمَّ تَنْكَشِفُ ، فَمَنْ أَحَبَّ مِنْكُمْ أَنْ يُزَحْزَحَ عَنِ النَّارِ وَيَدْخُلَ الْجَنَّةَ ، فَلْتُدْرِكْهُ مَنِيَّتُهُ وَهُوَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ ، وَلْيَأْتِ إِلَى النَّاسِ الَّذِي يُحِبُّ أَنْ يُؤْتَى إِلَيْهِ ، وَمَنْ بَايَعَ إِمَامًا وَأَعْطَاهُ  صَفْقَةَ  يَدِهِ  وَثَمَرَةَ  قَلْبِهِ فَلْيُطِعْهُ مَا اسْتَطَاعَ  "" .  قُلْتُ : هَذَا ابْنُ عَمِّكَ  مُعَاوِيَةُ  يَأْمُرُنَا أَنْ نَأْكُلَ أَمْوَالَنَا وَنُهْرِيقَ دِمَاءَنَا ، وَقَدْ قَالَ اللهُ عَزَّ وَجَلَّ :         {      يَا أَيُّهَا الَّذِينَ آمَنُوا لا تَأْكُلُوا أَمْوَالَكُمْ بَيْنَكُمْ بِالْبَاطِلِ         }      وَقَالَ :         {      وَلا تَقْتُلُوا أَنْفُسَكُمْ         }      ، قَالَ : فَسَكَتَ سَاعَةً ، ثُمَّ قَالَ : أَطِعْهُ فِي طَاعَةِ اللهِ ، وَاعْصِهِ فِي مَعْصِيَةِ اللهِ  .         [13/547]","","Al-Mu'jam al-Kabir 14439","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن عبد رب الكعبة العائذي عن زيد بن وهب الجهني عن الأعمش عن سفيان الثوري عن محمد بن كثير العبدي عن محمد بن محمد بن حيان التمار عن الطبراني","سفيان بن عوف عن عبد الله"
"14478","14440  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ رَبِّ الْكَعْبَةِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 14440","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن عبد رب الكعبة العائذي عن زيد بن وهب الجهني عن الأعمش عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14479","14441  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ وَعَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَا :  ثَنَا  أَحْمَدُ بْنُ أَبِي خَلَفٍ الْبَغْدَاذِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عُمَرَ أَبُو الْمُنْذِرِ ،  ثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ أَبِي السَّفَرِ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ رَبِّ الْكَعْبَةِ قَالَ :  رَأَيْتُ جَمَاعَةً عِنْدَ الْبَيْتِ فَمِلْتُ إِلَيْهِمْ ، وَإِذَا رَجُلٌ  يُحَدِّثُهُمْ  وَإِذَا هُوَ عَبْدُ اللهِ بْنُ عَمْرٍو ، فَقَالَ : كُنَّا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ فَنَزَلْنَا مَنْزِلًا ، فَمِنَّا مَنْ يَبْنِي خِبَاءَهُ وَمِنَّا مَنْ  يَنْتَضِلُ  وَمِنَّا مَنْ هُوَ فِي  جَشَرِهِ ،  إِذْ نَادَى مُنَادِي رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : الصَّلَاةَ جَامِعَةً ، فَانْتَهَيْتُ إِلَيْهِ ، فَسَمِعْتُهُ يَقُولُ :  إِنَّهُ مَا كَانَ أَوْ لَمْ يَكُنْ مِنْ نَبِيٍّ إِلَّا كَانَ عَلَيْهِ أَنْ يُبَشِّرَ أُمَّتَهُ بِمَا يَرَى أَنَّهُ خَيْرٌ لَهُمْ  وَيُنْذِرَهُمْ بِمَا يَرَى أَنَّهُ شَرٌّ لَهُمْ ، وَإِنَّ أُمَّتَكُمْ عَافِيَتُهَا         [13/548]      فِي أَوَّلِهَا ، وَسَتَكُونُ فِتَنٌ وَأُمُورٌ  يُرَقِّقُ  بَعْضُهَا بَعْضًا ، تَجِيءُ الْفِتْنَةُ فَيَقُولُ : هَذِهِ .  فَتَنْكَشِفُ ثُمَّ تَجِيءُ فَيَقُولُ : هَذِهِ مُهْلِكَتِي .  فَمَنْ أَحَبَّ أَنْ يُزَحْزَحَ عَنِ النَّارِ وَيَدْخُلَ الْجَنَّةَ فَلْيَأْتِ لِلنَّاسِ مَا يُحِبُّ أَنْ يُؤْتَى إِلَيْهِ وَيَكْرَهْ مَا يَكْرَهُ أَنْ يُؤْتَى إِلَيْهِ .  وَمَنْ بَايَعَ إِمَامًا فَأَعْطَاهُ  صَفْقَةَ  يَمِينِهِ  وَثَمَرَةَ  قَلْبِهِ فَلْيُطِعْهُ مَا اسْتَطَاعَ ، وَإِنْ خَالَفَ عَلَيْهِ رَجُلٌ فَاحْتَزُّوا رَأْسَهُ "" .  فَقُلْتُ : هَكَذَا فَأَفْرَجْتُ بَيْنَ رَجُلَيْنِ ، وَقُلْتُ : أَنْتَ سَمِعْتَ هَذَا مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : نَعَمْ ، سَمِعَتْهُ أُذُنَايَ  وَوَعَاهُ  قَلْبِي .  قُلْتُ : فَمَا تَأْمُرُ ؟! هَذَا ابْنُ عَمِّكَ  مُعَاوِيَةُ  يَأْمُرُنَا أَنْ نَقْتُلَ أَنْفُسَنَا ، وَأَنْ نَأْكُلَ أَمْوَالَنَا بَيْنَنَا بِالْبَاطِلِ ! فَوَضَعَ يَدَهُ عَلَى جَبِينِهِ ، ثُمَّ رَفَعَهَا ، فَقَالَ : اذْهَبُوا فَأَطِيعُوهُ مَا أَطَاعَ اللهَ ، وَاعْصُوهُ إِذَا عَصَى اللهَ  .","","Al-Mu'jam al-Kabir 14441","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن عبد رب الكعبة العائذي عن الشعبي عن عبد الله بن أبي السفر الهمداني عن يونس بن أبي إسحاق عن إسماعيل بن عمر الواسطي عن أحمد بن محمد بن أحمد بن محمد القطيعي عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14480","[13/549]      14442  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَالِمٍ الْمَفْلُوجُ ،  ثَنَا  عُبَيْدَةُ بْنُ الْأَسْوَدِ ،  عَنِ  الْقَاسِمِ بْنِ الْوَلِيدِ ،  عَنِ  الْمُغِيرَةِ بْنِ عَبْدِ اللهِ الْيَشْكُرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِيَّاكُمْ وَالْبُخْلَ فَإِنَّهُ أَهْلَكَ مَنْ كَانَ قَبْلَكُمْ  ، أَمَرَتْهُمْ بِالْقَطِيعَةِ فَقَطَعُوا وَبِالْبُخْلِ فَبَخِلُوا وَبِالْفُجُورِ فَفَجَرُوا  .","","Al-Mu'jam al-Kabir 14442","","عبد الله بن عمرو بن العاص عن عبد الله بن الحارث النجراني عن المغيرة بن عبد الله بن أبي عقيل اليشكري عن القاسم بن الوليد الخبذعي عن عبيدة بن الأسود بن سعيد الهمداني عن عبد الله بن سالم المفلوج عن محمد بن عثمان بن أبي شيبة عن الطبراني","سفيان بن عوف عن عبد الله"
"14481","14443  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي زُرْعَةَ الدِّمَشْقِيُّ وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ قَالَا :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ سُمَيْعٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ سُلَيْمَانَ النَّصْرِيُّ ،  عَنِ  الْمُغِيرَةِ بْنِ عَبْدِ اللهِ         [13/550]      الْيَشْكُرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  أَبِي كَثِيرٍ الزُّبَيْدِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  خَطَبَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  إِيَّاكُمْ وَالظُّلْمَ فَإِنَّ الظُّلْمَ ظُلُمَاتٌ يَوْمَ الْقِيَامَةِ  ، وَإِيَّاكُمْ  وَالْفُحْشَ  فَإِنَّ اللهَ لَا يُحِبُّ  الْفُحْشَ  وَلَا التَّفَحُّشَ ، وَإِيَّاكُمْ  وَالشُّحَّ  فَإِنَّ  الشُّحَّ  أَهْلَكَ مَنْ كَانَ قَبْلَكُمْ ، أَمَرَهُمْ أَنْ يَقْطَعُوا أَرْحَامَهُمْ فَقَطَعُوا "" ، فَقَالَ رَجُلٌ : يَا رَسُولَ اللهِ ، وَأَيُّ  الْجِهَادِ  أَفْضَلُ ؟ قَالَ : "" أَنْ يُهَرَاقَ دَمُكَ وَيُعْقَرَ جَوَادُكَ "" ، قَالَ : فَأَيُّ الْهِجْرَةِ أَفْضَلُ ؟ قَالَ : "" أَنْ تَهْجُرَ مَا كَرِهَ رَبُّكَ ، وَهُمَا هِجْرَتَانِ : هِجْرَةٌ  لِلْحَاضِرِ  وَهِجْرَةٌ لِلْبَادِي ، فَأَمَّا هِجْرَةُ الْبَادِي         [13/551]      فَإِذَا دُعِيَ أَجَابَ ، وَإِذَا أُمِرَ أَطَاعَ ، وَأَمَّا هِجْرَةُ  الْحَاضِرِ  فَأَشَدُّهُمْ بَلْوَى وَأَعْظَمُهُمْ أَجْرًا  "" .","","Al-Mu'jam al-Kabir 14443","","عبد الله بن عمرو بن العاص عن أبو كثير الزبيدي عن عبد الله بن الحارث النجراني عن المغيرة بن عبد الله بن أبي عقيل اليشكري عن معاوية بن سلمة بن سليمان النصري عن محمد بن عيسى بن القاسم مولى معاوية بن أبي سفيان عن هشام بن عمار عن محمد بن أبي زرعة النصري عن الطبراني","سفيان بن عوف عن عبد الله"
"14482","14444  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ وَسُلَيْمَانُ بْنُ حَرْبٍ قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  أَبِي كَثِيرٍ الزُّبَيْدِيِّ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يُحَدِّثُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ :  إِيَّاكُمْ وَالظُّلْمَ فَإِنَّهُ ظُلُمَاتٌ يَوْمَ الْقِيَامَةِ  ، وَإِيَّاكُمْ  وَالْفُحْشَ  فَإِنَّ اللهَ عَزَّ وَجَلَّ لَا يُحِبُّ  الْفَاحِشَ  الْمُتَفَحِّشَ ، وَإِيَّاكُمْ  وَالشُّحَّ  فَإِنَّهُ أَهْلَكَ مَنْ كَانَ قَبْلَكُمْ ، أَمَرَهُمْ بِالْبُخْلِ         [13/552]      فَبَخِلُوا ، وَأَمَرَهُمْ بِالْفُجُورِ فَفَجَرُوا ، وَأَمَرَهُمْ بِقَطْعِ الرَّحِمِ فَقَطَعُوا "" .  فَقَامَ  رَجُلٌ  فَقَالَ : يَا رَسُولَ اللهِ أَيُّ الْإِسْلَامِ أَفْضَلُ ؟ قَالَ : "" أَنْ يَسْلَمَ الْمُسْلِمُونَ مِنْ لِسَانِكَ وَيَدِكَ "" ، فَقَامَ ذَلِكَ  الرَّجُلُ أَوْ رَجُلٌ آخَرُ  فَقَالَ : يَا رَسُولَ اللهِ أَيُّ الْهِجْرَةِ أَفْضَلُ ؟ قَالَ : "" أَنْ تَهْجُرَ مَا كَرِهَ         [13/553]      رَبُّكَ "" ، ثُمَّ قَالَ : "" الْهِجْرَةُ هِجْرَتَانِ : هِجْرَةٌ  لِلْحَاضِرِ  وَهِجْرَةٌ لِلْبَادِي ، فَأَمَّا هِجْرَةُ الْبَادِي فَتُجِيبُهُ إِذَا دَعَاكَ وَتُطِيعُهُ إِذَا أَمَرَكَ ، وَالْحَاضِرُ أَعْظَمُهَا بَلِيَّةً وَأَفْضَلُهَا أَجْرًا  .  وَاللَّفْظُ لِحَدِيثِ  أَبِي الْوَلِيدِ  .","","Al-Mu'jam al-Kabir 14444","","عبد الله بن عمرو بن العاص عن أبو كثير الزبيدي عن عبد الله بن الحارث النجراني عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","سفيان بن عوف عن عبد الله"
"14483","14445  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مَخْلَدُ بْنُ مَالِكٍ ،  حَدَّثَنَا  مِسْكِينُ بْنُ بُكَيْرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  أَبِي كَثِيرٍ الزُّبَيْدِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  تَجْتَمِعُونَ يَوْمَ الْقِيَامَةِ يُقَالُ : أَيْنَ فُقَرَاءُ هَذِهِ الْأُمَّةِ وَمَسَاكِينُهَا ؟  فَيَقُومُونَ ، فَيُقَالُ لَهُمْ : مَاذَا عَمِلْتُمْ ؟ فَيَقُولُونَ : رَبَّنَا ابْتَلَيْتَنَا فَصَبَرْنَا وَوَلَّيْتَ الْأُمُورَ وَالسُّلْطَانَ غَيْرَنَا ، فَيَقُولُ اللهُ جَلَّ ذِكْرُهُ :         [13/554]      صَدَقْتُمْ ، فَيَدْخُلُونَ الْجَنَّةَ قَبْلَ النَّاسِ بِزَمَانٍ ، وَتَبْقَى شِدَّةُ الْحِسَابِ عَلَى ذَوِي الْأَمْوَالِ وَالسُّلْطَانِ "" ، قَالُوا : فَأَيْنَ الْمُؤْمِنُونَ يَوْمَئِذٍ ؟ قَالَ : "" تُوضَعُ لَهُمْ كَرَاسِيُّ مِنْ نُورٍ مُظَلَّلٌ عَلَيْهِمُ الْغَمَامُ ، يَكُونُ ذَلِكَ الْيَوْمُ أَقْصَرَ عَلَى الْمُؤْمِنِينَ مِنْ سَاعَةٍ مِنْ نَهَارٍ "" .","","Al-Mu'jam al-Kabir 14445","","عبد الله بن عمرو بن العاص عن أبو كثير الزبيدي عن عبد الله بن الحارث النجراني عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن مسكين بن بكير الحراني عن مخلد بن مالك بن شيبان الحراني عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14484","14446  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  عَمِّي الْقَاسِمُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  تَلِيدُ بْنُ سُلَيْمَانَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  زُهَيْرِ بْنِ الْأَقْمَرِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ  مُعَاوِيَةَ  كَانَ يَكْتُبُ بَيْنَ يَدَيِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 14446","","عبد الله بن عمرو بن العاص عن أبو كثير الزبيدي عن عبد الله بن الحارث النجراني عن عمرو بن مرة المرادي عن الأعمش عن تليد بن سليمان المحاربي الأعرج عن قاسم بن محمد بن أبي شيبة العبسي عن محمد بن عثمان بن أبي شيبة عن الطبراني","سفيان بن عوف عن عبد الله"
"14485","14447  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْأَعْمَشُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ قَالَ :  كُنَّا جُلُوسًا عِنْدَ  أَبِي عُبَيْدَةَ  فَذَكَرُوا الرِّيَاءَ ،         [13/555]      فَقَالَ  شَيْخٌ يُكْنَى أَبَا يَزِيدَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سَمَّعَ النَّاسَ بِعَمَلِهِ سَمَّعَ اللهُ بِهِ  سَامِعَ  خَلْقِهِ  ، وَحَقَّرَهُ وَصَغَّرَهُ "" .","","Al-Mu'jam al-Kabir 14447","","عبد الله بن عمرو بن العاص عن أبو يزيد عن عمرو بن مرة المرادي عن الأعمش عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14486","14448  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ زُنْبُورٍ ،  ثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  حَدَّثَنِي  شَيْخٌ يُكَنَّى أَبَا يَزِيدَ قَالَ :  كُنْتُ جَالِسًا مَعَ  عَبْدِ اللهِ بْنِ عَمْرٍو  وَعَبْدِ اللهِ بْنِ عُمَرَ  ،  فَقَالَ  عَبْدُ اللهِ بْنُ عُمَرَ :  إِنَّ  الشَّيْطَانَ  يَجْرِي مِنَ ابْنِ آدَمَ مَجْرَى الدَّمِ وَالرُّوحِ  .  فَبَكَى عَبْدُ اللهِ بْنُ عَمْرٍو وَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ سَمَّعَ النَّاسَ بِعَمَلِهِ سَمَّعَ اللهُ بِهِ  سَامِعَ  خَلْقِهِ  ، وَصَغَّرَهُ وَحَقَّرَهُ  .","","Al-Mu'jam al-Kabir 14448","","عبد الله بن عمرو بن العاص عن أبو يزيد عن عمرو بن مرة المرادي عن الأعمش عن الفضيل بن عياض عن محمد بن زنبور الهاشمي عن الساجي عن الطبراني","سفيان بن عوف عن عبد الله"
"14487","[13/556]      14449  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ وَسُلَيْمَانُ بْنُ حَرْبٍ ، قَالُوا :  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ قَالَ : سَمِعْتُ رَجُلًا فِي بَيْتِ  أَبِي عُبَيْدَةَ  يُحَدِّثُ  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عَمْرٍو يُحَدِّثُ  عَبْدَ اللهِ بْنَ عُمَرَ  أَنَّهُ سَمِعَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ سَمَّعَ النَّاسَ بِعَمَلِهِ سَمَّعَ اللهُ بِهِ  سَامِعَ  خَلْقِهِ  وَصَغَّرَهُ وَحَقَّرَهُ "" ،  فَذَرَفَتْ  عَيْنَا  عَبْدِ اللهِ بْنِ عُمَرَ  .","","Al-Mu'jam al-Kabir 14449","","عبد الله بن عمرو بن العاص عن رجل عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","سفيان بن عوف عن عبد الله"
"14488","14450  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  الْفِرْيَابِيُّ         [13/557]      وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو حُذَيْفَةَ قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي حَيَّانَ التَّيْمِيِّ ،  عَنْ  أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ ، قَالَ :  تَذَاكَرُوا الْآيَاتِ عِنْدَ  مَرْوَانَ  فَذَكَرُوا  الدَّجَّالَ  ،  فَقَالَ  عَبْدُ اللهِ بْنُ عَمْرٍو : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  أَسْرَعُ الْآيَاتِ : طُلُوعُ الشَّمْسِ مِنْ مَغْرِبِهَا  أَوْ خُرُوجُ الدَّابَّةِ عَلَى النَّاسِ ضُحًى ، فَأَيَّتُهُمَا كَانَتْ قَبْلَ الْأُخْرَى فَالْأُخْرَى عَلَى أَثَرِهَا قَرِيبًا "" ، ثُمَّ قَالَ  عَبْدُ اللهِ بْنُ عَمْرٍو  : فَأَظُنُّ طُلُوعَ الشَّمْسِ أَوَّلَهُمَا  .","","Al-Mu'jam al-Kabir 14450","","عبد الله بن عمرو بن العاص عن أبو زرعة بن عمرو بن جرير الغلابي عن يحيى بن سعيد التيمي عن سفيان الثوري عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14489","14451  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَعَمْرُو بْنُ حَفْصٍ         [13/558]      السَّدُوسِيُّ  قَالَا :  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ قَالَ :  سَمِعْتُ  سَيْفًا  يُحَدِّثُ عَنْ  رُشَيْدٍ الْهَجَرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  .  كذا في طبعة الجريسي ، والصواب : ( عمر بن حفص )","","Al-Mu'jam al-Kabir 14451","","عبد الله بن عمرو بن العاص عن رشيد الهجري عن سيف بياع السابري عن رشيد الهجري عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","سفيان بن عوف عن عبد الله"
"14490","14452  -  حَدَّثَنَا  فَضْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  إِسْرَائِيلُ ،  عَنِ  الْحَكَمِ ،  عَنْ  هِلَالٍ الْهَجَرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  ، وَالْمُهَاجِرُ مَنْ هَجَرَ مَا نَهَى اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 14452","","عبد الله بن عمرو بن العاص عن رشيد الهجري عن الحكم بن عتيبة الكندي عن إسرائيل بن يونس بن أبي إسحاق عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14491","14453  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  فِطْرُ بْنُ         [13/559]      خَلِيفَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  وَهْبِ بْنِ جَابِرٍ الْخَيْوَانِيِّ  قَالَ  :  أَتَيْتُ  بَيْتَ الْمَقْدِسِ  فَجَلَسْتُ إِلَى عَبْدِ اللهِ بْنِ عَمْرٍو ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  كَفَى بِالْمَرْءِ إِثْمًا أَنْ يُضَيِّعَ مَنْ  يَقُوتُ  .","","Al-Mu'jam al-Kabir 14453","","عبد الله بن عمرو بن العاص عن وهب بن بيان بن جابر الخيواني عن أبو إسحاق السبيعي عن فطر بن خليفة عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14492","[13/560]      14454  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَبَنَا  عَبْدُ الرَّزَّاقِ ،  أَبَنَا  مَعْمَرٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  وَهْبِ بْنِ جَابِرٍ الْخَيْوَانِيِّ  قَالَ  : كُنْتُ عِنْدَ عَبْدِ اللهِ بْنِ عَمْرٍو ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  كَفَى إِثْمًا أَنْ يُضَيِّعَ الرَّجُلُ مَنْ  يَقُوتُ  .","","Al-Mu'jam al-Kabir 14454","","عبد الله بن عمرو بن العاص عن وهب بن بيان بن جابر الخيواني عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14493","14455  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  عَفَّانُ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  وَهْبِ بْنِ جَابِرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  كَفَى بِالْمَرْءِ إِثْمًا أَنْ يُضَيِّعَ مَنْ  يَقُوتُ  .","","Al-Mu'jam al-Kabir 14455","","عبد الله بن عمرو بن العاص عن وهب بن بيان بن جابر الخيواني عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن عفان بن مسلم الصفار عن أحمد بن محمد بن أحمد الجواربي عن الطبراني","سفيان بن عوف عن عبد الله"
"14494","[13/561]      14456  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الْأَصْبَهَانِيُّ ،  ثَنَا  أَبُو مَسْعُودٍ أَحْمَدُ بْنُ الْفُرَاتِ ،  ثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  ثَنَا  الْمُغِيرَةُ بْنُ مُسْلِمٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  وَهْبِ بْنِ جَابِرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ  يَأْجُوجَ  وَمَأْجُوجَ  مِنْ وَلَدِ  آدَمَ  ، وَلَوْ أُرْسِلُوا لَأَفْسَدُوا عَلَى النَّاسِ مَعَايِشَهُمْ ، وَلَمْ يَمُتْ مِنْهُمْ رَجُلٌ إِلَّا تَرَكَ مِنْ ذُرِّيَّتِهِ أَلْفًا فَصَاعِدًا ، وَإِنَّ مِنْ وَرَائِهِمْ ثَلَاثَ أُمَمٍ :  تَاوِيلُ  ،  وَتَارِيسُ  ،  وَمَنْسَكُ  .","","Al-Mu'jam al-Kabir 14456","","عبد الله بن عمرو بن العاص عن وهب بن بيان بن جابر الخيواني عن أبو إسحاق السبيعي عن المغيرة بن مسلم القسملي عن أبو داود الطيالسي عن أحمد بن الفرات الضبي عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","سفيان بن عوف عن عبد الله"
"14495","[13/562]      14457  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ،  ثَنَا  أَبُو مَعْمَرٍ الْمُقْعَدُ ،  ثَنَا  عَبْدُ الْوَارِثِ بْنُ سَعِيدٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  رَآنِي النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَدَعَانِي ، فَقَالَ :  فِي كَمْ تَقْرَأُ الْقُرْآنَ ؟ "" قُلْتُ : فِي يَوْمَيْنِ وَلَيْلَتَيْنِ ، فَقَالَ : ""  بَخٍ  !  صَلِّ وَارْقُدْ ، وَارْقُدْ وَصَلِّ ، اقْرَأْ فِي شَهْرٍ ، "" قُلْتُ : إِنِّي أَقْوَى مِنْ ذَلِكَ ، فَنَاقَصَنِي وَنَاقَصْتُهُ حَتَّى بَلَغَ سَبْعًا .  قَالَ : "" كَيْفَ تَصُومُ ؟ "" قُلْتُ : أَصُومُ وَلَا أُفْطِرُ فَقَالَ : "" صُمْ وَأَفْطِرْ ، وَصُمْ مِنْ كُلِّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ "" ، قُلْتُ : إِنِّي أَقْوَى مِنْ ذَلِكَ ، فَنَاقَصَنِي وَنَاقَصْتُهُ ، قَالَ : "" فَإِنْ أَبَيْتَ فَصُمْ أَحَبَّ الصَّوْمِ إِلَى اللهِ صَوْمَ  دَاوُدَ  ، صُمْ يَوْمًا وَأَفْطِرْ يَوْمًا "" ، فَلَأَنْ أَكُونَ قَبِلْتُ رُخْصَةَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحَبُّ إِلَيَّ مِنْ أَهْلِي وَمَالِي  .","","Al-Mu'jam al-Kabir 14457","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن عبد الوارث بن سعيد بن ذكوان عن عبد الله بن عمرو المقعد عن أحمد بن داود بن موسى السدوسي عن الطبراني","سفيان بن عوف عن عبد الله"
"14496","14458  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  جَرِيرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14458","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14497","[13/563]      14459  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّهُ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَيْفَ أَقْرَأُ الْقُرْآنَ ؟ قَالَ : "" فِي سَبْعِ لَيَالٍ  ، قَالَ : فَمَا زِلْتُ أُنَاقِصُهُ ، حَتَّى قَالَ : "" اقْرَأْهُ فِي يَوْمٍ وَلَيْلَةٍ ، لَا تَزِيدُ عَلَى ذَلِكَ شَيْئًا  .","","Al-Mu'jam al-Kabir 14459","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن هشام الدستوائي عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14498","14460  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّهُ بَلَغَنِي عَنْكَ أَنَّكَ تَصُومُ وَلَا تُفْطِرُ وَتُصَلِّي وَلَا تَنَامُ "" ، قَالَ :  فَصُمْ مِنْ كُلِّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ  ، وَاقْرَأِ الْقُرْآنَ فِي شَهْرَيْنِ "" ، فَنَاقَصَنِي وَنَاقَصْتُهُ فَلَمْ يَزَلْ يُنَاقِصُنِي ، حَتَّى قَالَ : "" صُمْ يَوْمًا وَأَفْطِرْ يَوْمًا ، وَاقْرَأِ الْقُرْآنَ فِي سَبْعٍ "" .","","Al-Mu'jam al-Kabir 14460","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14499","[13/564]      14461  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ نَاسًا مِنَ الْيَهُودِ سَلَّمُوا عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَدْ قَالُوا فِي أَنْفُسِهِمْ :         {      لَوْلا يُعَذِّبُنَا اللهُ بِمَا نَقُولُ         }      ، فَنَزَلَتْ :         {      وَإِذَا جَاءُوكَ حَيَّوْكَ بِمَا لَمْ يُحَيِّكَ بِهِ اللهُ         }      ..  .","","Al-Mu'jam al-Kabir 14461","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن حماد بن سلمة عن أبو الوليد الطيالسي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14500","14462  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدِ بْنِ حَرْبٍ الْعَبَّادَانِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  أَتَتِ الْيَهُودُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَالُوا :  السَّامُ  عَلَيْكَ  ، وَقَالُوا فِي أَنْفُسِهِمْ :         {      لَوْلا يُعَذِّبُنَا اللهُ بِمَا نَقُولُ         }      : "" فَأَنْزَلَ اللهُ :         {      وَإِذَا جَاءُوكَ حَيَّوْكَ بِمَا لَمْ يُحَيِّكَ بِهِ اللهُ         }      الْآيَةَ كُلَّهَا .","","Al-Mu'jam al-Kabir 14462","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن حماد بن زيد عن سليمان بن حرب الواشحي عن جعفر بن محمد بن حرب العباداني عن الطبراني","سفيان بن عوف عن عبد الله"
"14501","[13/565]      14463  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  أَخْبَرَنِي  أَبِي  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ قَالَ :  لَمَّا  جَهَّزَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَاطِمَةَ  إِلَى  عَلِيٍّ  بَعَثَ         [13/566]      مَعَهَا  بِخَمِيلٍ  ، فَقَالَ  عَطَاءٌ  : مَا  الْخَمِيلُ  ؟ قَالَ : قَطِيفَةٌ وَوِسَادَةٍ مِنْ أَدَمٍ حَشْوُهَا لِيفٌ أَوْ  إِذْخِرٌ  ، وَقِرْبَةٌ كَانَا يَفْتَرِشَانِ نِصْفَ  الْخَمِيلِ  ، وَيَلْتَحِفَانِ بِنِصْفِهِ .","","Al-Mu'jam al-Kabir 14463","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14502","14464  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ أَمَرَ  عَلِيَّا  وَفَاطِمَةَ  إِذَا أَخَذَا مَضَاجِعَهُمَا بِالتَّسْبِيحِ وَالتَّكْبِيرِ  وَالتَّحْمِيدِ ثَلَاثًا وَثَلَاثِينَ وَثَلَاثًا وَثَلَاثِينَ وَأَرْبَعًا وَثَلَاثِينَ  .","","Al-Mu'jam al-Kabir 14464","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14503","14465  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ         [13/567]      عَمْرٍو  أَنَّ  رَجُلًا  قَالَ : اللَّهُمَّ اغْفِرْ لِي  وَلِمُحَمَّدٍ  وَحْدَنَا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَقَدْ حَجَبْتَ عَنْ نَاسٍ كَثِيرٍ !  .","","Al-Mu'jam al-Kabir 14465","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14504","14466  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجٌ ،  عَنْ  حَمَّادٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ  رَجُلًا  قَالَ فِي الصَّلَاةِ : اللهُ أَكْبَرُ ، الْحَمْدُ لِلهِ  مِلْءَ  السَّمَاوَاتِ وَمِلْءَ الْأَرْضِ ، فَلَمَّا قَضَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : "" مَنِ الْمُتَكَلِّمُ بِالْكَلِمَاتِ ؟ "" فَقَالَ رَجُلٌ : أَنَا .         [13/568]      فَقَالَ :  لَقَدْ رَأَيْتُ الْمَلَائِكَةَ تَلَقَّاهَا يُبَادِرُ بَعْضُهُمْ بَعْضًا  .","","Al-Mu'jam al-Kabir 14466","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14505","14467  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ سَاجِدًا ، فَقَالَ فِي آخِرِ سُجُودِهِ :  أُفْ  أُفْ  ، أَلَمْ تَعِدْنِي أَلَّا تُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ ؟!  .","","Al-Mu'jam al-Kabir 14467","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن حماد بن سلمة عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14506","14468  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  كَسَفَتِ الشَّمْسُ  ... فَذَكَرَ الْحَدِيثَ .         [13/569]","","Al-Mu'jam al-Kabir 14468","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14507","14469  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  الرَّبِيعُ بْنُ يَحْيَى الْأُشْنَانِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى فِي كُسُوفِ الشَّمْسِ رَكْعَتَيْنِ  .","","Al-Mu'jam al-Kabir 14469","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن شعبة بن الحجاج عن الربيع بن يحيى المرئي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14508","14470  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ،  ثَنَا  أَبُو مَعْمَرٍ الْمُقْعَدُ ،  حَدَّثَنَا  عَبْدُ الْوَارِثِ بْنُ سَعِيدٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  كَسَفَتِ الشَّمْسُ فَصَلَّى بِنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ..فَذَكَرَ نَحْوَهُ .         [13/570]","","Al-Mu'jam al-Kabir 14470","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن عبد الوارث بن سعيد بن ذكوان عن عبد الله بن عمرو المقعد عن أحمد بن داود بن موسى السدوسي عن الطبراني","سفيان بن عوف عن عبد الله"
"14509","14471  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  جَرِيرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  انْكَسَفَتِ الشَّمْسُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَطَالَ الْقِيَامَ  ... فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 14471","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14510","14472  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  خَلَفُ بْنُ هِشَامٍ الْبَزَّارُ ،  ثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اعْبُدُوا الرَّحْمَنَ ، وَأَفْشُوا السَّلَامَ  ، وَأَطْعِمُوا الطَّعَامَ ، تَدْخُلُونَ الْجِنَانَ  .         [13/571]","","Al-Mu'jam al-Kabir 14472","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن خالد بن عبد الله الطحان عن خلف بن هشام البزار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14511","14473  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  جَرِيرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14473","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14512","14474  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَقُومُ السَّاعَةُ حَتَّى يَخْرُجَ سَبْعُونَ كَذَّابًا  .","","Al-Mu'jam al-Kabir 14474","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن خالد بن عبد الله الطحان عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","سفيان بن عوف عن عبد الله"
"14513","14475  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  خَلَفُ بْنُ هِشَامٍ ،  ثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ         [13/572]      عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَنَّ رَجُلًا فِي الْجَاهِلِيَّةِ مَرَّ يَتَبَخْتَرُ فِي  حُلَّةٍ  لَهُ  مُسْبِلًا  ; فَأَمَرَ اللهُ الْأَرْضَ فَأَخَذَتْهُ  ، فَهُوَ يَتَدَحْرَجُ فِيهَا إِلَى يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 14475","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن خالد بن عبد الله الطحان عن خلف بن هشام البزار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14514","14476  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  هَنَّادُ بْنُ السَّرِيِّ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَرَجَ رَجُلٌ مِمَّنْ كَانَ قَبْلَكُمْ فِي  حُلَّةٍ  لَهُ يَخْتَالُ فِيهَا ، فَأَمَرَ اللهُ الْأَرْضَ فَأَخَذَتْهُ  ، فَهُوَ  يَتَجَلْجَلُ  فِيهَا إِلَى يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 14476","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن سلام بن سليم الحنفي عن هناد بن السري عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14515","14477  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عِقَالٍ الْحَرَّانِيُّ ،  ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14477","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن موسى بن أعين الجزري عن عبد الله بن محمد النفيلي عن أحمد بن عبد الرحمن بن يزيد الحراني عن الطبراني","سفيان بن عوف عن عبد الله"
"14516","14478  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا         [13/573]      جَرِيرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14478","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14517","14479  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ التَّرْجُمَانِيُّ ،  حَدَّثَنَا  شُعَيْبُ بْنُ صَفْوَانَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كَانَ فِي  بَنِي إِسْرَائِيلَ  جَدْيٌ  فِي غَنَمٍ كَثِيرَةٍ تُرْضِعُهُ أُمُّهُ  ، فَانْفَلَتَ فَرَضَعَ الْغَنَمَ كُلَّهَا ، ثُمَّ لَمْ يَشْبَعْ ، فَبَلَغَ ذَلِكَ نَبِيَّهُمْ ، فَقَالَ : إِنَّ مَثَلَ هَذَا مَثَلُ قَوْمٍ يَأْتُونَ مِنْ بَعْدِكُمْ يُعْطَى الرَّجُلُ مِنْهُمْ مَا يَكْفِي الْقَبِيلَةَ أَوِ الْأُمَّةَ ثُمَّ لَا يَشْبَعُ "" .","","Al-Mu'jam al-Kabir 14479","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن شعيب بن صفوان الأبناوي عن إسماعيل بن إبراهيم الترجماني عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14518","14480  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ التَّرْجُمَانِيُّ ،  ثَنَا  شُعَيْبُ بْنُ صَفْوَانَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  نَزَلَ ضَيْفٌ فِي         [13/574]      بَنِي إِسْرَائِيلَ  عَلَى قَوْمٍ  ، وَكَانَتْ لَهُمْ كَلْبَةٌ  مُجِحٌّ  -  يَعْنِي : حَامِلٌ  - ; فَقَالَتْ : لَا أَنْبَحُ ضَيْفَ أَهْلِي اللَّيْلَةَ ، فَعَوَى جِرَاؤُهَا فِي بَطْنِهَا ، فَغَدَوْا عَلَى نَبِيٍّ لَهُمْ فَأَخْبَرُوهُ ، فَقَالَ : أَتَدْرُونَ مَا مَثَلُ هَذَا ؟ قَالُوا : لَا ، قَالَ : مَثَلُ أُمَّةٍ تَكُونُ بَعْدَكُمْ يَغْلِبُ سُفَهَاؤُهَا حُلَمَاءَهَا "" .","","Al-Mu'jam al-Kabir 14480","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن شعيب بن صفوان الأبناوي عن إسماعيل بن إبراهيم الترجماني عن محمد بن علي بن شعيب السمسار عن الطبراني","سفيان بن عوف عن عبد الله"
"14519","14481  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  حَمَّادُ بْنُ يَحْيَى بْنِ حَمَّادٍ ،  ثَنَا  أَبِي  ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14481","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن الوضاح بن عبد الله اليشكري عن يحيى بن حماد بن أبي زياد الشيباني عن حماد بن يحيى بن حماد عن عبد الله بن أحمد الجواليقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14520","14482  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ الْوَارِثِ ،         [13/575]      عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ  رَجُلًا  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ بَايِعْنِي ، فَقَدْ تَرَكْتُ أَبَوَيَّ يَبْكِيَانِ ، فَقَالَ :  ارْجِعْ فَأَضْحِكْهُمَا كَمَا أَبْكَيْتَهُمَا  ، وَأَبَى أَنْ  يُبَايِعَهُ  .","","Al-Mu'jam al-Kabir 14482","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن عبد الوارث بن سعيد بن ذكوان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14521","14483  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ         [13/576]      عَمْرٍو  أَنَّ  رَجُلًا  جَاءَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : جِئْتُ  أُبَايِعُكَ  عَلَى الْهِجْرَةِ وَتَرَكْتُ أَبَوَايَ يَبْكِيَانِ ، فَقَالَ :  ارْجِعْ إِلَيْهِمَا فَأَضْحِكْهُمَا كَمَا أَبْكَيْتَهُمَا  .","","Al-Mu'jam al-Kabir 14483","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن سفيان بن عيينة عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14522","14484  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِيُبَايِعَهُ  عَلَى الْهِجْرَةِ ، فَقَالَ : إِنِّي أَبْكَيْتُ وَالِدَيَّ وَجِئْتُكَ  لِأُبَايِعَكَ  ، فَقَالَ :  ارْجِعْ إِلَيْهِمَا فَأَضْحِكْهُمَا كَمَا أَبْكَيْتَهُمَا  .","","Al-Mu'jam al-Kabir 14484","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن شعبة بن الحجاج عن النضر بن شميل عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14523","[13/577]      14485  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يُبَايِعُهُ  عَلَى الْهِجْرَةِ ، وَتَرَكَ أَبَوَيْهِ يَبْكِيَانِ ، فَقَالَ :  ارْجِعْ إِلَيْهِمَا فَأَضْحِكْهُمَا كَمَا أَبْكَيْتَهُمَا  .","","Al-Mu'jam al-Kabir 14485","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14524","14486  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ الْبَكْرِيُّ ،  عَنْ  نَصْرِ بْنِ طَرِيفٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَعُدُّ الْآيَ فِي الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 14486","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن نصر بن طريف القصاب عن عبد الله بن يزيد البكري عن هشام بن عمار عن أحمد بن النضر بن بحر العسكري عن الطبراني","سفيان بن عوف عن عبد الله"
"14525","[13/578]      14487  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ حَمْزَةَ الدِّمَشْقِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ أَبُو النَّضْرِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنِ  الْوَلِيدِ بْنِ عَبَّادٍ ،  عَنِ  الْفَضْلِ بْنِ صَالِحٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اسْفُوا فِي وُجُوهِ الْمَدَّاحِينَ  التُّرَابَ  .","","Al-Mu'jam al-Kabir 14487","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن الفضل بن صالح عن الوليد بن عباد الأزدي عن إسماعيل بن عياش الأحول عن إسحاق بن إبراهيم الفراديسي عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","سفيان بن عوف عن عبد الله"
"14526","14488  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ الضَّحَّاكِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنِ  الْوَلِيدِ بْنِ عَبَّادٍ ،  عَنِ  الْفَضْلِ بْنِ صَالِحٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  سَتَكُونُ بَعْدِي فِتَنٌ يَصْطَلِمُ فِيهَا الْعَرَبُ  ، اللِّسَانُ فِيهَا أَشَدُّ مِنَ السَّيْفِ ، قَتْلَاهَا جَمِيعًا فِي النَّارِ "" .","","Al-Mu'jam al-Kabir 14488","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن الفضل بن صالح عن الوليد بن عباد الأزدي عن إسماعيل بن عياش الأحول عن عبد الوهاب بن الضحاك عن عبد الله بن أحمد الجواليقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14527","14489  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ .         [13/579]      وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ قَالَا :  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،         [13/580]      قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَصْلَتَانِ  ... "" ، فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 14489","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14528","14490  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  جَرِيرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَصْلَتَانِ  لَا يُحَافِظُ عَلَيْهِمَا رَجُلٌ مُسْلِمٌ إِلَّا دَخَلَ الْجَنَّةَ  ، وَهُمَا يَسِيرٌ ، وَمَنْ يَعْمَلُ بِهِمَا قَلِيلٌ  ... "" فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 14490","","عبد الله بن عمرو بن العاص عن عطاء بن السائب عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14529","14491  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ         [13/581]      الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  خَصْلَتَانِ  ... "" فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14491","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14530","14492  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مُهَاجِرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بَابَاهْ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  كُنْتُ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذُكِرَتِ الْأَعْمَالُ ، فَقَالَ :  مَا مِنْ أَيَّامٍ أَفْضَلُ فِيهِنَّ الْعَمَلُ مِنْ هَذِهِ الْعَشْرِ  ، قَالُوا : يَا رَسُولَ اللهِ ،  الْجِهَادُ  ؟ فَأَكْبَرَهُ ، قَالَ : "" وَلَا  الْجِهَادُ  ، إِلَّا أَنْ يَخْرُجَ رَجُلٌ بِنَفْسِهِ وَمَالِهِ ، ثُمَّ تَكُونَ مُهْجَةُ نَفْسِهِ فِيهِ "" .","","Al-Mu'jam al-Kabir 14492","","عبد الله بن عمرو بن العاص عن عبد الله بن باباه البصري عن إبراهيم بن مهاجر بن جابر البجلي عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","سفيان بن عوف عن عبد الله"
"14531","[13/582]      14493  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  ثَنَا  الْأَعْمَشُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بَابَاهْ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  مَرَّ بِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا أُصَلِّي جَالِسًا ، فَقَالَ :  أَمَا إِنَّ لِلْجَالِسِ نِصْفَ صَلَاةِ الْقَائِمِ  .","","Al-Mu'jam al-Kabir 14493","","عبد الله بن عمرو بن العاص عن عبد الله بن باباه البصري عن حبيب بن أبي ثابت الكاهلي عن الأعمش عن عيسى بن يونس بن أبي إسحاق عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14532","14494  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  عَنْ  قُطْبَةَ بْنِ عَبْدِ الْعَزِيزِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بَابِي ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  مَرَّ بِي النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا أُصَلِّي جَالِسًا ، فَقَالَ :  صَلَاةُ الْجَالِسِ عَلَى النِّصْفِ مِنْ صَلَاةِ الْقَائِمِ  .","","Al-Mu'jam al-Kabir 14494","","عبد الله بن عمرو بن العاص عن عبد الله بن باباه البصري عن حبيب بن أبي ثابت الكاهلي عن الأعمش عن قطبة بن عبد العزيز بن سياه الحماني عن يحيى بن آدم عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سفيان بن عوف عن عبد الله"
"14533","14495  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي سِنَانٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي الْهُذَيْلِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [13/583]      يَقُولُ :  اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ نَفْسٍ لَا تَشْبَعُ  ، وَعِلْمٍ لَا يَنْفَعُ ، وَقَلْبٍ لَا يَخْشَعُ ، وَمِنْ دُعَاءٍ لَا  يُسْمَعُ ،  اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ شَرِّ هَؤُلَاءِ الْأَرْبَعِ  .","","Al-Mu'jam al-Kabir 14495","","عبد الله بن عمرو بن العاص عن عبد الله بن أبي الهذيل الغنوي عن ضرار بن مرة الشيباني عن سفيان الثوري عن عبد الرحمن بن مهدي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14534","14496  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  عَبَّادِ بْنِ الْعَوَّامِ ،  عَنِ  الْعَلَاءِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي دَاوُدَ الْهَمْدَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  لَقِيَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  أَلَا أُعَلِّمُكَ كَلِمَاتٍ مَنْ أَرَادَ اللهُ بِهِ خَيْرًا عَلَّمَهُنَّ إِيَّاهُ ؟!  قُلْتُ : نَعَمْ يَا رَسُولَ اللهِ ، قَالَ : "" قُلِ : اللَّهُمَّ إِنِّي ضَعِيفٌ فَخُذْ إِلَى الْخَيْرِ بِنَاصِيَتِي ، وَاجْعَلِ الْإِسْلَامَ مُنْتَهَى رِضَايَ ، اللَّهُمَّ إِنِّي ضَعِيفٌ فَقَوِّ فِي رِضَاكَ ضَعْفِي ، وَإِنِّي ذَلِيلٌ فَأَعِزَّنِي ، وَإِنِّي فَقِيرٌ فَأَغْنِنِي "" .","","Al-Mu'jam al-Kabir 14496","","عبد الله بن عمرو بن العاص عن نفيع بن الحارث الأعمى عن علاء بن المسيب عن عباد بن العوام الكلابي عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","سفيان بن عوف عن عبد الله"
"14535","[13/584]      14497  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ السَّوْطِيُّ ،  ثَنَا  عَفَّانُ ،  ثَنَا  شُعْبَةُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي مُوسَى ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ الْقَاعِدِ عَلَى النِّصْفِ مِنْ صَلَاةِ الْقَائِمِ  .","","Al-Mu'jam al-Kabir 14497","","عبد الله بن عمرو بن العاص عن أبو موسى عن حبيب بن أبي ثابت الكاهلي عن شعبة بن الحجاج عن عفان بن مسلم الصفار عن أحمد بن يحيى السوطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14536","14498  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي مُوسَى ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  صَلَاةُ الْقَاعِدِ عَلَى النِّصْفِ مِنْ صَلَاةِ الْقَائِمِ  .","","Al-Mu'jam al-Kabir 14498","","عبد الله بن عمرو بن العاص عن أبو موسى عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14537","14499  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  مُحَمَّدُ بْنُ سَعِيدٍ الْأَصْبَهَانِيُّ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ .         [13/585]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنْ  مُطَرِّفٍ ،  عَنْ  بَشِيرٍ أَبِي عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَرْكَبِ الْبَحْرَ إِلَّا حَاجًّا أَوْ مُعْتَمِرًا أَوْ غَازِيًا فِي  سَبِيلِ  اللهِ  ; فَإِنَّ تَحْتَ الْبَحْرِ  نَارًا ،  وَتَحْتَ النَّارِ بَحْرٌ ،         [13/586]      وَلَا تَشْتَرِي مِنْ ذِي  ضُغْطَةٍ  مِنْ سُلْطَانٍ شَيْئًا  .","","Al-Mu'jam al-Kabir 14499","","عبد الله بن عمرو بن العاص عن بشير بن مسلم الكندي عن مطرف بن طريف عن إسماعيل بن زكريا شقوصا عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","سفيان بن عوف عن عبد الله"
"14538","14500  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  مُطَرِّفِ بْنِ عَبْدِ اللهِ  أَنَّ  نَوْفًا  وَعَبْدَ اللهِ بْنَ عَمْرٍو اجْتَمَعَا ،  فَقَالَ  نَوْفٌ :  أَجِدُ فِي التَّوْرَاةِ أَنَّ السَّمَاوَاتِ وَالْأَرْضَ وَمَنْ فِيهِنَّ لَوْ كَانَ  طَبَقًا  وَاحِدًا مِنْ حَدِيدٍ  ، فَقَالَ رَجُلٌ :         [13/587]      "" لَا إِلَهَ إِلَّا اللهُ "" لَخَرَقَتْهُنَّ حَتَّى تَنْتَهِيَ إِلَى اللهِ  .  فَقَالَ  عَبْدُ اللهِ  : وَأَنَا أُحَدِّثُكَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ; صَلَّيْنَا مَعَهُ الْعِشَاءَ ذَاتَ لَيْلَةٍ ، فَرَجَعَ مَنْ رَجَعَ وَعَقَّبَ مَنْ عَقَّبَ ، فَجَاءَ قَبْلَ أَنْ  يَثُوبَ  النَّاسُ مِنْ صَلَاةِ الْعِشَاءِ وَقَدْ  حَفَزَهُ  النَّفَسُ ، وَقَدْ عَقَدَ عِشْرِينَ ، وَأَشَارَ بِالسَّبَّابَةِ وَهُوَ يَقُولُ :  إِنَّ رَبَّكُمْ عَزَّ وَجَلَّ فَتَحَ بَابًا مِنْ أَبْوَابِ السَّمَاءِ  يُبَاهِي  بِكُمُ الْمَلَائِكَةَ  ، وَزَادَ : هَؤُلَاءِ عِبَادِي قَدْ قَضَوْا فَرِيضَةً وَيَنْتَظِرُونَ أُخْرَى  .","","Al-Mu'jam al-Kabir 14500","","عبد الله بن عمرو بن العاص عن مطرف بن عبد الله بن الشخير الحرشي عن علي بن زيد بن جدعان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14539","14501  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجٌ ،  ثَنَا  حَمَّادٌ ،         [13/588]      عَنْ  ثَابِتٍ ،  عَنْ  أَبِي أَيُّوبَ ،  عَنْ  نَوْفٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو مِثْلَهُ .","","Al-Mu'jam al-Kabir 14501","","عبد الله بن عمرو بن العاص عن نوف بن فضالة البكالي عن أبو أيوب المراغي عن ثابت البناني عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14540","14502  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  حَمَّادِ بْنِ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدِ بْنِ جُدْعَانَ ،  عَنْ  مُطَرِّفٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  صَلَّى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمَغْرِبَ ، فَعَقَّبَ مَنْ عَقَّبَ وَرَجَعَ مَنْ رَجَعَ ، فَخَرَجَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  هَذَا رَبُّكُمْ قَدْ فَتَحَ بَابًا مِنْ أَبْوَابِ السَّمَاءِ  يُبَاهِي  بِكُمُ الْمَلَائِكَةَ  ، يَقُولُ : عِبَادِي قَضَوْا فَرِيضَةً وَهُمْ يَنْتَظِرُونَ أُخْرَى "" .","","Al-Mu'jam al-Kabir 14502","","عبد الله بن عمرو بن العاص عن مطرف بن عبد الله بن الشخير الحرشي عن علي بن زيد بن جدعان عن حماد بن سلمة عن عبد الرحمن بن مهدي عن عقبة بن مكرم عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14541","14503  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ السَّوْطِيُّ ،  ثَنَا  عَفَّانُ ،  ثَنَا  شُعْبَةُ وَهَمَّامُ بْنُ يَحْيَى ،  عَنْ  قَتَادَةَ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ الشِّخِّيرِ ،  عَنْ         [13/589]      عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَرَأَ الْقُرْآنَ فِي أَقَلَّ مِنْ ثَلَاثٍ لَمْ يَفْقَهْهُ  .","","Al-Mu'jam al-Kabir 14503","","عبد الله بن عمرو بن العاص عن يزيد بن عبد الله بن الشخير العامري عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عفان بن مسلم الصفار عن أحمد بن يحيى السوطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14542","14504  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الرَّقَاشِيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي الْعَلَاءِ ،  عَنْ  مُطَرِّفٍ ،  عَنِ  ابْنِ أَبِي رَبِيعَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  ذَكَرْتُ         [13/590]      لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الصَّوْمَ ، فَقَالَ :  صُمْ مِنْ كُلِّ عَشَرَةِ أَيَّامٍ يَوْمًا ، وَلَكَ أَجْرُ التِّسْعَةِ  ، قُلْتُ : إِنِّي أَقْوَى مِنْ ذَلِكَ ، قَالَ : "" فَصُمْ مِنْ كُلِّ تِسْعَةِ أَيَّامٍ يَوْمًا وَلَكَ أَجْرُ الثَّمَانِيَةِ "" ، قُلْتُ : إِنِّي أَقْوَى مِنْ ذَلِكَ ، قَالَ : "" فَصُمْ مِنْ كُلِّ ثَمَانِيَةِ أَيَّامٍ يَوْمًا ، وَلَكَ أَجْرُ السَّبْعَةِ"" ، قُلْتُ : إِنِّي أَقْوَى مِنْ ذَلِكَ ، فَلَمْ يَزَلْ حَتَّى قَالَ : "" صُمْ يَوْمًا ، وَأَفْطِرْ يَوْمًا "" .","","Al-Mu'jam al-Kabir 14504","","عبد الله بن عمرو بن العاص عن الحارث بن عبد الله أبي ربيعة القباع عن مطرف بن عبد الله بن الشخير الحرشي عن يزيد بن عبد الله بن الشخير العامري عن سليمان بن طرخان عن معتمر بن سليمان عن محمد بن عبد الله بن محمد بن عبد الملك الرقاشي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14543","14505  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ ،  ثَنَا  بَكْرُ بْنُ خَلَفٍ ،  ثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي حَسَّانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُحَدِّثُنَا عَامَّةَ اللَّيْلِ ، لَا يَقُومُ إِلَّا لِعِظَمِ الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 14505","","عبد الله بن عمرو بن العاص عن مسلم بن عبد الله الأحرد عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن بكر بن خلف عن محمد بن علي بن زيد الصائغ عن الطبراني","سفيان بن عوف عن عبد الله"
"14544","[13/591]      14506  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِيُّ ،  عَنْ  مُحَمَّدٍ مَوْلَى بَنِي هَاشِمٍ وَكَانَ مِنْ أَصْحَابِ مَكْحُولٍ ،  عَنْ  صَالِحِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِي الْعَجْفَاءِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خُذُوا الْقُرْآنَ مِنْ أَرْبَعَةٍ  : مِنِ  ابْنِ أُمِّ عَبْدٍ  ،  وَمُعَاذٍ  ،  وَأُبَيٍّ  ،  وَسَالِمٍ  . وَلَقَدْ هَمَمْتُ أَنْ أَبْعَثَهُمْ فِي الْأُمَمِ كَمَا بَعَثَ  عِيسَى  الْحَوَارِيِّينَ مِنْ  بَنِي إِسْرَائِيلَ  "" ، فَقَالَ رَجُلٌ : يَا رَسُولَ اللهِ ، فَأَيْنَ أَنْتَ عَنْ  أَبِي بَكْرٍ  وَعُمَرَ  ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَا غِنَى عَنْهُمَا ، إِنَّمَا مَثَلُهُمَا مِنَ الدِّينِ كَمَثَلِ السَّمْعِ وَالْبَصَرِ  .","","Al-Mu'jam al-Kabir 14506","","عبد الله بن عمرو بن العاص عن أبو العجفاء السلمي عن صالح بن جبير الصدائي عن محمد بن سعيد المصلوب عن عبد الرحمن بن محمد المحاربي عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","سفيان بن عوف عن عبد الله"
"14545","14507  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَبَنَا  عَبْدُ الرَّزَّاقِ ،  أَبَنَا  مَعْمَرٌ ،  عَنْ  مَطَرٍ الْوَرَّاقِ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِي سَبْرَةَ ،         [13/592]      حَدَّثَنِي  عَبْدُ اللهِ بْنُ عَمْرِو بْنِ الْعَاصِ أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ عَزَّ وَجَلَّ يُبْغِضُ  الْفَاحِشَ  وَالْمُتَفَحِّشَ  ، وَالَّذِي نَفْسُ  مُحَمَّدٍ  بِيَدِهِ لَا تَقُومُ السَّاعَةُ حَتَّى يَظْهَرَ  الْفُحْشُ  وَالتَّفَحُّشُ ، وَسُوءُ الْجِوَارِ ، وَقَطِيعَةُ الْأَرْحَامِ ، وَحَتَّى يُخَوَّنَ الْأَمِينُ ، وَيُؤْتَمَنَ الْخَائِنُ ، وَالَّذِي نَفْسُ  مُحَمَّدٍ  بِيَدِهِ إِنَّ أَسْلَمَ الْمُسْلِمِينَ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ ، وَإِنَّ أَفْضَلَ الْهِجْرَةِ مَنْ هَجَرَ مَا نَهَى اللهُ عَنْهُ .  وَالَّذِي نَفْسِي بِيَدِهِ إِنَّ مَثَلَ الْمُؤْمِنِ كَمَثَلِ  النَّحْلَةِ  أَكَلَتْ طَيِّبًا وَوَضَعَتْ طَيِّبًا وَوَقَعَتْ فَلَمْ تَكْسِرْ وَلَمْ تُفْسِدْ ، أَلَا وَإِنَّ لِي حَوْضًا مَا بَيْنَ نَاحِيَتَيْهِ كَمَا بَيْنَ  أَيْلَةَ  إِلَى  مَكَّةَ  - أَوْ قَالَ :  صَنْعَاءَ  إِلَى  الْمَدِينَةِ  -  ، وَإِنَّ فِيهِ مِنَ الْأَبَارِيقِ مِثْلَ الْكَوَاكِبِ ، هُوَ أَشَدُّ بَيَاضًا مِنَ اللَّبَنِ وَأَحْلَى مِنَ الْعَسَلِ ، مَنْ شَرِبَ مِنْهُ لَمْ يَظْمَأْ بَعْدَهَا أَبَدًا  .","","Al-Mu'jam al-Kabir 14507","","عبد الله بن عمرو بن العاص عن سالم بن سلمة الهذلي عن عبد الله بن بريدة عن مطر بن طهمان الوراق عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14546","[13/593]      14508  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ .  وَحَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  حُسَيْنٌ الْمُعَلِّمُ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِي سَبْرَةَ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عَمْرٍو أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ يُبْغِضُ  الْفَاحِشَ  الْمُتَفَحِّشَ  ، وَلَا تَقُومُ السَّاعَةُ حَتَّى يَظْهَرَ  الْفُحْشُ  وَالتَّفَحُّشُ ، وَسُوءُ الْجِوَارِ وَقَطِيعَةُ الْأَرْحَامِ ، وَحَتَّى يُتَّمَنَ الْخَائِنُ وَيُخَوَّنَ الْأَمِينُ ، أَلَا إِنَّ مَوْعِدَكُمْ حَوْضِي ، عَرْضُهُ وَطُولُهُ وَاحِدٌ كَمَا بَيْنَ  أَيْلَةَ  وَمَكَّةَ  ،  مَسِيرَةُ  شَهْرٍ ، فِيهِ أَبَارِيقُ مِثْلُ الْكَوَاكِبِ ، شَرَابُهُ أَشَدُّ بَيَاضًا مِنَ الْفِضَّةِ ، مَنْ شَرِبَ مِنْهُ مَشْرَبًا لَمْ يَظْمَأْ بَعْدَهُ أَبَدًا  .","","Al-Mu'jam al-Kabir 14508","","عبد الله بن عمرو بن العاص عن سالم بن سلمة الهذلي عن عبد الله بن بريدة عن حسين المعلم عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14547","[13/594]      14509  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مَعْمَرُ بْنُ سَهْلٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ تَمَّامٍ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  بِشْرِ بْنِ شَغَافٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ شَيْءٍ أَكْرَمَ عَلَى اللهِ - جَلَّ ذِكْرُهُ - يَوْمَ الْقِيَامَةِ مِنَ ابْنِ آدَمَ  .  قِيلَ : يَا رَسُولَ اللهِ وَلَا الْمَلَائِكَةُ ؟ قَالَ : "" وَلَا الْمَلَائِكَةُ ، إِنَّ الْمَلَائِكَةَ مَجْبُورُونَ بِمَنْزِلَةِ الشَّمْسِ وَالْقَمَرِ  .","","Al-Mu'jam al-Kabir 14509","","عبد الله بن عمرو بن العاص عن أبو بشر بن شغاف الضبي عن بشر بن شغاف الضبي عن خالد الحذاء عن عبيد الله بن تمام السلمي عن معمر بن سهل بن معمر الأهوازي عن عبد الله بن أحمد الجواليقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14548","[13/595]      14510  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  خَلَّادُ بْنُ يَحْيَى .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  أَسْلَمَ الْعِجْلِيِّ ،  عَنْ  بِشْرِ بْنِ شَغَافٍ ،  عَنْ         [13/596]      عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  سُئِلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الصُّورِ  ؟ قَالَ : "" هُوَ قَرْنٌ يُنْفَخُ فِيهِ  .","","Al-Mu'jam al-Kabir 14510","","عبد الله بن عمرو بن العاص عن بشر بن شغاف الضبي عن أسلم العجلي الربعي عن سليمان بن طرخان عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14549","14511  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  أَسْلَمَ الْعِجْلِيِّ ،  عَنْ  بِشْرِ بْنِ شَغَافٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  قِيلَ : يَا رَسُولَ اللهِ مَا الصُّورُ ؟ قَالَ : "" قَرْنٌ يُنْفَحُ فِيهِ  .","","Al-Mu'jam al-Kabir 14511","","عبد الله بن عمرو بن العاص عن بشر بن شغاف الضبي عن أسلم العجلي الربعي عن سليمان بن طرخان عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14550","14512  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  أَحْمَدُ بْنُ حَفْصٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  سُوَيْدِ بْنِ حُجَيْرٍ ،  عَنِ  الْعَلَاءِ بْنِ زِيَادٍ ، قَالَ :  سَأَلَ  رَجُلٌ عَبْدَ اللهِ بْنَ عَمْرٍو         [13/597]      قَالَ :  أَيُّ الْمُؤْمِنِينَ أَفْضَلُ إِسْلَامًا ؟ قَالَ : "" مَنْ أَسْلَمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ  وَيَدِهِ "" ، قَالَ : فَأَيُّ الْمُؤْمِنِينَ أَفْضَلُ إِيمَانًا ؟ قَالَ : "" أَحْسَنُهُمْ  خُلُقًا  "" ، قَالَ : فَأَيُّ الْمُهَاجِرِينَ أَفْضَلُ ؟ قَالَ : "" مَنْ هَجَرَ مَا نَهَى اللهُ عَنْهُ "" ، قَالَ : فَأَيُّ  الْجِهَادِ  أَفْضَلُ ؟ قَالَ : "" مَنْ جَاهَدَ نَفْسَهُ فِي ذَاتِ اللهِ  .  قَالَ : أَنْتَ قُلْتَهُ يَا  عَبْدَ اللهِ بْنَ عَمْرٍو  أَمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : بَلْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Al-Mu'jam al-Kabir 14512","","عبد الله بن عمرو بن العاص عن العلاء بن زياد بن مطر عن سويد بن حجير الباهلي عن حجاج بن حجاج الباهلي الأحول عن إبراهيم بن طهمان عن حفص بن عبد الله بن راشد النيسابوري عن أحمد بن حفص بن عبد الله النيسابوري عن موسى بن هارون الحمال عن الطبراني","سفيان بن عوف عن عبد الله"
"14551","14513  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  أَحْمَدُ بْنُ حَفْصٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنِ  الْحَجَّاجِ بْنِ الْحَجَّاجِ ،  عَنْ  قَتَادَةَ ،  عَنْ  عُمَرَ بْنِ سَيْفٍ ،  عَنِ  الْمُهَلَّبِ بْنِ أَبِي صُفْرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تُبْعَثُ نَارٌ عَلَى  أَهْلِ الْمَشْرِقِ  فَتَحْشُرُهُمْ إِلَى  الْمَغْرِبِ  ،  فَتَبِيتُ مَعَهُمْ حَيْثُ بَاتُوا وَتَقِيلُ مَعَهُمْ حَيْثُ قَالُوا ، يَكُونُ لَهَا مَا سَقَطَ مِنْهُمْ وَتَخَلَّفَ ، تَسُوقُهُمْ سَوْقَ الْجَمَلِ الْكَسِيرِ  .","","Al-Mu'jam al-Kabir 14513","","عبد الله بن عمرو بن العاص عن المهلب بن أبي صفرة عن عمر بن سيف البصري عن قتادة بن دعامة عن حجاج بن حجاج الباهلي الأحول عن إبراهيم بن طهمان عن حفص بن عبد الله بن راشد النيسابوري عن أحمد بن حفص بن عبد الله النيسابوري عن موسى بن هارون الحمال عن الطبراني","سفيان بن عوف عن عبد الله"
"14552","[13/598]      14514  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ أَحْمَدَ بْنِ عُمَرَ الْوَكِيعِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  مُحَمَّدُ بْنُ ثَوْرٍ ،  ثَنَا  مَعْمَرٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  رَأَيْتُ فِي الْمَنَامِ [أَنَّهُمْ] أَخَذُوا عَمُودَ الْكِتَابِ  فَعَمَدُوا بِهِ إِلَى  الشَّامِ  ، فَإِذَا وَقَعَتِ الْفِتَنُ فَالْأَمْنُ  بِالشَّامِ  .","","Al-Mu'jam al-Kabir 14514","","عبد الله بن عمرو بن العاص عن أبو قلابة الجرمي عن أيوب السختياني عن معمر بن راشد عن محمد بن ثور الصنعاني عن مؤمل بن إسماعيل العدوي عن أحمد بن عمر الوكيعي عن إبراهيم بن أحمد بن عمر الوكيعي عن الطبراني","سفيان بن عوف عن عبد الله"
"14553","[13/599]      14515  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ الْحِمَّانِيُّ .  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ أَحْمَدَ بْنِ أَبِي عَقِيلٍ الْبَغْدَاذِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ يَحْيَى ،  عَنْ  سَعِيدِ بْنِ مِينَا ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قُلْتُ :  يَا رَسُولَ اللهِ إِنِّي رَجُلٌ  أَسْرُدُ  الصَّوْمَ ، أَفَأَصُومُ صَوْمَ الدَّهْرِ ؟ قَالَ : "" لَا "" ، قُلْتُ : أَصُومُ يَوْمَيْنِ وَأُفْطِرُ يَوْمًا ؟ قَالَ : "" لَا "" ، فَجَعَلْتُ أُنَاقِصُهُ ، فَقَالَ :  صُمْ صَوْمَ  دَاوُدَ  عَلَيْهِ السَّلَامُ ، فَإِنَّهُ كَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا  .","","Al-Mu'jam al-Kabir 14515","","عبد الله بن عمرو بن العاص عن سعيد بن مينا الحجازي عن حماد الأبح عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14554","14516  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  النَّضْرُ         [13/600]      بْنُ شُمَيْلٍ ،  عَنْ  عَوْفٍ ،  عَنْ  مَيْمُونِ بْنِ أَسْتَاذَ الْهَزَّانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ لَبِسَ مِنْ أُمَّتِي الذَّهَبَ فَمَاتَ وَهُوَ يَلْبَسُهُ حَرَّمَ اللهُ عَلَيْهِ ذَهَبَ الْجَنَّةِ  ، وَمَنْ مَاتَ مِنْ أُمَّتِي وَهُوَ يَلْبَسُ الْحَرِيرَ حَرَّمَ اللهُ عَلَيْهِ حَرِيرَ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 14516","","عبد الله بن عمرو بن العاص عن ميمون بن أستاذ الهزاني عن عوف بن أبي جميلة عن النضر بن شميل عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14555","14517  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ ،  ثَنَا  بَكْرُ بْنُ خَلَفٍ ،  ثَنَا  عَبْدُ الْأَعْلَى بْنُ عَبْدِ الْأَعْلَى ،  عَنْ  سَعِيدٍ الْجُرَيْرِيِّ ،  عَنْ  مَيْمُونِ بْنِ أُسْتَاذٍ ،  عَنِ  الصَّدَفِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ مَاتَ مِنْ أُمَّتِي يَتَحَلَّى الذَّهَبَ حَرَّمَ اللهُ حِلْيَتَهُ فِي الْآخِرَةِ  ، وَمَنْ مَاتَ مِنْ أُمَّتِي يَشْرَبُ الْخَمْرَ حَرَّمَ اللهُ عَلَيْهِ شُرْبَهَا فِي الْآخِرَةِ ، وَمَنْ مَاتَ مِنْ أُمَّتِي يَلْبَسُ الْحَرِيرَ حُرِمَ لُبْسَهُ فِي الْآخِرَةِ  .","","Al-Mu'jam al-Kabir 14517","","عبد الله بن عمرو بن العاص عن الصدفي عن ميمون بن أستاذ الهزاني عن سعيد بن إياس الجريري عن عبد الأعلى بن عبد الأعلى القرشي عن بكر بن خلف عن محمد بن علي بن زيد الصائغ عن الطبراني","سفيان بن عوف عن عبد الله"
"14556","[13/601]      14518  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَنَا  قَتَادَةُ ،  عَنْ  أَبِي أُمَامَةَ الثَّقَفِيِّ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [13/602]      قَالَ :  تُوضَعُ الرَّحِمُ يَوْمَ الْقِيَامَةِ ، لَهُ  حُجْنَةٌ  كَحُجْنَةِ  الْمِغْزَلِ  ، فَتَتَكَلَّمُ بِأَلْسُنٍ  طُلْقٍ  ذُلْقٍ  ، فَتَصِلُ مَنْ وَصَلَهَا وَتَقْطَعُ مَنْ قَطَعَهَا  .  كذا في طبعة الجريسي ، والصواب : (أبي ثمامة).","","Al-Mu'jam al-Kabir 14518","","عبد الله بن عمرو بن العاص عن أبو ثمامة الثقفي عن قتادة بن دعامة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن الطبراني","سفيان بن عوف عن عبد الله"
"14557","14519  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَبِي عِمْرَانَ الْجَوْنِيِّ قَالَ :  كَتَبَ إِلَيَّ  عَبْدُ اللهِ بْنُ         [13/603]      رَبَاحٍ ،  فَحَدَّثَنِي عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  هَجَّرْتُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَعَدْنَا بِالْبَابِ ، فَسَمِعَ رَجُلَيْنِ اخْتَلَفَا فِي آيَةٍ ، فَخَرَجَ إِلَيْنَا يُعْرَفُ الْغَضَبُ فِي وَجْهِهِ ، فَقَالَ :  إِنَّمَا هَلَكَ مَنْ كَانَ قَبْلَكُمْ بِكَثْرَةِ اخْتِلَافِهِمْ فِي الْقُرْآنِ  .","","Al-Mu'jam al-Kabir 14519","","عبد الله بن عمرو بن العاص عن عبد الله بن رباح الأنصاري عن عبد الملك بن حبيب الجوني عن حماد بن زيد عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","سفيان بن عوف عن عبد الله"
"14558","14520  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو عَوَانَةَ .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي ،  ثَنَا  يَحْيَى بْنُ حَمَّادٍ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  ثَنَا  عُثْمَانُ بْنُ قَيْسٍ ،  عَنْ  أَبِي         [13/604]      حَرْبِ بْنِ أَبِي الْأَسْوَدِ الدِّيلِيِّ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا أَظَلَّتِ  الْخَضْرَاءُ  وَلَا أَقَلَّتِ  الْغَبْرَاءُ  مِنْ رَجُلٍ أَصْدَقَ مِنْ  أَبِي ذَرٍّ  .","","Al-Mu'jam al-Kabir 14520","","عبد الله بن عمرو بن العاص عن أبو حرب بن أبي الأسود الديلي عن عثمان بن عمير البجلي عن الأعمش عن الوضاح بن عبد الله اليشكري عن يحيى بن حماد بن أبي زياد الشيباني عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14559","14521  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنِي  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُثْمَانَ بْنِ عُمَيْرٍ ،  عَنْ  أَبِي حَرْبِ بْنِ أَبِي الْأَسْوَدِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا أَقَلَّتِ  الْغَبْرَاءُ  وَلَا أَظَلَّتِ  الْخَضْرَاءُ  عَلَى ذِي  لَهْجَةٍ  أَصْدَقَ مِنْ  أَبِي ذَرٍّ  .","","Al-Mu'jam al-Kabir 14521","","عبد الله بن عمرو بن العاص عن أبو حرب بن أبي الأسود الديلي عن عثمان بن عمير البجلي عن الأعمش عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14560","14522  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  أَبَنَا  أَزْهَرُ بْنُ الْقَاسِمِ .         [13/605]      وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَزْهَرُ بْنُ الْقَاسِمِ الرَّاسِبِيُّ ،  ثَنَا  الْمُثَنَّى بْنُ سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ بَابِي ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ :  إِنَّ اللهَ  يُبَاهِي  مَلَائِكَتَهُ عَشِيَّةَ عَرَفَةَ بِأَهْلِ عَرَفَةَ  ، يَقُولُ : انْظُرُوا إِلَى عِبَادِي أَتَوْنِي شُعْثًا غُبْرًا  .","","Al-Mu'jam al-Kabir 14522","","عبد الله بن عمرو بن العاص عن عبد الله بن باباه البصري عن قتادة بن دعامة عن المثنى بن سعيد القسام عن أزهر بن القاسم الراسبي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14561","14523  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  عَفَّانُ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  أَبِي أَيُّوبَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  اجْتَمَعَ  نَوْفٌ الْبِكَالِيُّ  وَعَبْدُ اللهِ بْنُ عَمْرٍو  ، فَقَالَ  نَوْفٌ  : لَوْ أَنَّ السَّمَاوَاتِ وَالْأَرْضَ وُضِعْنَ فِي كِفَّةٍ وَوُضِعَتْ "" لَا إِلَهَ إِلَّا اللهُ "" فِي كِفَّةٍ أُخْرَى لَرَجَحَتْ "" لَا إِلَهَ إِلَّا اللهُ "" ، وَلَوْ أَنَّ السَّمَاوَاتِ وَالْأَرْضَ كَانَتَا طَبَقًا مِنْ حَدِيدٍ لَخَرَقَتْهُنَّ "" لَا إِلَهَ إِلَّا اللهُ "" .  فَقَالَ  عَبْدُ اللهِ بْنُ عَمْرٍو  : صَلَّى بِنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمَغْرِبَ ، فَعَقَّبَ قَوْمٌ وَذَهَبَ قَوْمٌ ، فَخَرَجَ حِينَ مَضَى نِصْفُ اللَّيْلِ وَقَدْ  حَسَرَ  عَنْ رُكْبَتَيْهِ         [13/606]      فَزَعًا ، وَقَدْ  حَفَزَهُ  النَّفَسُ ، وَهُوَ يَقُولُ :  أَبْشِرُوا يَا مَعْشَرَ الْمُسْلِمِينَ ! أَبْشِرُوا ! هَذَا رَبُّكُمْ فَتَحَ بَابَ السَّمَاءِ  يُبَاهِي  بِكُمُ الْمَلَائِكَةَ  ، يَقُولُ : انْظُرُوا إِلَى عِبَادِي قَدْ قَضَوْا فَرِيضَةً وَهُمْ يَنْتَظِرُونَ أُخْرَى  .","","Al-Mu'jam al-Kabir 14523","","عبد الله بن عمرو بن العاص عن أبو أيوب المراغي عن ثابت البناني عن حماد بن سلمة عن عفان بن مسلم الصفار عن أحمد بن محمد بن أحمد الجواربي عن الطبراني","سفيان بن عوف عن عبد الله"
"14562","14524  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ .         [13/607]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ، قَالَا :  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي أَيُّوبَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ  رَجُلًا  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ وَقْتِ الصَّلَاةِ ؟ فَقَالَ :  وَقْتُ صَلَاةِ الظُّهْرِ إِذَا زَالَتِ الشَّمْسُ فَكَانَ ظِلُّ الرَّجُلِ كَطُولِهِ مَا لَمْ يَحْضُرِ الْعَصْرُ  ، وَوَقْتُ الْعَصْرِ مَا لَمْ تَغْرُبِ الشَّمْسُ ، وَوَقْتُ الْمَغْرِبِ مَا لَمْ يَغِبِ  الشَّفَقُ  ، وَوَقْتُ الْعِشَاءِ إِلَى نِصْفِ اللَّيْلِ ، وَوَقْتُ الْفَجْرِ مِنْ طُلُوعِ الْفَجْرِ مَا لَمْ تَطْلُعِ الشَّمْسُ  .  أَبُو أَيُّوبَ هَذَا الَّذِي رَوَى عَنْهُ قَتَادَةُ هُوَ الْأَزْدِيُّ ، اسْمُهُ يَحْيَى بْنُ مَالِكٍ  ،  ثِقَةٌ  .","","Al-Mu'jam al-Kabir 14524","","عبد الله بن عمرو بن العاص عن أبو أيوب المراغي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","سفيان بن عوف عن عبد الله"
"14563","14525  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَبَنَا         [13/608]      شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي أَيُّوبَ ،  عَنْ  عَبْدِ اللهِ - أَظُنُّهُ ابْنَ عَمْرٍو  - ، قَالَ  شُعْبَةُ  : كَانَ أَحْيَانًا  يَرْفَعُهُ  وَأَحْيَانًا لَا  يَرْفَعُهُ  ، قَالَ :  وَقْتُ الْعَصْرِ مَا لَمْ يَحْضُرْ وَقْتُ الْمَغْرِبِ  ، وَوَقْتُ الْمَغْرِبِ مَا لَمْ يَسْقُطِ  الشَّفَقُ  ، وَوَقْتُ الْعِشَاءِ مَا لَمْ يَنْتَصِفِ اللَّيْلُ ، وَوَقْتُ الصُّبْحِ مَا لَمْ تَطْلُعِ الشَّمْسُ  .","","Al-Mu'jam al-Kabir 14525","","عبد الله بن عمرو بن العاص عن أبو أيوب المراغي عن قتادة بن دعامة عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سفيان بن عوف عن عبد الله"
"14564","14526  -  حَدَّثَنَا  أَبُو الدَّرْدَاءِ عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْأَشْعَثِ الْأَنْطَرْطُوسِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عُبَيْدَةَ ،  ثَنَا  أَبِي  ،  ثَنَا  الْجَرَّاحُ بْنُ         [13/609]      مَلِيحٍ ،  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ عَبْدِ الْحَمِيدِ بْنِ ذِي حِمَايَةَ ،  عَنْ  شُعْبَةَ ،  عَنْ  قَتَادَةَ بْنِ دِعَامَةَ ،  عَنْ  أَبِي أَيُّوبَ الْأَزْدِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،  رَفَعَهُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  صَلَاةُ الْأُولَى قَبْلَ أَنْ يَدْخُلَ وَقْتُ الْعَصْرِ  ، وَالْعَصْرُ قَبْلَ أَنْ تَصْفَرَّ الشَّمْسُ ، وَالْمَغْرِبُ قَبْلَ أَنْ يَسْقُطَ  الشَّفَقُ  ، وَالْعِشَاءُ الْآخِرَةُ فِي نِصْفِ اللَّيْلِ ، وَالصُّبْحُ قَبْلَ طُلُوعِ الشَّمْسِ  .","","Al-Mu'jam al-Kabir 14526","","عبد الله بن عمرو بن العاص عن أبو أيوب المراغي عن قتادة بن دعامة عن شعبة بن الحجاج عن إبراهيم بن عبد الحميد الرحبي عن الجراح بن مليح البهراني عن محمد بن عبيدة المددي عن إبراهيم بن محمد بن عبيدة المددي عن عبد الله بن محمد بن الأشعث الأنطرسوسي عن الطبراني","سفيان بن عوف عن عبد الله"
"14565","14527  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  ،  ثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي أَيُّوبَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  سَيِّدُ رَيْحَانِ أَهْلِ الْجَنَّةِ الْحِنَّاءُ  .","","Al-Mu'jam al-Kabir 14527","","عبد الله بن عمرو بن العاص عن أبو أيوب المراغي عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14566","[13/610]      14528  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  أَحْمَدُ بْنُ يَحْيَى السُّوسِيُّ ،  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ عَطَاءٍ ،  عَنْ  سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي أَيُّوبَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا أَرَادَ أَنْ يَنَامَ وَهُوَ  جُنُبٌ  تَوَضَّأَ  .","","Al-Mu'jam al-Kabir 14528","","عبد الله بن عمرو بن العاص عن أبو أيوب المراغي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الوهاب بن عطاء الخفاف عن أحمد بن يحيى بن مالك الهمداني عن أحمد بن يحيى بن زهير التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14567","[13/611]      14529  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ ،  ثَنَا  أَحْمَدُ بْنُ يَحْيَى السُّوسِيُّ ،  ثَنَا  عَبْدُ الْوَهَّابِ ،  ثَنَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي أَيُّوبَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو مِثْلَهُ .","","Al-Mu'jam al-Kabir 14529","","عبد الله بن عمرو بن العاص عن أبو أيوب المراغي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الوهاب بن عطاء الخفاف عن أحمد بن يحيى بن مالك الهمداني عن أحمد بن يحيى بن زهير التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14568","14530  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدِ بْنِ حَرْبٍ الْعَبَّادَانِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  خَالِدٍ         [13/612]      الْحَذَّاءِ ،  عَنِ  الْقَاسِمِ بْنِ رَبِيعَةَ ،  عَنْ  عُقْبَةَ بْنِ أَوْسٍ السَّدُوسِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَطَبَ  يَوْمَ الْفَتْحِ  وَكَبَّرَ ثَلَاثًا ، ثُمَّ قَالَ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، صَدَقَ وَعْدَهُ ، وَنَصَرَ عَبْدَهُ  ، وَهَزَمَ  الْأَحْزَابَ  وَحْدَهُ ، أَلَا إِنَّ كُلَّ  مَأْثُرَةٍ  كَانَتْ فِي الْجَاهِلِيَّةِ تُذْكَرُ وَتُدْعَى ، وَدَمٍ وَمَالٍ تَحْتَ  قَدَمَيَّ  هَاتَيْنِ ، إِلَّا  سِدَانَةَ  الْبَيْتِ  وَسِقَايَةَ الْحَاجِّ ، أَلَا وَإِنَّ قَتِيلَ  الْخَطَأِ  شِبْهِ  الْعَمْدِ مَا كَانَ بِسَوْطٍ أَوْ عَصًا : مِائَةٌ مِنَ الْإِبِلِ ، مِنْهَا أَرْبَعُونَ فِي بُطُونِهَا أَوْلَادُهَا ""  .","","Al-Mu'jam al-Kabir 14530","","عبد الله بن عمرو بن العاص عن عقبة بن أوس السدوسي عن القاسم بن ربيعة بن جوشن الغطفاني عن خالد الحذاء عن حماد بن زيد عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14569","14531  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنِ  الْقَاسِمِ بْنِ رَبِيعَةَ ،  عَنْ  عُقْبَةَ بْنِ أَوْسٍ السَّدُوسِيِّ ،  عَنْ  رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَمَّا قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَكَّةَ  قَالَ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ ، صَدَقَ وَعْدَهُ ، وَنَصَرَ عَبْدَهُ  ، وَهَزَمَ  الْأَحْزَابَ  وَحْدَهُ ...  فَذَكَرَ مِثْلَ حَدِيثِ  حَمَّادِ بْنِ زَيْدٍ  .","","Al-Mu'jam al-Kabir 14531","","أحد الصحابة عن عقبة بن أوس السدوسي عن القاسم بن ربيعة بن جوشن الغطفاني عن خالد الحذاء عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14570","[13/613]      14532  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ ،  ثَنَا  بَكْرُ بْنُ خَلَفٍ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَيُّوبَ قَالَ :  سَمِعْتُ  الْقَاسِمَ بْنَ رَبِيعَةَ  يُحَدِّثُ عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ قَتْلَ  الْخَطَأِ  شِبْهِ  الْعَمْدِ قَتِيلَ السَّوْطِ  وَالْعَصَا  ، فِيهِ مِائَةٌ مِنَ الْإِبِلِ ، مِنْهَا أَرْبَعُونَ فِي بُطُونِهَا أَوْلَادُهَا  .","","Al-Mu'jam al-Kabir 14532","","عبد الله بن عمرو بن العاص عن القاسم بن ربيعة بن جوشن الغطفاني عن أيوب السختياني عن شعبة بن الحجاج عن غندر ربيب شعبة عن بكر بن خلف عن محمد بن علي بن زيد الصائغ عن الطبراني","سفيان بن عوف عن عبد الله"
"14571","[13/614]      14533  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنْ  عُقْبَةَ بْنِ وَسَّاجٍ  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ :  أُتِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِسِقَايَةٍ مِنْ ذَهَبٍ  ... فَذَكَرَ الْحَدِيثَ  .","","Al-Mu'jam al-Kabir 14533","","عبد الله بن عمرو بن العاص عن عقبة بن وساج البرساني عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14572","[13/615]      14534  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ، قَالَ :  كُنْتُ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِحُشَّانٍ مِنْ  حُشَّانِ  الْمَدِينَةِ  ، فَجَاءَ رَجُلٌ فَاسْتَأْذَنَ ، فَقَالَ :  قُمْ فَأْذَنْ لَهُ وَبَشِّرْهُ بِالْجَنَّةِ  ، فَقُمْتُ فَأَذِنْتُ لَهُ فَإِذَا هُوَ  أَبُو بَكْرٍ  ، فَبَشَّرْتُهُ بِالْجَنَّةِ ، فَجَعَلَ يَحْمَدُ اللهَ حَتَّى جَلَسَ ، ثُمَّ جَاءَ رَجُلٌ فَاسْتَأْذَنَ ، فَقَالَ : "" قُمْ فَأْذَنْ لَهُ وَبَشِّرْهُ بِالْجَنَّةِ "" ، فَقُمْتُ فَأَذِنْتُ لَهُ فَإِذَا هُوَ  عُمَرُ  ، فَبَشَّرْتُهُ بِالْجَنَّةِ ، فَجَعَلَ يَحْمَدُ اللهَ حَتَّى جَلَسَ ، ثُمَّ جَاءَ خَفِيضَ الصَّوْتِ ، فَقَالَ : "" قُمْ فَأْذَنْ لَهُ وَبَشِّرْهُ بِالْجَنَّةِ         [13/616]      [عَلَى بَلْوَى] تُصِيبُهُ "" ، فَقُمْتُ فَأَذِنْتُ لَهُ فَإِذَا هُوَ  عُثْمَانُ  ، فَبَشَّرْتُهُ بِالْجَنَّةِ عَلَى بَلْوَى تُصِيبُهُ ، فَجَعَلَ يَقُولُ : اللَّهُمَّ صَبْرًا ، حَتَّى جَلَسَ ، قُلْتُ : يَا رَسُولَ اللهِ فَأَيْنَ أَنَا ؟ قَالَ : "" أَنْتَ مَعَ أَبِيكَ  .","","Al-Mu'jam al-Kabir 14534","","عبد الله بن عمرو بن العاص عن محمد بن سيرين عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن زكريا بن يحيى السجزي عن الطبراني","سفيان بن عوف عن عبد الله"
"14573","14535  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  دَاوُدُ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُحَمَّدِ بْنِ عُبَيْدٍ الْحَنَفِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14535","","عبد الله بن عمرو بن العاص عن محمد بن عبيد أبو قدامة الحنفي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن داود بن مهران الدباغ عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14574","14536  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُحَمَّدِ بْنِ عُبَيْدٍ الْحَنَفِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  كُنْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي حُشٍّ  ، فَجَاءَ رَجُلٌ فَاسْتَأْذَنَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ...  فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14536","","عبد الله بن عمرو بن العاص عن محمد بن عبيد أبو قدامة الحنفي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عبد الرحمن بن مهدي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14575","14537  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  أَشْعَثُ بْنُ عَبْدِ الْمَلِكِ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ  قَالَ  :  كَانَ عَبْدُ اللهِ بْنُ عَمْرِو بْنِ الْعَاصِ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَاسْتَأْذَنَ رَجُلٌ ،         [13/617]      فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ائْذَنُوا لَهُ وَبَشِّرْهُ بِالْجَنَّةِ  ، فَدَخَلَ فَإِذَا  أَبُو بَكْرٍ  ، ثُمَّ اسْتَأْذَنَ رَجُلٌ ، فَقَالَ : "" ائْذَنُوا لَهُ وَبَشِّرُوهُ بِالْجَنَّةِ "" ، فَدَخَلَ فَإِذَا  عُمَرُ بْنُ الْخَطَّابِ  ، وَاسْتَأْذَنَ رَجُلٌ فَقَالَ : "" ائْذَنُوا لَهُ وَبَشِّرُوهُ بِالْجَنَّةِ "" ، فَدَخَلَ  عُثْمَانُ بْنُ عَفَّانَ  ، فَقَالَ  عَبْدُ اللهِ بْنُ عَمْرٍو  : فَأَيْنَ أَنَا يَا رَسُولَ اللهِ ؟ قَالَ : "" أَنْتَ مَعَ أَبِيكَ  .","","Al-Mu'jam al-Kabir 14537","","عبد الله بن عمرو بن العاص عن محمد بن سيرين عن أشعث الحمراني عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14576","14538  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  سَالِمٌ الْخَيَّاطُ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ سِيرِينَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّهُ كَانَ قَاعِدًا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  سَيَكُونُ مِنْ بَعْدِي أَئِمَّةٌ يُؤَخِّرُونَ الصَّلَاةَ عَنْ مَوَاقِيتِهَا  ، قُلْتُ : يَا رَسُولَ اللهِ ، فَكَيْفَ يَصْنَعُ مَنْ أَدْرَكَهُمْ ؟ قَالَ : "" صَلُّوهَا لِوَقْتِهَا ، فَإِذَا حَضَرْتُمْ مَعَهُمُ الصَّلَاةَ فَصَلُّوا  .","","Al-Mu'jam al-Kabir 14538","","عبد الله بن عمرو بن العاص عن محمد بن سيرين عن سالم بن عبد الله الخياط عن الوليد بن مسلم القرشي عن محمد بن مصفى بن بهلول عن عبد الله بن أحمد الجواليقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14577","[13/618]      14539  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ  شَرِبَ  الْخَمْرَ فَاجْلِدُوهُ  ، قَالَهَا ثَلَاثًا ، "" فَإِنْ شَرِبَهَا الرَّابِعَةَ فَاقْتُلُوهُ  .","","Al-Mu'jam al-Kabir 14539","","عبد الله بن عمرو بن العاص عن شهر بن حوشب عن قتادة بن دعامة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14578","14540  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ ،  ثَنَا  بَكْرُ بْنُ خَلَفٍ ،  ثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ         [13/619]      عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَخْرُجُ نَاسٌ مِنْ قِبَلِ الْمَشْرِقِ  ، يَقْرَؤُونَ الْقُرْآنَ لَا يُجَاوِزُ  تَرَاقِيَهُمْ  ، كُلَّمَا قُطِعَ قَرْنٌ نَشَأَ قَرْنٌ ، حَتَّى يَكُونَ مَعَ بَقِيَّتِهِمُ  الدَّجَّالُ  .","","Al-Mu'jam al-Kabir 14540","","عبد الله بن عمرو بن العاص عن شهر بن حوشب عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن بكر بن خلف عن محمد بن علي بن زيد الصائغ عن الطبراني","سفيان بن عوف عن عبد الله"
"14579","14541  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  أَبُو صَالِحٍ عَبْدُ اللهِ بْنُ صَالِحٍ .         [13/620]      وَحَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ قَالَا :  ثَنَا  اللَّيْثُ بْنُ سَعْدٍ ،  عَنْ  إِسْحَاقَ بْنِ أَسِيدٍ ،  عَنْ  رَجَاءِ بْنِ حَيْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَلِيلُ الْفِقْهِ خَيْرٌ مِنْ كَثِيرِ الْعِبَادَةِ  ، وَكَفَى بِالْمَرْءِ فِقْهًا إِذَا عَبَدَ اللهَ ، وَكَفَى بِالْمَرْءِ جَهْلًا إِذَا أُعْجِبَ بِرَأْيِهِ ، إِنَّمَا النَّاسُ رَجُلَانِ : مُؤْمِنٌ وَجَاهِلٌ ، فَلَا تُؤْذِي الْمُؤْمِنَ وَلَا تُحَاوِرِ الْجَاهِلَ  .","","Al-Mu'jam al-Kabir 14541","","عبد الله بن عمرو بن العاص عن حيوة بن جرول الكندي عن رجاء بن حيوة عن إسحاق بن أسيد الخراساني عن الليث بن سعد عن يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","سفيان بن عوف عن عبد الله"
"14580","14542  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا         [13/621]      جَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّهُ كَائِنٌ فِيكُمْ قَوْمٌ يَقْرَؤُونَ الْقُرْآنَ لَا يُجَاوِزُ رُؤُوسَهُمْ  ، كُلَّمَا طَلَعَ مِنْهُمْ قَرْنٌ قُطِعَ ، كُلَّمَا طَلَعَ مِنْهُمْ قَرْنٌ قُطِعَ - حَتَّى ذَكَرَ عِشْرِينَ مَرَّةً وَزِيَادَةً - ، حَتَّى يَكُونَ آخِرُهُمْ يَخْرُجُ مَعَ  الدَّجَّالِ  .","","Al-Mu'jam al-Kabir 14542","","عبد الله بن عمرو بن العاص عن شهر بن حوشب عن ليث بن أبي سليم عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14581","وَعَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  هِجْرَةٌ بَعْدَ هِجْرَةٍ ، حَتَّى يُهَاجِرَ النَّاسُ إِلَى  مُهَاجَرِ  إِبْرَاهِيمَ  ، وَحَتَّى لَا يَبْقَى عَلَى الْأَرْضِ إِلَّا شِرَارُ أَهْلِهَا ، تَقْذَرُهُمْ رُوحُ اللهِ  وَتَلْفِظُهُمْ  أَرْضُهُمْ ، وَتَحْشُرُهُمُ النَّارُ مِنْ عَدَنٍ مَعَ الْقِرَدَةِ وَالْخَنَازِيرِ ، تَبِيتُ مَعَهُمْ أَيْنَمَا بَاتُوا وَتَقِيلُ مَعَهُمْ أَيْنَمَا قَالُوا ، وَلَهَا مَا سَقَطَ مِنْهُمْ  .","","Al-Mu'jam al-Kabir 14581","","عبد الله بن عمرو بن العاص عن شهر بن حوشب عن ليث بن أبي سليم عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14582","[13/622]      14543  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مَحْمُودِ بْنِ مُحَمَّدٍ النَّيْسَابُورِيُّ ،  ثَنَا  يَحْيَى بْنُ يَحْيَى النَّيْسَابُورِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  رُبَّ حَامِلِ فِقْهٍ غَيْرُ فَقِيهٍ  ، وَمَنْ لَمْ يَنْفَعْهُ عِلْمُهُ ضَرَّهُ جَهْلُهُ ، اقْرَأِ الْقُرْآنَ مَا نَهَاكَ ، فَإِنْ لَمْ يَنْهَكَ فَلَسْتَ تَقْرَؤُهُ  .","","Al-Mu'jam al-Kabir 14543","","عبد الله بن عمرو بن العاص عن شهر بن حوشب عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن إسماعيل بن عياش الأحول عن يحيى بن يحيى الحنظلي عن إسماعيل بن محمود النيسابوري عن الطبراني","سفيان بن عوف عن عبد الله"
"14583","14544  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  مَسْلَمَةُ بْنُ عُلَيٍّ ،  حَدَّثَنِي  الْأَوْزَاعِيُّ ،  عَنْ  مَكْحُولٍ ،  عَنْ  رَجَاءِ بْنِ حَيْوَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  صَلَّيْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا انْصَرَفَ قَالَ لَنَا :  هَلْ تَقْرَؤُونَ الْقُرْآنَ إِذَا كُنْتُمْ مَعِي فِي الصَّلَاةِ ؟  قُلْنَا : نَعَمْ ، قَالَ : "" فَلَا تَفْعَلُوا إِلَّا بِأُمِّ الْقُرْآنِ  .","","Al-Mu'jam al-Kabir 14544","","عبد الله بن عمرو بن العاص عن رجاء بن حيوة عن مكحول بن أبي مسلم عن أبو عمرو الأوزاعي عن مسلمة بن علي بن خلف الخشني عن سعيد بن الحكم الجمحي عن يحيى بن عثمان بن صالح عن الطبراني","سفيان بن عوف عن عبد الله"
"14584","[13/623]      14545  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ ، وَأَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ، قَالَا :  ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنْ  رَبِيعَةَ بْنِ يَزِيدَ ،  عَنْ  أَبِي إِدْرِيسَ الْخَوْلَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : سَمِعْتُ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  بَيْنَا أَنَا نَائِمٌ رَأَيْتُ عَمُودَ الْكِتَابِ احْتُمِلَ مِنْ تَحْتِ رَأْسِي  ، فَأَتْبَعْتُهُ بَصَرِي ، فَإِذَا هُوَ قَدْ عُمِدَ بِهِ إِلَى  الشَّامِ  ، أَلَا وَإِنَّ الْإِيمَانَ إِذَا كَانَتِ الْفِتَنُ  بِالشَّامِ  "" ثَلَاثَ مَرَّاتٍ  .","","Al-Mu'jam al-Kabir 14545","","عبد الله بن عمرو بن العاص عن عائذ الله بن عبد الله الخولاني عن ربيعة بن يزيد القصير عن جعفر بن ربيعة الكندي عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن روح بن الفرج القطان عن الطبراني","سفيان بن عوف عن عبد الله"
"14585","14546  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  حَسَّانَ بْنِ عَطِيَّةَ ،  عَنْ  أَبِي كَبْشَةَ السَّلُولِيِّ ،  عَنْ         [13/624]      عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بَلِّغُوا عَنِّي وَلَوْ آيَةً  ، وَحَدِّثُوا عَنْ  بَنِي إِسْرَائِيلَ  وَلَا  حَرَجَ ،  وَمَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 14546","","عبد الله بن عمرو بن العاص عن أبو كبشة السلولي عن حسان بن عطية المحاربي عن أبو عمرو الأوزاعي عن أبو عاصم النبيل عن أبو مسلم الكجي عن الطبراني","سفيان بن عوف عن عبد الله"
"14586","[13/625]      14547  -  حَدَّثَنَا  ابْنُ أَبِي مَرْيَمَ ،  ثَنَا  الْفِرْيَابِيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  حَسَّانَ بْنِ عَطِيَّةَ ،  عَنْ  أَبِي كَبْشَةَ السَّلُولِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،         [13/626]      قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَرْبَعُونَ حَسَنَةً ، أَعْلَاهَا مِنْحَةُ الْعَنْزِ  ، مَنْ عَمِلَ حَسَنَةً مِنْهَا رَجَاءَ ثَوَابِهَا أَدْخَلَهُ اللهُ الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 14547","","عبد الله بن عمرو بن العاص عن أبو كبشة السلولي عن حسان بن عطية المحاربي عن أبو عمرو الأوزاعي عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","سفيان بن عوف عن عبد الله"
"14587","14548  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ الدِّمَشْقِيُّ ،  ثَنَا  عَلِيُّ بْنُ عَيَّاشٍ ،  ثَنَا  ابْنُ ثَوْبَانَ ،  عَنْ  حَسَّانَ بْنِ عَطِيَّةَ ،  عَنْ  أَبِي كَبْشَةَ         [13/627]      السَّلُولِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَدِّدُوا  وَقَارِبُوا ،  وَخَيْرُ أَعْمَالِكُمُ الصَّلَاةُ ، وَلَا يُحَافِظُ عَلَى الْوُضُوءِ إِلَّا مُؤْمِنٌ  .","","Al-Mu'jam al-Kabir 14548","","عبد الله بن عمرو بن العاص عن أبو كبشة السلولي عن حسان بن عطية المحاربي عن عبد الرحمن بن ثابت العنسي عن علي بن عياش الألهاني عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","سفيان بن عوف عن عبد الله"
"14588","14549  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  رَبِيعَةَ بْنِ يَزِيدَ ،  عَنِ  ابْنِ الدَّيْلَمِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ  شَرِبَ  الْخَمْرَ لَمْ يَقْبَلِ اللهُ مِنْهُ صَلَاةً أَرْبَعِينَ يَوْمًا  .","","Al-Mu'jam al-Kabir 14549","","عبد الله بن عمرو بن العاص عن عبد الله بن فيروز عن ربيعة بن يزيد القصير عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14589","14550  -  حَدَّثَنَا  ابْنُ أَبِي مَرْيَمَ ،  حَدَّثَنَا  الْفِرْيَابِيُّ .  وَحَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ، قَالَا :  ثَنَا  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  رَبِيعَةُ بْنُ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ الدَّيْلَمِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         [13/628]      مَنْ  شَرِبَ  الْخَمْرَ لَمْ يَقْبَلِ اللهُ تَوْبَتَهُ أَرْبَعِينَ صَبَاحًا  ، فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ ، فَإِنْ عَادَ لَمْ يَقْبَلْ تَوْبَتَهُ أَرْبَعِينَ صَبَاحًا ، فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ ""  ثَلَاثًا أَوْ أَرْبَعًا  . قَالَ  الْأَوْزَاعِيُّ  :  مَا أَدْرِي فِي الثَّالِثَةِ أَوْ فِي الرَّابِعَةِ  :  "" فَإِنْ عَادَ كَانَ حَقًّا عَلَى اللهِ عَزَّ وَجَلَّ أَنْ يَسْقِيَهُ مِنْ  رَدْغَةِ  الْخَبَالِ  يَوْمَ الْقِيَامَةِ  . قَالَ  الْأَوْزَاعِيُّ  :  رَدْغَةُ  الْخَبَالِ  صَدِيدُ  أَهْلِ النَّارِ  .","","Al-Mu'jam al-Kabir 14550","","عبد الله بن عمرو بن العاص عن عبد الله بن فيروز عن ربيعة بن يزيد القصير عن أبو عمرو الأوزاعي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","سفيان بن عوف عن عبد الله"
"14590","14551  -  حَدَّثَنَا  طَالِبُ بْنُ قُرَّةَ الْأَذَنِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ،  ثَنَا  فَرَجُ بْنُ فَضَالَةَ ،  عَنْ  رَبِيعَةَ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ الدَّيْلَمِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ... مِثْلَ حَدِيثِ  الْأَوْزَاعِيِّ  .","","Al-Mu'jam al-Kabir 14551","","عبد الله بن عمرو بن العاص عن عبد الله بن فيروز عن ربيعة بن يزيد القصير عن فرج بن فضالة بن النعمان التنوخي عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن طالب بن قرة الأذني عن الطبراني","سفيان بن عوف عن عبد الله"
"14591","14552  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرٍ الْقَطَّانُ الْهَمَذَانِيُّ ،  ثَنَا  هِشَامُ بْنُ         [13/629]      عَمَّارٍ ،  ثَنَا  عَمْرُو بْنُ وَاقِدٍ ،  حَدَّثَنِي  يَحْيَى بْنُ سُلَيْمٍ ،  عَنْ  أَبِي سَلَّامٍ الْحَبَشِيِّ ،  عَنِ  ابْنِ الدَّيْلَمِيِّ قَالَ :  أَتَيْتُ  عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ ، قُلْتُ : سَمِعْتَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ  شَرِبَ  الْخَمْرَ رَجُسَ وَرَجُسَتْ صَلَاتُهُ أَرْبَعِينَ يَوْمًا  ، فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ ، ثُمَّ إِنْ عَادَ رَجُسَ وَرَجُسَتْ صَلَاتُهُ أَرْبَعِينَ يَوْمًا ، ثُمَّ إِنْ تَابَ تَابَ اللهُ عَلَيْهِ ، ثُمَّ إِنْ عَادَ رَجُسَ وَرَجُسَتْ صَلَاتُهُ أَرْبَعِينَ يَوْمًا ، فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ ، فَإِنْ عَادَ كَانَ حَقًّا عَلَى اللهِ أَنْ يَسْقِيَهُ مِنْ  رَدْغَةِ  الْخَبَالِ  يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 14552","","عبد الله بن عمرو بن العاص عن عبد الله بن فيروز عن ممطور الحبشي عن يحيى بن سليمان عن عمرو بن واقد القرشي عن هشام بن عمار عن محمد بن نصر مموس الهمداني عن الطبراني","سفيان بن عوف عن عبد الله"
"14592","14553  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ شُعَيْبِ بْنِ شَابُورَ ،  عَنْ  عُرْوَةَ بْنِ         [13/630]      رُوَيْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الدَّيْلَمِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ  سُلَيْمَانَ بْنَ دَاوُدَ  سَأَلَ اللهَ ثَلَاثًا فَأَعْطَاهُ اللهُ اثْنَتَيْنِ  ، وَأَرْجُو أَنْ يَكُونَ أَعْطَاهُ الثَّالِثَةَ : سَأَلَهُ أَنْ يَحْكُمَ بِحُكْمٍ يُوَاطِئُ حُكْمَهُ فَأُعْطِيَ ، وَسَأَلَهُ مُلْكًا لَا يَنْبَغِي لِأَحَدٍ مِنْ بَعْدِهِ فَأَعْطَاهُ ، وَسَأَلَهُ أَيُّمَا عَبْدٍ أَتَى  بَيْتَ الْمَقْدِسِ  لَا يُرِيدُ إِلَّا الصَّلَاةَ فِيهِ أَنْ يَكُونَ مِنْ خَطِيئَتِهِ كَيَوْمِ وَلَدَتْهُ أُمُّهُ  .","","Al-Mu'jam al-Kabir 14553","","عبد الله بن عمرو بن العاص عن عبد الله بن فيروز عن عروة بن رويم اللخمي عن محمد بن شعيب بن شابور القرشي عن سليمان بن عبد الرحمن التميمي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","سفيان بن عوف عن عبد الله"
"14593","14554  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  رَبِيعَةَ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ الدَّيْلَمِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [13/631]      يَقُولُ :  إِنَّ  سُلَيْمَانَ بْنَ دَاوُدَ  سَأَلَ رَبَّهُ ثَلَاثًا فَأَعْطَاهُ اثْنَتَيْنِ  ، وَأَرْجُو أَنْ يَكُونَ قَدْ أَعْطَاهُ الثَّالِثَةَ : سَأَلَ رَبَّهُ حُكْمًا يُصَادِفُ حُكْمَهُ فَأَعْطَاهُ ، وَسَأَلَهُ مُلْكًا لَا يَنْبَغِي لِأَحَدٍ مِنْ بَعْدِهِ فَأَعْطَاهُ ، وَسَأَلَ أَيُّمَا رَجُلٍ خَرَجَ مِنْ بَيْتِهِ لَا يُرِيدُ إِلَّا الصَّلَاةَ فِي هَذَا الْمَسْجِدِ -  يَعْنِي  مَسْجِدَ بَيْتِ الْمَقْدِسِ  - أَنْ يَخْرُجَ مِنْ خَطِيئَتِهِ مِثْلَ يَوْمَ وَلَدَتْهُ أُمُّهُ ، وَنَحْنُ نَرْجُو أَنْ يَكُونَ قَدْ أَعْطَاهُ ذَلِكَ  .","","Al-Mu'jam al-Kabir 14554","","عبد الله بن عمرو بن العاص عن عبد الله بن فيروز عن ربيعة بن يزيد القصير عن أبو عمرو الأوزاعي عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","سفيان بن عوف عن عبد الله"
"14594","14555  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  رَبِيعَةَ بْنِ يَزِيدَ ،  عَنِ  ابْنِ الدَّيْلَمِيِّ ،  عَنْ  عَبْدِ اللهِ         [13/632]      بْنِ عَمْرٍو ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ  سُلَيْمَانَ بْنَ دَاوُدَ  سَأَلَ اللهَ عَزَّ وَجَلَّ ثَلَاثًا  : سَأَلَهُ مُلْكًا لَا يَنْبَغِي لِأَحَدٍ مِنْ بَعْدِهِ فَأَعْطَاهُ إِيَّاهُ ، وَسَأَلَهُ حُكْمًا يُصَادِفُ حُكْمَهُ فَأَعْطَاهُ ، وَسَأَلَهُ مَنْ أَتَى هَذَا  الْبَيْتَ  لَا يُرِيدُ إِلَّا الصَّلَاةَ فِيهِ أَنْ يَغْفِرَ لَهُ  .","","Al-Mu'jam al-Kabir 14555","","عبد الله بن عمرو بن العاص عن عبد الله بن فيروز عن ربيعة بن يزيد القصير عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14595","14556  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  يَحْيَى بْنِ أَبِي عَمْرٍو السَّيْبَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ الدَّيْلَمِيِّ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ خَلَقَ خَلْقَهُ فِي ظُلْمَةٍ  ، وَأَلْقَى عَلَيْهِمْ مِنْ نُورِهِ ، فَمَنْ أَصَابَ مِنْ ذَلِكَ النُّورِ اهْتَدَى ، وَمَنْ أَخْطَأَهُ ضَلَّ "" ، فَلِذَلِكَ أَقُولُ : جَفَّ الْقَلَمُ عَلَى عِلْمِ اللهِ  .","","Al-Mu'jam al-Kabir 14556","","عبد الله بن عمرو بن العاص عن عبد الله بن فيروز عن يحيى بن أبي عمرو السيباني عن إسماعيل بن عياش الأحول عن سليمان بن داود العتكي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","سفيان بن عوف عن عبد الله"
"14596","[13/633]      14557  -  حَدَّثَنَا  ابْنُ أَبِي مَرْيَمَ ،  ثَنَا  الْفِرْيَابِيُّ ،  ثَنَا  الْأَوْزَاعِيُّ .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  رَبِيعَةَ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ الدَّيْلَمِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ خَلَقَ خَلْقَهُ فِي ظُلْمَةٍ  ، ثُمَّ أَلْقَى عَلَيْهِمْ مِنْ نُورِهِ ، فَمَنْ أَصَابَهُ مِنْ ذَلِكَ النُّورِ اهْتَدَى ، وَمَنْ أَخْطَأَهُ ضَلَّ "" ، فَلِذَلِكَ أَقُولُ : جَفَّ الْقَلَمُ عَلَى عِلْمِ اللهِ  .","","Al-Mu'jam al-Kabir 14557","","عبد الله بن عمرو بن العاص عن عبد الله بن فيروز عن ربيعة بن يزيد القصير عن أبو عمرو الأوزاعي عن عبد الله بن المبارك عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14597","[13/634]      14558  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ وَأَحْمَدُ بْنُ عَلِيٍّ الْأَبَّارُ ، قَالَا :  ثَنَا  إِبْرَاهِيمُ بْنُ الْعَلَاءِ الْحِمْصِيُّ .  وَحَدَّثَنَا  عَمْرُو بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ الْعَلَاءِ ،  ثَنَا  جَدِّي  ،  ثَنَا  ثَوَابَةُ بْنُ عَوْنٍ أَبُو عَوْنٍ التُّنُوخِيُّ ، قَالَ :  سَمِعْتُ  عَمْرَو بْنَ قَيْسٍ الْكِنْدِيَّ يَقُولُ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ رَآنِي فِي الْمَنَامِ فَكَأَنَّمَا رَآنِي فِي الْيَقَظَةِ  ، وَمَنْ رَآنِي فَقَدْ رَأَى  الْحَقَّ ;  فَإِنَّ الشَّيْطَانَ لَا يَتَمَثَّلُ بِي  .","","Al-Mu'jam al-Kabir 14558","","عبد الله بن عمرو بن العاص عن عمرو بن قيس بن ثور السكوني عن ثوابة بن عون التنوخي عن إبراهيم بن العلاء زبريق عن أحمد بن علي بن مسلم النخشبي عن الطبراني","سفيان بن عوف عن عبد الله"
"14598","[13/635]      14559  -  حَدَّثَنَا  مُحَمَّدُ بْنُ السَّرِيِّ بْنِ مِهْرَانَ النَّاقِدُ ،  ثَنَا  الْحَكَمُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ الْكِنْدِيِّ قَالَ :  كُنْتُ مَعَ أَبِي بِـ ""  حُوَّارَيْنِ  "" وَأَنَا غُلَامٌ حَدَثٌ شَابٌّ ، فَرَأَيْتُ النَّاسَ مُجْتَمِعِينَ عَلَى رَجُلٍ ، فَقُلْتُ : مَنْ هَذَا ؟ قَالُوا : عَبْدُ اللهِ بْنُ عَمْرٍو ، فَسَمِعْتُهُ  يُحَدِّثُ عَنْ  رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ :  مِنَ اقْتِرَابِ السَّاعَةِ : أَنْ         [13/636]      يُرْفَعَ الْأَشْرَارُ  ، وَيُوضَعَ الْأَخْيَارُ ، وَيُفْتَحَ الْقَوْلُ ، وَيُحْبَسَ الْعَمَلُ ، وَيُقْرَأَ فِي  الْقَوْمِ  الْمَثْنَاةُ "" ، قِيلَ : وَمَا الْمَثْنَاةُ ؟ قَالَ : "" مَا كُتِبَ سِوَى كِتَابِ اللهِ  .","","Al-Mu'jam al-Kabir 14559","","عبد الله بن عمرو بن العاص عن عمرو بن قيس بن ثور السكوني عن يحيى بن حمزة بن البتلهي عن الحكم بن موسى بن أبي زهير النسائي عن محمد بن السري بن مهران الناقد عن الطبراني","سفيان بن عوف عن عبد الله"
"14599","14560  -  حَدَّثَنَا  مُوسَى بْنُ سَهْلٍ أَبُو عِمْرَانَ الْجَوْنِيُّ وَعَبْدَانُ بْنُ أَحْمَدَ قَالَا :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  ثَنَا  شُرَحْبِيلُ بْنُ مُسْلِمٍ ،  عَنْ  [ شُفْعَةَ ] ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  رَأَى         [13/637]      عَلَيَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَوْبًا مَصْبُوغًا ، فَقَالَ : "" مَا هَذَا ؟ "" ، فَانْطَلَقْتُ فَأَحْرَقْتُهُ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا صَنَعْتَ بِثَوْبِكَ ؟ "" قُلْتُ : أَحْرَقْتُهُ ، قَالَ : "" أَلَا كَسَوْتَهُ بَعْضَ نِسَائِكَ ؟ !  .","","Al-Mu'jam al-Kabir 14560","","عبد الله بن عمرو بن العاص عن شفعة السمعي عن شرحبيل بن مسلم الخولاني عن إسماعيل بن عياش الأحول عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14600","14561  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ الدِّمَشْقِيُّ ،  ثَنَا  يَحْيَى بْنُ صَالِحٍ الْوُحَاظِيُّ ،  ثَنَا  سَعِيدُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  يُونُسَ بْنِ مَيْسَرَةَ بْنِ حَلْبَسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  رَأَيْتُ عَمُودَ الْكِتَابِ انْتُزِعَ مِنْ تَحْتِ وِسَادَتِي  ، فَأَتْبَعْتُهُ بَصَرِي فَإِذَا هُوَ نُورٌ  سَاطِعٌ  إِلَى  الشَّامِ  .","","Al-Mu'jam al-Kabir 14561","","عبد الله بن عمرو بن العاص عن يونس بن ميسرة بن حلبس الجبلاني عن سعيد بن عبد العزيز التنوخي عن يحيى بن صالح الوحاظي عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","سفيان بن عوف عن عبد الله"
"14601","[13/638]      14562  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ ،  ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  الْمُهَنَّدُ بْنُ خَالِدٍ التَّمِيمِيُّ ،  عَنِ  الْعَلَاءِ بْنِ عَبْدِ اللهِ بْنِ رَافِعٍ الْحَضْرَمِيِّ ،  عَنِ  الْحَنَانِ بْنِ خَارِجَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ  رَجُلًا  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْهِجْرَةِ ؟ فَقَالَ :  إِذَا أَقَمْتَ الصَّلَاةَ وَآتَيْتَ الزَّكَاةَ وَهَجَرْتَ الْفَوَاحِشَ مَا ظَهَرَ مِنْهَا وَمَا بَطَنَ ، فَأَنْتَ مُهَاجِرٌ وَإِنْ مُتَّ بِالْحَضَرِ  ، ثُمَّ جَاءَ  رَجُلٌ  ، فَقَالَ : يَا رَسُولَ اللهِ ، أَخْبِرْنَا عَنْ ثِيَابِ أَهْلِ الْجَنَّةِ أَتُخْلَقُ خَلْقًا أَمْ تُنْسَجُ نَسْجًا ؟ قَالَ : "" بَلْ تَشَقَّقُ عَنْهَا ثِمَارُ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 14562","","عبد الله بن عمرو بن العاص عن حنان بن خارجة الذكواني عن العلاء بن عبد الله بن رافع الحضرمي عن المهند بن خالد التميمي عن عمرو بن خالد بن فروخ عن أحمد بن محمد بن الحجاج المصري عن الطبراني","سفيان بن عوف عن عبد الله"
"14602","[13/639]      14563  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَرَمِيُّ بْنُ حَفْصٍ الْقَسْمَلِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُلَاثَةَ ،  ثَنَا  الْعَلَاءُ بْنُ عَبْدِ اللهِ أَنَّ الْحَنَانَ بْنَ خَارِجَةَ  حَدَّثَهُ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  بَيْنَمَا نَحْنُ حَوْلَ نَبِيِّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذْ جَاءَ  رَجُلٌ  ، فَقَالَ :  يَا رَسُولَ اللهِ ، أَخْبِرْنَا عَنْ ثِيَابِ الْجَنَّةِ  ، أَخَلْقٌ يُخْلَقُ أَمْ نَسْجٌ يُنْسَجُ ؟ فَضَحِكَ بَعْضُ  الْقَوْمِ  ، فَقَالَ : "" مِمَّ تَضْحَكُونَ ؟ ! أَنَّ جَاهِلًا سَأَلَ عَالِمًا ؟! "" فَجَلَسَ يَسِيرًا ، ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَيْنَ السَّائِلُ عَنْ ثِيَابِ الْجَنَّةِ ؟! "" قَالَ : هَا هُوَ ذَا يَا رَسُولَ اللهِ ، قَالَ : "" لَا ، بَلْ يُشَقُّ عَنْهَا  ثَمَرُ  الْجَنَّةِ : "" قَالَهَا ثَلَاثًا .","","Al-Mu'jam al-Kabir 14563","","عبد الله بن عمرو بن العاص عن حنان بن خارجة الذكواني عن العلاء بن عبد الله بن رافع الحضرمي عن قاضي الجن محمد بن عبد الله بن علاثة عن حرمي بن حفص العتكي عن أبو مسلم الكجي عن الطبراني","سفيان بن عوف عن عبد الله"
"14603","14564  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرٍ الْقَطَّانُ الْهَمَذَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ مُهَاجِرٍ ،  عَنِ  الْعَبَّاسِ بْنِ سَالِمٍ ،  عَنْ  مُدْرِكِ بْنِ عَبْدِ اللهِ الْأَزْدِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ         [13/640]      عَمْرٍو ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ الْإِيمَانَ إِذَا وَقَعَتِ الْفِتَنُ  بِالشَّامِ  "" ثَلَاثًا  .","","Al-Mu'jam al-Kabir 14564","","عبد الله بن عمرو بن العاص عن مدرك بن عبد الله الأزدي عن عباس بن سالم بن جميل اللخمي عن محمد بن مهاجر بن أبي مسلم عن عثمان بن عبد الرحمن الطرائفي عن محمد بن مصفى بن بهلول عن محمد بن نصر مموس الهمداني عن الطبراني","سفيان بن عوف عن عبد الله"
"14604","14565  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ سَلَمَةَ الْخَبَائِرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حَرْبٍ الْأَبْرَشُ ،  ثَنَا  الزُّبَيْدِيُّ ،  عَنْ  خَالِدِ بْنِ مُحَمَّدٍ الثَّقَفِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَلَمَةَ الْجُمَحِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَدْ أَفْلَحَ مَنْ أَسْلَمَ وَكَانَ رِزْقُهُ كَفَافًا  .","","Al-Mu'jam al-Kabir 14565","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن سلمة الجمحي عن خالد بن محمد الثقفي عن محمد بن الوليد بن عامر الزبيدي عن محمد بن حرب الأبرش عن سليمان بن سلمة الخبائري عن أحمد بن النضر بن بحر العسكري عن الطبراني","سفيان بن عوف عن عبد الله"
"14605","14566  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  سَعِيدُ بْنُ عَبْدِ الْعَزِيزِ قَالَ :  قَالَ  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ الْجُمَحِيُّ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ :  حَدَّثَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَدِيثًا وَكَتَبْتُهُ ، فَلَمَّا حَفِظْتُهُ مَحَوْتُهُ ، قَالَ :  قَدْ أَفْلَحَ مَنْ أَسْلَمَ وَكَانَ رِزْقُهُ كَفَافًا وَصَبَرَ عَلَى ذَلِكَ  .","","Al-Mu'jam al-Kabir 14566","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن سلمة الجمحي عن سعيد بن عبد العزيز التنوخي عن الوليد بن مسلم القرشي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14606","[13/641]      14567  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي .  وَحَدَّثَنَا  سَلَامَةُ بْنُ نَاهِضٍ الْمَقْدِسِيُّ وَوَرْدُ بْنُ أَحْمَدَ بْنِ لَبِيدٍ الْبَيْرُوتِيُّ ، قَالَا :  ثَنَا  صَفْوَانُ بْنُ صَالِحٍ ،  ثَنَا  مُحَمَّدُ بْنُ شُعَيْبِ [ بْنِ شَابُورَ ،  حَدَّثَنِي  عُمَرُ بْنُ يَزِيدَ النَّصْرِيُّ ،  ثَنَا  عَمْرُو بْنُ مُهَاجِرٍ ،  حَدَّثَنِي  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  يَحْيَى بْنِ الْقَاسِمِ بْنِ عَبْدِ اللهِ بْنِ عَمْرٍو ] ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا هَلَكَتْ أُمَّةٌ قَطُّ إِلَّا بِالْأَنْوَاءِ  ، وَمَا كَانَ بَدْءُ إِشْرَاكِهَا إِلَّا التَّكْذِيبَ بِالْقَدَرِ  .","","Al-Mu'jam al-Kabir 14567","","عبد الله بن عمرو بن العاص عن القاسم بن عبد الله بن عمرو عن يحيى بن القاسم بن عبد الله عن عمر بن عبد العزيز بن مروان عن عمرو بن المهاجر عن عمر بن يزيد النصري عن محمد بن شعيب بن شابور القرشي عن صفوان بن صالح الدمشقي عن محمد بن أحمد بن لبيد عن سلام بن محمد بن ناهض الترياقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14607","[13/642]      14568  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ الْجَوْهَرِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  يَمَانُ بْنُ الْمُغِيرَةِ ،  حَدَّثَنِي  عَطَاءُ بْنُ أَبِي رَبَاحٍ ،  عَنْ  عَمْرِو بْنِ عَبْدِ اللهِ بْنِ عَمْرٍو ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ  شَرِبَ  الْخَمْرَ فَاجْلِدُوهُ  ، قَالَهَا ثَلَاثًا ، "" فَإِنْ عَادَ الرَّابِعَةَ فَاقْتُلُوهُ  .","","Al-Mu'jam al-Kabir 14568","","عبد الله بن عمرو بن العاص عن عمرو بن عبد الله بن عمرو عن عطاء بن أبي رباح عن يمان بن المغيرة العنبري عن سعيد بن سليمان سعدويه عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","سفيان بن عوف عن عبد الله"
"14608","14569  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدُوَيْهِ الصَّفَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ حَسَّانَ الضَّبِّيُّ ،  ثَنَا  نُوحُ بْنُ دَرَّاجٍ ،  ثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ         [13/643]      بْنِ عَمْرِو بْنِ الْعَاصِ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَمْ يَزَلْ أَمْرُ  بَنِي إِسْرَائِيلَ  مُقَارِبًا ، أَوْ قَالَ :  مُؤَامًّا  ، حَتَّى نَشَأَ فِيهِمُ  الْمُوَلَّدُونَ  - أَبْنَاءُ سَبَايَا الْأُمَمِ الَّتِي كَانَتْ  بَنُو إِسْرَائِيلَ  تَسْبِيهَا - ، فَقَالُوا بِرَأْيِهِمْ فَضَلُّوا وَأَضَلُّوا  .","","Al-Mu'jam al-Kabir 14569","","عبد الله بن عمرو بن العاص عن محمد بن عبد الله بن عمرو بن العاص عن هشام بن عروة بن الزبير عن نوح بن دراج الطائي عن محمد بن حسان بن خالد السمتي عن سعيد بن عبدويه البغدادي عن الطبراني","سفيان بن عوف عن عبد الله"
"14609","14570  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ .  وَحَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدِ بْنِ حَرْبٍ الْعَبَّادَانِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،         [13/644]      قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ ،  عَنْ  شُعَيْبِ بْنِ عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو  يَقُولُ :  مَا رُئِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَأْكُلُ مُتَّكِئًا ، وَلَا يَطَأُ عَقِبُهُ رَجُلَيْنِ  .","","Al-Mu'jam al-Kabir 14570","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن ثابت البناني عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14610","[13/645]      14571  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَبَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ ،  عَنْ  شُعَيْبِ بْنِ عَبْدِ اللهِ بْنِ عَمْرٍو ،  عَنْ  أَبِيهِ  قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صُمْ يَوْمًا وَلَكَ عَشَرَةٌ  ، قُلْتُ : زِدْنِي ، قَالَ : "" صُمْ يَوْمَيْنِ وَلَكَ تِسْعَةٌ "" ، قُلْتُ : زِدْنِي ، قَالَ : "" صُمْ ثَلَاثَةَ أَيَّامٍ وَلَكَ ثَمَانِيَةٌ  ، قَالَ  ثَابِتٌ  : فَذَكَرْتُ ذَلِكَ  لِمُطَرِّفٍ  ، فَقَالَ :  مَا أُرَاهُ إِلَّا زَادَ فِي الْعَمَلِ وَنَقَصَ مِنَ الْأَجْرِ  .","","Al-Mu'jam al-Kabir 14571","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن ثابت البناني عن حماد بن سلمة عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","سفيان بن عوف عن عبد الله"
"14611","14572  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرِ بْنِ نُفَيْرٍ ،  عَنْ  أَبِيهِ جُبَيْرِ بْنِ نُفَيْرٍ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  بَيْنَا أَنَا قَاعِدٌ فِي الْمَسْجِدِ فِي حَلْقَةٍ         [13/646]      مِنْ فُقَرَاءِ  الْمُهَاجِرِينَ  إِذْ دَخَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَعَدَ مَعَهُمْ ، فَقُمْتُ إِلَيْهِمْ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِيُبْشِرْ فُقَرَاءُ  الْمُهَاجِرِينَ  بِمَا يَسُرُّ وُجُوهَهُمْ  ; فَإِنَّهُمْ يَدْخُلُونَ الْجَنَّةَ قَبْلَ الْأَغْنِيَاءِ بِأَرْبَعِينَ  خَرِيفًا  "" . فَلَقَدْ رَأَيْتُ أَلْوَانَهُمْ أَسْفَرَتْ حَتَّى تَمَنَّيْتُ أَنْ أَكُونَ مِنْهُمْ  .","","Al-Mu'jam al-Kabir 14572","","عبد الله بن عمرو بن العاص عن جبير بن نفير بن مالك الحضرمي عن عبد الرحمن بن جبير الحضرمي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14612","14573  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  ثَنَا  الْمُقْرِئُ ،  ثَنَا  حَيْوَةُ بْنُ         [13/647]      شُرَيْحٍ ،  حَدَّثَنِي  كَعْبُ بْنُ عَلْقَمَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرِ بْنِ نُفَيْرٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَلُوا لِيَ  الْوَسِيلَةَ  ، فَإِنَّهَا مَنْزِلٌ فِي الْجَنَّةِ لَا يَنْبَغِي إِلَّا لِعَبْدٍ مِنْ عِبَادِ اللهِ  ، وَأَرْجُو أَنْ أَكُونَ هُوَ ، وَمَنْ سَأَلَ لِيَ  الْوَسِيلَةَ  حَلَّتْ عَلَيْهِ الشَّفَاعَةُ  .","","Al-Mu'jam al-Kabir 14573","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن جبير الحضرمي عن كعب بن علقمة بن كعب عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","سفيان بن عوف عن عبد الله"
"14613","14574  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ .         [13/648]      قَالَ  إِسْحَاقُ :  وَأَخْبَرَنَا  وَكِيعٌ ،  عَنْ  عَلِيِّ بْنِ الْمُبَارَكِ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنْ  جُبَيْرِ بْنِ نُفَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  رَأَى عَلَيَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَوْبَيْنِ مُعَصْفَرَيْنِ ، فَقَالَ :  أَلْقِهِمَا فَإِنَّهُمَا مِنْ ثِيَابِ أَهْلِ النَّارِ "" ، فَطَرَحْتُهُمَا .","","Al-Mu'jam al-Kabir 14574","","عبد الله بن عمرو بن العاص عن جبير بن نفير بن مالك الحضرمي عن خالد بن معدان عن محمد بن إبراهيم بن الحارث التيمي عن يحيى بن أبي كثير عن علي بن المبارك الهنائي عن وكيع بن الجراح عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14614","[13/649]      14575  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  عِيسَى بْنُ يُونُسَ وَيَحْيَى بْنُ أَبِي الْحَجَّاجِ التَّمِيمِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ رَافِعٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ عُبَيْدِ اللهِ بْنِ الْمُهَاجِرِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ قَرَأَ الْقُرْآنَ فَكَأَنَّمَا اسْتُدْرِجَتِ النُّبُوَّةُ بَيْنَ جَنْبَيْهِ  ، غَيْرَ أَنَّهُ لَا يُوحَى إِلَيْهِ ، وَمَنْ قَرَأَ الْقُرْآنَ فَرَأَى أَنَّ أَحَدًا أُعْطِيَ         [13/650]      أَفْضَلَ مِمَّا أُعْطِيَ ، فَقَدْ عَظَّمَ مَا صَغَّرَ اللهُ وَصَغَّرَ مَا عَظَّمَ اللهُ ، وَلَيْسَ يَنْبَغِي لِحَامِلِ الْقُرْآنِ أَنْ يَسْفَهَ فِيمَنْ يَسْفَهُ ، أَوْ يَغْضَبَ فِيمَنْ يَغْضَبُ ، أَوْ يَحْتَدَّ فِيمَنْ يَحْتَدُّ ، وَلَكِنْ يَعْفُو وَيَصْفَحُ لِفَضْلِ الْقُرْآنِ  .","","Al-Mu'jam al-Kabir 14575","","عبد الله بن عمرو بن العاص عن إسماعيل ابن أبي المهاجر عن إسماعيل بن رافع بن عويمر المزني عن يحيى بن أبي الحجاج الأهتمي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14615","14576  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عُمَرُ بْنُ عَبْدِ الْوَاحِدِ الدِّمَشْقِيُّ ،  عَنِ  النُّعْمَانِ بْنِ الْمُنْذِرِ ،  عَنْ  مَكْحُولٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ مَنَعَ  فَضْلَ  مَاءٍ أَوْ  كَلَأٍ  مَنَعَهُ اللهُ فَضْلَهُ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 14576","","عبد الله بن عمرو بن العاص عن مكحول بن أبي مسلم عن النعمان بن المنذر الغساني عن عمر بن عبد الواحد الأفطس عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14616","14577  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْجَمَّالُ الْأَصْبَهَانِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عُمَرَ رُسْتَهْ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  ثَنَا  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  مُهَاصِرِ بْنِ حَبِيبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  تَعَوَّذُوا مِنْ شَرِّ الْأَرْبَعِ  : مِنْ عِلْمٍ لَا يَنْفَعُ ، وَقَلْبٍ لَا يَخْشَعُ ، وَنَفْسٍ لَا تَشْبَعُ ، وَمِنْ دُعَاءٍ لَا  يُسْمَعُ  "" .  وَقَالَ : "" مَنْ صَلَّى عَلَيَّ صَلَّى اللهُ عَلَيْهِ عَشْرًا "" .","","Al-Mu'jam al-Kabir 14577","","عبد الله بن عمرو بن العاص عن المهاصر بن حبيب الزبيدي عن معاوية بن صالح بن حدير الحضرمي عن عبد الرحمن بن مهدي عن رستة عبد الرحمن بن عمر الأزرق عن أحمد بن محمد بن عبد الله الجمال عن الطبراني","سفيان بن عوف عن عبد الله"
"14617","14578  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّصْرِ الْقَطَّانُ الْهَمَذَانِيُّ ،  ثَنَا  مُحَمَّدُ         [13/651]      بْنُ مُصَفَّى ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ مُهَاجِرٍ ،  عَنِ  الْعَبَّاسِ بْنِ سَالِمٍ ،  عَنْ  مُدْرِكِ بْنِ عَبْدِ اللهِ الْأَزْدِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْإِيمَانُ إِذَا وَقَعَتِ الْفِتَنُ  بِالشَّامِ  "" . ثَلَاثًا  .","","Al-Mu'jam al-Kabir 14578","","عبد الله بن عمرو بن العاص عن مدرك بن عبد الله الأزدي عن عباس بن سالم بن جميل اللخمي عن محمد بن مهاجر بن أبي مسلم عن عثمان بن عبد الرحمن عن محمد بن مصفى بن بهلول عن محمد بن نصر مموس الهمداني عن الطبراني","سفيان بن عوف عن عبد الله"
"14618","14579  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحَسَنُ بْنُ مُوسَى الْأَشْيَبُ ،  عَنْ  حَرِيزِ بْنِ عُثْمَانَ ،  عَنْ  حَيَّانَ بْنِ زَيْدٍ الشَّرْعَبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ         [13/652]      عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ارْحَمُوا تُرْحَمُوا  ، وَيْلٌ  لِأَقْمَاعِ  الْقَوْلِ ! وَيْلٌ لِلَّذِينَ يُصِرُّونَ عَلَى مَا فَعَلُوا وَهُمْ يَعْلَمُونَ  ! "" .","","Al-Mu'jam al-Kabir 14579","","عبد الله بن عمرو بن العاص عن حبان بن زيد الشرعبي عن حريز بن عثمان الرحبي عن الحسن بن موسى الأشيب عن بشر بن موسى بن صالح الأسدي عن الطبراني","سفيان بن عوف عن عبد الله"
"14619","14580  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْعَلَاءُ بْنُ عَبْدِ الْجَبَّارِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  مُسْلِمِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  عَمْرِو بْنِ حَرِيشٍ ،  عَنْ         [13/653]      عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  أَمَرَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ  أُجَهِّزَ  جَيْشًا ، فَنَفِدَتِ الْإِبِلُ ، فَقُلْتُ :  يَا رَسُولَ اللهِ نَفِدَتِ الْإِبِلُ ، فَقَالَ : "" أَخَذَ فِي         [13/654]      قِلَاصِ  الصَّدَقَةِ  .  فَأَخَذْتُ الْبَعِيرَ بِالْبَعِيرَيْنِ إِلَى إِبِلِ الصَّدَقَةِ  .","","Al-Mu'jam al-Kabir 14580","","عبد الله بن عمرو بن العاص عن عمرو بن حريش الزبيدي عن أبو سفيان عن مسلم بن جبير الحرشي عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن حماد بن سلمة عن العلاء بن عبد الجبار الأنصاري عن بشر بن موسى بن صالح الأسدي عن الطبراني","سفيان بن عوف عن عبد الله"
"14620","14581  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ وَمُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  ثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ،         [13/655]      قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  حَجَّةٌ لِمَنْ لَمْ يَحُجَّ خَيْرٌ مِنْ عَشْرِ غَزَوَاتٍ  ، وَغَزْوَةٌ لِمَنْ قَدْ حَجَّ خَيْرٌ مِنْ عَشْرِ حِجَجٍ ، وَغَزْوَةٌ فِي الْبَحْرِ خَيْرٌ مِنْ عَشْرِ غَزَوَاتٍ فِي الْبَرِّ ، وَمَنْ أَجَازَ الْبَحْرَ فَكَأَنَّمَا أَجَازَ الْأَوْدِيَةَ كُلَّهَا ،  وَالْمَائِدُ  فِيهِ كَالْمُتَشَحِّطِ فِي دَمِهِ  .","","Al-Mu'jam al-Kabir 14581","","عبد الله بن عمرو بن العاص عن عطاء بن يسار الهلالي عن يحيى بن سعيد الأنصاري عن يحيى بن أيوب الغافقي عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","سفيان بن عوف عن عبد الله"
"14621","14582  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبُو مُوسَى الْهَرَوِيُّ ،  ثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَنْصَارِيُّ ،  ثَنَا  هَمَّامٌ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُسْلِمِ بْنِ إِبْرَاهِيمَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ آذَى  أَهْلَ الْمَدِينَةِ  آذَاهُ اللهُ  ، وَعَلَيْهِ لَعْنَةُ اللهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ ، لَا يُقْبَلُ مِنْهُ  صَرْفٌ  وَلَا عَدْلٌ  .","","Al-Mu'jam al-Kabir 14582","","عبد الله بن عمرو بن العاص عن عطاء بن يسار الهلالي عن مسلم بن أبي مريم الأنصاري عن يحيى بن سعيد الأنصاري عن همام بن يحيى بن دينار عن عباس بن الفضل الواقفي عن إسحاق بن إبراهيم الهروي عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14622","[13/656]      14583  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ الْجُنْدَيْسَابُورِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مِهْرَانَ الْجَمَّالُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ أَبِي سَلَمَةَ الْمَاجِشُونِ ،  عَنْ  هِلَالِ بْنِ أَبِي هِلَالٍ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ         [13/657]      عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  إِنَّ هَذِهِ الْآيَةَ الَّتِي فِي الْقُرْآنِ         {      يَا أَيُّهَا النَّبِيُّ إِنَّا أَرْسَلْنَاكَ شَاهِدًا وَمُبَشِّرًا وَنَذِيرًا         }      هِيَ فِي التَّوْرَاةِ  : أَيُّهَا النَّبِيُّ إِنَّا أَرْسَلْنَاكَ شَاهِدًا وَمُبَشِّرًا وَنَذِيرًا  وَحِرْزًا  لِلْأُمِّيِّينَ ، أَنْتَ عَبْدِي وَرَسُولِي ، سَمَّيْتُكَ الْمُتَوَكِّلَ ، لَسْتَ  بِفَظٍّ  وَلَا غَلِيظٍ ، وَلَا صَخَّابٍ فِي الْأَسْوَاقِ ، وَلَا تَدْفَعُ السَّيِّئَةَ بِالسَّيِّئَةِ ، وَلَكِنْ تَعْفُو وَتَصْفَحُ ، وَلَنْ أَتَوَفَّاكَ حَتَّى أُقِيمَ بِكَ الْمِلَّةَ  الْعَوْجَاءَ  ، فَأَفْتَحَ بِكَ أَعْيُنًا عُمْيًا وَآذَانًا صُمًّا وَقُلُوبًا  غُلْفًا  ; لِأَنْ يَقُولُوا : لَا إِلَهَ إِلَّا اللهُ .         [13/658]      وَإِنَّ هَذِهِ الْآيَةَ فِي الْقُرْآنِ :         {      يَا أَيُّهَا الَّذِينَ آمَنُوا إِنَّمَا الْخَمْرُ وَالْمَيْسِرُ وَالأَنْصَابُ وَالأَزْلامُ رِجْسٌ مِنْ عَمَلِ الشَّيْطَانِ فَاجْتَنِبُوهُ لَعَلَّكُمْ تُفْلِحُونَ         }      ، قَالَ : هِيَ فِي التَّوْرَاةِ : إِنَّ اللهَ عَزَّ وَجَلَّ أَنْزَلَ الْحَقَّ لِيُذْهِبَ بِهِ الْبَاطِلَ وَيُبْطِلَ بِهِ اللَّعِبَ وَالْكِبَارَاتِ ، وَالزَّمْرَ وَالْمَعَازِفَ  وَالْمَزَاهِرَ ،  وَالشِّعْرَ وَالْخَمْرَ ، وَأَقْسَمَ رَبِّي بِيَمِينٍ : لَا يَشْرَبُهَا عَبْدٌ بَعْدَمَا حَرَّمْتُهَا إِلَّا أَعْطَشْتُهُ يَوْمَ الْقِيَامَةِ ، وَلَا يَدَعُهَا بَعْدَمَا حَرَّمْتُهَا إِلَّا سَقَيْتُهُ مِنْ حَظِيرَةِ الْقُدُسِ .","","Al-Mu'jam al-Kabir 14583","","عبد الله بن عمرو بن العاص عن عطاء بن يسار الهلالي عن هلال بن علي بن أسامة عن عبد العزيز بن عبد الله الماجشون عن يزيد بن هارون عن محمد بن مهران الجمال عن محمد بن جابان الجند يسابوري عن الطبراني","سفيان بن عوف عن عبد الله"
"14623","14584  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ صَدَقَةَ الْبَغْدَاذِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ خَالِدٍ الْمِصِّيصِيُّ ،  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  ثَنَا  أَبُو         [13/659]      غَسَّانَ مُحَمَّدُ بْنُ مُطَرِّفٍ ،  عَنْ  صَفْوَانَ بْنِ سُلَيْمٍ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الْمَلَائِكَةَ قَالَتْ :  يَا رَبَّنَا أَعْطَيْتَ بَنِي آدَمَ الدُّنْيَا يَأْكُلُونَ فِيهَا وَيَشْرَبُونَ وَيَلْبَسُونَ  ، وَنَحْنُ نُسَبِّحُ بِحَمْدِكَ وَلَا نَأْكُلُ وَلَا نَشْرَبُ وَلَا نَلْهُو ، وَكَمَا جَعَلْتَ لَهُمُ الدُّنْيَا فَاجْعَلْ لَنَا الْآخِرَةَ . قَالَ : لَا أَجْعَلُ صَالِحَ  ذُرِّيَّةِ  مَنْ خَلَقْتُ بِيَدَيَّ كَمَنْ قُلْتُ لَهُ : كُنْ فَكَانَ  .","","Al-Mu'jam al-Kabir 14584","","عبد الله بن عمرو بن العاص عن عطاء بن يسار الهلالي عن صفوان بن سليم القرشي عن محمد بن مطرف بن داود عن حجاج بن محمد الأعور عن إبراهيم بن عبد الله بن خالد المصيصي عن أحمد بن محمد بن عبد الله البغدادي عن الطبراني","سفيان بن عوف عن عبد الله"
"14624","[13/660]      بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ  14585  -  حَدَّثَنَا  أَبُو زُرْعَةَ الدِّمَشْقِيُّ ، قَالَ :  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،         [13/661]      ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنِ  الصَّقْعَبِ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  كُنَّا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَاءَهُ  رَجُلٌ  مِنْ أَهْلِ الْبَادِيَةِ عَلَيْهِ جُبَّةُ  سِيجَانٍ  مَزْرُورَةٍ  بِالدِّيبَاجِ  ، فَقَالَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُرِيدُ أَنْ يَرْفَعَ كُلَّ رَاعِ بْنِ رَاعٍ ، وَيَضَعَ كُلَّ فَارِسِ بْنِ فَارِسٍ ، فَأَخَذَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِمَجَامِعِ جُبَّتِهِ ، وَقَالَ : أَلَا أَرَى عَلَيْهِ لِبَاسَ مَنْ لَا يَعْقِلُ ، ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ نَبِيَّ اللهِ  نُوحًا  لَمَّا حَضَرَتْهُ الْوَفَاةُ ، قَالَ لِابْنِهِ : يَا بُنَيَّ إِنِّي مُوصِيكَ ، فَقَاصِرٌ عَلَيْكَ الْوَصِيَّةَ  ، آمُرُكَ بِاثْنَتَيْنِ وَأَنْهَاكَ عَنِ اثْنَتَيْنِ : آمُرُكَ بِـ ""لَا إِلَهَ إِلَّا اللهُ"" ، فَلَوْ أَنَّ السَّمَاوَاتِ السَّبْعَ وَالْأَرَضِينَ السَّبْعَ وُضِعْنَ فِي كِفَّةٍ وَلَا إِلَهَ إِلَّا اللهُ فِي كِفَّةٍ لَرَجَحَتْ بِهِنَّ ، وَلَوْ أَنَّ السَّمَاوَاتِ السَّبْعَ وَالْأَرَضِينَ السَّبْعَ كَانَتْ حَلْقَةً مُبْهَمَةً ، قَصَمَتْهُنَّ لَا إِلَهَ إِلَّا اللهُ ، وَأُوصِيكَ بِـ "" سُبْحَانَ اللهِ وَبِحَمْدِهِ "" ، فَإِنَّهَا صَلَاةُ الْخَلْقِ ، وَبِهَا يُرْزَقُ         [13/662]      الْخَلْقُ ، وَأَنْهَاكَ عَنِ الْكُفْرِ وَالْكِبْرِ ، فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، الْكُفْرُ قَدْ عَرَفْنَاهُ ، فَمَا الْكِبْرُ ؟ أَهُوَ أَنْ يَكُونَ لِلرَّجُلِ نَعْلَانِ حَسَنَتَانِ ، وَلَهُ شِرَاكَانِ حَسَنَانِ ; يُعْجِبُهُ ذَلِكَ ؟ قَالَ : لَا ، قَالَ : فَهُوَ أَنْ تَكُونَ لَهُ  حُلَّةٌ  حَسَنَةٌ يَلْبَسُهَا ؟ قَالَ : لَا ، قَالَ : فَهُوَ أَنْ يَكُونَ لَهُ فَرَسٌ جَمِيلٌ يُعْجِبُهُ جَمَالُهُ ؟ قَالَ : لَا ، قَالَ : فَهُوَ أَنْ يَكُونَ لِأَحَدِنَا أَصْحَابٌ يُجَالِسُونَهُ ؟ قَالَ : لَا ، قَالَ : فَمَا الْكِبْرُ ؟ قَالَ : أَنْ  تُسَفِّهَ  الْحَقَّ ، وَتُغْمِضَ النَّاسَ  .","","Al-Mu'jam al-Kabir 14585","","عبد الله بن عمرو بن العاص عن عطاء بن يسار الهلالي عن زيد بن أسلم عن الصقعب بن زهير الأزدي عن حماد بن زيد عن سليمان بن حرب الواشحي عن أبو زرعة الدمشقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14625","[14/5]      رَيْحَانُ بْنُ يَزِيدَ  14586  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  أَبُو نُعَيْمٍ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  رَيْحَانَ بْنِ يَزِيدَ الْعَامِرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَحِلُّ الصَّدَقَةُ لِغَنِيٍّ ، وَلَا لِذِي  مِرَّةٍ  قَوِيٍّ  .","","Al-Mu'jam al-Kabir 14586","","عبد الله بن عمرو بن العاص عن ريحان بن يزيد العامري عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","ريحان بن يزيد"
"14626","[14/6]      الْمُطَّلِبُ بْنُ عَبْدِ اللهِ بْنِ حَنْطَبٍ  14587  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ، قَالَ :  ثَنَا  أَبُو مُصْعَبٍ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  ثَنَا  يَحْيَى الْحِمَّانِيُّ (  ح  ) .  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ، قَالَ :  ثَنَا  أَبُو ثَابِتٍ مُحَمَّدُ بْنُ عُبَيْدِ اللهِ الْمَدِينِيُّ ، قَالَ :  أَخْبَرَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُسْلِمِ بْنِ الْوَلِيدِ بْنِ رَبَاحٍ ،  عَنِ  الْمُطَّلِبِ بْنِ عَبْدِ اللهِ بْنِ حَنْطَبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  صَعِدَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمِنْبَرَ ، فَقَالَ :  لَا أُقْسِمُ ، لَا أُقْسِمُ ،         [14/7]      لَا أُقْسِمُ ، ثُمَّ نَزَلَ ، فَقَالَ : أَبْشِرُوا ! أَبْشِرُوا !  إِنَّهُ مَنْ صَلَّى الصَّلَوَاتِ الْخَمْسَ ، وَاجْتَنَبَ الْكَبَائِرَ ، دَخَلَ مِنْ أَيِّ أَبْوَابِ الْجَنَّةِ شَاءَ .  قَالَ  الْمُطَّلِبُ  : سَمِعْتُ  رَجُلًا  يَسْأَلُ  عَبْدَ اللهِ بْنَ عَمْرٍو  : أَسَمِعْتَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَذْكُرُهُنَّ ؟ قَالَ : نَعَمْ :  عُقُوقُ  الْوَالِدَيْنِ ،  وَالشِّرْكُ  بِاللهِ ، وَقَتْلُ النَّفْسِ ، وَقَذْفُ الْمُحْصَنَاتِ ، وَأَكْلُ مَالِ الْيَتِيمِ ، وَالْفِرَارُ مِنَ  الزَّحْفِ  ، وَأَكْلُ الرِّبَا  .","","Al-Mu'jam al-Kabir 14587","","عبد الله بن عمرو بن العاص عن المطلب بن عبد الله بن حنطب المخزومي عن مسلم بن الوليد مولى آل أبى ذباب عن عبد العزيز بن محمد الدراوردي عن محمد بن عبيد الله بن محمد بن زيد الأموي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","المطلب بن عبد الله بن حنطب"
"14627","[14/8]      بَابٌ  14588  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  أَبُو نُعَيْمٍ ، قَالَ :  ثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  هِلَالِ بْنِ خَبَّابٍ أَبِي الْعَلَاءِ ، قَالَ :  حَدَّثَنِي  عِكْرِمَةُ ، قَالَ :  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عَمْرٍو ، قَالَ :  بَيْنَا نَحْنُ حَوْلَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  إِذْ ذَكَرَ الْفِتْنَةَ ، أَوْ ذُكِرَتْ عِنْدَهُ  ، فَقَالَ :  إِذَا رَأَيْتَ النَّاسَ  مَرِجَتْ  عُهُودُهُمْ ، وَخَفَّتْ أَمَانَاتُهُمْ فَكَانُوا هَكَذَا ،  وَشَبَّكَ  بَيْنَ أَصَابِعِهِ  ، قَالَ : فَقُمْتُ إِلَيْهِ ، فَقُلْتُ : كَيْفَ أَصْنَعُ عِنْدَ ذَلِكَ جَعَلَنِي اللهُ فِدَاءَكَ ؟ قَالَ : الْزَمْ بَيْتَكَ ، وَامْلِكْ عَلَيْكَ لِسَانَكَ ، وَخُذْ مَا تَعْرِفُ ، وَدَعْ مَا تُنْكِرُ ، وَعَلَيْكَ بِأَمْرِ الْخَاصَّةِ ، وَدَعْ أَمْرَ الْعَامَّةِ  .","","Al-Mu'jam al-Kabir 14588","","عبد الله بن عمرو بن العاص عن عكرمة مولى ابن عباس عن هلال بن خباب عن يونس بن أبي إسحاق عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","المطلب بن عبد الله بن حنطب"
"14628","[14/9]      عُمَارَةُ بْنُ عَمْرِو بْنِ حَزْمٍ  14589  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  يَعْقُوبُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  عُمَارَةَ بْنِ عَمْرِو بْنِ حَزْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كَيْفَ بِكُمْ فِي زَمَانٍ - أَوْ  يُوشِكُ  أَنْ يَأْتِيَ زَمَانٌ -  يُغَرْبَلُ النَّاسُ فِيهِ غَرْبَلَةً  ، وَتَبْقَى  حُثَالَةٌ  مِنَ النَّاسِ قَدْ  مَرِجَتْ  عُهُودُهُمْ وَأَمَانَاتُهُمْ ، وَاخْتَلَفُوا وَكَانُوا هَكَذَا ،  وَشَبَّكَ  بَيْنَ أَصَابِعِهِ ، فَقَالُوا : كَيْفَ بِنَا يَا رَسُولَ اللهِ ؟ قَالَ : تَأْخُذُونَ مَا تَعْرِفُونَ ، وَتَذَرُونَ مَا تُنْكِرُونَ ، وَتُقْبِلُونَ عَلَى أَمْرِ خَاصَّتِكُمْ ، وَتَدَعُونَ أَمْرَ عَامَّتِكُمْ  .","","Al-Mu'jam al-Kabir 14589","","عبد الله بن عمرو بن العاص عن عمارة بن عمرو بن حزم الأنصاري عن سلمة بن دينار الأعرج عن يعقوب بن عبد الرحمن الإسكندراني عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عمارة بن عمرو بن حزم"
"14629","[14/10]      عُمَرُ بْنُ الْحَكَمِ بْنِ ثَوْبَانَ  14590  -  حَدَّثَنَا  مُوسَى بْنُ جُمْهُورٍ السِّمْسَارُ التِّنِّيسِيُّ ، قَالَ :  ثَنَا  دُحَيْمٌ ، قَالَ :  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ، قَالَ :  حَدَّثَنِي  مُوسَى بْنُ يَعْقُوبَ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  عُمَرَ بْنِ الْحَكَمِ بْنِ ثَوْبَانَ ، أَنَّ عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ ،  أَخْبَرَهُ  : أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لَهُ :  كَيْفَ بِكُمْ إِذَا جَاءَ زَمَانٌ يُغَرْبَلُ فِيهِ النَّاسُ غَرْبَلَةً ، وَبَقِيتُمْ فِي  حُثَالَةٍ  مِنَ النَّاسِ قَدْ  مَرِجَتْ  عُهُودُهُمْ  ، وَضَيَّعُوا أَمَانَاتِهِمْ ، فَعَادُوا هَكَذَا ، وَأَدْخَلَ أَصَابِعَهُ بَعْضَهُمْ فِي بَعْضٍ .         [14/11]      فَقَالُوا : كَيْفَ نَصْنَعُ يَا رَسُولَ اللهِ ؟ قَالَ : تَأْخُذُونَ مَا تَعْرِفُونَ ، وَتَدَعُونَ مَا تُنْكِرُونَ ، وَعَلَيْكُمْ بِخَوَاصِّكُمْ ، وَدَعُوا عَوَامَّكُمْ  .","","Al-Mu'jam al-Kabir 14590","","عبد الله بن عمرو بن العاص عن عمر بن الحكم بن ثوبان الحجازي عن سلمة بن دينار الأعرج عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن محمد بن إسماعيل بن مسلم الديلي عن دحيم عن موسى بن جمهور بن زريق البغدادي عن الطبراني","عمر بن الحكم بن ثوبان"
"14630","14591  -  حَدَّثَنَا  ابْنُ رَاهَوَيْهِ ، قَالَ :  ثَنَا  أَبِي  قَالَ :  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عُمَارَةَ بْنِ عَمْرِو بْنِ حَزْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14591","","عبد الله بن عمرو بن العاص عن عمارة بن عمرو بن حزم الأنصاري عن سلمة بن دينار الأعرج عن عبد العزيز بن أبي حازم المخزومي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","عمر بن الحكم بن ثوبان"
"14631","[14/12]      عُقْبَةُ بْنُ أَوْسٍ  14592  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  عِيسَى بْنُ سَالِمٍ الشَّاشِيُّ ، قَالَ :  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  عُقْبَةَ بْنِ أَوْسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَيْفَ أَنْتَ إِذَا بَقِيتَ فِي  حُثَالَةٍ  مِنَ النَّاسِ قَدْ  مَرِجَتْ  عُهُودُهُمْ وَأَمَانَاتُهُمْ  ، وَاخْتِلَافُ أَعْنَاقِهِمْ ، وَصَارُوا هَكَذَا - وَخَالَفَ بَيْنَ أَصَابِعِهِ - فَقَالَ : كَيْفَ الْمَخْرَجُ يَا رَسُولَ اللهِ ؟ قَالَ : خُذْ بِمَا عَرَفْتَ ، وَدَعْ مَا أَنْكَرْتَ ، وَعَلَيْكَ بِخَاصَّةِ نَفْسِكَ ، وَإِيَّاكَ مِنْ عَوَامِّهِمْ  .","","Al-Mu'jam al-Kabir 14592","","عبد الله بن عمرو بن العاص عن عقبة بن أوس السدوسي عن محمد بن سيرين عن أيوب السختياني عن عبيد الله بن عمرو بن أبي الوليد عن عيسى بن سالم الشاشي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عقبة بن أوس"
"14632","[14/13]      الْحَسَنُ  14593  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَ :  ثَنَا  يَحْيَى بْنُ إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ أَبِي عُبَيْدَةَ بْنِ مَعْنٍ  ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَيْفَ أَنْتَ إِذَا كُنْتَ فِي  حُثَالَةٍ  مِنَ النَّاسِ ،  مَرِجَتْ  عُهُودُهُمْ وَأَمَانَاتُهُمْ ، فَاخْتَلَفُوا فَصَارُوا هَكَذَا ؟ ثُمَّ أَدْخَلَ أَصَابِعَهُ بَعْضَهَا فِي بَعْضٍ .  قُلْتُ : كَيْفَ لِي يَا رَسُولَ اللهِ ؟ قَالَ : تَأْخُذُ مَا تَعْرِفُ ، وَتَدَعُ مَا تُنْكِرُ ، وَعَلَيْكَ بِخَاصَّتِكَ ، وَإِيَّاكَ وَعَوَامَّهُمْ  .  كذا في طبعة الجريسي ، والذي في نسخة الوطنية : ( يحيى بن إبراهيم ، ثنا محمد بن أبي عبيدة ) وكذا أشار المحقق ، وقال : ""في الأصل ( ثنا ) بدل ( بن ) وهو مشكل؛ لأن أكثر رواية يحيى بن إبراهيم هي بهذا الإسناد : يحيى بن إبراهيم بن محمد بن أبي عبيدة بن معن ، ثنا أبي ، عن أبيه ، عن جده ، عن الأعمش . كما في رواية الطبراني في المعجم الكبير 4 / 208 رقم 4159 وغيره. وقد ذكر المزي في تهذيب الكمال 31 / 187 : أن يحيى بن إبراهيم هذا يروي عن أبيه إبراهيم وجده محمد بن أبي عبيدة ، ولكن ما وقفنا عليه من رواية يحيى بن إبراهيم عن جده جاء على الوجه التالي : يحيى بن إبراهيم بن محمد بن أبي عبيدة بن معن المسعودي ، حدثني أبي محمد بن أبي عبيدة ، عن أبيه ، عن الأعمش . كما تقدم عند المصنف 6 / 219 رقم 6058.""","","Al-Mu'jam al-Kabir 14593","","عبد الله بن عمرو بن العاص عن الحسن البصري عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن الأعمش عن عبد الملك بن معن المسعودي عن محمد بن أبي عبيدة المسعودي عن والد يحيى بن إبراهيم بن محمد المسعودي عن يحيى بن إبراهيم بن محمد المسعودي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","الحسن"
"14633","[14/14]      14594  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ، قَالَ :  ثَنَا  أَبِي ،  قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنِ  الرَّبِيعِ بْنِ صُبَيْحٍ ،  عَنِ  الْحَسَنِ ،  أَنَّ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لِعَبْدِ اللهِ بْنِ عَمْرٍو :  كَيْفَ أَنْتَ إِذَا بَقِيتَ فِي  حُثَالَةٍ  مِنَ النَّاسِ  ....فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 14594","","عبد الله بن عمرو بن العاص عن الحسن البصري عن الربيع بن صبيح عن عبد الرحمن بن مهدي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","الحسن"
"14634","14595  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، قَالَ :  ثَنَا  مَعْمَرُ بْنُ سَهْلٍ الْأَهْوَازِيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ ، قَالَ :  ثَنَا  مَالِكُ بْنُ مِغْوَلٍ ،  عَنْ  [ ....]  ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَيْفَ أَنْتَ إِذَا كُنْتَ فِي  حُثَالَةٍ  مِنَ النَّاسِ  مَرِجَتْ  عُهُودُهُمْ  ،  وَمَرِجَتْ  أَمَانَاتُهُمْ ، وَاخْتَلَفَتْ [قُلُوبُهُمْ] ؟ !  وَشَبَّكَ  بَيْنَ أَصَابِعِهِ ، قَالَ : كَيْفَ أَصْنَعُ يَا رَسُولَ اللهِ ؟ قَالَ : عَلَيْكَ بِمَا تَعْرِفُ ، [وَدَعْ مَا تُنْكِرُ] ، وَعَلَيْكَ بِخُوَيْصَّةِ نَفْسِكَ ، وَإِيَّاكَ وَعَوَامَّهُمْ  .  كذا في طبعة الجريسي ، وهي غير واضحة في الأصل الخطي نسخة الوطنية ، وأشار لذلك المحقق ، ولم نقف عليه في موضع آخر فالله أعلم .","","Al-Mu'jam al-Kabir 14595","","عبد الله بن عمرو بن العاص عن الحسن البصري عن مالك بن مغول الصهيبي عن محمد بن إسماعيل الفارسي عن معمر بن سهل بن معمر الأهوازي عن عبد الله بن أحمد الجواليقي عن الطبراني","الحسن"
"14635","[14/15]      14596  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَ :  ثَنَا  أَبُو كُرَيْبٍ ، قَالَ :  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  خَالِدِ بْنِ دِينَارٍ النِّيلِيِّ ،  عَنِ  الْحَسَنِ :  أَنَّ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لِعَبْدِ اللهِ بْنِ عَمْرٍو :  كَيْفَ أَنْتَ إِذَا بَقِيتَ فِي  حُثَالَةٍ  مِنَ النَّاسِ  مَرِجَتْ  قُلُوبُهُمْ وَأَمَانَاتُهُمْ ، وَاخْتَلَفَتْ قُلُوبُهُمْ ؟ !  وَشَبَّكَ  بَيْنَ أَصَابِعِهِ ، قَالَ : كَيْفَ أَصْنَعُ ؟ قَالَ : عَلَيْكَ بِمَا تَعْرِفُ ، وَدَعْ مَا تُنْكِرُ ، وَعَلَيْكَ بِخُوَيْصَّةِ نَفْسِكَ ، وَإِيَّاكَ وَعَوَامَّهُمْ  .","","Al-Mu'jam al-Kabir 14596","","عبد الله بن عمرو بن العاص عن الحسن البصري عن خالد بن دينار النيلي عن يونس بن بكير عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","الحسن"
"14636","14597  -  حَدَّثَنَا  أَحْمَدُ بْنُ أَبِي خَيْثَمَةَ ، وَأَحْمَدُ بْنُ مَابِهْرَامَ الْإِيذَجِيُّ ، قَالَا :  ثَنَا  نَصْرُ بْنُ عَلِيٍّ ، قَالَ :  أَخْبَرَنَا  نُوحُ بْنُ قَيْسٍ ، قَالَ :  ثَنَا  كَثِيرُ بْنُ زِيَادٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لَهُ :  كَيْفَ بِكَ إِذَا بَقِيتَ فِي  حُثَالَةٍ  مِنَ النَّاسِ  ؛         [14/16]      قَوْمٌ  مَرِجَتْ  عُهُودُهُمْ وَأَمَانَاتُهُمْ ، وَاخْتَلَفُوا وَصَارُوا هَكَذَا ؟  وَشَبَّكَ  بَيْنَ أَصَابِعِهِ . قَالَ : مَا تَأْمُرُنِي يَا رَسُولَ اللهِ ؟ قَالَ : عَلَيْكَ بِمَا تَعْرِفُ ، وَدَعْ مَا تُنْكِرُ ، وَعَلَيْكَ بِخَاصَّةِ نَفْسِكَ ، وَدَعْ عَوَامَّهُمْ  .","","Al-Mu'jam al-Kabir 14597","","عبد الله بن عمرو بن العاص عن الحسن البصري عن كثير بن زياد البرساني عن نوح بن قيس بن رباح الحداني عن نصر بن علي بن نصر الجهضمي عن أحمد بن الحسين بن مابهرام الأيذجي عن الطبراني","الحسن"
"14637","14598  -  أَخْبَرَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ السُّلَمِيُّ الْبَصْرِيُّ ، قَالَ :  ثَنَا  مُنَيْنُ بْنُ طَالِبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَبْدِ الْكَرِيمِ الضَّالُّ ،  عَنِ  الْحَسَنِ ،  أَنَّ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لِعَبْدِ اللهِ بْنِ عَمْرٍو ..... فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14598","","عبد الله بن عمرو بن العاص عن الحسن البصري عن الضال معاوية بن عبد الكريم عن منين بن طالب البصري عن عثمان بن عبد الرحمن السلمي البصري عن الطبراني","الحسن"
"14638","14599  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ، قَالَ :  ثَنَا  أَبِي ،  قَالَ :  ثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ، قَالَ : أَخْبَرَنَا قُرَّةُ بْنُ خَالِدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ قَالَ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ  شَرِبَ  الْخَمْرَ فَاجْلِدُوهُ ، ثُمَّ إِنْ  شَرِبَ  فَاجْلِدُوهُ  ، ثُمَّ إِنْ شَرِبَ فَاجْلِدُوهُ ، ثُمَّ إِنْ شَرِبَ الرَّابِعَةَ  فَاقْتُلُوهُ  .  قَالَ : فَكَانَ  عَبْدُ اللهِ بْنُ عَمْرٍو  يَقُولُ : ائْتُونِي بِرَجُلٍ  شَرِبَ  الْخَمْرَ ثَلَاثَ مَرَّاتٍ ، فَلَكُمْ عَلَيَّ أَنْ أَضْرِبَ عُنُقَهُ  .","","Al-Mu'jam al-Kabir 14599","","عبد الله بن عمرو بن العاص عن الحسن البصري عن قرة بن خالد السدوسي عن النضر بن شميل عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","الحسن"
"14639","[14/17]      شُفَيٌّ الْأَصْبَحِيُّ  14600  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  حَيْوَةَ بْنِ شُرَيْحٍ الْكِنْدِيِّ ،  عَنْ  شُفَيٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لِلْغَازِي أَجْرُهُ ، وَلِلْجَاعِلِ أَجْرُهُ وَأَجْرُ الْغَازِي  .","","Al-Mu'jam al-Kabir 14600","","عبد الله بن عمرو بن العاص عن شفي بن ماتع الأصبحي عن حيوة بن شريح التجيبي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","شفي الأصبحي"
"14640","[14/18]      14601  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  حَدَّثَنِي  أَبُو قَبِيلٍ الْمَعَافِرِيُّ ،  عَنْ  شُفَيٍّ الْأَصْبَحِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَفِي يَدِهِ كِتَابَانِ ، فَقَالَ :  أَتَدْرُونَ مَا هَذَانِ الْكِتَابَانِ ؟ فَقُلْنَا : لَا ، إِلَّا أَنْ تُخْبِرَنَا يَا رَسُولَ اللهِ ،  قَالَ : كِتَابٌ مِنْ رَبِّ الْعَالَمِينَ فِيهِ أَسْمَاءُ         [14/19]      أَهْلِ الْجَنَّةِ ، وَأَسْمَاءُ آبَائِهِمْ وَقَبَائِلِهِمْ ، ثُمَّ  أُجْمِلَ  عَلَى آخِرِهِمْ ، فَلَا يُزَادُ فِيهِمْ وَلَا يُنْتَقَصُ مِنْهُمْ أَبَدًا .  وَهَذَا كِتَابُ أَهْلِ النَّارِ بِأَسْمَائِهِمْ وَأَسْمَاءِ آبَائِهِمْ وَقَبَائِلِهِمْ ، ثُمَّ  أُجْمِلَ  عَلَى الْآخِرِ مِنْهُمْ ، فَلَا يُزَادُ فِيهِمْ ، وَلَا يُنْقَصُ مِنْهُمْ أَبَدًا . فَقَالَ أَصْحَابُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : فَفِيمَ الْعَمَلُ إِنْ كَانَ هَذَا أَمْرٌ قَدْ فُرِغَ مِنْهُ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : بَلْ  سَدِّدُوا  وَقَارِبُوا ،  فَإِنَّ صَاحِبَ الْجَنَّةِ يُخْتَمُ لَهُ بِعَمَلِ الْجَنَّةِ ، وَإِنْ عَمِلَ أَيَّ عَمَلٍ ، وَإِنَّ صَاحِبَ النَّارِ يُخْتَمُ لَهُ بِعَمَلِ أَهْلِ النَّارِ ، وَإِنْ عَمِلَ أَيَّ عَمَلٍ ، فَرَغَ رَبُّكُمْ مِنَ الْعِبَادِ ، ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِيَدَيْهِ فَنَبَذَهُمَا : فَرَغَ رَبُّكُمْ مِنَ الْخَلْقِ : فَرِيقٌ فِي الْجَنَّةِ ، وَفَرِيقٌ فِي السَّعِيرِ  .","","Al-Mu'jam al-Kabir 14601","","عبد الله بن عمرو بن العاص عن شفي بن ماتع الأصبحي عن حيي بن هانئ السريعي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","شفي الأصبحي"
"14641","14602  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ         [14/20]      صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  حَدَّثَنِي  حَيْوَةُ بْنُ شُرَيْحٍ ،  عَنِ  ابْنِ شُفَيٍّ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،  عَنْ  رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ :  قَفْلَةٌ  كَغَزْوَةٍ ؛  يُرِيدُ : الْقُفُولَ مِنَ الْغَزْوِ  .","","Al-Mu'jam al-Kabir 14602","","عبد الله بن عمرو بن العاص عن شفي بن ماتع الأصبحي عن الحسين بن شفي الأصبحي عن حيوة بن شريح التجيبي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","شفي الأصبحي"
"14642","14603  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ، قَالَ :  ثَنَا  كَامِلُ بْنُ طَلْحَةَ الْجَحْدَرِيُّ .         [14/21]      قَالَ :  وَثَنَا  طَاهِرُ بْنُ عِيسَى بْنِ قِيرَسَ الْمِصْرِيُّ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ، قَالَا :  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ عَمْرٍو ،  عَنْ  شُفَيٍّ الْأَصْبَحِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  عَقَلْتُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَلْفَ مَثَلٍ  .","","Al-Mu'jam al-Kabir 14603","","عبد الله بن عمرو بن العاص عن شفي بن ماتع الأصبحي عن يزيد بن عمرو المعافري عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن طاهر بن عيسى بن قيرس المؤدب عن الطبراني","شفي الأصبحي"
"14643","[14/22]      عَمْرُو بْنُ الْوَلِيدِ بْنِ عَبْدَةَ  14604  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَ :  ثَنَا  أَبُو عَاصِمٍ ،  عَنْ  عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  عَمْرِو بْنِ الْوَلِيدِ بْنِ عَبْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  ، ثُمَّ قَالَ : إِنَّ اللهَ عَزَّ وَجَلَّ وَرَسُولَهُ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَرَّمَا الْخَمْرَ ، وَالْمَيْسِرَ ،  وَالْكُوبَةَ ،  وَالْغُبَيْرَاءَ  .","","Al-Mu'jam al-Kabir 14604","","عبد الله بن عمرو بن العاص عن عمرو بن الوليد بن عبدة السهمى عن يزيد بن أبي حبيب الأزدي عن عبد الحميد بن جعفر الأوسي عن أبو عاصم النبيل عن أبو مسلم الكجي عن الطبراني","عمرو بن الوليد بن عبدة"
"14644","[14/23]      الْوَلِيدُ بْنُ عَبْدَةَ  14605  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ، قَالَ :  ثَنَا  حَسَّانُ بْنُ غَالِبٍ ، قَالَ :  وَحَدَّثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يُونُسَ بْنِ يَزِيدَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  [يَزِيدَ] بْنِ أَبِي حَبِيبٍ ،  عَنِ  الْوَلِيدِ بْنِ عَبْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ....سَوَاءً .","","Al-Mu'jam al-Kabir 14605","","عبد الله بن عمرو بن العاص عن الوليد بن عبدة المصري مولى عمرو بن العاص عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن يونس بن يزيدالأيلي عن عبد الله بن لهيعة عن حسان بن غالب المصري عن يحيى بن عثمان بن صالح عن الطبراني","الوليد بن عبدة"
"14645","عَمْرُو بْنُ الْوَلِيدِ  14606  -  حَدَّثَنَا  يَحْيَى بْنُ نَافِعٍ الْمِصْرِيُّ أَبُو حَبِيبٍ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ، قَالَ :  أَخْبَرَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  عَمْرِو بْنِ الْوَلِيدِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ،         [14/24]      هَلْ تُحِسُّ بِالْوَحْيِ ؟ قَالَ :  نَعَمْ ؛ أَسْمَعُ صَلَاصِلًا ، ثُمَّ أَسْتَثْبِتُ عِنْدَ ذَلِكَ ، وَمَا مِنْ مَرَّةٍ يُوحَى إِلَيَّ ، إِلَّا ظَنَنْتُ أَنَّ نَفْسِي تَفِيضُ  .","","Al-Mu'jam al-Kabir 14606","","عبد الله بن عمرو بن العاص عن عمرو بن الوليد بن عبدة السهمى عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن يحيى بن نافع بن خالد المصري عن الطبراني","عمرو بن الوليد"
"14646","14607  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ، قَالَ :  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  عَمْرِو بْنِ الْوَلِيدِ بْنِ عَبْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَدْرِي مَنْ مَعَنَا فِي الْبَيْتِ ؟  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، وَقَدْ سَلَّمَ عَلَيْكَ  .","","Al-Mu'jam al-Kabir 14607","","عبد الله بن عمرو بن العاص عن عمرو بن الوليد بن عبدة السهمى عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن يحيى بن عثمان بن صالح عن الطبراني","عمرو بن الوليد"
"14647","14608  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  عَمْرِو بْنِ الْوَلِيدِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  كُنْتُ يَوْمًا مَعَ         [14/25]      رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي بَيْتِهِ ، فَقَالَ :  تَدْرُونَ مَنْ مَعَنَا فِي الْبَيْتِ ؟  قُلْتُ : مَنْ يَا رَسُولَ اللهِ ؟ ! قَالَ :  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، قُلْتُ : السَّلَامُ عَلَيْكَ يَا  جِبْرِيلُ  وَرَحْمَةُ اللهِ . قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّهُ رَدَّ عَلَيْكَ السَّلَامَ  .","","Al-Mu'jam al-Kabir 14608","","عبد الله بن عمرو بن العاص عن عمرو بن الوليد بن عبدة السهمى عن يزيد بن أبي حبيب الأزدي عن عمرو بن الحارث بن يعقوب عن رشدين بن سعد المهري عن حجاج بن رشدين المصري عن محمد بن الحجاج بن رشدين المهري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","عمرو بن الوليد"
"14648","مُحَمَّدُ بْنُ هَدِيَّةَ  14609  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ، قَالَ :  ثَنَا  أَسَدُ بْنُ مُوسَى ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ شُرَيْحٍ الْمَعَافِرِيِّ ، قَالَ :  حَدَّثَنِي  شَرَاحِيلُ بْنُ يَزِيدَ ،  عَنْ  مُحَمَّدِ بْنِ هُدَيَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَكْثَرُ  مُنَافِقِي  أُمَّتِي  قُرَّاؤُهَا  .","","Al-Mu'jam al-Kabir 14609","","عبد الله بن عمرو بن العاص عن محمد بن هدية الصدفي عن شراحيل بن يزيد المعافري عن عبد الرحمن بن شريح المعافري عن عبد الله بن المبارك عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","محمد بن هدية"
"14649","[14/26]      عُلَيُّ بْنُ رَبَاحٍ  14610  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  مُوسَى بْنُ عُلَيِّ بْنِ رَبَاحٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَتَدْرُونَ مَا الْمُسْلِمُ ؟ قَالُوا : اللهُ وَرَسُولُهُ أَعْلَمُ ، قَالَ : مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  ، قَالُوا :         [14/27]      فَمَنِ الْمُؤْمِنُ ؟ قَالَ : مَنْ أَمِنَهُ الْمُؤْمِنُونَ عَلَى أَنْفُسِهِمْ وَأَمْوَالِهِمْ ، قَالُوا : فَمَنِ الْمُهَاجِرُ ؟ قَالَ : مَنْ هَجَرَ السُّوءَ فَاجْتَنَبَهُ .  قَالَ أَبُو الْقَاسِمِ :  أَهْلُ مِصْرَ  يَقُولُونَ :  مُوسَى بْنُ عُلَيِّ بْنِ رَبَاحٍ  ، وَسَائِرُ النَّاسِ يَقُولُونَ :  مُوسَى بْنُ عُلَيٍّ  ، وَقَدْ حَرَّجَ عَلَى مَنْ سَمَّاهُ  عُلَيًّ  .","","Al-Mu'jam al-Kabir 14610","","عبد الله بن عمرو بن العاص عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","علي بن رباح"
"14650","14611  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ، قَالَ :  ثَنَا  أَصْبَغُ بْنُ الْفَرَجِ ، قَالَ :  ثَنَا  الْكَيِّسُ بْنُ حَسَّانَ ،  عَنْ  أَبِيهِ ،  عَنْ  مُوسَى بْنِ عُلَيِّ         [14/28]      بْنِ رَبَاحٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَتَدْرُونَ مَنِ الْمُسْلِمُ ؟  ...  فَذَكَرَ مِثْلَ حَدِيثِ  ابْنِ صَالِحٍ  .","","Al-Mu'jam al-Kabir 14611","","عبد الله بن عمرو بن العاص عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن حسان بن عبد الله اللخمي عن كيس بن حسان اللخمي عن أصبغ بن الفرج مولى عمر بن عبد العزيز عن يحيى بن عثمان بن صالح عن الطبراني","علي بن رباح"
"14651","14612  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ، قَالَ :  ثَنَا  رَوْحُ بْنُ صَلَاحٍ ، قَالَ :  ثَنَا  مُوسَى بْنُ عُلَيِّ بْنِ رَبَاحٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّمَا  الْحَسَدُ  فِي اثْنَتَيْنِ : رَجُلٌ         [14/29]      آتَاهُ اللهُ الْقُرْآنَ  ، فَقَامَ بِهِ فَأَحَلَّ حَلَالَهُ وَحَرَّمَ حَرَامَهُ ، وَرَجُلٌ آتَاهُ اللهُ مَالًا فَوَصَلَ فِيهِ أَقَارِبَهُ وَرَحِمَهُ ، وَعَمِلَ بِكَلِمَةِ اللهِ  .","","Al-Mu'jam al-Kabir 14612","","عبد الله بن عمرو بن العاص عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن روح بن صلاح بن سيابة الحارثي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","علي بن رباح"
"14652","14613  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ، قَالَ :  ثَنَا  رَوْحُ بْنُ صَلَاحٍ ، قَالَ :  ثَنَا  مُوسَى بْنُ عُلَيِّ بْنِ رَبَاحٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَا أُنَبِّئُكَ بِأَهْلِ الْجَنَّةِ ؟ قُلْتُ : بَلَى ، قَالَ : الضُّعَفَاءُ الْمَغْلُوبُونَ  .","","Al-Mu'jam al-Kabir 14613","","عبد الله بن عمرو بن العاص عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن روح بن صلاح بن سيابة الحارثي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","علي بن رباح"
"14653","[14/30]      أَبُو عَبْدِ الرَّحْمَنِ الْحُبُلِيُّ  .  14614  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  عَامِرِ بْنِ يَحْيَى الْمَعَافِرِيِّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو ، قَالَ : قَالَ         [14/31]      رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَيُصَاحُ يَوْمَ الْقِيَامَةِ بِرَجُلٍ مِنْ أُمَّتِي عَلَى رُؤُوسِ الْخَلَائِقِ ، وَتُنْشَرُ عَلَيْهِ تِسْعَةٌ وَتِسْعُونَ  سِجِلًّا  ، كُلُّ  سِجِلٍّ  مِنْهَا مَدُّ الْبَصَرِ  ، ثُمَّ قَالَ : أَتُنْكِرُ مِنْ هَذَا شَيْئًا ؟ فَيَقُولُ : لَا يَا رَبِّ ، فَيَقُولُ : وَلَكَ عُذْرٌ أَوْ حَسَنَةٌ ؟ فَيَهَابُ الرَّجُلُ فَيَقُولُ : لَا يَا رَبِّ . فَيَقُولُ ، بَلَى ، إِنَّ لَكَ عِنْدَنَا حَسَنَاتٍ ، وَإِنَّهُ لَا ظُلْمَ عَلَيْكَ الْيَوْمَ . فَتُخْرَجُ لَهُ  بِطَاقَةٌ  فِيهَا : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ ، فَيَثْقُلُ وَزْنُهُ ، فَيَقُولُ : يَا رَبِّ ، مَا هَذِهِ  الْبِطَاقَةُ  مَعَ هَذِهِ  السِّجِلَّاتِ  ؟ فَتُوضَعُ  السِّجِلَّاتُ  فِي كِفَّةٍ ،  وَالْبِطَاقَةُ  فِي كِفَّةٍ ،  فَطَاشَتِ  السِّجِلَّاتُ  ، وَتَثْقُلُ  الْبِطَاقَةُ  .","","Al-Mu'jam al-Kabir 14614","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عامر بن يحيى الشرعبي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","أبو عبد الرحمن الحبلي"
"14654","14615  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ الْمِصْرِيُّ ، قَالَ :  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  عَنْ  رَاشِدِ بْنِ عَبْدِ اللهِ الْمَعَافِرِيِّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَفْضَلُ الصَّدَقَةِ إِصْلَاحُ ذَاتِ الْبَيْنِ  .","","Al-Mu'jam al-Kabir 14615","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن راشد بن يحيى المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14655","[14/32]      14616  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِسْحَاقَ النَّيْسَابُورِيُّ ، قَالَ :  ثَنَا  يَحْيَى بْنُ يَحْيَى النَّيْسَابُورِيُّ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَيَّاشِ بْنِ عَبَّاسٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  لَمْ يَكُنْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَاحِشًا  ، وَلَا مُتَفَحِّشًا  .","","Al-Mu'jam al-Kabir 14616","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عياش بن عباس القتباني عن عبد الله بن لهيعة عن يحيى بن يحيى الحنظلي عن إسماعيل بن إسحاق السراج عن الطبراني","أبو عبد الرحمن الحبلي"
"14656","14617  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ، قَالَ :  ثَنَا  خَالِدُ بْنُ خِدَاشٍ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ عَيَّاشِ بْنِ عَبَّاسٍ الْقِتْبَانِيُّ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سُئِلَ عَنْ عِلْمٍ فَكَتَمَهُ ،  أُلْجِمَ  يَوْمَ الْقِيَامَةِ بِلِجَامٍ مِنْ نَارٍ  .","","Al-Mu'jam al-Kabir 14617","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عياش بن عباس القتباني عن عبد الله بن عياش القتباني عن عبد الله بن وهب المصري عن خالد المهلبي عن محمد بن أحمد بن النضر النضري عن الطبراني","أبو عبد الرحمن الحبلي"
"14657","[14/33]      14618  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ، قَالَ :  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ، (  ح  ) .  وَحَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ، قَالَ :  ثَنَا  يَزِيدُ بْنُ مَوْهَبٍ الرَّمْلِيُّ ، قَالَ :  ثَنَا  مُفَضَّلُ بْنُ فَضَالَةَ ،  عَنْ  عَيَّاشِ بْنِ عَبَّاسٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُغْفَرُ لِلشَّهِيدِ كُلُّ ذَنْبٍ إِلَّا الدَّيْنَ  .","","Al-Mu'jam al-Kabir 14618","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عياش بن عباس القتباني عن المفضل بن فضالة عن يزيد بن خالد بن يزيد بن موهب عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","أبو عبد الرحمن الحبلي"
"14658","14619  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ         [14/34]      الْمُقْرِئُ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  عَنْ  عَيَّاشِ بْنِ عَبَّاسٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْقَتْلُ فِي  سَبِيلِ  اللهِ ، يُكَفِّرُ كُلَّ شَيْءٍ ، إِلَّا الدَّيْنَ  .","","Al-Mu'jam al-Kabir 14619","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عياش بن عباس القتباني عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14659","14620  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزِّيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ الْعَسْقَلَانِيُّ ، قَالَ :  ثَنَا  رِشْدِينُ بْنُ سَعْدٍ ، قَالَ :  ثَنَا  زُهْرَةُ بْنُ مَعْبَدٍ ، (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ زِيَادِ بْنِ زَكَرِيَّا الْإِيَادِيُّ الْأَعْرَجُ ، قَالَ :  ثَنَا  مُوسَى بْنُ مُحَمَّدٍ السُّكَّرِيُّ  ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ حِمْيَرَ ،  عَنْ  خَالِدِ بْنِ حُمَيْدٍ الْمَهْرِيِّ ،  عَنْ  زُهْرَةَ بْنِ مَعْبَدٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، مَا غَنِيمَةُ مَجَالِسِ الذِّكْرِ ؟ قَالَ : الْجَنَّةُ  .  قال محقق طبعة الجريسي : ""كذا في الأصل ، وفي ""مسند الشاميين"" - في إسناد هذا الحديث وفي موضعين آخرين -: «السكوني» .""","","Al-Mu'jam al-Kabir 14620","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن زهرة بن معبد القرشي عن خالد بن حميد المهري عن محمد بن حمير القضاعي عن موسى بن محمد السكوني عن أحمد بن زياد الإيادي عن الطبراني","أبو عبد الرحمن الحبلي"
"14660","[14/35]      14621  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزِّيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ الْعَسْقَلَانِيُّ ، قَالَ :  ثَنَا  رِشْدِينُ ، قَالَ :  حَدَّثَنِي  زُهْرَةُ بْنُ مَعْبَدٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِرَجُلٍ  :  كَيْفَ أَصْبَحْتَ يَا فُلَانُ ؟ قَالَ :  أَحْمَدُ  اللهَ إِلَيْكَ يَا رَسُولَ اللهِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : هَذَا الَّذِي أَرَدْتُ مِنْكَ  .","","Al-Mu'jam al-Kabir 14621","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن زهرة بن معبد القرشي عن رشدين بن سعد المهري عن محمد بن المتوكل بن ابى السرى عن عبد الله بن وهيب الجذامي عن الطبراني","أبو عبد الرحمن الحبلي"
"14661","14622  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ، (  ح  ) .  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ، قَالَ :  ثَنَا  أَسَدُ بْنُ مُوسَى ، قَالَا :  ثَنَا  ابْنُ لَهِيعَةَ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ هُبَيْرَةَ ،  أَنَّهُ سَمِعَ  أَبَا عَبْدِ الرَّحْمَنِ الْحُبُلِيَّ ،  يُحَدِّثُ عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :         [14/36]      مَنْ رَدَّتْهُ  الطِّيَرَةُ  عَنْ حَاجَتِهِ ، فَقَدْ  أَشْرَكَ  . قَالُوا : يَا رَسُولَ اللهِ ، فَمَا كَفَّارَةُ ذَلِكَ ؟ قَالَ : يَقُولُ : اللَّهُمَّ لَا طَيْرَ إِلَّا طَيْرُكَ ، وَلَا خَيْرَ إِلَّا خَيْرُكَ ، وَلَا إِلَهَ إِلَّا أَنْتَ  .","","Al-Mu'jam al-Kabir 14622","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الله بن هبيرة السبئي عن عبد الله بن لهيعة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","أبو عبد الرحمن الحبلي"
"14662","14623  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ الْعَسْقَلَانِيُّ ، قَالَ :  ثَنَا  رِشْدِينُ بْنُ سَعْدٍ ،  عَنْ  عُمَرَ ، مَوْلَى غُفْرَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ، قَالَ :  قَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ إِنَّ الْمُؤَذِّنِينَ يَفْضُلُونَنَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فَقُلْ كَمَا يَقُولُ الْمُؤَذِّنُ ، ثُمَّ إِذَا فَرَغْتَ فَسَلْ تُعْطَهْ  .","","Al-Mu'jam al-Kabir 14623","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عمر بن عبد الله مولى غفرة بنت رباح عن رشدين بن سعد المهري عن محمد بن المتوكل بن ابى السرى عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","أبو عبد الرحمن الحبلي"
"14663","14624  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  شُرَحْبِيلَ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ         [14/37]      [الْحُبُلِيِّ] ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الدُّنْيَا مَتَاعٌ ، [وَخَيْرُ] مَتَاعِهَا الزَّوْجُ الصَّالِحُ  .","","Al-Mu'jam al-Kabir 14624","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن شرحبيل بن شريك الأجروي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","أبو عبد الرحمن الحبلي"
"14664","14625  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،  عَنْ  حَيْوَةَ بْنِ شُرَيْحٍ ، وَابْنِ لَهِيعَةَ ، قَالَا :  ثَنَا  شُرَحْبِيلُ بْنُ شَرِيكٍ الْمَعَافِرِيُّ ،  أَنَّهُ سَمِعَ  أَبَا عَبْدِ الرَّحْمَنِ الْحُبُلِيَّ ،  يُحَدِّثُ عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،  عَنْ  رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ :  خَيْرُ الْأَصْحَابِ عِنْدَ اللهِ خَيْرُهُمْ لِصَاحِبِهِ ، وَخَيْرُ الْجِيرَانِ عِنْدَ اللهِ خَيْرُهُمْ لِجَارِهِ  .","","Al-Mu'jam al-Kabir 14625","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن شرحبيل بن شريك الأجروي عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","أبو عبد الرحمن الحبلي"
"14665","[14/38]      14626  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ الْمِصْرِيُّ ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ، قَالَ :  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ ،  عَنْ  شُرَحْبِيلَ بْنِ شَرِيكٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ فُقَرَاءَ الْمُهَاجِرِينَ يَسْبِقُونَ الْأَغْنِيَاءَ يَوْمَ الْقِيَامَةِ أَرْبَعِينَ  خَرِيفًا  .","","Al-Mu'jam al-Kabir 14626","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن شرحبيل بن شريك الأجروي عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14666","14627  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ، قَالَ :  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ ، قَالَ :  أَخْبَرَنِي  شُرَحْبِيلُ بْنُ شَرِيكٍ ،  أَنَّهُ سَمِعَ  أَبَا عَبْدِ الرَّحْمَنِ الْحُبُلِيَّ ، يُحَدِّثُ :  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عَمْرٍو ، يَقُولُ :  لَخَيْرٌ أَعْمَلُهُ الْيَوْمَ أَحَبُّ إِلَيَّ مِنْ مِثْلَيْهِ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، لِأَنَّا كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تُهِمُّنَا الْآخِرَةُ وَلَا تُهِمُّنَا الدُّنْيَا ، وَأَنَّا الْيَوْمَ قَدْ مَالَتْ بِنَا الدُّنْيَا  .","","Al-Mu'jam al-Kabir 14627","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن شرحبيل بن شريك الأجروي عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","أبو عبد الرحمن الحبلي"
"14667","[14/39]      14628  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ الْمُقْرِئُ ، قَالَ :  ثَنَا  حَيْوَةُ ،  عَنْ  شُرَحْبِيلَ بْنِ شَرِيكٍ (  ح  ) .  وَحَدَّثَنَا  طَاهِرُ بْنُ عِيسَى بْنِ قِيرَسَ الْمُقْرِئُ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  شُرَحْبِيلَ بْنِ شَرِيكٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَدْ أَفْلَحَ مَنْ رَزَقَهُ اللهُ كَفَافًا ، وَقَنَّعَهُ بِمَا آتَاهُ  .","","Al-Mu'jam al-Kabir 14628","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن شرحبيل بن شريك الأجروي عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14668","[14/40]      14629  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ، قَالَ :  أَخْبَرَنَا  نَافِعُ بْنُ يَزِيدَ ، قَالَ :  حَدَّثَنِي  رَبِيعَةُ بْنُ سَيْفٍ ، قَالَ :  حَدَّثَنِي  أَبُو عَبْدِ الرَّحْمَنِ الْحُبُلِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  قَبَرْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَجُلًا  ، فَلَمَّا رَجَعْنَا وَحَاذَيْنَا بَابَهُ ، إِذَا هُوَ بِامْرَأَةٍ مُقْبِلَةٍ لَا نَظُنُّهُ عَرَفَهَا ، فَقَالَ :  يَا  فَاطِمَةُ  مِنْ أَيْنَ جِئْتِ ؟ قَالَتْ : جِئْتُ مِنْ عِنْدِ أَهْلِ هَذَا الْمَيِّتِ ، رَحِمْتُ إِلَيْهِمْ مَيِّتَهُمْ وَعَزَّيْتُهُمْ  ، قَالَ : فَلَعَلَّكِ بَلَغْتِ مَعَهُمُ  الْكُدَى  ؟ ! قَالَتْ : مَعَاذَ اللهِ أَنْ أَبْلُغَ مَعَهُمُ  الْكُدَى  ، وَقَدْ سَمِعْتُكَ تَذْكُرُ مِنْهُمْ مَا تَذْكُرُ ، قَالَ : لَوْ بَلَغْتِ مَعَهُمُ  الْكُدَى  مَا رَأَيْتِ الْجَنَّةَ حَتَّى يَرَاهَا جَدُّ أَبِيكِ  .  وَالْكُدَى  : الْمَقَابِرُ  .         [14/41]","","Al-Mu'jam al-Kabir 14629","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن ربيعة بن سيف المعافري عن نافع بن يزيد الكلاعي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","أبو عبد الرحمن الحبلي"
"14669","14630  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ، قَالَ :  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ ،  عَنْ  رَبِيعَةَ بْنِ سَيْفٍ ،  عَنِ  الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14630","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن ربيعة بن سيف المعافري عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14670","14631  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  عَنْ  رَبِيعَةَ بْنِ سَيْفٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  قَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، تَمُرُّ بِنَا جِنَازَةُ الْكَافِرِ ، فَنَقُومُ لَهَا ؟ فَقَالَ  : نَعَمْ ، قُومُوا لَهَا ، فَإِنَّكُمْ لَسْتُمْ تَقُومُونَ لَهَا ، إِنَّمَا تَقُومُونَ لِمَنْ مَعَهَا مِنَ الْمَلَائِكَةِ  .","","Al-Mu'jam al-Kabir 14631","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن ربيعة بن سيف المعافري عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14671","[14/42]      14632  -  حَدَّثَنَا  هَارُونُ ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ عَبْدُ اللهِ بْنُ يَزِيدَ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادِ بْنِ أَنْعُمَ ،  عَنِ  الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَتَمَنَّوْا لِقَاءَ الْعَدُوِّ وَسَلُوا اللهَ الْعَافِيَةَ ،  فَإِذَا لَقِيتُمُوهُمْ فَاثْبُتُوا ، فَإِنْ أَيْلَبُوا وَصَيَّحُوا فَعَلَيْكُمْ بِالصَّمْتِ  .","","Al-Mu'jam al-Kabir 14632","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14672","14633  -  حَدَّثَنَا  هَارُونُ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ، قَالَ :  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ ، قَالَ :  حَدَّثَنِي  أَبُو هَانِئٍ ،  عَنِ  الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الدُّنْيَا مَتَاعٌ ، وَخَيْرُ مَتَاعِهَا الْمَرْأَةُ الصَّالِحَةُ  .","","Al-Mu'jam al-Kabir 14633","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حميد بن هانئ الخولاني عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14673","[14/43]      14634  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ (  ح  ) .  وَحَدَّثَنَا  بِشْرُ بْنُ مُوسَى ، قَالَ :  ثَنَا  خَلَّادُ بْنُ يَحْيَى (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  أَبُو نُعَيْمٍ ، قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ         [14/44]      عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَمَنَّوْا لِقَاءَ الْعَدُوِّ ، وَسَلُوا اللهَ الْعَافِيَةَ  ، فَإِذَا لَقِيتُمُوهُمْ فَاثْبُتُوا ، وَأَكْثِرُوا ذِكْرَ اللهِ ، وَإِنْ يَلَّبُوا وَصَيَّحُوا فَعَلَيْكُمْ بِالصَّمْتِ  .","","Al-Mu'jam al-Kabir 14634","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو عبد الرحمن الحبلي"
"14674","14635  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِرَجُلٍ مِنَ الْأَنْصَارِ  :  مَا تَقُولُ عِنْدَ مَنَامِكَ ؟ قَالَ : أَقُولُ : بِاسْمِكَ اللَّهُمَّ وَضَعْتُ جَنْبِي فَاغْفِرْ لِي . قَالَ : غَفَرَ اللهُ لَكَ  .","","Al-Mu'jam al-Kabir 14635","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14675","[14/45]      14636  -  حَدَّثَنَا  هَارُونُ ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  أَلَا أُعَلِّمُكَ [كَلِمَاتٍ] كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُعَلِّمُهُنَّ  أَبَا بَكْرٍ  إِذَا أَرَادَ أَنْ يَنَامَ ؟ قُلْنَا : بَلَى ، قَالَ :  اللَّهُمَّ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ ، عَالِمَ الْغَيْبِ وَالشَّهَادَةِ  ، أَنْتَ رَبُّ كُلِّ شَيْءٍ وَمَلِيكُهُ ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ وَحْدَكَ لَا شَرِيكَ لَكَ ، وَالْمَلَائِكَةُ يَشْهَدُونَ ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الشَّيْطَانِ  وَشِرْكِهِ ،  وَأَعُوذُ بِكَ أَنْ أَقْتَرِفَ عَلَى نَفْسِي سُوءًا ، أَوْ أَجُرَّهُ إِلَى مُسْلِمٍ .","","Al-Mu'jam al-Kabir 14636","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14676","14637  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ         [14/46]      الْمُقْرِئُ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ صُدِعَ فِي  سَبِيلِ  اللهِ ،  فَاحْتَسَبَ  ، غَفَرَ اللهُ لَهُ مَا كَانَ قَبْلُ مِنْ ذَنْبٍ  .","","Al-Mu'jam al-Kabir 14637","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","أبو عبد الرحمن الحبلي"
"14677","14638  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  لَمَّا أَمَرَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بَالْخَنْدَقِ  ، فَخُنْدِقَ عَلَى  الْمَدِينَةِ  ، قَالُوا :         [14/47]      يَا رَسُولَ اللهِ إِنَّا وَكَدْنَا صَفًا ، لَا نَسْتَطِيعُ حَفْرَهَا ، فَقَامَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقُمْنَا مَعَهُ ، فَلَمَّا أَتَى أَخَذَ  الْمِعْوَلَ  فَضَرَبَ بِهِ ضَرْبَةً وَكَبَّرَ ، فَسَمِعْتُ هَدَّةً لَمْ أَسْمَعْ مِثْلَهَا قَطُّ ، فَقَالَ :  فُتِحَتْ  فَارِسُ  !! ثُمَّ ضَرَبَ أُخْرَى وَكَبَّرَ ، فَسَمِعْتُ هَدَّةً ، لَمْ أَسْمَعْ مِثْلَهَا قَطُّ ، فَقَالَ : فُتِحَتِ  الرُّومُ  ، ثُمَّ ضَرَبَ أُخْرَى وَكَبَّرَ ، فَسَمِعْتُ هَدَّةً لَمْ أَسْمَعْ مِثْلَهَا قَطُّ ، فَقَالَ : جَاءَ اللهُ بِحِمْيَرَ ، أَعْوَانًا وَأَنْصَارًا .","","Al-Mu'jam al-Kabir 14638","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14678","14639  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادٍ ،  عَنْ  [ عَبْدِ اللهِ بْنِ يَزِيدَ ] ،  عَنْ         [14/48]      عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ أَحَبَّ رَجُلًا لِلهِ ، فَقَدْ أَحَبَّهُ اللهُ ، فَدَخَلَا جَمِيعًا الْجَنَّةَ  ، فَكَانَ الَّذِي أَحَبَّ لِلهِ أَرْفَعَ مَنْزِلَةً مِنَ الْآخَرِ الَّذِي أُحِبَّ لِلهِ .","","Al-Mu'jam al-Kabir 14639","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","أبو عبد الرحمن الحبلي"
"14679","14640  -  حَدَّثَنَا  هَارُونُ ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :         [14/49]      قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَيُؤَيِّدُ الْإِسْلَامَ بِرِجَالٍ مَا هُمْ مِنْ أَهْلِهِ  .","","Al-Mu'jam al-Kabir 14640","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14680","14641  -  حَدَّثَنَا  جَعْفَرٌ الرَّقِّيُّ ، قَالَ :  ثَنَا  قَبِيصَةُ بْنُ عُقْبَةَ (  ح  ) .  وَحَدَّثَنَا  بِشْرُ بْنُ مُوسَى ، قَالَ :  ثَنَا  خَلَّادُ بْنُ يَحْيَى ، قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الدُّنْيَا مَتَاعٌ ، وَخَيْرُ مَتَاعِهَا الْمَرْأَةُ الصَّالِحَةُ  .","","Al-Mu'jam al-Kabir 14641","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن سفيان الثوري عن خلاد بن يحيى الأرحبي عن بشر بن موسى بن صالح الأسدي عن الطبراني","أبو عبد الرحمن الحبلي"
"14681","14642  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ، قَالَ :  ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ، قَالَ :  ثَنَا  مِنْدَلُ بْنُ عَلِيٍّ ، وَعِيسَى بْنُ يُونُسَ ،  عَنْ  عَبْدِ الرَّحْمَنِ         [14/50]      بْنِ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ الْمَعَافِرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الدُّنْيَا مَتَاعٌ ، وَخَيْرُ مَتَاعِهَا الزَّوْجَةُ الصَّالِحَةُ  .","","Al-Mu'jam al-Kabir 14642","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عيسى بن يونس بن أبي إسحاق عن أبو بلال الأشعري عن محمد بن الفضل بن جابر السقطى عن الطبراني","أبو عبد الرحمن الحبلي"
"14682","14643  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،  يَرْفَعُهُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّكُمْ سَتَظْهَرُونَ عَلَى الْأَعَاجِمِ ، فَتَجِدُونَ بُيُوتًا تُدْعَى الْحَمَّامَاتِ  ، وَلَا يَدْخُلُهَا الرَّجُلُ إِلَّا  بِإِزَارٍ - أَوْ قَالَ : بِمِئْزَرٍ  - وَلَا تَدْخُلُهَا النِّسَاءُ إِلَّا نُفَسَاءَ ، أَوْ مِنْ مَرَضٍ .","","Al-Mu'jam al-Kabir 14643","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو عبد الرحمن الحبلي"
"14683","14644  -  حَدَّثَنَا  حَفْصٌ الرَّقِّيُّ ، قَالَ :  حَدَّثَنَا  قَبِيصَةُ بْنُ عُقْبَةَ (  ح  ) .         [14/51]      وَحَدَّثَنَا  يُوسُفُ الْقَاضِي ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ، قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَدْعُو :  اللَّهُمَّ إِنِّي أَسْأَلُكَ الصِّحَّةَ ،  وَالْعِفَّةَ  ، وَالْأَمَانَةَ  ، وَحُسْنَ  الْخُلُقِ  ، وَالرِّضَا بِالْقَدَرِ .","","Al-Mu'jam al-Kabir 14644","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن سفيان الثوري عن قبيصة بن عقبة السوائي عن حفص بن عمر سنجة ألف عن الطبراني","أبو عبد الرحمن الحبلي"
"14684","14645  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  عَبْدِ اللهِ بْنِ         [14/52]      يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُؤْتَى بِرَجُلٍ يَوْمَ الْقِيَامَةِ ، ثُمَّ يُؤْتَى بِالْمِيزَانِ ، ثُمَّ يُؤْتَى بِتِسْعَةٍ وَتِسْعِينَ  سِجِلًّا  ، كُلُّ  سِجِلٍّ  مِنْهَا مَدُّ الْبَصَرِ  ؛ فِيهَا ذُنُوبُهُ وَخَطَايَاهُ ، فَتُوضَعُ فِي كِفَّةِ الْمِيزَانِ ، ثُمَّ يُؤْتَى بِقِرْطَاسٍ مِثْلِ هَذَا - وَأَشَارَ بِيَدِهِ وَأَمْسَكَ بِإِبْهَامِهِ - فِيهَا شَهَادَةُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، فَتُوضَعُ فِي الْكِفَّةِ ، فَتَرْجَحُ بِذُنُوبِهِ وَخَطَايَاهُ  .","","Al-Mu'jam al-Kabir 14645","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14685","14646  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ (  ح  ) .         [14/53]      وَحَدَّثَنَا  حَفْصٌ الرَّقِّيُّ ، قَالَ :  ثَنَا  قَبِيصَةُ ، قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيَأْتِيَنَّ عَلَى أُمَّتِي مَا أَتَى عَلَى  بَنِي إِسْرَائِيلَ  ، لَوْ كَانَ فِيهِمْ مَنْ يَأْتِي أُمَّهُ عَلَانِيَةً  ، كَانَ فِيهِمْ مَنْ يَأْتِي أُمَّهُ عَلَانِيَةً ،  حَذْوَ  النَّعْلِ بِالنَّعْلِ . وَإِنَّ  بَنِي إِسْرَائِيلَ  افْتَرَقُوا عَلَى ثِنْتَيْنِ وَسَبْعِينَ فِرْقَةً ، وَإِنَّ أُمَّتِي سَتَفْتَرِقُ عَلَى ثَلَاثَةٍ وَسَبْعِينَ فِرْقَةً ، كُلُّهَا فِي النَّارِ إِلَّا فِرْقَةً وَاحِدَةً . قِيلَ : يَا رَسُولَ اللهِ مَنْ هُمْ ؟ قَالَ : مَا أَنَا عَلَيْهِ وَأَصْحَابِي  .","","Al-Mu'jam al-Kabir 14646","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن سفيان الثوري عن قبيصة بن عقبة السوائي عن حفص بن عمر سنجة ألف عن الطبراني","أبو عبد الرحمن الحبلي"
"14686","[14/54]      14647  -  حَدَّثَنَا  هَارُونُ ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  [ ابْنُ أَنْعُمَ ] ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَنْكِحُوا النِّسَاءَ  لِحَسَبِهِنَّ  ، فَعَسَى  حَسَبُهُنَّ  أَنْ يُؤْذِيَهُنَّ  ، وَلَا تَنْكِحُوهُنَّ لِأَمْوَالِهِنَّ ، فَعَسَى أَمْوَالُهُنَّ أَنْ يُطْغِيَهُنَّ ، فَلَأَمَةٌ سَوْدَاءُ خَرْمَاءُ ذَاتُ دِينٍ أَفْضَلُ  .","","Al-Mu'jam al-Kabir 14647","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14687","[14/55]      14648  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ، قَالَ :  ثَنَا  أَبِي ،  قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ الْمَكِّيُّ ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا صَلَاةَ بَعْدَ صَلَاةِ الْفَجْرِ إِلَّا رَكْعَتَيْنِ  .         [14/56]","","Al-Mu'jam al-Kabir 14648","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن سفيان الثوري عن عبد الله بن رجاء البصري عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","أبو عبد الرحمن الحبلي"
"14688","14649  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  الْقَعْنَبِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ غَانِمٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَثَلُ أُمَّتِي كَمَثَلِ الْمَطَرِ ، لَا يُدْرَى أَوَّلُهُ خَيْرٌ أَمْ آخِرُهُ  .","","Al-Mu'jam al-Kabir 14649","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن عمر بن غانم الرعيني عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو عبد الرحمن الحبلي"
"14689","14650  -  حَدَّثَنَا  هَارُونُ ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  مَا تَعُدُّونَ  الشَّهِيدَ  فِيكُمْ ؟ قُلْنَا : مَنْ قُتِلَ فِي  سَبِيلِ  اللهِ ، قَالَ : مَنْ قُتِلَ فِي  سَبِيلِ  اللهِ فَهُوَ  شَهِيدٌ  ، وَمَنْ غَرِقَ فِي  سَبِيلِ  اللهِ فَهُوَ  شَهِيدٌ  ، وَمَنْ قَتَلَهُ الْبَطْنُ فَهُوَ  شَهِيدٌ  ، وَالْمَرْأَةُ يَقْتُلُهَا نِفَاسُهَا  شَهِيدَةٌ  .","","Al-Mu'jam al-Kabir 14650","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14690","[14/57]      14651  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ، قَالَ :  ثَنَا  يَعْقُوبُ بْنُ عَبَّادٍ الْمَكِّيُّ ، قَالَ :  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لِلشَّهِيدِ سِتُّ خِصَالٍ : يُغْفَرُ لَهُ بِأَوَّلِ دَفْعَةٍ مِنْ دَمِهِ  ، وَيُؤَمَّنُ مِنَ الْفَزَعِ ، وَيَرَى مَقْعَدَهُ مِنَ الْجَنَّةِ ، وَيُزَوَّجُ مِنَ  الْحُورِ  الْعِينِ  ، وَيُجَارُ مِنْ عَذَابِ الْقَبْرِ .","","Al-Mu'jam al-Kabir 14651","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن إسماعيل بن عياش الأحول عن يعقوب بن إسحاق القلزمي عن يوسف بن يزيد القراطيسي عن الطبراني","أبو عبد الرحمن الحبلي"
"14691","14652  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ، قَالَ :  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ، قَالَ :  حَدَّثَنِي  ابْنُ الْمُبَارَكِ ،  عَنْ  يَحْيَى بْنِ أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ مُحَمَّدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  تَجَشَّأَ  رَجُلٌ  عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  اقْصِرْ مِنْ جُشَائِكَ ، فَإِنَّ أَطْوَلَ النَّاسِ جُوعًا يَوْمَ الْقِيَامَةِ أَشْبَعُهُمْ فِي الدُّنْيَا  .","","Al-Mu'jam al-Kabir 14652","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن محمد بن محمد عن يحيى بن أيوب المقابري عن عبد الله بن المبارك عن نعيم بن حماد الخزاعي عن يوسف بن يزيد القراطيسي عن الطبراني","أبو عبد الرحمن الحبلي"
"14692","[14/58]      14653  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَالِمٍ الرَّازِيُّ ، قَالَ :  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ، قَالَ :  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَفْضَلُ الصَّدَقَةِ إِصْلَاحُ ذَاتِ الْبَيْنِ  .","","Al-Mu'jam al-Kabir 14653","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن مروان بن معاوية الفزاري عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","أبو عبد الرحمن الحبلي"
"14693","14654  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عِقَالٍ الْحَرَّانِيُّ ، قَالَ :  ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ، قَالَ :  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ نَظَرَ إِلَى مُسْلِمٍ نَظْرَةً يُخِيفُهُ بِهَا فِي غَيْرِ حَقٍّ ، أَخَافَهُ اللهُ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 14654","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عيسى بن يونس بن أبي إسحاق عن عبد الله بن محمد النفيلي عن أحمد بن عبد الرحمن بن يزيد الحراني عن الطبراني","أبو عبد الرحمن الحبلي"
"14694","[14/59]      14655  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سُلَيْمَانَ بْنِ أَبِي الْجَوْنِ ، قَالَا :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  سِتُّ مَجَالِسَ الْمُؤْمِنُ ضَامِنٌ         [14/60]      عَلَى اللهِ مَا كَانَ فِي شَيْءٍ مِنْهَا  : فِي مَسْجِدِ جَمَاعَةٍ ، وَعِنْدَ مَرِيضٍ ، أَوْ فِي جِنَازَتِهِ أَوْ فِي بَيْتِهِ ، أَوْ عِنْدَ إِمَامٍ مُقْسِطٍ  يُعَزِّرُهُ  وَيُوَقِّرُهُ .","","Al-Mu'jam al-Kabir 14655","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الرحمن بن سليمان الداراني عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","أبو عبد الرحمن الحبلي"
"14695","14656  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سُلَيْمَانَ بْنِ أَبِي الْجَوْنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْعِلْمُ ثَلَاثَةٌ - مَا سِوَى ذَلِكَ فَضْلٌ - : آيَةٌ مُحْكَمَةٌ ، وَسُنَّةٌ  قَائِمَةٌ  ،  وَفَرِيضَةٌ  عَادِلَةٌ  .","","Al-Mu'jam al-Kabir 14656","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الرحمن بن سليمان الداراني عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","أبو عبد الرحمن الحبلي"
"14696","[14/61]      14657  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ، قَالَ :  ثَنَا  أَبِي ،  قَالَ :  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  التَّسْبِيحُ نِصْفُ الْمِيزَانِ ، وَالْحَمْدُ لِلهِ تَمْلَأُ الْمِيزَانَ  ، وَلَا إِلَهَ إِلَّا اللهُ لَيْسَ لَهَا سِتْرٌ حَتَّى تَخْلُصَ إِلَى الرَّحْمَنِ عَزَّ وَجَلَّ .","","Al-Mu'jam al-Kabir 14657","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عيسى بن يونس بن أبي إسحاق عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","أبو عبد الرحمن الحبلي"
"14697","14658  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ، قَالَ :  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  إِنَّ أَسْرَعَ الدُّعَاءِ إِجَابَةً دَعْوَةُ غَائِبٍ لِغَائِبٍ  .","","Al-Mu'jam al-Kabir 14658","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14698","[14/62]      14659  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ كَثِيرٍ ، قَالَ :  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادِ بْنِ أَنْعُمَ الْإِفْرِيقِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ شَيْءٌ أَسْرَعَ إِجَابَةً مِنْ دَعْوَةِ غَائِبٍ لِغَائِبٍ  .","","Al-Mu'jam al-Kabir 14659","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عيسى بن يونس بن أبي إسحاق عن علي بن كثير عن الحسين بن إسحاق التستري عن الطبراني","أبو عبد الرحمن الحبلي"
"14699","14660  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  الْمُقْرِئُ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ، قَالَ :  ثَنَا  حَرْمَلَةُ بْنُ يَحْيَى ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَا  يَتَعَاظَمُهُ  ذَنْبٌ غَفَرَهُ  .  إِنَّ رَجُلًا مِمَّنْ كَانَ قَبْلَكُمْ قَتَلَ ثَمَانِيًا         [14/63]      وَتِسْعِينَ نَفْسًا ، فَأَتَى رَاهِبًا ، فَقَالَ : إِنِّي قَتَلْتُ ثَمَانِيَ وَتِسْعِينَ نَفْسًا ، فَهَلْ تَجِدُ لِي مِنْ تَوْبَةٍ ؟ فَقَالَ لَهُ : قَدْ أَسْرَفْتَ ، فَقَامَ إِلَيْهِ فَقَتَلَهُ . ثُمَّ أَتَى رَاهِبًا آخَرَ ، فَقَالَ : إِنِّي قَتَلْتُ تِسْعَةً وَتِسْعِينَ نَفْسًا فَهَلْ تَجِدُ لِي مِنْ تَوْبَةٍ ؟ قَالَ : لَا ، قَدْ أَسْرَفْتَ ، فَقَامَ إِلَيْهِ فَقَتَلَهُ ، ثُمَّ أَتَى رَاهِبًا آخَرَ ، فَقَالَ : إِنِّي قَتَلْتُ مِائَةَ نَفْسٍ فَهَلْ تَجِدُ لِي مِنْ تَوْبَةٍ ؟ قَالَ : قَدْ أَسْرَفْتَ ، وَمَا أَدْرِي ، وَلَكِنْ هَهُنَا قَرْيَتَانِ ، قَرْيَةٌ يُقَالُ لَهَا : نَضْرَةُ ، وَالْأُخْرَى يُقَالُ لَهَا : كَفْرَةُ ، فَأَمَّا نَضْرَةُ فَيَعْمَلُونَ عَمَلَ الْجَنَّةِ ، لَا يَثْبُتُ فِيهَا غَيْرُهُمْ ، وَأَمَّا كَفْرَةُ فَيَعْمَلُونَ عَمَلَ أَهْلِ النَّارِ ، لَا يَثْبُتُ فِيهَا غَيْرُهُمْ ، فَانْطَلِقْ إِلَى نَضْرَةَ ، فَإِنْ ثَبَتَّ فِيهَا وَعَمِلْتَ مِثْلَ أَهْلِهَا فَلَا شَكَّ فِي تَوْبَتِكَ .  فَانْطَلَقَ يُرِيدُهَا ، حَتَّى إِذَا كَانَ بَيْنَ الْقَرْيَتَيْنِ أَدْرَكَهُ الْمَوْتُ ، فَسَأَلَتِ الْمَلَائِكَةُ رَبَّهَا عَنْهُ ؟ فَقَالَ : انْظُرُوا إِلَى أَيِّ الْقَرْيَتَيْنِ كَانَ أَقْرَبَ ، فَاكْتُبُوهُ مِنْ أَهْلِهَا ، فَوَجَدُوهُ أَقْرَبَ إِلَى نَضْرَةَ بِقِيدِ أُنْمُلَةٍ ، فَكُتِبَ مِنْ أَهْلِهَا  .","","Al-Mu'jam al-Kabir 14660","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن الحسين بن إسحاق التستري عن الطبراني","أبو عبد الرحمن الحبلي"
"14700","14661  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ         [14/64]      الْمُقْرِئُ ،  عَنْ  حَيْوَةَ بْنِ شُرَيْحٍ ، وَابْنِ لَهِيعَةَ ،  أَخْبَرَنَا  أَبُو هَانِئٍ حُمَيْدُ بْنُ هَانِئٍ الْخَوْلَانِيُّ ،  أَنَّهُ سَمِعَ  أَبَا عَبْدِ الرَّحْمَنِ الْحُبُلِيَّ ، يَقُولُ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو ، يَقُولُ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  مَا مِنْ  غَازِيَةٍ  تَغْزُو فِي  سَبِيلِ  اللهِ يُصِيبُونَ غَنِيمَةً ، إِلَّا تَعَجَّلُوا ثُلُثَيْ أُجُورِهِمْ  ، وَيَبْقَى الثُّلُثُ ، فَإِنْ لَمْ يُصِيبُوا غَنِيمَةً تَمَّ لَهُمْ أَجْرُهُمْ  .","","Al-Mu'jam al-Kabir 14661","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حميد بن هانئ الخولاني عن عبد الله بن لهيعة عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","أبو عبد الرحمن الحبلي"
"14701","14662  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ، قَالَ :  أَنَا  نَافِعُ بْنُ يَزِيدَ ،  حَدَّثَنِي  أَبُو هَانِئٍ ، قَالَ :  حَدَّثَنِي  أَبُو عَبْدِ الرَّحْمَنِ الْحُبُلِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14662","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حميد بن هانئ الخولاني عن نافع بن يزيد الكلاعي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","أبو عبد الرحمن الحبلي"
"14702","[14/65]      14663  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْمُقْرِئُ ،  عَنْ  حَيْوَةَ بْنِ شُرَيْحٍ ، قَالَ :  حَدَّثَنِي  أَبُو هَانِئٍ ،  أَنَّهُ سَمِعَ  أَبَا عَبْدِ الرَّحْمَنِ ، يَقُولُ :  إِنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عَمْرٍو ، يَقُولُ : إِنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  إِنَّ قُلُوبَ بَنِي آدَمَ كُلَّهَا بَيْنَ إِصْبَعَيْنِ مِنْ أَصَابِعِ الرَّحْمَنِ كَقَلْبٍ وَاحِدٍ  ، يُصَرِّفُهَا حَيْثُ شَاءَ ، ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : اللَّهُمَّ مُصَرِّفَ الْقُلُوبِ ، صَرِّفْ قَلْبِي إِلَى طَاعَتِكَ  .","","Al-Mu'jam al-Kabir 14663","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حميد بن هانئ الخولاني عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","أبو عبد الرحمن الحبلي"
"14703","[14/66]      14664  -  حَدَّثَنَا  هَارُونُ ، قَالَ :  ثَنَا  الْمُقْرِئُ ، قَالَ :  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ ،  عَنْ  أَبِي هَانِئٍ ،  عَنِ  الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ عَزَّ وَجَلَّ قَدَّرَ الْمَقَادِيرَ قَبْلَ أَنْ يَخْلُقَ السَّمَاوَاتِ وَالْأَرْضَ بِخَمْسِينَ أَلْفَ سَنَةٍ  .","","Al-Mu'jam al-Kabir 14664","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حميد بن هانئ الخولاني عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو عبد الرحمن الحبلي"
"14704","[14/67]      14665  -  حَدَّثَنَا  يَحْيَى الْعَلَّافُ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ، قَالَ :  ثَنَا  نَافِعُ بْنُ يَزِيدَ ، وَاللَّيْثُ بْنُ سَعْدٍ ، قَالَا :  ثَنَا  أَبُو هَانِئٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  فَرَغَ اللهُ مِنَ الْمَقَادِيرِ وَأُمُورِ الدُّنْيَا قَبْلَ أَنْ يَخْلُقَ السَّمَاوَاتِ وَالْأَرْضَ بِخَمْسِينَ أَلْفَ سَنَةٍ  .  وَلَمْ يَذْكُرِ  اللَّيْثُ  : "" أُمُورِ الدُّنْيَا "" ، إِلَّا أَنَّهُ قَالَ : "" مَقَادِيرِ كُلِّ شَيْءٍ  .","","Al-Mu'jam al-Kabir 14665","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حميد بن هانئ الخولاني عن نافع بن يزيد الكلاعي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","أبو عبد الرحمن الحبلي"
"14705","[14/68]      14666  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ، قَالَ :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ، قَالَ :  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ، قَالَ :  ثَنَا  خَالِدُ بْنُ حُمَيْدٍ الْمَهْرِيُّ ، قَالَ :  ثَنَا  حُمَيْدُ بْنُ هَانِئٍ الْخَوْلَانِيُّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيَأْتِيَنَّ عَلَى النَّاسِ زَمَانٌ قُلُوبُهُمْ قُلُوبُ الْعَجَمِ  . قُلْتُ : وَمَا قُلُوبُ الْعَجَمِ ؟ قَالَ : حُبُّ الدُّنْيَا ، سُنَّتُهُمْ سُنَّةُ الْأَعْرَابِ ، مَا أَتَاهُمْ مِنْ رِزْقٍ جَعَلُوهُ فِي الْحَيَوَانِ ، يَرَوْنَ  الْجِهَادَ  ضَرَرًا ، وَالزَّكَاةَ  مَغْرَمًا  .","","Al-Mu'jam al-Kabir 14666","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حميد بن هانئ الخولاني عن خالد بن حميد المهري عن بقية بن الوليد عن هشام بن عمار عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","أبو عبد الرحمن الحبلي"
"14706","14667  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ الْمِصْرِيُّ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  أَبُو هَانِئٍ حُمَيْدُ         [14/69]      بْنُ هَانِئٍ ،  أَنَّهُ سَمِعَ  أَبَا عَبْدِ الرَّحْمَنِ ،  يُحَدِّثُ عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  إِنَّ فُقَرَاءَ الْمُهَاجِرِينَ يَسْبِقُونَ الْأَغْنِيَاءَ يَوْمَ الْقِيَامَةِ بِأَرْبَعِينَ  خَرِيفًا  .","","Al-Mu'jam al-Kabir 14667","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حميد بن هانئ الخولاني عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف المصري عن الطبراني","أبو عبد الرحمن الحبلي"
"14707","14668  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  ثَنَا  حَرْمَلَةُ بْنُ يَحْيَى ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ قَالَ :  أَخْبَرَنِي  عَبْدُ الرَّحْمَنِ بْنُ مَيْسَرَةَ الْحَضْرَمِيُّ ،  عَنْ  أَبِي هَانِئٍ الْخَوْلَانِيِّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الْإِيمَانَ لَيَخْلَقُ فِي جَوْفِ أَحَدِكُمْ كَمَا يَخْلَقُ الثَّوْبُ الْخَلَقُ ، [فَسَلُوا اللهَ أَنْ] يُجَدِّدَ الْإِيمَانَ فِي قُلُوبِكُمْ  .","","Al-Mu'jam al-Kabir 14668","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حميد بن هانئ الخولاني عن عبد الرحمن بن ميسرة الحمصي عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن الحسين بن إسحاق التستري عن الطبراني","أبو عبد الرحمن الحبلي"
"14708","14669  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  ثَنَا  حَرْمَلَةُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  عَبْدُ الرَّحْمَنِ بْنُ مَيْسَرَةَ ،  عَنْ  أَبِي هَانِئٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  سَمِعْتُ         [14/70]      رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَلَا هَذِهِ الْآيَةَ :         {      يَوْمَ يَقُومُ النَّاسُ لِرَبِّ الْعَالَمِينَ         }      فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَيْفَ بِكُمْ إِذَا جَمَعَكُمُ اللهُ جَلَّ وَعَزَّ كَمَا يُجْمَعُ النَّبْلُ فِي الْكِنَانَةِ خَمْسِينَ أَلْفَ سَنَةٍ لَا يَنْظُرُ إِلَيْكُمْ  .","","Al-Mu'jam al-Kabir 14669","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حميد بن هانئ الخولاني عن عبد الرحمن بن ميسرة المصري عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن الحسين بن إسحاق التستري عن الطبراني","أبو عبد الرحمن الحبلي"
"14709","14670  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  حُيَيُّ بْنُ عَبْدِ اللهِ الْمَعَافِرِيُّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ [خَرَجَ]  يَوْمَ الْخَنْدَقِ  وَهُمْ يُخَنْدِقُونَ حَوْلَ  الْمَدِينَةِ  ، فَتَنَاوَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْفَأْسَ ، فَضَرَبَ ضَرْبَةً ، فَقَالَ :  بِهَذِهِ الضَّرْبَةِ يَفْتَحُ اللهُ كُنُوزَ  الرُّومِ  ، ثُمَّ ضَرَبَ الثَّانِيَةَ ، وَقَالَ : بِهَذِهِ يَفْتَحُ اللهُ كُنُوزَ  فَارِسَ  ،         [14/71]      ثُمَّ ضَرَبَ الثَّالِثَةَ ، فَقَالَ : بِهَذِهِ الضَّرْبَةِ يَأْتِي اللهُ  بِأَهْلِ الْيَمَنِ  أَنْصَارًا وَأَعْوَانًا  .","","Al-Mu'jam al-Kabir 14670","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف عن الطبراني","أبو عبد الرحمن الحبلي"
"14710","14671  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنَا  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  نَزَلَتْ :         {      إِذَا زُلْزِلَتِ الأَرْضُ زِلْزَالَهَا         }      وَأَبُو بَكْرٍ الصِّدِّيقُ  رَضِيَ اللهُ عَنْهُ قَاعِدٌ ، فَبَكَى  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا يُبْكِيكَ يَا  أَبَا بَكْرٍ  ؟ قَالَ : أَبْكَتْنِي هَذِهِ السُّورَةُ  . فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لَوْ أَنَّكُمْ لَا تُخْطِئُونَ وَلَا تُذْنِبُونَ لَخَلَقَ اللهُ مِنْ بَعْدِكُمْ أُمَّةً يُذْنِبُونَ وَيُخْطِئُونَ ، فَيَغْفِرُ لَهُمْ .","","Al-Mu'jam al-Kabir 14671","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف عن الطبراني","أبو عبد الرحمن الحبلي"
"14711","14672  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي         [14/72]      عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الصِّيَامُ وَالْقُرْآنُ يَوْمَ الْقِيَامَةِ يَشْفَعَانِ لِلْعَبْدِ  ، يَقُولُ الصِّيَامُ : رَبِّ ، مَنَعْتُهُ الطَّعَامَ وَالشَّرَابَ بِالنَّهَارِ ، فَشَفِّعْنِي فِيهِ ، وَيَقُولُ الْقُرْآنُ : رَبِّ مَنَعْتُهُ النَّوْمَ بِاللَّيْلِ ، فَشَفِّعْنِي فِيهِ ، فَيُشَفَّعَانِ .","","Al-Mu'jam al-Kabir 14672","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف عن الطبراني","أبو عبد الرحمن الحبلي"
"14712","14673  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ، قَالَ :  ثَنَا  عَمْرُو بْنُ خَالِدٍ ، قَالَ :  ثَنَا  عُمَرُ وَابْنُ لَهِيعَةَ ،  عَنْ  حُيَيِّ بْنِ عَبْدِ اللهِ (  ح  ) .  وَحَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  قُرِئَ عَلَى  ابْنِ وَهْبٍ :  أَخْبَرَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا رَكَعَ رَكْعَتَيِ الْفَجْرِ اضْطَجَعَ عَلَى شِقِّهِ الْأَيْمَنِ  .","","Al-Mu'jam al-Kabir 14673","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف عن الطبراني","أبو عبد الرحمن الحبلي"
"14713","[14/73]      14674  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ عُتْبَةَ (  ح  ) .  وَحَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَا :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  حُيَيُّ بْنُ عَبْدِ اللهِ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  تُوُفِّيَ  رَجُلٌ  بِالْمَدِينَةِ  ، فَصَلَّى عَلَيْهِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ قَالَ :  يَا لَيْتَهُ مَاتَ فِي غَيْرِ مَوْلِدِهِ  ، فَقَالَ  رَجُلٌ  : لِمَ يَا رَسُولَ اللهِ ؟ فَقَالَ : إِنَّ الرَّجُلَ إِذَا مَاتَ فِي غَيْرِ مَوْلِدِهِ ، قِيسَ لَهُ مَوْلِدُهُ إِلَى مُنْقَطَعِ  أَثَرِهِ  فِي الْجَنَّةِ .","","Al-Mu'jam al-Kabir 14674","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن عن الطبراني","أبو عبد الرحمن الحبلي"
"14714","14675  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلْيُكْرِمْ ضَيْفَهُ  ، وَمَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلْيَقُلْ خَيْرًا أَوْ لِيَصْمُتْ ، وَمَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلْيُكْرِمْ جَارَهُ .","","Al-Mu'jam al-Kabir 14675","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن عن الطبراني","أبو عبد الرحمن الحبلي"
"14715","[14/74]      14676  -  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنَا  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَدْعُو ، يَقُولُ : اللَّهُمَّ اغْفِرْ لَنَا ذُنُوبَنَا  ، وَظُلْمَنَا ، وَهَزْلَنَا ، وَجِدَّنَا ، وَعَمْدَنَا ، وَكُلَّ ذَلِكَ عِنْدَنَا  .","","Al-Mu'jam al-Kabir 14676","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل عن الطبراني","أبو عبد الرحمن الحبلي"
"14716","14677  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ ، قَالَ :  ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  حُيَيِّ بْنِ عَبْدِ اللهِ (  ح  ) .  وَحَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،         [14/75]      أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَدْعُو بِهَؤُلَاءِ الْكَلِمَاتِ : اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ غَلَبَةِ الدَّيْنِ  ، وَغَلَبَةِ الْعَدُوِّ ،  وَشَمَاتَةِ  الْأَعْدَاءِ  .","","Al-Mu'jam al-Kabir 14677","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن روح بن الفرج القطان عن الطبراني","أبو عبد الرحمن الحبلي"
"14717","14678  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ حِينَ يُرِيدُ أَنْ يَنَامَ :  اللَّهُمَّ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ ، عَالِمَ الْغَيْبِ وَالشَّهَادَةِ  ، رَبَّ كُلِّ شَيْءٍ وَإِلَهَ كُلِّ شَيْءٍ ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ ، وَحْدَكَ لَا شَرِيكَ لَكَ ، وَأَنَّ  مُحَمَّدًا  عَبْدُكَ وَرَسُولُكَ ، وَالْمَلَائِكَةُ يَشْهَدُونَ ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الشَّيْطَانِ  وَشِرْكِهِ ،  وَأَعُوذُ بِكَ أَنْ أَقْتَرِفَ عَلَى نَفْسِي إِثْمًا ، أَوْ أَرُدَّهُ إِلَى مُسْلِمٍ .","","Al-Mu'jam al-Kabir 14678","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن عن الطبراني","أبو عبد الرحمن الحبلي"
"14718","14679  -  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  ثَنَا  أَحْمَدُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،  أَنَّ         [14/76]      رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَرَجَ  يَوْمَ بَدْرٍ  فِي ثَلَاثِمِائَةٍ وَخَمْسَةٍ وَعِشْرِينَ مِنَ الْمُقَاتِلَةِ ، كَمَا خَرَجَ  طَالُوتُ  ، فَدَعَا لَهُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ خَرَجُوا :  اللَّهُمَّ إِنَّهُمْ حُفَاةٌ فَاحْمِلْهُمُ ، اللَّهُمَّ إِنَّهُمْ عُرَاةٌ فَاكْسُهُمُ ، اللَّهُمَّ إِنَّهُمْ جِيَاعٌ فَأَشْبِعْهُمْ ، فَفَتَحَ اللهُ لَهُ  بَدْرًا  ، وَانْقَلَبُوا حِينَ انْقَلَبُوا وَمَا مِنْهُمْ رَجُلٌ إِلَّا وَقَدْ رَجَعَ بِجَمَلٍ ، أَوْ جَمَلَيْنِ ، وَاكْتَسَوْا وَشَبِعُوا  .","","Al-Mu'jam al-Kabir 14679","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل عن الطبراني","أبو عبد الرحمن الحبلي"
"14719","14680  -  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  ثَنَا  أَحْمَدُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْإِيمَانُ  يَمَانٍ  ، وَهُمْ مِنِّي وَإِلَيَّ ، وَإِنْ بَعُدَ مِنْهُمُ الْمَرْبَعُ ،  وَيُوشِكُ  أَنْ يَأْتُوكُمْ أَنْصَارًا وَأَعْوَانًا ، فَآمُرُكُمْ بِهِمْ خَيْرًا  .","","Al-Mu'jam al-Kabir 14680","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن عبد الله سمويه عن الطبراني","أبو عبد الرحمن الحبلي"
"14720","14681  -  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،  أَنَّ  امْرَأَةً  أَتَتِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَتْ : إِنَّ زَوْجِي مِسْكِينٌ لَا يَقْدِرُ عَلَى شَيْءٍ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِزَوْجِهَا :  أَتَقْرَأُ مِنَ الْقُرْآنِ شَيْئًا ؟  قَالَ : أَقْرَأُ سُورَةَ كَذَا ، وَسُورَةَ كَذَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بَخٍ  !  بَخٍ  ! زَوْجُكِ غَنِيٌّ ، فَالْزَمِيهِ .  فَلَزِمَتِ الْمَرْأَةُ زَوْجَهَا ، ثُمَّ أَتَتِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَتْ : يَا نَبِيَّ اللهِ قَدْ بَسَطَ اللهُ عَلَيْنَا وَرَزَقَنَا  .","","Al-Mu'jam al-Kabir 14681","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل عن الطبراني","أبو عبد الرحمن الحبلي"
"14721","[14/77]      14682  -  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  ثَنَا  أَحْمَدُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  جَاءَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَبْعُ رِجَالٍ ، فَأَخَذَ كُلُّ رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَجُلًا ، وَأَخَذَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَجُلًا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا اسْمُكَ ؟ قَالَ :  أَبُو غَزْوَانَ  ، قَالَ : فَحَلَبَ لَهُ سَبْعَ  شِيَاهٍ  ، فَشَرِبَ لَبَنَهَا  كُلَّهُ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : هَلْ لَكَ يَا  أَبَا غَزْوَانَ  أَنْ تُسْلِمَ ؟         [14/78]      قَالَ : نَعَمْ ، فَأَسْلَمَ ، فَمَسَحَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَدْرَهُ ، فَلَمَّا أَصْبَحَ حَلَبَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ شَاةً وَاحِدَةً ، فَلَمْ يُتِمَّ لَبَنَهَا ، فَقَالَ : مَا لَكَ يَا  أَبَا غَزْوَانَ  ؟ فَقَالَ : وَالَّذِي بَعَثَكَ نَبِيًّا لَقَدْ رُوِيتُ . قَالَ : إِنَّكَ أَمْسِ كَانَ لَكَ سَبْعَةُ أَمْعَاءٍ ، وَلَيْسَ لَكَ الْيَوْمَ إِلَّا وَاحِدٌ .","","Al-Mu'jam al-Kabir 14682","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل عن الطبراني","أبو عبد الرحمن الحبلي"
"14722","14683  -  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ  رَاحَ  إِلَى مَسْجِدِ الْجَمَاعَةِ ، فَخُطْوَةٌ تَمْحُو سَيِّئَةً ، وَخُطْوَةٌ تَكْتُبُ لَهُ حَسَنَةً ، ذَاهِبًا وَرَاجِعًا  .","","Al-Mu'jam al-Kabir 14683","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل عن الطبراني","أبو عبد الرحمن الحبلي"
"14723","14684  -  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  بَعَثَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَرِيَّةً ، فَغَنِمُوا وَأَسْرَعُوا الرَّجْعَةَ ، فَتَحَدَّثَ النَّاسُ بِقُرْبِ مَغْزَاهُمْ وَكَثْرَةِ غَنِيمَتِهِمْ وَسُرْعَةِ رَجْعَتِهِمْ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَا أَدُلُّكُمْ عَلَى أَقْرَبَ مِنْهُمْ مَغْزًى ، وَأَكْثَرَ غَنِيمَةً ، وَأَوْشَكَ رَجْعَةً ؟  مَنْ تَوَضَّأَ ثُمَّ غَدَا إِلَى الْمَسْجِدِ لِسُبْحَةِ الصُّبْحِ ، فَهُوَ أَقْرَبُ مَغْزًى ، وَأَكْثَرُ غَنِيمَةً ،  وَأَوْشَكُ  رَجْعَةً .","","Al-Mu'jam al-Kabir 14684","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل عن الطبراني","أبو عبد الرحمن الحبلي"
"14724","[14/79]      14685  -  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  ثَنَا  أَحْمَدُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو :  أَنَّ  رَجُلًا  قَالَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّ الْمُؤَذِّنِينَ يَفْضُلُونَنَا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قُلْ كَمَا يَقُولُونَ ، وَإِذَا انْتَهَيْتَ فَسَلْ تُعْطَهْ  .","","Al-Mu'jam al-Kabir 14685","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل عن الطبراني","أبو عبد الرحمن الحبلي"
"14725","14686  -  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  عَبْدُ اللهِ بْنُ وَهْبٍ ،  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  لَمَّا غَزَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  غَزْوَةَ تَبُوكَ  ، أَدْلَجَ بِهِمْ حَتَّى كَانَ مَعَ السَّحَرِ ، ثُمَّ نَزَلَ بِهِمْ سَحَرًا ، فَقَالَ :  يَا  بِلَالُ  ، احْرُسْ لَنَا الصَّلَاةَ  ، قَالَ : نَعَمْ يَا رَسُولَ اللهِ ، فَغَلَبَ  بِلَالً  النَّوْمُ فَرَقَدَ ، فَنَامُوا         [14/80]      حَتَّى أَوْجَعَتْهُمُ الشَّمْسُ ، فَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَتَيَمَّمَ ، فَقَالَ  لِبِلَالٍ  : أَذِّنْ وَأَقِمْ ، فَقَالَ  بِلَالٌ  : الْآنَ ؟ قَالَ : نَعَمْ ، فَصَلَّوْا بَعْدَمَا أَصْبَحُوا .","","Al-Mu'jam al-Kabir 14686","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل عن الطبراني","أبو عبد الرحمن الحبلي"
"14726","14687  -  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  ثَنَا  أَحْمَدُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ فِي الْجَنَّةِ غُرَفً يُرَى ظَاهِرُهَا مِنْ بَاطِنِهَا وَبَاطِنُهَا مِنْ ظَاهِرِهَا  ، قَالَ  أَبُو مَالِكٍ الْأَشْعَرِيُّ  : لِمَنْ هِيَ يَا رَسُولَ اللهِ ؟ قَالَ : لِمَنْ أَلَانَ الْكَلَامَ ، وَأَطْعَمَ الطَّعَامَ ، وَبَاتَ قَائِمًا وَالنَّاسُ نِيَامٌ .","","Al-Mu'jam al-Kabir 14687","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل عن الطبراني","أبو عبد الرحمن الحبلي"
"14727","14688  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ         [14/81]      عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  أَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَجُلًا  يُصَلِّي بِالنَّاسِ صَلَاةَ الظُّهْرِ ،  فَتَفَلَ  فِي الْقِبْلَةِ وَهُوَ يُصَلِّي لِلنَّاسِ ، فَلَمَّا كَانَ صَلَاةُ الْعَصْرِ أَرْسَلَ إِلَى  آخَرَ  ، فَأَشْفَقَ الرَّجُلُ الْأَوَّلُ ، فَجَاءَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، أَنَزَلَ فِيَّ ؟ قَالَ :  لَا ، وَلَكِنَّكَ  تَفَلْتَ  بَيْنَ يَدَيْكَ ، وَأَنْتَ تَؤُمُّ النَّاسَ ، فَآذَيْتَ اللهَ وَمَلَائِكَتَهُ  .","","Al-Mu'jam al-Kabir 14688","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن عن الطبراني","أبو عبد الرحمن الحبلي"
"14728","14689  -  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  ثَنَا  أَحْمَدُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  جَاءَ  رَجُلٌ  ، فَقَالَ : يَا رَسُولَ اللهِ إِنَّ أَبِي يَذْبَحُ قَبْلَ أَنْ يُصَلِّيَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قُلْ لِأَبِيكَ يُصَلِّي ، ثُمَّ يَذْبَحُ  .","","Al-Mu'jam al-Kabir 14689","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن محمد بن عبيد الله العذري عن الطبراني","أبو عبد الرحمن الحبلي"
"14729","14690  -  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  ثَنَا  أَحْمَدُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو :  أَنَّ النَّبِيَّ         [14/82]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَكَرَ فَتَّانَ الْقَبْرِ ، فَقَالَ  عُمَرُ بْنُ الْخَطَّابِ  : أَتُرَدُّ عُقُولُنَا عَلَيْنَا يَا رَسُولَ اللهِ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  نَعَمْ كَهَيْئَتِكُمُ الْيَوْمَ ، فَقَالَ  عُمَرُ  : بِعَيْنِهِ الْحَجَرُ  .","","Al-Mu'jam al-Kabir 14690","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل عن الطبراني","أبو عبد الرحمن الحبلي"
"14730","14691  -  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  ثَنَا  أَحْمَدُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا جَاءَ الرَّجُلُ يَعُودُ مَرِيضًا فَلْيَقُلِ : اللَّهُمَّ اشْفِ عَبْدَكَ فُلَانًا ،  يُنْكِي  لَكَ عَدُوًّا ، أَوْ يَمْشِي لَكَ إِلَى صَلَاةٍ  .","","Al-Mu'jam al-Kabir 14691","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل عن الطبراني","أبو عبد الرحمن الحبلي"
"14731","14692  -  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  ثَنَا  أَحْمَدُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ،         [14/83]      قَالَ :  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، ائْذَنْ لِي أَنْ أَخْتَصِيَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خِصَاءُ أُمَّتِي : الصِّيَامُ وَالْقِيَامُ  .","","Al-Mu'jam al-Kabir 14692","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل عن الطبراني","أبو عبد الرحمن الحبلي"
"14732","14693  -  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  ثَنَا  أَحْمَدُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  سَارَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَنَزَلَ بِأَصْحَابِهِ ، وَإِذَا نَاسٌ قَدْ جَعَلُوا  عَرِيشًا  عَلَى صَاحِبِهِمْ وَهُوَ صَائِمٌ ، فَمَرَّ بِهِمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : مَا  شَأْنُ  صَاحِبِكُمْ ؟ أَوَجِعٌ هُوَ ؟ قَالُوا : لَا يَا رَسُولَ اللهِ ، وَلَكِنَّهُ صَائِمٌ - وَذَلِكَ فِي يَوْمٍ حَرُورٍ - فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا بِرَّ أَنْ يُصَامَ فِي السَّفَرِ  .","","Al-Mu'jam al-Kabir 14693","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل عن الطبراني","أبو عبد الرحمن الحبلي"
"14733","[14/84]      14694  -  حَدَّثَنَا  عَلِيُّ بْنُ مُحَمَّدٍ الْأَنْصَنَاوِيُّ ، قَالَ :  ثَنَا  حَرْمَلَةُ بْنُ يَحْيَى ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  حُيَيٌّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى الظُّهْرَ فَوَجَدَ رَاحِلَةً مَعْقُولَةً ، فَقَالَ :  أَيْنَ صَاحِبُ هَذِهِ الرَّاحِلَةِ ؟  فَلَمْ يَسْتَجِبْ لَهُ أَحَدٌ ، فَدَخَلَ الْمَسْجِدَ فَصَلَّى ، حَتَّى إِذَا فَرَغَ خَرَجَ ، فَوَجَدَ الرَّاحِلَةَ كَمَا هِيَ ، فَقَالَ : أَيْنَ صَاحِبُ هَذِهِ الرَّاحِلَةِ ؟ فَاسْتَجَابَ لَهُ صَاحِبُهَا ، فَقَالَ : أَنَا - يَا نَبِيَّ اللهِ - صَاحِبُهَا ، فَقَالَ : أَلَا تَتَّقِي اللهَ فِيهَا ؟ إِمَّا أَنْ تَعْلِفَهَا ، وَإِمَّا أَنْ تُرْسِلَهَا حَتَّى تَبْتَغِيَ لِنَفْسِهَا  .","","Al-Mu'jam al-Kabir 14694","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن علي بن محمد الأنصناوي عن الطبراني","أبو عبد الرحمن الحبلي"
"14734","14695  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ ،  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ زِبْرِيقٍ الْحِمْصِيُّ ، قَالَ :  ثَنَا  عُثْمَانُ بْنُ سَعِيدِ بْنِ كَثِيرِ بْنِ دِينَارٍ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  حُيَيِّ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِي         [14/85]      عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا طَلَعَتِ الشَّمْسُ مِنْ مَغْرِبِهَا خَرَّ إِبْلِيسُ سَاجِدًا يُنَادِي وَيَجْهَرُ : إِلَهِي ، مُرْنِي بِالسُّجُودِ لِمَنْ شِئْتَ  ، قَالَ : فَتَجْتَمِعُ إِلَيْهِ زَبَانِيَتُهُ ، فَتَقُولُ : يَا سَيِّدَهُمْ ، مَا هَذَا التَّضَرُّعُ ؟ فَيَقُولُ : إِنَّمَا سَأَلْتُ رَبِّي جَلَّ وَعَزَّ أَنْ يُنْظِرَنِي إِلَى الْوَقْتِ الْمَعْلُومِ ، وَهَذَا الْوَقْتُ الْمَعْلُومُ . قَالَ : ثُمَّ تَخْرُجُ دَابَّةُ الْأَرْضِ مِنْ صَدْعٍ فِي  الصَّفَا  . قَالَ : فَأَوَّلُ خُطْوَةٍ تَضَعُهَا  بِأَنْطَاكِيَّةَ  ، فَتَأْتِي إِبْلِيسَ فَتَلْطِمُهُ  .","","Al-Mu'jam al-Kabir 14695","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن لهيعة عن عثمان بن سعيد بن كثير عن إسحاق بن إبراهيم بن العلاء عن أحمد بن يحيى بن خالد الرقي عن الطبراني","أبو عبد الرحمن الحبلي"
"14735","14696  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ الدِّمَشْقِيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ خَالِدٍ الدِّمَشْقِيُّ ، قَالَ :  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  حُيَيِّ بْنِ عَبْدِ اللهِ الْمَعَافِرِيِّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  بَدْرٍ  فِي ثَلَاثِمِائَةٍ وَخَمْسَةَ عَشَرَ كَعِدَّةِ أَصْحَابِ  طَالُوتَ  ، فَلَمَّا بَرَزُوا رَآهُمْ         [14/86]      رَجَّالَةً حُفَاةً عُرَاةً ، فَقَالَ :  اللَّهُمَّ إِنَّهُمْ جِيَاعٌ فَأَشْبِعْهُمْ ، وَرَجَّالَةٌ فَاحْمِلْهُمْ ، وَعُرَاةٌ فَاكْسُهُمْ  . فَرَجَعُوا مِنْ  بَدْرٍ  وَمَا مِنْهُمْ أَحَدٌ إِلَّا وَهُوَ آخِذٌ بِرَأْسِ جَمَلٍ أَوْ جَمَلَيْنِ ، وَاكْتَسَوْا ، وَشَبِعُوا .","","Al-Mu'jam al-Kabir 14696","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن عبد الله بن لهيعة عن الوليد بن مسلم القرشي عن محمد بن خالد الدمشقي عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","أبو عبد الرحمن الحبلي"
"14736","14697  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ، قَالَ :  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ الْفَهْمِيُّ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ عَمْرٍو الْمَعَافِرِيِّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ صَمَتَ نَجَا  .","","Al-Mu'jam al-Kabir 14697","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن يزيد بن عمرو المعافري عن عبد الله بن لهيعة عن عثمان بن صالح بن صفوان عن يحيى بن عثمان بن صالح عن الطبراني","أبو عبد الرحمن الحبلي"
"14737","[14/87]      14698  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ نَافِعٍ الطَّحَّانُ الْمِصْرِيُّ ،  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  ثَنَا  يَزِيدُ بْنُ عَمْرٍو الْمَعَافِرِيُّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ صَمَتَ نَجَا  .","","Al-Mu'jam al-Kabir 14698","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن يزيد بن عمرو المعافري عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن نافع الطحاوي عن الطبراني","أبو عبد الرحمن الحبلي"
"14738","14699  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ الْفَهْمِيُّ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ عَمْرٍو الْمَعَافِرِيِّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَذَكَرَ الرَّحِمَ وَاضِعًا إِحْدَى إِصْبَعَيْهِ عَلَى الْأُخْرَى - يَقُولُ :  مَنْ وَصَلَكِ وَصَلْتُهُ ، وَمَنْ قَطَعَكِ قَطَعْتُهُ  .","","Al-Mu'jam al-Kabir 14699","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن يزيد بن عمرو المعافري عن عبد الله بن لهيعة عن البيطارى عبد الله بن محمد بن إسحاق عن روح بن الفرج القطان عن الطبراني","أبو عبد الرحمن الحبلي"
"14739","14700  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ ، قَالَ :  حَدَّثَنِي         [14/88]      أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ،  عَنِ  الْعَلَاءِ بْنِ كَثِيرٍ ، أَنَّ أَبَا عَبْدِ الرَّحْمَنِ الْحُبُلِيَّ ،  حَدَّثَهُمْ  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَأَلَ  رَجُلًا  ، فَقَالَ : كَيْفَ تَقُولُ إِذَا أَوَيْتَ إِلَى فِرَاشِكَ ؟ قَالَ :  أَقُولُ : بِاسْمِكَ وَضَعْتُ جَنْبِي ، فَاغْفِرْ لِي ذَنْبِي . قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَصَبْتَ  ، وَفَّقَكَ اللهُ  .","","Al-Mu'jam al-Kabir 14700","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن العلاء بن كثير الإسكندراني عن عمرو بن الحارث بن يعقوب عن رشدين بن سعد المهري عن حجاج بن رشدين المصري عن محمد بن الحجاج بن رشدين المهري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","أبو عبد الرحمن الحبلي"
"14740","14701  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ الْحَجَّاجِ بْنِ رِشْدِينِ بْنِ سَعْدٍ ، [قَالَ :  حَدَّثَنِي  أَبِي ] ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ،  عَنِ  الْعَلَاءِ بْنِ مُحَمَّدٍ ، أَنَّ أَبَا عَبْدِ الرَّحْمَنِ الْحُبُلِيَّ ،  حَدَّثَهُمْ  أَنَّ  عَبْدَ اللهِ بْنَ عَمْرٍو سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ لَقِيَ اللهَ يَوْمَ الْقِيَامَةِ بِالصَّلَوَاتِ الْخَمْسِ ، وَصِيَامِ رَمَضَانَ ، وَالِاغْتِسَالِ مِنَ الْجَنَابَةِ ، كَانَ عَبْدًا لِلهِ حَقًّا  ، وَمَنِ اخْتَانَ مِنْهُنَّ شَيْئًا كَانَ عَدُوًّا لِلهِ حَقًّا  .","","Al-Mu'jam al-Kabir 14701","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن العلاء بن محمد عن عمرو بن الحارث بن يعقوب عن رشدين بن سعد المهري عن حجاج بن رشدين المصري عن محمد بن الحجاج بن رشدين المهري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","أبو عبد الرحمن الحبلي"
"14741","14702  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ، قَالَ :  ثَنَا  مُعَاذُ بْنُ أَسَدٍ (  ح  ) .         [14/89]      وَحَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ، قَالَ :  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ، (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ مُقَاتِلٍ الْمَرْوَزِيُّ ، قَالُوا :  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  يَحْيَى بْنِ أَيُّوبَ ، قَالَ :  حَدَّثَنِي  عَبْدُ اللهِ بْنُ جُنَادَةَ ، قَالَ :  حَدَّثَنِي  الْحُبُلِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِرَجُلٍ  يَحْلُبُ شَاةً ، فَقَالَ :  أَيْ فُلَانُ ، إِذَا حَلَبْتَ فَأَبْقِ لِوَلَدِهَا ، فَإِنَّهَا مِنْ أَبَرِّ الدَّوَابِّ  .","","Al-Mu'jam al-Kabir 14702","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الله بن جنادة المعافري عن يحيى بن أيوب الغافقي عن عبد الله بن المبارك عن محمد بن مقاتل الكسائي عن محمد بن علي بن زيد الصائغ عن الطبراني","أبو عبد الرحمن الحبلي"
"14742","14703  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَأَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ، قَالَا :  أَنَا  هِشَامُ بْنُ عَمَّارٍ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ الْبَكْرِيُّ ، قَالَ :  ثَنَا  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  كَعْبِ بْنِ عَلْقَمَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ،  أَنَّ  رَجُلًا  شَكَا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سُوءَ  الْحِرْفَةِ  ، فَقَالَ : رَبِّ صَغِيرًا  . فَسَأَلْتُهُ ؟ فَقَالَ : مُهْرًا أَوْ جَارِيَةً أَوْ غُلَامًا  .","","Al-Mu'jam al-Kabir 14703","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن كعب بن علقمة بن كعب عن عمرو بن الحارث بن يعقوب عن عبد الله بن يزيد البكري عن هشام بن عمار عن أحمد بن المعلى الأسدي عن الطبراني","أبو عبد الرحمن الحبلي"
"14743","[14/90]      14704  -  حَدَّثَنَا  الْقَاسِمُ بْنُ زَكَرِيَّا ، قَالَ :  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْمَرْوَزِيُّ ، قَالَ :  ثَنَا  هِشَامُ بْنُ يُوسُفَ ، قَالَ :  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ صَخْرٍ ،  عَنْ  جَمِيلِ بْنِ كُرَيْبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ شَرِبَ بَصْقَةَ خَمْرٍ فَاجْلِدُوهُ ثَمَانِينَ  .","","Al-Mu'jam al-Kabir 14704","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن جميل بن كريب الإفريقي عن عبد الرحمن بن صخر بن جويرية الإفريقي عن هشام بن يوسف الأبناوي عن إسحاق بن أبي إسرائيل عن القاسم بن زكريا المطرز عن الطبراني","أبو عبد الرحمن الحبلي"
"14744","حُدَيْجُ بْنُ صَوْمِيٍّ الْمَعَافِرِيُّ  14705  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  الْمُقْرِئُ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  حَدَّثَنِي  حُدَيْجُ بْنُ صَوْمِيٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْغَفْلَةُ فِي ثَلَاثٍ : عَنْ ذِكْرِ اللهِ عَزَّ وَجَلَّ ،         [14/91]      وَحِينَ يُصَلِّي الصُّبْحَ إِلَى طُلُوعِ الشَّمْسِ  ، وَغَفْلَةُ الرَّجُلِ عَنْ نَفْسِهِ فِي الدَّيْنِ حَتَّى يَرْكَبَهُ  .","","Al-Mu'jam al-Kabir 14705","","عبد الله بن عمرو بن العاص عن حديج بن صومي الحميري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","حُدَيْجُ بْنُ صَوْمِيٍّ الْمَعَافِرِ"
"14745","14706  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  الْمُقْرِئُ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْعِلْمُ ثَلَاثَةٌ - فَمَا سِوَى ذَلِكَ فَضْلٌ - : آيَةٌ مُحْكَمَةٌ ، وَسُنَّةٌ  قَائِمَةٌ  ،  وَفَرِيضَةٌ  عَادِلَةٌ  .","","Al-Mu'jam al-Kabir 14706","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","حُدَيْجُ بْنُ صَوْمِيٍّ الْمَعَافِرِ"
"14746","[14/92]      أَبُو غُطَيْفٍ الْحَضْرَمِيُّ  .  14707  -  حَدَّثَنَا  هَارُونُ ، قَالَ :  ثَنَا  الْمُقْرِئُ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ، قَالَ :  حَدَّثَنِي  عُمَارَةُ بْنُ غُرَابٍ الْيَحْصَبِيُّ ،  عَنْ  أَبِي غُطَيْفٍ الْحَضْرَمِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَنَحْنُ جُلُوسٌ ، فَأَوْسَعْنَا لَهُ فَجَلَسَ ، ثُمَّ قَالَ :  أَيْنَ أَصْحَابِي الَّذِينَ هُمْ مِنِّي ، وَأَنَا مِنْهُمْ ، وَأَدْخُلُ الْجَنَّةَ وَيَدْخُلُونَهَا مَعِي ؟  قَالَهَا ثَلَاثًا ، فَقُلْنَا : أَغَيْرُنَا يَا رَسُولَ اللهِ ؟ قَالَ : نَعَمْ ،  أَهْلُ الْيَمَنِ  الْمُطَّرَحِينَ فِي أَطْرَافِ الْأَرْضِ ، الْمَدْفُوعُونَ عَنْ أَبْوَابِ السُّلْطَانِ ، يَمُوتُ أَحَدُهُمْ وَحَاجَتُهُ فِي صَدْرِهِ لَمْ يَقْضِهَا .","","Al-Mu'jam al-Kabir 14707","","عبد الله بن عمرو بن العاص عن أبو غطيف الحضرمي عن عمارة بن غراب اليحصبي عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أبو غطيف الحضرمي"
"14747","[14/93]      أَبُو الْحُصَيْنِ  14708  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ، قَالَ :  ثَنَا  شُعْبَةُ بْنُ عُقْبَةَ ، قَالَ :  ثَنَا  ابْنُ لهِيعَةَ ، قَالَ :  ثَنَا  عَيَّاشُ بْنُ عَبَّاسٍ ،  عَنْ  أَبِي الْحُصَيْنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،  أَنَّ  رَجُلًا  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ وَقْتِ صَلَاةِ الصُّبْحِ ؟ فَصَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الصُّبْحَ  بِغَلَسٍ  ، ثُمَّ صَلَّاهَا مِنَ الْغَدِ  فَأَسْفَرَ  ، ثُمَّ قَالَ :  أَيْنَ السَّائِلُ ؟ فَقَالَ : أَنَا ، فَقَالَ : الْوَقْتُ فِيمَا بَيْنَ أَمْسِ وَالْيَوْمِ  .","","Al-Mu'jam al-Kabir 14708","","عبد الله بن عمرو بن العاص عن الهيثم بن شفي بن قاسط الرعيني عن عياش بن عباس القتباني عن عبد الله بن لهيعة عن شعبة بن عقبة عن روح بن الفرج القطان عن الطبراني","أبو الحصين"
"14748","[14/94]      عَبْدُ اللهِ بْنُ رَافِعٍ  14709  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادٍ  ، ح  .  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ، قَالَ :  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دَخَلَ الْمَسْجِدَ فَرَأَى مَجْلِسَيْنِ ، أَحَدُ الْمَجْلِسَيْنِ يَدْعُونَ اللهَ وَيَرْغَبُونَ إِلَيْهِ ، وَالْآخَرُ يَتَعَلَّمُونَ الْفِقْهَ وَيُعَلِّمُونَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كِلَا الْمَجْلِسَيْنِ عَلَى خَيْرٍ ، أَحَدُهُمَا أَفْضَلُ مِنَ الْآخَرِ  ، أَمَّا هَؤُلَاءِ فَيَدْعُونَ اللهَ وَيَرْغَبُونَ         [14/95]      إِلَيْهِ ، إِنْ شَاءَ أَعْطَاهُمْ ، وَإِنْ شَاءَ مَنَعَهُمْ ، وَأَمَّا هَؤُلَاءِ فَيَتَعَلَّمُونَ وَيُعَلِّمُونَ الْجَاهِلَ ، وَإِنَّمَا بُعِثْتُ مُعَلِّمًا ، وَهَؤُلَاءِ أَفْضَلُ . وَأَتَاهُمْ حَتَّى جَلَسَ إِلَيْهِمْ  .  كذا في طبعة الجريسي ، والصواب : ( عبد الرحمن بن رافع )  كذا في طبعة الجريسي ، والصواب : ( عبد الرحمن بن رافع )","","Al-Mu'jam al-Kabir 14709","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن رافع التنوخي عن عبد الرحمن بن زياد بن أنعم الإفريقي عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","عبد الله بن رافع"
"14749","عَبْدُ الرَّحْمَنِ بْنُ رَافِعٍ  14710  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  الْمُقْرِئُ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ رَافِعٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَفِي إِحْدَى يَدَيْهِ ذَهَبٌ ، وَفِي الْأُخْرَى حَرِيرٌ ، فَقَالَ :  هَذَانِ حَرَامٌ عَلَى ذُكُورِ أُمَّتِي ، حِلٌّ لِإِنَاثِهَا  .","","Al-Mu'jam al-Kabir 14710","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن رافع التنوخي عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","عبد الرحمن بن رافع"
"14750","14711  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ رَبَاحٍ .         [14/96]      وَحَدَّثَنَا  طَالِبُ بْنُ قُرَّةَ الْأَذَنِيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ، قَالَا :  ثَنَا  فَرَجُ بْنُ فَضَالَةَ ،  عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ رَافِعٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ حَرَّمَ عَلَى أُمَّتِي الْخَمْرَ ، وَالْمَيْسِرَ ،  وَالْمِزْرَ  ،  وَالْكُوبَةَ ،  وَالْغُبَيْرَاءَ  ، وَزَادَنِي صَلَاةَ الْوَتْرِ  .","","Al-Mu'jam al-Kabir 14711","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن رافع التنوخي عن إبراهيم بن عبد الرحمن بن رافع الحضرمي عن فرج بن فضالة بن النعمان التنوخي عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن طالب بن قرة الأذني عن الطبراني","عبد الرحمن بن رافع"
"14751","14712  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  الْمُقْرِئُ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ (  ح  ) .  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ (  ح  ) .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، قَالَ :  ثَنَا  مُسَدَّدٌ ، قَالَ :  ثَنَا  عِيسَى بْنُ يُونُسَ (  ح  ) .         [14/97]      وَحَدَّثَنَا  أَحْمَدُ بْنُ خُلَيْدٍ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ الطَّبَّاعِ ، قَالَ :  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ، كُلُّهُمْ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ رَافِعٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّهَا سَتُفْتَحُ لَكُمْ أَرْضُ الْأَعَاجِمِ بَعْدِي ، وَإِنَّ فِيهَا بُيُوتًا تُدْعَى الْحَمَّامَاتِ  ، أَلَا وَهِيَ حَرَامٌ عَلَى الرِّجَالِ إِلَّا بِالْمَيَازِرِ ، وَعَلَى نِسَاءِ أُمَّتِي إِلَّا النُّفَسَاءَ أَوِ السَّقِيمَةَ  .","","Al-Mu'jam al-Kabir 14712","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن رافع التنوخي عن عبد الرحمن بن زياد بن أنعم الإفريقي عن إسماعيل بن عياش الأحول عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن أحمد بن خليد بن يزيد الحلبي عن الطبراني","عبد الرحمن بن رافع"
"14752","14713  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ، قَالَ :  أَنَا  مُحَمَّدُ بْنُ يَحْيَى الْأَزْدِيُّ ، قَالَ :  ثَنَا  ابْنُ الْمُحَبَّرِ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ رَاشِدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ رَافِعٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنَ الذِّكْرِ أَفْضَلُ مِنْ لَا إِلَهَ إِلَّا اللهُ  ، وَلَا مِنَ الدُّعَاءِ أَفْضَلُ مِنَ الِاسْتِغْفَارِ ، ثُمَّ تَلَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         {      فَاعْلَمْ أَنَّهُ لا إِلَهَ إِلا اللهُ وَاسْتَغْفِرْ لِذَنْبِكَ وَلِلْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ         }      .","","Al-Mu'jam al-Kabir 14713","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن رافع التنوخي عن عبد الرحمن بن زياد بن أنعم الإفريقي عن سعيد بن راشد السماك عن داود بن المحبر البكراوي عن محمد بن يحيى بن أبي حاتم عن أحمد بن يحيى بن زهير التستري عن الطبراني","عبد الرحمن بن رافع"
"14753","[14/98]      14714  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  بَكْرِ بْنِ سَوَادَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ رَافِعٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا أَحْدَثَ الْإِمَامُ فِي آخِرِ صَلَاتِهِ حِينَ يَسْتَوِي قَاعِدًا فَقَدْ تَمَّتْ صَلَاتُهُ  ، وَصَلَاةُ مَنْ وَرَاءَهُ عَلَى مِثْلِ صَلَاتِهِ  .","","Al-Mu'jam al-Kabir 14714","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن رافع التنوخي عن بكر بن سوادة عن عبد الرحمن بن زياد بن أنعم الإفريقي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبد الرحمن بن رافع"
"14754","[14/99]      14715  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  الْمُقْرِئُ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  عَنْ  شُرَحْبِيلَ بْنِ شَرِيكٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ رَافِعٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا  أُبَالِي  مَا أَتَيْتُ - أَوْ مَا رَكِبْتُ  - إِذَا مَا  تَعَلَّقْتُ  تَمِيمَةً  ، أَوْ شَرِبْتُ  تِرْيَاقًا  ، أَوْ قُلْتُ         [14/100]      الشِّعْرَ مِنْ قِبَلِ نَفْسِي  .","","Al-Mu'jam al-Kabir 14715","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن رافع التنوخي عن شرحبيل بن شريك الأجروي عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","عبد الرحمن بن رافع"
"14755","يَزِيدُ بْنُ رَبَاحٍ  14716  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ:  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ، أَنَّ بَكْرَ بْنَ سَوَادَةَ  حَدَّثَهُ  ، أَنَّ يَزِيدَ بْنَ رَبَاحٍ  حَدَّثَهُ  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا فُتِحَتْ عَلَيْكُمْ خَزَائِنُ  فَارِسَ  وَالرُّومِ  ، أَيُّ قَوْمٍ أَنْتُمْ ؟  فَقَالَ  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  : نَكُونُ كَمَا أَمَرَ اللهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَوْ غَيْرَ ذَلِكَ ! تَتَنَافَسُونَ ، ثُمَّ تَحَاسَدُونَ ثُمَّ تَدَابَرُونَ ، وَتَبَاغَضُونَ - أَوْ نَحْوَ ذَلِكَ - ثُمَّ تَنْطَلِقُونَ إِلَى مَسَاكِنِ الْمُهَاجِرِينَ         [14/101]      فَتَحْمِلُونَ بَعْضَهُمْ عَلَى رِقَابِ بَعْضٍ .","","Al-Mu'jam al-Kabir 14716","","عبد الله بن عمرو بن العاص عن يزيد بن رباح السهمي عن بكر بن سوادة عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","يزيد بن رباح"
"14756","14717  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ، قَالَ :  ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي قَنَانٍ ،  عَنْ  يَزِيدَ بْنِ رَبَاحٍ أَبِي فِرَاسٍ ،  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عَمْرٍو ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  صَامَ  نُوحٌ  عَلَيْهِ السَّلَامُ الدَّهْرَ ، إِلَّا يَوْمَ الْفِطْرِ وَالْأَضْحَى  ، وَصَامَ  دَاوُدُ  عَلَيْهِ السَّلَامُ نِصْفَ الدَّهْرِ . وَصَامَ  إِبْرَاهِيمُ  عَلَيْهِ السَّلَامُ ثَلَاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ ، صَامَ الدَّهْرَ وَأَفْطَرَ الدَّهْرَ  .","","Al-Mu'jam al-Kabir 14717","","عبد الله بن عمرو بن العاص عن يزيد بن رباح السهمي عن أيوب بن أبي العالية الحضرمي عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن روح بن الفرج القطان عن الطبراني","يزيد بن رباح"
"14757","[14/102]      وَاهِبُ بْنُ عَبْدِ اللهِ  14718  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ، قَالَ :  ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  وَاهِبِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يُصَلِّي أَحَدُكُمْ وَثَوْبُهُ عَلَى أَنْفِهِ ، فَإِنَّ ذَلِكَ  خَطْمُ  الشَّيْطَانِ  .","","Al-Mu'jam al-Kabir 14718","","عبد الله بن عمرو بن العاص عن واهب بن عبد الله المعافري عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن أحمد بن محمد بن الحجاج المصري عن الطبراني","واهب بن عبد الله"
"14758","14719  -  حَدَّثَنَا  عُمَارَةُ بْنُ وَثِيمَةَ ، قَالَ :  حَدَّثَنِي  [ أَبِي وَثِيمَةُ بْنُ]         [14/103]      مُوسَى  ، قَالَ :  ثَنَا  إِدْرِيسُ بْنُ يَحْيَى الْخَوْلَانِيُّ ،  عَنْ  رَجَاءِ بْنِ أَبِي عَطَاءٍ ،  عَنْ  وَاهِبِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَطْعَمَ أَخَاهُ حَتَّى يُشْبِعَهُ ، وَسَقَاهُ مِنَ الْمَاءِ حَتَّى يَرْوِيَهُ ، بَاعَدَهُ اللهُ مِنَ النَّارِ سَبْعَ خَنَادِقَ  ، مَا بَيْنَ كُلِّ خَنْدَقٍ  مَسِيرَةُ  خَمْسِمِائَةِ عَامٍ  .","","Al-Mu'jam al-Kabir 14719","","عبد الله بن عمرو بن العاص عن واهب بن عبد الله المعافري عن رجاء بن أبي عطاء المصري عن إدريس بن يحيى الخولاني عن وثيمة بن موسى الفارسي عن عمارة بن وثيمة المصري عن الطبراني","واهب بن عبد الله"
"14759","[14/104]      سُلَيْمُ بْنُ بِلَالٍ  14720  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ، قَالَ :  ثَنَا  أَبِي ،  قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  عَمْرِو بْنِ الْوَلِيدِ بْنِ عَبْدَةَ ،  عَنْ  أَبِي أَسْمَاءَ سُلَيْمِ بْنِ بِلَالٍ الْحَضْرَمِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يَكُونُ  خَلِيفَةٌ  هُوَ وَذُرِّيَّتُهُ مِنْ أَهْلِ النَّارِ  .  قَيْصَرُ بْنُ أَبِي حَزْرَةَ .","","Al-Mu'jam al-Kabir 14720","","عبد الله بن عمرو بن العاص عن أبو أسماء سليم بن بلال الحضرمي عن عمرو بن الوليد بن عبدة السهمى عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن عثمان بن صالح بن صفوان عن يحيى بن عثمان بن صالح عن الطبراني","سليم بن بلال"
"14760","14721  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ، قَالَ :  ثَنَا  مُوسَى بْنُ دَاوُدَ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  قَيْصَرَ بْنِ أَبِي حَزْرَةَ التُّجِيبِيِّ (  ح  ) .         [14/105]      وَحَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ، قَالَ :  ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  قَيْصَرَ بْنِ أَبِي حَزْرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ، قَالَ :  كُنْتُ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَسَأَلَهُ  شَيْخٌ  عَنِ الْقُبْلَةِ للِصَّائِمِ ، فَرَخَّصَ لَهُ ، ثُمَّ سَأَلَهُ  رَجُلٌ شَابٌّ  عَنِ الْقُبْلَةِ لِلصَّائِمِ ، فَنَهَاهُ ، فَنَظَرَ بَعْضُ  الْقَوْمِ  فِي وُجُوهِ بَعْضٍ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الشَّيْخَ يَمْلِكُ نَفْسَهُ  .  زَادَ  مُوسَى بْنُ دَاوُدَ  فِي حَدِيثِهِ : فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : قَدْ عَلِمْتُ لِمَ نَظَرَ بَعْضُكُمْ إِلَى بَعْضٍ ، إِنَّ الشَّيْخَ يَمْلِكُ نَفْسَهُ  .","","Al-Mu'jam al-Kabir 14721","","عبد الله بن عمرو بن العاص عن قيصر التجيبي الكلابي عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن روح بن الفرج القطان عن الطبراني","سليم بن بلال"
"14761","أَبُو سَالِمٍ الْجَيْشَانِيُّ  عَنْهُ  14722  -  أَخْبَرَنَا  سُلَيْمَانُ بْنُ أَحْمَدَ بْنِ أَيُّوبَ ، قَالَ :  ثَنَا  أَبُو الزِّنْبَاعِ ، قَالَ :  حَدَّثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي هُبَيْرَةَ ،  عَنْ  أَبِي سَالِمٍ الْجَيْشَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَحِلُّ أَنْ تُنْكَحَ امْرَأَةٌ بِطَلَاقِ أُخْرَى  .","","Al-Mu'jam al-Kabir 14722","","عبد الله بن عمرو بن العاص عن سفيان بن هانئ الجيشاني عن عبد الله بن هبيرة السبئي عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن روح بن الفرج القطان عن الطبراني","أبو سالم الجيشاني عنه"
"14762","[14/106]      14723  -  حَدَّثَنَا  أَحْمَدُ بْنُ حَمَّادٍ ابْنُ زُغْبَةَ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ عُقْبَةَ  ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ هُبَيْرَةَ ،  عَنْ  أَبِي سَالِمٍ الْجَيْشَانِيِّ  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَحِلُّ لِرَجُلٍ أَنْ يَتَزَوَّجَ امْرَأَةً بِطَلَاقِ أُخْرَى  ، وَلَا يَحِلُّ لِرَجُلٍ أَنْ يَبِيعَ عَلَى بَيْعِ صَاحِبِهِ حَتَّى يَذَرَ ، وَلَا يَحِلُّ لِثَلَاثَةِ نَفَرٍ يَكُونُونَ بِأَرْضِ فَلَاةٍ  يَتَنَاجَى  اثْنَانِ دُونَ صَاحِبِهِمَا .  كذا في طبعة الجريسي ، ولعل الصواب : (سعيد بن عفير) .","","Al-Mu'jam al-Kabir 14723","","عبد الله بن عمرو بن العاص عن سفيان بن هانئ الجيشاني عن عبد الله بن هبيرة السبئي عن عبد الله بن لهيعة عن سعيد بن كثير بن عفير عن زغبة ، أحمد بن حماد بن مسلم التجيبي عن الطبراني","أبو سالم الجيشاني عنه"
"14763","أَبُو رَزِينٍ الْغَافِقِيُّ  14724  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ نَافِعٍ الطَّحَّانُ الْمِصْرِيُّ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ وَهْبٍ أَبُو عُبَيْدِ اللهِ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ عَيَّاشٍ ،  عَنْ  أَبِي رَزِينٍ الْغَافِقِيِّ ،         [14/107]      عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الَّذِي يَمُرُّ بَيْنَ يَدَيِ الرَّجُلِ وَهُوَ يُصَلِّي عَمْدًا ، يَتَمَنَّى يَوْمَ الْقِيَامَةِ أَنَّهُ شَجَرَةٌ يَابِسَةٌ  .","","Al-Mu'jam al-Kabir 14724","","عبد الله بن عمرو بن العاص عن أبو رزين الغافقي عن عبد الله بن عياش القتباني عن عبد الله بن وهب المصري عن أحمد بن عبد الرحمن بن وهب عن أحمد بن محمد بن نافع الطحاوي عن الطبراني","أبو رزين الغافقي"
"14764","ابْنُ حُجَيْرَةَ  14725  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مَحْمُودٍ النَّيْسَابُورِيُّ ، قَالَ :  ثَنَا  يَحْيَى بْنُ يَحْيَى ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنِ  الْحَارِثِ بْنِ يَزِيدَ ،  عَنِ  ابْنِ حُجَيْرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَرْبَعٌ إِذَا كُنَّ فِيكَ فَمَا عَلَيْكَ مَا فَاتَكَ مِنَ الدُّنْيَا : أَدَاءُ الْأَمَانَةِ  ، وَصِدْقُ الْحَدِيثِ ، وَحُسْنُ الْخَلِيقَةِ ،  وَعِفَّةُ  طُعْمَةٍ  .","","Al-Mu'jam al-Kabir 14725","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن حجيرة الخولاني عن الحارث بن يزيد الحضرمي عن عبد الله بن لهيعة عن يحيى بن يحيى الحنظلي عن إسماعيل بن محمود النيسابوري عن الطبراني","ابن حجيرة"
"14765","[14/108]      14726  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ، قَالَ :  أَنَا  ابْنُ لَهِيعَةَ ، قَالَ :  حَدَّثَنِي  الْحَارِثُ بْنُ يَزِيدَ ،  عَنِ  ابْنِ حُجَيْرَةَ ، [  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ] قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  إِنَّ الْمُسْلِمَ  الْمُسَدِّدَ  لَيُدْرِكُ دَرَجَةَ الصَّوَّامِ الْقَوَّامِ بِآيَاتِ اللهِ ، بِحُسْنِ  خُلُقِهِ  ، وَبِكَرَمِ  ضَرِيبَتِهِ  .","","Al-Mu'jam al-Kabir 14726","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن حجيرة الخولاني عن الحارث بن يزيد الحضرمي عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","ابن حجيرة"
"14766","[14/109]      14727  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ، قَالَ :  حَدَّثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ، أَنَّ أَبَا سُوَيْدٍ  حَدَّثَهُ  ،  أَنَّهُ سَمِعَ  ابْنَ حُجَيْرَةَ ،  يُخْبِرُ عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  مَنْ قَامَ بِعَشْرِ آيَاتٍ لَمْ يُكْتَبْ مِنَ الْغَافِلِينَ  ، وَمَنْ قَامَ بِمِائَةِ آيَةٍ كُتِبَ مِنَ  الْقَانِتِينَ  ، وَمَنْ قَامَ بِأَلْفِ آيَةٍ كُتِبَ مِنَ الشَّاكِرِينَ .","","Al-Mu'jam al-Kabir 14727","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن حجيرة الخولاني عن عبيد بن سوية المصري عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","ابن حجيرة"
"14767","14728  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ، قَالَ :  حَدَّثَنِي  خَالِي سُلَيْمَانُ بْنُ دَاوُدَ أَبُو الرَّبِيعِ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ، أَنَّ أَبَا سُوَيْدٍ  حَدَّثَهُ  ،  عَنِ  ابْنِ حُجَيْرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ قَامَ بِـ         {      قُلْ هُوَ اللهُ أَحَدٌ             *          اللهُ الصَّمَدُ         }      ، فَقَدْ قَرَأَ بِثُلُثِ الْقُرْآنِ .","","Al-Mu'jam al-Kabir 14728","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن حجيرة الخولاني عن عبيد بن سوية المصري عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن سليمان بن داود المهري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","ابن حجيرة"
"14768","[14/110]      عَبْدُ الرَّحْمَنِ بْنُ شِمَاسَةَ الْمَهْرِيُّ  14729  -  حَدَّثَنَا  خَيْرُ بْنُ عَرَفَةَ التُّجِيبِيُّ ، قَالَ :  ثَنَا  هَانِئُ بْنُ الْمُتَوَكِّلِ الْإِسْكَنْدَرَانِيُّ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ شِمَاسَةَ الْمَهْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دَخَلَ عَلَى  أُمِّ إِبْرَاهِيمَ الْقِبْطِيَّةِ  أُمِّ وَلَدِهِ ، وَهِيَ حَامِلٌ مِنْهُ  بِإِبْرَاهِيمَ  ، فَوَجَدَ عِنْدَهَا نَسِيبًا لَهَا ، كَانَ قَدِمَ مَعَهَا مِنْ  مِصْرَ  ، فَأَسْلَمَ وَحَسُنَ إِسْلَامُهُ ، وَكَانَ يَدْخُلُ عَلَى  أُمِّ إِبْرَاهِيمَ  ، وَأَنَّهُ رَضِيَ بِمَكَانِهِ مِنْ أُمِّ وَلَدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَجُبَّ نَفْسَهُ ، فَقَطَعَ مَا بَيْنَ رِجْلَيْهِ حَتَّى لَمْ يُبْقِ لِنَفْسِهِ قَلِيلًا وَلَا كَثِيرًا ، فَدَخَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا عَلَى  أُمِّ إِبْرَاهِيمَ  ، فَوَجَدَ قَرِيبَهَا عِنْدَهَا ، فَوَقَعَ فِي نَفْسِهِ مِنْ ذَلِكَ شَيْءٌ كَمَا يَقَعُ فِي أَنْفُسِ النَّاسِ ، فَرَجَعَ مُتَغَيِّرَ اللَّوْنِ ، فَلَقِيَ  عُمَرَ  ، فَأَخْبَرَهُ بِمَا وَقَعَ فِي نَفْسِهِ مِنْ قَرِيبِ  أُمِّ إِبْرَاهِيمَ  ، فَأَخَذَ سَيْفَهُ وَأَقْبَلَ يَسْعَى حَتَّى دَخَلَ عَلَى  مَارِيَةَ  ، فَوَجَدَ قَرِيبَهَا ذَلِكَ عِنْدَهَا ، فَأَهْوَى إِلَيْهِ بِالسَّيْفِ لِيَقْتُلَهُ ، فَلَمَّا رَأَى ذَلِكَ مِنْهُ كَشَفَ عَنْ نَفْسِهِ ، فَلَمَّا رَآهُ  عُمَرُ  رَجَعَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرَهُ ،         [14/111]      فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ  جِبْرِيلَ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَتَانِي فَأَخْبَرَنِي أَنَّ اللهَ عَزَّ وَجَلَّ قَدْ بَرَّأَهَا  وَقَرِيبَهَا مِمَّا وَقَعَ فِي نَفْسِي ، وَبَشَّرَنِي أَنَّ فِي بَطْنِهَا غُلَامًا مِنِّي وَأَنَّهُ أَشْبَهُ الْخَلْقِ بِي ، وَأَمَرَنِي أَنْ أُسَمِّيَهُ  إِبْرَاهِيمَ  ،  وَكَنَّانِي  بِأَبِي إِبْرَاهِيمَ  ، فَلَوْلَا أَنِّي أَكْرَهُ أَنْ أُحَوِّلَ كُنْيَتِي الَّتِي عُرِفْتُ بِهَا لَتَكَنَّيْتُ  بِأَبِي إِبْرَاهِيمَ  ، كَمَا  كَنَّانِي  جِبْرِيلُ  عَلَيْهِ السَّلَامُ  .","","Al-Mu'jam al-Kabir 14729","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن شماسة المهري عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن هانئ بن المتوكل الإسكندراني عن خير بن عرفة المصري عن الطبراني","عبد الرحمن بن شماسة المهري"
"14769","أَبُو الْخَيْرِ  14730  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ، قَالَ :  ثَنَا  شُعَيْبُ بْنُ يَحْيَى ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَبِي الْخَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،  أَنَّ  رَجُلًا  ، قَالَ : يَا رَسُولَ اللهِ ، أَيُّ الْمُسْلِمِينَ خَيْرٌ ؟ قَالَ :  مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  .","","Al-Mu'jam al-Kabir 14730","","عبد الله بن عمرو بن العاص عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن شعيب بن يحيى التجيبي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","أبو الخير"
"14770","14731  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَبِي الْخَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،  أَنَّ  رَجُلًا  قَالَ : يَا رَسُولَ اللهِ ، أَيُّ الْمُسْلِمِينَ خَيْرٌ ؟ قَالَ :  مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  .","","Al-Mu'jam al-Kabir 14731","","عبد الله بن عمرو بن العاص عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","أبو الخير"
"14771","[14/112]      14732  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  عَنْ  أَبِي الْخَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،  أَنَّ  رَجُلًا  سَأَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَيُّ الْإِسْلَامِ خَيْرٌ ؟ قَالَ :  تُطْعِمُ الطَّعَامَ ، وَتَقْرَأُ السَّلَامَ عَلَى مَنْ عَرَفْتَ وَمَنْ لَمْ تَعْرِفْ  .","","Al-Mu'jam al-Kabir 14732","","عبد الله بن عمرو بن العاص عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","أبو الخير"
"14772","أَسْلَمُ أَبُو عِمْرَانَ  14733  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ، قَالَ :  ثَنَا  شُعَيْبُ بْنُ يَحْيَى ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ، أَنَّ أَسْلَمَ أَبَا عِمْرَانَ  حَدَّثَهُ  ،  أَنَّ  عَبْدَ اللهِ بْنَ عَمْرٍو كَانَ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَقْبَلَ  رَجُلٌ مِنَ الْأَعْرَابِ  ، فَقَالَ :         [14/113]      يَا رَسُولَ اللهِ إِنِّي أُحِبُّ  الْجِهَادَ  وَالْعُمْرَةَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَلْ لَكَ وَالِدَانِ ؟  قَالَ : نَعَمْ ، كِلَاهُمَا ، قَالَ : فَارْجِعْ [فَأَحْسِنْ] صَحَابَتَهُمَا  .","","Al-Mu'jam al-Kabir 14733","","عبد الله بن عمرو بن العاص عن أسلم بن يزيد التجيبي عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن شعيب بن يحيى التجيبي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","أسلم أبو عمران"
"14773","أَبُو عُشَّانَةَ  14734  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  الْمُقْرِئُ عَبْدُ اللهِ بْنُ يَزِيدَ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  حَدَّثَنِي  مَعْرُوفُ بْنُ سُوَيْدٍ الْجُذَامِيُّ (  ح  ) .         [14/114]      وَحَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ، قَالَ :  أَنَا  نَافِعُ بْنُ يَزِيدَ ،  حَدَّثَنِي  مَعْرُوفُ بْنُ سُوَيْدٍ الْجُذَامِيُّ ، أَنَّ أَبَا عُشَّانَةَ الْمَعَافِرِيُّ  حَدَّثَهُ  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عَمْرٍو ، يَقُولُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ :  هَلْ تَدْرُونَ أَوَّلَ مَنْ يَدْخُلُ الْجَنَّةَ ؟  قَالُوا : اللهُ وَرَسُولُهُ أَعْلَمُ ، قَالَ : فُقَرَاءُ  الْمُهَاجِرِينَ  الَّذِينَ تُتَّقَى بِهِمُ الْمَكَارِهُ ، يَمُوتُ أَحَدُهُمْ وَحَاجَتُهُ فِي صَدْرِهِ لَا يَسْتَطِيعُ لَهَا قَضَاءً ، تَقُولُ الْمَلَائِكَةُ : رَبَّنَا نَحْنُ مَلَائِكَتُكَ وَخَزَنَتُكَ وَسُكَّانُ سَمَاوَاتِكَ ، لَا تُدْخِلْهُمُ الْجَنَّةَ قَبْلَنَا . فَيَقُولُ : عِبَادِي لَا يُشْرِكُونَ بِي شَيْئًا تُتَّقَى بِهِمُ الْمَكَارِهُ ، يَمُوتُ أَحَدُهُمْ وَحَاجَتُهُ فِي صَدْرِهِ ، لَمْ يَسْتَطِعْ لَهَا قَضَاءً ، فَعِنْدَ ذَلِكَ تَدْخُلُ عَلَيْهِمُ الْمَلَائِكَةُ مِنْ كُلِّ بَابٍ :         {      سَلامٌ عَلَيْكُمْ بِمَا صَبَرْتُمْ فَنِعْمَ عُقْبَى الدَّارِ         }      .","","Al-Mu'jam al-Kabir 14734","","عبد الله بن عمرو بن العاص عن حي بن يؤمن أبو عشانة المصري عن معروف بن سويد الجذامي عن نافع بن يزيد الكلاعي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","أبو عشانة"
"14774","14735  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،         [14/115]      قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  أَبِي عُشَّانَةَ ،  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عَمْرٍو ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  أَوَّلُ  ثُلَّةٍ  تَدْخُلُ الْجَنَّةَ : فُقَرَاءُ  الْمُهَاجِرِينَ  الَّذِينَ تُتَّقَى بِهِمُ الْمَكَارِهُ ، إِذَا أُمِرُوا سَمِعُوا وَأَطَاعُوا ، وَإِنْ كَانَتْ لِرَجُلٍ مِنْهُمْ حَاجَةٌ إِلَى السُّلْطَانِ لَمْ تُقْضَ ، حَتَّى يَمُوتَ وَهِيَ فِي صَدْرِهِ ، فَإِنَّ اللهَ عَزَّ وَجَلَّ يَدْعُو يَوْمَ الْقِيَامَةِ الْجَنَّةَ ، فَتَأْتِي  بِزُخْرُفِهَا  وَزِينَتِهَا ، فَيَقُولُ : أَيْنَ عِبَادِي الَّذِينَ قَاتَلُوا [فِي سَبِيلِي] ، وَأُوذُوا فِي سَبِيلِي ، وَجَاهَدُوا فِي سَبِيلِي ؟ ادْخُلُوا الْجَنَّةَ بِغَيْرِ عَذَابٍ وَلَا حِسَابٍ . وَتَأْتِي الْمَلَائِكَةُ فَيَسْجُدُونَ ، فَيَقُولُونَ : رَبَّنَا نَحْنُ نُسَبِّحُكَ اللَّيْلَ وَالنَّهَارَ وَنُقَدِّسُ لَكَ ، مَنْ هَؤُلَاءِ الَّذِينَ آثَرْتَهُمْ عَلَيْنَا ؟ فَيَقُولُ الرَّبُّ جَلَّ ذِكْرُهُ : هَؤُلَاءِ عِبَادِي الَّذِينَ قَاتَلُوا فِي سَبِيلِي ، وَأُوذُوا فِي سَبِيلِي ، وَجَاهَدُوا فِي سَبِيلِي . فَتَدْخُلُ عَلَيْهِمُ الْمَلَائِكَةُ مِنْ كُلِّ بَابٍ :         {      سَلامٌ عَلَيْكُمْ بِمَا صَبَرْتُمْ فَنِعْمَ عُقْبَى الدَّارِ         }      .","","Al-Mu'jam al-Kabir 14735","","عبد الله بن عمرو بن العاص عن حي بن يؤمن أبو عشانة المصري عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","أبو عشانة"
"14775","[14/116]      نَاعِمٌ مَوْلَى أُمِّ سَلَمَةَ  14736  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ، أَنَّ نَاعِمًا مَوْلَى أُمِّ سَلَمَةَ  حَدَّثَهُ  ، أَنَّ عَبْدَ اللهِ بْنَ عَمْرٍو  حَدَّثَهُ  ، قَالَ :  أَقْبَلَ  رَجُلٌ  إِلَى نَبِيِّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  أُبَايِعُكَ  عَلَى الْهِجْرَةِ  وَالْجِهَادِ  ، وَأَبْغِي الْأَجْرَ مِنَ اللهِ ، قَالَ :  فَهَلْ مِنْ وَالِدَيْكَ أَحَدٌ حَيٌّ ؟  قَالَ : نَعَمْ ، كِلَاهُمَا . قَالَ : فَمَا تَبْغِي الْأَجْرَ مِنَ اللهِ ؟ قَالَ : نَعَمْ ، قَالَ : ارْجِعْ إِلَى وَالِدَيْكَ وَأَحْسِنْ صُحْبَتَهُمَا  .","","Al-Mu'jam al-Kabir 14736","","عبد الله بن عمرو بن العاص عن ناعم بن أجيل الهمداني عن يزيد بن أبي حبيب الأزدي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","ناعم مولى أم سلمة"
"14776","عَتَّابُ بْنُ عَامِرٍ  14737  -  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ يَحْيَى بْنِ بُكَيْرٍ ، قَالَ :  ثَنَا  أَبِي  ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي صَخْرٍ ،  عَنْ  عَتَّابِ بْنِ عَامِرٍ ، قَالَ :  كُنْتُ عِنْدَ عَبْدِ اللهِ بْنِ عَمْرٍو فِي  الْحِجْرِ  بِمَكَّةَ  ، فَسُئِلَ عَنِ الْخَمْرِ ، فَقَالَ :         [14/117]      سَأَلَنِي رَجُلٌ ، فَقُلْتُ : هَذَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَاذْهَبْ فَاسْأَلْهُ ، ثُمَّ ارْجِعْ فَأَخْبِرْنِي ، فَسَأَلَهُ ثُمَّ رَجَعَ ، فَأَخْبَرَنِي أَنَّهُ سَأَلَهُ ، فَقَالَ :  هِيَ أَكْبَرُ الْكَبَائِرِ  ، وَأُمُّ الْفَوَاحِشِ ، وَمَنْ  شَرِبَ  الْخَمْرَ تَرَكَ الصَّلَاةَ وَوَقَعَ عَلَى أُمِّهِ وَعَمَّتِهِ وَخَالَتِهِ!!  .","","Al-Mu'jam al-Kabir 14737","","أحد الصحابة عن عبد الله بن عمرو بن العاص عن عتاب بن عامر عن حميد بن أبي المخارق الخراط عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن عبد الملك بن يحيى المخزومي عن الطبراني","عتاب بن عامر"
"14777","عَمْرُو بْنُ حَرِيشٍ  14738  -  أَخْبَرَنَا  بِشْرُ بْنُ مُوسَى ، قَالَ :  ثَنَا  [ الْعَلَاءُ] بْنُ عَبْدِ الْجَبَّارِ الْعَطَّارُ (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الْعَزِيزِ الْبَغَوِيُّ ، قَالَ :  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِياثٍ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ         [14/118]      إِسْحَاقَ ،  عَنْ  [يَزِيدَ] بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  عَمْرِو بْنِ حَرِيشٍ ، قَالَ :  قُلْتُ  لِعَبْدِ اللهِ بْنِ عَمْرٍو :  إِنَّا بِأَرْضٍ لَيْسَ بِهَا ذَهَبٌ وَلَا فِضَّةٌ ، أَفَنَبِيعُ الْبَعِيرَ بِالْبَعِيرَيْنِ وَالْبَقَرَةَ بِالْبَقَرَتَيْنِ وَالشَّاةَ بِالشَّاتَيْنِ ؟ قَالَ : أَمَرَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ  أُجَهِّزَ  جَيْشًا فَنَفِدَتِ الْإِبِلُ ، فَقُلْتُ : يَا رَسُولَ اللهِ نَفِدَتِ الْإِبِلُ ؟ فَقَالَ :  خُذْ [فِي]  قَلَائِصِ  الصَّدَقَةِ  . فَجَعَلْتُ آخُذُ الْبَعِيرَ بِالْبَعِيرَيْنِ إِلَى إِبِلِ الصَّدَقَةِ .","","Al-Mu'jam al-Kabir 14738","","عبد الله بن عمرو بن العاص عن عمرو بن حريش الزبيدي عن أبو سفيان عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن حماد بن سلمة عن عبد الواحد بن غياث عن أبو القاسم البغوي عن الطبراني","عمرو بن حريش"
"14778","عِيسَى بْنُ هِلَالٍ الصَّدَفِيُّ  14739  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ عَيَّاشِ بْنِ عَبَّاسٍ ، قَالَ :  حَدَّثَنِي  أَبِي  ، قَالَ :  سَمِعْتُ  أَبَا عَبْدِ الرَّحْمَنِ ، وَعِيسَى بْنَ هِلَالٍ الصَّدَفِيَّ  يُحَدِّثَانِ عَنْ  عَبْدِ اللهِ بْنِ         [14/119]      عَمْرٍو ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  سَيَكُونُ فِي أُمَّتِي رِجَالٌ ، يَرْكَبُونَ نِسَاؤُهُمْ عَلَى سُرُوجٍ كَأَشْبَاهِ الرِّحَالِ  ،  كَاسِيَاتٍ         [14/120]      عَارِيَاتٍ عَلَى رُؤُسِهِنَّ  كَأَسْنِمَةِ  الْبُخْتِ  ، فَالْعَنُوهُمْ ، فَإِنَّهُنَّ مَلْعُونَاتٌ ، لَوْ كَانَتْ وَرَاءَكُمْ أُمَّةٌ مِنَ الْأُمَمِ خَدَمَتْهُمْ كَمَا تَخْدُمُكُمْ نِسَاءُ الْأُمَمِ قَبْلَكُمْ  .","","Al-Mu'jam al-Kabir 14739","","عبد الله بن عمرو بن العاص عن عيسى بن هلال السليحي عن عياش بن عباس القتباني عن عبد الله بن عياش القتباني عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","عيسى بن هلال الصدفي"
"14779","14740  -  أَخْبَرَنَا  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ بْنِ مِقْلَاصٍ الْمِصْرِيُّ ، قَالَ :  ثَنَا  أَبِي  قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي أَيُّوبَ ،  عَنْ  دَرَّاجٍ أَبِي السَّمْحِ ،  عَنْ  عِيسَى بْنِ هِلَالٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،         [14/121]      قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُمِرْتُ بِيَوْمِ الْأَضْحَى عِيدٍ ، جَعَلَهُ لِهَذِهِ الْأُمَّةِ  ، فَقَالَ  رَجُلٌ  : أَرَأَيْتَ إِنْ لَمْ أَجِدْ إِلَّا مِنْحَةَ أَهْلِي أَفَأُضَحِّي بِهَا ؟ فَقَالَ : لَا ، وَلَكِنْ قَلِّمْ أَظْفَارَكَ ، وَاحْلِقْ عَانَتَكَ ، وَخُذْ شَارِبَكَ ، فَذَاكَ تَمَامُ أُضْحِيَّتِكَ  .","","Al-Mu'jam al-Kabir 14740","","عبد الله بن عمرو بن العاص عن عيسى بن هلال السليحي عن دراج أبي السمح عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن وهب المصري عن عبد العزيز بن عمران المصري عن عمر بن عبد العزيز الخزاعي عن الطبراني","عيسى بن هلال الصدفي"
"14780","14741  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ         [14/122]      الْمُقْرِئُ ،  عَنْ  سَعِيدِ بْنِ أَبِي أَيُّوبَ ، قَالَ :  حَدَّثَنِي  عَيَّاشُ بْنُ عَبَّاسٍ (  ح  ) .  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  عَيَّاشُ بْنُ عَبَّاسٍ ،  عَنْ  عِيسَى بْنِ هِلَالٍ الصَّدَفِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو :  أَنَّ  رَجُلًا  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، أَقْرِئْنِي ، قَالَ :  أُقْرِئُكَ مِنْ ذَوَاتِ الْحَوَامِيمِ ؟  قَالَ : يَا رَسُولَ اللهِ ، ثَقُلَ لِسَانِي وَغَلُظَ كَبِدِي ، قَالَ : أُقْرِئُكَ مِنْ ذَوَاتِ الر ؟ فَقَالَ لَهُ مِثْلَ قَوْلِهِ ، قَالَ : أُقْرِئُكَ مِنْ ذَوَاتِ الْمُسَبِّحَاتِ ؟ فَقَالَ لَهُ مِثْلَ قَوْلِهِ الْأَوَّلِ ،         [14/123]      فَقَالَ : عَلَيْكَ بِالسُّورَةِ  الْجَامِعَةِ  الْفَاذَّةِ  ، فَأَقْرَأَهُ :         {      إِذَا زُلْزِلَتِ الأَرْضُ زِلْزَالَهَا         }      فَقَالَ الْأَعْرَابِيُّ : حَسْبِي ، ثُمَّ أَدْبَرَ ، وَنَادَاهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَرَجَعَ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنِّي أُمِرْتُ بِالْأُضْحِيَةِ ، فَانْسُكْ  نَسِيكَةَ  يَوْمِ الْأَضْحَى . فَقَالَ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ إِنْ لَمْ أَجِدْ إِلَّا شَاةَ أَهْلِي ؟ قَالَ : لَا ، وَلَكِنِ اقْصُرْ شَارِبَكَ وَقَلِّمْ أَظْفَارَكَ فَإِنَّهُ مِنْ تَمَامِ أُضْحِيَّتِكَ .  زَادَ  الْمُقْرِئُ  فِي حَدِيثِهِ : وَتَحْلِقُ عَانَتَكَ .","","Al-Mu'jam al-Kabir 14741","","عبد الله بن عمرو بن العاص عن عيسى بن هلال السليحي عن عياش بن عباس القتباني عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","عيسى بن هلال الصدفي"
"14781","14742  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ، قَالَ :  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ، أَنَّ عَيَّاشَ بْنَ عَبَّاسٍ  حَدَّثَهُمْ  ،  عَنْ  عِيسَى بْنِ هِلَالٍ الصَّدَفِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو :  أَنَّ  رَجُلًا  أَتَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، أَقْرِئْنِي  ....ثُمَّ ذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14742","","عبد الله بن عمرو بن العاص عن عيسى بن هلال السليحي عن عياش بن عباس القتباني عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن إبراهيم بن المنذر الحزامي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","عيسى بن هلال الصدفي"
"14782","[14/124]      14743  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  حَدَّثَنِي  خَالِدُ بْنُ يَزِيدَ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عَبْدِ اللهِ ،  عَنْ  عِيسَى بْنِ هِلَالٍ الصَّدَفِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ :  إِنَّ الْعَبْدَ لَيُكْتَبُ مُؤْمِنًا أَحْقَابًا ثُمَّ أَحْقَابًا  ، ثُمَّ يَمُوتُ وَاللهُ عَلَيْهِ سَاخِطٌ . وَإِنَّ الْعَبْدَ لَيُكْتَبُ كَافِرًا أَحْقَابًا ثُمَّ أَحْقَابًا ، ثُمَّ يَمُوتُ وَاللهُ عَنْهُ رَاضٍ . مَنْ مَاتَ هَمَّازًا لَمَّازًا مُلَقِّبًا لِلنَّاسِ ، كَانَ عَلَامَتُهُ يَوْمَ الْقِيَامَةِ أَنْ  يَسِمَهُ  اللهُ عَلَى الْخُرْطُومِ مِنْ كِلَا الشِّقَّيْنِ  .","","Al-Mu'jam al-Kabir 14743","","عبد الله بن عمرو بن العاص عن عيسى بن هلال السليحي عن عبد الملك بن عبد الله عن سعيد بن أبي هلال الليثي عن خالد بن يزيد الجمحي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عيسى بن هلال الصدفي"
"14783","14744  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ، قَالَ :  ثَنَا  يَحْيَى بْنُ إِسْحَاقَ السَّيْلَحِينِيُّ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  دَرَّاجٍ أَبِي السَّمْحِ ،  عَنْ  عِيسَى بْنِ هِلَالٍ الصَّدَفِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         [14/125]      إِنَّ أَرْوَاحَ الْمُؤْمِنِينَ تَلْتَقِي عَلَى  مَسِيرَةِ  يَوْمٍ وَلَيْلَةٍ  ، وَمَا رَأَى وَاحِدٌ مِنْهُمَا وَجْهَ صَاحِبِهِ  .","","Al-Mu'jam al-Kabir 14744","","عبد الله بن عمرو بن العاص عن عيسى بن هلال السليحي عن دراج أبي السمح عن عبد الله بن لهيعة عن يحيى بن إسحاق السيلحيني عن بشر بن موسى بن صالح الأسدي عن الطبراني","عيسى بن هلال الصدفي"
"14784","14745  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ، قَالَ :  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ، قَالَ :  ثَنَا  ابْنُ الْمُبَارَكِ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ يَزِيدَ أَبُو شُجَاعٍ الْمِصْرِيُّ ،  عَنْ  أَبِي السَّمْحِ ،  عَنْ  عِيسَى بْنِ هِلَالٍ الصَّدَفِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ         [14/126]      عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ أَنَّ رَصَاصَةً مِثْلَ هَذِهِ  - وَأَشَارَ إِلَى مِثْلِ الْجُمَانَةِ - أُرْسِلَتْ مِنَ السَّمَاءِ إِلَى الْأَرْضِ ، وَهِيَ  مَسِيرَةُ  خَمْسِمِائَةِ سَنَةٍ لَبَلَغَتِ الْأَرْضَ قَبْلَ اللَّيْلِ ، وَلَوْ أَنَّهَا أُرْسِلَتْ مِنْ رَأْسِ السِّلْسِلَةِ لَسَارَتْ أَرْبَعِينَ  خَرِيفًا  اللَّيْلَ وَالنَّهَارَ قَبْلَ أَنْ تَبْلُغَ أَصْلَهَا فِي قَعْرِهَا  .","","Al-Mu'jam al-Kabir 14745","","عبد الله بن عمرو بن العاص عن عيسى بن هلال السليحي عن دراج أبي السمح عن سعيد بن يزيد الحميري عن عبد الله بن المبارك عن نعيم بن حماد الخزاعي عن يوسف بن يزيد القراطيسي عن الطبراني","عيسى بن هلال الصدفي"
"14785","[14/127]      14746  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ، قَالَ :  ثَنَا  الْمُقْرِئُ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  عَنْ  كَعْبِ بْنِ عَلْقَمَةَ ،  عَنْ  عِيسَى بْنِ هِلَالٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  ذَكَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الصَّلَاةَ ، فَقَالَ :  مَنْ حَافَظَ عَلَيْهَا كَانَتْ لَهُ نُورٌ  وَبُرْهَانٌ  ، وَمَنْ لَمْ يُحَافِظْ عَلَيْهَا لَمْ يَكُنْ لَهُ         [14/128]      نُورٌ وَلَا  بُرْهَانٌ  ، وَكَانَ مَعَ  فِرْعَوْنَ  وَهَامَانَ  وَأُبَيِّ بْنِ خَلَفٍ  .","","Al-Mu'jam al-Kabir 14746","","عبد الله بن عمرو بن العاص عن عيسى بن هلال السليحي عن كعب بن علقمة بن كعب عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","عيسى بن هلال الصدفي"
"14786","أَبُو قَبِيلٍ  14747  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ، قَالَ :  ثَنَا  كَثِيرُ بْنُ السَّرِيِّ  الْعَسْقَلَانِيُّ ، قَالَ :  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ، قَالَ :  حَدَّثَنِي  مُعَاوِيَةُ بْنُ سَعِيدٍ         [14/129]      التُّجِيبِيُّ ،  عَنْ  أَبِي قَبِيلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ مَاتَ يَوْمَ الْجُمُعَةِ  وَلَيْلَةَ الْجُمُعَةِ وُقِيَ فِتْنَةَ الْقَبْرِ  .  كذا في طبعة الجريسي والنسخة الخطية ، ولعل الصواب : (بن أبي السري) ، وهو محمد كما عند المصنف في الأوسط ، والله أعلم .","","Al-Mu'jam al-Kabir 14747","","عبد الله بن عمرو بن العاص عن حيي بن هانئ السريعي عن معاوية بن سعيد بن شريح التجيبي عن بقية بن الوليد عن محمد بن المتوكل بن ابى السرى عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","أبو قبيل"
"14787","14748  -  حَدَّثَنَا  أَحْمَدُ بْنُ حَمَّادٍ ابْنُ زُغْبَةَ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  أَبِي قَبِيلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو :         [14/130]      أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ اسْتَعَاذَ مِنْ سَبْعٍ  ، مِنْ مَوْتِ الْفَجْأَةِ ، وَمِنْ لَدْغِ الْحَيَّةِ ، وَمِنْ أَكْلِ السَّبُعِ ، وَمِنَ  الْحَرَقِ  ، وَمِنَ  الْغَرَقِ  ، وَمِنْ أَنْ يَخِرَّ عَلَيْهِ شَيْءٌ ، وَمِنَ الْقَتْلِ فِرَارًا مِنَ  الزَّحْفِ  .","","Al-Mu'jam al-Kabir 14748","","عبد الله بن عمرو بن العاص عن حيي بن هانئ السريعي عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن زغبة ، أحمد بن حماد بن مسلم التجيبي عن الطبراني","أبو قبيل"
"14788","14749  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ، قَالَ :  ثَنَا  يَحْيَى بْنُ إِسْحَاقَ السَّيْلَحِينِيُّ ، قَالَ :  ثَنَا  يَحْيَى بْنُ أَيُّوبَ (  ح  ) .  وَحَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ، قَالَ :  ثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  أَبِي قَبِيلٍ ،  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عَمْرٍو ، يَقُولُ - وَقَدْ ذَكَرُوا فَتْحَ  الْقُسْطَنْطِينِيَّةِ  وَرُومِيَّةَ  أَيُّهُمَا تُفْتَحُ قَبْلُ ؟ فَدَعَا عَبْدُ اللهِ بِصُنْدُوقٍ فَفَتَحَ - فَقَالَ : كُنَّا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَكْتُبُ مَا نَسْمَعُ مِنْهُ ، فَقُلْنَا : أَيُّ الْمَدِينَتَيْنِ تُفْتَحُ قَبْلُ يَا رَسُولَ اللهِ ؟ قَالَ :  مَدِينَةُ  هِرَقْلَ  . يُرِيدُ  مَدِينَةَ الْقُسْطَنْطِينِيَّةِ  .","","Al-Mu'jam al-Kabir 14749","","عبد الله بن عمرو بن العاص عن حيي بن هانئ السريعي عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","أبو قبيل"
"14789","[14/131]      14750  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ سُفْيَانَ الْحَضْرَمِيُّ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي قَبِيلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا مَلَكَ الْعَتِيقَانِ  - عَتِيقُ الْعَرَبِ وَعَتِيقُ الرُّومِ - كَانَتْ عَلَى أَيْدِيهِمَا الْمَلَاحِمُ  .","","Al-Mu'jam al-Kabir 14750","","عبد الله بن عمرو بن العاص عن حيي بن هانئ السريعي عن عبد الله بن لهيعة عن محمد بن سفيان الحضرمي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","أبو قبيل"
"14790","14751  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ ، قَالَ :  ثَنَا  عَبْدُوسُ بْنُ مُحَمَّدٍ الْمِصْرِيُّ ، قَالَ :  ثَنَا  مَنْصُورُ بْنُ عَمَّارٍ ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  أَبِي قَبِيلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  شِعَارُ  أُمَّتِي إِذَا حُمِلُوا عَلَى الصِّرَاطِ  لَا إِلَهَ إِلَّا أَنْتَ  .","","Al-Mu'jam al-Kabir 14751","","عبد الله بن عمرو بن العاص عن حيي بن هانئ السريعي عن عبد الله بن لهيعة عن منصور بن عمار  الخراساني عن عبدوس بن محمد البغدادي عن أحمد بن يحيى بن خالد الرقي عن الطبراني","أبو قبيل"
"14791","[14/132]      14752  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ ، قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي يَحْيَى بْنِ خَالِدٍ  ، قَالَ :  ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي حَيَّةَ ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  أَبِي قَبِيلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ يُحِبُّ مَنْ يُحِبُّ التَّمْرَ  .","","Al-Mu'jam al-Kabir 14752","","عبد الله بن عمرو بن العاص عن حيي بن هانئ السريعي عن عبد الله بن لهيعة عن نعيم إبراهيم بن أبي حية عن يحيى بن خالد عن أحمد بن يحيى بن خالد الرقي عن الطبراني","أبو قبيل"
"14792","14753  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ سُفْيَانَ الْمِصْرِيُّ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي قَبِيلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  سَتَكُونُ فِتْنَةٌ يُفَارِقُ الرَّجُلُ فِيهَا أَخَاهُ وَأَبَاهُ  ، تَطِيرُ الْفِتْنَةُ فِي قُلُوبِ رِجَالٍ مِنْهُمْ إِلَى يَوْمِ الْقِيَامَةِ ، حَتَّى يُعَيَّرَ الرَّجُلُ بِهَا ، كَمَا تُعَيَّرُ الزَّانِيَةُ بِزِنَاهَا  .","","Al-Mu'jam al-Kabir 14753","","عبد الله بن عمرو بن العاص عن حيي بن هانئ السريعي عن عبد الله بن لهيعة عن محمد بن سفيان العامري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","أبو قبيل"
"14793","14754  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ سُفْيَانَ الْحَضْرَمِيُّ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي قَبِيلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،         [14/133]      أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَتَتْكُمُ الْقُرَيْعَاءُ  ، قُلْنَا : وَمَا هِيَ ، يَا رَسُولَ اللهِ ؟ قَالَ : فِتْنَةٌ يَكُونُ فِيهَا مِثْلُ الْبَيْضَةِ  .","","Al-Mu'jam al-Kabir 14754","","عبد الله بن عمرو بن العاص عن حيي بن هانئ السريعي عن عبد الله بن لهيعة عن محمد بن سفيان الحضرمي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","أبو قبيل"
"14794","14755  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هِشَامٍ الْمُسْتَمْلِي ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ الْفِهْرِيُّ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي قَبِيلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَحْبِبْ حَبِيبَكَ  هَوْنًا  مَا  ، عَسَى أَنْ يَكُونَ بَغِيضَكَ يَوْمًا مَا ، وَأَبْغِضْ بَغِيضَكَ  هَوْنًا  مَا ، عَسَى أَنْ يَكُونَ حَبِيبَكَ يَوْمًا مَا  .","","Al-Mu'jam al-Kabir 14755","","عبد الله بن عمرو بن العاص عن حيي بن هانئ السريعي عن عبد الله بن لهيعة عن محمد بن كثير بن مروان الفهري عن ابن أبى الدميك محمد بن هشام بن علي عن الطبراني","أبو قبيل"
"14795","14756  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، قَالَ :  ثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ، قَالَ :  ثَنَا  ضِمَامُ بْنُ إِسْمَاعِيلَ ،  عَنْ  أَبِي قَبِيلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :         [14/134]      قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  زُرْ  غِبًّا ،  تَزْدَدْ حُبًّا  .","","Al-Mu'jam al-Kabir 14756","","عبد الله بن عمرو بن العاص عن حيي بن هانئ السريعي عن ضمام بن إسماعيل المرادي عن سويد بن سعيد الحدثاني عن معاذ بن المثنى العنبري عن الطبراني","أبو قبيل"
"14796","عِمْرَانُ بْنُ عَبْدٍ الْمَعَافِرِيُّ  14757  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  أَبُو نُعَيْمٍ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  عِمْرَانَ بْنِ عَبْدٍ الْمَعَافِرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ دَيْنٍ مَأْخُوذٌ مِنْ حَسَنَاتِ صَاحِبِهِ  ، إِلَّا مَنِ  ادَّانَ  فِي ثَلَاثٍ : رَجُلٌ ضَعُفَتْ قُوَّتُهُ فِي  سَبِيلِ  اللهِ فَتَقَوَّى عَلَى قِتَالِ عَدُوِّهِ بِدَيْنٍ فَمَاتَ وَلَمْ يَقْضِ ، وَرَجُلٌ خَافَ عَلَى نَفْسِهِ الْعُزُوبَةَ فَاسْتَعَفَّ بِنِكَاحِ امْرَأَةٍ بِدَيْنٍ فَمَاتَ وَلَمْ يَقْضِ ، وَرَجُلٌ مَاتَ عِنْدَهُ رَجُلٌ مُسْلِمٌ فَلَمْ يَجِدْ مَا يَكْفِيهِ إِلَّا بِدَيْنٍ         [14/135]      فَمَاتَ وَلَمْ يَقْضِ ، قُضِيَ عَنْهُمْ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 14757","","عبد الله بن عمرو بن العاص عن عمران بن عبد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمران بن عبد المعافري"
"14797","14758  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  حَدَّثَنِي  عِمْرَانُ بْنُ عَبْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  ثَلَاثَةٌ مَنِ  ادَّانَ  فِيهِمْ ثُمَّ مَاتَ وَلَمْ يَقْضِ قَضَاهُ اللهُ عَزَّ وَجَلَّ  : رَجُلٌ يَكُونُ فِي  سَبِيلِ  اللهِ فَتَضْعُفُ قُوَّتُهُ فَيَتَقَوَّى بِدَيْنٍ لِعَدُوِّهِ فَيَمُوتُ وَلَمْ يَقْضِ ، وَرَجُلٌ مَاتَ عِنْدَهُ رَجُلٌ مِنْكُمْ ، فَلَمْ يَجِدْ مَا يَكْفِيهِ وَلَا مَا يُوَارِيهِ إِلَّا بِدَيْنٍ ، فَيَمُوتُ وَلَمْ يَقْضِ ، وَرَجُلٌ خَافَ عَلَى نَفْسِهِ الْفِتْنَةَ فِي الْعُزُوبَةِ فَاسْتَعَفَّ بِنِكَاحِ امْرَأَةٍ بِدَيْنٍ فَمَاتَ وَلَمْ يَقْضِ ، فَإِنَّ اللهَ عَزَّ وَجَلَّ يَقْضِي عَنْهُمْ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 14758","","عبد الله بن عمرو بن العاص عن عمران بن عبد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","عمران بن عبد المعافري"
"14798","[14/136]      14759  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ، قَالَ :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  حَدَّثَنِي  عِمْرَانُ بْنُ عَبْدٍ الْمَعَافِرِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  ثَلَاثَةٌ لَا تُقْبَلُ لَهُمْ صَلَاةٌ  : مَنْ تَقَدَّمَ قَوْمًا وَهُمْ لَهُ كَارِهُونَ ، وَرَجُلٌ أَتَى الصَّلَاةَ  دِبَارًا  -  وَالدِّبَارُ  : أَنْ يَأْتِيَ بَعْدَ الْوَقْتِ - وَرَجُلٌ  اعْتَبَدَ  مُحَرَّرَهُ  .","","Al-Mu'jam al-Kabir 14759","","عبد الله بن عمرو بن العاص عن عمران بن عبد المعافري عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","عمران بن عبد المعافري"
"14799","[14/137]      أَحَادِيثُ  عَبْدِ اللهِ بْنِ جَعْفَرِ بْنِ أَبِي طَالِبٍ  يُكْنَى  أَبَا جَعْفَرٍ  ، وَأُمُّهُ :  أَسْمَاءُ بِنْتُ عُمَيْسِ بْنِ النُّعْمَانِ بْنِ كَعْبِ بْنِ مَالِكِ بْنِ قُحَافَةَ بْنِ خَثْعَمَ  ، وَوُلِدَ  عَبْدُ اللهِ  بِأَرْضِ الْحَبَشَةِ .  ذِكْرُ سِنِّ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  وَوَفَاتِهِ  14760  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامِ بْنِ حَفْصِ بْنِ غِيَاثٍ  ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ  ،  قَالَ  :  وَفِيهَا مَاتَ  عَبْدُ اللهِ بْنُ جَعْفَرِ بْنِ أَبِي طَالِبٍ  بِالْمَدِينَةِ  ، وَيُكْنَى  أَبَا جَعْفَرٍ ،  يَعْنِي : سَنَةَ ثَمَانِينَ  .","","Al-Mu'jam al-Kabir 14760","","","ذكر سن عبد الله بن جعفر ووفاته"
"14800","14761  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ ، قَالَ :  ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ ، قَالَ :  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ :  كَانَ عَبْدُ اللهِ بْنُ جَعْفَرٍ يَخْضِبُ بِالْحِنَّاءِ  .","","Al-Mu'jam al-Kabir 14761","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن محمد بن إسحاق عن زياد بن عبد الله البكائي عن عبد الملك بن هشام الذهلي عن عبد الرحيم بن عبد الله البرقي عن الطبراني","ذكر سن عبد الله بن جعفر ووفاته"
"14801","[14/138]      مَا انْتَهَى إِلَيْنَا مِنْ  مُسْنَدِ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  14762  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ أَيُّوبَ صَاحِبُ الْمَغَازِي ، قَالَ :  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أُمِرْتُ أَنْ أُبَشِّرَ  خَدِيجَةَ  بِبَيْتٍ  فِي الْجَنَّةِ  مِنْ  قَصَبٍ ،  لَا  صَخَبَ  فِيهِ وَلَا  نَصَبَ  .","","Al-Mu'jam al-Kabir 14762","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن أحمد بن محمد بن أيوب عن عبد الله بن أحمد بن حنبل عن الطبراني","ما انتهى إلينا من مسند عبد الله بن جعفر"
"14802","14763  -  حَدَّثَنَا  الْحَسَنُ بْنُ جَرِيرٍ الصُّورِيُّ ، قَالَ :  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ، قَالَ :  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  هِشَامِ بْنِ         [14/139]      عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ وَعَبْدِ اللهِ بْنِ الزُّبَيْرِ :  أَنَّهُمَا أَتَيَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُمَا ابْنَا سَبْعِ سِنِينَ  ، فَلَمَّا رَآهُمَا تَبَسَّمَ ، وَمَدَّ يَدَهُ فَبَايَعَهُمَا  .","","Al-Mu'jam al-Kabir 14763","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن إسماعيل بن عياش الأحول عن سليمان بن عبد الرحمن التميمي عن الحسن بن جرير الزنبقي عن الطبراني","ما انتهى إلينا من مسند عبد الله بن جعفر"
"14803","14764  -  حَدَّثَنَا  أَبُو صَالِحٍ الْقَاسِمُ بْنُ اللَّيْثِ الرَّاسِبِيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ أَبِي صَفْوَانَ الثَّقَفِيُّ ، قَالَ :  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ، قَالَ :  ثَنَا  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، قَالَ :  لَمَّا تُوُفِّيَ  أَبُو طَالِبٍ  خَرَجَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  الطَّائِفِ  مَاشِيًا عَلَى قَدَمَيْهِ ، فَدَعَاهُمْ إِلَى الْإِسْلَامِ فَلَمْ يُجِيبُوهُ ،         [14/140]      فَانْصَرَفَ ، فَأَتَى ظِلَّ شَجَرَةٍ ، فَصَلَّى رَكْعَتَيْنِ ، ثُمَّ قَالَ :  اللَّهُمَّ إِلَيْكَ أَشْكُو ضَعْفَ قُوَّتِي  ، وَقِلَّةَ حِيلَتِي ، وَهَوَانِي عَلَى النَّاسِ ، أَرْحَمَ الرَّاحِمِينَ ، أَنْتَ أَرْحَمُ الرَّاحِمِينَ ، إِلَى مَنْ تَكِلُنِي ؟ إِلَى عَدُوٍّ  يَتَجَهَّمُنِي ،  أَمْ إِلَى قَرِيبٍ مَلَّكْتَهُ أَمْرِي ، إِنْ لَمْ تَكُنْ غَضْبَانًا عَلَيَّ فَلَا  أُبَالِي  ، إِنَّ عَافِيَتَكَ أَوْسَعُ لِي ، أَعُوذُ بِنُورِ وَجْهِكَ الَّذِي أَشْرَقَتْ لَهُ         [14/141]      الظُّلُمَاتُ ، وَصَلُحَ عَلَيْهِ أَمْرُ الدُّنْيَا وَالْآخِرَةِ أَنْ تُنْزِلَ بِي غَضَبَكَ ، أَوْ تُحِلَّ عَلَيَّ سَخَطَكَ ، لَكَ الْعُتْبَى حَتَّى تَرْضَى ، وَلَا قُوَّةَ إِلَّا بِكَ  .","","Al-Mu'jam al-Kabir 14764","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن إسحاق عن جرير بن حازم عن وهب بن جرير بن حازم عن محمد بن عثمان بن أبي صفوان الثقفي عن القاسم بن الليث بن مسرور الرسعني عن الطبراني","ما انتهى إلينا من مسند عبد الله بن جعفر"
"14804","14765  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ، قَالَ :  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَالِكٍ ، قَالَ :  ثَنَا  عَمْرُو بْنُ عَبْدِ الْغَفَّارِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَأْكُلُ الْبِطِّيخَ بِالرُّطَبِ  .","","Al-Mu'jam al-Kabir 14765","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عمرو بن عبد الغفار الفقيمي عن إبراهيم بن مالك بن بهبوذ البزاز عن البزار عن الطبراني","ما انتهى إلينا من مسند عبد الله بن جعفر"
"14805","[14/142]      مَا  أَسْنَدَ  أَبُو جَعْفَرٍ مُحَمَّدُ بْنُ عَلِيِّ بْنِ حُسَيْنٍ  ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  14766  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ الْمِصْرِيُّ ، قَالَ :  ثَنَا  أَسَدُ بْنُ مُوسَى ، قَالَ :  ثَنَا  شَيْبَانُ ،  عَنْ  جَابِرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ احْتَجَمَ بَعْدَمَا سُمَّ  .","","Al-Mu'jam al-Kabir 14766","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن أبو جعفر الباقر عن جابر الجعفي عن شيبان بن عبد الرحمن المؤدب عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","ما أسند أبو جعفر محمد بن علي بن حسين عن عبد الله بن جعفر"
"14806","14767  -  حَدَّثَنَا  أَحْمَدُ بْنُ خُلَيْدٍ الْحَلَبِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ الزُّبَيْرِ الْحُمَيْدِيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي فُدَيْكٍ ، قَالَ :  حَدَّثَنِي  سَعِيدُ بْنُ سُفْيَانَ الْأَسْلَمِيُّ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ جَلَّ وَعَزَّ مَعَ الْمَدِينِ ، حَتَّى يَقْضِيَ دَيْنَهُ  ، مَا لَمْ يَكُنْ دَيْنُهُ فِيمَا يَكْرَهُ اللهُ  .","","Al-Mu'jam al-Kabir 14767","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن أبو جعفر الباقر عن جعفر الصادق عن سعيد بن سفيان الأسلمي عن محمد بن إسماعيل بن مسلم الديلي عن الحميدي عن أحمد بن خليد بن يزيد الحلبي عن الطبراني","ما أسند أبو جعفر محمد بن علي بن حسين عن عبد الله بن جعفر"
"14807","[14/143]      14768  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ الْمَكِّيُّ ، قَالَ :  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدِ بْنِ كَاسِبٍ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ أَبِي عَلِيٍّ الْهَاشِمِيُّ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَرْدَفَهُ ، فَقَالَ :  يَا فَتَى ، أَلَا أَهَبُ لَكَ ؟ أَلَا أُعَلِّمُكَ كَلِمَاتٍ يَنْفَعُكَ اللهُ بِهِنَّ ؟  احْفَظِ اللهَ يَحْفَظْكَ ، احْفَظِ اللهَ تَجِدْهُ أَمَامَكَ ، وَإِذَا سَأَلْتَ فَسَلِ اللهَ ، وَإِذَا اسْتَعَنْتَ فَاسْتَعِنْ بِاللهِ ، وَاعْلَمْ أَنْ قَدْ جَفَّ الْقَلَمُ بِمَا هُوَ كَائِنٌ ، وَاعْلَمْ أَنَّ الْخَلَائِقَ لَوْ أَرَادُوكَ بِشَيْءٍ لَمْ يُكْتَبْ عَلَيْكَ لَمْ يَقْدِرُوا عَلَيْكَ ، وَاعْلَمْ أَنَّ النَّصْرَ مَعَ الصَّبْرِ ، وَأَنَّ الْفَرَجَ مَعَ الْكَرْبِ ، وَأَنَّ مَعَ الْعُسْرِ يُسْرًا  .","","Al-Mu'jam al-Kabir 14768","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن أبو جعفر الباقر عن جعفر الصادق عن علي بن أبي علي اللهبي عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","ما أسند أبو جعفر محمد بن علي بن حسين عن عبد الله بن جعفر"
"14808","[14/144]      مَا  أَسْنَدَ  إِسْمَاعِيلُ بْنُ عَبْدِ اللهِ بْنِ جَعْفَرٍ  ، عَنْ أَبِيهِ .  14769  -  حَدَّثَنَا  مُحَمَّدُ بْنُ [الْحُسَيْنِ] الْأَنْمَاطِيُّ الْبَغْدَادِيُّ ، قَالَ :  ثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ بْنِ مُصْعَبٍ الزُّبَيْرِيُّ ، قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  إِسْمَاعِيلَ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَوْبَيْنِ مَصْبُوغَيْنِ بِزَعْفَرَانٍ  ، [رِدَاءً وَعِمَامَةً]  .","","Al-Mu'jam al-Kabir 14769","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن إسماعيل بن عبد الله بن جعفر بن أبي طالب الهاشمي عن عبد الله بن مصعب بن ثابت الزبيري عن مصعب بن عبد الله بن مصعب الزبيري عن محمد بن الحسين الأنماطي عن الطبراني","ما أسند إسماعيل بن عبد الله بن جعفر عن أبيه"
"14809","[14/145]      مَا  أَسْنَدَ  مُعَاوِيَةُ بْنُ عَبْدِ اللهِ بْنِ جَعْفَرٍ  ، عَنْ أَبِيهِ  14770  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ الْمِصْرِيُّ ، قَالَ :  ثَنَا  أَبُو صَالِحٍ عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ الْهَادِ ،  عَنْ  مُعَاوِيَةَ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى قَوْمٍ يَرْمُونَ كَبْشًا بِالنَّبْلِ ، فَقَالَ :  لَا تُمَثِّلُوا بِالْبَهَائِمِ  .","","Al-Mu'jam al-Kabir 14770","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن معاوية بن عبد الله بن جعفر بن أبي طالب عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","ما أسند معاوية بن عبد الله بن جعفر عن أبيه"
"14810","14771  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ، قَالَ :  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ يَحْيَى الْمَدَنِيُّ ، قَالَ :  ثَنَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  عَمْرِو بْنِ أَبِي عَمْرٍو ،  عَنْ  مُعَاوِيَةَ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  وَقَفَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  حَمْزَةَ  يَوْمَ أُحُدٍ  وَهُوَ يَدْفِنُهُ ، فَلُفَّ فِي  نَمِرَةٍ  فَبَدَتْ قَدَمَاهُ حِينَ  خَمَّرُوا  رَأْسَهُ ، فَأَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ [بِالْحَرْمَلِ] ؛ فَجُعِلَ عَلَى         [14/146]      قَدَمَيْهِ ، وَقَالَ :  لَوْلَا أَنْ تَحْزَنَ نِسَاؤُنَا لِذَلِكَ لَتَرَكْنَاهُ بِالْعَرَاءِ  لِعَافِيَةِ  السِّبَاعِ  وَالطَّيْرِ  .","","Al-Mu'jam al-Kabir 14771","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن معاوية بن عبد الله بن جعفر بن أبي طالب عن عمرو بن أبي عمرو المخزومي عن سليمان بن بلال القرشي عن عبد العزيز بن يحيى بن عبد الله الهاشمي عن محمد بن علي بن زيد الصائغ عن الطبراني","ما أسند معاوية بن عبد الله بن جعفر عن أبيه"
"14811","14772  -  حَدَّثَنَا  أَحْمَدُ بْنُ [زُهَيْرٍ التُّسْتَرِيُّ] ، وَأَبُو حَامِدٍ الْأَصْبَهَانِيُّ ، قَالَا :  ثَنَا  أَبُو زُرْعَةَ عُبَيْدُ اللهِ بْنُ عَبْدِ الْكَرِيمِ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ جَعْفَرِ بْنِ إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ عَلِيِّ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرِ بْنِ أَبِي طَالِبٍ ،  ثَنَا  عَمِّي مُوسَى بْنُ جَعْفَرٍ ،  عَنْ  صَالِحِ بْنِ مُعَاوِيَةَ ،  عَنْ  أَخِيهِ عَبْدِ اللهِ بْنِ مُعَاوِيَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  عَلِيٌّ  أَصْلِي ،  وَجَعْفَرٌ  فَرْعِي  ، أَوْ :  جَعْفَرٌ  أَصْلِي ،  وَعَلِيٌّ  فَرْعِي  .","","Al-Mu'jam al-Kabir 14772","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن معاوية بن عبد الله بن جعفر بن أبي طالب عن عبد الله بن معاوية بن عبد الله بن جعفر بن أبي طالب عن صالح بن معاوية عن موسى بن جعفر العلوي عن محمد بن إسماعيل بن جعفر الجعفري عن أبو زرعة الرازي عن محمود بن علي بن مالك الشيباني عن الطبراني","ما أسند معاوية بن عبد الله بن جعفر عن أبيه"
"14812","[14/147]      عَلِيُّ بْنُ عَبْدِ اللهِ بْنِ جَعْفَرٍ  ، عَنْ أَبِيهِ  14773  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ هَارُونَ بْنِ مُوسَى الْأَوْدِيُّ ، قَالَ :  حَدَّثَنَا  قُدَامَةُ بْنُ مُحَمَّدٍ الْأَشْجَعِيُّ ،  عَنْ  مَخْرَمَةَ بْنِ بُكَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَلِيِّ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَنِيئًا لَكَ يَا  عَبْدَ اللهِ  ، أَبُوكَ يَطِيرُ مَعَ الْمَلَائِكَةِ فِي السَّمَاءِ  .","","Al-Mu'jam al-Kabir 14773","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن علي بن عبد الله بن جعفر عن بكير بن عبد الله بن الأشج القرشي عن مخرمة بن بكير المخزومي عن قدامة بن محمد بن قدامة الخشرمي عن عبد الله بن هارون بن موسى الفروي عن الساجي عن الطبراني","علي بن عبد الله بن جعفر عن أبيه"
"14813","إِسْحَاقُ بْنُ عَبْدِ اللهِ بْنِ جَعْفَرٍ  ، عَنْ أَبِيهِ  14774  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ :  حَدَّثَنِي  أَبِي  ، قَالَ :  ثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  عَنْ  كَثِيرِ بْنِ زَيْدٍ ،  عَنْ  إِسْحَاقَ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  أَبِيهِ  ،  فِي هَؤُلَاءِ الْكَلِمَاتِ : لَا إِلَهَ إِلَّا اللهُ الْحَلِيمُ الْعَظِيمُ ، سُبْحَانَ اللهِ رَبِّ الْعَرْشِ الْكَرِيمُ ، وَالْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ ، قَالَ : كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  لَقِّنُوهَا مَوْتَاكُمْ  ، قَالُوا : يَا رَسُولَ اللهِ ، فَكَيْفَ هِيَ لِلْأَحْيَاءِ ؟ قَالَ : أَجْوَدُ وَأَجْوَدُ  .","","Al-Mu'jam al-Kabir 14774","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن إسحاق بن عبد الله بن جعفر بن أبي طالب عن كثير بن زيد السهمي عن أبو عامر العقدي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","إسحاق بن عبد الله بن جعفر عن أبيه"
"14814","[14/148]      مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ جَعْفَرٍ  ، عَنْ أَبِيهِ .  14775  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ، قَالَ :  ثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ الشَّاذَكُونِيُّ ، قَالَ :  ثَنَا  إِسْمَاعِيلُ بْنُ عُبَيْدِ اللهِ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ مَوْهَبٍ ، أَنَّ  إِبْرَاهِيمَ بْنَ مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ  أَخْبَرَهُ  ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنْتُ مَعَ عَبْدِ اللهِ بْنِ جَعْفَرٍ ، إِذْ جَاءَ رَجُلٌ فَقَالَ : مُرْنِي بِدَعَوَاتٍ يَنْفَعُنِي اللهُ بِهِنَّ ،  فَقَالَ  : نَعَمْ ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَأَلَهُ  رَجُلٌ  عَمَّا سَأَلْتَنِي عَنْهُ ، فَقَالَ :  سَلِ اللهَ  الْعَفْوَ  وَالْعَافِيَةَ فِي الدُّنْيَا وَالْآخِرَةِ  .","","Al-Mu'jam al-Kabir 14775","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن محمد بن علي بن عبد الله الهاشمي عن إبراهيم بن محمد بن علي الجعفري عن عبد الله بن موهب الهمداني عن إسماعيل بن عبيد الله عن الشاذكوني عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","محمد بن عبد الله بن جعفر عن أبيه"
"14815","الْحَسَنُ بْنُ سَعْدٍ مَوْلَى الْحَسَنِ بْنِ عَلِيٍّ  ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  14776  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ، (  ح  ) .         [14/149]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ ، قَالَ :  ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ، (  ح  ) .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ، قَالَ :  ثَنَا  مَهْدِيُّ بْنُ مَيْمُونٍ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ         [14/150]      [أَبِي يَعْقُوبَ ] ،  عَنِ  الْحَسَنِ بْنِ سَعْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، قَالَ :  أَرْدَفَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ يَوْمٍ ، فَأَسَرَّ إِلَيَّ حَدِيثًا لَا أُحَدِّثُ بِهِ أَحَدًا مِنَ النَّاسِ ، قَالَ : وَكَانَ أَحَبُّ مَا اسْتَتَرَ بِهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَدَفٌ أَوْ  حَائِشُ  نَخْلٍ ، فَدَخَلَ حَائِطَ  رَجُلٍ مِنَ الْأَنْصَارِ  ، فَإِذَا جَمَلٌ ، فَلَمَّا رَأَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَنَّ  وَذَرَفَتْ  عَيْنَاهُ ، فَأَتَاهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَمَسَحَ سَرَاتَهُ  وَذِفْرَاهُ  ، فَسَكَنَ ، ثُمَّ قَالَ :  لِمَنْ هَذَا الْجَمَلُ ؟  فَجَاءَ فَتًى مِنَ  الْأَنْصَارِ  ، فَقَالَ : هُوَ لِي يَا رَسُولَ اللهِ ، فَقَالَ لَهُ : أَفَلَا تَتَّقِي اللهَ فِي هَذِهِ الْبَهِيمَةِ الَّتِي مَلَّكَكَ اللهُ إِيَّاهَا ؟ فَإِنَّهُ شَكَاكَ إِلَيَّ أَنَّكَ تُجِيعُهُ  وَتُدْئِبُهُ  .","","Al-Mu'jam al-Kabir 14776","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن الحسن بن سعد مولى علي بن أبي طالب عن محمد بن عبد الله بن أبي يعقوب عن مهدي بن ميمون المعولي عن عبد الله بن محمد بن أسماء الضبعي عن معاذ بن المثنى العنبري عن الطبراني","الحسن بن سعد مولى الحسن بن علي عن عبد الله بن جعفر"
"14816","14777  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ، قَالَ :  ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ الْمِنْقَرِيُّ ، قَالَ :  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ، (  ح  ) .         [14/151]      وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ :  حَدَّثَنِي  أَبِي  ، قَالَ :  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ أَبِي يَعْقُوبَ ،  عَنِ  الْحَسَنِ بْنِ سَعْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، قَالَ :  بَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَيْشًا ، وَاسْتَعْمَلَ عَلَيْهِمْ  زَيْدَ بْنَ حَارِثَةَ  : فَإِنْ  قُتِلَ أَوِ اسْتُشْهِدَ  فَأَمِيرُكُمْ  جَعْفَرُ بْنُ أَبِي طَالِبٍ  ، فَإِنْ  قُتِلَ أَوِ اسْتُشْهِدَ  فَأَمِيرُكُمْ  عَبْدُ اللهِ بْنُ رَوَاحَةَ  .         [14/152]      فَانْطَلَقُوا فَلَقَوُا الْعَدُوَّ ، فَأَخَذَ  الرَّايَةَ  زَيْدُ بْنُ حَارِثَةَ  ، فَقَاتَلَ حَتَّى قُتِلَ ، ثُمَّ أَخَذَ  الرَّايَةَ  جَعْفَرٌ  ، فَقَاتَلَ حَتَّى قُتِلَ ، ثُمَّ أَخَذَ  الرَّايَةَ  عَبْدُ اللهِ بْنُ رَوَاحَةَ  ، فَقَاتَلَ حَتَّى  قُتِلَ ، أَوِ اسْتُشْهِدَ  ، ثُمَّ أَخَذَ  الرَّايَةَ  سَيْفٌ مِنْ سُيُوفِ اللهِ  خَالِدُ بْنُ الْوَلِيدِ  ، فَفَتَحَ اللهُ عَلَيْهِ ، فَأَتَى خَبَرُهُمْ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَخَرَجَ فَرَقِيَ الْمِنْبَرَ ، فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ :  أَمَّا بَعْدُ ، فَإِنَّ إِخْوَانَكُمْ لَقُوا الْعَدُوَّ  ، فَأَخَذَ  الرَّايَةَ  زَيْدُ بْنُ حَارِثَةَ  ، فَقَاتَلَ حَتَّى  قُتِلَ - أَوِ اسْتُشْهِدَ  - ثُمَّ أَخَذَ  الرَّايَةَ  جَعْفَرٌ  ، فَقَاتَلَ حَتَّى  قُتِلَ - أَوِ اسْتُشْهِدَ  - ثُمَّ أَخَذَ  الرَّايَةَ  عَبْدُ اللهِ ابْنُ رَوَاحَةَ  ، فَقَاتَلَ حَتَّى  قُتِلَ - أَوِ اسْتُشْهِدَ  - ثُمَّ أَخَذَ  الرَّايَةَ  سَيْفٌ مِنْ سُيُوفِ اللهِ  خَالِدُ بْنُ الْوَلِيدِ  ، فَفَتَحَ اللهُ عَلَيْهِ . ثُمَّ أَمْهَلَ  آلَ جَعْفَرٍ  ثَلَاثًا أَنْ يَأْتِيَهُمْ ، ثُمَّ أَتَاهُمْ فَقَالَ : لَا تَبْكُوا عَلَيْهِ بَعْدَ الْيَوْمِ ، ثُمَّ قَالَ : ادْعُوا لِي بَنِي أَخِي ، فَجِيءَ بِنَا كَأَنَّا أَفْرُخٌ ، فَقَالَ : ادْعُوا لِي الْحَلَّاقَ ، فَأَمَرَهُ فَحَلَقَ رُؤُوسَنَا ، ثُمَّ قَالَ : أَمَّا  مُحَمَّدٌ  فَشَبِيهُ عَمِّنَا  أَبِي طَالِبٍ  ، وَأَمَّا  عَوْنٌ  فَشَبِيهُ خَلْقِي  وَخُلُقِي  ، ثُمَّ أَخَذَ بِيَدِي فَشَالَهَا ، فَقَالَ : اللَّهُمَّ  اخْلُفْ  جَعْفَرًا  فِي أَهْلِهِ ، وَبَارِكْ  لِعَبْدِ اللهِ  فِي  صَفْقَةِ  يَمِينِهِ ، قَالَهَا ثَلَاثَ مَرَّاتٍ . قَالَ : فَجَاءَتْ أُمُّنَا فَذَكَرَتْ يُتْمَنَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : الْعَيْلَةَ تَخَافِينَ عَلَيْهِمْ ، وَأَنَا وَلِيُّهُمْ فِي الدُّنْيَا وَالْآخِرَةِ  ؟!  .","","Al-Mu'jam al-Kabir 14777","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن الحسن بن سعد مولى علي بن أبي طالب عن محمد بن عبد الله بن أبي يعقوب عن جرير بن حازم عن وهب بن جرير بن حازم عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","الحسن بن سعد مولى الحسن بن علي عن عبد الله بن جعفر"
"14817","[14/153]      سَعْدُ بْنُ إِبْرَاهِيمَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  14778  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ :  حَدَّثَنِي  أَبِي  ، قَالَ :  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَأْكُلُ الْقِثَّاءَ بِالرُّطَبِ  .","","Al-Mu'jam al-Kabir 14778","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سعد بن إبراهيم بن عبد الرحمن بن عوف عن عبد الله بن جعفر"
"14818","[14/154]      الْقَاسِمُ بْنُ مُحَمَّدٍ  ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  14779  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ عَبْدِ الْمَلِكِ بْنِ وَاقِدٍ الْحَرَّانِيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي حَكِيمٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَنْبَغِي لِنَبِيٍّ أَنْ يَقُولَ : أَنَا خَيْرٌ مِنْ  يُونُسَ بْنِ مَتَّى  .","","Al-Mu'jam al-Kabir 14779","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن القاسم بن محمد بن أبي بكر الصديق عن إسماعيل بن أبي حكيم القرشي عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن أحمد بن عبد الملك بن واقد الحراني عن محمد بن أحمد بن النضر النضري عن الطبراني","القاسم بن محمد عن عبد الله بن جعفر"
"14819","[14/155]      14780  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ صَالِحٍ الشِّيرَازِيُّ ، قَالَ :  ثَنَا  عُثْمَانُ بْنُ الْهَيْثَمِ ، قَالَ :  ثَنَا  حَنْظَلَةُ بْنُ أَبِي سُفْيَانَ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، قَالَ :  نَهَى عَنْ قَتْلِهِنَّ  ،  يَعْنِي : الْحَيَّاتِ الَّتِي تَكُونُ فِي الْبُيُوتِ  .","","Al-Mu'jam al-Kabir 14780","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن القاسم بن محمد بن أبي بكر الصديق عن حنظلة الجمحي عن عثمان بن الهيثم بن جهم الأشج عن إبراهيم بن صالح الشيرازي عن الطبراني","القاسم بن محمد عن عبد الله بن جعفر"
"14820","الْعَبَّاسُ بْنُ سَهْلِ بْنِ سَعْدٍ  ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  14781  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ الْمَكِّيُّ ، قَالَ :  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدِ بْنِ كَاسِبٍ ، قَالَ :  ثَنَا  عَبْدُ الْمُهَيْمِنِ بْنُ عَبَّاسِ بْنِ سَهْلِ بْنِ سَعْدٍ السَّاعِدِيُّ ،  عَنْ  أَبِيهِ  ،  أَنَّ  سَهْلًا ، دَخَلَ عَلَى  الْحَجَّاجِ  وَهُوَ         [14/156]      مُتَوَكِّئٌ عَلَى يَدِهِ ، فَقَالَ لَهُ : إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ فِي  الْأَنْصَارِ  :  أَحْسِنُوا إِلَى مُحْسِنِهِمْ  ، وَاعْفُوا عَنْ مُسِيئِهِمْ ، فَقَالَ : مَنْ يَشْهَدُ لَكَ ؟ قَالَ : هَذَانِ كَنَفَيْكَ : عَبْدُ اللهِ بْنُ جَعْفَرٍ وَإِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ طَلْحَةَ . فَقَالَا : نَعَمْ  .","","Al-Mu'jam al-Kabir 14781","","سهل بن سعد الساعدي عن عباس بن سهل بن سعد الساعدي عن عبد المهيمن بن عباس الساعدي عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","العباس بن سهل بن سعد عن عبد الله بن جعفر"
"14821","عَبْدُ اللهِ بْنُ أَبِي مُلَيْكَةَ  ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  14782  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبْدُوسٍ الْبَغْدَادِيُّ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ، قَالَ :  أَخْبَرَنَا  شُعْبَةُ ،  عَنْ  حَبِيبِ بْنِ الشَّهِيدِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  أَنَّ عَبْدَ اللهِ بْنَ الزُّبَيْرِ ، قَالَ لِابْنِ عَبَّاسٍ وَعَبْدِ اللهِ بْنِ جَعْفَرٍ :  تَذْكُرَا يَوْمَ لَقِينَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟  قَالَا : نَعَمْ ، فَحَمَلَنَا ، وَتَرَكَكَ  .","","Al-Mu'jam al-Kabir 14782","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عبد الله بن الزبير عن ابن أبي مليكة عن حبيب بن الشهيد عن شعبة بن الحجاج عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","عبد الله بن أبي مليكة عن عبد الله بن جعفر"
"14822","[14/157]      مُوَرِّقٌ الْعِجْلِيُّ  ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  14783  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ، قَالَ :  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ،  عَنْ  مُوَرِّقٍ الْعِجْلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَمَلَ  غُلَامًا مِنْ بَنِي هَاشِمٍ  ،  وَابْنَ جَعْفَرٍ  عَلَى بَعِيرٍ  .","","Al-Mu'jam al-Kabir 14783","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن مورق العجلي عن عاصم بن سليمان الأحول عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن حفص بن عمر سنجة ألف عن الطبراني","مورق العجلي عن عبد الله بن جعفر"
"14823","14784  -  ثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الرَّقِّيُّ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ،  عَنْ  مُوَرِّقٍ         [14/158]      الْعِجْلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا قَدِمَ مِنْ سَفَرٍ تُلُقِّيَ بِصِبْيَانِ أَهْلِ بَيْتِهِ  ، وَإِنَّهُ قَدِمَ مِنْ سَفَرٍ ، فَسُبِقَ بِي إِلَيْهِ ، فَحَمَلَنِي بَيْنَ يَدَيْهِ ، ثُمَّ جِيءَ بِأَحَدِ ابْنَيْ  فَاطِمَةَ  فَحَمَلَهُ خَلْفَهُ ، فَدَخَلْنَا  الْمَدِينَةَ  وَنَحْنُ ثَلَاثَةٌ عَلَى دَابَّةٍ  .","","Al-Mu'jam al-Kabir 14784","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن مورق العجلي عن عاصم بن سليمان الأحول عن أبو معاوية الضرير عن عبد الله بن جعفر بن غيلان عن أبو شعيب الحراني عن الطبراني","مورق العجلي عن عبد الله بن جعفر"
"14824","14785  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ، قَالَ :  ثَنَا  فُضَيْلُ بْنُ سُلَيْمَانَ النُّمَيْرِيُّ ، قَالَ :  حَدَّثَنَا  عَاصِمٌ الْأَحْوَلُ ،  عَنْ  مُوَرِّقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؛ نَحْوَهُ .","","Al-Mu'jam al-Kabir 14785","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن مورق العجلي عن عاصم بن سليمان الأحول عن فضيل بن سليمان النميري عن محمد بن أبي بكر المقدمي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","مورق العجلي عن عبد الله بن جعفر"
"14825","14786  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ         [14/159]      الصَّبَّاحِ الدَّوْلَابِيُّ ، قَالَ :  ثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدَ ،  عَنْ  مُوَرِّقٍ الْعِجْلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَمَلَ  غُلَامًا مِنْ بَنِي هَاشِمٍ  وَابْنَ جَعْفَرٍ  عَلَى دَابَّةٍ  .","","Al-Mu'jam al-Kabir 14786","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن مورق العجلي عن داود بن أبي هند عن إسماعيل بن زكريا شقوصا عن محمد بن الصباح الدولابي عن عبد الله بن أحمد بن حنبل عن الطبراني","مورق العجلي عن عبد الله بن جعفر"
"14826","خَالِدُ بْنُ سَارَةَ الْمَخْزُومِيُّ  ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  14787  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ، (  ح  ) .  وَحَدَّثَنَا  الْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ ، قَالَ :  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، جَمِيعًا ،  عَنْ  سُفْيَانَ بْنِ عُيَيْنَةَ ،  عَنْ  جَعْفَرِ بْنِ خَالِدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، قَالَ :  لَمَّا جَاءَ نَعْيُ  جَعْفَرٍ  ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اصْنَعُوا  لِآلِ جَعْفَرٍ  طَعَامًا  ، فَإِنَّهُ قَدْ جَاءَهُمْ أَمْرٌ يَشْغَلُهُمْ  .","","Al-Mu'jam al-Kabir 14787","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن خالد بن سارة المخزومي عن جعفر بن خالد بن سارة المخزومي عن سفيان بن عيينة عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","خالد بن سارة المخزومي عن عبد الله بن جعفر"
"14827","[14/160]      14788  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَ :  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ، قَالَ :  ثَنَا  يَحْيَى بْنُ سَعِيدٍ الْقَطَّانُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  جَعْفَرِ بْنِ خَالِدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، قَالَ :  مَرَّ بِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَنَا مَعَ غِلْمَةٍ  لِبَنِي عَبْدِ الْمُطَّلِبِ  ،  فَحَمَلَنِي  وَغُلَامًا آخَرَ  عَلَى دَابَّةٍ كَانَ عَلَيْهَا ، فَكُنَّا عَلَيْهَا ثَلَاثَةً  .","","Al-Mu'jam al-Kabir 14788","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن خالد بن سارة المخزومي عن جعفر بن خالد بن سارة المخزومي عن ابن جريج عن يحيى القطان عن إبراهيم بن بشار الرمادى عن أبو مسلم الكجي عن الطبراني","خالد بن سارة المخزومي عن عبد الله بن جعفر"
"14828","14789  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، قَالَ :  ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ، قَالَ :  ثَنَا  يَحْيَى بْنُ سَعِيدٍ الْقَطَّانُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  جَعْفَرِ بْنِ خَالِدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَسَحَ بِرَأْسِهِ ثَلَاثًا ، وَقَالَ :  اللَّهُمَّ  اخْلُفْ  جَعْفَرًا  فِي أَهْلِهِ  .","","Al-Mu'jam al-Kabir 14789","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن خالد بن سارة المخزومي عن جعفر بن خالد بن سارة المخزومي عن ابن جريج عن يحيى القطان عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","خالد بن سارة المخزومي عن عبد الله بن جعفر"
"14829","[14/161]      عُبَيْدُ بْنُ أُمِّ كِلَابٍ  ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  14790  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ ، قَالَ :  ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ، قَالَ :  ثَنَا  أَبِي  ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُبَيْدٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ جَعْفَرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا عَطَسَ حَمِدَ اللهَ ، فَيُقَالُ لَهُ : يَرْحَمُكَ اللهُ ، فَيَقُولُ :  يَهْدِيكُمُ اللهُ ، وَيُصْلِحُ بَالَكُمْ  .","","Al-Mu'jam al-Kabir 14790","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عبيد بن أم كلاب عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","عبيد بن أم كلاب عن عبد الله بن جعفر"
"14830","[14/162]      عُقْبَةُ بْنُ مُحَمَّدِ بْنِ الْحَارِثِ  ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  14791  -  حَدَّثَنَا  [ إِدْرِيسُ] بْنُ جَعْفَرٍ الْعَطَّارُ ، قَالَ :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ، (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ :  ثَنَا  يَحْيَى بْنُ مَعِينٍ ، قَالَ :  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ، كِلَاهُمَا  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي         [14/163]      عَبْدُ اللهِ بْنُ مُسَافِعٍ ،  عَنْ  مُصْعَبِ بْنِ شَيْبَةَ ،  عَنْ  عُقْبَةَ بْنِ مُحَمَّدِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ شَكَّ فِي شَيْءٍ مِنْ صَلَاتِهِ  فَلْيَسْجُدْ سَجْدَتَيْنِ مَا لَمْ يُسَلِّمْ  .","","Al-Mu'jam al-Kabir 14791","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عتبة ، ويقال عن مصعب بن شيبة بن جبير الحجبي عن عبد الله بن مسافع الحجبي عن ابن جريج عن حجاج بن محمد الأعور عن يحيى بن معين عن عبد الله بن أحمد بن حنبل عن الطبراني","عقبة بن محمد بن الحارث عن عبد الله بن جعفر"
"14831","عَبْدُ الرَّحْمَنِ بْنُ أَبِي رَافِعٍ  ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  14792  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ، قَالَ :  ثَنَا  [ هُدْبَةُ] بْنُ خَالِدٍ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي رَافِعٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ : أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَتَخَتَّمُ بِالْفِضَّةِ فِي يَمِينِهِ  .","","Al-Mu'jam al-Kabir 14792","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عبد الرحمن بن أبي رافع عن حماد بن سلمة عن هدبة بن خالد عن الساجي عن الطبراني","عبد الرحمن بن أبي رافع عن عبد الله بن جعفر"
"14832","[14/164]      14793  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ :  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي رَافِعٍ ،  أَنَّ  عَبْدَ اللهِ بْنَ جَعْفَرٍ ، قَالَ لِابْنَتِهِ حِينَ دَخَلَ بِهَا عَلَى  الْحَجَّاجِ  : إِذَا دَخَلَ عَلَيْكِ فَقُولِي : لَا إِلَهَ إِلَّا اللهُ الْعَلِيُّ الْعَظِيمُ  ، سُبْحَانَ اللهِ رَبِّ الْعَرْشِ الْكَرِيمُ ، الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ ، وَزَعَمَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُهُ إِذَا نَزَلَ بِهِ  الْجَهْدُ  ، فَقَالَتْهُ ، فَلَمْ يَصِلْ إِلَيْهَا  .","","Al-Mu'jam al-Kabir 14793","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عبد الرحمن بن أبي رافع عن حماد بن سلمة عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","عبد الرحمن بن أبي رافع عن عبد الله بن جعفر"
"14833","[14/165]      عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَقِيلٍ  ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  14794  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَالِمٍ الرَّازِيُّ ، قَالَ :  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ، (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ، قَالَ :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ الْفَضْلِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَتَخَتَّمُ فِي يَمِينِهِ  .","","Al-Mu'jam al-Kabir 14794","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عبد الله بن محمد بن عقيل بن أبي طالب عن إبراهيم بن الفضل المخزومي عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن محمد بن عقيل عن عبد الله بن جعفر"
"14834","14795  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ، قَالَ :  ثَنَا  سُلَيْمَانُ بْنُ النُّعْمَانِ الشَّيْبَانِيُّ ، قَالَ :  ثَنَا  يَحْيَى بْنُ الْعَلَاءِ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَتَخَتَّمُ فِي يَمِينِهِ  .","","Al-Mu'jam al-Kabir 14795","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عبد الله بن محمد بن عقيل بن أبي طالب عن يحيى بن العلاء الفوراردي عن سليمان بن النعمان الشيباني عن عثمان بن عمر الضبي عن الطبراني","عبد الله بن محمد بن عقيل عن عبد الله بن جعفر"
"14835","14796  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ، قَالَ :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ الْفَضْلِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، قَالَ :  رَأَيْتُ خَاتَمَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي يَمِينِهِ  .","","Al-Mu'jam al-Kabir 14796","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عبد الله بن محمد بن عقيل بن أبي طالب عن إبراهيم بن الفضل المخزومي عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن محمد بن عقيل عن عبد الله بن جعفر"
"14836","[14/166]      بُدَيْحٌ مَوْلَى عَبْدِ اللهِ بْنِ جَعْفَرٍ  ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  14797  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ :  ثَنَا  بَكْرُ بْنُ خَلَفٍ ، قَالَ :  ثَنَا  أَبُو عَاصِمٍ ،  عَنْ  جُوَيْرِيَةَ بْنِ أَسْمَاءَ ،  عَنْ  عِيسَى بْنِ [عُمَرَ ] ،  عَنْ  بُدَيْحٍ ، قَالَ :  وَفَدَ عَبْدُ اللهِ بْنُ جَعْفَرٍ إِلَى  عَبْدِ الْمَلِكِ بْنِ مَرْوَانَ  ، فَدَخَلَ عَلَيْهِ  ، وَعِنْدَهُ  يَحْيَى بْنُ الْحَكَمِ  ، فَسَأَلَهُ ، فَقَالَ : كَيْفَ تَرَكْتَ خِبْثَةَ ؟ -  يَعْنِي :  الْمَدِينَةَ  - فَقَالَ  عَبْدُ اللهِ  : سَمَّاهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  طَيْبَةَ  ، وَتُسَمِّيهَا خِبْثَةَ .  ؟","","Al-Mu'jam al-Kabir 14797","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن بديح مولى عبد الله بن جعفر عن عيسى بن عمر بن موسى الحجازي عن جويرية بن أسماء الضبعي عن أبو عاصم النبيل عن بكر بن خلف عن عبد الله بن أحمد بن حنبل عن الطبراني","بديح مولى عبد الله بن جعفر عن عبد الله بن جعفر"
"14837","[14/167]      شَيْخٌ مِنْ  فَهْمٍ  يُقَالُ لَهُ :  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ  ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  14798  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  أَبُو نُعَيْمٍ ، قَالَ :  حَدَّثَنَا  مِسْعَرٌ ،  عَنْ  شَيْخٍ مِنْ فَهْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  أَطْيَبُ اللَّحْمِ لَحْمُ الظَّهْرِ  .","","Al-Mu'jam al-Kabir 14798","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن محمد بن عبد الله بن أبي رافع الفهمي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","شيخ من فهم يقال له محمد بن عبد الرحمن عن عبد الله بن جعفر"
"14838","14799  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ الْقَاضِي ، وَمُعَاذُ بْنُ الْمُثَنَّى ، قَالَا :  ثَنَا  مُسَدَّدٌ ، قَالَ :  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  مِسْعَرٍ ،  عَنْ  رَجُلٍ مِنْ فَهْمٍ ، يُقَالُ لَهُ : مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَطْيَبُ اللَّحْمِ لَحْمُ الظَّهْرِ  .","","Al-Mu'jam al-Kabir 14799","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن محمد بن عبد الله بن أبي رافع الفهمي عن مسعر بن كدام عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","شيخ من فهم يقال له محمد بن عبد الرحمن عن عبد الله بن جعفر"
"14839","[14/168]      صَفْوَانُ بْنُ سُلَيْمٍ  ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  14800  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ أَبِي رَجَاءٍ الْعَبَّادَانِيُّ ، قَالَ :  ثَنَا  سَلَمَةُ بْنُ رَجَاءٍ ،  عَنْ  يَزِيدَ بْنِ عِيَاضٍ ،  عَنْ  صَفْوَانَ بْنِ سُلَيْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ رَمَى بِاللَّيْلِ فَلَيْسَ مِنَّا  ، وَمَنْ رَقَدَ عَلَى سَطْحٍ لَا جِدَارَ لَهُ         [14/169]      فَسَقَطَ فَمَاتَ ، فَدَمُهُ هَدَرٌ  .         [14/170]","","Al-Mu'jam al-Kabir 14800","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن صفوان بن سليم القرشي عن يزيد بن عياض بن جعدبة الليثي عن سلمة بن رجاء التميمي عن محمد بن أبي رجاء العباداني عن الحسين بن إسحاق التستري عن الطبراني","صفوان بن سليم عن عبد الله بن جعفر"
"14840","[14/171]      عَبْدُ اللهِ بْنُ الزُّبَيْرِ بْنِ الْعَوَّامِ  يُكْنَى  أَبَا خُبَيْبٍ  ، وَيُكْنَى  أَبَا بَكْرٍ  أَيْضًا ، وَأُمُّهُ :  أَسْمَاءُ بِنْتُ أَبِي بَكْرٍ الصِّدِّيقِ  ، وَأُمُّهَا  قُتَيْلَةُ بِنْتُ عَبْدِ الْعُزَّى بْنِ عَبْدِ اللهِ بْنِ نَصْرِ بْنِ مَالِكِ بْنِ حِسْلِ بْنِ عَامِرِ بْنِ لُؤَيٍّ  .  ذِكْرُ سِنِّ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، وَوَفَاتِهِ ، وَمِنْ أَخْبَارِهِ  14801  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، قَالَ :  ثَنَا  يَحْيَى بْنُ عُبَيْدٍ  ، قَالَ :  حَدَّثَنِي  اللَّيْثُ بْنُ سَعْدٍ  ، قَالَ  :  قُتِلَ  عَبْدُ اللهِ بْنُ الزُّبَيْرِ  فِي جُمَادَى الْآخِرَةِ سَنَةَ ثَلَاثٍ وَسَبْعِينَ  ، وَكَانَ يَوْمَ قُتِلَ ابْنَ اثْنَتَيْنِ وَسَبْعِينَ سَنَةً  .","","Al-Mu'jam al-Kabir 14801","","","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14841","14802  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، قَالَ :  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ، قَالَ :  وُلِدَ  عَبْدُ اللهِ بْنُ الزُّبَيْرِ  بِالْمَدِينَةِ  بَعْدَ الْهِجْرَةِ بِعِشْرِينَ شَهْرًا  ، وَهُوَ أَكْبَرُ مِنَ  الْمِسْوَرِ  وَمَرْوَانَ  بِأَرْبَعَةِ أَشْهُرٍ وَسَبْعَةِ أَيَّامٍ  .","","Al-Mu'jam al-Kabir 14802","","","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14842","[14/172]      14803  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَدِينِيُّ فُسْتُقَةُ  ، قَالَ :  ثَنَا  دَاوُدُ ابْنُ رُشَيْدٍ  ،  عَنِ  الْهَيْثَمِ بْنِ عَدِيٍّ  ، قَالَ :  قُتِلَ  ابْنُ الزُّبَيْرِ  سَنَةَ ثِنْتَيْنِ وَسَبْعِينَ  .","","Al-Mu'jam al-Kabir 14803","","","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14843","14804  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ ، قَالَ :  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ، قَالَ :  حَدَّثَنِي  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ         [14/173]      عُرْوَةَ ، قَالَ :  حَدَّثَنِي  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  خَرَجَتْ  أَسْمَاءُ بِنْتُ أَبِي بَكْرٍ  ، حِينَ هَاجَرَتْ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَهِيَ حَامِلٌ  بِعَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، فَنُفِسَتْهُ ، فَأَتَتْ بِهِ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِيُحَنِّكَهُ ، فَأَخَذَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَوَضَعَهُ فِي حِجْرِهِ ، فَأُتِيَ بِتَمْرَةٍ فَمَصَّهَا ثُمَّ وَضَعَهَا فِي فِيهِ ،  فَحَنَّكَهُ  بِهَا ، فَإِنْ كَانَ أَوَّلَ شَيْءٍ دَخَلَ بَطْنَهُ رِيقُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَتْ  أَسْمَاءُ  : ثُمَّ مَسَحَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَسَمَّاهُ :  عَبْدَ اللهِ  ، ثُمَّ جَاءَ بَعْدُ وَهُوَ ابْنُ  سَبْعِ سِنِينَ أَوْ ثَمَانِ سِنِينَ  لِيُبَايِعَهُ  النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَهُ  الزُّبَيْرُ  بِذَلِكَ - فَتَبَسَّمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ رَآهُ مُقْبِلًا ، وَبَايَعَ ، وَكَانَ أَوَّلَ مَنْ وُلِدَ         [14/174]      فِي الْإِسْلَامِ  بِالْمَدِينَةِ  مَقْدَمَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَكَانَتِ الْيَهُودُ تَقُولُ : وَأَخَذْنَاهُمْ فَلَا يُولَدُ لَهُمْ  بِالْمَدِينَةِ  وَلَدٌ ، فَكَبَّرَ أَصْحَابُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ وُلِدَ  عَبْدُ اللهِ  ، وَقَالَ  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ الْخَطَّابِ  - حِينَ سَمِعَ بِتَكْبِيرِ  أَهْلِ الشَّامِ  ، وَقَدْ قَتَلُوا  عَبْدَ اللهِ بْنَ الزُّبَيْرِ  - : الَّذِينَ كَبَّرُوا عَلَى مَوْلِدِهِ خَيْرٌ مِنَ الَّذِينَ كَبَّرُوا عَلَى قَتْلِهِ  .","","Al-Mu'jam al-Kabir 14804","","عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن محمد بن يحيى المدني عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14844","14805  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ بَحْرٍ ، قَالَ :  ثَنَا  شُعَيْبُ بْنُ إِسْحَاقَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ، وَفَاطِمَةَ بِنْتِ الْمُنْذِرِ ، قَالَتْ :  خَرَجَتْ أَسْمَاءُ بِنْتُ أَبِي بَكْرٍ حِينَ هَاجَرَتْ وَهِيَ حُبْلَى  بِعَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، فَقَدِمَتْ  قُبَاءً  فَنُفِسَتْ  بِعَبْدِ اللهِ  بِقُبَاءَ  ، ثُمَّ خَرَجَتْ بِهِ حِينَ نُفِسَتْ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِيُحَنِّكَهُ ، فَأَخَذَهُ         [14/175]      رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْهَا ، فَوَضَعَهُ فِي حِجْرِهِ ، ثُمَّ دَعَا بِتَمْرَةٍ ، فَقَالَتْ عَائِشَةُ : فَمَكَثْنَا سَاعَةً نَلْتَمِسُهَا قَبْلَ أَنْ نَجِدَهَا ، فَمَصَّهَا ، ثُمَّ وَضَعَهَا فِي فِيهِ ، فَإِنَّ أَوَّلَ شَيْءٍ دَخَلَ بَطْنَهُ رِيقُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . قَالَتْ  أَسْمَاءُ  : ثُمَّ مَسَحَهُ ، وَصَلَّى عَلَيْهِ ، وَسَمَّاهُ  بِعَبْدِ اللهِ  . ثُمَّ جَاءَ بَعْدُ وَهُوَ ابْنُ  سَبْعِ سِنِينَ ، أَوْ ثَمَانٍ  ،  لِيُبَايِعَ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَهُ بِذَلِكَ  الزُّبَيْرُ  - فَتَبَسَّمَ حِينَ رَآهُ مُقْبِلًا إِلَيْهِ ، ثُمَّ بَايَعَهُ  .","","Al-Mu'jam al-Kabir 14805","","عائشة بنت أبي بكر الصديق عن فاطمة بنت المنذر بن الزبير بن العوام عن هشام بن عروة بن الزبير عن شعيب بن إسحاق الدمشقي عن علي بن بحر بن بري القطان عن الحسين بن إسحاق التستري عن الطبراني","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14845","14806  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  عَمْرُو بْنُ عَوْنٍ الْوَاسِطِيُّ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  قُلْتُ : يَا رَسُولَ اللهِ ، لِكُلِّ صَوَاحِبَاتِي  كُنًى  ، فَلَوْ         [14/176]      كَنَّيْتَنِي  ، قَالَ :  فَاكْتَنِي بِابْنِكِ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، وَكَانَتْ تَكْتَنِي  أُمَّ عَبْدِ اللهِ  حَتَّى مَاتَتْ  .","","Al-Mu'jam al-Kabir 14806","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن عمرو بن عون الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14846","14807  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ، قَالَ :  ثَنَا  عَمْرُو بْنُ عَوْنٍ الْوَاسِطِيُّ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  أَنَّ  عَائِشَةَ قَالَتْ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ نِسَائِكَ لَهَا كُنْيَةٌ ، غَيْرِي ، فَقَالَ لَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اكْتَنِي أَنْتِ  أُمَّ عَبْدِ اللهِ  . فَكَانَ يُقَالُ لَهَا :  أُمُّ عَبْدِ اللهِ  ، حَتَّى مَاتَتْ ، وَلَمْ تَلِدْ قَطُّ .","","Al-Mu'jam al-Kabir 14807","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن عمرو بن عون الواسطي عن إسحاق الدبري عن الطبراني","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14847","14808  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُعَاذٍ الْحَلَبِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ مَسْلَمَةَ الْقَعْنَبِيُّ ، قَالَ :  حَدَّثَنِي  أَبِي مَسْلَمَةُ بْنُ قَعْنَبٍ  ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عَبَّادِ بْنِ حَمْزَةَ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  أَنَّ  عَائِشَةَ ، قَالَتْ : يَا رَسُولَ اللهِ ، أَلَا تُكَنِّينِي ؟ فَقَالَ :  اكْتَنِي  بِعَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، فَكَانَتْ تُكَنَّى  أُمَّ عَبْدِ اللهِ  .","","Al-Mu'jam al-Kabir 14808","","عائشة بنت أبي بكر الصديق عن عباد بن حمزة بن عبد الله بن الزبير بن العوام عن هشام بن عروة بن الزبير عن مسلمة بن قعنب القعنبي عن عبد الله بن مسلمة القعنبي عن محمد بن معاذ بن سفيان العنزي عن الطبراني","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14848","[14/177]      14809  -  حَدَّثَنَا  عَلِيُّ بْنُ الصَّقْرِ السَّكُونِيُّ  ، قَالَ :  ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ :  ثَنَا  وُهَيْبُ بْنُ خَالِدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عَبَّادِ بْنِ حَمْزَةَ ،  عَنْ  عَائِشَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؛ مِثْلَهُ .  كذا في طبعة الجريسي ، ولعل الصواب: ( السكري ) .","","Al-Mu'jam al-Kabir 14809","","عائشة بنت أبي بكر الصديق عن عباد بن حمزة بن عبد الله بن الزبير بن العوام عن هشام بن عروة بن الزبير عن وهيب بن خالد الكرابيسي عن عفان بن مسلم الصفار عن علي بن الصقر بن نصر السكري عن الطبراني","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14849","[14/178]      14810  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ ، قَالَ :  ثَنَا  زَيْدُ بْنُ الْمُبَارَكِ ، قَالَ :  حَدَّثَنِي  عَبْدُ الْمَلِكِ بْنُ عَبْدِ الرَّحْمَنِ الذِّمَارِيُّ ، قَالَ :  ثَنَا  [ مُحَمَّدُ بْنُ سَعِيدٍ ] ،  أَنَّ  مُعَاوِيَةَ ، لَمَّا حَضَرَهُ الْمَوْتُ ، قَالَ  لِيَزِيدَ بْنِ مُعَاوِيَةَ  : قَدْ وَطَّأْتُ لَكَ الْبِلَادَ  ، وَفَرَشْتُ لَكَ النَّاسَ ، وَلَسْتُ أَخَافُ عَلَيْكَ إِلَّا  أَهْلَ الْحِجَازِ  ، فَإِنْ رَابَكَ مِنْهُمْ رَيْبٌ فَوَجِّهْ إِلَيْهِمْ  مُسْلِمَ بْنَ عُقْبَةَ الْمُرِّيَّ  ، فَإِنِّي قَدْ جَرَّبْتُهُ غَيْرَ مَرَّةٍ ، فَلَمْ أَجِدْ لَهُ مِثْلًا ؛ لِطَاعَتِهِ  وَنَصِيحَتِهِ  .  فَلَمَّا جَاءَ  يَزِيدَ بْنَ مُعَاوِيَةَ  خِلَافُ  ابْنِ الزُّبَيْرِ  ، وَدُعَاؤُهُ إِلَى نَفْسِهِ ، دَعَا  مُسْلِمَ بْنَ عُقْبَةَ الْمُرِّيَّ  وَقَدْ أَصَابَهُ  فَالِجٌ  ، فَقَالَ : إِنَّ أَمِيرَ الْمُؤْمِنِينَ عَهِدَ إِلَيَّ فِي مَرَضِهِ إِنْ رَابَنِي مِنْ  أَهْلِ الْحِجَازِ  شَيْءٌ أَنْ أُوَجِّهَكَ إِلَيْهِمْ ، وَقَدْ رَابَنِي . فَقَالَ : إِنِّي كَمَا ظَنَّ أَمِيرُ الْمُؤْمِنِينَ ، اعْقِدْ لِي وَعَبِّئِ الْجُيُوشَ . قَالَ : فَوَرَدَ  الْمَدِينَةَ  فَأَبَاحَهَا ثَلَاثًا ، ثُمَّ دَعَاهُمْ إِلَى بَيْعَةِ  يَزِيدَ  عَلَى أَنَّهُمْ أَعْبُدٌ  قِنٌ  فِي طَاعَةِ اللهِ وَمَعْصِيَتِهِ ، فَأَجَابُوهُ إِلَى ذَلِكَ ،         [14/179]      إِلَّا رَجُلٌ وَاحِدٌ مِنْ  قُرَيْشٍ  أُمُّهُ أُمُّ وَلَدٍ ، فَقَالَ لَهُ : بَايِعْ  لِيَزِيدَ  عَلَى أَنَّكَ عَبْدٌ فِي طَاعَةِ اللهِ وَمَعْصِيَتِهِ ، قَالَ : لَا ، بَلْ فِي طَاعَةِ اللهِ . فَأَبَى أَنْ يَقْبَلَ ذَلِكَ مِنْهُ ، وَقَتَلَهُ . فَأَقْسَمَتْ أُمُّهُ قَسَمًا : لَئِنْ أَمْكَنَهَا اللهُ مِنْ  مُسْلِمٍ  حَيًّا أَوْ مَيِّتًا أَنْ تُحْرِقَهُ بِالنَّارِ! .  قَالَ : فَلَمَّا خَرَجَ  مُسْلِمُ بْنُ عُقْبَةَ  مِنَ  الْمَدِينَةِ  اشْتَدَّتْ عِلَّتُهُ فَمَاتَ ، فَخَرَجَتْ أُمُّ الْقُرَشِيِّ بِأَعْبُدٍ لَهَا إِلَى قَبْرِ مُسْلِمٍ ، فَأَمَرَتْ بِهِ أَنْ         [14/180]      يُنْبَشَ مِنْ عِنْدِ رَأْسِهِ ، فَلَمَّا وَصَلُوا إِلَيْهِ إِذَا بِثُعْبَانٍ قَدِ الْتَوَى عَلَى عُنُقِهِ قَابِضًا بِأَرْنَبَةِ أَنْفِهِ ، يَمُصُّهَا ، قَالَ :  فَكَاعَ  الْقَوْمُ  عَنْهُ ، وَقَالُوا : يَا مَوْلَاتَنَا انْصَرِفِي ، فَقَدْ كَفَاكِ اللهُ شَرَّهُ ، وَأَخْبَرُوهَا الْخَبَرَ ، قَالَتْ : لَا ، أَوْ أُوفِي اللهَ بِمَا وَعَدْتُهُ . ثُمَّ قَالَتِ : انْبُشُوا لِي مِنْ عِنْدِ الرِّجْلَيْنِ ، فَنَبَشُوا فَإِذَا الثُّعْبَانُ لَاوٍ ذَنَبَهُ بِرِجْلَيْهِ ، قَالَ : فَتَنَحَّتْ ، فَصَلَّتْ رَكْعَتَيْنِ ، ثُمَّ قَالَتِ : اللَّهُمَّ إِنْ كُنْتَ تَعْلَمُ أَنِّي إِنَّمَا غَضِبْتُ عَلَى  مُسْلِمِ بْنِ عُقْبَةَ  الْيَوْمَ لَكَ ، فَخَلِّ بَيْنِي وَبَيْنَهُ . قَالَ : ثُمَّ تَنَاوَلَتْ عُودًا فَمَضَتْ إِلَى ذَنَبِ الثُّعْبَانِ فَحَرَّكَتْهُ ،  فَانْسَلَّ  مِنْ مُؤَخَّرِ رَأْسِهِ ، فَخَرَجَ مِنَ الْقَبْرِ ، ثُمَّ أَمَرَتْ بِهِ فَأُخْرِجَ مِنَ الْقَبْرِ وَأُحْرِقَ بِالنَّارِ .","","Al-Mu'jam al-Kabir 14810","","معاوية بن أبي سفيان عن محمد بن سعيد بن رمانة اليمني عن عبد الملك بن عبد الرحمن الذماري عن زيد بن المبارك الصنعاني عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14850","14811  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ ، [  ثَنَا  زَيْدُ بْنُ الْمُبَارَكِ ] ، قَالَ :  أَخْبَرَنَا  صَاحِبٌ لَنَا ، قَالَ :  أَخْبَرَنِي  إِبْرَاهِيمُ بْنُ         [14/181]      إِسْحَاقَ ، قَالَ :  سَمِعْتُ  إِسْحَاقَ بْنَ أَبِي إِسْحَاقَ ، قَالَ :  أَنَا حَاضِرٌ قَتْلَ ابْنِ الزُّبَيْرِ يَوْمَ قُتِلَ فِي  الْمَسْجِدِ الْحَرَامِ  ، جَعَلَتِ الْجُيُوشُ تَدْخُلُ مِنْ أَبْوَابِ الْمَسْجِدِ ، فَكُلَّمَا دَخَلَ قَوْمٌ مِنْ بَابٍ حَمَلَ عَلَيْهِمْ وَحْدَهُ حَتَّى يُخْرِجَهُمْ ، فَبَيْنَا هُوَ عَلَى تِلْكَ الْحَالِ إِذْ جَاءَتْ شُرْفَةٌ مِنْ شُرُفَاتِ الْمَسْجِدِ وَوَقَعَتْ عَلَى رَأْسِهِ ، فَصَرَعَتْهُ ، وَهُوَ يَتَمَثَّلُ بِهَذِهِ الْأَبْيَاتِ ؛ يَقُولُ :","","Al-Mu'jam al-Kabir 14811","","عبد الله بن الزبير عن إسحاق بن أبي إسحاق عن إبراهيم بن إسحاق عن صاحب زيد بن المبارك الصنعاني عن زيد بن المبارك الصنعاني عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14851","[14/182]      14812  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَيُّوبَ ،  عَنِ  ابْنِ سِيرِينَ ، قَالَ :  قَالَ  ابْنُ الزُّبَيْرِ :  مَا شَيْءٌ كَانَ يُحَدِّثُنَاهُ  كَعْبٌ  إِلَّا قَدْ أَتَى عَلَى مَا قَالَ  ، إِلَّا قَوْلُهُ : فَتَى  ثَقِيفَ  يَقْتُلُنِي ، وَهَذَا رَأْسُهُ بَيْنَ يَدَيَّ ،  يَعْنِي :  الْمُخْتَارَ  .  قَالَ  ابْنُ سِيرِينَ  :  وَلَا يَشْعُرُ أَنَّ  أَبَا مُحَمَّدٍ  قَدْ خُبِّئَ لَهُ ،  يَعْنِي :  الْحَجَّاجَ  .","","Al-Mu'jam al-Kabir 14812","","عبد الله بن الزبير عن محمد بن سيرين عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14852","14813  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ ، قَالَ :  ثَنَا  زَيْدُ بْنُ الْمُبَارَكِ ، قَالَ :  ثَنَا  عَبْدُ الْمَلِكِ بْنُ عَبْدِ الرَّحْمَنِ الذِّمَارِيُّ ، قَالَ :  ثَنَا  الْقَاسِمُ بْنُ مَعْنٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ، قَالَ :  لَمَّا مَاتَ  مُعَاوِيَةُ  ، تَثَاقَلَ عَبْدُ اللهِ بْنُ الزُّبَيْرِ عَنْ طَاعَةِ  يَزِيدَ بْنِ مُعَاوِيَةَ  ، وَأَظْهَرَ شَتْمَهُ ، فَبَلَغَ ذَلِكَ         [14/183]      يَزِيدَ  ، فَأَقْسَمَ لَا يُؤْتَى بِهِ إِلَّا مَغْلُولًا ، وَإِلَّا أَرْسَلَ إِلَيْهِ . فَقِيلَ  لِابْنِ الزُّبَيْرِ  : أَلَا نَصْنَعُ لَكَ أَغْلَالًا مِنْ فِضَّةٍ تَلْبَسُ عَلَيْهَا الثَّوْبَ ، وَتَبَرُّ قَسَمَهُ ، فَالصُّلْحُ أَجْمَلُ بِكَ ؟ قَالَ : فَلَا أَبَرُّ - وَاللهِ - قَسَمَهُ ، ثُمَّ قَالَ :  ثُمَّ قَالَ : وَاللهِ لَضَرْبَةٌ بِسَيْفٍ فِي عِزٍّ أَحَبُّ إِلَيَّ مِنْ ضَرْبَةٍ بِسَوْطٍ فِي ذُلٍّ . ثُمَّ دَعَا إِلَى نَفْسِهِ وَأَظْهَرَ الْخِلَافَ  لِيَزِيدَ بْنِ مُعَاوِيَةَ  ، فَوَجَّهَ إِلَيْهِ  يَزِيدُ بْنُ مُعَاوِيَةَ  مُسْلِمَ بْنَ عُقْبَةَ الْمُرِّيَّ  فِي جَيْشِ  أَهْلِ الشَّامِ  ، وَأَمَرَهُ بِقِتَالِ  أَهْلِ الْمَدِينَةِ  ، فَإِذَا فَرَغَ مِنْ ذَلِكَ سَارَ إِلَى  مَكَّةَ  .  قَالَ : فَدَخَلَ  مُسْلِمُ بْنُ عُقْبَةَ  الْمَدِينَةَ  ، وَهَرَبَ مِنْهُ بَقَايَا أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَعَبَثَ فِيهَا وَأَسْرَفَ فِي الْقَتْلِ ، ثُمَّ خَرَجَ مِنْهَا ، فَلَمَّا         [14/184]      كَانَ فِي بَعْضِ الطَّرِيقِ إِلَى  مَكَّةَ  مَاتَ ، وَاسْتَخْلَفَ  حُصَيْنَ بْنَ نُمَيْرٍ الْكِنْدِيَّ  ، وَقَالَ لَهُ : يَا ابْنَ بَرْدَعَةِ الْحِمَارِ ، احْذَرْ خَدَائِعَ  قُرَيْشٍ  ، وَلَا تُعَامِلْهُمْ إِلَّا [بِالثِّقَافِ] ، ثُمَّ بِالْقِطَافِ .  فَمَضَى  حُصَيْنٌ  حَتَّى وَرَدَ  مَكَّةَ  فَقَاتَلَ بِهَا  ابْنَ الزُّبَيْرِ  أَيَّامًا ، وَضَرَبَ  ابْنُ الزُّبَيْرِ  فُسْطَاطًا  فِي الْمَسْجِدِ ، فَكَانَ فِيهِ نِسَاءٌ يَسْقِينَ الْجَرْحَى وَيُدَاوِينَهُمْ ، وَيُطْعِمْنَ الْجَائِعَ ، وَيَكْتُمْنَ إِلَيْهِنَّ الْمَجْرُوحَ ، فَقَالَ  حُصَيْنٌ  : مَا يَزَالُ يَخْرُجُ عَلَيْنَا مِنْ ذَلِكَ  الْفُسْطَاطِ  أَسَدٌ كَمَا يَخْرُجُ مِنْ عَرِينِهِ ، فَمَنْ يَكْفِينِيهِ ؟ فَقَالَ رَجُلٌ مِنْ  أَهْلِ الشَّامِ  : أَنَا . فَلَمَّا  جَنَّ  عَلَيْهِ         [14/185]      اللَّيْلُ وَضَعَ شَمْعَةً فِي طَرَفِ رُمْحِهِ ، ثُمَّ ضَرَبَ فَرَسَهُ ، ثُمَّ طَعَنَ  الْفُسْطَاطَ  فَالْتَهَبَ نَارًا ، وَالْكَعْبَةُ يَوْمَئِذٍ مُؤَزَّرَةٌ بِالطَّنَافِسِ ، وَعَلَى أَعْلَاهَا [الْحِبَرَةُ] ، فَطَارَتِ الرِّيحُ بِاللهَبِ عَلَى الْكَعْبَةِ حَتَّى احْتَرَقَتْ ، وَاحْتَرَقَ فِيهَا يَوْمَئِذٍ قَرْنَا الْكَبْشِ الَّذِي فُدِيَ بِهِ  إِسْحَاقُ  .  قَالَ : وَبَلَغَ  حُصَيْنَ بْنَ نُمَيْرٍ  مَوْتُ  يَزِيدَ بْنِ مُعَاوِيَةَ  فَهَرَبَ  حُصَيْنُ بْنُ نُمَيْرٍ  . فَلَمَّا مَاتَ  يَزِيدُ بْنُ مُعَاوِيَةَ  دَعَا  مَرْوَانُ بْنُ الْحَكَمِ  إِلَى نَفْسِهِ فَأَجَابَهُ  أَهْلُ حِمْصَ  وَأَهْلُ الْأُرْدُنِّ وَفِلَسْطِينَ  ، فَوَجَّهَ إِلَيْهِ  ابْنُ الزُّبَيْرِ  الضَّحَّاكَ بْنَ قَيْسٍ الْفِهْرِيَّ  فِي مِائَةِ أَلْفٍ ، فَالْتَقَوْا  بِمَرْجِ رَاهِطٍ  ،  وَمَرْوَانُ  يَوْمَئِذٍ فِي خَمْسَةِ آلَافٍ مِنْ  بَنِي أُمَيَّةَ  وَمَوَالِيهِمْ وَأَتْبَاعِهِمْ مِنْ  أَهْلِ الشَّامِ  ، فَقَالَ  مَرْوَانُ  لِمَوْلًى لَهُ - يُقَالُ لَهُ :  كَرَّةُ  - : احْمِلْ عَلَى أَيِّ الطَّرَفَيْنِ شِئْتَ ، فَقَالَ : كَيْفَ أَحْمِلُ عَلَى هَؤُلَاءِ ؟ لِكَثْرَتِهِمْ ، قَالَ : هُمْ مِنْ بَيْنِ مُكْرَهٍ وَمُسْتَأْجَرٍ ، احْمِلْ عَلَيْهِمْ لَا أُمَّ لَكَ ، فَيَكْفِيكَ الطِّعَانُ النَّاصِعُ الْجَنْدَلُ ، هُمْ يَكْفُونَكَ أَنْفُسَهُمْ ، إِنَّمَا هَؤُلَاءِ عَبِيدُ الدِّينَارِ وَالدِّرْهَمِ .         [14/186]      فَحَمَلَ عَلَيْهِمْ فَهَزَمَهُمْ ، وَقُتِلَ  الضَّحَّاكُ بْنُ قَيْسٍ  ، وَانْصَدَعَ الْجَيْشُ ، فَفِي ذَلِكَ يَقُولُ  زُفَرُ بْنُ الْحَارِثِ  :  أَبَا  دِمَنِ  الثَّرَى  وَفِيهِ يَقُولُ أَيْضًا :         [14/187]      بَحْدَلٌ  بَحْدَلٍ  قَالَ : ثُمَّ مَاتَ  مَرْوَانُ  ، فَدَعَا  عَبْدُ الْمَلِكِ  إِلَى نَفْسِهِ وَقَامَ ، فَأَجَابَهُ  أَهْلُ الشَّامِ  ، فَخَطَبَ عَلَى الْمِنْبَرِ ، وَقَالَ : مَنْ  لِابْنِ الزُّبَيْرِ  مِنْكُمْ ؟ فَقَالَ  الْحَجَّاجُ  : أَنَا يَا أَمِيرَ الْمُؤْمِنِينَ ، فَأَسْكَتَهُ ، ثُمَّ عَادَ فَأَسْكَتَهُ ، فَقَالَ : أَنَا يَا أَمِيرَ الْمُؤْمِنِينَ ، فَإِنِّي رَأَيْتُ فِي النَّوْمِ أَنِّي انْتَزَعْتُ جُبَّتَهُ فَلَبِسْتُهَا . فَعَقَدَ لَهُ فِي الْجَيْشِ إِلَى  مَكَّةَ  ، حَتَّى وَرَدَهَا عَلَى  ابْنِ الزُّبَيْرِ  ، فَقَاتَلَهُ بِهَا ، فَقَالَ  ابْنُ الزُّبَيْرِ  لِأَهْلِ مَكَّةَ  : احْفَظُوا هَذَيْنِ الْجَبَلَيْنِ ، فَإِنَّكُمْ لَنْ تَزَالُوا بِخَيْرٍ أَعِزَّةً مَا لَمْ يَظْهَرُوا عَلَيْهِمَا ، قَالَ : فَلَمْ يَلْبَثُوا أَنْ ظَهَرَ  الْحَجَّاجُ  وَمَنْ مَعَهُ عَلَى  أَبِي قُبَيْسٍ  ، وَنَصَبَ عَلَيْهِ الْمَنْجَنِيقَ ، فَكَانَ يَرْمِي بِهِ  ابْنَ الزُّبَيْرِ  وَمَنْ مَعَهُ فِي الْمَسْجِدِ .  فَلَمَّا كَانَ الْغَدَاةُ الَّتِي قُتِلَ فِيهَا  ابْنُ الزُّبَيْرِ  دَخَلَ  ابْنُ الزُّبَيْرِ  عَلَى         [14/188]      أُمِّهِ  أَسْمَاءَ بِنْتِ أَبِي بَكْرٍ  ، وَهِيَ يَوْمَئِذٍ ابْنَةُ مِائَةِ سَنَةٍ لَمْ يَسْقُطْ لَهَا سِنٌّ ، وَلَمْ يَفْسُدْ لَهَا بَصَرٌ ، فَقَالَتْ لِابْنِهَا : يَا  عَبْدَ اللهِ  ، مَا فَعَلْتَ فِي حَرْبِكَ ؟ قَالَ : بَلَغُوا مَكَانَ كَذَا وَكَذَا ، قَالَ : وَضَحِكَ  ابْنُ الزُّبَيْرِ  ، فَقَالَ : إِنَّ فِي الْمَوْتِ لَرَاحَةً ، فَقَالَتْ : يَا بُنَيَّ ، لَعَلَّكَ تَتَمَنَّاهُ لِي ، مَا أُحِبُّ أَنْ أَمُوتَ حَتَّى آتِيَ عَلَى أَحَدِ  طَرَفَيْكَ  : إِمَّا أَنْ تَمْلِكَ ، فَتَقَرَّ بِذَلِكَ عَيْنِي ، وَإِمَّا أَنْ تُقْتَلَ فَأَحْتَسِبَكَ . قَالَ : فَوَدَّعَهَا ، فَقَالَتْ لَهُ : يَا بُنَيَّ ، إِيَّاكَ أَنْ تُعْطِيَ  خَصْلَةً  مِنْ دِينِكَ مَخَافَةَ الْقَتْلِ .  وَخَرَجَ عَنْهَا فَدَخَلَ الْمَسْجِدَ ، وَقَدْ جَعَلَ مِصْرَاعَيْنِ عَلَى الْحَجَرِ الْأَسْوَدِ يَتَّقِي أَنْ يُصِيبَهُ الْمَنْجَنِيقُ . وَأَتَى  ابْنَ الزُّبَيْرِ  آتٍ  وَهُوَ جَالِسٌ عِنْدَ الْحَجَرِ ، فَقَالَ لَهُ : أَلَا نَفْتَحُ لَكَ  الْكَعْبَةَ  فَتَصْعَدُ فِيهَا ؟ فَنَظَرَ إِلَيْهِ  عَبْدُ اللهِ  ، ثُمَّ قَالَ لَهُ : مِنْ كُلِّ شَيْءٍ تَحْفَظُ أَخَاكَ إِلَّا مِنْ نَفْسِهِ -  يَعْنِي : مِنْ أَجَلِهِ  - وَهَلْ  لِلْكَعْبَةِ  حُرْمَةٌ  لَيْسَتْ لِهَذَا الْمَكَانِ ؟ وَاللهِ لَوْ وَجَدُوكُمْ مُتَعَلِّقِينَ بِأَسْتَارِ الْكَعْبَةِ لَقَتَلُوكُمْ ! فَقِيلَ لَهُ : أَلَا تُكَلِّمُهُمْ فِي الصُّلْحِ ؟ فَقَالَ : أَوَحِينُ صُلْحٍ هَذَا ؟ وَاللهِ لَوْ وَجَدُوكُمْ فِي جَوْفِهَا لَذَبَحُوكُمْ جَمِيعًا ، ثُمَّ أَنْشَأَ يَقُولُ :         [14/189]      ثُمَّ أَقْبَلَ عَلَى  آلِ الزُّبَيْرِ  يَعِظُهُمْ ، وَيَقُولُ : لِيُكِنَّ أَحَدُكُمْ سَيْفَهُ كَمَا يُكِنُّ وَجْهَهُ ، لَا يُنَكِّسُ سَيْفَهُ فَيَدْفَعَ عَنْ نَفْسِهِ بِيَدِهِ [كَأَنَّهُ امْرَأَةٌ] ، وَاللهِ مَا لَقِيتُ زَحْفًا قَطُّ إِلَّا فِي الرَّعِيلِ الْأَوَّلِ ، وَمَا أَلِمْتُ جُرْحًا قَطُّ إِلَّا أَنْ آلَمَ الدَّوَاءَ .  قَالَ : فَبَيْنَمَا هُمْ كَذَلِكَ ، إِذْ دَخَلَ عَلَيْهِمْ نَفَرٌ مِنْ بَابِ  بَنِي جُمَحٍ  ، [فِيهِمْ  أَسْوَدُ  ] فَقَالَ : مَنْ هَؤُلَاءِ ؟ قِيلَ :  أَهْلُ حِمْصَ  ، فَحَمَلَ عَلَيْهِمْ وَمَعَهُ سَيْفَانِ ، فَأَوَّلُ مَنْ لَقِيَهُ  الْأَسْوَدُ  ، فَضَرَبَهُ بِسَيْفِهِ حَتَّى أَطَنَّ رِجْلَهُ ، فَقَالَ  الْأَسْوَدُ  : أَخْ ! يَا ابْنَ الزَّانِيَةِ ، فَقَالَ لَهُ  ابْنُ الزُّبَيْرِ  : اخْسَأْ يَا ابْنَ حَامٍ ،  أَسْمَاءُ  زَانِيَةٌ ؟ ثُمَّ أَخْرَجَهُمْ مِنَ الْمَسْجِدِ وَانْصَرَفَ ، فَإِذَا بِقَوْمٍ قَدْ دَخَلُوا مِنْ بَابِ  بَنِي سَهْمٍ  ، فَقَالَ : مَنْ هَؤُلَاءِ ؟ فَقِيلَ :  أَهْلُ الْأُرْدُنِّ  ، فَحَمَلَ عَلَيْهِمْ ، وَهُوَ يَقُولُ :         [14/190]      فَأَخْرَجَهُمْ مِنَ الْمَسْجِدِ ، فَإِذَا بِقَوْمٍ قَدْ دَخَلُوا مِنْ بَابِ  بَنِي مَخْزُومٍ  ، فَحَمَلَ عَلَيْهِمْ ، وَهُوَ يَقُولُ :  قَالَ : وَعَلَى ظَهْرِ الْمَسْجِدِ مِنْ أَعْوَانِهِ مَنْ يَرْمِي عَدُوَّهُ بِالْآجُرِّ وَغَيْرِهِ ، فَحَمَلَ عَلَيْهِمْ ، فَأَصَابَتْهُ آجُرَّةٌ فِي مَفْرِقِهِ حَتَّى فَلَقَتْ رَأْسَهُ ، فَوَقَفَ قَائِمًا وَهُوَ يَقُولُ :  تَدْمَى  قَالَ : ثُمَّ وَقَعَ ، فَأَكَبَّ عَلَيْهِ مُوَالِيَانِ لَهُ وَهُمَا يَقُولَانِ :  قَالَ : ثُمَّ سِيرَ إِلَيْهِ فَحُزَّ رَأْسُهُ  .","","Al-Mu'jam al-Kabir 14813","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن القاسم بن معن عن عبد الملك بن عبد الرحمن الذماري عن زيد بن المبارك الصنعاني عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14853","[14/191]      14814  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، قَالَ :  ثَنَا  الْأَسْوَدُ بْنُ شَيْبَانَ ، قَالَ :  حَدَّثَنِي  أَبُو نَوْفَلِ بْنُ أَبِي عَقْرَبٍ الْعُرَيْجِيُّ قَالَ :  صَلَبَ  الْحَجَّاجُ بْنُ يُوسُفَ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ  عَلَى عَقَبَةِ  الْمَدِينَةِ  لِيُرِيَ ذَلِكَ  قُرَيْشًا  ، فَلَمَّا أَنْ نَفَرُوا جَعَلُوا يَمُرُّونَ فَلَا يَقِفُونَ عَلَيْهِ حَتَّى مَرَّ  عَبْدُ اللهِ بْنُ عُمَرَ  ، فَوَقَفَ عَلَيْهِ ، فَقَالَ : السَّلَامُ عَلَيْكَ يَا  أَبَا خُبَيْبٍ  - قَالَهَا ثَلَاثَ مَرَّاتٍ - ثُمَّ قَالَ : نَهَيْتُكَ عَنْ ذَا - قَالَهَا ثَلَاثَ مَرَّاتٍ - لَقَدْ كُنْتَ صَوَّامًا قَوَّامًا ، تَصِلُ الرَّحِمَ . فَبَلَغَ ذَلِكَ  الْحَجَّاجَ  - مَوْقِفُ  عَبْدِ اللهِ بْنِ عُمَرَ  - فَاسْتَنْزَلَهُ فَرَمَى بِهِ فِي قُبُورِ الْيَهُودِ ، وَبَعَثَ إِلَى أَسْمَاءَ بِنْتِ أَبِي بَكْرٍ أَنْ تَأْتِيَهُ ، وَقَدْ ذَهَبَ بَصَرُهَا ، فَأَبَتْ فَأَرْسَلَ إِلَيْهَا :         [14/192]      لَتَجِيئِنَّ أَوْ لَأَبْعَثَنَّ إِلَيْكِ مَنْ يَسْحَبُكِ  بِقُرُونِكِ  . قَالَتْ : وَاللهِ لَا آتِيكَ حَتَّى تُرْسِلَ إِلَيَّ مَنْ يَسْحَبُنِي بِقُرُونِي . فَأَتَى رَسُولُهُ فَأَخْبَرَهُ ، فَقَالَ : يَا غُلَامُ ، نَاوِلْنِي  سِبْتِيَّتَيَّ  ، فَنَاوَلَهُ نَعْلَيْهِ ، فَقَامَ وَهُوَ يَتَوَقَّدُ حَتَّى أَتَاهَا ، فَقَالَ لَهَا : كَيْفَ رَأَيْتِ اللهَ صَنَعَ بِعَدُوِّ اللهِ ؟ قَالَتْ : رَأَيْتُكَ أَفْسَدْتَ عَلَيْهِ دُنْيَاهُ ، وَأَفْسَدَ عَلَيْكَ آخِرَتَكَ ، وَأَمَّا مَا كُنْتَ تُعَيِّرُهُ بِذَاتِ النِّطَاقَيْنِ ، أَجَلْ ، لَقَدْ كَانَ لِي نِطَاقَانِ : نِطَاقٌ غُطِّيَ بِهِ طَعَامُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ النَّمْلِ ، وَنِطَاقِي الْآخَرُ لَا بُدَّ لِلنِّسَاءِ مِنْهُ ، وَقَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ فِي  ثَقِيفَ  مُبِيرًا  وَكَذَّابًا  ، فَأَمَّا الْكَذَّابُ فَقَدْ رَأَيْنَاهُ ، وَأَمَّا  الْمُبِيرُ  فَأَنْتَ ذَاكَ ، قَالَ : فَخَرَجَ  .","","Al-Mu'jam al-Kabir 14814","","أسماء بنت أبي بكر عن أبو نوفل بن أبي عقرب عن الأسود بن شيبان السدوسي عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14854","14815  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ، قَالَ :  ثَنَا  [  أَبُو الْمُحَيَّاةِ ] ،  عَنْ  أَبِيهِ  ،  قَالَ  :  قَدِمْتُ  مَكَّةَ  بَعْدَمَا  صُلِبَ - أَوْ قُتِلَ  -  ابْنُ الزُّبَيْرِ  بِثَلَاثَةِ أَيَّامٍ ، فَكَلَّمَتْ أُمُّهُ أَسْمَاءُ بِنْتُ أَبِي بَكْرٍ         [14/193]      الْحَجَّاجَ  ، فَقَالَتْ : أَمَا آنَ لِهَذَا الرَّاكِبِ أَنْ يَنْزِلَ ؟ قَالَ : الْمُنَافِقُ ؟ قَالَتْ : لَا وَاللهِ ، مَا كَانَ بِمُنَافِقٍ ، فَلَقَدْ كَانَ صَوَّامًا قَوَّامًا . قَالَ : اسْكُتِي فَإِنَّكِ عَجُوزٌ قَدْ خَرِفْتِ ، قَالَتْ : مَا خَرِفْتُ مُنْذُ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَخْرُجُ مِنْ  ثَقِيفَ  كَذَّابٌ  وَمُبِيرٌ  ، فَأَمَّا الْكَذَّابُ فَقَدْ رَأَيْنَاهُ -  يَعْنِي :  الْمُخْتَارَ  - وَأَمَّا  الْمُبِيرُ  فَأَنْتَ .","","Al-Mu'jam al-Kabir 14815","","أسماء بنت أبي بكر عن يعلى بن حرملة التيمي عن يحيى بن يعلى بن حرملة التيمي عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14855","14816  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  دَاوُدُ بْنُ عَمْرٍو         [14/194]      الضَّبِّيُّ ، قَالَ :  ثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  قَيْسِ بْنِ الْأَحْنَفِ الثَّقَفِيِّ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  قَالَ  :  جَاءَتْ أَسْمَاءُ بِنْتُ أَبِي بَكْرٍ مَعَ جَوَارِي لَهَا ، وَقَدْ ذَهَبَ بَصَرُهَا ، فَقَالَتْ : أَيْنَ  الْحَجَّاجُ  ؟ قُلْنَا : لَيْسَ هَهُنَا ، قَالَتْ : فَمُرُوهُ فَلْيَأْمُرْ لَنَا بِهَذِهِ الْعِظَامِ ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَنْهَى عَنِ  الْمُثْلَةِ  . قُلْنَا : إِذَا جَاءَ قُلْنَا لَهُ ، قَالَتْ : إِذَا جَاءَ فَأَخْبِرُوهُ أَنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ فِي  ثَقِيفَ  كَذَّابًا  وَمُبِيرًا  .","","Al-Mu'jam al-Kabir 14816","","أسماء بنت أبي بكر عن القاسم بن محمد بن أبي بكر الصديق عن قيس بن الأحنف النخعي عن يزيد بن أبي زياد القرشي عن إسماعيل بن زكريا شقوصا عن داود بن عمرو المسيبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14856","[14/195]      14817  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ الْمِصْرِيُّ ، قَالَ :  ثَنَا  أَبُو زَيْدِ بْنُ أَبِي الْغِمْرِ ، قَالَ :  ثَنَا  ضِمَامُ بْنُ إِسْمَاعِيلَ ،  عَنْ  عُقَيْلِ بْنِ خَالِدٍ ،  أَنَّ  أَبَاهُ  كَانَ مَعَ  الْحَجَّاجِ  لَمَّا قُتِلَ  ابْنُ الزُّبَيْرِ  ، فَبَعَثَهُ إِلَى أَسْمَاءَ بِنْتِ أَبِي بَكْرٍ ، فَقَالَ لَهُ : قُلْ لَهَا : يَقُولُ لَكِ  الْحَجَّاجُ  : اعْزِلِي مَا كَانَ لَكِ مِنْ مَالٍ عَنْ مَالِ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  . فَقَالَتْ : أَفَعَلَهَا بِابْنِ  أَسْمَاءَ  ؟ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  يَخْرُجُ مِنْ هَذَا الْحَيِّ مِنْ  ثَقِيفَ  رَجُلَانِ  : أَحَدُهُمَا يَكْذِبُ ، وَالْآخَرُ  مُبِيرٌ  ، فَأَمَّا الْكَذَّابُ فَقَدْ عَرَفْنَاهُ ، وَمَا أَحْسَبُهُ إِلَّا  الْمُبِيرَ  . فَرَجَعْتُ إِلَيْهِ فَأَخْبَرْتُهُ ، فَلَمْ يَكْرَهْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 14817","","أسماء بنت أبي بكر عن خالد بن عقيل الأيلي عن عقيل بن خالد الأيلي عن ضمام بن إسماعيل المرادي عن عبد الرحمن بن أبي الغمر المهري عن عمرو بن أبي الطاهر المصري عن الطبراني","ذكر سن عبد الله بن الزبير ووفاته ومن أخباره"
"14857","[14/196]      [  عَامِرُ بْنُ عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، عَنْ أَبِيهِ]  14818  -  حَدَّثَنَا  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ بْنِ مِقْلَاصٍ الْمِصْرِيُّ ، قَالَ :  حَدَّثَنِي  أَبِي  ، قَالَ :  دَثَنَا  ابْنُ وَهْبٍ ، قَالَ :  دَثَنِي  عَبْدُ اللهِ بْنُ الْأَسْوَدِ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَعْلِنُوا النِّكَاحَ  .","","Al-Mu'jam al-Kabir 14818","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن عبد الله بن الأسود القرشي عن عبد الله بن وهب المصري عن عبد العزيز بن عمران المصري عن عمر بن عبد العزيز الخزاعي عن الطبراني","عامر بن عبد الله بن الزبير عن أبيه"
"14858","[14/197]      14819  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  دَثَنَا         [14/198]      حَامِدُ بْنُ يَحْيَى الْبَلْخِيُّ ، قَالَ :  دَثَنَا  سُفْيَانُ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ اسْمُ  أَبِي بَكْرٍ  :  عَبْدَ اللهِ بْنَ عُثْمَانَ  ، فَسَمَّاهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَتِيقً مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 14819","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن زياد بن سعد الخراساني عن سفيان بن عيينة عن حامد بن يحيى البلخي عن الحسين بن إسحاق التستري عن الطبراني","عامر بن عبد الله بن الزبير عن أبيه"
"14859","14820  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ ، قَالَا :  دَثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ، قَالَ :  دَثَنَا  بِشْرُ بْنُ السَّرِيِّ ،         [14/199]      قَالَ :  دَثَنَا  مُصْعَبُ بْنُ ثَابِتٍ ،  عَنْ  عَمِّهِ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  ، قَالَ :  نَزَلَتْ فِي  أَبِي بَكْرٍ الصِّدِّيقِ  :         {      وَمَا لأَحَدٍ عِنْدَهُ مِنْ نِعْمَةٍ تُجْزَى             *          إِلا ابْتِغَاءَ وَجْهِ رَبِّهِ الْأَعْلَى             *          وَلَسَوْفَ يَرْضَى         }      .","","Al-Mu'jam al-Kabir 14820","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن بشر بن السري عن محمود بن غيلان المروزي عن الحسين بن إسحاق التستري عن الطبراني","عامر بن عبد الله بن الزبير عن أبيه"
"14860","14821  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، قَالَ :  دَثَنَا  أَيُّوبُ بْنُ مُحَمَّدٍ         [14/200]      الْوَزَّانُ ، قَالَ :  دَثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  زِيَادُ بْنُ سَعْدٍ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ  يُشِيرُ  بِإِصْبَعِهِ إِذَا دَعَا  ، لَا يُحَرِّكُهَا .  قَالَ  ابْنُ جُرَيْجٍ  : وَزَادَ  عَمْرُو بْنُ دِينَارٍ  ، قَالَ : أَخْبَرَنِي  عَامِرُ بْنُ عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، عَنْ أَبِيهِ ،  أَنَّهُ رَأَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَدْعُو كَذَلِكَ ، وَيَتَحَامَلُ بِيَدِهِ الْيُسْرَى عَلَى رِجْلِهِ الْيُسْرَى  .","","Al-Mu'jam al-Kabir 14821","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن محمد بن عجلان عن زياد بن سعد الخراساني عن ابن جريج عن حجاج بن محمد الأعور عن أيوب بن محمد الوزان عن عبد الله بن أحمد الجواليقي عن الطبراني","عامر بن عبد الله بن الزبير عن أبيه"
"14861","14822  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  دَثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ الْحِمَّانِيُّ ، قَالَ :  دَثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ، قَالَ :  دَثَنَا  عُثْمَانُ بْنُ حَكِيمٍ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا جَلَسَ فِي الصَّلَاةِ ، وَضَعَ رِجْلَهُ الْيُسْرَى ، بَيْنَ فَخِذِهِ وَسَاقِهِ  ، وَوَضَعَ يَدَهُ الْيُسْرَى عَلَى فَخِذِهِ الْيُسْرَى ، وَوَضَعَ يَدَهُ الْيُمْنَى عَلَى فَخِذِهِ الْيُمْنَى .","","Al-Mu'jam al-Kabir 14822","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن عثمان بن حكيم الأحلافي عن عبد الواحد بن زياد عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عامر بن عبد الله بن الزبير عن أبيه"
"14862","14823  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ ، قَالَ :  دَثَنَا  إِسْمَاعِيلُ         [14/201]      بْنُ أَبِي أُوَيْسٍ ،  عَنْ  سُلَيْمَانَ بْنِ بِلَالٍ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  :  أَنَّهُ رَأَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا صَلَّى فَجَلَسَ فِي  الثِّنْتَيْنِ ، أَوِ الْأَرْبَعِ  ، يَضَعُ يَدَهُ الْيُسْرَى عَلَى فَخِذِهِ الْيُسْرَى ، وَيَضَعُ يَدَهُ الْيُمْنَى عَلَى فَخِذِهِ الْيُمْنَى ،  وَيُشِيرُ  بِإِصْبَعِهِ الَّتِي تَلِي الْإِبْهَامَ .","","Al-Mu'jam al-Kabir 14823","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن محمد بن عجلان عن سليمان بن بلال القرشي عن إسماعيل بن أبي أويس عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","عامر بن عبد الله بن الزبير عن أبيه"
"14863","14824  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ، قَالَ :  دَثَنَا  أُمَيَّةُ بْنُ بِسْطَامٍ ، قَالَ :  دَثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ، قَالَ :  دَثَنَا  رَوْحُ بْنُ الْقَاسِمِ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  : عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  أَنَّهُ كَانَ إِذَا صَلَّى وَضَعَ إِحْدَى يَدَيْهِ عَلَى فَخِذِهِ الْيُسْرَى  ، وَالْيَدَ الْأُخْرَى عَلَى فَخِذِهِ الْيُمْنَى ، وَإِصْبَعُهُ هَكَذَا يُشِيرُ  .","","Al-Mu'jam al-Kabir 14824","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن محمد بن عجلان عن روح بن القاسم العنبري عن يزيد بن زريع العيشي عن أمية بن بسطام عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","عامر بن عبد الله بن الزبير عن أبيه"
"14864","14825  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ :  دَثَنِي  أَبِي  ، قَالَ :  حَدَّثَنَا  عَبْدُ الْقُدُّوسِ بْنُ بَكْرِ بْنِ خُنَيْسٍ ، قَالَ :  أَخْبَرَنَا  حَجَّاجُ بْنُ         [14/202]      أَرْطَاةَ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ النَّبِيَّ عَلَيْهِ السَّلَامُ حِينَ افْتَتَحَ الصَّلَاةَ رَفَعَ يَدَيْهِ  حَتَّى جَاوَزَ بِهِمَا أُذُنَيْهِ .","","Al-Mu'jam al-Kabir 14825","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن حجاج بن أرطاة عن عبد القدوس بن بكر بن خنيس الكوفي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عامر بن عبد الله بن الزبير عن أبيه"
"14865","14826  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ الْأَصْبَهَانِيُّ ، قَالَ :  حَدَّثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ ، قَالَ :  حَدَّثَنِي  عَبْدُ اللهِ بْنُ مُصْعَبِ بْنِ ثَابِتٍ ، قَالَ :  دَثَنَا  أَبِي مُصْعَبُ بْنُ ثَابِتِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، قَالَ :  جِئْتُ أَبِي ، فَقَالَ : أَيْنَ كُنْتَ ؟ فَقُلْتُ : وَجَدْتُ أَقْوَامًا مَا رَأَيْتُ خَيْرًا مِنْهُمْ  ، يَذْكُرُونَ اللهَ فَيُرْعَدُ أَحَدُهُمْ حَتَّى يُغْشَى عَلَيْهِ مِنْ خَشْيَةِ اللهِ ، فَقَعَدْتُ مَعَهُمْ ، قَالَ : لَا تَقْعُدْ مَعَهُمْ بَعْدَهَا . فَرَآنِي كَأَنَّهُ لَمْ يَأْخُذْ ذَلِكَ فِيَّ ، فَقَالَ : رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَتْلُو الْقُرْآنَ ، وَرَأَيْتُ  أَبَا بَكْرٍ  ،  وَعُمَرَ  يَتْلُوَانِ الْقُرْآنَ ، فَلَا يُصِيبُهُمْ هَذَا ، أَفَتَرَاهُمْ أَخْشَعَ لِلهِ مِنْ  أَبِي بَكْرٍ  وَعُمَرَ  ؟ فَرَأَيْتُ أَنَّ ذَلِكَ كَذَلِكَ ، فَتَرَكْتُهُمْ .","","Al-Mu'jam al-Kabir 14826","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن عبد الله بن مصعب بن ثابت الزبيري عن الزبير بن بكار عن محمد بن العباس ابن الأخرم عن الطبراني","عامر بن عبد الله بن الزبير عن أبيه"
"14866","[14/203]      عَبَّادُ بْنُ عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، عَنْ أَبِيهِ  14827  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقُطَعِيُّ ، قَالَ :  دَثَنَا  عَبْدُ الْأَعْلَى ، قَالَ :  دَثَنَا  إِبْرَاهِيمُ بْنُ يَزِيدَ ،  عَنْ  عَبَّادِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَتَى الْجُمُعَةَ فَلْيَغْتَسِلْ  .","","Al-Mu'jam al-Kabir 14827","","عبد الله بن الزبير عن عباد بن عبد الله بن الزبير بن العوام عن إبراهيم بن يزيد الخوزي عن عبد الأعلى بن عبد الأعلى القرشي عن محمد بن يحيى بن أبي حزم القطعي عن عبد الله بن أحمد الجواليقي عن الطبراني","عباد بن عبد الله بن الزبير عن أبيه"
"14867","14828  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْأَحْمَرِ النَّاقِدُ الْبَصْرِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقُطَعِيُّ ، قَالَ :  دَثَنَا  وَهْبُ بْنُ جَرِيرٍ ، قَالَ :  دَثَنَا  أَبِي  .         [14/204]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ زُهَيْرٍ أَبُو يَعْلَى الْأُبُلِّيُّ ، قَالَ :  دَثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ الصَّفَّارُ ، قَالَ :  دَثَنَا  عُبَيْدُ بْنُ عَقِيلٍ ، قَالَ :  دَثَنَا  جَرِيرُ بْنُ حَازِمٍ ، قَالَ :  دَثَنَا  ابْنُ إِسْحَاقَ ، قَالَ :  حَدَّثَنِي  يَحْيَى بْنُ عَبَّادٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، قَالَ :  كَانَتْ  قُرَيْشٌ  نَاحَتْ قَتْلَاهَا ، ثُمَّ نَدِمَتْ ، وَقَالُوا : لَا تَنُوحُوا عَلَيْهِمْ فَيَبْلُغَ ذَلِكَ  مُحَمَّدًا  وَأَصْحَابَهُ ، فَيَشْمَتُوا بِكُمْ . وَكَانَ فِي الْأَسْرَى  أَبُو وَدَاعَةَ بْنُ [صُبَيْرَةَ] السَّهْمِيُّ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ لَهُ  بِمَكَّةَ  ابْنً تَاجِرً كَيِّسً ذَا مَالٍ  ، كَأَنَّكُمْ بِهِ قَدْ جَاءَكُمْ فِي فِدَاءِ أَبِيهِ ، فَلَمَّا قَالَتْ  قُرَيْشٌ  فِي الْفِدَاءِ مَا قَالَتْ ، قَالَ  الْمُطَّلِبُ  : صَدَقْتُمْ ، وَاللهِ لَئِنْ فَعَلْتُمْ  لَيُتَأَرَّبُ  عَلَيْكُمْ ، ثُمَّ  انْسَلَّ  مِنَ اللَّيْلِ ، فَقَدِمَ  الْمَدِينَةَ  فَفَدَى أَبَاهُ بِأَرْبَعَةِ آلَافِ دِرْهَمٍ .","","Al-Mu'jam al-Kabir 14828","","عبد الله بن الزبير عن عباد بن عبد الله بن الزبير بن العوام عن يحيى بن عباد بن عبد الله بن الزبير بن العوام عن محمد بن إسحاق عن جرير بن حازم عن عبيد بن عقيل الهلالي عن عبدة بن عبد الله بن عبدة الخزاعي عن محمد بن زهير الأبلي عن الطبراني","عباد بن عبد الله بن الزبير عن أبيه"
"14868","[14/205]      مُصْعَبُ بْنُ ثَابِتِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، عَنْ جَدِّهِ  14829  -  حَدَّثَنَا  أَبُو يَزِيدَ يُوسُفُ بْنُ يَزِيدَ الْقَرَاطِيسِيُّ الْمِصْرِيُّ ، قَالَ :  دَثَنَا  حَجَّاجُ بْنُ إِبْرَاهِيمَ الْأَزْرَقُ ، قَالَ :  دَثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  مُصْعَبِ بْنِ ثَابِتٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  أَنَّهُ كَانَتْ بَيْنَهُ وَبَيْنَ  عَمْرِو بْنِ [الزُّبَيْرِ  ] خُصُومَةٌ  ، فَدَخَلَ  عَبْدُ اللهِ بْنُ الزُّبَيْرِ  عَلَى  سَعِيدِ بْنِ الْعَاصِ  وَعَمْرٌو  مَعَهُ عَلَى السَّرِيرِ ، فَقَالَ  سَعِيدٌ  لِعَبْدِ اللهِ بْنِ الزُّبَيْرِ  : هَهُنَا ، فَقَالَ : لَا ، قَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّ الْخَصْمَيْنِ يَقْعُدَانِ أَمَامَ الْحَاكِمِ  .","","Al-Mu'jam al-Kabir 14829","","عبد الله بن الزبير عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن عبد الله بن المبارك عن حجاج بن إبراهيم الأبناوي عن يوسف بن يزيد القراطيسي عن الطبراني","مصعب بن ثابت بن عبد الله بن الزبير عن جده"
"14869","[14/206]      14830  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي زُرْعَةَ الدِّمَشْقِيُّ ، قَالَ :  دَثَنَا  هِشَامُ بْنُ عَمَّارٍ ، قَالَ :  دَثَنَا  سَعِيدُ بْنُ يَحْيَى اللَّخْمِيُّ .  وَحَدَّثَنَا  الْحَسَنُ بْنُ جَرِيرٍ الصُّورِيُّ ، قَالَ :  دَثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ، قَالَ :  دَثَنَا  سَعْدَانُ بْنُ يَحْيَى اللَّخْمِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  مُصْعَبِ بْنِ ثَابِتٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ : أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا أَفْطَرَ عِنْدَ قَوْمٍ قَالَ :  أَفْطَرَ عِنْدَكُمُ الصَّائِمُونَ  ، وَصَلَّتْ عَلَيْكُمُ الْمَلَائِكَةُ .","","Al-Mu'jam al-Kabir 14830","","عبد الله بن الزبير عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن محمد بن عمرو بن علقمة بن وقاص الليثي عن سعيد بن يحيى سعدان عن هشام بن عمار عن محمد بن أبي زرعة النصري عن الطبراني","مصعب بن ثابت بن عبد الله بن الزبير عن جده"
"14870","14831  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ [حَمْدَانَ] الْحَنَفِيُّ الْأَصْبَهَانِيُّ ،         [14/207]      قَالَ :  دَثَنَا  الْوَلِيدُ بْنُ عَمْرِو بْنِ سِكِّينٍ الضُّبَعِيُّ ، قَالَ :  دَثَنَا  أَبُو هَمَّامٍ مُحَمَّدُ بْنُ الزِّبْرِقَانِ ، قَالَ :  دَثَنَا  مُوسَى بْنُ عُبَيْدَةَ ، قَالَ :  حَدَّثَنِي  مُصْعَبُ بْنُ ثَابِتٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، قَالَ :  مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَفَرٍ مِنْ أَصْحَابِهِ ، وَقَدْ عَرَضَ لَهُمْ شَيْءٌ أَضْحَكَهُمْ ، فَقَالَ :  أَتَضْحَكُونَ وَذِكْرُ الْجَنَّةِ وَالنَّارِ بَيْنَ أَيْدِيكُمْ ؟  فَنَزَلَتْ هَذِهِ الْآيَةُ :         {      نَبِّئْ عِبَادِي أَنِّي أَنَا الْغَفُورُ الرَّحِيمُ             *          وَأَنَّ عَذَابِي هُوَ الْعَذَابُ الأَلِيمُ         }      .","","Al-Mu'jam al-Kabir 14831","","عبد الله بن الزبير عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن موسى بن عبيدة بن نشيط الحميري عن محمد بن الزبرقان الأهوازي عن الوليد بن عمرو بن السكين الضبعي عن العباس بن حمدان الأصبهاني عن الطبراني","مصعب بن ثابت بن عبد الله بن الزبير عن جده"
"14871","[14/208]      نَافِعُ بْنُ ثَابِتِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، عَنْ جَدِّهِ .  14832  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  دَثَنَا  إِبْرَاهِيمُ بْنُ حَمْزَةَ الزُّبَيْرِيُّ ، قَالَ :  دَثَنَا  عَبْدُ اللهِ بْنُ نَافِعِ بْنِ ثَابِتٍ ،  عَنْ  أَخِيهِ ،  عَنْ  أَبِيهِ نَافِعِ بْنِ ثَابِتِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَرَّتَيْنِ ، أَوْ ثَلَاثًا  .","","Al-Mu'jam al-Kabir 14832","","عبد الله بن الزبير عن نافع بن ثابت بن عبد الله بن الزبير بن العوام عن عبد الله بن نافع الأكبر عن عبد الله بن نافع بن ثابت الزبيري عن إبراهيم بن حمزة الزبيري عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","نافع بن ثابت بن عبد الله بن الزبير عن جده"
"14872","14833  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ حَمْدَانَ الْأَصْبَهَانِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ صَاعِقَةُ ، قَالَ :  دَثَنَا  مَنْصُورُ بْنُ سَلَمَةَ الْخُزَاعِيُّ ، قَالَ :  حَدَّثَنَا  ابْنُ أَبِي الْمَوَالِ ، قَالَ :  أَخْبَرَنِي  نَافِعُ بْنُ ثَابِتٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا صَلَّى الْعِشَاءَ  رَكَعَ أَرْبَعَ رَكَعَاتٍ ، وَأَوْتَرَ بِسَجْدَةٍ ، ثُمَّ نَامَ حَتَّى يُصَلِّيَ بَعْدُ صَلَاتَهُ مِنَ اللَّيْلِ .","","Al-Mu'jam al-Kabir 14833","","عبد الله بن الزبير عن نافع بن ثابت بن عبد الله بن الزبير بن العوام عن عبد الرحمن بن أبي الموال مولى علي بن أبي طالب عن منصور بن سلمة بن عبد العزيز عن محمد بن عبد الرحيم  صاعقة عن العباس بن حمدان الأصبهاني عن الطبراني","نافع بن ثابت بن عبد الله بن الزبير عن جده"
"14873","[14/209]      يَحْيَى بْنُ عَبَّادِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، عَنْ جَدِّهِ  14834  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خَلَفٍ الْقَاضِي وَكِيعٌ ، قَالَ :  دَثَنَا  عَبْدُ اللهِ بْنُ شَبِيبٍ الْمَدَنِيُّ ، قَالَ :  دَثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ، قَالَ :  دَثَنَا  ابْنُ وَهْبٍ ،  عَنْ  سَعِيدِ بْنِ عَبْدِ الرَّحْمَنِ الْجُمَحِيِّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  يَحْيَى بْنِ عَبَّادِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  جَدِّهِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، قَالَ :  ضَرَبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِلزُّبَيْرِ  عَامَ خَيْبَرَ  بِأَرْبَعَةِ أَسْهُمٍ  :  سَهْمٍ  لِلزُّبَيْرِ ،  وَسَهْمٍ لِذِي الْقُرْبَى ، وَسَهْمٍ لِأُمِّهِ ، وَسَهْمٍ لِفَرَسِهِ  .","","Al-Mu'jam al-Kabir 14834","","عبد الله بن الزبير عن يحيى بن عباد بن عبد الله بن الزبير بن العوام عن هشام بن عروة بن الزبير عن سعيد بن عبد الرحمن الجمحي عن عبد الله بن وهب المصري عن إبراهيم بن المنذر الحزامي عن عبد الله بن شبيب الربعي عن محمد بن خلف وكيع عن الطبراني","يحيى بن عباد بن عبد الله بن الزبير عن جده"
"14874","[14/210]      عُرْوَةُ بْنُ الزُّبَيْرِ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14835  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ، قَالَ :  دَثَنَا  عَبْدُ الرَّزَّاقِ ، قَالَ :  دَثَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  حَدَّثَنِي  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، أَنَّهُ حَدَّثَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تُحَرِّمُ الْمَصَّةُ مِنَ الرَّضَاعَةِ  ، وَلَا الْمَصَّتَانِ  .","","Al-Mu'jam al-Kabir 14835","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عروة بن الزبير"
"14875","[14/211]      14836  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ ، قَالَ :  دَثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدٍ الشَّافِعِيُّ ، قَالَ :  دَثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُحَرِّمُ الْمَصَّةُ وَلَا الْمَصَّتَانِ  .","","Al-Mu'jam al-Kabir 14836","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبيد الله بن عمر العمري عن عبد الله بن رجاء البصري عن إبراهيم بن محمد بن العباس المطلبي عن محمد بن علي بن زيد الصائغ عن الطبراني","عروة بن الزبير"
"14876","14837  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  دَثَنَا  حَجَّاجٌ ، قَالَ :         [14/212]      دَثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14837","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عروة بن الزبير"
"14877","14838  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ، قَالَ :  حَثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ، قَالَ :  حَثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ عُرْوَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، قَالَ :  وَدِدْتُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَعْطَانَا  النِّدَاءَ  ، قُلْتُ : لِمَ ذَاكَ ؟ قَالَ : لِأَنَّهُمْ أَطْوَلُ أَهْلِ الْجَنَّةِ  أَعْنَاقًا  يَوْمَ الْقِيَامَةِ .","","Al-Mu'jam al-Kabir 14838","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن محمد بن يحيى المدني عن إبراهيم بن المنذر الحزامي عن محمد بن علي بن زيد الصائغ عن الطبراني","عروة بن الزبير"
"14878","14839  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ، قَالَ :  حَنَا  عَمْرُو بْنُ أَبِي سَلَمَةَ التِّنِّيسِيُّ ، قَالَ :  دَنَا  حَفْصُ بْنُ مَيْسَرَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْعُمْرَى  جَائِزَةٌ لِمَنْ أُعْمِرَهَا  ، وَالرُّقْبَى لِمَنْ أُرْقِبَهَا ، سَبِيلُهَا سَبِيلُ الْمِيرَاثِ  .","","Al-Mu'jam al-Kabir 14839","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حفص بن ميسرة العقيلي عن عمرو بن أبي سلمة التنيسي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","عروة بن الزبير"
"14879","[14/213]      14840  -  حَدَّثَنَا  أَبُو يَزِيدَ يُوسُفُ بْنُ يَزِيدَ الْقَرَاطِيسِيُّ ، قَالَ :  دَثَنَا  يَعْقُوبُ بْنُ أَبِي عَبَّادٍ الْمَكِّيُّ ، قَالَ :  دَثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ،  فِي قَوْلِ اللهِ :         {      خُذِ الْعَفْوَ         }      قَالَ :  أَمَرَ اللهُ نَبِيَّهُ أَنْ يَأْخُذَ  الْعَفْوَ  مِنْ  أَخْلَاقِ  النَّاسِ  .","","Al-Mu'jam al-Kabir 14840","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن يعقوب بن إسحاق القلزمي عن يوسف بن يزيد القراطيسي عن الطبراني","عروة بن الزبير"
"14880","14841  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، قَالَ :  دَثَنَا  زَيْدُ بْنُ الْحَرِيشِ ، قَالَ :  دَثَنَا  عُمَرُ بْنُ عَلِيٍّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، قَالَ :  نَزَلَتْ هَذِهِ الْآيَةُ فِي  النَّجَاشِيِّ  :         {      وَإِذَا سَمِعُوا مَا أُنْـزِلَ إِلَى الرَّسُولِ تَرَى أَعْيُنَهُمْ تَفِيضُ مِنَ الدَّمْعِ         }      .","","Al-Mu'jam al-Kabir 14841","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عمر بن علي بن عطاء عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","عروة بن الزبير"
"14881","[14/214]      14842  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ، قَالَ :  دَثَنَا  خَلَّادُ بْنُ أَسْلَمَ ، قَالَ :  دَثَنَا  حَنِيفَةُ بْنُ مَرْزُوقٍ ، قَالَ :  دَثَنَا  شَرِيكٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  قَالَ :  مَنْ يَأْكُلُ الْغُرَابَ وَقَدْ سَمَّاهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَاسِقًا .  ؟","","Al-Mu'jam al-Kabir 14842","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن شريك بن عبد الله النخعي عن حنيفة بن مرزوق عن خلاد بن أسلم الصفار عن محمد بن العباس ابن الأخرم عن الطبراني","عروة بن الزبير"
"14882","[14/215]      14843  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الْمِصْرِيُّ ، قَالَ :  دَثَنَا  شُعَيْبُ بْنُ يَحْيَى التُّجِيبِيُّ (  ح  ) .  وَحَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ، قَالَ :  دَثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ (  ح  ) .  وَدَثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ، قَالَ :  دَثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ (  ح  ) .         [14/216]      وَدَثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ، وَأَبُو خَلِيفَةَ الْفَضْلُ بْنُ حُبَابٍ الْجُمَحِيُّ ، قَالَا :  دَثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، قَالُوا :  حَدَّثَنَا  اللَّيْثُ بْنُ سَعْدٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ : أَنَّ عَبْدَ اللهِ بْنَ الزُّبَيْرِ  ،         [14/217]      حَدَّثَهُ  :  أَنَّ  رَجُلًا مِنَ الْأَنْصَارِ  خَاصَمَ  الزُّبَيْرَ  عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  شِرَاجِ  الْحَرَّةِ  الَّتِي يَسْقُونَ بِهَا النَّخْلَ ، فَقَالَ الْأَنْصَارِيُّ : سَرِّحِ الْمَاءَ ، فَأَبَى عَلَيْهِ  الزُّبَيْرُ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اسْقِ يَا  زُبَيْرُ  ، ثُمَّ أَرْسِلْ إِلَى جَارِكَ  . فَغَضِبَ الْأَنْصَارِيُّ ، فَقَالَ : يَا رَسُولَ اللهِ ، أَنْ كَانَ ابْنَ عَمَّتِكَ ؟ فَتَلَوَّنَ وَجْهُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : اسْقِ يَا  زُبَيْرُ  ، ثُمَّ احْبِسِ الْمَاءَ حَتَّى يَرْجِعَ إِلَى  الْجَدْرِ  . قَالَ  الزُّبَيْرُ  :         [14/218]      فَوَاللهِ إِنِّي لَأَحْسَبُ هَذِهِ الْآيَةَ نَزَلَتْ فِي ذَلِكَ :         {      فَلا وَرَبِّكَ لا يُؤْمِنُونَ حَتَّى يُحَكِّمُوكَ فِيمَا شَجَرَ بَيْنَهُمْ         }      ، الْآيَةَ  .","","Al-Mu'jam al-Kabir 14843","","عبد الله بن الزبير عن عروة بن الزبير عن الزهري عن الليث بن سعد عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","عروة بن الزبير"
"14883","14844  -  حَدَّثَنَا  مُحَمَّدُ بْنُ فَضَاءٍ الْجَوْهَرِيُّ ، قَالَ :  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ حِسَابٍ ، قَالَ :  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِكُلِّ نَبِيٍّ  حَوَارِيٌّ  ،  وَالزُّبَيْرُ  حَوَارِيَّ  مِنْ أُمَّتِي  .","","Al-Mu'jam al-Kabir 14844","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن محمد بن عبيد بن حساب الغبري عن محمد بن قضاء الجوهري عن الطبراني","عروة بن الزبير"
"14884","[14/219]      عَبْدُ اللهِ بْنُ عُرْوَةَ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14845  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ، قَالَ :  حَدَّثَنَا  أَبُو صَالِحٍ عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ خَالِدِ بْنِ مُسَافِرٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُرْوَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، قَالَ :  إِنَّمَا سُمِّيَ  الْبَيْتُ الْعَتِيقَ  ، لِأَنَّ اللهَ أَعْتَقَهُ مِنَ الْجَبَابِرَةِ  .","","Al-Mu'jam al-Kabir 14845","","عبد الله بن الزبير عن عبد الله بن عروة بن الزبير بن العوام عن الزهري عن عبد الرحمن بن خالد بن مسافر الفهمي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عبد الله بن عروة عن عبد الله بن الزبير"
"14885","[14/220]      يُوسُفُ مَوْلَى الزُّبَيْرِ  ، عَنِ  ابْنِ الزُّبَيْرِ  14846  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  حَدَّثَنَا  أَبُو حُذَيْفَةَ ، قَالَ :  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  يُوسُفَ ، مَوْلَى الزُّبَيْرِ ،  عَنِ  ابْنِ الزُّبَيْرِ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  يَا نَبِيَّ اللهِ ،         [14/221]      أَحُجُّ عَنْ أَبِي ؟ فَقَالَ : أَنْتَ أَكْبَرُ وَلَدِهِ ؟  قَالَ : نَعَمْ ، قَالَ : فَاحْجُجْ عَنْهُ  .","","Al-Mu'jam al-Kabir 14846","","عبد الله بن الزبير عن يوسف بن الزبير الأسدي عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن سفيان الثوري عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","يوسف مولى الزبير عن ابن الزبير"
"14886","14847  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ الزُّبَيْرِ ،  أَنَّ  زَمْعَةَ  ، كَانَتْ لَهُ  جَارِيَةٌ  ، وَكَانَ يَتَّطِئُهَا ، وَكَانُوا يَتَّهِمُونَهَا ، فَوَلَدَتْ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِسَوْدَةَ  :  أَمَّا الْمِيرَاثُ فَلَهُ ، وَأَمَّا أَنْتِ فَاحْتَجِبِي مِنْهُ يَا  سَوْدَةُ  ، فَإِنَّهُ لَيْسَ لَكِ بِأَخٍ  .","","Al-Mu'jam al-Kabir 14847","","عبد الله بن الزبير عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","يوسف مولى الزبير عن ابن الزبير"
"14887","14848  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ أَحْمَدَ بْنِ عُمَرَ الْوَكِيعِيُّ ، قَالَ :  حَدَّثَنِي  أَبِي  ، قَالَ :  دَثَنَا  يَحْيَى بْنُ آدَمَ ، قَالَ :  دَثَنَا  قَيْسٌ وَمُفَضَّلُ بْنُ مُهَلْهَلٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  يُوسُفَ ، قَالَ :  سَمِعْتُ  ابْنَ الزُّبَيْرِ يُحَدِّثُ عَنِ         [14/222]      النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ جَعَلَ لَهُ الْمِيرَاثَ ، لِأَنَّهُ وُلِدَ عَلَى فِرَاشِ  زَمْعَةَ  ، وَقَالَ  لِسَوْدَةَ  :  وَأَمَّا أَنْتِ فَاحْتَجِبِي عَنْهُ  .","","Al-Mu'jam al-Kabir 14848","","عبد الله بن الزبير عن يوسف بن الزبير الأسدي عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن قيس بن الربيع الأسدي عن يحيى بن آدم عن أحمد بن عمر الوكيعي عن إبراهيم بن أحمد بن عمر الوكيعي عن الطبراني","يوسف مولى الزبير عن ابن الزبير"
"14888","14849  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ، قَالَ :  دَثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَ :  دَثَنَا  حُسَيْنُ بْنُ عَلِيٍّ الْجُعْفِيُّ ،  عَنْ  زَائِدَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ الزُّبَيْرِ - أَوْ  عَنْ  مَوْلًى لِابْنِ الزُّبَيْرِ -  عَنِ  ابْنِ الزُّبَيْرِ  ، قَالَ :  كَانَ  زَمْعَةُ  يَطَأُ  جَارِيَةً  ... فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 14849","","عبد الله بن الزبير عن مولى لابن الزبير عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن زائدة بن قدامة عن الحسين بن علي الجعفي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","يوسف مولى الزبير عن ابن الزبير"
"14889","[14/223]      الْقَاسِمُ بْنُ مُحَمَّدٍ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14850  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ، قَالَ :  دَثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ ، يَقُولُ :  مِنْ سُنَّةِ الْحَاجِّ أَنْ يُصَلِّيَ يَوْمَ  التَّرْوِيَةِ  الظُّهْرَ وَالْعَصْرَ وَالْمَغْرِبَ وَالْعِشَاءَ الْآخِرَةَ وَالصُّبْحَ  بِمِنًى  ، ثُمَّ يَغْدُوَ فَيَقِيلَ حَيْثُ كَتَبَ اللهُ لَهُ ، ثُمَّ يَرُوحَ إِذَا زَالَتِ الشَّمْسُ ، فَيَخْطُبَ النَّاسَ ، ثُمَّ يَنْزِلَ فَيَجْمَعَ بَيْنَ الصَّلَاتَيْنِ الظُّهْرِ وَالْعَصْرِ ، ثُمَّ يَقِفَ  بِعَرَفَةَ  ، فَيَدْفَعَ إِذَا غَرَبَتِ الشَّمْسُ ، ثُمَّ يُصَلِّيَ الْمَغْرِبَ حَيْثُ قَدَرَ اللهُ لَهُ أَنْ يُصَلِّيَ ، ثُمَّ يَقِفَ  بِالْمُزْدَلِفَةِ  ، فَإِذَا طَلَعَ الْفَجْرُ صَلَّى الصُّبْحَ ، ثُمَّ يَدْفَعَ إِذَا أَصْبَحَ ، فَإِذَا رَمَى الْجَمْرَةَ فَقَدْ حَلَّ لَهُ مَا حَرُمَ عَلَيْهِ إِلَّا النِّسَاءَ حَتَّى يَطُوفَ  بِالْبَيْتِ  .","","Al-Mu'jam al-Kabir 14850","","عبد الله بن الزبير عن القاسم بن محمد بن أبي بكر الصديق عن يحيى بن سعيد الأنصاري عن الليث بن سعد عن عبد الله بن صالح المصري عن يوسف بن يزيد القراطيسي عن الطبراني","القاسم بن محمد عن عبد الله بن الزبير"
"14890","[14/224]      عَطَاءُ بْنُ أَبِي رَبَاحٍ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14851  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  دَثَنَا  عَارِمٌ ، قَالَ :  دَثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  حَبِيبٍ الْمُعَلِّمِ ،  عَنْ  عَطَاءٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَلَاةٌ فِي مَسْجِدِي هَذَا أَفْضَلُ         [14/225]      مِنْ أَلْفِ صَلَاةٍ فِيمَا سِوَاهُ  ، إِلَّا  الْمَسْجِدَ الْحَرَامَ  ، وَصَلَاةٌ فِي  الْمَسْجِدِ الْحَرَامِ  أَفْضَلُ مِنْ صَلَاةٍ فِي مَسْجِدِي بِأَلْفِ صَلَاةٍ  .","","Al-Mu'jam al-Kabir 14851","","عبد الله بن الزبير عن عطاء بن أبي رباح عن حبيب المعلم مولى معقل بن يسار عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عطاء بن أبي رباح عن عبد الله بن الزبير"
"14891","[14/226]      14852  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَتُّوَيْهِ الْأَصْبَهَانِيُّ ، قَالَ :  دَثَنَا  يَحْيَى بْنُ حُجْرٍ الْبَصْرِيُّ ، قَالَ :  دَثَنَا  مُسْلِمُ بْنُ خَالِدٍ ،  عَنْ  خَلَّادِ بْنِ عَطَاءٍ ، قَالَ :  سَمِعْتُ  عَطَاءَ بْنَ أَبِي رَبَاحٍ ، يَقُولُ :  سَمِعْتُ  ابْنَ الزُّبَيْرِ ، يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فُضِّلَ  الْمَسْجِدُ الْحَرَامُ  عَلَى مَسْجِدِي مِائَةَ صَلَاةٍ  .","","Al-Mu'jam al-Kabir 14852","","عبد الله بن الزبير عن عطاء بن أبي رباح عن خلاد بن عطاء بن أبي رباح عن مسلم بن خالد الزنجي عن يحيى بن حجر البصري عن إبراهيم بن محمد الطيان عن الطبراني","عطاء بن أبي رباح عن عبد الله بن الزبير"
"14892","14853  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْوَلِيدِ النَّرْسِيُّ ، قَالَ :  دَثَنَا  زَيْدُ بْنُ أَخْزَمَ ، قَالَ :  دَثَنَا  أَبُو قُتَيْبَةَ ، قَالَ :  دَثَنَا  الرَّبِيعُ بْنُ صُبَيْحٍ ، قَالَ :  دَثَنَا  عَطَاءٌ ، قَالَ :  خَطَبَنَا ابْنُ الزُّبَيْرِ ،  فَقَالَ  : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَلَاةٌ فِي مَسْجِدِي هَذَا أَفْضَلُ مِنْ أَلْفِ صَلَاةٍ فِيمَا سِوَاهُ مِنَ الْمَسَاجِدِ  إِلَّا  الْمَسْجِدَ الْحَرَامَ  .","","Al-Mu'jam al-Kabir 14853","","عبد الله بن الزبير عن عطاء بن أبي رباح عن الربيع بن صبيح عن سلم بن قتيبة الشعيري عن زيد بن أخزم الطائي عن محمد بن صالح النرسي عن الطبراني","عطاء بن أبي رباح عن عبد الله بن الزبير"
"14893","14854  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ :  دَثَنَا  جَعْفَرُ بْنُ مِهْرَانَ السَّبَّاكُ ، قَالَ :  دَثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  حَبِيبٍ الْمُعَلِّمِ ،  عَنْ         [14/227]      عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، وَابْنِ الزُّبَيْرِ : أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  عُمْرَةٌ فِي رَمَضَانَ تَعْدِلُ حَجَّةً  .","","Al-Mu'jam al-Kabir 14854","","عبد الله بن الزبير عن عطاء بن أبي رباح عن حبيب المعلم مولى معقل بن يسار عن عبد الوارث بن سعيد بن ذكوان عن جعفر بن مهران السباك عن عبد الله بن أحمد بن حنبل عن الطبراني","عطاء بن أبي رباح عن عبد الله بن الزبير"
"14894","14855  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي خَيْثَمَةَ ، قَالَ :  دَثَنَا  الْفَضْلُ بْنُ سَهْلٍ ، قَالَ :  دَثَنَا  أَبُو الْجَوَّابِ ، قَالَ :  دَثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  لَيْثٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، قَالَ :  مَا كَانُوا يَغْسِلُونَ أَسْتَاهَهُمْ بِالْمَاءِ  .","","Al-Mu'jam al-Kabir 14855","","عبد الله بن الزبير عن عطاء بن أبي رباح عن ليث بن أبي سليم عن سفيان الثوري عن أحوص بن جواب الضبي عن الفضل بن سهل الخراساني عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","عطاء بن أبي رباح عن عبد الله بن الزبير"
"14895","[14/228]      عَبْدُ اللهِ بْنُ أَبِي مُلَيْكَةَ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14856  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ، قَالَ :  دَثَنَا  عَبْدُ الرَّزَّاقِ ، قَالَ :  أَخْبَرَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  سَمِعْتُ  ابْنَ أَبِي مُلَيْكَةَ ، يُحَدِّثُ  أَنَّ  ابْنَ الزُّبَيْرِ كَتَبَ إِلَى  أَهْلِ الْعِرَاقِ  : إِنَّ الَّذِي قَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لَوْ كُنْتُ مُتَّخِذًا  خَلِيلًا  حَتَّى أَلْقَى اللهَ سِوَى اللهِ لَاتَّخَذْتُ أَبَا بَكْرٍ  خَلِيلًا  ،  فَكَانَ يَجْعَلُ الْجَدَّ أَبًا  .","","Al-Mu'jam al-Kabir 14856","","أبو  بكر الصديق عن عبد الله بن الزبير عن ابن أبي مليكة عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبد الله بن أبي مليكة عن عبد الله بن الزبير"
"14896","[14/229]      14857  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ بَحْرٍ الْهُجَيْمِيُّ ، قَالَ :  دَثَنَا  سَعِيدُ بْنُ سَالِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  مَنْ قَرَأَ الْقُرْآنَ ظَاهِرًا أَوْ نَظَرًا أُعْطِيَ  شَجَرَةً  فِي الْجَنَّةِ  ، لَوْ أَنَّ غُرَابًا أَفْرَخَ تَحْتَ وَرَقَةٍ مِنْهَا ، ثُمَّ أَدْرَكَ ذَلِكَ الْفَرْخَ فَنَهَضَ ، لَأَدْرَكَهُ  الْهَرَمُ  قَبْلَ أَنْ يَقْطَعَ تِلْكَ الْوَرَقَةَ  .","","Al-Mu'jam al-Kabir 14857","","عبد الله بن الزبير عن ابن أبي مليكة عن ابن جريج عن سعيد بن سالم القداح عن محمد بن بحر الهجيمي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","عبد الله بن أبي مليكة عن عبد الله بن الزبير"
"14897","[14/230]      14858  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  دَثَنَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ ، قَالَ :  دَثَنَا  نَافِعُ بْنُ عُمَرَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ :  أَنَّ  الْأَقْرَعَ بْنَ حَابِسٍ  ، قَدِمَ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ  أَبُو بَكْرٍ  : يَا رَسُولَ اللهِ ، اسْتَعْمِلْهُ عَلَى قَوْمِهِ  ، فَقَالَ  عُمَرُ  : لَا تَسْتَعْمِلْهُ يَا رَسُولَ اللهِ . فَتَكَلَّمَا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى ارْتَفَعَتْ أَصْوَاتُهُمَا ، فَقَالَ  أَبُو بَكْرٍ  لِعُمَرَ  : مَا أَرَدْتَ إِلَّا خِلَافِي ، قَالَ : مَا أَرَدْتُ خِلَافَكَ ، قَالَ : فَنَزَلَتْ         {      يَا أَيُّهَا الَّذِينَ آمَنُوا لا تَرْفَعُوا أَصْوَاتَكُمْ فَوْقَ صَوْتِ النَّبِيِّ         }      فَكَانَ  عُمَرُ  بَعْدَ ذَلِكَ إِذَا تَكَلَّمَ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يَسْمَعْ كَلَامَهُ حَتَّى يَسْتَفْهِمَهُ .","","Al-Mu'jam al-Kabir 14858","","عبد الله بن الزبير عن ابن أبي مليكة عن نافع بن عمر بن عبد الله بن جميل الجمحي عن مؤمل بن إسماعيل العدوي عن أبو موسى الزمن عن الساجي عن الطبراني","عبد الله بن أبي مليكة عن عبد الله بن الزبير"
"14898","[14/231]      14859  -  حَدَّثَنَا  جَعْفَرُ بْنُ سُنَيْدِ بْنِ دَاوُدَ ، قَالَ :  حَدَّثَنَا  أَبِي  .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ نَاجِيَةَ ، قَالَ :  دَثَنَا  الْحَسَنُ بْنُ مُحَمَّدٍ الزَّعْفَرَانِيُّ ، قَالَا :  حَدَّثَنَا  حَجَّاجٌ ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  ابْنُ أَبِي مُلَيْكَةَ :  أَنَّ عَبْدَ اللهِ بْنَ الزُّبَيْرِ  أَخْبَرَهُمْ  :  أَنَّهُ قَدِمَ رَكْبٌ مِنْ  بَنِي تَمِيمٍ  عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيهِمُ  الْأَقْرَعُ بْنُ حَابِسٍ  ، فَقَالَ  أَبُو بَكْرٍ  : يَا رَسُولَ اللهِ ، اسْتَعْمِلِ  الْأَقْرَعَ  عَلَى قَوْمِهِ ، فَقَالَ  عُمَرُ  : يَا رَسُولَ اللهِ ، لَا تَسْتَعْمِلْهُ ، فَتَنَازَعَا حَتَّى ارْتَفَعَتْ أَصْوَاتُهُمَا ، فَقَالَ  أَبُو بَكْرٍ  : مَا أَرَدْتَ إِلَّا خِلَافِي ، فَقَالَ  عُمَرُ  : مَا أَرَدْتُ خِلَافَكَ . فَتَمَارَيَا حَتَّى ارْتَفَعَتْ أَصْوَاتُهُمَا ، فَنَزَلَ فِي ذَلِكَ :         {      يَا أَيُّهَا الَّذِينَ آمَنُوا لا تُقَدِّمُوا بَيْنَ يَدَيِ اللهِ وَرَسُولِهِ         }      حَتَّى انْقَضَتِ الْآيَةُ  .","","Al-Mu'jam al-Kabir 14859","","عبد الله بن الزبير عن ابن أبي مليكة عن ابن جريج عن حجاج بن محمد الأعور عن الحسن بن محمد الزعفراني عن عبد الله بن محمد بن ناجية البربري عن الطبراني","عبد الله بن أبي مليكة عن عبد الله بن الزبير"
"14899","[14/232]      14860  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  دَثَنَا  أَحْمَدُ بْنُ مَنِيعٍ ، قَالَ :  دَثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  عَنْ  أَيُّوبَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ الزُّبَيْرِ ،  أَنَّ  عَلِيًّا  ذَكَرَ  بِنْتَ أَبِي جَهْلٍ  ، فَبَلَغَ ذَلِكَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  إِنَّمَا  فَاطِمَةُ  بَضْعَةٌ  مِنِّي ، يُؤْذِينِي مَا آذَاهَا  ،  وَيُنْصِبُنِي  مَا أَنْصَبَهَا  .","","Al-Mu'jam al-Kabir 14860","","عبد الله بن الزبير عن ابن أبي مليكة عن أيوب السختياني عن إسماعيل ابن علية عن أحمد بن منيع البغوي عن الحسين بن إسحاق التستري عن الطبراني","عبد الله بن أبي مليكة عن عبد الله بن الزبير"
"14900","[14/233]      عَمْرُو بْنُ دِينَارٍ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14861  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  دَثَنَا  أَبُو حُذَيْفَةَ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  أَنَّ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ ، قَالَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا مِنْ صَاحِبِ إِبِلٍ إِلَّا يُؤْتَى بِهِ يَوْمَ الْقِيَامَةِ إِذَا لَمْ يَكُنْ يُؤَدِّي حَقَّهَا  ، فَتَمْشِي عَلَيْهِ بِقَاعٍ يَطَؤُهُ  بِأَخْفَافِهَا  . وَيُؤْتَى بِصَاحِبِ الْبَقَرِ إِذَا لَمْ يَكُنْ يُؤَدِّي حَقَّهَا ، فَتَمْشِي عَلَيْهِ بِقَاعٍ ، تَطَؤُهُ         [14/234]      بِأَظْلَافِهَا  وَتَنْطَحُهُ بِقُرُونِهَا . وَيُؤْتَى بِصَاحِبِ الْغَنَمِ إِذَا لَمْ يُؤَدِّي حَقَّهَا ، فَتَمْشِي عَلَيْهِ بِقَاعٍ ، فَتَنْطَحُهُ بِقُرُونِهَا وَتَطَؤُهُ  بِأَظْلَافِهَا  ، لَيْسَ فِيهَا  جَمَّاءُ  وَلَا مَكْسُورَةُ الْقَرْنِ . وَيُؤْتَى بِصَاحِبِ الْكَنْزِ فَيُمَثَّلُ لَهُ  شُجَاعٌ  أَقْرَعُ فَلَا يَجِدُ شَيْئًا فَيُدْخِلُ يَدَهُ فِي فِيهِ  .  رَوَاهُ  عَمْرُو بْنُ دِينَارٍ  ، عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ اللَّيْثِيِّ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مُرْسَلًا  .","","Al-Mu'jam al-Kabir 14861","","عبد الله بن الزبير عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن عبد الله بن الزبير"
"14901","14862  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  دَثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ         [14/235]      دِينَارٍ ،  عَنِ  ابْنِ الزُّبَيْرِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ  نُوقِشَ  الْمُحَاسَبَةَ هَلَكَ  .","","Al-Mu'jam al-Kabir 14862","","عبد الله بن الزبير عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن أبو عامر العقدي عن محمد بن معمر بن ربعي البحراني عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن عبد الله بن الزبير"
"14902","14863  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْأَصْفَهَانِيُّ ، قَالَ :  دَثَنَا  عَقِيلُ بْنُ يَحْيَى الطِّهْرَانِيُّ ، قَالَ :  دَثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ، قَالَ :  حَدَّثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، قَالَ :  لَيْسَ مِنَ السُّنَّةِ الصَّلَاةُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ الْجُمُعَةِ عَلَى الْمِنْبَرِ  .","","Al-Mu'jam al-Kabir 14863","","عبد الله بن الزبير عن عمرو بن دينار الأثرم عن ليث بن أبي سليم عن جرير بن عبد الحميد عن أبو داود الطيالسي عن عقيل بن يحيى بن الأسود الطهراني عن محمد بن يحيى الأصفهاني عن الطبراني","عمرو بن دينار عن عبد الله بن الزبير"
"14903","[14/236]      14864  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ أُسَيْدٍ الْأَصْبَهَانِيُّ ، قَالَ :  دَثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْبُزُورِيُّ ، قَالَ :  دَثَنَا  يَحْيَى بْنُ مُوسَى الطَّائِفِيُّ ،  عَنْ  مُسْلِمِ بْنِ رُزَيْقٍ الْمَخْزُومِيِّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، قَالَ :  أَمَرَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَمَّهُ  الْعَبَّاسَ  يَأْمُرُ بَنِيهِ أَنْ يَحْرُثُوا الْقَضْبَ  ، فَإِنَّهُ يَنْفِي الْفَقْرَ . قَالَ :  وَالْقَضْبُ : الرَّطْبَةُ  .","","Al-Mu'jam al-Kabir 14864","","عبد الله بن الزبير عن عمرو بن دينار الأثرم عن مسلم بن زريق المخزومي عن يحيى بن موسى الطائفي عن جعفر بن محمد البزوري عن عبد الله بن أحمد بن أسيد الرحال عن الطبراني","عمرو بن دينار عن عبد الله بن الزبير"
"14904","طَاوُسُ بْنُ كَيْسَانَ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14865  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ، قَالَ :  دَثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ، قَالَ :  أَخْبَرَنَا  الْفَضْلُ بْنُ مُوسَى .         [14/237]      وَدَثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  دَثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ الْهَرَوِيُّ ، قَالَ :  دَثَنَا  الْفَضْلُ بْنُ مُوسَى السِّينَانِيُّ ،  عَنْ  مَعْمَرٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ الزُّبَيْرِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ  شَهَرَ  سَيْفَهُ ثُمَّ  وَضَعَهُ  فَدَمُهُ هَدَرٌ  .  يَعْنِي ""  وَضَعَهُ  "" : ضَرَبَ بِهِ  .","","Al-Mu'jam al-Kabir 14865","","عبد الله بن الزبير عن طاوس بن كيسان عن عبد الله بن طاووس عن معمر بن راشد عن الفضل بن موسى السيناني عن إبراهيم بن عبد الله الهروي عن الحسين بن إسحاق التستري عن الطبراني","طاوس بن كيسان عن عبد الله بن الزبير"
"14905","الْعَبَّاسُ بْنُ سَهْلِ بْنِ سَعْدٍ السَّاعِدِيُّ  ، عَنِ  ابْنِ الزُّبَيْرِ  14866  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ ، وَأَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ، قَالَا :  دَثَنَا  أَبُو نُعَيْمٍ ، قَالَ :  دَثَنَا  عَبْدُ الرَّحْمَنِ         [14/238]      بْنُ الْغَسِيلِ ،  عَنِ  الْعَبَّاسِ بْنِ سَهْلِ بْنِ سَعْدٍ ، قَالَ :  سَمِعْتُ  ابْنَ الزُّبَيْرِ ، عَلَى مِنْبَرِ  مَكَّةَ  يَقُولُ فِي خُطْبَتِهِ : يَا أَيُّهَا النَّاسُ ، إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ :  لَوْ أَنَّ ابْنَ آدَمَ أُعْطِيَ وَادِيًا مِنْ ذَهَبٍ أَحَبَّ إِلَيْهِ ثَانِيًا  ، وَلَوْ أُعْطِيَ ثَانِيًا أَحَبَّ إِلَيْهِ ثَالِثًا ، وَلَا يَمْلَأُ جَوْفَ ابْنِ آدَمَ إِلَّا التُّرَابُ ، وَيَتُوبُ اللهُ عَلَى مَنْ تَابَ  .","","Al-Mu'jam al-Kabir 14866","","عبد الله بن الزبير عن عباس بن سهل بن سعد الساعدي عن عبد الرحمن بن سليمان الأوسي عن الفضل بن دكين عن أبو زرعة الدمشقي عن الطبراني","العباس بن سهل بن سعد الساعدي عن ابن الزبير"
"14906","أَبُو الْحَكَمِ عِمْرَانُ السُّلَمِيُّ  ، عَنِ  ابْنِ الزُّبَيْرِ  14867  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  دَثَنَا  أَبُو حُذَيْفَةَ ، قَالَ :  دَثَنَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  عِمْرَانَ السُّلَمِيِّ ، قَالَ :  أَتَيْتُ ابْنَ الزُّبَيْرِ  فَسَأَلْتُهُ  عَنِ النَّبِيذِ ، فَقَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ نَبِيذِ  الْجَرِّ  وَالدُّبَّاءِ  .","","Al-Mu'jam al-Kabir 14867","","عبد الله بن الزبير عن عمران بن الحارث السلمي عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو الحكم عمران السلمي عن ابن الزبير"
"14907","[14/239]      14868  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي ، قَالَ :  دَثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ، قَالَ :  دَثَنَا  شُعْبَةُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي الْحَكَمِ السُّلَمِيِّ ، قَالَ :  سَأَلْتُ  ابْنَ الزُّبَيْرِ فَقَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْجَرِّ  وَالدُّبَّاءِ  .","","Al-Mu'jam al-Kabir 14868","","عبد الله بن الزبير عن عمران بن الحارث السلمي عن سلمة بن كهيل الحضرمي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","أبو الحكم عمران السلمي عن ابن الزبير"
"14908","الْحَسَنُ بْنُ يَنَّاقَ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14869  -  دَثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ الْمَكِّيُّ ، قَالَ :  دَثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ، قَالَ :  دَثَنَا  بِشْرُ بْنُ السَّرِيِّ ،  عَنْ  إِبْرَاهِيمَ بْنِ نَافِعٍ ،  عَنِ  الْحَسَنِ بْنِ مُسْلِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَوْ كُنْتُ مُتَّخِذًا  خَلِيلًا  غَيْرَ رَبِّي لَاتَّخَذْتُ  أَبَا بَكْرٍ  خَلِيلًا  ، وَلَكِنْ أَخِي وَصَاحِبِي فِي الْغَارِ  .","","Al-Mu'jam al-Kabir 14869","","عبد الله بن الزبير عن الحسن بن مسلم بن يناق عن إبراهيم بن نافع المخزومي عن بشر بن السري عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","الحسن بن يناق عن عبد الله بن الزبير"
"14909","[14/240]      عَبِيدَةُ بْنُ عَمْرٍو السَّلْمَانِيُّ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14870  -  دَثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  دَثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْوَهَّابِ الْحَجَبِيُّ ، قَالَ :  دَثَنَا  خَالِدُ بْنُ الْحَارِثِ ، قَالَ :  دَثَنَا  شُعْبَةُ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي الْبَخْتَرِيِّ ،  عَنْ  عَبِيدَةُ ،  عَنِ  ابْنِ الزُّبَيْرِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ رَجُلًا حَلَفَ بِاللهِ الَّذِي لَا إِلَهَ إِلَّا هُوَ كَاذِبًا ، فَغُفِرَ لَهُ  .","","Al-Mu'jam al-Kabir 14870","","عبد الله بن الزبير عن عبيدة بن عمرو السلماني عن سعيد بن فيروز الطائي عن عطاء بن السائب عن شعبة بن الحجاج عن خالد الصدق عن عبد الله بن عبد الوهاب الحجبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبيدة بن عمرو السلماني عن عبد الله بن الزبير"
"14910","[14/241]      عَبْدُ اللهِ الْبَهِيُّ مَوْلَى الزُّبَيْرِ  ، عَنِ  ابْنِ الزُّبَيْرِ  14871  -  دَثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْخُزَاعِيُّ الْأَصْبَهَانِيُّ ، قَالَ :  دَثَنَا  الْقَعْنَبِيُّ .  وَدَثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  دَثَنَا  أَبُو نُعَيْمٍ ضِرَارُ بْنُ صُرَدٍ .  وَدَثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ، قَالَ :  دَثَنَا  أَصْبَغُ بْنُ الْفَرَجِ ، قَالُوا :  دَثَنَا  عَلِيُّ بْنُ عَابِسٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنِ  الْبَهِيِّ مَوْلَى الزُّبَيْرِ ،  عَنِ  ابْنِ الزُّبَيْرِ ، قَالَ :  لَقَدْ رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَاجِدًا حَتَّى جَاءَ  الْحَسَنُ بْنُ عَلِيٍّ  فَصَعِدَ عَلَى ظَهْرِهِ  ، فَمَا أَنْزَلَهُ حَتَّى كَانَ هُوَ الَّذِي نَزَلَ ، وَإِنْ كَانَ لَيُفَرِّجُ لَهُ رِجْلَيْهِ فَيَدْخُلُ مِنْ ذَا الْجَانِبِ وَيَخْرُجُ مِنْ ذَا الْجَانِبِ الْآخَرِ  .","","Al-Mu'jam al-Kabir 14871","","عبد الله بن الزبير عن عبد الله البهي مولى مصعب بن الزبير عن يزيد بن أبي زياد القرشي عن علي بن عابس الملائي عن أصبغ بن الفرج مولى عمر بن عبد العزيز عن يحيى بن عثمان بن صالح عن الطبراني","عبد الله البهي مولى الزبير عن ابن الزبير"
"14911","14872  -  حَدَّثَنَا  الْحَسَنُ بْنُ الْعَبَّاسِ الرَّازِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ         [14/242]      حُمَيْدٍ ، قَالَ :  دَثَنَا  هَارُونُ بْنُ الْمُغِيرَةِ ،  عَنْ  عَمْرِو بْنِ أَبِي قَيْسٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنِ  الْبَهِيِّ ،  عَنِ  ابْنِ الزُّبَيْرِ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَعَنَ فُلَانًا وَوَلَدَهُ عَلَى هَذَا الْمِنْبَرِ  .","","Al-Mu'jam al-Kabir 14872","","عبد الله بن الزبير عن عبد الله البهي مولى مصعب بن الزبير عن يزيد بن أبي زياد القرشي عن عمرو بن أبي قيس عن هارون بن المغيرة المروزي عن محمد بن حميد الرازي عن الجمال الحسن بن العباس عن الطبراني","عبد الله البهي مولى الزبير عن ابن الزبير"
"14912","عَبْدُ اللهِ بْنُ عَامِرِ بْنِ كُرَيْزٍ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14873  -  دَثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  دَثَنَا  إِبْرَاهِيمُ بْنُ حَمْزَةَ الزُّبَيْرِيُّ ، قَالَ :  دَثَنَا  عَبْدُ اللهِ بْنُ مُصْعَبِ بْنِ ثَابِتٍ الزُّبَيْرِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  حَنْظَلَةَ بْنِ قَيْسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرِ بْنِ كُرَيْزٍ ،  أُرَاهُ  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قُتِلَ دُونَ مَالِهِ فَهُوَ  شَهِيدٌ  .","","Al-Mu'jam al-Kabir 14873","","عبد الله بن الزبير عن عبد الله بن عامر ابن عمة النبي صلى الله عليه وسلم عن حنظلة بن قيس بن عمرو الزرقي عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن عبد الله بن مصعب بن ثابت الزبيري عن إبراهيم بن حمزة الزبيري عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن عامر بن كريز عن عبد الله بن الزبير"
"14913","[14/243]      سَعِيدُ بْنُ جُبَيْرٍ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14874  -  دَثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ، قَالَ :  دَثَنَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ .  وَدَثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ طَرِيفٍ الْبَجَلِيُّ ، قَالَا :  دَثَنَا  زِيَادُ بْنُ الْحَسَنِ بْنِ فُرَاتٍ ، قَالَ :  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي : فُرَاتٍ  ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ :  كَتَبَ  عُتْبَةُ بْنُ فَرْقَدٍ  إِلَى عَبْدِ اللهِ بْنِ الزُّبَيْرِ يَسْتَفْتِيهِ فِي الْجَدِّ ، فَكَتَبَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : لَوْ كُنْتُ مُتَّخِذًا  خَلِيلًا  مِنْ أُمَّتِي دُونَ رَبِّي لَاتَّخَذْتُ  أَبَا بَكْرٍ  خَلِيلًا  ، وَلَكِنَّهُ أَخِي فِي الدِّينِ وَصَاحِبِي فِي الْغَارِ .  وَإِنَّ  أَبَا بَكْرٍ كَانَ يُنْزِلُهُ مَنْزِلَةَ الْوَالِدِ  .","","Al-Mu'jam al-Kabir 14874","","أبو  بكر الصديق عن عبد الله بن الزبير عن سعيد بن جبير الأسدي عن فرات بن أبي عبد الرحمن القزاز عن الحسن بن الفرات القزاز عن زياد بن الحسن القزاز عن يحيى بن سليمان بن يحيى عن روح بن الفرج القطان عن الطبراني","سعيد بن جبير عن عبد الله بن الزبير"
"14914","[14/244]      أَحْنَفُ أَبُو فُرَاتٍ  ، عَنِ  ابْنِ الزُّبَيْرِ  14875  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَأَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ ، قَالُوا :  دَثَنَا  أَبُو عُبَيْدَةَ بْنُ الْفُضَيْلِ بْنِ عِيَاضٍ ، قَالَ :  دَثَنَا  مَالِكُ بْنُ سُعَيْرِ بْنِ الْخِمْسِ ، قَالَ :  دَثَنَا  فُرَاتُ بْنُ أَحْنَفَ ، قَالَ :  دَثَنِي  أَبِي  ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ فِي  حَجَّةِ الْوَدَاعِ  :  أَيُّ بَلَدٍ أَحْرَمُ ؟ قِيلَ :  مَكَّةُ  ، قَالَ : فَأَيُّ شَهْرٍ أَحْرَمُ ؟ قِيلَ : ذُو الْحِجَّةِ . قَالَ : فَأَيُّ يَوْمٍ أَحْرَمُ ؟         [14/245]      قَالَ : يَوْمُ النَّحْرِ يَوْمُ  الْحَجِّ  الْأَكْبَرِ ،  فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : دِمَاؤُكُمْ وَأَمْوَالُكُمْ حَرَامٌ عَلَيْكُمْ إِلَى أَنْ تَلْقَوْا رَبَّكُمْ ،  كَحُرْمَةِ  يَوْمِكُمْ هَذَا ، فِي شَهْرِكُمْ هَذَا ، فِي بَلَدِكُمْ هَذَا  .","","Al-Mu'jam al-Kabir 14875","","عبد الله بن الزبير عن الأحنف أبو بحر الهلالي عن الفرات بن أحنف الهلالى عن مالك بن سعير التميمي عن أبو عبيدة بن الفضيل بن عياض عن أحمد بن يحيى بن خالد الرقي عن الطبراني","أحنف أبو فرات عن ابن الزبير"
"14915","ثُوَيْرُ بْنُ أَبِي فَاخِتَةَ  ، عَنِ  ابْنِ الزُّبَيْرِ  14876  -  دَثَنَا  الْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ ، قَالَ :  دَثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ، قَالَ :  دَثَنَا  إِسْرَائِيلُ ،  عَنْ  ثُوَيْرٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ ، يَقُولُ :  هَذَا يَوْمُ عَاشُورَاءَ فَصُومُوهُ ، فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ بِصِيَامِهِ  .","","Al-Mu'jam al-Kabir 14876","","عبد الله بن الزبير عن ثوير بن أبي فاختة مولى أم هانئ عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن الفضل بن الحباب الجمحي عن الطبراني","ثوير بن أبي فاختة عن ابن الزبير"
"14916","[14/246]      عَبْدُ اللهِ بْنُ شَرِيكٍ الْعَامِرِيُّ  ، عَنِ  ابْنِ الزُّبَيْرِ  14877  -  دَثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الْوَرْكَانِيُّ (  ح  ) .  وَدَثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ ، قَالَ :  دَثَنَا  عَلِيُّ بْنُ الْجَعْدِ ، قَالَا :  دَثَنَا  شَرِيكٌ ،  عَنْ  عَبْدِ اللهِ بْنِ شَرِيكٍ الْعَامِرِيِّ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ وَابْنَ عَبَّاسٍ وَابْنَ الزُّبَيْرِ عَنِ الْعُمْرَةِ قَبْلَ  الْحَجِّ  ؟  قَالُوا : سُنَّةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَقْدَمُ فَتَطُوفُ  بِالْبَيْتِ  وَبَيْنَ  الصَّفَا  وَالْمَرْوَةِ  ، ثُمَّ تَحِلُّ ، وَإِنْ كَانَ ذَلِكَ قَبْلَ عَرَفَةَ بِيَوْمٍ ، ثُمَّ تُهِلُّ بِالْحَجِّ ، فَيَكُونُ قَدْ جَمَعْتَ عُمْرَةً وَحَجَّةً  .","","Al-Mu'jam al-Kabir 14877","","عبد الله بن عمر بن الخطاب عن عبد الله بن شريك العامري عن شريك بن عبد الله النخعي عن محمد بن جعفر الوركاني عن عبد الله بن أحمد بن حنبل عن الطبراني","عبد الله بن شريك العامري عن ابن الزبير"
"14917","نُسَيْرُ بْنُ ذُعْلُوقٍ  ، عَنِ  ابْنِ الزُّبَيْرِ  14878  -  دَثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  نُسَيْرِ بْنِ ذُعْلُوقٍ ،  أَنَّ  ابْنَ الزُّبَيْرِ رَأَى النَّاسَ يَمْسَحُونَ الْمَقَامَ ، فَنَهَاهُمْ  ، وَقَالَ : إِنَّكُمْ لَمْ تُؤْمَرُوا بِالْمَسْحِ ، إِنَّمَا أُمِرْتُمْ بِالصَّلَاةِ  .","","Al-Mu'jam al-Kabir 14878","","عبد الله بن الزبير عن نسير بن ذعلوق الثوري عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","نسير بن ذعلوق عن ابن الزبير"
"14918","[14/247]      14879  -  دَثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ ، قَالَ :  دَثَنَا  عَلِيُّ بْنُ الْجَعْدِ ، قَالَ :  دَثَنَا  شَرِيكٌ ،  عَنْ  نُسَيْرِ بْنِ ذُعْلُوقٍ ، قَالَ :  رَأَيْتُ  ابْنَ الزُّبَيْرِ يَطُوفُ وَعَلَيْهِ بُرْطُلَةٌ  .","","Al-Mu'jam al-Kabir 14879","","عبد الله بن الزبير عن نسير بن ذعلوق الثوري عن شريك بن عبد الله النخعي عن علي بن الجعد عن ابن الرازي محمد بن جعفر البغدادى عن الطبراني","نسير بن ذعلوق عن ابن الزبير"
"14919","[14/248]      أَبُو عَوْنٍ مُحَمَّدُ بْنُ عُبَيْدِ اللهِ الثَّقَفِيُّ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14880  -  دَثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ، قَالَ :  دَثَنَا  سَهْلُ بْنُ عُثْمَانَ ، قَالَ :  دَثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  أَبِي سَعْدٍ الْبَقَّالِ ،  عَنْ  مُحَمَّدِ بْنِ عُبَيْدِ اللهِ ، قَالَ :  سَمِعْتُ  ابْنَ الزُّبَيْرِ يَقُولُ :  كَانَ النَّاسُ يَتَّكِلُ بَعْضُهُمْ عَلَى بَعْضٍ فِي الزَّادِ ، فَأَمَرَهُمُ اللهُ أَنْ يَتَزَوَّدُوا  ، فَقَالَ :         {      وَتَزَوَّدُوا فَإِنَّ خَيْرَ الزَّادِ التَّقْوَى         }      .","","Al-Mu'jam al-Kabir 14880","","عبد الله بن الزبير عن محمد بن عبيد الله بن سعيد الثقفي عن سعيد بن المرزبان عن يحيى بن زكريا بن أبي زائدة عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","أبو عون محمد بن عبيد الله الثقفي عن عبد الله بن الزبير"
"14920","زُرْعَةُ بْنُ عَبْدِ الرَّحْمَنِ  ، عَنِ  ابْنِ الزُّبَيْرِ  14881  -  دَثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ :  دَثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ، قَالَ :  دَثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ، قَالَ :  دَثَنَا  الْعَلَاءُ بْنُ صَالِحٍ ، قَالَ :  دَثَنَا  زُرْعَةُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ يَقُولُ :  صَفُّ الْقَدَمَيْنِ ، وَوَضْعُ الْيَدِ عَلَى الْيَدِ فِي الصَّلَاةِ : مِنَ السُّنَّةِ  .","","Al-Mu'jam al-Kabir 14881","","عبد الله بن الزبير عن زرعة بن عبد الرحمن الكوفي عن العلاء بن صالح التيمي عن محمد بن عبد الله بن الزبير عن عمرو بن محمد بن بكير عن عبد الله بن أحمد بن حنبل عن الطبراني","زرعة بن عبد الرحمن عن ابن الزبير"
"14921","[14/249]      عَامِرٌ الشَّعْبِيُّ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14882  -  دَثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ ، قَالَ :  دَثَنَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ، وَأَحْمَدُ بْنُ بَشِيرٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ وَهُوَ يَطُوفُ  بِالْكَعْبَةِ  ، وَهُوَ يَقُولُ :  وَرَبِّ هَذِهِ  الْبَنِيَّةِ  ! لَلَعَنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْحَكَمَ  وَمَا وَلَدَ!  .","","Al-Mu'jam al-Kabir 14882","","عبد الله بن الزبير عن الشعبي عن إسماعيل بن أبي خالد عن أحمد بن بشير المخزومى عن يحيى بن سليمان بن يحيى عن أحمد بن يحيى بن خالد الرقي عن الطبراني","عامر الشعبي عن عبد الله بن الزبير"
"14922","14883  -  دَثَنَا  جَعْفَرُ بْنُ أَحْمَدَ بْنِ سِنَانٍ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ الْمُحَارِبِيُّ ، قَالَ :  دَثَنَا  أَبُو مَالِكٍ الْجَنْبِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي         [14/250]      خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  أَنَّهُ قَالَ وَهُوَ عَلَى الْمِنْبَرِ : وَرَبِّ هَذَا الْبَيْتِ الْحَرَامِ وَالْبَلَدِ الْحَرَامِ!  إِنَّ  الْحَكَمَ بْنَ أَبِي الْعَاصِ  وَوَلَدَهُ مَلْعُونُونَ عَلَى لِسَانِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 14883","","عبد الله بن الزبير عن الشعبي عن إسماعيل بن أبي خالد عن عمرو بن هاشم الجنبي عن محمد بن عبيد بن محمد بن واقد النحاس عن جعفر بن أحمد بن سنان الواسطي عن الطبراني","عامر الشعبي عن عبد الله بن الزبير"
"14923","14884  -  دَثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ ، قَالَ :  دَثَنَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ ، قَالَ :  دَثَنَا  ابْنُ فُضَيْلٍ ،  عَنِ  ابْنِ شُبْرُمَةَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، قَالَ :  أَشْهَدُ لَسَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَلْعَنُ  الْحَكَمَ  وَمَا وَلَدَ  .","","Al-Mu'jam al-Kabir 14884","","عبد الله بن الزبير عن الشعبي عن عبد الله بن شبرمة عن محمد بن فضيل بن غزوان عن يحيى بن سليمان بن يحيى عن أحمد بن محمد بن الحجاج المصري عن الطبراني","عامر الشعبي عن عبد الله بن الزبير"
"14924","عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14885  -  دَثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ صَاعِقَةُ ، قَالَ :  دَثَنَا  يَحْيَى بْنُ حَمَّادٍ ، قَالَ :  دَثَنَا  أَبُو عَوَانَةَ ،         [14/251]      عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُسْتَشَارُ مُؤْتَمَنٌ  .","","Al-Mu'jam al-Kabir 14885","","عبد الله بن الزبير عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن يحيى بن حماد بن أبي زياد الشيباني عن محمد بن عبد الرحيم  صاعقة عن أحمد بن يحيى بن زهير التستري عن الطبراني","عبد الملك بن عمير عن عبد الله بن الزبير"
"14925","يَحْيَى بْنُ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ  ، عَنِ  ابْنِ الزُّبَيْرِ  14886  -  دَثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  دَثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ، قَالَ :  دَثَنَا  يَحْيَى بْنُ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، قَالَ :  لَمَّا نَزَلَتْ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         {      إِنَّكَ مَيِّتٌ وَإِنَّهُمْ مَيِّتُونَ             *          ثُمَّ إِنَّكُمْ يَوْمَ الْقِيَامَةِ عِنْدَ رَبِّكُمْ تَخْتَصِمُونَ         }      قَالَ  الزُّبَيْرُ  : أَيُكَرَّرُ عَلَيْنَا مَا كَانَ بَيْنَنَا فِي الدُّنْيَا ؟ قَالَ :  نَعَمْ ، لَيُكَرَّرُ عَلَيْكُمْ ذَلِكَ حَتَّى يُرَدَّ إِلَى كُلِّ ذِي حَقٍّ حَقُّهُ  . قَالَ  الزُّبَيْرُ  : وَاللهِ! إِنَّ الْأَمْرَ لَشَدِيدٌ . !","","Al-Mu'jam al-Kabir 14886","","عبد الله بن الزبير عن يحيى بن عبد الرحمن بن حاطب اللخمي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن محمد بن بشر بن الفرافصة عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","يحيى بن عبد الرحمن بن حاطب عن ابن الزبير"
"14926","[14/252]      14887  -  دَثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَ :  دَثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ، قَالَ :  دَثَنَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَلْقَمَةَ ،         [14/253]      عَنْ  يَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ،  عَنِ  ابْنِ الزُّبَيْرِ قَالَ :  لَمَّا نَزَلَتْ :         {      ثُمَّ لَتُسْأَلُنَّ يَوْمَئِذٍ عَنِ النَّعِيمِ         }      قَالَ  الزُّبَيْرُ بْنُ الْعَوَّامِ  :  يَا رَسُولَ اللهِ ، أَيُّ نَعِيمٍ نُسْأَلُ عَنْهُ ؟ وَإِنَّمَا هُمَا  الْأَسْوَدَانِ  : الْمَاءُ وَالتَّمْرُ ؟ قَالَ : أَمَا إِنَّ ذَلِكَ سَيَكُونُ .","","Al-Mu'jam al-Kabir 14887","","عبد الله بن الزبير عن يحيى بن عبد الرحمن بن حاطب اللخمي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن أبو مسلم الكجي عن الطبراني","يحيى بن عبد الرحمن بن حاطب عن ابن الزبير"
"14927","[14/254]      سُلَيْمَانُ بْنُ عَتِيقٍ  ، عَنِ  ابْنِ الزُّبَيْرِ  14888  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ الدِّيبَاجِيُّ التُّسْتَرِيُّ ، قَالَ :  دَثَنَا  سَهْلُ بْنُ عُبَيْدٍ التُّسْتَرِيُّ ، قَالَ :  دَثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  سُلَيْمَانَ بْنِ عَتِيقٍ ،  سَمِعَ  ابْنَ الزُّبَيْرِ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  صَلَاةٌ فِي  الْمَسْجِدِ الْحَرَامِ  أَفْضَلُ مِنْ أَلْفِ صَلَاةٍ فِيمَا سِوَاهُ مِنَ الْمَسَاجِدِ  .","","Al-Mu'jam al-Kabir 14888","","عبد الله بن الزبير عن سليمان بن عتيق المحاربي عن زياد بن سعد الخراساني عن سفيان بن عيينة عن سهل بن عبيد التستري عن محمد بن عبد الرحمن الديباجي عن الطبراني","سليمان بن عتيق عن ابن الزبير"
"14928","[14/255]      سُلَيْمَانُ بْنُ زِيَادٍ  ، عَنِ  ابْنِ الزُّبَيْرِ  14889  -  دَثَنَا  أَبُو جَعْفَرٍ مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَكْرٍ السَّرَّاجُ الْعَسْكَرِيُّ ، قَالَ :  دَثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ، قَالَ :  دَثَنَا  الْمُفَضَّلُ بْنُ فَضَالَةَ ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  سُلَيْمَانَ بْنِ زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، قَالَ :  أَكَلْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا شِوَاءً وَنَحْنُ فِي الْمَسْجِدِ  ، فَأُقِيمَتِ الصَّلَاةُ ، فَلَمْ نَزِدْ أَنْ مَسَحْنَا بِالْحَصَى  .","","Al-Mu'jam al-Kabir 14889","","عبد الله بن الزبير عن سليمان بن زياد الصوراني عن عبد الله بن لهيعة عن المفضل بن فضالة عن عبد الأعلى بن حماد النرسي عن محمد بن عبد الله بن بكر السراج عن الطبراني","سليمان بن زياد عن ابن الزبير"
"14929","[14/256]      عَبْدُ اللهِ بْنُ دِينَارٍ  ، عَنِ  ابْنِ الزُّبَيْرِ  14890  -  دَثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ، قَالَ :  دَثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الْخَرَّازُ الرَّازِيُّ ، قَالَ :  دَثَنَا  مُسْلِمُ بْنُ خَالِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ الزُّبَيْرِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَيْسَ مِنَّا مَنْ  حَمَلَ  عَلَيْنَا السِّلَاحَ  .","","Al-Mu'jam al-Kabir 14890","","عبد الله بن الزبير عن عبد الله بن دينار العدوي عن مسلم بن خالد الزنجي عن عبد الله بن جعفر الخراز الرازي عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","عبد الله بن دينار عن ابن الزبير"
"14930","أَبُو الزُّبَيْرِ مُحَمَّدُ بْنُ مُسْلِمٍ الْمَكِّيُّ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14891  -  دَثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ الْأَصْبَهَانِيُّ ، قَالَ :  دَثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ، قَالَ :  دَثَنَا  ابْنُ عُلَيَّةَ ،  عَنْ  حَجَّاجٍ الصَّوَّافِ ،  عَنْ  أَبِي الزُّبَيْرِ ، قَالَ :  سَمِعْتُ  ابْنَ الزُّبَيْرِ ، يَقُولُ :  كَانَ         [14/257]      رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دُبُرَ الصَّلَاةِ يَقُولُ : لَا إِلَهَ إِلَّا اللهُ  ، لَا نَعْبُدُ إِلَّا إِيَّاهُ ، أَهْلُ النِّعْمَةِ وَالْفَضْلِ ، وَالثَّنَاءِ الْحَسَنِ ، لَا إِلَهَ إِلَّا اللهُ ، مُخْلِصِينَ لَهُ الدِّينَ وَلَوْ كَرِهَ الْكَافِرُونَ  .","","Al-Mu'jam al-Kabir 14891","","عبد الله بن الزبير عن أبو الزبير المكي عن حجاج بن أبى عثمان الصواف الكندي عن إسماعيل ابن علية عن يعقوب بن إبراهيم بن كثير عن محمد بن العباس ابن الأخرم عن الطبراني","أبو الزبير محمد بن مسلم المكي عن عبد الله بن الزبير"
"14931","14892  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْقَلَانِسِيُّ الرَّمْلِيُّ ، وَأَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو ، قَالَا :  دَثَنَا  آدَمُ ، قَالَ :  دَثَنَا  حَفْصُ بْنُ مَيْسَرَةَ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ عِنْدَ انْقِضَاءِ صَلَاتِهِ قَبْلَ أَنْ يَقُومَ : لَا إِلَهَ إِلَّا اللهُ  وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ ، لَا نَعْبُدُ إِلَّا إِيَّاهُ ، لَهُ النِّعْمَةُ وَلَهُ الْفَضْلُ ، وَلَهُ الثَّنَاءُ الْحَسَنُ ، لَا إِلَهَ إِلَّا اللهُ مُخْلِصِينَ لَهُ الدِّينَ .","","Al-Mu'jam al-Kabir 14892","","عبد الله بن الزبير عن أبو الزبير المكي عن موسى بن عقبة عن حفص بن ميسرة العقيلي عن آدم بن أبي إياس عن أبو زرعة الدمشقي عن الطبراني","أبو الزبير محمد بن مسلم المكي عن عبد الله بن الزبير"
"14932","[14/258]      14893  -  دَثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ، قَالَ :  دَثَنَا  سَهْلُ بْنُ عُثْمَانَ ، قَالَ :  دَثَنَا  جُنَادَةُ بْنُ سَلْمٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنْ  مُحَمَّدِ بْنِ مُسْلِمٍ أَبِي الزُّبَيْرِ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ ، يَقُولُ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ فِي دُبُرِ الصَّلَاةِ إِذَا سَلَّمَ قَبْلَ أَنْ يَقُومَ  ؛ يَرْفَعُ بِذَلِكَ صَوْتَهُ : لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ ، لَا نَعْبُدُ إِلَّا إِيَّاهُ ، لَهُ النِّعْمَةُ ، وَلَهُ الْفَضْلُ ، وَلَهُ الثَّنَاءُ الْحَسَنُ ، لَا إِلَهَ إِلَّا اللهُ ، مُخْلِصِينَ لَهُ الدِّينَ وَلَوْ كَرِهَ الْكَافِرُونَ  .","","Al-Mu'jam al-Kabir 14893","","عبد الله بن الزبير عن أبو الزبير المكي عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن جنادة بن سلم العامري عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","أبو الزبير محمد بن مسلم المكي عن عبد الله بن الزبير"
"14933","14894  -  دَثَنَا  عُمَرُ بْنُ الْعَزِيزِ بْنِ مِقْلَاصٍ ، قَالَ :  دَثَنَا  أَبِي  ، قَالَ :  دَثَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنَا  يَحْيَى بْنُ عَبْدِ اللهِ بْنِ سَالِمٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ....  مِثْلَ حَدِيثِ  حَفْصِ بْنِ مَيْسَرَةَ  عَنْ  مُوسَى بْنِ عُقْبَةَ  .","","Al-Mu'jam al-Kabir 14894","","عبد الله بن الزبير عن أبو الزبير المكي عن موسى بن عقبة عن يحيى بن عبد الله بن سالم بن عبد الله بن عمر عن عبد الله بن وهب المصري عن عبد العزيز بن عمران المصري عن عمر بن عبد العزيز الخزاعي عن الطبراني","أبو الزبير محمد بن مسلم المكي عن عبد الله بن الزبير"
"14934","14895  -  دَثَنَا  الْحَسَنُ بْنُ الْعَبَّاسِ الرَّازِيُّ ، قَالَ :  دَثَنَا  سَهْلُ بْنُ عُثْمَانَ ، قَالَ :  دَثَنَا  جُنَادَةُ بْنُ سَلْمٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ...  مِثْلَ حَدِيثِ         [14/259]      عَبْدِ الرَّحْمَنِ بْنِ سَلْمٍ  ، وَلَمْ يُذْكَرْ  نَافِعٌ  ، وَهُوَ الصَّوَابُ  .","","Al-Mu'jam al-Kabir 14895","","عبد الله بن الزبير عن أبو الزبير المكي عن عبيد الله بن عمر العمري عن جنادة بن سلم العامري عن سهل بن عثمان العسكري عن الجمال الحسن بن العباس عن الطبراني","أبو الزبير محمد بن مسلم المكي عن عبد الله بن الزبير"
"14935","أَبُو ذُبْيَانَ خَلِيفَةُ بْنُ كَعْبٍ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14896  -  دَثَنَا  أَحْمَدُ بْنُ سَهْلٍ الْأَهْوَازِيُّ ، قَالَ :  دَثَنَا  عَلِيُّ بْنُ بَحْرٍ ، قَالَ :  دَثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  جَعْفَرِ بْنِ مَيْمُونٍ الْبَصْرِيِّ ، قَالَ :  حَدَّثَنِي  خَلِيفَةُ بْنُ كَعْبٍ ، قَالَ :  خَطَبَنَا عَبْدُ اللهِ بْنُ الزُّبَيْرِ ،  فَقَالَ  : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَبِسَ الْحَرِيرَ فِي الدُّنْيَا لَمْ يَلْبَسْهُ فِي الْآخِرَةِ  .","","Al-Mu'jam al-Kabir 14896","","عبد الله بن الزبير عن خليفة بن كعب البستي عن جعفر بن ميمون الأنماطي عن عيسى بن يونس بن أبي إسحاق عن علي بن بحر بن بري القطان عن أحمد بن سهل بن أيوب الأهوازي عن الطبراني","أبو ذبيان خليفة بن كعب عن عبد الله بن الزبير"
"14936","[14/260]      ثَابِتٌ الْبُنَانِيُّ  ، عَنِ  ابْنِ الزُّبَيْرِ  14897  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  دَثَنَا  فِطْرُ بْنُ حَمَّادِ بْنِ وَاقِدٍ الصَّفَّارُ ، قَالَ :  دَثَنَا  أَبِي  ،  عَنْ  ثَابِتٍ ، قَالَ : خَطَبَنَا عَبْدُ اللهِ بْنُ الزُّبَيْرِ ،  فَقَالَ  : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  مَنْ لَبِسَ الْحَرِيرَ فِي الدُّنْيَا لَمْ يَلْبَسْهُ فِي الْآخِرَةِ  .","","Al-Mu'jam al-Kabir 14897","","عبد الله بن الزبير عن ثابت البناني عن حماد بن واقد العيشي عن فطر بن حماد عن الحسين بن إسحاق التستري عن الطبراني","ثابت البناني عن ابن الزبير"
"14937","عَبْدُ الْعَزِيزِ بْنُ أَسِيدٍ  ، عَنِ  ابْنِ الزُّبَيْرِ  14898  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ، قَالَ :  دَثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَ :  دَثَنَا  ابْنُ عُلَيَّةَ ،  عَنْ  سَعِيدِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ أَسِيدٍ ، قَالَ :  قَالَ  رَجُلٌ  لِابْنِ الزُّبَيْرِ : أَفْتِنَا فِي نَبِيذِ  الْجَرِّ  ،  فَقَالَ  :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَنْهَى عَنْ نَبِيذِ  الْجَرِّ  .","","Al-Mu'jam al-Kabir 14898","","عبد الله بن الزبير عن عبد العزيز بن أسيد الطاحي عن سعيد بن يزيد الطاحي عن إسماعيل ابن علية عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد العزيز بن أسيد عن ابن الزبير"
"14938","[14/261]      أَبُو عَامِرٍ سَلِيمُ بْنُ عَامِرٍ  ، عَنِ  ابْنِ الزُّبَيْرِ  14899  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  دَثَنَا  عَلِيُّ بْنُ بَحْرٍ ، قَالَ :  دَثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  دَثَنَا  ثَابِتُ بْنُ عَجْلَانَ ،  عَنْ  سُلَيْمِ بْنِ عَامِرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ صَلَاةٍ مَفْرُوضَةٍ إِلَّا وَبَيْنَ يَدَيْهَا رَكْعَتَيْنِ  .","","Al-Mu'jam al-Kabir 14899","","عبد الله بن الزبير عن سليم بن عامر الخبائري عن ثابت بن عجلان السلمي عن سويد بن عبد العزيز السلمي عن علي بن بحر بن بري القطان عن الحسين بن إسحاق التستري عن الطبراني","أبو عامر سليم بن عامر عن ابن الزبير"
"14939","[14/262]      14900  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ، قَالَ :  حَدَّثَنَا  عَلِيُّ بْنُ بَحْرٍ ، قَالَ :  دَثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  ثَابِتِ بْنِ عَجْلَانَ ،  عَنْ  سُلَيْمِ بْنِ عَامِرٍ ، قَالَ :  سَمِعْتُ  ابْنَ الزُّبَيْرِ ، يَقْرَأُ هَذِهِ الْآيَةَ :         {      قَالُوا  سَاحِرَانِ  تَظَاهَرَا         }      .","","Al-Mu'jam al-Kabir 14900","","عبد الله بن الزبير عن سليم بن عامر الخبائري عن ثابت بن عجلان السلمي عن سويد بن عبد العزيز السلمي عن علي بن بحر بن بري القطان عن الحسين بن إسحاق التستري عن الطبراني","أبو عامر سليم بن عامر عن ابن الزبير"
"14940","سُهَيْلُ بْنُ ذَكْوَانَ  ، عَنِ  ابْنِ الزُّبَيْرِ  14901  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدِ بْنِ عُقْبَةَ الشَّيْبَانِيُّ ، قَالَ :  دَثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ، قَالَ :  دَثَنَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ :  دَثَنَا  سُهَيْلُ بْنُ ذَكْوَانَ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ ، يَخْطُبُ ، فَقَالَ :  إِنَّ  ابْنَ عَبَّاسٍ  يُحِلُّ  الْمُتْعَةَ  وَهِيَ حَرَامٌ مِنَ اللهِ وَرَسُولِهِ  .","","Al-Mu'jam al-Kabir 14901","","عبد الله بن الزبير عن سهيل بن أبي صالح السمان عن يزيد بن هارون عن الحسن بن علي الريحاني عن محمد بن محمد بن عقبة الشيباني عن الطبراني","سهيل بن ذكران عن ابن الزبير"
"14941","[14/263]      وَهْبُ بْنُ كَيْسَانَ  ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14902  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ، قَالَ :  دَثَنَا  مُصَرِّفُ بْنُ عَمْرٍو الْيَامِيُّ ، قَالَ :  دَثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  وَهْبِ بْنِ كَيْسَانَ ، قَالَ :  صَلَّى بِنَا عَبْدُ اللهِ بْنُ الزُّبَيْرِ يَوْمَ عِيدٍ ، ثُمَّ خَطَبَ بَعْدَ الصَّلَاةِ  ، ثُمَّ  قَالَ  : كُلُّ سُنَّةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ غَيَّرَ  فُلَانٌ  ، حَتَّى الصَّلَاةَ  .","","Al-Mu'jam al-Kabir 14902","","عبد الله بن الزبير عن وهب بن كيسان القرشي عن محمد بن إسحاق عن يونس بن بكير عن مصرف بن عمرو بن السري الهمداني عن علي بن سعيد بن بشير عليك عن الطبراني","وهب بن كيسان عن عبد الله بن الزبير"
"14942","14903  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نَاجِيَةَ ، قَالَ :  دَثَنَا  يُوسُفُ بْنُ مُوسَى الْقَطَّانُ ، قَالَ :  دَثَنَا  سَلَمَةُ بْنُ الْفَضْلِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  وَهْبِ بْنِ كَيْسَانَ ، قَالَ :  كَتَبَ  عَبْدُ اللهِ بْنُ عُتْبَةَ  إِلَى ابْنِ الزُّبَيْرِ - وَكَانَ اسْتَعْمَلَهُ عَلَى  الْعِرَاقِ  - يَسْأَلُهُ عَنِ الْجَدِّ  ، فَكَتَبَ إِلَيْهِ : إِنَّ الَّذِي قَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لَوْ مُتَّخِذًا  خَلِيلًا  لَاتَّخَذْتُهُ  خَلِيلًا  - جَعَلَ الْجَدَّ أَبًا  يَحُوزُ  إِلَيْهِ الْمَالَ  .","","Al-Mu'jam al-Kabir 14903","","أبو  بكر الصديق عن عبد الله بن الزبير عن وهب بن كيسان القرشي عن محمد بن إسحاق عن سلمة بن الفضل الأبرش عن يوسف بن موسى بن راشد عن عبد الله بن محمد بن ناجية البربري عن الطبراني","وهب بن كيسان عن عبد الله بن الزبير"
"14943","[14/264]      سُبَيْعٌ السَّلُولِيُّ  ، عَنِ  ابْنِ الزُّبَيْرِ  14904  -  دَثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ، وَالْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ، قَالَا :  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْخَطَّابِ ، قَالَ :  دَثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سُبَيْعٍ السَّلُولِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ ثَلَاثِينَ كَذَّابًا  ، مِنْهُمُ  الْأَسْوَدُ الْعَنْسِيُّ  صَاحِبُ  صَنْعَاءَ  ، وَصَاحِبُ  الْيَمَامَةِ  .","","Al-Mu'jam al-Kabir 14904","","عبد الله بن الزبير عن سبيع السلولي عن أبو إسحاق السبيعي عن قيس بن الربيع الأسدي عن عبد العزيز بن الخطاب الكوفي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","سبيع السلولي عن ابن الزبير"
"14944","14905  -  دَثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ، قَالَ :  دَثَنَا  سَهْلُ بْنُ عُثْمَانَ ، قَالَ :  دَثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ، قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سُبَيْعٍ السَّلُولِيِّ ،  عَنِ  ابْنِ الزُّبَيْرِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ... مِثْلَهُ .","","Al-Mu'jam al-Kabir 14905","","عبد الله بن الزبير عن سبيع السلولي عن أبو إسحاق السبيعي عن زكريا بن أبي زائدة الوادعي عن يحيى بن زكريا بن أبي زائدة عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","سبيع السلولي عن ابن الزبير"
"14945","[14/265]      أَبُو الْوَرْدِ  ، عَنِ  ابْنِ الزُّبَيْرِ  14906  -  دَثَنَا  بَكْرُ بْنُ سَهْلٍ ، قَالَ :  دَثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ، قَالَ :  دَثَنَا  ابْنُ لَهِيعَةَ ، قَالَ :  سَمِعْتُ  أَبَا الْوَرْدِ يَقُولُ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ يَقُولُ :  تَشَهَّدَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : بِاسْمِ اللهِ وَبِاللهِ خَيْرِ الْأَسْمَاءِ  ،  التَّحِيَّاتُ  لِلهِ ، الطَّيِّبَاتُ الصَّلَوَاتُ ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ ، وَأَشْهَدُ أَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ ، أَرْسَلَهُ بِالْحَقِّ بَشِيرًا وَنَذِيرًا ، وَأَنَّ السَّاعَةَ آتِيَةٌ لَا رَيْبَ فِيهَا ، السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ ، السَّلَامُ عَلَيْنَا وَعَلَى عِبَادِ اللهِ الصَّالِحِينَ ، اللَّهُمَّ اغْفِرْ لِي وَاهْدِنِي . هَذَا فِي الرَّكْعَتَيْنِ الْأُولَيَيْنِ  .","","Al-Mu'jam al-Kabir 14906","","عبد الله بن الزبير عن أبو الورد عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","أبو الورد عن ابن الزبير"
"14946","[14/266]      مُحَمَّدُ بْنُ أَبِي يَحْيَى الْأَسْلَمِيُّ  ، عَنِ  ابْنِ الزُّبَيْرِ  14907  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْحَسَنِ الْعَطَّارُ ، قَالَ :  دَثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ، قَالَ :  دَثَنَا  الْفُضَيْلُ بْنُ سُلَيْمَانَ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ أَبِي يَحْيَى ، قَالَ :  رَأَيْتُ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ وَرَأَى  رَجُلًا  رَافِعًا يَدَيْهِ يَدْعُو قَبْلَ أَنْ يَفْرُغَ مِنْ صَلَاتِهِ ، فَلَمَّا فَرَغَ مِنْهَا ، قَالَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يَكُنْ يَرْفَعُ يَدَيْهِ حَتَّى يَفْرُغَ مِنْ صَلَاتِهِ  .","","Al-Mu'jam al-Kabir 14907","","عبد الله بن الزبير عن محمد بن أبي يحيى الأسلمي عن فضيل بن سليمان النميري عن فضيل بن حسين الجحدري عن سليمان بن الحسن العطار عن الطبراني","محمد بن أبي يحيى الأسلمي عن ابن الزبير"
"14947","رِجَالٌ غَيْرُ مُسَمَّيْنَ ، عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  14908  -  دَثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ، قَالَ :  دَثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَ :  دَثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  سُلَيْمَانَ بْنِ قَرْمٍ ،  عَنْ  أَبِي حَبِيبٍ ،         [14/267]      عَنْ  رَجُلٍ مِنْ أَهْلِ الْحِجَازِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  :  لَوْلَا أَنْ  أَشُقَّ  عَلَى أُمَّتِي لَأَمَرْتُهُمْ بِالسِّوَاكِ عِنْدَ كُلِّ صَلَاةٍ  .","","Al-Mu'jam al-Kabir 14908","","عبد الله بن الزبير عن رجل من أهل الحجاز عن سنان بن حبيب السلمي عن سليمان بن قرم الضبي عن معاوية بن هشام القصار عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","رجال غير مسمين عن عبد الله بن الزبير"
"14948","14909  -  دَثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ، قَالَ :  دَثَنَا  خَالِدُ بْنُ يُوسُفَ السَّمْتِيُّ ، قَالَ :  دَثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِنَانٍ أَبِي حَبِيبٍ ،  عَنْ  رَجُلٍ حَدَّثَهُ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْلَا أَنْ  أَشُقَّ  عَلَى أُمَّتِي لَأَمَرْتُهُمْ بِالسِّوَاكِ عِنْدَ كُلِّ صَلَاةٍ  .         [14/268]","","Al-Mu'jam al-Kabir 14909","","عبد الله بن الزبير عن رجل عن سنان بن حبيب السلمي عن الوضاح بن عبد الله اليشكري عن خالد بن يوسف بن خالد السمتي عن الساجي عن الطبراني","رجال غير مسمين عن عبد الله بن الزبير"
"14949","[14/269]      مَا  أَسْنَدَ  عَبْدُ اللهِ بْنُ أَبِي بَكْرٍ الصِّدِّيقِ  رَضِيَ اللهُ عَنْهُمَا  14910  -  دَثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  دَثَنَا  عُثْمَانُ بْنُ الْهَيْثَمِ الْمُؤَذِّنُ ، قَالَ :  دَثَنَا  الْهَيْثَمُ بْنُ الْأَشْعَثِ ،  عَنِ  الْهَيْثَمِ أَبِي مُحَمَّدٍ السُّلَمِيِّ ،  عَنْ  مُحَمَّدِ بْنِ عَمَّارٍ الْأَنْصَارِيِّ ،  عَنِ  [ الْجَهْمِ بْنِ عُثْمَانَ بْنِ أَبِي جَهْمَةَ ،  عَنْ  مُحَمَّدِ بْنِ] عَبْدِ اللهِ بْنِ عَمْرِو بْنِ عُثْمَانَ بْنِ عَفَّانَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ الصِّدِّيقِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا بَلَغَ الْمَرْءُ الْمُسْلِمُ خَمْسِينَ سَنَةً صَرَفَ اللهُ عَنْهُ ثَلَاثَةَ أَنْوَاعٍ مِنَ الْبَلَاءِ  : الْجُنُونَ ، وَالْجُذَامَ ، وَالْبَرَصَ ، فَإِذَا بَلَغَ سِتِّينَ سَنَةً رَزَقَهُ اللهُ الْإِنَابَةَ إِلَيْهِ ، فَإِذَا بَلَغَ سَبْعِينَ سَنَةً مُحِيَتْ سَيِّئَاتُهُ وَكُتِبَتْ حَسَنَاتُهُ ، فَإِذَا بَلَغَ تِسْعِينَ سَنَةً غَفَرَ اللهُ لَهُ ذَنْبَهُ مَا تَقَدَّمَ مِنْهُ وَمَا تَأَخَّرَ ، وَكَانَ أَسِيرَ اللهِ فِي الْأَرْضِ ، وَشَفَعَ لَأَهْلِ بَيْتِهِ  .         [14/270]","","Al-Mu'jam al-Kabir 14910","","عبد الله بن أبي بكر الصديق عن الديباج ، محمد بن عبد الله بن عمرو عن الجهم بن عثمان بن أبي جهمة عن كشاكش ، محمد بن عمار بن حفص عن الهيثم أبي محمد السلمي عن الهيثم بن الأشعث عن عثمان بن الهيثم بن جهم الأشج عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ما أسند عبد الله بن أبي بكر الصديق رضي الله عنهما"
"14950","[14/271]      عَبْدُ اللهِ بْنُ أَبِي أُمَيَّةَ بْنِ الْمُغِيرَةِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ بْنِ مَخْزُومٍ  أَخُو أُمِّ سَلَمَةَ لِأَبِيهَا ، أُمُّهُ  عَاتِكَةُ بِنْتُ عَبْدِ الْمُطَّلِبِ عَمَّةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، أَسْلَمَ يَوْمَ الْفَتْحِ ، لَقِيَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الطَّرِيقِ ، فَأَسْلَمَ ، وَاسْتُشْهِدَ يَوْمَ الطَّائِفِ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  14911  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ، قَالَ :  دَثَنَا  أَسَدُ بْنُ مُوسَى .         [14/272]      وَدَثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  دَثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ الْهَاشِمِيُّ ، قَالَا :  دَثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ، قَالَ :  أَخْبَرَنِي  عَبْدُ اللهِ بْنُ أَبِي أُمَيَّةَ :  أَنَّهُ رَأَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي فِي بَيْتِ  أُمِّ سَلَمَةَ  فِي ثَوْبٍ وَاحِدٍ  ، مُلْتَحِفًا بِهِ ، مُخَالِفًا بَيْنَ طَرَفَيْهِ  .","","Al-Mu'jam al-Kabir 14911","","عبد الله بن أبي أمية المخزومي صهر رسول الله عن عروة بن الزبير عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سليمان بن داود القرشي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن أبي أمية بن المغيرة بن عبد الله بن عمر بن مخزوم"
"14951","14912  -  دَثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، قَالَ :  دَثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ، قَالَ :  دَثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ، قَالَ :  دَثَنَا  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي أُمَيَّةَ الْمَخْزُومِيِّ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي بَيْتِ  أُمِّ سَلَمَةَ  يُصَلِّي فِي ثَوْبٍ وَاحِدٍ  ، مُخَالِفًا بَيْنَ طَرَفَيْهِ .","","Al-Mu'jam al-Kabir 14912","","عبد الله بن أبي أمية المخزومي صهر رسول الله عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","عبد الله بن أبي أمية بن المغيرة بن عبد الله بن عمر بن مخزوم"
"14952","[14/273]      مَا  أَسْنَدَ  عَبْدُ اللهِ بْنُ حَارِثَةَ بْنِ النُّعْمَانِ الْأَنْصَارِيُّ  14913  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ ، قَالَ :  دَثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ .         [14/274]      وَحَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ الْمَكِّيُّ ، قَالَ :  دَثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ طَلْحَةَ التَّيْمِيُّ ، قَالَ :  حَدَّثَنِي  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ حَارِثَةَ بْنِ النُّعْمَانِ الْأَنْصَارِيُّ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ حَارِثَةَ  ، قَالَ :  لَمَّا أَنْ قَدِمَ  صَفْوَانُ بْنُ أُمَيَّةَ بْنِ خَلَفٍ الْجُمَحِيُّ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  عَلَى مَنْ نَزَلْتَ يَا  أَبَا وَهْبٍ  ؟  قَالَ : نَزَلْتُ عَلَى  الْعَبَّاسِ  ، قَالَ : نَزَلْتَ عَلَى أَشَدِّ  قُرَيْشٍ  لِقُرَيْشٍ  حُبًّا .","","Al-Mu'jam al-Kabir 14913","","عبد الله بن حارثة بن النعمان الأنصاري عن أبو إسحاق بن إبراهيم بن طلحة الأنصاري عن إسحاق بن إبراهيم بن طلحة الأنصاري عن محمد بن طلحة بن عبد الرحمن عن إسماعيل بن أبي أويس عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","ما أسند عبد الله بن حارثة بن النعمان الأنصاري"
"14953","[14/275]      عَبْدُ اللهِ بْنُ أُنَيْسٍ الْأَنْصَارِيُّ  وَهُوَ الَّذِي بَعَثَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  سُفْيَانَ الْهُذَلِيِّ  ، فَقَتَلَهُ .  مَا  أَسْنَدَ  عَبْدُ اللهِ بْنُ أُنَيْسٍ الْأَنْصَارِيُّ  جَابِرُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ  ، عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ  14914  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  دَثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ .         [14/276]      وَدَثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَ :  دَثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ الْغُدَانِيُّ ، وَحَجَّاجُ بْنُ الْمِنْهَالِ .         [14/277]      وَدَثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ :  دَثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ، قَالُوا :  دَثَنَا  هَمَّامٌ ، قَالَ :  دَثَنَا  الْقَاسِمُ بْنُ عَبْدِ الْوَاحِدِ ، قَالَ :  دَثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَقِيلٍ ،  أَنَّ جَابِرَ بْنَ عَبْدِ اللهِ  حَدَّثَهُ  ، قَالَ : بَلَغَنِي عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَدِيثًا سَمِعَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَلَمْ أَسْمَعْهُ مِنْهُ ، فَخَشِيتُ أَنْ يَمُوتَ أَوْ أَمُوتَ قَبْلَ أَنْ أَسْمَعَهُ ، فَابْتَعْتُ بَعِيرًا ، فَشَدَدْتُ عَلَيْهِ رَحْلِي ، ثُمَّ سِرْتُ عَلَيْهِ شَهْرًا ، حَتَّى قَدِمْتُ  الشَّامَ  ، فَأَتَيْتُ عَبْدَ اللهِ بْنَ أُنَيْسٍ الْأَنْصَارِيَّ ، فَقُمْتُ فَاسْتَأْذَنْتُ عَلَيْهِ ، فَقُلْتُ :  جَابِرُ بْنُ عَبْدِ اللهِ  ، فَخَرَجَ عَلَيَّ فَعَانَقَنِي وَعَانَقْتُهُ . قَالَ : قُلْتُ : حَدِيثًا بَلَغَنِي أَنَّكَ         [14/278]      سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْمَظَالِمِ ، خَشِيتُ أَنْ تَمُوتَ أَوْ أَمُوتَ قَبْلَ أَنْ أَسْمَعَهُ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَحْشُرُ اللهُ الْعِبَادَ - وَأَوْمَأَ بِيَدِهِ قِبَلَ  الشَّامِ  - عُرَاةً حُفَاةً  غُرْلًا  بُهْمًا  - قَالَ : قُلْتُ : مَا  بُهْمًا  ؟ قَالَ : لَيْسَ مَعَهُمْ شَيْءٌ - فَيُنَادِي مُنَادِي بِصَوْتٍ يَسْمَعُهُ مَنْ بَعُدَ كَمَا يَسْمَعُهُ مَنْ قَرُبَ : أَنَا الْمَلِكُ  الدَّيَّانُ  ، لَا يَنْبَغِي لِأَحَدٍ مِنْ أَهْلِ الْجَنَّةِ يَدْخُلُ الْجَنَّةَ ، وَأَحَدٌ مِنْ أَهْلِ النَّارِ يَطْلُبُهُ بِمَظْلَمَةٍ ، وَلَا يَنْبَغِي لِأَحَدٍ مِنْ أَهْلِ النَّارِ يَدْخُلُ النَّارَ وَأَحَدٌ مِنْ أَهْلِ الْجَنَّةِ يَطْلُبُهُ بِمَظْلَمَةٍ ، حَتَّى اللَّطْمَةُ . قَالَ : قُلْتُ : وَكَيْفَ ، وَإِنَّمَا نَأْتِي عُرَاةً  غُرْلًا  بُهْمًا  ؟ قَالَ : الْحَسَنَاتُ وَالسَّيِّئَاتُ  .","","Al-Mu'jam al-Kabir 14914","","عبد الله بن أنيس القضاعي عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن القاسم بن عبد الواحد بن أيمن المخزومي عن همام بن يحيى بن دينار عن شيبان بن فروخ الحبطي عن عبد الله بن أحمد بن حنبل عن الطبراني","جابر بن عبد الله الأنصاري عن عبد الله بن أنيس"
"14954","[14/279]      14915  -  دَثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ الْجَرْجَرَائِيُّ ، قَالَ :  دَثَنَا  عَلِيُّ بْنُ ثَابِتٍ الْجَزَرِيُّ ،  عَنِ  الْوَازِعِ بْنِ نَافِعٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ  لِسُفْيَانَ الْهُذَلِيِّ  ؟ يَهْجُونِي وَيَشْتِمُنِي وَيُؤْذِينِي ؟ !  فَقُلْتُ لَهُ : أَنَا يَا رَسُولَ اللهِ ، ابْعَثْنِي لَهُ . فَبَعَثَهُ لَهُ ، فَلَمَّا أَتَاهُ لَيْلًا دَخَلَ دَارَهُ ، فَنَادَى : أَيْنَ  سُفْيَانُ  ؟ فَاطَّلَعَ عَلَيْهِ مُطَّلِعًا مِنْ أَهْلِهِ ، فَقَالَ : مَا تُرِيدُ ؟ قَالَ : أُرِيدُ  سُفْيَانَ  ، فَمُرُوهُ فَلْيَطَّلِعْ عَلَيَّ ، فَاطَّلَعَ إِلَيْهِ  سُفْيَانُ  ، فَقَالَ : مَا تُرِيدُ ؟ قَالَ : أُرِيدُ أَنْ تَهْبِطَ إِلَيَّ ، فَإِنَّ عِنْدِي دِرْعً أُرِيدُ أَنْ أُرِيكَهَا ، قَالَ : فَأَيْنَ هِيَ ؟ قَالَ : هَا هَذِهِ ، فَاهْبِطْ إِلَيَّ         [14/280]      بِقُبَائِكَ ، فَاخْرُجْ مَعِي أُرِيكَهَا ، فَخَرَجَ مَعَهُ ، فَسَلَّ سَيْفَهُ فَضَرَبَهُ حَتَّى  بَرَدَ  ، ثُمَّ أَقْبَلَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ فِي الْمَجْلِسِ ، فَأَخْبَرَهُ بِأَنَّهُ قَدْ قَتَلَهُ ، وَمَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَصًا يَتَخَصَّرُ بِهَا ، فَنَاوَلَهَا إِيَّاهُ ، ثُمَّ قَالَ :  تَخَصَّرْ  بِهَذِهِ ، فَإِنَّ الْمُتَخَصِّرِينَ يَوْمَ الْقِيَامَةِ قَلِيلٌ ، فَلَمْ يَزَلْ عِنْدَهُ حَتَّى مَاتَ ، فَدُفِنَتْ مَعَهُ  .","","Al-Mu'jam al-Kabir 14915","","عبد الله بن أنيس الأنصاري عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو سلمة بن عبد الرحمن عن الوازع بن نافع العقيلي عن علي بن ثابت الجزري عن محمد بن الصباح الجرجرائي عن الحسين بن إسحاق التستري عن الطبراني","جابر بن عبد الله الأنصاري عن عبد الله بن أنيس"
"14955","14916  -  دَثَنَا  مُحَمَّدُ بْنُ هِشَامٍ الْمُسْتَمْلِي ، قَالَ :  دَثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ، قَالَ :  دَثَنَا  جَعْفَرُ بْنُ عَوْنٍ ، قَالَ :  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ بْنِ مُجَمِّعٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ كَعْبِ بْنِ مَالِكٍ ، أَنَّ أَبَاهُ  حَدَّثَهُ  ،  عَنْ  أُمِّهِ بِنْتِ عَبْدِ اللهِ بْنِ أُنَيْسٍ ، أَنَّهَا  حَدَّثَتْهُ عَنْ  عَبْدِ اللهِ         [14/281]      بْنِ أُنَيْسٍ  :  أَنَّ الرَّهْطَ الَّذِينَ بَعَثَهُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  عَبْدِ اللهِ بْنِ أَبِي الْحُقَيْقِ  لِيَقْتُلُوهُ  :  عَبْدُ اللهِ بْنُ عَتِيكٍ  ،  وَعَبْدُ اللهِ بْنُ أُنَيْسٍ  ،  وَأَبُو قَتَادَةَ  وَحَلِيفٌ لَهُمْ  ،  وَرَجُلٌ مِنَ الْأَنْصَارِ  ، وَأَنَّهُمْ قَدِمُوا  خَيْبَرَ  لَيْلًا . فَعَمَدْنَا إِلَى أَبْوَابِهِمْ نُغْلِقُهَا خَارِجً ، قَالَتِ  امْرَأَةُ ابْنِ أَبِي الْحُقَيْقِ  : إِنَّ هَذَا لَصَوْتُ  عَبْدِ اللهِ بْنِ عَتِيكٍ  ، قَالَ : افْتَحِي ، فَفَتَحَتْ ، فَدَخَلْتُ أَنَا  وَعَبْدُ اللهِ بْنُ عَتِيكٍ  ، فَقَالَ  عَبْدُ اللهِ  : دُونَكِ ، فَذَهَبْتُ لِأَضْرِبَهَا بِالسَّيْفِ ، فَأَذْكُرُ نَهْيَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ قَتْلِ النِّسَاءِ وَالْوِلْدَانِ فَأَكُفُّ عَنْهَا .  قَالَ  عَلِيُّ بْنُ الْمَدِينِيِّ  : هَذَا  عَبْدُ اللهِ بْنُ أُنَيْسٍ الْأَنْصَارِيُّ  ، وَلَيْسَ بِالْجُهَنِيِّ ، هَذَا  عَبْدُ اللهِ بْنُ أُنَيْسٍ الْأَنْصَارِيُّ  ، الَّذِي رَوَى عَنْهُ  جَابِرُ بْنُ عَبْدِ اللهِ  .","","Al-Mu'jam al-Kabir 14916","","عبد الله بن أنيس القضاعي عن بنت عبد الله بن أنيس عن عبد الرحمن بن عبد الله بن كعب بن مالك الأنصاري عن إبراهيم بن عبد الرحمن بن عبد الله بن كعب بن مالك عن إبراهيم بن إسماعيل بن مجمع عن جعفر بن عون المخزومي عن علي ابن المديني عن ابن أبى الدميك محمد بن هشام بن علي عن الطبراني","جابر بن عبد الله الأنصاري عن عبد الله بن أنيس"
"14956","14917  -  دَثَنَا  بَكْرُ بْنُ أَحْمَدَ بْنِ مُقْبِلٍ الْبَصْرِيُّ ، قَالَ :  دَثَنَا  إِسْحَاقُ بْنُ وَهْبٍ الْعَلَّافُ ، قَالَ :  دَثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ، قَالَ :  دَثَنَا         [14/282]      عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ ،  عَنْ  إِبْرَاهِيمَ بْنِ حُوَيِّصَةَ ،  عَنِ  ابْنِ كَعْبِ بْنِ مَالِكٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ الْأَنْصَارِيِّ ، قَالَ :  ضَرَبَ  الْيَسْتَتِرُ بْنُ رِزَامٍ  الْيَهُودِيُّ وَجْهِي  بِمِخْرَشٍ  مِنْ  شَوْحَطٍ  ،  فَشَجَّنِي  مُنَقِّلَةً ، أَوْ مَأْمُومَةً  ، فَأَتَيْتُ بِهَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَكَشَفَ عَنْهَا ،  وَتَفَلَ  فِيهَا ، فَمَا آذَانِي مِنْهَا شَيْءٌ .","","Al-Mu'jam al-Kabir 14917","","عبد الله بن أنيس القضاعي عن عبد الله بن كعب بن مالك عن إبراهيم بن حويصة عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن يعقوب بن محمد بن عيسى عن إسحاق بن وهب العلاف عن بكر بن أحمد بن مقبل الهاشمي عن الطبراني","جابر بن عبد الله الأنصاري عن عبد الله بن أنيس"
"14957","[14/283]      مُحَمَّدُ بْنُ كَعْبٍ الْقُرَظِيُّ  ، عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ الْأَنْصَارِيِّ  14918  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ، قَالَ :  حَدَّثَنِي  أَبِي  ، قَالَ :  دَثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ الْهَادِ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ ، قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ أُنَيْسٍ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا :  مَنْ لِي مِنْ  خَالِدِ بْنِ نُبَيْحٍ  ؟  رَجُلٍ مِنْ  هُذَيْلٍ  ، وَهُوَ يَوْمَئِذٍ  بِعَرَفَةَ  ، قَالَ  عَبْدُ اللهِ  : فَقُلْتُ : أَنَا يَا رَسُولَ اللهِ انْعَتْهُ لِي ، فَقَالَ : لَوْ رَأَيْتَهُ هِبْتَهُ ، فَقُلْتُ : وَالَّذِي أَكْرَمَكَ ، مَا هِبْتُ شَيْئًا قَطُّ ، فَخَرَجْتُ حَتَّى لَقِيتُهُ  بِجِبَالِ عَرَفَةَ  قَبْلَ أَنْ تَغِيبَ الشَّمْسُ ،         [14/284]      فَلَقِيتُهُ فَرُعِبْتُ مِنْهُ ، فَعَرَفْتُ حِينَ رُعِبْتُ مِنْهُ الَّذِي قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : مَنِ الرَّجُلُ ؟ فَقُلْتُ : بَاغِي حَاجَةٍ ، فَهَلْ مِنْ مَبِيتٍ ؟ قَالَ : نَعَمْ ، فَالْحَقْ بِي ، قَالَ : فَخَرَجْتُ فِي أَثَرِهِ فَصَلَّيْتُ الْعَصْرَ رَكْعَتَيْنِ خَفِيفَتَيْنِ ، ثُمَّ خَرَجْتُ ، وَأَشْفَقْتُ أَنْ يَرَانِي ، ثُمَّ لَحِقْتُهُ فَضَرَبْتُهُ بِالسَّيْفِ ، ثُمَّ غَشِيتُ الْجَبَلَ  وَكَمَنْتُ  ، حَتَّى إِذَا ذَهَبَ النَّاسُ خَرَجْتُ ، حَتَّى قَدِمْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْمَدِينَةَ  فَأَخْبَرْتُهُ الْخَبَرَ .  قَالَ  مُحَمَّدُ بْنُ كَعْبٍ  : فَأَعْطَاهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مِخْصَرَةً  ، فَقَالَ :  تَخَصَّرْ  بِهَذِهِ حَتَّى تَلْقَانِي بِهَا يَوْمَ الْقِيَامَةِ ، وَأَقَلُّ النَّاسِ يَوْمَئِذٍ الْمُتَخَصِّرُونَ .  قَالَ  مُحَمَّدُ بْنُ كَعْبٍ  : فَلَمَّا تُوُفِّيَ  عَبْدُ اللهِ بْنُ أُنَيْسٍ  أَمَرَ بِهَا فَوُضِعَتْ عَلَى بَطْنِهِ ، وَكُفِّنَ عَلَيْهَا ، وَدُفِنَتْ مَعَهُ  .","","Al-Mu'jam al-Kabir 14918","","عبد الله بن أنيس القضاعي عن محمد بن كعب بن سليم القرظي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","محمد بن كعب القرظي عن عبد الله بن أنيس الأنصاري"
"14958","[14/285]      عَبْدُ اللهِ بْنُ أُنَيْسِ بْنِ حَرَامٍ الْجُهَنِيُّ  كَانَ يَنْزِلُ  الْمَدِينَةَ  ، وَهُوَ حَلِيفٌ  لِبَنِي نَابِيِّ بْنِ عَمْرِو بْنِ سَوَّادٍ  . عَقَبِيٌّ .  عِيسَى بْنُ عَبْدِ اللهِ بْنِ أُنَيْسٍ  عَنْ أَبِيهِ  14919  -  دَثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  عِيسَى بْنِ عَبْدِ اللهِ بْنِ أُنَيْسٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَهُ بِلَيْلَةِ ثَلَاثٍ وَعِشْرِينَ  .","","Al-Mu'jam al-Kabir 14919","","عبد الله بن أنيس القضاعي عن عيسى بن عبد الله بن أنيس الأنصاري عن عبد الله بن عمر العمري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عيسى بن عبد الله بن أنيس عن أبيه"
"14959","14920  -  دَثَنَا  الْحَسَنُ بْنُ عَبْدِ الْأَعْلَى الْبَوْسِيُّ ، وَإِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ بَرَّةَ الصَّنْعَانِيَّانِ ، قَالَا :  دَثَنَا  عَبْدُ الرَّزَّاقِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  عِيسَى بْنِ عَبْدِ اللهِ بْنِ أُنَيْسٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَتَى قِرْبَةً فَخَنَثَهَا  ، فَشَرِبَ وَهُوَ قَائِمٌ .","","Al-Mu'jam al-Kabir 14920","","عبد الله بن أنيس القضاعي عن عيسى بن عبد الله بن أنيس الأنصاري عن عبد الله بن عمر العمري عن عبد الرزاق الصنعاني عن إبراهيم بن محمد بن برة الصنعاني عن الطبراني","عيسى بن عبد الله بن أنيس عن أبيه"
"14960","[14/286]      ضَمْرَةُ بْنُ عَبْدِ اللهِ بْنِ أُنَيْسٍ  عَنْ أَبِيهِ  14921  -  دَثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَ :  دَثَنَا  يَحْيَى بْنُ كَثِيرٍ النَّاجِيُّ ، قَالَ :  دَثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ ، قَالَ :  سَأَلْتُ  ضَمْرَةَ بْنَ عَبْدِ اللهِ بْنِ أُنَيْسٍ عَنْ لَيْلَةِ الْقَدْرِ ؟ فَقَالَ :  سَمِعْتُ  أَبِي  يُخْبِرُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  [تَحَرَّوْهَا] لَيْلَةَ ثَلَاثٍ وَعِشْرِينَ  .","","Al-Mu'jam al-Kabir 14921","","عبد الله بن أنيس القضاعي عن ضمرة بن عبد الله بن أنيس الجهني عن بكير بن عبد الله بن الأشج القرشي عن عبد الله بن لهيعة عن يحيى بن كثير الناجي عن أبو مسلم الكجي عن الطبراني","ضمرة بن عبد الله بن أنيس عن أبيه"
"14961","[14/287]      14922  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ، قَالَ :  دَثَنَا  أَحْمَدُ بْنُ عَبْدَةَ ، قَالَ :  دَثَنَا  فُضَيْلُ بْنُ سُلَيْمَانَ النُّمَيْرِيُّ ، قَالَ :  دَثَنَا  بُكَيْرُ بْنُ مِسْمَارٍ ،  عَنِ  الزُّهْرِيِّ ، قَالَ :  قُلْتُ  لِضَمْرَةَ بْنِ عَبْدِ اللهِ بْنِ أُنَيْسٍ : مَا قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِأَبِيكَ فِي لَيْلَةِ الْقَدْرِ ؟  قَالَ  : كَانَ أَبِي  صَاحِبَ بَادِيَةٍ ، فَقَالَ : يَا رَسُولَ اللهِ ، مُرْنِي بِلَيْلَةٍ أَنْزِلُ فِيهَا ، قَالَ :  انْزِلْ لَيْلَةَ ثَلَاثٍ وَعِشْرِينَ  . قَالَ : فَلَمَّا وَلَّى ، قَالَ : اطْلُبْهَا فِي الْعَشْرِ الْأَوَاخِرِ .","","Al-Mu'jam al-Kabir 14922","","عبد الله بن أنيس القضاعي عن ضمرة بن عبد الله بن أنيس الجهني عن الزهري عن بكير بن مسمار الزهري عن فضيل بن سليمان النميري عن أحمد بن عبدة الضبي عن إبراهيم بن هاشم البغوي عن الطبراني","ضمرة بن عبد الله بن أنيس عن أبيه"
"14962","14923  -  دَثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ، قَالَ :  دَثَنَا  مُؤَمَّلُ بْنُ هِشَامٍ ، قَالَ :  دَثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،         [14/288]      قَالَ :  أَخْبَرَنِي  مُحَمَّدُ بْنُ إِبْرَاهِيمَ ،  عَنِ  ابْنِ عَبْدِ اللهِ بْنِ أُنَيْسٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي أَكُونُ بِالرَّاحِلَةِ ، وَأَنَا بِحَمْدِ اللهِ أُصَلِّي بِهَا فَمُرْنِي بِلَيْلَةٍ أَنْزِلُهَا لِهَذَا الْمَسْجِدِ أُصَلِّي فِيهِ ، قَالَ :  انْزِلْ لَيْلَةَ ثَلَاثٍ وَعِشْرِينَ  .","","Al-Mu'jam al-Kabir 14923","","عبد الله بن أنيس القضاعي عن ضمرة بن عبد الله بن أنيس الجهني عن محمد بن إبراهيم بن الحارث التيمي عن محمد بن إسحاق عن إسماعيل ابن علية عن مؤمل بن هشام اليشكري عن محمد بن صالح النرسي عن الطبراني","ضمرة بن عبد الله بن أنيس عن أبيه"
"14963","14924  -  دَثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ، قَالَ :  دَثَنَا  عَيَّاشُ بْنُ الْوَلِيدِ الرَّقَّامُ ، قَالَ :  دَثَنَا  عَبْدُ الْأَعْلَى ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ بْنِ الْحَارِثِ التَّيْمِيِّ ،  عَنِ  ابْنِ عَبْدِ اللهِ بْنِ أُنَيْسٍ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ قَالَ : يَا رَسُولَ اللهِ ، إِنَّا نَكُونُ فِي بَادِيَتِنَا وَأَنَا بِحَمْدِ اللهِ أُصَلِّي بِهَا ، فَأْمُرْنِي بِلَيْلَةٍ مِنْ هَذَا  الشَّهْرِ  أَنْزِلُهَا إِلَى الْمَسْجِدِ فَأُصَلِّي فِيهِ ، فَقَالَ :  انْزِلْ لَيْلَةَ ثَلَاثٍ وَعِشْرِينَ فَصَلِّهَا  ، وَإِنْ أَحْبَبْتَ أَنْ تَسْتَتِمَّ إِلَى آخِرِ  الشَّهْرِ  فَافْعَلْ ، وَإِنْ أَحْبَبْتَ أَنْ تَرْجِعَ إِلَى أَهْلِكَ بِلَيْلٍ فَاصْنَعْ .","","Al-Mu'jam al-Kabir 14924","","عبد الله بن أنيس القضاعي عن ضمرة بن عبد الله بن أنيس الجهني عن محمد بن إبراهيم بن الحارث التيمي عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن عياش بن الوليد الرقام عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","ضمرة بن عبد الله بن أنيس عن أبيه"
"14964","[14/289]      بِلَالُ بْنُ عَبْدِ اللهِ بْنِ أُنَيْسٍ  ، عَنْ أَبِيهِ  14925  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَ :  دَثَنَا  الصَّلْتُ بْنُ مَسْعُودٍ الْجَحْدَرِيُّ ، قَالَ :  دَثَنَا  يَحْيَى بْنُ يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ أُنَيْسٍ ، قَالَ :  حَدَّثَنِي  بِلَالُ بْنُ عَبْدِ اللهِ بْنِ أُنَيْسٍ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ قَالَ : يَا رَسُولَ اللهِ ، أَخْبِرْنِي أَيَّةَ لَيْلَةٍ يُبْتَغَى فِيهَا لَيْلَةُ الْقَدْرِ ؟ فَقَالَ :  لَوْلَا أَنْ يَتْرُكَ النَّاسُ الصَّلَاةَ إِلَّا تِلْكَ اللَّيْلَةَ لَأَخْبَرْتُكَ  ، وَلَكِنِ ابْتَغِهَا فِي ثَلَاثٍ وَعِشْرِينَ مِنَ  الشَّهْرِ  .","","Al-Mu'jam al-Kabir 14925","","عبد الله بن أنيس القضاعي عن بلال بن عبد الله بن أنيس الجهني عن يحيى بن عبد الله بن يزيد الأنيسي عن الصلت بن مسعود الجحدري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بلال بن عبد الله بن أنيس عن أبيه"
"14965","عَمْرُو بْنُ عَبْدِ اللهِ بْنِ أُنَيْسٍ  عَنْ أَبِيهِ  14926  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ نَافِعٍ الطَّحَّانُ الْمِصْرِيُّ ، قَالَ :  دَثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  دَثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  عَنْ  مُوسَى بْنِ يَعْقُوبَ الزَّمْعِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ [أَنَّ] مُحَمَّدَ بْنَ مُسْلِمٍ         [14/290]      الزُّهْرِيَّ ،  أَخْبَرَهُ ؛  أَنَّ عَبْدَ اللهِ بْنَ كَعْبِ بْنِ مَالِكٍ الْأَنْصَارِيَّ ،  وَعَمْرَو بْنَ عَبْدِ اللهِ بْنِ أُنَيْسٍ  أَخْبَرَاهُ  ، أَنَّ عَبْدَ اللهِ بْنَ أُنَيْسٍ  أَخْبَرَهُمَا  ،  أَنَّ نَفَرًا مِنَ  الْأَنْصَارِ  ، قَالُوا : مَنْ رَجُلٌ نَبْعَثُهُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ  عَبْدُ اللهِ  : فَقُلْتُ : أَنَا ، قَالُوا : فَاذْهَبْ فَسَلْهُ لَنَا : مَتَى لَيْلَةُ الْقَدْرِ ؟ فَخَرَجْتُ حَتَّى وَافَيْتُ غُرُوبَ الشَّمْسِ عِنْدَ بَعْضِ أَبْيَاتِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَرَجَ يُصَلِّي بِالْمَغْرِبِ ، فَصَلَّى وَخَرَجَ فَخَرَجْتُ مَعَهُ حَتَّى دَخَلَ بَيْتَهُ وَأَنَا مَعَهُ ، فَدَعَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِفِطْرِهِ . قَالَ  عَبْدُ اللهِ بْنُ أُنَيْسٍ  : فَرَأَيْتُنِي وَأَنَا أُرْعِي عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ قِلَّةِ طَعَامِهِ ، فَلَمَّا فَرَغَ دَعَا بِنَعْلِهِ ، ثُمَّ قَالَ :  إِنِّي أَظُنُّ أَنَّ لَكَ حَاجَةً ؟ قُلْتُ : أَجَلْ يَا رَسُولَ اللهِ  ، أَرْسَلَنِي إِلَيْكَ فُلَانٌ وَفُلَانٌ يَسْأَلُونَكَ : مَتَى لَيْلَةُ الْقَدْرِ ؟ قَالَ : اللَّيْلَةَ - وَتِلْكَ اللَّيْلَةُ لَيْلَةُ اثْنَتَيْنِ وَعِشْرِينَ مِنْ رَمَضَانَ - ثُمَّ قَالَ : مَا اللَّيْلَةُ ؟ قُلْتُ : لَيْلَةُ اثْنَتَيْنِ وَعِشْرِينَ ، قَالَ : لَا ، بَلِ اللَّيْلَةُ الْمُقْبِلَةُ ؛ لَيْلَةُ ثَلَاثٍ وَعِشْرِينَ  .","","Al-Mu'jam al-Kabir 14926","","عبد الله بن أنيس القضاعي عن عمرو بن عبد الله بن أنيس الحجازي عن الزهري عن عبد الرحمن بن إسحاق العامري عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن محمد بن إسماعيل بن مسلم الديلي عن أحمد بن صالح المصري عن أحمد بن محمد بن نافع الطحاوي عن الطبراني","عمرو بن عبد الله بن أنيس عن أبيه"
"14966","عَبْدُ الرَّحْمَنِ بْنُ كَعْبِ بْنِ مَالِكٍ  عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ  14927  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ، قَالَ :  حَدَّثَنِي  أَبِي  ، قَالَ :  دَثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  يَزِيدَ بْنِ الْهَادِ ،  عَنْ  أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ         [14/291]      كَعْبِ بْنِ مَالِكٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ ، قَالَ :  كُنَّا نَتَدَارَا فِي رَمَضَانَ ، فَقَالَ قَوْمُنَا : إِنَّهُ لَيَشُقُّ عَلَيْنَا أَنْ نَنْزِلَ بِعِيَالِنَا وَنِسَائِنَا ، وَإِنَّا لَنَخْشَى عَلَيْهِمُ الضَّيْعَةَ إِنْ نَزَلْنَا وَتَرَكْنَاهُمْ ، وَإِنَّا نَكْرَهُ أَنْ تَفُوتَنَا هَذِهِ اللَّيْلَةُ ، فَهَلْ لَكُمْ أَنْ يُرْسَلَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَيَذْكُرَ هَذَا لَهُ ، وَيَسْأَلَهُ أَنْ يَأْمُرَنَا بِلَيْلَةٍ نَنْزِلُهَا ؟ ! قَالَ  عَبْدُ اللهِ  : فَأَرْسَلُونِي وَكُنْتُ أَحْدَثَهُمْ ، فَجِئْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرْتُ لَهُ ذَلِكَ ، وَسَأَلْتُهُ أَنْ يَأْمُرَنَا بِلَيْلَةٍ نَنْزِلُهَا ، فَقَالَ :  انْزِلُوا لَيْلَةَ ثَلَاثٍ وَعِشْرِينَ  . فَكَانَ  عَبْدُ اللهِ  يَنْزِلُ تِلْكَ اللَّيْلَةَ ، فَإِذَا أَصْبَحَ رَجَعَ  .","","Al-Mu'jam al-Kabir 14927","","عبد الله بن أنيس القضاعي عن عبد الرحمن بن كعب بن مالك السلمي عن عبد الله بن عبد الرحمن بن كعب بن مالك الأنصاري عن أبو بكر بن محمد الخزرجي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","عبد الرحمن بن كعب بن مالك عن عبد الله بن أنيس"
"14967","[14/292]      14928  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْحَسَنِ الضَّرَّابُ الْأَصْبَهَانِيُّ ، قَالَ :  دَثَنَا  يَحْيَى بْنُ وَرْدِ بْنِ عَبْدِ اللهِ ، قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  عَدِيِّ بْنِ الْفَضْلِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  ضَمْرَةَ بْنِ عَبْدِ اللهِ بْنِ أُنَيْسٍ ، وَعَبْدِ الرَّحْمَنِ بْنِ كَعْبٍ ،  أَنَّهُمَا سَمِعَا  عَبْدَ اللهِ بْنَ أُنَيْسٍ  ، يَقُولُ :  جَلَسْتُ فِي مَجْلِسِ  بَنِي سَلِمَةَ  وَأَنَا أَصْغَرُهُمْ - صَبِيحَةَ إِحْدَى وَعِشْرِينَ مِنْ رَمَضَانَ ، فَقَالُوا : مَنْ يَسْأَلُ لَنَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مَتَى لَيْلَةُ الْقَدْرِ ؟ فَقُلْتُ : أَنَا ، فَذَهَبْتُ حَتَّى وَافَيْتُ عِنْدَ الْمَغْرِبِ لَيْلَةَ اثْنَتَيْنِ وَعِشْرِينَ ، فَصَلَّيْتُ مَعَهُ الصَّلَاةَ ، ثُمَّ وَقَفْتُ لَهُ عَلَى بَابِهِ حَتَّى مَرَّ عَلَيَّ ، فَأَدْخَلَنِي بَيْتَهُ ، فَدَعَا لِي بِعَشَاءٍ ، فَقَالَ لِي : تَعَشَّهْ ، فَلَقَدْ         [14/293]      رَأَيْتُنِي أَكُفُّ عَنْهُ مِنْ قِلَّتِهِ ، ثُمَّ دَعَا بِنَعْلَيْهِ فَقَامَ ، فَقَالَ : كَأَنَّ لَكَ حَاجَةً ؟ قُلْتُ : أَجَلْ ، أَرْسَلَنِي إِلَيْكَ رِجَالٌ مِنْ  بَنِي سَلِمَةَ  يَسْأَلُونَكَ : مَتَى لَيْلَةُ الْقَدْرِ ؟ فَقَالَ :  كَمِ اللَّيْلَةُ مِنَ  الشَّهْرِ  ؟ فَقُلْتُ : اثْنَتَانِ وَعِشْرُونَ ، فَقَالَ : هِيَ اللَّيْلَةُ  ، ثُمَّ رَجَعَ ، فَقَالَ : أَوِ الْقَابِلَةُ أَوِ الْقَابِلَةُ .","","Al-Mu'jam al-Kabir 14928","","عبد الله بن أنيس القضاعي عن عبد الرحمن بن كعب بن مالك السلمي عن الزهري عن عبد الرحمن بن إسحاق العامري عن عدي بن الفضل التيمي عن ورد بن عبد الله التميمي عن يحيى بن الورد التميمي عن عبد الرحمن بن الحسن الأصبهاني عن الطبراني","عبد الرحمن بن كعب بن مالك عن عبد الله بن أنيس"
"14968","[14/294]      ابْنَتُ عَبْدِ اللهِ بْنِ أُنَيْسٍ  ، عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ  14929  -  حَدَّثَنَا  أَبُو جَعْفَرٍ مُحَمَّدُ بْنُ أَحْمَدَ بْنِ نَصْرٍ التِّرْمِذِيُّ ، قَالَ :  دَثَنَا  بَكْرُ بْنُ عَبْدِ الْوَهَّابِ ، قَالَ :  دَثَنَا  يَحْيَى بْنُ مُحَمَّدِ بْنِ عُبَيْدٍ الْجَارِيُّ ، قَالَ :  حَدَّثَنِي  عَبْدُ الْعَزِيزِ بْنُ بِلَالِ بْنِ عَبْدِ اللهِ بْنِ أُنَيْسٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  [  خَالِدَةَ] بِنْتِ عَبْدِ اللهِ بْنِ أُنَيْسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ  ،  أَنَّهُ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ لَيْلَةِ الْقَدْرِ ؟ فَقَالَ :  رَأَيْتُنِي أَسْجُدُ فِي مَاءٍ وَطِينٍ  . فَقُلْتُ : بَيِّنْ لِي مَتَى  أَتَحَرَّاهَا  ، فَقَالَ :  تَحَرَّهَا  فِي النِّصْفِ الْأَوَاخِرِ ، قُلْتُ : فِي أَيِّ النِّصْفِ الْآخِرِ ؟ قَالَ : فِي ثَلَاثٍ وَعِشْرِينَ  .","","Al-Mu'jam al-Kabir 14929","","عبد الله بن أنيس القضاعي عن خالدة بنت عبد الله بن أنيس عن بلال بن عبد الله بن أنيس الجهني عن عبد العزيز بن بلال الجهني عن يحيى بن محمد بن عبد الله بن مهران الجاري عن بكر  بن عبد الوهاب الدمشقي عن محمد بن أحمد بن نصر الترمذي عن الطبراني","ابنت عبد الله بن أنيس عن عبد الله بن أنيس"
"14969","[14/295]      عَطِيَّةُ بْنُ عَبْدِ اللهِ بْنِ أُنَيْسٍ  عَنْ أَبِيهِ  14930  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ الْمِصْرِيُّ ، قَالَ :  دَثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  دَثَنَا  ابْنُ أَبِي فُدَيْكٍ ، قَالَ :  حَدَّثَنِي  عَبْدُ الْعَزِيزِ بْنُ بِلَالِ بْنِ عَبْدِ اللهِ بْنِ أُنَيْسٍ ،  عَنْ  أَبِيهِ بِلَالِ بْنِ عَبْدِ اللهِ  ،  عَنْ  عَطِيَّةَ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ عَبْدِ اللهِ بْنِ أُنَيْسٍ  ،  أَنَّهُ سَأَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ لَيْلَةِ الْقَدْرِ ، فَقَالَ :  رَأَيْتُهَا فَأُنْسِيتُهَا ،  فَتَحَرَّهَا  فِي النِّصْفِ الْآخِرِ  ، ثُمَّ عَادَ فَسَأَلَهُ ، فَقَالَ : فِي ثَلَاثٍ وَعِشْرِينَ تَمْضِي مِنَ  الشَّهْرِ  .  قَالَ  عَبْدُ الْعَزِيزِ :  فَأَخْبَرَتْنِي  أُمِّي  أَنَّ  عَبْدَ اللهِ بْنَ أُنَيْسٍ كَانَ يُحْيِي لَيْلَةَ سِتَّ عَشْرَةَ إِلَى لَيْلَةِ ثَلَاثٍ وَعِشْرِينَ  .","","Al-Mu'jam al-Kabir 14930","","عبد الله بن أنيس القضاعي عن عطية بن عبد الله بن أنيس الجهني عن بلال بن عبد الله بن أنيس الجهني عن عبد العزيز بن بلال الجهني عن محمد بن إسماعيل بن مسلم الديلي عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف المصري عن الطبراني","عطية بن عبد الله بن أنيس عن أبيه"
"14970","[14/296]      عَبْدُ الرَّحْمَنِ بْنُ أَبِي لَيْلَى  ، عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ  14931  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَمُعَاذُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ، قَالُوا :  حَدَّثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ، قَالَ :  دَثَنَا  سُلَيْمَانُ بْنُ كَثِيرٍ ، قَالَ :  حَدَّثَنِي  أَبُو الْحَسَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ ، قَالَ :  أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُصَلِّي ، فَقُمْتُ عَنْ يَسَارِهِ ، فَأَخَذَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَقَامَنِي عَنْ يَمِينِهِ ، وَعَلَيَّ ثَوْبٌ مُتَمَزِّقٌ لَا يُوَارِينِي ، فَجَعَلْتُ كُلَّمَا سَجَدْتُ أَمْسَكْتُهُ بِيَدِي مَخَافَةَ أَنْ تَنْكَشِفَ  عَوْرَتِي  وَخَلْفِي نِسَاءٌ ، فَلَمَّا انْصَرَفَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دَعَا لِي بِثَوْبٍ فَكَسَانِيهِ ، وَقَالَ :  تَوَدَّعْهُ  بِخَلَقِكَ هَذَا  .         [14/297]      أَبُو الْحَسَنِ  هَذَا الَّذِي رَوَى عَنْهُ  سُلَيْمَانُ بْنُ كَثِيرٍ  : مُهَاجِرٌ .  أَبُو الْحَسَنِ  الَّذِي رَوَى عَنْهُ  شُعْبَةُ  كُوفِيٌّ .  وَعَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ هُوَ : عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى  ، أَخُو  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى  .","","Al-Mu'jam al-Kabir 14931","","عبد الله بن أنيس القضاعي عن عبد الرحمن بن أبي ليلى عن عبد الله بن عبد الرحمن بن أبي ليلى الأنصاري عن مهاجر الصائغ عن سليمان بن كثير الأصيد عن محمد بن كثير العبدي عن محمد بن محمد بن حيان التمار عن الطبراني","عبد الرحمن بن أبي ليلى عن عبد الله بن أنيس"
"14971","أَبُو أُمَامَةَ بْنُ ثَعْلَبَةَ الْأَنْصَارِيُّ  عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ  14932  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ ، قَالَ :  دَثَنَا  شُعَيْبُ بْنُ يَحْيَى ، وَعَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَا :  دَثَنَا  اللَّيْثُ بْنُ سَعْدٍ ، قَالَ :  حَدَّثَنِي  هِشَامُ بْنُ سَعْدٍ ،  عَنْ  مُحَمَّدِ بْنِ زَيْدِ بْنِ الْمُهَاجِرِ بْنِ قُنْفُذٍ التَّيْمِيِّ ،  عَنْ  أَبِي أُمَامَةَ الْأَنْصَارِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ الْجُهَنِيِّ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ :  مِنْ أَكْبَرِ الْكَبَائِرِ :  الشِّرْكُ  بِاللهِ  ،  وَعُقُوقُ  الْوَالِدَيْنِ ،         [14/298]      وَالْيَمِينُ  الْغَمُوسُ  ، وَمَا حَلَفَ حَالِفٌ بِاللهِ يَمِينَ صَبْرٍ أَدْخَلَ فِيهَا مِثْلَ جَنَاحِ بَعُوضَةٍ ، إِلَّا كَانَتْ  وَكْتَةً  فِي قَلْبِهِ إِلَى يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 14932","","عبد الله بن أنيس القضاعي عن أبو أمامة البلوي عن محمد بن زيد بن المهاجر الجدعاني عن هشام بن سعد المخزومي عن الليث بن سعد عن شعيب بن يحيى التجيبي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","أبو أمامة بن ثعلبة الأنصاري عن عبد الله بن أنيس"
"14972","14933  -  دَثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ، قَالَ :  دَثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  قَالَ  : أَرَنَا خَالِدٌ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ زَيْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي أُمَامَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَكْبَرُ الْكَبَائِرِ : الْإِشْرَاكُ بِاللهِ  ،  وَعُقُوقُ  الْوَالِدَيْنِ ، وَيَمِينُ  الْغَمُوسِ  ، وَايْمُ الَّذِي نَفْسِي بِيَدِهِ لَا يَحْلِفُ أَحَدٌ - وَإِنْ كَانَ عَلَى مِثْلِ جَنَاحِ بَعُوضَةٍ - إِلَّا كَانَتْ  وَكْتَةً  فِي قَلْبِهِ إِلَى يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 14933","","عبد الله بن أنيس القضاعي عن عبد الله بن أبي أمامة البلوي عن محمد بن زيد بن المهاجر الجدعاني عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","أبو أمامة بن ثعلبة الأنصاري عن عبد الله بن أنيس"
"14973","[14/299]      الْحَسَنُ بْنُ يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ أُنَيْسٍ  عَنْ جَدِّهِ  14934  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ، قَالَ :  دَثَنَا  الصَّلْتُ بْنُ مَسْعُودٍ الْجَحْدَرِيُّ ، قَالَ :  دَثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ بْنِ يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ أُنَيْسٍ ، قَالَ :  دَثَنَا  الْحَسَنُ بْنُ يَزِيدَ عَمِّي ،  عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعَثَهُ سَرِيَّةً وَحْدَهُ  .","","Al-Mu'jam al-Kabir 14934","","عبد الله بن أنيس القضاعي عن الحسن بن يزيد عن يحيى بن عبد الله بن يزيد الأنيسي عن الصلت بن مسعود الجحدري عن إبراهيم بن هاشم البغوي عن الطبراني","الحسن بن يزيد بن عبد الله بن أنيس عن جده"
"14974","عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ الْحُبَابِ  عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ  14935  -  حَدَّثَنَا  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ بْنِ مِقْلَاصٍ الْمِصْرِيُّ ، قَالَ :  دَثَنَا  أَبِي  ، (  ح  ) .  وَدَثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  دَثَنَا  حَرْمَلَةُ بْنُ يَحْيَى ، قَالَا :  حَدَّثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  عَمْرُو بْنُ الْحَارِثِ ، أَنَّ مُوسَى         [14/300]      بْنَ جُبَيْرٍ  حَدَّثَهُ  ، أَنَّ عَبْدَ اللهِ بْنَ عَبْدِ الرَّحْمَنِ بْنِ الْحُبَابِ الْأَنْصَارِيَّ  حَدَّثَهُ  ،  أَنَّ عَبْدَ اللهِ بْنَ أُنَيْسٍ  حَدَّثَهُ  : أَنَّهُ تَذَاكَرَ هُوَ وَعُمَرُ بْنُ الْخَطَّابِ يَوْمًا الصَّدَقَةَ ،  فَقَالَ  عُمَرُ  : أَلَمْ تَسْمَعْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَذْكُرُ غُلُولَ الصَّدَقَةِ :  مَنْ غَلَّ مِنْهَا بَعِيرًا أَوْ شَاةً أُتِيَ بِهِ يَحْمِلُهُ يَوْمَ الْقِيَامَةِ ؟  قَالَ  عَبْدُ اللهِ بْنُ أُنَيْسٍ  : بَلَى  .","","Al-Mu'jam al-Kabir 14935","","عمر بن الخطاب عن عبد الله بن أنيس القضاعي عن عبد الله بن عبد الرحمن بن الحباب الأنصاري عن موسى بن جبير الأنصاري عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن الحسين بن إسحاق التستري عن الطبراني","عبد الله بن عبد الرحمن بن الحباب عن عبد الله بن أنيس"
"14975","بُسْرُ بْنُ سَعِيدٍ  عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ  14936  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ، قَالَ :  دَثَنَا  أَبُو ثَابِتٍ مُحَمَّدُ بْنُ عُبَيْدِ اللهِ ، قَالَ :  دَثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنِ  الضَّحَّاكِ بْنِ عُثْمَانَ ،  عَنْ  أَبِي النَّضْرِ ،  عَنْ  بُسْرِ بْنِ سَعِيدٍ ،  عَنْ  عَبْدِ اللهِ         [14/301]      بْنِ أُنَيْسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أُرِيتُ لَيْلَةَ الْقَدْرِ فَأُنْسِيتُهَا  ، وَإِنِّي أَرَانِي أَسْجُدُ فِي مَاءٍ وَطِينٍ . فَرَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْجُدُ فِي مَاءٍ وَطِينٍ صَبِيحَةَ ثَلَاثٍ وَعِشْرِينَ  .","","Al-Mu'jam al-Kabir 14936","","عبد الله بن أنيس القضاعي عن بسر بن سعيد المدني عن سالم بن أبي أمية التيمي عن الضحاك بن عثمان الحزامي عن عبد العزيز بن محمد الدراوردي عن محمد بن عبيد الله بن محمد بن زيد الأموي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","بسر بن سعيد عن عبد الله بن أنيس"
"14976","14937  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ الْمَكِّيُّ ، قَالَ :  دَثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ ،  عَنِ  الضَّحَّاكِ بْنِ عُثْمَانَ ،  عَنْ  سَالِمٍ أَبِي النَّضْرِ ،  عَنْ  بُسْرِ بْنِ سَعِيدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؛ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14937","","عبد الله بن أنيس القضاعي عن بسر بن سعيد المدني عن سالم بن أبي أمية التيمي عن الضحاك بن عثمان الحزامي عن محمد بن فليح بن سليمان الأسلمي عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","بسر بن سعيد عن عبد الله بن أنيس"
"14977","14938  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  دَثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ الْحِمَّانِيُّ ، قَالَ :  دَثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  سَالِمٍ أَبِي النَّضْرِ ،  عَنْ  بُسْرِ بْنِ سَعِيدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  رَأَيْتُنِي لَيْلَةَ الْقَدْرِ أَسْجُدُ فِي مَاءٍ وَطِينٍ  . فَصَلَّى بِنَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيْلَةَ ثَلَاثٍ وَعِشْرِينَ ، فَرَأَيْتُهُ يَسْجُدُ فِي مَاءٍ وَطِينٍ  .","","Al-Mu'jam al-Kabir 14938","","عبد الله بن أنيس القضاعي عن بسر بن سعيد المدني عن سالم بن أبي أمية التيمي عن موسى بن عقبة عن عبد العزيز بن محمد الدراوردي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","بسر بن سعيد عن عبد الله بن أنيس"
"14978","عَبْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ خُبَيْبٍ  عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ  14939  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ، قَالَ :  دَثَنَا  أَبُو صَالِحٍ         [14/302]      عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُعَاذِ بْنِ عَبْدِ اللهِ بْنِ خُبَيْبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ خُبَيْبٍ  ،  عَنْ  عَبْدِ اللهِ بْنِ أُنَيْسٍ ، صَاحِبِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  أَنَّهُ سُئِلَ عَنْ لَيْلَةِ الْقَدْرِ ؟ فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْتَمِسُوهَا اللَّيْلَةَ  - وَتِلْكَ اللَّيْلَةُ لَيْلَةُ ثَلَاثٍ وَعِشْرِينَ - فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، هِيَ إِذَنْ أَوَّلُ ثَمَانٍ ، قَالَ : بَلْ أَوَّلُ سَبْعٍ ؛ إِذِ  الشَّهْرُ  لَا يَتِمُّ  .","","Al-Mu'jam al-Kabir 14939","","عبد الله بن أنيس القضاعي عن عبد الله بن عبد الله خبيب الجهني عن معاذ بن عبد الله بن خبيب الجهني عن محمد بن إسحاق عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عبد الله بن عبد الله بن خبيب عن عبد الله بن أنيس"
"14979","[14/303]      عَبْدُ اللهِ بْنُ سَلَامٍ  رَضِيَ اللهُ عَنْهُ  14940  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ، قَالَ :  دَثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَ :  دَثَنَا  يَحْيَى بْنُ يَعْلَى ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنِ  ابْنِ أَخِي عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ ، قَالَ :  كَانَ اسْمِي فِي الْجَاهِلِيَّةِ فُلَانٌ ، فَسَمَّانِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَبْدَ اللهِ  .","","Al-Mu'jam al-Kabir 14940","","عبد الله بن سلام بن الحارث الإسرائيلي عن ابن أخي عبد الله بن سلام عن عبد الملك بن عمير القبطي عن يحيى بن يعلى بن حرملة التيمي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن سلام رضي الله عنه"
"14980","[14/304]      مَا  أَسْنَدَ  عَبْدُ اللهِ بْنُ سَلَامٍ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَبُو هُرَيْرَةَ  عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ  رَضِيَ اللهُ عَنْهُمَا  14941  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ، قَالَ :  دَثَنَا  يَزِيدُ بْنُ هَارُونَ ،  قَالَ  : أَرَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي هُرَيْرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ جَلَسَ مُنْتَظِرًا لِصَلَاةٍ فَهُوَ فِي صَلَاةٍ  .","","Al-Mu'jam al-Kabir 14941","","عبد الله بن سلام بن الحارث الإسرائيلي عن أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن إبراهيم بن الحارث التيمي عن محمد بن إسحاق عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","أبو هريرة عن عبد الله بن سلام رضي الله عنهما"
"14981","14942  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  دَثَنَا  حَجَّاجُ بْنُ         [14/305]      الْمِنْهَالِ ، قَالَ :  دَثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  قَيْسِ بْنِ سَعْدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنِ انْتَظَرَ الصَّلَاةَ فَهُوَ فِي صَلَاةٍ حَتَّى يُصَلِّيَ  .","","Al-Mu'jam al-Kabir 14942","","عبد الله بن سلام بن الحارث الإسرائيلي عن أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن إبراهيم بن الحارث التيمي عن قيس بن سعد الحبشي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو هريرة عن عبد الله بن سلام رضي الله عنهما"
"14982","14943  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالُوا :  دَثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنِ انْتَظَرَ الصَّلَاةَ فَهُوَ فِي صَلَاةٍ حَتَّى يُصَلِّيَ  .","","Al-Mu'jam al-Kabir 14943","","عبد الله بن سلام بن الحارث الإسرائيلي عن أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن إبراهيم بن الحارث التيمي عن محمد بن إسحاق عن محمد بن عبيد بن أبي أمية عن أبو بكر ابن أبي شيبة عن عبد الله بن أحمد الجواليقي عن الطبراني","أبو هريرة عن عبد الله بن سلام رضي الله عنهما"
"14983","14944  -  دَثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  دَثَنَا  الْقَعْنَبِيُّ .  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ، قَالَ :  دَثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ، جَمِيعًا  عَنْ         [14/306]      مَالِكٍ ،  عَنْ  يَزِيدَ بْنِ الْهَادِ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنِ انْتَظَرَ الصَّلَاةَ فَهُوَ فِي صَلَاةٍ  .","","Al-Mu'jam al-Kabir 14944","","عبد الله بن سلام بن الحارث الإسرائيلي عن أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن إبراهيم بن الحارث التيمي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن مالك بن أنس عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","أبو هريرة عن عبد الله بن سلام رضي الله عنهما"
"14984","14945  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ سِنَانٍ الْعَوَقِيُّ ، قَالَ :  دَثَنَا  فُلَيْحُ بْنُ سُلَيْمَانَ ،  عَنْ  سَعِيدِ بْنِ الْحَارِثِ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ :  كَانَ أَبُو هُرَيْرَةَ  يُحَدِّثُنَا         [14/307]      عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ :  إِنَّ فِي الْجُمُعَةِ سَاعَةً لَا يُوَافِقُهَا مُسْلِمٌ وَهُوَ فِي صَلَاةٍ يَسْأَلُ اللهَ خَيْرًا إِلَّا أَعْطَاهُ إِيَّاهُ  ، يُقَلِّلُهَا  أَبُو هُرَيْرَةَ  بِيَدِهِ . فَلَمَّا تُوُفِّيَ  أَبُو هُرَيْرَةَ  ، قُلْتُ : لَوْ جِئْتُ  أَبَا سَعِيدٍ  فَسَأَلْتُهُ ؟ فَأَتَيْتُهُ فَسَأَلْتُهُ ، ثُمَّ خَرَجْتُ مِنْ عِنْدِهِ فَدَخَلْتُ عَلَى عَبْدِ اللهِ بْنِ سَلَامٍ ، فَسَأَلْتُهُ  فَقَالَ  :  خَلَقَ اللهُ  آدَمَ  يَوْمَ الْجُمُعَةِ  ، وَقَبَضَهُ يَوْمَ الْجُمُعَةِ ، وَفِيهِ تَقُومُ السَّاعَةُ ، وَهِيَ آخِرُ سَاعَةٍ ، فَقُلْتُ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : فِي صَلَاةٍ ، وَلَيْسَتْ سَاعَةَ صَلَاةٍ ؟ فَقَالَ : أَوَمَا تَعْلَمُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مُنْتَظِرُ الصَّلَاةِ فِي صَلَاةٍ  ؟ قُلْتُ : بَلَى ، قَالَ : فَهِيَ وَاللهِ هِيَ  .","","Al-Mu'jam al-Kabir 14945","","عبد الله بن سلام بن الحارث الإسرائيلي عن أبو سلمة بن عبد الرحمن عن سعيد بن الحارث بن أبي سعيد الأنصاري عن فليح بن سليمان عن محمد بن سنان الباهلي عن حفص بن عمر سنجة ألف عن الطبراني","أبو هريرة عن عبد الله بن سلام رضي الله عنهما"
"14985","[14/308]      عَبْدُ اللهِ بْنُ حَنْظَلَةَ بْنِ الرَّاهِبِ  عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ  14946  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ، قَالَ :  دَثَنَا  سَلْمُ بْنُ إِبْرَاهِيمَ الْوَرَّاقُ .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَإِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ، قَالَا :  دَثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ، قَالَ :  دَثَنَا  إِسْمَاعِيلُ بْنُ سِنَانٍ أَبُو عُبَيْدَةَ الْعُصْفُرِيُّ - قَالَا :  حَدَّثَنَا  عِكْرِمَةُ بْنُ عَمَّارٍ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ الْقَاسِمِ ، قَالَ :  زَعَمَ  عَبْدُ اللهِ بْنُ حَنْظَلَةَ بْنِ الرَّاهِبِ  أَنَّ  عَبْدَ اللهِ بْنَ سَلَامٍ ، مَرَّ فِي السُّوقِ وَعَلَيْهِ حُزْمَةُ حَطَبٍ ، فَقِيلَ لَهُ : مَا يَحْمِلُكَ عَلَى هَذَا وَقَدْ أَغْنَاكَ اللهُ عَنْ هَذَا ؟ قَالَ : أَرَدْتُ أَنْ أَدْفَعَ الْكِبْرَ ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  لَا يَدْخُلُ الْجَنَّةَ مَنْ فِي قَلْبِهِ خَرْدَلَةٌ مِنْ  كِبْرٍ  .","","Al-Mu'jam al-Kabir 14946","","عبد الله بن سلام بن الحارث الإسرائيلي عن عبد الله بن حنظلة بن أبي عامر الراهب الأوسي عن محمد بن القاسم عن عكرمة بن عمار عن إسماعيل بن سنان العصفري عن محمد بن أبي بكر المقدمي عن عبد الله بن أحمد بن حنبل عن الطبراني","عبد الله بن حنظلة بن الراهب عن عبد الله بن سلام"
"14986","[14/309]      أَنَسُ بْنُ مَالِكٍ  عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ  14947  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ الْجَوْهَرِيُّ ، قَالَ :  دَثَنَا  عَفَّانُ بْنُ مُسْلِمٍ .  وَدَثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَ :  دَثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ، قَالَا :  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ وَحُمَيْدٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدِمَ  الْمَدِينَةَ  وَعَبْدُ اللهِ بْنُ سَلَامٍ فِي نَخْلِهِ  ، فَأَتَى  عَبْدُ اللهِ بْنُ سَلَامٍ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنِّي سَائِلُكَ عَنْ أَشْيَاءَ لَا يَعْلَمُهَا إِلَّا نَبِيٌّ ، فَإِنْ أَنْتَ أَخْبَرْتَنِي بِهَا آمَنْتُ بِكَ  ... الْحَدِيثَ .","","Al-Mu'jam al-Kabir 14947","","أنس بن مالك عن حميد الطويل عن حماد بن سلمة عن شيبان بن فروخ الحبطي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أنس بن مالك عن عبد الله بن سلام"
"14987","[14/310]      14948  -  حَدَّثَنَا  أَحْمَدُ بْنُ عِقَالٍ الْحَرَّانِيُّ ، قَالَ :  دَثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ         [14/311]      حُمَيْدٍ الطَّوِيلِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ سَلَامٍ  : يَا رَسُولَ اللهِ ، إِنِّي قَدْ أَسْلَمْتُ ، وَأَنَا أُحِبُّ أَنْ أَسْأَلَكَ عَنْ أَشْيَاءَ ، فَقَالَ : سَلْ عَمَّا بَدَا لَكَ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، حَدِّثْنِي عَنْ شَبَهِ الرَّجُلِ أُمَّهُ ، وَإِنَّمَا  النُّطْفَةُ  مِنَ الرَّجُلِ ؟ فَقَالَ :  نُطْفَةُ  الرَّجُلِ بَيْضَاءُ غَلِيظَةٌ ،  وَنُطْفَةُ  الْمَرْأَةِ حَمْرَاءُ رَقِيقَةٌ  ، فَأَيُّهُمَا غَلَبَ صَاحِبَتَهَا كَانَ الشَّبَهُ لَهُ . قُلْتُ : يَا رَسُولَ اللهِ ، مَا أُكُلُ أَهْلِ الْجَنَّةِ فِي الْجَنَّةِ إِذَا دَخَلُوهَا ؟ قَالَ : زِيَادَةُ كَبِدِ حُوتٍ . قُلْتُ : يَا رَسُولَ اللهِ ، أَخْبِرْنِي عَنْ أَشْرَاطِ السَّاعَةِ ؟ قَالَ : نَارٌ تَخْرُجُ مِنَ الْمَشْرِقِ فَتَسُوقُ النَّاسَ إِلَى  مَحْشَرِهِمْ  ، فَقَالَ : أَشْهَدُ أَنَّكَ نَبِيٌّ .","","Al-Mu'jam al-Kabir 14948","","أنس بن مالك عن حميد الطويل عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن عبد الله بن محمد النفيلي عن أحمد بن عبد الرحمن بن يزيد الحراني عن الطبراني","أنس بن مالك عن عبد الله بن سلام"
"14988","[14/312]      عَبْدُ اللهِ بْنُ مَعْقِلٍ الْمُزَنِيُّ  عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ  14949  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَ :  دَثَنَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ الْأَسَدِيُّ ، قَالَ :  دَثَنَا  أَبِي  ، قَالَ :  دَثَنَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَعْقِلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ ،  أَنَّهُ قَالَ حِينَ هَاجَ النَّاسُ فِي أَمْرِ  عُثْمَانَ  :  أَيُّهَا النَّاسُ ، لَا تَقْتُلُوا هَذَا الشَّيْخَ وَاسْتَعْتِبُوهُ ، فَإِنَّهُ لَنْ تَقْتُلَ أُمَّةٌ نَبِيَّهَا فَيَصْلُحَ أَمْرُهُمْ حَتَّى يُهَرَاقَ دِمَاءُ سَبْعِينَ أَلْفًا مِنْهُمْ  ، وَلَنْ تَقْتُلَ أُمَّةٌ خَلِيفَتَهُمْ فَيَصْلُحَ أَمْرُهُمْ حَتَّى يُهَرَاقَ دِمَاءُ أَرْبَعِينَ أَلْفًا مِنْهُمْ . فَلَمْ يَنْظُرُوا فِيمَا قَالَ وَقَتَلُوهُ ، فَجَلَسَ  لِعَلِيٍّ  فِي الطَّرِيقِ ، فَقَالَ : أَيْنَ تُرِيدُ ؟ فَقَالَ : أُرِيدُ أَرْضَ  الْعِرَاقِ  . وَقَالَ : لَا تَأْتِ  الْعِرَاقَ  ، وَعَلَيْكَ بِمِنْبَرِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَوَثَبَ إِلَيْهِ أُنَاسٌ مِنْ أَصْحَابِ  عَلِيٍّ  وَهَمُّوا بِهِ ، فَقَالَ  عَلِيٌّ  : دَعُوهُ فَإِنَّهُ رَجُلٌ مِنَّا  أَهْلَ الْبَيْتِ  . فَلَمَّا قُتِلَ  عَلِيٌّ  قَالَ  ابْنُ سَلَامٍ  لِابْنِ مَعْقِلٍ  : هَذِهِ رَأْسُ الْأَرْبَعِينَ وَسَيَكُونُ عَلَى رَأْسِهَا صُلْحٌ ، وَلَنْ تَقْتُلَ أُمَّةٌ نَبِيَّهَا إِلَّا قُتِلَ بِهِ سَبْعُونَ أَلْفًا ، وَلَنْ تَقْتُلَ أُمَّةٌ خَلِيفَتَهَا إِلَّا قُتِلَ بِهِ أَرْبَعُونَ أَلْفًا  .","","Al-Mu'jam al-Kabir 14949","","عبد الله بن سلام بن الحارث الإسرائيلي عن عبد الله بن مغفل بن عبد نهم المزني عن حميد بن هلال العدوي عن سليمان بن المغيرة القيسي عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عبد الله بن معقل المزني عن عبد الله بن سلام"
"14989","[14/313]      يُوسُفُ بْنُ عَبْدِ اللهِ بْنِ سَلَامٍ  عَنْ أَبِيهِ  14950  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ، قَالَ :  دَثَنَا  عَمَّارُ بْنُ هَارُونَ ، قَالَ :  دَثَنَا  هِشَامٌ أَبُو الْمِقْدَامِ ،  عَنْ  أَبِيهِ  ،  عَنْ  يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اللَّهُمَّ بَارِكْ لِأُمَّتِي فِي بُكُورِهَا  .","","Al-Mu'jam al-Kabir 14950","","عبد الله بن سلام بن الحارث الإسرائيلي عن يوسف بن عبد الله بن سلام الإسرائيلي عن زياد القرشي مولى عثمان بن عفان عن هشام بن زياد بن أبي يزيد العثماني عن عمار بن هارون المستملي عن إبراهيم بن هاشم البغوي عن الطبراني","يوسف بن عبد الله بن سلام عن أبيه"
"14990","[14/314]      14951  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ، قَالَ :  دَثَنَا  عَمَّارُ بْنُ هَارُونَ ، قَالَ :  دَثَنَا  هِشَامٌ أَبُو الْمِقْدَامِ ،  عَنْ  أَبِيهِ  ،  عَنْ  يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحَرْبُ  خَدْعَةٌ  .","","Al-Mu'jam al-Kabir 14951","","عبد الله بن سلام بن الحارث الإسرائيلي عن يوسف بن عبد الله بن سلام الإسرائيلي عن زياد القرشي مولى عثمان بن عفان عن هشام بن زياد بن أبي يزيد العثماني عن عمار بن هارون المستملي عن إبراهيم بن هاشم البغوي عن الطبراني","يوسف بن عبد الله بن سلام عن أبيه"
"14991","14952  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَ :  دَثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ .  وَحَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ، قَالَ :  دَثَنَا  أَصْبَغُ بْنُ الْفَرَجِ ، (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ، وَمَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ ، قَالَا :  دَثَنَا  سَعِيدُ بْنُ مَنْصُورٍ .         [14/315]      وَحَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ ، قَالَ :  دَثَنَا  أَحْمَدُ بْنُ صَالِحٍ - قَالُوا :  دَثَنَا  ابْنُ وَهْبٍ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ، أَنَّ يَحْيَى بْنَ عَبْدِ الرَّحْمَنِ  حَدَّثَهُ  ،  عَنْ  عَوْنِ بْنِ عَبْدِ اللهِ ،  عَنْ  يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  بَيْنَمَا نَحْنُ نَسِيرُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذْ سَمِعَ  الْقَوْمَ  وَهُمْ يَقُولُونَ : أَيُّ الْأَعْمَالِ أَفْضَلُ يَا رَسُولَ اللهِ ؟ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِيمَانٌ بِاللهِ وَرَسُولِهِ ،  وَجِهَادٌ  فِي سَبِيلِهِ ، وَحَجٌّ  مَبْرُورٌ  . ثُمَّ سَمِعَ نِدَاءً فِي الْوَادِي ، يَقُولُ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : وَأَنَا أَشْهَدُ ، وَأَشْهَدُ ، لَا يَشْهَدُهَا أَحَدٌ إِلَّا بَرِئَ مِنَ  الشِّرْكِ  .  وَاللَّفْظُ لِحَدِيثِ  أَحْمَدَ بْنِ صَالِحٍ  .","","Al-Mu'jam al-Kabir 14952","","عبد الله بن سلام بن الحارث الإسرائيلي عن يوسف بن عبد الله بن سلام الإسرائيلي عن عون بن عبد الله بن عتبة عن يحيى بن عبد الرحمن الثقفي عن سعيد بن أبي هلال الليثي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","يوسف بن عبد الله بن سلام عن أبيه"
"14992","14953  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ         [14/316]      عَبْدِ الْعَزِيزِ الرَّمْلِيُّ ، قَالَ :  دَثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ، قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ حَمْزَةَ بْنِ يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ :  كُنْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي أُنَاسٍ مِنْ أَصْحَابِهِ ، إِذْ أَقْبَلَ  عُثْمَانُ بْنُ عَفَّانَ  وَمَعَهُ رَاحِلَةٌ عَلَيْهَا غِرَارَتَيْنِ ، وَهُوَ مُحْتَجِزٌ  بِعِقَالِ  نَاقَتِهِ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَيُّ شَيْءٍ فِي الْغَرَارَتَيْنِ ؟ قَالَ : دَقِيقٌ وَسَمْنٌ وَعَسَلٌ  ،         [14/317]      فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَنِخْ ، فَأَنَاخَ ، ثُمَّ دَعَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِبُرْمَةٍ  ، فَجَعَلَ فِيهَا مِنْ ذَلِكَ الدَّقِيقِ وَالسَّمْنِ وَالْعَسَلِ ، ثُمَّ لَبَّكَهُ ، ثُمَّ أَكَلَ ، ثُمَّ قَالَ لِأَصْحَابِهِ : كُلُوا ، هَذَا الَّذِي تُسَمِّيهِ فَارِسُ : الْخَبِيصَ .","","Al-Mu'jam al-Kabir 14953","","عبد الله بن سلام بن الحارث الإسرائيلي عن حمزة بن يوسف بن عبد الله بن سلام عن محمد بن حمزة الإسرائيلي عن الوليد بن مسلم القرشي عن محمد بن عبد العزيز بن محمد العمري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","يوسف بن عبد الله بن سلام عن أبيه"
"14993","14954  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ، قَالَ :  دَثَنَا  أَبِي  .         [14/318]      وَدَثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْأَبَّارُ الْبَغْدَادِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ ، قَالَا :  دَثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ حَمْزَةَ بْنِ يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ عَبْدِ اللهِ بْنِ سَلَامٍ  ، قَالَ :  إِنَّ اللهَ لَمَّا أَرَادَ هُدَى  زَيْدِ بْنِ سَعْنَةَ  ، قَالَ  زَيْدُ بْنُ سَعْنَةَ  : مَا مِنْ عَلَامَاتِ النُّبُوَّةِ شَيْءٌ إِلَّا وَقَدْ عَرَفْتُهَا فِي وَجْهِ  مُحَمَّدٍ  حِينَ نَظَرْتُ إِلَيْهِ ، إِلَّا اثْنَنَيْنِ لَمْ أَخْبُرْهُمَا مِنْهُ : يَسْبِقُ حِلْمُهُ جَهْلَهُ ، وَلَا يَزِيدُهُ شِدَّةُ الْجَهْلِ عَلَيْهِ إِلَّا حِلْمًا ، فَكُنْتُ أَلْطُفُ لَهُ إِلَى أَنْ أُخَالِطَهُ ، فَأَعْرِفَ حِلْمَهُ مِنْ جَهْلِهِ .         [14/319]      قَالَ  زَيْدُ بْنُ سَعْنَةَ  : فَخَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا مِنَ الْحُجُرَاتِ ، وَمَعَهُ  عَلِيُّ بْنُ أَبِي طَالِبٍ  ، فَأَتَاهُ  رَجُلٌ  عَلَى رَاحِلَتِهِ كَالْبَدَوِيِّ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ بِقُرْبِي قَرْيَةَ بَنِي فُلَانٍ ، قَدْ أَسْلَمُوا وَدَخَلُوا فِي الْإِسْلَامِ ، وَكُنْتُ حَدَّثْتُهُمْ إِنْ أَسْلَمُوا أَتَاهُمُ الرِّزْقُ رَغَدًا ، وَقَدْ أَصَابَتْهُمْ سَنَةٌ ، وَشِدَّةٌ ، وَقُحُوطٌ مِنَ الْغَيْثِ ، فَأَنَا أَخْشَى - يَا رَسُولَ اللهِ - أَنْ يَخْرُجُوا مِنَ الْإِسْلَامِ طَمَعًا ، كَمَا دَخَلُوا فِيهِ طَمَعًا ، فَإِنْ رَأَيْتَ أَنْ تُرْسِلَ إِلَيْهِمْ بِشَيْءٍ تُعِينُهُمْ بِهِ ، فَعَلْتَ . فَنَظَرَ إِلَى رَجُلٍ إِلَى جَانِبِهِ - أُرَاهُ  عَلِيًّا  - فَقَالَ : يَا رَسُولَ اللهِ مَا بَقِيَ مِنْهُ شَيْءٌ . قَالَ  زَيْدُ بْنُ سَعْنَةَ  : فَدَنَوْتُ إِلَيْهِ ، فَقُلْتُ : يَا  مُحَمَّدُ  ، هَلْ لَكَ أَنْ تَبِيعَنِي تَمْرًا مَعْلُومًا فِي حَائِطِ بَنِي فُلَانٍ إِلَى أَجَلِ كَذَا وَكَذَا ؟ فَقَالَ :  لَا يَا يَهُودِيُّ ، وَلَكِنْ أَبِيعُكَ تَمْرًا مَعْلُومًا إِلَى أَجَلِ كَذَا وَكَذَا  ، وَلَا نُسَمِّي حَائِطَ بَنِي فُلَانٍ ، قُلْتُ : نَعَمْ ، فَبَايَعَنِي ، فَأَطْلَقْتُ هِمْيَانِي ، فَأَعْطَيْتُهُ ثَمَانِينَ  مِثْقَالًا  مِنْ ذَهَبٍ فِي تَمْرٍ مَعْلُومٍ إِلَى أَجَلِ كَذَا وَكَذَا ، فَأَعْطَاهَا الرَّجُلَ ، وَقَالَ : اعْدِلْ عَلَيْهِمْ وَأَعِنْهُمْ بِهَا .  قَالَ  زَيْدُ بْنُ سَعْنَةَ  : فَلَمَّا كَانَ قَبْلَ مَحِلّ الْأَجَلِ بِيَوْمَيْنِ أَوْ ثَلَاثٍ ، خَرَجَ رَسُولُ اللهِ وَمَعَهُ  أَبُو بَكْرٍ  وَعُمَرُ  وَعُثْمَانُ  فِي نَفَرٍ مِنْ         [14/320]      أَصْحَابِهِ ، فَلَمَّا صَلَّى عَلَى الْجِنَازَةِ وَدَنَا مِنْ جِدَارٍ لِيَجْلِسَ أَتَيْتُهُ ، فَأَخَذْتُ بِمَجَامِعِ قَمِيصِهِ وَرِدَائِهِ ، وَنَظَرْتُ إِلَيْهِ بِوَجْهٍ غَلِيظٍ ، فَقُلْتُ لَهُ : أَلَا تَقْضِينِي يَا  مُحَمَّدُ  حَقِّي ؟ فَوَاللهِ مَا عَلِمْتُكُمْ -  بَنِي عَبْدِ الْمُطَّلِبِ  - لَمُطْلٌ ، وَلَقَدْ كَانَ لِي بِمُخَالَطَتِكُمْ عِلْمٌ ، وَنَظَرْتُ إِلَى  عُمَرَ  وَإِذَا عَيْنَاهُ تَدُورَانِ فِي وَجْهِهِ  كَالْفَلَكِ  الْمُسْتَدِيرِ ، ثُمَّ رَمَانِي بِبَصَرِهِ ، فَقَالَ : يَا عَدُوَّ اللهِ ، أَتَقُولُ لِرَسُولِ اللهِ مَا أَسْمَعُ ، وَتَصْنَعُ بِهِ مَا أَرَى ؟ فَوَالَّذِي بَعَثَهُ بِالْحَقِّ لَوْلَا مَا أُحَاذِرُ فَوْتَهُ لَضَرَبْتُ بِسَيْفِي رَأْسَكَ ، وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَنْظُرُ إِلَى  عُمَرَ  بِسُكُونٍ وَتُؤَدَةٍ ، وَتَبَسَّمَ ، ثُمَّ قَالَ : يَا  عُمَرُ  ، أَنَا وَهُوَ كُنَّا أَحْوَجَ إِلَى غَيْرِ هَذَا ، أَنْ تَأْمُرَنِي بِحُسْنِ الْأَدَاءِ ، وَتَأْمُرَهُ بِحُسْنِ اتِّبَاعِهِ ، اذْهَبْ بِهِ يَا  عُمَرُ  فَأَعْطِهِ حَقَّهُ ، وَزِدْهُ عِشْرِينَ صَاعًا مِنْ تَمْرٍ مَكَانَ مَا رُعْتَهُ .  قَالَ  زَيْدٌ  : فَذَهَبَ بِي  عُمَرُ  فَأَعْطَانِي حَقِّي وَزَادَنِي عِشْرِينَ صَاعًا مِنْ تَمْرٍ ، فَقُلْتُ : مَا هَذِهِ الزِّيَادَةُ يَا  عُمَرُ  ؟ قَالَ : أَمَرَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ         [14/321]      أَزِيدَكَ مَكَانَ مَا رُعْتُكَ . قَالَ : وَتَعْرِفُنِي يَا  عُمَرُ  ؟ قَالَ : لَا ، فَمَا دَعَاكَ أَنْ فَعَلْتَ بِرَسُولِ اللهِ مَا فَعَلْتَ وَقُلْتَ لَهُ مَا قُلْتَ؟ قُلْتُ : يَا  عُمَرُ  ، لَمْ يَكُنْ مِنْ عَلَامَاتِ النُّبُوَّةِ شَيْءٌ إِلَّا وَقَدْ عَرَفْتُ فِي وَجْهِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ نَظَرْتُ إِلَيْهِ إِلَّا اثْنَتَيْنِ لَمْ أَخْبُرْهُمَا مِنْهُ : يَسْبِقُ حِلْمُهُ جَهْلَهُ ، وَلَا يَزِيدُهُ بِشِدَّةِ الْجَهْلِ عَلَيْهِ إِلَّا حِلْمًا ، فَقَدِ اخْتَبَرْتُهُمَا ، فَأُشْهِدُكَ يَا  عُمَرُ  أَنِّي قَدْ رَضِيتُ بِاللهِ رَبًّا ، وَبِالْإِسْلَامِ دِينًا ،  وَبِمُحَمَّدٍ  نَبِيًّا ، وَأُشْهِدُكَ أَنَّ  شَطْرَ  مَالِي - فَإِنِّي أَكْثَرُهَا مَالًا - صَدَقَةٌ عَلَى أُمَّةِ  مُحَمَّدٍ  . قَالَ  عُمَرُ  : أَوْ عَلَى بَعْضِهِمْ ، فَإِنَّكَ لَا تَسَعُهُمْ . قُلْتُ : أَوْ عَلَى بَعْضِهِمْ .  فَرَجَعَ  عُمَرُ  وَزَيْدٌ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ  زَيْدٌ  : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَشْهَدُ أَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ .         [14/322]      وَآمَنَ بِهِ وَصَدَّقَهُ ، وَتَابَعَهُ ، وَشَهِدَ مَعَهُ مَشَاهِدَ كَثِيرَةً ، ثُمَّ تُوُفِّيَ فِي  غَزْوَةِ تَبُوكَ  مُقْبِلًا غَيْرَ مُدْبِرٍ . رَحِمَ اللهُ  زَيْدًا  .","","Al-Mu'jam al-Kabir 14954","","عبد الله بن سلام بن الحارث الإسرائيلي عن حمزة بن يوسف بن عبد الله بن سلام عن محمد بن حمزة الإسرائيلي عن الوليد بن مسلم القرشي عن محمد بن المتوكل بن ابى السرى عن أحمد بن علي بن مسلم النخشبي عن الطبراني","يوسف بن عبد الله بن سلام عن أبيه"
"14994","14955  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ، قَالَ :  دَثَنَا  الْوَلِيدُ ،  عَنْ  مُحَمَّدِ بْنِ حَمْزَةَ بْنِ يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ  :  أَنَّ  عَبْدَ اللهِ بْنَ سَلَامٍ  قَالَ لِأَحْبَارِ الْيَهُودِ : إِنِّي أَحْدَثُ بِمَسْجِدِ أَبِينَا  إِبْرَاهِيمَ  وَإِسْمَاعِيلَ  عَهْدًا ، فَانْطَلَقَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ  بِمَكَّةَ  ، فَوَافَاهُمْ وَقَدِ انْصَرَفُوا مِنَ  الْحَجِّ  ، فَوَجَدَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِمِنًى  ، وَالنَّاسُ حَوْلَهُ ، فَقَامَ مَعَ النَّاسِ ، فَلَمَّا نَظَرَ إِلَيْهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَنْتَ  عَبْدُ اللهِ بْنُ سَلَامٍ  ؟ قَالَ : قُلْتُ : نَعَمْ ، قَالَ : ادْنُ  ، فَدَنَوْتُ مِنْهُ ، قَالَ :  أَنْشُدُكَ  بِاللهِ يَا  عَبْدَ اللهِ بْنَ سَلَامٍ  ، أَمَا تَجِدُنِي فِي التَّوْرَاةِ رَسُولَ اللهِ ؟ فَقُلْتُ لَهُ : انْعَتْ رَبَّنَا ، قَالَ : فَجَاءَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ حَتَّى وَقَفَ بَيْنَ يَدَيْ         [14/323]      رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :         {      قُلْ هُوَ اللهُ أَحَدٌ             *          اللهُ الصَّمَدُ             *          لَمْ يَلِدْ وَلَمْ يُولَدْ             *          وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ         }      ، فَقَرَأَهَا عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . قَالَ  ابْنُ سَلَامٍ  : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنَّكَ رَسُولُ اللهِ ، ثُمَّ انْصَرَفَ  ابْنُ سَلَامٍ  إِلَى  الْمَدِينَةِ  ، فَكَتَمَ إِسْلَامَهُ . فَلَمَّا هَاجَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدِمَ  الْمَدِينَةَ  وَأَنَا فَوْقُ فِي نَخْلَةٍ لِي أَجُدُّهَا ، فَسَمِعْتُ رَجَّةً فِي  الْمَدِينَةِ  ، فَقُلْتُ : مَا هَذَا ؟ قَالُوا : هَذَا رَسُولُ اللهِ قَدْ قَدِمَ . فَأَلْقَيْتُ نَفْسِي مِنْ أَعْلَى النَّخْلَةِ ، ثُمَّ جِئْتُ  أَحْفِزُ  حَتَّى أَتَيْتُهُ ، فَسَلَّمْتُ عَلَيْهِ ، ثُمَّ رَجَعْتُ ، فَقَالَتْ أُمِّي : لِلهِ أَنْتَ ، وَاللهِ لَوْ كَانَ  مُوسَى بْنُ عِمْرَانَ  عَلَيْهِ السَّلَامُ مَا كَانَ نَوْلُكَ تُلْقِي نَفْسَكَ مِنْ أَعْلَى النَّخْلَةِ ، فَقُلْتُ : وَاللهِ ، لَأَنَا أَسَرُّ بِقُدُومِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ  مُوسَى بْنِ عِمْرَانَ  إِذْ بُعِثَ  .","","Al-Mu'jam al-Kabir 14955","","حمزة بن يوسف بن عبد الله بن سلام عن محمد بن حمزة الإسرائيلي عن الوليد بن مسلم القرشي عن محمد بن مصفى بن بهلول عن عبد الله بن أحمد الجواليقي عن الطبراني","يوسف بن عبد الله بن سلام عن أبيه"
"14995","[14/324]      14956  -  حَدَّثَنَا  حَجَّاجُ بْنُ عِمْرَانَ السَّدُوسِيُّ ، قَالَ :  دَثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ الشَّاذَكُونِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ عُمَرَ الْوَاقِدِيُّ ، قَالَ :  دَثَنَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  خَطَبَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ جُمُعَةٍ فَقَالَ :  مَا عَلَى أَحَدِكُمْ لَوِ اتَّخَذَ ثَوْبَيْنِ لِجُمُعَتِهِ ، سِوَى ثَوْبَيْ  مِهْنَتِهِ .  ؟","","Al-Mu'jam al-Kabir 14956","","عبد الله بن سلام بن الحارث الإسرائيلي عن يوسف بن عبد الله بن سلام الإسرائيلي عن محمد بن يحيى بن حبان عن عبد الحميد بن جعفر الأوسي عن الواقدي عن الشاذكوني عن حجاج بن عمران السدوسي عن الطبراني","يوسف بن عبد الله بن سلام عن أبيه"
"14996","14957  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْأَزْدِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ عُمَرَ الْوَاقِدِيُّ ، قَالَ :  دَثَنَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  قُلْنَا : يَا رَسُولَ اللهِ ، أَنَحْنُ خَيْرٌ أَمْ مَنْ بَعْدَنَا ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ أَنَّ لِأَحَدِهِمْ مِثْلَ  أُحُدٍ  ذَهَبًا يُنْفِقُهُ فِي  سَبِيلِ  اللهِ مَا بَلَغَ  مُدَّ  أَحَدِكُمْ وَلَا  نَصِيفَهُ  .","","Al-Mu'jam al-Kabir 14957","","عبد الله بن سلام بن الحارث الإسرائيلي عن يوسف بن عبد الله بن سلام الإسرائيلي عن محمد بن يحيى بن حبان عن عبد الحميد بن جعفر الأوسي عن الواقدي عن محمد بن يحيى بن أبي حاتم عن الحسين بن إسحاق التستري عن الطبراني","يوسف بن عبد الله بن سلام عن أبيه"
"14997","[14/325]      14958  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامِ بْنِ حَفْصِ بْنِ غِيَاثٍ الْكُوفِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ (  ح  ) .  وَدَثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ طَرِيفٍ الْبَجَلِيُّ ، وَعُقْبَةُ بْنُ مُكْرَمٍ ، وَهَنَّادُ بْنُ السَّرِيِّ ، قَالُوا :  دَثَنَا  يُونُسُ بْنُ بُكَيْرٍ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  يَعْقُوبَ بْنِ عُتْبَةَ بْنِ الْمُغِيرَةِ بْنِ الْأَخْنَسِ ،  عَنْ  عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ،  عَنْ  يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنَّا نَكُونُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَإِذَا حَدَّثَ رَفَعَ رَأْسَهُ إِلَى السَّمَاءِ  .","","Al-Mu'jam al-Kabir 14958","","عبد الله بن سلام بن الحارث الإسرائيلي عن يوسف بن عبد الله بن سلام الإسرائيلي عن عمر بن عبد العزيز بن مروان عن يعقوب بن عتبة بن المغيرة الثقفي عن محمد بن إسحاق عن يونس بن بكير عن محمد بن عبد الله بن نمير عن عبيد بن غنام النخعي عن الطبراني","يوسف بن عبد الله بن سلام عن أبيه"
"14998","[14/326]      14959  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ جَامِعٍ الْعَطَّارُ ، قَالَ :  دَثَنَا  سَلْمُ بْنُ قُتَيْبَةَ ، قَالَ :  دَثَنَا  الصَّلْتُ بْنُ يَحْيَى ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ  : عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا صَلَاةَ لِمُلْتَفِتٍ  .","","Al-Mu'jam al-Kabir 14959","","عبد الله بن سلام بن الحارث الإسرائيلي عن يوسف بن عبد الله بن سلام الإسرائيلي عن ابن أبي مليكة عن الصلت بن طريف المعولي عن سلم بن قتيبة الشعيري عن محمد بن جامع العطار عن عبد الله بن أحمد الجواليقي عن الطبراني","يوسف بن عبد الله بن سلام عن أبيه"
"14999","14960  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ بُنْدَارٌ ، قَالَ :  دَثَنَا  سَلْمُ بْنُ قُتَيْبَةَ ،  عَنِ  الصَّلْتِ بْنِ طَرِيفٍ ،  عَنْ  رَجُلٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا صَلَاةَ لِمُلْتَفِتٍ  .","","Al-Mu'jam al-Kabir 14960","","عبد الله بن سلام بن الحارث الإسرائيلي عن يوسف بن عبد الله بن سلام الإسرائيلي عن ابن أبي مليكة عن رجل عن الصلت بن طريف المعولي عن سلم بن قتيبة الشعيري عن محمد بن بشار بندار عن محمد بن عبد الله مطين الحضرمي عن الطبراني","يوسف بن عبد الله بن سلام عن أبيه"
"15000","[14/327]      14961  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، قَالَ :  دَثَنَا  الْحُسَيْنُ بْنُ عَلِيِّ بْنِ الْأَسْوَدِ ، قَالَ :  دَثَنَا  مُحَمَّدُ بْنُ الصَّلْتِ ، قَالَ :  دَثَنَا  غِيَاثُ بْنُ إِبْرَاهِيمَ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي يَحْيَى ،  عَنْ  يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قُلْتُ :  يَا رَسُولَ اللهِ ، قَدْ قَرَأْتُ الْقُرْآنَ وَالتَّوْرَاةَ وَالْإِنْجِيلَ ، قَالَ :  اقْرَأْ بِهَذَا لَيْلَةً ، وَبِهَذَا لَيْلَةً  .","","Al-Mu'jam al-Kabir 14961","","عبد الله بن سلام بن الحارث الإسرائيلي عن يوسف بن عبد الله بن سلام الإسرائيلي عن محمد بن أبي يحيى الأسلمي عن غياث بن إبراهيم النخعي عن محمد بن الصلت الأصم عن الحسين بن علي بن الأسود العجلي عن عبد الله بن أحمد الجواليقي عن الطبراني","يوسف بن عبد الله بن سلام عن أبيه"
