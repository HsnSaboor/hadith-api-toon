hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"1801","624  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدِ بْنِ الْعَاصِ ،  عَنْ  سَعِيدِ بْنِ عَمْرِو بْنِ الْعَاصِ  أَنَّ  عَدِيًّا لَمَّا حَكَمَ أَرْبَعَمِائَةٍ وَثَمَانِينَ دِرْهَمًا أَرْسَلَ إِلَيْهِ  عَمْرُو بْنُ حُرَيْثٍ  ثَلَاثِينَ أَلْفًا  ، فَقَسَمَهَا يَوْمَئِذٍ قَبْلَ أَنْ يَبْرَحَ فِيمَنْ كَانَ عِنْدَهُ ، وَعَلَيْهِ يَوْمَئِذٍ بَتٌّ ، فَلَمَّا بَلَغَ  عَمْرَو بْنَ حُرَيْثٍ  أَنَّهُ قَسَمَهَا بَعَثَ إِلَيْهَا بِجِهَازِهَا وَمَا يُصْلِحُهَا وَكَانَ يُقَالُ لَهَا :  أُسْدَةُ بِنْتُ عَدِيٍّ  .","","Sunan Sa'id ibn Mansur 624","","عدي بن حاتم بن عبد الله الطائي عن سعيد بن عمرو بن سعيد بن العاص العذري عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة على حكمها"
"1802","625  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ قَالَ : «  مَكْتُوبٌ فِي بَعْضِ الْكُتُبِ : مَهْرُ الْبِكْرِ أَرْبَعُونَ دِرْهَمًا  ، وَمَهْرُ  الثَّيِّبِ  عِشْرُونَ دِرْهَمًا ، لِكَيْ لَا يَقُولَ أَحَدٌ : لَا أَجِدُ مَا أَنْكِحُ فَيَزْنِيَ  » .","","Sunan Sa'id ibn Mansur 625","","زيد بن أسلم عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يتزوج المرأة على حكمها"
"1803","626  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ، قَالَ : «  النِّكَاحُ عَلَى مَا تَرَاضَوْا عَلَيْهِ مِنْ شَيْءٍ فَهُوَ صَدَاقٌ  » .","","Sunan Sa'id ibn Mansur 626","","الحسن البصري عن يونس بن عبيد عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يتزوج المرأة على حكمها"
"1804","بَابُ مَا جَاءَ فِي نِكَاحِ السِّرِّ .  627  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ عَنْ  عُبَيْدٍ ، قَالَ :  نَا         [6/202]      الْحَسَنُ  أَنَّ رَجُلًا تَزَوَّجَ امْرَأَةً سِرًّا ، فَكَانَ يَخْتَلِفُ إِلَيْهَا ، فَرَآهُ  جَارٌ لَهَا  ، فَقَذَفَهُ بِهَا فَاسْتَعْدَى عَلَيْهِ عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ ،  فَقَالَ لَهُ  عُمَرُ  : بَيِّنَتُكَ عَلَى تَزْوِيجِهَا ، فَقَالَ : يَا أَمِيرَ الْمُؤْمِنِينَ كَانَ أَمْرُنَا دُونَ فَأَشْهَدْتُ عَلَيْهَا أَهْلَهَا ، فَدَرَأَ  عُمَرُ  الْحَدَّ  عَنْ قَاذِفِهِ وَقَالَ : «  حَصِّنُوا  فُرُوجَ  هَذِهِ النِّسَاءِ ، وَأَعْلِنُوا هَذَا النِّكَاحَ  وَنَهَى عَنِ  الْمُتْعَةِ  » .  كذا في طبعة الدار السلفية بالهند، وورد على الصواب : ( يونس بن عبيد ) عند البيهقي في سننه الكبير ، وينظر مصادر الترجمة ، والله أعلم .","","Sunan Sa'id ibn Mansur 627","","عمر بن الخطاب عن الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نكاح السر"
"1805","628  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ، أَنَّهُ سَمِعَهُ يَقُولُ : «  إِنَّ نِكَاحَ السِّرِّ حَرَامٌ  » .","","Sunan Sa'id ibn Mansur 628","","عروة بن الزبير عن هشام بن عروة بن الزبير عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب ما جاء في نكاح السر"
"1806","629  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ، وَهُشَيْمٌ ،  عَنْ  أَبِي بَلْجٍ ،  عَنْ  مُحَمَّدِ بْنِ حَاطِبٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  فَصْلُ مَا بَيْنَ الْحَلَالِ وَالْحَرَامِ  الصَّوْتُ ،  وَضَرْبُ الدُّفِّ  » .","","Sunan Sa'id ibn Mansur 629","","محمد بن حاطب بن الحارث الجمحي عن أبو بلج يحيى بن سليم الفزاري عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نكاح السر"
"1807","630  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ، قَالَ :  سَمِعْتُ  رَبِيعَةَ ، يَقُولُ :  سَمِعَ عُمَرُ بْنُ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ صَوْتَ كَبَرٍ فَقَالَ : مَا هَذَا ؟ فَقِيلَ : نِكَاحٌ ،  فَقَالَ  : «  أَفْشُوا النِّكَاحَ  »  .","","Sunan Sa'id ibn Mansur 630","","عمر بن الخطاب عن ربيعة الرأي عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب ما جاء في نكاح السر"
"1808","631  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُبَيْدِ اللهِ بْنِ حَمْزَةَ بْنِ صُهَيْبٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ         [6/203]      عَبْدِ الرَّحْمَنِ  قَالَ  : «  لَقَدْ ضُرِبَ بِالدُّفِّ وَغُنِّيَ عَلَى رَأْسِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ لَيْلَةَ الْمِلَاكِ  » .","","Sunan Sa'id ibn Mansur 631","","عبد الرحمن بن عوف بن عبد عوف القرشي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن عطاء العامري عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب ما جاء في نكاح السر"
"1809","632  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ، قَالَ :  نُبِّئَتْ  أَنَّ عُمَرَ رَضِيَ اللهُ عَنْهُ كَانَ إِذَا سَمِعَ صَوْتًا أَنْكَرَهُ ، وَسَأَلَ عَنْهُ  فَإِنْ قِيلَ :  عُرْسٌ  أَوْ خِتَانٌ أَقَرَّهُ  » .","","Sunan Sa'id ibn Mansur 632","","عمر بن الخطاب عن محمد بن سيرين عن أيوب السختياني عن إسماعيل ابن علية عن سعيد بن منصور","باب ما جاء في نكاح السر"
"1810","633  -  حَدَّثَنَا  سَعِيدٌ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  سَالِمٍ الْخَيَّاطِ ،  عَنِ  الْحَسَنِ ،  أَنَّ رَجُلًا تَزَوَّجَ سِرًّا فَقَالَ لَهُ رَجُلٌ : أَرَاكَ تَدَخْلُ عَلَى  فُلَانَةَ  : إِنَّكَ لَتَزْنِي بِهَا  قَالَ : فَرُفِعَ ذَلِكَ إِلَى عُمَرَ رَضِيَ اللهُ عَنْهُ ، فَقَالَ : هِيَ امْرَأَتِي فَلَمْ يَجْلِدْ  عُمَرُ  الْقَاذِفَ  .","","Sunan Sa'id ibn Mansur 633","","عمر بن الخطاب عن الحسن البصري عن سالم بن عبد الله الخياط عن عبد الله بن المبارك عن سعيد بن منصور","باب ما جاء في نكاح السر"
"1811","634  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  ابْنُ الْمُبَارَكِ ،  قَالَ  عَبْدُ الْمَلِكِ بْنُ أَبِي سُلَيْمَانَ  عَنْ  عَطَاءٍ ،  فِي رَجُلٍ قَالَ لِرَجُلٍ : مَا تَأْتِي امْرَأَتَكَ إِلَّا حَرَامًا  قَالَ : « لَيْسَ عَلَيْهِ حَدٌّ  » .","","Sunan Sa'id ibn Mansur 634","","عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن عبد الله بن المبارك عن سعيد بن منصور","باب ما جاء في نكاح السر"
"1812","635  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  ابْنُ الْمُبَارَكِ ، قَالَ :  نَا  عِيسَى بْنُ يُونُسَ ، قَالَ :  نَا  خَالِدُ بْنُ إِلْيَاسَ ،  عَنْ  رَبِيعَةَ صَاحِبِ الرَّأْيِ  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ ، رَضِيَ اللهُ عَنْهَا قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  أَظْهِرُوا النِّكَاحَ ، وَاضْرِبُوا عَلَيْهِ بِالْغِرْبَالِ  » .","","Sunan Sa'id ibn Mansur 635","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن ربيعة الرأي عن خالد بن الياس العدوي عن عيسى بن يونس بن أبي إسحاق عن عبد الله بن المبارك عن سعيد بن منصور","باب ما جاء في نكاح السر"
"1813","بَابُ تَزْوِيجِ الْجَارِيَةِ الصَّغِيرَةِ .  636  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  نَا  سَيَّارٌ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّ رَجُلًا         [6/204]      كَانَ فِي سَفَرٍ فَقَالَ لِأَصْحَابِهِ :  أَيُّكُمْ يَذْبَحُ لَنَا شَاةً وَأُزَوِّجُهُ أَوَّلَ بِنْتٍ يُولَدُ لِي ،  فَفَعَلَ ذَلِكَ رَجُلٌ مِنَ  الْقَوْمِ  ، فَذَبَحَ لَهُمْ شَاةً ، فَوُلِدَ  لِلرَّجُلِ  ابْنَةٌ ، فَأَتَاهُ فَقَالَ : امْرَأَتِي فَأَتَوُا  ابْنَ مَسْعُودٍ  رَحِمَهُ اللهُ ،  فَقَالَ  ابْنُ مَسْعُودٍ : « وَجَبَ النِّكَاحُ بِالشَّاةِ ، وَلَهَا صَدَاقُ مِثْلِهَا ، لَا  وَكْسَ  وَلَا  شَطَطَ  » .","","Sunan Sa'id ibn Mansur 636","","عبد الله بن مسعود عن الشعبي عن سيار بن أبي سيار العنزي عن هشيم بن بشير عن سعيد بن منصور","باب تزويج الجارية الصغيرة"
"1814","637  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ اللهِ ، بِنَحْوٍ مِنْ ذَلِكَ .","","Sunan Sa'id ibn Mansur 637","","عبد الله بن مسعود عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب تزويج الجارية الصغيرة"
"1815","638  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ قَوْمًا كَانُوا فِي سَفَرٍ فَقَالَ رَجُلٌ مِنَ  الْقَوْمِ  : مَنْ يَذْبَحُ شَاةً لِلْقَوْمِ  وَلَهُ ابْنَتِي ، أَوْ قَالَ : ابْنَةٌ تُولَدُ لِي  ، فَذَبَحَ  رَجُلٌ  مِنْهُمْ ، فَلَمَّا وُلِدَ لَهُ ذُكِرَ ذَلِكَ لِعَبْدِ اللهِ رَحِمَهُ اللهُ  فَقَالَ  : «  قَدْ مَلَكْتَ الْمَرْأَةَ وَلَيْسَ هَذَا بِصَدَاقٍ  » .","","Sunan Sa'id ibn Mansur 638","","عبد الله بن مسعود عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب تزويج الجارية الصغيرة"
"1816","639  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ،  نَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  دَخَلَ الزُّبَيْرُ بْنُ الْعَوَّامِ عَلَى  قُدَامَةَ بْنِ مَظْعُونٍ  يَعُودُهُ فَبُشِّرَ  زُبَيْرٌ  بِجَارِيَةٍ ، وَهُوَ عِنْدَهُ ، فَقَالَ لَهُ  قُدَامَةُ  : زَوِّجْنِيهَا  ، فَقَالَ لَهُ  الزُّبَيْرُ بْنُ الْعَوَّامِ  : مَا تَصَنَعُ بِجَارِيَةٍ صَغِيرَةٍ وَأَنْتَ عَلَى هَذِهِ الْحَالِ ؟ قَالَ : بَلَى إِنْ عِشْتُ فَابْنَةُ  الزُّبَيْرِ  ، وَإِنْ مُتُّ فَأَحَبُّ مَنْ وَرِثَنِي قَالَ : فَزَوَّجَهَا إِيَّاهُ  .         [6/205]","","Sunan Sa'id ibn Mansur 639","","الزبير بن العوام عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أبو معاوية الضرير عن سعيد بن منصور","باب تزويج الجارية الصغيرة"
"1817","640  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  أَيُّوبَ بْنِ مُوسَى ،  عَنِ  ابْنِ قُسَيْطٍ ، قَالَ  بُشِّرَ رَجُلٌ بِجَارِيَةٍ فَقَالَ رَجُلٌ : هَبْهَا لِي ، فَقَالَ : هِيَ لَكَ فَسُئِلَ سَعِيدُ بْنُ الْمُسَيِّبِ عَنْ ذَلِكَ ،  فَقَالَ  : «  لَا تَحِلُّ الْهِبَةُ لِأَحَدٍ بَعْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، وَلَوْ أَصْدَقَهَا سَوْطًا حَلَّتْ لَهُ  » .","","Sunan Sa'id ibn Mansur 640","","سعيد بن المسيب عن يزيد بن عبد الله بن قسيط الليثي عن أيوب بن موسى الأموي عن سفيان بن عيينة عن سعيد بن منصور","باب تزويج الجارية الصغيرة"
"1818","641  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  يَعْقُوبُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  حَدَّثَنِي  أَبُو حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ ، رَحِمَهُ اللهُ :  أَنَّ  امْرَأَةً  جَاءَتْ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَتْ : يَا رَسُولَ اللهِ جِئْتُ لِأَهَبَ لَكَ نَفْسِي فَنَظَرَ إِلَيْهَا  فَصَعَّدَ  الْبَصَرَ  وَصَوَّبَهُ  ثُمَّ طَأْطَأَ رَأْسَهُ ، فَقَامَ  رَجُلٌ مِنْ أَصْحَابِهِ  فَقَالَ : يَا رَسُولَ اللهِ ، إِنْ لَمْ يَكُنْ لَكَ بِهَا حَاجَةٌ فَزَوِّجْنِيهَا ، فَقَالَ : هَلْ عِنْدَكَ مِنْ شَيْءٍ ؟ فَقَالَ : لَا ، وَاللهِ يَا رَسُولَ اللهِ فَقَالَ : اذْهَبْ إِلَى أَهْلِكَ فَانْظُرْ هَلْ تَجِدُ شَيْئًا ، فَذَهَبَ ثُمَّ رَجَعَ فَقَالَ : لَا ، وَاللهِ مَا وَجَدْتُ شَيْئًا ، فَقَالَ : اذْهَبْ وَلَوْ خَاتَمًا مِنْ حَدِيدٍ ، فَذَهَبَ ثُمَّ رَجَعَ فَقَالَ : لَا وَاللهِ يَا رَسُولَ اللهِ وَلَا خَاتَمًا مِنْ حَدِيدٍ ، وَلَكِنْ هَذَا إِزَارِي قَالَ  سَهْلٌ  : مَا لَهُ رِدَاءٌ ، فَلَهَا نِصْفُهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مَا تَصْنَعُ بِإِزَارِكَ ؟ إِنْ لَبِسْتَهُ لَمْ يَكُنْ عَلَيْهَا مِنْهُ شَيْءٌ ، وَإِنْ لَبِسَتْهُ لَمْ يَكُنْ عَلَيْكَ مِنْهُ شَيْءٌ ، فَجَلَسَ الرَّجُلُ حَتَّى طَالَ مَجْلِسُهُ قَالَ : مَاذَا مَعَكَ مِنَ الْقُرْآنِ ؟ فَقَالَ : مَعِي سُورَةُ كَذَا وَسُورَةُ كَذَا عَدَّدَهَا ، فَقَالَ : أَتَقْرَؤُهُنَّ عَنْ ظَهْرِ قَلْبٍ ؟ فَقَالَ : نَعَمْ قَالَ :  اذْهَبْ مَلَّكْتُكَهَا بِمَا مَعَكَ         [6/206]      مِنَ الْقُرْآنِ  .","","Sunan Sa'id ibn Mansur 641","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن يعقوب بن عبد الرحمن الإسكندراني عن سعيد بن منصور","باب تزويج الجارية الصغيرة"
"1819","642  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  أَبُو عَرْفَجَةَ الْفَايِشِيُّ  عَنْ  أَبِي النُّعْمَانَ الْأَزْدِيِّ قَالَ :  زَوَّجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  امْرَأَةً  عَلَى سُورَةٍ مِنَ الْقُرْآنِ  ، ثُمَّ قَالَ : « لَا تَكُونُ لِأَحَدٍ بَعْدَكَ مَهْرًا  » .","","Sunan Sa'id ibn Mansur 642","","أبو النعمان الأزدي جد أيوب بن النعمان عن عمير بن عرفجة الفائشي عن أبو معاوية الضرير عن سعيد بن منصور","باب تزويج الجارية الصغيرة"
"1820","643  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ «  أَنَّ  عَبْدَ الرَّحْمَنِ بْنَ أُمِّ الْحَكَمِ  أَرَادَ امْرَأَتَهُ  ابْنَةَ جَرِيرٍ  فِي مَرَضِهِ عَلَى شَيْءٍ مِنْ مِيرَاثِهَا مِنْهُ فَأَبَتْ عَلَيْهِ  ، فَتَزَوَّجَ عَلَيْهَا امْرَأَتَيْنِ فَأَجَازَ ذَلِكَ عَبْدُ الْمَلِكِ بْنُ مَرْوَانَ  »  .","","Sunan Sa'id ibn Mansur 643","","عبد الملك بن مروان بن الحكم عن الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب تزويج الجارية الصغيرة"
"1821","644  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  عَنِ  الشَّيْبَانِيِّ قَالَ :  سَمِعْتُ  الشَّعْبِيَّ ، يَقُولُ  فِي رَجُلٍ تَزَوَّجَ امْرَأَةً وَهُوَ مَرِيضٌ  ، فَقَالَ  الشَّعْبِيُّ  : « يَجُوزُ تَزْوِيجُهُ وَبَيْعُهُ وَشِرَاؤُهُ  » .","","Sunan Sa'id ibn Mansur 644","","الشعبي عن سليمان بن فيروز الشيباني عن هشيم بن بشير عن سعيد بن منصور","باب تزويج الجارية الصغيرة"
"1822","645  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  نُجِيزُ تَزْوِيجَهُ فِي مَرَضِهِ  » .","","Sunan Sa'id ibn Mansur 645","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب تزويج الجارية الصغيرة"
"1823","646  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ، قَالَ :  حَدَّثَنِي  مُوسَى         [6/207]      بْنُ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  أَنَّ  عَبْدَ الرَّحْمَنِ بْنَ أَبِي رَبِيعَةَ  تَزَوَّجَ بِنْتَ عَمٍّ لَهُ فِي زَمَانِ  عُثْمَانَ  - وَهِيَ الَّتِي كَانَ تُزَوَّجَهَا  عُمَرُ  ثُمَّ طَلَّقَهَا - فِي مَرَضِهِ لِتَرِثَهُ فَمَاتَ فَوَرِثَتْهُ  .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، ولعل الصواب : ( عبد الله بن أبي ربيعة )","","Sunan Sa'id ibn Mansur 646","","عبد الله بن أبي ربيعة المخزومي عن نافع مولى ابن عمر عن موسى بن عقبة عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب تزويج الجارية الصغيرة"
"1824","بَابُ مَا جَاءَ فِي النَّهْيِ عَنْ أَنْ  يَخْطُبَ  الرَّجُلُ عَلَى خِطْبَةِ أَخِيهِ .  647  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْأَعْرَجِ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : سَمِعْتُهُ يَقُولُ : «  لَا  يَخْطُبُ  الرَّجُلُ عَلَى خِطْبَةِ أَخِيهِ حَتَّى يَنْكِحَ أَوْ يَتْرُكَ  » .","","Sunan Sa'id ibn Mansur 647","","أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سعيد بن منصور","باب ما جاء في النهي عن أن يخطب الرجل على خطبة أخيه"
"1825","648  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  عَوْفٌ ، قَالَ :  أَنَا  الْحَسَنُ قَالَ : نُبِّئْتُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : «  لَا  يَخْطُبُ  الرَّجُلُ عَلَى خِطْبَةِ أَخِيهِ  ، وَلَا  يَسُومُ  عَلَى سَوْمِ أَخِيهِ  » .","","Sunan Sa'id ibn Mansur 648","","الحسن البصري عن عوف بن أبي جميلة عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في النهي عن أن يخطب الرجل على خطبة أخيه"
"1826","649  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  يَزِيدُ بْنُ هَارُونَ ،  عَنْ  حُسَيْنٍ الْمُعَلِّمِ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  أَنَّ رَجُلًا تَزَوَّجَ امْرَأَةً عَلَى خَالَتِهَا فَفَرَّقَ بَيْنَهُمَا عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ  .","","Sunan Sa'id ibn Mansur 649","","عمر بن الخطاب عن عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن عمرو بن شعيب عن حسين المعلم عن يزيد بن هارون عن سعيد بن منصور","باب ما جاء في النهي عن أن يخطب الرجل على خطبة أخيه"
"1827","[6/208]      بَابُ مَا جَاءَ فِي الرَّجُلِ لَا يَنْكِحُ الْمَرْأَةَ عَلَى عَمَّتِهَا وَلَا خَالَتِهَا .  650  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عُمَرُ بْنُ أَبِي سَلَمَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : «  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ تُنْكَحَ الْمَرْأَةُ عَلَى عَمَّتِهَا ، أَوْ عَلَى خَالَتِهَا  » .","","Sunan Sa'id ibn Mansur 650","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن عمر بن أبي سلمة الزهري عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل لا ينكح المرأة على عمتها ولا خالتها"
"1828","651  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  سَمِعَ  أَبَا سَلَمَةَ ، يُحَدِّثُ  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : «  نَهَى أَنْ تُنْكَحَ الْمَرْأَةُ ، عَلَى ابْنَةٍ  وَعَلَى خَالَتِهَا  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : سقط من ص : أخيها ، تدل عليه رواية مسلم","","Sunan Sa'id ibn Mansur 651","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الرجل لا ينكح المرأة على عمتها ولا خالتها"
"1829","652  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : «  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ تُنْكَحَ الْمَرْأَةُ عَلَى عَمَّتِهَا أَوْ عَلَى خَالَتِهَا  ، وَنَهَى أَنْ تُنْكَحَ الْمَرْأَةُ عَلَى ابْنَةِ أَخِيهَا أَوِ ابْنَةِ أُخْتِهَا ، نَهَى أَنْ تُنْكَحَ الْكُبْرَى عَلَى الصُّغْرَى ، أَوِ الصُّغْرَى عَلَى الْكُبْرَى  » .","","Sunan Sa'id ibn Mansur 652","","أبو هريرة الدوسي عن الشعبي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل لا ينكح المرأة على عمتها ولا خالتها"
"1830","653  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  لَا تُنْكَحُ الْمَرْأَةُ عَلَى عَمَّتِهَا وَلَا عَلَى خَالَتِهَا  ، وَلَا تَسْأَلُ الْمَرْأَةُ طَلَاقَ أُخْتِهَا  لِتَكْتَفِئَ  مَا فِي صَحْفَتِهَا وَلِتُزَوَّجَ فَإِنَّمَا لَهَا مَا كُتِبَ لَهَا  » .         [6/209]","","Sunan Sa'id ibn Mansur 653","","أبو هريرة الدوسي عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل لا ينكح المرأة على عمتها ولا خالتها"
"1831","654  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْأَعْرَجِ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : «  لَا يُجْمَعُ بَيْنَ الْمَرْأَةِ وَعَمَّتِهَا  ، وَلَا بَيْنَهَا وَبَيْنَ خَالَتِهَا ، وَلَا تَسْأَلُ الْمَرْأَةُ طَلَاقَ أُخْتِهَا لِتَسْتَفْرِغَ مَا فِي صَحْفَتِهَا وَتَنْكِحَ فَإِنَّمَا لَهَا مَا قُدِّرَ لَهَا  » .","","Sunan Sa'id ibn Mansur 654","","أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سعيد بن منصور","باب ما جاء في الرجل لا ينكح المرأة على عمتها ولا خالتها"
"1832","بَابُ مَا جَاءَ فِي ابْنَتَيِ الْعَمِّ ، وَالْجَمْعِ بَيْنَهُمَا .  655  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  عَطَاءٍ ، قَالَ : «  كُرِهَ نِكَاحُ بِنْتَيِ الْعَمِّ لِفَسَادٍ بَيْنَهُمَا  » .","","Sunan Sa'id ibn Mansur 655","","عطاء بن أبي رباح عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنتي العم والجمع بينهما"
"1833","656  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنِ  الْحَسَنِ «  أَنَّهُ كَانَ لَا يَرَى بَأْسًا أَنْ يُجْمَعَ بَيْنَ بِنْتَيِ الْعَمِّ وَبَيْنَ بِنْتَيِ الْخَالِ  » .","","Sunan Sa'id ibn Mansur 656","","الحسن البصري عن هشام بن حسان العتكي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب ما جاء في ابنتي العم والجمع بينهما"
"1834","657  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  أَنَّ  ابْنًا لِعَلِيٍّ جَمَعَ بَيْنَ ابْنَتَيِ الْعَمِّ  لَمْ يَكُنْ أَعْلَمَ بِذَلِكَ الْعَمَّيْنِ ، فَأَصْبَحَتْ نِسَاءٌ لَا يَدْرِينَ إِلَى مَنْ يَذْهَبْنَ إِلَى هَذِهِ ، أَوْ إِلَى هَذِهِ ، فَقَالَ  عَمْرٌو  : فَقُلْتُ لِلْحَسَنِ بْنِ مُحَمَّدٍ : مَا هَذَا الَّذِي صَنَعْتُمْ ؟ قَالَ : « هُوَ أَحَبُّ إِلَيْنَا مِنْهُمَا  » .","","Sunan Sa'id ibn Mansur 657","","الحسن بن محمد بن علي بن أبي طالب عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنتي العم والجمع بينهما"
"1835","بَابُ مَا جَاءَ فِي الشَّرْطِ فِي النِّكَاحِ .  658  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ ،  عَنْ         [6/210]      يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَبِي الْخَيْرِ مَرْثَدٍ الْيَزَنِيِّ قَالَ :  سَمِعْتُ  عُقْبَةَ بْنَ عَامِرٍ يُحَدِّثُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  إِنَّ أَحَقَّ مَا وَفَّيْتُمْ بِهِ مِنَ الشَّرْطِ مَا اسْتَحْلَلْتُمْ بِهِ  الْفُرُوجَ  » .","","Sunan Sa'id ibn Mansur 658","","عقبة بن عامر بن عبس الفرضي عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن عبد الحميد بن جعفر الأوسي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1836","659  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ الْأَنْصَارِيُّ ،  عَنِ  الْحَسَنِ بْنِ مُحَمَّدٍ الْأَنْصَارِيِّ قَالَ :  حَدَّثَنِي  رَجُلٌ مِنَ النَّمِرِ بْنِ قَاسِطٍ قَالَ :  سَمِعْتُ  صُهَيْبَ بْنَ سِنَانٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : «  أَيُّمَا رَجُلٍ أَصْدَقَ امْرَأَةً صَدَاقًا وَاللهُ يَعْلَمُ مِنْهُ أَنَّهُ لَا يُرِيدُ أَدَاءَهُ إِلَيْهَا  فَغَرَّهَا بِاللهِ عَزَّ وَجَلَّ وَاسْتَحَلَّ فَرْجَهَا بِالْبَاطِلِ لَقِيَ اللهَ عَزَّ وَجَلَّ يَوْمَ يَلْقَاهُ وَهُوَ زَانٍ ، وَأَيُّمَا رَجُلٍ  ادَّانَ  مِنْ رَجُلٍ دَيْنًا وَاللهُ يَعْلَمُ مِنْهُ أَنَّهُ لَا يُرِيدُ أَدَاءَهُ إِلَيْهِ ، فَغَرَّهُ بِاللهِ وَاسْتَحَلَّ مَالَهُ بِالْبَاطِلِ ، لَقِيَ اللهَ عَزَّ وَجَلَّ يَوْمَ يَلْقَاهُ وَهُوَ سَارِقٌ  » .","","Sunan Sa'id ibn Mansur 659","","صهيب بن سنان الرومي عن رجل من النمر بن قاسط عن الحسن بن محمد الأنصاري عن عبد الحميد بن جعفر الأوسي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1837","660  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  سَمِعَ  جَابِرَ         [6/211]      بْنَ زَيْدٍ ، يَقُولُ : «  إِذَا اشْتَرَطَ الرَّجُلُ لِلْمَرْأَةِ دَارَهَا فَهُوَ بِمَا اسْتَحَلَّ مِنْ فَرْجِهَا  » .","","Sunan Sa'id ibn Mansur 660","","جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1838","661  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ، قَالَ :  نَا  الْحَارِثُ بْنُ أَبِي ذُبَابٍ ،  عَنْ  مُسْلِمِ بْنِ يَسَارٍ قَالَ :  سَأَلْتُ  سَعِيدَ بْنَ الْمُسَيِّبِ عَنْ  رَجُلٍ شَرَطَ لِامْرَأَةٍ دَارَهَا قَالَ : « يُخْرِجُهَا حَيْثُ شَاءَ  » .","","Sunan Sa'id ibn Mansur 661","","سعيد بن المسيب عن مسلم بن أبي مريم الأنصاري عن الحارث بن عبد الرحمن الدوسي عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1839","662  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ  عَنْ  يَزِيدَ بْنِ يَزِيدَ بْنِ جَابِرٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ عُبَيْدِ اللهِ بْنِ أَبِي الْمُهَاجِرِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ قَالَ :  شَهِدْتُ  عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ أُتِيَ فِي امْرَأَةٍ جَعَلَ لَهَا زَوْجُهَا دَارَهَا ، فَقَالَ  عُمَرُ  : لَهَا شَرْطُهَا ، فَقَالَ رَجُلٌ : إِذًا يُطَلِّقْنَنَا ، فَقَالَ  عُمَرُ  : «  إِنَّمَا مَقَاطِعُ الْحُقُوقِ عِنْدَ الشُّرُوطِ  »  .","","Sunan Sa'id ibn Mansur 662","","عمر بن الخطاب عن عبد الرحمن بن غنم الأشعري عن إسماعيل ابن أبي المهاجر عن يزيد بن يزيد بن جابر الأزدي عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1840","663  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  إِسْمَاعِيلَ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ قَالَ :  كُنْتُ جَالِسًا عِنْدَ عُمَرَ حَيْثُ تَمَسُّ رُكْبَتِي رُكْبَتَهُ فَقَالَ رَجُلٌ : يَا أَمِيرَ الْمُؤْمِنِينَ ، تَزَوَّجْتُ هَذِهِ وَشَرَطْتُ لَهَا دَارَهَا ، وَإِنِّي أَجْمَعُ  لِأَمْرِي أَوْ لِشَأْنِي  أَنِّي أَنْتَقِلُ إِلَى أَرْضِ كَذَا وَكَذَا ،         [6/212]      فَقَالَ : لَهَا شَرْطُهَا ، فَقَالَ رَجُلٌ : هَلَكَتِ الرِّجَالُ إِذًا لَا تَشَاءُ امْرَأَةٌ أَنْ تُطَلِّقَ زَوْجَهَا إِلَّا طَلَّقَتْ ،  فَقَالَ  عُمَرَ  : «  الْمُسْلِمُونَ عَلَى شُرُوطِهِمْ عِنْدَ مَقَاطِعِ حُقُوقِهِمْ  »  .","","Sunan Sa'id ibn Mansur 663","","عمر بن الخطاب عن عبد الرحمن بن غنم الأشعري عن إسماعيل ابن أبي المهاجر عن أيوب السختياني عن حماد بن زيد عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1841","664  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ قَالَ :  نَا  عَبْدُ الْكَرِيمِ الْجَزَرِيُّ ،  عَنْ  أَبِي عُبَيْدَةَ ،  أَنَّ  مُعَاوِيَةَ  أُتِيَ فِي ذَلِكَ فَاسْتَشَارَ عَمْرَو بْنَ الْعَاصِ  فَقَالَ  : « لَهَا شَرْطُهَا  » .","","Sunan Sa'id ibn Mansur 664","","عمرو بن العاص بن وائل السهمي عن أبو عبيدة بن عبد الله بن مسعود عن عبد الكريم الاصطخري عن سفيان الثوري عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1842","665  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  عُمَرَ بْنِ قَيْسٍ الْمَاصِرِ ، قَالَ :  شَهِدْتُ  شُرَيْحًا وَأَتَاهُ رَجُلٌ وَقَالَ : إِنِّي رَجُلٌ مِنْ  أَهْلِ الشَّامِ  ، فَقَالَ : « مَرْحَبًا بِالْبَقِيَّةِ  » قَالَ : إِنِّي تَزَوَّجْتُ امْرَأَةً ، فَقَالَ : «  بِالرِّفَاءِ  وَالْبَنِينَ » قَالَ : شَرَطْتُ لَهَا دَارَهَا ، قَالَ : « الْمُسْلِمُونَ عِنْدَ شُرُوطِهِمْ » قَالَ : اقْضِ بَيْنَنَا ، قَالَ : « قَدْ فَعَلْتُ  » .","","Sunan Sa'id ibn Mansur 665","","شريح بن الحارث الكندي عن عمر بن قيس الماصر عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1843","666  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُحَمَّدُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ قَالَ :  جَاءَ  عَدِيُّ بْنُ أَرْطَاةَ  إِلَى شُرَيْحٍ فَقَالَ : إِنِّي امْرُؤٌ مِنْ  أَهْلِ الشَّامِ  ، فَقَالَ : « مَرْحَبًا بِكَ وَأَهْلًا »  قَالَ : تَزَوَّجْتُ امْرَأَةً ، قَالَ : «  بِالرِّفَاءِ  وَالْبَنِينَ ، أَوْ قَالَ : بِالرِّفْعَةِ وَالْبَنِينَ  » قَالَ : شَرَطْتُ لَهَا دَارَهَا ، قَالَ : « الشَّرْطُ أَمْلَكُ » قَالَ : أَرَدْتُ الرُّجُوعَ إِلَى أَهْلِي ، قَالَ : « أَنْتَ أَحَقُّ بِأَهْلِكَ » قَالَ : فَأَيْنَ أَنْتَ ؟ قَالَ : « بَيْنَكَ وَبَيْنَ الْجِدَارِ » قَالَ : فَاقْضِ بَيْنَنَا ، قَالَ : « قَدْ فَعَلْتُ  » .         [6/213]","","Sunan Sa'id ibn Mansur 666","","شريح بن الحارث الكندي عن الشعبي عن محمد بن سالم الهمداني عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1844","667  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  عَبَّادٍ ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ  فِي الرَّجُلِ يَتَزَوَّجُ الْمَرْأَةَ وَشَرَطَ لَهَا دَارَهَا  ، قَالَ : « شَرْطُ اللهِ قَبْلَ شَرْطِهَا  » .","","Sunan Sa'id ibn Mansur 667","","علي بن أبي طالب عن عباد بن عبد الله الأسدي عن المنهال بن عمرو الأسدي عن محمد بن عبد الرحمن بن أبي ليلى عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1845","668  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  يَجُوزُ النِّكَاحُ وَيَبْطُلُ الشَّرْطُ  » .","","Sunan Sa'id ibn Mansur 668","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1846","669  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 669","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1847","670  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ اللهِ بْنُ وَهْبٍ قَالَ :  نَا  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  كَثِيرِ بْنِ فَرْقَدٍ ،  عَنْ  سَعِيدِ بْنِ عُبَيْدِ بْنِ السَّبَّاقِ  أَنَّ رَجُلًا تَزَوَّجَ امْرَأَةً عَلَى عَهْدِ عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ وَشَرَطَ لَهَا أَنْ لَا يُخْرِجَهَا  فَوَضَعَ عَنْهُ  عُمَرُ بْنُ الْخَطَّابِ  الشَّرْطَ ،  وَقَالَ  : « الْمَرْأَةُ مَعَ زَوْجِهَا  » .","","Sunan Sa'id ibn Mansur 670","","عمر بن الخطاب عن سعيد بن عبيد بن السباق الثقفي عن كثير بن فرقد المدني عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1848","671  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَطَاءٍ الْخُرَاسَانِيِّ  أَنَّ  عَلِيًّا ، وَابْنَ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا سُئِلَا عَنْ رَجُلٍ تَزَوَّجَ امْرَأَةً وَشَرَطَتْ عَلَيْهِ أَنَّ بِيَدِهَا الْفُرْقَةَ وَالْجِمَاعَ وَعَلَيْهَا الصَّدَاقُ فَقَالَا : «  عَمِيتَ عَنِ السُّنَّةِ  ،         [6/214]      وَوَلَّيْتَ الْأَمْرَ غَيْرَ أَهْلِهِ ، عَلَيْكَ الصَّدَاقُ وَبِيَدِكَ الْفِرَاقُ وَالْجِمَاعُ  » .","","Sunan Sa'id ibn Mansur 671","","عبد الله بن عباس عن عطاء الخراساني عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1849","672  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ، وَأَبُو عَوَانَةَ  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ قَالَ : «  كُلُّ شَرْطٍ فِي نِكَاحٍ فَإِنَّ النِّكَاحَ يَهْدِمُهُ إِلَّا الطَّلَاقَ  ، وَكُلُّ شَرْطٍ فِي بَيْعٍ ، فَإِنَّ الْبَيْعَ يَهْدِمُهُ إِلَّا الْعَتَاقَ  » .","","Sunan Sa'id ibn Mansur 672","","إبراهيم النخعي عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1850","673  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُطَرِّفٌ ،  عَنْ  إِبْرَاهِيمَ أَنَّهُ قَالَ مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 673","","إبراهيم النخعي عن مطرف بن طريف عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1851","674  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْأَعْلَى الثَّعْلَبِيِّ قَالَ :  كُنْتُ جَالِسًا عِنْدَ  شُرَيْحٍ  فَجَاءَتْهُ امْرَأَةٌ فَقَالَتْ : يَا  أَبَا أُمَيَّةَ  إِنَّ هَذَا الرَّجُلَ أَتَانِي ، وَلَا يَرْجُو أَنْ يَتَزَوَّجَنِي ، فَقُلْتُ لَهُ : هَلْ لَكَ أَنْ تَزَوَّجَنِي قَالَ : أَتَسْخَرِينَ بِي فَزَوَّجْتُهُ نَفْسِي ، وَأَعْطَيْتُهُ مِنَ الَّذِي لِي أَرْبَعَةَ آلَافِ دِرْهَمٍ ، وَأَتْجَرْتُهُ فِي مَالِي حَتَّى عَمُرَ مَالُهُ فِي مَالِي كَالرَّقْمَةِ فِي جَنْبِ الْبَعِيرِ ، فَزَعَمَ أَنَّهُ مُطَلِّقِي وَيَتَزَوَّجُ عَلَيَّ ، فَقَالَ  شُرَيْحٌ  لِلرَّجُلِ  : مَا تَقُولُ ؟ قَالَ : صَدَقَتْ ، فَسَأَلَ  شُرَيْحٌ  الْمَلَأَ حَوْلَهُ ، فَزَعَمُوا  أَنَّ  عَلِيًّا رَضِيَ اللهُ عَنْهُ أَتَاهُ مِثْلُ الَّذِي أَتَاكَ ، فَقَالَ : «  أَنْتَ أَحَقُّ بِالطَّلَاقِ وَالنِّكَاحِ مَا بَيْنَكَ وَبَيْنَ أَرْبَعَةِ نِسْوَةٍ  ، فَإِنْ أَنْتَ طَلَّقْتَ فَالطَّلَاقُ بِيَدِكَ ، وَارْدُدْ إِلَيْهَا مَالَهَا ، وَمِثْلَهُ مِنْ مَالِكَ بِمَا اسْتَحْلَلْتَ مِنْ فَرْجِهَا ،  فَقَالَ  شُرَيْحٌ  :         [6/215]      هَذَا الَّذِي بَلَغَنَا عَنْهُ ، هُوَ قَضَائِي بَيْنَكُمَا قُومَا  » .","","Sunan Sa'id ibn Mansur 674","","علي بن أبي طالب عن عبد الأعلى بن عامر الثعلبي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1852","675  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ «  أَنَّهُ كَانَ يَرَى :  تَزْوِيجَ الرَّجُلِ الْمَرْأَةَ عَلَى أَنْ يُحِجَّهَا جَائِزٌ  ، فَإِنْ طَلَّقَهَا قَبْلَ أَنْ يَدْخُلَ بِهَا فَلَهَا نِصْفُ مَا يَحُجُّ بِهِ مِثْلُهَا  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : كذا في ص .","","Sunan Sa'id ibn Mansur 675","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1853","676  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ «  أَنَّهُ كَانَ يَرَى  النِّكَاحَ عَلَى الْبَيْتِ وَالْخَادِمِ جَائِزٌ  »  .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : كذا في ص .","","Sunan Sa'id ibn Mansur 676","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1854","677  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ قَالَ : «  لَا بَأْسَ أَنْ يَتَزَوَّجَ الرَّجُلُ عَلَى الْبَيْتِ وَالْخَادِمِ  » .","","Sunan Sa'id ibn Mansur 677","","إبراهيم النخعي عن حماد بن أبي سليمان عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1855","678  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ قَالَ :  أَخْبَرَنِي  عُثْمَانُ بْنُ عَبْدِ اللهِ بْنِ أَبِي عَتِيقٍ ،  أَنَّ رَجُلًا تَزَوَّجَ امْرَأَةً وَشَرَطَ لَهَا دَارًا فَأَعْطَاهَا الْعُهُودَ وَالْمَوَاثِيقَ ، فَاخْتَصَمُوا إِلَى  سَعْدِ بْنِ إِبْرَاهِيمَ  ،  فَسَأَلَ  الْقَاسِمَ وَسَالِمَ بْنَ عَبْدِ اللهِ فَقَالَا : «  لَا يَنْبَغِي لِعُهُودِ اللهِ عَزَّ وَجَلَّ أَنْ تُتَخَطَّى  »  .","","Sunan Sa'id ibn Mansur 678","","سالم بن عبد الله بن عمر بن الخطاب عن عثمان بن عبد الله بن أبي عتيق عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1856","679  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُبَيْدٍ الْكَلَاعِيِّ ،  عَنْ  مَكْحُولٍ  فِي رَجُلٍ خَطَبَ إِلَى رَجُلٍ  ابْنَتَهُ أَوْ أُخْتَهُ  ، فَقَالَ : لَا أَفْعَلُ إِلَّا أَنْ تُطَلِّقَ امْرَأَتَكَ  ، فَطَلَّقَهَا وَاحِدَةً ثُمَّ تَزَوَّجَ هَذِهِ ، ثُمَّ أَرَادَ أَنْ يُرَاجِعَ الْأُولَى ، قَالَ : « ذَلِكَ لَهُ » قَالَ : وَكَيْفَ إِنْ كَانَ قَالَ الَّذِي أَنْكَحَهُ : إِنَّمَا أَنْكَحْتُكَ عَلَى فِرَاقِ امْرَأَتِكَ ، وَقَالَ الْآخَرُ : إِنَّمَا شَرَطْتُ لَكَ أَنْ أُطَلِّقَهَا فَقَدْ طَلَّقْتُهَا ، وَأَنَا مُرَاجِعُهَا ؟ فَقَالَ  مَكْحُولٌ  : يُرَاجِعُهَا إِنْ شَاءَ  .         [6/216]","","Sunan Sa'id ibn Mansur 679","","مكحول بن أبي مسلم عن عبيد الله بن عبيد الكلاعي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1857","680  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُبَيْدٍ ،  عَنْ  مَكْحُولٍ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ قَالَ فِي رَجُلٍ شَرَطَ لِامْرَأَةٍ دَارَهَا ، فَقَالَ : « لَا يُخْرِجُهَا إِلَّا أَنْ تَشَاءَ  ; لِأَنَّ مَقَاطِعَ الْحُقُوقِ الشُّرُوطُ  »  وَكَانَ  مَكْحُولٌ  يَرَاهُ  .","","Sunan Sa'id ibn Mansur 680","","عمر بن الخطاب عن مكحول بن أبي مسلم عن عبيد الله بن عبيد الكلاعي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب ما جاء في الشرط في النكاح"
"1858","بَابُ تَزْوِيجِ النَّهَارِيَّاتِ .  681  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ  أَنَّهُ كَانَ لَا يَرَى بِتَزْوِيجِ النَّهَارِيَّاتِ بَأْسًا  ،  وَكَانَ ابْنُ سِيرِينَ يَكْرَهُ ذَلِكَ  .","","Sunan Sa'id ibn Mansur 681","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب تزويج النهاريات"
"1859","682  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ  فِي الرَّجُلِ يَتَزَوَّجُ الْمَرْأَةَ ، وَيَجْعَلُ لَهَا مِنَ  الشَّهْرِ  أَيَّامًا مَعْلُومَةً  فَلَمْ يَرَ بِهِ بَأْسًا ،  وَكَانَ ابْنُ سِيرِينَ يَكْرَهُ ذَلِكَ  .","","Sunan Sa'id ibn Mansur 682","","الحسن البصري عن يونس بن عبيد عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب تزويج النهاريات"
"1860","683  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ ، وَعَطَاءٍ  أَنَّهُمَا كَانَا لَا يَرَيَانِ بِتَزْوِيجِ النَّهَارِيَّاتِ بَأْسًا  .","","Sunan Sa'id ibn Mansur 683","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب تزويج النهاريات"
"1861","684  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  مُطَرِّفٌ ،  عَنِ  الْحَكَمِ ، وَحَمَّادٍ «  أَنَّهُمَا كَانَا يَكْرَهَانِ ذَلِكَ  »  .","","Sunan Sa'id ibn Mansur 684","","حماد بن أبي سليمان عن مطرف بن طريف عن هشيم بن بشير عن سعيد بن منصور","باب تزويج النهاريات"
"1862","685  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُطَرِّفٍ ،  عَنِ  الْحَكَمِ ، وَحَمَّادٍ قَالَا : «  هَذَا شَرْطٌ فَاسِدٌ  » .","","Sunan Sa'id ibn Mansur 685","","حماد بن أبي سليمان عن مطرف بن طريف عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب تزويج النهاريات"
"1863","بَابُ الشَّرْطِ عِنْدَ عَقْدِ النِّكَاحِ .  686  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَوْفٌ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ         [6/217]      «  أَنَّهُ كَانَ إِذَا زَوَّجَ بِنْتًا مِنْ بَنَاتِهِ أَوْ مِنْ مَوَالِيهِ ، قَالَ : يَقُولُ :  عَلَيْكَ أَنْ تُمْسِكَ بِمَعْرُوفٍ أَوْ تُسَرِّحَ بِإِحْسَانٍ  »  .","","Sunan Sa'id ibn Mansur 686","","أنس بن مالك عن عوف بن أبي جميلة عن هشيم بن بشير عن سعيد بن منصور","باب الشرط عند عقد النكاح"
"1864","687  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ قَالَ :  كَانَ ابْنُ عُمَرَ إِذَا نَكَحَ  قَالَ  :  أَنَكَحْتُكَ عَلَى مَا أَمَرَ اللهُ تَبَارَكَ وَتَعَالَى إِمْسَاكٌ بِمَعْرُوفٍ أَوْ تَسْرِيحٌ بِإِحْسَانٍ  .","","Sunan Sa'id ibn Mansur 687","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب الشرط عند عقد النكاح"
"1865","688  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  ابْنِ عَجْلَانَ ،  عَنْ  رَجُلٍ حَسِبْتُ أَنَّهُ سُلَيْمَانُ قَالَ :  خَطَبْتُ إِلَى ابْنِ عُمَرَ مَوْلَاةً لَهُ ،  فَقَالَ  :  أُنْكِحُكَ عَلَى مَا أَمَرَ اللهُ عَزَّ وَجَلَّ إِمْسَاكٌ بِمَعْرُوفٍ أَوْ تَسْرِيحٌ بِإِحْسَانٍ  .","","Sunan Sa'id ibn Mansur 688","","عبد الله بن عمر بن الخطاب عن سليمان بن أبي يحيى الحجازي عن محمد بن عجلان عن سفيان بن عيينة عن سعيد بن منصور","باب الشرط عند عقد النكاح"
"1866","689  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْ  سَمِعَ  أَبَا بَكْرِ بْنَ حَفْصٍ يُحَدِّثُ  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ قَالَ :  لَحِقْتُ ابْنَ عُمَرَ فَخَطَبْتُ إِلَيْهِ ابْنَتَهُ  ،  فَقَالَ لِي  : إِنَّ  ابْنَ أَبِي عَبْدِ اللهِ  لَأَهْلٌ أَنْ يُنْكَحَ ، نَحْمَدُ رَبَّنَا وَنُصَلِّي عَلَى نَبِيِّنَا صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقَدْ أَنَكَحْنَاكَ عَلَى مَا أَمَرَ اللهُ عَزَّ وَجَلَّ إِمْسَاكٌ بِمَعْرُوفٍ أَوْ تَسْرِيحٌ بِإِحْسَانٍ  .","","Sunan Sa'id ibn Mansur 689","","عبد الله بن عمر بن الخطاب عن عروة بن الزبير عن عبد الله بن حفص بن عمر بن سعد بن أبي وقاص عن من عن هشيم بن بشير عن سعيد بن منصور","باب الشرط عند عقد النكاح"
"1867","690  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ اللهِ بْنُ وَهْبٍ قَالَ :  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  بُكَيْرِ بْنِ الْأَشَجِّ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ  أَنَّهُ كَانَ يَكْرَهُ أَنْ يَضَعَ الرَّجُلُ يَدَهُ عَلَى امْرَأَةٍ قَدْ نَكَحَهَا  حَتَّى يُسَمِّيَ صَدَاقَهَا أَوْ يُقَدِّمَ شَيْئًا  .","","Sunan Sa'id ibn Mansur 690","","سليمان بن يسار مولى ميمونة زوج رسول الله عن بكير بن عبد الله بن الأشج القرشي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن سعيد بن منصور","باب الشرط عند عقد النكاح"
"1868","[6/218]      بَابُ مَا جَاءَ فِي التَّعَوُّذِ مِنْ  بَوَارِ  الْأَيِّمِ وَغَيْرِ ذَلِكَ .  691  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ اللهِ بْنِ أَبِي مَرْيَمَ قَالَ :  حَدَّثَنِي  حَكِيمُ بْنُ عُمَيْرٍ ، وَضَمْرَةُ بْنُ حَبِيبٍ : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَتَعَوَّذُ مِنْ كَسَادِ الْأَيَامَى  ، وَيَدْعُو لَهُنَّ بِالنَّفَاقِ  .","","Sunan Sa'id ibn Mansur 691","","ضمرة بن حبيب الزبيدي عن أبو بكر الغساني عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب ما جاء في التعوذ من بوار الأيم وغير ذلك"
"1869","692  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  إِسْمَاعِيلُ بْنُ سَالِمٍ قَالَ :  أَنَا  عَبْدُ اللهِ بْنُ ثَابِتٍ الْكِنْدِيُّ  أَنَّ رَجُلًا خَطَبَ إِلَى رَجُلٍ أُخْتَهُ فَزَوَّجَهَا إِيَّاهُ  ، فَأَرْسَلَ إِلَيْهَا بِجُزُرٍ فَقَبِلَتْهَا ، وَقَسَمَتْهَا فِي حَيِّهَا ، ثُمَّ إِنَّهَا أَنْكَرَتِ النِّكَاحَ بَعْدُ ، فَاخْتَصَمُوا إِلَى  شُرَيْحٍ  فَقَالَ  لِلرَّجُلِ  : بَيِّنَتُكَ أَنَّهَا رَضِيَتْ ؟ فَقَالَ : مَا لِي بَيِّنَةٌ إِلَّا أَنَّ أَخَاهَا زَوَّجَنِيهَا ، وَهُوَ مُقِرٌّ بِذَلِكَ ، وَالْجُزُرُ الَّتِي أَهْدَيْتُهَا إِلَيْهَا قَبِلَتْهَا وَقَسَمَتْهَا فِي حَيِّهَا ،  فَقَالَ  شُرَيْحٌ : « لَوْ كُنْتُ قَاضِيًا لِأَحَدٍ بِغَيْرِ بَيِّنَةٍ لَقَضَيْتُ لَكَ ، ثُمَّ اسْتَحْلَفَ  الْمَرْأَةَ  بِاللهِ الَّذِي لَا إِلَهَ إِلَّا هُوَ مَا رَضِيَتْ وَلَا أَذِنَتْ وَلَا أَجَازَتْ ، فَحَلَفَتْ وَضَمَّنَهَا ثَمَنَ الْجُزُرِ  »  .","","Sunan Sa'id ibn Mansur 692","","شريح بن الحارث الكندي عن عبد الله بن ثابت الكندي عن إسماعيل بن سالم الأسدي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في التعوذ من بوار الأيم وغير ذلك"
"1870","بَابُ الْمَرْأَةِ تُزَوَّجُ فِي عِدَّتِهَا .  693  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ قَالَ :  حَدَّثَنِي  عَلِيُّ         [6/219]      بْنُ الْمُبَارَكِ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  زَيْدِ بْنِ نُعَيْمٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ «  أَنَّ  رَجُلًا  تَزَوَّجَ  امْرَأَةً  فَلَمَّا أَصَابَهَا وَجَدَهَا حُبْلَى  ، فَرَفَعَ ذَلِكَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَفَرَّقَ بَيْنَهُمَا ، وَجَعَلَ لَهَا الصَّدَاقَ ، وَجَلَدَهَا مِائَةً  »  .","","Sunan Sa'id ibn Mansur 693","","سعيد بن المسيب عن يزيد بن نعيم بن هزال الأسلمي عن يحيى بن أبي كثير عن علي بن المبارك الهنائي عن عبد الله بن المبارك عن سعيد بن منصور","باب المرأة تزوج في عدتها"
"1871","694  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ  فِي الَّتِي تَزَوَّجَتْ فِي عِدَّتِهَا  قَالَ  : فَرَّقَ عُمَرُ بَيْنَهُمَا  ، وَقَالَ : « كَانَ النِّكَاحُ حَرَامًا ، وَكَانَ الصَّدَاقُ حَرَامًا ، فَجَعَلَ الصَّدَاقَ فِي بَيْتِ الْمَالِ  »  .","","Sunan Sa'id ibn Mansur 694","","عمر بن الخطاب عن مسروق بن الأجدع عن الشعبي عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن سعيد بن منصور","باب المرأة تزوج في عدتها"
"1872","695  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  عُمَرَ أُتِيَ فِي امْرَأَةٍ تَزَوَّجَتْ فِي عِدَّتِهَا فَفَرَّقَ بَيْنَهُمَا وَعَاقَبَهَا  ، وَجَعَلَ الصَّدَاقَ فِي بَيْتِ الْمَالِ عُقُوبَةً لَهَا ، وَقَالَ : « لَا يَجْتَمِعَانِ أَبَدًا  »  .","","Sunan Sa'id ibn Mansur 695","","عمر بن الخطاب عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تزوج في عدتها"
"1873","696  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ ، فَرَّقَ بَيْنَهُمَا فَضَرَبَهُمَا  ، وَقَالَ : « لَا تَعُودُ إِلَيْهِ أَبَدًا ، وَجَعَلَ الصَّدَاقَ فِي بَيْتِ الْمَالِ  »  .","","Sunan Sa'id ibn Mansur 696","","عمر بن الخطاب عن الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تزوج في عدتها"
"1874","697  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَشْعَثُ بْنُ سَوَّارٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ « رَجَعَ عَنْ قَوْلِهِ فِي الصَّدَاقِ  ،         [6/220]      وَجَعَلَهُ لَهَا بِمَا اسْتَحَلَّ مِنْ فَرْجِهَا  »  .","","Sunan Sa'id ibn Mansur 697","","عمر بن الخطاب عن مسروق بن الأجدع عن الشعبي عن أشعث بن سوار عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تزوج في عدتها"
"1875","698  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ  أَنَّ  عُمَرَ قَالَ لِلَّتِي نَكَحَتْ فِي عِدَّتِهَا ، فَرَّقَ بَيْنَهُمَا  ، وَقَالَ : « لَا يَتَنَاكَحَانِ أَبَدًا وَجَعَلَ لَهَا الْمَهْرَ بِمَا اسْتَحَلَّ مِنْ فَرْجِهَا ، وَأَمَرَهَا أَنَّ تَعْتَدَّ مِنْ هَذَا وَتَعْتَدَّ مِنْ هَذَا  »  .","","Sunan Sa'id ibn Mansur 698","","عمر بن الخطاب عن سليمان بن يسار مولى ميمونة زوج رسول الله عن أبو الزناد عن سفيان بن عيينة عن سعيد بن منصور","باب المرأة تزوج في عدتها"
"1876","699  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُحَمَّدُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ  أَنَّ  عَلِيًّا ، رَضِيَ اللهُ عَنْهُ « فَرَّقَ بَيْنَهُمَا وَجَعَلَ لَهَا الصَّدَاقَ  بِمَا اسْتَحَلَّ مِنْ فَرْجِهَا ، وَقَالَ : إِذَا انْقَضَتْ عِدَّتُهَا إِنْ شَاءَتْ تَزَوَّجَتْهُ فَعَلَتْ  ، قَالَ  هُشَيْمٌ  :  وَهُوَ الْقَوْلُ عِنْدَنَا  »  .","","Sunan Sa'id ibn Mansur 699","","علي بن أبي طالب عن الشعبي عن محمد بن سالم الهمداني عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تزوج في عدتها"
"1877","700  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ قَالَ :  قَالَ  إِبْرَاهِيمُ : «  يُفَرَّقُ بَيْنَهُمَا ، وَيَتَزَوَّجُهَا الْآخَرُ  ، ثُمَّ تُكْمِلُ مَا بَقِيَ مِنْ عِدَّتِهَا مِنَ الْأَوَّلِ ثُمَّ تَعْتَدُّ مِنَ الْآخَرِ » .  وَقَالَ  الشَّعْبِيُّ : «  تَعْتَدُّ مِنْ هَذَا الْآخَرِ  ثُمَّ تَعْتَدُّ بَقِيَّةَ عِدَّتِهَا مِنَ الْأَوَّلِ  » .         [6/221]","","Sunan Sa'id ibn Mansur 700","","إبراهيم النخعي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تزوج في عدتها"
"1878","701  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  إِبْرَاهِيمَ ، وَالشَّعْبِيِّ ، قَالَ :  كَانَ بَيْنَهُمَا فَقَالَ أَحَدُهُمَا : « تَعْتَدُّ مِنَ الْأَوَّلِ »  ، وَقَالَ الْآخَرُ : « تَبْدَأُ مِنَ الْآخَرِ » . فَقَالَ  إِبْرَاهِيمُ  : « إِنَّكَ إِذَا اسْتٌ ؟؟ اتَتْ  »  .","","Sunan Sa'id ibn Mansur 701","","الشعبي عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن سعيد بن منصور","باب المرأة تزوج في عدتها"
"1879","702  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  نَا  ابْنُ شُبْرُمَةَ ، قَالَ :  سَمِعْتُ  الشَّعْبِيَّ ، سُئِلَ عَنْ  رَجُلٍ طَلَّقَ امْرَأَتَهُ فَتَزَوَّجَتْ فِي عِدَّتِهَا فَأَيُّ الْعِدَّتَيْنِ تَبْدَأُ ؟  فَقَالَ  الشَّعْبِيُّ  « تَبْدَأُ بِالْعِدَّةِ مِنْ أَحْدَثِهِمَا بِهَا عَهْدًا  »  .","","Sunan Sa'id ibn Mansur 702","","الشعبي عن عبد الله بن شبرمة عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تزوج في عدتها"
"1880","703  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  بَعْضُ الْكُوفِيِّينَ ،  أَنَّهُ قَالَ لِإِبْرَاهِيمَ حَيْثُ قَالَ : « تَبْدَأُ بِالْعِدَّةِ مِنَ الْأَوَّلِ  ، أَرَأَيْتَ إِنْ كَانَتْ حَامِلًا مِنَ الْآخَرِ ، فَسَكَتَ  إِبْرَاهِيمُ  فَمَا أَجَابَهُ  »  .","","Sunan Sa'id ibn Mansur 703","","إبراهيم النخعي عن بعض الكوفيين عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تزوج في عدتها"
"1881","بَابُ مَا جَاءَ فِي الْمَرْأَةِ غَابَ عَنْهَا زَوْجُهَا فَتَزَوَّجَتْ بَعْدَهُ .  704  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ، قَالَ :  نَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  أَبِي مَعْشَرٍ ،  عَنْ  إِبْرَاهِيمَ أَنَّهُ كَانَ يَقُولُ : «  إِذَا دَخَلَتْ عِدَّتَانِ فِي  عِدَّةٍ  أَجْزَأَتْهَا إِحْدَاهُمَا  » .","","Sunan Sa'id ibn Mansur 704","","إبراهيم النخعي عن زياد بن كليب عن سعيد بن أبي عروبة عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في المرأة غاب عنها زوجها فتزوجت بعده"
"1882","705  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ  فِي رَجُلٍ غَابَ عَنِ امْرَأَتِهِ ، فَتَزَوَّجَتْ ثُمَّ جَاءَ الْأَوَّلُ  ، فَقَالَ : « تَعْتَدُّ  عِدَّةً  وَاحِدَةً  » .         [6/222]","","Sunan Sa'id ibn Mansur 705","","إبراهيم النخعي عن منصور بن المعتمر عن الفضيل بن عياض عن سعيد بن منصور","باب ما جاء في المرأة غاب عنها زوجها فتزوجت بعده"
"1883","706  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  فُضَيْلٌ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الْحَكَمِ قَالَ : «  عِدَّتَانِ  »  .","","Sunan Sa'id ibn Mansur 706","","الحكم بن عتيبة الكندي عن منصور بن المعتمر عن الفضيل بن عياض عن سعيد بن منصور","باب ما جاء في المرأة غاب عنها زوجها فتزوجت بعده"
"1884","707  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ  فِي امْرَأَةٍ نُعِيَ لَهَا زَوْجُهَا فَتَزَوَّجَتْ ، ثُمَّ جَاءَ خَبَرٌ أَنَّ زَوْجَهَا الْأَوَّلَ حَيٌّ  ، فَلَمَّا بَلَغَ زَوْجَهَا الْأَوَّلَ طَلَّقَهَا ثَلَاثًا ، فَقَالَ : « طَلَاقُهُ إِيَّاهَا اخْتِيَارٌ تَعْتَزِلُ هَذَا الْآخَرَ ثَلَاثَةَ  أَقْرَاءٍ  ، ثُمَّ تَزَوَّجُ مَنْ شَاءَتْ ، وَإِنْ كَانَتْ حَامِلًا فَوَضْعُهَا حَمْلَهَا قُرْؤُهَا ، ثُمَّ تَعْتَدُّ بَعْدَ ذَلِكَ حَيْضَتَيْنِ  »  .","","Sunan Sa'id ibn Mansur 707","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب ما جاء في المرأة غاب عنها زوجها فتزوجت بعده"
"1885","708  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ  فِي رَجُلٍ غَابَ عَنِ امْرَأَتِهِ ، فَتَزَوَّجَتِ امْرَأَتُهُ  ، فَقَدِمَ زَوْجُهَا قَالَ : « تَعْتَدُّ مِنَ الْآخَرِ ، ثُمَّ تُدْفَعُ إِلَى الْأَوَّلِ  » .","","Sunan Sa'id ibn Mansur 708","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في المرأة غاب عنها زوجها فتزوجت بعده"
"1886","709  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ قَالَ لِلَّتِي تَزَوَّجَتْ فِي عِدَّتِهَا : « يُفَرَّقُ بَيْنَهُمَا  ، وَتُكْمِلُ مَا بَقِيَ مِنْ عِدَّتِهَا مِنَ الْأَوَّلِ ، ثُمَّ تَعْتَدُّ مِنَ الْآخَرِ  » .","","Sunan Sa'id ibn Mansur 709","","عمر بن الخطاب عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في المرأة غاب عنها زوجها فتزوجت بعده"
"1887","710  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ  فِي امْرَأَةٍ نُعِيَ إِلَيْهَا زَوْجُهَا ، فَتَزَوَّجَتْ رَجُلًا مِنْ بَعْدِهِ ، فَمَاتَ فَوَرِثَتْهُ  ، فَقَدِمَ زَوْجُهَا الْأَوَّلُ ، قَالَ : « تُدْفَعُ إِلَيْهِ وَتَرُدُّ إِلَى وَرَثَةِ الْمَيِّتِ مَا أَخَذَتْ مِنْ مِيرَاثِهِ  » .         [6/223]","","Sunan Sa'id ibn Mansur 710","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في المرأة غاب عنها زوجها فتزوجت بعده"
"1888","711  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْوَلِيدِ بْنِ أَبِي هَاشِمٍ ،  أَنَّ امْرَأَةً تُوُفِّيَ عَنْهَا زَوْجُهَا ، ثُمَّ تَزَوَّجَتْ ، فَوَضَعَتْ عِنْدَ  زَوْجِهَا  لِأَرْبَعَةِ أَشْهُرٍ فَأَنْكَرَ ذَلِكَ  الزَّوْجُ  ، فَرُفِعَ إِلَى عُمَرَ بْنِ الْخَطَّابِ ، وَسَأَلَ  الْمَرْأَةَ  فَقَالَتْ : « وَاللهِ مَا كَانَ بَيْنَهُمَا رَجُلٌ ، وَلَكِنَّ زَوْجِي كَانَ عَهْدُهُ بِي قَبْلَ وَفَاتِهِ بِخَمْسَةَ عَشَرَ يَوْمًا ، فَهَلَكَ وَكُنْتُ أَرَى الدَّمَ ، فَسَأَلَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ نِسَاءً مِنْ نِسَاءِ الْجَاهِلِيَّةِ ، فَقُلْنَ : إِنَّ هَذَا يَكُونُ ، فَفَرَّقَ بَيْنَهُمَا وَجَعَلَ الْوَلَدَ لِلْأَوَّلِ  » .","","Sunan Sa'id ibn Mansur 711","","عمر بن الخطاب عن الوليد بن هشام الهمداني عن يونس بن عبيد عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في المرأة غاب عنها زوجها فتزوجت بعده"
"1889","بَابُ مَا جَاءَ فِي الْمَرْأَةِ تُزَوَّجُ عَبْدَهَا .  712  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ، قَالَ :  أُتِيَ عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ بِامْرَأَةٍ تَزَوَّجَتْ عَبْدَهَا  فَقَالَ  : « مَا حَمَلَكِ عَلَى هَذَا ؟ قَالَتْ : هُوَ مِلْكُ يَمِينِي ، أَوَلَيْسَ قَدْ أَحَلَّ اللهُ مِلْكَ الْيَمِينِ ؟ فَأَمَرَ بِهَا  عُمَرُ  رَضِيَ اللهُ عَنْهُ فَضُرِبَتْ ، وَأُتِيَ بِامْرَأَةٍ تَزَوَّجَتْ بِغَيْرٍ بَيِّنَةٍ فَضَرَبَهَا ، وَكَتَبَ إِلَى أَهْلِ الْأَمْصَارِ يَنْهَاهُمْ عَنْ ذَلِكَ  » .","","Sunan Sa'id ibn Mansur 712","","عمر بن الخطاب عن بكر بن عبد الله المزني عن حصين بن عبد الرحمن السلمي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في المرأة تزوج عبدها"
"1890","713  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حُصَيْنٌ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ أُتِيَ بِامْرَأَةٍ قَدْ تَزَوَّجَتْ عَبْدًا لَهَا فَضَرَبَهُمَا وَفَرَّقَ بَيْنَهُمَا  . فَقَالَتِ الْمَرْأَةُ : « أَلَيْسَ اللهُ عَزَّ وَجَلَّ يَقُولُ فِي كِتَابِهِ :         {      أَوْ مَا مَلَكَتْ أَيْمَانُكُمْ         }      ؟ وَكَتَبَ إِلَى أَهْلِ الْأَمْصَارِ : أَيُّ امْرَأَةٍ تَزَوَّجَتْ عَبْدَهَا أَوْ تَزَوَّجَتْ بِغَيْرِ بَيِّنَةٍ أَوْ وَلِيٍّ ، فَاضْرِبُوهَا  الْحَدَّ  » .         [6/224]","","Sunan Sa'id ibn Mansur 713","","عمر بن الخطاب عن بكر بن عبد الله المزني عن حصين بن عبد الرحمن السلمي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في المرأة تزوج عبدها"
"1891","714  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ « أُتِيَ بِامْرَأَةٍ تَزَوَّجَتْ عَبْدَهَا فَعَاقَبَهَا وَفَرَّقَ بَيْنَهَا وَبَيْنَ عَبْدِهَا  ، وَحَرَّمَ عَلَيْهَا الْأَزْوَاجَ عُقُوبَةً لَهَا  »  .","","Sunan Sa'id ibn Mansur 714","","عمر بن الخطاب عن الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في المرأة تزوج عبدها"
"1892","بَابُ نِكَاحِ الْيَهُودِيَّةِ وَالنَّصْرَانِيَّةِ .  715  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عِيسَى بْنُ يُونُسَ قَالَ :  نَا  أَبُو بَكْرِ بْنُ عَبْدِ اللهِ بْنِ أَبِي مَرْيَمَ الْغَسَّانِيُّ ،  عَنْ  عَلِيِّ بْنِ [ أَبِي ] طَلْحَةَ ،  عَنْ  كَعْبِ بْنِ مَالِكٍ  أَنَّهُ أَرَادَ أَنْ يَتَزَوَّجَ يَهُودِيَّةً أَوْ نَصْرَانِيَّةً ، فَسَأَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَنَهَاهُ ، وَقَالَ : «  إِنَّهَا لَا تُحْصِنُكَ  » .","","Sunan Sa'id ibn Mansur 715","","كعب بن مالك الأنصاري عن علي بن أبي طلحة العباسي عن أبو بكر الغساني عن عيسى بن يونس بن أبي إسحاق عن سعيد بن منصور","باب نكاح اليهودية والنصرانية"
"1893","716  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  الصَّلْتِ بْنِ بَهْرَامٍ ،  سَمِعَ  أَبَا وَائِلٍ شَقِيقَ بْنَ سَلَمَةَ يَقُولُ :  تَزَوَّجَ  حُذَيْفَةُ  يَهُودِيَّةً  فَكَتَبَ إِلَيْهِ  عُمَرُ : طَلِّقْهَا  ، فَكَتَبَ إِلَيْهِ : لِمَ ؟ أَحَرَامٌ هِيَ ؟ فَكَتَبَ إِلَيْهِ : « لَا وَلَكِنِّي خِفْتُ أَنْ تَعَاطَوُا  الْمُومِسَاتِ  مِنْهُنَّ  » .","","Sunan Sa'id ibn Mansur 716","","عمر بن الخطاب عن شقيق بن سلمة عن الصلت بن بهرام التيمي عن سفيان بن عيينة عن سعيد بن منصور","باب نكاح اليهودية والنصرانية"
"1894","717  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  مُغِيرَةُ قَالَ :  نَا  الشَّعْبِيُّ قَالَ :         [6/225]      «  تَزَوَّجَ أَحَدُ السِّتَّةِ مِنْ أَصْحَابِ الشُّورَى يَهُودِيَّةً  ، فَقُلْتُ لَهُ :  الزُّبَيْرُ  هُوَ ؟ قَالَ  الشَّعْبِيُّ  : إِنْ كَانَ لَكَرِيمَ الْمَنَاكَحِ  » .","","Sunan Sa'id ibn Mansur 717","","أحد الصحابة عن الشعبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب نكاح اليهودية والنصرانية"
"1895","718  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ  أَنَا  ابْنُ عَوْنٍ ،  عَنِ  ابْنِ سِيرِينَ ،  أَنَّ  حُذَيْفَةَ  تَزَوَّجَ يَهُودِيَّةً  فَقَالَ لَهُ  عُمَرُ فِي ذَلِكَ  ، فَقَالَ : أَحَرَامٌ هِيَ ؟ قَالَ : « لَا ، وَلَكِنَّكَ سَيِّدُ الْمُسْلِمِينَ فَفَارَقَهَا  » .","","Sunan Sa'id ibn Mansur 718","","عمر بن الخطاب عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن هشيم بن بشير عن سعيد بن منصور","باب نكاح اليهودية والنصرانية"
"1896","719  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ قَالَ  أَنَا  يُونُسُ  عَنِ  الْحَسَنِ  أَنَّهُ كَانَ لَا يَرَى بَأْسًا أَنْ يَتَزَوَّجَ الْيَهُودِيَّةَ وَالنَّصْرَانِيَّةَ عَلَى الْمُسْلِمَةِ  قَالَ : وَالْقَسْمُ بَيْنَهُمَا سَوِيٌّ  .","","Sunan Sa'id ibn Mansur 719","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب نكاح اليهودية والنصرانية"
"1897","720  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  مُطَرِّفٌ ،  عَنِ  الشَّعْبِيِّ ، وَعُبَيْدَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَا : «  إِذَا تَزَوَّجَ الْيَهُودِيَّةَ وَالنَّصْرَانِيَّةَ عَلَى الْمُسْلِمَةِ فَالْقَسْمُ بَيْنَهُمَا سَوَاءٌ  وَإِنْ قَذَفَهَا لَمْ يُلَاعِنْهَا  » .","","Sunan Sa'id ibn Mansur 720","","إبراهيم النخعي عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب نكاح اليهودية والنصرانية"
"1898","721  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  مَنْصُورٌ ، وَيُونُسُ ،  عَنِ  الْحَسَنِ قَالَ : «  بَيْنَ كُلِّ زَوْجَيْنِ مُلَاعَنَةٌ  »  .","","Sunan Sa'id ibn Mansur 721","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب نكاح اليهودية والنصرانية"
"1899","بَابُ نِكَاحِ الْأَمَةِ عَلَى الْحُرَّةِ وَالْحُرَّةِ عَلَى الْأَمَةِ .  722  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ، قَالَ :         [6/226]      سَمِعْتُ  ابْنَ الْمُسَيِّبِ ، يَقُولُ : «  تُنْكَحُ الْحُرَّةُ عَلَى الْأَمَةِ  ، وَلَا تُنْكَحُ الْأَمَةُ عَلَى الْحُرَّةِ ، وَيُقْسَمُ بَيْنَهُمَا الثُّلُثُ لِلْأَمَةِ ، وَالثُّلْثَانِ لِلْحُرَّةِ  »  .","","Sunan Sa'id ibn Mansur 722","","سعيد بن المسيب عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1900","723  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  عَبْدُ الْمَلِكِ ،  عَنْ  عَطَاءٍ قَالَ : «  تُنْكَحُ الْحُرَّةُ عَلَى الْأَمَةِ  وَلَا تُنْكَحُ الْأَمَةُ عَلَى الْحُرَّةِ ، وَيُقْسَمُ لِلْأَمَةِ إِذَا تَزَوَّجَ عَلَيْهَا الْحُرَّةَ الثُّلُثَ ، وَلِلْحُرَّةِ الثُّلُثَانِ  » .","","Sunan Sa'id ibn Mansur 723","","عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن هشيم بن بشير عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1901","724  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ : «  تُنْكَحُ الْحُرَّةُ عَلَى الْأَمَةِ وَلَا تُنْكَحُ الْأَمَةُ عَلَى الْحُرَّةِ إِلَّا أَنْ تَشَاءَ هِيَ ذَلِكَ  » .","","Sunan Sa'id ibn Mansur 724","","سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1902","725  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  ابْنُ أَبِي لَيْلَى ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  زِرٍّ ، وَعَبَّادِ بْنِ عَبْدِ اللهِ الْأَسَدِيِّ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ ، رَضِيَ اللهُ عَنْهُ أَنَّهُ كَانَ يَقُولُ : «  إِذَا تَزَوَّجَ الْحُرَّةَ عَلَى الْأَمَةِ فَقَسَمَ بَيْنَهُمَا  : لِلْأَمَةِ الثُّلُثُ وَلِلْحُرَّةِ الثُّلُثَانِ  » .","","Sunan Sa'id ibn Mansur 725","","علي بن أبي طالب عن عباد بن عبد الله الأسدي عن المنهال بن عمرو الأسدي عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1903","726  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ  أَنَّهُ كَانَ يَكْرَهُ نِكَاحَ الْإِمَاءِ فِي زَمَانِهِ  ، وَقَالَ : « إِنَّمَا رُخِّصَ فِيهِنَّ إِذَا لَمْ يَجِدْ طَوْلًا لِلْحُرَّةِ  » .         [6/227]","","Sunan Sa'id ibn Mansur 726","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1904","727  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 727","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1905","728  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَبُو بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  فِي قَوْلِهِ عَزَّ وَجَلَّ         {      وَمَنْ لَمْ يَسْتَطِعْ مِنْكُمْ طَوْلا         }      قَالَ : « الطَّوْلُ : الْغَنَاءُ  ، إِذَا لَمْ يَجِدْ مَا يَنْكِحُ بِهِ الْحُرَّةَ ، تَزَوَّجَ أَمَةً  »  .","","Sunan Sa'id ibn Mansur 728","","سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن هشيم بن بشير عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1906","729  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا تَزَوَّجَ الْحُرَّةَ عَلَى الْأَمَةِ فَأَحَبُّ إِلَيَّ أَنْ يُفَارِقَ الْأَمَةَ  ، إِلَّا أَنْ يَخَافَ  الْعَنَتَ  ، فَإِنْ خَافَ  الْعَنَتَ  أَمْسَكَهَا ، وَقَسَمَ لَهَا الثُّلُثَ ، وَلِلْحُرَّةِ الثُّلُثَيْنِ مِنْ نَفْسِهِ وَمَالِهِ  »  .","","Sunan Sa'id ibn Mansur 729","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1907","730  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  نَا  عُبَيْدَةُ ،  عَنِ  الشَّعْبِيِّ قَالَ :  قَالَ لِي : « هَلْ تَدْرِي مَا  الْعَنَتُ  ؟ »  قُلْتُ : وَمَا هَذَا ؟ قَالَ : « الزِّنَا  » .","","Sunan Sa'id ibn Mansur 730","","الشعبي عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1908","731  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، وَجُوَيْبِرٍ ،  عَنِ  الضَّحَّاكِ ، أَنَّهُمَا قَالَا : «  الْعَنَتُ  : الزِّنَا  »  .","","Sunan Sa'id ibn Mansur 731","","الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن هشيم بن بشير عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1909","732  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  أَبُو بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ قَالَ : «  مَا  ازْلَحَفَّ  نَاكِحُ الْأَمَةِ عَنِ الزِّنَا إِلَّا قَلِيلًا         {      وَأَنْ تَصْبِرُوا خَيْرٌ لَكُمْ         }      قَالَ : عَنْ نِكَاحِ الْإِمَاءِ  » .         [6/228]","","Sunan Sa'id ibn Mansur 732","","سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن هشيم بن بشير عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1910","733  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  أَنَا  هُشَيْمٌ قَالَ :  أَنَا  ابْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ، قَالَ : «  إِذَا تَزَوَّجَ الْحُرَّةَ عَلَى الْأَمَةِ فَهُوَ طَلَاقُ الْأَمَةِ  ، هُوَ كَصَاحِبِ الْمَيْتَةِ يَأْكُلُ مِنْهَا مَا اضْطُرَّ إِلَيْهَا ، فَإِذَا اسْتَغْنَى عَنْهَا فَلْيُمْسِكْ  »  .","","Sunan Sa'id ibn Mansur 733","","مسروق بن الأجدع عن الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1911","734  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ  فِي نِكَاحِ الْحُرَّةِ عَلَى الْأَمَةِ  ، قَالَ : « هِيَ كَالْمَيْتَةِ تُضْطَرُّ إِلَيْهَا ، فَإِذَا أَغْنَاكَ اللهُ عَنْهَا فَاسْتَغْنِ  »  .","","Sunan Sa'id ibn Mansur 734","","مسروق بن الأجدع عن الشعبي عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1912","735  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُطَرِّفٌ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ أَنَّهُ كَانَ يَقُولُ : «  إِذَا تَزَوَّجَ الْحُرَّةَ عَلَى الْأَمَةِ فَهُوَ طَلَاقُ الْأَمَةِ  ، وَلَا يَجْتَمِعَانِ إِلَّا لِمَمْلُوكٍ  » .","","Sunan Sa'id ibn Mansur 735","","مسروق بن الأجدع عن الشعبي عن مطرف بن طريف عن هشيم بن بشير عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1913","736  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ  أَنَّهُ كَانَ يَقُولُ فِي الْعَبْدِ : « إِذَا كَانَتْ عِنْدَهُ حُرَّةٌ ، فَإِنْ شَاءَ تَزَوَّجَ عَلَيْهَا أَمَةً  »  .","","Sunan Sa'id ibn Mansur 736","","مسروق بن الأجدع عن الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1914","737  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ، وَسَيَّارٌ ،  عَنِ  الشَّعْبِيِّ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا وَجَدَ طَوْلًا لِلْحُرَّةِ حُرِّمَتْ عَلَيْهِ الْأَمَةُ  » .","","Sunan Sa'id ibn Mansur 737","","الشعبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1915","738  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،         [6/229]      عَنْ  عَبَّادٍ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ : «  إِذَا تَزَوَّجَ الْحُرَّةَ عَلَى الْأَمَةِ فَلَهَا الثُّلُثَانِ وَلِلْأَمَةِ الثُّلُثِ  » .","","Sunan Sa'id ibn Mansur 738","","علي بن أبي طالب عن عباد بن عبد الله الأسدي عن المنهال بن عمرو الأسدي عن محمد بن عبد الرحمن بن أبي ليلى عن سفيان بن عيينة عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1916","739  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  قَالَ  عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ : «  أَيُّمَا  حُرٍّ  تَزَوَّجَ أَمَةً فَقَدْ أَرَقَّ نِصْفَهُ  ، وَأَيُّمَا عَبْدٍ تَزَوَّجَ حُرَّةً ، فَقَدْ أَعْتَقَ نِصْفَهُ  » .","","Sunan Sa'id ibn Mansur 739","","عمر بن الخطاب عن سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1917","740  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عُمَرَ ، مِثْلَهُ .","","Sunan Sa'id ibn Mansur 740","","عمر بن الخطاب عن سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن حماد بن زيد عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1918","741  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، قَالَ :  حَدَّثَنِي  مَنْ  سَمِعَ  الْحَسَنَ ، يَقُولُ : «  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ تُنْكَحَ الْأَمَةُ عَلَى الْحُرَّةِ  » .","","Sunan Sa'id ibn Mansur 741","","الحسن البصري عن من عن إسماعيل ابن علية عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1919","742  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  أَنَّ  ابْنَ عَبَّاسٍ ، قَالَ : «  نِكَاحُ الْحُرَّةِ عَلَى الْأَمَةِ طَلَاقُهَا  »  .","","Sunan Sa'id ibn Mansur 742","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1920","743  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ، قَالَ :  أَخْبَرَنِي  أَبِي  ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ، أَنَّهُ قَالَ : «  مِنَ السُّنَّةِ أَنَّ الْمَرْأَةَ الْحُرَّةَ إِذَا كَانَ الرَّجُلُ يَنْكِحُ عَلَيْهَا [ الْأَمَةَ ] ، فَهِيَ بِالْخِيَارِ إِنْ شَاءَتْ فَارَقَتْهُ  ، وَإِنْ شَاءَتْ أَقَامَتْ ، وَإِنْ أَقَامَتْ عَلَى ضِرَارٍ فَلَهَا يَوْمَانِ ، وَلِلْأَمَةِ يَوْمٌ  »  .","","Sunan Sa'id ibn Mansur 743","","سليمان بن يسار مولى ميمونة زوج رسول الله عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سعيد بن منصور","باب نكاح الأمة على الحرة والحرة على الأمة"
"1921","[6/230]      بَابُ مَا جَاءَ فِي الرَّجُلِ يَتَزَوَّجُ الْمَرْأَةَ فَيَدْخُلُ بِهَا قَبْلَ أَنْ يَفْرِضَ شَيْئًا .  744  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  مَنْصُورٍ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  خَيْثَمَةَ ، قَالَ  جَرِيرٌ  : أُرَاهُ  عَنْ  عَائِشَةَ ، رَضِيَ اللهُ عَنْهَا قَالَتْ : «  إِنَّ  رَجُلًا مِنَ الْمُسْلِمِينَ  لَيْسَ لَهُ شَيْءٌ تَزَوَّجَ  امْرَأَةً  فَأَمَرَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ تَدْخُلَ عَلَيْهِ  امْرَأَتُهُ  ، وَأَوْصَاهُمْ خَيْرًا ، فَأَصَابَ  الرَّجُلُ  بَعْدُ حَتَّى صَارَ مِنْ أَشْرَافِ النَّاسِ  » .","","Sunan Sa'id ibn Mansur 744","","عائشة بنت أبي بكر الصديق عن خيثمة بن عبد الرحمن الجعفي عن طلحة بن مصرف الهمداني عن منصور بن المعتمر عن جرير بن عبد الحميد عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فيدخل بها قبل أن يفرض شيئا"
"1922","745  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ قَالَ :  نَا  حَجَّاجٌ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  خَيْثَمَةَ ،  أَنَّ  رَجُلًا مِنَ الْأَنْصَارِ  تَزَوَّجَ فَقَالُوا : يَا رَسُولَ اللهِ إِنَّهُ فَقِيرٌ وَلَيْسَ عِنْدَهُ شَيْءٌ أَفَنُدْخِلُهَا عَلَيْهِ وَلَمْ يُعْطِهَا شَيْئًا مِنْ صَدَاقِهَا ؟ قَالَ : «  نَعَمْ أَدْخِلُوهَا عَلَيْهِ  » .","","Sunan Sa'id ibn Mansur 745","","خيثمة بن عبد الرحمن الجعفي عن طلحة بن مصرف الهمداني عن حجاج بن أرطاة عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فيدخل بها قبل أن يفرض شيئا"
"1923","746  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَبُو حَمْزَةَ عِمْرَانُ بْنُ أَبِي عَطَاءٍ قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ - وَسَأَلَهُ رَجُلٌ فَقَالَ : إِنَّهُ تَزَوَّجَ امْرَأَةً وَأَنَّهُ أَعْسَرَ عَنْ صَدَاقِهَا  - فَقَالَ : « إِنْ لَمْ تَجِدْ إِلَّا إِحْدَى نَعْلَيْكَ فَأَعْطِهَا إِيَّاهَا وَادْخُلْ بِهَا  »  .         [6/231]","","Sunan Sa'id ibn Mansur 746","","عبد الله بن عباس عن عمران بن أبي عطاء القصاب عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فيدخل بها قبل أن يفرض شيئا"
"1924","747  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  حَجَّاجٌ ،  عَنِ  الرُّكَيْنِ بْنِ الرَّبِيعِ ،  عَنْ  أَبِيهِ  أَنَّهُ «  تَزَوَّجَ فُلَانُ بْنُ هُرْمُزَ  لَيْلَى بِنْتَ الْعَجْمَاءِ  فِي زَمَنِ  عُمَرَ بْنِ الْخَطَّابِ  رَضِيَ اللهُ عَنْهُ عَلَى أَرْبَعَةِ آلَافٍ  ، ثُمَّ دَخَلَ بِهَا قَبْلَ أَنْ يُعْطِيَهَا مِنْ صَدَاقِهَا شَيْئًا  » .","","Sunan Sa'id ibn Mansur 747","","الربيع بن عميلة الفزاري عن ركين بن الربيع الفزاري عن حجاج بن أرطاة عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فيدخل بها قبل أن يفرض شيئا"
"1925","748  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  عِمْرَانَ بْنِ أَبِي عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّهُ : « يَكْرَهُ أَنْ يَدْخُلَ ، بِامْرَأَتِهِ حَتَّى يُعْطِيَهَا شَيْئًا  »  .","","Sunan Sa'id ibn Mansur 748","","عبد الله بن عباس عن عمران بن أبي عطاء القصاب عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فيدخل بها قبل أن يفرض شيئا"
"1926","749  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حَجَّاجٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  أَنَّ  كُرَيْبَ بْنَ أَبِي مُسْلِمٍ ، وَكَانَ مِنْ أَصْحَابِ  عَبْدِ اللهِ  ، « تَزَوَّجَ امْرَأَةً عَلَى أَرْبَعَةِ آلَافٍ  فَدَخَلَ بِهَا قَبْلَ أَنْ يُعْطِيَهَا شَيْئًا  » .","","Sunan Sa'id ibn Mansur 749","","كريب بن أبي مسلم الحجازي عن أبو إسحاق السبيعي عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فيدخل بها قبل أن يفرض شيئا"
"1927","750  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  حَجَّاجٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  كُرَيْبِ بْنِ هِشَامٍ  ، وَكَانَ مِنْ أَصْحَابِ  عَبْدِ اللهِ  ، «  أَنَّهُ تَزَوَّجَ امْرَأَةً عَلَى أَرْبَعَةِ آلَافٍ  ، ثُمَّ دَخَلَ بِهَا قَبْلَ أَنْ يُعْطِيَهَا مِنْ صَدَاقِهَا شَيْئًا  »  .         [6/232]      كذا في طبعة الدار طبعة الدار السلفية بالهند ، ولعل الصواب كريب الهاشمي وينظر مصادر التخريج .","","Sunan Sa'id ibn Mansur 750","","كريب بن أبي مسلم الحجازي عن أبو إسحاق السبيعي عن حجاج بن أرطاة عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فيدخل بها قبل أن يفرض شيئا"
"1928","751  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  وَأَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ «  أَنَّهُمَا كَانَا لَا يَرَيَانِ بَأْسًا أَنْ يَدْخُلَ الرَّجُلُ بِامْرَأَتِهِ قَبْلَ أَنْ يُعْطِيَهَا شَيْئًا  » .","","Sunan Sa'id ibn Mansur 751","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فيدخل بها قبل أن يفرض شيئا"
"1929","752  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ ، قَالَ : «  كَانَتِ الْمَرْأَةُ مِنْ  أَهْلِ الْمَدِينَةِ  إِذَا تَزَوَّجَتْ أَرْسَلَتْ إِلَى زَوْجِهَا : أَنْ بِتْ عِنْدَنَا لِكَيْ أَسْتَوْجِبَ الصَّدَاقَ  ، وَذَلِكَ قَبْلَ أَنْ يُعْطِيَهَا شَيْئًا  »  .","","Sunan Sa'id ibn Mansur 752","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فيدخل بها قبل أن يفرض شيئا"
"1930","753  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  عَمَّنْ  سَمِعَ  قَتَادَةَ  يُحَدِّثُ عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، «  أَنَّهُ كَانَ لَا يَرَى بَأْسًا أَنْ يَدْخُلَ بِهَا قَبْلَ أَنْ يُعْطِيَهَا شَيْئًا  » .","","Sunan Sa'id ibn Mansur 753","","سعيد بن المسيب عن قتادة بن دعامة عن عمن عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فيدخل بها قبل أن يفرض شيئا"
"1931","754  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  أَبِي مَعْشَرٍ ،  عَنْ  إِبْرَاهِيمَ  فِي الرَّجُلِ يَتَزَوَّجُ الْمَرْأَةَ ، قَالَ : كَانَ يُقَالُ : «  أَحْسَنُ الْأُلْفَةِ أَنْ لَا يَقْرَبَهَا حَتَّى يَأْتِيَ بَيْتَهُ  »  .","","Sunan Sa'id ibn Mansur 754","","إبراهيم النخعي عن زياد بن كليب عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فيدخل بها قبل أن يفرض شيئا"
"1932","755  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  كَانَ لَا يَرَى بَأْسًا إِذَا مَلَكَ الرَّجُلُ عُقْدَةَ النِّكَاحِ أَنْ يَدْخُلَ بِهَا  قَبَلَ أَنْ يَنْقُدَهَا شَيْئًا  » .","","Sunan Sa'id ibn Mansur 755","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فيدخل بها قبل أن يفرض شيئا"
"1933","756  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَتَّابُ بْنُ بَشِيرٍ ، قَالَ :  أَنَا  خُصَيْفٌ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ : «  لَا يَدْخُلُ الرَّجُلُ عَلَى امْرَأَتِهِ حَتَّى يُقَدِّمَ إِلَيْهَا شَيْئًا  ، قَمِيصًا أَوْ رِدَاءً خِمَارًا ، وَلَوْ خَاتَمًا  » .","","Sunan Sa'id ibn Mansur 756","","سعيد بن جبير الأسدي عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فيدخل بها قبل أن يفرض شيئا"
"1934","[6/233]      بَابٌ فِيمَا يَجِبُ بِهِ الصَّدَاقُ .  757  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  قَالَ  عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ : «  إِذَا أُرْخِيَتِ السُّتُورُ فَقَدْ وَجَبَ الصَّدَاقُ وَالْعِدَّةُ  » .","","Sunan Sa'id ibn Mansur 757","","عمر بن الخطاب عن سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب فيما يجب به الصداق"
"1935","758  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عُمَرَ ، أَنَّهُ قَالَ : «  إِذَا أُغْلِقَ الْبَابُ أَوْ أُرْخِيَ السِّتْرُ أَوْ كُشِفَ الْخِمَارُ فَقَدْ وَجَبَ الصَّدَاقُ  » .","","Sunan Sa'id ibn Mansur 758","","عمر بن الخطاب عن إبراهيم النخعي عن منصور بن زاذان الثقفي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب فيما يجب به الصداق"
"1936","759  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  قَالَ  عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ : «  إِذَا أُغْلِقَ الْبَابُ وَأُرْخِيَ السِّتْرُ وَوُضِعَ الْخِمَارُ وَجَبَ الصَّدَاقُ  » .","","Sunan Sa'id ibn Mansur 759","","عمر بن الخطاب عن إبراهيم النخعي عن منصور بن المعتمر عن معتمر بن سليمان عن سعيد بن منصور","باب فيما يجب به الصداق"
"1937","760  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ  عَنْ  إِبْرَاهِيمَ ، قَالَ :  قَالَ  عُمَرُ : «  إِذَا أُغْلِقَ الْبَابُ وَأُرْخِيَ السِّتْرُ فَقَدْ وَجَبَ الصَّدَاقُ  »  .","","Sunan Sa'id ibn Mansur 760","","عمر بن الخطاب عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب فيما يجب به الصداق"
"1938","761  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  ابْنُ أَبِي لَيْلَى ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  زِرٍّ ، وَعَبَّادِ بْنِ عَبْدِ اللهِ الْأَسَدِيِّ ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ أَنَّهُ قَالَ : «  مَنْ أَصْفَقَ بَابًا وَأَرْخَى سِتْرًا فَقَدْ وَجَبَ الصَّدَاقُ وَالْعِدَّةُ  » .         [6/234]","","Sunan Sa'id ibn Mansur 761","","علي بن أبي طالب عن عباد بن عبد الله الأسدي عن المنهال بن عمرو الأسدي عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور","باب فيما يجب به الصداق"
"1939","762  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  عَوْفٌ ،  عَنْ  زُرَارَةَ بْنِ أَوْفَى ،  قَالَ  : «  قَضَى الْخُلَفَاءُ الرَّاشِدُونَ  الْمَهْدِيُّونَ  : أَنَّهُ  مَنْ أَغْلَقَ بَابًا وَأَرْخَى سِتْرًا فَقَدْ وَجَبَ الصَّدَاقُ وَالْعِدَّةُ  » .","","Sunan Sa'id ibn Mansur 762","","أبو  بكر الصديق عن زرارة بن أوفى عن عوف بن أبي جميلة عن هشيم بن بشير عن سعيد بن منصور","باب فيما يجب به الصداق"
"1940","763  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  إِذَا اطَّلَعَ الرَّجُلُ مِنِ امْرَأَتِهِ عَلَى مَا لَا يَحِلُّ أَنْ يَطَّلِعَ عَلَيْهِ غَيْرُهُ فَقَدْ وَجَبَ الصَّدَاقُ وَالْعِدَّةُ  » .","","Sunan Sa'id ibn Mansur 763","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب فيما يجب به الصداق"
"1941","764  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ قَالَ : قَالَ لِي : «  أُرْخِيَ عَلَيْكَ السِّتْرُ وَأُغْلِقَ عَلَيْكَ الْبَابُ  ؟ قُلْتُ : نَعَمْ ، قَالَ : وَجَبَ عَلَيْكَ الصَّدَاقُ  » .","","Sunan Sa'id ibn Mansur 764","","علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جعفر الصادق عن سفيان بن عيينة عن سعيد بن منصور","باب فيما يجب به الصداق"
"1942","765  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ  فِي الرَّجُلِ يَخْلُو بِالْمَرْأَةِ ، فَيَقُولُ : لَمْ  أَمَسَّهَا  ، وَتَقُولُ : قَدْ مَسَّنِي ، فَالْقَوْلُ قَوْلُهَا  .","","Sunan Sa'id ibn Mansur 765","","زيد بن ثابت الأنصاري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سعيد بن منصور","باب فيما يجب به الصداق"
"1943","766  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  شُرَيْحٍ  فِي رَجُلٍ أُدْخِلَتْ عَلَيْهِ امْرَأَتُهُ فَزَعَمَ أَنَّهُ لَمْ يَمَسَّهَا  ، فَقَالَ  شُرَيْحٌ  : « لَمْ أَسْمَعِ اللهَ عَزَّ وَجَلَّ يَذْكُرُ فِي الْقُرْآنِ بَابًا وَلَا سِتْرًا ، لَهَا نِصْفُ الصَّدَاقِ ، وَعَلَيْهَا الْعِدَّةُ  »  .         [6/235]","","Sunan Sa'id ibn Mansur 766","","شريح بن الحارث الكندي عن الشعبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب فيما يجب به الصداق"
"1944","767  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  نَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّ  عَمْرَو بْنَ نَافِعٍ  طَلَّقَ امْرَأَتَهُ ، وَكَانَتْ قَدْ أُدْخِلَتْ عَلَيْهِ  ، فَزَعَمَ أَنَّهُ لَمْ يَقْرَبْهَا وَزَعَمَتْ أَنَّهُ قَدْ قَرِبَهَا ، فَخَاصَمَتْهُ إِلَى شُرَيْحٍ فَصَبَرَ يَمِينَ  عَمْرٍو  بِاللهِ الَّذِي لَا إِلَهَ إِلَّا هُوَ مَا قَرِبَهَا ، وَقَضَى عَلَيْهِ بِنِصْفِ الصَّدَاقِ  .","","Sunan Sa'id ibn Mansur 767","","شريح بن الحارث الكندي عن الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب فيما يجب به الصداق"
"1945","768  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  سَيَّارٌ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  شُرَيْحٍ مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 768","","شريح بن الحارث الكندي عن الشعبي عن سيار بن أبي سيار العنزي عن هشيم بن بشير عن سعيد بن منصور","باب فيما يجب به الصداق"
"1946","769  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حُصَيْنُ بْنُ عَبْدِ الرَّحْمَنِ ،  أَنَّ  عَمْرَو بْنَ نَافِعٍ  ، تَزَوَّجَ  بِنْتَ يَحْيَى بْنِ الْجَزَّارِ  فَطَلَّقَهَا ، وَزَعَمَ أَنَّهُ لَمْ يَقْرَبْهَا  ، فَخَاصَمُوهُ إِلَى شُرَيْحٍ فَاسْتَحْلَفَهُ وَقَضَى عَلَيْهِ بِنِصْفِ الصَّدَاقِ  .","","Sunan Sa'id ibn Mansur 769","","شريح بن الحارث الكندي عن حصين بن عبد الرحمن السلمي عن هشيم بن بشير عن سعيد بن منصور","باب فيما يجب به الصداق"
"1947","770  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنْ  عَزْرَةَ ،  عَنْ  شُرَيْحٍ ،  أَنَّهُ قَالَ لَهَا : « لَا لَا أُصَدِّقُكِ لِنَفْسِكِ ، وَأَتَّهِمُكِ لِنَفْسِكِ  » قَالَ  هُشَيْمٌ  يَقُولُ : فَعَلَيْكِ الْعِدَّةُ ، وَلَا تَزَوَّجِي حَتَّى تَعْتَدِّي  .","","Sunan Sa'id ibn Mansur 770","","شريح بن الحارث الكندي عن عزرة بن عبد الرحمن بن زرارة عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب فيما يجب به الصداق"
"1948","771  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ :  أَنَّ رَجُلًا تَزَوَّجَ امْرَأَةً وَكَانَ يَبِيتُ عِنْدَهَا فَطَلَّقَهَا  ، فَقَالَتْ : لَمْ يَقْرَبْنِي وَكَانَ         [6/236]      يَبِيتُ عِنْدِي وَعَلَيَّ ثِيَابِي قَالَ : « عَلَيْهَا الْعِدَّةُ وَلَهَا الصَّدَاقُ ، أَلَا تَرَى أَنَّهَا لَوِ ادَّعَتْ  حَمْلًا صُدِّقَتْ  »  .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : كذا في ص ، وفوق السين علامة الإهمال ، وتحت الحاء حاء صغيرة ، لكني أرى أن الصواب ""ادعت""","","Sunan Sa'id ibn Mansur 771","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب فيما يجب به الصداق"
"1949","772  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  لَيْثٌ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّهُ كَانَ يَقُولُ فِي الرَّجُلِ إِذَا أُدْخِلَتْ عَلَيْهِ امْرَأَتُهُ ، ثُمَّ طَلَّقَهَا فَزَعَمَ أَنَّهُ لَمْ يَمَسَّهَا  ، قَالَ : « عَلَيْهِ نِصْفُ الصَّدَاقِ  »  .","","Sunan Sa'id ibn Mansur 772","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن هشيم بن بشير عن سعيد بن منصور","باب فيما يجب به الصداق"
"1950","بَابُ الرَّجُلِ يُزَوِّجُ ابْنَهُ وَهُوَ صَغِيرٌ .  773  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، قَالَ : «  إِذَا زَوَّجَ الرَّجُلُ ابْنَهُ وَهُوَ صَغِيرٌ فَالصَّدَاقُ عَلَى الِابْنِ  إِلَّا أَنْ يَضْمَنَهُ الْأَبُ  »  قَالَ  هُشَيْمٌ  :  وَهُوَ الْقَوْلُ  .","","Sunan Sa'id ibn Mansur 773","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يزوج ابنه وهو صغير"
"1951","774  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  مُجَالِدٌ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  هُوَ عَلَى الْأَبِ  » .","","Sunan Sa'id ibn Mansur 774","","الشعبي عن مجالد بن سعيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يزوج ابنه وهو صغير"
"1952","775  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  «  أَنَّهُ زَوَّجَ ابْنَةَ أَخِيهِ ابْنَ أَخِيهِ وَهُمَا صَغِيرَانِ  » .","","Sunan Sa'id ibn Mansur 775","","عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن سعيد بن منصور","باب الرجل يزوج ابنه وهو صغير"
"1953","بَابُ الْإِقَامَةِ عِنْدَ الْبِكْرِ  وَالثَّيِّبِ  .  776  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ ،  عَنْ         [6/237]      عَبْدِ الْمَلِكِ بْنِ أَبِي بَكْرٍ ، قَالَ :  لَمَّا دَخَلَتْ  أُمُّ سَلَمَةَ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : «  إِنَّهُ لَيْسَ بِكِ عَلَى  أَهْلِكِ  هَوَانٌ  ، فَإِنْ شِئْتِ  سَبَّعْتُ  لَكِ ، وَإِلَّا فَثَلَّثْتُكِ ثُمَّ أَدُورُ  » .","","Sunan Sa'id ibn Mansur 776","","عبد الملك بن أبي بكر المخزومي عن عبد الله بن أبي بكر بن محمد  ابن حزم عن سفيان بن عيينة عن سعيد بن منصور","باب الإقامة عند البكر والثيب"
"1954","777  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  حُمَيْدٌ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ : «  أَصَابَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  صَفِيَّةَ بِنْتَ حُيَيٍّ  حِينَ اتَّخَذَهَا أَقَامَ عِنْدَهَا ثَلَاثًا  » .","","Sunan Sa'id ibn Mansur 777","","أنس بن مالك عن حميد الطويل عن هشيم بن بشير عن سعيد بن منصور","باب الإقامة عند البكر والثيب"
"1955","778  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  خَالِدٌ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  أَنَسٍ قَالَ : «  إِذَا تَزَوَّجَ الْبِكْرَ عَلَى  الثَّيِّبِ  أَقَامَ عِنْدَهَا سَبْعًا  ، ثُمَّ قَسَمَ ، وَإِذَا تَزَوَّجَ  الثَّيِّبَ  أَقَامَ عِنْدَهَا ثَلَاثًا » قَالَ  خَالِدٌ  فِي حَدِيثِهِ : وَلَوْ قُلْتُ لَهُ إِنَّهُ  رَفَعَ الْحَدِيثَ  لَصَدَقْتُ وَلَكِنْ قَالَ : السُّنَّةُ كَذَلِكَ  .","","Sunan Sa'id ibn Mansur 778","","أنس بن مالك عن أبو قلابة الجرمي عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب الإقامة عند البكر والثيب"
"1956","779  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  حُمَيْدٌ ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، يَقُولُ مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 779","","أنس بن مالك عن حميد الطويل عن هشيم بن بشير عن سعيد بن منصور","باب الإقامة عند البكر والثيب"
"1957","780  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  حُمَيْدٌ ، وَيُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ قَالَ : «  إِذَا تَزَوَّجَ الْبِكْرَ عَلَى  الثَّيِّبِ  أَقَامَ عِنْدَهَا ثَلَاثًا  ، وَإِذَا تَزَوَّجَ  الثَّيِّبَ  أَقَامَ عِنْدَهَا لَيْلَتَيْنِ  » .         [6/238]","","Sunan Sa'id ibn Mansur 780","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الإقامة عند البكر والثيب"
"1958","781  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  خَالِدٌ ،  عَنِ  ابْنِ سِيرِينَ ، أَنَّهُ قَالَ كَمَا قَالَ  الْحَسَنُ  .","","Sunan Sa'id ibn Mansur 781","","محمد بن سيرين عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب الإقامة عند البكر والثيب"
"1959","782  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِأُمِّ سَلَمَةَ  حِينَ دَخَلَتْ : «  إِنْ شِئْتِ  سَبَّعْتُ  وَسَبَّعْتُ لِنِسَائِي  » .","","Sunan Sa'id ibn Mansur 782","","الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن هشيم بن بشير عن سعيد بن منصور","باب الإقامة عند البكر والثيب"
"1960","783  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  رَجُلٍ سَمَّاهُ مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 783","","رجل عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب الإقامة عند البكر والثيب"
"1961","بَابُ مَا جَاءَ فِي الرَّجُلِ يَتَزَوَّجُ الْأَمَةَ وَالْيَهُودِيَّةَ وَالنَّصْرَانِيَّةَ ثُمَّ يَزْنِي .  784  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، وَمُطَرِّفٍ ،  عَنِ  الشَّعْبِيِّ ، وَيُونُسَ ،  عَنِ  الْحَسَنِ ، وَحَجَّاجٍ ، وَعَبْدِ الْمَلِكِ ،  عَنْ  عَطَاءٍ «  أَنَّهُمْ قَالُوا فِي الْحُرِّ إِذَا تَزَوَّجَ أَمَةً ثُمَّ أَتَى فَاحِشَةً  ، أَنَّهُ يُجْلَدُ وَلَا يُرْجَمُ  »  .","","Sunan Sa'id ibn Mansur 784","","الشعبي عن مطرف بن طريف عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج الأمة واليهودية والنصرانية ثم يزني"
"1962","785  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حَجَّاجٌ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  أَنَّهُ «  لَا تُحْصِنُ الْأَمَةُ الْحُرَّ  ، وَلَا تُحْصِنُ الْحُرَّةُ الْعَبْدَ ، وَلَا تُحْصِنُ الْمُسْلِمَ الْيَهُودِيَّةُ وَلَا النَّصْرَانِيَّةُ ، وَإِنْ  قَذَفَ  وَاحِدَةً مِنْهُنَّ لَمْ يَكُنْ بَيْنَهَا وَبَيْنَ زَوْجِهَا لِعَانٌ  » .         [6/239]","","Sunan Sa'id ibn Mansur 785","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن عمرو بن شعيب عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج الأمة واليهودية والنصرانية ثم يزني"
"1963","786  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  أَنَا  أَيُّوبُ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ، قَالَ :  قَالَ  عُمَرُ عَلَى الْمِنْبَرِ : « أَتَدْرُونَ كَمْ يَنْكِحُ الْعَبْدُ ؟  فَقَامَ إِلَيْهِ رَجُلٌ ، فَقَالَ : أَنَا ، قَالَ : كَمْ ؟ قَالَ : اثْنَيْنِ  »  .","","Sunan Sa'id ibn Mansur 786","","عمر بن الخطاب عن محمد بن سيرين عن أيوب السختياني عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الرجل يتزوج الأمة واليهودية والنصرانية ثم يزني"
"1964","بَابُ الْعَبْدِ يَتَزَوَّجُ بِغَيْرِ إِذْنِ سَيِّدِهِ .  787  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ قَالَ : «  يَنْكِحُ الْعَبْدُ أَرْبَعًا  »  .","","Sunan Sa'id ibn Mansur 787","","مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1965","788  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  عَطَاءٍ قَالَ : «  يَنْكِحُ الْعَبْدُ اثْنَيْنِ  »  .","","Sunan Sa'id ibn Mansur 788","","عطاء بن أبي رباح عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1966","789  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ، قَالَ  أَنَا  يُونُسُ بْنُ عُبَيْدٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ «  أَنَّ غُلَامًا لَهُ تَزَوَّجَ بِغَيْرِ أَمْرِهِ فَضَرَبَهُمَا  الْحَدَّ  وَأَخَذَ كُلَّ شَيْءٍ كَانَ أَعْطَاهَا وَفَرَّقَ بَيْنَهُمَا  »  .","","Sunan Sa'id ibn Mansur 789","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1967","790  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  إِذَا تَزَوَّجَ الْعَبْدُ بِإِذْنِ مَوْلَاهُ فَالطَّلَاقُ بِيَدِ الْعَبْدِ  ، وَإِذَا تَزَوَّجَ بِغَيْرِ إِذْنِ مَوْلَاهُ ثُمَّ اطَّلَعَ عَلَيْهِ مَوْلَاهُ ، فَأَنْكَرَ تَزْوِيجَهُ يُفَرَّقُ بَيْنَهُ وَبَيْنَ امْرَأَتِهِ ، وَيَأْخُذُ         [6/240]      مَوْلَاهُ مَا وَجَدَ مِنْ مَهْرِهَا بِعَيْنِهِ ، وَمَا اسْتَهْلَكَتْهُ فَهُوَ لَهَا ، وَإِنْ كَانَ أَحَدٌ غَرَّ الْمَرْأَةَ فَعَلَيْهِ لَهَا مَهْرُ مِثْلِهَا  »  .","","Sunan Sa'id ibn Mansur 790","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1968","791  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، وَمُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، وَحُصَيْنٍ ،  عَنِ  الشَّعْبِيِّ ، أَنَّهُمْ قَالُوا : «  إِذَا تَزَوَّجَ بِغَيْرِ إِذْنِ مَوْلَاهُ فَالْأَمْرُ إِلَى الْمَوْلَى  ، إِنْ شَاءَ أَنْ  يُجِيزَ  ، وَإِنْ شَاءَ أَنْ يَرُدَّ ، وَإِذَا تَزَوَّجَ بِأَمْرِهِ فَالطَّلَاقُ بِيَدِ الْعَبْدِ  »  .","","Sunan Sa'id ibn Mansur 791","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1969","792  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا فَرَّقَ الْمَوْلَى بَيْنَهُمَا ، فَلَهَا مَا أَخَذَتْ بِمَا اسْتَحَلَّ مِنْهَا  » .","","Sunan Sa'id ibn Mansur 792","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1970","793  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  إِذَا فَرَّقَ الْمَوْلَى بَيْنَهُمَا فَإِنْ وَجَدَ عِنْدَهَا مِنْ عَيْنِ مَالِ غُلَامِهِ فَهُوَ لَهُ  ، وَمَا اسْتَهْلَكَتْ فَلَا شَيْءَ عَلَيْهَا  » .","","Sunan Sa'id ibn Mansur 793","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1971","794  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عُبَيْدَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ كَانَ يَقُولُ : «  مَا اسْتَهْلَكَتْ فَهُوَ دَيْنٌ عَلَيْهَا  » ،  قَالَ  هُشَيْمٌ :  وَهُوَ الْقَوْلُ  .","","Sunan Sa'id ibn Mansur 794","","إبراهيم النخعي عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1972","795  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  ابْنُ أَبِي لَيْلَى ، وَالْحَجَّاجُ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، وَحَجَّاجٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  شُرَيْحٍ ، وَمُغِيرَةُ  عَنْ  إِبْرَاهِيمَ ، وَيُونُسُ  عَنِ  الْحَسَنِ ، وَحُصَيْنٌ ، وَإِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ، أَنَّهُمْ قَالُوا : «  إِذَا تَزَوَّجَ بِأَمْرِ مَوْلَاهُ فَالطَّلَاقُ بِيَدِهِ  ، وَإِذَا تَزَوَّجَ بِغَيْرِ أَمْرِهِ فَالْأَمْرُ إِلَى الْمَوْلَى إِنْ شَاءَ جَمَعَ وَإِنْ شَاءَ فَرَّقَ  »  .         [6/241]","","Sunan Sa'id ibn Mansur 795","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1973","796  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  خَالِدٌ ،  عَنِ  ابْنِ سِيرِينَ ،  أَنَّ غُلَامًا تَزَوَّجَ بِغَيْرِ إِذْنِ مَوْلَاهُ فَرُفِعَ ذَلِكَ إِلَى  الْأَشْعَرِيِّ  ،  فَكَتَبَ إِلَى  عُمَرَ بْنِ الْخَطَّابِ  رَضِيَ اللهُ عَنْهُ وَكَانَ أَصْدَقَهَا خَمْسَ ذَوْدٍ ،  فَكَتَبَ  عُمَرُ إِلَيْهِ : « أَنْ أَعْطِهَا ثَلَاثَةً وَخُذْ مِنْهَا اثْنَيْنِ أَوْ أَعْطِهَا اثْنَيْنِ وَخُذْ مِنْهَا ثَلَاثًا  »  .","","Sunan Sa'id ibn Mansur 796","","عمر بن الخطاب عن محمد بن سيرين عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1974","797  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو عَوَانَةَ ،  عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  شُرَيْحٍ ، قَالَ : «  يَجُوزُ طَلَاقُ الْعَبْدِ  ، وَلَا يَجُوزُ نِكَاحُهُ  »  .","","Sunan Sa'id ibn Mansur 797","","شريح بن الحارث الكندي عن المسيب بن رافع الكاهلي عن سعيد بن مسروق الثوري عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1975","798  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ : «  إِذَا زَوَّجَ الرَّجُلُ أَمَتَهُ عَبْدَهُ فَالطَّلَاقُ بِيَدِ الْعَبْدِ  »  .","","Sunan Sa'id ibn Mansur 798","","سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1976","799  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ : «  يَنْزِعُهَا مِنْهُ إِنْ شَاءَ بِغَيْرِ طَلَاقٍ  »  .","","Sunan Sa'id ibn Mansur 799","","مجاهد بن جبر المخزومي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1977","800  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّهُ كَانَ يَقُولُ : «  الْأَمْرُ إِلَى الْمَوْلَى أَذِنَ لَهُ ، أَوْ لَمْ يَأْذَنْ لَهُ  » ، وَيَتْلُو هَذِهِ الْآيَةَ         {      ضَرَبَ اللهُ مَثَلا عَبْدًا مَمْلُوكًا لا يَقْدِرُ عَلَى شَيْءٍ         }      .","","Sunan Sa'id ibn Mansur 800","","عبد الله بن عباس عن عطاء بن أبي رباح عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1978","801  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :         [6/242]      «  كَانُوا يُكْرِهُونَ الْمَمْلُوكَ عَلَى النِّكَاحِ  وَيُدْلُونَهُ مَعَ امْرَأَتِهِ  الثَّيِّبِ  ثُمَّ يُغْلِقُونَ عَلَيْهِمَا الْبَابَ  »  .","","Sunan Sa'id ibn Mansur 801","","إبراهيم النخعي عن منصور بن المعتمر عن جرير بن عبد الحميد عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1979","802  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ  فِي الْعَبْدِ إِذَا تَزَوَّجَ بِغَيْرِ إِذْنِ مَوَالِيهِ  ، قَالَ : « فَالطَّلَاقُ بِيَدِ الْمَوْلَى ، إِنْ شَاءَ أَجَازَ وَإِنْ شَاءَ رَدَّ ، وَلِلْمَوْلَى مَا وَجَدَ مِنْ عَيْنِ مَالِهِ  »  .","","Sunan Sa'id ibn Mansur 802","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1980","803  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ  فِي الْعَبْدِ إِذَا تَزَوَّجَ بِإِذْنِ مَوَالِيهِ  قَالَ : « الطَّلَاقُ بِيَدِ الْعَبْدِ  » .","","Sunan Sa'id ibn Mansur 803","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1981","804  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُغِيرَةَ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ  فِي رَجُلٍ تَزَوَّجَ امْرَأَةً وَلَمْ يُسَمِّ لَهَا صَدَاقًا  ، فَبَعَثَ إِلَيْهَا شَيْئًا فَقَبِلَتْهُ ، فَدَخَلَ بِهَا ، ثُمَّ طَلَبَتْ صَدَاقَهَا قَالَ : « لَيْسَ ذَاكَ لَهَا إِنْ كَانَ دَخَلَ بِهَا وَرَضِيَتْ  »  .","","Sunan Sa'id ibn Mansur 804","","إبراهيم النخعي عن حماد بن أبي سليمان عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1982","805  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ،  ثَنَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ قَالَ : «  إِذَا أَذِنَ السَّيِّدُ فِي النِّكَاحِ فَالطَّلَاقُ بِيَدِ الْعَبْدِ  »  .","","Sunan Sa'id ibn Mansur 805","","إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1983","806  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  أَبِي مَعْبَدٍ ،  أَنَّ غُلَامًا  لِابْنِ عَبَّاسٍ  طَلَّقَ امْرَأَتَهُ تَطْلِيقَتَيْنِ ،  فَقَالَ  لَهُ ابْنُ عَبَّاسٍ : « رَاجِعْهَا  . فَأَبَى ، فَقَالَ : هِيَ لَكَ اسْتَحِلَّهَا بِمِلْكِ الْيَمِينِ  » .         [6/243]","","Sunan Sa'id ibn Mansur 806","","عبد الله بن عباس عن نافذ المكي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1984","807  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ :  لَيْسَ لِلْعَبْدِ طَلَاقٌ إِلَّا بِإِذْنِ سَيِّدِهِ  . قَالَ : وَذَكَرَ :         {      ضَرَبَ اللهُ مَثَلا عَبْدًا مَمْلُوكًا لا يَقْدِرُ عَلَى شَيْءٍ         }      .","","Sunan Sa'id ibn Mansur 807","","عبد الله بن عباس عن عطاء بن أبي رباح عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1985","808  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  الشَّيْبَانِيُّ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ : «  أَهْلُ الْحِجَازِ  أَوْ بَعْضُهُمْ  لَا يَرَوْنَ لِلْمَمْلُوكِ تَزْوِيجًا وَلَا طَلَاقًا  إِلَّا بِإِذْنِ مَوْلَاهُ  »  .","","Sunan Sa'id ibn Mansur 808","","سعيد بن جبير الأسدي عن سليمان بن فيروز الشيباني عن هشيم بن بشير عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1986","809  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ، قَالَ :  سَأَلْتُ  سَعِيدَ بْنَ جُبَيْرٍ عَنِ الرَّجُلِ يَأْذَنُ لِعَبْدٍ فِي التَّزْوِيجِ ، بِيَدِ مَنِ الطَّلَاقُ ؟  قَالَ : بِيَدِ الَّذِي نَكَحَ . قُلْتُ لَهُ : فَإِنَّ  جَابِرَ بْنَ زَيْدٍ  يَقُولُ : بِيَدِ السَّيِّدِ ؟ قَالَ : كَذَبَ  جَابِرٌ  .","","Sunan Sa'id ibn Mansur 809","","سعيد بن جبير الأسدي عن أيوب السختياني عن حماد بن زيد عن سعيد بن منصور","باب العبد يتزوج بغير إذن سيده"
"1987","بَابُ الرَّجُلِ يَتَزَوَّجُ شِبْهَهُ مِنَ النِّسَاءِ ، يَعْنِي :  لُمَتَهُ  مِنَ النِّسَاءِ .  810  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عِيسَى بْنُ يُونُسَ ، قَالَ :  نَا  أَبُو بَكْرِ بْنُ عَبْدِ اللهِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  أَبِي الْمُجَاشِعِ الْأَزْدِيِّ ، قَالَ :  أُتِيَ عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ بِامْرَأَةٍ شَابَّةٍ زَوَّجُوهَا شَيْخًا كَبِيرًا فَقَتَلَتْهُ ،  فَقَالَ  : «  يَا أَيُّهَا النَّاسُ ، اتَّقُوا اللهَ وَلْيَنْكِحِ الرَّجُلُ  لُمَتَهُ  مِنَ النِّسَاءِ  ، وَلْتَنْكِحِ الْمَرْأَةُ  لُمَتَهَا  مِنَ الرِّجَالِ ، يَعْنِي :  شِبْهَهَا  »  .         [6/244]","","Sunan Sa'id ibn Mansur 810","","عمر بن الخطاب عن أبو مجاشع الأزدي عن أبو بكر الغساني عن عيسى بن يونس بن أبي إسحاق عن سعيد بن منصور","باب الرجل يتزوج شبهه من النساء يعني لمته من النساء"
"1988","811  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  قَالَ  عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ : «  لَا تُكْرِهُوا فَتَيَاتِكُمْ عَلَى الرَّجُلِ الْقَبِيحِ  ، فَإِنَّهُنَّ يُحْبِبْنَ مَا تُحِبُّونَ  »  .","","Sunan Sa'id ibn Mansur 811","","عمر بن الخطاب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عيسى بن يونس بن أبي إسحاق عن سعيد بن منصور","باب الرجل يتزوج شبهه من النساء يعني لمته من النساء"
"1989","812  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عِيسَى بْنُ يُونُسَ ، قَالَ :  نَا  أَبُو بَكْرِ بْنُ أَبِي مَرْيَمَ الْغَسَّانِيُّ ،  عَنْ  حَبِيبِ بْنِ عُبَيْدٍ « أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَسْتَحِبُّ النِّكَاحَ فِي رَمَضَانَ  ; رَجَاءَ الْبَرَكَةِ فِيهِ  »  .","","Sunan Sa'id ibn Mansur 812","","حبيب بن عبيد الرحبي عن أبو بكر الغساني عن عيسى بن يونس بن أبي إسحاق عن سعيد بن منصور","باب الرجل يتزوج شبهه من النساء يعني لمته من النساء"
"1990","بَابُ الرَّجُلِ يَتَزَوَّجُ الْمَرْأَةَ الْفَاجِرَةَ .  813  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ  فِي الرَّجُلِ يَتَزَوَّجُ الْمَرْأَةَ وَقَدْ  فَجَرَتْ  ، قَالَ : « إِنْ لَمْ يَسْتَحْيِ لِوَلَدِهِ أَنْ يُعَيَّرَ بِذَلِكَ فَلْيَتَزَوَّجْهَا إِنْ شَاءَ  » .","","Sunan Sa'id ibn Mansur 813","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة الفاجرة"
"1991","814  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  حَجَّاجٌ ،  عَنْ  عَطَاءٍ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 814","","عطاء بن أبي رباح عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة الفاجرة"
"1992","815  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  الْعَوَّامُ بْنُ حَوْشَبٍ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  لَا تَحِلُّ مُسَافِحَةٌ وَلَا ذَاتُ خِدْنٍ لِمُسْلِمٍ  »  .","","Sunan Sa'id ibn Mansur 815","","الحسن البصري عن العوام بن حوشب عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة الفاجرة"
"1993","816  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  مَنْصُورٌ ، وَيُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  يُفَارِقُهَا إِذَا فَعَلَتْ ذَلِكَ  ، وَهِيَ عِنْدَهُ وَلَا يُمْسِكُهَا  »  .","","Sunan Sa'id ibn Mansur 816","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة الفاجرة"
"1994","817  -  حَدَّثَنَا  سَعِيدٌ قَالَ : .....  نَا  أَبُو شِهَابٍ ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،         [6/245]      عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ : «  لَوْ أَنَّ رَجُلًا وَجَدَ مَعَ امْرَأَتِهِ عَشَرَةً لَمْ تَحْرُمْ عَلَيْهِ  »  .","","Sunan Sa'id ibn Mansur 817","","مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان الثوري عن عبد ربه بن نافع الحناط عن سعيد بن منصور","باب الرجل يتزوج المرأة الفاجرة"
"1995","بَابُ مِنْ يَتَزَوَّجُ امْرَأَةً  مَجْذُومَةً  أَوْ مَجْنُونَةً .  818  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ، قَالَ :  نَا  سَعِيدُ بْنُ الْمُسَيِّبِ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ قَالَ : «  أَيُّمَا رَجُلٍ تَزَوَّجَ امْرَأَةً فَدَخَلَ بِهَا ، فَوَجَدَ بِهَا بَرَصًا ، أَوْ مَجْنُونَةً أَوْ  مَجْذُومَةً  ، فَلَهَا الصَّدَاقُ بِمَسِيسِهِ إِيَّاهَا ، وَهُوَ لَهُ عَلَى مَنْ غَرَّهُ مِنْهَا  »  .","","Sunan Sa'id ibn Mansur 818","","عمر بن الخطاب عن سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب من يتزوج امرأة مجذومة أو مجنونة"
"1996","819  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ قَضَى : «  أَيُّمَا امْرَأَةٍ نُكِحَتْ وَبِهَا شَيْءٌ مِنْ هَذَا الدَّاءِ  ، وَلَمْ يَعْلَمْ حَتَّى مَسَّهَا ، فَلَهَا مَهْرُهَا بِمَا اسْتَحَلَّ مِنْ فَرْجِهَا ، وَيُغْرِمُ وَلِيَّهَا زَوْجُهَا مِثْلَ مَهْرِهَا  » .","","Sunan Sa'id ibn Mansur 819","","عمر بن الخطاب عن سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن سفيان بن عيينة عن سعيد بن منصور","باب من يتزوج امرأة مجذومة أو مجنونة"
"1997","820  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ قَالَ : «  أَيُّمَا رَجُلٍ تَزَوَّجَ امْرَأَةً ، فَوَجَدَهَا مَجْنُونَةً أَوْ  مَجْذُومَةً  أَوْ بَرْصَاءَ  ، فَهِيَ امْرَأَتُهُ ، إِنْ شَاءَ طَلَّقَ ، وَإِنْ شَاءَ أَمْسَكَ  » .","","Sunan Sa'id ibn Mansur 820","","علي بن أبي طالب عن الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب من يتزوج امرأة مجذومة أو مجنونة"
"1998","821  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  مُطَرِّفٍ ،  عَنِ  الشَّعْبِيِّ قَالَ :  قَالَ  عَلِيٌّ رَضِيَ اللهُ عَنْهُ : «  أَيُّمَا امْرَأَةٍ نُكِحَتْ وَبِهَا بَرَصٌ أَوْ جُنُونٌ أَوْ جُذَامٌ أَوْ         [6/246]      قَرْنٌ  ، فَزَوْجُهَا بِالْخِيَارِ مَا لَمْ يَمَسَّهَا ، إِنْ شَاءَ أَمْسَكَ ، وَإِنْ شَاءَ طَلَّقَ ، وَإِنَّ مَسَّهَا فَلَهَا الْمَهْرُ بِمَا اسْتَحَلَّ مِنْ فَرْجِهَا  » .","","Sunan Sa'id ibn Mansur 821","","علي بن أبي طالب عن الشعبي عن مطرف بن طريف عن سفيان بن عيينة عن سعيد بن منصور","باب من يتزوج امرأة مجذومة أو مجنونة"
"1999","822  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  مُحَمَّدُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ أَنَّهُ قَالَ : «  ذَلِكَ إِذَا دَخَلَ بِهَا ، فَإِنْ عَلِمَ بِذَلِكَ قَبْلَ أَنْ يَدْخُلَ بِهَا ، فَإِنْ شَاءَ أَمْسَكَ  ، وَإِنْ شَاءَ فَارَقَ بِغَيْرِ طَلَاقٍ  »  .","","Sunan Sa'id ibn Mansur 822","","الشعبي عن محمد بن سالم الهمداني عن هشيم بن بشير عن سعيد بن منصور","باب من يتزوج امرأة مجذومة أو مجنونة"
"2000","823  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ كَانَ يَقُولُ : «  هِيَ امْرَأَتُهُ ، إِنْ شَاءَ أَمْسَكَ ، وَإِنْ شَاءَ طَلَّقَ  ، دَخَلَ بِهَا أَمْ لَمْ يَدْخُلْ بِهَا ، وَلَيْسَ  الْحَرَائِرُ  كَالْإِمَاءِ ، الْحُرَّةُ لَا تُرَدُّ مِنْ دَاءٍ  » .","","Sunan Sa'id ibn Mansur 823","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب من يتزوج امرأة مجذومة أو مجنونة"
"2001","824  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ قَالَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 824","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب من يتزوج امرأة مجذومة أو مجنونة"
"2002","825  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ، قَالَ : «  أَرْبَعٌ لَا يَجُزْنَ فِي بَيْعٍ وَلَا نِكَاحٍ  : الْمَجْنُونَةُ ،  وَالْمَجْذُومَةُ ،  وَالْبَرْصَاءُ ،  وَالْعَفْلَاءُ  »  .","","Sunan Sa'id ibn Mansur 825","","جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن حماد بن زيد عن سعيد بن منصور","باب من يتزوج امرأة مجذومة أو مجنونة"
"2003","826  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  خَالِدٌ الْحَذَّاءُ ، قَالَ :  كَتَبَ  عَدِيُّ بْنُ أَرْطَاةَ  إِلَى  عُمَرَ بْنِ عَبْدِ الْعَزِيزِ  فِي ذَلِكَ ، فَكَتَبَ إِلَيْهِ عُمَرُ : «  إِنَّهُ قَدِ ائْتَمَنَ أَصْهَارَهُ عَلَى مَا هُوَ أَعْظَمُ مِنْ ذَلِكَ ، إِنْ شَاءَ طَلَّقَ ، وَإِنْ شَاءَ أَمْسَكَ  »  .         [6/247]","","Sunan Sa'id ibn Mansur 826","","عمر بن عبد العزيز بن مروان عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب من يتزوج امرأة مجذومة أو مجنونة"
"2004","827  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  إِنْ عَلِمَ بِذَلِكَ الْوَلِيُّ فَالصَّدَاقُ عَلَيْهِ كَمَا غَرَّهُ مِنْهَا  ، وَإِنْ لَمْ يَعْلَمْ فَهِيَ امْرَأَتُهُ ، إِنْ شَاءَ طَلَّقَ ، وَإِنْ شَاءَ أَمْسَكَ  »  .","","Sunan Sa'id ibn Mansur 827","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب من يتزوج امرأة مجذومة أو مجنونة"
"2005","828  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ، قَالَ : «  أَرْبَعٌ لَا يَجُزْنَ فِي بَيْعٍ وَلَا نِكَاحٍ إِلَّا أَنْ يَمَسَّ  ، فَإِنْ مَسَّ فَقَدْ جَازَ : الْجُنُونُ ، وَالْجُذَامُ ، وَالْبَرَصُ ، وَالْقَرْنُ  »  .","","Sunan Sa'id ibn Mansur 828","","جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب من يتزوج امرأة مجذومة أو مجنونة"
"2006","829  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  جَمِيلُ بْنُ زَيْدٍ الطَّائِيُّ ،  عَنْ  زَيْدِ بْنِ كَعْبِ بْنِ عُجْرَةَ قَالَ :  تَزَوَّجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  امْرَأَةً مِنْ بَنِي غِفَارٍ  ، فَلَمَّا دَخَلَتْ عَلَيْهِ وَضَعَتْ ثِيَابَهَا ، فَرَأَى بِكَشْحِهَا بَيَاضًا ، فَقَالَ : «  الْبَسِي ثِيَابَكِ وَالْحَقِي بِأَهْلِكِ  »  .","","Sunan Sa'id ibn Mansur 829","","زيد بن كعب بن عجرة عن جميل بن زيد الطائي عن أبو معاوية الضرير عن سعيد بن منصور","باب من يتزوج امرأة مجذومة أو مجنونة"
"2007","830  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  شَرِيكٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  لَا تُرَدُّ الْحُرَّةُ مِنْ عَيْبٍ  »  .","","Sunan Sa'id ibn Mansur 830","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن شريك بن عبد الله النخعي عن سعيد بن منصور","باب من يتزوج امرأة مجذومة أو مجنونة"
"2008","831  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  رَجُلٌ ،  عَنْ  جَمِيلِ بْنِ زَيْدٍ ،  عَنْ  زَيْدِ بْنِ كَعْبِ بْنِ عُجْرَةَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَ حَدِيثٍ قَبْلَهُ ، « أَمَرَ لَهَا بِالصَّدَاقِ  »  .         [6/248]","","Sunan Sa'id ibn Mansur 831","","زيد بن كعب بن عجرة عن جميل بن زيد الطائي عن رجل عن أبو معاوية الضرير عن سعيد بن منصور","باب من يتزوج امرأة مجذومة أو مجنونة"
"2009","832  -  حَدَّثَنِي  مُحَمَّدٌ ، قَالَ :  حَدَّثَنِي  أَبُو عَمْرٍو سَهْلُ بْنُ زَنْجَلَةَ الرَّازِّيُّ ، قَالَ :  نَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنِ  الْأَوْزَاعِيِّ قَالَ :  سَأَلْتُ  الزُّهْرِيَّ : أَيُّ أَزْوَاجِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الَّتِي اسْتَعَاذَتْ مِنْهُ ؟ فَقَالَ :  حَدَّثَنِي  عُرْوَةُ ،  عَنْ  عَائِشَةَ أَنَّ  ابْنَةَ الْجَوْنِ الْكِلَابِيَّةَ  لَمَّا دَخَلَتْ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَهَبَ يَدْنُو مِنْهَا ، فَقَالَتْ : عَائِذًا بِاللهِ . فَقَالَ : «  عُذْتِ  بِعَظِيمٍ ، ضُمِّي ثِيَابَكِ وَالْحَقِي بِأَهْلِكِ  »  .","","Sunan Sa'id ibn Mansur 832","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن سهل بن أبي سهل الأشتر","باب من يتزوج امرأة مجذومة أو مجنونة"
"2010","833  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ، قَالَ  حَدَّثَنِي  ابْنُ جُرَيْجٍ ،  عَنْ  عَطَاءٍ  فِي رَجُلٍ تَزَوَّجَ امْرَأَةً ، فَلَمَّا دَخَلَ بِهَا بَدَا مِنَ الرَّجُلِ عَيْبٌ  ، بَرَصٌ أَوْ جُذَامٌ . قَالَ  عَطَاءٌ  : « لَا تُنْزَعُ مِنْهُ امْرَأَتُهُ  »  .","","Sunan Sa'id ibn Mansur 833","","عطاء بن أبي رباح عن ابن جريج عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب من يتزوج امرأة مجذومة أو مجنونة"
"2011","بَابُ التَّزْوِيجِ بِالْعَاجِلِ وَالْآجِلِ .  834  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ  فِي رَجُلٍ تَزَوَّجَ عَلَى عَاجِلٍ وَآجِلٍ  : « وَهُوَ حَالٌّ كُلُّهُ ، إِلَّا أَنْ يَكُونَ لَهُ مُدَّةٌ مَعْلُومَةٌ  » .","","Sunan Sa'id ibn Mansur 834","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب التزويج بالعاجل والآجل"
"2012","835  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  أَشْعَثُ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّهُ كَانَ يَقُولُ فِي الْآجِلِ مِنَ الْمَهْرِ  : « إِلَى أَنْ يَكُونَ طَلَاقٌ أَوْ مَوْتٌ  » .","","Sunan Sa'id ibn Mansur 835","","الشعبي عن أشعث بن سوار عن هشيم بن بشير عن سعيد بن منصور","باب التزويج بالعاجل والآجل"
"2013","بَابُ مَا جَاءَ فِي الرَّجُلِ يَتَزَوَّجُ أَمَةً بَيْنَ الرَّجُلَيْنِ ثُمَّ يَشْتَرِي نَصِيبَ أَحَدِهِمَا .  836  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ  فِي         [6/249]      رَجُلٍ تَزَوَّجَ أَمَةً بَيْنَ رَجُلَيْنِ فَاشْتَرَى نَصِيبَ أَحَدِهِمَا  قَالَ : « لَا يَقْرَبْهَا حَتَّى يَتَخَلَّصَ نَصِيبُ الْآخَرِ  » .","","Sunan Sa'id ibn Mansur 836","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج أمة بين الرجلين ثم يشتري نصيب أحدهما"
"2014","837  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  حُدِّثْتُ عَنْ  إِبْرَاهِيمَ ، أَنَّهُ قَالَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 837","","إبراهيم النخعي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج أمة بين الرجلين ثم يشتري نصيب أحدهما"
"2015","بَابُ مَا جَاءَ فِي الرَّجُلِ يَتَزَوَّجُ ذَاتَ  مَحْرَمٍ  .  838  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ  فِي رَجُلٍ تَزَوَّجَ ذَاتَ  مَحْرَمٍ  مِنْهُ  قَالَ : « إِنْ دَخَلَ بِهَا فَلَهَا الصَّدَاقُ ، وَإِنْ كَانَ لَمْ يَدْخُلْ بِهَا فَلَا صَدَاقَ لَهَا ، وَيُفَرَّقُ بَيْنَهُمَا  » .  وَقَالَ  حَمَّادٌ : «  لَهَا مَا أَخَذَتْ  »  .","","Sunan Sa'id ibn Mansur 838","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج ذات محرم"
"2016","839  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ قَالَ : «  إِنْ لَمْ يَكُنْ دَخَلَ بِهَا بَطَلَ الصَّدَاقُ  ، وَإِنْ دَخَلَ بِهَا فَلَهَا مَا سَمَّاهَا  »  .","","Sunan Sa'id ibn Mansur 839","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في الرجل يتزوج ذات محرم"
"2017","840  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، قَالَ : «  إِنْ لَمْ يَكُنْ دَخَلَ بِهَا فَلَا شَيْءَ لَهَا  ، وَإِنْ كَانَ دَخَلَ بِهَا فَلَهَا مَا أَخَذَتْ  »  .","","Sunan Sa'id ibn Mansur 840","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج ذات محرم"
"2018","841  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَشْعَثُ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  لَا شَيْءَ لَهَا ، دَخَلَ بِهَا أَوْ لَمْ يَدْخُلْ بِهَا  ،  أَيُصْدِقُ  الرَّجُلُ أُخْتَهُ أَوْ أُمَّهُ  ؟ »  .","","Sunan Sa'id ibn Mansur 841","","الشعبي عن أشعث بن سوار عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج ذات محرم"
"2019","842  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُبَيْدٍ ،  عَنْ  مَكْحُولٍ ،  فِي رَجُلٍ نَكَحَ امْرَأَةً فَوَجَدَهَا أُخْتَهُ مِنَ الرَّضَاعَةِ  وَلَمْ يَعْلَمْ قَالَ : « إِذَا لَمْ يَكُنْ دَخَلَ بِهَا فَلَا نِكَاحَ بَيْنَهُمَا وَيَقْبِضُ مَالَهُ ، وَإِنْ كَانَ دَخَلَ بِهَا وَرَأَى مِنْهَا         [6/250]      مَا يَرَى الرَّجُلُ مِنِ امْرَأَتِهِ وَلَمْ يَمَسَّهَا ، وَجَبَ مَهْرُهَا كَامِلًا ، وَإِنْ كَانَ طَلَّقَهَا قَبْلَ أَنْ يَمَسَّهَا وَأَعْطَاهَا نِصْفَ الصَّدَاقِ وَهُوَ لَا يَعْلَمُ أَنَّهَا أُخْتُهُ ، ثُمَّ عَلِمَ بَعْدَ ذَلِكَ قَالَ : أَرَى أَنْ تَرُدَّ إِلَيْهِ مَا أَخَذَتْ مِنْهُ ، وَلَمْ أَسْمَعْ فِيهِ شَيْئًا ، وَعِدَّتُهَا  عِدَّةُ  الْمُطَلَّقَةِ إِنْ كَانَ دَخَلَ بِهَا ، وَإِنْ تُوُفِّيَ وَاحِدٌ مِنْهُمَا فَلَا مِيرَاثَ بَيْنَهُمَا  »  .","","Sunan Sa'id ibn Mansur 842","","مكحول بن أبي مسلم عن عبيد الله بن عبيد الكلاعي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب ما جاء في الرجل يتزوج ذات محرم"
"2020","843  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  سَعِيدِ بْنِ يُوسُفَ الرَّحَبِيِّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ  فِي رَجُلٍ نَكَحَ امْرَأَةً فَأَعْطَاهَا صَدَاقَهَا ، وَكَانَتْ أُخْتَهُ مِنَ الرَّضَاعَةِ  ، وَلَمْ يَكُنْ دَخَلَ بِهَا قَالَ : « تَرُدُّ إِلَيْهِ مَالَهُ الَّذِي أَعْطَاهَا وَيَفْتَرِقَانِ  »  .","","Sunan Sa'id ibn Mansur 843","","علي بن أبي طالب عن يحيى بن أبي كثير عن سعيد بن يوسف الرحبي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب ما جاء في الرجل يتزوج ذات محرم"
"2021","بَابُ مَا جَاءَ فِي الْمُتْعَةِ  844  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ قَالَ :  لَمَّا قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَكَّةَ  فِي عُمْرَتِهِ ، تَزَيَّنَ نِسَاءُ  أَهْلِ الْمَدِينَةِ  ، فَشَكَا أَصْحَابُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : «  تَمَتَّعُوا مِنْهُنَّ ، وَاجْعَلُوا الْأَجَلَ بَيْنَكُمْ وَبَيْنَهُنَّ ثَلَاثًا  ، فَمَا أَحْسِبُ رَجُلًا يَتَمَكَّنُ مِنِ امْرَأَةٍ ثَلَاثًا إِلَّا وَلَّاهَا الدُّبُرَ  »  .","","Sunan Sa'id ibn Mansur 844","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في المتعة"
"2022","845  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ ، قَالَ : «  إِنَّمَا كَانَتِ الْمُتْعَةُ مِنَ النِّسَاءِ ثَلَاثَةَ أَيَّامٍ  ، وَلَمْ يَكُنْ قَبْلَ ذَلِكَ وَلَا بَعْدَهُ  »  .         [6/251]","","Sunan Sa'id ibn Mansur 845","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في المتعة"
"2023","846  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ اللهِ بْنُ وَهْبٍ ، قَالَ :  سَمِعْتُ  عَمْرَو بْنَ الْحَارِثِ ،  يُحَدِّثُ عَنِ  الرَّبِيعِ بْنِ سَبْرَةَ الْجُهَنِيِّ ،  عَنْ  أَبِيهِ  ، قَالَ : «  أَذِنَ لَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  الْمُتْعَةِ  عَامَ الْفَتْحِ  ، فَانْطَلَقْتُ أَنَا  وَرَجُلٌ  إِلَى  امْرَأَةٍ  شَابَّةٍ كَأَنَّهَا  بَكْرَةٌ  عَيْطَاءُ  نَتَمَتَّعُ ، فَجَلَسْنَا بَيْنَ يَدَيْهَا وَعَلَيَّ بُرْدٌ وَعَلَيْهِ بُرْدَةٌ ، فَكَلَّمْنَاهَا وَمَهَرْنَاهَا بُرْدَتَنَا ، وَكُنْتُ أَشَبَّ مِنْهُ ، وَكَانَ بُرْدُهُ أَجْوَدَ مِنْ بُرْدِي ، فَجَعَلَتْ تَنْظُرُ إِلَى بُرْدِهِ مَرَّةً ، وَإِلَى بُرْدِي مَرَّةً ، ثُمَّ قَبِلَتْنِي ، فَنَكَحْتُهَا ، فَلَبِثْتُ مَعَهَا ثَلَاثًا ، ثُمَّ إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْهَا ، فَفَارَقْتُهَا . أَوْ نَحْوَ هَذَا  »  .","","Sunan Sa'id ibn Mansur 846","","سبرة بن معبد الجهني عن الربيع بن سبرة الجهني عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن سعيد بن منصور","باب ما جاء في المتعة"
"2024","847  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  الرَّبِيعِ بْنِ سَبْرَةَ الْجُهَنِيِّ ،  عَنْ  أَبِيهِ  « أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ نِكَاحِ  الْمُتْعَةِ  عَامَ الْفَتْحِ  »  .","","Sunan Sa'id ibn Mansur 847","","سبرة بن معبد الجهني عن الربيع بن سبرة الجهني عن الزهري عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في المتعة"
"2025","848  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  سَمِعَ  عَبْدَ اللهِ ، وَالْحَسَنَ ، ابْنَيْ مُحَمَّدِ بْنِ عَلِيٍّ ابْنِ الْحَنَفِيَّةِ  يُحَدِّثَانِ عَنْ  أَبِيهِمَا  ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ أَنَّهُ قَالَ  لِابْنِ عَبَّاسٍ  : « إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى  زَمَنَ خَيْبَرَ  عَنْ نِكَاحِ  الْمُتْعَةِ  وَعَنْ لُحُومِ الْحُمُرِ  الْأَهْلِيَّةِ  »  .","","Sunan Sa'id ibn Mansur 848","","علي بن أبي طالب عن ابن الحنفية عن الحسن بن محمد بن علي بن أبي طالب عن الزهري عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في المتعة"
"2026","849  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ         [6/252]      عَبْدِ اللهِ ، وَالْحَسَنِ ، ابْنَيْ مُحَمَّدِ ابْنِ الْحَنَفِيَّةِ ،  عَنْ  أَبِيهِمَا  ،  أَنَّ  عَلِيًّا  ، رَضِيَ اللهُ عَنْهُ مَرَّ  بِابْنِ عَبَّاسٍ  وَهُوَ يُفْتِي فِي مُتْعَةِ النِّسَاءِ أَنَّهُ لَا بَأْسَ بِهَا ، فَقَالَ لَهُ عَلِيٌّ رَضِيَ اللهُ عَنْهُ : «  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْهَا ، وَعَنْ لُحُومِ الْحُمُرِ  الْأَهْلِيَّةِ  يَوْمَ خَيْبَرَ  »  .","","Sunan Sa'id ibn Mansur 849","","علي بن أبي طالب عن ابن الحنفية عن عبد الله بن محمد بن علي بن أبي طالب عن الزهري عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في المتعة"
"2027","850  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ، قَالَ :  نَا  عَبْدُ الْمَلِكِ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ : «  كَانُوا يَتَمَتَّعُونَ مِنَ النِّسَاءِ حَتَّى نَهَى عُمَرُ  »  .","","Sunan Sa'id ibn Mansur 850","","عمر بن الخطاب عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في المتعة"
"2028","851  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عُبَيْدُ اللهِ بْنُ إِيَادِ بْنِ لَقِيطٍ ، قَالَ :  نَا  إِيَادُ بْنُ لَقِيطٍ  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ نُعَيْمٍ الْأَعْرَجِ ، قَالَ :  سَأَلَ  رَجُلٌ  عَبْدَ اللهِ بْنَ عُمَرَ عَنْ مُتْعَةِ النِّسَاءِ  ، فَغَضِبَ وَقَالَ : مَا كُنَّا عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ زَانِينَ وَلَا مُسَافِحِينَ . ثُمَّ قَالَ : وَاللهِ لَقَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : « لَيَكُونَنَّ قَبْلَ الْقِيَامَةِ  الْمَسِيحُ الدَّجَّالُ  ، وَكَذَّابُونَ ثَلَاثُونَ أَوْ أَكْثَرُ  »  .","","Sunan Sa'id ibn Mansur 851","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن نعم الأعرجي عن إياد بن لقيط السدوسي عن عبيد الله بن إياد بن لقيط السدوسي عن سعيد بن منصور","باب ما جاء في المتعة"
"2029","852  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ ، قَالَ :  قَالَ  عُمَرُ بْنُ الْخَطَّابِ : «  مُتْعَتَانِ كَانَتَا عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، وَأَنَا أَنْهَى عَنْهُمَا وَأُعَاقِبُ عَلَيْهِمَا  .","","Sunan Sa'id ibn Mansur 852","","عمر بن الخطاب عن أبو قلابة الجرمي عن أيوب السختياني عن حماد بن زيد عن سعيد بن منصور","باب ما جاء في المتعة"
"2030","853  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  خَالِدٌ ،  عَنْ  أَبِي قِلَابَةَ قَالَ :  قَالَ  عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ : «  مُتْعَتَانِ كَانَتَا عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَا أَنْهَى عَنْهُمَا  وَأُعَاقِبُ عَلَيْهِمَا : مُتْعَةُ النِّسَاءِ ، وَمُتْعَةُ  الْحَجِّ  .         [6/253]","","Sunan Sa'id ibn Mansur 853","","عمر بن الخطاب عن أبو قلابة الجرمي عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في المتعة"
"2031","854  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  أَنَّ  عُمَرَ « نَهَى عَنْ مُتْعَةِ النِّسَاءِ وَمُتْعَةِ  الْحَجِّ  »  .","","Sunan Sa'id ibn Mansur 854","","عمر بن الخطاب عن سعيد بن المسيب عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في المتعة"
"2032","855  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  أَنَّ  عُرْوَةَ  «  كَانَ يَنْهَى عَنْ نِكَاحِ  الْمُتْعَةِ  ، وَيَقُولُ : هِيَ الزِّنَا الصَّرِيحُ  »  .","","Sunan Sa'id ibn Mansur 855","","عروة بن الزبير عن هشام بن عروة بن الزبير عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب ما جاء في المتعة"
"2033","بَابُ مَا جَاءَ فِي الرَّجُلِ يَزْنِي وَقَدْ تَزَوَّجَ امْرَأَةً وَلَمْ يَدْخُلْ بِهَا  856  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  حَنَشِ بْنِ الْمُعْتَمِرِ ، قَالَ :  أُتِيَ عَلِيٌّ رَضِيَ اللهُ عَنْهُ بِرَجُلٍ قَدْ أَقَرَّ عَلَى نَفْسِهِ بِالزِّنَا  ،  فَقَالَ  لَهُ : أَحْصَنْتَ ؟ قَالَ : نَعَمْ . قَالَ : إِذًا تُرْجَمُ . فَرَفَعَهُ إِلَى الْحَبْسِ ، فَلَمَّا كَانَ بِالْعَشِيِّ دَعَا بِهِ ، وَقَصَّ أَمْرَهُ عَلَى النَّاسِ ، فَقَالَ لَهُ رَجُلٌ : إِنَّهُ قَدْ تَزَوَّجَ امْرَأَةً وَلَمْ يَدْخُلْ بِهَا . فَفَرِحَ  عَلِيٌّ  بِذَلِكَ ، فَضَرَبَهُ  الْحَدَّ  ، وَفَرَّقَ بَيْنَهُ وَبَيْنَ امْرَأَتِهِ ، وَأَعْطَاهَا نِصْفَ الصَّدَاقِ ، فِيمَا يَرَى  سِمَاكٌ  .","","Sunan Sa'id ibn Mansur 856","","علي بن أبي طالب عن حنش بن المعتمر الكناني عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2034","857  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  حَنَشٍ ، قَالَ :  جَاءَ رَجُلٌ إِلَى عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، فَقَالَ : إِنِّي قَدْ زَنَيْتُ  .  فَقَالَ  : « إِنَّكَ إِذًا تُرْجَمُ إِنْ كُنْتَ قَدْ أَحْصَنْتَ . قَالَ :  مَلَكْتُ - أَوْ تَزَوَّجْتُ  - امْرَأَةً وَلَمْ أَبْنِ بِهَا . قَالَ : فَجَلَدَهُ مِائَةً ، وَفَرَّقَ بَيْنَهُمَا ، وَأَعْطَاهَا طَائِفَةً مِنْ صَدَاقِهَا  »  .         [6/254]","","Sunan Sa'id ibn Mansur 857","","علي بن أبي طالب عن حنش بن المعتمر الكناني عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2035","858  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا  زَنَتْ قَبْلَ أَنْ يُدْخَلَ بِهَا  ، ضُرِبَتِ  الْحَدَّ  ، وَفُرِّقَ بَيْنَهُمَا ، وَلَا صَدَاقَ لَهَا  » .","","Sunan Sa'id ibn Mansur 858","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2036","859  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ ذَلِكَ .","","Sunan Sa'id ibn Mansur 859","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2037","860  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  فِي  الْمَرْأَةِ تَزْنِي قَبْلَ أَنْ يُدْخَلَ بِهَا  قَالَ : « يُفَرَّقُ بَيْنَهُمَا ، وَلَا صَدَاقَ لَهَا  »  .","","Sunan Sa'id ibn Mansur 860","","إبراهيم النخعي عن منصور بن زاذان الثقفي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2038","861  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ أَنَّهُ كَانَ يَقُولُ : «  إِذَا زَنَى قَبْلَ أَنْ يَدْخُلَ بِهَا  ، أُقِيمَ عَلَيْهِ  الْحَدُّ  ، وَفُرِّقَ بَيْنَهُمَا ، وَلَا صَدَاقَ لَهَا  »  .","","Sunan Sa'id ibn Mansur 861","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2039","862  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  فِي قَوْلِهِ عَزَّ وَجَلَّ :         {      الزَّانِي لا يَنْكِحُ إِلا زَانِيَةً أَوْ مُشْرِكَةً         }      قَالَ : نَسَخَتْهَا         {      وَأَنْكِحُوا الأَيَامَى مِنْكُمْ         }      « فَهِيَ مِنْ أَيَامَى الْمُسْلِمِينَ  » .","","Sunan Sa'id ibn Mansur 862","","سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2040","863  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، مِثْلَهُ .","","Sunan Sa'id ibn Mansur 863","","سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن إسماعيل بن زكريا شقوصا عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2041","864  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُحَمَّدُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  أَيُّهُمَا زَنَى جُلِدَ  الْحَدَّ  ، وَهُمَا عَلَى نِكَاحِهِمَا  » ،  قَالَ  هُشَيْمٌ :  وَهُوَ الْقَوْلُ  .","","Sunan Sa'id ibn Mansur 864","","الشعبي عن محمد بن سالم الهمداني عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2042","865  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنْ  حَبِيبِ بْنِ أَبِي عَمْرَةَ ،  عَنْ  سَعِيدٍ ،  فِي قَوْلِهِ عَزَّ وَجَلَّ :         {      الزَّانِي لا يَنْكِحُ إِلا زَانِيَةً أَوْ مُشْرِكَةً         }      قَالَ : « لَيْسَ هُوَ بِالنِّكَاحِ ، وَلَكِنَّهُ الْجِمَاعُ  »  .         [6/255]","","Sunan Sa'id ibn Mansur 865","","سعيد بن جبير الأسدي عن حبيب بن أبي عمرة القصاب عن إسماعيل بن زكريا شقوصا عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2043","866  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  الشَّيْبَانِيُّ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّ جَارِيَةً  فَجَرَتْ  وَأُقِيمَ عَلَيْهَا  الْحَدُّ  ، ثُمَّ إِنَّهُمْ أَقْبَلُوا مُهَاجِرِينَ ، وَتَابَتِ الْجَارِيَةُ ، وَحَسُنَتْ تَوْبَتُهَا وَحَالُهَا ، وَكَانَتْ تُخْطَبُ إِلَى  عَمِّهَا  ، فَكَرِهَ أَنْ يُزَوِّجَهَا حَتَّى يُخْبِرَ بِمَا كَانَ مِنْ أَمْرِهَا ، وَجَعَلَ يَكْرَهُ أَنْ يُفْشِيَ ذَلِكَ عَلَيْهَا ، فَذَكَرَتْ أَمْرَهَا ذَلِكَ لِعُمَرَ ،  فَقَالَ  : « زَوِّجُوهَا كَمَا تُزَوِّجُوا صَالِحِي نِسَائِكُمْ  » .","","Sunan Sa'id ibn Mansur 866","","عمر بن الخطاب عن الشعبي عن سليمان بن فيروز الشيباني عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2044","867  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، قَالَ :  أَحْدَثَتِ امْرَأَةٌ  بِالشَّامِ  ،  فَكَتَبَ إِلَى  عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ أَنْ أَنْكِحْهَا وَلَا تُخْبِرْ حَدَثَهَا  . قَالَ : « أَنْكِحُوهَا وَلَا تَذْكُرُوا حَدَثَهَا  » .","","Sunan Sa'id ibn Mansur 867","","عمر بن الخطاب عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2045","868  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  فِي رَجُلٍ تَزَوَّجَ جَارِيَةً بِكْرًا ، فَفَجَرَتْ قَبْلَ أَنْ يُدْخَلَ بِهَا  قَالَ : « يُفَرَّقُ بَيْنَهُمَا وَلَا صَدَاقَ لَهَا  »  .","","Sunan Sa'id ibn Mansur 868","","إبراهيم النخعي عن منصور بن زاذان الثقفي عن جرير بن عبد الحميد عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2046","869  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  أَبِي إِسْحَاقَ الشَّيْبَانِيِّ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  تُجْلَدُ وَتَقَرُّ عِنْدَهُ  ، كَمَا أَنَّهُ لَوْ فَجَرَ هُوَ لَمْ تُنْزَعْ مِنْهُ امْرَأَتُهُ  »  .","","Sunan Sa'id ibn Mansur 869","","الشعبي عن سليمان بن فيروز الشيباني عن جرير بن عبد الحميد عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2047","870  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُبَيْدِ اللهِ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  إِذَا زَنَتِ الْبِكْرُ وَنُفِيَتْ فَهِيَ عِنْدَ زَوْجِهَا عَلَى نِكَاحِهَا  ، فَإِنْ فَعَلَ الْبِكْرُ فَهُوَ كَذَلِكَ  »  .         [6/256]","","Sunan Sa'id ibn Mansur 870","","الشعبي عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2048","871  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  أَنَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  لَا تَلِي النِّسَاءُ عُقْدَةَ النِّكَاحِ  » .","","Sunan Sa'id ibn Mansur 871","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2049","872  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، مِثْلَهُ .","","Sunan Sa'id ibn Mansur 872","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2050","873  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ «  أَنَّ السُّنَّةَ عِنْدَهُمْ أَنَّ الْمَرْأَةَ ، لَا تَعْقِدُ عُقْدَةَ النِّكَاحِ فِي نَفْسِهَا وَلَا فِي غَيْرِهَا  »  .","","Sunan Sa'id ibn Mansur 873","","سليمان بن يسار مولى ميمونة زوج رسول الله عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سعيد بن منصور","باب ما جاء في الرجل يزني وقد تزوج امرأة ولم يدخل بها"
"2051","بَابُ مَا جَاءَ فِي شَهَادَةِ النِّسَاءِ فِي النِّكَاحِ  874  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عُبَيْدَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  سَأَلْتُهُ عَنْ رَجُلٍ تَزَوَّجَ بِشَهَادَةِ رَجُلٍ وَامْرَأَةٍ  قَالَ : « يُشْهِدُونَ رَجُلًا آخَرَ  »  .","","Sunan Sa'id ibn Mansur 874","","إبراهيم النخعي عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في شهادة النساء في النكاح"
"2052","875  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  حَجَّاجٌ ،  عَنْ  عَطَاءٍ ،  عَنْ  عُمَرَ بْنِ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ «  أَنَّهُ أَجَازَ شَهَادَةَ النِّسَاءِ مَعَ الرَّجُلِ فِي النِّكَاحِ  » .","","Sunan Sa'id ibn Mansur 875","","عمر بن الخطاب عن عطاء بن أبي رباح عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في شهادة النساء في النكاح"
"2053","876  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ، وَمُطَرِّفٌ ،  عَنِ  الشَّعْبِيِّ «  أَنَّهُ كَانَ  يُجِيزُ  شَهَادَةَ النِّسَاءِ مَعَ الرَّجُلِ فِي النِّكَاحِ وَالطَّلَاقِ  » .","","Sunan Sa'id ibn Mansur 876","","الشعبي عن مطرف بن طريف عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في شهادة النساء في النكاح"
"2054","877  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَبِيدَةُ ،  عَنْ  إِبْرَاهِيمَ «  أَنَّهُ كَانَ لَا  يُجِيزُ  شَهَادَةَ النِّسَاءِ عَلَى الطَّلَاقِ  وَلَا عَلَى الْحُدُودِ  » .","","Sunan Sa'id ibn Mansur 877","","إبراهيم النخعي عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في شهادة النساء في النكاح"
"2055","878  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  إِبْرَاهِيمَ «  أَنَّهُ         [6/257]      كَانَ لَا  يُجِيزُ  شَهَادَةَ النِّسَاءِ عَلَى الْحُدُودِ  ، وَالطَّلَاقُ مِنْ أَشَدِّ الْحُدُودِ  » .","","Sunan Sa'id ibn Mansur 878","","إبراهيم النخعي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في شهادة النساء في النكاح"
"2056","879  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، «  أَنَّهُ كَانَ لَا  يُجِيزُ  شَهَادَةَ النِّسَاءِ عَلَى الطَّلَاقِ  » .","","Sunan Sa'id ibn Mansur 879","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في شهادة النساء في النكاح"
"2057","880  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَطَاءُ بْنُ السَّائِبِ ، قَالَ :  سَأَلْتُ  إِبْرَاهِيمَ عَنْ شَهَادَةِ رَجُلٍ وَامْرَأَتَيْنِ عَلَى الطَّلَاقِ  ، قَالَ  إِبْرَاهِيمُ  : « لَوْ شَهِدَ  تَمِيمُ بْنُ سَلَمَةَ  وَكَذَا وَكَذَا امْرَأَةً عَلَى الطَّلَاقِ لَمْ يَجُزْ ذَلِكَ  »  .","","Sunan Sa'id ibn Mansur 880","","إبراهيم النخعي عن عطاء بن السائب عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في شهادة النساء في النكاح"
"2058","881  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  زَكَرِيَّا ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  لَا تَجُوزُ شَهَادَةُ النِّسَاءِ عَلَى الْحُدُودِ  » .","","Sunan Sa'id ibn Mansur 881","","الشعبي عن زكريا بن أبي زائدة الوادعي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في شهادة النساء في النكاح"
"2059","بَابُ الْمَرْأَةِ تَمْلِكُ مِنْ زَوْجِهَا شَيْئًا  882  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  إِذَا مَلَكَتِ الْمَرْأَةُ مِنْ زَوْجِهَا شَيْئًا حَرُمَتْ عَلَيْهِ  ، فَإِنْ أَعْتَقَتْهُ سَاعَةَ تَمْلِكُهُ فَهُمَا عَلَى نِكَاحِهِمَا  » .","","Sunan Sa'id ibn Mansur 882","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تملك من زوجها شيئا"
"2060","883  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ أَنَّهُ كَانَ يَقُولُ : «  إِذَا مَلَكَتِ الْمَرْأَةُ شَيْئًا مِنْ زَوْجِهَا فَقَدْ حَرُمَتْ عَلَيْهِ  وَهِيَ مُطَلَّقَةٌ بَائِنَةٌ ، فَإِنْ أَعْتَقَتْهُ فَكَذَلِكَ » .         [6/258]","","Sunan Sa'id ibn Mansur 883","","الحسن البصري عن يونس بن يزيدالأيلي عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تملك من زوجها شيئا"
"2061","884  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  حَجَّاجٌ ،  عَنِ  الشَّعْبِيِّ ، وَعَطَاءٍ ، قَالَا : «  حَرُمَتْ ، فَإِنْ كَانَتْ مِنْ شَأْنِهِ فَلْيَخْطُبْهَا  » .","","Sunan Sa'id ibn Mansur 884","","عطاء بن أبي رباح عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تملك من زوجها شيئا"
"2062","بَابُ الرَّجُلِ يَفْجُرُ بِالْمَرْأَةِ ثُمَّ يَتَزَوَّجُهَا  885  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ ،  عَنْ  أَبِيهِ  ،  أَنَّ  رَجُلًا تَزَوَّجَ امْرَأَةً وَلَهَا ابْنَةٌ وَلَهُ ابْنٌ مِنْ غَيْرِهَا ، فَفَجَرَ بِهَا  ، فَقَدِمَ عُمَرُ  مَكَّةَ  ، فَرَفَعَهُمَا إِلَيْهِ فَحَدَّهُمَا ، وَحَرَصَ أَنْ يَجْمَعَ بَيْنَهُمَا ، فَأَبَى ذَلِكَ الْغُلَامُ  .","","Sunan Sa'id ibn Mansur 885","","عمر بن الخطاب عن أبو يزيد مولى آل قارظ عن عبيد الله بن أبي يزيد الكناني عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2063","886  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ، قَالَ :  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ أَبِي يَزِيدَ قَالَ :  سَأَلْتُ  ابْنَ عَبَّاسٍ عَنْ رَجُلٍ فَجَرَ بِامْرَأَةٍ ، أَيَنْكِحُهَا ؟  قَالَ : « نَعَمْ ، ذَاكَ حِينَ أَصَابَ الْحَلَالَ » .","","Sunan Sa'id ibn Mansur 886","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2064","887  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ ،  وَسَأَلْتُهُ عَنْ رَجُلٍ زَنَى بِامْرَأَةٍ ، يَتَزَوَّجُهَا ؟  قَالَ : « ذَاكَ حِينَ أَجَادَ أَمْرَهَا »  .","","Sunan Sa'id ibn Mansur 887","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن حماد بن زيد عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2065","888  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  دَاوُدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ ،  أَنَّهُ سَأَلَ  ابْنَ عَبَّاسٍ ، فَقَالَ  ابْنُ عَبَّاسٍ  : «  الْأَوَّلُ  سِفَاحٌ  ، وَالْآخَرُ نِكَاحٌ  » .         [6/259]","","Sunan Sa'id ibn Mansur 888","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن عبد الله بن أبي نجيح عن داود ابن النصراني عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2066","889  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَلَفُ بْنُ خَلِيفَةَ ،  نَا  أَبُو هَاشِمٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّهُ سُئِلَ عَنْ ذَاكَ ، فَقَالَ : «  أَوَّلُهُ  سِفَاحٌ ،  وَآخِرُهُ نِكَاحٌ  » .","","Sunan Sa'id ibn Mansur 889","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن يحيى بن دينار الرماني عن خلف بن خليفة الأشجعي عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2067","890  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، مِثْلَهُ .","","Sunan Sa'id ibn Mansur 890","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2068","891  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  حُصَيْنٌ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، مِثْلَهُ .","","Sunan Sa'id ibn Mansur 891","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن حصين بن عبد الرحمن السلمي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2069","892  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  وَعَبْدُ الْمَلِكِ  ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  وَدَاوُدُ بْنُ أَبِي هِنْدٍ  ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّهُ كَانَ يَقُولُ : «  أَوَّلُهُ  سِفَاحٌ ،  وَآخِرُهُ نِكَاحٌ  »  .","","Sunan Sa'id ibn Mansur 892","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2070","893  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  أَبُو نَعَامَةَ الضَّبِّيُّ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّهُ قَالَ : «  أَوَّلُهُ  سِفَاحٌ ،  وَآخِرُهُ نِكَاحٌ  ، حَلَّتْ لَهُ بِمَالِهِ  »  .","","Sunan Sa'id ibn Mansur 893","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن محمد بن شيبة بن نعامة الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2071","894  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  سَيَّارٌ ،  عَنْ  عِكْرِمَةَ  أَنَّهُ كَانَ يَقُولُ فِي الرَّجُلِ يَفْجُرُ الْمَرْأَةَ ثُمَّ يَتَزَوَّجُهَا  قَالَ : « مَثَلُهُ كَمَثَلِ رَجُلٍ أَخَذَ مِنْ  ثَمَرِ  نَخْلَةٍ بِغَيْرِ أَمْرِ صَاحِبِهَا فَكَانَ حَرَامًا ، ثُمَّ اشْتَرَاهَا فَكَانَ لَهُ حَلَالًا  » .","","Sunan Sa'id ibn Mansur 894","","عكرمة مولى ابن عباس عن سيار بن أبي سيار العنزي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2072","895  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ قَالَ :  أَنَا  عُبَيْدَةُ ،  عَنْ  أَبِي جَعْفَرٍ مُحَمَّدِ بْنِ عَلِيٍّ  أَنَّهُ سُئِلَ عَنْ ذَلِكَ ، قَالَ : «  إِنَّمَا مَثَلُهُ مَثَلُ رَجُلٍ أَتَى بَيْدَرًا وَأَخَذَ مِنْهَا بِغَيْرِ أَمْرِ صَاحِبِهَا فَكَانَ حَرَامًا  ، ثُمَّ اشْتَرَاهُ فَكَانَ حَلَالًا  » .","","Sunan Sa'id ibn Mansur 895","","أبو جعفر الباقر عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2073","896  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،         [6/260]      عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  فِي الرَّجُلِ يَفْجُرُ بِالْمَرْأَةِ ثُمَّ يَتَزَوَّجُهَا  قَالَ : « لَا يَزَالَانِ زَانِيَيْنِ مَا اجْتَمَعَا  » .","","Sunan Sa'id ibn Mansur 896","","عبد الله بن مسعود عن رافع الغطفاني عن سالم بن أبي الجعد الغطفاني عن قتادة بن دعامة عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2074","897  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَائِشَةَ ، رَضِيَ اللهُ عَنْهَا ،  وَدَاوُدُ  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَائِشَةَ ، رَضِيَ اللهُ عَنْهَا قَالَتْ : «  هُمَا زَانِيَانِ مَا اضْطَجَعَا  »  .","","Sunan Sa'id ibn Mansur 897","","عائشة بنت أبي بكر الصديق عن الشعبي عن داود بن أبي هند عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2075","898  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُطَرِّفٌ ،  عَنْ  سُلَيْمَانَ بْنِ الْجَهْمِ الْكِنْدِيِّ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ قَالَ : «  هُمَا زَانِيَانِ مَا اجْتَمَعَا  »  .","","Sunan Sa'id ibn Mansur 898","","البراء بن عازب الأوسي عن سليمان بن الجهم الجوزجانى عن مطرف بن طريف عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2076","899  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  دَاوُدُ بْنُ عُلْبَةَ  ، قَالَ :  نَا  مُطَرِّفٌ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَائِشَةَ ، رَضِيَ اللهُ عَنْهَا  فِي الرَّجُلِ يَفْجُرُ بِالْمَرْأَةِ ثُمَّ يَتَزَوَّجُهَا  ، قَالَتْ : « حَرَامٌ إِلَى يَوْمِ الْقِيَامَةِ  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، ولعل الصواب : ( ذواد )","","Sunan Sa'id ibn Mansur 899","","عائشة بنت أبي بكر الصديق عن الشعبي عن مطرف بن طريف عن ذواد بن علبة الحارثي عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2077","900  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ  أَنَّهُ سُئِلَ عَنْ ذَلِكَ ، فَتَلَا هَذِهِ الْآيَةَ :         {      وَهُوَ الَّذِي يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ وَيَعْفُو عَنِ السَّيِّئَاتِ وَيَعْلَمُ مَا  يَفْعَلُونَ         }      .","","Sunan Sa'id ibn Mansur 900","","علقمة بن قيس النخعي عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2078","901  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ،  نَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  أَتَى رَجُلٌ عَلْقَمَةَ ، فَقَالَ لَهُ : رَجُلٌ فَجَرَ بِامْرَأَةٍ ، أَيَتَزَوَّجُهَا ؟  قَالَ  : نَعَمْ . وَقَرَأَ         [6/261]      عَلَيْهِ هَذِهِ الْآيَةَ :         {      وَهُوَ الَّذِي يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ وَيَعْفُو عَنِ السَّيِّئَاتِ وَيَعْلَمُ مَا  يَفْعَلُونَ         }      .","","Sunan Sa'id ibn Mansur 901","","علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2079","902  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَبُو جَنَابٍ الْكَلْبِيُّ ،  عَنْ  بُكَيْرِ بْنِ الْأَخْنَسِ ،  عَنْ  أَبِيهِ  قَالَ :  امْتَرَيْنَا فِي قِرَاءَةِ هَذَا الْحَرْفِ :         {      وَهُوَ الَّذِي يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ وَيَعْفُو عَنِ السَّيِّئَاتِ وَيَعْلَمُ مَا  يَفْعَلُونَ         }      أَوْ         {      تَفْعَلُونَ         }      ،  فَأَتَيْتُ  ابْنَ مَسْعُودٍ لِأَسْأَلَهُ عَنْ ذَلِكَ ، فَبَيْنَا أَنَا عِنْدَهُ إِذْ أَتَاهُ آتٍ ، فَقَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، رَجُلٌ أَصَابَ مِنِ امْرَأَةٍ حَرَامًا ، ثُمَّ تَابَا وَأَصْلَحَا ، أَيَتَزَوَّجُهَا ؟ فَتَلَا  عَبْدُ اللهِ  :         {      وَهُوَ الَّذِي يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ وَيَعْفُو عَنِ السَّيِّئَاتِ وَيَعْلَمُ مَا  يَفْعَلُونَ         }      .","","Sunan Sa'id ibn Mansur 902","","عبد الله بن مسعود عن الأخنس السدوسي عن بكير بن الأخنس السدوسي عن يحيى بن أبي حية عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2080","903  -  حَدَّثَنَا  سَعِيدٌ  قَالَ  خَلَفُ بْنُ خَلِيفَةَ ،  نَا  أَبُو جَنَابٍ يَحْيَى بْنُ أَبِي حَيَّةَ الْكَلْبِيُّ ،  عَنْ  بُكَيْرِ بْنِ الْأَخْنَسِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ، مِثْلَهُ ، فَقَالَ :  لِيَتَزَوَّجْهَا  .","","Sunan Sa'id ibn Mansur 903","","عبد الله بن مسعود عن الأخنس السدوسي عن بكير بن الأخنس السدوسي عن يحيى بن أبي حية عن خلف بن خليفة الأشجعي عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2081","904  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ  فِي الرَّجُلِ يَفْجُرُ بِالْمَرْأَةِ ثُمَّ يَتَزَوَّجُهَا  ، قَالَ : « هُوَ أَحَقُّ بِهَا  » .","","Sunan Sa'id ibn Mansur 904","","جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2082","905  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  عَتَّابٌ ، قَالَ :  أَنَا  خُصَيْفٌ ،  عَنْ  مُجَاهِدٍ ، قَالَ : «  إِذَا زَنَى الرَّجُلُ بِالْمَرْأَةِ لَمْ يَصْلُحْ لَهُ أَنْ يَتَزَوَّجَهَا  » .","","Sunan Sa'id ibn Mansur 905","","مجاهد بن جبر المخزومي عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2083","906  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  أَنَّ  أَبَا الشَّعْثَاءِ  أَمَرَهُ أَنْ يَسْأَلَ عِكْرِمَةَ عَنْ رَجُلٍ فَجَرَ بِامْرَأَةٍ  ، فَرَآهَا تُرْضِعُ جَارِيَةً ، أَيُصْلِحُ لَهُ أَنْ يَتَزَوَّجَ الْجَارِيَةَ ؟ فَسَأَلْتُهُ ، فَقَالَ : لَا  .","","Sunan Sa'id ibn Mansur 906","","عكرمة مولى ابن عباس عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يفجر بالمرأة ثم يتزوجها"
"2084","[6/262]      بَابُ الرَّجُلِ  يُعْتِقُ  أَمَتَهُ ثُمَّ يَتَزَوَّجُهَا .  907  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ صُهَيْبٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ «  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَعْتَقَ  صَفِيَّةَ بِنْتَ حُيَيِّ بْنِ أَخْطَبَ  أَمَتَهُ وَتَزَوَّجَهَا  ، فَقِيلَ  لِأَنَسٍ  : مَا أَصْدَقَهَا ؟ قَالَ : أَصْدَقَهَا نَفْسَهَا ، جَعَلَ عِتْقَهَا صَدَاقَهَا  » .","","Sunan Sa'id ibn Mansur 907","","أنس بن مالك عن عبد العزيز بن صهيب البناني عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يعتق أمته ثم يتزوجها"
"2085","908  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  زَكَرِيَّا ،  عَنِ  الشَّعْبِيِّ «  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَعْتَقَ  جُوَيْرِيَةَ بِنْتَ الْحَارِثِ  ، وَجَعَلَ صَدَاقَهَا عِتْقَهَا  ، وَأَعْتَقَ مَنْ سَبَى مِنْ قَوْمِهَا مِنْ  بَنِي الْمُصْطَلِقِ  » .","","Sunan Sa'id ibn Mansur 908","","الشعبي عن زكريا بن أبي زائدة الوادعي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يعتق أمته ثم يتزوجها"
"2086","909  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  قَالَتْ  جُوَيْرِيَةُ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : « إِنَّ أَزْوَاجَكَ يَفْخَرْنَ عَلَيَّ ، يَقُلْنَ : لَمْ يَتَزَوَّجْكِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . قَالَ :  أَوَلَمْ أُعْظِمْ صَدَاقَكِ ؟ أَلَمْ  أُعْتِقْ  أَرْبَعِينَ مِنْ قَوْمِكِ  ؟ .","","Sunan Sa'id ibn Mansur 909","","جويرية بنت الحارث المصطلقية عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يعتق أمته ثم يتزوجها"
"2087","910  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  يَحْيَى بْنِ جَعْدَةَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : «  ثَلَاثَةٌ يُعْطَوْنَ أُجُورَهُمْ مَرَّتَيْنِ  : رَجُلٌ مِنْ أَهْلِ الْكِتَابِ آمَنَ بِمَا جَاءَ بِهِ  عِيسَى  وَبِمَا جَاءَ بِهِ  مُحَمَّدٌ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَعَبْدٌ أَطَاعَ رَبَّهُ وَأَطَاعَ مَوَالِيَهُ ، وَرَجُلٌ أَعْتَقَ جَارِيَةً ثُمَّ تَزَوَّجَهَا » .","","Sunan Sa'id ibn Mansur 910","","يحيى بن جعدة بن هبيرة المخزومي عن عمرو بن دينار الأثرم عن حماد بن زيد عن سعيد بن منصور","باب الرجل يعتق أمته ثم يتزوجها"
"2088","911  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  يَحْيَى بْنِ جَعْدَةَ ،         [6/263]      يَبْلُغُ بِهِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : «  ثَلَاثَةٌ يُعْطَوْنَ أُجُورَهُمْ مَرَّتَيْنِ  : الرَّجُلُ تَكُونُ لَهُ الْأَمَةُ  فَيُعْتِقُهَا  فَيَتَزَوَّجُهَا ، وَالْعَبْدُ يُطِيعُ اللهَ عَزَّ وَجَلَّ وَيُؤَدِّي حَقَّ سَيِّدِهِ ، وَمُؤْمِنُ أَهْلِ الْكِتَابِ » .","","Sunan Sa'id ibn Mansur 911","","يحيى بن جعدة بن هبيرة المخزومي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يعتق أمته ثم يتزوجها"
"2089","912  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُطَرِّفٍ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ فِي «  الَّذِي  يُعْتِقُ  أَمَتَهُ ثُمَّ يَتَزَوَّجُهَا ، فَلَهُ أَجْرَانِ  » .","","Sunan Sa'id ibn Mansur 912","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن الشعبي عن مطرف بن طريف عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يعتق أمته ثم يتزوجها"
"2090","913  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  صَالِحُ بْنُ حَيٍّ الْهَمْدَانِيُّ ، قَالَ :  كُنْتُ عِنْدَ  الشَّعْبِيِّ  ، فَأَتَاهُ رَجُلٌ مِنْ أَهْلِ خُرَاسَانَ ، فَقَالَ : يَا  أَبَا عَمْرٍو  ، إِنَّ مَنْ قِبَلَنَا مِنْ  أَهْلِ خُرَاسَانَ  يَقُولُونَ فِي الرَّجُلِ إِذَا أَعْتَقَ أَمَتَهُ ثُمَّ تَزَوَّجَهَا فَهُوَ كَالرَّاكِبِ  بَدَنَتَهُ  .  فَقَالَ  الشَّعْبِيُّ :  أَخْبَرَنِي  أَبُو بُرْدَةَ بْنُ أَبِي مُوسَى ،  عَنْ  أَبِيهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : «  ثَلَاثَةٌ يُؤْتَوْنَ أَجْرَهُمْ مَرَّتَيْنِ  : رَجُلٌ مِنْ أَهْلِ الْكِتَابِ آمَنَ بِنَبِيِّهِ ، ثُمَّ أَدْرَكَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَآمَنَ بِهِ ثُمَّ اتَّبَعَهُ فَلَهُ أَجْرَانِ ، وَعَبْدٌ مَمْلُوكٌ يُؤَدِّي حَقَّ اللهِ وَحَقَّ سَيِّدِهِ عَلَيْهِ فَلَهُ أَجْرَانِ ، وَرَجُلٌ كَانَتْ لَهُ أَمَةٌ غَذَّاهَا فَأَحْسَنَ غِذَاءَهَا ، ثُمَّ أَدَّبَهَا فَأَحْسَنَ أَدَبَهَا ، ثُمَّ أَعْتَقَهَا فَتَزَوَّجَهَا ، فَلَهُ أَجْرَانِ » ، ثُمَّ قَالَ  الشَّعْبِيُّ  لِلْخُرَاسَانِيِّ  : خُذْهَا بِغَيْرِ شَيْءٍ ، فَقَدْ كَانَ الرَّجُلُ يَرْحَلُ إِلَى  الْمَدِينَةِ  فِيمَا هُوَ أَدْنَى مِنْهُ  .         [6/264]","","Sunan Sa'id ibn Mansur 913","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن الشعبي عن صالح بن صالح بن حي الثوري عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يعتق أمته ثم يتزوجها"
"2091","914  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  صَالِحِ بْنِ حَيٍّ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  سَأَلَهُ رَجُلٌ مِنْ أَهْلِ خُرَاسَانَ ، فَقَالَ لَهُ : يَا  أَبَا عَمْرٍو  ، إِنَّا نَقُولُ : إِنَّ الَّذِي  يُعْتِقُ  أَمَتَهُ ثُمَّ يَتَزَوَّجُ بِهَا فَهُوَ كَرَاكِبٍ  بَدَنَتَهُ  . فَقَالَ :  أَخْبَرَنِي  أَبُو بُرْدَةَ ،  عَنْ  أَبِيهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : «  أَيُّمَا رَجُلٍ كَانَتْ لَهُ جَارِيَةٌ فَعَلَّمَهَا فَأَحْسَنَ تَعْلِيمَهَا  ، وَأَدَّبَهَا فَأَحْسَنَ تَأْدِيبَهَا ، ثُمَّ أَعْتَقَهَا وَتَزَوَّجَهَا ، فَلَهُ أَجْرَانِ ، وَأَيُّمَا عَبْدٍ أَدَّى حَقَّ اللهِ وَحَقَّ سَيِّدِهِ فَلَهُ أَجْرَانِ ، وَأَيُّمَا رَجُلٍ مِنْ أَهْلِ الْكِتَابِ كَانَ مُؤْمِنًا ثُمَّ آمَنَ بِالنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَهُ أَجْرَانِ » ، ثُمَّ قَالَ  الشَّعْبِيُّ  : أَعْطَيْتُكَهَا بِغَيْرِ شَيْءٍ ، فَقَدْ كَانَ الرَّجُلُ يَرْحَلُ إِلَى  الْمَدِينَةِ  بِأَهْوَنَ مِنْ هَذَا  .","","Sunan Sa'id ibn Mansur 914","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن الشعبي عن صالح بن صالح بن حي الثوري عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يعتق أمته ثم يتزوجها"
"2092","915  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ كَانَ يَقُولُ  فِي الرَّجُلِ يَتَزَوَّجُ  مُحَرَّرَتَهُ  : « فَهُوَ كَالرَّاكِبِ  بَدَنَتَهُ  »  . قَالَ : وَكَانَ إِبْرَاهِيمُ وَأَصْحَابُنَا «  لَا يَرَوْنَ بِذَلِكَ بَأْسًا ، وَكَانَ أَحَبُّ ذَلِكَ إِلَيْهِمْ أَنْ يَجْعَلُوا عِتْقَهَا صَدَاقَهَا  »  .","","Sunan Sa'id ibn Mansur 915","","عبد الله بن عمر بن الخطاب عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يعتق أمته ثم يتزوجها"
"2093","916  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  فِي الرَّجُلِ  يُعْتِقُ  الْجَارِيَةَ لِلهِ عَزَّ وَجَلَّ ثُمَّ يَتَزَوَّجُهَا قَالَ : كَانَ ابْنُ عُمَرَ  يَقُولُ  : «  هُوَ كَالرَّاكِبِ  بَدَنَتَهُ  »  .  قَالَ  : وَكَانَ أَعْجَبُ ذَاكَ إِلَى أَصْحَابِنَا أَنْ يَجْعَلُوا عِتْقَهَا صَدَاقَهَا .         [6/265]","","Sunan Sa'id ibn Mansur 916","","عبد الله بن عمر بن الخطاب عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب الرجل يعتق أمته ثم يتزوجها"
"2094","917  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  ابْنِ سِيرِينَ ، «  أَنَّهُ  كَانَ يُحِبُّ أَنْ يَجْعَلَ لَهَا مَعَ عِتْقِهَا شَيْئًا مَا كَانَ  »  .","","Sunan Sa'id ibn Mansur 917","","محمد بن سيرين عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يعتق أمته ثم يتزوجها"
"2095","918  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ «  أَنَّهُ  كَانَ لَا يَرَى بَأْسًا أَنْ يَجْعَلَ عِتْقَهَا صَدَاقَهَا  »  .","","Sunan Sa'id ibn Mansur 918","","سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يعتق أمته ثم يتزوجها"
"2096","919  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  وَمُغِيرَةَ  ،  عَنْ  إِبْرَاهِيمَ ،  وَيُونُسَ  ،  عَنِ  الْحَسَنِ ، قَالَ :  وَأَنَا  عَبْدُ الْمَلِكِ ،  عَنْ  عَطَاءٍ «  أَنَّهُمْ لَمْ يَرَوْا بِذَلِكَ بَأْسًا  »  .","","Sunan Sa'id ibn Mansur 919","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يعتق أمته ثم يتزوجها"
"2097","920  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  شَرِيكٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ قَالَ : «  لَا يَقُلْ : قَدْ أَعْتَقْتُكِ وَتَزَوَّجْتُكِ  ، وَلَكِنْ لِيَقُلْ : أَعْتَقْتُكِ عَلَى أَنْ أَتَزَوَّجَكِ  »  .","","Sunan Sa'id ibn Mansur 920","","إبراهيم النخعي عن منصور بن المعتمر عن شريك بن عبد الله بن أبي نمر الكناني عن سعيد بن منصور","باب الرجل يعتق أمته ثم يتزوجها"
"2098","921  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَبْدُ الْمَلِكِ بْنُ أَبِي سُلَيْمَانَ ، قَالَ :  سَمِعْتُ  عَطَاءً ، يَقُولُ : «  إِذَا قَالَ الرَّجُلُ لِأَمَتِهِ : قَدْ أَعْتَقْتُكِ وَتَزَوَّجْتُكِ ، فَهِيَ امْرَأَتُهُ  ، وَإِذَا قَالَ :  أُعْتِقُكِ  وَأَتَزَوَّجُكِ فَأَعْتَقَهَا ، فَإِنْ شَاءَتْ تَزَوَّجَتْهُ ، وَإِنْ شَاءَتْ لَمْ تَزَوَّجْهُ  »  .","","Sunan Sa'id ibn Mansur 921","","عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يعتق أمته ثم يتزوجها"
"2099","بَابُ الرَّجُلِ يَتَزَوَّجُ الْمَرْأَةَ فَيَمُوتُ وَلَمْ يَفْرِضْ لَهَا صَدَاقًا .  922  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،         [6/266]      عَنْ  عَبْدِ خَيْرٍ ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ  أَنَّهُ قَالَ  فِي الْمُتَوَفَّى عَنْهَا وَلَمْ يَفْرِضْ لَهَا صَدَاقًا قَالَ : « لَهَا الْمِيرَاثُ  ، وَلَا صَدَاقَ لَهَا  »  .","","Sunan Sa'id ibn Mansur 922","","علي بن أبي طالب عن عبد خير بن يزيد الخيواني عن عطاء بن السائب عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يتزوج المرأة فيموت ولم يفرض لها صداقا"
"2100","923  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدٌ ،  عَنْ  مُطَرِّفٍ ،  عَنِ  الْحَكَمِ ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 923","","علي بن أبي طالب عن الحكم بن عتيبة الكندي عن مطرف بن طريف عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يتزوج المرأة فيموت ولم يفرض لها صداقا"
"2101","924  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُحَمَّدُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ أَنَّهُ قَالَ : «  لَهَا الْمِيرَاثُ وَعَلَيْهَا الْعِدَّةُ  ، وَلَا صَدَاقَ لَهَا  » .","","Sunan Sa'id ibn Mansur 924","","علي بن أبي طالب عن الشعبي عن محمد بن سالم الهمداني عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة فيموت ولم يفرض لها صداقا"
"2102","925  -  حَدَّثَنَا  سَعِيدٌ ،  ثَنَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  أَنَّ  ابْنَ عُمَرَ زَوَّجَ ابْنًا لَهُ ابْنَةَ أَخِيهِ  عُبَيْدِ اللهِ بْنِ عُمَرَ  ، وَابْنُهُ صَغِيرٌ يَوْمَئِذٍ  وَلَمْ يَفْرِضْ لَهَا صَدَاقًا ، فَمَكَثَ الْغُلَامُ مَا مَكَثَ ، ثُمَّ مَاتَ ، فَخَاصَمَ خَالُ الْجَارِيَةِ  ابْنَ عُمَرَ  إِلَى  زَيْدِ بْنِ ثَابِتٍ  ، فَقَالَ  ابْنُ عُمَرَ  لِزَيْدٍ  : « إِنِّي زَوَّجْتُ ابْنِي ، وَأَنَا أُحَدِّثُ نَفْسِي أَنْ أَصْنَعَ بِهِ خَيْرًا ، فَمَاتَ قَبْلَ ذَلِكَ ، وَلَمْ يَفْرِضْ لِلْجَارِيَةِ صَدَاقًا .  فَقَالَ  زَيْدٌ : فَلَهَا الْمِيرَاثُ إِنْ كَانَ لِلْغُلَامِ مَالٌ ، وَعَلَيْهَا الْعِدَّةُ ، وَلَا صَدَاقَ لَهَا  »  .","","Sunan Sa'id ibn Mansur 925","","زيد بن ثابت الأنصاري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة فيموت ولم يفرض لها صداقا"
"2103","926  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  دَاوُدَ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  أَنَّ  ابْنَ عُمَرَ ، وَزَيْدَ بْنَ ثَابِتٍ  قَالَا  فِي رَجُلٍ تَزَوَّجَ امْرَأَةً وَلَمْ يَفْرِضْ لَهَا صَدَاقًا فَمَاتَ  ، قَالَا : « لَهَا الْمِيرَاثُ ، وَلَا صَدَاقَ لَهَا  » .  قَالَ  مَسْرُوقٌ : «  مَا كَانَ مِيرَاثٌ قَطُّ إِلَّا كَانَ قَبْلَهُ صَدَاقٌ  » .         [6/267]","","Sunan Sa'id ibn Mansur 926","","زيد بن ثابت الأنصاري عن الشعبي عن داود بن أبي هند عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يتزوج المرأة فيموت ولم يفرض لها صداقا"
"2104","927  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  دَاوُدُ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  ذُكِرَ قَوْلُ  أَهْلِ الْمَدِينَةِ  هَذَا  لِمَسْرُوقٍ  ،  فَقَالَ  مَسْرُوقٌ : «  مَا كَانَ مِيرَاثٌ قَطُّ إِلَّا وَبَيْنَ يَدَيْهِ صَدَاقٌ  » .","","Sunan Sa'id ibn Mansur 927","","مسروق بن الأجدع عن الشعبي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة فيموت ولم يفرض لها صداقا"
"2105","928  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  عَطَّافُ بْنُ خَالِدٍ ،  عَنْ  نَافِعٍ ، قَالَ :  زَوَّجَ  ابْنُ عُمَرَ  ابْنَهُ ابْنَةَ أَخِيهِ ، فَمَاتَتِ الْجَارِيَةُ قَبْلَ أَنْ يَفْرِضَ لَهَا صَدَاقًا  ، فَسَأَلَتْ أُمُّهَا صَدَاقَهَا ، فَقَالَ  ابْنُ عُمَرَ  : « لَيْسَ لَهَا صَدَاقٌ . فَاخْتَصَمُوا إِلَى زَيْدِ بْنِ ثَابِتٍ ،  فَقَالَ  : لَيْسَ لَهَا صَدَاقٌ ، وَلَهَا الْمِيرَاثُ  .","","Sunan Sa'id ibn Mansur 928","","زيد بن ثابت الأنصاري عن نافع مولى ابن عمر عن عطاف بن خالد المخزومي عن سعيد بن منصور","باب الرجل يتزوج المرأة فيموت ولم يفرض لها صداقا"
"2106","929  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  ،  أَنَّهُ أُتِيَ فِي رَجُلٍ تَزَوَّجَ امْرَأَةً وَلَمْ يَفْرِضْ لَهَا صَدَاقًا ، فَمَاتَ قَبْلَ أَنْ يَدْخُلَ بِهَا ، فَأَتَوُا  ابْنَ مَسْعُودٍ  ، فَقَالَ : « الْتَمِسُوا ، فَلَعَلَّكُمْ أَنْ تَجِدُوا فِي ذَلِكَ أَثَرًا . فَأَتَوُا  ابْنَ مَسْعُودٍ  فَقَالُوا : قَدِ الْتَمَسْنَا فَلَمْ نَجِدْ . فَقَالَ  ابْنُ مَسْعُودٍ  : أَقُولُ فِيهَا بِرَأْيِي ، فَإِنْ كَانَ صَوَابًا فَمِنَ اللهِ عَزَّ وَجَلَّ ، أَرَى لَهَا صَدَاقَ نِسَائِهَا ، وَلَا  وَكْسَ  وَلَا  شَطَطَ  ، وَعَلَيْهَا الْعِدَّةُ ، وَلَهَا الْمِيرَاثُ . فَقَامَ أَبُو سِنَانٍ الْأَشْجَعِيُّ ،  فَقَالَ  :  قَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي امْرَأَةٍ مِنَّا يُقَالُ لَهَا  بَرْوَعُ بِنْتُ وَاشِقٍ  بِمِثْلِ مَا قُلْتَ . فَفَرِحَ  عَبْدُ اللهِ  بِمُوَافَقَتِهِ قَضَاءَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  »  .","","Sunan Sa'id ibn Mansur 929","","معقل بن سنان بن مظهر الأشجعي عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة فيموت ولم يفرض لها صداقا"
"2107","930  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  سَيَّارٌ ، وَإِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ، وَدَاوُدُ ،         [6/268]      كُلُّهُمْ  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ ، بِمِثْلِ ذَلِكَ ، إِلَّا أَنَّهُمْ قَالُوا : قَامَ مَعْقِلُ بْنُ سِنَانٍ الْأَشْجَعِيُّ ،  فَقَالَ  :  أَشْهَدُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْأُمِّيِّ أَنَّهُ قَضَى بِمِثْلِ مَا قَضَيْتَ  . قَالَ  هُشَيْمٌ  : وَبِهِ نَأْخُذُ  .","","Sunan Sa'id ibn Mansur 930","","معقل بن سنان بن مظهر الأشجعي عن الشعبي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة فيموت ولم يفرض لها صداقا"
"2108","931  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  نَا  أَبُو إِسْحَاقَ الْكُوفِيُّ ،  عَنْ  مَزِيدَةَ بْنِ جَابِرٍ ،  أَنَّ  عَلِيًّا ، رَضِيَ اللهُ عَنْهُ قَالَ : «  لَا يُقْبَلُ قَوْلُ أَعْرَابِيٍّ [ مِنْ ]  أَشْجَعَ  عَلَى كِتَابِ اللهِ عَزَّ وَجَلَّ  » .","","Sunan Sa'id ibn Mansur 931","","علي بن أبي طالب عن مزيدة بن جابر الهجري عن عبد الله بن ميسرة الحارثي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة فيموت ولم يفرض لها صداقا"
"2109","932  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  زَكَرِيَّا ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  بَابٌ مِنَ الطَّلَاقِ جَسِيمٌ ، إِذَا وَرِثَتِ الْمَرْأَةُ اعْتَدَّتْ  » .","","Sunan Sa'id ibn Mansur 932","","الشعبي عن زكريا بن أبي زائدة الوادعي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة فيموت ولم يفرض لها صداقا"
"2110","933  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ فِي امْرَأَةٍ تُوَفِّيَ عَنْهَا زَوْجُهَا وَلَمْ يَفْرِضْ لَهَا صَدَاقًا قَالَ : «  لَهَا مِثْلُ صَدَاقِ نِسَائِهَا  » .","","Sunan Sa'id ibn Mansur 933","","الحسن البصري عن يونس بن عبيد عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يتزوج المرأة فيموت ولم يفرض لها صداقا"
"2111","934  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ، قَالَ :  حَدَّثَنِي  عَطَاءٌ الْخُرَاسَانِيُّ ، قَالَ :  كَتَبَ  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ إِلَى النَّاسِ فِي الرَّجُلِ يَتَزَوَّجُ الْمَرْأَةَ ، ثُمَّ يُطَلِّقُهَا قَبْلَ أَنْ يَدْخُلَ بِهَا  ، وَقَبْلَ أَنْ يَفْرِضَ لَهَا « أَنَّ لَهَا نِصْفَ الصَّدَاقِ ، وَلَا  عِدَّةَ  عَلَيْهَا ، وَلَا مِيرَاثَ لَهَا  » .","","Sunan Sa'id ibn Mansur 934","","عمر بن عبد العزيز بن مروان عن عطاء الخراساني عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يتزوج المرأة فيموت ولم يفرض لها صداقا"
"2112","[6/269]      بَابُ مَا جَاءَ فِي الرَّجُلِ يَتَزَوَّجُ الْمَرْأَةَ فَتَمُوتُ قَبْلَ أَنْ يَدْخُلَ بِهَا أَوْ يُطَلِّقَهَا ، هَلْ يَصْلُحُ لَهُ أَنْ يَتَزَوَّجَ أُمَّهَا .  935  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، وَخَالِدٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  فِي الرَّجُلِ يَتَزَوَّجُ الْمَرْأَةَ فَتَمُوتُ قَبْلَ -  أُرَاهُ قَالَ : أَنْ يَدْخُلَ بِهَا  - أَيَتَزَوَّجُ أُمَّهَا  ؟  فَقَالَ  : كَانَ شُرَيْحٌ إِذَا أُتِيَ فِي ذَلِكَ يَقُولُ : « ائْتُوا  بَنِي شَمْخٍ  فَسَلُوهُمْ عَنْ ذَلِكَ  »  .","","Sunan Sa'id ibn Mansur 935","","شريح بن الحارث الكندي عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فتموت قبل أن يدخل بها أو يطلقها هل يصلح له أن يتزوج أمها"
"2113","936  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حُدَيْجُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَعْدِ بْنِ إِيَاسٍ ، عَنْ  رَجُلٍ تَزَوَّجَ امْرَأَةً مِنْ بَنِي شَمْخٍ ، ثُمَّ أَبْصَرَ أُمَّهَا فَأَعْجَبَتْهُ  ، فَذَهَبَ إِلَى ابْنِ مَسْعُودٍ ، فَقَالَ : « إِنِّي تَزَوَّجْتُ بِامْرَأَةٍ فَلَمْ أَدْخُلْ بِهَا ، ثُمَّ أَعْجَبَتْنِي أُمُّهَا ، فَأُطَلِّقُ الْمَرْأَةَ وَأَتَزَوَّجُ أُمَّهَا ؟  قَالَ  : نَعَمْ . فَطَلَّقَهَا وَتَزَوَّجَ أُمَّهَا ، فَأَتَى عَبْدُ اللهِ  الْمَدِينَةَ  ، فَسَأَلَ أَصْحَابَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا : لَا يَصْلُحُ . ثُمَّ قَدِمَ فَأَتَى  بَنِي شَمْخٍ  ، فَقَالَ : أَيْنَ الرَّجُلُ الَّذِي تَزَوَّجَ أُمَّ الْمَرْأَةِ الَّتِي كَانَتْ عِنْدَهُ ؟ قَالُوا : هَاهُنَا . قَالَ : فَلْيُفَارِقْهَا . قَالُوا : كَيْفَ وَقَدْ  نَثَرَتْ  لَهُ بَطْنَهَا ؟ قَالَ : وَإِنْ كَانَتْ فَعَلَتْ ، فَلْيُفَارِقْهَا ، فَإِنَّهَا حَرَامٌ مِنَ اللهِ عَزَّ وَجَلَّ  »  .         [6/270]","","Sunan Sa'id ibn Mansur 936","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن أبو إسحاق السبيعي عن حديج بن معاوية بن حديج  الجعفي عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فتموت قبل أن يدخل بها أو يطلقها هل يصلح له أن يتزوج أمها"
"2114","937  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  دَاوُدُ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  أَنَّهُ  سُئِلَ عَنْ قَوْلِ اللهِ ، عَزَّ وَجَلَّ :         {      وَأُمَّهَاتُ نِسَائِكُمْ         }      فَقَالَ  ابْنُ عَبَّاسٍ : « هِيَ مُبْهَمَةٌ  ، فَأَرْسِلُوا مَا أَرْسَلَ اللهُ ، وَاتَّبِعُوا مَا بَيَّنَ اللهُ عَزَّ وَجَلَّ . قَالَ : رَخَّصَ فِي الرَّبِيبَةِ إِذَا لَمْ يَكُنْ دَخَلَ بِأُمِّهَا ، وَكَرِهَ الْأُمَّ عَلَى كُلِّ حَالٍ  »  .","","Sunan Sa'id ibn Mansur 937","","عبد الله بن عباس عن مسروق بن الأجدع عن الشعبي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فتموت قبل أن يدخل بها أو يطلقها هل يصلح له أن يتزوج أمها"
"2115","938  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  قَالَ  :  هِيَ فِي مُصْحَفِ عَبْدِ اللهِ : ( وَرَبَائِبُكُمُ اللَّاتِي فِي حُجُورِكُمْ مِنْ نِسَائِكُمُ اللَّاتِي دَخَلْتُمْ بِأُمَّهَاتِهِنَّ فَإِنْ لَمْ تَكُونُوا دَخَلْتُمْ بِهِنَّ فَلَا جُنَاحَ عَلَيْكُمْ )  . قَالَ  هُشَيْمٌ  :  لَا أَدْرِي أَذُكِرَ فِي الْحَدِيثِ ، أَوْ قَالَ : كَذَا  .","","Sunan Sa'id ibn Mansur 938","","عبد الله بن مسعود عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فتموت قبل أن يدخل بها أو يطلقها هل يصلح له أن يتزوج أمها"
"2116","939  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  صَدَقَةَ بْنِ يَسَارٍ ، قَالَ :  سُئِلَ  عِكْرِمَةُ عَنْ رَجُلٍ تَزَوَّجَ امْرَأَةً ، فَلَمْ يَدْخُلْ بِهَا حَتَّى مَاتَ  ، أَوْ طَلَّقَهَا ، أَيَتَزَوَّجُهَا ابْنُهُ ؟ قَالَ : « فِيهِ قَتَلَ  دَاوُدُ  ابْنَهُ  آذِينَ  »  .  في طبعة الدار طبعة الدار السلفية بالهند ( قبل ) ، وكتب المحقق في الهامش : ( قتل ) ، والحديث أخرجه المصنف في التفسير 3 / 1215 بلفظة ( قتل )","","Sunan Sa'id ibn Mansur 939","","عكرمة مولى ابن عباس عن صدقة بن يسار الجزري عن جرير بن عبد الحميد عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فتموت قبل أن يدخل بها أو يطلقها هل يصلح له أن يتزوج أمها"
"2117","940  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ «  أَنَّهُ رَخَّصَ فِي الرَّبِيبَةِ إِذَا لَمْ يَكُنْ دَخَلَ بِأُمِّهَا  ، وَكَرِهَ الْأُمَّ عَلَى كُلِّ حَالٍ  »  .","","Sunan Sa'id ibn Mansur 940","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فتموت قبل أن يدخل بها أو يطلقها هل يصلح له أن يتزوج أمها"
"2118","941  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا تَزَوَّجَ أُمَّ امْرَأَتِهِ وَقَدْ دَخَلَ بِامْرَأَتِهِ فَارَقَهُمَا جَمِيعًا  ، وَإِنْ كَانَتِ الْأُخْتُ         [6/271]      أَقَامَ عَلَى امْرَأَتِهِ وَلَمْ يَقْرَبْهَا حَتَّى يَسْتَبْرِئَ رَحِمَ الْأُخْرَى ، فَإِذَا اسْتَبْرَأَ رَحِمَهَا رَجَعَ إِلَى امْرَأَتِهِ  » .","","Sunan Sa'id ibn Mansur 941","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فتموت قبل أن يدخل بها أو يطلقها هل يصلح له أن يتزوج أمها"
"2119","942  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَشْعَثُ بْنُ سَوَّارٍ ،  عَنْ  عَدِيِّ بْنِ ثَابِتٍ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ قَالَ : «  مَرَّ بِي عَمِّي  الْحَارِثُ بْنُ عَمْرٍو  ، وَقَدْ عَقَدَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِوَاءً  ، فَعَدَلْتُ إِلَيْهِ ، فَقُلْتُ : أَيْنَ بَعَثَكَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : بَعَثَنِي إِلَى رَجُلٍ تَزَوَّجَ امْرَأَةَ أَبِيهِ ، فَأَمَرَنِي أَنْ أَضْرِبَ عُنُقَهُ  .","","Sunan Sa'id ibn Mansur 942","","البراء بن عازب الأوسي عن عدي بن ثابت الظفري عن أشعث بن سوار عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فتموت قبل أن يدخل بها أو يطلقها هل يصلح له أن يتزوج أمها"
"2120","943  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبِيدَةُ بْنُ حُمَيْدٍ ،  نَا  مُطَرِّفٌ ،  عَنْ  أَبِي الْجَهْمِ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ : «  بَيْنَا أَنَا فِي مَكَانٍ إِذْ رُفِعَتْ لَنَا  رَكَبَةٌ أَوْ رَكْبٌ  مَعَهُمْ لِوَاءٌ  ، فَجَاءُوا حَتَّى أَخْرَجُوا رَجُلًا فَضَرَبُوا عُنُقَهُ ، فَقُلْنَا : مَا هَذَا ؟ قَالُوا : هَذَا رَجُلٌ  عَرَّسَ  بِامْرَأَةِ أَبِيهِ الْبَارِحَةَ  » .","","Sunan Sa'id ibn Mansur 943","","البراء بن عازب الأوسي عن سليمان بن الجهم الجوزجانى عن مطرف بن طريف عن عبيدة بن حميد بن صهيب التيمي عن سعيد بن منصور","باب ما جاء في الرجل يتزوج المرأة فتموت قبل أن يدخل بها أو يطلقها هل يصلح له أن يتزوج أمها"
"2121","بَابُ مَا جَاءَ فِي ابْنَةِ الْأَخِ مِنَ الرَّضَاعَةِ .  944  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  نَا  شُعْبَةُ ،  عَنْ  أَبِي عَوْنٍ ،  عَنْ  أَبِي صَالِحٍ الْحَنَفِيِّ ،  عَنْ  عَلِيٍّ ، عَلَيْهِ السَّلَامُ قَالَ :  سَأَلْتُهُ عَنِ ابْنَةِ الْأَخِ مِنَ الرَّضَاعَةِ ، فَقَالَ  عَلِيٌّ  : ذَكَرْتُ  بِنْتَ حَمْزَةَ  فِي التَّزْوِيجِ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ «  إِنَّهَا ابْنَةُ أَخِي مِنَ الرَّضَاعَةِ  »  .         [6/272]","","Sunan Sa'id ibn Mansur 944","","علي بن أبي طالب عن عبد الرحمن بن قيس الحنفي عن محمد بن عبيد الله بن سعيد الثقفي عن شعبة بن الحجاج عن عبد الرحمن بن زياد العراقي عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2122","945  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  عَلِيًّا ، رَضِيَ اللهُ عَنْهُ أَشَارَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَتَزَوَّجَ  بِنْتَ حَمْزَةَ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  إِنَّ  حَمْزَةَ  كَانَ أَخِي مِنَ الرَّضَاعَةِ  »  .","","Sunan Sa'id ibn Mansur 945","","علي بن أبي طالب عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2123","946  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ، قَالَ :  ذَكَرْتُ بِنْتَ  حَمْزَةَ  لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرُوا مِنْ جَمَالِهَا ، فَقَالَ : «  إِنَّ  حَمْزَةَ  كَانَ أَخِي مِنَ الرَّضَاعَةِ  » .","","Sunan Sa'id ibn Mansur 946","","الحسن البصري عن يونس بن عبيد عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2124","947  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنْبَأَ  يُونُسُ  عَنِ  الْحَسَنِ ، قَالَ :  قِيلَ : يَا رَسُولَ اللهِ ، لَوْ تَزَوَّجْتَ  بِنْتَ حَمْزَةَ  ؟ فَقَالَ : «  إِنَّ  حَمْزَةَ  كَانَ أَخِي مِنَ الرَّضَاعَةِ  ، وَإِنَّهُ يَحْرُمُ مِنَ الرَّضَاعَةِ مَا يَحْرُمُ مِنَ النَّسَبِ  »  .","","Sunan Sa'id ibn Mansur 947","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2125","948  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  أَنَا  عَلِيُّ بْنُ زَيْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  قَالَ  عَلِيٌّ : يَا رَسُولَ اللهِ ، أَلَا تَتَزَوَّجُ ابْنَةَ عَمِّكَ  حَمْزَةَ  ؟ فَإِنَّهَا مِنْ أَحْسَنِ فَتَاةٍ فِي  قُرَيْشٍ  . قَالَ : «  إِنَّهَا ابْنَةُ أَخِي مِنَ الرَّضَاعَةِ  ، وَإِنَّ اللهَ حَرَّمَ مِنَ الرَّضَاعَةِ مَا حَرَّمَ مِنَ النَّسَبِ  »  .","","Sunan Sa'id ibn Mansur 948","","علي بن أبي طالب عن سعيد بن المسيب عن علي بن زيد بن جدعان عن إسماعيل ابن علية عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2126","949  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  حَرُمَ مِنَ الرَّضَاعَةِ مَا حَرُمَ مِنَ النَّسَبِ  »  .","","Sunan Sa'id ibn Mansur 949","","سعيد بن المسيب عن علي بن زيد بن جدعان عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2127","950  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  أَبِي بَكْرِ بْنِ مُحَمَّدِ         [6/273]      بْنِ عَمْرِو بْنِ حَزْمٍ ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ : «  يَحْرُمُ مِنَ الرَّضَاعَةِ مَا يَحْرُمُ مِنَ الْوِلَادَةِ  »  .","","Sunan Sa'id ibn Mansur 950","","عائشة بنت أبي بكر الصديق عن أبو بكر بن محمد الخزرجي عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2128","951  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ، وَهِشَامِ بْنِ عُرْوَةَ - قَالَ  سُفْيَانُ  : سَمِعْتُهُ مِنْهُمَا جَمِيعًا -  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ : «  جَاءَ عَمِّي  أَفْلَحُ بْنُ أَبِي قُعَيْسٍ  يَسْتَأْذِنُ عَلَيَّ بَعْدَمَا ضُرِبَ عَلَيْنَا الْحِجَابُ ، فَأَبَيْتُ أَنْ آذَنَ لَهُ ، فَدَخَلَ عَلَيَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرْتُ ذَلِكَ لَهُ ، فَقَالَ :  إِنَّهُ عَمُّكِ ; فَلْيَلِجْ عَلَيْكِ  . فَقُلْتُ : إِنَّمَا أَرْضَعَتْنِي الْمَرْأَةُ ، وَلَمْ يُرْضِعْنِي الرَّجُلُ . قَالَ :  تَرِبَتْ  يَدَاكِ ، فَلْيَلِجْ عَلَيْكِ  .","","Sunan Sa'id ibn Mansur 951","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2129","952  -  حَدَّثَنَا  سَعِيدٌ ، قَالَ :  نَا  سُفْيَانُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  قَالَتْ  عَائِشَةُ : «  يَا ابْنَ أُخْتِي ، يَحْرُمُ مِنَ الرَّضَاعِ مَا يَحْرُمُ مِنَ النَّسَبِ  »  .","","Sunan Sa'id ibn Mansur 952","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2130","953  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُرْوَةَ ، قَالَ :  قَالَتْ لِي  عَائِشَةُ : «  جَاءَنِي عَمِّي مِنَ الرَّضَاعَةِ بَعْدَ مَا ضُرِبَ عَلَيْنَا الْحِجَابُ يَسْتَأْذِنُ عَلَيَّ ، فَقُلْتُ : وَاللهِ لَا آذَنُ لَهُ حَتَّى يَجِيءَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا جَاءَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ اسْتَأْذَنْتُهُ ، فَقَالَ : «  يَلِجُ عَلَيْكِ ; فَإِنَّهُ عَمُّكِ  » . وَكَانَتْ  عَائِشَةُ  تَقُولُ : « يَحْرُمُ مِنَ الرَّضَاعَةِ مَا يَحْرُمُ مِنَ الْوِلَادَةِ »  .","","Sunan Sa'id ibn Mansur 953","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2131","954  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  أَنْبَأَ  عَبَّادُ بْنُ مَنْصُورٍ ، قَالَ :  قُلْتُ  لِلْقَاسِمِ بْنِ مُحَمَّدٍ : امْرَأَةُ أَبِي أَرْضَعَتْ جَارِيَةً مِنْ عُرْضِ النَّاسِ بِلِبَانِ إِخْوَتِي  ،         [6/274]      أَتَرَى أَنْ أَتَزَوَّجَهَا ؟ قَالَ : لَا ، أَبُوكَ أَبُوهَا . ثُمَّ حَدَّثَ حَدِيثَ  أَبِي قُعَيْسٍ  ، فَقَالَ : إِنَّ  أَبَا قُعَيْسٍ  أَتَى  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا يَسْتَأْذِنُ عَلَيْهَا ، فَلَمْ تَأْذَنْ لَهُ ، فَلَمَّا جَاءَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَتْ  عَائِشَةُ  : يَا رَسُولَ اللهِ ، إِنَّ  أَبَا قُعَيْسٍ  جَاءَ يَسْتَأْذِنُ عَلَيَّ ، فَلَمْ آذَنْ لَهُ . فَقَالَ : « هُوَ عَمُّكِ ; فَلْيَدْخُلْ عَلَيْكِ » . فَقُلْتُ : إِنَّمَا أَرْضَعَتْنِي امْرَأَةٌ ، وَلَمْ يُرْضِعْنِي الرَّجُلُ ؟ فَقَالَ : « هُوَ عَمُّكِ ; فَلْيَدْخُلْ عَلَيْكِ » . قَالَ :  وَسَأَلْتُ  طَاوُسًا ، فَقَالَ مِثْلَ قَوْلِ الْأَوَّلِينَ ،  وَسَأَلْتُ  عَطَاءً ، فَقَالَ مِثْلَ ذَلِكَ ،  وَسَأَلْتُ  الْحَسَنَ ، فَقَالَ مِثْلَ قَوْلِ الْأَوَّلِينَ .  وَسَأَلْتُ  مُجَاهِدًا ، فَقَالَ : اخْتَلَفَ فِيهِ الْفُقَهَاءُ فَلَسْتُ أَقُولُ فِيهِ شَيْئًا .  وَسَأَلْتُ  ابْنَ سِيرِينَ ، فَقَالَ مِثْلَ قَوْلِ  مُجَاهِدٍ  ،  وَسَأَلْتُ  يُوسُفَ بْنَ مَاهَكَ ، فَذَكَرَ حَدِيثَ  أَبِي قُعَيْسٍ  .","","Sunan Sa'id ibn Mansur 954","","القاسم بن محمد بن أبي بكر الصديق عن عباد بن منصور الناجي عن إسماعيل ابن علية عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2132","955  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ «  أَنَّهُ كَانَ يَكْرَهُ  لَبَنَ  الْفَحْلِ  »  .","","Sunan Sa'id ibn Mansur 955","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2133","956  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  خَالِدٌ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ «  أَنَّهُ كَرِهَ  لَبَنَ  الْفَحْلِ  »  .         [6/275]","","Sunan Sa'id ibn Mansur 956","","الحسن البصري عن يونس بن عبيد عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2134","957  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  عَبْدُ اللهِ بْنُ سَبْرَةَ الْهَمْدَانِيُّ  أَنَّهُ  سَمِعَ  الشَّعْبِيَّ كَرِهَهُ  .","","Sunan Sa'id ibn Mansur 957","","الشعبي عن عبد الله بن سبرة الكوفي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2135","958  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  حَجَّاجٌ ،  عَنِ  الْحَكَمِ ،  عَنْ  إِبْرَاهِيمَ «  أَنَّهُ لَمْ يَكُنْ يَرَى بِلَبَنِ  الْفَحْلِ  بَأْسًا  ، وَإِنَّ مُجَاهِدًا كَرِهَهُ  »  .","","Sunan Sa'id ibn Mansur 958","","مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2136","959  -  حَدَّثَنَا  سَعِيدٌ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ «  أَنَّهُ كَانَ لَا يَرَى بِلَبَنِ  الْفَحْلِ  بَأْسًا  »  .","","Sunan Sa'id ibn Mansur 959","","إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2137","960  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِي قِلَابَةَ «  أَنَّهُ لَمْ يَكُنْ يَرَى بِهِ بَأْسًا  »  .","","Sunan Sa'id ibn Mansur 960","","أبو قلابة الجرمي عن بكير بن عبد الله بن الأشج القرشي عن خالد الحذاء عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2138","961  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  أَنَا  عُمَرُ بْنُ حُسَيْنٍ ، مَوْلَى قُدَامَةَ بْنِ مَظْعُونٍ  أَنَّ  سَالِمَ بْنَ عَبْدِ اللهِ « زَوَّجَ ابْنًا لَهُ أُخْتًا مِنْ أَبِيهِ مِنَ الرَّضَاعَةِ  »  .","","Sunan Sa'id ibn Mansur 961","","سالم بن عبد الله بن عمر بن الخطاب عن عمر بن حسين بن عبد الله الجمحي عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2139","962  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ، قَالَ :  أَخْبَرَنِي  أَفْلَحُ بْنُ حُمَيْدٍ قَالَ :  قُلْتُ  لِلْقَاسِمِ يَعْنِي : ابْنَ مُحَمَّدٍ : «  إِنَّ فُلَانًا مِنْ آلِ بَنِي فَرْوَةَ أَرَادَ أَنْ يُزَوِّجَ غُلَامًا أُخْتَهُ مِنْ أَبِيهِ مِنَ الرَّضَاعَةِ  . قَالَ : « لَا بَأْسَ بِذَلِكَ  »  .","","Sunan Sa'id ibn Mansur 962","","القاسم بن محمد بن أبي بكر الصديق عن أفلح ابن صفيراء عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2140","963  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ، قَالَ :  حَدَّثَنِي  رَبِيعَةُ ، وَيَحْيَى بْنُ سَعِيدٍ ، وَعَمْرُو بْنُ عُبَيْدِ اللهِ ، وَأَفْلَحُ بْنُ حُمَيْدٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ، قَالَ : «  كَانَ يَدْخُلُ عَلَى عَائِشَةَ مَنْ أَرْضَعَ بَنَاتِ  أَبِي بَكْرٍ  ، وَلَا يَدْخُلُ عَلَيْهَا مَنْ أَرْضَعَ نِسَاءَ  بَنِي أَبِي بَكْرٍ  »  .         [6/276]","","Sunan Sa'id ibn Mansur 963","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن ربيعة الرأي عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2141","964  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو الْأَحْوَصِ ،  نَا  أَشْعَثُ بْنُ سُلَيْمٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعِنْدِي  رَجُلٌ  ، فَاشْتَدَّ عَلَيْهِ حَتَّى عَرَفْتُ الْغَضَبَ فِي وَجْهِهِ ، قُلْتُ : يَا رَسُولَ اللهِ ، إِنَّهُ أَخِي مِنَ الرَّضَاعَةِ . فَقَالَ : «  انْظُرْنَ أَخَوَاتِكُنَّ مِنَ  الرَّضَاعَةِ  ، فَإِنَّمَا  الرَّضَاعَةُ  مِنَ  الْمَجَاعَةِ  »  .","","Sunan Sa'id ibn Mansur 964","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن سليم بن أسود المحاربي عن أشعث بن أبي الشعثاء عن سلام بن سليم الحنفي عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2142","965  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ، قَالَ :  كَانَ الْحَسَنُ وَالْحُسَيْنُ لَا يَرَيَانِ أُمَّهَاتِ الْمُؤْمِنِينَ  .  قَالَ  ابْنُ عَبَّاسٍ : « وَإِنَّ رُؤْيَتَهُنَّ لَهُمَا تَحِلُّ  »  .","","Sunan Sa'id ibn Mansur 965","","عبد الله بن عباس عن أبو جعفر الباقر عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2143","966  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  مَالِكُ بْنُ أَنَسٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَمْرِو بْنِ الشَّرِيدِ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَتَاهُ رَجُلٌ ، فَقَالَ : إِنَّ لِي امْرَأَةً وَجَارِيَةً  ، أَرْضَعَتْ هَذِهِ غُلَامًا ، وَهَذِهِ جَارِيَةً ، أَيَصْلُحُ لِلْغُلَامِ أَنْ يَتَزَوَّجَ الْجَارِيَةَ ؟ فَقَالَ : « لَا يَصْلُحُ ،  اللِّقَاحُ  وَاحِدٌ  »  .","","Sunan Sa'id ibn Mansur 966","","عبد الله بن عباس عن عمرو بن الشريد الطائفي عن الزهري عن مالك بن أنس عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2144","967  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ، قَالَ :  حَدَّثَنِي  مُوسَى بْنُ أَيُّوبَ الْغَافِقِيُّ ، قَالَ :  حَدَّثَنِي  عَمِّي إِيَاسُ بْنُ عَامِرٍ قَالَ :  قَالَ لِي  عَلِيٌّ رَضِيَ اللهُ عَنْهُ : «  لَا تَنْكِحَنَّ مَنْ أَرْضَعَتْ أُمُّ أَبِيكَ  ، وَلَا امْرَأَةُ ابْنِكَ ، وَلَا امْرَأَةُ أَخِيكَ  »  .","","Sunan Sa'id ibn Mansur 967","","علي بن أبي طالب عن إياس بن عامر المصري عن موسى بن أيوب بن عامر الغافقي عن عبد الله بن المبارك عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2145","968  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ عُقْبَةَ ،  أَنَّهُ         [6/277]      سَأَلَ  عُرْوَةَ بْنَ الزُّبَيْرِ عَنِ الرَّضَاعِ ، قَالَ :  كَانَتْ عَائِشَةُ « لَا تَرَى الْمَصَّةَ وَلَا الْمَصَّتَيْنِ شَيْئًا  دُونَ عَشْرِ رَضَعَاتٍ فَصَاعِدًا  » . ثُمَّ سَأَلْتُهُ عَنِ الرَّضَاعَةِ بَعْدَ الْفِطَامِ قَالَ : « إِنَّمَا ذَلِكَ طَعَامٌ أَكَلَهُ لَيْسَ بِشَيْءٍ » . ثُمَّ  سَأَلْتُ  سَعِيدَ بْنَ الْمُسَيِّبِ عَنِ الرَّضَاعِ ، فَقَالَ  سَعِيدٌ  : أَمَا إِنِّي لَا أَقُولُ كَمَا يَقُولُ ابْنُ عَبَّاسٍ وَابْنُ الزُّبَيْرِ . قُلْتُ : كَيْفَ كَانَا يَقُولَانِ ؟ فَقَالَ :  كَانَا  يَقُولَانِ  : «  لَا تُحَرِّمُ الْمَصَّةُ وَالْمَصَّتَانِ  . قُلْتُ : كَيْفَ تَقُولُ أَنْتَ ؟ قَالَ : إِنْ كَانَتْ دَخَلَتْ بَطْنَهُ قَطْرَةٌ يَعْلَمُ ذَلِكَ ، فَإِنَّهَا عَلَيْهِ حَرَامٌ . قُلْتُ :  أَرَأَيْتَ الرَّضَاعَةَ بَعْدَ الْفِطَامِ  ؟ قَالَ : إِنَّمَا ذَلِكَ طَعَامٌ أَكَلَهُ لَيْسَ بِشَيْءٍ  »  .","","Sunan Sa'id ibn Mansur 968","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن إبراهيم بن عقبة بن أبي عياش المطرقي عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2146","969  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  أَنَا  أَيُّوبُ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  لَا تُحَرِّمُ الْمَصَّةُ وَالْمَصَّتَانِ  »  .","","Sunan Sa'id ibn Mansur 969","","عائشة بنت أبي بكر الصديق عن عبد الله بن الزبير عن ابن أبي مليكة عن أيوب السختياني عن إسماعيل ابن علية عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2147","970  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، قَالَ :  أَنَا  أَيُّوبُ ،  عَنْ  أَبِي الْخَلِيلِ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  أُمِّ الْفَضْلِ ، قَالَتْ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي بَيْتِي ، فَجَاءَ  أَعْرَابِيٌّ  ، فَقَالَ : كَانَتْ عِنْدِي  امْرَأَةٌ  تَزَوَّجْتُ عَلَيْهَا  امْرَأَةً  أُخْرَى ، فَزَعَمَتِ امْرَأَتِي الْأُولَى أَنَّهَا أَرْضَعَتِ امْرَأَتِي الْأُخْرَى رَضْعَةً أَوْ رَضْعَتَيْنِ أَوْ إِمْلَاجَةً أَوْ إِمْلَاجَتَيْنِ . فَقَالَ : «  لَا تُحَرِّمُ  الْإِمْلَاجَةُ وَالْإِمْلَاجَتَانِ » . أَوْ قَالَ :         [6/278]      « الرَّضْعَةُ أَوِ الرَّضْعَتَانِ  »  .","","Sunan Sa'id ibn Mansur 970","","لبابة بنت الحارث الهلالية عن عبد الله بن الحارث بن نوفل عن صالح بن أبي مريم الضبعي عن أيوب السختياني عن إسماعيل ابن علية عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2148","971  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  الْجُرَيْرِيُّ ،  عَنْ  حَيَّانَ بْنِ عُمَيْرٍ ، قَالَ :  قَالَ  ابْنُ عَبَّاسٍ : «  سَبْعٌ صِهْرٌ ، وَسَبْعٌ نَسَبٌ  ، وَيَحْرُمُ مِنَ الرَّضَاعِ مَا يَحْرُمُ مِنَ النَّسَبِ  »  .","","Sunan Sa'id ibn Mansur 971","","عبد الله بن عباس عن حيان بن عمير الجريري عن سعيد بن إياس الجريري عن إسماعيل ابن علية عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2149","972  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  ثَوْرِ بْنِ زَيْدٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : «  مَا كَانَ فِي الْحَوْلَيْنِ فَإِنَّهُ يُحَرِّمُ  ، وَإِنْ كَانَتْ مَصَّةً ، وَمَا كَانَتْ بَعْدَ الْحَوْلَيْنِ فَلَيْسَ بِشَيْءٍ  »  .","","Sunan Sa'id ibn Mansur 972","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن ثور بن زيد الديلي عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2150","973  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ، وَهُشَيْمٌ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنِ  الشَّعْبِيِّ قَالَ : «  مَا كَانَ مِنْ وَجَوْرٍ أَوْ سَعُوطٍ فِي الْحَوْلَيْنِ فَإِنَّهُ يُحَرِّمُ  ، وَمَا كَانَ مِنْ بَعْدُ فَإِنَّهُ لَا يُحَرِّمُ  » قَالَ  هُشَيْمٌ  : الْحَوْلَيْنِ .","","Sunan Sa'id ibn Mansur 973","","الشعبي عن سليمان بن فيروز الشيباني عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2151","974  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : «  لَا رَضَاعَ إِلَّا مَا كَانَ فِي الْحَوْلَيْنِ  ، مَا  أَنْشَزَ  الْعَظْمَ وَأَنْبَتَ اللَّحْمَ  »  .         [6/279]","","Sunan Sa'id ibn Mansur 974","","عبد الله بن مسعود عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2152","975  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  أَبِي عُمَرَ الشَّيْبَانِيِّ ،  أَنَّ  رَجُلًا حَصَرَ اللَّبَنَ فِي ثَدْيِ امْرَأَتِهِ ، فَجَعَلَ يَمُصُّهُ ثُمَّ يَمُجُّهُ  ، فَدَخَلَ فِي حَلْقِهِ ، فَأَتَى  الْأَشْعَرِيَّ  ، فَقَالَ الْأَشْعَرِيُّ : « لَا تَقْرَبِ امْرَأَتَكَ » . فَقِيلَ : ائْتِ ابْنَ مَسْعُودٍ . فَأَتَى  عَبْدَ اللهِ  ، فَأَخْبَرَهُ بِمَا قَالَ  الْأَشْعَرِيُّ  قَالَ : « هَا إِنَّمَا هَذَا طَيِّبٌ لَيْسَ بِحَرَامٍ  »  .","","Sunan Sa'id ibn Mansur 975","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2153","976  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ قَالَتْ : «  نَزَلَ الْقُرْآنُ بِعَشْرِ رَضَعَاتٍ مَعْلُومَاتٍ  ، ثُمَّ كُنَّ خَمْسًا  »  .","","Sunan Sa'id ibn Mansur 976","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2154","977  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ : «  لَا رَضَاعَ إِلَّا مَا كَانَ فِي الْمَهْدِ  »  .","","Sunan Sa'id ibn Mansur 977","","سعيد بن المسيب عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2155","978  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْحَجَّاجِ بْنِ الْحَجَّاجِ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : «  لَا رَضَاعَ إِلَّا مَا فَتَقَ الْأَمْعَاءَ  »  .         [6/280]","","Sunan Sa'id ibn Mansur 978","","أبو هريرة الدوسي عن حجاج بن حجاج بن مالك الأسلمي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2156","979  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ، قَالَ :  سَمِعْتُ  الْمُغِيرَةَ بْنَ شُعْبَةَ ، يَقُولُ : «  لَا تُحَرِّمُ  الْعَيْفَةُ  . قِيلَ : وَمَا  الْعَيْفَةُ  ؟ قَالَ : الْمَرْأَةُ تَحْصُرُ فِي ثَدْيِهَا اللَّبَنَ ، فَتُرْضِعُ وَلَدَ جَارٍ لَهَا  »  .","","Sunan Sa'id ibn Mansur 979","","المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2157","980  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : «  لَا رَضَاعَ إِلَّا مَا كَانَ فِي الْحَوْلَيْنِ  »  .","","Sunan Sa'id ibn Mansur 980","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2158","981  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  عَتَّابُ بْنُ بَشِيرٍ ،  أَنَا  خُصَيْفٌ ،  عَنْ  طَاوُسٍ ، قَالَ : «  يُحَرِّمُ مِنَ الرَّضَاعِ الْمَصَّةُ وَالْمَصَّتَانِ  »  .","","Sunan Sa'id ibn Mansur 981","","طاوس بن كيسان عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2159","982  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  أَبِي أُمَيَّةَ ،  عَنْ  طَاوُسٍ ، قَالَ : «  كَانَ الَّذِي قَالُوا ثُمَّ :  الْمَزَّةُ  الْوَاحِدَةُ تُحَرِّمُ  »  .","","Sunan Sa'id ibn Mansur 982","","طاوس بن كيسان عن عبد الكريم بن أبي المخارق عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2160","983  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ، قَالَ : «  الْمَزَّةُ  الْوَاحِدَةُ مِنَ الرَّضَاعِ تُحَرِّمُ  »  .         [6/281]","","Sunan Sa'id ibn Mansur 983","","طاوس بن كيسان عن عبد الله بن طاووس عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2161","984  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، قَالَ :  سُئِلَ  ابْنُ عُمَرَ عَنْ شَيْءٍ مِنَ الرَّضَاعِ قَالَ : « لَا نَعْلَمُ إِلَّا أَنَّ اللهَ عَزَّ وَجَلَّ حَرَّمَ الْأُخْتَ مِنَ الرَّضَاعَةِ  » . فَقُلْتُ : إِنَّ أَمِيرَ الْمُؤْمِنِينَ ابْنَ الزُّبَيْرِ يَقُولُ : لَا تُحَرِّمُ الرَّضْعَةُ وَالرَّضْعَتَانِ ، وَلَا الْمَصَّةُ وَلَا الْمَصَّتَانِ . قَالَ  ابْنُ عُمَرَ  : « قَضَاءُ اللهِ خَيْرٌ مِنْ قَضَائِكَ وَقَضَاءِ أَمِيرِ الْمُؤْمِنِينَ مَعَكَ  » .","","Sunan Sa'id ibn Mansur 984","","عبد الله بن الزبير عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2162","985  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  عُمَرَ ، قَالَ : «  لَا رَضَاعَ إِلَّا مَا كَانَ فِي الصِّغَرِ  » .","","Sunan Sa'id ibn Mansur 985","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2163","986  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ حَكِيمٍ ،  أَنَّ  رَجُلًا اسْتَسْقَى امْرَأَتَهُ فِي يَوْمٍ صَائِفٍ ، قَالَتْ : سَقَيْتُكَ مِنْ لَبَنِي  . فَسَأَلَ عُمَرَ بْنَ الْخَطَّابِ عَنْ ذَلِكَ ، فَقَالَ : « دَعْهَا ، لَا خَيْرَ لَكَ فِيهَا ، وَإِنْ أَمْسَكْتَهَا فَأَوْجِعْ ظَهْرَهَا  »  .","","Sunan Sa'id ibn Mansur 986","","عمر بن الخطاب عن عبد العزيز بن حكيم الحضرمي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2164","987  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  رَجُلًا  أَوْجَرَتْهُ امْرَأَتُهُ أَوْ سَعَطَتْهُ  مِنْ لَبَنِهَا  ، فَأَتَوْا أَبَا مُوسَى الْأَشْعَرِيَّ ، فَقَالَ : « حَرُمَتْ عَلَيْهِ » . ثُمَّ أَتَوْا عَبْدَ اللهِ بْنَ مَسْعُودٍ ، فَقَالَ : لَا رَضَاعَ بَعْدَ الْحَوْلَيْنِ ، إِنَّمَا         [6/282]      الرَّضَاعُ مَا أَنْبَتَ اللَّحْمَ  وَأَنْشَزَ  الْعَظْمَ . قَالَ  أَبُو مُوسَى  :  لَا تَسْأَلُونِي - أَوْ لَا يَنْبَغِي أَنْ تَسْأَلُونِي  - عَنْ شَيْءٍ مَا دَامَ هَذَا الْحَبْرُ بَيْنَكُمْ  .","","Sunan Sa'id ibn Mansur 987","","عبد الله بن مسعود عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2165","988  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو مُعَاوِيَةَ ،  نَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ عَلْقَمَةَ اللَّيْثِيُّ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ قُسَيْطٍ ، قَالَ :  سَأَلْتُ  أَبَا سَلَمَةَ بْنَ عَبْدِ الرَّحْمَنِ ، وَأَبَا بَكْرِ بْنَ سُلَيْمَانَ بْنِ أَبِي حَثْمَةَ ، وَسَعِيدَ بْنَ الْمُسَيِّبِ ، وَعَطَاءَ بْنَ يَسَارٍ « عَنْ  لَبَنِ  الْفَحْلِ  ، فَكُلُّهُمْ لَا يَرَى بِهِ بَأْسًا  » .","","Sunan Sa'id ibn Mansur 988","","عطاء بن يسار الهلالي عن يزيد بن عبد الله بن قسيط الليثي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2166","989  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  يَعْقُوبُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَةَ ، قَالَ :  سَمِعْتُ  سَعِيدَ بْنَ الْمُسَيِّبِ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  يَحْرُمُ مِنَ الرَّضَاعِ مَا يَحْرُمُ مِنَ الْوِلَادَةِ  » .","","Sunan Sa'id ibn Mansur 989","","سعيد بن المسيب عن عبد الرحمن بن حرملة الأسلمي عن يعقوب بن عبد الرحمن الإسكندراني عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2167","990  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عُقْبَةَ بْنِ الْحَارِثِ قَالَ :  أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْتُ : إِنِّي تَزَوَّجْتُ  ابْنَةَ أَبِي إِهَابٍ  ، وَإِنَّ  امْرَأَةً  زَعَمَتْ أَنَّهَا أَرْضَعَتْنَا . فَأَعْرَضَ عَنْهُ ، ثُمَّ أَتَاهُ مِنَ الشِّقِّ الْآخَرِ فَأَعْرَضَ عَنْهُ ، ثُمَّ أَتَاهُ مِنْ قِبَلِ وَجْهِهِ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنَّهَا سَوْدَاءُ . قَالَ : « كَيْفَ وَقَدْ قِيلَ  » .","","Sunan Sa'id ibn Mansur 990","","عقبة بن الحارث بن عامر النوفلي عن ابن أبي مليكة عن إسماعيل بن أمية الأموي عن سفيان الثوري عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2168","991  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ، قَالَ : «  تَجُوزُ شَهَادَةُ الْمَرْأَةِ الْوَاحِدَةِ فِي الرَّضَاعِ  ، وَإِنْ كَانَتْ سَوْدَاءَ  »  .         [6/283]","","Sunan Sa'id ibn Mansur 991","","طاوس بن كيسان عن عبد الله بن طاووس عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2169","992  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  ابْنُ أَبِي لَيْلَى ، وَالْحَجَّاجُ ،  عَنْ  عِكْرِمَةَ بْنِ خَالِدٍ الْمَخْزُومِيِّ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ أُتِيَ فِي امْرَأَةٍ شَهِدَتْ عَلَى رَجُلٍ وَامْرَأَتِهِ أَنَّهَا أَرْضَعَتْهُمَا  ، فَقَالَ : « لَا ، حَتَّى يَشْهَدَ رَجُلَانِ أَوْ رَجُلٌ وَامْرَأَتَانِ  » .","","Sunan Sa'id ibn Mansur 992","","عمر بن الخطاب عن عكرمة بن خالد بن العاص عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2170","993  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  وَهْبِ بْنِ عُقْبَةَ - وُلِدَ فِي زَمَنِ  عُثْمَانَ  -  أَنَّ امْرَأَةً شَهِدَتْ عَلَى رَضَاعٍ ، فَقَالَتْ : أَرْضَعْتُ رَجُلًا وَامْرَأَتَهُ  .  فَقَالَ  عُثْمَانُ بْنُ عَفَّانَ : « تَحْلِفُ عِنْدَ  الْكَعْبَةِ  . فَلَمَّا حُمِلَتْ عَلَى ذَلِكَ رَجَعَتْ  »  .","","Sunan Sa'id ibn Mansur 993","","عثمان بن عفان عن وهب بن عقبة البكائي عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2171","994  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  وَأَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ  فِي الْمَرْأَةِ إِذَا شَهِدَتْ عَلَى رَجُلٍ وَامْرَأَتِهِ أَنَّهَا أَرْضَعَتْهَا  ، قَالَ مَرَّةً : « إِنْ كَانَتْ مَرْضِيَّةً » وَقَالَ مَرَّةً : « إِنْ كَانَتْ عَدْلًا اسْتُحْلِفَتْ بِاللهِ أَنَّهَا أَرْضَعَتْهَا ، فَإِنْ حَلَفَتْ فُرِّقَ بَيْنَهُمَا » . قَالَ  هُشَيْمٌ  : وَلَا يُؤْخَذُ بِهِ  .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : كذا والظاهر أرضعتهما","","Sunan Sa'id ibn Mansur 994","","الحسن البصري عن منصور بن المعتمر عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2172","995  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ «  أَنَّهُ كَانَ لَا يَرَى بَأْسًا أَنْ يَسْتَرْضِعَ الرَّجُلُ لِوَلَدِهِ الْيَهُودِيَّةَ  وَالنَّصْرَانِيَّةَ وَالْفَاجِرَةَ  » .","","Sunan Sa'id ibn Mansur 995","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2173","996  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُخْبِرٌ ،  عَنْ  إِبْرَاهِيمَ ، مِثْلَهُ ، غَيْرَ أَنَّهُ لَمْ يَذْكُرِ الْفَاجِرَةَ .","","Sunan Sa'id ibn Mansur 996","","إبراهيم النخعي عن مخبر عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2174","997  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  عُمَرَ بْنِ حَبِيبٍ ،  عَنْ  رَجُلٍ مِنْ كِنَانَةَ - أَرَاهُ عُتْوَارِيًّا ، قَالَ :  جَلَسْتُ إِلَى ابْنِ عُمَرَ ،  فَقَالَ  : أَمِنْ بَنِي فُلَانٍ أَنْتَ ؟ قُلْتُ :         [6/284]      لَا  ، وَلَكِنَّهُمْ أَرْضَعُونِي . قَالَ :  سَمِعْتُ  عُمَرَ بْنَ الْخَطَّابِ يَقُولُ : « إِنَّ اللَّبَنَ يُشْتَبَهُ عَلَيْهِ  » .","","Sunan Sa'id ibn Mansur 997","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن رجل من كنانة أراه عتواريا عن عمر بن حبيب المكي عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في ابنة الأخ من الرضاعة"
"2175","بَابُ مَا جَاءَ فِيمَنْ أَصْدَقَ سِرًّا مَهْرًا وَأَعْلَنَ أَكْثَرَ مِنْ ذَلِكَ .  998  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  خَالِدٌ ،  عَنِ  ابْنِ سِيرِينَ ،  عَنْ  شُرَيْحٍ «  فِيمَنْ أَصْدَقَ سِرًّا وَأَعْلَنَ أَكْثَرَ مِنْ ذَلِكَ أَنَّهُ أَجَازَ السِّرَّ  ، وَأَبْطَلَ الْعَلَانِيَةَ  » قَالَ  هُشَيْمٌ  :  وَهُوَ الْقَوْلُ عِنْدَنَا  .","","Sunan Sa'id ibn Mansur 998","","شريح بن الحارث الكندي عن محمد بن سيرين عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن أصدق سرا مهرا وأعلن أكثر من ذلك"
"2176","999  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ أَنَّهُ كَانَ يَقُولُ : «  يَجُوزُ السِّرُّ وَيَبْطُلُ الْعَلَانِيَةُ  » .","","Sunan Sa'id ibn Mansur 999","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن أصدق سرا مهرا وأعلن أكثر من ذلك"
"2177","1000  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  حَجَّاجٌ ،  عَنْ  أَبِي عَوْنٍ مُحَمَّدِ بْنِ عُبَيْدِ اللهِ الثَّقَفِيِّ ،  عَنْ  شُرَيْحٍ ، مِثْلَ ذَلِكَ .         [6/285]","","Sunan Sa'id ibn Mansur 1000","","شريح بن الحارث الكندي عن محمد بن عبيد الله بن سعيد الثقفي عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن أصدق سرا مهرا وأعلن أكثر من ذلك"
"2178","1001  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  حُصَيْنٌ ، وَإِسْمَاعِيلُ بْنُ سَالِمٍ ، وَعَبْدُ السَّلَامِ مَوْلَى قُرَيْشٍ  أَنَّهُمْ سَمِعُوا  الشَّعْبِيَّ يَقُولُ : «  يُؤْخَذُ بِالْعَلَانِيَةِ  » .","","Sunan Sa'id ibn Mansur 1001","","الشعبي عن إسماعيل بن سالم الأسدي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن أصدق سرا مهرا وأعلن أكثر من ذلك"
"2179","1002  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  خَالِدٌ ،  عَنْ  حُصَيْنٍ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ قَالَ : «  يُؤْخَذُ بِالْعَلَانِيَةِ  » .","","Sunan Sa'id ibn Mansur 1002","","الشعبي عن حصين بن عبد الرحمن السلمي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء فيمن أصدق سرا مهرا وأعلن أكثر من ذلك"
"2180","1003  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو مُعَاوِيَةَ ،  نَا  أَبُو إِسْحَاقَ الشَّيْبَانِيُّ ،  عَنِ  الشَّعْبِيِّ قَالَ : «  يُؤْخَذُ بِالْعَلَانِيَةِ  » .  قَالَ  هُشَيْمٌ :  قَالَ  ابْنُ أَبِي لَيْلَى : «  يَأْخُذُ بِالْعَلَانِيَةِ  » .","","Sunan Sa'id ibn Mansur 1003","","الشعبي عن سليمان بن فيروز الشيباني عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء فيمن أصدق سرا مهرا وأعلن أكثر من ذلك"
"2181","بَابُ الْجَمْعِ بَيْنَ ابْنَةِ الرَّجُلِ وَامْرَأَتِهِ .  1004  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  نَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ «  أَنَّهُ كَانَ يَكْرَهُ الْجَمْعَ بَيْنَ ابْنَةِ الرَّجُلِ وَامْرَأَتِهِ  »  .","","Sunan Sa'id ibn Mansur 1004","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب الجمع بين ابنة الرجل وامرأته"
"2182","1005  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  ابْنُ عَوْنٍ ،  عَنِ  ابْنِ سِيرِينَ «  أَنَّهُ كَانَ لَا يَرَى بِذَلِكَ بَأْسًا  » .","","Sunan Sa'id ibn Mansur 1005","","محمد بن سيرين عن عبد الله بن عون بن أرطبان عن هشيم بن بشير عن سعيد بن منصور","باب الجمع بين ابنة الرجل وامرأته"
"2183","1006  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  أَنَا  أَيُّوبُ ، قَالَ :  سُئِلَ  الْحَسَنُ وَمُحَمَّدُ بْنُ سِيرِينَ عَنِ الرَّجُلِ يَتَزَوَّجُ امْرَأَةَ الرَّجُلِ وَابْنَتَهُ مِنْ غَيْرِهَا  ، فَكَرِهَ ذَلِكَ  الْحَسَنُ  ، وَلَمْ يَرَ بِهِ بَأْسًا  مُحَمَّدُ بْنُ سِيرِينَ  ، فَقَالَ : قَدْ فَعَلَ  جَبَلَةُ ، رَجُلٌ مِنْ أَهْلِ مِصْرَ  .         [6/286]","","Sunan Sa'id ibn Mansur 1006","","محمد بن سيرين عن أيوب السختياني عن إسماعيل ابن علية عن سعيد بن منصور","باب الجمع بين ابنة الرجل وامرأته"
"2184","1007  -  حَدَّثَنَا  سَعِيدٌ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  نَا  سَلَمَةُ بْنُ عَلْقَمَةَ ،  قَالَ  : «  إِنِّي لَجَالِسٌ مَعَ الْحَسَنِ ، فَسُئِلَ عَنْهَا ، فَكَرِهَهَا  ، فَقَالَ بَعْضُ  الْقَوْمِ  : يَا  أَبَا سَعِيدٍ  ، أَتَرَى بَيْنَهُمَا شَيْئًا ؟ فَنَظَرَ ، ثُمَّ قَالَ : مَا أَرَى بَيْنَهُمَا شَيْئًا  » .","","Sunan Sa'id ibn Mansur 1007","","الحسن البصري عن سلمة بن علقمة التميمي عن إسماعيل ابن علية عن سعيد بن منصور","باب الجمع بين ابنة الرجل وامرأته"
"2185","1008  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ، وَسُفْيَانَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  أَنَّ  عَبْدَ اللهِ بْنَ صَفْوَانَ ، « جَمَعَ بَيْنَ امْرَأَةِ رَجُلٍ وَابْنَتِهِ  »  .","","Sunan Sa'id ibn Mansur 1008","","عبد الله بن صفوان الجمحي عن عمرو بن دينار الأثرم عن أيوب السختياني عن حماد بن زيد عن سعيد بن منصور","باب الجمع بين ابنة الرجل وامرأته"
"2186","1009  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  أَنَا  أَيُّوبُ ،  عَنْ  عِكْرِمَةَ بْنِ خَالِدٍ ،  أَنَّ  عَبْدَ اللهِ بْنَ صَفْوَانَ « تَزَوَّجَ امْرَأَةَ رَجُلٍ مِنْ ثَقِيفَ وَابْنَتَهُ  »  .","","Sunan Sa'id ibn Mansur 1009","","عبد الله بن صفوان الجمحي عن عكرمة بن خالد بن العاص عن أيوب السختياني عن إسماعيل ابن علية عن سعيد بن منصور","باب الجمع بين ابنة الرجل وامرأته"
"2187","1010  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  قُثَمَ مَوْلَى بَنِي هَاشِمٍ  أَنَّ  عَبْدَ اللهِ بْنَ جَعْفَرٍ « جَمَعَ بَيْنَ ابْنَةِ عَلِيٍّ وَبَيْنَ امْرَأَتِهِ النَّهْشَلِيَّةِ  » .","","Sunan Sa'id ibn Mansur 1010","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن قثم بن لؤلؤة الهاشمي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الجمع بين ابنة الرجل وامرأته"
"2188","1011  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  قُثَمَ مَوْلَى آلِ الْعَبَّاسِ قَالَ :  جَمَعَ عَبْدُ اللهِ بْنُ جَعْفَرٍ بَيْنَ  لَيْلَى بِنْتِ مَسْعُودٍ النَّهْشَلِيَّةِ  ، وَكَانَتِ امْرَأَةَ  عَلِيٍّ  ، وَبَيْنَ  أُمِّ كُلْثُومٍ بِنْتِ عَلِيٍّ  لِفَاطِمَةَ بِنْتِ رَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكَانَتَا امْرَأَتَيْهِ  .","","Sunan Sa'id ibn Mansur 1011","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن قثم بن لؤلؤة الهاشمي عن جرير بن عبد الحميد عن سعيد بن منصور","باب الجمع بين ابنة الرجل وامرأته"
"2189","[6/287]      بَابُ الرَّجُلِ يَتَزَوَّجُ الْمَرْأَةَ فَيَدْخُلُ عَلَيْهَا وَمَعَهَا نِسَاءٌ فَوَقَعَ عَلَى امْرَأَةٍ مِنْهُنَّ .  1012  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّهُ سُئِلَ عَنْ رَجُلٍ ، تَزَوَّجَ جَارِيَةً ، فَدَخَلَ عَلَيْهَا وَمَعَهَا جَوَارٍ  ، فَتَنَاوَلَ وَاحِدَةً فَقَالَتْ : لَسْتُ بِامْرَأَتِكَ . فَخَلَّى عَنْهَا ، ثُمَّ تَنَاوَلَ أُخْرَى فَقَالَتْ : لَسْتُ بِامْرَأَتِكَ . فَخَلَّى عَنْهَا ، ثُمَّ تَنَاوَلَ أُخْرَى فَقَالَتْ : لَسْتُ بِامْرَأَتِكَ . فَقَالَ : أَتُدَافِعِينِي ؟ فَوَقَعَ بِهَا ، فَنَظَرَ فَإِذَا هِيَ لَيْسَتْ بِامْرَأَتِهِ ، فَقَالَ  إِبْرَاهِيمُ  : « لَهَا الصَّدَاقُ ، وَيُدْرَأُ عَنْهُ  الْحَدُّ  لِجَهَالَتِهِ  » .","","Sunan Sa'id ibn Mansur 1012","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة فيدخل عليها ومعها نساء فوقع على امرأة منهن"
"2190","1013  -  حَدَّثَنَا  سَعِيدٌ ، قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  مَنْ وَطِئَ فَرْجًا بِجَهَالَةٍ دُرِئَ عَنْهُ  الْحَدُّ  ، وَضَمِنَ  الْعُقْرَ  » .","","Sunan Sa'id ibn Mansur 1013","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة فيدخل عليها ومعها نساء فوقع على امرأة منهن"
"2191","1014  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  فِي رَجُلٍ وُجِدَ مَعَ امْرَأَةٍ يَنْكِحُهَا ، فَقَالَ : امْرَأَتِي . فَقَالَتْ : زَوْجِي  . فَقَالَ : « يُسْأَلُ الْبَيِّنَةَ عَلَى ذَلِكَ ، وَإِلَّا أُقِيمَ عَلَيْهِمَا  الْحَدُّ  ، لَوِ اسْتَقَامَ ذَلِكَ لَمْ يُقَمْ حَدٌّ عَلَى فَاجِرٍ  » .","","Sunan Sa'id ibn Mansur 1014","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة فيدخل عليها ومعها نساء فوقع على امرأة منهن"
"2192","1015  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ، قَالَ :  كُنَّا عِنْدَ  حُمَيْدٍ الطَّوِيلِ  وَالْحَارِثِ الْغَنَوِيِّ  ، فَتَذَاكَرُوا هَذَا الْبَابَ  ،  فَقَالَ  حُمَيْدٌ : « يَسْأَلَانِ الْبَيِّنَةَ ، وَإِلَّا أُقِيمَ عَلَيْهِمَا  الْحَدُّ  » .  وَقَالَ  الْحَارِثُ الْغَنَوِيُّ : الْقَوْلُ قَوْلُهُمَا ، وَلَا حَدَّ عَلَيْهِمَا . فَبَيْنَا نَحْنُ كَذَلِكَ إِذْ         [6/288]      أَقْبَلَ  ابْنُ شُبْرُمَةَ  ، فَقَالَ  حُمَيْدٌ  لِلْحَارِثِ  : هَذَا  ابْنُ شُبْرُمَةَ  ، وَهُوَ بَيْنِي وَبَيْنَكَ ، فَأَقْبَلَ  ابْنُ شُبْرُمَةَ  حَتَّى جَلَسَ ، فَسَأَلَهُ  حُمَيْدٌ  ، فَقَالَ ابْنُ شُبْرُمَةَ بِقَوْلِ  إِبْرَاهِيمَ  .","","Sunan Sa'id ibn Mansur 1015","","عبد الله بن شبرمة عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة فيدخل عليها ومعها نساء فوقع على امرأة منهن"
"2193","1016  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  شُعْبَةُ ، قَالَ :  سَمِعْتُ  الْحَكَمَ ، وَحَمَّادًا ، يَقُولَانِ : «  الْقَوْلُ قَوْلُهُمَا  » . قَالَ  هُشَيْمٌ  :  وَهُوَ الْقَوْلُ  .","","Sunan Sa'id ibn Mansur 1016","","الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة فيدخل عليها ومعها نساء فوقع على امرأة منهن"
"2194","1017  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو مُعَاوِيَةَ ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ،  عَنِ  السُّمَيْطِ  عَنِ  السَّدُوسِيِّ  قَالَ : «  خَطَبْتُ امْرَأَةً ، فَقَالُوا لِي : لَا نُزَوِّجُكَ حَتَّى تُطَلِّقَ امْرَأَتَكَ ثَلَاثًا  . فَقُلْتُ : إِنِّي قَدْ طَلَّقْتُ ثَلَاثًا ، فَزَوَّجُونِي ، ثُمَّ نَظَرُوا فَإِذَا امْرَأَتِي عِنْدِي ، فَقَالُوا : أَلَيْسَ قَدْ طَلَّقْتَ ثَلَاثًا ؟ فَقُلْتُ : بَلَى ، كَانَتْ عِنْدِي فُلَانَةُ بِنْتُ فُلَانٍ فَطَلَّقْتُهَا ، وَفُلَانَةُ بِنْتُ فُلَانٍ فَطَلَّقْتُهَا ، وَأَمَّا هَذِهِ فَلَمْ أُطَلِّقْهَا . فَأَتَيْتُ شَقِيقَ بْنَ مَجْزَأَةَ بْنِ ثَوْرٍ وَهُوَ يُرِيدُ أَنْ يَخْرُجَ إِلَى عُثْمَانَ بْنِ عَفَّانَ وَافِدًا ، فَقُلْتُ لَهُ : سَلْ أَمِيرَ الْمُؤْمِنِينَ عَنْ هَذِهِ . فَخَرَجَ إِلَيْهِ فَسَأَلَهُ ،  فَقَالَ  عُثْمَانُ  : نِيَّتُهُ  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : كذا في ص ، والصواب عندي حذف كلمة ( عن ) والسميط السدوسي هو ابن عمير ، وقيل : ابن سمير ، ذكره الحافظ في التهذيب . قلنا : ، ولعل الصواب ( بن ) بدل ( عن ) والله أعلم","","Sunan Sa'id ibn Mansur 1017","","عثمان بن عفان عن شقيق بن ثور السدوسي عن سميط بن عمير السدوسي عن عاصم بن سليمان الأحول عن أبو معاوية الضرير عن سعيد بن منصور","باب الرجل يتزوج المرأة فيدخل عليها ومعها نساء فوقع على امرأة منهن"
"2195","1018  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ  أَنَّهُ سُئِلَ عَنْ رَجُلٍ خَطَبَ إِلَى قَوْمٍ ، فَزَوَّجُوهُ عَلَى إِنْ كَانَ لَهُ امْرَأَةٌ فَصَدَاقُ صَاحِبَتِهِمْ أَلْفَانِ  ، فَإِنْ لَمْ يَكُنْ لَهُ امْرَأَةٌ فَصَدَاقُهَا أَلْفٌ ، فَزَوَّجُوهُ عَلَى ذَلِكَ ، فَوَجَدُوا لَهُ امْرَأَةً ، فَقَالَ  الشَّعْبِيُّ  : « لَهَا أَخَسُّ الصَّدَاقَيْنِ  » .         [6/289]","","Sunan Sa'id ibn Mansur 1018","","الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يتزوج المرأة فيدخل عليها ومعها نساء فوقع على امرأة منهن"
"2196","1019  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  طَاوُسٍ ، قَالَ : «  إِذَا كَانَ لِلرَّجُلِ ابْنٌ ، وَكَانَتْ لَهُ امْرَأَةٌ ، وَلَهَا ابْنَةٌ مِنْ غَيْرِهِ  ، وَابْنُهُ مِنْ غَيْرِهَا ، فَلَا بَأْسَ أَنْ يَتَزَوَّجَ الِابْنُ ابْنَةَ الْمَرْأَةِ إِنْ كَانَتْ وُلِدَتْ قَبْلَ أَنْ يَتَزَوَّجَهَا الْأَبُ ، وَإِنْ كَانَ بَعْدُ كَرِهَهُ » . وَلَمْ يَرَ بِهِ مُجَاهِدٌ بَأْسًا قَبْلُ وَلَا بَعْدُ . قَالَ أَبُو عُثْمَانَ : الْقَوْلُ مَا قَالَ  مُجَاهِدٌ  .","","Sunan Sa'id ibn Mansur 1019","","طاوس بن كيسان عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يتزوج المرأة فيدخل عليها ومعها نساء فوقع على امرأة منهن"
"2197","بَابُ مَا جَاءَ فِيمَنْ طَلَّقَ قَبْلَ أَنْ يَمْلِكَ .  1020  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  عَامِرٌ الْأَحْوَلُ ،  نَا  عَمْرُو بْنُ شُعَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : «  لَا نَذْرَ لِابْنِ آدَمَ فِيمَا لَا يَمْلِكُ  ، وَلَا عِتْقَ لَهُ فِيمَا لَا يَمْلِكُ ، وَلَا طَلَاقَ لَهُ فِيمَا لَا يَمْلِكُ  » .","","Sunan Sa'id ibn Mansur 1020","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن عمرو بن شعيب عن عامر بن عبد الواحد الأحول عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2198","1021  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو عَلْقَمَةَ الْفَرْوِيُّ ، قَالَ :  حَدَّثَنِي  عَبْدُ الْحَكِيمِ بْنُ عَبْدِ اللهِ بْنِ أَبِي فَرْوَةَ ، قَالَ :  قَدِمَ عَلَيْنَا عَمْرُو بْنُ شُعَيْبٍ ،  فَسَأَلْتُهُ  ، فَقَالَ : كَانَ أَبِي عَرَضَ عَلَيَّ امْرَأَةً يُزَوِّجُنِيهَا ، فَأَبَيْتُ أَنْ أَتَزَوَّجَهَا ، وَقُلْتُ : هِيَ طَالِقٌ أَلْبَتَّةَ يَوْمَ أَتَزَوَّجُهَا ، ثُمَّ نَدِمْتُ فَقَدِمْتُ  الْمَدِينَةَ  ،  فَسَأَلْتُ  سَعِيدَ بْنَ الْمُسَيِّبِ وَعُرْوَةَ بْنَ الزُّبَيْرِ ، فَقَالَا : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  لَا طَلَاقَ إِلَّا بَعْدَ نِكَاحٍ  »  .         [6/290]","","Sunan Sa'id ibn Mansur 1021","","عروة بن الزبير عن عمرو بن شعيب عن عبد الحكيم بن عبد الله بن أبي فروة عن عبد الله بن محمد بن عبد الله الفروي عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2199","1022  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنِ  ابْنِ عَجْلَانَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : «  لَيْسَ الظِّهَارُ وَالطَّلَاقُ قَبْلَ الْمِلْكِ بِشَيْءٍ  »  .","","Sunan Sa'id ibn Mansur 1022","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن محمد بن عجلان عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2200","1023  -  حَدَّثَنَا  سَعِيدٌ ، قَالَ :  نَا  مَالِكُ بْنُ أَنَسٍ ،  عَنْ  سَعِيدِ بْنِ عَمْرِو بْنِ سُلَيْمٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ  أَنَّ  رَجُلًا قَالَ : إِنْ تَزَوَّجْتُ فُلَانَةَ فَهِيَ عَلَيَّ كَظَهْرِ أُمِّي . فَتَزَوَّجَهَا  ، فَسَأَلَ عُمَرَ بْنَ الْخَطَّابِ ، فَقَالَ : « لَا تَقْرَبْهَا حَتَّى تُكَفِّرَ كَفَّارَةَ الظِّهَارِ  » .","","Sunan Sa'id ibn Mansur 1023","","عمر بن الخطاب عن القاسم بن محمد بن أبي بكر الصديق عن سعيد بن عمرو بن سليم الزرقي عن مالك بن أنس عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2201","1024  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنْ  شُرَيْحٍ قَالَ : «  لَا طَلَاقَ إِلَّا بَعْدَ نِكَاحٍ  »  .","","Sunan Sa'id ibn Mansur 1024","","شريح بن الحارث الكندي عن سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2202","1025  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُبَارَكُ بْنُ فَضَالَةَ ، قَالَ :  سَمِعْتُ  الْحَسَنَ  يُحَدِّثُ عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ ، رَضِيَ اللهُ عَنْهُ  أَنَّهُ سُئِلَ عَنْ رَجُلٍ قَالَ :         [6/291]      إِنْ تَزَوَّجْتُ فُلَانَةَ فَهِيَ طَالِقٌ  ، فَقَالَ : « لَيْسَ بِشَيْءٍ ، لَا طَلَاقَ إِلَّا بَعْدَ مِلْكٍ  » .","","Sunan Sa'id ibn Mansur 1025","","علي بن أبي طالب عن الحسن البصري عن مبارك بن فضالة عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2203","1026  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  رَجُلٍ ،  عَنْ  أَبِي الشَّعْثَاءِ ، قَالَ : «  الطَّلَاقُ بَعْدَ النِّكَاحِ ، وَالْعِتْقُ بَعْدَ الْمِلْكِ  »  .","","Sunan Sa'id ibn Mansur 1026","","جابر بن زيد اليحمدي عن رجل عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2204","1027  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  أَشْعَثُ بْنُ سَوَّارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : «  لَا طَلَاقَ إِلَّا مِنْ بَعْدِ نِكَاحٍ  ، وَلَا عِتْقَ إِلَّا مِنْ بَعْدِ مِلْكٍ  »  .","","Sunan Sa'id ibn Mansur 1027","","عبد الله بن عباس عن طاوس بن كيسان عن أشعث بن سوار عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2205","1028  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  نَا  عُبَيْدَةُ ،  عَنِ  الْحَسَنِ بْنِ رَوَاحٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّهُ قَالَ : «  لَا طَلَاقَ إِلَّا مِنْ بَعْدِ نِكَاحٍ  » .","","Sunan Sa'id ibn Mansur 1028","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن الحسن بن رواح عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2206","1029  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  سُلَيْمَانَ بْنِ أَبِي الْمُغِيرَةِ ، قَالَ :  سَأَلْتُ  سَعِيدَ بْنَ جُبَيْرٍ وَعَلِيَّ بْنَ حُسَيْنٍ «  عَنِ الطَّلَاقِ ، قَبْلَ النِّكَاحِ  ، فَلَمْ يَرَيَاهُ شَيْئًا  » .","","Sunan Sa'id ibn Mansur 1029","","علي بن الحسين زين العابدين عن سليمان بن أبي المغيرة العبسي عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2207","1030  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  جُوَيْبِرٌ ،  عَنِ  الضَّحَّاكِ ، قَالَ :  أَخْبَرَنِي  النَّزَّالُ بْنُ سَبْرَةَ الْهِلَالِيُّ ، قَالَ :  سَمِعْتُ  عَلِيًّا ، رَضِيَ اللهُ عَنْهُ يَقُولُ : «  لَا  وِصَالَ  وَلَا رَضَاعَ بَعْدَ فِطَامٍ  ، وَلَا يُتْمَ بَعْدَ الْحُلُمِ ، وَلَا صَمْتَ يَوْمٍ إِلَى اللَّيْلِ ، وَلَا طَلَاقَ إِلَّا بَعْدَ نِكَاحٍ  »  .         [6/292]","","Sunan Sa'id ibn Mansur 1030","","علي بن أبي طالب عن النزال بن سبرة الهلالي عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2208","1031  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مَنْصُورٌ ، وَيُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  لَا طَلَاقَ إِلَّا بَعْدَ مِلْكٍ  »  .","","Sunan Sa'id ibn Mansur 1031","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2209","1032  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  يَحْيَى بْنُ سَعِيدٍ ، وَدَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ : «  لَا طَلَاقَ إِلَّا مِنْ بَعْدِ نِكَاحٍ  »  .","","Sunan Sa'id ibn Mansur 1032","","سعيد بن المسيب عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2210","1033  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  حَمَّادُ بْنُ شُعَيْبٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ، قَالَ :  جَاءَ رَجُلٌ إِلَى عَلِيِّ بْنِ حُسَيْنٍ ، فَقَالَ : إِنِّي قُلْتُ : يَوْمَ أَتَزَوَّجُ فُلَانَةَ فَهِيَ طَالِقٌ  . فَقَرَأَ هَذِهِ الْآيَةَ :         {      يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا نَكَحْتُمُ الْمُؤْمِنَاتِ ثُمَّ طَلَّقْتُمُوهُنَّ مِنْ قَبْلِ أَنْ تَمَسُّوهُنَّ         }      قَالَ  عَلِيُّ بْنُ حُسَيْنٍ  : « لَا أَرَى طَلَاقًا إِلَّا بَعْدَ نِكَاحٍ  »  .","","Sunan Sa'id ibn Mansur 1033","","علي بن الحسين زين العابدين عن حبيب بن أبي ثابت الكاهلي عن حماد بن شعيب الحماني عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2211","1034  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  الْأَجْلَحُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ، قَالَ :  جَاءَ رَجُلٌ إِلَى عَلِيِّ بْنِ حُسَيْنٍ ، فَقَالَ : مَا تَقُولُ فِي رَجُلٍ قَالَ : إِنْ تَزَوَّجْتُ فُلَانَةَ فَهِيَ طَالِقٌ  ؟  فَقَالَ  : « لَيْسَ بِشَيْءٍ ، بَدَأَ اللهُ بِالنِّكَاحِ قَبْلَ الطَّلَاقِ ، ثُمَّ قَالَ :         {      يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا نَكَحْتُمُ الْمُؤْمِنَاتِ ثُمَّ طَلَّقْتُمُوهُنَّ         }      فَبَدَأَ اللهُ بِالنِّكَاحِ قَبْلَ الطَّلَاقِ ، وَلَيْسَ قَوْلُهُ بِشَيْءٍ  »  .","","Sunan Sa'id ibn Mansur 1034","","علي بن الحسين زين العابدين عن حبيب بن أبي ثابت الكاهلي عن أجلح بن عبد الله الكندي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2212","1035  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  قَالَ :  إِذَا قَالَ : « كُلُّ امْرَأَةٍ أَتَزَوَّجُهَا فَهِيَ عَلَيَّ كَظَهْرِ أُمِّي  ، كَفَّرَ عَنْ أَوَّلِ امْرَأَةٍ         [6/293]      يَتَزَوَّجُهَا ، وَإِذَا قَالَ : إِنْ تَزَوَّجْتُ فُلَانَةَ فَهِيَ عَلَيَّ كَظَهْرِ أُمِّي فَتَزَوَّجَهَا ، فَلَا يَقْرَبْهَا حَتَّى يُكَفِّرَ  »  .","","Sunan Sa'id ibn Mansur 1035","","عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2213","1036  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو مُعَاوِيَةَ ،  نَا  عُقْبَةُ بْنُ صَالِحٍ الْأَسَدِيُّ ، قَالَ :  جَاءَ رَجُلٌ إِلَى إِبْرَاهِيمَ ، فَقَالَ : إِنِّي حَلَفْتُ بِطَلَاقِ امْرَأَةِ فُلَانٍ  ، قُلْتُ : إِنِّي لَا أَتَزَوَّجُهَا حَتَّى أَخْرُجَ إِلَى  أَصْبَهَانَ  .  فَقَالَ  لَهُ  إِبْرَاهِيمُ  : « فَاخْرُجْ إِلَى  أَصْبَهَانَ  ، ثُمَّ تَزَوَّجْهَا بَعْدُ  »  .","","Sunan Sa'id ibn Mansur 1036","","إبراهيم النخعي عن عقبة بن صالح الأسدي عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2214","1037  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُحَمَّدُ بْنُ خَالِدٍ ،  حَدَّثَنِي  عَدِيُّ بْنُ كَعْبٍ ، قَالَ :  جَاءَ رَجُلٌ إِلَى سَعِيدِ بْنِ الْمُسَيِّبِ فَقَالَ : « مَا تَقُولُ فِي رَجُلٍ قَالَ : إِنْ تَزَوَّجْتُ فُلَانَةَ فَهِيَ طَالِقٌ ؟  فَقَالَ  لَهُ  سَعِيدٌ  : كَمْ أَصْدَقَهَا ؟ ، قَالَ لَهُ الرَّجُلُ : لَمْ يَتَزَوَّجْهَا بَعْدُ ، فَكَيْفَ  يُصْدِقُهَا  ؟ فَقَالَ لَهُ  سَعِيدٌ  : فَكَيْفَ يُطَلِّقُ مَا لَمْ يَتَزَوَّجْهُ ؟  » .","","Sunan Sa'id ibn Mansur 1037","","سعيد بن المسيب عن عدي بن كعب عن محمد بن خالد بن سلمة المخزومي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2215","1038  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  عَتَّابُ بْنُ بَشِيرٍ ،  نَا  خُصَيْفٌ ، قَالَ :  سَأَلْتُ  عَطَاءً ، وَطَاوُسًا ، وَسَعِيدَ بْنَ الْمُسَيِّبِ ، فَقَالُوا مِثْلَ ذَلِكَ ،  وَسَأَلْتُ  مُجَاهِدًا  فَكَرِهَهُ  .","","Sunan Sa'id ibn Mansur 1038","","مجاهد بن جبر المخزومي عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2216","1039  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  عَتَّابُ بْنُ بَشِيرٍ ،  أَنَا  خُصَيْفٌ ،  عَنْ  سُلَيْمَانَ بْنِ         [6/294]      يَسَارٍ ،  أَنَّهُ حَلَفَ فِي امْرَأَةٍ إِنْ تَزَوَّجَهَا فَهِيَ طَالِقٌ ، فَتَزَوَّجَهَا  ،  فَأُخْبِرَ  بِذَلِكَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ وَهُوَ أَمِيرٌ عَلَى  الْمَدِينَةِ  ، فَأَرْسَلَ إِلَيْهِ : « بَلَغَنِي أَنَّكَ حَلَفْتَ فِي كَذَا » ، قَالَ : نَعَمْ ، قَالَ : أَفَلَا تُخَلِّي سَبِيلَهَا ؟ قَالَ : لَا . فَتَرَكَهُ  عُمَرُ  ، وَلَمْ يُفَرِّقْ بَيْنَهُمَا  »  .","","Sunan Sa'id ibn Mansur 1039","","عمر بن عبد العزيز بن مروان عن سليمان بن يسار مولى ميمونة زوج رسول الله عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2217","1040  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  خَلَفُ بْنُ خَلِيفَةَ قَالَ  :  سَأَلْتُ  مَنْصُورَ بْنَ زَاذَانَ عَنْ رَجُلٍ ذُكِرَ لَهُ امْرَأَةٌ ، فَقَالَ : « إِنْ تَزَوَّجْتُهَا فَهِيَ طَالِقٌ  » قَالَ : وَكَانَ الْحَسَنُ « لَا يَرَاهُ شَيْئًا »  .","","Sunan Sa'id ibn Mansur 1040","","الحسن البصري عن منصور بن زاذان الثقفي عن خلف بن خليفة الأشجعي عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2218","1041  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  خَلَفُ بْنُ خَلِيفَةَ قَالَ :  سَأَلْتُ  أَبَا هَاشِمٍ ، فَقَالَ : « هِيَ طَالِقٌ فَمَا يُرِيدُ  »  .","","Sunan Sa'id ibn Mansur 1041","","يحيى بن دينار الرماني عن خلف بن خليفة الأشجعي عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2219","1042  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو عَوَانَةَ ،  عَنْ  مُحَمَّدِ بْنِ قَيْسٍ  أَنَّ رَجُلًا قَالَ لِجَارِيَةٍ صَغِيرَةٍ : إِنْ تَزَوَّجْتُهَا فَهِيَ طَالِقٌ  . فَشَبَّتْ فَرَغِبَ فِيهَا ، فَتَزَوَّجَهَا ، ثُمَّ إِنَّهُ وَقَعَ فِي نَفْسِهِ مِنْ ذَلِكَ ، فَقَالَ لِي : سَلْ لِي عَنْ ذَلِكَ . فَلَقِيتُ  عَامِرًا الشَّعْبِيَّ  فَسَأَلْتُهُ ، فَقَالَ : ائْتِ إِبْرَاهِيمَ ، فَإِنِّي تَرَكْتُهُ بِمَكَانِ كَذَا وَكَذَا ، فَاسْأَلْهُ ، ثُمَّ ارْجِعْ إِلَيَّ ، فَأَخْبِرْنِي بِمَا يَقُولُ . قَالَ : فَلَقِيتُهُ  فَسَأَلْتُهُ  ، فَذَكَرَ عَنْ  عَلْقَمَةَ أَوِ الْأَسْوَدِ  قَالَ :  قَالَ  عَبْدُ اللهِ : « هِيَ كَمَا قَالَ  » ، قَالَ : فَرَجَعْتُ إِلَى عَامِرٍ فَأَخْبَرْتُهُ ، فَقَالَ : صَدَقَ ، هُوَ كَمَا قَالَ . فَلَقِيتُ الزَّوْجَ فَأَخْبَرْتُهُ بِالَّذِي قَالَا ، فَأَتَى امْرَأَتَهُ فَأَخْبَرَهَا أَنَّهَا أَحَقُّ بِنَفْسِهَا ، ثُمَّ خَطَبَهَا فَتَزَوَّجَهَا  .         [6/295]","","Sunan Sa'id ibn Mansur 1042","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن محمد بن قيس الهمداني عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2220","1043  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  حِبَّانُ بْنُ عَلِيٍّ ،  نَا  جُوَيْبِرٌ ،  عَنِ  الضَّحَّاكِ ، قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ :  إِذَا قَالَ الرَّجُلُ : كُلُّ امْرَأَةٍ أَتَزَوَّجُهَا فَهِيَ طَالِقٌ  قَالَ : « فَلَيْسَ بِشَيْءٍ إِلَّا أَنْ يُوَقِّتَ  »  .","","Sunan Sa'id ibn Mansur 1043","","عبد الله بن مسعود عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن حبان بن علي العنزي عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2221","1044  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ  فِي رَجُلٍ قَالَ : « إِنْ تَزَوَّجْتُ فُلَانَةَ ، أَوْ قَالَ : مِنْ بَنِي فُلَانٍ ، فَهِيَ طَالِقٌ  ، فَإِنْ تَزَوَّجَ فَهِيَ طَالِقٌ ، وَإِنْ قَالَ : كُلُّ امْرَأَةٍ يَتَزَوَّجُهَا فَهِيَ طَالِقٌ ، فَلَيْسَ بِشَيْءٍ  »  .","","Sunan Sa'id ibn Mansur 1044","","إبراهيم النخعي عن منصور بن المعتمر عن حماد بن زيد عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2222","1045  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ  أَنَّهُ قَالَ فِي رَجُلٍ قَالَ : « كُلُّ امْرَأَةٍ يَتَزَوَّجُهَا فَهِيَ طَالِقٌ قَالَ : لَيْسَ بِشَيْءٍ  ، هَذَا رَجُلٌ مِنَ الْمُحْصَنَاتِ  . وَإِذَا قَالَ : إِنْ تَزَوَّجْتُ فُلَانَةَ فَهِيَ طَالِقٌ ، فَإِنْ تَزَوَّجَهَا فَهِيَ طَالِقٌ كَمَا قَالَ  »  .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : كذا في ص ، وصوابه عندي ما في المحلى 9 / 468 : ""هذا رجل حرم المحصنات على نفسه""","","Sunan Sa'id ibn Mansur 1045","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2223","1046  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا سَمَّاهَا أَوْ نَسَبَهَا ، أَوْ سَمَّى مِصْرًا  ، أَوْ  وَقَّتَ  وَقْتًا ، فَهُوَ كَمَا قَالَ  »  .","","Sunan Sa'id ibn Mansur 1046","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2224","1047  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ، أَنَّهُ كَانَ يَقُولُ مِثْلَ ذَلِكَ .         [6/296]","","Sunan Sa'id ibn Mansur 1047","","الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2225","1048  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  خَالِدٌ ،  عَنْ  مُغِيرَةَ ، وَالشَّعْبِيِّ  فِي رَجُلٍ قَالَ : كُلُّ امْرَأَةٍ يَتَزَوَّجُهَا فَهِيَ طَالِقٌ  ، قَالَا : « لَيْسَ بِشَيْءٍ حَرَّمَ الْمُحْصَنَاتِ » . فَإِذَا قَالَ : كُلُّ امْرَأَةٍ يَتَزَوَّجُهَا مِنْ بَنِي فُلَانٍ ، أَوْ مِنْ مِصْرٍ ، أَوْ قَبِيلَةٍ ، فَهِيَ طَالِقٌ كَمَا قَالَ  »  .","","Sunan Sa'id ibn Mansur 1048","","الشعبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2226","1049  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  صَالِحِ بْنِ مُسْلِمٍ ، وَمُطَرِّفٍ ،  عَنِ  الشَّعْبِيِّ  فِي رَجُلٍ قَالَ لِامْرَأَتِهِ : « إِنْ تَزَوَّجْتُ امْرَأَةً مَا دُمْتِ عِنْدِي  فَهِيَ طَالِقٌ  .","","Sunan Sa'id ibn Mansur 1049","","الشعبي عن مطرف بن طريف عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2227","1050  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  خَالِدُ بْنُ عَبْدٍ ،  عَنْ  صَالِحِ بْنِ مُسْلِمٍ ،  عَنِ  الشَّعْبِيِّ  فِي رَجُلٍ قَالَ : كُلُّ امْرَأَةٍ يَتَزَوَّجُهَا مِنْ  بَنِي أَسَدٍ  فَهِيَ طَالِقٌ  قَالَ : « يَتَحَوَّلُ إِلَى غَيْرِهِمْ » .","","Sunan Sa'id ibn Mansur 1050","","الشعبي عن صالح بن مسلم العجلي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2228","1051  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  حِبَّانُ بْنُ عَلِيٍّ ،  عَنْ  عَمْرِو بْنِ مُحَمَّدٍ ، وَسَالِمِ بْنِ عَبْدِ اللهِ ، قَالَا : «  إِذَا قَالَ : كُلُّ امْرَأَةٍ يَتَزَوَّجُهَا فَهِيَ طَالِقٌ ، فَهُوَ كَمَا قَالَ  »  .         [6/297]","","Sunan Sa'id ibn Mansur 1051","","سالم بن عبد الله بن عمر بن الخطاب عن حبان بن علي العنزي عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2229","1052  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :  قُلْتُ  لِعَطَاءٍ : رَجُلٌ قَالَ لِامْرَأَةٍ : إِنْ نَكَحْتُهَا فَهِيَ عَلَيْهِ كَظَهْرِ أُمِّهِ  قَالَ : « يُكَفِّرُ إِنْ نَكَحَهَا قَبْلَ أَنْ يُصِيبَهَا ، ذَلِكُمْ تُوعَظُونَ بِهِ  »  .","","Sunan Sa'id ibn Mansur 1052","","عطاء بن أبي رباح عن ابن جريج عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2230","1053  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو مُعَاوِيَةَ ،  نَا  عُبَيْدَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  سُئِلَ عَنْ رَجُلٍ ، تَزَوَّجَ حُرَّةً وَأَمَةً فِي عُقْدَةٍ  قَالَ : « يُثَبِّتُ نِكَاحَ الْحُرَّةِ وَيُسْقِطُ نِكَاحَ الْأَمَةِ  »  .","","Sunan Sa'id ibn Mansur 1053","","إبراهيم النخعي عن عبيدة بن معتب الضبي عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2231","1054  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  أَنَّ  أَبَاهُ  كَانَ يَقُولُ : «  كُلُّ طَلَاقٍ أَوْ عِتْقٍ قَبْلَ الْمِلْكِ فَهُوَ بَاطِلٌ  »  .","","Sunan Sa'id ibn Mansur 1054","","عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2232","1055  -  حَدَّثَنَا  سَعِيدٌ ، قَالَ :  نَا  أَبُو مُعَاوِيَةَ ،  نَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ قَالَ :  جَاءَتْ إِلَى الشَّعْبِيِّ امْرَأَةٌ ، فَقَالَتْ : إِنِّي حَلَفْتُ لِزَوْجِي أَنْ لَا أَتَزَوَّجَ بَعْدَهُ  بِأَيْمَانٍ غَلِيظَةٍ ، فَمَا تَرَى ؟ قَالَ : « أَرَى أَنْ نَبْدَأَ بِحَلَالِ اللهِ عَزَّ وَجَلَّ قَبْلَ حَرَامِكُمْ  » .  ( آخِرُ كِتَابِ النِّكَاحِ ) .","","Sunan Sa'id ibn Mansur 1055","","الشعبي عن إسماعيل بن أبي خالد عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء فيمن طلق قبل أن يملك"
"2233","[6/298]      كِتَابُ الطَّلَاقِ .  1056  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  فِي قَوْلِهِ عَزَّ وَجَلَّ :         {      فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ         }      « أَنْ يُطَلِّقَهَا مِنْ غَيْرِ جِمَاعٍ  ، ثُمَّ يُمْهِلَ حَتَّى تَحِيضَ حَيْضَةً ثُمَّ تَطْهُرَ ، ثُمَّ يُمْهِلَ حَتَّى تَحِيضَ حَيْضَةً ثُمَّ تَطْهُرَ ، إِنْ أَرَادَ أَنْ يُرَاجِعَ رَاجَعَهَا  »  .","","Sunan Sa'id ibn Mansur 1056","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن سعيد بن منصور","كتاب الطلاق"
"2234","1057  -  أَخْبَرَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ : الْأَعْمَشُ  نَا  عَنْ  مَالِكِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ :  قَالَ  عَبْدُ اللهِ : «  الطَّلَاقُ لِلْعِدَّةِ أَنْ يُطَلِّقَ الرَّجُلُ امْرَأَتَهُ وَهِيَ طَاهِرٌ  فِي غَيْرِ جِمَاعٍ  »  .","","Sunan Sa'id ibn Mansur 1057","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن مالك بن الحارث السلمي عن الأعمش عن هشيم بن بشير عن سعيد بن منصور","كتاب الطلاق"
"2235","1058  -  أَخْبَرَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ قَالَ :  كَانَ ابْنُ عَبَّاسٍ يَقْرَأُ : « ( فَطَلِّقُوهُنَّ لِقُبُلِ عِدَّتِهِنَّ )  »  .","","Sunan Sa'id ibn Mansur 1058","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","كتاب الطلاق"
"2236","1059  -  أَخْبَرَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :  سَمِعْتُ  مُجَاهِدًا يَقُولُ : «  فَطَلِّقُوهُنَّ  لِقُبُلِ  عِدَّتِهِنَّ  » ،  قَالَ  سُفْيَانُ  : وَمَا سَمِعْتُ  ابْنَ جُرَيْجٍ  يَقُولُ فِي شَيْءٍ : سَمِعْتُ  مُجَاهِدًا  ، إِلَّا فِي هَذَا  .","","Sunan Sa'id ibn Mansur 1059","","مجاهد بن جبر المخزومي عن ابن جريج عن سفيان بن عيينة عن سعيد بن منصور","كتاب الطلاق"
"2237","1060  -  أَخْبَرَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  خَالِدٍ ،  عَنِ  ابْنِ سِيرِينَ قَالَ : «  الطَّلَاقُ لِلْعِدَّةِ أَنْ يُطَلِّقَهَا ، طَاهِرًا  مِنْ غَيْرِ جِمَاعٍ أَوْ حَمْلٍ بَيِّنٍ  »  .         [6/299]","","Sunan Sa'id ibn Mansur 1060","","محمد بن سيرين عن خالد الحذاء عن خالد بن عبد الله الطحان عن سعيد بن منصور","كتاب الطلاق"
"2238","1061  -  أَخْبَرَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  خَالِدٌ ، وَابْنُ عَوْنٍ ،  عَنِ  ابْنِ سِيرِينَ قَالَ : «  الطَّلَاقُ لِلْعِدَّةِ أَنْ يُطَلِّقَ الرَّجُلُ امْرَأَتَهُ وَهِيَ طَاهِرٌ  مِنْ غَيْرِ جِمَاعٍ أَوْ حَبَلٍ بَيِّنٌ حَبَلُهَا  »  .","","Sunan Sa'id ibn Mansur 1061","","محمد بن سيرين عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","كتاب الطلاق"
"2239","1062  -  أَخْبَرَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَبْدُ الْمَلِكِ بْنُ أَبِي سُلَيْمَانَ ، قَالَ :  كُنْتُ عِنْدَ سَعِيدِ بْنِ جُبَيْرٍ ، فَأَتَاهُ رَجُلٌ مِنْ أَهْلِ الْبَصْرَةِ ، فَقَالَ : « إِنِّي ابْتُلِيتُ بِأَمْرٍ عَظِيمٍ  . قَالَ : وَمَا هُوَ ؟ قَالَ : امْرَأَتُهُ ابْنَةُ عَمِّهِ ، أُحَدِّثُ نَفْسِي بِطَلَاقِهَا ، حَتَّى أَرَى أَنَّ لِسَانِي قَدْ تَحَرَّكَ بِذَاكَ ، وَحَتَّى أَضَعَ يَدِي عَلَى فَمِي مَخَافَةَ أَنْ يَبْدُرَنِي الْكَلَامُ بِطَلَاقِهَا .  فَقَالَ  سَعِيدٌ  : أَتَرْكٌ مُطِيعٌ  ؟ قَالَ : مَا سَأَلْتُكَ إِلَّا وَأَنَا أُرِيدُ أَنْ أُطِيعَكَ . قَالَ : فَإِنَّ الطَّلَاقَ لَيْسَ هُنَاكَ ، وَالطَّلَاقُ الَّذِي أَمَرَ اللهُ بِهِ أَنْ يُطَلِّقَ الرَّجُلُ امْرَأَتَهُ وَهِيَ طَاهِرٌ مِنْ غَيْرِ جِمَاعٍ ، وَأَنْ يُشْهِدَ عَلَى طَلَاقِهَا وَعَلَى رَجْعَتِهَا إِنْ أَرَادَ ذَلِكَ ، فَذَلِكَ الطَّلَاقُ الَّذِي أَمَرَ اللهُ بِهِ  »  .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : كذا في ص ، والصواب عندي : أتراك مطيع ، أي: أتظن نفسك أنك مطيع ، أو أتراك مطيعا","","Sunan Sa'id ibn Mansur 1062","","سعيد بن جبير الأسدي عن عبد الملك بن أبي سليمان العرزمي عن هشيم بن بشير عن سعيد بن منصور","كتاب الطلاق"
"2240","بَابُ التَّعَدِّي فِي الطَّلَاقِ .  1063  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ، قَالَ :  جَاءَ رَجُلٌ إِلَى عَبْدِ اللهِ ، فَقَالَ : « إِنِّي طَلَّقْتُ امْرَأَتِي تِسْعًا وَتِسْعِينَ  . قَالَ  عَبْدُ اللهِ  : فَمَا قَالُوا لَكَ ؟ قَالَ : قَالُوا : حَرُمَتْ عَلَيْكَ .  قَالَ  عَبْدُ اللهِ  : لَقَدْ أَرَادُوا أَنْ يَشُقُّوا عَلَيْكَ ،  بَانَتْ  مِنْكَ بِثَلَاثٍ ، وَسَائِرُهُنَّ عُدْوَانٌ  »  .         [6/300]","","Sunan Sa'id ibn Mansur 1063","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب التعدي في الطلاق"
"2241","1064  -  أَخْبَرَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مَالِكِ بْنِ الْحَارِثِ ، قَالَ :  جَاءَ رَجُلٌ إِلَى ابْنِ عَبَّاسٍ ، فَقَالَ : « إِنْ عَمَّهُ طَلَّقَ امْرَأَتَهُ ثَلَاثًا فَأَكْثَرَ  .  فَقَالَ  : عَصَيْتَ اللهَ عَزَّ وَجَلَّ ،  وَبَانَتْ  مِنْكَ امْرَأَتُكَ ، وَلَمْ تَتَّقِ اللهَ عَزَّ وَجَلَّ فَيَجْعَلَ لَكَ مَخْرَجًا  »  .","","Sunan Sa'id ibn Mansur 1064","","عبد الله بن عباس عن مالك بن الحارث السلمي عن الأعمش عن سفيان بن عيينة عن سعيد بن منصور","باب التعدي في الطلاق"
"2242","1065  -  أَخْبَرَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  الْأَعْمَشُ ،  عَنْ  عِمْرَانَ بْنِ الْحَارِثِ السُّلَمِيِّ ، قَالَ :  جَاءَ رَجُلٌ إِلَى ابْنِ عَبَّاسٍ ، فَقَالَ : « إِنَّ عَمَّهُ طَلَّقَ ثَلَاثًا ، فَنَدِمَ  .  فَقَالَ  : عَمُّكَ عَصَى اللهَ فَأَنْدَمَهُ ، وَأَطَاعَ الشَّيْطَانَ فَلَمْ يَجْعَلْ لَهُ مَخْرَجًا . قَالَ : أَرَأَيْتَ إِنْ أَنَا تَزَوَّجْتُهَا عَنْ غَيْرِ عِلْمٍ مِنْهُ ، أَتَرْجِعُ إِلَيْهِ ؟ فَقَالَ : مَنْ يُخَادِعِ اللهَ عَزَّ وَجَلَّ يَخْدَعْهُ اللهُ  »  .","","Sunan Sa'id ibn Mansur 1065","","عبد الله بن عباس عن عمران بن الحارث السلمي عن الأعمش عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2243","1066  -  أَخْبَرَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مَعْشَرٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ         [6/301]      الْمَقْبُرِيِّ ، قَالَ :  إِنِّي لَعِنْدَ عَبْدِ اللهِ بْنِ عُمَرَ إِذْ جَاءَهُ رَجُلٌ يُقَالُ لَهُ  مُهْرٌ مَوْلًى لِآلِ أَبِي نَمِرٍ  ، فَقَالَ : « يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، إِنَّهُ طَلَّقَ امْرَأَتَهُ مِائَةَ مَرَّةٍ .  قَالَ  : مَا اسْمُكَ ؟ قَالَ :  مَهْرٌ  . قَالَ : بَلْ أَنْتَ  مُهَيْرٌ  ، يُؤْخَذُ مِنْكَ ثَلَاثَةٌ ، وَسَبْعَةٌ وَتِسْعُونَ يُحَاسِبُكَ اللهُ عَزَّ وَجَلَّ بِهَا يَوْمَ الْقِيَامَةِ  »  .","","Sunan Sa'id ibn Mansur 1066","","عبد الله بن عمر بن الخطاب عن سعيد المقبري عن نجيح بن عبد الرحمن السندي عن سعيد بن منصور","باب التعدي في الطلاق"
"2244","1067  -  أَخْبَرَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  هِشَامِ بْنِ حُجَيْرٍ ،  عَنْ  طَاوُسٍ ، قَالَ :  قَالَ  عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ : «  قَدْ كَانَ لَكُمْ فِي الطَّلَاقِ أَنَاةٌ ، فَاسْتَعْجَلْتُمْ أَنَاتَكُمْ  ، وَقَدْ أَجَزْنَا عَلَيْكُمْ مَا اسْتَعْجَلْتُمْ مِنْ ذَلِكَ  »  .","","Sunan Sa'id ibn Mansur 1067","","عمر بن الخطاب عن طاوس بن كيسان عن هشام بن حجير الحجازي عن سفيان بن عيينة عن سعيد بن منصور","باب التعدي في الطلاق"
"2245","1068  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَبُو حُرَّةَ ،  عَنِ  الْحَسَنِ  فِي الرَّجُلِ يُطَلِّقُ امْرَأَتَهُ ثَلَاثًا  بِكَلِمَةٍ  وَاحِدَةٍ  ، فَقَالَ :  قَالَ  عُمَرُ : « لَوْ حَمَلْنَاهُمْ عَلَى كِتَابِ اللهِ . ثُمَّ قَالَ : لَا ، بَلْ نُلْزِمُهُمْ مَا أَلْزَمُوا أَنْفُسَهُمْ  »  .","","Sunan Sa'id ibn Mansur 1068","","عمر بن الخطاب عن الحسن البصري عن واصل بن عبد الرحمن البصري عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2246","1069  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  سَعِيدٍ الْجُرَيْرِيِّ ،  عَنِ  الْحَسَنِ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ ، كَتَبَ إِلَى  أَبِي مُوسَى الْأَشْعَرِيِّ  : «  لَقَدْ هَمَمْتُ أَنْ أَجْعَلَ إِذَا طَلَّقَ الرَّجُلُ امْرَأَتَهُ ثَلَاثًا فِي مَجْلِسٍ أَنْ أَجْعَلَهَا وَاحِدَةً  ، وَلَكِنَّ أَقْوَامًا حَمَلُوا عَلَى أَنْفُسِهِمْ ، فَأَلْزِمْ كُلَّ نَفْسٍ مَا أَلْزَمَ نَفْسَهُ ، مَنْ قَالَ لِامْرَأَتِهِ : أَنْتِ عَلَيَّ  حَرَامٌ  فَهِيَ  حَرَامٌ  ، وَمَنْ قَالَ لِامْرَأَتِهِ : أَنْتِ بَائِنَةٌ فَهِيَ بَائِنَةٌ ، وَمَنْ قَالَ : أَنْتِ طَالِقٌ ثَلَاثًا فَهِيَ ثَلَاثٌ  »  .","","Sunan Sa'id ibn Mansur 1069","","عمر بن الخطاب عن الحسن البصري عن سعيد بن إياس الجريري عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب التعدي في الطلاق"
"2247","1070  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  نَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ  أَنَّهُ         [6/302]      كَانَ يَكْرَهُ أَنْ يُطَلِّقَ الرَّجُلُ امْرَأَتَهُ ثَلَاثًا بِكَلِمَةٍ وَاحِدَةٍ  ، وَيَقُولُ : « لِيُطَلِّقْهَا وَاحِدَةً ، ثُمَّ لِيَدَعْهَا حَتَّى تَنْقَضِيَ الْعِدَّةُ  »  .","","Sunan Sa'id ibn Mansur 1070","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2248","1071  -  أَخْبَرَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَبُو عَوْنٍ ،  عَنِ  ابْنِ سِيرِينَ «  أَنَّهُ كَانَ لَا يَرَى بَأْسًا أَنْ يُطَلِّقَ ثَلَاثًا  »  .","","Sunan Sa'id ibn Mansur 1071","","محمد بن سيرين عن عبد الله بن عون بن أرطبان عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2249","1072  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  زَكَرِيَّاءُ ،  عَنِ  الشَّعْبِيِّ قَالَ : «  أَتَاهُ رَجُلٌ ، فَقَالَ إِنَّهُ يُرِيدُ أَنْ يَسْتَرِيحَ مِنِ امْرَأَتِهِ  . قَالَ : فَطَلِّقْهَا ثَلَاثًا إِنْ شِئْتَ  »  .","","Sunan Sa'id ibn Mansur 1072","","الشعبي عن زكريا بن أبي زائدة الوادعي عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2250","1073  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو عَوَانَةَ ،  عَنْ  شَقِيقٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  فِي مَنْ طَلَّقَ امْرَأَتَهُ ثَلَاثًا قَبْلَ أَنْ يَدْخُلَ بِهَا قَالَ : « لَا تَحِلُّ لَهُ  حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  » .  وَكَانَ عُمَرُ « إِذَا أُتِيَ بِرَجُلٍ طَلَّقَ امْرَأَتَهُ ثَلَاثًا أَوْجَعَ ظَهْرَهُ  »  .","","Sunan Sa'id ibn Mansur 1073","","أنس بن مالك عن شقيق بن أبي عبد الله الحضرمي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب التعدي في الطلاق"
"2251","1074  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  شَقِيقٍ ،  سَمِعَ  أَنَسَ بْنَ مَالِكٍ ،  يَقُولُ  فِي الرَّجُلِ يُطَلِّقُ امْرَأَتَهُ ثَلَاثًا قَبْلَ أَنْ يَدْخُلَ بِهَا قَالَ : « هِيَ ثَلَاثٌ  ، لَا تَحِلُّ         [6/303]      لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ .  وَكَانَ عُمَرُ إِذَا أُتِيَ بِهِ أَوْجَعَهُ  »  .","","Sunan Sa'id ibn Mansur 1074","","أنس بن مالك عن شقيق بن أبي عبد الله الحضرمي عن سفيان بن عيينة عن سعيد بن منصور","باب التعدي في الطلاق"
"2252","1075  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ، قَالَ  سُفْيَانُ  : أَظُنُّهُ  عَنْ  أَبِي سَلَمَةَ ،  أَنَّ  ابْنَ عَبَّاسٍ ، وَأَبَا هُرَيْرَةَ ، وَعَبْدَ اللهِ بْنَ عَمْرٍو  قَالُوا  فِي الَّذِي يُطَلِّقُ امْرَأَتَهُ ثَلَاثًا قَبْلَ أَنْ يَدْخُلَ بِهَا  : « إِنَّهَا لَا تَحِلُّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  »  .","","Sunan Sa'id ibn Mansur 1075","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن الزهري عن سفيان بن عيينة عن سعيد بن منصور","باب التعدي في الطلاق"
"2253","1076  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ، وَحَمَّادُ بْنُ زَيْدٍ ، وَأَبُو عَوَانَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنِ  ابْنِ مَسْعُودٍ  فِيمَنْ طَلَّقَ امْرَأَتَهُ ثَلَاثًا قَبْلَ أَنْ يَدْخُلَ بِهَا  قَالَ : « لَا تَحِلُّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  »  .","","Sunan Sa'id ibn Mansur 1076","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن حماد بن زيد عن سعيد بن منصور","باب التعدي في الطلاق"
"2254","1077  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَطَاءٍ وَجَابِرِ بْنِ زَيْدٍ ، قَالَا : «  إِذَا طُلِّقَتِ الْبِكْرُ ثَلَاثًا فَهِيَ وَاحِدَةٌ  »  .","","Sunan Sa'id ibn Mansur 1077","","عطاء بن أبي رباح عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب التعدي في الطلاق"
"2255","1078  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَبِي هَاشِمٍ ،  عَنْ  إِبْرَاهِيمَ  فِي الرَّجُلِ يَقُولُ لِامْرَأَتِهِ وَلَمْ يَدْخُلْ بِهَا : أَنْتِ طَالِقٌ  ، أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ قَالَ : «  بَانَتْ  بِالْأُولَى ، وَالثِّنْتَانِ لَيْسَ بِشَيْءٍ ، وَإِنْ طَلَّقَهَا ثَلَاثًا بِفَمٍ وَاحِدٍ         [6/304]      لَمْ تَحِلَّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  » .","","Sunan Sa'id ibn Mansur 1078","","إبراهيم النخعي عن يحيى بن دينار الرماني عن حماد بن زيد عن سعيد بن منصور","باب التعدي في الطلاق"
"2256","1079  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  فِيمَنْ طَلَّقَ امْرَأَتَهُ ثَلَاثًا ، وَلَمْ يَدْخُلْ بِهَا قَالَ : « لَا تَحِلُّ لَهُ  حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ . وَإِذَا قَالَ : أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ ،  بَانَتْ  بِالْأَوْلَى ، وَلَمْ يَكُنِ الْأُخْرَيَانِ بِشَيْءٍ  »  .","","Sunan Sa'id ibn Mansur 1079","","مسروق بن الأجدع عن الشعبي عن جابر الجعفي عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2257","1080  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُطَرِّفٌ ،  عَنِ  الْحَكَمِ أَنَّهُ قَالَ :  إِذَا قَالَ : « هِيَ طَالِقٌ ثَلَاثًا ، لَمْ تَحِلَّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  ، وَإِذَا قَالَ : أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ ،  بَانَتْ  بِالْأُولَى ، وَلَمْ تَكُنِ الْأُخْرَيَانِ بِشَيْءٍ . فَقِيلَ لَهُ : عَمَّنْ هَذَا يَا  أَبَا عَبْدِ اللهِ  ؟ فَقَالَ :  عَنْ  عَلِيٍّ ، وَعَبْدِ اللهِ ، وَزَيْدِ بْنِ ثَابِتٍ  »  .","","Sunan Sa'id ibn Mansur 1080","","زيد بن ثابت الأنصاري عن الحكم بن عتيبة الكندي عن مطرف بن طريف عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2258","1081  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ  فِي الرَّجُلِ يَقُولُ لِامْرَأَتِهِ : أَنْتِ طَالِقٌ ثَلَاثًا قَبْلَ أَنْ يَدْخُلَ بِهَا  قَالَ : « إِنْ أَخْرَجَهُنَّ جَمِيعًا لَمْ تَحِلَّ لَهُ ، فَإِذَا أَخْرَجَهُنَّ  تَتْرَى  بَانَتْ  بِالْأُولَى ، وَالثِّنْتَانِ لَيْسَتَا بِشَيْءٍ  »  .","","Sunan Sa'id ibn Mansur 1081","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب التعدي في الطلاق"
"2259","1082  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  مُغِيرَةُ ، قَالَ : «  إِذَا قَالَ : أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ قَالَ : إِذَا كَانَ كَلَامًا مُتَّصِلًا لَمْ تَحِلَّ لَهُ  حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ ، وَإِذَا قَالَ : أَنْتِ طَالِقٌ ثُمَّ سَكَتَ ، ثُمَّ قَالَ : أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ ،  بَانَتْ  بِالْأُولَى ، وَلَمْ تَكُنِ الْأُخْرَيَانِ شَيْئًا  »  .         [6/305]","","Sunan Sa'id ibn Mansur 1082","","المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2260","1083  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَعْقِلٍ الْمُزَنِيِّ أَنَّهُ قَالَ : «  إِذَا كَانَ مُتَّصِلًا لَمْ تَحِلَّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  »  .","","Sunan Sa'id ibn Mansur 1083","","عبد الله بن معقل بن مقرن المزني عن الشعبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2261","1084  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ «  فِي رَجُلٍ طَلَّقَ امْرَأَتَهُ قَبْلَ أَنْ يَدْخُلَ بِهَا طَلَاقًا مُتَّصِلًا  يَقُولُ : أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ قَالَ : لَا تَحِلُّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  »  .","","Sunan Sa'id ibn Mansur 1084","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب التعدي في الطلاق"
"2262","1085  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ، وَهُشَيْمٌ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  عَزْرَةَ ،  عَنِ  ابْنِ مَسْعُودٍ  فِي رَجُلٍ طَلَّقَ امْرَأَتَهُ ثَلَاثًا قَبْلَ أَنْ يَدْخُلَ بِهَا  قَالَ : « لَا تَحِلُّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  » .","","Sunan Sa'id ibn Mansur 1085","","عبد الله بن مسعود عن عزرة بن عبد الرحمن بن زرارة عن خالد الحذاء عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب التعدي في الطلاق"
"2263","1086  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَتَّابُ بْنُ بَشِيرٍ ، قَالَ :  أَنَا  خُصَيْفٌ ،  عَنْ  زِيَادِ بْنِ أَبِي مَرْيَمَ ،  عَنِ  ابْنِ مَسْعُودٍ  فِي الرَّجُلِ يُطَلِّقُ امْرَأَتَهُ جَمِيعًا وَلَمْ يَكُنْ دَخَلَ بِهَا  قَالَ : « هِيَ ثَلَاثٌ ، فَإِنْ طَلَّقَ وَاحِدَةً ثُمَّ ثَنَّى وَثَلَّثَ لَمْ يَقَعْ عَلَيْهَا لِأَنَّهَا  بَانَتْ  بِالْأَوَّلِ  »  .","","Sunan Sa'id ibn Mansur 1086","","عبد الله بن مسعود عن زياد بن أبي مريم الجزري عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2264","1087  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَبُو بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ : «  إِذَا قَالَ : أَنْتِ طَالِقٌ ثَلَاثًا قَبْلَ أَنْ يَدْخُلَ بِهَا  ، لَمْ تَحِلَّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  »  .","","Sunan Sa'id ibn Mansur 1087","","سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2265","1088  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حُمَيْدٌ ،  عَنِ  الْحَسَنِ  أَنَّهُ         [6/306]      قَالَ فِيمَنْ طَلَّقَ امْرَأَتَهُ ثَلَاثًا قَبْلَ أَنْ يَدْخُلَ بِهَا  قَالَ : « رَغِمَ أَنْفُهُ بَلَغَ حَدَّهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  »  .","","Sunan Sa'id ibn Mansur 1088","","الحسن البصري عن حميد الطويل عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2266","1089  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ أَنَّهُ قَالَ : «  بَعْدَ ذَلِكَ إِنْ شَاءَ خَطَبَهَا  »  .","","Sunan Sa'id ibn Mansur 1089","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2267","1090  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ، وَحُصَيْنٌ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  لَا تَحِلُّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  »  .","","Sunan Sa'id ibn Mansur 1090","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2268","1091  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ، أَنَّهُ قَالَ ذَلِكَ أَيْضًا .","","Sunan Sa'id ibn Mansur 1091","","الشعبي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2269","1092  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ  أَنَّهُ سُئِلَ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَهُ أَلْفًا قَبْلَ أَنْ يَدْخُلَ بِهَا  قَالَ : «  بَانَتْ  مِنْهُ بِثَلَاثٍ وَسَائِرُهُنَّ مَعْصِيَةٌ  »  .","","Sunan Sa'id ibn Mansur 1092","","إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب التعدي في الطلاق"
"2270","1093  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ قَالَ :  سُئِلَ  عَبْدُ اللهِ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَهُ تِسْعًا وَتِسْعِينَ  قَالَ : « يَكْفِيكَ ثَلَاثٌ ، وَسَائِرُهُنَّ عُدْوَانٌ  »  .         [6/307]","","Sunan Sa'id ibn Mansur 1093","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن جرير بن عبد الحميد عن سعيد بن منصور","باب التعدي في الطلاق"
"2271","1094  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَطَاءٍ الْخُرَاسَانِيِّ ،  أَنَّ  الْعَلَاءَ بْنَ جَعْوَنَةَ  ، طَلَّقَ امْرَأَتَهُ مِائَةَ تَطْلِيقَةٍ  ، فَأَرْسَلَ إِلَيْهِ عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ : « أَنِ اعْتَزَلِ امْرَأَتَكَ  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : في ص بإهمال الحروف ، والصواب عندي العلاء بن جارية ، فقد ذكر ابن حجر في الإصابة أنه روى الذهلي في الزهريات عن أبي المغيرة بن عبد الرحمن بن يزيد ، عن الزهري عن سليمان بن يسار أن العلاء بن جارية الثقفي طلق امرأته فأخبر بذلك عمر ، فسأله فقال : نعم ، مائة مرة ، فقال : فقد بانت منك أمرأتك ( 2 / 497 )","","Sunan Sa'id ibn Mansur 1094","","عمر بن الخطاب عن عطاء الخراساني عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب التعدي في الطلاق"
"2272","1095  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ بْنِ الْأَشَجِّ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  أَنَّهُ سُئِلَ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَهُ ثَلَاثًا قَبْلَ أَنْ يَدْخُلَ بِهَا  ، قَالَ : « الثَّلَاثُ وَالْوَاحِدَةُ لِلْبِكْرِ سَوَاءٌ  » ، فَقَالَ لَهُ عَبْدُ اللهِ بْنُ عَمْرٍو : «  إِنَّمَا أَنْتَ قَاصٌّ وَلَسْتَ بِمُفْتٍ ، الْوَاحِدَةُ تُبِينُهَا  ، وَالثَّلَاثُ تُحَرِّمُهَا حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  »  .","","Sunan Sa'id ibn Mansur 1095","","عبد الله بن عمرو بن العاص عن عطاء بن يسار الهلالي عن بكير بن عبد الله بن الأشج القرشي عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2273","1096  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  ابْنُ أَبِي لَيْلَى ،  عَنْ  رَجُلٍ حَدَّثَهُ  عَنْ  أَبِيهِ  ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1096","","علي بن أبي طالب عن أبيه عن رجل عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2274","1097  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حُصَيْنٌ ، وَمُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  وَلَا تَحِلُّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  »  .","","Sunan Sa'id ibn Mansur 1097","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2275","1098  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  جُوَيْبِرٌ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ عَبَّاسٍ ، وَابْنِ مَسْعُودٍ قَالَا : «  لَا تَحِلُّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  »  .","","Sunan Sa'id ibn Mansur 1098","","عبد الله بن مسعود عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن هشيم بن بشير عن سعيد بن منصور","باب التعدي في الطلاق"
"2276","1099  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  قَالَ  :  طَلَّقَ         [6/308]      ابْنُ عُمَرَ امْرَأَةً لَهُ ، فَقَالَتْ لَهُ : « هَلْ رَأَيْتَ مِنِّي شَيْئًا تَكْرَهُهُ  ؟ قَالَ : لَا ، قَالَتْ : فَفِيمَ تُطَلَّقُ الْمَرْأَةُ الْعَفِيفَةُ الْمُسْلِمَةُ ؟ قَالَ : فَارْتَجَعَهَا  »  .","","Sunan Sa'id ibn Mansur 1099","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب التعدي في الطلاق"
"2277","بَابُ مَا جَاءَ فِي طَلَاقِ السَّكْرَانِ وَمَنْ لَمْ يَرَهُ وَمَنْ أَجَازَهُ .  1100  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَزْمُ بْنُ أَبِي حَزْمٍ ، قَالَ :  سَمِعْتُ  الْحَسَنَ ، وَسَأَلَهُ رَجُلٌ فَقَالَ : «  يَا  أَبَا سَعِيدٍ  ، رَجُلٌ طَلَّقَ امْرَأَتَهُ الْبَارِحَةَ ثَلَاثًا وَهُوَ شَارِبٌ  ؟ فَقَالَ : « يُجْلَدُ ثَمَانِينَ ، وَبَرِئَتْ مِنْهُ  »  .","","Sunan Sa'id ibn Mansur 1100","","الحسن البصري عن حزم بن أبي حزم القطعي عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2278","1101  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، وَابْنِ سِيرِينَ «  أَنَّهُمَا كَانَا يُجِيزَانِ طَلَاقَ السَّكْرَانِ  وَيَرَيَانِ أَنْ يُضْرَبَ  الْحَدَّ  »  .","","Sunan Sa'id ibn Mansur 1101","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2279","1102  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ : «  طَلَاقُ السَّكْرَانِ جَائِزٌ  »  .","","Sunan Sa'id ibn Mansur 1102","","مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2280","1103  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  طَلَاقُ السَّكْرَانِ جَائِزٌ  ، وَيُضْرَبُ  الْحَدَّ  لِأَنَّهُ فِي عُدْوَانٍ  »  .","","Sunan Sa'id ibn Mansur 1103","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2281","1104  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ «  أَنَّهُ كَانَ  يُجِيزُ  طَلَاقَ السَّكْرَانِ  ، وَمَا أَتَى مِنْ حَدٍّ فِي سُكْرِهِ أُقِيمَ عَلَيْهِ  »  .         [6/309]","","Sunan Sa'id ibn Mansur 1104","","الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2282","1105  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حَجَّاجٌ ،  عَنْ  عَطَاءٍ ، أَنَّهُ كَانَ يَقُولُ ذَلِكَ أَيْضًا .","","Sunan Sa'id ibn Mansur 1105","","عطاء بن أبي رباح عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2283","1106  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ اللهِ بْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  مَخْرَمَةُ بْنُ بُكَيْرٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ مِقْسَمٍ ، قَالَ :  سَمِعْتُ  سُلَيْمَانَ بْنَ يَسَارٍ ، يَقُولُ : «  إِنَّ  رَجُلًا مِنَ آلِ أَبِي الْبَخْتَرِيِّ طَلَّقَ امْرَأَتَهُ وَهُوَ سَكْرَانٌ  فَضَرَبَهُ عُمَرُ  الْحَدَّ  وَأَجَازَ عَلَيْهِ طَلَاقَهُ  »  .","","Sunan Sa'id ibn Mansur 1106","","عمر بن الخطاب عن سليمان بن يسار مولى ميمونة زوج رسول الله عن عبيد الله بن مقسم القرشي عن مخرمة بن بكير المخزومي عن عبد الله بن وهب المصري عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2284","1107  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ، قَالَ :  أَخْبَرَنِي  عَبْدُ الرَّحْمَنِ بْنُ حَرْمَلَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ «  أَنَّهُ كَانَ يَرَى طَلَاقَ السَّكْرَانِ جَائِزًا  »  .","","Sunan Sa'id ibn Mansur 1107","","سعيد بن المسيب عن عبد الرحمن بن حرملة الأسلمي عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2285","1108  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ، قَالَ :  أَخْبَرَنِي  هِشَامُ بْنُ حَسَّانَ ،  عَنِ  الْحَسَنِ مِثْلَهُ .","","Sunan Sa'id ibn Mansur 1108","","الحسن البصري عن هشام بن حسان العتكي عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2286","1109  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  حَجَّاجٌ ،  عَنْ  عَطَاءٍ «  أَنَّهُ كَانَ  يُجِيزُ  طَلَاقَ النَّشْوَانِ  »  .         [6/310]","","Sunan Sa'id ibn Mansur 1109","","عطاء بن أبي رباح عن حجاج بن أرطاة عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2287","1110  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ  عَنْ  عُمَرَ بْنِ عَبْدِ الْعَزِيزِ :  أَنَّهُ أُتِيَ بِرَجُلٍ طَلَّقَ امْرَأَتَهُ وَهُوَ سَكْرَانُ فَاسْتَحْلَفَهُ بِاللهِ الَّذِي لَا إِلَهَ إِلَّا هُوَ أَنَّهُ طَلَّقَ وَمَا يَعْقِلُ  ، فَحَلَفَ فَرَدَّ عَلَيْهِ امْرَأَتَهُ وَضَرَبَهُ  الْحَدَّ  .","","Sunan Sa'id ibn Mansur 1110","","عمر بن عبد العزيز بن مروان عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2288","1111  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ أَنَّهُ قَالَ : كَمَا قَالَ  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ  .","","Sunan Sa'id ibn Mansur 1111","","القاسم بن محمد بن أبي بكر الصديق عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2289","1112  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ قَالَ :  نَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبَانَ بْنِ عُثْمَانَ ،  عَنْ  عُثْمَانَ رَضِيَ اللهُ عَنْهُ قَالَ :  كُلُّ الطَّلَاقِ جَائِزٌ إِلَّا طَلَاقَ النَّشْوَانِ  ، وَطَلَاقَ الْمَجْنُونِ  .","","Sunan Sa'id ibn Mansur 1112","","عثمان بن عفان عن أبان بن عثمان بن عفان عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2290","1113  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  الْأَعْمَشُ  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَابِسِ بْنِ رَبِيعَةَ النَّخَعِيِّ ، قَالَ :  سَمِعْتُ  عَلِيًّا رَضِيَ اللهُ عَنْهُ يَقُولُ :  كُلُّ الطَّلَاقِ جَائِزٌ إِلَّا طَلَاقَ  الْمَعْتُوهِ  .","","Sunan Sa'id ibn Mansur 1113","","علي بن أبي طالب عن عابس بن ربيعة الغطيفي عن إبراهيم النخعي عن الأعمش عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2291","1114  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  أَشْعَثُ بْنُ سَوَّارٍ قَالَ :  أَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَابِسٍ ،  عَنْ  أَبِيهِ  أَنَّهُ سَمِعَ  عَلِيًّا رَضِيَ اللهُ عَنْهُ يَقُولُ ذَلِكَ أَيْضًا .","","Sunan Sa'id ibn Mansur 1114","","علي بن أبي طالب عن عابس بن ربيعة الغطيفي عن عبد الرحمن بن عابس النخعي عن أشعث بن سوار عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2292","1115  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ وَأَبُو عَوَانَةَ وَأَبُو مُعَاوِيَةَ  عَنِ         [6/311]      الْأَعْمَشِ  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَابِسِ بْنِ رَبِيعَةَ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  كُلُّ الطَّلَاقِ جَائِزٌ إِلَّا طَلَاقَ  الْمَعْتُوهِ  .","","Sunan Sa'id ibn Mansur 1115","","علي بن أبي طالب عن عابس بن ربيعة الغطيفي عن إبراهيم النخعي عن الأعمش عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2293","1116  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو شِهَابٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَابِسِ بْنِ رَبِيعَةَ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  مَنْ طَلَّقَ فَيَجُوزُ طَلَاقُهُ إِلَّا طَلَاقَ  الْمَعْتُوهِ  .","","Sunan Sa'id ibn Mansur 1116","","علي بن أبي طالب عن عابس بن ربيعة الغطيفي عن إبراهيم النخعي عن الأعمش عن عبد ربه بن نافع الحناط عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2294","1117  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  إِسْمَاعِيلُ بْنُ سَالِمٍ ، قَالَ :  سَمِعْتُ  الْحَكَمَ بْنَ عُتَيْبَةَ قَالَ : «  مَنْ طَلَّقَ فِي سُكْرٍ مِنَ اللهِ عَزَّ وَجَلَّ فَلَيْسَ طَلَاقُهُ بِشَيْءٍ  ، وَمَنْ طَلَّقَ [ فِي ] سُكْرٍ مِنَ الشَّيْطَانِ فَطَلَاقُهُ لَهُ لَازِمٌ  »  .","","Sunan Sa'id ibn Mansur 1117","","الحكم بن عتيبة الكندي عن إسماعيل بن سالم الأسدي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2295","1118  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْحَجَّاجُ ،  عَنِ  الْحَكَمِ قَالَ : «  كَانَ يَقُولُ فِي طَلَاقِ الْمُبَرْسَمِ ، وَالْمَحْمُومِ الَّذِي يَهْذِي وَنِكَاحِ الْجِنِّ أَنَّ طَلَاقَهُمْ لَيْسَ بِشَيْءٍ  ، وَإِنَّ نِكَاحَ الْجِنِّ لَيْسَ بِشَيْءٍ  »  .","","Sunan Sa'id ibn Mansur 1118","","الحكم بن عتيبة الكندي عن حجاج بن أرطاة عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2296","1119  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  عُبَيْدَةَ ،  عَنْ  إِبْرَاهِيمَ قَالَ : «  طَلَاقُ السَّكْرَانِ جَائِزٌ  ، وَالْمُبَرْسَمِ لَا يَجُوزُ  »  .         [6/312]","","Sunan Sa'id ibn Mansur 1119","","إبراهيم النخعي عن عبيدة بن معتب الضبي عن حفص بن غياث النخعي عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2297","1120  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  صَالِحِ بْنِ مُسْلِمٍ ، وَإِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ قَالَ : «  لَا يَجُوزُ طَلَاقُ الْمَجْنُونِ إِذَا طَلَّقَ فِي جُنُونِهِ  ، وَإِذَا عَقَلَ فَطَلَاقُهُ جَائِزٌ  »  .","","Sunan Sa'id ibn Mansur 1120","","الشعبي عن صالح بن صالح بن حي الثوري عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2298","1121  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  صَالِحِ بْنِ مُسْلِمٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  لَا يَجُوزُ طَلَاقُ  الْمَعْتُوهِ  »  .","","Sunan Sa'id ibn Mansur 1121","","الشعبي عن صالح بن صالح بن حي الثوري عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2299","1122  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ  وَغَيْرِ وَاحِدٍ مِنْ أَصْحَابِنَا  عَنِ  الشَّعْبِيِّ ، قَالَا : «  طَلَاقُ الْمَجْنُونِ فِي إِفَاقَتِهِ جَائِزٌ  ، وَإِذَا طَلَّقَ فِي غَيْرِ إِفَاقَتِهِ لَمْ يَجُزْ طَلَاقُهُ  »  .","","Sunan Sa'id ibn Mansur 1122","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2300","1123  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  لَا يَجُوزُ طَلَاقُ الْمَجْنُونِ حَتَّى يَبْرَأَ  »  .","","Sunan Sa'id ibn Mansur 1123","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2301","1124  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُحَمَّدُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  لَا يَجُوزُ طَلَاقُ الْمَغْلُوبِ عَلَى عَقْلِهِ  »  .","","Sunan Sa'id ibn Mansur 1124","","الشعبي عن محمد بن سالم الهمداني عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2302","1125  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  عَنْ  مُغِيرَةَ  عَنْ  عُبَيْدَةَ  عَنْ  إِبْرَاهِيمَ ،  وَمُحَمَّدِ بْنِ سَالِمٍ  ،  عَنِ  الشَّعْبِيِّ ،  وَيُونُسَ  ،  عَنِ  الْحَسَنِ «  أَنَّهُمْ لَمْ يَرَوْا طَلَاقَ الْمُبَرْسَمِ شَيْئًا  »  .         [6/313]","","Sunan Sa'id ibn Mansur 1125","","الشعبي عن محمد بن سالم الهمداني عن عبيدة بن معتب الضبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2303","1126  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  إِذَا كَانَ الْمَجْنُونُ يُفِيقُ وَيَعْقِلُ جَازَ مَا صَنَعَ فِي إِفَاقَتِهِ  مِنْ عِتْقٍ ، أَوْ طَلَاقٍ ، أَوْ حَدٍّ ، أَوْ شِرًى  »  .","","Sunan Sa'id ibn Mansur 1126","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2304","1127  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُبَيْدِ اللهِ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  لَا يَجُوزُ نِكَاحُ السَّكْرَانِ وَيَجُوزُ طَلَاقُهُ  »  .","","Sunan Sa'id ibn Mansur 1127","","الشعبي عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب ما جاء في طلاق السكران ومن لم يره ومن أجازه"
"2305","بَابُ مَا جَاءَ فِي طَلَاقِ الْمُكْرَهِ .  1128  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِبْرَاهِيمُ بْنُ قُدَامَةَ بْنِ إِبْرَاهِيمَ الْجُمَحِيُّ ، قَالَ :  سَمِعْتُ  أَبِي قُدَامَةَ بْنَ إِبْرَاهِيمَ  ،  أَنَّ رَجُلًا عَلَى عَهْدِ عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ تَدَلَّى بِشَتَّارٍ عَسَلًا فَأَقْبَلَتِ امْرَأَتُهُ فَجَلَسَتْ عَلَى الْحَبْلِ  ، فَقَالَتْ : لَتُطَلِّقَنَّهَا ثَلَاثًا وَإِلَّا قَطَعَتِ الْحَبْلَ ، فَذَكَّرَهَا اللهَ وَالْإِسْلَامَ أَنْ تَفْعَلَ فَأَبَتْ أَوْ تَقْطَعَ الْحَبْلَ أَوْ يُطَلِّقَهَا ، فَطَلَّقَهَا ثَلَاثًا ، ثُمَّ خَرَجَ إِلَى  عُمَرَ بْنِ الْخَطَّابِ  رَضِيَ اللهُ عَنْهُ فَذَكَرَ ذَلِكَ لَهُ ،  فَقَالَ  : « ارْجِعْ إِلَى أَهْلِكَ فَلَيْسَ هَذَا بِطَلَاقٍ  »  .","","Sunan Sa'id ibn Mansur 1128","","عمر بن الخطاب عن قدامة بن إبراهيم الجمحي عن إبراهيم بن قدامة بن إبراهيم الجمحي عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2306","1129  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  فَرَجُ بْنُ فَضَالَةَ ، قَالَ :  حَدَّثَنِي  عُمَرُ بْنُ         [6/314]      شَرَاحِيلَ الْمَعَافِرِيُّ ، قَالَ :  كَانَتِ امْرَأَةٌ مُبْغِضَةٌ لِزَوْجِهَا فَأَرَادَتْهُ عَلَى الطَّلَاقِ فَأَبَى  فَجَاءَتْ ذَاتَ لَيْلَةٍ فَلَمَّا رَأَتْهُ نَائِمًا ، قَامَتْ وَأَخَذَتْ سَيْفَهُ ، فَوَضَعَتْهُ عَلَى بَطْنِهِ ثُمَّ حَرَّكَتْهُ بِرِجْلِهَا فَقَالَ : وَيْلَكِ مَا لَكِ ؟ قَالَتْ : وَاللهِ لَتُطَلِّقَنِّي وَإِلَّا أَنْفَذْتُكَ بِهِ ، فَطَلَّقَهَا ثَلَاثًا ، فَرُفِعَ ذَلِكَ إِلَى عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ فَأَرْسَلَ إِلَيْهَا فَشَتَمَهَا ،  فَقَالَ  : مَا حَمَلَكِ عَلَى مَا صَنَعْتِ ؟ قَالَتْ بُغْضِي إِيَّاهُ فَأَمْضَى طَلَاقَهَا  .","","Sunan Sa'id ibn Mansur 1129","","عمر بن الخطاب عن عمر بن شراحيل عن فرج بن فضالة بن النعمان التنوخي عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2307","1130  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ قَالَ :  حَدَّثَنِي  الْغَازُ بْنُ جَبَلَةَ الْجُبْلَانِيُّ ،  عَنْ  صَفْوَانَ بْنِ عِمْرَانَ الطَّائِيِّ ،  أَنَّ رَجُلًا كَانَ نَائِمًا مَعَ امْرَأَتِهِ فَقَامَتْ فَأَخَذَتْ  سِكِّينًا  فَجَلَسَتْ عَلَى صَدْرِهِ وَوَضَعَتِ  السِّكِّينَ  عَلَى حَلْقِهِ وَقَالَتْ : لَتُطَلِّقَنِّي ثَلَاثًا أَلْبَتَّةَ وَإِلَّا ذَبَحْتُكَ ، فَنَاشَدَهَا اللهَ ، فَأَبَتْ عَلَيْهِ فَطَلَّقَهَا ثَلَاثًا فَذَكَرَ ذَلِكَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : «  لَا قَيْلُولَةَ فِي الطَّلَاقِ  »  .","","Sunan Sa'id ibn Mansur 1130","","صفوان بن غزوان الطائي عن غازي بن جبلة الجبلاني عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2308","1131  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنِ  الْغَازِ بْنِ جَبَلَةَ الْجُبْلَانِيِّ ،  أَنَّهُ سَمِعَ  صَفْوَانَ الْأَصَمَّ ، يَقُولُ :  بَيْنَا رَجُلٌ نَائِمٌ لَمْ يَرُعْهُ إِلَّا وَامْرَأَتُهُ         [6/315]      جَالِسَةٌ عَلَى صَدْرِهِ ، وَاضِعَةٌ  السِّكِّينَ  عَلَى فُؤَادِهِ وَهِيَ تَقُولُ : لَتُطَلِّقَنِّي أَوْ لَأَقْتُلُنَّكَ ، فَطَلَّقَهَا ، ثُمَّ أَتَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ ذَلِكَ لَهُ ، فَقَالَ : «  لَا قَيْلُولَةَ فِي الطَّلَاقِ  ، لَا قَيْلُولَةَ فِي الطَّلَاقِ  »  .","","Sunan Sa'id ibn Mansur 1131","","صفوان بن غزوان الطائي عن غازي بن جبلة الجبلاني عن الوليد بن مسلم القرشي عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2309","1132  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ، قَالَ :  حَضَرْتُ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ أُتِيَ بِرَجُلٍ كَانَ يَكُونُ فِي بَنِي حَطْمَةَ يُقَالُ لَهُ :  الْقُمَّرِيُّ  ضَرَبَهُ قَوْمٌ عَلَى أَنْ يُطَلِّقَ امْرَأَتَهُ  ، وَقَالُوا : « لَا نَدَعُكَ وَاللهِ حَتَّى نَقْتُلَكَ أَوْ تُطَلِّقَهَا  الْبَتَّةَ  وَجَاءَ عَلَى ذَلِكَ بِالْبَيِّنَةِ فَرَدَّهَا عَلَيْهِ  »  .","","Sunan Sa'id ibn Mansur 1132","","عمر بن عبد العزيز بن مروان عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2310","1133  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  فَرَجُ بْنُ فَضَالَةَ ، قَالَ :  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ، قَالَ :  كَانَ رَجُلٌ تَزَوَّجَ  أُخْتَ يَزِيدَ بْنِ مُهَلَّبٍ  زَمَنَ  الْحَجَّاجِ  ، وَأَهْلُهَا كَارِهُونَ  ، فَلَمَّا وَلِيَ  يَزِيدُ بْنُ الْمُهَلَّبِ  الْعِرَاقَ  أَرْسَلَ إِلَيْهِ ، وَقَالَ : طَلِّقْهَا فَأَبَى ، فَضَرَبَهُ  يَزِيدُ  ، وَقَالَ : وَاللهِ لَا أَرْفَعُ عَنْكَ السِّيَاطَ حَتَّى تُطَلِّقَهَا ، فَطَلَّقَهَا ، فَلَمَّا كَانَ زَمَنُ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ أَتَاهُ فَاسْتَغَاثَ بِهِ ، فَقَالَ  عُمَرُ  : « أَمَّا ضَرْبُهُ إِيَّاكَ فَسَيَلْقَى اللهَ بِهِ يَوْمَ الْقِيَامَةِ ، وَأَمَّا الطَّلَاقُ فَقَدْ مَضَى » .","","Sunan Sa'id ibn Mansur 1133","","عمر بن عبد العزيز بن مروان عن معاوية بن صالح بن حدير الحضرمي عن فرج بن فضالة بن النعمان التنوخي عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2311","1134  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ، وَالْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ  أَنَّهُ كَانَ يَرَى طَلَاقَ الْمُكْرَهِ جَائِزًا  ، قَالَ  الْأَعْمَشُ  : قَالَ  إِبْرَاهِيمُ  : « إِنَّمَا هُوَ شَيْءٌ افْتَدَى بِهِ نَفْسَهُ  »  .         [6/316]","","Sunan Sa'id ibn Mansur 1134","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2312","1135  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  سَيَّارٌ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  قِيلَ لَهُ : إِنَّهُمْ يَزْعُمُونَ أَنَّكَ لَا تَرَى طَلَاقَ الْمُكْرَهِ شَيْئًا فَقَالَ : « أَنْتُمْ تَكْذِبُونَ عَلَيَّ وَأَنَا حَيٌّ  ، فَكَيْفَ لَا تَكْذِبُونَ عَلَى  إِبْرَاهِيمَ  وَقَدْ مَاتَ ؟  »  .","","Sunan Sa'id ibn Mansur 1135","","الشعبي عن سيار بن أبي سيار العنزي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2313","1136  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حُصَيْنٌ ،  عَنِ  الشَّعْبِيِّ  أَنَّهُ « كَانَ  يُجِيزُ  طَلَاقَ السُّلْطَانِ عَلَى الْإِكْرَاهِ  ، وَلَا  يُجِيزُ  طَلَاقَ اللُّصُوصِ  »  .","","Sunan Sa'id ibn Mansur 1136","","الشعبي عن حصين بن عبد الرحمن السلمي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2314","1137  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ، وَأَبُو عَوَانَةَ  عَنْ  حُصَيْنٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  إِنْ أَكْرَهَهُ اللُّصُوصُ فَطَلَّقَ فَلَا يَجُوزُ  ، وَإِنْ أَكْرَهَهُ السُّلْطَانُ فَطَلَّقَ فَهُوَ جَائِزٌ  »  .","","Sunan Sa'id ibn Mansur 1137","","الشعبي عن حصين بن عبد الرحمن السلمي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2315","1138  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ، وَمَنْصُورٌ ،  عَنِ  الْحَسَنِ «  أَنَّهُ كَانَ لَا يَرَى طَلَاقَ الْمُكْرَهِ شَيْئًا  »  .","","Sunan Sa'id ibn Mansur 1138","","الحسن البصري عن منصور بن المعتمر عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2316","1139  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ «  أَنَّهُ كَانَ لَا يَرَى طَلَاقَ الْمُكْرَهِ شَيْئًا  »  .","","Sunan Sa'id ibn Mansur 1139","","الحسن البصري عن قتادة بن دعامة عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2317","1140  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ «  أَنَّهُ كَانَ يَهَابُ طَلَاقَ الْمُسْتَكْرَهِ  »  .","","Sunan Sa'id ibn Mansur 1140","","الحسن البصري عن يونس بن عبيد عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2318","1141  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَبْدُ الْمَلِكِ ، وَحَجَّاجٌ ،  عَنْ  عَطَاءٍ «  أَنَّهُ كَانَ لَا يَرَى طَلَاقَ الْمُكْرَهِ شَيْئًا  »  .","","Sunan Sa'id ibn Mansur 1141","","عطاء بن أبي رباح عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2319","1142  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَبْدُ الْمَلِكِ ،  عَنْ  عَطَاءٍ ، قَالَ : «  الشِّرْكُ  أَعْظَمُ مِنَ الطَّلَاقِ  »  .         [6/317]","","Sunan Sa'id ibn Mansur 1142","","عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2320","1143  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَبْدُ اللهِ بْنُ طَلْحَةَ الْخُزَاعِيُّ ، قَالَ :  حَدَّثَنِي  أَبُو يَزِيدَ الْمَدِينِيُّ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّهُ قَالَ : «  لَيْسَ لِمُكْرَهٍ وَلَا لِمُضْطَهَدٍ طَلَاقٌ  »  .","","Sunan Sa'id ibn Mansur 1143","","عبد الله بن عباس عن أبو يزيد المديني عن عبد الله بن طلحة الخزاعي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2321","1144  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ، وَعَوْفٌ ،  عَنِ  الْحَسَنِ ، قَالَ : «  إِنَّ اللهَ عَزَّ وَجَلَّ  تَجَاوَزَ  لِهَذِهِ الْأُمَّةِ عَنِ النِّسْيَانِ  ، وَالْخَطَأِ وَمَا أُكْرِهُوا عَلَيْهِ  »  .","","Sunan Sa'id ibn Mansur 1144","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2322","1145  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  هِشَامٍ ،  عَنِ  الْحَسَنِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ عَفَا لَكُمْ عَنْ ثَلَاثٍ  : عَنِ الْخَطَأِ ، وَالنِّسْيَانِ ، وَمَا اسْتُكْرِهْتُمْ عَلَيْهِ  .","","Sunan Sa'id ibn Mansur 1145","","الحسن البصري عن هشام بن حسان العتكي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2323","1146  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ، قَالَ :  حَدَّثَنِي  جَعْفَرُ بْنُ حَيَّانَ الْعُطَارِدِيُّ ،  عَنِ  الْحَسَنِ ، قَالَ : سَمِعْتُهُ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ         [6/318]      عَلَيْهِ وَسَلَّمَ : «  تَجَاوُزَ اللهُ عَزَّ وَجَلَّ لِابْنِ آدَمَ عَمَّا أَخْطَأَ وَعَمَّا نَسِيَ  ، وَعَمَّا أُكْرِهَ ، وَعَمَّا غُلِبَ عَلَيْهِ  »  .","","Sunan Sa'id ibn Mansur 1146","","الحسن البصري عن جعفر بن حيان العطاردي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2324","1147  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو شِهَابٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  طَلَاقُ السُّلْطَانِ وَاللُّصُوصِ جَائِزٌ  » .","","Sunan Sa'id ibn Mansur 1147","","إبراهيم النخعي عن الأعمش عن عبد ربه بن نافع الحناط عن سعيد بن منصور","باب ما جاء في طلاق المكره"
"2325","بَابُ الرَّجُلِ يَحْلِفُ إِنْ لَمْ يَضْرِبْ غُلَامَهُ مِائَةَ سَوْطٍ فَامْرَأَتُهُ طَالِقٌ .  1148  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ  فِي رَجُلٍ قَالَ لِامْرَأَتِهِ : إِنْ لَمْ آتِ  الْبَصْرَةَ  فَأَنْتِ طَالِقٌ  ، قَالَ : « هِيَ امْرَأَتُهُ حَتَّى يَمُوتَ ، فَإِنْ مَاتَ وَاحِدٌ مِنْهُمَا فَلَا مِيرَاثَ بَيْنَهُمَا  »  .","","Sunan Sa'id ibn Mansur 1148","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2326","1149  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  لَا يَقْرَبْهَا حَتَّى يَفْعَلَ مَا حَلَفَ عَلَيْهِ  »  .","","Sunan Sa'id ibn Mansur 1149","","الحسن البصري عن يونس بن يزيدالأيلي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2327","1150  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَشْعَثُ بْنُ سَوَّارٍ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّهُ قَالَ  فِي رَجُلٍ قَالَ : إِنْ لَمْ يَضْرِبْ غُلَامَهُ مِائَةَ سَوْطٍ فَامْرَأَتُهُ طَالِقٌ  قَالَ : هِيَ امْرَأَتُهُ حَتَّى يَضْرِبَ الْغُلَامَ أَوْ يَمُوتَ  .","","Sunan Sa'id ibn Mansur 1150","","الشعبي عن أشعث بن سوار عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2328","1151  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  صَالِحِ بْنِ مُسْلِمٍ ،  عَنِ  الشَّعْبِيِّ ،  فِي رَجُلٍ قَالَ لِغُلَامِهِ : إِنْ لَمْ أَضْرِبْهُ فَامْرَأَتُهُ طَالِقٌ  فَأَبَقَ  الْغُلَامُ  ، فَقَالَ : « هِيَ امْرَأَتُهُ حَتَّى يَمُوتَ الْغُلَامُ  »  . قَالَ سَعِيدٌ :  بِئْسَ مَا قَالَ  .         [6/319]      حَبْلُكِ عَلَى  غَارِبِكِ  وَنَحْوَ ذَلِكَ مِنَ الْكِنَايَاتِ .","","Sunan Sa'id ibn Mansur 1151","","الشعبي عن صالح بن مسلم العجلي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2329","1152  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  أَنَّ  رَجُلًا قَالَ لِامْرَأَتِهِ : حَبْلُكِ عَلَى  غَارِبِكِ  ، قَالَ ذَلِكَ مِرَارًا ، فَأَتَى عُمَرَ بْنَ الْخَطَّابِ فَاسْتَحْلَفَهُ بَيْنَ  الرُّكْنِ  وَالْمَقَامِ  : « مَا الَّذِي أَرَدْتَ بِقَوْلِكَ ؟ » قَالَ : أَرَدْتُ الطَّلَاقَ ، فَفَرَّقَ بَيْنَهُمَا  .","","Sunan Sa'id ibn Mansur 1152","","عمر بن الخطاب عن عطاء بن أبي رباح عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2330","1153  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ، وَابْنُ أَبِي لَيْلَى ، وَعَبْدُ الْمَلِكِ ،  عَنْ  عَطَاءٍ ،  أَنَّ رَجُلًا قَالَ لِامْرَأَتِهِ : حَبْلُكِ عَلَى  غَارِبِكِ  ، فَأَتَى  عُمَرَ بْنَ الْخَطَّابِ  فَذَكَرَ ذَلِكَ لَهُ . قَالَ  هُشَيْمٌ  : قَالَ  عَبْدُ الْمَلِكِ  مِنْ بَيْنِ  الْقَوْمِ  : فَأَرْسَلَ إِلَى عَلِيِّ بْنِ أَبِي طَالِبٍ رَضِيَ اللهُ عَنْهُ : وَافِنِي فِي الْمَوْسِمِ ، فَوَافَاهُ بِهِ فَأَقَامَهُ بَيْنَ  الرُّكْنِ  وَالْمَقَامِ  ثُمَّ « اسْتَحْلَفَهُ مَا أَرَادَ بِقَوْلِهِ ؟ » فَقَالَ : أَمَا إِنَّهَا ابْنَةُ عَمِّي وَأَكْرَمُ النَّاسِ عَلَيَّ ، وَلَوْ أَقَمْتَنِي فِي غَيْرِ هَذَا الْمَقَامِ لَعَلِّي ، فَأَمَّا إِذْ أَقَمْتَنِي فِي هَذَا الْمَقَامِ ، فَإِنَّمَا أَرَدْتُ فِرَاقَهَا ، « فَفَرَّقَ بَيْنَهُمَا »  .","","Sunan Sa'id ibn Mansur 1153","","علي بن أبي طالب عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2331","1154  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ ،  فِي رَجُلٍ قَالَ لِامْرَأَتِهِ : اذْهَبِي فَلَا حَاجَةَ لِي فِيكِ  ، قَالَ : « هِيَ ثَلَاثٌ  »  .","","Sunan Sa'id ibn Mansur 1154","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2332","1155  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّهُ         [6/320]      سُئِلَ عَنْ رَجُلٍ قَالَ لِامْرَأَتِهِ : اذْهَبِي فَتَزَوَّجِي  ، قَالَ : « لَيْسَ بِشَيْءٍ إِنْ لَمْ يَنْوِ طَلَاقًا » . فَذَكَرْنَا ذَلِكَ لِلشَّعْبِيِّ  فَقَالَ  :  وَالَّذِي يُحْلَفُ بِهِ ، إِنَّ أَهْوَنَ مِنْ هَذَا لَيَكُونُ طَلَاقًا  »  .","","Sunan Sa'id ibn Mansur 1155","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2333","1156  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو الْأَحْوَصِ ، قَالَ :  نَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ  فِي رَجُلٍ قَالَ لِامْرَأَتِهِ : قَدْ أَذِنْتُ لَكِ فَانْكِحِي مَنْ شِئْتِ  ، قَالَ : « لَيْسَ بِشَيْءٍ » .  قَالَ  الْمُغِيرَةُ :  فَسَأَلْتُ  الشَّعْبِيَّ عَنْ ذَلِكَ فَقَالَ :  إِنَّ أَهْوَنَ مِنْ هَذَا لَيَكُونُ طَلَاقًا  »  .","","Sunan Sa'id ibn Mansur 1156","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن سلام بن سليم الحنفي عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2334","1157  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ  فِي رَجُلٍ قَالَ لِامْرَأَتِهِ : قَدْ أَذِنْتُ لَكِ أَنْ تَزَوَّجِي  ، قَالَ : « إِنْ كَانَ عَنَى طَلَاقًا وَإِلَّا فَلَا شَيْءَ  »  .","","Sunan Sa'id ibn Mansur 1157","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2335","1158  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  وَمُحَمَّدُ بْنُ سَالِمٍ  ،  عَنِ  الشَّعْبِيِّ ،  أَنَّهُمَا قَالَا  فِي رَجُلٍ قَالَ لِامْرَأَتِهِ : الْحَقِي بِأَهْلِكِ ، وَلَا سَبِيلَ لِي عَلَيْكِ  ، وَالطَّرِيقُ لَكِ وَاسِعٌ ، قَالَا : « إِنْ كَانَ نَوَى الطَّلَاقَ فَهِيَ وَاحِدَةٌ وَهُوَ أَحَقُّ بِهَا ، وَإِنْ لَمْ يَنْوِ طَلَاقًا فَلَيْسَ بِشَيْءٍ  »  .","","Sunan Sa'id ibn Mansur 1158","","الحسن البصري عن يونس بن يزيدالأيلي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2336","1159  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  سَأَلْتُهُ عَنْ رَجُلٍ قَالَ لِامْرَأَتِهِ : لَيْسَتْ لِي بِامْرَأَةٍ  ، قَالَ ذَلِكَ مِرَارًا ، قَالَ : « مَا أُرَاهُ بَلَغَ الثَّلَاثَ إِلَّا وَهُوَ يُرِيدُ الطَّلَاقَ  »  .","","Sunan Sa'id ibn Mansur 1159","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2337","1160  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  فِي رَجُلٍ قَالَ لِامْرَأَتِهِ : مَا أَنْتِ لِي بِامْرَأَةٍ  ، فَأَكْثَرَ مِنْ ذَلِكَ ، قَالَ : « مَا أُرَاهُ قَالَ ذَلِكَ ثَلَاثًا إِلَّا وَهُوَ يَنْوِي الطَّلَاقَ  »  .","","Sunan Sa'id ibn Mansur 1160","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2338","[6/321]      1161  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  وَمُغِيرَةُ  عَنْ  إِبْرَاهِيمَ ،  وَسَيَّارٌ  عَنِ  الشَّعْبِيِّ  أَنَّهُمْ قَالُوا  فِي رَجُلٍ سُئِلَ : أَلَكَ امْرَأَةٌ ؟ فَقَالَ : لَا  ، وَلَهُ امْرَأَةٌ ، قَالُوا : « هِيَ كَذْبَةٌ  »  .","","Sunan Sa'id ibn Mansur 1161","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2339","1162  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  سُئِلَ عَنْ رَجُلٍ قِيلَ لَهُ : أَلَكَ امْرَأَةٌ ؟ وَلَهُ امْرَأَةٌ قَالَ : لَا  ، قَالَ : « لَيْسَ بِشَيْءٍ كَذْبَةٌ كَذَبَهَا  »  .","","Sunan Sa'id ibn Mansur 1162","","إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2340","1163  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  فِي الرَّجُلِ يُقَالُ لَهُ : « تَزَوَّجْتَ ؟ فَيَقُولُ : لَا  ، وَيُقَالُ : لَكَ امْرَأَةٌ ؟ فَيَقُولُ : لَا ، قَالَ : لَيْسَ بِشَيْءٍ كَذْبَةٌ كَذَبَهَا  »  .","","Sunan Sa'id ibn Mansur 1163","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2341","1164  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ قَالَ :  كَانَ يُقَالُ : « الطَّلَاقُ مَا عُنِيَ بِهِ الطَّلَاقُ  »  .","","Sunan Sa'id ibn Mansur 1164","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2342","1165  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ  أَنَّهُ كَانَ يُقَالُ : « إِنَّمَا الطَّلَاقُ مَا عُنِيَ بِهِ الطَّلَاقُ  »  .","","Sunan Sa'id ibn Mansur 1165","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2343","1166  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  مَعْمَرٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ، قَالَ : «  مَا أُرِيدَ بِهِ الطَّلَاقُ فَهُوَ طَلَاقٌ  »  .","","Sunan Sa'id ibn Mansur 1166","","طاوس بن كيسان عن عبد الله بن طاووس عن معمر بن راشد عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2344","1167  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْحَجَّاجُ بْنُ أَرْطَاةَ ،         [6/322]      عَنْ  إِسْمَاعِيلَ بْنِ رَجَاءٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  مَسْرُوقٍ قَالَ : «  كُلُّ كَلَامٍ يُشْبِهُ الطَّلَاقَ أُرِيدَ بِهِ الطَّلَاقُ فَهُوَ طَلَاقٌ  »  .","","Sunan Sa'id ibn Mansur 1167","","مسروق بن الأجدع عن إبراهيم النخعي عن إسماعيل بن رجاء الزبيدي عن حجاج بن أرطاة عن أبو معاوية الضرير عن سعيد بن منصور","باب الرجل يحلف إن لم يضرب غلامه مائة سوط فامرأته طالق"
"2345","بَابُ الرَّجُلِ يَكُونُ لَهُ أَرْبَعُ نِسْوَةٍ فَيَقُولُ : بَيْنُكُنَّ تَطْلِيقَةٌ .  1168  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ  فِي رَجُلٍ لَهُ أَرْبَعُ نِسْوَةٍ ، فَقَالَ : بَيْنَكُنَّ تَطْلِيقَةٌ  ، قَالَ : « يُطَلِّقُ كُلَّ وَاحِدَةٍ مِنْهُنَّ تَطْلِيقَةً  »  .","","Sunan Sa'id ibn Mansur 1168","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يكون له أربع نسوة فيقول بينكن تطليقة"
"2346","1169  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ  فِي رَجُلٍ قَالَ لِأَرْبَعِ نِسْوَةٍ : قَسَمْتُ بَيْنَكُنَّ تَطْلِيقَةً قَالَ : « يُطَلِّقُ كُلَّ وَاحِدَةٍ وَاحِدَةً إِلَى أَرْبَعِ تَطْلِيقَاتٍ  ، فَإِنْ قَالَ : خَمْسَ تَطْلِيقَاتٍ ، طُلِّقَتْ كُلُّ وَاحِدَةً ثِنْتَيْنِ إِلَى ثَمَانِ تَطْلِيقَاتٍ ، فَإِنْ قَالَ : تِسْعَ تَطْلِيقَاتٍ ، طُلِّقَتْ كُلُّ وَاحِدَةٍ ثَلَاثًا  »  .","","Sunan Sa'id ibn Mansur 1169","","الحسن البصري عن قتادة بن دعامة عن معمر بن راشد عن عبد الله بن المبارك عن سعيد بن منصور","باب الرجل يكون له أربع نسوة فيقول بينكن تطليقة"
"2347","1170  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ  فِي رَجُلٍ لَهُ أَرْبَعُ نِسْوَةٍ فَقَالَ : امْرَأَتُهُ طَالِقٌ  ، وَلَمْ يَدْرِ أَيَّتَهُنَّ طَلَّقَ ، قَالَ : « يَنْوِي ، فَإِنْ لَمْ يَكُنْ نَوَى اعْتَزَلَهُنَّ جَمِيعًا  »  .","","Sunan Sa'id ibn Mansur 1170","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يكون له أربع نسوة فيقول بينكن تطليقة"
"2348","1171  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  عَمْرِو بْنِ         [6/323]      هَرِمٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي رَجُلٍ لَهُ ثَلَاثُ نِسْوَةٍ طَلَّقَ إِحْدَاهُنَّ تَطْلِيقَةً ، وَلَمْ تَقَعْ نِيَّتُهُ عَلَى أَحَدٍ مِنْهُنَّ  قَالَ : «  يَنَالُهُنَّ  مِنَ الطَّلَاقِ مَا  يَنَالُهُنَّ  مِنَ الْمِيرَاثِ  »  .","","Sunan Sa'id ibn Mansur 1171","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن هرم الأزدي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب الرجل يكون له أربع نسوة فيقول بينكن تطليقة"
"2349","1172  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَبُو بِشْرٍ ،  عَنْ  عَمْرِو بْنِ هَرِمٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، مِثْلَهُ .","","Sunan Sa'id ibn Mansur 1172","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن هرم الأزدي عن جعفر بن إياس اليشكري عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يكون له أربع نسوة فيقول بينكن تطليقة"
"2350","1173  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :  أَنَا  بَعْضُ أَصْحَابِنَا  أَنَّ رَجُلًا مِنْ أَهْلِ  عَمَّانَ  اسْتَفْتَى  ابْنَ عَبَّاسٍ  وَكَانَ عِنْدَهُ نِسْوَةٌ فَطَلَّقَ إِحْدَاهُنَّ  ،  فَقَالَ  ابْنُ عَبَّاسٍ : « إِنْ كُنْتَ نَوَيْتَهَا فِي نَفْسِكَ ثُمَّ نَسِيتَهَا فَقَدْ ذَهَبْنَ جَمِيعًا ، يَشْتَرِكْنَ فِي الطَّلَاقِ كَمَا يَشْتَرِكْنَ فِي الْمِيرَاثِ ، وَإِنْ لَمْ تَكُنْ نَوَيْتَهُنَّ فَأَيَّتَهُنَّ شِئْتَ  »  .","","Sunan Sa'id ibn Mansur 1173","","عبد الله بن عباس عن بعض أصحاب ابن جريج عن ابن جريج عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يكون له أربع نسوة فيقول بينكن تطليقة"
"2351","1174  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  وَمُغِيرَةُ  ،  عَنْ  إِبْرَاهِيمَ  أَنَّهُمَا قَالَا  فِي رَجُلٍ طَلَّقَ امْرَأَتَهُ تَطْلِيقَةً فَلَقِيَهُ رَجُلٌ فَقَالَ : طَلَّقْتَ امْرَأَتَكَ ؟ قَالَ : نَعَمْ  ، ثُمَّ لَقِيَهُ آخَرُ ، فَقَالَ مِثْلَ ذَلِكَ ، ثُمَّ لَقِيَهُ آخَرُ ، فَقَالَ مِثْلَ قَوْلِهِ الْأَوَّلِ ، قَالَا : « نِيَّتُهُ إِنْ نَوَى قَوْلَهُ الْأَوَّلَ فَإِنَّمَا هِيَ تَطْلِيقَةٌ  »  .","","Sunan Sa'id ibn Mansur 1174","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يكون له أربع نسوة فيقول بينكن تطليقة"
"2352","1175  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنِ  الْمُغَيَّرَةِ ،  عَنِ  الْحَارِثِ الْعُكْلِيِّ  فِي رَجُلٍ قَالَ لِأَرْبَعِ نِسْوَةٍ لَهُ : بَيْنَكُنَّ ثَلَاثُ تَطْلِيقَاتٍ  ، قَالَ : تَبِينُ كُلُّ وَاحِدَةٍ بِثَلَاثٍ ، وَإِذَا قَالَ لِامْرَأَتِهِ : أَنْتِ طَالِقٌ رُبُعًا ، أَوْ ثُلُثًا ، أَوْ نِصْفًا فَهِيَ تَطْلِيقَةٌ تَامَّةٌ  .","","Sunan Sa'id ibn Mansur 1175","","الحارث بن يزيد العكلي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب الرجل يكون له أربع نسوة فيقول بينكن تطليقة"
"2353","[6/324]      بَابُ الرَّجُلِ لَهُ أَرْبَعُ نِسْوَةٍ فَنَهَى وَاحِدَةً عَنِ الْخُرُوجِ ، فَوَجَدَ امْرَأَةً مِنْ نِسَائِهِ قَدْ خَرَجَتْ ، فَقَالَ : فُلَانَةُ أَنْتِ طَالِقٌ ، أَيَّتُهُنَّ تُطَلَّقُ مِنْهُ ؟ .  1176  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ  فِي رَجُلٍ لَهُ امْرَأَتَانِ نَهَى إِحْدَاهُمَا عَنِ الْخُرُوجِ ، فَخَرَجَتِ الَّتِي لَمْ تُنْهَ  ، فَظَنَّ أَنَّهَا الَّتِي نَهَى فَقَالَ : فُلَانَةُ ، أَخَرَجْتِ ؟ أَنْتِ طَالِقٌ ، قَالَ : « تُطَلَّقُ الَّتِي نَوَى ، أَوْ أَرَادَ » قَالَ  هُشَيْمٌ  : وَهُوَ الْقَوْلُ  .","","Sunan Sa'id ibn Mansur 1176","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل له أربع نسوة فنهى واحدة عن الخروج فوجد امرأة من نسائه قد خرجت فقال فلانة أنت طالق أيتهن تطلق منه"
"2354","1177  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ قَالَ :  «  تُطَلَّقَانِ جَمِيعًا الَّتِي فِي الْبَيْتِ بِتَسْمِيَتِهِ إِيَّاهَا  ، وَالَّتِي خَرَجَتْ بِقَوْلِهِ : أَنْتِ طَالِقٌ  »  .","","Sunan Sa'id ibn Mansur 1177","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل له أربع نسوة فنهى واحدة عن الخروج فوجد امرأة من نسائه قد خرجت فقال فلانة أنت طالق أيتهن تطلق منه"
"2355","1178  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، قَالَ :  سُئِلَ جَابِرُ بْنُ زَيْدٍ عَنْ رَجُلٍ ، لَهُ أَرْبَعُ نِسْوَةٍ فَطَلَعَتْ وَاحِدَةٌ  ، فَقَالَ : « أَنْتِ طَالِقٌ ؟ قَالَ : هَذِهِ أُغْلُوطَةٌ  »  .","","Sunan Sa'id ibn Mansur 1178","","جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل له أربع نسوة فنهى واحدة عن الخروج فوجد امرأة من نسائه قد خرجت فقال فلانة أنت طالق أيتهن تطلق منه"
"2356","1179  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عِيسَى بْنُ يُونُسَ ، قَالَ :  نَا  الْأَوْزَاعِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ سَعْدٍ ،  عَنِ  الصُّنَابِحِيِّ ،  عَنْ  رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَمَّاهُ ، قَالَ : «  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْأُغْلُوطَاتِ  » قَالَ  الْأَوْزَاعِيُّ  :  يَعْنِي شِرَارَ  الْمَسَائِلِ  .  قَالَ سَعِيدٌ :  هَذَا عَنْ  مُعَاوِيَةَ  وَلَكِنَّهُ لَمْ يُسَمِّهِ  .         [6/325]","","Sunan Sa'id ibn Mansur 1179","","أحد الصحابة عن عبد الرحمن بن عسيلة الصنابحي عن عبد الله بن سعد بن فروة البجلي عن أبو عمرو الأوزاعي عن عيسى بن يونس بن أبي إسحاق عن سعيد بن منصور","باب الرجل له أربع نسوة فنهى واحدة عن الخروج فوجد امرأة من نسائه قد خرجت فقال فلانة أنت طالق أيتهن تطلق منه"
"2357","1180  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  ابْنُ شُبْرُمَةَ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  النِّيَّةُ فِي الطَّلَاقِ فِيمَا خَفِيَ  ، وَأَمَّا مَا ظَهَرَ فَلَا نِيَّةَ فِيهِ  »  .","","Sunan Sa'id ibn Mansur 1180","","الشعبي عن عبد الله بن شبرمة عن هشيم بن بشير عن سعيد بن منصور","باب الرجل له أربع نسوة فنهى واحدة عن الخروج فوجد امرأة من نسائه قد خرجت فقال فلانة أنت طالق أيتهن تطلق منه"
"2358","1181  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُبَيْدِ اللهِ ،  أَنَّ  الشَّعْبِيَّ ، قَالَ : «  إِذَا تَكَلَّمَ بِالطَّلَاقِ وَنَوَى شَيْئًا فَهُوَ مَا نَوَى  »  .","","Sunan Sa'id ibn Mansur 1181","","الشعبي عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل له أربع نسوة فنهى واحدة عن الخروج فوجد امرأة من نسائه قد خرجت فقال فلانة أنت طالق أيتهن تطلق منه"
"2359","1182  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَلْقَمَةَ الْفَرْوِيُّ ، قَالَ :  حَدَّثَنِي  إِسْحَاقُ بْنُ عَبْدِ اللهِ بْنِ أَبِي فَرْوَةَ ، قَالَ : كَانَ عُثْمَانُ بْنُ عَفَّانَ رَضِيَ اللهُ عَنْهُ  يَقُولُ  : «  لَيْسَ الطَّلَاقُ عَلَى مَا أَضْمَرْتَ  ، وَلَكِنَّ الطَّلَاقَ عَلَى مَا خَرَجَ مِنْ فِيكَ  »  .","","Sunan Sa'id ibn Mansur 1182","","عثمان بن عفان عن إسحاق بن أبي فروة عن عبد الله بن محمد بن عبد الله الفروي عن سعيد بن منصور","باب الرجل له أربع نسوة فنهى واحدة عن الخروج فوجد امرأة من نسائه قد خرجت فقال فلانة أنت طالق أيتهن تطلق منه"
"2360","بَابُ الرَّجُلِ يَكْتُبُ بِطَلَاقِ امْرَأَتِهِ .  1183  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ  فِي رَجُلٍ كَتَبَ بِطَلَاقِ امْرَأَتِهِ ثُمَّ مَحَاهُ قَبْلَ أَنْ يَتَكَلَّمَ  ، قَالَ : « لَيْسَ بِشَيْءٍ إِلَّا أَنْ يُمْضِيَهُ أَوْ يَتَكَلَّمَ بِهِ  »  .","","Sunan Sa'id ibn Mansur 1183","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يكتب بطلاق امرأته"
"2361","1184  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1184","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يكتب بطلاق امرأته"
"2362","1185  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ         [6/326]      كَانَ يَقُولُ : «  إِذَا كَتَبَهُ فَقَدْ لَزِمَهُ تَكَلَّمَ بِهِ أَوْ لَمْ يَتَكَلَّمْ بِهِ  »  .","","Sunan Sa'id ibn Mansur 1185","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يكتب بطلاق امرأته"
"2363","1186  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  إِذَا خَطَّ الرَّجُلُ بِيَدِهِ الطَّلَاقَ فَهُوَ طَلَاقٌ  »  .","","Sunan Sa'id ibn Mansur 1186","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يكتب بطلاق امرأته"
"2364","1187  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُبَيْدِ اللهِ ،  عَنِ  الشَّعْبِيِّ ، وَالْحَكَمِ ، قَالَا : «  مَنْ خَطَّ بِيَدِهِ طَلَاقًا فَهُوَ كَمَا كَتَبَ  »  .","","Sunan Sa'id ibn Mansur 1187","","الحكم بن عتيبة الكندي عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يكتب بطلاق امرأته"
"2365","1188  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ ،  عَنِ  الشَّعْبِيِّ ، «  أَنَّهُ  سُئِلَ عَنْ رَجُلٍ كَتَبَ إِلَى امْرَأَتِهِ وَهُوَ غَائِبٌ : إِذَا جَاءَكِ كِتَابِي هَذَا فَاعْتَدِّي  ، فَلَمْ يَأْتِهَا الْكِتَابُ ، وَهَلَكَ دُونَهَا قَالَ : لَيْسَ بِشَيْءٍ  »  .","","Sunan Sa'id ibn Mansur 1188","","الشعبي عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يكتب بطلاق امرأته"
"2366","1189  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُبَيْدِ اللهِ ،  عَنِ  الشَّعْبِيِّ  أَنَّهُ  سُئِلَ عَنْ رَجُلٍ كَتَبَ إِلَى امْرَأَتِهِ وَهُوَ غَائِبٌ : اعْتَدِّي ، فَمَاتَتْ قَبْلَ أَنْ يَبْلُغَهَا الْكِتَابُ  ، قَالَ : « إِنْ كَانَتْ لَمْ تَنْقَضِ عِدَّتُهَا وَرِثَهَا ، وَإِنْ كَانَتْ قَدِ انْقَضَتْ عِدَّتُهَا لَمْ يَتَوَارَثَا  »  .","","Sunan Sa'id ibn Mansur 1189","","الشعبي عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يكتب بطلاق امرأته"
"2367","1190  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُبَيْدِ اللهِ ،  عَنِ  الشَّعْبِيِّ  أَنَّهُ  سُئِلَ عَنْ رَجُلٍ ، كَتَبَ إِلَى امْرَأَتِهِ : اعْتَدِّي فَزَعَمَتْ أَنَّهُ لَمْ يَأْتِهَا الْكِتَابُ  ، فَقَالَ : « أَمَّا زَوْجُهَا فَتَكَلَّمَ بِطَلَاقِهَا ، لَا يَضَرُّهَا أَتَاهَا كِتَابُهُ أَمْ لَا فَلْتَصْنَعْ مَا أَمَرَهَا بِهِ زَوْجُهَا  » .","","Sunan Sa'id ibn Mansur 1190","","الشعبي عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يكتب بطلاق امرأته"
"2368","1191  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :         [6/327]      حُدِّثْتُ عَنْ  طَاوُسٍ ،  أَنَّهُ قَالَ  فِي رَجُلٍ قَالَ لِامْرَأَتِهِ : أَفْلِحِي  ، فَقَالَ : « إِنْ كَانَ نَوَى طَلَاقَهَا فَهُوَ طَلَاقٌ  »  .","","Sunan Sa'id ibn Mansur 1191","","طاوس بن كيسان عن ابن جريج عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يكتب بطلاق امرأته"
"2369","بَابُ الرَّجُلِ تَقُولُ لَهُ امْرَأَتُهُ : شَبِّهْنِي .  1192  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ  أَنَّهُ سُئِلَ عَنْ رَجُلٍ ، قَالَتْ لَهُ امْرَأَتُهُ : شَبِّهْنِي  ، فَقَالَ : كَأَنَّكِ ظَبْيَةٌ ، كَأَنَّكِ حَمَامَةٌ ، قَالَتْ : لَا أَرْضَى حَتَّى تَقُولَ :  خَلِيَّةٌ  طَالِقٌ  ، فَقَالَ ذَلِكَ ، وَهُوَ يَعْنِي مِنَ الْإِبِلِ ، فَقَالَ  إِبْرَاهِيمُ  : « هِيَ طَالِقٌ ، فَقَالَ  الْمُغِيرَةُ  : لِمَ ؟ أَلَيْسَ كَانَ يُقَالُ : الطَّلَاقُ مَا عُنِيَ بِهِ الطَّلَاقُ ؟ فَقَالَ لِي  إِبْرَاهِيمُ  : أَلَا تَرَى أَنَّهُ يَقُولُ : أَنْتِ  خَلِيَّةٌ  طَالِقٌ  ، يَسْتَقْبِلُهَا ؟  » .","","Sunan Sa'id ibn Mansur 1192","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل تقول له امرأته شبهني"
"2370","1193  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، مِثْلَهُ ، وَلَمْ يَقُلْ : حَمَامَةٌ .","","Sunan Sa'id ibn Mansur 1193","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن سعيد بن منصور","باب الرجل تقول له امرأته شبهني"
"2371","1194  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  ابْنُ أَبِي لَيْلَى ،  عَنِ  الْحَكَمِ ،  عَنْ  خَيْثَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ شِهَابٍ الْخَوْلَانِيِّ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ أُتِيَ فِي ذَلِكَ ، فَقَالَ لِزَوْجِهَا : «  أَوْجِعْ رَأْسَهَا ، وَإِنْ طَلَّقَ بِهَا فَهِيَ امْرَأَتُكَ  » . قَالَ  هُشَيْمٌ  : وَهُوَ الْقَوْلُ  .","","Sunan Sa'id ibn Mansur 1194","","عمر بن الخطاب عن عبد الله بن شهاب الخولاني عن خيثمة بن عبد الرحمن الجعفي عن الحكم بن عتيبة الكندي عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور","باب الرجل تقول له امرأته شبهني"
"2372","[6/328]      بَابُ الرَّجُلِ يَمُوتُ عَنِ الْمَرْأَةِ بِأَرْضِ غُرْبَةٍ .  1195  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : «  إِذَا مَاتَ الرَّجُلُ عَنِ امْرَأَتِهِ ، وَهُوَ غَائِبٌ  ، أَوْ طَلَّقَ وَهُوَ غَائِبٌ ، فَإِنَّ الْعِدَّةَ تَقَعُ عَلَيْهَا مِنْ يَوْمِ يَمُوتُ أَوْ يُطَلِّقُهَا  » .","","Sunan Sa'id ibn Mansur 1195","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2373","1196  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو الْأَحْوَصِ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ قَالَ مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1196","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن سلام بن سليم الحنفي عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2374","1197  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  مُجَاهِدٍ ، وَسَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : «  تَعْتَدُّ مِنْ يَوْمِ مَاتَ أَوْ طَلَّقَ  » .","","Sunan Sa'id ibn Mansur 1197","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2375","1198  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : «  تَعْتَدُّ مِنْ يَوْمِ تُوُفِّيَ  » .","","Sunan Sa'id ibn Mansur 1198","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن حماد بن زيد عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2376","1199  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ، قَالَ :  سَأَلْتُ  سَعِيدَ بْنَ جُبَيْرٍ ، وَمُجَاهِدًا ، وَعَطَاءً ، وَأَبَا قِلَابَةَ ، وَمُحَمَّدَ بْنَ سِيرِينَ ، وَعِكْرِمَةَ         [6/329]      فَقَالُوا : «  مِنْ يَوْمِ تُوُفِّيَ  » .  قَالَ :  وَقَالَ  جَابِرُ بْنُ زَيْدٍ ، وَابْنُ عَبَّاسٍ : «  مِنْ يَوْمِ تُوُفِّيَ  » .","","Sunan Sa'id ibn Mansur 1199","","محمد بن سيرين عن أيوب السختياني عن حماد بن زيد عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2377","1200  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  الْعِدَّةُ مِنْ يَوْمِ مَاتَ أَوْ طَلَّقَ  » .","","Sunan Sa'id ibn Mansur 1200","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2378","1201  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ، وَالشَّيْبَانِيُّ ،  عَنِ  الشَّعْبِيِّ ، قَالَ مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1201","","الشعبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2379","1202  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ  فِي رَجُلٍ طَلَّقَ امْرَأَتَهُ عِنْدَ كُلِّ حَيْضَةٍ  ، قَالَ : « عِدَّتُهَا مِنَ الطَّلَاقِ الْأَوَّلِ مَا لَمْ تَكُنْ مُرَاجَعَةً »  .","","Sunan Sa'id ibn Mansur 1202","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2380","1203  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  عَنْ  خَالِدٍ ،  عَنْ  أَبِي قِلَابَةَ ، وَعُبَيْدَةَ ،  عَنْ  إِبْرَاهِيمَ ،  وَمُحَمَّدِ بْنِ سَالِمٍ  ،  عَنِ  الشَّعْبِيِّ ، قَالُوا مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1203","","إبراهيم النخعي عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2381","1204  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  عَنْ  خَالِدٍ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  تَعْتَدُّ مِنَ الطَّلَاقِ الْأَوَّلِ  » .","","Sunan Sa'id ibn Mansur 1204","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2382","1205  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  خَالِدٌ ،  عَنْ  أَبِي مَعْشَرٍ ،  عَنْ  إِبْرَاهِيمَ ، مِثْلَ قَوْلِ  الْحَسَنِ  وَأَبِي قِلَابَةَ  .","","Sunan Sa'id ibn Mansur 1205","","إبراهيم النخعي عن زياد بن كليب عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2383","1206  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ بْنُ عُبَيْدٍ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ، قَالَ : «  تَعْتَدُّ مِنَ الطَّلَاقِ الْأَوَّلِ  إِنْ رَاجَعَهَا مَا لَمْ يُجَامِعْهَا  » .","","Sunan Sa'id ibn Mansur 1206","","عطاء بن أبي رباح عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2384","1207  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَشْعَثُ ، وَمُحَمَّدُ بْنُ سَالِمٍ ،         [6/330]      عَنِ  الشَّعْبِيِّ ،  أَنَّ  ابْنَ مَسْعُودٍ ، قَالَ : «  الْعِدَّةُ مِنْ يَوْمِ مَاتَ أَوْ طَلَّقَ  » .","","Sunan Sa'id ibn Mansur 1207","","عبد الله بن مسعود عن الشعبي عن محمد بن سالم الهمداني عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2385","1208  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حُصَيْنٌ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ، قَالَ : «  الْعِدَّةُ مِنْ يَوْمِ مَاتَ أَوْ طَلَّقَ  » .","","Sunan Sa'id ibn Mansur 1208","","مسروق بن الأجدع عن الشعبي عن حصين بن عبد الرحمن السلمي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2386","1209  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  دَاوُدُ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1209","","سعيد بن المسيب عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2387","1210  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَشْعَثُ ،  عَنِ  الْحَكَمِ ،  عَنْ  أَبِي صَادِقٍ ،  عَنْ  رَبِيعَةَ بْنِ نَاجِدٍ ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ قَالَ : «  الْعِدَّةُ مِنْ يَوْمِ يَأْتِيهَا الْخَبَرُ  » .","","Sunan Sa'id ibn Mansur 1210","","علي بن أبي طالب عن ربيعة بن ناجد الأزدي عن أبو صادق الأزدي عن الحكم بن عتيبة الكندي عن أشعث بن سوار عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2388","1211  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنْ  عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، قَالَ : «  إِنْ قَامَتْ بَيِّنَةٌ فَمِنْ يَوْمِ مَاتَ أَوْ طَلَّقَ وَإِنْ لَمْ تَقُمْ بَيِّنَةٌ فَمِنْ يَوْمِ يَأْتِيهَا الْخَبَرُ  » .","","Sunan Sa'id ibn Mansur 1211","","عمر بن عبد العزيز بن مروان عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2389","1212  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  خَالِدٌ ،  عَنْ  أَبِي قِلَابَةَ ، وَأَبِي الْعَالِيَةِ ، وَابْنِ سِيرِينَ أَنَّهُمْ قَالُوا : «  مِنْ يَوْمِ مَاتَ أَوْ يَوْمِ طَلَّقَ  » .","","Sunan Sa'id ibn Mansur 1212","","محمد بن سيرين عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2390","1213  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  الْعِدَّةُ مِنْ يَوْمِ مَاتَ أَوْ يَوْمِ طَلَّقَ  » .         [6/331]","","Sunan Sa'id ibn Mansur 1213","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2391","1214  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ  فِي رَجُلٍ طَلَّقَ امْرَأَتَهُ تَطْلِيقَةً ، ثُمَّ سَافَرَ  ، ثُمَّ كَتَبَ إِلَيْهَا بِتَطْلِيقَةٍ أُخْرَى ، قَالَ : « بَيْنَهُمَا الْمِيرَاثُ مَا لَمْ تَغْتَسِلْ مِنَ الْحَيْضَةِ الثَّالِثَةِ مِنْ يَوْمِ طَلَّقَهَا ، غَيْرَ أَنَّهَا إِذَا جَاءَهَا الْخَبَرُ بَعْدَ ذَلِكَ اعْتَدَّتْ مِنْ يَوْمِ يَأْتِيهَا الْخَبَرُ ، وَلَا مِيرَاثَ بَيْنَهُمَا فِي الْعِدَّةِ الْآخِرَةِ  » .","","Sunan Sa'id ibn Mansur 1214","","الحسن البصري عن يونس بن يزيدالأيلي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2392","1215  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ، وَمَنْصُورٌ ،  عَنِ  الْحَسَنِ ، قَالَ : «  الْعِدَّةُ مِنْ يَوْمِ يَأْتِيهَا الْخَبَرُ  ، فَإِنْ طَلَّقَهَا وَاحِدَةً أَوِ اثْنَتَيْنِ إِلَى أَنْ تَطْهُرَ مِنَ الْحَيْضَةِ الثَّالِثَةِ غَيْرَ أَنَّهَا تَعْتَدُّ مِنْ يَوْمِ يَأْتِيهَا الْخَبَرُ وَلَيْسَ بَيْنَهُمَا مِيرَاثٌ فِي الْعِدَّةِ الْآخِرَةِ  » . قَالَ  هُشَيْمٌ  :  الْقَوْلُ مَا قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ  .","","Sunan Sa'id ibn Mansur 1215","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يموت عن المرأة بأرض غربة"
"2393","بَابُ الرَّجُلِ يُطَلِّقُ امْرَأَتَهُ فَتَحِيضُ ثَلَاثَ حِيَضٍ فَيَدْخُلُ عَلَيْهَا قَبْلَ أَنْ تَطْهُرَ .  1216  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ رَجُلًا مِنَ  الْأَنْصَارِ  طَلَّقَ امْرَأَتَهُ فَحَاضَتْ ثَلَاثَ حِيَضٍ  فَلَمَّا دَخَلَتْ لِتَغْتَسِلَ أَرَادَ الدُّخُولَ عَلَيْهَا فَمُنِعَ مِنْ ذَاكَ ، وَكَانَتْ ذَاتَ حَشَمٍ فَاخْتَصَمُوا إِلَى عُمَرَ بْنِ الْخَطَّابِ فَقَالَتْ : « رَأَيْتُ الطُّهْرَ وَوَضَعْتُ الثِّيَابَ وَقَرَّبْتُ الْمَاءَ ،  قَالَ  : » هَلْ كُنْتِ اسْتَنْفَضْتِ ؟ « قَالَتْ : لَا ، فَرَدَّهَا عَلَيْهِ  » .         [6/332]","","Sunan Sa'id ibn Mansur 1216","","عمر بن الخطاب عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2394","1217  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عُمَرَ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1217","","عمر بن الخطاب عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2395","1218  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عُمَرَ ، وَعَبْدِ اللهِ ، قَالَا : «  هُوَ أَحَقُّ بِهَا مَا لَمْ تَغْتَسِلْ مِنَ الْحَيْضَةِ الثَّالِثَةِ  » .","","Sunan Sa'id ibn Mansur 1218","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2396","1219  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ مِثْلَهُ .","","Sunan Sa'id ibn Mansur 1219","","علي بن أبي طالب عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2397","1220  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  أَيُّوبَ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَبِي مُوسَى الْأَشْعَرِيِّ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1220","","أبو موسى الأشعري عن الحسن البصري عن أيوب السختياني عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2398","1221  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حَجَّاجٌ ،  عَنْ  مَكْحُولٍ ،  أَنَّ  أَبَا الدَّرْدَاءِ ، وَعُبَادَةَ بْنَ الصَّامِتِ ، قَالَا مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1221","","عبادة بن الصامت عن مكحول بن أبي مسلم عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2399","1222  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَبِي مُوسَى الْأَشْعَرِيِّ ، مِثْلَهُ .","","Sunan Sa'id ibn Mansur 1222","","أبو موسى الأشعري عن الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2400","1223  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُبَيْدٍ الْكَلَاعِيِّ ،  عَنْ  مَكْحُولٍ ،  أَنَّ  أَبَا بَكْرٍ ، وَعُمَرَ ، وَعُثْمَانَ ، وَعَلِيًّا ، وَابْنَ مَسْعُودٍ وَأَبَا مُوسَى         [6/333]      الْأَشْعَرِيَّ وَأَبَا الدَّرْدَاءِ وَعُبَادَةَ بْنَ الصَّامِتِ قَالُوا : «  هُوَ أَحَقُّ بِرَجْعَتِهَا مَا لَمْ تَغْتَسِلْ مِنَ الْحَيْضَةِ الثَّالِثَةِ  » .","","Sunan Sa'id ibn Mansur 1223","","عمر بن الخطاب عن مكحول بن أبي مسلم عن عبيد الله بن عبيد الكلاعي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
