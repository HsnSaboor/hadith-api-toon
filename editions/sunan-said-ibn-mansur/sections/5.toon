hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"2401","1224  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ : «  هُوَ أَحَقُّ بِهَا مَا كَانَتْ فِي الدَّمِ  » .","","Sunan Sa'id ibn Mansur 1224","","سعيد بن جبير الأسدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2402","1225  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ : «  يُبِينُهَا مِنْ زَوْجِهَا إِذَا طَعَنَتْ فِي الْحَيْضَةِ الثَّالِثَةِ  » .","","Sunan Sa'id ibn Mansur 1225","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن الزهري عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2403","1226  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ ، قَالَ : «  إِذَا طَعَنَتْ فِي الْحَيْضَةِ الثَّالِثَةِ فَقَدْ بَرِئَ مِنْهَا  » .","","Sunan Sa'id ibn Mansur 1226","","زيد بن ثابت الأنصاري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن الزهري عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2404","1227  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  ثَوْرِ بْنِ زَيْدٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : «  إِذَا حَاضَتِ الْمُطَلَّقَةُ الثَّالِثَةَ فَقَدْ بَرِئَتْ مِنْهُ         [6/334]      إِلَّا أَنَّهَا لَا تَزَوَّجُ حَتَّى تَطْهُرَ  » .","","Sunan Sa'id ibn Mansur 1227","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن ثور بن زيد الديلي عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2405","1228  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ أَنَّهُ كَانَ يَقُولُ : «  إِذَا دَخَلَتْ فِي الْحَيْضَةِ الثَّالِثَةِ فَلَا رَجْعَةَ لَهُ  عَلَيْهَا وَلَا مِيرَاثَ بَيْنَهُمَا  » .","","Sunan Sa'id ibn Mansur 1228","","زيد بن ثابت الأنصاري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2406","1229  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ، أَنَّهُ كَانَ يَقُولُ مِثْلَ مَا قَالَ  زَيْدٌ  .","","Sunan Sa'id ibn Mansur 1229","","سالم بن عبد الله بن عمر بن الخطاب عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2407","1230  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  أَنَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  عُمَرَ ، وَابْنَ مَسْعُودٍ قَالَا : «  هُوَ أَحَقُّ بِهَا مَا لَمْ تَغْتَسِلْ مِنَ الْحَيْضَةِ الثَّالِثَةِ  » .","","Sunan Sa'id ibn Mansur 1230","","عبد الله بن مسعود عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2408","1231  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ ، قَالَتِ : «  الْأَقْرَاءُ  : الْأَطْهَارُ  » .","","Sunan Sa'id ibn Mansur 1231","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن الزهري عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2409","1232  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  مَنْ أَخْبَرَهُ  عَنْ  عَائِشَةَ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1232","","عائشة بنت أبي بكر الصديق عن من عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2410","1233  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الْعَزِيزِ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَلِيٍّ - رَضِيَ اللهُ عَنْهُ - قَالَ : «  هُوَ أَحَقُّ بِهَا مَا لَمْ تَغْتَسِلْ مِنَ الْحَيْضَةِ الثَّالِثَةِ  » .","","Sunan Sa'id ibn Mansur 1233","","علي بن أبي طالب عن أبو جعفر الباقر عن جعفر الصادق عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب الرجل يطلق امرأته فتحيض ثلاث حيض فيدخل عليها قبل أن تطهر"
"2411","بَابُ مَنْ قَالَ لِامْرَأَتِهِ : اعْتَدِّي .  1234  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :         [6/335]      «  كَانَ يُقَالُ : إِذَا قَالَ : اعْتَدِّي فَهُوَ تَطْلِيقَةٌ  » .","","Sunan Sa'id ibn Mansur 1234","","إبراهيم النخعي عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب من قال لامرأته اعتدي"
"2412","1235  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، وَعُبَيْدَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُمَا قَالَا : «  إِذَا قَالَ الرَّجُلُ لِامْرَأَتِهِ : اعْتَدِّي وَهُوَ يَنْوِي الطَّلَاقَ قَالَا : وَاحِدَةٌ  ، وَهُوَ أَحَقُّ بِهَا ، وَإِنْ لَمْ يَنْوِ طَلَاقًا فَلَيْسَ بِشَيْءٍ  » .","","Sunan Sa'id ibn Mansur 1235","","إبراهيم النخعي عن عبيدة بن معتب الضبي عن يونس بن يزيدالأيلي عن هشيم بن بشير عن سعيد بن منصور","باب من قال لامرأته اعتدي"
"2413","1236  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَبُو حُرَّةَ ،  عَنِ  الْحَسَنِ ، أَنَّهُ قَالَ : «  إِذَا قَالَ الرَّجُلُ لِامْرَأَتِهِ : أَنْتِ طَالِقٌ اعْتَدِّي ، فَهِيَ وَاحِدَةٌ  ، وَإِذَا قَالَ : أَنْتِ طَالِقٌ وَاعْتَدِّي ، فَهُمَا اثْنَتَانِ  » .","","Sunan Sa'id ibn Mansur 1236","","الحسن البصري عن واصل بن عبد الرحمن البصري عن هشيم بن بشير عن سعيد بن منصور","باب من قال لامرأته اعتدي"
"2414","1237  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  أَبِي بَكْرِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  مَكْحُولٍ ، قَالَ : «  إِذَا قَالَ لِامْرَأَتِهِ : اعْتَدِّي أَوْ عُدِّي أَجَلَكِ ، فَإِنَّهَا تَطْلِيقَةٌ  وَهُوَ أَمْلَكُ بِهَا  » .","","Sunan Sa'id ibn Mansur 1237","","مكحول بن أبي مسلم عن أبو بكر الغساني عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب من قال لامرأته اعتدي"
"2415","1238  -  حَدَّثَنَا  سَعِيدٌ ،  قَالَ  فُضَيْلٌ :  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ «  إِذَا قَالَ الرَّجُلُ : اعْتَدِّي ، فَهُوَ تَطْلِيقَةٌ  » .","","Sunan Sa'id ibn Mansur 1238","","إبراهيم النخعي عن منصور بن المعتمر عن الفضيل بن عياض عن سعيد بن منصور","باب من قال لامرأته اعتدي"
"2416","1239  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ  فِي رَجُلٍ قَالَ لِامْرَأَتِهِ : اعْتَدِّي ، قَالَ : « هِيَ تَطْلِيقَةٌ  ، وَهُوَ أَحَقُّ بِهَا  » .","","Sunan Sa'id ibn Mansur 1239","","الحسن البصري عن يونس بن عبيد عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب من قال لامرأته اعتدي"
"2417","[6/336]      بَابُ مَنْ قَالَ لِامْرَأَتِهِ : أَنْتِ طَالِقٌ إِذَا شِئْتِ .  1240  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ  فِي رَجُلٍ قَالَ لِامْرَأَتِهِ : « أَنْتِ كُلَّمَا شِئْتِ طَالِقٌ فَهِيَ كُلَّمَا شَاءَتْ طَالِقٌ  » .","","Sunan Sa'id ibn Mansur 1240","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب من قال لامرأته : أنت طالق إذا شئت"
"2418","1241  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ  فِي رَجُلٍ زَوَّجَ أَمَتَهُ رَجُلًا ، وَأَصْدَقَهَا صَدَاقًا ، ثُمَّ أَعْتَقَهَا  قَبَلَ أَنْ يَدْخُلَ بِهَا زَوْجُهَا فَخُيِّرَتْ ، فَاخْتَارَتْ نَفْسَهَا ، قَالَ : « يُفَرَّقُ بَيْنَهُمَا ، وَيُرَدُّ إِلَى الزَّوْجِ مَهْرُهُ  » .","","Sunan Sa'id ibn Mansur 1241","","إبراهيم النخعي عن حماد بن أبي سليمان عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب من قال لامرأته : أنت طالق إذا شئت"
"2419","1242  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ  فِي رَجُلٍ زَوَّجَ أَمَتَهُ عَلَى مَهْرٍ مُسَمًّى  ، فَأَعْتَقَهَا سَيِّدُهَا قَبْلَ أَنْ يَدْخُلَ بِهَا ، قَالَ : « إِنِ اخْتَارَتْ نَفْسَهَا بَطَلَ الصَّدَاقُ » ، وَإِنِ اخْتَارَتْ زَوْجَهَا قَبْلَ أَنْ يَدْخُلَ بِهَا  قَالَ  الْمُغِيرَةُ :  قَالَ  ابْنُ شُبْرُمَةَ :  الصَّدَاقُ لِلْمَوْلَى  .","","Sunan Sa'id ibn Mansur 1242","","إبراهيم النخعي عن حماد بن أبي سليمان عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب من قال لامرأته : أنت طالق إذا شئت"
"2420","1243  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  إِنِ اخْتَارَتْ نَفْسَهَا وَقَدْ دَخَلَ بِهَا زَوْجُهَا ، فَالصَّدَاقُ لِلْمَوْلَى  » .","","Sunan Sa'id ibn Mansur 1243","","إبراهيم النخعي عن حماد بن أبي سليمان عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب من قال لامرأته : أنت طالق إذا شئت"
"2421","1244  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُبَيْدٍ الْكَلَاعِيِّ ،  عَنْ  مَكْحُولٍ  فِي مَمْلُوكٍ نَكَحَ الْوَلِيدَةَ فَأُعْتِقَتْ قَبْلَ أَنْ يَدْخُلَ بِهَا  وَقَدْ أَعْطَاهَا صَدَاقَهَا ، فَخُيِّرَتْ فَاخْتَارَتْ نَفْسَهَا ، قَالَ : « يُرَدُّ إِلَيْهِ مَا أَعْطَاهَا  » .","","Sunan Sa'id ibn Mansur 1244","","مكحول بن أبي مسلم عن عبيد الله بن عبيد الكلاعي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب من قال لامرأته : أنت طالق إذا شئت"
"2422","1245  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ         [6/337]      عُبَيْدٍ الْكَلَاعِيِّ  فِي رَجُلٍ مَمْلُوكٍ نَكَحَ أَمَةً ثُمَّ أُعْتِقَتْ قَبْلَهُ  ، أَتُخَيَّرُ الْأَمَةُ أَنْ تَقَرَّ عِنْدَهُ أَوْ تُكْرَهَ عَلَيْهِ ؟ قَالَ : « بَلْ تُخَيَّرُ » ، قُلْتُ : فَكَيْفَ إِنْ كَانَتْ وَلَدَتْ مِنْ سَيِّدِهَا غُلَامًا فَصَارَ زَوْجُهَا لِابْنِهَا أَيُحَرِّمُهَا ذَلِكَ عَلَيْهِ أَمْ لَا ؟ قَالَ : « أَرَى أَنْ تُحَرَّمَ عَلَيْهِ لِذَلِكَ » ، قُلْتُ : وَكَيْفَ إِنْ كَانَتْ عِنْدَهُ حِينًا قَلِيلًا أَوْ كَثِيرًا ، ثُمَّ أَرَادَ أَنْ يَنْتَزِعَ مِنْهُ أَلَهَا ذَلِكَ أَمْ لَا ؟ وَقَالَتْ : إِنِّي لَمْ أَعْلَمْ أَنَّ لِي مِنْ أَمْرِي شَيْئًا ، قَالَ : « إِذَا اسْتَقَرَّتْ حَتَّى يَأْتِيَهَا فَهِيَ امْرَأَتُهُ » ، قُلْتُ : فَكَيْفَ إِنْ كَانَ صَارَ الْعَبْدُ لَهَا مِنْ مِيرَاثِهَا مِنْ بَعْدِ وَلَدِهَا ؟ قَالَ : « لَا تَحِلُّ لَهُ  ، وَكَانَ عَلِيُّ بْنُ أَبِي طَالِبٍ رَضِيَ اللهُ عَنْهُ  يَقُولُ  : يُؤْمَرُ بِطَلَاقِهَا  » .","","Sunan Sa'id ibn Mansur 1245","","عبيد الله بن عبيد الكلاعي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب من قال لامرأته : أنت طالق إذا شئت"
"2423","1246  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ «  أَنَّهُ كَانَ يَقُولُ  فِي الْأَمَةِ تُعْتَقُ تُخَيَّرُ مِنَ الْعَبْدِ وَلَا تُخَيَّرُ مِنَ الْحُرِّ  ، فَإِنْ غَشِيَهَا الْعَبْدُ لَمْ يَكُنْ لَهَا خِيَارٌ  » .","","Sunan Sa'id ibn Mansur 1246","","أبو قلابة الجرمي عن أيوب السختياني عن حماد بن زيد عن سعيد بن منصور","باب من قال لامرأته : أنت طالق إذا شئت"
"2424","1247  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  خَالِدٌ ،  عَنْ  أَبِي قِلَابَةَ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ كَانَ يَقُولُ : «  فِي الْأَمَةِ إِذَا أُعْتِقَتْ وَلَهَا زَوْجٌ فَغَشِيَهَا قَبْلَ أَنْ تَخْتَارَ فَلَا خِيَارَ لَهَا  » .         [6/338]","","Sunan Sa'id ibn Mansur 1247","","عمر بن الخطاب عن أبو قلابة الجرمي عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب من قال لامرأته : أنت طالق إذا شئت"
"2425","1248  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا لَمْ تَعْلَمْ أَنَّ لَهَا الْخِيَارَ ، فَلَهَا الْخِيَارُ  ، وَإِنْ كَانَ قَدْ غَشِيَهَا زَوْجُهَا  » .","","Sunan Sa'id ibn Mansur 1248","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب من قال لامرأته : أنت طالق إذا شئت"
"2426","1249  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَشْعَثُ ،  عَنِ  الشَّعْبِيِّ ، أَنَّهُ كَانَ يَقُولُ : «  لَهَا الْخِيَارُ إِذَا عَلِمَتْ  » .","","Sunan Sa'id ibn Mansur 1249","","الشعبي عن أشعث بن سوار عن هشيم بن بشير عن سعيد بن منصور","باب من قال لامرأته : أنت طالق إذا شئت"
"2427","بَابُ مَا جَاءَ فِي خِيَارِ الْأَمَةِ .  1250  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَمَةٍ لِبَنِي عَدِيِّ بْنِ كَعْبٍ أُعْتِقَتْ وَلَهَا زَوْجٌ ،  فَقَالَتْ  لَهَا حَفْصَةُ : «  إِنِّي مُخْبِرَتُكِ وَمَا أُحِبُّ أَنْ تَفْعَلِيهِ ، لَكِ الْخِيَارُ مَا لَمْ يَمَسَّكِ زَوْجُكِ  ، فَإِذَا مَسَّكِ فَلَا خِيَارَ لَكِ » ، قَالَتْ : فَاشْهَدِي أَنِّي قَدْ فَارَقْتُهُ ، ثُمَّ فَارَقَتْهُ  .","","Sunan Sa'id ibn Mansur 1250","","حفصة بنت عمر بن الخطاب عن أمة لبني عدي بن كعب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في خيار الأمة"
"2428","1251  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ، وَيُونُسُ ،  عَنِ  الْحَسَنِ «  أَنَّهُ  كَانَ يَقُولُ فِي الْأَمَةِ إِذَا أُعْتِقَتْ وَلَهَا زَوْجٌ  حُرٌّ  فَلَا خِيَارَ لَهَا  ، وَإِنْ كَانَ عَبْدًا فَلَهَا الْخِيَارُ  » .","","Sunan Sa'id ibn Mansur 1251","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في خيار الأمة"
"2429","1252  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ، قَالَ :  نَا  ابْنُ طَاوُسٍ ،  عَنْ  أَبِيهِ  ، قَالَ : «  لِلْأَمَةِ الْخِيَارُ إِذَا أُعْتِقَتْ  ، وَإِنْ كَانَ تَحْتَ رَجُلٍ مِنْ قُرَيْشٍ  » .         [6/339]","","Sunan Sa'id ibn Mansur 1252","","طاوس بن كيسان عن عبد الله بن طاووس عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في خيار الأمة"
"2430","1253  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ كَانَ يَقُولُ : «  لَهَا الْخِيَارُ عَبْدًا كَانَ زَوْجُهَا أَوْ حُرًّا  » . قَالَ  هُشَيْمٌ  : وَهُوَ الْقَوْلُ  .","","Sunan Sa'id ibn Mansur 1253","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في خيار الأمة"
"2431","1254  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَبْدُ اللهِ بْنُ شُبْرُمَةَ الْهَمْدَانِيُّ ، قَالَ :  سَمِعْتُ  الشَّعْبِيَّ ، يَقُولُ : «  لَهَا الْخِيَارُ حُرًّا كَانَ زَوْجُهَا أَوْ عَبْدًا  » .","","Sunan Sa'id ibn Mansur 1254","","الشعبي عن عبد الله بن شبرمة عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في خيار الأمة"
"2432","1255  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  ابْنُ أَبِي لَيْلَى ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ «  أَنَّهُ كَانَ لَا يَجْعَلُ لَهَا الْخِيَارَ عَلَى الْحُرِّ  » .","","Sunan Sa'id ibn Mansur 1255","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في خيار الأمة"
"2433","1256  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  ابْنُ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ، وَنَافِعٍ ، أَنَّهُمَا قَالَا : «  كَانَ زَوْجُ  بَرِيرَةَ  عَبْدًا يُقَالُ لَهُ :  مُغِيثٌ  » .","","Sunan Sa'id ibn Mansur 1256","","نافع مولى ابن عمر عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في خيار الأمة"
"2434","1257  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  خَالِدٌ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَمَّا  خُيِّرَتْ  بَرِيرَةُ  رَأَيْتُ زَوْجَهَا يَتْبَعُهَا فِي سِكَكِ  الْمَدِينَةِ  وَدُمُوعُهُ تَسِيلُ عَلَى لِحْيَتِهِ ، فَكَلَّمَ لَهُ  الْعَبَّاسُ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَطْلُبَ إِلَيْهَا ، فَقَالَ لَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  زَوْجُكِ وَأَبُو وَلَدِكِ » ، قَالَتْ : أَتَأْمُرُنِي بِهِ يَا رَسُولَ اللهِ ؟ قَالَ : « إِنَّمَا أَنَا شَافِعٌ  » ، قَالَتْ : فَإِنْ كُنْتَ شَافِعًا فَلَا حَاجَةَ لِي فِيهِ ، قَالَ : فَاخْتَارَتْ نَفْسَهَا ، وَكَانَ يُقَالُ لَهُ :  مُغِيثٌ  ، وَكَانَ عَبْدًا         [6/340]      لِآلِ بَلْمُغِيرَةِ  مِنْ  بَنِي مَخْزُومٍ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِلْعَبَّاسِ  : « أَلَا تَعْجَبُ مِنْ شِدَّةِ بُغْضِ  بَرِيرَةَ  لِزَوْجِهَا ، وَمِنْ شِدَّةِ حُبِّ زَوْجِهَا لَهَا ؟  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : أي بني المغيرة ، والصواب لآل المغيرة ، وليحرر قوله كان عبدا لآل المغيرة ، ففي الإصابة أنه كان مولى لأبي أحمد بن جحش الأسدي.","","Sunan Sa'id ibn Mansur 1257","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في خيار الأمة"
"2435","1258  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، قَالَ :  أَنَا  أَيُّوبُ ،  عَنْ  عِكْرِمَةَ ،  أَنَّ  ابْنَ عَبَّاسٍ  قَالَ فِي زَوْجِ  بَرِيرَةَ  : يُقَالُ لَهُ :  مُغِيثٌ عَبْدُ بَنِي فُلَانٍ  : « كَأَنِّي أَرَاهُ الْآنَ يَتْبَعُهَا فِي سِكَكِ  الْمَدِينَةِ  يَبْكِي  » .","","Sunan Sa'id ibn Mansur 1258","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن أيوب السختياني عن إسماعيل ابن علية عن سعيد بن منصور","باب ما جاء في خيار الأمة"
"2436","1259  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ بْنِ يَزِيدَ ،  عَنْ  عَائِشَةَ ، قَالَتْ : «  كَانَ زَوْجُ  بَرِيرَةَ  حُرًّا  » .","","Sunan Sa'id ibn Mansur 1259","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في خيار الأمة"
"2437","1260  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ زَوْجُ  بَرِيرَةَ  حُرًّا ، قَالَتْ : فَلَمَّا أُعْتِقَتْ خَيَّرَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَاخْتَارَتْ نَفْسَهَا ، وَأَرَادَ أَهْلُهَا أَنْ يَبِيعُوهَا وَيَشْتَرِطُوا الْوَلَاءَ ، فَذُكِرَ ذَلِكَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : «  اشْتَرِيهَا ثُمَّ أَعْتِقِيهَا ، فَإِنَّمَا الْوَلَاءُ لِمَنْ أَعْتَقَ  » .         [6/341]","","Sunan Sa'id ibn Mansur 1260","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في خيار الأمة"
"2438","1261  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ ، قَالَ :  لَا أَدْرِي مِنْ حَدِيثِ إِبْرَاهِيمَ  سَمِعْتُهُ  أَوْ غَيْرِهِ  ،  عَنْ  عَائِشَةَ أَنَّهَا قَالَتْ :  يَا رَسُولَ اللهِ ، إِنَّ النَّاسَ يَتَصَدَّقُونَ عَلَى  بَرِيرَةَ  فَتُهْدِي إِلَيْنَا ، فَنَأْكُلُ ؟ قَالَ : «  نَعَمْ إِنَّهُ عَلَيْهَا صَدَقَةٌ ، وَهُوَ لَكُمْ هَدِيَّةٌ  » .","","Sunan Sa'id ibn Mansur 1261","","عائشة بنت أبي بكر الصديق عن غيره عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في خيار الأمة"
"2439","1262  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حُصَيْنٌ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  كَانَ فِي  بَرِيرَةَ  ثَلَاثُ قَضِيَّاتٍ : جَعَلَ لَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْخِيَارَ عَلَى زَوْجِهَا ، وَكَانَ مَوَالِيهَا بَاعُوهَا مِنْ  عَائِشَةَ  وَاشْتَرَطُوا أَنَّ الْوَلَاءَ لَهُمْ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  الْوَلَاءُ لِمَنْ أَعْتَقَ  » ، وَتُصُدِّقَ عَلَيْهَا بِلَحْمٍ فَأَهْدَتْهُ إِلَى  عَائِشَةَ  ، فَدَخَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَرَادَ أَنْ يَأْكُلَ مِنْهُ ، فَقَالَتْ : إِنَّهُ تُصُدِّقَ عَلَى  بَرِيرَةَ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : « هُوَ عَلَى  بَرِيرَةَ  صَدَقَةٌ ، وَهُوَ لَنَا هَدِيَّةٌ  » .","","Sunan Sa'id ibn Mansur 1262","","الشعبي عن حصين بن عبد الرحمن السلمي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في خيار الأمة"
"2440","1263  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، رَضِيَ اللهُ عَنْهَا قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  الْوَلَاءُ لِمَنْ أَعْتَقَ  » .","","Sunan Sa'id ibn Mansur 1263","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن عمر بن أبي سلمة الزهري عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في خيار الأمة"
"2441","1264  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ  فِي الْأَمَةِ تَحْتَ الْحُرِّ أَوِ الْعَبْدِ فَتُعْتَقُ ، فَقَالَ : «  لَهَا الْخِيَارُ إِذَا أُعْتِقَتْ  » .","","Sunan Sa'id ibn Mansur 1264","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في خيار الأمة"
"2442","1265  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَلْقَمَةَ الْفَرْوِيُّ ، قَالَ :  نَا  نَافِعٌ ، قَالَ :         [6/342]      قَالَ  عَبْدُ اللهِ بْنُ عُمَرَ : «  أَيُّمَا أَمَةٍ كَانَتْ تَحْتَ عَبْدٍ فَأُعْتِقَتْ فَإِنَّ لَهَا الْخِيَارَ مَا لَمْ يَمَسَّهَا  » .","","Sunan Sa'id ibn Mansur 1265","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن محمد بن عبد الله الفروي عن سعيد بن منصور","باب ما جاء في خيار الأمة"
"2443","بَابُ الْجَارِيَةِ تُطَلَّقُ وَلَمْ تَبْلُغِ الْمَحِيضَ .  1266  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، وَمُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، وَمُحَمَّدُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ  أَنَّهُمْ قَالُوا فِي الْجَارِيَةِ إِذَا طُلِّقَتْ وَلَمْ تَبْلُغِ الْمَحِيضَ : « إِنَّهَا تَعْتَدُّ بِالشُّهُورِ  ، فَإِنْ حَاضَتْ قَبْلَ أَنْ تَمْضِيَ الشُّهُورُ الثَّلَاثَةُ بِيَوْمٍ أَوْ يَوْمَيْنِ اسْتَأْنَفَتِ الْعِدَّةَ بِالْحَيْضِ ، فَإِنْ حَاضَتْ بَعْدَمَا تَمْضِي الشُّهُورُ بِيَوْمٍ أَوْ يَوْمَيْنِ فَقَدِ انْقَضَتْ عِدَّتُهَا  » .","","Sunan Sa'id ibn Mansur 1266","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الجارية تطلق ولم تبلغ المحيض"
"2444","بَابُ الْأَمَةِ تُطَلَّقُ فَتُعْتَقُ فِي الْعِدَّةِ .  1267  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  وَأَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ، وَعُبَيْدَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالُوا : «  إِذَا طَلَّقَ الرَّجُلُ امْرَأَتَهُ وَهِيَ أَمَةٌ تَطْلِيقَةً وَاحِدَةً فَأُعْتِقَتْ فِي الْعِدَّةِ  ، فَعِدَّتُهَا  عِدَّةُ  الْحُرَّةِ وَلَهُ عَلَيْهَا رَجْعَةٌ ، وَإِنْ طَلَّقَهَا تَطْلِيقَتَيْنِ فَأُعْتِقَتْ فِي الْعِدَّةِ ، فَعِدَّتُهَا  عِدَّةُ  الْأَمَةِ وَلَا رَجْعَةَ لَهُ عَلَيْهَا  » .","","Sunan Sa'id ibn Mansur 1267","","إبراهيم النخعي عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الأمة تطلق فتعتق في العدة"
"2445","1268  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ،  عَنْ  رَجُلٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ : «  تَعْتَدُّ  عِدَّةَ  الْحُرَّةِ وَلَهُ عَلَيْهَا الرَّجْعَةُ  ، فَإِذَا انْقَضَتِ الْعِدَّةُ فَشَاءَ أَنْ يَخْطُبَهَا خَطَبَهَا  » .         [6/343]","","Sunan Sa'id ibn Mansur 1268","","سعيد بن المسيب عن رجل عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب الأمة تطلق فتعتق في العدة"
"2446","1269  -  حَدَّثَنَا سَعِيدٌ قَالَ :  نَا  عَتَّابُ بْنُ بَشِيرٍ ، قَالَ :  أَنَا  خُصَيْفٌ ،  عَنْ  مُجَاهِدٍ  فِي الْأَمَةِ تُطَلَّقُ ثُمَّ تُعْتَقُ وَهِيَ فِي الْعِدَّةِ ، قَالَ : « تَسْتَأْنِفُ  عِدَّةَ  الْحُرَّةِ  إِذَا كَانَتْ مِنْ تَطْلِيقَةٍ ، وَإِنْ كَانَتْ مِنْ تَطْلِيقَتَيْنِ فَقَدْ  بَانَتْ  تَعْتَدُّ ثَلَاثَةَ قُرُوءٍ  » .","","Sunan Sa'id ibn Mansur 1269","","مجاهد بن جبر المخزومي عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب الأمة تطلق فتعتق في العدة"
"2447","1270  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَمْرِو بْنِ أَوْسٍ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ قَالَ : «  لَوِ اسْتَطَعْتُ أَنْ أَجْعَلَ  عِدَّةَ  الْأَمَةِ حَيْضَةً وَنِصْفًا لَفَعَلْتُ  » .","","Sunan Sa'id ibn Mansur 1270","","عمر بن الخطاب عن عمرو بن أوس بن أبي أوس الثقفي عن عمرو بن دينار الأثرم عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب الأمة تطلق فتعتق في العدة"
"2448","1271  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَمْرِو بْنِ أَوْسٍ ،  أَنَّ  عُمَرَ ، رَضِيَ اللهُ عَنْهُ قَالَ : «  لَوِ اسْتَطَعْتُ أَنْ أَجْعَلَ  عِدَّةَ  الْأَمَةِ حَيْضَةً وَنِصْفًا لَفَعَلْتُ  ، فَقَالَ رَجُلٌ : يَا أَمِيرَ الْمُؤْمِنِينَ فَاجْعَلْهَا شَهْرًا وَنِصْفًا ، قَالَ : فَسَكَتَ  » .","","Sunan Sa'id ibn Mansur 1271","","عمر بن الخطاب عن عمرو بن أوس بن أبي أوس الثقفي عن عمرو بن دينار الأثرم عن حماد بن زيد عن سعيد بن منصور","باب الأمة تطلق فتعتق في العدة"
"2449","1272  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ، قَالَ :  نَا  عَمْرُو بْنُ دِينَارٍ ، قَالَ  سَمِعْتُ  عَمْرَو بْنَ أَوْسٍ ،  يَذْكُرُ عَنْ  رَجُلٍ مِنْ ثَقِيفَ قَالَ :  سَمِعْتُ  عُمَرَ بْنَ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ عَلَى الْمِنْبَرِ يَقُولُ : «  لَوِ اسْتَطَعْتُ أَنْ أَجْعَلَ  عِدَّةَ  الْأَمَةِ حَيْضَةً وَنِصْفًا لَفَعَلْتُ  ، فَقَالَ رَجُلٌ : فَاجْعَلْهَا شَهْرًا وَنِصْفًا ، قَالَ : فَسَكَتَ  » .","","Sunan Sa'id ibn Mansur 1272","","عمر بن الخطاب عن رجل من ثقيف عن عمرو بن أوس بن أبي أوس الثقفي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب الأمة تطلق فتعتق في العدة"
"2450","1273  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  أَنَّ  عَطَاءً كَانَ يَقُولُ : «  عِدَّةُ  الْأَمَةِ إِذَا كَانَتْ لَا تَحِيضُ شَهْرَانِ  » .         [6/344]","","Sunan Sa'id ibn Mansur 1273","","عطاء بن أبي رباح عن عمرو بن دينار الأثرم عن حماد بن زيد عن سعيد بن منصور","باب الأمة تطلق فتعتق في العدة"
"2451","1274  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  ابْنِ مَسْعُودٍ  أَنَّهُ كَانَ يَقُولُ فِي  عِدَّةِ  الْأَمَةِ : «  أَيَكُونُ عَلَيْهَا نِصْفُ الْعَذَابِ وَلَا يَكُونُ لَهَا نِصْفُ الرُّخْصَةِ  » .","","Sunan Sa'id ibn Mansur 1274","","عبد الله بن مسعود عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الأمة تطلق فتعتق في العدة"
"2452","1275  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حِبَّانُ بْنُ عَلِيٍّ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  طَلَاقُ الْأَمَةِ تَطْلِيقَتَانِ  ، وَعِدَّتُهَا قُرْءَانِ ، وَإِنْ كَانَتْ لَا تَحِيضُ فَشَهْرٌ وَنِصْفٌ  » .","","Sunan Sa'id ibn Mansur 1275","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن حبان بن علي العنزي عن سعيد بن منصور","باب الأمة تطلق فتعتق في العدة"
"2453","1276  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  طَلَاقُ الْأَمَةِ تَطْلِيقَتَانِ  ، وَعِدَّتُهَا حَيْضَتَانِ » قَالَ : « وَإِذَا اسْتُبْرِئَتِ الْأَمَةُ اسْتُبْرِئَتْ  بِحَيْضَةٍ  »  .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : كذا في ص بحذف الهمزة ، وحق الرسم ""استبرأت""","","Sunan Sa'id ibn Mansur 1276","","إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب الأمة تطلق فتعتق في العدة"
"2454","1277  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ الرَّحْمَنِ ، مَوْلَى آلِ طَلْحَةَ قَالَ :  نَا  سُلَيْمَانُ بْنُ يَسَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُتْبَةَ ، قَالَ :  قَالَ  عُمَرُ : «  يَنْكِحُ الْعَبْدُ اثْنَتَيْنِ وَيُطَلِّقُ تَطْلِيقَتَيْنِ  ، وَيَعْتَدُّ حَيْضَتَيْنِ ،  فَإِنْ لَمْ تَحِضْ فَشَهْرًا وَنِصْفًا أَوْ قَالَ : شَهْرَيْنِ  ، شَكَّ  سُفْيَانُ  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : في عق : وتعتد الأمة حيضتين","","Sunan Sa'id ibn Mansur 1277","","عمر بن الخطاب عن عبد الله بن عتبة بن مسعود عن سليمان بن يسار مولى ميمونة زوج رسول الله عن محمد بن عبد الرحمن بن عبيد الطلحي عن سفيان بن عيينة عن سعيد بن منصور","باب الأمة تطلق فتعتق في العدة"
"2455","1278  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حِبَّانُ بْنُ عَلِيٍّ ، قَالَ :  أَنَا  ابْنُ أَبِي لَيْلَى ،         [6/345]      عَنْ  عَبْدِ الْكَرِيمِ ،  عَنِ  ابْنِ سِيرِينَ ، قَالَ :  قَالَ  عُمَرُ : «  طَلَاقُ الْأَمَةِ تَطْلِيقَتَانِ وَإِيلَاؤُهَا شَهْرَانِ  » .","","Sunan Sa'id ibn Mansur 1278","","عمر بن الخطاب عن محمد بن سيرين عن عبد الكريم بن أبي المخارق عن محمد بن عبد الرحمن بن أبي ليلى عن حبان بن علي العنزي عن سعيد بن منصور","باب الأمة تطلق فتعتق في العدة"
"2456","1279  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، وَيُونُسُ ،  عَنِ  الْحَسَنِ ، وَمُحَمَّدُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّهُمْ قَالُوا فِي  عِدَّةِ  الْأَمَةِ إِذَا طُلِّقَتْ : « إِنْ كَانَتْ تَحِيضُ فَحَيْضَتَانِ  ، وَإِنْ كَانَتْ لَا تَحِيضُ فَشَهْرٌ وَنِصْفٌ ، وَإِنْ تُوُفِّيَ عَنْهَا فَشَهْرَانِ وَخَمْسَةُ أَيَّامٍ  ، قَالَ  هُشَيْمٌ  : وَهُوَ الْقَوْلُ  » .","","Sunan Sa'id ibn Mansur 1279","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الأمة تطلق فتعتق في العدة"
"2457","1280  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَتَّابٌ ، قَالَ :  نَا  خُصَيْفٌ ،  عَنْ  مُجَاهِدٍ ، قَالَ : «  كُلُّ امْرَأَةٍ تَعْتَدُّ  بِالْأَقْرَاءِ  ثُمَّ تَرْتَفِعُ حَيْضَتُهَا فَإِنَّهَا تَسْتَأْنِفُ الشُّهُورَ  ، وَإِنْ كَانَتْ تَعْتَدُّ بِالشُّهُورِ ثُمَّ حَاضَتْ فَإِنَّهَا تَسْتَأْنِفُ الْحَيْضَ  » .","","Sunan Sa'id ibn Mansur 1280","","مجاهد بن جبر المخزومي عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب الأمة تطلق فتعتق في العدة"
"2458","1281  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو الْأَحْوَصِ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  فِي الرَّجُلِ يَتَزَوَّجُ الْجَارِيَةَ قَبْلَ أَنْ تَبْلُغَ الْمَحِيضَ ثُمَّ يُطَلِّقُهَا  ، قَالَ : « تَعْتَدُّ ثَلَاثَةَ أَشْهُرٍ فَإِنْ حَاضَتْ قَبْلَ أَنْ تَنْقَضِيَ الشُّهُورُ اسْتَأْنَفَتِ الْحَيْضَ  » .","","Sunan Sa'id ibn Mansur 1281","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن سلام بن سليم الحنفي عن سعيد بن منصور","باب الأمة تطلق فتعتق في العدة"
"2459","بَابُ مَا جَاءَ فِي  عِدَّةِ  أُمِّ الْوَلَدِ .  1282  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  أَنَّهُ قَالَ فِي  عِدَّةِ  أُمِّ الْوَلَدِ إِذَا مَاتَ عَنْهَا سَيِّدُهَا أَوْ أَعْتَقَهَا ، قَالَ : «  عِدَّةُ  الْحُرَّةِ  » .","","Sunan Sa'id ibn Mansur 1282","","سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2460","1283  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  نَا  أَبُو شِهَابٍ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَامِرٍ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَلِيٍّ - رَضِيَ اللهُ عَنْهُ - قَالَ : «  إِذَا أُعْتِقَتْ أُمُّ الْوَلَدِ فَعِدَّتُهَا ثَلَاثُ حِيَضٍ  ، قَالَ حَجَّاجٌ :  فَإِنْ مَاتَ عَنْهَا فَمِثْلُ ذَلِكَ  » .         [6/346]","","Sunan Sa'id ibn Mansur 1283","","علي بن أبي طالب عن الحارث الأعور عن الشعبي عن حجاج بن أرطاة عن عبد ربه بن نافع الحناط عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2461","1284  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  حَجَّاجٌ ،  عَنِ  الْحَكَمِ ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ قَالَ : «  عِدَّةُ  أُمِّ الْوَلَدِ ثَلَاثُ حِيَضٍ  » .","","Sunan Sa'id ibn Mansur 1284","","علي بن أبي طالب عن الحكم بن عتيبة الكندي عن حجاج بن أرطاة عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2462","1285  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  يَزِيدُ بْنُ هَارُونَ ،  عَنِ  الْحَجَّاجِ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَلِيٍّ ، وَعَبْدِ اللهِ ،  قَالَا فِي أُمِّ الْوَلَدِ : «  إِذَا مَاتَ عَنْهَا سَيِّدُهَا ، قَالَ : تَعْتَدُّ ثَلَاثَةَ قُرُوءٍ  » .","","Sunan Sa'id ibn Mansur 1285","","عبد الله بن مسعود عن الشعبي عن حجاج بن أرطاة عن يزيد بن هارون عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2463","1286  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  عِدَّةُ  أُمِّ الْوَلَدِ ثَلَاثُ حِيَضٍ  » .","","Sunan Sa'id ibn Mansur 1286","","إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2464","1287  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عُبَيْدَةُ ،  عَنْ  إِبْرَاهِيمَ ، وَمِنْ  سَمِعَ  الْحَكَمَ ،  يُحَدِّثُ عَنْ  إِبْرَاهِيمَ ، قَالَ : «  تَعْتَدُّ ثَلَاثَ حِيَضٍ أَوْ ثَلَاثَةَ أَشْهُرٍ  » .","","Sunan Sa'id ibn Mansur 1287","","إبراهيم النخعي عن الحكم بن عتيبة الكندي عن ومن عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2465","1288  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  أَنَا  الْحَجَّاجُ ،  عَنْ  نَافِعٍ ،  أَنَّ  ابْنَ عُمَرَ ، قَالَ : «  عِدَّةُ  أُمِّ الْوَلَدِ حَيْضَةٌ  » .","","Sunan Sa'id ibn Mansur 1288","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن حجاج بن أرطاة عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2466","1289  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  دَاوُدُ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : «  تَعْتَدُّ بِحَيْضَةٍ وَاحِدَةٍ  » .","","Sunan Sa'id ibn Mansur 1289","","عبد الله بن عمر بن الخطاب عن الشعبي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2467","1290  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  خَالِدٌ ،  عَنْ  أَبِي قِلَابَةَ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1290","","أبو قلابة الجرمي عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2468","1291  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حُمَيْدٌ الطَّوِيلُ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، أَنَّهُ قَالَ : «  أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا  » .         [6/347]","","Sunan Sa'id ibn Mansur 1291","","سعيد بن جبير الأسدي عن حميد الطويل عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2469","1292  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ  ثَنَا  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  فِي  عِدَّةِ  أُمِّ الْوَلَدِ إِذَا مَاتَ عَنْهَا سَيِّدُهَا ، قَالَ : « أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا  » .","","Sunan Sa'id ibn Mansur 1292","","سعيد بن المسيب عن داود بن أبي هند عن حماد بن زيد عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2470","1293  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنْ  حُمَيْدٍ الطَّوِيلِ ، أَنَّهُمَا  سَمِعَا  الْحَسَنَ ، يَقُولُ : «  أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا  » .","","Sunan Sa'id ibn Mansur 1293","","الحسن البصري عن حميد الطويل عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2471","1294  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ، وَأَبُو حُرَّةَ  عَنِ  الْحَسَنِ ، أَنَّهُ قَالَ فِي آخِرِ أَمْرِهِ : «  تَعْتَدُّ بِحَيْضَةٍ وَاحِدَةٍ ، فَإِنْ أَعْتَقَهَا سَيِّدُهَا فَثَلَاثَةُ أَشْهُرٍ  » .","","Sunan Sa'id ibn Mansur 1294","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2472","1295  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَبْدُ الْمَلِكِ ،  عَنْ  عَطَاءٍ ،  أَنَّهُ سُئِلَ عَنْ ذَلِكَ ، فَقَالَ : «  مِنْهُمْ مَنْ يَقُولُ : ثَلَاثَةُ أَشْهُرٍ ، وَمِنْهُمْ مَنْ يَقُولُ : أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا  » .","","Sunan Sa'id ibn Mansur 1295","","عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2473","1296  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  سَيَّارٌ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  قِيلَ لَهُ  أَتَعْتَدُّ أُمُّ الْوَلَدِ إِذَا تُوُفِّيَ عَنْهَا سَيِّدُهَا أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا ؟  قَالَ : أَفَلَا تُوَرِّثُونَهَا إِذًا  » .","","Sunan Sa'id ibn Mansur 1296","","الشعبي عن سيار بن أبي سيار العنزي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2474","1297  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَبْدِ الْكَرِيمِ بْنِ أَبِي أُمَيَّةَ  ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  لَا يُسْتَبْرَأُ فَرْجُ الْحُرَّةِ مَا قَلَّ مِنْ ثَلَاثِ حِيَضٍ  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، والصواب عبد الكريم أبي أمية .","","Sunan Sa'id ibn Mansur 1297","","إبراهيم النخعي عن عبد الكريم بن أبي المخارق عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2475","1298  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  يَزِيدُ بْنُ هَارُونَ ،  عَنِ  الْحَجَّاجِ ،  عَنِ  الْحَكَمِ ،  أَنَّ  عَلِيًّا ، رَضِيَ اللهُ عَنْهُ  قَالَ فِي الْأَمَةِ إِذَا أُعْتِقَتْ: « تَعْتَدُّ ثَلَاثَ حِيَضٍ  » .         [6/348]","","Sunan Sa'id ibn Mansur 1298","","علي بن أبي طالب عن الحكم بن عتيبة الكندي عن حجاج بن أرطاة عن يزيد بن هارون عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2476","1299  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَتَّابُ بْنُ بَشِيرٍ ، قَالَ :  نَا  خُصَيْفٌ ،  عَنْ  عَطَاءٍ ، قَالَ : «  إِذَا أَعْتَقَ الرَّجُلُ أُمَّ وَلَدِهِ أَوْ جَارِيَةً كَانَ يَطَأُهَا فَعِدَّتُهَا ثَلَاثُ حِيَضٍ  » .","","Sunan Sa'id ibn Mansur 1299","","عطاء بن أبي رباح عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب ما جاء في عدة أم الولد"
"2477","بَابُ الْمَرْأَةِ تُطَلَّقُ تَطْلِيقَةً أَوْ تَطْلِيقَتَيْنِ فَتَرْتَفِعُ حَيْضَتُهَا فَتَمُوتُ يَرِثُهَا زَوْجُهَا .  1300  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  عَلْقَمَةَ  ، طَلَّقَ امْرَأَتَهُ فَمَكَثَتْ سِتَّةَ عَشَرَ شَهْرًا  ، أَوْ سَبْعَةَ عَشَرَ شَهْرًا ، أَوْ ثَمَانِيَةَ عَشَرَ شَهْرًا ، فَمَاتَتْ وَلَمْ تُكْمِلِ الْعِدَّةَ ، فَسَأَلَ  عَلْقَمَةُ  عَبْدَ اللهِ  قَالَ  : « رَدَّ اللهُ عَلَيْكَ مِيرَاثَهَا  » .","","Sunan Sa'id ibn Mansur 1300","","عبد الله بن مسعود عن إبراهيم النخعي عن منصور بن المعتمر عن سفيان الثوري عن سعيد بن منصور","باب المرأة تطلق تطليقة أو تطليقتين فترتفع حيضتها فتموت يرثها زوجها"
"2478","1301  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  عَلْقَمَةَ  طَلَّقَ امْرَأَتَهُ تَطْلِيقَةً أَوْ تَطْلِيقَتَيْنِ ، فَحَاضَتْ حَيْضَةً أَوْ حَيْضَتَيْنِ ثُمَّ ارْتَفَعَ حَيْضَتُهَا  سَبْعَةَ عَشَرَ شَهْرًا ، أَوْ ثَمَانِيَةَ عَشَرَ شَهْرًا ، ثُمَّ مَاتَتْ فَجَاءَ  عَلْقَمَةُ  إِلَى عَبْدِ اللهِ يَسْأَلُهُ عَنْ مِيرَاثِهَا ،  فَقَالَ  : « قَدْ حَبَسَ اللهُ عَلَيْكَ مِيرَاثَهَا ، فَوَرِثَهَا  » .","","Sunan Sa'id ibn Mansur 1301","","عبد الله بن مسعود عن إبراهيم النخعي عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب المرأة تطلق تطليقة أو تطليقتين فترتفع حيضتها فتموت يرثها زوجها"
"2479","1302  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ  عَنْ  إِبْرَاهِيمَ ،         [6/349]      عَنْ  عَلْقَمَةَ ،  أَنَّهُ طَلَّقَ امْرَأَتَهُ تَطْلِيقَةً فَحَاضَتْ حَيْضَةً أَوْ حَيْضَتَيْنِ فِي سِتَّةَ عَشَرَ شَهْرًا  ، أَوْ سَبْعَةَ عَشَرَ شَهْرًا ، ثُمَّ لَمْ تَحِضِ الثَّالِثَةَ حَتَّى مَاتَتْ ، فَأَتَى عَبْدَ اللهِ فَذَكَرَ ذَلِكَ لَهُ ،  فَقَالَ  عَبْدُ اللهِ  ، « حَبَسَ اللهُ عَلَيْكَ مِيرَاثَهَا فَوَرَّثَهُ مِنْهَا  » .","","Sunan Sa'id ibn Mansur 1302","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب المرأة تطلق تطليقة أو تطليقتين فترتفع حيضتها فتموت يرثها زوجها"
"2480","1303  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنْبَأَ  دَاوُدُ ،  عَنِ  الشَّعْبِيِّ ، وَحُمَيْدٌ ،  عَنِ  الْحَسَنِ ، وَعُبَيْدَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُمْ قَالُوا : «  إِذَا كَانَتْ تَحِيضُ فَعِدَّتُهَا بِالْحَيْضِ  وَإِنْ حَاضَتْ فِي كُلِّ سَنَةٍ مَرَّةً  » .","","Sunan Sa'id ibn Mansur 1303","","الشعبي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تطلق تطليقة أو تطليقتين فترتفع حيضتها فتموت يرثها زوجها"
"2481","1304  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ، قَالَ : «  إِذَا كَانَتِ الْمَرْأَةُ تَحِيضُ فِي كُلِّ سَنَةٍ مَرَّةً تَكْفِيهَا ثَلَاثَةُ أَشْهُرٍ  » . وَقَالَ طَاوُسٌ : «  أَقَرَاؤُهَا مَا كَانَتْ  » .","","Sunan Sa'id ibn Mansur 1304","","جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب المرأة تطلق تطليقة أو تطليقتين فترتفع حيضتها فتموت يرثها زوجها"
"2482","1305  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  أَيُّوبَ بْنِ مُوسَى ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  أَنَّ  حَبَّانَ بْنَ مُنْقِذٍ  ، كَانَتْ تَحْتَهُ امْرَأَتَانِ هَاشِمِيَّةٌ وَأَنْصَارِيَّةٌ ، فَطَلَّقَ الْأَنْصَارِيَّةَ  وَكَانَتْ تُرْضِعُ فَلَبِثَتْ سَنَةً ، ثُمَّ مَاتَ عَنْهَا عِنْدَ رَأْسِ الْحَوْلِ ، فَأَتَتْ عُثْمَانَ بْنَ عَفَّانَ رَضِيَ اللهُ عَنْهُ فَقَالَتْ : إِنَّ لِي مِيرَاثًا ،  فَقَالَ  عُثْمَانُ  : « إِنَّ هَذَا أَمْرٌ لَيْسَ بِهِ عِلْمٌ  ، ائْتِ  عَلِيًّا  » ،  فَقَالَ  عَلِيٌّ رَضِيَ اللهُ عَنْهُ : « تَحْلِفِينَ عِنْدَ مِنْبَرِ         [6/350]      رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّكِ لَمْ تَحِيضِي ثَلَاثَ حِيَضٍ ، فَإِنْ حَلَفْتِ فَلَكِ الْمِيرَاثُ » ، فَحَلَفَتْ فَأَشْرَكَهَا  عَلِيٌّ  مَعَ الْهَاشِمِيَّةِ فِي الثُّمُنِ ، فَقَالَ  عُثْمَانُ  رَضِيَ اللهُ عَنْهُ لِلْهَاشِمِيَّةِ كَأَنَّهُ يَعْتَذِرُ إِلَيْهَا : « هَذَا قَضَاءُ ابْنِ عَمِّكِ »  .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، والأصل الخطي ، ولعل الأولى زيادة لفظة ( لي ) بعد ( ليس ) كما في مصنف عبد الرزاق 6 / 341","","Sunan Sa'id ibn Mansur 1305","","علي بن أبي طالب عن محمد بن يحيى بن حبان عن أيوب بن موسى الأموي عن سفيان بن عيينة عن سعيد بن منصور","باب المرأة تطلق تطليقة أو تطليقتين فترتفع حيضتها فتموت يرثها زوجها"
"2483","1306  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، «  أَنَّهُ قَالَ فِي رَجُلٍ يُطَلِّقُ امْرَأَتَهُ تَطْلِيقَةً أَوْ ثِنْتَيْنِ ثُمَّ تَرْتَفِعُ حَيْضَتُهَا  فَلَمْ يَدْرِ مَا رَفَعَتْهَا فَإِنَّهَا تَرَبَّصُ مِنْ عِنْدِ الرِّيبَةِ تِسْعَةَ أَشْهُرٍ فَإِنِ اسْتَبَانَ بِهَا حَمْلٌ فَذَاكَ ، وَإِنْ لَمْ يَسْتَبِنْ تَرَبَّصَتْ ثَلَاثَةَ أَشْهُرٍ ، ثُمَّ تَزَوَّجَتْ مَنْ شَاءَتْ  » .","","Sunan Sa'id ibn Mansur 1306","","سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تطلق تطليقة أو تطليقتين فترتفع حيضتها فتموت يرثها زوجها"
"2484","1307  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  تَرَبَّصُ سَنَةً مِنْ بَعْدِ الرِّيبَةِ ، ثُمَّ ثَلَاثَةَ أَشْهُرٍ بَعْدَ السَّنَةِ  ، ثُمَّ تَزَوَّجُ إِنْ شَاءَتْ  » .","","Sunan Sa'id ibn Mansur 1307","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تطلق تطليقة أو تطليقتين فترتفع حيضتها فتموت يرثها زوجها"
"2485","1308  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَشْعَثُ بْنُ عَبْدِ الْمَلِكِ ،  عَنِ  ابْنِ سِيرِينَ ،  أَنَّ  ابْنَ مَسْعُودٍ ، كَانَ يَقُولُ : «  تَعْتَدُّ بِالْحَيْضِ إِنْ كَانَتْ تَحِيضُ  » .","","Sunan Sa'id ibn Mansur 1308","","عبد الله بن مسعود عن محمد بن سيرين عن أشعث الحمراني عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تطلق تطليقة أو تطليقتين فترتفع حيضتها فتموت يرثها زوجها"
"2486","1309  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ         [6/351]      الشَّعْبِيِّ ، قَالَ :  أُتِيَ عَلِيٌّ رَضِيَ اللهُ عَنْهُ فِي رَجُلٍ طَلَّقَ امْرَأَتَهُ فَحَاضَتْ ثَلَاثَ حِيَضٍ  فِي  شَهْرٍ ، أَوْ خَمْسٍ وَثَلَاثِينَ لَيْلَةً  ، فَقَالَ  لِشُرَيْحٍ  : اقْضِ فِيهَا يَا شُرَيْحُ فَقَالَ : أَقْضِي وَأَنْتَ شَاهِدٌ يَا أَمِيرَ الْمُؤْمِنِينَ ، قَالَ : اقْضِ :  قَالَ  : إِنْ جَاءَتْ بِبَيِّنَةٍ مِنَ النِّسَاءِ الْعُدُولِ مِنْ بِطَانَةِ أَهْلِهَا مِمَّنْ يُرْضَى صِدْقُهُ وَعَدْلُهُ فَشَهِدُوا أَنَّهُ قَدْ رَأَتْ مَا يُحَرِّمُ عَلَيْهَا الصَّلَاةَ مِنَ الطَّمْثِ الَّذِي هُوَ الطَّمْثُ ، تَغْتَسِلُ مِنْ كُلِّ قُرْءٍ ، وَتُصَلِّي فَقَدِ انْقَضَتْ عِدَّتُهَا ، وَإِلَّا فَهِيَ كَاذِبَةٌ  ،  فَقَالَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ : إِنْ قَالَ : هِيَ بِالرُّومِيَّةِ أَصَابَ  .","","Sunan Sa'id ibn Mansur 1309","","علي بن أبي طالب عن الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تطلق تطليقة أو تطليقتين فترتفع حيضتها فتموت يرثها زوجها"
"2487","1310  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو شِهَابٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  كَانَ شُرَيْحٌ جَالِسًا عِنْدَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، إِذْ جَاءَتِ امْرَأَةٌ تُخَاصِمُ زَوْجَهَا  أَنَّهُ كَانَ طَلَّقَهَا فَزَعَمَتْ أَنَّهَا قَدْ حَاضَتْ ثَلَاثَ حِيَضٍ فِي شَهْرٍ ،  فَقَالَ  عَلِيٌّ  : يَا  شُرَيْحُ  ، اقْضِ بَيْنَهُمَا ، فَقَالَ : رَحِمَكَ اللهُ يَا أَمِيرَ الْمُؤْمِنِينَ ، أَقْضِي بَيْنَهُمَا وَأَنْتَ جَالِسٌ ، فَقَالَ : لَتَقْضِيَنَّ فِيهَا ،  فَقَالَ  شُرَيْحٌ  : إِنْ جَاءَتْ بِبِطَانَةٍ مِنْ أَهْلِهَا مِمَّنْ يُرْضَى دِينُهُ وَأَمَانَتُهُ يَشْهَدُونَ أَنَّهَا حَاضَتْ ثَلَاثَ حِيَضٍ ، وَاغْتَسَلَتْ عِنْدَ كُلِّ حَيْضٍ ، وَصَلَّتْ فَهُوَ كَمَا قَالَتْ ، وَإِلَّا فَهِيَ كَاذِبَةٌ ، فَقَالَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ :  قَالُونُ  ، بِالرُّومِيَّةِ ، أَيْ : صَدَقَ  .         [6/352]","","Sunan Sa'id ibn Mansur 1310","","علي بن أبي طالب عن الشعبي عن إسماعيل بن أبي خالد عن عبد ربه بن نافع الحناط عن سعيد بن منصور","باب المرأة تطلق تطليقة أو تطليقتين فترتفع حيضتها فتموت يرثها زوجها"
"2488","1311  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  فِي امْرَأَةٍ طُلِّقَتْ فَاعْتَدَّتْ ثَلَاثَ حِيَضٍ فِي أَرْبَعِينَ لَيْلَةً  ، فَقَالَ  إِبْرَاهِيمُ  : « إِنْ جَاءَتْ بِالْبَيِّنَةِ مِنَ النِّسَاءِ الْعُدُولِ يَشْهَدُونَ أَنَّهَا قَدْ رَأَتْ مَا يُحَرِّمُ عَلَيْهَا الصَّلَاةَ مِنَ الطَّمْثِ الَّذِي هُوَ الطَّمْثُ الْمَعْرُوفُ عِنْدَ كُلِّ طُهْرٍ ، وُتَصَلِّي فَقَدِ انْقَضَى أَجَلُهَا وَإِلَّا فَهِيَ كَاذِبَةٌ  » .","","Sunan Sa'id ibn Mansur 1311","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تطلق تطليقة أو تطليقتين فترتفع حيضتها فتموت يرثها زوجها"
"2489","1312  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  فُضَيْلٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُسْلِمِ بْنِ صُبَيْحٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  أُبَيِّ بْنِ كَعْبٍ ، قَالَ : «  مِنَ الْأَمَانَةِ أَنَّ الْمَرْأَةَ ائْتُمِنَتْ عَلَى فَرْجِهَا  » .","","Sunan Sa'id ibn Mansur 1312","","أبي بن كعب عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن الفضيل بن عياض عن سعيد بن منصور","باب المرأة تطلق تطليقة أو تطليقتين فترتفع حيضتها فتموت يرثها زوجها"
"2490","1313  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ، قَالَ : «  ائْتُمِنَتِ الْمَرْأَةُ عَلَى فَرْجِهَا  » .","","Sunan Sa'id ibn Mansur 1313","","عبيد بن عمير بن قتادة الجندعي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب المرأة تطلق تطليقة أو تطليقتين فترتفع حيضتها فتموت يرثها زوجها"
"2491","بَابُ مَنْ رَاجَعَ امْرَأَتَهُ وَهُوَ غَائِبٌ وَهِيَ لَا تَعْلَمُ .  1314  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  أَبَا كَنَفٍ  طَلَّقَ امْرَأَتَهُ ، ثُمَّ سَافَرَ فَرَاجَعَ امْرَأَتَهُ وَهِيَ لَا تَعْلَمُ  ، فَاعْتَدَّتْ ، فَلَمَّا انْقَضَتْ عِدَّتُهَا تَزَوَّجَتْ ، فَقَدِمَ عَلَى  عُمَرَ  فَأَخْبَرَهُ ،  فَقَالَ  عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ : « مِنْ قِبَلِكَ جَاءَ التَّفْرِيطُ . فَكَتَبَ لَهُ : إِنْ كَانَ زَوْجُهَا لَمْ يَدْخُلْ بِهَا فَهُوَ أَحَقُّ بِهَا . فَقَدِمَ وَقَدْ تَهَيَّتْ وَامْتَشَطَتْ لِيَدْخُلَ عَلَيْهَا زَوْجُهَا ،         [6/353]      وَعِنْدَهَا النِّسَاءُ ، فَخَلَا بِهَا ، فَنَاشَدَهَا اللهَ ، أَقْرَبَكِ ؟ قَالَتْ : لَا . فَأَغْلَقَ الْبَابَ دُونَ النِّسَاءِ ، فَلَمَّا أَصْبَحَ قَرَأَ عَلَيْهِمْ كِتَابَ  عُمَرَ  ، فَأُقِرَّ مَعَ امْرَأَتِهِ  » .","","Sunan Sa'id ibn Mansur 1314","","عمر بن الخطاب عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب من راجع امرأته وهو غائب وهي لا تعلم"
"2492","1315  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، بِهَذَا الْحَدِيثِ .","","Sunan Sa'id ibn Mansur 1315","","عمر بن الخطاب عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب من راجع امرأته وهو غائب وهي لا تعلم"
"2493","1316  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  أَبَا كَنَفٍ  طَلَّقَ امْرَأَتَهُ وَهُوَ غَائِبٌ فَأَعْلَمَهَا الطَّلَاقَ ، ثُمَّ رَاجَعَهَا وَلَمْ يُعْلِمْهَا بِالرَّجْعَةِ  ، فَقَدِمَ أَبُو كَنَفٍ ، فَإِذَا هِيَ قَدْ تَزَوَّجَتْ ، فَأَتَى  عُمَرَ بْنَ الْخَطَّابِ  فَذَكَرَ ذَلِكَ لَهُ ،  فَقَالَ  عُمَرُ : «  النَّجَاءَ  ، فَإِنْ أَدْرَكْتَهَا قَبْلَ أَنْ يَدْخُلَ بِهَا فَهِيَ امْرَأَتُكَ ، وَإِنْ جِئْتَ بَعْدَمَا يَدْخُلُ بِهَا فَلَا سَبِيلَ عَلَيْهَا . فَجَاءَ فَوَافَقَهَا لَيْلَةَ  عُرْسِهَا  ، فَقَالَ : اسْتَأْذِنُوا لِي عَلَيْهَا ; فَإِنَّ لِي إِلَيْهَا حَاجَةً . فَفَعَلُوا ، فَأَخَذَ بِرِجْلِهَا  » .","","Sunan Sa'id ibn Mansur 1316","","عمر بن الخطاب عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب من راجع امرأته وهو غائب وهي لا تعلم"
"2494","1317  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ، وَمُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  قَالَ  عُمَرُ بْنُ الْخَطَّابِ : «  إِذَا طَلَّقَ الرَّجُلُ امْرَأَتَهُ فَأَعْلَمَهَا طَلَاقَهَا ، ثُمَّ رَاجَعَهَا وَكَتَمَهَا الرَّجْعَةَ  حَتَّى انْقَضَتِ الْعِدَّةُ ، فَلَا سَبِيلَ لَهُ عَلَيْهَا  » .","","Sunan Sa'id ibn Mansur 1317","","عمر بن الخطاب عن إبراهيم النخعي عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب من راجع امرأته وهو غائب وهي لا تعلم"
"2495","1318  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا طَلَّقَ الرَّجُلُ امْرَأَتَهُ ، ثُمَّ رَاجَعَهَا فِي غَيْبٍ  أَوْ مَشْهَدٍ فَلَمْ يُعْلِمْهَا الرَّجْعَةَ حَتَّى تَنْقَضِيَ الْعِدَّةُ ، فَلَا سَبِيلَ لَهُ عَلَيْهَا  » .","","Sunan Sa'id ibn Mansur 1318","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب من راجع امرأته وهو غائب وهي لا تعلم"
"2496","1319  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَتَّابٌ ، قَالَ :  أَنَا  خُصَيْفٌ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  قَالَ  فِي الرَّجُلِ الْغَائِبِ يَكْتُبُ إِلَى امْرَأَتِهِ بِالطَّلَاقِ ، ثُمَّ يَكْتُبُ إِلَيْهَا         [6/354]      بِالرَّجْعَةِ  ، فَلَا يَأْتِيهَا حَتَّى تَتَزَوَّجَ ، قَالَ : « إِذَا أَدْرَكَهَا قَبْلَ أَنْ يَدْخُلَ بِهَا الْآخَرُ فَهِيَ امْرَأَتُهُ ، وَإِنْ لَمْ يُدْرِكْهَا حَتَّى يَدْخُلَ بِهَا فَقَدْ  بَانَتْ  » .","","Sunan Sa'id ibn Mansur 1319","","سعيد بن المسيب عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب من راجع امرأته وهو غائب وهي لا تعلم"
"2497","1320  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُحَمَّدُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ ، وَشُعْبَةَ ،  عَنِ  الْحَكَمِ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا رَاجَعَهَا فِي الْعِدَّةِ فَهِيَ امْرَأَتُهُ  ، تَزَوَّجَتْ أَوْ لَمْ تَتَزَوَّجْ ، دَخَلَ بِهَا أَوْ لَمْ يَدْخُلْ بِهَا ، عَلِمَتْ أَوْ لَمْ تَعْلَمْ  » .","","Sunan Sa'id ibn Mansur 1320","","علي بن أبي طالب عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن محمد بن سالم الهمداني عن هشيم بن بشير عن سعيد بن منصور","باب من راجع امرأته وهو غائب وهي لا تعلم"
"2498","1321  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  دَاوُدُ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّ رَجُلًا طَلَّقَ امْرَأَتَهُ تَطْلِيقَةً فَأَعْلَمَهَا بِالطَّلَاقِ  ، ثُمَّ سَافَرَ وَكَتَبَ إِلَيْهَا بِالرَّجْعَةِ فَلَمْ يَبْلُغْهَا الْكِتَابُ ، حَتَّى انْقَضَتِ الْعِدَّةُ ، فَأَتَى  شُرَيْحًا  فَذَكَرَ ذَلِكَ لَهُ ،  فَقَالَ  شُرَيْحٌ : « إِنْ كَانَتْ تَزَوَّجَتْ فَلَا سَبِيلَ لَكَ عَلَيْهَا ، وَإِنْ كَانَتْ لَمْ تَتَزَوَّجْ فَارْفَعْهَا إِلَى السُّلْطَانِ ، فَيَكُونُونَ هُمُ الَّذِينَ يَرُدُّونَهَا عَلَيْكَ أَوْ يَمْنَعُونَكَهَا ، وَأَعْلِمُوهُنَّ الرَّجْعَةَ كَمَا تُعْلِمُوهُنَّ الطَّلَاقَ  » .","","Sunan Sa'id ibn Mansur 1321","","شريح بن الحارث الكندي عن الشعبي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب من راجع امرأته وهو غائب وهي لا تعلم"
"2499","1322  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، وَمُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، وَمُحَمَّدِ بْنِ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ ، وَأَبُو إِسْحَاقَ  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  أَنَّهُمْ قَالُوا فِي رَجُلٍ طَلَّقَ امْرَأَتَهُ وَاحِدَةً أَوِ اثْنَتَيْنِ ، ثُمَّ غَشِيَهَا فِي الْعِدَّةِ : « إِنَّهَا مُرَاجَعَةٌ  ، وَيَشْهَدُ عَلَى مَا كَانَ مِنْهُ  » .         [6/355]","","Sunan Sa'id ibn Mansur 1322","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب من راجع امرأته وهو غائب وهي لا تعلم"
"2500","1323  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ بْنُ عُبَيْدٍ ،  عَنِ  ابْنِ سِيرِينَ ، قَالَ :  جَاءَ رَجُلٌ إِلَى عِمْرَانَ بْنِ حُصَيْنٍ ، فَقَالَ : إِنَّهُ طَلَّقَ امْرَأَتَهُ وَلَمْ يُشْهِدْ ، وَرَاجَعَ وَلَمْ يُشْهِدْ  ،  فَقَالَ  لَهُ  عِمْرَانُ  : « طَلَّقْتَ لِغَيْرِ  عِدَّةٍ  ، وَرَاجَعْتَ فِي غَيْرِ سُنَّةٍ ، أَشْهِدْ عَلَى مَا صَنَعْتَ  » .","","Sunan Sa'id ibn Mansur 1323","","عمران بن حصين بن عبيد بن خلف الخزاعي عن محمد بن سيرين عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب من راجع امرأته وهو غائب وهي لا تعلم"
"2501","1324  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عُبَيْدَةُ ،  عَنِ  الْحَسَنِ بْنِ رَوَاحٍ ، قَالَ :  سَأَلْتُ  سَعِيدَ بْنَ الْمُسَيِّبِ  عَنْ رَجُلٍ طَلَّقَ سِرًّا وَرَاجَعَ سِرًّا  ، فَقَالَ : « طَلَّقْتَ فِي غَيْرِ  عِدَّةٍ  ، وَرَاجَعْتَ عَمًا  ، أَشْهِدْ عَلَى مَا صَنَعْتَ  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : كذا في ص ، وفي المحلى : ( وارتجعت في عما ) ، والمراد به العمى وهو عدم البصيرة .","","Sunan Sa'id ibn Mansur 1324","","سعيد بن المسيب عن الحسن بن رواح عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب من راجع امرأته وهو غائب وهي لا تعلم"
"2502","1325  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنْبَأَ  يُونُسُ ،  عَنِ  الْحَسَنِ ، قَالَ : «  إِذَا طَلَّقَ وَلَمْ يُشْهِدْ ، وَرَاجَعَ وَلَمْ يُشْهِدْ ، فَلْيُشْهِدْ عَلَى مَا صَنَعَ  » .","","Sunan Sa'id ibn Mansur 1325","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب من راجع امرأته وهو غائب وهي لا تعلم"
"2503","1326  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ، وَعَاصِمٍ الْأَحْوَلِ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ، قَالَ :  قَالَ  عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ : «  رُدُّوا الْجَهَالَاتِ إِلَى السُّنَّةِ  » .","","Sunan Sa'id ibn Mansur 1326","","عمر بن الخطاب عن مسروق بن الأجدع عن الشعبي عن عاصم بن سليمان الأحول عن سفيان بن عيينة عن سعيد بن منصور","باب من راجع امرأته وهو غائب وهي لا تعلم"
"2504","1327  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ، قَالَ :  «  خَالَفْتُ رَجُلًا مِنَ الْقُرَّاءِ الْأَوَّلِينَ فِي الرَّجُلِ يُطَلِّقُ امْرَأَتَهُ         [6/356]      فَيَكْتُمُهَا رَجْعَتَهَا  حَتَّى تَنْقَضِيَ عِدَّتُهَا ،  فَسَأَلْتُ  شُرَيْحًا ، فَقَالَ : لَهُ  فَسْوَةُ  الضَّبُعِ »  .","","Sunan Sa'id ibn Mansur 1327","","شريح بن الحارث الكندي عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب من راجع امرأته وهو غائب وهي لا تعلم"
"2505","بَابُ الطَّلَاقِ بِالرِّجَالِ وَالْعِدَّةِ بِالنِّسَاءِ .  1328  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  أَيُّوبَ ،  سَمِعَ  سُلَيْمَانَ بْنَ يَسَارٍ ، يَقُولُ : «  إِنَّ  نُفَيْعًا فَتَى أُمِّ سَلَمَةَ  طَلَّقَ امْرَأَةً حُرَّةً تَطْلِيقَتَيْنِ  ، فَحَرَصُوا أَنْ يَرُدُّوهَا عَلَيْهِ ، فَأَبَى ذَلِكَ عُثْمَانُ وَزَيْدُ بْنُ ثَابِتٍ  » .","","Sunan Sa'id ibn Mansur 1328","","زيد بن ثابت الأنصاري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن أيوب السختياني عن سفيان بن عيينة عن سعيد بن منصور","باب الطلاق بالرجال والعدة بالنساء"
"2506","1329  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  عِكْرِمَةَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ ، قَالَ : «  الطَّلَاقُ  بِالرِّجَالِ وَالْعِدَّةُ بِالنِّسَاءِ  » .","","Sunan Sa'id ibn Mansur 1329","","زيد بن ثابت الأنصاري عن عكرمة مولى ابن عباس عن خالد الحذاء عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الطلاق بالرجال والعدة بالنساء"
"2507","1330  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، سَمِعَهُ يَقُولُ : «  الطَّلَاقُ  بِالرِّجَالِ وَالْعِدَّةُ بِالنِّسَاءِ  » .","","Sunan Sa'id ibn Mansur 1330","","سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن سفيان بن عيينة عن سعيد بن منصور","باب الطلاق بالرجال والعدة بالنساء"
"2508","1331  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ : «  يُطَلِّقُ الْحُرُّ الْأَمَةَ ثَلَاثَ تَطْلِيقَاتٍ ، وَتَعْتَدُّ حَيْضَتَيْنِ  ، وَيُطَلِّقُ الْمَمْلُوكُ الْحُرَّةَ تَطْلِيقَتَيْنِ ، وَتَعْتَدُّ ثَلَاثَ حِيَضٍ ، فَالطَّلَاقُ بِالرِّجَالِ ، وَالْعِدَّةُ بِالنِّسَاءِ  » .","","Sunan Sa'id ibn Mansur 1331","","سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب الطلاق بالرجال والعدة بالنساء"
"2509","1332  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَشْعَثُ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  قَالَ  عَبْدُ اللهِ : «  السُّنَّةُ بِالنِّسَاءِ فِي الطَّلَاقِ وَالْعِدَّةِ  » .         [6/357]","","Sunan Sa'id ibn Mansur 1332","","عبد الله بن مسعود عن الشعبي عن أشعث بن سوار عن هشيم بن بشير عن سعيد بن منصور","باب الطلاق بالرجال والعدة بالنساء"
"2510","1333  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، وَابْنِ سِيرِينَ أَنَّهُمَا كَانَا يَقُولَانِ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1333","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الطلاق بالرجال والعدة بالنساء"
"2511","1334  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدٌ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1334","","الحسن البصري عن يونس بن عبيد عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الطلاق بالرجال والعدة بالنساء"
"2512","1335  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدٍ ، وَالْحَسَنِ ، أَنَّهُمَا كَانَا يَقُولَانِ : «  الطَّلَاقُ وَالْعِدَّةُ بِالنِّسَاءِ  » .","","Sunan Sa'id ibn Mansur 1335","","محمد بن سيرين عن أيوب السختياني عن حماد بن زيد عن سعيد بن منصور","باب الطلاق بالرجال والعدة بالنساء"
"2513","1336  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عِكْرِمَةَ ، قَالَ : «  يُطَلِّقُ الْمَمْلُوكُ الْحُرَّةَ ثَلَاثًا  ، وَيُطَلِّقُ الْحُرُّ الْمَمْلُوكَةَ تَطْلِيقَتَيْنِ  » .","","Sunan Sa'id ibn Mansur 1336","","عكرمة مولى ابن عباس عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب الطلاق بالرجال والعدة بالنساء"
"2514","1337  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  الطَّلَاقُ وَالْعِدَّةُ بِالنِّسَاءِ  » .","","Sunan Sa'id ibn Mansur 1337","","إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب الطلاق بالرجال والعدة بالنساء"
"2515","1338  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، عَمَّنْ  قَالَ  :  نَا  الْأَعْمَشُ ، قَالَ :  قَالَ  عَبْدُ اللهِ : «  السُّنَّةُ بِالنِّسَاءِ فِي الطَّلَاقِ وَالْعِدَّةِ  » .","","Sunan Sa'id ibn Mansur 1338","","عبد الله بن مسعود عن الأعمش عن عمن عن أبو معاوية الضرير عن سعيد بن منصور","باب الطلاق بالرجال والعدة بالنساء"
"2516","1339  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1339","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن أشعث بن سوار عن شعبة بن الحجاج عن عبد الرحمن بن زياد العراقي عن سعيد بن منصور","باب الطلاق بالرجال والعدة بالنساء"
"2517","1340  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْحَسَنُ بْنُ عُمَارَةَ ،  عَنِ  الْحَكَمِ ،  عَنْ  يَحْيَى بْنِ الْجَزَّارِ ،  عَنْ  عَلِيٍّ ، قَالَ : «  الطَّلَاقُ بِالنِّسَاءِ وَالْعِدَّةُ بِالنِّسَاءِ  » .","","Sunan Sa'id ibn Mansur 1340","","علي بن أبي طالب عن يحيى بن الجزار العرني عن الحكم بن عتيبة الكندي عن الحسن بن عمارة عن أبو معاوية الضرير عن سعيد بن منصور","باب الطلاق بالرجال والعدة بالنساء"
"2518","[6/358]      بَابُ الْمُتَوَفَّى عَنْهَا زَوْجُهَا أَيْنَ تَعْتَدُّ .  1341  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  أَنَّ نِسْوَةً مِنْ  هَمْدَانَ  قُتِلَ أَزْوَاجُهُنَّ  ، فَأَرْسَلْنَ إِلَى عَبْدِ اللهِ بْنِ مَسْعُودٍ يَسْأَلْنَهُ عَنِ الْخُرُوجِ ،  فَقَالَ  : « اخْرُجْنَ بِالنَّهَارِ ، يُؤْنِسُ بَعْضُكُنَّ بَعْضًا ، فَإِذَا كَانَ اللَّيْلُ فَلَا تَبِيتَنَّ عَنْ بُيُوتِكُنَّ  » .","","Sunan Sa'id ibn Mansur 1341","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن سفيان بن عيينة عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2519","1342  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ، وَالْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ نِسْوَةً مِنْ  هَمْدَانَ  قُتِلَ أَزْوَاجُهُنَّ فَاسْتَوْحَشْنَ  ، فَأَتَيْنَ ابْنَ مَسْعُودٍ  فَسَأَلْنَهُ  ، فَقَالَ أَحَدُهُمَا : تَزَاوَرْنَ بِالنَّهَارِ . وَقَالَ الْآخَرُ : تَحَدَّثْنَ بِالنَّهَارِ مَا بَدَا لَكُنَّ ، وَارْجِعْنَ بِاللَّيْلِ إِلَى بُيُوتِكُنَّ  » .","","Sunan Sa'id ibn Mansur 1342","","عبد الله بن مسعود عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2520","1343  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  تُوُفِّيَ أَزْوَاجُ نِسْوَةٍ وَهُنَّ  حَاجَّاتٌ أَوْ مُعْتَمِرَاتٌ  ،         [6/359]      فَرَدَّهُنَّ عُمَرُ بْنُ الْخَطَّابِ مِنْ  ذِي الْحُلَيْفَةِ  يَعْتَدِدْنَ فِي بُيُوتِهِنَّ  .","","Sunan Sa'id ibn Mansur 1343","","عمر بن الخطاب عن سعيد بن المسيب عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن جرير بن عبد الحميد عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2521","1344  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَبْدُ الْمَلِكِ ،  عَنْ  عَطَاءٍ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ «  رَدَّ نِسْوَةً خَرَجْنَ حُجَّاجًا فِي عِدَّتِهِنَّ  ، فَرَدَّهُنَّ مِنْ  ذِي الْحُلَيْفَةِ  إِلَى بُيُوتِهِنَّ  » .","","Sunan Sa'id ibn Mansur 1344","","عمر بن الخطاب عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن هشيم بن بشير عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2522","1345  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  أَيُّوبَ بْنِ مُوسَى ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  أَنَّ امْرَأَةً تُوُفِّيَ عَنْهَا زَوْجُهَا وَكَانَتْ فِي عِدَّتِهَا ، فَمَاتَ أَبُوهَا  ،  فَسُئِلَ  عَنْهَا عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ ، « فَرَخَّصَ لَهَا أَنْ تَبِيتَ اللَّيْلَةَ وَاللَّيْلَتَيْنِ  » .","","Sunan Sa'id ibn Mansur 1345","","عمر بن الخطاب عن سعيد بن المسيب عن أيوب بن موسى الأموي عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2523","1346  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  الْمُتَوَفَّى عَنْهَا زَوْجُهَا لَا تَخْرُجْ مِنْ بَيْتِهَا إِلَّا فِي حَقٍّ  عِيَادَةِ الْمَرِيضِ ، أَوْ ذِي قَرَابَةٍ ، أَوْ أَمْرٍ لَا بُدَّ مِنْهُ ، وَالْمُطَلَّقَةُ ثَلَاثًا مِثْلُ ذَلِكَ  » .","","Sunan Sa'id ibn Mansur 1346","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2524","1347  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  الْمُتَوَفَّى عَنْهَا زَوْجُهَا لَا تَخْرُجُ إِلَّا فِي حَقٍّ  ، عِيَادَةِ وَالِدٍ ، أَوْ ذِي قَرَابَةٍ تَصِلُهُ ، وَلَا تَبِيتُ إِلَّا فِي بَيْتِهَا  » .","","Sunan Sa'id ibn Mansur 1347","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2525","1348  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  أَشْعَثَ بْنِ سُلَيْمٍ ،  عَنِ         [6/360]      الْحَارِثِ ،  أَنَّ  رَجُلًا ، قَالَ لِابْنِ مَسْعُودٍ : إِنِّي طَلَّقْتُ امْرَأَتِي ، فَأَصْبَحَتْ غَادِيَةً إِلَى أَهْلِهَا  . فَقَالَ  ابْنُ مَسْعُودٍ  : « مَا يَسُرُّنِي أَنَّ لِي دِينَهَا بِتَمْرَةٍ أَوْ تَمْرَتَيْنِ  » .","","Sunan Sa'id ibn Mansur 1348","","عبد الله بن مسعود عن الحارث بن سويد الأعور عن أشعث بن أبي الشعثاء عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2526","1349  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو الْأَحْوَصِ ، قَالَ :  أَنَا  أَشْعَثُ بْنُ سُلَيْمٍ ،  عَنِ  الْحَارِثِ بْنِ سُوَيْدٍ ،  قَالَ  :  كُنْتُ قَاعِدًا عِنْدَ ابْنِ مَسْعُودٍ ، فَأَتَاهُ رَجُلٌ فَقَالَ :  مَا تَرَى فِي امْرَأَةٍ طُلِّقَتْ ، فَأَصْبَحَتْ عَائِدَةً إِلَى أَهْلِهَا ؟  فَقَالَ  عَبْدُ اللهِ  : « مَا يَسُرُّنِي أَنَّ لِي دِينَهَا بِتَمْرَةٍ  » .","","Sunan Sa'id ibn Mansur 1349","","عبد الله بن مسعود عن الحارث بن سويد الأعور عن أشعث بن أبي الشعثاء عن سلام بن سليم الحنفي عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2527","1350  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ «  أَنَّهُ انْتَقَلَ  أُمَّ كُلْثُومٍ  ابْنَتَهُ حَيْثُ أُصِيبَ  عُمَرُ  ، فَانْتَقَلَهَا فِي عِدَّتِهَا  » .","","Sunan Sa'id ibn Mansur 1350","","علي بن أبي طالب عن الحسن البصري عن يونس بن يزيدالأيلي عن هشيم بن بشير عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2528","1351  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّهُ سُئِلَ عَنِ الْمُتَوَفَّى عَنْهَا زَوْجُهَا ، أَتَخْرُجُ فِي عِدَّتِهَا ؟  فَقَالَ : « كَانَ أَصْحَابُ عَبْدِ اللهِ أَشَدَّ شَيْئًا فِي ذَلِكَ ، كَانُوا يَقُولُونَ : لَا تَخْرُجُ  ، وَكَانَ الشَّيْخُ - يَعْنِي عَلِيًّا رَضِيَ اللهُ عَنْهُ - يُرَحِّلُهَا  » .","","Sunan Sa'id ibn Mansur 1351","","علي بن أبي طالب عن الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2529","1352  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  عَطَاءٍ ، وَجَابِرِ         [6/361]      بْنِ زَيْدٍ ،  فِي الْمُتَوَفَّى عَنْهَا ، قَالَ : « لَا تَخْرُجُ  » .","","Sunan Sa'id ibn Mansur 1352","","عطاء بن أبي رباح عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2530","1353  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  أَنَّ  يَحْيَى بْنَ سَعِيدِ بْنِ الْعَاصِ  ، طَلَّقَ امْرَأَتَهُ - وَهِيَ  بِنْتُ عَبْدِ الرَّحْمَنِ بْنِ الْحَكَمِ  ابْنِ أَخِي  مَرْوَانَ  - فَنَقَلَهَا أَبُوهَا فِي عِدَّتِهَا ، فَأَرْسَلَتْ عَائِشَةُ إِلَى  مَرْوَانَ  : «  اتَّقُوا اللهَ وَارْدُدُوا الْمَرْأَةَ إِلَى بَيْتِ زَوْجِهَا لِتَعْتَدَّ فِيهِ  » فَأَرْسَلَ إِلَيْهَا  مَرْوَانُ  : إِنَّ أَبَاهَا قَدْ غَلَبَنِي عَلَى ذَلِكَ . قَالَ يَحْيَى :  فَحَدَّثَنِي  الْقَاسِمُ بْنُ مُحَمَّدٍ أَنَّ  مَرْوَانَ  حَيْثُ أَرْسَلَتْ إِلَيْهِ  عَائِشَةُ  ، فَقَالَ : أَمَا بَلَغَكِ حَدِيثُ  فَاطِمَةَ بِنْتِ قَيْسٍ  ؟ فَقَالَتْ : دَعْ عَنْكَ حَدِيثَ  فَاطِمَةَ  . فَقَالَ  مَرْوَانُ  : بِكِ الشَّرُّ ؟ حَسْبُكِ مَا بَيْنَ هَذَيْنِ مِنَ الشَّرِّ  .","","Sunan Sa'id ibn Mansur 1353","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2531","1354  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ، قَالَ :  حَدَّثَنِي  عَمْرُو بْنُ مَيْمُونِ بْنِ مِهْرَانَ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَأَلْتُ  سَعِيدَ بْنَ الْمُسَيِّبِ عَنْ أَمْرِ  فَاطِمَةَ بِنْتِ قَيْسٍ  ، مَا بَالُهَا انْتَقَلَتْ ؟  قَالَ : « لِأَنَّهَا  بَذَتْ  عَلَيْهِمْ وَهِيَ مَعَهُمْ فِي الدَّارِ ، فَأَخْرَجَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ لَمْ يَتْرُكْهَا تَنْتَقِلُ إِلَى أَهْلِهَا  » .         [6/362]","","Sunan Sa'id ibn Mansur 1354","","سعيد بن المسيب عن ميمون بن مهران الرقي عن عمرو بن ميمون بن مهران عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2532","1355  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  يَعْقُوبُ بْنُ عَبْدِ الرَّحْمَنِ الزُّهْرِيُّ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  فَاطِمَةَ بِنْتِ قَيْسٍ ،  أَنَّهُ طَلَّقَهَا زَوْجُهَا فِي عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكَانَ يُنْفِقُ عَلَيْهَا نَفَقَةَ دُونٍ ، فَلَمَّا رَأَتْ ذَلِكَ قَالَتْ : وَاللهِ لَأُكَلِّمَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَإِنْ كَانَتْ لِي نَفَقَةٌ أَخَذْتُ الَّذِي يُصْلِحُنِي . فَذَكَرْتُ ذَلِكَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : «  لَا نَفَقَةَ لَكِ وَلَا سُكْنَى  » .","","Sunan Sa'id ibn Mansur 1355","","فاطمة بنت قيس الفهرية عن أبو سلمة بن عبد الرحمن عن سلمة بن دينار الأعرج عن يعقوب بن عبد الرحمن الإسكندراني عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2533","1356  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  سَيَّارٌ ، قَالَ :  حَدَّثَنِي  الشَّعْبِيُّ ،  عَنْ  فَاطِمَةَ بِنْتِ قَيْسٍ ، قَالَتْ :  طَلَّقَنِي زَوْجِي فَخَاصَمْتُ فِي السُّكْنَى وَالنَّفَقَةِ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَضَى لِي بِالسُّكْنَى وَالنَّفَقَةِ ، فَلَمَّا بَلَغَهُ أَنَّهُ طَلَّقَنِي ثَلَاثًا « لَمْ يَجْعَلْ لِي سُكْنَى وَلَا نَفَقَةً ، وَأُمِرْتُ أَنْ أَعْتَدَّ فِي بَيْتِ امْرَأَةٍ » ، فَقِيلَ لَهُ : يُتَحَدَّثُ إِلَيْهَا . قَالَتْ : « فَأَمَرَنِي أَنْ أَعْتَدَّ فِي بَيْتِ  ابْنِ أُمِّ مَكْتُومٍ  » .","","Sunan Sa'id ibn Mansur 1356","","فاطمة بنت قيس الفهرية عن الشعبي عن سيار بن أبي سيار العنزي عن هشيم بن بشير عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2534","1357  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ، وَحُصَيْنٌ ، وَإِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  وَأَنَا  دَاوُدُ ، وَمُجَالِدٌ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  دَخَلْتُ عَلَى فَاطِمَةَ بِنْتِ قَيْسٍ ،  فَسَأَلْتُهَا  عَنْ قَضَاءِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَتْ : « طَلَّقَنِي زَوْجِي أَلْبَتَّةَ ، فَخَاصَمْتُهُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي السُّكْنَى وَالنَّفَقَةِ ، فَلَمْ يَجْعَلْ لِي سُكْنَى وَلَا نَفَقَةً ، وَأَمَرَنِي أَنْ أَعْتَدَّ فِي بَيْتِ  ابْنِ أُمِّ مَكْتُومٍ  . قَالَ  مُجَالِدٌ  فِي حَدِيثِهِ :  يَا  بِنْتَ آلِ قَيْسٍ  ، إِنَّمَا السُّكْنَى وَالنَّفَقَةُ عَلَى مَنْ لَهُ الرَّجْعَةُ  » .         [6/363]","","Sunan Sa'id ibn Mansur 1357","","فاطمة بنت قيس الفهرية عن الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2535","1358  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  فَاطِمَةَ بِنْتِ قَيْسٍ ، قَالَتْ :  أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَطْلُبُ السُّكْنَى وَالنَّفَقَةَ ، فَقَالَ : «  أَتَسْمَعِينَ يَا هَذِهِ ؟ إِنَّمَا السُّكْنَى وَالنَّفَقَةُ لِمَنْ كَانَ لِزَوْجِهَا عَلَيْهَا الرَّجْعَةُ  » .","","Sunan Sa'id ibn Mansur 1358","","فاطمة بنت قيس الفهرية عن الشعبي عن مجالد بن سعيد عن سفيان بن عيينة عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2536","1359  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  وَنَا  حُصَيْنٌ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّ  عُمَرَ ، قَالَ : «  لَا نَدَعُ كِتَابَ اللهِ عَزَّ وَجَلَّ وَسُنَّةَ نَبِيِّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِقَوْلِ امْرَأَةٍ  ، لَا نَدْرِي لَعَلَّهَا نَسِيَتْ أَوْ شُبِّهَ لَهَا  » .","","Sunan Sa'id ibn Mansur 1359","","عمر بن الخطاب عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2537","1360  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  نَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  ذُكِرَ لَهُ قَوْلُ  عُمَرَ  ، فَقَالَ  الشَّعْبِيُّ  :  امْرَأَةٌ مِنْ  قُرَيْشٍ  ذَاتُ عَقْلٍ وَرَأْيٍ ، أَتَنْسَى قَضَاءً قُضِيَ عَلَيْهَا ؟  .","","Sunan Sa'id ibn Mansur 1360","","الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2538","1361  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ، قَالَ :  نَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  كَانَ عُمَرُ وَعَبْدُ اللهِ « يَجْعَلَانِ لِلْمُطَلَّقَةِ ثَلَاثًا السُّكْنَى وَالنَّفَقَةَ  » . قَالَ : وَكَانَ  عُمَرُ  إِذَا ذُكِرَ عِنْدَهُ حَدِيثُ  فَاطِمَةَ بِنْتِ قَيْسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَهَا أَنْ تَعْتَدَّ فِي غَيْرِ بَيْتِ زَوْجِهَا ، قَالَ : « مَا كُنَّا نُجِيزُ فِي دِينِنَا شَهَادَةَ امْرَأَةٍ  » . قَالَ سَعِيدٌ :  وَقَوْلُ  عُمَرَ  أَحَبُّ إِلَيْنَا مِنْ هَذَا  .","","Sunan Sa'id ibn Mansur 1361","","عبد الله بن مسعود عن إبراهيم النخعي عن الأعمش عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2539","1362  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  أَنَّهُ         [6/364]      كَانَ يَقُولُ  فِي الْمُطَلَّقَةِ ثَلَاثًا وَالْمُتَوَفَّى عَنْهَا زَوْجُهَا : « لَا سُكْنَى لَهَا وَلَا نَفَقَةَ  وَتَعْتَدَّانِ حَيْثُ شَاءَتَا  » .","","Sunan Sa'id ibn Mansur 1362","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2540","1363  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حَجَّاجٌ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّهُ كَانَ يَقُولُ  فِي الْمُطَلَّقَةِ ثَلَاثًا ، وَالْمُتَوَفَّى عَنْهَا زَوْجُهَا : « إِنَّهُمَا لَا سُكْنَى لَهُمَا وَلَا نَفَقَةَ  ، وَتَعْتَدَّانِ حَيْثُ شَاءَتَا ، وَتَحُجَّانِ فِي عِدَّتِهِمَا إِنْ شَاءَتَا  » .","","Sunan Sa'id ibn Mansur 1363","","عبد الله بن عباس عن عطاء بن أبي رباح عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2541","1364  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  أَنَّ امْرَأَةً مِنْ  أَهْلِ الْمَدِينَةِ  تُوَفِّيَ عَنْهَا زَوْجُهَا  ، فَسُئِلَ الْقَاسِمُ بْنُ مُحَمَّدٍ ، فَقَالَ : لَا تَبْرَحُ حَتَّى تَنْقَضِيَ عِدَّتُهَا . وَسُئِلَ سَالِمُ بْنُ عَبْدِ اللهِ ، فَقَالَ مِثْلَ ذَلِكَ ، فَأَتَوْا سَعِيدَ بْنَ الْمُسَيِّبِ فَسَأَلُوهُ عَنْ ذَلِكَ ، فَقَالَ : « لِتَمْكُثْ حَتَّى تَنْقَضِيَ الْعِدَّةُ ، فَإِنِّي أَرْجُو إِنْ هِيَ فَعَلَتْ أَنْ تَزَوَّجَ لَيْلَةَ تَحِلُّ . فَفَعَلَتْ ، فَتَزَوَّجَتْ لَيْلَةَ حَلَّتْ  » .","","Sunan Sa'id ibn Mansur 1364","","سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2542","1365  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  سَعْدِ بْنِ إِسْحَاقَ بْنِ كَعْبِ بْنِ عُجْرَةَ ،  عَنْ  عَمَّتِهِ زَيْنَبَ ،  عَنْ  فُرَيْعَةَ بِنْتِ مَالِكٍ أُخْتِ أَبِي سَعِيدٍ الْخُدْرِيِّ  أَنَّ زَوْجَهَا خَرَجَ فِي طَلَبِ  أَعْلَاجٍ  لَهُ فَقُتِلَ بِطَرَفِ  الْقَدُومِ  ، فَأَتَتْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَتْ ذَلِكَ لَهُ ، قَالَتْ : وَسَأَلْتُهُ النُّقْلَةَ إِلَى إِخْوَتِي . فَذَكَرَتْ حَالًا مِنْ حَالِهَا قَالَتْ : فَرَخَّصَ لِي ، فَلَمَّا وَلَّيْتُ نَادَانِي : «  امْكُثِي فِي         [6/365]      بَيْتِكِ حَتَّى يَبْلُغَ الْكِتَابُ أَجَلَهُ  أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا  » .","","Sunan Sa'id ibn Mansur 1365","","الفريعة بنت مالك الخدرية عن زينب بنت كعب بن عجرة عن سعد بن إسحاق بن كعب بن عجرة عن حماد بن زيد عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2543","1366  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  سُئِلَ عَنْ نِسَاءٍ ، طُلِّقْنَ فِي الْقَنَاطِرِ ، فَقَدِمْنَ  الْكُوفَةَ  ،  « فَأَمَرَهُنَّ  إِبْرَاهِيمُ  أَنْ يَرْجِعْنَ حَيْثُ طُلِّقْنَ يَعْتَدِدْنَ بِهَا  » .","","Sunan Sa'id ibn Mansur 1366","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2544","1367  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ، وَمَنْصُورٌ ،  عَنِ  الْحَسَنِ ،  فِي الْمُتَوَفَّى عَنْهَا ، قَالَ : « تُحَوَّلُ إِنْ شَاءَتْ ، وَتَلْبَسُ مَا شَاءَتْ  » .","","Sunan Sa'id ibn Mansur 1367","","الحسن البصري عن منصور بن المعتمر عن هشيم بن بشير عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2545","1368  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  مَسْرُوقٍ ، قَالَ :  جَاءَ رَجُلٌ إِلَى عَبْدِ اللهِ بْنِ مَسْعُودٍ ، فَقَالَ : «  إِنِّي طَلَّقْتُ امْرَأَتِي ثَلَاثًا ، وَإِنَّهَا أَبَتْ أَنْ تَعْتَدَّ فِي بَيْتِهَا .  قَالَ  : لَا تَدَعْهَا  . قَالَ : إِنَّهَا أَبَتْ إِلَّا أَنْ تَخْرُجَ . قَالَ : تُقَيِّدُهَا . قَالَ : إِنَّ لَهَا إِخْوَةً غَلِيظَةٌ رِقَابُهُمْ . قَالَ : اسْتَعْدِ عَلَيْهِمُ السُّلْطَانُ  » .","","Sunan Sa'id ibn Mansur 1368","","عبد الله بن مسعود عن مسروق بن الأجدع عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2546","1369  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  تُوفِّيَ رَجُلٌ وَامْرَأَتُهُ فِي بَيْتٍ بِأَجْرٍ ، فَسُئِلَ  إِبْرَاهِيمُ  : أَيْنَ تَعْتَدُّ ؟  قَالَ : أَرَى حَسَنًا أَنْ تُعْطِيَ الْكَرَى ، وَتَعْتَدَّ فِي الْبَيْتِ الَّذِي كَانَتْ فِيهِ  » .         [6/366]","","Sunan Sa'id ibn Mansur 1369","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2547","1370  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  أَنَّهُ سُئِلَ عَنْ رَجُلٍ ، طَلَّقَ امْرَأَتَهُ وَهِيَ فِي بَيْتِ مُؤَاجَرَةٍ  قَالَ : « تُقِيمُ فِيهِ حَتَّى تَنْقَضِيَ عِدَّتُهَا ، وَعَلَى زَوْجِهَا أَجْرُ الْبَيْتِ  » .","","Sunan Sa'id ibn Mansur 1370","","سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن حماد بن زيد عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2548","1371  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ، قَالَ :  نَا  أَيُّوبُ ،  عَنْ  نَافِعٍ ،  أَنَّ  ابْنَ عُمَرَ اشْتَكَى ، فَأَتَتْ بِنْتٌ لَهُ تَعُودُهُ مُتَوَفًّى عَنْهَا زَوْجُهَا  ، فَلَمَّا كَانَ مِنَ اللَّيْلِ اسْتَأْذَنَتْهُ أَنْ تَبِيتَ ، « فَأَمَرَهَا أَنْ تَرْجِعَ إِلَى بَيْتِ زَوْجِهَا  » .","","Sunan Sa'id ibn Mansur 1371","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن حماد بن زيد عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2549","1372  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ، قَالَ :  قَالَ  أَبِي : «  الْمُطَلَّقَةُ لَا تَنْتَقِلُ ، إِلَّا أَنْ  يَنْتَوِيَ  أَهْلُهَا  فَتَنْتَوِيَ  مَعَهُمْ  » .","","Sunan Sa'id ibn Mansur 1372","","عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن سعيد بن منصور","باب المتوفى عنها زوجها أين تعتد"
"2550","بَابُ مَا جَاءَ فِي نَفَقَةِ الْحَامِلِ .  1373  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  شُرَيْحٍ ، قَالَ : «  يُنْفَقُ عَلَى الْحَامِلِ الْمُتَوَفَّى عَنْهَا زَوْجُهَا مِنْ جَمِيعِ الْمَالِ  » . قَالَ : وَكَانَ أَصْحَابُنَا يَقُولُونَ : « إِذَا كَانَ الْمَالُ ذَا  مِزٍّ  أُنْفِقَ عَلَيْهَا مِنْ نَصِيبِهَا ، وَإِنْ كَانَ الْمَالُ         [6/367]      قَلِيلًا أُنْفِقَ عَلَيْهَا مِنْ جَمِيعِ الْمَالِ  » .","","Sunan Sa'id ibn Mansur 1373","","شريح بن الحارث الكندي عن إبراهيم النخعي عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2551","1374  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  عَنْ  سُفْيَانَ بْنِ حُسَيْنٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  فِي الْمُتَوَفَّى عَنْهَا زَوْجُهَا وَهِيَ حَامِلٌ ، قَالَ : « لَهَا النَّفَقَةُ مِنْ جَمِيعِ الْمَالِ  » .","","Sunan Sa'id ibn Mansur 1374","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن حسين المعلم عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2552","1375  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  عَنْ  سُفْيَانَ بْنِ حُسَيْنٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  فِي الْمُتَوَفَّى عَنْهَا وَهِيَ حَامِلٌ ، قَالَ : « لَهَا النَّفَقَةُ مِنْ جَمِيعِ الْمَالِ  » .","","Sunan Sa'id ibn Mansur 1375","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن حسين المعلم عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2553","1376  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  سَيَّارٌ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  أَرْسَلَ إِلَيَّ  يَزِيدُ بْنُ أَبِي مُسْلِمٍ  يَسْأَلُنِي عَنِ الْمُتَوَفَّى عَنْهَا وَهِيَ حَامِلٌ  ، فَقُلْتُ لَهُ : يُنْفَقُ عَلَيْهَا مِنْ جَمِيعِ الْمَالِ حَتَّى تَضَعَ ، فَإِذَا وَضَعَتْ قُسِمَ الْمِيرَاثُ . فَقَالَ لِي  يَزِيدُ  : نَقْسِمُ الْمِيرَاثَ ، فَنَعْزِلُ لِمَا فِي بَطْنِهَا نَصِيبَ الْغُلَامِ ، فَإِنْ جَاءَتْ بِغُلَامٍ فَلَهُ نَصِيبُهُ ، وَإِنْ جَاءَتْ بِجَارِيَةٍ أُعْطِيَتْ نَصِيبَهَا وَقُسِمَ مَا سِوَى ذَلِكَ بَيْنَ الْوَرَثَةِ ؟ فَقُلْتُ : أَرَأَيْتَ إِنْ جَاءَتْ بِهِمَا تَوْأَمًا ؟ فَإِنِّي أَنَا  وَعَمْرَةُ  وُلِدْنَا فِي بَطْنٍ  » .","","Sunan Sa'id ibn Mansur 1376","","الشعبي عن سيار بن أبي سيار العنزي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2554","1377  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ، قَالَ :  نَا  أَبُو هَاشِمٍ ،  عَنْ  شُرَيْحٍ ، وَإِبْرَاهِيمَ ، أَنَّهُمَا قَالَا : «  نَفَقَةُ الْحَامِلِ الْمُتَوَفَّى عَنْهَا مِنْ جَمِيعِ الْمَالِ  » .","","Sunan Sa'id ibn Mansur 1377","","إبراهيم النخعي عن يحيى بن دينار الرماني عن حماد بن زيد عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2555","1378  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : «  نَفَقَتُهَا مِنْ نَصِيبِهَا  » .         [6/368]","","Sunan Sa'id ibn Mansur 1378","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن حماد بن زيد عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2556","1379  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ، قَالَ :  حَدَّثَنِي  عَلِيُّ بْنُ الْحَكَمِ ، وَكَثِيرٌ ،  عَنْ  عَطَاءٍ ، أَنَّهُ قَالَ : «  مِنْ نَصِيبِهَا  » .","","Sunan Sa'id ibn Mansur 1379","","عطاء بن أبي رباح عن كثير بن شنظير المازني عن حماد بن زيد عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2557","1380  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : «  لَيْسَ لِلْمُتَوَفَّى عَنْهَا زَوْجُهَا نَفَقَةُ الْحَامِلِ  » قَالَ سَعِيدٌ :  وَهُوَ الْمَأْخُوذُ بِهِ  .","","Sunan Sa'id ibn Mansur 1380","","عبد الله بن عباس عن عطاء بن أبي رباح عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2558","1381  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّهُ كَانَ يَقُولُ فِي الْمُتَوَفَّى عَنْهَا زَوْجُهَا وَهِيَ حَامِلٌ : « إِنَّ لَهَا النَّفَقَةَ  مِنْ جَمِيعِ الْمَالِ حَتَّى تَضَعَ  » .","","Sunan Sa'id ibn Mansur 1381","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2559","1382  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ، وَإِبْرَاهِيمَ ، أَنَّهُمَا كَانَ يَقُولَانِ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1382","","الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2560","1383  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَشْعَثُ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  شُرَيْحٍ ، أَنَّهُ كَانَ يَقُولُ : «  لَهَا النَّفَقَةُ مِنْ جَمِيعِ الْمَالِ حَتَّى تَضَعَ  » .","","Sunan Sa'id ibn Mansur 1383","","شريح بن الحارث الكندي عن الشعبي عن أشعث بن سوار عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2561","1384  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  ابْنُ أَبِي لَيْلَى ، وَأَشْعَثُ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّهُ كَانَ يَقُولُ : «  لَهَا النَّفَقَةُ مِنْ جَمِيعِ الْمَالِ حَتَّى تَضَعَ مَا فِي بَطْنِهَا  » .","","Sunan Sa'id ibn Mansur 1384","","عبد الله بن مسعود عن الشعبي عن أشعث بن سوار عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2562","1385  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حَجَّاجٌ ،  عَنْ  عَطَاءٍ ،  عَنِ         [6/369]      ابْنِ عَبَّاسٍ ، قَالَ : «  لَا نَفَقَةَ لَهَا إِلَّا مِنْ نَصِيبَهَا  » .","","Sunan Sa'id ibn Mansur 1385","","عبد الله بن عباس عن عطاء بن أبي رباح عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2563","1386  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَخْبَرَنِي  مَنْ  سَمِعَ  الْحَكَمَ ،  يُحَدِّثُ  عَنْ  أَبِي صَادِقٍ ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ أَنَّهُ كَانَ يَقُولُ : «  لَهَا النَّفَقَةُ مِنْ جَمِيعِ الْمَالِ  » .","","Sunan Sa'id ibn Mansur 1386","","علي بن أبي طالب عن أبو صادق الأزدي عن الحكم بن عتيبة الكندي عن من عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2564","1387  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  نَفَقَتُهَا مِنْ نَصِيبِهَا  » .","","Sunan Sa'id ibn Mansur 1387","","الحسن البصري عن يونس بن يزيدالأيلي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2565","1388  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  ابْنُ أَبِي لَيْلَى ، وَأَشْعَثُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ : «  لَا نَفَقَةَ لَهَا  » .","","Sunan Sa'id ibn Mansur 1388","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن أشعث بن سوار عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2566","1389  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عُبَيْدَةُ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّهُ كَانَ يَقُولُ فِي  الْمُطَلَّقَةِ ثَلَاثًا ،  وَالْمُخْتَلِعَةِ  ، وَالْمُتَوَفَّى عَنْهَا وَهِيَ حَامِلٌ : « إِنَّ لَهُنَّ السُّكْنَى وَالنَّفَقَةَ  حَتَّى تَنْقَضِيَ الْعِدَّةُ  » .","","Sunan Sa'id ibn Mansur 1389","","إبراهيم النخعي عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2567","1390  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَخْبَرَنِي  مَنْ ،  سَمِعَ  الْحَكَمَ ،  يُحَدِّثُ عَنْ  إِبْرَاهِيمَ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1390","","إبراهيم النخعي عن الحكم بن عتيبة الكندي عن من عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2568","1391  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو شِهَابٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  فِي امْرَأَةٍ بَلَغَهَا أَنَّ زَوْجَهَا مَاتَ ، وَقَدْ أَنْفَقَتْ مَالَهُ  قَالَ : « يُحْسَبُ         [6/370]      مَا أَنْفَقَتْ مِنْ يَوْمِ مَاتَ زَوْجُهَا ، وَيُجْعَلُ مِنْ نَصِيبِهَا  » .","","Sunan Sa'id ibn Mansur 1391","","الشعبي عن إسماعيل بن أبي خالد عن عبد ربه بن نافع الحناط عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2569","1392  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  أَنَّهُ كَانَ يَقُولُ فِي  أُمِّ الْوَلَدِ إِذَا مَاتَ عَنْهَا وَهِيَ حَامِلٌ : « إِنْ وَلَدَتْهُ حَيًّا فَنَفَقَتُهَا مِنْ نَصِيبِهِ  ، وَإِنْ كَانَ مَيِّتًا فَمِنْ جَمِيعِ الْمَالِ  » .","","Sunan Sa'id ibn Mansur 1392","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2570","1393  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  ابْنِ سِيرِينَ ، قَالَ : كَانَ يَقُولُ : «  يُنْفَقُ عَلَيْهَا مِنْ جَمِيعِ الْمَالِ  . قَالَ : كَانَ ذَلِكَ رَأْيَهُ ، حَتَّى وَلِيَ تَرِكَةَ ابْنِ أَخٍ لَهُ ، تَرَكَ أُمَّ وَلَدٍ لَهُ وَهِيَ حَامِلٌ ، فَكَرِهَ أَنْ يَعْمَلَ فِيهَا بِرَأْيِهِ ، فَأَرْسَلَ إِلَى عَبْدِ الْمَلِكِ بْنِ يَعْلَى قَاضِي  الْبَصْرَةِ  ، فَسَأَلَهُ عَنْ ذَلِكَ ، فَقَالَ : لَا نَفَقَةَ لَهَا  » .","","Sunan Sa'id ibn Mansur 1393","","عبد الملك بن يعلى الليثي عن محمد بن سيرين عن يونس بن يزيدالأيلي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2571","1394  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنْ  مُحَمَّدِ بْنِ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  إِذَا طَلَّقَ الرَّجُلُ الْأَمَةَ وَهِيَ حَامِلٌ فَلَيْسَ لَهَا نَفَقَةٌ  ; لِأَنَّ وَلَدَهُ لِقَوْمٍ آخَرِينَ  » .","","Sunan Sa'id ibn Mansur 1394","","الشعبي عن محمد بن سالم الهمداني عن الفضيل بن عياض عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2572","1395  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  الشَّيْبَانِيُّ ،  عَنِ  الشَّعْبِيِّ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا كَانَتِ الْأَمَةُ تَحْتَ الْحُرِّ أَوِ الْعَبْدِ ، وَطَلَّقَهَا تَطْلِيقَتَيْنِ  وَهِيَ حَامِلٌ ،         [6/371]      فَعَلَى زَوْجِهَا النَّفَقَةُ وَالسُّكْنَى حَتَّى تَضَعَ حَمْلَهَا  » .","","Sunan Sa'id ibn Mansur 1395","","الشعبي عن سليمان بن فيروز الشيباني عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2573","1396  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا طَلَّقَهَا تَطْلِيقَتَيْنِ وَهِيَ حَامِلٌ فَعَلَيْهِ النَّفَقَةُ  ، حُرَّةً كَانَتْ أَوْ أَمَةً ، حُرًّا كَانَ زَوْجُهَا أَوْ عَبْدًا  » .","","Sunan Sa'id ibn Mansur 1396","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2574","1397  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، «  أَنَّهُ كَانَ يَرَى لِلْمَرْأَةِ النَّفَقَةَ عَلَى زَوْجِهَا حَتَّى يَدْخُلَ بِهَا  » .","","Sunan Sa'id ibn Mansur 1397","","الحسن البصري عن يونس بن يزيدالأيلي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2575","1398  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حُسَامُ بْنُ مِصَكٍّ ،  عَنْ  أَبِي مَعْشَرٍ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ كَانَ يَقُولُ : «  لَا نَفَقَةَ لَهَا إِلَّا أَنْ تَطْلُبَ  » .","","Sunan Sa'id ibn Mansur 1398","","إبراهيم النخعي عن زياد بن كليب عن حسام بن مصك الأزدي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2576","1399  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُطَرِّفٌ ،  عَنِ  الشَّعْبِيِّ ، أَنَّهُ كَانَ يَقُولُ : «  لَيْسَ لَهَا النَّفَقَةُ عَلَى زَوْجِهَا إِذَا كَانَ الْحَبْسُ مِنْ قِبَلِهَا  » .","","Sunan Sa'id ibn Mansur 1399","","الشعبي عن مطرف بن طريف عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2577","1400  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ، وَجَرِيرٌ ،  عَنْ  مُطَرِّفٍ ،  عَنِ  الشَّعْبِيِّ ، أَنَّهُ كَانَ يَقُولُ مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1400","","الشعبي عن مطرف بن طريف عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2578","1401  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  يُقْضَى لِلْمَرْأَةِ عَلَى زَوْجِهَا فِي قُوتِهَا نِصْفَ صَاعِ بُرٍّ كُلَّ يَوْمٍ  » .","","Sunan Sa'id ibn Mansur 1401","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2579","1402  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  فُرِضَ لِلْمُطَلَّقَةِ نِصْفُ صَاعٍ كُلَّ يَوْمٍ مِنْ  قَمْحٍ  » .         [6/372]","","Sunan Sa'id ibn Mansur 1402","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2580","1403  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنِ  الشَّعْبِيِّ ، «  أَنَّهُ قَضَى لِامْرَأَةٍ فِي قُوتِهَا بِخَمْسَةَ عَشَرَ صَاعًا بِالْحَجَّاجِيِّ  ، وَدِرْهَمَيْنِ لِدُهْنِهَا وَحَاجَتِهَا فِي كُلِّ شَهْرٍ  » .","","Sunan Sa'id ibn Mansur 1403","","الشعبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2581","1404  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو وَكِيعٍ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  عَيَّرْنَا صَاعَ عُمَرَ فَوَجَدْنَاهُ حَجَّاجِيًّا  . قَالَ سَعِيدٌ :  الْحَجَّاجِيُّ : مُدُّ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Sunan Sa'id ibn Mansur 1404","","عمر بن الخطاب عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن الجراح بن مليح الرؤاسي والد وكيع عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2582","1405  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنِ  الشَّعْبِيِّ ،  فِي امْرَأَةٍ أَضَرَّ بِهَا زَوْجُهَا ، «  فَفَرَضَ  لَهَا  الشَّعْبِيُّ  فِي كُلِّ شَهْرٍ خَمْسَةَ عَشَرَ صَاعًا وَدِرْهَمَيْنِ  » .","","Sunan Sa'id ibn Mansur 1405","","الشعبي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2583","1406  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  فِي الرَّجُلِ يَغِيبُ عَنِ امْرَأَتِهِ ، وَلَا يَبْعَثُ إِلَيْهَا بِنَفَقَةٍ  قَالَ : « تُغَذَّى عَلَى مَالِ زَوْجِهَا  » .","","Sunan Sa'id ibn Mansur 1406","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب ما جاء في نفقة الحامل"
"2584","بَابُ الْمَرْأَةِ تَسْأَلُ الزَّوْجَ الطَّلَاقَ .  1407  -  حَدَّثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ، قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  خَالِدٌ ،         [6/373]      عَنْ  أَبِي قِلَابَةَ ،  عَنْ  أَبِي أَسْمَاءَ – يَعْنِي الرَّحَبِيَّ -  عَنْ  ثَوْبَانَ ، مَوْلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  مَا مِنِ امْرَأَةٍ تَسْأَلُ زَوْجَهَا الطَّلَاقَ مِنْ غَيْرِ أَمْرٍ يَعْتَدِي بِهِ فَتُرِيحُ رِيحَ الْجَنَّةِ  » .","","Sunan Sa'id ibn Mansur 1407","","ثوبان بن بجدد مولى رسول الله عن عمرو بن مرثد الرحبي عن أبو قلابة الجرمي عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تسأل الزوج الطلاق"
"2585","1408  -  حَدَّثَنَا  أَبُو قُدَامَةَ ، قَالَ :  نَا  عَلِيُّ بْنُ الْأَحْوَلِ ،  أَنَّ  امْرَأَةً جَاءَتْ إِلَى الْحَسَنِ ، فَقَالَتْ : يَا  أَبَا سَعِيدٍ  ، إِنَّ زَوْجَهَا صَوَّامٌ قَوَّامٌ ، وَإِنَّهَا لَمْ تُحِبَّهُ ، أَفَتَخْتَلِعُ مِنْهُ ؟ قَالَ : لَا ، إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : «  الْمُنْتَزِعَاتُ  وَالْمُخْتَلِعَاتُ  هُنَّ الْمُنَافِقَاتُ  » . قَالَتْ : أَعِدْ عَلَيَّ ، فَأَعَادَ عَلَيْهَا الْحَدِيثَ ، قَالَتْ : وَاللهِ لِأَصْبِرَنَّ . فَلَمَّا انْصَرَفَتْ قَالَ  الْحَسَنُ  : مَا كُنْتُ أَرَى بَقِيَتِ امْرَأَةٌ تُصَبِّرُ نَفْسَهَا عَلَى مَكْرُوهٍ لِمَا بَلَغَهَا مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Sunan Sa'id ibn Mansur 1408","","الحسن البصري عن علي بن عبد الأعلى الثعلبي عن الحارث بن عبيد الإيادي عن سعيد بن منصور","باب المرأة تسأل الزوج الطلاق"
"2586","1409  -  حَدَّثَنَا  حَزْمُ بْنُ أَبِي حَزْمٍ ، قَالَ :  سَمِعْتُ  الْحَسَنَ ، يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  إِنَّ الْمُنْتَزِعَاتِ  وَالْمُخْتَلِعَاتِ  هُنَّ الْمُنَافِقَاتُ  » .","","Sunan Sa'id ibn Mansur 1409","","الحسن البصري عن حزم بن أبي حزم القطعي عن سعيد بن منصور","باب المرأة تسأل الزوج الطلاق"
"2587","1410  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  أَبِي بَكْرِ بْنِ أَبِي مَرْيَمَ  عَنِ  الْهَيْثَمِ بْنِ مَالِكٍ ،  أَنَّ  امْرَأَةً  أَتَتْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَشْكُو زَوْجَهَا ،         [6/374]      فَقَالَ : «  مَا تُرِيدِينَ ؟ أَتُرِيدِينَ أَنْ تَتَزَوَّجِي شَابًّا ذَا  جُمَّةٍ  فَيْنَانَةٍ  ، عَلَى كُلِّ  خَصْلَةٍ  مِنْهَا شَيْطَانٌ ، أَوْ تَخْتَلِعِي ; فَتَكُونِي عِنْدَ اللهِ أَنْتَنَ مِنْ  جِيفَةِ  حِمَارٍ  » ؟ .","","Sunan Sa'id ibn Mansur 1410","","الهيثم بن مالك الطائي عن أبو بكر الغساني عن عبد الله بن المبارك عن سعيد بن منصور","باب المرأة تسأل الزوج الطلاق"
"2588","1411  -  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  قَيْسِ بْنِ وَهْبٍ ، «  أَنَّ امْرَأَةً ، اخْتَلَعَتْ مِنْ زَوْجِهَا عَلَى مَا أَخَذَتْ مِنْهُ  وَدَخَلَتْ فِي شَيْءٍ مِنْ أَمْرِهِمْ ، فَأَجَازَ ذَلِكَ شُرَيْحٌ  » .","","Sunan Sa'id ibn Mansur 1411","","شريح بن الحارث الكندي عن قيس بن وهب الهمداني عن شريك بن عبد الله بن أبي نمر الكناني عن سعيد بن منصور","باب المرأة تسأل الزوج الطلاق"
"2589","1412  -  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  أَوِ الْحَسَنِ - شَكَّ حَمَّادٌ  -  أَنَّ بِنْتًا لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَاءَتْ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَشْكُو زَوْجَهَا ، فَقَالَ لَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  ارْجِعِي ، فَإِنِّي أَكْرَهُ لِلْمَرْأَةِ أَنْ تَجُرَّ ذَيْلَهَا تَشْكُو زَوْجَهَا  » .","","Sunan Sa'id ibn Mansur 1412","","الحسن البصري عن علي بن زيد بن جدعان عن حماد بن زيد عن سعيد بن منصور","باب المرأة تسأل الزوج الطلاق"
"2590","1413  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ ، «  أَنَّهُ كَانَ لَا يَرَى الْخُلْعَ دُونَ السُّلْطَانِ  » .","","Sunan Sa'id ibn Mansur 1413","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب المرأة تسأل الزوج الطلاق"
"2591","بَابُ مَا جَاءَ فِي الْخُلْعِ .  1414  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  لَا يَجُوزُ الْخُلْعُ إِلَّا عِنْدَ السُّلْطَانِ  » .","","Sunan Sa'id ibn Mansur 1414","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2592","1415  -  حَدَّثَنَا  هُشَيْمٌ ، قَالَ :  أَنَا  بَعْضُ أَصْحَابِنَا ،  عَنِ  الشَّعْبِيِّ ، «  هُمْ عَلَى         [6/375]      مَا اصْطَلَحُوا عَلَيْهِ  ، وَإِنْ كَانَ دُونَ السُّلْطَانِ فَهُوَ جَائِزٌ  » .","","Sunan Sa'id ibn Mansur 1415","","الشعبي عن بعض أصحاب هشيم بن بشير عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2593","1416  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : قِيلَ لَهُ : «  الْمَرْأَةُ إِذَا أَرَادَتْ أَنْ تَخْتَلِعَ مِنْ زَوْجِهَا تَقُولُ : لَا أَبَرُّ لَكَ قَسَمًا  ، وَلَا أُطِيعُ لَكَ أَمْرًا ، وَلَا أَغْتَسِلُ لَكَ مِنْ جَنَابَةٍ . فَقَالَ  الشَّعْبِيُّ  : الْمَرْأَةُ تَفْجُرُ ، فَمَا تَدَعُ  الْغُسْلَ  مِنَ الْجَنَابَةِ . كَأَنَّهُ كَرِهَ هَذَا الْقَوْلَ  » .","","Sunan Sa'id ibn Mansur 1416","","الشعبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2594","1417  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ، «  أَنَّ امْرَأَةً ، قَالَتْ لِزَوْجِهَا : لَا أَبَرُّ لَكَ قَسَمًا ، وَلَا أُطِيعُ لَكَ أَمْرًا  ، وَلَا أَغْتَسِلُ لَكَ مِنْ جَنَابَةٍ . فَقَالَ بِيَدِهِ : لَا أَفْعَلُ ، وَلَا أَفْعَلُ ، أَيُّمَا امْرَأَةٍ كَرِهَتْ زَوْجَهَا فَيَأْخُذُ مِنْهَا وَيُخَلِّي عَنْهَا  » .","","Sunan Sa'id ibn Mansur 1417","","الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2595","1418  -  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  عُمَرَ بْنِ قَيْسٍ الْمَاصِرِ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ، قَالَ :  كُنْتُ جَالِسًا عِنْدَ شُرَيْحٍ ، فَجَاءَهُ رَجُلٌ وَامْرَأَةٌ يَخْتَصِمَانِ إِلَيْهِ  ، فَجَعَلَ الرَّجُلُ يَقُولُ : « أَمَا وَاللهِ لَوْلَا مَالُكِ عِنْدِي لَطَلَّقْتُكِ . فَقَالَتِ الْمَرْأَةُ :         [6/376]      هُوَ لَكَ عَلَى أَنْ تُطَلِّقَنِي . فَقَالَ : أَنْتِ طَالِقٌ . فَقَالَتْ : زِدْنِي . قَالَ : أَنْتِ طَالِقٌ . قَالَتْ : زِدْنِي . قَالَ : أَنْتِ طَالِقٌ . فَقُلْتُ : مَا أَرَاكَ إِلَّا قَدْ خِبْتَ ،  بَانَتْ  مِنْكَ امْرَأَتُكَ وَغَرِمْتَ . قَالَ  شُرَيْحٌ  : دِينُ اللهِ إِذًا فِي يَدِكَ ، هُمَا عَلَى مَا اصْطَلَحَا عَلَيْهِ  » .","","Sunan Sa'id ibn Mansur 1418","","شريح بن الحارث الكندي عن الشعبي عن عمر بن قيس الماصر عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في الخلع"
"2596","1419  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ، «  أَنَّ امْرَأَةً قَالَتْ لِزَوْجِهَا : أَتْرُكُ لَكَ مَا عَلَيْكَ مِنْ صَدَاقِي عَلَى أَنْ تُطَلِّقَنِي . فَقَالَ : اشْهَدُوا  . فَقَالَتِ : اشْهَدُوا . قَالَ : فَأَنْتِ طَالِقٌ . قَالَتْ : لَا وَاللهِ ، حَتَّى تَمُرَّهُنَّ ثَلَاثًا . قَالَ : فَأَنْتِ طَالِقٌ ثَلَاثًا . قَالَتْ : قَدْ طَلَّقْتَنِي ، فَارْدُدْ عَلَيَّ مَالِي . فَاخْتَصَمَا إِلَى  شُرَيْحٍ  ، فَقَالَ جُلَسَاءُ  شُرَيْحٍ  : مَا نَرَى امْرَأَتَكَ إِلَّا قَدْ  بَانَتْ  مِنْكَ ، وَمَا نَرَاكَ إِلَّا قَدْ غَرِمْتَ مَالَهَا .  فَقَالَ  شُرَيْحٌ : أَوَتَرَوْنَ ذَلِكَ ؟ قَالُوا : نَعَمْ . قَالَ : إِنَّ الْإِسْلَامَ إِذًا أَضْيَقُ مِنْ حَدِّ السَّيْفِ . ثُمَّ قَالَ لِلرَّجُلِ : أَمَّا امْرَأَتُكَ فَلَا تَحِلُّ لَكَ حَتَّى تَنْكِحَ زَوْجًا غَيْرَكَ ، وَأَمَّا مَالُكَ فَلَكَ  » .","","Sunan Sa'id ibn Mansur 1419","","شريح بن الحارث الكندي عن الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2597","1420  -  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، «  فِي رَجُلٍ قَالَ لِامْرَأَتِهِ : قَدْ خَلَعْتُكِ ، وَلَمْ يَكُنْ خَلَعَهَا  ، فَقَالَ : قَدْ خَلَعَهَا الْآنَ » . وَقَالَ حَمَّادٌ : «  لَيْسَ فِي مَالِهَا شَيْءٌ  » .         [6/377]","","Sunan Sa'id ibn Mansur 1420","","","باب ما جاء في الخلع"
"2598","1421  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  إِذَا قَالَ الرَّجُلُ لِامْرَأَتِهِ : قَدْ خَلَعْتُكِ ، وَلَمْ يَكُنْ خَلَعَهَا ، فَقَدْ خَلَعَهَا الْآنَ  ، وَلَا شَيْءَ لَهُ  » .","","Sunan Sa'id ibn Mansur 1421","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2599","1422  -  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  كَانُوا يَكْرَهُونَ الْخُلْعَ  » .","","Sunan Sa'id ibn Mansur 1422","","إبراهيم النخعي عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في الخلع"
"2600","1423  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  ابْنُ أَبِي لَيْلَى ،  عَنِ  الْحَكَمِ بْنِ عُتَيْبَةَ ،  عَنْ  خَيْثَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ شِهَابٍ الْخَوْلَانِيِّ ،  أَنَّ امْرَأَةً اشْتَرَتْ مِنْ زَوْجِهَا تَطْلِيقَهُ بِأَلْفِ دِرْهَمٍ  ، فَرُفِعَ ذَلِكَ إِلَى عُمَرَ بْنِ الْخَطَّابِ فَأَجَازَهُ ،  وَقَالَ  : « هَذِهِ امْرَأَةٌ ابْتَاعَتْ نَفْسَهَا مِنْ زَوْجِهَا ابْتِيَاعًا  » .","","Sunan Sa'id ibn Mansur 1423","","عمر بن الخطاب عن عبد الله بن شهاب الخولاني عن خيثمة بن عبد الرحمن الجعفي عن الحكم بن عتيبة الكندي عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2601","1424  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : كَانَ يُقَالُ : «  الْخُلْعُ مَا دُونَ  عِقَاصِ  الرَّأْسِ  ، وَقَدْ تَفْتَدِي الْمَرْأَةُ بِبَعْضِ مَالِهَا  » .","","Sunan Sa'id ibn Mansur 1424","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2602","1425  -  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ : «  يَأْخُذُ مِنَ  الْمُخْتَلِعَةِ  حَتَّى  عِقَاصَهَا  » .         [6/378]","","Sunan Sa'id ibn Mansur 1425","","مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الخلع"
"2603","1426  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، «  أَنَّهُ كَانَ لَا يَرَى بَأْسًا أَنْ يَأْخُذَ مِنْهَا أَكْثَرَ مِمَّا أَعْطَاهَا إِذَا خَلَعَهَا  » .","","Sunan Sa'id ibn Mansur 1426","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2604","1427  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  حُمَيْدٌ الطَّوِيلُ ،  عَنْ  جَابِرِ بْنِ حَيْوَةَ  ،  عَنْ  قَبِيصَةَ بْنِ ذُؤَيْبٍ ،  أَنَّهُ كَانَ لَا يَرَى بَأْسًا أَنْ يَأْخُذَ مِنْهَا أَكْثَرَ مِمَّا أَعْطَاهَا  . قَالَ : وَيَتْلُو هَذِهِ الْآيَةَ :         {      فَلا جُنَاحَ عَلَيْهِمَا فِيمَا افْتَدَتْ بِهِ         }      .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : كذا في ص ، وهو خطأ فاحش من أحد النساخ ، والصواب : رجاء ، ورجاء بن حيوة معروف بالرواية عن قبيصة ، وعنه حميد الطويل.","","Sunan Sa'id ibn Mansur 1427","","قبيصة بن ذؤيب الخزاعي عن رجاء بن حيوة عن حميد الطويل عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2605","1428  -  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  عَطَاءٍ ،  يَبْلُغُ بِهِ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : «  لَا يَأْخُذُ مِنَ  الْمُخْتَلِعَةِ  أَكْثَرَ مِمَّا أَعْطَاهَا  » .","","Sunan Sa'id ibn Mansur 1428","","عطاء بن أبي رباح عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الخلع"
"2606","1429  -  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنِي  رَجُلٌ ، مُنْذُ أَكْثَرَ مِنْ خَمْسِينَ سَنَةً سَمِعْتُهُ  يُحَدِّثُ عَنْ  أَبِيهِ  ،  عَنْ  عَلِيٍّ ، قَالَ : «  لَا يَأْخُذُ مِنَ  الْمُخْتَلِعَةِ  أَكْثَرَ مِمَّا أَعْطَاهَا  » .","","Sunan Sa'id ibn Mansur 1429","","علي بن أبي طالب عن أبيه عن رجل عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الخلع"
"2607","1430  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عَمْرَةَ بِنْتِ عَبْدِ الرَّحْمَنِ ،  أَنَّ  حَبِيبَةَ بِنْتَ سَهْلٍ ، كَانَتْ تَحْتَ  ثَابِتِ بْنِ قَيْسِ بْنِ شَمَّاسٍ  ، وَكَانَ فِي  خُلُقِهِ  مِنْهُ إِلَيْهَا ،         [6/379]      فَجَاءَتْ  بِالْغَلَسِ  حَتَّى قَعَدَتْ عَلَى بَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا خَرَجَ رَسُولُ اللهِ قَالَ : «  مَنْ هَذِهِ » ؟ قَالَتْ : أَنَا  حَبِيبَةُ بِنْتُ سَهْلٍ  . قَالَتْ : لَا أَنَا وَلَا  ثَابِتٌ  .  قَالَ : « إِنَّ  ثَابِتًا  لَيُثْنَى عَلَيْهِ » ؟ قَالَتْ : وَهُوَ كَذَلِكَ ، وَلَكِنْ لَا أَنَا وَلَا هُوَ . فَلَمْ يَكُ شَيْءٌ حَتَّى جَاءَ  ثَابِتٌ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : « إِنَّهُ يَأْخُذُ  حَدِيقَتَهُ  » . قَالَتْ : لِيَأْخُذْهَا . وَكَانَ أَصْدَقَهَا إِيَّاهَا ، فَأَخَذَ  حَدِيقَتَهُ  ، وَجَلَسَتْ عِنْدَ أَهْلِهَا  .","","Sunan Sa'id ibn Mansur 1430","","حبيبة بنت سهل  بن ثعلبة النجارية عن عمرة بنت عبد الرحمن الأنصارية عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2608","1431  -  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  عَمْرَةَ بِنْتِ عَبْدِ الرَّحْمَنِ ، قَالَتْ :  جَاءَتْ حَبِيبَةُ بِنْتُ سَهْلٍ - امْرَأَةٌ مِنَ  الْأَنْصَارِ  ، وَكَانَتْ تَحْتَ  ثَابِتِ بْنِ قَيْسِ بْنِ شَمَّاسٍ  - فَقَالَتْ : يَا رَسُولَ اللهِ ، لَا أَنَا وَلَا  ثَابِتٌ  . تَشْكُو شَيْئًا مِنْهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  خُذْ مِنْهَا  حَدِيقَتَهَا  » . فَأَخَذَ مِنْهَا ، وَقَعَدَتْ فِي بَيْتِهَا  .","","Sunan Sa'id ibn Mansur 1431","","حبيبة بنت سهل  بن ثعلبة النجارية عن عمرة بنت عبد الرحمن الأنصارية عن يحيى بن سعيد الأنصاري عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الخلع"
"2609","1432  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  أَيُّوبُ بْنُ أَبِي مِسْكِينٍ ،  عَنِ  الْحَكَمِ بْنِ عُتَيْبَةَ ، قَالَ :  جَاءَتِ امْرَأَةٌ إِلَى عُمَرَ بْنِ الْخَطَّابِ قَدْ نَشَزَتْ عَلَى زَوْجِهَا ، فَوَعَظَهَا وَذَكَّرَهَا  ، وَأَمَرَهَا بِطَاعَةِ زَوْجِهَا ، فَقَالَتْ : لَئِنْ رَدَدْتَنِي إِلَيْهِ لَأَقْتُلَنَّ نَفْسِي . فَأَمَرَ بِهَا إِلَى إِسْطَبْلِ الدَّوَابِّ ، فَمَكَثَتْ فِيهِ ثَلَاثًا ، ثُمَّ أَرْسَلَ إِلَيْهَا : كَيْفَ وَجَدْتِ مَكَانَكِ الَّذِي كُنْتِ بِهِ ؟ قَالَتْ : مَا وَجَدْتُ رَاحَةً مُنْذُ كُنْتُ عِنْدَهُ إِلَّا فِي هَذِهِ الثَّلَاثِ لَيَالِي . فَقَالَ لِزَوْجِهَا :  اخْلَعْهَا  بِدُونِ  عِقَاصِ  رَأْسِهَا ; فَلَا خَيْرَ لَكَ فِيهَا  .         [6/380]","","Sunan Sa'id ibn Mansur 1432","","عمر بن الخطاب عن الحكم بن عتيبة الكندي عن أيوب بن أبي مسكين عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2610","1433  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  جُوَيْبِرٌ ،  عَنِ  الضَّحَّاكِ ، قَالَ :  جَاءَتِ امْرَأَةٌ إِلَى عَلِيِّ بْنِ أَبِي طَالِبٍ ، فَقَالَتْ : « فَرِّقْ بَيْنِي وَبَيْنَ زَوْجِي  .  فَقَالَ  : مَا أَمْلِكُ ذَاكَ ; أَعْطَاكِ مَالَهُ ، وَاسْتَحَلَّكِ بِكِتَابِ اللهِ . فَقَالَتْ : وَاللهِ لَتُفَرِّقَنَّ بَيْنِي وَبَيْنَهُ ، وَإِلَّا قَتَلْتُهُ . قَالَ : اللهِ . قَالَتِ : اللهِ . قَالَ : اللهِ . قَالَتِ : اللهِ . قَالَ لِزَوْجِهَا :  اخْلَعْهَا  بِمَا دُونَ  عِقَاصِ  رَأْسِهَا ; فَلَا خَيْرَ لَكَ فِيهَا  » . قَالَ جُوَيْبِرٌ :  فَقُلْتُ لِلضَّحَّاكِ :  أَيَأْخُذُ مِنْهَا أَكْثَرَ مِمَّا أَعْطَاهَا ؟ قَالَ : نَعَمْ  ، وَإِنْ أَعْطَتْهُ مِائَةَ أَلْفٍ ، إِنَّمَا هِيَ امْرَأَةٌ اشْتَرَتْ نَفْسَهَا شِرًى  .","","Sunan Sa'id ibn Mansur 1433","","علي بن أبي طالب عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2611","1434  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  إِسْمَاعِيلُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ ، «  أَنَّهُ كَانَ يَكْرَهُ أَنْ يَأْخُذَ مِنْهَا أَكْثَرَ مِمَّا أَعْطَاهَا  » .","","Sunan Sa'id ibn Mansur 1434","","الشعبي عن إسماعيل بن سالم الأسدي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2612","1435  -  حَدَّثَنَا  سَعِيدٌ ،  أَنَا  عَبْدُ الْمَلِكِ ،  عَنْ  عَطَاءٍ ، «  أَنَّهُ كَانَ يَكْرَهُ أَنْ يَأْخُذَ مِنْهَا أَكْثَرَ مِمَّا أَعْطَاهَا  » .","","Sunan Sa'id ibn Mansur 1435","","عطاء بن أبي رباح عن ابن جريج عن سعيد بن منصور","باب ما جاء في الخلع"
"2613","1436  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  إِسْمَاعِيلُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  إِذَا كَانَ الدَّرْؤُ مِنْ قِبَلِهِ لَمْ يَحِلَّ لَهُ أَنْ يَأْخُذَ مِنْهَا شَيْئًا  ، وَإِنْ كَانَ مَنْ قِبَلِهَا فَلْيَأْخُذْ  » .","","Sunan Sa'id ibn Mansur 1436","","الشعبي عن إسماعيل بن سالم الأسدي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2614","1437  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  عُبَيْدَةُ ،  عَنِ  الشَّعْبِيِّ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا كَانَ الدَّرْؤُ مِنْ قِبَلِهِ فَمَا أَخَذَ مِنْهَا كَالْمَيْتَةِ  ، وَالدَّمِ ، وَلَحْمِ الْخِنْزِيزِ  » .         [6/381]","","Sunan Sa'id ibn Mansur 1437","","الشعبي عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2615","1438  -  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي يَزِيدَ الْمَدَنِيِّ ، قَالَ :  قَالَ  عُمَرُ : «  اخْلَعْهَا  وَلَوْ فِي  قُرْطِهَا  » .","","Sunan Sa'id ibn Mansur 1438","","عمر بن الخطاب عن أبو يزيد المديني عن أيوب السختياني عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الخلع"
"2616","1439  -  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  لَا تَحِلُّ الْفِدْيَةُ حَتَّى تَعْصِيَهُ وَلَا تُطِيعَهُ ، وَتُحَنِّثَهُ  » .","","Sunan Sa'id ibn Mansur 1439","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في الخلع"
"2617","1440  -  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ، قَالَ :  «  لَا يَصْلُحُ الْخُلْعُ حَتَّى يَجِيءَ مِنْ قِبَلِ الْمَرْأَةِ  » . وَقَالَ  سُفْيَانُ  مَرَّةً أُخْرَى : « لَا بَأْسَ بِالْخُلْعِ إِذَا كَانَ مِنْ قِبَلِ الْمَرْأَةِ »  .","","Sunan Sa'id ibn Mansur 1440","","جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الخلع"
"2618","1441  -  حَدَّثَنَا  عَتَّابُ بْنُ بَشِيرٍ ،  أَنَا  خُصَيْفٌ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  فِي الْمُفْتَدِيَةِ قَالَ : « مَا أَرَى أَنْ يَأْخُذَ مَالَهَا كُلَّهُ  ، لَكِنْ لِيَدَعْ لَهَا  » .","","Sunan Sa'id ibn Mansur 1441","","سعيد بن المسيب عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2619","1442  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، قَالَ : «  إِذَا نَشَزَتِ الْمَرْأَةُ عَلَى زَوْجِهَا ، وَعَظَهَا وَذَكَّرَهَا  ، فَإِنْ رَجَعَتْ إِلَى مَا يُحِبُّ فَذَاكَ ، وَإِنْ لَمْ تَفْعَلْ هَجَرَهَا فِي الْمَضْجَعِ ، فَإِنْ رَجَعَتْ فَذَاكَ ، وَإِنْ لَمْ تَفْعَلْ ضَرَبَهَا ضَرْبًا غَيْرَ  مُبَرِّحٍ  فَإِنْ رَجَعَتْ إِلَى مَا يُحِبُّ فَذَاكَ ، وَإِلَّا فَقَدْ حَلَّ لَهُ أَنْ يَأْخُذَ مِنْهَا وَيُخَلِّيَ عَنْهَا  » .","","Sunan Sa'id ibn Mansur 1442","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2620","1443  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  أَنَّهُ كَانَ يَقُولُ فِي  الْمُخْتَلِعَةِ  : « لَا نَفَقَةَ لَهَا إِلَّا أَنْ يُشْتَرَطَ ذَلِكَ عَلَى زَوْجِهَا  » .         [6/382]","","Sunan Sa'id ibn Mansur 1443","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2621","1444  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّهُ سُئِلَ عَنِ  الْمُخْتَلِعَةِ  ، لَهَا نَفَقَةٌ ؟  فَقَالَ : « كَيْفَ يَكُونُ لَهَا نَفَقَةٌ وَأَنْتُمْ تَأْخُذُونَ مَالَهَا  » .","","Sunan Sa'id ibn Mansur 1444","","الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2622","1445  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  أَصْحَابِهِ ،  أَنَّهُمْ كَانُوا يَقُولُونَ فِي  الْمُخْتَلِعَةِ  الْحَامِلِ : « إِنَّ لَهَا النَّفَقَةَ  إِلَّا أَنْ يَتَبَرَّأَ مِنْهَا زَوْجُهَا  » .","","Sunan Sa'id ibn Mansur 1445","","أصحاب المغيرة بن مقسم الضبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2623","1446  -  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جُمْهَانَ الْأَسْلَمِيِّ ،  أَنَّ  أُمَّ بَكْرٍ  ، اخْتَلَعَتْ مِنْ زَوْجِهَا عَلَى عَهْدِ عُثْمَانَ فَقَالَ : «  هِيَ تَطْلِيقَةٌ إِلَّا أَنْ يَكُونَ سَمَّيَا شَيْئًا فَهُوَ عَلَى مَا سَمَّيَا  » .","","Sunan Sa'id ibn Mansur 1446","","عثمان بن عفان عن جمهان الجذامي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الخلع"
"2624","1447  -  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  نَا  هِشَامُ بْنُ عُرْوَةَ ، قَالَ :  خَلَعَ  جُمْهَانُ الْأَسْلَمِيُّ  امْرَأَتَهُ ثُمَّ نَدِمَ وَنَدِمَتْ  ، فَأَتَيَا عُثْمَانَ بْنَ عَفَّانَ ، فَذَكَرَا ذَلِكَ لَهُ ،  فَقَالَ  : « هِيَ تَطْلِيقَةٌ إِلَّا أَنْ تَكُونَ سَمَّيْتَ شَيْئًا فَهُوَ عَلَى مَا سَمَّيْتَ ، فَكَانَ أَبِي يَقُولُ : الْخُلْعُ تَطْلِيقَةٌ بَائِنَةٌ ، وَتَعْتَدُّ ثَلَاثَ حِيَضٍ ، وَصَاحِبُهَا أَوْلَى بِالْخِطْبَةِ فِي الْعِدَّةِ  » .","","Sunan Sa'id ibn Mansur 1447","","عثمان بن عفان عن هشام بن عروة بن الزبير عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في الخلع"
"2625","1448  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا قَبِلَ الْفِدَاءَ فَهِيَ تَطْلِيقَةٌ  ، وَيَخْطُبُهَا فِي الْعِدَّةِ إِنْ شَاءَ وَشَاءَتْ  » .         [6/383]","","Sunan Sa'id ibn Mansur 1448","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2626","1449  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنِ  الشَّعْبِيِّ أَنَّهُ كَانَ يَقُولُ : «  مَنْ قَبِلَ مَالًا عَلَى الطَّلَاقِ ، فَالطَّلَاقُ بَائِنٌ  لَا رَجْعَةَ لَهُ  » .","","Sunan Sa'id ibn Mansur 1449","","الشعبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2627","1450  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  حَجَّاجٌ ،  عَنْ  حُصَيْنٍ الْحَارِثِيِّ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ قَالَ : «  مَنْ قَبِلَ مَالًا عَلَى طَلَاقٍ فَهُوَ طَلَاقٌ بَائِنٌ  لَا رَجْعَةَ لَهُ  » .","","Sunan Sa'id ibn Mansur 1450","","علي بن أبي طالب عن الحارث الأعور عن الشعبي عن حصين بن عبد الرحمن الحارثي عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2628","1451  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  ابْنُ أَبِي لَيْلَى ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، «  أَنَّهُ كَانَ لَا يَرَى طَلَاقًا بَائِنًا إِلَّا خُلْعًا أَوْ ثَلَاثًا  » .","","Sunan Sa'id ibn Mansur 1451","","عبد الله بن مسعود عن إبراهيم النخعي عن طلحة بن مصرف الهمداني عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2629","1452  -  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  نَا  ابْنُ أَبِي لَيْلَى ،  عَنْ  طَلْحَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  ابْنِ مَسْعُودٍ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1452","","عبد الله بن مسعود عن إبراهيم النخعي عن طلحة بن مصرف الهمداني عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الخلع"
"2630","1453  -  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ «  أَنَّهُ         [6/384]      جَمَعَ بَيْنَ رَجُلٍ وَامْرَأَتِهِ بَعْدَ تَطْلِيقَتَيْنِ وَخُلْعٍ  » .","","Sunan Sa'id ibn Mansur 1453","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في الخلع"
"2631","1454  -  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  عِكْرِمَةَ ، قَالَ : «  كُلُّ شَيْءٍ أَجَازَهُ الْمَالُ فَلَيْسَ بِطَلَاقٍ  » .","","Sunan Sa'id ibn Mansur 1454","","عكرمة مولى ابن عباس عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الخلع"
"2632","1455  -  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ، قَالَ :  سَمِعْتُ  إِبْرَاهِيمَ بْنَ سَعْدٍ ،  سَأَلَ  ابْنَ عَبَّاسٍ  عَنْ رَجُلٍ ، طَلَّقَ امْرَأَتَهُ تَطْلِيقَتَيْنِ ثُمَّ اخْتَلَعَتْ مِنْهُ  فَقَالَ : « لِيَنْكِحْهَا إِنْ شَاءَ ، إِنَّمَا ذَكَرَ اللهُ الطَّلَاقَ فِي أَوَّلِ الْآيَةِ وَآخِرِهَا ، وَالْخُلْعُ فِيمَا بَيْنَ ذَلِكَ  » .","","Sunan Sa'id ibn Mansur 1455","","عبد الله بن عباس عن إبراهيم بن سعد عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الخلع"
"2633","1456  -  حَدَّثَنَا  خَالِدٌ ،  عَنْ  إِسْمَاعِيلَ بْنِ سُمَيْعٍ ،  عَنْ  أَبِي رَزِينٍ ، قَالَ : «  أَتَى رَجُلٌ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  إِنِّي سَمِعْتُ اللهَ يَقُولُ         {      الطَّلاقُ مَرَّتَانِ         }      فَأَيْنَ الثَّالِثَةُ قَالَ : إِمْسَاكٌ بِمَعْرُوفٍ أَوْ تَسْرِيحٌ بِإِحْسَانٍ  .","","Sunan Sa'id ibn Mansur 1456","","مسعود بن مالك الأسدي عن إسماعيل بن سميع عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في الخلع"
"2634","1457  -  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ سُمَيْعٍ ،  عَنْ  أَبِي رَزِينٍ ،  أَنَّ رَجُلًا ، قَالَ :  أَلَا يَا رَسُولَ اللهِ الطَّلَاقُ مَرَّتَانِ ، فَأَيْنَ الثَّالِثَةُ ؟ قَالَ : "" إِمْسَاكٌ بِمَعْرُوفٍ أَوْ تَسْرِيحٌ بِإِحْسَانٍ  "" .","","Sunan Sa'id ibn Mansur 1457","","مسعود بن مالك الأسدي عن إسماعيل بن سميع عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في الخلع"
"2635","[6/385]      بَابُ مَا جَاءَ فِي الْإِيلَاءِ .  1458  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ  فِي رَجُلٍ آلَى مِنِ امْرَأَتِهِ فَمَضَتْ أَرْبَعَةُ أَشْهُرٍ ، وَاخْتَلَعَتْ مِنْهُ  فَتَزَوَّجَهَا فِي عِدَّتِهَا فَطَلَّقَهَا قَبْلَ أَنْ يَدْخُلَ بِهَا قَالَ : كَانَ  إِبْرَاهِيمُ  يَقُولُ : « لَهَا الصَّدَاقُ تَامًّا وَيَسْتَقْبِلُ الْعِدَّةَ ، وَكَانَ الْحَسَنُ وَعَامِرٌ يَقُولَانِ : لَهَا نِصْفُ الصَّدَاقِ وَتُكْمِلُ مَا بَقِيَ مِنْ عِدَّتِهَا ، فَقُلْتُ  لِمَنْصُورٍ  : أَيُّ الْقَوْلَيْنِ أَحَبُّ إِلَيْكَ ؟ قَالَ : قَوْلُ  الْحَسَنِ  وَعَامِرٍ  »  .","","Sunan Sa'id ibn Mansur 1458","","إبراهيم النخعي عن منصور بن المعتمر عن حماد بن زيد عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2636","1459  -  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَبِي عَبْدِ اللهِ الشَّقَرِيِّ ،  عَنْ  إِبْرَاهِيمَ ، «  فِي الْمُوَلَّى عَنْهَا وَالْمُطَلَّقَةِ إِذَا خَطَبَهَا زَوْجُهَا فِي عِدَّتِهَا ثُمَّ طَلَّقَهَا مِنْ قَبْلِ أَنْ يَدْخُلَ بِهَا  ، فَلَهَا الْمَهْرُ كَامِلًا  وَبَانَتِ  الْعِدَّةُ  » .","","Sunan Sa'id ibn Mansur 1459","","إبراهيم النخعي عن سلمة بن تمام الشقري عن حماد بن زيد عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2637","1460  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا تَزَوَّجَ امْرَأَتَهُ وَهُوَ فِي  عِدَّةٍ  مِنَ الْخُلْعِ أَوْ إِيلَاءٍ فَطَلَّقَهَا قَبْلَ أَنْ يَدْخُلَ بِهَا  فَلَهَا الصَّدَاقُ تَامًّا ، وَلَهَا الْعِدَّةُ تَامَّةً  » .","","Sunan Sa'id ibn Mansur 1460","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2638","1461  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  عَبْدُ اللهِ بْنُ سَبْرَةَ الْهَمْدَانِيُّ ،  عَنِ  الشَّعْبِيِّ ، قَالَ مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1461","","الشعبي عن عبد الله بن سبرة الكوفي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2639","1462  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  حَجَّاجٌ ، وَمُحَمَّدُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ ، مِثْلَ ذَلِكَ .         [6/386]","","Sunan Sa'id ibn Mansur 1462","","الشعبي عن محمد بن سالم الهمداني عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2640","1463  -  حَدَّثَنَا  حَجَّاجٌ ،  عَنْ  عَطَاءٍ ، قَالَ : «  لَهَا بَقِيَّةُ الصَّدَاقِ وَتُكْمِلُ مَا بَقِيَ مِنْ عِدَّتِهَا  » .","","Sunan Sa'id ibn Mansur 1463","","عطاء بن أبي رباح عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2641","1464  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  يُونُسُ ، وَمَنْصُورٌ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ مِثْلَ مَا قَالَ  عَطَاءٌ  .","","Sunan Sa'id ibn Mansur 1464","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2642","1465  -  حَدَّثَنَا  عَتَّابُ بْنُ بَشِيرٍ ،  نَا  خُصَيْفٌ ،  عَنِ  الْحَكَمِ ، وَزِيَادِ بْنِ أَبِي مَرْيَمَ ، قَالَا : «  إِذَا طَلَّقَ الرَّجُلُ امْرَأَتَهُ طَلَاقًا بَائِنًا ، وَقَدْ كَانَ دَخَلَ بِهَا فَتَزَوَّجَهَا فِي عِدَّتِهَا مِنَ الطَّلَاقِ  ، ثُمَّ طَلَّقَهَا قَبْلَ أَنْ يَدْخُلَ بِهَا كَانَ لَهَا الْمَهْرُ كَامِلًا ، وَإِنْ تَزَوَّجَهَا بَعْدَ انْقِضَاءِ عِدَّتِهَا فَلَهَا نِصْفُ الْمَهْرِ  » .","","Sunan Sa'id ibn Mansur 1465","","زياد بن أبي مريم الجزري عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2643","1466  -  حَدَّثَنَا  عَتَّابٌ ،  عَنْ  خُصَيْفٍ ، قَالَ : كَانَ مَيْمُونُ بْنُ مِهْرَانَ  يَقُولُ  : «  لَهَا نِصْفُ الْمَهْرِ تَزَوَّجَهَا فِي الْعِدَّةِ أَوْ بَعْدَ الْعِدَّةِ  » .","","Sunan Sa'id ibn Mansur 1466","","ميمون بن مهران الرقي عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2644","1467  -  حَدَّثَنَا  فَرَجُ بْنُ فَضَالَةَ ،  حَدَّثَنِي  عَلِيُّ بْنُ أَبِي طَلْحَةَ ،  عَنِ  ابْنِ  عَوْنٍ الْأَعْوَرِ ،  عَنْ  أَبِي الدَّرْدَاءِ ، قَالَ : «  الْمُخْتَلِعَةُ  يَلْحَقُهَا الطَّلَاقُ مَا دَامَتْ فِي الْعِدَّةِ  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وعند ابن أبي شيبة في مصنفه : ( أبي ) وهو الصواب ، وينظر مصادر الترجمة ، والله أعلم.","","Sunan Sa'id ibn Mansur 1467","","أبو الدرداء عن عبد الله بن أبي عبد الله الشامي الأعور عن علي بن أبي طلحة العباسي عن فرج بن فضالة بن النعمان التنوخي عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2645","1468  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنِ  الْعَلَاءِ بْنِ عُتْبَةَ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ ، يَرْفَعُ الْحَدِيثَ مِثْلَ ذَلِكَ .         [6/387]","","Sunan Sa'id ibn Mansur 1468","","أبو الدرداء عن عبد الله بن أبي عبد الله الشامي الأعور عن علي بن أبي طلحة العباسي عن العلاء بن عتبة اليحصبي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2646","1468  -  حَدَّثَنَا  سَعِيدٌ ،  عَنْ  عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ الْبَصْرِيِّ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  كُلُّ امْرَأَةٍ مَاءُ الرَّجُلِ فِي رَحِمِهَا فَهِيَ تَعْتَدُّ مِنْهُ  ، وَلَا تَعْتَدُّ مِنْ غَيْرِهِ وَهِيَ يَحِلُّ لَهُ أَنْ يَنْكِحَهَا وَلَا يَحِلُّ لِغَيْرِهِ أَنْ يَنْكِحَهَا ، وَوَقَعَ عَلَيْهَا الطَّلَاقُ  »  .","","Sunan Sa'id ibn Mansur 1468","","إبراهيم النخعي عن عبد الكريم بن أبي المخارق عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2647","1469  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا طَلَّقَ  الْمُخْتَلِعَةَ  فِي الْعِدَّةِ كَانَ عَلَيْهَا الطَّلَاقُ  » .","","Sunan Sa'id ibn Mansur 1469","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2648","1470  -  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  بَيَانٍ ،  عَنِ  الشَّعْبِيِّ ، وَمُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  إِذَا طُلِّقَتِ  الْمُخْتَلِعَةُ  فِي الْعِدَّةِ حُسِبَ عَلَيْهَا الطَّلَاقُ  » .","","Sunan Sa'id ibn Mansur 1470","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2649","1471  -  حَدَّثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  مَنْصُورٍ ، وَمُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  مَنْ طَلَّقَ فِي  عِدَّةٍ  جَازَ عَلَيْهَا الطَّلَاقُ  » .","","Sunan Sa'id ibn Mansur 1471","","إبراهيم النخعي عن منصور بن المعتمر عن جرير بن عبد الحميد عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2650","1472  -  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  إِذَا كَانَتِ الْمَرْأَةُ تَعْتَدُّ مِنْ خُلْعٍ أَوْ إِيلَاءٍ  وَطَلَّقَهَا زَوْجُهَا فِي الْعِدَّةِ جَازَ عَلَيْهَا الطَّلَاقُ  » .","","Sunan Sa'id ibn Mansur 1472","","إبراهيم النخعي عن منصور بن المعتمر عن جرير بن عبد الحميد عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2651","1473  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  حَجَّاجٌ ، وَمُحَمَّدُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ ، أَنَّهُ كَانَ يَقُولُ : «  يَلْزَمُهَا طَلَاقُهُ إِيَّاهَا مَا كَانَتْ فِي الْعِدَّةِ  » .         [6/388]","","Sunan Sa'id ibn Mansur 1473","","الشعبي عن محمد بن سالم الهمداني عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2652","1474  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  شُرَيْحٍ ، أَنَّهُ كَانَ يَقُولُ : «  يَلْزَمُهَا طَلَاقُهُ إِيَّاهَا  »  .","","Sunan Sa'id ibn Mansur 1474","","شريح بن الحارث الكندي عن الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2653","1475  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  هِشَامُ بْنُ أَبِي عَبْدِ اللهِ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  أَنَّ  ابْنَ مَسْعُودٍ ، كَانَ يَقُولُ : «  يَلْزَمُهَا طَلَاقُهُ إِيَّاهَا مَا كَانَتْ فِي الْعِدَّةِ  » .","","Sunan Sa'id ibn Mansur 1475","","عبد الله بن مسعود عن الضحاك بن مزاحم الهلالي عن يحيى بن أبي كثير عن هشام الدستوائي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2654","1476  -  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ، قَالَ :  سُئِلَ  ابْنُ عَبَّاسٍ وَابْنُ الزُّبَيْرِ «  عَنِ الطَّلَاقِ ، بَعْدَ الْخُلْعِ فَلَمْ يَخْتَلِفَا أَنَّهُ  لَا طَلَاقَ بَعْدَ الْخُلْعِ  » .","","Sunan Sa'id ibn Mansur 1476","","عبد الله بن الزبير عن عطاء بن أبي رباح عن ابن جريج عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2655","1477  -  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عِكْرِمَةَ ، قَالَ : «  لَيْسَ الطَّلَاقُ بَعْدَ الْخُلْعِ شَيْئًا  » .","","Sunan Sa'id ibn Mansur 1477","","عكرمة مولى ابن عباس عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2656","1478  -  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  يُونُسَ ، وَمَنْصُورٍ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  لَا يَلْحَقُهَا طَلَاقُهُ إِيَّاهَا إِذَا كَانَتْ فِي  عِدَّةٍ  بَائِنَةٍ  » .","","Sunan Sa'id ibn Mansur 1478","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2657","1479  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  حَجَّاجٌ ،  عَنْ  عَطَاءٍ ، أَنَّهُ سَمِعَهُ يَقُولُ مِثْلَ ذَلِكَ .         [6/389]","","Sunan Sa'id ibn Mansur 1479","","عطاء بن أبي رباح عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2658","1480  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  مَنْصُورٌ ،  عَنْ  عَمْرِو بْنِ هُرْمُزَ  ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ، أَنَّهُ قَالَ ذَلِكَ .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، ولعل الصواب : (هرم).","","Sunan Sa'id ibn Mansur 1480","","جابر بن زيد اليحمدي عن عمرو بن هرم الأزدي عن منصور بن المعتمر عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2659","1481  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، وَمُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، وَمَالِكِ بْنِ مِغْوَلٍ ،  عَنِ  الشَّعْبِيِّ ، أَنَّهُمْ قَالُوا : «  عِدَّةُ  الْمُخْتَلِعَةِ  مِثْلُ  عِدَّةِ  الْمُطَلَّقَةِ  » .","","Sunan Sa'id ibn Mansur 1481","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2660","1482  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، وَالشَّعْبِيِّ ،  فِي رَجُلٍ طَلَّقَ امْرَأَتَهُ وَهِيَ أَمَةٌ تَطْلِيقَتَيْنِ فَاشْتَرَاهَا  قَالُوا : « لَا تَحِلُّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ ، وَلَا تَحِلُّ لَهُ إِلَّا مِنَ الْبَابِ الَّذِي حُرِّمَتْ عَلَيْهِ  » .","","Sunan Sa'id ibn Mansur 1482","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2661","1483  -  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  نَا  الْأَعْمَشُ ،  عَنْ  مُسْلِمِ بْنِ صُبَيْحٍ ،  عَنْ  مَسْرُوقٍ ، «  فِي رَجُلٍ كَانَتْ عِنْدَهُ أَمَةٌ ، فَطَلَّقَهَا تَطْلِيقَتَيْنِ ثُمَّ اشْتَرَاهَا ، أَيَقَعُ عَلَيْهَا ؟  فَكَرِهَ ذَلِكَ  مَسْرُوقٌ  » .","","Sunan Sa'id ibn Mansur 1483","","مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2662","1484  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  خَالِدٌ الْحَذَّاءُ ،  عَنْ  أَبِي مَعْشَرٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلِيٍّ ، وَالْحَكَمِ ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ قَالَ : «  لَا تَحِلُّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  » .  وَذَكَرَ أَحَدُهُمَا عَنْ  عُبَيْدَةَ  عَنْ  عَلِيٍّ  .         [6/390]","","Sunan Sa'id ibn Mansur 1484","","علي بن أبي طالب عن إبراهيم النخعي عن زياد بن كليب عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2663","1485  -  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ، قَالَ :  حُدِّثْتُ  أَنَّ عُثْمَانَ بْنَ عَفَّانَ وَزَيْدَ بْنَ ثَابِتٍ قَالَا : «  لَا تَحِلُّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  » .","","Sunan Sa'id ibn Mansur 1485","","زيد بن ثابت الأنصاري عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2664","1486  -  حَدَّثَنَا  هُشَيْمٌ ،  أَخْبَرَنِي  عُثْمَانُ بْنُ حَكِيمٍ الْأَنْصَارِيُّ ،  نَا  سُلَيْمَانُ بْنُ يَسَارٍ ،  أَنَّ رَجُلًا تَزَوَّجَ أَمَةً كَانَتْ  لِكَثِيرِ بْنِ الصَّلْتِ  فَطَلَّقَهَا أَلْبَتَّةَ  فَضَرَبَ  الدَّهْرُ مَنْ ضَرَبَهُ ، وَأَصَابَ الرَّجُلُ مَالًا ، فَأَتَى  كَثِيرُ بْنُ الصَّلْتِ  فَابْتَاعَ مِنْهُ الْجَارِيَةَ ، فَلَمَّا أَوْجَبَهَا لَهُ قَالَ : لَا تَعْجَلْ حَتَّى أَرْجِعَ إِلَيْكَ ، فَأَتَى  مَرْوَانَ بْنَ الْحَكَمِ  يَذْكُرُ ذَلِكَ لَهُ ، فَقَالَ لَهُ  مَرْوَانُ  : انْطَلِقْ إِلَى زَيْدِ بْنِ ثَابِتٍ فَاسْأَلْهُ عَنْ ذَلِكَ ، فَانْطَلَقَ الرَّجُلُ إِلَى  زَيْدٍ  قَالَ  سُلَيْمَانُ بْنُ يَسَارٍ  : فَجَاءَ إِلَى  زَيْدٍ  وَأَنَا عِنْدَهُ فَسَأَلَهُ ،  فَقَالَ  : « لَا تَحِلُّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ ، فَانْطَلَقَ  كَثِيرٌ  إِلَى الرَّجُلِ فَأَخْبَرَهُ ، فَقَالَ الرَّجُلُ : اشْهَدُوا أَنَّهُ قَدْ أَعْتَقَهَا وَتَزَوَّجَهَا وَأَصْدَقَهَا كَذَا وَكَذَا ، فَقَالَ  كَثِيرٌ  : لَا تَعْجَلْ حَتَّى أَرْجِعَ إِلَيْكَ ، فَأَتَى  زَيْدَ بْنَ ثَابِتٍ  فَذَكَرَ ذَلِكَ لَهُ ، فَقَالَ : لَا تَحِلُّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  » .","","Sunan Sa'id ibn Mansur 1486","","زيد بن ثابت الأنصاري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن عثمان بن حكيم الأحلافي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2665","1487  -  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  أَبِي مَعْبَدٍ ،  أَنَّ عَبْدًا         [6/391]      لِابْنِ عَبَّاسٍ طَلَّقَ امْرَأَتَهُ تَطْلِيقَتَيْنِ  فَقَالَ لَهُ  : « ارْجِعْهَا فَأَبَى ، فَوَهَبَهَا لَهُ وَقَالَ : اسْتَحِلَّهَا بِمِلْكِ الْيَمِينِ  » .","","Sunan Sa'id ibn Mansur 1487","","عبد الله بن عباس عن نافذ المكي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2666","1488  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  أَبُو الزُّبَيْرِ ،  عَنْ  أَبِي مَعْبَدٍ ،  أَنَّ غُلَامًا ، لِابْنِ عَبَّاسٍ طَلَّقَ امْرَأَتَهُ تَطْلِيقَتَيْنِ  ،  فَقَالَ لَهُ  ابْنُ عَبَّاسٍ  : « ارْجِعْهَا لَا أُمَّ لَكَ فَإِنَّهُ لَيْسَ لَكَ مِنَ الْأَمْرِ شَيْءٌ ، فَأَبَى ، فَقَالَ : هِيَ لَكَ فَاتَّخِذْهَا  » .","","Sunan Sa'id ibn Mansur 1488","","عبد الله بن عباس عن نافذ المكي عن أبو الزبير المكي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2667","1489  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ ،  أَنَّهُ كَانَ يَقُولُ فِي الرَّجُلِ يُطَلِّقُ امْرَأَتَهُ وَهِيَ أَمَةٌ تَطْلِيقَتَيْنِ فَوَطِئَهَا سَيِّدُهَا  : « إِنَّ زَوْجَهَا إِنْ شَاءَ أَنْ يَخْطُبَهَا »  قَالَ سَعِيدٌ :  بِئْسَ مَا قَالَ  .","","Sunan Sa'id ibn Mansur 1489","","زيد بن ثابت الأنصاري عن الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2668","1490  -  أَخْبَرَنَا  خَالِدٌ الْحَذَّاءُ ،  عَنْ  مَرْوَانَ الْأَصْفَرِ ،  عَنْ  أَبِي رَافِعٍ ،  أَنَّ  عُثْمَانَ بْنَ عَفَّانَ ، وَزَيْدَ بْنَ ثَابِتٍ ،  سُئِلَا عَنْ ذَلِكَ ، فَرَخَّصَا فِيهِ وَعَلِيٌّ جَالِسٌ فَقَامَ مُغْضَبًا كَارِهًا لِمَا قَالَا  .","","Sunan Sa'id ibn Mansur 1490","","علي بن أبي طالب عن نفيع بن رافع الصائغ عن أبو خلف مروان الأصفر عن خالد الحذاء عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2669","1491  -  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَبِي عَبْدِ اللهِ الشَّقَرِيِّ ،  عَنْ  عَامِرٍ ،  عَنْ  مَسْرُوقٍ ، «  فِي رَجُلٍ كَانَتْ تَحْتَهُ أَمَةٌ فَطَلَّقَهَا تَطْلِيقَتَيْنِ ، ثُمَّ غَشِيَهَا سَيِّدُهَا ، أَتَحِلُّ لِزَوْجِهَا ؟  فَقَالَ : سَمِعْتُ اللهَ تَعَالَى يَقُولُ :         {      حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ         }      وَلَيْسَ هَذَا بِزَوْجٍ  » .","","Sunan Sa'id ibn Mansur 1491","","مسروق بن الأجدع عن الشعبي عن سلمة بن تمام الشقري عن حماد بن زيد عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2670","1492  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، وَالشَّعْبِيِّ ، «  فِي الْأَمَةِ إِذَا         [6/392]      طُلِّقَتْ فَنَكَحَهَا سَيِّدُهَا أَنَّهَا لَا تَحِلُّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  » .","","Sunan Sa'id ibn Mansur 1492","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2671","1493  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  ابْنُ عَوْنٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  شَهِدْتُ  قَيْسًا الزَّيَّاتَ  سَأَلَ مَسْرُوقًا « فَرَخَّصَ لَهُ أَنْ يَتَزَوَّجَهَا  ، فَلَمَّا أَدْبَرَ دَعَاهُ ، فَقَالَ لَهُ : أَبْرَأُ إِلَيْكَ مِمَّا قُلْتُ ، وَاللهِ مَا أَرَى اسْتِحْلَالَهُ فَرْجَهَا إِلَّا بِزَوْجٍ » وَمَا أَدْرِي مَا فَعَلَ  .","","Sunan Sa'id ibn Mansur 1493","","مسروق بن الأجدع عن الشعبي عن عبد الله بن عون بن أرطبان عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الإيلاء"
"2672","بَابُ مَا جَاءَ فِي مَتَاعِ الْبَيْتِ إِذَا اخْتَلَفَ فِيهِ الزَّوْجَانِ .  1494  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ ،  فِي رَجُلٍ طَلَّقَ امْرَأَتَهُ ، أَوْ مَاتَ عَنْهَا وَقَدْ أَحْدَثَتْ فِي بَيْتِهِ أَشْيَاءَ  قَالَ  الْحَسَنُ  : « لَهَا مَا أَغْلَقَتْ عَلَيْهِ بَابَهَا إِلَّا سِلَاحَ الرَّجُلِ وَمُصْحَفَهُ  » .","","Sunan Sa'id ibn Mansur 1494","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع البيت إذا اختلف فيه الزوجان"
"2673","1495  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  مَنْصُورٌ ،  عَنِ  ابْنِ سِيرِينَ ، أَنَّهُ قَالَ : «  مَا كَانَ مِنْ صَدَاقٍ فَهُوَ لَهَا  ، وَمَا كَانَ مِنْ غَيْرِ الصَّدَاقِ فَهُوَ مِيرَاثٌ  » .","","Sunan Sa'id ibn Mansur 1495","","محمد بن سيرين عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع البيت إذا اختلف فيه الزوجان"
"2674","1496  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  عُبَيْدَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  مَا كَانَ لِلرَّجُلِ مِمَّا لَا يَكُونُ لِلنِّسَاءِ مِثْلُهُ فَهُوَ لِلرَّجُلِ  ، وَمَا كَانَ مِمَّا يَكُونُ لِلنِّسَاءِ مِمَّا لَا يَكُونُ لِلرَّجُلِ مِثْلُهُ فَهُوَ لِلْمَرْأَةِ ، وَإِنْ كَانَ مِمَّا يَكُونُ لِلرِّجَالِ وَالنِّسَاءِ مِثْلُهُ فَهُوَ لِلْبَاقِي مِنْهُمَا  » .","","Sunan Sa'id ibn Mansur 1496","","إبراهيم النخعي عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع البيت إذا اختلف فيه الزوجان"
"2675","1497  -  حَدَّثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ الدِّمَشْقِيُّ ،  حَدَّثَنِي  أَبُو نُوحٍ الْمَدَنِيُّ ،         [6/393]      مِنْ  آلِ أَبِي بَكْرَةَ  قَالَ :  حَدَّثَنِي  الْحَضْرَمِيُّ ، رَجُلٌ قَدْ سَمَّاهُ  عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ ، رَضِيَ اللهُ عَنْهُ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  مَتَاعُ النِّسَاءِ لِلنِّسَاءِ ، وَمَتَاعُ الرِّجَالِ لِلرِّجَالِ  » .","","Sunan Sa'id ibn Mansur 1497","","علي بن أبي طالب عن الحضرمي عن أبو نوح المدني عن سويد بن عبد العزيز السلمي عن سعيد بن منصور","باب ما جاء في متاع البيت إذا اختلف فيه الزوجان"
"2676","1498  -  حَدَّثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  سَأَلْتُ  ابْنَ شُبْرُمَةَ عَنْ ذَلِكَ ، فَقَالَ مِثْلَ ذَلِكَ ، وَقَالَ : «  مَا كَانَ مِنْ مَتَاعٍ يَكُونُ لِلنِّسَاءِ وَالرِّجَالِ فَهُوَ بَيْنُهُمَا  » .","","Sunan Sa'id ibn Mansur 1498","","عبد الله بن شبرمة عن سويد بن عبد العزيز السلمي عن سعيد بن منصور","باب ما جاء في متاع البيت إذا اختلف فيه الزوجان"
"2677","1499  -  حَدَّثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  سَأَلْتُ  ابْنَ أَبِي لَيْلَى فَقَالَ مِثْلَ ذَلِكَ ، إِلَّا أَنَّهُ قَالَ : «  وَمَا كَانَ مِنْ مَتَاعٍ يَكُونُ لِلرِّجَالِ وَالنِّسَاءِ ، فَهُوَ لِلرِّجَالِ  ، حَيٌّ كَانَ أَوْ مَيِّتٌ  » .","","Sunan Sa'id ibn Mansur 1499","","محمد بن عبد الرحمن بن أبي ليلى عن سويد بن عبد العزيز السلمي عن سعيد بن منصور","باب ما جاء في متاع البيت إذا اختلف فيه الزوجان"
"2678","1500  -  حَدَّثَنَا  هُشَيْمٌ ،  عَنِ  ابْنِ شُبْرُمَةَ ، وَابْنُ أَبِي لَيْلَى ، أَنَّهُمَا كَانَا يَقُولَانِ : «  مَا كَانَ لِلرِّجَالِ فَهُوَ لِلرِّجَالِ  ، وَمَا كَانَ لِلنِّسَاءِ فَهُوَ لِلْمَرْأَةِ وَمَا كَانَ مِمَّا يَكُونُ لِلرِّجَالِ وَالنِّسَاءِ فَهُوَ لِلرِّجَالِ  » .","","Sunan Sa'id ibn Mansur 1500","","محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع البيت إذا اختلف فيه الزوجان"
"2679","1501  -  حَدَّثَنَا  هُشَيْمٌ ، قَالَ :  أَخْبَرَنِي  مَنْ ،  سَمِعَ  الْحَكَمَ ، وَابْنَ أَشْوَعَ قَالَا :  «  مَا كَانَ لِلرِّجَالِ فَهُوَ لِلرِّجَالِ  ، وَمَا كَانَ لِلنِّسَاءِ فَهُوَ لِلْمَرْأَةِ ، وَمَا كَانَ لِلرِّجَالِ وَالنِّسَاءِ فَهُوَ لِلْمَرْأَةِ » . قَالَ  هُشَيْمٌ  : وَهُوَ الْقَوْلُ  .","","Sunan Sa'id ibn Mansur 1501","","سعيد بن عمرو بن أشوع الهمداني عن من عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع البيت إذا اختلف فيه الزوجان"
"2680","1502  -  حَدَّثَنَا  هُشَيْمٌ ، قَالَ :  أَخْبَرَنِي  مَنْ  سَمِعَ  ابْنَ ذَكْوَانَ الْمَدِينِيَّ ، وَعُثْمَانَ الْبَتِّيَّ ، يَقُولَانِ : «  مَا كَانَ لِلرِّجَالِ وَالنِّسَاءِ فَهُوَ بَيْنَهُمَا  » .         [6/394]","","Sunan Sa'id ibn Mansur 1502","","عثمان بن مسلم عن من عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع البيت إذا اختلف فيه الزوجان"
"2681","1503  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  إِسْمَاعِيلُ بْنُ سَالِمٍ ، قَالَ :  سَمِعْتُ  الشَّعْبِيَّ ، يَقُولُ : «  إِذَا دَخَلَتِ الْمَرْأَةُ عَلَى زَوْجِهَا بِمَتَاعٍ أَوْ حُلِيٍّ ثُمَّ مَاتَتْ فَهُوَ مِيرَاثٌ  ، وَإِنْ أَقَامَ أَهْلُهَا الْبَيِّنَةَ أَنَّهُ كَانَ عَارِيَّةً عِنْدَهَا ، إِلَّا أَنْ يُعْلِمُوا ذَلِكَ زَوْجَهَا  » .","","Sunan Sa'id ibn Mansur 1503","","الشعبي عن إسماعيل بن سالم الأسدي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع البيت إذا اختلف فيه الزوجان"
"2682","1504  -  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ، «  أَنَّ امْرَأَةً ، زَوَّجَتْ بِنْتَهَا ، فَلَمَّا أَنْ أَرَادَتْ ، أَنْ تُهْدِيَهَا ، إِلَى زَوْجِهَا جَمَعَتْ حُلِيًّا لَهَا  ، وَأَشْهَدَتْ أَنَّ الْحُلِيَّ حُلِيُّهَا ، فَكَتَبَ فِي ذَلِكَ  الْحَجَّاجُ  إِلَى عَبْدِ الْمَلِكِ بْنِ مَرْوَانَ فَكَتَبَ  عَبْدُ الْمَلِكِ  : إِنَّ إِحْدَاهُنَّ تُخْبِرُ أَنَّ لِابْنَتِهَا الْمَالَ فَتَزَوَّجَهَا عَلَى ذَلِكَ ، فَأَيُّمَا امْرَأَةٍ حَمَلَتْ مِنْ بَيْتِ أَهْلِهَا مَتَاعًا كَانَ مَعَهَا حَتَّى تَهْلِكَ فَهُوَ لَهَا  » .  وَكَانَ الشَّعْبِيُّ يَرَى ذَلِكَ  .","","Sunan Sa'id ibn Mansur 1504","","عبد الملك بن مروان بن الحكم عن الشعبي عن داود بن أبي هند عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في متاع البيت إذا اختلف فيه الزوجان"
"2683","1505  -  حَدَّثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  نَا  أَبُو وَهْبٍ الْكَلَاعِيُّ ،  عَنْ  مَكْحُولٍ ،  أَنَّ  عُمَرَ بْنَ عَبْدِ الْعَزِيزِ ، «  رَخَّصَ لِلْمَرْأَةِ فِي غَيْرِ الرَّأْسِ وَالرَّأْسَيْنِ فِي غَيْرِ أَمْرِ الزَّوْجِ  » .","","Sunan Sa'id ibn Mansur 1505","","عمر بن عبد العزيز بن مروان عن مكحول بن أبي مسلم عن عبيد الله بن عبيد الكلاعي عن سويد بن عبد العزيز السلمي عن سعيد بن منصور","باب ما جاء في متاع البيت إذا اختلف فيه الزوجان"
"2684","بَابُ مَا جَاءَ فِي  عِدَّةِ  الْحَامِلِ الْمُتَوَفَّى عَنْهَا زَوْجُهَا .  1506  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، «  أَنَّ  سُبَيْعَةَ بِنْتَ الْحَارِثِ  ، تَعَالَتْ مِنْ  نِفَاسِهَا  بَعْدَ وَفَاةِ زَوْجِهَا بِأَيَّامٍ ، فَمَرَّ بِهَا  أَبُو السَّنَابِلِ  فَقَالَ : إِنَّكِ لَا تَحِلِّينَ حَتَّى تَمْكُثِي أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا ، فَذَكَرَتْ ذَلِكَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : «  كَذَبَ  أَبُو السَّنَابِلِ  لَيْسَ كَمَا قَالَ ، قَدْ حَلَلْتِ فَانْكِحِي  .         [6/395]","","Sunan Sa'id ibn Mansur 1506","","عبد الله بن عتبة بن مسعود عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2685","1507  -  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  أَبِي السَّنَابِلِ بْنِ بَعْكَكٍ ، قَالَ : «  وَضَعَتْ  سُبَيْعَةُ بِنْتُ الْحَارِثِ  بَعْدَ وَفَاةِ زَوْجِهَا بِثَلَاثَةٍ وَعِشْرِينَ أَوْ خَمْسَةٍ وَعِشْرِينَ ، فَلَمَّا تَعَالَتْ  تَشَوَّفَتْ  لِلنِّكَاحِ فَأُعِيبَ ذَلِكَ وَأُنْكِرَ ذَلِكَ عَلَيْهَا فَبَلَغَ ذَلِكَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  إِنْ تَفْعَلْ فَقَدْ خَلَا أَجَلُهَا  .","","Sunan Sa'id ibn Mansur 1507","","أبو السنابل بن بعكك العبدري عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2686","1508  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مَنْصُورٌ ،  عَنِ  ابْنِ سِيرِينَ  أَنَّ  سُبَيْعَةَ  وَضَعَتْ بَعْدَ وَفَاةِ زَوْجِهَا بِنَحْوٍ مِنْ عِشْرِينَ لَيْلَةً ،  فَتَشَوَّفَتْ  فَمَرَّ بِهَا  أَبُو السَّنَابِلِ  فَقَالَ : كَأَنَّكِ تُرِيدِينَ التَّزْوِيجَ قَالَتْ : وَلَسْتُ قَدْ حَلَلْتُ ؟ فَقَالَ : كَلَّا ، حَتَّى يَأْتِيَ عَلَيْكِ آخِرُ الْأَجَلَيْنِ ، فَأَتَتْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَتْ ذَلِكَ لَهُ فَقَالَ : «  كَذَبَ  أَبُو السَّنَابِلِ  ، إِذَا وَجَدْتِ رَجُلًا تَرْضَيْنَهُ فَتَزَوَّجِيهِ  » .","","Sunan Sa'id ibn Mansur 1508","","محمد بن سيرين عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2687","1509  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ اللهِ ، بِنَحْوِ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1509","","عبد الله بن عباس عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2688","1510  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أَبِي سَلَمَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِ حَدِيثِ  مَنْصُورِ بْنِ زَاذَانَ  .         [6/396]","","Sunan Sa'id ibn Mansur 1510","","أبو سلمة بن عبد الرحمن عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2689","1511  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  ابْنُ أَبِي لَيْلَى ، وَدَاوُدُ ،  عَنِ  الشَّعْبِيِّ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوٍ مِنْ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1511","","الشعبي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2690","1512  -  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُسْلِمِ بْنِ صُبَيْحٍ ،  عَنْ  مَسْرُوقٍ قَالَ :  قَالَ  عَبْدُ اللهِ :  مَنْ شَاءَ لَاعَنْتُهُ لَأُنْزِلَتْ سُورَةُ النِّسَاءِ  الْقُصْرَى  بَعْدَ ""أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا  .","","Sunan Sa'id ibn Mansur 1512","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2691","1513  -  حَدَّثَنَا  سَعِيدٌ ،  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّهُ كَانَ يَقُولُ :  مَنْ شَاءَ حَالَفْتُهُ أَنَّ سُورَةَ النِّسَاءِ  الْقُصْرَى  أُنْزِلَتْ بَعْدَ الَّتِي فِي الْبَقَرَةِ         {      أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا         }      .","","Sunan Sa'id ibn Mansur 1513","","عبد الله بن مسعود عن الشعبي عن إسماعيل بن أبي خالد عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2692","1514  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  قَالَ  ابْنُ مَسْعُودٍ : «  مَنْ شَاءَ دَاعَيْتُهُ أَنَّ سُورَةَ النِّسَاءِ  الْقُصْرَى  أُنْزِلَتْ بَعْدَ الَّتِي فِي الْبَقَرَةِ  » .","","Sunan Sa'id ibn Mansur 1514","","عبد الله بن مسعود عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2693","1515  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  قَالَ  ابْنُ مَسْعُودٍ : «  أَجَلُ كُلِّ حَامِلٍ أَنْ تَضَعَ ، مَا فِي بَطْنِهَا  » .","","Sunan Sa'id ibn Mansur 1515","","عبد الله بن مسعود عن الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2694","1516  -  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُسْلِمِ بْنِ صُبَيْحٍ ،  قَالَ  : كَانَ عَلِيٌّ يَقُولُ : «  آخِرُ الْأَجَلَيْنِ  » .         [6/397]","","Sunan Sa'id ibn Mansur 1516","","علي بن أبي طالب عن مسلم بن صبيح الهمداني عن الأعمش عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2695","1517  -  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ، قَالَ :  قُلْتُ  لِعَامِرٍ الشَّعْبِيِّ : «  مَا أُصَدِّقُ  أَنَّ  عَلِيًّا قَالَ : آخِرُ الْأَجَلَيْنِ قَالَ : بَلَى فَصَدِّقْ بِهِ أَشَدَّ مَا صَدَّقْتَ بِشَيْءٍ قَطُّ  » .","","Sunan Sa'id ibn Mansur 1517","","علي بن أبي طالب عن الشعبي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2696","1518  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي الْمُتَوَفَّى عَنْهَا زَوْجُهَا : « يَنْتَظِرُ آخِرَ الْأَجَلَيْنِ  » .","","Sunan Sa'id ibn Mansur 1518","","عبد الله بن عباس عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2697","1519  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَلِيٍّ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1519","","علي بن أبي طالب عن الشعبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2698","1520  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  جُوَيْبِرٌ ،  عَنِ  الضَّحَّاكِ ، قَالَ :  اخْتَلَفَ فِيهِ أَصْحَابُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْهُمْ مَنْ قَالَ : آخِرُ الْأَجَلَيْنِ ،  فَقَالَ  أُبَيُّ بْنُ كَعْبٍ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : «  أَجَلُ كُلِّ حَامِلٍ مَا تَضَعُ  مَا فِي بَطْنِهَا  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، والصواب ( أن تضع ) وينظر مصنف ابن أبي شيبة 9 / 311 ، وسنن البيهقي 7 / 422","","Sunan Sa'id ibn Mansur 1520","","أبي بن كعب عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2699","1521  -  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ، قَالَ :  سَمِعْتُ  رَجُلًا ، مِنَ الْأَنْصَارِ يُحَدِّثُ أَبِي قَالَ :  سَمِعْتُ  أَبَاكَ ، يَقُولُ : «  إِذَا وَضَعَتْ ذَا بَطْنِهَا وَزَوْجُهَا عَلَى السَّرِيرِ فَقَدْ حَلَّتْ  » .","","Sunan Sa'id ibn Mansur 1521","","عمر بن الخطاب عن رجل من الأنصار عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2700","1522  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا وَضَعَتْ فَقَدْ حَلَّتْ  » .  فَقَالَ  رَجُلٌ مِنَ الْأَنْصَارِ :  سَمِعْتُ  عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ يَقُولُ : «  إِذَا وَضَعَتْ مَا فِي بَطْنِهَا وَزَوْجُهَا عَلَى السَّرِيرِ قَبْلَ أَنْ يُدَلَّى فِي حُفْرَتِهِ فَقَدِ انْقَضَتْ عِدَّتُهَا  » .         [6/398]","","Sunan Sa'id ibn Mansur 1522","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2701","1523  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، وَمُغِيرَةَ ،  عَنِ  الشَّعْبِيِّ ، «  أَنَّهُمَا كَرِهَا أَنْ تَنْكِحَ النُّفَسَاءُ ، مَا كَانَتْ فِي الدَّمِ  » .","","Sunan Sa'id ibn Mansur 1523","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2702","1524  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنِ  الْحَارِثِ الْعُكْلِيِّ ،  أَنَّهُ  كَانَ لَا يَرَى بَأْسًا أَنْ تَنْكِحَ مَا كَانَتْ فِي الدَّمِ  ، قَالَ : « وَلَكِنْ لَا يَدْخُلُ بِهَا زَوْجُهَا حَتَّى تَغْتَسِلَ »  .","","Sunan Sa'id ibn Mansur 1524","","الحارث بن يزيد العكلي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في عدة الحامل المتوفى عنها زوجها"
"2703","بَابُ الرَّجُلِ يُطَلِّقُ الْمَرْأَةَ تَطْلِيقَةً أَوْ تَطْلِيقَتَيْنِ ثُمَّ تَرْجِعُ إِلَيْهِ بَعْدَ زَوْجٍ عَلَى كَمْ تَكُونُ عِنْدَهُ .  1525  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ، وَحُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ، وَعُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  سَمِعُوا  أَبَا هُرَيْرَةَ ، يَقُولُ :  سَأَلْتُ  عُمَرَ عَنْ رَجُلٍ ، مِنْ أَهْلِ الْبَحْرَيْنِ طَلَّقَ امْرَأَتَهُ تَطْلِيقَتَيْنِ ، وَانْقَضَتْ عِدَّتُهَا  ، ثُمَّ تَزَوَّجَهَا رَجُلٌ فَطَلَّقَهَا ، فَرَجَعَتْ إِلَيْهِ قَالَ : « هِيَ عَلَى مَا بَقِيَ مِنَ الطَّلَاقِ »  .","","Sunan Sa'id ibn Mansur 1525","","عمر بن الخطاب عن أبو هريرة الدوسي عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يطلق المرأة تطليقة أو تطليقتين ثم ترجع إليه بعد زوج على كم تكون عنده"
"2704","1526  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ،  عَنْ  عُمَرَ بْنِ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ قَالَ : «  هِيَ عَلَى مَا بَقِيَ مِنَ الطَّلَاقِ  » .","","Sunan Sa'id ibn Mansur 1526","","عمر بن الخطاب عن أبو هريرة الدوسي عن سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق المرأة تطليقة أو تطليقتين ثم ترجع إليه بعد زوج على كم تكون عنده"
"2705","1527  -  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  كَثِيرِ بْنِ شِنْظِيرٍ ،  عَنِ  الْحَسَنِ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ ، وَأُبَيَّ بْنَ كَعْبٍ ، وَزَيْدَ بْنَ ثَابِتٍ ، وَعِمْرَانَ بْنَ حُصَيْنٍ ، قَالُوا : «  هِيَ عَلَى مَا بَقِيَ مِنَ الطَّلَاقِ  » .","","Sunan Sa'id ibn Mansur 1527","","عمران بن حصين بن عبيد بن خلف الخزاعي عن الحسن البصري عن كثير بن شنظير المازني عن حماد بن زيد عن سعيد بن منصور","باب الرجل يطلق المرأة تطليقة أو تطليقتين ثم ترجع إليه بعد زوج على كم تكون عنده"
"2706","1528  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  ابْنُ أَبِي لَيْلَى ، قَالَ :  سَمِعْتُ  مَزِيدَةَ بْنَ جَابِرٍ ،         [6/399]      يُحَدِّثُ عَنْ  أَبِيهِ  ،  عَنْ  عَلِيٍّ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1528","","علي بن أبي طالب عن جابر الحداني عن مزيدة بن جابر الهجري عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق المرأة تطليقة أو تطليقتين ثم ترجع إليه بعد زوج على كم تكون عنده"
"2707","1529  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  ابْنُ أَبِي لَيْلَى ،  عَنِ  الْحَكَمِ ،  عَنْ  عَبِيدَةَ ، أَنَّهُ كَانَ يَقُولُ : «  هِيَ عَلَى مَا بَقِيَ  ، لَا يَهْدِمُ دُخُولُهُ عَلَى مَا مَضَى مِنَ الطَّلَاقِ  » .","","Sunan Sa'id ibn Mansur 1529","","عبيدة بن عمرو السلماني عن الحكم بن عتيبة الكندي عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق المرأة تطليقة أو تطليقتين ثم ترجع إليه بعد زوج على كم تكون عنده"
"2708","1530  -  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  أَنَّ  زِيَادًا  سَأَلَ  عِمْرَانَ بْنَ حُصَيْنٍ عَنْ رَجُلٍ ، طَلَّقَ امْرَأَتَهُ تَطْلِيقَتَيْنِ فَانْقَضَتْ عِدَّتُهَا فَتَزَوَّجَتْ رَجُلًا  ، ثُمَّ طَلَّقَهَا ، ثُمَّ تَزَوَّجَتِ الْأَوَّلَ قَالَ : « هِيَ عِنْدَهُ عَلَى وَاحِدَةٍ وَمَضَتْ ثِنْتَانِ وَبَقِيَتْ وَاحِدَةٌ  »  وَسَأَلَ  شُرَيْحًا فَقَالَ :  طَلَاقٌ جَدِيدٌ وَنِكَاحٌ جَدِيدٌ  ، فَقَالَ  زِيَادٌ  : قَدْ قَالَ  شُرَيْحٌ  وَقَضَى  أَبُو نُجَيْدٍ  .","","Sunan Sa'id ibn Mansur 1530","","شريح بن الحارث الكندي عن زياد بن زيد الأعسم عن معاوية بن قرة عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب الرجل يطلق المرأة تطليقة أو تطليقتين ثم ترجع إليه بعد زوج على كم تكون عنده"
"2709","1531  -  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  أَنَّ  زِيَادًا  ، سَأَلَ عِمْرَانَ بْنَ حُصَيْنٍ فَقَالَ : « هِيَ عَلَى مَا بَقِيَ  » .  وَسَأَلَ  شُرَيْحًا فَقَالَ : «  يَهْدِمُ الدُّخُولُ الْأَخِيرُ طَلَاقَ الْأَوَّلِ  » وَكَانَ  عَامِرٌ  يَأْخُذُ بِقَوْلِ  شُرَيْحٍ  .","","Sunan Sa'id ibn Mansur 1531","","شريح بن الحارث الكندي عن الشعبي عن داود بن أبي هند عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يطلق المرأة تطليقة أو تطليقتين ثم ترجع إليه بعد زوج على كم تكون عنده"
"2710","1532  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  شُرَيْحٍ ، قَالَ : «  نِكَاحٌ جَدِيدٌ وَطَلَاقٌ جَدِيدٌ  »  قَالَ  دَاوُدُ : وَكَانَ عَامِرٌ يَرَاهُ  .","","Sunan Sa'id ibn Mansur 1532","","شريح بن الحارث الكندي عن الشعبي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق المرأة تطليقة أو تطليقتين ثم ترجع إليه بعد زوج على كم تكون عنده"
"2711","1533  -  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : «  هِيَ عِنْدَهُ عَلَى ثَلَاثٍ  » .","","Sunan Sa'id ibn Mansur 1533","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يطلق المرأة تطليقة أو تطليقتين ثم ترجع إليه بعد زوج على كم تكون عنده"
"2712","[6/400]      1534  -  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَيُّوبَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : «  هِيَ عِنْدَهُ عَلَى ثَلَاثٍ  » .","","Sunan Sa'id ibn Mansur 1534","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن أيوب السختياني عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يطلق المرأة تطليقة أو تطليقتين ثم ترجع إليه بعد زوج على كم تكون عنده"
"2713","1535  -  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدٍ ،  عَنْ  شُرَيْحٍ ، قَالَ : «  هِيَ عِنْدَهُ عَلَى ثَلَاثٍ  » .","","Sunan Sa'id ibn Mansur 1535","","شريح بن الحارث الكندي عن محمد بن سيرين عن أيوب السختياني عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يطلق المرأة تطليقة أو تطليقتين ثم ترجع إليه بعد زوج على كم تكون عنده"
"2714","1536  -  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  بَعْضِ أَصْحَابِهِ  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : «  نِكَاحٌ جَدِيدٌ وَطَلَاقٌ جَدِيدٌ  » .","","Sunan Sa'id ibn Mansur 1536","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن بعض أصحاب هشيم بن بشير عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق المرأة تطليقة أو تطليقتين ثم ترجع إليه بعد زوج على كم تكون عنده"
"2715","1537  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  مُغِيرَةُ ،  عَنْ  فُضَيْلٍ ،  عَنْ  إِبْرَاهِيمَ ،  قَالَ  مُغِيرَةُ : وَأَظُنُّهُ قَدْ  سَمِعْتُهُ  مِنْ إِبْرَاهِيمَ  أَنَّهُ كَانَ يَقُولُ : «  إِذَا تَزَوَّجَتْ زَوْجًا فَدَخَلَ بِهَا فَإِنَّهُ دُخُولُهُ  يَهْدِمُ بَقِيَّةَ الطَّلَاقِ  ، وَإِذَا لَمْ يَدْخُلْ بِهَا فَهِيَ عَلَى مَا بَقِيَ  »  .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، والصواب : ( فإن )","","Sunan Sa'id ibn Mansur 1537","","إبراهيم النخعي عن فضيل بن عمرو الفقيمي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق المرأة تطليقة أو تطليقتين ثم ترجع إليه بعد زوج على كم تكون عنده"
"2716","1538  -  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  نَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  قَالَ  : « كَانَ أَصْحَابُ عَبْدِ اللهِ يَقُولُونَ :  يَهْدِمُ النِّكَاحُ الثَّلَاثَ ، وَلَا يَهْدِمُ الْوَاحِدَةَ وَالثِّنْتَيْنِ  » .","","Sunan Sa'id ibn Mansur 1538","","أصحاب عبد الله عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب الرجل يطلق المرأة تطليقة أو تطليقتين ثم ترجع إليه بعد زوج على كم تكون عنده"
"2717","بَابُ الرَّجُلِ يُطَلِّقُ ثُمَّ يَجْحَدُ الطَّلَاقَ  1539  -  حَدَّثَنَا  سَعِيدٌ  نَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  فِي الرَّجُلِ يُطَلِّقُ امْرَأَتَهُ ثَلَاثًا ثُمَّ يَجْحَدُ  قَالَ : « تُرَافِعُهُ إِلَى السُّلْطَانِ يَسْتَحْلِفُهُ  » .","","Sunan Sa'id ibn Mansur 1539","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق ثم يجحد الطلاق"
"2718","1540  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّهُ قَالَ مِثْلَ ذَلِكَ قَالَ : «  فَإِنْ حَلَفَ فَلْتَفْدِي مِنْهُ  » .         [6/401]","","Sunan Sa'id ibn Mansur 1540","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق ثم يجحد الطلاق"
"2719","1541  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ أَنَّهُ قَالَ : «  هُمَا زَانِيَانِ مَا اصْطَحَبَا  » .","","Sunan Sa'id ibn Mansur 1541","","جابر بن زيد اليحمدي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق ثم يجحد الطلاق"
"2720","1542  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مُحَمَّدُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّهُ سُئِلَ : عَنْ رَجُلٍ ، طَلَّقَ امْرَأَتَهُ ثَلَاثًا ، فَكَانَ يَغْشَاهَا فَشَهِدَتْ عَلَيْهِ الشُّهُودُ أَنَّهُ طَلَّقَهَا  وَكَانَ يَغْشَاهَا بَعْدَ الطَّلَاقِ ، فَجَحَدَ شَهَادَتَهُمْ ، فَقَالَ  الشَّعْبِيُّ  : « يُدْرَأُ عَنْهُ »  يَعْنِي  الْحَدَّ  « بِجُحُودِهِ وَيُفَرَّقُ بَيْنَهُ وَبَيْنَ امْرَأَتِهِ  » .","","Sunan Sa'id ibn Mansur 1542","","الشعبي عن محمد بن سالم الهمداني عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق ثم يجحد الطلاق"
"2721","1543  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  عَبْدُ الْمَلِكِ ،  عَنْ  عَطَاءٍ ،  أَنَّهُ  سُئِلَ رَجُلٌ ، حَلَفَ بِطَلَاقِ امْرَأَتِهِ أَنَّهُ دَفَعَ إِلَيْهَا دِرْهَمًا فَقَالَتْ : لَمْ تَدْفَعْ إِلَيَّ شَيْئًا  قَالَ : « يُصَدَّقُ وَالْقَوْلُ قَوْلُهُ  » .","","Sunan Sa'id ibn Mansur 1543","","عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق ثم يجحد الطلاق"
"2722","1544  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  أَبُو إِسْحَاقَ الْكُوفِيُّ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّهُ سُئِلَ عَنْ رَجُلٍ ، حَلَفَ لِرَجُلٍ كَانَ يَطْلُبُهُ بِمَالٍ أَنْ لَا تَغِيبَ لَهُ الشَّمْسُ حَتَّى يَدْفَعَ إِلَيْهِ مَالَهُ  ، فَإِنْ لَمْ يَفْعَلْ فَامْرَأَتُهُ طَالِقٌ ثَلَاثًا ، فَغَابَتِ الشَّمْسُ فَزَعَمَ غَرِيمُهُ أَنَّهُ لَمْ يَدْفَعْ إِلَيْهِ شَيْئًا ، فَقَالَتِ امْرَأَتُهُ : قَدْ طَلَّقَنِي قَالَ : « يُدَيِّنُ فِي امْرَأَةٍ وَبَيِّنَتُهُ عَلَى غَرِيمِهِ أَنَّهُ قَدْ دَفَعَ إِلَيْهِ حَقَّهُ ، وَإِلَّا فَهُوَ ضَامِنٌ لِمَالِهِ حَتَّى يَدْفَعَهُ إِلَيْهِ  » قَالَ  هُشَيْمٌ  : وَهُوَ الْقَوْلُ .         [6/402]","","Sunan Sa'id ibn Mansur 1544","","الشعبي عن عبد الله بن ميسرة الحارثي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق ثم يجحد الطلاق"
"2723","1545  -  حَدَّثَنَا  شَرِيكُ بْنُ عَبْدِ اللهِ ،  عَنِ  ابْنِ وَبَرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ رَجُلًا كَانَ يَطْلُبُ رَجُلًا  بِثَلَاثَةَ عَشَرَ دِرْهَمًا ، أَوْ عَشَرَةِ دَرَاهِمَ أَوْ نَحْوِهَا  ، فَقَالَ : إِنْ لَمْ أَجِئْ بِهَا فَامْرَأَتُهُ طَالِقٌ ثَلَاثًا ، فَجَاءَهَا ، وَفِيهَا دِرْهَمٌ زَيْفٌ ، وَسَتُوقٌ ، فَقَالَ  إِبْرَاهِيمُ  : «  مُرِ امْرَأَتَكَ أَنْ تَعْتَدَّ  » .","","Sunan Sa'id ibn Mansur 1545","","إبراهيم النخعي عن قدامة بن وبرة العجيفي عن شريك بن عبد الله النخعي عن سعيد بن منصور","باب الرجل يطلق ثم يجحد الطلاق"
"2724","بَابُ الرَّجُلِ يُطَلِّقُ امْرَأَتَهُ وَهِيَ حَائِضٌ  1546  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ ، «  أَنَّهُ طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ فَرَدَّ ذَلِكَ رَسُولُ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى طَلَّقَهَا ، وَهِيَ طَاهِرٌ  »  .","","Sunan Sa'id ibn Mansur 1546","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن يونس بن يزيدالأيلي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته وهي حائض"
"2725","1547  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  عَبِيدَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  لَا تَعْتَدُّ تِلْكَ الْحَيْضَةَ  »  .","","Sunan Sa'id ibn Mansur 1547","","إبراهيم النخعي عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته وهي حائض"
"2726","1548  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، قَالَ : «  إِنْ طَلَّقَهَا طَلْقَةً فَهُوَ أَحَقُّ بِرَجْعَتِهَا لَمْ يَعْتَدَّ بِهَا  ، وَإِنْ طَلَّقَهَا طَلَاقًا بَائِنًا اعْتَدَّتْ بِهَا  »  .","","Sunan Sa'id ibn Mansur 1548","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته وهي حائض"
"2727","1549  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  خَالِدٌ ،  عَنِ  ابْنِ سِيرِينَ ،  أَنَّ  ابْنَ عُمَرَ ، طَلَّقَ امْرَأَتَهُ تَطْلِيقَةً ، وَهِيَ حَائِضٌ فَذَكَرَ  عُمَرُ  ذَلِكَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : «  مُرْهُ فَلْيُرَاجِعْهَا يَنْتَظِرُ بِهَا الطُّهْرَ  » قَالَ : فَرَاجَعَهَا  ابْنُ عُمَرَ  لَيْسَ لَهُ فِيهَا         [6/403]      حَاجَةٌ ، فَقُلْتُ  لِابْنِ عُمَرَ  : اعْتَدَدْتَ بِتِلْكَ التَّطْلِيقَةِ ؟ قَالَ :  فَمَهْ  أَرَأَيْتَ إِنْ كُنْتُ عَجَزْتُ  وَاسْتَحْمَقْتُ  .","","Sunan Sa'id ibn Mansur 1549","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته وهي حائض"
"2728","1550  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  ابْنِ سِيرِينَ ، بِنَحْوٍ مِمَّا ذَكَرَ  خَالِدٌ  إِلَّا أَنَّ أَحَدَهُمَا زَعَمَ أَنَّ الَّذِي سَأَلَهُ : اعْتَدَدْتَ بِتِلْكَ التَّطْلِيقَةِ ، هُوَ  يُونُسُ بْنُ جُبَيْرٍ  .","","Sunan Sa'id ibn Mansur 1550","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته وهي حائض"
"2729","1551  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  لَيْثٌ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّ رَجُلًا جَاءَ إِلَى شُرَيْحٍ فَقَالَ : إِنَّهُ طَلَّقَ امْرَأَتَهُ ثَلَاثًا وَهِيَ حَائِضٌ  ، فَقَالَ  شُرَيْحٌ  : «  أَخَلَطْتَ  حَلَالًا بِحَرَامٍ وَخَبِيثًا بِطَيِّبٍ ؟ أَمْهِلْهَا حَتَّى تَطْهُرَ ثُمَّ تَأْتَنِفَ حَيْضًا ، ثُمَّ لَا تَحِلَّ ،  يَعْنِي : لَكَ  حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  »  .","","Sunan Sa'id ibn Mansur 1551","","شريح بن الحارث الكندي عن الشعبي عن الليث بن سعد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته وهي حائض"
"2730","1552  -  حَدَّثَنَا  حُدَيْجُ بْنُ مُعَاوِيَةَ ،  نَا  أَبُو إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَالِكٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ ، فَانْطَلَقَ  عُمَرُ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : إِنَّ  عَبْدَ اللهِ  طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ ، فَقَالَ رَسُولُ اللهِ         [6/404]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  لَيْسَ ذَلِكَ بِشَيْءٍ  » .","","Sunan Sa'id ibn Mansur 1552","","عبد الله بن عمر بن الخطاب عن عبد الله بن مالك بن الحارث الهمداني عن أبو إسحاق السبيعي عن حديج بن معاوية بن حديج  الجعفي عن سعيد بن منصور","باب الرجل يطلق امرأته وهي حائض"
"2731","1553  -  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  نَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  إِذَا  طَلَّقَ الرَّجُلُ امْرَأَتَهُ وَهِيَ طَاهِرٌ اعْتَدَّتْ ثَلَاثَ حِيَضٍ  سِوَى الْحَيْضَةِ الَّتِي طَهُرَتْ مِنْهَا  » .","","Sunan Sa'id ibn Mansur 1553","","إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب الرجل يطلق امرأته وهي حائض"
"2732","بَابُ مَا جَاءَ فِي اللِّعَانِ  1554  -  حَدَّثَنَا  سَعِيدٌ ،  عَنْ  مَالِكِ بْنِ أَنَسٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : «  فَرَّقَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ الْمُتَلَاعِنَيْنِ  ، وَأَلْحَقَ الْوَلَدَ بِأُمِّهِ  »  .","","Sunan Sa'id ibn Mansur 1554","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن سعيد بن منصور","باب ما جاء في اللعان"
"2733","1555  -  حَدَّثَنَا  سُفْيَانُ ،  نَا  الزُّهْرِيُّ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ السَّاعِدِيِّ ، قَالَ : «  شَهِدْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَرَّقَ بَيْنَ الْمُتَلَاعِنَيْنِ  وَأَنَا ابْنُ خَمْسَ عَشْرَةَ سَنَةً ، فَقَالَ : يَا رَسُولَ اللهِ ، كَذَبْتُ عَلَيْهَا إِنْ أَنَا رَاجَعْتُهَا  » .","","Sunan Sa'id ibn Mansur 1555","","سهل بن سعد الساعدي عن الزهري عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في اللعان"
"2734","1556  -  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ دِينَارٍ ،  سَمِعَ  ابْنَ جُبَيْرٍ ، يَقُولُ :  أَخْبَرَنِي  ابْنُ عُمَرَ ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِلْمُتَلَاعِنَيْنِ : «  حِسَابُكُمَا عَلَى اللهِ ، وَأَحَدُكُمَا كَاذِبٌ ، لَا سَبِيلَ لَكَ عَلَيْهَا  » ، فَقَالَ : يَا رَسُولَ اللهِ مَالِي ، فَقَالَ : « لَا مَالَ لَكَ إِنْ كُنْتَ صَدَقْتَ عَلَيْهَا فَهُوَ بِمَا اسْتَحْلَلْتَ مِنْ فَرْجِهَا ، وَإِنْ         [6/405]      كُنْتَ كَذَبْتَ عَلَيْهَا فَذَلِكَ أَبْعَدُ لَكَ  » .","","Sunan Sa'id ibn Mansur 1556","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في اللعان"
"2735","1557  -  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ :  لَمَّا تَلَاعَنَا لَزِمَهَا ، فَقَالَ لَهَا : مَالِي ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  إِنْ كُنْتَ صَادِقًا فَهُوَ بِمَا اسْتَحْلَلْتَ مِنْ فَرْجِهَا  ، وَإِنْ كُنْتَ كَاذِبًا فَهُوَ أَبْعَدُ لَكَ ، اللهُ يَعْلَمُ أَنَّ أَحَدَكُمَا كَاذِبٌ ، وَحِسَابُكُمَا عَلَى اللهِ ، وَلَا سَبِيلَ لَكَ عَلَيْهَا  » .","","Sunan Sa'id ibn Mansur 1557","","سعيد بن جبير الأسدي عن عمرو بن دينار الأثرم عن حماد بن زيد عن سعيد بن منصور","باب ما جاء في اللعان"
"2736","1558  -  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَيُّوبَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنِ الْمُتَلَاعِنَيْنِ ، فَقَالَ : فَرَّقَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ أَخَوَيْ  بَنِي الْعَجْلَانِ  وَقَالَ : «  اللهُ يَعْلَمُ أَنَّ أَحَدَكُمَا كَاذِبٌ  ، فَهَلْ مِنْكُمَا تَائِبٌ » ، فَقَالَ ذَلِكَ : ثَلَاثَ مَرَّاتٍ  .","","Sunan Sa'id ibn Mansur 1558","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن أيوب السختياني عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في اللعان"
"2737","1559  -  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، «  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَعْطَى أَحَدَ  بَنِي الْعَجْلَانِ  الصَّدَاقَ  » .","","Sunan Sa'id ibn Mansur 1559","","سعيد بن جبير الأسدي عن داود بن أبي هند عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في اللعان"
"2738","1560  -  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  بَيَانٍ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ، قَالَ : «  الْمُلَاعَنَةُ أَعْظَمُ مِنَ الرَّجْمِ  »  .","","Sunan Sa'id ibn Mansur 1560","","الشعبي عن بيان بن بشر الأحمسي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في اللعان"
"2739","1561  -  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  نَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  قَالَ  عُمَرُ بْنُ         [6/406]      الْخَطَّابِ : «  الْمُتَلَاعِنَانِ يُفَرَّقُ بَيْنَهُمَا وَلَا يَجْتَمِعَانِ أَبَدًا  » .","","Sunan Sa'id ibn Mansur 1561","","عمر بن الخطاب عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في اللعان"
"2740","1562  -  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  يُجْلَدُ قَاذِفُ ابْنِ الْمُتَلَاعِنَةِ  ، وَلَا تَنْكِحُ الْمُلَاعَنَةُ الْمُلَاعِنَ أَبَدًا  » .","","Sunan Sa'id ibn Mansur 1562","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في اللعان"
"2741","1563  -  حَدَّثَنَا  ابْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَاعَنَ بَيْنَ  رَجُلٍ  وَامْرَأَتِهِ  ، قَالَ زَوْجُ الْمَرْأَةِ : وَاللهِ مَا قَرَبْتُهَا مُنْذُ  عَفَرْنَا  ،  وَالْعَفْرُ  أَنْ تَسْقِيَ النَّخْلَ بَعْدَمَا تَتْرُكُ مِنَ السَّقْيِ شَهْرَيْنِ ، وَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : « اللَّهُمَّ بَيِّنْ » ، فَكَانَ زَوْجُ الْمَرْأَةِ أَصْهَبَ الشَّعَرِ ، حَمْشَ السَّاقَيْنِ وَالذِّرَاعَيْنِ فَجَاءَتْ بِغُلَامٍ أَسْوَدَ جَعْدٍ  قَطَطٍ  عَبْلِ  الذِّرَاعَيْنِ ، فَقَالَ  شَدَّادُ بْنُ الْهَادِ  لِابْنِ عَبَّاسٍ  : أَهِيَ الْمَرْأَةُ الَّتِي قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : « لَوْ كُنْتُ رَاجِمَهَا بِغَيْرِ بَيِّنَةٍ رَجَمْتُهَا » ؟ قَالَ : لَا ، تِلْكَ امْرَأَةٌ كَانَتْ قَدِ اعْتَلَنَتْ فِي الْإِسْلَامِ ، فَنَادَاهُ رَجُلٌ آخَرُ ، فَقَالَ :         [6/407]      يَا  أَبَا الْعَبَّاسِ  : كَيْفَ صِفَةُ الْغُلَامِ ؟ فَقَالَ : جَاءَتْ بِهِ عَلَى الْوَصْفِ السَّيِّئِ  .","","Sunan Sa'id ibn Mansur 1563","","عبد الله بن عباس عن القاسم بن محمد بن أبي بكر الصديق عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سعيد بن منصور","باب ما جاء في اللعان"
"2742","1564  -  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنِ  الْقَاسِمِ ،  قَالَ  :  ذَكَرَ ابْنُ عَبَّاسٍ الْمُتَلَاعِنَيْنِ ، فَقَالَ  عَبْدُ اللهِ بْنُ شَدَّادِ بْنِ الْهَادِ  : وَهِيَ الَّتِي قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  لَوْ كُنْتُ رَاجِمًا امْرَأَةً بِغَيْرِ بَيِّنَةٍ لَرَجَمْتُهَا  » ؟ قَالَ : لَا ، قَالَ : تِلْكَ الْمَرْأَةُ  أَعْلَنَتْ  .","","Sunan Sa'id ibn Mansur 1564","","عبد الله بن عباس عن القاسم بن محمد بن أبي بكر الصديق عن أبو الزناد عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في اللعان"
"2743","1565  -  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مَصَّانَ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ، قَالَ : «  وَلَدُ الْمُلَاعَنَةِ يَلْحَقُ بِأُمِّهِ  ، وَإِنْ رَمَاهُ إِنْسَانٌ أَوْ رَمَى أُمَّهُ جُلِدَ  » .","","Sunan Sa'id ibn Mansur 1565","","الشعبي عن مصان عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في اللعان"
"2744","1566  -  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  وَلَدُ الْمُلَاعَنَةِ يَلْحَقُ بِأُمِّهِ ، وَيَعْقِلُونَ عَنْهُ  » .","","Sunan Sa'id ibn Mansur 1566","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء في اللعان"
"2745","1567  -  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  مَنْ  قَذَفَ  وَلَدَ الْمُلَاعَنَةِ بِأُمِّهِ جُلِدَ  » .","","Sunan Sa'id ibn Mansur 1567","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في اللعان"
"2746","بَابُ الرَّجُلِ يُطَلِّقُ امْرَأَتَهُ ثُمَّ يَقْذِفُهَا فِي عِدَّتِهَا  1568  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  هِشَامُ بْنُ حَسَّانَ ،  عَنْ  حِبَّانَ الْأَزْدِيِّ ،         [6/408]      عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ قَالَ فِي رَجُلٍ طَلَّقَ امْرَأَتَهُ ثُمَّ قَذَفَهَا فِي الْعِدَّةِ قَالَ : « إِنْ كَانَ طَلَّقَهَا ثَلَاثًا جُلِدَ  ، وَأُلْحِقَ بِهِ الْوَلَدُ ، وَلَمْ يُلَاعَنْ وَإِنْ طَلَّقَهَا وَاحِدَةً لَاعَنَهَا ، وَقَالَ ابْنُ عَبَّاسٍ :  إِنْ طَلَّقَهَا ثَلَاثًا ثُمَّ قَذَفَهَا فِي الْعِدَّةِ لَاعَنَهَا  ، وَقَالَ  جَابِرُ بْنُ زَيْدٍ  : قَوْلُ  ابْنِ عُمَرَ  أَحَبُّ إِلَيْنَا مِمَّا قَالَ  ابْنُ عَبَّاسٍ  .","","Sunan Sa'id ibn Mansur 1568","","عبد الله بن عمر بن الخطاب عن جابر بن زيد اليحمدي عن حبان الأزدي عن هشام بن حسان العتكي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2747","1569  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  هَارُونُ السُّلَمِيُّ ،  عَنْ  عَمْرِو بْنِ هُرْمُزَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1569","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن هرم الأزدي عن هارون بن زاذي السلمي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2748","1570  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  يُلَاعِنُهَا إِذَا طَلَّقَهَا ثَلَاثًا ، ثُمَّ قَذَفَهَا فِي الْعِدَّةِ  » .","","Sunan Sa'id ibn Mansur 1570","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2749","1571  -  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  هِشَامٍ ،  عَنِ  الْحَسَنِ ،  فِي رَجُلٍ يَقْذِفُ امْرَأَتَهُ ثُمَّ طَلَّقَهَا ثَلَاثًا قَالَ : « لَا يُلَاعِنُ  » .","","Sunan Sa'id ibn Mansur 1571","","الحسن البصري عن هشام بن حسان العتكي عن حماد بن زيد عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2750","1572  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا طَلَّقَهَا طَلَاقًا بَائِنًا ثُمَّ قَذَفَهَا فِي الْعِدَّةِ لَاعَنَهَا  » .","","Sunan Sa'id ibn Mansur 1572","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2751","1573  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّهُ سُئِلَ عَنْ رَجُلٍ ، طَلَّقَ امْرَأَتَهُ ثَلَاثًا ، ثُمَّ قَذَفَهَا فِي الْعِدَّةِ  قَالَ : « يُلَاعِنُهَا مَا كَانَتْ فِي الْعِدَّةِ فَإِذَا انْقَضَتِ الْعِدَّةُ جُلِدَ وَلَمْ يُلَاعِنْ  » .         [6/409]","","Sunan Sa'id ibn Mansur 1573","","الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2752","1574  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا  قَذَفَ  الرَّجُلُ امْرَأَتَهُ فَطَلَّقَهَا ثَلَاثًا لَاعَنَ  ، حَامِلًا كَانَتْ أَوْ غَيْرَ حَامِلٍ ، وَإِذَا طَلَّقَهَا ثَلَاثًا ثُمَّ قَذَفَهَا فِي الْعِدَّةِ ، فَإِنْ كَانَتْ حَامِلًا لَاعَنَهَا ، وَإِنْ لَمْ يَكُنْ حَمْلًا جُلِدَ  » .","","Sunan Sa'id ibn Mansur 1574","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2753","1575  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  لَا مُلَاعَنَةَ لِمَنْ لَا يَمْلِكُ الرَّجْعَةَ  » .","","Sunan Sa'id ibn Mansur 1575","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2754","1576  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّهُ سُئِلَ عَنْ رَجُلٍ ، طَلَّقَ امْرَأَتَهُ ثَلَاثًا فَجَاءَتْ بِحَمْلٍ فَانْتَفَى مِنْهُ  قَالَ : « يُلَاعِنُهَا ، فَقَالَ لَهُ  الْحَارِثُ الْعُكْلِيُّ  : يَا  أَبَا عُمَرَ  وَإِنَّ اللهَ يَقُولُ فِي كِتَابِهِ :         {      وَالَّذِينَ يَرْمُونَ أَزْوَاجَهُمْ         }      أَفَتَرَاهَا لَهُ زَوْجَةً وَقَدْ طَلَّقَهَا ثَلَاثًا ، فَقَالَ  الشَّعْبِيُّ  : لَأَسْتَحْيِي إِذَا رَأَيْتُ الْحَقَّ أَنْ أَرْجِعَ إِلَيْهِ  » .","","Sunan Sa'id ibn Mansur 1576","","الشعبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2755","1577  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّهُ سُئِلَ عَنْ رَجُلٍ ،  قَذَفَ  امْرَأَتَهُ ثُمَّ اخْتَلَعَتْ مِنْهُ  قَالَ : « إِنْ أَخَذَتْهُ بِالْقَذْفِ ، فَمَا كَذَّبَ نَفْسَهُ جُلِدَ ، وَكَانَ لَهُ مَا أَخَذَ مِنْهَا ، وَإِنْ لَاعَنَهَا رَدَّ عَلَيْهَا مَا أَخَذَ مِنْهَا  » .","","Sunan Sa'id ibn Mansur 1577","","الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2756","1578  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنِ  الْحَارِثِ الْعُكْلِيِّ ،  فِي رَجُلٍ  قَذَفَ         [6/410]      امْرَأَتَهُ ثُمَّ اخْتَلَعَتْ مِنْهُ  قَالَ : « هِيَ فَرَّتْ مِنَ الْمُلَاعَنَةِ فَلَا حَدَّ وَلَا لِعَانَ ، وَإِذَا طَلَّقَهَا بَعْدَ قَذْفِهِ إِيَّاهَا فَهُوَ فَرَّ مِنَ الْمُلَاعَنَةِ فَضُرِبَ  الْحَدَّ  ، وَلَا لِعَانَ  » .","","Sunan Sa'id ibn Mansur 1578","","الحارث بن يزيد العكلي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2757","1579  -  حَدَّثَنَا  هُشَيْمٌ ،  نَا  عُثْمَانُ الْبَتِّيُّ ،  عَنِ  الشَّعْبِيِّ ،  فِي رَجُلٍ  قَذَفَ  امْرَأَتَهُ بِشَيْءٍ قَبْلَ أَنْ يَتَزَوَّجَهَا ، قَالَ : « يُضْرَبُ ، وَيُلَاعِنُ  ، وَهِيَ امْرَأَتُهُ  » .","","Sunan Sa'id ibn Mansur 1579","","الشعبي عن عثمان بن مسلم عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2758","1580  -  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنِ  الشَّعْبِيِّ ، «  فِي أَرْبَعَةٍ شَهِدُوا عَلَى امْرَأَةٍ بِالزِّنَا ، أَحَدُهُمْ زَوْجُهَا  ، قَالَ : يُقَامُ عَلَيْهَا  الْحَدُّ  » .","","Sunan Sa'id ibn Mansur 1580","","الشعبي عن سليمان بن فيروز الشيباني عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2759","1581  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  الشَّيْبَانِيُّ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  إِذَا كَانُوا أَرْبَعَةً فَقَدْ أَحْرَزُوا ظُهُورَهُمْ مِنَ  الْحَدِّ  ، وَيُقَامُ عَلَيْهَا  الْحَدُّ  » . قَالَ الشَّيْبَانِيُّ :  وَأَنَا  حَمَّادٌ ،  عَنْ  إِبْرَاهِيمَ أَنَّهُ كَانَ يَقُولُ : «  يُلَاعِنُ الزَّوْجُ ، وَيُجْلَدُ الثَّلَاثَةُ  » .","","Sunan Sa'id ibn Mansur 1581","","الشعبي عن سليمان بن فيروز الشيباني عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2760","1582  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي أَرْبَعَةٍ شَهِدُوا عَلَى امْرَأَةٍ بِالزِّنَا ، أَحَدُهُمْ زَوْجُهَا  قَالَ : « يُلَاعِنُ الزَّوْجُ وَيُجْلَدُ الثَّلَاثَةُ  » قَالَ  أَبُو الزِّنَادِ  ، وَهَذَا رَأْيُ أَهْلِ بَلَدِنَا ، وَهُوَ الْقَوْلُ .","","Sunan Sa'id ibn Mansur 1582","","عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2761","1583  -  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ،  أَخْبَرَنِي  مَعْمَرٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ : «  اللِّعَانُ تَطْلِيقَةٌ بَائِنَةٌ ، وَإِنْ يُكَذِّبْ نَفْسَهُ جُلِدَ ،  وَخَطَبَهَا إِنْ شَاءَ  » .         [6/411]","","Sunan Sa'id ibn Mansur 1583","","سعيد بن المسيب عن قتادة بن دعامة عن معمر بن راشد عن عبد الله بن المبارك عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2762","1584  -  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ : «  الْمُلَاعِنُ إِذَا كَذَّبَ نَفْسَهُ فِي مَكَانِهِ جُلِدَ  ، وَرُدَّتْ إِلَيْهِ امْرَأَتُهُ  » .","","Sunan Sa'id ibn Mansur 1584","","سعيد بن المسيب عن داود بن أبي هند عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2763","1585  -  حَدَّثَنَا  عَتَّابُ بْنُ بَشِيرٍ ،  أَنَا  خُصَيْفٌ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ :  إِذَا لَاعَنَ الرَّجُلُ امْرَأَتَهُ قَالَ : « إِنْ أَكْذَبَ نَفْسَهُ وَهِيَ فِي الْعِدَّةِ ضُرِبَ  ، وَتَزَوَّجَهَا إِنْ شَاءَ ، وَإِنْ لَمْ يُكَذِّبْ نَفْسَهُ حَتَّى تَنْقَضِيَ عِدَّتُهَا لَمْ يَتَزَوَّجْهَا  » .","","Sunan Sa'id ibn Mansur 1585","","سعيد بن جبير الأسدي عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2764","1586  -  حَدَّثَنَا  عَتَّابٌ ،  عَنْ  خُصَيْفٍ ،  عَنْ  حَمَّادٍ ، قَالَ : «  مَتَى أَكْذَبَ نَفْسَهُ فِي الْعِدَّةِ وَبَعْدَ الْعِدَّةِ تَزَوَّجَهَا إِنْ شَاءَ  » .","","Sunan Sa'id ibn Mansur 1586","","حماد بن أبي سليمان عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2765","1587  -  حَدَّثَنَا  عَتَّابٌ ،  عَنْ  خُصَيْفٍ ،  عَنِ  الشَّعْبِيِّ ،  فِي الرَّجُلِ يَتَزَوَّجُ الْمَرْأَةَ وَهِيَ بِبَلَدٍ آخَرَ فَيَقْذِفُهَا وَلَمْ يَرَهَا  قَالَ : « يُجْلَدُ وَلَا لِعَانَ بَيْنَهُمَا ، وَذَكَرَ أَنَّ الْأَعْمَى بِتِلْكَ الْمَنْزِلَةِ ، وَكُلَّ مَنْ لَا تَجُوزُ شَهَادَتُهُ » .  قَالَ  خُصَيْفٌ :  قَالَ  حَمَّادٌ : «  كُلُّ مَخْرَجٍ جَعَلَهُ اللهُ لِلزَّوْجِ ، فَإِنْ رَآهَا أَوْ لَمْ يَرَهَا فَإِنَّهُمَا يَتَلَاعَنَانِ  ، وَالْأَعْمَى وَمَنْ لَا تَجُوزُ شَهَادَتُهُ كَذَلِكَ ، وَالْمُرْتَدُّ كَذَلِكَ  » .","","Sunan Sa'id ibn Mansur 1587","","الشعبي عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2766","1588  -  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنِ  الشَّعْبِيِّ ،  فِي رَجُلٍ         [6/412]      طَلَّقَ امْرَأَتَهُ قَبْلَ أَنْ يَدْخُلَ بِهَا ، فَجَاءَتْ بِوَلَدٍ فَانْتَقَى مِنْهُ  قَالَ : « يُلَاعِنُهَا وَلَهَا نِصْفُ الصَّدَاقِ  » .","","Sunan Sa'id ibn Mansur 1588","","الشعبي عن سليمان بن فيروز الشيباني عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2767","1589  -  حَدَّثَنَا  عَتَّابُ بْنُ بَشِيرٍ ،  أَنَا  خُصَيْفٌ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي الرَّجُلِ يَقْذِفُ امْرَأَتَهُ ثُمَّ يَمُوتُ قَبْلَ أَنْ يُلَاعِنَهَا  قَالَ : « يُوقَفُ فَإِنْ أَكْذَبَ نَفْسَهُ جُلِدَ  الْحَدَّ  وَوَرِثَ ، وَإِنْ جَاءَ بِالشُّهُودِ وَرِثَ ، وَإِنِ الْتَعَنَ لَمْ يُوَرَّثْ  »  .","","Sunan Sa'id ibn Mansur 1589","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2768","1590  -  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُغِيرَةَ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ  ثُمَّ  رَجُلٌ  قَذَفَ  امْرَأَتَهُ ثُمَّ مَاتَتْ قَالَ : « إِنْ أَكْذَبَ نَفْسَهُ جُلِدَ وَوَرِثَهَا  ، وَإِنْ لَاعَنَهَا بَرِئَ مِنَ الْجَلْدِ وَالْمِيرَاثِ  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، ولعل الصواب : ( في )","","Sunan Sa'id ibn Mansur 1590","","الشعبي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2769","1591  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  نَا  عَبْدُ الْعَزِيزِ ،  عَنِ  الشَّعْبِيِّ ،  فِي رَجُلٍ يَقْذِفُ امْرَأَتَهُ فَلَا يَتَرَافَعَانِ أَنَّهُمَا عَلَى نِكَاحِهِمَا  : « لَا يُفَرِّقُ ذَلِكَ بَيْنَهُمَا إِلَّا أَنْ يُلَاعِنَهَا  » .","","Sunan Sa'id ibn Mansur 1591","","الشعبي عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2770","1592  -  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  عُمَرُ بْنُ بَشِيرٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :         [6/413]      سُئِلَ عَنْ رَجُلٍ  قَذَفَ  امْرَأَتَهُ وَهِيَ صَمَّاءُ خَرْسَاءُ  ، قَالَ  الشَّعْبِيُّ  : « لَيْسَ تَسْمَعُ وَلَا تَتَكَلَّمُ ، فَتُصَدِّقُهُ أَوْ تُكَذِّبُهُ ، لَيْسَ بَيْنَهُمَا حَدٌّ وَلَا لِعَانٌ  » .","","Sunan Sa'id ibn Mansur 1592","","الشعبي عن عمر بن بشير الهمداني عن أبو معاوية الضرير عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2771","1593  -  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِي مَعْشَرٍ ،  عَنْ  إِبْرَاهِيمَ ،  فِي الرَّجُلِ يَقْذِفُ امْرَأَتَهُ وَهِيَ فِي الْعِدَّةِ  قَالَ : « يُلَاعِنُهَا مَا كَانَتْ لَهُ عَلَيْهَا رَجْعَةٌ  » .","","Sunan Sa'id ibn Mansur 1593","","إبراهيم النخعي عن زياد بن كليب عن سعيد بن جبير الأسدي عن عبد الله بن المبارك عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2772","1594  -  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ، قَالَ :  أَخْبَرَنِي  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  فِي الرَّجُلِ يَقْذِفُ امْرَأَتَهُ ، وَيَشْهَدُ أَنَّهَا أُخْتُهُ مِنَ الرَّضَاعَةِ  قَالَ : « يُفَرَّقُ بَيْنَهُمَا وَلَهَا الصَّدَاقُ ، فَلَيْسَ بَيْنَهُمَا مُلَاعَنَةٌ  » .","","Sunan Sa'id ibn Mansur 1594","","الزهري عن معمر بن راشد عن عبد الله بن المبارك عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2773","1595  -  حَدَّثَنَا  ابْنُ عَيَّاشٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُبَيْدٍ الْكَلَاعِيِّ ،  عَنْ  مَكْحُولٍ ،  أَنَّهُ سُئِلَ «  عَنْ رَجُلٍ ، طَلَّقَ امْرَأَتَهُ تَطْلِيقَتَيْنِ ثُمَّ قَذَفَهَا ، فَإِنْ أَكْذَبَ نَفْسَهُ فَعَلَيْهِ  الْحَدُّ  ، وَيُرَاجِعُهَا إِنْ شَاءَ ، وَإِنْ هُوَ لَمْ يُكَذِّبْ نَفْسَهُ يُلَاعِنُهَا وَيُفَرَّقُ بَيْنَهُمَا وَلَمْ يَجْتَمِعَا أَبَدًا  » .","","Sunan Sa'id ibn Mansur 1595","","مكحول بن أبي مسلم عن عبيد الله بن عبيد الكلاعي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يطلق امرأته ثم يقذفها في عدتها"
"2774","بَابُ الرَّجُلِ يَقُولُ لِامْرَأَتِهِ : قَدْ وَهَبْتُكِ لِأَهْلِكِ  1596  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَبُو حُرَّةَ ، وَمَنْصُورٌ ،  عَنِ         [6/414]      الْحَسَنِ ، قَالَ : «  إِذَا وَهَبَهَا لِأَهْلِهَا ، فَقَبِلُوهَا فَهِيَ ثَلَاثٌ  ، وَإِنْ رَدُّوهَا فَوَاحِدَةٌ ، وَهُوَ أَحَقُّ بِهَا »  .","","Sunan Sa'id ibn Mansur 1596","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يقول لامرأته : قد وهبتك لأهلك"
"2775","1597  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  مُطَرِّفٌ ،  عَنِ  الْحَكَمِ ،  عَنْ  يَحْيَى بْنِ الْجَزَّارِ ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ أَنَّهُ كَانَ يَقُولُ : «  إِنْ قَبِلُوهَا فَهِيَ وَاحِدَةٌ بَائِنَةٌ ، وَإِنْ رَدُّوهَا فَهِيَ وَاحِدَةٌ  ، وَهُوَ أَحَقُّ بِهَا  » .","","Sunan Sa'id ibn Mansur 1597","","علي بن أبي طالب عن يحيى بن الجزار العرني عن الحكم بن عتيبة الكندي عن مطرف بن طريف عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يقول لامرأته : قد وهبتك لأهلك"
"2776","1598  -  حَدَّثَنَا  هُشَيْمٌ ،  أَنَا  أَشْعَثُ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : «  إِنْ قَبِلُوهَا فَوَاحِدَةٌ ، وَهُوَ أَحَقُّ بِهَا  ، وَإِنْ رَدُّوهَا فَلَا شَيْءَ  » .","","Sunan Sa'id ibn Mansur 1598","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن أشعث بن سوار عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يقول لامرأته : قد وهبتك لأهلك"
"2777","1599  -  حَدَّثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  كَانَ يُقَالُ فِي الْمَوْهُوبَةِ لِأَهْلِهَا : تَطْلِيقَةٌ  » .  قَالَ  مَنْصُورٌ :  بَلَغَنِي عَنِ  ابْنِ مَسْعُودٍ أَنَّهُ كَانَ يَقُولُ : «  إِنْ قَبِلُوهَا فَوَاحِدَةٌ ، وَإِنْ لَمْ يَقْبَلُوهَا فَلَا شَيْءَ  » .","","Sunan Sa'id ibn Mansur 1599","","عبد الله بن مسعود عن منصور بن المعتمر عن معتمر بن سليمان عن سعيد بن منصور","باب الرجل يقول لامرأته : قد وهبتك لأهلك"
"2778","1600  -  حَدَّثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُبَيْدٍ الْكَلَاعِيِّ ،  عَنْ  مَكْحُولٍ ، قَالَ : «  إِنْ قَبِلُوهَا فَهِيَ تَطْلِيقَةٌ ، وَهُوَ أَمْلَكُ بِهَا  ، وَإِنْ لَمْ يَقْبَلُوهَا ، فَلَا شَيْءَ  » .         [6/415]","","Sunan Sa'id ibn Mansur 1600","","مكحول بن أبي مسلم عن عبيد الله بن عبيد الكلاعي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يقول لامرأته : قد وهبتك لأهلك"
"2779","1601  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُبَيْدِ اللهِ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1601","","مسروق بن الأجدع عن الشعبي عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يقول لامرأته : قد وهبتك لأهلك"
"2780","1602  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  فِي الرَّجُلِ يَقُولُ لِامْرَأَتِهِ : قَدْ وَهَبْتُكِ لِأَهْلِكِ  قَالَ : « كَانُوا يَقُولُونَ : هِيَ تَطْلِيقَةٌ ، وَلَا يَدْرِي أَبَائِنَةٌ أَمْ يَمْلِكُ الرَّجْعَةَ  » .","","Sunan Sa'id ibn Mansur 1602","","إبراهيم النخعي عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب الرجل يقول لامرأته : قد وهبتك لأهلك"
"2781","بَابُ الطَّلَاقِ لَا رُجُوعَ فِيهِ  1603  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ، قَالَ :  أَخْبَرَنِي  عَبْدُ الرَّحْمَنِ بْنُ حَبِيبٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ مَاهَكَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  ثَلَاثٌ جِدُّهُنَّ جِدٌّ ، وَهَزْلُهُنَّ جِدٌّ ، الطَّلَاقُ ، وَالنِّكَاحُ ، وَالرَّجْعَةُ  » .","","Sunan Sa'id ibn Mansur 1603","","أبو هريرة الدوسي عن يوسف بن ماهك الفارسي عن عطاء بن أبي رباح عن عبد الرحمن بن حبيب بن أردك المخزومي عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب الطلاق لا رجوع فيه"
"2782","1604  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَبِي الدَّرْدَاءِ ، قَالَ : «  ثَلَاثٌ لَا يُلْعَبُ بِهِنَّ ، اللَّعِبُ فِيهِنَّ وَالْجِدُّ سَوَاءٌ  : الطَّلَاقُ ، وَالنِّكَاحُ ، وَالْعَتَاقُ  » .         [6/416]","","Sunan Sa'id ibn Mansur 1604","","أبو الدرداء عن الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الطلاق لا رجوع فيه"
"2783","1605  -  حَدَّثَنَا  سَعِيدٌ ، قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَبِي الدَّرْدَاءِ ، قَالَ : «  ثَلَاثٌ لَا يُلْعَبُ فِيهِنَّ : الطَّلَاقُ ، وَالْعِتْقُ ، وَالنِّكَاحُ  » .","","Sunan Sa'id ibn Mansur 1605","","أبو الدرداء عن الحسن البصري عن يونس بن عبيد عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الطلاق لا رجوع فيه"
"2784","1606  -  حَدَّثَنَا  سَعِيدٌ ، قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  خَالِدٌ ،  عَنِ  ابْنِ سِيرِينَ ،  عَنْ  عَبِيدَةَ السَّلْمَانِيِّ ، قَالَ : «  خَلَّتَانِ اللَّعِبُ فِيهِنَّ وَالْجِدُّ سَوَاءٌ : الطَّلَاقُ ، وَالنِّكَاحُ  » .","","Sunan Sa'id ibn Mansur 1606","","عبيدة بن عمرو السلماني عن محمد بن سيرين عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب الطلاق لا رجوع فيه"
"2785","1607  -  حَدَّثَنَا  سَعِيدٌ ، قَالَ :  نَا  سُفْيَانُ ،  عَنْ  مُسْلِمِ بْنِ أَبِي مَرْيَمَ ، قَالَ :  سَمِعْتُ  سَعِيدَ بْنَ الْمُسَيِّبِ ، قَالَ :  سَمِعْتُ  مَرْوَانَ بْنَ الْحَكَمِ ، عَلَى هَذَا الْمِنْبَرِ يَقُولُ : «  أَرْبَعٌ لَا رُجُوعَ فِيهَا إِلَّا الْوَفَاءُ : الْعَتَاقُ ، وَالطَّلَاقُ ، وَالنِّكَاحُ ، وَالنَّذْرُ  » .","","Sunan Sa'id ibn Mansur 1607","","مروان بن الحكم بن أبي العاص عن سعيد بن المسيب عن مسلم بن أبي مريم الأنصاري عن سفيان بن عيينة عن سعيد بن منصور","باب الطلاق لا رجوع فيه"
"2786","1608  -  حَدَّثَنَا  سَعِيدٌ ، قَالَ :  نَا  حَفْصُ بْنُ مَيْسَرَةَ الصَّنْعَانِيُّ ،  قَالَ  مُسْلِمُ بْنُ أَبِي مَرْيَمَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  قَالَ  مَرْوَانُ عَلَى مِنْبَرِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : «  أَرْبَعٌ لَيْسَ فِيهِنَّ رَدِيدًا  إِلَّا الْوَفَاءُ : الطَّلَاقُ ، وَالْعَتَاقُ ، وَالنِّكَاحُ ، وَالنُّذُورُ  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : كذا في ص ، والصواب في رسمه ( رديدي ) بكسر الراء وتشديد الدال الأولى مع كسرها وآخره ألف مقصورة وهو مصدر ( رد ) ، يرد بمعنى الصرف والتحويل ، وفي النهاية : لا رديدي في الصدقة","","Sunan Sa'id ibn Mansur 1608","","مروان بن الحكم بن أبي العاص عن سعيد بن المسيب عن مسلم بن أبي مريم الأنصاري عن حفص بن ميسرة العقيلي عن سعيد بن منصور","باب الطلاق لا رجوع فيه"
"2787","1609  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو شِهَابٍ ،  عَنْ  حَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  سُلَيْمَانَ سُحَيْمٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  قَالَ  عُمَرُ رَضِيَ اللهُ عَنْهُ : «  أَرْبَعٌ جَائِزَاتٌ         [6/417]      إِذَا تُكُلِّمَ بِهِنَّ : الطَّلَاقُ ، وَالْعَتَاقُ ، وَالنِّكَاحُ ، وَالنُّذُورُ  ، وَأَرْبَعٌ يُمْسُونَ وَاللهُ عَلَيْهِمْ سَاخِطٌ ، وَيُصْبِحُونَ وَاللهُ عَلَيْهِمْ غَضْبَانُ : الْمُتَشَبِّهُونَ مِنَ الرِّجَالِ بِالنِّسَاءِ ، وَالْمُتَشَبِّهَاتُ مِنَ النِّسَاءِ بِالرِّجَالِ ، وَمَنْ غَشِيَ بَهِيمَةً ، وَمَنْ عَمِلَ بِعَمَلِ  قَوْمِ لُوطٍ  » .","","Sunan Sa'id ibn Mansur 1609","","عمر بن الخطاب عن سعيد بن المسيب عن سليمان بن سحيم  الحجازي عن حجاج بن أرطاة عن عبد ربه بن نافع الحناط عن سعيد بن منصور","باب الطلاق لا رجوع فيه"
"2788","1610  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  حَجَّاجٌ ،  عَنْ  سُلَيْمَانَ بْنِ سُحَيْمٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عُمَرَ ، قَالَ : «  أَرْبَعَةٌ يُمْسِي اللهُ عَزَّ وَجَلَّ وَهُوَ عَلَيْهِمْ سَاخِطٌ ، وَيُصْبِحُ وَهُوَ عَلَيْهِمْ غَضْبَانُ  : الْمُتَشَبِّهُونَ مِنَ الرِّجَالِ بِالنِّسَاءِ ، وَالْمُتَشَبِّهَاتُ مِنَ النِّسَاءِ بِالرِّجَالِ ، وَالَّذِي يَأْتِي بَهِيمَةً ، وَالْعَامِلُ بِعَمَلِ  قَوْمِ لُوطٍ  » . وَقَالَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ : أَرْبَعٌ جَائِزَاتٌ عَلَى كُلِّ أَحَدٍ : الْعَتَاقُ ، وَالطَّلَاقُ ، وَالنُّذُورُ ، وَالنِّكَاحُ  .","","Sunan Sa'id ibn Mansur 1610","","عمر بن الخطاب عن سعيد بن المسيب عن سليمان بن سحيم  الحجازي عن حجاج بن أرطاة عن أبو معاوية الضرير عن سعيد بن منصور","باب الطلاق لا رجوع فيه"
"2789","1611  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَلْقَمَةَ الْفَرْوِيُّ ، قَالَ :  أَنَا  يَزِيدُ بْنُ أَبِي عَمْرٍو ، قَالَ :  دَخَلَ الْقَاسِمُ بْنُ مُحَمَّدٍ عَلَى  النَّصْرِيِّ  ، وَهُوَ أَمِيرُ  الْمَدِينَةِ  ، فَقَالَ :  إِنَّ يَتِيمَكَ هَذَا قَدْ حَلَفَ بِالطَّلَاقِ ، وَالْعِتَاقِ قَالَ  الْقَاسِمُ  : « أَمَّا الطَّلَاقُ فَإِلَيْهِ ، وَأَمَّا الْعَتَاقُ فَإِلَيَّ  » .         [6/418]","","Sunan Sa'id ibn Mansur 1611","","القاسم بن محمد بن أبي بكر الصديق عن يزيد بن أبي عمرو الشعوبي عن عبد الله بن محمد بن عبد الله الفروي عن سعيد بن منصور","باب الطلاق لا رجوع فيه"
"2790","1612  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَلْقَمَةَ ، قَالَ :  نَا  إِسْحَاقُ ،  عَنْ  أَبِي بُكَيْرِ بْنِ مُحَمَّدٍ ، قَالَ :  كَتَبَ  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ : «  مَا رَخَّصْتُ فِيهِ مِنْ شَيْءٍ ، فَلَا تُرَخِّصْ لِلسُّفَهَاءِ فِي الطَّلَاقِ  » .","","Sunan Sa'id ibn Mansur 1612","","عمر بن عبد العزيز بن مروان عن أبو بكر بن محمد الخزرجي عن إسحاق بن أبي فروة عن عبد الله بن محمد بن عبد الله الفروي عن سعيد بن منصور","باب الطلاق لا رجوع فيه"
"2791","بَابُ الرَّجُلِ يَجْعَلُ أَمْرَ امْرَأَتِهِ بِيَدِهَا .  1613  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  مَسْرُوقٍ ، قَالَ :  جَاءَ رَجُلٌ إِلَى  عُمَرَ  رَضِيَ اللهُ عَنْهُ فَقَالَ : إِنِّي جَعَلْتُ أَمْرَ امْرَأَتِي بِيَدِهَا ، فَطَلَّقَتْ نَفْسَهَا ثَلَاثًا  ، فَقَالَ  عُمَرُ  لِعَبْدِ اللهِ : مَا تَرَى ؟  قَالَ  : « أُرَاهَا وَاحِدَةً ، وَهُوَ أَحَقُّ بِهَا ،  قَالَ  عُمَرُ : وَأَنَا أَرَى ذَلِكَ  » .","","Sunan Sa'id ibn Mansur 1613","","عبد الله بن مسعود عن مسروق بن الأجدع عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2792","1614  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  فِي الرَّجُلِ يَقُولُ لِامْرَأَتِهِ : أَمْرُكِ بِيَدِكِ فَتُطَلِّقُ نَفْسَهَا ثَلَاثًا  قَالَ : «  إِنَّ  عُمَرَ وَعَبْدَ اللهِ اجْتَمَعَا عَلَى أَنَّهَا وَاحِدَةٌ ، وَهُوَ أَحَقُّ بِهَا  » .","","Sunan Sa'id ibn Mansur 1614","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2793","1615  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  غَيْلَانَ بْنِ جَرِيرٍ ،  عَنْ  أَبِي الْحَلَالِ الْعَتَكِيِّ ، قَالَ :  سَأَلْتُ  عُثْمَانَ بْنَ عَفَّانَ رَضِيَ اللهُ عَنْهُ فَقُلْتُ :  يَا أَمِيرَ         [6/419]      الْمُؤْمِنِينَ ، إِنَّ رَجُلًا جَعَلَ أَمْرَ امْرَأَتِهِ بِيَدِهَا ؟ قَالَ : « فَأَمْرُهَا بِيَدِهَا  » .","","Sunan Sa'id ibn Mansur 1615","","عثمان بن عفان عن ربيعة بن زرارة العتكي عن غيلان بن جرير المعولي عن حماد بن زيد عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2794","1616  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  أَبِي رَبِيعَةَ بْنِ أَبِي الْحَلَالِ الْعَتَكِيِّ ،  عَنْ  أَبِيهِ  ،  أَنَّ  عُثْمَانَ بْنَ عَفَّانَ ، قَالَ فِي « أَمْرُكِ بِيَدِكِ : الْقَضَاءُ مَا قَضَتْ  » .","","Sunan Sa'id ibn Mansur 1616","","عثمان بن عفان عن ربيعة بن زرارة العتكي عن زرارة بن أبي الحلال العتكي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2795","1617  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  فِي رَجُلٍ جَعَلَ أَمْرَ امْرَأَتِهِ بِيَدِهَا ، فَرَدَّتْ إِلَيْهِ الْأَمْرَ  قَالَ : « لَيْسَ شَيْءٌ ، الْقَضَاءُ مَا قَضَتْ  » .","","Sunan Sa'id ibn Mansur 1617","","سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن حماد بن زيد عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2796","1618  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  نَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، أَنَّهُ كَانَ يَقُولُ :  الْقَضَاءُ مَا قَضَتْ  .","","Sunan Sa'id ibn Mansur 1618","","سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2797","1619  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّهُ كَانَ يَقُولُ : «  الْقَضَاءُ مَا قَضَتْ  » .","","Sunan Sa'id ibn Mansur 1619","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2798","1620  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : «  إِذَا جَعَلَ الرَّجُلُ أَمْرَ امْرَأَتِهِ بِيَدِهَا فَطَلَّقَتْ نَفْسَهَا         [6/420]      وَاحِدَةً فَهِيَ وَاحِدَةٌ ، أَوِ اثْنَتَيْنِ فَثِنْتَيْنِ ، أَوْ ثَلَاثًا فَثَلَاثٌ ، إِلَّا أَنْ يُنَاكِرَهَا وَيَقُولَ : لَمْ أَجْعَلِ الْأَمْرَ إِلَيْكِ إِلَّا فِي وَاحِدَةٍ ، فَيَحْلِفُ عَلَى ذَلِكَ ، وَإِنْ رَدَّتِ الْأَمْرَ فَلَيْسَ بِشَيْءٍ ، وَكَانَ يَقُولُ : الْقَضَاءُ مَا قَضَتْ  » .","","Sunan Sa'id ibn Mansur 1620","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن حماد بن زيد عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2799","1621  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ وَغَيْرِهِ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ ، قَالَ : «  إِذَا خَيَّرَ الرَّجُلُ امْرَأَتَهُ فَطَلَّقَتْ نَفْسَهَا ثَلَاثًا فَهِيَ وَاحِدَةٌ  » .","","Sunan Sa'id ibn Mansur 1621","","زيد بن ثابت الأنصاري عن وغيره عن أبو الزناد عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2800","1622  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ كَانَ يَقُولُ :  إِذَا خَيَّرَ الرَّجُلُ امْرَأَتَهُ فَلَمْ يَقُلْ شَيْئًا حَتَّى يَفْتَرِقَا  قَالَ : « سُكُوتُهَا رِضًى بِزَوْجِهَا ، لَيْسَ لَهَا أَنْ تَخْتَارَ كُلَّمَا شَاءَتْ  » .","","Sunan Sa'id ibn Mansur 1622","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2801","1623  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  نَا  أَبُو إِسْحَاقَ الْكُوفِيُّ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  وَإِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ  ،  عَنِ  الشَّعْبِيِّ ، أَنَّهُمَا قَالَا مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1623","","الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2802","1624  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ، قَالَ : «  إِذَا قَالَ الرَّجُلُ لِامْرَأَتِهِ : أَمْرُكِ بِيَدِكِ ، فَهُوَ مَا قَالَتْ فِي مَجْلِسِهَا  ، فَإِنْ تَفَرَّقَا فَلَيْسَ بِشَيْءٍ ، لَيْسَ لَهُ أَنْ يَمْشِيَ فِي السُّوقِ وَطَلَاقُ امْرَأَتِهِ بِيَدِ غَيْرِهِ  » .         [6/421]","","Sunan Sa'id ibn Mansur 1624","","جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2803","1625  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  يَزِيدُ بْنُ هَارُونَ ،  عَنْ  حَجَّاجٍ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  أَنَّ  ابْنَ مَسْعُودٍ ، قَالَ فِي "" أَمْرُكِ بِيَدِكِ "" : « إِذَا قَامَتْ مِنْ مَجْلِسِهَا فَلَا خِيَارَ لَهَا  » .","","Sunan Sa'id ibn Mansur 1625","","عبد الله بن مسعود عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن حجاج بن أرطاة عن يزيد بن هارون عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2804","1626  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  الْأَشْعَثُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ : «  إِذَا قَامَتْ مِنْ مَجْلِسِهَا قَبْلَ أَنْ تَخْتَارَ فَلَا خِيَارَ لَهَا  » .","","Sunan Sa'id ibn Mansur 1626","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن أشعث بن سوار عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2805","1627  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَبْدُ الْمَلِكِ ،  عَنْ  عَطَاءٍ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا خَيَّرَ الرَّجُلُ امْرَأَتَهُ فَاخْتَارَتْ زَوْجَهَا فَلَا شَيْءَ  ، وَإِنِ اخْتَارَتْ نَفْسَهَا فَوَاحِدَةٌ وَهُوَ أَحَقُّ بِهَا  » .","","Sunan Sa'id ibn Mansur 1627","","عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2806","1628  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُبَيْدٍ الْكَلَاعِيِّ ،  عَنْ  مَكْحُولٍ ، قَالَ : «  إِذَا جَعَلَ الرَّجُلُ أَمْرَ امْرَأَتِهِ بِيَدِهَا فَأَرْحَتْ ذَلِكَ  ، فَلَا شَيْءَ لَهَا  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : كذا في ص ، والصواب : فأرجت ، يعني: فأرجأت أي: أخرت","","Sunan Sa'id ibn Mansur 1628","","مكحول بن أبي مسلم عن عبيد الله بن عبيد الكلاعي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2807","1629  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1629","","عطاء بن أبي رباح عن ابن جريج عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2808","1630  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنِ  الْحَجَّاجِ ،  عَنِ  الْحَكَمِ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ رَجُلًا كَتَبَ إِلَى امْرَأَتِهِ يُخَيِّرُهَا فَوَضَعَتِ الْكِتَابَ تَحْتَ الْفِرَاشِ         [6/422]      فَلَمْ تَقُلْ شَيْئًا  قَالَ : « فَلَا خِيَارَ لَهَا  » .","","Sunan Sa'id ibn Mansur 1630","","إبراهيم النخعي عن الحكم بن عتيبة الكندي عن حجاج بن أرطاة عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2809","1631  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  إِذَا خَيَّرَ الرَّجُلُ امْرَأَتَهُ ثَلَاثَ مَرَّاتٍ فَاخْتَارَتْ مَرَّةً وَاحِدَةً فَهِيَ ثَلَاثٌ  ، وَإِذَا خَيَّرَهَا مَرَّةً وَاحِدَةً فَاخْتَارَتْ ثَلَاثًا فَوَاحِدَةٌ  » .","","Sunan Sa'id ibn Mansur 1631","","الشعبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2810","1632  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ قَالَ مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1632","","إبراهيم النخعي عن حماد بن أبي سليمان عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2811","1633  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  بَيَانٍ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  وَمُغِيرَةَ  ،  عَنْ  إِبْرَاهِيمَ ، وَعَامِرٍ ،  قَالَا  فِي رَجُلٍ قَالَ لِامْرَأَتِهِ : اخْتَارِي ، اخْتَارِي ، اخْتَارِي ، فَاخْتَارَتْ مَرَّةً وَاحِدَةً قَالَا : هِيَ ثَلَاثٌ  وَإِنْ قَالَ لَهَا : اخْتَارِي فَاخْتَارَتْ ثَلَاثًا فَهِيَ وَاحِدَةٌ  .","","Sunan Sa'id ibn Mansur 1633","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2812","1634  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  إِذَا جَعَلَ الرَّجُلُ أَمْرَ امْرَأَتِهِ بِيَدِ غَيْرِهَا فَطَلَّقَهَا ثَلَاثًا ، فَهِيَ وَاحِدَةٌ  ، وَهُوَ أَحَقُّ بِهَا  » .","","Sunan Sa'id ibn Mansur 1634","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2813","1635  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ، وَيُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا جَعَلَ الرَّجُلُ أَمْرَ امْرَأَتِهِ بِيَدِ غَيْرِهَا فَالْقَضَاءُ مَا قَضَى  ، فَإِنْ رَدَّهَا فَوَاحِدَةٌ ، وَهُوَ أَحَقُّ بِهَا  » .","","Sunan Sa'id ibn Mansur 1635","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2814","1636  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْحَجَّاجِ ،  عَنِ  ابْنِ أَبِي         [6/423]      نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  قَالَ  ابْنُ مَسْعُودٍ : «  إِذَا جَعَلَ الرَّجُلُ أَمْرَ امْرَأَتِهِ بِيَدِ رَجُلٍ فَقَامَ الرَّجُلُ قَبْلَ أَنْ يَقْضِيَ فِي ذَلِكَ شَيْئًا ، فَلَا أَمْرَ لَهُ  » .","","Sunan Sa'id ibn Mansur 1636","","عبد الله بن مسعود عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن حجاج بن أرطاة عن أبو معاوية الضرير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2815","1637  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ ،  فِي رَجُلٍ جَعَلَ أَمْرَ امْرَأَتِهِ بِيَدِ رَجُلَيْنِ فَطَلَّقَ أَحَدُهُمَا  قَالَ : « لَا ، حَتَّى يَجْتَمِعَا جَمِيعًا  » .","","Sunan Sa'id ibn Mansur 1637","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2816","1638  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عُبَيْدَةُ ،  عَنْ  إِبْرَاهِيمَ مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1638","","إبراهيم النخعي عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2817","1639  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ امْرَأَةً ، قَالَتْ لِزَوْجِهَا : لَوْ أَنَّ الَّذِي بِيَدِكَ مِنْ أَمْرِي بِيَدِي لَفَارَقْتُكَ  قَالَ لَهَا : فَأَمْرُكِ بِيَدِكِ قَالَتْ : أَنْتَ طَالِقٌ ثَلَاثًا ، فَرُفِعَ ذَلِكَ إِلَى عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ فَغَضِبَ مِنْ ذَلِكَ ،  وَقَالَ  : « تَعْمِدُونَ إِلَى أَمْرٍ جَعَلَهُ اللهُ بِأَيْدِيكُمْ فَتَجْعَلُونَهُ بِأَيْدِيهِنَّ » ، ثُمَّ قَالَ : « وَاحِدَةٌ وَأَنْتَ أَحَقُّ بِرَجْعَتِهَا  » .","","Sunan Sa'id ibn Mansur 1639","","عمر بن الخطاب عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2818","1640  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ الصَّمَدِ الْعَمِّيُّ ، قَالَ :  نَا  مَنْصُورٌ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  أَنَّ امْرَأَةً قَالَتْ لِزَوْجِهَا : لَوْ أَنَّ الَّذِي بِيَدِكَ بِيَدِي لَعَلِمْتَ مَا أَصْنَعُ  قَالَ : فَإِنَّ مَا بِيَدِي مِنْ أَمْرِكِ بِيَدِكِ فَقَالَتْ : قَدْ طَلَّقْتُكَ ثَلَاثًا ، فَأَتَوُا ابْنَ مَسْعُودٍ فَسَأَلُوهُ ،  فَقَالَ  عَبْدُ اللهِ  : فَعَلَ اللهُ بِالرِّجَالِ عَمَدُوا إِلَى شَيْءٍ جَعَلَهُ اللهُ فِي أَيْدِيهِمْ فَوَلَّوْهُ غَيْرَهُمْ ، فَهِيَ وَاحِدَةٌ وَسَأَسْأَلُ أَمِيرَ الْمُؤْمِنِينَ فَسَأَلَهُ ،  فَقَالَ  عُمَرُ رَضِيَ اللهُ عَنْهُ : « فِي فِيهَا التُّرَابُ ، ثَلَاثَ مَرَّاتٍ ، ثُمَّ قَالَ  لِابْنِ         [6/424]      مَسْعُودٍ  : « مَا قُلْتَ فِيهَا ؟ قَالَ : قُلْتُ : وَاحِدَةٌ ، قَالَ : ذَاكَ رَأْيُكَ ؟ قَالَ : نَعَمْ ، قَالَ : وَكَذَلِكَ رَأْيِي ، وَلَوْ رَأَيْتَ غَيْرَ ذَلِكَ لَمْ تُصِبْ  .","","Sunan Sa'id ibn Mansur 1640","","عمر بن الخطاب عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن عبد العزيز بن عبد الصمد العمي عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2819","1641  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، قَالَ :  قَالَ  ابْنُ عَبَّاسٍ : «  خَطَّأَ  اللهُ نَوْءَهَا  » .","","Sunan Sa'id ibn Mansur 1641","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن حماد بن زيد عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2820","1642  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّهُ سُئِلَ عَنْ رَجُلٍ جَعَلَ أَمْرَ امْرَأَتِهِ بِيَدِهَا فَقَالَتْ ، أَنْتَ الطَّلَاقُ أَنْتَ الطَّلَاقُ  ، فَقَالَ  ابْنُ عَبَّاسٍ  : «  خَطَّأَ  اللهُ نَوْءَهَا  » .","","Sunan Sa'id ibn Mansur 1642","","عبد الله بن عباس عن عطاء بن أبي رباح عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2821","1643  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :         [6/425]      ذُكِرَ عِنْدَهُ قَوْلُ  ابْنِ عَبَّاسٍ  ، فَقَالَ : « هُمَا سَوَاءٌ  » .","","Sunan Sa'id ibn Mansur 1643","","إبراهيم النخعي عن منصور بن المعتمر عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2822","1644  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  شُعَيْبِ بْنِ الْحَبْحَابِ ،  عَنْ  إِبْرَاهِيمَ ،  قَالَ  :  ذُكِرَ عِنْدَ عَائِشَةَ رَضِيَ اللهُ عَنْهَا الْخِيَارُ ، فَقَالَتْ :  قَدْ خَيَّرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَاخْتَرْنَاهُ ، فَلَمْ يُعَدَّ ذَلِكَ طَلَاقًا  .","","Sunan Sa'id ibn Mansur 1644","","عائشة بنت أبي بكر الصديق عن إبراهيم النخعي عن شعيب بن الحبحاب المعولي عن حماد بن زيد عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2823","1645  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  سُلَيْمَانَ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ ، رَضِيَ اللهُ عَنْهَا قَالَتْ : «  خَيَّرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَاخْتَرْنَاهُ  ، فَلَمْ يَعُدَّهَا طَلَاقًا  » .","","Sunan Sa'id ibn Mansur 1645","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2824","1646  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مَسْرُوقٍ ،  أَنَّ  عَائِشَةَ ، رَضِيَ اللهُ عَنْهَا قَالَتْ : «  خَيَّرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَاخْتَرْنَاهُ  فَلَمْ يَعُدَّهَا عَلَيْنَا شَيْئًا  » .","","Sunan Sa'id ibn Mansur 1646","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2825","1647  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَائِشَةَ ، رَضِيَ اللهُ عَنْهَا قَالَتْ : «  خَيَّرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَاخْتَرْنَاهُ  ، فَلَمْ يَكُنْ طَلَاقًا  »  .","","Sunan Sa'id ibn Mansur 1647","","عائشة بنت أبي بكر الصديق عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2826","1648  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  بَيَانٍ ،  عَنْ  عَامِرٍ ، قَالَ :  سَأَلَنِي  عَبْدُ الْحَمِيدِ  عَنِ الْخِيَارِ ،  فَقُلْتُ  : كَانَ عَبْدُ اللهِ بْنُ مَسْعُودٍ يَقُولُ : «  إِنِ         [6/426]      اخْتَارَتْ نَفْسَهَا وَاحِدَةٌ  ، وَإِنِ اخْتَارَتْ زَوْجَهَا فَلَا شَيْءَ » .  قَالَ  عَلِيٌّ رَضِيَ اللهُ عَنْهُ : «  إِنِ اخْتَارَتْ زَوْجَهَا فَوَاحِدَةٌ  ، وَهُوَ أَحَقُّ بِهَا ، وَإِنِ اخْتَارَتْ نَفْسَهَا فَوَاحِدَةٌ بَائِنَةٌ » ،  وَقَالَ  زَيْدُ بْنُ ثَابِتٍ :  إِنِ اخْتَارَتْ نَفْسَهَا فَثَلَاثٌ  «  فَقَالَ  : اقْضِ فِيهَا بِقَوْلِ  عَبْدِ اللهِ  .","","Sunan Sa'id ibn Mansur 1648","","زيد بن ثابت الأنصاري عن الشعبي عن بيان بن بشر الأحمسي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2827","1649  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  عُمَرَ ، وَابْنَ مَسْعُودٍ  قَالَا  فِي الرَّجُلِ إِذَا خَيَّرَ امْرَأَتَهُ ، فَاخْتَارَتْ نَفْسَهَا ، فَهِيَ وَاحِدَةٌ وَهُوَ أَحَقُّ بِهَا  ، وَإِنِ اخْتَارَتْ زَوْجَهَا فَلَا شَيْءَ  .","","Sunan Sa'id ibn Mansur 1649","","عبد الله بن مسعود عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2828","1650  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  وَأَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ  أَنَّ  عَلِيًّا ، رَضِيَ اللهُ عَنْهُ كَانَ يَقُولُ : «  إِنِ اخْتَارَتْ نَفْسَهَا فَوَاحِدَةٌ بَائِنَةٌ  ، وَإِنِ اخْتَارَتْ زَوْجَهَا فَوَاحِدَةٌ وَهُوَ أَحَقُّ بِهَا  »  .","","Sunan Sa'id ibn Mansur 1650","","علي بن أبي طالب عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2829","1651  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ ، أَنَّهُ كَانَ يَقُولُ : «  إِنِ اخْتَارَتْ نَفْسَهَا  فَثَلَاثٌ  ، وَإِنِ اخْتَارَتْ نَفْسُهَا زَوْجَهَا فَوَاحِدَةٌ  » .         [6/427]      كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق: هنا في الأصل كلمة ( نفسها ) مزيدة خطأ ، وضع الناسخ فوقها ضبة إشارة إلى أنها ثابتة في أصله لكن إثباتها خطأ.","","Sunan Sa'id ibn Mansur 1651","","زيد بن ثابت الأنصاري عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2830","1652  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1652","","زيد بن ثابت الأنصاري عن الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2831","1653  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَسَنِ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ ، أَنَّهُ قَالَ : «  إِنِ اخْتَارَتْ نَفْسَهَا فَثَلَاثٌ  ، وَإِنِ اخْتَارَتْ زَوْجَهَا فَوَاحِدَةٌ وَهُوَ أَحَقُّ بِهَا  » .","","Sunan Sa'id ibn Mansur 1653","","زيد بن ثابت الأنصاري عن الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2832","1654  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ كَانَ يَقُولُ : «  أَمْرُكِ بِيَدِكِ ، وَاخْتَارِي هُمَا سَوَاءٌ  ، إِنِ اخْتَارَتْ نَفْسَهَا فَوَاحِدَةٌ وَهُوَ أَحَقُّ بِهَا ، وَإِنِ اخْتَارَتْ زَوْجَهَا فَلَا شَيْءَ  » .","","Sunan Sa'id ibn Mansur 1654","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2833","1655  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ، أَنَّهُ كَانَ يَقُولُ ذَلِكَ أَيْضًا .","","Sunan Sa'id ibn Mansur 1655","","مسروق بن الأجدع عن الشعبي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2834","1656  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  ابْنُ أَبِي لَيْلَى ،  عَنِ  الْحَكَمِ ،  أَنَّ  عَلِيًّا ، رَضِيَ اللهُ عَنْهُ كَانَ يَقُولُ : «  إِذَا جَعَلَ الْأَمْرَ بِيَدِهَا ، فَهُوَ بِيَدِهَا  ، فَمَا قَضَتْ فَهُوَ جَائِزٌ  » .","","Sunan Sa'id ibn Mansur 1656","","علي بن أبي طالب عن الحكم بن عتيبة الكندي عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2835","1657  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ، وَمَنْصُورٌ ،  عَنِ         [6/428]      الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا جَعَلَ الرَّجُلُ أَمْرَ امْرَأَتِهِ بِيَدِهَا فَقَدْ  بَانَتْ  بِثَلَاثٍ  » .","","Sunan Sa'id ibn Mansur 1657","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2836","1658  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو شِهَابٍ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  أَبِي جَعْفَرٍ ،  أَنَّهُ سُئِلَ عَنِ الْمُخَيَّرَةِ ، قَالَ : «  إِنِ اخْتَارَتْ زَوْجَهَا فَلَا شَيْءَ  » .","","Sunan Sa'id ibn Mansur 1658","","أبو جعفر الباقر عن حجاج بن أرطاة عن عبد ربه بن نافع الحناط عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2837","1659  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  أَنَّ  رَجُلًا خَرَجَ مِنْ عِنْدِ أَهْلِهِ ، وَهُوَ لَا يُنْكِرُ مِنْهُمْ شَيْئًا  ، فَوَجَدَ امْرَأَتَهُ ..... فَقَالَتْ : لَوْ أَنَّ الَّذِي بِيَدِكَ مِنْ أَمْرِي بِيَدِي لَعَلِمْتَ كَيْفَ أَصْنَعُ ، فَقَالَ الرَّجُلُ : فَنَعَمْ ، فَنَعَمْ ، فَارْتَفَعُوا إِلَى  أَبِي مُوسَى الْأَشْعَرِيِّ  فَأَخْبَرُوهُ بِقِصَّتِهِمْ ، فَقَالَ أَبُو مُوسَى : ذَاكَ بِكَ ، ذَاكَ بِكَ  .","","Sunan Sa'id ibn Mansur 1659","","أبو موسى الأشعري عن الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2838","1660  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو وَكِيعٍ ،  عَنِ  الْهَزْهَازِ بْنِ مَيْزَنٍ ،  أَنَّ  عَدِيَّ بْنَ فَرَسٍ  خَيَّرَ امْرَأَتَهُ ثَلَاثًا كُلُّ ذَلِكَ تَخْتَارُهُ  ، فَرُفِعَ إِلَى عَلِيٍّ رَضِيَ اللهُ عَنْهُ « فَفَرَّقَ بَيْنَهُمَا  » .  قَالَ سَعِيدٌ :  فَرَسٌ  جَدُّ  وَكِيعٍ  .","","Sunan Sa'id ibn Mansur 1660","","علي بن أبي طالب عن هزهاز بن ميزن الرؤاسي عن الجراح بن مليح الرؤاسي والد وكيع عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2839","1661  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْحَجَّاجُ ،  عَنْ  أَبِي         [6/429]      جَعْفَرٍ ،  أَنَّ  ابْنَ أَبِي عَتِيقٍ  جَعَلَ أَمْرَ امْرَأَتِهِ بِيَدِهَا ، فَطَلَّقَتْ نَفْسَهَا طَلَاقًا كَثِيرًا  ، فَسَأَلَ زَيْدَ بْنَ ثَابِتٍ فَقَالَ : « هِيَ وَاحِدَةٌ وَهُوَ أَحَقُّ بِهَا  » .","","Sunan Sa'id ibn Mansur 1661","","زيد بن ثابت الأنصاري عن أبو جعفر الباقر عن حجاج بن أرطاة عن أبو معاوية الضرير عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2840","1662  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ ، رَضِيَ اللهُ عَنْهَا  أَنَّهَا زَوَّجَتْ بِنْتًا  لِعَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  يُقَالُ لَهَا :  قُرَيْبَةُ  فَزَوَّجَتْهَا  مِنَ  الْمُنْذِرِ بْنِ الزُّبَيْرِ  فَقَدِمَ  عَبْدُ الرَّحْمَنِ  مِنْ غَيْبَتِهِ ، فَوَجَدَ مِنْ ذَلِكَ وَقَالَ : « أَمِثْلِي  يُفْتَاتُ  عَلَيْهِ فِي بَنَاتِهِ ؟ » فَقَالَتْ  عَائِشَةُ  : أَعَنِ  الْمُنْذِرِ بْنِ الزُّبَيْرِ  تَرْغَبُ ؟ لَنَجْعَلَنَّ أَمْرَهَا بِيَدِهِ ، فَجَعَلَ  الْمُنْذِرُ  أَمْرَ  بِنْتِ عَبْدِ الرَّحْمَنِ  بِيَدِهِ ، فَلَمْ يَقُلْ  عَبْدُ الرَّحْمَنِ  فِي ذَلِكَ شَيْئًا ، وَلَمْ يَرَوْا ذَلِكَ شَيْئًا  .","","Sunan Sa'id ibn Mansur 1662","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن يحيى بن سعيد الأنصاري عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2841","1663  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  سَعِيدِ بْنِ يُوسُفَ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ، قَالَ :  سُئِلَ  الْقَاسِمُ بْنُ مُحَمَّدٍ عَنْ رَجُلٍ قَالَ لِامْرَأَتِهِ : أَمْرُكِ بِيَدِكِ  ، فَقَالَتْ : قَدْ حُرِّمْتُ عَلَيْكَ ثَلَاثَ مَرَّاتٍ قَالَ : « هِيَ تَطْلِيقَةٌ وَاحِدَةٌ  » .","","Sunan Sa'id ibn Mansur 1663","","القاسم بن محمد بن أبي بكر الصديق عن يحيى بن أبي كثير عن سعيد بن يوسف الرحبي عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يجعل أمر امرأته بيدها"
"2842","بَابُ  أَلْبَتَّةِ  وَالْبَرِيَّةِ  وَالْخَلِيَّةِ  وَالْحَرَامِ .  1664  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  سَيَّارٌ ، وَإِسْمَاعِيلُ بْنُ         [6/430]      أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّ رَجُلًا كَانَ بِسَبِيلٍ مِنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ  ، فَقَالَ لِامْرَأَتِهِ : إِنْ أَتَيْتِ  أَهْلَ الْمُغِيرَةِ  فَأَنْتِ طَالِقٌ أَلْبَتَّةَ  . فَانْطَلَقَ الرَّجُلُ حَتَّى دَخَلَ عَلَى عُرْوَةَ بْنِ الْمُغِيرَةِ ، فَقَالَ  عُرْوَةُ  : مَرْحَبًا بِكَ أَبَا فُلَانٍ أَتَيْتَنَا ، وَقَدْ جَاءَتْنَا  أُمُّ بَكْرٍ  -  يَعْنِي امْرَأَتَهُ .  قَالَ : فَإِنَّهُ قَدْ طَلَّقَهَا أَلْبَتَّةَ ، فَأَفْتِنِي . فَأَرْسَلَ  عُرْوَةُ  يَسْأَلُ عَنْ ذَلِكَ ، فَأَخْبَرَهُ عَبْدُ اللهِ بْنُ شَدَّادِ بْنِ الْهَادِ  عَنْ  عُمَرَ رَضِيَ اللهُ عَنْهُ أَنَّهُ جَعَلَهَا وَاحِدَةً ،  وَأَخْبَرَهُ  رِيَاشٌ الطَّائِيُّ  أَنَّ  عَلِيًّا رَضِيَ اللهُ عَنْهُ قَالَ : « هِيَ ثَلَاثٌ »  . فَأَرْسَلَ عُرْوَةُ إِلَى  شُرَيْحٍ  يَسْأَلُهُ عَنْ ذَلِكَ ، فَقَالَ شُرَيْحٌ : أَمَّا قَوْلُهُ : طَالِقٌ ، فَهِيَ طَالِقٌ بِالسُّنَّةِ ، وَأَمَّا قَوْلُهُ : أَلْبَتَّةَ ، فَهِيَ بِدْعَةٌ نَقِفُهُ عِنْدَ بِدْعَتِهِ ، فَإِنْ شَاءَ تَقَدَّمَ ، وَإِنْ شَاءَ تَأَخَّرَ  .","","Sunan Sa'id ibn Mansur 1664","","علي بن أبي طالب عن رياش بن عمرو عن الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2843","1665  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ، بِنَحْوٍ مَنْ حَدِيثِ  سَيَّارٍ  وَإِسْمَاعِيلَ  ، قَالَ :  فَلَمَّا أَرْسَلَهُ إِلَى  شُرَيْحٍ  يَسْأَلُهُ عَنْ ذَلِكَ ،  قَالَ  شُرَيْحٌ :  إِنَّ اللهَ عَزَّ وَجَلَّ سَنَّ سُنَنًا ، وَإِنَّ الْعِبَادَ ابْتَدَعُوا بِدَعًا  ، فَعَمَدُوا إِلَى بِدْعَتِهِمْ فَخَلَطُوهَا بِسُنَنِ اللهِ ، فَإِذَا سُئِلْتُمْ عَنْ شَيْءٍ مِنْ ذَلِكَ فَمَيِّزُوا السُّنَنَ مِنَ الْبِدَعِ ، ثُمَّ امْضُوا بِالسُّنَنِ عَلَى وَجْهِهَا ، وَاجْعَلُوا الْبِدَعَ لِأَهْلِهَا ، وَأَمَّا قَوْلُهُ : طَالِقٌ ، فَهِيَ طَالِقٌ ، وَأَمَّا قَوْلُهُ : أَلْبَتَّةَ ، فَهِيَ بِدْعَةٌ ، نَقِفُهُ         [6/431]      عِنْدَ بِدْعَتِهِ ، فَإِنْ شَاءَ فَلْيَتَقَدَّمْ ، وَإِنْ شَاءَ فَلْيَتَأَخَّرْ  .","","Sunan Sa'id ibn Mansur 1665","","شريح بن الحارث الكندي عن الشعبي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2844","1666  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  الشَّيْبَانِيُّ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ ،  أَنَّ  عُمَرَ ، قَالَ : «  هِيَ وَاحِدَةٌ ، وَهُوَ أَحَقُّ بِهَا  »  .","","Sunan Sa'id ibn Mansur 1666","","عمر بن الخطاب عن عبد الله بن شداد بن الهاد الليثي عن الشعبي عن سليمان بن فيروز الشيباني عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2845","1667  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبَّادِ بْنِ جَعْفَرٍ ،  عَنِ  الْمُطَّلِبِ بْنِ حَنْطَبٍ ،  أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ  قَالَ لَهُ  فِي طَلَاقِ  أَلْبَتَّةِ  : «  أَمْسِكْ عَلَيْكَ امْرَأَتَكَ ، وَاحِدَةٌ تَبُتُّ  » .","","Sunan Sa'id ibn Mansur 1667","","عمر بن الخطاب عن المطلب بن عبد الله بن حنطب المخزومي عن محمد بن عباد بن جعفر المخزومي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2846","1668  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ ، قَالَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1668","","عمر بن الخطاب عن سليمان بن يسار مولى ميمونة زوج رسول الله عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2847","1669  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ « جَعَلَ أَلْبَتَّةَ وَاحِدَةً  ، وَهُوَ أَحَقُّ بِهَا  » .","","Sunan Sa'id ibn Mansur 1669","","عمر بن الخطاب عن سليمان بن يسار مولى ميمونة زوج رسول الله عن عمرو بن دينار الأثرم عن حماد بن زيد عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2848","1670  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ قَالَ : «  أَلْبَتَّةُ  وَاحِدَةٌ ، وَهُوَ أَحَقُّ بِهَا  » .","","Sunan Sa'id ibn Mansur 1670","","عمر بن الخطاب عن عبد الله بن شداد بن الهاد الليثي عن الشعبي عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2849","1671  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  ابْنُ الْمُبَارَكِ ، قَالَ :  نَا  ابْنُ الزُّبَيْرِ  ،  عَنْ         [6/432]      عَبْدِ اللهِ بْنِ عَلِيٍّ ،  أَنَّ  رُكَانَةَ بْنَ عَبْدِ يَزِيدَ  طَلَّقَ امْرَأَتَهُ أَلْبَتَّةَ ، فَأَتَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَ ذَلِكَ لَهُ ، فَقَالَ : «  مَا أَرَدْتَ » ؟ قَالَ : وَاحِدَةً . قَالَ : « اللهِ مَا أَرَدْتَ إِلَّا وَاحِدَةً  » ؟ قَالَ : « اللهِ مَا أَرَدْتُ إِلَّا وَاحِدَةً . قَالَ : « هِيَ وَاحِدَةٌ »  .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، ولعل الصواب : (الزبير بن سعيد) كما عند الترمذي وابن ماجه والطبراني وغيرهم ، وابن المبارك يروي عن الزبير بن سعيد كما في التهذيب وليس ابن الزبير ، والله أعلم.","","Sunan Sa'id ibn Mansur 1671","","عبد الله بن علي بن السائب المطلبي عن الزبير بن سعيد الهاشمي عن عبد الله بن المبارك عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2850","1672  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ، قَالَ :  سُئِلَ  الزُّهْرِيُّ عَنْ  أَلْبَتَّةِ  ، قَالَ : «  أَلْبَتَّةُ  عِنْدَنَا أَبَتُّ الطَّلَاقِ  » .","","Sunan Sa'id ibn Mansur 1672","","الزهري عن سفيان بن عيينة عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2851","1673  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  أَبِي بَكْرِ بْنِ مُحَمَّدٍ ،  أَنَّ  عُمَرَ بْنَ عَبْدِ الْعَزِيزِ  ، سَأَلَهُ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَهُ أَلْبَتَّةَ  ، فَقَالَ : كَانَ أَبَانُ بْنُ عُثْمَانَ يَجْعَلُهَا وَاحِدَةً ، وَهُوَ أَحَقُّ بِهَا . فَقَالَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ : « لَوْ أَنَّ الطَّلَاقَ كَانَ يَكُونُ أَلْفَ تَطْلِيقَةٍ ، لَبَلَغَهَا إِذَا قَالَ أَلْبَتَّةَ  » .","","Sunan Sa'id ibn Mansur 1673","","عمر بن عبد العزيز بن مروان عن أبو بكر بن محمد الخزرجي عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2852","1674  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَتَّابٌ ، قَالَ :  أَنَا  خُصَيْفٌ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ : «  أَلْبَتَّةُ  ثَلَاثٌ  »  .","","Sunan Sa'id ibn Mansur 1674","","سعيد بن المسيب عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2853","1675  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُغِيرَةَ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنْ  عُمَرَ ،  فِي رَجُلٍ قَالَ لِامْرَأَتِهِ : أَنْتِ طَالِقٌ أَلْبَتَّةَ  ، قَالَ : « هِيَ وَاحِدَةٌ ، وَهُوَ أَحَقُّ بِهَا  » .","","Sunan Sa'id ibn Mansur 1675","","عمر بن الخطاب عن الشعبي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2854","1676  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  فِي رَجُلٍ قَالَ لِامْرَأَتِهِ : أَنْتِ طَالِقٌ أَلْبَتَّةَ  ، قَالَ : « نِيَّتُهُ مَرَّةً ، أَوْ ثِنْتَيْنِ ، أَوْ ثَلَاثًا  » .         [6/433]","","Sunan Sa'id ibn Mansur 1676","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2855","1677  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  فِي رَجُلٍ قَالَ لِامْرَأَتِهِ : أَنْتِ مِنِّي بَرِيَّةٌ  ، قَالَ : « نِيَّتُهُ  » .","","Sunan Sa'id ibn Mansur 1677","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2856","1678  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ،  عَنِ  الْحَكَمِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ  أَنَّهُ كَانَ يَقُولُ فِي الْحَرَامِ ، وَأَلْبَتَّةِ ،  وَالْخَلِيَّةِ  ، وَالْبَرِيَّةِ : ثَلَاثٌ ، ثَلَاثٌ  .","","Sunan Sa'id ibn Mansur 1678","","علي بن أبي طالب عن إبراهيم النخعي عن الحكم بن عتيبة الكندي عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2857","1679  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ قَالَ فِي «  الْخَلِيَّةِ  ، وَالْبَرِيَّةِ ، وَأَلْبَتَّةِ : ثَلَاثٌ ثَلَاثٌ  » .","","Sunan Sa'id ibn Mansur 1679","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2858","1680  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ، قَالَ :  أَمَّا  حِفْظِي عَنِ  الْحَسَنِ ، أَنَّهُ قَالَ فِي  الْخَلِيَّةِ  : ثَلَاثٌ  . وَزَعَمَ حَفْصُ بْنُ سُلَيْمَانَ  أَنَّ  الْحَسَنَ قَالَ : « هِيَ وَاحِدَةٌ ، وَهُوَ أَحَقُّ بِهَا  » .","","Sunan Sa'id ibn Mansur 1680","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2859","1681  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَبُو حُرَّةَ ، وَأَشْعَثُ ،  عَنِ  الْحَسَنِ ،  أَنَّهُ قَالَ فِي «  الْخَلِيَّةِ  : وَاحِدَةٌ ، وَهُوَ أَحَقُّ بِهَا  » .","","Sunan Sa'id ibn Mansur 1681","","الحسن البصري عن واصل بن عبد الرحمن البصري عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2860","1682  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  نَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ، وَمُطَرِّفٌ ، أَنَّهُمَا  سَمِعَا  الشَّعْبِيَّ ، يَقُولُ :  إِنَّ نَاسًا يَزْعُمُونَ  أَنَّ  عَلِيًّا رَضِيَ اللهُ عَنْهُ قَالَ فِي الْحَرَامِ : هِيَ ثَلَاثٌ ، وَلَيْسَ كَذَلِكَ  ، وَلَأَنَا أَعْلَمُ بِمَا قَالَ مِمَّنْ رَوَى         [6/434]      ذَلِكَ عَنْهُ ، إِنَّمَا قَالَ : « لَا أُحَرِّمُهَا وَلَا أُحِلُّهَا ، إِنْ شِئْتَ فَتَقَدَّمْ ، وَإِنْ شِئْتَ فَتَأَخَّرْ  »  .","","Sunan Sa'id ibn Mansur 1682","","علي بن أبي طالب عن الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2861","1683  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَبُو بِشْرٍ ،  عَنْ  يُوسُفَ الْمَكِّيِّ ، قَالَ :  جَاءَ رَجُلٌ إِلَى ابْنِ عَبَّاسٍ ، فَقَالَ : إِنَّهُ جَعَلَ امْرَأَتَهُ عَلَيْهِ  حَرَامًا  .  قَالَ  : « فَلَيْسَتْ عَلَيْكَ  بِحَرَامٍ  . فَقَالَ الْأَعْرَابِيُّ : أَلَيْسَ اللهُ تَعَالَى يَقُولُ فِي كِتَابِهِ :         {      كُلُّ الطَّعَامِ كَانَ حِلا لِبَنِي إِسْرَائِيلَ إِلا مَا حَرَّمَ إِسْرَائِيلُ عَلَى نَفْسِهِ         }      ؟ فَضَحِكَ  ابْنُ عَبَّاسٍ  ، وَقَالَ : مَا يُدْرِيكَ مَا حَرَّمَ  إِسْرَائِيلُ  عَلَى نَفْسِهِ ؟ ثُمَّ أَقْبَلَ عَلَى  الْقَوْمِ  يُحَدِّثُهُمْ ، فَقَالَ : إِنَّ  إِسْرَائِيلَ  عَرَضَتْ لَهُ الْأَنْسَاءُ فَأَضْنَتْهُ ، فَجَعَلَ لِلهِ عَزَّ وَجَلَّ عَلَيْهِ إِنْ شَفَاهُ أَنْ لَا يَأْكُلَ  عِرْقًا  ، فَلِذَلِكَ الْيَهُودُ يَنْزِعُ الْعُرُوقَ مِنَ اللَّحْمِ  » .","","Sunan Sa'id ibn Mansur 1683","","عبد الله بن عباس عن يوسف بن ماهك الفارسي عن جعفر بن إياس اليشكري عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2862","1684  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّهُ  كَانَ يَقُولُ فِي رَجُلٍ  حَرَّمَ  عَلَيْهِ امْرَأَتَهُ ، قَالَ : « لَيْسَ بِشَيْءٍ  » .","","Sunan Sa'id ibn Mansur 1684","","الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2863","1685  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  فِي رَجُلٍ قَالَ : الْحِلُّ عَلَيْهِ حَرَامٌ ، قَالَ : « عَلَيْهِ كَفَّارَةُ يَمِينٍ  مَا لَمْ يَنْوِ امْرَأَتَهُ  » .         [6/435]","","Sunan Sa'id ibn Mansur 1685","","الحسن البصري عن يونس بن عبيد عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2864","1686  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  أَنَّهُ كَانَ يَقُولُ فِي رَجُلٍ جَعَلَ كُلَّ حَلَالِ عَلَيْهِ حَرَامًا ، قَالَ : « هِيَ يَمِينٌ  ، إِلَّا أَنْ يَنْوِيَ امْرَأَتَهُ  » .","","Sunan Sa'id ibn Mansur 1686","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2865","1687  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حَجَّاجٌ ، عَمَّنْ  حَدَّثَهُ  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ قَالَ مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1687","","إبراهيم النخعي عن عمن عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2866","1688  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حَجَّاجٌ ،  عَنْ  عَطَاءٍ ، أَنَّهُ قَالَ : «  إِذَا قَالَ الرَّجُلُ : كُلُّ حَلَالٍ عَلَيْهِ حَرَامٌ ، فَهِيَ يَمِينٌ يَتَكَفَّرُهَا  » .","","Sunan Sa'id ibn Mansur 1688","","عطاء بن أبي رباح عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2867","1689  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  عُبَيْدٍ الْمُكْتِبِ ، قَالَ :  ذُبِحَتْ بَقَرَةٌ فِي الْحَيِّ ، فَقَالَ رَجُلٌ : الْحِلُّ عَلَيْهِ حَرَامٌ إِنْ أَكَلَ مِنْهَا  ، فَسُئِلَ إِبْرَاهِيمُ ، فَقَالَ : « لَوْلَا امْرَأَتُهُ لَأَمَرْتُهُ أَنْ يَأْكُلَ  » .","","Sunan Sa'id ibn Mansur 1689","","إبراهيم النخعي عن عبيد بن مهران المكتب عن جرير بن عبد الحميد عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2868","1690  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  عُبَيْدٍ الْمُكْتِبِ ، قَالَ :  سُئِلَ  إِبْرَاهِيمُ ، قَالَ : « لَوْلَا امْرَأَتُكَ لَأَمَرْتُكَ أَنْ تَأْكُلَ مِنْ لَحْمِهَا  » .","","Sunan Sa'id ibn Mansur 1690","","إبراهيم النخعي عن عبيد بن مهران المكتب عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2869","1691  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  إِنْ نَوَى طَلَاقًا ، وَإِلَّا فَلَيْسَ بِشَيْءٍ  » .         [6/436]","","Sunan Sa'id ibn Mansur 1691","","إبراهيم النخعي عن حماد بن أبي سليمان عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2870","1692  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  قُرَيْرٌ  ،  عَنْ  عِيسَى بْنِ عُمَرَ الْفَارِقِيِّ الْحِزَامِيِّ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  فِيمَنْ قَالَ : الْحِلُّ عَلَيْهِ حَرَامٌ : « يَمِينٌ مِنَ الْأَيْمَانِ يُكَفِّرُهَا  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، ولعل الصواب : (جرير) كما أشار المحقق ، والله أعلم.","","Sunan Sa'id ibn Mansur 1692","","سعيد بن جبير الأسدي عن عمرو بن مرة المرادي عن عيسى بن عمر بن موسى الحجازي عن جرير بن عبد الحميد عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2871","1693  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ مَسْعُودٍ ،  قَالَ فِي الْحَرَامِ : « يَمِينٌ  » .","","Sunan Sa'id ibn Mansur 1693","","عبد الله بن مسعود عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2872","1694  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  جَعْفَرٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ  عَلِيًّا ، رَضِيَ اللهُ عَنْهُ قَالَ فِي الَّذِي يُحَرِّمُ امْرَأَتَهُ ، قَالَ : « هِيَ طَالِقٌ ثَلَاثًا  » .","","Sunan Sa'id ibn Mansur 1694","","علي بن أبي طالب عن أبو جعفر الباقر عن جعفر الصادق عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2873","1695  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  جُوَيْبِرٍ ،  عَنِ  الضَّحَّاكِ ،  أَنَّ  أَبَا بَكْرٍ ، وَعُمَرَ ، وَابْنَ مَسْعُودٍ ،  قَالُوا فِي الْحَرَامِ : « يَمِينٌ  » .","","Sunan Sa'id ibn Mansur 1695","","عبد الله بن مسعود عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2874","1696  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدٌ ،  عَنِ  الْعَوَّامِ ،  عَنْ  يُسَيْرِ بْنِ عَمْرٍو ، قَالَ : «  إِذَا أَحَلْتَ الْحَدِيثَ عَلَى غَيْرِكَ اكْتَفَيْتَ  » .","","Sunan Sa'id ibn Mansur 1696","","يسير بن عمرو الكندي عن العوام بن حوشب عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2875","1697  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  بَعْضُ أَصْحَابِنَا ،  عَنْ  قَتَادَةَ ،  أَنَّ  عَلِيًّا ، رَضِيَ اللهُ عَنْهُ  كَانَ يَقُولُ فِي الْحَرَامِ : « هِيَ ثَلَاثٌ  » .         [6/437]","","Sunan Sa'id ibn Mansur 1697","","علي بن أبي طالب عن قتادة بن دعامة عن بعض أصحاب هشيم بن بشير عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2876","1698  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  أَشْعَثُ ،  عَنِ  الْحَكَمِ ،  أَنَّ  ابْنَ مَسْعُودٍ ،  كَانَ يَقُولُ فِي الْحَرَامِ : « إِنْ نَوَى طَلَاقًا فَهِيَ طَالِقٌ ،  وَإِنْ نَوَى يَمِينًا فَهِيَ يَمِينٌ  » .","","Sunan Sa'id ibn Mansur 1698","","عبد الله بن مسعود عن الحكم بن عتيبة الكندي عن أشعث بن سوار عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2877","1699  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنِ  الْحَكَمِ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ قَالَ : «  إِذَا قَالَ الرَّجُلُ لِامْرَأَتِهِ : أَنْتِ عَلَيَّ  حَرَامٌ  ، فَإِنْ نَوَى ثَلَاثًا فَثَلَاثٌ  ، وَإِنْ نَوَى وَاحِدَةً فَوَاحِدَةٌ بَائِنَةٌ ، وَإِنْ لَمْ يَنْوِ شَيْئًا فَيَمِينٌ يُكَفِّرُهَا  » .","","Sunan Sa'id ibn Mansur 1699","","إبراهيم النخعي عن الحكم بن عتيبة الكندي عن أشعث بن سوار عن إسماعيل بن زكريا شقوصا عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2878","1700  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  أَدْنَى مَا كَانُوا يَقُولُونَ فِي الْحَرَامِ : تَطْلِيقَةٌ بَائِنَةٌ  » .","","Sunan Sa'id ibn Mansur 1700","","إبراهيم النخعي عن الأعمش عن إسماعيل بن زكريا شقوصا عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2879","1701  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  خَالِدٌ ،  عَنْ  عِكْرِمَةَ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ قَالَ فِي الْحَرَامِ : « يَمِينٌ  » .","","Sunan Sa'id ibn Mansur 1701","","عمر بن الخطاب عن عكرمة مولى ابن عباس عن خالد الحذاء عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2880","1702  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ، وَإِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  قَالَ  مَسْرُوقٌ : «  مَا  أُبَالِي  أَحَرُمَتِ امْرَأَتِي عَلَيَّ ، أَوْ حَرُمَتْ جَفْنَةٌ مِنْ ثَرِيدٍ  » .","","Sunan Sa'id ibn Mansur 1702","","مسروق بن الأجدع عن الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2881","1703  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّهُ سُئِلَ         [6/438]      عَنْ رَجُلٍ قَالَ لِامْرَأَتِهِ : أَنْتِ طَالِقٌ تَطْلِيقَةً وَنِصْفٌ ، قَالَ : « هُمَا تَطْلِيقَتَانِ  » .","","Sunan Sa'id ibn Mansur 1703","","الشعبي عن جابر الجعفي عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2882","1704  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  قَالَ فِي الْحَرَامِ : « هِيَ يَمِينٌ  » .","","Sunan Sa'id ibn Mansur 1704","","عبد الله بن عباس عن سعيد بن المسيب عن قتادة بن دعامة عن شعبة بن الحجاج عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2883","1705  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  وَعُبَيْدَةُ  ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّهُمَا قَالَا فِي رَجُلٍ قَالَ لِأَمَتِهِ : هِيَ عَلَيَّ حَرَامٌ ، قَالَا : « يَمِينٌ يُكَفِّرُهَا  » .","","Sunan Sa'id ibn Mansur 1705","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2884","1706  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ، قَالَ : «  يَطَؤُهَا وَلَا شَيْءَ عَلَيْهِ  » .","","Sunan Sa'id ibn Mansur 1706","","مسروق بن الأجدع عن الشعبي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2885","1707  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عُبَيْدَةُ ،  عَنْ  إِبْرَاهِيمَ ، وَجُوَيْبِرٍ ،  عَنِ  الضَّحَّاكِ ،  أَنَّ  حَفْصَةَ أُمَّ الْمُؤْمِنِينَ  ، زَارَتْ أَبَاهَا ذَاتَ يَوْمٍ وَكَانَ يَوْمَهَا ، فَلَمَّا جَاءَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَمْ يَرَهَا فِي الْمَنْزِلِ ، أَرْسَلَ إِلَى أَمَتِهِ  مَارِيَةَ الْقِبْطِيَّةِ  ، فَأَصَابَ مِنْهَا فِي  بَيْتِ حَفْصَةَ  ، وَجَاءَتْ  حَفْصَةُ  عَلَى تِلْكَ الْحَالِ ، فَقَالَتْ : يَا رَسُولَ اللهِ ، أَتَفْعَلُ هَذَا فِي بَيْتِي وَفِي يَوْمِي ؟ قَالَ : «  فَإِنَّهَا عَلَيَّ حَرَامٌ ، وَلَا تُخْبِرِينَ  بِذَاكَ أَحَدًا  » . فَانْطَلَقَتْ إِلَى  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا فَأَخْبَرَتْهَا بِذَلِكَ ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      يَا أَيُّهَا النَّبِيُّ لِمَ تُحَرِّمُ مَا أَحَلَّ اللهُ لَكَ         }      إِلَى قَوْلِهِ :         {      وَصَالِحُ الْمُؤْمِنِينَ         }      فَأُمِرَ أَنْ يُكَفِّرَ عَنْ يَمِينِهِ ، وَيُرَاجِعَ أَمَتَهُ  » .         [6/439]      كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : كذا في ص ، خبر بمعنى النهي ، وفي هق : لا تخبري","","Sunan Sa'id ibn Mansur 1707","","الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2886","1708  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  دَاوُدُ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَلَفَ  لِحَفْصَةَ  أَنْ لَا يَقْرَبَ أَمَتَهُ قَالَ : هِيَ عَلَيَّ حَرَامٌ  ، فَنَزَلَتِ الْكَفَّارَةُ لِيَمِينِهِ ، وَأُمِرَ أَنْ لَا يُحَرِّمَ مَا أَحَلَّ اللهُ لَهُ  .","","Sunan Sa'id ibn Mansur 1708","","مسروق بن الأجدع عن الشعبي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2887","1709  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ، بِهَذَا الْحَدِيثِ .","","Sunan Sa'id ibn Mansur 1709","","مسروق بن الأجدع عن الشعبي عن داود بن أبي هند عن أبو زائدة بن ميمون الوادعي عن زكريا بن أبي زائدة الوادعي عن سفيان بن عيينة عن سعيد بن منصور","باب ألبتة والبرية والخلية والحرام"
"2888","بَابُ طَلَاقِ الصِّبْيَانِ وَمَا يَجِبُ فِيهِ .  1710  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  كَانُوا يَكْتُمُونَ الصِّبْيَانَ النِّكَاحَ ،  وَيَكْرَهُونَ أَنْ يُلْقُوا عَلَى أَفْوَاهِهِمُ الطَّلَاقَ  » .","","Sunan Sa'id ibn Mansur 1710","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب طلاق الصبيان وما يجب فيه"
"2889","1711  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  كَانُوا يَكْتُمُونَ الصِّبْيَانَ النِّكَاحَ مَخَافَةَ الطَّلَاقِ  » .  قَالَ  الْمُغِيرَةُ :  وَكَانَ إِبْرَاهِيمُ لَا يَهَابُ شَيْئًا مِنَ الْغُلَامِ إِلَّا الطَّلَاقَ  .","","Sunan Sa'id ibn Mansur 1711","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب طلاق الصبيان وما يجب فيه"
"2890","1712  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  الصَّبِيُّ لَا تَجُوزُ لَهُ عَطِيَّةٌ وَلَا عِتْقٌ حَتَّى يَحْتَلِمَ  ، وَالْجَارِيَةُ حَتَّى تَحِيضَ . وَكَانَ لَا يَهَابُ مِنْ أَمْرِ الصَّبِيِّ إِلَّا الطَّلَاقَ  » .","","Sunan Sa'id ibn Mansur 1712","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب طلاق الصبيان وما يجب فيه"
"2891","1713  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  لَا يَجُوزُ طَلَاقُ الْغُلَامِ الَّذِي لَمْ يَحْتَلِمْ حَتَّى يَحْتَلِمَ  » .         [6/440]","","Sunan Sa'id ibn Mansur 1713","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب طلاق الصبيان وما يجب فيه"
"2892","1714  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  ابْنُ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1714","","الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب طلاق الصبيان وما يجب فيه"
"2893","1715  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  بَعْضُ أَصْحَابِنَا ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ : «  إِذَا صَلَّى ، وَصَامَ شَهْرَ رَمَضَانَ ، وَعَقَلَ ، جَازَ طَلَاقُهُ  » .","","Sunan Sa'id ibn Mansur 1715","","سعيد بن المسيب عن بعض أصحاب هشيم بن بشير عن هشيم بن بشير عن سعيد بن منصور","باب طلاق الصبيان وما يجب فيه"
"2894","1716  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدٌ ،  عَنْ  صَالِحِ بْنِ مُسْلِمٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ : «  لَا يَجُوزُ طَلَاقُ الصَّبِيِّ  »  .","","Sunan Sa'id ibn Mansur 1716","","الشعبي عن صالح بن صالح بن حي الثوري عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب طلاق الصبيان وما يجب فيه"
"2895","1717  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنْ  حَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، رَضِيَ اللهُ عَنْهُ قَالَ : «  لَا يَجُوزُ صَدَقَةُ الْغُلَامِ  ، وَلَا هِبَتُهُ ، وَلَا طَلَاقُهُ ، وَلَا عِتْقُهُ  »  .","","Sunan Sa'id ibn Mansur 1717","","عبد الله بن عباس عن عطاء بن أبي رباح عن حجاج بن أرطاة عن إسماعيل بن زكريا شقوصا عن سعيد بن منصور","باب طلاق الصبيان وما يجب فيه"
"2896","1718  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَتَّابُ بْنُ بَشِيرٍ ، قَالَ :  أَنَا  خُصَيْفٌ ،  عَنْ  مُجَاهِدٍ ، قَالَ : «  إِذَا أَصَابَ امْرَأَةً حَرَامًا ، فَلَا يَصْلُحُ لَهُ أَنْ يَتَزَوَّجَ أُمَّهَا  »  .","","Sunan Sa'id ibn Mansur 1718","","مجاهد بن جبر المخزومي عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب طلاق الصبيان وما يجب فيه"
"2897","بَابُ الرَّجُلِ يَفْجُرُ بِالْمَرْأَةِ ، أَلَهُ أَنْ يَتَزَوَّجَ بِهَا أَوْ يَتَزَوَّجَ أُمَّهَا .  1719  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  بَعْضُ أَصْحَابِنَا ،  عَنْ  مَطَرٍ الْوَرَّاقِ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي رَجُلٍ فَجَرَ بِأُمِّ امْرَأَتِهِ ، قَالَ : « تَخَطَّى  حُرْمَتَيْنِ  ،         [6/441]      لَا يُحَرِّمُ الْحَرَامُ الْحَلَالَ  »  .","","Sunan Sa'id ibn Mansur 1719","","عبد الله بن عباس عن عطاء بن أبي رباح عن مطر بن طهمان الوراق عن بعض أصحاب هشيم بن بشير عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يفجر بالمرأة أله أن يتزوج بها أو يتزوج أمها"
"2898","1720  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ  سُئِلَ عَنْ ذَلِكَ ، قَالَ : «  يُفَارِقُ امْرَأَتَهُ ، وَلَا يُقِيمُ عَلَيْهَا  » . وَأَمَرَهُمْ أَنْ يَأْتُوا الشَّعْبِيَّ ، فَأَتَوُا  الشَّعْبِيَّ  فَسَأَلُوهُ ، فَقَالَ مِثْلَ مَا قَالَ  إِبْرَاهِيمُ  .","","Sunan Sa'id ibn Mansur 1720","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يفجر بالمرأة أله أن يتزوج بها أو يتزوج أمها"
"2899","1721  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ الْأَنْصَارِيُّ ،  أَنَّ رَجُلًا مِنْ قُرَيْشٍ سَأَلَ عَنْ ذَلِكَ سَعِيدَ بْنَ الْمُسَيِّبِ ، فَقَالَ لَهُ : ائْتِ عُرْوَةَ فَاسْأَلْهُ ، ثُمَّ ارْجِعْ إِلَيَّ ، فَأَخْبِرْنِي مَا يَقُولُ لَكَ . فَسَأَلَ  عُرْوَةَ  ، فَقَالَ : « لَا  يُحَرِّمُ الْحَرَامُ الْحَلَالَ  » . فَرَجَعَ إِلَى  سَعِيدِ بْنِ الْمُسَيِّبِ  فَأَخْبَرَهُ ، فَقَالَ  سَعِيدٌ  : صَدَقَ  عُرْوَةُ  ، الْقَوْلُ مَا قَالَ  .","","Sunan Sa'id ibn Mansur 1721","","عروة بن الزبير عن عبد الحميد بن جعفر الأوسي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يفجر بالمرأة أله أن يتزوج بها أو يتزوج أمها"
"2900","1722  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُحَمَّدُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ ، رَضِيَ اللهُ عَنْهُ ،  فِي رَجُلٍ فَجَرَ بِأُخْتِ امْرَأَتِهِ ، قَالَ : « لَا تَحْرُمُ عَلَيْهِ امْرَأَتُهُ  ، وَيَعْتَزِلُهَا حَتَّى تَنْقَضِيَ  عِدَّةُ  الْأُخْرَى ، ثُمَّ يَرْجِعُ إِلَى امْرَأَتِهِ ،         [6/442]      وَيَسْتَغْفِرُ رَبَّهُ وَلَا يَعُودُ  »  .","","Sunan Sa'id ibn Mansur 1722","","علي بن أبي طالب عن الشعبي عن محمد بن سالم الهمداني عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يفجر بالمرأة أله أن يتزوج بها أو يتزوج أمها"
"2901","1723  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1723","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يفجر بالمرأة أله أن يتزوج بها أو يتزوج أمها"
"2902","1724  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عُبَيْدَةُ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ كَانَ يَقُولُ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1724","","إبراهيم النخعي عن عبيدة بن معتب الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يفجر بالمرأة أله أن يتزوج بها أو يتزوج أمها"
"2903","1725  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  وَيُونُسَ  ،  عَنِ  الْحَسَنِ ، قَالَ : «  فَعَلَ ذَلِكَ بِأُخْتِ امْرَأَتِهِ مِنَ الرَّضَاعَةِ فَكَذَلِكَ أَيْضًا  » .","","Sunan Sa'id ibn Mansur 1725","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل يفجر بالمرأة أله أن يتزوج بها أو يتزوج أمها"
"2904","1726  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنِ  ابْنِ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ، قَالَ : «  إِذَا زَنَى الرَّجُلُ بِأُمِّ امْرَأَتِهِ حَرُمَتْ عَلَيْهِ امْرَأَتُهُ  » .","","Sunan Sa'id ibn Mansur 1726","","جابر بن زيد اليحمدي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن إسماعيل بن عياش الأحول عن سعيد بن منصور","باب الرجل يفجر بالمرأة أله أن يتزوج بها أو يتزوج أمها"
"2905","[6/443]      بَابُ الرَّجُلِ لَهُ أَمَتَانِ أُخْتَانِ يَطَؤُهُمَا .  1727  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حَجَّاجُ بْنُ أَرْطَاةَ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  أَنَّ  ابْنَ عُمَرَ ، سُئِلَ عَنْ رَجُلٍ لَهُ أَمَتَانِ وَهُمَا أُخْتَانِ ، فَوَطِئَ إِحْدَاهُمَا  ، وَأَرَادَ أَنْ يَطَأَ الْأُخْرَى ، فَقَالَ : « لَيْسَ ذَاكَ لَهُ » . قِيلَ : فَإِنْ قَرُبَهَا ؟ قَالَ : « لَا ، حَتَّى تَخْرُجَ الَّتِي وَطِئَ مِنْ مِلْكِهِ  »  .","","Sunan Sa'id ibn Mansur 1727","","عبد الله بن عمر بن الخطاب عن ميمون بن مهران الرقي عن حجاج بن أرطاة عن هشيم بن بشير عن سعيد بن منصور","باب الرجل له أمتان أختان يطؤهما"
"2906","1728  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  وَعُبَيْدَةَ  ،  عَنْ  إِبْرَاهِيمَ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1728","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل له أمتان أختان يطؤهما"
"2907","1729  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  شَرِيكُ بْنُ عَبْدِ اللهِ  عَنْ  عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، وَابْنِ أَبِي لَيْلَى ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : «  كَانَتْ لَهُ مَمْلُوكَتَانِ أُخْتَانِ ، فَوَطِئَ إِحْدَاهُمَا ، ثُمَّ أَرَادَ أَنْ يَطَأَ الْأُخْرَى ، فَأَخْرَجَهَا مِنْ مِلْكِهِ  »  .","","Sunan Sa'id ibn Mansur 1729","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الكريم الاصطخري عن شريك بن عبد الله النخعي عن سعيد بن منصور","باب الرجل له أمتان أختان يطؤهما"
"2908","1730  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  أَنَّهُ         [6/444]      كَانَ يَقُولُ فِي الرَّجُلِ يَطَأُ أَمَتَهُ ، أَوْ أَمَةَ غَيْرِهِ ، وَهِيَ أُخْتُ امْرَأَتِهِ مِنَ الرَّضَاعَةِ  ، قَالَ : « يَعْتَزِلُ امْرَأَتَهُ حَتَّى يَسْتَبْرِئَ رَحِمَ الْأَمَةِ  »  .","","Sunan Sa'id ibn Mansur 1730","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل له أمتان أختان يطؤهما"
"2909","1731  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، مِثْلَهُ .","","Sunan Sa'id ibn Mansur 1731","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل له أمتان أختان يطؤهما"
"2910","1732  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، قَالَ :  أَنَا  سَلَمَةُ بْنُ عَلْقَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  قَالَ  :  كَانَ عَبْدُ اللهِ بْنُ عُتْبَةَ  جَالِسًا فِي الْمَسْجِدِ - أَوْ قَالَ : فِي الْمَجْلِسِ  - فَدَعَا رَجُلًا ، فَجَاءَ حَتَّى جَلَسَ بَيْنَ يَدَيْهِ ، فَكَلَّمَهُ بِشَيْءٍ لَا أَفْهَمُهُ ، فَلَمَّا قَامَ رَفَعَ صَوْتَهُ ، فَظَنَنْتُ أَنَّهُ يُرِيدُ أَنْ يُسْمِعَنِي ، فَقَالَ :  لَوْ شِئْتَ لَاعْتَرَفْتَ ، أَلَا تَسْمَعُوا إِلَى قَوْلِهِ : إِنِّي حَرَّمْتُ إِحْدَاهُمَا  ، إِنَّهُمْ لَمْ يَزَالُوا بِعَبْدِ اللهِ بْنِ مَسْعُودٍ حَتَّى أَغْضَبُوهُ ،  فَقَالَ  : «  إِنَّ جَمَلَكَ مِمَّا مَلَكَتْ يَمِينُكَ  » . فَسَأَلْتُ بَعْضَهُمْ فَزَعَمُوا أَنَّ عِنْدَهُ أُخْتَيْنِ مَمْلُوكَتَيْنِ يَطَؤُهُمَا  »  .","","Sunan Sa'id ibn Mansur 1732","","عبد الله بن مسعود عن عبد الله بن عتبة بن مسعود عن محمد بن سيرين عن سلمة بن علقمة التميمي عن إسماعيل ابن علية عن سعيد بن منصور","باب الرجل له أمتان أختان يطؤهما"
"2911","1733  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  سُئِلَ  عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ عَنْ جَمْعٍ بَيْنَ الْأُمِّ وَابْنَتِهَا  ، قَالَ : « مَا أُحِبُّ أَنْ أُجِيزَهُمَا جَمِيعًا . قَالَ أَبِي : فَرَدَّدْتُ أَنَّ  عُمَرَ  كَانَ أَشَدَّ فِي ذَلِكَ مِمَّا هُوَ  » .         [6/445]","","Sunan Sa'id ibn Mansur 1733","","عمر بن الخطاب عن عبد الله بن عتبة بن مسعود عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل له أمتان أختان يطؤهما"
"2912","1734  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حُدَيْجُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  رَجُلٍ ،  أَنَّهُ كَانَتْ لَهُ جَارِيَتَانِ امْرَأَةٌ وَابْنَتُهَا ، فَوَلَدَتَا مِنْهُ جَمِيعًا  ،  فَسَأَلَ  عَلِيًّا رَضِيَ اللهُ عَنْهُ عَنْ ذَلِكَ ، فَقَالَ : آيَتَانِ : إِحْدَاهُمَا تُحَرِّمُ عَلَيْكَ ، وَالْأُخْرَى تُحِلُّ لَكَ مَا مَلَكَتْ يَمِينُكَ ، وَلَسْتُ أَفْعَلُهُ أَنَا وَلَا أَهْلِي  .","","Sunan Sa'id ibn Mansur 1734","","علي بن أبي طالب عن رجل عن أبو إسحاق السبيعي عن حديج بن معاوية بن حديج  الجعفي عن سعيد بن منصور","باب الرجل له أمتان أختان يطؤهما"
"2913","1735  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  ذَكَرُوا عِنْدَ  ابْنِ عَبَّاسٍ  قَوْلَ  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ : أَحَلَّتْهُمَا آيَةٌ وَحَرَّمَتْهُمَا آيَةٌ  . فَقَالَ  ابْنُ عَبَّاسٍ  : « أَحَلَّتْهُمَا آيَةٌ وَحَرَّمَتْهُمَا أُخْرَى ، إِنَّمَا يُحَرِّمُ عَلَيَّ قَرَابَتِي مِنْهُنَّ ، وَلَا تُحَرِّمُ عَلَيَّ قَرَابَةُ بَعْضِهِنَّ مِنْ بَعْضٍ  » .","","Sunan Sa'id ibn Mansur 1735","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل له أمتان أختان يطؤهما"
"2914","1736  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي مُلَيْكَةَ ،  أَنَّ  رَجُلًا سَأَلَ عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، قَالَ لَهَا :  إِنَّ قِنَّةً قَدْ كَبِرَتْ -  أَمَةٌ لَهُ كَانَ يَطَؤُهَا  - وَلَهَا ابْنَةٌ ، أَيَحِلُّ لِي أَنْ أَغْشَاهَا ؟  قَالَتْ : « أَنْهَاكَ عَنْهَا وَمَنْ أَطَاعَنِي  » .         [6/446]      قَالَ  سَعِيدٌ :  وَسَأَلْتُ  سُفْيَانَ عَنْ حَدِيثِ  مُطَرِّفٍ  ، عَنْ  عَمَّارٍ  ، قَالَ : قَالَ «  يَحْرُمُ مِنَ الْإِمَاءِ مَا يَحْرُمُ مِنَ  الْحَرَائِرِ  إِلَّا الْعَدَدَ  » .  فَقَالَ  مُطَرِّفٌ  عَنْ  أَبِي فُلَانٍ . فَقُلْتُ لَهُ :  عَنْ  أَبِي الْجَهْمِ  ،  عَنْ  أَبِي الْأَخْضَرِ ،  عَنْ  عَمَّارٍ ؟ . قَالَ : نَعَمْ  .","","Sunan Sa'id ibn Mansur 1736","","عمار بن ياسر عن أبو الأخضر عن سليمان بن الجهم الجوزجانى عن مطرف بن طريف عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل له أمتان أختان يطؤهما"
"2915","1737  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَبْدِ الرَّحْمَنِ عَبْدُ اللهِ بْنُ يَزِيدَ ،  عَنْ  مُوسَى بْنِ أَيُّوبَ الْغَافِقِيِّ ،  عَنْ  عَمِّهِ ،  عَنْ  عَلِيٍّ ، رَضِيَ اللهُ عَنْهُ قَالَ : «  يَحْرُمُ مِنَ الْإِمَاءِ مَا يَحْرُمُ مِنَ  الْحَرَائِرِ  إِلَّا الْعَدَدَ  » .","","Sunan Sa'id ibn Mansur 1737","","علي بن أبي طالب عن إياس بن عامر المصري عن موسى بن أيوب بن عامر الغافقي عن عبد الله بن يزيد القصير عن سعيد بن منصور","باب الرجل له أمتان أختان يطؤهما"
"2916","1738  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّ  ابْنَ عَبَّاسٍ ، سُئِلَ عَنِ الْأُخْتَيْنِ مِمَّا مَلَكَتِ الْيَمِينُ  ، فَقَالَ : « لَا أُحِلُّهُمَا وَلَا أُحَرِّمُهُمَا ، أَحَلَّتْهُمَا آيَةٌ وَحَرَّمَتْهُمَا أُخْرَى » . فَبَلَغَ ابْنَ مَسْعُودٍ ، فَقَالَ : « لَا تَجْمَعْهُمَا  » .","","Sunan Sa'id ibn Mansur 1738","","عبد الله بن مسعود عن الشعبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل له أمتان أختان يطؤهما"
"2917","1739  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  الْأَحْوَصُ  ،  عَنْ  طَارِقِ بْنِ عَبْدِ الرَّحْمَنِ الْبَجَلِيِّ ،  عَنْ  قَيْسِ بْنِ أَبِي عَاصِمٍ  ، قَالَ :  قُلْتُ  لِابْنِ عَبَّاسٍ :  أَيَقَعُ الرَّجُلُ عَلَى الْجَارِيَةِ وَابْنَتِهَا تَكُونَانِ لَهُ مَمْلُوكَتَيْنِ ؟  قَالَ : « حَرَّمَتْهُمَا آيَةٌ وَأَحَلَّتْهُمَا آيَةٌ أُخْرَى ، وَلَمْ أَكُنْ لِأَفْعَلَهُ  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، والصواب :""أبو الأحوص"". كما في مصادر التخريج.  كذا في طبعة الدار طبعة الدار السلفية بالهند ، ولعل الصواب : (قيس بن أبي حازم) ، وينظر مصادر التخريج ، والله أعلم .","","Sunan Sa'id ibn Mansur 1739","","عبد الله بن عباس عن قيس بن أبي حازم عن طارق بن عبد الرحمن البجلي عن سلام بن سليم الحنفي عن سعيد بن منصور","باب الرجل له أمتان أختان يطؤهما"
"2918","بَابُ الرَّجُلِ لَهُ أَرْبَعُ نِسْوَةٍ فَيُطَلِّقُ إِحْدَاهُنَّ .  1740  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ،  أَنَّهُ         [6/447]      سَأَلَ  سَعِيدَ بْنَ الْمُسَيِّبِ  عَنْ رَجُلٍ لَهُ أَرْبَعُ نِسْوَةٍ فَطَلَّقَ وَاحِدَةً ، قَالَ : « لَا يَنْكِحُ حَتَّى تَنْقَضِيَ  عِدَّةُ  الْمُطَلَّقَةِ  » .","","Sunan Sa'id ibn Mansur 1740","","سعيد بن المسيب عن عبد الكريم الاصطخري عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل له أربع نسوة فيطلق إحداهن"
"2919","1741  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَتَّابُ بْنُ بَشِيرٍ ، قَالَ :  أَنَا  خُصَيْفٌ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  لَا يَتَزَوَّجُ حَتَّى تَنْقَضِيَ  عِدَّةُ  الَّتِي طَلَّقَ  .","","Sunan Sa'id ibn Mansur 1741","","سعيد بن المسيب عن خصيف الجزري عن عتاب بن بشير عن سعيد بن منصور","باب الرجل له أربع نسوة فيطلق إحداهن"
"2920","1742  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  لَا يَتَزَوَّجُ الْخَامِسَةَ حَتَّى تَنْقَضِيَ  عِدَّةُ  الَّتِي طَلَّقَ  » .","","Sunan Sa'id ibn Mansur 1742","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب الرجل له أربع نسوة فيطلق إحداهن"
"2921","1743  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  فِي رَجُلٍ لَهُ أَرْبَعُ نِسْوَةٍ فَطَلَّقَ إِحْدَاهُنَّ ، قَالَ : « لَا يَتَزَوَّجُ رَابِعَةً حَتَّى تَنْقَضِيَ  عِدَّةُ  الَّتِي طَلَّقَ  ، فَإِنْ كَانَ لَهُ أَرْبَعُ نِسْوَةٍ فَمَاتَتْ إِحْدَاهُنَّ ، تَزَوَّجَ مَكَانَهَا إِنْ شَاءَ ، فَلَيْسَ الْمَوْتُ مِثْلَ الطَّلَاقِ  » .","","Sunan Sa'id ibn Mansur 1743","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب الرجل له أربع نسوة فيطلق إحداهن"
"2922","1744  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  عَطَاءٍ ، قَالَ : «  إِنْ كَانَ طَلَّقَهَا ثَلَاثًا فَلْيَنْكِحْ  » .","","Sunan Sa'id ibn Mansur 1744","","عطاء بن أبي رباح عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن سعيد بن منصور","باب الرجل له أربع نسوة فيطلق إحداهن"
"2923","1745  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا طَلَّقَ الرَّجُلُ امْرَأَتَهُ ، ثُمَّ أَرَادَ أَنْ يَتَزَوَّجَ أُخْتَهَا  ، فَإِنْ كَانَ بِامْرَأَتِهِ حَبَلٌ لَمْ يَتَزَوَّجْ أُخْتَهَا حَتَّى تَنْقَضِيَ عِدَّتُهَا ، وَإِنْ لَمْ يَكُنْ بِهَا حَبَلٌ تَزَوَّجَ أُخْتَهَا إِنْ شَاءَ  » .         [6/448]","","Sunan Sa'id ibn Mansur 1745","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الرجل له أربع نسوة فيطلق إحداهن"
"2924","1746  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ : «  لَا يَتَزَوَّجُهَا حَتَّى تَنْقَضِيَ  عِدَّةُ  أُخْتِهَا  » .","","Sunan Sa'id ibn Mansur 1746","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل له أربع نسوة فيطلق إحداهن"
"2925","1747  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُحَمَّدُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ ، أَنَّهُ قَالَ : «  إِذَا طَلَّقَهَا طَلَاقًا بَائِنًا فَلْيَتَزَوَّجْ أُخْتَهَا إِنْ شَاءَ فِي عِدَّتِهَا  » .","","Sunan Sa'id ibn Mansur 1747","","زيد بن ثابت الأنصاري عن الشعبي عن محمد بن سالم الهمداني عن هشيم بن بشير عن سعيد بن منصور","باب الرجل له أربع نسوة فيطلق إحداهن"
"2926","1748  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنْبَأَ  يَحْيَى بْنُ سَعِيدٍ ، قَالَ :  قَدِمَ  الْوَلِيدُ بْنُ عَبْدِ الْمَلِكِ  الْمَدِينَةَ  وَهُوَ يُرِيدُ  الْحَجَّ  ، فَأَرَادَ أَنْ يَتَزَوَّجَ بِهَا ، وَعِنْدَهُ أَرْبَعُ نِسْوَةٍ ، فَسَأَلَ عُرْوَةَ بْنَ الزُّبَيْرِ ، فَقَالَ :  طَلِّقَ إِحْدَى نِسَائِكَ طَلَاقًا بَائِنًا ، ثُمَّ تَزَوَّجْ  . فَفَعَلَ ذَلِكَ  .","","Sunan Sa'id ibn Mansur 1748","","عروة بن الزبير عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب الرجل له أربع نسوة فيطلق إحداهن"
"2927","1749  -  حَدَّثَنَا  سَعِيدٌ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  قَالَ  :  كَانَ لِلْوَلِيدِ بْنِ عَبْدِ الْمَلِكِ أَرْبَعُ نِسْوَةٍ ، فَطَلَّقَ وَاحِدَةً أَلْبَتَّةَ ، وَتَزَوَّجَ قَبْلَ أَنْ تَحِلَّ  ، فَعَابَ ذَلِكَ عَلَيْهِ كَثِيرٌ مِنَ الْفُقَهَاءِ ، وَلَيْسَ كُلُّهُمْ عَابَهُ  .  1750  - حَدَّثَنَا سَعِيدٌ قَالَ :  إِذَا عَابَهُ  سَعِيدُ بْنُ الْمُسَيِّبِ  فَأَيُّ شَيْءٍ بَقِيَ ؟  .","","Sunan Sa'id ibn Mansur 1749","","الوليد بن عبد الملك الأموي عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سعيد بن منصور","باب الرجل له أربع نسوة فيطلق إحداهن"
"2928","1751  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  عَبْدُ الْمَلِكِ ،  عَنْ  عَطَاءٍ ،  عَنْ  عُبَيْدِ         [6/449]      بْنِ عُمَيْرٍ ، قَالَ :  جَاءَتِ امْرَأَةٌ إِلَى عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ ، فَقَالَتْ : إِنَّ زَوْجَهَا غَابَ عَنْهَا فَأَطَالَ الْغَيْبَةَ  ، فَأَمَرَهَا أَنْ تَرَبَّصَ أَرْبَعَ سِنِينَ ، فَفَعَلَتْ ، ثُمَّ أَتَتْهُ فَأَمَرَ وَلِيَّهُ أَنْ يُطَلِّقَهَا ، فَطَلَّقَهَا ، وَأَمَرَهَا أَنْ تَعْتَدَّ ثَلَاثَةَ قُرُوءٍ ، فَفَعَلَتْ ، ثُمَّ أَتَتْهُ فَأَمَرَهَا أَنْ تَعْتَدَّ أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا ، فَفَعَلَتْ ، فَأَمَرَهَا أَنْ تَزَوَّجَ  .","","Sunan Sa'id ibn Mansur 1751","","عمر بن الخطاب عن عبيد بن عمير بن قتادة الجندعي عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل له أربع نسوة فيطلق إحداهن"
"2929","بَابُ الْحُكْمِ فِي امْرَأَةِ الْمَفْقُودِ .  1752  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عُمَرَ أَنَّهُ قَالَ : «  تَرَبَّصُ امْرَأَةُ الْمَفْقُودِ أَرْبَعَ سِنِينَ  ، ثُمَّ تَعْتَدُّ  عِدَّةَ  الْمُتَوَفَّى عَنْهَا زَوْجُهَا ، وَتَزَوَّجُ إِنْ شَاءَتْ »  .","","Sunan Sa'id ibn Mansur 1752","","عمر بن الخطاب عن سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب الحكم في امرأة المفقود"
"2930","1753  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  عَنْ  عُمَرَ بْنِ الْخَطَّابِ ، رَضِيَ اللهُ عَنْهُ مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1753","","عمر بن الخطاب عن الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب الحكم في امرأة المفقود"
"2931","1754  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  يَحْيَى بْنِ جَعْدَةَ ، أَنَّ  رَجُلًا انْتَسَفَتْهُ الْجِنُّ عَلَى عَهْدِ عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ  ، فَلَبِثَ مَا شَاءَ اللهُ أَنْ يَلْبَثَ ، ثُمَّ إِنَّ امْرَأَتَهُ أَتَتْ  عُمَرَ بْنَ الْخَطَّابِ  ، فَأَمَرَهَا أَنْ تَرَبَّصَ أَرْبَعَ سِنِينَ ، فَلَمَّا لَمْ يَجِئْ أَمَرَ وَلِيَّهُ أَنْ يُطَلِّقَهَا ، ثُمَّ أَمَرَهَا أَنْ تَعْتَدَّ ، فَإِذَا انْقَضَتْ عِدَّتُهَا وَجَاءَ زَوْجُهَا خُيِّرَ بَيْنَهَا وَبَيْنَ الصَّدَاقِ  .","","Sunan Sa'id ibn Mansur 1754","","عمر بن الخطاب عن يحيى بن جعدة بن هبيرة المخزومي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب الحكم في امرأة المفقود"
"2932","1755  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنْ  أَبِي نَضْرَةَ ،         [6/450]      عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  أَنَّ  رَجُلًا مِنَ  الْأَنْصَارِ  خَرَجَ لَيْلًا فَانْتَسَفَتْهُ الْجِنُّ ، فَطَالَتْ غَيْبَتُهُ  ، فَأَتَتِ امْرَأَتُهُ عُمَرَ بْنَ الْخَطَّابِ ، فَقَالَتْ : إِنَّ زَوْجَهَا قَدْ غَابَ عَنْهَا فَطَالَتْ غَيْبَتُهُ ، فَأَمَرَهَا أَنْ تَعْتَدَّ أَرْبَعَ سِنِينَ ، فَفَعَلَتْ ثُمَّ أَتَتْهُ ، فَأَمَرَهَا أَنْ تَزَوَّجَ فَفَعَلَتْ ، ثُمَّ قَدِمَ زَوْجُهَا الْأَوَّلُ ، فَأَتَى  عُمَرَ بْنَ الْخَطَّابِ  رَضِيَ اللهُ عَنْهُ وَأَخْبَرَهُ ، فَغَضِبَ  عُمَرُ  ، وَقَالَ : « يَعْمِدُ أَحَدُكُمْ فَيُطِيلُ الْغَيْبَةَ عَنْ أَهْلِهِ ، ثُمَّ لَا يُعْلِمُهُمْ » . قَالَ : لَا تَعْجَلْ عَلَيَّ يَا أَمِيرَ الْمُؤْمِنِينَ ، إِنِّي خَرَجْتُ مِنْ مَنْزِلِي عِشَاءً فَاسْتَبَتْنِي الْجِنُّ ، فَكُنْتُ فِيهِمْ مَا شَاءَ اللهُ ، فَغَزَاهُمْ جِنٌّ مِنَ الْمُسْلِمِينَ ، فَقَالُوا لِي : مَا أَنْتَ ؟ فَأَخْبَرَتْهُمْ ، فَقَالُوا لِي : هَلْ لَكَ أَنْ تَرْجِعَ إِلَى بِلَادِكَ ؟ فَقُلْتُ : نَعَمْ ، فَبَعَثُوا بِي ، فَأَمَّا اللَّيْلُ فَرِجَالٌ أَعْرِفُهُمْ ، وَأَمَّا النَّهَارُ فَإِعْصَارُ رِيحٍ تَحْمِلُنِي . قَالَ : فَخَيَّرَهُ  عُمَرُ  بَيْنَ امْرَأَتِهِ وَبَيْنَ الصَّدَاقِ ، فَاخْتَارَ امْرَأَتَهُ ، فَفَرَّقَ بَيْنَهُمَا ، وَرَدَّهَا إِلَيْهِ ، فَقَالَ  عُمَرُ  : « مَا كَانَ طَعَامُهُمْ ؟ » قَالَ :  الْفُولُ  ، وَمَا لَمْ يُذْكَرِ اسْمُ اللهِ عَلَيْهِ . قَالَ : « فَمَا كَانَ شَرَابُهُمْ ؟ » قَالَ :  الْجَدَفُ  .  يَعْنِي الَّذِي لَا يُغَطَّى  » .         [6/451]","","Sunan Sa'id ibn Mansur 1755","","عمر بن الخطاب عن عبد الرحمن بن أبي ليلى عن المنذر بن مالك العوقي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب الحكم في امرأة المفقود"
"2933","1756  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  عَمْرِو بْنِ هَرِمٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، وَابْنِ عُمَرَ أَنَّهُمَا قَالَا : «  تَنْتَظِرُ امْرَأَةُ الْمَفْقُودِ أَرْبَعَ سِنِينَ  » . قَالَ  ابْنُ عُمَرَ  : « يُنْفَقُ عَلَيْهَا فِي الْأَرْبَعِ سِنِينَ مِنْ مَالِ زَوْجِهَا ; لِأَنَّهَا حَبَسَتْ نَفْسَهَا عَلَيْهِ » . وَقَالَ  ابْنُ عَبَّاسٍ  : « إِذَا أَجْحَفَ ذَلِكَ بِالْوَرَثَةِ ، وَلَكِنْ تَسْتَدِينُ ، فَإِنْ جَاءَ زَوْجُهَا أَخَذَتْ مِنْ مَالِهِ ، وَإِنْ غَابَ قَضَتْ مِنْ نَصِيبِهَا مِنَ الْمِيرَاثِ » . وَقَالَا جَمِيعًا : « يُنْفَقُ عَلَيْهَا بَعْدَ الْأَرْبَعِ سِنِينَ أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا مِنْ جَمِيعِ الْمَالِ  » .","","Sunan Sa'id ibn Mansur 1756","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن هرم الأزدي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب الحكم في امرأة المفقود"
"2934","1757  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  عَبَّادٍ ،  عَنْ  عَلِيٍّ ،  فِي امْرَأَةِ الْمَفْقُودِ قَالَ : « هِيَ امْرَأَتُهُ  » .","","Sunan Sa'id ibn Mansur 1757","","علي بن أبي طالب عن عباد بن عبد الله الأسدي عن المنهال بن عمرو الأسدي عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب الحكم في امرأة المفقود"
"2935","1758  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الْحَكَمِ ، قَالَ :  قَالَ  عَلِيٌّ : «  إِذَا فَقَدَتِ الْمَرْأَةُ زَوْجَهَا فَلَا تَتَزَوَّجُ حَتَّى تَسْتَبِينَ أَمْرَهُ  » .","","Sunan Sa'id ibn Mansur 1758","","علي بن أبي طالب عن الحكم بن عتيبة الكندي عن منصور بن المعتمر عن جرير بن عبد الحميد عن سعيد بن منصور","باب الحكم في امرأة المفقود"
"2936","1759  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، مِثْلَهُ .","","Sunan Sa'id ibn Mansur 1759","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن سعيد بن منصور","باب الحكم في امرأة المفقود"
"2937","1760  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ  فِي امْرَأَةٍ         [6/452]      نُعِيَ إِلَيْهَا زَوْجُهَا ، أَوْ يَأْسِرُهُ الْعَدُوُّ  ، قَالَ : « تَصْبِرُ حَتَّى تَعْلَمَ يَقِينَ أَمْرِهِ ، إِنَّمَا هِيَ امْرَأَةٌ ابْتُلِيَتْ  » .","","Sunan Sa'id ibn Mansur 1760","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الحكم في امرأة المفقود"
"2938","1761  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنْبَأَ  سَيَّارٌ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّهُ كَانَ يَقُولُ فِي امْرَأَةِ الْمَفْقُودِ : « إِنْ جَاءَ الْأَوَّلُ فَهِيَ امْرَأَتُهُ  وَلَا خِيَارَ لَهُ  ، وَكَانَ عَلِيُّ بْنُ أَبِي طَالِبٍ رَضِيَ اللهُ عَنْهُ يَقُولُ ذَلِكَ  » .  قَالَ  هُشَيْمٌ  : وَهُوَ الْقَوْلُ  .","","Sunan Sa'id ibn Mansur 1761","","الشعبي عن سيار بن أبي سيار العنزي عن هشيم بن بشير عن سعيد بن منصور","باب الحكم في امرأة المفقود"
"2939","1762  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  نَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ، وَالشَّيْبَانِيُّ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّهُ قَالَ فِي امْرَأَةِ الْمَفْقُودِ : إِذَا تَزَوَّجَتْ فَحَمَلَتْ مِنْ زَوْجِهَا  ، ثُمَّ بَلَغَهَا أَنَّ الْأَوَّلَ حَيٌّ ، قَالَ : « يُفَرَّقُ بَيْنَهَا وَبَيْنَ الْآخَرِ ، أَوْ مَاتَ زَوْجُهَا الْأَوَّلُ تَعْتَدُّ مِنْ هَذَا الْأَخِيرِ بِبَقِيَّةِ حَمْلِهَا ، وَإِذَا وَضَعَتِ اعْتَدَّتْ مِنَ الْأَوَّلِ أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا وَوَرِثَتْهُ  » .  تَمَّ الْقِسْمُ الْأَوَّلُ مِنَ الْمُجَلَّدِ الثَّالِثِ مِنْ سُنَنِ  سَعِيدِ بْنِ مَنْصُورٍ الْخُرَاسَانِيِّ  ، وَالْحَمْدُ لِلهِ ، وَالصَّلَاةُ عَلَى نَبِيِّهِ أَوَّلًا وَآخِرًا .","","Sunan Sa'id ibn Mansur 1762","","الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن سعيد بن منصور","باب الحكم في امرأة المفقود"
"2940","[7/25]      الْقِسْمُ الثَّانِي مِنَ الْمُجَلَّدِ الثَّالِثِ مِنْ كِتَابِ السُّنَنِ لِلْإِمَامِ سَعِيدِ بْنِ مَنْصُورٍ .  بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ .  بَابُ مَا جَاءَ فِي مَتَاعِ الْمُطَلَّقَةِ .  1763  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ  ، عَنِ  ابْنِ سِيرِينَ ،  أَنَّ  الْحَسَنَ بْنَ عَلِيٍّ طَلَّقَ امْرَأَةً لَهُ ، وَبَعَثَ إِلَيْهَا بِعَشَرَةِ آلَافٍ مُتْعَةً  لَهَا ، فَقَالَتْ : « مَتَاعٌ قَلِيلٌ مِنْ حَبِيبٍ مُفَارِقٍ » فَبَلَغَهُ قَوْلُهَا فَرَاجَعَهَا  .","","Sunan Sa'id ibn Mansur 1763","","الحسن بن علي سبط رسول الله عن محمد بن سيرين عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2941","1764  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو عَوَانَةَ  ، عَنْ  مَنْصُورٍ  ، عَنْ  إِبْرَاهِيمَ ،  أَنَّ  الْأَسْوَدَ بْنَ يَزِيدَ ، « طَلَّقَ امْرَأَتَهُ  فَمَتَّعَهَا  بِثَلَاثِ مِائَةِ دِرْهَمٍ  »  .         [7/26]","","Sunan Sa'id ibn Mansur 1764","","الأسود بن يزيد النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2942","1765  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ  ، عَنِ  الْأَعْمَشِ  ، عَنْ  إِبْرَاهِيمَ  ، عَنِ  الْأَسْوَدِ ، «  أَنَّهُ طَلَّقَ امْرَأَتَهُ  فَمَتَّعَهَا  بِثَلَاثِ مِائَةِ دِرْهَمٍ  » .","","Sunan Sa'id ibn Mansur 1765","","الأسود بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2943","1766  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ،  أَنَا  الْأَعْمَشُ  ، عَنْ  إِبْرَاهِيمَ  ، عَنِ  الْأَسْوَدِ ، مِثْلَ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1766","","الأسود بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2944","1767  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  نَا  يُونُسُ بْنُ عُبَيْدٍ ،  أَنَّ  أَنَسَ بْنَ مَالِكٍ « طَلَّقَ امْرَأَتَهُ  فَمَتَّعَهَا  بِثَلَاثِ مِائَةِ دِرْهَمٍ  » .","","Sunan Sa'id ibn Mansur 1767","","أنس بن مالك عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2945","1768  -  حَدَّثَنَا  سَعِيدٌ ،  نَا  هُشَيْمٌ ،  أَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ  ، عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ  ، عَنْ  أَبِيهِ  ، عَنْ  جَدِّهِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  ، «  أَنَّهُ طَلَّقَ امْرَأَتَهُ  فَمَتَّعَهَا  بِجَارِيَةٍ سَوْدَاءَ  حَمَّمَهَا  » .","","Sunan Sa'id ibn Mansur 1768","","عبد الرحمن بن عوف بن عبد عوف القرشي عن إبراهيم بن عبد الرحمن بن عوف عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن محمد بن إسحاق عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2946","1769  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ الرَّحْمَنِ ، قَالَ :  نَا  شُعْبَةُ  ، عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ، قَالَ :  سَمِعْتُ  حُمَيْدَ بْنَ عَبْدِ الرَّحْمَنِ ،  يُحَدِّثُ عَنْ  أُمِّهِ  ، أَنَّهَا قَالَتْ : «  كَأَنِّي أَنْظُرُ إِلَى جَارِيَةٍ سَوْدَاءَ  حَمَّمَهَا  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ امْرَأَتَهُ  أُمَّ أَبِي سَلَمَةَ  حِينَ طَلَّقَهَا فِي مَرَضِهِ  » .","","Sunan Sa'id ibn Mansur 1769","","عبد الرحمن بن عوف بن عبد عوف القرشي عن أم كلثوم بنت عقبة بن أبي معيط عن حميد بن عبد الرحمن القرشي عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2947","1770  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  نَا  مُغِيرَةُ  ، عَنْ  إِبْرَاهِيمَ ، قَالَ : «  الْعَرَبُ تُسَمِّي  الْمُتْعَةَ  التَّحْمِيمَ  » .","","Sunan Sa'id ibn Mansur 1770","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2948","1771  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  ثَنَا  هُشَيْمٌ ، قَالَ :  أَنَا  سَيَّارٌ  ، عَنِ  الشَّعْبِيِّ ،  أَنَّ  شُرَيْحًا طَلَّقَ امْرَأَةً يُقَالُ لَهَا :  كُبَيْشَةُ  ،  فَمَتَّعَهَا  مَتَاعًا لَمْ يُسَمِّهِ  ، وَكَتَمَهَا طَلَاقَهَا حَتَّى         [7/27]      انْقَضَتْ عِدَّتُهَا ، فَلَمَّا أَخْبَرَهَا أَمَرَتْ بِثِيَابِهَا أَنْ تُنْقَلَ ، وَخَرَجَتْ ، فَقَالَ  شُرَيْحٌ  : « لِذَلِكَ كَتَمْتُهَا ؛ إِنِّي كَرِهْتُ أَنْ تَعْصِيَ اللهَ عَزَّ وَجَلَّ  » .","","Sunan Sa'id ibn Mansur 1771","","شريح بن الحارث الكندي عن الشعبي عن سيار بن أبي سيار العنزي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2949","1772  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  دَاوُدُ ، قَالَ :  وَأَنَا  مُغِيرَةُ  ، عَنِ  الشَّعْبِيِّ ،  أَنَّ  شُرَيْحًا طَلَّقَ امْرَأَتَهُ  وَمَتَّعَهَا  بِخَمْسِ مِائَةِ دِرْهَمٍ  .","","Sunan Sa'id ibn Mansur 1772","","شريح بن الحارث الكندي عن الشعبي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2950","1773  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  ابْنُ أَبِي لَيْلَى  ، عَنْ  نَافِعٍ  ، عَنِ  ابْنِ عُمَرَ ، قَالَ : «  لِكُلِّ مُطَلَّقَةٍ مَتَاعٌ  إِلَّا الَّتِي طَلَّقَهَا قَبْلَ أَنْ يَدْخُلَ بِهَا ، وَقَدْ كَانَ  فَرَضَ  لَهَا ، فَلَهَا نِصْفُ الصَّدَاقِ  » .","","Sunan Sa'id ibn Mansur 1773","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2951","1774  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ  ، عَنِ  الْحَسَنِ ، قَالَ : «  لِكُلِّ مُطَلَّقَةٍ مَتَاعٌ  » .","","Sunan Sa'id ibn Mansur 1774","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2952","1775  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَبْدُ الْمَلِكِ  ، عَنْ  عَطَاءٍ ، أَنَّهُ قَالَ : «  لِكُلِّ مُطَلَّقَةٍ مَتَاعٌ  إِلَّا الَّتِي طَلَّقَهَا قَبْلَ أَنْ يَدْخُلَ بِهَا ، وَقَدْ  فَرَضَ  لَهَا ، فَلَهَا نِصْفُ الصَّدَاقِ  » .","","Sunan Sa'id ibn Mansur 1775","","عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2953","1776  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  دَاوُدُ  ، عَنِ  الشَّعْبِيِّ ،  أَنَّهُ قَالَ فِي الْمَتَاعِ : « دِرْعٌ ، وَخِمَارٌ  ، وَمِلْحَفَةٌ ، وَجِلْبَابٌ  » .         [7/28]","","Sunan Sa'id ibn Mansur 1776","","الشعبي عن داود بن أبي هند عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2954","1777  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ  ، عَنْ  إِبْرَاهِيمَ ،  وَمُحَمَّدِ بْنِ سَالِمٍ  ، عَنِ  الشَّعْبِيِّ ، أَنَّهُمَا قَالَا : «  لِكُلِّ مُطَلَّقَةٍ مَتَاعٌ  إِلَّا الَّتِي طَلَّقَهَا ، وَقَدْ  فَرَضَ  لَهَا قَبْلَ أَنْ يَدْخُلَ بِهَا ، فَلَهَا نِصْفُ الصَّدَاقِ  » .","","Sunan Sa'id ibn Mansur 1777","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2955","1778  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ  ، عَنِ  الْحَسَنِ ،  أَنَّهُ سُئِلَ عَنِ الْمُتْعَةِ ، فَقَالَ : « كَانَ مِنْهُمْ مَنْ  مَتَّعَ  بِالْخَادِمِ وَالنَّفَقَةِ  ، وَمَنْ كَانَ دُونَ ذَلِكَ  مَتَّعَ  بِالنَّفَقَةِ وَالْكِسْوَةِ ، وَمَنْ كَانَ دُونَ ذَلِكَ  مَتَّعَ  بِمِلْحَفَةٍ ، وَدِرْعٍ ، وَجِلْبَابٍ ، وَمَنْ كَانَ دُونَ ذَلِكَ  مَتَّعَ  بِثَوْبٍ وَاحِدٍ  » .","","Sunan Sa'id ibn Mansur 1778","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2956","1779  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مَنْصُورٌ ، وَيُونُسُ ، وَهِشَامٌ  ، عَنِ  ابْنِ سِيرِينَ  ، عَنْ  شُرَيْحٍ ،  أَنَّ امْرَأَةً خَاصَمَتْ زَوْجَهَا إِلَى  شُرَيْحٍ  فِي الْمُتْعَةِ ، فَقَالَ  شُرَيْحٌ  : « لَا تَابَى  أَنْ تَكُونَ مِنَ الْمُحْسِنِينَ  ، لَا تَابَى  أَنْ تَكُونَ مِنَ الْمُتَّقِينَ » وَلَمْ يُجْبِرْهُ  .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : كذا في عب ، ورسمه في ص : ( لا تابا ) والمراد لا تاب ، على صيغة النهي من الاباء  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : كذا في عب ، ورسمه في ص : ( لا تابا ) والمراد لا تاب ، على صيغة النهي من الاباء","","Sunan Sa'id ibn Mansur 1779","","شريح بن الحارث الكندي عن محمد بن سيرين عن هشام بن حسان العتكي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2957","1780  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  جُوَيْبِرٌ  ، عَنِ  الضَّحَّاكِ ، أَنَّهُ قَالَ : «  لِكُلِّ مُطَلَّقَةٍ مَتَاعٌ حَتَّى  الْمُخْتَلِعَةِ  » .","","Sunan Sa'id ibn Mansur 1780","","الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2958","1781  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ  ، عَنْ  عَمْرِو بْنِ دِينَارٍ ، قَالَ :  طَلَّقَ ابْنُ عُمَرَ امْرَأَةً لَهُ ، فَقَالَتْ لَهُ : هَلْ رَأَيْتَ مِنِّي شَيْئًا تَكْرَهُهُ ؟  قَالَ : « لَا » قَالَتْ :         [7/29]      فَفِيمَ تُطَلَّقُ الْعَفِيفَةُ الْمُسْلِمَةُ ؟ قَالَ : فَارْتَجَعَهَا  .","","Sunan Sa'id ibn Mansur 1781","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2959","1782  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ  ، عَنْ  عَمْرِو بْنِ دِينَارٍ  ، عَنْ  عَطَاءٍ  ، عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : «  إِذَا فُوِّضَ إِلَى الرَّجُلِ فَطَلَّقَ قَبْلَ أَنْ يَمَسَّ وَيَفْرِضَ فَلَيْسَ لَهَا إِلَّا الْمَتَاعُ  » .","","Sunan Sa'id ibn Mansur 1782","","عبد الله بن عباس عن عطاء بن أبي رباح عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2960","1783  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، قَالَ :  سَأَلْتُ  ابْنَ أَبِي نَجِيحٍ سُئِلَ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَهُ قَبْلَ أَنْ يَدْخُلَ بِهَا ،  وَقَدْ  فَرَضَ  لَهَا هَلْ لَهَا مَتَاعٌ ؟ فَقَالَ : كَانَ عَطَاءٌ يَقُولُ : « لَا مَتَاعَ لَهَا  » .","","Sunan Sa'id ibn Mansur 1783","","عطاء بن أبي رباح عن عبد الله بن أبي نجيح عن إسماعيل ابن علية عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2961","1784  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، قَالَ :  أَنَا  أَيُّوبُ ، قَالَ :  سَمِعْتُ  سَعِيدَ بْنَ جُبَيْرٍ ، يَقُولُ : «  لِكُلِّ مُطَلَّقَةٍ مَتَاعٌ  » .","","Sunan Sa'id ibn Mansur 1784","","سعيد بن جبير الأسدي عن أيوب السختياني عن إسماعيل ابن علية عن سعيد بن منصور","باب ما جاء في متاع المطلقة"
"2962","بَابُ الرَّجُلِ تَلِدُ مِنْهُ أَمَةٌ ثُمَّ يَشْتَرِيهَا .  1785  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ، وَمَنْصُورٌ  ، عَنِ  الْحَسَنِ ،  فِي رَجُلٍ زُوِّجَ  أَمَةً فَوَلَدَتْ مِنْهُ أَوْلَادًا ، ثُمَّ اشْتَرَاهَا  ، قَالَ : « هِيَ أُمُّ وَلَدٍ وَلَا يَبِيعُهَا  » .  كذا في طبعة الدار طبعة الدار السلفية بالهند ، وقال المحقق : كذا في ص ، والظاهر ( تزوج )","","Sunan Sa'id ibn Mansur 1785","","الحسن البصري عن منصور بن المعتمر عن هشيم بن بشير عن سعيد بن منصور","باب الرجل تلد منه أمة ثم يشتريها"
"2963","[7/30]      1786  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ  ، عَنْ  يُونُسَ  ، عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  هِيَ أُمُّ وَلَدٍ  » .","","Sunan Sa'id ibn Mansur 1786","","الحسن البصري عن يونس بن عبيد عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل تلد منه أمة ثم يشتريها"
"2964","1787  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدٌ  ، عَنْ  مُغِيرَةَ  ، عَنْ  حَمَّادٍ  ، عَنْ  إِبْرَاهِيمَ ، قَالَ : «  لَا تَكُونُ أُمَّ وَلَدٍ حَتَّى تُحْدِثَ عِنْدَهُ وَلَدًا آخَرَ  » .","","Sunan Sa'id ibn Mansur 1787","","إبراهيم النخعي عن حماد بن أبي سليمان عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب الرجل تلد منه أمة ثم يشتريها"
"2965","1788  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ  ، عَنْ  أَصْحَابِهِ  ، عَنْ  إِبْرَاهِيمَ ، مِثْلَهُ . قَالَ  هُشَيْمٌ  : وَهُوَ الْقَوْلُ .","","Sunan Sa'id ibn Mansur 1788","","إبراهيم النخعي عن أصحاب المغيرة بن مقسم الضبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب الرجل تلد منه أمة ثم يشتريها"
"2966","1789  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  فُضَيْلٌ أَبُو مُعَاذٍ  ، عَنْ  أَبِي حَرِيزٍ ، قَالَ :  نَا  الشَّعْبِيُّ ،  أَنَّ رَجُلًا كَانَتْ لَهُ امْرَأَةٌ حُرَّةٌ ، وَأَمَةٌ تَزَوَّجَهَا فَوُلِدَ لَهُ مِنْهَا  ، فَكَانَ كُلَّمَا وُلِدَ لَهُ مِنَ الْأَمَةِ وَلَدٌ  أُعْتِقَ  ، فَاشْتَرَاهَا بَعْدَ ذَلِكَ ، وَمَاتَ قَبْلَ أَنْ تَلِدَ مِنْهُ ، فَخَاصَمَ وَلَدُهَا وَلَدَ الْحُرَّةِ إِلَى  شُرَيْحٍ  ، فَأَرْسَلَهُمْ  شُرَيْحٌ  إِلَى عَبِيدَةَ ، فَقَالَ  عُبَيْدَةُ  : « هِيَ أَمَةٌ ، وَإِنَّمَا تُعْتَقُ لَوْ أَنَّهَا وَلَدَتْ أَوْلَادًا أَحْرَارًا ، وَإِنَّمَا وَلَدَتْهُمْ وَهُمْ مَمْلُوكُونَ ، فَهِيَ أَمَةٌ » فَأَعْتِقُوهَا مِنْ نَصِيبِ أَوْلَادِهَا  .","","Sunan Sa'id ibn Mansur 1789","","عبيدة بن عمرو السلماني عن الشعبي عن عبد الله بن الحسين السجستاني عن فضيل بن ميسرة عن هشيم بن بشير عن سعيد بن منصور","باب الرجل تلد منه أمة ثم يشتريها"
"2967","بَابُ مَنْ كَانَ لَا يَرَى طَلَاقَ  الشِّرْكِ  شَيْئًا .  1790  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ  ، عَنِ  الْحَسَنِ ، «  أَنَّهُ كَانَ لَا يَرَى طَلَاقَ  الشِّرْكِ  شَيْئًا  » .","","Sunan Sa'id ibn Mansur 1790","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب من كان لا يرى طلاق الشرك شيئا"
"2968","1791  -  حَدَّثَنَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ  ، عَنْ  إِبْرَاهِيمَ ،  أَنَّهُ «  كَانَ يَرَاهُ جَائِزًا  » .","","Sunan Sa'id ibn Mansur 1791","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب من كان لا يرى طلاق الشرك شيئا"
"2969","[7/31]      1792  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ .. الشَّعْبِيُّ  أَنَّهُ « كَانَ يَرَاهُ جَائِزًا  » .","","Sunan Sa'id ibn Mansur 1792","","الشعبي عن هشيم بن بشير عن سعيد بن منصور","باب من كان لا يرى طلاق الشرك شيئا"
"2970","1793  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ  ، عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  مَنْ كَانَ عَلَى غَيْرِ الْإِسْلَامِ فَتَزَوَّجَ امْرَأَةً وَابْنَتَهَا  ، فَدَخَلَ بِوَاحِدَةٍ مِنْهُمَا ، ثُمَّ أَسْلَمُوا فَقَدْ حَرُمَتَا عَلَيْهِ  » .","","Sunan Sa'id ibn Mansur 1793","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب من كان لا يرى طلاق الشرك شيئا"
"2971","بَابُ مَنْ طَلَّقَ امْرَأَتَهُ وَظَنَّ أَنَّ لَهُ رَجْعَةً .  1794  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُطَرِّفٌ  ، عَنْ  حَمَّادٍ ،  فِي رَجُلٍ طَلَّقَ امْرَأَتَهُ قَبْلَ أَنْ يَدْخُلَ بِهَا  ، فَظَنَّ لَهُ عَلَيْهَا رَجْعَةً فَوَاقَعَهَا ، قَالَ : « عَلَيْهِ مَهْرٌ وَنِصْفٌ  » .","","Sunan Sa'id ibn Mansur 1794","","حماد بن أبي سليمان عن مطرف بن طريف عن هشيم بن بشير عن سعيد بن منصور","باب من طلق امرأته وظن أن له رجعة"
"2972","1795  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ، وَمَنْصُورٌ  ، عَنِ  الْحَسَنِ ، أَنَّهُ قَالَ : «  صَدَاقٌ وَاحِدٌ  » .","","Sunan Sa'id ibn Mansur 1795","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب من طلق امرأته وظن أن له رجعة"
"2973","1796  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ  ، عَنْ  مُحَمَّدِ بْنِ سَالِمٍ  ، عَنِ  الشَّعْبِيِّ ، مِثْلَ قَوْلِ  الْحَسَنِ  .         [7/32]","","Sunan Sa'id ibn Mansur 1796","","الشعبي عن محمد بن سالم الهمداني عن هشيم بن بشير عن سعيد بن منصور","باب من طلق امرأته وظن أن له رجعة"
"2974","1797  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُطَرِّفٌ  ، عَنِ  الْحَكَمِ مِثْلَ ذَلِكَ ، قَالَ سَعِيدٌ :  الْقَوْلُ قَوْلُ  حَمَّادٍ  .","","Sunan Sa'id ibn Mansur 1797","","الحكم بن عتيبة الكندي عن مطرف بن طريف عن هشيم بن بشير عن سعيد بن منصور","باب من طلق امرأته وظن أن له رجعة"
"2975","بَابُ مَنْ  وَقَّتَ  لِلطَّلَاقِ وَقْتًا .  1798  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ  ، عَنْ  إِبْرَاهِيمَ ، قَالَ : «  مَنْ  وَقَّتَ  لِلطَّلَاقِ وَقْتًا ، فَإِذَا جَاءَ ذَلِكَ الْوَقْتُ وَقَعَ الطَّلَاقُ  » .","","Sunan Sa'id ibn Mansur 1798","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب من وقت للطلاق وقتا"
"2976","1799  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ  ، عَنْ  إِبْرَاهِيمَ ، قَالَ : «  إِذَا  وَقَّتَ  فِي الطَّلَاقِ وَالْعَتَاقِ وَقَعَ  ، وَإِذَا لَمْ يُوَقِّتْ لَمْ يَقَعْ  » .","","Sunan Sa'id ibn Mansur 1799","","إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب من وقت للطلاق وقتا"
"2977","1800  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  عُبَيْدَةُ  ، عَنِ  الشَّعْبِيِّ ، مِثْلَهُ .","","Sunan Sa'id ibn Mansur 1800","","الشعبي عن عبيدة بن معتب الضبي عن أبو معاوية الضرير عن سعيد بن منصور","باب من وقت للطلاق وقتا"
"2978","1801  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ  ، عَنْ  يَحْيَى بْنِ سَعِيدٍ  ، عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ : «  إِذَا قَالَ الرَّجُلُ لِامْرَأَتِهِ : أَنْتِ طَالِقٌ إِلَى سَنَةٍ فَهِيَ طَالِقٌ حِينَئِذٍ  » .         [7/33]","","Sunan Sa'id ibn Mansur 1801","","سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن حماد بن زيد عن سعيد بن منصور","باب من وقت للطلاق وقتا"
"2979","1802  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ  ، عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، «  أَنَّهُ كَانَ لَا يُؤَجِّلُ فِي الطَّلَاقِ  » .","","Sunan Sa'id ibn Mansur 1802","","سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن هشيم بن بشير عن سعيد بن منصور","باب من وقت للطلاق وقتا"
"2980","1803  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ  ، عَنْ  مَنْصُورٍ ، وَيُونُسَ  ، عَنِ  الْحَسَنِ ، «  أَنَّهُ كَانَ لَا يُؤَجِّلُ فِي الطَّلَاقِ  » .","","Sunan Sa'id ibn Mansur 1803","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور","باب من وقت للطلاق وقتا"
"2981","بَابُ مَا جَاءَ فِيمَنْ بَدَأَ بِالْيَمِينِ فِي الطَّلَاقِ وَالْعَتَاقِ قَبْلَ الِاسْتِثْنَاءِ .  1804  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ  ، عَنْ  مَنْصُورٍ  ، عَنْ  إِبْرَاهِيمَ ، قَالَ : كَانَ شُرَيْحٌ يَقُولُ : «  مَتَى بَدَأَ بِالْيَمِينِ فِي الطَّلَاقِ وَالْعَتَاقِ قَبْلَ الْمَثْنَوِيَّةِ فَقَدْ وَقَعَ عَلَيْهِ الطَّلَاقُ  وَالْعَتَاقُ  » .","","Sunan Sa'id ibn Mansur 1804","","شريح بن الحارث الكندي عن إبراهيم النخعي عن منصور بن المعتمر عن جرير بن عبد الحميد عن سعيد بن منصور","باب ما جاء فيمن بدأ باليمين في الطلاق والعتاق قبل الاستثناء"
"2982","[7/34]      1805  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  جَرِيرٌ  ، عَنْ  مَنْصُورٍ ، قَالَ : قَالَ سَعِيدُ بْنُ جُبَيْرٍ : «  إِنْ لَمْ يَحْنَثْ فَلَا يَقَعُ عَلَيْهِ  » .","","Sunan Sa'id ibn Mansur 1805","","سعيد بن جبير الأسدي عن منصور بن المعتمر عن جرير بن عبد الحميد عن سعيد بن منصور","باب ما جاء فيمن بدأ باليمين في الطلاق والعتاق قبل الاستثناء"
"2983","1806  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ  ، عَنْ  إِبْرَاهِيمَ  ، عَنْ  شُرَيْحٍ ، قَالَ :  إِذَا بَدَأَ الرَّجُلُ بِالطَّلَاقِ وَقَعَ ؛ حَنِثَ أَوْ لَمْ يَحْنَثْ  ، قَالَ : وَكَانَ  إِبْرَاهِيمُ  يَقُولُ : وَمَا يَدْرِي  شُرَيْحٌ  .","","Sunan Sa'id ibn Mansur 1806","","شريح بن الحارث الكندي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور","باب ما جاء فيمن بدأ باليمين في الطلاق والعتاق قبل الاستثناء"
"2984","1807  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ  ، عَنْ  إِبْرَاهِيمَ  ، عَنْ  شُرَيْحٍ ، قَالَ : «  مَنْ بَدَأَ بِالطَّلَاقِ فَلَا اسْتِثْنَاءَ عَلَيْهِ  » .","","Sunan Sa'id ibn Mansur 1807","","شريح بن الحارث الكندي عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن بدأ باليمين في الطلاق والعتاق قبل الاستثناء"
"2985","1808  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  حُصَيْنٌ  ، عَنِ  الشَّعْبِيِّ  ، عَنْ  شُرَيْحٍ ، أَنَّهُ كَانَ يَقُولُ : «  مَنْ بَدَأَ بِالطَّلَاقِ لَزِمَهُ الطَّلَاقُ  » .","","Sunan Sa'id ibn Mansur 1808","","شريح بن الحارث الكندي عن الشعبي عن حصين بن عبد الرحمن السلمي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن بدأ باليمين في الطلاق والعتاق قبل الاستثناء"
"2986","1809  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ  ، عَنْ  مُغِيرَةَ  ، عَنْ  إِبْرَاهِيمَ  ، عَنْ  شُرَيْحٍ ، أَنَّهُ كَانَ يَقُولُ : «  إِذَا بَدَأَ الرَّجُلُ بِالطَّلَاقِ لَمْ يُغْنِ شَرْطُهُ شَيْئًا  » .","","Sunan Sa'id ibn Mansur 1809","","شريح بن الحارث الكندي عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء فيمن بدأ باليمين في الطلاق والعتاق قبل الاستثناء"
"2987","1810  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  خَالِدٌ  ، عَنْ  مُغِيرَةَ  ، عَنْ  إِبْرَاهِيمَ ،  فِي رَجُلٍ قَالَتْ لَهُ امْرَأَتُهُ : بَلَغَنِي أَنَّكَ تَزَوَّجْتَ  ، فَقَالَ : كُلُّ امْرَأَةٍ لَهُ غَيْرَكِ طَالِقٌ ، فَأَخْبَرَهُ بِقَوْلِ  شُرَيْحٍ  بِتَقْدِيمِ الطَّلَاقِ وَتَأْخِيرِهِ  .         [7/35]","","Sunan Sa'id ibn Mansur 1810","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن سعيد بن منصور","باب ما جاء فيمن بدأ باليمين في الطلاق والعتاق قبل الاستثناء"
"2988","1811  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ  ، عَنْ  سَيَّارٍ  ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ ثَرْوَانَ ، قَالَ :  لَقَدْ تَرَكَ  شُرَيْحٌ  فِي صُدُورِ الْوَرِعِينَ فِيهَا هَاجِسًا  .","","Sunan Sa'id ibn Mansur 1811","","عبد الرحمن بن ثروان الأودي عن سيار بن أبي سيار العنزي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن بدأ باليمين في الطلاق والعتاق قبل الاستثناء"
"2989","1812  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ  ، عَنْ  لَيْثٍ  ، عَنْ  طَاوُسٍ  فِي الرَّجُلِ يَقُولُ : إِنْ لَمْ أَفْعَلْ كَذَا وَكَذَا ، فَامْرَأَتُهُ طَالِقٌ إِنْ شَاءَ اللهُ  ، قَالَ : «  ثُنْيَاهُ  فِي الطَّلَاقِ وَالْعَتَاقِ  » .","","Sunan Sa'id ibn Mansur 1812","","طاوس بن كيسان عن ليث بن أبي سليم عن حماد بن زيد عن سعيد بن منصور","باب ما جاء فيمن بدأ باليمين في الطلاق والعتاق قبل الاستثناء"
"2990","1813  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، قَالَ :  نَا  لَيْثٌ  ، عَنْ  عَطَاءٍ ، وَطَاوُسٍ ، وَمُجَاهِدٍ ، وَالنَّخَعِيِّ ، وَالزُّهْرِيِّ ، أَنَّهُمْ قَالُوا : «  إِذَا قَالَ الرَّجُلُ لِامْرَأَتِهِ : أَنْتِ طَالِقٌ إِنْ لَمْ تَفْعَلِي كَذَا وَكَذَا  ، إِنْ شَاءَ اللهُ فَلَمْ تَفْعَلْ لَهُ  ثُنْيَاهُ  » .","","Sunan Sa'id ibn Mansur 1813","","الزهري عن ليث بن أبي سليم عن إسماعيل ابن علية عن سعيد بن منصور","باب ما جاء فيمن بدأ باليمين في الطلاق والعتاق قبل الاستثناء"
"2991","1814  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  ابْنُ الْمُبَارَكِ  ، عَنْ  مَعْمَرٍ  ، عَنِ  ابْنِ طَاوُسٍ  ، عَنْ  أَبِيهِ  «  أَنَّهُ كَانَ يَرَى الِاسْتِثْنَاءَ فِي الطَّلَاقِ جَائِزًا  » .","","Sunan Sa'id ibn Mansur 1814","","طاوس بن كيسان عن عبد الله بن طاووس عن معمر بن راشد عن عبد الله بن المبارك عن سعيد بن منصور","باب ما جاء فيمن بدأ باليمين في الطلاق والعتاق قبل الاستثناء"
"2992","1815  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ  ، عَنْ  عَبْدِ الْمَلِكِ  ، عَنْ  عَطَاءٍ ،  فِي رَجُلٍ قَالَ لِغُلَامِهِ : «  أَعْتِقُكَ  إِنْ شَاءَ اللهُ  » ، فَلَمْ يَرَهُ عِتْقًا  » .","","Sunan Sa'id ibn Mansur 1815","","عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن عبد الله بن المبارك عن سعيد بن منصور","باب ما جاء فيمن بدأ باليمين في الطلاق والعتاق قبل الاستثناء"
"2993","1816  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ، قَالَ :  أَنَا  أَشْعَثُ         [7/36]      بْنُ حَسَّانَ ، قَالَ :  سَأَلْتُ أَبَا مِجْلَزٍ عَنْ رَجُلٍ ، قَالَ : إِنْ دَخَلْتُ دَارَ فُلَانٍ فَامْرَأَتُهُ طَالِقٌ ثَلَاثًا  ، قُلْتُ : إِلَّا إِنْ شَاءَ اللهُ ، إِلَّا إِنْ يَشَأِ اللهُ ، قَالَ  أَبُو مِجْلَزٍ  : « أَلَيْسَ قَدِ اسْتَثْنَى لِيَدْخُلَهَا إِنْ شَاءَ  » .","","Sunan Sa'id ibn Mansur 1816","","لاحق بن حميد عن أشعث بن حسان الخراساني عن عبد الله بن المبارك عن سعيد بن منصور","باب ما جاء فيمن بدأ باليمين في الطلاق والعتاق قبل الاستثناء"
"2994","1817  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ  ، عَنِ  الْحَسَنِ ، «  أَنَّهُ كَانَ  يُجِيزُ  الثُّنْيَا  فِي الطَّلَاقِ  ، قَدَّمَ الطَّلَاقَ أَوْ أَخَّرَهُ بَعْدَ أَنْ يَصِلَ ذَلِكَ بِمَنْطِقِهِ وَكَلَامِهِ  » .","","Sunan Sa'id ibn Mansur 1817","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن بدأ باليمين في الطلاق والعتاق قبل الاستثناء"
"2995","1818  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  إِسْمَاعِيلُ بْنُ سَالِمٍ ، قَالَ :  سَمِعْتُ  الشَّعْبِيَّ ، يَقُولُ ذَلِكَ .","","Sunan Sa'id ibn Mansur 1818","","الشعبي عن إسماعيل بن سالم الأسدي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن بدأ باليمين في الطلاق والعتاق قبل الاستثناء"
"2996","1819  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  هِشَامٌ  ، عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  لَيْسَ فِي الطَّلَاقِ وَالْعَتَاقِ اسْتِثْنَاءٌ  » .","","Sunan Sa'id ibn Mansur 1819","","الحسن البصري عن هشام بن حسان العتكي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء فيمن بدأ باليمين في الطلاق والعتاق قبل الاستثناء"
"2997","بَابُ مَا جَاءَ فِي الظِّهَارِ .  1820  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ  ، عَنِ  الْحَسَنِ ، أَنَّهُ كَانَ يَقُولُ : «  مَنْ ظَاهَرَ مِنِ امْرَأَتِهِ ثُمَّ طَلَّقَهَا ، ثُمَّ تَزَوَّجَهَا غَيْرُهُ  ، ثُمَّ فَارَقَهَا ، وَتَزَوَّجَهَا زَوْجُهَا الْأَوَّلُ . قَالَ : لَا يَقْرَبُهَا حَتَّى يُكَفِّرَ  » .         [7/37]","","Sunan Sa'id ibn Mansur 1820","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الظهار"
"2998","1821  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ  ، عَنِ  الْحَسَنِ ، «  أَنَّهُ كَانَ لَا يُوَقِّتُ فِي الظِّهَارِ وَقْتًا  » .","","Sunan Sa'id ibn Mansur 1821","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الظهار"
"2999","1822  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  هُشَيْمٌ ، قَالَ :  أَنَا  مُغِيرَةُ  ، عَنْ  إِبْرَاهِيمَ ، «  أَنَّهُ كَانَ لَا يُوَقِّتُ فِي الظِّهَارِ وَقْتًا  إِلَّا أَنْ يَقُولَ : إِنْ قَرَبْتُكِ وَأَنْتِ عَلَيَّ كَظَهْرِ أُمِّي ، فَإِذَا قَالَ ذَلِكَ فَمَضَتْ أَرْبَعَةُ أَشْهُرٍ قَبْلَ أَنْ يَمَسَّهَا  بَانَتْ  بِإِيلَاءٍ  » .","","Sunan Sa'id ibn Mansur 1822","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور","باب ما جاء في الظهار"
"3000","1823  -  حَدَّثَنَا  سَعِيدٌ قَالَ :  نَا  سُفْيَانُ  ، عَنْ  هِشَامِ بْنِ حُجَيْرٍ  ، عَنْ  طَاوُسٍ ، قَالَ : «  إِذَا ظَاهَرَ الرَّجُلُ مِنِ امْرَأَتِهِ فَعَلَيْهِ الْكَفَّارَةُ  ، بَرَّأَ وَلَمْ يَبَرَّ  » .","","Sunan Sa'id ibn Mansur 1823","","طاوس بن كيسان عن هشام بن حجير الحجازي عن سفيان بن عيينة عن سعيد بن منصور","باب ما جاء في الظهار"
