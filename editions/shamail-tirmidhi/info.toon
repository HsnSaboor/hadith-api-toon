sections[57]{id,name,name_ar,name_bn,name_en,name_fr,name_id,name_ru,name_tr,name_ur,hadith_first,hadith_last,arabic_first,arabic_last,name_hi,name_ta,name_roman-ur,name_de,name_es}:
"0","The Seeing Of Rasoolullah In a Dream","باب ماجاء في رؤية رسول الله صلى الله عليه وسلم","স্বপ্নে রাসূলুল্লাহকে দেখা","The Seeing Of Rasoolullah In a Dream","Voir le Messager d'Allah en Rêve","Melihat Rasulullah Dalam Mimpi","Видение Посланника Аллаха во Сне","Resulullah'ı Rüyada Görmek","خواب میں رسول اللہ کو دیکھنا","403","417","403","417","रसूलुल्लाह ﷺ को स्वप्न में देखना","ரசூலுல்லாஹ்வை கனவில் காண்பது","Rasoolullah Ka Khwab Mein Deekha Jana","Das Sehen von Rasoolullah im Traum","El Ver a Rasoolullah en un Sueño"
"1","The Noble Features Of Rasoolullah","صفة رسول الله صلى الله عليه وسلم","রাসূলুল্লাহর মহান বৈশিষ্ট্য","The Noble Features Of Rasoolullah","Les Traits Nobles du Messager d'Allah","Sifat-sifat Mulia Rasulullah","Благородные Черты Посланника Аллаха","Resulullah'ın Şerefli Özellikleri","رسول اللہ کے شاندار اوصاف","1","16","1","16","रसूलुल्लाह ﷺ की पवित्र विशेषताएँ","ரசூலுல்லாஹ்வின் புனித அம்சங்கள்","Rasoolullah Ke Mubarak Naqsh-o-Nigaar","Die edlen Gesichtszüge von Rasoolullah","Los Nobles Rasgos de Rasoolullah"
"2","Seal Of Nubuwwah (Prophethood) Of Rasoolullah","خاتم النبوة","রাসূলুল্লাহর নবুয়তের মোহর","Seal Of Nubuwwah (Prophethood) Of Rasoolullah","Sceau de la Prophétie du Messager d'Allah","Segel Kenabian Rasulullah","Печать Пророчества Посланника Аллаха","Resulullah'ın Nübüvvet Mührü","رسول اللہ کی نبوت کی مہر","17","24","17","24","रसूलुल्लाह ﷺ की नुबूवत की मुहर","ரசூலுல்லாஹ்வின் நபுவ்வத் முத்திரை","Rasoolullah Ki Mohar-e-Nubuwwat","Das Siegel der Nubuwwah (Prophetentum) von Rasoolullah","El Sello de la Nubuwwah (Profecía) de Rasoolullah"
"3","The Mubarak Hair Of Rasoolullah","شعر رسول الله صلى الله عليه وسلم","রাসূলুল্লাহর মুবারক চুল","The Mubarak Hair Of Rasoolullah","Les Cheveux Bénis du Messager d'Allah","Rambut Berkah Rasulullah","Благословенные Волосы Посланника Аллаха","Resulullah'ın Mübarek Saçları","رسول اللہ کے مبارک بال","25","32","25","32","रसूलुल्लाह ﷺ के पवित्र बाल","ரசூலுல்லாஹ்வின் முபாரக் திருமுடி","Rasoolullah Ke Mubarak Baal","Das gesegnete Haar von Rasoolullah","El Cabello Mubarak de Rasoolullah"
