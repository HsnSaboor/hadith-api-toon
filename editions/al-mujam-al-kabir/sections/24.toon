hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"13801","13765  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  خَيْثَمَةَ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ : مَتَى نُوتِرُ ؟ قَالَ :  كُنَّا نُوتِرُ مِنْ آخِرِ اللَّيْلِ  .","","Al-Mu'jam al-Kabir 13765","","عبد الله بن عمر بن الخطاب عن خيثمة بن عبد الرحمن الجعفي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13802","13766  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  يَحْيَى بْنِ وَثَّابٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُؤْمِنُ الَّذِي يُخَالِطُ النَّاسَ  وَيَكْظِمُ  الْغَيْظَ أَعْظَمُ أَجْرًا  مِنَ الْمُؤْمِنِ الَّذِي لَا يُخَالِطُ النَّاسَ وَلَا يَصْبِرُ عَلَى أَذَاهُمْ  .","","Al-Mu'jam al-Kabir 13766","","عبد الله بن عمر بن الخطاب عن يحيى بن وثاب الأصبهاني عن الأعمش عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13803","[13/113]      13767  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ الصَّلْتِ أَبُو يَعْلَى التَّوَّزِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  حُصَيْنٍ ،  عَنْ  يَحْيَى بْنِ وَثَّابٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْمُؤْمِنُ الَّذِي يُخَالِطُ النَّاسَ وَيَصْبِرُ عَلَى أَذَاهُمْ أَفْضَلُ  مِنَ الْمُؤْمِنِ الَّذِي لَا يُخَالِطُ النَّاسَ وَلَا يَصْبِرُ عَلَى أَذَاهُمْ  .","","Al-Mu'jam al-Kabir 13767","","عبد الله بن عمر بن الخطاب عن يحيى بن وثاب الأصبهاني عن حصين بن عبد الرحمن السلمي عن سفيان بن عيينة عن محمد بن الصلت التوزي عن محمد بن محمد بن حيان التمار عن الطبراني","عمرو بن دينار عن ابن عمر"
"13804","[13/114]      13768  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ،  أَبَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ وَأَبِي حَصِينٍ ،  عَنْ  يَحْيَى بْنِ وَثَّابٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ أَتَى الْجُمُعَةَ فَلْيَغْتَسِلْ  .","","Al-Mu'jam al-Kabir 13768","","عبد الله بن عمر بن الخطاب عن يحيى بن وثاب الأصبهاني عن عثمان بن عاصم بن حصين عن شريك بن عبد الله النخعي عن محمد بن سعيد حمدان عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13805","13769  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَبَنَا  شُعْبَةُ ،  عَنْ  حُصَيْنٍ ،  عَنْ  يَحْيَى بْنِ وَثَّابٍ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ ، عَنِ الْغُسْلِ يَوْمَ الْجُمُعَةِ ؟ فَقَالَ : أُمِرْنَا بِهِ  .","","Al-Mu'jam al-Kabir 13769","","عبد الله بن عمر بن الخطاب عن يحيى بن وثاب الأصبهاني عن حصين بن عبد الرحمن السلمي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن عثمان بن حفص الضبي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13806","[13/115]      13770  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  الْفَضْلُ بْنُ مُوسَى السِّينَانِيُّ ،  عَنْ  أَبَانَ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ ،  عَنْ  أَبِي بَكْرِ بْنِ حَفْصٍ  أَنَّ  ابْنَ عُمَرَ لَمْ يُصَلِّي قَبْلَ الْعِيدِ وَلَا بَعْدَهَا  فَقِيلَ لَهُ ؟ فَقَالَ :  لَمْ أَرَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى قَبْلَهَا وَلَا بَعْدَهَا  .","","Al-Mu'jam al-Kabir 13770","","عبد الله بن عمر بن الخطاب عن عبد الله بن حفص بن عمر بن سعد بن أبي وقاص عن أبان بن عبد الله بن أبي حازم عن الفضل بن موسى السيناني عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","عمرو بن دينار عن ابن عمر"
"13807","13771  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا         [13/116]      أَبُو مُعَاوِيَةَ مُحَمَّدُ بْنُ خَازِمٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبْجَرَ ،  عَنْ  ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ أَدْنَى أَهْلِ الْجَنَّةِ مَنْزِلَةً لَرَجُلٌ يَنْظُرُ فِي مُلْكِهِ أَلْفَيْ سَنَةٍ  ، يَرَى أَقْصَاهُ كَمَا يَرَى أَدْنَاهُ ، يَنْظُرُ إِلَى أَزْوَاجِهِ وَسُرُرِهِ وَخَدَمِهِ ، وَإِنَّ أَفْضَلَهُمْ مَنْزِلَةً مَنْ يَنْظُرُ فِي وَجْهِ اللهِ كُلَّ يَوْمٍ مَرَّتَيْنِ  .","","Al-Mu'jam al-Kabir 13771","","عبد الله بن عمر بن الخطاب عن ثوير بن أبي فاختة مولى أم هانئ عن عبد الملك بن سعيد بن حيان عن أبو معاوية الضرير عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13808","[13/117]      13772  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ نَبِيذِ  الْحَنْتَمَةِ  .  قَالَ  شُعْبَةُ  :  قُلْتُ  لِجَبَلَةَ  : مَا  الْحَنْتَمَةُ  ؟ قَالَ : الْجَرَّةُ  .","","Al-Mu'jam al-Kabir 13772","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13809","13773  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  ثَنَا  خَالِدٌ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نُهِيَ عَنِ  الْحَنْتَمَةِ  ،  قُلْتُ : وَمَا  الْحَنْتَمَةُ  ؟ قَالَ : الْجَرَّةُ  .","","Al-Mu'jam al-Kabir 13773","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن سليمان بن فيروز الشيباني عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","عمرو بن دينار عن ابن عمر"
"13810","13774  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ .         [13/118]      وَحَدَّثَنَا  الْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ وَحَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ، قَالُوا :  ثَنَا  شُعْبَةُ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الشَّهْرُ  هَكَذَا وَهَكَذَا ; ثَلَاثُونَ وَتِسْعٌ وَعِشْرُونَ  .","","Al-Mu'jam al-Kabir 13774","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13811","13775  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الرَّقِّيُّ .  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَا :  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ         [13/119]      ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ :  مَنْ أَكَلَ مَعَ قَوْمٍ تَمْرًا فَلَا يَقْرِنْ إِلَّا أَنْ يَأْذَنُوا لَهُ  .","","Al-Mu'jam al-Kabir 13775","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن عبد الله بن جعفر بن غيلان عن أبو شعيب الحراني عن الطبراني","عمرو بن دينار عن ابن عمر"
"13812","13776  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ،  ثَنَا  الْفَضْلُ بْنُ زِيَادٍ الطَّسْتِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي غَنِيَّةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنِ  الْقِرَانِ  فِي التَّمْرِ  .","","Al-Mu'jam al-Kabir 13776","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن عبد الملك بن حميد الخزاعي عن يحيى بن عبد الملك بن حميد عن الطستي الفضل بن زياد عن محمد بن الفضل بن جابر السقطى عن الطبراني","عمرو بن دينار عن ابن عمر"
"13813","13777  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ شَبِيبٍ الْعَسَّالُ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْقِرَانِ  فِي التَّمْرِ  إِلَّا أَنْ يَسْتَأْذِنَ الرَّجُلُ أَصْحَابَهُ ، فَإِنْ أَذِنُوا لَهُ فَلْيَأْكُلْ كَيْفَ شَاءَ  .","","Al-Mu'jam al-Kabir 13777","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن قيس بن الربيع الأسدي عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","عمرو بن دينار عن ابن عمر"
"13814","13778  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ وَمُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ .         [13/120]      وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  عَمْرُو بْنُ حَكَّامٍ قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنِ  الْقِرَانِ  إِلَّا أَنْ يَسْتَأْذِنَ الرَّجُلُ أَخَاهُ  .","","Al-Mu'jam al-Kabir 13778","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن شعبة بن الحجاج عن عاصم بن علي الواسطي عن لحية الليف محمد بن العباس عن الطبراني","عمرو بن دينار عن ابن عمر"
"13815","13779  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  سُرَيْجُ بْنُ يُونُسَ .  وَحَدَّثَنَا أَحْمَدُ بْنُ مُحَمَّدٍ الْخُزَاعِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بُكَيْرٍ الْحَضْرَمِيُّ ; قَالَا :  ثَنَا  عُمَرُ بْنُ عُبَيْدٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْقِرَانِ  بَيْنَ التَّمْرِ  إِلَّا أَنْ يَسْتَأْذِنَ الرَّجُلُ صَاحِبَهُ  .","","Al-Mu'jam al-Kabir 13779","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن مسعر بن كدام عن عمر بن عبيد الطنافسي عن سريج بن يونس المروزي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13816","[13/121]      13780  -  حَدَّثَنَا  عَلِيُّ بْنُ الْعَبَّاسِ الْكُوفِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ يُوسُفَ الصَّيْرَفِيُّ ،  ثَنَا  الْأَشْجَعِيُّ ،  عَنْ  سُفْيَانَ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى أَنْ يَقْرِنَ بَيْنَ التَّمْرَتَيْنِ  .","","Al-Mu'jam al-Kabir 13780","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن سفيان الثوري عن عبيد الله بن عبيد الرحمن الأشجعي عن إبراهيم بن يوسف الصيرفي عن المقانعي علي بن العباس بن الوليد عن الطبراني","عمرو بن دينار عن ابن عمر"
"13817","13781  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ حَمْزَةَ الْمَرْوَزِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَّامٍ ،  ثَنَا  عِيسَى بْنُ يُونُسَ  ،  عَنْ  أَبِي         [13/122]      حَمْزَةَ ،  عَنْ  رَقَبَةَ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ  نَهَى عَنِ  الْقِرَانِ  فِي التَّمْرِ  .  كذا في طبعة الجريسي ، ولعل الصواب : (عيسى بن موسى) وينظر تعليق المحقق .","","Al-Mu'jam al-Kabir 13781","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن رقبة بن مصقلة عن محمد بن ميمون أبو حمزة السكري عن عيسى بن موسى غنجار عن محمد بن سلام البيكندي عن محمد بن علي بن حمزة المروزي عن علي بن سعيد بن بشير عليك عن الطبراني","عمرو بن دينار عن ابن عمر"
"13818","13782  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  عَمْرُو بْنُ حَكَّامٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي فِي  الْبَيْتِ  ،  يَعْنِي  الْكَعْبَةَ  .","","Al-Mu'jam al-Kabir 13782","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن شعبة بن الحجاج عن عمرو بن حكام الزنجبيلي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13819","13783  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ .         [13/123]      وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَحْمَدُ بْنُ النُّعْمَانِ الْفَرَّاءُ ، قَالَا :  ثَنَا  يَحْيَى بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي غَنِيَّةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  سَأَلَ سَائِلٌ عَنْ  عَلِيٍّ  ؟ فَقَالَ :  عَنْ أَيِّ أَمْرِ  عَلِيٍّ  تَسْأَلُ ؟  هَذَا بَيْتُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهَذَا بَيْتُهُ . !","","Al-Mu'jam al-Kabir 13783","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن عبد الملك بن حميد الخزاعي عن يحيى بن عبد الملك بن حميد عن أحمد بن النعمان الفراء عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13820","13784  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْخَضِرِ بْنِ مُحَمَّدٍ الْمَرْوَزِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدَةَ الْمَرْوَزِيُّ ،  ثَنَا  أَبُو مُعَاذٍ النَّحْوِيُّ الْفَضْلُ بْنُ خَالِدٍ ،  ثَنَا  أَبُو حَمْزَةَ ،  عَنْ  رَقَبَةَ بْنِ مَصْقَلَةَ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ صَلَّى مِنْكُمْ فَلَا يَفْتَرِشِ  افْتِرَاشَ  الْكَلْبِ ذِرَاعَيْهِ  .","","Al-Mu'jam al-Kabir 13784","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن رقبة بن مصقلة عن محمد بن ميمون أبو حمزة السكري عن الفضل بن خالد المروزي عن محمد بن عبدة المروزي عن أحمد بن الخضر المروزي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13821","13785  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  أَبُو الشَّعْثَاءِ عَلِيُّ بْنُ الْحَسَنِ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  حَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  نَافِعٍ وَجَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  أَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَالْمُسْلِمُونَ  بِالْمَدِينَةِ  عَشْرَ سِنِينَ يُضَحُّونَ  ، قَالَ : وَذَلِكَ السُّنَّةُ  .","","Al-Mu'jam al-Kabir 13785","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن حجاج بن أرطاة عن حفص بن غياث النخعي عن علي بن الحسن بن سليمان الحضرمي عن محمود بن محمد بن منويه المفيد عن الطبراني","عمرو بن دينار عن ابن عمر"
"13822","[13/124]      13786  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ ،  رَفَعَهُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  مَنِ  اسْتَجْمَرَ  ،  فَلْيَسْتَجْمِرْ  ثَلَاثًا  .","","Al-Mu'jam al-Kabir 13786","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن قيس بن الربيع الأسدي عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13823","13787  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ وَمُحَمَّدُ بْنُ عَلِيِّ بْنِ الْعَبَّاسِ النَّسَائِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنْ  قَيْسِ بْنِ الرَّبِيعِ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يُفَتَّشَ التَّمْرُ عَمَّا فِيهِ  .","","Al-Mu'jam al-Kabir 13787","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن قيس بن الربيع الأسدي عن إسماعيل بن زكريا شقوصا عن محمد بن بكار الرصافي عن محمد بن على بن العباس النسائي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13824","13788  -  حَدَّثَنَا  الْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ         [13/125]      الطَّيَالِسِيُّ وَحَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ، قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ جَرَّ ثَوْبًا مِنْ ثِيَابِهِ مِنْ  مَخِيلَةٍ  ، فَإِنَّ اللهَ لَا يَنْظُرُ إِلَيْهِ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 13788","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن شعبة بن الحجاج عن حفص بن عمر الحوضى عن الفضل بن الحباب الجمحي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13825","13789  -  حَدَّثَنَا  عَلِيُّ بْنُ الْعَبَّاسِ الْبَجَلِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ يُوسُفَ الصَّيْرَفِيُّ ،  ثَنَا  الْأَشْجَعِيُّ ،  عَنْ  سُفْيَانَ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ جَرَّ ثِيَابَهُ مِنَ  الْخُيَلَاءِ  لَا يَنْظُرُ اللهُ إِلَيْهِ  .","","Al-Mu'jam al-Kabir 13789","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن سفيان الثوري عن عبيد الله بن عبيد الرحمن الأشجعي عن إبراهيم بن يوسف الصيرفي عن المقانعي علي بن العباس بن الوليد عن الطبراني","عمرو بن دينار عن ابن عمر"
"13826","[13/126]      13790  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَبَنَا  خَالِدٌ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ جَرَّ ثَوْبًا  مَخِيلَةً  لَمْ يَنْظُرِ اللهُ إِلَيْهِ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 13790","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن سليمان بن فيروز الشيباني عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","عمرو بن دينار عن ابن عمر"
"13827","13791  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ بَهْرَامَ ، قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي  :  عَنْ  عَمْرِو بْنِ قَيْسٍ الْمُلَائِيِّ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ جَرَّ ثَوْبَهُ  خُيَلَاءَ  لَا يَنْظُرُ اللهُ إِلَيْهِ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 13791","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن عمرو بن قيس الملائي عن بهرام بن يحيى الكشي عن إسماعيل الوشاء عن علي بن سعيد بن بشير عليك عن الطبراني","عمرو بن دينار عن ابن عمر"
"13828","13792  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي غَنِيَّةَ ،  ثَنَا  أَبِي  ،  ثَنَا  جَبَلَةُ بْنُ سُحَيْمٍ ،  عَنِ         [13/127]      ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ جَرَّ ثَوْبَهُ  خُيَلَاءَ  لَمْ يَنْظُرِ اللهُ إِلَيْهِ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 13792","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن عبد الملك بن حميد الخزاعي عن يحيى بن عبد الملك بن حميد عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13829","13793  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ حَمْزَةَ الْمَرْوَزِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَّامٍ ،  ثَنَا  عِيسَى بْنُ مُوسَى ،  عَنْ  أَبِي حَمْزَةَ ،  عَنْ  رَقَبَةَ بْنِ مَصْقَلَةَ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ جَرَّ ثِيَابَهُ  مَخِيلَةً  لَمْ يَنْظُرِ اللهُ إِلَيْهِ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 13793","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن رقبة بن مصقلة عن محمد بن ميمون أبو حمزة السكري عن عيسى بن موسى غنجار عن محمد بن سلام البيكندي عن محمد بن علي بن حمزة المروزي عن علي بن سعيد بن بشير عليك عن الطبراني","عمرو بن دينار عن ابن عمر"
"13830","13794  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ جَبَلَةَ ،  ثَنَا  مُحَمَّدُ بْنُ مَرْوَانَ ،  عَنْ  شُعْبَةَ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  أَسْلَمَ  رَجُلٌ  فِي نَخْلٍ  لِرَجُلٍ مِنَ الْأَنْصَارِ  فَلَمْ يَحْمِلْ ذَلِكَ الْعَامَ ، فَخَاصَمَهُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : "" حَمَلَ نَخْلُكَ ؟ "" قَالَ : لَا ، قَالَ : "" فَبِمَا تَأْكُلُ مَالَهُ ؟ ! "" ، فَأَمَرَهُ أَنْ يَرُدَّ عَلَيْهِ ،  وَنَهَى عَنِ  السَّلَمِ  فِي النَّخْلِ حَتَّى يَبْدُوَ صَلَاحُهُ  .","","Al-Mu'jam al-Kabir 13794","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن شعبة بن الحجاج عن محمد بن مروان بن قدامة العجلي عن محمد بن عمرو بن عباد العتكي عن الحسن بن علي بن شبيب المعمري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13831","[13/128]      13795  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ ،  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْتَمِسُوا لَيْلَةَ الْقَدْرِ فِي الْعَشْرِ الْأُخَرِ مِنْ رَمَضَانَ  .","","Al-Mu'jam al-Kabir 13795","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","عمرو بن دينار عن ابن عمر"
"13832","13796  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ الْجُنْدَيْسَابُورِيُّ ،  ثَنَا  زُنَيْجٌ أَبُو غَسَّانَ الرَّازِيُّ ،  ثَنَا  الْحَكَمُ بْنُ بَشِيرٍ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَانَ مُتَحَرِّيًا لَيْلَةَ الْقَدْرِ  فَلْيَتَحَرَّهَا  فِي الْعَشْرِ الْأَوَاخِرِ  "" .","","Al-Mu'jam al-Kabir 13796","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن عمرو بن قيس الملائي عن الحكم بن  أبى إسماعيل النهدي عن محمد بن عمرو بن بكر بن سالم عن محمد بن جابان الجند يسابوري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13833","13797  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عُبَيْدِ اللهِ ،         [13/129]      ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ ،  ثَنَا  شُعَيْبُ بْنُ إِسْحَاقَ ،  عَنْ  مِسْعَرٍ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ  بِرَجُلٍ  بِهِ زَمَانَةٌ ، فَنَزَلَ وَسَجَدَ  ،  وَمَرَّ بِهِ  أَبُو بَكْرٍ  فَنَزَلَ فَسَجَدَ  ، وَمَرَّ بِهِ  عُمَرُ  فَنَزَلَ وَسَجَدَ  .","","Al-Mu'jam al-Kabir 13797","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن مسعر بن كدام عن شعيب بن إسحاق الدمشقي عن عبد الله بن جعفر بن غيلان عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13834","13798  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  جَرِيرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ  رَجُلًا  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَيُّ الْبِقَاعِ خَيْرٌ ؟ وَأَيُّ الْبِقَاعِ شَرٌّ ؟ قَالَ :  خَيْرُ الْبِقَاعِ الْمَسَاجِدُ  ، وَشَرُّ الْبِقَاعِ الْأَسْوَاقُ  .","","Al-Mu'jam al-Kabir 13798","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن عطاء بن السائب عن جرير بن عبد الحميد عن أبو الوليد الطيالسي عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13835","[13/130]      13799  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اتَّقُوا الظُّلْمَ ، فَإِنَّهُ الظُّلُمَاتُ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 13799","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن عطاء بن السائب عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13836","13800  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ،  ثَنَا  مَهْدِيُّ بْنُ حَفْصٍ ،  ثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  ثَنَا  أَبُو حَنِيفَةَ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَلَّى الْعِشَاءَ فِي جَمَاعَةٍ وَصَلَّى أَرْبَعَ رَكَعَاتٍ قَبْلَ أَنْ يَخْرُجَ مِنَ الْمَسْجِدِ كَانَ  كَعِدْلِ  لَيْلَةِ الْقَدْرِ  .","","Al-Mu'jam al-Kabir 13800","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن أبو حنيفة النعمان عن إسحاق بن يوسف الأزرق عن مهدي بن حفص البغدادي عن محمد بن الفضل بن جابر السقطى عن الطبراني","عمرو بن دينار عن ابن عمر"
"13837","[13/131]      13801  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْقُضَاةُ ثَلَاثَةٌ  : قَاضِيَانِ فِي النَّارِ وَقَاضٍ فِي الْجَنَّةِ ، قَاضِي قَضَى بِالْهَوَى فَهُوَ فِي النَّارِ ، وَقَاضِي قَضَى بِغَيْرِ عِلْمٍ فَهُوَ فِي النَّارِ ، وَقَاضِي قَضَى بِالْحَقِّ فَهُوَ فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 13801","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن فضيل بن غزوان عن محمد بن فضيل بن غزوان عن مسروق بن المرزبان الكندي عن علي بن سعيد بن بشير عليك عن الطبراني","عمرو بن دينار عن ابن عمر"
"13838","13802  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ الْمِصْرِيُّ ،  حَدَّثَنَا  يُوسُفُ بْنُ عَدِيٍّ ،  ثَنَا  مُحَمَّدُ بْنُ الْفُرَاتِ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،         [13/132]      عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  شَاهِدُ  الزُّورِ  لَا تَزُولُ قَدَمَاهُ حَتَّى تَجِبَ لَهُ النَّارُ  .","","Al-Mu'jam al-Kabir 13802","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن محمد بن الفرات الجرمي عن يوسف بن عدي بن رزق الكوفي عن عمرو بن أبي الطاهر المصري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13839","13803  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ الْمُحَارِبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْفُرَاتِ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ قَالَ :  سَمِعْتُ         [13/133]      ابْنَ عُمَرَ يَقُولُ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَعِظُ  رَجُلًا  :  تَجِيءُ الطَّيْرُ يَوْمَ الْقِيَامَةِ تَحْتَ الْعَرْشِ  ، تَرْفَعُ مَنَاقِيرَهَا ، وَتَضْرِبُ بِأَذْنَابِهَا ، وَتَطْرَحُ مَا فِي بُطُونِهَا ، وَلَيْسَتْ عَلَيْهَا مَظْلَمَةٌ ، فَاتَّقِهِ  .","","Al-Mu'jam al-Kabir 13803","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن محمد بن الفرات الجرمي عن محمد بن عبيد بن محمد بن واقد النحاس عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13840","13804  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ شَبِيبٍ الْعَسَّالُ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  أَبُو مَرْيَمَ ،  ثَنَا  مُحَارِبُ بْنُ دِثَارٍ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ مَثَلَ الرَّجُلِ         [13/134]      الْمُسْلِمِ كَالشَّجَرَةِ الْخَضْرَاءِ  الَّتِي لَا تَسْقُطُ وَرَقُهَا ، وَهَلْ تَدْرُونَ أَيُّ شَجَرَةٍ هِيَ ؟ "" قَالَ  ابْنُ عُمَرَ  : فَقُمْتُ ثُمَّ نَظَرْتُ فَإِذَا أَنَا أَصْغَرُ  الْقَوْمِ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" هِيَ النَّخْلَةُ  .","","Al-Mu'jam al-Kabir 13804","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن عبد الغفار بن القاسم الأنصاري عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","عمرو بن دينار عن ابن عمر"
"13841","13805  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  وَرْقَاءُ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ ،         [13/135]      قَالَ : قَالَ لَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْكَوْثَرُ  نَهَرٌ فِي الْجَنَّةِ حَافَتَاهُ مِنْ ذَهَبٍ  ، وَالْمَاءُ يَجْرِي عَلَى اللُّؤْلُؤِ ، وَمَاؤُهُ أَبْيَضُ مِنَ اللَّبَنِ وَأَحْلَى مِنَ الْعَسَلِ  .","","Al-Mu'jam al-Kabir 13805","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن عطاء بن السائب عن ورقاء بن عمر عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13842","13806  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ،  ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  مُحَارِبِ         [13/136]      بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ  فِي قَوْلِ اللهِ جَلَّ ذِكْرُهُ :         {      إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ         }      ، قَالَ :  نَهَرٌ فِي الْجَنَّةِ مَحْفُوفٌ بِالذَّهَبِ  ، يَجْرِي مَاؤُهُ عَلَى الْيَاقُوتِ وَالدُّرِّ ، أَبْيَضُ مِنَ اللَّبَنِ وَأَحْلَى مِنَ الْعَسَلِ .","","Al-Mu'jam al-Kabir 13806","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن عطاء بن السائب عن قيس بن الربيع الأسدي عن أبو بلال الأشعري عن محمد بن الفضل بن جابر السقطى عن الطبراني","عمرو بن دينار عن ابن عمر"
"13843","13807  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  حَدَّثَنِي  أَبِي  .  وَحَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  ثَنَا  يُوسُفُ بْنُ عَدِيٍّ قَالَا :  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا قَامَ فِي الرُّكُوعِ كَبَّرَ وَرَفَعَ يَدَيْهِ  .","","Al-Mu'jam al-Kabir 13807","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن عاصم بن كليب الجرمي عن محمد بن فضيل بن غزوان عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13844","13808  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،         [13/137]      ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْتَمِسُوا لَيْلَةَ الْقَدْرِ فِي الْعَشْرِ الْأَوَاخِرِ مِنْ رَمَضَانَ  .","","Al-Mu'jam al-Kabir 13808","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13845","13809  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْحَسَنُ بْنُ الرَّبِيعِ الْكُوفِيُّ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُعَلِّمُ النَّاسَ  التَّشَهُّدَ  عَلَى الْمِنْبَرِ  ، كَمَا يُعَلِّمُ الْمُعَلِّمُ الْغِلْمَانَ .","","Al-Mu'jam al-Kabir 13809","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن عبد الواحد بن زياد عن الحسن بن الربيع البوراني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13846","13810  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ جَرَّ ثَوْبَهُ  خُيَلَاءَ  لَمْ يَنْظُرِ اللهُ إِلَيْهِ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 13810","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13847","[13/138]      13811  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مُحَمَّدُ بْنُ قَيْسٍ الْأَسَدِيُّ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ جَرَّ ثَوْبَهُ  مَخِيلَةً  لَمْ يَنْظُرِ اللهُ إِلَيْهِ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 13811","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن محمد بن قيس الوالبي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13848","13812  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  كَثِيرُ بْنُ عُبَيْدٍ الْحَذَّاءُ ،  ثَنَا  مُحَمَّدُ بْنُ خَالِدٍ الْوَهْبِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ الْوَلِيدِ الْوَصَّافِيُّ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كَانَ عَامَّةُ وَصِيَّةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الصَّلَاةَ وَمَا  مَلَكَتْ  أَيْمَانُكُمْ  ، حَتَّى جَعَلَ  يُغَرْغِرُ  بِهَا فِي صَدْرِهِ ، وَمَا كَانَ يُفِيضُ بِهَا لِسَانُهُ  .","","Al-Mu'jam al-Kabir 13812","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن عبيد الله بن الوليد الوصافي عن محمد بن خالد بن محمد الوهبي عن كثير بن عبيد المذحجي عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13849","[13/139]      13813  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  كَثِيرُ بْنُ عُبَيْدٍ ،  ثَنَا  مُحَمَّدُ بْنُ خَالِدٍ الْوَهْبِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ الْوَلِيدِ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَبْغَضُ الْحَلَالِ إِلَى اللهِ الطَّلَاقُ  .","","Al-Mu'jam al-Kabir 13813","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن عبيد الله بن الوليد الوصافي عن محمد بن خالد بن محمد الوهبي عن كثير بن عبيد المذحجي عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13850","13814  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  كَثِيرُ بْنُ عُبَيْدٍ ،         [13/140]      ثَنَا  مُحَمَّدُ بْنُ خَالِدٍ الْوَهْبِيُّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ الْوَلِيدِ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَمَّاهُمُ اللهُ الْأَبْرَارَ  ; لِأَنَّهُمْ بَرُّوا الْآبَاءَ وَالْأُمَّهَاتِ وَالْأَبْنَاءَ ، كَمَا أَنَّ لِوَالِدَيْكَ عَلَيْكَ حَقًّا كَذَلِكَ لِوَلَدِكَ  .","","Al-Mu'jam al-Kabir 13814","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن عبيد الله بن الوليد الوصافي عن محمد بن خالد بن محمد الوهبي عن كثير بن عبيد المذحجي عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13851","13815  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْأَصْبَهَانِيُّ ،  ثَنَا  عَمَّارُ بْنُ خَالِدٍ الْوَاسِطِيُّ ،  ثَنَا  قُرَّةُ بْنُ عِيسَى ،  عَنْ  عُبَيْدِ اللهِ بْنِ الْوَلِيدِ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُطْبَعُ  الْمُؤْمِنُ عَلَى كُلِّ  خُلُقٍ  ، لَيْسَ الْخِيَانَةَ وَالْكَذِبَ  .","","Al-Mu'jam al-Kabir 13815","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن عبيد الله بن الوليد الوصافي عن قرة بن عيسى عن عمار بن خالد بن يزيد التمار عن محمد بن أبان الأصبهاني عن الطبراني","عمرو بن دينار عن ابن عمر"
"13852","[13/141]      13816  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَبَنَا  عَبْدُ الرَّزَّاقِ ،  أَبَنَا  ابْنُ جُرَيْجٍ ،  أَبَنَا  عَطَاءٌ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا رُقْبَى وَلَا  عُمْرَى  ، فَمَنْ  أُعْمِرَ  شَيْئًا أَوْ أُرْقِبَهُ فَهُوَ لَهُ حَيَاتَهُ وَمَمَاتَهُ  ، قَالَ :  وَالرُّقْبَى أَنْ يَقُولَ : هَذِهِ لِلْآخِرِ مِنِّي وَمِنْكَ مَوْتًا ،  وَالْعُمْرَى  : أَنْ يَجْعَلَهُ لَهُ حَيَاتَهُ بِأَنْ يُعْمِرَهَا حَيَاتَهُمَا  .","","Al-Mu'jam al-Kabir 13816","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن عطاء بن أبي رباح عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13853","13817  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي سُوَيْدٍ الذَّارِعُ ،  ثَنَا  أَبُو شَيْبَةَ إِبْرَاهِيمُ بْنُ عُثْمَانَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ  أُعْمِرَ  شَيْئًا حَيَاتَهُ فَهُوَ لَهُ بَعْدَ مَمَاتِهِ  .","","Al-Mu'jam al-Kabir 13817","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن إبراهيم بن عثمان أبو شيبة العبسي عن إبراهيم بن الفضل بن أبي سويد الذارع عن عثمان بن عمر الضبي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13854","[13/142]      13818  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  وَكِيعٌ ،  عَنْ  يَزِيدَ بْنِ زِيَادِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُرْقِبُوا ، فَمَنْ  أُرْقِبَ  شَيْئًا فَهُوَ لَهُ  ، وَلَا  تُعْمِرُوا  فَمَنْ  أُعْمِرَ  شَيْئًا فَهُوَ فِي سَبِيلِ الْمِيرَاثِ  .","","Al-Mu'jam al-Kabir 13818","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن يزيد بن زياد بن أبي الجعد الغطفاني عن وكيع بن الجراح عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13855","13819  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ حَبَّانَ الْمَازِنِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ .  وَحَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ، قَالُوا :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَعْتَقَ شَقِيصًا فِي مَمْلُوكٍ ضَمِنَ لِشُرَكَائِهِ أَنْصِبَاءَهُمْ  .","","Al-Mu'jam al-Kabir 13819","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن عبد العزيز بن رفيع الطائفي عن سلام بن سليم الحنفي عن سعيد بن منصور عن بشر بن موسى بن صالح الأسدي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13856","[13/143]      13820  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَبَنَا  خَالِدٌ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تَمْنَعُوا النِّسَاءَ الْمَسَاجِدَ  ، وَبُيُوتُهُنَّ خَيْرٌ لَهُنَّ  .","","Al-Mu'jam al-Kabir 13820","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن العوام بن حوشب عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","عمرو بن دينار عن ابن عمر"
"13857","13821  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ،  ثَنَا  حَمَّادُ بْنُ شُعَيْبٍ الْحِمَّانِيُّ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ الْكَاهِلِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بُنِيَ الْإِسْلَامُ عَلَى خَمْسٍ  : شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنَّ مُحَمَّدًا رَسُولُ اللهِ ، وَإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَحَجِّ  الْبَيْتِ  ، وَصَوْمِ شَهْرِ رَمَضَانَ  .","","Al-Mu'jam al-Kabir 13821","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن حماد بن شعيب الحماني عن أبو بلال الأشعري عن عمر بن حفص السدوسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13858","13822  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ         [13/144]      مَيْمُونٍ الْخَيَّاطُ الْمَكِّيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  سُعَيْرِ بْنِ الْخِمْسِ وَمِسْعَرِ بْنِ كِدَامٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ  .","","Al-Mu'jam al-Kabir 13822","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن مسعر بن كدام عن سفيان بن عيينة عن محمد بن ميمون الخياط عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13859","13823  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْحُسَيْنِ بْنِ مُدْرِكٍ  بِقَصْرِ ابْنِ هُبَيْرَةَ  ،  ثَنَا  حَامِدُ بْنُ يَحْيَى الْبَلْخِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  سُعَيْرِ بْنِ الْخِمْسِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ         [13/145]      رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  عَشَرَةٌ مِنْ  قُرَيْشٍ  فِي الْجَنَّةِ  :  أَبُو بَكْرٍ  فِي الْجَنَّةِ ،  وَعُمَرُ  فِي الْجَنَّةِ ،  وَعُثْمَانُ  فِي الْجَنَّةِ ،  وَعَلِيٌّ  فِي الْجَنَّةِ ،  وَطَلْحَةُ  فِي الْجَنَّةِ ،  وَالزُّبَيْرُ  فِي الْجَنَّةِ ،  وَسَعْدٌ  وَسَعِيدٌ  فِي الْجَنَّةِ ،  وَعَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  فِي الْجَنَّةِ  ، وَأَبُو عُبَيْدَةَ بْنُ الْجَرَّاحِ  فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 13823","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن سعير بن الخمس التميمي عن سفيان بن عيينة عن حامد بن يحيى البلخي عن أحمد بن الحسين بن مدرك القصري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13860","13824  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَلِيُّ بْنُ حَكِيمٍ الْأَوْدِيُّ .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ الْكُوفِيُّ ،  ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ .  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الطُّفَيْلِ ،  ثَنَا  شَرِيكٌ ،  عَنْ  فِطْرِ بْنِ خَلِيفَةَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  مَا أَجِدُنِي آسَى عَلَى شَيْءٍ إِلَّا أَنِّي لَمْ أُقَاتِلِ  الْفِئَةَ  الْبَاغِيَةَ  مَعَ  عَلِيٍّ  .","","Al-Mu'jam al-Kabir 13824","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن فطر بن خليفة عن شريك بن عبد الله النخعي عن محمد بن الطفيل بن مالك النخعي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13861","[13/146]      13825  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  سِنَانُ بْنُ هَارُونَ ،  عَنْ  عَبْدِ اللهِ بْنِ حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِيهِ  قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  مَا آسَى عَلَى شَيْءٍ فَاتَنِي إِلَّا الصَّوْمَ وَالصَّلَاةَ  ، وَتَرْكِي  الْفِئَةَ  الْبَاغِيَةَ  أَلَّا أَكُونَ قَاتَلْتُهَا ، وَاسْتِقَالَتِي  عَلِيًّا  الْبَيْعَةَ  .","","Al-Mu'jam al-Kabir 13825","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن عبد الله بن حبيب بن أبي ثابت عن سنان بن هارون البرجمي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","عمرو بن دينار عن ابن عمر"
"13862","13826  -  حَدَّثَنَا  الْحَسَنُ بْنُ الْعَبَّاسِ وَعَلِيُّ بْنُ سَعِيدٍ الرَّازِيَّانِ ، قَالَا :  ثَنَا  سَهْلُ بْنُ زَنْجَلَةَ ،  ثَنَا  الصَّبَّاحُ بْنُ مُحَارِبٍ ،  عَنْ  هَارُونَ بْنِ عَنْتَرَةَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  إِنِّي أَفْطَرْتُ يَوْمًا مِنْ رَمَضَانَ ؟ فَقَالَ : "" مِنْ غَيْرِ عُذْرٍ وَلَا سُقْمٍ  ؟ "" قَالَ : نَعَمْ ، قَالَ : "" بِئْسَ مَا صَنَعْتَ ! "" ، قَالَ : أَجَلْ ، مَا تَأْمُرُنِي ؟ قَالَ : "" أَعْتِقْ رَقَبَةً "" ، قَالَ : وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا مَلَكْتُ رَقَبَةً قَطُّ ، قَالَ : "" صُمْ شَهْرَيْنِ مُتَتَابِعَيْنِ "" ، قَالَ : لَا أَسْتَطِيعُ ، قَالَ :         [13/147]      "" فَأَطْعِمْ سِتِّينَ مِسْكِينًا "" ، قَالَ : وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا أُشْبِعُ أَهْلِي .  فَأُتِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِمِكْتَلٍ  فِيهِ تَمْرٌ ، فَقَالَ : ""  تَصَدَّقْ  بِهَذَا "" ، قَالَ : عَلَى مَنْ ؟ قَالَ : "" عَلَى أَفْقَرِ مَنْ تَعْلَمُ "" ، قَالَ : وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا بَيْنَ  لَابَتَيْهَا  أَهْلُ بَيْتٍ أَحْوَجُ مِنَّا ، قَالَ : "" فَأَطْعِمْهُ عِيَالَكَ "" .","","Al-Mu'jam al-Kabir 13826","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن هارون بن عنترة الشيباني عن صباح بن محارب التيمي عن سهل بن أبي سهل الأشتر عن الجمال الحسن بن العباس عن الطبراني","عمرو بن دينار عن ابن عمر"
"13863","13827  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلُّوَيْهِ الْقَطَّانُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عِيسَى الْعَطَّارُ ،  ثَنَا  دَاوُدُ بْنُ الزِّبْرِقَانِ ،  عَنْ  حَفْصِ بْنِ عِمْرَانَ الْكِنْدِيِّ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَدَّهِنَ إِلَّا غِبًّا  .","","Al-Mu'jam al-Kabir 13827","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن حفص بن عمران الكندي عن داود بن الزبرقان عن إسماعيل بن عيسى البغدادي عن ابن علويه الحسن بن علي القطان عن الطبراني","عمرو بن دينار عن ابن عمر"
"13864","13828  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلُّوَيْهِ الْقَطَّانُ ،  ثَنَا  عَلِيُّ بْنُ سِيَابَةَ الْكُوفِيُّ ،  ثَنَا  عَمْرُو بْنُ عَبْدِ الْغَفَّارِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  حَبِيبِ بْنِ أَبِي         [13/148]      ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  عَدْوَى  وَلَا  هَامَةَ  .","","Al-Mu'jam al-Kabir 13828","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن الأعمش عن عمرو بن عبد الغفار الفقيمي عن علي بن سيابة عن ابن علويه الحسن بن علي القطان عن الطبراني","عمرو بن دينار عن ابن عمر"
"13865","13829  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلُّوَيْهِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عِيسَى ،  ثَنَا  دَاوُدُ بْنُ الزِّبْرِقَانِ ،  عَنْ  حَفْصِ بْنِ عِمْرَانَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى أَنْ يُقْرَنَ بَيْنَ التَّمْرَتَيْنِ  .","","Al-Mu'jam al-Kabir 13829","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن حفص بن عمران عن داود بن الزبرقان عن إسماعيل بن عيسى البغدادي عن ابن علويه الحسن بن علي القطان عن الطبراني","عمرو بن دينار عن ابن عمر"
"13866","13830  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلُّوَيْهِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عِيسَى الْعَطَّارُ ،  ثَنَا  دَاوُدُ بْنُ الزِّبْرِقَانِ ،  عَنْ  حَفْصِ بْنِ عِمْرَانَ الْكِنْدِيِّ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى أَنْ تُشَقَّ التَّمْرَةُ عَمَّا فِيهَا  .","","Al-Mu'jam al-Kabir 13830","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن حفص بن عمران الكندي عن داود بن الزبرقان عن إسماعيل بن عيسى البغدادي عن ابن علويه الحسن بن علي القطان عن الطبراني","عمرو بن دينار عن ابن عمر"
"13867","[13/149]      13831  -  حَدَّثَنَا  الْحَسَنُ بْنُ زَكَرِيَّا ،  ثَنَا  مُحَمَّدُ بْنُ عُمَارَةَ بْنِ صُبَيْحٍ الْكُوفِيُّ ،  ثَنَا  سَهْلُ بْنُ عَامِرٍ ،  ثَنَا  عَبَّادُ بْنُ الرَّبِيعِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا يُبْغِضُ الْعَرَبَ مُؤْمِنٌ  ، وَلَا يُحِبُّ  ثَقِيفَ  مُؤْمِنٌ  .","","Al-Mu'jam al-Kabir 13831","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن الأعمش عن عباد بن الربيع عن سهل بن عامر البجلي عن محمد بن عمارة الكوفي عن الحسن بن زكريا عن الطبراني","عمرو بن دينار عن ابن عمر"
"13868","13832  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ ،  ثَنَا  زُهَيْرُ بْنُ عَبَّادٍ ،  ثَنَا  أَبُو بَكْرٍ الدَّاهِرِيُّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ         [13/150]      ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُؤْمِنُ الَّذِي يُخَالِطُ النَّاسَ فَيُؤْذُونَهُ فَيَصْبِرُ عَلَى أَذَاهُمْ  أَفْضَلُ مِنَ الْمُؤْمِنِ الَّذِي لَا يُخَالِطُ النَّاسَ فَيُؤْذُونَهُ فَيَصْبِرُ عَلَى أَذَاهُمْ  .","","Al-Mu'jam al-Kabir 13832","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن الأعمش عن عبد الله بن حكيم الداهري عن زهير بن عباد بن مليح الرؤاسي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13869","13833  -  حَدَّثَنَا  خَطَّابُ بْنُ سَعْدٍ الدِّمَشْقِيُّ ،  ثَنَا  مُؤَمَّلُ بْنُ إِهَابٍ ،  ثَنَا  مُحَمَّدُ بْنُ الْقَاسِمِ الْأَسَدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  أُحِلَّتْ  لِي  مَكَّةُ  سَاعَةً مِنْ نَهَارٍ وَلَمْ تَحِلَّ لِأَحَدٍ مِنْ بَعْدِي  ، وَهِيَ  حَرَامٌ  بِحُرْمَةِ  اللهِ إِلَى يَوْمِ الْقِيَامَةِ ، لَا  يُعْضَدُ  شَجَرُهَا وَلَا يُخْتَلَى  خَلَاهَا  وَلَا يُنَفَّرُ         [13/151]      صَيْدُهَا ، وَلَا تُلْتَقَطُ  لُقَطَتُهَا  إِلَّا  لِمُنْشِدٍ  "" ، قَالُوا : إِلَّا  الْإِذْخِرَ  ، فَإِنَّهُ لِقَيْنِنَا وَبُيُوتِنَا ، قَالَ : "" إِلَّا  الْإِذْخِرَ  .","","Al-Mu'jam al-Kabir 13833","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن عبد الله بن حبيب بن أبي ثابت عن محمد بن القاسم الأسدي عن مؤمل بن إهاب عن خطاب بن سعد الخير الحمصي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13870","13834  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَبَنَا  مُحَمَّدُ بْنُ الْحَسَنِ الْمُرِّيُّ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  لَمَّا كَانَ الْيَوْمُ الَّذِي اجْتَمَعَ فِيهِ  عَلِيٌّ  وَمُعَاوِيَةُ  بِدَوْمَةِ الْجَنْدَلِ  ، قَالَتْ لِي  حَفْصَةُ  :  إِنَّهُ لَا يَجْمُلُ بِكَ أَنْ تَتَخَلَّفَ عَنْ صُلْحٍ يُصْلِحُ اللهُ بِهِ بَيْنَ أُمَّةِ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنْتَ صِهْرُ رَسُولِ اللهِ  وَابْنُ         [13/152]      عُمَرَ بْنِ الْخَطَّابِ  ، فَأَقْبَلَ يَوْمَئِذٍ  مُعَاوِيَةُ  عَلَى  بُخْتِيٍّ  عَظِيمٍ ، فَقَالَ : مَنْ يَطْمَعُ فِي هَذَا الْأَمْرِ أَوْ يَرْجُوهُ أَوْ يَمُدُّ إِلَيْهِ عُنُقَهُ ؟ قَالَ  ابْنُ عُمَرَ  : فَمَا حَدَّثْتُ نَفْسِي بِالدُّنْيَا قَبْلَ يَوْمَئِذٍ ، فَهَمَمْتُ أَنْ أَقُولَ : يَطْمَعُ فِيهِ مَنْ ضَرَبَكَ وَأَبَاكَ عَلَى الْإِسْلَامِ حَتَّى أَدْخَلَكُمَا فِيهِ ، فَذَكَرْتُ الْجَنَّةَ وَنَعِيمَهَا فَأَعْرَضْتُ عَنْهُ .","","Al-Mu'jam al-Kabir 13834","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن العوام بن حوشب عن محمد بن الحسن المزني عن وهب بن بقية الواسطي عن بحشل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13871","13835  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ ،  ثَنَا  أَحْمَدُ بْنُ سَهْلِ بْنِ عَلِيٍّ الْبَاهِلِيُّ ،  ثَنَا  أَبُو سُفْيَانَ الْحِمْيَرِيُّ ،  ثَنَا  هُشَيْمٌ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  جَاءَ  رَجُلٌ مِنَ الْأَنْصَارِ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ الْيَهُودَ قَتَلُوا أَخِي "" قَالَ :  لَأَدْفَعَنَّ  الرَّايَةَ  إِلَى رَجُلٍ يُحِبُّ اللهَ وَرَسُولَهُ وَيُحِبُّهُ اللهُ         [13/153]      وَرَسُولُهُ  ، يَفْتَحُ اللهُ عَلَى يَدَيْهِ فَيُمَكِّنُكَ اللهُ مِنْ قَاتِلِ أَخِيكَ "" .  فَاسْتَشْرَفَ لِذَلِكَ أَصْحَابُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَبَعَثَ إِلَى  عَلِيٍّ  فَعَقَدَ لَهُ اللِّوَاءَ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي رَمِدٌ كَمَا تَرَى . وَكَانَ يَوْمَئِذٍ رَمِدًا ،  فَتَفَلَ  فِي عَيْنِهِ ، قَالَ  عَلِيٌّ  : فَمَا رَمِدْتُ بَعْدَ يَوْمِئِذٍ ، فَمَضَى  .","","Al-Mu'jam al-Kabir 13835","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن العوام بن حوشب عن هشيم بن بشير عن سعيد بن يحيى الحميري عن أحمد بن سهل بن علي الباهلي عن بحشل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13872","13836  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ عَلِيٍّ ابْنُ أَخِي رَوَّادِ بْنِ الْجَرَّاحِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ سَالِمٍ الصَّائِغُ ،  ثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  عَنْ  سُفْيَانَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ وَعَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ،         [13/154]      عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  فَوَاتِحُ الْغَيْبِ خَمْسٌ لَا يَعْلَمُهُنَّ إِلَّا اللهُ  : الْمَطَرُ لَا يَعْلَمُهُ إِلَّا اللهُ ، وَعِنْدَهُ عِلْمُ السَّاعَةِ ، وَمَا تَدْرِي نَفْسٌ مَاذَا تَكْسِبُ غَدًا ، وَمَا تَدْرِي نَفْسٌ بِأَيِّ أَرْضٍ تَمُوتُ  .","","Al-Mu'jam al-Kabir 13836","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن سفيان الثوري عن إسحاق بن يوسف الأزرق عن إسماعيل بن سالم الصائغ عن عبد الله بن أحمد بن علي ابن أخي رواد بن الجراح عن الطبراني","عمرو بن دينار عن ابن عمر"
"13873","13837  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ الْجَبَلِيُّ  بِالْكُوفَةِ  ،  ثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحِيمِ الْحَارِثِيُّ ،  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ الْعَنْقَزِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي أُرِيدُ أَنْ  أُبَايِعَكَ  عَلَى  الْجِهَادِ  ، قَالَ :  أَحَيٌّ وَالِدَاكَ ؟ "" قَالَ : نَعَمْ ، قَالَ : "" فَفِيهِمَا فَجَاهِدْ  .","","Al-Mu'jam al-Kabir 13837","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن عمرو بن محمد الأحمر عن أحمد بن عبد الرحيم الحارثي عن محمد بن أحمد الجبلي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13874","[13/155]      13838  -  حَدَّثَنَا  عَلَّانُ بْنُ عَبْدِ الصَّمَدِ مَاغَمَّهُ ،  ثَنَا  الْقَاسِمُ بْنُ دِينَارٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  سُفْيَانُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّهُ سُئِلَ عَنِ الْحَامِلِ وَالْمُتَوَفَّى عَنْهَا ؟ قَالَ : كُنَّا نُنْفِقُ عَلَيْهِنَّ  .","","Al-Mu'jam al-Kabir 13838","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن عبد الله بن موسى بن إبراهيم الطلحي عن القاسم بن زكريا الطحان عن علي بن عبد الصمد علان ماغمه عن الطبراني","عمرو بن دينار عن ابن عمر"
"13875","13839  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ .         [13/156]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ، قَالُوا :  ثَنَا  شُعْبَةُ ،  عَنْ  عُقْبَةَ بْنِ حُرَيْثٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْجَرِّ  وَالدُّبَّاءِ  وَالْمُزَفَّتِ  ، وَأَمَرَ أَنْ يُنْبَذَ فِي الْأَسْقِيَةِ  .  وَاللَّفْظُ  لِأَبِي الْوَلِيدِ  .","","Al-Mu'jam al-Kabir 13839","","عبد الله بن عمر بن الخطاب عن عقبة بن حريث التغلبي عن شعبة بن الحجاج عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13876","13840  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عُقْبَةَ بْنِ حُرَيْثٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الشَّهْرُ  هَكَذَا وَكَذَا "" ، وَقَبَضَ إِبْهَامَهُ  .","","Al-Mu'jam al-Kabir 13840","","عبد الله بن عمر بن الخطاب عن عقبة بن حريث التغلبي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13877","13841  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  عُقْبَةَ بْنِ حُرَيْثٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يُحَدِّثُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ، فَإِذَا رَأَيْتَ الصُّبْحَ  فَأَوْتِرْ  بِرَكْعَةٍ  .","","Al-Mu'jam al-Kabir 13841","","عبد الله بن عمر بن الخطاب عن عقبة بن حريث التغلبي عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13878","[13/157]      13842  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  سَعِيدُ بْنُ عَمْرٍو الْأَشْعَثِيُّ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  حِبَّانَ بْنِ عَبْدِ اللهِ ،  عَنْ  عُقْبَةَ بْنِ حُرَيْثٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنِ الْتَمَسَ لَيْلَةَ الْقَدْرِ ، فَلْيَلْتَمِسْهَا فِي الْعَشْرِ الْأَوَاخِرِ  .","","Al-Mu'jam al-Kabir 13842","","عبد الله بن عمر بن الخطاب عن عقبة بن حريث التغلبي عن حبان بن عبد الله عن مروان بن معاوية الفزاري عن سعيد بن عمرو بن سهل الأشعثي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13879","13843  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ بَشَّارٍ النَّسَائِيُّ ،  ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ،  ثَنَا  أَيُّوبُ بْنُ جَابِرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُصْمٍ ،  عَنِ  ابْنِ عُمَرَ ،         [13/158]      قَالَ :  كَانَ غَسْلُ الثَّوْبِ مِنَ الْبَوْلِ سَبْعَ مَرَّاتٍ  ، فَلَمْ يَزَلْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى جَعَلَ غَسْلَ الْبَوْلِ مِنَ الثَّوْبِ مَرَّةً  .","","Al-Mu'jam al-Kabir 13843","","عبد الله بن عمر بن الخطاب عن عبد الله بن عصم اليمامي عن أيوب بن جابر السحيمي عن قتيبة بن سعيد عن أحمد بن عبد الرحمن بن بشار النسوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13880","13844  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ وَاقِدٍ ،  ثَنَا  أَبِي  ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَبْدِ اللهِ بْنِ عُصْمٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  يَخْرُجُ مِنْ  ثَقِيفَ  مُبِيرٌ  وَكَذَّابٌ  .","","Al-Mu'jam al-Kabir 13844","","عبد الله بن عمر بن الخطاب عن عبد الله بن عصم اليمامي عن شريك بن عبد الله النخعي عن عبد الرحمن بن واقد الواقدي عن عبيد الله بن أبي مسلم الواقدي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13881","13845  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ .         [13/159]      وَحَدَّثَنَا  مُوسَى بْنُ هَارُونَ وَمُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ ، قَالَا :  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ، قَالَا :  ثَنَا  شُعْبَةُ  عَنْ  حَيَّانَ الْبَارِقِيِّ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  رَكْعَتَانِ مِنْ صَلَاةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَخَفُّ مِنْ رَكْعَةٍ مِنْ صَلَاتِكُمْ  .","","Al-Mu'jam al-Kabir 13845","","عبد الله بن عمر بن الخطاب عن حيان بن إياس البارقي عن شعبة بن الحجاج عن علي بن الجعد عن موسى بن هارون الحمال عن الطبراني","عمرو بن دينار عن ابن عمر"
"13882","13846  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  حُلْوُ بْنُ السَّرِيِّ ،  ثَنَا  أَبُو الْبِلَادِ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْجُمُعَةُ وَاجِبَةٌ إِلَّا عَلَى مَا مَلَكْتَ أَوْ ذِي عِلَّةٍ  .","","Al-Mu'jam al-Kabir 13846","","عبد الله بن عمر بن الخطاب عن يحيى بن أبى سليمان الغطفاني عن حلو بن السري الكوفي عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13883","13847  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  مَنْصُورُ بْنُ         [13/160]      أَبِي مُزَاحِمٍ ،  ثَنَا  شَرِيكٌ ،  عَنْ  كُلَيْبِ بْنِ وَائِلٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يُبَاعَ التَّمْرُ حَتَّى يَبْدُوَ صَلَاحُهُ  .","","Al-Mu'jam al-Kabir 13847","","عبد الله بن عمر بن الخطاب عن كليب بن وائل بن بيحان اليشكري عن شريك بن عبد الله النخعي عن منصور بن أبي مزاحم عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13884","13848  -  حَدَّثَنَا  الْحَسَنُ بْنُ سَهْلٍ الْمُجَوِّزُ الْبَصْرِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  ثَنَا  أَبُو رَجَاءٍ الْكُلَيْبِيُّ ،  ثَنَا  كُلَيْبُ بْنُ وَائِلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ قَالَ :  كُنَّا نُوجِبُ عَلَى أَهْلِ الْكَبَائِرِ حَتَّى نَزَلَتْ هَذِهِ الْآيَةُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         {      إِنَّ اللهَ لا يَغْفِرُ أَنْ يُشْرَكَ بِهِ وَيَغْفِرُ مَا دُونَ ذَلِكَ لِمَنْ يَشَاءُ         }      ، قَالَ :  فَنَهَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نُوجِبَ لِأَحَدٍ مِنَ الْمُوَحِّدِينَ النَّارَ  .","","Al-Mu'jam al-Kabir 13848","","عبد الله بن عمر بن الخطاب عن كليب بن وائل بن بيحان اليشكري عن روح بن المسيب الكلبي عن إبراهيم بن الحجاج السامي عن الحسن بن سهل بن عبد العزيز المجوز عن الطبراني","عمرو بن دينار عن ابن عمر"
"13885","[13/161]      13849  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  الْعَبَّاسُ بْنُ عَبْدِ الْعَظِيمِ الْعَنْبَرِيُّ ،  ثَنَا  الْأَسْوَدُ بْنُ عَامِرٍ ،  ثَنَا  سِنَانُ بْنُ هَارُونَ الْبُرْجُمِيُّ ،  عَنْ  كُلَيْبِ بْنِ وَائِلٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  ذُكِرَ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِتْنَةٌ وَمَرَّ رَجُلٌ ، فَقَالَ :  يُقْتَلُ فِيهَا هَذَا الْمُقَنَّعُ مَظْلُومًا  ، فَنَظَرْتُ فَإِذَا هُوَ  عُثْمَانُ بْنُ عَفَّانَ  .","","Al-Mu'jam al-Kabir 13849","","عبد الله بن عمر بن الخطاب عن كليب بن وائل بن بيحان اليشكري عن سنان بن هارون البرجمي عن الأسود بن عامر شاذان عن عباس بن عبد العظيم العنبري عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13886","13850  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  فُضَيْلُ         [13/162]      بْنُ مَرْزُوقٍ ،  ثَنَا  عَطِيَّةُ الْعَوْفِيُّ قَالَ :  قَرَأْتُ عَلَى  ابْنِ عُمَرَ :         {      اللهُ الَّذِي خَلَقَكُمْ مِنْ ضَعْفٍ ثُمَّ جَعَلَ مِنْ بَعْدِ ضَعْفٍ قُوَّةً ثُمَّ جَعَلَ مِنْ بَعْدِ قُوَّةٍ ضَعْفًا         }      ، فَقَالَ  ابْنُ عُمَرَ  :         {      اللهُ الَّذِي خَلَقَكُمْ مِنْ ضَعْفٍ ثُمَّ جَعَلَ مِنْ بَعْدِ ضَعْفٍ قُوَّةً ثُمَّ جَعَلَ مِنْ بَعْدِ قُوَّةٍ ضَعْفًا         }      ، هَكَذَا قَرَأْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13850","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13887","13851  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ،  ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  فُضَيْلِ بْنِ مَرْزُوقٍ ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ  .","","Al-Mu'jam al-Kabir 13851","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن سفيان الثوري عن موسى بن مسعود النهدي عن حفص بن عمر سنجة ألف عن الطبراني","عمرو بن دينار عن ابن عمر"
"13888","13852  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،         [13/163]      ثَنَا  زُهَيْرٌ ،  عَنْ  فُضَيْلٍ ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ  .","","Al-Mu'jam al-Kabir 13852","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","عمرو بن دينار عن ابن عمر"
"13889","13853  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْحَسَنِ بْنِ هَارُونَ بْنِ سُلَيْمَانَ بْنِ إِسْمَاعِيلَ بْنِ حَمَّادِ بْنِ أَبِي سُلَيْمَانَ الصَّبَّاحِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ رَاشِدٍ الْأَدَمِيُّ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  مَالِكُ بْنُ مِغْوَلٍ وَصَالِحُ بْنُ مُسْلِمٍ ، قَالَا :  ثَنَا  عَطِيَّةُ الْعَوْفِيُّ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  قَرَأْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         {      اللهُ الَّذِي خَلَقَكُمْ مِنْ ضَعْفٍ         }      ،  فَقَالَ لِي :         {      مِنْ ضَعْفٍ         }      يَا بُنَيَّ  .","","Al-Mu'jam al-Kabir 13853","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن صالح بن مسلم العجلي عن مسلم بن إبراهيم الشحام عن إبراهيم بن راشد بن سليمان الآدمي عن الصباحي أحمد بن الحسن عن الطبراني","عمرو بن دينار عن ابن عمر"
"13890","13854  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ أَبِي حَسَّانَ الْأَنْمَاطِيُّ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  سَعِيدُ بْنُ يَحْيَى اللَّخْمِيُّ ،  عَنْ  فُضَيْلِ بْنِ غَزْوَانَ ،  عَنْ  عَطِيَّةَ الْعَوْفِيِّ ، قَالَ :  قَرَأْتُ عَلَى  عَبْدِ اللهِ بْنِ عُمَرَ :         [13/164]             {      اللهُ الَّذِي خَلَقَكُمْ مِنْ ضَعْفٍ ثُمَّ جَعَلَ مِنْ بَعْدِ ضَعْفٍ قُوَّةً ثُمَّ جَعَلَ مِنْ بَعْدِ قُوَّةٍ ضَعْفًا وَشَيْبَةً         }      ، فَقَالَ  ابْنُ عُمَرَ  :         {      اللهُ الَّذِي خَلَقَكُمْ مِنْ ضَعْفٍ ثُمَّ جَعَلَ مِنْ بَعْدِ ضَعْفٍ قُوَّةً ثُمَّ جَعَلَ مِنْ بَعْدِ قُوَّةٍ ضَعْفًا وَشَيْبَةً         }      ، ثُمَّ قَالَ  ابْنُ عُمَرَ  :  قَرَأْتُهَا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَمَا قَرَأْتَهَا عَلَيَّ ، فَأَخَذَهَا عَلَيَّ كَمَا أَخَذْتُهَا عَلَيْكَ  .","","Al-Mu'jam al-Kabir 13854","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن فضيل بن غزوان عن سعيد بن يحيى سعدان عن هشام بن عمار عن إسحاق بن إبراهيم بن أبي حسان الأنماطي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13891","13855  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَبَنَا  سَوَّارُ بْنُ مُصْعَبٍ ،  عَنْ  عَطِيَّةَ الْعَوْفِيِّ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَقْرَأَهُ         {      اللهُ الَّذِي خَلَقَكُمْ مِنْ ضَعْفٍ ثُمَّ جَعَلَ مِنْ بَعْدِ ضَعْفٍ قُوَّةً ثُمَّ جَعَلَ مِنْ بَعْدِ قُوَّةٍ ضَعْفًا         }      .","","Al-Mu'jam al-Kabir 13855","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن سوار بن مصعب المؤذن عن عبد الله بن رجاء الغداني عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13892","13856  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  فُضَيْلُ بْنُ مَرْزُوقٍ ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  السَّجْدَةُ مِنْ سُجُودِ هَؤُلَاءِ أَطْوَلُ مِنْ ثَلَاثِ سَجَدَاتٍ مِنْ سُجُودِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13856","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13893","[13/165]      13857  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  فُضَيْلُ بْنُ مَرْزُوقٍ ،  عَنْ  عَطِيَّةَ ،  حَدَّثَنِي  ابْنُ عُمَرَ قَالَ :  أُنْزِلَتْ هَذِهِ الْآيَةُ فِي الْأَعْرَابِ         {      مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا         }      فَقَالَ  رَجُلٌ  : فَمَا  لِلْمُهَاجِرِينَ  يَا  أَبَا عَبْدِ الرَّحْمَنِ  ؟ قَالَ : مَا هُوَ أَفْضَلُ مِنْ ذَلِكَ :         {      إِنَّ اللهَ لا يَظْلِمُ مِثْقَالَ ذَرَّةٍ وَإِنْ تَكُ حَسَنَةً يُضَاعِفْهَا وَيُؤْتِ مِنْ لَدُنْهُ أَجْرًا عَظِيمًا         }      .","","Al-Mu'jam al-Kabir 13857","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13894","13858  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي عُمَرَ الْعَدَنِيُّ ،  ثَنَا  بِشْرُ بْنُ السَّرِيِّ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  فُضَيْلِ بْنِ مَرْزُوقٍ ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ كَانَ يَقْرَأُ :         {      فَبِذَلِكَ  فَلْتَفْرَحُوا  هُوَ خَيْرٌ مِمَّا يَجْمَعُونَ         }      .","","Al-Mu'jam al-Kabir 13858","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن عبد الله بن المبارك عن بشر بن السري عن ابن أبي عمر العدني عن علي بن سعيد بن بشير عليك عن الطبراني","عمرو بن دينار عن ابن عمر"
"13895","[13/166]      13859  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ، فَإِذَا خَشِيتَ الصُّبْحَ  فَوَاحِدَةً أَوْ رَكْعَةً  .","","Al-Mu'jam al-Kabir 13859","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13896","13860  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ يَحْيَى بْنِ الرَّبِيعِ بْنِ أَبِي رَاشِدٍ ،  ثَنَا  عَمْرُو بْنُ عَطِيَّةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ :  طَلَّقْتُ امْرَأَتِي وَهِيَ حَائِضٌ فَأَتَى  عُمَرُ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَحَدَّثَهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مُرْهُ فَلْيُرَاجِعْهَا ، ثُمَّ لِيُطَلِّقْهَا بَعْدُ إِنْ شَاءَ  .  قَالَ : فَرَاجَعَهَا وَحَسَبَهَا وَاحِدَةً  .","","Al-Mu'jam al-Kabir 13860","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن عمرو بن جميع العوفي عن عبد الله بن يحيى بن الربيع بن أبي راشد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13897","[13/167]      13861  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  حَدَّثَنِي  أَبِي قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي  :  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ وَنَافِعٍ وَعَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمَغْرِبَ وَالْعِشَاءَ بِإِقَامَةٍ وَاحِدَةٍ  .","","Al-Mu'jam al-Kabir 13861","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن أبي شيبة العبسي عن عثمان ابن أبي شيبة عن محمد بن عثمان بن أبي شيبة عن الطبراني","عمرو بن دينار عن ابن عمر"
"13898","13862  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  حَدَّثَنِي  أَبِي قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي بِخَطِّهِ  :  ثَنَا  ابْنُ أَبِي لَيْلَى ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بُنِيَ الْإِسْلَامُ عَلَى خَمْسٍ  : عَلَى شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، وَإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَحَجِّ  الْبَيْتِ  ، وَصَوْمِ رَمَضَانَ  .","","Al-Mu'jam al-Kabir 13862","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن أبي شيبة العبسي عن عثمان ابن أبي شيبة عن محمد بن عثمان بن أبي شيبة عن الطبراني","عمرو بن دينار عن ابن عمر"
"13899","13863  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الرَّازِيُّ الطَّرَسُوسِيُّ ،  ثَنَا  يَحْيَى         [13/168]      بْنُ مَعِينٍ ،  ثَنَا  أَبُو حَفْصٍ الْأَبَّارُ ،  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّكُمْ  رَاعٍ  وَكُلُّكُمْ مَسْؤُولٌ عَنْ رَعِيَّتِهِ  .","","Al-Mu'jam al-Kabir 13863","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن محمد بن جحادة الأودي عن عمر بن عبد الرحمن بن قيس عن يحيى بن معين عن محمد بن إبراهيم بن زياد الطيالسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13900","13864  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رِزْمَةَ ،  ثَنَا  عَلِيُّ بْنُ الْحَسَنِ بْنِ شَقِيقٍ ،  ثَنَا  أَبُو حَمْزَةَ ،  عَنْ  مُطَرِّفٍ ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنْ غَادِرٍ إِلَّا يُرْفَعُ لَهُ  لِوَاءٌ  يَوْمَ الْقِيَامَةِ  ، فَيُقَالُ : هَذَا لِوَاءُ غَدْرَةِ فُلَانٍ  .","","Al-Mu'jam al-Kabir 13864","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن مطرف بن طريف عن محمد بن ميمون أبو حمزة السكري عن علي بن الحسن بن شقيق عن محمد بن عبد العزيز بن أبي رزمة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13901","13865  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدٍ السِّمَّرِيُّ النَّاقِدُ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رِزْمَةَ ،  ثَنَا  عَلِيُّ بْنُ الْحَسَنِ بْنِ شَقِيقٍ ،  عَنْ  أَبِي حَمْزَةَ السُّكَّرِيِّ ،  عَنْ  مُطَرِّفٍ ،  عَنْ  عَطِيَّةَ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ وَأَبَا سَعِيدٍ الْخُدْرِيَّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ... فَذَكَرَ مِثْلَهُ  .","","Al-Mu'jam al-Kabir 13865","","أبو سعيد الخدري عن عطية بن سعد العوفي عن مطرف بن طريف عن محمد بن ميمون أبو حمزة السكري عن علي بن الحسن بن شقيق عن محمد بن عبد العزيز بن أبي رزمة عن عبد الله بن محمد السمري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13902","[13/169]      13866  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  عَبْدِ اللهِ بْنِ عِيسَى ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ لَا يَرْحَمْ لَا يُرْحَمْ  .","","Al-Mu'jam al-Kabir 13866","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن عبد الله بن عيسى بن عبد الرحمن بن أبي ليلى عن شريك بن عبد الله النخعي عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13903","[13/170]      13867  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ إِبْرَاهِيمَ الْقَرَاطِيسِيُّ الْبَغْدَاذِيُّ ،  ثَنَا  الْحُسَيْنُ بْنُ عَمْرِو بْنِ مُحَمَّدٍ الْعَنْقَزِيُّ ،  ثَنَا  عُمَرُ بْنُ شَبِيبٍ الْمُسْلِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ عِيسَى ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كُنْتُ  مَوْلَاهُ  فَعَلِيٌّ  مَوْلَاهُ  ، اللَّهُمَّ وَالِ مَنْ وَالَاهُ وَعَادِ مَنْ عَادَاهُ  .","","Al-Mu'jam al-Kabir 13867","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن عبد الله بن عيسى بن عبد الرحمن بن أبي ليلى عن عمر بن شبيب بن عمر المذحجي عن الحسين بن عمرو بن محمد العنقزي عن العباس بن إبراهيم القراطيسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13904","13868  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ بَيَانٍ ،  ثَنَا  عُمَرُ بْنُ شَبِيبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عِيسَى ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  طَلَاقُ الْأَمَةِ ثِنْتَانِ وَعِدَّتُهَا حَيْضَتَانِ  .","","Al-Mu'jam al-Kabir 13868","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن عبد الله بن عيسى بن عبد الرحمن بن أبي ليلى عن عمر بن شبيب بن عمر المذحجي عن عبد الحميد بن بيان السكري عن محمود بن محمد بن منويه المفيد عن الطبراني","عمرو بن دينار عن ابن عمر"
"13905","[13/171]      13869  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ الْهَيْثَمِ الْبَغْدَادِيُّ ،  ثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  حَجَّاجٍ ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ تُبَاعَ  الثَّمَرَةُ  حَتَّى يَبْدُوَ صَلَاحُهَا  .","","Al-Mu'jam al-Kabir 13869","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن حجاج بن أرطاة عن أبو معاوية الضرير عن عمرو بن محمد بن بكير عن إبراهيم بن محمد بن الهيثم القطيعي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13906","13870  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  أَبُو الشَّعْثَاءِ عَلِيُّ         [13/172]      بْنُ الْحَسَنِ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  ابْنِ أَبِي لَيْلَى وَأَشْعَثَ وَالْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  سَافَرْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَصَلَّيْتُ مَعَهُ فِي الْحَضَرِ وَالسَّفَرِ  ، فَصَلَّيْتُ مَعَهُ فِي الْحَضَرِ الظُّهْرَ أَرْبَعًا وَبَعْدَهَا رَكْعَتَيْنِ ، وَالْعَصْرَ أَرْبَعًا وَلَيْسَ بَعْدَهَا شَيْءٌ ، وَالْمَغْرِبَ ثَلَاثًا وَبَعْدَهَا رَكْعَتَيْنِ ، وَالْعِشَاءَ أَرْبَعًا وَبَعْدَهَا رَكْعَتَيْنِ ، وَالْفَجْرَ رَكْعَتَيْنِ وَقَبْلَهَا رَكْعَتَيْنِ .  وَفِي السَّفَرِ : الظُّهْرَ رَكْعَتَيْنِ وَبَعْدَهَا رَكْعَتَيْنِ ، وَالْعَصْرَ رَكْعَتَيْنِ وَلَيْسَ بَعْدَهَا شَيْءٌ ، وَالْمَغْرِبَ ثَلَاثًا وَبَعْدَهَا رَكْعَتَيْنِ ، وَالْعِشَاءَ رَكْعَتَيْنِ وَبَعْدَهَا رَكْعَتَيْنِ ، وَالْفَجْرَ رَكْعَتَيْنِ وَقَبْلَهَا رَكْعَتَيْنِ .","","Al-Mu'jam al-Kabir 13870","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن حجاج بن أرطاة عن حفص بن غياث النخعي عن علي بن الحسن بن سليمان الحضرمي عن محمود بن محمد بن منويه المفيد عن الطبراني","عمرو بن دينار عن ابن عمر"
"13907","13871  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  سَوَّارُ بْنُ مُصْعَبٍ ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ لِلنِّسَاءِ نَصِيبٌ فِي الْخُرُوجِ إِلَّا مُضْطَرَّةً  ،  يَعْنِي لَيْسَ لَهَا خَادِمٌ ، إِلَّا فِي الْعِيدَيْنِ الْأَضْحَى وَالْفِطْرِ ، وَلَيْسَ لَهُمْ نَصِيبٌ فِي الطُّرُقِ إِلَّا الْحَوَاشِي  "" .","","Al-Mu'jam al-Kabir 13871","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن سوار بن مصعب المؤذن عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","عمرو بن دينار عن ابن عمر"
"13908","[13/173]      13872  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ صَالِحٍ ،  ثَنَا  مِنْدَلٌ ،  عَنِ  الْحَسَنِ بْنِ مُحَمَّدِ بْنِ عَطِيَّةَ ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  لَعَنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ النَّائِحَةَ وَالْمُسْتَمِعَةَ  .","","Al-Mu'jam al-Kabir 13872","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن الحسن بن عطية العوفي عن مندل بن علي عن عبد الحميد بن صالح البرجمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13909","13873  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ يَحْيَى بْنِ الرَّبِيعِ بْنِ أَبِي رَاشِدٍ ،  ثَنَا  عَمْرُو بْنُ عَطِيَّةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ         [13/174]      قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي عَلَى رَاحِلَتِهِ وَهُوَ رَاكِبٌ  .","","Al-Mu'jam al-Kabir 13873","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن عمرو بن جميع العوفي عن عبد الله بن يحيى بن الربيع بن أبي راشد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13910","13874  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ يَحْيَى بْنِ الرَّبِيعِ بْنِ أَبِي رَاشِدٍ ،  ثَنَا  عَمْرُو بْنُ عَطِيَّةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُشِيرُ بِيَدِهِ قِبَلَ الْمَشْرِقِ ، فَقَالَ :  أَلَا إِنَّ الْفِتْنَةَ هَاهُنَا حَيْثُ يَطْلُعُ قَرْنُ الشَّيْطَانِ  .","","Al-Mu'jam al-Kabir 13874","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن عمرو بن جميع العوفي عن عبد الله بن يحيى بن الربيع بن أبي راشد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13911","13875  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ يَحْيَى بْنِ الرَّبِيعِ بْنِ أَبِي رَاشِدٍ ،  ثَنَا  عَمْرُو بْنُ عَطِيَّةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الشَّهْرُ  تِسْعٌ وَعِشْرُونَ  .","","Al-Mu'jam al-Kabir 13875","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن عمرو بن جميع العوفي عن عبد الله بن يحيى بن الربيع بن أبي راشد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13912","13876  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ يَحْيَى بْنِ الرَّبِيعِ بْنِ أَبِي رَاشِدٍ ،  ثَنَا  عَمْرُو بْنُ عَطِيَّةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّمَا مَثَلُكُمْ وَمَثَلُ الْيَهُودِ وَالنَّصَارَى كَمَثَلِ رَجُلٍ اسْتَعْمَلَ عُمَّالًا  ، فَقَالَ : مَنْ يَعْمَلُ لِي عَمَلًا إِلَى نِصْفِ النَّهَارِ         [13/175]      بِقِيرَاطٍ ؟ فَعَمِلَتِ الْيَهُودُ ، فَقَالَ : مَنْ يَعْمَلُ لِي عَمَلًا مِنْ نِصْفِ النَّهَارِ إِلَى صَلَاةِ الْعَصْرِ ؟ فَعَمِلَتِ النَّصَارَى ، فَقَالَ : مَنْ يَعْمَلُ لِي عَمَلًا مِنْ صَلَاةِ الْعَصْرِ إِلَى غُرُوبِ الشَّمْسِ بِقِيرَاطَيْنِ قِيرَاطَيْنِ ؟ وَكُنْتُمْ أَنْتُمْ هُمْ ، فَعَمِلَتِ الْيَهُودُ وَالنَّصَارَى ، فَقَالُوا : مَا شَأْنُنَا نَحْنُ أَكْثَرُ عَمَلًا وَأَقَلُّ أَجْرًا ؟ قَالَ لَهُمْ : أَظَلَمْتُكُمْ مِنْ شَيْءٍ ؟ قَالُوا : لَا ، قَالَ : أَمَا أَعْطَيْتُكُمُ الَّذِي وَزَنْتُ لَكُمْ بِهِ عَلَى نَفْسِي ؟ قَالُوا : نَعَمْ ، قَالَ : ذَلِكَ فَضْلِي أُوتِيهِ مَنْ أَشَاءُ وَاللهُ ذُو الْفَضْلِ الْعَظِيمِ "" .  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَلَا إِنَّمَا أَجَلُكُمْ فِي آجَالِ مَنْ مَضَى مِنَ الْأُمَمِ كَمَا بَقِيَ مِنْ صَلَاةِ الْعَصْرِ إِلَى غُرُوبِ الشَّمْسِ  .","","Al-Mu'jam al-Kabir 13876","","عبد الله بن عمر بن الخطاب عن عطية بن قيس الكلابي عن عمرو بن جميع العوفي عن عبد الله بن يحيى بن الربيع بن أبي راشد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13913","[13/176]      13877  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  كَثِيرِ بْنِ جُمْهَانَ قَالَ :  رَأَيْتُ  ابْنَ عُمَرَ يَمْشِي فِي  بَطْنِ الْمَسِيلِ  ، فَقُلْتُ : تَمْشِي وَتَأْمُرُ النَّاسَ بِالسَّعْيِ ؟ ! فَقَالَ  ابْنُ عُمَرَ  : إِنْ أَمْشِي فَقَدْ  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَمْشِي أَوْ  عُمَرَ  ، وَإِنْ أَسْعَى فَقَدْ  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْعَى أَوْ  عُمَرَ  .","","Al-Mu'jam al-Kabir 13877","","عبد الله بن عمر بن الخطاب عن كثير بن جمهان السلمي عن عطاء بن السائب عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13914","13878  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  زُهَيْرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  كَثِيرِ بْنِ جُمْهَانَ  أَنَّ  رَجُلًا  ، قَالَ لِعَبْدِ اللهِ بْنِ عُمَرَ فِي الْمَسْعَى بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  : يَا  أَبَا عَبْدِ الرَّحْمَنِ  مَا لِي أَرَاكَ تَمْشِي وَالنَّاسُ يَسْعَوْنَ ؟  فَقَالَ  :  إِنْ أَمْشِي فَقَدْ رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَمْشِي  وَإِنْ أَسْعَى فَقَدْ رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْعَى ، وَأَنَا شَيْخٌ كَبِيرٌ  .","","Al-Mu'jam al-Kabir 13878","","عبد الله بن عمر بن الخطاب عن كثير بن جمهان السلمي عن عطاء بن السائب عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","عمرو بن دينار عن ابن عمر"
"13915","[13/177]      13879  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ عَبْسٍ التُّنُوخِيُّ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى الْأَسْلَمِيُّ ،  ثَنَا  أَبُو الصَّبَّاحِ الْوَاسِطِيُّ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ حَكِيمٍ الْحَضْرَمِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِعَلِيٍّ  :  أَنْتَ مِنِّي بِمَنْزِلَةِ  هَارُونَ  مِنْ  مُوسَى  إِلَّا أَنَّهُ لَا نُبُوَّةَ وَلَا وِرَاثَةَ  .","","Al-Mu'jam al-Kabir 13879","","عبد الله بن عمر بن الخطاب عن عبد العزيز بن حكيم الحضرمي عن عبد الغفور بن عبد العزيز الواسطي عن يحيى بن يعلى القطواني عن إبراهيم بن عبس التنوخي عن علي بن سعيد بن بشير عليك عن الطبراني","عمرو بن دينار عن ابن عمر"
"13916","13880  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ،  ثَنَا  مُوسَى بْنُ يَحْيَى الْمَرْوَزِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ اللهِ بْنِ وَهْبٍ الْكُوفِيُّ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ         [13/178]      حَكِيمٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ عَلَى أَهْلِ قَوْلِ لَا إِلَهَ إِلَّا اللهُ وَحْشَةٌ فِي الْمَوْتِ  وَلَا فِي الْقُبُورِ وَلَا فِي  النُّشُورِ  ، كَأَنِّي أَنْظُرُ إِلَيْهِمْ عِنْدَ الصَّيْحَةِ يَنْفُضُونَ رُؤُوسَهُمْ مِنَ التُّرَابِ يَقُولُونَ :         {      الْحَمْدُ لِلهِ الَّذِي أَذْهَبَ عَنَّا الْحَزَنَ         }      .","","Al-Mu'jam al-Kabir 13880","","عبد الله بن عمر بن الخطاب عن عبد العزيز بن حكيم الحضرمي عن سليمان بن عمرو البغدادي عن موسى بن يحيى المروزي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13917","13881  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ الْخَشَّابُ الرَّقِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الرَّقِّيُّ ،  حَدَّثَنَا  الْحَسَنُ بْنُ عَلُّوَيْهِ الْقَطَّانُ ،  ثَنَا  عُبَيْدُ بْنُ جَنَّادٍ الْحَلَبِيُّ ، قَالَا :  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنِ  الْقَاسِمِ بْنِ عَوْفٍ الْبَكْرِيِّ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  لَقَدْ عِشْنَا بُرْهَةً مِنْ دَهْرِنَا وَنَحْنُ نَرَى أَنَّ هَذِهِ الْآيَةَ أُنْزِلَتْ فِينَا وَفِي أَهْلِ الْكِتَابَيْنِ  قَبْلَنَا :         {      إِنَّكَ مَيِّتٌ وَإِنَّهُمْ مَيِّتُونَ             *          ثُمَّ إِنَّكُمْ يَوْمَ الْقِيَامَةِ عِنْدَ رَبِّكُمْ تَخْتَصِمُونَ         }      .         [13/179]      الْآيَةَ ، قُلْنَا : كَيْفَ نَخْتَصِمُ وَنَبِيُّنَا وَاحِدٌ وَكِتَابُنَا وَاحِدٌ ؟ حَتَّى رَأَيْتُ بَعْضَنَا يَضْرِبُ فِي وُجُوهِ بَعْضٍ بِالسَّيْفِ ، فَعَرَفْتُ أَنَّهَا فِينَا أُنْزِلَتْ  .","","Al-Mu'jam al-Kabir 13881","","عبد الله بن عمر بن الخطاب عن القاسم بن عوف الشيباني عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن عبيد بن جناد الرقي عن ابن علويه الحسن بن علي القطان عن الطبراني","عمرو بن دينار عن ابن عمر"
"13918","13882  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَائِذِ بْنِ نَصِيبٍ  سَمِعَ  ابْنَ عُمَرَ يَقُولُ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  الْكَعْبَةِ  .","","Al-Mu'jam al-Kabir 13882","","عبد الله بن عمر بن الخطاب عن عائذ بن نصيب الأسدي عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13919","13883  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  عَبَّادِ بْنِ الْعَوَّامِ ،  أَبَنَا  أَبُو مَالِكٍ الْأَشْجَعِيُّ ،  ثَنَا  حُسَيْنُ بْنُ الْحَارِثِ الْجَدَلِيُّ - جَدِيلَةُ قَيْسٍ ، قَالَ :  خَطَبَنَا أَمِيرُ  مَكَّةَ  فَنَشَدَ  النَّاسَ ، فَقَالَ : مَنْ رَأَى الْهِلَالَ يَوْمَ كَذَا وَكَذَا ؟ ثُمَّ قَالَ :  عَهِدَ إِلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَنْسُكَ لِلرُّؤْيَةِ  ، فَإِنْ لَمْ نَرَهُ وَشَهِدَ شَاهِدَا عَدْلٍ         [13/180]      نَسَكْنَا  بِشَهَادَتِهِمَا .  فَسَأَلْتُ  الْحُسَيْنَ  : مَنْ أَمِيرُ  مَكَّةَ  ؟ فَقَالَ : هُوَ الْحَارِثُ بْنُ حَاطِبٍ أَخُو مُحَمَّدِ بْنِ حَاطِبٍ ، ثُمَّ قَالَ الْأَمِيرُ : إِنَّ فِيكُمْ مَنْ هُوَ أَعْلَمُ بِاللهِ وَرَسُولِهِ مِنِّي ، وَقَدْ شَهِدَ هَذَا مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَوْمَأَ بِيَدِهِ إِلَى الرَّجُلِ .  قَالَ  الْحُسَيْنُ  : وَقُلْتُ  لِشَيْخٍ  إِلَى جَنْبِي : مَنْ هَذَا الَّذِي أَوْمَأَ إِلَيْهِ الْأَمِيرُ ؟ قَالَ : هَذَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ الْخَطَّابِ  ، وَهُوَ أَعْلَمُ بِاللهِ وَرَسُولِهِ مِنْهُ ،  فَأَتَيْنَا  ابْنَ عُمَرَ ، فَقَالَ : بِذَلِكَ أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Al-Mu'jam al-Kabir 13883","","عبد الله بن عمر بن الخطاب عن الحسين بن الحارث الجدلي عن سعد بن طارق بن أشيم الأشجعي عن عباد بن العوام الكلابي عن سعيد بن سليمان سعدويه عن محمد بن الفضل بن جابر السقطى عن الطبراني","عمرو بن دينار عن ابن عمر"
"13920","13884  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ  حَدَّثَنِي  سَالِمٌ أَبُو عَبْدِ اللهِ الْبَرَّادُ ،  عَنِ  ابْنِ عُمَرَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  مَنْ تَبِعَ جِنَازَةً فَصَلَّى عَلَيْهَا فَلَهُ قِيرَاطٌ  ، قِيلَ : يَا رَسُولَ اللهِ كَمِ الْقِيرَاطُ ؟ قَالَ : "" مِثْلُ  أُحَدٍ  "" .","","Al-Mu'jam al-Kabir 13884","","عبد الله بن عمر بن الخطاب عن سالم البراد عن إسماعيل بن أبي خالد عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13921","[13/181]      13885  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ، قَالَ :  كَانَ الشَّعْبِيُّ يُحَدِّثُ بِالْمَغَازِي  فَمَرَّ ابْنُ عُمَرَ فَسَمِعَهُ وَهُوَ يُحَدِّثُ بِهَا ،  فَقَالَ  :  لَهُوَ أَحْفَظُ لَهَا مِنِّي ، وَإِنْ كُنْتُ قَدْ شَهِدْتُهَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13885","","عبد الله بن عمر بن الخطاب عن عبد الملك بن عمير القبطي عن شريك بن عبد الله النخعي عن عثمان ابن أبي شيبة عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13922","13886  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْأَسْوَدِ بْنِ قَيْسٍ ،  عَنْ  سَعِيدِ بْنِ عَمْرٍو ،  عَنِ  ابْنِ عُمَرَ         [13/182]      قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّا  أُمَّةٌ  أُمِّيَّةٌ لَا نَكْتُبُ وَلَا نَحْسُبُ  ، إِنَّ  الشَّهْرَ  هَكَذَا وَهَكَذَا ، وَقَبَضَ الْإِبْهَامَ فِي الثَّالِثَةِ  .","","Al-Mu'jam al-Kabir 13886","","عبد الله بن عمر بن الخطاب عن سعيد بن عمرو بن سعيد بن العاص العذري عن الأسود بن قيس العبدي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13923","13887  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ الْحِمَّانِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ سَعِيدِ بْنِ عَمْرِو بْنِ سَعِيدٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْيَدُ  الْعُلْيَا  خَيْرٌ مِنَ  الْيَدِ  السُّفْلَى  ، وَابْدَأْ بِمَنْ  تَعُولُ  .","","Al-Mu'jam al-Kabir 13887","","عبد الله بن عمر بن الخطاب عن سعيد بن عمرو بن سعيد بن العاص العذري عن إسحاق بن سعيد بن عمرو السعيدي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13924","13888  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو غَسَّانَ النَّهْدِيُّ مَالِكُ         [13/183]      بْنُ إِسْمَاعِيلَ ،  ثَنَا  إِسْحَاقُ بْنُ سَعِيدٍ ،  عَنْ  أَبِيهِ سَعِيدِ بْنِ عَمْرٍو  قَالَ :  دَفَعْنَا مَعَ ابْنِ عُمَرَ يَوْمَ  الصَّدَرِ  حَتَّى إِذَا كُنَّا عَلَى  الْجَمْرَةِ  الَّتِي عِنْدَ  الْعَقَبَةِ  ، مَرَّتْ بِنَا رُفْقَةٌ يَمَانِيَةٌ مِنَ الْحَاجِّ ، رِحَالُهُمُ الْأَدَمُ  وَخُطُمُ  إِبِلِهِمُ  الْجُدُلُ  ،  فَقَالَ  :  مَنْ أَحَبَّ أَنْ يَرَى أَشْبَهَ رُفْقَةٍ وَرَدَتْ مِنَ الْحَاجِّ الْعَامَ بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَمَنْ قَدِمَ مَعَهُ فَلْيَنْظُرْ إِلَى هَذِهِ الرُّفْقَةِ .","","Al-Mu'jam al-Kabir 13888","","عبد الله بن عمر بن الخطاب عن سعيد بن عمرو بن سعيد بن العاص العذري عن إسحاق بن سعيد بن عمرو السعيدي عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13925","13889  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ .         [13/184]      وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى بْنُ الْحِمَّانِيِّ قَالَا :  ثَنَا  إِسْحَاقُ بْنُ سَعِيدٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ تُصْبَرَ الْبَهِيمَةُ  .  زَادَ  الْحِمَّانِيُّ  فِي حَدِيثِهِ : وَقَالَ : إِنْ أَرَدْتُمْ أَنْ تَذْبَحُوهَا فَاذْبَحُوهَا  .","","Al-Mu'jam al-Kabir 13889","","عبد الله بن عمر بن الخطاب عن سعيد بن عمرو بن سعيد بن العاص العذري عن إسحاق بن سعيد بن عمرو السعيدي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13926","13890  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  خَالِدُ بْنُ سَعِيدٍ ،  ثَنَا  عَمْرُو بْنُ سَعِيدٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْيَدُ  الْعُلْيَا  خَيْرٌ مِنَ  الْيَدِ  السُّفْلَى  .","","Al-Mu'jam al-Kabir 13890","","عبد الله بن عمر بن الخطاب عن سعيد بن عمرو بن سعيد بن العاص العذري عن عمرو بن سعيد عن خالد بن سعيد بن عمرو الأموي عن عبد الله بن عمر مشكدانة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13927","13891  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  خَلَفُ بْنُ مُوسَى بْنِ خَلَفٍ الْعَمِّيُّ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  لَيْثٍ ،  عَنْ  أَبِي مُحَمَّدٍ قَالَ :  صَحِبْتُ  ابْنَ عُمَرَ شَهْرًا وَسَمِعْتُهُ يَقْرَأُ فِي رَكْعَتَيِ الْفَجْرِ  :         [13/185]             {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      ،  وَذَكَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقْرَؤُهُمَا  .","","Al-Mu'jam al-Kabir 13891","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن حفص بن غياث النخعي عن خلف بن موسى بن خلف العمي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13928","13892  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  عَنْ  مُوسَى بْنِ أَعْيَنَ كِلَاهُمَا ،  عَنْ  لَيْثٍ ،  عَنْ  سَعِيدِ بْنِ عَامِرٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كُنَّا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ ، فَنَزَلْنَا بِبِرْكَةٍ فِيهَا مَاءٌ ،  فَكَرَعْنَا  فِيهِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَكْرَعُوا فِيهِ ، وَلَكِنِ اغْسِلُوا أَيْدِيَكُمْ وَاشْرَبُوا فِيهَا  ;         [13/186]      فَإِنَّهُ مَا مِنْ إِنَاءٍ أَطْيَبُ وَلَا أَنْظَفُ مِنْهُ  .  وَاللَّفْظُ لِحَدِيثِ  قَيْسِ بْنِ الرَّبِيعِ  .","","Al-Mu'jam al-Kabir 13892","","عبد الله بن عمر بن الخطاب عن سعيد بن عامر عن ليث بن أبي سليم عن موسى بن أعين الجزري عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","عمرو بن دينار عن ابن عمر"
"13929","13893  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الرَّقَاشِيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ قَالَ :  قَرَأْتُ عَلَى  الْفُضَيْلِ بْنِ مَيْسَرَةَ ،  عَنْ  أَبِي حَرِيزٍ أَنَّ نُفَيْعًا  حَدَّثَهُ  عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دَخَلَ عَلَى  امْرَأَةٍ مِنْ خَثْعَمَ  ، فَقَالَ : "" كَيْفَ تَجِدِينَكِ ؟ "" فَقَالَتْ : لَا أَرَانِي إِلَّا لِمَا بِي !         [13/187]      فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  وَدِدْتُ أَنَّكِ لَمْ تَخْرُجِي مِنَ الدُّنْيَا حَتَّى تَكْفُلِي يَتِيمًا أَوْ  تُجَهِّزِي  غَازِيًا  .","","Al-Mu'jam al-Kabir 13893","","عبد الله بن عمر بن الخطاب عن نفيع بن الحارث الأعمى عن عبد الله بن الحسين السجستاني عن فضيل بن ميسرة عن معتمر بن سليمان عن محمد بن عبد الله بن محمد بن عبد الملك الرقاشي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13930","13894  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَمْرُو بْنُ عُثْمَانَ بْنِ عَاصِمٍ الْوَاسِطِيُّ  ،  ثَنَا  أَبُو تُمَيْلَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَحْيَى بْنِ يَزِيدَ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  نُفَيْعِ بْنِ الْحَارِثِ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِشْرِينَ لَيْلَةً يَقْرَأُ فِي الرَّكْعَتَيْنِ قَبْلَ صَلَاةِ الصُّبْحِ :         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .  قَالَ : وَسَمِعْتُهُ يَقُولُ :  نِعْمَ السُّورَتَانِ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      تَعْدِلُ  ثُلُثَ  الْقُرْآنِ  ، وَ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      تَعْدِلُ رُبُعَ الْقُرْآنِ  .  كذا في طبعة الجريسي ، ولعل الصواب : (عمر بن عثمان بن عاصم الواسطي) وينظر تعليق المحقق .","","Al-Mu'jam al-Kabir 13894","","عبد الله بن عمر بن الخطاب عن نفيع بن الحارث الأعمى عن زيد بن أبي أنيسة الجزري عن يحيى بن يزيد الرهاوي عن محمد بن إسحاق عن يحيى بن واضح الأنصاري عن عمر بن عثمان بن عاصم القرشي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13931","[13/188]      13895  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ ،  حَدَّثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  عَنْ  شِهَابِ بْنِ شُرْنُفَةَ الْمُجَاشِعِيِّ ، قَالَ :  سَمِعْتُ  أَبَا دَاوُدَ الدَّارِمِيَّ يَقُولُ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عُمَرَ يَقُولُ :  رَمَقْتُ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَرْبَعًا وَعِشْرِينَ أَوْ خَمْسًا وَعِشْرِينَ  غَدَاةً وَهُوَ يُصَلِّي الرَّكْعَتَيْنِ قَبْلَ الْغَدَاةِ  ، يَقْرَأُ فِي الْأُولَى مِنْهُمَا         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      وَفِي الثَّانِيَةِ :         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .","","Al-Mu'jam al-Kabir 13895","","عبد الله بن عمر بن الخطاب عن نفيع بن الحارث الأعمى عن شهاب بن خراش الحوشبي عن مسلم بن إبراهيم الشحام عن الفضل بن الحباب الجمحي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13932","13896  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  الصَّلْتُ بْنُ الْحَجَّاجِ ،  ثَنَا  الصَّبَّاحُ ،  عَنْ  أَبِي دَاوُدَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا كَانَ عَشِيَّةُ عَرَفَةَ لَمْ يَبْقَ أَحَدٌ فِي قَلْبِهِ  مِثْقَالُ  حَبَّةٍ  مِنْ خَرْدَلٍ مِنْ إِيمَانٍ إِلَّا غُفِرَ لَهُ  .  قُلْتُ : يَا رَسُولَ اللهِ ، أَهْلُ عَرَفَةَ خَاصَّةً ؟ قَالَ : "" بَلْ لِلْمُسْلِمِينَ عَامَّةً  .","","Al-Mu'jam al-Kabir 13896","","عبد الله بن عمر بن الخطاب عن نفيع بن الحارث الأعمى عن صباح بن موسى عن الصلت بن الحجاج الكوفي عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13933","[13/189]      13897  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عِيسَى بْنُ قِرْطَاسٍ ،  حَدَّثَنِي  أَبُو جَعْفَرٍ مَوْلَى بَنِي هَاشِمٍ ، قَالَ :  كُنَّا قُعُودًا عِنْدَ  ابْنِ عُمَرَ  فَجَاءَهُ رَجُلٌ فَقَالَ لَهُ : كَيْفَ تَقُولُ فِي الطِّلَاءِ الْحُلْوِ الْحَلَالِ ؟ فَضَحِكْنَا وَاسْتَحْيَيْنَا حِينَ قَالَ : الْحَلَالُ ،  فَقَالَ  ابْنُ عُمَرَ :  لَا أَشْرَبُهُ وَلَا أَسْقِيهِ أَحَدًا مِنْ أَهْلِ بَيْتِي  ، فَقَالَ لَهُ  أَبُو جَعْفَرٍ  عِنْدَ ذَلِكَ : هَلْ سَمِعْتَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَذْكُرُ مِنْ هَذِهِ الْأَشْرِبَةِ شَيْئًا ؟ قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَنْهَى عَنِ  الْمُزَفَّتِ  وَالدُّبَّاءِ  وَالنَّقِيرِ  ، وَقَالَ :"" كُلُّ مُسْكِرٍ حَرَامٌ "" ، قُلْتُ لَهُ : النَّبِيذُ يُسْكِرُ ؟ قَالَ : هَذَا مَا سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ  .","","Al-Mu'jam al-Kabir 13897","","عبد الله بن عمر بن الخطاب عن أبو جعفر مولى بني هاشم عن عيسى بن قرطاس الكوفي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13934","13898  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  مَهْدِيُّ بْنُ مَيْمُونٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ أَبِي يَعْقُوبَ ،  عَنِ  ابْنِ أَبِي         [13/190]      نُعْمٍ ، قَالَ  :  كُنْتُ عِنْدَ ابْنِ عُمَرَ فَسَأَلَهُ رَجُلٌ عَنْ دَمِ الْبَعُوضِ  ؟ فَقَالَ لَهُ : مِمَّنْ أَنْتَ ؟ قَالَ : مِنْ  أَهْلِ الْعِرَاقِ  ،  فَقَالَ  : انْظُرُوا ! هَذَا يَسْأَلُنِي عَنْ دَمِ الْبَعُوضَةِ وَقَدْ قَتَلُوا ابْنَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، وَقَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  هُمَا رَيْحَانَتِي مِنَ الدُّنْيَا .  !!","","Al-Mu'jam al-Kabir 13898","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن أبي نعم البجلي عن محمد بن عبد الله بن أبي يعقوب عن مهدي بن ميمون المعولي عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13935","13899  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  أَبُو جَنَابٍ الْكَلْبِيُّ ،  حَدَّثَنِي  هَانِئُ بْنُ الْحَضْرَمِيِّ ، قَالَ :  صَحِبْنَا  ابْنَ عُمَرَ         [13/191]      فِي نَفَرٍ مِنْ  أَهْلِ الْكُوفَةِ  وَأَهْلِ الْبَصْرَةِ  لِنَقْتَدِيَ بِحَجِّهِ  ، فَلَمَّا  أَفَاضَ  مِنْ  عَرَفَاتٍ  وَأَتَى  جَمْعًا  أَقَامَ الصَّلَاةَ ، فَصَلَّيْنَا مَعَهُ الْمَغْرِبَ ، ثُمَّ سَلَّمَ ثُمَّ تَقَدَّمَ فَصَلَّى رَكْعَتَيْنِ ، وَظَنَنَّا أَنَّهُ يُسَبِّحُ ، حَتَّى إِذَا فَرَغَ مَشَى إِلَى خِبَائِهِ ، فَأَلْقَى رِدَاءَهُ وَأَطْلَقَ إِزَارَهُ ، ثُمَّ أُعْطِيَ ثَوْبًا جَافِيًا ، فَأَتَى فِرَاشَهُ فَاضْطَجَعَ عَلَيْهِ ، فَقُلْنَا : مَا يُنْتَظَرُ مِنِ  ابْنِ عُمَرَ  قَدْ أَتَى فِرَاشَهُ فَاضْطَجَعَ عَلَيْهِ ! فَقُمْنَا إِلَيْهِ فَقُلْنَا :  الْقَوْمُ  يَنْتَظِرُونَكَ أَنْ تُصَلِّيَ بِهِمُ الْعِشَاءَ ، فَقَالَ : أَمَّا كَمَا صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَدْ صَلَّيْتُ .  فَعَرَفْنَا أَنَّ الرَّكْعَتَيْنِ هِيَ الْمَكْتُوبَةُ ، ثُمَّ اضْطَجَعَ ، فَلَمَّا رَحَلَ النَّاسُ لِلْغُدُوِّ إِلَى  مِنًى  خَرَجَ فَصَلَّى ، فَأَطَالَ الصَّلَاةَ ثُمَّ جَلَسَ ، فَقَالَ لِغُلَامِهِ : انْظُرْ ، طَلَعَتِ الْكَوْكَبَةُ عَلَى الْجَبَلِ ؟ قَالَ غُلَامُهُ : نَعَمْ قَدْ طَلَعَتْ .  فَدَعَا بِالصَّلَاةِ فَصَلَّى رَكْعَتَيْنِ ، ثُمَّ أَقَامَ الصَّلَاةَ فَصَلَّيْنَا مَعَهُ ، ثُمَّ رَكِبَ إِلَى الْإِمَامِ لِيُفِيضَ مَعَهُ  .","","Al-Mu'jam al-Kabir 13899","","عبد الله بن عمر بن الخطاب عن هانئ بن ثبيب الحضرمي عن يحيى بن أبي حية عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13936","13900  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَمُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ سَعِيدٍ الْأَصْبَهَانِيُّ ،  أَبَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ         [13/192]      زِيَادِ بْنِ خَيْثَمَةَ ،  عَنْ  نُعْمَانِ بْنِ قُرَادٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خُيِّرْتُ بَيْنَ الشَّفَاعَةِ وَبَيْنَ أَنْ يَدْخُلَ  شَطْرُ  أُمَّتِي الْجَنَّةَ ، فَاخْتَرْتُ الشَّفَاعَةَ  لِأَنَّهَا أَعَمُّ ، أَمَا إِنَّهَا لَيْسَتْ لِلْمُؤْمِنِينَ الْمُتَّقِينَ ، وَلَكِنَّهَا لِلْمُذْنِبِينَ الْخَطَّائِينَ الْمُتَلَوِّثِينَ  .","","Al-Mu'jam al-Kabir 13900","","عبد الله بن عمر بن الخطاب عن النعمان بن قراد عن زياد بن خيثمة الجعفي عن عبد السلام بن حرب الملائي عن محمد بن سعيد حمدان عن محمد بن أحمد بن النضر النضري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13937","13901  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الصَّفَّارُ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي عَائِشَةَ أَبُو مُعَاوِيَةَ ،  ثَنَا  صُبَيْحٌ - شَيْخٌ لَنَا قَدِيمٌ ، قَالَ : قَدِمَ عَلَيْنَا عَبْدُ اللهِ بْنُ عُمَرَ ،  فَقَالَ  : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  عَلَيْكُمْ بِالْغَنَمِ  ، فَإِنَّهَا مِنْ دَوَابِّ الْجَنَّةِ ، فَصَلُّوا فِي مُرَاحِهَا وَامْسَحُوا  رُعَامَهَا  .  قُلْتُ لَهُ : مَا  الرُّعَامُ  ؟ قَالَ : الْمُخَاطُ  .","","Al-Mu'jam al-Kabir 13901","","عبد الله بن عمر بن الخطاب عن صبيح شيخ عبد الرحمن بن أبي عائشة المديني قديم عن عبد الرحمن بن أبي عائشة المديني عن يوسف بن يعقوب الصفار عن محمد بن عثمان بن أبي شيبة عن الطبراني","عمرو بن دينار عن ابن عمر"
"13938","[13/193]      13902  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  كُلَيْبُ بْنُ وَائِلٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي مُلَيْكَةَ ، يُكْنَى أَبَا ثَوْرٍ ، قَالَ :  كُنْتُ جَالِسًا عِنْدَ ابْنِ عُمَرَ ، فَأَتَاهُ رَجُلٌ فَسَأَلَهُ ، فَقَالَ : أَرَأَيْتَ  عُثْمَانَ  ، هَلْ شَهِدَ  بَدْرًا  ؟ فَقَالَ : لَا .  فَقَالَ : هَلْ تَوَلَّى يَوْمَ الْتَقَى الْجَمْعَانِ ؟ قَالَ : نَعَمْ .  قَالَ : هَلْ شَهِدَ بَيْعَةَ الرِّضْوَانِ ؟ قَالَ : لَا .  ثُمَّ انْطَلَقَ الرَّجُلُ ، فَقَالَ رَجُلٌ  لِابْنِ عُمَرَ  : إِنَّ هَذَا يَنْطَلِقُ فَيَزْعُمُ أَنَّكَ عِبْتَ عَلَى  عُثْمَانَ  ! فَقَالَ : أَوَفَعَلْتُ ؟ عَلَيَّ الرَّجُلَ ، فَرُدَّ ، فَقَالَ لَهُ  ابْنُ         [13/194]      عُمَرَ  : هَلْ عَقَلْتَ مَا قُلْتُ لَكَ ؟ قَالَ : نَعَمْ .  قَالَ : أَمَّا  يَوْمَ بَدْرٍ  فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اللَّهُمَّ إِنَّ  عُثْمَانَ  فِي حَاجَتِكَ وَحَاجَةِ رَسُولِكَ  ، فَضَرَبَ بِسَهْمِهِ . وَأَمَّا يَوْمَ الْتَقَى الْجَمْعَانِ فَقَدْ عَفَا اللهُ عَنْهُ ، فَقَالَ :         {      إِنَّ الَّذِينَ تَوَلَّوْا مِنْكُمْ         }      ..الْآيَةَ .  وَأَمَّا  بَيْعَةُ الرِّضْوَانِ  فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعَثَهُ إِلَى  الْأَحْزَابِ  فِي  شَأْنِ  الْهَدْيِ لِيُوَادِعُونَا  وَيُسَالِمُونَا  فَأَبَوْا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اللَّهُمَّ إِنَّ  عُثْمَانَ  فِي حَاجَتِكَ وَحَاجَةِ رَسُولِكَ ، وَإِنِّي  أُبَايِعُ  لَهُ  .  فَضَرَبَ بِإِحْدَى يَدَيْهِ عَلَى الْأُخْرَى .  اذْهَبْ فَاجْهَدْ عَلَيَّ  جَهْدَكَ  .","","Al-Mu'jam al-Kabir 13902","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي مليكة النهدي عن كليب بن وائل بن بيحان اليشكري عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13939","13903  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُعَلَّى بْنُ أَسَدٍ الْعَمِّيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْمُخْتَارِ ،  حَدَّثَنِي  مَنْصُورُ بْنُ عَبْدِ الرَّحْمَنِ الْغُدَانِيُّ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ ذَكْوَانَ خَالِي ،  أَنَّهُ سَأَلَ  عَبْدَ اللهِ بْنَ عُمَرَ عَنِ النَّبِيذِ ؟ فَقَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْحَنْتَمِ  وَالْمُزَفَّتِ  ، وَأَمَرَنَا أَنْ نَشْرَبَ فِيمَا يُوكَى وَيُعَلَّقُ  .","","Al-Mu'jam al-Kabir 13903","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن ذكوان خالي عن منصور بن عبد الرحمن الغداني عن عبد العزيز بن المختار الدباغ عن معلى بن أسد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13940","[13/195]      13904  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  إِيَادِ بْنِ لَقِيطٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ نُعَيْمٍ أَخِي بَنِي الْأَعْرَجِ ، قَالَ :  جَاءَ  رَجُلٌ  عَشِيَّةَ عَرَفَةَ إِلَى ابْنِ عُمَرَ فَسَأَلَهُ ؟ فَقَالَ  ابْنُ عُمَرَ  : إِنَّا قَدْ سَمِعْنَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ  الدَّجَّالَ  ، وَبَيْنَ يَدَيِ  الدَّجَّالِ  كَذَّابُونَ ثَلَاثُونَ أَوْ أَكْثَرُ "" ، قُلْنَا : مَا آيَتُهُمْ ؟ قَالَ : "" أَنْ يَأْتُوكُمْ بِسُنَّةٍ لَمْ تَكُونُوا عَلَيْهَا ، يُغَيِّرُونَ بِهَا سُنَّتَكُمْ وَدِينَكُمْ ، فَإِذَا رَأَيْتُمُوهُمْ فَاجْتَنِبُوهُمْ وَعَادُوهُمْ  .","","Al-Mu'jam al-Kabir 13904","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن نعم الأعرجي عن إياد بن لقيط السدوسي عن قيس بن الربيع الأسدي عن عاصم بن علي الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13941","[13/196]      13905  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  ثَنَا  زُهَيْرُ بْنُ أَبِي ثَابِتٍ ،  عَنْ  تَمِيمِ بْنِ سَلَمَةَ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  تَسَحَّرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ لَيْلَةٍ وَعِنْدَهُ قَوْمٌ ، فَجَاءَ  عَلْقَمَةُ بْنُ عُلَاثَةَ الْعَامِرِيُّ  ، فَدَعَا لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِرَأْسٍ ، فَجَاءَ  بِلَالٌ  لِيُؤَذِّنَ بِالصَّلَاةِ ، فَقَالَ :  رُوَيْدَكَ  يَا  بِلَالُ  ، يَتَسَحَّرْ  عَلْقَمَةُ  .","","Al-Mu'jam al-Kabir 13905","","عبد الله بن عمر بن الخطاب عن تميم بن سلمة السلمي عن زهير بن أبى ثابت العبسي عن قيس بن الربيع الأسدي عن عاصم بن علي الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13942","13906  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  أَبُو جَنَابٍ ،  حَدَّثَنِي  أَبِي  ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         [13/197]      لَا تَأْخُذُوا الدِّينَارَ بِالدِّينَارَيْنِ  ، وَلَا الدِّرْهَمَ بِالدِّرْهَمَيْنِ ، وَلَا الصَّاعَ بِالصَّاعَيْنِ ، إِنِّي أَخَافُ عَلَيْكُمُ الرِّبَا "" ، فَقَالَ رَجُلٌ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، الرَّجُلُ يَشْتَرِي النَّجِيبَةَ بِالْإِبِلِ وَالْفَرَسَ بِالْأَفْرَاسِ ؟ قَالَ : لَا بَأْسَ بِذَلِكَ إِذَا كَانَ يَدًا بِيَدٍ  .","","Al-Mu'jam al-Kabir 13906","","عبد الله بن عمر بن الخطاب عن حيي الكلبي عن يحيى بن أبي حية عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13943","13907  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  ضِرَارُ بْنُ صُرَدٍ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  ثَنَا  سَالِمُ بْنُ أَبِي حَفْصَةَ ،  عَنْ  جُمَيْعِ بْنِ عُمَيْرٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمَّا وَجَّهَ  عَلِيًّا  إِلَى  خَيْبَرَ  عَقَدَ لَهُ لِوَاءً فَدَفَعَهُ إِلَيْهِ  .","","Al-Mu'jam al-Kabir 13907","","عبد الله بن عمر بن الخطاب عن جميع بن عمير بن عفاق التيمي عن سالم بن أبي حفصة العجلي عن محمد بن فضيل بن غزوان عن ضرار بن صرد التيمي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13944","13908  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  عَلِيُّ بْنُ صَالِحٍ ،  عَنْ  حَكِيمِ بْنِ جُبَيْرٍ ،  عَنْ  جُمَيْعِ بْنِ عُمَيْرٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  عَلِيٌّ  أَخِي فِي الدُّنْيَا وَالْآخِرَةِ  .","","Al-Mu'jam al-Kabir 13908","","عبد الله بن عمر بن الخطاب عن جميع بن عمير بن عفاق التيمي عن حكيم بن جبير الأسدي عن علي بن صالح بن حي عن إسماعيل بن عمرو البجلي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","عمرو بن دينار عن ابن عمر"
"13945","[13/198]      13909  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عُمَرَ الْبَجَلِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنِ  الْجَحَّافِ ،  عَنْ  جُمَيْعِ بْنِ عُمَيْرٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  آخَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ النَّاسِ حَتَّى لَمْ يَبْقَ إِلَّا  عَلِيٌّ  ، فَقَالَ : يَا رَسُولَ اللهِ ، فَمَنْ أَخِي ؟ قَالَ :  أَنْتَ أَخِي فِي الدُّنْيَا وَالْآخِرَةِ  .","","Al-Mu'jam al-Kabir 13909","","عبد الله بن عمر بن الخطاب عن جميع بن عمير بن عفاق التيمي عن داود بن أبي عوف البرجمي عن قيس بن الربيع الأسدي عن إسماعيل بن عمرو البجلي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","عمرو بن دينار عن ابن عمر"
"13946","13910  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  يَحْيَى بْنُ الْحَسَنِ بْنِ فُرَاتٍ الْقَزَّازُ ،  ثَنَا  عَمْرُو بْنُ ثَابِتٍ ،  حَدَّثَنِي  أَبُو الْجَحَّافِ وَكَثِيرٌ النَّوَّاءُ ، قَالَا :  ثَنَا  جُمَيْعُ بْنُ عُمَيْرٍ ، قَالَ : قُلْتُ لِعَبْدِ اللهِ بْنِ عُمَرَ :  حَدِّثْنِي  عَنْ  عَلِيٍّ  ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ آخَى بَيْنَ الْمُؤْمِنِينَ ، فَسَمِعْتُهُ يَقُولُ : يَا نَبِيَّ اللهِ كُلُّهُمْ يَرْجِعُ وَلَهُ أَخٌ غَيْرِي ؟ فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَمَا تَرْضَى أَنْ أَكُونَ أَخَاكَ  ؟! "" قَالَ : بَلَى ، قَالَ : "" فَأَنَا أَخُوكَ فِي الدُّنْيَا وَالْآخِرَةِ  .         [13/199]      قَالَ  كَثِيرٌ  : فَقُلْتُ : يَا  جُمَيْعُ  ، آللهِ الَّذِي لَا إِلَهَ إِلَّا هُوَ إِنَّكَ سَمِعْتَهُ مِنْ  عَبْدِ اللهِ بْنِ عُمَرَ  ؟! فَحَلَفَ ثَلَاثَ مَرَّاتٍ أَنَّهُ سَمِعَهُ مِنْ  عَبْدِ اللهِ بْنِ عُمَرَ  .","","Al-Mu'jam al-Kabir 13910","","عبد الله بن عمر بن الخطاب عن جميع بن عمير بن عفاق التيمي عن كثير بن إسماعيل النواء عن عمرو بن ثابت عن يحيى بن الحسن بن فرات القزاز عن محمد بن عثمان بن أبي شيبة عن الطبراني","عمرو بن دينار عن ابن عمر"
"13947","13911  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  يَحْيَى بْنُ الْحَسَنِ بْنِ فُرَاتٍ الْقَزَّازُ ،  ثَنَا  عَمْرُو بْنُ ثَابِتٍ ،  ثَنَا  أَبُو الْجَحَّافِ وَكَثِيرٌ النَّوَّاءُ ، قَالَا :  ثَنَا  جُمَيْعُ بْنُ عُمَيْرٍ ، قَالَ :  قُلْتُ  لِعَبْدِ اللهِ بْنِ عُمَرَ : حَدِّثْنِي عَنْ  عَلِيٍّ  . قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ خَيْبَرَ  يَقُولُ :  لَأُعْطِيَنَّ  الرَّايَةَ  رَجُلًا يُحِبُّ اللهَ وَرَسُولَهُ وَيُحِبُّهُ اللهُ وَرَسُولُهُ  ، فَكَأَنِّي أَنْظُرُ إِلَيْهَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَحْتَضِنُهَا ، وَكَانَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  أَرْمَدَ مِنْ  دُخَانِ  الْحِصْنِ ، فَدَفَعَهَا إِلَيْهِ ، فَلَا وَاللهِ مَا تَتَامَّتِ الْخَيْلُ حَتَّى فَتَحَهَا اللهُ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 13911","","عبد الله بن عمر بن الخطاب عن جميع بن عمير بن عفاق التيمي عن كثير بن إسماعيل النواء عن عمرو بن ثابت عن يحيى بن الحسن بن فرات القزاز عن محمد بن عثمان بن أبي شيبة عن الطبراني","عمرو بن دينار عن ابن عمر"
"13948","13912  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْوَهَّابِ الْحَجَبِيُّ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  ثَنَا  صَدَقَةُ بْنُ سَعِيدٍ الْحَنَفِيُّ ،  عَنْ  جُمَيْعِ بْنِ عُمَيْرٍ التَّيْمِيِّ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عُمَرَ         [13/200]      يَقُولُ :  كُنَّا عَلَى بَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَنْتَظِرُهُ ، فَخَرَجَ ، فَاتَّبَعْنَاهُ حَتَّى أَتَى عَقَبَةً مِنْ عِقَابِ  الْمَدِينَةِ  فَقَعَدَ عَلَيْهَا ، فَقَالَ :  يَا أَيُّهَا النَّاسُ ، لَا يَتَلَقَّيَنَّ أَحَدٌ مِنْكُمْ سُوقًا  ، وَلَا يَبِيعَنَّ مُهَاجِرٌ لِأَعْرَابِيٍّ ، وَمَنِ ابْتَاعَ  مُحَفَّلَةً  فَهُوَ  بِالْخِيَارِ  ثَلَاثَةَ أَيَّامٍ ، فَإِنْ رَدَّهَا رَدَّ مَعَهَا  مِثْلَ أَوْ قَالَ : مِثْلَيْ  لَبَنِهَا  قَمْحًا  .","","Al-Mu'jam al-Kabir 13912","","عبد الله بن عمر بن الخطاب عن جميع بن عمير بن عفاق التيمي عن صدقة بن سعيد الحنفي عن عبد الواحد بن زياد عن عبد الله بن عبد الوهاب الحجبي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمرو بن دينار عن ابن عمر"
"13949","13913  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَبْدِ اللهِ بْنِ شَرِيكٍ قَالَ :  حَجَجْتُ فَتَمَتَّعْتُ ، فَسَأَلْتُ ابْنَ عُمَرَ وَابْنَ عَبَّاسٍ وَابْنَ الزُّبَيْرِ ؟ فَقَالُوا :  هُدِيتَ لِسُنَّةِ نَبِيِّكَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، تَقُومُ فَتَطُوفُ  بِالْبَيْتِ  ثُمَّ تَحِلُّ  .","","Al-Mu'jam al-Kabir 13913","","عبد الله بن الزبير عن عبد الله بن شريك العامري عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13950","[13/201]      13914  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  عَنْ  أَبِي إِسْحَاقَ الْفَزَارِيِّ ،  عَنْ  سُفْيَانَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  يَزِيدَ بْنِ بِشْرٍ السَّكْسَكِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  بُنِيَ الْإِسْلَامُ عَلَى خَمْسٍ  : شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَصِيَامِ رَمَضَانَ ، ثُمَّ  الْجِهَادُ  بَعْدَ ذَلِكَ حَسَنٌ  .  هَكَذَا حَدَّثَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13914","","عبد الله بن عمر بن الخطاب عن يزيد بن بشر السكسكي عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن سفيان الثوري عن أبو إسحاق الفزاري عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13951","[13/202]      13915  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ زُنْبُورٍ ،  ثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  يَزِيدَ بْنِ أَبِي بَشِيرٍ السَّكْسَكِيِّ ، قَالَ : لَقِيتُ ابْنَ عُمَرَ ،  فَقَالَ  :  إِنَّ الْإِسْلَامَ بُنِيَ عَلَى خَمْسٍ  : شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ ، وَإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَحَجِّ  الْبَيْتِ  ، وَصَوْمِ رَمَضَانَ .  وَالْجِهَادُ  وَالصَّدَقَةُ مِنَ الْعَمَلِ الصَّالِحِ  .  هَكَذَا حَدَّثَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13915","","عبد الله بن عمر بن الخطاب عن يزيد بن بشر السكسكي عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن الفضيل بن عياض عن محمد بن زنبور الهاشمي عن زكريا بن يحيى السجزي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13952","13916  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي الْبَخْتَرِيِّ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنِ الصَّرْفِ ؟ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الْوَرِقِ نَسِيئًا  بِنَاجِزٍ  .","","Al-Mu'jam al-Kabir 13916","","عبد الله بن عمر بن الخطاب عن سعيد بن فيروز الطائي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13953","13917  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ وَسُلَيْمَانُ بْنُ حَرْبٍ ، قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ قَالَ :  سَمِعْتُ         [13/203]      أَبَا الْبَخْتَرِيِّ يَقُولُ :  سَأَلْتُ  ابْنَ عُمَرَ عَنِ  السَّلَمِ  فِي النَّخْلِ ؟ فَقَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ  الثَّمَرَةِ  حَتَّى تَطْلُعَ  .","","Al-Mu'jam al-Kabir 13917","","عبد الله بن عمر بن الخطاب عن سعيد بن فيروز الطائي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13954","13917  (م)  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي الْبَخْتَرِيِّ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ عَنْ بَيْعِ النَّخْلِ ، فَقَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ النَّخْلِ حَتَّى يَبْدُوَ صَلَاحُهُ  .","","Al-Mu'jam al-Kabir 13917","","عبد الله بن عمر بن الخطاب عن سعيد بن فيروز الطائي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمرو بن دينار عن ابن عمر"
"13955","13918  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  سَعِيدُ بْنُ زَكَرِيَّا ،  عَنْ  عَنْبَسَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُحَمَّدِ بْنِ رُسْتُمَ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يُقْبَلُ إِيمَانٌ بِلَا عَمَلٍ ، وَلَا عَمَلٌ بِلَا إِيمَانٍ  .","","Al-Mu'jam al-Kabir 13918","","عبد الله بن عمر بن الخطاب عن محمد بن رستم عن عنبسة بن عبد الرحمن بن عنبسة الأموي عن سعيد بن زكريا القرشي عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13956","13919  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا         [13/204]      عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ دَعَا النَّاسَ إِلَى قَوْلٍ أَوْ عَمَلٍ فَلَمْ يَعْمَلْ هُوَ بِهِ لَمْ يَزَلْ فِي  سَخَطِ  اللهِ حَتَّى يَكُفَّ  أَوْ يَعْمَلَ مَا قَالَ أَوْ دَعَا إِلَيْهِ  .","","Al-Mu'jam al-Kabir 13919","","عبد الله بن عمر بن الخطاب عن المسيب بن رافع الكاهلي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13957","13920  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَلْبَسُ قَلَنْسُوَةً بَيْضَاءَ  .","","Al-Mu'jam al-Kabir 13920","","عبد الله بن عمر بن الخطاب عن إبراهيم بن يزيد بن شريك التيمي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13958","[13/205]      13921  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  عَلَى كُلِّ مُسْلِمٍ السَّمْعُ وَالطَّاعَةُ فِيمَا أَحَبَّ وَكَرِهَ  مَا لَمْ يُؤْمَرْ بِمَعْصِيَةِ اللهِ  .","","Al-Mu'jam al-Kabir 13921","","عبد الله بن عمر بن الخطاب عن إبراهيم بن يزيد بن شريك التيمي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13959","13922  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَفْضَلُ الدِّينِ  الْوَرَعُ  ، وَأَفْضَلُ الْعِبَادَةِ الْفِقْهُ  .","","Al-Mu'jam al-Kabir 13922","","عبد الله بن عمر بن الخطاب عن إبراهيم بن يزيد بن شريك التيمي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13960","13923  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  [ الْعَوَّامِ بْنِ حَوْشَبٍ ] ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،         [13/206]      عَنِ  ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ حَلَفَ بِغَيْرِ اللهِ فَقَدْ  أَشْرَكَ  .","","Al-Mu'jam al-Kabir 13923","","عبد الله بن عمر بن الخطاب عن إبراهيم بن يزيد بن شريك التيمي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13961","13924  -  حَدَّثَنَا  مُوسَى بْنُ زَكَرِيَّا التُّسْتَرِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ الشَّاذَكُونِيُّ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  ثَنَا  بَدْرُ بْنُ الْخَلِيلِ ،  عَنْ  عَمَّارٍ الدُّهْنِيِّ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ  رَجُلًا  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الصِّيَامِ ؟ فَقَالَ :  الْأَيَّامُ  الْبِيضُ  ثَلَاثَةُ أَيَّامٍ مِنْ كُلِّ شَهْرٍ  .","","Al-Mu'jam al-Kabir 13924","","عبد الله بن عمر بن الخطاب عن سالم بن أبي الجعد الغطفاني عن عمار بن معاوية الدهني عن بدر بن الخليل الأسدي عن عيسى بن يونس بن أبي إسحاق عن الشاذكوني عن موسى بن زكريا التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13962","[13/207]      13925  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ الْأَنْمَاطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حَسَّانَ السَّمْتِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ زَيْدٍ الْحِمْصِيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  عَبْدَةَ بْنِ أَبِي لُبَابَةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ لِلهِ أَقْوَامًا اخْتَصَّهُمْ بِالنِّعَمِ لِمَنَافِعِ الْعِبَادِ  ، يُقِرُّهُمْ فِيهَا مَا يَبْذُلُونَهَا ، فَإِذَا مَنَعُوهَا نَزَعَهَا مِنْهُمْ فَحَوَّلَهَا إِلَى غَيْرِهِمْ  .","","Al-Mu'jam al-Kabir 13925","","عبد الله بن عمر بن الخطاب عن عبدة بن أبي لبابة عن أبو عمرو الأوزاعي عن عبد الله بن زيد الكلبي عن محمد بن حسان بن خالد السمتي عن محمد بن الحسين الأنماطي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13963","13926  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلُ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ أَبِي الثَّلْجِ ،  ثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  ثَنَا  شُعْبَةُ ،  عَنْ  زَائِدَةَ بْنِ عُمَيْرٍ         [13/208]      قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  الْبَيْتِ  ، وَسَيَأْتِي مَنْ يَنْهَاكَ عَنْهُ وَتَسْمَعُ مِنْهُ .  وَإِذَا  ابْنُ عَبَّاسٍ  جَالِسٌ  .","","Al-Mu'jam al-Kabir 13926","","عبد الله بن عمر بن الخطاب عن زائدة بن عمير الطائي عن شعبة بن الحجاج عن عبد الصمد بن عبد الوارث التنوري عن محمد بن عبد الله بن إسماعيل البغدادي عن عبيد العجل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13964","13927  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْوَهَّابِ الْحَجَبِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا أَحَبَّ أَحَدُكُمْ عَبْدًا فَلْيُخْبِرْهُ  ، فَإِنَّهُ يَجِدُ مِثْلَ الَّذِي يَجِدُ لَهُ  .","","Al-Mu'jam al-Kabir 13927","","عبد الله بن عمر بن الخطاب عن عبد الله بن مرة الخارفي عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن عبد الله بن عبد الوهاب الحجبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13965","13928  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مَنْصُورٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نَهَانَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ النَّذْرِ ، وَقَالَ :  إِنَّهُ لَا يُقَدِّمُ شَيْئًا ، وَإِنَّمَا يُسْتَخْرَجُ بِهِ مِنَ  الشَّحِيحِ  .         [13/209]","","Al-Mu'jam al-Kabir 13928","","عبد الله بن عمر بن الخطاب عن عبد الله بن مرة الخارفي عن منصور بن المعتمر عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13966","13929  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ النَّذْرِ ..فَذَكَرَ مِثْلَهُ  .","","Al-Mu'jam al-Kabir 13929","","عبد الله بن عمر بن الخطاب عن عبد الله بن مرة الخارفي عن منصور بن المعتمر عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمرو بن دينار عن ابن عمر"
"13967","13930  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ النَّذْرَ لَا يَرُدُّ شَيْئًا  ، وَلَكِنْ يُسْتَخْرَجُ بِهِ مِنَ الْبَخِيلِ  .","","Al-Mu'jam al-Kabir 13930","","عبد الله بن عمر بن الخطاب عن عبد الله بن مرة الخارفي عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13968","[13/210]      13931  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ الدَّوْلَابِيُّ .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ ،  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَبَنَا  شَرِيكٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ النَّذْرِ  ، وَأَمَرَ بِالْوَفَاءِ بِهِ  .","","Al-Mu'jam al-Kabir 13931","","عبد الله بن عمر بن الخطاب عن عبد الله بن مرة الخارفي عن منصور بن المعتمر عن شريك بن عبد الله النخعي عن علي بن الجعد عن ابن الرازي محمد بن جعفر البغدادى عن الطبراني","عمرو بن دينار عن ابن عمر"
"13969","13932  -  حَدَّثَنَا  أَحْمَدُ بْنُ شُعَيْبٍ أَبُو عَبْدِ الرَّحْمَنِ النَّسَائِيُّ ،  أَبَنَا  مُحَمَّدُ بْنُ رَافِعٍ النَّيْسَابُورِيُّ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  ثَنَا  مُفَضَّلُ بْنُ مُهَلْهِلٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ النَّذْرِ ..فَذَكَرَ مِثْلَهُ  .","","Al-Mu'jam al-Kabir 13932","","عبد الله بن عمر بن الخطاب عن عبد الله بن مرة الخارفي عن منصور بن المعتمر عن المفضل بن مهلهل السعدي عن يحيى بن آدم عن محمد بن رافع القشيري عن النسائي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13970","13933  -  حَدَّثَنَا عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرُ بْنُ كِدَامٍ ،  عَنْ  وَبَرَةَ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ : مَتَى أَرْمِي بِالْجِمَارِ ؟         [13/211]      قَالَ : إِذَا رَمَى إِمَامُكَ فَارْمِهِ  ، فَأَعَدْتُ عَلَيْهِ الْمَسْأَلَةَ ، فَقَالَ :  كُنَّا  نَتَحَيَّنُ  فَإِذَا زَالَتِ الشَّمْسُ رَمَيْنَا  .","","Al-Mu'jam al-Kabir 13933","","عبد الله بن عمر بن الخطاب عن وبرة بن عبد الرحمن المسلي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13971","13934  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرُ بْنُ كِدَامٍ ،  عَنْ  وَبَرَةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  وَقَّتَ  لِأَهْلِ الْيَمَنِ  يَلَمْلَمَ  ،  وَلِأَهْلِ الْمَدِينَةِ  ذَا الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  الْجُحْفَةَ  ،  وَلِأَهْلِ نَجْدٍ  قَرْنً  . فَذَكَرْتُ لَهُ  الْعِرَاقَ  ، فَقَالَ : لَمْ يَكُنْ يَوْمَئِذٍ  كُوفَةٌ  وَلَا  بَصْرَةٌ  .","","Al-Mu'jam al-Kabir 13934","","عبد الله بن عمر بن الخطاب عن وبرة بن عبد الرحمن المسلي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13972","[13/212]      13935  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  وَبَرَةَ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  يَقْتُلُ الْمُحْرِمُ  الْحِدَأَةَ  وَالْكَلْبَ  الْعَقُورَ  وَالذِّئْبَ  وَالْفَأْرَةَ  وَالْغُرَابَ  . فَذَكَرْتُ لَهُ الْحَيَّةَ وَالْعَقْرَبَ ؟ فَقَالَ : إِنَّ ذَلِكَ لَيُقَالُ  .","","Al-Mu'jam al-Kabir 13935","","عبد الله بن عمر بن الخطاب عن وبرة بن عبد الرحمن المسلي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13973","13936  -  حَدَّثَنَا  الْقَاسِمُ بْنُ مُحَمَّدٍ الدَّلَّالُ الْكُوفِيُّ ،  ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ مِسْعَرِ بْنِ كِدَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَبَرَةَ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِرَجُلٍ  : ""  تَنَقَّهْ  [وَتَوَقَّهْ ]  .","","Al-Mu'jam al-Kabir 13936","","عبد الله بن عمر بن الخطاب عن وبرة بن عبد الرحمن المسلي عن مسعر بن كدام عن عبد الله بن مسعر بن كدام عن أبو بلال الأشعري عن قاسم بن محمد بن حماد الدلال عن الطبراني","عمرو بن دينار عن ابن عمر"
"13974","[13/213]      13937  -  حَدَّثَنَا  جَعْفَرُ بْنُ أَحْمَدَ الشَّامِيُّ الْكُوفِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  مُحَمَّدِ بْنِ جَابِرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  وَبَرَةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَكْثَرَ مِنْ عِشْرِينَ مَرَّةً يَقْرَأُ فِي الرَّكْعَتَيْنِ قَبْلَ الْفَجْرِ  :         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ، وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .","","Al-Mu'jam al-Kabir 13937","","عبد الله بن عمر بن الخطاب عن وبرة بن عبد الرحمن المسلي عن أبو إسحاق السبيعي عن محمد بن جابر بن سيار عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن جعفر بن أحمد الشامي الكوفي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13975","13938  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ الْقَطَّانُ ، قَالَا :  ثَنَا  يُوسُفُ بْنُ عَدِيٍّ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  وَبَرَةَ بْنِ عَبْدِ الرَّحْمَنِ قَالَ :         [13/214]      قُلْتُ لِابْنِ عُمَرَ : أَطُوفُ  بِالْبَيْتِ  وَأَنَا مُحْرِمٌ ؟  قَالَ  : وَمَا يَمْنَعُكَ ؟  قَالَ : كَانَ  ابْنُ عَبَّاسٍ  يَنْهَى عَنْ ذَلِكَ حَتَّى يَرْجِعَ النَّاسُ مِنَ  الْمُعَرَّفِ  .  فَقَالَ :  قَدْ حَجَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَطَافَ  بِالْبَيْتِ  وَسَعَى بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  ; فَسُنَّةُ اللهِ وَسُنَّةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحَقُّ أَنْ تُتَّبَعَ ، أَوْ سُنَّةُ  ابْنِ عَبَّاسٍ  ، إِنْ كَانَ صَادِقًا . ؟ !","","Al-Mu'jam al-Kabir 13938","","عبد الله بن عمر بن الخطاب عن وبرة بن عبد الرحمن المسلي عن إسماعيل بن أبي خالد عن يحيى بن زكريا بن أبي زائدة عن يوسف بن عدي بن رزق الكوفي عن إسحاق بن إبراهيم بن جابر التجيبي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13976","[13/215]      13939  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  الْحَسَنُ بْنُ عَرَفَةَ ،  ثَنَا  قُدَامَةُ بْنُ شِهَابٍ الْمَازِنِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  وَبَرَةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  سُئِلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَيُّ الْكَسْبِ أَطْيَبُ ؟ قَالَ :  [عَمَلُ] الرَّجُلِ بِيَدِهِ ، وَكُلُّ بَيْعٍ مَبْرُورٍ  .","","Al-Mu'jam al-Kabir 13939","","عبد الله بن عمر بن الخطاب عن وبرة بن عبد الرحمن المسلي عن إسماعيل بن أبي خالد عن قدامة بن شهاب المازني عن الحسن بن عرفة العبدي عن علي بن سعيد بن بشير عليك عن الطبراني","عمرو بن دينار عن ابن عمر"
"13977","13940  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  أَبُو حُمَيْدٍ أَحْمَدُ بْنُ مُحَمَّدِ بْنِ الْمُغِيرَةِ بْنِ سَيَّارٍ الْحِمْصِيُّ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ الْعَطَّارُ ،  ثَنَا  حَفْصُ بْنُ سُلَيْمَانَ ،  عَنْ  مُحَمَّدِ بْنِ سُوقَةَ ،  عَنْ  وَبَرَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَيَدْفَعُ بِالْمُسْلِمِ الصَّالِحِ عَنْ مِائَةِ أَهْلِ بَيْتٍ مِنْ جِيرَانِهِ الْبَلَاءَ  ، ثُمَّ قَرَأَ  ابْنُ عُمَرَ  :         {      وَلَوْلا دَفْعُ اللهِ النَّاسَ بَعْضَهُمْ بِبَعْضٍ لَفَسَدَتِ الأَرْضُ         }      ..  .","","Al-Mu'jam al-Kabir 13940","","عبد الله بن عمر بن الخطاب عن وبرة بن عبد الرحمن المسلي عن محمد بن سوقة الغنوي عن حفيص الأسدي عن يحيى بن سعيد الأنصاري عن أحمد بن محمد بن المغيرة بن سنان العوهي عن علي بن سعيد بن بشير عليك عن الطبراني","عمرو بن دينار عن ابن عمر"
"13978","[13/216]      13941  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  لَيْثٍ ،  عَنْ  عُمَيْرِ بْنِ أَبِي عُمَيْرٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  مَا رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَائِمًا فِي يَوْمِ جُمُعَةٍ قَطُّ  .","","Al-Mu'jam al-Kabir 13941","","عبد الله بن عمر بن الخطاب عن عمير بن أبي عمير عن ليث بن أبي سليم عن حفص بن غياث النخعي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13979","13942  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ أَعْيَنَ الْبَغْدَادِيُّ ،  ثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ ،  ثَنَا  أَسْبَاطُ بْنُ مُحَمَّدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ         [13/217]      عَبْدِ اللهِ ،  عَنْ  سَعْدٍ مَوْلَى طَلْحَةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : لَقَدْ سَمِعْتُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَدِيثًا لَوْ لَمْ أَسْمَعْهُ إِلَّا مَرَّةً أَوْ مَرَّتَيْنِ ، حَتَّى عَدَّ سَبْعَ مَرَّاتٍ ، وَلَكِنْ قَدْ سَمِعْتُهُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : ""  كَانَ  الْكِفْلُ  مِنْ  بَنِي إِسْرَائِيلَ  لَا يَتَوَرَّعُ مِنْ ذَنْبٍ عَمِلَهُ  ، فَأَتَتْهُ  امْرَأَةٌ  فَأَعْطَاهَا سِتِّينَ دِينَارًا عَلَى أَنْ يَطَأَهَا ، فَلَمَّا قَعَدَ مِنْهَا مَقْعَدَ الرَّجُلِ مِنِ امْرَأَتِهِ أَرْعَدَتْ وَبَكَتْ ، فَقَالَ : مَا يُبْكِيكِ ؟ أَكْرَهْتُكِ ؟ قَالَتْ : لَا وَلَكِنَّ هَذَا عَمَلٌ لَمْ أَعْمَلْهُ قَطُّ ، إِنَّمَا حَمَلَتْنِي عَلَيْهِ الْحَاجَةُ ! قَالَ : فَتَفْعَلِينَ هَذَا وَلَمْ تَفْعَلِيهِ قَطُّ ؟ ثُمَّ نَزَلَ فَقَالَ : اذْهَبِي وَالدَّنَانِيرُ لَكِ ، ثُمَّ قَالَ : وَاللهِ لَا يَعْصِي اللهَ  الْكِفْلُ  أَبَدًا .  فَمَاتَ مِنْ لَيْلَتِهِ فَأَصْبَحَ مَكْتُوبٌ عَلَى بَابِهِ : قَدْ غَفَرَ اللهُ  لِلْكِفْلِ  .","","Al-Mu'jam al-Kabir 13942","","عبد الله بن عمر بن الخطاب عن سعد مولى طلحة عن عبد الله بن عبد الله الهاشمي عن الأعمش عن أسباط بن محمد بن ميسرة القرشي عن داود بن عمرو المسيبي عن محمد بن جعفر بن أعين البغدادي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13980","[13/218]      13943  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  يَزِيدُ بْنُ مِهْرَانَ أَبُو خَالِدٍ الْخَبَّازُ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ الرَّازِيِّ ،  عَنْ  سَعِيدٍ مَوْلَى طَلْحَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَكْثَرَ مِنْ عِشْرِينَ مَرَّةً يَقُولُ :  أَتَى  ذَا الْكِفْلِ  امْرَأَةٌ  ،         [13/219]      فَلَمَّا دَنَا مِنْهَا بَكَتْ ، وَتَنَحَّى نَاحِيَةً  ، فَجَاءَهُ الْمَوْتُ مِنَ اللَّيْلِ ، فَأَصْبَحَ مَكْتُوبٌ عَلَى بَابِهِ ، مَكْتُوبٌ : قَدْ غَفَرَ اللهُ لَكَ  .","","Al-Mu'jam al-Kabir 13943","","عبد الله بن عمر بن الخطاب عن سعد مولى طلحة عن عبد الله بن عبد الله الهاشمي عن الأعمش عن أبو بكر بن عياش عن يزيد بن مهران الخباز عن بشر بن موسى بن صالح الأسدي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13981","13944  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ،  ثَنَا  دَاوُدُ بْنُ مِخْرَاقٍ الْفِرْيَابِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنِ  ابْنِ مِغْوَلٍ وَإِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  أَبِي حَنْظَلَةَ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنِ الصَّلَاةِ فِي السَّفَرِ ؟ فَقَالَ : رَكْعَتَانِ  ، فَقُلْتُ : إِنَّا آمِنُونَ لَا نَخَافُ ! قَالَ : سُنَّةُ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13944","","عبد الله بن عمر بن الخطاب عن أبو حنظلة الحذاء الكوفى عن مالك بن مغول الصهيبي عن عبد الله بن إدريس الأودي عن داود بن مخراق الفريابي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13982","13945  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  [ شُعْبَةُ ] ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، قَالَ :         [13/220]      سَمِعْتُ  حَكِيمً  الْحَذَّاءَ يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ سُئِلَ عَنِ الصَّلَاةِ فِي السَّفَرِ ؟ فَقَالَ : رَكْعَتَيْنِ ،  سُنَّةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  كذا في طبعة الجريسي ، والنصب على لغة ربيعة .","","Al-Mu'jam al-Kabir 13945","","عبد الله بن عمر بن الخطاب عن أبو حنظلة الحذاء الكوفى عن إسماعيل بن أبي خالد عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13983","13946  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  جَنْدَلُ بْنُ وَالِقٍ ،  ثَنَا  مِنْدَلٌ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  عُمَرَ الْأَزْدِيِّ ،  عَنْ  عُمَيْرِ بْنِ هِشَامٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لِجَهَنَّمَ  سَبْعَةُ أَبْوَابٍ  ، فَبَابٌ مِنْهَا لِمَنْ  شَهَرَ  السِّلَاحَ عَلَى أُمَّتِي  .","","Al-Mu'jam al-Kabir 13946","","عبد الله بن عمر بن الخطاب عن عمير بن هشام عن عمر الأزدي عن سلمة بن دينار الأعرج عن مندل بن علي عن جندل بن والق التغلبي عن محمد بن عثمان بن أبي شيبة عن الطبراني","عمرو بن دينار عن ابن عمر"
"13984","13947  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،         [13/221]      ثَنَا  الْحَسَنُ بْنُ عُبَيْدِ اللهِ ،  ثَنَا  سَعْدُ بْنُ عُبَيْدَةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الشَّهْرُ  هَكَذَا وَهَكَذَا  .."" ، وَحَبَسَ إِبْهَامَهُ  .","","Al-Mu'jam al-Kabir 13947","","عبد الله بن عمر بن الخطاب عن سعد بن عبيدة السلمي عن الحسن بن عبيد الله النخعي عن عبد الواحد بن زياد عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13985","13948  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  أَبُو حَصِينٍ ،  عَنْ  سَعْدِ بْنِ [عُبَيْدَةَ] قَالَ :  أَتَى رَجُلٌ إِلَى ابْنِ عُمَرَ فَسَأَلَهُ عَنْ عَلِيٍّ ؟ فَذَكَرَ أَحْسَنَ عَمَلِهِ  ، ثُمَّ قَالَ :         [13/222]      هَذَلِكَ بَيْتُهُ  أَوْسَطُ بُيُوتِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَوْ وَسَطَ بُيُوتِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  شَكَّ  أَبُو حَصِينٍ  ، ثُمَّ قَالَ لَهُ  ابْنُ عُمَرَ  : إِنِّي لَأَرَاكَ يَسُوءُكَ ؟! قَالَ : أَجَلْ ،  فَقَالَ  ابْنُ عُمَرَ  :  أَبْعَدَكَ  اللهُ [وَأَرْغَمَ] بِأَنْفِكَ ، ثُمَّ قَالَ : اخْرُجْ  .","","Al-Mu'jam al-Kabir 13948","","علي بن أبي طالب عن سعد بن عبيدة السلمي عن عثمان بن عاصم بن حصين عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13986","[13/223]      13949  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيِّ بْنِ زُولَاقٍ الْمِصْرِيُّ ،  ثَنَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  أَبِي حَصِينٍ ،  عَنْ  سَعْدِ بْنِ عُبَيْدَةَ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ، فَإِذَا خَشِيتَ الصُّبْحَ  فَأَوْتِرْ  بِوَاحِدَةٍ  .","","Al-Mu'jam al-Kabir 13949","","عبد الله بن عمر بن الخطاب عن سعد بن عبيدة السلمي عن عثمان بن عاصم بن حصين عن أبو بكر بن عياش عن يحيى بن سليمان بن يحيى عن الحسن بن علي ابن زولاق الشيعي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13987","13950  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  شَرِيكٌ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  سَعْدِ بْنِ عُبَيْدَةَ ،  عَنِ  ابْنِ عُمَرَ  أَنَّهُ سَمِعَ  رَجُلًا  يَقُولُ : وَالْكَعْبَةِ ، فَقَالَ : وَيْحَكَ ! لَا تَقُولُ :         [13/224]      وَالْكَعْبَةِ ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  كُلُّ يَمِينٍ يُحْلَفُ بِهَا دُونَ اللهِ  شِرْكٌ  .","","Al-Mu'jam al-Kabir 13950","","عبد الله بن عمر بن الخطاب عن سعد بن عبيدة السلمي عن الحسن بن عبيد الله النخعي عن شريك بن عبد الله بن أبي نمر الكناني عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13988","13951  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَبَنَا  عَبْدُ الرَّزَّاقِ ،  أَبَنَا  الثَّوْرِيُّ ،  عَنْ  أَبِيهِ  وَمَنْصُورٍ وَالْأَعْمَشِ ،  عَنْ  سَعْدِ بْنِ عُبَيْدَةَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كَانَ  عُمَرُ  يَحْلِفُ وَأَبِي . فَنَهَاهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقَالَ :  مَنْ حَلَفَ بِشَيْءٍ دُونَ اللهِ فَقَدْ  أَشْرَكَ  .","","Al-Mu'jam al-Kabir 13951","","عبد الله بن عمر بن الخطاب عن سعد بن عبيدة السلمي عن منصور بن المعتمر عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13989","13952  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ ،  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا         [13/225]      شَرِيكٌ ،  عَنْ  جَابِرٍ ،  عَنْ  سَعْدِ بْنِ عُبَيْدَةَ ،  عَنِ  ابْنِ عُمَرَ  أَنَّهُ سَمِعَ  رَجُلًا  يَقُولُ : وَالْكَعْبَةِ ، فَقَالَ : لَا تَقُلْ وَالْكَعْبَةِ ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  كُلُّ يَمِينٍ حُلِفَ بِهَا دُونَ اللهِ  شِرْكٌ  .","","Al-Mu'jam al-Kabir 13952","","عبد الله بن عمر بن الخطاب عن سعد بن عبيدة السلمي عن جابر الجعفي عن شريك بن عبد الله بن أبي نمر الكناني عن علي بن الجعد عن ابن الرازي محمد بن جعفر البغدادى عن الطبراني","عمرو بن دينار عن ابن عمر"
"13990","13953  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عُزَيْزٍ الْمَوْصِلِيُّ ،  ثَنَا  غَسَّانُ بْنُ الرَّبِيعِ ،  ثَنَا  جَعْفَرُ بْنُ مَيْسَرَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ :  مَنْ تَبِعَ جِنَازَةً حَتَّى يُصَلِّيَ عَلَيْهَا ثُمَّ يَرْجِعَ فَلَهُ قِيرَاطٌ  ، وَمَنْ صَلَّى عَلَيْهَا ثُمَّ مَشَى مَعَهَا حَتَّى يَدْفِنَهَا فَلَهُ قِيرَاطَانِ "" ، قِيلَ : يَا رَسُولَ اللهِ ، وَمَا الْقِيرَاطَانِ ؟ قَالَ : "" مِثْلُ  أُحُدٍ  .","","Al-Mu'jam al-Kabir 13953","","عبد الله بن عمر بن الخطاب عن ميسرة الأشجعي عن جعفر بن ميسرة الأشجعي عن غسان بن الربيع الأزدي عن عبد الله بن محمد بن عزيز التميمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13991","13954  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عُزَيْزٍ الْمَوْصِلِيُّ ،  ثَنَا  غَسَّانُ بْنُ الرَّبِيعِ ،  ثَنَا  جَعْفَرُ بْنُ مَيْسَرَةَ الْأَشْجَعِيُّ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ         [13/226]      أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَعَنَ اللهُ  الْمُسَوِّفَاتِ  ، قُلْنَا : يَا نَبِيَّ اللهِ ، وَمَا  الْمُسَوِّفَاتُ  ؟ قَالَ : "" الَّتِي يَدْعُوهَا زَوْجُهَا إِلَى فِرَاشِهِ ، فَتَقُولُ : سَوْفَ ، حَتَّى تَغْلِبَهُ عَيْنَاهُ  .","","Al-Mu'jam al-Kabir 13954","","عبد الله بن عمر بن الخطاب عن ميسرة الأشجعي عن جعفر بن ميسرة الأشجعي عن غسان بن الربيع الأزدي عن عبد الله بن محمد بن عزيز التميمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13992","13955  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عُزَيْزٍ الْمَوْصِلِيُّ ،  ثَنَا  غَسَّانُ بْنُ الرَّبِيعِ ،  ثَنَا  جَعْفَرُ بْنُ مَيْسَرَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ يَوْمًا بَيْنَ قُبُورٍ وَمَعَهُ  جَرِيدَةٌ  رَطْبَةٌ ، فَشَقَّهَا بِاثْنَيْنِ ، وَوَضَعَ وَاحِدَةً عَلَى قَبْرٍ وَالْأُخْرَى عَلَى قَبْرٍ آخَرَ ، ثُمَّ مَضَى ، فَقُلْنَا : يَا رَسُولَ اللهِ ، لِمَ فَعَلْتَ ذَلِكَ ؟ فَقَالَ :  أَمَّا أَحَدُهُمَا فَكَانَ يُعَذَّبُ فِي النَّمِيمَةِ ، وَأَمَّا الْآخَرُ فَكَانَ لَا يَتَّقِي الْبَوْلَ  ، وَلَنْ يُعَذَّبَا مَا دَامَتْ هَذِهِ رَطْبَةً  .","","Al-Mu'jam al-Kabir 13955","","عبد الله بن عمر بن الخطاب عن ميسرة الأشجعي عن جعفر بن ميسرة الأشجعي عن غسان بن الربيع الأزدي عن عبد الله بن محمد بن عزيز التميمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13993","[13/227]      13956  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عُزَيْزٍ الْمَوْصِلِيُّ ،  ثَنَا  غَسَّانُ بْنُ الرَّبِيعِ ،  ثَنَا  جَعْفَرُ بْنُ مَيْسَرَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كَانَ الْمُشْرِكُونَ لَا يُفِيضُونَ مِنْ  عَرَفَاتٍ  حَتَّى تَعَمَّمَ الشَّمْسُ فِي رُؤُوسِ الْجِبَالِ ، فَتَصِيرَ فِي رُؤُوسِهَا كَعَمَائِمِ الرِّجَالِ فِي وُجُوهِهَا ،  وَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ لَا يُفِيضُ حَتَّى تَغْرُبَ  ، وَكَانَ الْمُشْرِكُونَ لَا يُفِيضُونَ مِنْ  جَمْعٍ  حَتَّى يَقُولُوا :  أَشْرِقْ  ثَبِيرُ ، فَلَا يُفِيضُونَ حَتَّى تَصِيرَ الشَّمْسُ فِي رُؤُوسِ الْجِبَالِ كَعَمَائِمِ الرِّجَالِ فِي وُجُوهِهِمْ ، وَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يُفِيضُ قَبْلَ أَنْ تَطْلُعَ الشَّمْسُ  .","","Al-Mu'jam al-Kabir 13956","","عبد الله بن عمر بن الخطاب عن ميسرة الأشجعي عن جعفر بن ميسرة الأشجعي عن غسان بن الربيع الأزدي عن عبد الله بن محمد بن عزيز التميمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13994","13957  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  نَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  مِنْدَلُ بْنُ عَلِيٍّ ،  ثَنَا  جَعْفَرُ بْنُ أَبِي جَعْفَرٍ الْأَشْجَعِيُّ ،  عَنْ         [13/228]      أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ :  صَلَّى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِأَصْحَابِهِ صَلَاةَ الْفَجْرِ فِي سَفَرٍ ، فَقَرَأَ :         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      ، ثُمَّ قَالَ :  قَرَأْتُ لَكُمْ  ثُلُثَ  الْقُرْآنِ وَرُبُعَهُ  .","","Al-Mu'jam al-Kabir 13957","","عبد الله بن عمر بن الخطاب عن ميسرة الأشجعي عن جعفر بن ميسرة الأشجعي عن مندل بن علي عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13995","13958  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عُزَيْزٍ الْمَوْصِلِيُّ ،  ثَنَا  غَسَّانُ بْنُ الرَّبِيعِ ،  ثَنَا  مُوسَى بْنُ مُطَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ :  رُبَّمَا اسْتَاكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي اللَّيْلِ أَرْبَعَ مَرَّاتٍ  .","","Al-Mu'jam al-Kabir 13958","","عبد الله بن عمر بن الخطاب عن مطير بن أبي خالد الكوفي عن موسى بن مطير الكوفي عن غسان بن الربيع الأزدي عن عبد الله بن محمد بن عزيز التميمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13996","13959  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ وَعَبْدُ السَّلَامِ بْنُ سَهْلٍ السُّكَّرِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الرُّزِّيُّ ،  ثَنَا  أَبُو تُمَيْلَةَ يَحْيَى بْنُ         [13/229]      وَاضِحٍ ،  عَنْ  أَبِي طَيْبَةَ ،  ثَنَا  أَبُو مِجْلَزٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَبِسَ الْحَرِيرَ وَشَرِبَ فِي الْفِضَّةِ فَلَيْسَ مِنَّا  ، وَمَنْ  خَبَّبَ  امْرَأَةً عَلَى زَوْجِهَا أَوْ عَبْدًا عَلَى مَوَالِيهِ فَلَيْسَ مِنَّا  .","","Al-Mu'jam al-Kabir 13959","","عبد الله بن عمر بن الخطاب عن لاحق بن حميد عن عبد الله بن مسلم السلمي عن يحيى بن واضح الأنصاري عن محمد بن عبد الله الأرزي عن عبد السلام بن سهل السكري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13997","13960  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَبَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي مِجْلَزٍ قَالَ :  صَلَّيْتُ خَلْفَ ابْنِ عُمَرَ فَلَمْ يَقْنُتْ  ، فَقُلْتُ : مَا مَنَعَكَ مِنَ  الْقُنُوتِ  ؟  فَقَالَ  : إِنِّي لَا أَحْفَظُ عَنْ أَحَدٍ مِنْ أَصْحَابِي  .","","Al-Mu'jam al-Kabir 13960","","عبد الله بن عمر بن الخطاب عن لاحق بن حميد عن قتادة بن دعامة عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن عثمان بن عمر الضبي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13998","[13/230]      13961  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ الْعِجْلِيُّ ،  ثَنَا  عَبْثَرُ بْنُ الْقَاسِمِ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  أَبِي مِجْلَزٍ قَالَ :  قَالَ  ابْنُ عُمَرَ :  أَمَّا نَحْنُ فَكُنَّا نُعْطِي صَدَقَةَ الْفِطْرِ التَّمْرَ  .","","Al-Mu'jam al-Kabir 13961","","عبد الله بن عمر بن الخطاب عن لاحق بن حميد عن سليمان بن طرخان عن عبثر بن القاسم الزبيدي عن عبد الله بن صالح العجلي عن لحية الليف محمد بن العباس عن الطبراني","عمرو بن دينار عن ابن عمر"
"13999","13962  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  سَعِيدُ بْنُ عَمْرٍو الْأَشْعَثِيُّ ،  ثَنَا  عَبْثَرُ بْنُ الْقَاسِمِ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  أَبِي مِجْلَزٍ ،  عَنِ  ابْنِ         [13/231]      عُمَرَ قَالَ :  صَلَّى بِنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الظُّهْرَ فَسَجَدَ  ، ثُمَّ قَامَ فَقَرَأَ ، فَرَأَوْا أَنَّهُ قَرَأَ :         {      الم             *          تَنْـزِيلُ         }      السَّجْدَةَ  .","","Al-Mu'jam al-Kabir 13962","","عبد الله بن عمر بن الخطاب عن لاحق بن حميد عن سليمان بن طرخان عن عبثر بن القاسم الزبيدي عن سعيد بن عمرو بن سهل الأشعثي عن موسى بن هارون الحمال عن الطبراني","عمرو بن دينار عن ابن عمر"
"14000","13963  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ ،  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَبَنَا  شُعْبَةُ ،  عَنْ  أَبِي التَّيَّاحِ قَالَ :  سَمِعْتُ  أَبَا مِجْلَزٍ  يُحَدِّثُ عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْوِتْرُ  رَكْعَةٌ مِنْ آخِرِ اللَّيْلِ  .","","Al-Mu'jam al-Kabir 13963","","عبد الله بن عمر بن الخطاب عن لاحق بن حميد عن يزيد بن حميد الضبعي عن شعبة بن الحجاج عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","عمرو بن دينار عن ابن عمر"
"14001","[13/232]      13964  -  حَدَّثَنَا  دُرَّانُ بْنُ سُفْيَانَ بْنِ مُعَاوِيَةَ الْعَطَّارُ الْبَصْرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي مِجْلَزٍ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنِ  الْوِتْرِ  ؟ فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : "" رَكْعَةٌ  .","","Al-Mu'jam al-Kabir 13964","","عبد الله بن عمر بن الخطاب عن لاحق بن حميد عن قتادة بن دعامة عن همام بن يحيى بن دينار عن محمد بن كثير العبدي عن محمد بن معاذ بن سفيان العنزي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14002","13965  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  شُعْبَةَ ،  حَدَّثَنِي  قَتَادَةُ ،  عَنْ  أَبِي مِجْلَزٍ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنِ  الْوِتْرِ  ؟ فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  رَكْعَةٌ مِنْ آخِرِ اللَّيْلِ  .","","Al-Mu'jam al-Kabir 13965","","عبد الله بن عمر بن الخطاب عن لاحق بن حميد عن قتادة بن دعامة عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14003","[13/233]      13966  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ التَّرْجُمَانِيُّ ،  ثَنَا  صَالِحٌ الْمُرِّيُّ ،  عَنْ  أَبِي هَارُونَ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ  الْقَوْمَ  إِذَا صَلَّوْا فِي الْجَمِيعِ إِنَّ اللهَ لَيَعْجَبُ مِنْهُمْ  .","","Al-Mu'jam al-Kabir 13966","","عبد الله بن عمر بن الخطاب عن عمارة بن جوين العبدي عن صالح بن بشير المري عن إسماعيل بن إبراهيم الترجماني عن روح بن الفرج القطان عن الطبراني","عمرو بن دينار عن ابن عمر"
"14004","13967  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَبِي هَارُونَ الْعَبْدِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،         [13/234]      فَقَالَ :  السَّلَامُ عَلَيْكُمْ ، فَقَالَ : "" عَشْرًا  ، فَجَاءَ  آخَرُ  فَقَالَ : السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ ، فَقَالَ : "" عِشْرُونَ "" ، ثُمَّ جَاءَ  آخَرُ  فَقَالَ : السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" ثَلَاثُونَ  .","","Al-Mu'jam al-Kabir 13967","","عبد الله بن عمر بن الخطاب عن عمارة بن جوين العبدي عن حماد بن زيد عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14005","13968  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْوَهَّابِ الْحَجَبِيُّ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ زَيْدٍ الْعَمِّيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  تَوَضَّأَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّةً مَرَّةً وَقَالَ :  هَذَا وَظِيفَةُ الْوُضُوءِ الَّذِي لَا يَقْبَلُ اللهُ صَلَاةً إِلَّا بِهِ  ، ثُمَّ تَوَضَّأَ مَرَّتَيْنِ مَرَّتَيْنِ ، وَقَالَ : "" هَذَا الْقَصْدُ مِنَ الْوُضُوءِ وَيُضَاعِفُ اللهُ الْأَجْرَ لِصَاحِبِهِ مَرَّتَيْنِ "" ، ثُمَّ تَوَضَّأَ ثَلَاثًا ثَلَاثًا ، ثُمَّ قَالَ :         [13/235]      "" هَذَا وُضُوئِي وَوُضُوءُ  خَلِيلِ  اللهِ  إِبْرَاهِيمَ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَوُضُوءُ الْأَنْبِيَاءِ مِنْ قَبْلِي صَلَوَاتُ اللهِ عَلَيْهِمْ ، وَمَنْ قَالَ بَعْدَ فَرَاغِهِ : "" أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ "" فَتَحَ اللهُ لَهُ مِنَ الْجَنَّةِ ثَمَانِيَةَ أَبْوَابٍ  .","","Al-Mu'jam al-Kabir 13968","","عبد الله بن عمر بن الخطاب عن معاوية بن قرة عن زيد بن الحواري العمي عن عبد الرحيم بن زيد بن الحواري العمي عن عبد الله بن عبد الوهاب الحجبي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14006","13969  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ وَمُوسَى بْنُ هَارُونَ قَالَا :  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  الْفُرَاتُ بْنُ أَبِي الْفُرَاتِ قَالَ :         [13/236]      سَمِعْتُ  مُعَاوِيَةَ بْنَ قُرَّةَ  يُحَدِّثُ عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ اسْتَعْمَلَ  رَجُلًا  عَلَى عَمَلٍ فَقَالَ :  يَا رَسُولَ اللهِ خِرْ لِي ، قَالَ : "" الْزَمْ بَيْتَكَ  .","","Al-Mu'jam al-Kabir 13969","","عبد الله بن عمر بن الخطاب عن معاوية بن قرة عن فرات بن أبي الفرات البصري عن سليمان بن داود العتكي عن موسى بن هارون الحمال عن الطبراني","عمرو بن دينار عن ابن عمر"
"14007","13970  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  أَبَانُ بْنُ يَزِيدَ ،  ثَنَا  أَنَسُ بْنُ سِيرِينَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  حَفِظْتُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَشْرَ رَكَعَاتٍ  : رَكْعَتَيْنِ قَبْلَ الظُّهْرِ ، وَبَعْدَهُ رَكْعَتَيْنِ ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَرَكْعَتَيْنِ بَعْدَ الْعِشَاءِ ، وَرَكْعَتَيْنِ قَبْلَ الْفَجْرِ  .","","Al-Mu'jam al-Kabir 13970","","عبد الله بن عمر بن الخطاب عن أنس بن سيرين عن أبان بن يزيد العطار عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14008","13971  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنْ  أَنَسِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ  رَجُلًا  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ صَلَاةِ اللَّيْلِ ؟ فَقَالَ : "" مَثْنَى مَثْنَى  .","","Al-Mu'jam al-Kabir 13971","","عبد الله بن عمر بن الخطاب عن أنس بن سيرين عن عبد الله بن عون بن أرطبان عن أبو عاصم النبيل عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14009","[13/237]      13972  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَنَسِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ; فَإِذَا خَشِيتَ الصُّبْحَ  فَأَوْتِرْ  بِرَكْعَةٍ  .","","Al-Mu'jam al-Kabir 13972","","عبد الله بن عمر بن الخطاب عن أنس بن سيرين عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14010","13973  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ حَبِيبِ بْنِ الشَّهِيدِ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي حَبِيبِ بْنِ الشَّهِيدِ  ،  عَنْ  أَنَسِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُصَلِّي مِنَ اللَّيْلِ مَثْنَى مَثْنَى  .","","Al-Mu'jam al-Kabir 13973","","عبد الله بن عمر بن الخطاب عن أنس بن سيرين عن حبيب بن الشهيد عن إبراهيم بن حبيب بن الشهيد عن إسحاق بن إبراهيم الشهيدي عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14011","13974  -  حَدَّثَنَا  جَعْفَرُ بْنُ أَحْمَدَ بْنِ سِنَانٍ الْوَاسِطِيُّ ،  ثَنَا  هِلَالُ بْنُ بِشْرٍ ،  ثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الضُّبَعِيُّ ،  عَنِ  النَّهَّاسِ بْنِ قَهْمٍ ،  عَنْ  أَنَسِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  أَنَا بَيْنَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَبَيْنَ  الرَّجُلِ  الَّذِي سَأَلَهُ عَنْ صَلَاةِ اللَّيْلِ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ، فَإِذَا خَشِيتَ الصُّبْحَ  فَأَوْتِرْ  بِرَكْعَةٍ  .","","Al-Mu'jam al-Kabir 13974","","عبد الله بن عمر بن الخطاب عن أنس بن سيرين عن النهاس بن قهم القيسي عن يوسف بن يعقوب بن أبي القاسم السلعي عن هلال بن بشر بن محبوب الأحدب عن جعفر بن أحمد بن سنان الواسطي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14012","13975  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  حَدَّثَنَا  بِشْرُ بْنُ         [13/238]      الْمُفَضَّلِ ،  عَنْ  سَلَمَةَ بْنِ عَلْقَمَةَ ،  عَنْ  أَنَسِ بْنِ سِيرِينَ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنِ  الْوِتْرِ  ؟ فَقَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا صَلَّى الْعِشَاءَ أَتَى فِرَاشَهُ  ، ثُمَّ يَقُومُ مِنَ اللَّيْلِ فَيُصَلِّي رَكْعَتَيْنِ رَكْعَتَيْنِ ، حَتَّى إِذَا كَانَ مِنْ آخِرِ اللَّيْلِ أَوْتَرَ بِرَكْعَةٍ ، حَتَّى إِذَا أَصْبَحَ وَطَلَعَ الْفَجْرُ صَلَّى رَكْعَتَيْنِ ، كَأَنَّ الْأَذَانَ فِي أُذُنَيْهِ  .","","Al-Mu'jam al-Kabir 13975","","عبد الله بن عمر بن الخطاب عن أنس بن سيرين عن سلمة بن علقمة التميمي عن بشر بن المفضل عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14013","13976  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  ثَنَا  أَنَسُ بْنُ سِيرِينَ ، قَالَ :  قُلْتُ  لِابْنِ عُمَرَ : أَرَأَيْتَ الرَّكْعَتَيْنِ قَبْلَ صَلَاةِ الْغَدَاةِ أُطِيلُ فِيهِمَا الْقِرَاءَةَ ؟ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي مِنَ اللَّيْلِ مَثْنَى مَثْنَى وَيُوتِرُ بِرَكْعَةٍ  . فَقُلْتُ : إِنِّي لَسْتُ عَنْ ذَلِكَ أَسْأَلُكَ ! قَالَ : إِنَّكَ لَضَخْمٌ ، أَلَا تَدَعُنِي أَسْتَقْرِئُ لَكَ الْحَدِيثَ ؟!         [13/239]      كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي مِنَ اللَّيْلِ مَثْنَى مَثْنَى وَيُوتِرُ بِرَكْعَةٍ ، وَيُصَلِّي رَكْعَتَيْنِ قَبْلَ صَلَاةِ الْغَدَاةِ ، كَأَنَّ الْأَذَانَ بِأُذُنَيْهِ  .  قَالَ  حَمَّادٌ  :  أَيْ سُرْعَةً  .","","Al-Mu'jam al-Kabir 13976","","عبد الله بن عمر بن الخطاب عن أنس بن سيرين عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14014","13977  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  حَدَّثَنِي  أَبِي ، قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي بِخَطِّهِ  :  ثَنَا  مُسْتَلِمُ بْنُ سَعِيدٍ ،  ثَنَا  مَنْصُورُ بْنُ زَاذَانَ ،  عَنْ  أَنَسِ بْنِ سِيرِينَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنِ اشْتَرَى أَوْ أُهْدِيَ إِلَيْهِ كَبْشًا فَلْيُقَسِّمْهُ         [13/240]      عَلَى ثَلَاثَةِ أَجْزَاءٍ  ، فَيُطْعِمُ كُلَّ يَوْمٍ جُزْءًا عَلَى الرِّيقِ ، إِنْ شَاءَ أَسْلَأَهُ وَإِنْ شَاءَ أَكَلَهُ  ;  يَعْنِي : أَلْيَةَ الْكَبْشِ يُتَدَاوَى بِهِ مِنْ  عِرْقِ  النَّسَا  .  قَالَ أَبُو الْقَاسِمِ :  أَسْلَأَهُ ; أَيْ : ذَوَّبَهُ  .","","Al-Mu'jam al-Kabir 13977","","عبد الله بن عمر بن الخطاب عن أنس بن سيرين عن منصور بن زاذان الثقفي عن مستلم بن سعيد الواسطي عن محمد بن أبي شيبة العبسي عن عثمان ابن أبي شيبة عن محمد بن عثمان بن أبي شيبة عن الطبراني","عمرو بن دينار عن ابن عمر"
"14015","13978  -  حَدَّثَنَا  يَحْيَى بْنُ مُحَمَّدٍ الْحِنَّائِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ         [13/241]      حِسَابٍ ،  حَدَّثَنَا  سُفْيَانُ بْنُ مُوسَى ،  ثَنَا  أَيُّوبُ ،  عَنْ  أَنَسِ بْنِ سِيرِينَ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنِ الرَّجُلِ لَيْسَ لَهُ مَالٌ ; يَشْتَرِي بِالدَّيْنِ فَيَنْوِي قَضَاءً ؟ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِكُلِّ غَادِرٍ  لِوَاءٌ  يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 13978","","عبد الله بن عمر بن الخطاب عن أنس بن سيرين عن أيوب السختياني عن سفيان بن موسى البصري عن محمد بن عبيد بن حساب الغبري عن يحيى بن محمد بن البختري الحنائي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14016","13979  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، قَالَا :  ثَنَا  شُعْبَةُ ،  حَدَّثَنِي  أَنَسُ بْنُ سِيرِينَ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  طَلَّقَ  ابْنُ عُمَرَ  امْرَأَتَهُ وَهِيَ حَائِضٌ  ، فَذَكَرَ ذَلِكَ  عُمَرُ  لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  لِيُرَاجِعْهَا ، فَإِذَا طَهُرَتْ فَلْيُطَلِّقْهَا  .         [13/242]      قُلْتُ لَهُ : أَتَحْسَبُ ؟ قَالَ : فَمَهْ . ؟ !","","Al-Mu'jam al-Kabir 13979","","عبد الله بن عمر بن الخطاب عن أنس بن سيرين عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14017","13980  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ مُسْلِمٍ ،  عَنْ  مُحَمَّدٍ وَأَنَسٍ ابْنَيْ سِيرِينَ  أَنَّ ابْنَ عُمَرَ سَأَلَهُ  رَجُلٌ  عَنِ الرَّجُلِ يُطَلِّقُ امْرَأَتَهُ وَهِيَ حَائِضٌ ؟ فَقَالَ  ابْنُ عُمَرَ  : فَعَلَ ذَلِكَ  عَبْدُ اللهِ بْنُ عُمَرَ  ، فَسَأَلَ  عُمَرُ         [13/243]      النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  بِئْسَ مَا صَنَعَ ! مُرْهُ فَلْيُرَاجِعْهَا ، فَإِذَا طَهُرَتْ فَلْيُطَلِّقْهَا إِنْ شَاءَ وَإِنْ شَاءَ فَلْيُمْسِكْهَا  .","","Al-Mu'jam al-Kabir 13980","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن أبو معاوية الضرير عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14018","13981  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  أَنَسِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عُمَرَ  أَنَّهُ طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ ، فَذَكَرَ ذَلِكَ  عُمَرُ  لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ :  مُرْهُ فَلْيُرَاجِعْهَا فَإِذَا طَهُرَتْ طَلَّقَهَا  .","","Al-Mu'jam al-Kabir 13981","","عبد الله بن عمر بن الخطاب عن أنس بن سيرين عن عبد الملك بن أبي سليمان العرزمي عن يحيى بن زكريا بن أبي زائدة عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14019","13982  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ،  وَالْوِتْرُ  رَكْعَةٌ مِنْ آخِرِ اللَّيْلِ "" .  قَالَ : وَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمَغْرِبُ  وِتْرُ  النَّهَارِ ،  فَأَوْتِرُوا  صَلَاةَ اللَّيْلِ  .","","Al-Mu'jam al-Kabir 13982","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن هشام بن حسان العتكي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14020","[13/244]      13983  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  أَخْبَرَنَا  عَبْدُ الرَّزَّاقِ ،  أَبَنَا  مَعْمَرٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ،  وَالْوِتْرُ  رَكْعَةٌ مِنْ آخِرِ اللَّيْلِ "" .  وَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمَغْرِبُ  وِتْرُ  النَّهَارِ ;  فَأَوْتِرُوا  صَلَاةَ اللَّيْلِ  .","","Al-Mu'jam al-Kabir 13983","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14021","13984  -  حَدَّثَنَا  وَرْدُ بْنُ أَحْمَدَ بْنِ لَبِيدٍ الْبَيْرُوتِيُّ ،  ثَنَا  صَفْوَانُ بْنُ صَالِحٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  سَالِمٌ الْخَيَّاطُ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ،  وَالْوِتْرُ  رَكْعَةٌ مِنْ آخِرِ اللَّيْلِ  .","","Al-Mu'jam al-Kabir 13984","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن سالم بن عبد الله الخياط عن الوليد بن مسلم القرشي عن صفوان بن صالح الدمشقي عن ورد بن أحمد بن لبيد البيروتي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14022","13985  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  ابْنُ         [13/245]      أَبِي عَدِيٍّ ،  عَنْ  يُونُسَ ،  عَنْ  مُحَمَّدٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ، فَإِذَا خَشِيتَ الصُّبْحَ  فَأَوْتِرْ  بِرَكْعَةٍ  .","","Al-Mu'jam al-Kabir 13985","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن يونس بن عبيد عن محمد بن إبراهيم بن أبي عدي القسملي عن أبو موسى الزمن عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14023","13986  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  سَمِعْتُ  أَبَا شُعَيْبٍ         [13/246]      يُحَدِّثُ عَنْ مُحَمَّدِ بْنِ سِيرِينَ وَأَنَسِ بْنِ سِيرِينَ وَنَافِعٍ أَنَّهُمْ  حَدَّثُوهُ  عَنِ  ابْنِ عُمَرَ ، قَالَ :  عَشْرُ صَلَوَاتٍ حَفِظْتُهُنَّ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  : رَكْعَتَيْنِ قَبْلَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَهَا ، [وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ] ، وَرَكْعَتَيْنِ بَعْدَ الْعِشَاءِ ، وَرَكْعَتَيْنِ قَبْلَ الْفَجْرِ  .","","Al-Mu'jam al-Kabir 13986","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن الصلت بن دينار الهنائي عن معتمر بن سليمان عن عبد الأعلى بن حماد النرسي عن محمود بن محمد بن منويه المفيد عن الطبراني","عمرو بن دينار عن ابن عمر"
"14024","13987  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ عَمْرِو بْنِ سُكَيْنٍ ،  ثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْحَضْرَمِيُّ ،  ثَنَا  الْحَكَمُ بْنُ عَطِيَّةَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ قَالَ :  حَفِظْتُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَشْرَ رَكَعَاتٍ  : رَكْعَتَيْنِ قَبْلَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَهَا ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَرَكْعَتَيْنِ بَعْدَ الْعِشَاءِ ، وَرَكْعَتَيْنِ قَبْلَ الْفَجْرِ  .","","Al-Mu'jam al-Kabir 13987","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن الحكم بن عطية العيشي عن يعقوب بن إسحاق بن زيد الحضرمي عن الوليد بن عمرو بن السكين الضبعي عن الساجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14025","13988  -  حَدَّثَنَا  الْحَسَنُ بْنُ الْعَبَّاسِ الرَّازِيُّ ،  ثَنَا  عَلِيُّ بْنُ هَاشِمِ بْنِ مَرْزُوقٍ الرَّازِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  حَفِظْتُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَبْلَ الظُّهْرِ رَكْعَتَيْنِ  ، وَبَعْدَهَا أَرْبَعًا ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَرَكْعَتَيْنِ بَعْدَ الْعِشَاءِ ، وَرَكْعَتَيْنِ قَبْلَ الْفَجْرِ  .","","Al-Mu'jam al-Kabir 13988","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن عاصم بن سليمان الأحول عن عمرو بن أبي قيس عن هاشم بن مرزوق عن علي بن هاشم بن مرزوق الرازي عن الجمال الحسن بن العباس عن الطبراني","عمرو بن دينار عن ابن عمر"
"14026","[13/247]      13989  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نُوحِ بْنِ حَرْبٍ الْعَسْكَرِيُّ ،  ثَنَا  عَمَّارُ بْنُ الْمُخْتَارِ ،  ثَنَا  أَبِي  ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  حَفِظْتُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَشْرَ رَكَعَاتٍ  : رَكْعَتَيْنِ قَبْلَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَرَكْعَتَيْنِ بَعْدَ الْعِشَاءِ ، وَرَكْعَتَيْنِ قَبْلَ الْفَجْرِ  .","","Al-Mu'jam al-Kabir 13989","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن يونس بن عبيد عن عمر بن المختار البصري عن عمار بن عمر بن المختار عن محمد بن نوح العسكري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14027","13990  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  حَدَّثَنَا  نُعَيْمُ بْنُ يَعْقُوبَ وَيَحْيَى بْنُ طَلْحَةَ الْيَرْبُوعِيُّ ، قَالَا :  ثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِأَشَجِّ عَبْدِ الْقَيْسِ  :  إِنَّ فِيكَ  خَصْلَتَيْنِ  يُحِبُّهُمَا اللهُ : الْحِلْمُ وَالْأَنَاةُ  .","","Al-Mu'jam al-Kabir 13990","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن هشام بن حسان العتكي عن الفضيل بن عياض عن يحيى بن طلحة بن أبي كثير اليربوعي عن محمد بن عثمان بن أبي شيبة عن الطبراني","عمرو بن دينار عن ابن عمر"
"14028","13991  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  هِشَامُ بْنُ         [13/248]      عَمَّارٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنِ  ابْنِ سِيرِينَ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنِ الضَّحَايَا أَوَاجِبَةٌ هِيَ ؟ فَقَالَ :  ضَحَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَالْمُسْلِمُونَ بَعْدَهُ وَجَرَتْ بِهِ السُّنَّةُ  .","","Al-Mu'jam al-Kabir 13991","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن إسماعيل بن عياش الأحول عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14029","13992  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عُثْمَانُ بْنُ سَعِيدٍ الْمُرِّيُّ ،  ثَنَا  عَلِيُّ بْنُ صَالِحٍ ،  عَنْ  عُمَرَ بْنِ رَبِيعَةَ ،  عَنِ  الْحَسَنِ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  سُئِلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْجَنَّةِ ؟ فَقَالَ :  مَنْ يَدْخُلُ الْجَنَّةَ يَحْيَا فِيهَا لَا يَمُوتُ  ، وَيَنْعَمُ فِيهَا لَا يَبْأَسُ ، لَا تَبْلَى ثِيَابُهُ وَلَا يَفْنَى شَبَابُهُ "" ، قِيلَ : يَا رَسُولَ اللهِ ، مَا بِنَاؤُهَا ؟ قَالَ : "" لَبِنَةٌ مِنْ ذَهَبٍ ، وَلَبِنَةٌ مِنْ فِضَّةٍ ،  مِلَاطُهَا  الْمِسْكُ  الْأَذْفَرُ  ، وَتُرَابُهَا الزَّعْفَرَانُ ،  حَصْبَاؤُهَا  اللُّؤْلُؤُ وَالْيَاقُوتُ  .","","Al-Mu'jam al-Kabir 13992","","عبد الله بن عمر بن الخطاب عن الحسن البصري عن أبو ربيعة الإيادي عن علي بن صالح بن حي عن عثمان بن سعيد بن مرة المكفوف عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14030","13993  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا         [13/249]      حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيمَا يَحْكِي عَنْ رَبِّهِ تَبَارَكَ وَتَعَالَى ، قَالَ :  أَيُّمَا عَبْدٍ مِنْ عِبَادِي خَرَجَ مُجَاهِدًا فِي سَبِيلِي ابْتِغَاءَ مَرْضَاتِي ضَمِنْتُ لَهُ  أَنْ أُرْجِعَهُ إِنْ رَجَعْتُهُ بِمَا أَصَابَ مِنْ أَجْرٍ أَوْ غَنِيمَةٍ أَوْ قَبَضْتُهُ غَفَرْتُ لَهُ وَرَحِمْتُهُ وَأَدْخَلْتُهُ الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 13993","","عبد الله بن عمر بن الخطاب عن الحسن البصري عن يونس بن عبيد عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14031","13994  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  أَبِي عَلِيُّ بْنُ عَاصِمٍ ،  ثَنَا  يُونُسُ بْنُ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنِ  ابْنِ         [13/250]      عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا  تَجَرَّعَ  عَبْدٌ  جَرْعَةً  أَفْضَلَ مِنْ  جَرْعَةِ  غَيْظٍ  كَظَمَهَا  ابْتِغَاءَ وَجْهِ اللهِ  .","","Al-Mu'jam al-Kabir 13994","","عبد الله بن عمر بن الخطاب عن الحسن البصري عن يونس بن عبيد عن علي بن عاصم بن صهيب عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14032","13995  -  حَدَّثَنَا  أَبُو حَنِيفَةَ مُحَمَّدُ بْنُ حَنِيفَةَ الْأَهْوَازِيُّ ،  ثَنَا  مَعْمَرُ بْنُ سَهْلٍ الْأَهْوَازِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ تَمَّامٍ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ دَعَا إِلَى هُدًى وَاتُّبِعَ عَلَيْهِ فَإِنَّ لَهُ مِثْلَ أُجُورِهِمْ مِنْ غَيْرِ أَنْ يَنْتَقِصَ مِنْ أُجُورِهِمْ شَيْئًا  ، وَمَنْ دَعَا إِلَى ضَلَالَةٍ كَانَ عَلَيْهِ مِثْلُ أَوْزَارِهِمْ مِنْ غَيْرِ أَنْ يَنْتَقِصَ مِنْ أَوْزَارِهِمْ شَيْئًا  .","","Al-Mu'jam al-Kabir 13995","","عبد الله بن عمر بن الخطاب عن الحسن البصري عن يونس بن عبيد عن عبيد الله بن تمام السلمي عن معمر بن سهل بن معمر الأهوازي عن محمد بن حنيفة القصبى عن الطبراني","عمرو بن دينار عن ابن عمر"
"14033","13996  -  حَدَّثَنَا  أَبُو حَنِيفَةَ مُحَمَّدُ بْنُ حَنِيفَةَ الْوَاسِطِيُّ ،  ثَنَا  مَعْمَرُ         [13/251]      بْنُ سَهْلٍ الْأَهْوَازِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ تَمَّامٍ ،  ثَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا يَنْبَغِي لِرَجُلٍ أَنْ يَأْتِيَ عَلَيْهِ ثَلَاثَةٌ إِلَّا وَوَصِيَّتُهُ مَكْتُوبَةٌ عِنْدَهُ  .","","Al-Mu'jam al-Kabir 13996","","عبد الله بن عمر بن الخطاب عن الحسن البصري عن يونس بن عبيد عن عبيد الله بن تمام السلمي عن معمر بن سهل بن معمر الأهوازي عن محمد بن حنيفة القصبى عن الطبراني","عمرو بن دينار عن ابن عمر"
"14034","13997  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ سَعِيدِ بْنِ كَثِيرِ بْنِ دِينَارٍ الْحِمْصِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  شُعَيْبُ بْنُ رُزَيْقٍ ،  حَدَّثَنِي  عَطَاءٌ الْخُرَاسَانِيُّ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  أَنَّهُ طَلَّقَ امْرَأَتَهُ تَطْلِيقَةً وَهِيَ حَائِضٌ ، ثُمَّ أَرَادَ أَنْ يُتْبِعَهَا تَطْلِيقَتَيْنِ أُخْرَاوَيْنِ عِنْدَ الْقُرْأَيْنِ الْبَاقِيَيْنِ ، فَبَلَغَ ذَلِكَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  يَا  ابْنَ عُمَرَ  مَا هَكَذَا أَمَرَ اللهُ ، قَدْ أَخْطَأْتَ السُّنَّةَ ،  وَالسُّنَّةُ أَنْ تَسْتَقْبِلَ الطُّهْرَ فَتُطَلِّقَ لِكُلِّ قُرْءٍ "" ، فَأَمَرَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَرَاجَعْتُهَا ، ثُمَّ قَالَ : "" إِذَا هِيَ حَاضَتْ ثُمَّ طَهُرَتْ فَطَلِّقْ عِنْدَ ذَلِكَ أَوْ أَمْسِكْ "" ، فَقُلْتُ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ لَوْ طَلَّقْتُهَا ثَلَاثًا كَانَ لِي أَنْ أُرَاجِعَهَا ؟ قَالَ : "" إِذَنْ  بَانَتْ  مِنْكَ ، وَكَانَتْ مَعْصِيَةً  .","","Al-Mu'jam al-Kabir 13997","","عبد الله بن عمر بن الخطاب عن الحسن البصري عن عطاء الخراساني عن شعيب بن رزيق المقدسي عن عثمان بن سعيد بن كثير عن يحيى بن عثمان بن سعيد الحمصي عن علي بن سعيد بن بشير عليك عن الطبراني","عمرو بن دينار عن ابن عمر"
"14035","[13/252]      13998  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  [ مُحَمَّدُ] بْنُ دِينَارٍ ،  ثَنَا  يُونُسُ بْنُ عُبَيْدٍ ،  عَنْ  زِيَادِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ بَيْعِ الْحَيَوَانِ بِالْحَيَوَانِ  نَسِيئَةً  .","","Al-Mu'jam al-Kabir 13998","","عبد الله بن عمر بن الخطاب عن زياد بن جبير الثقفي عن يونس بن عبيد عن محمد بن دينار الطاحي عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14036","[13/253]      13999  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْجُدِّيُّ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  أَيُّوبَ ،  عَنْ  زِيَادِ بْنِ جُبَيْرٍ قَالَ :  رَأَى ابْنُ عُمَرَ  رَجُلًا  يَنْحَرُ بَدَنَةً وَهِيَ بَارِكَةٌ ،  فَقَالَ : ابْعَثْهَا فَإِنَّهَا سُنَّةُ  أَبِي الْقَاسِمِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13999","","عبد الله بن عمر بن الخطاب عن زياد بن جبير الثقفي عن أيوب السختياني عن عبد الوارث بن سعيد بن ذكوان عن حفص بن عمر الحوضى عن محمد بن علي بن زيد الصائغ عن الطبراني","عمرو بن دينار عن ابن عمر"
"14037","14000  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  يُونُسُ بْنُ عُبَيْدٍ ،  عَنْ  زِيَادِ بْنِ جُبَيْرٍ قَالَ :  كُنْتُ عِنْدَ  ابْنِ عُمَرَ  فَأَتَاهُ  رَجُلٌ  ، فَقَالَ : إِنِّي نَذَرْتُ أَنْ أَصُومَ كُلَّ  ثُلَاثَاءَ أَوْ أَرْبِعَاءٍ  مَا عِشْتُ ، وَإِنِّي وَافَقْتُ هَذَا الْيَوْمَ يَوْمَ النَّحْرِ ؟  فَقَالَ  ابْنُ عُمَرَ :  قَدْ أَمَرَ اللهُ بِوَفَاءِ النَّذْرِ ، وَنُهِينَا أَنْ نَصُومَ هَذَا الْيَوْمَ  .","","Al-Mu'jam al-Kabir 14000","","عبد الله بن عمر بن الخطاب عن زياد بن جبير الثقفي عن يونس بن عبيد عن يزيد بن زريع العيشي عن محمد بن المنهال عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمرو بن دينار عن ابن عمر"
"14038","[13/254]      14001  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْمِنْهَالُ بْنُ بَحْرٍ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنْ  زِيَادِ بْنِ جَابِرٍ أَوْ جَابِرِ بْنِ زِيَادٍ  ،  شَكَّ  ابْنُ عَوْنٍ  ،  أَنَّ  امْرَأَةً  أَتَتِ  ابْنَ عُمَرَ  يَوْمَ خَمِيسٍ ، فَقَالَتْ : إِنِّي نَذَرْتُ أَنْ أَصُومَ كُلَّ خَمِيسٍ فَوَافَقَ ذَلِكَ الْيَوْمَ الْعِيدُ أَفَأَصُومُهُ ؟ فَقَالَ لَهَا ابْنُ عُمَرَ :  أَمَرَنَا اللهُ بِوَفَاءِ النَّذْرِ ، وَنَهَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ صَوْمِ هَذَا الْيَوْمِ  .","","Al-Mu'jam al-Kabir 14001","","عبد الله بن عمر بن الخطاب عن زياد بن جبير الثقفي عن عبد الله بن عون بن أرطبان عن المنهال بن بحر القشيري عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14039","14002  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى الْعَنْبَرِيُّ ،  ثَنَا  أَبِي ،  ثَنَا  أَبِي  ،  ثَنَا  قُرَّةُ بْنُ خَالِدٍ ،  عَنْ  مَعْرُوفِ بْنِ بَشِيرٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ نَبِيذِ  الدُّبَّاءِ  وَالْحَنْتَمِ  .","","Al-Mu'jam al-Kabir 14002","","عبد الله بن عمر بن الخطاب عن معروف بن بشير عن قرة بن خالد السدوسي عن معاذ بن معاذ بن نصر عن المثنى بن معاذ بن معاذ العنبري عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14040","14003  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  سَهْلُ بْنُ بَكَّارٍ ،  ثَنَا  أَبَانُ         [13/255]      بْنُ يَزِيدَ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ بَابِي ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فِي  التَّشَهُّدِ  : ""  التَّحِيَّاتُ  الطَّيِّبَاتُ الصَّلَوَاتُ لِلهِ  ، السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ ، السَّلَامُ عَلَيْنَا وَعَلَى عِبَادِ اللهِ الصَّالِحِينَ ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَشْهَدُ أَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ  .","","Al-Mu'jam al-Kabir 14003","","عبد الله بن عمر بن الخطاب عن عبد الله بن باباه البصري عن قتادة بن دعامة عن أبان بن يزيد العطار عن سهل بن بكار الدارمي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14041","14004  -  حَدَّثَنَا  أَحْمَدُ بْنُ بَشِيرٍ  الطَّيَالِسِيُّ ،  ثَنَا  نُوحُ بْنُ حَبِيبٍ الْقُومَسِيُّ ،  ثَنَا  أَزْهَرُ بْنُ الْقَاسِمِ ،  عَنِ  الْمُثَنَّى بْنِ سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ بَابِي ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ  .  كذا في طبعة الجريسي وأكثر المواضع في كتب المصنف ، المعاجم وغيرها ، وكذا هو في لسان الميزان ، وقال محقق تهذيب الكمال 24 / 581 : ""جاء في حواشي النسخ تعقيب للمؤلف على صاحب الكمال نصه : ""كان فيه : أحمد بن بشر وهو خطأ "". والذي في تاريخ بغداد وتاريخ الإسلام : (بشر) فالله أعلم .","","Al-Mu'jam al-Kabir 14004","","عبد الله بن عمر بن الخطاب عن عبد الله بن باباه البصري عن قتادة بن دعامة عن المثنى بن سعيد القسام عن أزهر بن القاسم الراسبي عن نوح بن حبيب القومسي عن أحمد بن بشر الطيالسى عن الطبراني","عمرو بن دينار عن ابن عمر"
"14042","14005  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقُطَعِيُّ ،  ثَنَا  رَوْحُ بْنُ عَطَاءِ بْنِ أَبِي مَيْمُونَةَ ،  ثَنَا  غِيلَانُ مَوْلَى عُثْمَانَ بْنِ عَفَّانَ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فِي الْمَسْحِ عَلَى الْخُفَّيْنِ : يَوْمٌ وَلَيْلَةٌ لِلْمُقِيمِ  ، وَثَلَاثَةُ أَيَّامٍ وَلَيَالِيهِنَّ لِلْمُسَافِرِ  .","","Al-Mu'jam al-Kabir 14005","","عبد الله بن عمر بن الخطاب عن غيلان القدري بن أبي غيلان عن روح بن عطاء بن أبي ميمونة البصري عن محمد بن يحيى بن أبي حزم القطعي عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14043","14006  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ .         [13/256]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ قَالَا :  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الصِّدِّيقِ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا وَضَعْتُمْ مَوْتَاكُمْ فِي قُبُورِهِمْ ، فَقُولُوا  : بِاسْمِ اللهِ وَعَلَى سُنَّةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 14006","","عبد الله بن عمر بن الخطاب عن بكر بن عمرو الناجي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","عمرو بن دينار عن ابن عمر"
"14044","14007  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  ثَنَا  قَتَادَةُ ،  عَنْ  أَبِي الصِّدِّيقِ  أَنَّ  ابْنَ عُمَرَ كَانَ إِذَا وُضِعَ الْمَيِّتُ فِي الْقَبْرِ قَالَ :  بِاسْمِ اللهِ وَعَلَى سُنَّةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 14007","","عبد الله بن عمر بن الخطاب عن بكر بن عمرو الناجي عن قتادة بن دعامة عن هشام الدستوائي عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14045","[13/257]      14008  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الصِّدِّيقِ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  إِذَا وَضَعْتُمُ الْمَيِّتَ فِي قَبْرِهِ ، فَقُولُوا : بِاسْمِ اللهِ  وَعَلَى سُنَّةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 14008","","عبد الله بن عمر بن الخطاب عن بكر بن عمرو الناجي عن قتادة بن دعامة عن شعبة بن الحجاج عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","عمرو بن دينار عن ابن عمر"
"14046","14009  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  أَبَانُ بْنُ يَزِيدَ ،  ثَنَا  قَتَادَةُ .  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ،  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ .         [13/258]      وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ .         [13/259]      وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  الْعَبَّاسُ بْنُ طَالِبٍ قَالَا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ وَهِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  قَتَادَةَ ،  عَنْ  صَفْوَانَ بْنِ مُحْرِزٍ الْمَازِنِيِّ قَالَ :  بَيْنَمَا أَنَا أَمْشِي مَعَ ابْنِ عُمَرَ إِذْ عَرَضَ لَهُ  رَجُلٌ  ، فَقَالَ : كَيْفَ سَمِعْتَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ فِي  النَّجْوَى  ؟ قَالَ : سَمِعْتُهُ يَقُولُ :  يَدْنُو الْمُؤْمِنُ مِنْ رَبِّهِ تَبَارَكَ وَتَعَالَى حَتَّى يَضَعَ  كَنَفَهُ  عَلَى  كَنَفِهِ  ،         [13/260]      وَيُقَالُ لَهُ : تَعْرِفُ كَذَا وَكَذَا ؟ فَيَقُولُ : نَعَمْ ، فَيَقُولُ : فَإِنِّي سَتَرْتُهَا عَلَيْكَ فِي الدُّنْيَا وَإِنِّي أَغْفِرُهَا لَكَ الْيَوْمَ . فَيُعْطَى صَحِيفَةَ حَسَنَاتِهِ . وَأَمَّا الْكَافِرُ وَالْمُنَافِقُ فَيُنَادَى بِهِمْ عَلَى رُؤُوسِ الْأَشْهَادِ :         {      هَؤُلاءِ الَّذِينَ كَذَبُوا عَلَى رَبِّهِمْ أَلا لَعْنَةُ اللهِ عَلَى الظَّالِمِينَ         }      .  وَاللَّفْظُ لِحَدِيثِ  مُسْلِمٍ  عَنْ  أَبَانَ  وَالْآخَرُونَ نَحْوُهُ  .","","Al-Mu'jam al-Kabir 14009","","عبد الله بن عمر بن الخطاب عن صفوان بن محرز المازني عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14047","14010  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  صَفْوَانَ بْنِ مُحْرِزٍ قَالَ :         [13/261]      سَأَلْتُ  ابْنَ عُمَرَ عَنِ الصَّلَاةِ فِي السَّفَرِ ؟ قَالَ : رَكْعَتَانِ  ، مَنْ خَالَفَ السُّنَّةَ كَفَرَ  .","","Al-Mu'jam al-Kabir 14010","","عبد الله بن عمر بن الخطاب عن صفوان بن محرز المازني عن قتادة بن دعامة عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن عثمان بن عمر الضبي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14048","14011  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  يَزِيدُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  مُحَمَّدُ بْنُ سِيرِينَ ،  ثَنَا  يُونُسُ بْنُ جُبَيْرٍ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ  ؟ فَقَالَ : تَعْرِفُ  عَبْدَ اللهِ بْنَ عُمَرَ ؟  ! قُلْتُ : نَعَمْ ، قَالَ : فَإِنَّ  عَبْدَ اللهِ بْنَ عُمَرَ  طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ ، فَأَتَى  عُمَرُ بْنُ الْخَطَّابِ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَأَلَهُ ؟  فَأَمَرَهُ أَنْ يُرَاجِعَهَا ثُمَّ يُطَلِّقَهَا فِي  قُبُلِ  عِدَّتِهَا  ، قُلْتُ : فَيَعْتَدُّ بِهَا ؟ قَالَ : نَعَمْ أَرَأَيْتَ إِنْ عَجَزَ وَحَمُقَ . ؟!","","Al-Mu'jam al-Kabir 14011","","عبد الله بن عمر بن الخطاب عن يونس بن جبير الباهلي عن محمد بن سيرين عن يزيد بن إبراهيم التستري عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14049","[13/262]      14012  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،         [13/263]      حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ وَسَلَمَةَ بْنِ عَلْقَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَبِي غَلَّابٍ يُونُسَ بْنِ جُبَيْرٍ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ  ؟ فَقَالَ : تَعْرِفُ  عَبْدَ اللهِ بْنَ عُمَرَ  ؟! فَإِنَّهُ طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ ،  فَسَأَلَ  عُمَرُ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَمَرَهُ أَنْ يُرَاجِعَهَا  ، قُلْتُ :  احْتَسَبَ  ؟ قَالَ :  فَمَهْ  ؟! أَرَأَيْتَ إِنْ عَجَزَ  وَاسْتَحْمَقَ .  ؟!","","Al-Mu'jam al-Kabir 14012","","عبد الله بن عمر بن الخطاب عن يونس بن جبير الباهلي عن محمد بن سيرين عن سلمة بن علقمة التميمي عن حماد بن زيد عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14050","14013  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَيُّوبَ ،  عَنِ  ابْنِ سِيرِينَ قَالَ :  مَكَثْتُ عِشْرِينَ سَنَةً أَسْمَعُ أَنَّ ابْنَ عُمَرَ طَلَّقَ امْرَأَتَهُ الَّتِي طَلَّقَ عَلَى عَهْدِ النَّبِيِّ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهِيَ حَائِضٌ ثَلَاثًا ، حَتَّى  أَخْبَرَنِي  يُونُسُ بْنُ جُبَيْرٍ أَنَّهُ سَأَلَهُ ،  فَقَالَ  : كَمْ كُنْتَ طَلَّقْتَ امْرَأَتَكَ عَلَى عَهْدِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ : وَاحِدَةً  .","","Al-Mu'jam al-Kabir 14013","","عبد الله بن عمر بن الخطاب عن يونس بن جبير الباهلي عن محمد بن سيرين عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14051","[13/264]      14014  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَاصِمٍ ،  عَنِ  ابْنِ سِيرِينَ قَالَ :  سُئِلَ ابْنُ عُمَرَ : هَلِ  احْتَسَبْتَ  بِهَا ؟  يَعْنِي التَّطْلِيقَةَ  الَّتِي طَلَّقَهَا وَهِيَ حَائِضٌ  فَقَالَ  : وَمَا يَمْنَعُهُنَّ إِنْ كُنْتَ عَجَزْتَ  وَاسْتَحْمَقْتَ  ؟!  .  لَمْ يَذْكُرِ  الثَّوْرِيُّ  فِي حَدِيثِهِ عَنْ  عَاصِمٍ يُونُسَ بْنَ جُبَيْرٍ  وَجَوَّدَهُ  عَمْرُو بْنُ أَبِي قَيْسٍ  .","","Al-Mu'jam al-Kabir 14014","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن عاصم بن بهدلة عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14052","14015  -  حَدَّثَنَا  الْحَسَنُ بْنُ الْعَبَّاسِ الرَّازِيُّ ،  ثَنَا  عَلِيُّ بْنُ هَاشِمِ بْنِ مَرْزُوقٍ ،  ثَنَا  أَبِي  ،  عَنْ  عَمْرِو بْنِ أَبِي قَيْسٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  يُونُسَ أَبِي غَلَّابٍ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنِ الرَّجُلِ يُطَلِّقُ امْرَأَتَهُ وَهِيَ حَائِضٌ  ؟ فَقَالَ : أَتَعْرِفُ  ابْنَ عُمَرَ  ؟! قُلْتُ : نَعَمْ ، قَالَ : فَإِنِّي طَلَّقْتُ امْرَأَتِي وَهِيَ حَائِضٌ  فَأَتَى  عُمَرُ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ ذَلِكَ لَهُ ؟ فَقَالَ :  فَلْيُرَاجِعْهَا حَتَّى تَطْهُرَ فَلْيُطَلِّقْهَا أَوْ لِيُمْسِكْ  .","","Al-Mu'jam al-Kabir 14015","","عبد الله بن عمر بن الخطاب عن يونس بن جبير الباهلي عن محمد بن سيرين عن عاصم بن سليمان الأحول عن عمرو بن أبي قيس عن هاشم بن مرزوق عن علي بن هاشم بن مرزوق الرازي عن الجمال الحسن بن العباس عن الطبراني","عمرو بن دينار عن ابن عمر"
"14053","14016  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا         [13/265]      إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  يُونُسَ بْنِ جُبَيْرٍ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنْ رَجُلٍ يُطَلِّقُ امْرَأَتَهُ وَهِيَ حَائِضٌ  ؟ فَقَالَ : أَتَعْرِفُ  عَبْدَ اللهِ بْنَ عُمَرَ  ؟! قُلْتُ : نَعَمْ ، قَالَ : فَإِنَّهُ طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ ، فَأَتَى  عُمَرُ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَأَلَهُ ؟  فَأَمَرَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يُرَاجِعَهَا ثُمَّ يُطَلِّقَهَا فَتَسْتَقْبِلَ عِدَّتَهَا  .","","Al-Mu'jam al-Kabir 14016","","عبد الله بن عمر بن الخطاب عن يونس بن جبير الباهلي عن محمد بن سيرين عن يونس بن عبيد عن إسماعيل ابن علية عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"14054","14017  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي غَلَّابٍ يُونُسَ بْنِ جُبَيْرٍ ، قَالَ :  قُلْتُ لِابْنِ عُمَرَ رَجُلٌ طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ  ؟  فَقَالَ  : تَعْرِفُ  ابْنَ عُمَرَ  ؟! إِنَّ  ابْنَ عُمَرَ  طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ ، فَأَتَى  عُمَرُ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ ذَلِكَ لَهُ ؟  فَأَمَرَهُ أَنْ يُرَاجِعَهَا ، فَإِذَا طَهُرَتْ فَأَرَادَ أَنْ يُطَلِّقَهَا فَلْيُطَلِّقْهَا  .  قُلْتُ : فَهَلْ عَدَّ ذَلِكَ طَلَاقًا ؟ قَالَ : أَرَأَيْتَ إِنْ عَجَزَ  وَاسْتَحْمَقَ  ؟!  .","","Al-Mu'jam al-Kabir 14017","","عبد الله بن عمر بن الخطاب عن يونس بن جبير الباهلي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14055","14018  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،         [13/266]      ثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  ثَنَا  قَتَادَةُ ،  عَنْ  يُونُسَ بْنِ جُبَيْرٍ  أَنَّ  رَجُلًا  سَأَلَ ابْنَ عُمَرَ ، عَنْ رَجُلٍ طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ ؟  فَقَالَ  : تَعْرِفُ  ابْنَ عُمَرَ  ؟! طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ فَسَأَلَ  عُمَرُ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ ؟ فَقَالَ :  تُمْسِكُ عَلَيْكَ فَإِذَا طَهُرَتْ فَإِنْ شَاءَ أَمْسَكَ وَإِنْ شَاءَ طَلَّقَ  .  قُلْتُ : تَعْتَدُّ بِتِلْكَ التَّطْلِيقَةِ ؟ قَالَ :  فَمَهْ  ؟! أَرَأَيْتَ إِنْ عَجَزَ أَوْ حَمُقَ . ؟!","","Al-Mu'jam al-Kabir 14018","","عبد الله بن عمر بن الخطاب عن يونس بن جبير الباهلي عن قتادة بن دعامة عن هشام الدستوائي عن مسلم بن إبراهيم الشحام عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14056","14019  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ .  وَحَدَّثَنَا  دُرَّانُ بْنُ سُفْيَانَ الْعَطَّارُ الْبَصْرِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ .         [13/267]      وَحَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْخُزَاعِيُّ الْأَصْبَهَانِيُّ وَمُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ ، قَالَا :  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ .  قَالُوا :  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  يُونُسَ بْنِ جُبَيْرٍ  أَنَّ  ابْنَ عُمَرَ طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ  ، فَذَكَرَ  عُمَرُ  ذَلِكَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  مُرْهُ فَلْيُرَاجِعْهَا ، فَإِذَا طَهُرَتْ فَلْيُطَلِّقْهَا إِنْ شَاءَ  .  قُلْتُ : أَتَحْتَسِبُهَا ؟ قَالَ :  فَمَهْ ،  أَرَأَيْتَ إِنْ عَجَزَ  وَاسْتَحْمَقَ  ؟!  .","","Al-Mu'jam al-Kabir 14019","","عبد الله بن عمر بن الخطاب عن يونس بن جبير الباهلي عن قتادة بن دعامة عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن محمد بن معاذ بن سفيان العنزي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14057","14020  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  أَبُو مَرْيَمَ عَبْدُ الْغَفَّارِ بْنُ الْقَاسِمِ ،  حَدَّثَنِي  قَتَادَةُ ،  ثَنَا  يُونُسُ بْنُ جُبَيْرٍ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَهُ تَطْلِيقَةً وَهِيَ حَائِضٌ  ؟ فَقَالَ : أَتَعْرِفُ  عَبْدَ اللهِ بْنَ عُمَرَ  ؟! قُلْتُ : نَعَمْ ، قَالَ : إِنَّهُ طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ فَأَتَى  عُمَرُ بْنُ الْخَطَّابِ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَأَلَهُ ؟  وَأَمَرَهُ أَنْ يُرَاجِعَهَا حَتَّى تَطْهُرَ فَإِنْ شَاءَ أَمْسَكَ وَإِنْ شَاءَ طَلَّقَ  .","","Al-Mu'jam al-Kabir 14020","","عبد الله بن عمر بن الخطاب عن يونس بن جبير الباهلي عن قتادة بن دعامة عن عبد الغفار بن القاسم الأنصاري عن إسماعيل بن عمرو البجلي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","عمرو بن دينار عن ابن عمر"
"14058","14021  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ التُّسْتَرِيُّ ،  ثَنَا  طَاهِرُ بْنُ خَالِدِ بْنِ نِزَارٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنِ  الْحَجَّاجِ بْنِ الْحَجَّاجِ ،  عَنْ  قَتَادَةَ ،  عَنْ  يُونُسَ بْنِ جُبَيْرٍ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ  ؟ قَالَ : فَإِنَّهُ طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ ،         [13/268]      فَأَتَى عُمَرُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ ذَلِكَ لَهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِيُرَاجِعْهَا فَإِذَا طَهُرَتْ فَلْيُطَلِّقْهَا إِنْ شَاءَ  .  قُلْتُ لَهُ : وَكَانَتْ تَطْلِيقَةً ؟ قَالَ : نَعَمْ ، أَرَأَيْتَ إِنْ عَجَزَ  ابْنُ عُمَرَ  وَاسْتَحْمَقَ  ؟!  .","","Al-Mu'jam al-Kabir 14021","","عبد الله بن عمر بن الخطاب عن يونس بن جبير الباهلي عن قتادة بن دعامة عن حجاج بن حجاج الباهلي الأحول عن إبراهيم بن طهمان عن خالد بن نزار عن طاهر بن خالد بن نزار الأيلي عن سعيد بن عبد الرحمن التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14059","14022  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ عِيسَى الْخَزَّازُ ،  عَنْ  يَحْيَى الْبَكَّاءِ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ  حَبَشِيًّا  دُفِنَ  بِالْمَدِينَةِ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  دُفِنَ بِالطِّينَةِ الَّتِي خُلِقَ مِنْهَا  .","","Al-Mu'jam al-Kabir 14022","","عبد الله بن عمر بن الخطاب عن يحيى بن مسلم الحداني عن عبد الله بن عيسى بن خالد الخزاز عن عقبة بن مكرم عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"14060","14023  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُوسَى الْحَرَشِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عِيسَى ،  عَنْ  يَحْيَى الْبَكَّاءِ  أَنَّهُ سَمِعَ  ابْنَ عُمَرَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ  رَاحَ  مِنْكُمْ إِلَى الْجُمُعَةِ فَلْيَغْتَسِلْ  .","","Al-Mu'jam al-Kabir 14023","","عبد الله بن عمر بن الخطاب عن يحيى بن مسلم الحداني عن عبد الله بن عيسى بن خالد الخزاز عن محمد بن موسى الحرشي عن الساجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14061","[13/269]      14024  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  نُعَيْمُ بْنُ يَعْقُوبَ ،  ثَنَا  عَبْدُ الْعَزِيزِ النَّرْمَقِيُّ ،  عَنْ  يَحْيَى الْبَكَّاءِ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  تَجَشَّأَ  رَجُلٌ  عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  اقْصُرْ عَنَّا جُشَاءَكَ  ، فَإِنَّ أَكْثَرَهُمْ شِبَعًا فِي الدُّنْيَا أَطْوَلُهُمْ جُوعًا يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 14024","","عبد الله بن عمر بن الخطاب عن يحيى بن مسلم الحداني عن عبد العزيز بن عبد الله النرمقي عن نعيم بن يعقوب الكوفي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14062","14025  -  حَدَّثَنَا  حَبَابُ بْنُ صَالِحٍ الْوَاسِطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حَرْبٍ النَّسَائِيُّ  ،  ثَنَا  عَلِيُّ بْنُ عَاصِمٍ ،  ثَنَا  يَحْيَى الْبَكَّاءُ ،  حَدَّثَنِي  ابْنُ عُمَرَ قَالَ :  أَرَادَتْ  ضُبَاعَةُ بِنْتُ الزُّبَيْرِ  الْحَجَّ  ، فَقَالَ لَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         [13/270]      حُجِّي وَقَوْلِي : مَحِلِّي حَيْثُ حَبَسْتَنِي  .  كذا في طبعة الجريسي ، والصواب : (النشائي ) .","","Al-Mu'jam al-Kabir 14025","","عبد الله بن عمر بن الخطاب عن يحيى بن مسلم الحداني عن علي بن عاصم بن صهيب عن محمد بن حرب النشائي عن حباب الواسطي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14063","14026  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  يَحْيَى الْبَكَّاءِ قَالَ :  قُلْتُ لِابْنِ عُمَرَ : إِنَّا نَدْخُلُ عَلَى الْأُمَرَاءِ  فَنُقَرِّظُهُمْ  ، فَإِذَا خَرَجْنَا مِنْ عِنْدِهِمْ قُلْنَا غَيْرَ ذَلِكَ ؟  فَقَالَ  :  كُنَّا نَعُدُّ هَذَا نِفَاقًا عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 14026","","عبد الله بن عمر بن الخطاب عن يحيى بن مسلم الحداني عن حماد بن سلمة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14064","14027  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ ،  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ وَبِشْرِ بْنِ         [13/271]      الْمُحْتَفِزِ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْحَرِيرُ ثِيَابُ مَنْ لَا  خَلَاقَ  لَهُ  .","","Al-Mu'jam al-Kabir 14027","","عبد الله بن عمر بن الخطاب عن بكر بن عبد الله المزني عن قتادة بن دعامة عن شعبة بن الحجاج عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","عمرو بن دينار عن ابن عمر"
"14065","14028  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  عُمَرُ بْنُ الْمُغِيرَةِ ،  ثَنَا  غَالِبٌ الْقَطَّانُ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كُنَّا نَقُولُ لِقَاتِلِ الْمُؤْمِنِ إِذَا مَاتَ : إِنَّهُ فِي النَّارِ  ، وَنَقُولُ لِمَنْ أَصَابَ كَبِيرَةً مَاتَ عَلَيْهَا : إِنَّهُ فِي النَّارِ ، حَتَّى أُنْزِلَتْ هَذِهِ الْآيَةُ         {      إِنَّ اللهَ لا يَغْفِرُ أَنْ يُشْرَكَ بِهِ وَيَغْفِرُ مَا دُونَ ذَلِكَ لِمَنْ يَشَاءُ         }      ، فَلَمْ نُوجِبْ لَهُمْ كُنَّا نَرْجُو لَهُمْ وَنَخَافُ عَلَيْهِمْ  .","","Al-Mu'jam al-Kabir 14028","","عبد الله بن عمر بن الخطاب عن بكر بن عبد الله المزني عن غالب بن خطاف القطان عن مغني المساكين عمر بن المغيرة عن عبد الله بن يوسف التنيسي عن يحيى بن عثمان بن صالح عن الطبراني","عمرو بن دينار عن ابن عمر"
"14066","[13/272]      14029  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ،  ثَنَا  [سُرَيْجُ] بْنُ النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ وَبَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى الظُّهْرَ وَالْعَصْرَ وَالْمَغْرِبَ وَالْعِشَاءَ ، ثُمَّ هَجَعَ هَجْعَةً  ، ثُمَّ دَخَلَ فَطَافَ  بِالْبَيْتِ  يَعْنِي : بِالْمُحَصَّبِ  .","","Al-Mu'jam al-Kabir 14029","","عبد الله بن عمر بن الخطاب عن بكر بن عبد الله المزني عن أيوب السختياني عن حماد بن سلمة عن سريج بن النعمان الجوهري عن لحية الليف محمد بن العباس عن الطبراني","عمرو بن دينار عن ابن عمر"
"14067","14030  -  حَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ دَاوُدَ الْحَرَّانِيُّ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  ثَنَا  أَيُّوبُ وَهِشَامُ بْنُ حَسَّانَ وَعُبَيْدُ اللهِ بْنُ عُمَرَ وَحَبِيبُ بْنُ الشَّهِيدِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ  وَعَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [13/273]      كَانَ يَقُولُ :  لَبَّيْكَ  اللَّهُمَّ  لَبَّيْكَ ،  لَبَّيْكَ  لَا شَرِيكَ لَكَ  لَبَّيْكَ  ، إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ وَالْمُلْكَ ، لَا شَرِيكَ لَكَ  .","","Al-Mu'jam al-Kabir 14030","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن حبيب بن الشهيد عن حماد بن سلمة عن عبد العزيز بن داود الراذاني عن أبو شعيب الحراني عن الطبراني","عمرو بن دينار عن ابن عمر"
"14068","[13/274]      14031  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  سَعِيدُ بْنُ أَبِي الرَّبِيعِ ،  ثَنَا  صَالِحٌ الْمُرِّيُّ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا لَبَّى قَالَ :  لَبَّيْكَ  اللَّهُمَّ  لَبَّيْكَ ،  لَبَّيْكَ  لَا شَرِيكَ لَكَ  لَبَّيْكَ  ، إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ وَالْمُلْكَ ، لَا شَرِيكَ لَكَ  .","","Al-Mu'jam al-Kabir 14031","","عبد الله بن عمر بن الخطاب عن بكر بن عبد الله المزني عن صالح بن بشير المري عن سعيد بن أبى الربيع السمان عن إبراهيم بن هاشم البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14069","14032  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُعَلَّى بْنُ أَسَدٍ الْعَمِّيُّ .  وَحَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ قَالَا :  ثَنَا  عُبَيْسُ بْنُ مَيْمُونٍ ،  ثَنَا  بَكْرُ بْنُ عَبْدِ اللهِ الْمُزَنِيُّ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَثَلُ أُمَّتِي مَثَلُ الْمَطَرِ  لَا يُدْرَى أَوَّلُهُ خَيْرٌ أَمْ آخِرُهُ  .","","Al-Mu'jam al-Kabir 14032","","عبد الله بن عمر بن الخطاب عن بكر بن عبد الله المزني عن عبيس بن ميمون التيمي عن سعيد بن منصور عن بشر بن موسى بن صالح الأسدي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14070","[13/275]      14033  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  الْحَسَنُ بْنُ قَزَعَةَ ،  ثَنَا  سُفْيَانُ بْنُ حَبِيبٍ ،  عَنْ  حُمَيْدٍ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اسْتَمْتِعُوا مِنْ هَذَا  الْبَيْتِ  فَإِنَّهُ قَدْ هُدِمَ مَرَّتَيْنِ  ، وَيُرْفَعُ فِي الثَّالِثَةِ  .","","Al-Mu'jam al-Kabir 14033","","عبد الله بن عمر بن الخطاب عن بكر بن عبد الله المزني عن حميد الطويل عن سفيان بن حبيب البصري عن الحسن بن قزعة الخلقاني عن الساجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14071","14034  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  حُمَيْدُ بْنُ مَسْعَدَةَ ،  ثَنَا         [13/276]      سُفْيَانُ بْنُ حَبِيبٍ ،  عَنْ  حُمَيْدٍ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  مِنَ السُّنَّةِ أَنْ يَغْتَسِلَ عِنْدَ إِحْرَامِهِ  وَعِنْدَ مَدْخَلِ  مَكَّةَ  .","","Al-Mu'jam al-Kabir 14034","","عبد الله بن عمر بن الخطاب عن بكر بن عبد الله المزني عن حميد الطويل عن سفيان بن حبيب البصري عن حميد السامي عن موسى بن هارون الحمال عن الطبراني","عمرو بن دينار عن ابن عمر"
"14072","14035  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَزْهَرُ بْنُ جَمِيلٍ ،  ثَنَا  أَبُو بَحْرٍ الْبَكْرَاوِيُّ ،  عَنْ  حُمَيْدٍ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  غُسْلُ يَوْمِ الْجُمُعَةِ سُنَّةٌ  .","","Al-Mu'jam al-Kabir 14035","","عبد الله بن عمر بن الخطاب عن بكر بن عبد الله المزني عن حميد الطويل عن أبو بحر البكراوي عن أزهر بن جميل الشطي عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14073","14036  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ اللهِ بْنُ الْوَلِيدِ الْعَدَنِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  جَهْضَمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بَدْرٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  خَرَجْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَمْ يَحْلِلْ  وَمَعَ  أَبِي بَكْرٍ  وَعُمَرَ  وَعُثْمَانَ  فَلَمْ يَحِلُّوا  .","","Al-Mu'jam al-Kabir 14036","","عبد الله بن عمر بن الخطاب عن عبد الله بن بدر بن عميرة السحيمي عن جهضم بن عبد الله القيسي عن سفيان الثوري عن عبد الله بن الوليد بن ميمون العدني عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"14074","[13/277]      14037  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  مُسْلِمٍ الْقُرِّيِّ قَالَ :  سَمِعْتُ  رَجُلًا  سَأَلَ ابْنَ عُمَرَ ،  فَقَالَ  : أَرَأَيْتَ الْوَتْرَ أَسُنَّةٌ هُوَ ؟ قَالَ : سُنَّةٌ ؟!  قَدْ أَوْتَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَالْمُسْلِمُونَ  .","","Al-Mu'jam al-Kabir 14037","","عبد الله بن عمر بن الخطاب عن مسلم بن مخراق القطان عن عبد الله بن عون بن أرطبان عن بشر بن المفضل عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14075","14038  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  دُحَيْمٌ [عَبْدُ الرَّحْمَنِ] بْنُ عَبَّادِ بْنِ إِسْمَاعِيلَ الْمَعْوَلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مَرْوَانَ الْعُقَيْلِيُّ ،  ثَنَا  خَالِدُ بْنُ الْحَذَّاءِ ،  عَنْ  أَبِي الْمُعَذَّلِ  أَنَّ  رَجُلًا  جَاءَ إِلَى قَوْمٍ وَهُمْ يُصَلُّونَ وَابْنُ عُمَرَ جَالِسٌ خَلْفَهُمْ عَلَى شَيْءٍ ، فَقَالَ : يَا  أَبَا         [13/278]      عَبْدِ الرَّحْمَنِ  مَا مَنَعَكَ أَنْ تُصَلِّيَ ؟ قَالَ :  إِنِّي قَدْ صَلَّيْتُ وَقَدْ نُهِينَا أَنْ نُصَلِّيَ فِي يَوْمٍ مَرَّتَيْنِ  .","","Al-Mu'jam al-Kabir 14038","","عبد الله بن عمر بن الخطاب عن عطية الطفاوي عن خالد الحذاء عن محمد بن مروان بن قدامة العجلي عن دحيم عن الحسن بن علي بن شبيب المعمري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14076","14039  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،  ثَنَا  أَبُو مَعْشَرٍ الْبَرَّاءُ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  حَدَّثَنِي  أَبُو عَبْدِ السَّلَامِ قَالَ :  قُلْتُ لِابْنِ عُمَرَ : كَيْفَ كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَعْتَمُّ ؟ قَالَ :  كَانَ يُدِيرُ كَوْرَ الْعِمَامَةِ عَلَى رَأْسِهِ وَيَغْرِزُهَا مِنْ وَرَائِهِ وَيُرْسِلُهَا بَيْنَ كَتِفَيْهِ  .","","Al-Mu'jam al-Kabir 14039","","عبد الله بن عمر بن الخطاب عن أبو عبد السلام ، عن ابن عمر عن خالد الحذاء عن يوسف بن يزيد البراء عن فضيل بن حسين الجحدري عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14077","[13/279]      14040  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ .  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  ثَنَا  بَكَّارُ بْنُ سُقَيْرٍ ،  حَدَّثَنِي  أَبِي سُقَيْرٌ  ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ قَالَ :  وَقَدْ لَقِيَهُ أَبِي  بِمَكَّةَ  قَالَ : خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ يَوْمٍ مِنْ مَنْزِلِهِ وَمَعَهُ أُنَاسٌ مِنْ أَصْحَابِهِ ، فَأَخَذَ فِي بَعْضِ طُرُقِ  الْمَدِينَةِ  ، فَمَرَّ بِفِنَاءِ قَوْمٍ وَسَخْلَةٌ مَيْتَةٌ مَطْرُوحَةٌ بِفِنَائِهِمْ ، فَقَامَ عَلَيْهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَنَظَرَ إِلَيْهَا ، ثُمَّ الْتَفَتَ إِلَى أَصْحَابِهِ ، فَقَالَ : "" تَرَوْنَ هَذِهِ السَّخْلَةَ هَانَتْ عَلَى أَهْلِهَا إِذْ طَرَحُوهَا هَكَذَا ؟ ! "" قَالُوا : نَعَمْ يَا رَسُولَ اللهِ ، قَالَ :  فَوَاللهِ لَلدُّنْيَا أَهْوَنُ عَلَى اللهِ مِنْ هَذِهِ السَّخْلَةِ عَلَى أَهْلِهَا  .","","Al-Mu'jam al-Kabir 14040","","عبد الله بن عمر بن الخطاب عن سقير العبدي عن بكار بن سقير المازني عن إبراهيم بن الحجاج السامي عن إبراهيم بن هاشم البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14078","14041  -  حَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ ،  ثَنَا  النُّفَيْلِيُّ ،  ثَنَا  مِسْكِينُ بْنُ بُكَيْرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَقِيلِ بْنِ طَلْحَةَ قَالَ :  سَمِعْتُ  أَبَا الْخَصِيبِ يَقُولُ :  كُنْتُ قَاعِدًا فَجَاءَ ابْنُ عُمَرَ ، فَقَامَ لَهُ         [13/280]      رَجُلٌ  مِنْ مَقْعَدِهِ ، فَأَبَى أَنْ يَقْعُدَ فِيهِ وَقَعَدَ فِي مَكَانٍ آخَرَ ، فَجَعَلَ الرَّجُلُ يَقُولُ لَهُ : مَا كَانَ عَلَيْكَ أَنْ تَفْعَلَ ، فَقَالَ : مَا كُنْتُ لِأَقْعُدَ فِي مَجْلِسِكَ أَوْ مَجْلِسِ غَيْرِكَ بَعْدَمَا سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  جَاءَهُ  رَجُلٌ  فَقَامَ لَهُ  رَجُلٌ  ، فَأَرَادَ أَنْ يَقْعُدَ فِي مَقْعَدِهِ ، فَنَهَاهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 14041","","عبد الله بن عمر بن الخطاب عن زياد بن عبد الرحمن القيسي عن عقيل بن طلحة السلمي عن شعبة بن الحجاج عن مسكين بن بكير الحراني عن عبد الله بن محمد النفيلي عن أبو شعيب الحراني عن الطبراني","عمرو بن دينار عن ابن عمر"
"14079","14042  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُقْبَةَ السَّدُوسِيُّ ،  ثَنَا  مُعَاذُ بْنُ مُحَمَّدٍ - ابْنُ أَخِي سَلِيمِ بْنِ حَيَّانَ الْهُذَلِيِّ ،  حَدَّثَنِي  أَخِي  ،  عَنْ  جَدِّي  قَالَ :  كُنَّا عِنْدَ ابْنِ عُمَرَ فَذَكَرُوا حَجَّ  أَهْلِ الْيَمَنِ  وَمَا يَصْنَعُونَ فِيهِ ، فَسَبَّهُمْ بَعْضُ  الْقَوْمِ  ، فَقَالَ  ابْنُ عُمَرَ  : لَا  تَسُبُّوا  أَهْلَ الْيَمَنِ  ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  زَيْنُ الْحَاجِّ  أَهْلُ الْيَمَنِ  .  كذا في طبعة الجريسي ، والصواب : (أبي) وينظر تعليق المحقق .","","Al-Mu'jam al-Kabir 14042","","عبد الله بن عمر بن الخطاب عن حيان بن بسطام الهذلي عن محمد بن حيان الهذلي عن معاذ بن محمد الهذلي عن محمد بن عقبة بن هرم السدوسي عن محمد بن الفضل بن جابر السقطى عن الطبراني","عمرو بن دينار عن ابن عمر"
"14080","[13/281]      14043  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ صَالِحٍ الشِّيرَازِيُّ ،  ثَنَا  عُثْمَانُ بْنُ الْهَيْثَمِ ،  ثَنَا  عِمْرَانُ بْنُ حُدَيْرٍ ،  عَنْ  يَزِيدَ بْنِ عُطَارِدٍ [أَبِي] الْبَزْرِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كُنَّا نَأْكُلُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَنَحْنُ نَسْعَى  ، وَنَشْرَبُ وَنَحْنُ قِيَامٌ  .","","Al-Mu'jam al-Kabir 14043","","عبد الله بن عمر بن الخطاب عن يزيد بن عطارد السدوسي عن عمران بن حدير عن عثمان بن الهيثم بن جهم الأشج عن إبراهيم بن صالح الشيرازي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14081","[13/282]      14044  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ ،  ثَنَا  خَالِدُ بْنُ خِدَاشٍ ،  ثَنَا  عِكْرِمَةُ بْنُ خَالِدِ بْنِ سَلَمَةَ الْمَخْزُومِيُّ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَضْرِبُوا الْمَمْلُوكَ  ، فَإِنَّكُمْ لَا تَدْرُونَ مَا تُوَافِقُونَ  .","","Al-Mu'jam al-Kabir 14044","","عبد الله بن عمر بن الخطاب عن الفأفأ ، خالد بن سلمة بن العاص عن عكرمة بن خالد بن سلمة المخزومي عن خالد المهلبي عن محمد بن علي بن شعيب السمسار عن الطبراني","عمرو بن دينار عن ابن عمر"
"14082","14045  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  أَحْمَدُ بْنُ عَبْدِ الْمَلِكِ بْنِ وَاقِدٍ الْحَرَّانِيُّ ،  ثَنَا  غَسَّانُ بْنُ بُرْزِينَ ،  حَدَّثَنِي  رَاشِدٌ أَبُو مُحَمَّدٍ الْحِمَّانِيُّ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  لَقَدْ رَأَيْتُنَا وَمَا يَرَى أَحَدُنَا أَنَّهُ أَحَقُّ بِدِينَارِهِ وَدِرْهَمِهِ مِنْ أَخِيهِ الْمُسْلِمِ ، فَإِذَا الدِّينَارُ وَالدِّرْهَمُ أَحَبُّ إِلَى أَحَدِنَا مِنْ أَخِيهِ الْمُسْلِمِ ، وَلَقَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا ضَنَّ النَّاسُ بِالدِّينَارِ وَالدِّرْهَمِ وَاتَّبَعُوا أَذْنَابَ الْبَقَرِ  فَتَرَكُوا  الْجِهَادَ  ، سَلَّطَ اللهُ عَلَيْهِمْ ذُلًّا لَا يَنْزِعُهُ مِنْهُمْ حَتَّى يُرَاجِعُوا أَمْرَهُمْ  .","","Al-Mu'jam al-Kabir 14045","","عبد الله بن عمر بن الخطاب عن راشد بن نجيح الحماني عن غسان بن برزين الطهوي عن أحمد بن عبد الملك بن واقد الحراني عن محمد بن أحمد بن النضر النضري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14083","[13/283]      14046  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  خَلَفُ بْنُ سَالِمٍ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مُبَشِّرِ بْنِ أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا مِنْ رَجُلٍ يُصَلِّي عَلَيْهِ مِائَةٌ إِلَّا غُفِرَ لَهُ  .","","Al-Mu'jam al-Kabir 14046","","عبد الله بن عمر بن الخطاب عن أبو المليح بن أسامة الهذلي عن مبشر بن أبي المليح الهذلي عن شعبة بن الحجاج عن يحيى القطان عن خلف بن سالم المخرمي عن الحسن بن علي بن شبيب المعمري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14084","14047  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْعَلَاءِ الْحِمْصِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْمُغِيرَةِ بْنِ مُخَادِشٍ قَالَ :  قُلْتُ  لِابْنِ عُمَرَ إِنِّي حَجَجْتُ فَتَمَتَّعْتُ ، فَكَرِهَ ذَلِكَ نَاسٌ مِنْ أَصْحَابِي؟ فَقَالَ  ابْنُ عُمَرَ  :  جَمَعَ اللهُ لَكَ  نُسُكَيْنِ  ، فَعَلَ ذَلِكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 14047","","عبد الله بن عمر بن الخطاب عن مغيرة بن مخادش البصري عن شعبة بن الحجاج عن بقية بن الوليد عن إبراهيم بن العلاء زبريق عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14085","14048  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ         [13/284]      إِسْمَاعِيلَ الْبُخَارِيُّ ،  ثَنَا  عَبْدَانُ بْنُ عُثْمَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  شُعْبَةَ ،  عَنْ  مُغِيرَةَ بْنِ مُخَادِشٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ مُسْكِرٍ حَرَامٌ  .","","Al-Mu'jam al-Kabir 14048","","عبد الله بن عمر بن الخطاب عن مغيرة بن مخادش البصري عن شعبة بن الحجاج عن عثمان بن جبلة عن عبد الله بن عثمان بن جبلة عن البخاري عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14086","14049  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  مِسْعَرٍ ،  عَنْ  سِمَاكٍ الْحَنَفِيِّ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ صَلَّى بِهَؤُلَاءِ رَكْعَةً وَبِهَؤُلَاءِ رَكْعَةً فِي صَلَاةِ الْخَوْفِ  .","","Al-Mu'jam al-Kabir 14049","","عبد الله بن عمر بن الخطاب عن سماك بن الوليد اليمامي عن مسعر بن كدام عن يحيى القطان عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمرو بن دينار عن ابن عمر"
"14087","14050  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَبَنَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ الْحَنَفِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  الْبَيْتِ  .","","Al-Mu'jam al-Kabir 14050","","عبد الله بن عمر بن الخطاب عن سماك بن الوليد اليمامي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمرو بن دينار عن ابن عمر"
"14088","[13/285]      14051  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  مِسْعَرٍ ،  عَنْ  سِمَاكٍ الْحَنَفِيِّ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  الْبَيْتِ  أَوْ فِي  الْكَعْبَةِ  .","","Al-Mu'jam al-Kabir 14051","","عبد الله بن عمر بن الخطاب عن سماك بن الوليد اليمامي عن مسعر بن كدام عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14089","14052  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرُ بْنُ كِدَامٍ ،  عَنْ  سِمَاكٍ الْحَنَفِيِّ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  صَلَّى فِيهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ،  يَعْنِي : فِي  الْبَيْتِ  .","","Al-Mu'jam al-Kabir 14052","","عبد الله بن عمر بن الخطاب عن سماك بن الوليد اليمامي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14090","14053  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلُ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ أَبِي الثَّلْجِ ،  ثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ الْحَنَفِيِّ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14053","","عبد الله بن عمر بن الخطاب عن سماك بن الوليد اليمامي عن شعبة بن الحجاج عن عبد الصمد بن عبد الوارث التنوري عن محمد بن عبد الله بن إسماعيل البغدادي عن عبيد العجل عن الطبراني","عمرو بن دينار عن ابن عمر"
"14091","14054  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  سِمَاكٍ الْحَنَفِيِّ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  لَيْسَتْ بِقَصْرٍ وَلَكِنَّهَا تَمَامٌ سُنَّةُ الرَّكْعَتَيْنِ فِي السَّفَرِ  .","","Al-Mu'jam al-Kabir 14054","","عبد الله بن عمر بن الخطاب عن سماك بن الوليد اليمامي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14092","[13/286]      14055  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ الْوَارِثِ بْنُ سَعِيدٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ صُهَيْبٍ ،  عَنْ  عَبْدِ الْوَاحِدِ الْبُنَانِيِّ قَالَ :  كُنْتُ قَاعِدًا عِنْدَ ابْنِ عُمَرَ ، فَأَتَاهُ رَجُلٌ ، فَقَالَ : إِنِّي أَشْتَرِي هَذِهِ الْحِيطَانَ فِيهَا الْأَعْنَابُ ، فَلَا أَسْتَطِيعُ أَنْ أَبِيعَهَا كُلَّهَا عِنَبًا حَتَّى نَعْصِرَهَا ؟ قَالَ : أَفَعَنِ الْخَمْرِ تَسْأَلُنِي ؟ سَأُحَدِّثُكَ حَدِيثًا سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : كُنَّا جُلُوسًا مَعَ نَبِيِّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذْ رَفَعَ رَأْسَهُ إِلَى السَّمَاءِ ثُمَّ أَكَبَّ ، وَنَكَتَ فِي الْأَرْضِ ، فَقَالَ :  الْوَيْلُ  لِبَنِي إِسْرَائِيلَ  !!  ، قَالَ  عُمَرُ  : يَا رَسُولَ اللهِ ، لَقَدْ أَفْزَعَنَا قَوْلُكَ مِنْ  بَنِي إِسْرَائِيلَ  ، قَالَ : "" لَيْسَ عَلَيْكُمْ مِنْ ذَلِكَ بَأْسٌ ، إِنَّهُ حُرِّمَ عَلَيْهِمُ الشَّحْمُ فَيُطْرُونَهُ ثُمَّ يَبِيعُونَهُ ثُمَّ يَأْكُلُونَ ثَمَنَهُ ، وَكَذَلِكَ ثَمَنُ الْخَمْرِ عَلَيْكُمْ حَرَامٌ  .","","Al-Mu'jam al-Kabir 14055","","عبد الله بن عمر بن الخطاب عن عبدالواحد البناني عن عبد العزيز بن صهيب البناني عن عبد الوارث بن سعيد بن ذكوان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14093","14056  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ         [13/287]      الْمُخْتَارِ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ قُلْتُ : رَجُلًا يُحَرِّكُ الْحَصَى فِي الصَّلَاةِ ؟ قَالَ : لَا تُحَرِّكِ الْحَصَى فَإِنَّ ذَلِكَ مِنَ الشَّيْطَانِ ، وَلَكِنِ اصْنَعْ كَمَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَصْنَعُ ،  ضَعْ يَدَكَ عَلَى فَخِذِكَ ثُمَّ قُلْ هَكَذَا  ، وَوَضَعَ كَفَّهُ الْيُمْنَى عَلَى فَخِذِهِ الْيُمْنَى وَأَشَارَ بِإِصْبَعِهِ السَّبَّابَةِ  .","","Al-Mu'jam al-Kabir 14056","","عبد الله بن عمر بن الخطاب عن ثابت البناني عن عبد العزيز بن المختار الدباغ عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14094","14057  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَبَنَا  شُعْبَةُ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ قَالَ :  قُلْتُ  لِابْنِ عُمَرَ : مَا تَقُولُ فِي نَبِيذِ  الْجَرِّ  حَرَّمَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟  قَالَ : زَعَمُوا ذَلِكَ ، قُلْتُ : سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : زَعَمُوا ذَلِكَ .  قَالَ  ثَابِتٌ  : فَصَرَفَهُ اللهُ عَنِّي ، وَكَانَ أَحَدُهُمْ إِذَا قِيلَ لَهُ : سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ غَضِبَ  .","","Al-Mu'jam al-Kabir 14057","","عبد الله بن عمر بن الخطاب عن ثابت البناني عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمرو بن دينار عن ابن عمر"
"14095","[13/288]      14058  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنْ نَبِيذِ  الْجَرِّ  ؟  فَقَالَ  : حَرَامٌ  ، فَقُلْتُ : أَنَهَى عَنْهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ  ابْنُ عُمَرَ  : يَزْعُمُونَ ذَلِكَ  .","","Al-Mu'jam al-Kabir 14058","","عبد الله بن عمر بن الخطاب عن ثابت البناني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14096","14059  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنِ  الزُّبَيْرِ بْنِ عَرَبِيٍّ ، قَالَ :  سَمِعْتُ  رَجُلًا  سَأَلَ ابْنَ عُمَرَ عَنِ اسْتِلَامِ الْحَجَرِ ؟  فَقَالَ  ابْنُ عُمَرَ  :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْتَلِمُهُ         [13/289]      وَيُقَبِّلُهُ  ، فَجَعَلَ الرَّجُلُ يَقُولُ : أَرَأَيْتَ إِنْ زُحِمْتُ أَرَأَيْتَ إِنْ غُلِبْتُ ؟ قَالَ : اجْعَلْ أَرَأَيْتَ بِالْيَمَنِ ، رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْتَلِمُهُ وَيُقَبِّلُهُ  .","","Al-Mu'jam al-Kabir 14059","","عبد الله بن عمر بن الخطاب عن الزبير بن عربي النمري عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14097","14060  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  مَرْثَدُ بْنُ عَامِرٍ الْهُنَائِيُّ ،  عَنْ  أَبِي عَمْرٍو النَّدْبِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَيَعْجَبُ مِنَ الصَّلَاةِ فِي الْجَمِيعِ  .","","Al-Mu'jam al-Kabir 14060","","عبد الله بن عمر بن الخطاب عن بشر بن حرب عن مرثد بن عامر الهنائي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14098","14061  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  بِشْرِ بْنِ حَرْبٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِنْدَ حُجْرَةِ  عَائِشَةَ  يَقُولُ :  لِكُلِّ غَادِرٍ  لِوَاءٌ  يَوْمَ الْقِيَامَةِ بِقَدْرِ غَدْرَتِهِ  .","","Al-Mu'jam al-Kabir 14061","","عبد الله بن عمر بن الخطاب عن بشر بن حرب عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14099","[13/290]      14062  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  بِشْرِ بْنِ حَرْبٍ  أَنَّ  ابْنَ عُمَرَ سُئِلَ عَنِ الضَّبِّ ؟ فَقَالَ : إِنَّا مُنْذُ قَالَ فِيهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا قَالَ ، فَإِنَّا قَدِ انْتَهَيْنَا عَنْ أَكْلِهِ  .","","Al-Mu'jam al-Kabir 14062","","عبد الله بن عمر بن الخطاب عن بشر بن حرب عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14100","14063  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  بِشْرِ بْنِ حَرْبٍ قَالَ :  قُلْنَا لِابْنِ عُمَرَ : كَيْفَ صَلَاةُ الْمُسَافِرِ يَا  أَبَا عَبْدِ الرَّحْمَنِ  ؟  فَقَالَ  : إِمَّا أَنْتُمْ تَتَّبِعُونَ سُنَّةَ نَبِيِّكُمْ أَخْبَرْتُكُمْ ، فَإِمَّا لَا تَتَّبِعُونَ سُنَّةَ نَبِيِّكُمْ لَمْ أُخْبِرْكُمْ ، قُلْنَا : خَيْرُ السُّنَنِ سُنَّةُ نَبِيِّنَا يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا خَرَجَ مِنْ هَذِهِ  الْمَدِينَةِ  لَمْ يَزِدْ عَلَى رَكْعَتَيْنِ حَتَّى يَرْجِعَ إِلَيْهَا  .","","Al-Mu'jam al-Kabir 14063","","عبد الله بن عمر بن الخطاب عن بشر بن حرب عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14101","14064  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  بِشْرِ بْنِ حَرْبٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  نُهِيتُمْ عَنِ  الْحَنْتَمِ  ، نُهِيتُمْ عَنِ  النَّقِيرِ  ، نُهِيتُمْ عَنِ  الْمُزَفَّتِ  ، كُلُّ هَذَا قَدْ نُهِيتُمْ عَنْهُ  .","","Al-Mu'jam al-Kabir 14064","","عبد الله بن عمر بن الخطاب عن بشر بن حرب عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14102","[13/291]      14065  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  بِشْرِ بْنِ حَرْبٍ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  أَرَأَيْتُمْ قِيَامَكُمْ عِنْدَ فَرَاغِ الْإِمَامِ مِنَ السُّورَةِ ، هَذَا  الْقُنُوتُ  ؟! وَاللهِ إِنَّهُ لَبِدْعَةٌ ، مَا فَعَلَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ غَيْرَ شَهْرٍ ثُمَّ تَرَكَهُ . أَرَأَيْتُمْ رَفْعَ أَيْدِيَكُمْ فِي الصَّلَاةِ ؟! وَرَفَعَ يَدَهُ ، وَاللهِ إِنَّهُ لَبِدْعَةٌ  مَا زَادَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى هَذَا قَطُّ وَرَفَعَ يَدَيْهِ حِيَالَ مَنْكِبَيْهِ  .","","Al-Mu'jam al-Kabir 14065","","عبد الله بن عمر بن الخطاب عن بشر بن حرب عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14103","14066  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  بِشْرِ بْنِ حَرْبٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [13/292]      دَعَا فِي  قُنُوتِهِ  عَلَى  بَنِي عُصَيَّةَ  ، فَقَالَ :  اللَّهُمَّ عَلَيْكَ  بَنِي عُصَيَّةَ  ، فَإِنَّهُمْ عَصَوُا اللهَ وَرَسُولَهُ  ، قَالَ : فَصُبَّتِ الْحُمَّى عَلَيْهِمْ  .","","Al-Mu'jam al-Kabir 14066","","عبد الله بن عمر بن الخطاب عن بشر بن حرب عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14104","14067  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  بِشْرِ بْنِ حَرْبٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِنْدَ حُجْرَةِ  عَائِشَةَ  :  مِنْ هُنَا الْفِتْنَةُ  ، وَأَشَارَ بِيَدِهِ نَحْوَ الْمَشْرِقِ ، وَ"" مِنْ حَيْثُ يَطْلُعُ قَرْنُ الشَّيْطَانِ  .","","Al-Mu'jam al-Kabir 14067","","عبد الله بن عمر بن الخطاب عن بشر بن حرب عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14105","14068  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  بِشْرِ بْنِ حَرْبٍ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ : آخُذُ الدِّرْهَمَيْنِ بِالدِّرْهَمِ ؟ فَقَالَ : عَيْنُ الرِّبَا فَلَا تَقْرَبَنَّهُ ، هَلْ شَعَرْتَ مَا قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟! قَالَ :  خُذُوا الْمِثْلَ بِالْمِثْلِ  .","","Al-Mu'jam al-Kabir 14068","","عبد الله بن عمر بن الخطاب عن بشر بن حرب عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14106","[13/293]      14069  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنِ  الْقَاسِمِ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ عَلَى دَرَجِ  الْكَعْبَةِ  ، يَقُولُ :  الْحَمْدُ لِلهِ الَّذِي أَنْجَزَ وَعْدَهُ ، وَنَصَرَ عَبْدَهُ ، وَهَزَمَ  الْأَحْزَابَ  وَحْدَهُ  ، أَلَا إِنَّ كُلَّ  مَأْثُرَةٍ  كَانَتْ فِي الْجَاهِلِيَّةِ فَإِنَّهَا تَحْتَ قَدَمَيَّ الْيَوْمَ ، إِلَّا مَا كَانَ مِنْ  سِدَانَةِ  الْبَيْتِ  وَسِقَايَةِ الْحَاجِّ ، أَلَا وَإِنَّ مَا بَيْنَ الْعَمْدِ  وَالْخَطَأِ  الْقَتِيلَ بِالسَّوْطِ وَالْحَجَرِ فِيهَا مِائَةُ بَعِيرٍ ، أَرْبَعُونَ فِي بُطُونِهَا أَوْلَادُهَا  .","","Al-Mu'jam al-Kabir 14069","","عبد الله بن عمر بن الخطاب عن القاسم بن ربيعة بن جوشن الغطفاني عن علي بن زيد بن جدعان عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14107","[13/294]      14070  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  تَوْبَةَ الْعَنْبَرِيِّ ،  عَنْ  مُوَرِّقٍ الْعِجْلِيِّ قَالَ :  قُلْتُ  لِابْنِ عُمَرَ : أَتُصَلِّي الضُّحَى ؟  قَالَ : لَا ، قُلْتُ :  فَأَبُو بَكْرٍ  ؟ قَالَ : لَا ، قُلْتُ : فَالنَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : لَا إِخَالُهُ  .","","Al-Mu'jam al-Kabir 14070","","عبد الله بن عمر بن الخطاب عن مورق العجلي عن توبة بن أبي الأسد العنبري عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14108","14071  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ،  ثَنَا  إِسْحَاقُ بْنُ حَاتِمٍ الْعَلَّافُ ،  ثَنَا  يَحْيَى بْنُ الْمُتَوَكِّلِ ،  ثَنَا  الصَّلْتُ بْنُ دِينَارٍ ،  عَنْ  مُوَرِّقٍ الْعِجْلِيِّ وَمُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  حَفِظْتُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا لَا أَدَعُهُ فِي حَضَرٍ وَلَا سَفَرٍ : رَكْعَتَيْنِ قَبْلَ الظُّهْرِ وَرَكْعَتَيْنِ بَعْدَهَا  وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ وَرَكْعَتَيْنِ بَعْدَ الْعِشَاءِ وَرَكْعَتَيْنِ قَبْلَ الْفَجْرِ  .","","Al-Mu'jam al-Kabir 14071","","عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن الصلت بن دينار الهنائي عن يحيى بن المتوكل الباهلي عن إسحاق بن حاتم العلاف عن البزار عن الطبراني","عمرو بن دينار عن ابن عمر"
"14109","14072  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ         [13/295]      مَعْمَرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُوَرِّقٍ الْعِجْلِيِّ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنِ الصَّلَاةِ فِي السَّفَرِ؟ فَقَالَ : رَكْعَتَيْنِ رَكْعَتَيْنِ  ، مَنْ خَالَفَ السُّنَّةَ كَفَرَ  .","","Al-Mu'jam al-Kabir 14072","","عبد الله بن عمر بن الخطاب عن مورق العجلي عن قتادة بن دعامة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14110","14073  -  حَدَّثَنَا  إِسْحَاقُ بْنُ خَالَوَيْهِ الْوَاسِطِيُّ ،  ثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  ثَنَا  مُوَرِّقٌ الْعِجْلِيُّ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنْ صَلَاةِ الْمُسَافِرِ ؟ فَقَالَ : رَكْعَتَانِ  ، مَنْ خَالَفَ السُّنَّةَ كَفَرَ  .","","Al-Mu'jam al-Kabir 14073","","عبد الله بن عمر بن الخطاب عن مورق العجلي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن العباس بن الوليد النرسي عن إسحاق بن خالويه البابسيري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14111","[13/296]      14074  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  عَمْرُو بْنُ حَكَّامٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي التَّيَّاحِ ،  عَنْ  مُوَرِّقٍ الْعِجْلِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  سَأَلَهُ  صَفْوَانُ بْنُ مُحْرِزٍ  عَنِ الصَّلَاةِ فِي السَّفَرِ ؟  فَقَالَ : رَكْعَتَانِ مَنْ خَالَفَ السُّنَّةَ كَفَرَ  .","","Al-Mu'jam al-Kabir 14074","","عبد الله بن عمر بن الخطاب عن مورق العجلي عن يزيد بن حميد الضبعي عن شعبة بن الحجاج عن عمرو بن حكام الزنجبيلي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14112","14075  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ ثَلَاثِينَ كَذَّابًا  دَجَّالًا  .","","Al-Mu'jam al-Kabir 14075","","عبد الله بن عمر بن الخطاب عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14113","[13/297]      14076  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ التَّيْمِيِّ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ قَالَ :  حَدَّثَنِي  الْحَوَارِيُّ بْنُ زِيَادٍ قَالَ :  كُنْتُ جَالِسًا عِنْدَ  عَبْدِ اللهِ بْنِ عُمَرَ  فَجَاءَهُ شَابٌّ فَقَالَ : أَلَا تُجَاهِدُ ؟ فَسَكَتَ وَأَعْرَضَ عَنْهُ ،  فَقَالَ  ابْنُ عُمَرَ :  إِنَّ الْإِسْلَامَ بُنِيَ عَلَى أَرْبَعِ دَعَائِمَ : إِقَامُ الصَّلَاةِ وَإِيتَاءُ الزَّكَاةِ  لَا يُفَرَّقُ بَيْنَهُمَا ، وَصِيَامُ شَهْرِ رَمَضَانَ وَحَجُّ الْبَيْتِ مَنِ اسْتَطَاعَ إِلَيْهِ سَبِيلًا ، وَإِنَّ  الْجِهَادَ  وَالصَّدَقَةَ مِنَ الْعَمَلِ الْحَسَنِ  .","","Al-Mu'jam al-Kabir 14076","","عبد الله بن عمر بن الخطاب عن حواري بن زياد العتكي عن عبد الملك بن عمير القبطي عن معتمر بن سليمان عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14114","14077  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا         [13/298]      حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ وَنَافِعٍ  أَنَّ  ابْنَ عُمَرَ اسْتَفْتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ أَرَأَيْتَ أَحَدَنَا  يُجْنِبُ  مِنَ اللَّيْلِ ؟ قَالَ :  لِيَتَوَضَّأْ إِذَا أَرَادَ أَنْ يَنَامَ  .","","Al-Mu'jam al-Kabir 14077","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14115","14078  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  ثَنَا  خَالِدٌ الْحَذَّاءُ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نَادَى  رَجُلٌ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَيُّ اللَّيْلِ  أَجْوَبُ  دَعْوَةً ؟ قَالَ : ""  جَوْفُ  اللَّيْلِ الْآخِرُ  .","","Al-Mu'jam al-Kabir 14078","","عبد الله بن عمر بن الخطاب عن أبو قلابة الجرمي عن خالد الحذاء عن بشر بن المفضل عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14116","14079  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  أَيُّوبُ بْنُ يُونُسَ أَبُو أُمَيَّةَ         [13/299]      الصَّفَّارُ ،  ثَنَا  وُهَيْبُ بْنُ خَالِدٍ ،  عَنْ  أَيُّوبَ وَخَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ قُتِلَ دُونَ مَالِهِ فَهُوَ  شَهِيدٌ  .","","Al-Mu'jam al-Kabir 14079","","عبد الله بن عمر بن الخطاب عن أبو قلابة الجرمي عن خالد الحذاء عن وهيب بن خالد الكرابيسي عن أيوب بن يونس الصفار عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14117","14080  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  ثَنَا  خَالِدٌ الْحَذَّاءُ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ قَالَ :  كَانَ ابْنُ عُمَرَ إِذَا أَوَى إِلَى فِرَاشِهِ ، قَالَ : اللَّهُمَّ أَنْتَ خَلَقْتَ نَفْسِي وَأَنْتَ تَتَوَفَّاهَا  ، لَكَ مَحْيَاهَا وَمَمَاتُهَا ، اللَّهُمَّ إِنْ تَوَفَّيْتَهَا فَاغْفِرْ لَهَا وَإِنْ         [13/300]      أَحْيَيْتَهَا فَاحْفَظْهَا ، اللَّهُمَّ إِنِّي أَسْأَلُكَ الْعَافِيَةَ ، فَقَالَ لَهُ  رَجُلٌ  مِنْ وَلَدِهِ : يَا أَبَةِ أَكَانَ  عُمَرُ  يَقُولُ ذَا ؟ قَالَ : بَلْ خَيْرٌ مِنْ  عُمَرَ  كَانَ يَقُولُ ذَا  .","","Al-Mu'jam al-Kabir 14080","","عبد الله بن عمر بن الخطاب عن عبد الله بن الحارث الأنصاري عن خالد الحذاء عن بشر بن المفضل عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14118","14081  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هِشَامٍ الْمُسْتَمْلِي ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ صَالِحٍ الْهَرَوِيُّ ،  ثَنَا  عَبَّادُ بْنُ عَبَّادٍ  ،  عَنْ  جَمِيلِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ         [13/301]      عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَحْبِبْ حَبِيبَكَ  هَوْنًا  مَا عَسَى أَنْ يَكُونَ بَغِيضَكَ يَوْمًا مَا  ، وَأَبْغِضْ بَغِيضَكَ  هَوْنًا  مَا عَسَى أَنْ يَكُونَ حَبِيبَكَ يَوْمًا مَا  .  كذا في طبعة الجريسي ، ولعل الصواب : (عباد بن العوام) وينظر تعليق المحقق .","","Al-Mu'jam al-Kabir 14081","","عبد الله بن عمر بن الخطاب عن جميل بن زيد الطائي عن عباد بن العوام الكلابي عن عبد السلام بن صالح الهروي عن ابن أبى الدميك محمد بن هشام بن علي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14119","14082  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  هِشَامُ بْنُ يُونُسَ اللُّؤْلُئِيُّ ،  ثَنَا  أَبُو مَالِكٍ الْجَنْبِيُّ ،  عَنْ  جَمِيلِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  صَلَاةُ السَّفَرِ رَكْعَتَيْنِ  ، مَنْ خَالَفَ السُّنَّةَ كَفَرَ  .","","Al-Mu'jam al-Kabir 14082","","عبد الله بن عمر بن الخطاب عن جميل بن زيد الطائي عن عمرو بن هاشم الجنبي عن هشام بن يونس بن وابل النهشلي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14120","14083  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،         [13/302]      أَبَنَا  شُعْبَةُ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ، فَإِذَا خَشِيتَ الصُّبْحَ فَاسْجُدْ سَجْدَةً  .","","Al-Mu'jam al-Kabir 14083","","عبد الله بن عمر بن الخطاب عن عبد الله بن شقيق العقيلي عن خالد الحذاء عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن محمد بن محمد بن حيان التمار عن الطبراني","عمرو بن دينار عن ابن عمر"
"14121","14084  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  فَإِذَا خَشِيتَ الصُّبْحَ فَاسْجُدْ سَجْدَةً وَاحِدَةً ، وَسَجْدَتَانِ قَبْلَ صَلَاةِ الْفَجْرِ  .","","Al-Mu'jam al-Kabir 14084","","عبد الله بن عمر بن الخطاب عن عبد الله بن شقيق العقيلي عن خالد الحذاء عن بشر بن المفضل عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14122","14085  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا         [13/303]      هُشَيْمٌ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنِ  النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14085","","عبد الله بن عمر بن الخطاب عن عبد الله بن شقيق العقيلي عن خالد الحذاء عن هشيم بن بشير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14123","14086  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ  رَجُلًا  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : صَلَاةُ اللَّيْلِ ؟ فَقَالَ بِإِصْبَعِهِ هَكَذَا : "" مَثْنَى مَثْنَى  ،  وَالْوِتْرُ  رَكْعَةٌ مِنْ آخِرِ اللَّيْلِ  .","","Al-Mu'jam al-Kabir 14086","","عبد الله بن عمر بن الخطاب عن عبد الله بن شقيق العقيلي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن محمد بن كثير العبدي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14124","14087  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَبُو الرَّبِيعِ         [13/304]      الزَّهْرَانِيِّ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  ثَنَا  أَيُّوبُ وَبُدَيْلٌ الْعُقَيْلِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ  رَجُلًا  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا بَيْنَهُ وَبَيْنَ السَّائِلِ ، فَقَالَ :  يَا رَسُولَ اللهِ كَيْفَ صَلَاةُ اللَّيْلِ ؟ قَالَ : "" مَثْنَى مَثْنَى  فَإِذَا خَشِيتَ الصُّبْحَ فَصَلِّ رَكْعَةً ، وَاجْعَلْ آخِرَ صَلَاتِكَ  وِتْرًا  .","","Al-Mu'jam al-Kabir 14087","","عبد الله بن عمر بن الخطاب عن عبد الله بن شقيق العقيلي عن بديل بن ميسرة العقيلي عن حماد بن زيد عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14125","14088  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مَعْمَرُ بْنُ سَهْلٍ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ تَمَّامٍ ،  عَنْ  سَعِيدٍ الْجُرَيْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  تُسَلِّمُ فِي كُلِّ رَكْعَتَيْنِ ، فَإِذَا خَشِيتَ الصُّبْحَ  فَأَوْتِرْ  بِرَكْعَةٍ  .","","Al-Mu'jam al-Kabir 14088","","عبد الله بن عمر بن الخطاب عن عبد الله بن شقيق العقيلي عن سعيد بن إياس الجريري عن عبيد الله بن تمام السلمي عن معمر بن سهل بن معمر الأهوازي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14126","14089  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَامِرِ بْنِ زُرَارَةَ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  بَادِرُوا الصُّبْحَ  بِالْوِتْرِ  .","","Al-Mu'jam al-Kabir 14089","","عبد الله بن عمر بن الخطاب عن عبد الله بن شقيق العقيلي عن عاصم بن سليمان الأحول عن يحيى بن زكريا بن أبي زائدة عن عبد الله بن عامر بن زرارة الحضرمي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14127","[13/305]      14090  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي وَعُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ قَالَا :  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَبَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ قَالَ : كُنَّا عِنْدَ مُحَمَّدِ بْنِ سِيرِينَ وَعِنْدَهُ الْمُغِيرَةُ بْنُ سَلْمَانَ ،  فَحَدَّثَ  قَالَ :  قَالَ  : ابْنُ عُمَرَ :  عَشْرُ رَكَعَاتٍ حَفِظْتُهُنَّ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  : رَكْعَتَيْنِ قَبْلَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَرَكْعَتَيْنِ بَعْدَ عِشَاءِ الْآخِرَةِ ، وَرَكْعَتَيْنِ قَبْلَ الصُّبْحِ  . فَقَالَ رَجُلٌ عِنْدَ  مُحَمَّدٍ  : هَذَا مَا لَا بُدَّ مِنْهُ ؟! فَقَالَ  مُحَمَّدٌ  : إِنَّ مَا لَا بُدَّ مِنْهُ الْفَرِيضَةُ  .","","Al-Mu'jam al-Kabir 14090","","عبد الله بن عمر بن الخطاب عن المغيرة بن سلمان الخزاعي عن قتادة بن دعامة عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن عثمان بن عمر الضبي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14128","14091  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  يَزِيدُ بْنُ إِبْرَاهِيمَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سِيرِينَ ،  ثَنَا  الْمُغِيرَةُ بْنُ سَلْمَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ قَالَ :  عَشْرُ رَكَعَاتٍ حَفِظْتُهُنَّ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  : رَكْعَتَيْنِ قَبْلَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَرَكْعَتَيْنِ بَعْدَ الْعِشَاءِ ، وَرَكْعَتَيْنِ قَبْلَ الْفَجْرِ  .","","Al-Mu'jam al-Kabir 14091","","عبد الله بن عمر بن الخطاب عن المغيرة بن سلمان الخزاعي عن محمد بن سيرين عن يزيد بن إبراهيم التستري عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14129","[13/306]      14092  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ أَعْيَنَ الْبَغْدَادِيُّ ،  ثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنِ  ابْنِ سِيرِينَ ،  عَنِ  الْمُغِيرَةِ بْنِ سَلْمَانَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  صَلَّيْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَرْبَعًا قَبْلَ الظُّهْرِ ، وَاثْنَيْنِ بَعْدَهَا  ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَرَكْعَتَيْنِ بَعْدَ الْعِشَاءِ ، وَرَكْعَتَيْنِ قَبْلَ الْفَجْرِ  .","","Al-Mu'jam al-Kabir 14092","","عبد الله بن عمر بن الخطاب عن المغيرة بن سلمان الخزاعي عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن مروان بن معاوية الفزاري عن داود بن عمرو المسيبي عن محمد بن جعفر بن أعين البغدادي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14130","14093  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنِ  الْمُغِيرَةِ بْنِ سَلْمَانَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  عَشْرُ رَكَعَاتٍ سِوَى الْفَرِيضَةِ حَفِظْتُهُنَّ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  : رَكْعَتَيْنِ قَبْلَ الظُّهْرِ وَرَكْعَتَيْنِ بَعْدَهَا ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَرَكْعَتَيْنِ بَعْدَ الْعِشَاءِ ، وَرَكْعَتَيْنِ قَبْلَ الصُّبْحِ  .","","Al-Mu'jam al-Kabir 14093","","عبد الله بن عمر بن الخطاب عن المغيرة بن سلمان الخزاعي عن أيوب السختياني عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14131","[13/307]      14094  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  خَالِدِ بْنِ زَيْدٍ ،  عَنْ  قَزَعَةَ بْنِ يَحْيَى  قَالَ  :  كُنْتُ مَعَ ابْنِ عُمَرَ فِي مَسِيرٍ فَتَقَدَّمَ  الْعِيرُ  عَلَى رَاحِلَتِهِ ، فَجَعَلَ يَقْرَأُ وَيَرْكَعُ وَيَسْجُدُ أَيْنَمَا كَانَ وَجْهُهُ ، فَلَمَّا أَصْبَحْنَا قُلْتُ لَهُ : رَأَيْتُكَ تَفْعَلُ شَيْئًا لَمْ تَكُنْ تَفْعَلُهُ ؟ قَالَ :  رَأَيْتُ  أَبَا الْقَاسِمِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُهُ  .","","Al-Mu'jam al-Kabir 14094","","عبد الله بن عمر بن الخطاب عن قزعة بن يحيى الحرشي عن خالد بن زيد الشامي عن معتمر بن سليمان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14132","14095  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدٍ ،  عَنْ  قَزَعَةَ  أَنَّهُ سَأَلَ ابْنَ عُمَرَ عَنِ الصَّلَاةِ عَلَى الرَّاحِلَةِ أَيْنَمَا تَوَجَّهَتْ ، مِنَ السُّنَّةِ ؟  قَالَ  : نَعَمْ  .","","Al-Mu'jam al-Kabir 14095","","عبد الله بن عمر بن الخطاب عن قزعة بن يحيى الحرشي عن محمد بن سيرين عن أيوب السختياني عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14133","14096  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  سَعِيدُ بْنُ         [13/308]      مُحَمَّدٍ الْجَرْمِيُّ ،  ثَنَا  أَبُو تُمَيْلَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُسْلِمٍ أَبُو طَيْبَةَ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عُبَيْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  أَنَّ  رَجُلًا مِنَ الْأَنْصَارِ  كَانَ لَهُ ابْنٌ يَرُوحُ إِذَا رَاحَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَسَأَلَ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْهُ ، فَقَالَ : "" أَتُحِبُّهُ ؟ "" فَقَالَ : يَا نَبِيَّ اللهِ نَعَمْ ، فَأَحَبَّكَ اللهُ كَمَا أُحِبُّهُ ، فَقَالَ : "" إِنَّ اللهَ أَشَدُّ لِي حُبًّا مِنْكَ لَهُ "" . فَلَمْ يَلْبَثْ أَنْ مَاتَ ابْنُهُ ذَلِكَ ، فَرَاحَ إِلَى نَبِيِّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقَدْ أَقْبَلَ عَلَيْهِ بَثُّهُ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَجَزِعْتَ ؟ "" قَالَ : نَعَمْ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَوَمَا تَرْضَى أَنْ يَكُونَ ابْنُكَ مَعَ ابْنِي  إِبْرَاهِيمَ  يُلَاعِبُهُ تَحْتَ ظِلِّ الْعَرْشِ ؟!  قَالَ : بَلَى يَا رَسُولَ اللهِ  .","","Al-Mu'jam al-Kabir 14096","","عبد الله بن عمر بن الخطاب عن إبراهيم بن عبيد بن رفاعة الزرقي عن عبد الله بن مسلم السلمي عن يحيى بن واضح الأنصاري عن سعيد بن محمد الجرمي عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"14134","14097  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ أَبِي         [13/309]      عَوَانَةَ الشَّاشِيِّ ،  ثَنَا  عَلِيُّ بْنُ الْحَسَنِ بْنِ شَقِيقٍ ،  أَبَنَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  ثَنَا  مَرْوَانُ بْنُ الْمُقَفَّعِ قَالَ :  رَأَيْتُ  ابْنَ عُمَرَ قَبَضَ عَلَى لِحْيَتِهِ فَقَطَعَ مَا زَادَ عَلَى الْكَفِّ ، وَقَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا أَفْطَرَ قَالَ  : "" ذَهَبَ الظَّمَأُ وَابْتَلَّتِ الْعُرُوقُ وَثَبَتَ الْأَجْرُ إِنْ شَاءَ اللهُ  .","","Al-Mu'jam al-Kabir 14097","","","عمرو بن دينار عن ابن عمر"
"14135","14098  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ الْأَنْمَاطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَّامٍ الْجُمَحِيُّ ،  ثَنَا  أَبِي  ،  عَنْ  مَيْسُورِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ [سَالِمٍ] ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اقْتُلُوا الْحَيَّاتِ  ، فَإِنَّا لَمْ  نُسَالِمْهُنَّ  مُنْذُ حَارَبْنَاهُنَّ  .","","Al-Mu'jam al-Kabir 14098","","عبد الله بن عمر بن الخطاب عن عبيد الله بن سالم عن ميسور بن عبد الرحمن البصري عن والد محمد بن سلام الجمحي عن محمد بن سلام الجمحي عن محمد بن الحسين الأنماطي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14136","14099  -  حَدَّثَنَا  بَكْرُ بْنُ مُحَمَّدٍ أَبُو عُمَرَ الْقَزَّازُ الْبَصْرِيُّ ،  ثَنَا         [13/310]      أَحْمَدُ بْنُ عَبْدَةَ الضَّبِّيُّ ،  ثَنَا  عُمَرُ بْنُ عَبْدِ اللهِ الرُّومِيُّ ،  ثَنَا  عَوْنٌ الْعُقَيْلِيُّ  أَنَّ  ابْنَ عُمَرَ ذَكَرَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الذَّهَبُ بِالذَّهَبِ وَزْنًا بِوَزْنٍ وَالْفِضَّةُ بِالْفِضَّةِ وَزْنًا بِوَزْنٍ  ، فَمَنْ زَادَ وَاسْتَزَادَ فَقَدْ  أَرْبَى  "" ، وَاللهِ مَا كَذَبَ  ابْنُ عُمَرَ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 14099","","عبد الله بن عمر بن الخطاب عن عون بن أبي شداد عن عمر بن عبد الله بن عبد الرحمن الرومي عن أحمد بن عبدة الضبي عن بكر بن محمد بن عبد الوهاب القزاز عن الطبراني","عمرو بن دينار عن ابن عمر"
"14137","14100  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  أَحْمَدُ بْنُ طَارِقٍ الْوَابِشِيُّ ،  ثَنَا  بَشِيرُ بْنُ مَيْمُونٍ الْوَاسِطِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ يُوسُفَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ هَذِهِ الْقُلُوبَ أَوْعِيَةٌ فَخَيْرُهَا أَوْعَاهَا  ، فَإِذَا سَأَلْتُمُ اللهَ فَسَلُوهُ وَأَنْتُمْ وَاثِقُونَ بِالْإِجَابَةِ ، فَإِنَّ اللهَ لَا يَسْتَجِيبُ دُعَاءَ مَنْ دَعَاهُ عَنْ ظَهْرِ قَلْبٍ غَافِلٍ  .","","Al-Mu'jam al-Kabir 14100","","عبد الله بن عمر بن الخطاب عن عبد الله بن يوسف عن بشير بن ميمون الواسطي عن أحمد بن طارق الوابشي عن محمد بن عثمان بن أبي شيبة عن الطبراني","عمرو بن دينار عن ابن عمر"
"14138","[13/311]      14101  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَبُو الْمُغِيرَةِ ،  ثَنَا  صَفْوَانُ بْنُ عَمْرٍو ،  عَنْ  شُرَيْحِ بْنِ عُبَيْدٍ الْحَضْرَمِيِّ  أَنَّهُ سَمِعَ  الزُّبَيْرَ بْنَ الْوَلِيدِ  يُحَدِّثُ عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ بْنِ الْخَطَّابِ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا غَزَا أَوْ سَافَرَ فَأَدْرَكَهُ اللَّيْلُ ، قَالَ : "" يَا أَرْضُ ، رَبِّي وَرَبُّكِ اللهُ ،  أَعُوذُ بِاللهِ مِنْ شَرِّكِ وَشَرِّ مَا فِيكِ وَشَرِّ مَا خُلِقَ فِيكِ ، وَشَرِّ مَا دَبَّ عَلَيْكِ ، أَعُوذُ بِاللهِ مِنْ شَرِّ أَسَدٍ وَأَسْوَدَ وَحَيَّةٍ وَعَقْرَبٍ ، وَمِنْ سَاكِنِ  الْبَلَدِ  وَمِنْ وَالِدٍ وَمَا وَلَدَ  .","","Al-Mu'jam al-Kabir 14101","","عبد الله بن عمر بن الخطاب عن الزبير بن الوليد الشامي عن شريح بن عبيد المقرائي عن صفوان بن عمرو السكسكي عن عبد القدوس بن الحجاج عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","عمرو بن دينار عن ابن عمر"
"14139","[13/312]      14102  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ  ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى أَنْ تُتْبَعَ جِنَازَةٌ مَعَهَا رَانَّةٌ  .","","Al-Mu'jam al-Kabir 14102","","عبد الله بن عمر بن الخطاب عن شهر بن حوشب عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14140","14103  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ أَنَّ أَبَا عَنْبَسَةَ  حَدَّثَهُ  قَالَ :  حَجَجْتُ فَلَقِيتُ عَبْدَ اللهِ بْنَ عُمَرَ  فَسَأَلْتُهُ  ، وَقَدْ خَرَجَ  ابْنُ الزُّبَيْرِ  وَخَرَجَ إِلَيْهِ  الْحَجَّاجُ  بِالْجَيْشِ ، فَقَالَ : كَيْفَ تَرَى يَا  أَبَا عَبْدِ الرَّحْمَنِ  فِي حَجِّنَا ، فَإِنَّا نَتَخَوَّفُ أَنْ يُحَالَ بَيْنَنَا وَبَيْنَ  الْبَيْتِ  ؟ فَقَالَ  ابْنُ عُمَرَ  :  امْضُوا إِلَى  الْبَيْتِ  حَتَّى تَقْضُوا مَا عَلَيْكُمْ ، فَإِنْ حِيلَ بَيْنَكُمْ وَبَيْنَهُ صَنَعْتُمْ كَمَا صَنَعْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَحَرْتُمْ هَدْيًا إِنْ كَانَ مَعَكُمْ وَحَلَلْتُمْ فَرَجَعْتُمْ  .","","Al-Mu'jam al-Kabir 14103","","عبد الله بن عمر بن الخطاب عن سعيد بن عمرو بن سعيد بن العاص العذري عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14141","14104  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ ،  ثَنَا  أَبُو         [13/313]      الْمُغِيرَةِ ،  ثَنَا  عُمَرُ بْنُ عَمْرٍو الْأَحْمُوسِيُّ ،  عَنِ  الْمُخَارِقِ بْنِ أَبِي الْمُخَارِقِ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عُمَرَ يَقُولُ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  حَوْضِي كَمَا بَيْنَ  عَدَنَ  وَعَمَّانَ  ، أَبْرَدُ مِنَ الثَّلْجِ وَأَحْلَى مِنَ الْعَسَلِ وَأَطْيَبُ رِيحًا مِنَ الْمِسْكِ ، أَكَاوِيبُهُ مِثْلُ نُجُومِ السَّمَاءِ ، مَنْ شَرِبَ مِنْهُ شَرْبَةً لَمْ يَظْمَأْ بَعْدَهَا أَبَدًا ، أَوَّلُ النَّاسِ عَلَيْهِ وُرُودًا صَعَالِيكُ  الْمُهَاجِرِينَ  "" ، قَالَ  قَائِلٌ  : وَمَنْ هُمْ يَا رَسُولَ اللهِ ؟ قَالَ : "" الشَّعِثَةُ رُؤُوسُهُمُ ، الشَّحِبَةُ وُجُوهُهُمُ ، الدَّنِسَةُ ثِيَابُهُمُ ، الَّذِينَ لَا يُفْتَحُ لَهُمُ  السُّدَدُ  وَلَا يَنْكِحُونَ الْمُتَمَنِّعَاتِ الَّذِينَ يُعْطُونَ كُلَّ الَّذِي عَلَيْهِمْ وَلَا يَأْخُذُونَ الَّذِي لَهُمْ  .","","Al-Mu'jam al-Kabir 14104","","عبد الله بن عمر بن الخطاب عن مخارق بن أبي المخارق الأحموسي عن عمر بن عمرو الأحمسي عن عبد القدوس بن الحجاج عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","عمرو بن دينار عن ابن عمر"
"14142","[13/314]      14105  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ السَّمَيْدَعِ الْأَنْطَاكِيُّ ،  ثَنَا  مُوسَى بْنُ أَيُّوبَ النَّصِيبِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  عَبْدِ اللهِ بْنِ عِمْرَانَ الْحَضْرَمِيِّ ،  عَنْ  عُمَرَ بْنِ حُجْرٍ ،  عَنْ  عَبْدِ الْكَرِيمِ بْنِ الْحَارِثِ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْإِمَامُ الضَّعِيفُ مَلْعُونٌ  .","","Al-Mu'jam al-Kabir 14105","","عبد الله بن عمر بن الخطاب عن عبد الكريم بن الحارث بن يزيد الحضرمي عن عمر بن حجر عن عبد الله بن عمران الحضرمي عن بقية بن الوليد عن موسى بن أيوب النصيبي عن الحسين بن السميدع البجلي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14143","14106  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ بْنِ الْعَبَّاسِ بْنِ يَعْقُوبَ الْقُرَشِيُّ الدِّمَشْقِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ سَلَمَةَ الْأَزْدِيُّ ،  عَنْ  مَسْلَمَةَ بْنِ عَلِيٍّ الْخُشَنِيِّ ،  عَنْ  عُمَيْرِ بْنِ هَانِئٍ ،  عَنِ         [13/315]      ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  نَزَلَتْ سُورَةُ الْحَدِيدِ يَوْمَ الثُّلَاثَاءِ  ، وَخَلَقَ اللهُ الْحَدِيدَ يَوْمَ الثُّلَاثَاءِ ، وَقَتَلَ ابْنُ آدَمَ أَخَاهُ يَوْمَ الثُّلَاثَاءِ "" ، وَنَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْحِجَامَةِ يَوْمَ الثُّلَاثَاءِ  .","","Al-Mu'jam al-Kabir 14106","","عبد الله بن عمر بن الخطاب عن عمير بن هانئ الداراني عن مسلمة بن علي بن خلف الخشني عن الوليد بن سلمة الأردني عن العباس بن الفضل بن العباس القرشي عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14144","14107  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ الدِّمَشْقِيُّ ،  ثَنَا  عَلِيُّ بْنُ عَيَّاشٍ الْحِمْصِيُّ .  وَحَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ قَالَا :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ ثَابِتِ بْنِ ثَوْبَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَكْحُولٍ ،  عَنْ  جُبَيْرِ بْنِ نُفَيْرٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنِ  النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ يَقْبَلُ تَوْبَةَ الْعَبْدِ مَا لَمْ  يُغَرْغِرْ  .","","Al-Mu'jam al-Kabir 14107","","عبد الله بن عمر بن الخطاب عن جبير بن نفير بن مالك الحضرمي عن مكحول بن أبي مسلم عن ثابت بن ثوبان العبسي عن عبد الرحمن بن ثابت العنسي عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14145","[13/316]      14108  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ صَالِحٍ  ،  عَنِ  الْعَلَاءِ بْنِ الْحَارِثِ ،  عَنْ  زَيْدِ بْنِ أَرْطَاةَ ،  عَنْ  جُبَيْرِ بْنِ نُفَيْرٍ  أَنَّ  ابْنَ عُمَرَ  رَأَى فَتًى وَهُوَ يُصَلِّي قَدْ أَطَالَ صَلَاتَهُ وَأَطْنَبَ فِيهَا ، فَقَالَ : مَنْ يَعْرِفُ هَذَا ؟ فَقَالَ رَجُلٌ : أَنَا ، فَقَالَ عَبْدُ اللهِ بْنُ عُمَرَ : لَوْ كُنْتُ أَعْرِفُهُ لَأَمَرْتُهُ أَنْ يُطِيلَ الرُّكُوعَ وَالسُّجُودَ ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ الْعَبْدَ إِذَا قَامَ يُصَلِّي أُتِيَ بِذُنُوبِهِ فَجُعِلَتْ عَلَى رَأْسِهِ وَعَاتِقَيْهِ ، كُلَّمَا رَكَعَ وَسَجَدَ تَسَاقَطَتْ عَنْهُ  .","","Al-Mu'jam al-Kabir 14108","","عبد الله بن عمر بن الخطاب عن جبير بن نفير بن مالك الحضرمي عن زيد بن أرطأة الفزاري عن العلاء بن الحارث الرمادي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14146","[13/317]      14109  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عُزَيْزٍ الْمَوْصِلِيُّ ،  ثَنَا  غَسَّانُ بْنُ الرَّبِيعِ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ ثَابِتٍ ،  عَنْ  حَسَّانَ بْنِ عَطِيَّةَ ،  عَنْ  أَبِي مُنِيبٍ الْجُرَشِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بُعِثْتُ بَيْنَ يَدَيِ السَّاعَةِ بِالسَّيْفِ حَتَّى يُعْبَدَ اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ  ، وَجُعِلَ رِزْقِي تَحْتَ ظِلِّ رُمْحِي ، وَجُعِلَتِ الذِّلَّةُ وَالصَّغَارُ عَلَى مَنْ خَالَفَنِي ، وَمَنْ تَشَبَّهَ بِقَوْمٍ فَهُوَ مِنْهُمْ  .         [13/318]","","Al-Mu'jam al-Kabir 14109","","عبد الله بن عمر بن الخطاب عن أبو المنيب الأحدب عن حسان بن عطية المحاربي عن عبد الرحمن بن ثابت العنسي عن غسان بن الربيع الأزدي عن عبد الله بن محمد بن عزيز التميمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14147","14110  -  حَدَّثَنَا  مُوسَى بْنُ سَهْلٍ أَبُو عِمْرَانَ الْجَوْنِيُّ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  حَسَّانَ بْنِ عَطِيَّةَ ،  عَنْ  أَبِي الْمُنِيبِ الْجُرَشِيِّ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مِثْلَ حَدِيثِ  ابْنِ ثَوْبَانَ  .","","Al-Mu'jam al-Kabir 14110","","عبد الله بن عمر بن الخطاب عن أبو المنيب الأحدب عن حسان بن عطية المحاربي عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن هشام بن عمار عن موسى بن سهل الجوني عن الطبراني","عمرو بن دينار عن ابن عمر"
"14148","14111  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَيُّوبَ بْنِ عَافِيَةَ بْنِ أَيُّوبَ ،  حَدَّثَنِي  جَدِّي  ،  ثَنَا  مُعَاوِيَةُ بْنُ صَالِحٍ ،  حَدَّثَنِي  أَبُو الزَّاهِرِيَّةِ ،  عَنْ  كَثِيرِ بْنِ مُرَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ مِنْ عَلَامَاتِ الْبَلَاءِ وَأَشْرَاطِ السَّاعَةِ : أَنْ تَعْزُبَ الْعُقُولُ  ، وَتَنْقُصَ الْأَحْلَامُ ، وَيَكْثُرَ الْقَتْلُ ، وَتُرْفَعَ عَلَامَاتُ الْخَيْرِ ، وَتَظْهَرَ الْفِتَنُ  .","","Al-Mu'jam al-Kabir 14111","","عبد الله بن عمر بن الخطاب عن كثير بن مرة الرهاوي عن أبو الزاهرية حدير بن كريب عن معاوية بن صالح بن حدير الحضرمي عن عافية بن أيوب بن عبد الرحمن عن محمد بن أيوب بن عافية عن علي بن سعيد بن بشير عليك عن الطبراني","عمرو بن دينار عن ابن عمر"
"14149","14112  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ الْمَرْوَزِيُّ ،  ثَنَا         [13/319]      بَقِيَّةُ ،  عَنْ  سَعِيدِ بْنِ سِنَانٍ ،  ثَنَا  أَبُو الزَّاهِرِيَّةِ ،  عَنْ  كَثِيرِ بْنِ مُرَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ عَزَّ وَجَلَّ قَدْ رَفَعَ لِيَ الدُّنْيَا  ، فَأَنَا أَنْظُرُ إِلَيْهَا وَإِلَى مَا هُوَ كَائِنٌ فِيهَا إِلَى يَوْمِ الْقِيَامَةِ ، كَأَنَّمَا أَنْظُرُ إِلَى كَفِّي هَذِهِ ، جَلِيَّانِ مِنَ اللهِ جَلَاهُ لِنَبِيِّهِ كَمَا جَلَا لِلنَّبِيِّينَ مِنْ قَبْلِهِ  .","","Al-Mu'jam al-Kabir 14112","","عبد الله بن عمر بن الخطاب عن كثير بن مرة الرهاوي عن أبو الزاهرية حدير بن كريب عن سعيد بن سنان الحمصي عن بقية بن الوليد عن نعيم بن حماد الخزاعي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14150","14113  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  عَنْ  مُعَاوِيَةَ بْنِ صَالِحٍ ،  عَنْ  أَبِي الزَّاهِرِيَّةِ ،  عَنْ  كَثِيرِ بْنِ مُرَّةَ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَقِيمُوا الصُّفُوفَ فَإِنَّمَا تَصُفُّونَ بِصُفُوفِ الْمَلَائِكَةِ  ، وَحَاذُوا بَيْنَ الْمَنَاكِبِ وَسُدُّوا الْخَلَلَ ، وَلِينُوا فِي أَيْدِي إِخْوَانِكُمْ ، وَلَا تَذَرُوا فُرُجَاتِ الشَّيَاطِينِ ، مَنْ وَصَلَ صَفًّا وَصَلَهُ اللهُ ، وَمَنْ قَطَعَ صَفًّا قَطَعَهُ اللهُ  .","","Al-Mu'jam al-Kabir 14113","","عبد الله بن عمر بن الخطاب عن كثير بن مرة الرهاوي عن أبو الزاهرية حدير بن كريب عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"14151","[13/320]      14114  -  حَدَّثَنَا  مُحَمَّدُ بْنُ سُفْيَانَ بْنِ جَرِيرٍ الرَّمْلِيُّ  ،  ثَنَا  صَفْوَانُ بْنُ صَالِحٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  سَعِيدُ بْنُ سِنَانٍ ،  عَنْ  أَبِي الزَّاهِرِيَّةِ ،  عَنْ  كَثِيرِ بْنِ مُرَّةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الِارْتِدَاءُ لُبْسَةُ الْعَرَبِ  ، وَالِالْتِفَاعُ لُبْسَةُ الْإِيمَانِ "" ، وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَتَلَفَّعُ  .  كذا في طبعة الجريسي ولم أقف على من نسبه ( ابن جرير ) إلا الطبراني في معاجمه؛ وذكره من شيوخ الطبراني صاحب توضيح المشتبه (2 / 288) أما بقية كتب التراجم اتفقوا على أنه ( ابن المنذر الرملي ).","","Al-Mu'jam al-Kabir 14114","","عبد الله بن عمر بن الخطاب عن كثير بن مرة الرهاوي عن أبو الزاهرية حدير بن كريب عن سعيد بن سنان الحمصي عن الوليد بن مسلم القرشي عن صفوان بن صالح الدمشقي عن محمد بن سفيان الرملي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14152","14115  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  سَعِيدِ بْنِ سِنَانٍ ،  عَنْ  أَبِي الزَّاهِرِيَّةِ ،  عَنْ  أَبِي شَجَرَةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ  :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي  الْوِتْرِ  بِـ         {      سَبِّحِ اسْمَ رَبِّكَ         }      ، وَ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ، وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .","","Al-Mu'jam al-Kabir 14115","","عبد الله بن عمر بن الخطاب عن كثير بن مرة الرهاوي عن أبو الزاهرية حدير بن كريب عن سعيد بن سنان الحمصي عن الوليد بن مسلم القرشي عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14153","14116  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  سَعِيدِ بْنِ سِنَانٍ ،  عَنْ  أَبِي الزَّاهِرِيَّةِ ،  عَنْ  أَبِي شَجَرَةَ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِقَامَةُ حَدٍّ مِنْ حُدُودِ اللهِ         [13/321]      خَيْرٌ مِنْ تَنْزِيلِ غَيْثٍ أَرْبَعِينَ لَيْلَةً فِي بِلَادِ اللهِ  "" .","","Al-Mu'jam al-Kabir 14116","","عبد الله بن عمر بن الخطاب عن كثير بن مرة الرهاوي عن أبو الزاهرية حدير بن كريب عن سعيد بن سنان الحمصي عن الوليد بن مسلم القرشي عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14154","14117  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ شُجَاعِ بْنِ الْوَلِيدِ ،  ثَنَا  مَسْلَمَةُ بْنُ عُلَيٍّ ،  ثَنَا  سَعِيدُ بْنُ سِنَانٍ ،  عَنْ  أَبِي الزَّاهِرِيَّةِ ،  عَنْ  كَثِيرِ بْنِ مُرَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ سَلَّمَ عَلَى عِشْرِينَ رَجُلًا مِنَ الْمُسْلِمِينَ فِي يَوْمٍ  ، جَمَاعَةٍ أَوْ فُرَادَى ، ثُمَّ مَاتَ مِنْ يَوْمِهِ ذَلِكَ وَجَبَتْ لَهُ الْجَنَّةُ ، وَفِي لَيْلَتِهِ مِثْلُ ذَلِكَ  .","","Al-Mu'jam al-Kabir 14117","","عبد الله بن عمر بن الخطاب عن كثير بن مرة الرهاوي عن أبو الزاهرية حدير بن كريب عن سعيد بن سنان الحمصي عن مسلمة بن علي بن خلف الخشني عن الوليد بن شجاع عن ابن الرازي محمد بن جعفر البغدادى عن الطبراني","عمرو بن دينار عن ابن عمر"
"14155","14118  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَيُّوبَ بْنِ عَافِيَةَ بْنِ أَيُّوبَ ،  حَدَّثَنِي  جَدِّي  ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  أَبِي الزَّاهِرِيَّةِ ،  عَنْ  كَثِيرِ بْنِ مُرَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيَفْتِنَنَّ أُمَّتِي بَعْدِي فِتَنٌ  كَقِطَعِ  اللَّيْلِ الْمُظْلِمِ  ، يُصْبِحُ الرَّجُلُ فِيهَا مُؤْمِنًا وَيُمْسِي كَافِرًا ، وَيُمْسِي مُؤْمِنًا وَيُصْبِحُ كَافِرًا ، يَبِيعُ أَقْوَامٌ فِيهَا دِينَهُمْ بِعَرَضٍ مِنَ الدُّنْيَا قَلِيلٍ  .","","Al-Mu'jam al-Kabir 14118","","عبد الله بن عمر بن الخطاب عن كثير بن مرة الرهاوي عن أبو الزاهرية حدير بن كريب عن معاوية بن صالح بن حدير الحضرمي عن عافية بن أيوب بن عبد الرحمن عن محمد بن أيوب بن عافية عن علي بن سعيد بن بشير عليك عن الطبراني","عمرو بن دينار عن ابن عمر"
"14156","[13/322]      14119  -  حَدَّثَنَا  الْفَضْلُ بْنُ هَارُونَ الْبَغْدَادِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ التَّرْجُمَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ الْكَلَاعِيِّ  ،  عَنْ  أَبِي عَبْدِ اللهِ الْقُرَشِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الصُّفْرَةُ خِضَابُ الْمُؤْمِنِ  ، وَالْحُمْرَةُ خِضَابُ الْمُسْلِمِ ، وَالسَّوَادُ خِضَابُ الْكَافِرِ  .  كذا في طبعة الجريسي ، والصواب : ( الكلابي )","","Al-Mu'jam al-Kabir 14119","","عبد الله بن عمر بن الخطاب عن أبو عبد الله القرشي عن سالم بن عبد الله الرقي عن إسماعيل بن عياش الأحول عن إسماعيل بن إبراهيم الترجماني عن الفضل بن هارون البغدادي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14157","14120  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَبَنَا  ابْنُ لَهِيعَةَ ،  عَنِ  الْحَارِثِ بْنِ يَزِيدَ ،  عَنِ  ابْنِ حُجَيْرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَرْبَعٌ إِذَا كُنَّ فِيكَ فَلَا عَلَيْكَ مَا فَاتَكَ مِنَ الدُّنْيَا : حِفْظُ الْأَمَانَةِ  ، وَصِدْقُ حَدِيثٍ ، وَحُسْنُ خَلِيقَةٍ ،  وَعِفَّةُ  طَعْمٍ  .","","Al-Mu'jam al-Kabir 14120","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن حجيرة الخولاني عن الحارث بن يزيد الحضرمي عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","عمرو بن دينار عن ابن عمر"
"14158","[13/323]      14121  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَبَنَا  ابْنُ لَهِيعَةَ ،  عَنِ  الْحَارِثِ بْنِ يَزِيدَ ،  عَنِ  ابْنِ حُجَيْرَةَ الْأَكْبَرِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا  حَسَدَ  إِلَّا عَلَى اثْنَتَيْنِ  ; رَجُلٍ أَعْطَاهُ اللهُ الْقُرْآنَ فَهُوَ يَقْرَأُ بِهِ بِاللَّيْلِ وَالنَّهَارِ ، وَرَجُلٍ أَعْطَاهُ اللهُ مَالًا فَأَنْفَقَهُ فِي  سَبِيلِ  اللهِ أَوْ فِي طَاعَةِ اللهِ  .","","Al-Mu'jam al-Kabir 14121","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن حجيرة الخولاني عن الحارث بن يزيد الحضرمي عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","عمرو بن دينار عن ابن عمر"
"14159","14122  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  أَبِي غُطَيْفٍ ، قَالَ : كُنْتُ عِنْدَ ابْنِ عُمَرَ ،  فَقَالَ  : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ تَوَضَّأَ عَلَى طُهْرٍ كَتَبَ اللهُ لَهُ عَشْرَ حَسَنَاتٍ  .","","Al-Mu'jam al-Kabir 14122","","عبد الله بن عمر بن الخطاب عن أبو غطيف الهذلي عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عيسى بن يونس بن أبي إسحاق عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14160","[13/324]      14123  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ،  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَبْدُ الرَّحْمَنِ بْنُ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  يَزِيدَ بْنِ قَاسِطٍ السَّكْسَكِيِّ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنِ الصِّيَامِ فِي السَّفَرِ ؟ فَقَالَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَصُومُ فِي السَّفَرِ وَيُفْطِرُ  ، وَأَنَا أَصُومُ وَأُفْطِرُ  .","","Al-Mu'jam al-Kabir 14123","","عبد الله بن عمر بن الخطاب عن يزيد بن قاسط عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14161","14124  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  أَبُو طُعْمَةَ ، قَالَ :  كُنْتُ عِنْدَ ابْنِ عُمَرَ إِذْ جَاءَهُ         [13/325]      رَجُلٌ فَقَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، إِنِّي أَقْوَى عَلَى الصِّيَامِ فِي السَّفَرِ ؟  فَقَالَ  ابْنُ عُمَرَ  : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ لَمْ يَقْبَلْ رُخْصَةَ اللهِ كَانَ عَلَيْهِ مِنَ الْإِثْمِ مِثْلُ  جِبَالِ عَرَفَةَ  .","","Al-Mu'jam al-Kabir 14124","","عبد الله بن عمر بن الخطاب عن أبو طعمة الأموي مولى عمر بن عبد العزيز عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14162","14125  -  حَدَّثَنَا  مَسْعُودُ بْنُ مُحَمَّدٍ الرَّمْلِيُّ أَبُو الْجَارُودِ ،  حَدَّثَنَا  عِمْرَانُ بْنُ هَارُونَ الرَّمْلِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  أَبُو طُعْمَةَ  أَنَّهُ سَمِعَ  ابْنَ عُمَرَ يَقُولُ : كُنْتُ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَسَمِعْتُهُ يَقُولُ :  إِنَّ اللهَ لَعَنَ الْخَمْرَ  ، وَعَاصِرَهَا ، وَمُعْتَصِرَهَا ، وَشَارِبَهَا ، وَسَاقِيَهَا ، وَحَامِلَهَا ، وَالْمَحْمُولَةَ إِلَيْهِ ، وَبَائِعَهَا ، وَمُشْتَرِيَهَا ، وَآكِلَ ثَمَنِهَا  .","","Al-Mu'jam al-Kabir 14125","","عبد الله بن عمر بن الخطاب عن أبو طعمة الأموي مولى عمر بن عبد العزيز عن عبد الله بن لهيعة عن الصوفي عمران بن أبى عمران عن مسعود بن محمد الرملي أبو الجارود عن الطبراني","عمرو بن دينار عن ابن عمر"
"14163","14126  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ وَأَبُو يَزِيدَ الْقَرَاطِيسِيُّ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَبَنَا  نَافِعُ بْنُ يَزِيدَ ،         [13/326]      حَدَّثَنِي  أَبُو هَانِئٍ ،  عَنْ  عَبَّاسٍ الْحَجْرِيِّ  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عُمَرَ يَقُولُ :  سُئِلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ; كَمْ نَغْفِرُ لِمَمَالِيكِنَا ؟ قَالَ :  تَعْفُو عَنْهُمْ كُلَّ يَوْمٍ سَبْعِينَ مَرَّةً  .","","Al-Mu'jam al-Kabir 14126","","عبد الله بن عمر بن الخطاب عن عباس بن جليد الحجري عن حميد بن هانئ الخولاني عن نافع بن يزيد الكلاعي عن سعيد بن الحكم الجمحي عن يوسف بن يزيد القراطيسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14164","14127  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ،  أَبَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنِي  أَبُو هَانِئٍ الْخَوْلَانِيُّ ،  عَنْ  عَبَّاسِ بْنِ جُلَيْدٍ الْحَجْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ أَنَّهُ سَمِعَهُ يَقُولُ :  جَاءَ  رَجُلٌ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا نَبِيَّ اللهِ كَمْ نَعْفُو عَنِ الْخَادِمِ ؟ فَصَمَتَ ، ثُمَّ أَعَادَ عَلَيْهِ الْكَلَامَ فَصَمَتَ ، فَلَمَّا كَانَتِ الثَّالِثَةُ قَالَ :  اعْفُ عَنْهُ سَبْعِينَ مَرَّةً كُلَّ يَوْمٍ  .","","Al-Mu'jam al-Kabir 14127","","عبد الله بن عمر بن الخطاب عن عباس بن جليد الحجري عن حميد بن هانئ الخولاني عن عبد الله بن وهب المصري عن عبد الله بن عبد الحكم بن أعين عن يوسف بن يزيد القراطيسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14165","[13/327]      14128  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  إِسْحَاقُ بْنُ بَكْرِ بْنِ مُضَرَ ،  ثَنَا  أَبِي  ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنْ  عُقْبَةَ بْنِ مُسْلِمٍ قَالَ :  سَأَلْتُ  عَبْدَ اللهِ بْنَ عُمَرَ عَنِ  الْوِتْرِ  ؟ قَالَ : بَيْنَمَا نَحْنُ فِي الْمَسْجِدِ قَامَ  رَجُلٌ  فَسَأَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْوِتْرِ  وَعَنْ صَلَاةِ اللَّيْلِ ؟ فَقَالَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ، فَإِذَا أَصْبَحْتَ وَخَشِيتَ الصُّبْحَ  فَأَوْتِرْ  بِوَاحِدَةٍ  .","","Al-Mu'jam al-Kabir 14128","","عبد الله بن عمر بن الخطاب عن عقبة بن مسلم التجيبي عن جعفر بن ربيعة الكندي عن بكر بن مضر المصري عن إسحاق بن بكر بن مضر المصري عن يحيى بن عثمان بن صالح عن الطبراني","عمرو بن دينار عن ابن عمر"
"14166","14129  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ،  حَدَّثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ أَنَّ عَبْدَ اللهِ بْنَ رَافِعٍ الْحَضْرَمِيَّ  حَدَّثَهُ  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عُمَرَ يَقُولُ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَبْدَأُ بِالصَّلَاةِ فِي الْفِطْرِ وَالْأَضْحَى  .","","Al-Mu'jam al-Kabir 14129","","عبد الله بن عمر بن الخطاب عن عبد الله بن رافع الغافقي عن جعفر بن ربيعة الكندي عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن أحمد بن محمد بن الحجاج المصري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14167","[13/328]      14130  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ،  ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شَرَاحِيلَ بْنِ بُكَيْلٍ الْخَوْلَانِيِّ ،  عَنْ  أَبِيهِ  أَنَّهُ سَأَلَ  عَبْدَ اللهِ بْنَ عُمَرَ عَنِ الْعَصِيرِ ؟ فَقَالَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  قَاتَلَ  اللهُ الْيَهُودَ ، حُرِّمَتْ عَلَيْهِمُ  الشُّحُومُ  فَبَاعُوهَا وَأَكَلُوا أَثْمَانَهَا  .","","Al-Mu'jam al-Kabir 14130","","عبد الله بن عمر بن الخطاب عن شراحيل بن بكيل الخولاني عن ابن شراحيل بن بلال الخولاني عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن أحمد بن محمد بن الحجاج المصري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14168","14131  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  خَالِدِ بْنِ يَزِيدَ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ،  عَنْ  رَبِيعَةَ بْنِ سَيْفٍ قَالَ : كُنَّا عِنْدَ شُفَيٍّ الْأَصْبَحِيِّ قَالَ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ ، فَقَالَ :  الْتَفَتَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  عُثْمَانَ  رَضِيَ اللهُ عَنْهُ ، فَقَالَ :  يَا  عُثْمَانُ  ، إِنْ كَسَاكَ اللهُ قَمِيصًا فَأَرَادَكَ النَّاسُ عَلَى  خَلْعِهِ  فَلَا تَخْلَعْهُ  ، فَوَاللهِ لَئِنْ خَلَعْتَهُ لَا تَرَى الْجَنَّةَ حَتَّى يَلِجَ الْجَمَلُ فِي سَمِّ  الْخِيَاطِ  "" .","","Al-Mu'jam al-Kabir 14131","","عبد الله بن عمر بن الخطاب عن شفي بن ماتع الأصبحي عن ربيعة بن سيف المعافري عن سعيد بن أبي هلال الليثي عن خالد بن يزيد الجمحي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14169","[13/329]      وَسَمِعْتُ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَكُونُ بَعْدِي اثْنَا عَشَرَ  خَلِيفَةً  :  أَبُو بَكْرٍ الصِّدِّيقُ  لَا يَلْبَثُ بَعْدِي إِلَّا يَسِيرًا ، وَصَاحِبُ رَحَى دَارَةِ الْعَرَبِ يَعِيشُ حَمِيدًا وَيُقْتَلُ  شَهِيدًا  "" .  فَقَالَ  رَجُلٌ  : مَنْ هُوَ يَا رَسُولَ اللهِ ؟ قَالَ : ""  عُمَرُ بْنُ الْخَطَّابِ  .","","Al-Mu'jam al-Kabir 14169","","عبد الله بن عمر بن الخطاب عن شفي بن ماتع الأصبحي عن ربيعة بن سيف المعافري عن سعيد بن أبي هلال الليثي عن خالد بن يزيد الجمحي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14170","14132  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ النِّيلِ الْفِهْرِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَالنَّاسُ يَتَنَفَّلُونَ بَعْدَ طُلُوعِ الْفَجْرِ ، وَقَالَ :  إِنَّهُ لَا صَلَاةَ بَعْدَ طُلُوعِ الْفَجْرِ إِلَّا رَكْعَتَانِ  .","","Al-Mu'jam al-Kabir 14132","","عبد الله بن عمر بن الخطاب عن محمد بن النيل الفهري عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14171","[13/330]      14133  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَبَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ النِّيلِ أَنَّ أَبَا بَكْرِ بْنَ يَزِيدَ بْنِ سَرْجِسَ ،  حَدَّثَهُ  أَنَّ عَبْدَ اللهِ بْنَ عُمَرَ رَأَى مَوْلًى لَهُ - يُقَالُ لَهُ :  يَسَارٌ  - يُصَلِّي بَعْدَ طُلُوعِ الْفَجْرِ ، فَقَالَ : مَا هَذِهِ الصَّلَاةُ ؟ قَالَ : شَيْءٌ بَقِيَ عَلَيَّ مِنْ  حِزْبِي  ،  فَقَالَ  ابْنُ عُمَرَ  : خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعْدَ صَلَاةِ الْفَجْرِ ، فَقَالَ :  إِذَا طَلَعَ الْفَجْرُ فَلَا صَلَاةَ إِلَّا رَكْعَتَيْنِ ، فَلْيُبَلِّغِ  الشَّاهِدُ  الْغَائِبَ  .","","Al-Mu'jam al-Kabir 14133","","عبد الله بن عمر بن الخطاب عن أبو بكر بن يزيد بن سرجس عن محمد بن النيل الفهري عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","عمرو بن دينار عن ابن عمر"
"14172","14134  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  حَجَّاجُ بْنُ إِبْرَاهِيمَ الْأَزْرَقُ ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ الْيَمَامِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ بَدْرٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نَزَلَ الْقُرْآنُ بِالْمَسْحِ ، فَأَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْغُسْلِ فَغَسَلْنَا  .","","Al-Mu'jam al-Kabir 14134","","عبد الله بن عمر بن الخطاب عن عبد الله بن بدر بن عميرة السحيمي عن محمد بن جابر بن سيار عن حجاج بن إبراهيم الأبناوي عن يوسف بن يزيد القراطيسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14173","[13/331]      14135  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  حَدَّثَنَا  يُوسُفُ بْنُ عَدِيٍّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  بَزِيعٍ أَبِي عُمَرَ مَوْلَى بَنِي مَخْزُومٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ لُبْسَتَيْنِ : الْمَشْهُورَةِ فِي حُسْنِهَا  ، وَالْمَشْهُورَةِ فِي قُبْحِهَا  .","","Al-Mu'jam al-Kabir 14135","","عبد الله بن عمر بن الخطاب عن بزيع المخزومي مولاهم عن معتمر بن سليمان عن يوسف بن عدي بن رزق الكوفي عن روح بن الفرج القطان عن الطبراني","عمرو بن دينار عن ابن عمر"
"14174","14136  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  الْحَكَمُ بْنُ مَرْوَانَ ،  حَدَّثَنَا  فُرَاتُ بْنُ السَّائِبِ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْغَيْبَةِ  وَعَنِ الِاسْتِمَاعِ إِلَى الْغَيْبَةِ  .","","Al-Mu'jam al-Kabir 14136","","عبد الله بن عمر بن الخطاب عن ميمون بن مهران الرقي عن فرات بن السائب الجزري عن الحكم بن مروان الكوفي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14175","[13/332]      14137  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  الْحَكَمُ بْنُ مَرْوَانَ ،  ثَنَا  فُرَاتُ بْنُ السَّائِبِ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ النَّمِيمَةِ  وَالِاسْتِمَاعِ إِلَى النَّمِيمَةِ  .","","Al-Mu'jam al-Kabir 14137","","عبد الله بن عمر بن الخطاب عن ميمون بن مهران الرقي عن فرات بن السائب الجزري عن الحكم بن مروان الكوفي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14176","14138  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  الْحَكَمُ بْنُ مَرْوَانَ ،  ثَنَا  فُرَاتُ بْنُ السَّائِبِ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ  يُتَخَلَّى  عَلَى ضَفَّةِ نَهَرٍ جَارٍ  .","","Al-Mu'jam al-Kabir 14138","","عبد الله بن عمر بن الخطاب عن ميمون بن مهران الرقي عن فرات بن السائب الجزري عن الحكم بن مروان الكوفي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14177","[13/333]      14139  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ الْعَبْدِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ كَثِيرٍ ،  ثَنَا  فُرَاتُ بْنُ السَّائِبِ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  أَرَادَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَبْعَثَ رَجُلًا فِي حَاجَةٍ قَدْ أَهَمَّتْهُ ،  وَأَبُو بَكْرٍ  عَنْ يَمِينِهِ  وَعُمَرُ  عَنْ يَسَارِهِ ، فَقَالَ لَهُ  عَلِيٌّ  : مَا يَمْنَعُكَ مِنْ هَذَيْنِ ؟ فَقَالَ :  كَيْفَ أَبْعَثُ هَذَيْنِ وَهُمَا مِنَ الدِّينِ بِمَنْزِلَةِ السَّمْعِ وَالْبَصَرِ مِنَ الرَّأْسِ ؟!  .","","Al-Mu'jam al-Kabir 14139","","عبد الله بن عمر بن الخطاب عن ميمون بن مهران الرقي عن فرات بن السائب الجزري عن سليمان بن كثير الأصيد عن محمد بن كثير العبدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14178","14140  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عِقَالٍ الْحَرَّانِيُّ ،  ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ قَالَ :  قَرَأْتُ عَلَى  مَعْقِلِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  مَيْمُونِ بْنِ         [13/334]      مِهْرَانَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  ذَكَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمَجُوسَ ، فَقَالَ :  إِنَّهُمْ يُوفُونَ سِبَالَهُمْ وَيَحْلِقُونَ لِحَاهُمْ  ،  فَكَانَ ابْنُ عُمَرَ يَسْتَعْرِضُ  سَبَلَتَهُ  فَيَجُزُّهَا كَمَا تُجَزُّ الشَّاةُ  .","","Al-Mu'jam al-Kabir 14140","","عبد الله بن عمر بن الخطاب عن ميمون بن مهران الرقي عن معقل بن عبيد الله الجزري عن عبد الله بن محمد النفيلي عن أحمد بن عبد الرحمن بن يزيد الحراني عن الطبراني","عمرو بن دينار عن ابن عمر"
"14179","14141  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  يَزِيدَ بْنِ سِنَانٍ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أُرِيدَ مَالُهُ فَقَاتَلَ فَقُتِلَ فَهُوَ  شَهِيدٌ  .","","Al-Mu'jam al-Kabir 14141","","عبد الله بن عمر بن الخطاب عن ميمون بن مهران الرقي عن يزيد بن سنان الرهاوي عن مروان بن معاوية الفزاري عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14180","14142  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  عِيسَى بْنُ سَالِمٍ الشَّاشِيُّ ،  ثَنَا  أَبُو الْمَلِيحِ الرَّقِّيُّ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عُمَرَ أَنَّهُ طَلَّقَ         [13/335]      امْرَأَتَهُ فِي حَيْضِهَا ، فَبَلَغَ ذَلِكَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَأَمَرَهُ أَنْ يُرَاجِعَهَا وَلَا يُجَامِعَهَا حَتَّى تَطْهُرَ  ، فَإِذَا طَهُرَتْ فَإِنْ شَاءَ طَلَّقَ وَإِنْ شَاءَ أَمْسَكَ  .","","Al-Mu'jam al-Kabir 14142","","عبد الله بن عمر بن الخطاب عن ميمون بن مهران الرقي عن الحسن بن عمر الفزاري عن عيسى بن سالم الشاشي عن موسى بن هارون الحمال عن الطبراني","عمرو بن دينار عن ابن عمر"
"14181","14143  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ عَاصِمٍ ،  ثَنَا  أَبُو الْمَلِيحِ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ قَالَ :  سَأَلَ  رَجُلٌ ابْنَ عُمَرَ عَنْ قَوْلِ اللهِ عَزَّ وَجَلَّ :         {      وَقَاتِلُوهُمْ حَتَّى لا تَكُونَ فِتْنَةٌ         }      ؟ قَالَ :  قَدْ قَاتَلْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى لَمْ تَكُنْ فِتْنَةٌ  ، فَاذْهَبْ أَنْتَ وَأَصْحَابُكَ فَقَاتِلُوا حَتَّى تَكُونَ فِتْنَةٌ  .","","Al-Mu'jam al-Kabir 14143","","عبد الله بن عمر بن الخطاب عن ميمون بن مهران الرقي عن الحسن بن عمر الفزاري عن عبد الجبار بن عاصم الخراساني عن موسى بن هارون الحمال عن الطبراني","عمرو بن دينار عن ابن عمر"
"14182","14144  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَارِثِ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الْبَيْلَمَانِيُّ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  شُفْعَةَ  لِغَائِبٍ وَلَا صَغِيرٍ         [13/336]      وَلَا شَرِيكٍ عَلَى شَرِيكٍ إِذَا سَبَقَهُ بِالشَّرَى ،  وَالشُّفْعَةُ  كَحَلِّ  الْعِقَالِ  .","","Al-Mu'jam al-Kabir 14144","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن البيلماني المدني عن محمد بن عبد الرحمن ابن البيلماني الكوفي عن محمد بن الحارث بن زياد البصري عن عفان بن مسلم الصفار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14183","14145  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عُثَيْمٍ يَقُولُ :  حَدَّثَنِي  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الْبَيْلَمَانِيُّ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سُئِلَ : مَا يَجُوزُ فِي الرَّضَاعِ مِنَ الشُّهُودِ ؟ فَقَالَ : "" رَجُلٌ وَامْرَأَتُهُ  .","","Al-Mu'jam al-Kabir 14145","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن البيلماني المدني عن محمد بن عبد الرحمن ابن البيلماني الكوفي عن محمد بن عثيم النجرانى عن معتمر بن سليمان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14184","14146  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الرَّبِيعِ بْنِ ثَعْلَبٍ ،  ثَنَا  أَبِي  ،  ثَنَا         [13/337]      الْمُسَيِّبُ بْنُ شَرِيكٍ ،  عَنْ  جَعْفَرِ بْنِ الْعَبَّاسِ ،  عَنِ  ابْنِ الْبَيْلَمَانِيِّ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الدَّيْنُ دَيْنَانِ : فَمَنْ مَاتَ وَهُوَ يَنْوِي قَضَاءَهُ فَأَنَا وَلِيُّهُ  ، وَمَنْ مَاتَ وَلَا يَنْوِي قَضَاءَهُ فَذَلِكَ الَّذِي يُؤْخَذُ مِنْ حَسَنَاتِهِ ، لَيْسَ يَوْمَئِذٍ دِينَارٌ وَلَا دِرْهَمٌ  .","","Al-Mu'jam al-Kabir 14146","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن البيلماني المدني عن محمد بن عبد الرحمن ابن البيلماني الكوفي عن جعفر بن العباس الكوفي عن المسيب بن شريك الشقري عن الربيع بن ثعلب المروزي عن العباس بن الربيع بن ثعلب البغدادي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14185","14147  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الرَّبِيعِ بْنِ ثَعْلَبٍ ،  ثَنَا  أَبِي  ،  ثَنَا  الْمُسَيِّبُ بْنُ شَرِيكٍ ،  عَنْ  جَعْفَرِ بْنِ الْعَبَّاسِ ،  عَنِ  ابْنِ الْبَيْلَمَانِيِّ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ :  قَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، دُلَّنِي عَلَى عَمَلٍ يَنْفَعُنِي اللهُ بِهِ ، قَالَ :  عَلَيْكَ بِرَكْعَتَيِ الْفَجْرِ ; فَإِنَّ فِيهِمَا فَضِيلَةً  .","","Al-Mu'jam al-Kabir 14147","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن البيلماني المدني عن محمد بن عبد الرحمن ابن البيلماني الكوفي عن جعفر بن العباس الكوفي عن المسيب بن شريك الشقري عن الربيع بن ثعلب المروزي عن العباس بن الربيع بن ثعلب البغدادي عن الطبراني","عمرو بن دينار عن ابن عمر"
"14186","14148  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  عُثْمَانَ بْنِ يَزْدَوَيْهِ ،  عَنْ  يَعْفُرَ بْنِ رُوذِيٍّ قَالَ :  سَمِعْتُ  عُبَيْدَ بْنَ عُمَيْرٍ وَهُوَ يَقُصُّ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَثَلُ الْمُنَافِقِ مَثَلُ الشَّاةِ الرَّابِضَةِ بَيْنَ الْغَنَمَيْنِ "" ، فَقَالَ ابْنُ عُمَرَ : وَيْلَكُمْ ! لَا تَكْذِبُوا         [13/338]      عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِنَّمَا قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَثَلُ الْمُنَافِقِ مَثَلُ الشَّاةِ  الْيَاعِرَةِ  بَيْنَ الْغَنَمَيْنِ  .","","Al-Mu'jam al-Kabir 14148","","عبد الله بن عمر بن الخطاب عن عبيد بن عمير بن قتادة الجندعي عن يعفر بن روذي عن عثمان بن يزدويه الصنعاني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14187","14149  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَبَنَا  عَبْدُ اللهِ بْنُ بَحِيرٍ قَالَ :  سَمِعْتُ  عَبْدَ الرَّحْمَنِ بْنَ يَزِيدَ الصَّنْعَانِيَّ يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سَرَّهُ أَنْ يَنْظُرَ إِلَى يَوْمِ الْقِيَامَةِ كَأَنَّهُ بِرَأْيِ الْعَيْنِ فَلْيَقْرَأْ :         {      إِذَا الشَّمْسُ كُوِّرَتْ         }      ، وَ         {      إِذَا السَّمَاءُ انْشَقَّتْ         }      ، وَ         {      إِذَا السَّمَاءُ انْفَطَرَتْ         }      ، وَأَحْسَبُهُ ذَكَرَ سُورَةَ  هُودٍ  .","","Al-Mu'jam al-Kabir 14149","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن يزيد الأبناوي عن عبد الله بن بحير بن ريسان المرادي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"14188","[13/339]      عَبْدُ اللهِ بْنُ عَمْرِو بْنِ الْعَاصِ ، يُكْنَى أَبَا مُحَمَّدٍ  ذِكْرُ سِنِّهِ وَوَفَاتِهِ وَمِنْ أَخْبَارِهِ  14150  -  ذَكَرَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ  ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  قَالَ :  تُوُفِّيَ  عَبْدُ اللهِ بْنُ عَمْرِو بْنِ الْعَاصِ ، وَيُكْنَى أَبَا مُحَمَّدٍ  ،  بِمِصْرَ  . وَدُفِنَ فِي دَارِهِ الصَّغِيرَةِ سَنَةَ خَمْسٍ وَسِتِّينَ ، وَقَائِلٌ يَقُولُ : سَنَةَ ثَمَانٍ وَسِتِّينَ ،  وَسِنُّهُ ثِنْتَانِ وَسَبْعُونَ سَنَةً أَوْ ثِنْتَانِ وَتِسْعُونَ سَنَةً  ،  شَكَّ  يَحْيَى بْنُ بُكَيْرٍ  فِي السَّبْعِينَ وَالتِّسْعِينَ  .","","Al-Mu'jam al-Kabir 14150","","","ذكر سنه ووفاته ومن أخباره"
"14189","14151  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ قَالَ :  مَاتَ عَبْدُ اللهِ بْنُ عَمْرٍو سَنَةَ خَمْسٍ وَسِتِّينَ  .","","Al-Mu'jam al-Kabir 14151","","عبد الله بن عمرو بن العاص عن محمد بن عبد الله بن نمير عن عبيد بن غنام النخعي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14190","14152  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ  ،  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ  ،  ثَنَا  ابْنُ وَهْبٍ  ،  أَخْبَرَنِي  حُمَيْدُ بْنُ هَانِئٍ أَبُو هَانِئٍ  أَنَّهُ سَمِعَ         [13/340]      أَبَا عَبْدِ الرَّحْمَنِ الْحُبُلِيَّ  يَقُولُ :  جَاءَ ثَلَاثَةُ نَفَرٍ إِلَى  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ  وَأَنَا عِنْدَهُ  ، فَقَالُوا : يَا  أَبَا مُحَمَّدٍ  .","","Al-Mu'jam al-Kabir 14152","","","ذكر سنه ووفاته ومن أخباره"
"14191","14153  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ،  ثَنَا  قَبِيصَةُ بْنُ عُقْبَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  خُلِقَتِ  الْكَعْبَةُ  قَبْلَ الْأَرْضِ بِأَلْفَيْ عَامٍ  ، وَدُحِيَتِ الْأَرْضُ مِنْ تَحْتِهَا  .","","Al-Mu'jam al-Kabir 14153","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن سفيان الثوري عن قبيصة بن عقبة السوائي عن حفص بن عمر سنجة ألف عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14192","[13/341]      14154  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  بُكَيْرِ بْنِ الْأَخْنَسِ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  وُضِعَ  الْبَيْتُ  قَبْلَ الْأَرْضِ بِأَلْفَيْ سَنَةٍ  ، وَكَانَ  الْبَيْتُ  زُبْدَةً بَيْضَاءَ حِينَ كَانَ الْعَرْشُ عَلَى الْمَاءِ ، وَكَانَتِ الْأَرْضُ تَحْتَهُ كَأَنَّهَا حَشَفَةٌ ، فَدُحِيَتْ مِنْهُ  .","","Al-Mu'jam al-Kabir 14154","","عبد الله بن عمرو بن العاص عن عطاء بن أبي رباح عن بكير بن الأخنس السدوسي عن الأعمش عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14193","14155  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  أَنَا  أَبِي  ،  أَبَنَا  مُعَاوِيَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  بُكَيْرِ بْنِ الْأَخْنَسِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو نَحْوَهُ ، قَالَ :  وَكَانَ  الْبَيْتُ  زُبْدَةً  .","","Al-Mu'jam al-Kabir 14155","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن بكير بن الأخنس السدوسي عن الأعمش عن معاوية بن هشام القصار عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14194","[13/342]      14156  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  وُضِعَ  الْحَرَمُ  قَبْلَ الْأَرْضِ بِأَلْفَيْ عَامٍ  ، وَدُحِيَتِ الْأَرْضُ مِنْ تَحْتِهِ .  قَالَ مُجَاهِدٌ :  وَقَوْلُهُ         {      فَاجْعَلْ أَفْئِدَةً مِنَ النَّاسِ تَهْوِي إِلَيْهِمْ         }      ، قَالَ :  لَوْ قَالَ : أَفْئِدَةُ النَّاسِ لَازْدَحَمَتْ عَلَيْهِ  فَارِسُ  وَالرُّومُ  .","","Al-Mu'jam al-Kabir 14156","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14195","14157  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ،         [13/343]      قَالَ :  لَمَّا أَهْبَطَ اللهُ  آدَمَ  مِنَ الْجَنَّةِ  قَالَ : إِنِّي مُهْبِطٌ مَعَكَ  بَيْتًا أَوْ مَنْزِلًا  يُطَافُ حَوْلَهُ كَمَا يُطَافُ حَوْلَ عَرْشِي ، وَيُصَلَّى عِنْدَهُ كَمَا يُصَلَّى حَوْلَ عَرْشِي .  فَلَمَّا كَانَ زَمَانُ الطُّوفَانِ رُفِعَ ، وَكَانَ الْأَنْبِيَاءُ يَحُجُّونَهُ وَلَا يَعْلَمُونَ مَكَانَهُ ، فَبَوَّأَهُ  لِإِبْرَاهِيمَ  ، فَبَنَاهُ مِنْ خَمْسَةِ أَجْبُلٍ : مِنْ  حِرَاءٍ  ،  وَثَبِيرٍ  ،  وَلُبْنَانَ  ،  وَجَبَلِ الطُّورِ  ،  وَجَبَلِ الْحَبْرِ  ; فَتَمَتَّعُوا مِنْهُ مَا اسْتَطَعْتُمْ  .","","Al-Mu'jam al-Kabir 14157","","عبد الله بن عمرو بن العاص عن أبو قلابة الجرمي عن أيوب السختياني عن عبد الوهاب بن عبد المجيد الثقفي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14196","14158  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  أَبَنَا  النَّهَّاسُ بْنُ قَهْمٍ ،  عَنْ  عِسْلِ بْنِ سُفْيَانَ الْيَرْبُوعِيِّ ،  عَنْ  عَطَاءِ         [13/344]      بْنِ أَبِي رَبَاحٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  لَمَّا أَهْبَطَ اللهُ  آدَمَ  أَهْبَطَهُ بِأَرْضِ  الْهِنْدِ  وَمَعَهُ غَرْسٌ مِنْ شَجَرِ الْجَنَّةِ  ، فَغَرَسَهُ بِهَا ، وَكَانَ رَأْسُهُ فِي السَّمَاءِ وَرِجْلَاهُ فِي الْأَرْضِ ، وَكَانَ يَسْمَعُ كَلَامَ الْمَلَائِكَةِ ، فَكَانَ ذَلِكَ يُهَوِّنُ عَلَيْهِ وَحْدَهُ ، فَغَمَزَ غَمْزَةً فَتَطَأْطَأَ إِلَى سَبْعِينَ ذِرَاعًا ، فَأَنْزَلَ اللهُ : إِنِّي مُنْزِلٌ عَلَيْكَ بَيْتًا يُطَافُ حَوْلَهُ كَمَا تَطُوفُ الْمَلَائِكَةُ حَوْلَ عَرْشِي ، وَيُصَلَّى عِنْدَهُ كَمَا تُصَلِّي الْمَلَائِكَةُ حَوْلَ عَرْشِي .  فَأَقْبَلَ نَحْوَ  الْبَيْتِ  فَكَانَ مَوْضِعَ كُلِّ قَدَمٍ قَرْيَةٌ ، وَمَا بَيْنَ قَدَمَيْهِ مَفَازَةٌ حَتَّى قَدِمَ  مَكَّةَ  فَدَخَلَ مِنْ بَابِ  الصَّفَا  ، وَطَافَ  بِالْبَيْتِ  وَصَلَّى عِنْدَهُ ، ثُمَّ خَرَجَ إِلَى  الشَّامِ  فَمَاتَ بِهَا  .","","Al-Mu'jam al-Kabir 14158","","عبد الله بن عمرو بن العاص عن عطاء بن أبي رباح عن عسل بن سفيان اليربوعي عن النهاس بن قهم القيسي عن النضر بن شميل عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14197","14159  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  وَكِيعٌ ،  عَنْ  سَوَادَةَ بْنِ أَبِي الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  طُوفُوا بِهَذَا  الْبَيْتِ  وَاسْتَلِمُوا  هَذَا الْحَجَرَ  ; فَإِنَّهُمَا كَانَا حَجَرَيْنِ أُهْبِطَا مِنَ الْجَنَّةِ ، فَرُفِعَ أَحَدُهُمَا وَسَيُرْفَعُ الْآخَرُ ، فَإِنْ لَمْ يَكُنْ كَمَا قُلْتُ فَمَنْ مَرَّ بِقَبْرِي فَلْيَقُلْ : هَذَا قَبْرُ  عَبْدِ اللهِ بْنِ عَمْرٍو  الْكَذَّابِ  .","","Al-Mu'jam al-Kabir 14159","","عبد الله بن عمرو بن العاص عن مسلم بن مخراق القطان عن سوادة بن أبي الأسود القطان عن وكيع بن الجراح عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14198","[13/345]      14160  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  جَرِيرٌ ،  عَنِ  الْعَلَاءِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  يُوسُفَ بْنِ مَاهَكَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  نَزَلَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ بِهَذَا الْحَجَرِ مِنَ الْجَنَّةِ  ، فَتَمَتَّعُوا مِنْهُ مَا اسْتَطَعْتُمْ فَإِنَّكُمْ لَا تَزَالُوا بِخَيْرٍ مَا دَامَ بَيْنَ أَظْهُرِكُمْ ، فَإِنَّهُ  يُوشِكُ  أَنْ يَأْتِيَ فَيَرْجِعَ بِهِ مِنْ حَيْثُ جَاءَ بِهِ  .","","Al-Mu'jam al-Kabir 14160","","عبد الله بن عمرو بن العاص عن يوسف بن ماهك الفارسي عن عمرو بن مرة المرادي عن علاء بن المسيب عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14199","14161  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  حِبَّانُ بْنُ عَلِيٍّ ،  عَنْ  ضِرَارِ بْنِ مُرَّةَ ،  عَنْ  عَبْدِ اللهِ         [13/346]      بْنِ أَبِي الْهُذَيْلِ قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ عَمْرِو بْنِ الْعَاصِ :  لَوْ رَأَيْتُ رَجُلًا يَشْرَبُ الْخَمْرَ لَا يَرَانِي إِلَّا اللهُ ، فَاسْتَطَعْتُ أَنْ أَقْتُلَهُ لَقَتَلْتُهُ  .","","Al-Mu'jam al-Kabir 14161","","عبد الله بن عمرو بن العاص عن عبد الله بن أبي الهذيل الغنوي عن ضرار بن مرة الشيباني عن حبان بن علي العنزي عن سليمان بن داود العتكي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14200","14162  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  دَرَّاجٍ قَالَ :  رَأَيْتُ  عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ رَاكِبًا عَلَى دَابَّةٍ بَيْنَ يَدَيِ الْجِنَازَةِ حَتَّى أَتَى الْمَقْبَرَةَ ، فَنَزَلَ فَجَلَسَ  قَبْلَ أَنْ تَأْتِيَ الْجِنَازَةُ  .","","Al-Mu'jam al-Kabir 14162","","عبد الله بن عمرو بن العاص عن دراج أبي السمح عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن روح بن الفرج القطان عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14201","14163  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبُو مَعْمَرٍ إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْمَلِكِ بْنِ أَبْجَرَ ،  عَنْ  أَبِيهِ  ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  رُبُعُ مَنْ لَا يَلْبَسُ الثِّيَابَ مِنَ  السُّودَانِ  أَكْثَرُ مِنْ جَمِيعِ النَّاسِ  .","","Al-Mu'jam al-Kabir 14163","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن طلحة بن مصرف الهمداني عن عبد الملك بن سعيد بن حيان عن عبد الرحمن بن عبد الملك الكناني عن إسماعيل بن إبراهيم المقعد عن عبد الله بن أحمد بن حنبل عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14202","[13/347]      14164  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنِ  الْعُرْيَانِ بْنِ الْهَيْثَمِ ،  عَنْ  أَبِيهِ الْهَيْثَمِ  قَالَ :  دَخَلْتُ عَلَى  يَزِيدَ بْنِ مُعَاوِيَةَ  ، فَبَيْنَمَا نَحْنُ جُلُوسٌ عِنْدَهُ إِذْ أَتَاهُ رَجُلٌ فَأَخَذَ مِرْفَقَيْهِ فَاتَّكَأَ عَلَيْهِمَا  ، قُلْنَا : مَنْ هَذَا ؟ قَالَ بَعْضُهُمْ : هَذَا عَبْدُ اللهِ بْنُ عَمْرٍو ، وَقَالَ بَعْضُنَا : يَا  عَبْدَ اللهِ  إِنَّا نُحَدِّثُ عَنْكَ أَحَادِيثَ ،  قَالَ  : إِنَّكُمْ مُعَاشِرُ  أَهْلِ الْعِرَاقِ  ، تَأْخُذُونَ الْأَحَادِيثَ مِنْ أَسَافِلِهَا وَلَا تَأْخُذُونَهَا مِنْ أَعَالِيهَا .  وَذَكَرُوا  الدَّجَّالَ  ، فَقَالَ : أَبِأَرْضِكُمْ أَرْضٌ يُقَالُ لَهَا :  كُوثَى  ، ذَاتُ  سِبَاخٍ  وَنَخْلٍ ؟ قَالُوا : نَعَمْ ، قَالَ : فَإِنَّهُ يَخْرُجُ مِنْهَا  .","","Al-Mu'jam al-Kabir 14164","","عبد الله بن عمرو بن العاص عن الهيثم بن الأسود المذحجي عن العريان بن الهيثم عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14203","14165  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا         [13/348]      إِسْمَاعِيلُ بْنُ عُمَرَ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ عُبَيْدٍ مَوْلَى أَبِي رِفَاعَةَ الزُّرَقِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ بَابَيْ قَالَ :  جِئْتُ عَبْدَ اللهِ بْنَ عَمْرٍو  بِعَرَفَةَ  ،  فَرَأَيْتُهُ  قَدْ ضَرَبَ  فُسْطَاطًا  فِي الْحَلِّ  وَفُسْطَاطًا  فِي  الْحَرَمِ  ، فَقُلْتُ لَهُ : لِمَ صَنَعْتَ هَذَا ؟! فَقَالَ : تَكُونُ صَلَاتِي فِي  الْحَرَمِ  ، وَإِذَا خَرَجْتُ إِلَى أَهْلِي كُنْتُ فِي الْحَلِّ ، قُلْتُ لَهُ : كَيْفَ تُوتِرُ ؟ قَالَ : أَعْجَبُ  الْوِتْرِ  إِلَيَّ سَبْعًا ، خَلَقَ اللهُ سَبْعَ سَمَاوَاتٍ وَسَبَعَ أَرْضِينَ وَسَبْعَةَ أَيَّامٍ ، وَجُعِلَ  الطَّوَافُ  بِالْبَيْتِ  سَبْعًا ، وَبَيْنَ  الصَّفَا  وَالْمَرْوَةِ  سَبْعًا ، وَرَمْيُ الْجِمَارِ سَبْعُ حَصَيَاتٍ ، ثُمَّ قَالَ : مَا خَلَقَ اللهُ شَيْئًا فِي الْأَرْضِ مِنَ الْجَنَّةِ إِلَّا هَذِهِ الْيَاقُوتَةَ (  الرُّكْنَ الْأَسْوَدَ  ) ، وَاللهِ لِيُرْفَعَنَّ قَبْلَ يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 14165","","عبد الله بن عمرو بن العاص عن عبد الله بن باباه البصري عن إبراهيم بن عبيد بن رفاعة الزرقي عن محمد بن عبد الرحمن بن المغيرة عن إسماعيل بن عمر الواسطي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14204","14166  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا         [13/349]      يَحْيَى بْنُ آدَمَ ،  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  أَنَّ غُلَامًا لَهُ بَاعَ  فَضْلَ  مَاءٍ مِنْ عَمٍّ لَهُ بِعِشْرِينَ أَلْفًا  ، فَقَالَ  عَبْدُ اللهِ  : لَا تَبِعْهُ ; فَإِنَّهُ لَا يَحِلُّ بَيْعُهُ  .","","Al-Mu'jam al-Kabir 14166","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن عمرو بن شعيب عن أبو الزبير المكي عن زهير بن معاوية بن حديج عن يحيى بن آدم عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14205","14167  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنْ  عَبْدِ اللهِ         [13/350]      بْنِ عَمْرٍو ، قَالَ :  الْجَنَّةُ مَطْوِيَّةٌ مُعَلَّقَةٌ بِقُرُونِ الشَّمْسِ  ، تَنْتَشِرُ فِي كُلِّ عَامٍ مَرَّةً ، وَأَرْوَاحُ الْمُؤْمِنِينَ فِي طَيْرٍ كَالزَّرَازِيرِ يَتَعَارَفُونَ فِيهَا ، يُرْزَقُونَ مِنْ  ثَمَرِ  الْجَنَّةِ  .  قَالَ خَالِدُ بْنُ مَعْدَانَ :  إِذَا أُدْخِلَ أَهْلُ الْجَنَّةِ الْجَنَّةَ قَالُوا : رَبَّنَا أَلَمْ تُوعِدْنَا أَنْ تُورِدَنَا النَّارَ ؟!  قَالَ : بَلَى ، وَلَكِنَّكُمْ مَرَرْتُمْ بِهَا وَهِيَ خَامِدَةٌ  .","","Al-Mu'jam al-Kabir 14167","","عبد الله بن عمرو بن العاص عن خالد بن معدان عن ثور بن يزيد الكلاعي عن عيسى بن يونس بن أبي إسحاق عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14206","14168  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  مُعَاذُ         [13/351]      بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنْ  كَثِيرِ بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي عِيَاضٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  إِنَّ الْعَرْشَ لَيُطَوَّقُ بِحَيَّةٍ  ، وَإِنَّ الْوَحْيَ لَيَنْزِلُ فِي السَّلَاسِلِ  .","","Al-Mu'jam al-Kabir 14168","","عبد الله بن عمرو بن العاص عن عمرو أو عمير بن الأسود الداراني عن كثير بن أبي كثير البصري عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14207","14169  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ الْمِصْرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ الْمُقْرِئُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  عَنْ  خَالِدِ بْنِ يَزِيدَ . وَعَبْدُ اللهِ بْنُ سُلَيْمَانَ ،  عَنْ  عَمْرِو بْنِ نَافِعٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّهُ مَرَّ عَلَى رَجُلٍ بَعْدَ صَلَاةِ الصُّبْحِ وَهُوَ نَائِمٌ ، فَحَرَّكَهُ بِرِجْلِهِ حَتَّى اسْتَيْقَظَ ، فَقَالَ لَهُ :  أَمَا عَلِمْتَ أَنَّ اللهَ يَطَّلِعُ هَذِهِ السَّاعَةَ إِلَى خَلْقِهِ ، فَيُدْخِلُ  ثُلَّتَهُ  مِنْهُمُ الْجَنَّةَ بِرَحْمَتِهِ  .","","Al-Mu'jam al-Kabir 14169","","عبد الله بن عمرو بن العاص عن عمرو بن نافع عن خالد بن يزيد الجمحي عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14208","14170  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  ثَنَا  أَبِي  ، قَالَ :  قَرَأْتُ عَلَى         [13/352]      أَبِي قُرَّةَ ،  عَنْ  زَمْعَةَ بْنِ صَالِحٍ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  نَزَلَ  الرُّكْنُ الْأَسْوَدُ  مِنَ السَّمَاءِ ، فَوُضِعَ عَلَى  أَبِي قُبَيْسٍ  كَأَنَّهُ مَهَاةٌ بَيْضَاءُ  ، فَمَكَثَ أَرْبَعِينَ سَنَةً ، ثُمَّ وُضِعَ عَلَى قَوَاعِدِ  إِبْرَاهِيمَ  .","","Al-Mu'jam al-Kabir 14170","","عبد الله بن عمرو بن العاص عن أبو الزبير المكي عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14209","14171  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  ثَنَا  أَبِي  ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي أَيُّوبَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  إِنَّ أَهْلَ النَّارِ لَيَدْعُونَ  مَالِكًا  فُلَا يُجِيبُهُمْ أَرْبَعِينَ عَامًا  ، ثُمَّ         [13/353]      يَقُولُ :         {      إِنَّكُمْ مَاكِثُونَ         }      ثُمَّ يَدْعُونَ رَبَّهُمْ فَيَقُولُونَ :         {      رَبَّنَا أَخْرِجْنَا مِنْهَا فَإِنْ عُدْنَا فَإِنَّا ظَالِمُونَ         }      ، فَلَا يُجِيبُهُمْ مِثْلَ الدُّنْيَا ، ثُمَّ يَقُولُ :         {      اخْسَئُوا فِيهَا وَلا تُكَلِّمُونِ         }      ثُمَّ يَأْيَسُ  الْقَوْمُ  ، فَمَا هُوَ إِلَّا الزَّفِيرُ وَالشَّهِيقُ ، تُشْبِهُ أَصْوَاتُهُمْ أَصْوَاتَ الْحَمِيرِ ، أَوَّلُهَا شَهِيقٌ وَآخِرُهَا زَفِيرٌ  .","","Al-Mu'jam al-Kabir 14171","","عبد الله بن عمرو بن العاص عن أبو أيوب المراغي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن روح بن عبادة القيسي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14210","14172  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  ثَنَا  أَبِي  ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  شِبْلٌ ،  عَنْ  قَيْسِ بْنِ سَعْدٍ ،  عَنْ  مُسْلِمٍ الْهَجَرِيِّ قَالَ :  قُلْتُ  لِعَبْدِ اللهِ بْنِ عَمْرٍو : يَا  أَبَا مُحَمَّدٍ  ، مِمَّ خُلِقَ الْخَلْقُ ؟  قَالَ : مِنْ مَاءٍ وَرِيحٍ ، مِنْ نُورٍ وَظُلْمَةٍ . فَأَتَيْتُ ابْنَ عَبَّاسٍ  فَسَأَلْتُهُ  عَنْ ذَلِكَ ؟ فَقَالَ فِيهَا كَمَا قَالَ  عَبْدُ اللهِ بْنُ عَمْرٍو  .","","Al-Mu'jam al-Kabir 14172","","عبد الله بن عباس عن مسلم الهجري عن قيس بن سعد الحبشي عن شبل بن عباد المكي عن روح بن عبادة القيسي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14211","[13/354]      14173  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  ثَنَا  أَبِي  ،  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  مُغِيرَةَ ،  عَنْ  فُضَيْلِ بْنِ عَمْرٍو ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  إِنِّي أَجِدُ فِي كِتَابِ اللهِ الْمُنَزَّلِ : "" مَنْ  شَرِبَ  الْخَمْرَ فَلَمْ يَسْكَرْ لَمْ تُقْبَلْ لَهُ صَلَاةٌ سَبْعًا  ، فَإِنْ مَاتَ فِيهَا مَاتَ كَافِرًا ، فَإِنْ  شَرِبَ  الْخَمْرَ وَسَكِرَ لَمْ تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ صَبَاحًا ، فَإِنْ مَاتَ فِيهَا مَاتَ كَافِرًا  "" .","","Al-Mu'jam al-Kabir 14173","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن فضيل بن عمرو الفقيمي عن المغيرة بن حكيم الأبناوي عن جرير بن حازم عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14212","[13/355]      14174  -  حَدَّثَنَا  مُحَمَّدٌ ،  ثَنَا  أَبِي  ،  ثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  ثَنَا  هِشَامُ بْنُ سَعْدٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْبَيْلَمَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو :  إِذَا قُتِلَ الْعَبْدُ فِي  سَبِيلِ  اللهِ ، فَأَوَّلُ قَطْرَةٍ تَقَعُ عَلَى الْأَرْضِ مِنْ دَمِهِ يَغْفِرُ اللهُ لَهُ ذُنُوبَهُ كُلَّهَا  ، ثُمَّ يُرْسِلُ إِلَيْهِ  بِرَيْطَةٍ  مِنَ الْجَنَّةِ فَتُقْبَضُ فِيهَا نَفْسُهُ ، وَيُجْسَدُ مِنَ الْجَنَّةِ ، حَتَّى تُرَكَّبَ فِيهِ رُوحُهُ ، ثُمَّ يَعْرُجُ مَعَ الْمَلَائِكَةِ كَأَنَّهُ كَانَ مَعَهُمْ مُنْذُ خَلَقَهُ اللهُ ، حَتَّى يُؤْتَى بِهِ إِلَى السَّمَاءِ ، فَلَا يَمُرُّ بِبَابٍ إِلَّا فُتِحَ لَهُ ، وَلَا عَلَى مَلَكٍ إِلَّا صَلَّى عَلَيْهِ وَاسْتَغْفَرَ لَهُ ، حَتَّى يُؤْتَى بِهِ الرَّحْمَنُ عَزَّ وَجَلَّ ، فَيَسْجُدُ قَبْلَ الْمَلَائِكَةِ ، ثُمَّ تَسْجُدُ الْمَلَائِكَةُ بَعْدَهُ ، ثُمَّ يُغْفَرُ لَهُ وَيُطَهَّرُ ، ثُمَّ يُؤْمَرُ بِهِ إِلَى الشُّهَدَاءِ ، فَيَجِدُهُمْ         [13/356]      فِي رِيَاضٍ خُضْرٍ وَثِيَابٍ مِنْ حَرِيرٍ ، عِنْدَهُمْ ثَوْرٌ وَحُوتٌ يُلَغِّثَانِهِمْ كُلَّ يَوْمٍ بِشَيْءٍ لَمْ يُلَغِّثَاهُ بِالْأَمْسِ ، يَظَلُّ الْحُوتُ فِي أَنْهَارِ الْجَنَّةِ ، فَيَأْكُلُ مَنْ كُلِّ رَائِحَةٍ مِنْ أَنْهَارِ الْجَنَّةِ ، فَإِذَا أَمْسَى  وَكَزَهُ  الثَّوْرُ بِقَرْنِهِ فَذَكَّاهُ ، فَأَكَلُوا مِنْ لَحْمِهِ فَوَجَدُوا فِي لَحْمِهِ كُلَّ رَائِحَةٍ مِنْ أَنْهَارِ الْجَنَّةِ .  وَيَبِيتُ الثَّوْرُ  نَافِشًا  فِي الْجَنَّةِ يَأْكُلُ مِنْ  ثَمَرِ  الْجَنَّةِ ، فَإِذَا أَصْبَحَ غَدَا عَلَيْهِ الْحُوتُ فَذَكَّاهُ بِذَنَبِهِ ، فَأَكَلُوا مِنْ لَحْمِهِ وَوَجَدُوا فِي طَعْمِ لَحْمِهِ طَعْمَ كُلِّ  ثَمَرَةٍ  فِي الْجَنَّةِ ، يَنْظُرُونَ إِلَى مَنَازِلِهِمْ ، يَدْعُونَ اللهَ بِقِيَامِ السَّاعَةِ .         [13/357]      وَإِذَا تَوَفَّى اللهُ الْعَبْدَ الْمُؤْمِنَ أَرْسَلَ إِلَيْهِ مَلَكَيْنِ بِخِرْقَةٍ مِنَ الْجَنَّةِ وَرَيْحَانٍ مِنْ رَيْحَانِ الْجَنَّةِ ، فَقَالَا : أَيَّتُهَا النَّفْسُ الْمُطْمَئِنَّةُ ، اخْرُجِي إِلَى رَوْحٍ وَرَيْحَانٍ ، وَرَبٍّ غَيْرِ غَضْبَانَ ، اخْرُجِي فَنِعِمَّا قَدَّمْتِ ، فَتَخْرُجُ كَأَطْيَبِ رَائِحَةِ الْمِسْكِ وَجَدَهَا أَحَدٌ مِنْكُمْ بِأَنْفِهِ قَطُّ ، وَعَلَى أَرْجَاءِ السَّمَاءِ مَلَائِكَةٌ يَقُولُونَ : سُبْحَانَ اللهِ ! لَقَدْ جَاءَ مِنَ الْأَرْضِ الْيَوْمَ رُوحٌ طَيِّبَةٌ  وَنَسَمَةٌ  طَيِّبَةٌ ، فَلَا يَمُرُّ بِبَابٍ إِلَّا فُتِحَ لَهُ ، وَلَا مَلَكٍ إِلَّا صَلَّى عَلَيْهِ وَيَشْفَعُ لَهُ ، حَتَّى يُؤْتَى بِهِ الرَّحْمَنُ عَزَّ وَجَلَّ ، فَتَسْجُدُ الْمَلَائِكَةُ قَبْلَهُ ثُمَّ يَقُولُونَ : رَبَّنَا هَذَا عَبْدُكَ فُلَانٌ تَوَفَّيْنَاهُ وَأَنْتَ أَعْلَمُ بِهِ ، فَيَقُولُ : مُرُوهُ بِالسُّجُودِ ، فَيَسْجُدُ  النَّسَمَةُ  ، ثُمَّ يُدْعَى  مِيكَائِيلُ  ، فَيُقَالُ : اجْعَلْ هَذِهِ  النَّسَمَةَ  مَعَ أَنْفُسِ الْمُؤْمِنِينَ حَتَّى أَسْأَلَكَ عَنْهُمْ يَوْمَ الْقِيَامَةِ .  ثُمَّ يُؤْمَرُ بِجَسَدِهِ فَيُوَسَّعُ لَهُ ، طُولُهُ سَبْعُونَ وَعَرْضُهُ سَبْعُونَ ، وَيُنْبَذُ فِيهِ الرَّيْحَانُ وَيُبْسَطُ فِيهِ الْحَرِيرُ ، وَيُسْتَرُ فِيهِ بِحَرِيرٍ ، وَإِنْ كَانَ مَعَهُ شَيْءٌ مِنَ الْقُرْآنِ كَسَاهُ نُورُهُ ، وَإِلَّا جَعَلَ اللهُ لَهُ نُورًا مِثْلَ نُورِ الشَّمْسِ ، ثُمَّ يُفْتَحُ لَهُ بَابٌ إِلَى الْجَنَّةِ ، فَيَنْظُرُ إِلَى مَقْعَدِهِ فِي الْجَنَّةِ بُكْرَةً وَعَشِيًّا .         [13/358]      وَإِذَا تَوَفَّى اللهُ الْعَبْدَ الْكَافِرَ أَرْسَلَ إِلَيْهِ مَلَكَيْنِ ، وَأَرْسَلَ إِلَيْهِ بِقِطْعَةِ  الْبِجَادِ  أَنْتَنَ مِنْ كُلِّ نَتْنٍ ، وَأَخْشَنَ مَنْ كُلِّ خَشِنٍ ، فَقَالَا : أَيَّتُهَا النَّفْسُ الْخَبِيثَةُ ، اخْرُجِي إِلَى  جَهَنَّمَ  وَعَذَابٍ أَلِيمٍ ، وَرَبٍّ عَلَيْكِ سَاخِطٍ ، اخْرُجِي فَسَاءَ مَا قَدَّمْتِ . فَتَخْرُجُ كَأَنْتَنِ  جِيفَةٍ  وَجَدَهَا أَحَدُكُمْ بِأَنْفِهِ قَطُّ ، وَعَلَى أَرْجَاءِ السَّمَاءِ مَلَائِكَةٌ يَقُولُونَ : سُبْحَانَ اللهِ ! لَقَدْ جَاءَ الْيَوْمَ مِنَ الْأَرْضِ رِيحُ  جِيفَةٍ  وَنَسَمَةٌ  خَبِيثَةٌ ، فَلَا يُفْتَحُ لَهُ بَابُ السَّمَاءِ ، فَيُؤْمَرُ بِجَسَدِهِ فَيُضَيَّقُ عَلَيْهِ فِي الْقَبْرِ ، وَيُمْلَأُ حَيَّاتٍ مِثْلَ أَعْنَاقِ  الْبُخْتِ  تَأْكُلُ لَحْمَهُ ، فَلَا يَدَعْنَ مِنْ عِظَامِهِ شَيْئًا ، ثُمَّ يُرْسَلُ عَلَيْهِ مَلَائِكَةٌ صُمٌّ عُمْيٌ ، مَعَهُمْ فَطَاطِيسُ مِنْ حَدِيدٍ ، لَا يُبْصِرُونَهُ فَيَرْحَمُونَهُ ، وَلَا يَسْمَعُونَ صَوْتَهُ فَيَرْحَمُونَهُ ، فَيَضْرِبُونَهُ وَيَخْبِطُونَهُ وَيُفْتَحُ لَهُ بَابٌ مِنَ النَّارِ ،         [13/359]      يَنْظُرُ إِلَى مَقْعَدِهِ مِنَ النَّارِ بُكْرَةً وَعَشِيًّا ، يَسْأَلُ اللهَ أَنْ يُدِيمَ ذَلِكَ عَلَيْهِ وَلَا يَصِلَ إِلَى مَا وَرَاءَهُ مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 14174","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن البيلماني المدني عن زيد بن أسلم عن هشام بن سعد المخزومي عن أبو عامر العقدي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","ذكر سنه ووفاته ومن أخباره"
"14213","[13/360]      وَمَا  أَسْنَدَ  عَبْدُ اللهِ بْنُ عَمْرِو بْنِ الْعَاصِ  رَضِيَ اللهُ عَنْهُ  عَبْدُ اللهِ بْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُ عَنْهُ  14175  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مَرْوَانُ بْنُ شُجَاعٍ ،  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ أَبِي عَبْلَةَ الْعَقِيلِيُّ مِنْ أَهْلِ بَيْتِ الْمَقْدِسِ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  قَالَ  :  الْتَقَى عَبْدُ اللهِ بْنُ عُمَرَ وَعَبْدُ اللهِ بْنُ عَمْرِو بْنِ الْعَاصِ عَلَى  الْمَرْوَةِ  ، فَتَحَدَّثَا ، ثُمَّ مَضَى  عَبْدُ اللهِ بْنُ عَمْرٍو  وَبَقِيَ  عَبْدُ اللهِ بْنُ عُمَرَ  يَبْكِي ، فَقَالَ لَهُ رَجُلٌ : مَا يُبْكِيكَ يَا  أَبَا عَبْدِ الرَّحْمَنِ  ؟ قَالَ : هَذَا  يَعْنِي :  عَبْدَ اللهِ بْنَ عَمْرٍو  زَعَمَ أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ كَانَ فِي قَلْبِهِ  مِثْقَالُ  حَبَّةٍ  مِنْ خَرْدَلٍ مَنْ  كِبْرٍ  كَبَّهُ اللهُ عَلَى وَجْهِهِ فِي النَّارِ  .","","Al-Mu'jam al-Kabir 14175","","عبد الله بن عمرو بن العاص عن عبد الله بن عمر بن الخطاب عن أبو سلمة بن عبد الرحمن عن إبراهيم بن أبي عبلة عن مروان بن شجاع الخصيفي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عبد الله بن عمر رضي الله عنه عنه"
"14214","[13/361]      14176  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  جَعْفَرُ بْنُ عَوْنٍ ، كِلَاهُمَا  عَنْ  أَبِي حَيَّانَ التَّيْمِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا يَدْخُلُ الْجَنَّةَ إِنْسَانٌ فِي قَلْبِهِ  مِثْقَالُ  حَبَّةٍ  مِنْ خَرْدَلٍ مِنْ  كِبْرٍ  .","","Al-Mu'jam al-Kabir 14176","","عبد الله بن عمرو بن العاص عن عبد الله بن عمر بن الخطاب عن سعيد بن حيان التيمي عن يحيى بن سعيد التيمي عن جعفر بن عون المخزومي عن محمد بن عبد الله بن نمير عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن عمر رضي الله عنه عنه"
"14215","14177  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ ،  حَدَّثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَبَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ زَحْرٍ ،  عَنْ  عَلِيِّ بْنِ يَزِيدَ ،  عَنِ  الْقَاسِمِ ،  عَنْ  أَبِي أُمَامَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  كُنَّا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَدْ ضُرِبَتْ لَهُ  قُبَّةٌ  فِي مُؤَخَّرِ الْمَسْجِدِ ،         [13/362]      وَرَجُلَانِ يَتَمَارَيَانِ ، فَسَمِعْتُ شَيْئًا يُحَرِّكُ أَطْنَابَ  الْقُبَّةِ  ، فَالْتَفَتُّ فَإِذَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدِ اطَّلَعَ حَاسِرًا عَنْ رَأْسِهِ قَدِ احْمَرَّ وَجْهُهُ ، قَالَ :  أَمَا إِنَّهُ لَمْ تَهْلِكِ الْأُمَمُ قَبْلَكُمْ حَتَّى وَقَعُوا فِي مِثْلِ هَذَا ، تَضْرِبُونَ الْقُرْآنَ بَعْضَهُ بِبَعْضٍ  ؟! مَا كَانَ مِنْ حَلَالٍ فَأَحِلُّوهُ وَمَا كَانَ مِنْ حَرَامٍ فَحَرِّمُوهُ ، وَمَا كَانَ مِنْ  مُتَشَابِهٍ  فَآمِنُوا بِهِ  .","","Al-Mu'jam al-Kabir 14177","","عبد الله بن عمرو بن العاص عن أبو أمامة الباهلي عن القاسم بن عبد الرحمن الدمشقي عن علي بن يزيد الألهاني عن عبيد الله بن زحر الضمري عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","عبد الله بن عمر رضي الله عنه عنه"
"14216","[13/363]      سُفْيَانُ بْنُ عَوْفٍ  ، عَنْ  عَبْدِ اللهِ  14178  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو .         [13/364]      وَحَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،  ثَنَا  ابْنُ لَهِيعَةَ .  وَحَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَبَنَا  عَبْدُ اللهِ بْنُ لَهِيعَةَ ،  أَخْبَرَنِي  الْحَارِثُ بْنُ يَزِيدَ ،  عَنْ  جُنْدُبِ بْنِ عَبْدِ اللهِ الْعَدْوَانِيِّ  أَنَّهُ سَمِعَ  سُفْيَانَ بْنَ عَوْفٍ الْقَارِيَّ - رَجُلٌ مِنَ الْقَارَةِ - ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ  : كُنَّا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَطَلَعَتِ الشَّمْسُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَأْتِي اللهُ بِقَوْمٍ يَوْمَ الْقِيَامَةِ نُورُهُمْ كَنُورِ الشَّمْسِ  ، فَقَالَ  أَبُو بَكْرٍ  : نَحْنُ هُمْ يَا رَسُولَ اللهِ ؟ فَقَالَ : "" لَا ، وَلَكُمْ خَيْرٌ كَثِيرٌ ، وَلَكِنَّهُمْ فُقَرَاءُ  الْمُهَاجِرِينَ  يُحْشَرُونَ مِنْ أَقْطَارِ الْأَرْضِ "" ، ثُمَّ قَالَ :         [13/365]      "" طُوبَى لِلْغُرَبَاءِ ، طُوبَى لِلْغُرَبَاءِ "" ، قِيلَ : مَنِ الْغُرَبَاءُ ؟ قَالَ : "" نَاسٌ صَالِحُونَ قَلِيلٌ فِي نَاسِ سَوْءٍ كَثِيرٍ ، مَنْ يَعْصِيهِمْ أَكْثَرُ مِمَّنْ يُطِيعُهُمْ  .","","Al-Mu'jam al-Kabir 14178","","عبد الله بن عمرو بن العاص عن سفيان بن عوف القاري عن جندب بن عبد الله الوالبي عن الحارث بن يزيد الحضرمي عن عبد الله بن لهيعة عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","سفيان بن عوف عن عبد الله"
"14217","14179  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ الْكَرِيمِ بْنِ الْحَارِثِ ،  عَنْ  أَبِيهِ الْحَارِثِ بْنِ يَزِيدَ  أَنَّ جُنْدُبَ بْنَ عَبْدِ اللهِ الْعَدْوَانِيَّ  حَدَّثَهُ  أَنَّ سُفْيَانَ بْنَ عَوْفٍ الْقَارِيَّ  أَخْبَرَهُ  :  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ يَقُولُ :  كُنَّا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا ، فَطَلَعَتِ الشَّمْسُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيَأْتِيَنَّ اللهَ يَوْمَ الْقِيَامَةِ أَقْوَامٌ نُورُهُمْ كَضَوْءِ الشَّمْسِ  ، قَالَ  أَبُو بَكْرٍ  وَعُمَرُ  : أَنَحْنُ هُمْ يَا رَسُولَ اللهِ ؟ قَالَ : "" لَسْتُمْ بِهُمْ وَلَكُمْ خَيْرٌ كَثِيرٌ ، وَلَكِنَّهُمْ فُقَرَاءُ  الْمُهَاجِرِينَ  يُبْعَثُونَ مِنْ أَقْطَارِ الْأَرْضِ  .","","Al-Mu'jam al-Kabir 14179","","عبد الله بن عمرو بن العاص عن سفيان بن عوف القاري عن جندب بن عبد الله الوالبي عن الحارث بن يزيد الحضرمي عن عبد الكريم بن الحارث بن يزيد الحضرمي عن عمرو بن الحارث بن يعقوب عن رشدين بن سعد المهري عن حجاج بن رشدين المصري عن محمد بن الحجاج بن رشدين المهري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","سفيان بن عوف عن عبد الله"
"14218","14180  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ ،  ثَنَا  عَارِمٌ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنْ  عُثْمَانَ بْنِ حَكِيمٍ ،  عَنْ  أَبِي أُمَامَةَ بْنِ سَهْلِ بْنِ         [13/366]      حُنَيْفٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تَقُومُ السَّاعَةُ حَتَّى يَتَسَافَدَ النَّاسُ تَسَافُدَ الْبَهَائِمِ فِي الطُّرُقِ  .","","Al-Mu'jam al-Kabir 14180","","عبد الله بن عمرو بن العاص عن أسعد بن سهل بن حنيف عن عثمان بن حكيم الأحلافي عن عبد الواحد بن زياد عن محمد بن الفضل السدوسي عن حفص بن عمر سنجة ألف عن الطبراني","سفيان بن عوف عن عبد الله"
"14219","14181  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرٍ الْقَطَّانُ الْهَمَذَانِيُّ مَمُّوسٌ ،  ثَنَا  مُحَمَّدُ بْنُ سَهْمٍ الْأَنْطَاكِيُّ ،  ثَنَا  بَقِيَّةُ .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عَطِيَّةُ بْنُ بَقِيَّةَ بْنِ الْوَلِيدِ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  الْمِسْوَرِ بْنِ مَخْرَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْجُمَّةِ  لِلْحُرَّةِ وَالْعِقْصَةِ لِلْأَمَةِ  .","","Al-Mu'jam al-Kabir 14181","","عبد الله بن عمرو بن العاص عن المسور بن مخرمة عن الزهري عن ابن جريج عن معتمر بن سليمان عن بقية بن الوليد عن عطية بن بقية بن الوليد عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14220","14182  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدَةَ الْمِصِّيصِيُّ ،  ثَنَا  أَبُو تَوْبَةَ الرَّبِيعُ         [13/367]      بْنُ نَافِعٍ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  فِطْرِ بْنِ خَلِيفَةَ ،  عَنْ  أَبِي الطُّفَيْلِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الرَّحِمُ  شِجْنَةٌ  مُعَلَّقَةٌ بِالْعَرْشِ  ، وَلَيْسَ الْوَاصِلُ بِالْمُكَافِئِ ، وَلَكِنَّ الْوَاصِلَ الَّذِي إِذَا قُطِعَتْ رَحِمُهُ وَصَلَهَا  .","","Al-Mu'jam al-Kabir 14182","","عبد الله بن عمرو بن العاص عن عامر بن واثلة عن فطر بن خليفة عن عيسى بن يونس بن أبي إسحاق عن الربيع بن نافع الحلبي عن محمد بن عبدة المصيصي عن الطبراني","سفيان بن عوف عن عبد الله"
"14221","14183  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  عَلِيُّ بْنُ         [13/368]      الْمَدِينِيِّ ،  ثَنَا  حُسَيْنٌ الْجُعْفِيُّ ،  عَنْ  زَائِدَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  حَرْبِ بْنِ عُبَيْدِ اللهِ ،  عَنِ  السَّائِبِ بْنِ يَزِيدَ قَالَ :  حَفِظْتُ عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَهُ أَنْ يَقْرَأَ الْقُرْآنَ فِي خَمْسٍ  .","","Al-Mu'jam al-Kabir 14183","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن حرب بن عبيد الله بن عمير الثقفي عن عطاء بن السائب عن زائدة بن قدامة عن الحسين بن علي الجعفي عن علي ابن المديني عن الفضل بن الحباب الجمحي عن الطبراني","سفيان بن عوف عن عبد الله"
"14222","14184  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَبَنَا  عِمْرَانُ الْقَطَّانُ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَبْدِ اللهِ بْنِ         [13/369]      عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَنْظُرُ اللهُ إِلَى امْرَأَةٍ يَوْمَ الْقِيَامَةِ لَا تَشْكُرُ لِزَوْجِهَا وَلَا تَسْتَغْنِي عَنْهُ  .","","Al-Mu'jam al-Kabir 14184","","عبد الله بن عمرو بن العاص عن سعيد بن المسيب عن قتادة بن دعامة عن عمران بن داور القطان عن عبد الله بن رجاء الغداني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14223","14185  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَحْمَدُ بْنُ جَمِيلٍ الْمَرْوَزِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  شُعْبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 14185","","عبد الله بن عمرو بن العاص عن سعيد بن المسيب عن قتادة بن دعامة عن شعبة بن الحجاج عن عبد الله بن المبارك عن أحمد بن جميل المروزي عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14224","14186  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  يَزِيدُ بْنُ عِيَاضٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَبْدِ اللهِ بْنِ         [13/370]      عَمْرٍو  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَرَجَ عَلَى النَّاسِ وَهُمْ يُصَلُّونَ ، فَقَالَ :  صَلَاةُ الْقَاعِدِ نِصْفُ صَلَاةِ الْقَائِمِ  .","","Al-Mu'jam al-Kabir 14186","","عبد الله بن عمرو بن العاص عن سعيد بن المسيب عن الزهري عن يزيد بن عياض بن جعدبة الليثي عن شيبان بن فروخ الحبطي عن عبد الله بن أحمد الجواليقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14225","14187  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ زَيْدٍ الْخَطَّابِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ بْنِ أَبِي دَاوُدَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يُحَدِّثُ يَوْمًا مَلَأً مِنَ الْمُسْلِمِينَ فِيهِمُ  ابْنُ عُمَرَ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ سَمَّعَ النَّاسَ بِعَمَلِهِ سَمَّعَ اللهُ بِهِ  سَامِعَ  خَلْقِهِ وَحَقَّرَهُ وَصَغَّرَهُ  ، فَرَأَيْتُ عَيْنَيِ  ابْنِ عُمَرَ  تَذْرِفَانِ  .","","Al-Mu'jam al-Kabir 14187","","عبد الله بن عمرو بن العاص عن سعيد بن المسيب عن عبد الكريم الاصطخري عن سليمان بن أبي داود الحراني بومة عن محمد بن سليمان بن أبي داود بومة عن إسحاق بن زيد بن عبد الكبير الخطابي عن محمد بن يحيى بن مندة عن الطبراني","سفيان بن عوف عن عبد الله"
"14226","[13/371]      14188  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى وَيُوسُفُ الْقَاضِي قَالَا :  ثَنَا  مُسَدَّدٌ .  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْبَرْبَهَارِيُّ ،  حَدَّثَنَا  زَكَرِيَّا بْنُ عَدِيٍّ .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ قَالُوا :  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْحَضْرَمِيِّ ،  عَنِ  الْقَاسِمِ بْنِ         [13/372]      مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ امْرَأَةً يُقَالُ لَهَا  أُمُّ مَهْزُولٍ  ، وَكَانَتْ تَكُونُ بِأَجْيَادٍ [ تُسَافِحُ ] ، وَكَانَتْ تَشْتَرِطُ لِلرَّجُلِ إِنَّ تَزَوَّجَهَا أَنْ تَكْفِيَهُ النَّفَقَةَ  ، وَأَنَّ  رَجُلًا  اسْتَأْذَنَ فِيهَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَقَرَأَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ هَذِهِ الْآيَةَ أَوْ قَالَ : فَأُنْزِلَتْ         {      وَالزَّانِيَةُ لا يَنْكِحُهَا إِلا زَانٍ أَوْ مُشْرِكٌ         }      الْآيَةَ  .  وَاللَّفْظُ  لِيَحْيَى بْنِ مَعِينٍ  .","","Al-Mu'jam al-Kabir 14188","","عبد الله بن عمرو بن العاص عن القاسم بن محمد بن أبي بكر الصديق عن حضرمي بن لاحق الأعرجي عن سليمان بن طرخان عن معتمر بن سليمان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14227","14189  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَسَنِ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ طَلْحَةَ ،         [13/373]      عَنْ  عَمِّهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أُرِيدَ مَالُهُ بِغَيْرِ حَقٍّ فَقَاتَلَ فَقُتِلَ فَهُوَ  شَهِيدٌ  .","","Al-Mu'jam al-Kabir 14189","","عبد الله بن عمرو بن العاص عن عمران بن طلحة القرشي عن إبراهيم بن محمد بن طلحة التيمي عن عبد الله بن حسن بن حسن بن علي بن أبي طالب عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14228","[13/374]      14190  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ ،  ثَنَا  قَبِيصَةُ .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ كَيْسَانَ الْمِصِّيصِيُّ ،  ثَنَا  أَبُو حُذَيْفَةَ .  وَحَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ وَمُعَاذُ بْنُ الْمُثَنَّى قَالَا :  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ قَالُوا :  ثَنَا  سُفْيَانُ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  حُمَيْدِ بْنِ         [13/375]      عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مِنَ الْكَبَائِرِ أَنْ يَشْتُمَ الرَّجُلُ وَالِدَيْهِ  ، قَالُوا : يَا رَسُولَ اللهِ وَكَيْفَ يَشْتُمُ الرَّجُلُ وَالِدَيْهِ ؟ قَالَ : "" يَشْتُمُ الرَّجُلُ أَبَا الرَّجُلِ فَيَشْتُمُ أَبَاهُ وَيَشْتُمُ أُمَّهُ فَيَشْتُمُ أُمَّهُ  .","","Al-Mu'jam al-Kabir 14190","","عبد الله بن عمرو بن العاص عن حميد بن عبد الرحمن القرشي عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن سفيان الثوري عن محمد بن كثير العبدي عن أحمد بن داود بن موسى السدوسي عن الطبراني","سفيان بن عوف عن عبد الله"
"14229","14191  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَبَنَا  شُعْبَةُ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يُحَدِّثُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ مِنْ أَكْبَرِ الذَّنْبِ فِي الْإِسْلَامِ أَنْ  يَسُبَّ  الرَّجُلُ وَالِدَيْهِ  ، قِيلَ : يَا رَسُولَ اللهِ وَكَيْفَ  يَسُبُّ  الرَّجُلُ وَالِدَيْهِ ؟! قَالَ : "" يُسَابُّ الرَّجُلُ الرَّجُلَ ، فَيَسُبُّ أَبَاهُ وَيَسُبُّ أَبَاهُ ، وَيَسُبُّ أُمَّهُ فَيَسُبُّ أُمَّهُ  .","","Al-Mu'jam al-Kabir 14191","","عبد الله بن عمرو بن العاص عن حميد بن عبد الرحمن القرشي عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سفيان بن عوف عن عبد الله"
"14230","14192  -  حَدَّثَنَا  سَعِيدُ بْنُ مُحَمَّدِ بْنِ الْمُغِيرَةِ الْمِصْرِيُّ ،  ثَنَا  سَعِيدُ         [13/376]      بْنُ سُلَيْمَانَ الْوَاسِطِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ مِنْ أَكْبَرِ الْكَبَائِرِ أَنْ يَلْعَنَ الرَّجُلُ أَبَاهُ  ، قَالُوا : يَا رَسُولَ اللهِ ، وَكَيْفَ يَلْعَنُ الرَّجُلُ أَبَاهُ ؟! قَالَ : ""  يَسُبُّ  أَبَا الرَّجُلِ فَيَسُبُّ أَبَاهُ ، وَيَسُبُّ أُمَّ الرَّجُلِ فَيَسُبُّ أُمَّهُ  .","","Al-Mu'jam al-Kabir 14192","","عبد الله بن عمرو بن العاص عن حميد بن عبد الرحمن القرشي عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن سعيد بن سليمان سعدويه عن سعيد بن محمد بن المغيرة المصري عن الطبراني","سفيان بن عوف عن عبد الله"
"14231","14193  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنِ  ابْنِ الْهَادِ .  وَحَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ الْمَرْوَزِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  يَزِيدَ بْنِ الْهَادِ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ         [13/377]      حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مِنْ أَكْبَرِ الْكَبَائِرِ شَتْمُ الرَّجُلِ وَالِدَيْهِ  ، قَالُوا : يَا رَسُولَ اللهِ وَهَلْ يَشْتُمُ الرَّجُلُ وَالِدَيْهِ ؟! قَالَ : "" نَعَمْ  يَسُبُّ  أَبَا الرَّجُلِ فَيَسُبُّ أَبَاهُ ، وَيَسُبُّ أُمَّهُ فَيَسُبُّ أُمَّهُ  .","","Al-Mu'jam al-Kabir 14193","","عبد الله بن عمرو بن العاص عن حميد بن عبد الرحمن القرشي عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن محمد الدراوردي عن نعيم بن حماد الخزاعي عن يحيى بن عثمان بن صالح عن الطبراني","سفيان بن عوف عن عبد الله"
"14232","14194  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَبَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ عَلْقَمَةَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَمْرٍو قَالَ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْتِي ، فَقَالَ :  يَا  عَبْدَ اللهِ بْنَ عَمْرٍو  ، أَلَمْ أُخْبَرْ أَنَّكَ تَكَلَّفُ قِيَامَ اللَّيْلِ وَصِيَامَ النَّهَارِ  ؟ "" قُلْتُ : إِنِّي لَأَفْعَلُ ، فَقَالَ : "" إِنَّ مِنْ حَسْبِكَ أَنْ تَصُومَ مِنْ كُلِّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ الْحَسَنَةُ بِعَشْرِ أَمْثَالِهَا ، وَكَأَنَّكَ قَدْ صُمْتَ الدَّهْرَ كُلَّهُ "" ، فَغَلَّظْتُ فَغَلَّظَ عَلَيَّ ، فَقُلْتُ : يَا رَسُولَ اللهِ إِنِّي لَأَجِدُ قُوَّةً عَنْ ذَلِكَ ، فَقَالَ : "" إِنَّ مِنْ حَسْبِكَ - وَلَا تَقُولُ أَفْعَلُ - أَنْ تَصُومَ مِنْ كُلِّ جُمُعَةٍ ثَلَاثَةَ أَيَّامٍ "" ، فَغَلَّظْتُ فَغَلَّظَ عَلَيَّ فَقُلْتُ : إِنِّي لَأَجِدُ قُوَّةً عَنْ ذَلِكَ .         [13/378]      فَقَالَ : "" إِنَّ أَعْدَلَ الصِّيَامِ عِنْدَ اللهِ صَوْمُ  دَاوُدَ  كَانَ يَصُومُ نِصْفَ الدَّهْرِ ، إِنَّ لِعَيْنَيْكَ عَلَيْكَ حَقًّا ، وَإِنَّ لِضَيْفِكَ عَلَيْكَ حَقًّا ، وَإِنَّ لِأَهْلِكَ عَلَيْكَ حَقًّا "" .  فَقَالَ  عَبْدُ اللهِ  لَمَّا أَدْرَكَتْهُ السِّنُّ وَضَعُفَ وَكَبِرَ : لَأَنْ أَكُونَ قَبِلْتُ رُخْصَةَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحَبُّ إِلَيَّ مِنْ أَهْلِي وَمَالِي  .","","Al-Mu'jam al-Kabir 14194","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","سفيان بن عوف عن عبد الله"
"14233","14195  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبَانُ بْنُ يَزِيدَ الْعَطَّارُ ،  ثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لَهُ :  اقْرَأِ الْقُرْآنَ فِي شَهْرٍ  : "" قَالَ : إِنِّي أَجِدُ قُوَّةً ، قَالَ : "" اقْرَأْ فِي عِشْرِينَ "" ، قَالَ : إِنِّي أَجِدُ قُوَّةً ، قَالَ : "" اقْرَأْ فِي خَمْسَ عَشْرَةَ "" ،         [13/379]      قَالَ : إِنِّي أَجِدُ قُوَّةً ، قَالَ : "" اقْرَأْ فِي عَشْرٍ "" ، قَالَ : إِنِّي أَجِدُ قُوَّةً ، قَالَ : "" اقْرَأْ فِي سَبْعٍ وَلَا تَزِيدُ عَلَى ذَلِكَ شَيْئًا  .","","Al-Mu'jam al-Kabir 14195","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن محمد بن عبد الرحمن الزهري عن يحيى بن أبي كثير عن أبان بن يزيد العطار عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14234","14196  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَمْ أُخْبَرْ أَنَّكَ تَصُومُ النَّهَارَ وَتَقُومُ اللَّيْلَ  ؟ "" قُلْتُ : نَعَمْ ، قَالَ : "" فَلَا تَفْعَلْ صُمْ وَأَفْطِرْ وَقُمْ وَنَمْ ، فَإِنَّ لِنَفْسِكَ عَلَيْكَ حَقًّا وَلِجَسَدِكَ عَلَيْكَ حَقًّا وَلِزَوْجِكَ عَلَيْكَ حَقًّا وَإِنَّ لِزُوَّارِكَ عَلَيْكَ حَقًّا ، وَإِنَّ  بِحَسْبِكَ  أَنْ تَصُومَ مِنْ كُلِّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ ، فَإِنَّ الْحَسَنَةَ بِعَشْرِ أَمْثَالِهَا "" ، فَشَدَّدْتُ فَشُدِّدَ عَلَيَّ ، قُلْتُ : إِنِّي أَجِدُ قُوَّةً ، قَالَ : "" فَصُمْ مِنْ كُلِّ جُمُعَةٍ ثَلَاثَةَ أَيَّامٍ "" ، فَشَدَّدْتُ فَشُدِّدَ عَلَيَّ قُلْتُ : إِنِّي أَجِدُ قُوَّةً ، قَالَ : "" فَصُمْ صِيَامَ  دَاوُدَ         [13/380]      نَبِيِّ اللهِ وَلَا تَزِدْ عَلَيْهِ : "" قُلْتُ : وَمَا صِيَامُ  دَاوُدَ  ؟ قَالَ : "" نِصْفُ الدَّهْرِ "" .  وَكَانَ  عَبْدُ اللهِ بْنُ عَمْرٍو  بَعْدَمَا كَبِرَ يَقُولُ : يَا لَيْتَنِي قَبِلْتُ رُخْصَةَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ !  .","","Al-Mu'jam al-Kabir 14196","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","سفيان بن عوف عن عبد الله"
"14235","14197  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَسْعُودٍ الْمَقْدِسِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ .         [13/381]      وَحَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  عَبْدَ اللهِ  لَا تَكُنْ مِثْلَ فُلَانٍ ، فَإِنَّهُ كَانَ يَقُومُ اللَّيْلَ فَتَرَكَ قِيَامَ اللَّيْلِ  .","","Al-Mu'jam al-Kabir 14197","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","سفيان بن عوف عن عبد الله"
"14236","14198  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَسْعُودٍ الْمَقْدِسِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ         [13/382]      عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُلْحِدُ رَجُلٌ  بِمَكَّةَ  يُقَالُ لَهُ :  عَبْدُ اللهِ ،  عَلَيْهِ  شَطْرُ  عَذَابِ الْعَالَمِ  .","","Al-Mu'jam al-Kabir 14198","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن محمد بن كثير بن أبي عطاء عن أحمد بن مسعود المقدسي عن الطبراني","سفيان بن عوف عن عبد الله"
"14237","14199  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  شَيْبَانُ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  كَسَفَتِ الشَّمْسُ ، فَنُودِيَ : الصَّلَاةَ جَامِعَةً ! فَرَكَعَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَكْعَتَيْنِ فِي الْمَسْجِدِ  ، ثُمَّ جَلَسَ حَتَّى  تَجَلَّتِ  الشَّمْسُ  .","","Al-Mu'jam al-Kabir 14199","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن شيبان بن عبد الرحمن المؤدب عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14238","14200  -  حَدَّثَنَا  أَحْمَدُ بْنُ بَشِيرٍ  الطَّيَالِسِيُّ ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،         [13/383]      ثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  ثَنَا  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَلَاةُ الْقَاعِدِ عَلَى النِّصْفِ مِنْ صَلَاةِ الْقَائِمِ  .  كذا في طبعة الجريسي وأكثر المواضع في كتب المصنف ، المعاجم وغيرها ، وكذا هو في لسان الميزان ، وقال محقق تهذيب الكمال 24 / 581 : ""جاء في حواشي النسخ تعقيب للمؤلف على صاحب الكمال نصه : ""كان فيه : أحمد بن بشر وهو خطأ "". والذي في تاريخ بغداد وتاريخ الإسلام : (بشر) فالله أعلم .","","Al-Mu'jam al-Kabir 14200","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن الزهري عن محمد بن إسحاق عن جرير بن حازم عن وهب بن جرير بن حازم عن يحيى بن معين عن أحمد بن بشر الطيالسى عن الطبراني","سفيان بن عوف عن عبد الله"
"14239","14201  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَعْنَةُ اللهِ عَلَى  الرَّاشِي  وَالْمُرْتَشِي  .","","Al-Mu'jam al-Kabir 14201","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن الحارث بن عبد الرحمن العامري عن محمد بن عبد الرحمن بن المغيرة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سفيان بن عوف عن عبد الله"
"14240","[13/384]      14202  -  حَدَّثَنَا  أَحْمَدُ بْنُ سَهْلِ بْنِ أَيُّوبَ الْأَهْوَازِيُّ ،  ثَنَا  عَلِيُّ بْنُ بَحْرٍ ،  ثَنَا  هِشَامُ بْنُ يُوسُفَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَعَنَ اللهُ  الرَّاشِيَ  وَالْمُرْتَشِيَ  .","","Al-Mu'jam al-Kabir 14202","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن الحارث بن عبد الرحمن العامري عن ابن جريج عن هشام بن يوسف الأبناوي عن علي بن بحر بن بري القطان عن أحمد بن سهل بن أيوب الأهوازي عن الطبراني","سفيان بن عوف عن عبد الله"
"14241","14203  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صِيَامُ ثَلَاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ صِيَامُ الدَّهْرِ  .","","Al-Mu'jam al-Kabir 14203","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14242","[13/385]      14204  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ الْمِصْرِيُّ ،  ثَنَا  خَالِدُ بْنُ نِزَارٍ ،  ثَنَا  عِيسَى بْنُ الْمُطَّلِبِ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنِ  ابْنِ الْمُسَيِّبِ وَأَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ قَالَ :  قُلْتُ لَأَصُومَنَّ الدَّهْرَ مَا عِشْتُ وَلَأَقُومَنَّ اللَّيْلَ مَا عِشْتُ ، فَقَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَنْتَ الَّذِي قُلْتَ لَأَصُومَنَّ الدَّهْرَ مَا عِشْتُ وَلَأَقُومَنَّ اللَّيْلَ مَا عِشْتُ ؟  فَقُلْتُ : قَدْ قُلْتُ ذَلِكَ يَا رَسُولَ اللهِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" صُمْ وَأَفْطِرْ وَصَلِّ وَنَمْ وَصُمْ مِنَ  الشَّهْرِ  ثَلَاثَةَ أَيَّامٍ ، وَكُلُّ حَسَنَةٍ بِعَشْرِ أَمْثَالِهَا "" .  قُلْتُ : إِنِّي أَجِدُنِي أَقْوَى عَلَى أَفْضَلِ مِنْ         [13/386]      ذَلِكَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" فَصُمْ يَوْمًا وَأَفْطِرْ يَوْمَيْنِ "" .  قُلْتُ : إِنِّي أَجِدُنِي أَقْوَى عَلَى أَفْضَلِ مِنْ ذَلِكَ ، فَقَالَ : "" فَصُمْ يَوْمًا وَأَفْطِرْ يَوْمًا فَذَلِكَ صِيَامُ  دَاوُدَ  "" .  فَقُلْتُ : إِنِّي أَقْوَى عَلَى أَفْضَلِ مِنْ ذَلِكَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَا أَفْضَلَ مِنْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 14204","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن الزهري عن عيسى بن المطلب الزهري عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","سفيان بن عوف عن عبد الله"
"14243","14205  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ خَالِدِ بْنِ مُسَافِرٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ وَأَبِي سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  أُخْبِرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنِّي أَقُولُ : لَأَصُومَنَّ الدَّهْرَ وَلَأَقُومَنَّ اللَّيْلَ مَا عِشْتُ  .  فَذَكَرَ مِثْلَ حَدِيثِ  عِيسَى بْنِ الْمُطَّلِبِ  .","","Al-Mu'jam al-Kabir 14205","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن الزهري عن عبد الرحمن بن خالد بن مسافر الفهمي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","سفيان بن عوف عن عبد الله"
"14244","14206  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ ،  ثَنَا  عَلِيُّ بْنُ مُسْلِمِ بْنِ الْهَيْثَمِ الْمُؤَدِّبُ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى بْنِ الْحَارِثِ الْمُحَارِبِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  بَكْرُ بْنُ وَائِلٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ وَأَبِي سَلَمَةَ ، عَنْ عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 14206","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن الزهري عن بكر بن وائل التيمي عن يعلى بن الحارث بن حرب المحاربي عن يحيى بن يعلى بن الحارث المحاربي عن علي بن مسلم بن الهيثم المؤدب عن علي بن سعيد بن بشير عليك عن الطبراني","سفيان بن عوف عن عبد الله"
"14245","[13/387]      14207  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  أَبُو ثَابِتٍ مُحَمَّدُ بْنُ عُبَيْدِ اللهِ الْمَدِينِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ ،  عَنْ  يَزِيدَ بْنِ الْهَادِ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِرَجُلٍ  :  إِنَّكَ تَصُومُ النَّهَارَ فَلَا تُفْطِرُ  ، وَتُصَلِّي اللَّيْلَ فَلَا تَنَامُ ، فَبِحَسْبِكَ أَنْ تَصُومَ مِنْ كُلِّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ "" ، قُلْتُ : يَا رَسُولَ اللهِ إِنِّي أَجِدُ بِي قُوَّةً هِيَ أَقْوَى مِنْ ذَلِكَ .  قَالَ : "" فَبِحَسْبِكَ أَنْ تَصُومَ مِنْ كُلِّ جُمُعَةٍ يَوْمَيْنِ "" ، قُلْتُ : يَا رَسُولَ اللهِ ..حَتَّى بَلَغَ صَوْمَ  دَاوُدَ  "" كَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا  .","","Al-Mu'jam al-Kabir 14207","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن محمد بن إبراهيم بن الحارث التيمي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن أبي حازم المخزومي عن محمد بن عبيد الله بن محمد بن زيد الأموي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14246","[13/388]      14208  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ قَالَ :  سَأَلْتُ  عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ قُلْتُ :  أَخْبِرْنِي بِأَشَدِّ شَيْءٍ رَأَيْتَهُ صَنَعَهُ الْمُشْرِكُونَ بِرَسُولِ اللهِ  ، قَالَ : أَقْبَلَ  عُقْبَةُ بْنُ أَبِي مُعَيْطٍ  وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي عِنْدَ  الْكَعْبَةِ  فَلَوَى ثَوْبَهُ فِي عُنُقِهِ فَخَنَقَهُ خَنْقًا شَدِيدًا ، فَأَقْبَلَ  أَبُو بَكْرٍ  فَأَخَذَ بِمَنْكِبِهِ فَدَفَعَهُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ  أَبُو بَكْرٍ  : يَا قَوْمِ         {      أَتَقْتُلُونَ رَجُلا أَنْ يَقُولَ رَبِّيَ اللهُ وَقَدْ جَاءَكُمْ بِالْبَيِّنَاتِ         }      الْآيَةَ كُلَّهَا  .","","Al-Mu'jam al-Kabir 14208","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن محمد بن إبراهيم بن الحارث التيمي عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","سفيان بن عوف عن عبد الله"
"14247","[13/389]      14209  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ أَيُّوبَ صَاحِبُ الْمَغَازِي ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَحْيَى بْنِ عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ عُرْوَةَ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّهُ قَالَ :  مَا أَكْثَرَ مَا رَأَيْتَ  قُرَيْشًا  أَصَابَتْ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيمَا كَانَتْ تُظْهِرُ مِنْ عَدَاوَتِهِ  ؟ قَالَ : حَضَرْتُهُمْ وَقَدِ اجْتَمَعَ أَشْرَافُهُمْ يَوْمًا فِي  الْحِجْرِ  .  .  ثُمَّ ذَكَرَ مِثْلَ حَدِيثِ  الْأَوْزَاعِيِّ  .","","Al-Mu'jam al-Kabir 14209","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن يحيى بن عروة بن الزبير عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن أحمد بن محمد بن أيوب عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14248","[13/390]      14210  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ لَا يَقْبِضُ الْعِلْمَ انْتِزَاعًا يَنْتَزِعُهُ مِنْ صُدُورِ النَّاسِ  ، وَلَكِنْ يَقْبِضُ الْعِلْمَ بِقَبْضِ الْعُلَمَاءِ ، حَتَّى إِذَا لَمْ يَتْرُكْ عَالِمًا اتَّخَذَ النَّاسُ رُؤُوسًا جُهَّالًا ، فَسُئِلُوا فَأَفْتَوْا بِغَيْرِ عِلْمٍ فَضَلُّوا وَأَضَلُّوا  .","","Al-Mu'jam al-Kabir 14210","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14249","[13/391]      14211  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَبَنَا  شُعْبَةُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يُحَدِّثُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَا يَقْبِضُ الْعِلْمَ انْتِزَاعًا يَنْتَزِعُهُ مِنَ النَّاسِ  وَلَكِنْ يَقْبِضُ الْعِلْمَ بِعَالِمِهِمْ ، حَتَّى إِذَا لَمْ يَبْقَ عَالِمٌ اتَّخَذَ النَّاسُ رُؤُوسًا جُهَّالًا ، فَأَفْتَوْا بِغَيْرِ عِلْمٍ فَضَلُّوا وَأَضَلُّوا  .","","Al-Mu'jam al-Kabir 14211","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سفيان بن عوف عن عبد الله"
"14250","14212  -  حَدَّثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ النَّوْفَلِيُّ الْمَدَنِيُّ وَعَبْدُ الرَّحْمَنِ بْنُ جُمُعَةَ اللَّاذِقِيُّ قَالَا :  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ اللهِ الْأُوَيْسِيُّ ،  ثَنَا  مَالِكٌ .         [13/392]      وَحَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ الْمِصْرِيُّ ،  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ قَالَ :  قَرَأْتُ عَلَى  عَبْدِ اللهِ بْنِ نَافِعٍ ،  أَخْبَرَنِي  مَالِكُ بْنُ أَنَسٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  أَنَّ عَبْدَ اللهِ بْنَ عَمْرٍو  أَخْبَرَهُ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَا يَنْتَزِعُ الْعِلْمَ مِنَ النَّاسِ انْتِزَاعًا  ، وَلَكِنْ يَقْبِضُ الْعُلَمَاءَ فَيَقْبِضُ الْعِلْمَ بِقَبْضِهِمْ حَتَّى إِذَا لَمْ يَبْقَ عَالِمٌ اتَّخَذَ النَّاسُ رُؤُوسًا جُهَّالًا ، فَسُئِلُوا فَأَفْتَوْا بِغَيْرِ عِلْمٍ فَضَلُّوا وَأَضَلُّوا  .","","Al-Mu'jam al-Kabir 14212","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مالك بن أنس عن عبد الله بن نافع الصائغ عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف المصري عن الطبراني","سفيان بن عوف عن عبد الله"
"14251","14213  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ لَا يَقْبِضُ الْعِلْمَ انْتِزَاعًا يَنْتَزِعُهُ مِنَ النَّاسِ  ، وَلَكِنْ يَقْبِضُ الْعِلْمَ بِقَبْضِ الْعُلَمَاءِ ، حَتَّى إِذَا لَمْ يَبْقَ عَالِمٌ اتَّخَذَ النَّاسُ رُؤُوسًا جُهَّالًا ، فَسُئِلُوا فَأَفْتَوْا بِغَيْرِ عِلْمٍ فَضَلُّوا وَأَضَلُّوا  .","","Al-Mu'jam al-Kabir 14213","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","سفيان بن عوف عن عبد الله"
"14252","14214  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  أَبُو صَالِحٍ عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ عَجْلَانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :         [13/393]      إِنَّ اللهَ تَبَارَكَ وَتَعَالَى لَا يَنْتَزِعُ الْعِلْمَ انْتِزَاعًا يَنْتَزِعُهُ مِنْهُمْ بَعْدَ إِذْ أَعْطَاهُمْ  ، وَلَكِنْ يَقْبِضُ الْعِلْمَ بِقَبْضِ الْعُلَمَاءِ ، فَإِذَا لَمْ يَبْقَ عَالِمٌ اتَّخَذَ النَّاسُ رُؤُوسًا جُهَّالًا يَسْتَفْتُونَهُمْ ، فَيُفْتُونَهُمْ بِغَيْرِ عِلْمٍ فَيَضِلُّونَ وَيُضِلُّونَ  .","","Al-Mu'jam al-Kabir 14214","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن عجلان عن الليث بن سعد عن عبد الله بن صالح المصري عن يحيى بن عثمان بن صالح عن الطبراني","سفيان بن عوف عن عبد الله"
"14253","14215  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْمُعَافَى بْنِ سُلَيْمَانَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  الْقَاسِمُ بْنُ مَعْنٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ لَا يَقْبِضُ الْعِلْمَ انْتِزَاعًا يَنْتَزِعُهُ مِنْ صُدُورِ النَّاسِ  وَلَكِنْ يَقْبِضُ الْعِلْمَ بِقَبْضِ الْعُلَمَاءِ ، حَتَّى إِذَا لَمْ يَتْرُكْ عَالِمًا اتَّخَذَ النَّاسُ رُؤُوسًا جُهَّالًا ، فَسُئِلُوا فَأَفْتَوْا بِغَيْرِ عِلْمٍ فَضَلُّوا وَأَضَلُّوا  .","","Al-Mu'jam al-Kabir 14215","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن القاسم بن معن عن المعافى بن سليمان الرسعني عن سليمان بن المعافى الرسعني عن الطبراني","سفيان بن عوف عن عبد الله"
"14254","14216  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُعَاذٍ الْحَلَبِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ مَسْلَمَةَ الْقَعْنَبِيُّ ،  ثَنَا  أَبِي  ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ لَا يَقْبِضُ الْعِلْمَ انْتِزَاعًا يَنْتَزِعُهُ مِنَ النَّاسِ وَلَكِنْ يَقْبِضُ الْعِلْمَ بِقَبْضِ الْعُلَمَاءِ  ، حَتَّى إِذَا لَمْ يَتْرُكْ عَالِمًا اتَّخَذَ النَّاسُ رُؤُوسًا جُهَّالًا ، فَسُئِلُوا فَأَفْتَوْا بِغَيْرِ عِلْمٍ فَضَلُّوا وَأَضَلُّوا  .","","Al-Mu'jam al-Kabir 14216","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مسلمة بن قعنب القعنبي عن عبد الله بن مسلمة القعنبي عن محمد بن معاذ بن سفيان العنزي عن الطبراني","سفيان بن عوف عن عبد الله"
"14255","[13/394]      14217  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  أَبِي ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ لَا يَقْبِضُ الْعِلْمَ انْتِزَاعًا يَنْتَزِعُهُ مِنَ النَّاسِ  وَلَكِنْ يَقْبِضُ الْعِلْمَ بِقَبْضِ الْعُلَمَاءِ ، حَتَّى إِذَا لَمْ يَبْقَ عَالِمٌ اتَّخَذَ النَّاسُ رُؤُوسًا جُهَّالًا ، فَسُئِلُوا فَأَفْتَوْا بِغَيْرِ عِلْمٍ فَضَلُّوا وَأَضَلُّوا  .","","Al-Mu'jam al-Kabir 14217","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن عبد الله بن أويس عن إسماعيل بن أبي أويس عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","سفيان بن عوف عن عبد الله"
"14256","14218  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  أَخْبَرَنِي  أَبِي  قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَا يَقْبِضُ الْعِلْمَ انْتِزَاعًا يَنْتَزِعُهُ مِنَ النَّاسِ  وَلَكِنْ يَقْبِضُ الْعِلْمَ بِقَبْضِ الْعُلَمَاءِ ، فَإِذَا لَمْ يَبْقَ عَالِمٌ اتَّخَذَ النَّاسُ رُؤُوسًا جُهَّالًا ، فَسُئِلُوا فَأَفْتَوْا بِغَيْرِ عِلْمٍ فَضَلُّوا وَأَضَلُّوا  .","","Al-Mu'jam al-Kabir 14218","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","سفيان بن عوف عن عبد الله"
"14257","14219  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  ثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ         [13/395]      عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ جَلَّ ذِكْرُهُ لَا يَقْبِضُ الْعِلْمَ انْتِزَاعًا يَنْزِعُهُ مِنَ النَّاسِ  ، وَلَكِنْ يَقْبِضُ الْعِلْمَ بِقَبْضِ الْعُلَمَاءِ بِعِلْمِهِمْ ، حَتَّى إِذَا لَمْ يَبْقَ عَالِمٌ اتَّخَذَ النَّاسُ رُؤُوسًا جُهَّالًا ، فَسُئِلُوا فَأَفْتَوْا بِغَيْرِ عِلْمٍ فَضَلُّوا وَأَضَلُّوا  .","","Al-Mu'jam al-Kabir 14219","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14258","14220  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ لَا يَقْبِضُ الْعِلْمَ  .."" فَذَكَرَ نَحْوَهُ.","","Al-Mu'jam al-Kabir 14220","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14259","14221  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ ،  ثَنَا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ ،  عَنْ  أَيُّوبَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .         [13/396]","","Al-Mu'jam al-Kabir 14221","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أيوب السختياني عن عبد الوهاب بن عبد المجيد الثقفي عن الفلاس عن عبد الله بن أحمد الجواليقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14260","14222  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْجَارُودِيُّ الْأَصْبَهَانِيُّ ،  ثَنَا  حَفْصُ بْنُ عَمْرٍو الرَّبَالِيُّ ،  ثَنَا  عَبْدُ الْوَهَّابِ ،  ثَنَا  أَيُّوبُ وَيَحْيَى بْنُ سَعِيدٍ الْأَنْصَارِيُّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَا يَقْبِضُ الْعِلْمَ انْتِزَاعًا يَنْتَزِعُهُ مِنَ النَّاسِ  وَلَكِنْ يَقْبِضُ الْعِلْمَ بِعَالِمِهِ ، حَتَّى إِذَا لَمْ يَبْقَ عَالِمٌ اتَّخَذَ النَّاسُ رُؤُوسًا جُهَّالًا ، فَسُئِلُوا فَأَفْتَوْا بِغَيْرِ عِلْمٍ فَضَلُّوا وَأَضَلُّوا  .","","Al-Mu'jam al-Kabir 14222","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يحيى بن سعيد الأنصاري عن عبد الوهاب بن عبد المجيد الثقفي عن حفص بن عمرو الربالي عن الجارودي أحمد بن علي الأصبهاني عن الطبراني","سفيان بن عوف عن عبد الله"
"14261","14223  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  وَعَنْ  قَتَادَةَ جَمِيعًا ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ تَبَارَكَ وَتَعَالَى لَا يَنْزِعُ الْعِلْمَ مِنْ صُدُورِ النَّاسِ بَعْدَ أَنْ يُعْطِيَهُمْ إِيَّاهُ  ، وَلَكِنْ ذَهَابُهُ قَبْضُ الْعُلَمَاءِ فَيَتَّخِذُ النَّاسُ رُؤُوسًا جُهَّالًا ، فَيُسْأَلُونَ فَيَقُولُونَ بِغَيْرِ عِلْمٍ فَيَضِلُّونَ وَيُضِلُّونَ  .","","Al-Mu'jam al-Kabir 14223","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14262","[13/397]      14224  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  ثَنَا  يَعْقُوبُ بْنُ كَاسِبٍ .  وَحَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ وَمُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ كَثِيرٍ الْمَدَنِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ مَوْلَى مُزَيْنَةَ ،  عَنْ  صَفْوَانَ بْنِ سُلَيْمٍ ، قَالَ :  قَالَ  هِشَامُ بْنُ عُرْوَةَ ،  قَالَ  عُرْوَةُ  :  قَالَ  عَبْدُ اللهِ بْنُ عَمْرٍو : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ لَا يَقْبِضُ الْعِلْمَ انْتِزَاعًا يَنْتَزِعُهُ مِنَ النَّاسِ  ، وَلَكِنْ يَقْبِضُ الْعِلْمَ بِقَبْضِ الْعُلَمَاءِ ، حَتَّى إِذَا لَمْ يَتْرُكْ عَالِمًا اتَّخَذَ النَّاسُ رُؤُوسًا جُهَّالًا ، فَسُئِلُوا فَأَفْتَوْا بِغَيْرِ عِلْمٍ فَضَلُّوا وَأَضَلُّوا  .","","Al-Mu'jam al-Kabir 14224","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن صفوان بن سليم القرشي عن إسحاق بن إبراهيم بن سعيد الصواف عن يعقوب بن حميد بن كاسب المدني عن روح بن الفرج القطان عن الطبراني","سفيان بن عوف عن عبد الله"
"14263","[13/398]      14225  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  مَالِكُ بْنُ الْخَلِيلِ أَبُو غَسَّانَ الْيُحْمَدِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي عَدِيٍّ ،  ثَنَا  مُحَمَّدُ بْنُ هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَا يَقْبِضُ الْعِلْمَ انْتِزَاعًا يَنْتَزِعُهُ  ، وَلَكِنْ يَقْبِضُ الْعُلَمَاءَ ، فَيَصِيرُ لِلنَّاسِ رُؤُوسٌ جُهَّالٌ ، فَسُئِلُوا فَأَفْتَوْا بِغَيْرِ عِلْمٍ فَضَلُّوا وَأَضَلُّوا  .","","Al-Mu'jam al-Kabir 14225","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن هشام بن عروة المدني عن محمد بن إبراهيم بن أبي عدي القسملي عن مالك بن الخليل اليحمدي عن محمد بن صالح النرسي عن الطبراني","سفيان بن عوف عن عبد الله"
"14264","14226  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَبَنَا  زَائِدَةُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ لَا يَقْبِضُ الْعِلْمَ  .."" ، فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 14226","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن زائدة بن قدامة عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سفيان بن عوف عن عبد الله"
"14265","14227  -  حَدَّثَنَا  أَحْمَدُ بْنُ زَيْدِ بْنِ الْحَرِيشِ الْأَهْوَازِيُّ ،  ثَنَا         [13/399]      مُحَمَّدُ بْنُ مَعْمَرٍ الْبَحْرَانِيُّ ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ لَا يَقْبِضُ الْعِلْمَ  .  "" فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 14227","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن ابن جريج عن روح بن عبادة القيسي عن محمد بن معمر بن ربعي البحراني عن أحمد بن زيد بن الحريش الأهوازي عن الطبراني","سفيان بن عوف عن عبد الله"
"14266","14228  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  أَبِي  ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ لَا يَقْبِضُ الْعِلْمَ  .."" ، فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 14228","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن عبيد بن غنام النخعي عن الطبراني","سفيان بن عوف عن عبد الله"
"14267","14229  -  حَدَّثَنَا  أَبُو زَيْدٍ أَحْمَدُ بْنُ عَبْدِ الرَّحِيمِ بْنِ يَزِيدَ الْحَوْطِيُّ ،  ثَنَا  أَبُو الْمُغِيرَةِ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ لَا يَقْبِضُ الْعِلْمَ  .."" ، فَذَكَرَ نَحْوَهُ .         [13/400]","","Al-Mu'jam al-Kabir 14229","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أبو عمرو الأوزاعي عن عبد القدوس بن الحجاج عن أحمد بن عبد الرحيم بن يزيد الحوطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14268","14230  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ ،  ثَنَا  أَبُو الْمُغِيرَةِ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عَبْدِ اللهِ - وَلَمْ يَذْكُرْ :  عُرْوَةَ  ... فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 14230","","عبد الله بن عمرو بن العاص عن هشام بن عروة بن الزبير عن أبو عمرو الأوزاعي عن عبد القدوس بن الحجاج عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","سفيان بن عوف عن عبد الله"
"14269","14231  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَمْرُو بْنُ هَاشِمٍ الْبَيْرُوتِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْحُصَيْنِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ... فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 14231","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد العزيز بن الحصين المروزي عن عمرو بن هاشم البيروتي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14270","14232  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ جَلَّ ذِكْرُهُ لَا يَنْتَزِعُ الْعِلْمَ مِنَ النَّاسِ بَعْدَ أَنْ يُعْطِيَهُمْ إِيَّاهُ  ، وَلَكِنْ يَذْهَبُ بِالْعُلَمَاءِ ، كُلَّمَا ذَهَبَ عَالِمٌ ذَهَبَ بِمَا مَعَهُ مِنَ الْعِلْمِ ، حَتَّى يَبْقَى مَنْ لَا يَعْلَمُ فَيَضِلُّوا وَيُضِلُّوا  .","","Al-Mu'jam al-Kabir 14232","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14271","[13/401]      14233  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَبَنَا  عَبْدُ الرَّزَّاقِ ،  أَبَنَا  مَعْمَرٌ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : أَشْهَدُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ تَبَارَكَ وَتَعَالَى لَا يَقْبِضُ الْعِلْمَ بِقَبْضٍ يَقْبِضُهُ  ، وَلَكِنْ يَقْبِضُ الْعُلَمَاءَ بِعِلْمِهِمْ ، حَتَّى إِذَا لَمْ يَبْقَ عَالِمٌ اتَّخَذَ النَّاسُ رُؤُوسًا جُهَّالًا فَسُئِلُوا فَحَدَّثُوا فَضَلُّوا وَأَضَلُّوا  .","","Al-Mu'jam al-Kabir 14233","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن يحيى بن أبي كثير عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14272","14234  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ نَافِعٍ الطَّحَّانُ ،  ثَنَا  أَبُو الطَّاهِرِ ابْنُ السَّرْحِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  مَالِكُ بْنُ أَنَسٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الشَّيْطَانَ يَأْتِي أَحَدَكُمْ فَيَقُولُ : مَنْ خَلَقَ السَّمَاءَ  ؟ فَيَقُولُ : اللهُ ، فَيَقُولُ : مَنْ خَلَقَ الْأَرْضَ ؟ فَيَقُولُ : اللهُ ، فَيَقُولُ : مَنْ خَلَقَ اللهَ ؟ فَإِذَا وَجَدَ ذَلِكَ أَحَدُكُمْ فَلْيَقُلْ : آمَنْتُ بِاللهِ وَرَسُولِهِ  .","","Al-Mu'jam al-Kabir 14234","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مالك بن أنس عن إسماعيل بن أبي أويس عن أحمد بن عمرو بن بن السرح المصري عن أحمد بن محمد بن نافع الطحاوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14273","[13/402]      14235  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  الْحَكَمُ بْنُ مُوسَى ،  ثَنَا  مُسْلِمُ بْنُ خَالِدٍ الزَّنْجِيُّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مِنْ  حَلَفَ  عَلَى يَمِينٍ فَرَأَى خَيْرًا مِنْهَا فَلْيُكَفِّرْ عَنْ يَمِينِهِ وَلْيَأْتِ الَّذِي هُوَ خَيْرٌ  .","","Al-Mu'jam al-Kabir 14235","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مسلم بن خالد الزنجي عن الحكم بن موسى بن أبي زهير النسائي عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14274","14236  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تُصَلُّوا فِي  أَعْطَانِ  الْإِبِلِ ، وَصَلُّوا فِي مُرَاحِ الْغَنَمِ  .","","Al-Mu'jam al-Kabir 14236","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن عبد الله بن أحمد الجواليقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14275","[13/403]      14237  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عِيسَى بْنِ طَلْحَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ، قَالَ :  وَقَفَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  حَجَّةِ الْوَدَاعِ  بِمِنًى  يَسْأَلُونَهُ ، فَجَاءَهُ  رَجُلٌ  ، فَقَالَ : يَا رَسُولَ اللهِ ، لَمْ أَشْعُرْ فَحَلَقْتُ قَبْلَ أَنْ أَذْبَحَ ؟! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اذْبَحْ وَلَا حَرَجَ  ، فَجَاءَهُ  رَجُلٌ  آخَرُ فَقَالَ :         [13/404]      يَا رَسُولَ اللهِ ، لَمْ أَشْعُرْ فَنَحَرْتُ قَبْلَ أَنْ أَرْمِيَ ؟! قَالَ : "" ارْمِ وَلَا حَرَجَ "" ، قَالَ : فَمَا سُئِلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ شَيْءٍ قُدِّمَ وَلَا أُخِّرَ إِلَّا قَالَ : "" افْعَلْ وَلَا حَرَجَ  .         [13/405]","","Al-Mu'jam al-Kabir 14237","","عبد الله بن عمرو بن العاص عن عيسى بن طلحة التيمي عن الزهري عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14276","14238  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سُوَيْدٍ الشِّبَامِيُّ ،  أَبَنَا  عَبْدُ الرَّزَّاقِ ،  أَبَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عِيسَى بْنِ طَلْحَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ  :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِمِنًى  ، فَجَاءَهُ  رَجُلٌ  فَقَالَ : يَا رَسُولَ اللهِ  ... فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 14238","","عبد الله بن عمرو بن العاص عن عيسى بن طلحة التيمي عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إبراهيم بن محمد بن عبد الله الشبامي عن الطبراني","سفيان بن عوف عن عبد الله"
"14277","14239  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي سَلَمَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عِيسَى بْنِ طَلْحَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ قَالَ :  حَضَرْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِنْدَ  الْجَمْرَةِ  وَهُوَ         [13/406]      يُسْأَلُ ، فَقَالَ لَهُ  رَجُلٌ  : يَا رَسُولَ اللهِ ، إِنِّي نَحَرْتُ قَبْلَ أَنْ أَرْمِيَ ؟! قَالَ :  ارْمِ وَلَا حَرَجَ  ، وَقَالَ لَهُ  رَجُلٌ  آخَرُ : يَا رَسُولَ اللهِ ، إِنِّي حَلَقْتُ قَبْلَ أَنْ أَنْحَرَ ؟! قَالَ : "" انْحَرْ وَلَا حَرَجَ "" ، قَالَ : فَمَا سُئِلَ عَنْ شَيْءٍ قُدِّمَ وَلَا أُخِّرَ إِلَّا قَالَ : "" افْعَلْ وَلَا حَرَجَ  .","","Al-Mu'jam al-Kabir 14239","","عبد الله بن عمرو بن العاص عن عيسى بن طلحة التيمي عن الزهري عن عبد العزيز بن عبد الله الماجشون عن عبد الله بن رجاء الغداني عن أبو مسلم الكجي عن الطبراني","سفيان بن عوف عن عبد الله"
"14278","14240  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ قَالَ :  سَمِعْتُ  عِيسَى بْنَ طَلْحَةَ  يُحَدِّثُ عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو         [13/407]      أَنَّ  رَجُلًا  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ، ذَبَحْتُ قَبْلَ أَنْ أَرْمِيَ ؟! قَالَ :  ارْمِ وَلَا حَرَجَ  قَالَ آخَرُ : حَلَقْتُ قَبْلَ أَنْ أَذْبَحَ ؟! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اذْبَحْ وَلَا حَرَجَ  .","","Al-Mu'jam al-Kabir 14240","","عبد الله بن عمرو بن العاص عن عيسى بن طلحة التيمي عن الزهري عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","سفيان بن عوف عن عبد الله"
"14279","14241  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ خَالِدِ بْنِ مُسَافِرٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عِيسَى بْنِ طَلْحَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّهُ سَمِعَ رِجَالًا يَسْتَفْتُونَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  حَجَّةِ الْوَدَاعِ  ، فَيَقُولُ  رَجُلٌ  : إِنِّي لَمْ أَكُنْ أَشْعُرُ أَنَّ الرَّمْيَ قَبْلَ النَّحْرِ فَنَحَرْتُ قَبْلَ أَنْ أَرْمِيَ ؟! فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فَارْمِ وَلَا حَرَجَ  ، فَقَالَ بَعْضُهُمْ : يَا رَسُولَ اللهِ ، لَمْ أَشْعُرْ أَنَّ النَّحْرَ قَبْلَ الْحَلْقِ فَحَلَقْتُ قَبْلَ أَنْ أَنْحَرَ ؟! فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" فَانْحَرْ وَلَا حَرَجَ  .","","Al-Mu'jam al-Kabir 14241","","عبد الله بن عمرو بن العاص عن عيسى بن طلحة التيمي عن الزهري عن عبد الرحمن بن خالد بن مسافر الفهمي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","سفيان بن عوف عن عبد الله"
"14280","14242  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ نَافِعٍ الْمِصْرِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ الْمُنْكَدِرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي فُدَيْكٍ ،  عَنْ         [13/408]      سُلَيْمَانَ بْنِ دَاوُدَ بْنِ قَيْسٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عِيسَى بْنِ طَلْحَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ، قَالَ :  خَطَبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ النَّاسَ فِي  حَجَّةِ الْوَدَاعِ  ، فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ :  يَا أَيُّهَا النَّاسُ ، خُذُوا مَنَاسِكَكُمْ فَإِنِّي لَا أَدْرِي لَعَلِّي غَيْرُ حَاجٍّ بَعْدَ عَامِي هَذَا  .","","Al-Mu'jam al-Kabir 14242","","عبد الله بن عمرو بن العاص عن عيسى بن طلحة التيمي عن الزهري عن موسى بن عقبة عن داود بن قيس الدباغ عن سليمان بن داود بن قيس الفراء عن محمد بن إسماعيل بن مسلم الديلي عن عبيد الله بن عبد الله بن المنكدر التيمي عن أحمد بن محمد بن نافع الطحاوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14281","14243  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عِمْرَانَ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  زَمْعَةُ بْنُ صَالِحٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عِيسَى بْنِ طَلْحَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ عَلَى رَاحِلَتِهِ  بِمِنًى  .","","Al-Mu'jam al-Kabir 14243","","عبد الله بن عمرو بن العاص عن عيسى بن طلحة التيمي عن الزهري عن زمعة بن صالح الجندي عن أبو داود الطيالسي عن عبد الله بن عمران بن أبي علي عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","سفيان بن عوف عن عبد الله"
"14282","14244  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ ،  ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  أَبِي خَالِدٍ الدَّالَانِيِّ ،  عَنْ         [13/409]      عَمْرِو بْنِ مُرَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  أَبِي كَثِيرٍ الزُّبَيْدِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  رَفَعَهُ  ، قَالَ :  يُوضَعُ لِلْمُؤْمِنِينَ كَرَاسِيٌّ مِنْ نُورٍ  ، وَيُظَلِّلُ عَلَيْهِمُ الْغَمَامُ ، وَيَكُونُ ذَلِكَ الْيَوْمُ عَلَيْهِمْ كَسَاعَةٍ مِنْ نَهَارٍ  .","","Al-Mu'jam al-Kabir 14244","","عبد الله بن عمرو بن العاص عن أبو كثير الزبيدي عن عبد الله بن الحارث النجراني عن عمرو بن مرة المرادي عن أبو خالد الدالاني عن عبد السلام بن حرب الملائي عن مالك بن إسماعيل النهدي عن حفص بن عمر سنجة ألف عن الطبراني","سفيان بن عوف عن عبد الله"
"14283","14245  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّهُ قَالَ  يَوْمَ  صِفِّينَ  : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ فِي  عَمَّارٍ  :  تَقْتُلُهُ  الْفِئَةُ  الْبَاغِيَةُ  ، فَقَالَ  مُعَاوِيَةُ  : لَا تَزَالُ دَاحِضًا فِي بَوْلِكَ ! أَنَحْنُ قَتَلْنَاهُ ؟! إِنَّمَا قَتَلَهُ مَنْ جَاءَ بِهِ  .","","Al-Mu'jam al-Kabir 14245","","عبد الله بن عمرو بن العاص عن عبد الله بن الحارث بن نوفل عن عبد الرحمن بن زياد الهاشمي عن الأعمش عن سفيان الثوري عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14284","[13/410]      14246  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُبَيْدُ بْنُ أَسْبَاطِ بْنِ مُحَمَّدٍ ،  ثَنَا  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ نَوْفَلٍ  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عَمْرٍو وَعَمْرَو بْنَ الْعَاصِ وَمُعَاوِيَةَ يَقُولُونَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِعَمَّارٍ  :  تَقْتُلُكَ  الْفِئَةُ  الْبَاغِيَةُ  .","","Al-Mu'jam al-Kabir 14246","","معاوية بن أبي سفيان عن عبد الله بن الحارث بن نوفل عن عبد الرحمن بن زياد الهاشمي عن الأعمش عن أسباط بن محمد بن ميسرة القرشي عن عبيد بن أسباط بن محمد الهمداني عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14285","14247  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ ،  ثَنَا  مُحَمَّدُ بْنُ صُدْرَانَ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي عَدِيٍّ ،  عَنْ  صَالِحِ بْنِ أَبِي الْأَخْضَرِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  كَانَ قَوْمٌ عَلَى بَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَتَنَازَعُونَ فِي الْقُرْآنِ ، فَخَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [13/411]      يَوْمًا مُتَغَيِّرًا وَجْهُهُ ، فَقَالَ :  يَا قَوْمِ ، بِهَذَا أُهْلِكَتِ الْأُمَمُ ، وَإِنَّ الْقُرْآنَ يُصَدِّقُ بَعْضُهُ بَعْضًا  ، فَلَا تُكَذِّبُوا بَعْضَهُ بِبَعْضٍ  .","","Al-Mu'jam al-Kabir 14247","","عبد الله بن عمرو بن العاص عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن صالح بن أبي الأخضر اليمامي عن محمد بن إبراهيم بن أبي عدي القسملي عن محمد بن إبراهيم بن صدران الأزدي عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","سفيان بن عوف عن عبد الله"
"14286","14248  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ وَالْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  الْعَبَّاسُ بْنُ عَبْدِ الْعَظِيمِ الْعَنْبَرِيُّ ،  ثَنَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  مُوسَى بْنُ عُبَيْدَةَ الرَّبَذِيُّ ،  عَنْ  عُمَرَ بْنِ الْحَكَمِ بْنِ ثَوْبَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ .  وَعَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  دُونَ اللهِ سَبْعُونَ أَلْفَ حِجَابٍ مِنْ نُورٍ         [13/412]      وَظُلْمَةٍ  ، فَمَا مِنْ نَفْسٍ تَسْمَعُ شَيْئًا مِنْ حِسِّ تِلْكَ الْحُجُبِ إِلَّا  زَهَقَتْ  .","","Al-Mu'jam al-Kabir 14248","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن موسى بن عبيدة بن نشيط الحميري عن مكي بن إبراهيم عن عباس بن عبد العظيم العنبري عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14287","14249  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  رَجَاءُ بْنُ مُحَمَّدٍ الْعُذْرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ حُمْرَانَ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُمَرَ بْنِ الْحَكَمِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  دَخَلَ  رَجُلٌ  عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَقْسِمُ  تِبْرًا  ، فَقَالَ : يَا  مُحَمَّدُ  ، اعْدِلْ ! قَالَ :  وَيْلَكَ ، وَمَنْ يَعْدِلُ إِذَا لَمْ أَعْدِلْ  ؟! وَعِنْدَ مَنْ يُلْتَمَسُ الْعَدْلُ بَعْدِي ؟ ! "" ، ثُمَّ قَالَ : ""  يُوشِكُ  أَنَّ يَأْتِيَ قَوْمٌ مِثْلُ هَذَا يَسْأَلُونَ بِكِتَابِ اللهِ وَهُمْ أَعْدَاؤُهُ ، يَقْرَؤُونَ كِتَابَ اللهِ ، مُحَلَّقَةٌ رُؤُوسُهُمْ ، فَإِذَا خَرَجُوا فَاضْرِبُوا رِقَابَهُمْ  .","","Al-Mu'jam al-Kabir 14249","","عبد الله بن عمرو بن العاص عن عمر بن الحكم بن رافع الأوسي عن جعفر بن عبد الله بن الحكم الأوسي عن عبد الحميد بن جعفر الأوسي عن عبد الله بن حمران مولى عثمان بن عفان عن رجاء بن محمد العذري عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14288","14250  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مِرَاءٌ فِي الْقُرْآنِ كُفْرٌ  .","","Al-Mu'jam al-Kabir 14250","","عبد الله بن عمرو بن العاص عن محمد بن عبد الرحمن بن ثوبان القرشي عن موسى بن عبيدة بن نشيط الحميري عن إسحاق بن سليمان الرازي عن سعيد بن سليمان سعدويه عن محمد بن الفضل بن جابر السقطى عن الطبراني","سفيان بن عوف عن عبد الله"
"14289","[13/413]      14251  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  حَدَّثَنَا  خَالِدُ بْنُ نِزَارٍ ،  ثَنَا  هِشَامُ بْنُ سَعْدٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ،  عَنْ  رَبِيعَةَ بْنِ سَيْفٍ ،  عَنْ  عِيَاضِ بْنِ عُقْبَةَ الْفِهْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ مُسْلِمٍ يَمُوتُ فِي يَوْمِ الْجُمُعَةِ أَوْ لَيْلَةِ جُمُعَةٍ ، إِلَّا وَقَاهُ اللهُ فِتْنَةَ الْقَبْرِ  .","","Al-Mu'jam al-Kabir 14251","","عبد الله بن عمرو بن العاص عن عياض بن عقبة الفهري عن ربيعة بن سيف المعافري عن سعيد بن أبي هلال الليثي عن هشام بن سعد المخزومي عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","سفيان بن عوف عن عبد الله"
"14290","[13/414]      14252  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ وَأَبُو حَاتِمٍ رَوْحُ بْنُ الْفَرَجِ الْبَغْدَادِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ زُنْبُورٍ ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  بَيْنَمَا أَنَا أَمْشِي مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذْ سَمِعْنَا الْوَاعِيَةَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اذْهَبْ فَانْظُرْ مَا هَذَا ؟ "" قَالَ : هُوَ  عَبْدُ اللهِ بْنُ رَوَاحَةَ  مَاتَ !  قَالَ : "" لَمْ يَمُتْ "" ،  فَأَفَاقَ  وَكَانَ أُغْمِيَ عَلَيْهِ ، فَأُخْبِرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَأْتِيهِ ، فَتَلَقَّاهُ ، فَقَالَ : يَا رَسُولَ اللهِ ، أُغْمِيَ عَلَيَّ فَصَاحَتِ النِّسَاءُ : وَاعِزَّاهُ !! وَاجَبَلَاهُ !! فَقَالَ مَلَكٌ مَعَهُ  مِرْزَبَّةٌ  فَجَعَلَهَا بَيْنَ رِجْلَيْهِ ، فَقَالَ : كَمَا يَقُولُ هَؤُلَاءِ تَقُولُ ؟ قُلْتُ : لَا ، فَلَوْ قُلْتُ : نَعَمْ ، ضَرَبَنِي بِهَا  .","","Al-Mu'jam al-Kabir 14252","","عبد الله بن عمرو بن العاص عن ذكوان السمان عن الأعمش عن محمد بن جابر بن سيار عن محمد بن زنبور الهاشمي عن روح بن الفرج بن زكريا البغدادي عن الطبراني","سفيان بن عوف عن عبد الله"
"14291","14253  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي ،  أَبَنَا  جَرِيرُ         [13/415]      بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  عِيسَى - أُرَاهُ مِنْ  أَهْلِ الْمَدِينَةِ  -  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَلَمَةَ - أَوْ سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ  -  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  قَدْ أَفْلَحَ مَنْ أَسْلَمَ وَكَانَ رِزْقُهُ كَفَافًا وَصَبَرَ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 14253","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن سلمة الجمحي عن عيسى بن حطان الرقاشي عن ليث بن أبي سليم عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14292","14254  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ السَّوْطِيُّ ،  ثَنَا  عَفَّانُ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  هِلَالِ بْنِ طَلْحَةَ أَوْ طَلْحَةَ بْنِ هِلَالٍ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَوْمُ ثَلَاثَةِ أَيَّامٍ صَوْمُ الدَّهْرِ ;         {      مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا         }      ، قُلْتُ : فَإِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، فَقَالَ : "" صُمْ صَوْمَ  دَاوُدَ  ، كَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا  .","","Al-Mu'jam al-Kabir 14254","","عبد الله بن عمرو بن العاص عن طلحة بن هلال العامري عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن عفان بن مسلم الصفار عن أحمد بن يحيى السوطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14293","[13/416]      14255  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  مَالِكُ بْنُ أَنَسٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُحَمَّدِ بْنِ سَعْدٍ ،  عَنْ  مَوْلًى لِعَبْدِ اللهِ بْنِ عَمْرٍو ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ الرَّجُلِ قَاعِدًا عَلَى نِصْفِ صَلَاتِهِ وَهُوَ قَائِمٌ  .","","Al-Mu'jam al-Kabir 14255","","عبد الله بن عمرو بن العاص عن مولى لعبد الله بن عمرو عن إسماعيل بن محمد بن سعد عن مالك بن أنس عن روح بن عبادة القيسي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14294","14256  -  حَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ ،  ثَنَا  أَحْمَدُ بْنُ عَبْدِ الْمَلِكِ بْنِ وَاقِدٍ الْحَرَّانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  إِبْرَاهِيمَ بْنِ الْمُهَاجِرِ ،  عَنْ  إِسْمَاعِيلَ مَوْلَى عَبْدِ اللهِ بْنِ عَمْرٍو ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  وَالَّذِي نَفْسِي بِيَدِهِ لَقَتْلُ الْمُؤْمِنِ أَعْظَمُ عِنْدَ اللهِ يَوْمَ الْقِيَامَةِ مِنْ زَوَالِ الدُّنْيَا  .","","Al-Mu'jam al-Kabir 14256","","عبد الله بن عمرو بن العاص عن إسماعيل السهمي مولى عبد الله بن عمرو بن العاص عن إبراهيم بن مهاجر بن جابر البجلي عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن أحمد بن عبد الملك بن واقد الحراني عن أبو شعيب الحراني عن الطبراني","سفيان بن عوف عن عبد الله"
"14295","[13/417]      14257  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عِمْرَانَ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ الرَّازِيُّ ،  عَنْ  أَبِي سِنَانٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  شُعَيْبِ بْنِ عَبْدِ اللهِ بْنِ عَمْرٍو ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  ، قَالَ : كُنْتُ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الدُّنْيَا حُلْوَةٌ  خَضِرَةٌ  ، فَمِنْ أَخَذَهَا بِحَقِّهِ بُورِكَ لَهُ فِيهَا  ، وَرُبَّ  مُتَخَوِّضٍ  فِيمَا اشْتَهَتْ نَفْسُهُ لَيْسَ لَهُ يَوْمَ الْقِيَامَةِ إِلَّا النَّارَ  .","","Al-Mu'jam al-Kabir 14257","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن حبيب بن أبي ثابت الكاهلي عن سعيد بن سنان البرجمي عن إسحاق بن سليمان الرازي عن عبد الله بن عمران بن أبي علي عن علي بن سعيد بن بشير عليك عن الطبراني","سفيان بن عوف عن عبد الله"
"14296","14258  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  شُعَيْبِ بْنِ عَبْدِ اللهِ بْنِ عَمْرٍو ،         [13/418]      عَنْ  أَبِيهِ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لَهُ :  صُمْ يَوْمًا وَلَكَ عَشَرَةُ أَيَّامٍ  ، قَالَ : زِدْنِي يَا رَسُولَ اللهِ ، قَالَ : "" صُمْ يَوْمَيْنِ وَلَكَ تِسْعَةُ أَيَّامٍ "" ، قَالَ : زِدْنِي يَا رَسُولَ اللهِ ، قَالَ : "" صُمْ ثَلَاثَةَ أَيَّامٍ ، وَلَكَ ثَمَانِيَةُ أَيَّامٍ  ، قَالَ : فَأَخْبَرْتُ بِذَلِكَ  مُطَرِّفًا  ، فَقَالَ :  مَا أُرَاهُ إِلَّا يُزَادُ فِي الْعَمَلِ وَيُنْقَصُ مِنَ الْأَجْرِ  .","","Al-Mu'jam al-Kabir 14258","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن ثابت البناني عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14297","14259  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  حَدَّثَنَا  مُعَلَّى بْنُ أَسَدٍ الْعَمِّيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْمُخْتَارِ ،  عَنْ  يَحْيَى بْنِ أَبِي إِسْحَاقَ ،  عَنْ  عَبْدَةَ بْنِ أَبِي لُبَابَةَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي عَبْدِ اللهِ مَوْلَى عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ عَمْرٍو وَهُوَ يَطُوفُ  بِالْبَيْتِ  : قَالَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي هَذِهِ الْأَيَّامِ :  مَا مِنْ أَيَّامٍ أَحَبُّ إِلَى اللهِ الْعَمَلُ فِيهِنَّ مِنْ هَذِهِ الْأَيَّامِ  ، فَقِيلَ : يَا رَسُولَ اللهِ ، وَلَا  الْجِهَادُ  فِي  سَبِيلِ  اللهِ ؟ قَالَ :         [13/419]      "" وَلَا  الْجِهَادُ  فِي  سَبِيلِ  اللهِ ، إِلَّا مَنْ خَرَجَ بِنَفْسِهِ وَمَالِهِ ثُمَّ لَمْ يَرْجِعْ حَتَّى يُهَرَاقَ دَمُهُ  .  قَالَ  يَحْيَى : فَلَقِيتُ حَبِيبَ بْنَ أَبِي ثَابِتٍ  وَسَأَلْتُهُ  ؟ فَحَدَّثَ نَحْوًا مِنْ هَذَا  ، فَقِيلَ  لِيَحْيَى  : لَمْ يُخَالِفْهُ ؟ قَالَ : لَا ، وَحَدَّثَنِي أَنَّهَا أَيَّامُ الْعَشْرِ .","","Al-Mu'jam al-Kabir 14259","","عبد الله بن عمرو بن العاص عن أبو عبد الله , مولى عبد الله بن عمرو بن العاص عن حبيب بن أبي ثابت الكاهلي عن عبدة بن أبي لبابة عن يحيى بن أبي إسحاق الحضرمي عن عبد العزيز بن المختار الدباغ عن معلى بن أسد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14298","14260  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ الْجَعْدِ ،  ثَنَا  قَتَادَةُ ،  حَدَّثَنِي  عَطَاءُ بْنُ أَبِي رَبَاحٍ أَنَّ مَوْلًى لِعَبْدِ اللهِ بْنِ عَمْرٍو  حَدَّثَهُ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ نَبِيِّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مِنْ طَافَ بِهَذَا  الْبَيْتِ  أُسْبُوعًا  وَصَلَّى خَلْفَ  مَقَامِ إِبْرَاهِيمَ  عَلَيْهِ السَّلَامُ رَكْعَتَيْنِ فَهُوَ عِدْلُ  مُحَرَّرٍ  .","","Al-Mu'jam al-Kabir 14260","","عبد الله بن عمرو بن العاص عن مولى لعبد الله بن عمرو عن عطاء بن أبي رباح عن قتادة بن دعامة عن حماد بن الجعد الهذلي عن هدبة بن خالد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14299","[13/420]      14261  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ أَبِي عَبَّادٍ .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ قَالَا :  ثَنَا  يَعْلَى بْنُ الْحَارِثِ الْمُحَارِبِيُّ ،  عَنْ  بَكْرِ بْنِ وَائِلٍ قَالَ :  سَمِعْتُ  الزُّهْرِيَّ  يُحَدِّثُ عَنْ  مَوْلًى لِعَبْدِ اللهِ بْنِ عَمْرٍو ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  فَشَا الْوَجَعُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكَثُرَ مَنْ يُصَلِّي وَهُوَ قَاعِدٌ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَلَاةُ الْقَاعِدِ عَلَى النِّصْفِ مِنْ صَلَاةِ الْقَائِمِ  .","","Al-Mu'jam al-Kabir 14261","","عبد الله بن عمرو بن العاص عن مولى لعبد الله بن عمرو عن الزهري عن بكر بن وائل التيمي عن يعلى بن الحارث بن حرب المحاربي عن أحمد بن عبد الله اليربوعي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سفيان بن عوف عن عبد الله"
"14300","14262  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  رَجَاءٌ أَبُو يَحْيَى صَاحِبُ السَّقَطِ ،  ثَنَا  مُسَافِعُ بْنُ شَيْبَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : أَشْهَدُ بِاللهِ لَسَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ  الرُّكْنَ  وَالْمَقَامَ  يَاقُوتَتَانِ مِنْ يَوَاقِيتِ الْجَنَّةِ طَمَسَ اللهُ نُورَهُمَا  ، وَلَوْلَا مَا طَمَسَ اللهُ نُورَهُمَا لَأَضَاءَتَا مَا بَيْنَ الْمَشْرِقِ وَالْمَغْرِبِ  .","","Al-Mu'jam al-Kabir 14262","","عبد الله بن عمرو بن العاص عن مسافع بن عبد الله الأكبر الحجبي عن رجاء بن صبيح السقطي عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14301","[13/421]      14263  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو عُمَرَ الضَّرِيرُ وَعَبْدُ الرَّحْمَنِ بْنُ الْمُبَارَكِ الْعَيْشِيُّ .         [13/422]      وَحَدَّثَنَا  أَحْمَدُ بْنُ خُلَيْدٍ الْحَلَبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ; قَالُوا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  يُوسُفَ بْنِ مَاهَكَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ ،  فَأَرْهَقْنَا  صَلَاةَ الْعَصْرِ ، فَتَوَضَّأْنَا ، فَجَعَلْنَا نَمْسَحُ عَلَى أَقْدَامِنَا ،  فَنَادَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَوْ قَالَ مُنَادِي رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  :  وَيْلٌ  لِلْأَعْقَابِ  مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 14263","","عبد الله بن عمرو بن العاص عن يوسف بن ماهك الفارسي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن أحمد بن خليد بن يزيد الحلبي عن الطبراني","سفيان بن عوف عن عبد الله"
"14302","14264  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ الْأَخْنَسِ  حَدَّثَنِي  الْوَلِيدُ بْنُ عَبْدِ اللهِ ،  عَنْ  يُوسُفَ بْنِ مَاهَكَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  كُنْتُ أَكْتُبُ كُلَّ شَيْءٍ سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُرِيدُ حِفْظَهُ ، فَنَهَتْنِي  قُرَيْشٌ  ، فَقَالُوا : تَكْتُبُ كُلَّ شَيْءٍ         [13/423]      تَسْمَعُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَشَرٌ يَتَكَلَّمُ فِي الْغَضَبِ وَالرِّضَا ! فَأَمْسَكْتُ عَنِ الْكِتَابِ ، فَذَكَرْتُ ذَلِكَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَوْمَأَ بِإِصْبَعِهِ إِلَى فِيهِ وَقَالَ :  اكْتُبْ ، فَوَالَّذِي نَفْسِي بِيَدِهِ مَا يَخْرُجُ مِنْهُ إِلَّا حَقٌّ  .","","Al-Mu'jam al-Kabir 14264","","عبد الله بن عمرو بن العاص عن يوسف بن ماهك الفارسي عن الوليد بن عبد الله بن أبي مغيث العبدري عن عبيد الله بن الأخنس النخعي عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14303","14265  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ .         [13/424]      وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ قَالَا :  ثَنَا  مِسْعَرٌ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي الْعَبَّاسِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَجُلٌ  يَسْتَأْذِنُهُ فِي  الْجِهَادِ  ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَحَيٌّ وَالِدَاكَ ؟ "" قَالَ : نَعَمْ ، قَالَ : "" فَفِيهِمَا فَجَاهِدْ  .","","Al-Mu'jam al-Kabir 14265","","عبد الله بن عمرو بن العاص عن السائب بن فروخ الشاعر عن حبيب بن أبي ثابت الكاهلي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14304","14266  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  عَاصِمُ بْنُ النَّضْرِ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  ثَنَا  أَبِي  ،  ثَنَا  مِسْعَرٌ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي الْعَبَّاسِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ  رَجُلًا  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُرِيدُ  الْجِهَادَ  وَالْهِجْرَةَ ، فَأَخْبَرَهُ أَنَّ لَهُ أَبَوَيْنِ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فَفِيهِمَا فَجَاهِدْ  .","","Al-Mu'jam al-Kabir 14266","","عبد الله بن عمرو بن العاص عن السائب بن فروخ الشاعر عن حبيب بن أبي ثابت الكاهلي عن مسعر بن كدام عن سليمان بن طرخان عن معتمر بن سليمان عن عاصم بن النضر الأحول عن عبد الله بن أحمد الجواليقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14305","14267  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا         [13/425]      سُفْيَانُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي الْعَبَّاسِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : إِنِّي أُرِيدُ  الْجِهَادَ  ، قَالَ :  أَحَيٌّ وَالِدَاكَ ؟ "" قَالَ : نَعَمْ ، قَالَ : "" فَفِيهِمَا فَجَاهِدْ  .","","Al-Mu'jam al-Kabir 14267","","عبد الله بن عمرو بن العاص عن السائب بن فروخ الشاعر عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن محمد بن كثير العبدي عن محمد بن محمد بن حيان التمار عن الطبراني","سفيان بن عوف عن عبد الله"
"14306","14268  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ أَعْيَنَ ،  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا  شُعْبَةُ ،  أَخْبَرَنِي  حَبِيبُ بْنُ أَبِي ثَابِتٍ  أَنَّ  أَبَا الْعَبَّاسِ الْمَكِّيَّ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْتَأْذِنُهُ فِي  الْجِهَادِ  ، فَقَالَ :  أَحَيٌّ وَالِدَاكَ ؟ "" قَالَ : نَعَمْ ، قَالَ : "" فَفِيهِمَا فَجَاهِدْ  .  هُوَ :  أَبُو الْعَبَّاسِ الشَّاعِرُ ، وَاسْمُهُ : السَّائِبُ بْنُ فَرُّوخَ ، وَقِيلَ : الْحَجَّاجُ بْنُ فَرُّوخَ  .","","Al-Mu'jam al-Kabir 14268","","عبد الله بن عمرو بن العاص عن السائب بن فروخ الشاعر عن حبيب بن أبي ثابت الكاهلي عن شعبة بن الحجاج عن علي بن الجعد عن محمد بن جعفر بن أعين البغدادي عن الطبراني","سفيان بن عوف عن عبد الله"
"14307","[13/426]      14269  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  ثَنَا  سُفْيَانُ وَشُعْبَةُ قَالَا :  ثَنَا  حَبِيبُ بْنُ أَبِي ثَابِتٍ ،  عَنْ  أَبِي الْعَبَّاسِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  جَاءَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنِّي أُرِيدُ  الْجِهَادَ  ، فَقَالَ :  أَحَيٌّ وَالِدَاكَ ؟ "" ، قَالَ : نَعَمْ ، قَالَ : "" فَفِيهِمَا فَجَاهِدْ  .","","Al-Mu'jam al-Kabir 14269","","عبد الله بن عمرو بن العاص عن السائب بن فروخ الشاعر عن حبيب بن أبي ثابت الكاهلي عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14308","14270  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي الْعَبَّاسِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا صَامَ مَنْ صَامَ الْأَبَدَ  .","","Al-Mu'jam al-Kabir 14270","","عبد الله بن عمرو بن العاص عن السائب بن فروخ الشاعر عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14309","[13/427]      14271  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي الْعَبَّاسِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَحَبُّ الصِّيَامِ إِلَى اللهِ صِيَامُ  دَاوُدَ  ، يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا ، وَلَا يَفِرُّ إِذَا لَاقَى  .","","Al-Mu'jam al-Kabir 14271","","عبد الله بن عمرو بن العاص عن السائب بن فروخ الشاعر عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","سفيان بن عوف عن عبد الله"
"14310","14272  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَبَنَا  خَالِدٌ ،  عَنْ  مُطَرِّفِ بْنِ طَرِيفٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ         [13/428]      أَبِي الْعَبَّاسِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَمْ أُخْبَرْ أَنَّكَ تَقُومُ اللَّيْلَ وَتَصُومُ النَّهَارَ  ؟ "" قُلْتُ : بَلَى يَا رَسُولَ اللهِ ، وَمَا أَرَدْتُ بِذَلِكَ إِلَّا الْخَيْرَ . قَالَ : "" فَلَا تَفْعَلْ ; فَإِنَّكَ إِذَا فَعَلْتَ ذَلِكَ  هَجَمَتْ  لَهُ الْعَيْنُ ،  وَنَفِهَتْ  لَهُ النَّفْسُ ، وَلَا صَامَ مَنْ صَامَ الْأَبَدَ ، وَلَكِنْ أَدُلُّكَ عَلَى صَوْمِ الدَّهْرِ ; ثَلَاثَةُ أَيَّامٍ مِنْ كُلِّ شَهْرٍ ، فَذَلِكَ صَوْمُ الدَّهْرِ "" .  قُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ . قَالَ : "" فَصُمْ مِنَ  الشَّهْرِ  خَمْسًا "" ، قُلْتُ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : "" فَصُمْ صَوْمَ  دَاوُدَ  ; فَإِنَّهُ كَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا ، وَلَا يَفِرُّ إِذَا لَاقَى  .","","Al-Mu'jam al-Kabir 14272","","عبد الله بن عمرو بن العاص عن السائب بن فروخ الشاعر عن حبيب بن أبي ثابت الكاهلي عن مطرف بن طريف عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","سفيان بن عوف عن عبد الله"
"14311","14273  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  الرَّبِيعُ بْنُ يَحْيَى الْأُشْنَانِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  أَبِي الْعَبَّاسِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لَهُ :  اقْرَأِ الْقُرْآنَ فِي خَمْسٍ  .","","Al-Mu'jam al-Kabir 14273","","عبد الله بن عمرو بن العاص عن السائب بن فروخ الشاعر عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن الربيع بن يحيى المرئي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14312","[13/429]      14274  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  أَبِي الْعَبَّاسِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  ذَكَرَ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَوْمًا يَجْتَهِدُونَ فِي الْعِبَادَةِ اجْتِهَادًا شَدِيدًا ، فَقَالَ :  تِلْكَ  ضَرَاوَةُ  الْإِسْلَامِ  وَشِرَّتُهُ  ، وَلِكُلِّ  شِرَّةٍ  فَتْرَةٌ  ، فَمَنْ كَانَتْ فَتْرَتُهُ إِلَى اقْتِصَادٍ فَنِعِمَّا هُوَ ، وَمَنْ كَانَتْ فَتْرَتُهُ إِلَى الْمَعَاصِي فَأُولَئِكَ هُمُ الْهَالِكُونَ  .","","Al-Mu'jam al-Kabir 14274","","عبد الله بن عمرو بن العاص عن السائب بن فروخ الشاعر عن أبو الزبير المكي عن محمد بن إسحاق عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","سفيان بن عوف عن عبد الله"
"14313","[13/430]      14275  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  هِشَامُ بْنُ يُوسُفَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَمْرِو بْنِ أَوْسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَحَبُّ الصِّيَامِ إِلَى اللهِ صِيَامُ  دَاوُدَ  كَانَ يَصُومُ نِصْفَ الدَّهْرِ  ، وَأَحَبُّ الصَّلَاةِ إِلَى اللهِ صَلَاةُ         [13/431]      دَاوُدَ  كَانَ يَرْقُدُ  شَطْرَ  اللَّيْلِ وَيَقُومُ ثُمَّ يَرْقُدُ آخِرَهُ ، ثُمَّ يَقُومُ ثُلُثَ اللَّيْلِ بَعْدَ  شَطْرِهِ  .","","Al-Mu'jam al-Kabir 14275","","عبد الله بن عمرو بن العاص عن عمرو بن أوس بن أبي أوس الثقفي عن عمرو بن دينار الأثرم عن ابن جريج عن هشام بن يوسف الأبناوي عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14314","14276  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  سَالِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  كَانَ عَلَى  ثَقَلِ  النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَجُلٌ يُقَالُ لَهُ  كِرْكِرَةُ  .","","Al-Mu'jam al-Kabir 14276","","عبد الله بن عمرو بن العاص عن سالم بن أبي الجعد الغطفاني عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14315","[13/432]      14277  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَلْمَانَ ،  عَنْ  عُقَيْلِ بْنِ خَالِدٍ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ أَنَّ شُعَيْبًا  وَمُجَاهِدًا  حَدَّثَاهُ  أَنَّ عَبْدَ اللهِ بْنَ عَمْرٍو  حَدَّثَهُمْ  ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ إِنِّي لَأَعِي حَدِيثَكَ وَأَسْتَعِينُ بِيَدِي ؟ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" نَعَمْ "" ، قُلْتُ : يَا رَسُولَ اللهِ فِي الْغَضَبِ وَالرِّضَا ؟ قَالَ :  نَعَمْ ؛ فَإِنِّي لَا أَقُولُ إِلَّا حَقًّا  .","","Al-Mu'jam al-Kabir 14277","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن عمرو بن شعيب عن عقيل بن خالد الأيلي عن عبد الرحمن بن سلمان الرعيني عن عبد الله بن وهب المصري عن يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","سفيان بن عوف عن عبد الله"
"14316","14278  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  إِسْحَاقُ بْنُ يَحْيَى بْنِ طَلْحَةَ بْنِ عُبَيْدِ اللهِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ         [13/433]      عَمْرٍو قَالَ :  كَانَ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَاسٌ مِنْ أَصْحَابِهِ وَأَنَا مَعَهُمْ ، وَأَنَا أَصْغَرُ  الْقَوْمِ  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  ، فَلَمَّا خَرَجَ  الْقَوْمُ  قُلْتُ : كَيْفَ تُحَدِّثُونَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَدْ سَمِعْتُمْ مَا قَالَ ؟ وَأَنْتُمْ تَتَهَمَّكُونَ فِي الْحَدِيثِ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَضَحِكُوا وَقَالُوا : يَا ابْنَ أَخِينَا ، إِنَّ كُلَّ مَا سَمِعْنَا مِنْهُ عِنْدَنَا فِي كِتَابٍ  .","","Al-Mu'jam al-Kabir 14278","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن إسحاق بن يحيى بن طلحة التيمي عن عاصم بن علي الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14317","14279  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ يَحْيَى بْنِ طَلْحَةَ ،  عَنْ  مُجَاهِدٍ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ :  أَرَادَ  مُعَاوِيَةُ  أَنْ يَأْخُذَ بَعْضَ مَالِهِ ، فَجَمَعَ بَنِيهِ فَقَالَ لَهُمْ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ ظُلِمَ مَالَهُ فَقَاتَلَ دُونَهُ فَقُتِلَ فَهُوَ  شَهِيدٌ  .","","Al-Mu'jam al-Kabir 14279","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن إسحاق بن يحيى بن طلحة التيمي عن عاصم بن علي الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14318","[13/434]      14280  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُوسَى بْنِ أَبِي عُثْمَانَ الْأَنْمَاطِيُّ ،  ثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ الْبَصْرِيُّ ،  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الرَّحِمَ مُعَلَّقَةٌ بِالْعَرْشِ  ، وَلَيْسَ الْوَاصِلُ بِالْمُكَافِئِ ، وَلَكِنَّ الْوَاصِلَ إِذَا قُطِعَتْ رَحِمُهُ وَصَلَهَا  .","","Al-Mu'jam al-Kabir 14280","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن حرملة الأسلمي عن بشر بن المفضل عن موسى بن محمد بن سعيد البصري عن ابن بلعها عبد الله بن موسى الدهقان عن الطبراني","سفيان بن عوف عن عبد الله"
"14319","14281  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  دَاوُدَ بْنِ شَابُورَ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا زَالَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ يُوصِينِي بِالْجَارِ حَتَّى ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُ  .","","Al-Mu'jam al-Kabir 14281","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن داود بن شابور المكي عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن أبو مسلم الكجي عن الطبراني","سفيان بن عوف عن عبد الله"
"14320","[13/435]      14282  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  دَاوُدَ بْنِ شَابُورَ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  خُذُوا الْقُرْآنَ مِنْ أَرْبَعَةٍ : رَجُلَيْنِ مِنَ  الْمُهَاجِرِينَ  وَرَجُلَيْنِ مِنَ  الْأَنْصَارِ  ؛ مِنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  وَسَالِمٍ مَوْلَى أَبِي حُذَيْفَةَ  ،  وَأُبَيِّ بْنِ كَعْبٍ  وَمُعَاذِ بْنِ جَبَلٍ  "" .  قَالَ : وَخَصَّ  عَبْدَ اللهِ بْنَ مَسْعُودٍ  بِكَلِمَةٍ قَالَ : "" مَنْ أَرَادَ أَنْ يَقْرَأَ الْقُرْآنَ  غَضًّا  كَمَا أُنْزِلَ ، فَلْيَقْرَأْ كَمَا يَقْرَؤُهُ  ابْنُ أُمِّ عَبْدٍ  .","","Al-Mu'jam al-Kabir 14282","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن داود بن شابور المكي عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن أبو مسلم الكجي عن الطبراني","سفيان بن عوف عن عبد الله"
"14321","[13/436]      14283  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  الْمُغِيرَةِ بْنِ حَكِيمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ إِنِّي أَسْمَعُ مِنْكَ أَشْيَاءَ فِي الْغَضَبِ ، أَفَأَكْتُبُهَا ؟ قَالَ :  نَعَمْ ؛ فَإِنِّي لَا أَقُولُ فِي الْغَضَبِ وَالرِّضَا إِلَّا حَقًّا  .","","Al-Mu'jam al-Kabir 14283","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن المغيرة بن حكيم الأبناوي عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14322","14284  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ ،  حَدَّثَنَا  أَبُو زَيْدٍ النَّحْوِيُّ سَعِيدُ بْنُ أَوْسٍ ،  ثَنَا  [ شُعْبَةُ ] ،  عَنِ  الْحَكَمِ قَالَ :  سَمِعْتُ  مُجَاهِدًا ،  قَالَ  :  أَرَادَ  مُعَاوِيَةُ  أَنْ يَدَّعِيَ  جُنَادَةَ بْنَ أَبِي أُمَيَّةَ  رَجُلًا مِنَ الْأَزْدِ - فَقَالَ لَهُ عَبْدُ اللهِ بْنُ عَمْرٍو - سَمِعْتُهُ  وَرَفَعَهُ  - قَالَ :  مَنِ  ادَّعَى         [13/437]      إِلَى غَيْرِ أَبِيهِ لَمْ يَجِدْ رَائِحَةَ الْجَنَّةِ  ، وَإِنَّ رِيحَهُ لَيُوجَدُ مِنْ قَدْرِ سَبْعِينَ عَامًا "" ، فَلَمَّا بَلَغَ ذَلِكَ  جُنَادَةَ  قَالَ : يَا أَمِيرَ الْمُؤْمِنِينَ إِنَّمَا أَنَا  سَهْمٌ  مِنْ كِنَانَتِكَ فَارْمِ بِي حَيْثُ شِئْتَ  .","","Al-Mu'jam al-Kabir 14284","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن سعيد بن أوس بن ثابت عن محمد بن يحيى بن المنذر القزاز عن الطبراني","سفيان بن عوف عن عبد الله"
"14323","14285  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 14285","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن روح بن عبادة القيسي عن محمد بن أبي بكر المقدمي عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14324","14286  -  حَدَّثَنَا  جَعْفَرُ بْنُ أَحْمَدَ الشَّامِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  فِرْدَوْسُ بْنُ الْأَشْعَرِيِّ ،  عَنْ  مَسْعُودِ بْنِ سُلَيْمَانَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  جُنَادَةَ بْنِ أَبِي أُمَيَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنِ  ادَّعَى  إِلَى غَيْرِ أَبِيهِ لَمْ يَجِدْ رَوْحَ الْجَنَّةِ  ، وَإِنَّهُ لَيُوجَدُ مِنْ  مَسِيرَةِ  سَبْعِينَ عَامًا  .","","Al-Mu'jam al-Kabir 14286","","عبد الله بن عمرو بن العاص عن جنادة بن أبي أمية الأزدي عن مجاهد بن جبر المخزومي عن حبيب بن أبي ثابت الكاهلي عن مسعود بن سليمان عن فردوس بن الأشعري الكوفي عن أبو كريب محمد بن العلاء عن ابن الرواس جعفر بن أحمد بن عاصم عن الطبراني","سفيان بن عوف عن عبد الله"
"14325","[13/438]      14287  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  مَنْصُورُ بْنُ أَبِي الْأَسْوَدِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  مَرَّ بِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا أُصَلِّي قَاعِدًا ، فَقَالَ :  اعْلَمْ أَنَّ صَلَاةَ الْقَاعِدِ عَلَى النِّصْفِ مِنْ صَلَاةِ الْقَائِمِ  .","","Al-Mu'jam al-Kabir 14287","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن الأعمش عن منصور بن أبي الأسود الليثي عن سعيد بن سليمان سعدويه عن محمد بن أحمد بن النضر النضري عن الطبراني","سفيان بن عوف عن عبد الله"
"14326","14288  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  خَلَّادُ بْنُ يَزِيدَ ،  عَنْ  شَرِيكٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَدْعُو : "" اللَّهُمَّ إِنِّي أَسْأَلُكَ عِيشَةً نَقِيَّةً ، وَمِيتَةً سَوِيَّةً ، وَمَرَدًّا غَيْرَ مَخْزِيٍّ  .","","Al-Mu'jam al-Kabir 14288","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن الأعمش عن شريك بن عبد الله النخعي عن خلاد بن يزيد الجعفي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سفيان بن عوف عن عبد الله"
"14327","[13/439]      14289  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  حُمَيْدُ بْنُ مَسْعَدَةَ ،  ثَنَا  حُصَيْنُ بْنُ نُمَيْرٍ ،  عَنْ  حُصَيْنٍ يَعْنِي ابْنَ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  يُكْرَهُ مَهْرُ  الْبَغِيِّ  ، وَأَجْرُ  الْكَاهِنِ  ، وَكَسْبُ الْحَجَّامِ ، وَثَمَنُ الْكَلْبِ  .","","Al-Mu'jam al-Kabir 14289","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن حصين بن عبد الرحمن السلمي عن حصين بن نمير الأنصاري عن حميد السامي عن عبد الله بن أحمد الجواليقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14328","14290  -  حَدَّثَنَا  يَحْيَى بْنُ مُحَمَّدٍ الْحِنَّائِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ جَامِعٍ الْعَطَّارُ ،  ثَنَا  حُصَيْنُ بْنُ نُمَيْرٍ ،  عَنْ  حُصَيْنٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كَفَّارَةُ الْمَجْلِسِ : سُبْحَانَكَ اللَّهُمَّ  وَبِحَمْدِكَ  ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ ، أَسْتَغْفِرُكَ وَأَتُوبُ إِلَيْكَ  .","","Al-Mu'jam al-Kabir 14290","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن حصين بن عبد الرحمن السلمي عن حصين بن نمير الأنصاري عن محمد بن جامع العطار عن يحيى بن محمد بن البختري الحنائي عن الطبراني","سفيان بن عوف عن عبد الله"
"14329","14291  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  حُصَيْنٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [13/440]      قَالَ :  لِكُلِّ عَامِلٍ  فَتْرَةٌ  ، وَلِكُلِّ  فَتْرَةٍ  شِرَّةٌ  ، فَمَنْ كَانَتْ فَتْرَتُهُ إِلَى سُنَّتِي فَقَدْ أَفْلَحَ  .","","Al-Mu'jam al-Kabir 14291","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن حصين بن عبد الرحمن السلمي عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14330","14292  -  حَدَّثَنَا  جَعْفَرُ بْنُ أَحْمَدَ الشَّامِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  فِرْدَوْسُ بْنُ الْأَشْعَرِيِّ ،  عَنْ  مَسْعُودِ بْنِ سُلَيْمَانَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ قَالَ         [13/441]      فِي  الدَّجَّالِ  :  مَا شُبِّهَ عَلَيْكُمْ مِنْهُ ، فَإِنَّ اللهَ عَزَّ وَجَلَّ لَيْسَ  بِأَعْوَرَ  ، يَخْرُجُ فَيَكُونُ فِي الْأَرْضِ أَرْبَعِينَ صَبَاحًا ، يَرُدُّ مِنْهَا كُلَّ  مَنْهَلٍ  إِلَّا  الْكَعْبَةَ  وَبَيْتَ الْمَقْدِسِ  وَالْمَدِينَةَ  ،  الشَّهْرُ  كَالْجُمُعَةِ وَالْجُمُعَةُ كَالْيَوْمِ ، وَمَعَهُ جَنَّةٌ وَنَارٌ ، فَنَارُهُ جَنَّةٌ وَجَنَّتُهُ نَارٌ ، مَعَهُ جَبَلٌ مَنْ خُبْزٍ وَنَهَرٌ مِنْ مَاءٍ ، يَدْعُو بِرَجُلٍ لَا يُسَلِّطُهُ اللهُ إِلَّا عَلَيْهِ ، فَيَقُولُ : مَا تَقُولُ فِيَّ ؟ فَيَقُولُ : أَنْتَ عَدُوُّ اللهِ ، وَأَنْتَ  الدَّجَّالُ  الْكَذَّابُ ، فَيَدْعُو بِمِنْشَارٍ فَيَضَعُهُ  حَذْوَ  رَأْسِهِ فَيَشُقُّهُ حَتَّى يَقَعَ عَلَى الْأَرْضِ ، ثُمَّ يُحْيِيهِ ، فَيَقُولُ : مَا تَقُولُ فِيَّ ؟ فَيَقُولُ : وَاللهِ مَا كُنْتُ أَشَدَّ  بَصِيرَةً  مِنِّي فِيكَ الْآنَ ، أَنْتَ عَدُوُّ اللهِ  الدَّجَّالُ  الَّذِي أَخْبَرَنَا عَنْكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : فَيَهْوِي إِلَيْهِ بِسَيْفِهِ فَلَا يَسْتَطِيعُهُ ، فَيَقُولُ : أَخِّرُوهُ عَنِّي  .","","Al-Mu'jam al-Kabir 14292","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن حبيب بن أبي ثابت الكاهلي عن مسعود بن سليمان عن فردوس بن الأشعري الكوفي عن أبو كريب محمد بن العلاء عن ابن الرواس جعفر بن أحمد بن عاصم عن الطبراني","سفيان بن عوف عن عبد الله"
"14331","14293  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ         [13/442]      مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ الْجَالِسِ عَلَى النِّصْفِ مِنْ صَلَاةِ الْقَائِمِ  .","","Al-Mu'jam al-Kabir 14293","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سفيان بن عوف عن عبد الله"
"14332","14294  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ         [13/443]      عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اسْتَقِيمُوا وَلَنْ  تُحْصُوا  ، وَاعْلَمُوا أَنَّ مِنْ أَفْضَلِ أَعْمَالِكُمُ الصَّلَاةَ ، وَلَا يُحَافِظُ عَلَى الْوُضُوءِ إِلَّا مُؤْمِنٌ  .","","Al-Mu'jam al-Kabir 14294","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","سفيان بن عوف عن عبد الله"
"14333","14295  -  حَدَّثَنَا  أَحْمَدُ بْنُ زِيَادِ بْنِ زَكَرِيَّا الْأَنْصَارِيُّ ،  ثَنَا  يَزِيدُ بْنُ قَيْسٍ ،  ثَنَا  الْمُعَافَى بْنُ عِمْرَانَ الطُّهَوِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَيَّاشٍ ،  عَنْ  جَعْفَرِ بْنِ الْحَارِثِ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اسْتَقِيمُوا وَلَنْ  تُحْصُوا  ، وَاعْلَمُوا أَنَّ مِنْ خَيْرِ أَعْمَالِكُمُ الصَّلَاةَ ، وَلَا يُحَافِظُ عَلَى الْوُضُوءِ إِلَّا مُؤْمِنٌ  .","","Al-Mu'jam al-Kabir 14295","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن جعفر بن الحارث الواسطي عن إسماعيل بن عياش الأحول عن المعافى بن عمران الظهري عن يزيد بن قبيس السيلحيني عن أحمد بن زياد الإيادي عن الطبراني","سفيان بن عوف عن عبد الله"
"14334","14296  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ،  ثَنَا  أَبُو مُوسَى الْهَرَوِيُّ إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْقُدُّوسِ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَمْلَأُ اللهُ أَيْدِيَكُمْ مِنَ الْأَعَاجِمِ فَيَصِيرُونَ أُسْدًا لَا يَفِرُّونَ  ، فَيَضْرِبُونَ أَعْنَاقَكُمْ وَيَأْخُذُونَ فَيْئَكُمْ  .","","Al-Mu'jam al-Kabir 14296","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن عبد الله بن عبد القدوس الرازي عن إسحاق بن إبراهيم الهروي عن محمد بن الفضل بن جابر السقطى عن الطبراني","سفيان بن عوف عن عبد الله"
"14335","[13/444]      14297  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  حَدَّثَنَا  أَبِي  ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  لَيْثٍ .  وَحَدَّثَنَا  مَحْمُودُ بْنُ الْفَرَجِ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  لَمَّا قُتِلَ  عَمَّارُ بْنُ يَاسِرٍ  قَالَ  عَبْدُ اللهِ بْنُ عَمْرٍو : إِنَّا لِلهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ ! سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  تَقْتُلُهُ  الْفِئَةُ  الْبَاغِيَةُ  ،  فَقَالَ  مُعَاوِيَةُ  : نَحْنُ قَتَلْنَاهُ ؟! إِنَّمَا قَتَلَهُ الَّذِينَ أَخْرَجُوهُ  .","","Al-Mu'jam al-Kabir 14297","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن معتمر بن سليمان عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14336","14298  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  أَحْمَدُ بْنُ عَبْدَةَ ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ الْبَكَّائِيُّ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ         [13/445]      عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اسْتَقِيمُوا وَلَنْ  تُحْصُوا  ، وَاعْلَمُوا أَنَّ أَفْضَلَ أَعْمَالِكُمُ الصَّلَاةُ ، وَلَا يُحَافِظُ عَلَى الْوُضُوءِ إِلَّا مُؤْمِنٌ  .","","Al-Mu'jam al-Kabir 14298","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن زياد بن عبد الله البكائي عن أحمد بن عبدة الضبي عن عبد الله بن أحمد الجواليقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14337","14299  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  خَالِدٌ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو -  مَرْفُوعٌ  -         [13/446]      قَالَ :  مَنْ  شَرِبَ  الْخَمْرَ فَجَعَلَهَا فِي بَطْنِهِ لَمْ تُقْبَلْ لَهُ صَلَاةٌ سَبْعًا  ، فَإِنْ مَاتَ مَاتَ كَافِرًا ، فَإِنْ شَرِبَهَا حَتَّى تَغْلِبَهُ عَنْ شَيْءٍ مِنَ الْفَرَائِضِ لَمْ تُقْبَلْ صَلَاتُهُ أَرْبَعِينَ يَوْمًا ، فَإِنْ مَاتَ مَاتَ كَافِرًا  .","","Al-Mu'jam al-Kabir 14299","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن خالد بن عبد الله الطحان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14338","14300  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْبَاقِي الْمِصِّيصِيُّ ،  ثَنَا  الْمُسَيِّبُ بْنُ وَاضِحٍ ،  ثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِعَمَّارٍ  :  تَقْتُلُكَ  الْفِئَةُ  الْبَاغِيَةُ  .","","Al-Mu'jam al-Kabir 14300","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن سويد بن عبد العزيز السلمي عن المسيب بن واضح التلمنسي عن يحيى بن عبد الباقي الثغري عن الطبراني","سفيان بن عوف عن عبد الله"
"14339","14301  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  حَدَّثَنَا  أَبُو نُعَيْمٍ .  وَحَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  خَلَّادُ بْنُ يَحْيَى قَالَا :  ثَنَا  فِطْرُ بْنُ خَلِيفَةَ ،  ثَنَا  مُجَاهِدٌ أَبُو الْحَجَّاجِ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ :         [13/447]      قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الرَّحِمَ مُعَلَّقَةٌ بِالْعَرْشِ  ، وَلَيْسَ الْوَاصِلُ بِالْمُكَافِئِ ، وَلَكِنَّ الْوَاصِلَ الَّذِي إِذَا قُطِعَتْ رَحِمُهُ وَصَلَهَا  .","","Al-Mu'jam al-Kabir 14301","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن فطر بن خليفة عن خلاد بن يحيى الأرحبي عن بشر بن موسى بن صالح الأسدي عن الطبراني","سفيان بن عوف عن عبد الله"
"14340","14302  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ وَالْحَسَنِ بْنِ عَمْرٍو الْفُقَيْمِيِّ وَفِطْرٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ  سُفْيَانُ  : لَمْ  يَرْفَعْهُ  سُلَيْمَانُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَرَفَعَهُ  الْحَسَنُ  وَفِطْرٌ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ الْوَاصِلُ بِالْمُكَافِئِ ، وَلَكِنَّ الْوَاصِلَ الَّذِي إِذَا قُطِعَتْ رَحِمُهُ وَصَلَهَا  .","","Al-Mu'jam al-Kabir 14302","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن فطر بن خليفة عن سفيان الثوري عن محمد بن كثير العبدي عن محمد بن محمد بن حيان التمار عن الطبراني","سفيان بن عوف عن عبد الله"
"14341","[13/448]      14303  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 14303","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن مروان بن معاوية الفزاري عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14342","14304  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الْحَسَنِ بْنِ عَمْرٍو ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَيْسَ الْوَاصِلُ بِالْمُكَافِئِ  ، وَلَكِنَّ الْوَاصِلَ إِذَا قُطِعَتْ رَحِمُهُ وَصَلَهَا  .","","Al-Mu'jam al-Kabir 14304","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن الحسن بن عمرو الفقيمي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","سفيان بن عوف عن عبد الله"
"14343","[13/449]      14305  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ الرَّازِيُّ ،  ثَنَا  سَلَمَةُ بْنُ الْفَضْلِ ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  زُبَيْدٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَيْسَ الْوَاصِلُ بِالْمُكَافِئِ  ، وَلَكِنَّ الْوَاصِلَ مَنْ إِذَا قُطِعَتْ رَحِمُهُ وَصَلَهَا  .","","Al-Mu'jam al-Kabir 14305","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن زبيد بن الحارث اليامي عن سفيان الثوري عن سلمة بن الفضل الأبرش عن عبد الرحمن بن سلمة الأزداني عن علي بن سعيد بن بشير عليك عن الطبراني","سفيان بن عوف عن عبد الله"
"14344","14306  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا الْكُوفِيُّ ،  ثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنْ  فِطْرٍ ،  عَنْ  حَمَّادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ الْوَاصِلُ بِالْمُكَافِئِ  ، وَلَكِنَّ الْوَاصِلَ مَنْ إِذَا قُطِعَتْ رَحِمُهُ وَصَلَهَا  .","","Al-Mu'jam al-Kabir 14306","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن حماد بن أبي سليمان عن فطر بن خليفة عن الفضيل بن عياض عن إسماعيل بن زكريا الكوفي عن عبد الله بن أحمد الجواليقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14345","14307  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ السَّوْطِيُّ ،  ثَنَا  عَفَّانُ ،  ثَنَا  أَبُو         [13/450]      عَوَانَةَ ،  عَنْ  مُغِيرَةَ بْنِ مِقْسَمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  أَنْكَحَنِي أَبِي  امْرَأَةً  ذَاتَ  حَسَبٍ  فَكَانَ يَتَعَاهَدُ  كُنَّتَهُ  وَيَسْأَلُهَا عَنْ  بَعْلِهَا  ، فَيَقُولُ : كَيْفَ  بَعْلُكِ  ؟ فَتَقُولُ : نِعْمَ الرَّجُلُ مِنْ رَجُلٍ لَمْ يَطَأْ لَنَا فِرَاشًا وَلَمْ يُفَتِّشْ لَهَا  كَنَفًا  ، فَلَمَّا طَالَ ذَلِكَ عَلَيْهِ ذَكَرَ ذَلِكَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقَامَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَعَهُ فَلَقِيتُهُ مَعَهُ ، فَقَالَ لِي : ""أَتَصُومُ ؟ "" فَقُلْتُ : أَصُومُ كُلَّ يَوْمٍ ، قَالَ : "" فَكَيْفَ تَخْتِمُ ؟ "" قُلْتُ : كُلَّ يَوْمٍ ، فَقَالَ :  اقْرَأْهُ فِي كُلِّ شَهْرٍ مَرَّةً وَصُمْ ثَلَاثَةَ أَيَّامٍ  ، "" قُلْتُ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : "" فَأَفْطِرْ يَوْمَيْنِ وَصُمْ يَوْمًا "" ، قُلْتُ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : "" فَصُمْ صَوْمَ  دَاوُدَ  ، كَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا ، وَاقْرَأِ         [13/451]      الْقُرْآنَ فِي كُلِّ سَبْعٍ "" .  فَكَانَ يَقُولُ بَعْدَمَا كَبِرَ وَضَعُفَ : لَوْ كُنْتُ قَبِلْتُ رُخْصَةَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ! فَكَانَ يَقْرَأُ السَّبْعَ عِنْدَ أَهْلِهِ بِالنَّهَارِ لِيَقْوَى بِاللَّيْلِ لِيَكُونَ أَخَفَّ عَلَيْهِ ، وَإِذَا أَرَادَ أَنْ يُفْطِرَ أَفْطَرَ أَيَّامًا فَأَحْصَاهُنَّ ، ثُمَّ صَامَ بِعِدَّتِهِنَّ لِكَيْ يَأْتِيَ عَلَى مَا فَارَقَ عَلَيْهِ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 14307","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن عفان بن مسلم الصفار عن أحمد بن يحيى السوطي عن الطبراني","سفيان بن عوف عن عبد الله"
"14346","14308  -  حَدَّثَنَا  مُوسَى بْنُ حَازِمٍ  الْأَصْبَهَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بُكَيْرٍ الْحَضْرَمِيُّ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ الْفَزَارِيُّ ،  عَنِ  الْحَسَنِ بْنِ عَمْرٍو ،  عَنْ  مُجَاهِدٍ ،  عَنْ  جُنَادَةَ بْنِ أَبِي أُمَيَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [13/452]      قَالَ :  مَنْ قَتَلَ قَتِيلًا مِنْ  أَهْلِ الذِّمَّةِ  لَمْ  يَرَحْ  رَائِحَةَ الْجَنَّةِ  ، وَإِنَّ رِيحَهَا لَيُوجَدُ مِنْ  مَسِيرَةِ  مِائَةِ عَامٍ  .  كذا في طبعة الجريسي وهو التصحيف ، والصواب : (بن خازم) .","","Al-Mu'jam al-Kabir 14308","","عبد الله بن عمرو بن العاص عن جنادة بن أبي أمية الأزدي عن مجاهد بن جبر المخزومي عن الحسن بن عمرو الفقيمي عن مروان بن معاوية الفزاري عن محمد بن بكير بن واصل الأصبهاني عن موسى بن خازم بن سيار الأصبهاني عن الطبراني","سفيان بن عوف عن عبد الله"
"14347","14309  -  حَدَّثَنَا  خَلَفُ بْنُ عَمْرٍو الْعُكْبَرِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  الْيَمَانُ بْنُ الْمُغِيرَةِ ،  ثَنَا  عَبْدُ الْكَرِيمِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَلَّى قَبْلَ الْعَصْرِ أَرْبَعًا حَرَّمَهُ اللهُ عَلَى النَّارِ  .","","Al-Mu'jam al-Kabir 14309","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن عبد الكريم بن أبي المخارق عن يمان بن المغيرة العنبري عن سعيد بن سليمان سعدويه عن خلف بن عمرو بن عبد الرحمن العكبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14348","14310  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  زُبَيْدٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا زَالَ  جِبْرِيلُ  يُوصِينِي بِالْجَارِ ، حَتَّى ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُ  .","","Al-Mu'jam al-Kabir 14310","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن زبيد بن الحارث اليامي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","سفيان بن عوف عن عبد الله"
"14349","[13/453]      14311  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْجَمَّالُ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ يَزِيدَ الْقَطَّانُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ رُسْتُمٍ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  سَالِمٍ الْأَفْطَسِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُؤَذِّنُ الْمُحْتَسِبُ  كَالشَّهِيدِ  الْمُتَشَحِّطِ فِي دَمِهِ  ، إِذَا مَاتَ لَمْ يُدَوِّدْ فِي قَبْرِهِ  .","","Al-Mu'jam al-Kabir 14311","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن سالم بن عجلان الأفطس عن قيس بن الربيع الأسدي عن إبراهيم بن رستم الكرماني عن إسماعيل بن يزيد بن حريث القطان عن أحمد بن محمد بن عبد الله الجمال عن الطبراني","سفيان بن عوف عن عبد الله"
"14350","14312  -  حَدَّثَنَا  عُثْمَانُ بْنُ عَمْرٍو الضَّبِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَبَنَا  زَائِدَةُ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اسْتَقِيمُوا وَلَنْ  تُحْصُوا ،  وَاعْلَمُوا أَنَّ مِنْ خَيْرِ أَعْمَالِكُمُ الصَّلَاةَ  ، وَلَا يُحَافِظُ عَلَى الْوُضُوءِ إِلَّا مُؤْمِنٌ  .","","Al-Mu'jam al-Kabir 14312","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن زائدة بن قدامة عن عبد الله بن رجاء الغداني عن عثمان بن عمر الضبي عن الطبراني","سفيان بن عوف عن عبد الله"
"14351","[13/454]      14313  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عِقَالٍ الْحَرَّانِيُّ ،  ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يُخَرِّبُ  الْكَعْبَةَ  ذُو  السُّوَيْقَتَيْنِ  مِنَ  الْحَبَشَةِ  .","","Al-Mu'jam al-Kabir 14313","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن عبد الله بن محمد النفيلي عن أحمد بن عبد الرحمن بن يزيد الحراني عن الطبراني","سفيان بن عوف عن عبد الله"
"14352","14314  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَيُّوبَ بْنِ مَرْزُوقٍ الْمَاوَرْدِيُّ الْبَصْرِيُّ ،  ثَنَا  [ عُبَيْدُ اللهِ] بْنُ عَائِشَةَ ،  ثَنَا  النَّضْرُ بْنُ إِسْمَاعِيلَ الْبَجَلِيُّ ،  ثَنَا  الْحَسَنُ بْنُ عَمْرٍو الْفُقَيْمِيُّ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :         [13/455]      قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا رَأَيْتُمْ أُمَّتِي تَهَابُ الظَّالِمَ أَنْ تَقُولَ لَهُ إِنَّكَ ظَالِمٌ فَقَدْ  تُوُدِّعَ  مِنْهُمْ  .","","Al-Mu'jam al-Kabir 14314","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن الحسن بن عمرو الفقيمي عن النضر بن إسماعيل بن حازم البجلي عن ابن عائشة عن محمد بن أيوب بن مرزوق الماوردي البصري عن الطبراني","سفيان بن عوف عن عبد الله"
"14353","14315  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  الْحُسَيْنُ بْنُ عِيسَى بْنِ مَيْسَرَةَ الرَّازِيُّ ،  حَدَّثَنَا  أَبُو زُهَيْرٍ عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ ،  حَدَّثَنَا  مُوسَى الْجُهَنِيُّ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ مَيْسَرَةَ الزَّرَّادِ ،  عَنْ  مُجَاهِدٍ  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَدْخُلُ مِنْ أَهْلِ هَذِهِ الْقِبْلَةِ النَّارَ مَنْ لَا يُحْصِي عَدَدَهُمْ إِلَّا اللهُ  بِمَا عَصَوُا اللهَ وَاجْتَرَءُوا عَلَى مَعْصِيَتِهِ وَخَالَفُوا طَاعَتَهُ ، فَيُؤْذَنُ لِي فِي الشَّفَاعَةِ ، فَأُثْنِي عَلَى اللهِ سَاجِدًا كَمَا أُثْنِي عَلَيْهِ قَائِمًا ، فَيُقَالُ : ارْفَعْ رَأْسَكَ ، سَلْ تُعْطَهْ ، وَاشْفَعْ تُشَفَّعْ  .","","Al-Mu'jam al-Kabir 14315","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن عبد الملك بن ميسرة الهلالي عن موسى بن عبد الله الجهني عن عبد الرحمن بن مغراء الدوسي عن الحسين بن عيسى الحارثي عن علي بن سعيد بن بشير عليك عن الطبراني","سفيان بن عوف عن عبد الله"
"14354","14316  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هِشَامِ بْنِ أَبِي الدُّمَيْكِ ،  ثَنَا  عَبْدُ اللهِ بْنُ         [13/456]      عُمَرَ بْنِ أَبَانَ مُشْكُدَانَهْ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَحِلُّ إِجَارَتُهَا وَلَا  رِبَاعُهَا  يَعْنِي  مَكَّةَ  .","","Al-Mu'jam al-Kabir 14316","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن إبراهيم بن مهاجر بن جابر البجلي عن إسماعيل بن إبراهيم بن مهاجر النخعي عن عبد الرحيم بن سليمان الأشل عن عبد الله بن عمر مشكدانة عن ابن أبى الدميك محمد بن هشام بن علي عن الطبراني","سفيان بن عوف عن عبد الله"
"14355","14317  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  وَمُحَمَّدُ         [13/457]      بْنُ عَبَّادٍ الْمَكِّيُّ قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  أَبِي قَابُوسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  يَبْلُغُ بِهِ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الرَّاحِمُونَ يَرْحَمُهُمُ الرَّحْمَنُ  ، ارْحَمُوا أَهْلَ الْأَرْضِ يَرْحَمْكُمْ أَهْلُ السَّمَاءِ  .","","Al-Mu'jam al-Kabir 14317","","عبد الله بن عمرو بن العاص عن أبو قابوس مولى عبد الله بن عمرو بن العاص عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14356","14318  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  وَمُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ قَالَا :  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  أَبِي         [13/458]      قَابُوسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  يَبْلُغُ بِهِ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الرَّحِمُ  شِجْنَةٌ  مِنَ الرَّحْمَنِ  ، مَنْ وَصَلَهَا وَصَلَتْهُ وَمَنْ قَطَعَهَا بَتَّتْهُ  .","","Al-Mu'jam al-Kabir 14318","","عبد الله بن عمرو بن العاص عن أبو قابوس مولى عبد الله بن عمرو بن العاص عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14357","14319  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  حَدَّثَنِي  أَبِي  ،  أَخْبَرَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  سَعِيدُ بْنُ كَثِيرٍ أَنَّ جَعْفَرَ بْنَ الْمُطَّلِبِ  أَخْبَرَهُ  أَنَّ  عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ دَخَلَ عَلَى عَمْرِو بْنِ الْعَاصِ أَيَّامَ مِنًى ، فَدَعَاهُ إِلَى  الْغَدَاءِ  ، فَقَالَ : إِنِّي صَائِمٌ  ، ثُمَّ الثَّانِيَةَ فَقَالَ ذَلِكَ ، ثُمَّ الثَّالِثَةَ فَقَالَ : إِنِّي صَائِمٌ ، إِلَّا أَنْ تَكُونَ سَمِعْتَ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَعْنِي النَّهْيَ  ، قَالَ : فَإِنِّي سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 14319","","عمرو بن العاص بن وائل السهمي عن عبد الله بن عمرو بن العاص عن جعفر بن المطلب بن أبي وداعة السهمي عن سعيد بن كثير السهمي عن ابن جريج عن محمد بن بكر بن عثمان البرساني عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14358","[13/459]      14320  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  عُمَرُ بْنُ دِينَارٍ  قَالَ  :  تَيَسَّرَ عَبْدُ اللهِ بْنُ عَمْرٍو لِلْقِتَالِ دُونَ الْوَهْطِ  ، وَقَالَ : مَا لِي لَا أُقَاتِلُ دُونَهُ  وَقَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ قُتِلَ دُونَ مَالِهِ فَهُوَ  شَهِيدٌ  .","","Al-Mu'jam al-Kabir 14320","","عبد الله بن عمرو بن العاص عن عمرو بن دينار الأثرم عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14359","14321  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْمَقْتُولُ دُونَ مَالِهِ شَهِيدٌ  .","","Al-Mu'jam al-Kabir 14321","","عبد الله بن عمرو بن العاص عن عمرو بن دينار الأثرم عن حماد بن زيد عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سفيان بن عوف عن عبد الله"
"14360","14322  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَبَنَا  عَمْرُو بْنُ دِينَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْمَقْتُولُ دُونَ مَالِهِ شَهِيدٌ  .","","Al-Mu'jam al-Kabir 14322","","عبد الله بن عمرو بن العاص عن عمرو بن دينار الأثرم عن حماد بن سلمة عن عبد الواحد بن غياث عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سفيان بن عوف عن عبد الله"
"14361","14323  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى الصَّنْعَانِيُّ ،  ثَنَا  خَالِدُ بْنُ الْحَارِثِ ،  ثَنَا  حَاتِمُ بْنُ أَبِي         [13/460]      صَغِيرَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ قُتِلَ دُونَ مَالِهِ فَهُوَ  شَهِيدٌ  .","","Al-Mu'jam al-Kabir 14323","","عبد الله بن عمرو بن العاص عن عمرو بن دينار الأثرم عن حاتم بن أبي صغيرة القشيري عن خالد الصدق عن محمد بن عبد الأعلى القيسي عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14362","14324  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَزِيعٍ ،  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  عَنْ  أَبِي يُونُسَ الْقُشَيْرِيِّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ صَفْوَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ قَاتَلَ دُونَ مَالِهِ فَقُتِلَ فَهُوَ  شَهِيدٌ  .","","Al-Mu'jam al-Kabir 14324","","عبد الله بن عمرو بن العاص عن عبد الله بن صفوان الجمحي عن عمرو بن دينار الأثرم عن حاتم بن أبي صغيرة القشيري عن بشر بن المفضل عن محمد بن عبد الله بن بزيع البصري عن عبد الله بن أحمد الجواليقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14363","14325  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ دِينَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ لِلْقَاعِدِ فِي الصَّلَاةِ نِصْفَ أَجْرِ الْقَائِمِ  .","","Al-Mu'jam al-Kabir 14325","","عبد الله بن عمرو بن العاص عن عمرو بن دينار الأثرم عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14364","14326  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَامِرِ بْنِ زُرَارَةَ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         [13/461]      كَانَ فِي وَصِيَّةِ  نُوحٍ  لِابْنِهِ : يَا بُنَيَّ أُوصِيكَ  بِخَصْلَتَيْنِ  وَأَنْهَاكَ عَنْ  خَصْلَتَيْنِ  ؛ أُوصِيكَ بِشَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ  فَإِنَّهَا لَوْ كَانَتِ السَّمَاوَاتُ وَالْأَرْضُ فِي كِفَّةٍ وَهِيَ فِي كِفَّةٍ لَوَزَنَتْهَا ، وَأُوصِيكَ بِالتَّسْبِيحِ فَإِنَّهَا عِبَادَةُ الْخَلْقِ وَبِالتَّكْبِيرِ . وَأَنْهَاكَ عَنْ  خَصْلَتَيْنِ  ؛ عَنِ الْكِبْرِ  وَالْخُيَلَاءِ  "" .  قُلْتُ : يَا رَسُولَ اللهِ ، أَمِنَ الْكِبْرِ أَنْ أَرْكَبَ الدَّابَّةَ النَّجِيبَةَ ؟ قَالَ : "" لَا "" .  قُلْتُ : فَمِنَ الْكِبْرِ أَنْ أَلْبَسَ الثَّوْبَ الْحَسَنَ ؟ قَالَ : "" لَا "" .  قُلْتُ : يَا رَسُولَ اللهِ ، فَمَا الْكِبْرُ ؟ قَالَ : "" أَنْ  تُسَفِّهَ  الْحَقَّ وَتُغْمِضَ النَّاسَ  .","","Al-Mu'jam al-Kabir 14326","","عبد الله بن عمرو بن العاص عن عمرو بن دينار الأثرم عن محمد بن إسحاق عن عبد الرحيم بن سليمان الأشل عن عبد الله بن عامر بن زرارة الحضرمي عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14365","14327  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  حَدَّثَنَا  عَطَاءُ بْنُ مُسْلِمٍ الْخَفَّافُ ،  عَنِ  الْأَعْمَشِ قَالَ :  قَالَ  أَبُو عَبْدِ الرَّحْمَنِ         [13/462]      السُّلَمِيُّ :  شَهِدْنَا مَعَ  عَلِيٍّ  صِفِّينَ  وَقَدْ وَكَّلْنَا بِفَرَسِهِ رَجُلَيْنِ ، فَكَانَتْ إِذَا كَانَتْ مِنَ الرَّجُلِ غَفْلَةٌ غَمْزَ  عَلِيٌّ  فَرَسَهُ فَإِذَا هُوَ فِي عَسْكَرِ  الْقَوْمِ  ، فَيَرْجِعُ إِلَيْنَا وَقَدْ خَضَّبَ سَيْفَهُ دَمًا ، وَيَقُولُ إِذَا رَجَعَ : يَا صِحَابِي اعْذُرُونِي اعْذُرُونِي ! وَكُنَّا إِذَا تَوَادَعْنَا دَخَلَ هَؤُلَاءِ فِي عَسْكَرِ هَؤُلَاءِ وَهَؤُلَاءِ فِي عَسْكَرِ هَؤُلَاءِ .  فَكَانَ  عَمَّارُ  بْنُ يَاسِرٍ عَلَمًا لِأَصْحَابِ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، لَا يَسْلُكُ  عَمَّارٌ  وَادِيًا مِنْ أَوْدِيَةِ  صِفِّينَ  إِلَّا تَبِعَهُ أَصْحَابُ  مُحَمَّدٍ  ، فَانْتَهَيْنَا إِلَى  هَاشِمِ بْنِ عُتْبَةَ بْنِ أَبِي وَقَّاصٍ  وَقَدْ رَكَزَ  الرَّايَةَ  ، فَقَالَ : مَا لَكَ يَا  هَاشِمُ  ، أَعَوَرًا وَجُبْنًا ؟! لَا خَيْرَ فِي  أَعْوَرَ  لَا يَغْشَى الْبَأْسَ .  قَالَ : فَنَزَعَ  هَاشِمٌ  الرَّايَةَ  وَهُوَ يَقُولُ :  أَعْوَرُ  عَالَجَ         [13/463]      فَقَالَ لَهُ  عَمَّارٌ  : أَقْدِمْ فَإِنَّ الْجَنَّةَ تَحْتَ  الْبَارِقَةِ ،  قَدْ تَزَيَّنَ  الْحُورُ  الْعِينُ  مَعَ  مُحَمَّدٍ  وَحِزْبِهِ فِي  الرَّفِيقِ  الْأَعْلَى ! فَحَمَلَا ، فَمَا رَجَعَا حَتَّى قُتِلَا .  وَكُنَّا إِذَا تَوَادَعْنَا دَخَلَ هَؤُلَاءِ فِي عَسْكَرِ هَؤُلَاءِ وَهَؤُلَاءِ فِي عَسْكَرِ هَؤُلَاءِ ، فَنَظَرْتُ فَإِذَا أَنَا بِأَرْبَعَةٍ يَسِيرُونَ :  مُعَاوِيَةُ  ،  وَأَبُو الْأَعْوَرِ السُّلَمِيُّ  ،  وَعَمْرُو بْنُ الْعَاصِ  ، وَابْنُهُ ، فَقُلْتُ فِي نَفْسِي : إِنْ أَخَذْتُ عَنْ يَمِينِ اثْنَيْنِ لَمْ أَسْمَعْ كَلَامَهُمْ ، فَاخْتَرْتُ لِنَفْسِي أَنْ أَضْرِبَ فَرَسِي فَأُفَرِّقَ بَيْنَهُمْ ، فَفَعَلْتُ ، فَجَعَلْتُ اثْنَيْنِ عَنْ يَمِينِي وَاثْنَيْنِ عَنْ يَسَارِي ، فَجَعَلْتُ أُصْغِي بِسَمْعِي أَحْيَانًا إِلَى  مُعَاوِيَةَ  وَإِلَى  أَبِي الْأَعْوَرِ  ، وَأَحْيَانًا إِلَى  عَمْرِو بْنِ الْعَاصِ  وَابْنِهِ  عَبْدِ اللهِ بْنِ عَمْرٍو  ،  فَسَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ لِأَبِيهِ : يَا أَبَةِ ، قَتَلْنَا هَذَا الرَّجُلَ ، وَقَدْ قَالَ فِيهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا قَالَ ! فَقَالَ : وَأَيُّ رَجُلٍ ! فَقَالَ :  عَمَّارُ بْنُ يَاسِرٍ  ، أَمَا سَمِعْتَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ يَوْمَ بَنَى الْمَسْجِدَ وَنَحْنُ نَحْمِلُ لَبِنَةً لَبِنَةً  وَعَمَّارٌ         [13/464]      يَحْمِلُ لَبِنَتَيْنِ لَبِنَتَيْنِ ، فَمَرَّ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  تَحْمِلُ لَبِنَتَيْنِ لَبِنَتَيْنِ وَأَنْ تُرْحَضَ ؟! أَمَا إِنَّهُ سَيَقْتُلُكَ  الْفِئَةُ  الْبَاغِيَةُ  ، وَأَنْتَ مِنْ أَهْلِ الْجَنَّةِ  ، فَسَمِعْتُ  عَمْرًا  يَقُولُ  لِمُعَاوِيَةَ  : قَتَلْنَا هَذَا الرَّجُلَ وَقَدْ قَالَ فِيهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا قَالَ ! قَالَ : أَيُّ رَجُلٍ ؟ قَالَ :  عَمَّارُ بْنُ يَاسِرٍ  ، إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ يَوْمَ بَنَى الْمَسْجِدَ وَنَحْنُ نَنْقُلُ لَبِنَةً لَبِنَةً  وَعَمَّارٌ  يَحْمِلُ لَبِنَتَيْنِ لَبِنَتَيْنِ ، فَمَرَّ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : "" يَا أَبَا الْيَقْظَانِ ، أَتَحْمِلُ لَبِنَتَيْنِ وَأَنْتَ تُرْحَضُ؟! أَمَا إِنَّهُ سَتَقْتُلُكَ  الْفِئَةُ  الْبَاغِيَةُ  ، وَأَنْتَ مِنْ أَهْلِ الْجَنَّةِ "" ، فَقَالَ  مُعَاوِيَةُ  : اسْكُتْ ، فَوَاللهِ مَا تَزَالُ تَدْحَضُ فِي بَوْلِكَ ! أَنَحْنُ قَتَلْنَاهُ ؟! إِنَّمَا قَتَلَهُ مَنْ جَاءُوا بِهِ فَأَلْقَوْهُ بَيْنَ رِمَاحِنَا .  قَالَ : فَتَنَادَوْا فِي عَسْكَرِ  مُعَاوِيَةَ  : إِنَّمَا قَتَلَ  عَمَّارًا  مَنْ جَاءَ بِهِ  .","","Al-Mu'jam al-Kabir 14327","","عبد الله بن عمرو بن العاص عن عبد الله بن حبيب السلمي عن الأعمش عن عطاء بن مسلم عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14366","[13/465]      14328  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  عَبْدَ اللهِ بْنَ عَمْرٍو  ، أَتَصُومُ النَّهَارَ وَتَقُومُ اللَّيْلَ  ؟ "" فَقُلْتُ : نَعَمْ ، فَقَالَ : "" إِنَّكَ إِذَا فَعَلْتَ ذَلِكَ  هَجَمَتِ  الْعَيْنَانِ  وَنَفِهَتِ  النَّفْسُ ، إِنَّ لِعَيْنِكَ عَلَيْكَ حَقًّا ، وَإِنَّ لِجَسَدِكَ عَلَيْكَ حَقًّا ، وَإِنَّ لِأَهْلِكَ عَلَيْكَ حَقًّا ، فَقُمْ وَنَمْ ، وَصُمْ وَأَفْطِرْ ؛ صُمْ ثَلَاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ فَذَلِكَ صَوْمُ الدَّهْرِ "" ، فَقُلْتُ : إِنِّي أَقْوَى مِنْ ذَلِكَ ، فَقَالَ : "" لَا صَامَ مَنْ صَامَ الْأَبَدَ ، فَإِنْ كَانَ لَا بُدَّ فَصُمْ صَوْمَ رَسُولِ اللهِ  دَاوُدَ  ؛ كَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا ، وَلَا يَفِرُّ إِذَا لَاقَى  .","","Al-Mu'jam al-Kabir 14328","","عبد الله بن عمرو بن العاص عن عطاء بن أبي رباح عن حجاج بن أرطاة عن أبو معاوية الضرير عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14367","[13/466]      14329  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  عِيسَى بْنُ يُونُسَ ،  قَالَ  الْأَوْزَاعِيُّ الْأَزْدِيُّ :  ثَنَا  عَبْدُ اللهِ بْنُ عَمْرٍو أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا صَامَ مَنْ صَامَ الْأَبَدَ  .","","Al-Mu'jam al-Kabir 14329","","عبد الله بن عمرو بن العاص عن الأوزاعي الأزدي عن عيسى بن يونس بن أبي إسحاق عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14368","14330  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُؤَمَّلِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  قُلْتُ :  يَا رَسُولَ اللهِ ، أُقَيِّدُ الْعِلْمَ ؟ قَالَ : "" نَعَمْ "" ، قُلْتُ : وَمَا تَقْيِيدُهُ ؟ قَالَ : "" الْكِتَابُ  .","","Al-Mu'jam al-Kabir 14330","","عبد الله بن عمرو بن العاص عن عطاء بن أبي رباح عن ابن جريج عن عبد الله بن المؤمل العائذي عن سعيد بن سليمان سعدويه عن محمد بن أحمد بن النضر النضري عن الطبراني","سفيان بن عوف عن عبد الله"
"14369","[13/467]      14331  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ الْعَسْقَلَانِيُّ ،  ثَنَا  شُعَيْبُ بْنُ إِسْحَاقَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  رَفَعَهُ  ، قَالَ :  مَا مِنْ دَابَّةٍ طَائِرٍ وَلَا غَيْرِهِ يُقْتَلُ بِغَيْرِ حَقٍّ إِلَّا سَيُخَاصِمُهُ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 14331","","عبد الله بن عمرو بن العاص عن عطاء بن أبي رباح عن ابن جريج عن شعيب بن إسحاق الدمشقي عن محمد بن المتوكل بن ابى السرى عن عبد الله بن وهيب الجذامي عن الطبراني","سفيان بن عوف عن عبد الله"
"14370","14332  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَبَنَا  عُمَرُ بْنُ حَوْشَبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ دِينَارٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَيْسَ مِنَّا مَنْ تَشَبَّهَ بِالرِّجَالِ مِنَ النِّسَاءِ  ، وَلَا مَنْ تَشَبَّهَ بِالنِّسَاءِ مِنَ الرِّجَالِ  .","","Al-Mu'jam al-Kabir 14332","","عبد الله بن عمرو بن العاص عن عطاء بن أبي رباح عن عمرو بن دينار الأثرم عن عمر بن حوشب الصنعاني عن عبد الرزاق الصنعاني عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14371","[13/468]      14333  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  حَدَّثَنِي  أَبِي ، قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي بِخَطِّهِ  :  حَدَّثَنَا  ابْنُ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَاتَلَ دُونَ مَالِهِ فَقُتِلَ فَهُوَ  شَهِيدٌ  .","","Al-Mu'jam al-Kabir 14333","","عبد الله بن عمرو بن العاص عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن أبي شيبة العبسي عن عثمان ابن أبي شيبة عن محمد بن عثمان بن أبي شيبة عن الطبراني","سفيان بن عوف عن عبد الله"
"14372","14334  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  عَبْدُ اللهِ بْنُ عِصْمَةَ النَّصِيبِيُّ ،  ثَنَا  حَمْزَةُ بْنُ أَبِي حَمْزَةَ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَيُّمَا امْرَأَةٍ نُكِحَتْ بِغَيْرِ إِذْنِ وَلِيِّهَا فَنِكَاحُهَا بَاطِلٌ ،  وَإِنْ كَانَ دَخَلَ بِهَا فَلَهَا صَدَاقُهَا بِمَا اسْتَحَلَّ مِنْ فَرْجِهَا ، وَيُفَرَّقُ بَيْنَهُمَا ، وَإِنْ كَانَ لَمْ يَدْخُلْ بِهَا فُرِّقَ بَيْنَهُمَا ، وَالسُّلْطَانُ وَلِيُّ مَنْ لَا وَلِيَّ لَهُ  .","","Al-Mu'jam al-Kabir 14334","","عبد الله بن عمرو بن العاص عن عطاء بن أبي رباح عن حمزة بن أبي حمزة النصيبي عن عبد الله بن عصمة النصيبي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14373","[13/469]      14335  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَزِيعٍ ،  ثَنَا  أَبُو بَحْرٍ الْبَكْرَاوِيُّ ،  ثَنَا  مَرْزُوقٌ أَبُو بَكْرٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ أَحَبَّ الصَّلَاةِ إِلَى اللهِ صَلَاةُ  دَاوُدَ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ؛ كَانَ يُصَلِّي  شَطْرَ  اللَّيْلِ وَيَنَامُ  شَطْرَهُ  الْبَاقِيَ ، فَيُصَلِّي ثُلُثَيْهِ وَيَنَامُ ثُلُثَهُ  .","","Al-Mu'jam al-Kabir 14335","","عبد الله بن عمرو بن العاص عن عبيد بن عمير بن قتادة الجندعي عن عمرو بن دينار الأثرم عن مرزوق مولى طلحة بن عبد الرحمن الباهلي عن أبو بحر البكراوي عن محمد بن عبد الله بن بزيع البصري عن عبد الله بن أحمد الجواليقي عن الطبراني","سفيان بن عوف عن عبد الله"
"14374","14336  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :         [13/470]      يَأْخُذُ الْجَبَّارُ سَمَاوَاتِهِ وَأَرْضَهُ بِيَدِهِ وَيَقْبِضُ يَدَهُ  ، وَجَعَلَ يَقْبِضُهَا وَيَبْسُطُهَا ، ثُمَّ يَقُولُ : أَنَا الْجَبَّارُ أَنَا الْمَلِكُ ، أَيْنَ الْجَبَّارُونَ ؟! أَيْنَ الْمُتَكَبِّرُونَ ؟! "" قَالَ : فَيَمِيلُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ يَمِينِهِ وَعَنْ شِمَالِهِ ، حَتَّى نَظَرْتُ إِلَى الْمِنْبَرِ يَتَحَرَّكُ مِنْ أَسْفَلِ شَيْءٍ مِنْهُ ، حَتَّى إِنِّي لَأَقُولُ : أَسَاقِطٌ هُوَ بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ؟!  هَكَذَا رَوَاهُ  يَحْيَى بْنُ بُكَيْرٍ  ، عَنِ  ابْنِ أَبِي حَازِمٍ  ، فَقَالَ : عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  ، وَرَوَاهُ غَيْرُهُ عَنْهُ فَقَالَ : عَنِ  ابْنِ عُمَرَ  .","","Al-Mu'jam al-Kabir 14336","","عبد الله بن عمرو بن العاص عن عبيد بن عمير بن قتادة الجندعي عن سلمة بن دينار الأعرج عن عبد العزيز بن أبي حازم المخزومي عن يحيى بن عبد الله بن بكير المخزومي عن يحيى بن أيوب العلاف عن الطبراني","سفيان بن عوف عن عبد الله"
"14375","14337  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  حَدَّثَنِي  ابْنُ أَبِي لَيْلَى ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي مُلَيْكَةَ ،  عَنْ         [13/471]      عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  أَفَاضَ  جِبْرِيلُ  بِإِبْرَاهِيمَ  عَلَيْهِمَا السَّلَامُ إِلَى  مِنًى  ،  فَصَلَّى بِهِ الظُّهْرَ وَالْعَصْرَ وَالْمَغْرِبَ وَالْعِشَاءَ وَالصُّبْحَ  بِمِنًى  ، ثُمَّ         [13/472]      غَدَا مِنْ  مِنًى  إِلَى  عَرَفَاتٍ  ، فَصَلَّى بِهِ الصَّلَاتَيْنِ ، ثُمَّ وَقَفَ حَتَّى غَابَتِ الشَّمْسُ ، ثُمَّ أَتَى بِهِ إِلَى  الْمُزْدَلِفَةِ  فَنَزَلَ بِهَا فَبَاتَ بِهَا ، ثُمَّ قَامَ فَصَلَّى كَأَعْجَلِ مَا يُصَلِّي أَحَدٌ مِنَ الْمُسْلِمِينَ ، ثُمَّ أَتَى بِهِ كَأَبْطَأِ مَا يُصَلِّي بِهِ أَحَدٌ مِنَ الْمُسْلِمِينَ ، ثُمَّ دَفَعَ بِهِ إِلَى  مِنًى  فَرَمَى وَذَبَحَ وَحَلَقَ ، ثُمَّ أَوْحَى اللهُ إِلَى  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         {      أَنِ اتَّبِعْ مِلَّةَ إِبْرَاهِيمَ حَنِيفًا وَمَا كَانَ مِنَ الْمُشْرِكِينَ         }      .","","Al-Mu'jam al-Kabir 14337","","عبد الله بن عمرو بن العاص عن ابن أبي مليكة عن محمد بن عبد الرحمن بن أبي ليلى عن سفيان الثوري عن محمد بن كثير العبدي عن محمد بن محمد بن حيان التمار عن الطبراني","سفيان بن عوف عن عبد الله"
"14376","14338  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَبَنَا  أَيُّوبُ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ  أَنَّ  أَعْرَابِيًّا أَتَى عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ ، فَقَالَ : إِنِّي مُضْعِفٌ مِنَ  الْحَمُولَةِ  . وَمَعَهُ جَمَرَاتٌ ، فَأُفِيضُ مَنْ  جَمْعٍ  قَبْلَ أَنْ يَفِيضَ الْإِمَامُ ؟ فَقَالَ :  إِنَّ  إِبْرَاهِيمَ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى الظُّهْرَ وَالْعَصْرَ وَالْمَغْرِبَ وَالْعِشَاءَ وَالْفَجْرَ  بِمِنًى  ، فَلَمَّا أَصْبَحَ ذَهَبَ إِلَى  عَرَفَةَ  فَوَقَفَ ، ثُمَّ  أَفَاضَ  مِنْ  عَرَفَةَ  فَبَاتَ  بِجَمْعٍ  ، فَلَمَّا         [13/473]      كَانَتِ الصَّلَاةُ الْمُعَجَّلَةُ صَلَّى الْفَجْرَ ثُمَّ وَقَفَ ، فَلَمَّا كَانَتِ الصَّلَاةُ الْمُسْفِرَةُ  أَفَاضَ  ، وَقَدْ أُمِرَ نَبِيُّكُمْ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَتَّبِعَ مِلَّةَ أَبِيكُمْ  إِبْرَاهِيمَ  .","","Al-Mu'jam al-Kabir 14338","","عبد الله بن عمرو بن العاص عن ابن أبي مليكة عن أيوب السختياني عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14377","14339  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ .  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ قَالَا :  حَدَّثَنَا  يَزِيدُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  عَبْدُ اللهِ بْنُ أَبِي مُلَيْكَةَ قَالَ :  أَتَى رَجُلٌ عَبْدَ اللهِ بْنَ عَمْرٍو فَقَالَ : إِنِّي مُضْعِفٌ مِنَ  الْحَمُولَةِ  مُضْعِفٌ مِنَ الْأَهْلِ ، أَفَتَرَى أَنْ أَتَعَجَّلَ ؟ فَقَالَ لَهُ  عَبْدُ اللهِ بْنُ عَمْرٍو  :  قَدِمَ  إِبْرَاهِيمُ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَطَافَ  بِالْبَيْتِ  ، وَطَافَ بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  ، ثُمَّ  رَاحَ  فَصَلَّى الظُّهْرَ  بِمِنًى  ، حَتَّى إِذَا كَانَ مِنَ الْغَدِ عِنْدَ حَاجِبِ الشَّمْسِ غَدَا إِلَى الْمَنْزِلِ مِنْ  عَرَفَةَ  ، ثُمَّ رَاحَ فَوَقَفَ  بِعَرَفَةَ  حَتَّى غَرَبَتِ الشَّمْسُ ، ثُمَّ  أَفَاضَ  فَصَلَّى  بِجَمْعٍ  وَبَاتَ بِهَا ، حَتَّى إِذَا كَانَ مِنَ الْغَدِ صَلَّى صَلَاةَ الْمُعَجَّلَةِ ، ثُمَّ وَقَفَ إِلَى الصَّلَاةِ الْمُصْبِحَةِ ، وَأَوْحَى اللهُ إِلَى نَبِيِّكُمْ أَنْ يَتَّبِعَ مِلَّةَ  إِبْرَاهِيمَ  حَنِيفًا وَمَا كَانَ مِنَ الْمُشْرِكِينَ  .","","Al-Mu'jam al-Kabir 14339","","عبد الله بن عمرو بن العاص عن ابن أبي مليكة عن يزيد بن إبراهيم التستري عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سفيان بن عوف عن عبد الله"
"14378","[13/474]      14340  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ عِمْرَانَ بْنِ أَبِي لَيْلَى ،  حَدَّثَنِي  أَبِي ،  عَنِ  ابْنِ أَبِي لَيْلَى  ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ قَالَ لَهُ : "" جَمَعْتَ الْقُرْآنَ ؟ "" فَقُلْتُ : نَعَمْ ، فَقَالَ : "" اقْرَأْهُ فِي كُلِّ شَهْرٍ  ، قُلْتُ : إِنِّي أَجِدُ نَشَاطًا ، قَالَ : "" فَفِي عِشْرِينَ "" ، قُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي أَجِدُ قُوَّةً ! فَلَمْ أَزَلْ حَتَّى قَالَ : "" اقْرَأْهُ فِي سَبْعٍ "" ، فَتَمَنَّيْتُ أَنِّي قَبِلْتُ الَّذِي قَالَ : "" اقْرَأْهُ فِي شَهْرٍ  .","","Al-Mu'jam al-Kabir 14340","","عبد الله بن عمرو بن العاص عن ابن أبي مليكة عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن عثمان بن أبي شيبة عن الطبراني","سفيان بن عوف عن عبد الله"
"14379","14341  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ،  ثَنَا  سُرَيْجُ بْنُ النُّعْمَانِ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُؤَمَّلِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّهُ لَبِسَ خَاتَمًا مَنْ ذَهَبَ ، فَنَظَرَ إِلَيْهِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكَأَنَّهُ كَرِهَهُ فَلَبِسَ إِلَيْهِ خَاتَمًا مِنْ حَدِيدٍ ، فَنَظَرَ إِلَيْهِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  هَذَا أَخْبَثُ وَأَخْبَثُ "" ، فَطَرَحَهُ ، فَلَبِسَ خَاتَمًا مِنْ  وَرِقٍ  فَسَكَتَ  .","","Al-Mu'jam al-Kabir 14341","","عبد الله بن عمرو بن العاص عن ابن أبي مليكة عن عبد الله بن المؤمل العائذي عن سريج بن النعمان الجوهري عن لحية الليف محمد بن العباس عن الطبراني","سفيان بن عوف عن عبد الله"
"14380","[13/475]      14342  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ وَعَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ .  وَحَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْعَلَاءُ بْنُ عَبْدِ الْجَبَّارِ الْعَطَّارُ ، قَالَا :  ثَنَا  نَافِعُ بْنُ عُمَرَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ عَمْرٍو : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  حَوْضِي  مَسِيرَةُ  شَهْرٍ ، وَزَوَايَاهُ سَوَاءٌ  ، وَمَاؤُهُ أَبْيَضُ مِنَ الْوَرِقِ ، وَرِيحُهُ أَطْيَبُ مِنَ الْمِسْكِ ، وَكِيزَانُهُ كَنُجُومِ السَّمَاءِ ، مَنْ شَرِبَ مِنْهُ لَا يَظْمَأُ أَبَدًا  .","","Al-Mu'jam al-Kabir 14342","","عبد الله بن عمرو بن العاص عن ابن أبي مليكة عن نافع بن عمر بن عبد الله بن جميل الجمحي عن العلاء بن عبد الجبار الأنصاري عن بشر بن موسى بن صالح الأسدي عن الطبراني","سفيان بن عوف عن عبد الله"
"14381","[13/476]      14343  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  إِسْحَاقُ بْنُ عُبَيْدِ اللهِ الْمُقْرِئُ .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  إِسْحَاقُ بْنُ عُبَيْدِ اللهِ الْمَدَنِيُّ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ أَبِي مُلَيْكَةَ يَقُولُ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ لِلصَّائِمِ عِنْدَ فِطْرِهِ لَدَعْوَةً مَا تُرَدُّ  .","","Al-Mu'jam al-Kabir 14343","","عبد الله بن عمرو بن العاص عن ابن أبي مليكة عن إسحاق بن عبيد الله بن أبي مليكة القرشي عن الوليد بن مسلم القرشي عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14382","14344  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدِ بْنِ حَرْبٍ الْعَبَّادَانِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ .         [13/477]      وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  قَالَ  صُهَيْبٌ الْحَذَّاءُ :  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَتَلَ عُصْفُورًا بِغَيْرِ حَقِّهِ سَأَلَهُ اللهُ عَنْهُ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 14344","","عبد الله بن عمرو بن العاص عن صهيب مولى عبد الله بن عامر عن عمرو بن دينار الأثرم عن حماد بن سلمة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سفيان بن عوف عن عبد الله"
"14383","14345  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  صُهَيْبٍ مَوْلَى ابْنِ عَبَّاسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ ذَبَحَ عُصْفُورًا أَوْ قَتَلَهُ فِي غَيْرِ شَيْءٍ  - قَالَ  عَمْرٌو  :  وَأَحْسَبُهُ قَالَ : إِلَّا بِحَقِّهِ  - سَأَلَهُ اللهُ عَنْهُ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 14345","","عبد الله بن عمرو بن العاص عن صهيب البكري عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سفيان بن عوف عن عبد الله"
"14384","[13/478]      14346  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  سُلَيْمَانُ الْأَحْوَلُ أَنَّ ثَابِتًا مَوْلَى عُمَرَ بْنِ عَبْدِ الرَّحْمَنِ ،  أَخْبَرَهُ  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ قُتِلَ عَلَى مَالِهِ فَهُوَ  شَهِيدٌ  .","","Al-Mu'jam al-Kabir 14346","","عبد الله بن عمرو بن العاص عن ثابت بن عياض الأعرج عن سليمان بن أبي مسلم الأحول عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14385","14347  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،         [13/479]      عَنْ  سَعِيدِ بْنِ أَبِي أَيُّوبَ ،  حَدَّثَنِي  أَبُو الْأَسْوَدِ ،  عَنْ  عِكْرِمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ قُتِلَ دُونَ مَالِهِ مَظْلُومًا فَلَهُ الْجَنَّةُ  .","","Al-Mu'jam al-Kabir 14347","","عبد الله بن عمرو بن العاص عن عكرمة مولى ابن عباس عن محمد بن عبد الرحمن بن نوفل عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","سفيان بن عوف عن عبد الله"
"14386","14348  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  أُمَيَّةُ بْنُ بِسْطَامٍ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  رَوْحُ بْنُ الْقَاسِمِ ،  عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ ،  عَنْ  بُجَيْرِ بْنِ أَبِي بُجَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :         [13/480]      مَنِ اتَّخَذَ كَلْبًا لَيْسَ كَلْبَ قَنْصٍ وَلَا كَلْبَ مَاشِيَةٍ  نَقَصَ مِنْ أَجْرِهُ كُلَّ يَوْمٍ قِيرَاطٌ  ،  ثُمَّ ذَكَرَ أَنَّهُمْ كَانُوا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ ، فَمَرُّوا عَلَى قَبْرِ  أَبِي رِغَالٍ  فَقَالُوا : مَا هَذَا يَا رَسُولَ اللهِ ؟ قَالَ :  هَذَا قَبْرُ  أَبِي رِغَالٍ  ، وَهُوَ أَبُو  ثَقِيفَ  ، وَكَانَ امْرَأً مِنْ ثَمُودَ ، وَكَانَ مَنْزِلُهُ  بِالْحَرَمِ  ، فَلَمَّا أَهْلَكَ اللهُ قَوْمَهُ بِمَا أَهْلَكَهُمْ مَنَعَهُ لِمَكَانِهِ مِنَ  الْحَرَمِ  ، وَإِنَّهُ خَرَجَ حَتَّى إِذَا بَلَغَ هَاهُنَا مَاتَ فَدُفِنَ وَدُفِنَ مَعَهُ غُصْنٌ مِنْ ذَهَبٍ "" ، فَابْتَدَرْنَاهُ فَاسْتَخْرَجْنَاهُ  .","","Al-Mu'jam al-Kabir 14348","","عبد الله بن عمرو بن العاص عن بجير بن أبي بجير الطائفي عن إسماعيل بن أمية الأموي عن روح بن القاسم العنبري عن يزيد بن زريع العيشي عن أمية بن بسطام عن إبراهيم بن هاشم البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14387","14349  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  ثَنَا  أَبِي  ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ إِسْحَاقَ         [13/481]      يُحَدِّثُ عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ ،  عَنْ  بُجَيْرِ بْنِ أَبِي بُجَيْرٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ :  حِينَ خَرَجْنَا إِلَى  الطَّائِفِ  فَمَرَرْنَا بِقَبْرٍ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَذَا قَبْرُ  أَبِي رِغَالٍ  ، وَهُوَ أَبُو  ثَقِيفَ  ،  وَكَانَ مِنْ ثَمُودَ ، وَكَانَ بِهَذَا  الْحَرَمِ  فَدُفِعَ عَنْهُ ، فَلَمَّا خَرَجَ مِنْهُ أَصَابَتْهُ النِّقْمَةُ الَّتِي أَصَابَتْ قَوْمَهُ بِهَذَا الْمَكَانِ فَدُفِنَ فِيهِ ، وَآيَةُ ذَلِكَ أَنَّهُ دُفِنَ مَعَهُ غُصْنٌ مِنْ ذَهَبٍ إِنْ أَنْتُمْ نَبَشْتُمْ عَنْهُ أَصَبْتُمُوهُ "" ، فَابْتَدَرَهُ النَّاسُ فَاسْتَخْرَجُوا مِنْهُ الْغُصْنَ  .","","Al-Mu'jam al-Kabir 14349","","عبد الله بن عمرو بن العاص عن بجير بن أبي بجير الطائفي عن إسماعيل بن أمية الأموي عن محمد بن إسحاق عن جرير بن حازم عن وهب بن جرير بن حازم عن يحيى بن معين عن محمد بن عثمان بن أبي شيبة عن الطبراني","سفيان بن عوف عن عبد الله"
"14388","14350  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ قَالَ :  سَمِعْتُ  ابْنَ أَبِي مُلَيْكَةَ  يُحَدِّثُ عَنْ  يَحْيَى بْنِ حَكِيمِ         [13/482]      بْنِ صَفْوَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ، قَالَ :  جَمَعْتُ الْقُرْآنَ فَقَرَأْتُهُ فِي لَيْلَةٍ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنِّي أَخْشَى أَنْ يَطُولَ عَلَيْكَ الزَّمَانُ وَأَنْ تَمَلَّ ، اقْرَأْ بِهِ فِي شَهْرٍ  ، قُلْتُ : أَيْ رَسُولَ اللهِ ، دَعْنِي أَسْتَمْتِعْ مِنْ قُوَّتِي وَمِنْ شَبَابِي ! قَالَ : "" اقْرَأْ بِهِ فِي عِشْرِينَ "" ، قُلْتُ : أَيْ رَسُولَ اللهِ ، دَعْنِي أَسْتَمْتِعْ مِنْ قُوَّتِي وَمِنْ شَبَابِي ! قَالَ : "" اقْرَأْ بِهِ فِي عَشْرٍ "" ، قُلْتُ : أَيْ رَسُولَ اللهِ ، دَعْنِي أَسْتَمْتِعْ مِنْ قُوَّتِي وَمِنْ شَبَابِي ! قَالَ : "" اقْرَأْ بِهِ فِي سَبْعٍ "" ، قُلْتُ : أَيْ رَسُولَ اللهِ ، دَعْنِي أَسْتَمْتِعْ مِنْ قُوَّتِي وَمِنْ شَبَابِي ! فَأَبَى  .","","Al-Mu'jam al-Kabir 14350","","عبد الله بن عمرو بن العاص عن يحيى بن حكيم بن صفوان الجمحي عن ابن أبي مليكة عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14389","14351  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  سَيْفُ بْنُ هَارُونَ ،  عَنِ  الْحَسَنِ بْنِ عَمْرٍو ،  حَدَّثَنِي  أَبُو الزُّبَيْرِ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا رَأَيْتَ أُمَّتِي تَهَابُ الظَّالِمَ أَنْ تَقُولَ إِنَّكَ ظَالِمٌ فَقَدْ  تُوُدِّعَ  مِنْهُمْ  .","","Al-Mu'jam al-Kabir 14351","","عبد الله بن عمرو بن العاص عن أبو الزبير المكي عن الحسن بن عمرو الفقيمي عن سيف بن هارون البرجمي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","سفيان بن عوف عن عبد الله"
"14390","[13/483]      14352  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُحَمَّدُ بْنُ عَمَّارٍ الْمَوْصِلِيُّ ،  ثَنَا  الْقَاسِمُ بْنُ يَزِيدَ الْجَرْمِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ يَزِيدَ الْمَكِّيُّ  ،  عَنْ  سُلَيْمَانَ الْأَحْوَلِ ،  عَنْ  طَاوُسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  رَأَى         [13/484]      رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَيَّ ثَوْبَيْنِ مُعَصْفَرَيْنِ ، فَقَالَ :  أُمُّكَ أَمَرَتْكَ بِهَا ؟ "" قَالَ : قُلْتُ : أَغْسِلُهُمَا ؟ قَالَ : "" بَلْ  أَحْرِقْهُمَا  .  كذا في طبعة الجريسي ، ولعل الصواب : (إبراهيم بن نافع) وينظر مصادر التخريج ، والله أعلم .","","Al-Mu'jam al-Kabir 14352","","عبد الله بن عمرو بن العاص عن طاوس بن كيسان عن سليمان بن أبي مسلم الأحول عن إبراهيم بن نافع المخزومي عن القاسم بن يزيد الجرمي عن محمد بن عبد الله بن عمار الغامدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14391","14353  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ خَالِدِ بْنِ عَبْدِ اللهِ الْوَاسِطِيُّ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يُوشِكُ  أَنْ تَظْهَرَ فِيكُمْ شَيَاطِينُ كَانَ  سُلَيْمَانُ بْنُ دَاوُدَ  أَوْثَقَهَا فِي الْبَحْرِ  ، يُصَلُّونَ مَعَكُمْ فِي مَسَاجِدِكُمْ ، وَيَقْرَؤُونَ مَعَكُمُ الْقُرْآنَ ، وَيُجَادِلُونَكُمْ فِي الدِّينِ ، وَإِنَّهُمْ لَشَيَاطِينُ فِي صُوَرِ الْإِنْسِ  .","","Al-Mu'jam al-Kabir 14353","","عبد الله بن عمرو بن العاص عن طاوس بن كيسان عن ليث بن أبي سليم عن خالد بن عبد الله الطحان عن محمد بن خالد بن عبد الله الواسطي عن الحسين بن إسحاق التستري عن الطبراني","سفيان بن عوف عن عبد الله"
"14392","[13/485]      14354  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ وَعَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنْ  زِيَادِ بْنِ سِيمِينْكُوشَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  تَكُونُ فِتْنَةٌ  تَسْتَنْظِفُ  الْعَرَبَ ، قَتْلَاهَا فِي النَّارِ  ، اللِّسَانُ فِيهَا أَشَدُّ وَقْعًا مِنَ السَّيْفِ  .","","Al-Mu'jam al-Kabir 14354","","عبد الله بن عمرو بن العاص عن سيمينكوش ، زياد بن سليم عن طاوس بن كيسان عن ليث بن أبي سليم عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14393","14355  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَبَنَا  مَعْمَرٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ         [13/486]      عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَطَّلِعُ عَلَيْكُمْ رَجُلٌ مِنْ هَذَا  الْفَجِّ  مِنْ أَهْلِ النَّارِ  ، وَكُنْتُ تَرَكْتُ أَبِي يَتَوَضَّأُ ، فَخَشِيتُ أَنْ يَكُونَ هُوَ ، فَاطَّلَعَ  رَجُلٌ  غَيْرُهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" هُوَ هَذَا  .","","Al-Mu'jam al-Kabir 14355","","عبد الله بن عمرو بن العاص عن طاوس بن كيسان عن عبد الله بن طاووس عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14394","14356  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَبَنَا  عَبْدُ الرَّزَّاقِ ،  أَبَنَا  مَعْمَرٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  قَالَ :  سَمِعْتُ  رَجُلًا يُحَدِّثُ  ابْنَ عَبَّاسٍ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيَطْلُعُ عَلَيْكُمْ  رَجُلٌ  يُبْعَثُ يَوْمَ الْقِيَامَةِ عَلَى  غَيْرِ سُنَّتِي "" ، أَوْ : "" غَيْرِ مِلَّتِي  ، وَكُنْتُ تَرَكْتُ أَبِي فِي الْمَنْزِلِ ، فَخِفْتُ أَنْ يَكُونَ هُوَ ، فَطَلَعَ غَيْرُهُ ، فَقَالَ : "" هُوَ هَذَا  .","","Al-Mu'jam al-Kabir 14356","","عبد الله بن عمرو بن العاص عن رجل عن طاوس بن كيسان عن عبد الله بن طاووس عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14395","14357  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَبَنَا  مَعْمَرٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ         [13/487]      عَمْرٍو ، قَالَ :  رَأَى عَلَيَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَوْبَيْنِ مُعَصْفَرَيْنِ ، فَقَالَ :  إِنَّهُمَا مِنْ ثِيَابِ أَهْلِ النَّارِ ، فَلَا تَلْبَسْهُمَا  .","","Al-Mu'jam al-Kabir 14357","","عبد الله بن عمرو بن العاص عن طاوس بن كيسان عن عبد الله بن طاووس عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","سفيان بن عوف عن عبد الله"
"14396","14358  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  أَبَنَا  عَبْدُ الرَّزَّاقِ ،  أَبَنَا  مَعْمَرٌ ،  عَنْ  سِمَاكِ بْنِ الْفَضْلِ ،  عَنْ  وَهْبِ بْنِ مُنَبِّهٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو أَنَّهُ  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : فِي كَمْ يُقْرَأُ الْقُرْآنُ ؟ قَالَ : "" فِي أَرْبَعِينَ  ، قَالَ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : "" فِي شَهْرٍ "" ، قَالَ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : "" فِي خَمْسَ عَشْرَةَ "" ، ثُمَّ قَالَ : "" فِي عَشْرٍ "" ، ثُمَّ قَالَ : "" فِي سَبْعٍ "" ، ثُمَّ لَمْ يَنْزِلْ مِنْ سَبْعٍ  .","","Al-Mu'jam al-Kabir 14358","","عبد الله بن عمرو بن العاص عن وهب بن منبه عن سماك بن الفضل الخولاني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان بن عوف عن عبد الله"
"14397","14359  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ وَعَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَبَنَا  نَافِعُ بْنُ عُمَرَ .         [13/488]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ،  ثَنَا  سُرَيْجُ بْنُ النُّعْمَانِ ،  ثَنَا  نَافِعُ بْنُ عُمَرَ ،  حَدَّثَنِي  بِشْرُ بْنُ عَاصِمٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ يُبْغِضُ الْبَلِيغَ مِنَ الرِّجَالِ الَّذِي  يَتَخَلَّلُ  بِلِسَانِهِ تَخَلُّلَ الْبَاقِرَةِ بِلِسَانِهَا  .","","Al-Mu'jam al-Kabir 14359","","عبد الله بن عمرو بن العاص عن عاصم بن سفيان الثقفي عن بشر بن عاصم بن سفيان الطائفي عن نافع بن عمر بن عبد الله بن جميل الجمحي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","سفيان بن عوف عن عبد الله"
"14398","[13/489]      14360  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَفَّانُ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  ثَنَا  يَعْلَى بْنُ عَطَاءٍ ،  عَنْ  نَافِعِ بْنِ عَاصِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ  شَرِبَ  الْخَمْرَ لَمْ تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ لَيْلَةً  ، فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ ، فَإِنْ شَرِبَهَا لَمْ تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ لَيْلَةً ، فَإِنْ شَرِبَهَا كَانَ حَقًّا عَلَى اللهِ أَنْ يَسْقِيَهُ مِنْ طِينَةِ  الْخَبَالِ  "" ، قَالَ : وَمَا طِينَةُ  الْخَبَالِ  ؟ قَالَ : ""  صَدِيدُ  أَهْلِ النَّارِ  .","","Al-Mu'jam al-Kabir 14360","","عبد الله بن عمرو بن العاص عن نافع بن عاصم بن عروة بن مسعود الثقفي عن يعلى بن عطاء الطائفي عن حماد بن سلمة عن عفان بن مسلم الصفار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان بن عوف عن عبد الله"
"14399","14361  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  نَافِعِ بْنِ عَاصِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  نَزَلَتْ هَذِهِ الْآيَةُ فِي  أُمَيَّةَ بْنِ أَبِي الصَّلْتِ  :         {      الَّذِي آتَيْنَاهُ آيَاتِنَا فَانْسَلَخَ مِنْهَا         }      ....","","Al-Mu'jam al-Kabir 14361","","عبد الله بن عمرو بن العاص عن نافع بن عاصم بن عروة بن مسعود الثقفي عن يعلى بن عطاء الطائفي عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن الفضل بن الحباب الجمحي عن الطبراني","سفيان بن عوف عن عبد الله"
"14400","[13/490]      14362  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ ،  ثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ ،  ثَنَا  أَبِي  ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عُرْوَةَ بْنِ عِيَاضٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَدْخُلُ الْجَنَّةَ مَنْ كَانَ فِي قَلْبِهِ  مِثْقَالُ  حَبَّةٍ  مِنْ خَرْدَلٍ مِنْ  كِبْرٍ  .","","Al-Mu'jam al-Kabir 14362","","عبد الله بن عمرو بن العاص عن عروة بن عياض النوفلي عن عبد العزيز بن جريج المكي عن ابن جريج عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن محمد بن يحيى بن مندة عن الطبراني","سفيان بن عوف عن عبد الله"
