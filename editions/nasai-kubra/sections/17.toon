hadiths[165]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"2641","أَنْبَأَ أَحْمَدُ بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا زَيْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنِي ثَابِتُ بْنُ قَيْسٍ الْغِفَارِيُّ ، قَالَ : حَدَّثَنِي أَبُو سَعِيدٍ الْمَقْبُرِيُّ ، قَالَ : حَدَّثَنِي أَبُو هُرَيْرَةَ ، عَنْ أُسَامَةَ بْنِ زَيْدٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  كَانَيَسْرُدُ الصَّوْمَ "" ، فَيُقَالُ : لا يُفْطِرُ ، وَيُفْطِرُ فَيُقَالُ : لا يَصُومُ""","Sahih|Sahih|Isnaad Sahih","Sunan al-Kubra al-Nasai 2641","","أَخْبَرَنَا عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ عَبْدِ اللهِ بْنِ يُونُسَ قَالَ حَدَّثَنَا عَبْثَرٌ قَالَ حَدَّثَنَا حُصَيْنٌ عَنِ الشَّعْبِيِّ عَنْ مُحَمَّدِ بْنِ صَيْفِيٍّ قَالَ","The Book of Fasting"
"2642","أَنْبَأَ عَمْرُو بْنُ عُثْمَانَ ، عَنْ بَقِيَّةَ قَالَ : حَدَّثَنَا بَحِيرٌ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنْ جُبَيْرِ بْنِ نُفَيْرٍ ، أَنَّ عَائِشَةَ قَالَتْ : إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  كَانَيَتَحَرَّى صِيَامَ الاثْنَيْنِ وَالْخَمِيسِ """"""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 2642","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ حَدَّثَنَا يَحْيَى عَنْ يَزِيدَ قَالَ حَدَّثَنَا سَلَمَةُ","The Book of Fasting"
"2643","أَنْبَأَ عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا عَبْدُ اللَّهِ بْنُ دَاوُدَ ، قَالَ : حَدَّثَنَا ثَوْرٌ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنْ رَبِيعَةَ الْجُرَشِيِّ ، عَنْ عَائِشَةَ ، قَالَتْ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَتَحَرَّى يَوْمَ الاثْنَيْنِ وَالْخَمِيسِ """"""","Hasan|Hasan|Isnaad Hasan","Sunan al-Kubra al-Nasai 2643","","أَخْبَرَنَا عَمْرُو بْنُ مَنْصُورٍ قَالَ حَدَّثَنَا عَاصِمُ بْنُ يُوسُفَ قَالَ حَدَّثَنَا أَبُو الْأَحْوَصِ عَنْ طَلْحَةَ بْنِ يَحْيَى عَنْ مُجَاهِدٍ عَنْ عَائِشَةَ قَالَتْ","The Book of Fasting"
"2644","أَنْبَأَ إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أَنْبَأَ ُعبَيْدُ بْنُ سَعِيدٍ الأُمَوِيُّ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ ثَوْرٍ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنْ عَائِشَةَ ، قَالَتْ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَتَحَرَّى الإِثْنَيْنِ وَالْخَمِيسَ """"""","","Sunan al-Kubra al-Nasai 2644","","أَخْبَرَنَا أَبُو دَاوُدَ قَالَ حَدَّثَنَا يَزِيدُ قَالَ أَخْبَرَنَا شَرِيكٌ عَنْ طَلْحَةَ بْنِ يَحْيَى بْنِ طَلْحَةَ عَنْ مُجَاهِدٍ عَنْ عَائِشَةَ قَالَتْ","The Book of Fasting"
"2645","أَنْبَأَ أَحْمَدُ بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ سُفْيَانَ ، عَنْ مَنْصُورٍ ، عَنْ خَالِدِ بْنِ سَعِيدٍ ، عَنْ عَائِشَةَ ، قَالَتْ : كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَتَحَرَّى الاثْنَيْنِ وَالْخَمِيسَ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : هَذَا حَدِيثٌ مُنْكَرٌ ، مَا يُشْبِهُ حَدِيثَ مَنْصُورٍ ، يُشْبِهُ أَنْ يَكُونَ أَتَى مِنْ أَبِي دَاوُدَ""","Hasan Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 2645","","أَخْبَرَنِي عَبْدُ اللهِ بْنُ الْهَيْثَمِ قَالَ حَدَّثَنَا أَبُو بَكْرٍ الْحَنَفِيُّ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ طَلْحَةَ بْنِ يَحْيَى عَنْ مُجَاهِدٍ عَنْ عَائِشَةَ قَالَتْ","The Book of Fasting"
"2646","أَنْبَأَ إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ حَبِيبِ بْنِ الشَّهِيدِ ، قالَ : حَدَّثَنَا يَحْيَى بْنُ يَمَانٍ ، عَنْ سُفْيَانَ ، عَنْ عَاصِمٍ ، عَنِ الْمُسَيَّبِ بْنِ رَافِعٍ ، عَنْ سَوَاءٍ الْخُزَاعِيِّ ، عَنْ عَائِشَةَ ، قَالَتْ : كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَصُومُ الاثْنَيْنِ وَالْخَمِيسَ """"""","","Sunan al-Kubra al-Nasai 2646","","حَدَّثَنَا أَحْمَدُ بْنُ حَرْبٍ قَالَ حَدَّثَنَا قَاسِمٌ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ طَلْحَةَ بْنِ يَحْيَى عَنْ عَائِشَةَ بِنْتِ طَلْحَةَ عَنْ عَائِشَةَ أُمِّ الْمُؤْمِنِينَ قَالَتْ","The Book of Fasting"
"2647","أَخْبَرَنِي أَبُو بَكْرِ بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنِي أَبُو نَصْرٍ التَّمَّارُ ، قَالَ : حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ ، عَنْ عَاصِمٍ ، عَنْ سَوَاءٍ ، عَنْ أُمِّ سَلَمَةَ ، قَالَتْ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَصُومُ مِنْ كُلِّ شَهْرٍ ثَلاثَةَ أَيَّامٍ : الاثْنَيْنِ وَالْخَمِيسَ مِنْ هَذِهِ الْجُمُعَةِ ، وَالاثْنَيْنِ مِنَ الْمُقْبِلَةِ """"""","","Sunan al-Kubra al-Nasai 2647","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا يَحْيَى قَالَ حَدَّثَنَا طَلْحَةُ بْنُ يَحْيَى قَالَ حَدَّثَتْنِي عَائِشَةُ بِنْتُ طَلْحَةَ عَنْ عَائِشَةَ أُمِّ الْمُؤْمِنِينَ","The Book of Fasting"
"2648","أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى ، قَالَ : حَدَّثَنَا إسْحَاقُ ، قَالَ : حَدَّثَنَا النَّضْرُ ، قَالَ : حَدَّثَنَا حَمَّادٌ ، عَنْ عَاصِمِ بْنِ أَبِي النَّجُودِ ، عَنْ سَوَاءٍ ، عَنْ حَفْصَةَ ، قَالَتْ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَصُومُ ثَلاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ : يَوْمَ الْخَمِيسِ ، وَيَوْمَ الاثْنَيْنِ مِنَ الْجُمُعَةِ الأُولَى ، وَمِنَ الْجُمُعَةِ الثَّانِيَةِ يَوْمَ الاثْنَيْنِ """"""","","Sunan al-Kubra al-Nasai 2648","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا وَكِيعٌ قَالَ حَدَّثَنَا طَلْحَةُ بْنُ يَحْيَى عَنْ عَمَّتِهِ عَائِشَةَ بِنْتِ طَلْحَةَ عَنْ عَائِشَةَ أُمِّ الْمُؤْمِنِينَ قَالَتْ","The Book of Fasting"
"2649","أَنْبَأَ الْقَاسِمُ بْنُ زَكَرِيَّا ، قَالَ : حَدَّثَنَا حسَيْنٌ ، عَنْ زَائِدَةَ ، عَنْ عَاصِمٍ ، عَنِ الْمُسَيَّبِ ، عَنْ حَفْصَةَ ، قَالَتْ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا أَخَذَ مَضْجَعَهُ جَعَلَ كَفَّهُ الْيُمْنَى تَحْتَ خَدِّهِ الأَيْمَنِ ، وَكَانَ يَصُومُ الاثْنَيْنِ وَالْخَمِيسَ """"""","","Sunan al-Kubra al-Nasai 2649","","أَخْبَرَنِي أَبُو بَكْرِ بْنُ عَلِيٍّ قَالَ حَدَّثَنَا نَصْرُ بْنُ عَلِيٍّ قَالَ أَخْبَرَنَي أَبِي عَنِ الْقَاسِمِ بْنِ مَعْنٍ قَالَ حَدَّثَنَا طَلْحَةُ بْنُ يَحْيَى عَنْ عَائِشَةَ بِنْتِ طَلْحَةَ وَمُجَاهِدٍ عَنْ عَائِشَةَ","The Book of Fasting"
"2650","أَنْبَأَ مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحَسَنِ بْنِ شَقِيقٍ ، قَالَ : أبِي أخبرنا ، قَالَ : أَنْبَأَ أَبُو حَمْزَةَ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ ، قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَصُومُ ثَلاثَةَ أَيَّامٍ مِنْ غُرَّةِ كُلِّ شَهْرٍ ، وَقَلَّ مَا يُفْطِرُ يَوْمَ الْجُمُعَةِ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : أَبُو حَمْزَةَ هَذَا اسْمُهُ : مُحَمَّدُ بْنُ مَيْمُونٍ ، مَرْوَزِيٌّ لا بَأْسَ بِهِ ، إِلا أَنَّهُ كَانَ ذَهَبَ بَصَرُهُ فِي آخِرِ عُمْرِهِ ، فَمَنْ كَتَبَ عَنْهُ قَبْلَ ذَلِكَ فَحَدِيثُهُ جَيِّدٌ ، وَأَبُو حَمْزَةَ صَاحِبُ إِبْرَاهِيمَ النَّخَعِيَّ اسْمُهُ : مَيْمُونٌ الأَعْوَرُ ، وَلَيْسَ بِثِقَةٍ ، وَأَبُو حَمْزَةَ ثَابِتُ بْنُ أَبِي صَفِيَّةَ كُوفِيٌّ ، وَلَيْسَ بِثِقَةٍ ، وَأَبُو حَمْزَةَ عِمْرَانُ بْنُ أَبِي عَطَاءٍ ، يَرْوِي عَنِ ابْنِ عَبَّاسٍ ، رَوَى عَنْهُ شُعْبَةُ ، وَسُفْيَانُ ، وَأَبُو عَوَانَةَ ، وَلَيْسَ بِالْقَوِيِّ ، وَأَبُو حَمْزَةَ طَلْحَةُ بْنُ يَزِيدَ : كُوفِيٌّ ثِقَةٌ ، وَأَبُو حَمْزَةَ مُحَمَّدُ بْنُ كَعْبٍ الْقُرَظِيُّ مَدَنِيٌّ ثِقَةٌ ، وَأَبُو حَمْزَةَ سَعْدٌ ، عَنْ عُبَيْدٍ كُوفِيٌّ ثِقَةٌ ، وَأَبُو حَمْزَةَ أَنَسُ بْنُ سِيرِينَ ثِقَةٌ ، وَهُمْ أَرْبَعَةٌ إِخْوَةٌ : مُحَمَّدُ بْنُ سِيرِينَ ، وَيَحْيَى بْنُ سِيرِينَ ، وَمَعْبَدُ بْنُ سِيرِينَ ، وَأَنَسُ بْنُ سِيرِينَ ، وَحَفْصَةُ بِنْتُ سِيرِينَ ، وَكَرِيمَةُ بِنْتُ سِيرِينَ ، وَهُمْ مَوَالِي أَنَسِ بْنِ مَالِكٍ الأَنْصَارِيِّ""","","Sunan al-Kubra al-Nasai 2650","","","The Book of Fasting"
"2651","أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى ، قَالَ : حَدَّثَنَا أَبُو كَامِلٍ ، قَالَ : حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ عَاصِمِ بْنِ بَهْدَلَةَ ، عَنْ رَجُلٍ ، عَنِ الأَسْوَدِ بْنِ هِلالٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : أَمَرَنِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِرَكْعَتَيِ الضُّحَى ، وَلا أَنَامُ إِلا عَلَى وِتْرٍ ، وَصِيَامِ ثَلاثَةِ أَيَّامٍ مِنَ الشَّهْرِ """"""","Sahih Lighairihi|Sahih|Sahih","Sunan al-Kubra al-Nasai 2651","","أَخْبَرَنِي صَفْوَانُ بْنُ عَمْرٍو قَالَ حَدَّثَنَا أَحْمَدُ بْنُ خَالِدٍ قَالَ حَدَّثَنَا إِسْرَائِيلُ عَنْ سِمَاكِ بْنِ حَرْبٍ قَالَ حَدَّثَنِي رَجُلٌ عَنْ عَائِشَةَ بِنْتِ طَلْحَةَ عَنْ عَائِشَةَ أُمِّ الْمُؤْمِنِينَ قَالَتْ","The Book of Fasting"
"2652","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ عُبَيْدِ اللَّهِ ، سَمِعَ ابْنَ عَبَّاسٍ ، يُسْأَلُ عَنْصِيَامِ يَوْمِ عَاشُورَاءَ ، قَالَ :  مَا عَلِمْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَامَ يَوْمًا يَتَحَرَّى فَضْلَهُ عَلَى الأَيَّامِ إِلا هَذَا الْيَوْمَ، يَعْنِي عَاشُورَاءَ""","Sahih|Sahih|Daif","Sunan al-Kubra al-Nasai 2652","","أَخْبَرَنَا الْقَاسِمُ بْنُ زَكَرِيَّا بْنِ دِينَارٍ قَالَ حَدَّثَنَا سَعِيدُ بْنُ شُرَحْبِيلَ قَالَ أَخْبَرَنَا اللَّيْثُ عَنْ يَحْيَى بْنِ أَيُّوبَ عَنْ عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ عَنْ سَالِمِ بْنِ عَبْدِ اللهِ عَنْ عَبْدِ اللهِ بْنِ عُمَرَ عَنْ حَفْصَةَ","The Book of Fasting"
"2653","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنِ الزُّهْرِيِّ ، عَنْ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، قَالَ : سَمِعْتُ مُعَاوِيَةَيَوْمَ عَاشُورَاءَ وَهُوَ عَلَى الْمِنْبَرِ ، يَقُولُ : يَا أَهْلَ الْمَدِينَةِ ، أَيْنَ عُلَمَاؤُكُمْ ، يَا أَهْلَ الْمَدِينَةِ ، سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ فِي هَذَا الْيَوْمِ :  إِنِّي صَائِمٌ ، فَمَنْ شَاءَ أَنْ يَصُومَ فَلْيَصُمْ """"""","Sahih|Sahih|Daif","Sunan al-Kubra al-Nasai 2653","","أَخْبَرَنَا عَبْدُ الْمَلِكِ بْنُ شُعَيْبِ بْنِ اللَّيْثِ بْنِ سَعْدٍ قَالَ حَدَّثَنِي أَبِي عَنْ جَدِّي قَالَ حَدَّثَنِي يَحْيَى بْنُ أَيُّوبَ عَنْ عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ عَنِ ابْنِ شِهَابٍ عَنْ سَالِمٍ عَنْ عَبْدِ اللهِ عَنْ حَفْصَةَ","The Book of Fasting"
"2654","أَنْبَأَ زَكَرِيَّا بْنُ يَحْيَى ، قَالَ : أَنْبَأَ شَيْبَانُ ، قَالَ : حَدَّثَنَا أَبُو عَوَانَةَ ، عَنِ الْحُرِّ بْنِ الصَّيَّاحِ ، عَنْ هُنَيْدَةَ بْنِ خَالِدٍ ، عَنِ امْرَأَتِهِ ، قَالَتْ : حَدَّثَتْنِي بَعْضُ نِسَاءِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَصُومُ يَوْمَ عَاشُورَاءَ وَتِسْعًا مِنْ ذِي الْحِجَّةِ ، وَثَلاثَةَ أَيَّامٍ مِنَ الشَّهْرِ : أَوَّلَ الاثْنَيْنِ مِنَ الشَّهْرِ ، وَخَمِيسَيْنِ """"""","","Sunan al-Kubra al-Nasai 2654","","أَخْبَرَنِي مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الْحَكَمِ عَنْ أَشْهَبَ قَالَ أَخْبَرَنِي يَحْيَى بْنُ أَيُّوبَ وَذَكَرَ آخَرُ أَنَّ عَبْدَ اللهِ بْنَ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ حَدَّثَهُمَا عَنِ ابْنِ شِهَابٍ عَنْ سَالِمِ بْنِ عَبْدِ اللهِ عَنْ أَبِيهِ عَنْ حَفْصَةَ","The Book of Fasting"
"2655","أَنْبَأَ عَلِيُّ بْنُ حُجْرٍ ، قَالَ : أَنْبَأَ إسْمَاعِيلُ ، عَنِ الْجُرَيْرِيِّ ، عَنْ يَزِيدَ بْنِ عَبْدِ اللَّهِ بْنِ الشِّخِّيرِ ، عَنْ أَخِيهِ مُطَرِّفٍ ، عَنْ عِمْرَانَ ، قَالَ : قِيلَ : يَا رَسُولَ اللَّهِ ، إِنَّ فُلانًالا يُفْطِرُ نَهَارًا الدَّهْرَ ، فَقَالَ :  لا صَامَ ، وَلا أَفْطَرَ """"""","Sahih|Sahih|Daif","Sunan al-Kubra al-Nasai 2655","","أَخْبَرَنَا أَحْمَدُ بْنُ الْأَزْهَرِ قَالَ حَدَّثَنَا عَبْدُ الرَّزَّاقِ عَنِ ابْنِ جُرَيْجٍ عَنِ ابْنِ شِهَابٍ عَنْ سَالِمٍ عَنِ ابْنِ عُمَرَ عَنْ حَفْصَةَ","The Book of Fasting"
"2656","أَخْبَرَنِي عَمْرُو بْنُ هِشَامٍ ، قَالَ : حَدَّثَنَا مَخْلَدٌ ، عَنِ الأَوْزَاعِيِّ ، عَنْ قَتَادَةَ ، عَنْ مُطَرِّفِ بْنِ عَبْدِ اللَّهِ بْنِ الشِّخِّيرِ ، قَالَ : حَدَّثَنِي أبي ، أَنَّهُ سَمِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَذُكِرَ عِنْدَهُرَجُلٌ يَصُومُ الدَّهْرَ ، فَقَالَ :  لا صَامَ ، وَلا أَفْطَرَ """"""","","Sunan al-Kubra al-Nasai 2656","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى قَالَ حَدَّثَنَا مُعْتَمِرٌ قَالَ سَمِعْتُ عُبَيْدَ اللهِ عَنِ ابْنِ شِهَابٍ عَنْ سَالِمٍ عَنْ عَبْدِ اللهِ عَنْ حَفْصَةَ","The Book of Fasting"
"2657","أَنْبَأَ مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ : حَدَّثَنَا أَبُو دَاوُدَ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ قَتَادَةَ ، قَالَ : سَمِعْتُ مُطَرِّفَ بْنَ عَبْدِ اللَّهِ بْنِ الشِّخِّيرِ يُحَدِّثُ ، عَنْ أَبِيهِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ فِيصَوْمِ الدَّهْرِ :  لا صَامَ ، وَلا أَفْطَرَ ""ذِكْرُ الاخْتِلافِ عَلَى غَيْلانَ بْنِ جَرِيرٍ فِيهِ""","Sahih Muquf|Sahih Muquf|Isnaad Sahih","Sunan al-Kubra al-Nasai 2657","","أَخْبَرَنَا الرَّبِيعُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا ابْنُ وَهْبٍ قَالَ أَخْبَرَنِي يُونُسُ عَنِ ابْنِ شِهَابٍ قَالَ أَخْبَرَنِي حَمْزَةُ بْنُ عَبْدِ اللهِ بْنِ عُمَرَ عَنْ أَبِيهِ قَالَ قَالَتْ","The Book of Fasting"
"2658","أَخْبَرَنِي هَارُونُ بْنُ عَبْدِ اللَّهِ ، قَالَ : حَدَّثَنَا الْحَسَنُ بْنُ مُوسَى ، قَالَ : حَدَّثَنَا أَبُو هِلالٍ ، قَالَ : حَدَّثَنَا غَيْلانُ هُوَ ابْنُ جَرِيرٍ ، قَالَ : حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَعْبَدٍ الزِّمَّانِيُّ ، عَنْ أَبِي قَتَادَةَ ، عَنْ عُمَرَ ، قَالَ : كُنَّا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَمَرَرْنَا بِرَجُلٍ ، فَقَالُوا : يَا نَبِيَّ اللَّهِ ، هَذَا لا يُفْطِرُ مُذْ كَذَا وكذا ، فَقَالَ : لا صَامَ وَلا أَفْطَرَ ، أَوْ مَا صَامَ وَمَا أَفْطَرَ """"""","Sahih Muquf|Sahih Muquf|Hasan","Sunan al-Kubra al-Nasai 2658","","أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى قَالَ حَدَّثَنَا الْحَسَنُ بْنُ عِيسَى وَهُوَ ابْنُ مَاسَرْجِسَ قَالَ أَخْبَرَنَا ابْنُ الْمُبَارَكِ قَالَ أَخْبَرَنَا مَعْمَرٌ عَنِ الزُّهْرِيِّ عَنْ حَمْزَةَ بْنِ عَبْدِ اللهِ عَنْ عَبْدِ اللهِ بْنِ عُمَرَ عَنْ حَفْصَةَ قَالَتْ","The Book of Fasting"
"2659","أَنْبَأَ مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ غَيْلانَ بْنِ جَرِيرٍ ، سَمِعَ عَبْدَ اللَّهِ بْنَ مَعْبَدٍ الزِّمَّانِيَّ ، عَنْ أَبِي قَتَادَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سُئِلَ عَنْ صَوْمِهِ فَغَضِبَ ، فَقَالَ عُمَرُ : رَضِينَا بِاللَّهِ رَبًّا ، وَبِالإِسْلامِ دِينًا ، وَبِمُحَمَّدٍ رَسُولا ، وَسُئِلَ عَمَّنْصَامَ الدَّهْرَ ، فَقَالَ :  لا صَامَ وَلا أَفْطَرَ ، أَوْ مَا صَامَ وَمَا أَفْطَرَ ""ذِكْرُ الاخْتِلافِ عَلَى عَطَاءِ بْنِ أَبِي رَبَاحٍ فِيهِ""","Sahih Muquf|Sahih Muquf|Hasan","Sunan al-Kubra al-Nasai 2659","","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمٍ قَالَ أَخْبَرَنَا حِبَّانُ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ سُفْيَانَ بْنِ عُيَيْنَةَ وَمَعْمَرٌ عَنِ الزُّهْرِيِّ عَنْ حَمْزَةَ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ عَنْ أَبِيهِ عَنْ حَفْصَةَ قَالَتْ","The Book of Fasting"
"2660","أَخْبَرَنِي حَاجِبُ بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا الْحَارِثُ بْنُ عَطِيَّةَ ، قَالَ : حَدَّثَنَا الأَوْزَاعِيُّ ، عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ صَامَ الأَبَدَ فَلا صَامَ """"""","","Sunan al-Kubra al-Nasai 2660","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا سُفْيَانُ عَنِ الزُّهْرِيِّ عَنْ حَمْزَةَ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ","The Book of Fasting"
"2661","أَنْبَأَ عِيسَى بْنُ مُسَاوِرٍ ، عَنِ الْوَلِيدِ ، قَالَ : حَدَّثَنَا الأَوْزَاعِيُّ ، قَالَ : حَدَّثَنِي عَطَاءٌ ، عَنْ عَبْدِ اللَّهِ . وأنبا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ ، قَالَ : حَدَّثَنَا الْوَلِيدُ ، عَنِ الأَوْزَاعِيِّ ، قَالَ : حَدَّثَنَا عَطَاءٌ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ صَامَ الأَبَدَ فَلا صَامَ وَلا أَفْطَرَ """"""","","Sunan al-Kubra al-Nasai 2661","","أَخْبَرَنَا أَحْمَدُ بْنُ حَرْبٍ المَوْصليُّ قَالَ حَدَّثَنَا سُفْيَانُ عَنِ الزُّهْرِيِّ عَنْ حَمْزَةَ بْنِ عَبْدِ اللهِ عَنْ حَفْصَةَ قَالَتْ «§لَا صِيَامَ لِمَنْ لَمْ يُجْمِعِ الصِّيامَ قَبْلَ الْفَجْرِ» قَالَ","The Book of Fasting"
"2662","أَنْبَأَ الْعَبَّاسُ بْنُ الْوَلِيدِ بْنِ مَزْيَدٍ الْبَيْرُوتِيُّ ، قالَ : أَخْبَرَنِي أَبِي ، وَعُقْبَةُ ، عَنِ الأَوْزَاعِيِّ ، قَالَ : حَدَّثَنِي عَطَاءُ بْنُ أَبِي رَبَاحٍ ، قَالَ : حَدَّثَنِي مَنْ ، سَمِعَ عَبْدَ اللَّهِ بْنَ عُمَرٍ ، يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ صَامَ الأَبَدَ فَلا صَامَ """"""","Sahih Muquf|Sahih Muquf|Isnaad Sahih","Sunan al-Kubra al-Nasai 2662","","الْحَارِثُ بْنُ مِسْكِينٍ قِرَاءَةً عَلَيْهِ عَنِ ابْنِ الْقَاسِمِ قَالَ حَدَّثَنِي مَالِكٌ عَنِ ابْنِ شِهَابٍ","The Book of Fasting"
"2663","أَخْبَرَنِي إِسْمَاعِيلُ بْنُ يَعْقُوبَ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ مُوسَى ، قَالَ : حَدَّثَنَا أَبِي ، عَنِ الأَوْزَاعِيِّ ، عَنْ عَطَاءٍ ، عَمَّنْ ، سَمِعَ عَبْدَ اللَّهِ بْنَ عُمَرٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ صَامَ الأَبَدَ فَلا صَامَ """"""","Sahih Muquf|Sahih Muquf|Isnaad Sahih","Sunan al-Kubra al-Nasai 2663","","قَالَ الْحَارِثُ بْنُ مِسْكِينٍ قِرَاءَةً عَلَيْهِ عَنِ ابْنِ الْقَاسِمِ قَالَ حَدَّثَنِي مَالِكٌ عَنْ نَافِعٍ عَنِ ابْنِ عُمَرَ","The Book of Fasting"
"2664","قَالَ أَبُو عَبْدِ الرَّحْمَنِ : قَرَأْتُ عَلَى أَحْمَدَ ْبنِ إِبْرَاهِيمَ ، أَنَّ ابْنَ عَائِذٍ حَدَّثَهُمْ وَهُوَ مُحَمَّدٌ دِمَشْقِيٌّ ، قَالَ : حَدَّثَنَا يَحْيَى وَهُوَ ابْنُ حَمْزَةَ ، عَنِ الأَوْزَاعِيِّ ، عَنْ عَطَاءٍ أَنَّهُ حَدَّثَهُ ، قَالَ : حَدَّثَنِي مَنْ ، سَمِعَ عَبْدَ اللَّهِ بْنَ عَمْرٍو ، يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ صَامَ الأَبَدَ فَلا صَامَ وَلا أَفْطَرَ """"""","Sahih Muquf|Sahih Muquf|Isnaad Sahih","Sunan al-Kubra al-Nasai 2664","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى قَالَ حَدَّثَنَا الْمُعْتَمِرُ قَالَ سَمِعْتُ عُبَيْدَ اللهِ عَنْ نَافِعٍ عَنْ عَبْدِ اللهِ قَالَ","The Book of Fasting"
"2665","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ الْحَسَنِ ، قَالَ : حَدَّثَنَا حجَّاجُ بْنُ مُحَمَّدٍ ، قَالَ : قَالَ ابْنُ جُرَيْجٍ : سَمِعْتُ عَطَاءَ ، أنَّ أَبا الْعَبَّاسِ الشَّاعِرَ أَخْبَرَهُ ، أَنَّهُ سَمِعَ عَبْدَ اللَّهِ بْنَ عَمْرِو بْنِ الْعَاصِ ، قَالَ : بَلَغَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنِّي أَصُومُ أَسْرُدُ ، وَسَاقَ الْحَدِيثَ ،  قَالَ : قَالَ عَطَاءٌ : وَلا أَدْرِي كَيْفَ ذَكَرَ صِيَامَ الأَبَدِ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا صَامَ مَنْ صَامَ الأَبَدَ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : أَبُو الْعَبَّاسِ الشَّاعِرُ اسْمُهُ السَّائِبُ بْنُ فَرُّوخَ ثِقَةٌ ، وَابْنُهُ الْعَلاءُ بْنُ أَبِي الْعَبَّاسِ يَرْوِي عَنْهُ الْحَدِيثَ""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 2665","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ عَمْرِو بْنِ دِينَارٍ عَنْ عَمْرِو بْنِ أَوْسٍ أَنَّهُ سَمِعَ عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ يَقُولُ","The Book of Fasting"
"2666","أَخْبَرَنِي يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ ، قَالَ : حدَّثَنَا حَمَّادٌ ، عَنْ هِشَامٍ ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ ، أَنَّ حَمْزَةَ بْنَ عَمْرٍو الأَسْلَمِيَّ سَأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : يَا رَسُولَ اللَّهِ ، إِنِّي رَجُلٌ أَسْرُدُ الصَّوْمَ ، أَفَأَصُومُ فِي السَّفَرِ ، قَالَ : صُمْ إِنْ شِئْتَ ، وَأَفْطِرْ إِنْ شِئْتَ """"""","Daif Isnaad|Daif Isnaad|Isnaad Hasan","Sunan al-Kubra al-Nasai 2666","","أَخْبَرَنَا الْقَاسِمُ بْنُ زَكَرِيَّا قَالَ حَدَّثَنَا عُبَيْدُ اللهِ وَهُوَ ابْنُ مُوسَى قَالَ حَدَّثَنَا يَعْقُوبُ عَنْ جَعْفَرٍ عَنْ سَعِيدٍ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Fasting"
"2667","أَنْبَأَ مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي عَمَّارٍ ، عَنْ عَمْرِو بْنِ شُرَحْبِيلَ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : قِيلَ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :رَجُلٌ يَصُومُ الدَّهْرَ ، قَالَ :  وَدِدْتُ أَنَّهُ لَمْ يَطْعَمِ الدَّهْرَ "" ، قَالُوا : فَثُلُثَيْهِ ؟ قَالَ : "" أَكْثَرَ "" ، قَالُوا : فَنِصْفُهُ ؟ قَالَ : "" أَكْثَرَ "" ، ثُمَّ قَالَ : "" أَلا أُخْبِرُكُمْ بِمَا يُذْهِبُ وَحَرَ الصَّدْرِ ؟ صَوْمُ ثَلاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ """"""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 2667","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنَا مُحَمَّدٌ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ أَبِي بِشْرٍ عَنْ سَعِيدِ بْنِ جُبَيْرٍ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Fasting"
"2668","أَنْبَأَ مُحَمَّدُ بْنُ الْعَلاءِ ، قَالَ : حَدَّثَنَا أَبُو ُمعَاوِيَةَ ، قَالَ : حَدَّثَنَا الأَعْمَشُ ، عَنْ أَبِي عَمَّارٍ ، عَنْ عَمْرِو بْنِ شُرَحْبِيلَ ، قَالَ : أَتَى رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَجُلٌ ، فَقَالَ : يَا رَسُولَ اللَّهِ ، مَا تَقُولُ فِي رَجُلٍ صَامَ الدَّهْرَ ؟ فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  وَدِدْتُ أَنَّهُ لَمْ يَطْعَمِ الدَّهْرَ شَيْئًا "" ، قَالَ : فَثُلُثَيْهِ ؟ قَالَ : "" أَكْثَرَ "" ، قَالَ : فَنِصْفَهُ ، قَالَ : "" أَكْثَرَ ، أَلا أُخْبِرُكُمْ بِمَا يُذْهِبُ وَحَرَ الصُّدُورِ ؟ "" ، قَالُوا : بَلَى ، قَالَ :"" صَوْمُ ثَلاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ """"""","Sahih Isnaad|Sahih Isnaad|Isnaad Hasan","Sunan al-Kubra al-Nasai 2668","","أَخْبَرَنَا مُحَمَّدُ بْنُ النَّضْرِ بْنِ مُسَاوِرٍ الَمرْوَزِيُّ قَالَ حَدَّثَنَا حَمَّادٌ عَنْ مَرْوَانَ أَبِي لُبَابَةَ عَنْ عَائِشَةَ قَالَتْ","The Book of Fasting"
"2669","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا حَمَّادٌ ، عَنْ غَيْلانَ بْنِ جَرِيرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ مَعْبَدٍ ، عَنْ أَبِي قَتَادَةَ ، قَالَ : قَالَ عُمَرُ : يَا رَسُولَ اللَّهِ ، كَيْفَ بِمَنْيَصُومُ الدَّهْرَ كُلَّهُ ؟ قَالَ :  لا صَامَ وَلا أَفْطَرَ ، أَوْ لَمْ يَصُمْ وَلَمْ يُفْطِرْ "" ، قَالَ : يَا رَسُولَ اللَّهِ ، كَيْفَ بِمَنْ يَصُومُ يَوْمَيْنِ وَيُفْطِرُ يَوْمًا ؟ قَالَ : "" وَيُطِيقُ ذَلِكَ أَحَدٌ ؟ "" قَالَ : وَكَيْفَ بِمَنْ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا ؟ قَالَ : "" ذَاكَ صَوْمُ دَاوُدَ "" ، قَالَ : فَكَيْفَ بِمَنْ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمَيْنِ ؟ قَالَ : "" وَدِدْتُ أَنِّي أُطِيقُ ذَاكَ "" ، قَالَ : ثُمَّ قَالَ : "" ثَلاثٌ مِنْ كُلِّ شَهْرٍ ، وَرَمَضَانُ إِلَى رَمَضَانَ هَذَا صِيَامُ الدَّهْرِ كُلَّهُ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 2669","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ عَنْ خَالِدٍ قَالَ حَدَّثَنَا سَعِيدٌ قَالَ حَدَّثَنَا قَتَادَةُ عَنْ زُرَارَةَ بْنِ أَوْفَى عَنْ سَعْدِ بْنِ هِشَامٍ عَنْ عَائِشَةَ قَالَتْ","The Book of Fasting"
"2670","قَالَ : وَفِيمَا قَرَأَ عَلَيْنَا أَحْمَدُ بْنُ مَنِيعٍ ، قَالَ : حَدَّثَنَا هُشَيْمٌ ، قَالَ : أَنْبَأَ حُصَيْنٌ ، وَمُغِيرَةُ ، عَنْ مُجَاهِدٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَفْضَلُ الصِّيَامِ صِيَامُ دَاوُدَ ، كَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا """"""","Sahih|Sahih|Sahih Muslim","Sunan al-Kubra al-Nasai 2670","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا حَمَّادٌ عَنْ أَيُّوبَ عَنْ عَبْدِ اللهِ بْنِ شَقِيقٍ قَالَ سَأَلْتُ عَائِشَةَ","The Book of Fasting"
"2671","أَنْبَأَ مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ : حَدَّثَنَا يَحْيَى بْنُ حَمَّادٍ ، قَالَ : حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ مُغِيرَةَ ، عَنْ مُجَاهِدٍ ، قَالَ : قَالَ لِي عَبْدُ اللَّهِ بْنُ عَمْرِو بْنِ الْعَاصِ : أَنْكَحَنِي أَبِي امْرَأَةً ذَاتَ حَسَبٍ ، فَكَانَ يَأْتِيهَا فَيَسْأَلُهَا عَنْ بَعْلِهَا ، فَقَالَتْ : نِعْمَ الرَّجُلُ مِنْ رَجُلٍ ، لَمْ يَطَأْ لَنَا فِرَاشًا ، وَلَمْ يُفَتِّشْ لَنَا كَنَفًا مُنْذُ أَتَيْنَاهُ ، فَذَكَرَ ذَلِكَ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  الْقَنِي بِهِ "" ، فَأَتَيْتُهُ مَعَهُ ، فَقَالَ : "" كَيْفَ تَصُومُ ؟ "" قُلْتُ : كُلَّ يَوْمٍ ، قَالَ : "" صُمْ مِنْ كُلِّ جُمُعَةٍ ثَلاثَةَ أَيَّامٍ "" ، قُلْتُ : إِنِّي أُطِيقُ أَفْضَلَ مِنْ ذَلِكَ ، قَالَ : "" صُمْ يَوْمَيْنِ وَأَفْطِرْ يَوْمًا "" ، قَالَ : إِنِّي أُطِيقُ أَفْضَلَ مِنْ ذَلِكَ ، قَالَ : ""صُمْ أَفْضَلَ الصِّيَامِ صِيَامَ دَاوُدَ عَلَيْهِ السَّلامُ ، صَوْمُ يَوْمٍ وَفِطْرُ يَوْمٍ """"""","Sahih|Sahih|Isnaad Sahih","Sunan al-Kubra al-Nasai 2671","","أَخْبَرَنَا الرَّبِيعُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا ابْنُ وَهْبٍ قَالَ حَدَّثَنَا مُعَاوِيَةُ بْنُ صَالِحٍ أَنَّ عَبْدَ اللهِ بْنَ أَبِي قَيْسٍ حَدَّثَهُ","The Book of Fasting"
"2672","أَنْبَأَ عَبْدُ اللَّهِ بْنُ أَحْمَدَ بْنِ عَبْدِ اللَّهِ بْنِ يُونُسَ ، قَالَ : حَدَّثَنَا عَبْثَرٌ ، قَالَ : حَدَّثَنَا حُصَيْنٌ ، عَنْ مُجَاهِدٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، قَالَ : زَوَّجَنِي أَبِي امْرَأَةً فَجَاءَ يَزُورُهَا ، فَقَالَ : كَيْفَ تَرَيْنَ بَعْلَكِ ؟ فَقَالَتْ : نِعْمَ الرَّجُلُ مِنْ رَجُلٍ لا يَنَامُ اللَّيْلَ وَلا يُفْطِرُ النَّهَارَ ، فَوَقَعَ بِي يَنَامُ اللَّيْلَ ، وَقَالَ : زَوَّجْتُكَ امْرَأَةً مِنَ الْمُسْلِمِينَ فَعَضَلْتَهَا ، قَالَ : فَجَعَلْتُ لا أَلْتَفِتُ إِلَى قَوْلِهِ مِمَّا أَرَى عِنْدِي مِنَ الْقُوَّةِ وَالاجْتِهَادِ ، فَبَلَغَ ذَلِكَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  لَكِنِّي أَنَا أَقُومُ وَأَنَامُ ، وَأَصُومُ وَأُفْطِرُ ، فَقُمْ وَنَمْ ، وَصُمْ وَأَفْطِرْ "" ، قَالَ : "" صُمْ مِنْ كُلِّ شَهْرٍ ثَلاثَةَ أَيَّامٍ "" ، فَقُلْتُ : أَنَا أَقْوَى مِنْ ذَلِكَ ، قَالَ : ""صُمْ صَوْمَ دَاوُدَ عَلَيْهِ السَّلامُ ، صُمْ يَوْمًا وَأَفْطِرْ يَوْمًا "" ، قُلْتُ : أَنَا أَقْوَى مِنْ ذَلِكَ ، قَالَ : "" اقْرَأِ الْقُرْآنَ فِي كُلِّ شَهْرٍ "" ، ثُمَّ انْتَهَى إِلَى خَمْسَ عَشْرَةَ وَأَنَا أَقُولُ : أَنَا أَقْوَى مِنْ ذَلِكَ""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 2672","","أَخْبَرَنَا الرَّبِيعُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا ابْنُ وَهْبٍ قَالَ حَدَّثَنِي مَالِكٌ وَعَمْرُو بْنُ الْحَارِثِ وَذَكَرَ آخَرَ قَبْلَهُمَا أَنَّ أَبَا النَّضْرِ حَدَّثَهُمْ عَنْ أَبِي سَلَمَةَ عَنْ عَائِشَةَ قَالَتْ","The Book of Fasting"
"2673","أَنْبَأَ يَحْيَى بْنُ دُرُسْتَ ، قَالَ : أَنْبَأَ أَبُو إِسْمَاعِيلَ ، قَالَ : حَدَّثَنَا يَحْيَى بْنُ أَبِي كَثِيرٍ ، أَنَّ أَبَا سَلَمَةَ حَدَّثَهُ ، أَنَّ عَبْدَ اللَّهِ قَالَ : دَخَلَ عليَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حُجْرَتِي ، فَقَالَ :  أَلَمْ أُخْبَرْ أَنَّكَ تَقُومُ اللَّيْلَ ، وَتَصُومُ النَّهَارَ ؟ "" قَالَ : بَلَى ، قَالَ : "" فَلا تَفْعَلَنَّ ،نَمْ وَقُمْ ، وَصُمْ وَأَفْطِرْ ، فَإِنَّ لِعَيْنِكَ عَلَيْكَ حَقًّا ، وَإِنَّ لِجَسَدِكَ عَلَيْكَ حَقًّا ، وَإِنَّ لِزَوْجَتِكَ عَلَيْكَ حَقًّا ، وَإِنَّ لِضَيْفِكَ عَلَيْكَ حَقًّا ، وَإِنَّ لِصَدِيقِكَ عَلَيْكَ حَقًّا ، وَإِنَّهُ عَسَى أَنْ يَطُولَ بِكَ عُمُرٌ ، وَإِنَّهُ حَسْبُكَ أَنْ تَصُومَ مِنْ كُلِّ شَهْرٍ ثَلاثًا ، فَذَلِكَ صِيَامُ الدَّهْرِ كُلِّهِ ، وَالْحَسَنَةُ بِعَشْرِ أَمْثَالِهَا "" ، قُلْتُ : إِنِّي أَجِدُ قُوَّةً ، فَشَدَّدْتُ فَشُدِّدَ عَلَيَّ ، قَالَ : "" صُمْ مِنْ كُلِّ جُمُعَةٍ ثَلاثَةَ أَيَّامٍ "" ، قُلْتُ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، فَشَدَّدْتُ فَشُدِّدَ عَلَيَّ ، قَالَ : "" صُمْ صَوْمَ نَبِيِّ اللَّهِ دَاوُدَ عَلَيْهِ السَّلامُ "" ، قُلْتُ : وَمَا كَانَ صَوْمُ دَاوُدَ ؟ قَالَ : "" نِصْفُ الدَّهْرِ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 2673","","أَخْبَرَنَا مَحْمُودُ بْنُ غَيْلَانَ قَالَ حَدَّثَنَا أَبُو دَاوُدَ قَالَ أَخْبَرَنَا شُعْبَةُ عَنْ مَنْصُورٍ قَالَ سَمِعْتُ سَالِمَ بْنَ أَبِي الْجَعْدِ عَنْ أَبِي سَلَمَةَ عَنْ أُمِّ سَلَمَةَ","The Book of Fasting"
"2674","أَنْبَأَ الرَّبِيعُ بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا ابْنُ وَهْبٍ ، قَالَ : أَخْبَرَنِي يُونُسُ ، عَنِ ابْنِ شِهَابٍ ، قَالَ : أَخْبَرَنِي سَعِيدُ بْنُ الْمُسَيِّبِ ، وَأَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ ، أَنَّ عَبْدَ اللَّهِ بْنَ عَمْرِو بْنِ الْعَاصِ قَالَ : ذُكِرَ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ يَقُولُ : لأَقُومَنَّ اللَّيْلَ وَلأَصُومَنَّ النَّهَارَ مَا عِشْتُ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَنْتَ الَّذِي تَقُولُ ذَلِكَ ؟ "" فَقُلْتُ لَهُ : قَدْ قُلْتُهُ يَا رَسُولَ اللَّهِ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" فَإِنَّكَ لا تَسْتَطِيعُ ذَلِكَ ،فَصُمْ وَأَفْطِرْ ، وَنَمْ وَقُمْ ، وَصُمْ مِنَ الشَّهْرِ ثَلاثَةَ أَيَّامٍ فَإِنَّ الْحَسَنَةَ بِعَشْرِ أَمْثَالِهَا ، وَذَلِكَ مِثْلُ صِيَامِ الدَّهْرِ "" ، قُلْتُ : فَإِنِّي أُطِيقُ أَفْضَلَ مِنْ ذَلِكَ ، قَالَ : "" صُمْ يَوْمًا وَأَفْطِرْ يَوْمَيْنِ "" ، قُلْتُ : إِنِّي أُطِيقُ أَفْضَلَ مِنْ ذَلِكَ يَا رَسُولَ اللَّهِ ، قَالَ : "" فَصُمْ يَوْمًا وَأَفْطِرْ يَوْمًا ، وَذَلِكَ صِيَامُ دَاوُدَ وَهُوَ أَعْدَلُ الصِّيَامِ "" ، قُلْتُ : فَإِنِّي أُطِيقُ أَفْضَلَ مِنْ ذَلِكَ ، قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" لا أَفْضَلَ مِنْ ذَلِكَ ""، قَالَ عَبْدُ اللَّهِ بْنُ عَمْرٍو : لأَنْ أَكُونَ قَبِلْتُ الثَّلاثَةَ الأَيَّامَ الَّتِي قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَحَبُّ إِلَيَّ مِنْ أَهْلِي وَمَالِي""","","Sunan al-Kubra al-Nasai 2674","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْوَلِيدِ البُسْرِيُّ قَالَ حَدَّثَنَا مُحَمَّدٌ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ تَوْبَةَ هُوَ الْعَنْبَرِيُّ عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ عَنْ أَبِي سَلَمَةَ عَنْ أُمِّ سَلَمَةَ","The Book of Fasting"
"2675","أَخْبَرَنِي أَحْمَدُ بْنُ بَكَّارٍ ، قَالَ : حَدَّثَنَا ُمحَمَّدٌ وَهُوَ ابْنُ سَلَمَةَ ، عَنِ ابْنِ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : دَخَلْتُ عَلَى عَبْدِ اللَّهِ بْنِ عَمْرٍو ، فَقُلْتُ : أَيْ عَمِّ ، حَدِّثْنِي عَمَّا ، قَالَ لَكَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : يَا ابْنَ أَخِي ، إِنِّي قَدْ كُنْتُ أَجْمَعْتُ عَلَى أَنْ أَجْتَهِدَ اجْتِهَادًا شَدِيدًا حَتَّى قُلْتُ : لأَصُومَنَّ الدَّهْرَ ، وَلأَقْرَأَنَّ الْقُرْآنَ فِي كُلِّ يَوْمٍ وَلَيْلَةٍ ، فَسَمِعَ بِذَلِكَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَأَتَانِي حَتَّى دَخَلَ عَلَيَّ فِي دَارِي ، فَقَالَ :  بَلَغَنِي أَنَّكَ قُلْتَ : لأَصُومَنَّ الدَّهْرَ وَلأَقْرَأَنَّ الْقُرْآنَ "" ، فَقُلْتُ : قَدْ قُلْتُ ذَلِكَ يَا رَسُولَ اللَّهِ ، قَالَ : "" فَلا تَفْعَلْ ، صُمْ مِنْ كُلِّ شَهْرٍ ثَلاثَةَ أَيَّامٍ "" ، قُلْتُ : إِنِّي أَقْوَى عَلَى أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : "" فَصُمْ مِنَ الْجُمُعَةِ يَوْمَيْنِ الاثْنَيْنِ وَالْخَمِيسَ "" ، قُلْتُ : فَإِنِّي أَقْوَى عَلَى أَكْثَرَ مِنْ ذَلِكِ ، قَالَ : ""فَصُمْ صِيَامَ دَاوُدَ عَلَيْهِ السَّلامُ فَإِنَّهُ أَعْدَلُ الصِّيَامِ عِنْدَ اللَّهِ ، يَوْمًا صَائِمًا وَيَوْمًا مُفْطِرًا ، وَإِنَّهُ كَانَ إِذَا وَعَدَ لَمْ يُخْلِفْ وَإِذَا لاقَى لَمْ يَفِرَّ """"""","Hasan Sahih|Hasan Sahih|Isnaad Hasan","Sunan al-Kubra al-Nasai 2675","","أَخْبَرَنَا عَبَيْدُ اللهِ بْنُ سَعْدِ بْنِ إِبْرَاهِيمَ بْنِ سَعْدٍ قَالَ حَدَّثَنَا عَمِّي قَالَ حَدَّثَنَا أَبِي عَنِ ابْنِ إِسْحَاقَ قَالَ حَدَّثَنِي مُحَمَّدُ بْنُ إِبْرَاهِيمَ عَنْ أَبِي سَلَمَةَ عَنْ عَائِشَةَ قَالَتْ","The Book of Fasting"
"2676","أَنْبَأَ مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ : حَدَّثَنَا مُحَمَّدٌ ، قَالَ : أَنْبَأَ شُعْبَةُ ، عَنْ زِيَادِ بْنِ فَيَّاضٍ ، قَالَ : سَمِعْتُ أَبَا عِيَاضٍ يُحَدِّثُ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  صُمْ مِنَ الشَّهْرِ يَوْمًا وَلَكَ أَجْرُ مَا بَقِيَ "" ، قَالَ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : "" صُمْ يَوْمَيْنِ وَلَكَ أَجْرُ مَا بَقِيَ "" ، قَالَ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : "" صُمْ ثَلاثَةَ أَيَّامٍ وَلَكَ أَجْرُ مَا بَقِيَ "" ، قَالَ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : "" صُمْ أَرْبَعَةَ أَيَّامٍ وَلَكَ أَجْرُ مَا بَقِيَ "" ، قَالَ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : ""صُمْ أَفْضَلَ الصِّيَامِ عِنْدَ اللَّهِ صَوْمَ دَاوُدَ عَلَيْهِ السَّلامُ ، كَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا """"""","","Sunan al-Kubra al-Nasai 2676","","أَخْبَرَنَا عَمْرُو بْنُ هِشَامٍ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ سَلَمَةَ عَنِ ابْنِ إِسْحَاقَ عَنْ يَحْيَى بْنِ سَعِيدٍ عَنْ أَبِي سَلَمَةَ عَنْ عَائِشَةَ قَالَتْ","The Book of Fasting"
"2677","أَنْبَأَ مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حَدَّثَنَا الْمُعْتَمِرُ ، عَنْ أَبِيهِ ، قَالَ : حَدَّثَنَا أَبُو الْعَلاءِ ، عَنْ مُطَرِّفٍ ، عَنِ ابْنِ أَبِي رَبِيعَةَ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرو ، قَالَ : ذَكَرْتُ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الصَّوْمَ ، فَقَالَ :  صُمْ مِنْ كُلِّ عَشَرَةِ أَيَّامٍ يَوْمًا وَلَكَ أَجْرُ تِلْكَ التِّسْعَةِ "" ، فَقُلْتُ : إِنِّي أَقْوَى مِنْ ذَلِكَ ، قَالَ : "" صُمْ مِنْ كُلِّ تِسْعَةِ أَيَّامٍ يَوْمًا وَلَكَ أَجْرُ تِلْكَ الثَّمَانِيَةِ "" ، قُلْتُ : إِنِّي أَقْوَى مَنْ ذَلِكَ ، قَالَ : "" فَصُمْ مِنْ كُلِّ ثَمَانِيَةِ أَيَّامٍ يَوْمًا وَلَكَ أَجْرُ تِلْكَ السَّبْعَةِ "" ، قُلْتُ : إِنِّي أَقْوَى مِنْ ذَلِكَ ، قَالَ : فَلَمْ يَزَلْ حَتَّى ، قَالَ : ""صُمْ يَوْمًا وَأَفْطِرْ يَوْمًا """"""","","Sunan al-Kubra al-Nasai 2677","","أَخْبَرَنَا عَمْرُو بْنُ عُثْمَانَ عَنْ بَقِيَّةَ قَالَ حَدَّثَنَا بَحِيرٌ عَنْ خَالِدِ بْنِ مَعْدَانَ عَنْ جُبَيْرِ بْنِ نُفَيْرٍ أَنَّ عَائِشَةَ قَالَتْ","The Book of Fasting"
"2678","أَخْبَرَنِي مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ ، قَالَ : حَدَّثَنَا يَزِيدُ ، قَالَ : أَنْبَأَ حَمَّادٌ . وَأَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى ، قَالَ : حَدَّثَنَا عَبْدُ الأَعْلَى ، قَالَ : ثَنَا حَمَّادٌ ، عَنْ ثَابِتٍ ، عَنْ شُعَيْبِ بْنِ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، عَنْ أَبِيهِ ، قَالَ : إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ لَهُ : صُمْ يَوْمًا وَلَكَ أَجْرُ عَشَرَةِ "" ، فَقُلْتُ : زِدْنِي ، فَقَالَ : "" صُمْ يَوْمَيْنِ وَلَكَ أَجْرُ تِسْعَةٍ "" ، قُلْتُ : زِدْنِي ، قَالَ : "" صُمْ ثَلاثَةَ أَيَّامٍ وَلَكَ أَجْرُ ثَمَانِيَةٍ ""، قَالَ ثَابِتٌ : فَأَخْبَرْتُ بِذَلِكَ مُطَرِّفَ بْنَ عَبْدِ اللَّهِ ، فَقَالَ : مَا أُرَاهُ إِلا يَزْدَادُ فِي الْعَمَلِ وَيَنْقُصُ مِنَ الأَجْرِ ، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : زَادَ بَعْضُهُمْ عَلَى بَعْضٍ""","","Sunan al-Kubra al-Nasai 2678","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ عَنْ عَبْدِ الرَّحْمَنِ قَالَ حَدَّثَنَا ثَابِتُ بْنُ قَيْسٍ أَبُو الْغُصْنِ شَيْخٌ مِنْ أَهْلِ الْمَدِينَةِ قَالَ حَدَّثَنَا أَبُو سَعِيدٍ الْمَقْبُرِيُّ قَالَ حَدَّثَنِي أُسَامَةُ بْنُ زَيْدٍ قَالَ","The Book of Fasting"
"2679","أَخْبَرَنِي مُحَمَّدُ بْنُ عُبَيْدٍ الْكُوفِيُّ ، عَنْ أَسْبَاطِ بْنِ مُحَمَّدٍ كُوفِيٍّ ، عَنْ مُطَرِّفٍ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ أَبِي الْعَبَّاسِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، قَالَ : قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِنَّهُ بَلَغَنِي أَنَّكَ تَقُومُ اللَّيْلَ وَتَصُومُ النَّهَارَ ؟ "" ، قُلْتُ : يَا رَسُولَ اللَّهِ مَا أَرَدْتُ بِذَلِكَ إِلا الْخَيْرَ ، قَالَ : "" لا صَامَ مَنْ صَامَ الأَبَدَ ، وَلَكِنْ أَدُلُّكَ عَلَى صَوْمِ الدَّهْرِ ثَلاثَةُ أَيَّامٍ مِنَ الشَّهْرِ "" ، قُلْتُ : يَا رَسُولَ اللَّهِ إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : "" فَصُمْ خَمْسَةَ أَيَّامٍ "" ، قُلْتُ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : "" فَصُمْ عَشْرًا "" ، فَقُلْتُ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : ""فصُمْ صَوْمَ دَاوُدَ ، وكَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا """"""","","Sunan al-Kubra al-Nasai 2679","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ عَنْ عَبْدِ الرَّحْمَنِ قَالَ حَدَّثَنَا ثَابِتُ بْنُ قَيْسٍ أَبُو الْغُصْنِ شَيْخٌ مِنْ أَهْلِ الْمَدِينَةِ حَدَّثَنِي أَبُو سَعِيدٍ الْمَقْبُرِيُّ قَالَ حَدَّثَنِي أُسَامَةُ بْنُ زَيْدٍ قَالَ","The Book of Fasting"
"2680","أَنْبَأَ عَلِيُّ بْنُ الْحُسَيْنِ ، قَالَ : حَدَّثَنَا أُمَيَّةُ بْنُ خَالِدٍ بَصْرِيٌّ ، عَنْ شُعْبَةَ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، قَالَ : حَدَّثَنِي أَبُو الْعَبَّاسِ وَكَانَ رجلا من أهل الشام وكان شاعرا وكان صدوقا ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، قَالَ : قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إنكتقوم الليل وتصوم النهار ، لا صام من صام الأبد ، صم من كل شهر ثلاثة أيام ، "" قلت : زدني ، قال : "" صم من كل شهر خمسة أيام "" قلت : زدني ، قال : "" أفضل الصيام صوم داود ، يصوم يوما ، ويفطر يوم ، ولا يفر إذا لاقى """"""","Hasan Sahih|Hasan Sahih|Isnaad Hasan","Sunan al-Kubra al-Nasai 2680","","أَخْبَرَنَا أَحْمَدُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا زَيْدُ بْنُ الْحُبَابِ قَالَ أَخْبَرَنِي ثَابِتُ بْنُ قَيْسٍ الْغِفَارِيُّ قَالَ حَدَّثَنِي أَبُو سَعِيدٍ الْمَقْبُرِيُّ قَالَ حَدَّثَنِي أَبُو هُرَيْرَةَ عَنْ أُسَامَةَ بْنِ زَيْدٍ","The Book of Fasting"
"2681","أَنْبَأَ مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حَدَّثَنَا خالِدٌ ، عَنْ شُعْبَةَ ، قَالَ : أَخْبَرَنِي حَبِيبُ بْنُ أَبِي ثَابِتٍ ، قَالَ : سَمِعْتُ أَبَا الْعَبَّاسِ يُحَدِّثُ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، قَالَ : قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  يَا عَبْدَ اللَّهِ بْنَ عَمْرٍو إِنَّكَ تَصُومُ الدَّهْرَ ، وَتَقُومُ اللَّيْلَ ، وَإِذَا فَعَلْتَ ذَلِكَ هَجَعَتِ الْعَيْنُ ، وَنَفِهَتْ لَهُ النَّفْسُ ، لا صَامَ مَنْ صَامَ الأَبَدَ ، صَوْمُ الدَّهْرِ ثَلاثَةُ أَيَّامٍ مِنَ الشَّهْرِ صَوْمُ الدَّهْرِ كُلِّهِ "" ، قُلْتُ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : ""صَوْمُ دَاوُدَ ، وَكَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا وَلا يَفِرُّ إِذَا لاقَى """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 2681","","أَخْبَرَنَا عَمْرُو بْنُ عُثْمَانَ عَنْ بَقِيَّةَ قَالَ حَدَّثَنَا بَحِيرٌ عَنْ خَالِدِ بْنِ مَعْدَانَ عَنْ جُبَيْرِ بْنِ نُفَيْرٍ أَنَّ عَائِشَةَ قَالَتْ","The Book of Fasting"
"2682","أَنْبَأَ مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنَا مُحَمَّدٌ َيعْنِي ابْنَ جَعْفَرٍ غُنْدَرٌ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ أَبِي الْعَبَّاسِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، قَالَ : قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  اقْرَأِ الْقُرْآنَ فِي شَهْرٍ "" ، قُلْتُ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : فَلَمْ أَزَلْ أَطْلُبُ إِلَيْهِ حَتَّى ، قَالَ : "" فِي خَمْسَةِ أَيَّامٍ "" ، وَقَالَ : "" صُمْ ثَلاثَةَ أَيَّامٍ مِنَ الشَّهْرِ "" ، قُلْتُ : أَنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، فَلَمْ أَزَلْ أَطْلُبُ إِلَيْهِ حَتَّى ، قَالَ : ""صُمْ أَحَبَّ الصِّيَامِ إِلَى اللَّهِ صَوْمَ دَاوُدَ ، كَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 2682","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا عَبْدُ اللهِ بْنُ دَاوُدَ قَالَ أَخْبَرَنَا ثَوْرٌ عَنْ خَالِدِ بْنِ مَعْدَانَ عَنْ رَبِيعَةَ الْجُرَشِيِّ عَنْ عَائِشَةَ قَالَتْ","The Book of Fasting"
"2683","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ الْحَسَنِ ، قَالَ : حَدَّثَنَا حجَّاجٌ ، قَالَ ابْنُ جُرَيْجٍ : سَمِعْتُ عَطَاءً ، أَنَّ أَبَا الْعَبَّاسِ الشَّاعِرَ أَخْبَرَهُ ، أَنَّهُ سَمِعَ عَبْدَ اللَّهِ بْنَ عَمْرِو بْنِ الْعَاصِ ، قَالَ : بَلَغَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنِّي أَصُومُ أَسْرُدُ ، وَأُصَلِّي اللَّيْلَ ، قَالَ : فَأَرْسَلَ إِلَيْهِ ، وَإِمَّا لَقِيَهُ ، قَالَ :  أَلَمْ أُخْبَرْ أَنَّكَ تَصُومُ ، لا تُفْطِرُ وَتُصَلِّي اللَّيْلَ ؟ فَلا تَفْعَلْ ، فَإِنَّ لِعَيْنِكَ حَظًّا ، وَلِنَفْسِكَ حَظًّا ، وَلأَهْلِكَ حَقًّا ، صُمْ وَأَفْطِرْ ، وَصَلِّ وَنَمْ ، وَصُمْ مِنْ كُلِّ عَشَرَةِ أَيَّامٍ يَوْمًا وَلَكَ بِأَجْرِ تِسْعَةٍ "" ، قَالَ : إِنِّي أَقْوَى مِنْ ذَلِكَ يَا رَسُولَ اللَّهِ ، قَالَ : "" صُمْ صِيَامَ دَاوُدَ إِذًا "" ، قَالَ : وَكَيْفَ صِيَامُ دَاوُدَ يَا نَبِيَّ اللَّهِ ؟ قَالَ : ""كَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا ، وَلا يَفِرُّ إِذَا لاقَى "" ، قَالَ : قَالَ : وَمَنْ لِي بِهَذَا يَا نَبِيَّ اللَّهِ ؟""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 2683","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَنْبَأَنا عُبَيْدُ بْنُ سَعِيدٍ الْأُمَوِيُّ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ ثَوْرٍ عَنْ خَالِدِ بْنِ مَعْدَانَ عَنْ عَائِشَةَ قَالَتْ","The Book of Fasting"
"2684","أَنْبَأَ زَكَرِيَّا بْنُ يَحْيَى ، قَالَ : حَدَّثَنَا وَهْبُ بْنُ بَقِيَّةَ ، قَالَ : أَنْبَأَ خَالِدٌ ، عَنْ خَالِدٍ ، عَنْ أَبِي قِلابَةَ ، عَنْ أَبِي الْمَلِيحِ ، قَالَ : دَخَلْتُ مَعَ أَبِيكَ زَيْدٍ عَلَى عَبْدِ اللَّهِ بْنِ عَمْرٍو فَحَدَّثَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ذُكِرَ لَهُ صَوْمِي ، فَدَخَلَ عَلَيَّ ، قَالَ : فَأَلْقَيْتُ لَهُ وِسَادَةً حَشْوُهَا لِيفٌ ، فَجَلَسَ عَلَى الأَرْضِ فَصَارَتِ الْوِسَادَةُ فِيمَا بَيْنِي وَبَيْنَهُ ، فَقَالَ :  أَمَا يَكْفِيكَ مِنْ كُلِّ شَهْرٍ ثَلاثَةَ أَيَّامٍ ؟ "" قُلْتُ : زدني يَا رَسُولَ اللَّهِ ، قَالَ : "" خَمْسًا "" ، قُلْتُ : يَا رَسُولَ اللَّهِ ، قَالَ : "" سَبْعًا "" ، قُلْتُ : يَا رَسُولَ اللَّهِ ، قَالَ : "" تِسْعًا "" ، قُلْتُ : يَا رَسُولَ اللَّهِ ، قَالَ : "" أَحَدَ عَشْرَ "" ، قُلْتُ : يَا رَسُولَ اللَّهِ ، قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : ""لا صَوْمَ فَوْقَ صَوْمِ دَاوُدَ ، شَطْرَ الدَّهْرِ ، صِيَامُ يَوْمٍ وَفِطْرُ يَوْمٍ """"""","","Sunan al-Kubra al-Nasai 2684","","أَخْبَرَنَا أَحْمَدُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا أَبُو دَاوُدَ عَنْ سُفْيَانَ عَنْ مَنْصُورٍ عَنْ خَالِدِ بْنِ سَعْدٍ عَنْ عَائِشَةَ قَالَتْ","The Book of Fasting"
"2685","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ الْحَسَنِ الْمِصِّيصِيُّ ، قَالَ : حدَّثَنَا حَجَّاجُ بْنُ مُحَمَّدٍ ، قَالَ : حَدَّثَنِي شُعْبَةُ ، عَنْ زِيَادِ بْنِ فَيَّاضٍ ، قَالَ : سَمِعْتُ أَبَا عِيَاضٍ ، قَالَ : قَالَ عَبْدُ اللَّهِ بْنُ عَمْرٍو : قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  صُمْ مِنَ الشَّهْرِ يَوْمًا وَلَكَ أَجْرُ مَا بَقِيَ "" ، فَقُلْتُ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : "" فَصُمْ يَوْمَيْنِ وَلَكَ أَجْرُ مَا بَقِيَ "" ، فَقُلْتُ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : "" صُمْ ثَلاثَةَ أَيَّامٍ وَلَكَ أَجْرُ مَا بَقِيَ "" ، قُلْتُ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : "" صُمْ أَرْبَعَةَ أَيَّامٍ وَلَكَ أَجْرُ مَا بَقِيَ "" ، قُلْتُ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَعْدَمَا قَالَ : أَرْبَعَةُ أَيَّامٍ : ""أَفْضَلُ الصَّوْمِ صَوْمُ دَاوُدَ ، كَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 2685","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ حَبِيبِ بْنِ الشَّهِيدِ قَالَ حَدَّثَنَا يَحْيَى بْنُ يَمَانٍ عَنْ سُفْيَانَ عَنْ عَاصِمٍ عَنِ الْمُسَيَّبِ بْنِ رَافِعٍ عَنْ سَوَاءٍ الْخُزَاعِيِّ عَنْ عَائِشَةَ قَالَتْ","The Book of Fasting"
"2686","أَنْبَأَ عَلِيُّ بْنُ حُجْرٍ ، قَالَ : أَنْبَأَ إِسْمَاعِيلُ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ أَبِي حَرْمَلَةَ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، عَنْ أَبِي ذَرٍّ ، قَالَ :  أَوْصَانِي خَلِيلِي صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِثَلاثٍ لا أَدَعُهُنَّ إِنْ شَاءَ اللَّهُ أَبَدًا : أَوْصَانِيبِصَلاةِ الضُّحَى ، وَبِالْوَتْرِ قَبْلَ النَّوْمِ ، وَبِصِيَامِ ثَلاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ """"""","Hasan|Hasan|Sahih","Sunan al-Kubra al-Nasai 2686","","أَخْبَرَنِي أَبُو بَكْرِ بْنُ عَلِيٍّ قَالَ حَدَّثَنِي أَبُو نَصْرٍ التَّمَّارُ قَالَ حَدَّثَنِي حَمَّادُ بْنُ سَلَمَةَ عَنْ عَاصِمٍ عَنْ سَوَاءٍ عَنْ أُمِّ سَلَمَةَ قَالَتْ","The Book of Fasting"
"2687","أَنْبَأَ مُحَمَّدُ بْنُ عَلِيِّ بْنُ الْحَسَنِ بْنِ شَقِيقٍ الْمَرْوَزِيُّ ، قَالَ : سَمِعْتُ أَبِي ، قَالَ : أَنْبَأَ أَبُو حَمْزَةَ ، عَنْ عَاصِمٍ ، عَنِ الأَسْوَدِ بْنِ هِلالٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَمَرَنِي نَبِيُّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِثَلاثٍ نَوْمٌ عَلَى وِتْرٍ ، وَغُسْلٌ يَوْمَ الْجُمُعَةِ ، وَصِيَامُ ثَلاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ """"""","Hasan|Hasan|Isnaad Hasan","Sunan al-Kubra al-Nasai 2687","","أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى قَالَ حَدَّثَنَا إِسْحَاقُ قَالَ أَخْبَرَنَا النَّضْرُ قَالَ حَدَّثَنَا حَمَّادٌ عَنْ عَاصِمِ بْنِ أَبِي النَّجُودِ عَنْ سَوَاءٍ عَنْ حَفْصَةَ قَالَتْ","The Book of Fasting"
"2688","أَخْبَرَنِي مُحَمَّدُ بْنُ رَافِعٍ ، قَالَ : حَدَّثَنَا أَبُو النَّضْرِ ، قَالَ : حَدَّثَنَا أَبُو مُعَاوِيَةَ ، عَنْ عَاصِمٍ ، عَنِ الأَسْوَدِ بْنِ هِلالٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : أَمَرَنِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِنَوْمٍ عَلَى وَتْرٍ ، وَالْغَسْلِ يَوْمَ الْجُمُعَةِ ، وَصِيَامِ ثَلاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ """"""","Hasan Sahih|Hasan Sahih|Sahih","Sunan al-Kubra al-Nasai 2688","","أَخْبَرَنَا الْقَاسِمُ بْنُ زَكَرِيَّا قَالَ حَدَّثَنَا حُسَيْنٌ عَنْ زَائِدَةَ عَنْ عَاصِمٍ عَنِ الْمُسَيَّبِ عَنْ حَفْصَةَ قَالَتْ","The Book of Fasting"
"2689","أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى ، قَالَ : حَدَّثَنَا أَبُو كَامِلٍ ، قَالَ : حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ عَاصِمِ بْنِ بَهْدَلَةَ ، عَنْ رَجُلٍ ، عَنِ الأَسْوَدِ بْنِ هِلالٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ :  أَمَرَنِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَبِرَكْعَتَيِ الضُّحَى ، وَأَنْ لا أَنَامَ إِلا عَلَى وِتْرٍ ، وَصِيَامِ ثَلاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ ""ذِكْرُ الاخْتِلافِ عَلَى أَبِي عُثْمَانَ فِي خَبَرِ أَبِي هُرَيْرَةَ فِي صِيَامِ ثَلاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ""","","Sunan al-Kubra al-Nasai 2689","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحَسَنِ بْنِ شَقِيقٍ قَالَ أَبِي أَخْبَرَنَا أَبُو حَمْزَةَ عَنْ عَاصِمٍ عَنْ زِرٍّ عَنْ عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ","The Book of Fasting"
"2690","أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى ، قَالَ : حَدَّثَنَا عبْدُ الأَعْلَى ، قَالَ : حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ ، عَنْ ثَابِتٍ ، عَنْ أَبِي عُثْمَانَ ، أَنَّ أَبَا هُرَيْرَةَ قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : شَهْرُ الصَّبْرِ وَثَلاثَةُ أَيَّامٍ مِنْ كُلِّ شَهْرٍ صَوْمُ الدَّهْرِ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 2690","","أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى قَالَ حَدَّثَنَا أَبُو كَامِلٍ قَالَ حَدَّثَنَا أَبُو عَوَانَةَ عَنْ عَاصِمِ ابْنِ بَهْدَلَةَ عَنْ رَجُلٍ عَنِ الْأَسْوَدِ بْنِ هِلَالٍ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Fasting"
"2691","أنبأ عَلِيُّ بْنُ الْحَسَنِ اللانِيُّ ، عَنْ عَبْدِ الرَّحِيمِ هُوَ ابْنُ سُلَيْمَانَ ، عَنْ عَاصِمٍ الأَحْوَلِ ، عَنْ أَبِي عُثْمَانَ ، عَنْ أَبِي ذَرٍّ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ صَامَ ثَلاثَةَ أَيَّامٍ مِنَ الشَّهْرِ فَلْيَصُمِ الدَّهْرَ كُلَّهُ ""، ثُمَّ قَالَ : صَدَقَ اللَّهُ وَرَسُولُهُ فِي كِتَابِهِ  مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا ""","Sahih|Daif|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 2691","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ عُبَيْدِ اللهِ سَمِعَ ابْنَ عَبَّاسٍ يَسْأَلُ عَنْ صِيَامِ يَوْمِ عَاشُورَاءَ قَالَ","The Book of Fasting"
"2692","أنبأ مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : حَدَّثَنَا حِبَّانُ ، قَالَ : أنبأ عَبْدُ اللَّهِ ، عَنْ عَاصِمٍ ، عَنْ أَبِي عُثْمَانَ ، عَنْ رَجُلٍ ، قَالَ : قَالَ أَبُو ذَرٍّ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : مَنْ صَامَ ثَلاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ فَقَدْ تَمَّ لَهُ صَوْمُ الشَّهْرِ أَوْ فَلَهُ صَوْمُ الشَّهْرِ ""، شَكَّ عَاصِمٌ""","","Sunan al-Kubra al-Nasai 2692","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا سُفْيَانُ عَنِ الزُّهْرِيِّ عَنْ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ قَالَ","The Book of Fasting"
"2693","أنبأ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا اللَيْثُ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، عَنْ سَعِيدِ بْنِ أَبِي هِنْدَ ، أَنَّ مُطَرِّفًا حَدَّثَهُ ، أَنَّ عُثْمَانَ بْنَ أَبِي الْعَاصِ ، قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : صِيَامٌ حَسَنٌ ثَلاثَةُ أَيَّامٍ مِنَ الشَّهْرِ ""، أنبأ زَكَرِيَّا بْنُ يَحْيَى ، قَالَ : حَدَّثَنَا أَبُو مُصْعَبٍ ، عَنِ الْمُغِيرَةِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ اللَّهِ بْنِ سَعِيدِ بْنِ أَبِي هِنْدَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ سَعِيدِ بْنِ أَبِي هِنْدَ ، قَالَ : عُثْمَانُ بْنُ أَبِي الْعَاصِ نَحْوَهُ مُرْسَلا""","Sahih|Sahih|Isnaad Sahih","Sunan al-Kubra al-Nasai 2693","","أَخْبَرَنَا زَكَرِيَّا بْنُ يَحْيَى قَالَ حَدَّثَنَا شَيْبَانُ قَالَ حَدَّثَنَا أَبُو عَوَانَةَ عَنِ الْحُرِّ بْنِ الصَّيَّاحِ عَنْ هُنَيْدَةَ بْنِ خَالِدٍ عَنِ امْرَأَتِهِ قَالَتْ","The Book of Fasting"
"2694","أنبأ يُوسُفُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا حَجَّاجٌ ، عَنْ شَرِيكٍ ، عَنِ الْحُرِّ بْنِ صَيَّاحٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ ، يَقُولُ : كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَصُومُ ثَلاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ """"""","","Sunan al-Kubra al-Nasai 2694","","أَخْبَرَنَا عَلِيُّ بْنُ حُجْرٍ قَالَ أَخْبَرَنَا إِسْمَاعِيلُ عَنِ الْجُرَيْرِيِّ عَنْ يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ الشِّخِّيرِ عَنْ أَخِيهِ مُطَرِّفٍ عَنْ عِمْرَانَ قَالَ","The Book of Fasting"
"2695","أنبأ الْحَسَنُ بْنُ مُحَمَّدِ بْنِ الصَّبَّاحِ الزَّعْفَرَانِيُّ ، قَالَ : حَدَّثَنَا سَعِيدُ بْنُ سُلَيْمَانَ ، عَنْ شَرِيكٍ ، عَنِ الْحُرِّ بْنِ صَيَّاحٍ ، عَنِ ابْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَصُومُ ثَلاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ : يَوْمَ الاثْنَيْنِ مِنْ أَوَّلِ الشَّهْرِ ، ثُمَّ الْخَمِيسِ الَّذِي يَلِيهِ ، ثُمَّ الْخَمِيسِ الَّذِي يَلِيهِ """"""","","Sunan al-Kubra al-Nasai 2695","","أَخْبَرَنِي عَمْرُو بْنُ هِشَامٍ قَالَ حَدَّثَنَا مَخْلَدٌ عَنِ الْأَوْزَاعِيِّ عَنْ قَتَادَةَ عَنْ مُطَرِّفِ بْنِ عَبْدِ اللهِ بْنِ الشِّخِّيرِ قَالَ حَدَّثَنِي أَبِي","The Book of Fasting"
"2696","أنبأ عَلِيُّ بْنُ مُحَمَّدٍ ، قَالَ : حَدَّثَنَا خَلَفُ بْنُ َتمِيمٍ ، عَنْ زُهَيْرٍ ، عَنِ الْحُرِّ بْنِ صَيَّاحٍ ، قَالَ : سَمِعْتُ هُنَيْدَةَ الْخُزَاعِيَّ ، يَقُولُ : دَخَلْتُ عَلَى أُمِّ الْمُؤْمِنِينَ فَسَمِعْتُهَا ، تَقُولُ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَصُومُ مِنْ كُلِّ شَهْرٍ ثَلاثَةَ أَيَّامٍ : أَوَّلَ اثْنَيْنِ مِنَ الشَّهْرِ ، ثُمَّ الْخَمِيسَ ثُمَّ الْخَمِيسَ الَّذِي يَلِيهِ """"""","Sahih|Sahih|Isnaad Sahih","Sunan al-Kubra al-Nasai 2696","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ حَدَّثَنَا أَبُو دَاوُدَ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ قَتَادَةَ قَالَ سَمِعْتُ مُطَرِّفَ بْنَ عَبْدِ اللهِ بْنِ الشِّخِّيرِ يُحَدِّثُ عَنْ أَبِيهِ","The Book of Fasting"
"2697","أنبأ أَبُو بَكْرِ بْنُ أَبِي النَّضْرِ جَارُ ابْنِ الدَّوْرَقِيِّ ، قَالَ : حَدَّثَنِي أَبُو النَّضْرِ هَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حَدَّثَنَا أَبُو إِسْحَاقَ الأَشْجَعِيُّ كُوفِيٌّ ، عَنْ عَمْرِو بْنِ قَيْسٍ الْمُلائِيِّ ، عَنِ الْحُرِّ بْنِ صَيَّاحٍ ، عَنْ هُنَيْدَةَ بْنِ خَالِدٍ الْخُزَاعِيِّ ، عَنْ حَفْصَةَ أُمِّ الْمُؤْمِنِينَ ، قَالَتْ : أَرْبَعٌ لَمْ يَكُنْ يَدَعُهُنَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : صِيَامُ عَاشُورَاءَ ، وَالْعَشْرُ ، وَثَلاثَةُ أَيَّامٍ مِنْ كُلِّ شَهْرٍ ، وَرَكْعَتَانِ قَبْلَ الْغَدَاةِ """"""","-|Sahih|Sahih Muslim","Sunan al-Kubra al-Nasai 2697","","أَخْبَرَنِي هَارُونُ بْنُ عَبْدِ اللهِ قَالَ حَدَّثَنَا الْحَسَنُ بْنُ مُوسَى قَالَ حَدَّثَنَا أَبُو هِلَالٍ قَالَ حَدَّثَنَا غَيْلَانُ هُوَ ابْنُ جَرِيرٍ قَالَ حَدَّثَنَا عَبْدُ اللهِ بْنُ مَعْبَدٍ الزِّمَّانِيُّ عَنْ أَبِي قَتَادَةَ عَنْ عُمَرَ قَالَ","The Book of Fasting"
"2698","أنبأ أَحْمَدُ بْنُ يَحْيَى ، عَنْ أَبِي نُعَيْمٍ ، قَالَ : حَدَّثَنَا أَبُو عَوَانَةَ ، عَنِ الْحُرِّ بْنِ صَيَّاحٍ ، عَنْ هُنَيْدَةَ بْنِ خَالِدٍ ، عَنِ امْرَأَتِهِ ، عَنْ بَعْضِ أَزْوَاجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَصُومُ تِسْعًا مِنْ ذِي الْحِجَّةِ ، وَيَوْمَ عَاشُورَاءَ ، وَثَلاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ أَوَّلَ اثْنَيْنِ مِنَ الشَّهْرِ وَخَمِيسَيْنِ """"""","","Sunan al-Kubra al-Nasai 2698","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ غَيْلَانَ بْنِ جَرِيرٍ سَمِعَ عَبْدَ اللهِ بْنَ مَعْبَدٍ الزِّمَّانِيَّ عَنْ أَبِي قَتَادَةَ","The Book of Fasting"
"2699","أنبأ مُحَمَّدُ بْنُ عُثْمَانَ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ ، قَالَ : حَدَّثَنَا أَبُو عَوَانَةَ ، عَنِ حُرِّ بْنِ الصَّيَّاحِ ، عَنْ هُنَيْدَةَ بْنِ خَالِدٍ ، عَنِ امْرَأَتِهِ ، عَنْ بَعْضِ أَزْوَاجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَتْ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَصُومُ الْعَشْرَ ، وَثَلاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ الاثْنَيْنِ وَالْخَمِيسَ """"""","","Sunan al-Kubra al-Nasai 2699","","أَخْبَرَنِي حَاجِبُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا الْحَارِثُ بْنُ عَطِيَّةَ قَالَ حَدَّثَنَا الْأَوْزَاعِيُّ عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ عَنْ عَبْدِ اللهِ بْنِ عُمَرَ قَالَ","The Book of Fasting"
"2700","أنا إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ فُضَيْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ ، عَنْ هُنَيْدَةَ الْخُزَاعِيِّ ، عَنْ أُمِّهِ ، عَنْ أُمِّ سَلَمَةَ ، قَالَتْ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَأْمُرُ بِصِيَامِ ثَلاثَةِ أَيَّامٍ أَوَّلَ خَمِيسٍ ، وَالاثْنَيْنِ ، وَالاثْنَيْنِ """"""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 2700","","أَخْبَرَنَا عِيسَى بْنُ مُسَاوِرٍ عَنِ الْوَلِيدِ قَالَ حَدَّثَنَا الْأَوْزَاعِيُّ قَالَ حَدَّثَنِي عَطَاءٌ عَنْ عَبْدِ اللهِ وأَخْبَرَنَي مُحَمَّدُ بْنُ عَبْدِ اللهِ مِصْرِيٌّ قَالَ حَدَّثَنَا الْوَلِيدُ عَنِ الْأَوْزَاعِيِّ قَالَ حَدَّثَنَا عَطَاءٌ عَنْ عَبْدِ اللهِ بْنِ عُمَرَ قَالَ","The Book of Fasting"
"2701","أنبأ مَخْلَدُ بْنُ الْحَسَن ، قَالَ : حَدَّثَنَا عُبَيْدُ اللَّهِ ، عَنْ زَيْدِ بْنِ أَبِي أُنَيْسَةَ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ جَرِيرِ بْنِ عَبْدِ اللَّهِ الْبَجَلِيِّ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : صِيَامُ ثَلاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ صِيَامُ الدَّهْرِ ، وَأَيَّامُ الْبِيضِ صَبِيحَةَ ثَلاثَ عَشْرَةَ وَأَرْبَعَ عَشْرَةَ وَخَمْسَ عَشْرَةَ ""ذِكْرُ الاخْتِلافِ عَلَى مُوسَى بْنِ طَلْحَةَ فِي الْخَبَرِ فِي صِيَامِ ثَلاثَةِ أَيَّامٍ مِنَ الشَّهْرِ""","","Sunan al-Kubra al-Nasai 2701","","أَخْبَرَنَا الْعَبَّاسُ بْنُ الْوَلِيدِ بْنِ مَزْيَدٍ الْبَيْرُوتِيُّ قَالَ أَخْبَرَنِي أَبِي وَعُقْبَةُ عَنِ الْأَوْزَاعِيِّ قَالَ حَدَّثَنِي عَطَاءُ بْنُ أَبِي رَبَاحٍ قَالَ حَدَّثَنِي مَنْ سَمِعَ عَبْدَ اللهِ بْنَ عُمَرَ يَقُولُ","The Book of Fasting"
"2702","أنبأ مُحَمَّدُ بْنُ مَعْمَرٍ الْبَصْرِيُّ يُقَالُ لَهُ : الْبَحْرَانِيُّ ، قَالَ : حَدَّثَنَا حِبَّانُ وَهُوَ ابْنُ هِلالٍ أَبُو حَبِيبٍ ، قَالَ : حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ، عَنْ مُوسَى بْنِ طَلْحَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ جَاءَ أَعْرَابِيٌّ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِأَرْنَبٍ قَدْ شَوَاهَا فَوَضَعَهَا بَيْنَ يَدَيْهِ ، فَأَمْسَكَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَلَمْ يَأْكُلْ وَأَمَرَ الْقَوْمَ أَنْ يَأْكُلُوا ، وَأَمْسَكَ الأَعْرَابِيُّ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَا يَمْنَعُكَ أَنْ تَأْكُلَ ؟ "" قَالَ : إِنِّي أَصُومُ ثَلاثَةَ أَيَّامٍ مِنَ الشَّهْرِ ، قَالَ : "" إِنِّي كُنْتُ صَائِمًا فَصُمِ الْغُرَّ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 2702","","أَخْبَرَنِي إِسْمَاعِيلُ بْنُ يَعْقُوبَ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ مُوسَى قَالَ حَدَّثَنَا أَبِي عَنِ الْأَوْزَاعِيِّ عَنْ عَطَاءٍ عَمَّنْ سَمِعَ عَبْدَ اللهِ بْنَ عُمَرَ","The Book of Fasting"
"2703","أنبأ مُحَمَّدُ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رِزْمَةَ ، قَالَ : حَدَّثَنَا الْفَضْلُ بْنُ مُوسَى ، عَنْ فِطْرٍ ، عَنْ يَحْيَى بْنِ سَامٍ ، عَنْ مُوسَى بْنِ طَلْحَةَ ، عَنْ أَبِي ذَرٍّ ، قَالَ : أَمَرَنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  أَنْنَصُومَ مِنَ الشَّهْرِ ثَلاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ ، أَيَّامٍ الْبِيضَ ثَلاثَ عَشْرَةَ ، وَأَرْبَعَ عَشْرَةَ ، وَخَمْسَ عَشْرَةَ """"""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 2703","","قَالَ أَبُو عَبْدِ الرَّحْمَنِ قَرَأْتُ عَلَى أَحْمَدَ بْنِ إِبْرَاهِيمَ أَنَّ ابْنَ عَائِذٍ حَدَّثَهُمْ وَهُوَ مُحَمَّدٌ دِمَشْقِيٌّ قَالَ حَدَّثَنَا يَحْيَى وَهُوَ ابْنُ حَمْزَةَ عَنِ الْأَوْزَاعِيِّ عَنْ عَطَاءٍ أَنَّهُ حَدَّثَهُ قَالَ حَدَّثَنِي مَنْ سَمِعَ عَبْدَ اللهِ بْنَ عَمْرٍو","The Book of Fasting"
"2704","أنبأ عَمْرُو بْنُ يَزِيدَ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنِ الأَعْمَشِ ، قَالَ : سَمِعْتُ يَحْيَى بْنَ سَامٍ ، عَنْ مُوسَى بْنِ طَلْحَةَ ، قَالَ : سَمِعْتُ أَبَا ذَرٍّ بِالرَّبَذَةِ ، قَالَ : قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا صُمْتَ ثَلاثًا مِنَ الشَّهْرِ فَصُمْ ثَلاثًا يَعْنِي ثَلاثَ عَشْرَةَ ، وَأَرْبَعَ عَشْرَةَ ، وَخَمْسَ عَشْرَةَ """"""","","Sunan al-Kubra al-Nasai 2704","","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ الْحَسَنِ قَالَ حَدَّثَنَا حَجَّاجُ بْنُ مُحَمَّدٍ قَالَ قَالَ ابْنُ جُرَيْجٍ سَمِعْتُ عَطَاءً أَنَّ أَبَا الْعَبَّاسِ الشَّاعِرَ أَخْبَرَهُ أَنَّهُ سَمِعَ عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ قَالَ","The Book of Fasting"
"2705","حَدَّثَنَا مُحَمَّدُ بْنُ مَنْصُورٍ ، عَنْ سُفْيَانَ عَنْ بَيَانِ بْنِ بِشْرٍ ، عَنْ مُوسَى بْنِ طَلْحَةَ ، عَنِ ابْنِ الْحَوْتَكِيَّةِ ، عَنْ أَبِي ذَرٍّ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ لِرَجُلٍ : عَلَيْكَ بِصِيَامِ ثَلاثَ عَشْرَةَ ، وَأَرْبَعَ عَشْرَةَ ، وَخَمْسَ عَشْرَةَ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : هَذَا خَطَأٌ لَيْسَ هَذَا مِنْ حَدِيثِ بَيَانٍ ، وَلَعَلَّ سُفْيَانَ ، قَالَ : حَدَّثَنَا اثْنَانِ فَسَقَطَ الأَلِفُ فَصَارَ بَيَانٌ""","","Sunan al-Kubra al-Nasai 2705","","أَخْبَرَنَا يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ قَالَ حَدَّثَنَا حَمَّادٌ عَنْ هِشَامٍ عَنْ أَبِيهِ عَنْ عَائِشَةَ","The Book of Fasting"
"2706","أنبأ مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ : حَدَّثَنَا سُفْيَانُ ، قَالَ : حَدَّثَنَا رَجُلانِ مُحَمَّدٌ وَهُوَ ابْنُ عَبْدِ الرَّحْمَنِ مَوْلَى آلِ طَلْحَةَ ، وَحَكِيمٌ وَهُوَ ابْنُ جُبَيْرٍ لَيْسَ بِالْقَوِيِّ ، عَنْ مُوسَى بْنِ طَلْحَةَ ، عَنِ ابْنِ الْحَوْتَكِيَّةِ ، عَنْ أَبِي ذَرٍّ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَمَرَ رَجُلا بِصِيَامِ ثَلاثَ عَشْرَةَ ، وَأَرْبَعَ عَشْرَةَ ، وَخَمْسَ عَشْرَةَ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : حَكِيمُ بْنُ جُبَيْرٍ لَيْسَ بِالْقَوِيِّ""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 2706","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنَا عَبْدُ الرَّحْمَنِ قَالَ حَدَّثَنَا سُفْيَانُ عَنِ الْأَعْمَشِ عَنْ أَبِي عَمَّارٍ عَنْ عَمْرِو بْنِ شُرَحْبِيلَ","The Book of Fasting"
"2707","أنبأ أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ ، عَنْ بَكْرٍ الْكُوفِيِّ الْقَاضِي ، عَنْ عِيسَى ، عَنْ مُحَمَّدٍ ، عَنِ الْحَكَمِ ، عَنْ مُوسَى بْنِ طَلْحَةَ ، عَنِ ابْنِ الْحَوْتَكِيَّةِ ، قَالَ : جَاءَ أَعْرَابِيٌّ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَمَعَهُ أَرْنَبٌ قَدْ شَوَاهَا وَخُبْزٌ ، فَوَضَعَهَا بَيْنَ يَدَيْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ قَالَ : إِنِّي وَجَدْتُ بِهَا دَمًا ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  لا يَضِيرُ كُلُوا "" ، وَقَالَ لِلأَعْرَابِيِّ : "" كُلْ "" ، قَالَ : إِنِّي صَائِمٌ ، قَالَ : "" صَوْمُ مَاذَا ؟ "" قَالَ : صَوْمُ ثَلاثَةِ أَيَّامٍ مِنَ الشَّهْرِ ، قَالَ : ""إِنْ كُنْتَ صَائِمًا فَعَلَيْكَ بِالْغُرِّ الْبِيضِ ثَلاثَ عَشْرَةَ ، وَأَرْبَعَ عَشْرَةَ ، وَخَمْسَ عَشْرَةَ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : الصَّوَابُ عَنْ أَبِي ذَرٍّ ، وَيُشْبِهُ أَنْ يَكُونَ وَقَعَ مِنَ الْكِتَابِ ذَرٌّ ، فَقِيلَ : إِنِّي ، وَاللَّهُ أَعْلَمُ""","","Sunan al-Kubra al-Nasai 2707","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْعَلَاءِ قَالَ حَدَّثَنَا أَبُو مُعَاوِيَةَ قَالَ حَدَّثَنَا الْأَعْمَشُ عَنْ أَبِي عَمَّارٍ عَنْ عَمْرِو بْنِ شُرَحْبِيلَ قَالَ","The Book of Fasting"
"2708","أنبأ عَمْرُو بْنُ يَحْيَى بْنِ الْحَارِثِ ، قَالَ : حَدَّثَنَا الْمُعَافَى بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا الْقَاسِمُ بْنُ مَعْنٍ ، عَنْ طَلْحَةَ بْنِ يَحْيَى بْنِ طَلْحَةَ ، عَنْ مُوسَى بْنِ طَلْحَةَ ، أَنَّ رَجُلا أَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِأَرْنَبٍ فَكَأنَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَدَّ يَدَهُ إِلَيْهَا ، فَقَالَ الَّذِي جَاءَ بِهَا : إِنِّي رَأَيْتُ بِهَا دَمًا ، فَكَفَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَدَهُ ، وَأَمَرَ الْقَوْمَ أَنْ يَأْكُلُوا ، وَكَانَ فِي الْقَوْمِ رَجُلٌ مُنْتَبِذٌ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  مَا لَكَ ؟ "" ، قَالَ : إِنِّي صَائِمٌ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : ""فَهَلا ثَلاثَ الْبِيضِ ثَلاثَ عَشْرَةَ ، وَأَرْبَعَ عَشْرَةَ ، وَخَمْسَ عَشْرَةَ """"""","Sahih|Sahih|Sahih Muslim","Sunan al-Kubra al-Nasai 2708","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا حَمَّادٌ عَنْ غَيْلَانَ بْنِ جَرِيرٍ عَنْ عَبْدِ اللهِ بْنِ مَعْبَدٍ عَنْ أَبِي قَتَادَةَ قَالَ","The Book of Fasting"
"2709","أنبأ مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ بْنِ عُلَيَّةَ ، قَالَ : حَدَّثَنَا يَعْلَى ، عَنْ طَلْحَةَ بْنِ يَحْيَى ، عَنْ مُوسَى بْنِ طَلْحَةَ ، قَالَ : أُتِيَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِأَرْنَبٍ قَدْ سَوَّاهَا رَجُلٌ ، فَلَمَّا قَدَّمَهَا إِلَيْهِ ، قَالَ : يَا رَسُولَ اللَّهِ ، إِنِّي رَأَيْتُ بِهَا دَمًا ، فَتَرَكَهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَلَمْ يَأْكُلْهَا ، وَقَالَ لِمَنْ عِنْدَهُ :  كُلُوا فَإِنِّي لَوِ اشْتَهَيْتُهَا أَكَلْتُهَا "" ، وَرَجُلٌ جَالِسٌ : فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" ادْنُ فَكُلْ مَعَ الْقَوْمِ "" ، فَقَالَ : يَا رَسُولَ اللَّهِ ، إِنِّي صَائِمٌ ، قَالَ :"" فَهَلا صُمْتَ الْبِيضَ ؟ "" ، قَالَ : وَمَا هُنَّ ؟ قَالَ : "" ثَلاثَ عَشْرَةَ ، وَأَرْبَعَ عَشْرَةَ ، وَخَمْسَ عَشْرَةَ """"""","","Sunan al-Kubra al-Nasai 2709","","قَالَ وَفِيمَا قَرَأَ عَلَيْنَا أَحْمَدُ بْنُ مَنِيعٍ قَالَ حَدَّثَنَا هُشَيْمٌ قَالَ أَخْبَرَنَا حُصَيْنٌ وَمُغِيرَةُ عَنْ مُجَاهِدٍ عَنْ عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ","The Book of Fasting"
"2710","أنبأ مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حَدَّثَنَا خالِدٌ ، عَنْ شُعْبَةَ ، أنبأ أَنَسُ بْنُ سِيرِينَ ، عَنْ رَجُلٍ يُقَالُ لَهُ : عَبْدُ الْمَلِكِ يُحَدِّثُ ، عَنْ أَبِيهِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَأْمُرُ بِهَذِهِ الأَيَّامِ الثَّلاثِ الْبِيضِ وَيَقُولُ : "" هُنَّ صِيَامُ الشَّهْرِ """"""","","Sunan al-Kubra al-Nasai 2710","","أَخْبَرَنَا مُحَمَّدُ بْنُ مَعْمَرٍ قَالَ حَدَّثَنَا يَحْيَى بْنُ حَمَّادٍ قَالَ حَدَّثَنَا أَبُو عَوَانَةَ عَنْ مُغِيرَةَ عَنْ مُجَاهِدٍ قَالَ قَالَ لِي عَبْدُ اللهِ بْنُ عَمْرٍو بْنِ الْعَاصِ أَنْكَحَنِي أَبِي امْرَأَةً ذَاتَ حَسَبٍ فَكَانَ يَأْتِيهَا فَيَسْأَلُهَا عَنْ بَعْلِهَا فَقَالَتْ","The Book of Fasting"
"2711","أنبأ مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : أنبأ حِبَّانُ ، قَالَ : أنبأ عَبْدُ اللَّهِ ، عَنْ شُعْبَةَ ، عَنْ أَنَسِ بْنِ سِيرِينَ ، قَالَ : سَمِعْتُ عَبْدَ الْمَلِكِ بْنَ أَبِي الْمِنْهَالِ يُحَدِّثُ ، عَنْ أَبِيهِ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَمَرَهُمْبِصِيَامِ ثَلاثَةِ أَيَّامٍ الْبِيضِ ، وَقَالَ :  فَهُنَّ صَوْمُ الشَّهْرِ """"""","Sahih Isnaad|Sahih Isnaad|Hasan","Sunan al-Kubra al-Nasai 2711","","أَخْبَرَنَا عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ عَبْدِ اللهِ بْنِ يُونُسَ قَالَ حَدَّثَنَا عَبْثَرٌ قَالَ حَدَّثَنَا حُصَيْنٌ عَنْ مُجَاهِدٍ عَنْ عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ زَوَّجَنِي أَبِي امْرَأَةً فَجَاءَ يَزُورُهَا فَقَالَ كَيْفَ تَرَيْنَ بَعْلَكِ؟ فَقَالَتْ","The Book of Fasting"
"2712","أنبأ مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ : حَدَّثَنَا حِبَّانُ البصري ، قَالَ : حَدَّثَنَا هَمَّامٌ ، قَالَ : حَدَّثَنَا أَنَسُ بْنُ سِيرِينَ ، قَالَ : حَدَّثَنِي عَبْدُ الْمَلِكِ بْنُ قُدَامَةَ بْنِ مِلْحَانَ ، عَنْ أَبِيهِ ، قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَأْمُرُنَا أَنْ نَصُومَ أَيَّامَ الْبِيضِ ثَلاثَ عَشْرَةَ ، وَأَرْبَعَ عَشْرَةَ ، وَخَمْسَ عَشْرَةَ """"""","","Sunan al-Kubra al-Nasai 2712","","أَخْبَرَنَا يَحْيَى بْنُ دُرُسْتَ قَالَ حَدَّثَنَا أَبُو إِسْمَاعِيلَ قَالَ حَدَّثَنَا يَحْيَى بْنُ أَبِي كَثِيرٍ أَنَّ أَبَا سَلَمَةَ حَدَّثَهُ أَنَّ عَبْدَ اللهِ قَالَ","The Book of Fasting"
"2713","أنبأ عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا سَيْفُ بْنُ عُبَيْدِ اللَّهِ مِنْ خِيَارِ الْخَلْقِ ، قَالَ : حَدَّثَنَا الأَسْوَدُ بْنُ شَيْبَانَ ، عَنْ أَبِي نَوْفَلِ بْنِ أَبِي عَقْرَبٍ ، عَنْ أَبِيهِ ، قَالَ : سَأَلْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الصَّوْمِ ، فَقَالَ :  صُمْ يَوْمًا مِنَ الشَّهْرِ "" ، قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ ، زِدْنِي ، قَالَ : يَقُولُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" زِدْنِي ، زِدْنِي ، صُمْ يَوْمَيْنِ مِنْ كُلِّ شَهْرٍ "" ، قُلْتُ : يَا رَسُولَ اللَّهِ ، إِنِّي أَجِدُنِي قَوِيًّا ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" زِدْنِي زِدْنِي ! أَجِدُنِي قَوِيًّا "" ، فَسَكَتَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَتَّى ظَنَنْتُ أَنَّهُ يُزِيدُنِي ، قَالَ : ""صُمْ ثَلاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ """"""","","Sunan al-Kubra al-Nasai 2713","","أَخْبَرَنَا الرَّبِيعُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا ابْنُ وَهْبٍ قَالَ أَخْبَرَنِي يُونُسُ عَنِ ابْنِ شِهَابٍ قَالَ أَخْبَرَنِي سَعِيدُ بْنُ الْمُسَيِّبِ وَأَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ أَنَّ عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ قَالَ","The Book of Fasting"
"2714","أنبأ عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدِ بْنِ سَلامٍ ، قَالَ : حدَّثَنَا يَزِيدُ بْنُ هَارُونَ ، قَالَ : أنبأ الأَسْوَدُ بْنُ شَيْبَانَ ، عَنْ أَبِي نَوْفَلِ بْنِ أَبِي عَقْرَبٍ ، عَنْ أَبِيهِ ، أَنَّهُ سَأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الصَّوْمِ ، فَقَالَ :  صُمْ يَوْمًا مِنْ كُلِّ شَهْرٍ "" ، فَاسْتَزَادَهُ ، وَقَالَ : بِأَبِي أَنْتَ وَأُمِّي إِنِّي أَجِدُنِي قَوِيًّا فَزِدْنِي ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" إِنِّي أَجِدُنِي قَوِيًّا ، إِنِّي أَجِدُنِي قَوِيًّا "" ، فَمَا كَادَ أَنْ يَزِيدَهُ فَاسْتَزَادَهُ فَزَادَهُ ، فَقَالَ : "" صُمْ يَوْمَيْنِ مِنْ كُلِّ شَهْرٍ "" ، فَقَالَ : بِأَبِي أَنْتَ وَأُمِّي يَا رَسُولَ اللَّهِ ، إِنِّي أَجِدُنِي قَوِيًّا ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" إِنِّي أَجِدُنِي قَوِيًّا ، إِنِّي أَجِدُنِي قَوِيًّا "" ، فَمَا كَادَ أَنْ يَزِيدَهُ ، فَلَمَّا أَلَحَّ عَلَيْهِ ، قَالَ : ""صُمْ ثَلاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ """"""","Munkar|Munkar|Hasan","Sunan al-Kubra al-Nasai 2714","","أَخْبَرَنِي أَحْمَدُ بْنُ بَكَّارٍ قَالَ حَدَّثَنَا مُحَمَّدٌ وَهُوَ ابْنُ سَلَمَةَ عَنِ ابْنِ إِسْحَاقَ عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ قَالَ دَخَلْتُ عَلَى عَبْدِ اللهِ بْنِ عَمْرٍو قُلْتُ أَيْ عَمِّ حَدِّثْنِي عَمَّا قَالَ","The Book of Fasting"
"2715","أنبأ عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنِي أَبُو دَاوُدَ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، قَالَ : أَخْبَرَنِي زِيَادُ بْنُ فَيَّاضٍ ، قَالَ : سَمِعْتُ أَبَا عِيَاضٍ يُحَدِّثُ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : صُمْ يَوْمًا مِنْ أَوَّلِ الشَّهْرِ وَلَكَ أَجْرُ مَا بَقِيَ """"""","","Sunan al-Kubra al-Nasai 2715","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ حَدَّثَنَا مُحَمَّدٌ قَالَ وَأَخْبَرَنَا شُعْبَةُ عَنْ زِيَادِ بْنِ فَيَّاضٍ قَالَ سَمِعْتُ أَبَا عِيَاضٍ يُحَدِّثُ عَنْ عَبْدِ اللهِ بْنِ عَمْرٍو","The Book of Fasting"
"2716","أَنْبَأَ عَبْدَةُ بْنُ عَبْدِ اللَّهِ الصَّفَارُ بَصْرِيٌّ ، قَالَ : نَبَّأَ أَبُو دَاوُدَ الْحَفَرِيُّ ، عَنْ سُفْيَانَ ، عَنِ الْجُرَيْرِيِّ ، عَنْ أَبِي السَّلِيلِ ، عَنْ مُجِيبَةَ الْبَاهِلِيِّ ، عَنْ عَمِّهِ ، قَالَ : أَتَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْتُ : هَلْ تَعْرِفُنِي ، أَنَا الَّذِي أَتَيْتُكَ عَامَ الأَوَّلَ ، فَذَكَرَ مِنْ حُسْنِ جِسْمِهِ ، قَالَ : مَا أَفْطَرْتُ بَعْدَكَ نَهَارًا إِلا لَيْلا ، قَالَ :  وَمَنْ أَمَرَكَ أَنْ تُعَذِّبَ نَفْسَكَ ، صُمْ شَهْرَ الصَّبْرِ ، وَيَوْمًا مِنَ الشَّهْرِ "" ، قَالَ : إِنِّي أَقْوَى ، قَالَ : "" صُمْ شَهْرَ الصِّيَامِ ، وَيَوْمَيْنِ مِنَ الشَّهْرِ "" ، قَالَ : إِنِّي أَقْوَى ، قَالَ : "" صُمْ شَهْرَ الصَّبْرِ وَثَلاثَةَ أَيَّامٍ مِنَ الشَّهْرِ "" ، قَالَ : إِنِّي أَقْوَى ، قَالَ : ""صُمِ الْحُرُمَ وَأَفْطِرْ """"""","Sahih|Sahih|Isnaad Hasan","Sunan al-Kubra al-Nasai 2716","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى قَالَ حَدَّثَنَا الْمُعْتَمِرُ عَنْ أَبِيهِ قَالَ حَدَّثَنَا أَبُو الْعَلَاءِ عَنْ مُطَرِّفٍ عَنِ ابْنِ أَبِي رَبِيعَةَ عَنْ عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ ذَكَرْتُ لِلنَّبِيِّ ﷺ الصَّوْمَ قَالَ","The Book of Fasting"
"2717","أنبأ مُحَمَّدُ بْنُ مَنْصُورٍ ، وَالْحَارِثُ بْنُ مِسْكِينٍ قِرَاءَةً عَلَيُهِ وَاللَّفْظُ لَهُ ، عَنْ سُفْيَانَ ، عَنْ عَمْرٍو ، عَنْ يَحْيَى بْنِ جَعْدَةَ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو الْقَارِئِ ، قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ ، يَقُولُ : مَا أَنَا نَهَيْتُ عَنْ صِيَامِ يَوْمِ الْجُمُعَةِ ، مُحَمَّدٌ وَرَبِّ الْبَيْتِ نَهَى عَنْهُ """"""","","Sunan al-Kubra al-Nasai 2717","","أَخْبَرَنِي مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ قَالَ حَدَّثَنَا يَزِيدُ قَالَ أَخْبَرَنَا حَمَّادٌ وَأَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى قَالَ حَدَّثَنَا عَبْدُ الْأَعْلَى قَالَ حَدَّثَنَا حَمَّادٌ وَاللَّفْظُ لِزَكَرِيَّا عَنْ ثَابِتٍ عَنْ شُعَيْبِ بْنِ عَبْدِ اللهِ بْنِ عَمْرٍو عَنْ أَبِيهِ قَالَ","The Book of Fasting"
"2718","أنبأ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ عَبْدِ الْحَمِيدِ بْنِ جُبَيْرِ بْنِ شَيْبَةَ ، عَنْ مُحَمَّدِ بْنِ عَبَّادٍ ، قَالَ : سَأَلْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ وَهُوَ يَطُوفُ بِالْبَيْتِ  أَنَهَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْصِيَامِ يَوْمِ الْجُمُعَةِ ؟ قَالَ : نَعَمْ ، وَرَبِّ هَذَا الْبَيْتِذِكْرُ الاخْتِلافِ عَلَى عَبْدِ الْمَلِكِ بْنِ عَبْدِ الْعَزِيزِ بْنِ جُرَيْجٍ فِي هَذَا الْحَديثِ""","","Sunan al-Kubra al-Nasai 2718","","أَخْبَرَنِي مُحَمَّدُ بْنُ عُبَيْدٍ الْكُوفِيُّ عَنْ أَسْبَاطِ بْنِ مُحَمَّدٍ عَنْ مُطَرِّفٍ عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ عَنْ أَبِي الْعَبَّاسِ عَنْ عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ","The Book of Fasting"
"2719","أنبأ يُوسُفُ بْنُ سَعِيدٍ الْمِصِّيصِيُّ ، قَالَ : حدَّثَنَا حَجَّاجٌ ، عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَبْدُ الْحَمِيدِ بْنُ جُبَيْرِ بْنِ شَيْبَةَ ، أَنَّهُ سَمِعَ مُحَمَّدَ بْنَ عَبَّادِ بْنِ جَعْفَرٍ ، أَنَّهُ سَأَلَ جَابِرَ بْنَ عَبْدِ اللَّهِ وَهُوَ يَطُوفُ بِالْبَيْتِ : أَسَمِعْتَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَنْهَى عَنْ صِيَامِ يَوْمِ الْجُمُعَةِ ؟ فَقَالَ : نَعَمْ ، وَرَبِّ هَذَا الْبَيْتِ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 2719","","أَخْبَرَنَاَ عَلِيُّ بْنُ الْحُسَيْنِ قَالَ حَدَّثَنَا أُمَيَّةُ بْنُ خَالِدٍ بصري عَنْ شُعْبَةَ عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ قَالَ","The Book of Fasting"
"2720","أنبأ عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا يحْيَى ، قَالَ : حَدَّثَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ عَبَّادِ بْنِ جَعْفَرٍ ، قَالَ : قُلْتُ لِجَابِرٍ : أَسَمِعْتَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَنْهَى أَنْ يُفْرَدَ يَوْمُ الْجُمُعَةِ بِصَوْمٍ ؟ قَالَ : إِي وَرَبِّ الْكَعْبَةِ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 2720","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى قَالَ حَدَّثَنَا خَالِدٌ عَنْ شُعْبَةَ قَالَ أَخْبَرَنِي حَبِيبُ بْنُ أَبِي ثَابِتٍ قَالَ سَمِعْتُ أَبَا الْعَبَّاسِ يُحَدِّثُ عَنْ عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ","The Book of Fasting"
"2721","أنبأ سُلَيْمَانُ بْنُ سَلْمٍ الْبَلْخِيُّ ، قَالَ : أنبأ النَّضْرُ ، قَالَ : أنبأ ابْنُ جُرَيْجٍ ، عَنْ مُحَمَّدِ بْنِ عَبَّادٍ ، أَنَّ جَابِرًا سُئِلَ عَنْصَوْمِ يَوْمِ الْجُمُعَةِ ، فَقَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ تُفْرِدَهُ """"""","","Sunan al-Kubra al-Nasai 2721","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنَا مُحَمَّدٌ يَعْنِي ابْنَ جَعْفَرٍ غُنْدَرٌ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ عَمْرِو بْنِ دِينَارٍ عَنْ أَبِي الْعَبَّاسِ عَنْ عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ","The Book of Fasting"
"2722","حَدَّثَنَا أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ ، قَالَ : حدَّثَنَا أَبُو نُعَيْمٍ ، قَالَ : حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَيْجٍ ، عَنْ مُحَمَّدِ بْنِ عَبَّادِ بْنِ جَعْفَرٍ ، عَنْ جَابِرٍ ، قَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، عَنْصِيَامِ يَوْمِ الْجُمُعَةِ مُنْفَرِدًا ""خَالَفَهُ مُسْتَوْرِدُ بْنُ عَبَّادٍ الْهُنَائِيُّ""","Sahih Isnaad|Sahih Isnaad|Hasan","Sunan al-Kubra al-Nasai 2722","","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ الْحَسَنِ قَالَ حَدَّثَنَا حَجَّاجٌ قَالَ ابْنُ جُرَيْجٍ سَمِعْتُ عَطَاءً أَنَّ أَبَا الْعَبَّاسِ الشَّاعِرَ أَخْبَرَهُ أَنَّهُ سَمِعَ عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ قَالَ","The Book of Fasting"
"2723","أنبأ مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حَدَّثَنَا خالِدٌ ، قَالَ : حَدَّثَنَا مَسْتُورٌ ، قَالَ : حَدَّثَنَا فُلانُ بْنُ جَعْفَرٍ الْمَخْزُومِيِّ ، أَنَّ رَجُلا لَقِيَ أَبَا هُرَيْرَةَ وَهُوَ يَطُوفُ بِالْبَيْتِ ، قَالَ :  أَأَنْتَنَهَيْتَ النَّاسَ عَنْ صَوْمِ يَوْمِ الْجُمُعَةِ ؟ قَالَ : لا وَرَبِّ الْكَعْبَةِ ما أَنَا نَهَيْتُهُمْ وَلَكِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَاهُمْ ""ذِكْرُ الاخْتِلافِ عَلَى مُحَمَّدِ بْنِ سِيرِينَ""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 2723","","أَخْبَرَنَا زَكَرِيَّا بْنُ يَحْيَى قَالَ حَدَّثَنَا وَهْبُ بْنُ بَقِيَّةَ قَالَ أَخْبَرَنَا خَالِدٌ عَنْ خَالِدٍ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي الْمَلِيحِ قَالَ دَخَلْتُ مَعَ أَبِيكَ زَيْدٍ عَلَى عَبْدِ اللهِ بْنِ عَمْرٍو فَحَدَّثَ","The Book of Fasting"
"2724","أنبأ الْقَاسِمُ بْنُ زَكَرِيَّا بْنِ دِينَارٍ الْكُوفِيُّ ، قَالَ : ثنا حُسَيْنٌ الْجُعْفِيُّ ، عَنْ زَائِدَةَ ، عَنْ هِشَامٍ ، عَنِ ابْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا تَخْتَصُّوا لَيْلَةَ الْجُمُعَةِ بِقِيَامٍ مِنْ بَيْنِ اللَّيَالِي ، وَلا تَخْتَصُّوا يَوْمَ الْجُمُعَةِ بِصِيَامٍ مِنْ بَيْنِ الأَيَّامِ إِلا أَنْ يَكُونَ فِي صَوْمٍ يَصُومُهُ أَحَدُكُمْ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 2724","","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ الْحَسَنِ الْمِصِّيصِيُّ قَالَ حَدَّثَنَا حَجَّاجُ بْنُ مُحَمَّدٍ قَالَ حَدَّثَنِي شُعْبَةُ عَنْ زِيَادِ بْنِ فَيَّاضٍ قَالَ سَمِعْتُ أَبَا عِيَاضٍ قَالَ قَالَ عَبْدُ اللهِ بْنُ عَمْرٍو قَالَ","The Book of Fasting"
"2725","أنبأ أَبُو بَكْرِ بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ الْمَخْرَمِيُّ ، قَالَ : حَدَّثَنَا الأَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حَدَّثَنَا إِسْرَائِيلُ ، عَنْ عَاصِمٍ ، عَنْ مُحَمَّدِ بْنِ سِيرِينَ ، عَنْ أَبِي الدَّرْدَاءِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  يَا أَبَا الدَّرْدَاءِلا تَخُصَّ يَوْمَ الْجُمُعَةِ بِصِيَامٍ دُونَ الأَيَّامِ ، وَلا تَخُصَّ لَيْلَةَ الْجُمُعَةِ بِقِيَامٍ دُونَ اللَّيَالِي """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 2725","","أَخْبَرَنَا عَلِيُّ بْنُ حُجْرٍ قَالَ حَدَّثَنَا إِسْمَاعِيلُ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ أَبِي حَرْمَلَةَ عَنْ عَطَاءِ بْنِ يَسَارٍ عَنْ أَبِي ذَرٍّ قَالَ","The Book of Fasting"
"2726","أنبأ إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حَدَّثَنَا بشْرٌ ، قَالَ : حَدَّثَنَا سَعِيدٌ ، عَنْ قَتَادَةَ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ دَخَلَ عَلَى جُوَيْرِيَةَ بِنْتِ الْحَارِثِيَوْمَ الْجُمُعَةِ وَهِيَ صَائِمَةٌ ، فَقَالَ لَهَا :  أَصُمْتِ أَمْسِ ؟ "" ، قَالَتْ : لا ، قَالَ : "" أَتُرِيدِينَ أَنْ تَصُومِي غَدًا ؟ "" ، قَالَتْ : لا ، قَالَ : "" فَأَفْطِرِي """"""","Munkar|Munkar|Hasan","Sunan al-Kubra al-Nasai 2726","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَلَيِّ بْنِ الْحَسَنِ بْنِ شَقِيقٍ الْمَرْوَزِيُّ قَالَ سَمِعْتُ أَبِي قَالَ أَخْبَرَنَا أَبُو حَمْزَةَ عَنْ عَاصِمٍ عَنِ الْأَسْوَدِ بْنِ هِلَالٍ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Fasting"
"2727","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ مُحَمَّدٍ يعني التيمي ، قَالَ : حَدَّثَنَا يَحْيَى ، عَنْ شُعْبَةَ ، عَنْ قَتَادَةَ ، عَنْ أَبِي أَيُّوبَ ، عَنْ جُوَيْرِيَةَ ، قَالَتْ : دَخَلَ عَلَيَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَنَاصَائِمَةٌ يَوْمَ الْجُمُعَةِ ، قَالَ :  أَصُمْتِ أَمْسِ ؟ "" ، قُلْتُ : لا ، قَالَ : "" أَتُصُومِينَ غَدًا ؟ "" ، قُلْتُ : لا ، قَالَ : "" فَأَفْطِرِي """"""","Munkar|Munkar|Hasan","Sunan al-Kubra al-Nasai 2727","","أَخْبَرَنَا مُحَمَّدُ بْنُ رَافِعٍ قَالَ حَدَّثَنَا أَبُو النَّضْرِ قَالَ حَدَّثَنَا أَبُو مُعَاوِيَةَ عَنْ عَاصِمٍ عَنِ الْأَسْوَدِ بْنِ هِلَالٍ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Fasting"
"2728","أنبأ الْقَاسِمُ بْنُ زَكَرِيَّا ، قَالَ : حَدَّثَنَا حسَيْنٌ ، عَنْ زَائِدَةَ ، عَنْ هِشَامٍ ، عَنِ ابْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا تَخْتَصُّوا لَيْلَةَ الْجُمُعَةِ بِقِيَامٍ مِنْ بَيْنِ اللَّيَالِي ، وَلا تَخْتَصُّوا يَوْمَ الْجُمُعَةِ بِصِيَامٍ مِنْ بَيْنِ الأَيَّامِ إِلا أَنْ يَكُونَ فِي صَوْمٍ يَصُومُهُ أَحَدُكُمْ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 2728","","أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى قَالَ حَدَّثَنَا أَبُو كَامِلٍ قَالَ حَدَّثَنَا أَبُو عَوَانَةَ عَنْ عَاصِمِ ابْنِ بَهْدَلَةَ عَنْ رَجُلٍ عَنِ الْأَسْوَدِ بْنِ هِلَالٍ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Fasting"
"2729","أنبأ أَحْمَدُ بْنُ حَرْبٍ ، قَالَ : حَدَّثَنَا أَبُو ُمعَاوِيَةَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا يَصُمْ أَحَدُكُمْ يَوْمَ الْجُمُعَةِ إِلا أَنْ يَصُومَ قَبْلَهُ يَوْمًا أَوْ بَعْدَهُ يَوْمًا """"""","Sahih|Sahih|Isnaad Sahih","Sunan al-Kubra al-Nasai 2729","","أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى قَالَ حَدَّثَنَا عَبْدُ الْأَعْلَى قَالَ حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ عَنْ ثَابِتٍ عَنْ أَبِي عُثْمَانَ أَنَّ أَبَا هُرَيْرَةَ قَالَ","The Book of Fasting"
"2730","أنبأ مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاهِدٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّهُ قَالَ : لا يَصُمْ أَحَدُكُمْ يَوْمَ الْجُمُعَةِ إِلا أَنْ يَصُومَ قَبْلَهُ أَوْ بَعْدَهُ """"""","","Sunan al-Kubra al-Nasai 2730","","أَخْبَرَنَا عَلِيُّ بْنُ الْحَسَنِ اللَّانِيُّ عَنْ عَبْدِ الرَّحِيمِ وَهُوَ ابْنُ سُلَيْمَانَ عَنْ عَاصِمٍ الْأَحْوَلِ عَنْ أَبِي عُثْمَانَ عَنْ أَبِي ذَرٍّ قَالَ","The Book of Fasting"
"2731","أنبأ عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا أَبُو دَاوُدَ ، قَالَ : حَدَّثَنَا شَيْبَانُ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنِ ابْنِ مَسْعُودٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  كَانَيَصُومُ ثَلاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ وَقَلَّمَا رَأَيْتُهُ يُفْطِرُ يَوْمَ الْجُمُعَةِ """"""","","Sunan al-Kubra al-Nasai 2731","","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمٍ قَالَ حَدَّثَنَا حِبَّانُ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ عَاصِمٍ عَنْ أَبِي عُثْمَانَ عَنْ رَجُلٍ قَالَ قَالَ أَبُو ذَرٍّ","The Book of Fasting"
"2732","أنبأ حُسَيْنُ بْنُ مَنْصُورٍ ، قَالَ : حَدَّثَنَا مُبَشِّرُ ْبنُ إِسْمَاعِيلَ ، قَالَ : حَدَّثَنَا حَسَّانُ بْنُ نُوحٍ ، عَنْ عَبْدِ اللَّهِ بْنِ بُسرٍ ، أَنَّهُ قَالَ : تَرَوْنَ يَدِي هَذِهِ ؟ قَدْ بَايَعَتْ يَدَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَسَمِعْتُهُ يَقُولُ : لا تَصُومُوا يَوْمَ السَّبْتِ إِلا فَرِيضَةً ، فَإِنْ لَمْ يَجِدْ أَحَدُكُمْ إِلا لِحَاءَ شَجَرَةٍ فَلْيُفْطِرْ عَلَيْهِ """"""","Daif|Hasan","Sunan al-Kubra al-Nasai 2732","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا اللَّيْثُ عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ عَنْ سَعِيدِ بْنِ أَبِي هِنْدَ أَنَّ مُطَرِّفًا حَدَّثَهُ أَنَّ عُثْمَانَ بْنَ أَبِي الْعَاصِ قَالَ","The Book of Fasting"
"2733","أنبأ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، عَنْ مُعَاوِيَةَ بْنِ صَالِحٍ ، عَنِ ابْنِ عَبْدِ اللَّهِ بْنِ بُسرٍ ، عَنْ أَبِيهِ ، عَنْ عَمَّتِهِ الصَّمَّاءِ أُخْتِ بُسرٍ ، قَالَتْ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْصِيَامِ يَوْمِ السَّبْتِ ، وَيَقُولُ :  إِنْ لَمْ يَجِدْ أَحَدُكُمْ إِلا عُودًا أَخْضَرَ فَلْيُفْطِرْ عَلَيْهِ """"""","","Sunan al-Kubra al-Nasai 2733","","","The Book of Fasting"
"2734","أنبأ عَلِيُّ بْنُ خَشْرَمٍ ، قَالَ : أنبأ عِيسَى ، عَنْ ثَوْرٍ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنْ عَبْدِ اللَّهِ بْنِ بُسرٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا تَصُومُوا يَوْمَ السَّبْتِ إِلا فِيمَا افْتُرِضَ عَلَيْكُمْ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 2734","","أَخْبَرَنَا يُوسُفُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا حَجَّاجٌ عَنْ شَرِيكٍ عَنِ الْحُرِّ بْنِ صَيَّاحٍ قَالَ","The Book of Fasting"
"2735","أَخْبَرَنِي مُحَمَّدُ بْنُ إِسْمَاعِيلَ ، قَالَ : حَدَّثَنَا يزِيدُ ، قَالَ : أنبأ أَصْبَغُ هُوَ ابْنُ زَيْدٍ ، عَنْ ثَوْرٍ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، قَالَ : حَدَّثَنِي عَبْدُ اللَّهِ بْنُ بُسرٍ ، أَنَّ أُخْتَهُ يُقَالُ لَهَا الصَّمَّاءُ ، حَدَّثَتْهُ ، أَنَّهَا سَمِعَتْ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : لا تَصُومُوا يَوْمَ السَّبْتِ إِلا فِيمَا افْتُرِضَ عَلَيْكُمْ ، وَإِنْ لَمْ يَجِدْ أَحَدُكُمْ إِلا عُودَ عِنَبٍ أَوْ لِحَاءَ شَجَرَةٍ فَلْيَمْضُغْهُ """"""","Sahih Lighairihi|Sahih|Hasan","Sunan al-Kubra al-Nasai 2735","","أَخْبَرَنَا الْحَسَنُ بْنُ مُحَمَّدِ بْنِ الصَّبَّاحِ الزَّعْفَرَانِيُّ قَالَ حَدَّثَنَا سَعِيدُ بْنُ سُلَيْمَانَ عَنْ شَرِيكٍ عَنِ الْحُرِّ بْنِ صَيَّاحٍ عَنِ ابْنِ عُمَرَ","The Book of Fasting"
"2736","أنبأ حُمَيْدُ بْنُ مَسْعَدَةَ ، عَنْ سُفْيَانَ بْنِ َحبِيبٍ ، عَنْ ثَوْرٍ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، ثُمَّ ذَكَرَ كَلِمَةً مَعْنَاهَا ، عَنْ عَبْدِ اللَّهِ بْنِ بُسْرٍ ، عَنْ أُخْتِهِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لا تَصُومُوا يَوْمَ السَّبْتِ إِلا فِيمَا افْتُرِضَ عَلَيْكُمْ ، فَإِنْ لَمْ يَجِدْ أَحَدُكُمْ إِلا لِحَاءَ عِنَبَةٍ أَوْ عُودَ شَجَرَةٍ فَلْيَمْضُغْهُ """"""","Sahih|Sahih|Isnaad Hasan","Sunan al-Kubra al-Nasai 2736","","أَخْبَرَنَا عَلِيُّ بْنُ مُحَمَّدٍ قَالَ حَدَّثَنَا خَلَفُ بْنُ تَمِيمٍ عَنْ زُهَيْرٍ عَنِ الْحُرِّ بْنِ صَيَّاحٍ قَالَ","The Book of Fasting"
"2737","أَخْبَرَنِي نُصَيْرُ بْنُ الْفَرَجِ كُتِبَتْ عَنْهُ بِالثَّغْرِ وَيُكْنَى بَا حَمْزَةَ ثِقَةٌ ، قَالَ : حَدَّثَنَا عَبْدُ الْمَلِكِ بْنُ الصَّبَّاحِ ، قَالَ : حَدَّثَنَا ثَوْرٌ ، عَنْ خَالِدٍ هُوَ ابْنُ مَعْدَانَ ، عَنْ عَبْدِ اللَّهِ بْنِ بُسْرٍ ، عَنْ أُخْتِهِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :لا تَصُومُوا يَوْمَ السَّبْتِ إِلا فِيمَا افْتَرَضَ عَلَيْكُمْ ، فَإِنْ لَمْ يَجِدْ أَحَدُكُمْ إِلا عُودَ عِنَبٍ أَوْ لِحَاءَ شَجَرَةٍ فَلْيَمْضُغْهُ ""","Daif|Daif|Daif","Sunan al-Kubra al-Nasai 2737","","أَخْبَرَنَا أَبُو بَكْرِ بْنُ أَبِي النَّضْرِ جَارُ ابْنِ الدَّوْرَقِيِّ قَالَ حَدَّثَنِي أَبُو النَّضْرِ هَاشِمُ بْنُ الْقَاسِمِ قَالَ حَدَّثَنَا أَبُو إِسْحَاقَ الْأَشْجَعِيُّ كُوفِيٌّ عَنْ عَمْرِو بْنِ قَيْسٍ الْمُلَائِيِّ عَنِ الْحُرِّ بْنِ صَيَّاحٍ عَنْ هُنَيْدَةَ بْنِ خَالِدٍ الْخُزَاعِيِّ عَنْ حَفْصَةَ أُمِّ الْمُؤْمِنِينَ قَالَتْ","The Book of Fasting"
"2738","أنبأ سَعِيدُ بْنُ عَمْرٍو ، قَالَ : حَدَّثَنَا بَقِيَّةُ ، قَالَ : حَدَّثَنَا ثَوْرٌ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنْ عَبْدِ اللَّهِ بْنِ بُسرٍ ، عَنْ عَمَّتِهِ الصَّمَّاءِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لا تَصُومُوا يَوْمَ السَّبْتِ إِلا فِيمَا افْتُرِضَ عَلَيْكُمْ ، وَلَوْ لَمْ يَجِدْ أَحَدُكُمْ إِلا عُودَ عِنَبٍ أَوْ لِحَاءَ شَجَرَةٍ فَلْيَمْضُغْهُ """"""","Sahih|Sahih|Isnaad Sahih","Sunan al-Kubra al-Nasai 2738","","أَخْبَرَنِي أَحْمَدُ بْنُ يَحْيَى عَنْ أَبِي نُعَيْمٍ قَالَ حَدَّثَنَا أَبُو عَوَانَةَ عَنِ الْحُرِّ بْنِ الصَّيَّاحٍ عَنْ هُنَيْدَةَ بْنِ خَالِدٍ عَنِ امْرَأَتِهِ","The Book of Fasting"
"2739","أنا عَمْرُو بْنُ عُثْمَانَ ، قَالَ : حَدَّثَنَا بَقِيَّةُ ، قَالَ : حَدَّثَنِي الزُّبَيْدِيُّ ، قَالَ : حَدَّثَنِي لُقْمَانُ بْنُ عَامِرٍ ، عَنْ عَامِرِ بْنِ جَشِيبٍ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنْ عَبْدِ اللَّهِ بْنِ بُسْرٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لا تَصُومُوا يَوْمَ السَّبْتِ إِلا فِيمَا افْتُرِضَ عَلَيْكُمْ ، وَلَوْ لَمْ يَجِدْ أَحَدُكُمْ إِلا لِحَاءَ شَجَرَةٍ فَلْيُفْطِرْ """"""","","Sunan al-Kubra al-Nasai 2739","","أَخْبَرَنَا مُحَمَّدُ بْنُ عُثْمَانَ قَالَ حَدَّثَنَا عَبْدُ الرَّحْمَنِ قَالَ حَدَّثَنَا أَبُو عَوَانَةَ عَنِ حُرِّ بْنِ الصَّيَّاحِ عَنْ هُنَيْدَةَ بْنِ خَالِدٍ عَنِ امْرَأَتِهِ","The Book of Fasting"
"2740","أنبأ عِمْرَانُ بْنُ بَكَّارٍ ، قَالَ : حَدَّثَنَا الرَّبِيعُ بْنُ رَوْحٍ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ حَرْبٍ ، قَالَ : حَدَّثَنَا الزُّبَيْدِيُّ ، عَنِ الْفُضَيلِ بْنِ فَضَالَةَ ، عَنْ عَبْدِ اللَّهِ بْنِ بُسرٍ ، عَنْ خَالَتِهِ الصَّمَّاءِ ، قَالَتْ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : لا تَصُومُوا يَوْمَ السَّبْتِ إِلا فِيمَا افْتُرِضَ ، عَلَيْكُمْ وَلَوْ لَمْ يُفْطِرْ أَحَدُكُمْ إِلا عَلَى لِحَاءِ شَجَرَةٍ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : حُدِّثْتُ عَنِ ابْنِ سَالِمٍ ، عَنِ الزُّبَيْدِيِّ ، قَالَ : ثنا الْفُضَيلُ بْنُ فَضَالَةَ ، أَنَّ خَالِدَ بْنَ مَعْدَانَ حَدَّثَهُ ، أَنَّ عَبْدَ اللَّهِ بْنَ بُسرٍ حَدَّثَهُ أَنَّهُ ، سَمِعَ أَبَاهُ ، يَقُولُ : إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ صِيَامِ يَوْمِ السَّبْتِ "" ، نَحْوَهُ . أَخْبَرَنَا عُمْرَانُ ، قَالَ : حَدَّثَنَا أَبُو تَقِيٍّ ، قَالَ : حَدَّثَنَا ابْنُ سَالِمٍ ، عَنِ الزُّبَيْدِيِّ ، قَالَ : حَدَّثَنَا الْفُضَيْلُ بْنُ فَضَالَةَ ، أَنَّ خَالِدَ بْنَ مَعْدَانَ حَدَّثَهُ ، أَنَّ عَبْدَ اللِّهِ بْنَ بُسرٍ حَدَّثَهُ ، أَنَّهُ سَمِعَ أَبَاهُ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ صِيَامِ يَوْمِ السَّبْتِ ، وَقالَ : "" إِنْ لَمْ يَجِدْ . . . "" وَذَكَرَ الْحَدِيثَ . قَالَ أَبُو عَبْدِ الرَّحْمَنِ : أَبُو تَقِيٍّ هَذَا ضَعِيفٌ لَيْسَ بِشَيْءٍ ، وَإِنَّمَا أَخْرَجْتُهُ لِعِلَّةِ الاخْتِلافِ . أنبأ سَعِيدُ بْنُ عَمْرٍو ، قَالَ : حَدَّثَنَا بَقِيَّةُ ، عَنِ الزُّبَيْدِيِّ ، عَنْ لُقْمَانَ بْنِ عَامِرٍ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنْ عَبْدِ اللَّهِ بْنِ بُسْرٍ ، عَنْ خَالَتِهِ الصَّمَّاءِ ، عَن ِالنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ""","Shadh|Shadh|Sahih","Sunan al-Kubra al-Nasai 2740","","أَخْبَرَنَا إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ فُضَيْلٍ عَنِ الْحَسَنِ بْنِ عُبَيْدِ اللهِ عَنْ هُنَيْدَةَ الْخُزَاعِيِّ عَنْ أُمِّهِ عَنْ أُمِّ سَلَمَةَ قَالَتْ","The Book of Fasting"
"2741","أنبأ عِمْرَانُ بْنُ بَكَّارٍ ، قَالَ : حَدَّثَنَا يَزِيدُ بْنُ عَبْدِ رَبِّهِ ، قَالَ : حَدَّثَنَا بَقِيَّةُ ، عَنِ الزُّبَيْدِيِّ ، عَنْ عَامِرِ بْنِ جَشِيبٍ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنْ عَبْدِ اللَّهِ بْنِ بُسْرٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لا تَصُومُوا يَوْمَ السَّبْتِ إِلا فِيمَا افْتُرِضَ عَلَيْكُمْ ، وَلَوْ لَمْ يَجِدْ أَحَدُكُمْ إِلا لِحَاءَ شَجَرَةٍ فَلْيُفْطِرْ """"""","Hasan|Hasan|Sahih","Sunan al-Kubra al-Nasai 2741","","أَخْبَرَنَا مَخْلَدُ بْنُ الْحَسَنِ قَالَ حَدَّثَنَا عُبَيْدُ اللهِ عَنْ زَيْدِ بْنِ أَبِي أُنَيْسَةَ عَنْ أَبِي إِسْحَاقَ عَنْ جَرِيرِ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ","The Book of Fasting"
"2742","أَخْبَرَنِي مُحَمَّدُ بْنُ وَهْبٍ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ سَلَمَةَ ، قَالَ : حَدَّثَنِي أَبُو عَبْدِ الرَّحِيمِ ، عَنِ الْعَلاءِ ، عَنْ دَاوُدَ بْنِ عُبَيْدِ اللَّهِ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنْ عَبْدِ اللَّهِ بْنِ بُسْرٍ ، عَنْ أُخْتِهِ الصَّمَّاءِ ، عَنْ عَائِشَةَ ، عَنْ نَبِيِّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لا تَصُومُوا يَوْمَ السَّبْتِ إِلا فِيمَا افْتُرِضَ عَلَيْكُمْ ، وَإِنْ لَمْ يَجِدْ أَحَدُكُمْ إِلا لِحَاءَ شَجَرَةٍ فَلْيَمْضُغْهُ """"""","","Sunan al-Kubra al-Nasai 2742","","أَخْبَرَنَا مُحَمَّدُ بْنُ مَعْمَرٍ الْبَصْرِيُّ يُقَالُ لَهُ الْبَحْرَانِيُّ قَالَ حَدَّثَنَا حِبَّانُ وَهُوَ ابْنُ هِلَالٍ أَبُو حَبِيبٍ قَالَ حَدَّثَنَا أَبُو عَوَانَةَ عَنْ عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ عَنْ مُوسَى بْنِ طَلْحَةَ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Fasting"
"2743","أنبأ أَحْمَدُ بْنُ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ إِسْحَاقَ بْنِ إِبْرَاهِيمَ ، قَالَ : حَدَّثَنَا مُعَاوِيَةُ بْنُ يَحْيَى أَبُو مُطِيعٍ ، قَالَ : حَدَّثَنِي أَرْطَاَةُ ، قَالَ : سَمِعْتُ أَبَا عَامِرٍ ، قَالَ : سَمِعْتُ ثَوْبَانَ مَوْلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَسُئِلَ عَنْ صِيَامِ يَوْمِ السَّبْتِ ، فَقَالَ : سَلُوا عَبْدَ اللَّهِ بْنَ بُسْرٍ ، قَالَ : فَسَئَلَ ، فَقَالَ : صِيَامُ السَّبْتِ لا لَكَ وَلا عَلَيْكَ """"""","Daif|Daif|Daif","Sunan al-Kubra al-Nasai 2743","","أَخْبَرَنَي مُحَمَّدُ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رِزْمَةَ قَالَ حَدَّثَنَا الْفَضْلُ بْنُ مُوسَى عَنْ فِطْرٍ عَنْ يَحْيَى بْنِ سَامٍ عَنْ مُوسَى بْنِ طَلْحَةَ عَنْ أَبِي ذَرٍّ قَالَ","The Book of Fasting"
"2744","أنبأ الرَّبِيعُ بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا ابْنُ وَهْبٍ ، قَالَ : حَدَّثَنِي اللَّيْثُ بْنُ سَعْدٍ ، وَذَكَرَ آخَرَ قَبْلَهُ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، عَنْ أَبِي الْخَيْرِ ، عَنْ حُذَيْفَةَ الْبَارِقِيِّ ، عَنْ جُنَادَةَ الأَزْدِيِّ ، أَنَّهُمْ دَخَلُوا عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثَمَانِيَةَ نَفَرٍ وَهُوَ ثَامِنُهُمْ ،فَقَرَّبَ إِلَيْهِمْ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ طَعَامًا يَوْمَ جُمُعَةٍ ، فَقَالَ :  كُلُوا "" ، قَالُوا : صُيَّامٌ ، قَالَ : "" صُمْتُمْ أَمْسِ ؟ "" قَالُوا : لا ، قَالَ : غَدًا ؟ قَالُوا : لا ، قَالَ : "" فَأَفْطِرُوا ""، أَخْبَرَنِي أَحْمَدُ بْنُ بَكَّارٍ ، قَالَ : حَدَّثَنَا مُحَمَّدٌ ، عَنِ ابْنِ إِسْحَاقَ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، عَنْ حُذَيْفَةَ الأَزْدِيِّ ، عَنْ جُنَادَةَ الأَزْدِيِّ ، قَالَ : دَخَلْتُ عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَنَا ثَامِنُ سَبْعَةٍ مِنْ قَوْمِي مِنَ الأَزْدِ فَذَكَرَ نَحْوَهُ""","","Sunan al-Kubra al-Nasai 2744","","أَخْبَرَنَا عَمْرُو بْنُ يَزِيدَ قَالَ حَدَّثَنَا عَبْدُ الرَّحْمَنِ قَالَ حَدَّثَنَا شُعْبَةُ عَنِ الْأَعْمَشِ قَالَ سَمِعْتُ يَحْيَى بْنَ سَامٍ عَنْ مُوسَى بْنِ طَلْحَةَ قَالَ سَمِعْتُ أَبَا ذَرٍّ بِالرَّبَذَةِ قَالَ","The Book of Fasting"
"2745","أنبأ كَثِيرُ بْنُ عُبَيْدٍ الْحِمْصِيُّ ، قَالَ : حَدَّثَنَا بقِيَّةُ بْنُ الْوَلِيدِ ، عَنْ عَبْدِ اللَّهِ بْنِ الْمُبَارَكِ ، عَنْ عَبْدِ اللَّهِ بْنِ مُحَمَّدِ بْنِ عُمَرَ وَهُوَ ابْنُ عَلِيٍّ ، عَنْ أَبِيهِ ، عَنْ كُرَيْبٍ ، أَنَّ ابْنَ عَبَّاسٍ بَعَثَ إِلَى أُمِّ سَلَمَةَ ، وَإِلَى عَائِشَةَ يَسْأَلُهُمَا : مَا كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُحِبُّ أَنْ يَصُومَ مِنَ الأَيَّامِ ، فَقَالَتَا : مَا مَاتَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَتَّى كَانَأَكْثَرُ صَوْمِهِ يَوْمَ السَّبْتِ وَالأَحَدِ ، وَيَقُولُ :  هُمَا عِيدَانِ لأَهْلِ الْكِتَابِ فَنَحْنُ نُحِبُّ أَنْ نُخَالِفَهُمْ """"""","","Sunan al-Kubra al-Nasai 2745","","أَخْبَرَنَا مُحَمَّدُ بْنُ مَنْصُورٍ عَنْ سُفْيَانَ عَنْ بَيَانِ بْنِ بِشْرٍ عَنْ مُوسَى بْنِ طَلْحَةَ عَنِ ابْنِ الْحَوْتَكِيَّةِ عَنْ أَبِي ذَرٍّ","The Book of Fasting"
"2746","أنبأ مُحَمَّدُ بْنُ حَاتِمٍ الْمَرْوَزِيُّ ، قَالَ : أنبأ حِبَّانُ ، قَالَ : أنبأ عَبْدُ اللَّهِ ، عَنْ عَبْدِ اللَّهِ بْنِ مُحَمَّدِ بْنِ عُمَرِ بْنِ عَلِيٍّ ، قَالَ : حَدَّثَنِي أَبِي ، عَنْ كُرَيْبٍ ، قَالَ : أَرْسَلَنِي ابْنُ عَبَّاسٍ ، وَنَاسٌ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى أُمِّ سَلَمَةَ : أَيُّ الأَيَّامِ كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَكْثَرَهَا صِيَامًا ؟ قَالَتْ : يَوْمُ السَّبْتِ وَالأَحَدِ ، فَأَنْكَرُوا عَلَيَّ وَظَنُّوا أَنِّي لَمْ أَحْفَظْ ، فَرَدُّونِي ، فَقَالَتْ : مِثْلَ ذَلِكَ فَأَخْبَرْتُهُمْ ، فَقَامُوا بِأَجْمَعِهِمْ ، فَقَالُوا : إِنَّا أَرْسَلْنَا إِلَيْكِ فِي كَذَا وَكَذَا فَزَعَمَ هَذَا أَنَّكِ قُلْتِ كَذَا وَكَذَا ، قَالَتْ : صَدَقَ ، كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَصُومُ يَوْمَ السَّبْتِ وَالأَحَدِ أَكْثَرَ مَا يَصُومُ مِنَ الأَيَّامِ ، وَيَقُولُ :  إِنَّهُمَا يَوْمَا عِيدٍ لِلْمُشْرِكِينَ فَأَنَا أُحِبُّ أَنْ أُخَالِفَهُمْ """"""","","Sunan al-Kubra al-Nasai 2746","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ حَدَّثَنَا سُفْيَانُ قَالَ حَدَّثَنَا رَجُلَانِ مُحَمَّدٌ وَهُوَ ابْنُ عَبْدِ الرَّحْمَنِ مَوْلَى آلِ طَلْحَةَ وَحَكِيمٌ وَهُوَ ابْنُ جُبَيْرٍ لَيْسَ بِالْقَوِيِّ عَنْ مُوسَى بْنِ طَلْحَةَ عَنِ ابْنِ الْحَوْتَكِيَّةِ عَنْ أَبِي ذَرٍّ","The Book of Fasting"
"2747","أنبأ عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ، قَالَ : حَدَّثَنَا مَهْدِيُّ بْنُ مَيْمُونٍ ، عَنْ غَيْلانَ بْنِ جَرِيرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ مَعْبَدٍ الزِّمَّانِيِّ ، عَنْ أَبِي قَتَادَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سُئِلَ عَنْصَوْمِ الإِثْنَيْنِ ، قَالَ :  هُوَ يَوْمٌ وُلِدْتُ فِيهِ وَيَوْمٌ أُنْزِلَ عَلَيَّ فِيهِ """"""","","Sunan al-Kubra al-Nasai 2747","","أَخْبَرَنَا أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ عَنْ بَكْرٍ الْكُوفِيِّ الْقَاضِي عَنْ عِيسَى عَنْ مُحَمَّدٍ عَنِ الْحَكَمِ عَنْ مُوسَى بْنِ طَلْحَةَ عَنِ ابْنِ الْحَوْتَكِيَّةِ قَالَ","The Book of Fasting"
"2748","أنبأ أَبُو دَاوُدَ الْحَرَّانِيُّ ، قَالَ : حَدَّثَنَا عارِمٌ ، قَالَ : حَدَّثَنَا ثَابِتٌ ، قَالَ : حَدَّثَنَا هِلالٌ هُوَ ابْنِ خَبَّابٍ ، عَنْ عَرِيفٍ مِنْ عُرَفَاءِ قُرَيْشٍ ، قَالَ : حَدَّثَنِي أَبِي أَنَّهُ ، سَمِعَ مِنْ خَلْقٍ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ صَامَ رَمَضَانَ وَشَوَّالا وَالأَرْبِعَاءَ وَالْخَمِيسَ دَخَلَ الْجَنَّةَ """"""","Daif|Daif|Daif","Sunan al-Kubra al-Nasai 2748","","أَخْبَرَنَا عَمْرُو بْنُ يَحْيَى بْنِ الْحَارِثِ قَالَ حَدَّثَنَا الْمُعَافَى بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا الْقَاسِمُ بْنُ مَعْنٍ عَنْ طَلْحَةَ بْنِ يَحْيَى بن طَلْحَةَ عَنْ مُوسَى بْنِ طَلْحَةَ","The Book of Fasting"
"2749","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ يَعْقُوبَ ، وَأنا أَحْمَدُ بْنُ يَحْيَى ، قَالا : حَدَّثَنَا أَبُو نُعَيْمٍ ، قَالَ : حَدَّثَنَا هَارُونُ بْنُ سلْمَانَ ، قَالَ : حَدَّثَنِي مُسْلِمُ بْنُ عبَد اللَّهِ الْقُرَشِيُّ ، أَنَّ أَبَاهُ أَخْبَرَهُ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : صُمْ رَمَضَانَ وَالَّذِي يَلِيهِ وَكُلَّ يَوْمِ أَرْبِعَاءَ وَخَمِيسٍ ، فَإِذًا أَنْتَ قَدْ صُمْتَ الدَّهْرَ ""، وَقَالَ إِبْرَاهِيمُ : مُسْلِمُ بْنُ عُبَيْدِ اللَّهِ""","Daif|Daif|Daif","Sunan al-Kubra al-Nasai 2749","","أَخْبَرَنَا مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ ابْنِ عُلَيَّةَ قَالَ حَدَّثَنَا يَعْلَى عَنْ طَلْحَةَ بْنِ يَحْيَى عَنْ مُوسَى بْنِ طَلْحَةَ قَالَ","The Book of Fasting"
"2750","أنبأ عَبْدَةُ بْنُ عَبْدِ اللَّهِ الْبَصْرِيُّ ، قَالَ : أنبأ زَيْدٌ وَهُوَ ابْنُ حُبَابٍ ، قَالَ : حَدَّثَنِي هَارُونُ بْنُ سَلْمَانَ أَبُو مُوسَى مَوْلَى عَمْرِو بْنِ حُرَيْثٍ ، قَالَ : حَدَّثَنِي عُبَيْدُ اللَّهِ بْنُ مُسْلِمٍ الْقُرَشِيُّ ، عَنْ أَبِيهِ ، قَالَ : سَأَلْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِالصِّيَامِ ثَلاثًا ، قَالَ :  صُمْ شَهْرَ رَمَضَانَ وَالَّذِي يَلِيهِ وَيَوْمَ الأَرْبِعَاءِ وَالْخَمِيسِ ، فَإِذًا أَنْتَ صُمْتَ الدَّهْرَ وَأَفْطَرْتَ """"""","","Sunan al-Kubra al-Nasai 2750","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى قَالَ حَدَّثَنَا خَالِدٌ عَنْ شُعْبَةَ أَنبأَنا أَنَسُ بْنُ سِيرِينَ عَنْ رَجُلٍ يُقَالُ لَهُ عَبْدُ الْمَلِكِ يُحَدِّثُ عَنْ أَبِيهِ","The Book of Fasting"
"2751","أنبأ مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى الصَّنْعَانِيُّ الْبَصْرِيُّ ، عَنْ خَالِدٍ ، قَالَ : حدثنا هِشَامٍ ، عَنْ يَحْيَى ، عَنْ عُمَرَ بْنِ الْحَكَمِ بْنِ ثَوْبَانَ ، أَنَّ مَوْلَى قُدَامَةَ بْنِ مَظْعُونٍ حَدَّثَهُ ، أَنَّ مَوْلَى أُسَامَةَ ، قَالَ : كَانَ أُسَامَةُ يَرْكَبُ إِلَى مَالٍ لَهُ بِوَادِي الْقُرَى فَيَصُومُ يَوْمَ الاثْنَيْنِ وَالْخَمِيسِ ، قُلْتُ لَهُ : أَتَصُومُ فِي السَّفَرِ ، وَقَدْ كَبِرْتَ ؟ قَالَ : رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَصُومُ يَوْمَ الاثْنَيْنِ وَالْخَمِيسِ ، قَالَ :  إِنَّ الأَعْمَالَ تُعْرَضُ يَوْمَ الاثْنَيْنِ وَيَوْمَ الْخَمِيسِ "". أنبأ عُبَيْدُ اللَّهِ بْنُ سَعِيدٍ السَّرَخْسِيُّ ، قَالَ : حَدَّثَنَا مُعَاذُ بْنُ هِشَامٍ الدَّسْتُوَائِيُّ ، قَالَ : حَدَّثَنِي أَبِي ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، قَالَ : حَدَّثَنِي عُمَرُ بْنُ عَبْدِ الْحَكَمِ بْنِ ثَوْبَانَ ، أَنَّ مَوْلَى قُدَامَةَ بْنِ مَظْعُونٍ حَدَّثَهُ ، أَنَّ مَوْلَى أُسَامَةَ بْنِ زَيْدٍ حَدَّثَهُ ، أَنَّ أُسَامَةَ كَانَ يَرْكَبُ إِلَى مَالٍ لَهُ وَسَاقَ الْحَدِيثَ . أَخْبَرَنِي عُبَيْدُ اللَّهِ بْنُ فَضَالَةَ ، قَالَ : أنبأ مُحَمَّدُ بْنُ الْمُبَارَكِ الصُّورِيُّ ، قَالَ : حَدَّثَنَا مُعَاوِيَةُ بْنُ سَلامِ بْنِ أَبِي سَلامٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، قَالَ : حَدَّثَنِي مَوْلَى قُدَامَةَ بْنِ مَظْعُونٍ ، أَنَّ مَوْلَى أُسَامَةَ بْنِ زَيْدٍ أَخْبَرَهُ ، أَنَّ أُسَامَةَ بْنَ زَيْدٍ كَانَ يَصُومُ يَوْمَ الاثْنَيْنِ وَيَوْمَ الْخَمِيسِ نَحْوَهُ ، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : أَبُو سَلامٍ اسْمُهُ مَمْطُورٌ""","","Sunan al-Kubra al-Nasai 2751","","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمٍ قَالَ أَخْبَرَنَا حِبَّانُ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ شُعْبَةَ عَنْ أَنَسِ بْنِ سِيرِينَ قَالَ سَمِعْتُ عَبْدَ الْمَلِكِ بْنَ أَبِي الْمِنْهَالِ يُحَدِّثُ عَنْ أَبِيهِ","The Book of Fasting"
"2752","أَخْبَرَنِي مَحْمُودُ بْنُ خَالِدٍ ، قَالَ : حَدَّثَنَا الْوَلِيدُ ، عَنْ أَبِي عَمْرٍو ، عَنْ يَحْيَى عن مَوْلًى لأُسَامَةَ بْنِ زَيْدٍ ، أَنَّ أُسَامَةَ بْنَ زَيْدٍ كَانَيَصُومُ الاثْنَيْنِ وَالْخَمِيسَ وَيُخْبِرُ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَصُومُهُمَا كَذَلِكَ ""","Daif|Daif|Daif","Sunan al-Kubra al-Nasai 2752","","أَخْبَرَنَا مُحَمَّدُ بْنُ مَعْمَرٍ قَالَ حَدَّثَنَا حِبَّانُ البَصْرِيُّ قَالَ حَدَّثَنَا هَمَّامٌ قَالَ حَدَّثَنَا أَنَسُ بْنُ سِيرِينَ قَالَ حَدَّثَنِي عَبْدُ الْمَلِكِ بْنُ قُدَامَةَ بْنِ مِلْحَانَ عَنْ أَبِيهِ قَالَ","The Book of Fasting"
"2753","أنبأ إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ حَبِيبِ بْنِ الشَّهِيدِ الْبَصْرِيُّ قَالَ : حَدَّثَنَا يَحْيَى بْنُ الْيَمَانِ ، عَنْ سُفْيَانَ ، عَنْ عَاصِمٍ ، عَنِ الْمُسَيَّبِ بْنِ رَافِعٍ ، عَنْ سَوَاءٍ الْخُزَاعِيِّ ، عَنْ عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَصُومُ الاثْنَيْنِ وَالْخَمِيسَ """"""","","Sunan al-Kubra al-Nasai 2753","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا سَيْفُ بْنُ عُبَيْدِ اللهِ مِنْ خِيَارِ الْخَلْقِ قَالَ حَدَّثَنَا الْأَسْوَدُ بْنُ شَيْبَانَ عَنْ أَبِي نَوْفَلِ بْنِ أَبِي عَقْرَبٍ عَنْ أَبِيهِ قَالَ","The Book of Fasting"
"2754","أنبأ الْقَاسِمُ بْنُ زَكَرِيَّا ، قَالَ : حَدَّثَنَا حسَيْنٌ ، عَنْ زَائِدَةَ ، عَنْ عَاصِمٍ ، عَنِ الْمُسَيَّبِ ، عَنْ حَفْصَةَ ، قَالَتْ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَصُومُ الاثْنَيْنِ وَالْخَمِيسَ """"""","Sahih Isnaad|Sahih Isnaad|Isnaad Sahih","Sunan al-Kubra al-Nasai 2754","","أَخْبَرَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدِ بْنِ سَلَّامٍ قَالَ حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ قَالَ أَخْبَرَنَا الْأَسْوَدُ بْنُ شَيْبَانَ عَنْ أَبِي نَوْفَلِ بْنِ أَبِي عَقْرَبٍ عَنْ أَبِيهِ","The Book of Fasting"
"2755","أنبأ إِسْمَاعِيلُ بْنُ مَسْعُودٍ الْبَصْرِيُّ ، قَالَ : حدَّثَنَا خَالِدٌ ، عَنِ ابْنِ أَبِي ذِئْبٍ ، عَنْ سَعِيدِ بْنِ عَبْدِ اللَّهِ بْنِ قَارِظٍ ، عَنْ أَبِي عُبَيْدٍ ، قَالَ : شَهِدْتُ عَلِيًّا ، وَعُثْمَانَ فِييَوْمِ النَّحْرِ وَالْفِطْرِ يُصَلِّيَانِ ، ثُمَّ يَنْصَرِفَانِ فَيَذْكُرَانِ النَّاسَ ، وَسَمِعْتُهُمَا يَقُولانِ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ صَوْمِ هَذَيْنِ الْيَوْمَيْنِ """"""","","Sunan al-Kubra al-Nasai 2755","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنِي أَبُو دَاوُدَ قَالَ حَدَّثَنَا شُعْبَةُ قَالَ أَخْبَرَنِي زِيَادُ بْنُ فَيَّاضٍ قَالَ سَمِعْتُ أَبَا عِيَاضٍ يُحَدِّثُ عَنْ عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ","The Book of Fasting"
"2756","أنبأ إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أنبأ سُفْيَانُ ، عَنِ الزُّهْرِيِّ ، عَنْ أَبِي عُبَيْدٍ ، مَوْلَى بْنِ أَزْهَرَ ، قَالَ : شَهِدْتُ الْعِيدَ مَعَ عُمَرَ بْنِ الْخَطَّابِ فَبَدَأَ بِالصَّلاةِ قَبْلَ الْخُطْبَةِ ، ثُمّ قَالَ : إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ صِيَامِ هَذَيْنِ الْيَوْمَيْنِ ، أَمَّا يَوْمُ الْفِطْرِ فَيَوْمُ فِطْرِكُمْ مِنْ صِيَامِكُمْ ، وَأَمَّا يَوْمُ الأَضْحَى فَيَوْمُ نُسُكِكُمْ """"""","","Sunan al-Kubra al-Nasai 2756","","أَخْبَرَنَا عَبْدَةُ بْنُ عَبْدِ اللهِ الصَّفَارُ بَصْرِيٌّ قَالَ حَدَّثَنَا أَبُو دَاوُدَ الْحَفَرِيُّ عَنْ سُفْيَانَ عَنِ الْجُرَيْرِيِّ عَنْ أَبِي السَّلِيلِ عَنْ مُجِيبَةَ الْبَاهِلِيِّ عَنْ عَمِّهِ قَالَ","The Book of Fasting"
"2757","أَخْبَرَنِي مُحَمَّدُ بْنُ قُدَامَةَ الْمِصِّيصِيُّ ، عَنْ جَرِيرٍ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، عَنْ سَهْمٍ ، عَنْ قَزَعَةَ ، عَنْ أَبِي سَعِيدٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا صَوْمَ يَوْمَ عِيدٍ ""ذِكْرُ الاخْتِلافِ عَلَى قَتَادَةَ فِي هَذَا الْحَدِيثِ""","","Sunan al-Kubra al-Nasai 2757","","أَخْبَرَنَا مُحَمَّدُ بْنُ مَنْصُورٍ وَالْحَارِثُ بْنُ مِسْكِينٍ قِرَاءَةً عَلَيْهِ وَاللَّفْظُ لَهُ عَنْ سُفْيَانَ عَنْ عَمْرٍو عَنْ يَحْيَى بْنِ جَعْدَةَ عَنْ عَبْدِ اللهِ بْنِ عَمْرٍو الْقَارِي قَالَ سَمِعْتُ أَبَا هُرَيْرَةَ يَقُولُ «§مَا أَنَا نَهَيْتُ","The Book of Fasting"
"2758","أنبأ مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ : حَدَّثَنَا ابْنُ َبِي عَدِيٍّ ، عَنْ سَعِيدٍ ، عَنْ قَتَادَةَ ، عَنْ قَزَعَةَ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ،  أَنَّ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ صَوْمِ يَوْمِ الْفِطْرِ وَيَوْمِ النَّحْرِ """"""","","Sunan al-Kubra al-Nasai 2758","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ عَبْدِ الْحَمِيدِ بْنِ جُبَيْرِ بْنِ شَيْبَةَ عَنْ مُحَمَّدِ بْنِ عَبَّادٍ قَالَ","The Book of Fasting"
"2759","أنبأ عُبَيْدُ اللَّهِ بْنُ سَعِيدٍ ، قَالَ : أنبأ مُعَاذُ بْنُ هِشَامٍ ، قَالَ : حَدَّثَنِي أَبِي ، عَنْ قَتَادَةَ ، عَنْ قَزَعَةَ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ :  نَهَى نَبِيُّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْصَوْمِ يَوْمِ الْفِطْرِ وَيَوْمِ النَّحْرِ """"""","","Sunan al-Kubra al-Nasai 2759","","أَخْبَرَنَا يُوسُفُ بْنُ سَعِيدٍ الْمِصِّيصِيُّ قَالَ حَدَّثَنَا حَجَّاجٌ عَنِ ابْنِ جُرَيْجٍ قَالَ أَخْبَرَنِي عَبْدُ الْحَمِيدِ بْنُ جُبَيْرِ بْنِ شَيْبَةَ أَنَّهُ سَمِعَ مُحَمَّدَ بْنَ عَبَّادِ بْنِ جَعْفَرٍ أَنَّهُ سَأَلَ جَابِرَ بْنَ عَبْدِ اللهِ وَهُوَ يَطُوفُ بِالْبَيْتِ","The Book of Fasting"
"2760","أنبأ عِمْرَانُ بْنُ مُوسَى ، قَالَ : حَدَّثَنَا يَزِيدُ هُوَ ابْنُ زُرَيْعٍ ، قَالَ : حَدَّثَنَا هِشَامٌ ، قَالَ : حَدَّثَنَا قَتَادَةُ ، عَنْ قَزَعَةَ ، عَنْ أَبِي سَعِيدٍ ، قَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْصَوْمِ يَوْمَيْنِ : صَوْمِ يَوْمِ النَّحْرِ وَيَوْمِ الْفِطْرِ """"""","","Sunan al-Kubra al-Nasai 2760","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا يَحْيَى قَالَ حَدَّثَنَا ابْنُ جُرَيْجٍ قَالَ أَخْبَرَنِي مُحَمَّدُ بْنُ عَبَّادِ بْنِ جَعْفَرٍ قَالَ قُلْتُ لِجَابِرٍ","The Book of Fasting"
"2761","أنبأ زَكَرِيَّا بْنُ يَحْيَى ، قَالَ : حَدَّثَنَا عَبْدُ الأَعْلَى ، قَالَ : حَدَّثَنَا حَمَّادٌ ، عَنْ قَتَادَةَ ، عَنْ أَبِي نَضْرَةَ ، وَعَنْ بِشْرِ بْنِ حَرْبٍ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ صَوْمِ يَوْمِ الْفِطْرِ وَيَوْمِ النَّحْرِ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : بِشْرُ بْنُ حَرْبٍ ضَعِيفٌ ، وَإِنَّمَا أَخْرَجْنَاهُ لِعِلَّةِ الْحَدِيثِ وَالصَّوَابُ حَدِيثُ سَعِيدٍ ، وَهِشَامٍ ، وَاللَّهُ أَعْلَمُ""","","Sunan al-Kubra al-Nasai 2761","","أَخْبَرَنَا سُلَيْمَانُ بْنُ سَلْمٍ الْبَلْخِيُّ قَالَ حَدَّثَنَا النَّضْرُ بْنُ شُميلٍ قَالَ حَدَّثَنَا ابْنُ جُرَيْجٍ عَنْ مُحَمَّدِ بْنِ عَبَّادٍ أَنَّ جَابِرًا سُئِلَ عَنْ صَوْمِ يَوْمِ الْجُمُعَةِ فَقَالَ","The Book of Fasting"
"2762","أنبأ مُحَمَّدُ بْنُ سَلَمَةَ ، وَالْحَارِثُ بْنُ مِسْكِينٍ قِرَاءَةً عَلَيْهِ وَأَنَا أَسْمَعُ وَاللَّفْظُ لَهُ ، عَنِ ابْنِ الْقَاسِمِ ، حَدَّثَنِي مَالِكٌ ، عَنْ مُحَمَّدِ بْنِ يَحْيَى بْنِ حِبَّانَ ، عَنِ الأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ،  أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ صِيَامِ يَوْمَيْنِ يَوْمِ الْفِطْرِ وَيَوْمِ الأَضْحَى """"""","","Sunan al-Kubra al-Nasai 2762","","أَخْبَرَنَا أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ قَالَ حَدَّثَنَا أَبُو نُعَيْمٍ قَالَ حَدَّثَنَا حَفْصٌ عَنِ ابْنِ جُرَيْجٍ عَنْ مُحَمَّدِ بْنِ عَبَّادِ بْنِ جَعْفَرٍ عَنْ جَابِرٍ قَالَ","The Book of Fasting"
"2763","أنبأ عُبَيْدُ اللَّهِ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا يحْيَى ، عَنْ سُفْيَانَ ، قَالَ : حَدَّثَنِي مَنْصُورٌ ، عَنْ مُجَاهِدٍ ، عَنْ إِيَاسِ بْنِ حَرْمَلَةَ ، عَنْ أَبِي قَتَادَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : صَوْمُ عَاشُورَاءَ يُكَفِّرُ السَّنَةَ الْمَاضِيَةَ ، وَصَوْمُ عَرَفَةَ يُكَفِّرُ سَّنَتَيْنِ الْمَاضِيَةَ وَالْمُسْتَقَبَلَةَ "". أنبأ مَحْمُودُ بْنُ غَيْلانَ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، قال : حَدَّثَنَا سُفْيَانُ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاهِدٍ ، عَنْ حَرْمَلَةَ بْنِ إِيَاسٍ ، عَنْ أَبِي قَتَادَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : بِنَحْوِهِ . أنبأ عِيسَى بْنُ مُحَمَّدٍ الرَّمْلِيُّ أَبُو عُمَيْرٍ ، قَالَ : حَدَّثَنَا الْفِرْيَابِيُّ ، عَنْ سُفْيَانَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِي الْخَلِيلِ ، عَنْ حَرْمَلَةَ بْنِ إِيَاسٍ ، عَنْ أَبِي قَتَادَةَ ، عَن ِالنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ . أنا مَحْمُودُ بْنُ غَيْلانَ ، قَالَ : حَدَّثَنَا أَبُو دَاوُدَ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ مَنْصُورٍ ، عَنْ أَبِي الْخَلِيلِ ، عَنْ حَرْمَلَةَ ، عَنْ مَوْلًى لأَبِي قَتَادَةَ ، قَالَ : وَحَدَّثَنَا مُعَاوِيَةُ ، عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ أَبِي الْخَلِيلِ ، عَنْ حَرْمَلَةَ بْنِ إِيَاسٍ ، عَنْ مَوْلًى لأَبِي قَتَادَةَ ، عَنْ أَبِي قَتَادَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ""","","Sunan al-Kubra al-Nasai 2763","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى قَالَ حَدَّثَنَا خَالِدٌ قَالَ حَدَّثَنَا مَسْتُورٌ قَالَ حَدَّثَنَا فُلَانُ بْنُ جَعْفَرٍ الْمَخْزُومِيِّ أَنَّ رَجُلًا لَقِيَ أَبَا هُرَيْرَةَ وَهُوَ يَطُوفُ الْبَيْتَ قَالَ أَنْتَ نَهَيْتَ النَّاسَ عَنْ صَوْمِ الْجُمُعَةِ؟ قَالَ","The Book of Fasting"
"2764","أنبأ مُوسَى بْنُ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ الْكُوفِيُّ ، قالَ : حَدَّثَنَا حُسَيْنُ بْنُ عَلِيٍّ الْجُعْفِيُّ ، عَنْ زَائِدَةَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِي الْخَلِيلِ ، عَنْ إِيَاسِ بْنِ حَرْمَلَةَ السَّدُوسِيِّ ، عَنْ أَبِي قَتَادَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : صَوْمُ يَوْمِ عَرَفَةَ كَفَّارَةُ سَنَتَيْنِ سَنَةٍ قَبْلَهُ وَسَنَةٍ بَعْدَهُ ، وَصَوْمُ يَوْمِ عَاشُورَاءَ كَفَّارَةُ سَنَةٍ """"""","","Sunan al-Kubra al-Nasai 2764","","أَخْبَرَنَا الْقَاسِمُ بْنُ زَكَرِيَّا بْنِ دِينَارٍ الْكُوفِيُّ قَالَ حَدَّثَنَا حُسَيْنٌ الْجُعْفِيُّ عَنْ زَائِدَةَ عَنْ هِشَامٍ عَنِ ابْنِ سِيرِينَ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Fasting"
"2765","أنبأ الْقَاسِمُ بْنُ زَكَرِيَّا ، قَالَ : حَدَّثَنَا إسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ شَرِيكٍ ، عَنْ مَنْصُورٍ ، قَالَ : ذَهَبْتُ أنا ، وَمُجَاهِدٌ ، إِلَى أَبِي الْخَلِيلِ فَذَكَرَ ، عَنْ أَبِي قَتَادَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : صِيَامُ عَرَفَةَ كَفَّارَةُ سَنَةٍ قَبْلَهُ وَسَنَةٍ بَعْدَهُ """"""","","Sunan al-Kubra al-Nasai 2765","","أَخْبَرَنَا أَبُو بَكْرِ بْنُ عَلِيٍّ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللهِ الْمَخْرَمِيُّ قَالَ حَدَّثَنَا الْأَسْوَدُ بْنُ عَامِرٍ قَالَ حَدَّثَنَا إِسْرَائِيلُ عَنْ عَاصِمٍ عَنْ مُحَمَّدِ بْنِ سِيرِينَ عَنْ أَبِي الدَّرْدَاءِ قَالَ","The Book of Fasting"
"2766","أنا مُحَمَّدُ بْنُ الْمُصَفَّى ، قَالَ : حَدَّثَنَا مُعَاوِيَةُ بْنُ حَفْصٍ ، عَنِ الْحَكَمِ بْنِ هِشَامٍ ، عَنْ قَتَادَةَ ، عَنْ أَبِي الْخَلِيلِ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي قَتَادَةَ ، عَنْ أَبِيهِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : صَوْمُ عَرَفَةَ كَفَّارَةُ سَنَتَيْنِ سَنَةٍ مَاضِيَةٍ وَسَنَةٍ مُسْتَقْبِلَةٍ ، وَصَوْمُ عَاشُورَاءَ كَفَّارَةُ سَنَةٍ """"""","","Sunan al-Kubra al-Nasai 2766","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا بِشْرٌ قَالَ حَدَّثَنَا سَعِيدٌ عَنْ قَتَادَةَ عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ عَنْ عَبْدِ اللهِ بْنِ عَمْرٍو","The Book of Fasting"
"2767","أنبأ مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ يَزِيدَ الْمُقْرِئُ ، قَالَ : أنبأ سُفْيَانُ ، عَنْ دَاوُدَ ، عَنْ أَبُو قَزَعَةَ ، عَنْ أَبِي الْخَلِيلِ ، عَنْ أَبِي حَرْمَلَةَ ، عَنْ أَبِي قَتَادَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : صَوْمُ يَوْمِ عَاشُورَاءَ يُكَفِّرُ السَّنَةَ ، وَصَوْمُ يَوْمِ عَرَفَةَ يُكَفِّرُ السَّنَةَ وَالَّتِي تَلِيهَا "". أنبأ مَسْعُودُ بْنُ جُوَيْرِيَةَ الْمُوصِلِيُّ ، وَالْحَسَنُ بْنُ عِيسَى ، وَهَارُونُ بْنُ عَبْدِ اللَّهِ ، قَالُوا : أنبأ سُفْيَانُ ، عَنْ دَاوُدَ بْنِ شَابُورٍ ، عَنْ أَبِي قَزَعَةَ ، عَنْ أَبِي الْخَلِيلِ ، عَنْ أَبِي حَرْمَلَةَ ، عَنْ أَبِي قَتَادَةَ ، نَحْوَهُ ، قَالَ هَارُونُ فِي حَدِيثِهِ : سَمِعْنَاهُ مِنْ دَاوُدَ""","","Sunan al-Kubra al-Nasai 2767","","أَخْبَرَنَا إِبْرَاهِيمُ بْنُ مُحَمَّدٍ يَعْنِي التَّيْمِيَّ قَالَ حَدَّثَنَا يَحْيَى عَنْ شُعْبَةَ عَنْ قَتَادَةَ عَنْ أَبِي أَيُّوبَ عَنْ جُوَيْرِيَةَ قَالَتْ","The Book of Fasting"
"2768","أَخْبَرَنِي مُحَمَّدُ بْنُ عُبَيْدِ اللَّهِ ، قَالَ : حَدَّثَنِي الْحَسَنُ بْنُ بِشْرٍ ، قَالَ : حَدَّثَنَا زُهَيْرٌ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ أَبِي الْخَلِيلِ ، عَنْ أَبِي حَرْمَلَةَ ، عَنْ أَبِي قَتَادَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : صَوْمُ عَاشُورَاءَ كَفَّارَةُ سَنَةٍ ، وَصَوْمُ عَرَفَةَ كَفَّارَةُ سَنَتَيْنِ مَاضِيَةٍ وَمُسْتَقْبَلَةٍ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : الْحَسَنُ بْنُ بِشْرٍ لَيْسَ عِنْدَنَا بِالْقَوِيِّ فِي الْحَدِيثِ""","","Sunan al-Kubra al-Nasai 2768","","أَخْبَرَنَا الْقَاسِمُ بْنُ زَكَرِيَّا قَالَ حَدَّثَنَا حُسَيْنٌ عَنْ زَائِدَةَ عَنْ هِشَامٍ عَنِ ابْنِ سِيرِينَ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Fasting"
"2769","أنبأ مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ يَزِيدَ ، عَنْ أَبِيهِ ، قَالَ : حَدَّثَنَا هَمَّامٌ ، عَنْ قَتَادَةَ ، قَالَ : حَدَّثَنِي أَبُو الْخَلِيلِ ، عَنْ حَرْمَلَةَ بْنِ إِيَاسٍ ، عَنْ أَبِي قَتَادَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : يَعْدِلُ صَوْمُ يَوْمِ عَرَفَةَ سَنَتَيْنِ ، وَصَوْمُ يَوْمِ عَاشُورَاءَ يَعْدِلُ سَنَةً "". أنبأ عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا أَبُو دَاوُدَ ، قَالَ : حَدَّثَنَا هَمَّامٌ ، قَالَ : قَالَ لِي عَطَاءٌ : يَا هَمْامُ ، هَذَا حَدِيثٌ جَاءَنَا مَنْ ، قِبَلِكُمْ ، حَدَّثَنِي صَالِحٌ أَبُو الْخَلِيلِ ، عَنْ حَرْمَلَةَ بْنِ إِيَاسٍ ، عَنْ أَبِي قَتَادَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، نَحْوَهُ""","","Sunan al-Kubra al-Nasai 2769","","أَخْبَرَنَا أَحْمَدُ بْنُ حَرْبٍ قَالَ حَدَّثَنَا أَبُو مُعَاوِيَةَ عَنِ الْأَعْمَشِ عَنْ أَبِي صَالِحٍ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Fasting"
"2770","أنبأ حَاجِبُ بْنُ سُلَيْمَانَ الْمَنْبِجِيُّ ، عَنْ وكِيعٍ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنْ عَطَاءِ عَنِ أَبِي الْخَلِيلِ ، عَنْ أَبِي قَتَادَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : صَوْمُ عَاشُورَاءَ كَفَّارَةُ سَنَةٍ ، وَصَوْمُ عَرَفَةَ كَفَّارَةُ سَنَتَيْنِ : مَاضِيَةٍ وَمُسْتَقْبَلَةٍ "". أنبأ عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدِ بْنِ سَلامٍ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ رَبِيعَةَ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنْ عَطَاءٍ ، عَنْ أَبِي الْخَلِيلِ ، عَنْ أَبِي قَتَادَةَ ، نَحْوَهُ . أَخْبَرَنِي إِبْرَاهِيمُ بْنُ الْحَسَنِ الْمِصِّيصِيُّ ، قَالَ : حَدَّثَنَا حَجَّاجٌ ، عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَطَاءٌ ، عَنْ أَبِي الْخَلِيلِ ، عَنْ أَبِي قَتَادَةَ قَوْلَهُ . أنبأ هِلالُ بْنُ الْعَلاءِ بْنِ هِلالٍ ، قَالَ : حَدَّثَنَا أَبِي ، قَالَ : حَدَّثَنَا عُبَيْدُ اللَّهِ ، عَنْ عَبْدِ الْكَرِيمِ ، عَنْ عَطَاءٍ ، عَنْ كَعْبٍ نَحْوَهُ""","","Sunan al-Kubra al-Nasai 2770","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ مَنْصُورٍ عَنْ مُجَاهِدٍ عَنْ أَبِي هُرَيْرَةَ أَنَّهُ قَالَ «§لَا يَصُمْ أَحَدُكُمْ يَوْمَ الْجُمُعَةِ إِلَّا","The Book of Fasting"
"2771","أنبأ مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ غَيْلانَ بْنِ جَرِيرٍ ، سَمِعَ عَبْدَ اللَّهِ بْنَ مَعْبَدٍ ، عَنْ أَبِي قَتَادَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سُئِلَ عَنْصَوْمِ يَوْمِ عَرَفَةَ ، قَالَ :  يُكَفِّرُ السَّنَةَ الْمَاضِيَةَ وَالْبَاقِيَةَ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : هَذَا أَجْوَدُ حَدِيثٍ فِي هَذَا الْبَابِ عِنْدِي ، وَاللَّهُ أَعْلَمُ""","","Sunan al-Kubra al-Nasai 2771","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا أَبُو دَاوُدَ قَالَ حَدَّثَنَا شَيْبَانُ عَنْ عَاصِمٍ عَنْ زِرٍّ عَنِ ابْنِ مَسْعُودٍ","The Book of Fasting"
"2772","أنبأ عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْمِسْوَرِ الزُّهْرِيُّ الْبَصْرِيُّ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ أَيُّوبَ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ : أَتَيْتُ ابْنَ عَبَّاسٍيَوْمَ عَرَفَةَ فَوَجَدْتُهُ يَأْكُلُ رُمَّانًا ، فَقَالَ :  ادْنُ فَكُلْ ، لَعَلَّكَ صَائِمٌ ، إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمْ يَصُمْ هَذَا الْيَوْمَ """"""","","Sunan al-Kubra al-Nasai 2772","","أَخْبَرَنَا حُسَيْنُ بْنُ مَنْصُورٍ قَالَ حَدَّثَنَا مُبَشِّرُ بْنُ إِسْمَاعِيلَ قَالَ حَدَّثَنَا حَسَّانُ بْنُ نُوحٍ عَنْ عَبْدِ اللهِ بْنِ بُسْرٍ","The Book of Fasting"
"2773","أنبأ أَحْمَدُ بْنُ حَرْبٍ الْمُوصِلِيُّ أَخُو عَلِيِّ بْنِ حَرْبٍ ، قَالَ : حَدَّثَنَا ابْنُ عُلَيَّةَ ، عَنْ أَيُّوبَ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ : أَتَيْتُ ابْنَ عَبَّاسٍ بِعَرَفَةَ وَهُوَ يَأْكُلُ رُمَّانًا وَقَالَ : أَفْطَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِعَرَفَةَ ، فَبَعَثَتْ أُمُّ الْفَضْلِ بِلَبَنٍ فَشَرِبَهُ """"""","","Sunan al-Kubra al-Nasai 2773","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا اللَّيْثُ عَنْ مُعَاوِيَةَ بْنِ صَالِحٍ عَنِ ابْنِ عَبْدِ اللهِ بْنِ بُسرٍ عَنْ أَبِيهِ عَنْ عَمَّتِهِ الصَّمَّاءِ أُخْتِ بُسرٍ قَالَتْ","The Book of Fasting"
"2774","أَخْبَرَنِي زِيَادُ بْنُ أَيُّوبَ دَلُّوَيْهِ ، قَالَ : حدَّثَنَا إِسْمَاعِيلُ ، قَالَ : حَدَّثَنَا أَيُّوبُ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَفْطَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِعَرَفَةَ ، وَبَعَثَتْ إِلَيْهِ أُمُّ الْفَضْلِ بِلَبَنٍ فَشَرِبَهُ """"""","","Sunan al-Kubra al-Nasai 2774","","أَخْبَرَنَا عَلِيُّ بْنُ خَشْرَمٍ قَالَ أَخْبَرَنَا عِيسَى عَنْ ثَوْرٍ عَنْ خَالِدِ بْنِ مَعْدَانَ عَنْ عَبْدِ اللهِ بْنِ بُسْرٍ قَالَ","The Book of Fasting"
"2775","أَخْبَرَنِي أَبُو بَكْرِ بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا الْقَوَارِيرِيُّ ، قَالَ : حَدَّثَنَا حَمَّادٌ ، عَنْ أَيُّوبَ ، عَنْ عِكْرِمَةَ ، أَنَّ ابْنَ عَبَّاسٍ أَفْطَرَ بِعَرَفَةَ أُتِيَ بِرُمَّانٍ فَأَكَلَ قَالَ : وَحَدَّثَتْنِي أُمُّ الْفَضْلِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَفْطَرَ بِعَرَفَةَ أَتَتْهُ بِلَبَنٍ فَشَرِبَهُ """"""","","Sunan al-Kubra al-Nasai 2775","","أَخْبَرَنِي مُحَمَّدُ بْنُ إِسْمَاعِيلَ قَالَ حَدَّثَنَا يَزِيدُ قَالَ أَخْبَرَنَا أَصْبَغُ هُوَ ابْنُ زَيْدٍ عَنْ ثَوْرٍ عَنْ خَالِدِ بْنِ مَعْدَانَ قَالَ حَدَّثَنِي عَبْدُ اللهِ بْنُ بُسرٍ أَنَّ أُخْتَهُ يُقَالُ لَهَا الصَّمَّاءُ حَدَّثَتْهُ","The Book of Fasting"
"2776","أنبأ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا حَمَّادٌ ، عَنْ أَيُّوبَ ، عَنْ عِكْرِمَةَ ،  أَنَّ ابْنَ عَبَّاسٍأَفْطَرَ بِعَرَفَةَ وَأُتِيَ بِرُمَّانٍ فَأَكَلَهُ """"""","","Sunan al-Kubra al-Nasai 2776","","أَخْبَرَنَا حُمَيْدُ بْنُ مَسْعَدَةَ عَنْ سُفْيَانَ بْنِ حَبِيبٍ عَنْ ثَوْرٍ عَنْ خَالِدِ بْنِ مَعْدَانَ ثُمَّ ذَكَرَ كَلِمَةً مَعْنَاهَا عَنْ عَبْدِ اللهِ بْنِ بُسْرٍ عَنْ أُخْتِهِ","The Book of Fasting"
"2777","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ يَعْقُوبَ ، قَالَ : حَدَّثَنَا أحَمَّدُ بْنُ عِيسَى ، عَنْ حَمَّادِ بْنِ زَيْدٍ ، عَنْ أَيُّوبَ ، عَنْ عِكْرِمَةَ ، وَسَعِيدٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّهُ أَفْطَرَ بِعَرَفَةَ أُتِيَ بِرُمَّانٍ فَأَكَلَهُ فَقَالَ : حَدَّثَتْنِي أُمُّ الْفَضْلِ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَفْطَرَ بِعَرَفَةَ ، أُتِيَ بِلَبَنٍ فَشَرِبَهُ ""أَخْبَرَنِي إِبْرَاهِيمُ بْنُ يَعْقُوبَ الْجَوْزَجَانِيُّ ، قَالَ : حَدَّثَنَا أَبُو النُّعْمَانِ ، وَسُلَيْمَانُ بْنُ حَرْبٍ ، قَالا : حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ ، عَنْ أَيُّوبَ ، عَنْ عِكْرِمَةَ ، أَنَّ ابْنَ عَبَّاسٍ ، مِثْلَهُ سَوَاءً""","","Sunan al-Kubra al-Nasai 2777","","أَخْبَرَنَا نُصَيْرُ بْنُ الْفَرَجِ كُتِبَتْ عَنْهُ بِالثَّغْرِ وَيُكْنَى أَبَا حَمْزَةَ ثِقَةٌ قَالَ حَدَّثَنَا عَبْدُ الْمَلِكِ بْنُ الصَّبَّاحِ قَالَ حَدَّثَنَا ثَوْرٌ عَنْ خَالِدٍ هُوَ ابْنُ مَعْدَانَ عَنْ عَبْدِ اللهِ بْنِ بُسْرٍ عَنْ أُخْتِهِ","The Book of Fasting"
"2778","أنبأ يَعْقُوبُ بْنُ إِبْرَاهِيمَ ، قَالَ : حَدَّثَنَا يَحْيَى ، عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَطَاءٌ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّهُ دَعَا أَخَاهُ عُبَيْدَ اللَّهِيَوْمَ عَرَفَةَ إِلَى طَعَامٍ ، فَقَالَ : إِنِّي صَائِمٌ ، فَقَالَ : إِنَّكُمْ أَهْلُ بَيْتٍ يُقْتَدَى بِكُمْ ، رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  أُتِيَ بِحِلابٍ بِلَبَنٍ فِي هَذَا الْيَوْمِ فَشَرِبَ """"""","","Sunan al-Kubra al-Nasai 2778","","أَخْبَرَنَا سَعِيدُ بْنُ عَمْرٍو قَالَ حَدَّثَنَا بَقِيَّةُ قَالَ حَدَّثَنَا ثَوْرٌ عَنْ خَالِدِ بْنِ مَعْدَانَ عَنْ عَبْدِ اللهِ بْنِ بُسرٍ عَنْ عَمَّتِهِ الصَّمَّاءِ","The Book of Fasting"
"2779","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ الْحَسَنِ ، قَالَ : حَدَّثَنَا حجَّاجٌ ، قَالَ ابْنُ جُرَيْجٍ : قَالَ عَطَاءٌ : دَعَا عَبْدُ اللَّهِ بْنُ عَبَّاسٍ ، الْفَضْلَ بْنَ عَبَّاسٍ ، يَوْمَ عَرَفَةَ إِلَى الطَّعَامِ ، فَقَالَ : إِنِّي صَائِمٌ ، فَقَالَ عَبْدُ اللَّهِ لا تَصُمْ ، فَإِنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قُرِّبَ إِلَيْهِ حِلابُ فِيهِ لَبَنٍ يَوْمَ عَرَفَةَ فَشَرِبَ مِنْهُ ""، فَلا تَصُمْ فَإِنَّ النَّاسَ يَسْتَنُّونَ بِكُمْ""","","Sunan al-Kubra al-Nasai 2779","","أَخْبَرَنَا عَمْرُو بْنُ عُثْمَانَ قَالَ حَدَّثَنَا بَقِيَّةُ قَالَ حَدَّثَنِي الزُّبَيْدِيُّ قَالَ حَدَّثَنَا لُقْمَانُ بْنُ عَامِرٍ عَنْ عَامِرِ بْنِ جَشِيبٍ عَنْ خَالِدِ بْنِ مَعْدَانَ عَنْ عَبْدِ اللهِ بْنِ بُسْرٍ","The Book of Fasting"
"2780","أنبأ إِسْحَاقُ بْنُ مَنْصُورٍ الْكَوْسَجُ مَرْوَزِيٌّ ، قَالَ : نبأ عَبْدُ الرَّحْمَنِ ، عَنْ شُعْبَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ أَبِي السَّوْدَاءِ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ ،  عَنْصَوْمِ يَوْمِ عَرَفَةَ فَنَهَانِي """"""","","Sunan al-Kubra al-Nasai 2780","","أَخْبَرَنَا عِمْرَانُ بْنُ بَكَّارٍ قَالَ حَدَّثَنَا الرَّبِيعُ بْنُ رَوْحٍ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ حَرْبٍ قَالَ حَدَّثَنَا الزُّبَيْدِيُّ عَنِ الْفُضَيْلِ بْنِ فَضَالَةَ عَنْ عَبْدِ اللهِ بْنِ بِشْرٍ عَنْ خَالَتِهِ الصَّمَّاءِ قَالَتْ","The Book of Fasting"
"2781","أنبأ عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، وَشُعْبَةُ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ عَطَاءٍ ، عَنْ عُبَيْدٍ بْنِ عُمَيْرٍ ،  أَنَّ عُمَرَ كَانَيَنْهَى عَنْ صِيَامِ يَوْمِ عَرَفَةَ """"""","","Sunan al-Kubra al-Nasai 2781","","أَخْبَرَنَا عِمْرَانُ قَالَ حَدَّثَنَا أَبُو تَقِيٍّ قَالَ حَدَّثَنَا ابْنُ سَالِمٍ عَنِ الزُّبَيْدِيِّ قَالَ حَدَّثَنَا الْفُضَيْلُ بْنُ فَضَالَةَ أَنَّ خَالِدَ بْنِ مَعْدَانَ حَدَّثَهُ أَنَّ عَبْدَ اللهَ بْنَ بُسْرٍ حَدَّثَهُ أَنَّهُ سَمِعَ أَبَاهُ","The Book of Fasting"
"2782","أنبأ أَحْمَدُ بْنُ عُثْمَانَ أَبُو الْجَوْزَاءِ بَصْرِيٌّ ، قَالَ : حَدَّثَنَا الْمُؤَمِّلُ بْنُ إِسْمَاعِيلَ كَثِيرُ الْخَطَأِ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ ، عَنْ نَافِعٍ ، قَالَ : سُئِلَ ابْنُ عُمَرَ عَنْصَوْمِ يَوْمِ عَرَفَةَ بِعَرَفَةَ ، قَالَ : لَمْ يَصُمْهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَلا أَبُو بَكْرٍ ، وَلا عُمَرُ ، وَلا عُثْمَانُ ""","","Sunan al-Kubra al-Nasai 2782","","","The Book of Fasting"
"2783","أنبأ عَلِيُّ بْنُ حُجْرٍ ، قَالَ : أنبأ سُفْيَانُ ، وَإِسْمَاعِيلُ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ أَبِيهِ ، عَنِ ابْنِ عُمَرَ سُئِلَ عَنْصَوْمِ يَوْمِ عَرَفَةَ ، فَقَالَ : حَجَجْتُ مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَلَمْ يَصُمْهُ ""","","Sunan al-Kubra al-Nasai 2783","","أَخْبَرَنَا عِمْرَانُ بْنُ بَكَّارٍ قَالَ حَدَّثَنَا يَزِيدُ بْنُ عَبْدِ رَبِّهِ قَالَ حَدَّثَنَا بَقِيَّةُ عَنِ الزُّبَيْدِيِّ عَنْ عَامِرِ بْنِ جَشِيبٍ عَنْ خَالِدِ بْنِ مَعْدَانَ عَنْ عَبْدِ اللهِ بْنِ بُسْرٍ","The Book of Fasting"
"2784","أنبأ مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حَدَّثَنَا خالِدٌ ، عَنْ شُعْبَةَ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ أَبِيهِ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عُمَرَ أَنَّهُ سُئِلَ عَنْصَوْمِ يَوْمِ عَرَفَةَ ، فَقَالَ :  حَجَجْتُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَلَمْ يَصُمْهُ ، وَمَعَ أَبِي بَكْرٍ فَلَمْ يَصُمْهُ ، وَمَعَ عُمَرَ فَلَمْ يَصُمْهُ ، وَمَعَ عُثْمَانَ فَلَمْ يَصُمْهُ ، وَأَنَا لا أَصُومُهُ ، وَلا آمُرُكَ وَلا أَنْهَاكَ عَنْهُ ، إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَلا تَصُمْ """"""","","Sunan al-Kubra al-Nasai 2784","","أَخْبَرَنِي مُحَمَّدُ بْنُ وَهْبٍ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ سَلَمَةَ قَالَ حَدَّثَنِي أَبُو عَبْدِ الرَّحِيمِ عَنِ الْعَلَاءِ عَنْ دَاوُدَ بْنِ عُبَيْدِ اللهِ عَنْ خَالِدِ بْنِ مَعْدَانَ عَنْ عَبْدِ اللهِ بْنِ بُسرٍ عَنْ أُخْتِهِ الصَّمَّاءِ عَنْ عَائِشَةَ","The Book of Fasting"
"2785","أنبأ مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حَدَّثَنَا الْمُعْتَمِرُ ، قَالَ : قَرَأْتُ عَلَى فُضَيْلٍ ، عَنْ أَبِي حُرِيزٍ ، أَنَّهُ سَمِعَ سَعِيدَ بْنَ جُبَيْرٍ ، يَقُولُ : سَأَلَ رَجُلٌ عَبْدَ اللَّهِ بْنَ عُمَرَ عَنْصَوْمِ يَوْمِ عَرَفَةَ ، قَالَ :  كُنَّا وَنَحْنُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَعْدِلُهُ بِصَوْمِ سَنَةٍ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : أَبُو جَرِيرٍ لَيْسَ بِالْقَوِيِّ ، وَاسْمُهُ عَبْدُ اللَّهِ بْنُ حُسَيْنٍ قَاضِي سِجِسْتَانَ ، وَهَذَا حَدِيثٌ مُنْكَرٌ""","","Sunan al-Kubra al-Nasai 2785","","أَخْبَرَنَا أَحْمَدُ بْنُ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ عَنْ إِسْحَاقَ بْنِ إِبْرَاهِيمَ قَالَ حَدَّثَنَا مُعَاوِيَةُ بْنُ يَحْيَى أَبُو مُطِيعٍ قَالَ حَدَّثَنِي أَرْطَاةُ قَالَ سَمِعْتُ أَبَا عَامِرٍ قَالَ","The Book of Fasting"
"2786","أنبأ الْقَاسِمُ بْنُ زَكَرِيَّا بْنِ دِينَارٍ ، قَالَ : حدَّثَنَا زَيْدٌ ، قَالَ : حَدَّثَنِي مُوسَى بْنُ عَلِيٍّ ، قَالَ : سَمِعْتُ أَبِي ، يَقُولُ : سَمِعْتُ عُقْبَةَ بْنَ عَامِرٍ ، يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : يَوْمُ عَرَفَةَ ، وَيَوْمُ النَّحْرِ ، وَثَلاثَةُ أَيَّامِ التَّشْرِيقِ عِنْدَ أَهْلِ الإِسْلامِ هُنَّ أَكْلٌ وَشُرْبٌ """"""","","Sunan al-Kubra al-Nasai 2786","","أَخْبَرَنَا الرَّبِيعُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا ابْنُ وَهْبٍ قَالَ حَدَّثَنِي اللَّيْثُ بْنُ سَعْدٍ وَذَكَرَ آخَرَ قَبْلَهُ عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ عَنْ أَبِي الْخَيْرِ عَنْ حُذَيْفَةَ الْبَارِقِيِّ","The Book of Fasting"
"2787","أنبأ سُلَيْمَانُ بْنُ مَعْبَدٍ الْمَرْوَزِيُّ ، قَالَ : حدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ ، قَالَ : حَدَّثَنَا حَوْشَبُ بْنُ عُقَيْلٍ ، عَنْ مَهْدِيٍّ الْهَجَرِيِّ ، عَنْ عِكْرِمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْصَوْمِ يَوْمِ عَرَفَةَ بِعَرَفَةَ """"""","","Sunan al-Kubra al-Nasai 2787","","","The Book of Fasting"
"2788","أنبأ عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ ، قَالَ : حَدَّثَنَا حَوْشَبُ بْنُ عُقَيْلٍ ، عَنْ مَهْدِيٍّ الْعبدِيِّ ، قَالَ : حَدَّثَنِي وَذَكَرَ عِكْرِمَةَ ، قَالَ : دَخَلْتُ عَلَى أَبِي هُرَيْرَةَ ، فَسَأَلْتُهُ عَنْ صَوْمِ عَرَفَةَ بِعَرَفَاتٍ ، فَقَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْصَوْمِ يَوْمِ عَرَفَةَ بِعَرَفَاتٍ """"""","","Sunan al-Kubra al-Nasai 2788","","أَخْبَرَنَا كَثِيرُ بْنُ عُبَيْدٍ الْحِمْصِيُّ قَالَ حَدَّثَنَا بَقِيَّةُ بْنُ الْوَلِيدِ عَنْ عَبْدِ اللهِ بْنِ الْمُبَارَكِ عَنْ عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عُمَرَ وَهُوَ ابْنُ عَلِيٍّ عَنْ أَبِيهِ عَنْ كُرَيْبٍ","The Book of Fasting"
"2789","أنبأ إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : أنبأ عَبْدُ الرَّحْمَنِ ، قَالَ : حَدَّثَنَا حَوْشَبُ ، وَشُعْبَةُ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ عَطَاءٍ ، عَنْ عُبَيْدِ بْنِ عُمَيْرٍ ، قَالَ :  كَانَ عُمَرُيَنْهَى عَنْ صَوْمِ يَوْمِ عَرَفَةَ """"""","","Sunan al-Kubra al-Nasai 2789","","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمٍ الْمَرْوَزِيُّ قَالَ أَخْبَرَنَا حِبَّانُ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عُمَرَ بْنِ عَلِيٍّ قَالَ حَدَّثَنِي أَبِي عَنْ كُرَيْبٍ قَالَ","The Book of Fasting"
"2790","أنبأ الْحُسَيْنُ بْنُ عِيسَى ، قَالَ : حَدَّثَنَا أَزْهَرُ ، ثُمَّ ذَكَرَ كَلِمَةً مَعْنَاهَا ، حَدَّثَنَا ابْنُ عَوْنٍ ، عَنْ زِيَادِ بْنِ جُبَيْرٍ ، أَنَّ ابْنَ عُمَرَ ، قَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْصَوْمِ يَوْمِ النَّحْرِ """"""","","Sunan al-Kubra al-Nasai 2790","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ قَالَ حَدَّثَنَا مَهْدِيُّ بْنُ مَيْمُونٍ عَنْ غَيْلَانَ بْنِ جَرِيرٍ عَنْ عَبْدِ اللهِ بْنِ مَعْبَدٍ الزِّمَّانِيِّ عَنْ أَبِي قَتَادَةَ","The Book of Fasting"
"2791","أَخْبَرَنِي زِيَادُ بْنُ أَيُّوبَ ، قَالَ : حَدَّثَنَا هُشَيْمٌ ، قَالَ : أنبأ أَبُو بِشْرٍ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَمَّا قَدِمَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْمَدِينَةَ وَجَدَ الْيَهُودَ يَصُومُونَ يَوْمَ عَاشُورَاءَ فَسُئِلُوا عَنْ ذَلِكَ ، فَقَالُوا : هَذَا الْيَوْمُ الَّذِي أَظْهَرَ اللَّهُ فِيهِ مُوسَى ، وَبَنِي إِسْرَائِيلَ عَلَى فِرْعَوْنَ وَنَحْنُ نَصُومُهُ تَعْظِيمًا لَهُ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : نَحْنُ أَوْلَى بِمُوسَى مِنْكُمْ وَأَمَرَ بِصِيَامِهِ """"""","","Sunan al-Kubra al-Nasai 2791","","أَخْبَرَنَا أَبُو دَاوُدَ الْحَرَّانِيُّ قَالَ حَدَّثَنَا عَارِمٌ قَالَ حَدَّثَنَا ثَابِتٌ قَالَ حَدَّثَنَا هِلَالٌ هُوَ ابْنُ خَبَّابٍ عَنْ عَرِيفٍ مِنْ عُرَفَاءِ قُرَيْشٍ قَالَ حَدَّثَنِي أَبِي","The Book of Fasting"
"2792","أنبأ مُحَمَّدُ بْنُ مَنْصُورٍ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، قَالَ : حَدَّثَنَا أَيُّوبُ ، عَنِ ابْنِ سَعِيدِ بْنِ جُبَيْرٍ ، عَنْ أَبِيهِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَدِمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْمَدِينَةَ فَوَجَدَ الْيَهُودَ يَصُومُونَ يَوْمَ عَاشُورَاءَ فَسَأَلَهُمْ :  مَا هَذَا ؟ "" ، فَقَالُوا : يَوْمٌ أَنْجَى اللَّهُ فِيهِ مُوسَى وَأَغْرَقَ فِيهِ آلَ فِرْعَوْنَ فَصَامَهُ مُوسَى شُكْرًا اللَّهِ فَنَحْنُ نَصُومُهُ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : ""فَنَحْنُ أَحَقُّ بِمُوسَى وَأَوْلَى بِصِيَامِهِ فَصَامَهُ وَأَمَرَ بِصِيَامِهِ "". أنبأ إِسْمَاعِيلُ بْنُ يَعْقُوبَ الْحِرَابِيُّ الصَّبِيحِيُّ ، قَالَ : حَدَّثَنَا ابْنُ مُوسَى وَهُوَ ابْنُ أَعْيَنَ ، قَالَ : حَدَّثَنَا أَبِي ، عَنِ الْحَارِثِ يَعْنِي ابْنَ عُمَيْرٍ ، عَنْ أَيُّوبَ ، عَنْ عَبْدِ اللَّهِ بْنِ سَعِيدِ بْنِ جُبَيْرٍ ، عَنْ أَبِيهِ ، عَنِ ابْنِ عَبَّاسٍ نَحْوَهُ""","","Sunan al-Kubra al-Nasai 2792","","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ يَعْقُوبَ وَأَخْبَرَنَا أَحْمَدُ بْنُ يَحْيَى قَالَا حَدَّثَنَا أَبُو نُعَيْمٍ قَالَ حَدَّثَنَا هَارُونُ بْنُ سَلْمَانَ قَالَ حَدَّثَنِي مُسْلِمُ بْنُ عَبْدِ اللهِ الْقُرَشِيُّ أَنَّ أَبَاهُ","The Book of Fasting"
"2793","أنبأ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، أَنَّ عِرَاكًا أَخْبَرَهُ ، أَنَّ عُرْوَةَ أَخْبَرَهُ ، عَنْ عَائِشَةَ ، أَنَّ قُرَيْشًا كَانَتْ تَصُومُ عَاشُورَاءَ فِي الْجَاهِلِيَّةَ ، ثُمَّ أَمَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِصِيَامِهِ ، فَلَمَّا فُرِضَ رَمَضَانُ ، قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ شَاءَ فَلْيَصُمْهُ وَمَنْ شَاءَ أَفْطَرَهُ """"""","","Sunan al-Kubra al-Nasai 2793","","أَخْبَرَنَا عَبْدَةُ بْنُ عَبْدِ اللهِ الْبَصْرِيُّ قَالَ أَخْبَرَنَا زَيْدٌ وَهُوَ ابْنُ حُبَابٍ قَالَ حَدَّثَنِي هَارُونُ بْنُ سَلْمَانَ أَبُو مُوسَى مَوْلَى عَمْرِو بْنِ حُرَيْثٍ قَالَ حَدَّثَنَا عُبَيْدُ اللهِ بْنُ مُسْلِمٍ الْقُرَشِيُّ عَنْ أَبِيهِ قَالَ","The Book of Fasting"
"2794","أنبأ عُبَيْدُ اللَّهِ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا يحْيَى ، عَنْ هِشَامٍ ، قَالَ : أَخْبَرَنِي أَبِي ، عَنْ عَائِشَةَ ، قَالَتْ :  كَانَ يَوْمُ عَاشُورَاءَ يَوْمًا تَصُومُهُ قُرَيْشٌ فِي الْجَاهِلِيَّةِ ، فَكَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَصُومُهُ ، فَلَمَّا قَدِمَ الْمَدِينَةَ صَامَهُ وَأَمَرَ بِصِيَامِهِ ، فَنَزَلَ صَوْمُ رَمَضَانَ فَكَانَ رَمَضَانُ هُوَ الْفَرِيضَةَ ،فَمَنْ شَاءَ صَامَ ، يَعْنِي عَاشُورَاءَ ، وَمَنْ شَاءَ تَرَكَ """"""","","Sunan al-Kubra al-Nasai 2794","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى الصَّنْعَانِيُّ الْبَصْرِيُّ عَنْ خَالِدٍ عَنْ هِشَامٍ عَنْ يَحْيَى عَنْ عُمَرَ بْنِ الْحَكَمِ بْنِ ثَوْبَانَ أَنَّ مَوْلَى قُدَامَةَ بْنِ مَظْعُونٍ حَدَّثَهُ أَنَّ مَوْلَى أُسَامَةَ قَالَ","The Book of Fasting"
"2795","أَخْبَرَنِي عَمْرُو بْنُ عُثْمَانَ بْنِ سَعِيدٍ ، قَالَ : حدَّثَنَا أَبِي ، قَالَ : حَدَّثَنَا شُعَيْبٌ ، عَنِ الزُّهْرِيِّ ، قَالَ : أَخْبَرَنِي عُرْوَةُ ، عَنْ عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَأْمُرُ بِصِيَامِ عَاشُورَاءَ قَبْلَ أَنْ يُفْرَضَ رَمَضَانُ ، فَلَمَّا فُرِضَ رَمَضَانُ كَانَ مَنْ شَاءَ صَامَ عَاشُورَاءَ وَمَنْ شَاءَ أَفْطَرَ """"""","","Sunan al-Kubra al-Nasai 2795","","","The Book of Fasting"
"2796","أنبأ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّهُ ذُكِرَ عِنْدَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمُ عَاشُورَاءَ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : كَانَ يَوْمًا يَصُومُهُ أَهْلُ الْجَاهِلِيَّةِ فَمَنْ أَحَبَّ مِنْكُمْ أَنْ يَصُومَهُ فَلْيَصُمْهُ ، وَمَنْ كَرِهَهُ فَلْيَدَعْهُ """"""","","Sunan al-Kubra al-Nasai 2796","","","The Book of Fasting"
"2797","أنبأ إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أنبأ وَكِيعٌ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنِ الْقَاسِمِ بْنِ مُخَيْمِرَةَ ، عَنْ أَبِي عَمَّارٍ ، عَنْ قَيْسِ بْنِ سَعْدٍ ، قَالَ :  أَمَرَنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَبِصِيَامِ عَاشُورَاءَ قَبْلَ أَنْ يَنْزِلَ رَمَضَانُ ، فَلَمَّا نَزَلَ رَمَضَانُ لَمْ يَأْمُرْنَا وَلَمْ يَنْهَنَا """"""","","Sunan al-Kubra al-Nasai 2797","","أَخْبَرَنِي مَحْمُودُ بْنُ خَالِدٍ قَالَ حَدَّثَنَا الْوَلِيدُ عَنْ أَبِي عَمْرٍو عَنْ يَحْيَى عَنْ مَوْلًى لِأُسَامَةَ بْنِ زَيْدٍ أَنَّ أُسَامَةَ بْنَ زَيْدٍ كَانَ يَصُومُ الِاثْنَيْنِ وَالْخَمِيسَ وَيُخْبِرُ","The Book of Fasting"
"2798","أنبأ إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حَدَّثَنَا يزِيدُ يَعْنِي ابْنَ زُرَيْعٍ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ ، عَنِ الْقَاسِمِ بْنِ مُخَيْمِرَةَ ، عَنْ عَمْرِو بْنِ شُرَحْبِيلَ ، عَنْ قَيْسٍ بْنِ سَعْدٍ ، قَالَ : كُنَّا نَصُومُ يَوْمَ عَاشُورَاءَ وَنُؤَدِّي زَكَاةَ الْفِطْرِ ، فَلَمَّا نَزَلَ رَمَضَانُ وَنَزَلَتِ الزَّكَاةُ لَمْ نُؤْمَرْهُ وَلَمْ يُنْهَ عَنْهُ ، وَكُنَّا نَفْعَلُهُ """"""","","Sunan al-Kubra al-Nasai 2798","","","The Book of Fasting"
"2799","أنبأ عُمَرُ بْنُ إِبْرَاهِيمَ أَبُو الآذَانِ ، قَالَ : حدَّثَنَا عَلِيُّ بْنُ شُعَيْبٍ ، قَالَ : نا أَبُو النَّضْرِ ، قَالَ : حَدَّثَنَا الأَشْجَعِيُّ ، عَنْ سُفْيَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، عَنْ عَبْدِ اللَّهِ ، نَحْوَ كُنَّا نَصُومُ عَاشُورَاءَ فَلَمَّا نَزَلَ رَمَضَانُ لَمْ نُؤْمَرْ بِهِ وَلَمْ نُنْهَ عَنْهُ وَكُنَّا نَفْعَلُهُ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 2799","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ حَبِيبِ بْنِ الشَّهِيدِ الْبَصْرِيُّ قَالَ حَدَّثَنَا يَحْيَى بْنُ الْيَمَانِ عَنْ سُفْيَانَ عَنْ عَاصِمٍ عَنِ الْمُسَيَّبِ بْنِ رَافِعٍ عَنْ سَوَاءٍ الْخُزَاعِيِّ عَنْ عَائِشَةَ قَالَتْ","The Book of Fasting"
"2800","أنبأ مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنَا مُحَمَّدٌ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ : دَخَلَ الأَشْعَثُ بْنُ قَيْسٍ عَلَى عَبْدِ اللَّهِ يَوْمَ عَاشُورَاءَ وَهُوَ يَطْعَمُ ، قَالَ : ادْنُ فَاطْعَمْ ، قَالَ : إِنِّي صَائِمٌ ، فَقَالَ : عَبْدُ اللَّهِ كَانَ هَذَا يَوْمًا نَصُومُهُ قَبْلَ رَمَضَانَ ، فَإِنْ شِئْتَ أَنْ تَطْعَمَ فَادْنُ فَاطْعَمْ ""ذِكْرُ الاخْتِلافِ عَلَى عُمَارَةَ بْنِ عُمَيْرٍ فِي خَبَرِ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ فِي صَوْمِ يَوْمِ عَاشُورَاءَ""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 2800","","أَخْبَرَنَا الْقَاسِمُ بْنُ زَكَرِيَّا قَالَ حَدَّثَنَا حُسَيْنٌ عَنْ زَائِدَةَ عَنْ عَاصِمٍ عَنِ الْمُسَيَّبِ عَنْ حَفْصَةَ قَالَتْ","The Book of Fasting"
"2801","أنبأ مُحَمَّدُ بْنُ الْعَلاءِ ، قَالَ : حَدَّثَنَا أَبُو ُمعَاوِيَةَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَةَ بْنِ عُمَيْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ : دَخَلَ الأَشْعَثُ بْنُ قَيْسٍ عَلَى عَبْدِ اللَّهِ بْنِ مَسْعُودٍ يَوْمَ عَاشُورَاءَ وَهُوَ يَتَغَدَّى ، فَقَالَ لَهُ عَبْدُ اللَّهِ : يَا أَبَا مُحَمَّدٍ ادْنُ ، فَقَالَ : إِنِّي صَائِمٌ ، الْيَوْمَ يَوْمَ عَاشُورَاءَ ، قَالَ : وَهَلْ تَدْرِي مَا كَانَ يَوْمُ عَاشُورَاءَ ؟ قَالَ : وَمَا كَانَ ؟ قَالَ  يَوْمٌ كَانَيَصُومُهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَبْلَ أَنْ يَنْزِلَ رَمَضَانُ فَلَمَّا نَزَلَ رَمَضَانُ تَرَكَهُ """"""","","Sunan al-Kubra al-Nasai 2801","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ الْبَصْرِيُّ قَالَ حَدَّثَنَا خَالِدٌ عَنْ ابْنِ أَبِي ذِئْبٍ عَنْ سَعِيدِ بْنِ عَبْدِ اللهِ بْنِ قَارِظٍ عَنْ أَبِي عُبَيْدٍ قَالَ","The Book of Fasting"
"2802","أنبأ يَعْقُوبُ بْنُ إِبْرَاهِيمَ ، قَالَ : حَدَّثَنَا يحْيَى ، قَالَ : حَدَّثَنَا سُفْيَانُ ، قَالَ : حَدَّثَنِي زُبَيْدٌ ، عَنْ عُمَارَةَ بْنِ عُمَيْرٍ ، عَنْ قَيْسِ بْنِ السَّكَنِ ، أَنَّ الأشْعَثَ بْنَ قَيْسٍ دَخَلَ عَلَى عَبْدِ اللَّهِ يَوْمَ عَاشُورَاءَ وَهُوَ يَأْكُلُ ، فَقَالَ : ادْنُ فَكُلْ ، قَالَ : إِنِّي صَائِمٌ ، قَالَ : كُنَّا نَصُومُهُ ثُمَّ تُرِكَ """"""","","Sunan al-Kubra al-Nasai 2802","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا سُفْيَانُ عَنْ الزُّهْرِيِّ عَنْ أَبِي عُبَيْدٍ مَوْلَى ابْنِ أَزْهَرَ قَالَ شَهِدْتُ الْعِيدَ مَعَ عُمَرَ بْنِ الْخَطَّابِ فَبَدَأَ بِالصَّلَاةِ قَبْلَ الْخُطْبَةِ ثُمَّ قَالَ","The Book of Fasting"
"2803","أنبأ أَحْمَدُ بْنُ حَرْبٍ ، قَالَ : حَدَّثَنَا ابْنُ عُلَيَّةَ ، عَنْ مَنْصُورِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ الشَّعْبِيِّ ، عَنْ عَلْقَمَةَ ، قَالَ :  أَتَيْتُ ابْنَ مَسْعُودٍ فِيمَا بَيْنَ رَمَضَانَ إِلَى رَمَضَانَ ، مَا مِنْ يَوْمٍ إِلا أَتَيْتُهُ فِيهِفَمَا رَأَيْتُهُ فِي يَوْمٍ صَائِمًا وَلا يَوْمَ عَاشُورَاءَ """"""","","Sunan al-Kubra al-Nasai 2803","","أَخْبَرَنَا مُحَمَّدُ بْنُ قُدَامَةَ الْمِصِّيصِيُّ عَنْ جَرِيرٍ عَنْ مُغِيرَةَ عَنْ إِبْرَاهِيمَ عَنْ سَهْمٍ عَنْ قَزَعَةَ عَنْ أَبِي سَعِيدٍ قَالَ","The Book of Fasting"
"2804","أنبأ الْحُسَيْنُ بْنُ حُرَيْثٍ ، قَالَ : حَدَّثَنَا أَبُو ُأسَامَةَ ، عَنْ أَبِي عُمَيْسٍ ، عَنْ قَيْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِهَابٍ ، عَنْ أَبِي مُوسَى ، قَالَ : كَانَيَوْمُ عَاشُورَاءَ يَوْمًا تَصُومُهُ الْيَهُودُ تَتَّخِذُهُ عِيدًا ، فَلَمَّا قَدِمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْمَدِينَةَ أُخْبِرَ بِذَلِكَ ، فَقَالَ :  فَصُومُوهُ أَنْتُمْ ""خَالَفَهُ رَقَبَةُ""","","Sunan al-Kubra al-Nasai 2804","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ حَدَّثَنَا ابْنُ أَبِي عَدِيٍّ عَنْ سَعِيدٍ عَنْ قَتَادَةَ عَنْ قَزَعَةَ عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ","The Book of Fasting"
"2805","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ يَعْقُوبَ ، قَالَ : حَدَّثَنَا أَبُو الْوَلِيدِ ، قَالَ : حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ رَقَبَةَ ، عَنْ قَيْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِهَابٍ ، قَالَ : كَانَ يَوْمُ عَاشُورَاءَ لأَهْلِ يَثْرِبَ عِيدًا يَلْبَسُ فِيهِ النِّسَاءُ شَارَتَهُنَّ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : خَالِفُوهُمْ فَصُومُوهُ """"""","","Sunan al-Kubra al-Nasai 2805","","أَخْبَرَنَا عُبَيْدُ اللهِ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا مُعَاذُ بْنُ هِشَامٍ قَالَ حَدَّثَنِي أَبِي عَنْ قَتَادَةَ عَنْ قَزَعَةَ عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ","The Book of Fasting"
