"906","[AI-translation] ((रोटी को छुरी से न काटो जैसे ग़ैर-अरब करते हैं))।"
"907","[AI-translation] ((रोटी छोटी रखो और उसकी तादाद बढ़ाओ; तुम्हारे लिए उसमें बरकत रखी जाएगी))।"
"908","[AI-translation] ((ऐ अल्लाह! हमें इस्लाम और रोटी के ज़रिए फ़ायदा दे; अगर रोटी न होती तो न हम रोज़ा रखते, न नमाज़ पढ़ते, न हज करते, न जिहाद में शरीक होते))।"
"909","[AI-translation] ((तीन खाने आदमी पर गिने न जाएँगे: सहरी का खाना, इफ़्तार का खाना, और भाइयों के साथ मिलकर खाया खाना))।"
"910","[AI-translation] ((खाने पर फूँकना बरकत ले जाता है))।"
"911","[AI-translation] ((जो भरे पेट रात गुज़ारें उनके अख़लाक़ अच्छे हैं, और जो भूखे रात गुज़ारें उनके अख़लाक़ बुरे हैं))।"
"912","[AI-translation] ((अगर नबी (सल्लल्लाहु अलैहि वसल्लम) सुबह खाते तो शाम को न खाते, और अगर शाम को खाते तो सुबह न खाते))।"
"913","[AI-translation] ((जब भी नबी (सल्लल्लाहु अलैहि वसल्लम) खाना खाते तो अल्लाह की हम्द करते फिर यह दुआ «اللهم بارك لنا فيه و أطعمنا أطيب منه» पढ़ते))।"
"914","[AI-translation] ((दुनिया वालों और जन्नत वालों के खाने का सरदार गोश्त है))।"
"915","[AI-translation] ((बेशक दिल गोश्त खाते वक़्त ख़ुशी और मुसर्रत महसूस करता है))।"
"916","[AI-translation] ((गोश्त गोश्त पैदा [परवरिश] करता है, और जो चालीस दिन गोश्त से परहेज़ करे, उसकी ख़िल्क़त [सूरत] ख़राब हो जाती है))।"
"917","[AI-translation] ((ज़ैतून खाओ और उसका तेल लगाओ, क्योंकि वह पाक और बाबरकत है))।"
"918","[AI-translation] ((दूध पीना ख़ालिस ईमान है; जो ख़्वाब में दूध पिए वह ईमान और फ़ित्रत पर है))।"
"919","[AI-translation] ((आजिज़ी की निशानी है कि आदमी अपने भाई का बचा पानी पिए, और जो अल्लाह की रज़ा के लिए अपने भाई का बचा पानी पिए, उसके सत्तर दर्जे बुलन्द किए जाते हैं))।"
"920","[AI-translation] ((जो मुसलमान को वहाँ पानी का घूँट पिलाए जहाँ पानी हो, गोया उसने ग़ुलाम आज़ाद किया; और जो मुसलमान को वहाँ पानी का घूँट पिलाए जहाँ पानी न हो, गोया उसने मोमिन जान को ज़िन्दगी दी))।"
"921","[AI-translation] ((गर्म दिनों में पानी पर पानी पिलाओ; तुम्हारे गुनाह ऐसे झड़ेंगे जैसे तेज़ तूफ़ानी हवा में दरख़्त से पत्ते झड़ते हैं))।"
"922","[AI-translation] ((खाने में चावल ऐसा है जैसे क़ौम में सरदार))।"
"923","[AI-translation] ((जो चालीस दिन चावल खाए, उसके दिल से ज़बान की तरफ़ हिकमत के चश्मे बहते हैं))।"
"924","[AI-translation] ((चावल मुझसे है और मैं चावल से हूँ। मैंने चावल को अपने नूर के बचे हिस्से से पैदा किया))।"
"925","[AI-translation] ((मसूर ज़रूर इस्तेमाल करो क्योंकि वह बाबरकत और पाक है))।"
"926","[AI-translation] ((मसूर ज़रूर इस्तेमाल करो, क्योंकि वह सत्तर अम्बिया की ज़बानों पर पाक क़रार दी गई))।"
"927","[AI-translation] ((बैंगन में हर बीमारी का इलाज है, और उसमें कोई बीमारी नहीं))।"
"928","[AI-translation] ((बैंगन कसरत से खाओ, क्योंकि वह पहला दरख़्त है जो मैंने जन्नत-उल-मावा में देखा))।"
"929","[AI-translation] ((ख़रबूज़ा खाने से पहले पेट धोता है और बीमारी पूरी तरह दूर करता है))।"
"930","[AI-translation] ((मेरी उम्मत की बहार अंगूर और ख़रबूज़ा है))।"
"931","[AI-translation] ((लौकी खाओ, क्योंकि वह अक़्ल बढ़ाती है))।"
"932","[AI-translation] ((ऐ अली! जब सफ़र का तोशा लो तो प्याज़ न भूलो))।"
"933","[AI-translation] ((प्याज़ ज़रूर इस्तेमाल करो, क्योंकि वह मनी पाक करती है और बच्चा पैदा होता है))।"
"934","[AI-translation] ((जो खीरा गोश्त के साथ खाए वह कोढ़ की बीमारी से महफ़ूज़ रहा))।"
"935","[AI-translation] ((मोमिन का दिल मीठा है; उसे सिर्फ़ मिठास पसन्द है))।"
"936","[AI-translation] ((बेशक दुनिया में भूखे आख़िरत में सेर होंगे))।"
"937","[AI-translation] ((पनीर बीमारी है और अख़रोट भी बीमारी है, लेकिन जब दोनों मिल जाएँ तो शिफ़ा बन जाते हैं))।"
"938","[AI-translation] ((तेलों का सरदार बनफ़्शा का तेल है, और तेलों में बनफ़्शा के तेल की फ़ज़ीलत ऐसी है जैसी सब दीनों में इस्लाम की फ़ज़ीलत है))।"
"939","[AI-translation] ((जिसके घर में बकरी हो उसके घर में बरकतें होंगी))।"
"940","[AI-translation] ((मुर्ग़े को बुरा न कहो क्योंकि वह मेरा दोस्त है और मैं उसका दोस्त हूँ))।"
"941","[AI-translation] (([अबू-उल-बख़तरी ख़लीफ़ा हारून-उर-रशीद के पास गया और उसे कबूतर उड़ाते पाया। यह देखकर उसने ख़लीफ़ा को ख़ुश करने के लिए यह रिवायत गढ़ी और बयान की:] नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) कबूतर उड़ाते थे))।"
"942","[AI-translation] ((कव्वे और गिद्ध के सिवा सब परिन्दे खाने में कोई हर्ज नहीं))।"
"943","[AI-translation] ((साही... नापाक जानवरों में से एक नापाक जानवर है))।"
"944","[AI-translation] ((बेशक यह इसराफ़ है: जब चाहो खाओ))।"
"945","[AI-translation] ((मिट्टी खाना निफ़ाक़ की तरफ़ ले जाता है))।"
"946","[AI-translation] ((मिट्टी खाना हर मुसलमान के लिए हराम है))।"
"947","[AI-translation] ((जो मिट्टी खाए और उससे नहाए, [गोया] उसने अपने बाप आदम (अलैहिस्सलाम) का गोश्त खाया और उनके ख़ून से नहाया))।"
"948","[AI-translation] सहाबा ने पूछा: ((ऐ अल्लाह के रसूल! ये क़ुर्बानियाँ क्या हैं?)) आप (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: ((यह तुम्हारे बाप इब्राहीम (अलैहिस्सलाम) की सुन्नत है))। सहाबा ने पूछा: ((इनमें हमारे लिए क्या सवाब है?)) आप (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: ((हर बाल के बदले एक नेकी है))।"
"949","[AI-translation] एक आदमी ने हज़रत इब्ने उमर (रज़ियल्लाहु अन्हुमा) से क़ुर्बानी के बारे में पूछा, क्या वह वाजिब है। उन्होंने जवाब दिया: रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) और मुसलमानों ने क़ुर्बानी की है। फिर उसने फिर वही सवाल पूछा, तो आपने कहा: क्या समझे? रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) और मुसलमानों ने क़ुर्बानी की है।"
"950","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) मदीना में दस साल रहे और हर साल क़ुर्बानी [क़ुर्बानी] करते))।"
"951","[AI-translation] ((ज़ुल-हिज्जा की दस तारीख़ को आदम के बेटे का कोई अमल अल्लाह को ख़ून बहाने [क़ुर्बानी करने] से ज़्यादा महबूब नहीं। ये जानवर क़ियामत के दिन अपने सींगों, खुरों और बालों समेत आएँगे। ख़ून के ज़मीन पर गिरने से पहले अल्लाह के नज़दीक मक़ाम पाता है। तो ख़ुशदिली से अपनी क़ुर्बानी करो))।"
"952","[AI-translation] (([हज़रत अली (रज़ियल्लाहु अन्हु) ने कहा कि] रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने मुझे अपनी तरफ़ से क़ुर्बानी करने की वसीयत की, तो मैं उनकी तरफ़ से क़ुर्बानी करता हूँ))।"
"953","[AI-translation] ((ऊद, संदल, मुश्क, अम्बर और काफ़ूर आदम (अलैहिस्सलाम) के लिबास हैं जिनमें वे जन्नत से उतारे गए))।"
"954","[AI-translation] ((मर्द का घुटना औरत [छुपाने वाली शर्मगाह] में शामिल है))।"
"955","[AI-translation] ((अमामे के साथ नमाज़ [बग़ैर अमामे] पच्चीस नमाज़ों के बराबर है, और अमामे के साथ जुमा की नमाज़ [बग़ैर अमामे] सत्तर जुमों के बराबर है))।"
"956","[AI-translation] ((सिर पर अमामे के साथ नमाज़ का सवाब अल्लाह के रास्ते में जिहाद के बराबर है))।"
"957","[AI-translation] ((अमामा बाँधो, हिल्म और सब्र में बढ़ोगे))।"
