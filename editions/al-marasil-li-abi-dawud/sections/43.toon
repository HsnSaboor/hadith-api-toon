hadiths[9]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"240","[1/203]      43 - بَابُ الْحُدُودِ  241  -  حَدَّثَنَا  هِشَامُ بْنُ خَالِدٍ  ،  حَدَّثَنَا  الْحَسَنُ بْنُ يَحْيَى الْخُشَنِيُّ ،  عَنْ  زَيْدِ بْنِ وَاقِدٍ ،  عَنْ  مَكْحُولٍ .  عَنْ  عُبَادَةَ بْنِ الصَّامِتِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَقِيمُوا الْحُدُودَ فِي [الْحَضَرِ وَالسَّفَرِ]  عَلَى الْقَرِيبِ وَالْبَعِيدِ  ، وَلَا  تُبَالُوا  فِي اللهِ لَوْمَةَ لَائِمٍ  ( 5115 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: باب في الحدود .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: الدمشقي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: السفر والحضر .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: ""قال أبو داود : مكحول لم ير عبادة . وليس يصح له عن أحد من أصحاب النبي صلى الله عليه وسلم إلا أنس بن مالك وواثلة بن الأسقع وأبي أمامة"" .","","Al-Marasil li-Abi Dawud 241","","عبادة بن الصامت عن مكحول بن أبي مسلم عن زيد بن واقد القرشي عن الحسن بن يحيى الخشني عن هشام بن خالد السلامي عن أبو داود السجستاني","باب الحدود"
"241","242  -  حَدَّثَنَا  الْعَبَّاسُ  الْعَنْبَرِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  أَخْبَرَنَا  مَعْمَرٌ .  عَنِ  الزُّهْرِيِّ :  أَنَّ  صَفْوَانَ بْنَ الْمُعَطَّلِ  ، ضَرَبَ  حَسَّانَ بْنَ ثَابِتٍ         [1/204]      بِالسَّيْفِ  عَلَى عَهْدِ [رَسُولِ اللهِ]  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمْ يَقْطَعِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَدَهُ  ( 19386 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: عباس .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: النبي .","","Al-Marasil li-Abi Dawud 242","","الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن عباس بن عبد العظيم العنبري عن أبو داود السجستاني","باب الحدود"
"242","243  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عِيسَى - يَعْنِي ابْنَ أَبِي عَزَّةَ -  عَنِ  الشَّعْبِيِّ .  عَنْ  عَبْدِ اللهِ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ قَطَعَ فِي قِيمَةِ خَمْسَةِ دَرَاهِمَ  ( 9324 ) .","","Al-Marasil li-Abi Dawud 243","","عبد الله بن مسعود عن الشعبي عن عيسى بن أبي عزة الشعبي عن سفيان الثوري عن عبد الرحمن بن مهدي عن محمد بن بشار بندار عن أبو داود السجستاني","باب الحدود"
"243","244  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  يَزِيدَ بْنِ خُصَيْفَةَ .  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُتِيَ بِسَارِقٍ سَرَقَ  شَمْلَةً  ، فَقَالَ : مَا نَخَالُكَ  سَرَقْتَ ؟ قَالَ : بَلَى قَدْ فَعَلْتُ ، فَقَالَ : اذْهَبُوا بِهِ فَاقْطَعُوهُ ثُمَّ  احْسِمُوهُ  ثُمَّ ائْتُونِي بِهِ ، فَذَهَبُوا بِهِ ، فَقَطَعُوهُ ، ثُمَّ  حَسَمُوهُ  ، ثُمَّ أَتَوْهُ بِهِ ، فَقَالَ : تُبْ إِلَى اللهِ ، فَقَالَ  : قَدْ         [1/205]      تُبْتُ إِلَى اللهِ ، قَالَ : اللَّهُمَّ تُبْ عَلَيْهِ  ( 19312 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: أنا .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قد سرق .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: إخالك .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال .","","Al-Marasil li-Abi Dawud 244","","محمد بن عبد الرحمن بن ثوبان القرشي عن يزيد بن عبد الله بن خصيفة الكندي عن سفيان بن عيينة عن أحمد بن عبدة الضبي عن أبو داود السجستاني","باب الحدود"
"244","245  -  حَدَّثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  جَرِيرُ بْنُ حَازِمٍ .  عَنِ  الْحَسَنِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنِّي لَا أَقْطَعُ فِي الطَّعَامِ  ( 18505 ) .","","Al-Marasil li-Abi Dawud 245","","الحسن البصري عن جرير بن حازم عن مسلم بن إبراهيم الشحام عن أبو داود السجستاني","باب الحدود"
"245","[1/206]      246  -  [حَدَّثَنَا  أَبُو مَعْمَرٍ]  ،  حَدَّثَنَا  عَبْدُ الْوَارِثِ ،  عَنِ  الْحُسَيْنِ [بْنِ ذَكْوَانَ]  ،  عَنْ  يَحْيَى .  عَنْ  بَعْجَةَ بْنِ عَبْدِ اللهِ الْجُهَنِيِّ ،  أَنَّ  رَجُلًا مِنْ جُهَيْنَةَ  سَرَقَ مَتَاعًا مِنَ السُّوقِ ، فَأَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  إِنِّي سَرَقْتُ [فَاقْطَعْ يَدِي]  ، فَقَطَعَ يَدَهُ ثُمَّ غَزَا فِي  سَبِيلِ  اللهِ فَاسْتُشْهِدَ  ( 18458 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: حدثنا أبو معمر عبد الله بن عمرو .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: هو المعلم .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: فاقطعني .","","Al-Marasil li-Abi Dawud 246","","بعجة بن عبد الله بن بدر الجذامي عن يحيى بن أبي كثير عن حسين المعلم عن عبد الوارث بن سعيد بن ذكوان عن عبد الله بن عمرو المقعد عن أبو داود السجستاني","باب الحدود"
"246","247  -  حَدَّثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ الْأَنْبَارِيُّ ،  [حَدَّثَنَا  حَمَّادُ بْنُ مَسْعَدَةَ]  ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَبْدِ رَبِّهِ بْنِ أَبِي أُمَيَّةَ .  عَنِ  الْحَارِثِ بْنِ عَبْدِ اللهِ بْنِ أَبِي رَبِيعَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُتِيَ بِسَارِقٍ فَقِيلَ : هُوَ لِيَتَامَى مِنَ  الْأَنْصَارِ  مَا  لَهُمْ مَالٌ غَيْرُهُ  ، فَتَرَكَهُ  ثُمَّ الثَّانِيَةَ ، فَتَرَكَهُ ، ثُمَّ الثَّالِثَةَ ، فَتَرَكَهُ ، ثُمَّ الرَّابِعَةَ فَتَرَكَهُ ، ثُمَّ الْخَامِسَةَ فَقَطَعَ يَدَهُ ، ثُمَّ السَّادِسَةَ فَقَطَعَ رِجْلَهُ ، ثُمَّ السَّابِعَةَ فَقَطَعَ يَدَهُ ، ثُمَّ الثَّامِنَةَ فَقَطَعَ رِجْلَهُ ، ثُمَّ قَالَ : أَرْبَعٌ بِأَرْبَعٍ  ( 18481 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: أن حماد بن مسعدة حدثهم .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: والله ما .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال فتركه .","","Al-Marasil li-Abi Dawud 247","","الحارث بن عبد الله أبي ربيعة القباع عن عبد ربه بن أبي أمية عن ابن جريج عن حماد بن مسعدة عن محمد بن سليمان الأنباري عن أبو داود السجستاني","باب الحدود"
"247","248  -  حَدَّثَنَا  كَثِيرُ بْنُ عُبَيْدٍ ،  [حَدَّثَنَا  بَقِيَّةُ ،  حَدَّثَنَا]  صَفْوَانُ بْنُ عَمْرٍو .  حَدَّثَنِي  الْفُضَيْلُ بْنُ فَضَالَةَ الْهَوْزَنِيُّ ، قَالَ :  جَاءَتِ  امْرَأَةٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَتْ : يَا رَسُولَ اللهِ إِنَّ فِي بَطْنِي حَدَثًا - فَذَكَرَ [قِصَّةَ الرَّجْمِ]  -         [1/207]      فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ارْجُمُوهَا وَأَكْثِرُوا حَوْلَهَا مِنَ الْحِجَارَةِ وَتَابِعُوا عَلَيْهَا  ( 19193 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: ""قال : بقية نا عن"" .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قصة وضعها والرجم .","","Al-Marasil li-Abi Dawud 248","","فضيل بن فضالة الهوزني عن صفوان بن عمرو السكسكي عن بقية بن الوليد عن كثير بن عبيد المذحجي عن أبو داود السجستاني","باب الحدود"
"248","249  -  حَدَّثَنَا  هَنَّادُ بْنُ السَّرِيِّ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكٍ .  عَنِ  الْحَسَنِ الْبَصْرِيِّ ، قَالَ :  جَاءَتِ  امْرَأَةٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَتْ : إِنِّي قَدْ زَنَيْتُ  - فَذَكَرَ الْحَدِيثَ - قَالَ : فَلَمَّا وَلَدَتْ أَمَرَهَا فَتَطَهَّرَتْ وَلَبِسَتْ أَكْفَانَهَا ، ثُمَّ أَمَرَ بِهَا فَرُجِمَتْ  ( 18520 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال نا .","","Al-Marasil li-Abi Dawud 249","","الحسن البصري عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن هناد بن السري عن أبو داود السجستاني","باب الحدود"
