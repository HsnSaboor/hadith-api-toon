hadiths[40]{hadithnumber,text}:
"1","[AI-translation] Vijest nije kao viđenje vlastitim očima."
"2","[AI-translation] Rat je varka."
"3","[AI-translation] Musliman je ogledalo muslimanu."
"4","[AI-translation] Onaj od koga se traži savjet je povjerljiv (od povjerenja)."
"5","[AI-translation] Onaj ko upućuje na dobro je kao onaj ko ga čini."
"6","[AI-translation] Potražite pomoć za svoje potrebe u tajnosti (čuvanjem tajne)."
"7","[AI-translation] Čuvajte se Vatre pa makar i polovinom datule."
"8","[AI-translation] Ovaj svijet je zatvor vjernika i džennet nevjernika."
"9","[AI-translation] Stid je u potpunosti dobro."
"10","[AI-translation] Obećanje vjernika je kao već uzeto u ruku."
"11","[AI-translation] Nije dozvoljeno vjerniku da napusti svoga brata duže od tri dana."
"12","[AI-translation] Nije od nas onaj ko nas vara."
"13","[AI-translation] Malo što je dovoljno bolje je od mnogo što odvraća (od pokornosti)."
"14","[AI-translation] Onaj ko se vrati svome poklonu je kao onaj ko se vraća svojoj bljuvotini."
"15","[AI-translation] Iskušenje je povezano s govorom."
"16","[AI-translation] Ljudi su kao zupci češlja."
"17","[AI-translation] Bogatstvo je bogatstvo duše."
"18","[AI-translation] Sretan je onaj ko se pouči primjerom drugoga."
"19","[AI-translation] Zaista, u poeziji ima mudrosti, a u rječitosti ima čarolije."
"20","[AI-translation] Oprost vladara je očuvanje vlasti."
"21","[AI-translation] Čovjek će biti s onim koga voli."
"22","[AI-translation] Nije propao čovjek koji je spoznao svoju vrijednost."
"23","[AI-translation] Dijete pripada postelji, a preljubniku kamen."
"24","[AI-translation] Gornja ruka je bolja od donje ruke."
"25","[AI-translation] Nije zahvalio Allahu onaj ko ne zahvaljuje ljudima."
"26","[AI-translation] Tvoja ljubav prema nečemu čini te slijepim i gluhim."
"27","[AI-translation] Srca su po prirodi takva da vole onoga ko im čini dobro i mrze onoga ko im čini zlo."
"28","[AI-translation] Onaj ko se pokaje za grijeh je kao onaj ko grijeha nema."
"29","[AI-translation] Prisutni (svjedok) vidi ono što odsutni ne vidi."
"30","[AI-translation] Kada vam dođe plemeniti čovjek nekog naroda, počastite ga."
"31","[AI-translation] Lažna zakletva ostavlja domove pustim."
"32","[AI-translation] Onaj ko bude ubijen braneći svoj imetak je šehid."
"33","[AI-translation] Djela su prema namjerama."
"34","[AI-translation] Prvak naroda je njihov sluga."
"35","[AI-translation] Najbolji poslovi su oni srednji (umjereni)."
"36","[AI-translation] Allahu moj, podari bereket mome ummetu u njegovom ranom ustajanju četvrtkom."
"37","[AI-translation] Siromaštvo je zamalo da bude nevjerstvo."
"38","[AI-translation] Putovanje je dio patnje."
"39","[AI-translation] Najbolja opskrba je bogobojaznost (takvaluk)."
"40","[AI-translation] Sjednice (skupovi) su povjerenje."
