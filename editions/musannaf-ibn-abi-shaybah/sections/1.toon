hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"1","حَدَّثَنِی بَقِیُّ بْنُ مَخْلَدٍ ، رَحِمَہُ اللہ تعالی ، قَالَ: حدَّثَنَا أَبُو بَکْرٍ، عَبْدُاللہِ بْنُ مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ ، قَالَ:\n\n(۱) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، عَنْ أَنَسِ بْنِ مَالِکٍ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ إذَا دَخَلَ الْخَلاَئَ ، قَالَ : أَعُوذُ بِاللَّہِ مِنَ الْخُبُثِ وَالْخَبَائِثِ۔ (بخاری ۱۴۲، ۶۳۲۲۔ ابوداؤد ۴۔۵)",": Sahih","Musannaf Ibn Abi Shaybah 1","","","كتاب الطهارة"
"2","(۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ قَاسِمٍ الشَّیْبَانِیِّ ، عَنْ زَیْدِ بْنِ أَرْقَمَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إنَّ ہَذِہِ الْحُشُوشَ مُحْتَضَرَۃٌ ، فَإِذَا دَخَلَ أَحَدُکُمُ الْخَلاَئَ فَلْیَقُلِ: اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْخُبْثِ وَالْخَبَائِثِ۔ (نسائی۹۹۰۵۔ ابن ماجہ ۲۹۶)",": Sahih","Musannaf Ibn Abi Shaybah 2","","","كتاب الطهارة"
"3","(۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُمَرَ ، قَالَ : حدَّثَنِی الْحَسَنُ بْنُ مُسْلِمِ بْنِ یَنَّاق ، عَنْ رَجُلٍ مِنْ أَصْحَابِ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، قَالَ: قَالَ عَبْدُ اللہِ : إذَا دَخَلْتَ الْغَائِطَ ، فَأَرَدْتَ التَّکَشُّفَ ، فَقُلِ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الرِّجْسِ النَّجِسِ ، وَالْخُبْثِ وَالْخَبَائِثِ ، وَالشَّیْطَانِ الرَّجِیمِ۔",": Da'if","Musannaf Ibn Abi Shaybah 3","","","كتاب الطهارة"
"4","(۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : کَانَ حُذَیْفَۃُ إذَا دَخَلَ الْخَلاَئَ ، قَالَ : أَعُوذُ بِاللَّہِ مِنَ الرِّجْسِ النَّجِسِ ، الْخَبِیثِ الْمُخْبَثِ ، الشَّیْطَانِ الرَّجِیمِ۔",": Da'if","Musannaf Ibn Abi Shaybah 4","","","كتاب الطهارة"
"5","(۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی مَعْشَرٍ ، وَہُوَ نَجِیحٌ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی طَلْحَۃَ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا دَخَلَ الْکَنِیفَ ، قَالَ : بِسْمِ اللہِ ، اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْخُبْثِ وَالْخَبَائِثِ۔ (طبرانی ۳۵۷)",": Da'if","Musannaf Ibn Abi Shaybah 5","","","كتاب الطهارة"
"6","(۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنِ الزِّبْرِقَانِ الْعَبْدِیِّ ، عَنِ الضَّحَّاکِ بْنِ مُزَاحِمٍ ، قَالَ : إذَا دَخَلْتَ الْخَلاَئَ فَقُلِ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الرِّجْسِ النَّجِسِ ، الْخَبِیثِ الْمُخْبِثِ ، الشَّیْطَانِ الرَّجِیمِ۔",": Da'if","Musannaf Ibn Abi Shaybah 6","","","كتاب الطهارة"
"7","(۷) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، قَالَ : حَدَّثَنَا یُوسُفُ بْنُ أَبِی بُرْدَۃَ ، قَالَ : سَمِعْتُ أبِی یَقُولُ : دَخَلْتُ عَلَی عَائِشَۃَ رَضِیَ اللَّہُ عَنْہا ، فَسَمِعْتُہَا تَقُولُ : کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ إذَا خَرَجَ مِنَ الْغَائِطِ قَالَ : غُفْرَانَک۔ (ابن ماجہ ۳۰۰۔ نسائی ۹۹۰۷)",": Sahih","Musannaf Ibn Abi Shaybah 7","","","كتاب الطهارة"
"8","(۸) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْعَوَّامِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ؛ أَنَّ نُوحًا النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا خَرَجَ مِنَ الْغَائِطِ قَالَ : الْحَمْدُ لِلَّہِ الَّذِی أَذْہَبَ عَنِّی الأَذَی ، وَعَافَانِی۔",": Da'if","Musannaf Ibn Abi Shaybah 8","","","كتاب الطهارة"
"9","(۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ ، قَالَ : حُدِّثْتُ ، أَنَّ نُوحًا کَانَ یَقُولُ : الْحَمْدُ لِلَّہِ الَّذِی أَذَاقَنِی لَذَّتَہُ ، وَأَبْقَی فِیَّ مَنْفَعَتَہُ ، وَأَذْہَبَ عَنِّی أَذَاہُ۔ (بیہقی ۴۴۶۹)",": Da'if","Musannaf Ibn Abi Shaybah 9","","","كتاب الطهارة"
"10","(۱۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، وَوَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی عَلِیٍّ ؛ أَنَّ أَبَا ذَرٍّ کَانَ یَقُولُ إذَا خَرَجَ مِنَ الْخَلاَئِ : الْحَمْدُ لِلَّہِ الَّذِی أَذْہَبَ عَنِّی الأَذَی ، وَعَافَانِی۔ (طبرانی ۳۷۲)",": Majhul","Musannaf Ibn Abi Shaybah 10","","","كتاب الطهارة"
"11","(۱۱) حَدَّثَنَا عَبْدَۃُ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : کَانَ حُذَیْفَۃُ یَقُولُ إذَا خَرَجَ ، یَعْنِی مِنَ الْخَلاَئِ : الْحَمْدُ لِلَّہِ الَّذِی أَذْہَبَ عَنِّی الأَذَی وَعَافَانِی۔",": Da'if","Musannaf Ibn Abi Shaybah 11","","","كتاب الطهارة"
"12","(۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ زَمْعَۃَ ، عَنْ سَلَمَۃَ بْنِ وَہْرَام ، عَنْ طَاوُوسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إذَا خَرَجَ أَحَدُکُمْ مِنَ الْخَلاَئِ فَلْیَقُلِ : الْحَمْدُ لِلَّہِ الَّذِی أَذْہَبَ عَنِّی مَا یُؤْذِینِی ، وَأَمْسَکَ عَلَیَّ مَا یَنْفَعُنِی۔ (طبرانی ۳۷۱، دار قطنی۱/۵۷)",": Da'if","Musannaf Ibn Abi Shaybah 12","","","كتاب الطهارة"
"13","(۱۳) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ ، حَدَّثَنَا ہُرَیْمٌ ، عَنْ لَیْثٍ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو ، قَالَ : کَانَ أَبُو الدَّرْدَائِ إذَا خَرَجَ مِنَ الْخَلاَئِ قَالَ : الْحَمْدُ لِلَّہِ الَّذِی أَمَاطَ عَنِّی الأَذَی ، وَعَافَنِی۔",": Da'if","Musannaf Ibn Abi Shaybah 13","","","كتاب الطهارة"
"14","(۱۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، وَمُحَمَّدُ بْنُ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ کَثِیرِ بْنِ زَیْدٍ ، قَالَ : حدَّثَنِی رُبَیْحُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِی سَعِیدٍ الْخُدْرِیِّ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : لاَ وُضُوئَ لِمَنْ لَمْ یَذْکُرِ اسْمَ اللہِ عَلَیْہِ۔ (طبرانی۳۸۰۔ احمد ۳/۴۱)",": Da'if","Musannaf Ibn Abi Shaybah 14","","","كتاب الطهارة"
"15","(۱۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وُہَیْبٌ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ حَرْمَلَۃَ ، أَنَّہُ سَمِعَ أَبَا ثِفَالٍ یُحَدِّثُ ، أَنَّہُ سَمِعَ رَبَاحَ بْنَ عَبْدِ الرَّحْمَنِ بْنِ أَبِی سُفْیَانَ بْنِ حُوَیْطِبٍ یَقُولُ : حَدَّثَتْنِی جَدَّتِی ، أَنَّہَا سَمِعَتْ أَبَاہَا یَقُولُ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لاَ صَلاَۃَ لِمَنْ لاَ وُضُوئَ لَہُ ، وَلاَ وُضُوئَ لِمَنْ لَمْ یَذْکُرِ اسْمَ اللہِ عَلَیْہِ۔ (ترمذی۲۵،۲۶۔ ابن ماجہ ۳۹۸)",": Da'if","Musannaf Ibn Abi Shaybah 15","","","كتاب الطهارة"
"16","(۱۶) حَدَّثَنَا عَبْدَۃُ ، عَنْ حَارِثَۃَ ، عَنْ عَمْرَۃَ ، قَالَتْ : سَأَلْتُ عَائِشَۃَ : کَیْفَ کَانَتْ صَلاَۃُ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَتْ : کَانَ إذَا تَوَضَّأَ فَوَضَعَ یَدَہُ فِی الْمَائِ ، سَمَّی فَتَوَضَّأَ ، وَیُسْبِغُ الْوُضُوئَ۔\n(طبرانی ۳۸۳۔ ابن ماجہ ۱۰۶۲)",": Da'if","Musannaf Ibn Abi Shaybah 16","","","كتاب الطهارة"
"17","(۱۷) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ لَیْثٍ ، عَنْ حُسَیْنِ بْنِ عُمَارَۃَ ، عَنْ أَبِی بَکْرٍ ، قَالَ : إذَا تَوَضَّأَ الْعَبْدُ ، فَذَکَرَ اسْمَ اللہِ حِینَ یَأْخُذُ فِی وَضُوئِہِ ، طَہُرَ جَسَدُہُ کُلُّہُ ، وَإِذَا تَوَضَّأَ وَلَمْ یَذْکُرِ اسْمَ اللہِ ، لَمْ یَطْہُرْ مِنْہُ ، إِلاَّ مَا أَصَابَہُ الْمَائُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17","","","كتاب الطهارة"
"18","(۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ : یُسَمِّی إذَا تَوَضَّأَ ، فَإِنْ لَمْ یَفْعَلْ أَجْزَأَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 18","","","كتاب الطهارة"
"19","(۱۹) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ الْوَاسِطِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَنْ قَیْسِ بْنِ عُبَادٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : مَنْ قَالَ إذَا فَرَغَ مِنْ وُضُوئِہِ : سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ أَنْتَ ، أَسْتَغْفِرُک وَأَتُوبُ إلَیْک ، خُتِمَتْ بِخَاتَمٍ ، ثُمَّ رُفِعَتْ تَحْتَ الْعَرْشِ ، فَلَمْ تُکْسَرْ إلَی یَوْمِ الْقِیَامَۃِ۔\n(نسائی ۹۹۱۰۔ طبرانی ۳۹۱)",": Sahih","Musannaf Ibn Abi Shaybah 19","","","كتاب الطهارة"
"20","(۲۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، وَعَبْدُ اللہِ بْنُ دَاوُد ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ : کَانَ عَلِیٌّ إذَا فَرَغَ مِنْ وُضُوئِہِ ، قَالَ : أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، رَبِّ اجْعَلْنِی مِنَ التَّوَّابِینَ ، وَاجْعَلْنِی مِنَ الْمُتَطَہِّرِینَ۔",": Hasan","Musannaf Ibn Abi Shaybah 20","","","كتاب الطهارة"
"21","(۲۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنَا مُعَاوِیَۃُ بْنُ صَالِحٍ ، عَنْ رَبِیعَۃَ بْنِ یَزِیدَ ، عَنْ أَبِی إدْرِیسَ الْخَوْلاَنِیِّ ، وَأَبِی عُثْمَانَ ، عَنْ جُبَیْرِ بْنِ نُفَیْرِ بْنِ مَالِکٍ الْحَضْرَمِیِّ ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ الْجُہَنِیِّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ قَالَ : مَا مِنْ أَحَدٍ یَتَوَضَّأُ فَیُحْسِنُ الْوُضُوئَ ، ثُمَّ یُصَلِّی رَکْعَتَیْنِ ، مُقْبِلٌ بِقَلْبِہِ وَوَجْہِہِ عَلَیْہِمَا إِلاَّ وَجَبَتْ لَہُ الْجَنَّۃُ ۔ قَالَ : فَقَالَ عُمَرُ : مَا قَبْلَہَا أَکْثَرُ مِنْہَا ، کَأَنَّک جِئْتَ آنِفًا ؟ قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : مَنْ تَوَضَّأَ فَقَالَ : أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَحْدَہُ لاَ شَرِیکَ لَہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، فُتِحَتْ لَہُ ثَمَانیَۃُ أَبْوَابِ الْجَنَّۃِ ، یَدْخُلُ مِنْ أَیِّہَا شَائَ۔ (مسلم ۲۱۰۔ ترمذی ۵۵)",": Sahih","Musannaf Ibn Abi Shaybah 21","","","كتاب الطهارة"
"22","(۲۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنِی عَمْرُو بْنُ عَبْدِ اللہِ بْنِ وَہْبٍ النَّخَعِیُّ ، عَنْ زَیْدٍ الْعَمِّیِّ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ قَاَلَ : مَنْ تَوَضَّأَ فَقَالَ : أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَحْدَہُ لاَ شَرِیکَ لَہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، ثَلاَثَ مَرَّاتٍ ، فُتِحَتْ لَہُ ثَمَانیَۃُ أَبْوَابٍ الْجَنَّۃِ ، یَدْخُلُ مِنَ أَیِّہَا شَائَ۔\n(ابن ماجہ ۴۶۹۔ احمد ۳/۲۶۵)",": Da'if","Musannaf Ibn Abi Shaybah 22","","","كتاب الطهارة"
"23","(۲۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عَوْفٍ ، عَنْ أَبِی الْمِنْہَالِ ، أَنَّ أَبَا الْعَالِیَۃِ رَأَی رَجُلاً یَتَوَضَّأُ ، فَلَمَّا فَرَغَ قَالَ : اللَّہُمَّ اجْعَلْنِی مِنَ التَّوَّابِینَ ، وَاجْعَلْنِی مِنَ الْمُتَطَہِّرِینَ ، فَقَالَ : إنَّ الطُّہُورَ بِالْمَائِ حَسَنٌ ، وَلَکِنَّہُمُ الْمُتَطَہِّرُونَ مِنَ الذُّنُوبِ۔","","Musannaf Ibn Abi Shaybah 23","","","كتاب الطهارة"
"24","(۲۴) حَدَّثَنَا الْمُقْرِیئُ ، عَنْ سَعِیدِ بْنِ أَبِی أَیُّوبَ ، قَالَ : حدَّثَنِی زُہْرَۃُ بْنُ مَعْبَدٍ أَبُو عَقِیلٍ ، أَنَّ ابْنَ عَمٍّ لَہُ أَخْبَرَہُ ، أَنََّہُ سَمِعَ عُقْبَۃَ بْنَ عَامِرٍ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : مَنْ تَوَضَّأَ فَأَتَمَّ وُضُوئَہُ ، ثُمَّ رَفَعَ رَأْسَہُ إلَی السَّمَائِ ، فَقَالَ : أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَحْدَہُ لاَ شَرِیکَ لَہُ ، وَأَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، فُتِحَتْ لَہُ ثَمَانیَۃُ أَبْوَابٍ الْجَنَّۃِ ، یَدْخُلُ مِنْ أَیِّہَا شَائَ۔ (احمد ۴/۱۵۰۔ طبرانی ۱۷/۹۱۶)",": Majhul","Musannaf Ibn Abi Shaybah 24","","","كتاب الطهارة"
"25","(۲۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : کَانَ حُذَیْفَۃُ إذَا تَطَہَّرَ قَالَ : أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، اللَّہُمَّ اجْعَلْنِی مِنَ التَّوَّابِینَ ، وَاجْعَلْنِی مِنَ الْمُتَطَہِّرِینَ۔",": Da'if","Musannaf Ibn Abi Shaybah 25","","","كتاب الطهارة"
"26","(۲۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ (ح) وَحَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، کِلاَہُمَا عَنْ سِمَاکِ بْنِ حَرْبٍ ، عنْ مُصْعَبِ بْنِ سَعْدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : لاَ تُقْبَلُ صَلاَۃٌ إِلاَّ بِطُہُورٍ ، وَلاَ صَدَقَۃٌ مِنْ غُلُولٍ۔\n(مسلم۱/۲۰۴۔ ابن ماجہ ۲۷۲)",": Hasan","Musannaf Ibn Abi Shaybah 26","","","كتاب الطهارة"
"27","(۲۷) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنِ ابْنِ سِنَانٍ ، عَنْ أَنَسٍ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ تُقْبَلُ صَدَقَۃٌ مِنْ غُلُولٍ ، وَلاَ صَلاَۃٌ بِغَیْرِ طُہُورٍ۔ (ابن ماجہ ۲۷۳)",": Da'if","Musannaf Ibn Abi Shaybah 27","","","كتاب الطهارة"
"28","(۲۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وُہَیْبٌ ، قَالَ: حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ حَرْمَلَۃَ ، أَنَّہُ سَمِعَ أَبَا ثِفَالٍ یُحَدِّثُ ، قَالَ: سَمِعْتُ رَبَاحَ بْنَ عَبْدِ الرَّحْمَنِ بْنِ أَبِی سُفْیَانَ بْنِ حُوَیْطِبٍ یَقُولُ : حَدَّثَتْنِی جَدَّتِی ، أَنَّہَا سَمِعَتْ أَبَاہَا یَقُولُ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لاَ صَلاَۃَ لِمَنْ لاَ وُضُوئَ لَہُ۔ \n(ترمذی۲۵،۲۶۔ ابن ماجہ ۳۹۸)",": Da'if","Musannaf Ibn Abi Shaybah 28","","","كتاب الطهارة"
"29","(۲۹) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، وَعُبَیْدُ بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی الْمُلَیْحِ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ اللَّہَ لاَ یَقْبَلُ صَلاَۃً بِغَیْرِ طُہُورٍ ، وَلاَ صَدَقَۃً مِنْ غُلُولٍ۔\n(ابوداؤد ۶۰۔ ابن ماجہ ۲۷۱)",": Sahih","Musannaf Ibn Abi Shaybah 29","","","كتاب الطهارة"
"30","(۳۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ آدَمَ بْنِ عَلِیٍّ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : إنَّ أُنَاسًا یُدْعَوْنَ الْمَنْقُوصُونَ یَوْمَ الْقِیَامَۃِ ، فَقَالَ رَجُلٌ : مَنْ ہُمْ أَبَا عَبْدِ الرَّحْمَنِ ؟ قَالَ : کَانَ أَحَدُہُمْ یُنْقِصُ طُہُورَہُ ، وَالْتِفَاتَہُ فِی صَلاَتِہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 30","","","كتاب الطهارة"
"31","(۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : لاَ تُقْبَلُ صَلاَۃٌ إِلاَّ بِطُہُورٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 31","","","كتاب الطهارة"
"32","(۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُجَمِّعُ بْنُ یَحْیَی ، عَنْ خَالِدِ بْنِ زَیْدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ تُقْبَلُ صَلاَۃٌ بِغَیْرِ طُہُورٍ۔",": Hasan","Musannaf Ibn Abi Shaybah 32","","","كتاب الطهارة"
"33","(۳۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنِ الْمُسْتَوْرِدِ بْنِ الأَحْنَفِ ، قَالَ : قَالَ عُمَرُ : لاَ تُقْبَلُ صَلاَۃٌ بِغَیْرِ طُہُورٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 33","","","كتاب الطهارة"
"34","(۳۴) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ أَبِی رَوْحٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ بِأَصْحَابِہِ ، فَقَرَأَ بِسُورَۃِ الرُّومِ ، فَتَرَدَّدَ فِیہَا ، فَلَمَّا انْصَرَفَ قَالَ : إنَّمَا یُلَبِّسُ عَلَیْنَا صَلاَتَنَا قَوْمٌ یَحْضُرُونَ الصَّلاَۃَ بِغَیْرِ طُہُورٍ ، مَنْ شَہِدَ الصَّلاَۃَ فَلْیُحْسِنِ الطُّہُورَ۔ (احمد ۳/۴۷۱۔ نسائی ۱۰۱۹)","","Musannaf Ibn Abi Shaybah 34","","","كتاب الطهارة"
"35","(۳۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ ثَوْبَانَ مَوْلَی رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : لاَ یُحَافِظُ عَلَی الطُّہُورِ إِلاَّ مُؤْمِنٌ۔\n\n(ابن ماجہ۲۷۷۔ احمد ۵/۲۷۶)","","Musannaf Ibn Abi Shaybah 35","","","كتاب الطهارة"
"36","(۳۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : لَنْ یُحَافِظَ عَلَی الْوُضُوئِ إِلاَّ مُؤْمِنٌ۔ (ابن ماجہ ۲۷۸)",": Da'if","Musannaf Ibn Abi Shaybah 36","","","كتاب الطهارة"
"37","(۳۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبَانُ الْعَطَّارُ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ زَیْدِ بْنِ سَلاَّم ، عَنْ أَبِی سَلاَّمٍ ، عَنْ أبِی مَالِکٍ الأَشْعَرِیِّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : الطُّہُورُ شَطْرُ الإِیمَانِ۔\n(احمد ۵/۳۴۲۔ بیہقی ۱/۴۲)",": Sahih","Musannaf Ibn Abi Shaybah 37","","","كتاب الطهارة"
"38","(۳۸) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی لَیْلَی الْکِنْدِیِّ ، عَنْ حِجْرِ بْنِ عَدِیٍّ ، قَالَ : حدَّثَنَا عَلِیٌّ أَنَّ الطُّہُورَ شَطْرُ الإِیمَانِ۔","","Musannaf Ibn Abi Shaybah 38","","","كتاب الطهارة"
"39","(۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ شِمْرٍ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إذَا تَوَضَّأَ الرَّجُلُ الْمُسْلِمُ خَرَجَتْ ذُنُوبُہُ مِنْ سَمْعِہِ وَبَصَرِہِ وَیَدَیْہِ وَرِجْلَیْہِ ، فَإِنْ جَلَسَ جَلَسَ مَغْفُورًا لَہُ۔ (احمد ۵/۲۵۲)",": Da'if","Musannaf Ibn Abi Shaybah 39","","","كتاب الطهارة"
"40","(۴۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ : قُلْتُ یَا رَسُولَ اللہِ ، کَیْفَ تَعْرِفُ مَنْ لَمْ تَرَ مِنْ أُمَّتِکَ ؟ قَالَ : ہُمْ غُرٌّ مُحَجَّلُونَ ، بُلْقٌ مِنْ آثَارِ الْوُضُوئِ۔ (احمد ۱/۴۵۲)",": Da'if","Musannaf Ibn Abi Shaybah 40","","","كتاب الطهارة"
"41","(۴۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ أَبِی یَقُولُ : الْوُضُوئُ شَطْرُ الصَّلاَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 41","","","كتاب الطهارة"
"42","(۴۲) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : تَرِدُونَ عَلَیَّ غُرًّا مُحَجَّلِینَ مِنَ الْوُضُوئِ ، سِیمَائُ أُمَّتِی لَیْسَتْ لأَحَدٍ غَیْرِہَا۔ (ابن ماجہ ۴۲۸۲۔ ابو یعلی ۶۱۸۱)",": Sahih","Musannaf Ibn Abi Shaybah 42","","","كتاب الطهارة"
"43","(۴۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ یَزِیدَ بْنِ طَلْقٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْبَیْلَمَانِیِّ ، عَنْ عَمْرِو بْنِ عَبسَۃَ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ الْعَبْدَ إذَا تَوَضَّأَ فَغَسَلَ یَدَیْہِ ، خَرَّتْ خَطَایَاہُ مِنْ یَدَیْہِ ، وَإِذَا غَسَلَ وَجْہَہُ خَرَّتْ خَطَایَاہُ مِنْ وَجْہِہِ ، وَإِذَا غَسَلَ ذِرَاعَیْہِ وَمَسَحَ بِرَأْسِہِ خَرَّتْ خَطَایَاہُ مِنْ ذِرَاعَیْہِ وَرَأْسِہِ ، وَإِذَا غَسَلَ رِجْلَیْہِ خَرَّتْ خَطَایَاہُ مِنْ رِجْلَیْہِ۔ (ابن ماجہ ۲۸۳)",": Majhul","Musannaf Ibn Abi Shaybah 43","","","كتاب الطهارة"
"44","(۴۴) حَدَّثنَاَ یَحْیَی بْنُ أَبِی بُکَیْر ، قَالَ : حدَّثَنَا زُہَیْرُ بْنُ مُحَمَّدٍ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی سَعِیدٍ ، أَنَّہُ سَمِعَ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : أَلاَ أَدُلُّکُمْ عَلَی شَیْئٍ یُکَفِّرُ اللَّہُ بِہِ الْخَطَایَا وَیَزِیدُ بِہِ فِی الْحَسَنَاتِ ؟ قَالُوا : بَلَی ، یَا رَسُولَ اللہِ ، قَالَ : إسْبَاغُ الْوُضُوئِ عِنْدَ الْمَکَارِہِ ، وَکَثْرَۃُ الْخُطَی إلَی ہَذِہِ الْمَسَاجِدِ۔ (ابن ماجہ ۴۲۷۔ ابو یعلی ۱۳۵۰)",": Da'if","Musannaf Ibn Abi Shaybah 44","","","كتاب الطهارة"
"45","(۴۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ کَثِیرِ بْنِ مُدْرِکٍ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، قَالَ : قَالَ عَبْدُ اللہِ : الْکَفَّارَاتُ إسْبَاغُ الْوُضُوئِ بِالسَّبَرَاتِ ، وَنَقْلُ الأَقْدَامِ إلَی الْجُمُعَاتِ ، وَانْتِظَارُ الصَّلاَۃِ بَعْدَ الصَّلاَۃِ۔",": Hasan","Musannaf Ibn Abi Shaybah 45","","","كتاب الطهارة"
"46","(۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی صَخْرَۃَ ، قَالَ : سَمِعْتُ حُمْرَانَ یَقُولُ : کُنْتُ أَضَعُ لِعُثْمَانَ طَہُورَہُ ، فَقَالَ : حَدَّثَنَا رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : مَا مِنْ رَجُلٍ یَتَوَضَّأُ فَیُحْسِنُ الْوُضُوئَ ، إِلاَّ غُفِرَ لَہُ مَا بَیْنَہُ وَبَیْنَ الصَّلاَۃِ الأُخْرَی۔ (مسلم ۱/۲۰۷)",": Sahih","Musannaf Ibn Abi Shaybah 46","","","كتاب الطهارة"
"47","(۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ سَالِمٍ ، عَنْ یَزِیدَ بْنِ بِشْرٍ ، قَالَ : إنَّ اللَّہَ أَوْحَی إلَی مُوسَی أَنْ تَوَضَّہُ ، فَإِنْ لَمْ تَفْعَلْ فَأَصَابَتْک مُصِیبَۃٌ ، فَلاَ تَلُومَنَّ إِلاَّ نَفْسَک۔",": No Data Available","Musannaf Ibn Abi Shaybah 47","","","كتاب الطهارة"
"48","(۴۸) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ الرَّازِیّ ، عَنْ أَبِی سِنَانٍ ، عَنْ ثَابِتٍ ، عَنِ الضَّحَّاکِ ؛ فِی قَوْلِہِ تَعَالَی : (وَقُومُوا لِلَّہِ قَانِتِینَ) ، قَالَ : مُطِیعِینَ لِلَّہِ فِی الْوُضُوئِ۔ (بقرہ آیت ۲۳۸)",": No Data Available","Musannaf Ibn Abi Shaybah 48","","","كتاب الطهارة"
"49","(۴۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنْ حُمْرَانَ ، قَالَ : سَمِعْتُ عُثْمَانَ یَقُولُ : مَنْ تَوَضَّأَ فَأَحْسَنَ الْوُضُوئَ وَأَسْبَغَہُ وَأَتَمَّہُ ، خَرَجَتْ خَطَایَاہُ مِنْ جَسَدِہِ حَتَّی تَخْرُجَ مِنْ تَحْتِ أَظْفَارِہِ۔ (مسلم ۱/۲۱۶)",": Sahih","Musannaf Ibn Abi Shaybah 49","","","كتاب الطهارة"
"50","(۵۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ سَلَمَۃَ بْنِ سَبْرَۃَ ، عَنْ سَلْمَانَ ، قَالَ : إذَا تَوَضَّأَ الرَّجُلُ الْمُسْلِمُ ، وُضِعَتْ خَطَایَاہُ عَلَی رَأْسِہِ فَتَحَاتَتْ ، کَمَا یَتَحَاتُّ عِذْقُ النَّخْلَۃِ۔ (ابن حبان ۴/۳۱۷)",": Majhul","Musannaf Ibn Abi Shaybah 50","","","كتاب الطهارة"
"51","(۵۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ شَقِیقٍ ، عَنْ سَلَمَۃَ بْنِ سَبْرَۃَ ، عَنْ سَلْمَانَ مِثْلَہُ۔",": Majhul","Musannaf Ibn Abi Shaybah 51","","","كتاب الطهارة"
"52","(۵۲) حَدَّثَنَا قَبِیصَۃُ بْنُ عُقْبَۃَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : کُنْتُ مَعَ سَلْمَانَ فَأَخَذَ غُصْنًا مِنْ شَجَرَۃٍ یَابِسَۃٍ فَحَتَّہُ ، ثُمَّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ تَوَضَّأَ فَأَحْسَنَ الْوُضُوئَ ، تَحَاتَّتْ خَطَایَاہُ کَمَا یَتَحَاتُّ الْوَرَقُ۔ (احمد۴۳۷، جلد۵ ۔ طبرانی ۶۱۵۱)",": Da'if","Musannaf Ibn Abi Shaybah 52","","","كتاب الطهارة"
"53","(۵۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ الإِفْرِیقِیِّ ، عَنْ أَبِی غُطَیْفٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ تَوَضَّأَ عَلَی طُہْرٍ کُتِبَ لَہُ عَشْرُ حَسَنَاتٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 53","","","كتاب الطهارة"
"54","(۵۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی حَیَّۃَ ، قَالَ : رَأَیْتُ عَلِیًّا تَوَضَّأَ فَأَنْقَی کَفَّیْہِ ، ثُمَّ غَسَلَ وَجْہَہُ ثَلاَثًا وَذِرَاعَیْہِ ثَلاَثًا ، وَمَسَحَ بِرَأْسِہِ ، ثُمَّ غَسَلَ قَدَمَیْہِ إلَی الْکَعْبَیْنِ ، ثُمَّ قَامَ فَشَرِبَ فَضْلَ وَضُوئِہِ ، ثُمَّ قَالَ : إنَّمَا أَرَدْتُ أَنْ أُرِیَکُمْ طُہُورَ رَسُولِ اللّٰہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ۔ (ابوداؤد ۱۱۷۔ ترمذی ۴۸)",": Hasan","Musannaf Ibn Abi Shaybah 54","","","كتاب الطهارة"
"55","(۵۵) حَدَّثَنَا شَرِیکٌ ، عَنْ خَالِدِ بْنِ عَلْقَمَۃَ ، عَنْ عَبْدِ خَیْرٍ ، عَنْ عَلِیٍّ ، قَالَ : تَوَضَّأَ فَمَضْمَضَ ثَلاَثًا وَاسْتَنْشَقَ ثَلاَثًا مِنْ کَفٍّ وَاحِدٍ وَغَسَلَ وَجْہَہُ ثَلاَثًا ، ثُمَّ أَدْخَلَ یَدَہُ فِی الرَّکْوَۃِ فَمَسَحَ رَأْسَہُ وَغَسَلَ رِجْلَیْہِ ، ثُمَّ قَالَ : ہَذَا وُضُوئُ نَبِیِّکُمْ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ۔ (ابن خزیمۃ ۱۴۷۔ ابن حبان ۱۰۵۶)",": Hasan","Musannaf Ibn Abi Shaybah 55","","","كتاب الطهارة"
"56","(۵۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ مُسْلِمِ بْنِ یَسَارٍ ، عَنْ حُمْرَانَ ، قَالَ : دَعَا عُثْمَانُ بِمَائٍ فَتَوَضَّأَ ثُمَّ ضَحِکَ ، فَقَالَ : أَلاَ تَسْأَلُونِی مِمَّا أَضْحَکُ ؟ قَالُوا : یَا أَمِیرَ الْمُؤْمِنِینَ مَا أَضْحَکَک ؟ قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ کَمَا تَوَضَّأْتُ فَمَضْمَضَ وَاسْتَنْشَقَ وَغَسَلَ وَجْہَہُ ثَلاَثًا وَیَدَیْہِ ثَلاَثًا ، وَمَسَحَ بِرَأْسِہِ وَظَہْرِ قَدَمَیْہِ۔ (احمد ۲۵۸، جلد۱)",": Da'if","Musannaf Ibn Abi Shaybah 56","","","كتاب الطهارة"
"57","(۵۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ یَحْیَی ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ زَیْدٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ فَغَسَلَ وَجْہَہُ ثَلاَثًا وَیَدَیْہِ مَرَّتَیْنِ ، وَمَسَحَ بِرَأْسِہِ وَرِجْلَیْہِ مَرَّتَیْنِ۔ (بخاری ۱۸۵۔ مسلم ۲۱۱)",": Sahih","Musannaf Ibn Abi Shaybah 57","","","كتاب الطهارة"
"58","(۵۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ؛ أَنَّ رَجُلاً سَأَلَ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ عَنِ الْوُضُوئِ ؟ فَدَعَا بِمَائٍ فَتَوَضَّأَ ثَلاَثًا ثَلاَثًا ، ثُمَّ قَالَ : ہَکَذَا الطُّہُورُ ، فَمَنْ زَادَ ، أَوْ نَقَصَ فَقَدْ تَعَدَّی ، أًوْظَلَمَ۔ (ابوداؤد ۱۳۶، جلد۲)",": Hasan","Musannaf Ibn Abi Shaybah 58","","","كتاب الطهارة"
"59","(۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنِ الرُّبَیِّعِ بِنْتِ مُعَوِّذِ بْنِ عَفْرَائَ ، قَالَتْ : أَتَانَا رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَوَضَعْنَا لَہُ الْمِیضَأَۃَ فَتَوَضَّأَ ثَلاَثًا ثَلاَثًا ، وَمَسَحَ بِرَأْسِہِ یَبْدَأَُ بِمُؤَخَّرِہِ۔\n(احمد ۳۵۹، جلد۶)",": Da'if","Musannaf Ibn Abi Shaybah 59","","","كتاب الطهارة"
"60","(۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ عُقْبَۃَ الْمُرَادِیِّ ، أَبِی کِبْرَانَ ، قَالَ : سَمِعْتُ عَبْدَ خَیْرٍ الْہَمْدَانِیَّ یَقُولُ : قَالَ عَلِیٌّ : أَلاَ أُرِیکُمْ وُضُوئَ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ؟ ثُمَّ تَوَضَّأَ ثَلاَثًا ، ثَلاَثًا۔",": Hasan","Musannaf Ibn Abi Shaybah 60","","","كتاب الطهارة"
"61","(۶۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَمْرِو بْنِ دِینَار ، عَنْ سُمَیْعٍ ، عَنْ أَبِی أُمَامَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ فَغَسَلَ یَدَیْہِ ثَلاَثًا ، وَتَمَضْمَضَ وَاسْتَنْشَقَ ثَلاَثًا ثَلاَثًا ، وَتَوَضَّأَ ثَلاَثًا ثَلاَثًا۔ (احمد ۲۵۸، جلد۵۔ طبرانی ۷۹۹۰)",": Majhul","Musannaf Ibn Abi Shaybah 61","","","كتاب الطهارة"
"62","(۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی النَّضْرِ ، عَنْ أَبِی أَنَسٍ ؛ أَنَّ عُثْمَانَ تَوَضَّأَ بِالْمَقَاعِدِ ، فَقَالَ : أَلاَ أُرِیکُمْ وُضُوئَ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ؟ ثُمَّ تَوَضَّأَ لَنَا ثَلاَثًا ثَلاَثًا۔ (دار قطنی ۱۱۔ مسلم ۹)",": Sahih","Musannaf Ibn Abi Shaybah 62","","","كتاب الطهارة"
"63","(۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَامِرِ بْنِ شَقِیقٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ عُثْمَانَ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ ثَلاَثًا ثَلاَثًا۔",": Hasan","Musannaf Ibn Abi Shaybah 63","","","كتاب الطهارة"
"64","(۶۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَطَائِ بْنِ یَسَارٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ ، فَغَرَفَ غَرْفَۃً فَمَضْمَضَ مِنْہَا وَاسْتَنْثَرَ ، ثُمَّ غَرَفَ غَرْفَۃً فَغَسَلَ وَجْہَہُ ، ثُمَّ غَرَفَ غَرْفَۃً فَغَسَلَ یَدَہُ الْیُمْنَی ، ثُمَّ غَرَفَ غَرْفَۃً فَغَسَلَ یَدَہُ الْیُسْرَی ، ثُمَّ غَرَفَ غَرْفَۃً فَمَسَحَ رَأْسَہُ وَأُذُنَیْہِ دَاخِلَہُمَا بالسَّبَّابَتَیْنِ ، وَخَالَفَ بِإِبْہَامَیْہِ إلَی ظَاہِرِ أُذُنَیْہِ فَمَسَحَ بَاطِنَہُمَا وَظَاہِرَہُمَا ، ثُمَّ غَرَفَ غَرْفَۃً فَغَسَلَ رِجْلَہُ الْیُمْنَی ، ثُمَّ غَرَفَ غَرْفَۃً فَغَسَلَ رِجْلَہُ الْیُسْرَی۔ (ابن ماجہ۴۳۹۔ نسائی ۱۰۵)",": Hasan","Musannaf Ibn Abi Shaybah 64","","","كتاب الطهارة"
"65","(۶۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ؛ أَنَّ عُثْمَانَ تَوَضَّأَ ثَلاَثًا ثَلاَثًا ، وَمَسَحَ بِرَأْسِہِ مَسْحَۃً ، وَغَسَلَ رِجْلَیْہِ غَسْلاً ، ثُمَّ قَالَ : ہَکَذَا رَأَیْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ۔",": Da'if","Musannaf Ibn Abi Shaybah 65","","","كتاب الطهارة"
"66","(۶۶) حَدَّثَنَا شَرِیکٌ ، عَنْ ثَابِتٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : قُلْتُ لَہُ : حُدِّثْتَ عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ مَرَّۃً مَرَّۃً ؟ قَالَ : نَعَمْ۔ (ابن ماجہ ۴۱۰۔ دار قطنی ۸)",": Da'if","Musannaf Ibn Abi Shaybah 66","","","كتاب الطهارة"
"67","(۶۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ بَیَانٍ، عَنِ الشَّعْبِیِّ، عَنْ قَرَظَۃَ ، قَالَ : شَیَّعْنَا عُمَرَ إلَی صِرَارٍ ، فَتَوَضَّأَ فَغَسَلَ مَرَّتَیْنِ۔ \n(ابن سعد ۷)",": Sahih","Musannaf Ibn Abi Shaybah 67","","","كتاب الطهارة"
"68","(۶۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ قَرَظَۃَ ، قَالَ ، سَمِعْتُ عُمَرَ یَقُولُ : الْوُضُوئُ ثَلاَثٌ ثَلاَثٌ ، وَثِنْتَانِ تُجْزِیَانِ۔",": Da'if","Musannaf Ibn Abi Shaybah 68","","","كتاب الطهارة"
"69","(۶۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، عَنْ عُمَرَ ، قَالَ : فِی الْمَضْمَضَۃِ ، وَالْاِسْتِنْشَاقِ ، وَغَسْلِ الْوَجْہِ ، وَغَسْلِ الْیَدَیْنِ وَالرِّجْلَیْنِ ثِنْتَانِ تُجْزیَانِ ، وَثَلاَثٌ أَفْضَلُ۔",": Da'if","Musannaf Ibn Abi Shaybah 69","","","كتاب الطهارة"
"70","(۷۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ مُسْلِمِ بْنِ صُبَیْحٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یَتَوَضَّأُ ثَلاَثًا ثَلاَثًا ، ثُمَّ مَسَحَ بِرَأْسِہِ وَأُذُنَیْہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 70","","","كتاب الطهارة"
"71","(۷۱) حَدَّثَنَا جَرِیرٌ ، عَنْ یَزِیدَ ، قَالَ : رَأَیْتُ عَبْدَ الرَّحْمَنِ بْنَ أَبِی لَیْلَی تَوَضَّأَ فَمَضْمَضَ وَاسْتَنْشَقَ مَرَّۃً ، أَوْ مَرَّتَیْنِ ، وَغَسَلَ وَجْہَہُ ثَلاَثًا وَذِرَاعَیْہِ ثَلاَثًا ثَلاَثًا ، وَمَسَحَ بِرَأْسِہِ وَغَسَلَ رِجْلَیْہِ ثَلاَثًا ثَلاَثًا ، وَلَمْ أَرَہُ خَلَّلَ لِحْیَتَہُ، ثُمَّ قَالَ : ہَکَذَا رَأَیْتُ عَلِیًّا تَوَضَّأَ۔",": Da'if","Musannaf Ibn Abi Shaybah 71","","","كتاب الطهارة"
"72","(۷۲) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مُسْلِمٍ ، قَالَ : رَأَیْتُ عَبْدَ الرَّحْمَنِ بْنَ أَبِی لَیْلَی تَوَضَّأَ ثَلاَثًا ثَلاَثًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 72","","","كتاب الطهارة"
"73","(۷۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ إسْمَاعِیلَ بْنِ إبْرَاہِیمَ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ تَوَضَّأَ فِی دَارِ النَّدْوَۃِ مَرَّۃً مَرَّۃً۔",": Da'if","Musannaf Ibn Abi Shaybah 73","","","كتاب الطهارة"
"74","(۷۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَطَائِ بْنِ یَسَارٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ غَرْفَۃً غَرْفَۃً۔",": Hasan","Musannaf Ibn Abi Shaybah 74","","","كتاب الطهارة"
"75","(۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، أَنَّ عُمَرَ تَوَضَّأَ مَرَّتَیْنِ ، قَالَ عَامِرٌ : وَفَعَلَہُ أَبُو بَکْرٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 75","","","كتاب الطهارة"
"76","(۷۶) حَدَّثَنَا وَکِیعٌ ، وَالْفَضْلُ قَالاَ : حَدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، قَالَ : رَأَیْتُ سَالِمَ بْنَ عَبْدِ اللہِ تَوَضَّأَ مَرَّۃً مَرَّۃً۔",": No Data Available","Musannaf Ibn Abi Shaybah 76","","","كتاب الطهارة"
"77","(۷۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، وَابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُجْزِئُکَ مِنَ الْوُضُوئِ مَرَّتَیْنِ مَرَّتَیْنِ ، وَإِنْ ثَلَّثْتَ فَقَدْ أَسْبَغْت۔",": No Data Available","Musannaf Ibn Abi Shaybah 77","","","كتاب الطهارة"
"78","(۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : الْوُضُوئُ وِتْرٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 78","","","كتاب الطهارة"
"79","(۷۹) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ کَمْ یَکْفِی مِنَ الْوُضُوئِ عَنِ الْوَجْہِ وَالذِّرَاعَیْنِ ؟ قَالَ : مَا أَرَی وَاحِدَۃً سَابِغَۃً إِلاَّ کَافِیَۃً ، قَالَ : فَقُلْتُ لَہُ : إنَّ مَیْمُونًا یَقُولُ : ثَلاَثٌ عَلَی الْوَجْہِ وَثَلاَثٌ عَلَی الذِّرَاعَیْنِ ! فَقَالَ : ذَلِکَ أَبْلَغُ الْوُضُوئِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 79","","","كتاب الطهارة"
"80","(۸۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا الْجَرِیرِیُّ ، عَنْ عُرْوَۃَ بْنِ قَبِیصَۃَ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ ، عَنْ أَبِیہِ ؛ أَنَّ عُثْمَانَ قَالَ : أَلاَ أُرِیکُمْ کَیْفَ کَانَ وُضُوئُ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ؟ قَالُوا : بَلَی ، فَدَعَا بِمَائٍ فَمَضْمَضَ ثَلاَثًا ، وَاسْتَنْشَقَ ثَلاَثًا ، وَغَسَلَ وَجْہَہُ ثَلاَثًا ، وَذِرَاعَیْہِ ثَلاَثًا ، وَمَسَحَ بِرَأْسِہِ وَغَسَلَ قَدَمَیْہِ ، ثُمَّ قَالَ : وَاعْلَمُوا أَنَّ الأُذُنَیْنِ مِنَ الرَّأْسِ ، ثُمَّ قَالَ : تَحَرَّیْتُ ، أَوْ تَوَخَّیْتُ لَکُمْ وُضُوئَ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ۔ (احمد ۶۱، جلد۱۔ دار قطنی ۱۰۴)",": Da'if","Musannaf Ibn Abi Shaybah 80","","","كتاب الطهارة"
"81","(۸۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ، عَنْ عَبْدِ اللہِ بْنِ الْفَضْلِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ ہُرْمُزَ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ مَرَّتَیْنِ مَرَّتَیْنِ۔ \n(ابوداؤد ۱۳۷۔ ترمذی۴۳)",": Hasan","Musannaf Ibn Abi Shaybah 81","","","كتاب الطهارة"
"82","(۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ جَابِرٍ ، عَنِ الْحَسَنِ ، قَالَ : الْوُضُوئُ مَرَّۃً وَمَرَّتَانِ وَثَلاَثٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 82","","","كتاب الطهارة"
"83","(۸۳) حَدَّثَنَا وَکِیعٌ ، قَالَ حَدَّثَنَا دَاوُدُ بْنُ قَیْسٍ ، عَنْ عُبَیْدِ اللہِ بْنِ مِقْسَمٍ ، عَنِ الْقَاسِمِ قَالَ : أَمَّا مَنْ کَانَ یُحْسِنُ الْوُضُوئَ فَمَرَّۃً مَرَّۃً۔",": No Data Available","Musannaf Ibn Abi Shaybah 83","","","كتاب الطهارة"
"84","(۸۴) حَدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ، عَنْ إسْمَاعِیلَ بْنِ کَثِیرٍ ، عَنْ عَاصِمِ بْنِ لَقِیطِ بْنِ صَبِرَۃَ ، عَنْ أَبِیہِ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، أَخْبِرْنِی عَنِ الْوُضُوئِ ؟ قَالَ : أَسْبِغِ الْوُضُوئَ ، وَخَلِّلْ بَیْنَ الأَصَابِعِ ، وَبَالِغْ فِی الاِسْتِنْشَاقِ ، إِلاَّ أَنْ تَکُونَ صَائِمًا۔ (ابن ماجہ ۴۴۸۔ ابوداؤد ۱۴۳)",": Hasan","Musannaf Ibn Abi Shaybah 84","","","كتاب الطهارة"
"85","(۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ وَاقِدٍ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، قَالَ : مَرَّ عُمَرُ عَلَی قَوْمٍ یَتَوَضَّؤُونَ ، فَقَالَ : خَلِّلُوا۔",": Da'if","Musannaf Ibn Abi Shaybah 85","","","كتاب الطهارة"
"86","(۸۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنِ أَبیِ مِسْکِینٍ ، عَنْ ہُزَیْلٍ ، قَالَ : قَالَ عَبْدُ اللہِ : لَیَنْہَکَنَّ الرَّجُلُ مَا بَیْنَ أَصَابِعِہِ بِالْمَائِ ، أَوْ لَتَنْہَکَنَّہُ النَّارُ۔ (عبدالرزاق ۶۸)",": Sahih","Musannaf Ibn Abi Shaybah 86","","","كتاب الطهارة"
"87","(۸۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : حدَّثَنِی مَنْ سَمِعَ حُذَیْفَۃَ یَقُولُ : خَلِّلُوا بَیْنَ الأَصَابِعِ فِی الْوُضُوئِ قَبْلَ أَنْ تُخَلِّلَہَا النَّارُ۔",": Da'if","Musannaf Ibn Abi Shaybah 87","","","كتاب الطهارة"
"88","(۸۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عِمْرَانَ بْنِ أَبِی عَطَائٍ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ تَوَضَّأَ فَغَسَلَ قَدَمَیْہِ حَتَّی تَتَبَّعَ بَیْنَ أَصَابِعِہِ فَغَسَلَہُنَّ۔",": Da'if","Musannaf Ibn Abi Shaybah 88","","","كتاب الطهارة"
"89","(۸۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ شَیْبَۃَ بْنِ نِصَاحٍ ، قَالَ : صَحِبْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ إلَی مَکَّۃَ فَرَأَیْتُہُ إذَا تَوَضَّأَ لِلصَّلاَۃِ یُدْخِلُ أَصَابِعَ یَدَیْہِ بَیْنَ أَصَابِعِ رِجْلَیْہِ ، قَالَ : وَہُوَ یَصُبُّ الْمَائَ عَلَیْہَا ، فَقُلْتُ لَہُ : یَا أَبَا مُحَمَّدٍ ، لِمَ تَصْنَعُ ہَذَا ؟ فَقَالَ : رَأَیْتُ عَبْدَ اللہِ بْنَ عُمَرَ یَصْنَعُہُ۔",": Hasan","Musannaf Ibn Abi Shaybah 89","","","كتاب الطهارة"
"90","(۹۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ رَآہُ فِی سَفَرٍ یَنْزِعُ خُفَّیْہِ ، ثُمَّ یُخَلِّلُ أَصَابِعَہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 90","","","كتاب الطهارة"
"91","(۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ طَلْحَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : خَلِّلُوا بَیْنَ أَصَابِعِکُمْ بِالْمَائِ قَبْل أَنْ تَحْشُوَہَا النَّارُ۔ (طبرانی ۹۲۱۳)",": Da'if","Musannaf Ibn Abi Shaybah 91","","","كتاب الطهارة"
"92","(۹۲) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی التَّیْمِیُّ ، عَنْ مَنْصُورٍ ، عَنْ طَلْحَۃَ ، عَنْ عَبْدِ اللہِ ، بِمِثْلِ حَدِیثِ ابْنِ نُمَیْرٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 92","","","كتاب الطهارة"
"93","(۹۳) حَدَّثَنَا وَکِیعٌ ، عَنِ أَبیِ مَکِینٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : إذَا تَوَضَّأْتَ فَابْدَأْ بِأَصَابِعِکَ فَخَلِّلْہَا ، فَإِنَّہُ کَانَ یُقَالُ : ہُوَ مَقِیلُ الشَّیْطَانِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 93","","","كتاب الطهارة"
"94","(۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، قَالَ : رَأَیْتُ ابْنَ الْحَنَفِیَّۃِ تَوَضَّأَ ، فَخَلَّلَ أَصَابِعَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 94","","","كتاب الطهارة"
"95","(۹۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : خَلِّلُوا أَصَابِعَکُمْ بِالْمَائِ ، لاَ تُخَلِّلُہَا نَارٌ قَلِیلٌ بُقْیاہا۔",": No Data Available","Musannaf Ibn Abi Shaybah 95","","","كتاب الطهارة"
"96","(۹۶) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہِشَامٍ ، عَنْ یَحْیَی ، أَنَّ أَبَا بَکْرٍ الصِّدِّیقَ ، قَالَ : لَتُخَلِّلُنَّ أَصَابِعَکُمْ بِالْمَائِ، أَوْ لَیُخَلِّلَنَّہَا اللَّہُ بِالنَّارِ۔",": Da'if","Musannaf Ibn Abi Shaybah 96","","","كتاب الطهارة"
"97","(۹۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ وَاصِلِ بْنِ السَّائِبِ ، عَنْ أَبِی سَوْرَۃَ ، عَنْ عَمِّہِ أَبِی أَیُّوبَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : حَبَّذَا الْمُتَخَلِّلُونَ ، أَنْ تُخَلِّلَ بَیْنَ أَصَابِعِکَ بِالْمَائِ ، وَأَنْ تُخَلِّلَ مِنَ الطَّعَامِ۔ (طبرانی ۴۰۶۱۔ احمد ۴۱۶، جلد۵)",": Da'if","Musannaf Ibn Abi Shaybah 97","","","كتاب الطهارة"
"98","(۹۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ حَسَّانَ بْنِ بِلاَلٍ ، قَالَ : رَأَیْتُ عَمَّارَ بْنَ یَاسِرٍ تَوَضَّأَ فَخَلَّلَ لِحْیَتَہُ ، فَقُلْتُ لَہُ ؟ فَقَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَعَلَہُ۔ (ترمذی ۳۰۔ ابن ماجہ ۴۲۹)",": Da'if","Musannaf Ibn Abi Shaybah 98","","","كتاب الطهارة"
"99","(۹۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی حَمْزَۃَ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ یُخَلِّلُ لِحْیَتَہُ إذَا تَوَضَّأَ۔",": Da'if","Musannaf Ibn Abi Shaybah 99","","","كتاب الطهارة"
"100","(۱۰۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُخَلِّلُ لِحْیَتَہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 100","","","كتاب الطهارة"
"101","(۱۰۱) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی مَعْنٍ ، قَالَ : رَأَیْتُ أَنَسًا تَوَضَّأَ فَخَلَّلَ لِحْیَتَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 101","","","كتاب الطهارة"
"102","(۱۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُخَلِّلُ لِحْیَتَہُ إذَا تَوَضَّأَ۔",": Hasan","Musannaf Ibn Abi Shaybah 102","","","كتاب الطهارة"
"103","(۱۰۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ تَوَضَّأَ وَخَلَّلَ لِحْیَتَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 103","","","كتاب الطهارة"
"104","(۱۰۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمُعَلَّی بْنِ جَابِرٍ ، عَنِ الأَزْرَقِ بْنِ قَیْسٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یُخَلِّلُ لِحْیَتَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 104","","","كتاب الطهارة"
"105","(۱۰۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ النَّضْرِ بْنِ مَعْبَدٍ ، قَالَ : رَأَیْتُ أَبَا قِلاَبَۃَ إذَا تَوَضَّأَ خَلَّلَ لِحْیَتَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 105","","","كتاب الطهارة"
"106","(۱۰۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا الْحَسَنُ بْنُ صَالِحٍ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، عَنْ یَزِیدَ الرَّقَاشِیِّ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا تَوَضَّأَ یُخَلِّلُ لِحْیَتَہُ۔ (ابن ماجہ ۴۳۱۔ ابن سعد ۳۸۶)",": Da'if","Musannaf Ibn Abi Shaybah 106","","","كتاب الطهارة"
"107","(۱۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یُخَلِّلُ لِحْیَتَہُ إذَا تَوَضَّأَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 107","","","كتاب الطهارة"
"108","(۱۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، قَالَ : رَأَیْتُ ابْنَ سِیرِینَ تَوَضَّأَ فَخَلَّلَ لِحْیَتَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 108","","","كتاب الطهارة"
"109","(۱۰۹) حَدَّثَنَا ابن إدْرِیسَ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ ابْنُ سِیرِینَ یُخَلِّلُہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 109","","","كتاب الطهارة"
"110","(۱۱۰) حَدَّثَنَا یَحْیَی بْنُ الْیَمَانِ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ، عَنِ الضَّحَّاکِ، قَالَ: رَأَیْتُہ یُخَلِّلُ لِحْیَتَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 110","","","كتاب الطهارة"
"111","(۱۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی عَاصِمٍ ، عَنْ رَجُلٍ لَمْ یُسَمِّہِ ؛ أَنَّ عَلِیًّا مَرَّ عَلَی رَجُلٍ یَتَوَضَّأُ ، فَقَالَ : خَلِّلْ ، یَعْنِی لِحْیَتَہُ۔`",": Da'if","Musannaf Ibn Abi Shaybah 111","","","كتاب الطهارة"
"112","(۱۱۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ عُمَرَ بْنِ سُلَیْمٍ الْبَاہِلِیِّ ، قَالَ : حدَّثَنِی أَبُو غَالِبٍ ، قَالَ : قُلْتُ لأَبِی أُمَامَۃَ : أَخْبِرْنَا عَنْ وُضُوئِ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَتَوَضَّأَ ثَلاَثًا ، وَخَلَّلَ لِحْیَتَہُ ، وَقَالَ : ہَکَذَا رَأَیْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَفْعَلُ۔",": Hasan","Musannaf Ibn Abi Shaybah 112","","","كتاب الطهارة"
"113","(۱۱۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ عَامِرِ بْنِ شَقِیقٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : رَأَیْتُ عُثْمَانَ یَتَوَضَّأُ فَخَلَّلَ لِحْیَتَہُ ثَلاَثًا ، وَقَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَعَلَہُ۔(ابن حبان ۱۰۸۱۔ ترمذی ۳۱)",": Hasan","Musannaf Ibn Abi Shaybah 113","","","كتاب الطهارة"
"114","(۱۱۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الْہَیْثُمِّ بْنِ جَمَّازٍ ، عَنْ یَزِیدَ بْنِ أَبَانَ ، عَنْ أَنَسٍ ؛ عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: أَتَانِی جِبْرِیلُ فَقَالَ : إذَا تَوَضَّأْتَ فَخَلِّلْ لِحْیَتَک۔",": Da'if","Musannaf Ibn Abi Shaybah 114","","","كتاب الطهارة"
"115","(۱۱۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إذَا تَوَضَّأَ خَلَّلَ لِحْیَتَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 115","","","كتاب الطهارة"
"116","(۱۱۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ ، حَدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ أَبِی الْہَیْثُمِّ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ تَوَضَّأَ وَخَلَّلَ لِحْیَتَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 116","","","كتاب الطهارة"
"117","(۱۱۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدِ الزُّبَیْدِیِّ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ : أُخَلِّلُ لِحْیَتِی بِالْمَائِ ، أَوْ یَکْفِیہَا مَا مَرَّ عَلَیْہَا ؟ قَالَ : یَکْفِیہَا مَا مَرَّ عَلَیْہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 117","","","كتاب الطهارة"
"118","(۱۱۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ الْحَسَنُ لاَ یَفْعَلُ ، یَعْنِی لاَ یُخَلِّلُ لِحْیَتَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 118","","","كتاب الطهارة"
"119","(۱۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : رَأَیْتُہُ مَسَحَ جَانِبَیْ لِحْیَتِہِ وَعَارِضَیْہِ ، وَلَمْ یُخَلِّلْہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 119","","","كتاب الطهارة"
