hadiths[89]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"2810","«بابان معجلان عقوبتهما في الدنيا: البغي والعقوق»","صحيح","Sahih al-Jami al-Saghir 2810","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2811","«بادروا الصبح بالوتر»","صحيح","Sahih al-Jami al-Saghir 2811","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2812","«بادروا بالأعمال ستا: إمارة السفهاء وكثرة الشرط وبيع الحكم واستخفافا بالدم وقطيعة الرحم ونشوا يتخذون القرآن مزامير يقدمون أحدهم ليغنيهم وإن كان أقلهم فقها»","صحيح","Sahih al-Jami al-Saghir 2812","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2813","«بادروا بالأعمال ستا: طلوع الشمس من مغربها والدخان ودابة الأرض والدجال وخويصة أحدكم وأمر العامة»","صحيح","Sahih al-Jami al-Saghir 2813","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2814","«بادروا بالأعمال فتنا كقطع الليل المظلم يصبح الرجل مؤمنا ويمسي كافرا ويمسي مؤمنا ويصبح كافرا يبيع أحدهم دينه بعرض من الدنيا قليل»","صحيح","Sahih al-Jami al-Saghir 2814","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2815","«بادروا بصلاة المغرب قبل طلوع النجم»","حسن","Sahih al-Jami al-Saghir 2815","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2816","«بحسب أصحابي القتل»","صحيح","Sahih al-Jami al-Saghir 2816","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2817","«بخ بخ لخمس ما أثقلهن في الميزان: لا إله إلا الله وسبحان الله والحمد لله والله أكبر والولد الصالح يتوفى للمرء المسلم فيحتسبه»","صحيح","Sahih al-Jami al-Saghir 2817","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2818","«برئت الذمة ممن أقام مع المشركين في ديارهم»","حسن","Sahih al-Jami al-Saghir 2818","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2819","«بر الحج إطعام الطعام وطيب الكلام»","حسن","Sahih al-Jami al-Saghir 2819","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2820","«بسم الله الرحمن الرحيم من محمد عبد الله ورسوله إلى هرقل عظيم الروم سلام على من اتبع الهدى أما بعد; فإني أدعوك بدعاية الإسلام أسلم تسلم يؤتك الله أجرك مرتين فإن توليت فإن عليك إثم الأريسيين و {يَا أَهْلَ الْكِتَابِ تَعَالَوْا إِلَى كَلِمَةٍ سَوَاءٍ بَيْنَنَا وَبَيْنَكُمْ أَلَّا نَعْبُدَ إِلَّا اللَّهَ وَلا نُشْرِكَ بِهِ شَيْئاً وَلا يَتَّخِذَ بَعْضُنَا بَعْضاً أَرْبَاباً مِنْ دُونِ اللَّهِ فَإِنْ تَوَلَّوْا فَقُولُوا اشْهَدُوا بِأَنَّا مُسْلِمُونَ} »","صحيح","Sahih al-Jami al-Saghir 2820","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2821","«بسم الله الرحمن الرحيم هذا ما اشترى العداء بن خالد بن هوذة من محمد رسول الله صلى الله عليه وسلم اشترى منه عبدا أو أمة على أن لا داء ولا غائلة ولا خبثة بيع المسلم للمسلم»","حسن","Sahih al-Jami al-Saghir 2821","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2822","«بشرى الدنيا الرؤيا الصالحة»","صحيح","Sahih al-Jami al-Saghir 2822","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2823","«بشر المشائين في الظلم إلى المساجد بالنور التام يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 2823","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2824","«بشر الناس أنه من قال: لا إله إلا الله وحده لا شريك له وجبت له الجنة»","صحيح","Sahih al-Jami al-Saghir 2824","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2825","«بشر هذه الأمة بالسناء والدين والرفعة والنصر والتمكين في الأرض فمن عمل منهم عمل الآخرة للدنيا لم يكن له في الآخرة من نصيب»","صحيح","Sahih al-Jami al-Saghir 2825","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2826","«بشروا خديجة ببيت في الجنة من قصب لا صخب فيه ولا نصب»","صحيح","Sahih al-Jami al-Saghir 2826","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2827","«بطحان على بركة من برك الجنة»","حسن","Sahih al-Jami al-Saghir 2827","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2828","«بعثت إلى أهل البقيع لأصلي عليهم»","صحيح","Sahih al-Jami al-Saghir 2828","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2829","«بعثت أنا والساعة كهاتين»","صحيح","Sahih al-Jami al-Saghir 2829","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2830","«بعثت بجوامع الكلم ونصرت بالرعب وبينا أنا نائم أتيت بمفاتيح خزائن الأرض فوضعت في يدي»","صحيح","Sahih al-Jami al-Saghir 2830","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2831","""بعثت بين يدي الساعة بالسيف حتى يعبد الله تعالى ¤ وحده لا شريك له وجعل رزقي تحت ظل رمحي وجعل الذل والصغار على من خالف أمري ومن تشبه بقوم فهو منهم""","صحيح","Sahih al-Jami al-Saghir 2831","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2832","«بعثت في نسم الساعة»","صحيح","Sahih al-Jami al-Saghir 2832","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2833","«بعثت لأتمم صالح الأخلاق»","صحيح","Sahih al-Jami al-Saghir 2833","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2834","«بعثت من خير قرون بني آدم قرنا فقرنا حتى كنت من القرن الذي كنت فيه»","صحيح","Sahih al-Jami al-Saghir 2834","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2835","«بكروا بالإفطار وأخروا السحور»","صحيح","Sahih al-Jami al-Saghir 2835","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2836","«بل الله يخفض ويرفع وإني لأرجو أن ألقى الله وليس لأحد عندي مظلمة»","صحيح","Sahih al-Jami al-Saghir 2836","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2837","«بلغوا عني ولو آية وحدثوا عن بني إسرائيل ولا حرج ومن كذب علي متعمدا فليتبوأ مقعده من النار»","صحيح","Sahih al-Jami al-Saghir 2837","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2838","«بلوا أرحامكم ولو بالسلام»","حسن","Sahih al-Jami al-Saghir 2838","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2839","«بنو هاشم وبنو المطلب شيء واحد»","صحيح","Sahih al-Jami al-Saghir 2839","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2840","«بني الإسلام على خمس: شهادة أن لا إله إلا الله وأن محمدا رسول الله وإقام الصلاة وإيتاء الزكاة وحج البيت وصوم رمضان»","صحيح","Sahih al-Jami al-Saghir 2840","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2841","«بورك لأمتي في بكورها»","صحيح","Sahih al-Jami al-Saghir 2841","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2842","«بول الغلام ينضح وبول الجارية يغسل»","صحيح","Sahih al-Jami al-Saghir 2842","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2843","«بؤسا لك يا ابن سمية تقتلك الفئة الباغية»","صحيح","Sahih al-Jami al-Saghir 2843","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2844","«بيت لا تمر فيه جياع أهله»","صحيح","Sahih al-Jami al-Saghir 2844","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2845","«بيت لا تمر فيه كالبيت لا طعام فيه»","صحيح","Sahih al-Jami al-Saghir 2845","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2846","«بئس مطية الرجل زعموا»","صحيح","Sahih al-Jami al-Saghir 2846","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2847","«بئسما لأحدكم أن يقول: نسيت آية كيت وكيت بل هو نُسِّيَ»","صحيح","Sahih al-Jami al-Saghir 2847","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2848","«بين الرجل وبين الشرك والكفر ترك الصلاة»","صحيح","Sahih al-Jami al-Saghir 2848","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2849","«بين الكفر والإيمان ترك الصلاة»","صحيح","Sahih al-Jami al-Saghir 2849","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2850","«بين كل أذانين صلاة لمن شاء»","صحيح","Sahih al-Jami al-Saghir 2850","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2851","«بين كل ركعتين تحية»","صحيح","Sahih al-Jami al-Saghir 2851","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2852","«بين يدي الساعة أيام الهرج»","صحيح","Sahih al-Jami al-Saghir 2852","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2853","«بين يدي الساعة تقاتلون قوما نعالهم الشعر وهم أهل النار»","صحيح","Sahih al-Jami al-Saghir 2853","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2854","«بين يدي الساعة تقاتلون قوما ينتعلون الشعر وتقاتلون قوما كأن وجوهم المجان المطرقة»","صحيح","Sahih al-Jami al-Saghir 2854","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2855","«بين يدي الساعة فتن كقطع الليل المظلم»","صحيح","Sahih al-Jami al-Saghir 2855","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2856","«بين يدي الساعة مسخ وخسف وقذف»","صحيح","Sahih al-Jami al-Saghir 2856","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2857","«بينا أنا أسير في الجنة إذ عرض لي نهر حافتاه قباب اللؤلؤ المجوف قلت: يا جبريل ما هذا؟ قال: هذا الكوثر الذي أعطاكه الله ثم ضرب بيده إلى طينه فاستخرج مسكا ثم رفعت لي سدرة المنتهى فرأيت عندها نورا عظيما»","صحيح","Sahih al-Jami al-Saghir 2857","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2858","«بينا أنا نائم أتيت بخزائن الأرض فوضع في يدي سواران من ذهب فكبرا علي وأهماني فأوحى الله إلي: أن انفخهما فنفختهما فذهبا فأولتهما الكذابين اللذين أنا بينهما: صاحب صنعاء وصاحب اليمامة»","صحيح","Sahih al-Jami al-Saghir 2858","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2859","«بينا أنا نائم إذ أتيت بقدح لبن فشربت منه حتى لأرى الري يجري في أظفاري ثم أعطيت فضلي عمر بن الخطاب قالوا: فما أولته يا رسول الله؟ قال: العلم»","صحيح","Sahih al-Jami al-Saghir 2859","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2860","«بينا أنا نائم رأيت الناس يعرضون علي وعليهم قمص منها ما يبلغ الثدي ومنها ما يبلغ أسفل من ذلك وعرض علي عمر بن الخطاب وعليه قميص يجره قالوا: فما أولته يا رسول الله؟ قال: الدين»","صحيح","Sahih al-Jami al-Saghir 2860","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2861","«بينا أنا نائم رأيت في يدي سوارين من ذهب فأهمني شأنهما فأوحي إلي في المنام: أن انفخهما فنفختهما فطارا فأولتهما كذابين يخرجان من بعدي فكان أحدهما العنسي والآخر مسيلمة»","صحيح","Sahih al-Jami al-Saghir 2861","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2862","«بينا أنا نائم رأيتني في الجنة فإذا أنا بامرأة تتوضأ إلى جانب قصر فقلت: لمن هذا القصر؟ قالوا: لعمر بن الخطاب فذكرت غيرتك فوليت مدبرا»","صحيح","Sahih al-Jami al-Saghir 2862","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2863","«بينا أيوب يغتسل عريانا خر عليه جراد من ذهب فجعل أيوب يحثي في ثوبه فناداه ربه تبارك وتعالى: يا أيوب ألم أكن أغنيتك عما ترى؟ قال: بلى وعزتك ولكن لا غنى بي عن بركتك»","صحيح","Sahih al-Jami al-Saghir 2863","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2864","«بينا رجل بفلاة من الأرض فسمع صوتا في سحابة يقول: اسق حديقة فلان فتنحى ذلك السحاب فأفرغ ماءه في حرة فإذا شرجة من تلك الشراج قد استوعبت ذلك الماء كله فتتبع الماء فإذا رجل قائم في حديقته يحول الماء بمسحاته فقال له: يا عبد الله ما اسمك؟ قال: فلان للاسم الذي سمع في السحابة فقال له: يا عبد الله لم تسألني عن اسمي؟ قال: إني سمعت صوتا في السحاب الذي هذا ماؤه يقول: اسق حديقة فلان لاسمك فما تصنع فيها؟ قال: أما إذ قلت هذا فإني أنظر إلى ما يخرج منها فأتصدق بثلثه وآكل أنا وعيالي ثلثا وأرد فيها ثلثا»","صحيح","Sahih al-Jami al-Saghir 2864","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2865","«بينما أنا على بئر أنزع منها إذ جاء أبو بكر وعمر فأخذ أبو بكر الدلو فنزع ذنوبا أو ذنوبين وفي نزعه ضعف فغفر الله له ثم أخذها ابن الخطاب من يد أبي بكر فاستحالت في يده غربا فلم أر عبقريا من الناس يفري فريه حتى ضرب الناس بعطن»","صحيح","Sahih al-Jami al-Saghir 2865","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2866","""بينما أنا في الحطيم مضطجعا إذ أتاني آت فقد ما بين هذه إلى هذه فاستخرج قلبي ثم أتيت بطست من ذهب مملوءة إيمانا فغسل قلبي بماء زمزم ثم حشي ثم أعيد ثم أتيت بدابة دون البغل وفوق الحمار أبيض يقال له البراق يضع خطوه عند أقصى طرفه فحملت عليه فانطلق بي جبريل حتى أتى السماء الدنيا فاستفتح قيل من هذا؟ قال: جبريل قي: ومن معك؟ قال: محمد قيل: وقد أرسل إليه؟ قال: نعم قيل: مرحبا به فنعم المجيء جاء ففتح فلما خلصت فإذا فيها آدم فقال: هذا أبوك آدم فسلم عليه فسلمت عليه فرد السلام ثم قال: مرحبا بالنبي الصالح والابن الصالح; ثم صعد بي حتى أتى السماء الثانية فاستفتح فقيل: من هذا؟ قال: جبريل قيل: ومن معك؟ قال: محمد قيل وقد أرسل إليه؟ قال: نعم قيل مرحبا به فنعم المجيء جاء ففتح فلما خلصت إذا بيحيى وعيسى وهما ابنا الخالة قال: هذا يحيى وعيسى فسلم عليهما فسلمت فردا ثم قالا: مرحبا بالأخ الصالح والنبي الصالح; ثم صعد بي إلى السماء الثالثة فاستفتح قيل: من هذا؟ قال: جبريل قيل: ومن معك؟ قال: محمد قيل: وقد أرسل إليه؟ قال: نعم قيل: مرحبا به فنعم المجيء جاء ففتح فلما خلصت إذا يوسف قال: هذا يوسف فسلم عليه فسلمت عليه فرد ثم قال: مرحبا بالأخ الصالح والنبي الصالح; ثم صعد بي حتى أتى السماء الرابعة فاستفتح قيل: من هذا؟ قال: جبريل قيل: ومن معك؟ قال: محمد قيل: وقد أرسل إليه؟ قال: نعم قيل: مرحبا به فنعم المجيء جاء ففتح فلما خلصت إذا إدريس قال: هذا إدريس فسلم عليه فسلمت فرد ثم قال: مرحبا بالأخ الصالح والنبي الصالح; ¤ ثم صعد بي إلى السماء الخامسة فاستفتح قيل: من هذا؟ قال: جبريل قيل: ومن معك؟ قال: محمد قيل: وقد أرسل إليه؟ قال: نعم قيل: مرحبا به فنعم المجيء جاء فلما خلصت إذا هارون قال: هذا هارون فسلم عليه فسلمت عليه فرد ثم قال: مرحبا بالأخ الصالح والنبي الصالح; ثم صعد بي إلى السماء السادسة فاستفتح قيل: من هذا؟ قال: جبريل قيل: ومن معك؟ قال: محمد قيل: وقد أرسل إليه؟ قال: نعم قيل: مرحبا به فنعم المجيء جاء فلما خلصت فإذا موسى قال: هذا موسى فسلم عليه فسلمت عليه فرد ثم قال: مرحبا بالأخ الصالح والنبي الصالح فلما تجاوزت بكى قيل له: ما يبكيك؟ قال: أبكي لأن غلاما بعث بعدي يدخل الجنة من أمته أكثر ممن يدخل من أمتي; ثم صعد بي إلى السماء السابعة فاستفتح قيل: من هذا؟ قال: جبريل قيل: ومن معك؟ قال محمد قيل: وقد بعث إليه؟ قال: نعم قيل: مرحبا به فنعم المجيء جاء فلما خلصت إذا إبراهيم قال: هذا أبوك إبراهيم فسلم عليه فسلمت عليه فرد السلام فقال: مرحبا بالابن الصالح والنبي الصالح; ثم رفعت لي سدرة المنتهى فإذا نبقها مثل قلال هجر وإذا ورقها مثل آذان الفيلة قال: هذه سدرة المنتهى وإذا أربعة أنهار نهران باطنان ونهران ظاهران قلت: ما هذان يا جبريل؟ قال: أما الباطنان فنهران في الجنة وأما الظاهران فالنيل والفرات ثم رفع لي البيت المعمور فقلت: يا جبريل! ما هذا؟ قال: هذا البيت المعمور يدخله كل يوم سبعون ألف ملك إذا خرجوا منه لم يعودوا ¤ إليه آخر ما عليهم ثم أتيت بإناء من خمر وإناء من لبن وإناء من عسل فأخذت اللبن فقال: هي الفطرة التي أنت عليها وأمتك; ثم فرض علي خمسون صلاة كل يوم فرجعت فمررت على موسى فقال: بم أمرت؟ قلت: أمرت بخمسين صلاة كل يوم قال: إن أمتك لا تستطيع خمسين صلاة كل يوم وإني والله قد جربت الناس قبلك وعالجت بني إسرائيل أشد المعالجة فارجع إلى ربك فسله التخفيف لأمتك فرجعت فوضع عني عشرا فرجعت إلى موسى فقال مثله فرجعت فوضع عني عشرا فرجعت إلى موسى فقال مثله فرجعت فوضع عني عشرا فرجعت إلى موسى فقال مثله فرجعت فوضع عني عشرا فأمرت بعشر صلوات كل يوم فقال مثله فرجعت فأمرت بخمس صلوات كل يوم فرجعت إلى موسى فقال: بم أمرت؟ قلت: أمرت بخمس صلوات كل يوم قال: إن أمتك لا تستطيع خمس صلوات كل يوم وإني قد جربت الناس قبلك وعالجت بني إسرائيل أشد المعالجة فارجع إلى ربك فسله التخفيف لأمتك قلت: سألت ربي حتى استحييت منه ولكن أرضى وأسلم فلما جاوزت نادانى مناد أمضيت فريضتي وخففت عن عبادي""","صحيح","Sahih al-Jami al-Saghir 2866","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2867","«بينما أنا نائم إذا زمرة حتى إذا عرفتهم خرج رجل من بيني وبينهم فقال: هلم قلت: أين؟ قال: إلى النار والله قلت: ما شأنهم؟ قال: إنهم ارتدوا بعدك على أدبارهم القهقرى ثم إذا زمرة حتى إذا عرفتهم خرج رجل من بيني وبينهم فقال: هلم قلت: أين؟ قال: إلى النار قلت: ما شأنهم؟ قال: إنهم ارتدوا بعدك على أدبارهم القهقرى فلا أراه يخلص منهم إلا مثل همل النعم»","صحيح","Sahih al-Jami al-Saghir 2867","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2868","«بينما أنا نائم رأيتني أطوف بالكعبة فإذا رجل آدم سبط الشعر بين رجلين ينطف رأسه ماء فقلت: من هذا؟ قالوا: هذا ابن مريم ثم ذهبت ألتفت فإذا رجل أحمر جسيم جعد الرأس أعور العين كأن عينه عنبة طافية قلت: من هذا؟ قالوا: الدجال أقرب الناس به شبها ابن قطن»","صحيح","Sahih al-Jami al-Saghir 2868","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2869","«بينما أنا نائم رأيتني على قليب عليها دلو فنزعت منها ما شاء الله ثم أخذها ابن أبي قحافة فنزع بها ذنوبا أو ذنوبين وفي نزعه ضعف والله يغفر له ضعفه ثم استحالت غربا فأخذها ابن الخطاب فلم أر عبقريا من الناس ينزع نزع عمر ثم ضرب الناس بعطن»","صحيح","Sahih al-Jami al-Saghir 2869","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2870","""بينما ثلاثة نفر يمشون أخذهم المطر فآووا إلى غار في جبل فانحطت على فم غارهم صخرة من الجبل فانطبقت عليهم فقال بعضهم لبعض: انظروا أعمالا عملتموها صالحة لله فادعوا بها لعله يفرجها عنكم; فقال أحدهم: اللهم إنه كان لي والدان شيخان كبيران وامرأتي ولي صبية صغار أرعى عليهم فإذا أرحت عليهم حلبت فبدأت بوالدي فسقيتهما قبل بني وإني نأى بي ذات يوم الشجر فلم آت حتى أمسيت فوجدتهما قد ناما فحلبت كما كنت أحلب فجئت بالحلاب فقمت عند رءوسهما أكره أن أوقظهما من نومهما وأكره أن أسقى الصبية قبلهما والصبية يتضاغون عند قدمي فلم يزل ذلك دأبي ودأبهم حتى طلع الفجر فإن كنت تعلم أني فعلت ذلك ابتغاء وجهك فافرج لنا فرجة نرى منها السماء ففرج الله منها فرجة فرأوا منها السماء; ¤ وقال الآخر: اللهم إنه كانت لي ابنة عم أحببتها كأشد ما يحب الرجال النساء وطلبت إليها نفسها فأبت حتى آتيها بمائة دينار فتعبت حتى جمعت مائة دينار فجئتها بها فلما وقعت بين رجليها قالت: يا عبد الله اتق الله ولا تفتح الخاتم إلا بحقه فقمت عنها فإن كنت تعلم أني فعلت ذلك ابتغاء وجهك فافرج لنا منها فرجة ففرج لهم فرجة; وقال الآخر: اللهم إني كنت استأجرت أجيرا بفرق أرز فلما قضى عمله قال لي: أعطني حقي فعرضت عليه فرقه فرغب عنه فلم أزل أزرعه حتى جمعت منه بقرا ورعاءها فجاءني فقال: اتق الله ولا تظلمني حقي قلت: اذهب إلى تلك البقر ورعائها فخذها فقال: اتق الله ولا تستهزئ بي فقلت: إني لا أستهزئ بك خذ ذلك البقر ورعاءها فأخذه وذهب به فإن كنت تعلم أني فعلت ذلك ابتغاء وجهك فافرج ما بقي ففرج الله ما بقي""","صحيح","Sahih al-Jami al-Saghir 2870","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2871","«بينما رجل راكب على بقرة التفتت إليه فقالت: إني لم أخلق لهذا إنما خلقت للحرث فإني أومن بهذا أنا وأبو بكر وعمر وبينما رجل في غنمه إذ عدا الذئب فذهب منها بشاة فطلبه حتى استنقذها منه فقال له الذئب: هنا استنقذتها مني فمن لها يوم السبع يوم لا راعي لها غيري فإني أومن بهذا أنا وأبو بكر وعمر»","صحيح","Sahih al-Jami al-Saghir 2871","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2872","«بينما رجل يجر إزاره من الخيلاء خسف به فهو يتجلجل في الأرض إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 2872","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2873","""بينما رجل يمشي بطريق اشتد عليه العطش ¤ فوجد بئرا فنزل فيها فشرب منها ثم خرج فإذا هو بكلب يلهث يأكل الثرى من العطش فقال: لقد بلغ هذا الكلب من العطش مثل الذي بلغ بي فنزل البئر فملأ خفه ماء ثم أمسك بفيه ثم رقي فسقى الكلب فشكر الله فغفر له في كل ذات كبد رطبة أجر""","صحيح","Sahih al-Jami al-Saghir 2873","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2874","«بينما رجل يمشي بطريق وجد غصن شوك على الطريق فأخره فشكر الله له فغفر له»","صحيح","Sahih al-Jami al-Saghir 2874","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2875","«بينما رجل يمشي في حلة تعجبه نفسه مرجل جمته إذ خسف الله به الأرض فهو يتجلجل فيها إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 2875","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2876","«بينما كلب يطيف بركية كاد يقتله العطش إذ رأته بغي من بغايا بني إسرائيل فنزعت موقها فاستقت له به فغفر لها»","صحيح","Sahih al-Jami al-Saghir 2876","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2877","«البحر الطهور ماؤه الحل ميتته»","صحيح","Sahih al-Jami al-Saghir 2877","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2878","«البخيل من ذكرت عنده فلم يصل علي»","صحيح","Sahih al-Jami al-Saghir 2878","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2879","«البذاذة من الإيمان»","صحيح","Sahih al-Jami al-Saghir 2879","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2880","«البر حسن الخلق والإثم ما حاك في صدرك وكرهت أن يطلع عليه الناس»","صحيح","Sahih al-Jami al-Saghir 2880","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2881","«البر ما سكنت إليه النفس واطمأن إليه القلب والإثم ما لم تسكن إليه النفس ولم يطمئن إليه القلب وإن أفتاك المفتون»","صحيح","Sahih al-Jami al-Saghir 2881","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2882","«البركة في ثلاثة: في الجماعة والثريد والسحور»","صحيح","Sahih al-Jami al-Saghir 2882","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2883","«البركة في نواصي الخيل»","صحيح","Sahih al-Jami al-Saghir 2883","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2884","«البركة مع أكابركم»","صحيح","Sahih al-Jami al-Saghir 2884","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2885","«البزاق في المسجد سيئة ودفنه حسنة»","حسن","Sahih al-Jami al-Saghir 2885","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2886","«البصاق في المسجد خطيئة وكفارتها دفنها»","صحيح","Sahih al-Jami al-Saghir 2886","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2887","«البضع ما بين الثلاث إلى التسع»","صحيح","Sahih al-Jami al-Saghir 2887","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2888","«البطن والغرق شهادة»","صحيح","Sahih al-Jami al-Saghir 2888","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2889","«البقرة عن سبعة والجزور عن سبعة»","صحيح","Sahih al-Jami al-Saghir 2889","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2890","«البقرة عن سبعة والجزور عن سبعة في الأضاحي»","صحيح","Sahih al-Jami al-Saghir 2890","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2891","«البيت المعمور في السماء السابعة يدخله كل يوم سبعون ألف ملك ثم لا يعودون إليه حتى تقوم الساعة»","صحيح","Sahih al-Jami al-Saghir 2891","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2892","«البيعان إذا اختلفا في البيع ترادا البيع»","صحيح","Sahih al-Jami al-Saghir 2892","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2893","«البيعان بالخيار ما لم يتفرقا»","صحيح","Sahih al-Jami al-Saghir 2893","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2894","«البيعان بالخيار ما لم يتفرقا إلا أن تكون صفقة خيار ولا يحل له أن يفارق صاحبة خشية أن يستقيله»","حسن","Sahih al-Jami al-Saghir 2894","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2895","«البيعان بالخيار ما لم يتفرقا أو يقول أحدهما لصاحبه اختر»","صحيح","Sahih al-Jami al-Saghir 2895","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2896","«البيعان بالخيار ما لم يتفرقا فإن صدقا وبينا بورك لهما في بيعهما وإن كتما وكذبا محقت بركة بيعهما»","صحيح","Sahih al-Jami al-Saghir 2896","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2897","«البينة على المدعي واليمين على المدعى عليه»","صحيح","Sahih al-Jami al-Saghir 2897","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
"2898","«البينة وإلا فحد في ظهرك»","صحيح","Sahih al-Jami al-Saghir 2898","","","الأحاديث المبدوءة بحرف الباء Hadith Beginning with the Letter Ba (ب)"
