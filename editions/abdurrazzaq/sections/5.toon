hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"2421","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : جَاءَ رَجُلٌ إِلَى ابْنِ عَبَّاسٍ , فَقَالَ : إِنِّي صَلَّيْتُ مَعَ فُلانٍ فَكَبَّرَ اثْنَتَيْنِ وَعِشْرِينَ تَكْبِيرَةً ,  وَكَأَنَّهُ يُرِيدُ بِذَلِكَ عَيْبَهُ , فَقَالَ ابْنُ عَبَّاسٍ : \" وَيْحَكَ , تِلْكَ سُنَّةُ أَبِي الْقَاسِمِ ""","","","","","Book of Prayer"
"2422","عَنْ إِسْرَائِيلَ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَمْرِو بْنِ مَيْمُونٍ , قَالَ : كَانَ عُمَرُ بْنُ الْخَطَّابِ يُتِمُّ التَّكْبِيرَ فِي الصَّلاةِ ""","","","","","Book of Prayer"
"2423","عَنْ مَعْمَرٍ , أَنَّ عَدِيَّ بْنَ أَرْطَأَةَ أَمَرَ الْحَسَنَ , أَنْ يُصَلِّيَ بِالنَّاسِ , \" فَكَبَّرَ هَذَا التَّكْبِيرَ حِينَ يَخْفِضُ , وَحِينَ يَرْفَعُ , فَغَلِطَ النَّاسُ , فَكَبَّرَ بِهِمْ تَكْبِيرَ الأَئِمَّةِ يَوْمَئِذٍ ""","","","","","Book of Prayer"
"2424","عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ , عَنْ رَجُلٍ , يُقَالُ لَهُ مُوسَى , قَالَ : سَمِعْتُ الْحَسَنَ , وَقَالَ لَهُ رَجُلٌ : يَا أَبَا سَعِيدٍ , إِنَّ لَنَا إِمَامًا يُكَبِّرُ فِي الصَّلاةِ إِذَا رَفَعَ وَإِذَا وَضَعَ , فَقَالَ الْحَسَنُ : \" وَالَّذِي لا إِلَهَ إِلا هُوَ , إِنَّهَا لَصَلاةُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Prayer"
"2425","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , قَالَ : تَذَاكَرْنَا زَيَادَةَ هَذَا التَّكْبِيرِ فِي الصَّلاةِ , فَقَالَ أَبُو الشَّعْثَاءِ : \" قَدْ صَلَّيْتُ وَرَاءَ ابْنِ عَبَّاسٍ فَمَا سَمِعْتُهُ يُكَبِّرُهُ ""","","","","","Book of Prayer"
"2426","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ عَوْنِ بْنِ عَبْدِ اللَّهِ , قَالَ : قَالَ لِي عُمَرُ بْنُ عَبْدِ الْعَزِيزِ : أَعَدْلانِ عَنْدَكَ عُمَرُ , وَابْنُ عُمَرَ ؟ , قَالَ : قُلْتُ \" نَعَمْ \" , قَالَ : \" فَإِنَّهُمَا لَمْ يَكُونَا يُكَبِّرَانِ هَذَا التَّكْبِيرَ ""","","","","","Book of Prayer"
"2427","عَنْ إِسْمَاعِيلَ بْنِ عَبْدِ اللَّهِ أَبِي الْوَلِيدِ , عَنِ ابْنِ عَوْنٍ , قَالَ : صَلَّى قَاسِمُ بْنُ مُحَمَّدٍ الْمَغْرِبَ , أَمَّنَا فِيهَا فَلَمْ يُكَبِّرْ هَذَا التَّكْبِيرَ حِينَ يَرْفَعُ وَحِينَ يَسْجُدُ , فَلَمَّا فَرَغْتُ , قُلْتُ لَهُ : فَإِنَّ نَافِعًا أَخْبَرَنِي , \" أَنَّهُ صَلَّى خَلْفَ أَبِي هُرَيْرَةَ , فَكَبَّرَ حِينَ يَرْفَعُ , وَحِينَ يَسْجُدُ \" , قَالَ : فَغَضِبَ , وَقَالَ : لا أَبَا لَكَ , أَتَرَاهُ الْحَقَّ عَلَيَّ أَنْ أَصْنَعَ كُلَّمَا كَانَ أَبُو هُرَيْرَةَ يَصْنَعُ ؟ أَفَلا سَأَلْتَهُ أَكَانَ عَبْدُ اللَّهِ بْنُ عُمَرَ يَفْعَلُهُ ؟ فَسَأَلْتُ نَافِعًا , فَقَالَ : \" مَا تَرَكَهُ أَحَدٌ يَعْقِلُ الصَّلاةَ ""","","","","","Book of Prayer"
"2428","عَنْ إِسْمَاعِيلَ أَيْضًا , قَالَ : أَخْبَرَنِي شُعْبَةُ بْنُ الْحَجَّاجِ , عَنْ رَجُلٍ , عَنِ ابْنِ أَبْزَى , عَنْ أَبِيهِ , \" أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَمَّهُمْ فَلَمْ يُكَبِّرْ هَذَا التَّكْبِيرَ ""","","","","","Book of Prayer"
"2429","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : نُكَبِّرُ فِي التَّطَوُّعِ مِثْلَ مَا نُكَبِّرُ فِي الْمَكْتُوبَةِ ؟ , قَالَ : \" نَعَمْ , اجْعَلِ التَّطَوُّعَ مِثْلَ الْمَكْتُوبَةِ إِنِ اسْتَطَعْتَ فِي كُلِّ ذَلِكَ , إِنَّمَا هُوَ شَيْءٌ تُرِيدُ وَجْهَ اللَّهِ , وَالدَّارَ الآخِرَةَ ""","","","","","Book of Prayer"
"2430","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الرَّحْمَنِ بْنُ سَابِطٍ , \" أَنَّ وَجْهَ الصَّلاةِ أَنْ يُكَبِّرَ الرَّجُلُ بِيَدَيْهِ , وَوَجْهِهِ , وَفِيهِ , وَيَرْفَعَ رَأْسَهُ شَيْئًا حِينَ يَبْتَدِئُ , وَحِينَ يَرْكَعُ , وَحِينَ يَرْفَعُ رَأْسَهُ ""","","","","","Book of Prayer"
"2431","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِنَافِعٍ : هَلْ كُنْتَ تَرَى عَبْدَ اللَّهِ بْنَ عُمَرَ إِذَا كَبَّرَ فِي الصَّلاةِ يَرْفَعُ رَأْسَهُ وَوَجْهَهُ قِبَلَ السَّمَاءِ ؟ , قَالَ : نَعَمْ , قَلِيلا ""","","","","","Book of Prayer"
"2432","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , عَنِ ابْنِ عُمَرَ , قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَرْفَعُ يَدَيْهِ حِينَ يُكَبِّرُ حَتَّى يَكُونَا حِذْوَ مِنْكَبَيْهِ , أَوْ قَرِيبًا مِنْ ذَلِكَ , وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرَّكْعَةِ رَفَعَهُمَا , وَلا يَفْعَلُ ذَلِكَ فِي السُّجُودِ ""","","","","","Book of Prayer"
"2433","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي ابْنُ شِهَابٍ , عَنْ سَالِمِ بْنِ عَبْدِ اللَّهِ , أَنَّ ابْنَ عُمَرَ , كَانَ يَقُولُ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا قَامَ إِلَى الصَّلاةِ رَفَعَ يَدَيْهِ حَتَّى تَكُونَا حِذْوَ مِنْكَبَيْهِ , ثُمَّ يُكَبِّرُ , وَإِذَا أَرَادَ أَنْ يَرْكَعَ فَعَلَ مِثْلَ ذَلِكَ , وَإِذَا رَفَعَ مِنَ الرُّكُوعِ فَعَلَ مِثْلَ ذَلِكَ , وَلا يَفْعَلُهُ حِينَ يَرْفَعُ رَأْسَهُ مِنَ السُّجُودِ ""","","","","","Book of Prayer"
"2434","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنِ ابْنِ شِهَابٍ , عَنْ سَالِمٍ , قَالَ : كَانَ ابْنُ عُمَرَ إِذَا قَامَ إِلَى الصَّلاةِ رَفَعَ يَدَيْهِ حَتَّى يَكُونَا حِذْوَ مِنْكَبَيْهِ , وَإِذَا رَكَعَ رَفَعَهُمَا , فَإِذَا رَفَعَ رَأْسَهُ مِنَ الرَّكْعَةِ رَفَعَهُمَا , وَإِذَا قَامَ مِنْ مَثْنَى رَفَعَهُمَا , وَلا يَفْعَلُ ذَلِكَ فِي السُّجُودِ , قَالَ : ثُمَّ يُخْبِرُهُمْ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَفْعَلُهُ \" , قَالَ عَبْدُ اللَّهِ : سَمِعْتُ نَافِعًا يُحَدِّثُ , عَنِ ابْنِ عُمَرَ مِثْلَ هَذَا , إِلا أَنَّهُ قَالَ : يَرْفَعُ يَدَيْهِ حَتَّى يَكُونَا حِذْوَ أُذُنَيْهِ","","","","","Book of Prayer"
"2435","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ , \" أَنَّ ابْنَ عُمَرَ كَانَ يُكَبِّرُ بِيَدَيْهِ حِينَ يَسْتَفْتِحُ , وَحِينَ يَرْكَعُ , وَحِينَ يَقُولُ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , وَحِينَ يَرْفَعُ رَأْسَهُ مِنَ الرَّكْعَةِ , وَحِينَ يَسْتَوِي قَائِمًا مِنْ مَثْنَى , قَالَ : وَلَمْ يَكُنْ يُكَبِّرُ بِيَدَيْهِ إِذَا رَفَعَ رَأْسَهُ مِنَ السَّجْدَتَيْنِ , قُلْتُ لِنَافِعٍ : أَكَانَ ابْنُ عُمَرَ يَجْعَلُ الأُولَى مِنْهُنَّ أَرْفَعَهُنَّ ؟ , قَالَ : لا , سَوَاءً , قُلْتُ : أَكَانَ يُخْلِفُ بِشَيْءٍ مِنْهُنَّ أُذُنَيْهِ ؟ , قَالَ : لا , وَلا يَبْلُغُ وَجْهَهُ , فَأَشَارَ لِي إِلَى الثَّدْيَيْنِ أَوْ أَسْفَلَ مِنْهُمَا ""","","","","","Book of Prayer"
"2436","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ : \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَرْفَعُ يَدَيْهِ إِذَا رَكَعَ , وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ حَتَّى يَكُونَا حِذْوَ أُذُنَيْهِ ""","","","","","Book of Prayer"
"2437","عَنِ الثَّوْرِيِّ , عَنْ عَاصِمِ بْنِ كُلَيْبٍ , عَنْ أَبِيهِ , عَنْ وَائِلِ بْنِ حُجْرٍ , قَالَ : رَمَقْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَرَفَعَ يَدَيْهِ فِي الصَّلاةِ حِينَ كَبَّرَ , ثُمَّ حِينَ كَبَّرَ رَفَعَ يَدَيْهِ , ثُمَّ إِذَا قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ رَفَعَ , قَالَ : ثُمَّ جَلَسَ فَافْتَرَشَ رِجْلَهُ الْيُسْرَى , ثُمَّ وَضَعَ يَدَهُ الْيُسْرَى عَلَى رُكْبَتِهِ الْيُسْرَى , وَذِرَاعَهُ الْيُمْنَى عَلَى فَخِذِهِ الْيُمْنَى , ثُمَّ أَشَارَ بِسَبَّابَتِهِ , وَوَضَعَ الإِبْهَامَ عَلَى الْوُسْطَى حَلَّقَ بِهَا , وَقَبَضَ سَائِرَ أَصَابِعِهِ , ثُمَّ سَجَدَ فَكَانَتْ يَدَاهُ حِذْوَ أُذُنَيْهِ ""","","","","","Book of Prayer"
"2438","عَنْ هُشَيْمٍ , قَالَ : أَخْبَرَنِي أَبُو حَمْزَةَ , مَوْلَى بَنِي أَسَدٍ , قَالَ : \" رَأَيْتُ ابْنَ عَبَّاسٍ إِذَا افْتَتَحَ الصَّلاةَ يَرْفَعُ يَدَيْهِ , وَإِذَا رَكَعَ , وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ ""","","","","","Book of Prayer"
"2439","عَنْ دَاوُدَ بْنِ إِبْرَاهِيمَ , قال : \" رَأَيْتُ وَهْبَ بْنَ مُنَبِّهٍ إِذَا كَبَّرَ فِي الصَّلاةِ رَفَعَ يَدَيْهِ حَتَّى تَكُونَا حِذْوَ أُذُنَيْهِ , وَإِذَا رَكَعَ , وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ ""","","","","","Book of Prayer"
"2440","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي حَسَنُ بْنُ مُسْلِمٍ , قَالَ : سَمِعْتُ طَاوُسًا , وَهُوَ يُسْأَلُ عَنْ رَفْعِ الْيَدَيْنِ فِي الصَّلاةِ , فَقال : \" رَأَيْتُ عَبْدَ اللَّهِ , وَعَبْدَ اللَّهِ , وَعَبْدَ اللَّهِ يَرْفَعُونَ أَيْدِيَهُمْ فِي الصَّلاةِ لِعَبْدِ اللَّهِ بْنِ عُمَرَ , وَعَبْدِ اللَّهِ بْنِ عَبَّاسٍ , وَعَبْدِ اللَّهِ بْنِ الزُّبَيْرِ ""","","","","","Book of Prayer"
"2441","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي حَسَنُ بْنُ مُسْلِمٍ , عَنْ طَاوُسٍ , أَنَّهُ قَالَ : \" التَّكْبِيرَةُ الأُولَى الَّتِي لِلاسْتِفْتَاحِ بِالْيَدَيْنِ , أَرْفَعُ مِمَّا سِوَاهُمَا مِنَ التَّكْبِيرِ , قَالَ : حَتَّى يَخْلِفَ بِهَا الرَّأْسَ \" , قَالَ ابْنُ جُرَيْجٍ : رَأَيْتُ أَنَا ابْنَ طَاوُسٍ يَخْلِفُ بِيَدَيْهِ رَأْسَهُ","","","","","Book of Prayer"
"2442","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" قَدْ رَأَيْتُ تُكَبِّرُ بِيَدِكَ حِينَ تَسْتَفْتِحُ , وَحِينَ تَرْكَعُ , وَحِينَ تَرْفَعُ رَأْسَكَ مِنَ السَّجْدَةِ الأُولَى , وَمِنَ الأَخِيرَةِ , وَحِينَ تَسْتَوِي مِنَ الْمَثْنَى , قَالَ : أَجَلْ , قُلْتُ : بَلَغَكَ أَنَّ تَكْبِيرَ الاسْتِفْتَاحِ بِالْيَدَيْنِ أَكْبَرُ مِمِّا سِوَاهُمَا ؟ , قَالَ : لا , قُلْتُ : يَخْلِفُ بِالْيَدَيْنِ الأُذُنَيْنِ ؟ , قَالَ : لا , قَالَ : قَدْ بَلَغَنِي ذَلِكَ عَنْ عُثْمَانَ , أَنَّهُ كَانَ يَخْلِفُ بِيَدَيْهِ أُذُنَيْهِ \" , عَنِ ابْنِ جُرَيْجٍ قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ عُبَيْدِ بْنِ عُمَيْرٍ , يَذْكُرُ ذَلِكَ عَنْ عُثْمَانَ","","","","","Book of Prayer"
"2443","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : وَفِي التَّطَوُّعِ مِنَ الْيَدَيْنِ مِثْلُ مَا فِي الْمَكْتُوبَةِ ؟ , قَالَ : \" نَعَمْ , فِي كُلِّ صَلاةٍ ""","","","","","Book of Prayer"
"2444","عَنِ الثَّوْرِيِّ , عَنْ يَزِيدَ بْنِ أَبِي زِيَادٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى , عَنِ الْبَرَاءِ بْنِ عَازِبٍ , قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا كَبَّرَ رَفَعَ يَدَيْهِ حَتَّى يُرَى إِبْهَامُهُ قَرِيبًا مِنْ أُذُنَيْهِ \" , عَنِ ابْنِ عُيَيْنَةَ , عَنْ يَزِيدَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى , عَنِ الْبَرَاءِ بْنِ عَازِبٍ مِثْلَهُ , وَزَادَ قَالَ : \" مَرَّةً وَاحِدَةً , ثُمَّ لا تُعِدْ لِرَفْعِهَا فِي تِلْكَ الصَّلاةِ ""","","","","","Book of Prayer"
"2445","عَنِ الثَّوْرِيِّ , عَنِ الزُّبَيْرِ بْنِ عَدِيٍّ , عَنْ إِبْرَاهِيمَ , عَنِ الأَسْوَدِ , \" أَنَّ عُمَرَ بْنَ الْخَطَّابِ , كَانَ يَرْفَعُ يَدَيْهِ إِلَى الْمِنَكَبَيْنِ ""","","","","","Book of Prayer"
"2446","عَنِ الثَّوْرِيِّ , عَنْ حُصَيْنٍ , عَنْ إِبْرَاهِيمَ , عَنِ ابْنِ مَسْعُودٍ , \" كَانَ يَرْفَعُ يَدَيْهِ فِي أَوَّلِ شَيْءٍ ثُمَّ لا يَرْفَعُ بَعْدُ \" , عَنِ ابْنِ عُيَيْنَةَ , عَنْ حُصَيْنٍ , عَنْ إِبْرَاهِيمَ , عَنِ ابْنِ مَسْعُودٍ مِثْلَهُ","","","","","Book of Prayer"
"2447","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , قَالَ : سَأَلْتُ إِبْرَاهِيمَ عَنْ ذَلِكَ ؟ , فَقَالَ : \" يَرْفَعُ يَدَيْهِ أَوَّلَ مَرَّةٍ ""","","","","","Book of Prayer"
"2448","عَنِ ابْنِ جُرَيْجٍ , قال : \" قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْ نَسِيتُ , أَنْ أُكَبِّرَ بِيَدِي فِي بَعْضِ ذَلِكَ أَعُودُ لِلصَّلاةِ ؟ , قَالَ : لا ""","","","","","Book of Prayer"
"2449","عَنْ مَعْمَرٍ , قال : سَأَلْتُ حَمَّادًا : عَنْ رَجُلٍ نَسِيَ تَكْبِيرَةَ الاسْتِفْتَاحِ , قَالَ : يُعِيدُ صَلاتَهُ ""","","","","","Book of Prayer"
"2450","عَنْ حَمَّادٍ , قال : \" إِذَا نَسِيَ الرَّجُلُ تَكْبِيرَةَ مِفْتَاحِ الصَّلاةِ أَعَادَ الصَّلاةَ وَبِهِ يَأْخُذُ الثَّوْرِيُّ ""","","","","","Book of Prayer"
"2451","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ اللَّهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ , عَنْ مُحَمَّدِ بْنِ الْحَنَفِيَّةِ , عَنْ عَلِيٍّ , رَفَعَهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" مِفْتَاحُ الصَّلاةِ الطُّهُورُ , إِحْرَامُهَا التَّكْبِيرُ , وَتَحْلِيلُهَا التَّسْلِيمُ ""","","","","","Book of Prayer"
"2452","عَنْ عُثْمَانَ بْنِ مَطَرٍ , عَنْ حُسَيْنٍ الْمُعَلِّمِ , عَنْ بُدَيْلٍ الْعَقَطِيِّ , عَنْ أَبِي الْجَوْزَاءِ , قَالَ : سَمِعْتُ عَائِشَةَ , تَقُولُ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَفْتَتِحُ صَلاتَهُ بِالتَّكْبِيرِ , وَيَخْتِمُهَا بِالتَّسْلِيمِ ""","","","","","Book of Prayer"
"2453","عَنْ مَعْمَرٍ , قَالَ : سَمِعْتُ إِبْرَاهِيمَ , وَقَتَادَةَ , عَنِ الرَّجُلِ يَنْسَى تَكْبِيرَةَ مِفْتَاحِ الصَّلاةِ , قَالا : \" لا يُعِيدُ , قَدْ كَبَّرَ حِينَ رَكَعَ وَحِينَ سَجَدَ ""","","","","","Book of Prayer"
"2454","عَنِ الثَّوْرِيِّ , عَنِ الْحَكَمِ , وَعَطَاءٍ , قَالا : \" يُجْزِئُهُ تَكْبِيرَةُ الرَّكْعَةِ ""","","","","","Book of Prayer"
"2455","عَنِ ابْنِ جُرَيْجٍ , أَنَّ رَجُلا , قَالَ لِعَطَاءٍ : نَسِيتُ التَّكْبِيرَ هَلْ أَعُودُ ؟ , قَالَ \" لا , أَنْتَ تُكَبِّرُ إِذَا جَلَسْتَ وَبَيْنَ ذَلِكَ , إِنَّمَا تَعُودُ إِذَا نَسِيتَ رَكْعَةً أَوْ سَجْدَةً ""","","","","","Book of Prayer"
"2456","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِذَا نَسِيتُ بَعْضَ التَّكْبِيرِ أَنْ أَلْفِظَهُ بِفِيَّ ؟ , قَالَ \" لا تُعِدْ , وَلا تَسْجُدْ سَجْدَةَ السَّهْوِ , سَتُكَبِّرُ ""","","","","","Book of Prayer"
"2457","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عُبَيْدِ اللَّهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ السَّائِبِ بْنِ عُمَيْرٍ , قَالَ : \" قُلْتُ لابْنِ الْمُسَيِّبِ : إِنِّي أَسْجُدُ يَوْمَ الْجُمُعَةِ , فِيَقُولُ لِي الشَّيْطَانُ : لَمْ تُكَبِّرْ تَكْبِيرَةَ الاسْتِفْتَاحِ , قَالَ ابْنُ الْمُسَيِّبِ : كَبَّرْتَ قَبْلُ وَبَعْدُ ""","","","","","Book of Prayer"
"2458","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : إِذَا اعْتَدَلْتَ فِي الصَّفِّ , وَلَمْ تُكَبِّرْ حَتَّى يَرْكَعَ الإِمَامُ , وَيَرْفَعَ رَأْسَهُ مِنَ الرَّكْعَةِ , فَارْكَعْ وَاعْتَدَّ بِهَا , وَإِنْ كُنْتَ لَمْ تَعْتَدِلْ فِي الصَّفِّ فَلا تَعْتَدَّ بِهَا ""","","","","","Book of Prayer"
"2459","عَنِ الثَّوْرِيِّ , عَنِ ابْنِ أَبِي لَيْلَى , عَنِ الْحَكَمِ , قَالَ : إِذَا نَسِيَ أَنْ يُكَبِّرَ الرَّجُلُ فِي الصَّلاةِ , فَقال : سُبْحَانَ اللَّهِ , أَجْزَأَ عَنْهُ أَنْ يَفْتَتِحَ بِذِكْرِ اللَّهِ ""","","","","","Book of Prayer"
"2460","عَنِ الثَّوْرِيِّ , قال : \" إِذَا كَبَّرَ الرَّجُلُ قَبْلَ الإِمَامِ فَلْيُعِدِ التَّكْبِيرَ , فَإِنْ لَمْ يُعِدْ حَتَّى يَقْضِيَ الصَّلاةَ فَلْيُعِدِ الصَّلاةَ ""","","","","","Book of Prayer"
"2461","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : قُلْتُ لَهُ : لَوْ خُيِّلَ إِلَيَّ أَنَّ الإِمَامَ قَدْ كَبَّرَ تَكْبِيرَةَ الافْتِتَاحِ فَكَبَّرْتُ , ثُمَّ كَبَّرْتُ بَعْدُ ؟ , قَالَ : تُكَبِّرُ مَعَهُ ""","","","","","Book of Prayer"
"2462","عَنِ الثَّوْرِيِّ , قَالَ : وَسَمِعْتُ أَوْ أَخْبَرَنِي مَنْ سَمِعَهُ يُحَدِّثُ , عَنْ حَمَّادٍ , قَالَ : سَأَلْتُ إِبْرَاهِيمَ : مَتَى يُكَبِّرُ الإِمَامُ ؟ إِذَا فَرَغَ الْمُؤَذِّنُ أَوْ قَبْلَ أَنْ يَفْرُغَ ؟ , قَالَ : \" أَيُّ ذَلِكَ فَعَلْتَ فَلا بَأْسَ ""","","","","","Book of Prayer"
"2463","قَالَ : وَأَخْبَرَنِي الأَعْمَشُ , عَنْ إِبْرَاهِيمَ : \" أَنَّهُ كَانَ يُكَبِّرُ , حِينَ يَقُولُ الْمُؤَذِّنُ : قَدْ قَامَتِ الصَّلاةُ ""","","","","","Book of Prayer"
"2464","عَنْ هُشَيْمٍ , عَنِ الْمُغِيرَةِ , عَنْ إِبْرَاهِيمَ : \" أَنَّهُ كَبَّرَ مَرَّةً , حِينَ قَالَ الْمُؤَذِّنُ : قَدْ قَامَتِ الصَّلاةُ ""","","","","","Book of Prayer"
"2465","عَنْ يَحْيَى بْنِ الْعَلاءِ , عَنْ مُغِيرَةَ , قال : قُلْتُ لإِبْرَاهِيمَ : إِذَا قَالَ الْمُؤَذِّنُ قَدْ قَامَتِ الصَّلاةُ أُكَبِّرُ مَكَانِي , أَوْ حِينَ يَفْرُغُ ؟ قَالَ : أَيُّ ذَلِكَ شِئْتَ , قَالَ : وَقَالَ إِبْرَاهِيمُ : التَّكْبِيرُ جَزْمٌ , يَقُولُ : لا يُمَدُّ ""","","","","","Book of Prayer"
"2466","عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ , عَنْ عَلِيِّ بْنِ عَلِيٍّ الرِّفَاعِيِّ , عَنْ أَبِي الْمُتَوَكِّلِ النَّاجِيِّ , عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ , قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا قَامَ مِنَ اللَّيْلِ فَاسْتَفْتَحَ صَلاتَهُ كَبَّرَ , ثُمَّ قَالَ : سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ , تَبَارَكَ اسْمُكَ , وَتَعَالَى جَدُّكَ , وَلا إِلَهَ غَيْرُكَ , ثُمَّ يُهَلِّلُ ثَلاثًا وَيُكَبِّرُ ثَلاثًا , ثُمَّ يَقُولُ : أَعُوذُ بِاللَّهِ السَّمِيعِ الْعَلِيمِ مِنَ الشَّيْطَانِ الرَّجِيمِ ""","","","","","Book of Prayer"
"2467","عَنِ الْمُثَنَّى بْنِ الصَّبَّاحِ , قَالَ : أَخْبَرَنِي عِكْرِمةَ بْنُ خَالِدٍ , أنَّ عُمَرَ كَانَ يُعَلِّمُ النَّاسَ إِذَا قَامَ الرَّجُلُ لِلصَّلاةِ , أَنْ يَقُولَ : \" سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ , وَتَبَارَكَ اسْمُكَ , وَتَعَالَى جَدُّكَ , لا إِلَهَ غَيْرُكَ \" , قَبْلَ الْقِرَاءَةِ عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنْ عُمَرَ مِثْلَهُ","","","","","Book of Prayer"
"2468","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , عَنِ الأَسْوَدِ , قَالَ : كَانَ عُمَرُ إِذَا اسْتَفْتَحَ الصَّلاةَ , قَالَ : \" سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ تَبَارَكَ اسْمُكَ وَتَعَالَى جَدُّكَ وَلا إِلَهَ غَيْرُكَ ""","","","","","Book of Prayer"
"2469","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي مَنْ أُصَدِّقُ , عَنْ أَبِي بَكْرٍ , وَعَنْ عُمَرَ , وَعَنْ عُثْمَانَ , وَعَنِ ابْنِ مَسْعُودٍ , أَنَّهُمْ كَانُوا إِذَا اسْتَفْتَحُوا , قَالُوا : \" سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ , وَتَبَارَكَ اسْمُكَ , وَتَعَالَى جَدُّكَ , وَلا إِلَهَ غَيْرُكَ ""","","","","","Book of Prayer"
"2470","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ رَجُلٍ , عَنِ ابْنِ عُمَرَ , قَالَ : أَتَى رَجُلٌ وَالنَّاسُ فِي الصَّلاةِ , فَقَالَ حِينَ وَصَلَ إِلَى الصَّفِّ : اللَّهُ أَكْبَرُ كَبِيرًا , وَالْحَمْدُ للَّهِ كَثِيرًا , وَسُبْحَانَ اللَّهِ بُكْرَةً وَأَصِيلا , فَلَمَّا قَضَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الصَّلاةَ قَالَ : \" مَنْ صَاحِبُ الْكَلِمَاتِ ؟ \" , قَالَ الرَّجُلُ : أَنَا يَا رَسُولَ اللَّهِ , وَاللَّهِ مَا أَرَدْتُ بِهِنَّ إِلا الْخَيْرَ , قَالَ : \" لَقَدْ رَأَيْتُ أَبْوَابَ السَّمَاءِ فُتِحَتْ لَهُنَّ \" , قَالَ ابْنُ عُمَرَ : فَمَا تَرَكْتُهُنَّ مُنْذُ سَمِعْتُهُنَّ","","","","","Book of Prayer"
"2471","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْهَيْثَمِ بْنِ حَنَشٍ , أَنَّهُ رَأَى ابْنَ عُمَرَ وَصَلَّى مَعَهُ إِلَى جَنْبِهِ , فَقَالَ : \" اللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ كَبِيرًا , وَالْحَمْدُ للَّهِ كَثِيرًا , وَسُبْحَانَ اللَّهِ بُكْرَةً وَأَصِيلا , اللَّهُمَّ اجْعَلْكَ أَحَبَّ شَيْءٍ إِلَيَّ وَأَحْسَنَ شَيْءٍ عِنْدِي ""","","","","","Book of Prayer"
"2472","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ حُمَيْدٍ الطَّوِيلِ , عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ : دَخَلَ رَجُلٌ وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي صَلاتِهِ , وَلَهُ نَفَسٌ , فَقَالَ حِينَ دَخَلَ : الْحَمْدُ للَّهِ كَثِيرًا مُبَارَكًا طَيِّبًا , فَلَمَّا فَرَغَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ صَلاتِهِ فَقَالَ : \" مَنْ صَاحِبُ الْكَلِمَاتِ ؟ مَرَّتَيْنِ \" , فَقَالَ رَجُلٌ : أَنَا يَا رَسُولَ اللَّهِ , قَالَ : \" لَقَدْ رَأَيْتُهَا يَبْتَدِرُهَا اثْنَا عَشَرَ مَلَكًا أَيُّهُمْ يَسْبِقُ بِهَا فِيُحَيِّي اللَّهَ تَبَارَكَ وَتَعَالَى \" , قَالَ : فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَا لِي أَسْمَعُ نَفَسَكَ ؟ \" , قَالَ : أُقِيمَتِ الصَّلاةُ فَأُسْرِعُ , قَالَ : \" إِذَا سَمِعْتَ الإِقَامَةَ فَامْشِ عَلَى هَيْئَتِكَ , فَمَا أَدْرَكْتَ فَصَلِّ , وَمَا فَاتَكَ فَاقْضِ ""","","","","","Book of Prayer"
"2473","عَنْ هِشَامِ بْنِ حَسَّانَ , عَنْ مُحَمَّدِ بْنِ سِيرِينَ , قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا قَامَ أَحَدُكُمْ مِنَ اللَّيْلِ فَلْيَسْتَفْتِحْ صَلاتَهُ بِرَكْعَتَيْنِ خَفِيفَتَيْنِ \" , قَالَ هِشَامٌ : فَكَانَ مُحَمَّدٌ يَقْرَأُ فِي الأُولَى مِنْهُمَا  يَأَيُّهَا الَّذِينَ آمَنُوا أَنْفِقُوا مِمَّا رَزَقْنَاكُمْ مِنْ قَبْلِ أَنْ يَأْتِيَ يَوْمٌ لا بَيْعٌ فِيهِ وَلا خُلَّةٌ  إِلَى خَالِدُونَ سورة البقرة آية 254ـ257 , وَفِي الآخِرَةِ :  لِلَّهِ مَا فِي السَّمَوَاتِ وَمَا فِي الأَرْضِ وَإِنْ تُبْدُوا مَا فِي أَنْفُسِكُمْ أَوْ تُخْفُوهُ يُحَاسِبْكُمْ بِهِ اللَّهُ فَيَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ , إِلَى آخِرِ السُّورَةِ","","","","","Book of Prayer"
"2474","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ رَبِيعَةَ بْنِ كَعْبٍ الأَسْلَمِيِّ , قَالَ : كُنْتُ أَنَامُ فِي حُجْرَةِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَكُنْتُ أَسْمَعُهُ إِذَا قَامَ مِنَ اللَّيْلِ يُصَلِّي , يَقُولُ : \" الْحَمْدُ للَّهِ رَبِّ الْعَالَمِينَ \" , الْهَوِيَّ , ثُمَّ يَقُولُ : \" سُبْحَانَ اللَّهِ الْعَظِيمِ وَبِحَمْدِهِ \" , الْهَوِيَّ قُلْتُ لَهُ : مَا الْهَوِيُّ , قَالَ : \" يَدْعُو سَاعَةً ""","","","","","Book of Prayer"
"2475","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي سُلَيْمَانُ الأَحْوَلُ , أَنَّ طَاوُسًا أَخْبَرَهُ , أَنَّهُ سَمِعَ ابْنَ عَبَّاسٍ , يَقُولُ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا سَجَدَ مِنَ اللَّيْلِ , قَالَ : \" اللَّهُمَّ لَكَ الْحَمْدُ أَنْتَ نُورُ السَّمَوَاتِ وَالأَرْضِ , وَلَكَ الْحَمْدُ أَنْتَ قَيُّومُ السَّمَوَاتِ وَالأَرْضِ وَمَنْ فِيهِنَّ , وَلَكَ الْحَمْدُ أَنْتَ رَبُّ السَّمَوَاتِ وَالأَرْضِ , أَنْتَ الْحَقُّ , وَوَعْدُكَ الْحَقُّ , وَلِقَاؤُكَ الْحَقُّ , وَقَوْلُكَ الْحَقُّ , وَالْجَنَّةُ حَقٌّ , وَالنَّارُ حَقٌّ , وَالنَّبِيُّونَ حَقٌّ , وَالسَّاعَةُ حَقٌّ , اللَّهُمَّ لَكَ أَسْلَمْتُ , وَبِكَ آمَنْتُ , وَعَلَيْكَ تَوَكَّلْتُ , وَإِلَيْكَ أَنَبْتُ , وَبِكَ خَاصَمْتُ , وَإِلَيْكَ حَاكَمْتُ , فَاغْفِرْ لِي مَا قَدَّمْتُ وَمَا أَخَّرْتُ , وَمَا أَسْرَرْتُ وَمَا أَعْلَنْتُ , أَنْتَ إِلَهِي لا إِلَهَ إِلا أَنْتَ ""","","","","","Book of Prayer"
"2476","عَنِ ابْنِ عُيَيْنَةَ , عَنْ سُلَيْمَانَ الأَحْوَلِ , عَنْ طَاوُسٍ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : كَانَ إِذَا قَامَ مِنَ اللَّيْلِ , قَالَ : \" اللَّهُمَّ لَكَ الْحَمْدُ لَكَ مُلْكُ السَّمَوَاتِ وَالأَرْضِ , وَلَكَ الْحَمْدُ أَنْتَ قَيِّمُ السَّمَوَاتِ وَالأَرْضِ وَمَا فِيهِنَّ , وَلَكَ الْحَمْدُ لَكَ مُلْكُ السَّمَوَاتِ وَالأَرْضِ وَمَنْ فِيهِنَّ , أَنْتَ الْحَقُّ , وَوَعْدُكَ الْحَقُّ , وَلِقَاؤُكَ حَقٌّ , وَالْجَنَّةُ حَقٌّ , وَالنَّارُ حَقٌّ , وَالنَّبِيُّونَ حَقٌّ , وَمُحَمَّدٌ حَقٌّ , وَالسَّاعَةُ حَقٌّ , اللَّهُمَّ لَكَ أَسْلَمْتُ , وَبِكَ آمَنْتُ , وَعَلَيْكَ تَوَكَّلْتُ , وَإِلَيْكَ أَنَبْتُ , وَبِكَ خَاصَمْتُ , وَإِلَيْكَ حَاكَمْتُ , فَاغْفِرْ لِي مَا قَدَّمْتُ وَأَخَّرْتُ , وَأَسْرَرْتُ وَأَعْلَنْتُ , أَنْتَ الْمُقَدِّمُ وَأَنْتَ الْمُؤَخِّرُ , لا إِلَهَ إِلا أَنْتَ ""","","","","","Book of Prayer"
"2477","عَنِ الْحَسَنِ بْنِ عُمَارَةَ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَاصِمِ بنِ ضَمْرَةَ , قَالَ : كَانَ عَلِيٌّ إِذَا افْتَتَحَ الصَّلاةَ , قَالَ : \" اللَّهُ أَكْبَرُ لا إِلَهَ إِلا أَنْتَ سُبْحَانَكَ , إِنِّي ظَلَمْتُ نَفْسِي فَاغْفِرْ لِي , إِنَّهُ لا يَغْفِرُ الذُّنُوبَ إِلا أَنْتَ , لَبَّيْكَ وَسَعْدَيْكَ , وَالْخَيْرُ فِي يَدَيْكَ , وَالشَّرُّ لَيْسَ إِلَيْكَ , وَالْمَهْدِيُّ مَنْ هَدَيْتَ , وَعَبْدُكَ بَيْنَ يَدَيْكَ , وَعَبْدُكَ بَيْنَ يَدَيْكَ , وَمِنْكَ وَإِلَيْكَ , وَلا مَلْجَأَ وَلا مَنْجَا مِنْكَ إِلا إِلَيْكَ , تَبَارَكْتَ وَتَعَالَيْتَ , سُبْحَانَكَ رَبَّ الْبَيْتِ ""","","","","","Book of Prayer"
"2478","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ مُوسَى بْنِ عُقْبَةَ , عَنْ عَبْدِ اللَّهِ بْنِ الْفَضْلِ , عَنْ عُبَيْدِ اللَّهِ بْنِ أَبِي رَافِعٍ , عَنْ عَلِيٍّ , قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا قَامَ إِلَى الصَّلاةِ الْمَكْتُوبَةِ كَبَّرَ , وَرَفَعَ يَدَيْهِ حِذْوَ مِنْكَبَيْهِ , ثُمَّ قَالَ : \"  وَجَّهْتُ وَجْهِيَ لِلَّذِي فَطَرَ السَّمَوَاتِ وَالأَرْضَ حَنِيفًا  الآيَةَ , وَآيَتَيْنِ بَعْدَهَا إِلَى الْمُسْلِمِينَ سورة الأنعام آية 79ـ163 , ثُمَّ يَقُولُ : \" أَنْتَ الْمَلِكُ لا إِلَهَ إِلا أَنْتَ , سُبْحَانَكَ أَنْتَ رَبِّي , وَأَنَا عَبْدُكَ , ظَلَمْتُ نَفْسِي , وَاعْتَرَفْتُ بِذَنْبِي , فَاغْفِرْ لِي ذُنُوبِي جَمِيعًا , إِنَّهُ لا يَغْفِرُ الذُّنُوبَ إِلا أَنْتَ , وَاهْدِنِي لأَحْسَنِ الأَخْلاقِ , لا يَهْدِي لأَحْسَنِهَا إِلا أَنْتَ , وَاصْرِفْ عَنِّي سَيِّئَهَا , لا يَصْرِفُ عَنِّي سَيِّئَهَا إِلا أَنْتَ , لَبَّيْكَ وَسَعْدَيْكَ , وَأَنَا بِكَ وَإِلَيْكَ , لا مَلْجَأَ وَلا مَنْجَا مِنْكَ إِلا إِلَيْكَ , تَبَارَكْتَ وَتَعَالَيْتَ , أَسْتَغْفِرُكَ وَأَتُوبُ إِلَيْكَ \" , قَالَ إِبْرَاهِيمُ : وَحَدَّثَنِي ابْنُ الْمُنْكَدِرِ , عَنْ عَلِيِّ بْنِ أَبِي طَالِبٍ مِثْلَهُ","","","","","Book of Prayer"
"2479","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ أَنَّهُ كَانَ إِذَا اسْتَفْتَحَ الصَّلاةَ , قَالَ : \" اللَّهُ أَكْبَرُ كَبِيرًا , وَالْحَمْدُ للَّهِ كَثِيرًا طَيِّبًا مُبَارَكًا فِيهِ , ثُمَّ يَقُولُ : رَبِّي رَبُّ السَّمَوَاتِ وَالأَرْضِ ,  لَنْ نَدْعُوَ مِنْ دُونِهِ إِلَهًا لَقَدْ قُلْنَا إِذًا شَطَطًا , اللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ ,  وَجَّهْتُ وَجْهِيَ لِلَّذِي فَطَرَ السَّمَوَاتِ وَالأَرْضَ , إِلَيَّ  وَأَنَا مِنَ الْمُسْلِمِينَ , ثُمَّ يَقُولُ : رَبِّي رَبُّ السَّمَوَاتِ وَالأَرْضِ  لَنْ نَدْعُوَ مِنْ دُونِهِ إِلَهًا لَقَدْ قُلْنَا إِذًا شَطَطًا , اللَّهُ أَكْبَرُ , الْحَمْدُ للَّهِ , لا إِلَهَ إِلا اللَّهُ , وَسُبْحَانَ اللَّهِ , وَتَبَارَكَ اللَّهُ , وَتَعَالَى اللَّهُ , مَا شَاءَ اللَّهُ , لا حَوْلَ وَلا قُوَّةَ إِلا بِاللَّهِ , أَشْهَدُ أَنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ , وَأَنَّ اللَّهَ سُبْحَانَهُ سُبْحَانَ رَبِّيَ الأَعْلَى , سُبْحَانَ الْمَلِكِ الْقُدُّوسِ الْعَزِيزِ الْحَكِيمِ , رَبِّ اغْفِرْ لِي , رَبِّ ارْحَمْنِي ,  رَبِّ أَعُوذُ بِكَ مِنْ هَمَزَاتِ الشَّيَاطِينِ { 97 } وَأَعُوذُ بِكَ رَبِّ أَنْ يَحْضُرُونِ { 98 } , أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ , إِنَّ اللَّهَ هُوَ السَّمِيعُ الْعَلِيمُ , قَالَ : كَانَ يَقُولُ : هَذَا هُوَ التَّطَوُّعُ ""","","","","","Book of Prayer"
"2480","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : هَلْ مِنْ قَوْلٍ إِذَا كَبَّرَ الْمَرْءُ قَبْلَ أَنْ يَقْرَأَ ؟ , فَقَالَ : \" بَلَغَنَا أَنَّهُ يُهَلِّلُ , إِذَا اسْتَفْتَحَ الْمَرْءُ فَلْيُكَبِّرْ , وَلْيَحْمَدْ , وَلْيَذْكُرْ , وَلْيَسْأَلْ إِنْ كَانَتْ لَهُ حَاجَةٌ قَبْلَ الْقِرَاءَةِ , قَالَ : وَلَمْ يَبْلُغْنِي , قَوْلٌ : مُسَمَّى إِلا كَذَلِكَ , قَالَ : فَنَظَرْتُ قَوْلا : جَامِعًا رَأَيْتُهُ مِنْ قَبْلِي فَقُلْتُهُ , قُلْتُ : أُكَبِّرُهُنَّ خَمْسًا , قَالَ : تَكْبِيرَةُ الأُولَى بِيَدَيْهِ وَارْفَعْ بِفِيهِ , قَالَ : فَأُكَبِّرُ خَمْسًا , وَأَحْمَدُ خَمْسًا , وَأُسَبِّحُ خَمْسًا , وَأَحْمَدُ خَمْسًا , وَأُهَلِّلُ خَمْسًا , ثُمَّ أَقُولُ : لا حَوْلَ وَلا قُوَّةَ إِلا بِاللَّهِ خَمْسًا , وَأَقُولُ : حِينَ أَقُولُ : آخِرَ كُلِّ وَاحِدَةٍ مِنَ التَّكْبِيرِ , وَالتَّسْبِيحِ , وَالتَّحْمِيدِ , وَالتَّهْلِيلِ , لا حَوْلَ وَلا قُوَّةَ إِلا بِاللَّهِ , عَدَدَ خَلْقِكَ , وَرِضَا نَفْسِكَ , وَزِنَةَ عَرْشِكَ , وَأَسْأَلُ حَاجَتِي , ثُمَّ أَسْأَلُ وَأَسْتَغْفِرُ وَأَسْتَعِيذُ , قَالَ : فَإِذَا بَلَغْتُ أُحِسُّ ذَلِكَ فِي نَفْسِي , قُلْتُ هَذَا الْقَوْلَ , قَالَ : وَكَثِيرًا مَا أُقَصِّرُ عَنْ ذَلِكَ , قَالَ : وَأَحَبُّ إِلَيَّ أَنْ يَكُونَ فِي الْمَكْتُوبَةِ وَالتَّطَوُّعِ , قُلْتُ لَهُ : فَإِنَّهُ يُكْرَهُ أَنْ يَسْتَغْفِرَ الإِنْسَانُ قَائِمًا فِي الْمَكْتُوبَةِ , يَقُولُ : وَلَكِنْ يُسَبِّحُ وَيَذْكُرُ اللَّهَ , قَالَ : فَإِنِّي لَمْ أَقْرَأْ بَعْدُ وَلَمْ أُصَلِّ بَعْدُ , إِنَّمَا هَذَا قَبْلَ الْقِرَاءَةِ , قُلْتُ : فَكُنْتُ دَاعِيًا عَلَى إِنْسَانٍ حِينَئِذٍ تُسَمِّيهِ ؟ , قَالَ : لا , إِنَّمَا قُمْتُ فِي حَاجَتِي , فَأَمَّا فِي غَيْرِ ذَلِكَ فَلا , فَقَالَ لَهُ إِنْسَانٌ : أَتُبَالِي لَوْ تَكَلَّمْتُ حِينَئِذٍ بَعْدَ التَّكْبِيرَةِ وَقَبْلَ الْقِرَاءَةِ ؟ , قَالَ : أَيْ لَعَمْرِي أَبَعْدَ مَا أُكَبِّرُ ؟ لا كَلامَ حِينَئِذٍ بَعْدَ التَّكْبِيرَةِ وَقَبْلَ الْقِرَاءَةِ ""","","","","","Book of Prayer"
"2481","عَنِ ابْنِ جُرَيْجٍ , قال : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْ لَمْ أَزِدْ عَلَى تَكْبِيرَةٍ وَاحِدَةٍ فِي الْمَكْتُوبَةِ , وَلَمْ أَقُلْ هَذَا الْقَوْلَ : أَخَرَجَتْ أَمْ نَقَصَتْ صَلاتِي ؟ , قَالَ : لا , ثُمَّ قَالَ : أَرَأَيْتَ لَوْ كَانَ لَكَ حَاجَةٌ إِلَى إِنْسَانٍ أَلَسْتَ تُثْنِي عَلَيْهِ قَبْلَ الْمَسْأَلَةِ ؟ ""","","","","","Book of Prayer"
"2482","عَنِ ابْنِ جُرَيْجٍ , قال : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْ قُلْتُ :  وَجَّهْتُ وَجْهِيَ لِلَّذِي فَطَرَ السَّمَوَاتِ وَالأَرْضَ  إِلَى الْمُسْلِمِينَ , قَالَ : \" ذَلِكَ شَيْءٌ أَحْدَثَهُ النَّاسُ \" , قَالَ عَطَاءٌ : وَقَدْ كَانَ مِمَّنْ يَعْتَرِيهِ إِذَا تَهَجَّدَ ابْتَدَأَ أَحَدُهُمْ فَكَبَّرَ , ثُمَّ ذَكَرَ اللَّهَ , ثُمَّ يَسْأَلُ , ثُمَّ يَقْرَأُ , ثُمَّ يَرْكَعُ رَكْعَتَيْنِ , ثُمَّ يَقُومُ فِيُصَلِّي أَوْ يَسْتَقْبِلُ صَلاتَهُ ""","","","","","Book of Prayer"
"2483","عَنْ هِشَامِ بْنِ حَسَّانَ , عَنِ الْحَسَنِ , قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا قَامَ مِنَ اللَّيْلِ كَبَّرَ ثَلاثًا , وَسَبَّحَ ثَلاثًا , وَهَلَّلَ ثَلاثًا , ثُمَّ يَقُولُ : \" اللَّهُمَّ , إِنِّي أَعُوذُ بِكَ مِنَ الشَّيْطَانِ مِنْ هَمْزِهِ وَنَفْثِهِ وَنَفْخِهِ \" , قَالُوا : مَا أَكْثَرَ مَا تَسْتَعِيذُ مِنْ هَذَا , قَالَ : \" أَمَّا هَمْزُهُ فَالْجُنُونُ , وَأَمَّا نَفْثُهُ فَالشِّعْرُ , وَأَمَّا نَفْخُهُ فَالْكِبْرُ ""","","","","","Book of Prayer"
"2484","عَنْ مَعْمَرٍ , عَنْ مَنْ سَمِعَ الْحَسَنَ , يَقُولُ : كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا قَامَ مِنَ اللَّيْلِ , قَالَ : \" اللَّهُ أَكْبَرُ كَبِيرًا مَرَّتَيْنِ , ثُمَّ يَقُولُ : اللَّهُ أَكْبَرُ كَبِيرًا , ثُمَّ يَقُولُ : لا إِلَهَ إِلا اللَّهُ ثَلاثَ مَرَّاتٍ , ثُمَّ يَقُولُ : اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الشَّيْطَانِ مِنْ نَفْثِهِ , وَنَفْخِهِ , وَهَمْزِهِ ""","","","","","Book of Prayer"
"2485","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : الاسْتِعَاذَةُ وَاجِبَةٌ لِكُلِّ قِرَاءَةٍ فِي الصَّلاةِ أَوْ غَيْرِهَا , قُلْتُ لَهُ : مِنْ أَجْلِ  فَإِذَا قَرَأْتَ الْقُرْءَانَ فَاسْتَعِذْ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ ؟ , قَالَ : \" نَعَمْ , قُلْتُ : فَأَقُولُ : بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , أَعُوذُ بِاللَّهِ السَّمِيعِ الْعَلِيمِ الرَّحْمَنِ الرَّحِيمِ مِنَ الشَّيْطَانِ الرَّجِيمِ , وَأَعُوذُ بِكَ رَبِّ أَنْ يَحْضُرُونِ , أَوْ يَدْخُلُوا بَيْتِيَ الَّذِي يُئْوِينِي , قَالَ : وَقَبْلَ مَا أَبْلُغُ مِنْ هَذَا الْقَوْلِ كَثِيرًا مَا أَدَعُ أَكْثَرَهُ , قَالَ : يُجْزِئُ عَنْكَ لا تَزِيدُ عَلَى أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ ""","","","","","Book of Prayer"
"2486","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ لَوِ اسْتَدْرَكَنِي آيَاتٌ فَقَرَأْتُهُنَّ عَلَيْكَ أَسْتَعِيذُ ؟ , قَالَ \" لا , إِنْ شِئْتَ , وَلَكِنْ إِنْ عَرَضْتَ قُرْآنًا , وَابْتَغَيْتَ فِي صَلاةٍ أَوْ غَيْرِهَا عَرْضًا قِرَاءَةً تَقْرَؤُهَا فَاسْتَعِذْ لَهَا \" , قُلْتُ : أَرَأَيْتَ لَوْ صَلَّيْتُ رَكْعَتَيْنِ خَفِيفَتَيْنِ أَسْتَعِيذُ لَهَا ؟ , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"2487","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ لَوْ أَنِّي دَخَلْتُ قَبْلَ الصَّلاةِ فَاسْتَفْتَحْتُ , فَاسْتَعَذْتُ , فَقَرَأْتُ حَتَّى أُقِيمَتِ الصَّلاةُ , أَسْتَعِيذُ لِلْمَكْتُوبَةِ أَيْضًا ؟ ثُمَّ أَنَصَرِفُ مِنَ الْمَكْتُوبَةِ ثُمَّ صَلَّيْتُ بَعْدَهَا مَا أَسْتَعِيذُ أَيْضًا ؟ , قَالَ : \" يُجْزِئُ عَنْكَ الاسْتِعَاذَةُ الأُولَى , فَإِنِ اسْتَعَذْتَ لِذَلِكَ فَحَسَنٌ ""","","","","","Book of Prayer"
"2488","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلْتُ نَافِعًا , مَوْلَى ابْنِ عُمَرَ , عَنْ هَلْ تَدْرِي كَيْفَ كَانَ ابْنُ عُمَرَ يَسْتَعِيذُ ؟ قَالَ : كَانَ يَقُولُ : \" اللَّهُمَّ أَعُوذُ بِكَ مِنَ الشَّيْطَانِ الرَّجِيمِ ""","","","","","Book of Prayer"
"2489","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , أَنَّهُ كَانَ يَقُولُ : \" رَبِّ أَعُوذُ بِكَ مِنْ هَمَزَاتِ الشَّيَاطِينِ , وَأَعُوذُ بِكَ رَبِّ أَنْ يَحْضُرُونِ أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ , إِنَّ اللَّهَ هُوَ السَّمِيعُ الْعَلِيمُ ""","","","","","Book of Prayer"
"2490","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : قَامَ أَبُو ذَرٍّ يُصَلِّي , فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" يَا أَبَا ذَرٍّ ! تَعَوَّذْ بِاللَّهِ مِنْ شَيْطَانِ الإِنْسِ وَالْجِنِّ ""","","","","","Book of Prayer"
"2491","عَنْ هِشَامِ بْنِ حَسَّانَ , عَنِ الْحَسَنِ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ : \" اللَّهُمَّ , إِنِّي أَعُوذُ بِكَ مِنَ الشَّيْطَانِ مِنْ هَمْزِهِ وَنَفْثِهِ وَنَفْخِهِ \" , قَالُوا : مَا أَكْثَرَ مَا تَسْتَعِيذُ مِنْ هَذَا لِمَنْ هَذَا ؟ , قَالَ : \" أَمَّا هَمْزُهُ فَهُوَ الْجُنُونُ , وَأَمَّا نَفْخُهُ فَالْكِبْرُ , وَأَمَّا نَفْثُهُ فَالشِّعْرُ ""","","","","","Book of Prayer"
"2492","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنْ أَبِي الأَحْوَصِ , عَنْ عَبْدِ اللَّهِ , قَالَ : \" هَمْزُهُ الْمُؤْتَةُ يَعْنِي الْجُنُونَ , وَنَفْخُهُ الْكِبْرَ , وَنَفْثُهُ الشِّعْرَ ""","","","","","Book of Prayer"
"2493","عَنِ الثَّوْرِيِّ , عَنْ سَعِيدٍ الْجُرَيْرِيِّ , قَالَ : حَدَّثَنَا يَزِيدُ بْنُ عَبْدِ اللَّهِ بْنِ الشِّخِّيرِ , عَنْ عُثْمَانَ بْنِ أَبِي الْعَاصِ , قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ , حَالَ الشَّيْطَانُ بَيْنِي وَبَيْنَ قِرَاءَتِي , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" ذَاكَ الشَّيْطَانُ , يُقَالُ لَهُ : خِنْزَبٌ , فَإِذَا أَحْسَسْتَهُ فَتَعَوَّذْ , وَاتْفِلْ عَنْ يَسَارِكْ ثَلاثًا ""","","","","","Book of Prayer"
"2494","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : فَمَا  وَقُلْ رَبِّ أَعُوذُ بِكَ مِنْ هَمَزَاتِ الشَّيَاطِينِ ؟ , قَالَ : \" قَوْلٌ مِنَ الْقُرْآنِ : لَيْسَ بِوَاجِبٍ فِي الصَّلاةِ ""","","","","","Book of Prayer"
"2495","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : فَاسْتَعَذْتُ بِرَكْعَتَيْنِ , ثُمَّ أُخْرَى , ثُمَّ أُخْرَى فَأَسْتَعِيذُ لِكُلِّ صَلاةٍ عَلَى السَّبْعِ ؟ , قَالَ : \" يُجْزِئُ عَنْكَ الأَوَّلُ , فَإِنِ اسْتَعَذْتَ أَيْضًا فَحَسَنٌ \" , قُلْتُ : صَلَّيْتُ فَبَيْنَا أَنَا أُصَلِّي جَاءَنِي إِنْسَانٌ لِحَاجَةٍ , فَانْصَرَفْتُ إِلَيْهِ فَقَضَى حَاجَتَهُ , ثُمَّ قُمْتُ أُصَلِّي مَرَّةً أُخْرَى , قَالَ : \" يُجْزِئُ عَنْكِ الأَوَّلُ , فَإِنِ اسْتَعَذْتَ أَيْضًا فَحَسَنٌ ""","","","","","Book of Prayer"
"2496","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" يُجْزِئُ عَنْكَ التَّعَوُّذُ فِي كُلِّ شَيْءٍ , وَإِنْ زِدْتَ فَلا بَأْسَ ""","","","","","Book of Prayer"
"2497","عَنِ الثَّوْرِيِّ , عَنِ الْعَلاءِ بْنِ الْمُسَيَّبِ , عَنْ إِبْرَاهِيمَ , قال : \" يُجْزِئُكَ التَّعَوُّذُ فِي أَوَّلِ شَيْءٍ ""","","","","","Book of Prayer"
"2498","عَنْ هِشَامٍ , عَنِ الْحَسَنِ : \" أَنَّهُ كَانَ يَسْتَعِيذُ مَرَّةً وَاحِدَةً فِي أَوَّلِ صَلاتِهِ ""","","","","","Book of Prayer"
"2499","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ : \" أَنَّهُ كَانَ يَسْتَعِيذُ قَبْلَ أَنْ يَقْرَأَ أُمَّ الْقُرْآنِ ""","","","","","Book of Prayer"
"2500","عَنْ جَعْفَرٍ , عَنْ عَلِيِّ بْنِ عَلِيٍّ الرِّفَاعِيِّ , عَنْ أَبِي الْمُتَوَكِّلِ , عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ : \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ قَبْلَ الْقِرَاءَةِ : أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ ""","","","","","Book of Prayer"
"2501","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ : \" أَنَّهُ كَانَ يَتَعَوَّذُ مِنَ الشَّيْطَانِ فِي الصَّلاةِ قَبْلَ أَنْ يَقْرَأَ أُمَّ الْقُرْآنِ , وَبَعْدَ مَا يَقْرَأُ أُمَّ الْقُرْآنِ , قَالَ : وَكَانَ الْحَسَنُ يَتَعَوَّذُ قَبْلَهَا ""","","","","","Book of Prayer"
"2502","عَنْ هِشَامِ بْنِ حَسَّانَ , قال : كَانَ الْحَسَنُ يَسْتَعِيذُ مَرَّةً حِينَ يَسْتَفْتِحُ صَلاتَهُ قَبْلَ أَنْ يَقْرَأَ فَاتِحَةَ الْكِتَابِ , أَعُوذُ بِاللَّهِ السَّمِيعِ الْعَلِيمِ مِنَ الشَّيْطَانِ الرَّجِيمِ , قَالَ : وَكَانَ ابْنُ سِيرِينَ يَسْتَعِيذُ فِي كُلِّ صَلاةٍ ""","","","","","Book of Prayer"
"2503","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ لَهُ : فَرَغْتُ مِنَ الْقَوْلِ قَبْلَ الْقِرَاءَةِ , قَالَ : \" ثُمَّ اسْتَعَذْتَ , فَاقْرَأْ : بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , أَعُوذُ بِاللَّهِ السَّمِيعِ الْعَلِيمِ الرَّحْمَنِ الرَّحِيمِ مِنَ الشَّيْطَانِ الرَّجِيمِ , وَأَعُوذُ بِكَ أَنْ يَحْضُرُونِ , وَيَدْخُلُوا بَيْتِيَ الَّذِي يُئْوِينِي ""","","","","","Book of Prayer"
"2504","عَنْ عَلِيٍّ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ : \" أَنَّهُ كَانَ يَسْتَعِيذُ بَعْدَ فَاتِحَةِ الْكِتَابِ \" , قَالَ حَمَّادٌ : \" وَكَانَ سَعِيدُ بْنُ جُبَيْرٍ يَسْتَعِيذُ قَبْلَهَا ""","","","","","Book of Prayer"
"2505","عَنْ رَجُلٍ , مِنْ أَهْلِ الْكُوفَةِ , عَنْ أَبِي إِسْحَاقَ , قال : \" كَانَ أَصْحَابُ ابْنِ مَسْعُودٍ يَتَعَوَّذُونَ بَعْدَ فَاتِحَةِ الْكِتَابِ ""","","","","","Book of Prayer"
"2506","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : نَسِيتُ الاسْتِعَاذَةَ , قَالَ : \" لا أَعُودُ وَلا أَسْجُدُ سَجْدَتَيِ السَّهْوِ , فَسَوْفَ أَسْتَعِيذُ \" , قُلْتُ : فَقَدْ أُمِرْنَا بِالاسْتِعَاذَةِ كَمَا أُمِرْنَا بِالْوُضُوءِ ؟ , قَالَ : \" لَيْسَ ذَلِكَ كَالْوُضُوءِ , كَلامٌ سَوْفَ أَقُولُهُ إِذَا ذَكَرْتُ فِي صَلاتِي \" , قُلْتُ : فَلَمْ أَذْكُرْ حَتَّى فَرَغْتُ , قَالَ : \" فَحَسَنٌ , أَفْرُغُ أَسْتَعِيذُ ""","","","","","Book of Prayer"
"2507","عَنْ مَعْمَرٍ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , قال : \" أَرْبَعٌ يُخْفِيهُنَّ الإِمَامُ : بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , وَالاسْتِعَاذَةِ , وَآمِينَ , وَإِذَا قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , قَالَ : رَبَّنَا لَكَ الْحَمْدُ ""","","","","","Book of Prayer"
"2508","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قال : \" خَمْسٌ يُخْفِيَنَّ سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ , وَالتَّعَوُّذُ , وَبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , وَآمِينَ , وَاللَّهُمَّ رَبَّنَا لَكَ الْحَمْدُ ""","","","","","Book of Prayer"
"2509","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , وَحُمَيْدٍ , وَأَبَانَ , عَنْ أَنَسٍ سَمِعْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَأَبَا بَكْرٍ , وَعُمَرَ , وَعُثْمَانَ يَقْرَءُونَ  الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ""","","","","","Book of Prayer"
"2510","عَنِ الثَّوْرِيِّ , عَنْ أَنَسٍ , قَالَ : كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَأَبُو بَكْرٍ , وَعُمَرُ يَفْتَتِحُونَ الْحَمْدُ للَّهِ رَبِّ الْعَالَمِينَ \" , قَالَ : قُلْتُ :  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , قَالَ : \" خَلْفَهَا يَقُولُ , خَلْفَهَا يَقُولُ : أَسَرِرْهَا ""","","","","","Book of Prayer"
"2511","عَنْ مَعْمَرٍ , عَنْ سَعِيدٍ الْجُرَيْرِيِّ , قَالَ : أَخْبَرَنِي مَنْ سَمِعَ ابْنَ عَبْدِ اللَّهِ بْنِ مُغَفَّلٍ , يَقُولُ : \"  قَرَأْتُ بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ \" , فَقَالَ لِي أَبِي : إِيَّاكَ وَالْحَدَثَ يَا بُنَيَّ , فَإِنِّي قَدْ صَلَّيْتُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَعُمَرَ , وَعُثْمَانَ فَكَانُوا يَقْرَءُونَ :  الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ""","","","","","Book of Prayer"
"2512","عَنْ إِسْرَائِيلَ , عَنْ ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ , عَنْ أَبِيهِ : \" أَنِّ عَلِيًّا كَانَ لا يَجْهَرُ بِـ  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , كَانَ يَجْهَرُ بِـ  الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ""","","","","","Book of Prayer"
"2513","عَنْ عُثْمَانَ بْنِ مَطَرٍ , عَنْ حُسَيْنٍ الْمُعَلِّمِ , عَنْ بُدَيْلٍ الْعُقَيْلِيِّ , عَنْ أَبِي الْجَوْزَاءِ , عَنْ عَائِشَةَ , قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَفْتَتِحُ صَلاتَهُ بِالتَّكْبِيرِ , وَيَفْتَتِحُ قِرَاءَتَهُ بِـ  الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ""","","","","","Book of Prayer"
"2514","عَنْ مَعْمَرٍ , قال : \" أَخْبَرَنِي مَنْ صَلَّى وَرَاءَ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ , فَسَمِعْتُهُ يَسْتَفْتِحُ الْقِرَاءَةَ بِـ  الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ""","","","","","Book of Prayer"
"2515","قَالَ مَعْمَرٌ : \" وَكَانَ الْحَسَنُ , وَقَتَادَةَ يَفْتَتِحَانِ بِـ  الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ""","","","","","Book of Prayer"
"2516","عَنِ الثَّوْرِيِّ , عَنْ أَبِي سُفِيَانَ طَرِيفٍ , عَنِ الْحَسَنِ , قَالَ : سَأَلْتُهُ عَنْ  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ أَجْهَرُهَا ؟ , قال : \" السُّنَّةُ الْحَمْدُ للَّهِ رَبِّ الْعَالَمِينَ , وَإِنْ كَانَ الرَّأْيُ فَالْحَمْدُ للَّهِ أَفْضَلُ مِنْ  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ ""","","","","","Book of Prayer"
"2517","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ الْمَلِكِ بْنِ أَبِي بَشِيرٍ , عَنْ عِكْرِمَةَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : الْجَهْرُ بِـ :  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ قِرَاءَةُ الأَعْرَابِ ""","","","","","Book of Prayer"
"2518","عَنِ الثَّوْرِيِّ , عَنِ الْعَلاءِ بْنِ الْمُسَيَّبِ , عَنْ رَجُلٍ , عَنْ إِبْرَاهِيمَ , قال : \" يُجْزِئُكَ بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ فِي أَوَّلِ شَيْءٍ , وَالتَّعَوُّذُ فِي أَوَّلِ شَيْءٍ ""","","","","","Book of Prayer"
"2519","عَنِ ابْنِ التَّيْمِيِّ , عَنْ مَطَرٍ , عَنْ عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ : \" أَنَّ أُبَيَّ بْنَ كَعْبٍ كَانَ يَفْتَتِحُ بِـ :  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ ""","","","","","Book of Prayer"
"2520","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ : \" أَنَّ ابْنَ عُمَرَ كَانَ لا يَدَعُ  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , يَفْتَتِحُ الْقِرَاءَةَ بِـ :  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ ""","","","","","Book of Prayer"
"2521","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبِي , عَنْ سَعِيدِ بْنِ جُبَيْرٍ أَخْبَرَهُ , قال : \"  وَلَقَدْ آتَيْنَاكَ سَبْعًا مِنَ الْمَثَانِي , أُمُّ الْقُرْآنِ , وَقَرَأْتُهَا عَلَى سَعِيدٍ كَمَا قَرَأْتُهَا عَلَيْكَ , ثُمَّ قَالَ :  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ الآيَةُ السَّابِعَةُ , قَالَ ابْنُ عَبَّاسٍ : قَدْ أَخْرَجَهَا اللَّهُ لَكُمْ فَمَا أَخْرَجَهَا لأَحَدٍ قَبْلَكُمْ , قَالَ عَبْدُ الرَّزَّاقِ : قَرَأَهَا عَلَيْنَا ابْنُ جُرَيْجٍ  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ آيَةً ,  الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ آيَةً ,  الرَّحْمَنِ الرَّحِيمِ آيَةً ,  مَالِكِ يَوْمِ الدِّينِ آيَةً ,  إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ آيَةً ,  اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ آيَةً ,  صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ إِلَى آخِرِهَا ""","","","","","Book of Prayer"
"2522","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ عَمْرِو بْنِ دِينَارٍ : \" أَنَّ ابْنَ عَبَّاسٍ كَانَ يَسْتَفْتِحُ الصَّلاةَ بِـ :  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ ""","","","","","Book of Prayer"
"2523","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ صَالِحٍ مَوْلَى التَّوْءَمَةِ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : \" يُفْتَتَحُ بِـ :  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ فِي الصَّلاةِ ""","","","","","Book of Prayer"
"2524","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , , أَنَّهُ قَالَ : \" كَانَ يَفْتَتِحُ بِـ :  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , وَيَقُولُ : آيَةٌ مِنْ كِتَابِ اللَّهِ تَعَالَى تَرَكَهَا النَّاسُ ""","","","","","Book of Prayer"
"2525","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ , أَنَّ أَبَاهُ : \" كَانَ إِذَا قَرَأَ لَهُمْ :  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ قَبْلَ أُمِّ الْقُرْآنِ لَمْ يَقْرَأْهَا بَعْدَهَا ""","","","","","Book of Prayer"
"2526","عَنِ الثَّوْرِيِّ , عَنْ عَاصِمِ بْنِ أَبِي النَّجُودِ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ : \" أَنَّهُ كَانَ يَجْهَرُ بِـ : بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ فِي كُلِّ رَكْعَةٍ ""","","","","","Book of Prayer"
"2527","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" لا أَدَعُ أَبَدًا بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ فِي مَكْتُوبَةٍ وَلا تَطَوُّعٍ إِلا نَاسِيًا , لأُمِّ الْقُرْآنِ وَلِلسُّورَةِ الَّتِي أَقْرَأُهَا بَعْدَهَا , قَالَ : \" هِيَ آيَةٌ مِنَ الْقُرْآنِ , قُلْتُ : فَإِنَّهُ بَلَغَنِي , أَنَّهَا لَمْ تَنْزِلْ مَعَ الْقُرْآنِ , وَأَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمْ يَكْتُبْهَا حَتَّى نَزَلَ :  إِنَّهُ مِنْ سُلَيْمَانَ وَإِنَّهُ بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , فَكَتَبَهَا حِينَئِذٍ قَالَ : \" مَا بَلَغَنِي ذَلِكَ , مَا هِيَ إِلا آيَةُ الْقُرْآنِ , قَالَ : وَقَالَ يَحْيَى بْنُ جَعْدَةَ : قَدِ اخْتَلَسَ الشَّيْطَانُ مِنَ الأَئِمَّةِ آيَةَ بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ ""","","","","","Book of Prayer"
"2528","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِعَطَاءٍ , إِنْ نَسِيتُهَا فِي الْمَكْتُوبَةِ أَعُودُ إِلَى الصَّلاةِ , أَوْ أَسْجُدُ سَجْدَتَيِ السَّهْوِ ؟ , قَالَ : \" أَيْ لَعَمْرِي إِنَّا لَنُسْقِطُ مِنَ الْقُرْآنِ فَنُكْثِرُ \" , قَالَ لَهُ إِنْسَانٌ : وَبَرَاءَةُ قَالَ : \" نَعَمْ , إِنَّمَا هِيَ وَالأَنْفَالُ وَاحِدَةٌ , وَأَلا أَدَعُ أَنْ أَقْرَأَهَا بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ ""","","","","","Book of Prayer"
"2529","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , أَنَّ سَعِيدَ بْنَ جُبَيْرٍ أَخْبَرَهُ : \" أَنَّ الْمُؤْمِنِينَ فِي عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانُوا لا يَعْلَمُونَ انْقِضَاءَ السُّورَةِ حَتَّى يَنْزِلَ : بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , فَإِذَا نَزَلَ : بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ عَلِمُوا أَنْ قَدْ نَزَلَتِ السُّورَةُ , وَانْقَضَتِ الأُخْرَى ""","","","","","Book of Prayer"
"2530","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي عَبْدُ اللَّهِ بْنُ عُثْمَانَ بْنِ خُثَيْمٍ , عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرِ بْنِ حَفْصِ بْنِ عُمَرَ بْنِ سَعْدٍ , أَنَّ مُعَاوِيَةَ صَلَّى بِالْمَدِينَةِ لِلنَّاسِ الْعَتَمَةَ , فَلَمْ يَقْرَأْ بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , وَلَمْ يُكَبِّرْ بَعْضَ هَذَا التَّكْبِيرِ الَّذِي يُكَبِّرُ النَّاسُ , فَلَمَّا انْصَرَفَ نَادَاهُ مَنْ سَمِعَ ذَلِكَ مِنَ الْمُهَاجِرِينَ وَالأَنْصَارِ , فَقَالُوا : \" يَا مُعَاوِيَةُ , أَسَرَقْتَ الصَّلاةَ أَمْ نَسِيتَ ؟ أَيْنَ بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ ؟ وَاللَّهُ أَكْبَرُ حَتَّى تَهْوِيَ سَاجِدًا ؟ \" فَلَمْ يَعُدْ مُعَاوِيَةُ لِذَلِكَ بَعْدُ","","","","","Book of Prayer"
"2531","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , عَنْ مُجَاهِدٍ , قال : \" نَسِيَ النَّاسُ بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , وَهَذَا التَّكْبِيرَ ""","","","","","Book of Prayer"
"2532","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ عَمْرِو بْنِ دِينَارٍ : \" أَنَّ ابْنَ عَبَّاسٍ , وَابْنَ عُمَرَ كَانَا يَفْتَتِحَانِ بِـ  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ \" , قَالَ أَبُو بَكْرٍ : وَصَلَّى بِنَا مَعْمَرٌ فَاسْتَفْتَحَ  الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ","","","","","Book of Prayer"
"2533","عَنْ مَعْمَرٍ , قَالَ : سَمِعْتُ أَيُّوبَ يَسْأَلُ عَاصِمَ بْنَ أَبِي النَّجُودِ : مَا سَمِعْتَ فِي قِرَاءَةِ  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ ؟ , قَالَ : أَخْبَرَنِي أَبُو وَائِلٍ , أَنَّهُ سَمِعَ عُمَرَ بْنَ الْخَطَّابِ يَفْتَتِحُ  الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ""","","","","","Book of Prayer"
"2534","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَوَاجِبَةٌ قِرَاءَةُ أُمِّ الْقُرْآنِ ؟ , قَالَ \" أَمَّا أَنَا فَلا أَدَعُهَا فِي الْمَكْتُوبَةِ وَالتَّطَوُّعِ فَاتِحَةَ الْقُرْآنِ , قَالَ : وَأَمَّا أَنَا فَسَمِعْتُ أَبَا هُرَيْرَةَ يَقُولُ : \" إِذَا قَرَأَ أَحَدُكُمْ بِأُمِّ الْقُرْآنِ , فَإِنِ انْتَهَى إِلَيْهَا كَفَتْهُ , وَإِنْ زَادَ عَلَيْهَا فَخَيْرٌ ""","","","","","Book of Prayer"
"2535","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ مَحْمُودِ بْنِ الرَّبِيعِ , عَنْ عُبَادَةَ بْنِ الصَّامِتِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لا صَلاةَ لِمَنْ لَمْ يَقْرَأْ بِأُمِّ الْقُرْآنِ فَصَاعِدًا ""","","","","","Book of Prayer"
"2536","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ هُرْمُزَ الأَعْرَجُ , أَنَّهُ سَمِعَ أَبَا سَعِيدٍ الْخُدْرِيَّ قَرَأَ بِأُمِّ الْقُرْآنِ فِي كُلِّ رَكْعَةٍ , أَوْ قَالَ : فِي كُلِّ صَلاةٍ ""","","","","","Book of Prayer"
"2537","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ : \" أَنَّ ابْنَ عُمَرَ لَمْ يَكُنْ لِيَدَعَ أَنْ يَقْرَأَ بِأُمِّ الْقُرْآنِ فِي كُلِّ رَكْعَةٍ مِنَ الْمَكْتُوبَةِ ""","","","","","Book of Prayer"
"2538","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ أَبِي الْعَالِيَةِ , قَالَ : سَمِعْتُ ابْنَ عُمَرَ يَقُولُ : \" إِنِّي لأَسْتَحْيِي مِنْ رَبِّ هَذِهِ الْبُنَيَّةِ أَنْ أُصَلِّيَ صَلاةً لا أَقْرَأُ فِيهَا بِأُمِّ الْقُرْآنِ وَشَيْءٍ مَعَهَا \" , قَالَ : وَسَأَلْتُ ابْنَ عَبَّاسٍ , فَقَالَ : \" اقْرَأْ مِنْهُ مَا قَلَّ أَوْ كَثُرَ , وَلَيْسَ مِنَ الْقُرْآنِ قَلِيلٌ ""","","","","","Book of Prayer"
"2539","عَنْ بِشْرِ بْنِ رَافِعٍ , قَالَ : أَخْبَرَنِي دِرْعُ بْنُ عَبْدِ اللَّهِ , عَنْ أَبِي أُمَيَّةَ الأَسَدِيِّ , قَالَ : قَالَ لِي عُبَادَةُ بْنُ الصَّامِتِ : \" اقْرَأْ بِأُمِّ الْقُرْآنِ فِي كُلِّ رَكْعَةٍ ""","","","","","Book of Prayer"
"2540","عَنْ إِسْرَائِيلَ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْعَيْزَارِ بْنِ حُرَيْثٍ , قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ , يَقُولُ : \" لا تُصَلِّيَنَّ صَلاةً حَتَّى تَقْرَأَ بِفَاتِحَةِ الْكِتَابِ فِي كُلِّ رَكْعَةٍ ""","","","","","Book of Prayer"
"2541","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَيَجْزِي عَنِّي فِي كُلِّ رَكْعَةٍ إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ , لَيْسَ مَعَهَا أُمُّ الْقُرْآنِ فِي الْمَكْتُوبَةِ ؟ , قَالَ \" لا , وَلا سُورَةُ الْبَقَرَةِ \" , قَالَ :  وَلَقَدْ آتَيْنَاكَ سَبْعًا مِنَ الْمَثَانِي , قَالَ : \" هِيَ السَّبْعُ \" , قُلْتُ : فَأَيْنَ السَّابِعَةُ ؟ , قَالَ : \"  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , وَهُوَ يُوجِبُ أُمَّ الْقُرْآنِ فِي كُلِّ رَكْعَةٍ ""","","","","","Book of Prayer"
"2542","عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي مَنْ سَأَلَ الْحَسَنَ عَنْ رَجُلٍ قَرَأَ فِي صَلاتِهِ كُلِّهَا بِقُرْآنٍ , وَلَمْ يَقْرَأْ بِأُمِّ الْقُرْآنِ , أَوْ قَالَ : بِفَاتِحَةِ الْكِتَابِ , قال : \" لا يُعِيدُ قَدْ قَرَأَ قُرْآنًا ""","","","","","Book of Prayer"
"2543","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ لَوْ أَنِّي اسْتَفْتَحْتُ بِسُورَةِ مَرْيَمَ , فَقَرَأْتُ بِأُمِّ الْقُرْآنِ , ثُمَّ جِئْتُ السَّجْدَةَ فَسَجَدْتُ , وَقُمْتُ أَقْرَأُ بِأُمِّ الْقُرْآنِ أَيْضًا ؟ , قَالَ : \" لا , أَنْتَ فِي الرَّكْعَةِ حَتَّى الآنَ , فَلا تَقْرَأْ فِيهَا إِنْ شِئْتَ ""","","","","","Book of Prayer"
"2544","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا قَالَ :  غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ قَالَ : آمِينَ , حَتَّى يُسْمِعَ مَنْ يَلِيهِ ""","","","","","Book of Prayer"
"2545","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ , عَنْ أَبِيهِ , قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا قَالَ : \"  غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ , قَالَ : آمِينَ , قَالَ مَعْمَرٌ : يُؤَمِّنُ وَإِنْ صَلَّى وَحْدًا","","","","","Book of Prayer"
"2546","عَنْ دَاوُدَ بْنِ قَيْسٍ , عَنْ مَنْصُورِ بْنِ مَيْسَرَةَ , قَالَ : صَلَّيْتُ مَعَ أَبِي هُرَيْرَةَ , فَكَانَ إِذَا قَالَ : \"  غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ , قَالَ : آمِينَ , حَتَّى يُسْمِعَنَا فِيُؤَمِّنُ مَنْ خَلْفَهُ , قَالَ : وَكَانَ يُكَبِّرُ بِنَا هَذَا التَّكْبِيرَ إِذَا رَكَعَ , وَإِذَا سَجَدَ ""","","","","","Book of Prayer"
"2547","عَنْ مَعْمَرٍ , وَالثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ : \" أَنَّهُ كَانَ يُسِرُّ آمِينَ ""","","","","","Book of Prayer"
"2548","عَنِ الثَّوْرِيِّ , عَنْ عَاصِمٍ , عَنْ أَبِي عُثْمَانَ , قَالَ : قَالَ بِلالٌ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا تَسْبِقْنِي بِآمِينَ ""","","","","","Book of Prayer"
"2549","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ أَبِي هُرَيْرَةَ : \" أَنَّهُ كَانَ مُؤَذِّنًا لِلْعَلاءِ بْنِ الْحَضْرَمِيِّ بِالْبَحْرَيْنِ , فَاشْتَرَطَ عَلَيْهِ بِأَنْ لا يَسْبِقَهُ بِآمِينَ ""","","","","","Book of Prayer"
"2550","عَنْ بِشْرِ بْنِ رَافِعٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ أَبِي هُرَيْرَةَ : \" أَنَّهُ كَانَ مُؤَذِّنًا لِلْعَلاءِ بْنِ الْحَضْرَمِيِّ , فَقَالَ لَهُ أَبُو هُرَيْرَةَ : \" لَتَنْظُرُنِي بِآمِينَ أَوْ لا أُؤَذِّنُ لَكَ ""","","","","","Book of Prayer"
"2551","عَنْ بِشْرِ بْنِ رَافِعٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ أَبِي سَلَمَةَ , أَنَّ أَبَا هُرَيْرَةَ دَخَلَ الْمَسْجِدَ , وَالإِمَامُ فَنَادَاهُ أَبُو هُرَيْرَةَ : \" لا تَسْبِقْنِي بِآمِينَ ""","","","","","Book of Prayer"
"2552","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ لَهُ : أَكَانَ ابْنُ الزُّبَيْرِ يُؤَمِّنُ عَلَى إِثْرِ أُمِّ الْقُرْآنِ ؟ , قَالَ : \" نَعَمْ , وَيُؤَمِّنُ مَنْ وَرَاءَهُ حَتَّى أَنَّ لِلْمَسْجِدِ لَلَجَّةً , ثُمَّ قَالَ : إِنَّمَا آمِينَ دُعَاءٌ \" , وَكَانَ أَبُو هُرَيْرَةَ يَدْخُلُ الْمَسْجِدَ وَقَدْ قَامَ الإِمَامُ قَبْلَهُ , فِيَقُولُ : \" لا تَسْبِقْنِي بِآمِينَ ""","","","","","Book of Prayer"
"2553","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ عَنْ نَافِعٍ , أَنَّ ابْنَ عُمَرَ , كَانَ إِذَا خَتَمَ أُمَّ الْقُرْآنِ , قَالَ : \" آمِينَ , لا يَدَعُ أَنْ يُؤَمِّنَ إِذَا خَتَمَهَا , وَيَحُضُّهُمْ عَلَى قَوْلِهَا \" , قَالَ : وَسَمِعْتُ مِنْهُ فِي ذَلِكَ خَبَرًا","","","","","Book of Prayer"
"2554","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي ابْنُ طَاوُسٍ : \" لا يَعْلَمُ أَبَاهُ إِلا كَانَ يَقُولُهَا الإِمَامُ وَمَنْ وَرَاءَهُ ""","","","","","Book of Prayer"
"2555","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : آمِينَ ؟ , قَالَ : \" لا أَدَعُهَا أَبَدًا \" , قَالَ : إِثْرَ أُمِّ الْقُرْآنِ فِي الْمَكْتُوبَةِ وَالتَّطَوُّعِ ؟ , قَالَ : \" وَلَقَدْ كُنْتُ أَسْمَعُ الأَئِمَّةَ , يَقُولُونَ عَلَى إِثْرِ أُمِّ الْقُرْآنِ : آمِينَ , هُمْ أَنْفُسُهُمْ وَمَنْ وَرَاءَهُمْ حَتَّى أَنَّ لِلْمَسْجِدِ لَلَجَّةً ""","","","","","Book of Prayer"
"2556","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنِ ابْنِ الْمُسَيِّبِ , عَنْ أَبِي هُرَيْرَةَ , أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" إِذَا قَالَ الإِمَامُ :  غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ , فَقُولُوا : آمِينَ , فَإِنَّ الْمَلائِكَةَ تَقُولُ : آمِينَ , وَإِنَّ الإِمَامَ يَقُولُ : آمِينَ , فَمَنْ وَافَقَ تَأْمِينُهُ تَأْمِينَ الْمَلائِكَةِ غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ \" , عَنْ مَعْمَرٍ , عَنْ هَمَّامِ بْنِ مُنَبِّهٍ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَذَكَرَ مِثْلَ حَدِيثِ الزُّهْرِيِّ","","","","","Book of Prayer"
"2557","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَطَاءً , قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ : \" إِذَا وَافَقَتْ آمِينَ فِي الأَرْضِ آمِينَ فِي السَّمَاءِ غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ ""","","","","","Book of Prayer"
"2558","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنْ يُونُسَ بْنِ جُبَيْرٍ , عَنْ حَطَّانَ بْنِ عَبْدِ اللَّهِ الرِّقَاشِيِّ , عَنْ أَبِي مُوسَى الأَشْعَرِيِّ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا قَالَ الإِمَامُ :  غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ , فَقُولُوا : آمِينَ , يُجِبْكُمُ اللَّهُ ""","","","","","Book of Prayer"
"2559","عَنْ مَعْمَرٍ , قَالَ : حَدَّثَنِي مَنْ سَمِعَ عِكْرِمَةَ , يَقُولُ : \" صُفُوفُ أَهْلِ الأَرْضِ عَلَى صُفُوفِ أَهْلِ السَّمَاءِ , فَإِذَا وَافَقَ آمِينَ فِي الأَرْضِ آمِينَ فِي السَّمَاءِ غُفِرَ لَهُ ""","","","","","Book of Prayer"
"2560","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : مَا حَسَدَكُمُ الْيَهُودُ عَلَى شَيْءٍ مَا حَسَدُوكُمْ عَلَى آمِينَ , وَالسَّلامَ يُسَلِّمُ بَعْضُكُمْ عَلَى بَعْضٍ \" , قَالَ : وَبَلَغَنِي ذَلِكَ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","","","","","Book of Prayer"
"2561","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ هِلالِ بْنِ يَسَافٍ , قال : \" آمِينَ اسْمٌ مِنْ أَسْمَاءِ اللَّهِ عَزَّ وَجَلَّ ""","","","","","Book of Prayer"
"2562","عَنْ بِشْرِ بْنِ رَافِعٍ , عَنْ أَبِي عَبْدِ اللَّهِ , عَنْ أَبِي هُرَيْرَةَ , يَقُولُ : \" كَانَ مُوسَى بْنُ عِمْرَانَ إِذَا دَخَلَ أَمَّنَ هَارُونُ عَلَى دُعَائِهِ ""","","","","","Book of Prayer"
"2563","قَالَ : وَسَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ : \" آمِينَ اسْمٌ مِنْ أَسْمَاءِ اللَّهِ عَزَّ وَجَلَّ ""","","","","","Book of Prayer"
"2564","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ : \" إِنِّي لأَعْجَبُ مِنَ الإِنْسَانِ يَدْعُو فِيَجْعَلُ دُعَاءَهُ سَرْدًا , لا يُؤَمِّنُ عَلَى دُعَائِهِ , قَالَ : يَقُولُ : آمِينَ ""","","","","","Book of Prayer"
"2565","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِذَا قَرَأَ الإِمَامُ بِأُمِّ الْقُرْآنِ فِي الآخِرَةِ مِنَ الْمَغْرِبِ , وَ الآخِرَتَيْنِ مِنَ الْعِشَاءِ كَيْفَ يُؤَمِّنُ ؟ , قَالَ \" يُخَافِتُ بِآمِينَ فِي نَفْسِهِ ""","","","","","Book of Prayer"
"2566","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : نَسِيتُ آمِينَ , قَالَ : \" لا تُعِدْ , وَلا تَسْجُدِ السَّهْوَ ""","","","","","Book of Prayer"
"2567","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : مَا يُجْهَرُ بِهِ الصَّوْتُ مِنَ الْقِرَاءَةِ مِنْ صَلاةِ اللَّيْلِ وَالنِّهَارِ مِنَ الْمَكْتُوبَةِ ؟ , قَالَ : \" الصُّبْحَ , وَالأُولَيَيْنِ الْعِشَاءَ , وَالأُولَيَيْنِ الْمَغْرِبَ , وَالْجُمُعةَ إِذَا كَانَتْ فِي جَمَاعَةٍ , فَأَمَّا إِذَا كَانَ الْمَرْءُ وَحْدَهُ فَلا , هِيَ الظُّهْرُ حِينَئِذٍ , وَالْفِطْرُ حِينَئِذٍ , قَالَ : وَأَظُنُّ الأَضْحَى مِثْلَ الْفِطْرِ ""","","","","","Book of Prayer"
"2568","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ عُبَيْدِ اللَّهِ بْنِ أَبِي رَافِعٍ , قَالَ : \" كَانَ يَعْنِي عَلِيًّا يَقْرَأُ فِي الأُولَيَيْنِ مِنَ الظُّهْرِ وَالْعَصْرِ بِأُمِّ الْقُرْآنِ وَسُورَةٍ , وَلا يَقْرَأُ فِي الأُخْرَيَيْنِ ""","","","","","Book of Prayer"
"2569","قَالَ الزُّهْرِيُّ : \" وَكَانَ جَابِرُ بْنُ عَبْدِ اللَّهِ يَقْرَأُ فِي الرَّكْعَتَيْنِ الأُولَيَيْنِ مِنَ الظُّهْرِ وَالْعَصْرِ بِأُمِّ الْقُرْآنِ وَسُورَةٍ , وَفِي الأُخْرَيَيْنِ بِأُمِّ الْقُرْآنِ , قَالَ الزُّهْرِيُّ : وَالْقَوْمُ يَقْتَدُونَ بِإِمَامِهِمْ ""","","","","","Book of Prayer"
"2570","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ : \" كَانَ لا يَقْرَأُ فِي الآخِرَتَيْنِ , وَيُسَمِّيهُمَا سُبْحَتَيْنِ ""","","","","","Book of Prayer"
"2571","عَنْ أَبِي حَنِيفَةَ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , قال : \" مَا قَرَأَ عَلْقَمَةُ فِي الرَّكْعَتَيْنِ الأُخْرَيَيْنِ حَرْفًا قَطُّ ""","","","","","Book of Prayer"
"2572","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قال : \" اقْرَأْ فِي الأُولَيَيْنِ بِفَاتِحَةِ الْكِتَابِ وَسُورَةٍ , وَفِي الأُخْرَيَيْنِ سَبِّحْ ""","","","","","Book of Prayer"
"2573","عَنِ الثَّوْرِيِّ , عَنْ إِبْرَاهِيمَ , قال : \" كَانَ لا يَقْرَأُ فِي الأُخْرَيَيْنِ ""","","","","","Book of Prayer"
"2574","قَالَ حَمَّادٌ : \" وَكَانَ سَعِيدُ بْنُ جُبَيْرٍ يَقْرَأُ بِفَاتِحَةِ الْكِتَابِ ""","","","","","Book of Prayer"
"2575","عَنْ دَاوُدَ بْنِ قَيْسٍ , عَنْ عُبَيْدِ اللَّهِ بْنِ مِقْسَمٍ , قَالَ : سَأَلْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ , قَالَ : \" أَمَّا أَنَا فَأَقْرَأُ فِي الرَّكْعَتَيْنِ الأُولَيَيْنِ مِنَ الظُّهْرِ وَالْعَصْرِ بِفَاتِحَةِ الْكِتَابِ وَسُورَةٍ , وَفِي الأُخْرَيَيْنِ بِفَاتِحَةِ الْكِتَابِ \" , عَنِ الثَّوْرِيِّ , عَنْ أَيُّوبَ بْنِ مُوسَى , عَنْ عُبَيْدِ اللَّهِ بْنِ مِقْسَمٍ , عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ مِثْلَهُ","","","","","Book of Prayer"
"2576","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ الْعَزِيزِ , عَنْ ذَكْوَانَ : \" أَنَّ عَائِشَةَ كَانَتْ تَقْرَأُ فِي الأُخْرَيَيْنِ بِفَاتِحَةِ الْكِتَابِ ""","","","","","Book of Prayer"
"2577","عَنْ مَعْمَرِ بْنِ رَاشِدٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ يَعِيشَ بْنِ الْوَلِيدِ , عَنْ خَالِدِ بْنِ مَعْدَانَ , أَنَّ أَبَا الدَّرْدَاءِ , كَانَ يَقُولُ \" أَقْرَأُ فِي الرَّكْعَتَيْنِ الأُولَيَيْنِ مِنَ الظُّهْرِ وَالْعَصْرِ وَالْعِشَاءِ الآخِرَةِ فِي كُلِّ رَكْعَةٍ بِأُمِّ الْقُرْآنِ وَسُورَةٍ , وَفِي الرَّكْعَةِ الآخِرَةِ مِنَ الْمَغْرِبِ بِأُمِّ الْقُرْآنِ ""","","","","","Book of Prayer"
"2578","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاء : أَيُجْزِئُ عَنِّي أُمُّ الْقُرْآنِ فِي الْمَكْتُوبَةِ فِي الأَرْبَعِ قَطُّ ؟ , قَالَ \" نَعَمْ \" , قُلْتُ : أَنَزِيدُ فِي الظُّهْرِ وَالْعَصْرِ عَلَى أُمِّ الْقُرْآنِ ؟ , قَالَ : نَعَمْ , قُلْ هُوَ اللَّهُ أَحَدٌ وَنَحْوَ ذَلِكَ \" , قُلْتُ : أَنَزِيدُ فِي الآخِرَةِ مِنَ الْمَغْرِبِ وَالآخِرَتَيْنِ مِنَ الْعِشَاءِ عَلَى أُمِّ الْقُرْآنِ ؟ , قَالَ : \" نَعَمْ , قُلْ هُوَ اللَّهُ أَحَدٌ , وَنَحْوَ ذَلِكَ ""","","","","","Book of Prayer"
"2579","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ لَوْ لَمْ أَقْرَأْ فِي الْمَكْتُوبَةِ فِي الْفَصْلِ , وَقَرَأْتُ بِبَعْضِ السُّورَةِ مِنْ أَوَّلِهَا , أَوْ وَسَطِهَا , أَوْ آخِرِهَا ؟ , قَالَ : \" لا يَضُرُّكَ , كُلُّهُ قُرْآنٌ ""","","","","","Book of Prayer"
"2580","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ عَبَّادِ بْنِ جَعْفَرٍ , يَقُولُ : أَخْبَرَنِي أَبُو سَلَمَةَ بْنُ سُفِيَانَ , وَعَبْدُ اللَّهِ بْنُ عَمْرِو بْنِ عَبْدِ الْقَارِئِ , وَعَبْدُ اللَّهِ بْنُ الْمُسَيِّبِ الْعَابِدِيُّ , عَنْ عَبْدِ اللَّهِ بْنِ السَّائِبِ , قَالَ : صَلَّى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الصُّبْحَ بِمَكَّةَ فَاسْتَفْتَحَ سُورَةَ الْمُؤْمِنِينَ حَتَّى إِذَا جَاءَ ذِكْرُ مُوسَى , وَهَارُونَ أَوْ عِيسَى  ابْنُ عَبَّادٍ يَشُكُّ أَوِ اخْتَلَفُوا عَلَيْهِ أَخَذَتِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سَعْلَةٌ , فَحَذَفَ , فَرَكَعَ \" , وَعَبْدُ اللَّهِ بْنُ السَّائِبِ حَاضِرٌ ذَلِكَ","","","","","Book of Prayer"
"2581","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ : \" أَنَّ ابْنَ مَسْعُودٍ صَلَّى بِهِمُ الْعِشَاءَ فَقَرَأَ بِأَرْبَعِينَ مِنَ الأَنْفَالِ , ثُمَّ قَرَأَ فِي الثَّانِيَةِ بِسُورَةٍ مِنَ الْمُفَصَّلِ ""","","","","","Book of Prayer"
"2582","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ , قَالَ : \" صَلَّى بِنَا ابْنُ مَسْعُودٍ صَلاةَ الْعِشَاءِ الآخِرَةِ , فَاسْتَفْتَحَ بِسُورَةِ الأَنْفَالِ حَتَّى إِذَا بَلَغَ  نِعْمَ الْمَوْلَى وَنِعْمَ النَّصِيرُ رَكَعَ , ثُمَّ قَرَأَ فِي الثَّانِيَةِ بِسُورَةٍ مِنَ الْمُفَصَّلِ ""","","","","","Book of Prayer"
"2583","عَنِ ابْنِ جُرَيْجٍ , قَالَ : \" قُلْتُ لِنَافِعٍ : أَكَانَ ابْنُ عُمَرَ , يَقْرَأُ فِي الرَّكْعَةِ مِنَ الْمَكْتُوبَةِ بِبَعْضِ السُّورَةِ الطَّوِيلَةِ ثُمَّ يَرْكَعُ ؟ , قَالَ : لا ""","","","","","Book of Prayer"
"2584","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , قال : \" كَانُوا يَقْرَءُونَ فِي الظُّهْرِ وَالْعَصْرِ فِي الرَّكْعَتَيْنِ الأُولَيَيْنِ بِفَاتِحَةِ الْكِتَابِ وَمَا تَيَسَّرَ , وَفِي الأُخْرَيَيْنِ بِفَاتِحَةِ الْكِتَابِ ""","","","","","Book of Prayer"
"2585","عَنِ الثَّوْرِيِّ , عَنْ عَلِيِّ بْنِ زَيْدِ بْنِ جَدْعَانَ , عَنِ الْحَسَنِ , وَغَيْرِهِ , قَالَ : كَتَبَ عُمَرُ إِلَى أَبِي مُوسَى : \" أَنِ اقْرَأْ فِي الْمَغْرِبِ بِقِصَارِ الْمُفَصَّلِ , وَفِي الْعِشَاءِ بِوَسَطِ الْمُفَصَّلِ , وَفِي الصُّبْحِ بِطِوَالِ الْمُفَصَّلِ ""","","","","","Book of Prayer"
"2586","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , قال : \" الأُولَى مِنَ الصَّلَوَاتِ أَطْوَلُ فِي الْقِرَاءَةِ ""","","","","","Book of Prayer"
"2587","عَنْ إِسْرَائِيلَ , قَالَ : أَخْبَرَنِي عِيسَى بْنُ أَبِي عَزَّةَ : أَنَّهُ سَمِعَ الشَّعْبِيَّ , قَالَ : \" الأُولَى مِنَ الصَّلَوَاتِ أَطْوَلُ فِي الْقِرَاءَةِ ""","","","","","Book of Prayer"
"2588","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ عَبْدِ اللَّهِ بْنِ أَبِي قَتَادَةَ , عَنْ أَبِيهِ , قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي بِنَا الظُّهْرَ فَرُبَّمَا أَسْمَعَنَا الآيَةَ , وَكَانَ يُطَوِّلُ الرَّكْعَةَ الأُولَى مِنْ صَلاةِ الْفَجْرِ , وَيُطَوِّلُ الرَّكْعَةَ الأُولَى مِنْ صَلاةِ الظُّهْرِ , فَظَنَنَّا أَنَّهُ يُرِيدُ بِذَلِكَ أَنْ يُدْرِكَ النَّاسُ الرَّكْعَةَ الأُولَى ""","","","","","Book of Prayer"
"2589","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ عُمَارَةَ بْنِ عُمَيْرٍ , عَنْ أَبِي مَعْمَرٍ , قَالَ : سَأَلْنَا خَبَّابًا هَلْ كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي الظُّهْرِ وَالْعَصْرِ ؟ , فَقَالَ : \" نَعَمْ \" , قُلْنَا : بِأَيِّ شَيْءٍ عَرَفْتَ ذَلِكَ ؟ , قَالَ : \" بِاضْطِرَابِ لِحْيَتِهِ ""","","","","","Book of Prayer"
"2590","عَنِ الثَّوْرِيِّ , عَنْ زَيْدٍ الْعَمِّيِّ , عَنْ أَبِي الْعَالِيَةَ , قَالَ : \" كَانَ أَصْحَابُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَمَقُوهُ فِي الظُّهْرِ فَحَزَرُوا قِرَاءَتَهُ فِي الرَّكْعَةِ الأُولَى مِنَ الظُّهْرِ بِتَنْزِيلِ السَّجْدَةِ ""","","","","","Book of Prayer"
"2591","عَنِ ابْنِ التَّيْمِيِّ , عَنْ أَبِيهِ , عَنْ أَبِي مِجْلَزٍ : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سَجَدَ فِي صَلاةِ الظُّهْرِ , ثُمَّ قَامَ فَقَرَأَ , فِيَرَوْنَ أَنَّهُ قَرَأَ الم تَنْزِيلُ وَهُوَ يُصَلِّي بِأَصْحَابِهِ ""","","","","","Book of Prayer"
"2592","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنْ مُوَرِّقٍ الْعِجْلِيِّ , قَالَ : \" كَانَ ابْنُ عُمَرَ يُصَلِّي فِيَقْرَأُ فِي الظُّهْرِ بِقَافٍ , وَاقْتَرَبَتِ \" , قَالَ مَعْمَرٌ : فَأَخْبَرَنِي شَيْخٌ لَنَا , عَنْ مُوَرِّقٍ الْعِجْلِيِّ , قُلْنَا : مِنْ أَيْنَ عَلِمْتَ ؟ , قَالَ : \" رُبَّمَا سَمِعْتُ مِنْهُ الآيَةَ \" . عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ , عَنْ أَبَانَ , عَنْ مُوَرِّقٍ الْعِجْلِيِّ مِثْلَ حَدِيثِ قَتَادَةَ","","","","","Book of Prayer"
"2593","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ : \" أَنَّهُ كَانَ يَقْرَأُ فِي الظُّهْرِ الَّذِينَ كَفَرُوا , وَفِي إِنَّا فَتَحْنَا لَكَ \" , عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ مِثْلَهُ","","","","","Book of Prayer"
"2594","عَنِ الثَّوْرِيِّ , عَنْ حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ , قَالَ : سَأَلْتُ إِبْرَاهِيمَ : كَمْ تَقْرَأُ فِي الرَّكْعَةِ الأُولَى ؟ , قَالَ : \" قَدْرَ ثَلاثِينَ آيَةً ""","","","","","Book of Prayer"
"2595","عَنِ ابْنِ عُيَيْنَةَ , عَنِ ابْنِ أَبِي نَجِيحٍ , وَعَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ , عَنْ أَبِيهِ , عَنْ مَالِكِ بْنِ أَوْسِ بْنِ الْحَدَثَانِ , قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : \" أُشَبِّهُ صَلاةَ النِّهَارِ بِصَلاةِ اللَّيْلِ , صَلاةَ الْهَجِيرِ ""","","","","","Book of Prayer"
"2596","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ : \" أَنَّ ابْنَ عُمَرَ كَانَ يَقْرَأُ فِي الرَّكْعَةِ الأُولَى مِنَ الظُّهْرِ وَالذَّارِيَاتِ ""","","","","","Book of Prayer"
"2597","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" قَدْ كَانَتِ الْعَصْرُ تُجْعَلُ أَخَفَّ مِنَ الظُّهْرِ فِي الْقِرَاءَةِ ""","","","","","Book of Prayer"
"2598","عَنْ مَعْمَرٍ , عَنْ ثَابِتٍ : \" كَانَ أَنَسٌ يُصَلِّي بِنَا الظُّهْرَ وَالْعَصْرَ فَرُبَّمَا أَسْمَعَنَا مِنْ قِرَاءَتِهِ إِذَا السَّمَاءُ انْفَطَرَتْ , وَسَبِّحِ اسْمَ رَبِّكَ الأَعْلَى ""","","","","","Book of Prayer"
"2599","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" يَقْرَأُ فِي الرَّكْعَتَيْنِ الأُولَيَيْنِ مِنْ صَلاةِ الْعَصْرِ إِذَا السَّمَاءُ انْشَقَّتْ , وَالسَّمَاءِ ذَاتِ الْبُرُوجِ ""","","","","","Book of Prayer"
"2600","عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ , عَنْ أَبَانَ , عَنْ مُوَرِّقٍ , قَالَ : \" صَلَّيْنَا مَعَ ابْنِ عُمَرَ الْعَصْرَ فَقَرَأَ بِـ الْمُرْسَلاتِ , وَعَمَّ يَتَسَاءَلُونَ ""","","","","","Book of Prayer"
"2601","عَنِ الثَّوْرِيِّ , عَنْ زِيَادِ بْنِ الْفَيَّاضِ , قَالَ : سَأَلَ تَمِيمُ بْنُ سَلَمَةَ إِبْرَاهِيمَ , وَأَنَا أَسْمَعُ عَنِ الْقِرَاءَةِ فِي الْعَصْرِ , قَالَ : \" هِيَ مِثْلُ الْمَغْرِبِ \" , قَالَ سُفِيَانُ : \" وَقْتُ قِرَاءَةِ الْعَصْرِ وَاللَّيْلِ إِذَا يَغْشَى , وَ سَبِّحِ اسْمَ رَبِّكَ الأَعْلَى , وَالتِّينِ وَالزَّيْتُونِ ""","","","","","Book of Prayer"
"2602","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ أَبِي مُلَيْكَةَ , يَقُولُ : أَخْبَرَنِي عُرْوَةُ بْنُ الزُّبَيْرِ , أَنَّ مَرْوَانَ بْنَ الْحَكَمِ أَخْبَرَهُ , قَالَ : قَالَ لِي زَيْدُ بْنُ ثَابِتٍ : مَا لَكَ تَقْرَأُ فِي الْمَغْرِبِ بِقِصَارِ الْمُفَصَّلِ ؟ وَقَدْ كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي صَلاةِ الْمَغْرِبِ بِطُولَى الطُّولَيَيْنِ \" , قَالَ : قُلْتُ : وَمَا طُولَى الطُّولَيَيْنِ ؟ , قَالَ : \" الأَعْرَافُ \" , قَالَ : قُلْتُ لابْنِ أَبِي مُلَيْكَةَ : وَمَا الطُّولَيَانِ ؟ , قَالَ : فَكَأَنَّهُ قَالَ : مِنْ قِبَلِ رَأْيِهِ : \" الأَنْعَامُ , وَالأَعْرَافُ ""","","","","","Book of Prayer"
"2603","أَخْبَرَنِي مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنْ مُحَمَّدِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ , عَنْ أَبِيهِ , وَكَانَ قَدِمَ فِي فِدَاءِ الأَسْرَى , أَسَارَى يَوْمِ بَدْرٍ , قَالَ : \" سَمِعْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي الْمَغْرِبِ بِالطُّورِ ""","","","","","Book of Prayer"
"2604","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عُثْمَانُ بْنُ أَبِي سُلَيْمَانَ , أَنَّ جُبَيْرَ بْنَ مُطْعِمٍ , قَالَ : \" قَرَأَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْمَغْرِبِ بِالطُّورِ ""","","","","","Book of Prayer"
"2605","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ , عَنِ ابْنِ عَبَّاسٍ , عَنْ أُمِّهِ أُمِّ الْفَضْلِ , قَالَتْ : \" إِنَّ آخِرَ مَا سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَرَأَ فِي الْمَغْرِبِ سُورَةَ الْمُرْسَلاتِ ""","","","","","Book of Prayer"
"2606","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ رَجُلٍ , سَمِعَ ابْنَ عُمَرَ : \" يَقْرَأُ فِي الْمَغْرِبِ ق وَالْقُرْآنِ الْمَجِيدِ ""","","","","","Book of Prayer"
"2607","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , قَالَ : أَخْبَرَنِي صَالِحُ بْنُ كَيْسَانَ , أَنَّهُ سَمِعَ ابْنَ عُمَرَ قَرَأَ فِي الْمَغْرِبَ إِنَّا فَتَحْنَا لَكَ فَتْحًا مُبِينًا ""","","","","","Book of Prayer"
"2608","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَمْرِو بْنِ مَيْمُونٍ , قَالَ : \" صَلَّى بِنَا عُمَرُ بْنُ الْخَطَّابِ صَلاةَ الْمَغْرِبِ , فَقَرَأَ فِي الرَّكْعَةِ الأُولَى بِـ التِّينِ وَالزَّيْتُونِ وَطُورِ سِينِينَ , وَفِي الرَّكْعَةِ الأَخِيرَةِ أَلَمْ تَرَ , وَ لِإِيلافِ جَمِيعًا ""","","","","","Book of Prayer"
"2609","عَنْ مَالِكٍ , عَنْ أَبِي عُبَيْدٍ , مَوْلَى سُلَيْمَانَ بْنِ عَبْدِ الْمَلِكِ , أَنَّ عُبَادَةَ بْنَ نُسَيٍّ أَخْبَرَهُ , أَنَّهُ سَمِعَ الْقَيْسَ بْنَ الْحَارِثِ , يَقُولُ : أَخْبَرَنِي أَبُو عَبْدِ اللَّهِ الصُّنَابِحِيُّ : \" أَنَّهُ صَلَّى وَرَاءَ أَبِي بَكْرٍ الصِّدِّيقِ الْمَغْرِبَ فَقَرَأَ فِي الرَّكْعَتَيْنِ الأُولَيَيْنِ بِأُمِّ الْقُرْآنِ وَسُورَتَيْنِ مِنْ قِصَارِ الْمُفَصَّلِ , ثُمَّ قَامَ فِي الرَّكْعَةِ الثَّالِثَةِ , قَالَ : فَدَنَوْتُ مِنْهُ حَتَّى إِنَّ ثِيَابِي لَتَكَادُ أَنْ تَمَسَّ ثِيَابَهُ , فَسَمِعْتُهُ قَرَأَ بِأُمِّ الْقُرْآنِ , وَبِهَذِهِ الآيَةِ :  رَبَّنَا لا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا  , حَتَّى الْوَهَّابُ \" , قَالَ أَبُو عُبَيْدٍ : وَأَخْبَرَنِي عُبَادَةُ أَنَّهُ كَانَ عِنْدَ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ فِي خِلافَتِهِ , فَقَالَ عُمَرُ لِقَيْسٍ : كَيْفَ أَخْبَرْتَنِي عَنْ أَبِي عَبْدِ اللَّهِ ؟ فَحَدَّثَهُ , فَقَالَ عُمَرُ : \" مَا تَرَكْنَاهَا مُنْذُ سَمِعْنَاهَا , وَإِنْ كُنْتُ قَبْلَ ذَلِكَ لَعَلَى غَيْرِ ذَلِكَ \" , فَقَالَ رَجُلٌ : وَعَلَى أَيِّ شَيْءٍ كَانَ أَمِيرُ الْمُؤْمِنِينَ قَبْلَ ذَلِكَ ؟ , قَالَ : \" كُنْتُ أَقْرَأُ قُلْ هُوَ اللَّهُ أَحَدٌ ""","","","","","Book of Prayer"
"2610","عَنْ إِسْمَاعِيلَ بْنِ عَبْدِ اللَّهِ أَبِي الْوَلِيدِ , عَنِ ابْنِ عَوْنٍ , عَنْ رَجَاءِ بْنِ حَيْوَةَ , عَنْ مَحْمُودِ بْنِ رَبِيعٍ , أَنَّ الصُّنَابِحِيَّ , قَالَ : \" صَلَّيْتُ خَلْفَ أَبِي بَكْرٍ الْمَغْرِبَ حَيْثُ يَمَسُ ثِيَابِي ثِيَابَهُ , فَلَمَّا كَانَ فِي الرَّكْعَةِ الآخِرَةِ قَرَأَ فَاتِحَةَ الْكِتَابِ , ثُمَّ قَرَأَ :  رَبَّنَا لا تُزِغْ قُلُوبَنَا بَعْدَ  , إِلَى الْوَهَّابُ \" , قَالَ أَبُو بَكْرٍ : وَأَخْبَرَنِي مُحَمَّدُ بْنُ رَاشِدٍ , قَالَ : سَمِعْتُ رَجُلا يُحَدِّثُ بِهِ مَكْحُولا , عَنْ سَهْلِ بْنِ سَعْدٍ السَّاعِدِيِّ أَنَّهُ سَمِعَ أَبَا بَكْرٍ قَرَأَهَا فِي الرَّكْعَةِ الثَّالِثَةِ , فَقَالَ لَهُ مَكْحُولٌ : \" إِنَّهُ لَمْ يَكُنْ مِنْ أَبِي بَكْرٍ قِرَاءَةٌ إِنَّمَا كَانَ دُعَاءٌ مِنْهُ ""","","","","","Book of Prayer"
"2611","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" مَنْ صَلَّى الْمَغْرِبَ فَقَرَأَ فِي نَفْسِهِ فَأَسْمَعَ نَفْسَهُ أَجْزَأَ عَنْهُ ""","","","","","Book of Prayer"
"2612","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَبْدِ الرَّحْمَنِ ابْنِ يَزِيدَ , قَالَ : \" صَلَّى بِنَا ابْنُ مَسْعُودٍ صَلاةَ الْعِشَاءِ الآخِرَةِ , فَاسْتَفْتَحَ بِسُورَةِ الأَنْفَالِ , حَتَّى إِذَا بَلَغَ :  نِعْمَ الْمَوْلَى وَنِعْمَ النَّصِيرُ رَكَعَ , ثُمَّ قَرَأَ فِي الرَّكْعَةِ الثَّانِيَةِ بِسُورَةٍ مِنَ الْمُفَصَّلِ \" , عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ , عَنِ ابْنِ مَسْعُودٍ مِثْلَهُ","","","","","Book of Prayer"
"2613","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ ابْنَ أَبِي مُلَيْكَةَ , يَقُولُ : أَخْبَرَنِي عَلْقَمَةُ بْنُ أَبِي وَقَّاصٍ , قَالَ : \" كَانَ عُمَرُ بْنُ الْخَطَّابِ يَقْرَأُ فِي الْعِشَاءِ الآخِرَةِ سُورَةَ يُوسُفَ , قَالَ : وَأَنَا فِي مُؤَخَّرِ الصَّفِّ حَتَّى إِذَا ذَكَرَ يُوسُفَ سَمِعْتُ نَشِيجَهُ , وَأَنَا فِي مُؤَخَّرِ الصُّفُوفِ ""","","","","","Book of Prayer"
"2614","عَنِ ابْنِ جُرَيْجٍ , قَالَ إِبْرَاهِيمُ بْنُ مَيْسَرَةَ عَنِ ابْنِ طَاوُسٍ : \" أَنَّ أَبَاهُ كَانَ لا يَدَعُ أَنْ يَقْرَأَ فِي الْعِشَاءِ الآخِرَةِ بِسُورَةِ السَّجْدَةِ الصُّغْرَى الم تَنْزِيلُ , وَ تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ ""","","","","","Book of Prayer"
"2615","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , عَنْ سَلَمَةَ بْنِ وَهْرَامٍ , قال : \" رَأَيْتُ طَاوُسًا مَا لا أُحْصِي يَقْرَأُ فِي الْعِشَاءِ الآخِرَةِ الم تَنْزِيلُ السَّجْدَةَ , وَتَبَارَكَ وَيَسْجُدُ فِيهَا , فَلَمْ يَسْجُدْ فِيهَا لَيْلَةً , فَظَنَنْتُ أَنَّهُ رَكَعَ حِينَ بَلَغَ السَّجْدَةَ , قَرَأَهَا فِي رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"2616","عَنْ عَبْدِ اللَّهِ بْنِ كَثِيرٍ , عَنْ شُعْبَةَ , قَالَ : أَخْبَرَنِي عَدِيُّ بْنُ ثَابِتٍ , أَنَّهُ سَمِعَ الْبَرَاءَ بْنَ عَازِبٍ , يَقُولُ : \" قَرَأَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي صَلاةِ الْعِشَاءِ فِي إِحْدَى الرَّكْعَتَيْنِ بِالتِّينِ وَالزَّيْتُونِ فِي السَّفَرِ ""","","","","","Book of Prayer"
"2617","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ عَبَّادِ بْنِ جَعْفَرٍ , يَقُولُ : أَخْبَرَنِي أَبُو سَلَمَةَ بْنُ سُفِيَانَ , وَعَبْدُ اللَّهِ بْنُ عُمَرَ , وَابْنُ عَبْدٍ الْقَارِيُّ , وَعَبْدُ اللَّهِ بْنُ الْمُسَيَّبِ , عَنْ عَبْدِ اللَّهِ بْنِ السَّائِبِ , قَالَ : \" صَلَّى بِنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الصُّبْحَ بِمَكَّةَ , فَاسْتَفْتَحَ سُورَةَ الْمُؤْمِنِينَ حَتَّى إِذَا جَاءَ ذِكْرُ مُوسَى , وَهَارُونَ ,  أَوْ ذِكْرُ عِيسَى ابْنُ عَبَّادٍ يَشُكُّ أَوِ اخْتَلَفُوا عَلَيْهِ أَخَذَتِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سَعْلَةٌ فَرَكَعَ \" , وَعَبْدُ اللَّهِ بْنُ السَّائِبِ حَاضِرٌ ذَلِكَ","","","","","Book of Prayer"
"2618","عَنِ الثَّوْرِيِّ , عَنْ عَطَاءِ بْنِ السَّائِبِ , عَنْ أَبِي عَبْدِ الرَّحْمَنِ السَّلْمِيِّ , قَالَ : \" أَمَّنَا عَلِيٌّ فِي الْفَجْرِ فَقَرَأَ بِالأَنْبِيَاءِ , فَتَرَكَ آيَةً , ثُمَّ قَرَأَ بَرْزَخًا , ثُمَّ عَادَ إِلَى الآيَةِ فَقَرَأَ بِهَا , ثُمَّ أَعَادَ إِحْدَاثَهُ , وَرَجَعَ إِلَى مَا كَانَ يَقْرَؤُهَا ""","","","","","Book of Prayer"
"2619","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ حَفْصَةَ بِنْتِ سِيرِينَ : \" أَنَّ عُمَرَ قَرَأَ فِي الْفَجْرِ بِسُورَةِ يُوسُفَ فَتَرَدَّدَ , فَعَادَ إِلَى أَوَّلِهَا ثُمَّ قَرَأَ فَمَضَى فِي قِرَاءَتِهِ ""","","","","","Book of Prayer"
"2620","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , عَنْ صَفِيَّةَ بِنْتِ أَبِي عُبَيْدٍ : \" أَنَّ عُمَرَ قَرَأَ فِي صَلاةِ الْفَجْرِ بِالْكَهْفِ , وَيُوسُفَ أَوْ يُوسُفَ , وَهُودٍ قَالَ : فَتَرَدَّدَ فِي يُوسُفَ , فَلَمَّا تَرَدَّدَ رَجَعَ إِلَى أَوَّلِ السُّورَةِ فَقَرَأَ , ثُمَّ مَضَى فِيهَا كُلِّهَا ""","","","","","Book of Prayer"
"2621","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ : \" صَلَّيْتُ خَلْفَ أَبِي بَكْرٍ الْفَجْرَ , فَاسْتَفْتَحَ الْبَقَرَةَ فَقَرَأَهَا فِي رَكْعَتَيْنِ , فَقَامَ عُمَرُ حِينَ فَرَغَ , قَالَ : يَغْفِرُ اللَّهُ لَكَ , لَقَدْ كَادَتِ الشَّمْسُ تَطْلُعُ قَبْلَ أَنْ تُسَلِّمَ , قَالَ : \" لَوْ طَلَعَتِ لأَلْفَتْنَا غَيْرَ غَافِلِينَ ""","","","","","Book of Prayer"
"2622","أَخْبَرَنَا مَعْمَرٌ , عَنْ قَتَادَةَ , عَنْ أَنَسٍ : \" صَلَّيْتُ خَلْفَ أَبِي بَكْرٍ فَاسْتَفْتَحَ بِسُورَةِ آلِ عِمْرَانَ , فَقَامَ إِلَيْهِ عُمَرُ , فَقَالَ : يَغْفِرُ اللَّهُ لَكَ , لَقَدْ كَادَتِ الشَّمْسُ تَطْلُعُ قَبْلَ أَنْ تُسَلِّمَ , قَالَ : لَوْ طَلَعَتْ لأَلْفَتْنَا غَيْرَ غَافِلِينَ ""","","","","","Book of Prayer"
"2623","عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ : \" أَنَّ أَبَا بَكْرٍ قَرَأَ بِالْبَقَرَةِ فِي رَكْعَتَيِ الْفَجْرِ ""","","","","","Book of Prayer"
"2624","عَنِ الثَّوْرِيِّ , عَنْ عَمْرِو بْنِ يَعْلَى , عَنْ سَعِيدِ بْنِ جُبَيْرٍ : \" أَنَّهُ أَمَّهُمْ فِي الْفَجْرِ , فَقَرَأَ بَنِي إِسْرَائِيلَ فِي رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"2625","عَنْ مَعْمَرٍ , عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ , عَنْ عَبْدِ اللَّهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ , قال : \" مَا حَفِظْتُ سُورَةَ يُوسُفَ , وَسُورَةَ الْحَجِّ إِلا مِنْ عُمَرَ مِنْ كَثْرَةِ مَا كَانَ يَقْرَؤُهُمَا فِي صَلاةِ الْفَجْرِ , فَقَالَ : كَانَ يَقْرَؤُهُمَا قِرَاءَةً بَطِيئَةً ""","","","","","Book of Prayer"
"2626","عَنِ ابْنِ عُيَيْنَةَ , عَنْ إِسْمَاعِيلَ بْنِ مُحَمَّدِ بْنِ سَعْدٍ , قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ شَدَّادٍ , قَالَ : \" سَمِعْتُ نَشِيجَ عُمَرَ , وَإِنِّي لَفِي الصَّفِّ خَلْفَهُ فِي صَلاةٍ وَهُوَ يَقْرَأُ سُورَةَ يُوسُفَ , حَتَّى انْتَهَى إِلَى  إِنَّمَا أَشْكُو بَثِّي وَحُزْنِي إِلَى اللَّهِ ""","","","","","Book of Prayer"
"2627","عَنْ مَعْمَرٍ , عَنْ عَاصِمِ بْنِ سُلَيْمَانَ , عَنْ أَبِي عُثْمَانَ النَّهْدِيِّ , قَالَ : صَلَّى بِنَا عُمَرُ صَلاةَ الْغَدَاةِ , فَمَا انْصَرَفَ حَتَّى عَرَفَ كُلُّ ذِي بَالٍ أَنَّ الشَّمْسَ قَدْ طَلَعَتْ , قَالَ : فَقِيلَ لَهُ : مَا فَرَغْتَ حَتَّى كَادَتِ الشَّمْسُ تَطْلُعُ , فَقَالَ : \" لَوْ طَلَعَتْ لأَلْفَتْنَا غَيْرَ غَافِلِينَ ""","","","","","Book of Prayer"
"2628","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي سُلَيْمَانُ بْنُ عَتِيق : \" أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَرَأَ فِي الصُّبْحِ سُورَةَ آلِ عِمْرَانَ ""","","","","","Book of Prayer"
"2629","عَنِ الثَّوْرِيِّ , عَنْ زِيَادِ بْنِ عِلاقَةَ , عَنْ عَمِّهِ قُطْبَةَ بْنِ مَالِكٍ , قَالَ : \" سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي الرَّكْعَةِ الأُولَى مِنْ صَلاةِ الْفَجْرِ  وَالنَّخْلَ بَاسِقَاتٍ لَهَا طَلْعٌ نَضِيدٌ ""","","","","","Book of Prayer"
"2630","عَنْ إِسْرَائِيلَ , عَنْ سِمَاكِ بْنِ حَرْبٍ , أَنَّهُ سَمِعَ جَابِرَ بْنَ سَمُرَةَ , يَقُولُ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي الصَّلاةَ كَنَحْوٍ مِنْ صَلاتِكُمُ الَّتِي تُصَلُّونَ الْيَوْمَ , وَلَكِنَّهُ كَانَ يُخَفِّفُ , كَانَتْ صَلاتُهُ أَخَفَّ مِنْ صَلاتِكُمْ , كَانَ يَقْرَأُ فِي الْفَجْرِ الْوَاقِعَةَ , وَنَحْوَهَا مِنَ السُّورَةِ ""","","","","","Book of Prayer"
"2631","عَنِ ابْنِ عُيَيْنَةَ , عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ , عَنِ الْوَلِيدِ بْنِ سَرِيعٍ , عَنْ عَمْرِو بْنِ حُرَيْثٍ , قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , يَقْرَأُ فِي الصُّبْحِ وَاللَّيْلِ إِذَا عَسْعَسَ ""","","","","","Book of Prayer"
"2632","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنِ ابْنِ الْمُنْكَدِرِ , قَالَ : حَدَّثَنَا رَبِيعَةُ بْنُ عَبْدِ اللَّهِ بْنِ الْهَدِيرِ , قَالَ : \" كَانَ عُمَرُ يَقْرَأُ بِالْحَدِيدِ وَأَشْبَاهِهَا ""","","","","","Book of Prayer"
"2633","عَنْ مَالِكٍ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ : \" أَنَّهُ كَانَ يَقْرَأُ فِي الْفَجْرِ بِعَشْرٍ مِنْ أَوَّلِ الْمُفَصَّلِ فِي كُلِّ رَكْعَةٍ بِسُورَةٍ ""","","","","","Book of Prayer"
"2634","عَنِ الثَّوْرِيِّ , وَابْنِ عُيَيْنَةَ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ التَّيْمِيِّ , عَنْ حُصَيْنِ بْنِ سَبْرَةَ : \" أَنَّ عُمَرَ قَرَأَ فِي الْفَجْرِ بِيُوسُفَ , ثُمَّ قَرَأَ فِي الثَّانِيَةِ بِالنَّجْمِ , فَسَجَدَ , فَقَامَ , فَقَرَأَ إِذَا زُلْزِلَتِ ""","","","","","Book of Prayer"
"2635","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ , عَنْ شَبِيبٍ أَبِي رَوْحٍ , عَنْ رَجُلٍ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ : صَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاةَ الْفَجْرِ فَقَرَأَ سُورَةَ الرُّومِ , فَالْتَبَسَ مِنْهَا , فَلَمَّا انْصَرَفَ , قَالَ : \" مَا بَالُ أَقْوَامٍ يُصَلُّونَ مَعَنَا بِغَيْرِ طُهْرٍ , مَنْ صَلَّى مَعَنَا فَلْيُحْسِنْ طُهُورَهُ , فَإِنَّمَا يُلَبِّسُ عَلَيْنَا الْقُرْآنَ أُولَئِكَ ""","","","","","Book of Prayer"
"2636","عَنِ الثَّوْرِيِّ , وَمَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : أَمَرَ عَدِيُّ بْنُ أَرْطَاةَ الْحَسَنَ أَنْ يُصَلِّيَ بِالنَّاسِ فَقَرَأَ فِي الْفَجْرِ يَأَيُّهَا النَّبِيُّ إِذَا طَلَّقْتُمُ النِّسَاءَ , وَ يَأَيُّهَا النَّبِيُّ لِمَ تُحَرِّمُ ""","","","","","Book of Prayer"
"2637","عَنِ الثَّوْرِيِّ , عَنِ الْعَلاءِ بْنِ الْمُسَيَّبِ : \" أَنَّ أَبَا وَائِلٍ قَرَأَ فِي إِحْدَى رَكْعَتَيِ الصُّبْحِ بِأُمِّ الْقُرْآنِ وَآيَةٍ ""","","","","","Book of Prayer"
"2638","عَنْ مُحَمَّدٍ , عَنْ مُسْلِمٍ الْبَطِينِ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ يَوْمَ الْجُمُعَةِ فِي الْفَجْرِ بِـ تَنْزِيلُ السَّجْدَةِ , وَهَلْ أَتَى عَلَى الإِنْسَانِ \" , عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ مِثْلَهُ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","","","","","Book of Prayer"
"2639","عَنْ مَعْمَرٍ , عَنْ عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ : أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَرَأَ فِي الْفَجْرِ يَوْمَ الْجُمُعَةِ بِسُورَةِ الرُّومِ","","","","","Book of Prayer"
"2640","عَنِ ابْنِ عُيَيْنَةَ , عَنْ أَبِي فَرْوَةَ الْهَمْدَانِيِّ , قَالَ : سَمِعْتُ أَبَا الأَحْوَصِ , يَقُولُ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي صَلاةِ الْفَجْرِ يَوْمَ الْجُمُعَةِ بِـ تَنْزِيلُ السَّجْدَةِ , وَهَلْ أَتَى عَلَى الإِنْسَانِ ""","","","","","Book of Prayer"
"2641","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ أَبِي بَرْزَةَ : أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَرَأَ فِي الصُّبْحِ بِـ إِنَّا فَتَحْنَا لَكَ فَتْحًا مُبِينًا","","","","","Book of Prayer"
"2642","عَنْ عَبْدِ اللَّهِ بْنِ كَثِيرٍ , عَنْ شُعْبَةَ , عَنِ الْحَجَّاجِ , عَنِ الْحَكَمِ , قَالَ : سَمِعْتُ عَمْرَو بْنَ مَيْمُونٍ , يَقُولُ : \" صَلَّيْتُ مَعَ عُمَرَ بِذِي الْحَلِيفَةِ وَهُوَ يُرِيدُ مَكَّةَ صَلاةَ الْفَجْرِ , فَقَرَأَ بِـ قُلْ يَا أَيُّهَا الْكَافِرُونَ , وَالْوَاحِدُ الصَّمَدُ \" فِي قِرَاءَةِ ابْنِ مَسْعُودٍ","","","","","Book of Prayer"
"2643","عَنْ مَعْمَرٍ , عَنِ الأَعْمَشِ , عَنِ الْمَعْرُورِ بْنِ سُوَيْدٍ , قَالَ : كُنْتُ مَعَ عُمَرَ بَيْنَ مَكَّةَ وَالْمَدِينَةِ , فَصَلَّى بِنَا الْفَجْرَ , فَقَرَأَ : أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ , وَلِإِيلافِ قُرَيْشٍ , ثُمَّ رَأَى أَقْوَامًا يَنْزِلُونَ فِيُصَلُّونَ فِي مَسْجِدٍ , فَسَأَلَ عَنْهُمْ فَقَالُوا : مَسْجِدٌ صَلَّى فِيهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : \" إِنَّمَا هَلَكَ مَنْ كَانَ قَبْلَكُمْ أَنَّهُمُ اتَّخَذُوا آثَارَ أَنْبِيَائِهِمْ بِيَعًا , مَنْ مَرَّ بِشَيْءٍ مِنَ الْمَسَاجِدِ فَحَضَرَتِ الصَّلاةُ فَلْيُصَلِّ وَإِلا فَلْيَمْضِ ""","","","","","Book of Prayer"
"2644","عَنِ الثَّوْرِيِّ , عَنْ مَالِكِ بْنِ مِغْوَلٍ , عَنِ الْحَكَمِ , عَنْ عَمْرِو بْنِ مَيْمُونٍ , قَالَ : \" صَحِبْتُ عُمَرَ بْنَ الْخَطَّابِ فِي سَفَرٍ فَقَرَأَ بِـ قُلْ يَأَيُّهَا الْكَافِرُونَ , وَقُلْ هُوَ اللَّهُ أَحَدٌ ""","","","","","Book of Prayer"
"2645","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ التَّيْمِيِّ , عَنْ عَمْرِو بْنِ مَيْمُونٍ , قَالَ : \" صَلَّيْتُ مَعَ عُمَرَ فِي الْعَامِ الَّذِي قُتِلَ فِيهِ بِمَكَّةَ صَلاةَ الصُّبْحِ , فَقَرَأَ لا أُقْسِمُ بِهَذَا الْبَلَدِ , وَ وَالتِّينِ وَالزَّيْتُونِ ""","","","","","Book of Prayer"
"2646","عَنْ مَعْمَرٍ , عَنْ عَبْدِ الرَّزَّاقِ , عَنْ أَبِيهِ : \" أَنَّهُ كَانَ يَقْرَأُ فِي صَلاةِ الصُّبْحِ فِي السَّفَرِ بِسَبِّحْ , وَ هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ وَنَحْوِهِمَا ""","","","","","Book of Prayer"
"2647","عَنِ الثَّوْرِيِّ , وَابْنِ عُيَيْنَةَ , عَنِ الصَّلْتِ بْنِ بَهْرَامَ : \" أَنَّ إِبْرَاهِيمَ النَّخَعِيَّ أَمَّهُمْ فِي السَّفَرِ , فَقَرَأَ فِي صَلاةِ الْغَدَاةِ إِذَا زُلْزِلَتِ سورة الزلزلة آية 1 , وَ إِنَّا أَنْزَلْنَاهُ فِي لَيْلَةِ الْقَدْرِ سورة القدر آية 1 ""","","","","","Book of Prayer"
"2648","أَخْبَرَنَا مَعْمَرٌ , عَنْ ثَابِتٍ الْبُنَانِيِّ , قَالَ : كُنْتُ مَعَ أَنَسِ بْنِ مَالِكٍ , وَأَقْبَلَ عَنْ أَرْضِهِ يُرِيدُ الْبَصْرَةَ , وَبَيْنَهَا وَبَيْنَ الْبَصْرَةِ ثَلاثَةُ أَمْيَالٍ أَوْ ثَلاثُ فَرَاسِخَ فَحَضَرَتْ صَلاةُ الْغَدَاةِ , فَقَامَ ابْنٌ لَهُ يُقَالُ لَهُ : أَبُو بَكْرٍ , فَصَلَّى بِنَا , فَقَرَأَ سُورَةَ تَبَارَكَ , فَلَمَّا سَلَّمَ , قَالَ لَهُ أَنَسٌ : طَوَّلْتَ عَلَيْنَا ""","","","","","Book of Prayer"
"2649","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَمْرِو بْنِ مَيْمُونٍ , قَالَ : \" صَلَّيْتُ يَوْمَ قُتِلَ عُمَرُ الصُّبْحَ , فَمَا مَنَعَنِي أَنْ أَقُومَ مَعَ الصَّفِّ الأَوَّلِ إِلا هَيْبَةُ عُمَرَ , قَالَ : فَمَاجَ النَّاسُ , فَقَدَّمُوا عَبْدَ الرَّحْمَنِ بْنِ عَوْفٍ , فَقَرَأَ إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحِ , وَإِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ ""","","","","","Book of Prayer"
"2650","أَخْبَرَنَا الْفَضْلُ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قال : \" كَانُوا يَقْرَءُونَ فِي صَلاةِ الْفَجْرِ فِي السَّفَرِ إِذَا السَّمَاءُ انْفَطَرَتْ , وَ هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ ""","","","","","Book of Prayer"
"2651","عَنِ ابْنِ عُيَيْنَةَ , عَنِ الصَّلْتِ بْنِ بَهْرَامَ : \" أَنَّ إِبْرَاهِيمَ النَّخَعِيَّ , أَمَّهُمْ فِي السَّفَرِ فِي صَلاةِ الصُّبْحِ فَقَرَأَ وَالضُّحَى , وَالتِّينِ ""","","","","","Book of Prayer"
"2652","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ : فِي كُلِّ صَلاةٍ قِرَاءَةٌ فَمَا أَسْمَعَنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَسْمَعْنَاكُمْ , وَمَا أَخْفَى عَنَّا أَخْفَيْنَا عَنْكُمْ , فَسَمِعْتُهُ يَقُولُ : \" لا صَلاةَ إِلا بِقِرَاءَةٍ ""","","","","","Book of Prayer"
"2653","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي الْعَلاءُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ يَعْقُوبَ , أَنَّ أَبَا السَّائِبِ , مَوْلَى بَنِي عَبْدِ اللَّهِ بْنِ هِشَامِ بْنِ زُهْرَةَ أَخْبَرَهُ أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَنْ صَلَّى صَلاةً لَمْ يَقْرَأْ فِيهَا بِأُمِّ الْقُرْآنِ فَهِيَ خِدَاجٌ , هِيَ خِدَاجٌ , هِيَ خِدَاجٌ غَيْرُ تَمَامٍ ""","","","","","Book of Prayer"
"2654","عَنْ مَالِكٍ , عَنْ وَهْبِ بْنِ كَيْسَانَ , قَالَ : سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ : \" مَنْ صَلَّى رَكْعَةً فَلَمْ يَقْرَأْ فِيهَا بِأُمِّ الْقُرْآنِ فَلَمْ يُصَلِّ , إِلا مَعَ الإِمَامِ ""","","","","","Book of Prayer"
"2655","عَنِ الثَّوْرِيِّ , عَنِ ابْنِ أَبِي لَيْلَى , عَنْ عَطَاءٍ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَؤُمُّنَا فَيَجْهَرُ وَيُخَافِتُ , فَنَجْهَرُ فِيمَا جَهَرَ , وَنُخَافِتُ فِيمَا خَافَتَ , فَسَمِعْتُهُ يَقُولُ : \" لا صَلاةَ إِلا بِقِرَاءَةٍ ""","","","","","Book of Prayer"
"2656","عَنِ الثَّوْرِيِّ , عَنْ أَبِي خَالِدٍ , عَنْ إِبْرَاهِيمَ , عَنْ عَبْدِ اللَّهِ بْنِ أَبِي أَوْفَى , قَالَ : جَاءَ رَجُلٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ : إِنِّي لا أَسْتَطِيعُ أَنْ أَتَعَلَّمَ الْقُرْآنَ فَمَا يُجْزِئُنِي ؟ , قَالَ : \" تَقُولُ : سُبْحَانَ اللَّهِ , وَالْحَمْدُ لِلَّهِ , وَلا حَوْلَ وَلا قُوَّةَ إِلا بِاللَّهِ , وَلا إِلَهَ إِلا اللَّهُ , وَاللَّهُ أَكْبَرُ \" , قَالَ : فَقَالَ الرَّجُلُ : هَكَذَا وَجَمَعَ أَصَابِعَهُ الْخَمْسَ , فَقَالَ : \" هَذَا لِلَّهِ , قَالَ : تَقُولُ : اللَّهُمَّ اغْفِرْ لِي , وَارْحَمْنِي , وَاهْدِنِي , وَارْزُقْنِي \" , قَالَ : فَقَبَضَ الرَّجُلُ كَفَّيْهِ جَمِيعًا , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَمَّا هَذَا فَقَدْ مَلأَ يَدَيْهِ مِنَ الْخَيْرِ \" , قَالَ سُفْيَانُ : وَكَانَ حِسَابُ الْعَرَبِ كَذَلِكَ","","","","","Book of Prayer"
"2657","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ إِبْرَاهِيمَ التَّيْمِيُّ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ صَلَّى صَلاةً فَلَمْ يَقْرَأْ فِيهَا , فَقِيلَ لَهُ ذَلِكَ , فَقال : \" أَتْمَمْتُ الرُّكُوعَ وَالسُّجُودَ ؟ \" قَالُوا : نَعَمْ , قَالَ : \" فَلَمْ يُعِدْ تِلْكَ الصَّلاةَ ""","","","","","Book of Prayer"
"2658","عَنْ إِسْرَائِيلَ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , أَنَّ رَجُلا جَاءَهُ , فَقَالَ : إِنِّي صَلَّيْتُ وَلَمْ أَقْرَأْ , فَقَالَ : \" أَتْمَمْتَ الرُّكُوعَ وَالسُّجُودَ ؟ \" قَالَ : نَعَمْ , قَالَ : \" تَمَّتْ صَلاتُكَ ؟ \" , قَالَ : نَعَمْ , قَالَ : \" مَا كُلُّ أَحَدٍ يُحْسِنُ الْقِرَاءَةَ ""","","","","","Book of Prayer"
"2659","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : \" لا بُدَّ لِلرَّجُلِ الْمُسْلِمِ مِنْ سِتِّ سُوَرٍ يَتَعلَّمُهُنَّ لِلصَّلاةِ , سُورَتَيْنِ لِصَلاةِ الصُّبْحِ , وَسُورَتَيْنِ لِلْمَغْرِبِ , وَسُورَتَيْنِ لِلصَّلاةِ فِي الْعِشَاءِ ""","","","","","Book of Prayer"
"2660","عَنْ عِكْرِمَةَ بْنِ عَمَّارٍ , قَالَ : حَدَّثَنِي ضَمْضَمُ بْنُ جَوْسٍ الْهِفَّانِيُّ , عَنْ عَبْدِ اللَّهِ بْنِ حَنْظَلَةَ , قَالَ : حَدَّثَنَا وَهُوَ جَالِسٌ مَعَ أَبِي هُرَيْرَةَ , قَالَ : \" صَلَّيْتُ خَلْفَ عُمَرَ بْنِ الْخَطَّابِ الْمَغْرِبَ , فَلَمْ يَقْرَأْ فِي الرَّكْعَةِ الأُولَى بِشَيْءٍ , ثُمَّ قَرَأَ فِي الثَّانِيَةِ بِأُمِّ الْقُرْآنِ مَرَّتَيْنِ وَسُورَتَيْنِ , ثُمَّ سَجَدَ سَجْدَتَيْنِ قَبْلَ التَّسْلِيمِ ""","","","","","Book of Prayer"
"2661","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عِكْرِمَةُ بنُ خَالِدٍ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ , صَلَّى الْعِشَاءَ الآخِرَةَ بِالْجَابِيَةِ , فَلَمْ يَقْرَأْ فِيهَا حَتَّى فَرَغَ , فَلَمَّا فَرَغَ دَخَلَ فَأَطَافَ بِهِ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ , وَتَنَحْنَحَ لَهُ حَتَّى سَمِعَ عُمَرُ بْنُ الْخَطَّابِ حِسَّهُ , وَعَلِمَ أَنَّهُ ذُو حَاجَةٍ , فَقَالَ : \" مَنْ هَذَا ؟ , قَالَ : عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ , قَالَ : أَلَكَ حَاجَةٌ ؟ , قَالَ : نَعَمْ , قَالَ : فَادْخُلْ , فَدَخَلَ , فَقَالَ : أَرَأَيْتَ مَا صَنَعْتَ آنِفًا عَهِدَهُ إِلَيْكَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَمْ رَأَيْتَهُ يَصْنَعُهُ ؟ , قَالَ : وَمَا هُوَ ؟ , قَالَ : لَمْ تَقْرَأْ فِي الْعِشَاءِ , قَالَ : أَوَ فَعَلْتُ ؟ , قَالَ : نَعَمْ , قَالَ : فَإِنِّي سَهَوْتُ , جَهَّزْتُ عِيرًا مِنَ الشَّامِ , حَتَّى قَدِمَتِ الْمَدِينَةَ , قَالَ : مَنِ الْمُؤَذِّنُ ؟ فَأَقَامَ الصَّلاةَ , ثُمَّ عَادَ فَصَلَّى الْعِشَاءَ لِلنَّاسِ , فَلَمَّا فَرَغَ خَطَبَ , قَالَ : لا صَلاةَ لِمَنْ لَمْ يَقْرَأْ فِيهَا , إِنَّ الَّذِي صَنَعْتُ آنِفًا إِنِّي سَهَوْتُ , إِنِّي جَهَّزْتُ عِيرًا مِنَ الشَّامِ حَتَّى قَدِمَتِ الْمَدِينَةَ فَقَسَّمْتُهَا , قُلْتُ : عَمَّنْ تُحَدِّثُ هَذَا ؟ , قَالَ : لا أَدْرِي غَيْرَ أَنِّي لَمْ آخُذْهُ إِلا مِنْ ثِقَةٍ","","","","","Book of Prayer"
"2662","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ , عَنْ جَابِرِ بْنِ الْجُعْفِيِّ , قَالَ : حَدَّثَنَا زِيَادُ بْنُ عِيَاضٍ الأَشْعَرِيُّ , قَالَ : صَلَّى بِنَا عُمَرُ بْنُ الْخَطَّابِ الْعِشَاءَ فَلَمْ أَسْمَعْ قِرَاءَتَهُ فِيهَا , فَقَالَ لَهُ أَبُو مُوسَى الأَشْعَرِيُّ : مَا لَكَ لَمْ تَقْرَأْ يَا أَمِيرَ الْمُؤْمِنِينَ ؟ , قَالَ \" أَكَذَلِكَ يَا عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ ؟ \" , قَالَ : نَعَمْ , قَالَ : \" فَأَمَرَ الْمُؤَذِّنَ فَأَقَامَ الصَّلاةَ , وَقَرَأَ قِرَاءَةً فَسَمِعْتُهَا وَأَنَا فِي مُؤَخَّرِ الصُّفُوفِ , فَلَمَّا انْصَرَفَ , قَالَ : \" إِنِّي كُنْتُ لأُصَلِّي وَأُحَدِّثُ نَفْسِي بِعِيرٍ بَعَثْتُهَا مِنَ الْمَدِينَةِ بِأَقْتَابِهَا وَأَحْلاسِهَا مَتَى يَأْتِي ؟ وَإِنَّهُ لا صَلاةَ إِلا بِقِرَاءَةٍ ""","","","","","Book of Prayer"
"2663","عَنِ الثَّوْرِيِّ , عَنْ جَابِرٍ , وَابْنِ عَوْنٍ , عَنِ الشَّعْبِيِّ : \" أَنَّ عُمَرَ صَلَّى الْمَغْرِبَ فَلَمْ يَقْرَأْ , فَأَمَرَ الْمُؤَذِّنَ فَأَعَادَ الأَذَانَ وَالإِقَامَةَ , ثُمَّ أَعَادَ الصَّلاةَ ""","","","","","Book of Prayer"
"2664","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : صَلَّى عُمَرُ بِالنَّاسِ صَلاةَ الْعِشَاءِ , فَلَمْ أَسْمَعْ قِرَاءَتَهُ فِيهَا , فَقَالَ لَهُ أَبُو مُوسَى الأَشْعَرِيُّ : مَا لَكَ لَمْ تَقْرَأْ يَا أَمِيرَ الْمُؤْمِنِينَ ؟ , قَالَ : \" أَكَذَلِكَ يَا عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ ؟ , قَالَ : نَعَمْ , قَالَ : أَوَ فَعَلْتُ ؟ , قَالُوا : نَعَمْ , قَالَ : صَدَقْتُمْ , قَالَ : إِنِّي جَهَّزْتُ عِيرًا مِنَ الْمَدِينَةِ حَتَّى وَرَدَتِ الشَّامَ , فَكُنْتُ أُرَحِّلُهَا مَرْحَلَةً مَرْحَلَةً , قَالَ : فَأَعَادَ لَهُمُ الصَّلاةَ , قَالَ : فَأَخْبَرَنِي أَبَانُ , عَنْ جَابِرِ بْنِ يَزِيدَ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَمَرَ الْمُؤَذِّنَ فَأَقَامَ ثُمَّ صَلَّى ""","","","","","Book of Prayer"
"2665","عَنْ إِسْرَائِيلَ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ : \" إِذَا نَسِيَ الرَّجُلُ أَنْ يَقْرَأَ فِي الرَّكْعَتَيْنِ الأُولَيَيْنِ مِنَ الظُّهْرِ وَالْعَصْرِ وَالْعِشَاءِ , فَلْيَقْرَأْ فِي الرَّكْعَتَيْنِ الأُخْرَيَيْنِ وَقَدْ أَجْزَأَ عَنْهُ ""","","","","","Book of Prayer"
"2666","عَنْ مَعْمَرٍ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قَالَ : سَأَلْتُ عَلْقَمَةَ , قَالَ : قُلْتُ : \" نَسِيتُ فِي الرَّكْعَتَيْنِ الأُولَيَيْنِ , ثُمَّ قَرَأْتُ فِي الرَّكْعَتَيْنِ الأُخْرَيَيْنِ , أَتُجْزِي عَنِّي لِصَلاتِي ؟ , قَالَ : نَعَمْ إِنْ شَاءَ اللَّهُ ""","","","","","Book of Prayer"
"2667","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قال : سَأَلْتُ عَلْقَمَةَ عَنْ رَجُلٍ نَسِيَ أَنْ يَقْرَأَ فِي الأُولَيَيْنِ فَقَرَأَ فِي الأُخْرَيَيْنِ ؟ , قَالَ : يُجْزِئُ عَنْهُ إِنْ شَاءَ اللَّهُ , قَالَ سُفْيَانُ : وَنَقُولُ نَحْنُ لِيَسْجُدْ سَجْدَتَيِ السَّهْوِ ""","","","","","Book of Prayer"
"2668","عَنِ الثَّوْرِيِّ , قَالَ : بَلَغَنِي عَنْ إِبْرَاهِيمَ , قال : \" إِذَا لَمْ يَقْرَأْ فِي ثَلاثٍ مِنَ الظُّهْرِ أَعَادَ ""","","","","","Book of Prayer"
"2669","عَنْ مَعْمَرٍ , عَنْ حَمَّادٍ , عَنْ عَبْدِ الْحَقِّ , عَنْ إِبْرَاهِيمَ , أَنَّهُ قَالَ : \" إِنْ نَسِيَ الرَّجُلُ الْقِرَاءَةَ فِي الظُّهْرِ وَالْعَصْرِ فَإِنَّهُ يُعِيدُ , وَإِنْ قَرَأَ فِي الرَّكْعَتَيْنِ وَلَمْ يَقْرَأْ فِي الرَّكْعَتَيْنِ لَمْ يُعِدْ , وَإِنْ قَرَأَ فِي رَكْعَةٍ وَلَمْ يَقْرَأْ فِي ثَلاثٍ مِنَ الظُّهْرِ أَعَادَ ""","","","","","Book of Prayer"
"2670","عَنْ مَعْمَرٍ , عَمَّنْ , سَمِعَ الْحَسَنَ , يَقُولُ : فِي رَجُلٍ نَسِيَ أَنْ يَقْرَأَ فِي رَكْعَةٍ وَلَمْ يَقْرَأْ فِي الأُخْرَى , قَالَ : \" يُعِيدُ الرَّكْعَةَ الَّتِي لَمْ يَقْرَأْ فِيهَا \" , قَالَ مَعْمَرٌ : \" يُعِيدُ أَعْجَبُ إِلَيَّ ""","","","","","Book of Prayer"
"2671","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : لَوْ نَسِيتُ الْقِرَاءَةَ فِي رَكْعَةٍ بِأُمِّ الْقُرْآنِ وَبِالسُّورَةِ الَّتِي بَعْدَهَا , لَمْ أَقْرَأْ فِي الرَّكْعَةِ بِشَيْءٍ ؟ , فَقال : \" فَلا تُعِدْ , وَلَكِنِ اسْجُدْ سَجْدَتَيِ السَّهْوِ ""","","","","","Book of Prayer"
"2672","عَنِ الثَّوْرِيِّ , قال : \" إِذَا لَمْ يَقْرَأْ فِي الرَّكْعَتَيْنِ مِنَ الْمَغْرِبِ أَعَادَ ""","","","","","Book of Prayer"
"2673","عَنِ الثَّوْرِيِّ , قال : \" إِذَا لَمْ يَقْرَأْ فِي رَكْعَةٍ حَتَّى يَرْكَعَ , فَإِنَّهُ يَرْفَعُ رَأْسَهُ إِذَا ذَكَرَ وَيَقْرَأُ , ثُمَّ يَسْجُدُ سَجْدَتَيِ السَّهْوِ , فَإِنْ سَجَدَ مَضَى ""","","","","","Book of Prayer"
"2674","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ أَبِي قِلابَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لأَصْحَابِهِ : \" أَتَقْرَءُونَ خَلْفِي وَأَنَا أَقْرَأُ ؟ , قَالَ : فَسَكَتُوا حَتَّى سَأَلَهُمْ ثَلاثًا \" , قَالُوا : نَعَمْ , يَا رَسُولَ اللَّهِ , قَالَ : \" فَلا تَفْعَلُوا ذَلِكَ , لِيَقْرَأْ أَحَدُكُمْ بِفَاتِحَةِ الْكِتَابِ فِي نَفْسِهِ سِرًّا ""","","","","","Book of Prayer"
"2675","عَنِ الثَّوْرِيِّ , عَنْ خَالِدٍ الْحَذَّاءِ , عَنْ أَبِي قِلابَةَ , عَنْ مُحَمَّدِ بْنِ أَبِي عَائِشَةَ , عَنْ رَجُلٍ , مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لَعَلَّكُمْ تَقْرَءُونَ وَالإِمَامُ يَقْرَأُ مَرَّتَيْنِ أَوْ ثَلاثًا \" , قَالُوا : نَعَمْ , يَا رَسُولَ اللَّهِ , إِنَّا لَنَفْعَلُ , قَالَ : \" فَلا تَفْعَلُوا إِلا أَنْ يَقْرَأَ أَحَدُكُمْ بِفَاتِحَةِ الْكِتَابِ ""","","","","","Book of Prayer"
"2676","عَنِ ابْنِ جُرَيْجٍ , عَنِ الْعَلاءِ بْنِ عَبْدِ الرَّحْمَنِ , أَنَّ أَبَا السَّائِبِ , مَوْلَى بَنِي عَبْدِ اللَّهِ بْنِ هِشَامِ بْنِ زُهْرَةَ أَخْبَرَهُ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَنْ صَلَّى صَلاةً لَمْ يَقْرَأْ فِيهَا بِأُمِّ الْقُرْآنِ فَهِيَ خِدَاجٌ , هِيَ خِدَاجٌ غَيْرُ تَمَامٍ ""","","","","","Book of Prayer"
"2677","قَالَ أَبُو السَّائِبِ : أَكُونُ أَحْيَانًا وَرَاءَ الإِمَامِ , فَقَالَ أَبُو السَّائِبِ : فَغَمَزَ أَبُو هُرَيْرَةَ ذِرَاعِي , فَقَالَ : يَا أَعْرَابِيُّ , اقْرَأْ بِهَا فِي نَفْسِكَ , فَإِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : \" قَالَ اللَّهُ : قَسَمْتُ الصَّلاةَ بَيْنِي وَبَيْنَ عَبْدِي نِصْفَيْنِ , فَنِصْفُهَا لِي وَنِصْفُهَا لِعَبْدِي , وَلِعَبْدِي مَا سَأَلَ , قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : اقْرَأْ , يَقُومُ الْعَبْدُ , فَيَقُولُ :  الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ , فَيَقُولُ اللَّهُ : حَمِدَنِي عَبْدِي , وَيَقُولُ الْعَبْدُ :  الرَّحْمَنِ الرَّحِيمِ , فَيَقُولُ اللَّهُ : أَثْنَى عَلَيَّ عَبْدِي , وَيَقُولُ الْعَبْدُ :  مَالِكِ يَوْمِ الدِّينِ , فَيَقُولُ اللَّهُ : مَجَّدَنِي عَبْدِي , وَقَالَ : هَذِهِ بَيْنِي وَبَيْنَ عَبْدِي , فَيَقُولُ الْعَبْدُ :  إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ , فَيَقُولُ اللَّهُ : أَجْرُهَا لِعَبْدِي وَلَهُ مَا سَأَلَ , يَقُولُ عَبْدِي :  اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ , إِلَى آخِرِ السُّورَةِ , يَقُولُ اللَّهُ : هَذَا لِعَبْدِي وَلَهُ مَا سَأَلَ ""","","","","","Book of Prayer"
"2678","عَنْ مَالِكٍ , عَنِ الْعَلاءِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ يَعْقُوبَ , أَنَّهُ سَمِعَ أَبَا السَّائِبِ , مَوْلَى بَنِي زُهْرَةَ يُحَدِّثُ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَنْ صَلَّى صَلاةً لَمْ يَقْرَأْ فِيهَا بِأُمِّ الْقُرْآنِ فَهِيَ خِدَاجٌ , هِيَ خِدَاجٌ غَيْرُ تَامٍّ ""","","","","","Book of Prayer"
"2679","قَالَ : فَقُلْتُ لَهُ : يَا أَبَا هُرَيْرَةَ إِنِّي أَكُونُ أَحْيَانًا وَرَاءَ الإِمَامِ , قَالَ : فَغَمَزَ ذِرَاعِي , ثُمَّ قَالَ : اقْرَأْ بِهَا يَا فَارِسِيُّ فِي نَفْسِكَ , فَإِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : \" قَالَ اللَّهُ عَزَّ وَجَلَّ : قَسَمْتُ الصَّلاةَ بَيْنِي وَبَيْنَ عَبْدِي نِصْفَيْنِ , فَنِصْفُهَا لِي وَنِصْفُهَا لِعَبْدِي , وَلِعَبْدِي مَا سَأَلَ , قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : اقْرَءُوا , يَقُومُ الْعَبْدُ فَيَقُولُ :  الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ , يَقُولُ اللَّهُ تَبَارَكَ وَتَعَالَى : حَمِدَنِي عَبْدِي , وَيَقُولُ الْعَبْدُ :  الرَّحْمَنِ الرَّحِيمِ , يَقُولُ اللَّهُ : أَثْنَى عَلَيَّ عَبْدِي , وَيَقُولُ الْعَبْدُ :  مَالِكِ يَوْمِ الدِّينِ , يَقُولُ اللَّهُ : مَجَّدَنِي عَبْدِي , قَالَ : وَهَذِهِ الآيَةُ بَيْنِي وَبَيْنَ عَبْدِي وَلِعَبْدِي مَا سَأَلَ , يَقُولُ الْعَبْدُ :  إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ إِلَى آخِرِ السُّورَةِ , فَهَؤُلاءِ لِعَبْدِي وَلِعَبْدِي مَا سَأَلَ ""","","","","","Book of Prayer"
"2680","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ , عَنْ مَكْحُولٍ : \" كَانَ يَقْرَأُ بِفَاتِحَةِ الْكِتَابِ فِيمَا يَجْهَرُ فِيهِ الإِمَامُ وَفِيمَا لا يَجْهَرُ ""","","","","","Book of Prayer"
"2681","عَنْ بِشْرِ بْنِ رَافِعٍ , قَالَ : أَخْبَرَنِي دَرْعُ بْنُ عَبْدِ اللَّهِ , عَنْ أَبِي أُمَيَّةَ الأَزْدِيِّ , قَالَ : قَالَ لِي عُبَادَةُ بْنُ الصَّامِتِ : \" اقْرَأْ بِأُمِّ الْقُرْآنِ فِي كُلِّ صَلاةٍ أَوْ قَالَ : فِي كُلِّ رَكْعَةٍ , قَالَ : قُلْتُ : أَتَقْرَأُ بِهَا يَا أَبَا الْوَلِيدِ مَعَ الإِمَامِ ؟ قَالَ : لا أَدَعُهَا إِمَامًا وَلا مَأْمُومًا ""","","","","","Book of Prayer"
"2682","عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ , عَنِ ابْنِ عَوْنٍ , قَالَ : حَدَّثَنَا رَجَاءُ بْنُ حَيْوَةَ , قَالَ : \" صَلَّيْتُ إِلَى جَنْبِ عُبَادَةَ بْنِ الصَّامِتِ , فَسَمِعْتُهُ يَقْرَأُ خَلْفَ الإِمَامِ , فَلَمَّا قَضَيْنَا صَلاتَنَا , قُلْنَا : يَا أَبَا الْوَلِيدِ , أَتَقْرَأُ مَعَ الإِمَامِ ؟ , قَالَ : وَيْحَكَ إِنَّهُ لا صَلاةَ إِلا بِهَا ""","","","","","Book of Prayer"
"2683","عَنْ يَحْيَى بْنِ الْعَلاءِ , عَنِ ابْنِ سِنَانٍ , عَنْ عَبْدِ اللَّهِ بْنِ أَبِي الْهُذَيْلِ : \" أَنَّ أُبَيَّ بْنَ كَعْبٍ , كَانَ يَقْرَأُ خَلْفَ الإِمَامِ فِي الظُّهْرِ وَالْعَصْرِ ""","","","","","Book of Prayer"
"2684","عَنِ التَّيْمِيِّ , عَنْ لَيْثٍ , عَنْ عَطَاءٍ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" لا بُدَّ أَنْ يَقْرَأَ بِفَاتِحَةِ الْكِتَابِ خَلْفَ الإِمَامِ جَهَرَ , أَوْ لَمْ يَجْهَرْ ""","","","","","Book of Prayer"
"2685","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ مُجَاهِدٍ , قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ عَمْرٍو قَرَأَ خَلْفَ الإِمَامِ فِي الظُّهْرِ وَالْعَصْرِ ""","","","","","Book of Prayer"
"2686","عَنِ ابْنِ عُيَيْنَةَ , عَنْ حُصَيْنٍ , عَنْ عَبْدِ الرَّحْمَنِ , قَالَ : سَمِعْتُ عُبَيْدَ اللَّهِ بْنَ عَبْدِ اللَّهِ بْنِ عُتْبَةَ يَقْرَأُ فِي الظُّهْرِ وَالْعَصْرِ مَعَ الإِمَامِ , فَسَأَلْتُ إِبْرَاهِيمَ , فَقَالَ : \" لا تَقْرَأْ إِلا أَنْ يَهِمَ الإِمَامُ \" وَسَأَلْتُ مُجَاهِدًا , فَقَالَ : \" قَدْ سَمِعْتُ عَبْدَ اللَّهِ بْنَ عَمْرٍو يَقْرَأُ ""","","","","","Book of Prayer"
"2687","عَنِ الثَّوْرِيِّ , عَنْ سُلَيْمَانَ الشَّيْبَانِيِّ , عَنْ جَوَّابٍ , عَنْ يَزِيدَ بْنِ شَرِيكٍ , أَنَّهُ قَالَ لِعُمَرَ : أَقْرَأُ خَلْفَ الإِمَامِ ؟ , قَالَ : \" نَعَمْ , قُلْتُ : وَإِنْ قَرَأْتَ يَا أَمِيرَ الْمُؤْمِنِينَ , قَالَ : نَعَمْ , وَإِنْ قَرَأْتُ ""","","","","","Book of Prayer"
"2688","عَنِ ابْنِ التَّيْمِيِّ , عَنْ لَيْثٍ , عَنْ أَشْعَثَ , عَنْ أَبِي يَزِيدَ , عَنِ الْحَارِثِ بْنِ سُوَيْدٍ , وَيَزِيدَ التَّيْمِيِّ , قَالا : \" أَمَرَنَا عُمَرُ بْنُ الْخَطَّابِ أَنْ نَقْرَأَ خَلْفَ الإِمَامِ ""","","","","","Book of Prayer"
"2689","عَنِ الثَّوْرِيِّ , عَنِ الصَّلْتِ الرَّبَعِيِّ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قال : \" إِذَا لَمْ يُسْمِعْكَ الإِمَامُ فَاقْرَأْ ""","","","","","Book of Prayer"
"2690","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِذَا لَمْ تَفْهَمْ قِرَاءَةَ الإِمَامِ , فَاقْرَأْ إِنْ شِئْتَ أَوْ سَبِّحْ ""","","","","","Book of Prayer"
"2691","عَنْ مَالِكٍ , عَنْ أَبِي النَّضْرِ , عَنْ مَالِكِ بْنِ أَبِي عَامِرٍ , أَنَّ عُثْمَانَ , قَالَ : \" لِلْمُنْصِتِ الَّذِي لا يَسْمَعُ مِنَ الْحَظِّ مِثْلُ مَا لِلْمُسْتَمِعِ الْمُنْصِتِ \" . وَذَكَرَهُ ابْنُ جُرَيْجٍ , عَنْ مُصْعَبٍ , عَنْ مُحَمَّدِ بْنِ عُثْمَانَ , إِلا أَنَّهُ قَالَ : \" مِنَ الأَجْرِ ""","","","","","Book of Prayer"
"2692","عَنْ عَبْدِ الرَّحْمَنِ بْنِ زَيْدِ بْنِ أَسْلَمَ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ : \" لِلْمُنْصِتِ الَّذِي لا يَسْمَعُ كَأَجْرِ الْمُنْصِتِ الَّذِي يَسْمَعُ ""","","","","","Book of Prayer"
"2693","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قال : \" يَقْرَأُ الإِمَامُ بِفَاتِحَةِ الْكِتَابِ , وَسُورَةٍ أُخْرَى فِي الظُّهْرِ وَالْعَصْرِ فِي الرَّكْعَتَيْنِ الأُولَيَيْنِ ""","","","","","Book of Prayer"
"2694","عَنِ الثَّوْرِيِّ , عَنِ الزُّهْرِيِّ , قال : \" إِذَا جَهَرَ الإِمَامُ فَلا تَقْرَأْ شَيْئًا \" , عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ مِثْلَهُ","","","","","Book of Prayer"
"2695","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" أَمَّا أَنَا فَأَقْرَأُ مَعَ الإِمَامِ فِي الظُّهْرِ وَالْعَصْرِ بِأُمِّ الْقُرْآنِ وَسُورَةٍ قَصِيرَةٍ , ثُمَّ أُهَلِّلُ وَأُسَبِّحُ \" , قُلْتُ : أُسْمِعُ مَنْ إِلَى جَنْبِي قِرَاءَتِي ؟ , قَالَ : \" مَعَ الإِمَامِ ؟ \" , قَالَ : قُلْتُ : نَعَمْ , قَالَ : \" لا ""","","","","","Book of Prayer"
"2696","عَنِ ابْنِ الْمُثَنَّى بْنِ الصَّبَّاحِ , عَنْ عَمْرِو بْنِ شُعَيْبٍ , عَنْ أَبِيهِ , عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَطَبَ النَّاسَ فَقَالَ : \" مَنْ صَلَّى مَكْتُوبَةً أَوْ سُبْحَةً , فَلْيَقْرَأْ بِأُمِّ الْقُرْآنِ وَقُرْآنٍ مَعَهَا , فَإِنِ انْتَهَى إِلَى أُمِّ الْقُرْآنِ أَجْزَأَتْ عَنْهُ , وَمَنْ كَانَ مَعَ الإِمَامِ فَلْيَقْرَأْ قَبْلَهُ أَوْ إِذَا سَكَتَ , فَمَنْ صَلَّى صَلاةً لَمْ يَقْرَأْ فِيهَا فَهِيَ خِدَاجٌ ثَلاثًا ""","","","","","Book of Prayer"
"2697","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِذَا كَانَ الإِمَامُ يَجْهَرُ فَلْيُبَادِرْ بِأُمِّ الْقُرْآنِ , أَوْ لِيَقْرَأْ بَعْدَمَا يَسْكُتُ , فَإِذَا قَرَأَ فَلْيُنْصِتُوا كَمَا قَالَ اللَّهُ عَزَّ وَجَلَّ ""","","","","","Book of Prayer"
"2698","عَنْ مَعْمَرٍ , وَابْنِ جُرَيْجٍ , قَالا : أَخْبَرَنَا ابْنُ خُثَيْمٍ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , أَنَّهُ قَالَ : \" لا بُدَّ أَنْ تَقْرَأَ بِأُمِّ الْقُرْآنِ مَعَ الإِمَامِ , وَلَكِنْ مَنْ مَضَى كَانُوا إِذَا كَبَّرَ الإِمَامُ سَكَتَ سَاعَةً لا يَقْرَأُ قَدْرَ مَا يَقْرَءُونَ أُمَّ الْقُرْآنِ ""","","","","","Book of Prayer"
"2699","عَنْ مَعْمَرٍ , عَمَّنْ سَمِعَ الْحَسَنَ , يَقُولُ : \" اقْرَأْ بِأُمِّ الْقُرْآنِ جَهَرَ الإِمَامُ أَوْ لَمْ يَجْهَرْ , فَإِذَا جَهَرَ فَفَرَغَ مِنْ أُمِّ الْقُرْآنِ , فَاقْرَأْ بِهَا أَنْتَ ""","","","","","Book of Prayer"
"2700","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ شَرِيكِ بْنِ أَبِي نَمِرٍ , عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ , قال : \" إِذَا قَالَ الإِمَامُ :  غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ قَرَأْتُ بِأُمِّ الْقُرْآنِ أَوْ بَعْدَمَا يَفْرُغُ مِنَ السُّورَةِ الَّتِي بَعْدَهَا ""","","","","","Book of Prayer"
"2701","عَنْ مَعْمَرٍ , عَنْ غَيْرِ وَاحِدٍ , عَنِ الْحَسَنِ , قَالَ : \" كَانَ سَمُرَةُ بْنُ جُنْدَبٍ يَؤُمُّ النَّاسَ , فَكَانَ يَسْكُتُ سَكْتَتَيْنِ إِذَا كَبَّرَ لِلصَّلاةِ , وَإِذَا فَرَغَ مِنْ قِرَاءَةِ أُمِّ الْقُرْآنِ \" , فَعَابَ عَلَيْهِ النَّاسُ , فَكَتَبَ إِلَى أُبَيِّ بْنِ كَعْبٍ فِي ذَلِكَ أَنَّ النَّاسَ عَابُوا عَلَيَّ , فَنَسِيتُ وَحَفِظُوا , أَوْ حَفِظْتُ وَنَسَوْا , فَكَتَبَ إِلَيْهِ أُبَيٌّ بَلْ حَفِظْتَ وَنَسَوْا , فَكَانَ الْحَسَنُ , يَقُولُ : \" إِذَا فَرَغَ الإِمَامُ مِنْ قِرَاءَةِ أُمِّ الْقُرْآنِ فَاقْرَأْ بِهَا أَنْتَ ""","","","","","Book of Prayer"
"2702","عَنِ الْمُثَنَّى , عَنْ عَمْرِو بْنِ شُعَيْبٍ , عَنْ أَبِيهِ , عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ : \" إِذَا قَالَ الإِمَامُ :  غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ قَرَأْتُ بِأُمِّ الْقُرْآنِ أَوْ بَعْدَمَا يَفْرُغُ ""","","","","","Book of Prayer"
"2703","عَنْ مَعْمَرٍ , أَوْ غَيْرِهِ , عَنِ ابْنِ خُثَيْمٍ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قال : \" لا بُدَّ مِنْ أُمِّ الْقُرْآنِ , وَلَكِنْ مَنْ مَضَى كَانُوا إِذَا كَبَّرَ الإِمَامُ سَكَتَ سَاعَةً لا يَقْرَأُ قَدْرَ مَا يَقْرَءُونَ بِأُمِّ الْقُرْآنِ ""","","","","","Book of Prayer"
"2704","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : سَمِعْتُ ابْنَ أُكَيْمَةَ يُحَدِّثُ , عَنْ أَبِي هُرَيْرَةَ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى صَلاةً جَهَرَ فِيهَا بِالْقِرَاءَةِ , ثُمَّ أَقْبَلَ عَلَى النَّاسِ بَعْدَمَا سَلَّمَ , فَقَالَ لَهُمْ : \" هَلْ قَرَأَ مِنْكُمْ مَعِي أَحَدٌ آنِفًا ؟ \" , قَالُوا : نَعَمْ , يَا رَسُولَ اللَّهِ , قَالَ : \" إِنِّي أَقُولُ : مَالِي أُنَازَعُ الْقُرْآنَ \" , فَانْتَهَى النَّاسُ عَنِ الْقِرَاءَةِ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيمَا يَجْهَرُ بِهِ مِنَ الْقِرَاءَةِ حِينَ سَمِعُوا ذَلِكَ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ . عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ , قَالَ : سَمِعْتُ ابْنَ أُكَيْمَةَ يُحَدِّثُ , عَنْ أَبِي هُرَيْرَةَ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ إِلَى قَوْلِهِ : \" مَالِي أُنَازَعُ الْقُرْآنَ ""","","","","","Book of Prayer"
"2705","عَنِ الثَّوْرِيِّ , عَنْ مُوسَى بْنِ أَبِي عَائِشَةَ , عَنْ عَبْدِ اللَّهِ بْنِ شَدَّادِ بْنِ الْهَادِ اللَّيْثِيِّ , قَالَ : صَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الظُّهْرَ أَوِ الْعَصْرَ , فَجَعَلَ رَجُلٌ يَقْرَأُ خَلْفَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَرَجُلٌ يَنْهَاهُ , فَلَمَّا صَلَّى قَالَ : يَا رَسُولَ اللَّهِ , كُنْتُ أَقْرَأُ وَكَانَ هَذَا يَنْهَانِي , فَقَالَ لَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَنْ كَانَ لَهُ إِمَامٌ , فَإِنَّ قِرَاءَةَ الإِمَامِ لَهُ قِرَاءَةٌ ""","","","","","Book of Prayer"
"2706","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ رَجُلٍ , عَنْ عِمْرَانَ بْنِ الْحُصَيْنِ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى بِأَصْحَابِهِ الظُّهْرَ قَالَ : فَلَمَّا فَرَغَ , قَالَ : \" هَلْ قَرَأَ أَحَدٌ مِنْكُمْ سَبِّحِ اسْمَ رَبِّكَ الأَعْلَى ؟ \" , قَالَ رَجُلٌ : أَنَا قَرَأْتُهَا , قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" قَدْ قُلْتُ : مَالِي أُنَازَعُهَا ""","","","","","Book of Prayer"
"2707","أَخْبَرَنَا مَعْمَرٌ , عَنْ قَتَادَةَ , عَنْ زُرَارَةَ بْنِ أَبِي أَوْفَى , عَنْ عِمْرَانَ بْنِ الْحُصَيْنِ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى بِأَصْحَابِهِ الظُّهْرَ , فَلَمَّا قَضَى صَلاتَهُ , قَالَ : \" أَيُّكُمْ قَرَأَ بِـ سَبِّحِ اسْمَ رَبِّكَ الأَعْلَى ؟ \" , فَقَالَ بَعْضُ الْقَوْمِ : أَنَا يَا رَسُولَ اللَّهِ , قَالَ : \" قَدْ عَرَفْتُ أَنَّ بَعْضَكُمْ خَالَجَنِيهَا ""","","","","","Book of Prayer"
"2708","عَنِ الثَّوْرِيِّ , عَنْ مُوسَى بْنِ أَبِي عَائِشَةَ , عَنِ الْوَلِيدِ بْنِ أَبِي بَشِيرٍ , قَالَ : قَرَأَ رَجُلٌ بِـ سَبِّحِ اسْمَ رَبِّكَ الأَعْلَى خَلْفَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَذَكَرَ ذَلِكَ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ : \" قَدْ ذَكَرَ أَنَّ بَعْضَكُمْ خَالَجَنِيهَا ""","","","","","Book of Prayer"
"2709","عَنِ الْحَسَنِ بْنِ عُمَارَةَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَصْبَهَانِيِّ , عَنْ عَبْدِ اللَّهِ بْنِ أَبِي لَيْلَى , قَالَ : سَمِعْتُ عَلِيًّا , يَقُولُ : \" مَنْ قَرَأَ خَلْفَ الإِمَامِ فَقَدْ أَخْطَأَ الْفِطْرَةَ ""","","","","","Book of Prayer"
"2710","عَنْ دَاوُدَ بْنِ قَيْسٍ , قَالَ : أَخْبَرَنِي عُمَرُ بْنُ مُحَمَّدِ بْنِ زَيْدِ بْنِ عُمَرَ بْنِ الْخَطَّابِ , قَالَ : حَدَّثَنِي مُوسَى بْنُ سَعِيدٍ , عَنْ زَيْدِ بْنِ ثَابِتٍ , قَالَ : \" مَنْ قَرَأَ مَعَ الإِمَامِ فَلا صَلاةَ لَهُ ""","","","","","Book of Prayer"
"2711","عَنْ مَنْصُورٍ , عَنْ أَبِي وَائِلٍ , قَالَ : جَاءَ رَجُلٌ إِلَى عَبْدِ اللَّهِ , فَقَالَ : يَا أَبَا عَبْدِ الرَّحْمَنِ , أَقْرَأُ خَلْفَ الإِمَامِ ؟ , قَالَ : \" أَنْصِتْ لِلْقُرْآنِ , فَإِنَّ فِي الصَّلاةِ شُغْلا , وَسَيَكْفِيكَ ذَلِكَ الإِمَامُ ""","","","","","Book of Prayer"
"2712","عَنِ ابْنِ عُيَيْنَةَ , عَنْ أَبِي إِسْحَاقَ الشَّيْبَانِيِّ , عَنْ رَجُلٍ , قَالَ : عَهِدَ عُمَرُ بْنُ الْخَطَّابِ , أَنْ لا تَقْرَءُوا مَعَ الإِمَامِ","","","","","Book of Prayer"
"2713","قَالَ ابْنُ عُيَيْنَةَ : فَأَخْبَرَنَا أَصْحَابُنَا , عَنْ زُبَيْدٍ , عَنْ عَبْدِ اللَّهِ بْنِ أَبِي لَيْلَى , عَنْ عَلِيٍّ , قَالَ : \" لَيْسَ مِنَ الْفِطْرَةِ الْقِرَاءَةُ مَعَ الإِمَامِ ""","","","","","Book of Prayer"
"2714","عَنِ الثَّوْرِيِّ , عَنِ ابْنِ أَبِي لَيْلَى , عَنْ رَجُلٍ , عَنْ عَبْدِ اللَّهِ بْنِ أَبِي لَيْلَى , أَخِي عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى : \" أَنَّ عَلِيًّا كَانَ يَنْهَى عَنِ الْقِرَاءَةِ خَلْفَ الإِمَامِ ""","","","","","Book of Prayer"
"2715","عَنْ دَاوُدَ بْنِ قَيْسٍ , عَنْ مُحَمَّدِ بْنِ عَجْلانَ , قَالَ : قَالَ عَلِيٌّ : \" مَنْ قَرَأَ مَعَ الإِمَامِ فَلَيْسَ عَلَى الْفِطْرَةِ \" , قَالَ وَلاءٌ : وَقَالَ ابْنُ مَسْعُودٍ : مُلِئَ فُوهُ تُرَابًا","","","","","Book of Prayer"
"2716","قَالَ : وَقَالَ عُمَرُ بْنُ الْخَطَّابِ : \" وَدِدْتُ أَنَّ الَّذِي يَقْرَأُ خَلْفَ الإِمَامِ فِي فِيهِ حَجَرٌ ""","","","","","Book of Prayer"
"2717","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , عَنِ الأَسْوَدِ , قال : وَدِدْتُ أَنَّ الَّذِي يَقْرَأُ خَلْفَ الإِمَامِ مُلِئَ فُوهُ تُرَابًا ""","","","","","Book of Prayer"
"2718","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , أَنَّ عَلْقَمَةَ بْنَ قَيْسٍ , قال : \" وَدِدْتُ أَنَّ الَّذِي يَقْرَأُ خَلْفَ الإِمَامِ مُلِئَ فُوهُ قَالَ : أَحْسَبُهُ , قَالَ : تُرَابًا أَوْ رَضْفًا ""","","","","","Book of Prayer"
"2719","عَنْ مَعْمَرٍ , قَالَ : وَأَخْبَرَنِي رَجُلٌ , عَنِ الأَسْوَدِ , أَنَّهُ قَالَ : \" وَدِدْتُ أَنَّ الَّذِي يَقْرَأُ خَلْفَ الإِمَامِ إِذَا جَهَرَ عَضَّ عَلَى جَمْرٍ ""","","","","","Book of Prayer"
"2720","عَنْ عَبْدِ الرَّحْمَنِ بْنِ زَيْدِ بْنِ أَسْلَمَ , عَنْ أَبِيهِ , قَالَ : \" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الْقِرَاءَةِ خَلْفَ الإِمَامِ \" , قَالَ : أَخْبَرَنِي أَشْيَاخُنَا أَنَّ عَلِيًّا , قَالَ : \" مَنْ قَرَأَ خَلْفَ الإِمَامِ فَلا صَلاةَ لَهُ ""","","","","","Book of Prayer"
"2721","قَالَ : وَأَخْبَرَنِي مُوسَى بْنُ عُقْبَةَ : \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَأَبَا بَكْرٍ , وَعُمَرَ , وَعُثْمَانَ , كَانُوا يَنْهَوْنَ عَنِ الْقِرَاءَةِ خَلْفَ الإِمَامِ ""","","","","","Book of Prayer"
"2722","عَنْ مَعْمَرٍ , وَابْنِ جُرَيْجٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمِ بْنِ عَبْدِ اللَّهِ , قال : \" يَكْفِيكَ قِرَاءَةُ الإِمَامِ فِيمَا يَجْهَرُ فِي الصَّلاةِ ""","","","","","Book of Prayer"
"2723","قَالَ ابْنُ جُرَيْجٍ : وَحَدَّثَنِي ابْنُ شِهَابٍ , عَنْ سَالِمٍ , أَنَّ ابْنَ عُمَرَ كَانَ , يَقُولُ : \" يُنْصَتُ لِلإِمَامِ فِيمَا يَجْهَرُ بِهِ فِي الصَّلاةِ وَلا يَقْرَأُ مَعَهُ ""","","","","","Book of Prayer"
"2724","عَنْ هِشَامِ بْنِ حَسَّانَ , عَنْ أَنَسِ بْنِ سِيرِينَ , قَالَ : سَأَلْتُ ابْنَ عُمَرَ أَقْرَأُ مَعَ الإِمَامِ ؟ , فَقَالَ : \" إِنَّكَ لَضَخْمُ الْبَطْنِ , قِرَاءَةُ الإِمَامِ ""","","","","","Book of Prayer"
"2725","عَنْ إِسْرَائِيلَ , عَنْ أَبِي إِسْحَاقَ , قال : \" كَانَ أَصْحَابُ عَبْدِ اللَّهِ لا يَقْرَءُونَ خَلْفَ الإِمَامِ ""","","","","","Book of Prayer"
"2726","أَخْبَرَنَا دَاوُدُ بْنُ قَيْسٍ , عَنْ زَيْدِ بْنِ أَسْلَمَ , عَنِ ابْنِ عُمَرَ : \" كَانَ يَنْهَى عَنِ الْقِرَاءَةِ خَلْفَ الإِمَامِ ""","","","","","Book of Prayer"
"2727","عَنِ الثَّوْرِيِّ , عَنِ ابْنِ ذَكْوَانَ , عَنْ زَيْدِ بْنِ ثَابِتٍ , وَابْنِ عُمَرَ : \" كَانَا لا يَقْرَآنِ خَلْفَ الإِمَامِ ""","","","","","Book of Prayer"
"2728","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" يُجْزِي قِرَاءَةُ الإِمَامِ عَمَّنْ وَرَاءَهُ \" , قُلْتُ : عَمَّنْ تَأْثِرُهُ ؟ , قَالَ : \" سَمِعْتُهُ , وَلَكِنَّ الْفَضَائِلَ أَحَبُّ إِلَيَّ أَنْ تَأْخُذُوا بِهَا , أَحَبُّ إِلَيَّ أَنْ تَقْرَءُوا مَعَهُ ""","","","","","Book of Prayer"
"2729","عَنْ يَحْيَى بْنِ الْعَلاءِ , قَالَ : أَخْبَرَنَا الأَعْمَشُ , عَنْ إِبْرَاهِيمَ , قَالَ : مَا كَانُوا يَقْرَءُونَ خَلْفَ الإِمَامِ حَتَّى كَانَ ابْنُ زِيَادٍ , فَقِيلَ لَهُمْ : \" إِذَا لَمْ يَجْهَرْ لَمْ يَقْرَأْ فِي نَفْسِهِ , فَقَرَأَ النَّاسُ ""","","","","","Book of Prayer"
"2730","عَنِ ابْنِ جُرَيْجٍ , قال : قُلْتُ لِعَطَاءٍ : أَيُجْزِي عَمَّنْ وَرَاءَ الإِمَامِ قِرَاءَتُهُ فِيمَا يَرْفَعُ بِهِ الصَّوْتَ وَفِيمَا يُخَافِتُ ؟ , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"2731","عَنْ دَاوُدَ بْنِ قَيْسٍ , عَنْ عُبَيْدِ اللَّهِ بْنِ مِقْسَمٍ , قَالَ : سَأَلْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ أَتَقْرَأُ خَلْفَ الإِمَامِ فِي الظُّهْرِ وَالْعَصْرِ شَيْئًا ؟ , فَقَالَ : لا ""","","","","","Book of Prayer"
"2732","عَنِ ابْنِ جُرَيْجٍ , عَنْ غَيْرِ وَاحِدٍ , عَنِ الْحَسَنِ , قال : \" كَانَ مُرَّةُ يَؤُمُّ النَّاسَ , يَسْكُتُ سَكْتَتَيْنِ إِذَا كَبَّرَ لِلصَّلاةِ , وَإِذَا فَرَغَ مِنْ قِرَاءَةِ الْقُرْآنِ , عَابَ ذَلِكَ عَلَيْهِ النَّاسُ \" , كَتَبَ إِلَى أَبِي بْنِ كَعْبٍ فِي ذَلِكَ أَنَّ النَّاسَ عَابُوا عَلَيَّ , فَلَعَلِّي نَسِيتُ وَحَفِظُوا , أَوْ حَفِظْتُ وَنَسَوْا , فَكَتَبَ إِلَيْهِ أَبِي : بَلْ حَفِظْتَ وَنَسَوْا , فَكَانَ الْحَسَنُ , يَقُولُ : \" إِذَا فَرَغَ الإِمَامُ مِنْ قِرَاءَةِ الْقُرْآنِ فَاقْرَأْهَا أَنْتَ ""","","","","","Book of Prayer"
"2733","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , أَنَّ عَلِيًّا , قَالَ : \" لا يَفْتَحُ عَلَى الإِمَامِ قَوْمٌ وَهُوَ يَقْرَأُ , فَإِنَّهُ كَلامٌ ""","","","","","Book of Prayer"
"2734","عَنْ إِسْرَائِيلَ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" لا تَفْتَحَنَّ عَلَى إِمَامٍ وَأَنْتَ فِي الصَّلاةِ ""","","","","","Book of Prayer"
"2735","عَنْ إِسْرَائِيلَ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , عَنْ عَلْقَمَةَ , عَنِ ابْنِ مَسْعُودٍ , قَالَ : \" إِذَا تَعَايَا الإِمَامُ فَلا تَرْدُدْ عَلَيْهِ , فَإِنَّهُ كَلامٌ ""","","","","","Book of Prayer"
"2736","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , قال : \" كَانُوا يَكْرَهُونَ , أَنْ يَفْتَحُوا عَلَى الإِمَامِ ""","","","","","Book of Prayer"
"2737","قَالَ : وَقَالَ الْمُغِيرَةُ , عَنْ إِبْرَاهِيمَ : \" إِذَا تَرَدَّدْتَ فِي الآيَةِ فَجَاوِزْهَا إِلَى غَيْرِهَا ""","","","","","Book of Prayer"
"2738","عَنْ إِسْرَائِيلَ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَبِيدَةَ بْنِ رَبِيعَةَ , قَالَ : \" أَتَيْتُ الْمَسْجِدَ فَإِذَا رَجُلٌ يُصَلِّي خَلْفَ الْمَقَامِ طَيِّبُ الرِّيحِ , حَسَنُ الثِّيَابِ , وَهُوَ يَقْتَرِئُ , وَرَجُلٌ إِلَى جَنْبِهِ يَفْتَحُ عَلَيْهِ \" , فَقُلْتُ : مَنْ هَذَا ؟ \" , فَقَالُوا : عُثْمَانُ","","","","","Book of Prayer"
"2739","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ , قَالَ : \" كُنْتُ أُلَقِّنُ ابْنَ عُمَرَ فِي الصَّلاةِ , فَلا يَقُولُ : شَيْئًا ""","","","","","Book of Prayer"
"2740","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ : \" أَنَّ ابْنَ عُمَرَ , صَلَّى الْمَغْرِبَ فَلَمَّا قَرَأَ :  غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ جَعَلَ يَقْرَأُ : بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ مِرَارًا وَرَدَّدَهَا , فَقُلْتُ : إِذَا زُلْزِلَتِ فَقَرَأَهَا , فَلَمَّا فَرَغَ لَمْ يَعِبْ ذَلِكَ عَلَيَّ ""","","","","","Book of Prayer"
"2741","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قال : \" كَانَ مَرْوَانُ بْنُ الْحَكَمِ يُرَدُّ عَلَيْهِ فِي ذَلِكَ الزَّمَانِ , وَقَدْ وَكَّلَ بِذَلِكَ رِجَالا إِذَا أَخْطَأَ لَقَّنُوهُ , وَأَصْحَابُ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمَئِذٍ بِالْمَدِينَةِ \" , قَالَ مَعْمَرٌ : وَسَمِعْتُ قَتَادَةَ , يَقُولُ : \" لا تُلَقِّنْهُ حَتَّى يَسْكُتَ , فَإِذَا سَكَتَ فَلَقِّنْهُ ""","","","","","Book of Prayer"
"2742","عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي مَنْ , سَمِعَ الْحَسَنَ , يَقُولُ : \" لَقِّنْ أَخَاكَ ""","","","","","Book of Prayer"
"2743","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلْتُ عَطَاءً : هَلْ بِتَلْقِينَةِ الإِمَامِ بَأْسٌ ؟ , قَالَ : \" لا , وَهَلْ هُوَ إِلا قُرْآنٌ ""","","","","","Book of Prayer"
"2744","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ الأَعْلَى , عَنْ أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ , قال : \" إِذَا اسْتَطْعَمَكُمْ فَأَطْعِمُوهُ \" , يَقُولُ : \" إِذَا تَعَايَا فَرُدُّوا عَلَيْهِ ""","","","","","Book of Prayer"
"2745","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللَّهِ بْنِ حُنَيْنٍ , عَنْ أَبِيهِ , عَنْ عَلِيٍّ , قَالَ : \" نَهَانِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الْقِرَاءَةِ فِي الرُّكُوعِ وَالسُّجُودِ , وَعَنِ التَّخَتُّمِ بِالذَّهَبِ , وَعَنْ لِبَاسِ الْقَسِّيِّ , وَعَنْ لِبَاسِ الْمُعَصْفَرِ \" , قُلْتُ لَهُ : أَيُّ شَيْءٍ الْقَسِّيُّ ؟ , قَالَ : \" الْحَرِيرُ ""","","","","","Book of Prayer"
"2746","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , عَنِ ابْنِ حُنَيْنٍ , عَنْ عَلِيٍّ , قَالَ : \" نَهَانِي النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ أَقْرَأَ , وَأَنَا رَاكِعٌ ""","","","","","Book of Prayer"
"2747","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ أَبِي جَعْفَرٍ , قَالَ : قَالَ عَلِيُّ بْنُ أَبِي طَالِبٍ : \" نَهَانِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَلا أَقُولُ : نَهَاكُمْ عَنِ الْقِرَاءَةِ , وَأَنَا رَاكِعٌ ""","","","","","Book of Prayer"
"2748","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ : \" لا تَقْرَأْ وَأَنْتَ رَاكِعٌ , وَلا أَنْتَ سَاجِدٌ ""","","","","","Book of Prayer"
"2749","عَنِ الْحَسَنِ بْنِ عُمَارَةَ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" يَا عَلِيُّ , إِنِّي أُحِبُّ لَكَ مَا أُحِبُّ لِنَفْسِي , وَأَكْرَهُ لَكَ مَا أَكْرَهُ لِنَفْسِي , لا تَلْبَسِ الْقَسِّيَّ , وَلا الْمُعَصْفَرَ , وَلا تَرْكَبْ عَلَى الْمَيَاثِرِ الْحُمْرِ , فَإِنَّهَا مَرَاكِبُ الشَّيْطَانِ , وَلا تَقْرَأْ وَأَنْتَ سَاجِدٌ , وَلا تَعْقِصْ شَعْرَكَ وَأَنْتَ تُصَلِّي , فَإِنَّهُ كِفْلُ الشَّيْطَانِ , وَلا تَقْرَأْ وَأَنْتَ رَاكِعٌ , وَلا تَقْرَأْ وَأَنْتَ سَاجِدٌ , وَلا تَفْتَحْ عَلَى إِمَامِ قَوْمٍ , وَلا تَعْبَثْ بِالْحَصَى فِي الصَّلاةِ ""","","","","","Book of Prayer"
"2750","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ الْخُرَاسَانِيُّ : \" أَنَّ ابْنَ عَبَّاسٍ كَانَ يَكْرَهُ الْقِرَاءَةَ إِذَا كَانَ الرَّجُلُ رَاكِعًا أَوْ سَاجِدًا ""","","","","","Book of Prayer"
"2751","عَنِ الثَّوْرِيِّ , عَنْ عُثْمَانَ بْنِ الأَسْوَدِ , عَنْ مُجَاهِدٍ , قال : \" لا تَقْرَأْ فِي الرُّكُوعِ وَلا فِي السُّجُودِ , إِنَّمَا جُعِلَ الرُّكُوعُ وَالسُّجُودُ لِلتَّسْبِيحِ ""","","","","","Book of Prayer"
"2752","عَنِ ابْنِ عُيَيْنَةَ , عَنْ سُلَيْمَانَ بْنِ سُحَيْمٍ , عَنْ عَبْدِ اللَّهِ بْنِ مَعْبَدٍ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : رَفَعَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ السِّتَارَةَ فَرَأَى النَّاسَ صُفُوفًا خَلْفَ أَبِي بَكْرٍ , فَقَالَ : \" إِنَّهُ لَمْ يَبْقَ مِنْ مُبَشِّرَاتِ النَّبِوَّةِ إِلا الرُّؤْيَا الصَّالِحَةُ يَرَاهَا الْمُسْلِمُ أَوْ تُرَى لَهُ , وَإِنِّي نُهِيتُ أَنْ أَقْرَأَ فِي الرُّكُوعِ وَالسُّجُودِ , فَأَمَا الرُّكُوعُ فِيُعَظَّمُ فِيهِ الرَّبُّ , وَأَمَّا السُّجُودُ فَاجْتَهِدُوا فِيهِ فِي الدُّعَاءِ , فَقَمِنٌ أَنْ يُسْتَجَابَ لَكُمْ , يَقُولُ : فَحَرِيٌّ ""","","","","","Book of Prayer"
"2753","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ لَوْ رَفَعْتُ رَأْسِي فِي السُّجُودِ فِي الْمَكْتُوبَةِ , فَنَهَضْتُ أَقْرَأُ قَبْلَ أَنْ أَسْتَوِيَ قَائِمًا ؟ , قَالَ \" مَا أُحِبُّ أَنْ أَقْرَأَ حَتَّى تَنْتَصِبَ قَائِمًا ""","","","","","Book of Prayer"
"2754","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ : أَنَّهُ سَمِعَ عُبَيْدَ بْنَ عُمَيْرٍ , وَهُوَ يَقْرَأُ رَاكِعًا وَسَاجِدًا فِي التَّطَوُّعِ , قَالَ عَطَاءٌ : \" وَلا أَكْرَهُ أَنْ تَقْرَأَ رَاكِعًا وَسَاجِدًا فِي التَّطَوُّعِ , فَأَمَّا الْمَكْتُوبَةُ فَإِنِّي أَكْرَهُهُ , وَلَكَنْ أُسَبِّحُ وَأُهَلِّلُ ""","","","","","Book of Prayer"
"2755","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي عَبْدُ الْكَرِيمِ , عَنْ سَعِيدٍ , وَكَانَ أَبُوهُ غُلامًا لِحُذَيْفَةَ بْنِ الْيَمَانِ , فَأَخْبَرَهُ , عَنْ حُذَيْفَةَ بْنِ الْيَمَانِ : أَنَّهُ مَرَّ بِالنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَيْلَةً وَهُوَ يُصَلِّي فِي الْمَسْجِدِ فِي الْمَدِينَةِ , قَالَ : فَقُمْتُ أُصَلِّي وَرَاءَهُ يُخَيَّلُ إِلَيَّ أَنَّهُ لا يَعْلَمُ , فَاسْتَفْتَحَ سُورَةَ الْبَقَرَةِ , فَقُلْتُ : إِذَا جَاءَ مِائَةَ آيَةٍ رَكَعَ , فَجَاءَهَا فَلَمْ يَرْكَعْ , فَقُلْتُ : إِذَا جَاءَ مِائَتَيْ آيَةٍ رَكَعَ , فَجَاءَهَا فَلَمْ يَرْكَعْ , فَإِذَا خَتَمَهَا رَكَعَ , فَخَتَمَ فَلَمْ يَرْكَعْ , فَلَمَّا خَتَمَ , قَالَ : \" اللَّهُمَّ لَكَ الْحَمْدُ , اللَّهُمَّ لَكَ الْحَمْدُ \" وِتْرًا , ثُمَّ افْتَتَحَ آلَ عِمْرَانَ , فَقُلْتُ : إِنْ خَتَمَهَا رَكَعَ , فَخَتَمَهَا وَلَمْ يَرْكَعْ , وَقَالَ : \" اللَّهُمَّ لَكَ الْحَمْدُ ثَلاثَ مَرَّاتٍ \" , ثُمَّ افْتَتَحَ سُورَةَ الْمَائِدَةِ , فَقُلْتُ : إِذَا خَتَمَ رَكَعَ , فَخَتَمَهَا فَرَكَعَ , فَسَمِعْتُهُ يَقُولُ : \" سُبْحَانَ رَبِّيَ الْعَظِيمِ \" وَيُرَجِّعُ شَفَتَيْهِ , فَأَعْلَمُ أَنَّهُ يَقُولُ : غَيْرَ ذَلِكَ , ثُمَّ سَجَدَ , فَسَمِعْتُهُ يَقُولُ : \" سُبْحَانَ رَبِّيَ الأَعْلَى \" , وَيُرَجِّعُ شَفَتَيْهِ , فَأَعْلَمُ أَنَّهُ يَقُولُ : غَيْرَ ذَلِكَ , فَلا أَفْهَمُ غَيْرَهُ , ثُمَّ افْتَتَحَ سُورَةَ الأَنْعَامِ , فَتَرَكْتُهُ وَذَهَبْتُ","","","","","Book of Prayer"
"2756","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ , عَنْ رَجُلٍ , قَالَ : أَخْبَرَنِي بَعْضُ أَهْلِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \" أَنَّهُ بَاتَ مَعَهُ , فَقَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنَ اللَّيْلِ فَقَضَى حَاجَتَهُ , ثُمَّ جَاءَ الْقِرْبَةَ فَاسْتَكَبَ مَاءً , فَغَسَلَ كَفَّيْهِ ثَلاثًا , ثُمَّ تَمَضْمَضَ وَتَوَضَّأَ , فَقَرَأَ بِالسَّبْعِ الطِّوَالِ فِي رَكْعَةٍ وَاحِدَةٍ ""","","","","","Book of Prayer"
"2757","عَنِ ابْنِ عُيَيْنَةَ , عَنْ يَزِيدَ بْنِ خُصَيْفَةَ , عَنِ السَّائِبِ بْنِ يَزِيدَ : \" أَنَّ عُثْمَانَ , قَرَأَ بِالسَّبْعِ الطِّوَالِ فِي رَكْعَةٍ ""","","","","","Book of Prayer"
"2758","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ : \" أَنَّ ابْنَ عُمَرَ كَانَ يَقْرَأُ فِي رَكْعَةٍ الثَّلاثَ سُوَرٍ فِي بَعْضِ ذَلِكَ ""","","","","","Book of Prayer"
"2759","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ : \" أَنَّ ابْنَ عُمَرَ كَانَ يَقْرَأُ بِالسُّورَتَيْنِ وَالثَّلاثِ فِي رَكْعَةٍ ""","","","","","Book of Prayer"
"2760","عَنْ دَاوُدَ بْنِ قَيْسٍ , قَالَ : سَمِعْتُ رَجَاءَ بْنَ حَيْوَةَ , يَسْأَلُ نَافِعًا هَلْ كَانَ ابْنُ عُمَرَ يَجْمَعُ بَيْنَ سُورَتَيْنِ فِي رَكْعَةٍ ؟ , قَالَ : نَعَمْ , وَسُوَرٍ ""","","","","","Book of Prayer"
"2761","عَنِ ابنِ أَبِي رَوَّادٍ , عَنْ نَافِعٍ : \" أَنَّ ابْنَ عُمَرَ كَانَ يَقْرَأُ بِالسُّوَرِ فِي رَكْعَةٍ ""","","","","","Book of Prayer"
"2762","عَنِ الثَّوْرِيِّ , وأبي حنيفة , عَنْ حَمَّادٍ , عَنْ سَعِيدِ ابْنِ جُبَيْرٍ , قال : \" سَمِعْتُهُ يَقْرَأُ الْقُرْآنَ فِي جَوْفِ الْكَعْبَةِ فِي رَكْعَةٍ , وَقَرَأَ فِي الرَّكْعَةِ الأُخْرَى قُلْ هُوَ اللَّهُ أَحَدٌ ""","","","","","Book of Prayer"
"2763","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , عَنِ ابْنِ طَاوُسٍ , قال : \" كَانَ أَبِي يَجْمَعُ بَيْنَ سَبِّحِ اسْمَ رَبِّكَ الأَعْلَى , وَاللَّيْلِ إِذَا يَغْشَى فِي رَكْعَةٍ , وَبَيْنَ وَالضُّحَى , وَ أَلَمْ نَشْرَحْ فِي رَكْعَةٍ فِي الْمَكْتُوبَةِ ""","","","","","Book of Prayer"
"2764","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ : \" أَنَّهُ كَانَ لا يَرَى بِجَمْعِ السُّوَرِ فِي الرَّكْعَةِ بَأْسًا \" , قَالَ ابْنُ جُرَيْجٍ : \" وَكَانَ طَاوُسٌ يَجْمَعُ ثَلاثَ سُوَرٍ فِي رَكْعَةٍ ""","","","","","Book of Prayer"
"2765","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , عَنْ يَزِيدَ بْنِ زَادَوَيْهِ : \" أَنَّ طَاوُسًا كَانَ يَقْرَأُ بِـ قُلْ هُوَ اللَّهُ أَحَدٌ مَعَ أُمِّ الْقُرْآنِ فِي كُلِّ رَكْعَةٍ ""","","","","","Book of Prayer"
"2766","عَنِ الثَّوْرِيِّ , عَنْ عَاصِمٍ , عَنْ مُحَمَّدِ بْنِ سِيرِينَ , عَنِ ابْنِ عُمَرَ : \" أَنَّهُ كَانَ يَقْرَأُ بِعَشْرِ سُوَرٍ فِي رَكْعَةٍ ""","","","","","Book of Prayer"
"2767","عَنْ هُشَيْمٍ , عَنْ يَعْلَى بْنِ عَطَاءٍ , عَنِ ابْنِ نَافِعِ بْنِ لَبِيبَةَ , قَالَ : قُلْتُ لابْنِ عُمَرَ ,  أَوْ قَالَ غَيْرِي : إِنِّي قَرَأْتُ الْمُفَصَّلَ فِي رَكْعَةٍ قَالَ : \" أَفَعَلْتُمُوهَا ؟ , إِنَّ اللَّهَ لَوْ شَاءَ أَنْزَلَهُ جُمْلَةً وَاحِدَةً , فَأَعْطُوا كُلَّ سُورَةٍ حَظَّهَا مِنَ الرُّكُوعِ وَالسُّجُودِ ""","","","","","Book of Prayer"
"2768","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ عُمَارَةَ بْنِ عُمَيْرٍ , عَنْ أَبِي مَعْمَرٍ , عَنْ أَبِي مَسْعُودٍ الأَنْصَارِيِّ , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لا تُجْزِئُ صَلاةٌ لا يُقِيمُ الرَّجُلُ صُلْبَهُ فِي الرُّكُوعِ وَالسُّجُودِ ""","","","","","Book of Prayer"
"2769","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ أُنَاسًا يَصُفُّونَ أَيْدِيَهُمْ أَسْفَلَ مِنْ رُكَبِهِمْ إِذَا رَكَعُوا ؟ , فَقَالَ : \" هَذِهِ مُحْدَثَةٌ , لا , إِلا فَوْقَ الرُّكْبَتَيْنِ ""","","","","","Book of Prayer"
"2770","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قَالَ إِنْسَانٌ لِعَطَاءٍ : إِنِّي أَرَى أُنَاسًا إِذَا رَكَعُوا خَفَضُوا رُءُوسَهُمْ حَتَّى كَانُوا يَجْعَلُونَ أَذْقَانَّهُمْ بَيْنَ أَرْجُلِهِمْ , فَقَالَ : \" لا , هَذِهِ بِدْعَةٌ لَمْ يَكُنْ مَنْ مَضَى يَصْنَعُونَ ذَلِكَ , قَالَ : فَكَيْفَ ؟ , قَالَ : وَسَطٌ مِنَ الرُّكُوعِ كَرُكُوعِ النَّاسِ الآنَ ""","","","","","Book of Prayer"
"2771","عَنِ ابْنِ مُجَاهِدٍ , عَنْ أَبِيهِ , عَنِ ابْنِ عُمَرَ , أَن رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ لِرَجُلٍ : \" إِذَا قُمْتَ إِلَى الصَّلاةِ فَرَكَعْتَ فَضَعْ يَدَيْكَ عَلَى رُكْبَتَيْكَ , وَافْرِجْ بَيْنَ أَصَابِعِكَ , ثُمَّ ارْفَعْ رَأْسَكَ حَتَّى يَرْجِعَ كُلُّ عُضْوٍ إِلَى مِفْصَلِهِ , وَإِذَا سَجَدْتَ فَأَمْكِنْ جَبَينَكَ مِنَ الأَرْضِ وَلا تَنْقُرْ ""","","","","","Book of Prayer"
"2772","عَنِ الثَّوْرِيِّ , عَنْ لَيْثٍ , عَنِ الْقَاسِمِ بْنِ أَبِي بَزَّةَ , عَنْ رَجُلٍ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ لِرَجُلٍ : \" إِذَا رَكَعْتَ فَضَعْ يَدَيْكَ عَلَى رُكْبَتَيْكَ , وَفَرِّجْ بَيْنَ أَصَابِعِكَ ""","","","","","Book of Prayer"
"2773","عَنِ الثَّوْرِيِّ , عَنِ ابْنِ أَبِي نَجِيحٍ , قَالَ : قُلْتُ : أَكَانَ مُجَاهِدٌ , يَقُولُ : \" إِذَا وَضعَ يَدَيْهِ فَقَدْ أَتَمَّ ؟ فَأَشَارَ بِرَأْسِهِ , أَنْ نَعَمْ ""","","","","","Book of Prayer"
"2774","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ صَالَحٍ , مَوْلَى التَّوْأَمَةِ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : \" لا صَلاةَ إِلا بِرُكُوعٍ ""","","","","","Book of Prayer"
"2775","عَنِ ابْنِ عُيَيْنَةَ , عَنْ أَبِي حَصِينٍ , قَالَ : رَأَيْتُ شَيْخًا كَبِيرًا عَلَيْهِ بُرْنُسٌ , قَالَ ابْنُ عُيَيْنَةَ : يَعْنِي الأَسْوَدَ بْنَ يَزِيدَ إِذَا رَكَعَ ضَمَّ يَدَيْهِ بَيْنَ رُكْبَتَيْهِ , قَالَ : فَأَتَيْنَا أَبَا عَبْدِ الرَّحْمَنِ السُّلَمِيَّ فَأَخْبَرْنَاهُ , فَقَالَ : \" نَعَمْ , أُولَئِكَ أَصْحَابُ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ , وَلَكَنَّ عُمَرَ قَدْ سَنَّ لَكُمُ الرُّكَبَ فَخُذُوا بِالرُّكَبِ ""","","","","","Book of Prayer"
"2776","عَنِ ابْنِ عُيَيْنَةَ , عَنْ أَبِي يَعْفُورٍ , عَنْ مُصْعَبِ بْنِ سَعْدٍ , قَالَ : صَلَّيْتُ إِلَى جَنْبِ أَبِي فَطَبَّقْتُ , فَقَالَ : \" فَنَهَانِي أَبِي وَقَالَ : قَدْ كُنَّا نَفْعَلُهُ فَنُهِينَا عَنْهُ ""","","","","","Book of Prayer"
"2777","عَنِ ابْنِ التَّيْمِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ , قَالَ : \" كَانَ عَبْدُ اللَّهِ يُطَبِّقُ , إِذَا رَكَعَ جَعَلَ يَدَيْهِ بَيْنَ رُكْبَتَيْهِ , وَيَفْرِشُ ذِرَاعَيْهِ وَفَخِذَيْهِ \" , فَقُلْتُ لإِبْرَاهِيمَ : فَمَا مَنَعَكَ مِنْ ذَلِكَ ؟ , قَالَ : \" وَكَانَ يَضَعُ يَدَيْهِ عَلَى رُكْبَتَيْهِ ""","","","","","Book of Prayer"
"2778","عَنْ إِسْرَائِيلَ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَلْقَمَةَ , وَالأَسْوَدِ , قَالا : صَلَّيْنَا مَعَ عَبْدِ اللَّهِ فَلَمَّا رَكَعَ طَبَّقَ كَفَّيْهِ , وَوَضَعَهُمَا بَيْنَ رُكْبَتَيْهِ , وَضَرَبَ أَيْدِيَنَا , فَفَعَلْنَا ذَلِكَ , ثُمَّ لَقِيَنَا عُمَرُ بَعْدُ , فَصَلَّى بِنَا فِي بَيْتِهِ , فَلَمَّا رَكَعَ طَبَّقْنَا كَفَّيْنَا كَمَا طَبَّقَ عَبْدُ اللَّهِ , وَوَضَعَ عُمَرُ يَدَيْهِ عَلَى رُكْبَتَيْهِ , فَلَمَّا انْصَرَفَ , قَالَ : \" مَا هَذَا ؟ \" , فَأَخْبَرْنَاهُ بِفِعْلِ عَبْدِ اللَّهِ , قَالَ : \" ذَاكَ شَيْءٌ كَانَ يُفْعَلُ ثُمَّ تُرِكَ ""","","","","","Book of Prayer"
"2779","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ : \" أَثْبِتْ يَدَيْكَ عَلَى رُكْبَتَيْكَ , وَأَثْبِتْ صُلْبَكَ , وَهُوَ يُجْزِي عَلَى تَمَامِ الرُّكُوعِ ""","","","","","Book of Prayer"
"2780","عَنْ مَعْمَرٍ , وَالزُّهْرِيِّ , قال : \" قِرَّ فِي الرُّكُوعِ حَتَّى يَقَرَّ كُلُّ شَيْءٍ مِنْكَ قَرَارَهُ ""","","","","","Book of Prayer"
"2781","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عُثْمَانُ بْنُ أَبِي سُلَيْمَانَ , عَنِ ابْنِ مَسْعَدَةَ , صَاحِبِ الْجُيُوشِ , قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , يَقُولُ : \" إِنِّي قَدْ بَدَّنْتُ , فَمَنْ فَاتَهُ الرُّكُوعُ أَدْرَكَنِي فِي بُطْءِ قِيَامِي ""","","","","","Book of Prayer"
"2782","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ إِنْسَانٌ لِعَطَاءٍ : كَانَ يُقَالَ لا يُصَوِّبِ الإِنْسَانُ رَأْسَهُ فِي الرُّكُوعِ , وَلا يُقْنِعْهُ ؟ , فَقال : \" لا , وَلِمَ يُصَوِّبُهُ ؟ \" , فَقَالَ لَهُ إِنْسَانٌ : مَا الإِقْنَاعُ ؟ , قَالَ : \" رَفْعُهُ رَأْسَهُ فِي الرُّكُوعِ ""","","","","","Book of Prayer"
"2783","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ , قال : \" كَانَ يُكْرَهُ أَنْ يُقْنِعَ , أَوْ يُصَوِّبَ فِي الرُّكُوعِ ""","","","","","Book of Prayer"
"2784","عَنِ الثَّوْرِيِّ , عَنْ أَبِي فَرْوَةَ الْجُهَنِيِّ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى , قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رُكُوعُهُ وَسُجُودُهُ وَقِيَامُهُ بَعْدَ الرَّكْعَةِ مُتَقَارِبًا , قَالَ : وَكَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَوْ وُضِعَ عَلَى ظَهْرِهِ قَدَحٌ مِنْ مَاءٍ مَا اسْتَرَاقَ مِنَ اسْتِوَائِهِ حِينَ يَرْكَعُ ""","","","","","Book of Prayer"
"2785","عَنْ عُثْمَانَ بْنِ مَطَرٍ , عَنْ حُسَيْنٍ الْمُعَلِّمُ , عَنْ بُدَيْلٍ الْعُقَيْلِيِّ , عَنْ أَبِي الْجَوْزَاءِ , عَنْ عَائِشَةَ , قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا رَكَعَ لَمْ يُصَوِّبْ بِرَأْسِهِ وَلَمْ يُشْخِصْهُ , وَكَانَ إِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ لَمْ يَسْجُدْ حَتَّى يَسْتَوِيَ قَائِمًا ""","","","","","Book of Prayer"
"2786","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي عَبْدُ الْكَرِيمِ , عَنْ سَعِيدٍ , وَكَانَ أَبُوهُ غُلامًا لِحُذَيْفَةَ أَنَّهُ : سَمِعَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ وَهُوَ رَاكِعٌ : سُبْحَانَ رَبِّيَ الْعَظِيمِ , وَيُرَجِّعُ شَفَتَاهُ , فَأَعْلَمُ أَنَّهُ يَقُولُ غَيْرَ ذَلِكَ","","","","","Book of Prayer"
"2787","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ صِلَةَ بْنِ زُفَرَ , عَنْ حُذَيْفَةَ , قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا رَكَعَ , قَالَ : سُبْحَانَ رَبِّيَ الْعَظِيمِ , وَإِذَا سَجَدَ , قَالَ : سُبْحَانَ رَبِّيَ الأَعْلَى ""","","","","","Book of Prayer"
"2788","عَنِ الثَّوْرِيِّ , وَقَتَادَةَ , أَنَّ عَلِيًّا , قَالَ : كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا رَكَعَ , يَقُولُ : اللَّهُمَّ , رَكَعْتُ وَبِكَ آمَنْتُ , أَنْتَ رَبِّي وَعَلَيْكَ تَوَكَّلْتُ , وَفِي السُّجُودِ : سُبْحَانَ رَبِّيَ الأَعْلَى","","","","","Book of Prayer"
"2789","عَنِ الثَّوْرِيِّ , عَنْ مَعْمَرٍ , عَنْ عَاصِمٍ , عَنْ أَبِي النَّجُودِ , عَنْ زِرِّ بْنِ حُبَيْشٍ , قَالَ : قَالَ عَلِيٌّ : \" إِنَّ مِنْ أَحَبِّ الْكَلامِ إِلَى اللَّهِ عَزَّ وَجَلَّ , أَنْ يَقُولَ الْعَبْدُ : رَبِّي إِنِّي ظَلَمْتُ نَفْسِي فَاغْفِرْ لِي ""","","","","","Book of Prayer"
"2790","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ أَبِي الضُّحَى , عَنْ مَسْرُوقٍ , عَنْ عَائِشَةَ , قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُكْثِرُ , أَنْ يَقُولَ فِي رُكُوعِهِ وَسُجُودِهِ : سُبْحَانَكَ اللَّهُمَّ , رَبَّنَا وَبِحَمْدِكَ , اللَّهُمَّ اغْفِرْ لِي , يَتَأَوَّلُ الْقُرْآنَ , يَعْنِي إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ ""","","","","","Book of Prayer"
"2791","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنْ أَبِي عُبَيْدَةَ , عَنْ عَبْدِ اللَّهِ , قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُكْثِرُ حِينَ نَزَلَتْ إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ , أَنْ يَقُولَ : سُبْحَانَكَ اللَّهُمَّ ! وَبِحَمْدِكَ , اللَّهُمَّ ! اغْفِرْ لِي أَنْتَ التَّوَّابُ ""","","","","","Book of Prayer"
"2792","عَنْ بِشْرِ بْنِ رَافِعٍ , عَنْ يَحْيَى بْنِ رَافِعٍ , عَنْ أَبِي عُبَيْدَةَ بْنِ عَبْدِ اللَّهِ , أَنَّ ابْنَ مَسْعُودٍ كَانَ إِذَا رَكَعَ , قَالَ : سُبْحَانَ رَبِّيَ الْعَظِيمِ ثَلاثًا فَزِيَادَةً وَإِذَا سَجَدَ , قَالَ : سُبْحَانَ رَبِّيَ الأَعْلَى وَبِحَمْدِهِ ثَلاثًا , فَزِيَادَةً \" , قَالَ أَبُو عُبَيْدَةَ : وَكَانَ أَبِي يَذْكُرُ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُهُ","","","","","Book of Prayer"
"2793","عَنْ مَعْمَرٍ , عَنْ عِمْرَانَ , أَنَّ عَائِشَةَ قَامَتْ ذَاتَ لَيْلَةٍ تَلْتَمِسُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي جَوْفِ اللَّيْلِ , قَالَ : فَوَقَعَتْ يَدُهَا عَلَى بَطْنِ قَدَمِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ سَاجِدٌ وَهُوَ يَقُولُ : \" سُبْحَانَ رَبِّي ذِي الْمَلَكُوتِ وَالْجَبَرُوتِ وَالْكِبْرِيَاءِ وَالْعَظَمَةِ , أَعُوذُ بِاللَّهِ , بِرِضَاكَ مِنْ سَخَطِكَ , وَأَعُوذُ بِمَغْفِرَتِكَ مِنْ عُقُوبَتِكَ , وَأَعُوذُ بِكَ مِنْكَ , لا أُحْصِي ثَنَاءً عَلَيْكَ , أَنْتَ كَمَا أَثْنَيْتَ عَلَى نَفْسِكَ \" , عَنِ ابْنِ جُرَيْجٍ , عَنْ رَجُلٍ , عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ , عَنْ عَائِشَةَ مِثْلَهُ","","","","","Book of Prayer"
"2794","عَنِ ابْنِ عُيَيْنَةَ , عَنْ يَحْيَى بْنِ سَعِيدٍ , عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ التَّيْمِيِّ , قَالَ : فَقَدَتْ عَائِشَةُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ذَاتَ لَيْلَةٍ فَذَهَبَتْ بِيَدِهَا فَوَقَعَتْ عَلَى أَخْمَصِ قَدَمِهِ وَهُوَ سَاجِدٌ , وَهُوَ يَقُولُ : \" أَعُوذُ بِمُعَافَاتِكَ مِنْ عُقُوبَتِكَ , وَأَعُوذُ بِرِضَاكَ مِنْ سَخَطِكَ , وَأَعُوذُ بِكَ مِنْكَ , لا أَبْلُغُ مِدْحَتَكَ , وَلا أُحْصِي ثَنَاءً عَلَيْكَ , أَنْتَ كَمَا أَثْنَيْتَ عَلَى نَفْسِكَ ""","","","","","Book of Prayer"
"2795","قَالَ : أَخْبَرَنَا مَعْمَرٌ , عَنْ قَتَادَةَ , عَنْ مُطَرِّفِ بْنِ عَبْدِ اللَّهِ , عَنْ عَائِشَةَ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ فِي رُكُوعِهِ وَفِي سُجُودِهِ : \" سُبُّوحًا قُدُّوسًا رَبَّ الْمَلائِكَةِ وَالرُّوحِ ""","","","","","Book of Prayer"
"2796","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ كَانَ يَقُولُ فِي رُكُوعِهِ , وَفِي سُجُودِهِ قَدْرَ خَمْسِ تَسْبِيحَاتٍ : \" سُبْحَانَ اللَّهِ وَبِحَمْدِهِ ""","","","","","Book of Prayer"
"2797","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ الْخُرَاسَانِيُّ , أَنَّ ابْنَ عَبَّاسٍ , قَالَ : \" ارْكَعْ حَتَّى تَسْتَمْكِنَ كَفَّيْكَ مِنْ رُكْبَتَيْكَ قَدْرَ ثَلاثِ تَسْبِيحَاتٍ , ثُمَّ ارْفَعْ صُلْبَكَ حَتَّى يَأْخُذَ كُلُّ عُضْوٍ مِنْكَ مَوْضِعَهُ ""","","","","","Book of Prayer"
"2798","عَنْ مَعْمَرٍ , عَمَّنْ , سَمِعَ الْحَسَنَ , يَقُولُ : \" يُجْزِئُ فِي الرُّكُوعِ وَالسُّجُودِ سُبْحَانَ اللَّهِ وَبِحَمْدِهِ ثَلاثًا ""","","","","","Book of Prayer"
"2799","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قال : \" كَانَ يَقُولُ إِذَا سَجَدَ يَقُولُ : سَجَدَ وَجْهِيَ لِلَّذِي خَلَقَهُ وَصَوَّرَهُ وَجَعَلَ سَمْعَهُ وَبَصَرَهُ ""","","","","","Book of Prayer"
"2800","قَالَ : أَخْبَرَنَا مَعْمَرٌ , عَنْ عَاصِمِ بْنِ أَبِي النَّجُودِ , قال : سَمِعْتُ شَقِيقَ بْنَ سَلَمَةَ , وَهُوَ سَاجِدٌ , يَقُولُ : اللَّهُمَّ اغْفِرْ لِي ""","","","","","Book of Prayer"
"2801","عَنِ ابْنِ عُيَيْنَةَ , عَنْ مِسْعَرٍ , عَنْ سَعِيدِ بْنِ أَبِي بُرْدَةَ , عَنْ أَبِيهِ , قَالَ : \" صَلَّيْتُ إِلَى جَنْبِ ابْنِ عُمَرَ , فَسَمِعْتُهُ يَقُولُ وَهُوَ سَاجِدٌ يَقُولُ : رَبِّ قِنِي عَذَابَكَ يَوْمَ تَبْعَثُ عِبَادَكَ ""","","","","","Book of Prayer"
"2802","عَنِ الثَّوْرِيِّ , عَنْ عَلِيِّ بْنِ الأَقْمَرِ , عَنْ أَبِي الأَسْوَدِ , وَشَدَّادِ بْنِ الأَزْمَعِ , عَنِ ابْنِ مَسْعُودٍ , قَالَ :  اخْتَلَفْنَا , فَقَالَ أَبُو الأَسْوَدِ : \" كَانَ عَبْدُ اللَّهِ يَقُولُ فِي سُجُودِهِ : سُبْحَانَكَ لا رَبَّ غَيْرُكَ \" , وَقَالَ شَدَّادٌ : كَانَ يَقُولُ : \" سُبْحَانَكَ لا إِلَهَ إِلا أَنْتَ ""","","","","","Book of Prayer"
"2803","قَالَ : أَخْبَرَنَا مَعْمَرٌ , عَنْ قَتَادَةَ , عَنْ أُمِّ الْحَسَنِ : أَنَّهَا سَمِعَتْ أُمَّ سَلَمَةَ تَقُولُ فِي سُجُودِهَا وَفِي صَلاتِهَا : \" اللَّهُمَّ اغْفِرْ وَارْحَمْ وَاهْدِنَا السَّبِيلَ الأَقْوَمَ \" , وَذَكَرَهُ عَبْدُ اللَّهِ بْنُ كَثِيرٍ , عَنْ شُعْبَةَ , عَنْ قَتَادَةَ , عَنْ أُمِّ الْحَسَنِ , عَنْ أُمِّ سَلَمَةَ","","","","","Book of Prayer"
"2804","عَنِ ابْنِ عُيَيْنَةَ , عَنْ مِسْعَرٍ , عَنْ سَعِيدِ بْنِ أَبِي بُرْدَةَ , عَنْ أَبِيهِ , قَالَ : \" صَلَّيْتُ إِلَى جَنْبِ ابْنِ عُمَرَ , فَسَمِعْتُهُ يَقُولُ : رَبِّ بِمَا أَنْعَمْتَ عَلَيَّ فَلَنْ أَكُونَ ظَهِيرًا لِلْمُجْرِمِينَ فَلَمَّا قَضَى صَلاتَهُ , قَالَ لِي : مَا صَلَّيْتُ صَلاةً قَطُّ إِلا رَجَوْتُ أَنْ يَكُونَ كَفَّارَةٌ لِمَا قَبْلَهَا ""","","","","","Book of Prayer"
"2805","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ , عَنْ أَبِيهِ , أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ لِلْحَطَّابَةِ وَسَأَلُوهُ , فَقَالَ : \" ثَلاثُ تَسْبِيحَاتٍ رُكُوعًا , وَثَلاثُ تَسْبِيحَاتٍ سُجُودًا لِلْحَطَّابَةِ يَعْنِي قَوْمًا جَاءُوهُ ""","","","","","Book of Prayer"
"2806","عَنْ يَحْيَى بْنِ الْعَلاءِ , عَنْ شُعْبَةَ , عَنْ عَمِّهِ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَلْقَمَةَ , قَالَ : \" دَخَلْتُ الْمَسْجِدَ فَوَجَدْتُ عَبْدَ اللَّهِ يُصَلِّي فَرَكَعَ فَافْتَتَحْتُ سُورَةَ الأَعْرَافِ , فَفَرَغْتُ قَبْلَ أَنْ يَسْجُدَ ""","","","","","Book of Prayer"
"2807","عَنِ الثَّوْرِيِّ , عَنْ هِشَامٍ , عَنِ ابْنِ سِيرِينَ , قال : \" إِذَا وَضَعَ يَدَيْهِ عَلَى رُكْبَتَيْهِ فَقَدْ أَتَمَّ , وَإِذَا أَمْكَنَ جَبْهَتَهُ مِنَ الأَرْضِ فَقَدْ أَتَمَّ \" , قَالَ سُفْيَانُ : وَإِنْ لَمْ يَفْعَلْ شَيْئًا","","","","","Book of Prayer"
"2808","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي الْوَلِيدُ بْنُ عَبْدِ اللَّهِ بْنِ أَبِي مُغِيثٍ , أَنَّهُ سَمِعَ أَبَا عَبْدِ اللَّهِ بْنَ بَجِيلَةَ وَكَانَ مَرْضِيًّا يُنْظَرُ إِلَيْهِ وَيُؤَدِّي إِلَى الْحَدِيثِ , فَسَمِعْتُهُ يَقُولُ : صَلَّى رَجُلٌ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَرَأَ سُورَةَ الْبَقَرَةِ , فَقَرَأَ فَأَحْسَنَ الْقِرَاءَةَ فِيهَا وَأَبْيَنَهَا وَأَجْمَلَهَا , لا يَمُرُّ بِآيَةٍ فِيهَا ذِكْرُ الْجَنَّةِ إِلا سَأَلَ عَنْهَا , وَلا بِآيَةٍ فِيهَا ذِكْرُ النَّارِ إِلا اسْتَعَاذَ عِنْدَهَا , حَتَّى إِذَا خَتَمَهَا رَكَعَ , وَقَالَ : سُبْحَانَ رَبِّ الْمَلَكُوتِ وَالْجَبَرُوتِ وَالْكِبْرِيَاءِ وَالْعَظَمَةِ , ثُمَّ رَفَعَ رَأْسَهُ , فَقَالَ : مِثْلَ ذَلِكَ حِينَ رَفَعَ رَأْسَهُ , ثُمَّ سَجَدَ , فَمَكَثَ سَاعَةً , يَقُولُ : مِثْلَ مَا مَكَثَ رَافِعًا رَأْسَهُ مِنَ الرَّكْعَةِ , ثُمَّ رَفَعَ رَأْسَهُ , فَقَامَ فَقَرَأَ آلَ عِمْرَانَ كَمِثْلِ ذَلِكَ , ثُمَّ خَتَمَهَا , فَصَنَعَ مِثْلَ مَا صَنَعَ فِي الرُّكُوعِ وَالسُّجُودِ , وَرَفْعِ الرَّأْسَ مِنَ الرُّكُوعِ وَالسُّجُودِ يَقُولُ : ذَلِكَ فِي كُلِّ ذَلِكَ كَمَا صَنَعَ فِي الرَّكْعَةِ الأُولَى , فَقَالَ لَهُ الرَّجُلُ حِينَ أَصْبَحَ : يَا نَبِيَّ اللَّهِ , أَرَدْتُ أَنْ أُصَلِّيَ بِصَلاةٍ فَلَمْ أَسْتَطِعْ , قَالَ : إِنَّكُمْ لا تَسْتَطِيعُونَ مَا أَسْتَطِيعُ , إِنِّي أَخْشَاكُمْ لِلَّهِ","","","","","Book of Prayer"
"2809","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : هَلْ بَلَغَكَ مِنْ قَوْلٍ : يُقَالَ فِي الرُّكُوعِ ؟ , قَالَ : لا , قُلْتُ : فَكَيْفَ تَقُولُ أَنْتَ ؟ , قَالَ : \" إِذَا لَمْ أَعْجَلْ وَلَمْ يَكُنْ مَعِي شَيْءٌ يَشْغَلُنِي , فَإِنِّي أَقُولُ قَوْلا : إِذَا بَلَغْتَهُ فَهُوَ ذَلِكَ , أَقُولُ : سُبْحَانَكَ وَبِحَمْدِكَ لا إِلَهَ إِلا أَنْتَ ثَلاثَ مَرَّاتٍ , سُبْحَانَ رَبِّنَا إِنْ كَانَ وَعْدُ رَبِّنَا لَمَفْعُولا ثَلاثًا , سُبْحَانَ اللَّهِ الْعَظِيمِ ثَلاثًا , سُبْحَانَ اللَّهِ وَبِحَمْدِهِ ثَلاثَ مَرَّاتٍ , سُبْحَانَ الْمَلِكَ الْقُدُّوسِ ثَلاثَ مَرَّاتٍ , سُبُّوحٌ قُدُّوسٌ رَبُّ الْمَلائِكَةِ وَالرُّوحِ , سَبَقَتْ رَحْمَةُ رَبِّي غَضَبَهُ ثَلاثَ مَرَّاتٍ , قُلْتُ : فَهَلْ بَلَغَكَ , أَنَّهُ كَانَ يَقُولُ : شَيْئًا مِنْهُنَّ فِي الرُّكُوعِ ؟ , قَالَ : لا , قُلْتُ : فَمَا تَتَّبِعُ فِي ذَلِكَ ؟ , قَالَ : \" أَمَّا سُبْحَانَكَ وَبِحَمْدِكَ لا إِلَهَ إِلا أَنْتَ ""","","","","","Book of Prayer"
"2810","فَأَخْبَرَنِي ابْنُ أَبِي مُلَيكَةَ عَنْ عَائِشَةَ , قَالَتْ : افْتَقَدْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ذَاتَ لَيْلَةٍ , فَظَنَنْتُ أَنَّهُ ذَهَبَ إِلَى بَعْضِ نِسَائِهِ , فَجَسَسْتُ ثُمَّ رَجَعْتُ , فَإِذَا هُوَ رَاكِعٌ وَسَاجِدٌ يَقُولُ : \" سُبْحَانَكَ وَبِحَمْدِكَ لا إِلَهَ إِلا أَنْتَ \" , قَالَتْ : قُلْتُ : بِأَبِي أَنْتَ وَأُمِّي , إِنِّي لَفِي شَأْنٍ , وَإِنَّكِ لَفِي آخَرٍ قَالَ : \" أَمَّا سُبْحَانَ رَبِّنَا إِنْ كَانَ وَعْدُ رَبِّنَا لَمَفْعُولا , فَأَتَّبِعُ بِهَا الَّتِي فِي سُورَةِ بَنِي إِسْرَائِيلَ , وَأَمَّا سُبْحَانَ اللَّهِ الْعَظِيمِ وَسُبْحَانَ اللَّهِ وَبِحَمْدِهِ فَأُعَظِّمُ بِهِمَا اللَّهَ , وَأَمَّا سُبْحَانَ الْمَلِكَ الْقُدُّوسِ ""","","","","","Book of Prayer"
"2811","فَبَلَغَنِي , عَنْ عُبَيْدِ بْنِ عُمَيْرٍ , أَنَّهُ قَالَ : \" يَنْزِلُ الرَّبُّ تَبَارَكَ وَتَعَالَى شَطْرَ اللَّيْلِ الآخِرِ فِي السَّمَاءِ , فَيَقُولُ : مَنْ يَسْأَلُنِي فَأُعْطِيَهُ ؟ وَمَنْ يَسْتَغْفِرُنِي فَأَغْفِرَ لَهُ ؟ , وَيَقُولُ الْمَلِكَ : سَبِّحُوا الْمَلِكَ الْقُدُّوسَ , حَتَّى إِذَا كَانَ الْفَجْرُ صَعِدَ الرَّبُّ , فَأَتَّبِعُ قَوْلَ الْمَلَكَ : سُبْحَانَ الْمَلِكَ الْقُدُّوسِ , وَأَمَّا سُبُّوحٌ قُدُّوسٌ سَبَقَتْ رَحْمَةُ رَبِّي غَضَبَهُ ""","","","","","Book of Prayer"
"2812","فَبَلَغَنِي : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمَّا أُسْرِيَ بِهِ كَانَ كُلَّمَا مَرَّ قِسْمًا سَلَّمَتْ عَلَيْهِ الْمَلائِكَةُ حَتَّى إِذَا جَاءَ السَّمَاءَ السَّادِسَةَ , قَالَ لَهُ جِبْرِيلُ : هَذَا مَلَكَ فَسَلِّمْ عَلَيْهِ , فَبَدَرَهُ الْمَلَكَ فَبَدَأَهُ بِالسَّلامِ \" , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : وَدِدْتُ لَوْ أَنِّي سَلَّمْتُ عَلَيْهِ قَبْلَ أَنْ يُسَلِّمَ عَلَيَّ , فَلَمَّا جَاءَ السَّمَاءَ السَّابِعَةَ , قَالَ لَهُ جِبْرِيلُ : أَنَّ اللَّهَ عَزَّ وَجَلَّ يُصَلِّي , فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَهُوَ يُصَلِّي ؟ , قَالَ : نَعَمْ , قَالَ : وَمَا صَلاتُهُ ؟ , قَالَ : يَقُولُ : سُبُّوحٌ قُدُّوسٌ رَبُّ الْمَلائِكَةِ وَالرُّوحِ , سَبَقَتْ رَحْمَتِي غَضَبِي , فَأَتَّبِعُ ذَلِكَ قَالَ : قُلْتُ : أُقَدِّمُ بَعْضَ ذَلِكَ قَبْلَ بَعْضٍ , قَالَ : إِنْ شِئْتَ ""","","","","","Book of Prayer"
"2813","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" أَقُولُ فِي السُّجُودِ : مِثْلَ مَا أَقُولُ فِي الرُّكُوعِ ""","","","","","Book of Prayer"
"2814","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : سَأَلَ ابْنُ طَاوُسٍ , عَنْ وَفَاءِ السُّجُودِ , فَأَشَارَ بِيَدِهِ , فَقال : \" ثَلاثُ تَسْبِيحَاتٍ , قَالَ أَبُو بَكْرٍ : وَذَكَرَهُ مُحَمَّدُ بْنُ مُسْلِمٍ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , عَنْ طَاوُسٍ ""","","","","","Book of Prayer"
"2815","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : \" كُنْتُ أَسْمَعُ ابْنَ الزُّبَيْرِ كَثِيرًا , يَقُولُ فِي سُجُودِهِ : سُبُّوحٌ قُدُّوسٌ رَبُّ الْمَلائِكَةِ وَالرُّوحِ , سَبَقَتْ رَحْمَةُ رَبِّي غَضَبَهُ ""","","","","","Book of Prayer"
"2816","عَنِ الْحَسَنِ بْنِ عُمَارَةَ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَاصِمِ بْنِ ضَمْرَةَ , عَنْ عَلِيٍّ , قَالَ : \" كَانَ عَلِيٌّ , يَقُولُ إِذَا رَكَعَ : اللَّهُمَّ لَكَ خَشَعْتُ , وَلَكَ رَكَعْتُ , وَلَكَ أَسْلَمْتُ , وَبِكَ آمَنْتُ , وَأَنْتَ رَبِّي , وَعَلَيْكَ تَوَكَّلْتُ , خَشَعَ لَكَ سَمْعِي وَبَصَرِي وَلَحْمِي وَدَمِي وَمُخِّي وَعِظَامِي وَعَصَبِي وَشَعْرِي وَبَشَرِي , سُبْحَانَ اللَّهِ , سُبْحَانَ اللَّهِ , سُبْحَانَ اللَّهِ , فَإِذَا قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , قَالَ : اللَّهُمَّ رَبَّنَا لَكَ الْحَمْدُ , فَإِذَا سَجَدَ , قَالَ : اللَّهُمَّ لَكَ سَجَدْتُ , وَلَكَ أَسْلَمْتُ , وَبِكَ آمَنْتُ , وَعَلَيْكَ تَوَكَّلْتُ , وَأَنْتَ رَبِّي , سَجَدَ لَكَ سَمْعِي وَبَصَرِي وَلَحْمِي وَدَمِي وَعِظَامِي وَعَصَبِي وَشَعْرِي وَبَشَرِي , سُبْحَانَ اللَّهِ , سُبْحَانَ اللَّهِ , سُبْحَانَ اللَّهِ ""","","","","","Book of Prayer"
"2817","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ مُوسَى بْنِ عُقْبَةَ , عَنْ عَبْدِ اللَّهِ بْنِ الْفَضْلِ , عَنْ عَبْدِ الرَّحْمَنِ الأَعْرَجِ , عَنْ عُبَيْدِ اللَّهِ بْنِ أَبِي رَافِعٍ , عَنْ عَلِيٍّ , قَالَ : \" كَانَ كَلامُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي رُكُوعِهِ , أَنْ يَقُولَ : اللَّهُمَّ لَكَ رَكَعْتُ , وَبِكَ آمَنْتُ , وَلَكَ أَسْلَمْتُ , وَأَنْتَ رَبِّي , خَشَعَ سَمْعِي وَبَصَرِي وَمُخِّي وَعِظَامِي وَعَصَبِي لِلَّهِ رَبِّ الْعَالَمِينَ , فَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ , قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ ثُمَّ يُتْبِعُهَا اللَّهُمَّ لَكَ الْحَمْدُ مِلْءَ السَّمَوَاتِ وَمِلْءَ الأَرْضِ وَمِلْءَ مَا شِئْتَ مِنْ شَيْءٍ بَعْدُ , فَإِذَا سَجَدَ قَالَ فِي سُجُودِهِ : اللَّهُمَّ لَكَ سَجَدْتُ , وَبِكَ آمَنْتُ , وَلَكَ أَسْلَمْتُ , وَأَنْتَ رَبِّي , سَجَدَ وَجْهِيَ لِلَّذِي خَلَقَهُ , وَشَقَّ سَمْعَهُ وَبَصَرَهُ , تَبَارَكَ اللَّهُ أَحْسَنُ الْخَالِقِينَ \" , عَنِ ابْنِ أَبِي , عَنِ ابْنِ الْمُنْكَدِرِ , عَنْ عَلِيٍّ مِثْلَهُ","","","","","Book of Prayer"
"2818","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , قال : \" كَانَ طَاوُسٌ , يَقُولُ فِي رُكُوعِهِ : اللَّهُمَّ لَكَ رَكَعْتُ , وَلَكَ خَشَعْتُ , وَلَكَ أَسْلَمْتُ , وَبِكَ آمَنْتُ , وَعَلَيْكَ تَوَكَّلْتُ , وَإِلَيْكَ أَنَبْتُ , وَإِلَيْكَ الْمَصِيرُ ""","","","","","Book of Prayer"
"2819","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" سُنَّةٌ إِذَا رَفَعْتَ رَأْسَكَ مِنَ الرَّكْعَةِ أَوِ السَّجْدَةِ فَانْتَصِبْ حَتَّى يَرْجِعَ كُلُّ عَظْمٍ مِنْهَا مِفْصَلَهُ , فَإِذَا فَعَلْتَ فَحَسْبُكَ , وَقَدْ كَانَ يُقَالَ : فَلا أَدْرِي أَقَالَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَعْدَ مَا رَفَعَ رَأْسَهُ مِنَ الرَّكْعَةِ فَانْتَصَبَ قُلْ : اللَّهُمَّ رَبَّنَا لَكَ الْحَمْدُ مِلْءَ السَّمَوَاتِ وَمِلْءَ الأَرْضِ وَمِلْءَ مَا شِئْتَ مِنْ شَيْءٍ بَعْدُ , لا مَانِعَ لِمَا أَعْطَيْتَ , وَلا مُعْطِيَ لِمَا مَنَعْتَ , وَلا يَعْصِمُ ذَا الْجَدِّ مِنْكَ الْجَدُّ ""","","","","","Book of Prayer"
"2820","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ عَوْنِ بْنِ عَبْدِ اللَّهِ ابْنِ عُتْبَةَ , قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , قَالَ : اللَّهُمَّ رَبَّنَا لَكَ الْحَمْدُ مِلْءَ السَّمَوَاتِ وَمِلْءَ الأَرْضِ وَمِلْءَ مَا شِئْتَ مِنْ شَيْءٍ بَعْدُ ""","","","","","Book of Prayer"
"2821","عَنْ إِبْرَاهِيمَ بْنِ عُمَرَ , قَالَ : أَخْبَرَنِي وَهْبُ بْنُ مَانُوسَ , قَالَ : سَمِعْتُ سَعِيدَ بْنَ جُبَيْرٍ يُحَدِّثُ , عَنِ ابْنِ عَبَّاسٍ : \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ , قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , ثُمَّ يَقُولُ : اللَّهُمَّ رَبَّنَا وَلَكَ الْحَمْدُ مِلْءَ السَّمَوَاتِ , وَمِلْءَ الأَرْضِ وَمِلْءَ مَا شِئْتَ مِنْ شَيْءٍ بَعْدُ ""","","","","","Book of Prayer"
"2822","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنْ أَنَسِ بْنِ مَالْكَ , أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" إِذَا قَالَ الإِمَامُ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , فَقُولُوا : رَبَّنَا لَكَ الْحَمْدُ \" , عَنِ ابْنِ جُرَيْجٍ مِثْلَهُ بِهَذَا السَّنَدِ","","","","","Book of Prayer"
"2823","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , عَنِ ابْنِ عُمَرَ , أَنَّهُ سَمِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حِينَ رَفَعَ رَأْسَهُ مِنَ الرَّكْعَةِ قَالَ : رَبَّنَا لَكَ الْحَمْدُ ""","","","","","Book of Prayer"
"2824","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ قَالَ : \" اللَّهُمَّ رَبَّنَا وَلَكَ الْحَمْدُ ""","","","","","Book of Prayer"
"2825","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنْ يُونُسَ بْنِ جُبَيْرٍ , عَنْ حِطَّانَ بْنِ عَبْدِ اللَّهِ الرَّقَاشِيِّ , عَنْ أَبِي مُوسَى الأَشْعَرِيِّ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" إِذَا قَالَ الإِمَامُ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , فَقُولُوا : رَبَّنَا لَكَ الْحَمْدُ , يَسْمَعُ اللَّهُ لَكُمْ , فَإِنَّ اللَّهَ قَضَى عَلَى لِسَانِ نَبِيِّهِ , سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ ""","","","","","Book of Prayer"
"2826","عَنْ عَلِيٍّ : \" أَنَّهُ كَانَ إِذَا قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , قَالَ : اللَّهُمَّ ! رَبَّنَا لَكَ الْحَمْدُ كَثِيرًا , ثُمَّ يَسْجُدُ لأُعْطِيَهُ كَذَا , قَالَ : اللَّهُمَّ ! رَبَّنَا لَكَ الْحَمْدُ , اللَّهُمَّ بِحَوْلَكَ وَقُوَّتِكَ أَقُومُ وَأَقْعُدُ ""","","","","","Book of Prayer"
"2827","عَنِ الثَّوْرِيِّ , عَنْ سَلَمَةَ بْنِ كُهَيْلٍ , عَنِ الأَحْوَصِ , قال : \" إِذَا قَالَ الإِمَامُ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , فَلْيَقُلْ مَنْ خَلْفَهُ : رَبَّنَا لَكَ الْحَمْدُ ""","","","","","Book of Prayer"
"2828","عَنِ ابْنِ جُرَيْجٍ , عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ , عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ : أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ وَهُوَ إِمَامٌ لِلنَّاسِ فِي الصَّلاةِ , يَقُولُ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , اللَّهُمَّ رَبَّنَا لَكَ الْحَمْدُ , اللَّهُ أَكْبَرُ يَرْفَعُ بِذَلِكَ صَوْتَهُ وَنُتَابِعُهُ مَعًا ""","","","","","Book of Prayer"
"2829","عَنِ ابْنِ عُيَيْنَةَ , عَنْ أَيُّوبَ السَّخْتِيَانِيِّ , قَالَ : سَمِعْتُ عَبْدَ الرَّحْمَنِ بْنَ هُرْمُزَ الأَعْرَجَ , يَقُولُ : سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ : \" إِذَا رَفَعَ الإِمَامُ رَأْسَهُ مِنَ الرُّكُوعِ , فَقَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , فَقُلْ : رَبَّنَا لَكَ الْحَمْدُ ""","","","","","Book of Prayer"
"2830","عَنِ ابْنِ التَّيْمِيِّ , قَالَ : سَمِعْتُ عَبْدَ الْمَلِكَ بْنَ عُمَيْرٍ , يَقُولُ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ , قَالَ : الْحَمْدُ لِلَّهِ ذِي الْمُلْكِ وَالْجَبَرُوتِ وَالْكِبْرِيَاءِ وَالْعَظَمَةِ ""","","","","","Book of Prayer"
"2831","عَنِ ابْنِ عُيَيْنَةَ , عَنْ دَاوُدَ بْنِ سَابُورَ , عَنْ مُجَاهِدٍ , قَالَ : قَالَ رَجُلٌ حِينَ رَفَعَ رَأْسَهُ مِنَ الرَّكْعَةِ : رَبَّنَا لَكَ الْحَمْدُ كَثِيرًا طَيِّبًا مُبَارَكًا فِيهِ , فَلَمَّا قَضَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاتَهُ قَالَ : \" مَنْ قَائِلُ الْكَلِمَاتِ ؟ \" , فَسَكَتَ الرَّجُلُ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَنْ قَائِلُهَا ؟ \" , فَقَالَ الرَّجُلُ : أَنَا يَا رَسُولَ اللَّهِ , قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لَقَدِ ابْتَدَرَهَا اثْنَا عَشَرَ مَلَكًا كُلُّهُمْ يَكْتُبُهَا ""","","","","","Book of Prayer"
"2832","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِنْ كُنْتَ مَعَ إِمَامٍ , فَقَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , فَإِنْ قُلْتَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ أَيْضًا فَحَسَنٌ , وَإِنْ لَمْ تَقُلْ مَعَ الإِمَامِ سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ فَقَدْ أَجْزَأَ عَنْكَ , وَأَنْ تَجْمَعَهُمَا مَعَ الإِمَامِ أَحَبُّ إِلَيَّ ""","","","","","Book of Prayer"
"2833","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ : أَرَأَيْتَ إِنْ لَمْ يُسْمِعْنِي الإِمَامُ قَوْلَهُ سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ ؟ , قَالَ : \" قُلْ مِثْلَ مَا يَقُولُ : إِذَا سَمِعَكَ , قَالَ : وَيُحَمِّدُ الإِمَامُ , إِذَا قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ وَالْمَرْءُ يُصَلِّي لِنَفْسِهِ , فَيَحْمَدَانِ وَهُمَا مُنْتَصِبَانِ قَبْلَ أَنْ يَسْجُدَا , فَإِنَّهُ يُؤْمَرُ بِالْحَمْدِ الإِمَامُ وَغَيْرُهُ , إِذَا قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , وَيَقُولُ : مَنْ وَرَاءَ الإِمَامِ مَا قَدْ كَتُبِتْ ""","","","","","Book of Prayer"
"2834","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" وَإِنْ قُلْتَ إِذَا رَفَعْتَ رَأْسَكَ مِنَ الرَّكْعَةِ الْحَمْدُ لِلَّهِ , أَجْزَأَ عَنْكَ إِذَا حَمِدْتَ أَيَّ الْحَمْدِ فَحَسْبُكَ ""","","","","","Book of Prayer"
"2835","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قال : \" يَرْفَعُ رَأْسَهُ مِنَ السُّجُودِ حَتَّى يَقَرَّ كُلُّ شَيْءٍ قَرَارَهُ ""","","","","","Book of Prayer"
"2836","عَنْ مَعْمَرٍ , عَنْ مَنْصُورٍ , عَنْ سَالِمِ بْنِ أَبِي الْجَعْدِ , عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا سَجَدِ جَافَى حَتَّى يُرَى بَيَاضُ إِبْطَيْهِ ""","","","","","Book of Prayer"
"2837","عَنْ دَاوُدَ بْنِ قَيْسٍ , قَالَ : سَمِعْتُ عُبَيْدَ اللَّهِ بْنَ عَبْدِ اللَّهِ بْنِ أَقْرَمَ يُحَدِّثُ , عَنْ أَبِيهِ , قَالَ : حَدَّثَنِي أَبِي , أَنَّهُ كَانَ مَعَ أَبِيهِ بِالْقَاعِ مِنْ نَمِرَةَ , أَوْ قَالَ : مِنْ تَمِرَةَ , قَالَ : \" فَمَرَّ بِنَا رَكْبٌ فَأَنَاخُوا بِنَاحِيَةِ الطَّرِيقِ , فَقَالَ لِي أَبِي : أَيْ بُنَيَّ كُنْ فِي بَهْمِنَا حَتَّى أَدْنُوَ مِنْ هَؤُلاءِ الرَّكْبِ قَالَ : فَدَنَا مِنْهُمْ وَدَنَوْتُ مَعَهُ , فَأُقِيمَتِ الصَّلاةُ , فَإِذَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيهِمْ , فَقَالَ : فَكُنْتُ أَنْظُرُ إِلَى عُفْرَةِ إِبْطَيْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كُلَّمَا سَجَدَ ""","","","","","Book of Prayer"
"2838","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنِ التَّمِيمِيِّ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُرَى بَيَاضُ إِبْطَيْهِ إِذَا سَجَدَ ""","","","","","Book of Prayer"
"2839","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا سَجَدَ يُرَى بَيَاضُ إِبْطَيْهَ ""","","","","","Book of Prayer"
"2840","قَالَ ابْنُ عُيَيْنَةَ : وَأَخْبَرَنِي عُبَيْدُ اللَّهِ بْنُ عَبْدِ اللَّهِ , عَنْ يَزِيدَ بْنِ الأَصَمِّ , عَنْ مَيمُونَةَ , قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا سَجَدَ تَجَافَى حَتَّى لَوْ أَنَّ بَهْمَةً أَرَادَتْ أَنْ تَمُرَّ تَحْتَ يَدِهِ مَرَّتْ ""","","","","","Book of Prayer"
"2841","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قال : \" كَانَ يُكْرَهُ أَنْ يَتَطَاولَ فِي السُّجُودِ أَوْ يَحْبِسَ , وَلَكَنْ وَسَطًا بَيْنَ ذَلِكَ ""","","","","","Book of Prayer"
"2842","قَالَ إِبْرَاهِيمُ : وَحُدِّثْتُ \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُرَى بَيَاضُ إِبْطِهِ إِذَا سَجَدَ ""","","","","","Book of Prayer"
"2843","عَنِ الثَّوْرِيِّ , عَنْ آدَمَ بْنِ عَلِيٍّ , قَالَ : رَآنِي ابْنُ عُمَرَ , وَأَنَا أُصَلِّي لا أَتَجَافَى عَنِ الأَرْضِ , بِذِرَاعِي , فَقال : \" يَا ابْنَ أَخِي , لا تَبْسُطْ بَسْطَ السَّبُعِ , وَادَّعِمْ عَلَى رَاحَتَيْكَ , وَأَبْدِ ضَبْعَيْكَ , فَإِنَّكَ إِذَا فَعَلْتَ ذَلِكَ سَجَدَ كُلُّ عُضْوٍ مِنْكَ ""","","","","","Book of Prayer"
"2844","عَنِ الثَّوْرِيِّ , عَنْ سُمَيٍّ , قَالَ : حَدَّثَنَا النُّعْمَانُ بْنُ أَبِي عَيَّاشٍ الزُّرَقِيُّ , قَالَ : \" شَكَا أَصْحَابُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الاعْتِمَادَ بِأَيْدِيهِمْ فِي السُّجُودِ , فَرَخَّصَ لَهُمْ أَنْ يَسْتَعِينُوا بِأَيْدِيهِمْ عَلَى رُكَبِهِمْ فِي السُّجُودِ \" , فَقَالَ سُفْيَانُ : وَهِيَ رُخْصَةٌ لِلمُتَهَجِّدِ","","","","","Book of Prayer"
"2845","عَنِ ابْنِ جُرَيْجٍ , عَنْ سُلَيْمَانَ بْنِ مُوسَى , أَنَّ جَابِرَ بْنَ عَبْدِ اللَّهِ , قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \" يَأْمُرُ بِأَنْ يَعْتَدِلَ فِي السُّجُودِ , وَلا يَسْجُدُ الرَّجُلُ بَاسِطًا ذِرَاعَيْهِ كَالْكَلْبِ ""","","","","","Book of Prayer"
"2846","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ أَبِي سُفْيَانَ , عَنْ جَابِرٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا سَجَدَ أَحَدُكُمْ فَلْيَعْتَدِلْ , وَلا يَفْتَرِشْ ذِرَاعَيْهِ افْتِرَاشَ الْكَلْبِ ""","","","","","Book of Prayer"
"2847","عَنْ دَاوُدَ بْنِ قَيْسٍ , عَنْ دَاوُدَ بْنِ أَسْلَمَ , قَالَ : اشْتَكَى الْمُسْلِمُونَ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ التَّفَرُّجَ فِي الصَّلاةِ , \" فَأُمِرُوا أَنْ يَسْتَعِينُوا بِرُكَبِهِمْ ""","","","","","Book of Prayer"
"2848","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , قَالَ : \" كَانَ ابْنُ عُمَرَ إِذَا رَأَى الرَّجُلَ يُفَرِّجُ بَيْنَ أَصَابِعِهِ فِي الصَّلاةِ فِي السُّجُودِ نَهَاهُ , قَالَ : \" وَكَانَ هُوَ يَضُمُّ أَصَابِعَهُ ضَمًّا وَيَبْسُطُهَا ""","","","","","Book of Prayer"
"2849","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ , عَنْ حَفْصِ بْنِ عَاصِمٍ , قَالَ : صَلَّيْتُ إِلَى جَنْبِ ابْنِ عُمَرَ , فَفَرَّجْتُ بَيْنَ أَصَابِعِي حِينَ سَجَدْتُ , فَقَالَ : \" يَا ابْنَ أَخِي , اضْمُمْ أَصَابِعَكَ إِذَا سَجَدْتَ , وَاسْتَقْبِلِ الْقِبْلَةَ , وَاسْتَقْبِلْ بِالْكَفَّيْنِ الْقِبْلَةَ , فَإِنَّهُمَا يَسْجُدَانِ مَعَ الْوَجْهِ ""","","","","","Book of Prayer"
"2850","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ , أَنَّ ابْنَ عُمَرَ , كَانَ يَقُولُ : \" إِذَا سَجَدَ أَحَدُكُمْ فَلْيَضَعْ يَدَيْهِ مَعَ وَجْهِهِ , فَإِنَّ الْيَدَيْنِ تَسْجُدَانِ كَمَا يَسْجُدُ الْوَجْهُ , وَإِذَا رَفَعَ رَأْسَهُ فَلْيَرْفَعْهُمَا مَعَهُ ""","","","","","Book of Prayer"
"2851","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , قَالَ : \" إِذَا سَجَدَ أَحَدُكُمْ فَلْيَرْفَعْ يَدَيْهِ , فَإِنَّ الْيَدَيْنِ تَسْجُدَانِ مَعَ الْوَجْهِ ""","","","","","Book of Prayer"
"2852","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِبْرَاهِيمُ بْنُ مَيْسَرَةَ , عَنْ طَاوُسٍ , قال : مَا رَأَيْتُ مُصَلِّيًا كَهَيْئَةِ عَبْدِ اللَّهِ بْنِ عُمَرَ أَشَدَّ اسْتِقْبَالا لِلْكَعْبَةِ بِوَجْهِهِ , وَكَفَّيْهِ , وَقَدَمَيْهِ ""","","","","","Book of Prayer"
"2853","عَنِ الثَّوْرِيِّ , عَنِ ابْنِ عَجْلانَ , عَنْ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ , قَالَ : \" كَانَ ابْنُ عُمَرَ يُحِبُّ أَنْ يَعْتَدِلَ فِي الصَّلاةِ حَتَّى أَصَابِعُهُ إِلَى الْقِبْلَةِ ""","","","","","Book of Prayer"
"2854","عَنْ عُثْمَانَ بْنِ مَطَرٍ , عَنْ حُسَيْنٍ , عَنْ بُدَيْلٍ الْعُقَيْلِيِّ , عَنْ أَبِي الْجَوْزَاءِ , عَنْ عَائِشَةَ , قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَنْهَانَا أَنْ يَفْتَرِشَ أَحَدُنَا ذِرَاعَيْهِ افْتِرَاشَ الْكَلْبِ أَوِ السَّبُعِ ""","","","","","Book of Prayer"
"2855","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلْتُ عَطَاءً عَنِ الْجُنُوحِ بِالْيَدَيْنِ فِي السُّجُودِ , فَقَالَ : \" يُنْهَى عَنْهُ , فَقُلْتُ : فَإِنِّي أَجْعَلُ مِرْفَقَيَّ , فَقَالَ : إِنْ شِئْتَ فَعَلَى رُكْبَتَيْكَ , وَإِنْ شِئْتَ فَلا تَجْعَلْهُمَا عَلَيْهِمَا , إِذَا لَمْ تَجَنَّحْ فَلا يَضُرُّكَ أَيْنَ جَعَلْتَهَا ""","","","","","Book of Prayer"
"2856","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" كَانَ يَنْهَانَا أَنْ يَضَعَ الرَّجُلُ ذِرَاعَيْهِ عَلَى الأَرْضِ إِذَا سَجَدَ إِلَى الْكَفَّيْنِ ""","","","","","Book of Prayer"
"2857","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ حَبِيبٍ , عَنْ أَبِي الشَّعْثَاءِ , عَنِ ابْنِ عُمَرَ , أَنَّهُ رَأَى رَجُلا يَتَنَحَّى إِذَا سَجَدَ , قَالَ : \" لا , لا تَقْلِبْ صُورَتَكَ , يَقُولُ : لا تُؤْثِرَهَا \" , قُلْتُ : مَا تَقْلِبُ صُورَتَكَ ؟ , قَالَ : \" لا تُغَيِّرْ , لا تُخَنِّسْ ""","","","","","Book of Prayer"
"2858","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ أَبِي وَائِلٍ , قَالَ : قَالَ عَبْدُ اللَّهِ : \" إِذَا سَجَدَ أَحَدُكُمْ فَلا يَسْجُدْ مُتَوَرِّكًا وَلا مُضْطَجِعًا , فَإِنَّهُ إِذَا أَحْسَنَ السُّجُودَ سَجَدَتْ عِظَامُهُ كُلُّهَا ""","","","","","Book of Prayer"
"2859","عَنِ الثَّوْرِيِّ , عَنْ عَمْرِو بْنِ قَيْسٍ , عَنْ مَسْرُوقٍ , قَالَ : رَأَى رَجُلا حِينَ سَجَدَ رَفَعَ رِجْلَيْهِ فِي السَّمَاءِ , فَقَالَ : \" مَا تَمَّتِ الصَّلاةُ لِهَذَا ""","","","","","Book of Prayer"
"2860","عَنِ الثَّوْرِيِّ , عَنِ ابْنِ عَجْلانَ , عَنْ بُكَيْرِ بْنِ عَبْدِ اللَّهِ بْنِ الأَشَجِّ , عَنْ عَامِرِ بْنِ سَعْدٍ , قَالَ : \" أَمَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِوَضْعِ الْكَفَّيْنِ وَنَصْبِ الْقَدَمَيْنِ ""","","","","","Book of Prayer"
"2861","قَالَ سُفْيَانُ وَبَلَغَنِي أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَنْصِبُ قَدَمَيْهِ فِي السُّجُودِ , وَيَضَعُ الأَصَابِعَ عَلَى الأَرْضِ","","","","","Book of Prayer"
"2862","عَنِ ابْنِ جُرَيْجٍ , عَنْ سُلَيْمَانَ بْنِ مُوسَى , قال : \" أَمْكِنْ فِي السُّجُودِ رُكْبَتَيْكَ وَصُدُورَ قَدَمَيْكَ مِنَ الأَرْضِ ""","","","","","Book of Prayer"
"2863","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْ لَمْ أَنْصِبْ صُلْبِي فِي السَّجْدَةِ مِنَ الْمَكْتُوبَةِ , وَلَمْ أُثْبِتْ وَجْهِي سَاجِدًا فِي بَعْضِ ذَلِكَ ؟ , قَالَ : \" لا تُعِدْ , وَلا تَسْجُدْ سَجْدَتَيِ السَّهْوِ ""","","","","","Book of Prayer"
"2864","عَنِ الثَّوْرِيِّ , عَنْ أَبِي الْهُذَيْلِ , عَنْ إِبْرَاهِيمَ , قال : \" كَانَ يُكْرَهُ لِلرَّجُلِ إِذَا سَجَدَ أَنْ يُفْضِيَ بِذَكَرِهِ إِلَى الأَرْضِ \" , قَالَ : وَتَفْسِيرُهُ حَتَّى يَكُونَ بَيْنَهُ وَبَيْنَ الأَرْضِ ثَوْبٌ ""","","","","","Book of Prayer"
"2865","عَنِ الثَّوْرِيِّ , عَنْ عَاصِمِ بْنِ كُلَيْبٍ , عَنْ أَبِيهِ , عَنْ وَائِلِ بْنِ حُجْرٍ , قَالَ : \" رَمَقْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَلَمَّا سَجَدَ كَانَتْ يَدَاهُ حَذْوَ أُذُنَيْهِ ""","","","","","Book of Prayer"
"2866","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , قَالَ : \" كَانَ ابْنُ عُمَرَ يَضَعُ يَدَيْهِ إِذَا سَجَدَ حَذْوَ أُذُنَيْهِ ""","","","","","Book of Prayer"
"2867","عَنْ إِسْمَاعِيلَ بْنِ عُبَيْدِ اللَّهِ بْنِ أَبِي الْوَلِيدِ , عَنِ ابْنِ عَوْنٍ , عَنْ إِبْرَاهِيمَ , عَنِ الأَسْوَدِ , قَالَ : سُئِلَ ابْنُ عُمَرَ , أَنْ يَضَعَ الرَّجُلُ يَدَهُ إِذَا سَجَدَ ؟ فَقال : \" أَرْمِيهِمَا حَيْثُ وَقَعَتَا ""","","","","","Book of Prayer"
"2868","عَنِ ابْنِ جُرَيْجٍ , قال : قُلْتُ لِعَطَاءٍ : هَلْ لِلْكَفَّيْنِ مَوْضِعٌ يُؤْمَرُ بِهِ فِي السُّجُودِ ؟ , قَالَ : لا ""","","","","","Book of Prayer"
"2869","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَلْقَمَةَ , وَالأَسْوَدِ : \" أَنَّ ابْنَ مَسْعُودٍ , رَكَعَ فَطَبَّقَ يَدَيْهِ فَجَعَلَهُمَا بَيْنَ رُكْبَتَيْهِ ""","","","","","Book of Prayer"
"2870","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ مُصْعَبِ بْنِ سَعْدٍ , قَالَ : \" رَكَعْتُ فَطَبَّقْتُ فَجَعَلْتُ يَدَيَّ بَيْنَ رُكْبَتَيَّ , فَنَهَانِي أَبِي , وَقَالَ : إِنَّا كُنَّا نَفْعَلُ بِذَا فَنُهِينَا عَنْهُ ""","","","","","Book of Prayer"
"2871","عَنِ ابْنِ جُرَيْجٍ , عَنِ ابْنِ شِهَابٍ , عَنْ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ أَبِي هُرَيْرَةَ , أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ : \" سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ حِينَ يَرْفَعُ صُلْبَهُ مِنَ الرَّكْعَةِ , يَقُولُ وَهُوَ قَائِمٌ : رَبَّنَا وَلَكَ الْحَمْدُ , ثُمَّ يُكَبِّرُ حِينَ يَهْوِي سَاجِدًا ""","","","","","Book of Prayer"
"2872","عَنِ الثَّوْرِيِّ , وَمَعْمَرٍ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ : \" أَنَّ عُمَرَ كَانَ إِذَا رَكَعَ يَقَعُ كَمَا يَقَعُ الْبَعِيرُ رُكْبَتَاهُ قَبْلَ يَدَيْهِ , وَيُكَبِّرُ وَيَهْوِي ""","","","","","Book of Prayer"
"2873","عَنِ الثَّوْرِيِّ , عَنْ عَاصِمٍ , عَنْ إِبْرَاهِيمَ , فِي الرَّجُلِ يَقَعُ يَدَاهُ قَبْلَ رُكْبَتَيْهِ , قَالَ إِبْرَاهِيمُ : \" أَوَ يَفْعَلُ ذَلَكَ إِلا الْمَجْنُونُ ""","","","","","Book of Prayer"
"2874","عَنِ الثَّوْرِيِّ , عَنْ مَعْمَرٍ , عَنْ إِبْرَاهِيمَ , فِي الرَّجُلِ يَقَعُ يَدَاهُ قَبْلَ رُكْبَتَيْهِ , قَالَ إِبْرَاهِيمُ : \" أَوَ يَفْعَلُ ذَلَكَ إِلا الْمَجْنُونُ ""","","","","","Book of Prayer"
"2875","عَنِ التَّيْمِيِّ , عَنْ كَهْمَسٍ , عَنْ عَبْدِ اللَّهِ بْنِ يَسَارٍ : \" إِذَا سَجَدَ وَضَعَ رُكْبَتَيْهِ ثُمَّ يَدَيْهِ ثُمَّ وَجْهَهُ , فَإِذَا أَرَادَ أَنْ يَقُومَ رَفَعَ وَجْهَهُ , ثُمَّ يَدَيْهِ , ثُمَّ رُكْبَتَيْهِ \" , قَالَ عَبْدُ الرَّزَّاقِ : وَمَا أَحْسَنَهُ مِنْ حَدِيثٍ وَأَعْجِبْ بِهِ","","","","","Book of Prayer"
"2876","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , عَنِ ابْنِ الزُّبَيْرِ , قَالَ : مَا كَانَ يُكَبِّرُ إِلا وَهُوَ يَهْوِي وَفِي نَهْضَتِهِ لِلْقِيَامِ ""","","","","","Book of Prayer"
"2877","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ : \" أَنَّهُ رَأَى مُعَاوِيَةَ فِي الرَّكْعَةِ الثَّالِثَةِ كَذَا قَرَأَ الدَّبَرِيُّ وَالثَّالِثَةِ مِنَ الرُّكُوعِ إِذَا رَفَعَ رَأْسَهُ مِنَ السُّجُودِ لَمْ يَتَلَبَّثْ , قَالَ : يَنْهَضُ وَهُوَ يُكَبِّرُ فِي نَهْضَتِهِ لِلْقِيَامِ , قَالَ عَطَاءٌ : تَعَجَّبْتُ مِنْ ذَلِكَ حَتَّى بَلَغَنِي أَنَّ الأَمْرَ كَانَ عَلَى ذَلِكَ ""","","","","","Book of Prayer"
"2878","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ : أَنَّهُ كَانَ يَكْرَهُ أَنْ يَعْتَمِدَ إِذَا جَلَسَ بَيْنَ الرَّكْعَتَيْنِ وَإِذَا نَهَضَ عَلَى يَدَيْهِ ""","","","","","Book of Prayer"
"2879","عَنْ هُشَيْمِ بْنِ بَشِيرٍ , عَنْ مَنْصُورٍ , وَيُونُسَ , عَنِ الْحَسَنِ : \" أَنَّهُ كَانَ لا يَرَى بَأْسًا , أَنْ يَعْتَمِدَ الرَّجُلُ عَلَى يَدَيْهِ إِذَا نَهَضَ فِي الصَّلاةِ ""","","","","","Book of Prayer"
"2880","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ فِي الرَّجُلِ يَنْهَضُ لِيَقُومَ أَيَدَيْهِ يَرْفَعُ قَبْلُ أَمْ رُكْبَتَيْهِ ؟ , قَالَ : \" يَنْظُرُ أَهْوَنَ ذَلِكَ عَلَيْهِ ""","","","","","Book of Prayer"
"2881","عَنْ عَبْدِ اللَّهِ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ : \" أَنَّهُ كَانَ يَقُومُ إِذَا رَفَعَ رَأْسَهُ مِنَ السَّجْدَةِ مُعْتَمِدًا عَلَى يَدَيْهِ قَبْلَ أَنْ يَرْفَعَهُمَا ""","","","","","Book of Prayer"
"2882","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : إِنِّي أَرَى نَاسًا حِينَ يَقُومُ أَحَدُهُمُ يَثْنِي رِجْلَهُ , قَالَ : \" بِقَدَمِهَا , ثُمَّ يَضَعُ يَدَهُ عَلَى فَخِذِهِ , ثُمَّ يَقُومُ كَذَلِكَ , أَوْ يَضَعُ يَدَهُ فِي الأَرْضِ , ثُمَّ يَقُومُ عَلَيْهَا \" , قَالَ : هَذَا الْقِيَامُ أَقْرَبُ إِلَى النَّخْوَةِ , لا يَنْبَغِي فِي الصَّلاةِ إِلا التَّخَشُّعُ ""","","","","","Book of Prayer"
"2883","عَنِ ابْنِ عُيَيْنَةَ , عَنِ ابْنِ أَبِي لَيْلَى , قَالَ : سَمِعْتُ عَبْدَ الرَّحْمَنِ بْنَ يَزِيدَ , يَقُولُ : \" رَمَقْتُ عَبْدَ اللَّهِ بْنَ مَسْعُودٍ فِي الصَّلاةِ فَرَأَيْتُهُ يَنْهَضُ وَلا يَجْلِسُ , قَالَ : يَنْهَضُ عَلَى صُدُورِ قَدَمَيْهِ فِي الرَّكْعَةِ الأُولَى وَالثَّالِثَةِ ""","","","","","Book of Prayer"
"2884","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ , قَالَ : \" كَانَ عَبْدُ اللَّهِ يَنْهَضُ عَلَى صُدُورِ قَدَمَيْهِ مِنَ السَّجْدَةِ الآخِرَةِ وَفِي الرَّكْعَةِ الأُولَى وَالثَّالِثَةِ \" , عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ أَبِي عَطِيَّةَ , أَنَّ ابْنَ عَبَّاسٍ , وَابْنَ عُمَرَ كَانَا يَفْعَلانِ ذَلِكَ","","","","","Book of Prayer"
"2885","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ : \" أَنَّهُ كَانَ يَقُومُ إِذَا رَفَعَ رَأْسَهُ مِنَ السَّجْدَةِ مُعْتَمِدًا عَلَى يَدَيْهِ قَبْلَ أَنْ يَرْفَعَهُمَا ""","","","","","Book of Prayer"
"2886","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أُمِرْتُ أَنْ أَسْجُدَ عَلَى سَبْعٍ , وَلا أَكُفَّ شَعْرًا وَلا ثَوْبًا , عَلَى الْجَبْهَةِ وَالأَنْفِ , ثُمَّ يُمِرُّ يَدَيْهِ عَلَى جَبْهَتِهِ , وَأَنْفِهِ , وَالْكَفَّيْنِ , وَالرُّكْبَتَيْنِ , وَالْقَدَمَيْنِ ""","","","","","Book of Prayer"
"2887","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , أَنَّهُ سَمِعَ طَاوُسًا , يَحْسَبُ أَنَّهُ يَأْثِرُ ذَلِكَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" أُمِرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يَسْجُدَ عَلَى سَبْعَةٍ : بِجَبْهَتِهِ , وَكَفَّيْهِ , وَرُكْبَتَيْهِ , وَقَدَمَيْهِ , وَنُهِيَ أَنْ يَكُفَّ شَعْرًا أَوْ ثَوْبًا ""","","","","","Book of Prayer"
"2888","عَنْ إِبْرَاهِيمَ بْنِ يَزِيدَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ طَاوُسٍ , قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أُمِرْتُ أَنْ أَسْجُدَ عَلَى سَبْعَةِ أَعْظُمٍ , وَلا أَكُفَّ شَعْرًا , وَلا ثَوْبًا \" , قَالَ : الْجَبْهَةَ , ثُمَّ يَضَعُ يَدَهُ عَلَيْهَا , ثُمَّ يُمِرُّ إِلَى أَنْفِهِ , وَالْكَفَّيْنِ , وَالرُّكْبَتَيْنِ , وَالْقَدَمَيْنِ ""","","","","","Book of Prayer"
"2889","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ طَاوُسٍ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" أُمِرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يَسْجُدَ عَلَى سَبْعٍ , وَلا يَكُفَّ شَعْرًا , وَلا ثَوْبًا ""","","","","","Book of Prayer"
"2890","عَنِ ابْنِ جُرَيْجٍ عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قَالَ : \" أُمِرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يُصَلِّيَ عَلَى سَبْعٍ عَلَى كَفَّيْهِ , وَرُكْبَتَيْهِ , وَأَطْرَافِ قَدَمَيْهِ , وَجَبِينِهِ , ثُمَّ مَرَّ يَمْسَحُ طَاوُسٌ إِذَا قَالَ : وَجَبِينِهِ , ثُمَّ مَرَّ حَتَّى يَمْسَحَ أَنْفَهُ , وَلا يَكُفَّ شَعْرًا , وَلا الثِّيَابَ \" , قَالَ ابْنُ طَاوُسٍ : لا أَدْرِي أَيَّ السَّبْعِ كَانَ أَبُوهُ يَبْدَأُ","","","","","Book of Prayer"
"2891","عَنِ ابْنِ جُرَيْجٍ , قال : \" قَدْ كَانَ مَنْ مَضَى يَقُولُونَ : يَسْجُدُ الْمَرْءُ عَلَى وَجْهِهِ وَكَفَّيْهِ وَرُكْبَتَيْهِ وَقَدَمَيْهِ , وَلا يَكُفُّ شَعْرًا , وَلا ثَوْبًا ""","","","","","Book of Prayer"
"2892","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِبْرَاهِيمُ بْنُ مَيْسَرَةَ : \" أَنَّهُ سَأَلَ طَاوُسًا , قَالَ : الأَنْفُ مِنَ الْجَبِينِ ؟ , قَالَ : هُوَ خَيْرٌ ""","","","","","Book of Prayer"
"2893","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي الْحَكَمُ بْنُ أَبَانَ , عَنْ عِكْرِمَةَ , أَنَّهُ قَالَ : \" ضَعْ أَنْفَكَ حَتَّى يَخْرُجَ مِنْهُ الرَّغَمُ \" , قُلْتُ : مَا الرَّغَمُ ؟ , قَالَ : \" الْكَبْرُ ""","","","","","Book of Prayer"
"2894","عَنْ سِمَاكِ بْنِ حَرْبٍ , عَنْ عِكْرِمَةَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" إِذَا سَجَدْتَ فَأَلْصِقْ أَنْفَكَ بِالأَرْضِ ""","","","","","Book of Prayer"
"2895","أَخْبَرَنَا مَعْمَرٌ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ : \" أَنَّهُ رَأَى الطِّينَ فِي أَنْفِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ أَثَرِ السُّجُودِ وَكَانُوا مُطِرُوا مِنَ اللَّيْلِ ""","","","","","Book of Prayer"
"2896","عَنْ إِسْرَائِيلَ , عَنْ جَابِرٍ , قال : سَأَلْتُ الشَّعْبِيَّ , عَنِ الرَّجُلِ يَسْجُدُ عَلَى جَبِينِهِ , قَالَ : يُجْزِيهِ ""","","","","","Book of Prayer"
"2897","عَنْ مَعْمَرٍ , عَنْ عَاصِمِ بْنِ سُلَيْمَانَ , عَنْ عِكْرِمَةَ , مَوْلَى ابْنِ عَبَّاسٍ : أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَأَى امْرَأَةً تَسْجُدُ وَتَرْفَعُ أَنْفَهَا , فَقَالَ فِيهَا قَوْلا شَدِيدًا فِي الْكَرَاهَةِ لِرَفْعِهَا أَنْفَهَا","","","","","Book of Prayer"
"2898","عَنِ الثَّوْرِيِّ , عَنْ عَاصِمٍ , عَنْ عِكْرِمَةَ , قَالَ : مَرَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِرَجُلٍ يُصَلِّي , أَوِ امْرَأَةٍ , فَقَالَ : \" لا يَقْبَلُ اللَّهُ صَلاةً لا يُصِيبُ الأَنْفُ مِنْهَا مَا يُصِيبُ الْجَبِينَ ""","","","","","Book of Prayer"
"2899","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ اللَّهِ بْنِ عِيسَى , قَالَ : \" رَآنِي عَبْدُ الرَّحْمَنِ بْنُ أَبِي لَيْلَى وَأَنَا أُصَلِّي , فَقَالَ : يَا بُنَيَّ أَمْسِسْ أَنْفَكَ الأَرْضَ ""","","","","","Book of Prayer"
"2900","عَنِ الثَّوْرِيِّ , عَنْ وِقَاءٍ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قال : \" اسْجُدْ عَلَى أَنْفِكَ ""","","","","","Book of Prayer"
"2901","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي وِقَاءٌ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قال : \" إِذَا لَمْ تَضَعْ أَنْفَكَ مَعَ جَبِينِكَ لَمْ يُقْبَلْ مِنْكَ تِلَكَ السَّجْدَةُ ""","","","","","Book of Prayer"
"2902","عَنِ الثَّوْرِيِّ , عَنْ هِشَامٍ , عَنِ ابْنِ سِيرِينَ : \" يَسْجُدُ عَلَى أَنْفِهِ ""","","","","","Book of Prayer"
"2903","عَنِ الثَّوْرِيِّ , عَنْ وِقَاءٍ : \" سُئِلَ عَنْ رَجُلٍ يَسْجُدُ عَلَى جَبِينِهِ وَلا يَسْجُدُ عَلَى أَنْفِهِ , قَالَ : يُجْزِيهِ ""","","","","","Book of Prayer"
"2904","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ لَهُ : وَضْعُ الأَنْفِ مَعَ الْجَبِينِ ؟ , قَالَ : \" إِنِّي لأَسْجُدُ عَلَيْهِ مَرَّةً , وَمَرَّةً لا أَسْجُدُ عَلَيْهِ , وَلأَنْ أَسْجُدَ عَلَيْهِ أَحَبُّ إِلَيَّ ""","","","","","Book of Prayer"
"2905","عَنِ الثَّوْرِيِّ , قَالَ : كَانَ بَعْضُهُمْ , يَقُولُ : \" مَنْ قَالَ : إِنَّ السُّجُودَ عَلَى الأَنْفِ , فَسَجَدَ عَلَى جَبِينِهِ , وَلَمْ يَسْجُدْ عَلَى أَنْفِهِ أَجْزَأَهُ , وَمَنْ قَالَ : إِنَّهُ لَيْسَ عَلَى أَنْفِهِ سُجُودٌ فَسَجَدَ عَلَى الأَنْفِ وَلَمْ يَسْجُدْ عَلَى الْجَبِينِ لَمْ يُجْزِهِ ""","","","","","Book of Prayer"
"2906","عَنِ الثَّوْرِيِّ , عَنْ مُخَوَّلٍ , عَنْ رَجُلٍ , عَنْ أَبِي رَافِعٍ , قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يُصَلِّيَ الرَّجُلُ وَرَأْسُهُ مَعْقُوصٌ ""","","","","","Book of Prayer"
"2907","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي عِمْرَانُ بْنُ مُوسَى , عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ , عَنْ أَبِيهِ , أَنَّهُ رَأَى أَبَا رَافِعٍ مَوْلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , مَرَّ بِحَسَنِ بْنِ عَلِيٍّ , وَحَسَنٌ يُصَلِّي قَائِمًا وَقَدْ غَرَزَ ضَفْرَتَهُ فِي قَفَاهُ , فَحَلَّهَا أَبُو رَافِعٍ , فَالْتَفَتَ إِلَيْهِ مُغْضَبًا , فَقَالَ لَهُ أَبُو رَافِعٍ : أَقْبِلْ عَلَى صَلاتِكَ وَلا تَغْضَبْ , فَإِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : \" ذَلِكَ كِفْلُ الشَّيْطَانِ , يَقُولُ : مَقْعَدُ الشَّيْطَانِ يَعْنِي مَغْرِزَ ضَفْرَتِهِ ""","","","","","Book of Prayer"
"2908","عَنِ الثَّوْرِيِّ , عَنْ أَبِي هَاشِمٍ الْوَاسِطِيِّ , عَنْ مُجَاهِدٍ , قَالَ : \" مَرَّ عُمَرُ بْنُ الْخَطَّابِ عَلَى ابْنٍ لَهُ وَهُوَ يُصَلِّي وَرَأْسُهُ مَعْقُوصٌ فَجَبَذَهُ حَتَّى صَرَعَهُ ""","","","","","Book of Prayer"
"2909","عَنِ الْحَسَنِ بْنِ عُمَارَةَ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لا تَعْقِصْ شَعْرَكَ فِي الصَّلاةِ , فَإِنَّهُ كِفْلُ الشَّيْطَانِ ""","","","","","Book of Prayer"
"2910","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ : \" يُكْرَهُ أَنْ يُصَلِّيَ الرَّجُلُ وَرَأْسُهُ مَعْقُوصٌ , أَوْ يَعْبَثَ بِالْحَصَى , أَوْ يَتْفُلَ قِبَلَ وَجْهِهِ , أَوْ عَنْ يَمِينِهِ ""","","","","","Book of Prayer"
"2911","عَنِ الثَّوْرِيِّ , عَنْ أَبِي هَاشِمٍ الْوَاسِطِيِّ , عَنْ مُجَاهِدٍ , قَالَ : \" مَرَّ حُذَيْفَةُ بِابْنِهِ وَهُوَ يُصَلِّي , وَلَهُ ضَفْرَتَانِ قَدْ عَقَصَهُمَا , فَدَعَا بِشَفْرَةٍ فَقَطَعَ بِإِحْدَاهُمَا , ثُمَّ قَالَ : إِنْ شِئْتَ فَاصْنَعِ الأُخْرَى كَذَا , وَإِنْ شِئْتَ فَدَعْهَا ""","","","","","Book of Prayer"
"2912","عَنْ مَعْمَرٍ , وَالثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ زَيْدِ بْنِ وَهْبٍ , قَالَ : مَرَّ عَبْدُ اللَّهِ بْنُ مَسْعُودٍ عَلَى رَجُلٍ سَاجِدٍ وَرَأْسُهُ مَعْقُوصٌ , فَحَلَّهُ , فَلَمَّا انْصَرَفَ , قَالَ لَهُ عَبْدُ اللَّهِ : \" لا تَعْقِصْ , فَإِنَّ شَعْرَكَ يَسْجُدُ , وَإِنَّ لِكُلِّ شَعْرَةٍ أَجْرًا \" , قَالَ : إِنَّمَا عَقَصْتُهُ لِكَيْ لا يَتَتَرَّبَ , قَالَ : \" أَنْ يَتَتَرَّبَ خَيْرٌ لَكَ ""","","","","","Book of Prayer"
"2913","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَأَى رَجُلا يَسْجُدُ وَيَتَّقِي شَعْرَهُ بِيَدِهِ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : اللَّهُمَّ امْحُ شَعْرَهُ , قَالَ : فَسَقَطَ شَعْرُهُ , عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ مِثْلَهُ , إِلا أَنَّ قَتَادَةَ , قَالَ : صَلِعَ رَأْسُهُ","","","","","Book of Prayer"
"2914","حُدِّثْتُ أَنَّ ابْنَ عَبَّاسٍ , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أُمِرْتُ أَنْ لا أَكُفَّ شَعْرًا , وَلا ثَوْبًا \" , قَالَ : لا يَكُفُّ الشَّعْرَ عَنِ الأَرْضِ","","","","","Book of Prayer"
"2915","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ : أُصَلِّي فِي المَطَرِ فِي سَاجٍ لِي , وَالْمَاءُ يَسِيلُ بِجَنْبِي ؟ , قَالَ : \" لا تَكُفَّهُ \" , قَالَ : إِذًا يَفْسُدَ , قَالَ : \" وَلَوْ , دَعْهُ فِي الْمَاءِ \" , قَالَ عَبْدُ الرَّزَّاقِ : \" وَلا نَأْخُذُ بِهِ ""","","","","","Book of Prayer"
"2916","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : نَزْعُ الرَّجُلِ رِدَاءَهُ مِنْ تَحْتِهِ , ثُمَّ لا يَرَفَعُهُ مِنَ الأَرْضِ أَكَفٌّ هُوَ بِإِنْزَاعِهِ ؟ قَالَ : \" لا بَأْسَ إِذَا جَلَسَ , إِنَّمَا ذَلِكَ فِي السُّجُودِ ""","","","","","Book of Prayer"
"2917","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ لَهُ : الرَّجُلُ يَكُفُّ شَعْرَهُ لِغَيْرِ صَلاةٍ , ثُمَّ يُقَامُ الصَّلاةُ , قَالَ : \" لِيَنْشُرْ رَأْسَهُ وَلْيُرْخِهِ ""","","","","","Book of Prayer"
"2918","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الرَّجُلُ مِنْ أَهْلِ الْبَادِيَةِ يَكُفُّ أَحَدُهُمْ شَعْرَهُ الْحِينَ الطَّوِيلَ , مِنْ أَجْلِ قِيَامِهِ فِي مَاشِيَتِهِ وَعَمَلِهِ , قَالَ : \" لا بَأْسَ إِنَّمَا يَكُفُّ هَذَا مِنْ أَجْلِ عَمَلِهِ , وَإِنَّمَا نُهِيَ عَنْ كَفِّ الشَّعْرِ لِلصَّلاةِ ""","","","","","Book of Prayer"
"2919","عَنِ ابْنِ جُرَيْجٍ , 5 قَالَ : قُلْتُ لِعَطَاءٍ : هَلْ يُخْشَى أَنْ يَكُونَ الْعِمَامَةُ كَفًّا لِشَعْرٍ ؟ , قال : \" إِنَّمَا يَصِيرُ ذَلِكَ إِلَى النِّيَّةِ ""","","","","","Book of Prayer"
"2920","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : يَضْفِرُ الرَّجُلُ قَرْنَيْهِ ؟ , قَالَ : \" لا بَأْسَ , إِنَّ ذَلِكَ يَكُونُ لِغَيْرِ كَفِّهِ لِلصَّلاةِ , الْعَمَائِمُ , وَضَفْرُ الْقَرْنَيْنِ ""","","","","","Book of Prayer"
"2921","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" مَا أُحِبُّ أَنْ يَجْعَلَ ذُو الْقَرْنَيْنِ ضَفْرَتَيْهِ إِذَا طَالَتَا عَلَى ظَهْرِهِ \" , قَالَ : فَأَيْنَ ؟ , قَالَ : \" عَلَى صَدْرِهِ ""","","","","","Book of Prayer"
"2922","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" أَرَأَيْتَ لَوْ وَضَعْتُ ذِرَاعَيَّ عَلَى الأَرْضِ , وَكَفَفْتُ شَعْرِي وَثَوْبِي ؟ , قَالَ : فَلا تُعِدْ , وَلا تَسْجُدْ سَجْدَتَيِ السَّهْوِ ""","","","","","Book of Prayer"
"2923","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قال : \" يَرْفَعُ رَأْسَهُ مِنَ السُّجُودِ , ثُمَّ يَجْلِسُ حَتَّى يَقَرَّ كُلُّ شَيْءٍ مِنْهُ قَرَارَهُ ""","","","","","Book of Prayer"
"2924","أَخْبَرَنَا مَعْمَرٌ , عَنْ ثَابِتٍ الْبُنَانِيِّ , عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رُبَّمَا رَفَعَ رَأْسَهُ مِنَ السَّجْدَةِ وَالرَّكْعَةِ , فَيَمْكُثُ بَيْنَهُمَا حَتَّى يَقُولَ : الشَّيْءَ ""","","","","","Book of Prayer"
"2925","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , أَنَّهُ كَانَ يَقُولُ بَيْنَ السَّجْدَتَيْنِ : رَبِّ اغْفِرْ لِي , وَارْحَمْنِي , وَاجْبُرْنِي , وَارْزُقْنِي \" , وَبِهِ يَأْخُذُ عَبْدُ الرَّزَّاقِ","","","","","Book of Prayer"
"2926","عَنْ سَعِيدِ بْنِ عَبْدِ الْعَزِيزِ , أَنَّهُ سَمِعَ مَكْحُولا , يَقُولُ بَيْنَ السَّجْدَتَيْنِ : اللَّهُمَّ اغْفِرْ لِي , وَارْحَمْنِي , وَاهْدِنِي , وَارْزُقْنِي , وَاجْبُرْنِي ""","","","","","Book of Prayer"
"2927","عَنِ ابْنِ جُرَيْجٍ , وَمَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , قال : \" رَأَيْتُ أَبِي يَمْكُثُ بَيْنَ السَّجْدَتَيْنِ ""","","","","","Book of Prayer"
"2928","عَنِ ابْنِ عُيَيْنَةَ , عَنِ ابْنِ طَاوُسٍ , قال : كَانَ أَبِي يَقْرَأُ بَيْنَ السَّجْدَتَيْنِ قُرْآنًا كَثِيرًا ""","","","","","Book of Prayer"
"2929","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , قَالَ : قُلْتُ لإِبْرَاهِيمَ : تَقُولُ بَيْنَ السَّجْدَتَيْنِ شَيْئًا ؟ , قَالَ : \" مَا أَقُولُ بَيْنَهُمَا شَيْئًا ""","","","","","Book of Prayer"
"2930","عَنْ عُثْمَانَ بْنِ مَطَرٍ , عَنْ حُسَيْنٍ الْمُعَلِّمِ , عَنْ بُدَيْلٍ الْعُقَيْلِيِّ , عَنْ أَبِي الْجَوْزَاءِ , عَنْ عَائِشَةَ , قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا رَفَعَ رَأْسَهُ مِنَ السَّجْدَةِ لَمْ يَسْجُدْ حَتَّى يَسْتَوِيَ جَالِسًا , أَوْ قَالَ : قَاعِدًا ""","","","","","Book of Prayer"
"2931","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ : \" أَنَّهُ كَانَ يَكْرَهُ النَّفْخَ فِي الصَّلاةِ ""","","","","","Book of Prayer"
"2932","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , قَالَ \" ثَلاثُ نَفْخَاتٍ يُكْرَهْنَ حَيْثُ يَسْجُدُ , وَنَفْخَةٌ فِي الشَّرَابِ , وَنَفْخَةٌ فِي الطَّعَامِ ""","","","","","Book of Prayer"
"2933","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَمَّنْ سَمِعَ ابْنَ عَبَّاسٍ , يَقُولُ : \" مَنْ نَفَخَ فِي الصَّلاةِ فَقَدْ تَكَلَّمَ ""","","","","","Book of Prayer"
"2934","عَنِ ابْنِ عُيَيْنَةَ , عَنِ الأَعْمَشِ , عَنْ مُسْلِمِ بْنِ صُبَيْحٍ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" النَّفْخُ فِي الصَّلاةِ بِمَنْزِلَةِ الْكَلامِ ""","","","","","Book of Prayer"
"2935","عَنْ قَيْسِ بْنِ الرَّبِيعِ , عَنْ أَبِي حَصِينٍ , عَنْ أَبِي صَالِحٍ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : \" النَّفْخُ فِي الصَّلاةِ كَلامٌ ""","","","","","Book of Prayer"
"2936","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ صَالِحٍ مَوْلَى التَّوْأَمَةِ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : \" لا يَنْفُخُ أَحَدُكُمْ فِي صَلاتِهِ ""","","","","","Book of Prayer"
"2937","عَنْ قَيْسِ بْنِ الرَّبِيعِ , عَنْ أَبِي حَصِينٍ , قَالَ : سَمِعْتُ إِبْرَاهِيمَ النَّخَعِيَّ , وَسَعِيدَ بْنَ جُبَيْرٍ , يَقُولانِ : \" النَّفْخُ فِي الصَّلاةِ كَلامٌ ""","","","","","Book of Prayer"
"2938","عَنْ أَبِي حَصِينٍ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قال : \" مَا أُبَالِي نَفَخْتُ أَوْ تَكَلَّمْتُ ""","","","","","Book of Prayer"
"2939","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , قال : \" كَانُوا يَكْرَهُونَ النَّفْخَ , لأَنَّهُ يُؤْذِي جَلِيسَهُ ""","","","","","Book of Prayer"
"2940","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ عَطَاءً الْخُرَاسَانِيَّ , وَأَيُّوبَ , عَنِ الرَّجُلِ يُقْعِي إِذَا رَفَعَ رَأْسَهُ مِنَ الْمَسْجِدِ حَتَّى يَسْجُدَ الأُخْرَى , فَقَالَ أَيُّوبُ : \" كَانَ الْحَسَنُ وَابْنُ سِيرِينَ لا يُقْعِيَانِ \" , قَالَ عَطَاءٌ : \" كَذَلِكَ كُنَّا نَسْمَعُ حَتَّى جَاءَنَا أَهْلُ مَكَّةَ بِغَيْرِ ذَلِكَ ""","","","","","Book of Prayer"
"2941","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" إِذَا صَلَّى أَحَدُكُمْ فَلا يُقْعِيَنَّ إِقْعَاءَ الْكَلْبِ ""","","","","","Book of Prayer"
"2942","عَنْ مَعْمَرٍ , وَابْنِ جُرَيْجٍ , عَنِ ابْنِ خُثَيْمٍ , عَنِ ابْنِ لَبِيبَةَ , أَنَّ أَبَا هُرَيْرَةَ , قَالَ لَهُ : \" إِيَّاكَ وَحَبْوَةَ الْكَلْبِ وَالإِقْعَاءَ , وَتَحَفَّظْ مِنَ السَّهْوِ حَتَّى تَفْرُغَ مِنَ الْمَكْتُوبَةِ ""","","","","","Book of Prayer"
"2943","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ : \" الإِقْعَاءُ عَقَبَةُ الشَّيْطَانِ ""","","","","","Book of Prayer"
"2944","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ : \" أَنَّهُ كَانَ يَكْرَهُ الإِقْعَاءَ وَالتَّوَرُّكَ ""","","","","","Book of Prayer"
"2945","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ : \" أَنَّهُ رَأَى ابْنَ عُمَرَ , وَابْنَ الزُّبَيْرِ , وَابْنَ عَبَّاسٍ يُقْعُونَ بَيْنَ السَّجْدَتَيْنِ ""","","","","","Book of Prayer"
"2946","عَنِ الثَّوْرِيِّ , عَنْ لَيْثٍ , عَنْ طَاوُسٍ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" مِنَ السُّنَّةِ أَنْ يَمَسَّ عَقِبُكَ إِلْيَتَيْكَ فِي الصَّلاةِ بَيْنَ السَّجْدَتَيْنِ ""","","","","","Book of Prayer"
"2947","عَنْ عَمْرِو بْنِ حَوْشَبٍ , قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ أَبِي يَزِيدَ , \" أَنَّهُ رَأَى عُمَرَ , وَابْنَ عُمَرَ يُقْعِيَانِ بَيْنَ السَّجْدَتَيْنِ ""","","","","","Book of Prayer"
"2948","عَنْ عَمْرِو بْنِ حَوْشَبٍ , قَالَ : أَخْبَرَنِي عِكْرِمَةُ , أَنَّهُ سَمِعَ ابْنَ عَبَّاسٍ , يَقُولُ : \" الإِقْعَاءُ فِي الصَّلاةِ هُوَ السُّنَّةُ ""","","","","","Book of Prayer"
"2949","عَنِ ابْنِ عُيَيْنَةَ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , عَنْ طَاوُسٍ , قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ , يَقُولُ : \" مِنَ السُّنَّةِ أَنْ يَمَسَّ عَقِبُكَ إِلْيَتَيْكَ ""","","","","","Book of Prayer"
"2950","قَالَ : قَالَ طَاوُسٌ : \" وَرَأَيْتُ الْعَبَادِلَةَ يُقْعُونَ ابْنَ عُمَرَ , وَابْنَ عَبَّاسٍ , وَابْنَ الزُّبَيْرِ","","","","","Book of Prayer"
"2951","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ , أَنَّهُ رَأَى ابْنَ عُمَرَ يَفْعَلُ فِي السَّجْدَةِ الأُولَى مِنَ الشَّفْعِ وَالوِتْرِ خَصْلَتَيْنِ , قَالَ : \" رَأَيْتُهُ يُقْعِي مَرَّةً إِقْعَاءً جَاثِيًا عَلَى أَطْرَافِ قَدَمَيْهِ جَمِيعًا , وَمَرَّةً يَثْنِي رِجْلَهُ الْيُسْرَى فَيَبْسُطُهَا جَالِسًا عَلَيْهَا , وَالْيُمْنَى يَقُومُ عَلَيْهَا يَحْدِبُهَا عَلَى أَطْرَافِ قَدَمَيْهِ جَمِيعًا \" , قَالَ : \" رَأَيْتُهُ يَصْنَعُ ذَلِكَ فِي السَّجْدَةِ الأُولَى مِنَ السَّجْدَتَيْنِ , وَفِي السَّجْدَةِ الثَّالِثَةِ مِنَ الْوِتْرِ , ثُمَّ يَثْبُتُ فَيَقُومُ ""","","","","","Book of Prayer"
"2952","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ , أَنَّهُ سَمِعَ طَاوُسًا , يَقُولُ : قُلْنَا لابْنِ عَبَّاسٍ فِي الإِقْعَاءِ عَلَى الْقَدَمَيْنِ ؟ , قَالَ : \" هِيَ السُّنَّةُ \" , فَقُلْنَا : إِنَّا لَنَرَاهُ جَفَاءً بِالرَّجُلِ , قَالَ ابْنُ عَبَّاسٍ : \" بَلْ هِيَ سُنَّةُ نَبِيِّكَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Prayer"
"2953","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قال : \" سَأَلْتُهُ عَنِ الْجُلُوسِ فِي الصَّلاةِ فِي مَثْنَى , قَالَ : يَثْنِي الْيُسْرَى تَحْتَ الْيُمْنَى ""","","","","","Book of Prayer"
"2954","عَنِ الثَّوْرِيِّ , عَنِ الزُّبَيْرِ , عَنْ إِبْرَاهِيمَ , قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَفْتَرِشُ رِجْلَهُ الْيُسْرَى حَتَّى يُرَى ظَاهِرُهَا أَسْوَدَ ""","","","","","Book of Prayer"
"2955","عَنِ الثَّوْرِيِّ , عَنْ عَاصِمِ بْنِ كُلَيْبٍ , عَنْ أَبِيهِ , عَنْ وَائِلِ بْنِ حُجْرٍ , قَالَ : \" رَمَقْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الصَّلاةِ , فَلَمَّا جَلَسَ افْتَرَشَ رِجْلَهُ الْيُسْرَى ""","","","","","Book of Prayer"
"2956","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : \" رَأَيْتُ ابْنَ عُمَرَ يَجْلِسُ فِي مَثْنَى , يَجْلِسُ عَلَى يُسْرَاهُ فَيَبْسُطُهَا جَالِسًا عَلَيْهَا , وَيُقْعِي عَلَى أَصَابِعِ يُمْنَاهُ جَاثِيًا عَلَيْهَا , تَأْتِيهَا وَرَاءَهُ عَلَى كُلِّ أَصَابِعِهَا \" , عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ , عَنِ ابْنِ عُمَرَ , مِثْلَ خَبَرِ عَطَاءٍ","","","","","Book of Prayer"
"2957","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , قَالَ : تَرَبَّعَ ابْنُ عُمَرَ فِي صَلاتِهِ , فَقَالَ : \" إِنَّهَا لَيْسَتْ مِنْ سُنَّةِ الصَّلاةِ , وَلَكِنِّي أَشْتَكِي رِجْلِي ""","","","","","Book of Prayer"
"2958","عَنِ ابْنِ جُرَيْجٍ , قال : \" سَمِعْتُ رَجُلا يَسْأَلُ عَطَاءً : أَكَانَ يُسْتَحَبُّ أَنْ يَجْلِسَ الْمَرْءُ عَلَى يُسْرَى رِجْلَيْهِ فِي الصَّلاةِ ؟ , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"2959","عَنْ مَالِكٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ , عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُمَرَ , قَالَ : صَلَّى ابْنُ عُمَرَ فَتَرَبَّعَ , فَفَعَلْتُ ذَلِكَ وَأَنَا حَدِيثُ السِّنِّ , فَقَالَ : \" وَلِمَ تَفْعَلُ ذَلِكَ ؟ \" , قَالَ : قُلْتُ : فَإِنَّكَ تَفْعَلُهُ , قَالَ : \" إِنَّهَا لَيْسَتْ مِنْ سُنَّةِ الصَّلاةِ , وَلَكَنْ سُنَّةَ الصَّلاةِ أَنْ تَثْنِيَ الْيُسْرَى وَتَنْصِبَ الْيُمْنَى , قَالَ : وَقَالَ عَبْدُ اللَّهِ : \" إِنِّي لا يَحْمِلُنِي رِجْلايَ ""","","","","","Book of Prayer"
"2960","عَنْ مَالْكَ , عَنْ صَدَقَةَ بْنِ يَسَارٍ , عَنِ الْمُغِيرَةِ بْنِ حَكِيمٍ , أَنَّهُ رَأَى ابْنَ عُمَرَ تَرَبَّعَ فِي سَجْدَتَيْنِ مِنَ الصَّلاةِ عَلَى صُدُورِ قَدَمَيْهِ , فَذَكَرَ ذَلِكَ لَهُ , فَقَالَ : \" إِنَّهَا لَيْسَتْ مِنْ سُنَّةِ الصَّلاةِ , وَلَكِنِّي أَفْعَلُ ذَلِكَ مِنْ أَجْلِ أَنِّي أَشْتَكِي ""","","","","","Book of Prayer"
"2961","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ , عَنْ أَبِيهِ , قال : \" السُّنَّةُ فِي الْجُلُوسِ فِي الصَّلاةِ أَنْ تَثْنِيَ الْيُسْرَى وَتُقْعِيَ بِالْيُمْنَى ""","","","","","Book of Prayer"
"2962","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنِ ابْنِ طَلْحَةَ , عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ , عَنْ أَبِي حُمَيْدٍ السَّاعِدِيِّ : \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا جَلَسَ فِي الصَّلاةِ فِي الرَّكْعَتَيْنِ الأُولَيَيْنِ نَصَبَ قَدَمَهُ الْيُمْنَى , وَافْتَرَشَ الْيُسْرَى , وَأَشَارَ بِإِصْبَعِهِ الَّتِي تَلِي الإِبْهَامَ , وَإِذَا جَلَسَ فِي الأُخْرَيَيْنِ أَفْضَى بِمِقْعَدَتِهِ إِلَى الأَرْضِ , وَنَصَبَ قَدَمَهُ الْيُمْنَى ""","","","","","Book of Prayer"
"2963","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ كَانَ يَفْتَرِشُ رِجْلَهُ الْيُسْرَى وَيُقْعِي بِالْيُمْنَى \" , قَالَ : \" وَكَانَ الْحَسَنُ يَفْتَرِشُ الْيُمْنَى لِلْيُسْرَى ""","","","","","Book of Prayer"
"2964","عَنْ مَالِكٍ , وَابْنِ عُيَيْنَةَ , عَنْ مُسْلِمِ بْنِ أَبِي مَرْيَمَ , عَنْ عَلِيِّ بْنِ عَبْدِ الرَّحْمَنِ الأَنْصَارِيِّ , قَالَ : صَلَّيْتُ إِلَى جَنْبِ ابْنِ عُمَرَ , وَإِنِّي أُقَلِّبُ الْحَصَى فِي الصَّلاةِ , فَلَمَّا فَرَغَ , قَالَ \" إِنَّ تَقْلِيبَ الْحَصَى فِي الصَّلاةِ مِنَ الشَّيْطَانِ , وَلَكِنْ كَمَا كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَصْنَعُ إِذَا جَلَسَ فِي الصَّلاةِ وَضَعَ كَفَّهُ الْيُسْرَى عَلَى فَخِذِهِ الْيُسْرَى , وَوَضَعَ كَفَّهُ الْيُمْنَى عَلَى فَخِذِهِ الْيُمْنَى , وَقَبَضَ أَصَابِعَهُ وَأَشَارَ بِإِصْبَعِهِ الَّتِي تَلِي الإِبْهَامَ ""","","","","","Book of Prayer"
"2965","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي خَالِدٌ , قَالَ : بَلَغَنِي عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , \" أَنَّهُ كَانَ إِذَا جَلَسَ فِي مَثْنَى تَبَطَّنَ الْيُسْرَى فَجَلَسَ عَلَيْهَا , جَعَلَ قَدَمَهُ تَحْتَ إِلْيَتِهِ حَتَّى اسْوَدَّ بِالْبَطْحَاءِ ظَهْرُ قَدَمِهِ ""","","","","","Book of Prayer"
"2966","عَنْ عُثْمَانَ بْنِ مَطَرٍ , عَنِ الْحُسَيْنِ الْمُعَلِّمِ , عَنْ بُدَيْلٍ الْعُقَيْلِيِّ , عَنْ أَبِي الْجَوْزَاءِ , عَنْ عَائِشَةَ , قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَفْتَرِشُ رِجْلَهُ , أَوْ قَالَ : قَدَمَهُ الْيُسْرَى لِلْيُمْنَى \" , قَالَ : \" وَكَانَتْ تَنْهَانَا عَنْ عَقِبِ الشَّيْطَانِ ""","","","","","Book of Prayer"
"2967","عَنِ ابْنِ جُرَيْجٍ , قَالَ : كَانَ عَطَاءٌ يَشْتَكِي رِجْلَهُ الْيُسْرَى , فَكَانَ يُخْرِجُ الْيُمْنَى وَشِمَالُهُ مَقْبُوضَةٌ , فَيَقْبِضُهَا قَائِمَةً , فَقُلْتُ : أَلا تَتَرَبَّعُ ؟ , قَالَ : \" أَكْرَهُ ذَلِكَ \" , قُلْتُ : أَرَأَيْتَ لَوْ تَرَبَّعْتُ أَوْ بَسَطْتُ رِجْلِي أَمَامِي فِي الصَّلاةِ ؟ , قَالَ : \" اسْجُدْ سَجْدَتَيِ السَّهْوِ ""","","","","","Book of Prayer"
"2968","عَنِ الثَّوْرِيِّ , وَابْنِ عُيَيْنَةَ , عَنْ حُصَيْنٍ , عَنْ هَيْثَمِ بْنِ شِهَابٍ , قَالَ : قَالَ عَبْدُ اللَّهِ : \" لأَنْ أَجْلِسَ عَلَى رَضْفَيْنِ خَيْرٌ مِنْ أَنْ أَجْلِسَ فِي الصَّلاةِ مُتَرَبِّعًا ""","","","","","Book of Prayer"
"2969","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَتَتَرَبَّعُ بَيْنَ الرَّكْعَتَيْنِ وَأَنْتَ شَابٌّ ؟ , قَالَ : \" نَعَمْ \" , قُلْتُ : أُرِيدُ أَنْ أَتَرَبَّعَ قَبْلَ التَّشَهُّدِ , قَالَ : \" فَلا تَفْعَلْ حَتَّى تَشَهَّدَ , فَإِذَا شَهَّدْتَ فَتَرَبَّعْ , أَوِ احْتَبِ , أَوِ اصْنَعْ مَا شِئْتَ , فَإِنْ فَعَلْتَ قَبْلَ التَّشَهُّدِ فِي الْمَكْتُوبَةِ فَاسْجُدْ سَجْدَتَيِ السَّهْوِ , فَأَمَّا فِي التَّطَوُّعِ فَإِنْ فَعَلْتَهُ فَلا تَسْجُدْ \" , قَالَ : \" وَأَحَبُّ إِلَيَّ أَنْ تَتَشَهَّدَ مُتَبَطِّنًا يَسَارَكَ تَحْتَكَ , وَنَاصِبًا الأُخْرَى مُقْعِيًا عَلَيْهَا , أَصَابِعُهَا فِي التُّرَابِ , كَجُلُوسِ ابْنِ عُمَرَ \" , قُلْتُ : فَأَضَعُ يَدِي الْيُسْرَى كَذَلِكَ قَبْلَ التَّشَهُّدِ ؟ , قَالَ : \" لا , وَلا أُحِبُّ ذَلِكَ ""","","","","","Book of Prayer"
"2970","عَنْ مَعْمَرٍ , عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , قَالَ : \" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يَجْلِسَ الرَّجُلُ فِي الصَّلاةِ وَهُوَ مُعْتَمِدٌ عَلَى يَدَيْهِ ""","","","","","Book of Prayer"
"2971","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ , أَنَّ ابْنَ عُمَرَ رَأَى رَجُلا جَالِسًا مُعْتَمِدًا عَلَى يَدَيْهِ , فَقال : \" مَا يُجْلِسُكَ فِي صَلاتِكَ جُلُوسَ الْمَغْضُوبِ عَلَيْهِمْ ؟ ""","","","","","Book of Prayer"
"2972","عَنِ ابْنِ عُيَيْنَةَ , عَنْ مُحَمَّدِ بْنِ عَجْلانَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ : أَنَّهُ رَأَى رَجُلا جَالِسًا مُعْتَمِدًا بِيَدِهِ عَلَى الأَرْضِ , فَقَالَ : \" إِنَّكَ جَلَسْتَ جِلْسَةَ قَوْمٍ عُذِّبُوا ""","","","","","Book of Prayer"
"2973","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِبْرَاهِيمُ بْنُ مَيْسَرَةَ , أَنَّهُ سَمِعَ عَمْرَو بْنَ الشَّرِيدِ , يُخْبِرُ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , أَنَّهُ كَانَ يَقُولُ فِي وَضْعِ الرَّجُلِ شِمَالَهُ إِذَا جَلَسَ فِي الصَّلاةِ : \" هِيَ قَعْدَةُ الْمَغْضُوبِ عَلَيْهِمْ ""","","","","","Book of Prayer"
"2974","عَنِ الثَّوْرِيِّ , عَنْ دَاوُدَ , عَنْ أَبِي الْعَالِيَةِ , قَالَ : سَمِعَ ابْنُ عَبَّاسٍ رَجُلا حِينَ جَلَسَ فِي الصَّلاةِ , يَقُولُ : \" الْحَمْدُ لِلَّهِ قَبْلَ التَّشَهُّدِ , فَانْتَهَرَهُ , يَقُولُ : ابْتَدِئْ بِالتَّشَهُّدِ ""","","","","","Book of Prayer"
"2975","عَنِ ابْنِ جُرَيْجٍ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , قَالَ : سَمِعْتُ طَاوُسًا , يَقُولُ : \" لا أَعْلَمُ بَعْدَ الرَّكْعَتَيْنِ إِلا التَّشَهُّدَ ""","","","","","Book of Prayer"
"2976","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" الْمَثْنَى الأُولَى , إِنَّمَا هُوَ لِلتَّشَهُّدِ , وَإِنَّ الآخِرَ لِلدُّعَاءِ وَالرَّغْبَةِ , وَالآخَرُ أَطْوَلُهُمَا ""","","","","","Book of Prayer"
"2977","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , وَمَنْصُورٍ , وَحُصَيْنٍ , وَالأَعْمَشِ , وَأَبِي هِشَامٍ , عَنْ أَبِي وَائِلٍ , وَعَنْ أَبِي إِسْحَاقَ , عَنِ الأَسْوَدِ , وَأَبِي الأَحْوَصِ , عَنْ عَبْدِ اللَّهِ , قَالَ : كُنَّا لا نَدْرِي , مَا نَقُولُ فِي الصَّلاةِ , فَكُنَّا نَقُولُ : السَّلامُ عَلَى اللَّهِ , السَّلامُ عَلَى جِبْرِيلَ , السَّلامُ عَلَى مِيكَائِيلَ , فَعَلَّمَنَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ : \" لا تَقُولُوا السَّلامُ عَلَى اللَّهِ , إِنَّ اللَّهَ هُوَ السَّلامُ , فَإِذَا جَلَسْتُمْ فِي رَكْعَتَيْنِ , فَقُولُوا : التَّحِيَّاتُ لِلَّهِ وَالصَلَوَاتُ وَالطَّيِّبَاتُ , السَّلامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ , السَّلامُ عَلَيْنَا وَعَلَى عِبَادِ اللَّهِ الصَّالِحِينَ ,  قَالَ أَبُو وَائِلٍ فِي حَدِيثِ عَبْدِ اللَّهِ : عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا قُلْتَهَا أَصَابَتْ كُلَّ عَبْدٍ صَالِحٍ فِي السَّمَاءِ وَفِي الأَرْضِ , وَقَالَ أَبُو إِسْحَاقَ فِي حَدِيثِ عَبْدِ اللَّهِ : إِذَا قُلْتَهَا أَصَابَتْ كُلَّ مَلَكٍ مُقَرَّبٍ أَوْ نَبِيٍّ مُرْسَلٍ أَوْ عَبْدٍ صَالِحٍ , أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ , وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ ""","","","","","Book of Prayer"
"2978","أَخْبَرَنِي أَبِي , عَنْ إِبْرَاهِيمَ , قَالَ : جَاءَ رَبِيعُ بْنُ خُثَيْمٍ , إِلَى عَلْقَمَةَ يَسْتَشِيرُهُ أَنْ يَزِيدَ فِيهَا : وَمَغْفِرَتُهُ , قَالَ عَلْقَمَةُ : \" إِنَّمَا نَنْتَهِي إِلَى مَا عَلِمْنَاهُ ""","","","","","Book of Prayer"
"2979","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ أَبِي الأَحْوَصِ , عَنِ ابْنِ مَسْعُودٍ , قَالَ : إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عُلِّمَ فَوَاتِحَ الْخَيْرِ وَجَوَامِعَهُ أَوْ جَوَامِعَ الْخَيْرِ وَخَوَاتِمَهُ , وَإِنَّا كُنَّا لا نَدْرِي مَا نَقُولُ فِي صَلاتِنَا حَتَّى عَلَّمَنَا , قَالَ : \" قُولُوا : التَّحِيَّاتُ لِلَّهِ وَالصَلَوَاتُ وَالطَّيِّبَاتُ , السَّلامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ , السَّلامُ عَلَيْنَا وَعَلَى عِبَادِ اللَّهِ الصَّالِحِينَ , أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ , وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ ""","","","","","Book of Prayer"
"2980","عَنْ مَعْمَرٍ , عَنْ عَاصِمِ بْنِ أَبِي النَّجُودِ , عَنْ زِرِّ بْنِ حُبَيْشٍ , عَنْ شَقِيقِ بْنِ سَلَمَةَ , عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ , قَالَ : كُنَّا نُصَلِّي مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَكَانَ النَّاسُ , يَقُولُونَ : السَّلامُ عَلَى اللَّهِ , السَّلامُ عَلَى جِبْرِيلَ , السَّلامُ عَلَى مِيكَائِيلَ , السَّلامُ عَلَى الْمَلائِكَةِ الْمُقَرَّبِينَ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لا تَقُولُوا : السَّلامُ عَلَى اللَّهِ , فَإِنَّ اللَّهَ هُوَ السَّلامُ \" , قَالَ : فَعَلَّمَهُمُ التَّشَهُّدَ , فَقَالَ : \" قُولُوا : التَّحِيَّاتُ لِلَّهِ وَالصَلَوَاتُ وَالطَّيِّبَاتُ , السَّلامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ , السَّلامُ عَلَيْنَا وَعَلَى عِبَادِ اللَّهِ الصَّالِحِينَ , أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ , وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ ""","","","","","Book of Prayer"
"2981","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنْ يُونُسَ بْنِ جُبَيْرٍ , عَنْ حِطَّانَ بْنِ عَبْدِ اللَّهِ الرَّقَاشِيِّ , أَنَّ أَبَا مُوسَى صَلَّى بِأَصْحَابِهِ صَلاةً , قَالَ : فَلَمَّا جَلَسَ , قَالَ رَجُلٌ مِنَ الْقَوْمِ : أُقِرَّتِ الصَّلاةُ بِالْبِرِّ وَالزَّكَاةُ , قَالَ : فَلَمَّا فَرَغَ أَبُو مُوسَى مِنْ صَلاتِهِ , قَالَ : أَيُّكُمُ الْقَائِلُ كَلِمَةَ هَذَا وَكَذَا ؟ فَأَرَّمَ الْقَوْمُ , فَقَالَ أَبُو مُوسَى : يَا حِطَّانُ , لَعَلَّكَ قَائِلُهَا ؟ , قَالَ : قُلْتُ : لا وَاللَّهِ مَا قُلْتُهَا , وَلَقَدْ خَشِيتُ أَنْ تَبْكَعَنِي لَهَا , فَقَالَ رَجُلٌ مِنَ الْقَوْمِ أَنَا قَائِلُهَا , وَمَا أَرَدْتُ بِهَا إِلا الْخَيْرَ , فَقَالَ أَبُو مُوسَى : أَمَا تَعْلَمُونَ كَيْفَ صَلاتُكُمْ ؟ , إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَطَبَنَا , فَبَيَّنَ لَنَا سُنَنًا , وَعَلَّمَنَا صَلاتَنَا , فَقَالَ : \" إِذَا صَلَّيْتُمْ فَأَقِيمُوا صُفُوفَكُمْ , ثُمَّ لِيَؤُمَّكُمْ أَحَدُكُمْ , فَإِذَا كَبَّرَ فَكَبِّرُوا , وَإِذَا قَالَ :  غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ , فَقُولُوا : آمِينَ يُجِبْكُمُ اللَّهُ , وَإِذَا كَبَّرَ وَرَكَعَ فَكَبِّرُوا وَارْكَعُوا , فَإِنَّ الإِمَامَ يَرْكَعُ قَبْلَكُمْ وَيَرْفَعُ قَبْلَكُمْ \" , قَالَ نَبِيُّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" فَتِلْكَ بِتِلْكَ , وَإِذَا قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , فَقُولُوا : رَبَّنَا لَكَ الْحَمْدُ , يَسْمَعِ اللَّهُ لَكُمْ , فَإِنَّهُ قَضَى عَلَى لِسَانِ نَبِيِّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , فَإِذَا كَانَ عِنْدَ الْقُعُودِ فَلْيَقُلْ أَحَدُكُمْ أَوَّلَ مَا يَقْعُدُ : التَّحِيَّاتُ لِلَّهِ الطَّيِّبَاتُ , الصَلَوَاتُ لِلَّهِ , السَّلامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ , السَّلامُ عَلَيْنَا وَعَلَى عِبَادِ اللَّهِ الصَّالِحِينَ , أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ , وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ ""","","","","","Book of Prayer"
"2982","عَنْ مَعْمَرٍ , عَمَّنْ سَمِعَ الْحَسَنَ , يَقُولُ : \" التَّحِيَّاتُ لِلَّهِ الطَّيِّبَاتُ , الصَلَوَاتُ لِلَّهِ , السَّلامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ , السَّلامُ عَلَيْنَا وَعَلَى عِبَادِ اللَّهِ الصَّالِحِينَ , أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ , وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ ""","","","","","Book of Prayer"
"2983","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدٍ الْقَارِيِّ , قَالَ : شَهِدْتُ عُمَرَ بْنَ الْخَطَّابِ وَهُوَ يُعَلِّمُ التَّشَهُّدَ فَقَالَ : \" التَّحِيَّاتُ لِلَّهِ , الزَّاكِيَاتُ لِلَّهِ , الطَّيِّبَاتُ لِلَّهِ , السَّلامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ , السَّلامُ عَلَيْنَا وَعَلَى عِبَادِ اللَّهِ الصَّالِحِينَ , أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ , وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ \" , قَالَ عَبْدُ الرَّزَّاقِ : \" وَكَانَ مَعْمَرٌ يَأْخُذُ بِهِ , وَأَنَا آخُذُ بِهِ \" , عَنِ ابْنِ جُرَيْجٍ , عَنْ عُرْوَةَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدٍ الْقَارِيِّ , عَنْ عُمَرَ , مِثْلَ حَدِيثِ مَعْمَرٍ , إِلا أَنَّهُ قَالَ : وَرَحْمَةُ اللَّهِ , السَّلامُ عَلَيْنَا . عَنْ مَعْمَرٍ , عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ , مِثْلَ حَدِيثِ الزُّهْرِيِّ , إِلا أَنَّهُ كَانَ يَقُولُ فِي أَوَّلِهِ : \" بِسْمِ اللَّهِ خَيْرِ الأَسْمَاءِ , وَيَجْعَلُ مَكَانَ الزَّاكِيَاتِ الْمُبَارَكَاتِ ""","","","","","Book of Prayer"
"2984","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ , وَابْنَ الزُّبَيْرِ , يَقُولانِ فِي التَّشَهُّدِ فِي الصَّلاةِ : \" التَّحِيَّاتُ الْمُبَارَكَاتُ لِلَّهِ , الصَلَوَاتُ الطَّيِّبَاتُ لِلَّهِ , السَّلامُ عَلَى النَّبِيِّ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ , السَّلامُ عَلَيْنَا وَعَلَى عِبَادِ اللَّهِ الصَّالِحِينَ , أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ , وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ \" , قَالَ : \" لَقَدْ سَمِعْتُ ابْنَ الزُّبَيْرِ يَقُولُهُنَّ عَلَى الْمِنْبَرِ يُعَلِّمُهُنَّ النَّاسَ \" , قَالَ : \" وَلَقَدْ سَمِعْتُ ابْنَ عَبَّاسٍ يَقُولُهُنَّ كَذَلِكَ \" , قُلْتُ : فَلَمْ يَخْتَلِفْ فِيهَا ابْنُ عَبَّاسٍ وَابْنُ الزُّبَيْرِ ؟ , قَالَ : \" لا ""","","","","","Book of Prayer"
"2985","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ , عَنْ أَبِيهِ : \" أَنَّهُ كَانَ يَقُولُ فِي التَّشَهُّدِ : بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , التَّحِيَّاتُ الْمُبَارَكَاتُ وَالصَلَوَاتُ الطَّيِّبَاتُ لِلَّهِ , السَّلامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ , السَّلامُ عَلَيْنَا وَعَلَى عِبَادِ اللَّهِ الصَّالِحِينَ , أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ , وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ \" , قَالَ طَاوُسٌ فِي التَّشَهُّدِ : \" كَانَ يُعَلَّمُ كَمَا يُعَلَّمُ الْقُرْآنُ \" , عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي سُلَيْمَانُ الأَحْوَلُ , عَنْ طَاوُسٍ فِي التَّشَهُّدِ كَمَا أَخْبَرَنِي ابْنُ طَاوُسٍ , إِلا أَنَّهُ لَمْ يَجْعَلْ فِيهِ بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , قَالَ عَبْدُ الرَّحْمَنِ فَذَكَرْتُ ذَلِكَ لِسَعِيدِ ابْنِ جُبَيْرٍ , فَقَالَ : إِنَّ طَاوُسًا قَدْ رَجَعَ عَنْ بَعْضِهِ , فَعَرَّفْتُ ذَلِكَ طَاوُسًا فَأَنْكَرَ أَنْ يَكُونَ رَجَعَ عَنْ شَيْءٍ مِنْهُ , وَقَالَ : لَوْ أَنِّي لَمْ أَسْمَعْ عَبْدَ اللَّهِ بْنَ عَبَّاسٍ إِلا مَرَّةً أَوْ مَرَّتَيْنِ","","","","","Book of Prayer"
"2986","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِنَافِعٍ : كَيْفَ كَانَ ابْنُ عُمَرَ يَتَشَهَّدُ ؟ , فَقَالَ : كَانَ يَقُولُ : \" بِسْمِ اللَّهِ , التَّحِيَّاتُ لِلَّهِ , الصَلَوَاتُ لِلَّهِ , الزَّاكِيَاتُ لِلَّهِ , السَّلامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ , السَّلامُ عَلَيْنَا وَعَلَى عِبَادِ اللَّهِ الصَّالِحِينَ , ثُمَّ يَتَشَهَّدُ : شَهِدْتُ أَنْ لا إِلَهَ إِلا اللَّهُ , شَهِدْتُ أَنْ لا إِلَهَ إِلا اللَّهُ , شَهِدْتُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ يُوَالِي بِهِنَّ التَّسْلِيمَ ""","","","","","Book of Prayer"
"2987","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ : \" لا يُسَلِّمُ فِي الْمَثْنَى الأُولَى , كَانَ يَرَى ذَلِكَ فَسْخًا لِصَلاتِهِ \" , قَالَ الزُّهْرِيِّ : \" وَأَمَّا أَنَا فَأُسَلِّمُ ""","","","","","Book of Prayer"
"2988","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ : \" أَنَّ أَصْحَابَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانُوا يُسَلِّمُونَ وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَيٌّ : السَّلامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ , فَلَمَّا مَاتَ قَالُوا : السَّلامُ عَلَى النَّبِيِّ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ ""","","","","","Book of Prayer"
"2989","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : وَبَيْنَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُعَلِّمُ التَّشَهُّدَ , فَقَالَ رَجُلٌ : وَأَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُهُ وَعَبْدُهُ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" قَدْ كُنْتُ عَبْدًا قَبْلَ أَنْ أَكُونَ رَسُولا , قُلْ : وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ ""","","","","","Book of Prayer"
"2990","عَنْ مَعْمَرٍ , عَنْ خُصَيْفٍ الْجَزَرِيِّ , قال : \" رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي النَّوْمِ جَاءَنِي , فَقُلْتُ : يَا رَسُولَ اللَّهِ , اخْتُلِفَ عَلَيْنَا فِي التَّشَهُّدِ , قَالَ فُلانٌ : كَذَا , وَقَالَ فُلانٌ : كَذَا , وَقَالَ ابْنُ مَسْعُودٍ : كَذَا قَالَ : السُّنَّةُ سُنَّةُ ابْنِ مَسْعُودٍ ""","","","","","Book of Prayer"
"2991","عَنْ مَعْمَرٍ , وَقَتَادَةَ , وَحَمَّادٍ في رجل نسي التشهد في آخر صلاته حتى انصرف , قَالُوا : \" لا يُعِيدُ فَقَدْ تَمَّتْ صَلاتُهُ ""","","","","","Book of Prayer"
"2992","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" لا صَلاةَ مَكْتُوبَةً وَلا تَطَوُّعَ إِلا بِتَشَهُّدٍ \" , قُلْتُ : فَنَسِيتُ التَّشَهُّدَ فِي الصُّبْحِ , قَالَ : \" لا تُعِدُ وَلا تَسْجُدْ سَجْدَتَيِ السَّهْوِ وَتَشَهَّدْ حِينَ تَذْكُرُ ""","","","","","Book of Prayer"
"2993","عَنْ عَبْدِ اللَّهِ بْنِ كَثِيرٍ , عَنْ شُعْبَةَ , عَنْ مُسْلِمٍ الشَّامِيِّ , عَنْ حَمَلَةَ , رَجُلٌ مِنْ عَكٍّ , عَنْ عُمَرَ بْنِ الْخَطَّابِ , قَالَ : \" لا تَجُوزُ صَلاةٌ إِلا بِتَشَهُّدٍ ""","","","","","Book of Prayer"
"2994","عَنْ عُثْمَانَ بْنِ مَطَرٍ , عَنْ حُسَيْنٍ , عَنْ بُدَيْلٍ الْعُقَيْلِيِّ , عَنْ أَبِي الْجَوْزَاءِ , عَنْ عَائِشَةَ , قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ التَّحِيَّاتُ بَيْنَ كُلِّ رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"2995","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ عُمَيْرِ بْنِ سَعْدٍ , عَنِ ابْنِ مَسْعُودٍ , أَنَّهُ كَانَ يُعَلِّمُهُمُ التَّشَهُّدَ , ثُمَّ يَقُولُ : \" اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنَ الْخَيْرِ كُلِّهِ مَا عَلِمْتُ مِنْهُ وَمَا لَمْ أَعْلَمْ , وَأَعُوذُ بِكَ مِنَ الشَّرِ كُلِّهِ مَا عَلِمْتُ مِنْهُ وَمَا لَمْ أَعْلَمْ , اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ خَيْرِ مَا سَأَلَكَ عِبَادُكَ الصَّالِحُونَ , وَأَعُوذُ بِكَ مِنْ شَرِّ مَا اسْتَعَاذَ بِهِ عِبَادُكَ الصَّالِحُونَ , اللَّهُمَّ رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ , رَبَّنَا اغْفِرْ لَنَا ذُنُوبَنَا , وَكَفِّرْ عَنَّا سَيِّئَاتِنَا وَتَوَفَّنَا مَعَ الأَبْرَارِ , رَبَّنَا وَآتِنَا مَا وَعَدْتَنَا عَلَى رُسُلِكَ وَلا تُخْزِنَا يَوْمَ الْقِيَامَةِ إِنَّكَ لا تُخْلِفُ الْمِيعَادَ ""","","","","","Book of Prayer"
"2996","عَنِ الثَّوْرِيِّ , عَنْ أَبِي الْجَحَّافِ , عَنِ الْحَارِثِ بْنِ يَزِيدَ , عَنْ إِبْرَاهِيمَ , قَالَ : سَأَلْتُهُ عَنِ الإِمَامِ , قال : \" يُكَبِّرُ , ثُمَّ يَقُولُ : سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ , ثُمَّ يَتَعَوَّذُ سِرًّا , وَيَقْرَأُ  بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ سِرًّا , ثُمَّ يَجْهَرُ بِـ  الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ , ثُمَّ يُكَبِّرُ وَهُوَ يَهْوِي , ثُمَّ يَقُومُ فَيُكَبِّرُ وَهُوَ يَهْوِي , ثُمَّ يَجْلِسُ فِي الأُولَيَيْنِ لِلتَّشَهُّدِ , وَلا يَزِيدُ عَلَيْهِ , وَفِي الأُخْرَيَيْنِ التَّشَهُّدُ , وَخَمْسُ كَلِمَاتٍ جَوَامِعٍ \" , قَالَ الثَّوْرِيُّ : فَأَخْبَرَنِي مَنْصُورٌ , قَالَ : قُلْتُ لإِبْرَاهِيمَ : الصَّلاةُ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ : \" مَا كَانُوا يَزِيدُونَ عَلَيْهِنَّ ""","","","","","Book of Prayer"
"2997","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَلَيْسَ الصَّلاةُ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَعَ التَّشَهُّدِ ؟ , فَقَالَ : \" لا يُزَادُ عَلَى التَّشَهُّدِ فِيمَا يُعْلَمُ مِنَ التَّشَهُّدِ , إِلا أَنْ يَقُولَ الإِنْسَانُ بَعْدَ التَّشَهُّدِ : مَا شَاءَ ""","","","","","Book of Prayer"
"2998","عَنِ ابْنِ عُيَيْنَةَ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قال : \" يُجْزِيكَ التَّشَهُّدُ مِنَ الصَّلاةِ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Prayer"
"2999","عَنِ ابْنِ جُرَيْجٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , أَنَّهُ كَانَ يَقُولُ بَعْدَ التَّشَهُّدِ فِي الْمَثْنَى الآخِرِ : كَلِمَاتٍ يُعَلِّمُهُنَّ جِدَّا , قَالَ : \" أَعُوذُ بِاللَّهِ مِنْ عَذَابِ جَهَنَّمَ , وَأَعُوذُ بِاللَّهِ مِنْ شَرِّ الْمَسِيحِ الدَّجَالِ , وَأَعُوذُ بِاللَّهِ مِنْ عَذَابِ الْقَبْرِ , وَأَعُوذُ بِاللَّهِ مِنْ فِتْنَةِ الْمَحْيَا وَالْمَمَاتِ \" , قَالَ : كَانَ يُعَلِّمُهُنَّ وَيَذْكُرُهُنَّ عَنْ عَائِشَةَ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قَالَ : قَالَ لِرَجُلٍ : \" أَقُلْتَهُنَّ فِي صَلاتِكَ ؟ \" , قَالَ : لا , قَالَ : \" فَأَعِدْ صَلاتَكَ يَعْنِي هَذَا الْقَوْلَ ""","","","","","Book of Prayer"
"3000","عَنْ مَعْمَرِ بْنِ رَاشِدٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ أَبِي سَلَمَةَ , عَنْ عَائِشَةَ , قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ عَذَابِ الْقَبْرِ , وَمِنْ فِتْنَةِ الْمَحْيَا وَالْمَمَاتِ , وَمِنْ شَرِّ فِتْنَةِ الْمَسِيحِ الدَّجَالِ ""","","","","","Book of Prayer"
"3001","عَنِ الثَّوْرِيِّ , عَنْ هِشَامٍ , عَنْ مُحَمَّدٍ , قال : \" كَانَ إِذَا تَشَهَّدَ أَلْقَى رِدَاءَهُ بَعْدَ التَّشَهُّدِ فِي الرَّكْعَةِ الآخِرَةِ ""","","","","","Book of Prayer"
"3002","عَنْ مُقَاتِلٍ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ : \" مَنْ أَدْرَكَ رَكْعَةً مَعَ الإِمَامِ أَوْ فَاتَهُ رَكْعَةٌ فَلا يَتَشَهَّدْ مَعَ الإِمَامِ , وَلْيُهْلِلْ حَتَّى يَقُومَ \" . فَذُكِرَ ذَلِكَ لِلثَّوْرِيِّ , فَقَالَ : \" فِي كُلِّ جُلُوسٍ تَشَهُّدٌ ""","","","","","Book of Prayer"
"3003","عَنْ مَالِكٍ , قَالَ : سَأَلْتُ نَافِعًا , وَابْنَ شِهَابٍ , عَنْ ذَلِكَ , فَقَالا : \" يَتَشَهَّدُ ""","","","","","Book of Prayer"
"3004","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قال : \" يَتَشَهَّدُ ""","","","","","Book of Prayer"
"3005","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِذَا كُنْتَ فِي وِتْرٍ جَالِسًا وَالإِمَامُ فِي شَفْعٍ فَتَشَهَّدْ وَلا تُسَلِّمْ , تَقُولُ : التَّحِيَّاتُ لِلَّهِ , الْمُبَارَكَاتُ لِلَّهِ , الصَلَوَاتُ الطَّيِّبَاتُ لِلَّهِ , وَسَبِّحْ وَدَعِ السَّلامَ وَتَشَهَّدْ هَكَذَا \" , قُلْتُ : أَفَأُسَبِّحُ وَأُهَلِّلُ وَأُكَبِّرُ ؟ , قَالَ : \" فَلا , إِنْ شِئْتَ ""","","","","","Book of Prayer"
"3006","عَنْ قَيْسِ بْنِ الرَّبِيعِ , عَنْ مَنْصُورٍ , عَنْ أَبِي مَعْشَرٍ , عَنْ إِبْرَاهِيمَ , قال : \" لا يَتَشَهَّدُ ""","","","","","Book of Prayer"
"3007","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , عَنْ عَمْرِو بْنِ دِينَارٍ , قال : \" لا يَتَشَهَّدُ ""","","","","","Book of Prayer"
"3008","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , قَالَ : \" كَانَ ابْنُ عُمَرَ إِذَا كَانَ لَهُ وِتْرٌ وَالإِمَامُ فِي شَفْعٍ لا يُسَلِّمُ فِي تَشَهُّدِهِ , كَانَ يَرَاهُ فَسْخًا لِصَلاتِهِ \" , قَالَ مَعْمَرٌ , قَالَ الزُّهْرِيُّ : \" وَأَنَا أَشْهَدُ وَأُسَلِّمُ فِي تَشَهُّدِي ""","","","","","Book of Prayer"
"3009","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِذَا فَاتَتْكَ رَكْعَةٌ مَعَ الإِمَامِ فَجَلَسَ , فَتَشَهَّدَ فِي شَفْعٍ وَأَنْتَ فِي وِتْرٍ , فَإِذَا انْصَرَفَ الإِمَامُ فَأَوْفِ مِمَّا بَقِيَ مِنْ صَلاتِكَ , ثُمَّ اسْجُدْ سَجْدَتَيِ السَّهْوِ \" , قُلْتُ : فَلَمْ أَسْجُدُهُمَا ؟ , قَالَ : \" مِنْ أَجْلِ أَنَّهُ لا يُجْلَسُ فِي وِتْرٍ وَلا يُتَشَهَّدُ فِيهِ , وَمِنْ أَجْلِ أَنَّهُ جَلَسَ فِي وِتْرٍ \" , قُلْتُ : يَنْزِلُ ذَلِكَ مِنْهُ بِمَنْزِلَةِ السَّهْوِ وَالْخَطَإِ قَالَ : \" نَعَمْ ""","","","","","Book of Prayer"
"3010","عَنِ ابْنِ جُرَيْجٍ , قَالَ مُسْلِمُ بْنُ مُصَبِّحِ بْنِ الزُّبَيْرِ : قَالَ : \" فَاتَتِ ابْنَ الزُّبَيْرِ رَكْعَتَيِ الظُّهْرِ , فَلَمَّا سَلَّمَ الإِمَامُ قَامَ ابْنُ الزُّبَيْرِ فَأَتَمَّ الرَّكْعَةَ , فَلَمَّا سَلَّمَ سَجَدَ سَجْدَتَيِ السَّهْوِ \" , عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ , وَابْنِ عُمَرَ أَنَّهُمَا كَانَا يَفْعَلانِ ذَلِكَ , قَالَ ابْنُ جُرَيْجٍ : \" وَأُخْبِرْتُ بَعْدَمَا مَاتَ عَطَاءٌ , أَنَّهُ يَأْثِرُ حَدِيثَ ابْنِ عُمَرَ , عَنْ إِسْمَاعِيلَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ذُؤَيْبٍ الأَسْدِيِّ ""","","","","","Book of Prayer"
"3011","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ , قَالَ : \" رَأَيْتُ ابْنَ عُمَرَ يَفُوتُهُ رَكْعَةٌ , فَجَلَسَ فِي وِتْرٍ وَالإِمَامُ فِي شَفْعٍ , فَإِذَا سَلَّمَ الإِمَامُ قَامَ فَأَوْفَى مَا بَقِيَ عَلَيْهِ , ثُمَّ سَجَدَ سَجْدَتَيِ السَّهْوِ \" , عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , عَنِ ابْنِ عُمَرَ مِثْلَهُ","","","","","Book of Prayer"
"3012","قَالَ الزُّهْرِيُّ : وَأَخْبَرَنِي سَعِيدُ بْنُ الْمُسَيِّبِ , عَنْ أَبِي هُرَيْرَةَ , أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" إِذَا أُقِيمَتِ الصَّلاةُ فَلا تَأْتُوهَا تَسْعَوْنَ , وَلَكِنِ ائْتُوهَا وَأَنْتُمْ تَمْشُونَ , وَعَلَيْكُمُ السَّكِينَةُ , وَمَا أَدْرَكْتُمْ فَصَلُّوا , وَمَا فَاتَكُمْ فَأَتِمُّوا , فَلَمْ يَذْكُرْ سُجُودَهُ ""","","","","","Book of Prayer"
"3013","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدٍ , عَنْ عَمْرِو بْنِ حَزْمٍ , عَنْ رَجُلٍ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ : \" اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَعَلَى أَهْلِ بَيْتِهِ , وَعَلَى أَزْوَاجِهِ , وَذُرِّيَّتِهِ , كَمَا صَلَّيْتَ عَلَى إِبْرَاهِيمَ وَعَلَى آلِ إِبْرَاهِيمَ إِنَّكَ حَمِيدٌ مَجِيدٌ , وَبَارِكْ عَلَى مُحَمَّدٍ وَعَلَى أَهْلِ بَيْتِهِ , وَأَزْوَاجِهِ وَذُرِّيَّتِهِ , كَمَا بَارَكْتَ عَلَى إِبْرَاهِيمَ وَعَلَى آلِ إِبْرَاهِيمَ , إِنَّكَ حَمِيدٌ مَجِيدٌ \" , قَالَ ابْنُ طَاوُسٍ : \" وَكَانَ أَبِي , يَقُولُ : مِثْلَ ذَلِكَ ""","","","","","Book of Prayer"
"3014","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , عَنِ ابْنِ عَبَّاسٍ , أَنَّهُ كَانَ يَقُولُ : \" اللَّهُمَّ تَقَبَّلْ شَفَاعَةَ مُحَمَّدٍ الْكُبْرَى , وَارْفَعْ دَرَجَتَهُ الْعُلْيَا , وَآتِهِ سُؤْلَهُ فِي الآخِرَةِ وَالأُولَى , كَمَا آتَيْتَ إِبْرَاهِيمَ , وَمُوسَى \" . وَكَانَ مَعْمَرٌ رُبَّمَا ذَكَرَهُ , عَنِ ابْنِ طَاوُسٍ , عَنْ عِكْرِمَةَ بْنِ خَالِدٍ , عَنِ ابْنِ عَبَّاسٍ","","","","","Book of Prayer"
"3015","عَنْ عَبْدِ اللَّهِ بْنِ مُحَرَّرٍ , عَنِ الْحَكَمِ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى , عَنْ كَعْبِ بْنِ عُجْرَةَ , وَالثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنِ الْحَكَمِ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى , عَنْ كَعْبِ بْنِ عُجْرَةَ , أَنَّ رَجُلا قَالَ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : يَا رَسُولَ اللَّهِ , قَدْ عَلِمْنَا كَيْفَ السَّلامُ عَلَيْكَ , فَكَيْفَ الصَّلاةُ عَلَيْكَ ؟ قَالَ : \" قُولُوا : اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَعَلَى آلِ مُحَمَّدٍ , كَمَا صَلَّيْتَ عَلَى إِبْرَاهِيمَ إِنَّكَ حَمِيدٌ مَجِيدٌ , اللَّهُمَّ بَارِكْ عَلَى مُحَمَّدٍ كَمَا بَارَكْتَ عَلَى إِبْرَاهِيمَ إِنَّكَ حَمِيدٌ مَجِيدٌ ""","","","","","Book of Prayer"
"3016","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي ابْنُ أَبِي لَيْلَى , عَنْ كَعْبِ بْنِ عُجْرَةَ , قَالَ : كُنْتُ جَالِسًا عِنْدَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذْ جَاءَهُ رَجُلٌ , فَقَالَ : قَدْ عَلِمْنَا كَيْفَ نُسَلِّمُ عَلَيْكَ , فَكَيْفَ نُصَلِّي عَلَيْكَ ؟ , قَالَ : \" قُولُوا : اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَعَلَى آلِ مُحَمَّدٍ , كَمَا صَلَّيْتَ عَلَى آلِ إِبْرَاهِيمَ إِنَّكَ حَمِيدٌ مَجِيدٌ ""","","","","","Book of Prayer"
"3017","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , عَنْ كَعْبِ بْنِ عُجْرَةَ , قَالَ : يَا رَسُولَ اللَّهِ , قَدْ عَلِمْنَا كَيْفَ نُسَلِّمُ عَلَيْكَ , فَكَيْفَ نُصَلِّي عَلَيْكَ ؟ , قَالَ : \" قُولُوا : اللَّهُمَّ صَلِّ عَلَى آلِ مُحَمَّدٍ , اللَّهُمَّ بَارِكْ عَلَى آلِ مُحَمَّدٍ , كَمَا بَارَكْتَ وَصَلَّيْتَ عَلَى إِبْرَاهِيمَ , وَآلِ إِبْرَاهِيمَ إِنَّكَ حَمِيدٌ مَجِيدٌ ""","","","","","Book of Prayer"
"3018","عَنْ مَالِكٍ , عَنْ نُعَيْمِ بْنِ عَبْدِ اللَّهِ الْمُجْمِرِ مَوْلَى عُمَرَ بْنِ الْخَطَّابِ , أَنَّ مُحَمَّدَ بْنَ عَبْدِ اللَّهِ بْنِ زَيْدٍ أَخْبَرَهُ , عَنْ أَبِي مَسْعُودٍ الأَنْصَارِيِّ , أَنَّهُ قَالَ : أَتَانَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَجَلَسَ مَعَنَا فِي مَجْلِسِ سَعْدِ بْنِ عُبَادَةَ , فَقَالَ لَهُ : بَشِيرُ بْنُ سَعْدٍ وَهُوَ أَبُو النُّعْمَانِ بْنِ بَشِيرٍ أَمَرَنَا اللَّهُ , أَنْ نُصَلِّيَ عَلَيْكَ فَكَيْفَ نُصَلِّي عَلَيْكَ ؟ , قَالَ : فَصَمَتَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَتَّى تَمَنَّيْنَا , أَنَّهُ لَمْ يَسْأَلْهُ , ثُمَّ قَالَ : \" قُولُوا : اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَعَلَى آلِ مُحَمَّدٍ , كَمَا صَلَّيْتَ عَلَى إِبْرَاهِيمَ , وَبَارِكْ عَلَى مُحَمَّدٍ وَعَلَى آلِ مُحَمَّدٍ , كَمَا بَارَكْتَ عَلَى آلِ إِبْرَاهِيمَ فِي الْعَالَمِينَ إِنَّكَ حَمِيدٌ مَجِيدٌ , وَالسَّلامُ كَمَا قَدْ عَلِمْتُمْ ""","","","","","Book of Prayer"
"3019","عَنِ الثَّوْرِيِّ , عَنْ أَبِي سَلَمَةَ , عَنْ عَوْنِ بْنِ عَبْدِ اللَّهِ , عَنْ رَجُلٍ , عَنِ الأَسْوَدِ بْنِ يَزِيدَ , عَنِ ابْنِ مَسْعُودٍ , أَنَّهُ كَانَ يَقُولُ : \" اللَّهُمَّ اجْعَلْ صَلَوَاتِكَ وَرَحْمَتَكَ وَبَرَكَتَكَ عَلَى سَيِّدِ الْمُرْسَلِينَ وَإِمَامِ الْمُتَّقِينَ , وَخَاتَمِ النَّبِيِّينَ مُحَمَّدٍ عَبْدِكَ وَرَسُولِكَ إِمَامِ الْخَيْرِ , وَقَائِدِ الْخَيْرِ وَرَسُولِ الرَّحْمَةِ , اللَّهُمَّ ابْعَثْهُ مَقَامًا مَحْمُودًا يَغْبِطُ بِهِ الأَوَّلُونَ وَالآخِرُونَ , اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَعَلَى آلِ مُحَمَّدٍ , كَمَا صَلَّيْتَ عَلَى آلِ إِبْرَاهِيمَ إِنَّكَ حَمِيدٌ مَجِيدٌ , اللَّهُمَّ بَارِكْ عَلَى مُحَمَّدٍ وَعَلَى آلِ مُحَمَّدٍ , كَمَا بَارَكْتَ عَلَى آلِ إِبْرَاهِيمَ إِنَّكَ حَمِيدٌ مَجِيدٌ ""","","","","","Book of Prayer"
"3020","عَنِ الثَّوْرِيِّ , وَسَمِعْتُهُ وَسَأَلَهُ رَجُلٌ , عَنْ قَوْلِهِ : اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَعَلَى آلِ مُحَمَّدٍ , فَقَالَ : \" اخْتُلِفَ فِيهِمْ , فَمِنْهُمْ مَنْ , قَالَ : آلُ مُحَمَّدٍ أَهْلُ بَيْتِهِ , وَمِنْهُمْ مَنْ يَقُولُ : مَنْ أَطَاعَهُ ""","","","","","Book of Prayer"
"3021","عَنْ مَعْمَرٍ , عَنْ يُونُسَ بْنِ خَبَّابٍ , عَنْ مُجَاهِدٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّكُمْ تُعْرَضُونَ عَلَيَّ بِأَسْمَائِكُمْ وَسِيمَائِكُمْ فَأَحْسِنُوا الصَّلاةَ عَلَيَّ ""","","","","","Book of Prayer"
"3022","عَنِ الثَّوْرِيِّ , عَنْ أَبِي سَلَمَةَ , عَنْ عَوْنِ بْنِ عَبْدِ اللَّهِ , عَنْ رَجُلٍ , عَنِ الأَسْوَدِ بْنِ يَزِيدَ , عَنِ ابْنِ مَسْعُودٍ , قَالَ : \" إِذَا صَلَّيْتُمْ فَأَحْسِنُوا الصَّلاةَ عَلَى نَبِيِّكُمْ ""","","","","","Book of Prayer"
"3023","عَنْ مَعْمَرٍ , عَنْ أَبَانَ , عَنْ أَنَسٍ , عَنْ أَبِي طَلْحَةَ , قَالَ : دَخَلْتُ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمًا فَوَجَدْتُهُ مَسْرُورًا , فَقُلْتُ : يَا رَسُولَ اللَّهِ , مَا أَدْرِي مَتَى رَأَيْتُكَ أَحْسَنَ بِشْرًا وَأَطْيَبَ نَفْسًا مِنَ الْيَوْمِ ؟ , قَالَ : \" وَمَا يَمْنَعُنِي وَجِبْرِيلُ خَرَجَ مِنْ عِنْدِي السَّاعَةَ , فَبَشَّرَنِي أَنَّ لِكُلِّ عَبْدٍ صَلَّى عَلَيَّ صَلاةً يُكْتَبُ لَهُ بِهَا عَشْرُ حَسَنَاتٍ , وَيُمْحَى عَنْهُ عَشْرُ سَيِّئَاتٍ , وَيُرْفَعُ لَهُ عَشْرُ دَرَجَاتٍ , وَتُعْرَضُ عَلَيَّ كَمَا قَالَهَا , وَيُرَدُّ عَلَيْهِ بِمِثْلِ مَا دَعَا ""","","","","","Book of Prayer"
"3024","عَنِ ابْنِ عُيَيْنَةَ , قَالَ : أَخْبَرَنِي يَعْقُوبُ بْنُ زَيْدٍ التَّيْمِيُّ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَتَانِي آتٍ مِنْ رَبِّي , فَقَالَ : لا يُصَلِّي عَلَيْكَ عَبْدٌ صَلاةً إِلا صَلَّى اللَّهُ عَلَيْهِ عَشْرًا \" , قَالَ : فَقَالَ رَجُلٌ : يَا رَسُولَ اللَّهِ , أَلا أَجْعَلُ نِصْفَ دُعَائِي لَكَ ؟ , قَالَ : \" إِنْ شِئْتَ \" , قَالَ : أَلا أَجْعَلُ كُلَّ دُعَائِي لَكَ ؟ , قَالَ : \" إِذًا يَكْفِيكَ اللَّهُ هَمَّ الدُّنْيَا وَالآخِرَةِ ""","","","","","Book of Prayer"
"3025","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ عَبْدِ اللَّهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ , عَنْ أَبِيهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَنْ صَلَّى عَلَيَّ صَلاةً صَلَّى اللَّهُ عَلَيْهِ , فَأَكْثِرُوا أَوْ أَقِلُّوا ""","","","","","Book of Prayer"
