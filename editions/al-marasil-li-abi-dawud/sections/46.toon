hadiths[9]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"254","46 - بَابُ كَمِ الدِّيَةُ  255  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَالِدٍ الْجُهَنِيُّ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَيُّوبَ بْنِ مُوسَى .  عَنْ  مَكْحُولٍ ، قَالَ :  تُوُفِّيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَالدِّيَةُ ثَمَانُمِائَةِ         [1/211]      دِينَارٍ  ، فَخَشِيَ  عُمَرُ  مِنْ بَعْدِهِ فَجَعَلَهَا اثْنَيْ عَشَرَ أَلْفَ دِرْهَمٍ أَوْ أَلْفَ دِينَارٍ  ( 19458 ) .","","Al-Marasil li-Abi Dawud 255","","مكحول بن أبي مسلم عن أيوب بن موسى الأموي عن سفيان الثوري عن وكيع بن الجراح عن الهيثم بن خالد الجهني عن أبو داود السجستاني","باب كم الدية"
"255","256  -  حَدَّثَنَا  أَبُو كَامِلٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  حُسَيْنٌ .  عَنْ  عَمْرِو بْنِ شُعَيْبٍ :  أَنَّ قِيمَةَ الدِّيَةِ ، كَانَتْ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَمَانَمِائَةِ دِينَارٍ  ( 19172 ) .","","Al-Marasil li-Abi Dawud 256","","عمرو بن شعيب عن حسين المعلم عن يزيد بن زريع العيشي عن فضيل بن حسين الجحدري عن أبو داود السجستاني","باب كم الدية"
"256","257  -  حَدَّثَنَا  وَهْبُ بْنُ بَيَانٍ ، وَابْنُ السَّرْحِ ، وَأَحْمَدُ بْنُ سَعِيدٍ ، قَالُوا :  أَخْبَرَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  يُونُسُ .  عَنِ  ابْنِ شِهَابٍ ، قَالَ :  قَرَأْتُ فِي كِتَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِعَمْرِو بْنِ         [1/212]      حَزْمٍ  حِينَ بَعَثَهُ إِلَى  نَجْرَانَ  ، وَكَانَ الْكِتَابُ عِنْدَ  أَبِي بَكْرِ بْنِ حَزْمٍ  ، فَكَتَبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيهِ : هَذَا بَيَانٌ مِنَ اللهِ وَرَسُولِهِ :         {      يَا أَيُّهَا الَّذِينَ آمَنُوا أَوْفُوا بِالْعُقُودِ         }      وَكَتَبَ الْآيَاتِ مِنْهَا  حَتَّى بَلَغَ :         {      إِنَّ اللهَ سَرِيعُ الْحِسَابِ         }      ثُمَّ كَتَبَ : هَذَا كِتَابُ الْجِرَاحِ :  فِي النَّفْسِ مِائَةٌ مِنَ الْإِبِلِ  ، وَفِي الْأَنْفِ إِذَا أُوعِبَ  جَدْعُهُ  مِائَةٌ مِنَ الْإِبِلِ ، وَفِي الْعَيْنِ خَمْسُونَ مِنَ الْإِبِلِ ، وَفِي الْأُذُنِ خَمْسُونَ مِنَ الْإِبِلِ ، وَفِي الْيَدِ خَمْسُونَ مِنَ الْإِبِلِ ، وَفِي الرِّجْلِ خَمْسُونَ مِنَ الْإِبِلِ ، وَفِي كُلِّ أُصْبُعٍ مِمَّا هُنَالِكَ عَشْرٌ مِنَ الْإِبِلِ ، وَفِي الْمَأْمُومَةِ ثُلُثُ النَّفْسِ ، وَفِي  الْجَائِفَةِ  ثُلُثُ النَّفْسِ ، وَفِي الْمُنَقِّلَةِ خَمْسَ عَشْرَةَ ، وَفِي الْمُوضِحَةِ خَمْسٌ مِنَ الْإِبِلِ ، وَفِي السِّنِّ خَمْسٌ مِنَ الْإِبِلِ .  قَالَ  ابْنُ شِهَابٍ  : فَهَذَا الَّذِي قَرَأْتُ فِي الْكِتَابِ الَّذِي كَتَبَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِنْدَ  أَبِي بَكْرِ بْنِ حَزْمٍ  ( 19567 ) .         [1/213]      قَالَ أَبُو دَاوُدَ :  أُسْنِدَ  هَذَا وَلَا يَصِحُّ  ، رَوَاهُ  يَحْيَى بْنُ حَمْزَةَ  ، عَنْ  سُلَيْمَانَ بْنِ أَرْقَمَ  ، عَنِ  الزُّهْرِيِّ  ، عَنْ  أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ  ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ  .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: نا .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: فيها .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: أوعي .","","Al-Marasil li-Abi Dawud 257","","الزهري عن يونس بن يزيدالأيلي عن عبد الله بن وهب المصري عن أحمد بن عمرو بن بن السرح المصري عن أبو داود السجستاني","باب كم الدية"
"257","258  -  حَدَّثَنَا  أَبُو هُبَيْرَةَ ، قَالَ :  قَرَأْتُهُ فِي أَصْلِ  يَحْيَى بْنِ حَمْزَةَ ،  حَدَّثَنِي  سُلَيْمَانُ بْنُ أَرْقَمَ .  وَحَدَّثَنَا  هَارُونُ بْنُ مُحَمَّدِ بْنِ بَكَّارٍ ،  حَدَّثَنِي  أَبِي ، وَعَمِّي  ، قَالَا : يَحْيَى  بْنُ حَمْزَةَ ،  عَنْ  سُلَيْمَانَ بْنِ أَرْقَمَ ، مِثْلَهُ .  قَالَ  أَبُو دَاوُدَ  :  وَالَّذِي قَالَ  سُلَيْمَانُ بْنُ دَاوُدَ  وَهِمَ فِيهِ  .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: ""قال أبو داود : حدثني به"" .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال حدثني .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: نا يحيى .","","Al-Marasil li-Abi Dawud 258","","عمرو بن حزم بن زيد الخزرجي عن محمد بن عمرو بن حزم النجاري عن أبو بكر بن محمد الخزرجي عن الزهري عن سليمان بن أرقم الانصارى عن يحيى بن حمزة بن البتلهي عن محمد بن بكار العاملي عن هارون بن محمد بن بكار العاملي عن أبو داود السجستاني","باب كم الدية"
"258","259  -  حَدَّثَنَا  الْحَكَمُ بْنُ مُوسَى ،  حَدَّثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  عَنْ  سُلَيْمَانَ بْنِ دَاوُدَ [الْخَوْلَانِيِّ -  ثِقَةٌ  -]  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  وَهِمَ  فِيهِ  الْحَكَمُ  .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: ""قال أبو داود : وهم"" .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: ""قال أبو داود : كان قوم بمصر يقولون : وهب بن بيان من الأبدال .","","Al-Marasil li-Abi Dawud 259","","عمرو بن حزم بن زيد الخزرجي عن محمد بن عمرو بن حزم النجاري عن أبو بكر بن محمد الخزرجي عن الزهري عن سليمان بن داود بومة عن يحيى بن حمزة بن البتلهي عن الحكم بن موسى بن أبي زهير النسائي عن أبو داود السجستاني","باب كم الدية"
"259","260  -  حَدَّثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرِ بْنِ عَمْرِو بْنِ حَزْمٍ ، قَالَ :  كَانَ فِي كِتَابِ         [1/214]      رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَعْنِي هَذَا - :  وَفِي الذَّكَرِ الدِّيَةُ ، وَفِي اللِّسَانِ الدِّيَةُ  ( 18891 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: أنا .","","Al-Marasil li-Abi Dawud 260","","عبد الله بن أبي بكر بن محمد  ابن حزم عن محمد بن إسحاق عن حماد بن سلمة عن موسى بن إسماعيل التبوذكي عن أبو داود السجستاني","باب كم الدية"
"260","261  -  حَدَّثَنَا  مُوسَى ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ .  عَنْ  مَكْحُولٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  فِي اللِّسَانِ الدِّيَةُ ، وَفِي الذَّكَرِ الدِّيَةُ  ، وَفِيمَا أَقْبَلَ مِنَ الْأَسْنَانِ خَمْسُ  فَرَائِضَ  ( 19476 ) .","","Al-Marasil li-Abi Dawud 261","","مكحول بن أبي مسلم عن محمد بن إسحاق عن حماد بن سلمة عن موسى بن إسماعيل التبوذكي عن أبو داود السجستاني","باب كم الدية"
"261","262  -  حَدَّثَنَا  مُحَمَّدُ بْنُ [عَبْدِ اللهِ]  ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ يَعْنِي ابْنَ مَغْرَاءَ ،  حَدَّثَنَا  مُحَمَّدٌ يَعْنِي ابْنَ إِسْحَاقَ .  سَمِعْتُ  مَكْحُولًا يَقُولُ :  قَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْأُنْثَيَيْنِ الدِّيَةَ  ( 19477 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: القطان .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال سمعت .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: ""قال أبو داود : محمد بن عبد الله القطان رجل من أهل بغداد كان أحمد يكرمه ، مات بطرسوس"" .","","Al-Marasil li-Abi Dawud 262","","مكحول بن أبي مسلم عن محمد بن إسحاق عن عبد الرحمن بن مغراء الدوسي عن محمد بن عبد الله بن أبي حماد الطرسوسي عن أبو داود السجستاني","باب كم الدية"
"262","263  -  حَدَّثَنَا  قُتَيْبَةُ ،  حَدَّثَنَا  اللَّيْثُ ،  عَنِ  ابْنِ الْهَادِ .  عَنِ  ابْنِ شِهَابٍ قَالَ : [قَالَ]  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فِي  الصُّلْبِ  الدِّيَةُ  ( 19396 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قضى .","","Al-Marasil li-Abi Dawud 263","","الزهري عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن الليث بن سعد عن قتيبة بن سعيد عن أبو داود السجستاني","باب كم الدية"
