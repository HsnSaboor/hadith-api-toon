hadiths[18]{hadithnumber,text}:
"1009","[1009] حَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنِ ابْنِ شِہَابٍ، عَنْ عُبَیْدِ اللّٰہِ بْنِ عَبْدِ اللّٰہِ بْنِ عُتْبَۃَ بْنِ مَسْعُودٍ، عَنْ عَبْدِ اللّٰہِ بْنِ عَبَّاسٍ : أَنَّ سَعْدَ بْنَ عُبَادَۃَ اسْتَفْتَی رَسُولَ اللّٰہِ  ﷺ  فَقَالَ : إِنَّ أُمِّی مَاتَتْ وَعَلَیْہَا نَذْرٌ وَلَمْ تَقْضِہِ ؟ فَقَالَ رَسُولُ اللّٰہِ  ﷺ : اقْضِہِ عَنْہَا۔\nموطا امام مالک حدیث: 1009 عربی حدیث:"
"1010","[1010] وَحَدَّثَنِی عَنْ مَالِکٍ، عَنْ عَبْدِ اللّٰہِ بْنِ أبِی بَکْرٍ، عَنْ عَمَّتِہِ، أَ نَّہَا حَدَّثَتْہُ عَنْ جَدَّتِہِ : أَ نَّہَا کَانَتْ جَعَلَتْ عَلَی نَفْسِہَا مَشْیاً إِلَی مَسْجِدِ قُبَائٍ، فَمَاتَتْ وَلَمْ تَقْضِہِ، فَأَفْتَی عَبْدُ اللّٰہِ بْنُ عَبَّاسٍ ابْنَتَہَا أَنْ تَمْشِیَ عَنْہَا۔\nموطا امام مالک حدیث: 1010 عربی حدیث:"
"1011","[1011] وَحَدَّثَنِی عَنْ مَالِکٍ، عَنْ عَبْدِ اللّٰہِ بْنِ أبِی حَبِیبَۃَ قَالَ : قُلْتُ لِرَجُلٍ وَأَنَا حَدِیثُ السِّنِّ مَا عَلَی الرَّجُلِ أَنْ یَقُولَ : عَلَیَّ مَشْیٌ إِلَی بَیْتِ اللّٰہِ، وَلَمْ یَقُلْ عَلَیَّ نَذْرُ مَشْیٍ۔ فَقَالَ لِی رَجُلٌ : ہَلْ لَکَ أَنْ أُعْطِیَکَ ہَذَا الْجِرْوَ - لِجِرْوِ قِثَّائٍ فِی یَدِہِ – وَتَقُولُ : عَلَیَّ مَشْیٌ إِلَی بَیْتِ اللّٰہِ، قَالَ : فَقُلْتُ نَعَمْ، فَقُلْتُہُ وَأَنَا یَوْمَئِذٍ حَدِیثُ السِّنِّ، ثُمَّ مَکَثْتُ حَتَّی عَقَلْتُ، فَقِیلَ لِی : إِنَّ عَلَیْکَ مَشْیاً، فَجِئْتُ سَعِیدَ بْنَ الْمُسَیَّبِ فَسَأَلْتُہُ عَنْ ذَلِکَ، فَقَالَ لِی : عَلَیْکَ مَشْیٌ۔ فَمَشَیْتُ۔ \nموطا امام مالک حدیث: 1011 عربی حدیث:"
"1012","[1012] حَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ عُرْوَۃَ بْنِ أُذَیْنَۃَ اللَّیْثِیِّ، أَ نَّہُ قَالَ : خَرَجْتُ مَعَ جَدَّۃٍ لِی عَلَیْہَا مَشْیٌ إِلَی بَیْتِ اللّٰہِ، حَتَّی إِذَا کُنَّا بِبَعْضِ الطَّرِیقِ عَجَزَتْ, فَأَرْسَلَتْ مَوْلًی لَہَا یَسْأَلُ عَبْدَ اللّٰہِ بْنَ عُمَرَ، فَخَرَجْتُ مَعَہُ، فَسَأَلَ عَبْدَ اللّٰہِ بْنَ عُمَرَ فَقَالَ لَہُ عَبْدُ اللّٰہِ بْنُ عُمَرَ : مُرْہَا فَلْتَرْکَبْ، ثُمَّ لْتَمْشِ مِنْ حَیْثُ عَجَزَتْ۔\nقَالَ یَحْیَی : وَسَمِعْتُ مَالِکاً یَقُولُ : وَنَرَی عَلَیْہَا مَعَ ذَلِکَ الْہَدْیَ۔ \nموطا امام مالک حدیث: 1012 عربی حدیث:"
"1014","[1014] وَحَدَّثَنِی عَنْ مَالِکٍ، عَنْ یَحْیَی بْنِ سَعِیدٍ، أَ نَّہُ قَالَ : کَانَ عَلَیَّ مَشْیٌ، فَأَصَابَتْنِی خَاصِرَۃٌ، فَرَکِبْتُ حَتَّی أَتَیْتُ مَکَّۃَ، فَسَأَلْتُ عَطَائَ بْنَ أبِی رَبَاحٍ وَغَیْرَہُ، فَقَالُوا : عَلَیْکَ ہَدْیٌ۔ فَلَمَّا قَدِمْتُ الْمَدِینَۃَ سَأَلْتُ عُلَمَائَہَا، فَأَمَرُونِی أَنْ أَمْشِیَ مَرَّۃً أُخْرَی مِنْ حَیْثُ عَجَزْتُ، فَمَشَیْتُ۔ \nموطا امام مالک حدیث: 1014 عربی حدیث:"
"1015","[1015] حَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ حُمَیْدِ بْنِ قَیْسٍ وَثَوْرِ بْنِ زَیْدٍ الدِّیلِیِّ، أَ نَّہُمَا أَخْبَرَاہُ، عَنْ رَسُولِ اللّٰہِ  ﷺ ، وَأَحَدُہُمَا یَزِیدُ فِی الْحَدِیثِ عَلَی صَاحِبِہِ، أَنَّ رَسُولَ اللّٰہِ  ﷺ  رَأَی رَجُلاً قَائِماً فِی الشَّمْسِ فَقَالَ : مَا بَالُ ہَذَا ؟ فَقَالُوا : نَذَرَ أَنْ لاَ یَتَکَلَّمَ، وَلاَ یَسْتَظِلَّ مِنَ الشَّمْسِ، وَلاَ یَجْلِسَ وَیَصُومَ۔ فَقَالَ رَسُولُ اللّٰہِ  ﷺ : مُرُوہُ فَلْیَتَکَلَّمْ، وَلْیَسْتَظِلَّ، وَلْیَجْلِسْ، وَلْیُتِمَّ صِیَامَہُ۔ \nموطا امام مالک حدیث: 1015 عربی حدیث:"
"1016","[1016] وَحَدَّثَنِی عَنْ مَالِکٍ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ، أَ نَّہُ سَمِعَہُ یَقُولُ : أَتَتِ امْرَأَ ۃٌ إِلَی عَبْدِ اللّٰہِ بْنِ عَبَّاسٍ فَقَالَتْ : إنِّی نَذَرْتُ أَنْ أَنْحَرَ ابْنِی۔ فَقَالَ ابْنُ عَبَّاسٍ : لاَ تَنْحَرِی ابْنَکِ، وَکَفِّرِی عَنْ یَمِینِکِ۔ فَقَالَ شَیْخٌ عِنْدَ ابْنِ عَبَّاسٍ : وَکَیْفَ یَکُونُ فِی ہَذَا کَفَّارَۃٌ ؟ فَقَالَ ابْنُ عَبَّاسٍ : إِنَّ اللّٰہَ تَعَالَی قَالَ : {الَّذِینَ یُظَاہِرُونَ مِنْکُمْ مِنْ نِسَائِہِمْ} [المجادلۃ : 2]، ثُمَّ جَعَلَ فِیہِ مِنَ الْکَفَّارَۃِ مَا قَدْ رَأَیْتَ۔ \nموطا امام مالک حدیث: 1016 عربی حدیث:"
"1017","[1017] وَحَدَّثَنِی عَنْ مَالِکٍ، عَنْ طَلْحَۃَ بْنِ عَبْدِ الْمَلِکِ الْأَیْلِیِّ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدِ بْنِ الصِّدِّیقِ، عَنْ عَائِشَۃَ أَنَّ رَسُولَ اللّٰہِ  ﷺ  قَالَ : مَنْ نَذَرَ أَنْ یُطِیعَ اللّٰہَ فَلْیُطِعْہُ، وَمَنْ نَذَرَ أَنْ یَعْصِیَ اللّٰہَ فَلاَ یَعْصِہِ۔ \nموطا امام مالک حدیث: 1017 عربی حدیث:"
"1018","[1018] حَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ، عَنْ أَبِیہِ، عَنْ عَائِشَۃَ أُمِّ الْمُؤْمِنِینَ، أَ نَّہَا کَانَتْ تَقُولُ : لَغْوُ الْیَمِینِ قَوْلُ الإِنْسَانِ : لاَ وَاللّٰہِ، بَلَی وَاللّٰہِ۔ \nموطا امام مالک حدیث: 1018 عربی حدیث:"
"1019","[1019] حَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ نَافِعٍ، عَنْ عَبْدِ اللّٰہِ بْنِ عُمَرَ، أَ نَّہُ کَانَ یَقُولُ : مَنْ قَالَ : وَاللّٰہِ، ثُمَّ قَالَ : إِنْ شَائَ اللّٰہُ، ثُمَّ لَمْ یَفْعَلِ الَّذِی حَلَفَ عَلَیْہِ، لَمْ یَحْنَثْ۔ \nموطا امام مالک حدیث: 1019 عربی حدیث:"
"1020","[1020] حَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ سُہَیْلِ بْنِ أبِی صَالِحٍ، عَنْ أَبِیہِ، عَنْ أبِی ہُرَیْرَۃَ، أَنَّ رَسُولَ اللّٰہِ  ﷺ  قَالَ : مَنْ حَلَفَ بِیَمِینٍ، فَرَأَی غَیْرَہَا خَیْراً مِنْہَا، فَلْیُکَفِّرْ عَنْ یَمِینِہِ، وَلْیَفْعَلِ الَّذِی ہُوَ خَیْرٌ۔ \nموطا امام مالک حدیث: 1020 عربی حدیث:"
"1021","[1021] حَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ نَافِعٍ، عَنْ عَبْدِ اللّٰہِ بْنِ عُمَرَ، أَ نَّہُ کَانَ یَقُولُ : مَنْ حَلَفَ بِیَمِینٍ فَوَکَّدَہَا، ثُمَّ حَنِثَ فَعَلَیْہِ عِتْقُ رَقَبَۃٍ، أَوْ کِسْوَۃُ عَشَرَۃِ مَسَاکِینَ، وَمَنْ حَلَفَ بِیَمِینٍ فَلَمْ یُؤَکِّدْہَا، ثُمَّ حَنِثَ، فَعَلَیْہِ إِطْعَامُ عَشَرَۃِ مَسَاکِینَ، لِکُلِّ مِسْکِینٍ مُدٌّ مِنْ حِنْطَۃٍ، فَمَنْ لَمْ یَجِدْ فَصِیَامُ ثَـلَاثَۃِ أَیَّامٍ۔ \nموطا امام مالک حدیث: 1021 عربی حدیث:"
"1022","[1022] وَحَدَّثَنِی عَنْ مَالِکٍ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ، أَ نَّہُ قَالَ : أَدْرَکْتُ النَّاسَ وَہُمْ إِذَا أَعْطَوْا فِی کَفَّارَۃِ الْیَمِینِ أَعْطَوْا مُدًّا مِنْ حِنْطَۃٍ، بِالْمُدِّ الأَصْغَرِ، وَرَأَوْا ذَلِکَ مُجْزِئاً عَنْہُمْ۔\nموطا امام مالک حدیث: 1022 عربی حدیث:"
"1023","[1023] وَحَدَّثَنِی عَنْ مَالِکٍ، عَنْ نَافِعٍ، عَنْ عَبْدِ اللّٰہِ بْنِ عُمَرَ، أَ نَّہُ کَانَ یُکَفِّرُ عَنْ یَمِینِہِ بِإِطْعَامِ عَشَرَۃِ مَسَاکِینَ، لِکُلِّ مِسْکِینٍ مُدٌّ مِنْ حِنْطَۃٍ، وَکَانَ یَعْتِقُ الْمِرَارَ إِذَا وَکَّدَ الْیَمِینَ۔ \nموطا امام مالک حدیث: 1023 عربی حدیث:"
"1024","[1024] حَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ نَافِعٍ، عَنْ عَبْدِ اللّٰہِ بْنِ عُمَرَ، أَنَّ رَسُولَ اللّٰہِ  ﷺ  أَدْرَکَ عُمَرَ بْنَ الْخَطَّابِ  رضی اللہ عنہ ، وَہُوَ یَسِیرُ فِی رَکْبٍ، وَہُوَ یَحْلِفُ بِأَبِیہِ، فَقَالَ رَسُولُ اللّٰہِ  ﷺ : إِنَّ اللّٰہَ یَنْہَاکُمْ أَنْ تَحْلِفُوا بِآبَائِکُمْ، فَمَنْ کَانَ حَالِفاً فَلْیَحْلِفْ بِاللّٰہِ أَوْ لِیَصْمُتْ۔ \nموطا امام مالک حدیث: 1024 عربی حدیث:"
"1025","[1025] وَحَدَّثَنِی عَنْ مَالِکٍ، أَنَّہُ بَلَغَہُ أَنَّ رَسُولَ اللّٰہِ  ﷺ  کَانَ یَقُولُ : لاَ وَمُقَلِّبِ الْقُلُوبِ۔ \nموطا امام مالک حدیث: 1025 عربی حدیث:"
"1026","[1026] وَحَدَّثَنِی عَنْ مَالِکٍ، عَنْ عُثْمَانَ بْنِ حَفْصِ بْنِ عُمَرَ بْنِ خَلْدَۃَ، عَنِ ابْنِ شِہَابٍ، أَ نَّہُ بَلَغَہُ : أَنَّ أَبَا لُبَابَۃَ بْنَ عَبْدِ الْمُنْذِرِ حِینَ تَابَ اللّٰہُ عَلَیْہِ قَالَ : یَا رَسُولَ اللّٰہِ أَہْجُرُ دَارَ قَوْمِی الَّتِی أَصَبْتُ فِیہَا الذَّنْبَ، وَأُجَاوِرُکَ وَأَنْخَلِعُ مِنْ مَالِی صَدَقَۃً إِلَی اللّٰہِ وَإِلَی رَسُولِہِ, فَقَالَ رَسُولُ اللّٰہِ  ﷺ  : یُجْزِیکَ مِنْ ذَلِکَ الثُّلُثُ۔\nموطا امام مالک حدیث: 1026 عربی حدیث:"
"1027","[1027] وَحَدَّثَنِی عَنْ مَالِکٍ، عَنْ أَیُّوبَ بْنِ مُوسَی، عَنْ مَنْصُورِ بْنِ عَبْدِ الرَّحْمَنِ الْحَجَبِیِّ، عَنْ أُمِّہِ، عَنْ عَائِشَۃَ أُمِّ الْمُؤْمِنِینَ رَضِیَ اللّٰہُ عَنْہَا، أَ نَّہَا سُئِلَتْ عَنْ رَجُلٍ قَالَ : مَالِی فِی رِتَاجِ الْکَعْبَۃِ ؟ فَقَالَتْ عَائِشَۃُ : یُکَفِّرُہُ مَا یُکَفِّرُ الْیَمِینَ۔\nموطا امام مالک حدیث: 1027 عربی حدیث:"
