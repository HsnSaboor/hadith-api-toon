"19983","(۱۹۹۸۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَخَذْت الصَّیْدَ وَبِہِ رَمَقٌ فَمَاتَ فِی یَدِکَ فَلاَ تَأْکُلْہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19983","","","كتاب الصيد"
"19984","(۱۹۹۸۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ أَنَّہُ رَمَی دُبسیًا بِحَجَرٍ فَأَخَذَ عَبْدُ اللہِ یُعَالِجُہُ بِقَدُومٍ مَعَہُ لِیَذْبَحَہُ فَمَاتَ فِی یَدِہِ قَبْلَ أَنْ یَذْبَحَہُ فَأَلْقَاہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 19984","","","كتاب الصيد"
"19985","(۱۹۹۸۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا کُنْتَ فِی تَخْلِیصِ الصَّیْدِ فَسَبَقَک بِنَفْسِہِ فَلاَ بَأْسَ أَنْ تَأْکُلَہُ ، وَإِنْ تَرَبَّصْت بِہِ فَمَاتَ فَلاَ تَأْکُلْہُ۔","","Musannaf Ibn Abi Shaybah 19985","","","كتاب الصيد"
"19986","(۱۹۹۸۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ عَنِ الرَّجُلِ یُدْرِکُ الصَّیْدَ وَبِہِ رَمَقٌ فَیَدَعُ الْکَلْبَ حَتَّی یَقْتُلَہُ ، قَالَ : لاَ یَأْکُلُ۔","","Musannaf Ibn Abi Shaybah 19986","","","كتاب الصيد"
"19987","(۱۹۹۸۷) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ أَبِی حَرَّۃَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ أَرْسَلَ کَلْبَہُ عَلَی صَیْدٍ ، فَأَدْرَکَ الصَّیْدَ وَبِہِ رَمَقٌ ، فَمَاتَ فِی یَدَیْہِ ، فَقَالَ : إذَا کَانَ الْکَلْبُ مُکَلَّبًا فَلْیَأْکُلْ۔","","Musannaf Ibn Abi Shaybah 19987","","","كتاب الصيد"
"19988","(۱۹۹۸۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : کَانَ أَحَدُہُمْ یُرْسِلُ کَلْبَہُ وَیُسَمِّی ، وَلاَ یَرَی صَیْدًا فَإِذَا صَادَ أَکَلَہُ۔","","Musannaf Ibn Abi Shaybah 19988","","","كتاب الصيد"
"19989","(۱۹۹۸۹) حَدَّثَنَا حَفْصٌ، عَنْ حَجَّاجٍ، قَالَ: سَأَلْتُ عَطَائً عَنِ الْکِلاَبِ تَنْفَلِتُ مِنْ مَرَابِطِہَا فَتَقْتُلُ، قَالَ: لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 19989","","","كتاب الصيد"
"19990","(۱۹۹۹۰) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ مَعْرُوف ، قَالَ : خَرَجْنَا بِکِلاَبٍ فَلَقِینَا ابْنَ عُمَرَ ، فَقَالَ : إذَا أَرْسَلْتُمُوہُ فَسَمُّوا اللَّہَ عَلَیْہَا وَقُولُوا : اللَّہُمَّ اہْدِ صُدُورَہَا۔","","Musannaf Ibn Abi Shaybah 19990","","","كتاب الصيد"
"19991","(۱۹۹۹۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زُہَیْرِ بْنِ مُحَمَّدٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، أَنَّ أَبَاہُ کَانَ إذَا أَرْسَلَ کِلاَبَہُ ، قَالَ : اللَّہُمَّ اہْدِ صُدُورَہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 19991","","","كتاب الصيد"
"19992","(۱۹۹۹۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، قَالَ : إِنْ شَرِبَ مِنْ دَمِہِ فَلاَ تَأْکُلْ ، فَإِنَّہُ لَمْ یَعْلَمْ مَا عَلَّمْتہ۔",": Da'if","Musannaf Ibn Abi Shaybah 19992","","","كتاب الصيد"
"19993","(۱۹۹۹۳) حَدَّثَنَا حَفْصُ بْنُ غِیاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : إِنْ أَکَلَ فَلاَ تَأْکُلْ ، وَإِنْ شَرِبَ فَکُلْ۔","","Musannaf Ibn Abi Shaybah 19993","","","كتاب الصيد"
"19994","(۱۹۹۹۴) حَدَّثَنَا حَفْصُ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ قَالَ : إِنْ أَکَلَ فَلاَ تَأْکُلُ ، وَإِنْ شَرِبَ فَلاَ تَأْکُلْ۔","","Musannaf Ibn Abi Shaybah 19994","","","كتاب الصيد"
"19995","(۱۹۹۹۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إِنْ أَکَلَ فَکُلْ وَإِنْ شَرِبَ فَکُلْ۔","","Musannaf Ibn Abi Shaybah 19995","","","كتاب الصيد"
"19996","(۱۹۹۹۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ فِی الطَّیْرِ والْبُزَاۃِ وَالصُّقُورِ وَغَیْرِہَا ، وَمَا أَدْرَکْت ذَکَاتَہُ فَہُوَ لَکَ ، وَمَا لَمْ تُدْرَکْ ذَکَاتُہُ فَلاَ تَأْکُلْہُ۔","","Musannaf Ibn Abi Shaybah 19996","","","كتاب الصيد"
"19997","(۱۹۹۹۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : الْکَلْبُ وَالْبَازِی شَیْئٌ وَاحِدٌ ، کُلٌّ صُیُودٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19997","","","كتاب الصيد"
"19998","(۱۹۹۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ وَوَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْہَیْثَمِ ، عَنْ طَلْحَۃَ بْنِ مُصَرِّف ، قَالَ : قَالَ خَیْثَمَۃُ بْنُ عَبْدِ الرَّحْمَنِ : ہَذَا مَا قَدْ أَثْبَتُّ لَکَ ، إِنَّ الصُّقُورَ وَالْبَازِیَ مِنَ الْجَوَارِحِ۔","","Musannaf Ibn Abi Shaybah 19998","","","كتاب الصيد"
"19999","(۱۹۹۹۹) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ وُہَیْبٍ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ لَمْ یَرَ بَأْسًا بِصَیْدِ الْبَازِی وَالصَّقْرِ۔","","Musannaf Ibn Abi Shaybah 19999","","","كتاب الصيد"
"20000","(۲۰۰۰۰) حَدَّثَنَا مُعَاذٌ قَالَ : أَخْبَرَنَا أَشْعَثُ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ فِی الصَّقْرِ وَالْبَازِی ہما بِمَنْزِلَۃِ الْکَلْبِ۔","","Musannaf Ibn Abi Shaybah 20000","","","كتاب الصيد"
"20001","(۲۰۰۰۱) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْقَاسِمِ ، عَنْ مُجَاہِدٍ : {وَمَا عَلَّمْتُمْ مِنَ الْجَوَارِحِ مُکَلِّبِینَ} قَالَ : مِنَ الطَّیْرِ وَالْکِلاَبِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 20001","","","كتاب الصيد"
"20002","(۲۰۰۰۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، قَالَ : سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ صَیْدِ الْبَازِی ، فَقَالَ : مَا أَمْسَکَ عَلَیْک فَکُلْ۔ (ابوداؤد ۲۸۴۵۔ احمد ۴/۲۵۷)",": Da'if","Musannaf Ibn Abi Shaybah 20002","","","كتاب الصيد"
"20003","(۲۰۰۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَالِمٍ ، عَنْ سَعِیدٍ قَالَ : إِذَا أَکَلَ فَلاَ تَأْکُلْ۔","","Musannaf Ibn Abi Shaybah 20003","","","كتاب الصيد"
"20004","(۲۰۰۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، وَعَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالاَ : کُلْ مِنْ صَیْدِ الْبَازِی ، وَإِنْ أَکَلَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 20004","","","كتاب الصيد"
"20005","(۲۰۰۰۵) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ فِی الصَّقْرِ وَالْکَلْبِ : إِنْ أَصَابَ مِنْہُ ، أَوْ أَکَلَ مِنْہُ فَکُلْ، وَإِنْ أَکَلَ۔","","Musannaf Ibn Abi Shaybah 20005","","","كتاب الصيد"
"20006","(۲۰۰۰۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ فِی الْکَلْبِ إذَا کَانَ مُعَلَّمًا فَأَصَابَ صَیْدًا ، أَوِ الْبَازِی فَأَکَلَ فَلاَ تَأْکُلْ۔","","Musannaf Ibn Abi Shaybah 20006","","","كتاب الصيد"
"20007","(۲۰۰۰۷) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنِ الشَّیْبَانِیِّ ، عَنْ حَمَّادٍ ، قَالَ : إذَا نَتَفَ الطَّیْرَ ، أَوْ أَکَلَ فَکُلْ ، فَإِنَّمَا تَعْلِیمُہُ أَنْ یَرْجِعَ إلَیْک۔","","Musannaf Ibn Abi Shaybah 20007","","","كتاب الصيد"
"20008","(۲۰۰۰۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ وَالْحَکَمِ ، قَالاَ : إذَا أَرْسَلْت صَقْرَک ، أَوْ بَازیک ، ثُمَّ دَعَوْتہ فَأَتَاک فَذَاکَ عِلْمُہُ ، فَإِذا أَرْسَلْت عَلَی صَیْدٍ فَأَکَلَ فَکُلْ۔","","Musannaf Ibn Abi Shaybah 20008","","","كتاب الصيد"
"20009","(۲۰۰۰۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ دَاوُدَ بْنِ أَبِی الْفُرَاتِ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ سَلْمَانَ ، قَالَ : إذَا أَرْسَلْت کَلْبَک أو بَازیک فَکُلْ ، وَإِنْ أَکَلَ ثُلُثَہُ۔","","Musannaf Ibn Abi Shaybah 20009","","","كتاب الصيد"
"20010","(۲۰۰۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ الْوَلِیدِ الشَّنی ، عَنْ عِکْرِمَۃَ ، قَالَ : إذَا أَکَلَ الْبَازُ ، أَوِ الصَّقْرُ فَلاَ تَأْکُلْ۔","","Musannaf Ibn Abi Shaybah 20010","","","كتاب الصيد"
"20011","(۲۰۰۱۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، وَعَطَائٍ فِی الْبَازِی وَالصَّقْرِ : یَأْکُلُ ، قَالَ عَطَائٌ : إذَا أَکَلَ فَلاَ تَأْکُلْ ، وَقَالَ : الْحَسَنُ : کُلْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 20011","","","كتاب الصيد"
"20012","(۲۰۰۱۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ لَمْ یَرَ بِصَیْدِ الْفَہْدِ بَأْسًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 20012","","","كتاب الصيد"
"20013","(۲۰۰۱۳) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِی نَجِیح ، عَنْ مُجَاہِدٍ ، قَالَ : الْفَہْد مِنَ الْجَوَارِح۔","","Musannaf Ibn Abi Shaybah 20013","","","كتاب الصيد"
"20014","(۲۰۰۱۴) حدَّثَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ ، قَالَ : لاَ بَأْسَ بِصَیْدِ الْفَہْدِ۔","","Musannaf Ibn Abi Shaybah 20014","","","كتاب الصيد"
"20015","(۲۰۰۱۵) حَدَّثَنَا رَوَّاد بْنُ الْجَرَّاح ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ بَأْسَ بِصَیْدِ الْفَہْدِ۔","","Musannaf Ibn Abi Shaybah 20015","","","كتاب الصيد"
"20016","(۲۰۰۱۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : أَخْبَرَنَا أَشْعَثُ ، عَنِ الْحَسَنِ ، قَالَ : الْفَہْدُ وَالشَّاہِینُ بِمَنْزِلَۃِ الْکَلْبِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 20016","","","كتاب الصيد"
"20017","(۲۰۰۱۷) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنِ الشَّیْبَانِیِّ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَکْرَہُ صَیْدَ الْکَلْبِ وَالْفَہْدِ إذَا أَکَلَ مِنْہُ وَکَانَ لاَ یَرَی بَأْسًا بِصَیْدِ الْبَازِی إذَا أَکَلَ لأَنَّ الْکَلْبَ وَالْفَہْدَ یُضَرَّیَانِ وَالْبَازِ لاَ یُضَرَّی۔","","Musannaf Ibn Abi Shaybah 20017","","","كتاب الصيد"
"20018","(۲۰۰۱۸) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : لاَ بَأْسَ بِصَیْدِ الْمَجُوسِیِّ السَّمَکِ۔","","Musannaf Ibn Abi Shaybah 20018","","","كتاب الصيد"
"20019","(۲۰۰۱۹) حَدَّثَنَا أَبُو الأَحْوَص، عَنْ سِمَاکٍ، عَنْ عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: کُلِ السَّمَکَ، لاَ یَضُرُّک مَنْ صَادَہُ۔",": Hasan","Musannaf Ibn Abi Shaybah 20019","","","كتاب الصيد"
"20020","(۲۰۰۲۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ یُؤْکَلُ مِنْ صَیْدِ الْمَجُوسِیِّ إِلاَّ الْحِیتَانَ۔","","Musannaf Ibn Abi Shaybah 20020","","","كتاب الصيد"
"20021","(۲۰۰۲۱) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ مُغِیرَۃَ بْنِ زِیَادٍ ، عَنْ مَکْحُولٍ ، قَالَ : کُلْ صَیْدَ الْبَحْرِ مَا صَادَہ الْیَہُودِیُّ وَالنَّصْرَانِیُّ وَالْمَجُوسِیُّ۔","","Musannaf Ibn Abi Shaybah 20021","","","كتاب الصيد"
"20022","(۲۰۰۲۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِصَیْدِ الْمَجُوسِیِّ السَّمَکَ۔","","Musannaf Ibn Abi Shaybah 20022","","","كتاب الصيد"
"20023","(۲۰۰۲۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ ہَارُونَ بْنِ سَعْدٍ ، عَنْ عِکْرِمَۃَ قَالَ : کُلْ مِنْ صَیْدِ الْمَجُوسِیِّ وَالنَّصْرَانِیِّ وَالْیَہُودِیِّ لِلسَّمَکِ۔","","Musannaf Ibn Abi Shaybah 20023","","","كتاب الصيد"
"20024","(۲۰۰۲۴) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ الْکَرِیمِ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ أَنَّہُمَا لَمْ یَرَیَا بَأْسًا بِصَیْدِ الْمَجُوسِیِّ لِلسَّمَکِ۔","","Musannaf Ibn Abi Shaybah 20024","","","كتاب الصيد"
"20025","(۲۰۰۲۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَسَنِ بْنِ صَالِحٍ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ ، قَالَ : سَأَلْتُہ عَنِ الْمَجُوسِیِّ یَصِیدُ السَّمَکَ ، قَالَ : صَیْدُہُ ذَکِیٌّ۔","","Musannaf Ibn Abi Shaybah 20025","","","كتاب الصيد"
"20026","(۲۰۰۲۶) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ، عَنْ مُغِیرَۃَ، عَنْ حَمَّادٍ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِصَیْدِ الْمَجُوسِیِّ یَعْنِی لِلسَّمَکِ۔","","Musannaf Ibn Abi Shaybah 20026","","","كتاب الصيد"
"20027","(۲۰۰۲۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ، عَنْ حَجَّاجٍ، عَنْ عَطَائٍ، قَالَ: لاَ تَأْکُلُ مِنْ صَیْدِ الْمَجُوسِیِّ إِلاَّ السَّمَکَ وَالْجَرَادَ۔","","Musannaf Ibn Abi Shaybah 20027","","","كتاب الصيد"
"20028","(۲۰۰۲۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ وَالنَّخَعِیِّ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا بِصَیْدِ الْمَجُوسِیِّ لِلسَّمَکِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 20028","","","كتاب الصيد"
"20029","(۲۰۰۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُؤْکَلُ صَیْدُہُمْ فِی الْبَحْرِ ، وَلاَ یُؤْکَلُ صَیْدُہُمْ فِی الْبَرِّ۔",": No Data Available","Musannaf Ibn Abi Shaybah 20029","","","كتاب الصيد"
"20030","(۲۰۰۳۰) حَدَّثَنَا وَکِیعٌ ، وَعَلِیُّ بْنُ ہَاشِمٍ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ عِیسَی بْنِ عَاصِمٍ ، عَنْ عَلِیٍّ ، أَنَّہُ کَرِہَ صَیْدَ الْمَجُوسِیِّ لِلسَّمَکِ۔","","Musannaf Ibn Abi Shaybah 20030","","","كتاب الصيد"
"20031","(۲۰۰۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ عَطَائٍ ، قَالَ : سَأَلْتُہ عَنْ صَیْدِ الْمَجُوسِیِّ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 20031","","","كتاب الصيد"
"20032","(۲۰۰۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنَ جُبَیْرٍ ، قَالَ : لاَ تَأْکُلْ مِنْ صَیْدِ الْمَجُوسِیِّ سَمَّی ، أَوْ لَمْ یُسَمِّ۔",": No Data Available","Musannaf Ibn Abi Shaybah 20032","","","كتاب الصيد"
"20033","(۲۰۰۳۳) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، عَنْ أَبِی رَزِینٍ ، قَالَ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِأَرْنَبٍ ، فَقَالَ : إنِّی رَمَیْت أَرْنَبًا فَأَعْجَزَنِی طَلَبُہَا حَتَّی أَدْرَکَنِی اللَّیْلُ فَلَمْ أَقْدِرْ عَلَیْہَا حَتَّی أَصْبَحْت فَوَجَدْتہَا وَفِیہَا سَہْمِی ، فَقَالَ : أَصْمَیْتَ ، أَوْ أَنْمَیْت ؟ قَالَ : لاَ بَلْ أَنْمَیْت ، قَالَ : إنَّ اللَّیْلَ خَلْقٌ مِنْ خَلْقِ اللہِ عَظِیمٌ ، لاَ یَقْدُرُ قدرہ إِلاَّ الَّذِی خَلَقَہُ لَعَلَّہُ أَعَانَ عَلَی قَتْلِہَا شَیْئٌ انْبِذْہَا۔ (ابوداؤد ۳۸۳)","","Musannaf Ibn Abi Shaybah 20033","","","كتاب الصيد"
"20034","(۲۰۰۳۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَیَحْیَی بْنُ آدَمَ ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی رَزِینٍ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوٍ مِنْہُ۔ (بیہقی ۲۴۱)",": Da'if","Musannaf Ibn Abi Shaybah 20034","","","كتاب الصيد"
"20035","(۲۰۰۳۵) حَدَّثَنَا أبو مُعَاوِیَۃ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : جَائَ رَجُلٌ إلَی أَبِی الدَّرْدَائِ ، فَقَالَ : إنِّی أَرْمِی الصَّیْدَ فَیَغِیبُ عَنِّی ، ثُمَّ أَجِدُ سَہْمِی فِیہِ مِنَ الْغَدِ أَعْرِفُہُ ، قَالَ : أَمَّا أَنَا فَکُنْت آکُلُہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 20035","","","كتاب الصيد"
"20036","(۲۰۰۳۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَجْلَحِ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْہُذَیْلِ ، قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ وَسَأَلَہُ عَبْدٌ أَسْوَدُ ، فَقَالَ لَہُ : یَا أَبَا عَبَّاسٍ ، إنِّی أَرْمِی الصَّیْدَ فَأُصْمِی وَأُنْمِی ، فَقَالَ : مَا أَصْمَیْتَ فَکُلْ وَمَا أَنْمَیْت فَلاَ تَأْکُلْ۔",": Hasan","Musannaf Ibn Abi Shaybah 20036","","","كتاب الصيد"
"20037","(۲۰۰۳۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ بِنَحْوٍ مِنْ حَدِیثِ حَفْصٍ۔","","Musannaf Ibn Abi Shaybah 20037","","","كتاب الصيد"
"20038","(۲۰۰۳۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إذَا رَمَی ، ثُمَّ وَجَدَ سَہْمَہُ مِنَ الْغَدِ فَلْیَأْکُلْ۔",": Sahih","Musannaf Ibn Abi Shaybah 20038","","","كتاب الصيد"
"20039","(۲۰۰۳۹) حَدَّثَنَا ابن فُضَیْل ، عَنْ حُصَیْنٍ ، عَنْ عَامِرٍ ؛ فِی الرَّجُلِ یَرْمِی الصَّیْدَ فَیَغِیبُ عَنْہُ ، قَالَ : فَإِنْ وَجَدْتہ لَمْ یَقَعْ فِی مَائٍ ، وَلَمْ یَقَعْ مِنْ جَبَلٍ ، وَلَمْ یَأْکُلْ مِنْہُ سَبُعٌ فَکُلْ۔","","Musannaf Ibn Abi Shaybah 20039","","","كتاب الصيد"
"20040","(۲۰۰۴۰) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : إذَا وَجَدْت سَہْمَک فِیہِ مِنَ الْغَدِ فَعَرَفْتہ فَلاَ بَأْسَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 20040","","","كتاب الصيد"
