hadiths[count]{hadithnumber,text}:
"449.1","Abdullah b. Ebu Bekir b. Amr b. Hazm (r.a) Abbad b. Temim'i şöyle derken işitmiştir: \"\"Abdullah b. Zeyd el-Mazini'den işittim şöyle diyordu: \"\"Rasuluilah Sallallahu Aleyhi ve Sellem namazgaha çıkarak yağmur yağması için dua etti"
"449.2","Abdullah b. Ebu Bekir b. Amr b. Hazm (r.a) Abbad b. Temim'i şöyle derken işitmiştir: \"\"Abdullah b. Zeyd el-Mazini'den işittim şöyle diyordu: \"\"Rasuluilah Sallallahu Aleyhi ve Sellem namazgaha çıkarak yağmur yağması için dua etti"
"450.1","Amr b. Şuayb (r.a)'dan rivayete göre"
"450.2","Amr b. Şuayb (r.a)'dan rivayete göre"
"451.1","Enes b. Malik (r.a)'den rivayete göre"
"451.2","Enes b. Malik (r.a)'den rivayete göre"
"452.1","Zeyd b. Halid el Cüheni (r.a)'den rivayete göre"
"452.2","Zeyd b. Halid el Cüheni (r.a)'den rivayete göre"
"453.1","Malik (r.a.) diyor ki: \"\"Bana ulaştığına göre Rasulullah Sallallahu Aleyhi ve Sellem şöyle buyurmuştur: \"\"Deniz tarafından bir bulut ortaya çıkar"
"453.2","Malik (r.a.) diyor ki: \"\"Bana ulaştığına göre Rasulullah Sallallahu Aleyhi ve Sellem şöyle buyurmuştur: \"\"Deniz tarafından bir bulut ortaya çıkar"
"454.1","Malik (r.a) diyor ki: \"\"Bana ulaştığına göre"
"454.2","Malik (r.a) diyor ki: \"\"Bana ulaştığına göre"
