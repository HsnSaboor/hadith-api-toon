hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"6805","حَدَّثَنَا حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، وَزُهَيْرُ بْنُ حَرْبٍ وَاللَّفْظُ لِقُتَيْبَةَ، قَالَا: حَدَّثَنَا جَرِيرٌ ، عَنْ الْأَعْمَشِ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" يَقُولُ اللَّهُ عَزَّ وَجَلَّ: أَنَا عِنْدَ ظَنِّ عَبْدِي بِي، وَأَنَا مَعَهُ حِينَ يَذْكُرُنِي إِنْ ذَكَرَنِي فِي نَفْسِهِ ذَكَرْتُهُ فِي نَفْسِي، وَإِنْ ذَكَرَنِي فِي مَلَإٍ ذَكَرْتُهُ فِي مَلَإٍ هُمْ خَيْرٌ مِنْهُمْ، وَإِنْ تَقَرَّبَ مِنِّي شِبْرًا تَقَرَّبْتُ إِلَيْهِ ذِرَاعًا، وَإِنْ تَقَرَّبَ إِلَيَّ ذِرَاعًا تَقَرَّبْتُ مِنْهُ بَاعًا، وَإِنْ أَتَانِي يَمْشِي أَتَيْتُهُ هَرْوَلَةً \""\""،nصحیح مسلم حدیث: 6805 عربی حدیث: 2675""","Sahih","Sahih Muslim 6805","","","1. باب: جو شخص اچھی بات جاری کرے یا بری بات جاری کرے۔ذکر الہیٰ کی ترغیبChapter: Encouragement To Remember Allah, Exalted is He"
"6806","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، قَالَا: حَدَّثَنَا أَبُو مُعَاوِيَةَ ، عَنْ الْأَعْمَشِ ، بِهَذَا الْإِسْنَادِ وَلَمْ يَذْكُرْ، وَإِنْ تَقَرَّبَ إِلَيَّ ذِرَاعًا تَقَرَّبْتُ مِنْهُ بَاعًا.nصحیح مسلم حدیث: 6806 عربی حدیث: 2675","Sahih","Sahih Muslim 6806","","","1. باب: جو شخص اچھی بات جاری کرے یا بری بات جاری کرے۔ذکر الہیٰ کی ترغیبChapter: Encouragement To Remember Allah, Exalted is He"
"6807","حَدَّثَنَا حَدَّثَنَا مُحَمَّدُ بْنُ رَافِعٍ ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، حَدَّثَنَا مَعْمَرٌ ، عَنْ هَمَّامِ بْنِ مُنَبِّهٍ ، قَالَ: هَذَا مَا حَدَّثَنَا أَبُو هُرَيْرَةَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَذَكَرَ أَحَادِيثَ مِنْهَا، وَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِنَّ اللَّهَ قَالَ: \\"" إِذَا تَلَقَّانِي عَبْدِي بِشِبْرٍ تَلَقَّيْتُهُ بِذِرَاعٍ، وَإِذَا تَلَقَّانِي بِذِرَاعٍ تَلَقَّيْتُهُ بِبَاعٍ، وَإِذَا تَلَقَّانِي بِبَاعٍ أَتَيْتُهُ بِأَسْرَعَ \""\"".nصحیح مسلم حدیث: 6807 عربی حدیث: 2675""","Sahih","Sahih Muslim 6807","","","1. باب: جو شخص اچھی بات جاری کرے یا بری بات جاری کرے۔ذکر الہیٰ کی ترغیبChapter: Encouragement To Remember Allah, Exalted is He"
"6808","حَدَّثَنَا أُمَيَّةُ بْنُ بِسْطَامَ الْعَيْشِيُّ ، حَدَّثَنَا يَزِيدُ يَعْنِي ابْنَ زُرَيْعٍ ، حَدَّثَنَا رَوْحُ بْنُ الْقَاسِمِ ، عَنْ الْعَلَاءِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَسِيرُ فِي طَرِيقِ مَكَّةَ، فَمَرَّ عَلَى جَبَلٍ يُقَالُ لَهُ جُمْدَانُ، فَقَالَ: \\"" سِيرُوا هَذَا جُمْدَانُ سَبَقَ الْمُفَرِّدُونَ \""\""، قَالُوا: وَمَا الْمُفَرِّدُونَ يَا رَسُولَ اللَّهِ؟ قَالَ: \""\"" الذَّاكِرُونَ اللَّهَ كَثِيرًا وَالذَّاكِرَاتُ \""\"".nصحیح مسلم حدیث: 6808 عربی حدیث: 2676""","Sahih","Sahih Muslim 6808","","","1. باب: جو شخص اچھی بات جاری کرے یا بری بات جاری کرے۔ذکر الہیٰ کی ترغیبChapter: Encouragement To Remember Allah, Exalted is He"
"6809","حَدَّثَنَا عَمْرٌو النَّاقِدُ ، وَزُهَيْرُ بْنُ حَرْبٍ ، وَابْنُ أَبِي عُمَرَ جَمِيعًا، عَنْ سُفْيَانَ وَاللَّفْظُ لِعَمْرٍو، حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ، عَنْ أَبِي الزِّنَادِ ، عَنْ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ: \\"" لِلَّهِ تِسْعَةٌ وَتِسْعُونَ اسْمًا مَنْ حَفِظَهَا دَخَلَ الْجَنَّةَ، وَإِنَّ اللَّهَ وِتْرٌ يُحِبُّ الْوِتْرَ \""\"" وَفِي رِوَايَةِ ابْنِ أَبِي عُمَرَ مَنْ أَحْصَاهَا.nصحیح مسلم حدیث: 6809 عربی حدیث: 2677""","Sahih","Sahih Muslim 6809","","","2. باب: اللہ تعالیٰ کے ناموں کا بیان اور اس کو یاد کرنے کی فضیلت۔اللہ تعالیٰ کے اسمائے حسنیٰ اور ان کو یاد کرنے (ان کا ذکر کرنے) کی فضیلتChapter: The Names Of Allah, Exalted is He, And The Virtue Of The One Who Learns Them By Heart"
"6810","حَدَّثَنِي مُحَمَّدُ بْنُ رَافِعٍ ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، حَدَّثَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ ابْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، وَعَنْ هَمَّامِ بْنِ مُنَبِّهٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" إِنَّ لِلَّهِ تِسْعَةً وَتِسْعِينَ اسْمًا مِائَةً إِلَّا وَاحِدًا، مَنْ أَحْصَاهَا دَخَلَ الْجَنَّةَ \""\""، وَزَادَ هَمَّامٌ، عَنْ أَبِي هُرَيْرَةَ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: إِنَّهُ وِتْرٌ يُحِبُّ الْوِتْرَ.nصحیح مسلم حدیث: 6810 عربی حدیث: 2677""","Sahih","Sahih Muslim 6810","","","2. باب: اللہ تعالیٰ کے ناموں کا بیان اور اس کو یاد کرنے کی فضیلت۔اللہ تعالیٰ کے اسمائے حسنیٰ اور ان کو یاد کرنے (ان کا ذکر کرنے) کی فضیلتChapter: The Names Of Allah, Exalted is He, And The Virtue Of The One Who Learns Them By Heart"
"6811","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَزُهَيْرُ بْنُ حَرْبٍ جَمِيعًا، عَنْ ابْنِ عُلَيَّةَ ، قَالَ أَبُو بَكْرٍ حَدَّثَنَا إِسْمَاعِيلُ ابْنُ عُلَيَّةَ، عَنْ عَبْدِ الْعَزِيزِ بْنِ صُهَيْبٍ ، عَنْ أَنَسٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" إِذَا دَعَا أَحَدُكُمْ، فَلْيَعْزِمْ فِي الدُّعَاءِ، وَلَا يَقُلِ اللَّهُمَّ إِنْ شِئْتَ فَأَعْطِنِي فَإِنَّ اللَّهَ لَا مُسْتَكْرِهَ لَهُ \""\"".nصحیح مسلم حدیث: 6811 عربی حدیث: 2678""","Sahih","Sahih Muslim 6811","","","3. باب: یوں دعا کرنا منع ہے کہ اگر تو چاہے تو بخش مجھ کو۔عزم اور پختگی کے ساتھ دعا کرنا اور وہ (انسان) یہ نہ کہے: (اے اللہ!) اگر تو چاہےChapter: Being Firm In Supplication And Not Saying: If You Will"
"6812","حَدَّثَنَا يَحْيَى بْنُ أَيُّوبَ ، وَقُتَيْبَةُ ، وَابْنُ حُجْرٍ ، قَالُوا: حَدَّثَنَا إِسْمَاعِيلُ يَعْنُونَ ابْنَ جَعْفَرٍ ، عَنْ الْعَلَاءِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ ّرَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" إِذَا دَعَا أَحَدُكُمْ فَلَا يَقُلِ اللَّهُمَّ اغْفِرْ لِي إِنْ شِئْتَ، وَلَكِنْ لِيَعْزِمْ الْمَسْأَلَةَ وَلْيُعَظِّمْ الرَّغْبَةَ، فَإِنَّ اللَّهَ لَا يَتَعَاظَمُهُ شَيْءٌ أَعْطَاهُ \""\"".nصحیح مسلم حدیث: 6812 عربی حدیث: 2679""","Sahih","Sahih Muslim 6812","","","3. باب: یوں دعا کرنا منع ہے کہ اگر تو چاہے تو بخش مجھ کو۔عزم اور پختگی کے ساتھ دعا کرنا اور وہ (انسان) یہ نہ کہے: (اے اللہ!) اگر تو چاہےChapter: Being Firm In Supplication And Not Saying: If You Will"
"6813","حَدَّثَنَا إِسْحَاقُ بْنُ مُوسَى الْأَنْصَارِيُّ ، حَدَّثَنَا أَنَسُ بْنُ عِيَاضٍ ، حَدَّثَنَا الْحَارِثُ وَهُوَ ابْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي ذُبَابٍ ، عَنْ عَطَاءِ بْنِ مِينَاءَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" لَا يَقُولَنَّ أَحَدُكُمُ اللَّهُمَّ اغْفِرْ لِي إِنْ شِئْتَ، اللَّهُمَّ ارْحَمْنِي إِنْ شِئْتَ لِيَعْزِمْ فِي الدُّعَاءِ، فَإِنَّ اللَّهَ صَانِعٌ مَا شَاءَ لَا مُكْرِهَ لَهُ \""\"".nصحیح مسلم حدیث: 6813 عربی حدیث: 2679""","Sahih","Sahih Muslim 6813","","","3. باب: یوں دعا کرنا منع ہے کہ اگر تو چاہے تو بخش مجھ کو۔عزم اور پختگی کے ساتھ دعا کرنا اور وہ (انسان) یہ نہ کہے: (اے اللہ!) اگر تو چاہےChapter: Being Firm In Supplication And Not Saying: If You Will"
"6814","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا إِسْمَاعِيلُ يَعْنِي ابْنَ عُلَيَّةَ ، عَنْ عَبْدِ الْعَزِيزِ ، عَنْ أَنَسٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" لَا يَتَمَنَّيَنَّ أَحَدُكُمُ الْمَوْتَ لِضُرٍّ نَزَلَ بِهِ، فَإِنْ كَانَ لَا بُدَّ مُتَمَنِّيًا، فَلْيَقُلِ اللَّهُمَّ أَحْيِنِي مَا كَانَتِ الْحَيَاةُ خَيْرًا لِي، وَتَوَفَّنِي إِذَا كَانَتِ الْوَفَاةُ خَيْرًا لِي \""\""،nصحیح مسلم حدیث: 6814 عربی حدیث: 2680""","Sahih","Sahih Muslim 6814","","","4. باب: موت کی آرزو کرنا منع ہے کسی تکلیف آنے پر۔کسی نقصان یا مصیبت کے نازل ہونے پر موت کی تمنا کرنا مکروہ ہےChapter: It Is Disliked To Wish For Death Because Of Some Harm That Has Befallen One"
"6815","حَدَّثَنَا ابْنُ أَبِي خَلَفٍ ، حَدَّثَنَا رَوْحٌ ، حَدَّثَنَا شُعْبَةُ ، ح وحَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا حَمَّادٌ يَعْنِي ابْنَ سَلَمَةَ كِلَاهُمَا، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ غَيْرَ أَنَّهُ، قَالَ: مِنْ ضُرٍّ أَصَابَهُ \\"".nصحیح مسلم حدیث: 6815 عربی حدیث: 2680""","Sahih","Sahih Muslim 6815","","","4. باب: موت کی آرزو کرنا منع ہے کسی تکلیف آنے پر۔کسی نقصان یا مصیبت کے نازل ہونے پر موت کی تمنا کرنا مکروہ ہےChapter: It Is Disliked To Wish For Death Because Of Some Harm That Has Befallen One"
"6816","حَدَّثَنِي حَامِدُ بْنُ عُمَرَ ، حَدَّثَنَا عَبْدُ الْوَاحِدِ ، حَدَّثَنَا عَاصِمٌ ، عَنْ النَّضْرِ بْنِ أَنَسٍ ، وَأَنَسٌ يومئذ حي، قَالَ أَنَسٌ : لَوْلَا أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لَا يَتَمَنَّيَنَّ أَحَدُكُمُ الْمَوْتَ لَتَمَنَّيْتُهُ \""\"".nصحیح مسلم حدیث: 6816 عربی حدیث: 2680""","Sahih","Sahih Muslim 6816","","","4. باب: موت کی آرزو کرنا منع ہے کسی تکلیف آنے پر۔کسی نقصان یا مصیبت کے نازل ہونے پر موت کی تمنا کرنا مکروہ ہےChapter: It Is Disliked To Wish For Death Because Of Some Harm That Has Befallen One"
"6817","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ إِدْرِيسَ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنْ قَيْسِ بْنِ أَبِي حَازِمٍ ، قَالَ: دَخَلْنَا عَلَى خَبَّابٍ وَقَدِ اكْتَوَى سَبْعَ كَيَّاتٍ فِي بَطْنِهِ، فَقَالَ \\"" لَوْ مَا أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَانَا أَنْ نَدْعُوَ بِالْمَوْتِ لَدَعَوْتُ بِهِ \""\""،nصحیح مسلم حدیث: 6817 عربی حدیث: 2681""","Sahih","Sahih Muslim 6817","","","4. باب: موت کی آرزو کرنا منع ہے کسی تکلیف آنے پر۔کسی نقصان یا مصیبت کے نازل ہونے پر موت کی تمنا کرنا مکروہ ہےChapter: It Is Disliked To Wish For Death Because Of Some Harm That Has Befallen One"
"6818","حَدَّثَنَاه إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، وَجَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ، وَوَكِيعٌ . ح وحَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا أَبِي . ح وحَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ ، وَيَحْيَى بْنُ حَبِيبٍ ، قَالَا: حَدَّثَنَا مُعْتَمِرٌ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ رَافِعٍ ، حَدَّثَنَا أَبُو أُسَامَةَ كُلُّهُمْ، عَنْ إِسْمَاعِيلَ بِهَذَا الْإِسْنَادِ.nصحیح مسلم حدیث: 6818 عربی حدیث: 2681","Sahih","Sahih Muslim 6818","","","4. باب: موت کی آرزو کرنا منع ہے کسی تکلیف آنے پر۔کسی نقصان یا مصیبت کے نازل ہونے پر موت کی تمنا کرنا مکروہ ہےChapter: It Is Disliked To Wish For Death Because Of Some Harm That Has Befallen One"
"6819","حَدَّثَنَا مُحَمَّدُ بْنُ رَافِعٍ ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ هَمَّامِ بْنِ مُنَبِّهٍ ، قَالَ: هَذَا مَا حَدَّثَنَا أَبُو هُرَيْرَةَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ أَحَادِيثَ مِنْهَا، وَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" لَا يَتَمَنَّى أَحَدُكُمُ الْمَوْتَ، وَلَا يَدْعُ بِهِ مِنْ قَبْلِ أَنْ يَأْتِيَهُ إِنَّهُ إِذَا مَاتَ أَحَدُكُمُ انْقَطَعَ عَمَلُهُ، وَإِنَّهُ لَا يَزِيدُ الْمُؤْمِنَ عُمْرُهُ إِلَّا خَيْرًا \""\"".nصحیح مسلم حدیث: 6819 عربی حدیث: 2682""","Sahih","Sahih Muslim 6819","","","4. باب: موت کی آرزو کرنا منع ہے کسی تکلیف آنے پر۔کسی نقصان یا مصیبت کے نازل ہونے پر موت کی تمنا کرنا مکروہ ہےChapter: It Is Disliked To Wish For Death Because Of Some Harm That Has Befallen One"
"6820","حَدَّثَنَا هَدَّابُ بْنُ خَالِدٍ ، حَدَّثَنَا هَمَّامٌ ، حَدَّثَنَا قَتَادَةُ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، عَنْ عُبَادَةَ بْنِ الصَّامِتِ ، أَنَّ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ: \\"" مَنْ أَحَبَّ لِقَاءَ اللَّهِ أَحَبَّ اللَّهُ لِقَاءَهُ، وَمَنْ كَرِهَ لِقَاءَ اللَّهِ كَرِهَ اللَّهُ لِقَاءَهُ \""\""،nصحیح مسلم حدیث: 6820 عربی حدیث: 2683""","Sahih","Sahih Muslim 6820","","","5. باب: جو شخص اللہ سے ملنے کی آرزو رکھتا ہے۔جسے اللہ کی ملاقات محبوب ہو اللہ کو بھی اس سے ملنا محبوب ہوتا ہے اور جو اللہ سے ملنے کو ناپسند کرے تو اللہ بھی اس سے ملنے کو ناپسند فرماتا ہےChapter: Whoever Loves To Meet Allah, Allah Loves To Meet Him, And Whoever Hates To Meet Allah, Allah Hates To Meet Him"
"6821","وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، عَنْ قَتَادَةَ ، قَالَ: سَمِعْتُ أَنَسَ بْنَ مَالِكٍ يُحَدِّثُ، عَنْ عُبَادَةَ بْنِ الصَّامِتِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ.nصحیح مسلم حدیث: 6821 عربی حدیث: 2683","Sahih","Sahih Muslim 6821","","","5. باب: جو شخص اللہ سے ملنے کی آرزو رکھتا ہے۔جسے اللہ کی ملاقات محبوب ہو اللہ کو بھی اس سے ملنا محبوب ہوتا ہے اور جو اللہ سے ملنے کو ناپسند کرے تو اللہ بھی اس سے ملنے کو ناپسند فرماتا ہےChapter: Whoever Loves To Meet Allah, Allah Loves To Meet Him, And Whoever Hates To Meet Allah, Allah Hates To Meet Him"
"6822","حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ الرُّزِّيُّ ، حَدَّثَنَا خَالِدُ بْنُ الْحَارِثِ الْهُجَيْمِيُّ ، حَدَّثَنَا سَعِيدٌ ، عَنْ قَتَادَةَ ، عَنْ زُرَارَةَ ، عَنْ سَعْدِ بْنِ هِشَامٍ ، عَنْ عَائِشَةَ ، قَالَتْ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنْ أَحَبَّ لِقَاءَ اللَّهِ أَحَبَّ اللَّهُ لِقَاءَهُ، وَمَنْ كَرِهَ لِقَاءَ اللَّهِ كَرِهَ اللَّهُ لِقَاءَهُ \""\""، فَقُلْتُ: يَا نَبِيَّ اللَّهِ، أَكَرَاهِيَةُ الْمَوْتِ فَكُلُّنَا نَكْرَهُ الْمَوْتَ، فَقَالَ: \""\"" لَيْسَ كَذَلِكِ، وَلَكِنَّ الْمُؤْمِنَ إِذَا بُشِّرَ بِرَحْمَةِ اللَّهِ وَرِضْوَانِهِ وَجَنَّتِهِ أَحَبَّ لِقَاءَ اللَّهِ، فَأَحَبَّ اللَّهُ لِقَاءَهُ، وَإِنَّ الْكَافِرَ إِذَا بُشِّرَ بِعَذَابِ اللَّهِ وَسَخَطِهِ كَرِهَ لِقَاءَ اللَّهِ وَكَرِهَ اللَّهُ لِقَاءَهُ \""\""،nصحیح مسلم حدیث: 6822 عربی حدیث: 2684""","Sahih","Sahih Muslim 6822","","","5. باب: جو شخص اللہ سے ملنے کی آرزو رکھتا ہے۔جسے اللہ کی ملاقات محبوب ہو اللہ کو بھی اس سے ملنا محبوب ہوتا ہے اور جو اللہ سے ملنے کو ناپسند کرے تو اللہ بھی اس سے ملنے کو ناپسند فرماتا ہےChapter: Whoever Loves To Meet Allah, Allah Loves To Meet Him, And Whoever Hates To Meet Allah, Allah Hates To Meet Him"
"6823","وحَدَّثَنَاه مُحَمَّدُ بْنُ بَشَّارٍ ، حَدَّثَنَا مُحَمَّدُ بْنُ بَكْرٍ ، حَدَّثَنَا سَعِيدٌ ، عَنْ قَتَادَةَ بِهَذَا الْإِسْنَادِ.nصحیح مسلم حدیث: 6823 عربی حدیث: 2684","Sahih","Sahih Muslim 6823","","","5. باب: جو شخص اللہ سے ملنے کی آرزو رکھتا ہے۔جسے اللہ کی ملاقات محبوب ہو اللہ کو بھی اس سے ملنا محبوب ہوتا ہے اور جو اللہ سے ملنے کو ناپسند کرے تو اللہ بھی اس سے ملنے کو ناپسند فرماتا ہےChapter: Whoever Loves To Meet Allah, Allah Loves To Meet Him, And Whoever Hates To Meet Allah, Allah Hates To Meet Him"
"6824","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا عَلِيُّ بْنُ مُسْهِرٍ ، عَنْ زَكَرِيَّاءَ ، عَنْ الشَّعْبِيِّ ، عَنْ شُرَيْحِ بْنِ هَانِئٍ ، عَنْ عَائِشَةَ ، قَالَتْ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنْ أَحَبَّ لِقَاءَ اللَّهِ أَحَبَّ اللَّهُ لِقَاءَهُ، وَمَنْ كَرِهَ لِقَاءَ اللَّهِ كَرِهَ اللَّهُ لِقَاءَهُ، وَالْمَوْتُ قَبْلَ لِقَاءِ اللَّهِ \""\""،nصحیح مسلم حدیث: 6824 عربی حدیث: 2684""","Sahih","Sahih Muslim 6824","","","5. باب: جو شخص اللہ سے ملنے کی آرزو رکھتا ہے۔جسے اللہ کی ملاقات محبوب ہو اللہ کو بھی اس سے ملنا محبوب ہوتا ہے اور جو اللہ سے ملنے کو ناپسند کرے تو اللہ بھی اس سے ملنے کو ناپسند فرماتا ہےChapter: Whoever Loves To Meet Allah, Allah Loves To Meet Him, And Whoever Hates To Meet Allah, Allah Hates To Meet Him"
"6825","حَدَّثَنَاه إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا عِيسَى بْنُ يُونُسَ ، حَدَّثَنَا زَكَرِيَّاءُ ، عَنْ عَامِرٍ ، حَدَّثَنِي شُرَيْحُ بْنُ هَانِئٍ ، أَنَّ عَائِشَةَ أَخْبَرَتْهُ أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ: بِمِثْلِهِ.nصحیح مسلم حدیث: 6825 عربی حدیث: 2684","Sahih","Sahih Muslim 6825","","","5. باب: جو شخص اللہ سے ملنے کی آرزو رکھتا ہے۔جسے اللہ کی ملاقات محبوب ہو اللہ کو بھی اس سے ملنا محبوب ہوتا ہے اور جو اللہ سے ملنے کو ناپسند کرے تو اللہ بھی اس سے ملنے کو ناپسند فرماتا ہےChapter: Whoever Loves To Meet Allah, Allah Loves To Meet Him, And Whoever Hates To Meet Allah, Allah Hates To Meet Him"
"6826","حَدَّثَنَا سَعِيدُ بْنُ عَمْرٍو الْأَشْعَثِيُّ ، أَخْبَرَنَا عَبْثَرٌ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ ، عَنْ شُرَيْحِ بْنِ هَانِئٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنْ أَحَبَّ لِقَاءَ اللَّهِ أَحَبَّ اللَّهُ لِقَاءَهُ، وَمَنْ كَرِهَ لِقَاءَ اللَّهِ كَرِهَ اللَّهُ لِقَاءَهُ \""\""، قَالَ: فَأَتَيْتُ عَائِشَةَ ، فَقُلْتُ يَا أُمَّ الْمُؤْمِنِينَ: سَمِعْتُ أَبَا هُرَيْرَةَ يَذْكُرُ عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَدِيثًا إِنْ كَانَ كَذَلِكَ فَقَدْ هَلَكْنَا، فَقَالَتْ: إِنَّ الْهَالِكَ مَنْ هَلَكَ بِقَوْلِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَمَا ذَاكَ؟ قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \""\"" مَنْ أَحَبَّ لِقَاءَ اللَّهِ أَحَبَّ اللَّهُ لِقَاءَهُ، وَمَنْ كَرِهَ لِقَاءَ اللَّهِ كَرِهَ اللَّهُ لِقَاءَهُ \""\"" وَلَيْسَ مِنَّا أَحَدٌ إِلَّا وَهُوَ يَكْرَهُ الْمَوْتَ، فَقَالَتْ: قَدْ قَالَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَلَيْسَ بِالَّذِي تَذْهَبُ إِلَيْهِ، وَلَكِنْ إِذَا شَخَصَ الْبَصَرُ وَحَشْرَجَ الصَّدْرُ وَاقْشَعَرَّ الْجِلْدُ وَتَشَنَّجَتِ الْأَصَابِعُ، فَعِنْدَ ذَلِكَ مَنْ أَحَبَّ لِقَاءَ اللَّهِ أَحَبَّ اللَّهُ لِقَاءَهُ، وَمَنْ كَرِهَ لِقَاءَ اللَّهِ كَرِهَ اللَّهُ لِقَاءَهُ،nصحیح مسلم حدیث: 6826 عربی حدیث: 2685""","Sahih","Sahih Muslim 6826","","","5. باب: جو شخص اللہ سے ملنے کی آرزو رکھتا ہے۔جسے اللہ کی ملاقات محبوب ہو اللہ کو بھی اس سے ملنا محبوب ہوتا ہے اور جو اللہ سے ملنے کو ناپسند کرے تو اللہ بھی اس سے ملنے کو ناپسند فرماتا ہےChapter: Whoever Loves To Meet Allah, Allah Loves To Meet Him, And Whoever Hates To Meet Allah, Allah Hates To Meet Him"
"6827","وحَدَّثَنَاه إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْحَنْظَلِيُّ ، أَخْبَرَنِي جَرِيرٌ ، عَنْ مُطَرِّفٍ بِهَذَا الْإِسْنَادِ نَحْوَ حَدِيثِ عَبْثَرٍ.nصحیح مسلم حدیث: 6827 عربی حدیث: 2685","Sahih","Sahih Muslim 6827","","","5. باب: جو شخص اللہ سے ملنے کی آرزو رکھتا ہے۔جسے اللہ کی ملاقات محبوب ہو اللہ کو بھی اس سے ملنا محبوب ہوتا ہے اور جو اللہ سے ملنے کو ناپسند کرے تو اللہ بھی اس سے ملنے کو ناپسند فرماتا ہےChapter: Whoever Loves To Meet Allah, Allah Loves To Meet Him, And Whoever Hates To Meet Allah, Allah Hates To Meet Him"
"6828","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو عَامِرٍ الْأَشْعَرِيُّ ، وَأَبُو كُرَيْبٍ ، قَالُوا: حَدَّثَنَا أَبُو أُسَامَةَ ، عَنْ بُرَيْدٍ ، عَنْ أَبِي بُرْدَةَ ، عَنْ أَبِي مُوسَى ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" مَنْ أَحَبَّ لِقَاءَ اللَّهِ أَحَبَّ اللَّهُ لِقَاءَهُ، وَمَنْ كَرِهَ لِقَاءَ اللَّهِ كَرِهَ اللَّهُ لِقَاءَهُ \""\"".nصحیح مسلم حدیث: 6828 عربی حدیث: 2686""","Sahih","Sahih Muslim 6828","","","5. باب: جو شخص اللہ سے ملنے کی آرزو رکھتا ہے۔جسے اللہ کی ملاقات محبوب ہو اللہ کو بھی اس سے ملنا محبوب ہوتا ہے اور جو اللہ سے ملنے کو ناپسند کرے تو اللہ بھی اس سے ملنے کو ناپسند فرماتا ہےChapter: Whoever Loves To Meet Allah, Allah Loves To Meet Him, And Whoever Hates To Meet Allah, Allah Hates To Meet Him"
"6829","حَدَّثَنَا حَدَّثَنَا أَبُو كُرَيْبٍ مُحَمَّدُ بْنُ الْعَلَاءِ ، حَدَّثَنَا وَكِيعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ يَزِيدَ بْنِ الْأَصَمِّ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: إِنَّ اللَّهَ يَقُولُ: \\"" أَنَا عِنْدَ ظَنِّ عَبْدِي بِي وَأَنَا مَعَهُ إِذَا دَعَانِي \""\"".nصحیح مسلم حدیث: 6829 عربی حدیث: 2675""","Sahih","Sahih Muslim 6829","","","6. باب: اللہ تعالیٰ کی یاد اور قرب کی فضیلت۔ذکر، دعا، اللہ کے قرب اور اس کے بارے میں اچھے گمان کی فضیلتChapter: The Virtue Of Remembrance, Supplication, Drawing Close To Allah And Thinking Positively Of Him"
"6830","حَدَّثَنَا حَدَّثَنَا مُحَمَّدُ بْنُ بَشَّارِ بْنِ عُثْمَانَ الْعَبْدِيُّ ، حَدَّثَنَا يَحْيَى يَعْنِي ابْنَ سَعِيدٍ ، وَابْنُ أَبِي عَدِيٍّ ، عَنْ سُلَيْمَانَ وَهُوَ التَّيْمِيُّ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: قَالَ اللَّهُ عَزَّ وَجَلَّ: \\"" إِذَا تَقَرَّبَ عَبْدِي مِنِّي شِبْرًا تَقَرَّبْتُ مِنْهُ ذِرَاعًا، وَإِذَا تَقَرَّبَ مِنِّي ذِرَاعًا تَقَرَّبْتُ مِنْهُ بَاعًا أَوْ بُوعًا، وَإِذَا أَتَانِي يَمْشِي أَتَيْتُهُ هَرْوَلَةً \""\""،nصحیح مسلم حدیث: 6830 عربی حدیث: 2675""","Sahih","Sahih Muslim 6830","","","6. باب: اللہ تعالیٰ کی یاد اور قرب کی فضیلت۔ذکر، دعا، اللہ کے قرب اور اس کے بارے میں اچھے گمان کی فضیلتChapter: The Virtue Of Remembrance, Supplication, Drawing Close To Allah And Thinking Positively Of Him"
"6831","حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى الْقَيْسِيُّ ، حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِيهِ ، بِهَذَا الْإِسْنَادِ وَلَمْ يَذْكُرْ إِذَا أَتَانِي يَمْشِي أَتَيْتُهُ هَرْوَلَةً.nصحیح مسلم حدیث: 6831 عربی حدیث: 2675","Sahih","Sahih Muslim 6831","","","6. باب: اللہ تعالیٰ کی یاد اور قرب کی فضیلت۔ذکر، دعا، اللہ کے قرب اور اس کے بارے میں اچھے گمان کی فضیلتChapter: The Virtue Of Remembrance, Supplication, Drawing Close To Allah And Thinking Positively Of Him"
"6832","حَدَّثَنَا حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ وَاللَّفْظُ لِأَبِي كُرَيْبٍ، قَالَا: حَدَّثَنَا أَبُو مُعَاوِيَةَ ، عَنْ الْأَعْمَشِ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" يَقُولُ اللَّهُ عَزَّ وَجَلَّ: أَنَا عِنْدَ ظَنِّ عَبْدِي، وَأَنَا مَعَهُ حِينَ يَذْكُرُنِي، فَإِنْ ذَكَرَنِي فِي نَفْسِهِ ذَكَرْتُهُ فِي نَفْسِي، وَإِنْ ذَكَرَنِي فِي مَلَإٍ ذَكَرْتُهُ فِي مَلَإٍ خَيْرٍ مِنْهُ، وَإِنِ اقْتَرَبَ إِلَيَّ شِبْرًا تَقَرَّبْتُ إِلَيْهِ ذِرَاعًا، وَإِنِ اقْتَرَبَ إِلَيَّ ذِرَاعًا اقْتَرَبْتُ إِلَيْهِ بَاعًا، وَإِنْ أَتَانِي يَمْشِي أَتَيْتُهُ هَرْوَلَةً \""\"".nصحیح مسلم حدیث: 6832 عربی حدیث: 2675""","Sahih","Sahih Muslim 6832","","","6. باب: اللہ تعالیٰ کی یاد اور قرب کی فضیلت۔ذکر، دعا، اللہ کے قرب اور اس کے بارے میں اچھے گمان کی فضیلتChapter: The Virtue Of Remembrance, Supplication, Drawing Close To Allah And Thinking Positively Of Him"
"6833","حَدَّثَنَا حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا وَكِيعٌ ، حَدَّثَنَا الْأَعْمَشُ ، عَنْ الْمَعْرُورِ بْنِ سُوَيْدٍ ، عَنْ أَبِي ذَرٍّ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" يَقُولُ اللَّهُ عَزَّ وَجَلَّ: مَنْ جَاءَ بِالْحَسَنَةِ، فَلَهُ عَشْرُ أَمْثَالِهَا وَأَزِيدُ، وَمَنْ جَاءَ بِالسَّيِّئَةِ فَجَزَاؤُهُ سَيِّئَةٌ مِثْلُهَا أَوْ أَغْفِرُ، وَمَنْ تَقَرَّبَ مِنِّي شِبْرًا تَقَرَّبْتُ مِنْهُ ذِرَاعًا، وَمَنْ تَقَرَّبَ مِنِّي ذِرَاعًا تَقَرَّبْتُ مِنْهُ بَاعًا، وَمَنْ أَتَانِي يَمْشِي أَتَيْتُهُ هَرْوَلَةً، وَمَنْ لَقِيَنِي بِقُرَابِ الْأَرْضِ خَطِيئَةً لَا يُشْرِكُ بِي شَيْئًا لَقِيتُهُ بِمِثْلِهَا مَغْفِرَةً \""\""، قَالَ إِبْرَاهِيمُ: حَدَّثَنَا الْحَسَنُ بْنُ بِشْرٍ، حَدَّثَنَا وَكِيعٌ بِهَذَا الْحَدِيثِ،nصحیح مسلم حدیث: 6833 عربی حدیث: 2687""","Sahih","Sahih Muslim 6833","","","6. باب: اللہ تعالیٰ کی یاد اور قرب کی فضیلت۔ذکر، دعا، اللہ کے قرب اور اس کے بارے میں اچھے گمان کی فضیلتChapter: The Virtue Of Remembrance, Supplication, Drawing Close To Allah And Thinking Positively Of Him"
"6834","حَدَّثَنَا أَبُو كُرَيْبٍ، حَدَّثَنَا أَبُو مُعَاوِيَةَ، عَنْ الْأَعْمَشِ، بِهَذَا الْإِسْنَادِ نَحْوَهُ غَيْرَ أَنَّهُ قَالَ فَلَهُ عَشْرُ أَمْثَالِهَا أَوْ أَزِيدُ.nصحیح مسلم حدیث: 6834 عربی حدیث: 2687","Sahih","Sahih Muslim 6834","","","6. باب: اللہ تعالیٰ کی یاد اور قرب کی فضیلت۔ذکر، دعا، اللہ کے قرب اور اس کے بارے میں اچھے گمان کی فضیلتChapter: The Virtue Of Remembrance, Supplication, Drawing Close To Allah And Thinking Positively Of Him"
"6835","حَدَّثَنَا أَبُو الْخَطَّابِ زِيَادُ بْنُ يَحْيَى الْحَسَّانِيُّ ، حَدَّثَنَا مُحَمَّدُ بْنُ أَبِي عَدِيٍّ ، عَنْ حُمَيْدٍ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَادَ رَجُلًا مِنَ الْمُسْلِمِينَ قَدْ خَفَتَ فَصَارَ مِثْلَ الْفَرْخِ، فَقَالَ لَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" هَلْ كُنْتَ تَدْعُو بِشَيْءٍ أَوْ تَسْأَلُهُ إِيَّاهُ؟ \""\"" قَالَ: نَعَمْ، كُنْتُ أَقُولُ اللَّهُمَّ مَا كُنْتَ مُعَاقِبِي بِهِ فِي الْآخِرَةِ فَعَجِّلْهُ لِي فِي الدُّنْيَا، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \""\"" سُبْحَانَ اللَّهِ لَا تُطِيقُهُ أَوْ لَا تَسْتَطِيعُهُ، أَفَلَا قُلْتَ: اللَّهُمَّ آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً، وَقِنَا عَذَابَ النَّارِ \""\""، قَالَ: فَدَعَا اللَّهَ لَهُ فَشَفَاهُ.nصحیح مسلم حدیث: 6835 عربی حدیث: 2688""","Sahih","Sahih Muslim 6835","","","7. باب: دنیا میں عذاب ہو جانے کی دعا کرنا مکروہ ہے۔دنیا ہی میں جلد سزا مل جانے کی دعا مکروہ ہےChapter: It Is Disliked To Pray For Punishment To Be Brought Forward In This World"
"6836","حَدَّثَنَاه عَاصِمُ بْنُ النَّضْرِ التَّيْمِيُّ ، حَدَّثَنَا خَالِدُ بْنُ الْحَارِثِ ، حَدَّثَنَا حُمَيْدٌ بِهَذَا الْإِسْنَادِ إِلَى قَوْلِهِ وَقِنَا عَذَابَ النَّارِ، وَلَمْ يَذْكُرِ الزِّيَادَةَ،nصحیح مسلم حدیث: 6836 عربی حدیث: 2688","Sahih","Sahih Muslim 6836","","","7. باب: دنیا میں عذاب ہو جانے کی دعا کرنا مکروہ ہے۔دنیا ہی میں جلد سزا مل جانے کی دعا مکروہ ہےChapter: It Is Disliked To Pray For Punishment To Be Brought Forward In This World"
"6837","وحَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا حَمَّادٌ ، أَخْبَرَنَا ثَابِتٌ ، عَنْ أَنَسٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ دَخَلَ عَلَى رَجُلٍ مِنْ أَصْحَابِهِ يَعُودُهُ وَقَدْ صَارَ كَالْفَرْخِ، بِمَعْنَى حَدِيثِ حُمَيْدٍ غَيْرَ أَنَّهُ قَالَ: لَا طَاقَةَ لَكَ بِعَذَابِ اللَّهِ، وَلَمْ يَذْكُرْ فَدَعَا اللَّهَ لَهُ فَشَفَاهُ،nصحیح مسلم حدیث: 6837 عربی حدیث: 2688","Sahih","Sahih Muslim 6837","","","7. باب: دنیا میں عذاب ہو جانے کی دعا کرنا مکروہ ہے۔دنیا ہی میں جلد سزا مل جانے کی دعا مکروہ ہےChapter: It Is Disliked To Pray For Punishment To Be Brought Forward In This World"
"6838","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا سَالِمُ بْنُ نُوحٍ الْعَطَّارُ ، عَنْ سَعِيدِ بْنِ أَبِي عَرُوبَةَ ، عَنْ قَتَادَةَ ، عَنْ أَنَسٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِهَذَا الْحَدِيثِ.nصحیح مسلم حدیث: 6838 عربی حدیث: 2688","Sahih","Sahih Muslim 6838","","","7. باب: دنیا میں عذاب ہو جانے کی دعا کرنا مکروہ ہے۔دنیا ہی میں جلد سزا مل جانے کی دعا مکروہ ہےChapter: It Is Disliked To Pray For Punishment To Be Brought Forward In This World"
"6839","حَدَّثَنَا مُحَمَّدُ بْنُ حَاتِمِ بْنِ مَيْمُونٍ ، حَدَّثَنَا بَهْزٌ ، حَدَّثَنَا وُهَيْبٌ ، حَدَّثَنَا سُهَيْلٌ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ: \\"" إِنَّ لِلَّهِ تَبَارَكَ وَتَعَالَى مَلَائِكَةً سَيَّارَةً فُضُلًا يَتَتَبَّعُونَ مَجَالِسَ الذِّكْرِ، فَإِذَا وَجَدُوا مَجْلِسًا فِيهِ ذِكْرٌ قَعَدُوا مَعَهُمْ، وَحَفَّ بَعْضُهُمْ بَعْضًا بِأَجْنِحَتِهِمْ حَتَّى يَمْلَئُوا مَا بَيْنَهُمْ وَبَيْنَ السَّمَاءِ الدُّنْيَا، فَإِذَا تَفَرَّقُوا عَرَجُوا وَصَعِدُوا إِلَى السَّمَاءِ، قَالَ: فَيَسْأَلُهُمُ اللَّهُ عَزَّ وَجَلَّ وَهُوَ أَعْلَمُ بِهِمْ مِنْ أَيْنَ جِئْتُمْ؟ فَيَقُولُونَ: جِئْنَا مِنْ عِنْدِ عِبَادٍ لَكَ فِي الْأَرْضِ يُسَبِّحُونَكَ، وَيُكَبِّرُونَكَ، وَيُهَلِّلُونَكَ، وَيَحْمَدُونَكَ، وَيَسْأَلُونَكَ، قَالَ: وَمَاذَا يَسْأَلُونِي؟ قَالُوا: يَسْأَلُونَكَ جَنَّتَكَ، قَالَ: وَهَلْ رَأَوْا جَنَّتِي؟ قَالُوا: لَا أَيْ رَبِّ، قَالَ: فَكَيْفَ لَوْ رَأَوْا جَنَّتِي؟ قَالُوا: وَيَسْتَجِيرُونَكَ، قَالَ: وَمِمَّ يَسْتَجِيرُونَنِي؟ قَالُوا: مِنْ نَارِكَ يَا رَبِّ، قَالَ وَهَلْ رَأَوْا نَارِي؟ قَالُوا: لَا، قَالَ: فَكَيْفَ لَوْ رَأَوْا نَارِي؟ قَالُوا: وَيَسْتَغْفِرُونَكَ، قَالَ، فَيَقُولُ: قَدْ غَفَرْتُ لَهُمْ فَأَعْطَيْتُهُمْ مَا سَأَلُوا وَأَجَرْتُهُمْ مِمَّا اسْتَجَارُوا، قَالَ: فَيَقُولُونَ: رَبِّ فِيهِمْ فُلَانٌ عَبْدٌ خَطَّاءٌ إِنَّمَا مَرَّ فَجَلَسَ مَعَهُمْ، قَالَ: فَيَقُولُ: وَلَهُ غَفَرْتُ هُمُ الْقَوْمُ لَا يَشْقَى بِهِمْ جَلِيسُهُمْ \""\"".nصحیح مسلم حدیث: 6839 عربی حدیث: 2689""","Sahih","Sahih Muslim 6839","","","8. باب: ذکر الہٰی جس مجلس میں ہو اس کی فضلیت۔مجالس ذکر کی فضیلتChapter: The Virtues Of Gathering To Remember Allah (Adh-Dhikr)"
"6840","حَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا إِسْمَاعِيلُ يَعْنِي ابْنَ عُلَيَّةَ ، عَنْ عَبْدِ الْعَزِيزِ وَهُوَ ابْنُ صُهَيْبٍ ، قَالَ: سَأَلَ قَتَادَةُ أَنَسًا أَيُّ دَعْوَةٍ كَانَ يَدْعُو بِهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَكْثَرَ؟، قَالَ: كَانَ أَكْثَرُ دَعْوَةٍ يَدْعُو بِهَا يَقُولُ: \\"" اللَّهُمَّ آتِنَا فِي الدُّنْيَا حَسَنَةً، وَفِي الْآخِرَةِ حَسَنَةً، وَقِنَا عَذَابَ النَّارِ \""\""، قَالَ: وَكَانَ أَنَسٌ إِذَا أَرَادَ أَنْ يَدْعُوَ بِدَعْوَةٍ دَعَا بِهَا، فَإِذَا أَرَادَ أَنْ يَدْعُوَ بِدُعَاءٍ دَعَا بِهَا فِيهِ \""\"".nصحیح مسلم حدیث: 6840 عربی حدیث: 2690""","Sahih","Sahih Muslim 6840","","","9. باب: آپ صلی اللہ علیہ وسلم اکثر کون سی دعا کرتے۔اس دعا کی فضیلت: اے اللہ! ہمیں دنیا میں اچھائی عطا فرما اور آخرت میں بھی اچھائی عطا فرما اور ہمیں آگ کے عذاب سے بچاChapter: The Virtue Of The Supplication: O Allah, Give Us Good In This World And Good In The Hereafter, And Save Us From The Torment Of The Fire"
"6841","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا شُعْبَةُ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، قَالَ كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ: \\"" رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ \""\"".nصحیح مسلم حدیث: 6841 عربی حدیث: 2690""","Sahih","Sahih Muslim 6841","","","9. باب: آپ صلی اللہ علیہ وسلم اکثر کون سی دعا کرتے۔اس دعا کی فضیلت: اے اللہ! ہمیں دنیا میں اچھائی عطا فرما اور آخرت میں بھی اچھائی عطا فرما اور ہمیں آگ کے عذاب سے بچاChapter: The Virtue Of The Supplication: O Allah, Give Us Good In This World And Good In The Hereafter, And Save Us From The Torment Of The Fire"
"6842","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ سُمَيٍّ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" مَنْ قَالَ لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ فِي يَوْمٍ مِائَةَ مَرَّةٍ كَانَتْ لَهُ عَدْلَ عَشْرِ رِقَابٍ، وَكُتِبَتْ لَهُ مِائَةُ حَسَنَةٍ، وَمُحِيَتْ عَنْهُ مِائَةُ سَيِّئَةٍ، وَكَانَتْ لَهُ حِرْزًا مِنَ الشَّيْطَانِ يَوْمَهُ ذَلِكَ حَتَّى يُمْسِيَ، وَلَمْ يَأْتِ أَحَدٌ أَفْضَلَ مِمَّا جَاءَ بِهِ إِلَّا أَحَدٌ عَمِلَ أَكْثَرَ مِنْ ذَلِكَ، وَمَنْ قَالَ: سُبْحَانَ اللَّهِ وَبِحَمْدِهِ فِي يَوْمٍ مِائَةَ مَرَّةٍ، حُطَّتْ خَطَايَاهُ، وَلَوْ كَانَتْ مِثْلَ زَبَدِ الْبَحْرِ \""\"".nصحیح مسلم حدیث: 6842 عربی حدیث: 2691""","Sahih","Sahih Muslim 6842","","","10. باب: لا الہ الا اللہ اور سبحان اللہ اور دعا کی فضیلت۔لا الہ الا اللہ اور سبحان اللہ کہنے اور دعا کرنے کی فضیلتChapter: The Virtue Of Tahlil (Saying La Ilaha Ill-Allah), Tasbih (Saying Subhan Allah) And (Du'a) Supplication"
"6843","حَدَّثَنِي مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ الْأُمَوِيُّ ، حَدَّثَنَا عَبْدُ الْعَزِيزِ بْنُ الْمُخْتَارِ ، عَنْ سُهَيْلٍ ، عَنْ سُمَيٍّ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنْ قَالَ حِينَ يُصْبِحُ وَحِينَ يُمْسِي سُبْحَانَ اللَّهِ وَبِحَمْدِهِ مِائَةَ مَرَّةٍ، لَمْ يَأْتِ أَحَدٌ يَوْمَ الْقِيَامَةِ بِأَفْضَلَ مِمَّا جَاءَ بِهِ إِلَّا أَحَدٌ قَالَ مِثْلَ مَا قَالَ أَوْ زَادَ عَلَيْهِ \""\"".nصحیح مسلم حدیث: 6843 عربی حدیث: 2692""","Sahih","Sahih Muslim 6843","","","10. باب: لا الہ الا اللہ اور سبحان اللہ اور دعا کی فضیلت۔لا الہ الا اللہ اور سبحان اللہ کہنے اور دعا کرنے کی فضیلتChapter: The Virtue Of Tahlil (Saying La Ilaha Ill-Allah), Tasbih (Saying Subhan Allah) And (Du'a) Supplication"
"6844","حَدَّثَنَا سُلَيْمَانُ بْنُ عُبَيْدِ اللَّهِ أَبُو أَيُّوبَ الْغَيْلَانِيُّ ، حَدَّثَنَا أَبُو عَامِرٍ يَعْنِي الْعَقَدِيَّ ، حَدَّثَنَا عُمَرُ وَهُوَ ابْنُ أَبِي زَائِدَةَ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَيْمُونٍ ، قَالَ: \\"" مَنْ قَالَ لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ عَشْرَ مِرَارٍ، كَانَ كَمَنْ أَعْتَقَ أَرْبَعَةَ أَنْفُسٍ مِنْ وَلَدِ إِسْمَاعِيلَ \""\""،nصحیح مسلم حدیث: 6844 عربی حدیث: 2693""","Sahih","Sahih Muslim 6844","","","10. باب: لا الہ الا اللہ اور سبحان اللہ اور دعا کی فضیلت۔لا الہ الا اللہ اور سبحان اللہ کہنے اور دعا کرنے کی فضیلتChapter: The Virtue Of Tahlil (Saying La Ilaha Ill-Allah), Tasbih (Saying Subhan Allah) And (Du'a) Supplication"
"6845","وقَالَ سُلَيْمَانُ : حَدَّثَنَا أَبُو عَامِرٍ ، حَدَّثَنَا عُمَرُ ، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ أَبِي السَّفَرِ ، عَنْ الشَّعْبِيِّ ، عَنْ رَبِيعِ بْنِ خُثَيْمٍ بِمِثْلِ ذَلِكَ، قَالَ: فَقُلْتُ لِلرَّبِيعِ: مِمَّنْ سَمِعْتَهُ؟ قَالَ: مِنْ عَمْرِو بْنِ مَيْمُونٍ ، قَالَ: فَأَتَيْتُ عَمْرَو بْنَ مَيْمُونٍ، فَقُلْتُ: مِمَّنْ سَمِعْتُهُ، قَالَ: مِنْ ابْنِ أَبِي لَيْلَى ، قَالَ: فَأَتَيْتُ ابْنَ أَبِي لَيْلَى، فَقُلْتُ: مِمَّنْ سَمِعْتُهُ؟ قَالَ: مِنْ أَبِي أَيُّوبَ الْأَنْصَارِيِّ يُحَدِّثُهُ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.nصحیح مسلم حدیث: 6845 عربی حدیث: 2693","Sahih","Sahih Muslim 6845","","","10. باب: لا الہ الا اللہ اور سبحان اللہ اور دعا کی فضیلت۔لا الہ الا اللہ اور سبحان اللہ کہنے اور دعا کرنے کی فضیلتChapter: The Virtue Of Tahlil (Saying La Ilaha Ill-Allah), Tasbih (Saying Subhan Allah) And (Du'a) Supplication"
"6846","حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، وَزُهَيْرُ بْنُ حَرْبٍ ، وَأَبُو كُرَيْبٍ ، وَمُحَمَّدُ بْنُ طَرِيفٍ الْبَجَلِيُّ ، قَالُوا: حَدَّثَنَا ابْنُ فُضَيْلٍ ، عَنْ عُمَارَةَ بْنِ الْقَعْقَاعِ ، عَنْ أَبِي زُرْعَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" كَلِمَتَانِ خَفِيفَتَانِ عَلَى اللِّسَانِ ثَقِيلَتَانِ فِي الْمِيزَانِ حَبِيبَتَانِ إِلَى الرَّحْمَنِ، سُبْحَانَ اللَّهِ وَبِحَمْدِهِ سُبْحَانَ اللَّهِ الْعَظِيمِ \""\"".nصحیح مسلم حدیث: 6846 عربی حدیث: 2694""","Sahih","Sahih Muslim 6846","","","10. باب: لا الہ الا اللہ اور سبحان اللہ اور دعا کی فضیلت۔لا الہ الا اللہ اور سبحان اللہ کہنے اور دعا کرنے کی فضیلتChapter: The Virtue Of Tahlil (Saying La Ilaha Ill-Allah), Tasbih (Saying Subhan Allah) And (Du'a) Supplication"
"6847","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، قَالَا: حَدَّثَنَا أَبُو مُعَاوِيَةَ ، عَنْ الْأَعْمَشِ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" لَأَنْ أَقُولَ سُبْحَانَ اللَّهِ وَالْحَمْدُ لِلَّهِ وَلَا إِلَهَ إِلَّا اللَّهُ وَاللَّهُ أَكْبَرُ، أَحَبُّ إِلَيَّ مِمَّا طَلَعَتْ عَلَيْهِ الشَّمْسُ \""\"".nصحیح مسلم حدیث: 6847 عربی حدیث: 2695""","Sahih","Sahih Muslim 6847","","","10. باب: لا الہ الا اللہ اور سبحان اللہ اور دعا کی فضیلت۔لا الہ الا اللہ اور سبحان اللہ کہنے اور دعا کرنے کی فضیلتChapter: The Virtue Of Tahlil (Saying La Ilaha Ill-Allah), Tasbih (Saying Subhan Allah) And (Du'a) Supplication"
"6848","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا عَلِيُّ بْنُ مُسْهِرٍ ، وَابْنُ نُمَيْرٍ ، عَنْ مُوسَى الْجُهَنِيِّ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ وَاللَّفْظُ لَهُ، حَدَّثَنَا أَبِي ، حَدَّثَنَا مُوسَى الْجُهَنِيُّ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، عَنْ أَبِيهِ ، قَالَ: جَاءَ أَعْرَابِيٌّ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: عَلِّمْنِي كَلَامًا أَقُولُهُ، قَالَ: \\"" قُلْ لَا إِلَهَ إِلَّا اللَّهُ، وَحْدَهُ لَا شَرِيكَ لَهُ اللَّهُ أَكْبَرُ كَبِيرًا، وَالْحَمْدُ لِلَّهِ كَثِيرًا، سُبْحَانَ اللَّهِ رَبِّ الْعَالَمِينَ، لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ الْعَزِيزِ الْحَكِيمِ \""\""، قَالَ: فَهَؤُلَاءِ لِرَبِّي فَمَا لِي؟ قَالَ: \""\"" قُلِ اللَّهُمَّ اغْفِرْ لِي وَارْحَمْنِي وَاهْدِنِي وَارْزُقْنِي \""\""، قَالَ مُوسَى: أَمَّا عَافِنِي فَأَنَا أَتَوَهَّمُ، وَمَا أَدْرِي وَلَمْ يَذْكُرْ ابْنُ أَبِي شَيْبَةَ فِي حَدِيثِهِ قَوْلَ مُوسَى.nصحیح مسلم حدیث: 6848 عربی حدیث: 2696""","Sahih","Sahih Muslim 6848","","","10. باب: لا الہ الا اللہ اور سبحان اللہ اور دعا کی فضیلت۔لا الہ الا اللہ اور سبحان اللہ کہنے اور دعا کرنے کی فضیلتChapter: The Virtue Of Tahlil (Saying La Ilaha Ill-Allah), Tasbih (Saying Subhan Allah) And (Du'a) Supplication"
"6849","حَدَّثَنَا أَبُو كَامِلٍ الْجَحْدَرِيُّ ، حَدَّثَنَا عَبْدُ الْوَاحِدِ يَعْنِي ابْنَ زِيَادٍ ، حَدَّثَنَا أَبُو مَالِكٍ الْأَشْجَعِيُّ ، عَنْ أَبِيهِ ، قَالَ كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُعَلِّمُ مَنْ أَسْلَمَ، يَقُولُ: \\"" اللَّهُمَّ اغْفِرْ لِي وَارْحَمْنِي وَاهْدِنِي وَارْزُقْنِي \""\"".nصحیح مسلم حدیث: 6849 عربی حدیث: 2697""","Sahih","Sahih Muslim 6849","","","10. باب: لا الہ الا اللہ اور سبحان اللہ اور دعا کی فضیلت۔لا الہ الا اللہ اور سبحان اللہ کہنے اور دعا کرنے کی فضیلتChapter: The Virtue Of Tahlil (Saying La Ilaha Ill-Allah), Tasbih (Saying Subhan Allah) And (Du'a) Supplication"
"6850","حَدَّثَنَا سَعِيدُ بْنُ أَزْهَرَ الْوَاسِطِيُّ ، حَدَّثَنَا أَبُو مُعَاوِيَةَ ، حَدَّثَنَا أَبُو مَالِكٍ الْأَشْجَعِيُّ ، عَنْ أَبِيهِ ، قَالَ: كَانَ الرَّجُلُ إِذَا أَسْلَمَ، عَلَّمَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الصَّلَاةَ، ثُمَّ أَمَرَهُ أَنْ يَدْعُوَ بِهَؤُلَاءِ الْكَلِمَاتِ: \\"" اللَّهُمَّ اغْفِرْ لِي وَارْحَمْنِي وَاهْدِنِي وَعَافِنِي وَارْزُقْنِي \""\"".nصحیح مسلم حدیث: 6850 عربی حدیث: 2697""","Sahih","Sahih Muslim 6850","","","10. باب: لا الہ الا اللہ اور سبحان اللہ اور دعا کی فضیلت۔لا الہ الا اللہ اور سبحان اللہ کہنے اور دعا کرنے کی فضیلتChapter: The Virtue Of Tahlil (Saying La Ilaha Ill-Allah), Tasbih (Saying Subhan Allah) And (Du'a) Supplication"
"6851","حَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ ، أَخْبَرَنَا أَبُو مَالِكٍ ، عَنْ أَبِيهِ ، أَنَّهُ سَمِعَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَأَتَاهُ رَجُلٌ، فَقَالَ: يَا رَسُولَ اللَّهِ، كَيْفَ أَقُولُ حِينَ أَسْأَلُ رَبِّي؟ قَالَ:\\"" قُلِ اللَّهُمَّ اغْفِرْ لِي وَارْحَمْنِي وَعَافِنِي وَارْزُقْنِي وَيَجْمَعُ أَصَابِعَهُ إِلَّا الْإِبْهَامَ، فَإِنَّ هَؤُلَاءِ تَجْمَعُ لَكَ دُنْيَاكَ وَآخِرَتَكَ\""\"".nصحیح مسلم حدیث: 6851 عربی حدیث: 2697""","Sahih","Sahih Muslim 6851","","","10. باب: لا الہ الا اللہ اور سبحان اللہ اور دعا کی فضیلت۔لا الہ الا اللہ اور سبحان اللہ کہنے اور دعا کرنے کی فضیلتChapter: The Virtue Of Tahlil (Saying La Ilaha Ill-Allah), Tasbih (Saying Subhan Allah) And (Du'a) Supplication"
"6852","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ، حَدَّثَنَا مَرْوَانُ ، وَعَلِيُّ بْنُ مُسْهِرٍ ، عَنْ مُوسَى الْجُهَنِيِّ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ وَاللَّفْظُ لَهُ، حَدَّثَنَا أَبِي ، حَدَّثَنَا مُوسَى الْجُهَنِيُّ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، حَدَّثَنِي أَبِي ، قَالَ: كُنَّا عِنْدَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ:\\"" أَيَعْجِزُ أَحَدُكُمْ أَنْ يَكْسِبَ كُلَّ يَوْمٍ أَلْفَ حَسَنَةٍ\""\""، فَسَأَلَهُ سَائِلٌ مِنْ جُلَسَائِهِ كَيْفَ يَكْسِبُ أَحَدُنَا أَلْفَ حَسَنَةٍ؟، قَالَ:\""\"" يُسَبِّحُ مِائَةَ تَسْبِيحَةٍ فَيُكْتَبُ لَهُ أَلْفُ حَسَنَةٍ أَوْ يُحَطُّ عَنْهُ أَلْفُ خَطِيئَةٍ\""\"".nصحیح مسلم حدیث: 6852 عربی حدیث: 2698""","Sahih","Sahih Muslim 6852","","","10. باب: لا الہ الا اللہ اور سبحان اللہ اور دعا کی فضیلت۔لا الہ الا اللہ اور سبحان اللہ کہنے اور دعا کرنے کی فضیلتChapter: The Virtue Of Tahlil (Saying La Ilaha Ill-Allah), Tasbih (Saying Subhan Allah) And (Du'a) Supplication"
"6853","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى التَّمِيمِيُّ ، وَأَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَمُحَمَّدُ بْنُ الْعَلَاءِ الْهَمْدَانِيُّ وَاللَّفْظُ لِيَحْيَى، قَالَ يَحْيَى أَخْبَرَنَا، وقَالَ الْآخَرَانِ حَدَّثَنَا أَبُو مُعَاوِيَةَ ، عَنْ الْأَعْمَشِ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنْ نَفَّسَ عَنْ مُؤْمِنٍ كُرْبَةً مِنْ كُرَبِ الدُّنْيَا نَفَّسَ اللَّهُ عَنْهُ كُرْبَةً مِنْ كُرَبِ يَوْمِ الْقِيَامَةِ، وَمَنْ يَسَّرَ عَلَى مُعْسِرٍ يَسَّرَ اللَّهُ عَلَيْهِ فِي الدُّنْيَا وَالْآخِرَةِ، وَمَنْ سَتَرَ مُسْلِمًا سَتَرَهُ اللَّهُ فِي الدُّنْيَا وَالْآخِرَةِ، وَاللَّهُ فِي عَوْنِ الْعَبْدِ مَا كَانَ الْعَبْدُ فِي عَوْنِ أَخِيهِ، وَمَنْ سَلَكَ طَرِيقًا يَلْتَمِسُ فِيهِ عِلْمًا سَهَّلَ اللَّهُ لَهُ بِهِ طَرِيقًا إِلَى الْجَنَّةِ، وَمَا اجْتَمَعَ قَوْمٌ فِي بَيْتٍ مِنْ بُيُوتِ اللَّهِ يَتْلُونَ كِتَابَ اللَّهِ وَيَتَدَارَسُونَهُ بَيْنَهُمْ إِلَّا نَزَلَتْ عَلَيْهِمُ السَّكِينَةُ وَغَشِيَتْهُمُ الرَّحْمَةُ وَحَفَّتْهُمُ الْمَلَائِكَةُ، وَذَكَرَهُمُ اللَّهُ فِيمَنْ عِنْدَهُ، وَمَنْ بَطَّأَ بِهِ عَمَلُهُ لَمْ يُسْرِعْ بِهِ نَسَبُهُ \""\""،nصحیح مسلم حدیث: 6853 عربی حدیث: 2699""","Sahih","Sahih Muslim 6853","","","11. باب: قرآن کی تلاوت اور ذکر کے لیے جمع ہونے کی فضیلت۔قرآن کی تلاوت اور اللہ کے ذکر کو سننے سنانے کے لیے اکٹھے ہونے کی فضیلتChapter: The Virtue Of Gathering To Read Quran And To Remember Allah"
"6854","حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، حَدَّثَنَا أَبِي . ح وحَدَّثَنَاه نَصْرُ بْنُ عَلِيٍّ الْجَهْضَمِيُّ ، حَدَّثَنَا أَبُو أُسَامَةَ ، قَالَا: حَدَّثَنَا الْأَعْمَشُ ، حَدَّثَنَا ابْنُ نُمَيْرٍ، عَنْ أَبِي صَالِحٍ، وَفِي حَدِيثِ أَبِي أُسَامَةَ، حَدَّثَنَا أَبُو صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: صَخَبَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِ حَدِيثِ أَبِي مُعَاوِيَةَ، غَيْرَ أَنَّ حَدِيثَ أَبِي أُسَامَةَ لَيْسَ فِيهِ ذِكْرُ التَّيْسِيرِ عَلَى الْمُعْسِرِ.nصحیح مسلم حدیث: 6854 عربی حدیث: 2699","Sahih","Sahih Muslim 6854","","","11. باب: قرآن کی تلاوت اور ذکر کے لیے جمع ہونے کی فضیلت۔قرآن کی تلاوت اور اللہ کے ذکر کو سننے سنانے کے لیے اکٹھے ہونے کی فضیلتChapter: The Virtue Of Gathering To Read Quran And To Remember Allah"
"6855","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، سَمِعْتُ أَبَا إِسْحَاقَ يُحَدِّثُ، عَنْ الْأَغَرِّ أَبِي مُسْلِمٍ ، أَنَّهُ قَالَ: أَشْهَدُ عَلَى أَبِي هُرَيْرَةَ وَأَبِي سَعِيدٍ الْخُدْرِيِّ أَنَّهُمَا شَهِدَا عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ: \\"" لَا يَقْعُدُ قَوْمٌ يَذْكُرُونَ اللَّهَ عَزَّ وَجَلَّ إِلَّا حَفَّتْهُمُ الْمَلَائِكَةُ، وَغَشِيَتْهُمُ الرَّحْمَةُ، وَنَزَلَتْ عَلَيْهِمُ السَّكِينَةُ وَذَكَرَهُمُ اللَّهُ فِيمَنْ عِنْدَهُ \""\""،nصحیح مسلم حدیث: 6855 عربی حدیث: 2700""","Sahih","Sahih Muslim 6855","","","11. باب: قرآن کی تلاوت اور ذکر کے لیے جمع ہونے کی فضیلت۔قرآن کی تلاوت اور اللہ کے ذکر کو سننے سنانے کے لیے اکٹھے ہونے کی فضیلتChapter: The Virtue Of Gathering To Read Quran And To Remember Allah"
"6856","وحَدَّثَنِيهِ زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ ، حَدَّثَنَا شُعْبَةُ فِي هَذَا الْإِسْنَادِ نَحْوَهُ.nصحیح مسلم حدیث: 6856 عربی حدیث: 2700","Sahih","Sahih Muslim 6856","","","11. باب: قرآن کی تلاوت اور ذکر کے لیے جمع ہونے کی فضیلت۔قرآن کی تلاوت اور اللہ کے ذکر کو سننے سنانے کے لیے اکٹھے ہونے کی فضیلتChapter: The Virtue Of Gathering To Read Quran And To Remember Allah"
"6857","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا مَرْحُومُ بْنُ عَبْدِ الْعَزِيزِ ، عَنْ أَبِي نَعَامَةَ السَّعْدِيِّ ، عَنْ أَبِي عُثْمَانَ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ: خَرَجَ مُعَاوِيَةُ عَلَى حَلْقَةٍ فِي الْمَسْجِدِ، فَقَالَ: مَا أَجْلَسَكُمْ؟، قَالُوا: جَلَسْنَا نَذْكُرُ اللَّهَ، قَالَ: آللَّهِ مَا أَجْلَسَكُمْ إِلَّا ذَاكَ؟، قَالُوا: وَاللَّهِ مَا أَجْلَسَنَا إِلَّا ذَاكَ، قَالَ: أَمَا إِنِّي لَمْ أَسْتَحْلِفْكُمْ تُهْمَةً لَكُمْ، وَمَا كَانَ أَحَدٌ بِمَنْزِلَتِي مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَقَلَّ عَنْهُ حَدِيثًا مِنِّي، وَإِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَرَجَ عَلَى حَلْقَةٍ مِنْ أَصْحَابِهِ، فَقَالَ: \\"" مَا أَجْلَسَكُمْ \""\""، قَالُوا: جَلَسْنَا نَذْكُرُ اللَّهَ وَنَحْمَدُهُ عَلَى مَا هَدَانَا لِلْإِسْلَامِ، وَمَنَّ بِهِ عَلَيْنَا، قَالَ: \""\"" آللَّهِ مَا أَجْلَسَكُمْ إِلَّا ذَاكَ؟ \""\""، قَالُوا: وَاللَّهِ مَا أَجْلَسَنَا إِلَّا ذَاكَ؟ قَالَ: \""\"" أَمَا إِنِّي لَمْ أَسْتَحْلِفْكُمْ تُهْمَةً لَكُمْ، وَلَكِنَّهُ أَتَانِي جِبْرِيلُ فَأَخْبَرَنِي أَنَّ اللَّهَ عَزَّ وَجَلَّ يُبَاهِي بِكُمُ الْمَلَائِكَةَ \""\"".nصحیح مسلم حدیث: 6857 عربی حدیث: 2701""","Sahih","Sahih Muslim 6857","","","11. باب: قرآن کی تلاوت اور ذکر کے لیے جمع ہونے کی فضیلت۔قرآن کی تلاوت اور اللہ کے ذکر کو سننے سنانے کے لیے اکٹھے ہونے کی فضیلتChapter: The Virtue Of Gathering To Read Quran And To Remember Allah"
"6858","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، وَقُتَيْبَةُ بْنُ سَعِيدٍ ، وَأَبُو الرَّبِيعِ الْعَتَكِيُّ جَمِيعًا، عَنْ حَمَّادٍ ، قَالَ يَحْيَى أَخْبَرَنَا حَمَّادُ بْنُ زَيْدٍ، عَنْ ثَابِتٍ ، عَنْ أَبِي بُرْدَةَ ، عَنْ الْأَغَرِّ الْمُزَنِيِّ ، وَكَانَتْ لَهُ صُحْبَةٌ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" إِنَّهُ لَيُغَانُ عَلَى قَلْبِي وَإِنِّي لَأَسْتَغْفِرُ اللَّهَ فِي الْيَوْمِ مِائَةَ مَرَّةٍ \""\"".nصحیح مسلم حدیث: 6858 عربی حدیث: 2702""","Sahih","Sahih Muslim 6858","","","12. باب: اللہ سے مغفرت مانگنے کی فضیلت۔استغفار کرنا اور کثرت سے کرنا مستحب ہےChapter: It Is Recommend To Pray For Forgiveness A Great Deal"
"6859","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ، حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَةَ ، عَنْ عَمْرِو بْنِ مُرَّةَ ، عَنْ أَبِي بُرْدَةَ ، قَالَ: سَمِعْتُ الْأَغَرَّ ، وَكَانَ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُحَدِّثُ ابْنَ عُمَرَ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" يَا أَيُّهَا النَّاسُ تُوبُوا إِلَى اللَّهِ، فَإِنِّي أَتُوبُ فِي الْيَوْمِ إِلَيْهِ مِائَةَ مَرَّةٍ \""\""،nصحیح مسلم حدیث: 6859 عربی حدیث: 2702""","Sahih","Sahih Muslim 6859","","","12. باب: اللہ سے مغفرت مانگنے کی فضیلت۔استغفار کرنا اور کثرت سے کرنا مستحب ہےChapter: It Is Recommend To Pray For Forgiveness A Great Deal"
"6860","حَدَّثَنَاه عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ ، حَدَّثَنَا أَبِي . ح وحَدَّثَنَا ابْنُ الْمُثَنَّى ، حَدَّثَنَا أَبُو دَاوُدَ ، وَعَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ كلهم، عَنْ شُعْبَةَ فِي هَذَا الْإِسْنَادِ.nصحیح مسلم حدیث: 6860 عربی حدیث: 2702","Sahih","Sahih Muslim 6860","","","12. باب: اللہ سے مغفرت مانگنے کی فضیلت۔استغفار کرنا اور کثرت سے کرنا مستحب ہےChapter: It Is Recommend To Pray For Forgiveness A Great Deal"
"6861","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا أَبُو خَالِدٍ يَعْنِي سُلَيْمَانَ بْنَ حَيَّانَ . ح وحَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا أَبُو مُعَاوِيَةَ . ح وحَدَّثَنِي أَبُو سَعِيدٍ الْأَشَجُّ ، حَدَّثَنَا حَفْصٌ يَعْنِي ابْنَ غِيَاثٍ كُلُّهُمْ، عَنْ هِشَامٍ . ح وحَدَّثَنِي أَبُو خَيْثَمَةَ زُهَيْرُ بْنُ حَرْبٍ وَاللَّفْظُ لَهُ، حَدَّثَنَا إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنْ مُحَمَّدِ بْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنْ تَابَ قَبْلَ أَنْ تَطْلُعَ الشَّمْسُ مِنْ مَغْرِبِهَا تَابَ اللَّهُ عَلَيْهِ \""\"".nصحیح مسلم حدیث: 6861 عربی حدیث: 2703""","Sahih","Sahih Muslim 6861","","","12. باب: اللہ سے مغفرت مانگنے کی فضیلت۔استغفار کرنا اور کثرت سے کرنا مستحب ہےChapter: It Is Recommend To Pray For Forgiveness A Great Deal"
"6862","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ، حَدَّثَنَا مُحَمَّدُ بْنُ فُضَيْلٍ ، وَأَبُو مُعَاوِيَةَ ، عَنْ عَاصِمٍ ، عَنْ أَبِي عُثْمَانَ ، عَنْ أَبِي مُوسَى ، قَالَ: كُنَّا مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ، فَجَعَلَ النَّاسُ يَجْهَرُونَ بِالتَّكْبِيرِ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" أَيُّهَا النَّاسُ ارْبَعُوا عَلَى أَنْفُسِكُمْ إِنَّكُمْ لَيْسَ تَدْعُونَ أَصَمَّ، وَلَا غَائِبًا إِنَّكُمْ تَدْعُونَ سَمِيعًا قَرِيبًا وَهُوَ مَعَكُمْ، قَالَ: وَأَنَا خَلْفَهُ وَأَنَا أَقُولُ لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ \""\""، فَقَالَ: يَا عَبْدَ اللَّهِ بْنَ قَيْسٍ: \""\"" أَلَا أَدُلُّكَ عَلَى كَنْزٍ مِنْ كُنُوزِ الْجَنَّةِ؟ \""\""، فَقُلْتُ: بَلَى يَا رَسُولَ اللَّهِ، قَالَ: \""\"" قُلْ لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ \""\""،nصحیح مسلم حدیث: 6862 عربی حدیث: 2704""","Sahih","Sahih Muslim 6862","","","13. باب: آہستہ سے ذکر کرنا افضل ہے۔ذکر میں آواز دھیمی رکھنا مستحب ہے، سوائے ان مقامات کے جہاں شریعت میں اس کے لیے آواز بلند کرنے کا حکم وارد ہوا ہے، مثلا: تلبیہ (حج) وغیرہ اور لا حول ولا قوة الا بالله کثرت سے کہنا مستحب ہےChapter: It Is Recommend To Lower One's Voice When Saying Remembrance, Except In The Cases Where It Is Commanded To Raise The Voice Such As The Talbiyah Etc. It Is Recommend To Say A Great Deal, There Is No Power And No Strength Except With Allah"
"6863","حَدَّثَنَا ابْنُ نُمَيْرٍ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، وَأَبُو سَعِيدٍ الْأَشَجُّ جَمِيعًا، عَنْ حَفْصِ بْنِ غِيَاثٍ ، عَنْ عَاصِمٍ بِهَذَا الْإِسْنَادِ نَحْوَهُ.nصحیح مسلم حدیث: 6863 عربی حدیث: 2704","Sahih","Sahih Muslim 6863","","","13. باب: آہستہ سے ذکر کرنا افضل ہے۔ذکر میں آواز دھیمی رکھنا مستحب ہے، سوائے ان مقامات کے جہاں شریعت میں اس کے لیے آواز بلند کرنے کا حکم وارد ہوا ہے، مثلا: تلبیہ (حج) وغیرہ اور لا حول ولا قوة الا بالله کثرت سے کہنا مستحب ہےChapter: It Is Recommend To Lower One's Voice When Saying Remembrance, Except In The Cases Where It Is Commanded To Raise The Voice Such As The Talbiyah Etc. It Is Recommend To Say A Great Deal, There Is No Power And No Strength Except With Allah"
"6864","حَدَّثَنَا أَبُو كَامِلٍ فُضَيْلُ بْنُ حُسَيْنٍ ، حَدَّثَنَا يَزِيدُ يَعْنِي ابْنَ زُرَيْعٍ ، حَدَّثَنَا التَّيْمِيُّ ، عَنْ أَبِي عُثْمَانَ ، عَنْ أَبِي مُوسَى ، أَنَّهُمْ كَانُوا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُمْ يَصْعَدُونَ فِي ثَنِيَّةٍ، قَالَ: فَجَعَلَ رَجُلٌ كُلَّمَا عَلَا ثَنِيَّةً نَادَى لَا إِلَهَ إِلَّا اللَّهُ وَاللَّهُ أَكْبَرُ، قَالَ: فَقَالَ نَبِيُّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" إِنَّكُمْ لَا تُنَادُونَ أَصَمَّ وَلَا غَائِبًا \""\""، قَالَ: فَقَالَ يَا أَبَا مُوسَى أَوْ يَا عَبْدَ اللَّهِ بْنَ قَيْسٍ: \""\"" أَلَا أَدُلُّكَ عَلَى كَلِمَةٍ مِنْ كَنْزِ الْجَنَّةِ؟ \""\""، قُلْتُ: مَا هِيَ يَا رَسُولَ اللَّهِ؟، قَالَ: \""\"" لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ \""\""،nصحیح مسلم حدیث: 6864 عربی حدیث: 2704""","Sahih","Sahih Muslim 6864","","","13. باب: آہستہ سے ذکر کرنا افضل ہے۔ذکر میں آواز دھیمی رکھنا مستحب ہے، سوائے ان مقامات کے جہاں شریعت میں اس کے لیے آواز بلند کرنے کا حکم وارد ہوا ہے، مثلا: تلبیہ (حج) وغیرہ اور لا حول ولا قوة الا بالله کثرت سے کہنا مستحب ہےChapter: It Is Recommend To Lower One's Voice When Saying Remembrance, Except In The Cases Where It Is Commanded To Raise The Voice Such As The Talbiyah Etc. It Is Recommend To Say A Great Deal, There Is No Power And No Strength Except With Allah"
"6865","وحَدَّثَنَاه مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى ، حَدَّثَنَا الْمُعْتَمِرُ ، عَنْ أَبِيهِ ، حَدَّثَنَا أَبُو عُثْمَانَ ، عَنْ أَبِي مُوسَى ، قَالَ: بَيْنَمَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ نَحْوَهُ،nصحیح مسلم حدیث: 6865 عربی حدیث: 2704","Sahih","Sahih Muslim 6865","","","13. باب: آہستہ سے ذکر کرنا افضل ہے۔ذکر میں آواز دھیمی رکھنا مستحب ہے، سوائے ان مقامات کے جہاں شریعت میں اس کے لیے آواز بلند کرنے کا حکم وارد ہوا ہے، مثلا: تلبیہ (حج) وغیرہ اور لا حول ولا قوة الا بالله کثرت سے کہنا مستحب ہےChapter: It Is Recommend To Lower One's Voice When Saying Remembrance, Except In The Cases Where It Is Commanded To Raise The Voice Such As The Talbiyah Etc. It Is Recommend To Say A Great Deal, There Is No Power And No Strength Except With Allah"
"6866","حَدَّثَنَا خَلَفُ بْنُ هِشَامٍ ، وَأَبُو الرَّبِيعِ ، قَالَا: حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي عُثْمَانَ ، عَنْ أَبِي مُوسَى ، قَالَ: كُنَّا مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ، فَذَكَرَ نَحْوَ حَدِيثِ عَاصِمٍ،nصحیح مسلم حدیث: 6866 عربی حدیث: 2704","Sahih","Sahih Muslim 6866","","","13. باب: آہستہ سے ذکر کرنا افضل ہے۔ذکر میں آواز دھیمی رکھنا مستحب ہے، سوائے ان مقامات کے جہاں شریعت میں اس کے لیے آواز بلند کرنے کا حکم وارد ہوا ہے، مثلا: تلبیہ (حج) وغیرہ اور لا حول ولا قوة الا بالله کثرت سے کہنا مستحب ہےChapter: It Is Recommend To Lower One's Voice When Saying Remembrance, Except In The Cases Where It Is Commanded To Raise The Voice Such As The Talbiyah Etc. It Is Recommend To Say A Great Deal, There Is No Power And No Strength Except With Allah"
"6867","وحَدَّثَنَا إِسْحاَقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا الثَّقَفِيُّ ، حَدَّثَنَا خَالِدٌ الْحَذَّاءُ ، عَنْ أَبِي عُثْمَانَ ، عَنْ أَبِي مُوسَى ، قَالَ: كُنَّا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي غَزَاةٍ فَذَكَرَ الْحَدِيثَ، وَقَالَ: فِيهِ وَالَّذِي تَدْعُونَهُ أَقْرَبُ إِلَى أَحَدِكُمْ مِنْ عُنُقِ رَاحِلَةِ أَحَدِكُمْ، وَلَيْسَ فِي حَدِيثِهِ ذِكْرُ: لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ.nصحیح مسلم حدیث: 6867 عربی حدیث: 2704","Sahih","Sahih Muslim 6867","","","13. باب: آہستہ سے ذکر کرنا افضل ہے۔ذکر میں آواز دھیمی رکھنا مستحب ہے، سوائے ان مقامات کے جہاں شریعت میں اس کے لیے آواز بلند کرنے کا حکم وارد ہوا ہے، مثلا: تلبیہ (حج) وغیرہ اور لا حول ولا قوة الا بالله کثرت سے کہنا مستحب ہےChapter: It Is Recommend To Lower One's Voice When Saying Remembrance, Except In The Cases Where It Is Commanded To Raise The Voice Such As The Talbiyah Etc. It Is Recommend To Say A Great Deal, There Is No Power And No Strength Except With Allah"
"6868","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا النَّضْرُ بْنُ شُمَيْلٍ ، حَدَّثَنَا عُثْمَانُ وَهُوَ ابْنُ غِيَاثٍ ، حَدَّثَنَا أَبُو عُثْمَانَ ، عَنْ أَبِي مُوسَى الْأَشْعَرِيِّ ، قَالَ: قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" أَلَا أَدُلُّكَ عَلَى كَلِمَةٍ مِنْ كُنُوزِ الْجَنَّةِ؟ أَوَ قَالَ: عَلَى كَنْزٍ مِنْ كُنُوزِ الْجَنَّةِ؟ \""\""، فَقُلْتُ: بَلَى، فَقَالَ: \""\"" لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ \""\"".nصحیح مسلم حدیث: 6868 عربی حدیث: 2704""","Sahih","Sahih Muslim 6868","","","13. باب: آہستہ سے ذکر کرنا افضل ہے۔ذکر میں آواز دھیمی رکھنا مستحب ہے، سوائے ان مقامات کے جہاں شریعت میں اس کے لیے آواز بلند کرنے کا حکم وارد ہوا ہے، مثلا: تلبیہ (حج) وغیرہ اور لا حول ولا قوة الا بالله کثرت سے کہنا مستحب ہےChapter: It Is Recommend To Lower One's Voice When Saying Remembrance, Except In The Cases Where It Is Commanded To Raise The Voice Such As The Talbiyah Etc. It Is Recommend To Say A Great Deal, There Is No Power And No Strength Except With Allah"
"6869","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ رُمْحٍ ، أَخْبَرَنَا اللَّيْثُ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، عَنْ أَبِي الْخَيْرِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، عَنْ أَبِي بَكْرٍ ، أَنَّهُ قَالَ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: عَلِّمْنِي دُعَاءً أَدْعُو بِهِ فِي صَلَاتِي، قَالَ: \\"" قُلِ اللَّهُمَّ إِنِّي ظَلَمْتُ نَفْسِي ظُلْمًا كَبِيرًا \""\""، وَقَالَ قُتَيْبَةُ: كَثِيرًا وَلَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ فَاغْفِرْ لِي مَغْفِرَةً مِنْ عِنْدِكَ وَارْحَمْنِي إِنَّكَ أَنْتَ الْغَفُورُ الرَّحِيمُ،nصحیح مسلم حدیث: 6869 عربی حدیث: 2705""","Sahih","Sahih Muslim 6869","","","14. باب: دعاؤں اور اعوذ باللہ کا بیان۔دعائیں اور اللہ کی پناہ میں آنا"
"6870","وحَدَّثَنِيهِ أَبُو الطَّاهِرِ ، أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، أَخْبَرَنِي رَجُلٌ سَمَّاهُ ، وَعَمْرُو بْنُ الْحَارِثِ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، عَنْ أَبِي الْخَيْرِ ، أَنَّهُ سَمِعَ عَبْدَ اللَّهِ بْنَ عَمْرِو بْنِ الْعَاصِ ، يَقَولُ: إِنَّ أَبَا بَكْرٍ الصِّدِّيقَ ، قَالَ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: عَلِّمْنِي يَا رَسُولَ اللَّهِ دُعَاءً أَدْعُو بِهِ فِي صَلَاتِي وَفِي بَيْتِي، ثُمَّ ذَكَرَ بِمِثْلِ حَدِيثِ اللَّيْثِ غَيْرَ أَنَّهُ، قَالَ: ظُلْمًا كَثِيرًا.nصحیح مسلم حدیث: 6870 عربی حدیث: 2705","Sahih","Sahih Muslim 6870","","","14. باب: دعاؤں اور اعوذ باللہ کا بیان۔دعائیں اور اللہ کی پناہ میں آنا"
"6871","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ وَاللَّفْظُ لِأَبِي بَكْرٍ، قَالَا: حَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا هِشَامٌ ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَدْعُو بِهَؤُلَاءِ الدَّعَوَاتِ \\"" اللَّهُمَّ فَإِنِّي أَعُوذُ بِكَ مِنْ فِتْنَةِ النَّارِ وَعَذَابِ النَّارِ، وَفِتْنَةِ الْقَبْرِ وَعَذَابِ الْقَبْرِ، وَمِنْ شَرِّ فِتْنَةِ الْغِنَى وَمِنْ شَرِّ فِتْنَةِ الْفَقْرِ، وَأَعُوذُ بِكَ مِنْ شَرِّ فِتْنَةِ الْمَسِيحِ الدَّجَّالِ، اللَّهُمَّ اغْسِلْ خَطَايَايَ بِمَاءِ الثَّلْجِ وَالْبَرَدِ وَنَقِّ قَلْبِي مِنَ الْخَطَايَا كَمَا نَقَّيْتَ الثَّوْبَ الْأَبْيَضَ مِنَ الدَّنَسِ، وَبَاعِدْ بَيْنِي وَبَيْنَ خَطَايَايَ كَمَا بَاعَدْتَ بَيْنَ الْمَشْرِقِ وَالْمَغْرِبِ، اللَّهُمَّ فَإِنِّي أَعُوذُ بِكَ مِنَ الْكَسَلِ وَالْهَرَمِ وَالْمَأْثَمِ وَالْمَغْرَمِ \""\""،nصحیح مسلم حدیث: 6871 عربی حدیث: 589""","Sahih","Sahih Muslim 6871","","","14. باب: دعاؤں اور اعوذ باللہ کا بیان۔دعائیں اور اللہ کی پناہ میں آنا"
"6872","وحَدَّثَنَاه أَبُو كُرَيْبٍ ، حَدَّثَنَا أَبُو مُعَاوِيَةَ ، وَوَكِيعٌ ، عَنْ هِشَامٍ بِهَذَا الْإِسْنَادِ.nصحیح مسلم حدیث: 6872 عربی حدیث: 589","Sahih","Sahih Muslim 6872","","","14. باب: دعاؤں اور اعوذ باللہ کا بیان۔دعائیں اور اللہ کی پناہ میں آنا"
"6873","حَدَّثَنَا يَحْيَى بْنُ أَيُّوبَ ، حَدَّثَنَا ابْنُ عُلَيَّةَ ، قَالَ: وَأَخْبَرَنَا سُلَيْمَانُ التَّيْمِيُّ ، حَدَّثَنَا أَنَسُ بْنُ مَالِكٍ ، قَالَ: كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ: \\"" اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْعَجْزِ وَالْكَسَلِ وَالْجُبْنِ وَالْهَرَمِ وَالْبُخْلِ، وَأَعُوذُ بِكَ مِنْ عَذَابِ الْقَبْرِ وَمِنْ فِتْنَةِ الْمَحْيَا وَالْمَمَاتِ \""\""،nصحیح مسلم حدیث: 6873 عربی حدیث: 2706""","Sahih","Sahih Muslim 6873","","","15. باب:سستی اور عاجر ہونے سے پناہ مانگنے کا بیان۔(نیکی کے کاموں سے) عاجز رہ جانے اور سستی وغیرہ سے (اللہ کی) پناہ مانگناChapter: Seeking Refuge With Allah From Helplessness, Laziness Etc"
"6874","وحَدَّثَنَا أَبُو كَامِلٍ ، حَدَّثَنَا يَزِيدُ بْنُ زُرَيْعٍ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى ، حَدَّثَنَا مُعْتَمِرٌ كِلَاهُمَا، عَنْ التَّيْمِيِّ ، عَنْ أَنَسٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ، غَيْرَ أَنَّ يَزِيدَ لَيْسَ فِي حَدِيثِهِ قَوْلُهُ وَمِنْ فِتْنَةِ الْمَحْيَا وَالْمَمَاتِ،nصحیح مسلم حدیث: 6874 عربی حدیث: 2706","Sahih","Sahih Muslim 6874","","","15. باب:سستی اور عاجر ہونے سے پناہ مانگنے کا بیان۔(نیکی کے کاموں سے) عاجز رہ جانے اور سستی وغیرہ سے (اللہ کی) پناہ مانگناChapter: Seeking Refuge With Allah From Helplessness, Laziness Etc"
"6875","حَدَّثَنَا أَبُو كُرَيْبٍ مُحَمَّدُ بْنُ الْعَلَاءِ ، أَخْبَرَنَا ابْنُ مُبَارَكٍ ، عَنْ سُلَيْمَانَ التَّيْمِيِّ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَنَّهُ تَعَوَّذَ مِنْ أَشْيَاءَ ذَكَرَهَا وَالْبُخْلِ.nصحیح مسلم حدیث: 6875 عربی حدیث: 2706","Sahih","Sahih Muslim 6875","","","15. باب:سستی اور عاجر ہونے سے پناہ مانگنے کا بیان۔(نیکی کے کاموں سے) عاجز رہ جانے اور سستی وغیرہ سے (اللہ کی) پناہ مانگناChapter: Seeking Refuge With Allah From Helplessness, Laziness Etc"
"6876","حَدَّثَنَا أَبُو بَكْرِ بْنُ نَافِعٍ الْعَبْدِيُّ ، حَدَّثَنَا بَهْزُ بْنُ أَسَدٍ الْعَمِّيُّ ، حَدَّثَنَا هَارُونُ الْأَعْوَرُ ، حَدَّثَنَا شُعَيْبُ بْنُ الْحَبْحَابِ ، عَنْ أَنَسٍ ، قَالَ: كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَدْعُو بِهَؤُلَاءِ الدَّعَوَاتِ: \\"" اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْبُخْلِ وَالْكَسَلِ وَأَرْذَلِ الْعُمُرِ، وَعَذَابِ الْقَبْرِ وَفِتْنَةِ الْمَحْيَا وَالْمَمَاتِ \""\"".nصحیح مسلم حدیث: 6876 عربی حدیث: 2706""","Sahih","Sahih Muslim 6876","","","15. باب:سستی اور عاجر ہونے سے پناہ مانگنے کا بیان۔(نیکی کے کاموں سے) عاجز رہ جانے اور سستی وغیرہ سے (اللہ کی) پناہ مانگناChapter: Seeking Refuge With Allah From Helplessness, Laziness Etc"
"6877","حَدَّثَنِي عَمْرٌو النَّاقِدُ ، وَزُهَيْرُ بْنُ حَرْبٍ ، قَالَا: حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، حَدَّثَنِي سُمَيٌّ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ : أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ \\"" يَتَعَوَّذُ مِنْ سُوءِ الْقَضَاءِ، وَمِنْ دَرَكِ الشَّقَاءِ، وَمِنْ شَمَاتَةِ الْأَعْدَاءِ، وَمِنْ جَهْدِ الْبَلَاءِ \""\""، قَالَ عَمْرٌ وَفِي حَدِيثِهِ: قَالَ سُفْيَانُ: أَشُكُّ أَنِّي زِدْتُ وَاحِدَةً مِنْهَا.nصحیح مسلم حدیث: 6877 عربی حدیث: 2707""","Sahih","Sahih Muslim 6877","","","16. باب: بری قضا اور بدبختی سے پناہ مانگنے کا بیان۔اپنے حق میں برے فیصلے اور بدبختی کے آ لینے وغیرہ سے پناہ مانگناChapter: Seeking Refuge From A Bad End, And Misery Etc"
"6878","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ رُمْحٍ وَاللَّفْظُ لَهُ، أَخْبَرَنَا اللَّيْثُ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، عَنْ الْحَارِثِ بْنِ يَعْقُوبَ ، أَنَّ يَعْقُوبَ بْنَ عَبْدِ اللَّهِ حَدَّثَهُ أَنَّهُ سَمِعَ بُسْرَ بْنَ سَعِيدٍ ، يَقُولُ: سَمِعْتُ سَعْدَ بْنَ أَبِي وَقَّاصٍ ، يَقُولُ: سَمِعْتُ خَوْلَةَ بِنْتَ حَكِيمٍ السُّلَمِيَّةَ ، تَقُولُ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ: \\"" مَنْ نَزَلَ مَنْزِلًا، ثُمَّ قَالَ: أَعُوذُ بِكَلِمَاتِ اللَّهِ التَّامَّاتِ مِنْ شَرِّ مَا خَلَقَ، لَمْ يَضُرَّهُ شَيْءٌ حَتَّى يَرْتَحِلَ مِنْ مَنْزِلِهِ ذَلِكَ \""\"".nصحیح مسلم حدیث: 6878 عربی حدیث: 2708""","Sahih","Sahih Muslim 6878","","","16. باب: بری قضا اور بدبختی سے پناہ مانگنے کا بیان۔اپنے حق میں برے فیصلے اور بدبختی کے آ لینے وغیرہ سے پناہ مانگناChapter: Seeking Refuge From A Bad End, And Misery Etc"
"6879","وحَدَّثَنَا هَارُونُ بْنُ مَعْرُوفٍ ، وَأَبُو الطَّاهِرِ كِلَاهُمَا، عَنْ ابْنِ وَهْبٍ وَاللَّفْظُ لِهَارُونَ، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ، قَالَ: وَأَخْبَرَنَا عَمْرٌو وَهُوَ ابْنُ الْحَارِثِ ، أَنَّ يَزِيدَ بْنَ أَبِي حَبِيبٍ ، وَالْحَارِثَ بْنَ يَعْقُوبَ حَدَّثَاهُ، عَنْ يَعْقُوبَ بْنِ عَبْدِ اللَّهِ بْنِ الْأَشَجِّ، عَنْ بُسْرِ بْنِ سَعِيدٍ ، عَنْ سَعْدِ بْنِ أَبِي وَقَّاصٍ ، عَنْ خَوْلَةَ بِنْتِ حَكِيمٍ السُّلَمِيَّةِ أَنَّهَا سَمِعَتْ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" إِذَا نَزَلَ أَحَدُكُمْ مَنْزِلًا، فَلْيَقُلْ أَعُوذُ بِكَلِمَاتِ اللَّهِ التَّامَّاتِ مِنْ شَرِّ مَا خَلَقَ، فَإِنَّهُ لَا يَضُرُّهُ شَيْءٌ حَتَّى يَرْتَحِلَ مِنْهُ \""\"".nصحیح مسلم حدیث: 6879 عربی حدیث: 2708""","Sahih","Sahih Muslim 6879","","","16. باب: بری قضا اور بدبختی سے پناہ مانگنے کا بیان۔اپنے حق میں برے فیصلے اور بدبختی کے آ لینے وغیرہ سے پناہ مانگناChapter: Seeking Refuge From A Bad End, And Misery Etc"
"6880","(حديث مرفوع) قَالَ يَعْقُوبُ وَقَالَ الْقَعْقَاعُ بْنُ حَكِيمٍ ، عَنْ ذَكْوَانَ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّهُ قَالَ: جَاءَ رَجُلٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: يَا رَسُولَ اللَّهِ، مَا لَقِيتُ مِنْ عَقْرَبٍ لَدَغَتْنِي الْبَارِحَةَ، قَالَ: \\"" أَمَا لَوْ قُلْتَ حِينَ أَمْسَيْتَ أَعُوذُ بِكَلِمَاتِ اللَّهِ التَّامَّاتِ مِنْ شَرِّ مَا خَلَقَ لَمْ تَضُرَّكَ \""\""،nصحیح مسلم حدیث: 6880 عربی حدیث: 2709""","Sahih","Sahih Muslim 6880","","","16. باب: بری قضا اور بدبختی سے پناہ مانگنے کا بیان۔اپنے حق میں برے فیصلے اور بدبختی کے آ لینے وغیرہ سے پناہ مانگناChapter: Seeking Refuge From A Bad End, And Misery Etc"
"6881","وحَدَّثَنِي عِيسَى بْنُ حَمَّادٍ الْمِصْرِيُّ ، أَخْبَرَنِي اللَّيْثُ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، عَنْ جَعْفَرٍ ، عَنْ يَعْقُوبَ ، أَنَّهُ ذَكَرَ لَهُ أَنَّ أَبَا صَالِحٍ مَوْلَى غَطَفَانَ أَخْبَرَهُ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ ، يَقُولُ: قَالَ رَجُلٌ: يَا رَسُولَ اللَّهِ، لَدَغَتْنِي عَقْرَبٌ، بِمِثْلِ حَدِيثِ ابْنِ وَهْبٍ.nصحیح مسلم حدیث: 6881 عربی حدیث: 2709","Sahih","Sahih Muslim 6881","","","16. باب: بری قضا اور بدبختی سے پناہ مانگنے کا بیان۔اپنے حق میں برے فیصلے اور بدبختی کے آ لینے وغیرہ سے پناہ مانگناChapter: Seeking Refuge From A Bad End, And Misery Etc"
"6882","حَدَّثَنَا عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ وَاللَّفْظُ لِعُثْمَانَ، قَالَ إِسْحَاقُ: أَخْبَرَنَا، وقَالَ عُثْمَانُ: حَدَّثَنَا جَرِيرٌ ، عَنْ مَنْصُورٍ ، عَنْ سَعْدِ بْنِ عُبَيْدَةَ ، حَدَّثَنِي الْبَرَاءُ بْنُ عَازِبٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" إِذَا أَخَذْتَ مَضْجَعَكَ فَتَوَضَّأْ وُضُوءَكَ لِلصَّلَاةِ، ثُمَّ اضْطَجِعْ عَلَى شِقِّكَ الْأَيْمَنِ، ثُمَّ قُلْ: اللَّهُمَّ إِنِّي أَسْلَمْتُ وَجْهِي إِلَيْكَ، وَفَوَّضْتُ أَمْرِي إِلَيْكَ، وَأَلْجَأْتُ ظَهْرِي إِلَيْكَ، رَغْبَةً وَرَهْبَةً إِلَيْكَ، لَا مَلْجَأَ وَلَا مَنْجَا مِنْكَ إِلَّا إِلَيْكَ، آمَنْتُ بِكِتَابِكَ الَّذِي أَنْزَلْتَ وَبِنَبِيِّكَ الَّذِي أَرْسَلْتَ، وَاجْعَلْهُنَّ مِنْ آخِرِ كَلَامِكَ: فَإِنْ مُتَّ مِنْ لَيْلَتِكَ مُتَّ وَأَنْتَ عَلَى الْفِطْرَةِ \""\""، قَالَ: فَرَدَّدْتُهُنَّ لِأَسْتَذْكِرَهُنَّ، فَقُلْتُ: آمَنْتُ بِرَسُولِكَ الَّذِي أَرْسَلْتَ، قَالَ: قُلْ: آمَنْتُ بِنَبِيِّكَ الَّذِي أَرْسَلْتَ،nصحیح مسلم حدیث: 6882 عربی حدیث: 2710""","Sahih","Sahih Muslim 6882","","","17. باب: سوتے وقت کی دعا۔سوتے وقت کی دعاChapter: Supplication When Going To Sleep"
"6883","وحَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، حَدَّثَنَا عَبْدُ اللَّهِ يَعْنِي ابْنَ إِدْرِيسَ ، قَالَ: سَمِعْتُ حُصَيْنًا ، عَنْ سَعْدِ بْنِ عُبَيْدَةَ ، عَنْ الْبَرَاءِ بْنِ عَازِبٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِهَذَا الْحَدِيثِ، غَيْرَ أَنَّ مَنْصُورًا أَتَمُّ حَدِيثًا وَزَادَ فِي حَدِيثِ حُصَيْنٍ، وَإِنْ أَصْبَحَ أَصَابَ خَيْرًا.nصحیح مسلم حدیث: 6883 عربی حدیث: 2710","Sahih","Sahih Muslim 6883","","","17. باب: سوتے وقت کی دعا۔سوتے وقت کی دعاChapter: Supplication When Going To Sleep"
"6884","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا أَبُو دَاوُدَ ، حَدَّثَنَا شُعْبَةُ . ح وحَدَّثَنَا ابْنُ بَشَّارٍ ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ ، وَأَبُو دَاوُدَ ، قَالَا: حَدَّثَنَا شُعْبَةُ ، عَنْ عَمْرِو بْنِ مُرَّةَ ، قَالَ: سَمِعْتُ سَعْدَ بْنَ عُبَيْدَةَ يُحَدِّثُ، عَنْ الْبَرَاءِ بْنِ عَازِبٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَمَرَ رَجُلًا إِذَا أَخَذَ مَضْجَعَهُ مِنَ اللَّيْلِ أَنْ يَقُولَ: \\"" اللَّهُمَّ أَسْلَمْتُ نَفْسِي إِلَيْكَ، وَوَجَّهْتُ وَجْهِي إِلَيْكَ، وَأَلْجَأْتُ ظَهْرِي إِلَيْكَ، وَفَوَّضْتُ أَمْرِي إِلَيْكَ، رَغْبَةً وَرَهْبَةً إِلَيْكَ، لَا مَلْجَأَ وَلَا مَنْجَا مِنْكَ إِلَّا إِلَيْكَ، آمَنْتُ بِكِتَابِكَ الَّذِي أَنْزَلْتَ وَبِرَسُولِكَ الَّذِي أَرْسَلْتَ، فَإِنْ مَاتَ مَاتَ عَلَى الْفِطْرَةِ \""\""، وَلَمْ يَذْكُرْ ابْنُ بَشَّارٍ فِي حَدِيثِهِ مِنَ اللَّيْلِ،nصحیح مسلم حدیث: 6884 عربی حدیث: 2710""","Sahih","Sahih Muslim 6884","","","17. باب: سوتے وقت کی دعا۔سوتے وقت کی دعاChapter: Supplication When Going To Sleep"
"6885","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، أَخْبَرَنَا أَبُو الْأَحْوَصِ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِرَجُلٍ يَا فُلَانُ: إِذَا أَوَيْتَ إِلَى فِرَاشِكَ بِمِثْلِ حَدِيثِ عَمْرِو بْنِ مُرَّةَ، غَيْرَ أَنَّهُ، قَالَ: وَبِنَبِيِّكَ الَّذِي أَرْسَلْتَ فَإِنْ مُتَّ مِنْ لَيْلَتِكَ مُتَّ عَلَى الْفِطْرَةِ، وَإِنْ أَصْبَحْتَ أَصَبْتَ خَيْرًا،nصحیح مسلم حدیث: 6885 عربی حدیث: 2710","Sahih","Sahih Muslim 6885","","","17. باب: سوتے وقت کی دعا۔سوتے وقت کی دعاChapter: Supplication When Going To Sleep"
"6886","حَدَّثَنَا ابْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، عَنْ أَبِي إِسْحَاقَ ، أَنَّهُ سَمِعَ الْبَرَاءَ بْنَ عَازِبٍ ، يَقُولُ: أَمَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَجُلًا بِمِثْلِهِ، وَلَمْ يَذْكُرْ وَإِنْ أَصْبَحْتَ أَصَبْتَ خَيْرًا.nصحیح مسلم حدیث: 6886 عربی حدیث: 2710","Sahih","Sahih Muslim 6886","","","17. باب: سوتے وقت کی دعا۔سوتے وقت کی دعاChapter: Supplication When Going To Sleep"
"6887","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا شُعْبَةُ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي السَّفَرِ ، عَنْ أَبَي بَكْرِ بْنِ أَبِي مُوسَى عَنْ الْبَرَاءِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا أَخَذَ مَضْجَعَهُ، قَالَ: \\"" اللَّهُمَّ بِاسْمِكَ أَحْيَا وَبِاسْمِكَ أَمُوتُ \""\""، وَإِذَا اسْتَيْقَظَ، قَالَ: \""\"" الْحَمْدُ لِلَّهِ الَّذِي أَحْيَانَا بَعْدَ مَا أَمَاتَنَا وَإِلَيْهِ النُّشُورُ \""\"".nصحیح مسلم حدیث: 6887 عربی حدیث: 2711""","Sahih","Sahih Muslim 6887","","","17. باب: سوتے وقت کی دعا۔سوتے وقت کی دعاChapter: Supplication When Going To Sleep"
"6888","حَدَّثَنَا عُقْبَةُ بْنُ مُكْرَمٍ الْعَمِّيُّ ، وَأَبُو بَكْرِ بْنُ نَافِعٍ ، قَالَا: حَدَّثَنَا غُنْدَرٌ ، حَدَّثَنَا شُعْبَةُ ، عَنْ خَالِدٍ ، قَالَ: سَمِعْتُ عَبْدَ اللَّهِ بْنَ الْحَارِثِ يُحَدِّثُ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، أَنَّهُ أَمَرَ رَجُلًا إِذَا أَخَذَ مَضْجَعَهُ قَالَ: \\"" اللَّهُمَّ خَلَقْتَ نَفْسِي وَأَنْتَ تَوَفَّاهَا لَكَ مَمَاتُهَا وَمَحْيَاهَا، إِنْ أَحْيَيْتَهَا فَاحْفَظْهَا وَإِنْ أَمَتَّهَا فَاغْفِرْ لَهَا، اللَّهُمَّ إِنِّي أَسْأَلُكَ الْعَافِيَةَ \""\""، فَقَالَ لَهُ رَجُلٌ: أَسَمِعْتَ هَذَا مِنْ عُمَرَ؟، فَقَالَ: مِنْ خَيْرٍ مِنْ عُمَرَ، مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ ابْنُ نَافِعٍ فِي رِوَايَتِهِ: عَنْ عَبْدِ اللَّهِ بْنِ الْحَارِثِ، وَلَمْ يَذْكُرْ سَمِعْتُ.nصحیح مسلم حدیث: 6888 عربی حدیث: 2712""","Sahih","Sahih Muslim 6888","","","17. باب: سوتے وقت کی دعا۔سوتے وقت کی دعاChapter: Supplication When Going To Sleep"
"6889","حَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا جَرِيرٌ ، عَنْ سُهَيْلٍ ، قَالَ: كَانَ أَبُو صَالِحٍ يَأْمُرُنَا إِذَا أَرَادَ أَحَدُنَا أَنْ يَنَامَ أَنْ يَضْطَجِعَ عَلَى شِقِّهِ الْأَيْمَنِ، ثُمَّ يَقُولُ: \\"" اللَّهُمَّ رَبَّ السَّمَاوَاتِ وَرَبَّ الْأَرْضِ، وَرَبَّ الْعَرْشِ الْعَظِيمِ، رَبَّنَا وَرَبَّ كُلِّ شَيْءٍ، فَالِقَ الْحَبِّ وَالنَّوَى وَمُنْزِلَ التَّوْرَاةِ وَالْإِنْجِيلِ وَالْفُرْقَانِ، أَعُوذُ بِكَ مِنْ شَرِّ كُلِّ شَيْءٍ أَنْتَ آخِذٌ بِنَاصِيَتِهِ، اللَّهُمَّ أَنْتَ الْأَوَّلُ فَلَيْسَ قَبْلَكَ شَيْءٌ، وَأَنْتَ الْآخِرُ فَلَيْسَ بَعْدَكَ شَيْءٌ، وَأَنْتَ الظَّاهِرُ فَلَيْسَ فَوْقَكَ شَيْءٌ، وَأَنْتَ الْبَاطِنُ فَلَيْسَ دُونَكَ شَيْءٌ، اقْضِ عَنَّا الدَّيْنَ وَأَغْنِنَا مِنَ الْفَقْرِ \""\"" وَكَانَ يَرْوِي ذَلِكَ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،nصحیح مسلم حدیث: 6889 عربی حدیث: 2713""","Sahih","Sahih Muslim 6889","","","17. باب: سوتے وقت کی دعا۔سوتے وقت کی دعاChapter: Supplication When Going To Sleep"
"6890","وحَدَّثَنِي عَبْدُ الْحَمِيدِ بْنُ بَيَانٍ الْوَاسِطِيُّ ، حَدَّثَنَا خَالِدٌ يَعْنِي الطَّحَّانَ ، عَنْ سُهَيْلٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَأْمُرُنَا إِذَا أَخَذْنَا مَضْجَعَنَا أَنْ نَقُولَ بِمِثْلِ حَدِيثِ جَرِيرٍ، وَقَالَ: مِنْ شَرِّ كُلِّ دَابَّةٍ أَنْتَ آخِذٌ بِنَاصِيَتِهَا،nصحیح مسلم حدیث: 6890 عربی حدیث: 2713","Sahih","Sahih Muslim 6890","","","17. باب: سوتے وقت کی دعا۔سوتے وقت کی دعاChapter: Supplication When Going To Sleep"
"6891","وحَدَّثَنَا أَبُو كُرَيْبٍ مُحَمَّدُ بْنُ الْعَلَاءِ ، حَدَّثَنَا أَبُو أُسَامَةَ . ح وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، قَالَا: حَدَّثَنَا ابْنُ أَبِي عُبَيْدَةَ ، حَدَّثَنَا أَبِي كِلَاهُمَا، عَنْ الْأَعْمَشِ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: أَتَتْ فَاطِمَةُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تَسْأَلُهُ خَادِمًا، فَقَالَ لَهَا قُولِي: اللَّهُمَّ رَبَّ السَّمَاوَاتِ السَّبْعِ، بِمِثْلِ حَدِيثِ سُهَيْلٍ عَنْ أَبِيهِ.nصحیح مسلم حدیث: 6891 عربی حدیث: 2713","Sahih","Sahih Muslim 6891","","","17. باب: سوتے وقت کی دعا۔سوتے وقت کی دعاChapter: Supplication When Going To Sleep"
"6892","وحَدَّثَنَا إِسْحَاقُ بْنُ مُوسَى الْأَنْصَارِيُّ ، حَدَّثَنَا أَنَسُ بْنُ عِيَاضٍ ، حَدَّثَنَا عُبَيْدُ اللَّهِ ، حَدَّثَنِي سَعِيدُ بْنُ أَبِي سَعِيدٍ الْمَقْبُرِيُّ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" إِذَا أَوَى أَحَدُكُمْ إِلَى فِرَاشِهِ، فَلْيَأْخُذْ دَاخِلَةَ إِزَارِهِ، فَلْيَنْفُضْ بِهَا فِرَاشَهُ وَلْيُسَمِّ اللَّهَ، فَإِنَّهُ لَا يَعْلَمُ مَا خَلَفَهُ بَعْدَهُ عَلَى فِرَاشِهِ، فَإِذَا أَرَادَ أَنْ يَضْطَجِعَ فَلْيَضْطَجِعْ عَلَى شِقِّهِ الْأَيْمَنِ، وَلْيَقُلْ: سُبْحَانَكَ اللَّهُمَّ رَبِّي بِكَ وَضَعْتُ جَنْبِي وَبِكَ أَرْفَعُهُ، إِنْ أَمْسَكْتَ نَفْسِي فَاغْفِرْ لَهَا، وَإِنْ أَرْسَلْتَهَا فَاحْفَظْهَا بِمَا تَحْفَظُ بِهِ عِبَادَكَ الصَّالِحِينَ \""\""،nصحیح مسلم حدیث: 6892 عربی حدیث: 2714""","Sahih","Sahih Muslim 6892","","","17. باب: سوتے وقت کی دعا۔سوتے وقت کی دعاChapter: Supplication When Going To Sleep"
"6893","وحَدَّثَنَا أَبُو كُرَيْبٍ ، حَدَّثَنَا عَبْدَةُ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عُمَرَ بِهَذَا الْإِسْنَادِ، وَقَالَ: ثُمَّ لَيَقُلْ بِاسْمِكَ رَبِّي وَضَعْتُ جَنْبِي، فَإِنْ أَحْيَيْتَ نَفْسِي فَارْحَمْهَا.nصحیح مسلم حدیث: 6893 عربی حدیث: 2714","Sahih","Sahih Muslim 6893","","","17. باب: سوتے وقت کی دعا۔سوتے وقت کی دعاChapter: Supplication When Going To Sleep"
"6894","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَةَ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا أَوَى إِلَى فِرَاشِهِ، قَالَ: \\"" الْحَمْدُ لِلَّهِ الَّذِي أَطْعَمَنَا وَسَقَانَا وَكَفَانَا وَآوَانَا، فَكَمْ مِمَّنْ لَا كَافِيَ لَهُ وَلَا مُؤْوِيَ؟ \""\"".nصحیح مسلم حدیث: 6894 عربی حدیث: 2715""","Sahih","Sahih Muslim 6894","","","17. باب: سوتے وقت کی دعا۔سوتے وقت کی دعاChapter: Supplication When Going To Sleep"
"6895","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ وَاللَّفْظُ لِيَحْيَى، قَالَا: أَخْبَرَنَا جَرِيرٌ ، عَنْ مَنْصُورٍ ، عَنْ هِلَالٍ ، عَنْ فَرْوَةَ بْنِ نَوْفَلٍ الْأَشْجَعِيِّ ، قَالَ: سَأَلْتُ عَائِشَةَ عَمَّا كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَدْعُو بِهِ اللَّهَ؟ قَالَتْ: كَانَ يَقُولُ: \\"" اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ شَرِّ مَا عَمِلْتُ وَمِنْ شَرِّ مَا لَمْ أَعْمَلْ \""\"".nصحیح مسلم حدیث: 6895 عربی حدیث: 2716""","Sahih","Sahih Muslim 6895","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6896","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، قَالَا: حَدَّثَنَا عَبْدُ اللَّهِ بْنُ إِدْرِيسَ ، عَنْ حُصَيْنٍ ، عَنْ هِلَالٍ ، عَنْ فَرْوَةَ بْنِ نَوْفَلٍ ، قَالَ: سَأَلْتُ عَائِشَةَ عَنْ دُعَاءٍ كَانَ يَدْعُو بِهِ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَتْ: كَانَ يَقُولُ: \\"" اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ شَرِّ مَا عَمِلْتُ وَشَرِّ مَا لَمْ أَعْمَلْ \""\""،nصحیح مسلم حدیث: 6896 عربی حدیث: 2716""","Sahih","Sahih Muslim 6896","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6897","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا ابْنُ أَبِي عَدِيٍّ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ عَمْرِو بْنِ جَبَلَةَ ، حَدَّثَنَا مُحَمَّدٌ يَعْنِي ابْنَ جَعْفَرٍ كِلَاهُمَا، عَنْ شُعْبَةَ ، عَنْ حُصَيْنٍ بِهَذَا الْإِسْنَادِ مِثْلَهُ، غَيْرَ أَنَّ فِي حَدِيثِ مُحَمَّدِ بْنِ جَعْفَرٍ: وَمِنْ شَرِّ مَا لَمْ أَعْمَلْ.nصحیح مسلم حدیث: 6897 عربی حدیث: 2716","Sahih","Sahih Muslim 6897","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6898","وحَدَّثَنِي عَبْدُ اللَّهِ بْنُ هَاشِمٍ ، حَدَّثَنَا وَكِيعٌ ، عَنْ الْأَوْزَاعِيِّ ، عَنْ عَبْدَةَ بْنِ أَبِي لُبَابَةَ ، عَنْ هِلَالِ بْنِ يَسَافٍ ، عَنْ فَرْوَةَ بْنِ نَوْفَلٍ ، عَنْ عَائِشَةَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ فِي دُعَائِهِ: \\"" اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ شَرِّ مَا عَمِلْتُ وَشَرِّ مَا لَمْ أَعْمَلْ \""\"".nصحیح مسلم حدیث: 6898 عربی حدیث: 2716""","Sahih","Sahih Muslim 6898","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6899","حَدَّثَنِي حَجَّاجُ بْنُ الشَّاعِرِ ، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ عَمْرٍو أَبُو مَعْمَرٍ ، حَدَّثَنَا عَبْدُ الْوَارِثِ ، حَدَّثَنَا الْحُسَيْنُ ، حَدَّثَنِي ابْنُ بُرَيْدَةَ ، عَنْ يَحْيَى بْنِ يَعْمَرَ ، عَنْ ابْنِ عَبَّاسٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ، يَقُولُ: \\"" اللَّهُمَّ لَكَ أَسْلَمْتُ وَبِكَ آمَنْتُ، وَعَلَيْكَ تَوَكَّلْتُ وَإِلَيْكَ أَنَبْتُ وَبِكَ خَاصَمْتُ، اللَّهُمَّ إِنِّي أَعُوذُ بِعِزَّتِكَ لَا إِلَهَ إِلَّا أَنْتَ أَنْ تُضِلَّنِي، أَنْتَ الْحَيُّ الَّذِي لَا يَمُوتُ وَالْجِنُّ وَالْإِنْسُ يَمُوتُونَ \""\"".nصحیح مسلم حدیث: 6899 عربی حدیث: 2717""","Sahih","Sahih Muslim 6899","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6900","حَدَّثَنِي أَبُو الطَّاهِرِ ، أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، أَخْبَرَنِي سُلَيْمَانُ بْنُ بِلَالٍ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا كَانَ فِي سَفَرٍ وَأَسْحَرَ، يَقُولُ: \\"" سَمِعَ سَامِعٌ بِحَمْدِ اللَّهِ، وَحُسْنِ بَلَائِهِ عَلَيْنَا رَبَّنَا صَاحِبْنَا، وَأَفْضِلْ عَلَيْنَا عَائِذًا بِاللَّهِ مِنَ النَّارِ \""\"".nصحیح مسلم حدیث: 6900 عربی حدیث: 2718""","Sahih","Sahih Muslim 6900","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6901","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ الْعَنْبَرِيُّ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا شُعْبَةُ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ أَبِي بُرْدَةَ بْنِ أَبِي مُوسَى الْأَشْعَرِيِّ ، عَنْ أَبِيهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ كَانَ يَدْعُو بِهَذَا الدُّعَاءِ: \\"" اللَّهُمَّ اغْفِرْ لِي خَطِيئَتِي وَجَهْلِي وَإِسْرَافِي فِي أَمْرِي، وَمَا أَنْتَ أَعْلَمُ بِهِ مِنِّي اللَّهُمَّ اغْفِرْ لِي جِدِّي وَهَزْلِي وَخَطَئِي وَعَمْدِي وَكُلُّ ذَلِكَ عِنْدِي، اللَّهُمَّ اغْفِرْ لِي مَا قَدَّمْتُ وَمَا أَخَّرْتُ وَمَا أَسْرَرْتُ وَمَا أَعْلَنْتُ، وَمَا أَنْتَ أَعْلَمُ بِهِ مِنِّي، أَنْتَ الْمُقَدِّمُ وَأَنْتَ الْمُؤَخِّرُ وَأَنْتَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ \""\""،nصحیح مسلم حدیث: 6901 عربی حدیث: 2719""","Sahih","Sahih Muslim 6901","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6902","وحَدَّثَنَاه مُحَمَّدُ بْنُ بَشَّارٍ ، حَدَّثَنَا عَبْدُ الْمَلِكِ بْنُ الصَّبَّاحِ الْمِسْمَعِيُّ ، حَدَّثَنَا شُعْبَةُ فِي هَذَا الْإِسْنَادِ.nصحیح مسلم حدیث: 6902 عربی حدیث: 2719","Sahih","Sahih Muslim 6902","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6903","حَدَّثَنَا إِبْرَاهِيمُ بْنُ دِينَارٍ ، حَدَّثَنَا أَبُو قَطَنٍ عَمْرُو بْنُ الْهَيْثَمِ الْقُطَعِيُّ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي سَلَمَةَ الْمَاجِشُونِ ، عَنْ قُدَامَةَ بْنِ مُوسَى ، عَنْ أَبِي صَالِحٍ السَّمَّانِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" اللَّهُمَّ أَصْلِحْ لِي دِينِي الَّذِي هُوَ عِصْمَةُ أَمْرِي، وَأَصْلِحْ لِي دُنْيَايَ الَّتِي فِيهَا مَعَاشِي، وَأَصْلِحْ لِي آخِرَتِي الَّتِي فِيهَا مَعَادِي وَاجْعَلِ الْحَيَاةَ زِيَادَةً لِي فِي كُلِّ خَيْرٍ، وَاجْعَلِ الْمَوْتَ رَاحَةً لِي مِنْ كُلِّ شَرٍّ \""\"".nصحیح مسلم حدیث: 6903 عربی حدیث: 2720""","Sahih","Sahih Muslim 6903","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6904","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ أَبِي الْأَحْوَصِ ، عَنْ عَبْدِ اللَّهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَنَّهُ كَانَ يَقُولُ: \\"" اللَّهُمَّ إِنِّي أَسْأَلُكَ الْهُدَى وَالتُّقَى وَالْعَفَافَ وَالْغِنَى \""\""،nصحیح مسلم حدیث: 6904 عربی حدیث: 2721""","Sahih","Sahih Muslim 6904","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6905","وحَدَّثَنَا ابْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا عَبْدُ الرَّحْمَنِ ، عَنْ سُفْيَانَ ، عَنْ أَبِي إِسْحَاقَ بِهَذَا الْإِسْنَادِ مِثْلَهُ غَيْرَ أَنَّ ابْنَ الْمُثَنَّى، قَالَ فِي رِوَايَتِهِ: وَالْعِفَّةَ.nصحیح مسلم حدیث: 6905 عربی حدیث: 2721","Sahih","Sahih Muslim 6905","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6906","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، وَمُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ وَاللَّفْظُ لِابْنِ نُمَيْرٍ، قَالَ إِسْحَاقُ أَخْبَرَنَا، وقَالَ لآخَرَانِ حَدَّثَنَا أَبُو مُعَاوِيَةَ ، عَنْ عَاصِمٍ ، عَنْ عَبْدِ اللَّهِ بْنِ الْحَارِثِ ، وَعَنْ أَبِي عُثْمَانَ النَّهْدِيِّ ، عَنْ زَيْدِ بْنِ أَرْقَمَ، قَالَ: لَا أَقُولُ لَكُمْ إِلَّا كَمَا كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ، كَانَ يَقُولُ: \\"" اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْعَجْزِ وَالْكَسَلِ، وَالْجُبْنِ وَالْبُخْلِ، وَالْهَرَمِ وَعَذَابِ الْقَبْرِ، اللَّهُمَّ آتِ نَفْسِي تَقْوَاهَا وَزَكِّهَا أَنْتَ خَيْرُ مَنْ زَكَّاهَا، أَنْتَ وَلِيُّهَا وَمَوْلَاهَا، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ عِلْمٍ لَا يَنْفَعُ، وَمِنْ قَلْبٍ لَا يَخْشَعُ، وَمِنْ نَفْسٍ لَا تَشْبَعُ، وَمِنْ دَعْوَةٍ لَا يُسْتَجَابُ لَهَا \""\"".nصحیح مسلم حدیث: 6906 عربی حدیث: 2722""","Sahih","Sahih Muslim 6906","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6907","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ، عَنْ الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ ، حَدَّثَنَا إِبْرَاهِيمُ بْنُ سُوَيْدٍ النَّخَعِيُّ ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ ، عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ ، قَالَ: كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا أَمْسَى، قَالَ: \\"" أَمْسَيْنَا وَأَمْسَى الْمُلْكُ لِلَّهِ وَالْحَمْدُ لِلَّهِ لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ \""\"". قَالَ الْحَسَنُ: فَحَدَّثَنِي الزُّبَيْدُ أَنَّهُ حَفِظَ عَنْ إِبْرَاهِيمَ فِي هَذَا: لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ، اللَّهُمَّ أَسْأَلُكَ خَيْرَ هَذِهِ اللَّيْلَةِ، وَأَعُوذُ بِكَ مِنْ شَرِّ هَذِهِ اللَّيْلَةِ، وَشَرِّ مَا بَعْدَهَا، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْكَسَلِ وَسُوءِ الْكِبَرِ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ عَذَابٍ فِي النَّارِ وَعَذَابٍ فِي الْقَبْرِ \""\"".nصحیح مسلم حدیث: 6907 عربی حدیث: 2723""","Sahih","Sahih Muslim 6907","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6908","حَدَّثَنَا عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا جَرِيرٌ ، عَنْ الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ ، عَنْ إِبْرَاهِيمَ بْنِ سُوَيْدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، عَنْ عَبْدِ اللَّهِ ، قَالَ: كَانَ نَبِيُّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا أَمْسَى، قَالَ: \\"" أَمْسَيْنَا وَأَمْسَى الْمُلْكُ لِلَّهِ وَالْحَمْدُ لِلَّهِ لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ \""\""، قَالَ: أُرَاهُ قَالَ: \""\"" فِيهِنَّ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ، رَبِّ أَسْأَلُكَ خَيْرَ مَا فِي هَذِهِ اللَّيْلَةِ وَخَيْرَ مَا بَعْدَهَا، وَأَعُوذُ بِكَ مِنْ شَرِّ مَا فِي هَذِهِ اللَّيْلَةِ وَشَرِّ مَا بَعْدَهَا، رَبِّ أَعُوذُ بِكَ مِنَ الْكَسَلِ وَسُوءِ الْكِبَرِ، رَبِّ أَعُوذُ بِكَ مِنْ عَذَابٍ فِي النَّارِ، وَعَذَابٍ فِي الْقَبْرِ \""\""، وَإِذَا أَصْبَحَ، قَالَ: ذَلِكَ أَيْضًا أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ \""\"".nصحیح مسلم حدیث: 6908 عربی حدیث: 2723""","Sahih","Sahih Muslim 6908","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6909","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ حَدَّثَنَا حُسَيْنُ بْنُ عَلِيٍّ ، عَنْ زَائِدَةَ ، عَنْ الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ ، عَنْ إِبْرَاهِيمَ بْنِ سُوَيْدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، عَنْ عَبْدِ اللَّهِ ، قَالَ: كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا أَمْسَى قَالَ: \\"" أَمْسَيْنَا وَأَمْسَى الْمُلْكُ لِلَّهِ وَالْحَمْدُ لِلَّهِ لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ خَيْرِ هَذِهِ اللَّيْلَةِ وَخَيْرِ مَا فِيهَا، وَأَعُوذُ بِكَ مِنْ شَرِّهَا وَشَرِّ مَا فِيهَا، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْكَسَلِ وَالْهَرَمِ وَسُوءِ الْكِبَرِ وَفِتْنَةِ الدُّنْيَا وَعَذَابِ الْقَبْرِ \""\""، قَالَ الْحَسَنُ بْنُ عُبَيْدِ اللَّهِ : وَزَادَنِي فِيهِ زُبَيْدٌ ، عَنْ إِبْرَاهِيمَ بْنِ سُوَيْدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، عَنْ عَبْدِ اللَّهِ رَفَعَهُ، أَنَّهُ قَالَ: لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ \""\"".nصحیح مسلم حدیث: 6909 عربی حدیث: 2723""","Sahih","Sahih Muslim 6909","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6910","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ ، عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، كَانَ يَقُولُ: \\"" لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ أَعَزَّ جُنْدَهُ وَنَصَرَ عَبْدَهُ وَغَلَبَ الْأَحْزَابَ وَحْدَهُ فَلَا شَيْءَ بَعْدَهُ \""\"".nصحیح مسلم حدیث: 6910 عربی حدیث: 2724""","Sahih","Sahih Muslim 6910","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6911","حَدَّثَنَا أَبُو كُرَيْبٍ مُحَمَّدُ بْنُ الْعَلَاءِ ، حَدَّثَنَا ابْنُ إِدْرِيسَ ، قَالَ: سَمِعْتُ عَاصِمَ بْنَ كُلَيْبٍ ، عَنْ أَبِي بُرْدَةَ ، عَنْ عَلِيٍّ ، قَالَ: قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قُلْ: \\"" اللَّهُمَّ اهْدِنِي وَسَدِّدْنِي وَاذْكُرْ بِالْهُدَى هِدَايَتَكَ الطَّرِيقَ وَالسَّدَادِ سَدَادَ السَّهْمِ \""\""،nصحیح مسلم حدیث: 6911 عربی حدیث: 2725""","Sahih","Sahih Muslim 6911","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6912","وحَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا عَبْدُ اللَّهِ يَعْنِي ابْنَ إِدْرِيسَ ، أَخْبَرَنَا عَاصِمُ بْنُ كُلَيْبٍ ، بِهَذَا الْإِسْنَادِ، قَالَ: قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قُلْ: اللَّهُمَّ إِنِّي أَسْأَلُكَ الْهُدَى وَالسَّدَادَ، ثُمَّ ذَكَرَ بِمِثْلِهِ.nصحیح مسلم حدیث: 6912 عربی حدیث: 2725","Sahih","Sahih Muslim 6912","","","18. باب: دعاؤں کا بیان۔مختلف دعائیں"
"6913","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، وَعَمْرٌو النَّاقِدُ ، وابن أبي عمر واللفظ لابن أبي عمر، قَالُوا: حَدَّثَنَا سُفْيَانُ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ مَوْلَى آلِ طَلْحَةَ، عَنْ كُرَيْبٍ ، عَنْ ابْنِ عَبَّاسٍ ، عَنْ جُوَيْرِيَةَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَرَجَ مِنْ عِنْدِهَا بُكْرَةً حِينَ صَلَّى الصُّبْحَ وَهِيَ فِي مَسْجِدِهَا، ثُمَّ رَجَعَ بَعْدَ أَنْ أَضْحَى وَهِيَ جَالِسَةٌ، فَقَالَ: \\"" مَا زِلْتِ عَلَى الْحَالِ الَّتِي فَارَقْتُكِ عَلَيْهَا؟ \""\"" قَالَتْ: نَعَمْ، قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \""\"" لَقَدْ قُلْتُ بَعْدَكِ أَرْبَعَ كَلِمَاتٍ ثَلَاثَ مَرَّاتٍ، لَوْ وُزِنَتْ بِمَا قُلْتِ مُنْذُ الْيَوْمِ لَوَزَنَتْهُنَّ سُبْحَانَ اللَّهِ وَبِحَمْدِهِ عَدَدَ خَلْقِهِ وَرِضَا نَفْسِهِ وَزِنَةَ عَرْشِهِ وَمِدَادَ كَلِمَاتِهِ \""\""،nصحیح مسلم حدیث: 6913 عربی حدیث: 2726""","Sahih","Sahih Muslim 6913","","","19. باب: سوتے وقت اور دن کے آغاز میں تسبیح کرنے کا بیان۔دن کے آغاز اور سوتے وقت تسبیح کرناChapter: The Tasbih At The Beginning Of The Day And When Going To Sleep"
"6914","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، وَإِسْحَاقُ ، عَنْ مُحَمَّدِ بْنِ بِشْرٍ ، عَنْ مِسْعَرٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي رِشْدِينَ ، عَنْ ابْنِ عَبَّاسٍ ، عَنْ جُوَيْرِيَةَ ، قَالَتْ: مَرَّ بِهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حِينَ صَلَّى صَلَاةَ الْغَدَاةِ أَوْ بَعْدَ مَا صَلَّى الْغَدَاةَ، فَذَكَرَ نَحْوَهُ غَيْرَ أَنَّهُ، قَالَ: سُبْحَانَ اللَّهِ عَدَدَ خَلْقِهِ سُبْحَانَ اللَّهِ رِضَا نَفْسِهِ سُبْحَانَ اللَّهِ زِنَةَ عَرْشِهِ سُبْحَانَ اللَّهِ مِدَادَ كَلِمَاتِهِ.nصحیح مسلم حدیث: 6914 عربی حدیث: 2726","Sahih","Sahih Muslim 6914","","","19. باب: سوتے وقت اور دن کے آغاز میں تسبیح کرنے کا بیان۔دن کے آغاز اور سوتے وقت تسبیح کرناChapter: The Tasbih At The Beginning Of The Day And When Going To Sleep"
"6915","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ بَشَّارٍ وَاللَّفْظُ لِابْنِ الْمُثَنَّى، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، عَنْ الْحَكَمِ ، قَالَ: سَمِعْتُ ابْنَ أَبِي لَيْلَى ، حَدَّثَنَا عَلِيٌّ ، أَنَّ فَاطِمَةَ اشْتَكَتْ مَا تَلْقَى مِنَ الرَّحَى فِي يَدِهَا، وَأَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سَبْيٌ، فَانْطَلَقَتْ فَلَمْ تَجِدْهُ وَلَقِيَتْ عَائِشَةَ، فَأَخْبَرَتْهَا فَلَمَّا جَاءَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَخْبَرَتْهُ عَائِشَةُ بِمَجِيءِ فَاطِمَةَ إِلَيْهَا، فَجَاءَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَيْنَا وَقَدْ أَخَذْنَا مَضَاجِعَنَا فَذَهَبْنَا نَقُومُ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: عَلَى مَكَانِكُمَا، فَقَعَدَ بَيْنَنَا حَتَّى وَجَدْتُ بَرْدَ قَدَمِهِ عَلَى صَدْرِي، ثُمَّ قَالَ: \\"" أَلَا أُعَلِّمُكُمَا خَيْرًا مِمَّا سَأَلْتُمَا إِذَا أَخَذْتُمَا مَضَاجِعَكُمَا أَنْ تُكَبِّرَا اللَّهَ أَرْبَعًا وَثَلَاثِينَ، وَتُسَبِّحَاهُ ثَلَاثًا وَثَلَاثِينَ، وَتَحْمَدَاهُ ثَلَاثًا وَثَلَاثِينَ، فَهْوَ خَيْرٌ لَكُمَا مِنْ خَادِمٍ \""\""،nصحیح مسلم حدیث: 6915 عربی حدیث: 2727""","Sahih","Sahih Muslim 6915","","","19. باب: سوتے وقت اور دن کے آغاز میں تسبیح کرنے کا بیان۔دن کے آغاز اور سوتے وقت تسبیح کرناChapter: The Tasbih At The Beginning Of The Day And When Going To Sleep"
"6916","وحَدَّثَنَاه أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا وَكِيعٌ . ح وحَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ ، حَدَّثَنَا أَبِي . ح وحَدَّثَنَا ابْنُ الْمُثَنَّى ، حَدَّثَنَا ابْنُ أَبِي عَدِيٍّ كُلُّهُمْ، عَنْ شُعْبَةَ بِهَذَا الْإِسْنَادِ، وَفِي حَدِيثِ مُعَاذٍ أَخَذْتُمَا مَضْجَعَكُمَا مِنَ اللَّيْلِ،nصحیح مسلم حدیث: 6916 عربی حدیث: 2727","Sahih","Sahih Muslim 6916","","","19. باب: سوتے وقت اور دن کے آغاز میں تسبیح کرنے کا بیان۔دن کے آغاز اور سوتے وقت تسبیح کرناChapter: The Tasbih At The Beginning Of The Day And When Going To Sleep"
"6917","وحَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ عُبَيْدِ اللَّهِ بْنِ أَبِي يَزِيدَ ، عَنْ مُجَاهِدٍ ، عَنْ ابْنِ أَبِي لَيْلَى ، عَنْ عَلِيِّ بْنِ أَبِي طَالِبٍ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، وَعُبَيْدُ بْنُ يَعِيشَ ، عَنْ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، حَدَّثَنَا عَبْدُ الْمَلِكِ ، عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ ، عَنْ مُجَاهِدٍ ، عَنْ ابْنِ أَبِي لَيْلَى ، عَنْ عَلِيٍّ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِ حَدِيثِ الْحَكَمِ، عَنْ ابْنِ أَبِي لَيْلَى وَزَادَ فِي الْحَدِيثِ، قَالَ عَلِيٌّ: مَا تَرَكْتُهُ مُنْذُ سَمِعْتُهُ مِنَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قِيلَ لَهُ: وَلَا لَيْلَةَ صِفِّينَ، قَالَ: وَلَا لَيْلَةَ صِفِّينَ، وَفِي حَدِيثِ عَطَاءٍ، عَنْ مُجَاهِدٍ، عَنْ ابْنِ أَبِي لَيْلَى، قَالَ: قُلْتُ لَهُ: وَلَا لَيْلَةَ صِفِّينَ.nصحیح مسلم حدیث: 6917 عربی حدیث: 2727","Sahih","Sahih Muslim 6917","","","19. باب: سوتے وقت اور دن کے آغاز میں تسبیح کرنے کا بیان۔دن کے آغاز اور سوتے وقت تسبیح کرناChapter: The Tasbih At The Beginning Of The Day And When Going To Sleep"
"6918","حَدَّثَنِي أُمَيَّةُ بْنُ بِسْطَامَ الْعَيْشِيُّ ، حَدَّثَنَا يَزِيدُ يَعْنِي ابْنَ زُرَيْعٍ ، حَدَّثَنَا رَوْحٌ وَهُوَ ابْنُ الْقَاسِمِ ، عَنْ سُهَيْلٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ فَاطِمَةَ أَتَتِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تَسْأَلُهُ خَادِمًا وَشَكَتِ الْعَمَلَ، فَقَالَ: مَا أَلْفَيْتِيهِ عِنْدَنَا، قَالَ: \\"" أَلَا أَدُلُّكِ عَلَى مَا هُوَ خَيْرٌ لَكِ مِنْ خَادِمٍ؟ تُسَبِّحِينَ ثَلَاثًا وَثَلَاثِينَ، وَتَحْمَدِينَ ثَلَاثًا وَثَلَاثِينَ، وَتُكَبِّرِينَ أَرْبَعًا وَثَلَاثِينَ حِينَ تَأْخُذِينَ مَضْجَعَكِ \""\""،nصحیح مسلم حدیث: 6918 عربی حدیث: 2728""","Sahih","Sahih Muslim 6918","","","19. باب: سوتے وقت اور دن کے آغاز میں تسبیح کرنے کا بیان۔دن کے آغاز اور سوتے وقت تسبیح کرناChapter: The Tasbih At The Beginning Of The Day And When Going To Sleep"
"6919","وحَدَّثَنِيهِ أَحْمَدُ بْنُ سَعِيدٍ الدَّارِمِيُّ ، حَدَّثَنَا حَبَّانُ ، حَدَّثَنَا وُهَيْبٌ ، حَدَّثَنَا سُهَيْلٌ بِهَذَا الْإِسْنَادِ.nصحیح مسلم حدیث: 6919 عربی حدیث: 2728","Sahih","Sahih Muslim 6919","","","19. باب: سوتے وقت اور دن کے آغاز میں تسبیح کرنے کا بیان۔دن کے آغاز اور سوتے وقت تسبیح کرناChapter: The Tasbih At The Beginning Of The Day And When Going To Sleep"
"6920","حَدَّثَنِي قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ ، عَنْ جَعْفَرِ بْنِ رَبِيعَةَ ، عَنْ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" إِذَا سَمِعْتُمْ صِيَاحَ الدِّيَكَةِ فَاسْأَلُوا اللَّهَ مِنْ فَضْلِهِ، فَإِنَّهَا رَأَتْ مَلَكًا، وَإِذَا سَمِعْتُمْ نَهِيقَ الْحِمَارِ فَتَعَوَّذُوا بِاللَّهِ مِنَ الشَّيْطَانِ، فَإِنَّهَا رَأَتْ شَيْطَانًا \""\"".nصحیح مسلم حدیث: 6920 عربی حدیث: 2729""","Sahih","Sahih Muslim 6920","","","20. باب: مرغ کی بانگ کے وقت دعا کا استحباب۔مرغ کی بانگ کے وقت دعا مانگنا مستحب ہےChapter: It Is Recommend To Say Supplication When A Rooster Crows"
"6921","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، وَعُبَيْدُ اللَّهِ بْنُ سَعِيدٍ وَاللَّفْظُ لِابْنِ سَعِيدٍ، قَالُوا: حَدَّثَنَا مُعَاذُ بْنُ هِشَامٍ ، حَدَّثَنِي أَبِي ، عَنْ قَتَادَةَ ، عَنْ أَبِي الْعَالِيَةِ ، عَنْ ابْنِ عَبَّاسٍ ، أَنَّ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، كَانَ يَقُولُ عِنْدَ الْكَرْبِ: \\"" لَا إِلَهَ إِلَّا اللَّهُ الْعَظِيمُ الْحَلِيمُ، لَا إِلَهَ إِلَّا اللَّهُ رَبُّ الْعَرْشِ الْعَظِيمِ، لَا إِلَهَ إِلَّا اللَّهُ رَبُّ السَّمَاوَاتِ وَرَبُّ الْأَرْضِ وَرَبُّ الْعَرْشِ الْكَرِيمِ \""\""،nصحیح مسلم حدیث: 6921 عربی حدیث: 2730""","Sahih","Sahih Muslim 6921","","","21. باب: مصیبت کے وقت کی دعا۔کرب (شدید تکلیف دہ مصیب کی کیفیت) کے لیے دعاChapter: Supplication At Times Of Distress"
"6922","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا وَكِيعٌ ، عَنْ هِشَامٍ ، بِهَذَا الْإِسْنَادِ، وَحَدِيثُ مُعَاذِ بْنِ هِشَامٍ أَتَمُّ،nصحیح مسلم حدیث: 6922 عربی حدیث: 2730","Sahih","Sahih Muslim 6922","","","21. باب: مصیبت کے وقت کی دعا۔کرب (شدید تکلیف دہ مصیب کی کیفیت) کے لیے دعاChapter: Supplication At Times Of Distress"
"6923","وحَدَّثَنَا عَبْدُ بْنُ حُمَيْدٍ ، أَخْبَرَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِيُّ ، حَدَّثَنَا سَعِيدُ بْنُ أَبِي عَرُوبَةَ ، عَنْ قَتَادَةَ ، أَنَّ أَبَا الْعَالِيَةِ الرِّيَاحِيَّ ، حَدَّثَهُمْ، عَنْ ابْنِ عَبَّاسٍ أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَدْعُو بِهِنَّ، وَيَقُولُهُنَّ: عِنْدَ الْكَرْبِ فَذَكَرَ بِمِثْلِ حَدِيثِ مُعَاذِ بْنِ هِشَامٍ، عَنْ أَبِيهِ، عَنْ قَتَادَةَ غَيْرَ أَنَّهُ، قَالَ: رَبُّ السَّمَاوَاتِ وَالْأَرْضِ.nصحیح مسلم حدیث: 6923 عربی حدیث: 2730","Sahih","Sahih Muslim 6923","","","21. باب: مصیبت کے وقت کی دعا۔کرب (شدید تکلیف دہ مصیب کی کیفیت) کے لیے دعاChapter: Supplication At Times Of Distress"
"6924","وحَدَّثَنِي مُحَمَّدُ بْنُ حَاتِمٍ ، حَدَّثَنَا بَهْزٌ ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ ، أَخْبَرَنِي يُوسُفُ بْنُ عَبْدِ اللَّهِ بْنِ الْحَارِثِ ، عَنْ أَبِي الْعَالِيَةِ ، عَنْ ابْنِ عَبَّاسٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا حَزَبَهُ أَمْرٌ، قَالَ: فَذَكَرَ بِمِثْلِ حَدِيثِ مُعَاذٍ، عَنْ أَبِيهِ وَزَادَ مَعَهُنَّ لَا إِلَهَ إِلَّا اللَّهُ رَبُّ الْعَرْشِ الْكَرِيمِ.nصحیح مسلم حدیث: 6924 عربی حدیث: 2730","Sahih","Sahih Muslim 6924","","","21. باب: مصیبت کے وقت کی دعا۔کرب (شدید تکلیف دہ مصیب کی کیفیت) کے لیے دعاChapter: Supplication At Times Of Distress"
"6925","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا حَبَّانُ بْنُ هِلَالٍ ، حَدَّثَنَا وُهَيْبٌ ، حَدَّثَنَا سَعِيدٌ الْجُرَيْرِيُّ ، عَنْ أَبِي عَبْدِ اللَّهِ الْجِسْرِيِّ ، عَنْ ابْنِ الصَّامِتِ ، عَنْ أَبِي ذَرٍّ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: سُئِلَ أَيُّ الْكَلَامِ أَفْضَلُ؟، قَالَ: \\"" مَا اصْطَفَى اللَّهُ لِمَلَائِكَتِهِ أَوْ لِعِبَادِهِ سُبْحَانَ اللَّهِ وَبِحَمْدِهِ \""\"".nصحیح مسلم حدیث: 6925 عربی حدیث: 2731""","Sahih","Sahih Muslim 6925","","","22. باب: سبحان اللہ وبحمدہ کی فضیلت۔سبحان اللہ و بحمدہ (کے ذکر) کی فضیلتChapter: The Virtue Of (Saying): Glory To Allah And With His Praise"
"6926","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا يَحْيَى بْنُ أَبِي بُكَيْرٍ ، عَنْ شُعْبَةَ ، عَنْ الْجُرَيْرِيِّ ، عَنْ أَبِي عَبْدِ اللَّهِ الْجِسْرِيِّ مِنْ عَنَزَةَ، عَنْ عَبْدِ اللَّهِ بْنِ الصَّامِتِ ، عَنْ أَبِي ذَرٍّ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" أَلَا أُخْبِرُكَ بِأَحَبِّ الْكَلَامِ إِلَى اللَّهِ؟ \""\""، قُلْتُ: يَا رَسُولَ اللَّهِ، أَخْبِرْنِي بِأَحَبِّ الْكَلَامِ إِلَى اللَّهِ، فَقَالَ: \""\"" إِنَّ أَحَبَّ الْكَلَامِ إِلَى اللَّهِ سُبْحَانَ اللَّهِ وَبِحَمْدِهِ \""\"".nصحیح مسلم حدیث: 6926 عربی حدیث: 2731""","Sahih","Sahih Muslim 6926","","","22. باب: سبحان اللہ وبحمدہ کی فضیلت۔سبحان اللہ و بحمدہ (کے ذکر) کی فضیلتChapter: The Virtue Of (Saying): Glory To Allah And With His Praise"
"6927","حَدَّثَنِي أَحْمَدُ بْنُ عُمَرَ بْنِ حَفْصٍ الْوَكِيعِيُّ ، حَدَّثَنَا مُحَمَّدُ بْنُ فُضَيْلٍ ، حَدَّثَنَا أَبِي ، عَنْ طَلْحَةَ بْنِ عُبَيْدِ اللَّهِ بْنِ كَرِيزٍ ، عَنْ أُمِّ الدَّرْدَاءِ ، عَنْ أَبِي الدَّرْدَاءِ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَا مِنْ عَبْدٍ مُسْلِمٍ يَدْعُو لِأَخِيهِ بِظَهْرِ الْغَيْبِ إِلَّا قَالَ الْمَلَكُ وَلَكَ بِمِثْلٍ \""\"".nصحیح مسلم حدیث: 6927 عربی حدیث: 2732""","Sahih","Sahih Muslim 6927","","","23. باب: مسلمانوں کے پس پشت دعا کرنے کی فضیلت۔مسلمانوں کے لیے ان کی عدم موجودگی میں دعا کرنے کی فضیلتChapter: The Virtue Of Praying For The Muslims In Their Absence"
"6928","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا النَّضْرُ بْنُ شُمَيْلٍ ، حَدَّثَنَا مُوسَى بْنُ سَرْوَانَ الْمُعَلِّمُ ، حَدَّثَنِي طَلْحَةُ بْنُ عُبَيْدِ اللَّهِ بْنِ كَرِيزٍ ، قَالَ: حَدَّثَتْنِي أُمُّ الدَّرْدَاءِ ، قَالَتْ: حَدَّثَنِي سَيِّدِي أَنَّهُ سَمِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" مَنْ دَعَا لِأَخِيهِ بِظَهْرِ الْغَيْبِ قَالَ: الْمَلَكُ الْمُوَكَّلُ بِهِ آمِينَ وَلَكَ بِمِثْلٍ \""\"".nصحیح مسلم حدیث: 6928 عربی حدیث: 2732""","Sahih","Sahih Muslim 6928","","","23. باب: مسلمانوں کے پس پشت دعا کرنے کی فضیلت۔مسلمانوں کے لیے ان کی عدم موجودگی میں دعا کرنے کی فضیلتChapter: The Virtue Of Praying For The Muslims In Their Absence"
"6929","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا عِيسَى بْنُ يُونُسَ ، حَدَّثَنَا عَبْدُ الْمَلِكِ بْنُ أَبِي سُلَيْمَانَ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ صَفْوَانَ وَهُوَ ابْنُ عَبْدِ اللَّهِ بْنِ صَفْوَانَ ، وَكَانَتْ تَحْتَهُ الدَّرْدَاءُ، قَالَ: قَدِمْتُ الشَّامَ، فَأَتَيْتُ أَبَا الدَّرْدَاءِ فِي مَنْزِلِهِ فَلَمْ أَجِدْهُ، وَوَجَدْتُ أُمَّ الدَّرْدَاءِ ، فَقَالَتْ: أَتُرِيدُ الْحَجَّ الْعَامَ؟، فَقُلْتُ: نَعَمْ، قَالَتْ: فَادْعُ اللَّهَ لَنَا بِخَيْرٍ، فَإِنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، كَانَ يَقُولُ:\\"" دَعْوَةُ الْمَرْءِ الْمُسْلِمِ لِأَخِيهِ بِظَهْرِ الْغَيْبِ مُسْتَجَابَةٌ عِنْدَ رَأْسِهِ مَلَكٌ مُوَكَّلٌ كُلَّمَا دَعَا لِأَخِيهِ بِخَيْرٍ، قَالَ الْمَلَكُ الْمُوَكَّلُ بِهِ: آمِينَ وَلَكَ بِمِثْلٍ\""\""،nصحیح مسلم حدیث: 6929 عربی حدیث: 2733""","Sahih","Sahih Muslim 6929","","","23. باب: مسلمانوں کے پس پشت دعا کرنے کی فضیلت۔مسلمانوں کے لیے ان کی عدم موجودگی میں دعا کرنے کی فضیلتChapter: The Virtue Of Praying For The Muslims In Their Absence"
"6930","قَالَ: فَخَرَجْتُ إِلَى السُّوقِ فَلَقِيتُ أَبَا الدَّرْدَاءِ ، فَقَالَ لِي مِثْلَ ذَلِكَ يَرْوِيهِ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،nصحیح مسلم حدیث: 6930 عربی حدیث: 2732","Sahih","Sahih Muslim 6930","","","23. باب: مسلمانوں کے پس پشت دعا کرنے کی فضیلت۔مسلمانوں کے لیے ان کی عدم موجودگی میں دعا کرنے کی فضیلتChapter: The Virtue Of Praying For The Muslims In Their Absence"
"6931","وحَدَّثَنَاه أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ ، عَنْ عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ بِهَذَا الْإِسْنَادِ مِثْلَهُ، وَقَالَ: عَنْ صَفْوَانَ بْنِ عَبْدِ اللَّهِ بْنِ صَفْوَانَ.nصحیح مسلم حدیث: 6931 عربی حدیث: 2732","Sahih","Sahih Muslim 6931","","","23. باب: مسلمانوں کے پس پشت دعا کرنے کی فضیلت۔مسلمانوں کے لیے ان کی عدم موجودگی میں دعا کرنے کی فضیلتChapter: The Virtue Of Praying For The Muslims In Their Absence"
"6932","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَابْنُ نُمَيْرٍ وَاللَّفْظُ لِابْنِ نُمَيْرٍ، قَالَا: حَدَّثَنَا أَبُو أُسَامَةَ ، وَمُحَمَّدُ بْنُ بِشْرٍ ، عَنْ زَكَرِيَّاءَ بْنِ أَبِي زَائِدَةَ ، عَنْ سَعِيدِ بْنِ أَبِي بُرْدَةَ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" إِنَّ اللَّهَ لَيَرْضَى عَنِ الْعَبْدِ أَنْ يَأْكُلَ الْأَكْلَةَ، فَيَحْمَدَهُ عَلَيْهَا أَوْ يَشْرَبَ الشَّرْبَةَ فَيَحْمَدَهُ عَلَيْهَا \""\""،nصحیح مسلم حدیث: 6932 عربی حدیث: 2734""","Sahih","Sahih Muslim 6932","","","24. باب: کھانے پینے کے بعد اللہ تعالیٰ کا شکر ادا کرنے کا استحباب۔کھانے پینے کے بعد اللہ تعالیٰ کی حمد کرنا مستحب ہےChapter: It Is Recommend To Praise Allah After Eating And Drinking"
"6933","وحَدَّثَنِيهِ زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا إِسْحَاقُ بْنُ يُوسُفَ الْأَزْرَقُ ، حَدَّثَنَا زَكَرِيَّاءُ بِهَذَا الْإِسْنَادِ.nصحیح مسلم حدیث: 6933 عربی حدیث: 2734","Sahih","Sahih Muslim 6933","","","24. باب: کھانے پینے کے بعد اللہ تعالیٰ کا شکر ادا کرنے کا استحباب۔کھانے پینے کے بعد اللہ تعالیٰ کی حمد کرنا مستحب ہےChapter: It Is Recommend To Praise Allah After Eating And Drinking"
"6934","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ ابْنِ شِهَابٍ ، عَنْ أَبِي عُبَيْدٍ مَوْلَى ابْنِ أَزْهَرَ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" يُسْتَجَابُ لِأَحَدِكُمْ مَا لَمْ يَعْجَلْ، فَيَقُولُ: قَدْ دَعَوْتُ فَلَا أَوْ فَلَمْ يُسْتَجَبْ لِي \""\"".nصحیح مسلم حدیث: 6934 عربی حدیث: 2735""","Sahih","Sahih Muslim 6934","","","25. باب: جب تک قبولیت کی جلدی نہ کرے دعا قبول ہوتی ہے۔دعا مانگنے والے کی دعا پوری ہوتی ہے اگر وہ جلد بازی کرتے ہوئے یہ نہ کہے: میں نے دعا کی لیکن قبول نہیں ہوئیChapter: It Is Recommended For The One Who Supplicated Not To Be Impatient. And Not To Say: I Supplicated And Received No Response"
"6935","حَدَّثَنِي عَبْدُ الْمَلِكِ بْنُ شُعَيْبِ بْنِ لَيْثٍ ، حَدَّثَنِي أَبِي ، عَنْ جَدِّي ، حَدَّثَنِي عُقَيْلُ بْنُ خَالِدٍ ، عَنْ ابْنِ شِهَابٍ ، أَنَّهُ قَالَ: حَدَّثَنِي أَبُو عُبَيْدٍ مَوْلَى عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ، وَكَانَ مِنَ الْقُرَّاءِ وَأَهْلِ الْفِقْهِ، قَالَ: سَمِعْتُ أَبَا هُرَيْرَةَ ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" يُسْتَجَابُ لِأَحَدِكُمْ مَا لَمْ يَعْجَلْ، فَيَقُولُ: قَدْ دَعَوْتُ رَبِّي فَلَمْ يَسْتَجِبْ لِي \""\"".nصحیح مسلم حدیث: 6935 عربی حدیث: 2735""","Sahih","Sahih Muslim 6935","","","25. باب: جب تک قبولیت کی جلدی نہ کرے دعا قبول ہوتی ہے۔دعا مانگنے والے کی دعا پوری ہوتی ہے اگر وہ جلد بازی کرتے ہوئے یہ نہ کہے: میں نے دعا کی لیکن قبول نہیں ہوئیChapter: It Is Recommended For The One Who Supplicated Not To Be Impatient. And Not To Say: I Supplicated And Received No Response"
"6936","حَدَّثَنِي أَبُو الطَّاهِرِ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي مُعَاوِيَةُ وَهُوَ ابْنُ صَالِحٍ ، عَنْ رَبِيعَةَ بْنِ يَزِيدَ ، عَنْ أَبِي إِدْرِيسَ الْخَوْلَانِيِّ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَنَّهُ قَالَ: \\"" لَا يَزَالُ يُسْتَجَابُ لِلْعَبْدِ مَا لَمْ يَدْعُ بِإِثْمٍ أَوْ قَطِيعَةِ رَحِمٍ مَا لَمْ يَسْتَعْجِلْ \""\""، قِيلَ: يَا رَسُولَ اللَّهِ، مَا الِاسْتِعْجَالُ؟، قَالَ يَقُولُ: \""\"" قَدْ دَعَوْتُ وَقَدْ دَعَوْتُ فَلَمْ أَرَ يَسْتَجِيبُ لِي، فَيَسْتَحْسِرُ عِنْدَ ذَلِكَ وَيَدَعُ الدُّعَاءَ \""\"".nصحیح مسلم حدیث: 6936 عربی حدیث: 2735""","Sahih","Sahih Muslim 6936","","","25. باب: جب تک قبولیت کی جلدی نہ کرے دعا قبول ہوتی ہے۔دعا مانگنے والے کی دعا پوری ہوتی ہے اگر وہ جلد بازی کرتے ہوئے یہ نہ کہے: میں نے دعا کی لیکن قبول نہیں ہوئیChapter: It Is Recommended For The One Who Supplicated Not To Be Impatient. And Not To Say: I Supplicated And Received No Response"
