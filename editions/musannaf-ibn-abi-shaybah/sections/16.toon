"15989","(۱۵۹۸۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِیَقْتُلَ الْمُحْرِمُ الْغُرَابَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15989","","","كتاب الحج"
"15990","(۱۵۹۹۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی قَزَعَۃَ الْبَاہِلِیِّ ، عَنْ مُہَاجِرٍ الْمَکِّیِّ ، قَالَ : سَأَلَ رَجُلٌ جَابِرَ بْنَ عَبْدِ اللہِ أَیَرْفَعُ أَحَدُنَا یَدَیْہِ إذَا رَأَی الْبَیْتَ ؟ فَقَالَ : ذَاکَ صَنِیعُ یَہُودَ ، قَدْ حَجَجْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فلم نَفْعَلْ ذَلِکَ۔ (ابوداؤد ۱۸۶۵۔ دارمی ۱۹۲۰)",": Da'if","Musannaf Ibn Abi Shaybah 15990","","","كتاب الحج"
"15991","(۱۵۹۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی قَزَعَۃَ الْبَاہِلِیِّ ، عَنْ مُہَاجِرٍ الْمَکِّیِّ ، قَالَ : سُئِلَ جَابِرُ بْنُ عَبْدِ اللہِ ، أَیَرْفَعُ الرَّجُلُ یَدَیْہِ إذَا رَأَی الْبَیْتَ ؟ فَقَالَ : قَدْ حَجَجْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَکُنَّا نَفْعَلُہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15991","","","كتاب الحج"
"15992","(۱۵۹۹۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : تُرْفَعُ الأَیْدِی فِی سَبْعَۃِ مَوَاطِنَ ، إذَا رَأَی الْبَیْتَ ، وَعَلَی الصَّفَا وَالْمَرْوَۃِ وَفِی جَمْعٍ ، وَالْعَرَفَاتِ ، وَعِنْدَ الْجِمَارِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15992","","","كتاب الحج"
"15993","(۱۵۹۹۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ الْمُنْکَدِرِ ، قَالَ : مَا أَمْعَرَ حَاجٌّ قَطُّ یَعْنِی مَا افْتَقَرَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15993","","","كتاب الحج"
"15994","(۱۵۹۹۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ یَقُولُونَ : تُرْفَعُ الأَیْدِی فِی ثَمَانِیَۃِ مَوَاطِنَ عِنْدَ الْبَیْتِ ، وَعَلَی الصَّفَا وَالْمَرْوَۃِ ، وَبِعَرَفَۃَ ، وَبِالْمُزْدَلِفَۃِ ، وَعِنْدَ الْجَمْرَتَیْنِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15994","","","كتاب الحج"
"15995","(۱۵۹۹۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ طَلْحَۃَ ، عَنْ إبْرَاہِیمَ وَخَیْثَمَۃَ ، قَالاَ : تُرْفَعُ فِی الصَّلاَۃِ ، وَعِنْدَ الْبَیْتِ ، وَعَلَی الصَّفَا وَالْمَرْوَۃِ وَبِالْمُزْدَلِفَۃِ۔","","Musannaf Ibn Abi Shaybah 15995","","","كتاب الحج"
"15996","(۱۵۹۹۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تُرْفَعُ الأَیْدِی إِلاَّ فِی سَبْعَۃِ مَوَاطِن : إذَا قُمْتَ إلَی الصَّلاَۃِ ، وَإِذَا جِئْتَ مِنْ بَلَدٍ ، وَإِذَا رَأَیْتَ الْبَیْتَ ، وَإِذَا قُمْتَ عَلَی الصَّفَا وَالْمَرْوَۃِ ، وَبِعَرَفَاتٍ ، وَبِجَمْعٍ ، وَعِنْدِ الْجِمَارِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15996","","","كتاب الحج"
"15997","(۱۵۹۹۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَوَّلُ مَا تدْخُلُ مَکَّۃَ ، فَإِذَا انْتَہَیْت إلَی الْحَجَرِ فَاحْمَدِ اللَّہَ عَلَی حُسْنِ تَیْسِیرِہِ وَبَلاَغِہِ۔","","Musannaf Ibn Abi Shaybah 15997","","","كتاب الحج"
"15998","(۱۵۹۹۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْن سَعِیدٍ - یعنی : مُحَمَّدِ بْنِ سَعِیدٍ - ، عَنْ أَبیہ سَعِیدٍ أَنَّہُ کَانَ إذَا رَأَی الْبَیْتَ ، قَالَ : اللَّہُمَّ أَنْتَ السَّلاَمُ وَمِنْک السَّلاَمُ فَحَیِّنَا رَبَّنَا بِالسَّلاَمِ۔","","Musannaf Ibn Abi Shaybah 15998","","","كتاب الحج"
"15999","(۱۵۹۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ مِنْ أَہْلِ الشَّامِ ، عَنْ مَکْحُولٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمَّا رَأَی الْبَیْتَ ، قَالَ : اللَّہُمَّ زِدْ ہَذَا الْبَیْتِ تَشْرِیفًا وَتَعْظِیمًا وَمَہَابَۃً ، وَزِدْ مَنْ حَجَّہُ ، أَوِ اعْتَمَرَہُ تَشْرِیفًا وَتَعْظِیمًا وَتَکْبِیرًا وَبِرًّا۔ (طبرانی ۳۰۵۳)",": Da'if","Musannaf Ibn Abi Shaybah 15999","","","كتاب الحج"
"16000","(۱۶۰۰۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ مُحَمَّدِ بْنِ سَعِیدٍ ، عَنْ أَبِیہِ ، أَنَّ عُمَرَ لَمَّا دَخَلَ الْبَیْتَ ، قَالَ : اللَّہُمَّ أَنْتَ السَّلاَمُ ، وَمِنْک السَّلاَمُ ، فَحَیِّنَا رَبَّنَا بِالسَّلاَمِ۔",": Da'if","Musannaf Ibn Abi Shaybah 16000","","","كتاب الحج"
"16001","(۱۶۰۰۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ مُحَمَّدِ بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّہُ کَانَ إذَا دَخَلَ مَسْجِدَ الْکَعْبَۃِ وَنَظَرَ إلَی الْبَیْتِ ، قَالَ : اللَّہُمَّ أَنْتَ السَّلاَمُ وَمِنْک السَّلاَمُ فَحَیِّنَا رَبَّنَا بِالسَّلاَمِ۔","","Musannaf Ibn Abi Shaybah 16001","","","كتاب الحج"
"16002","(۱۶۰۰۲) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ حُمَیْدِ بْنِ صَخْرٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ قَالَ : إنِّہَا لَحَوْجَائُ فِی نَفْسِی أَنْ أَمُوتَ قَبْلَ أَنْ أَحُجَّ مَاشِیًا۔",": Hasan","Musannaf Ibn Abi Shaybah 16002","","","كتاب الحج"
"16003","(۱۶۰۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، أَنَّ إبْرَاہِیمَ وَإِسْمَاعِیلَ حَجَّا وَہُمَا مَاشِیَانِ۔","","Musannaf Ibn Abi Shaybah 16003","","","كتاب الحج"
"16004","(۱۶۰۰۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : حجَّ الْحُسَیْنُ بْنُ عَلِیٍّ مَاشِیًا وَنَجَائِبُہُ تُقَادُ إلَی جَنْبِہِ ، قَالَ حَفْصٌ : أَحْسَبُہُ ، قَالَ : عَشْرًا۔","","Musannaf Ibn Abi Shaybah 16004","","","كتاب الحج"
"16005","(۱۶۰۰۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، قَالَ : رَأَیْتُ نَافِعَ بْنَ جُبَیْرٍ یَقْضِی مَنَاسِکَہُ عَلَی رِجْلَیْہِ وَیُعَرِّفُ عَلَی رِجْلَیْہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 16005","","","كتاب الحج"
"16006","(۱۶۰۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : حجَجْت مَعَ سَعِیدِ بْنِ جُبَیْرٍ مَاشِیًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 16006","","","كتاب الحج"
"16007","(۱۶۰۰۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَأَلْتُ نَافِعًا حَجَّ ابْنُ عُمَرَ مَاشِیًا ؟ قَالَ : لاَ۔",": Sahih","Musannaf Ibn Abi Shaybah 16007","","","كتاب الحج"
"16008","(۱۶۰۰۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کُلُّ مَا أَصَابَ الْمُحْرِمُ الصَّیْدَ نَاسِیًا حُکِمَ عَلَیْہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 16008","","","كتاب الحج"
"16009","(۱۶۰۰۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کُلَّمَا أَصَابَ الْمُحْرِمُ الصَّیْدَ حُکِمَ عَلَیْہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 16009","","","كتاب الحج"
"16010","(۱۶۰۱۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : سَأَلَہُ رَجُلٌ ، فَقَالَ : إنِّی أَصَبْتُ صَیْدًا وَأَنَا مُحْرِمٌ ، فَقَالَ لَہُ شُرَیْحٌ : ہَلْ کُنْت أَصَبْت قَبْلَہُ ؟ قَالَ : لاَ قَالَ : لَوْ کُنْت فَعَلْت وَکَّلْتُک إلَی اللہِ تَعَالَی حَتَّی یَنْتَقِمَ مِنْک {وَاللَّہُ عَزِیزٌ ذُو انْتِقَامٍ} قَالَ دَاوُد : فَذَکَرْت ذَلِکَ لِسَعِیدِ بْنِ جُبَیْرٍ ، فَقَالَ : أَفَیَخْلُعُ یَحْکُمُ عَلَیْہِ ؟۔","","Musannaf Ibn Abi Shaybah 16010","","","كتاب الحج"
"16011","(۱۶۰۱۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا أَصَابَ مَرَّۃً حُکِمَ عَلَیْہِ ، ثُمَّ إِنْ عَادَ لَمْ یُحْکَمْ عَلَیْہِ ، ثُمَّ قَرَأَ : (وَمَنْ عَادَ فَیَنْتَقِمُ اللَّہُ مِنْہُ)۔",": Sahih","Musannaf Ibn Abi Shaybah 16011","","","كتاب الحج"
"16012","(۱۶۰۱۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یَحْیَی بْنِ أَبِی إِسْحَاقَ ، عَنْ أَنَسٍ ، أَنَّہُ سَمِعَ النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُلَبِّی ، یَقُولُ : لَبَّیْکَ بِعُمْرَۃٍ وَحَجٍّ۔",": Sahih","Musannaf Ibn Abi Shaybah 16012","","","كتاب الحج"
"16013","(۱۶۰۱۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ بکیر بْنِ عَطَائٍ ، عَنْ حُرَیْثِ بْنِ سُلَیْمٍ ، قَالَ : سَمِعْتُ عَلِیًّا لَبَّی بِالْحَجِّ وَالْعُمْرَۃِ ، فَبَدأَ بِالْعُمْرَۃِ ، فَقَالَ لَہُ عُثْمَانَ : إنَّک مِمَّنْ یُنْظَرُ إلَیْہِ ، فَقَالَ لَہُ عَلِی: وَأَنتَ مِمَّن یُنْظَر إِلِیہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 16013","","","كتاب الحج"
"16014","(۱۶۰۱۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ حُمَیْدٍ، عَنْ أَنَسٍ، أَنَّہُ سَمِعَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: لَبَّیْکَ بِعُمْرَۃٍ وَحَجَّۃٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 16014","","","كتاب الحج"
"16015","(۱۶۰۱۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ وَمُجَاہِدًا ، عَنِ الرَّجُلِ یُلَبِّی بِالْحَجِّ وَالْعُمْرَۃِ ، فَقَالَ : مُجَاہِدٌ : یَبْدَأُ بِالْعُمْرَۃِ ، وَقَالَ : إبْرَاہِیمُ : تُجْزِئُہُ النِّیَّۃُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 16015","","","كتاب الحج"
"16016","(۱۶۰۱۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا اسْتَعَطَ الرَّجُلُ بِالْبَنَفْسَجِ فَعَلَیْہِ الْفِدْیَۃُ۔","","Musannaf Ibn Abi Shaybah 16016","","","كتاب الحج"
"16017","(۱۶۰۱۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَ ، فَقَالَ : إذَا لَمْ یَجِدِ الْمُحْرِمُ إزَارًا فَلْیَلْبَسْ سَرَاوِیلَ ، وَإِذَا لَمْ یَجِدْ نَعْلَیْنِ فَلْیَلْبَسِ الْخُفَّیْنِ۔\n(مسلم ۸۳۵۔ بخاری ۱۷۴۰)",": Sahih","Musannaf Ibn Abi Shaybah 16017","","","كتاب الحج"
"16018","(۱۶۰۱۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ ، أَوْ نَحْوِہِ۔ (مسلم ۸۳۵۔ احمد ۱/۲۲۱)",": Sahih","Musannaf Ibn Abi Shaybah 16018","","","كتاب الحج"
"16019","(۱۶۰۱۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : سَمِعْتُ النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُہُ۔ (مسلم ۸۲۵۔ ترمذی ۸۳۴)",": Sahih","Musannaf Ibn Abi Shaybah 16019","","","كتاب الحج"
"16020","(۱۶۰۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ رَجُلاً سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَا یَلْبَسُ الْمُحْرِمُ مِنَ الثِّیَابِ ، أَوْ مَا یَتْرُکُ الْمُحْرِمُ ؟ فَقَالَ : لاَ یَلْبَسُ الْخُفَّیْنِ ، وَلاَ السَّرَاوِیلَ ، إِلاَّ أَنْ لاَ یَجِدَ نَعْلَیْنِ ، فَمَنْ لَمْ یَجِدْ نَعْلَیْنِ فَلْیَلْبَسِ الْخُفَّیْنِ وَلْیَقْطَعْہُمَا أَسْفَلَ مِنَ الْکَعْبَیْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 16020","","","كتاب الحج"
"16021","(۱۶۰۲۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ لَمْ یَجِدْ نَعْلَیْنِ فَلْیَلْبَسِ الْخُفَّیْنِ ، وَمَنْ لَمْ یَجِدْ إزَارًا فَلْیَلْبَسِ السَّرَاوِیلَ۔\n(مسلم ۸۳۶۔ احمد ۳/۳۲۳)",": Sahih","Musannaf Ibn Abi Shaybah 16021","","","كتاب الحج"
"16022","(۱۶۰۲۲) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنْ یُونُسَ بْنِ سَیْفٍ ، عَنْ عُمَیْرِ بْنِ الأَسْوَدِ ، قَالَ : سَأَلْتُ عُمَرَ ، قُلْتُ : مَا تَقُولُ فِی الْخُفَّیْنِ لِلْمُحْرِمِ ، فَقَالَ : ہُمَا نَعْلاَ مَنْ لاَ نَعْلَ لَہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 16022","","","كتاب الحج"
"16023","(۱۶۰۲۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَلِیٍّ فِی الْمُحْرِمِ إذَا لَمْ یَجِدْ نَعْلَیْنِ لَبِسَ خُفَّیْنِ ، وَإِذَا لَمْ یَجِدْ إزَارًا لَبِسَ سَرَاوِیلَ۔","","Musannaf Ibn Abi Shaybah 16023","","","كتاب الحج"
"16024","(۱۶۰۲۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا لَمْ یَجِدِ الْمُحْرِمُ إزَارًا فَلْیَلْبَسْ سَرَاوِیلَ وَإِذَا لَمْ یَجِدْ نَعْلَیْنِ فَلْیَلْبَسِ الْخُفَّیْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 16024","","","كتاب الحج"
"16025","(۱۶۰۲۵) حَدَّثَنَا حدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَید ، عَنْ بَکر قَالَ : إذَا لَمْ یَجِدَ الْمُحْرِمُ إزَارًا فَلْیَلْبَسْ سَرَاوِیلَ۔","","Musannaf Ibn Abi Shaybah 16025","","","كتاب الحج"
"16026","(۱۶۰۲۶) حَدَّثَنَا أَبُو بَکْرٍ ، قَالَ ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَلْبَسَ الْمُحْرِمُ سَرَاوِیلَ إذَا لَمْ یَجِدْ إزَارًا ، وَلاَ بَأْسَ أَنْ یَلْبَسَ خُفَّیْنِ إذَا لَمْ یَجِدْ نَعْلَیْنِ۔","","Musannaf Ibn Abi Shaybah 16026","","","كتاب الحج"
"16027","(۱۶۰۲۷) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنِّی لَوِ اسْتَقْبَلْت مِنْ أَمْرِی مَا اسْتَدْبَرْت ، لَمْ أَسُقِ الْہَدْیَ وَجَعَلْتہَا عُمْرَۃً ، فَمَنْ کَانَ مِنْکُمْ لَیْسَ مَعَہُ ہَدْیٌ فَلْیُحِلَّ ، وَلْیَجْعَلْہَا عُمْرَۃً فَقَامَ سُرَاقَۃُ ، فَقَالَ : یَا رَسُولَ اللہِ ألِعَامِنَا ہَذَا ، أَوْ لأَبَدٍ ؟ فَشَبَّکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَصَابِعَہُ وَاحِدَۃً فِی الأُخْرَی ، وَقَالَ : دَخَلَتِ الْعُمْرَۃُ فِی الْحَجِّ لاَ بَلْ لأَبَدٍ أَبَدٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 16027","","","كتاب الحج"
"16028","(۱۶۰۲۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : جَائَ النَّاسُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حُجَّاجًا فَأَمَرَہُمْ فَجَعَلُوہَا عُمْرَۃً ثُمَّ قَالَ : لَوْ أَنِّی اسْتَقْبَلْتُ مِنْ أَمْرِی مَا اسْتَدْبَرْتُ مَا فَعَلْتُ ذلک وَلَکِنْ دَخَلَتِ الْعُمْرَۃُ فِی الْحَجِّ إِلَی یَوْمِ الْقِیَامَۃِ ، ثُمَّ شَبَّکَ بَیْنَ أَصَابِعَہُ۔ (ابوداؤد ۱۷۸۹۔ ترمذی ۹۳۲)",": Da'if","Musannaf Ibn Abi Shaybah 16028","","","كتاب الحج"
"16029","(۱۶۰۲۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُمَیْدٌ ، عَنْ بَکْرٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إِنَّمَا أَہَلَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْحَجِّ وَأَہْلَلْنَا مَعَہُ ، فَلَمَّا قَدِمناَ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَنْ لَمْ یَکُنْ مَعَہ ہَدْیٌ فَلْیُحِلَّ وَکَانَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ہَدْیٌ فَلَمْ یَحِلَّ۔ (بخاری ۴۳۵۴۔ مسلم ۱۸۵)",": Sahih","Musannaf Ibn Abi Shaybah 16029","","","كتاب الحج"
"16030","(۱۶۰۳۰) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ، قَالَتْ : خَرَجْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُہِلِّینَ بِالْحَجِّ فِی أَشْہُرِ الْحَجِّ وَأَیَّامِ الْحَجِّ ، حَتَّی قَدِمْنَا سَرِفَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَصْحَابِہِ : مَنْ لَمْ یَکُنْ مِنْکُمْ سَاقَ ہَدْیًا فَأَحَبَّ أَنْ یُہِلَّ مِنْ حَجِّہِ بِعُمْرَۃٍ فَلْیَفْعَلْ۔",": Sahih","Musannaf Ibn Abi Shaybah 16030","","","كتاب الحج"
"16031","(۱۶۰۳۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ : ہَذِہِ عُمْرَۃٌ اسْتَمْتَعْنَا بِہَا ، فَمَنْ لَمْ یَکُنْ مَعَہُ ہَدْیٌ فَلْیَحِلَّ الْحِلَّ کُلَّہُ ، فَقَدْ دَخَلَتِ الْعُمْرَۃُ فِی الْحَجِّ إلَی یَوْمِ الْقِیَامَۃِ۔ (مسلم ۲۰۳۔ ابوداؤد ۱۷۸۷)",": Sahih","Musannaf Ibn Abi Shaybah 16031","","","كتاب الحج"
"16032","(۱۶۰۳۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ ، عَنْ أَبِی ذَرٍّ ، قَالَ : کَانَتِ الْمُتْعَۃُ فِی الْحَجِّ لأَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَاصَّۃً۔",": Sahih","Musannaf Ibn Abi Shaybah 16032","","","كتاب الحج"
