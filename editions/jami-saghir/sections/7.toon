hadiths[153]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3205","«خاب عبد وخسر لم يجعل الله تعالى في قلبه رحمة للبشر»","حسن","Sahih al-Jami al-Saghir 3205","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3206","«خالد بن الوليد سيف من سيوف الله»","صحيح","Sahih al-Jami al-Saghir 3206","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3207","«خالد بن الوليد سيف من سيوف الله سله الله على المشركين»","صحيح","Sahih al-Jami al-Saghir 3207","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3208","«خالد سيف من سيوف الله ونعم فتى العشيرة»","صحيح","Sahih al-Jami al-Saghir 3208","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3209","«خالفوا المشركين أحفوا الشوارب وأوفروا اللحى»","صحيح","Sahih al-Jami al-Saghir 3209","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3210","«خالفوا اليهود فإنهم لا يصلون في نعالهم ولا خفافهم»","صحيح","Sahih al-Jami al-Saghir 3210","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3211","""خبرني ربي أني سأرى علامة في أمتي فإذا رأيتها أكثرت من قول: سبحان الله وبحمده استغفر الله وأتوب إليه فقد رأيتها {إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ} - فتح مكة - {وَرَأَيْتَ النَّاسَ يَدْخُلُونَ فِي دِينِ اللَّهِ أَفْوَاجاً فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ إِنَّهُ كَانَ تَوَّاباً} ""","صحيح","Sahih al-Jami al-Saghir 3211","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3212","«خذ عليك ثوبك ولا تمشوا عراة»","صحيح","Sahih al-Jami al-Saghir 3212","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3213","«خذوا القرآن من أربعة من ابن مسعود وأبي بن كعب ومعاذ بن جبل وسالم مولى أبي حذيفة»","صحيح","Sahih al-Jami al-Saghir 3213","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3214","«خذوا جنتكم من النار قولوا: سبحان الله والحمد لله ولا إله إلا الله والله أكبر فإنهن يأتين يوم القيامة مقدمات ومعقبات ومجنبات وهن الباقيات الصالحات»","صحيح","Sahih al-Jami al-Saghir 3214","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3215","«خذوا عني خذوا عني قد جعل الله لهن سبيلا البكر بالبكر جلد مائة ونفي سنة والثيب بالثيب جلد مائة والرجم»","صحيح","Sahih al-Jami al-Saghir 3215","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3216","«خذوا مقاعدكم فإن الناس قد صلوا وأخذوا مضاجعهم وإنكم لن تزالوا في صلاة ما انتظرتم الصلاة ولولا ضعف الضعيف وسقم السقيم وحاجة ذوي الحاجة لأخرت هذه الصلاة إلى شطر الليل»","صحيح","Sahih al-Jami al-Saghir 3216","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3217","«خذوا من العبادة ما تطيقون فإن الله لا يسأم حتى تسأموا»","صحيح","Sahih al-Jami al-Saghir 3217","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3218","«خذوا من العمل ما تطيقون فإن الله لا يمل حتى تملوا»","صحيح","Sahih al-Jami al-Saghir 3218","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3219","«خذوا يا بني أرفدة حتى تعلم اليهود والنصارى أن في ديننا فسحة»","صحيح","Sahih al-Jami al-Saghir 3219","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3220","«خذي فرصة من مسك فتطهري بها»","صحيح","Sahih al-Jami al-Saghir 3220","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3221","«خذي من ماله بالمعروف ما يكفيك ويكفي بنيك»","صحيح","Sahih al-Jami al-Saghir 3221","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3222","«خرج رجل ممن كان قبلكم في حلة له يختال فيها فأمر الله الأرض فأخذته فهو يتجلجل فيها إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 3222","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3223","«خرجت من لدن آدم من نكاح غير سفاح»","حسن","Sahih al-Jami al-Saghir 3223","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3224","«خرجت من نكاح غير سفاح»","حسن","Sahih al-Jami al-Saghir 3224","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3225","«خرجت من نكاح ولم أخرج من سفاح من لدن آدم إلى أن ولدني أبي وأمي لم يصبني من سفاح الجاهلية شيء»","حسن","Sahih al-Jami al-Saghir 3225","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3226","«خرجت وأنا أريد أن أخبركم بليلة القدر فتلاحى رجلان فاختلجت مني فاطلبوها في العشر الأواخر: في سابعة تبقى أو تاسعة تبقى أو خامسة تبقى»","صحيح","Sahih al-Jami al-Saghir 3226","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3227","«خروج الآيات بعضها على أثر بعض يتتابعن كما تتابع الخرز في النظام»","صحيح","Sahih al-Jami al-Saghir 3227","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3228","«خصاء أمتي الصيام والقيام»","صحيح","Sahih al-Jami al-Saghir 3228","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3229","«خصلتان لا يجتمعان في منافق: حسن سمت ولا فقه في الدين»","صحيح","Sahih al-Jami al-Saghir 3229","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3230","«خصلتان لا يحافظ عليهما عبد مسلم إلا دخل الجنة ألا وهما يسير ومن يعمل بهما قليل يسبح الله في دبر كل صلاة عشرا ويحمده عشرا ويكبره عشرا فذلك خمسون ومائة باللسان وألف وخمسمائة في الميزان ويكبر أربعا وثلاثين إذا أخذ مضجعه ويحمده ثلاثا وثلاثين ويسبح ثلاثا وثلاثين فتلك مائة باللسان وألف في الميزان فأيكم يعمل في اليوم والليلة ألفين وخمسمائة سيئة»","صحيح","Sahih al-Jami al-Saghir 3230","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3231","«خفف على داود القرآن فكان يأمر بدوابه فتسرج فيقرأ القرآن من قبل أن تسرج دوابه ولا يأكل إلا من عمل يده»","صحيح","Sahih al-Jami al-Saghir 3231","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3232","«خلفت فيكم شيئين لن تضلوا بعدهما: كتاب الله وسنتي ولن يتفرقا حتى يردا علي الحوض»","صحيح","Sahih al-Jami al-Saghir 3232","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3233","«خلق الله آدم على صورته وطوله ستون ذراعا ثم قال: اذهب فسلم على أولئك النفر وهم نفر من الملائكة جلوس فاستمع ما يحيونك فإنها تحيتك وتحية ذريتك فذهب فقال: السلام عليكم فقالوا: السلام عليك ورحمة الله فزادوه ورحمة الله فكل من يدخل الجنة على صورة آدم في طوله ستون ذراعا فلم تزل الخلق تنقص بعده حتى الآن»","صحيح","Sahih al-Jami al-Saghir 3233","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3234","«خلق الله آدم فضرب كتفه اليمنى فأخرج ذرية بيضاء كأنهم اللبن ثم ضرب كتفه اليسرى فخرج ذرية سوداء كأنهم الحمم قال: هؤلاء في الجنة ولا أبالي وهؤلاء في النار ولا أبالي»","صحيح","Sahih al-Jami al-Saghir 3234","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3235","«خلق الله التربة يوم السبت وخلق فيها الجبال يوم الأحد وخلق الشجر يوم الاثنين وخلق المكروه يوم الثلاثاء وخلق النور يوم الأربعاء وبث فيها الدواب يوم الخميس وخلق آدم بعد العصر من يوم الجمعة في آخر الخلق في آخر ساعة من ساعات الجمعة فيما بين العصر إلى الليل»","صحيح","Sahih al-Jami al-Saghir 3235","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3236","«خلق الله مائة رحمة فوضع رحمة واحدة بين خلقه يتراحمون بها وخبأ عنده مائة إلا واحدة»","صحيح","Sahih al-Jami al-Saghir 3236","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3237","«خلق الله يحيى بن زكريا في بطن أمه مؤمنا وخلق فرعون في بطن أمه كافرا»","حسن","Sahih al-Jami al-Saghir 3237","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3238","«خلقت الملائكة من نور وخلق الجان من مارج من نار وخلق آدم مما وصف لكم»","صحيح","Sahih al-Jami al-Saghir 3238","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3239","«خلل أصابع يديك ورجليك»","صحيح","Sahih al-Jami al-Saghir 3239","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3240","«خمس بخمس ما نقض قوم العهد إلا سلط عليهم عدوهم وما حكموا بغير ما أنزل الله إلا فشا فيهم الفقر ولا ظهرت فيهم الفاحشة إلا فشا فيهم الموت ولا طففوا المكيال إلا منعوا النبات وأخذوا بالسنين ولا منعوا الزكاة إلا حبس عنهم القطر»","حسن","Sahih al-Jami al-Saghir 3240","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3241","«خمس تجب للمسلم على أخيه: رد السلام وتشميت العاطس وإجابة الدعوة وعيادة المريض واتباع الجنازة»","صحيح","Sahih al-Jami al-Saghir 3241","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3242","«خمس صلوات افترضهن الله عز وجل من أحسن وضوءهن وصلاهن لوقتهن وأتم ركوعهن وخشوعهن كان له على الله عهد أن يغفر له ومن لم يفعل فليس له على الله عهد إن شاء غفر له وإن شاء عذبه»","صحيح","Sahih al-Jami al-Saghir 3242","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3243","«خمس صلوات كتبهن الله على العباد فمن جاء بهن لم يضيع منهن شيئا استخفافا بحقهن كان له عند الله عهد أن يدخله الجنة ومن لم يأت بهن فليس له عند الله عهد إن شاء عذبه وإن شاء أدخله الجنة»","صحيح","Sahih al-Jami al-Saghir 3243","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3244","«خمس فواسق تقتلن في الحل والحرم: الحية والغراب الأبقع والفأرة والكلب العقور والحديا»","صحيح","Sahih al-Jami al-Saghir 3244","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3245","«خمس قتلهن حلال في الحرم: الحية والعقرب والحدأة والفأرة والكلب العقور»","صحيح","Sahih al-Jami al-Saghir 3245","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3246","«خمس كلهن فاسقة يقتلهن المحرم ويقتلن في الحرم: الفأرة والعقرب والحية والكلب العقور والغراب»","صحيح","Sahih al-Jami al-Saghir 3246","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3247","«خمس ليس لهن كفارة: الشرك بالله وقتل النفس بغير حق وبهت المؤمن والفرار من الزحف ويمين صابرة يقتطع بها مالا بغير حق»","حسن","Sahih al-Jami al-Saghir 3247","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3248","«خمس من الدواب كلهن فاسق يقتلن في الحرم: الغراب والحدأة والعقرب والفأرة والكلب العقور»","صحيح","Sahih al-Jami al-Saghir 3248","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3249","«خمس من الدواب ليس على المحرم في قتلهن جناح: الغراب والحدأة والفأرة والعقرب والكلب العقور»","صحيح","Sahih al-Jami al-Saghir 3249","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3250","«خمس من الفطرة: الختان والاستحداد وقص الشارب وتقليم الأظفار ونتف الإبط»","صحيح","Sahih al-Jami al-Saghir 3250","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3251","«خمس من حق المسلم على المسلم: رد التحية وإجابة الدعوة وشهود الجنازة وعيادة المريض وتشميت العاطس إذا حمد الله»","صحيح","Sahih al-Jami al-Saghir 3251","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3252","«خمس من عملهن في يوم كتبه الله من أهل الجنة: من صام يوم الجمعة وراح إلى الجمعة وعاد مريضا وشهد جنازة وأعتق رقبة»","صحيح","Sahih al-Jami al-Saghir 3252","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3253","«خمس من فعل واحدة منهن كان ضامنا على الله: من عاد مريضا أو خرج غازيا أو دخل على إمامه يريد تعزيره وتوقيره أو قعد في بيته فسلم الناس منه وسلم من الناس»","صحيح","Sahih al-Jami al-Saghir 3253","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3254","«خمس من قبض في شيء منهن فهو شهيد: المقتول في سبيل الله شهيد والغريق في سبيل الله شهيد والمبطون في سبيل الله شهيد والمطعون في سبيل الله شهيد والنفساء في سبيل الله شهيدة»","صحيح","Sahih al-Jami al-Saghir 3254","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3255","«خمس لا يعلمهن إلا الله: {إِنَّ اللَّهَ عِنْدَهُ عِلْمُ السَّاعَةِ وَيُنَزِّلُ الْغَيْثَ وَيَعْلَمُ مَا فِي الْأَرْحَامِ وَمَا تَدْرِي نَفْسٌ مَاذَا تَكْسِبُ غَداً وَمَا تَدْرِي نَفْسٌ بِأَيِّ أَرْضٍ تَمُوتُ إِنَّ اللَّهَ عَلِيمٌ خَبِيرٌ}»","صحيح","Sahih al-Jami al-Saghir 3255","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3256","«خمروا الآنية وأوكئوا الأسقية وأجيفوا الأبواب واكفتوا صبيانكم عند المساء فإن للجن انتشارا وخطفة وأطفئوا المصابيح عند الرقاد فإن الفويسقة ربما اجترت الفتيلة فأحرقت أهل البيت»","صحيح","Sahih al-Jami al-Saghir 3256","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3257","«خلافة النبوة ثلاثون سنة ثم يؤتي الله الملك من يشاء»","صحيح","Sahih al-Jami al-Saghir 3257","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3258","«خيار أئمتكم الذين تحبونهم ويحبونكم وتصلون عليهم ويصلون عليكم وشرار أئمتكم الذين تبغضونهم ويبغضونكم وتلعنونهم ويلعنونكم»","صحيح","Sahih al-Jami al-Saghir 3258","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3259","«خياركم أحاسنكم أخلاقا»","صحيح","Sahih al-Jami al-Saghir 3259","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3260","«خياركم أحاسنكم أخلاقا الموطئون أكنافا وشراركم الثرثارون المتفيهقون المتشدقون»","صحيح","Sahih al-Jami al-Saghir 3260","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3261","«خياركم أحسنكم قضاء للدين»","صحيح","Sahih al-Jami al-Saghir 3261","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3262","«خياركم أطولكم أعمارا وأحسنكم أخلاقا»","صحيح","Sahih al-Jami al-Saghir 3262","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3263","«خياركم أطولكم أعمارا وأحسنكم أعمالا»","صحيح","Sahih al-Jami al-Saghir 3263","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3264","«خياركم ألينكم مناكب في الصلاة»","حسن","Sahih al-Jami al-Saghir 3264","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
"3265","«خياركم خياركم لنسائهم»","صحيح","Sahih al-Jami al-Saghir 3265","","","الأحاديث المبدوءة بحرف الخاء Hadith Beginning with the Letter Kha (خ)"
