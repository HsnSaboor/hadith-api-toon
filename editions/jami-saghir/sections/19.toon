hadiths[37]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"4151","«غدوة في سبيل الله أو روحة خير من الدنيا وما فيها»","صحيح","Sahih al-Jami al-Saghir 4151","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4152","«غدوة في سبيل الله أو روحة خير مما طلعت عليه الشمس وغربت»","صحيح","Sahih al-Jami al-Saghir 4152","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4153","«غزا نبي من الأنبياء فقال لقومه: لا يتبعني منكم رجل ملك بضع امرأة وهو يريد أن يبني بها ولما يبن بها ولا أحد بنى بيوتا ولم يرفع سقوفها ولا أحد اشترى غنما أو خلفات وهو ينظر ولادها فغزا فدنا من القرية صلاة العصر أو قريبا من ذلك فقال للشمس: إنك مأمورة وأنا مأمور اللهم احبسها علينا فحبست حتى فتح الله عليه فجمع الغنائم فجاءت النار لتأكلها فلم تطعمها فقال: إن فيكم غلولا فليبايعني من كل قبيلة رجل فلزقت يد رجل بيده فقال: فيكم الغلول فلتبايعني قبيلتك فلزقت يد رجلين أو ثلاثة بيده فقال: فيكم الغلول: فجاءوا برأس مثل رأس بقرة من الذهب فوضعوها فجاءت النار فأكلتها ثم أحل الله لنا الغنائم رأى ضعفنا وعجزنا فأحلها لنا»","صحيح","Sahih al-Jami al-Saghir 4153","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4154","«غزوة في البحر خير من عشر غزوات في البر ومن أجاز البحر فكأنما أجاز الأودية كلها والمائد فيه كالمتشحط في دمه»","صحيح","Sahih al-Jami al-Saghir 4154","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4155","«غسل يوم الجمعة واجب على كل محتلم»","صحيح","Sahih al-Jami al-Saghir 4155","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4156","«غشيتكم الفتن كقطع الليل المظلم أنجى الناس فيها رجل صاحب شاهقة يأكل من رسل غنمه أو رجل آخذ بعنان فرسه من وراء الدروب يأكل من سيفه»","صحيح","Sahih al-Jami al-Saghir 4156","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4157","«غط فخذك فإن الفخذ عورة»","صحيح","Sahih al-Jami al-Saghir 4157","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4158","«غط فخذك فإن فخذ الرجل من عورته»","صحيح","Sahih al-Jami al-Saghir 4158","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4159","«غطوا الإناء وأوكئوا السقاء فإن في السنة ليلة ينزل فيها وباء لا يمر بإناء لم يغط أو سقاء لم يوكأ إلا وقع فيه من ذلك الوباء»","صحيح","Sahih al-Jami al-Saghir 4159","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4160","«غطوا الإناء وأوكئوا السقاء وأغلقوا الأبواب وأطفئوا السراج فإن الشيطان لا يحل سقاء ولا يفتح بابا ولا يكشف إناء فإن لم يجد أحدكم إلا أن يعرض على إنائه عودا ويذكر اسم الله فليفعل فإن الفويسقة تضرم على أهل البيت بيتهم»","صحيح","Sahih al-Jami al-Saghir 4160","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4161","«غفار غفر الله لها وأسلم سالمها الله وعصية عصت الله ورسوله»","صحيح","Sahih al-Jami al-Saghir 4161","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4162","«غفر الله لرجل ممن كان قبلكم كان سهلا إذا باع سهلا إذا اشترى سهلا إذا اقتضى»","صحيح","Sahih al-Jami al-Saghir 4162","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4163","«غفر لامرأة مومسة مرت بكلب على رأس ركي يلهث كاد يقتله العطش فنزعت خفها فأوثقته بخمارها فنزعت له من الماء فغفر لها بذلك»","صحيح","Sahih al-Jami al-Saghir 4163","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4164","«غلظ القلوب والجفاء في أهل المشرق والإيمان والسكينة في أهل الحجاز»","صحيح","Sahih al-Jami al-Saghir 4164","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4165","«غير الدجال أخوف على أمتي من الدجال الأئمة المضلون»","صحيح","Sahih al-Jami al-Saghir 4165","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4166","غير الدجال أخوفني عليكم إن يخرج وأنا فيكم فأنا حجيجه دونكم وإن يخرج ولست فيكم فامرؤ حجيج نفسه والله خليفتي على كل مسلم إنه شاب قطط إحدى عينيه كأنها عنبة طافية كأني أشبهه بعبد العزى بن قطن فمن أدركه منكم فليقرأ عليه فواتح سورة الكهف إنه خارج خلة بين الشام والعراق فعاث يمينا وعاث شمالا يا عباد الله فاثبتوا قالوا: يا رسول الله ما لبثه في الأرض؟ قال: أربعون يوما يوم كسنة ويوم كشهر ويوم كجمعة وسائر أيامه كأيامكم قالوا: يا رسول الله! فذلك اليوم كسنة أتكفينا فيه صلاة يوم؟ قال: لا اقدروا له قالوا: وما إسراعه في الأرض؟ قال: كالغيث استدبرته الريح فيأتي على القوم فيدعوهم فيؤمنون به ويستجيبون له فيأمر السماء فتمطر والأرض فتنبت فتروح عليهم سارحتهم أطول ما كانت درا وأشبعه ضروعا وأمده خواصر ثم يأتي القوم فيدعوهم فيردون عليه قوله فينصرف عنهم فيصبحون ممحلين ليس بأيديهم شيء من أموالهم ويمر بالخربة فيقول لها: أخرجي كنوزك فتتبعه كنوزها كيعاسيب النحل ثم يدعورجلا ممتلئا شبابا فيضربه بالسيف فيقطعه جزلتين رمية الغرض ثم يدعوه فيقبل ويتهلل وجهه ويضحك ; فبينما هوكذلك إذ بعث الله المسيح ابن مريم فينزل عند المنارة البيضاء شرقي دمشق بين مهرودتين واضعا كفيه على أجنحة ملكين إذ طأطأ رأسه قطر وإذا رفعه تحدر منه جمان كاللؤلؤ فلا يحل لكافر يجد ريح نفسه إلا مات ونفسه ينتهي حيث ينتهي طرفه فيطلبه حتى يدركه بباب لد فيقتله ثم يأتي عيسى قوم قد عصمهم الله منه فيمسح عن وجوههم ويحدثهم بدرجاتهم في الجنة. فبينما هم كذلك إذ أوحى الله إلى عيسى: إني أخرجت عبادا لا يدان لأحد بقتالهم فحرز عبادي إلى الطور ويبعث الله يأجوج ومأجوج وهم من كل حدب ينسلون فيمر أوائلهم على بحيرة طبرية فيشربون ما فيها ويمر آخرهم فيقولون: لقد كان بهذه مرة ماء! ثم يسيرون حتى ينتهوا إلى جبل الخمر وهو جبل بيت المقدس فيقولون لقد قتلنا من في الأرض هلم فلنقتل من في السماء فيرمون بنشابهم إلى السماء فيرد الله عليهم نشابهم مخضوبة دما; ويحصر نبي الله عيسى وأصحابه حتى يكون رأس الثور لأحدهم خيرا من مائة دينار لأحدكم اليوم فيرغب نبي الله عيسى وأصحابه فيرسل الله عليهم النغف في رقابهم فيصبحون فرسى كموت نفس واحدة. ثم يهبط نبي الله عيسى وأصحابه إلى الأرض فلا يجدون في الأرض موضع شبر إلا ملأه زهمهم ونتنهم فيرغب نبي الله عيسى وأصحابه إلى الله عز وجل فيرسل الله طيرا كأعناق البخت فتحملهم فتطرحهم حيث شاء الله ثم يرسل الله قطرا لا يكن منه بيت مدر ولا وبر فيغسل الأرض حتى يتركها كالزلفة ثم يقال للأرض: انبتي ثمرتك ودري بركتك فيومئذ تأكل العصابة من الرمانة ويستظلون بقحفها ويبارك في الرسل حتى أن اللقحة من الإبل لتكفي الفئام من الناس. واللقحة من البقر لتكفي القبيلة من الناس واللقحة من الغنم لتكفي الفخذ من الناس. فبينما هم كذلك إذ بعث الله ريحا طيبة فتأخذهم تحت آباطهم فتقبض روح كل مؤمن وكل مسلم ويبقى شرار الناس يتهارجون فيها تهارج الحمر فعليهم تقوم الساعة","صحيح","Sahih al-Jami al-Saghir 4166","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4167","«غيروا الشيب ولا تشبهوا باليهود»","صحيح","Sahih al-Jami al-Saghir 4167","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4168","«غيروا الشيب ولا تشبهوا باليهود والنصارى»","صحيح","Sahih al-Jami al-Saghir 4168","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4169","«غيروا الشيب ولا تقربوه السواد»","صحيح","Sahih al-Jami al-Saghir 4169","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4170","«غيروا رأسه بشيء واجتنبوا السواد»","صحيح","Sahih al-Jami al-Saghir 4170","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4171","«الغازي في سبيل الله عز وجل والحاج والمعتمر وفد الله دعاهم فأجابوه وسألوه فأعطاهم»","صحيح","Sahih al-Jami al-Saghir 4171","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4172","«الغريق شهيد والحريق شهيد، ... والمبطون شهيد ومن يقع عليه البيت فهو شهيد،....... ومن قتل دون نفسه فهو شهيد ... ...»","صحيح","Sahih al-Jami al-Saghir 4172","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4173","«الغريق في سبيل الله شهيد»","صحيح","Sahih al-Jami al-Saghir 4173","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4174","«الغزوغزوان فأما من غزا ابتغاء وجه الله تعالى وأطاع الإمام وأنفق الكريمة وياسر الشريك واجتنب الفساد في الأرض فإن نومه ونبهه أجر كله وأما من غزا فخرا ورياء وسمعة وعصى الإمام وأفسد في الأرض فإنه لن يرجع بالكفاف»","حسن","Sahih al-Jami al-Saghir 4174","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4175","«الغسل صاع والوضوء مد»","صحيح","Sahih al-Jami al-Saghir 4175","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4176","«الغسل من الغسل والوضوء من الحمل»","صحيح","Sahih al-Jami al-Saghir 4176","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4177","«الغسل يوم الجمعة واجب على كل محتلم والسواك ويمس من الطيب ما قدر عليه ولو من طيب المرأة»","صحيح","Sahih al-Jami al-Saghir 4177","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4178","«الغسل يوم الجمعة واجب على كل محتلم وأن يستن وأن يمس طيبا إن وجد»","صحيح","Sahih al-Jami al-Saghir 4178","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4179","«الغلة بالضمان»","حسن","Sahih al-Jami al-Saghir 4179","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4180","«الغنم بركة»","صحيح","Sahih al-Jami al-Saghir 4180","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4181","«الغنم بركة والإبل عز لأهلها والخيل معقود في نواصيها الخير إلى يوم القيامة،..... ... »","صحيح","Sahih al-Jami al-Saghir 4181","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4182","«الغنم من دواب الجنة فامسحوا رغامها وصلوا في مرابضها»","صحيح","Sahih al-Jami al-Saghir 4182","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4183","«الغلام الذي قتله الخضر طبع يوم طبع كافرا ولو عاش لأرهق أبويه طغيانا وكفرا»","صحيح","Sahih al-Jami al-Saghir 4183","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4184","«الغلام مرتهن بعقيقته تذبح عنه يوم السابع ويسمى ويحلق رأسه»","صحيح","Sahih al-Jami al-Saghir 4184","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4185","«الغلام مرتهن بعقيقته فأهريقوا عنه الدم وأميطوا عنه الأذى»","صحيح","Sahih al-Jami al-Saghir 4185","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4186","«الغيبة أن تذكر الرجل بما فيه من خلفه»","صحيح","Sahih al-Jami al-Saghir 4186","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
"4187","«الغيبة ذكرك أخاك بما يكره»","صحيح","Sahih al-Jami al-Saghir 4187","","","الأحاديث المبدوءة بحرف الغين Hadith Beginning with the Letter Ghayn (غ)"
