hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"1","1 - نِسْبَةُ  أَبِي بَكْرٍ الصِّدِّيقِ وَاسْمُهُ - رَضِيَ اللهُ عَنْهُ - أَبُو بَكْرٍ عَبْدُ اللهِ بْنُ عُثْمَانَ بْنِ عَامِرِ بْنِ عَمْرِو بْنِ كَعْبِ بْنِ سَعْدِ بْنِ تَيْمِ بْنِ مُرَّةَ  .  1  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ، قَالَ : ""  أَبُو بَكْرٍ الصِّدِّيقُ اسْمُهُ عَبْدُ اللهِ بْنُ عُثْمَانَ بْنِ عَامِرِ  بْنِ عَمْرِو بْنِ كَعْبِ بْنِ سَعْدِ بْنِ تَيْمِ بْنِ مُرَّةَ  ، شَهِدَ  بَدْرًا  مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأُمُّ أَبِي بَكْرٍ - رَضِيَ اللهُ عَنْهُ - : أُمُّ الْخَيْرِ سَلْمَى بِنْتُ صَخْرِ بْنِ عَامِرِ         [1/52]      بْنِ عَمْرِو بْنِ كَعْبِ بْنِ سَعْدِ بْنِ تَيْمِ بْنِ مُرَّةَ بْنِ كَعْبِ بْنِ لُؤَيِّ بْنِ غَالِبِ بْنِ فِهْرِ بْنِ مَالِكٍ  ،  وَأُمُّ أُمِّ الْخَيْرِ : دِلَافُ وَهِيَ أُمَيْمَةُ بِنْتُ عُبَيْدِ بْنِ النَّاقِدِ الْخُزَاعِيِّ  ،  وَجَدَّةُ أَبِي بَكْرٍ : أُمُّ أَبِي قُحَافَةَ أَمِينَةُ بِنْتُ عَبْدِ الْعُزَّى بْنِ حُرْثَانَ بْنِ عَوْفِ بْنِ عُبَيْدِ بْنِ عُوَيْجِ بْنِ عَدِيِّ بْنِ كَعْبٍ  "" .","","Al-Mu'jam al-Kabir 1","","","نسبة أبي بكر الصديق واسمه رضي الله عنه"
"2","2  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَدِينِيُّ الْبَغْدَادِيُّ  ، ثَنَا  دَاوُدُ بْنُ رُشَيْدٍ  ،  عَنِ  الْهَيْثَمِ بْنِ عَدِيٍّ  ، قَالَ : ""  أُمُّ أَبِي بَكْرٍ - رَضِيَ اللهُ عَنْهُ - يُقَالُ لَهَا : أُمُّ الْخَيْرِ بِنْتُ صَخْرِ بْنِ عَامِرٍ  ، وَهَلَكَ  أَبُو بَكْرٍ  فَوَرِثَهُ أَبَوَاهُ جَمِيعًا ، وَكَانَا قَدْ أَسْلَمَا ، وَمَاتَتْ  أُمُّ أَبِي بَكْرٍ  قَبْلَ أَبِيهِ "" .","","Al-Mu'jam al-Kabir 2","","","نسبة أبي بكر الصديق واسمه رضي الله عنه"
"3","3  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ مُحَمَّدِ بْنِ أَبِي بَكْرٍ الْمُقَدَّمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ شَبِيبٍ الْمَدَنِيُّ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ يَحْيَى بْنِ هَانِي الشَّجَرِيُّ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  خَازِمِ بْنِ الْحُسَيْنِ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  أَسْلَمَتْ  أُمُّ أَبِي بَكْرٍ  ،  وَأُمُّ عُثْمَانَ  ،  وَأُمُّ طَلْحَةَ  ،  وَأُمُّ الزُّبَيْرِ  ،  وَأُمُّ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  ،  وَأُمُّ عَمَّارِ بْنِ يَاسِرٍ  - رَضِيَ اللهُ عَنْهُمْ - وَيُقَالُ :  عَتِيقُ بْنُ عُثْمَانَ  ، وَإِنَّمَا سُمِّيَ  عَتِيقًا  لِحُسْنِ وَجْهِهِ  "" .","","Al-Mu'jam al-Kabir 3","","عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن عبد الله بن أبي بكر بن محمد  ابن حزم عن خازم بن الحسين الحميسي عن يحيى بن محمد بن عباد الشجري عن إبراهيم بن يحيى الشجري عن عبد الله بن شبيب الربعي عن محمد بن أحمد بن محمد المقدمي عن الطبراني","نسبة أبي بكر الصديق واسمه رضي الله عنه"
"4","4  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ  ، ثَنَا  هِشَامُ بْنُ خَالِدٍ ،  ثَنَا  ضَمْرَةُ بْنُ رَبِيعَةَ ،  عَنِ  اللَّيْثِ بْنِ سَعْدٍ ، قَالَ :  إِنَّمَا سُمِّيَ أَبُو بَكْرٍ - رَضِيَ اللهُ عَنْهُ -  عَتِيقًا  لَجَمَالِ وَجْهِهِ ، وَاسْمُهُ  عَبْدُ اللهِ بْنُ عُثْمَانَ  .","","Al-Mu'jam al-Kabir 4","","أبو  بكر الصديق عن الليث بن سعد عن ضمرة بن ربيعة الفلسطيني عن هشام بن خالد السلامي عن أحمد بن المعلى الأسدي عن الطبراني","نسبة أبي بكر الصديق واسمه رضي الله عنه"
"5","[1/53]      5  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ صَدَقَةَ ، قَالَ :  سَمِعْتُ  أَبَا حَفْصٍ عَمْرَو بْنَ عَلِيٍّ يَقُولُ :  كَانَ أَبُو بَكْرٍ - رَضِيَ اللهُ عَنْهُ - مَعْرُوقَ الْوَجْهِ ، وَإِنَّمَا سُمِّيَ  عَتِيقًا  لِعَتَاقَةِ وَجْهِهِ  ، وَكَانَ اسْمُهُ  عَبْدَ اللهِ بْنَ عُثْمَانَ  ،  وَقَدْ رُوِيَ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَمَّاهُ  عَتِيقًا  مِنَ النَّارِ "" .","","Al-Mu'jam al-Kabir 5","","أبو  بكر الصديق عن الفلاس عن أحمد بن محمد بن عبد الله البغدادي عن الطبراني","نسبة أبي بكر الصديق واسمه رضي الله عنه"
"6","6  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  قَيْسُ بْنُ أَبِي قَيْسٍ الْبُخَارِيُّ ،  ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ،  ثَنَا  ، ابْنُ لَهِيعَةَ ،  عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَأَلْتُ  عَائِشَةَ - رَضِيَ اللهُ عَنْهَا - عَنِ اسْمِ أَبِي بَكْرٍ ، فَقَالَتْ : ""  عَبْدُ اللهِ  "" ، فَقُلْتُ : إِنَّهُمْ يَقُولُونَ :  عَتِيقٌ  ، فَقَالَتْ :  إِنَّ  أَبَا قُحَافَةَ  كَانَ لَهُ ثَلَاثَةٌ ، فَسَمَّى وَاحِدًا  عَتِيقًا  ،  وَمُعَيْتِقًا  ،  وَمُعْتَقًا  "" .","","Al-Mu'jam al-Kabir 6","","أبو  بكر الصديق عن عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن عمارة بن غزية عن عبد الله بن لهيعة عن قتيبة بن سعيد عن قيس بن مسلم بن منصور البخاري عن يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","نسبة أبي بكر الصديق واسمه رضي الله عنه"
"7","7  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  حَامِدُ بْنُ يَحْيَى الْبَلْخِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ اسْمُ  أَبِي بَكْرٍ عَبْدَ اللهِ بْنَ عُثْمَانَ  فَسَمَّاهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَتِيقًا  مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 7","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن زياد بن سعد الخراساني عن سفيان بن عيينة عن حامد بن يحيى البلخي عن الحسين بن إسحاق التستري عن الطبراني","نسبة أبي بكر الصديق واسمه رضي الله عنه"
"8","8  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ الْمِصْرِيُّ  ،  ثَنَا  حَبِيبُ بْنُ رُزَيْقٍ  ،  ثَنَا  عَبْدُ اللهِ بْنُ عَامِرٍ الْأَسْلَمِيُّ  ،  عَنْ  عَمْرِو بْنِ سُلَيْمٍ  ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ  ، يَقُولُ : ""  كَانَ اسْمُ  أَبِي بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - :  عَبْدَ اللهِ بْنَ عُثْمَانَ  "" .","","Al-Mu'jam al-Kabir 8","","","نسبة أبي بكر الصديق واسمه رضي الله عنه"
"9","9  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ الْعُمَرِيُّ الْقَاضِي  ، ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي         [1/54]      أُوَيْسٍ ،  حَدَّثَنِي  إِسْحَاقُ بْنُ يَحْيَى بْنِ طَلْحَةَ ،  عَنْ  عَمِّهِ إِسْحَاقَ بْنِ طَلْحَةَ ، قَالَ :  دَخَلْتُ عَلَى عَائِشَةَ أُمِّ الْمُؤْمِنِينَ -رَضِيَ اللهُ عَنْهَا -  فَقَالَتْ  : إِنَّ  أَبَا بَكْرٍ  دَخَلَ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لَهُ :  أَنْتَ عَتِيقٌ مِنَ النَّارِ ، فَمِنْ يَوْمِئِذٍ سُمِّيَ  عَتِيقًا  .","","Al-Mu'jam al-Kabir 9","","عائشة بنت أبي بكر الصديق عن إسحاق بن طلحة القرشي التيمي عن إسحاق بن يحيى بن طلحة التيمي عن إسماعيل بن أبي أويس عن عبيد الله بن محمد بن عبد العزيز العمري عن الطبراني","نسبة أبي بكر الصديق واسمه رضي الله عنه"
"10","10  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ، وَأَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ قَالَا :  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  صَالِحُ بْنُ مُوسَى الطَّلْحِيُّ ،  عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ ،  عَنْ  عَائِشَةَ بِنْتِ طَلْحَةَ ،  عَنْ  عَائِشَةَ أُمِّ الْمُؤْمِنِينَ  أَنَّ  أَبَا بَكْرٍ  - رَضِيَ اللهُ عَنْهُمَا - مَرَّ بِالنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  مَنْ أَرَادَ أَنْ يَنْظُرَ إِلَى عَتِيقٍ مِنَ النَّارِ فَلْيَنْظُرْ إِلَى هَذَا ،  قَالَتْ : وَاسْمُهُ الذِّي سَمَّاهُ أَهْلُهُ  عَبْدُ اللهِ بْنُ عُثْمَانَ  - رَضِيَ اللهُ عَنْهُ  - .","","Al-Mu'jam al-Kabir 10","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن معاوية بن إسحاق بن طلحة التيمي عن صالح بن موسى الطلحي عن سعيد بن منصور عن أبو زرعة الدمشقي عن الطبراني","نسبة أبي بكر الصديق واسمه رضي الله عنه"
"11","11  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ بْنِ مُحَمَّدِ بْنِ أَبِي بَكْرٍ  ،  عَنْ  مُوسَى بْنِ عُقْبَةَ  ، قَالَ : ""  لَا نَعْلَمُ أَرْبَعَةً أَدْرَكُوا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَبْنَاؤُهُمْ  ، إِلَّا هَؤُلَاءِ الْأَرْبَعَةَ :  أَبُو قُحَافَةَ  ،  وَأَبُو بَكْرٍ  ،  وَعَبْدُ الرَّحْمَنِ بْنُ أَبِي بَكْرٍ  ،  وَأَبُو عَتِيقِ بْنُ عَبْدِ الرَّحْمَنِ  ، وَاسْمُ  أَبِي عَتِيقٍ مُحَمَّدٌ  - رَضِيَ اللهُ عَنْهُمْ - "" .","","Al-Mu'jam al-Kabir 11","","","نسبة أبي بكر الصديق واسمه رضي الله عنه"
"12","12  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ بْنُ سَعْدٍ ،  عَنْ  خَالِدِ بْنِ يَزِيدَ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ، عَنْ رَبِيعَةَ بْنِ سَيْفٍ ،  أَنَّهُ حَدَّثَهُ  أَنَّهُ جَلَسَ مَعَ شُفَيٍّ الْأَصْبَحِيِّ  فَقَالَ  :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يَكُونُ بَعْدِي اثْنَا عَشَرَ  خَلِيفَةً  :         [1/55]      أَبُو بَكْرٍ الصِّدِّيقُ  لَا يَلْبَثُ بَعْدِي إِلَّا قَلِيلًا ، وَصَاحِبُ رَحَى دَارَةٍ يَعِيشُ حَمِيدًا ، وَيَمُوتُ شَهِيدًا "" . قِيلَ : مَنْ هُوَ يَا رَسُولَ اللهِ ؟ قَالَ : ""  عُمَرُ بْنُ الْخَطَّابِ  "" - رَضِيَ اللهُ عَنْهُ - ، ثُمَّ الْتَفَتَ إِلَى  عُثْمَانَ  فَقَالَ : "" وَأَنْتَ سَيَسْأَلُكَ النَّاسُ أَنْ  تَخْلَعَ  قَمِيصًا كَسَاكَ اللهُ - عَزَّ وَجَلَّ - وَالَّذِي نَفْسِي بِيَدِهِ ، لَئِنْ خَلَعْتَهُ ، لَا تَدْخُلُ الْجَنَّةَ حَتَّى يَلِجَ الْجَمَلُ فِي سَمِّ  الْخِيَاطِ  .","","Al-Mu'jam al-Kabir 12","","عبد الله بن عمرو بن العاص عن شفي بن ماتع الأصبحي عن ربيعة بن سيف المعافري عن سعيد بن أبي هلال الليثي عن خالد بن يزيد الجمحي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","نسبة أبي بكر الصديق واسمه رضي الله عنه"
"13","13  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمَهَّالِ ، (  ح  )  وَحَدَّثَنَا  الْمِقْدَامُ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سَعِيدِ بْنِ جُمْهَانَ ،  عَنْ  سَفِينَةَ ، مَوْلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْخِلَافَةُ ثَلَاثُونَ سَنَةً  ، ثُمَّ يَكُونُ مُلْكًا قَالَ : "" أَمْسَكَ ثِنْتَيْنِ  أَبُو بَكْرٍ  ، وَعَشْرًا  عُمَرُ  ، وَاثْنَتَيْ عَشْرَةَ  عُثْمَانُ  ، وَسِتًّا  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُمْ - "" .","","Al-Mu'jam al-Kabir 13","","سفينة مولى رسول الله عن سعيد بن جمهان الأسلمي عن حماد بن سلمة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","نسبة أبي بكر الصديق واسمه رضي الله عنه"
"14","14  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  إِسْحَاقُ بْنُ مَنْصُورٍ السَّلُولِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ الْعَبْدِيُّ ،  عَنْ  هَارُونَ بْنِ سَعْدٍ ،  عَنْ  عِمْرَانَ بْنِ ظِبْيَانَ ،  عَنْ  أَبِي يَحْيَى حَكِيمِ بْنِ سَعْدٍ ، قَالَ :  سَمِعْتُ  عَلِيًّا - رَضِيَ اللهُ عَنْهُ - "" يَحْلِفُ :  لَلَّهُ أَنْزَلَ اسْمَ  أَبِي بَكْرٍ  مِنَ السَّمَاءِ  الصِّدِّيقُ  .","","Al-Mu'jam al-Kabir 14","","علي بن أبي طالب عن حكيم بن سعد الحنفي عن عمران بن ظبيان الكوفي عن هارون بن سعد العجلي عن محمد بن سليمان العيذي عن إسحاق بن منصور السلولي عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","نسبة أبي بكر الصديق واسمه رضي الله عنه"
"15","15  -  حَدَّثَنَا  بُهْلُولُ بْنُ إِسْحَاقَ بْنِ بُهْلُولٍ الْأَنْبَارِيُّ ،  ثَنَا  أَبِي  ،  عَنْ  عَبْدِ الْأَعْلَى بْنِ أَبِي الْمُسَاوِرِ ،  عَنْ  عِكْرِمَةَ ، قَالَ :  أَخْبَرَتْنِي  أُمُّ هَانِئٍ ، قَالَتْ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لَمَّا أُسْرِيَ بِهِ : إِنِّي أُرِيدُ أَنْ أَخْرُجَ إِلَى  قُرَيْشٍ  فَأُخْبِرَهُمْ ، فَأَخْبَرَهُمْ فَكَذَّبُوهُ  ، وَصَدَّقَهُ  أَبُو بَكْرٍ  فَسُمِّي يَوْمَئِذٍ  الصِّدِّيقُ  .","","Al-Mu'jam al-Kabir 15","","فاختة الهاشمية أخت علي بن أبي طالب عن عكرمة مولى ابن عباس عن عبد الأعلى بن أبي المساور الجرار عن إسحاق بن بهلول الأنباري عن البهلول بن إسحاق التنوخي عن الطبراني","نسبة أبي بكر الصديق واسمه رضي الله عنه"
"16","[1/56]      صِفَةُ  أَبِي بَكْرٍ  رَضِيَ اللهُ عَنْهُ  16  -  حَدَّثَنَا  طَاهِرُ بْنُ عِيسَى بْنِ قِيرَسٍ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  ثَنَا  الْحَارِثُ بْنُ يَزِيدَ ،  عَنْ  عُلَيِّ بْنِ رَبَاحٍ ،  أَنَّ  عَبْدَ اللهِ بْنَ عَمْرٍو - رَضِيَ اللهُ عَنْهُ - قَالَ :  ثَلَاثَةٌ مِنْ  قُرَيْشٍ  أَصْبَحُ  قُرَيْشٍ  وُجُوهًا  ، وَأَحْسَنُهَا  أَخْلَاقًا  ، وَأَثْبَتُهَا حَيَاءً ، إِنْ حَدَّثُوكَ لَمْ يَكْذِبُوكَ ، وَإِنْ حَدَّثْتَهُمْ لَمْ يُكَذِّبُوكَ : أَبُو بَكْرٍ الصِّدِّيقُ ، وَأَبُو عُبَيْدَةَ بْنُ الْجَرَّاحِ ، وَعُثْمَانُ بْنُ عَفَّانَ - رَضِيَ اللهُ عَنْهُمْ -  "" .","","Al-Mu'jam al-Kabir 16","","عثمان بن عفان عن عبد الله بن عمرو بن العاص عن علي بن رباح اللخمي عن الحارث بن يزيد الحضرمي عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن طاهر بن عيسى بن قيرس المؤدب عن الطبراني","صفة أبي بكر رضي الله عنه"
"17","17  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ - رَضِيَ اللهُ عَنْهُ -  أَنَّ  أَبَا بَكْرٍ - رَضِيَ اللهُ عَنْهُ - خَضَبَ بِالْحِنَّاءِ  وَالْكَتَمِ  "" .","","Al-Mu'jam al-Kabir 17","","أبو  بكر الصديق عن أنس بن مالك عن ثابت البناني عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","صفة أبي بكر رضي الله عنه"
"18","18  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  قَتَادَةَ ، وَثَابِتٍ ،  عَنْ  أَنَسٍ - رَضِيَ اللهُ عَنْهُ -  أَنَّ  أَبَا بَكْرٍ - رَضِيَ اللهُ عَنْهُ - خَضَبَ لِحْيَتَهُ بِالْحِنَّاءِ  وَالْكَتَمِ  ،  وَأَنَّ  عُمَرَ - رَضِيَ اللهُ عَنْهُ - خَضَبَ بِالْحِنَّاءِ فَرْدًا  "" .","","Al-Mu'jam al-Kabir 18","","عمر بن الخطاب عن أنس بن مالك عن ثابت البناني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","صفة أبي بكر رضي الله عنه"
"19","19  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ مِثْلَهُ .","","Al-Mu'jam al-Kabir 19","","عمر بن الخطاب عن أنس بن مالك عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن العباس بن الوليد النرسي عن عبد الله بن أحمد بن حنبل عن الطبراني","صفة أبي بكر رضي الله عنه"
"20","20  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا  شُعْبَةُ ،  عَنْ  حُمَيْدٍ ،  عَنْ  أَنَسٍ ،  أَنَّ  أَبَا بَكْرٍ - رَضِيَ اللهُ عَنْهُ - كَانَ يَخْضِبُ بِالْحِنَّاءِ  وَالْكَتَمِ  ،  وَأَنَّ  عُمَرَ - رَضِيَ اللهُ عَنْهُ - كَانَ يَخْضِبُ بِالْحِنَّاءِ  "" .","","Al-Mu'jam al-Kabir 20","","عمر بن الخطاب عن أنس بن مالك عن حميد الطويل عن شعبة بن الحجاج عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","صفة أبي بكر رضي الله عنه"
"21","21  -  ثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ ،  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  حَدَّثَنِي  الْوَاقِدِيُّ ،  حَدَّثَنِي  شُعَيْبُ بْنُ طَلْحَةَ بْنِ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ الصِّدِّيقِ - رَضِيَ اللهُ عَنْهُ -  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ -رَضِيَ اللهُ عَنْهَا -  أَنَّهَا رَأَتْ رَجُلًا مَارًّا ، وَهِيَ فِي هَوْدَجِهَا فَقَالَتْ :  مَا رَأَيْتُ رَجُلًا أَشْبَهَ بِأَبِي بَكْرٍ مِنْ         [1/57]      هَذَا  ، فَقِيلَ لَهَا : صِفِي لَنَا  أَبَا بَكْرٍ  ، فَقَالَتْ : "" كَانَ رَجُلًا أَبْيَضَ نَحِيفًا خَفِيفَ  الْعَارِضَيْنِ  ، أَحْنَا لَا تَسْتَمْسِكُ أُزْرَتُهُ ، تَسْتَرْخِي عَنْ حَقْوَيْهِ ، مَعْرُوقَ الْوَجْهِ ، غَائِرَ الْعَيْنَيْنِ ، نَاتِئَ الْجَبْهَةِ ،  عَارِيَ  الْأَشَاجِعِ ، هَذِهِ صِفَتُهُ  "" .","","Al-Mu'jam al-Kabir 21","","أبو  بكر الصديق عن عائشة بنت أبي بكر الصديق عن طلحة بن عبد الله بن عبد الرحمن بن أبي بكر الصديق عن شعيب بن طلحة بن عبد الله عن الواقدي عن إبراهيم بن المنذر الحزامي عن الزبير بن بكار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","صفة أبي بكر رضي الله عنه"
"22","22  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِي ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادِ بْنِ أَنْعُمَ ،  ثَنَا  عُمَارَةُ بْنُ غُرَابٍ ،  عَنْ  عَمِّهِ ، قَالَ :  رَأَيْتُ  أَبَا بَكْرٍ الصِّدِّيقَ وَهُوَ  خَلِيفَةُ  رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَحْمَرَ اللِّحْيَةِ قَانِيَهَا  "" .","","Al-Mu'jam al-Kabir 22","","أبو  بكر الصديق عن عم عمارة بن غراب اليحصبي عن عمارة بن غراب اليحصبي عن عبد الرحمن بن زياد بن أنعم الإفريقي عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","صفة أبي بكر رضي الله عنه"
"23","23  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ قَالَ :  كَانَ أَبُو بَكْرٍ - رَضِيَ اللهُ عَنْهُ - يَخْضِبُ بِالْحِنَّاءِ  "" .","","Al-Mu'jam al-Kabir 23","","أبو  بكر الصديق عن زياد بن علاقة الثعلبي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","صفة أبي بكر رضي الله عنه"
"24","24  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  أَبِي عَوْنٍ ،  عَنْ  رَجُلٍ ، مِنْ بَنِي أَسَدٍ قَالَ :  رَأَيْتُ  أَبَا بَكْرٍ - رَضِيَ اللهُ عَنْهُ - فِي غَزْوَةِ  ذَاتِ السَّلَاسِلِ  ، وَكَأَنَّ لِحْيَتَهُ لَهَبُ الْعَرْفَجِ  ، عَلَى نَاقَةٍ لَهُ أَدَمًا أَبْيَضَ خَفِيفًا  "" .","","Al-Mu'jam al-Kabir 24","","أبو  بكر الصديق عن رجل من بني أسد عن محمد بن عبيد الله بن سعيد الثقفي عن مسعر بن كدام عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","صفة أبي بكر رضي الله عنه"
"25","25  -  حَدَّثَنَا  الْقَاسِمُ بْنُ عَبَّادٍ الْخَطَّابِيُّ الْبَصْرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ لُوَيْنٌ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ، قَالَ :  قَالَ  مُعَاوِيَةُ - رَضِيَ اللهُ عَنْهُ - :  دَخَلْتُ  مَعَ أَبِي عَلَى أَبِي بَكْرٍ - رَضِيَ اللهُ عَنْهُ - فَرَأَيْتُ  أَسْمَاءَ  قَائِمَةً عَلَى رَأْسِهِ بَيْضَاءَ  ، وَرَأَيْتُ  أَبَا بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - أَبْيَضَ نَحِيفًا فَحَمَلَنِي وَأَبِي عَلَى فَرَسَيْنِ ، ثُمَّ عُرِضْنَا عَلَيْهِ ، وَأَجَازَنَا  "" .","","Al-Mu'jam al-Kabir 25","","أبو  بكر الصديق عن معاوية بن أبي سفيان عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن محمد بن سليمان لوين عن القاسم بن عباد الخطابى عن الطبراني","صفة أبي بكر رضي الله عنه"
"26","سِنُّ  أَبِي بَكْرٍ  وَخُطْبَتُهُ وَوَفَاتُهُ رَضِيَ اللهُ عَنْهُ  26  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ -رَضِيَ اللهُ عَنْهَا -  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [1/58]      مَاتَ عَلَى رَأْسِ ثَلَاثٍ وَسِتِّينَ  .  قَالَ  ابْنُ شِهَابٍ  : وَقَالَتْ  عَائِشَةُ  : ""  وَتُوُفِّيَ  أَبُو بَكْرٍ  عَلَى رَأْسِ ثَلَاثٍ وَسِتِّينَ "" .","","Al-Mu'jam al-Kabir 26","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"27","27  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ بْنُ سَعْدٍ ،  حَدَّثَنِي  عُقَيْلٌ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ -رَضِيَ اللهُ عَنْهَا -  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تُوُفِّيَ وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  .","","Al-Mu'jam al-Kabir 27","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن عقيل بن خالد الأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"28","28  -  حَدَّثَنَا  يَحْيَى  بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ -رَضِيَ اللهُ عَنْهَا - قَالَتْ :  تَذَاكَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - مِيلَادَهُمَا عِنْدِي  ، فَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَكْبَرَ مِنْ  أَبِي بَكْرٍ  ، فَتُوُفِّيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ ، وَتُوُفِّيَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ لِسَنَتَيْنِ وَنِصْفٍ الَّتِي عَاشَ بَعْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .  في طبعة مكتبة ابن تيمية : ( علي ) وكذا في النسخة الخطية إلا أنه ذكر في الحاشية : ( يحيى ) وصحح عليها .","","Al-Mu'jam al-Kabir 28","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن يحيى بن عثمان بن صالح عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"29","29  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  خَلَفُ بْنُ الْوَلِيدِ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ ، قَالَ : كُنْتُ مَعَ مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ - رَضِيَ اللهُ عَنْهُمْ -  فَسَمِعْتُهُ  يَقُولُ :  قُبِضَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ سَنَةً  ، وَقُبِضَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ ، وَقُبِضَ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ "" قَالَ  أَبُو إِسْحَاقَ  : وَقَالَ  مُعَاوِيَةُ  - رَضِيَ اللهُ عَنْهُ - : "" وَهَذِهِ لِي سَبْعٌ وَخَمْسُونَ ، ثُمَّ عَاشَ نَحْوًا مِنْ عِشْرِينَ سَنَةً .  .","","Al-Mu'jam al-Kabir 29","","معاوية بن أبي سفيان عن جرير بن عبد الله بن جابر يوسف الأمة عن عامر بن سعد البجلي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن خلف بن الوليد الجوهري عن بشر بن موسى بن صالح الأسدي عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"30","30  -  حَدَّثَنَا  أَبُو زُرْعَةَ الدِّمَشْقِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِي السَّفَرِ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ،  عَنْ  مُعَاوِيَةَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 30","","معاوية بن أبي سفيان عن جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن سعيد بن يحمد الهمداني عن يونس بن أبي إسحاق عن الفضل بن دكين عن أبو زرعة الدمشقي عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"31","31  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ         [1/59]      أَبِي إِسْحَاقَ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ، قَالَ :  حَدَّثَنِي  جَرِيرٌ ،  عَنْ  مُعَاوِيَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  مَاتَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  "" .","","Al-Mu'jam al-Kabir 31","","معاوية بن أبي سفيان عن جرير بن عبد الله بن جابر يوسف الأمة عن عامر بن سعد البجلي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن عاصم بن علي الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"32","32  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  مُعَاوِيَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  قُبِضَ  أَبُو بَكْرٍ  وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ .  "" 0","","Al-Mu'jam al-Kabir 32","","معاوية بن أبي سفيان عن عامر بن سعد البجلي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"33","33  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  أُمَيَّةُ بْنُ خَالِدٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  جَرِيرٍ ،  عَنْ  مُعَاوِيَةَ - رَضِيَ اللهُ عَنْهُ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 33","","معاوية بن أبي سفيان عن جرير بن عبد الله بن جابر يوسف الأمة عن عامر بن سعد البجلي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن أمية بن خالد الثوباني عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"34","34  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَبْدِ اللهِ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدَ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  تُوُفِّيَ أَبُو بَكْرٍ - رَضِيَ اللهُ عَنْهُ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  .","","Al-Mu'jam al-Kabir 34","","أبو  بكر الصديق عن الشعبي عن داود بن أبي هند عن إسماعيل بن عبد الله بن الحارث الأزدي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"35","35  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ ،  ثَنَا  أَبُو ضَمْرَةَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  تُوُفِّيَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ سَنَةً  ، وَوَلِيَ  أَبُو بَكْرٍ  سَنَتَيْنِ ، وَدُفِنَ لَيْلًا ، وَصَلَّى عَلَيْهِ  عُمَرُ  - رَضِيَ اللهُ عَنْهُمَا - ""  .","","Al-Mu'jam al-Kabir 35","","سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن أنس بن عياض الليثي عن الزبير بن بكار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"36","36  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِي الْحُوَيْرِثِ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَاتَ وَهُوَ ابْنُ خَمْسٍ وَسِتِّينَ سَنَةً  ،  وَأَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - بِمَنْزِلَتِهِ "" .","","Al-Mu'jam al-Kabir 36","","عبد الله بن عباس عن عبد الرحمن بن معاوية النوفلي عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"37","37  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ الْمِصْرِيُّ  ، ثَنَا  يُوسُفُ بْنُ         [1/60]      عَدِيٍّ الْكُوفِيُّ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنِ  الْأَغَرِّ أَبِي مَالِكٍ ، قَالَ :  لَمَّا أَرَادَ أَبُو بَكْرٍ - رَضِيَ اللهُ عَنْهُ - أَنَّ يَسْتَخْلِفَ  عُمَرَ  بَعَثَ إِلَيْهِ فَدَعَاهُ فَأَتَاهُ ،  فَقَالَ  :  إِنِّي أَدْعُوكَ إِلَى أَمْرٍ مُتْعِبٍ لِمَنْ وَلِيَهُ ، فَاتَّقِ اللهَ يَا  عُمَرُ  بِطَاعَتِهِ  ، وَأَطِعْهُ بِتَقْوَاهُ ، فَإِنَّ الْمُتَّقِيَ آمِنٌ مَحْفُوظٌ ، ثُمَّ إِنَّ الْأَمْرَ مَعْرُوضٌ لَا يَسْتَوْجِبُهُ إِلَّا مَنْ عَمِلَ بِهِ فَمَنْ أَمَرَ بِالْحَقِّ وَعَمِلَ بِالْبَاطِلِ ، وَأَمَرَ بِالْمَعْرُوفِ وَعَمِلَ بِالْمُنْكِرِ  يُوشِكُ  أَنَّ تَنْقَطِعَ أُمْنِيَّتُهُ ، وَأَنْ يَحْبَطَ عَمَلُهُ ، فَإِنْ أَنْتَ وُلِّيتَ عَلَيْهِمْ أَمْرَهُمْ ، فَإِنِ اسْتَطَعْتَ أَنْ تَجِفَّ يَدُكَ مِنْ دِمَائِهِمْ ، وَأَنْ تَضْمُرَ بَطْنُكَ مِنْ أَمْوَالِهِمْ ، وَأَنْ يَجِفَّ لِسَانُكَ عَنْ  أَعْرَاضِهِمْ  فَافْعَلْ ، وَلَا قُوَّةَ إِلَّا بِاللهِ  "" .","","Al-Mu'jam al-Kabir 37","","أبو  بكر الصديق عن الأغر أبي مالك عن سلام بن سليم الحنفي عن يوسف بن عدي بن رزق الكوفي عن عمرو بن أبي الطاهر المصري عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"38","38  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  هَارُونُ بْنُ مُوسَى الْفَرْوِيُّ ،  ثَنَا  مُوسَى بْنُ عَبْدِ اللهِ بْنِ حَسَنِ بْنِ حَسَنِ بْنِ عَلِيِّ بْنِ أَبِي طَالِبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ الْحَسَنِ بْنِ عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  لَمَّا احْتُضِرَ أَبُو بَكْرٍ - رَضِيَ اللهُ عَنْهُ -  قَالَ  :  يَا  عَائِشَةُ  انْظُرِي اللِّقْحَةَ الَّتِي كُنَّا نَشْرَبُ مِنْ لَبَنِهَا ، وَالْجَفْنَةَ الَّتِي كُنَّا نَصْطَبِحُ فِيهَا  ، وَالْقَطِيفَةَ الَّتِي كُنَّا نَلْبَسُهَا ، فَإِنَّا كُنَّا نَنْتَفِعُ بِذَلِكَ حِينَ كُنَّا فِي أَمْرِ الْمُسْلِمِينَ ، فَإِذَا مُتُّ فَارْدُدِيهِ إِلَى  عُمَرَ  ، فَلَمَّا مَاتَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - أَرْسَلَتْ بِهِ إِلَى  عُمَرَ  - رَضِيَ اللهُ عَنْهُ - فَقَالَ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - : - رَضِيَ اللهُ عَنْكَ - يَا  أَبَا بَكْرٍ  لَقَدْ أَتْعَبْتَ مَنْ جَاءَ بَعْدَكَ  .","","Al-Mu'jam al-Kabir 38","","أبو  بكر الصديق عن الحسن بن علي سبط رسول الله عن عبد الله بن حسن بن حسن بن علي بن أبي طالب عن موسى بن عبد الله بن حسن العلوي عن هارون بن موسى بن أبي علقمة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"39","39  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ  ، ثَنَا  أَبُو الْمُغِيرَةِ ،  ثَنَا  حَرِيزُ بْنُ عُثْمَانَ ،  عَنْ  نُعَيْمِ بْنِ نَمِحَةَ ، قَالَ :  كَانَ فِي خُطْبَةِ أَبِي بَكْرٍ - رَضِيَ اللهُ عَنْهُ - :  أَمَا تَعْلَمُونَ أَنَّكُمْ تَغْدُونَ وَتَرُوحُونَ لِأَجَلٍ مَعْلُومٍ  ، فَمَنِ اسْتَطَاعَ أَنْ يَنْقَضِيَ الْأَجَلُ وَهُوَ فِي عَمَلِ اللهِ - عَزَّ وَجَلَّ - فَلْيَفْعَلْ ، وَلَنْ تَنَالُوا ذَلِكَ إِلَّا بِاللهِ - عَزَّ وَجَلَّ - إِنَّ قَوْمًا جَعَلُوا آجَالَهُمْ لِغَيْرِهِمْ فَنَهَاكُمُ اللهُ أَنْ تَكُونُوا أَمْثَالَهُمْ :         {      وَلا تَكُونُوا كَالَّذِينَ نَسُوا اللهَ فَأَنْسَاهُمْ         }      أَيْنَ مَنْ تَعْرِفُونَ مِنْ إِخْوَانِكُمْ ؟ قَدَّمُوا مَا         [1/61]      قَدَّمُوا فِي أَيَّامِ سَلَفِهِمْ ، وَحَلُّوا فِيهِ بِالشِّقْوَةِ وَالسَّعَادَةِ ، أَيْنَ الْجَبَّارُونَ الْأَوَّلُونَ الَّذِينَ بَنَوُا الْمَدَائِنَ وَحَفَفُوهَا بِالْحَوَائِطِ ، قَدْ صَارُوا تَحْتَ الصَّخْرِ وَالْآبَارِ ، هَذَا كِتَابُ اللهِ - عَزَّ وَجَلَّ - لَا تَفْنَى عَجَائِبُهُ فَاسْتَوْصُوا بِهِ مِنْهُ لِيَوْمِ ظُلْمَةٍ ، وَائْتَضِحُوا بِسَائِهِ وَبَيَانِهِ ، إِنَّ اللهَ - عَزَّ وَجَلَّ - أَثْنَى عَلَى  زَكَرِيَّا  وَأَهْلِ بَيْتِهِ فَقَالَ :         {      كَانُوا يُسَارِعُونَ فِي الْخَيْرَاتِ وَيَدْعُونَنَا رَغَبًا وَرَهَبًا وَكَانُوا لَنَا خَاشِعِينَ         }      لَا خَيْرَ فِي قَوْلٍ لَا يُرَادَ بِهِ وَجْهُ اللهِ ، وَلَا خَيْرَ فِي مَالٍ لَا يُنْفَقُ فِي  سَبِيلِ  اللهِ ، وَلَا خَيْرَ فِيمَنْ يَغْلِبُ جَهْلُهُ حِلْمَهُ ، وَلَا خَيْرَ فِيمَنْ يَخَافُ فِي اللهِ لَوْمَةَ لَائِمٍ  "" .","","Al-Mu'jam al-Kabir 39","","أبو  بكر الصديق عن نعيم بن نمحة عن حريز بن عثمان الرحبي عن عبد القدوس بن الحجاج عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"40","40  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ -رَضِيَ اللهُ عَنْهَا - قَالَتْ :  تُوُفِّيَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - لَيْلَةَ الثُّلَاثَاءِ ، وَدُفِنَ لَيْلًا  "" .","","Al-Mu'jam al-Kabir 40","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"41","41  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  الْهَيْثَمُ بْنُ عِمْرَانَ ، قَالَ :  سَمِعْتُ  جَدِّي يَقُولُ :  تُوُفِّيَ أَبُو بَكْرٍ - رَضِيَ اللهُ عَنْهُ - وَبِهِ طَرَفٌ مِنَ السُّلِّ  ، وَوَلِيَ سَنَتَيْنِ وَنِصْفًا  "" .","","Al-Mu'jam al-Kabir 41","","أبو  بكر الصديق عن عبد الله بن أبي عبد الله العنسي عن الهيثم بن عمران عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"42","42  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ، قَالَ :  اسْتُخْلِفَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - فِي الْيَوْمِ الَّذِي تُوُفِّيَ فِيهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - وَتُوُفِّيَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - فِي جُمَادَى الْآخِرَةِ سَنَةَ ثَلَاثَ عَشْرَةَ ، وَسِنُّهُ يَوْمَ تُوُفِّيَ "" كَمَا ذَكَرَتْ  عَائِشَةُ  -رَضِيَ اللهُ عَنْهَا -  سِنُّ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  "" .","","Al-Mu'jam al-Kabir 42","","يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","سن أبي بكر وخطبته ووفاته رضي الله عنه"
"43","[1/62]      وَمِمَّا أَسْنَدَ  أَبُو بَكْرٍ الصِّدِّيقُ  رَضِيَ اللهُ عَنْهُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  43  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ عُفَيْرٍ ،  حَدَّثَنِي  عُلْوَانُ بْنُ دَاوُدَ الْبَجَلِيُّ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  دَخَلْتُ عَلَى  أَبِي بَكْرٍ - رَضِيَ اللهُ عَنْهُ - أَعُودُهُ فِي مَرَضِهِ الَّذِي تُوُفِّيَ فِيهِ ، فَسَلَّمْتُ عَلَيْهِ وَسَأَلْتُهُ كَيْفَ أَصْبَحْتَ ؟ فَاسْتَوَى جَالِسًا ، فَقُلْتُ : أَصْبَحْتَ بِحَمْدِ اللهِ  بَارِئًا  ، فَقَالَ :  أَمَا إِنِّي عَلَى مَا تَرَى وَجِعٌ ، وَجَعَلْتُمْ لِي شُغُلًا مَعَ وَجَعِي  ، جَعَلْتُ لَكُمْ عَهْدًا مِنْ بَعْدِي ، وَاخْتَرْتُ لَكُمْ خَيْرَكُمْ فِي نَفْسِي ، فَكُلُّكُمْ  وَرِمَ  لِذَلِكَ  أَنْفُهُ  رَجَاءَ أَنْ يَكُونَ الْأَمْرُ لَهُ ، وَرَأَيْتُ الدُّنْيَا قَدْ أَقْبَلَتْ ، وَلَمَّا تُقْبِلْ وَهِيَ جَائِيَةٌ ، وَسَتُنَجِّدُونَ بُيُوتَكُمْ بِسُوَرِ الْحَرِيرِ ،  وَنَضَائِدِ  الدِّيبَاجِ  ، وَتَأْلَمُونَ ضَجَائِعَ الصُّوفِ الْأَذْرِيِّ ، كَأَنَّ أَحَدَكُمْ عَلَى  حَسَكِ  السَّعْدَانِ  ، وَوَاللهِ لَأَنْ يُقَدَّمَ أَحَدُكُمْ فَيُضْرَبَ عُنُقُهُ - فِي غَيْرِ حَدٍّ - خَيْرٌ لَهُ مِنْ أَنْ يَسِيحَ فِي غَمْرَةِ الدُّنْيَا "" ثُمَّ قَالَ : "" أَمَا إِنِّي لَا آسَى عَلَى شَيْءٍ إِلَّا عَلَى ثَلَاثٍ فَعَلْتُهُنَّ ، وَدِدْتُ أَنِّي لَمْ أَفْعَلْهُنَّ ، وَثَلَاثٍ لَمْ أَفْعَلْهُنَّ وَدِدْتُ أَنِّي فَعَلْتُهُنَّ ، وَثَلَاثٍ وَدِدْتُ أَنِّي سَأَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْهُنَّ ، فَأَمَّا الثَّلَاثُ اللَّاتِي وَدِدْتُ أَنِّي لَمْ أَفْعَلْهُنَّ : فَوَدِدْتُ أَنِّي لَمْ أَكُنْ كَشَفْتُ بَيْتَ  فَاطِمَةَ  وَتَرَكْتُهُ ، وَأَنْ أُغْلِقَ عَلَيَّ الْحَرْبَ ، وَوَدِدْتُ أَنِّي يَوْمَ  سَقِيفَةِ بَنِي سَاعِدَةَ  كُنْتُ قَذَفْتُ الْأَمْرَ فِي عُنُقِ أَحَدِ الرَّجُلَيْنِ :  أَبِي عُبَيْدَةَ  أَوْ  عُمَرَ  ، فَكَانَ أَمِيرَ الْمُؤْمِنِينَ ، وَكُنْتُ وَزِيرًا ، وَوَدِدْتُ أَنِّي حَيْثُ كُنْتُ وَجَّهْتُ  خَالِدَ بْنَ الْوَلِيدِ  إِلَى أَهْلِ الرِّدَّةِ ، أَقَمْتُ  بِذِي  الْقَصَّةِ  ، فَإِنْ ظَفِرَ الْمُسْلِمُونَ ظَفِرُوا ، وَإِلَّا كُنْتُ رِدْءًا أَوْ مَدَدًا ، وَأَمَّا اللَّاتِي وَدِدْتُ أَنِّي فَعَلْتُهَا : فَوَدِدْتُ أَنِّي يَوْمَ أُتِيتُ  بِالْأَشْعَثِ  أَسِيرًا ضَرَبْتُ         [1/63]      عُنُقَهُ ، فَإِنَّهُ يُخَيَّلُ إِلَيَّ أَنَّهُ لَا يَكُونُ شَرٌّ إِلَّا طَارَ إِلَيْهِ ، وَوَدِدْتُ أَنِّي يَوْمَ أُتِيتُ  بِالْفُجَاءَةِ السُّلَمِيِّ  لَمْ أَكُنْ أَحْرِقُهُ ، وَقَتَلْتُهُ سَرِيحًا ، أَوْ أَطْلَقْتُهُ نَجِيحًا ، وَوَدِدْتُ أَنِّي حَيْثُ وَجَّهْتُ  خَالِدَ بْنَ الْوَلِيدِ  إِلَى  الشَّامِ  وَجَّهْتُ  عُمَرَ  إِلَى  الْعِرَاقِ  فَأَكُونُ قَدْ بَسَطْتُ يَدَيَّ يَمِينِي وَشِمَالِي فِي  سَبِيلِ  اللهِ - عَزَّ وَجَلَّ - ، وَأَمَّا الثَّلَاثُ اللَّاتِي وَدِدْتُ أَنِّي سَأَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : عَنْهُنَّ ، فَوَدِدْتُ أَنِّي كُنْتُ سَأَلْتُهُ فِيمَنْ هَذَا الْأَمْرُ ؟ فَلَا يُنَازَعُهُ أَهْلَهُ ، وَوَدِدْتُ أَنِّي كُنْتُ سَأَلْتُهُ هَلْ  لِلْأَنْصَارِ  فِي هَذَا الْأَمْرِ سَبَبٌ ؟ وَوَدِدْتُ أَنِّي سَأَلْتُهُ عَنِ الْعَمَّةِ وَبِنْتِ الْأَخِ ، فَإِنَّ فِي نَفْسِي مِنْهُمَا حَاجَةً  "" .","","Al-Mu'jam al-Kabir 43","","أبو  بكر الصديق عن عبد الرحمن بن عوف بن عبد عوف القرشي عن حميد بن عبد الرحمن القرشي عن صالح بن كيسان الدوسي عن حميد بن عبد الرحمن بن حميد بن عبد الرحمن بن عوف عن علوان بن داود البجلي عن سعيد بن كثير بن عفير عن روح بن الفرج القطان عن الطبراني","ومما أسند أبو بكر الصديق رضي الله عنه عن رسول الله صلى الله عليه وسلم"
"44","44  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ النَّهْدِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ حُمَيْدٍ الرَّوَاسِبِيُّ ،  ثَنَا  سُلَيْمَانُ الْأَعْمَشُ ،  عَنْ  إِسْمَاعِيلَ بْنِ رَجَاءٍ ،  عَنْ  عُمَيْرٍ ، مَوْلَى ابْنِ عَبَّاسٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - ، قَالَ :  اخْتَصَمَ  عَلِيٌّ  وَالْعَبَّاسُ  إِلَى أَبِي بَكْرٍ - رَضِيَ اللهُ عَنْهُمْ - فِي مِيرَاثِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  مَا كُنْتُ لِأُحَوِّلَهُ عَنْ مَوْضِعِهِ الَّذِي وَضَعَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  .","","Al-Mu'jam al-Kabir 44","","أبو  بكر الصديق عن عبد الله بن عباس عن عمير بن عبد الله الهلالي عن إسماعيل بن رجاء الزبيدي عن الأعمش عن عبد الرحمن بن حميد الرؤاسي عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ومما أسند أبو بكر الصديق رضي الله عنه عن رسول الله صلى الله عليه وسلم"
"45","45  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  عَبْدُ الْجَبَّارِ بْنُ سَعِيدٍ الْمَسَاحِقِيُّ ،  ثَنَا  يَحْيَى بْنُ مُحَمَّدِ بْنِ عَبَّادِ بْنِ هَانِئٍ الشَّجَرِيُّ ،  ثَنَا  هِشَامُ بْنُ سَعْدٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ،  عَنْ  أَبِي قَبِيلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ - رَضِيَ اللهُ عَنْهُ - قَالَ :  كَتَبَ أَبُو بَكْرٍ - رَضِيَ اللهُ عَنْهُ - إِلَى  عَمْرِو بْنِ الْعَاصِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ فِي  الْأَنْصَارِ  :  اقْبَلُوا مِنْ مُحْسِنِهِمْ وَتَجَاوَزُوا عَنْ مُسِيئِهِمْ  .","","Al-Mu'jam al-Kabir 45","","أبو  بكر الصديق عن عبد الله بن عمرو بن العاص عن حيي بن هانئ السريعي عن سعيد بن أبي هلال الليثي عن هشام بن سعد المخزومي عن يحيى بن محمد بن عباد الشجري عن عبد الجبار بن سعيد المساحقي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","ومما أسند أبو بكر الصديق رضي الله عنه عن رسول الله صلى الله عليه وسلم"
"46","46  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  عَبْدُ الْجَبَّارِ بْنُ سَعِيدٍ الْمَسَاحِقِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ مُحَمَّدٍ الشَّجَرِيُّ ،  ثَنَا  هِشَامُ بْنُ سَعْدٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ،  عَنْ  أَبِي قَبِيلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو - رَضِيَ اللهُ عَنْهُ - قَالَ :  كَتَبَ أَبُو بَكْرٍ - رَضِيَ اللهُ عَنْهُ - إِلَى  عَمْرِو بْنِ الْعَاصِ  "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  شَاوَرَ فِي أَمْرِ         [1/64]      الْحَرْبِ  فَعَلَيْكَ بِهِ  .","","Al-Mu'jam al-Kabir 46","","أبو  بكر الصديق عن عبد الله بن عمرو بن العاص عن حيي بن هانئ السريعي عن سعيد بن أبي هلال الليثي عن هشام بن سعد المخزومي عن يحيى بن محمد بن عباد الشجري عن عبد الجبار بن سعيد المساحقي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","ومما أسند أبو بكر الصديق رضي الله عنه عن رسول الله صلى الله عليه وسلم"
"47","47  -  حَدَّثَنَا  أَبُو زَيْدٍ الْحَوْطِيُّ  ، ثَنَا  أَبُو الْيَمَانِ ،  ثَنَا  عَطَّافُ بْنُ خَالِدٍ ،  حَدَّثَنِي  طَلْحَةُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ ،  عَنْ  أَبِيهِ ، قَالَ :  سَمِعْتُ  أَبِي ، قَالَ :  سَمِعْتُ  أَبَا بَكْرٍ الصِّدِّيقَ  - رَضِيَ اللهُ عَنْهُ - يَقُولُ : قُلْتُ :  يَا رَسُولَ اللهِ ، أَنَعْمَلُ عَلَى أَمْرٍ قَدْ فُرِغَ مِنْهُ أَمْ عَلَى أَمْرٍ مُؤْتَنَفٍ ؟ قَالَ :  بَلْ عَلَى أَمْرٍ قَدْ فُرِغَ مِنْهُ  ، قُلْتُ : فَفِيمَ الْعَمَلُ يَا رَسُولَ اللهِ ؟ قَالَ : "" كُلٌّ  مُيَسَّرٌ  لِمَا خُلِقَ لَهُ  .","","Al-Mu'jam al-Kabir 47","","أبو  بكر الصديق عن عبد الرحمن بن أبي بكر الصديق عن عبد الله بن عبد الرحمن بن أبي بكر الصديق عن طلحة بن عبد الله بن عبد الرحمن بن أبي بكر الصديق عن عطاف بن خالد المخزومي عن أبو اليمان الحكم بن نافع عن أحمد بن عبد الرحيم بن يزيد الحوطي عن الطبراني","ومما أسند أبو بكر الصديق رضي الله عنه عن رسول الله صلى الله عليه وسلم"
"48","2 - نِسْبَةُ  عُمَرَ بْنِ الْخَطَّابِ  - رَضِيَ اللهُ عَنْهُ -  48  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ مُحَمَّدِ بْنِ عَبْدِ اللهِ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنِ  ابْنِ شِهَابٍ ، قَالَ :  قَالَ  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ لِأَبِي بَكْرِ بْنِ سُلَيْمَانَ بْنِ أَبِي حَثْمَةَ : مَنْ أَوَّلُ مَنْ كَتَبَ مِنْ  عَبْدِ اللهِ  أَمِيرِ الْمُؤْمِنِينَ ؟ فَقَالَ :  أَخْبَرَتْنِي  الشِّفَاءُ بِنْتُ عَبْدِ اللهِ - وَكَانَتْ مِنَ  الْمُهَاجِرَاتِ  الْأُوَلِ - "" أَنَّ  لَبِيدَ بْنَ رَبِيعَةَ  ،  وَعَدِيَّ بْنَ حَاتِمٍ  قَدِمَا  الْمَدِينَةَ  ، وَأَتَيَا الْمَسْجِدَ فَوَجَدَا  عَمْرَو بْنَ الْعَاصِ  فَقَالَا : يَا  ابْنَ الْعَاصِ  ، اسْتَأْذِنْ لَنَا عَلَى أَمِيرِ الْمُؤْمِنِينَ ، فَقَالَ : أَنْتُمَا وَاللهِ أَصَبْتُمَا اسْمَهُ ، هُوَ الْأَمِيرُ ، وَنَحْنُ الْمُؤْمِنُونَ ، فَدَخَلَ  عَمْرٌو  عَلَى  عُمَرَ  فَقَالَ :  السَّلَامُ عَلَيْكَ يَا أَمِيرَ الْمُؤْمِنِينَ ،  فَقَالَ لَهُ  عُمَرُ : مَا هَذَا ؟  فَقَالَ : أَنْتَ الْأَمِيرُ ، وَنَحْنُ الْمُؤْمِنُونَ ، فَجَرَى الْكِتَابُ مِنْ يَوْمِئِذٍ  "" .","","Al-Mu'jam al-Kabir 48","","عمر بن الخطاب عن الشفاء بنت عبد الله القرشية عن أبو بكر بن سليمان بن أبي حثمة العدوي عن عمر بن عبد العزيز بن مروان عن الزهري عن موسى بن عقبة عن يعقوب بن عبد الرحمن الإسكندراني عن عمرو بن خالد بن فروخ عن روح بن الفرج القطان عن الطبراني","نسبة عمر بن الخطاب رضي الله عنه"
"49","49  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ  ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ  ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ  ،  عَنِ  ابْنِ إِسْحَاقَ  ، قَالَ : ""  عُمَرُ بْنُ الْخَطَّابِ بْنِ نُفَيْلِ بْنِ عَبْدِ الْعُزَّى بْنِ رَبَاحِ بْنِ عَبْدِ اللهِ  بْنِ قُرْطِ بْنِ رَزَاحِ بْنِ عَدِيِّ بْنِ كَعْبِ بْنِ لُؤَيِّ بْنِ غَالِبِ بْنِ فِهْرِ بْنِ مَالِكٍ يُكَنَّى أَبَا حَفْصٍ  - رَضِيَ اللهُ عَنْهُ -         [1/65]      وَأُمُّهُ  حَنْتَمَةُ بِنْتُ هِشَامِ بْنِ الْمُغِيرَةِ بْنِ عَبْدِ اللهِ بْنِ عَمْرِو بْنِ مَخْزُومٍ  ،  وَأُمُّ حَنْتَمَةَ : الشِّفَاءُ بِنْتُ عَبْدِ قَيْسِ بْنِ عَدِيِّ بْنِ سَعِيدِ بْنِ سَهْمِ بْنِ عَمْرِو بْنِ هُصَيْصِ بْنِ كَعْبِ بْنِ لُؤَيٍّ  .  / 49 / 2 -  وَحَدَّثَنَا  بِهِ  أَبُو أُسَامَةَ الْحَلَبِيُّ  ،  ثَنَا  الْحَجَّاجُ بْنُ أَبِي مَنِيعٍ الرُّصَافِيُّ  ،  ثَنَا  جَدِّي ،  عُبَيْدُ اللهِ بْنُ زِيَادٍ  ،  عَنِ  الزُّهْرِيِّ  .","","Al-Mu'jam al-Kabir 49","","","نسبة عمر بن الخطاب رضي الله عنه"
"50","صِفَةُ  عُمَرَ بْنِ الْخَطَّابِ  رَضِيَ اللهُ عَنْهُ  50  -  أَخْبَرَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنِ  الْحَسَنِ ،  عَنِ  الْأَسْوَدِ بْنِ سَرِيعٍ ، قَالَ :  كُنْتُ أُنْشِدُهُ -  يَعْنِي النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - وَلَا أَعْرِفُ أَصْحَابَهُ ، حَتَّى جَاءَ رَجُلٌ بَعِيدٌ مَا بَيْنَ الْمَنَاكِبِ أَصْلَعُ "" فَقِيلَ لِي : اسْكُتِ اسْكُتْ . فَقُلْتُ :  وَاثُكْلَاهْ ، مَنْ هَذَا الَّذِي أَسْكُتُ لَهُ عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟  فَقِيلَ لِي :  عُمَرُ بْنُ الْخَطَّابِ  .","","Al-Mu'jam al-Kabir 50","","الأسود بن سريع التميمي عن الحسن البصري عن مبارك بن فضالة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","صفة عمر بن الخطاب رضي الله عنه"
"51","51  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ، قَالَ :  خَرَجَ  أَهْلُ الْمَدِينَةِ  فِي مَشْهَدٍ لَهُمْ ، فَإِذَا أَنَا بِرَجُلٍ أَصْلَعَ ، أَعْسَرَ  أَيْسَرَ  ، قَدْ أَشْرَفَ فَوْقَ النَّاسِ بِذِرَاعٍ عَلَيْهِ إِزَارٌ غَلِيظٌ وَبُرْدُ  قَطْرٍ  ، وَهُوَ  يَقُولُ  : "" يَا  أَيُّهَا النَّاسُ  هَاجِرُوا  ، وَلَا  تَهَجَّرُوا  ، وَلَا يَحْذِفَنَّ أَحَدُكُمُ الْأَرْنَبَ بِعَصَاهُ أَوْ بِحَجَرٍ فَيَأْكُلَهَا ، وَلْيُذَكِّ لَكُمُ  الْأَسَلُ  الرِّمَاحُ وَالنَّبْلُ "" فَقُلْتُ : مَنْ هَذَا ؟ قَالُوا : عُمَرُ بْنُ الْخَطَّابِ  .","","Al-Mu'jam al-Kabir 51","","عمر بن الخطاب عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","صفة عمر بن الخطاب رضي الله عنه"
"52","52  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  كَانَ         [1/66]      عُمَرُ بْنُ الْخَطَّابِ - رَضِيَ اللهُ عَنْهُ - أَصْلَعَ شَدِيدَ الصَّلَعِ  .","","Al-Mu'jam al-Kabir 52","","عمر بن الخطاب عن سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","صفة عمر بن الخطاب رضي الله عنه"
"53","53  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  وَعَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  رَكِبَ عُمَرُ بْنُ الْخَطَّابِ - رَضِيَ اللهُ عَنْهُ - فَرَسًا فَرَكَضَهُ  ، فَانْكَشَفَتْ فَخِذُهُ فَرَأَى  أَهْلُ نَجْرَانَ  عَلَى فَخِذِهِ شَامَةً سَوْدَاءَ ، فَقَالُوا : هَذَا الَّذِي نَجِدُ فِي كِتَابِنَا أَنَّهُ يُخْرِجُنَا مِنْ أَرْضِنَا  "" .","","Al-Mu'jam al-Kabir 53","","عمر بن الخطاب عن عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","صفة عمر بن الخطاب رضي الله عنه"
"54","54  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  إِسْحَاقُ بْنُ عِيسَى الطَّبَّاعُ ، قَالَ : رَأَيْتُ مَالِكَ بْنَ أَنَسٍ وَافِرَ الشَّارِبِ ،  فَسَأَلْتُهُ  عَنْ ذَلِكَ ، فَقَالَ :  حَدَّثَنِي  زَيْدُ بْنُ أَسْلَمَ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ كَانَ إِذَا غَضِبَ فَتَلَ شَارِبَهُ ، وَنَفَخَ  "" .","","Al-Mu'jam al-Kabir 54","","عمر بن الخطاب عن عامر بن عبد الله بن الزبير بن العوام عن زيد بن أسلم عن مالك بن أنس عن إسحاق بن عيسى بن نجيح عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","صفة عمر بن الخطاب رضي الله عنه"
"55","55  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِيهِ ، قَالَ :  كَانَ عُمَرُ - رَضِيَ اللهُ عَنْهُ - يَأْخُذُ بِأُذُنِهِ  -  يَعْنِي بِأُذُنِ نَفْسِهِ  - ثُمَّ يَثِبُ عَلَى الْفَرَسِ  "" .","","Al-Mu'jam al-Kabir 55","","عمر بن الخطاب عن أسلم العدوي مولى عمر بن الخطاب عن زيد بن أسلم عن عبد الله بن عمر العمري عن عاصم بن علي الواسطي عن محمد بن أحمد بن النضر النضري عن الطبراني","صفة عمر بن الخطاب رضي الله عنه"
"56","56  -  حَدَّثَنَا  مُوسَى بْنُ عِيسَى بْنِ الْمُنْذِرِ الْحِمْصِيُّ  ، حَدَّثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ الْحِمْصِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  بَحِيرِ بْنِ سَعْدٍ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو السُّلَمِيُّ ،  أَنَّ  عُمَرَ - رَضِيَ اللهُ عَنْهُ - عَرَضَتْ عَلَيْهِ مَوْلَاةٌ لَهُ أَنْ يَصْبُغَ لِحْيَتَهُ ، فَقَالَ :  أَتُرِيدُ أَنْ تُطْفِئَ نُورِي ، كَمَا أَطْفَأَ فُلَانٌ نُورَهُ  "" .","","Al-Mu'jam al-Kabir 56","","عمر بن الخطاب عن عبد الرحمن بن عمرو بن عبسة السلمي عن خالد بن معدان عن بحير بن سعد عن بقية بن الوليد عن حيوة المقرئ عن موسى بن عيسى بن المنذر الحمصي عن الطبراني","صفة عمر بن الخطاب رضي الله عنه"
"57","57  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  مُحَمَّدُ بْنُ حِمْيَرَ ،  ثَنَا         [1/67]      ثَابِتُ بْنُ عَجْلَانَ ، قَالَ :  سَمِعْتُ  أَبَا عَامِرٍ سُلَيْمَ بْنَ عَامِرٍ ، يَقُولُ :  رَأَيْتُ  عُمَرَ لَا يُغَيِّرُ مِنْ لِحْيَتِهِ شَيْئًا  "" .","","Al-Mu'jam al-Kabir 57","","عمر بن الخطاب عن سليم بن عامر الشامي عن ثابت بن عجلان السلمي عن محمد بن حمير القضاعي عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","صفة عمر بن الخطاب رضي الله عنه"
"58","58  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ  ، حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُصَفَّى ،  ثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  ثَابِتُ بْنُ عَجْلَانَ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ  ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ  - رَضِيَ اللهُ عَنْهُ - كَانَ لَا يُغَيِّرُ شَيْبَتَهُ ، فَقِيلَ : يَا أَمِيرَ الْمُؤْمِنِينَ أَلَا تُغَيِّرُ ، وَقَدْ كَانَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - يُغَيِّرُ ؟ قَالَ عُمَرُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ شَابَ شَيْبَةً فِي الْإِسْلَامِ ، كَانَتْ لَهُ نُورًا يَوْمَ الْقِيَامَةِ  ، وَمَا أَنَا بِمُغَيِّرٍ شَيْبَتِي  .","","Al-Mu'jam al-Kabir 58","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ثابت بن عجلان السلمي عن سويد بن عبد العزيز السلمي عن محمد بن مصفى بن بهلول عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","صفة عمر بن الخطاب رضي الله عنه"
"59","59  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ، قَالَ :  كُنْتُ  بِالْمَدِينَةِ  فَإِذَا رَجُلٌ آدَمُ  أَعْسَرُ  أَيْسَرُ  ضَخْمٌ  ، إِذْ أَشْرَفَ عَلَى النَّاسِ ، كَأَنَّهُ عَلَى دَابَّةٍ ، فَإِذَا هُوَ عُمَرُ - رَضِيَ اللهُ عَنْهُ  - "" .","","Al-Mu'jam al-Kabir 59","","عمر بن الخطاب عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن عثمان بن عمر الضبي عن الطبراني","صفة عمر بن الخطاب رضي الله عنه"
"60","60  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ هِلَالٍ ، قَالَ :  رَأَيْتُ  عُمَرَ - رَضِيَ اللهُ عَنْهُ - رَجُلًا ضَخْمًا  ، كَأَنَّهُ مِنْ رِجَالِ  بَنِي سَدُوسٍ  "" .","","Al-Mu'jam al-Kabir 60","","عمر بن الخطاب عن عبد الله بن هلال الطائفي عن سماك بن حرب البكري عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","صفة عمر بن الخطاب رضي الله عنه"
"61","سِنُّ  عُمَرَ  وَوَفَاتُهُ وَفِي سِنِّهِ اخْتِلَافٌ رَضِيَ اللهُ عَنْهُ  61  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، حَدَّثَنَا  حَبِيبٌ كَاتِبُ مَالِكٍ ،  ثَنَا  ابْنُ أَخِي الزُّهْرِيِّ ،  عَنِ  الزُّهْرِيِّ  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أُبَيِّ بْنِ كَعْبٍ - رَضِيَ         [1/68]      اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَالَ لِي  جِبْرِيلُ  - عَلَيْهِ السَّلَامُ - :  لِيَبْكِ الْإِسْلَامُ عَلَى مَوْتِ  عُمَرَ  - رَضِيَ اللهُ عَنْهُ  -  .","","Al-Mu'jam al-Kabir 61","","أبي بن كعب عن سعيد بن المسيب عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن حبيب بن أبي حبيب الحنفي عن أحمد بن داود بن موسى السدوسي عن الطبراني","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"62","62  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  عَمِّي أَبُو بَكْرٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  لَيْثٍ ،  عَنْ  مَعْرُوفِ بْنِ أَبِي مَعْرُوفٍ الْمَوْصِلِيِّ ، قَالَ :  لَمَّا أُصِيبَ عُمَرُ - رَضِيَ اللهُ عَنْهُ - سَمِعْتُ صَوْتًا  :  .","","Al-Mu'jam al-Kabir 62","","عمر بن الخطاب عن معروف بن أبى معروف الموصلي عن ليث بن أبي سليم عن عبد الله بن إدريس الأودي عن أبو بكر ابن أبي شيبة عن محمد بن عثمان بن أبي شيبة عن الطبراني","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"63","63  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  أَخْبَرَنِي  اللَّيْثُ ،  أَخْبَرَنِي  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  الْمِسْوَرِ بْنِ مَخْرَمَةَ قَالَ :  وَلِيَ عُمَرُ بْنُ الْخَطَّابِ - رَضِيَ اللهُ عَنْهُ - عَشْرَ سِنِينَ  ، ثُمَّ تُوُفِّيَ  ""  .","","Al-Mu'jam al-Kabir 63","","عمر بن الخطاب عن المسور بن مخرمة عن الزهري عن عبيد الله بن عمر العمري عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"64","64  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ  ،  عَنِ  ابْنِ جُرَيْجٍ  ،  عَنْ  أَبِي الْحُوَيْرِثِ  ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - :  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ  - رَضِيَ اللهُ عَنْهُ - مَاتَ وَهُوَ ابْنُ سِتٍّ وَسِتِّينَ سَنَةً  "" .","","Al-Mu'jam al-Kabir 64","","","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"65","65  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  هُشَيْمٌ ،  أَنَا  دَاوُدُ ،  عَنِ  الشَّعْبِيِّ  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ - رَضِيَ اللهُ عَنْهُ - مَاتَ وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  "" .","","Al-Mu'jam al-Kabir 65","","عمر بن الخطاب عن الشعبي عن داود بن أبي هند عن هشيم بن بشير عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"66","66  -  حَدَّثَنَا  أَبُو زُرْعَةَ الدِّمَشْقِيُّ  ، حَدَّثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِي السَّفَرِ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ،  عَنْ  مُعَاوِيَةَ - رَضِيَ اللهُ عَنْهُ -         [1/69]      قَالَ :  قُبِضَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ سَنَةً  ، وَقُبِضَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ سَنَةً ،  وَقُبِضَ  عُمَرُ  وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ سَنَةً  .","","Al-Mu'jam al-Kabir 66","","معاوية بن أبي سفيان عن جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن سعيد بن يحمد الهمداني عن يونس بن أبي إسحاق عن الفضل بن دكين عن أبو زرعة الدمشقي عن الطبراني","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"67","67  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  ثَنَا  أَبُو هِلَالٍ ،  عَنْ  قَتَادَةَ ، قَالَ :  قُتِلَ عُمَرُ - رَضِيَ اللهُ عَنْهُ - وَهُوَ ابْنُ إِحْدَى وَسِتِّينَ سَنَةً  "" .","","Al-Mu'jam al-Kabir 67","","عمر بن الخطاب عن قتادة بن دعامة عن محمد بن سليم الراسبي عن الحسن بن موسى الأشيب عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"68","68  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ شِهَابٍ ، قَالَ :  مَاتَ عُمَرُ - رَضِيَ اللهُ عَنْهُ - عَلَى رَأْسِ خَمْسٍ وَخَمْسِينَ  "" .","","Al-Mu'jam al-Kabir 68","","عمر بن الخطاب عن الزهري عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"69","69  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  هُشَيْمٌ ،  أَنَا  عَلِيُّ بْنُ زَيْدٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ  أَنَّ  عُمَرَ - رَضِيَ اللهُ عَنْهُ - قُبِضَ وَهُوَ ابْنُ خَمْسٍ وَخَمْسِينَ  ""  .","","Al-Mu'jam al-Kabir 69","","عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن علي بن زيد بن جدعان عن هشيم بن بشير عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"70","70  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرٍ الصَّائِغُ  ، ثَنَا  إِبْرَاهِيمُ بْنُ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  تُوُفِّيَ عُمَرُ - رَضِيَ اللهُ عَنْهُ - وَهُوَ ابْنُ خَمْسٍ وَخَمْسِينَ  "" .","","Al-Mu'jam al-Kabir 70","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن محمد بن نصر بن منصور الصائغ عن الطبراني","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"71","71  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  مَاتَ عُمَرُ - رَضِيَ اللهُ عَنْهُ - وَهُوَ ابْنُ خَمْسٍ وَخَمْسِينَ "" وَقَالَ :  أَسْرَعَ إِلَيَّ الشَّيْبُ مِنْ قِبَلِ أَخْوَالِي  بَنِي الْمُغِيرَةِ  "" .","","Al-Mu'jam al-Kabir 71","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جرير بن حازم عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"72","72  - حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ  ، حَدَّثَنِي  رِشْدِينُ بْنُ سَعْدٍ  ، ثَنَا  أَبُو يُوسُفَ الْحَارِثُ بْنُ يُوسُفَ الْأَنْصَارِيُّ ، مِنْ بَنِي         [1/70]      الْحَارِثِ بْنِ الْخَزْرَجِ  ، عَنْ  سَهْلِ بْنِ سَعْدٍ الْأَنْصَارِيِّ  ، قَالَ :  دُفِنَ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - يَوْمَ الْأَرْبِعَاءِ ، لِأَرْبَعِ لَيَالٍ بَقِينَ مِنْ ذِي الْحِجَّةِ ، سَنَةَ ثَلَاثٍ وَعِشْرِينَ  "" .","","Al-Mu'jam al-Kabir 72","","","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"73","73  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ، قَالَ :  اسْتُخْلِفَ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - فِي رَجَبٍ سَنَةَ ثَلَاثَ عَشْرَةَ ، وَقُتِلَ فِي عَقِبِ ذِي الْحِجَّةِ سَنَةَ ثَلَاثٍ وَعِشْرِينَ  ، فَأَقَامَ ثَلَاثَةَ أَيَّامٍ بَعْدَ الطَّعْنَةِ ، ثُمَّ مَاتَ فِي آخِرِ ذِي الْحِجَّةِ ، وَصَلَّى عَلَيْهِ  صُهَيْبٌ  ، وَوَلِيَ غُسْلَهُ ابْنُهُ  عَبْدُ اللهِ بْنُ عُمَرَ  ، وَكَفَّنَهُ فِي خَمْسَةِ أَثْوَابٍ ، وَدُفِنَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَطُعِنَ يَوْمَ الْأَرْبِعَاءِ لِتِسْعٍ بَقِينَ مِنْ ذِي الْحِجَّةِ "" وَقَالَ بَعْضُ النَّاسِ : مَاتَ مِنْ يَوْمِهِ ، وَكَانَ سِنُّهُ يَوْمَ تُوُفِّيَ فِيمَا سَمِعْتُ  مَالِكَ بْنَ أَنَسٍ  يَذْكُرُ أَنَّهُ "" بَلَغَ سِنَّ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ "" ، وَبَعْضُ النَّاسِ يَقُولُ : "" لِتِسْعٍ وَخَمْسِينَ "" وَبَعْضُهُمْ يَقُولُ : "" ثَلَاثٍ وَخَمْسِينَ وَخَمْسٍ وَخَمْسِينَ "" وَقَالَ بَعْضُهُمْ : "" أَرْبَعٍ وَخَمْسِينَ ، وَكَانَتْ خِلَافَتُهُ عَشْرَ سِنِينَ وَأَرْبَعَةَ أَشْهُرٍ وَأَيَّامًا  "" .","","Al-Mu'jam al-Kabir 73","","يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"74","74  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ،  عَنِ  اللَّيْثِ بْنِ سَعْدٍ  ، قَالَ : ""  قُتِلَ أَمِيرُ الْمُؤْمِنِينَ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - مَصْدَرَ الْحَاجِّ  ، وَذَلِكَ فِي سَنَةِ ثَلَاثٍ وَعِشْرِينَ  "" .","","Al-Mu'jam al-Kabir 74","","","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"75","75  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ صَدَقَةَ  ، ثَنَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ  قَالَ : يُقَالُ : ""  قُتِلَ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  وَالثَّبْتُ أَنَّهُ كَانَ ابْنَ ثَمَانٍ وَخَمْسِينَ  "" .","","Al-Mu'jam al-Kabir 75","","","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"76","76  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ  ، قَالَ : ""  تُوُفِّيَ  عُمَرُ  سَنَةَ ثَلَاثٍ وَعِشْرِينَ ، وَكَانَتْ خِلَافَتُهُ عَشْرَ سِنِينَ  "" .","","Al-Mu'jam al-Kabir 76","","","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"77","77  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  عَمْرُو بْنُ الرَّبِيعِ بْنِ طَارِقٍ ،  أَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  يُونُسَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ         [1/71]      عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  أَنَّ  عُمَرَ - رَضِيَ اللهُ عَنْهُ - طُعِنَ فِي السَّحَرِ  ؛ طَعَنَهُ  أَبُو لُؤْلُؤَةَ غُلَامُ الْمُغِيرَةِ بْنِ شُعْبَةَ  ، وَكَانَ مَجُوسِيًّا  "" .","","Al-Mu'jam al-Kabir 77","","عمر بن الخطاب عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن يونس بن يزيدالأيلي عن يحيى بن أيوب الغافقي عن عمرو بن الربيع بن طارق الهلالي عن يحيى بن عثمان بن صالح عن الطبراني","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"78","78  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ جَابِرِ بْنِ الْبُحْتُرِيِّ الْحِمْصِيُّ  ، حَدَّثَنَا  بِشْرُ بْنُ شُعَيْبِ بْنِ أَبِي حَمْزَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ -  رَضِيَ اللهُ عَنْهُمَا - قَالَ :  لَمَّا طُعِنَ  عُمَرُ  أَرْسَلُوا إِلَى طَبِيبٍ  ، فَجَاءَ رَجُلٌ مِنَ الْأَنْصَارِ فَسَقَاهُ لَبَنًا ، فَخَرَجَ اللَّبَنُ أَبْيَضَ مِنَ الطَّعْنَةِ الَّتِي تَحْتَ السُّرَّةِ ، فَقَالَ لَهُ الطَّبِيبُ : اعْهَدْ عَهْدَكَ فَمَا أَرَاكَ تُمْسِي ، فَقَالَ : صَدَقَنِي  "" .","","Al-Mu'jam al-Kabir 78","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن شعيب بن أبي حمزة الحمصي عن بشر بن شعيب بن أبي حمزة عن عبد الرحمن بن جابر الطائي عن الطبراني","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"79","79  -  حَدَّثَنَا  الْقَاسِمُ بْنُ زَكَرِيَّا الْمُطَرِّزُ  ، ثَنَا  يُوسُفُ بْنُ مُوسَى الْقَطَّانُ ،  ثَنَا  سَلَمَةُ بْنُ الْفَضْلِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنِي  عَمِّي عَبْدُ الرَّحْمَنِ بْنُ يَسَارٍ ، قَالَ :  شَهِدْتُ  مَوْتَ عُمَرَ بْنِ الْخَطَّابِ - رَضِيَ اللهُ عَنْهُ  - فَانْكَسَفَتِ الشَّمْسُ يَوْمَئِذٍ  "" .","","Al-Mu'jam al-Kabir 79","","عمر بن الخطاب عن عبد الرحمن بن يسار القرشي عن محمد بن إسحاق عن سلمة بن الفضل الأبرش عن يوسف بن موسى بن راشد عن القاسم بن زكريا المطرز عن الطبراني","سن عمر ووفاته وفي سنه اختلاف رضي الله عنه"
"80","وَمَا أَسْنَدَ  عُمَرُ بْنُ الْخَطَّابِ  رَضِيَ اللهُ عَنْهُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  80  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُعَلَّى بْنُ أَسَدٍ الْعَمِّيُّ ،  ثَنَا  وُهَيْبٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  عُمَرَ  - رَضِيَ اللهُ عَنْهُمَا -  أَنَّهُ سَأَلَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَيَنَامُ أَحَدُنَا وَهُوَ  جُنُبٌ  ؟ قَالَ :  نَعَمْ ، وَيَتَوَضَّأُ وُضُوءَهُ لِلصَّلَاةِ  .","","Al-Mu'jam al-Kabir 80","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن وهيب بن خالد الكرابيسي عن معلى بن أسد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","وما أسند عمر بن الخطاب رضي الله عنه عن رسول الله صلى الله عليه وسلم"
"81","81  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُبَارَكِ الْعَيْشِيُّ ،  ثَنَا  وُهَيْبٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  عُمَرَ  - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  سَمِعَنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا أَقُولُ : وَأَبِي ، فَقَالَ :  إِنَّ اللهَ - عَزَّ وَجَلَّ - يَنْهَاكُمْ أَنْ تَحْلِفُوا بِآبَائِكُمْ  .","","Al-Mu'jam al-Kabir 81","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن وهيب بن خالد الكرابيسي عن عبد الرحمن بن المبارك الخلقاني عن معاذ بن المثنى العنبري عن الطبراني","وما أسند عمر بن الخطاب رضي الله عنه عن رسول الله صلى الله عليه وسلم"
"82","[1/72]      82  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  يُونُسُ بْنُ عُبَيْدِ اللهِ الْعُمَيْرِيُّ ،  ثَنَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  عُمَرَ  - رَضِيَ اللهُ عَنْهُمَا - أَنَّهُ قَالَ :  يَا أَيُّهَا النَّاسُ : اتَّهِمُوا الرَّأْيَ عَلَى الدِّينِ  ، فَلَقَدْ رَأَيْتُنِي أَرُدُّ أَمْرَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِرَأْيِي اجْتِهَادًا ، فَوَاللهِ مَا آلُو عَنِ الْحَقِّ وَذَلِكَ يَوْمَ  أَبِي جَنْدَلٍ  ، وَالْكِتَابُ بَيْنَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَهْلِ مَكَّةَ  ، فَقَالَ :  اكْتُبُوا بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ  ، فَقَالُوا : تَرَانَا قَدْ صَدَّقْنَاكَ بِمَا تَقُولُ ؟ وَلَكِنَّكَ تَكْتُبُ بِاسْمِكَ اللَّهُمَّ ، فَرَضِيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَبَيْتُ حَتَّى قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" تَرَانِي أَرْضَى وَتَأْبَى أَنْتَ ؟ "" قَالَ : فَرَضِيتُ  .","","Al-Mu'jam al-Kabir 82","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن مبارك بن فضالة عن يونس بن عبيد الله العميري عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","وما أسند عمر بن الخطاب رضي الله عنه عن رسول الله صلى الله عليه وسلم"
"83","83  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قُلْتُ  لِأَبِي :  مَنِ الرَّجُلُ الَّذِي خَلَّصَكَ مِنَ الْمُشْرِكِينَ يَوْمَ ضَرَبُوكَ  ؟ "" قَالَ : ذَاكَ  الْعَاصُ بْنُ وَائِلٍ السَّهْمِيُّ  .","","Al-Mu'jam al-Kabir 83","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن محمد بن إسحاق عن حماد بن زيد عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","وما أسند عمر بن الخطاب رضي الله عنه عن رسول الله صلى الله عليه وسلم"
"84","84  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  ثُمَامَةَ بْنِ عَبْدِ اللهِ بْنِ أَنَسٍ ،  عَنْ  أَنَسٍ ،  أَنَّ  عُمَرَ - رَضِيَ اللهُ عَنْهُ - خَرَجَ يَسْتَسْقِي ، وَخَرَجَ  بِالْعَبَّاسِ  مَعَهُ يَسْتَسْقِي فَيَقُولُ :  اللَّهُمَّ إِنَّا كُنَّا إِذَا قُحِطْنَا عَلَى عَهْدِ نَبِيِّنَا - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَوَسَّلْنَا إِلَيْكَ بِنَبِيِّنَا  - عَلَيْهِ السَّلَامُ - ، وَإِنَّا نَتَوَسَّلُ إِلَيْكَ بِعَمِّ نَبِيِّنَا - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَرَضِيَ عَنْهُ  "" .","","Al-Mu'jam al-Kabir 84","","عمر بن الخطاب عن أنس بن مالك عن ثمامة بن عبد الله بن أنس بن مالك عن عبد الله بن المثنى عن محمد بن عبد الله بن المثنى الخزرجي عن أبو مسلم الكجي عن الطبراني","وما أسند عمر بن الخطاب رضي الله عنه عن رسول الله صلى الله عليه وسلم"
"85","85  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  النَّضْرُ بْنُ عَبْدِ الْجَبَّارِ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي النَّضْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ، قَالَ :  قَالَ رَجُلٌ مِنْ أَهْلِ الْعِرَاقِ  لِعَبْدِ اللهِ بْنِ عُمَرَ  : قَالَ  ابْنُ عَبَّاسٍ  وَهُوَ عَلَيْنَا أَمِيرٌ : مَنْ أُعْطِيَ بِدِرْهَمٍ مِائَةَ دِرْهَمٍ         [1/73]      فَلْيَأْخُذْهَا ، فَقَالَ  ابْنُ عُمَرَ :  سَمِعْتُ  عُمَرَ بْنَ الْخَطَّابِ  يَقُولُ : كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ عَلَى الْمِنْبَرِ :  الذَّهَبُ بِالذَّهَبِ رِبًا ، إِلَّا مِثْلًا بِمِثْلٍ  ، لَا زِيَادَةَ ، فَمَا زَادَ فَهُوَ رِبًا "" قَالَ  ابْنُ عُمَرَ  فَإِنْ كُنْتَ فِي شَكٍّ فَاسْأَلْ أَبَا سَعِيدٍ الْخُدْرِيَّ عَنْ ذَلِكَ ، فَانْطَلَقَ فَسَأَلَ  أَبَا سَعِيدٍ الْخُدْرِيَّ  فَأَخْبَرَهُ أَنَّهُ سَمِعَ ذَلِكَ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقِيلَ  لِابْنِ عَبَّاسٍ  مَا قَالَ  ابْنُ عُمَرَ  وَأَبُو سَعِيدٍ  فَاسْتَغْفَرَ  ابْنُ عَبَّاسٍ  ، وَقَالَ : هَذَا رَأْيٌ رَأَيْتُهُ .","","Al-Mu'jam al-Kabir 85","","أبو سعيد الخدري عن عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن سالم بن أبي أمية التيمي عن عبد الله بن لهيعة عن النضر بن عبد الجبار المرادي عن المقدام بن داود الرعيني عن الطبراني","وما أسند عمر بن الخطاب رضي الله عنه عن رسول الله صلى الله عليه وسلم"
"86","86  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِي إِسْحَاقَ  ، عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، قَالَ :  قَالَ  ابْنُ عُمَرَ - رَضِيَ اللهُ عَنْهُمَا - :  سَافَرْتُ مَعَ  سَعْدٍ "" فَبَالَ وَتَوَضَّأَ ، وَمَسَحَ عَلَى خُفَّيْهِ  ، ثُمَّ أَمَّ النَّاسَ "" فَعِبْتُ ذَلِكَ عَلَيْهِ ، فَقَالَ : أَتَرْضَى بِأَبِيكَ ؟ قُلْتُ : نَعَمْ ، فَاجْتَمَعْنَا عِنْدَ أَمِيرِ الْمُؤْمِنِينَ ، فَقَالَ لَهُ  سَعْدٌ  : إِنِّي بُلْتُ ثُمَّ تَوَضَّأْتُ فَمَسَحْتُ عَلَى خُفَّيَّ ، ثُمَّ صَلَّيْتُ ،  فَقَالَ  : "" أَحْسَنْتَ وَأَصَبْتَ السُّنَّةَ "" ، قَالَ : إِنَّ ابْنَكَ  عَبْدَ اللهِ  عَابَ ذَلِكَ عَلَيَّ ، فَقَالَ : "" يَا  سَعْدُ  أَنْتَ كُنْتَ أَكْبَرَ مِنْهُ ، وَأَعْلَمَ ""  .","","Al-Mu'jam al-Kabir 86","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن أبو سلمة بن عبد الرحمن عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","وما أسند عمر بن الخطاب رضي الله عنه عن رسول الله صلى الله عليه وسلم"
"87","87  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ اللهِ الْأُوَيْسِيُّ ،  ثَنَا  يَزِيدُ بْنُ عَبْدِ الْمَلِكِ النَّوْفَلِيُّ ،  عَنْ  يَزِيدَ بْنِ خُصَيْفَةَ ،  عَنِ  السَّائِبِ بْنِ يَزِيدَ ،  عَنْ  عُمَرَ بْنِ الْخَطَّابِ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  ثَمَنُ  الْقَيْنَةِ  سُحْتٌ  ، وَغِنَاؤُهَا حَرَامٌ  ، وَالنَّظَرُ إِلَيْهَا حَرَامٌ ، وَثَمَنُهَا مِثْلُ ثَمَنِ الْكَلْبِ ، وَثَمَنُ الْكَلْبِ  سُحْتٌ  ، وَمَنْ نَبَتَ لَحْمُهُ عَلَى  السُّحْتِ  ، فَالنَّارُ أَوْلَى بِهِ  .","","Al-Mu'jam al-Kabir 87","","عمر بن الخطاب عن السائب بن يزيد الكندي عن يزيد بن عبد الله بن خصيفة الكندي عن يزيد بن عبد الملك بن المغيرة النوفلي عن عبد العزيز بن عبد الله الأويسي عن محمد بن الفضل بن جابر السقطى عن الطبراني","وما أسند عمر بن الخطاب رضي الله عنه عن رسول الله صلى الله عليه وسلم"
"88","88  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، أَنَا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ اللهِ ،  ثَنَا  يَزِيدُ بْنُ عَبْدِ الْمَلِكِ ،  عَنْ  يَزِيدَ بْنِ خُصَيْفَةَ ،  عَنِ  السَّائِبِ بْنِ يَزِيدَ ،  عَنْ  عُمَرَ - رَضِيَ اللهُ عَنْهُمَا -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَرَادَ أَنْ يُزَوِّجَ امْرَأَةً مِنْ نِسَائِهِ يَأْتِيهَا         [1/74]      مِنْ وَرَاءِ الْحِجَابِ ، فَيَقُولَ لَهَا :  يَا بُنَيَّةُ ، إِنَّ فُلَانًا قَدْ خَطَبَكِ ، فَإِنْ كَرِهْتِيهِ فَقُولِي لَا ،  فَإِنَّهُ لَا يَسْتَحِي أَحَدٌ أَنْ يَقُولَ لَا ، وَإِنْ أَحْبَبْتِ فَإِنَّ سُكُوتَكِ إِقْرَارٌ  .","","Al-Mu'jam al-Kabir 88","","عمر بن الخطاب عن السائب بن يزيد الكندي عن يزيد بن عبد الله بن خصيفة الكندي عن يزيد بن عبد الملك بن المغيرة النوفلي عن عبد العزيز بن عبد الله الأويسي عن محمد بن الفضل بن جابر السقطى عن الطبراني","وما أسند عمر بن الخطاب رضي الله عنه عن رسول الله صلى الله عليه وسلم"
"89","89  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  حَدَّثَنِي  الصَّعْبُ بْنُ حَكِيمِ بْنِ شَرِيكِ بْنِ نَمْلَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ :  ضِفْتُ  عُمَرَ بْنَ الْخَطَّابِ - رَضِيَ اللهُ عَنْهُ - لَيْلَةً  فَأَطْعَمَنِي  كُسُورًا  مِنْ رَأْسِ بَعِيرٍ بَارِدٍ ، وَأَطْعَمَنَا زَيْتًا ، وَقَالَ : "" هَذَا الزَّيْتُ الْمُبَارَكُ الَّذِي قَالَ اللهُ - عَزَّ وَجَلَّ - لِنَبِيِّهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" .","","Al-Mu'jam al-Kabir 89","","عمر بن الخطاب عن شريك بن نملة أو نميلة الكوفي عن حكيم بن شريك بن نملة الكوفي عن الصعب بن حكيم بن شريك بن نملة الكوفي عن سفيان بن عيينة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","وما أسند عمر بن الخطاب رضي الله عنه عن رسول الله صلى الله عليه وسلم"
"90","3 - نِسْبَةُ  عُثْمَانَ بْنِ عَفَّانَ  - رَضِيَ اللهُ عَنْهُ .  90  -  حَدَّثَنَا  أَحْمَدُ بْنُ شَاهِينَ  ،  ثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ  ، قَالَ : ""  عُثْمَانُ بْنُ عَفَّانَ بْنِ أَبِي الْعَاصِ بْنِ أُمَيَّةَ بْنِ عَبْدِ شَمْسِ بْنِ عَبْدِ مَنَافِ بْنِ قُصَيِّ بْنِ كِلَابِ  بْنِ مُرَّةَ بْنِ كَعْبِ بْنِ لُؤَيِّ بْنِ غَالِبِ بْنِ فِهْرٍ يُكَنَّى أَبَا عَمْرٍو وَيُقَالُ : أَبَا عَبْدِ اللهِ ،  وَأُمُّ عُثْمَانَ بْنِ عَفَّانَ : أَرْوَى بِنْتُ كُرَيْزِ بْنِ رَبِيعَةَ بْنِ حَبِيبِ بْنِ عَبْدِ شَمْسٍ  ،  وَأُمُّ أَرْوَى : أُمُّ حَكِيمٍ الْبَيْضَاءُ بِنْتُ عَبْدِ الْمُطَّلِبِ عَمَّةُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  وَأُمُّ أُمِّ حَكِيمٍ : فَاطِمَةُ بِنْتُ عَمْرِو بْنِ عَائِذِ بْنِ عِمْرَانَ بْنِ مَخْزُومٍ ، وَهِيَ جَدَّةُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ أَبِيهِ  ""  .","","Al-Mu'jam al-Kabir 90","","","نسبة عثمان بن عفان رضي الله عنه"
"91","91  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ مُحَمَّدِ بْنِ أَبِي بَكْرٍ الْمُقَدَّمِيُّ الْقَاضِي ،  ثَنَا  عَبْدُ اللهِ بْنُ شَبِيبٍ الْمَدَنِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ يَحْيَى الشَّجَرِيُّ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  خَازِمِ بْنِ حُسَيْنٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ         [1/75]      عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  أَسْلَمَتْ أُمُّ عُثْمَانَ - رَضِيَ اللهُ عَنْهُمَا -  أَرْوَى بِنْتُ كُرَيْزٍ  "" .","","Al-Mu'jam al-Kabir 91","","عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن عبد الله بن أبي بكر بن محمد  ابن حزم عن خازم بن الحسين الحميسي عن يحيى بن محمد بن عباد الشجري عن إبراهيم بن يحيى الشجري عن عبد الله بن شبيب الربعي عن محمد بن أحمد بن محمد المقدمي عن الطبراني","نسبة عثمان بن عفان رضي الله عنه"
"92","صِفَةُ  عُثْمَانَ بْنِ عَفَّانَ  وَسِنُّهُ رَضِيَ اللهُ عَنْهُ  92  -  حَدَّثَنَا  أَبُو يَزِيدَ يُوسُفُ بْنُ يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  ابْنُ لَهِيعَةَ ،  ثَنَا  أَبُو الْأَسْوَدِ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادِ بْنِ الْهَادِ ، قَالَ :  رَأَيْتُ  عُثْمَانَ بْنَ عَفَّانَ - رَضِيَ اللهُ عَنْهُ - يَوْمَ الْجُمُعَةِ عَلَى الْمِنْبَرِ  ، عَلَيْهِ إِزَارٌ عَدَنِيٌّ غَلِيظٌ ، ثَمَنُهُ أَرْبَعَةُ دَرَاهِمَ أَوْ خَمْسَةٌ ،  وَرَيْطَةٌ  كُوفِيَّةٌ  مُمَشَّقَةٌ  ، ضَرْبُ اللَّحْمِ ، طَوِيلُ اللِّحْيَةِ ، حَسَنُ الْوَجْهِ  "" .","","Al-Mu'jam al-Kabir 92","","عثمان بن عفان عن عبد الله بن شداد بن الهاد الليثي عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","صفة عثمان بن عفان وسنه رضي الله عنه"
"93","93  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  خَالِدُ بْنُ نِزَارٍ ،  ثَنَا  إِسْحَاقُ بْنُ يَحْيَى بْنِ طَلْحَةَ ،  عَنْ  عَمِّهِ مُوسَى بْنِ طَلْحَةَ ، قَالَ :  كَانَ عُثْمَانُ - رَضِيَ اللهُ عَنْهُ - ، يَوْمَ الْجُمُعَةِ يَتَوَكَّأُ عَلَى عَصًا ، وَكَانَ أَجْمَلَ النَّاسِ  ، وَعَلَيْهِ ثَوْبَانِ أَصْفَرَانِ ، إِزَارٌ ، وَرِدَاءٌ حَتَّى يَأْتِيَ الْمِنْبَرَ ، فَيَجْلِسَ عَلَيْهِ  "" .","","Al-Mu'jam al-Kabir 93","","عثمان بن عفان عن موسى بن طلحة بن عبيد الله التيمي عن إسحاق بن يحيى بن طلحة التيمي عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","صفة عثمان بن عفان وسنه رضي الله عنه"
"94","94  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  الرَّبِيعُ بْنُ بَدْرٍ ،  عَنِ  الْجُرَيْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ حَزْمٍ الْمَازِنِيِّ ، قَالَ :  رَأَيْتُ  عُثْمَانَ بْنَ عَفَّانَ - رَضِيَ اللهُ عَنْهُ - ، فَمَا رَأَيْتُ قَطُّ ذَكَرًا ،  وَلَا أُنْثَى أَحْسَنَ وَجْهًا مِنْهُ  "" .","","Al-Mu'jam al-Kabir 94","","عثمان بن عفان عن عبد الله بن حزم المازني عن سعيد بن إياس الجريري عن الربيع بن بدر عليلة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","صفة عثمان بن عفان وسنه رضي الله عنه"
"95","95  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الْعَزِيزِ الْبَغَوِيُّ ،  ثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  ثَنَا  سَلَمَةُ بْنُ بَشِيرٍ ،  حَدَّثَنَا  حُجْرُ بْنُ الْحَارِثِ الْغَسَّانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَوْفٍ الْقَارِيُّ ، قَالَ :  رَأَيْتُ  عُثْمَانَ بْنَ عَفَّانَ - رَضِيَ اللهُ عَنْهُ - ، أَبْيَضَ اللِّحْيَةِ  "" .","","Al-Mu'jam al-Kabir 95","","عثمان بن عفان عن عبد الله بن عوف الكناني عن حجر بن الحارث الغساني عن سلمة بن بشر بن صيفي الشامي عن داود بن رشيد الخوارزمي عن أبو القاسم البغوي عن الطبراني","صفة عثمان بن عفان وسنه رضي الله عنه"
"96","96  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنْ         [1/76]      عَبْدِ الرَّحْمَنِ بْنِ سَعْدٍ ، قَالَ :  رَأَيْتُ  عُثْمَانَ بْنَ عَفَّانَ - رَضِيَ اللهُ عَنْهُ - ، أَصْفَرَ اللِّحْيَةِ  "" .","","Al-Mu'jam al-Kabir 96","","عثمان بن عفان عن عبد الرحمن بن سعد مولى الأسود بن سفيان عن محمد بن عبد الرحمن بن المغيرة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","صفة عثمان بن عفان وسنه رضي الله عنه"
"97","97  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  ثَنَا  مَوْلًى لِعُثْمَانَ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ :  بَعَثَنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى  عُثْمَانَ  - رَضِيَ اللهُ عَنْهُ - ، بِصَحْفَةٍ فِيهَا لَحْمٌ ، فَدَخَلْتُ عَلَيْهِ ،  وَرُقَيَّةُ  جَالِسَةٌ ، فَمَا رَأَيْتُ اثْنَيْنِ أَحْسَنَ مِنْهُمَا - رَضِيَ اللهُ عَنْهُمَا - ، فَجَعَلْتُ مَرَّةً أَنْظُرُ إِلَى  رُقَيَّةَ  ، وَمَرَّةً أَنْظُرُ إِلَى  عُثْمَانَ  ، فَلَمَّا رَجَعْتُ ، قَالَ لِيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَدَخَلْتَ عَلَيْهِمَا ؟ "" قُلْتُ : نَعَمْ ، قَالَ :  هَلْ رَأَيْتَ زَوْجًا أَحْسَنَ مِنْهُمَا  ، قُلْتُ : لَا يَا رَسُولَ اللهِ ، لَقَدْ جَعَلْتُ أَنْظُرُ مَرَّةً إِلَى  رُقَيَّةَ  وَمَرَّةً إِلَى  عُثْمَانَ  ، قَالَ أَبُو الْقَاسِمِ رَحِمَهُ اللهُ :  وَهَذَا كَانَ قَبْلَ نُزُولِ آيَةِ الْحِجَابِ  .","","Al-Mu'jam al-Kabir 97","","أسامة بن زيد بن حارثة ذو البطين عن مولى لعثمان عن حماد بن زيد عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","صفة عثمان بن عفان وسنه رضي الله عنه"
"98","98  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ عَبْدِ اللهِ ، وَلَدُ قَيْسِ بْنِ مَخْرَمَةَ بْنِ الْمُطَّلِبِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عُثْمَانَ الْقُرَشِيِّ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ عَلَى ابْنَتِهِ وَهِيَ تَغْسِلُ رَأْسَ  عُثْمَانَ  - رَضِيَ اللهُ عَنْهُمَا - ، فَقَالَ :  يَا بُنَيَّةُ : أَحْسِنِي إِلَى  أَبِي عَبْدِ اللهِ  فَإِنَّهُ أَشْبَهُ أَصْحَابِي بِي  خُلُقًا  .","","Al-Mu'jam al-Kabir 98","","عبد الرحمن بن عثمان بن إبراهيم الحاطبي عن عبد الملك بن عبد الله ولد قيس بن مخرمة بن المطلب عن أحمد بن عبد الله اليربوعي عن محمد بن عثمان بن أبي شيبة عن الطبراني","صفة عثمان بن عفان وسنه رضي الله عنه"
"99","99  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الْعَسْكَرِيُّ الرَّازِيُّ ،  ثَنَا  الْخَلِيلُ بْنُ عَمْرٍو  عَنْ  مُحَمَّدِ بْنِ سَلَمَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحِيمِ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ عَبْدِ الْمُطَّلِبِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِي هُرَيْرَةَ - رَضِيَ اللهُ عَنْهُ - ، قَالَ :  دَخَلْتُ عَلَى  رُقَيَّةَ  بِنْتِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، امْرَأَةِ  عُثْمَانَ  - رَضِيَ اللهُ عَنْهُ - ، وَفِي يَدِهَا مُشْطٌ ، فَقَالَتْ : خَرَجَ مِنْ عِنْدِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - آنِفًا رَجَّلْتُ رَأْسَهُ ، فَقَالَ :         [1/77]      كَيْفَ تَجِدِينَ  أَبَا عَبْدِ اللهِ  ؟ "" قُلْتُ : بِخَيْرٍ ، قَالَ :  أَكْرِمِيهِ فَإِنَّهُ مِنْ أَشْبَهِ أَصْحَابِي بِي  خُلُقًا  .","","Al-Mu'jam al-Kabir 99","","أبو هريرة الدوسي عن محمد بن عبد الله بن عبد المطلب بن عبد الله عن زيد بن أبي أنيسة الجزري عن خالد بن يزيد الحراني عن محمد بن سلمة الباهلي عن الخليل بن عمرو البغوي عن علي بن سعيد بن عبد الله شقير عن الطبراني","صفة عثمان بن عفان وسنه رضي الله عنه"
"100","سِنُّ  عُثْمَانَ  وَوَفَاتُهُ رَضِيَ اللهُ عَنْهُ  100  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ التَّيْمِيِّ ، (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ قَالَ :  قُتِلَ عُثْمَانُ بْنُ عَفَّانَ - رَضِيَ اللهُ عَنْهُ - ، فِي أَوْسَطِ أَيَّامِ  التَّشْرِيقِ  "" .","","Al-Mu'jam al-Kabir 100","","عثمان بن عفان عن أبو عثمان النهدي عن سليمان بن طرخان عن معتمر بن سليمان عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"101","101  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، قَالَ :  سَمِعْتُ  الزُّبَيْرَ بْنَ بَكَّارٍ  ، يَقُولُ : ""  قُتِلَ  عُثْمَانُ بْنُ عَفَّانَ  - رَضِيَ اللهُ عَنْهُ - ، يَوْمَ الْجُمُعَةِ لِثَمَانِ عَشْرَةَ خَلَتْ مِنْ ذِي الْحِجَّةِ  ، سَنَةَ سِتٍّ وَثَلَاثِينَ بَعْدَ الْعَصْرِ ، وَهُوَ ابْنُ اثْنَيْنِ وَثَمَانِينَ سَنَةً ، وَكَانَ يَوْمَئِذٍ صَائِمًا  "" .","","Al-Mu'jam al-Kabir 101","","","سن عثمان ووفاته رضي الله عنه"
"102","102  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ الْمِصْرِيُّ  ،  ثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّقِّيُّ  ،  ثَنَا  عَبْدُ اللهِ بْنُ عَمْرٍو  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ  ، قَالَ : ""  قُتِلَ  عُثْمَانُ  - رَضِيَ اللهُ عَنْهُ - ، سَنَةَ خَمْسٍ وَثَلَاثِينَ  "" .","","Al-Mu'jam al-Kabir 102","","","سن عثمان ووفاته رضي الله عنه"
"103","103  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى  ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ  ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَمْرٍو  ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ  ، قَالَ : ""  قُتِلَ  عُثْمَانُ  - رَضِيَ اللهُ عَنْهُ - سَنَةَ خَمْسٍ وَثَلَاثِينَ  "" .","","Al-Mu'jam al-Kabir 103","","","سن عثمان ووفاته رضي الله عنه"
"104","[1/78]      104  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  الْحَسَنُ بْنُ مُوسَى ،  ثَنَا  أَبُو هِلَالٍ ،  عَنْ  قَتَادَةَ ، قَالَ :  قُتِلَ عُثْمَانُ وَهُوَ  ابْنُ تِسْعِينَ أَوْ ثَمَانٍ وَثَمَانِينَ  "" .","","Al-Mu'jam al-Kabir 104","","عثمان بن عفان عن قتادة بن دعامة عن محمد بن سليم الراسبي عن الحسن بن موسى الأشيب عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"105","105  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ  ، قَالَ : ""  قُتِلَ  عُثْمَانُ  - رَضِيَ اللهُ عَنْهُ - ، سَنَةَ خَمْسٍ وَثَلَاثِينَ  "" .","","Al-Mu'jam al-Kabir 105","","","سن عثمان ووفاته رضي الله عنه"
"106","106  - حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ  ، حَدَّثَنِي  اللَّيْثُ  ، حَدَّثَنِي  عَبْدُ اللهِ بْنُ عُمَرَ  ، عَنِ  ابْنِ شِهَابٍ  ، عَنِ  الْمِسْوَرِ بْنِ مَخْرَمَةَ  ، قَالَ : ""  كَانَتْ خِلَافَةُ  عُثْمَانَ  - رَضِيَ اللهُ عَنْهُ - ، ثِنْتَيْ عَشْرَةَ سَنَةً  "" .","","Al-Mu'jam al-Kabir 106","","","سن عثمان ووفاته رضي الله عنه"
"107","107  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ، قَالَ : ""  كَانَتِ الشُّورَى فَاجْتَمَعَ النَّاسُ عَلَى  عُثْمَانَ  - رَضِيَ اللهُ عَنْهُ  - ، لِثَلَاثٍ بَقِينَ مِنْ ذِي الْحِجَّةِ ، سَنَةَ ثَلَاثٍ وَعِشْرِينَ ، ثُمَّ قُتِلَ  عُثْمَانُ  يَوْمَ الْجُمُعَةِ لِثَمَانِ عَشْرَةَ خَلَتْ مِنْ ذِي الْحِجَّةِ ، تَمَامَ سَنَةِ خَمْسٍ وَثَلَاثِينَ ، وَسِنُّهُ ثَمَانٍ وَثَمَانُونَ سَنَةً ، وَكَانَ يُصَفِّرُ لِحْيَتَهُ ، وَكَانَتْ وِلَايَةُ  عُثْمَانَ  - رَضِيَ اللهُ عَنْهُ - ، ثِنْتَيْ عَشْرَةَ سَنَةً  "" .","","Al-Mu'jam al-Kabir 107","","","سن عثمان ووفاته رضي الله عنه"
"108","108  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  الْحَسَنُ بْنُ مُوسَى ،  ثَنَا  أَبُو هِلَالٍ ،  ثَنَا  قَتَادَةُ  أَنَّ  عُثْمَانَ - رَضِيَ اللهُ عَنْهُ - قُتِلَ  وَهُوَ  ابْنُ تِسْعِينَ ، أَوْ ثَمَانٍ وَثَمَانِينَ سَنَةً  "" .","","Al-Mu'jam al-Kabir 108","","عثمان بن عفان عن قتادة بن دعامة عن محمد بن سليم الراسبي عن الحسن بن موسى الأشيب عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"109","109  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ الْمِصْرِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الْحَكَمِ ،  ثَنَا  عَبْدُ الْمَلِكِ الْمَاجِشُونُ ، قَالَ :  سَمِعْتُ  مَالِكًا ، يَقُولُ :  قُتِلَ عُثْمَانُ - رَضِيَ اللهُ عَنْهُ - ، فَأَقَامَ مَطْرُوحًا عَلَى كُنَاسَةِ بَنِي فُلَانٍ         [1/79]      ثَلَاثًا  ، فَأَتَاهُ اثَنَا عَشَرَ رَجُلًا ، فِيهِمْ جَدِّي  مَالِكُ بْنُ أَبِي عَامِرٍ  ،  وَحُوَيْطِبُ بْنُ عَبْدِ الْعُزَّى  ،  وَحَكِيمُ بْنُ حِزَامٍ  ،  وَعَبْدُ اللهِ بْنُ الزُّبَيْرِ  ،  وَعَائِشَةُ بِنْتُ عُثْمَانَ  ، مَعَهُمْ مِصْبَاحٌ فِي حِقٍّ فَحَمَلُوهُ عَلَى بَابٍ ، وَإِنَّ رَأْسَهُ يَقُولُ عَلَى الْبَابِ طَقْ طَقْ حَتَّى أَتَوْا بِهِ  الْبَقِيعَ  ، فَاخْتَلَفُوا فِي الصَّلَاةِ عَلَيْهِ ، فَصَلَّى عَلَيْهِ  حَكِيمُ بْنُ حِزَامٍ  أَوْ  حُوَيْطِبُ بْنُ عَبْدِ الْعُزَّى  -  شَكَّ  عَبْدُ الرَّحْمَنِ  - ثُمَّ أَرَادُوا دَفْنَهُ ، فَقَامَ رَجُلٌ مِنْ بَنِي مَازِنٍ فَقَالَ : وَاللهِ لَئِنْ دَفَنْتُمُوهُ مَعَ الْمُسْلِمِينَ ، لَأُخْبِرَنَّ النَّاسَ ، فَحَمَلُوهُ حَتَّى أَتَوْا بِهِ إِلَى  حَشِّ  كَوْكَبٍ  ، فَلَمَّا دَلُّوهُ فِي قَبْرِهِ صَاحَتْ  عَائِشَةُ بِنْتُ عُثْمَانَ  ، فَقَالَ لَهَا  ابْنُ الزُّبَيْرِ  : اسْكُتِي فَوَاللهِ لَئِنْ عُدْتِ لَأَضْرِبَنَّ الَّذِي فِيهِ عَيْنَاكِ ، فَلَمَّا دَفَنُوهُ وَسَوَّوْا عَلَيْهِ التُّرَابَ قَالَ لَهَا  ابْنُ الزُّبَيْرِ  : صِيحِي مَا بَدَا لَكِ أَنْ تَصِيحِي ، قَالَ  مَالِكٌ  وَكَانَ  عُثْمَانُ بْنُ عَفَّانَ  - رَضِيَ اللهُ عَنْهُ - ، قَبْلَ ذَلِكَ يَمُرُّ  بِحُشِّ  كَوْكَبٍ  فَيَقُولُ : لَيُدْفَنَنَّ هَاهُنَا رَجُلٌ صَالِحٌ  "" ،  قَالَ أَبُو الْقَاسِمِ : ""  الْحُشُّ : الْبُسْتَانُ  "" .","","Al-Mu'jam al-Kabir 109","","عثمان بن عفان عن مالك بن أنس عن عبد الملك بن عبد العزيز الماجشون عن عبد الرحمن بن عبد الله المصري عن عمرو بن أبي الطاهر المصري عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"110","110  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ الضَّحَّاكِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  أَنَا  مُحَمَّدُ بْنُ يَزِيدَ الرَّحَبِيُّ ،  ثَنَا  سَهْمُ بْنُ حُبَيْشٍ - وَكَانَ مِمَّنْ شَهِدَ قَتْلَ عُثْمَانَ - قَالَ :  فَلَمَّا أَمْسَيْنَا قُلْتُ :  لَئِنْ تَرَكْتُمْ صَاحِبَكُمْ حَتَّى يُصْبِحَ مَثَّلُوا بِهِ  ، فَانْطَلِقُوا بِهِ إِلَى  بَقِيعِ الْغَرْقَدِ  فَأَمْكَنَّا لَهُ مِنْ  جَوْفِ  اللَّيْلِ ، ثُمَّ حَمَلْنَاهُ وَغَشِيَنَا سَوَادٌ مِنْ خَلْفِنَا ، فَهِبْنَاهُمْ حَتَّى كِدْنَا أَنْ نَتَفَرَّقَ عَنْهُ ، فَنَادَى مُنَادٍ : لَا رَوْعَ عَلَيْكُمُ ، اثْبُتُوا ، فَإِنَّا قَدْ جِئْنَا لِنَشْهَدَهُ مَعَكُمْ ، وَكَانَ  ابْنُ حُبَيْشٍ  يَقُولُ : هُمْ وَاللهِ الْمَلَائِكَةُ  "" .","","Al-Mu'jam al-Kabir 110","","عثمان بن عفان عن سهم بن حبيش الشامي عن محمد بن يزيد الرحبي عن إسماعيل بن عياش الأحول عن عبد الوهاب بن الضحاك عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"111","111  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ الْمِصْرِيُّ ،  ثَنَا  عَبْدُ الْمُنْعِمِ بْنُ بَشِيرٍ الْأَنْصَارِيُّ ،  ثَنَا  عَلِيُّ بْنُ غُرَابٍ الْمُحَارِبِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ سَعِيدٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنَّا جُلُوسًا عِنْدَ عَلِيِّ بْنِ أَبِي طَالِبٍ - رَضِيَ اللهُ عَنْهُ - ، وَعَنْ يَمِينِهِ  عَمَّارُ         [1/80]      بْنُ يَاسِرٍ  ، وَعَنْ يَسَارِهِ  مُحَمَّدُ بْنُ أَبِي بَكْرٍ  ، إِذْ جَاءَ  غُرَابُ بْنُ فُلَانٍ الصَّيْدَنِيُّ  فَقَالَ : يَا أَمِيرَ الْمُؤْمِنِينَ ، مَا تَقُولُ فِي  عُثْمَانَ  ؟ فَبَدَرَهُ الرَّجُلَانِ ، فَقَالَا : عَمَّ تَسْأَلُ ؟ عَنْ رَجُلٍ كَفَرَ بِاللهِ مِنْ بَعْدِ إِيمَانِهِ وَنَافَقَ ؟ فَقَالَ الرَّجُلُ لَهُمَا : لَسْتُ إِيَّاكُمَا أَسْأَلُ ، وَلَا إِلَيْكُمَا جِئْتُ ،  فَقَالَ لَهُ  عَلِيٌّ  : "" لَسْتُ أَقُولُ مَا قَالَا "" ، فَقَالَا لَهُ جَمِيعًا : فِلِمَ قَتَلْنَاهُ إِذًا ؟ قَالَ :  وُلِّيَ عَلَيْكُمْ فَأَسَاءَ الْوَلَايَةَ فِي آخِرِ أَيَّامِهِ ، وَجَزَعْتُمْ ، فَأَسَأْتُمُ الْجَزَعَ  ، وَاللهِ إِنِّي لَأَرْجُو أَنْ أَكُونَ أَنَا  وَعُثْمَانُ  كَمَا قَالَ اللهُ - عَزَّ وَجَلَّ - :         {      وَنَـزَعْنَا مَا فِي صُدُورِهِمْ مِنْ غِلٍّ إِخْوَانًا عَلَى سُرُرٍ مُتَقَابِلِينَ         }      .","","Al-Mu'jam al-Kabir 111","","علي بن أبي طالب عن سعيد بن أبي هند الفزاري عن عبد الله بن سعيد بن أبي هند الفزاري عن علي بن عبد العزيز الفزاري عن عبد المنعم بن بشير الأنصاري عن عمرو بن أبي الطاهر المصري عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"112","112  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  مُجَالِدُ بْنُ سَعِيدٍ ،  عَنْ  عُمَيْرِ بْنِ زَوْدِيٍّ  ، قَالَ :  خَطَبَ عَلِيٌّ - رَضِيَ اللهُ عَنْهُ - النَّاسَ فَقَالَ :  يَا أَيُّهَا النَّاسُ : إِنَّهُ وَاللهِ لَئِنْ لَمْ يَدْخُلِ النَّارَ إِلَّا مَنْ قَتَلَ  عُثْمَانَ  ، لَا أَدْخُلُهَا  ، وَلَئِنْ لَمْ يَدْخُلِ الْجَنَّةَ إِلَّا مَنْ قَتَلَ  عُثْمَانَ  لَا أَدْخُلُهَا "" ، قَالَ : فَلَمَّا نَزَلَ قِيلَ لَهُ : تَكَلَّمْتَ بِكَلِمَةٍ فَرَّقْتَ عَلَيْكَ بِهَا أَصْحَابَكَ ، فَخَطَبَهُمْ ، فَقَالَ : "" يَا أَيُّهَا النَّاسُ أَلَا إِنَّ اللهَ - عَزَّ وَجَلَّ - قَتَلَ  عُثْمَانَ  وَأَنَا مَعَهُ  "" .  قَالَ  حَمَّادٌ  ،  وَحَدَّثَنَا  حَبِيبُ بْنُ الشَّهِيدِ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ "" قَالَ :  كَلِمَةٌ قُرَشِيَّةٌ لَهَا وَجْهَانِ  "" .  قَالَ أَبُو الْقَاسِمِ :  كَأَنَّهُ يَعْنِي "" أَنَّ اللهَ تَعَالَى قَتَلَهُ وَأَنَا مَعَهُ مَقْتُولٌ - رَضِيَ اللهُ عَنْهُمَا  -  "" .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( زوذي )","","Al-Mu'jam al-Kabir 112","","علي بن أبي طالب عن عمير بن زوذي عن مجالد بن سعيد عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"113","113  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  مُجَالِدُ بْنُ سَعِيدٍ ،  عَنْ  عُمَيْرِ بْنِ زَوْدِيٍّ ، قَالَ :  خَطَبَهُمْ  عَلِيٌّ - رَضِيَ اللهُ عَنْهُ - ، فَقَطَعُوا عَلَيْهِ خُطْبَتَهُ ، فَقَالَ :  إِنَّمَا  وَهَنْتُ  يَوْمَ قُتِلَ  عُثْمَانُ  - رَضِيَ اللهُ عَنْهُ  - ، وَضَرَبَ لَهُمْ         [1/81]      مَثَلًا ، مَثَلَ ثَلَاثَةِ أَثْوَارٍ وَأَسَدٍ ، اجْتَمَعْنَ فِي أَجَمَةٍ أَسْوَدَ وَأَحْمَرَ وَأَبْيَضَ ، وَكَانَ الْأَسَدُ إِذَا أَرَادَ وَاحِدًا مِنْهُنَّ اجْتَمَعْنَ عَلَيْهِ فَامْتَنَعْنَ عَلَيْهِ ، فَقَالَ الْأَسَدُ لِلْأَسْوَدِ وَالْأَحْمَرِ : إِنَّمَا يَفْضَحُنَا فِي أَجَمَتِنَا ، وَيُشْهِرُنَا هَذَا الْأَبْيَضُ ، فَدَعَانِي حَتَّى آكُلَهُ ، فَلَوْنُكُمَا عَلَى لَوْنِي ، وَلَوْنِي عَلَى لَوْنِكُمَا ، فَحَمَلَ عَلَيْهِ الْأَسَدُ ، فَلَمْ يَلْبَثْ أَنْ قَتَلَهُ ، ثُمَّ قَالَ لِلْأَسْوَدِ : إِنَّمَا يَفْضَحُنَا وَيُشْهِرُنَا فِي أَجَمَتِنَا هَذَا الْأَحْمَرُ ، فَدَعْنِي حَتَّى آكُلَهُ ، فَلَوْنِي عَلَى لَوْنِكَ ، وَلَوْنُكَ عَلَى لَوْنِي ، فَحَمَلَ عَلَيْهِ فَقَتَلَهُ ، ثُمَّ قَالَ لِلْأَسْوَدِ : إِنِّي آكِلُكَ قَالَ : دَعْنِي أُصَوِّتُ ثَلَاثَةَ أَصْوَاتٍ ، فَقَالَ : أَلَا إِنَّمَا أُكِلْتُ يَوْمَ أُكِلَ الْأَبْيَضُ ، أَلَا إِنَّمَا أُكِلْتُ يَوْمَ أُكِلَ الْأَبْيَضُ ، أَلَا إِنَّمَا أُكِلْتُ يَوْمَ أُكِلَ الْأَبْيَضُ ، أَلَا إِنَّمَا  وَهَنْتُ  يَوْمَ قُتِلَ  عُثْمَانُ  "" .","","Al-Mu'jam al-Kabir 113","","علي بن أبي طالب عن عمير بن زوذي عن مجالد بن سعيد عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"114","114  -  حَدَّثَنَا أَبُو خَلِيفَةَ ،  حَدَّثَنَا  أَبُو عُمَرَ ، حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ،  ثَنَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  ثَنَا  مُجَالِدٌ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  لَقِيَ  مَسْرُوقٌ  الْأَشْتَرَ  ، فَقَالَ  مَسْرُوقٌ  لِلْأَشْتَرِ  : "" قَتَلْتُمْ  عُثْمَانَ  ؟ "" قَالَ : نَعَمْ ، قَالَ : "" أَمَا وَاللهِ لَقَدْ قَتَلْتُمُوهُ صَوَّامًا قَوَّامًا "" ، قَالَ : فَانْطَلَقَ  الْأَشْتَرُ  فَأَخْبَرَ عَمَّارًا - رَضِيَ اللهُ عَنْهُ - ، فَأَتَى  عَمَّارٌ  مَسْرُوقًا  ، فَقَالَ :  وَاللهِ لَيُجْلَدَنَّ  عَمَّارٌ  ، وَلَيُسَيِّرَنَّ  أَبَا ذَرٍّ  ، وَلَيَحْمِيَنَّ الْحِمَى ، وَتَقُولُ : قَتَلْتُمُوهُ صَوَّامًا قَوَّامًا  ،  فَقَالَ لَهُ  مَسْرُوقٌ :  فَوَاللهِ مَا فَعَلْتُمْ وَاحِدًا مِنْ ثِنْتَيْنِ ، مَا عَاقَبْتُمْ بِمِثْلِ مَا عُوقِبْتُمْ بِهِ  ، وَمَا صَبَرْتُمْ فَهُوَ خَيْرٌ لِلصَّابِرِينَ "" ، قَالَ : فَكَأَنَّمَا أَلْقَمَهُ حَجَرًا قَالَ : وَقَالَ  الشَّعْبِيُّ  : "" وَمَا وَلَدَتْ هَمْدَانِيَّةٌ مِثْلَ  مَسْرُوقٍ  "" .","","Al-Mu'jam al-Kabir 114","","مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن الحسن بن أبي جعفر الجفري عن حفص بن عمر الحوضى عن الفضل بن الحباب الجمحي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"115","115  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ حُمَيْدٍ الطَّوِيلُ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ عَلْقَمَةَ بْنِ وَقَّاصٍ  قَالَ :  اجْتَمَعْنَا فِي دَارِ  مَخْرَمَةَ  بَعْدَمَا قُتِلَ  عُثْمَانُ  - رَضِيَ اللهُ عَنْهُ - نُرِيدُ الْبَيْعَةَ ،  فَقَالَ  أَبُو جَهْمِ بْنُ حُذَيْفَةَ :  إِنَّا مَنْ بَايَعَنَا مِنْكُمْ فَإِنَّا لَا نَحُولُ دُونَ قِصَاصٍ  ، فَقَالَ         [1/82]      عَمَّارُ بْنُ يَاسِرٍ  : أَمَّا مِنْ دَمِ  عُثْمَانَ  فَلَا ، فَقَالَ  أَبُو جَهْمٍ  : يَا  ابْنَ سُمَيَّةَ  وَاللهِ لَتُقَادَنَّهُ مِنْ جَلَدَاتٍ جُلِدْتَهَا ، وَلَا يُقَادُ لِدَمِ  عُثْمَانَ  - رَضِيَ اللهُ عَنْهُ - فَانْصَرَفُوا يَوْمَئِذٍ عَنْ غَيْرِ بَيْعَةٍ  "" .","","Al-Mu'jam al-Kabir 115","","أبو الجهم بن حذيفة القرشي عن علقمة بن وقاص العتواري عن عمرو بن علقمة بن وقاص الليثي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن حماد بن سلمة عن أحمد بن يحيى بن حميد الطويل عن الفضل بن الحباب الجمحي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"116","116  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْحَسَنِ الْعَطَّارُ الْبَصْرِيُّ ،  ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  أَنَا  ابْنُ عَوْنٍ ،  عَنِ  الْحَسَنِ ، قَالَ :  أَخْبَرَنِي  وَثَّابٌ ، وَكَانَ مِمَّنْ أَدْرَكَهُ عِتْقُ  عُثْمَانَ  - رَضِيَ اللهُ عَنْهُ - ، فَكَانَ يَقُومُ بَيْنَ يَدَيْ  عُثْمَانَ  ، قَالَ :  بَعَثَنِي  عُثْمَانُ فَدَعَوْتُ لَهُ  الْأَشْتَرَ  - فَقَالَ  ابْنُ عَوْنٍ  :  فَأَظُنُّهُ قَالَ : فَطَرَحْتُ لِأَمِيرِ الْمُؤْمِنِينَ وِسَادَةً  ، وَلَهُ وِسَادَةٌ - فَقَالَ :  يَا  أَشْتَرُ  مَا يُرِيدُ النَّاسُ مِنِّي ؟  قَالَ : ثَلَاثًا مَا مِنْ إِحْدَاهُنِّ بُدٌّ ، قَالَ : "" مَا هُنَّ ؟ "" قَالَ : يُخَيِّرُونَكَ بَيْنَ أَنْ  تَخْلَعَ  لَهُمْ أَمْرَهُمْ ، فَتَقُولَ : هَذَا أَمْرُكُمْ ، فَاخْتَارُوا لَهُ مَنْ شِئْتُمْ ، وَبَيْنَ أَنْ تُقِصَّ مِنْ نَفْسِكَ ، فَإِنْ أَبَيْتَ هَذَيْنِ فَإِنَّ  الْقَوْمَ  قَاتِلُوكَ ، قَالَ : "" مَا مِنْ إِحْدَاهُنَّ بُدٌّ ؟ "" قَالَ : مَا مِنْ إِحْدَاهُنَّ بُدٌّ قَالَ : "" أَمَّا أَنْ أَخْلَعَ لَهُمْ أَمْرَهُمْ فَمَا كُنْتُ لِأَخْلَعَ  سِرْبَالًا  سُرْبِلْتُهُ "" قَالَ : وَقَالَ  الْحَسَنُ  : قَالَ : "" وَاللهِ لَأَنْ أُقَدَّمَ فَيُضْرَبَ عُنُقِي أَحَبُّ إِلَيَّ مِنْ أَنْ أَخْلَعَ أَمْرَ أُمَّةِ  مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعْضُهَا عَلَى بَعْضٍ - قَالَ  ابْنُ عَوْنٍ  : وَهَذَا أَشْبَهُ بِكَلَامِ  عُثْمَانَ  - وَأَمَّا أَنْ أُقِصَّ مِنْ نَفْسِي ، فَوَاللهِ لَقَدْ عَلِمْتُ أَنَّ صَاحِبَيَّ بَيْنَ يَدَيَّ كَانَا يُعَاقَبَانِ ، وَمَا يَقُومُ بَدَنِي لِلْقِصَاصِ ، وَأَمَّا أَنْ تَقْتُلُونِي فَوَاللهِ لَئِنْ قَتَلْتُمُونِي لَا تُحَابُّونَ بَعْدِي أَبَدًا ، وَلَا تُقَاتِلُونَ بَعْدِي عَدُوًّا جَمِيعًا أَبَدًا "" ، فَقَامَ  الْأَشْتَرُ  فَانْطَلَقَ ، فَمَكَثْنَا ، فَقُلْنَا : لَعَلَّ النَّاسَ إِذْ جَاءَ رَجُلٌ كَأَنَّهُ ذِئْبٌ فَاطَّلَعَ مِنْ بَابٍ ، ثُمَّ رَجَعَ ، ثُمَّ جَاءَ  مُحَمَّدُ بْنُ أَبِي بَكْرٍ  فِي ثَلَاثَةَ عَشَرَ رَجُلًا حَتَّى انْتَهَوْا إِلَى  عُثْمَانَ  - رَضِيَ اللهُ عَنْهُ - ، فَأَخَذَ بِلِحْيَتِهِ ، فَقَالَ بِهَا ، وَقَالَ بِهَا ، حَتَّى سَمِعْتُ وَقْعَ أَضْرَاسِهِ ، وَقَالَ مَا أَغْنَى عَنْكَ  مُعَاوِيَةُ  ، مَا أَغْنَى عَنْكَ  ابْنُ عَامِرٍ  ، مَا أَغْنَى عَنْكَ كُتُبُكَ ، قَالَ : "" أَرْسِلْ لِحْيَتِي يَا ابْنَ أَخِي ، أَرْسِلْ         [1/83]      لِحْيَتِي يَا ابْنَ أَخِي "" ، قَالَ : فَأَنَا رَأَيْتُهُ اسْتَدْعَى رَجُلًا مِنَ  الْقَوْمِ  بِعَيْنِهِ فَقَامَ إِلَيْهِ  بِمِشْقَصٍ  حَتَّى وَجَأَهُ بِهِ فِي رَأْسِهِ ، قُلْتُ : ثُمَّ  مَهْ  قَالَ : ثُمَّ  تَعَاوَوْا  عَلَيْهِ ، وَاللهِ حَتَّى قَتَلُوهُ  "" .","","Al-Mu'jam al-Kabir 116","","عثمان بن عفان عن وثاب ، مولى عثمان بن عفان عن الحسن البصري عن عبد الله بن عون بن أرطبان عن إسماعيل ابن علية عن فضيل بن حسين الجحدري عن سليمان بن الحسن العطار عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"117","117  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْحَسَنِ الْعَطَّارُ ،  ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  أَنَّ  مُحَمَّدَ بْنَ أَبِي حُذَيْفَةَ بْنِ عُتْبَةَ بْنِ رَبِيعَةَ  ،  وَكَعْبًا  ، رَكِبَا سَفِينَةً فِي الْبَحْرِ ، فَقَالَ  مُحَمَّدٌ  :  يَا كَعْبُ أَمَا تَجِدُ سَفِينَتَنَا هَذِهِ فِي التَّوْرَاةِ كَيْفَ تَجْرِي ؟  فَقَالَ : "" لَا وَلَكِنْ أَجِدُ فِيهَا رَجُلًا أَشْقَى الْفِتْيَةَ مِنْ  قُرَيْشٍ  يَنْزُو فِي الْفِتْنَةِ كَمَا يَنْزُو الْحِمَارُ ، لَا تَكُنْ أَنْتَ هُوَ "" قَالَ  ابْنُ سِيرِينَ  : فَزَعَمُوا أَنَّهُ كَانَ هُوَ .","","Al-Mu'jam al-Kabir 117","","كعب الأحبار عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن إسماعيل ابن علية عن فضيل بن حسين الجحدري عن سليمان بن الحسن العطار عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"118","118  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ صَدَقَةَ الْبَغْدَادِيُّ ، وَإِسْحَاقُ بْنُ دَاوُدَ الصَّوَّافُ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ خَالِدِ بْنِ خِدَاشٍ ،  ثَنَا  سَلْمُ بْنُ قُتَيْبَةَ ،  ثَنَا  مُبَارَكٌ ،  عَنِ  الْحَسَنِ ،  حَدَّثَنِي  سَيَّافُ عُثْمَانَ - رَضِيَ اللهُ عَنْهُ - ،  أَنَّ  رَجُلًا مِنَ الْأَنْصَارِ  دَخَلَ عَلَى عُثْمَانَ فَقَالَ : ارْجِعِ ابْنَ أَخِي فَلَسْتَ بِقَاتِلِي ، قَالَ : وَكَيْفَ عَلِمْتَ ذَاكَ ؟ قَالَ : لِأَنَّهُ "" أُتِيَ بِكَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ سَابِعِكَ  فَحَنَّكَكَ  ، وَدَعَا لَكَ بِالْبَرَكَةِ "" ، ثُمَّ دَخَلَ عَلَيْهِ  رَجُلٌ آخَرُ مِنَ الْأَنْصَارِ  فَقَالَ : ارْجِعِ ابْنَ أَخِي فَلَسْتَ بِقَاتِلِي ، قَالَ : بِمَ تَدْرِي ذَلِكَ ؟ قَالَ : لِأَنَّهُ "" أُتِيَ بِكَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ سَابِعِكَ  فَحَنَّكَكَ  وَدَعَا لَكَ بِالْبَرَكَةِ "" قَالَ : ثُمَّ دَخَلَ عَلَيْهِ  مُحَمَّدُ بْنُ أَبِي بَكْرٍ  فَقَالَ : أَنْتَ قَاتِلِي ، قَالَ : وَمَا يُدْرِيكَ يَا نَعْثَلُ ؟ قَالَ : لِأَنَّهُ "" أُتِيَ بِكَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ سَابِعِكَ لَيُحَنِّكَكَ وَيَدْعُوَ لَكَ بِالْبَرَكَةِ فَخَرَيْتَ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" قَالَ : فَوَثَبَ عَلَى صَدْرِهِ وَقَبَضَ عَلَى لِحْيَتِهِ ، فَقَالَ :  إِنْ تَفْعَلْ كَانَ يَعِزُّ عَلَى أَبِيكَ أَنْ تَسُوءَهُ ،  قَالَ : فَوَجَأَهُ فِي نَحْرِهِ بِمَشَاقِصَ كَانَتْ فِي يَدِهِ .","","Al-Mu'jam al-Kabir 118","","عثمان بن عفان عن سياف عثمان عن الحسن البصري عن مبارك بن فضالة عن سلم بن قتيبة الشعيري عن محمد بن خالد بن خداش المهلبي عن إسحاق بن داود الصواف التستري عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"119","[1/84]      119  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْبَاقِي الْأَذَنِيُّ ،  ثَنَا  الْمُسَيِّبُ بْنُ وَاضِحٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  يُونُسَ بْنِ يَزِيدَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ :  "" لَمَّا ضَرَبَ الرَّجُلُ يَدَ عُثْمَانَ  قَالَ  :  إِنَّهَا لَأَوَّلُ يَدٍ خَطَّتِ الْمُفَصَّلَ  .","","Al-Mu'jam al-Kabir 119","","عثمان بن عفان عن أبو سلمة بن عبد الرحمن عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن المبارك عن المسيب بن واضح التلمنسي عن يحيى بن عبد الباقي الثغري عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"120","120  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ ،  ثَنَا  عَمْرُو بْنُ عُثْمَانَ ،  ثَنَا  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ الْمُهَاجِرِ ،  عَنِ  الْعَبَّاسِ بْنِ سَالِمٍ ، أَنَّ عُمَيْرَ بْنَ رَبِيعَةَ ،  حَدَّثَهُ  أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَرْسَلَ إِلَى  كَعْبِ الْأَحْبَارِ  فَقَالَ :  يَا  كَعْبُ  كَيْفَ تَجِدُ نَعْتِي ؟  قَالَ : "" أَجِدُ نَعْتَكَ قَرْنًا مِنْ حَدِيدٍ "" ، قَالَ : وَمَا  قَرْنٌ  مِنْ حَدِيدٍ ؟ قَالَ : "" أَمِيرٌ سَدِيدٌ لَا يَأْخُذُهُ فِي اللهِ لَوْمَةُ لَائِمٍ "" ، قَالَ : ثُمَّ  مَهْ  ؟ قَالَ : "" ثُمَّ يَكُونُ بَعْدَكَ  خَلِيفَةٌ  تَقْتُلُهُ  فِئَةٌ  ظَالِمَةٌ "" ، قَالَ : ثُمَّ  مَهْ  ؟ قَالَ : "" ثُمَّ يَكُونُ الْبَلَاءُ  ""  .","","Al-Mu'jam al-Kabir 120","","عمر بن الخطاب عن عمير بن ربيعة عن عباس بن سالم بن جميل اللخمي عن محمد بن مهاجر بن أبي مسلم عن عثمان بن سعيد بن كثير عن عمرو بن عثمان بن سعيد الحمصي عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"121","121  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ، قَالَ :  سَمِعْتُ  سَعِيدَ بْنَ زَيْدٍ ، يَقُولُ :  وَاللهِ لَوِ انْقَضَّ أَحَدٌ فِيمَا فَعَلْتُمْ  بِابْنِ عَفَّانَ  لَكَانَ مَحْقُوقًا أَنْ يَنْقَضَّ  "" .","","Al-Mu'jam al-Kabir 121","","سعيد بن زيد بن عمرو العدوي عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"122","122  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، وَالْحَسَنُ بْنُ الْمُثَنَّى الْعَنْبَرِيُّ ، وَعَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالُوا :  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  الصَّعْقُ بْنُ حَزْنٍ ،  ثَنَا  قَتَادَةُ ،  عَنْ  زَهْدَمٍ الْجَرْمِيِّ ، قَالَ :  خَطَبَنَا  ابْنُ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - ، فَقَالَ :  لَوْ أَنَّ النَّاسَ لَمْ يَطْلُبُوا بِدَمِ  عُثْمَانَ  لَرُجِمُوا بِالْحِجَارَةِ مِنَ السَّمَاءِ  "" .","","Al-Mu'jam al-Kabir 122","","عبد الله بن عباس عن زهدم بن مضرب الجرمي عن قتادة بن دعامة عن الصعق بن حزن البكري عن محمد بن الفضل السدوسي عن الحسن بن المثنى العنبري عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"123","123  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي صَفْوَانَ الثَّقَفِيُّ ،  ثَنَا  أُمَيَّةُ بْنُ خَالِدٍ ،  ثَنَا  قُرَّةُ بْنُ خَالِدٍ ، قَالَ :  سَمِعْتُ  الْحَسَنَ ، يَقُولُ :  أُخِذَ         [1/85]      الْفَاسِقُ  مُحَمَّدُ بْنُ أَبِي بَكْرٍ  فِي شِعْبٍ مِنْ شِعَابِ  مِصْرَ  فَأُدْخِلَ فِي جَوْفِ حِمَارٍ فَأُحْرِقَ  "" .","","Al-Mu'jam al-Kabir 123","","الحسن البصري عن قرة بن خالد السدوسي عن أمية بن خالد الثوباني عن محمد بن عثمان بن أبي صفوان الثقفي عن الساجي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"124","124  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ الْمِصْرِيُّ ،  ثَنَا  أَبُو الْأَسْوَدِ النَّضْرُ بْنُ عَبْدِ الْجَبَّارِ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  يَزِيدُ بْنُ عَمْرٍو الْمَعَافِرِيُّ ، قَالَ :  سَمِعْتُ  أَبَا ثَوْرٍ النَّهْمِيَّ  يُحَدِّثُ ، عَنْ  عُثْمَانَ بْنِ عَفَّانَ - رَضِيَ اللهُ عَنْهُ - ، قَالَ :  لَقَدِ  اخْتَبَأْتُ  عِنْدَ رَبِّي عَشْرًا ، إِنِّي لَرَابِعُ أَرْبَعَةٍ فِي الْإِسْلَامِ  ، وَمَا تَعَنَّيْتُ ، وَلَا تَمَنَّيْتُ ، وَلَا وَضَعْتُ يَمِينِي عَلَى فَرْجِي ، مُنْذُ بَايَعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَمَا مَرَّتْ عَلَيَّ جُمُعَةٌ مُنْذُ أَسْلَمْتُ إِلَّا وَأَنَا  أَعْتِقُ  فِيهَا رَقَبَةً ، إِلَّا أَنْ لَا يَكُونَ عِنْدِي  فَأَعْتِقَهَا  بَعْدَ ذَلِكَ ، وَلَا زَنَيْتُ فِي جَاهِلِيَّةٍ وَلَا إِسْلَامٍ ""  .","","Al-Mu'jam al-Kabir 124","","عثمان بن عفان عن أبو ثور الفهمي عن يزيد بن عمرو المعافري عن عبد الله بن لهيعة عن النضر بن عبد الجبار المرادي عن المقدام بن داود الرعيني عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"125","125  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  كُلَيْبُ بْنُ وَائِلٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي مُلَيْكَةَ يُكَنَّى أَبَا ثَوْرٍ ، قَالَ :  كُنْتُ جَالِسًا عِنْدَ ابْنِ عُمَرَ ، فَأَتَاهُ  رَجُلٌ  فَسَأَلَهُ ، فَقَالَ : أَرَأَيْتَ  عُثْمَانَ  ؟ هَلْ شَهِدَ  بَدْرًا  ؟ فَقَالَ : لَا ، أَمَّا  يَوْمَ بَدْرٍ  ، فَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  اللَّهُمَّ إِنَّ  عُثْمَانَ  فِي حَاجَتِكَ وَحَاجَةِ رَسُولِكَ  ، فَضَرَبَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِسَهْمِهِ  .","","Al-Mu'jam al-Kabir 125","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي مليكة النهدي عن كليب بن وائل بن بيحان اليشكري عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"126","126  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ ، قَالَ  عُثْمَانُ بْنُ عَفَّانَ :  تَخَلَّفَ فِي  الْمَدِينَةِ  عَلَى امْرَأَتِهِ بِنْتِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَانَتْ وَجِعَةً مَعَرَّةً  ، فَضَرَبَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِسَهْمِهِ ، قَالَ : وَأَجْرِي يَا رَسُولَ اللهِ ؟ قَالَ : "" وَأَجْرُكَ  .","","Al-Mu'jam al-Kabir 126","","عثمان بن عفان عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"127","127  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَزِيدَ بْنِ هَارُونَ الْمَكِّيُّ الْقَزَّازُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  حَدَّثَنَا  عَبَّاسُ بْنُ أَبِي شَمْلَةَ ،  عَنْ  مُوسَى بْنِ يَعْقُوبَ الزَّمْعِيِّ ،  عَنْ  أَخِيهِ مُحَمَّدِ بْنِ يَعْقُوبَ  ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّهِ  ، قَالَتْ :  خَرَجَتِ  الصَّعْبَةُ بِنْتُ الْحَضْرَمِيِّ  ، فَسَمِعْنَاهَا تَقُولُ لِابْنِهَا  طَلْحَةَ بْنِ عُبَيْدِ اللهِ  :  إِنَّ         [1/86]      عُثْمَانَ قَدِ اشْتَدَّ حَصْرُهُ ، فَلَوْ كَلَّمْتَ فِيهِ حَتَّى  يُرَفَّهَ  عَنْهُ  ، قَالَتْ :  وَطَلْحَةُ  - رَضِيَ اللهُ عَنْهُ - يَغْسِلُ أَحَدَ شِقَّيْ رَأْسَهِ فَلَمْ يُجِبْهَا ، فَأَدْخَلَتْ يَدَيْهَا فِي كُمِّ دَرْعِهَا فَأَخْرَجَتْ ثَدْيَيْهَا ، وَقَالَتْ : أَسْأَلُكَ بِمَا حَمَلْتُكَ وَأَرْضَعْتُكَ إِلَّا فَعَلْتَ ، فَقَامَ وَلَوَى شِقَّ شَعَرِ رَأْسِهِ حَتَّى عَقَدَهُ وَهُوَ مَغْسُولٌ ، ثُمَّ خَرَجَ حَتَّى أَتَى  عَلِيًّا  - رَضِيَ اللهُ عَنْهُ - وَهُوَ جَالِسٌ فِي جَنْبِ دَارِهِ ، فَقَالَ  طَلْحَةُ  - رَضِيَ اللهُ عَنْهُ - وَمَعَهُ أُمُّهُ ،  وَأُمُّ عَبْدِ اللهِ بْنِ رَافِعٍ  : لَوْ رَفَّهْتَ عَنْ هَذَا ، فَقَدِ اشْتَدَّ حَصْرُهُ ، قَالَ : فَنَقَرَ بِقَدَحٍ فِي يَدِهِ ثَلَاثَ مَرَّاتٍ ، ثُمَّ رَفَعَ رَأْسَهُ ، فَقَالَ : "" وَاللهِ مَا أُحِبُّ مِنْ هَذَا شَيْئًا تَكْرَهُهُ "" .  قَالَ : وَأَنْشَدَنَا  أَبُو خَلِيفَةَ  قَالَ  : أَنْشَدَنَا  الْعَبَّاسُ بْنُ الْفَرَجِ الرِّيَاشِيُّ  لِلَيْلَى الْأَخْيَلِيَّةِ  :  خَلِيفَةُ  128  - أَنْشَدَنَا  أَبُو خَلِيفَةَ  قَالَ  : أَنْشَدَنَا  أَبُو مُحَمَّدٍ التَّوْزِيُّ  ، قَالَ  أَبُو خَلِيفَةَ  :  وَسَأَلْتُ عَنْهُ  الرِّيَاشِيَّ  فَقَالَ : هُوَ  لِحَسَّانَ بْنِ ثَابِتٍ  :  الْمُتَهَجِّدِ .","","Al-Mu'jam al-Kabir 127","","عثمان بن عفان عن أم عبد الله بن رافع المخزومي عن عبد الله بن رافع المخزومي عن محمد بن يعقوب الزمعي عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن عباس بن أبى شملة المدني عن إبراهيم بن المنذر الحزامي عن أحمد بن يزيد بن عبد الله الجمحي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"128","[1/87]      129  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  أَبُو هِلَالٍ الرَّاسِبِيُّ ،  عَنْ  قَتَادَةَ ،  أَنَّ  عُثْمَانَ بْنَ عَفَّانَ - رَضِيَ اللهُ عَنْهُ - كَانَ إِذَا جَاءَهُ مَنْ يُؤْذِنُهُ بِالصَّلَاةِ ، قَالَ :  مَرْحَبًا بِالْقَائِلِينَ عَدْلًا ، وَبِالصَّلَاةِ مَرْحَبًا وَأَهْلًا  .","","Al-Mu'jam al-Kabir 129","","عثمان بن عفان عن قتادة بن دعامة عن محمد بن سليم الراسبي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"129","130  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  سَلَّامُ بْنُ مِسْكِينٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ، قَالَ :  قَالَتِ امْرَأَةُ عُثْمَانَ - رَضِيَ اللهُ عَنْهُ - حِينَ أَطَافُوا بِهِ يُرِيدُونَ قَتْلَهُ :  إِنْ تَقْتُلُوهُ أَوْ تَتْرُكُوهُ فَإِنَّهُ كَانَ يُحْيِي اللَّيْلَ كُلَّهُ  فِي رَكْعَةٍ يَجْمَعُ فِيهَا الْقُرْآنَ  "" .","","Al-Mu'jam al-Kabir 130","","عثمان بن عفان عن نائلة بنت الفرافصة امرأة عثمان عن محمد بن سيرين عن سلام بن مسكين النمري عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"130","131  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  الْمُبَارَكُ بْنُ فَضَالَةَ ، قَالَ :  سَمِعْتُ  الْحَسَنَ ، يَقُولُ :  أَدْرَكْتُ عُثْمَانَ - رَضِيَ اللهُ عَنْهُ - وَأَنَا يَوْمَئِذٍ قَدْ رَاهَقْتُ الْحُلُمَ ،  فَسَمِعْتُهُ يَخْطُبُ  ، وَشَهِدْتُهُ يَقُولُ :  يَا أَيُّهَا النَّاسُ ، مَا تَنْقِمُونَ عَلَيَّ ؟  قَالَ : وَمَا مِنْ يَوْمٍ إِلَّا وَهُمْ يَقْتَسِمُونَ فِيهِ خَيْرًا ، يَقُولُ : "" يَا مَعْشَرَ النَّاسِ ، اغْدُوا عَلَى عَطِيَّاتِكُمْ "" فَيَغْدُونَ فَيَأْخُذُونَهَا وَافِرَةً ، ثُمَّ يُقَالُ : "" يَا مَعْشَرَ الْمُسْلِمِينَ اغْدُوا عَلَى كِسْوَتِكُمْ "" ، فَيُجَاءُ بِالْحُلَلِ فَتُقْسَمُ بَيْنَهُمْ قَالَ  الْحَسَنُ  : "" وَالْعَدُوُّ مَنْفِيٌّ ، وَالْعَطِيَّاتُ دَارَّةٌ ، وَذَاتُ الْبَيْنِ حَسَنٌ ، وَالْخَيْرُ كَثِيرٌ ، مَا عَلَى الْأَرْضِ مُؤْمِنٌ يَخَافُ مُؤْمِنًا ، مَنْ لَقِيَ مِنْ أَيِّ الْأَحْيَاءِ كَانَ فَهُوَ أَخُوهُ وَمَوَدَّتُهُ وَنُصْرَتُهُ ، وَالْفِتْنَةُ أَنْ يَسُلَّ عَلَيْهِ سَيْفًا  "" .","","Al-Mu'jam al-Kabir 131","","عثمان بن عفان عن الحسن البصري عن مبارك بن فضالة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"131","132  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْوَهَّابِ الْحَجَبِيُّ ،  ثَنَا  حَزْمُ بْنُ أَبِي حَزْمٍ ،  عَنْ  أَبِي الْأَسْوَدِ ، قَالَ :  سَمِعْتُ  أَبَا بَكْرَةَ ، يَقُولُ :  لَأَنْ أَخِرَّ مِنَ السَّمَاءِ فَأَنْقَطِعَ أَحَبُّ إِلَيَّ مِنْ أَنْ أَكُونَ شَرِكْتُ فِي دَمِ  عُثْمَانَ  - رَضِيَ اللهُ عَنْهُ  - "" .","","Al-Mu'jam al-Kabir 132","","أبو بكرة الثقفي عن مسلم بن مخراق القطان عن حزم بن أبي حزم القطعي عن عبد الله بن عبد الوهاب الحجبي عن الفضل بن الحباب الجمحي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"132","[1/88]      133  -  حَدَّثَنَا  الْفَضْلُ بْنُ الْحُبَابِ أَبُو خَلِيفَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْوَهَّابِ الْحَجَبِيُّ ،  ثَنَا  حَزْمٌ ،  عَنْ  أَبِي الْأَسْوَدِ ، قَالَ :  سَمِعْتُ  طَلِيقَ بْنَ خَشَّافٍ يَقُولُ :  وَفَدْنَا إِلَى  الْمَدِينَةِ  لِنَنْظُرَ فِيمَ قُتِلَ  عُثْمَانُ  ، فَلَمَّا قَدِمْنَا مَرَّ مِنَّا بَعْضٌ إِلَى  عَلِيٍّ ،  وَبَعْضٌ إِلَى  الْحُسَيْنِ بْنِ عَلِيٍّ  - رَضِيَ اللهُ عَنْهُمَا - وَبَعْضٌ إِلَى أُمَّهَاتِ الْمُؤْمِنِينَ - رَضِيَ اللهُ عَنْهُنَّ - فَانْطَلَقْتُ حَتَّى  أَتَيْتُ  عَائِشَةَ فَسَلَّمْتُ عَلَيْهَا فَرَدَّتِ السَّلَامَ ، فَقَالَتْ : وَمَنِ الرَّجُلُ ؟ قُلْتُ : مِنْ  أَهْلِ الْبَصْرَةِ  ، فَقَالَتْ : مِنْ أَيِّ  أَهْلِ الْبَصْرَةِ  ؟ قُلْتُ : مِنْ  بَكْرِ بْنِ وَائِلٍ  ، قَالَتْ : مِنْ أَيِّ  بَكْرِ بْنِ وَائِلٍ  ؟ قُلْتُ : مِنْ  بَنِي قَيْسِ بْنِ ثَعْلَبَةَ  قَالَتْ : أَمِنْ أَهْلِ فُلَانٍ ؟ فَقُلْتُ لَهَا : يَا أُمَّ الْمُؤْمِنِينَ ، فِيمَ قُتِلَ  عُثْمَانُ  أَمِيرُ الْمُؤْمِنِينَ - رَضِيَ اللهُ عَنْهُ - ؟ قَالَتْ : "" قُتِلَ وَاللهِ مَظْلُومًا ، لَعَنَ اللهُ قَتَلَتَهُ ، أَقَادَ اللهُ  ابْنَ أَبِي بَكْرٍ  بِهِ ، وَسَاقَ اللهُ إِلَى أَعْيُنِ  بَنِي تَمِيمٍ  هَوَانًا فِي بَيْتِهِ ، وَأَهَرَاقَ اللهُ دِمَاءَ  بَنِي بُدَيْلٍ  عَلَى ضَلَالَةٍ ، وَسَاقَ اللهُ إِلَى  الْأَشْتَرِ  سَهْمًا مِنْ سِهَامِهِ "" ، فَوَاللهِ مَا مِنَ  الْقَوْمِ  رَجُلٌ إِلَّا أَصَابَتْهُ دَعْوَتُهَا .","","Al-Mu'jam al-Kabir 133","","عائشة بنت أبي بكر الصديق عن طلق بن خشاف القيسي عن مسلم بن مخراق القطان عن حزم بن أبي حزم القطعي عن عبد الله بن عبد الوهاب الحجبي عن الفضل بن الحباب الجمحي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"133","134  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  الْفَضْلُ بْنُ زِيَادٍ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ  أَنَّ عَامَّةَ الرَّكْبِ الَّذِينَ سَارُوا إِلَى  عُثْمَانَ  جُنُّوا  .","","Al-Mu'jam al-Kabir 134","","يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن عبد الله بن المبارك عن الطستي الفضل بن زياد عن محمد بن علي بن زيد الصائغ عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"134","135  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  عَاصِمُ بْنُ أَبِي النَّجُودِ ،  عَنْ  شَقِيقِ بْنِ سَلَمَةَ ، قَالَ :  لَقِيَ  عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ  الْوَلِيدُ بْنُ عُقْبَةَ  فَقَالَ : مَا لِي أَرَاكَ قَدْ جَفَوْتَ أَمِيرَ الْمُؤْمِنِينَ  عُثْمَانَ  - رَضِيَ اللهُ عَنْهُ - ؟ فَقَالَ  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  - رَضِيَ اللهُ عَنْهُ - : أَبْلِغْهُ أَنِّي لَمْ  أَتَخَلَّفْ  عَنْ  بَدْرٍ         [1/89]      فَخُبِّرَ بِذَلِكَ عُثْمَانُ - رَضِيَ اللهُ عَنْهُ - فَقَالَ : "" أَمَّا قَوْلُهُ : إِنِّي لَمْ  أَتَخَلَّفْ  عَنْ  بَدْرٍ  ، فَإِنِّي كُنْتُ أُمَرِّضُ  رُقَيَّةَ بِنْتَ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى مَاتَتْ  وَلَقَدْ ضَرَبَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِسَهْمٍ  ، وَمَنْ ضَرَبَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِسَهْمٍ فَقَدْ شَهِدَ "" .","","Al-Mu'jam al-Kabir 135","","عثمان بن عفان عن شقيق بن سلمة عن عاصم بن بهدلة عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"135","136  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  الْعَوَّامُ بْنُ حَوْشَبٍ ،  ثَنَا  سَعِيدُ بْنُ جُمْهَانَ ،  عَنْ  سَفِينَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْخِلَافَةُ بَعْدِي فِي أُمَّتِي ثَلَاثُونَ سَنَةً  ، قَالَ : "" فَحَسِبْنَا ، فَوَجَدْنَا :  أَبَا بَكْرٍ  سَنَتَيْنِ  وَعُمَرَ  عَشْرًا ،  وَعُثْمَانَ  اثْنَتَيْ عَشْرَةَ ،  وَعَلِيًّا  سِتًّا - رَضِيَ اللهُ عَنْهُمْ -  .","","Al-Mu'jam al-Kabir 136","","سفينة مولى رسول الله عن سعيد بن جمهان الأسلمي عن العوام بن حوشب عن يزيد بن هارون عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"136","137  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ أَبِي مُوسَى الْأَنْطَاكِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ كَعْبٍ الْحَلَبِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ بْنِ جَابِرٍ ، وَعَبْدُ الْغَفَّارِ بْنُ إِسْمَاعِيلَ بْنِ عُبَيْدِ اللهِ ،  عَنْ  إِسْمَاعِيلَ بْنِ عُبَيْدِ اللهِ ،  عَنْ  أَبِي عَبْدِ اللهِ الْأَشْعَرِيِّ ،  عَنْ  أَبِي الدَّرْدَاءِ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : قُلْتُ :  يَا رَسُولَ اللهِ زَعَمُوا أَنَّكَ قُلْتَ :  سَيْكَفُرُ قَوْمٌ بَعْدَ إِيمَانِهِمْ  قَالَ : "" أَجَلْ ، وَلَسْتَ مِنْهُمْ  . فَتُوُفِّيَ  أَبُو الدَّرْدَاءِ  قَبْلَ قَتْلِ  عُثْمَانَ  - رَضِيَ اللهُ عَنْهُمَا  - .","","Al-Mu'jam al-Kabir 137","","أبو الدرداء عن أبو عبدالله الأشعري عن إسماعيل ابن أبي المهاجر عن عبد الغفار بن إسماعيل الدمشقي عن الوليد بن مسلم القرشي عن يعقوب بن كعب الأنطاكي عن أحمد بن محمد بن أبي موسى الأنطاكي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"137","138  -  حَدَّثَنَا  عَبَّادُ بْنُ عَلِيٍّ السِّيرِينِيُّ ،  حَدَّثَنَا  بَكَّارُ بْنُ مُحَمَّدٍ السِّيرِينِيُّ ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  عُقْبَةَ بْنِ أَوْسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  عُثْمَانُ ذُو النُّورَيْنِ  قُتِلَ مَظْلُومًا  "" .","","Al-Mu'jam al-Kabir 138","","عبد الله بن عمرو بن العاص عن عقبة بن أوس السدوسي عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن بكار بن محمد السيريني عن عباد بن علي بن مرزوق السيرينى عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"138","139  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  عُقْبَةَ بْنِ أَوْسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو - رَضِيَ اللهُ عَنْهُ - قَالَ :  أَبُو بَكْرٍ الصِّدِّيقُ  أَصَبْتُمُ اسْمَهُ  ،  عُمَرُ  قَرْنٌ  مِنْ حَدِيدٍ ،  عُثْمَانُ  ذُو النُّورَيْنِ أَصَبْتُمُ اسْمَهُ ، قُتِلَ مَظْلُومًا أُوتِيَ  كِفْلَيْنِ  مِنَ الْأَجْرِ  "" .","","Al-Mu'jam al-Kabir 139","","عبد الله بن عمرو بن العاص عن عقبة بن أوس السدوسي عن محمد بن سيرين عن هشام بن حسان العتكي عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"139","[1/90]      140  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ سِنَانٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ مَسْعُودٍ ، يَقُولُ "" حِينَ بُويِعَ  لِعُثْمَانَ  :  مَا أَلَوْنَا عَنْ أَعْلَاهَا ذَا  فُوقٍ  "" .","","Al-Mu'jam al-Kabir 140","","عبد الله بن مسعود عن عبد الله بن سنان الأسدي عن الأعمش عن أبو معاوية الضرير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"140","141  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  مُحَمَّدِ بْنِ بِشْرٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  حَكِيمِ بْنِ جَابِرٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ ، يَقُولُ "" حِينَ بُويِعَ  لِعُثْمَانَ  :  مَا أَلَوْنَا عَنْ أَعْلَاهَا ذَا  فُوقٍ  "" .","","Al-Mu'jam al-Kabir 141","","عبد الله بن مسعود عن حكيم بن جابر الأحمسي عن إسماعيل بن أبي خالد عن محمد بن بشر بن الفرافصة عن أبو معاوية الضرير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"141","142  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ بْنُ سَعْدٍ ،  عَنْ  خَالِدِ بْنِ يَزِيدَ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ،  عَنْ  رَبِيعَةَ بْنِ سَيْفٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يَكُونُ بَعْدِي اثْنَا عَشَرَ  خَلِيفَةً  :  أَبُو بَكْرٍ الصِّدِّيقُ  لَا يَلْبَثُ إِلَّا قَلِيلًا ، وَصَاحِبُ رَحَى دَارَةِ الْعَرَبِ يَعِيشُ حَمِيدًا ، وَيُقْتَلُ  شَهِيدًا  "" ، فَقَالَ  رَجُلٌ  : "" مَنْ هُوَ يَا رَسُولَ اللهِ ؟ قَالَ : ""  عُمَرُ بْنُ الْخَطَّابِ  "" ثُمَّ الْتَفَتَ إِلَى  عُثْمَانَ  فَقَالَ : "" وَأَنْتَ سَيَسْأَلُكَ النَّاسُ أَنْ  تَخْلَعَ  قَمِيصًا كَسَاكَ اللهُ إِيَّاهُ ، وَالَّذِي نَفْسِي بِيَدِهِ ، لَئِنْ خَلَعْتَهُ لَا تَدْخُلِ الْجَنَّةَ حَتَّى يَلِجَ الْجَمَلُ فِي سَمِّ  الْخِيَاطِ  .","","Al-Mu'jam al-Kabir 142","","عبد الله بن عمرو بن العاص عن ربيعة بن سيف المعافري عن سعيد بن أبي هلال الليثي عن خالد بن يزيد الجمحي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"142","143  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  بَشَّارُ بْنُ مُوسَى الْخَفَّافُ ،  ثَنَا  الْحَسَنُ بْنُ زِيَادٍ الْبُرْجُمِيُّ ، إِمَامُ مَسْجِدِ مُحَمَّدِ بْنِ وَاسِعٍ ،  عَنْ  قَتَادَةَ ،  عَنِ  النَّضْرِ بْنِ أَنَسٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  خَرَجَ  عُثْمَانُ  - رَضِيَ اللهُ عَنْهُ - مُهَاجِرًا إِلَى أَرْضِ  الْحَبَشَةِ  ، وَمَعَهُ  رُقَيَّةُ بِنْتُ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاحْتَبَسَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَبَرُهُمْ ، وَكَانَ يَخْرُجُ يَتَوَكَّفُ عَنْهُمُ الْخَبَرَ "" فَجَاءَتْهُ  امْرَأَةٌ  فَأَخْبَرَتْهُ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ  عُثْمَانَ  أَوَّلُ مَنْ هَاجَرَ إِلَى اللهِ بِأَهْلِهِ بَعْدَ  لُوطٍ  .","","Al-Mu'jam al-Kabir 143","","أنس بن مالك عن النضر بن أنس بن مالك الأنصاري عن قتادة بن دعامة عن الحسن بن زياد البرجمي إمام مسجد محمد بن واسع عن بشار بن موسى الشيباني عن عبد الله بن أحمد بن حنبل عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"143","144  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ         [1/91]      مُوسَى ،  ثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  عَنْ  إِيَاسِ بْنِ سَلَمَةَ بْنِ الْأَكْوَعِ ،  عَنْ  أَبِيهِ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمَّا بَعَثَ  عُثْمَانَ  إِلَى  أَهْلِ مَكَّةَ  فَبَايَعَ أَصْحَابَهُ  بَيْعَةَ الرِّضْوَانِ  ، "" بَايَعَ  لِعُثْمَانَ  بِإِحْدَى يَدَيْهِ عَلَى الْأُخْرَى "" ، فَقَالَ النَّاسُ : هَنِيئًا  لِأَبِي عَبْدِ اللهِ  يَطُوفُ بِالْبَيْتِ آمِنًا ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَوْ مَكَثَ كَذَا وَكَذَا مَا طَافَ حَتَّى أَطُوفَ  .","","Al-Mu'jam al-Kabir 144","","سلمة بن عمرو بن الأكوع الأسلمي عن إياس بن سلمة بن الأكوع الأسلمي عن موسى بن عبيدة بن نشيط الحميري عن عبيد الله بن موسى عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","سن عثمان ووفاته رضي الله عنه"
"144","وَمَا أَسْنَدَ  عُثْمَانُ بْنُ عَفَّانَ  رَضِيَ اللهُ عَنْهُ  145  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِي ،  ثَنَا  كَهْمَسُ بْنُ الْحَسَنِ ،  عَنْ  مُصْعَبِ بْنِ ثَابِتٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، قَالَ :  قَالَ عُثْمَانُ بْنُ عَفَّانَ - رَضِيَ اللهُ عَنْهُ - وَهُوَ يَخْطُبُ عَلَى الْمِنْبَرِ : إِنِّي مُحَدِّثُكُمْ بِحَدِيثٍ سَمِعْتُهُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمْ يَكُنْ يَمْنَعُنِي أَنْ أُحَدِّثَكُمْ إِلَّا الضِّنُّ بِكُمْ ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  حَرَسُ لَيْلَةٍ فِي  سَبِيلِ  اللهِ أَفْضَلُ مِنْ أَلْفِ لَيْلَةٍ يُقَامُ لَيْلُهَا وَيُصَامُ نَهَارُهَا  .","","Al-Mu'jam al-Kabir 145","","عثمان بن عفان عن عبد الله بن الزبير عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن كهمس بن الحسن النمري عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","وما أسند عثمان بن عفان رضي الله عنه"
"145","146  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ ، قَالَ :  نَاشَدَ عُثْمَانُ - رَضِيَ اللهُ عَنْهُ - النَّاسَ يَوْمًا ، فَقَالَ : أَتَعْلَمُونَ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَعِدَ  أُحُدًا  ،  وَأَبُو بَكْرٍ  ،  وَعُمَرُ  - رَضِيَ اللهُ عَنْهُمَا - ، وَأَنَا ، فَارْتَجَّ  أُحُدٌ  ، وَعَلَيْهِ  مُحَمَّدٌ  النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  وَأَبُو بَكْرٍ  ،  وَعُمَرُ  ،  وَعُثْمَانُ  - رَضِيَ اللهُ عَنْهُمْ - فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اثْبُتْ  أُحُدُ  مَا عَلَيْكَ إِلَّا نَبِيٌّ وَصِدِّيقٌ وَشَهِيدَانِ  .","","Al-Mu'jam al-Kabir 146","","عثمان بن عفان عن سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","وما أسند عثمان بن عفان رضي الله عنه"
"146","147  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  حُرَيْثُ بْنُ السَّائِبِ ،  ثَنَا  الْحَسَنُ ،  عَنْ  حُمْرَانَ بْنِ أَبَانَ ،  عَنْ  عُثْمَانَ بْنِ عَفَّانَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كُلُّ شَيْءٍ فَضَلَ عَنْ ظِلِّ بَيْتٍ  ،  وَجَرْفِ  الْخُبْزِ         [1/92]      وَثَوْبٍ يُوَارِي  عَوْرَةَ  الرَّجُلِ - أَوْ قَالَ :  عَوْرَةَ  ابْنِ آدَمَ  - وَكُلُّ شَيْءٍ فَضَلَ عَنْ ذَا لَمْ يَكُنْ لِابْنِ آدَمَ فِيهِ حَقٌّ  .","","Al-Mu'jam al-Kabir 147","","عثمان بن عفان عن حمران بن أبان النمري عن الحسن البصري عن حريث بن السائب الأسيدي عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","وما أسند عثمان بن عفان رضي الله عنه"
"147","148  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عَلِيُّ بْنُ بَحْرٍ ،  ثَنَا  قَتَادَةُ بْنُ الْفُضَيْلِ بْنِ قَتَادَةَ الرَّهَاوِيُّ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَبْدِ الرَّحْمَنِ بْنِ أَبِي عَمْرَةَ الْأَنْصَارِيَّ  يُحَدِّثُ ، عَنْ  أَبِيهِ  ،  عَنْ  عُثْمَانَ بْنِ عَفَّانَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ صَلَّى الْعِشَاءَ الْآخِرَةَ فِي جَمَاعَةٍ فَكَأَنَّمَا صَلَّى اللَّيْلَ كُلَّهُ  ، وَمَنْ صَلَّى الْغَدَاةَ فِي جَمَاعَةٍ فَكَأَنَّمَا صَلَّى النَّهَارَ كُلَّهُ  .","","Al-Mu'jam al-Kabir 148","","عثمان بن عفان عن عبد الرحمن بن أبي عمرة الخزرجي عن عبد الله بن عبد الرحمن بن أبي عمرة المازني عن قتادة بن الفضيل بن قتادة الرهاوي عن علي بن بحر بن بري القطان عن الحسين بن إسحاق التستري عن الطبراني","وما أسند عثمان بن عفان رضي الله عنه"
"148","149  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَا  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ ،  ثَنَا  مُحَمَّدُ بْنُ سُوقَةَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ، قَالَ :  سَمِعْتُ  عُثْمَانَ - رَضِيَ اللهُ عَنْهُ - وَكَانَ قَلِيلَ الْحَدِيثِ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ تَوَضَّأَ كَمَا أُمِرَ ، وَصَلَّى كَمَا أُمِرَ ، خَرَجَ مِنْ ذُنُوبِهِ كَمَا وَلَدَتْهُ أُمُّهُ  .","","Al-Mu'jam al-Kabir 149","","عثمان بن عفان عن عمرو بن ميمون الأودي عن محمد بن سوقة الغنوي عن زياد بن عبد الله البكائي عن زكريا بن يحيى زحمويه عن محمد بن عبد الله مطين الحضرمي عن الطبراني","وما أسند عثمان بن عفان رضي الله عنه"
"149","4 - نِسْبَةُ  عَلِيِّ بْنِ أَبِي طَالِبٍ  - رَضِيَ اللهُ عَنْهُ - شَهِدَ  بَدْرًا  .  ابْنُ عَبْدِ الْمُطَّلِبِ بْنِ هَاشِمِ بْنِ عَبْدِ مَنَافِ بْنِ قُصَيِّ بْنِ كِلَابِ بْنِ مُرَّةَ بْنِ كَعْبِ بْنِ لُؤَيِّ بْنِ غَالِبِ بْنِ فِهْرِ بْنِ مَالِكٍ  يُكَنَّى  أَبَا الْحَسَنِ  .  150  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ،  حَدَّثَنِي  أَبِي  ، قَالَ :  بَلَغَنِي  بَنُو هَاشِمٍ  : ""  أَنَّ  أَبَا طَالِبٍ  اسْمُهُ :  عَبْدُ مَنَافِ بْنُ عَبْدِ الْمُطَّلِبِ  ،  وَعَبْدُ الْمُطَّلِبِ  اسْمُهُ :  شَيْبَةُ بْنُ هَاشِمٍ  ،  وَهَاشِمُ  اسْمُهُ :  عَمْرُو بْنُ عَبْدِ مَنَافِ بْنِ قُصَيٍّ  ،  وَقُصَيٌّ  اسْمُهُ :  زَيْدٌ  "" .","","Al-Mu'jam al-Kabir 150","","","نسبة علي بن أبي طالب رضي الله عنه"
"150","151  -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَحْمَدَ الْخُزَاعِيُّ الْمَكِّيُّ ،  ثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ ، قَالَ :  أُمُّ  عَلِيِّ بْنِ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ :  فَاطِمَةُ بِنْتُ أَسَدِ بْنِ هَاشِمِ بْنِ عَبْدِ مَنَافِ بْنِ قُصَيٍّ  ، وَيُقَالُ : إِنَّهَا أَوَّلُ هَاشِمِيَّةٍ وَلَدَتْ لِهَاشِمِيٍّ ، وَقَدْ         [1/93]      أَسْلَمَتْ ، وَهَاجَرَتْ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِالْمَدِينَةِ  ، وَمَاتَتْ ، وَدَفَنَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأُمُّهَا  فَاطِمَةُ بِنْتُ هَرِمِ بْنِ رَوَاحَةَ بْنِ حُجْرِ بْنِ عَبْدِ مُعْرِضِ بْنِ عَامِرِ بْنِ لُؤَيٍّ  "" .","","Al-Mu'jam al-Kabir 151","","الزبير بن بكار عن إسحاق بن أحمد بن إسحاق الخزاعي عن الطبراني","نسبة علي بن أبي طالب رضي الله عنه"
"151","صِفَةُ  عَلِيِّ بْنِ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ  152  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِي إِسْحَاقَ  ، قَالَ :  رَأَيْتُ  عَلِيًّا - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ لِي أَبِي :  يَا  عَمْرُو  فَانْظُرْ إِلَى أَمِيرِ الْمُؤْمِنِينَ "" فَلَمْ أَرَهُ خَضَبَ لِحْيَتَهُ ، ضَخْمُ الرَّأْسِ  "" .","","Al-Mu'jam al-Kabir 152","","علي بن أبي طالب عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","صفة علي بن أبي طالب رضي الله عنه"
"152","153  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبِي إِسْحَاقَ ، قَالَ :  رَأَيْتُ  عَلِيًّا - رَضِيَ اللهُ عَنْهُ - أَبْيَضَ الرَّأْسِ وَاللِّحْيَةِ  ، وَعَلَيْهِ إِزَارٌ وَرِدَاءٌ  "" .","","Al-Mu'jam al-Kabir 153","","علي بن أبي طالب عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","صفة علي بن أبي طالب رضي الله عنه"
"153","154  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الصَّفَّارُ ،  ثَنَا  حَمَدُ بْنُ خَالِدٍ الْخَيَّاطُ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ، قَالَ :  رَأَيْتُ  عَلِيًّا - رَضِيَ اللهُ عَنْهُ - عَلَى الْمِنْبَرِ أَبْيَضَ الرَّأْسِ وَاللِّحْيَةِ  "" .","","Al-Mu'jam al-Kabir 154","","علي بن أبي طالب عن أبو إسحاق السبيعي عن سفيان الثوري عن محمد بن عبد الرحمن بن المغيرة عن حماد بن خالد الخياط عن يوسف بن يعقوب الصفار عن محمد بن عبد الله مطين الحضرمي عن الطبراني","صفة علي بن أبي طالب رضي الله عنه"
"154","155  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ، قَالَ :  أَخْبَرَنِي  أَبُو إِسْحَاقَ ، قَالَ :  خَرَجْتُ مَعَ أَبِي إِلَى الْجُمُعَةِ وَأَنَا غُلَامٌ ، فَلَمَّا خَرَجَ عَلِيٌّ - رَضِيَ اللهُ عَنْهُ - فَصَعِدَ الْمِنْبَرَ ، قَالَ لِي أَبِي : قُمْ أَيْ  عَمْرُو  فَانْظُرْ إِلَى أَمِيرِ الْمُؤْمِنِينَ ، قَالَ : "" فَقُمْتُ ، فَإِذَا هُوَ قَائِمٌ عَلَى الْمِنْبَرِ ،  فَإِذَا هُوَ أَبْيَضُ اللِّحْيَةِ وَالرَّأْسِ ، عَلَيْهِ إِزَارٌ وَرِدَاءٌ لَيْسَ عَلَيْهِ قَمِيصٌ  قَالَ : فَمَا رَأَيْتُهُ جَلَسَ عَلَى الْمِنْبَرِ حَتَّى نَزَلَ عَنْهُ ، قُلْنَا  لِأَبِي إِسْحَاقَ  : فَهَلْ قَنَتَ ؟ قَالَ : "" لَا  ""  .","","Al-Mu'jam al-Kabir 155","","علي بن أبي طالب عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","صفة علي بن أبي طالب رضي الله عنه"
"155","[1/94]      156  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  وَكِيعِ بْنِ الْجَرَّاحِ ، قَالَ :  أَخْبَرَنِي  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  أَنَّ  عَلِيًّا  - رَضِيَ اللهُ عَنْهُ - لَمَّا تَزَوَّجَ  فَاطِمَةَ  - رَضِيَ اللهُ عَنْهَا - قَالَتْ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : زَوَّجْتَنِيهِ أُعَيْمِشَ عَظِيمَ الْبَطْنِ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَقَدْ زَوَّجْتُكِهِ وَإِنَّهُ لَأَوَّلُ أَصْحَابِي سِلْمًا ، وَأَكْثَرُهُمْ عِلْمًا ، وَأَعْظَمُهُمْ حِلْمًا  "" .","","Al-Mu'jam al-Kabir 156","","أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن وكيع بن الجراح عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","صفة علي بن أبي طالب رضي الله عنه"
"156","157  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ، (  ح  )  وَحَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ الْمِصْرِيُّ ، قَالَا :  ثَنَا  أَبُو صَالِحٍ الْحَرَّانِيُّ ، قَالَ :  قَالَ  وَكِيعٌ : كِلَاهُمَا  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  رَأَيْتُ  عَلِيًّا - رَضِيَ اللهُ عَنْهُ - عَلَى الْمِنْبَرِ أَبْيَضَ اللِّحْيَةِ  قَدْ مَلَأَتْ مَا بَيْنَ مَنْكِبَيْهِ "" زَادَ  يَحْيَى بْنُ سَعِيدٍ  فِي حَدِيثِهِ : "" عَلَى رَأْسِهِ زُغَيْبَاتٌ  "" .","","Al-Mu'jam al-Kabir 157","","علي بن أبي طالب عن الشعبي عن إسماعيل بن أبي خالد عن وكيع بن الجراح عن عبد الغفار بن داود الحراني عن عمرو بن أبي الطاهر المصري عن الطبراني","صفة علي بن أبي طالب رضي الله عنه"
"157","158  -  ثَنَا  عَبْدُ اللهِ بْنُ الصَّقْرِ السُّكَّرِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  عَنِ  الْوَاقِدِيِّ ، قَالَ :  يُقَالُ  :  كَانَ عَلِيُّ بْنُ أَبِي طَالِبٍ آدَمَ رَبْعَةً مُسْمِنًا ، ضَخْمَ الْمَنْكِبَيْنِ  ، طَوِيلَ اللِّحْيَةِ ، أَصْلَعَ ، عَظِيمَ الْبَطْنِ ، غَلِيظَ الْعَيْنَيْنِ ، أَبْيَضَ الرَّأْسِ وَاللِّحْيَةِ  "" .","","Al-Mu'jam al-Kabir 158","","علي بن أبي طالب عن الواقدي عن إبراهيم بن المنذر الحزامي عن عبد الله بن الصقر السكري عن الطبراني","صفة علي بن أبي طالب رضي الله عنه"
"158","159  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  ثَنَا  شُعْبَةُ ، قَالَ :  سَأَلْتُ  أَبَا إِسْحَاقَ أَنْتَ أَكْبَرُ مِنَ  الشَّعْبِيِّ  ؟  فَقَالَ لِي : الشَّعْبِيُّ أَكْبَرُ مِنِّي  بِسَنَةٍ ، أَوْ سَنَتَيْنِ  قَالَ :  وَرَأَى  أَبُو إِسْحَاقَ عَلِيًّا - رَضِيَ اللهُ عَنْهُ - وَكَانَ يَصِفُهُ لَنَا "" عَظِيمَ الْبَطْنِ أَجْلَحَ  قَالَ  شُعْبَةُ  : "" وَكَانَ  أَبُو إِسْحَاقَ  أَكْبَرَ مِنْ  أَبِي الْبَخْتَرِيِّ  ، وَلَمْ يُدْرِكْ  أَبُو الْبَخْتَرِيِّ  عَلِيًّا  وَلَمْ يَرَهُ ""  .","","Al-Mu'jam al-Kabir 159","","علي بن أبي طالب عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن حجاج بن محمد الأعور عن يحيى بن معين عن محمد بن علي بن زيد الصائغ عن الطبراني","صفة علي بن أبي طالب رضي الله عنه"
"159","[1/95]      160  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ نَافِعٍ ،  ثَنَا  أُمَيَّةُ بْنُ خَالِدٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي الطُّفَيْلِ ، قَالَ :  ذَكَرْتُ  لِابْنِ مَسْعُودٍ  قَوْلَ عَلِيٍّ - رَضِيَ اللهُ عَنْهُ - فَقَالَ :  أَلَمْ تَرَ إِلَى رَأْسِهْ كَالطَّسْتِ ، وَإِنَّمَا حَوْلَهُ كَالْحِفَافِ  "" .","","Al-Mu'jam al-Kabir 160","","علي بن أبي طالب عن عامر بن واثلة عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن أمية بن خالد الثوباني عن محمد بن أحمد بن نافع القيسي عن الساجي عن الطبراني","صفة علي بن أبي طالب رضي الله عنه"
"160","161  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  يُوسُفُ بْنُ حَمَّادٍ الْمَعْنِيُّ ،  ثَنَا  وُهَيْبُ بْنُ جَرِيرٍ ،  ثَنَا  أَبِي  ،  عَنْ  أَبِي رَجَاءٍ الْعُطَارِدِيِّ ، قَالَ :  رَأَيْتُ  عَلِيًّا - رَضِيَ اللهُ عَنْهُ - ، مُسْمِنًا أَصْلَعَ الشَّعَرِ  ، كَأَنَّ بِجَانِبِهِ إِهَابُ شَاةٍ  "" .","","Al-Mu'jam al-Kabir 161","","علي بن أبي طالب عن أبو رجاء العطاردي عن جرير بن حازم عن وهب بن جرير بن حازم عن يوسف بن حماد البصري عن عبد الله بن أحمد الجواليقي عن الطبراني","صفة علي بن أبي طالب رضي الله عنه"
"161","سِنُّ  عَلِيِّ بْنِ أَبِي طَالِبٍ  وَوَفَاتُهُ رَضِيَ اللهُ عَنْهُ  162  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ  ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ،  ثَنَا  ابْنُ لَهِيعَةَ  ،  وَاللَّيْثُ بْنُ سَعْدٍ  ،  عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ  ، قَالَ : ""  أَسْلَمَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  وَهُوَ ابْنُ ثَمَانِ سِنِينَ  "" .","","Al-Mu'jam al-Kabir 162","","","سن علي بن أبي طالب ووفاته رضي الله عنه"
"162","163  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  أَخْبَرَنِي  قَتَادَةُ ،  عَنِ  الْحَسَنِ ، وَغَيْرِهِ ، قَالَ :  فَكَانَ أَوَّلَ مَنْ آمَنَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  ،  وَهُوَ ابْنُ  خَمْسَ عَشْرَةَ ، أَوْ سِتَّ عَشْرَةَ  "" .","","Al-Mu'jam al-Kabir 163","","وغيره عن قتادة بن دعامة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سن علي بن أبي طالب ووفاته رضي الله عنه"
"163","164  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ، قَالَ : ""  قُتِلَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  يَوْمَ الْجُمُعَةِ  ، يَوْمَ سَبْعَةَ عَشَرَ مِنْ شَهْرِ رَمَضَانَ ، سَنَةَ أَرْبَعِينَ  "" .","","Al-Mu'jam al-Kabir 164","","","سن علي بن أبي طالب ووفاته رضي الله عنه"
"164","165  -  حَدَّثَنَا  أَحْمَدُ بْنُ زَيْدِ بْنِ هَارُونَ الْقَزَّازُ الْمَكِّيُّ  ،  ثَنَا  إِبْرَاهِيمُ بْنُ         [1/96]      الْمُنْذِرِ الْحِزَامِيُّ  ،  ثَنَا  حُسَيْنُ بْنُ زَيْدِ بْنِ عَلِيٍّ  ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ  ،  عَنْ  أَبِيهِ  ، قَالَ : ""  تُوُفِّيَ  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ سَنَةً  "" .","","Al-Mu'jam al-Kabir 165","","","سن علي بن أبي طالب ووفاته رضي الله عنه"
"165","166  -  حَدَّثَنَا  أَحْمَدُ بْنُ زَيْدٍ  ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  ،  ثَنَا  سُفْيَانُ  ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ  ،  عَنْ  أَبِيهِ  ، قَالَ : ""  تُوُفِّيَ  عَلِيٌّ  وَهُوَ ابْنُ ثَمَانٍ وَخَمْسِينَ  "" .","","Al-Mu'jam al-Kabir 166","","","سن علي بن أبي طالب ووفاته رضي الله عنه"
"166","167  -  حَدَّثَنَا  الْقَاسِمُ بْنُ عَبَّادٍ الْخَطَّابِيُّ الْبَصْرِيُّ ،  ثَنَا  سَعِيدُ بْنُ صُبَيْحٍ ، قَالَ :  قَالَ  هِشَامُ بْنُ الْكَلْبِيِّ ،  عَنْ  عَوَانَةَ بْنِ الْحَكَمِ ، قَالَ :  لَمَّا ضَرَبَ  عَبْدُ الرَّحْمَنِ بْنُ مُلْجَمٍ  عَلِيًّا - رَضِيَ اللهُ عَنْهُ - وَحُمِلَ إِلَى مَنْزِلِهِ ، أَتَاهُ الْعُوَّادُ ، فَحَمِدَ اللهَ - عَزَّ وَجَلَّ - وَأَثْنَى عَلَيْهِ ، وَصَلَّى عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، ثُمَّ  قَالَ  :  كُلُّ امْرِئٍ مُلَاقٍ مَا يَفِرُّ مِنْهُ فِي فِرَارِهِ  ، وَالْأَجَلُ مُسَاقُ النَّفْسِ ، وَالْهَرَبُ مِنْ آفَاتِهِ كَمْ أَطْرَدْتُ الْأَيَّامَ أَبْحَثُهَا عَنْ مَكْنُونِ هَذَا الْأَمْرِ وَأَبَى اللهُ - عَزَّ وَجَلَّ - إِلَّا إِخْفَاءَهُ ، هَيْهَاتَ عِلْمٌ مَخْزُونٌ ، أَمَّا وَصِيَّتِي إِيَّاكُمْ فَاللهَ - عَزَّ وَجَلَّ - لَا تُشْرِكُوا بِهِ شَيْئًا ،  وَمُحَمَّدًا  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَا تَضُيِّعُوا سُنَّتَهُ ، أَقِيمُوا هَذَيْنِ الْعَمُودَيْنِ ،  وَخَلَاكُمْ  ذَمٌّ مَا لَمْ يُشَرَّدُوا ، وَأُحْمِلَ كُلُّ امْرِئٍ مَجْهُودَهُ ، وَخُفِّفَ عَنِ الْجَهَلَةِ بِرَبٍّ رَحِيمٍ ، وَدِينٍ قَوِيمٍ وَإِمَامٍ عَلِيمٍ ، كُنَّا فِي رِيَاحٍ وَذَرِيِّ أَغْصَانٍ ، وَتَحْتَ ظِلِّ  غَمَامَةٍ  اضْمَحَلَّ مَرْكَزُهَا فَيَحُطُّهَا عَانٍ ، جَاوَرَكُمْ تُدْنِي أَيَّامًا تِبَاعًا ، ثُمَّ هَوًى فَسَتُعْقَبُونَ مِنْ بَعْدِهِ  جُثَّةً  خَوَاءً سَاكِنَةً بَعْدَ حَرَكَةٍ كَاظِمَةٍ ، بَعْدَ نُطُوقٍ ، إِنَّهُ أَوْعَظُ لِلْمُعْتَبِرِينَ مِنْ نُطْقِ الْبَلِيغِ ، وَدَاعِيكُمْ دَاعِي مُرْصَدٍ لِلتَّلَاقِ ، غَدًا تَرَوْنَ أَيَّامِي ، وَيُكْشَفُ عَنْ سَرَائِرِي ، لَنْ يُحَابِيَنِي اللهُ - عَزَّ وَجَلَّ - إِلَّا أَنْ أَتَزَلَّفَهُ بِتَقْوَى فَيَغْفِرَ عَنْ فَرَطٍ مَوْعُودٍ ، عَلَيْكُمُ السَّلَامُ إِلَى يَوْمِ اللِّزَامِ إِنْ أَبْقَ ، فَأَنَا وَلِيُّ دَمِي ، وَإِنْ أَفْنَ فَالْفَنَاءُ مِيعَادِي ، الْعَفْوُ لِي قُرْبَةٌ ، وَلَكُمْ حَسَنَةٌ ، فَاعْفُوا عَفَا اللهُ عَنَّا وَعَنْكُمْ         {      أَلا تُحِبُّونَ أَنْ يَغْفِرَ اللهُ لَكُمْ وَاللهُ غَفُورٌ رَحِيمٌ         }      ثُمَّ قَالَ :         [1/97]      مَرْحِلٌ  "" .","","Al-Mu'jam al-Kabir 167","","علي بن أبي طالب عن عوانة بن الحكم الأخباري عن هشام بن محمد بن السائب الكلبي عن سعيد بن صبيح عن القاسم بن عباد الخطابى عن الطبراني","سن علي بن أبي طالب ووفاته رضي الله عنه"
"167","168  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْأَبَّارُ ،  ثَنَا  أَبُو أُمَيَّةَ عَمْرُو بْنُ هِشَامٍ الْحَرَّانِيُّ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الطَّرَائِفِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ رَاشِدٍ ، قَالَ :  كَانَ مِنْ حَدِيثِ  ابْنِ مُلْجَمٍ  - لَعَنَهُ اللهُ وَأَصْحَابَهُ - أَنَّ  عَبْدَ الرَّحْمَنِ بْنَ مُلْجَمٍ  وَالْبَرْكَ بْنَ عَبْدِ اللهِ  ،  وَعَمْرَو بْنَ بَكْرٍ التَّمِيمِيَّ  ، اجْتَمَعُوا  بِمَكَّةَ  فَذَكَرُوا أَمْرَ النَّاسِ ، وَعَابُوا عَمَلَ وُلَاتِهِمْ ، ثُمَّ ذَكَرُوا  أَهْلَ النَّهَرِ  فَتَرَحَّمُوا عَلَيْهِمْ ، فَقَالُوا : وَاللهِ مَا نَصْنَعُ بِالْبَقَاءِ بَعْدَهُمْ شَيْئًا ، إِخْوَانُنَا الَّذِينَ كَانُوا دُعَاةَ النَّاسِ لِعِبَادَةِ رَبِّهِمُ الَّذِينَ كَانُوا لَا يَخَافُونَ فِي اللهِ لَوْمَةَ لَائِمٍ ، فَلَوْ شَرَيْنَا أَنْفُسَنَا ، فَأَتَيْنَا أَئِمَّةَ الضَّلَالَةِ فَالْتَمَسْنَا قَتْلَهُمْ ، فَأَرَحْنَا مِنْهُمُ الْبِلَادَ وَثَأَرْنَا بِهِمْ إِخْوَانَنَا ، قَالَ  ابْنُ مُلْجَمٍ -  وَكَانَ مِنْ  أَهْلِ مِصْرَ  - : أَنَا أَكْفِيكُمْ  عَلِيَّ بْنَ أَبِي طَالِبٍ  ، وَقَالَ  الْبَرْكُ بْنُ عَبْدِ اللهِ  : أَنَا أَكْفِيكُمْ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ ،  وَقَالَ  عَمْرُو بْنُ بَكْرٍ التَّمِيمِيُّ  : أَنَا أَكْفِيكُمْ  عَمْرَو بْنَ الْعَاصِ  ، فَتَعَاهَدُوا وَتَوَاثَقُوا بِاللهِ ، لَا يَنْكُصُ رَجُلٌ مِنْهُمْ عَنْ صَاحِبِهِ الَّذِي تَوَجَّهَ إِلَيْهِ حَتَّى يَقْتُلَهُ ، أَوْ يَمُوتَ دُونَهُ ، فَأَخَذُوا أَسْيَافَهُمْ ، فَسَمُّوهَا وَاتَّعَدُوا لِسَبْعَ عَشْرَةَ مِنْ شَهْرِ رَمَضَانَ أَنْ يَثِبَ كُلُّ رَجُلٍ مِنْهُمْ عَلَى صَاحِبِهِ الَّذِي تَوَجَّهَ إِلَيْهِ ، وَأَقْبَلَ كُلُّ رَجُلٍ مِنْهُمْ إِلَى الْمِصْرِ الَّذِي فِيهِ صَاحِبُهُ الَّذِي يَطْلُبُ ، فَأَمَّا  ابْنُ الْمُلْجَمِ الْمُرَادِيُّ  ، فَأَتَى أَصْحَابَهُ  بِالْكُوفَةِ  ، وَكَاتَمَهُمْ أَمْرَهُ كَرَاهِيَةَ أَنْ يُظْهِرُوا شَيْئًا مِنْ أَمْرِهِ ، وَأَنَّهُ لَقِيَ أَصْحَابًا لَهُ مِنْ  تَيْمِ الرَّبَابِ         [1/98]      وَقَدْ قَتَلَ عَلِيُّ بْنُ أَبِي طَالِبٍ - رَضِيَ اللهُ عَنْهُ - مِنْهُمْ عِدَّةً  يَوْمَ النَّهَرِ  ، فَذَكَرُوا قَتْلَاهُمْ فَتَرَحَّمُوا عَلَيْهِمْ ، قَالَ : وَلَقِيَ مِنْ يَوْمِهِ ذَلِكَ امْرَأَةً مِنْ  تَيْمِ الرَّبَابِ  يُقَالُ لَهَا  قَطَامُ بِنْتُ الشَّحْنَةِ  ، وَقَدْ قَتَلَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  - رَضِيَ اللهُ عَنْهُ - أَبَاهَا ، وَأَخَاهَا  يَوْمَ النَّهَرِ  ، وَكَانَتْ فَائِقَةَ الْجَمَالِ ، فَلَمَّا رَآهَا الْتَبَسَتْ بِعَقْلِهِ وَنَسِيَ حَاجَتَهُ الَّتِي جَاءَ لَهَا ، فَخَطَبَهَا ، فَقَالَتْ : لَا أَتَزَوَّجُ حَتَّى تَشْتَفِيَ لِي ، قَالَ : وَمَا تَشَائِينَ ؟ قَالَتْ : ثَلَاثَةُ آلَافٍ ، وَعَبْدٌ ،  وَقَيْنَةٌ  ، وَقَتْلُ  عَلِيِّ بْنِ أَبِي طَالِبٍ  - رَضِيَ اللهُ عَنْهُ - فَقَالَ : هُوَ مَهْرٌ لَكِ ، فَأَمَّا قَتْلُ  عَلِيٍّ  فَمَا أَرَاكِ ذَكَرْتِيهِ لِي وَأَنْتِ تُرِيدِينَهُ ؟ قَالَتْ : بَلَى ، فَالْتَمِسْ غُرَّتَهُ فَإِنْ أَصَبْتَهُ شَفَيْتَ نَفْسَكَ وَنَفْسِي ، وَنَفَعَكَ الْعَيْشُ مَعِي ، وَإِنْ قُتِلْتَ فَمَا عِنْدَ اللهِ خَيْرٌ مِنَ الدُّنْيَا  وَزِبْرِجِ  أَهْلِهَا ، فَقَالَ : مَا جَاءَ بِي إِلَى هَذَا الْمِصْرِ إِلَّا قَتْلُ  عَلِيٍّ  ، قَالَتْ : فَإِذَا أَرَدْتَ ذَلِكَ فَأَخْبِرْنِي حَتَّى أَطْلُبَ لَكَ مَنْ يَشُدُّ ظَهْرَكَ ، وَيُسَاعِدُكَ عَلَى أَمْرِكَ ، فَبَعَثَتْ إِلَى رَجُلٍ مِنْ قَوْمِهَا مِنْ  تَيْمِ الرَّبَابِ  ، يُقَالُ لَهُ :  وَرْدَانُ  ، فَكَلَّمَتْهُ ، فَأَجَابَهَا ، وَأَتَى  ابْنُ مُلْجَمٍ  رَجُلًا مِنْ  أَشْجَعَ  يُقَالُ لَهُ :  شَبِيبُ بْنُ نَجْدَةَ  ، فَقَالَ لَهُ : هَلْ لَكَ فِي شَرَفِ الدُّنْيَا وَالْآخِرَةِ ؟ قَالَ : وَمَا ذَاكَ ؟ قَالَ : قَتْلُ  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  ثَكِلَتْكَ  أُمُّكَ ، لَقَدْ جِئْتَ شَيْئًا إِدًّا ، كَيْفَ تَقْدِرُ عَلَى قَتْلِهِ ؟ قَالَ :  أَكْمُنُ  لَهُ فِي السَّحَرِ فَإِذَا خَرَجَ لِصَلَاةِ الْغَدَاةِ شَدَدْنَا عَلَيْهِ فَقَتَلْنَاهُ ، فَإِنْ نَجَوْنَا شَفَيْنَا أَنْفُسَنَا وَأَدْرَكْنَا ثَأْرَنَا ، وَإِنْ قُتِلْنَا فَمَا عِنْدَ اللهِ خَيْرٌ مِنَ الدُّنْيَا  وَزِبْرِجِ  أَهْلِهَا ، قَالَ : وَيْحَكَ لَوْ كَانَ غَيْرَ  عَلِيٍّ  كَانَ أَهْوَنَ عَلَيَّ ، قَدْ عَرَفْتُ بَلَاءَهُ فِي الْإِسْلَامِ ، وَسَابِقَتَهُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَا أَجِدُنِي أَنْشَرِحُ لِقَتْلِهِ ، قَالَ : أَمَا تَعْلَمُ أَنَّهُ قَتَلَ  أَهْلَ النَّهَرِ  الْعُبَّادَ الْمُصَلِّينَ ؟ قَالَ : بَلَى ، قَالَ : فَقَتْلُهُ بِمَا قَتَلَ مِنْ إِخْوَانِنَا ، فَأَجَابَهُ فَجَاؤُوا حَتَّى دَخَلُوا عَلَى  قَطَامِ  ، وَهِيَ فِي الْمَسْجِدِ الْأَعْظَمِ مُعْتَكِفَةٌ فِيهِ ، فَقَالُوا لَهَا : قَدْ أَجْمَعَ رَأْيُنَا عَلَى قَتْلِ  عَلِيٍّ  ، قَالَتْ : فَإِذَا أَرَدْتُمْ ذَلِكَ فَائْتُونِي ، فَجَاءَ ، فَقَالَ : هَذِهِ اللَّيْلَةُ الَّتِي وَاعَدْتُ فِيهَا صَاحِبِي أَنْ يَقْتُلَ كُلُّ وَاحِدٍ مِنَّا صَاحِبَهُ ، فَدَعَتْ لَهُمْ بِالْحَرِيرِ فَعَصَّبَتْهُمْ ، وَأَخَذُوا أَسْيَافَهُمْ وَجَلَسُوا مُقَابِلَ  السُّدَّةِ  الَّتِي يَخْرُجُ مِنْهَا  عَلِيٌّ  ، فَخَرَجَ  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُ - لِصَلَاةِ الْغَدَاةِ ، فَجَعَلَ         [1/99]      يُنَادِي : الصَّلَاةَ الصَّلَاةَ ، فَشَدَّ عَلَيْهِ  شَبِيبٌ  فَضَرَبَهُ بِالسَّيْفِ ، فَوَقَعَ السَّيْفُ بِعِضَادَةِ  الْبَابِ - أَوْ بِالطَّاقِ  - فَشَدَّ عَلَيْهِ  ابْنُ مُلْجَمٍ  فَضَرَبَهُ بِالسَّيْفِ فِي قَرْنِهِ ، وَهَرَبَ  وَرْدَانُ  حَتَّى دَخَلَ مَنْزِلَهُ ، وَدَخَلَ عَلَيْهِ  رَجُلٌ مِنْ بَنِي أُمِّهِ  ، وَهُوَ يَنْزِعُ الْحَرِيرَ وَالسَّيْفَ عَنْ صَدْرِهِ ، فَقَالَ : مَا هَذَا السَّيْفُ وَالْحَرِيرُ ، فَأَخْبَرَهُ بِمَا كَانَ ، فَذَهَبَ إِلَى مَنْزِلِهِ فَجَاءَ بِسَيْفِهِ فَضَرَبَهُ ، حَتَّى قَتَلَهُ ، وَخَرَجَ  شَبِيبٌ  نَحْوَ أَبْوَابِ  كِنْدَةَ  ، وَشَدَّ عَلَيْهِ النَّاسُ إِلَّا أَنَّ رَجُلًا مِنْ  حَضْرَمَوْتَ  يُقَالُ لَهُ :  عُوَيْمِرٌ  ضَرَبَ رِجْلَهُ بِالسَّيْفِ فَصَرَعَهُ ، وَجَثَمَ عَلَيْهِ  الْحَضْرَمِيُّ  ، فَلَمَّا رَأَى النَّاسَ قَدْ أَقْبَلُوا فِي طَلَبِهِ ، وَسَيْفُ  شَبِيبٍ  فِي يَدِهِ خَشِيَ عَلَى نَفْسِهِ فَتَرَكَهُ ، فَنَجَا بِنَفْسِهِ ، وَنَجَا  شَبِيبٌ  فِي  غِمَارِ  النَّاسِ ، وَخَرَجَ  ابْنُ مُلْجَمٍ  فَشَدَّ عَلَيْهِ رَجُلٌ مِنْ  أَهْلِ هَمْدَانَ  يُكَنَّى :  أَبَا أَدَمَا  فَضَرَبَ رِجْلَهُ وَصَرَعَهُ ، وَتَأَخَّرَ  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُ - وَدَفَعَ فِي ظَهْرِ  جَعْدَةَ بْنِ هُبَيْرَةَ بْنِ أَبِي وَهْبٍ  ، فَصَلَّى بِالنَّاسِ الْغَدَاةَ ، وَشَدَّ عَلَيْهِ النَّاسُ مِنْ كُلِّ جَانِبٍ ، وَذَكَرُوا أَنَّ  مُحَمَّدَ بْنَ حُنَيْفٍ  قَالَ : وَاللهِ إِنِّي لِأُصَلِّي تِلْكَ اللَّيْلَةَ الَّتِي ضُرِبَ فِيهَا  عَلِيٌّ  فِي الْمَسْجِدِ الْأَعْظَمِ ، قَرِيبًا مِنَ  السُّدَّةِ  فِي رِجَالٍ كَثِيرٍ مِنْ أَهْلِ الْمِصْرِ مَا فِيهِمْ إِلَّا قِيَامٌ وَرُكُوعٌ وَسُجُودٌ ، وَمَا  يَسْأَمُونَ  مِنْ أَوَّلِ اللَّيْلِ إِلَى آخِرِهِ ، إِذْ خَرَجَ  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُ - لِصَلَاةِ الْغَدَاةِ ، فَجَعَلَ يُنَادِي : أَيُّهَا النَّاسُ ، الصَّلَاةَ الصَّلَاةَ ، فَمَا أَدْرِي أَتَكَلَّمَ بِهَذِهِ الْكَلِمَاتِ أَوْ نَظَرْتُ إِلَى بَرِيقِ السُّيُوفِ ، وَسَمِعْتُ : الْحُكْمُ لِلهِ ، لَا لَكَ يَا  عَلِيُّ ،  وَلَا لِأَصْحَابِكَ ، فَرَأَيْتُ سَيْفًا ، ثُمَّ رَأَيْتُ نَاسًا ، وَسَمِعْتُ  عَلِيًّا  يَقُولُ : لَا يَفُوتُكُمُ الرَّجُلُ ، وَشَدَّ عَلَيْهِ النَّاسُ مِنْ كُلِّ جَانِبٍ ، فَلَمْ أَبْرَحْ حَتَّى أُخِذَ  ابْنُ مُلْجَمٍ  فَأُدْخِلَ عَلَى  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - فَدَخَلْتُ فِيمَنْ دَخَلَ مِنَ النَّاسِ ، فَسَمِعْتُ  عَلِيًّا  يَقُولُ : النَّفْسُ بِالنَّفْسِ ، إِنْ هَلَكْتُ فَاقْتُلُوهُ كَمَا قَتَلَنِي ، وَإِنْ بَقِيتُ رَأَيْتُ فِيهِ رَأْيِي ، وَلَمَّا أُدْخِلَ  ابْنُ مُلْجَمٍ  عَلَى  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - قَالَ : يَا عَدُوَّ اللهِ ، أَلَمْ أُحْسِنْ إِلَيْكَ ؟ أَلَمْ أَفْعَلْ بِكَ ؟ قَالَ : بَلَى ، قَالَ : فَمَا حَمَلَكَ عَلَى هَذَا ؟ قَالَ : شَحَذْتُهُ أَرْبَعِينَ صَبَاحًا ، فَسَأَلْتُ اللهَ أَنْ يَقْتُلَ بِهِ شَرَّ خَلْقِهِ ، قَالَ لَهُ  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُ - : مَا أُرَاكَ إِلَّا مَقْتُولًا بِهِ ، وَمَا أُرَاكَ إِلَّا مِنْ شَرِّ خَلْقِ اللهِ ، وَكَانَ  ابْنُ مُلْجَمٍ  مَكْتُوفًا بَيْنَ يَدَيِ         [1/100]      الْحَسَنِ  ، إِذْ نَادَتْهُ  أُمُّ كُلْثُومٍ بِنْتُ عَلِيٍّ  وَهِيَ تَبْكِي : يَا عَدُوَّ اللهِ ، إِنَّهُ لَا بَأْسَ عَلَى أَبِي ، وَاللهُ مُخْزِيكَ ، قَالَ : فَعَلَامَ تَبْكِينَ ؟ وَاللهِ لَقَدِ اشْتَرَيْتُهُ بِأَلْفٍ ، وَسَمَّمْتُهُ بِأَلْفٍ ، وَلَوْ كَانَتْ هَذِهِ الضَّرْبَةُ لِجَمِيعِ أَهْلِ الْمِصْرِ مَا بَقِيَ مِنْهُمْ أَحَدٌ سَاعَةً ، وَهَذَا أَبُوكِ بَاقِيًا حَتَّى الْآنَ ، فَقَالَ  عَلِيٌّ  لِلْحَسَنِ  - رَضِيَ اللهُ عَنْهُمَا - : إِنْ بَقِيتُ رَأَيْتُ فِيهِ رَأْيِي ، وَإِنْ هَلَكْتُ مِنْ ضَرْبَتِي هَذِهِ فَاضْرِبْهُ ضَرْبَةً ، وَلَا تُمَثِّلْ بِهِ ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَنْهَى عَنِ  الْمُثْلَةِ  وَلَوْ بِالْكَلْبِ  الْعَقُورِ  وَذَكَرَ أَنَّ  جُنْدُبَ بْنَ عَبْدِ اللهِ  دَخَلَ عَلَى  عَلِيٍّ  يَسْأَلُ بِهِ ، فَقَالَ : يَا أَمِيرَ الْمُؤْمِنِينَ ، إِنْ فَقَدْنَاكَ وَلَا نَفْقُدُكَ  فَنُبَايِعُ  الْحَسَنَ  ؟ قَالَ : مَا آمُرُكُمْ ، وَلَا أَنْهَاكُمْ ، أَنْتُمْ أَبْصَرُ ، فَلَمَّا قُبِضَ  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُ - بَعَثَ  الْحَسَنُ  - رَضِيَ اللهُ عَنْهُ - إِلَى  ابْنِ مُلْجَمٍ  ، فَأُدْخِلَ عَلَيْهِ ، فَقَالَ لَهُ  ابْنُ مُلْجَمٍ  : هَلْ لَكَ فِي  خَصْلَةٍ  ؟ إِنِّي وَاللهِ مَا أَعْطَيْتُ اللهَ عَهْدًا إِلَّا وَفَّيْتُ بِهِ ، إِنِّي كُنْتُ أَعْطَيْتُ اللهَ عَهْدًا أَنْ أَقْتُلَ  عَلِيًّا  وَمُعَاوِيَةَ  أَوْ أَمُوتَ دُونَهُمَا ، فَإِنْ شِئْتَ خَلَّيْتَ بَيْنِي وَبَيْنَهُ ، وَلَكَ اللهَ عَلَيَّ إِنْ لَمْ أُقْتَلْ أَنْ آتِيَكَ حَتَّى أَضَعَ يَدِي فِي يَدِكَ ، فَقَالَ لَهُ  الْحَسَنُ  - رَضِيَ اللهُ عَنْهُ - : لَا وَاللهِ أَوْ تُعَايِنُ النَّارَ ، فَقَدَّمَهُ فَقَتَلَهُ ، ثُمَّ أَخَذَهُ النَّاسُ فَأَدْرَجُوهُ فِي بَوَارِي ، ثُمَّ أَحْرَقُوهُ بِالنَّارِ ، وَقَدْ كَانَ  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُ - قَالَ : يَا  بَنِي عَبْدِ الْمُطَّلِبِ  لَا أُلْفِيَنَّكُمْ تَخُوضُونَ دِمَاءَ الْمُسْلِمِينَ ، تَقُولُونَ : قُتِلَ أَمِيرُ الْمُؤْمِنِينَ ، قُتِلَ أَمِيرُ الْمُؤْمِنِينَ ، أَلَا لَا يُقْتَلُ بِي إِلَّا قَاتِلِي .  وَأَمَّا  الْبُرْكُ بْنُ عَبْدِ اللهِ  فَقَعَدَ  لِمُعَاوِيَةَ  - رَضِيَ اللهُ عَنْهُ - فَخَرَجَ لِصَلَاةِ الْغَدَاةِ ، فَشَدَّ عَلَيْهِ بِسَيْفِهِ وَأَدْبَرَ  مُعَاوِيَةُ  هَارِبًا ، فَوَقَعَ السَّيْفُ فِي أَلْيَتِهِ ، فَقَالَ : إِنَّ عِنْدِي خَبَرًا أُبَشِّرُكَ بِهِ ، فَإِنْ أَخْبَرْتُكَ أَنَافِعِي ذَلِكَ عِنْدَكَ ؟ قَالَ : وَمَا هُوَ ؟ قَالَ : إِنَّ أَخًا لِي قَتَلَ  عَلِيًّا  فِي هَذِهِ اللَّيْلَةِ ، قَالَ : فَلَعَلَّهُ لَمْ يَقْدِرْ عَلَيْهِ ؟ قَالَ : بَلَى ، إِنَّ  عَلِيًّا  يَخْرُجُ لَيْسَ مَعَهُ أَحَدٌ يَحْرُسُهُ ، فَأَمَرَ بِهِ  مُعَاوِيَةُ  - رَضِيَ اللهُ عَنْهُ - فَقُتِلَ ، فَبَعَثَ إِلَى  السَّاعِدِيِّ  ، وَكَانَ طَبِيبًا ، فَنَظَرَ إِلَيْهِ فَقَالَ : إِنَّ ضَرْبَتَكَ مَسْمُومَةٌ ، فَاخْتَرْ مِنِّي إِحْدَى  خَصْلَتَيْنِ  : إِمَّا أَنْ أَحْمِيَ حَدِيدَةً فَأَضَعَهَا مَوْضِعَ السَّيْفِ ، وَإِمَّا أَسْقِيَكَ شَرْبَةً تَقْطَعُ مِنْكَ الْوَلَدَ ، وَتَبْرَأُ مِنْهَا ، فَإِنَّ ضَرْبَتَكَ مَسْمُومَةٌ ، فَقَالَ لَهُ  مُعَاوِيَةُ  : أَمَّا النَّارُ فَلَا صَبْرَ لِي عَلَيْهَا ، وَأَمَّا انْقِطَاعُ الْوَلَدِ         [1/101]      فَإِنَّ فِي  يَزِيدَ  ،  وَعَبْدِ اللهِ  ، وَوَلَدِهِمَا مَا تَقَرُّ بِهِ عَيْنَيَّ ، فَسَقَاهُ تِلْكَ اللَّيْلَةَ الشَّرْبَةَ ، فَبَرَأَ فَلَمْ يُولَدْ بَعْدُ لَهُ ، فَأَمَرَ  مُعَاوِيَةُ  - رَضِيَ اللهُ عَنْهُ - بَعْدَ ذَلِكَ بِالْمَقْصُورَاتِ ، وَقِيَامِ الشُّرَطِ عَلَى رَأْسِهِ .  وَقَالَ  عَلِيٌّ  لِلْحَسَنِ  وَالْحُسَيْنِ  - رَضِيَ اللهُ عَنْهُمْ - : أَيْ بَنِيَّ أُوصِيكُمَا بِتَقْوَى اللهِ ، وَإِقَامِ الصَّلَاةِ لِوَقْتِهَا ، وَإِيتَاءِ الزَّكَاةِ عِنْدَ مَحِلِّهَا ، وَحُسْنِ الْوُضُوءِ ، فَإِنَّهُ لَا يُقْبَلُ صَلَاةٌ إِلَّا بِطُهُورٍ ، وَأُوصِيكُمْ بِغَفْرِ الذَّنْبِ ،  وَكَظْمِ  الْغَيْظِ ، وَصِلَةِ الرَّحِمِ ، وَالْحِلْمِ عَنِ الْجَهْلِ ، وَالتَّفَقُّهِ فِي الدِّينِ ، وَالتَّثَبُّتِ فِي الْأَمْرِ ، وَتَعَاهُدِ الْقُرْآنِ ، وَحُسْنِ الْجِوَارِ ، وَالْأَمْرِ بِالْمَعْرُوفِ ، وَالنَّهْيِ عَنِ الْمُنْكَرِ ، وَاجْتِنَابِ الْفَوَاحِشِ ، قَالَ : ثُمَّ نَظَرَ إِلَى  مُحَمَّدِ بْنِ الْحَنَفِيَّةِ  فَقَالَ : هَلْ حَفِظْتَ مَا أَوْصَيْتُ بِهِ أَخَوَيْكَ ؟ قَالَ : نَعَمْ ، قَالَ : فَإِنِّي أُوصِيكَ بِمِثْلِهِ ، وَأُوصِيكَ بِتَوْقِيرِ أَخَوَيْكَ لِعِظَمِ حَقِّهِمَا عَلَيْكَ ، وَتَزْيِينِ أَمْرِهِمَا ، وَلَا تَقْطَعْ أَمْرًا دُونَهُمَا ، ثُمَّ قَالَ لَهُمَا : أُوصِيكُمَا بِهِ ، فَإِنَّهُ شَقِيقُكُمَا ، وَابْنُ أَبِيكُمَا ، وَقَدْ عَلِمْتُمَا أَنَّ أَبَاكُمَا كَانَ يُحِبُّهُ ، ثُمَّ أَوْصَى فَكَانَتْ وَصِيَّتُهُ : بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ ، هَذَا مَا أَوْصَى بِهِ  عَلِيُّ بْنُ أَبِي طَالِبٍ  - رَضِيَ اللهُ عَنْهُ - أَوْصَى أَنَّهُ يَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، وَأَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ ، أَرْسَلَهُ بِالْهُدَى وَدِينِ الْحَقِّ لِيُظْهِرَهُ عَلَى الدِّينِ كُلِّهِ ، وَلَوْ كَرِهَ الْمُشْرِكُونَ ، ثُمَّ إِنَّ صَلَاتِي  وَنُسُكِي  وَمَحْيَايَ وَمَمَاتِي لِلهِ رَبِّ الْعَالَمِينَ ، لَا شَرِيكَ لَهُ ، وَبِذَلِكَ أُمِرْتُ ، وَأَنَا مِنَ الْمُسْلِمِينَ ، ثُمَّ أُوصِيكُمَا يَا  حَسَنُ  ، وَيَا  حُسَيْنُ  ، وَجَمِيعَ أَهْلِي وَوَلَدِي ، وَمَنْ بَلَغَهُ كِتَابِي ، بِتَقْوَى اللهِ رَبِّكُمْ ،         {      وَلا تَمُوتُنَّ إِلا وَأَنْتُمْ مُسْلِمُونَ             *          وَاعْتَصِمُوا بِحَبْلِ اللهِ جَمِيعًا وَلا تَفَرَّقُوا         }      ، فَإِنِّي سَمِعْتُ  أَبَا الْقَاسِمِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : "" إِنَّ صَلَاحَ ذَاتِ الْبَيْنِ أَعْظَمُ مِنْ عَامَّةِ الصَّلَاةِ وَالصِّيَامِ "" وَانْظُرُوا إِلَى ذَوِي أَرْحَامِكُمْ فَصِلُوهُمْ يُهَوِّنِ اللهُ عَلَيْكُمُ الْحِسَابَ ، وَاللهَ اللهَ فِي الْأَيْتَامِ لَا يَضِيعُنَّ بِحَضْرَتِكُمْ ، وَاللهَ اللهَ فِي الصَّلَاةِ فَإِنَّهَا عَمُودُ دِينِكُمْ         [1/102]      وَاللهَ اللهَ فِي الزَّكَاةِ فَإِنَّهَا تُطْفِئُ غَضَبَ الرَّبِّ - عَزَّ وَجَلَّ - وَاللهَ اللهَ فِي الْفُقَرَاءِ وَالْمَسَاكِينِ فَأَشْرِكُوهُمْ فِي مَعَايِشِكُمْ ، وَاللهَ اللهَ فِي الْقُرْآنِ فَلَا يَسْبِقَنَّكُمْ بِالْعَمَلِ بِهِ غَيْرُكُمْ ، وَاللهَ اللهَ فِي  الْجِهَادِ  فِي  سَبِيلِ  اللهِ بِأَمْوَالِكُمْ وَأَنْفُسِكُمْ ، وَاللهَ اللهَ فِي بَيْتِ رَبِّكُمْ - عَزَّ وَجَلَّ - لَا يَخْلُوَنَّ مَا بَقِيتُمْ ، فَإِنَّهُ إِنْ تُرِكَ لَمْ تَنَاظَرُوا ، وَاللهَ اللهَ فِي أَهْلِ ذِمَّةِ نَبِيِّكُمْ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَا يُظْلَمُنَّ بَيْنَ  ظَهْرَانَيْكُمْ  ، وَاللهَ اللهَ فِي جِيرَانِكُمْ فَإِنَّهُمْ وَصِيَّةُ نَبِيِّكُمْ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : "" مَا زَالَ  جِبْرِيلُ  يُوصِينِي بِهِمْ حَتَّى ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُمْ "" وَاللهَ اللهَ فِي أَصْحَابِ نَبِيِّكُمْ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَإِنَّهُ وَصَّى بِهِمْ ، وَاللهَ اللهَ فِي  الضَّعِيفَيْنِ  : نِسَائِكُمْ ، وَمَا مَلَكَتْ أَيْمَانُكُمْ ، فَإِنَّ آخِرَ مَا تَكَلَّمَ بِهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ قَالَ : "" أُوصِيكُمْ بِالضَّعِيفَيْنِ : النِّسَاءِ ، وَمَا  مَلَكَتْ  أَيْمَانُكُمْ "" الصَّلَاةَ الصَّلَاةَ ، لَا تَخَافُنَّ فِي اللهِ لَوْمَةَ لَائِمٍ ، يَكْفِكُمْ مَنْ أَرَادَكُمْ وَبَغَى عَلَيْكُمْ ، وَقُولُوا لِلنَّاسِ حُسْنًا كَمَا أَمَرَكُمُ اللهُ ، وَلَا تَتْرُكُوا الْأَمْرَ بِالْمَعْرُوفِ وَالنَّهْيَ عَنِ الْمُنْكَرِ ، فَيُوَلِّيَ أَمْرَكُمْ شِرَارَكُمْ ، ثُمَّ تَدْعُونَ فَلَا يُسْتَجَابُ لَكُمْ ، عَلَيْكُمْ بِالتَّوَاصُلِ ، وَالتَّبَاذُلِ ، وَإِيَّاكُمْ وَالتَّقَاطُعَ ، وَالتَّدَابُرَ ، وَالتَّفَرُّقَ ،         {      وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَى وَلا تَعَاوَنُوا عَلَى الإِثْمِ وَالْعُدْوَانِ وَاتَّقُوا اللهَ إِنَّ اللهَ شَدِيدُ الْعِقَابِ         }      ، حَفِظَكُمُ اللهُ مِنْ أَهْلِ بَيْتٍ ، وَحَفِظَ فِيكُمْ نَبِيَّكُمْ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَسْتَوْدِعُكُمُ اللهَ وَأَقْرَأُ عَلَيْكُمُ السَّلَامَ ، ثُمَّ لَمْ يَنْطِقْ إِلَّا بِلَا إِلَهَ إِلَّا اللهُ حَتَّى قُبِضَ فِي شَهْرِ رَمَضَانَ ، فِي سَنَةِ أَرْبَعِينَ ، وَغَسَّلَهُ  الْحَسَنُ  وَالْحُسَيْنُ  وَعَبْدُ اللهِ بْنُ جَعْفَرٍ  ، وَكُفِّنَ فِي ثَلَاثَةِ أَثْوَابٍ لَيْسَ فِيهَا قَمِيصٌ ، وَكَبَّرَ عَلَيْهِ  الْحَسَنُ  تِسْعَ تَكْبِيرَاتٍ ، وَوَلِيَ  الْحَسَنُ -  رَضِيَ اللهُ عَنْهُ - عَمَلَهُ سِتَّةَ أَشْهُرٍ ، وَكَانَ  ابْنُ مُلْجَمٍ  قَبْلَ أَنْ يَضْرِبَ  عَلِيًّا  قَاعِدًا فِي  بَنِي بَكْرِ بْنِ وَائِلٍ  ، إِذْ مُرَّ عَلَيْهِ بِجِنَازَةِ  أَبْجَرَ بْنِ جَابِرٍ الْعِجْلِيِّ أَبِي حَجَّارٍ  ، وَكَانَ نَصْرَانِيًّا ، وَالنَّصَارَى حَوْلَهُ ، وَأُنَاسٌ مَعَ  حَجَّارٍ  بِمَنْزِلَتِهِ فِيهِمْ ، يَمْشُونَ فِي جَانِبٍ ، أَمَامَهُمْ  شَقِيقُ بْنُ ثَوْرٍ السُّلَمِيُّ  ، فَلَمَّا رَآهُمْ قَالَ : مَا هَؤُلَاءِ ؟ فَأُخْبِرَ ، ثُمَّ أَنْشَأَ يَقُولُ :         [1/103]      وَقَالَ  ابْنُ أَبِي عَيَّاشٍ الْمُرَادِيُّ  :  وَقَيْنَةٌ  وَقَالَ  أَبُو الْأَسْوَدِ الدُّؤَلِيُّ  :  قَرَّتْ  الشَّامِتِينَا  الشَّهْرِ  وَخَيَّسَهَا  وَأَمَّا  عَمْرُو بْنُ بَكْرٍ  فَقَعَدَ  لِعَمْرِو بْنِ الْعَاصِ  - رَحِمَهُ اللهُ - فِي تِلْكَ اللَّيْلَةِ الَّتِي ضُرِبَ فِيهَا  مُعَاوِيَةُ  ، فَلَمْ يَخْرُجْ وَكَانَ اشْتَكَى بَطْنَهُ ، فَأَمَرَ  خَارِجَةَ بْنَ أَبِي حَبِيبٍ  ، وَكَانَ صَاحِبَ شُرْطَتِهِ ، وَكَانَ مِنْ  بَنِي عَامِرِ بْنِ لُؤَيٍّ ،  فَخَرَجَ         [1/104]      يُصَلِّي بِالنَّاسِ ، فَشَدَّ عَلَيْهِ وَهُوَ يَرَى أَنَّهُ  عَمْرُو بْنُ الْعَاصِ  فَضَرَبَهُ بِالسَّيْفِ فَقَتَلَهُ ، فَأُخِذَ وَأُدْخِلَ عَلَى  عَمْرٍو  ، فَلَمَّا رَآهُمْ يُسَلِّمُونَ عَلَيْهِ بِالْإِمْرَةِ قَالَ : مَنْ هَذَا ؟ قَالُوا :  عَمْرُو بْنُ الْعَاصِ  ، قَالَ : فَمَنْ قَتَلْتُ ؟ قَالُوا :  خَارِجَةَ  ، قَالَ : أَمَا وَاللهِ يَا فَاسِقُ مَا ضَمَّدْتُ غَيْرَكَ ، قَالَ  عَمْرٌو  : أَرَدْتَنِي ، وَاللهُ أَرَادَ  خَارِجَةَ  ، فَقَدَّمَهُ فَقَتَلَهُ ، فَبَلَغَ ذَلِكَ  مُعَاوِيَةَ  - رَضِيَ اللهُ عَنْهُ - فَكَتَبَ إِلَيْهِ :  وَكَانَ الَّذِي ذَهَبَ بِنَعْيِهِ  سُفْيَانُ بْنُ عَبْدِ شَمْسِ بْنِ أَبِي وَقَّاصٍ الزُّهْرِيُّ  ، وَقَدْ كَانَ  الْحَسَنُ  بَعَثَ  قَيْسَ بْنَ سَعْدِ بْنِ عُبَادَةَ  عَلَى تَقْدِمَتِهِ فِي اثْنَيْ عَشَرَ أَلْفًا ، وَخَرَجَ  مُعَاوِيَةُ  حَتَّى نَزَلَ  إِيلِيَاءَ  فِي ذَلِكَ الْعَامِ ، وَخَرَجَ  الْحُسَيْنُ  - رَضِيَ اللهُ عَنْهُ - ، حَتَّى نَزَلَ فِي الْقُصُورِ الْبِيضِ فِي  الْمَدَائِنِ  ، وَخَرَجَ  مُعَاوِيَةُ  حَتَّى نَزَلَ مَسْكَنًا ، وَكَانَ عَلَى  الْمَدَائِنِ  عَمُّ  الْمُخْتَارِ  لِابْنِ أَبِي عُبَيْدٍ  ، وَكَانَ يُقَالُ لَهُ :  سَعْدُ بْنُ مَسْعُودٍ  ، فَقَالَ لَهُ  الْمُخْتَارُ  وَهُوَ يَوْمَئِذٍ غُلَامٌ : هَلْ لَكَ فِي الْغِنَى وَالشَّرَفِ ؟ قَالَ : وَمَا ذَاكَ ؟ قَالَ : تُوثِقُ  الْحَسَنَ  وَتَسْتَأْمِنْ بِهِ إِلَى  مُعَاوِيَةَ  ، فَقَالَ لَهُ  سَعْدٌ  : عَلَيْكَ لَعْنَةُ اللهِ ، أَأَثِبُ عَلَى ابْنِ بِنْتِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأُوثِقُهُ ؟ بِئْسَ الرَّجُلُ أَنْتَ ، فَلَمَّا رَأَى  الْحَسَنُ  - رَضِيَ اللهُ عَنْهُ - تَفَرُّقَ النَّاسِ عَنْهُ بَعَثَ إِلَى  مُعَاوِيَةَ  يَطْلُبُ الصُّلْحَ ، فَبَعَثَ إِلَيْهِ         [1/105]      مُعَاوِيَةُ  عَبْدَ اللهِ بْنَ عَامِرٍ  وَعَبْدَ اللهِ بْنَ سَمُرَةَ بْنِ حَبِيبِ بْنِ عَبْدِ شَمْسٍ  فَقَدِمَا عَلَى  الْحَسَنِ  بِالْمَدَائِنِ  ، فَأَعْطَيَاهُ مَا أَرَادَ وَصَالَحَاهُ ، ثُمَّ قَامَ  الْحَسَنُ  - رَضِيَ اللهُ عَنْهُ - فِي النَّاسِ ، وَقَالَ : يَا  أَهْلَ الْعِرَاقِ  ، إِنَّهُ مِمَّا يُسْخِئُ بِنَفْسِي عَنْكُمْ ثَلَاثٌ : قَتْلُكُمْ أَبِي ، وَطَعْنُكُمْ إِيَّايَ ، وَانْتِهَابُكُمْ مَتَاعِي ، وَدَخَلَ فِي طَاعَةِ  مُعَاوِيَةَ  رَحِمَهُمَا اللهُ ، وَدَخَلَ  الْكُوفَةَ  فَبَايَعَهُ النَّاسُ  .","","Al-Mu'jam al-Kabir 168","","علي بن أبي طالب عن إسماعيل بن أبي إسماعيل السلمي عن عثمان بن عبد الرحمن الطرائفي عن عمرو بن هشام بن بزين الحراني عن أحمد بن علي بن مسلم النخشبي عن الطبراني","سن علي بن أبي طالب ووفاته رضي الله عنه"
"168","169  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  فِطْرُ بْنُ خَلِيفَةَ ،  عَنْ  أَبِي الطُّفَيْلِ ، قَالَ :  دَعَاهُمْ عَلِيٌّ - رَضِيَ اللهُ عَنْهُ - إِلَى الْبَيْعَةِ  ، فَجَاءَ فِيهِمْ  عَبْدُ الرَّحْمَنِ بْنُ مُلْجَمٍ  ، وَقَدْ كَانَ رَآهُ قَبْلَ ذَلِكَ مَرَّتَيْنِ ، ثُمَّ  قَالَ  : "" مَا يَحْبِسُ أَشْقَاهَا ، وَالَّذِي نَفْسِي بِيَدِهِ لَيَخْضِبَنَّ هَذِهِ مِنْ هَذِهِ ، وَتَمَثَّلَ بِهَذَيْنِ الْبَيْتَيْنِ :  حَيَازِيمَكَ  .","","Al-Mu'jam al-Kabir 169","","علي بن أبي طالب عن عامر بن واثلة عن فطر بن خليفة عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","سن علي بن أبي طالب ووفاته رضي الله عنه"
"169","170  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِدْرِيسَ بْنِ عَاصِمٍ الْجَمَّالُ الْبَغْدَادِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  أَنَا  يَعْلَى بْنُ عُبَيْدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي رَاشِدٍ ، قَالَ : جَاءَ رِجَالٌ مِنْ  أَهْلِ الْبَصْرَةِ  إِلَى عُبَيْدِ بْنِ عُمَيْرٍ ، فَقَالُوا :  إِنَّ إِخْوَانَكَ مِنْ  أَهْلِ الْبَصْرَةِ  يَسْأَلُونَكَ عَنْ  عَلِيٍّ  وَعُثْمَانَ  - رَضِيَ اللهُ عَنْهُمَا  - فَقَالَ : "" وَمَا أَقْدَمَكُمْ شَيْءٌ غَيْرُ هَذَا ؟ "" قَالُوا : نَعَمْ ، قَالَ :         {      تِلْكَ أُمَّةٌ قَدْ خَلَتْ لَهَا مَا كَسَبَتْ وَلَكُمْ مَا كَسَبْتُمْ وَلا تُسْأَلُونَ عَمَّا كَانُوا يَعْمَلُونَ         }      .","","Al-Mu'jam al-Kabir 170","","عبيد بن عمير بن قتادة الجندعي عن أبو راشد عن الأعمش عن يعلى بن عبيد الطنافسي عن إسحاق ابن راهويه عن محمد بن إدريس بن عاصم الجمال البغدادي عن الطبراني","سن علي بن أبي طالب ووفاته رضي الله عنه"
"170","171  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ،  ثَنَا  عَلِيُّ بْنُ مَعْبَدٍ  ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ         [1/106]      عَمْرٍو  ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ  ، قَالَ : ""  قُتِلَ  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُ - سَنَةَ أَرْبَعِينَ  "" .","","Al-Mu'jam al-Kabir 171","","","سن علي بن أبي طالب ووفاته رضي الله عنه"
"171","172  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ  ، قَالَ : ""  قُتِلَ  عَلِيٌّ  سَنَةَ أَرْبَعِينَ  ، وَكَانَتْ خِلَافَتُهُ خَمْسَ سِنِينَ وَسِتَّةَ أَشْهُرٍ  "" .","","Al-Mu'jam al-Kabir 172","","","سن علي بن أبي طالب ووفاته رضي الله عنه"
"172","173  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ، وَمُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ بْنُ سَعْدٍ ،  حَدَّثَنِي  خَالِدُ بْنُ يَزِيدَ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ، أَنَّ أَبَا سِنَانٍ الدُّؤَلِيَّ  حَدَّثَهُ  ، أَنَّهُ  عَادَ عَلِيًّا - رَضِيَ اللهُ عَنْهُ - فِي  شَكْوَةٍ  اشْتَكَاهَا ، فَقُلْتُ لَهُ : لَقَدْ تَخَوَّفْنَا عَلَيْكَ يَا  أَبَا الْحَسَنِ  فِي  شَكْوِكَ  هَذَا ، فَقَالَ : وَلَكِنِّي وَاللهِ مَا تَخَوَّفْتُ عَلَى نَفْسِي مِنْهُ ؛ لِأَنِّي سَمِعْتُ الصَّادِقَ الْمَصْدُوقَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّكَ سَتُضْرَبُ ضَرْبَةً هَاهُنَا  ، وَضَرْبَةً هَاهُنَا "" - وَأَشَارَ إِلَى صُدْغَيْهِ - "" فَيَسِيلُ دَمُهَا حَتَّى يَخْضِبَ لِحْيَتَكَ ، وَيَكُونُ صَاحِبُهَا أَشْقَاهَا كَمَا كَانَ عَاقِرُ النَّاقَةِ أَشْقَى  ثَمُودَ  "" .","","Al-Mu'jam al-Kabir 173","","علي بن أبي طالب عن يزيد بن أمية الدؤلي عن زيد بن أسلم عن سعيد بن أبي هلال الليثي عن خالد بن يزيد الجمحي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","سن علي بن أبي طالب ووفاته رضي الله عنه"
"173","174  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ ،  ثَنَا  مُوسَى بْنُ دَاوُدَ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنِ  الْحَجَّاجِ ،  عَنِ  الْحَكَمِ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  دَفَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الرَّايَةَ  إِلَى  عَلِيِّ بْنِ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ وَهُوَ ابْنُ عِشْرِينَ سَنَةً  .","","Al-Mu'jam al-Kabir 174","","عبد الله بن عباس عن مقسم بن بجرة عن الحكم بن عتيبة الكندي عن حجاج بن أرطاة عن قيس بن الربيع الأسدي عن موسى بن داود الخلقاني عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","سن علي بن أبي طالب ووفاته رضي الله عنه"
"174","وَمَا أَسْنَدَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ  175  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَيُّوبَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  عَنْ  عَلِيٍّ - رَضِيَ اللهُ عَنْهُ - قَالَ :  تَزَوَّجْتُ  فَاطِمَةَ  ، فَقُلْتُ : يَا رَسُولَ اللهِ ابْنِنِي ؟ قَالَ :  عِنْدَكَ شَيْءٌ تُعْطِيهَا ؟  فَقُلْتُ : لَا ، قَالَ : "" أَيْنَ دِرْعُكَ  الْحُطَمِيَّةُ  ؟ "" قُلْتُ :         [1/107]      عِنْدِي ، قَالَ : "" أَعْطِهَا إِيَّاهَا  "" .","","Al-Mu'jam al-Kabir 175","","علي بن أبي طالب عن عبد الله بن عباس عن عكرمة مولى ابن عباس عن أيوب السختياني عن حماد بن سلمة عن أبو الوليد الطيالسي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","وما أسند علي بن أبي طالب رضي الله عنه"
"175","176  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَمْرُو بْنُ حَمَّادِ بْنِ طَلْحَةَ الْقَنَّادُ ،  ثَنَا  أَسْبَاطُ بْنُ نَصْرٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ  ،  أَنَّ  عَلِيًّا - رَضِيَ اللهُ عَنْهُ - كَانَ يَقُولُ فِي حَيَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" إِنَّ اللهَ - عَزَّ وَجَلَّ - يَقُولُ :         {      أَفَإِنْ مَاتَ أَوْ قُتِلَ انْقَلَبْتُمْ عَلَى أَعْقَابِكُمْ         }      ، وَاللهِ لَا نَنْقَلِبُ عَلَى أَعْقَابِنَا بَعْدَ إِذْ هَدَانَا اللهُ  ، وَاللهِ لَئِنْ مَاتَ أَوْ قُتِلَ لَأُقَاتِلَنَّ عَلَى مَا قَاتَلَ عَلَيْهِ حَتَّى أَمُوتَ ، وَاللهِ إِنِّي لَأَخُوهُ وَوَلِيُّهُ ، وَابْنُ عَمِّهِ ، وَوَارِثُهُ ، فَمَنْ أَحَقُّ بِهِ مِنِّي "" .","","Al-Mu'jam al-Kabir 176","","علي بن أبي طالب عن عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن أسباط بن نصر الهمداني عن عمرو بن حماد القناد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","وما أسند علي بن أبي طالب رضي الله عنه"
"176","177  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ الْحَكَمِ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  أَبِي مُوسَى  ، أَنَّ  عَلِيًّا - رَضِيَ اللهُ عَنْهُ - قَالَ :  أَلَا أُخْبِرُكُمْ بِخَيْرِ هَذِهِ الْأُمَّةِ بَعْدَ نَبِيِّهَا  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ "" قَالُوا : بَلَى ، قَالَ : ""  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - "" ثُمَّ قَالَ : "" أَلَا أُخْبِرُكُمْ بِخَيْرِ هَذِهِ الْأُمَّةِ بَعْدَ  أَبِي بَكْرٍ  ؟ "" قَالُوا : بَلَى ، قَالَ : ""  عُمَرُ ،  وَلَوْ شِئْتُ لَأَخْبَرْتُكُمْ بِالثَّالِثِ  "" .","","Al-Mu'jam al-Kabir 177","","علي بن أبي طالب عن أبو موسى الأشعري عن أبو عثمان النهدي عن علي بن الحكم البناني عن حماد بن سلمة عن موسى بن إسماعيل التبوذكي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","وما أسند علي بن أبي طالب رضي الله عنه"
"177","178  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  حَدَّثَنَا  هَارُونُ بْنُ سَلْمَانَ الْفَرَّاءُ ، مَوْلَى عَمْرِو بْنِ حُرَيْثٍ ،  حَدَّثَنِي  عَمْرُو بْنُ حُرَيْثٍ ،  عَنْ  عَلِيٍّ - رَضِيَ اللهُ عَنْهُ -  أَنَّهُ كَانَ قَاعِدًا عَلَى الْمِنْبَرِ فَذَكَرَ  أَبَا بَكْرٍ  وَعُمَرَ  - رَضِيَ اللهُ عَنْهُمَا - فَقَالَ :  إِنَّ خَيْرَ هَذِهِ الْأُمَّةِ بَعْدَ نَبِيِّهَا - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَبُو بَكْرٍ  ، وَالثَّانِي  عُمَرُ  ، وَلَوْ أَشَاءُ أَنْ أَذْكُرَ الثَّالِثَ ذَكَرْتُهُ  "" .","","Al-Mu'jam al-Kabir 178","","علي بن أبي طالب عن عمرو بن حريث بن عمرو المخزومي عن هارون بن سلمان المخزومي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","وما أسند علي بن أبي طالب رضي الله عنه"
"178","179  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  أَبُو حُذَيْفَةَ الثَّعْلَبِيُّ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ السُّوَائِيِّ ،  عَنْ  عَلِيٍّ - رَضِيَ اللهُ عَنْهُ - : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  سَأَلْتُ رَبِّي - عَزَّ وَجَلَّ - ثَلَاثَ خِصَالٍ لِأُمَّتِي فَأَعْطَانِي اثْنَتَيْنِ ، وَمَنَعَنِي وَاحِدَةً  ، قُلْتُ : يَا رَبِّ لَا تُهْلِكْ أُمَّتِي جُوعًا ، قَالَ : هَذِهِ ، قُلْتُ : يَا رَبِّ لَا تُسَلِّطْ عَلَيْهِمْ عَدُوًّا مِنْ غَيْرِهِمْ - يَعْنِي أَهْلَ  الشِّرْكِ  - فَيَجْتَاحَهُمْ ، قَالَ : لَكَ ذَلِكَ ، قُلْتُ : يَا رَبِّ لَا تَجْعَلْ بَأْسَهُمْ بَيْنَهُمْ ، فَمَنَعَنِي         [1/108]      هَذِهِ  "" .","","Al-Mu'jam al-Kabir 179","","علي بن أبي طالب عن جابر بن سمرة السوائي عن زياد بن علاقة الثعلبي عن حماد بن عمير الثعلبي عن منجاب بن الحارث التميمي عن محمد بن عثمان بن أبي شيبة عن الطبراني","وما أسند علي بن أبي طالب رضي الله عنه"
"179","180  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَبْدُ الْحَمِيدِ بْنُ بَحْرٍ الزَّهْرَانِيُّ ،  ثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  بَيَانٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أَبِي جُحَيْفَةَ ،  عَنْ  عَلِيٍّ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا كَانَ يَوْمُ الْقِيَامَةِ قِيلَ : يَا أَهْلَ الْجَمْعِ  غُضُّوا أَبْصَارَكُمْ حَتَّى تَمُرَّ  فَاطِمَةُ بِنْتُ مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَتَمُرُّ وَعَلَيْهَا  رَيْطَتَانِ  خَضْرَاوَانِ -رَضِيَ اللهُ عَنْهَا  -  "" .","","Al-Mu'jam al-Kabir 180","","علي بن أبي طالب عن وهب بن عبد الله السوائي عن الشعبي عن بيان بن بشر الأحمسي عن خالد بن عبد الله الطحان عن عبد الحميد بن بحر الكوفي عن أبو مسلم الكجي عن الطبراني","وما أسند علي بن أبي طالب رضي الله عنه"
"180","181  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ  ، ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  جَابِرٍ ،  عَنْ  أَبِي الطُّفَيْلِ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَعَنَ اللهُ  سُهَيْلًا  ثَلَاثَ مِرَارٍ  ، فَإِنَّهُ كَانَ  يُعْشِرُ  النَّاسَ فِي الْأَرْضِ فَمَسَخَهُ اللهُ شِهَابًا  "" .","","Al-Mu'jam al-Kabir 181","","علي بن أبي طالب عن عامر بن واثلة عن جابر الجعفي عن سفيان الثوري عن موسى بن مسعود النهدي عن حفص بن عمر سنجة ألف عن الطبراني","وما أسند علي بن أبي طالب رضي الله عنه"
"181","182  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَالِمٍ الْقَزَّازُ ،  حَدَّثَنَا  حُسَيْنُ بْنُ زَيْدِ بْنِ عَلِيٍّ ،  عَنْ  عَلِيِّ بْنِ عُمَرَ بْنِ عَلِيٍّ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَلِيِّ بْنِ الْحُسَيْنِ ،  عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ - رَضِيَ اللهُ عَنْهُ -  عَنْ  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِفَاطِمَةَ  - رَضِيَ اللهُ عَنْهَا - :  إِنَّ اللهَ يَغْضَبُ لِغَضَبِكِ  ، وَيَرْضَى لِرِضَاكِ  "" .","","Al-Mu'jam al-Kabir 182","","علي بن أبي طالب عن الحسين بن علي عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جعفر الصادق عن علي بن عمر بن علي بن الحسين بن علي بن أبي طالب عن الحسين بن زيد بن علي بن الحسين بن علي بن أبي طالب عن عبد الله بن سالم المفلوج عن محمد بن عبد الله مطين الحضرمي عن الطبراني","وما أسند علي بن أبي طالب رضي الله عنه"
"182","[1/109]      183  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  يُونُسُ بْنُ رَاشِدٍ ،  عَنْ  عَوْنِ بْنِ مُحَمَّدِ بْنِ الْحَنَفِيَّةِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ عَلِيِّ بْنِ أَبِي طَالِبٍ  - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  عَلَيْكُمْ بِالْإِثْمِدِ  فَإِنَّهُ مَنْبَتَةٌ لِلشَّعَرِ مَذْهَبَةٌ لِلْقَذَا ، مَصْفَاةٌ لِلْبَصَرِ  "" .","","Al-Mu'jam al-Kabir 183","","علي بن أبي طالب عن ابن الحنفية عن عون بن محمد بن على الهاشمي عن يونس بن راشد الجزري عن عبد الله بن محمد النفيلي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","وما أسند علي بن أبي طالب رضي الله عنه"
"183","184  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ مَنْصُورٍ الرُّمَّانِيُّ  ، ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  يُونُسُ بْنُ رَاشِدٍ ،  عَنْ  عَوْنِ بْنِ مُحَمَّدِ بْنِ الْحَنَفِيَّةِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  لَا أَعْلَمُنَا إِلَّا خَرَجْنَا حُجَّاجًا مُهِلِّينَ بِالْحَجِّ  ، فَلَمْ يَحِلَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَا  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - حَتَّى طَافُوا  بِالْبَيْتِ  يَوْمَ النَّحْرِ  ،  وَبِالصَّفَا  وَالْمَرْوَةِ  "" .","","Al-Mu'jam al-Kabir 184","","علي بن أبي طالب عن ابن الحنفية عن عون بن محمد بن على الهاشمي عن يونس بن راشد الجزري عن عبد الله بن محمد النفيلي عن الحسين بن منصور الرماني عن الطبراني","وما أسند علي بن أبي طالب رضي الله عنه"
"184","185  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  عَبْدِ الْأَعْلَى ،  عَنْ  مُحَمَّدِ بْنِ الْحَنَفِيَّةِ ،  عَنْ  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - "" أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُوَاصِلُ مِنْ سَحَرٍ إِلَى سَحَرٍ  .","","Al-Mu'jam al-Kabir 185","","علي بن أبي طالب عن ابن الحنفية عن عبد الأعلى بن عامر الثعلبي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","وما أسند علي بن أبي طالب رضي الله عنه"
"185","186  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْحَكَمُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي نُعَيْمٍ الْبَجَلِيُّ ، قَالَ :  حَدَّثَتْنِي  فَاطِمَةُ بِنْتُ عَلِيِّ بْنِ أَبِي طَالِبٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَتْ :  قَالَ  أَبِي  ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَعْتَقَ  نَسَمَةً  مُسْلِمَةً أَوْ مُؤْمِنَةً  وَقَى  اللهُ بِكُلِّ عُضْوٍ مِنْهُ عُضْوًا مِنَ النَّارِ  "" .","","Al-Mu'jam al-Kabir 186","","علي بن أبي طالب عن فاطمة بنت علي بن أبي طالب عن الحكم بن عبد الرحمن بن أبي نعم البجلي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","وما أسند علي بن أبي طالب رضي الله عنه"
"186","5 - نِسْبَةُ  طَلْحَةَ بْنِ عُبَيْدِ اللهِ  - رَضِيَ اللهُ عَنْهُ  187  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ الْبَرْقِيُّ  ،  حَدَّثَنَا  عَبْدُ الْمَلِكِ         [1/110]      بْنُ هِشَامٍ  ، عَنْ  أَبِي عُبَيْدَةَ مَعْمَرِ بْنِ الْمُثَنَّى  ، قَالَ : ""  طَلْحَةُ بْنُ عُبَيْدِ اللهِ بْنِ عُثْمَانَ بْنِ عَامِرِ بْنِ كَعْبِ بْنِ سَعْدِ بْنِ تَيْمِ بْنِ مُرَّةَ بْنِ كَعْبِ بْنِ لُؤَيِّ بْنِ غَالِبِ بْنِ فِهْرِ بْنِ مَالِكٍ  ، وَأُمُّهُ :  الصَّعْبَةُ بِنْتُ الْحَضْرَمِيِّ  ، وَإِنَّمَا قِيلَ :  الْحَضْرَمِيُّ  ؛ لِأَنَّهُ كَانَ بِبِلَادِ  حَضْرَمَوْتَ  ، قَتَلَ بِهَا  عَمْرَو بْنَ نَاهِضٍ الْحِمْيَرِيَّ  ثُمَّ هَرَبَ إِلَى  مَكَّةَ  فَحَالَفَ  حَرْبَ بْنَ أُمَيَّةَ  ، وَاسْمُ  الْحَضْرَمِيِّ : عَبْدُ اللهِ بْنُ عَمَّارِ بْنِ رَبِيعَةَ بْنِ أَكْبَرَ بْنِ عَوْفِ بْنِ مَالِكِ بْنِ عُوَيْفِ بْنِ خَزْرَجِ بْنِ إِيَادِ بْنِ الصَّدَفِ بْنِ حَضْرَمَوْتَ بْنِ قَحْطَانَ بْنِ كِنْدَةَ  ،  الصَّعْبَةُ أُخْتُ الْعَلَاءِ بْنِ الْحَضْرَمِيِّ  ، وَأُمُّهَا  عَاتِكَةُ بِنْتُ وَهْبِ بْنِ عَبْدِ بْنِ قُصَيِّ بْنِ كِلَابِ بْنِ مُرَّةَ بْنِ كَعْبٍ  "" .","","Al-Mu'jam al-Kabir 187","","","نسبة طلحة بن عبيد الله رضي الله عنه"
"187","188  - حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ مُحَمَّدِ بْنِ أَبِي بَكْرٍ الْمُقَدَّمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ شَبِيبٍ  ، ثَنَا  إِبْرَاهِيمُ بْنُ يَحْيَى الشَّجَرِيُّ  ، ثَنَا  أَبِي  ، عَنْ  خَازِمِ بْنِ حُسَيْنٍ  ، عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ  ، عَنِ  الزُّهْرِيِّ  ، عَنْ عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ، عَنِ  ابْنِ عَبَّاسٍ  - رَضِيَ اللهُ عَنْهُمَا - قَالَ : ""  أَسْلَمَتْ  أُمُّ طَلْحَةَ بْنِ عُبَيْدِ اللهِ  "" .","","Al-Mu'jam al-Kabir 188","","","نسبة طلحة بن عبيد الله رضي الله عنه"
"188","189  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ ، قَالَ :  طَلْحَةُ بْنُ عُبَيْدِ اللهِ بْنِ عُثْمَانَ بْنِ عَمْرِو بْنِ كَعْبِ بْنِ سَعْدِ بْنِ تَيْمِ بْنِ مُرَّةَ  ، كَانَ  بِالشَّامِ  فَقَدِمَ ، وَكَلَّمَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَهْمِهِ ، فَضَرَبَ لَهُ بِسَهْمِهِ ، قَالَ :  وَأَجْرِي يَا رَسُولَ اللهِ ؟ قَالَ : "" وَأَجْرُكَ  يَعْنِي  يَوْمَ بَدْرٍ  .","","Al-Mu'jam al-Kabir 189","","عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","نسبة طلحة بن عبيد الله رضي الله عنه"
"189","190  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ، قَالَ : ""  طَلْحَةُ بْنُ عُبَيْدِ اللهِ  يُكْنَى  أَبَا مُحَمَّدٍ  - رَضِيَ اللهُ عَنْهُ  -  "" .","","Al-Mu'jam al-Kabir 190","","","نسبة طلحة بن عبيد الله رضي الله عنه"
"190","[1/111]      صِفَةُ  طَلْحَةَ بْنِ عُبَيْدِ اللهِ  رَضِيَ اللهُ عَنْهُ  191  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ ،  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عِمْرَانَ ،  حَدَّثَنِي  إِسْحَاقُ بْنُ يَحْيَى بْنِ طَلْحَةَ ،  عَنْ  عَمِّهِ  مُوسَى بْنِ طَلْحَةَ  ، قَالَ :  كَانَ طَلْحَةُ بْنُ عُبَيْدِ اللهِ - رَضِيَ اللهُ عَنْهُ - أَبْيَضَ يَضْرِبُ إِلَى الْحُمْرَةِ  ،  مَرْبُوعًا  هُوَ إِلَى الْقِصَرِ أَقْرَبُ رَحْبَ الصَّدْرِ ، عَرِيضَ الْمَنْكِبَيْنِ ، إِذَا  الْتَفَتَ  الْتَفَتَ  جَمِيعًا ، ضَخْمَ الْقَدَمَيْنِ  "" .  قَالَ  الزُّبَيْرُ  :  وَحَدَّثَنِي  - يَعْنِي إِبْرَاهِيمَ بْنَ الْمُنْذِرِ -  عَنِ  الْوَاقِدِيِّ ، قَالَ :  كَانَ طَلْحَةُ بْنُ عُبَيْدِ اللهِ آدَمَ كَثِيرَ الشَّعَرِ  لَيْسَ  بِالْجَعْدِ  ، وَلَا السَّبْطِ ، حَسَنَ الْوَجْهِ ، دَقِيقَ  الْعِرْنِينِ  ، إِذَا مَشَى أَسْرَعَ ، كَانَ لَا يُغَيِّرُ شَيْبَهُ ، قُتِلَ  يَوْمَ الْجَمَلِ  فِي جُمَادَى سَنَةَ سِتٍّ وَثَلَاثِينَ  "" .","","Al-Mu'jam al-Kabir 191","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن إسحاق بن يحيى بن طلحة التيمي عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن إبراهيم بن المنذر الحزامي عن الزبير بن بكار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","صفة طلحة بن عبيد الله رضي الله عنه"
"191","192  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ، قَالَ :  رَأَيْتُ يَدَ طَلْحَةَ بْنِ عُبَيْدِ اللهِ  شَلَّاءَ  وَقَى بِهَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ أُحُدٍ  "" .","","Al-Mu'jam al-Kabir 192","","طلحة بن عبيد الله بن عثمان الفياض عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","صفة طلحة بن عبيد الله رضي الله عنه"
"192","193  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ سُمَيْعٍ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  كَانَتْ إِصْبَعُ طَلْحَةَ بْنِ عُبَيْدِ اللهِ  شَلَّاءَ  "" .","","Al-Mu'jam al-Kabir 193","","طلحة بن عبيد الله بن عثمان الفياض عن سعيد بن المسيب عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن محمد بن عيسى بن القاسم مولى معاوية بن أبي سفيان عن هشام بن عمار عن أحمد بن المعلى الأسدي عن الطبراني","صفة طلحة بن عبيد الله رضي الله عنه"
"193","مِنْ فَضَائِلِهِ رَضِيَ اللهُ عَنْهُ  194  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  قَبِيصَةَ بْنِ جَابِرٍ ، قَالَ :  مَا رَأَيْتُ رَجُلًا قَطُّ أَعْطَى لِجَزِيلٍ مِنَ الْمَالِ مِنْ غَيْرِ مَسْأَلَةٍ مِنْ  طَلْحَةَ بْنِ عُبَيْدِ اللهِ  ، قَالَ         [1/112]      سُفْيَانُ  : وَكَانَ أَهْلُهُ يَقُولُونَ : "" إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَمَّاهُ  الْفَيَّاضَ  "" .","","Al-Mu'jam al-Kabir 194","","قبيصة بن جابر بن وهب الأسدي عن الشعبي عن مجالد بن سعيد عن سفيان بن عيينة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","من فضائله رضي الله عنه"
"194","195  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  طَلْحَةَ بْنِ يَحْيَى ،  عَنْ  جَدَّتِهِ - وَهِيَ امْرَأَتُهُ سُعْدَى - قَالَتْ :  دَخَلَ عَلَيَّ يَوْمًا طَلْحَةُ ، فَرَأَيْتُ مِنْهُ ثِقَلًا  ، فَقُلْتُ : مَا لَكَ ، لَعَلَّ رَابَكَ مِنَّا شَيْءٌ فَنُعْتِبَكَ ؟ قَالَ : "" لَا ، وَلَنِعْمَ حَلِيلَةُ الْمَرْءِ الْمُسْلِمِ أَنْتِ ، وَلَكِنِ اجْتَمَعَ عِنْدِي مَالٌ وَلَا أَدْرِي كَيْفَ أَصْنَعُ بِهِ "" ، قَالَتْ : وَمَا يَغُمُّكَ مِنْهُ ؟ ادْعُ قَوْمَكَ فَاقْسِمْهُ بَيْنَهُمْ ، فَقَالَ : "" يَا غُلَامُ ، عَلَيَّ قَوْمِي "" ، فَسَأَلْتُ  الْخَازِنَ  : كَمْ قَسَمَ ؟ قَالَ : أَرْبَعَمِائَةِ أَلْفٍ  .","","Al-Mu'jam al-Kabir 195","","طلحة بن عبيد الله بن عثمان الفياض عن سعدى بنت عوف المرية عن طلحة بن يحيى بن طلحة التيمي عن سفيان بن عيينة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","من فضائله رضي الله عنه"
"195","196  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، قَالَ :  كَانَتْ غَلَّةُ طَلْحَةَ بْنِ عُبَيْدِ اللهِ كُلَّ يَوْمٍ أَلْفًا وَافِيًا  .","","Al-Mu'jam al-Kabir 196","","طلحة بن عبيد الله بن عثمان الفياض عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","من فضائله رضي الله عنه"
"196","197  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ بْنِ سُلَيْمَانَ بْنِ عِيسَى بْنِ مُوسَى بْنِ طَلْحَةَ بْنِ عُبَيْدِ اللهِ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  أَبِيهِ ، طَلْحَةَ بْنِ عُبَيْدِ اللهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  سَمَّانِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ أُحُدٍ  :  طَلْحَةَ الْخَيْرِ  ، وَفِي غَزْوَةِ  ذِي الْعُشَيْرَةِ  :  طَلْحَةَ الْفَيَّاضَ  ،  وَيَوْمَ حُنَيْنٍ  :  طَلْحَةَ الْجُودِ  ،  قَالَ أَبُو الْقَاسِمِ ""  بِالسِّينِ وَالشِّينِ جَمِيعًا ، فَبِالسِّينِ مِنَ الْعُسْرَةِ ، وَبِالشِّينِ مَوْضِعٌ  "" .","","Al-Mu'jam al-Kabir 197","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","من فضائله رضي الله عنه"
"197","198  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  مُحَمَّدُ بْنُ طَلْحَةَ التَّيْمِيُّ ،  عَنْ  إِسْحَاقَ بْنِ يَحْيَى بْنِ طَلْحَةَ ،  عَنْ  عَمِّهِ مُوسَى بْنِ طَلْحَةَ ،  أَنَّ  طَلْحَةَ  نَحَرَ جَزُورًا ، وَحَفَرَ بِئْرًا  يَوْمَ ذِي  قَرَدَ  فَأَطْعَمَهُمْ وَسَقَاهُمْ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  طَلْحَةُ الْفَيَّاضُ  فَسُمِّيَ  طَلْحَةَ الْفَيَّاضَ  .","","Al-Mu'jam al-Kabir 198","","موسى بن طلحة بن عبيد الله التيمي عن إسحاق بن يحيى بن طلحة التيمي عن محمد بن طلحة بن عبد الرحمن عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","من فضائله رضي الله عنه"
"198","[1/113]      سِنُّ  طَلْحَةَ بْنِ عُبَيْدِ اللهِ  وَوَفَاتُهُ رَضِيَ اللهُ عَنْهُ  199  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  حَدَّثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ  ، قَالَ :  وَحَدَّثَنِي  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  ، عَنِ  الْوَاقِدِيِّ  ، قَالَ :  حَدَّثَنِي  إِسْحَاقُ بْنُ يَحْيَى بْنِ طَلْحَةَ  ،  عَنْ  عَمِّهِ  عِيسَى بْنِ طَلْحَةَ  ، قَالَ : ""  كَانَ  طَلْحَةُ  يَوْمَ قُتِلَ ابْنَ اثْنَيْنِ وَسِتِّينَ سَنَةً  ، قَالَ  الْوَاقِدِيُّ  : "" وَقُتِلَ  يَوْمَ الْجَمَلِ  فِي جُمَادَى سَنَةَ سِتٍّ وَثَلَاثِينَ  "" .  قَالَ  الْوَاقِدِيُّ  :  وَحَدَّثَنِي  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ طَلْحَةَ بْنِ عُبَيْدِ اللهِ  ،  عَنْ  مُحَمَّدِ بْنِ زَيْدِ بْنِ الْمُهَاجِرِ بْنِ قُنْفُذٍ التَّيْمِيِّ  ، قَالَ : ""  قُتِلَ  طَلْحَةُ  وَهُوَ ابْنُ أَرْبَعٍ وَسِتِّينَ  ، وَدُفِنَ  بِالْبَصْرَةِ  فِي نَاحِيَةِ  ثَقِيفٍ  "" .","","Al-Mu'jam al-Kabir 199","","","سن طلحة بن عبيد الله ووفاته رضي الله عنه"
"199","200  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ، قَالَ : ""  قُتِلَ  طَلْحَةُ بْنُ عُبَيْدِ اللهِ  - رَضِيَ اللهُ عَنْهُ -  يَوْمَ الْجَمَلِ  فِي جُمَادَى سَنَةَ سِتٍّ وَثَلَاثِينَ ، وَسِنُّهُ  اثْنَتَانِ وَخَمْسُونَ سَنَةً ، أَوْ أَرْبَعٌ وَخَمْسُونَ سَنَةً  ،  وَالزُّبَيْرُ  أَسَنُّ مِنْهُ ، وَيُكَنَّى  أَبَا مُحَمَّدٍ  "" .","","Al-Mu'jam al-Kabir 200","","","سن طلحة بن عبيد الله ووفاته رضي الله عنه"
"200","201  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ حَيَّانَ بْنِ خَالِدٍ الرَّقِّيُّ  ، ثَنَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ ،  ثَنَا  وَكِيعٌ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ، قَالَ :  رَأَيْتُ  مَرْوَانَ بْنَ الْحَكَمِ  حِينَ رُمِيَ طَلْحَةُ يَوْمَئِذٍ بِسَهْمٍ  ، فَوَقَعَ فِي عَيْنِ رُكْبَتِهِ ، فَمَا زَالَ يُسَبِّحُ إِلَى أَنْ مَاتَ  "" .","","Al-Mu'jam al-Kabir 201","","طلحة بن عبيد الله بن عثمان الفياض عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن وكيع بن الجراح عن يحيى بن سليمان بن يحيى عن أحمد بن يحيى بن خالد الرقي عن الطبراني","سن طلحة بن عبيد الله ووفاته رضي الله عنه"
"201","202  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ حَيَّانَ الرَّقِّيُّ  ، ثَنَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  لَيْثٍ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  أَنَّ  عَلِيًّا - رَضِيَ اللهُ عَنْهُ - انْتَهَى إِلَى  طَلْحَةَ بْنِ عُبَيْدِ اللهِ  وَقَدْ مَاتَ ، فَنَزَلَ عَنْ دَابَّتِهِ وَأَجْلَسَهُ ، فَجَعَلَ يَمْسَحُ الْغُبَارَ عَنْ وَجْهِهِ وَلِحْيَتِهِ ، وَهُوَ يَتَرَحَّمُ عَلَيْهِ وَيَقُولُ :         [1/114]      لَيْتَنِي مُتُّ قَبْلَ هَذَا الْيَوْمِ بِعِشْرِينَ سَنَةً  "" .","","Al-Mu'jam al-Kabir 202","","علي بن أبي طالب عن طلحة بن مصرف الهمداني عن ليث بن أبي سليم عن عبد الله بن إدريس الأودي عن يحيى بن سليمان بن يحيى عن أحمد بن يحيى بن خالد الرقي عن الطبراني","سن طلحة بن عبيد الله ووفاته رضي الله عنه"
"202","203  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُبَارَكِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  قَيْسِ بْنِ عَبَّادٍ ، قَالَ :  سَمِعْتُ  عَلِيًّا - رَضِيَ اللهُ عَنْهُ -  يَوْمَ الْجَمَلِ  يَقُولُ لِابْنِهِ  حَسَنٍ  :  يَا  حَسَنُ  وَدِدْتُ أَنِّي كُنْتُ مُتُّ مُذْ عِشْرِينَ سَنَةً  "" .","","Al-Mu'jam al-Kabir 203","","علي بن أبي طالب عن قيس بن عباد الضبعي عن الحسن البصري عن قتادة بن دعامة عن سعيد بن أبي عروبة عن حماد بن زيد عن عبد الرحمن بن المبارك الخلقاني عن الفضل بن الحباب الجمحي عن الطبراني","سن طلحة بن عبيد الله ووفاته رضي الله عنه"
"203","وَمَا أَسْنَدَ  طَلْحَةُ بْنُ عُبَيْدِ اللهِ  رَضِيَ اللهُ عَنْهُ  204  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ بْنِ سُلَيْمَانَ بْنِ عِيسَى بْنِ مُوسَى بْنِ طَلْحَةَ بْنِ عُبَيْدِ اللهِ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  أَبِيهِ طَلْحَةَ بْنِ عُبَيْدِ اللهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا ،  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  "" .","","Al-Mu'jam al-Kabir 204","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند طلحة بن عبيد الله رضي الله عنه"
"204","205  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  طَلْحَةَ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ مِنَ التَّوَاضُعِ لِلهِ الرِّضَا بِالدُّونِ مِنْ شَرَفِ الْمَجَالِسِ  "" .","","Al-Mu'jam al-Kabir 205","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند طلحة بن عبيد الله رضي الله عنه"
"205","206  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  طَلْحَةَ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ يَقُولُ :  النَّاكِحُ فِي قَوْمِهِ كَالْمُعْشِبِ فِي دَارِهِ  "" .","","Al-Mu'jam al-Kabir 206","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند طلحة بن عبيد الله رضي الله عنه"
"206","[1/115]      207  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  طَلْحَةَ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا كَانَتْ نُبُوَّةٌ قَطُّ إِلَّا كَانَ بَعْدَهَا قَتْلٌ وَصَلْبٌ  "" .","","Al-Mu'jam al-Kabir 207","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند طلحة بن عبيد الله رضي الله عنه"
"207","208  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  طَلْحَةَ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  عَمْرُو بْنُ الْعَاصِ  مِنْ صَالِحِي  قُرَيْشٍ  "" .","","Al-Mu'jam al-Kabir 208","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند طلحة بن عبيد الله رضي الله عنه"
"208","209  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ ،  ثَنَا  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  طَلْحَةَ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يَا  عَمْرُو  إِنَّكَ لَذُو رَأْيٍ رَشِيدٍ فِي الْإِسْلَامِ  "" .","","Al-Mu'jam al-Kabir 209","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند طلحة بن عبيد الله رضي الله عنه"
"209","210  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ ، قَالَ :  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  طَلْحَةَ  ،  أَنَّهُ صَلَّى بِقَوْمٍ فَلَمَّا انْصَرَفَ ، قَالَ : نَسِيتُ أَنْ أَسْتَأْمِرَكُمْ قَبْلَ أَنْ أَتَقَدَّمَكُمْ أَفَرَضِيتُمْ بِصَلَاتِي ؟ قَالُوا : نَعَمْ ، وَمَنْ يَكْرَهُ ذَلِكَ يَا حَوَارِيَّ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَيُّمَا رَجُلٍ أَمَّ قَوْمًا وَهُمْ لَهُ كَارِهُونَ لَمْ تَجُزْ صَلَاتُهُ أُذُنَهُ  "" .","","Al-Mu'jam al-Kabir 210","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند طلحة بن عبيد الله رضي الله عنه"
"210","211  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  طَلْحَةَ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أُولِيَ مَعْرُوفًا فَلْيَذْكُرْهُ فَمَنْ ذَكَرَهُ فَقَدْ شَكَرَهُ  ، وَمَنْ كَتَمَهُ فَقَدْ كَفَرَهُ  "" .","","Al-Mu'jam al-Kabir 211","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند طلحة بن عبيد الله رضي الله عنه"
"211","[1/116]      212  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَتْ رِحْلَةُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَطِيبُهُ إِلَيَّ ، فَأَتَاهُ  رَجُلٌ  يَسْأَلُهُ أَحَدَهُمَا ، فَقَالَ :  ذَاكَ إِلَى  طَلْحَةَ بْنِ عُبَيْدِ اللهِ  "" فَأَتَانِي فَأَعْلَمَنِي فَأَبَيْتُ عَلَيْهِ  ، فَعَادَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَسَأَلَهُ فَرَدَّ عَلَيْهِ مِثْلَ ذَلِكَ ، فَأَتَانِي فَأَعْلَمَنِي ، فَأَبَيْتُ عَلَيْهِ ، فَرَجَعَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقَالَ مِثْلَ ذَلِكَ ، فَرَجَعَ إِلَيَّ ، فَقُلْتُ فِي نَفْسِي : مَا بَعَثَهُ إِلَيَّ إِلَّا وَهُوَ يُحِبُّ أَنْ يَقْضِيَ حَاجَتَهُ ، وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَا يَكَادُ يُسْأَلُ شَيْئًا إِلَّا فَعَلَهُ ، فَقُلْتُ : لَأَنْ أَلِيَ بَشَرَةَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَحَبُّ إِلَيَّ مِنْ أَنْ أَلِيَ رِحْلَتَهُ ، فَدَفَعْتُهَا إِلَيْهِ ، فَأَرَادَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَفَرًا ، فَأَمَرَ أَنْ يُرْحَلَ لَهُ فَأَتَانِي ، فَقَالَ : أَيُّ الرِّحْلَتَيْنِ كَانَتْ أَحَبَّ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ فَقُلْتُ : الطَّائِفِيَّةُ فَرَحَلَهَا لَهُ ، ثُمَّ قَرَّبَهَا إِلَيْهِ ، فَلَمَّا ثَارَتْ بِهِ انْكَبَّتْ ، فَقَالَ : "" مَنْ رَحَلَ هَذَا ؟ "" قَالُوا :  فُلَانٌ  ، فَقَالَ : "" رُدُّوهَا إِلَى  طَلْحَةَ  "" فَرُدَّتْ إِلَيَّ ، قَالَ  طَلْحَةُ  : وَاللهِ مَا  غَشَشْتُ  أَحَدًا فِي الْإِسْلَامِ غَيْرَهُ لِكَيْ تَرْجِعَ إِلَيَّ رِحْلَةُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Al-Mu'jam al-Kabir 212","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند طلحة بن عبيد الله رضي الله عنه"
"212","213  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ ،  حَدَّثَنَا  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  لَمَّا كَانَ  يَوْمُ أُحُدٍ  جَعَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى ظَهْرِي حَتَّى اسْتَقَلَّ ، وَصَارَ عَلَى الصَّخْرَةِ ، وَاسْتَتَرَ مِنَ الْمُشْرِكِينَ ، فَقَالَ : "" هَكَذَا "" وَأَوْمَأَ بِيَدِهِ إِلَى وَرَاءِ ظَهْرِي :  هَذَا  جِبْرِيلُ  - عَلَيْهِ السَّلَامُ - أَخْبَرَنِي أَنَّهُ لَا يَرَاكَ يَوْمَ الْقِيَامَةِ فِي هَوْلٍ إِلَّا أَنْقَذَكَ مِنْهُ  "" .","","Al-Mu'jam al-Kabir 213","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند طلحة بن عبيد الله رضي الله عنه"
"213","214  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  لَمَّا كَانَ  يَوْمُ أُحُدٍ  أَصَابَنِي السَّهْمُ ، فَقُلْتُ :  حَسِّ  فَقَالَ :  لَوْ قُلْتَ : بِسْمِ اللهِ ، لَطَارَتْ بِكَ الْمَلَائِكَةُ  وَالنَّاسُ يَنْظُرُونَ إِلَيْكَ  "" .","","Al-Mu'jam al-Kabir 214","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند طلحة بن عبيد الله رضي الله عنه"
"214","[1/117]      215  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا رَآنِي قَالَ :  مَنْ أَحَبَّ أَنْ يَنْظُرَ إِلَى شَهِيدٍ يَمْشِي عَلَى وَجْهِ الْأَرْضِ  فَلْيَنْظُرْ إِلَى  طَلْحَةَ بْنِ عُبَيْدِ اللهِ  "" .","","Al-Mu'jam al-Kabir 215","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند طلحة بن عبيد الله رضي الله عنه"
"215","216  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا رَآنِي قَالَ :  سَلَفِي فِي الدُّنْيَا وَسَلَفِي فِي الْآخِرَةِ  "" .","","Al-Mu'jam al-Kabir 216","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند طلحة بن عبيد الله رضي الله عنه"
"216","217  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  لَمَّا رَجَعَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  أُحُدٍ  صَعِدَ الْمِنْبَرَ ، فَحَمِدَ اللهَ - عَزَّ وَجَلَّ - وَأَثْنَى عَلَيْهِ ثُمَّ قَرَأَ هَذِهِ الْآيَةَ :         {      رِجَالٌ صَدَقُوا مَا عَاهَدُوا اللهَ عَلَيْهِ         }      الْآيَةَ كُلَّهَا ، فَقَامَ إِلَيْهِ  رَجُلٌ  ، فَقَالَ : يَا رَسُولَ اللهِ ، مَنْ هَؤُلَاءِ ؟ فَأَقْبَلْتُ وَعَلَيَّ ثَوْبَانِ أَخْضَرَانِ ، فَقَالَ :  أَيُّهَا السَّائِلُ ، هَذَا مِنْهُمْ  "" .","","Al-Mu'jam al-Kabir 217","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند طلحة بن عبيد الله رضي الله عنه"
"217","218  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  لَمَّا كَانَ  يَوْمُ أُحُدٍ  سَمَّانِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  طَلْحَةَ الْخَيْرِ  ،  وَيَوْمَ  غَزْوَةِ ذَاتِ الْعُشَيْرَةِ  :  طَلْحَةَ الْفَيَّاضَ  ،  وَيَوْمَ حُنَيْنٍ  طَلْحَةَ الْجُودِ  "" .","","Al-Mu'jam al-Kabir 218","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند طلحة بن عبيد الله رضي الله عنه"
"218","219  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ ،  حَدَّثَنَا  أَبِي ،  عَنْ  جَدِّي ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ فِي جَمَاعَةٍ مِنْ أَصْحَابِهِ ، وَفِي يَدِهِ سَفَرْجَلَةٌ يُقَلِّبُهَا ، فَلَمَّا جَلَسْتُ إِلَيْهِ دَحَى بِهَا نَحْوِي ، ثُمَّ         [1/118]      قَالَ :  دُونَكَهَا  أَبَا مُحَمَّدٍ  ، فَإِنَّهَا تَشُدُّ الْقَلْبَ  ، وَتُطَيِّبُ النَّفْسَ ، وَتَذْهَبُ بِطَخَاوَةِ الصَّدْرِ  "" .","","Al-Mu'jam al-Kabir 219","","طلحة بن عبيد الله بن عثمان الفياض عن موسى بن طلحة بن عبيد الله التيمي عن سليمان بن عيسى بن موسى عن أيوب بن سليمان بن عيسى عن سليمان بن أيوب بن سليمان بن عيسى الطلحي عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند طلحة بن عبيد الله رضي الله عنه"
"219","6 - نِسْبَةُ  الزُّبَيْرِ بْنِ الْعَوَّامِ  رَضِيَ اللهُ عَنْهُ  الزُّبَيْرُ بْنُ الْعَوَّامِ بْنِ خُوَيْلِدِ بْنِ أَسَدِ بْنِ عَبْدِ الْعُزَّى بْنِ قُصَيِّ بْنِ كِلَابِ بْنِ مُرَّةَ بْنِ كَعْبِ بْنِ لُؤَيِّ بْنِ غَالِبِ بْنِ فِهْرِ بْنِ مَالِكٍ يُكَنَّى أَبَا عَبْدِ اللهِ  ، وَأُمُّهُ :  صَفِيَّةُ بِنْتُ عَبْدِ الْمُطَّلِبِ عَمَّةُ رَسُولِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .  220  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ، عَنْ  عُرْوَةَ  ""  فِيمَنْ شَهِدَ  بَدْرًا  مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - مِنْ  بَنِي أَسَدِ بْنِ عَبْدِ الْعُزَّى  :  الزُّبَيْرُ بْنُ الْعَوَّامِ بْنِ خُوَيْلِدِ بْنِ أَسَدٍ  ""  .","","Al-Mu'jam al-Kabir 220","","","نسبة الزبير بن العوام رضي الله عنه"
"220","221  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ، قَالَ : ""  كَانَ  الزُّبَيْرُ  يُكَنَّى  أَبَا عَبْدِ اللهِ  "" .","","Al-Mu'jam al-Kabir 221","","","نسبة الزبير بن العوام رضي الله عنه"
"221","222  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُوسَى بْنُ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  أَبِي إِسْحَاقَ الْفَزَارِيِّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ، قَالَ :  لَمَّا كَانَ  يَوْمُ الْيَرْمُوكِ  ، قَالُوا لِلزُّبَيْرِ : يَا  أَبَا عَبْدِ اللهِ  "" .","","Al-Mu'jam al-Kabir 222","","الزبير بن العوام عن هشام بن عروة بن الزبير عن أبو إسحاق الفزاري عن حماد بن أسامة القرشي عن موسى بن عبد الرحمن بن سعيد المسروقي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","نسبة الزبير بن العوام رضي الله عنه"
"222","صِفَةُ  الزُّبَيْرِ بْنِ الْعَوَّامِ  رَضِيَ اللهُ عَنْهُ  223  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ مُحَمَّدِ بْنِ يَحْيَى بْنِ عُرْوَةَ بْنِ الزُّبَيْرِ ، يَقُولُ :  كَانَ الزُّبَيْرُ بْنُ الْعَوَّامِ - رَضِيَ اللهُ عَنْهُ - أَبْيَضَ طَوِيلًا مُحَفَّفًا  ، خَفِيفَ  الْعَارِضَيْنِ  "" .","","Al-Mu'jam al-Kabir 223","","الزبير بن العوام عن عبد الله بن محمد بن يحيى المدني عن الزبير بن بكار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","صفة الزبير بن العوام رضي الله عنه"
"223","224  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ ،  ثَنَا  أَبُو غَزِيَّةَ ،  عَنْ         [1/119]      عَبْدِ الرَّحْمَنِ بْنِ أَبِي الزِّنَادِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ الزُّبَيْرُ بْنُ الْعَوَّامِ - رَضِيَ اللهُ عَنْهُ - طَوِيلًا  يَخُطُّ  رِجْلَاهُ الْأَرْضَ  ، إِذَا رَكِبَ الدَّابَّةَ أَشْعَرَ ، وَرُبَّمَا أَخَذْتُ بِشَعَرِ كَتِفَيْهِ  "" .","","Al-Mu'jam al-Kabir 224","","الزبير بن العوام عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الرحمن بن أبي الزناد عن محمد بن موسى بن مسكين المديني عن الزبير بن بكار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","صفة الزبير بن العوام رضي الله عنه"
"224","225  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  أَيُّوبَ  ،  عَنْ  نَافِعٍ ، قَالَ :  سَمِعَ ابْنُ عُمَرَ رَجُلًا يَقُولُ : أَنَا ابْنُ حَوَارِيِّ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  فَقَالَ  ابْنُ عُمَرَ  : "" إِنْ كُنْتَ مِنْ  آلِ الزُّبَيْرِ  وَإِلَّا فَلَا  "" .  في طبعة مكتبة ابن تيمية : ( أبي أيوب ) والمثبت من النسخة الخطية ، ومصنف ابن أبي شيبة","","Al-Mu'jam al-Kabir 225","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن سعيد بن أبي عروبة عن يزيد بن هارون عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","صفة الزبير بن العوام رضي الله عنه"
"225","226  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَمْرُو بْنُ عَبْدِ اللهِ الْأَوْدِيُّ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  أَوَّلُ مَنْ سَلَّ سَيْفًا فِي  سَبِيلِ  اللهِ  الزُّبَيْرُ بْنُ الْعَوَّامِ  "" .","","Al-Mu'jam al-Kabir 226","","عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن عمرو بن عبد الله بن حنش عن محمد بن عبد الله مطين الحضرمي عن الطبراني","صفة الزبير بن العوام رضي الله عنه"
"226","227  -  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ الْمَلِكِ بْنُ الْوَلِيدِ الْبَجَلِيُّ ،  أَنَا  أَحْمَدُ بْنُ يَزِيدَ الْوَرْتَنِيسِيُّ ،  ثَنَا  فُلَيْحُ بْنُ سُلَيْمَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  جَابِرٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ الْخَنْدَقِ  : "" مَنْ يَأْتِينَا بِخَبَرِ  بَنِي قُرَيْظَةَ  ؟ "" ثُمَّ نَدَبَهُمُ الثَّانِيَةَ ، ثُمَّ نَدَبَهُمُ الثَّالِثَةَ ،  فَانْتَدَبَ  الزُّبَيْرُ  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِكُلِّ نَبِيٍّ  حَوَارِيٌّ  وَحَوَارِيَّ  الزُّبَيْرُ  "" .","","Al-Mu'jam al-Kabir 227","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن فليح بن سليمان عن أحمد بن يزيد بن إبراهيم الورتنيسي عن عبد الملك بن الوليد البجلي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","صفة الزبير بن العوام رضي الله عنه"
"227","228  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  حَمْزَةُ بْنُ عَوْنٍ الْمَسْعُودِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْقَاسِمِ الْأَسَدِيُّ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ، وَشَرِيكٌ ، وَأَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَلِيٍّ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِكُلِّ نَبِيٍّ  حَوَارِيٌّ  وَحَوَارِيَّ  الزُّبَيْرُ  "" .","","Al-Mu'jam al-Kabir 228","","علي بن أبي طالب عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن أبو بكر بن عياش عن محمد بن القاسم الأسدي عن حمزة بن عون بن عتبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","صفة الزبير بن العوام رضي الله عنه"
"228","[1/120]      229  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  حَدَّثَنَا  سُكَيْنُ بْنُ عَبْدِ الْعَزِيزِ الْبَصْرِيُّ ،  ثَنَا  حَفْصُ بْنُ خَالِدٍ ، قَالَ :  حَدَّثَنِي  شَيْخٌ ، قَدِمَ عَلَيْنَا مِنَ الْمَوْصِلِ ، قَالَ :  صَحِبْتُ  الزُّبَيْرَ بْنَ الْعَوَّامِ فِي بَعْضِ أَسْفَارِهِ ، فَأَصَابَتْهُ جَنَابَةٌ بِأَرْضٍ قَفْرٍ  ، فَقَالَ : اسْتُرْنِي ، فَسَتَرْتُهُ ، فَحَانَتْ مِنِّي الْتِفَاتَةٌ إِلَيْهِ ، فَرَأَيْتُهُ  مُجَدَّعًا  بِالسُّيُوفِ ، قُلْتُ : وَاللهِ لَقَدْ رَأَيْتُ بِكَ آثَارًا مَا رَأَيْتُهَا بِأَحَدٍ قَطُّ قَالَ : وَقَدْ رَأَيْتَ ذَلِكَ ؟ قُلْتُ : نَعَمْ ، قَالَ : "" أَمَا وَاللهِ مَا مِنْهَا جِرَاحَةٌ إِلَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَفِي  سَبِيلِ  اللهِ - عَزَّ وَجَلَّ  - "" .","","Al-Mu'jam al-Kabir 229","","الزبير بن العوام عن شيخ قدم علينا من الموصل عن حفص بن خالد بن جابر عن سكين بن عبد العزيز بن قيس المجاشعي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","صفة الزبير بن العوام رضي الله عنه"
"229","230  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ  ، عَنْ  عُرْوَةَ  ، قَالَ :  نَزَلَ  جِبْرِيلُ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ بَدْرٍ  عَلَى سِيمَاءِ  الزُّبَيْرِ بْنِ الْعَوَّامِ  وَهُوَ  مُعْتَجِرٌ  بِعِمَامَةٍ صَفْرَاءَ  "" .","","Al-Mu'jam al-Kabir 230","","عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","صفة الزبير بن العوام رضي الله عنه"
"230","231  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  جَامِعٌ أَبُو سَلَمَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الْبَهِيِّ ، قَالَ :  كَانَ  يَوْمَ بَدْرٍ  مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَارِسَانِ  :  الزُّبَيْرُ بْنُ الْعَوَّامِ  عَلَى فَرَسٍ عَلَى الْمَيْمَنَةِ ،  وَالْمِقْدَادُ بْنُ الْأَسْوَدِ  عَلَى فَرَسٍ عَلَى الْمَيْسَرَةِ  "" .","","Al-Mu'jam al-Kabir 231","","عبد الله البهي مولى مصعب بن الزبير عن إسماعيل بن أبي خالد عن جامع أبو سلمة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","صفة الزبير بن العوام رضي الله عنه"
"231","232  -  حَدَّثَنَا  أَحْمَدُ بْنُ زَيْدِ بْنِ هَارُونَ الْقَزَّازُ الْمَكِّيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ عُرْوَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  أَنَّ  مُطِيعَ بْنَ الْأَسْوَدِ ، قَالَ :  سَمِعْتُ  عُمَرَ بْنَ الْخَطَّابِ - رَضِيَ اللهُ عَنْهُ - يَقُولُ :  وَاللهِ لَوْ عَهِدْتُ عَهْدًا ، أَوْ تَرَكْتُ تَرِكَةً  ، لَكَانَ أَحَبَّ إِلَيَّ مَنْ أَنْ أَجْعَلَهَا إِلَيْهِ  الزُّبَيْرُ بْنُ الْعَوَّامِ  ، فَإِنَّهُ رُكْنٌ مِنْ أَرْكَانِ الدِّينِ  "" .","","Al-Mu'jam al-Kabir 232","","عمر بن الخطاب عن مطيع بن الأسود بن حارثة الأسدي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن محمد بن يحيى المدني عن إبراهيم بن المنذر الحزامي عن أحمد بن يزيد بن عبد الله الجمحي عن الطبراني","صفة الزبير بن العوام رضي الله عنه"
"232","233  -  حَدَّثَنَا  أَحْمَدُ بْنُ زَيْدِ بْنِ هَارُونَ الْمَكِّيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ عُرْوَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  أَنَّ  عَلِيَّ بْنَ         [1/121]      أَبِي طَالِبٍ - رَضِيَ اللهُ عَنْهُ - لَقِيَ الزُّبَيْرَ - رَضِيَ اللهُ عَنْهُ - بِالسُّوقِ ، فَتَعَاتَبَا فِي شَيْءٍ  مِنْ أَمْرِ  عُثْمَانَ  - رَضِيَ اللهُ عَنْهُ - ثُمَّ أَغْلَظَ لَهُ  عَبْدُ اللهِ بْنُ الزُّبَيْرِ  ، فَقَالَ  عَلِيٌّ  : أَلَا تَسْمَعُ مَا يَقُولُ لِي ؟ "" فَضَرَبَهُ  الزُّبَيْرُ  حَتَّى وَقَعَ  "" .","","Al-Mu'jam al-Kabir 233","","الزبير بن العوام عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن محمد بن يحيى المدني عن إبراهيم بن المنذر الحزامي عن أحمد بن يزيد بن عبد الله الجمحي عن الطبراني","صفة الزبير بن العوام رضي الله عنه"
"233","234  -  حَدَّثَنَا  أَحْمَدُ بْنُ زَيْدِ بْنِ هَارُونَ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ عُرْوَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ، قَالَ :  ضَرَبَ الزُّبَيْرُ  أَسْمَاءَ بِنْتَ أَبِي بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - فَصَاحَتْ  بِعَبْدِ اللهِ بْنِ الزُّبَيْرِ  فَأَقْبَلَ فَلَمَّا رَآهُ قَالَ : أُمُّكَ طَالِقٌ إِنْ دَخَلْتَ ، فَقَالَ لَهُ عَبْدُ اللهِ : "" أَتَجْعَلُ أُمِّي عُرْضَةً لِيَمِينِكَ ؟ "" فَاقْتَحَمَ عَلَيْهِ ، فَخَلَّصَهَا مِنْهُ ،  فَبَانَتْ  مِنْهُ ، قَالَ : "" وَلَقَدْ كُنْتُ غُلَامًا رُبَّمَا أَخَذْتُ بِشَعَرِ مِنْكَبَيِ  الزُّبَيْرِ  "" .","","Al-Mu'jam al-Kabir 234","","الزبير بن العوام عن هشام بن عروة بن الزبير عن عبد الله بن محمد بن يحيى المدني عن إبراهيم بن المنذر الحزامي عن أحمد بن يزيد بن عبد الله الجمحي عن الطبراني","صفة الزبير بن العوام رضي الله عنه"
"234","235  -  حَدَّثَنَا  أَحْمَدُ بْنُ زَيْدِ بْنِ هَارُونَ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  أَنَّ  عَلِيَّ بْنَ أَبِي طَالِبٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  يَا بَنِيَّ لَا تُخْرِجُنَّ بَنَاتِكُمْ إِلَّا إِلَى الْأَكْفَاءِ  . قَالُوا : يَا أَبَانَا ، وَمَنِ الْأَكْفَاءُ ؟ قَالَ : "" وَلَدُ  الزُّبَيْرِ بْنِ الْعَوَّامِ  "" .","","Al-Mu'jam al-Kabir 235","","علي بن أبي طالب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن محمد بن يحيى المدني عن إبراهيم بن المنذر الحزامي عن أحمد بن يزيد بن عبد الله الجمحي عن الطبراني","صفة الزبير بن العوام رضي الله عنه"
"235","236  -  أَخْبَرَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ نُمَيْرٍ  ، يَقُولُ : ""  قُتِلَ  الزُّبَيْرُ  وَهُوَ ابْنُ أَرْبَعٍ وَسِتِّينَ  ، وَقُتِلَ سَنَةَ سِتٍّ وَثَلَاثِينَ  "" .","","Al-Mu'jam al-Kabir 236","","","صفة الزبير بن العوام رضي الله عنه"
"236","سِنُّ  الزُّبَيْرِ بْنِ الْعَوَّامِ  وَوَفَاتُهُ وَأَخْبَارُهُ رَضِيَ اللهُ عَنْهُ  237  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ، قَالَ :  أَسْلَمَ الزُّبَيْرُ وَهُوَ ابْنُ سِتَّةَ عَشَرَ  ، وَقُتِلَ وَهُوَ ابْنُ  بِضْعٍ  وَسِتِّينَ  "" .","","Al-Mu'jam al-Kabir 237","","الزبير بن العوام عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن يحيى بن معين عن عبد الله بن أحمد بن حنبل عن الطبراني","سن الزبير بن العوام ووفاته وأخباره رضي الله عنه"
"237","[1/122]      238  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ، قَالَ : ""  قُتِلَ  الزُّبَيْرُ بْنُ الْعَوَّامِ  - رَضِيَ اللهُ عَنْهُ -  يَوْمَ الْجَمَلِ  فِي جُمَادَى - لَا أَدْرِي  الْأُولَى أَوِ الْآخِرَةَ  - سَنَةَ سِتٍّ وَثَلَاثِينَ  "" .  قَالَ  يَحْيَى  :  وَأَخْبَرَنِي  اللَّيْثُ  ،  عَنْ  أَبِي الْأَسْوَدِ  ، أَنَّهُ  أَخْبَرَهُ  عُرْوَةُ  ، ""  أَنَّ  الزُّبَيْرَ  - رَضِيَ اللهُ عَنْهُ - أَسْلَمَ وَهُوَ ابْنُ ثَمَانِ سِنِينَ ، وَكَانَ يُكَنَّى  أَبَا عَبْدِ اللهِ  ، فَإِنْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَقَامَ  بِمَكَّةَ  ثَلَاثَ عَشْرَةَ فَهُوَ يَوْمَ قُتِلَ ابْنُ سَبْعٍ وَخَمْسِينَ ، وَإِنْ كَانَ أَقَامَ عَشْرَ سِنِينَ  فَالزُّبَيْرُ  ابْنُ أَرْبَعٍ وَخَمْسِينَ سَنَةً  "" .","","Al-Mu'jam al-Kabir 238","","","سن الزبير بن العوام ووفاته وأخباره رضي الله عنه"
"238","239  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى  ، ثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ  ، ثَنَا  اللَّيْثُ بْنُ سَعْدٍ  ، عَنْ  أَبِي الْأَسْوَدِ  ، قَالَ : ""  أَسْلَمَ  الزُّبَيْرُ بْنُ الْعَوَّامِ  وَهُوَ ابْنُ ثَمَانِ سِنِينَ  ، وَهَاجَرَ وَهُوَ ابْنُ ثَمَانِ عَشْرَةَ ، وَكَانَ  عَمُّ الزُّبَيْرِ  يُعَلِّقُ  الزُّبَيْرَ  فِي حَصِيرٍ ، وَيُدَخِّنُ عَلَيْهِ بِالنَّارِ ، وَهُوَ يَقُولُ : ارْجِعْ إِلَى الْكُفْرِ فَيَقُولُ  الزُّبَيْرُ  : لَا أَكْفُرُ أَبَدًا  "" .","","Al-Mu'jam al-Kabir 239","","","سن الزبير بن العوام ووفاته وأخباره رضي الله عنه"
"239","240  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  لَمَّا قُتِلَ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - مَحَا الزُّبَيْرُ اسْمَهُ مِنَ الدِّيوَانِ  "" .","","Al-Mu'jam al-Kabir 240","","الزبير بن العوام عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أنس بن عياض الليثي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سن الزبير بن العوام ووفاته وأخباره رضي الله عنه"
"240","241  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَبْدُ الْمَلِكِ بْنُ قَرِيبٍ الْأَصْمَعِيُّ ، قَالَ :  سَمِعْتُ  ابْنَ عَوْنٍ ، يَقُولُ :  هَؤُلَاءِ الْخِيَارُ قُتِلُوا قَتْلًا  ، ثُمَّ بَكَى ، فَقَالَ : قَاتِلُ الزُّبَيْرِ أَقْبَلَ عَلَى  الزُّبَيْرِ  فَأَقْبَلَ  الزُّبَيْرُ  عَلَيْهِ ، فَقَالَ : أُذَكِّرُكَ اللهَ ، فَكَفَّ عَنْهُ  الزُّبَيْرُ  حَتَّى فَعَلَ ذَلِكَ مِرَارًا ، فَقَالَ  الزُّبَيْرُ  :  قَاتَلَهُ اللهُ يُذَكِّرُ بِاللهِ - عَزَّ وَجَلَّ - وَيَنْسَاهُ  "" .","","Al-Mu'jam al-Kabir 241","","عبد الله بن عون بن أرطبان عن الأصمعي عن أبو مسلم الكجي عن الطبراني","سن الزبير بن العوام ووفاته وأخباره رضي الله عنه"
"241","242  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو رَبِيعَةَ فَهْدُ بْنُ عَوْفٍ ،  ثَنَا  مُبَارَكُ         [1/123]      بْنُ فَضَالَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَبِي بَكْرَةَ ، قَالَ :  لَمَّا كَانَ  يَوْمُ الْجَمَلِ  رَأَى عَلِيٌّ - رَضِيَ اللهُ عَنْهُ - الرُّؤُوسَ تَنْدُرُ  ، فَأَخَذَ بِيَدِ  الْحَسَنِ  - رَضِيَ اللهُ عَنْهُ - فَوَضَعَهَا عَلَى بَطْنِهِ ، ثُمَّ قَالَ : "" أَيْ بُنَيَّ أَيُّ خَيْرٍ يُرْجَى بَعْدَ هَذَا  "" .","","Al-Mu'jam al-Kabir 242","","علي بن أبي طالب عن أبو بكرة الثقفي عن الحسن البصري عن مبارك بن فضالة عن زيد بن عوف القطعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سن الزبير بن العوام ووفاته وأخباره رضي الله عنه"
"242","243  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  حَمْزَةُ بْنُ عَوْنٍ الْمَسْعُودِيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ الْقَاسِمِ الْأَسَدِيُّ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ، وَشَرِيكٌ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ، قَالَ :  كُنْتُ جَالِسًا عِنْدَ  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - فَأُتِيَ بِرَأْسِ  الزُّبَيْرِ  - رَضِيَ اللهُ عَنْهُ - فَقَالَ عَلِيٌّ - رَضِيَ اللهُ عَنْهُ - : بَشِّرْ  قَاتِلَ ابْنِ صَفِيَّةَ  بِالنَّارِ ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ لِكُلِّ نَبِيٍّ  حَوَارِيًّا  وَحَوَارِيَّ  الزُّبَيْرُ  "" .","","Al-Mu'jam al-Kabir 243","","علي بن أبي طالب عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن شريك بن عبد الله النخعي عن محمد بن القاسم الأسدي عن حمزة بن عون بن عتبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سن الزبير بن العوام ووفاته وأخباره رضي الله عنه"
"243","244  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ، قَالَ :  أَسْلَمَ الزُّبَيْرُ وَهُوَ ابْنُ سِتَّ عَشْرَةَ سَنَةً  ، وَلَمْ يَتَخَلَّفْ عَنْ غَزَاةٍ غَزَاهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقُتِلَ وَهُوَ ابْنُ  بِضْعٍ  وَسِتِّينَ وَهُوَ مِنَ  الْبَصْرَةِ  عَلَى نَحْوِ بَرِيدٍ  "" .","","Al-Mu'jam al-Kabir 244","","الزبير بن العوام عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","سن الزبير بن العوام ووفاته وأخباره رضي الله عنه"
"244","245  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ  ، قَالَ : ""  قُتِلَ  الزُّبَيْرُ  سَنَةَ سِتٍّ وَثَلَاثِينَ  ، قَتَلَهُ  ابْنُ جُرْمُوزٍ  وَمَعَهُ  النُّعْمَانُ بْنُ زِمَامٍ  ،  وَأَبُو الْمَضْرَحِيِّ  رَجُلَانِ مِنْ  بَنِي تَمِيمٍ  ، وَقُتِلَ  بِوَادِي السِّبَاعِ  ، وَدُفِنَ بِهِ  "" .","","Al-Mu'jam al-Kabir 245","","","سن الزبير بن العوام ووفاته وأخباره رضي الله عنه"
"245","246  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو أُسَامَةَ ،  ثَنَا  هِشَامُ بْنُ عُرْوَةَ :  أَنَّ  عَبْدَ اللهِ بْنَ مَسْعُودٍ ، وَعُثْمَانَ ، وَالْمِقْدَامَ بْنَ الْأَسْوَدِ ، وَعَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ ، وَمُطِيعَ بْنَ الْأَسْوَدِ أَوْصَوْا  إِلَى  الزُّبَيْرِ بْنِ الْعَوَّامِ  "" .","","Al-Mu'jam al-Kabir 246","","مطيع بن الأسود بن حارثة الأسدي عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","سن الزبير بن العوام ووفاته وأخباره رضي الله عنه"
"246","[1/124]      247  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ طَلْحَةَ ،  ثَنَا  إِسْحَاقُ بْنُ يَحْيَى بْنِ طَلْحَةَ ،  عَنْ  عَمِّهِ مُوسَى بْنِ طَلْحَةَ ، قَالَ :  كَانَ  عَلِيٌّ  ،  وَالزُّبَيْرُ  ،  وَسَعْدُ بْنُ أَبِي وَقَّاصٍ  عِذَارَ عَامٍ وَاحِدٍ  "" .","","Al-Mu'jam al-Kabir 247","","موسى بن طلحة بن عبيد الله التيمي عن إسحاق بن يحيى بن طلحة التيمي عن محمد بن طلحة بن عبد الرحمن عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","سن الزبير بن العوام ووفاته وأخباره رضي الله عنه"
"247","وَمِمَّا أَسْنَدَ  الزُّبَيْرُ بْنُ الْعَوَّامِ  رَضِيَ اللهُ عَنْهُ  248  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  رَوْحُ بْنُ عَبْدِ الْمُؤْمِنِ الْمُقْرِي ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ دِينَارٍ ،  ثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ الزُّبَيْرِ ،  عَنِ  الزُّبَيْرِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تُحَرِّمُ الْمَصَّةُ وَلَا الْمَصَّتَانِ  "" .","","Al-Mu'jam al-Kabir 248","","الزبير بن العوام عن عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن دينار الطاحي عن روح بن عبد المؤمن عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ومما أسند الزبير بن العوام رضي الله عنه"
"248","249  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ضِرَارُ بْنُ صُرَدٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الْعَزِيزِ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْمِسْوَرِ بْنِ مَخْرَمَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  حَدَّثَنِي  الزُّبَيْرُ بْنُ الْعَوَّامِ - رَضِيَ اللهُ عَنْهُ - قَالَ :  رَأَيْتُ  هِنْدَ بِنْتَ عُتْبَةَ  كَاشِفَةً عَنْ سَاقِهَا  يَوْمَ أُحُدٍ  ، وَكَأَنِّي أَنْظُرُ إِلَى خَدَمٍ فِي سَاقِهَا ، وَهِيَ تُحَرِّضُ النَّاسَ  "" .","","Al-Mu'jam al-Kabir 249","","الزبير بن العوام عن عبد الرحمن بن عوف بن عبد عوف القرشي عن المسور بن مخرمة عن عبد الرحمن بن المسور بن مخرمة عن الزهري عن محمد بن عبد العزيز عن عبد العزيز بن محمد الدراوردي عن ضرار بن صرد التيمي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ومما أسند الزبير بن العوام رضي الله عنه"
"249","250  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ الْعَسْقَلَانِيُّ ،  ثَنَا  عُمَرُ بْنُ حَفْصِ بْنِ ثَابِتِ بْنِ أَسْعَدَ بْنِ زُرَارَةَ الْأَنْصَارِيُّ ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ يَحْيَى بْنِ عَبَّادِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنِ  الزُّبَيْرِ بْنِ الْعَوَّامِ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الْأَرْضُ أَرْضُ اللهِ  ، وَالْعِبَادُ عِبَادُ اللهِ ، فَحَيْثُ وَجَدَ أَحَدُكُمْ خَيْرًا فَلْيَتَّقِ اللهَ         [1/125]      وَلْيُقِمْ  .  وَسَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَأَنْ يَأْخُذَ أَحَدُكُمْ حَبْلًا فَيَحْتَطِبَ عَلَى ظَهْرِهِ فَيَبِيعَ وَيَأْكُلَ  ، خَيْرٌ لَهُ مِنْ أَنْ يَسْأَلَ النَّاسَ أَعْطَوْهُ أَوْ مَنَعُوهُ  .  وَسَمِعْتُ رَسُولَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ حِينَ تَلَا هَذِهِ الْآيَةَ :         {      شَهِدَ اللهُ أَنَّهُ لا إِلَهَ إِلا هُوَ         }      إِلَى قَوْلِهِ :         {      الْعَزِيزُ الْحَكِيمُ         }      . قَالَ :  وَأَنَا أَشْهَدُ أَنَّكَ لَا إِلَهَ إِلَّا أَنْتَ الْعَزِيزُ الْحَكِيمُ  "" .","","Al-Mu'jam al-Kabir 250","","الزبير بن العوام عن عبد الله بن الزبير عن عباد بن عبد الله بن الزبير بن العوام عن يحيى بن عباد بن عبد الله بن الزبير بن العوام عن عبد الملك بن يحيى بن عباد القرشي عن أبو سعيد الحلبي عن محمد بن المتوكل بن ابى السرى عن أحمد بن محمد بن الحجاج المصري عن الطبراني","ومما أسند الزبير بن العوام رضي الله عنه"
"250","251  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  ثَنَا  نُمَيْرُ بْنُ يَزِيدَ الْقَيْنِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  قُحَافَةُ بْنُ رَبِيعَةَ ، قَالَ :  حَدَّثَنِي  الزُّبَيْرُ بْنُ الْعَوَّامِ - رَضِيَ اللهُ عَنْهُ - قَالَ :  صَلَّى بِنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَاةَ الصُّبْحِ فِي  مَسْجِدِ الْمَدِينَةِ  ، فَلَمَّا انْصَرَفَ ، قَالَ :  أَيُّكُمْ يَتْبَعُنِي إِلَى وَفْدِ الْجِنِّ اللَّيْلَةَ ؟  فَأَسْكَتَ  الْقَوْمُ  فَلَمْ يَتَكَلَّمْ مِنْهُمْ أَحَدٌ ، قَالَ ذَلِكَ ثَلَاثًا ، فَمَرَّ بِي يَمْشِي فَأَخَذَ بِيَدِي فَجَعَلْتُ أَمْشِي مَعَهُ حَتَّى  خَنَسَتْ  عَنَّا جِبَالُ  الْمَدِينَةِ  كُلُّهَا ، وَأُقْصِينَا إِلَى  أَرْضٍ قَرَارٍ  ، فَإِذَا رِجَالٌ طُوَالٌ كَأَنَّهُمُ الرِّمَاحُ ، مُسْتَدْفِرِي ثِيَابِهِمْ مِنْ بَيْنِ أَرْجُلِهِمْ ، فَلَمَّا رَأَيْتُهُمْ غَشِيَتْنِي رِعْدَةٌ شَدِيدَةٌ حَتَّى مَا يُمْسِكُنِي رِجْلَايَ مِنَ الْفَرَقِ ، فَلَمَّا دَنَوْنَا مِنْهُمْ خَطَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِإِبْهَامِ رِجْلِهِ فِي الْأَرْضِ خَطًّا ، فَقَالَ لِي : "" اقْعُدْ فِي وَسَطِهِ "" فَلَمَّا جَلَسْتُ ذَهَبَ عَنِّي كُلُّ شَيْءٍ أَجِدُهُ مِنْ رِيبَةٍ ، وَمَضَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنِي وَبَيْنَهُمْ فَتَلَا قُرْآنًا رَفِيعًا حَتَّى طَلَعَ الْفَجْرُ ، ثُمَّ أَقْبَلَ حَتَّى مَرَّ بِي ، فَقَالَ لِي : "" الْحَقْ "" فَجَعَلْتُ أَمْشِي مَعَهُ ، فَمَضَيْنَا غَيْرَ بَعِيدٍ ، فَقَالَ لِي : "" الْتَفِتْ فَانْظُرْ ، هَلْ تَرَى حَيْثُ كَانَ أُولَئِكَ مِنْ أَحَدٍ ؟ "" فَقُلْتُ : يَا رَسُولَ اللهِ أَرَى  سَوَادًا  كَثِيرًا ، فَخَفَضَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأْسَهُ إِلَى الْأَرْضِ ، فَنَظَمَ عَظْمًا بِرَوْثَةٍ ، ثُمَّ رَمَى بِهِ إِلَيْهِمْ ، وَقَالَ : "" رَشَدَ أُولَئِكَ مِنْ وَفْدِ قَوْمٍ هُمْ وَفْدُ نَصِيبِينَ ، سَأَلُونِي الزَّادَ         [1/126]      فَجَعَلْتُ لَهُمْ كُلَّ عَظْمٍ وَرَوْثَةٍ "" قَالَ  الزُّبَيْرُ  : "" فَلَا يَحِلُّ لِأَحَدٍ أَنْ يَسْتَنْجِيَ بِعَظْمٍ وَلَا رَوْثَةٍ أَبَدًا  "" .","","Al-Mu'jam al-Kabir 251","","الزبير بن العوام عن قحافة بن ربيعة عن يزيد القيني عن نمير بن يزيد القيني عن بقية بن الوليد عن عبد الوهاب بن نجدة عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","ومما أسند الزبير بن العوام رضي الله عنه"
"251","7 - نِسْبَةُ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  رَضِيَ اللهُ عَنْهُ .  252  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ  ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ  ،  عَنْ  أَبِي عُبَيْدَةَ مَعْمَرِ بْنِ الْمُثَنَّى  ، قَالَ : ""  عَبْدُ الرَّحْمَنِ بْنُ عَوْفِ بْنِ عَبْدِ عَوْفِ  بْنِ عَبْدِ الْحَارِثِ بْنِ زُهْرَةَ بْنِ كِلَابٍ  ""  .","","Al-Mu'jam al-Kabir 252","","","نسبة عبد الرحمن بن عوف رضي الله عنه"
"252","253  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَيُّوبَ ،  عَنِ  ابْنِ سِيرِينَ ،  أَنَّ  عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ  - رَضِيَ اللهُ عَنْهُ -  كَانَ اسْمُهُ فِي الْجَاهِلِيَّةِ :  عَبْدَ الْكَعْبَةِ  "" فَسَمَّاهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَبْدَ الرَّحْمَنِ  .","","Al-Mu'jam al-Kabir 253","","محمد بن سيرين عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","نسبة عبد الرحمن بن عوف رضي الله عنه"
"253","254  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، قَالَ :  كَانَ اسْمِي  عَبْدَ عَمْرٍو  فَسَمَّانِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَبْدَ الرَّحْمَنِ  .","","Al-Mu'jam al-Kabir 254","","عبد الرحمن بن عوف بن عبد عوف القرشي عن عبد العزيز بن عمر بن عبد الرحمن عن محمد بن عبد العزيز العوفى عن إبراهيم بن أبي ثابت الزهري عن يعقوب بن محمد بن عيسى عن عقبة بن مكرم عن عبد الله بن أحمد بن حنبل عن الطبراني","نسبة عبد الرحمن بن عوف رضي الله عنه"
"254","255  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَدِينِيُّ فُسْتُقَةُ  ،  ثَنَا  الْحُسَيْنُ بْنُ عَلِيِّ بْنِ يَزِيدَ الصُّدَائِيُّ  ،  ثَنَا  يَعْقُوبُ  ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ إِسْحَاقَ  ، قَالَ : ""  عَبْدُ الرَّحْمَنِ بْنُ عَوْفِ بْنِ عَبْدِ عَوْفِ بْنِ عَبْدِ الْحَارِثِ بْنِ زُهْرَةَ  ، وَيُكَنَّى أَبَا مُحَمَّدٍ  شَهِدَ  بَدْرًا  ""  .","","Al-Mu'jam al-Kabir 255","","","نسبة عبد الرحمن بن عوف رضي الله عنه"
"255","256  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ،  عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ  ، ""  فِيمَنْ شَهِدَ  بَدْرًا  مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  بَنِي زُهْرَةَ بْنِ كِلَابِ بْنِ مُرَّةَ  :  عَبْدُ الرَّحْمَنِ بْنُ عَوْفِ بْنِ الْحَارِثِ بْنِ زُهْرَةَ  ""  .","","Al-Mu'jam al-Kabir 256","","","نسبة عبد الرحمن بن عوف رضي الله عنه"
"256","[1/127]      257  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِعَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  - رَضِيَ اللهُ عَنْهُ - :  كَيْفَ صَنَعْتَ يَا  أَبَا مُحَمَّدٍ  فِي اسْتِلَامِ  الرُّكْنِ  ؟ "" -  يَعْنِي الْحَجَرَ الْأَسْوَدَ  - فَقَالَ  عَبْدُ الرَّحْمَنِ  :  اسْتَلَمْتُ  وَتَرَكْتُ ، فَقَالَ رَسُولُ اللهِ : "" أَصَبْتَ  .","","Al-Mu'jam al-Kabir 257","","عروة بن الزبير عن هشام بن عروة بن الزبير عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","نسبة عبد الرحمن بن عوف رضي الله عنه"
"257","صِفَةُ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  رَضِيَ اللهُ عَنْهُ  258  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  قَبِيصَةَ بْنِ جَابِرٍ الْأَسَدِيِّ ، قَالَ :  كُنْتُ مُحْرِمًا فَرَأَيْتُ ظَبْيًا فَرَمَيْتُهُ  ، فَأَصَبْتُ خَشَشَاهُ -  يَعْنِي أَصْلَ قَرْنِهِ  - فَرَكِبَ  رَدْعَهُ  ، فَوَقَعَ فِي نَفْسِي مِنْ ذَلِكَ شَيْءٌ ، فَأَتَيْتُ عُمَرَ بْنَ الْخَطَّابِ - رَضِيَ اللهُ عَنْهُ - أَسْأَلُهُ ، فَوَجَدْتُ إِلَى جَنْبِهِ رَجُلًا أَبْيَضَ رَقِيقَ الْوَجْهِ ، فَإِذَا هُوَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ - رَضِيَ اللهُ عَنْهُ -  فَسَأَلْتُ  عُمَرَ  - رَضِيَ اللهُ عَنْهُ - فَالْتَفَتَ إِلَى  عَبْدِ الرَّحْمَنِ  فَقَالَ : "" تَرَى شَاةً تَكْفِيهِ ؟ "" فَقَالَ : نَعَمْ ، فَأَمَرَنِي أَنْ أَذْبَحَ شَاةً ، فَقُمْنَا مِنْ عِنْدِهِ ، فَقَالَ صَاحِبٌ لِي : إِنَّ أَمِيرَ الْمُؤْمِنِينَ لَمْ يُحْسِنْ يُفْتِيكَ ، حَتَّى سَأَلَ الرَّجُلَ ، فَسَمِعَ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - بَعْضَ كَلَامِهِ ، فَعَلَاهُ  عُمَرُ  بِالدِّرَّةِ ضَرْبًا ، ثُمَّ أَقْبَلَ عَلَيَّ لِيَضْرِبَنِي ، فَقُلْتُ : يَا أَمِيرَ الْمُؤْمِنِينَ ، إِنِّي لَمْ أَقُلْ شَيْئًا إِنَّمَا هُوَ قَالَهُ ، فَتَرَكَنِي ، قَالَ : ثُمَّ قَالَ : "" أَرَدْتَ أَنْ تَقْتُلَ الْحَرَامَ وَتَتَعَدَّ الْفُتْيَا "" ، ثُمَّ قَالَ :  إِنَّ فِي الْإِنْسَانِ عَشَرَةَ  أَخْلَاقٍ  : تِسْعَةٌ حَسَنَةٌ ، وَوَاحِدَةٌ سَيِّئَةٌ يُفْسِدُهَا ذَلِكَ السَّيِّئُ "" ، ثُمَّ قَالَ : "" وَإِيَّاكَ وَعِشْرَةَ الشَّبَابِ  ""  .","","Al-Mu'jam al-Kabir 258","","عبد الرحمن بن عوف بن عبد عوف القرشي عن قبيصة بن جابر بن وهب الأسدي عن عبد الملك بن عمير القبطي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","صفة عبد الرحمن بن عوف رضي الله عنه"
"258","259  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ  ،  عَنْ  قَبِيصَةَ بْنِ جَابِرٍ ، قَالَ :  قَدِمْنَا عَلَى عُمَرَ رَضِيَ اللهُ         [1/128]      عَنْهُ ، فَذَكَرَ نَحْوَهُ ،  فَاجْتَنَحَ  إِلَى رَجُلٍ  ، وَاللهِ لَكَأَنَّ وَجْهَهُ قَلْبٌ  .  في طبعة مكتبة ابن تيمية ( عن ) والمثبت من النسخة الخطية ، ومصنف عبد الرزاق","","Al-Mu'jam al-Kabir 259","","عمر بن الخطاب عن قبيصة بن جابر بن وهب الأسدي عن عبد الملك بن عمير القبطي عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","صفة عبد الرحمن بن عوف رضي الله عنه"
"259","260  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  ضَمْرَةُ ،  عَنْ  عُثْمَانَ بْنِ عَطَاءٍ ،  عَنْ  أَبِيهِ ، قَالَ :  كَانَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ - رَضِيَ اللهُ عَنْهُ - يَلْبَسُ قَمِيصًا مِنْ  كَرَابِيسَ  إِلَى نِصْفِ سَاقِهِ  ، وَرِدَاؤُهُ يَضْرِبُ أَلْيَتَهُ  ""  .","","Al-Mu'jam al-Kabir 260","","عبد الرحمن بن عوف بن عبد عوف القرشي عن عطاء الخراساني عن عثمان بن عطاء الخراساني عن ضمرة بن ربيعة الفلسطيني عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","صفة عبد الرحمن بن عوف رضي الله عنه"
"260","261  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ  ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ ،  عَنِ  ابْنِ إِسْحَاقَ  أَنَّ  عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ ، كَانَ سَاقِطَ الثَّنِيَّتَيْنِ  ،  أَهْتَمَ  أَعْسَرَ  أَعْرَجَ ، كَانَ أُصِيبَ يَوْمَ  أُحُدٍ  فَهُتِمَ ، وَجُرِحَ عِشْرِينَ جِرَاحَةً أَوْ أَكْثَرَ ، أَصَابَهُ بَعْضُهَا فِي رِجْلِهِ فَعَرِجَ  "" .","","Al-Mu'jam al-Kabir 261","","عبد الرحمن بن عوف بن عبد عوف القرشي عن محمد بن إسحاق عن زياد بن عبد الله البكائي عن عبد الملك بن هشام الذهلي عن أحمد بن عبد الله ابن البرقي عن الطبراني","صفة عبد الرحمن بن عوف رضي الله عنه"
"261","سِنُّ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  وَوَفَاتُهُ رَضِيَ اللهُ عَنْهُ  262  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ  ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ، قَالَ : ""  وُلِدُ  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  - رَضِيَ اللهُ عَنْهُ - بَعْدَ الْفِيلِ بِعَشْرِ سِنِينَ  ، وَمَاتَ  سَنَةَ إِحْدَى أَوْ سَنَةَ اثْنَتَيْنِ وَثَلَاثِينَ  ، وَسِنُّهُ خَمْسٌ وَسَبْعُونَ ، وَصَلَّى عَلَيْهِ  عُثْمَانُ بْنُ عَفَّانَ  - رَضِيَ اللهُ عَنْهُمَا  - ""  .","","Al-Mu'jam al-Kabir 262","","","سن عبد الرحمن بن عوف ووفاته رضي الله عنه"
"262","263  / 1  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  قَالَ :  سَمِعْتُ  عَلِيًّا - رَضِيَ اللهُ عَنْهُ - يَوْمَ مَاتَ  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  يَقُولُ :  اذْهَبِ  ابْنَ عَوْفٍ  فَقَدْ أَدْرَكْتَ صَفْوَتَهَا  ، وَسَبَقْتَ رَنْقَهَا  ""  .","","Al-Mu'jam al-Kabir 263","","علي بن أبي طالب عن إبراهيم بن عبد الرحمن بن عوف عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سن عبد الرحمن بن عوف ووفاته رضي الله عنه"
"263","263  / 2  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ :  سَمِعْتُ  عَمْرَو بْنَ الْعَاصِ - رَضِيَ اللهُ عَنْهُ - يَوْمَ مَاتَ  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  يَقُولُ :  اذْهَبْ عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ فَقَدْ ذَهَبْتَ  بِبِطْنَتِكَ  لَمْ تَنْتَقِصْ مِنْهَا بِشَيْءٍ  "" .","","Al-Mu'jam al-Kabir 263","","عبد الرحمن بن عوف بن عبد عوف القرشي عن عمرو بن العاص بن وائل السهمي عن إبراهيم بن عبد الرحمن بن عوف عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سن عبد الرحمن بن عوف ووفاته رضي الله عنه"
"264","[1/129]      264  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  عُمَارَةُ بْنُ زَاذَانَ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  بَيْنَمَا  عَائِشَةُ  - رَضِيَ اللهُ عَنْهَا - فِي بَيْتِهَا ، إِذْ سَمِعَتْ صَوْتًا رُجَّتْ مِنْهُ  الْمَدِينَةُ  ، فَقَالَتْ : مَا هَذَا ؟ فَقَالُوا  عِيرٌ  قَدِمَتْ  لِعَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  مِنَ  الشَّامِ  ، وَكَانَتْ سَبْعَمِائَةِ رَاحِلَةٍ ، فَقَالَتْ عَائِشَةُ - رَضِيَ اللهُ عَنْهَا - : أَمَا إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  رَأَيْتُ  عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ  يَدْخُلُ الْجَنَّةَ  حَبْوًا  فَبَلَغَ ذَلِكَ  عَبْدَ الرَّحْمَنِ  فَأَتَاهَا فَسَأَلَهَا عَمَّا بَلَغَهُ فَحَدَّثَتْهُ قَالَ : "" فَإِنِّي أُشْهِدُكِ أَنَّهَا بِأَحْمَالِهَا وَأَقْتَابِهَا  وَأَحْلَاسِهَا  فِي  سَبِيلِ  اللهِ  .","","Al-Mu'jam al-Kabir 264","","عائشة بنت أبي بكر الصديق عن أنس بن مالك عن ثابت البناني عن عمارة بن زاذان الصيدلاني عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سن عبد الرحمن بن عوف ووفاته رضي الله عنه"
"265","265  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ، قَالَ :  تَصَدَّقَ  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  بِشَطْرِ  مَالِهِ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَرْبَعَةَ آلَافٍ  ، ثُمَّ  تَصَدَّقَ  بِأَرْبَعِينَ أَلْفًا ، ثُمَّ  تَصَدَّقَ  بِأَرْبَعِينَ أَلْفَ دِينَارٍ ، ثُمَّ حَمَلَ عَلَى خَمْسِمِائَةِ فَرَسٍ فِي  سَبِيلِ  اللهِ ، ثُمَّ حَمَلَ عَلَى أَلْفٍ وَخَمْسِمِائَةِ رَاحِلَةٍ فِي  سَبِيلِ  اللهِ ، وَكَانَ عَامَّةُ مَالِهِ مِنَ التِّجَارَةِ  ""  .","","Al-Mu'jam al-Kabir 265","","عبد الرحمن بن عوف بن عبد عوف القرشي عن الزهري عن معمر بن راشد عن عبد الله بن المبارك عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سن عبد الرحمن بن عوف ووفاته رضي الله عنه"
"266","وَمَا  أَسْنَدَ  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  - رَضِيَ اللهُ عَنْهُ - وَذِكْرُ الِاخْتِلَافِ فِي حَدِيثِ  الزُّهْرِيِّ  فِي الطَّاعُونِ .  266  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  وَحَدَّثَنَا  أَبُو زَيْدٍ أَحْمَدُ بْنُ يَزِيدَ الْحَوْطِيُّ ، قَالَا :  ثَنَا  أَبُو الْمُغِيرَةِ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ بْنِ تَمِيمٍ         [1/130]      ثَنَا  الزُّهْرِيُّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ - رَضِيَ اللهُ عَنْهُ - عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا وَقَعَ الطَّاعُونُ بِأَرْضٍ وَأَنْتُمْ بِهَا فَلَا تَخْرُجُوا فِرَارًا مِنْهُ  ، وَإِذَا وَقَعَ بِأَرْضٍ وَلَسْتُمْ بِهَا فَلَا تَدْخُلُوا عَلَيْهِ  قَالَ أَبُو الْقَاسِمِ :  هَكَذَا رَوَاهُ  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ بْنِ تَمِيمٍ ،  وَسُفْيَانُ بْنُ حُسَيْنٍ  ، وَخَالَفَهُمَا  ابْنُ أَبِي ذِئْبٍ  .","","Al-Mu'jam al-Kabir 266","","عبد الرحمن بن عوف بن عبد عوف القرشي عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عبد الرحمن بن يزيد بن تميم السلمي عن عبد القدوس بن الحجاج عن أحمد بن عبد الرحيم بن يزيد الحوطي عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"267","267  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ  ،  أَنَّ عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ ،  أَخْبَرَ  عُمَرَ  - رَضِيَ اللهُ عَنْهُمَا - وَهُوَ فِي طَرِيقِ  الشَّامِ  لَمَّا بَلَغَهُ أَنَّ بِهَا الطَّاعُونَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  إِنَّ هَذَا  الْوَجَعَ - أَوْ هَذَا السَّقَمَ  - عَذَابٌ عُذِّبَ بِهِ مَنْ كَانَ قَبْلَكُمْ  ، فَإِذَا كَانَ بِأَرْضٍ لَسْتُمْ بِهَا فَلَا تَهْبِطُوا عَلَيْهِ ، وَإِذَا كَانَ بِأَرْضٍ وَأَنْتُمْ بِهَا فَلَا تَخْرُجُوا فِرَارًا مِنْهُ "" ، قَالَ : فَرَجَعَ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - بِالنَّاسِ ذَلِكَ الْعَامَ  .  كذا في طبعة مكتبة ابن تيمية ، ونسخة الظاهرية ( 1 ) وأخرجه المصنف في الأوسط من طريق الزهري بنحوه فقال : ( عن سالم وعبد الله بن عامر بن ربيعة ) ، وابن حبان في صحيحه فقال : ( عن سالم عن عبد الله بن عامر بن ربيعة ) فالله أعلم","","Al-Mu'jam al-Kabir 267","","عبد الرحمن بن عوف بن عبد عوف القرشي عن عبد الله بن عامر بن ربيعة العنزي عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"268","268  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زَيْدِ بْنِ الْخَطَّابِ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ نَوْفَلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبَّاسٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا سَمِعْتُمْ بِهِ بِأَرْضٍ فَلَا تَقْدَمُوا عَلَيْهِ  ، وَإِذَا وَقَعَ بِأَرْضٍ وَأَنْتُمْ بِهَا فَلَا تَخْرُجُوا فِرَارًا مِنْهُ  .","","Al-Mu'jam al-Kabir 268","","عبد الرحمن بن عوف بن عبد عوف القرشي عن عبد الله بن عباس عن عبد الله بن الحارث بن نوفل عن عبد الرحمن بن زيد بن الخطاب بن نفيل العدوي عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"269","269  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ،  أَنَا  مَالِكٌ ، (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ         [1/131]      عَبْدِ الْحَمِيدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ زَيْدِ بْنِ الْخَطَّابِ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ نَوْفَلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبَّاسٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا سَمِعْتُمْ بِهِ بِأَرْضٍ فَلَا تَقْدَمُوا عَلَيْهِ  ، وَإِذَا وَقَعَ بِأَرْضٍ وَأَنْتُمْ بِهَا فَلَا تَخْرُجُوا فِرَارًا مِنْهُ  .","","Al-Mu'jam al-Kabir 269","","عبد الرحمن بن عوف بن عبد عوف القرشي عن عبد الله بن عباس عن عبد الله بن الحارث بن نوفل عن عبد الحميد بن عبد الرحمن الجزري عن الزهري عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"270","270  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ أَيُّوبَ ، صَاحِبُ الْمَغَازِي ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنِي  ابْنُ شِهَابٍ الزُّهْرِيُّ ،  عَنْ  عَبْدِ الْحَمِيدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ زَيْدِ بْنِ الْخَطَّابِ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ نَوْفَلٍ ،  أَنَّ  ابْنَ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  قَالَ  : إِنَّ عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ  قَالَ  : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا سَمِعْتُمْ بِهَذَا  الْوَبَاءِ  بِبَلَدٍ فَلَا تَقْدَمُوا عَلَيْهِ  ، وَإِذَا وَقَعَ وَأَنْتُمْ بِهِ فَلَا تَخْرُجُوا فِرَارًا مِنْهُ  .","","Al-Mu'jam al-Kabir 270","","عبد الرحمن بن عوف بن عبد عوف القرشي عن عبد الله بن عباس عن عبد الله بن الحارث بن نوفل عن عبد الحميد بن عبد الرحمن الجزري عن الزهري عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن أحمد بن محمد بن أيوب عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"271","271  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ الْمِصْرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يُونُسُ ،  عَنِ  ابْنِ شِهَابٍ ،  أَخْبَرَنِي  عَبْدُ الْحَمِيدِ بْنُ عَبْدِ الرَّحْمَنِ ، أَنَّ عَبْدَ اللهِ بْنَ الْحَارِثِ ،  حَدَّثَهُ  أَنَّ عَبْدَ اللهِ بْنَ عَبَّاسٍ  حَدَّثَ  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا سَمِعْتُمْ بِهِ فِي أَرْضٍ فَلَا تَقْدَمُوا عَلَيْهِ  ، وَإِذَا وَقَعَ بِأَرْضٍ وَأَنْتُمْ بِهَا فَلَا يُخْرِجَنَّكُمُ الْفِرَارُ مِنْهُ  .","","Al-Mu'jam al-Kabir 271","","عبد الرحمن بن عوف بن عبد عوف القرشي عن عبد الله بن عباس عن عبد الله بن عبد الله بن الحارث بن نوفل الهاشمي عن عبد الحميد بن عبد الرحمن الجزري عن الزهري عن يونس بن يزيدالأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن هارون بن كامل المصري عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"272","272  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ بْنِ مُجَمِّعٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا سَمِعْتُمْ بِهِ بِأَرْضٍ فَلَا تَقْدَمُوا عَلَيْهِ  ، وَإِذَا وَقَعَ وَأَنْتُمْ بِهِ فَلَا تَخْرُجُوا فِرَارًا مِنْهُ  .","","Al-Mu'jam al-Kabir 272","","عبد الرحمن بن عوف بن عبد عوف القرشي عن عبد الله بن عباس عن عبد الله بن عبد الله بن الحارث بن نوفل الهاشمي عن الزهري عن إبراهيم بن إسماعيل بن مجمع عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"273","273  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،         [1/132]      عَنِ  الزُّهْرِيِّ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ هَذَا  الْوَبَاءَ  رِجْزٌ  أَهْلَكَ اللهُ بِهِ بَعْضَ الْأُمَمِ  ، وَقَدْ بَقِيَ فِي الْأَرْضِ مِنْهُ شَيْءٌ يَجِيءُ أَحْيَانًا ، وَيَذْهَبُ أَحْيَانًا ، فَإِذَا وَقَعَ وَأَنْتُمْ بِأَرْضٍ فَلَا تَخْرُجُوا مِنْهَا ، وَإِذَا سَمِعْتُمْ بِهِ فِي أَرْضٍ فَلَا تَأْتُوهَا  .","","Al-Mu'jam al-Kabir 273","","أسامة بن زيد بن حارثة ذو البطين عن عامر بن سعد بن أبي وقاص عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"274","274  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ الْمِصْرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يُونُسُ ، (  ح  ) .  وَحَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ الْمِصْرِيُّ ،  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  أَخْبَرَنِي  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  يُونُسُ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ هَذَا  الْوَجَعَ - أَوِ السَّقَمَ  -  رِجْزٌ  عُذِّبَ بِهِ بَعْضُ الْأُمَمِ قَبْلَكُمْ ، ثُمَّ بَقِيَ بَعْدُ فِي الْأَرْضِ  ، فَيَذْهَبُ الْمَرَّةَ وَيَأْتِي الْأُخْرَى ، فَمَنْ سَمِعَ بِهِ بِأَرْضٍ فَلَا يَقْدَمُونَ عَلَيْهِ ، وَمَنْ وَقَعَ بِأَرْضٍ وَهُوَ بِهَا فَلَا يُخْرِجَنَّهُ الْفِرَارُ مِنْهُ  وَاللَّفْظُ لِحَدِيثِ  اللَّيْثِ  .","","Al-Mu'jam al-Kabir 274","","أسامة بن زيد بن حارثة ذو البطين عن عامر بن سعد بن أبي وقاص عن الزهري عن يونس بن يزيدالأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن هارون بن كامل المصري عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"275","275  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ وَمُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  عَامِرِ بْنِ سَعْدِ بْنِ أَبِي وَقَّاصٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ :  ذُكِرَ الطَّاعُونُ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  إِنَّهُ  رِجْزٌ  أَصَابَ مَنْ كَانَ قَبْلَكُمْ - أَوْ عَذَابٌ أَصَابَ مَنْ كَانَ قَبْلَكُمْ  - فَإِذَا سَمِعْتُمْ بِهِ بِبَلَدٍ فَلَا تَدْخُلُوا عَلَيْهِ  ، وَإِذَا وَقَعَ وَأَنْتُمْ بِبَلَدٍ فَلَا تَخْرُجُوا فِرَارًا مِنْهُ  .","","Al-Mu'jam al-Kabir 275","","أسامة بن زيد بن حارثة ذو البطين عن عامر بن سعد بن أبي وقاص عن محمد بن المنكدر عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"276","276  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  ثَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ هَذَا  الْوَبَاءَ  شَيْءٌ عُذِّبَ بِهِ الْأُمَمُ قَبْلَكُمْ ، وَقَدْ بَقِيَتْ فِي الْأَرْضِ مِنْهُ بَقِيَّةٌ ، فَتَقَعُ أَحْيَانًا وَيَذْهَبُ أَحْيَانًا  ، فَإِذَا وَقَعَ بِأَرْضٍ وَأَنْتُمْ بِهَا فَلَا تَخْرُجُوا مِنْهَا ، وَإِذَا وَقَعَ بِأَرْضٍ وَلَسْتُمْ بِهَا فَلَا تَدْخُلُوا عَلَيْهِ  .","","Al-Mu'jam al-Kabir 276","","سعد بن أبي وقاص عن عامر بن سعد بن أبي وقاص عن الزهري عن معمر بن راشد عن عبد الرحمن بن زياد عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"277","[1/133]      277  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُوسَى الْحَرَشِيُّ ،  ثَنَا  حَاتِمُ بْنُ وَرْدَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ ، قَالَ :  ذُكِرَ الطَّاعُونُ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  إِنَّهُ رِجْسٌ أَصَابَ مَنْ كَانَ قَبْلَكُمْ ، فَإِذَا سَمِعْتُمْ بِهِ بِبَلَدٍ فَلَا تَدْخُلُوهَا عَلَيْهِ  ، وَإِذَا وَقَعَ وَأَنْتُمْ بِبَلَدٍ فَلَا تَخْرُجُوا فِرَارًا مِنْهُ  .","","Al-Mu'jam al-Kabir 277","","زيد بن ثابت الأنصاري عن عامر بن سعد بن أبي وقاص عن الزهري عن عبد الرحمن بن إسحاق العامري عن حاتم بن وردان عن محمد بن موسى الحرشي عن زكريا بن يحيى السجزي عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"278","278  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  هِشَامُ بْنُ سَعْدٍ ، (  ح  )  وَحَدَّثَنِي  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  إِسْحَاقُ بْنُ إِسْمَاعِيلَ الطَّالْقَانِيُّ ،  ثَنَا  جَعْفَرٌ ،  ثَنَا  جَعْفَرُ بْنُ عَوْنٍ ،  أَنَا  هِشَامُ بْنُ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا سَمِعْتُمْ بِهِ بِأَرْضٍ فَلَا تَدْخُلُوا عَلَيْهِ  ، وَإِذَا وَقَعَ وَأَنْتُمْ بِأَرْضٍ فَلَا تَخْرُجُوا فِرَارًا مِنْهُ  .","","Al-Mu'jam al-Kabir 278","","عبد الرحمن بن عوف بن عبد عوف القرشي عن حميد بن عبد الرحمن القرشي عن الزهري عن هشام بن سعد المخزومي عن جعفر بن عون المخزومي عن جعفر بن محمد بن عمران الثعلبي عن إسحاق بن إسماعيل الطالقاني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"279","279  -  حَدَّثَنَا  عَمْرُو بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ الْعَلَاءِ بْنِ زِبْرِيقٍ الْحِمْصِيُّ ،  حَدَّثَنِي  جَدِّي إِبْرَاهِيمُ بْنُ الْعَلَاءِ ،  حَدَّثَنِي  عَمِّي الْحَارِثُ بْنُ الضَّحَّاكِ ،  حَدَّثَنِي  مَنْصُورُ بْنُ الْمُعْتَمِرِ ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ الْمُنْكَدِرِ  يُحَدِّثُ عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَيُّ اللَّيْلِ  أَسْمَعُ  ؟ قَالَ :  جَوْفُ  اللَّيْلِ الْآخِرُ ، ثُمَّ الصَّلَاةُ مَقْبُولَةٌ حَتَّى تُصَلِّيَ الْفَجْرَ  ، ثُمَّ لَا صَلَاةَ حَتَّى تَكُونَ الشَّمْسُ  قِيدَ  رُمْحٍ أَوْ رُمْحَيْنِ ، ثُمَّ الصَّلَاةُ مَقْبُولَةٌ حَتَّى يَقُومَ الظِّلُّ قِيَامَ الرُّمْحِ ، ثُمَّ لَا صَلَاةَ حَتَّى تَزُولَ الشَّمْسُ ، ثُمَّ الصَّلَاةُ مَقْبُولَةٌ حَتَّى تَكُونَ الشَّمْسُ  قِيدَ  رُمْحٍ أَوْ رُمْحَيْنِ ، ثُمَّ لَا صَلَاةَ حَتَّى تَغِيبَ الشَّمْسُ "" قَالَ : ثُمَّ قَالَ : "" أَيُّمَا امْرِئٍ مُسْلِمٍ أَعْتَقَ امْرَأً         [1/134]      مُسْلِمًا ، فَهُوَ فِكَاكُهُ مِنَ النَّارِ ، يُجْزَى بِكُلِّ عَظْمٍ مِنْهُ عَظْمًا مِنْهُ ، وَأَيُّمَا امْرَأَةٍ مُسْلِمَةٍ أَعْتَقَتِ امْرَأَةً مُسْلِمَةً فَهِيَ فِكَاكُهَا مِنَ النَّارِ ، يُجْزَى بِكُلِّ عَظْمٍ مِنْهَا عَظْمًا مِنْهَا ، وَأَيُّمَا امْرِئٍ مُسْلِمٍ أَعْتَقَ امْرَأَتَيْنِ مُسْلِمَتَيْنِ فَهُمَا فِكَاكُهُ مِنَ النَّارِ ، يُجْزَى عَظْمَيْنِ مِنْهُمَا عَظْمًا مِنْهُ  .","","Al-Mu'jam al-Kabir 279","","عبد الرحمن بن عوف بن عبد عوف القرشي عن أبو سلمة بن عبد الرحمن عن محمد بن المنكدر عن منصور بن المعتمر عن الحارث بن الضحاك عن إبراهيم بن العلاء زبريق عن عمرو بن إسحاق بن إبراهيم الزبيدي عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"280","280  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  ذُؤَيْبُ بْنُ عِمَامَةَ السَّهْمِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ سَالِمٍ ، مَوْلَى عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  قَالَ :  افْتَقَدَ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَجُلًا  مِنْ أَصْحَابِهِ ، قَالَ :  أَيْنَ كُنْتَ ؟ فَإِنِّي لَمْ أَرَكَ ؟ أَلَمْ تَشْهَدِ الصَّلَاةَ  ؟ "" قَالَ : بَلَى ، وَلَكِنِّي جِئْتُ وَقَدْ ثَبَتَ النَّاسُ ، وَكَرِهْتُ أَنْ  أَتَخَطَّى  رِقَابَ النَّاسِ ، قَالَ : "" أَحْسَنْتَ  .","","Al-Mu'jam al-Kabir 280","","عبد الرحمن بن عوف بن عبد عوف القرشي عن حميد بن عبد الرحمن القرشي عن عبد الرحمن بن حميد بن عبد الرحمن بن عوف عن سليمان بن سالم المدني عن ذؤيب بن عمامة السهمي عن المقدام بن داود الرعيني عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"281","281  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  ذُؤَيْبُ بْنُ عِمَامَةَ ،  ثَنَا  سُلَيْمَانُ بْنُ سَالِمٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ حُمَيْدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْعَامِلُ إِذَا اسْتُعْمِلَ فَأَخَذَ الْحَقَّ وَأَعْطَى الْحَقَّ كَالْمُجَاهِدِ فِي  سَبِيلِ  اللهِ  حَتَّى يَرْجِعَ إِلَى بَيْتِهِ  .","","Al-Mu'jam al-Kabir 281","","عبد الرحمن بن عوف بن عبد عوف القرشي عن حميد بن عبد الرحمن القرشي عن عبد الرحمن بن حميد بن عبد الرحمن بن عوف عن سليمان بن سالم المدني عن ذؤيب بن عمامة السهمي عن المقدام بن داود الرعيني عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"282","282  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  ذُؤَيْبٌ ،  ثَنَا  سُلَيْمَانُ بْنُ سَالِمٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ حُمَيْدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  صَلَاةُ  الْهَجِيرِ  مِنْ صَلَاةِ اللَّيْلِ  فَسَأَلْتُ  عَبْدَ الرَّحْمَنِ بْنَ حُمَيْدٍ  عَنِ  الْهَجِيرِ  ، قَالَ :  إِذَا زَالَتِ الشَّمْسُ  "" .","","Al-Mu'jam al-Kabir 282","","عبد الرحمن بن عوف بن عبد عوف القرشي عن حميد بن عبد الرحمن القرشي عن عبد الرحمن بن حميد بن عبد الرحمن بن عوف عن سليمان بن سالم المدني عن ذؤيب بن عمامة السهمي عن المقدام بن داود الرعيني عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"283","283  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  ذُؤَيْبُ بْنُ عِمَامَةَ ،  ثَنَا  سُلَيْمَانُ بْنُ سَالِمٍ ،         [1/135]      قَالَ :  سَمِعْتُ  عَبْدَ الرَّحْمَنِ بْنَ حُمَيْدٍ ،  يَذْكُرُ عَنْ  أَبِيهِ ، قَالَ :  سَمِعَ  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  - رَضِيَ اللهُ عَنْهُ - رَجُلًا مِنْ بَنِي هَاشِمٍ يَقُولُ :  أَنَا أَوْلَى النَّاسِ بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - فَقَالَ : "" غَيْرُهُ أَوْلَى بِهِ مِنْكَ وَلَكَ نَسَبُهُ ""  .","","Al-Mu'jam al-Kabir 283","","عبد الرحمن بن عوف بن عبد عوف القرشي عن حميد بن عبد الرحمن القرشي عن عبد الرحمن بن حميد بن عبد الرحمن بن عوف عن سليمان بن سالم المدني عن ذؤيب بن عمامة السهمي عن المقدام بن داود الرعيني عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"284","284  -  حَدَّثَنَا  جَعْفَرُ بْنُ الْفَضْلِ الْمَخْزُومِيُّ الْمُؤَدِّبُ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْمَلِكِ بْنِ شَيْبَةَ الْحِزَامِيُّ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ الْعَلَاءِ بْنِ حُسَيْنٍ النَّبَقِيُّ الْمُطَّلِبِيُّ ، قَالَ :  حَدَّثَنِي  الْوَلِيدُ بْنُ إِبْرَاهِيمَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ :  اسْتُعِزَّ  بِأُمَامَةَ بِنْتِ أَبِي الْعَاصِ  ، فَبَعَثَتْ  زَيْنَبُ  بِنْتُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَقُولُ لَهُ : إِنَّ ابْنَتِي قَدِ  اسْتُعِزَّ  بِهَا ، فَبَعَثَ إِلَى ابْنَتِهِ :  لِلهِ مَا أَخَذَ وَلَهُ وَمَا أَبْقَى  وَاسْتُعِزَّتِ  الثَّانِيَةَ ، فَبَعَثَتْ إِلَيْهِ : إِنَّ ابْنَتِي قَدِ  اسْتُعِزَّ  بِهَا ، فَبَعَثَ إِلَى ابْنَتِهِ : "" لِلهِ مَا أَخَذَ وَلَهُ مَا أَبْقَى "" ثُمَّ كَانَتِ الثَّالِثَةُ ، فَجَاءَهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخْرَجَتِ الصَّبِيَّةَ إِلَيْهِ ، فَإِذَا نَفْسُهَا  تَقَعْقَعُ  فِي صَدْرِهَا ، وَمَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَاسٌ مِنْ أَصْحَابِهِ ،  فَذَرَفَتْ  عَيْنَاهُ حَتَّى قَبَضَ عَلَى لِحْيَتِهِ ، فَفَطِنَ بِهِمْ وَهُمْ يَنْظُرُونَ إِلَيْهِ ، فَقَالَ : "" مَا لَكُمْ تَنْظُرُونَ ؟ "" قَالُوا : يَا رَسُولَ اللهِ رَأَيْنَاكَ رَقَقْتَ ، قَالَ : "" رَحْمَةٌ يَضَعُهَا اللهُ - عَزَّ وَجَلَّ - حَيْثُ يَشَاءُ ، وَإِنَّمَا يَرْحَمُ اللهُ غَدًا مِنْ عِبَادِهِ الرُّحَمَاءَ  .","","Al-Mu'jam al-Kabir 284","","عبد الرحمن بن عوف بن عبد عوف القرشي عن إبراهيم بن عبد الرحمن بن عوف عن الوليد بن إبراهيم بن عبد الرحمن بن عوف عن محمد بن العلاء بن أبي نيقة عن عبد الرحمن بن عبد الملك الحزامي عن جعفر بن الفضل التمار عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"285","285  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ضِرَارُ بْنُ صُرَدٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الْعَزِيزِ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْمِسْوَرِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ - رَضِيَ اللهُ عَنْهُ -  قَوْلَهُ - عَزَّ وَجَلَّ - :         {      ثُمَّ أَنْـزَلَ عَلَيْكُمْ مِنْ بَعْدِ الْغَمِّ أَمَنَةً نُعَاسًا         }      قَالَ :  أُلْقِيَ عَلَيْنَا النَّوْمُ يَوْمَ  أُحُدٍ  ""  .","","Al-Mu'jam al-Kabir 285","","عبد الرحمن بن عوف بن عبد عوف القرشي عن المسور بن مخرمة عن عبد الرحمن بن المسور بن مخرمة عن الزهري عن محمد بن عبد العزيز العوفى عن عبد العزيز بن محمد الدراوردي عن ضرار بن صرد التيمي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"286","286  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ سَعْدٍ الدَّشْتَكِيُّ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ  ،  عَنْ  خَارِجَةَ بْنِ         [1/136]      مُصْعَبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  مُحَمَّدِ بْنِ زَيْدٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَسِيرُ الْفِقْهِ خَيْرٌ مِنْ كَثِيرِ الْعِبَادَةِ  وَخَيْرُ أَعْمَالِكُمْ أَيْسَرُهَا  .","","Al-Mu'jam al-Kabir 286","","عبد الرحمن بن عوف بن عبد عوف القرشي عن أبو سلمة بن عبد الرحمن عن محمد بن زيد بن المهاجر الجدعاني عن عبد الله بن عطاء بن يسار عن خارجة الضبعي عن عبد الله بن سعد بن عثمان الدشتكي عن عبد الرحمن بن عبد الله الدشتكي عن أحمد بن عبد الرحمن حمدون الدشتكي عن علي بن سعيد بن بشير عليك عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"287","287  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ ،  ثَنَا  آدَمُ ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ زَيْدٍ ،  عَنْ  مُصْعَبِ بْنِ مُصْعَبٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  قَالَ :  كَلَّمَ  طَلْحَةُ  عَامِرَ بْنَ فُهَيْرَةَ  بِشَيْءٍ ، فَقَالَ لَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَهْلًا يَا  طَلْحَةُ  ، فَإِنَّهُ قَدْ شَهِدَ  بَدْرًا  كَمَا شَهِدْتَهُ  ، وَخَيْرُكُمْ خَيْرُكُمْ لِمَوَالِيهِ  .","","Al-Mu'jam al-Kabir 287","","عبد الرحمن بن عوف بن عبد عوف القرشي عن أبو سلمة بن عبد الرحمن عن الزهري عن مصعب بن مصعب بن عبد الرحمن الزهري عن عبد الملك بن زيد بن سعيد القرشي عن محمد بن إسماعيل بن مسلم الديلي عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"288","288  -  حَدَّثَنَا  عَبْدُ الْوَارِثِ بْنُ إِبْرَاهِيمَ أَبُو عُبَيْدَةَ الْعَسْكَرِيُّ ، وَمُعَاذُ بْنُ الْمُثَنَّى ، قَالَا :  ثَنَا  عِيسَى بْنُ إِبْرَاهِيمَ الْبِرَكِيُّ ،  ثَنَا  عَفِيفُ بْنُ سَالِمٍ ،  ثَنَا  لَيْثُ بْنُ سَعْدٍ الْمِصْرِيُّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَالَ الشَّيْطَانُ - لَعَنَهُ اللهُ - : لَنْ يَسْلَمَ مِنِّي صَاحِبُ الْمَالِ مِنْ إِحْدَى ثَلَاثٍ  ، أَغْدُو عَلَيْهِ بِهِنَّ وَأَرُوحُ بِهِنَّ : أَخْذُهُ الْمَالَ مِنْ غَيْرِ حِلِّهِ ، وَإِنْفَاقُهُ فِي غَيْرِ حَقِّهِ ، وَأُحَبِّبُهُ إِلَيْهِ فَيَمْنَعُهُ مِنْ حَقِّهِ  .","","Al-Mu'jam al-Kabir 288","","عبد الرحمن بن عوف بن عبد عوف القرشي عن أبو سلمة بن عبد الرحمن عن الزهري عن الليث بن سعد عن عفيف بن سالم الموصلي عن عيسى بن إبراهيم البركي عن معاذ بن المثنى العنبري عن الطبراني","وما أسند عبد الرحمن بن عوف رضي الله عنه وذكر الاختلاف في حديث الزهري في الطاعون"
"289","8 - نِسْبَةُ  سَعْدِ بْنِ أَبِي وَقَّاصٍ  رَضِيَ اللهُ عَنْهُ  وَاسْمُ  أَبِي وَقَّاصٍ مَالِكُ بْنُ أَهْيَبَ بْنِ عَبْدِ مَنَافِ بْنِ زُهْرَةَ وَيُكَنَّى أَبَا إِسْحَاقَ  ، شَهِدَ  بَدْرًا  .  289  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ         [1/137]      عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  سَعْدٍ - رَضِيَ اللهُ عَنْهُ -  أَنَّهُ جَاءَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، مَنْ أَنَا ؟ قَالَ :  سَعْدُ بْنُ مَالِكِ بْنِ أُهَيْبِ بْنِ عَبْدِ مَنَافِ بْنِ زُهْرَةَ  ، مَنْ قَالَ غَيْرَ ذَلِكَ فَعَلَيْهِ لَعْنَةُ اللهِ  .","","Al-Mu'jam al-Kabir 289","","سعد بن أبي وقاص عن سعيد بن المسيب عن علي بن زيد بن جدعان عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","نسبة سعد بن أبي وقاص رضي الله عنه"
"290","290  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ - رَضِيَ اللهُ عَنْهُ - قَالَ  لِسَعْدٍ  :  كَذَاكَ الظَّنُّ بِكَ يَا  أَبَا إِسْحَاقَ  ""  .","","Al-Mu'jam al-Kabir 290","","عمر بن الخطاب عن جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","نسبة سعد بن أبي وقاص رضي الله عنه"
"291","291  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مَعْمَرُ بْنُ بَكَّارٍ السَّعْدِيُّ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنِ  الزُّهْرِيِّ ، قَالَ :  قَالَ  سَعْدٌ : يَا رَسُولَ اللهِ ، مَنْ أَنَا ؟ قَالَ :  أَنْتَ  سَعْدُ بْنُ مَالِكِ بْنِ أُهَيْبِ بْنِ عَبْدِ مَنَافِ بْنِ زُهْرَةَ  ، فَمَنْ قَالَ غَيْرَ ذَلِكَ فَعَلَيْهِ لَعْنَةُ اللهِ  .","","Al-Mu'jam al-Kabir 291","","سعد بن أبي وقاص عن الزهري عن عثمان بن عبد الرحمن بن عمر الوقاصي عن معمر بن بكار السعدي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","نسبة سعد بن أبي وقاص رضي الله عنه"
"292","292  -  حَدَّثَنَا  أَحْمَدُ بْنُ شَاهِينَ الْبَغْدَادِيُّ  ،  ثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ  ، قَالَ : ""  أُمُّ سَعْدِ بْنِ أَبِي وَقَّاصٍ : حَمْنَةُ بِنْتُ أَبِي سُفْيَانَ بْنِ أُمَيَّةَ بْنِ عَبْدِ شَمْسِ بْنِ عَبْدِ مَنَافٍ  ، وَأُمُّهَا  بِنْتُ أَبِي سَرْحِ بْنِ حَبِيبِ بْنِ جَذِيمَةَ بْنِ نَصْرِ بْنِ مَالِكِ بْنِ حَسَلِ بْنِ عَامِرِ بْنِ لُؤَيِّ بْنِ غَالِبٍ  ""  .","","Al-Mu'jam al-Kabir 292","","","نسبة سعد بن أبي وقاص رضي الله عنه"
"293","صِفَةُ  سَعْدِ بْنِ مَالِكٍ  رَضِيَ اللهُ عَنْهُ  293  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ ، قَالَ :  قَالَ  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ :  حَدَّثَنِي  عَبْدُ اللهِ بْنُ جَعْفَرٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُحَمَّدِ بْنِ سَعْدٍ ، قَالَ :  كَانَ سَعْدُ بْنُ أَبِي وَقَّاصٍ  جَعْدَ  الشَّعَرِ  ، أَشْعَرَ الْجَسَدِ ، آدَمَ طَوِيلًا ، أَفْطَسَ  ""  .","","Al-Mu'jam al-Kabir 293","","سعد بن أبي وقاص عن إسماعيل بن محمد بن سعد عن عبد الله بن جعفر بن عبد الرحمن بن المسور بن مخرمة عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن الزبير بن بكار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","صفة سعد بن مالك رضي الله عنه"
"294","294  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  حَدَّثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ         [1/138]      الْمُنْذِرِ ،  عَنِ  الْوَاقِدِيِّ ،  عَنْ  بُكَيْرِ بْنِ مِسْمَارٍ ،  عَنْ  عَائِشَةَ بِنْتِ سَعْدٍ ، قَالَتْ :  كَانَ أَبِي رَجُلًا قَصِيرًا  دَحْدَاحًا  ، غَلِيظًا ذَا هَامَةٍ ،  شَثْنَ  الْأَصَابِعِ ، وَقَدْ شَهِدَ  بَدْرًا  ""  .","","Al-Mu'jam al-Kabir 294","","سعد بن أبي وقاص عن عائشة بنت سعد بن أبي وقاص عن بكير بن مسمار الزهري عن الواقدي عن إبراهيم بن المنذر الحزامي عن الزبير بن بكار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","صفة سعد بن مالك رضي الله عنه"
"295","295  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  رِشْدِينُ بْنُ سَعْدٍ ،  عَنْ  يُونُسَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  أَنَّ  سَعْدَ بْنَ أَبِي وَقَّاصٍ ، كَانَ يَخْضِبُ بِالسَّوَادِ  "" .","","Al-Mu'jam al-Kabir 295","","سعد بن أبي وقاص عن سعيد بن المسيب عن الزهري عن يونس بن يزيدالأيلي عن رشدين بن سعد المهري عن نعيم بن حماد الخزاعي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","صفة سعد بن مالك رضي الله عنه"
"296","296  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  سُلَيْمُ بْنُ مُسْلِمٍ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  أَنَّ  سَعْدًا كَانَ يَخْضِبُ بِالسَّوَادِ  "" .","","Al-Mu'jam al-Kabir 296","","سعد بن أبي وقاص عن عامر بن سعد بن أبي وقاص عن الزهري عن معمر بن راشد عن سليم بن مسلم الخشاب عن عبد الله بن عمر مشكدانة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","صفة سعد بن مالك رضي الله عنه"
"297","297  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  اشْتَرَكْنَا يَوْمَ  بَدْرٍ  أَنَا  وَعَمَّارٌ  وَسَعْدٌ  فِي النَّفْلِ  ، فَأَصَابَ  سَعْدٌ  أَسِيرَيْنِ ،  وَأَخْفَقْتُ  أَنَا  وَعَمَّارٌ  "" .","","Al-Mu'jam al-Kabir 297","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن زكريا بن أبي زائدة الوادعي عن يحيى بن زكريا بن أبي زائدة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","صفة سعد بن مالك رضي الله عنه"
"298","298  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هَاشِمِ بْنِ هَاشِمٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  سَمِعْتُ  سَعْدًا ، يَقُولُ :  مَا أَسْلَمَ أَحَدٌ إِلَّا فِي الْيَوْمِ الَّذِي أَسْلَمْتُ فِيهِ  ، وَلَقَدْ مَكَثْتُ سَبْعَةَ أَيَّامٍ وَإِنِّي لَثُلُثُ الْإِسْلَامِ  "" .","","Al-Mu'jam al-Kabir 298","","سعد بن أبي وقاص عن سعيد بن المسيب عن هاشم بن هاشم بن عتبة الوقاصي عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","صفة سعد بن مالك رضي الله عنه"
"299","سِنُّ  سَعْدِ بْنِ أَبِي وَقَّاصٍ  وَوَفَاتُهُ رَضِيَ اللهُ عَنْهُ  299  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  ،  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ رَاشِدٍ ،  يُحَدِّثُ عَنِ  الزُّهْرِيِّ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ، قَالَ :  كَانَ  سَعْدٌ  آخِرَ  الْمُهَاجِرِينَ  وَفَاةً رَضِيَ اللهُ عَنْهُمْ  .         [1/139]      300  - قَالَ عَبْدُ اللهِ : قَالَ أَبِي : "" تُوُفِّيَ وَهُوَ ابْنُ ثَلَاثٍ وَثَمَانِينَ ، وَمَاتَ عَلَى عَشَرَةِ أَمْيَالٍ فِي  الْمَدِينَةِ  ، فَحُمِلَ عَلَى رِقَابِ الرِّجَالِ إِلَى  الْمَدِينَةِ  ، وَكَانَ  مَرْوَانُ  يَوْمَئِذٍ الْوَالِيَ عَلَيْهَا ، وَأَسْلَمَ وَهُوَ ابْنُ تِسْعَ عَشْرَةَ سَنَةً "" .","","Al-Mu'jam al-Kabir 299","","عامر بن سعد بن أبي وقاص عن الزهري عن النعمان بن راشد الجزري عن جرير بن حازم عن وهب بن جرير بن حازم عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"300","301  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ نُمَيْرٍ  ، يَقُولُ : ""  مَاتَ  سَعْدٌ  ،  وَمَرْوَانُ  وَالِي  الْمَدِينَةِ  ، فَصَلَّى عَلَيْهِ  ، وَمَاتَ سَنَةَ خَمْسٍ وَخَمْسِينَ  ""  .","","Al-Mu'jam al-Kabir 301","","","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"301","302  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ ، قَالَ :  مَاتَ سَعْدٌ  بِالْعَقِيقِ  فِي قَصْرِهِ عَلَى عَشَرَةِ أَمْيَالٍ مِنَ  الْمَدِينَةِ  ،  وَحُمِلَ عَلَى رِقَابِ الرِّجَالِ إِلَى  الْمَدِينَةِ  ، وَيُقَالُ : تُوُفِّيَ وَهُوَ ابْنُ  بِضْعٍ  وَسَبْعِينَ  ""  .","","Al-Mu'jam al-Kabir 302","","سعد بن أبي وقاص عن الزبير بن بكار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"302","303  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ  ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ، قَالَ : ""  مَاتَ  سَعْدُ بْنُ أَبِي وَقَّاصٍ  - رَضِيَ اللهُ عَنْهُ -  بِالْعَقِيقِ  ، وَحُمِلَ إِلَى  الْمَدِينَةِ  ،  وَصَلَّى عَلَيْهِ  مَرْوَانُ بْنُ الْحَكَمِ  ، وَقَالَ : أَسْلَمْتُ وَأَنَا ابْنُ تِسْعَ عَشْرَةَ سَنَةً ، وَتُوُفِّيَ سَنَةَ خَمْسٍ وَخَمْسِينَ  "" .","","Al-Mu'jam al-Kabir 303","","","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"303","304  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  ،  ثَنَا  نُوحُ بْنُ يَزِيدَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ، قَالَ :  تُوُفِّيَ سَعْدُ بْنُ أَبِي وَقَّاصٍ فِي زَمَنِ  مُعَاوِيَةَ  - رَضِيَ اللهُ عَنْهُ - بَعْدَ حَجَّتِهِ الْأُولَى  ، وَهُوَ ابْنُ ثَلَاثٍ وَثَمَانِينَ  "" .","","Al-Mu'jam al-Kabir 304","","سعد بن أبي وقاص عن إبراهيم بن سعد أبو إسحاق الزهري عن نوح بن يزيد بن سيار البغدادي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"304","305  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَدِينِيُّ فُسْتُقَةُ ،  حَدَّثَنَا  أَبُو مُوسَى ،  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  حَدَّثَنِي  أَبِي  ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ رَاشِدٍ  يُحَدِّثُ عَنِ  الزُّهْرِيِّ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ، قَالَ :  كَانَ  سَعْدٌ  آخِرَ  الْمُهَاجِرِينَ  وَفَاةً رَضِيَ اللهُ عَنْهُمْ  ""  .","","Al-Mu'jam al-Kabir 305","","عامر بن سعد بن أبي وقاص عن الزهري عن النعمان بن راشد الجزري عن جرير بن حازم عن وهب بن جرير بن حازم عن أبو موسى الزمن عن محمد بن علي فستقة البغدادي عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"305","306  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا ،  ثَنَا  إِسْمَاعِيلُ ،  عَنْ  قَيْسٍ ، قَالَ :  كَانَ لِابْنِ مَسْعُودٍ عَلَى  سَعْدٍ  - رَضِيَ اللهُ         [1/140]      عَنْهُمَا - مَالٌ ،  فَقَالَ  ابْنُ مَسْعُودٍ  :  أَدِّ الْمَالَ الَّذِي قِبَلَكَ  ، فَقَالَ  سَعْدٌ  : "" وَيْحَكَ مَالِي وَمَالُكَ ؟ "" قَالَ : أَدِّ الْمَالَ الَّذِي قِبَلَكَ ،  فَقَالَ  سَعْدٌ : "" وَاللهِ إِنِّي لَأَرَاكَ لَاقٍ مِنِّي شَرًّا ، هَلْ أَنْتَ إِلَّا  ابْنُ مَسْعُودٍ  وَعَبْدٌ مِنْ  بَنِي هُذَيْلٍ  ؟ "" قَالَ : أَجَلْ ، وَاللهِ إِنِّي  لَابْنُ مَسْعُودٍ  ، وَإِنَّكَ  لَابْنُ حَمْنَةَ  ، فَقَالَ لَهُمَا  هَاشِمُ بْنُ عُتْبَةَ  : إِنَّكُمَا صَاحِبَا رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْظُرُ النَّاسُ إِلَيْكُمَا ، فَطَرَحَ  سَعْدٌ  عُودًا كَانَ بِيَدِهِ ، ثُمَّ رَفَعَ يَدَهُ فَقَالَ : "" اللَّهُمَّ رَبَّ السَّمَاوَاتِ "" فَقَالَ لَهُ  عَبْدُ اللهِ  : قُلْ قَوْلًا وَلَا تَلْعَنْ ، فَسَكَتَ ، ثُمَّ قَالَ  سَعْدٌ  :  أَمَا وَاللهِ لَوْلَا اتِّقَاءُ اللهِ لَدَعَوْتُ عَلَيْكَ دَعْوَةً لَا تُخْطِئُكَ  ""  .","","Al-Mu'jam al-Kabir 306","","سعد بن أبي وقاص عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى بن زكريا بن أبي زائدة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"306","307  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ ،  ثَنَا  ابْنُ عَوْنٍ ، قَالَ :  أَنْبَأَنِي  مُحَمَّدُ بْنُ مُحَمَّدِ بْنِ الْأَسْوَدِ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ، قَالَ :  بَيْنَمَا سَعْدٌ يَمْشِي ، إِذْ مَرَّ  بِرَجُلٍ  وَهُوَ يَشْتِمُ  عَلِيًّا  ،  وَطَلْحَةَ  ،  وَالزُّبَيْرَ  ،  فَقَالَ لَهُ  سَعْدٌ  :  إِنَّكَ تَشْتِمُ قَوْمًا قَدْ سَبَقَ لَهُمُ مِنَ اللهِ مَا سَبَقَ ، فَوَاللهِ لَتَكُفَّنَّ عَنْ شَتْمِهِمْ ، أَوْ لَأَدْعُوَنَّ اللهَ - عَزَّ وَجَلَّ - عَلَيْكَ  فَقَالَ : تُخَوِّفُنِي كَأَنَّكَ نَبِيٌّ ، فَقَالَ  سَعْدٌ  : "" اللَّهُمَّ إِنَّ هَذَا يَشْتِمُ أَقْوَامًا سَبَقَ لَهُمْ مِنْكَ مَا سَبَقَ فَاجْعَلْهُ الْيَوْمَ نَكَالًا "" فَجَاءَتْ  بُخْتِيَّةٌ  فَأَفْرَجَ النَّاسُ لَهَا ، فَتَخَبَّطَتْهُ ، فَرَأَيْتُ النَّاسَ يَتَّبِعُونَ  سَعْدًا  وَيَقُولُونَ : اسْتَجَابَ اللهُ لَكَ يَا  أَبَا إِسْحَاقَ  .","","Al-Mu'jam al-Kabir 307","","سعد بن أبي وقاص عن عامر بن سعد بن أبي وقاص عن محمد بن محمد بن الأسود الزهري عن عبد الله بن عون بن أرطبان عن محمد بن عبد الله بن المثنى الخزرجي عن أبو مسلم الكجي عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"307","308  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ،  أَنَّ  أَهْلَ الْكُوفَةِ  شَكَوْا  سَعْدًا  إِلَى  عُمَرَ  - رَضِيَ اللهُ عَنْهُ - فَبَعَثَ رِجَالًا يَسْأَلُونَ عَنْهُ  بِالْكُوفَةِ  ، فَكَانُوا لَا يَأْتُونَ مَسْجِدًا مِنْ مَسَاجِدِ  أَهْلِ الْكُوفَةِ  إِلَّا أَثْنَوْا عَلَيْهِ خَيْرًا ، وَقَالُوا مَعْرُوفًا ، حَتَّى أَتَوْا مَسْجِدًا مِنْ مَسَاجِدِ  بَنِي عَبْسٍ  ، فَقَامَ رَجُلٌ يُقَالُ لَهُ  أَبُو سَعْدَةَ  فَقَالَ : أَمَا إِذْ نَاشَدْتُمُونَا ، فَإِنَّهُ كَانَ لَا يَسِيرُ  بِالسَّرِيَّةِ ،  وَلَا يَعْدِلُ فِي الْقَضِيَّةِ ، وَلَا يَقْسِمُ بِالسَّوِيَّةِ ،  فَقَالَ  سَعْدٌ :  اللَّهُمَّ إِنْ كَانَ كَاذِبًا فَأَعْمِ بَصَرَهُ  ، وَأَطِلْ فَقْرَهُ ، وَعَرِّضْهُ         [1/141]      لِلْفِتَنِ "" قَالَ  عَبْدُ الْمَلِكِ  : فَأَنَا رَأَيْتُهُ يَتَعَرَّضُ لِلْإِمَاءِ فِي السِّكَكِ ، فَإِذَا سَأَلُوهُ كَيْفَ أَنْتَ  أَبَا سَعْدَةَ  ؟ فَيَقُولُ : كَبِيرٌ ضَرِيرٌ ، فَقِيرٌ مَفْتُونٌ ، أَصَابَتْنِي دَعْوَةُ  سَعْدٍ  .  قَالَ أَبُو الْقَاسِمِ : ""  أَبُو سَعْدَةَ هُوَ جَدُّ أَبِي بَكْرِ بْنِ أَبِي شَيْبَةَ  "" .","","Al-Mu'jam al-Kabir 308","","سعد بن أبي وقاص عن جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"308","309  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  خَرَجَتْ جَارِيَةٌ  لِسَعْدٍ  يُقَالُ لَهَا :  زِيرَا  ، وَعَلَيْهَا قَمِيصٌ جَدِيدٌ ، فَكَشَفَتْهَا الرِّيحُ ، فَشَدَّ عَلَيْهَا عُمَرُ - رَضِيَ اللهُ عَنْهُ - بِالدِّرَّةِ  ، وَجَاءَ  سَعْدٌ  لِيَمْنَعَهُ ، فَتَنَاوَلَهُ بِالدِّرَّةِ ، فَذَهَبَ سَعْدٌ يَدْعُو عَلَى  عُمَرَ  ، فَنَاوَلَهُ  عُمَرُ  الدِّرَّةَ ، وَقَالَ : اقْتَصَّ ، فَعَفَا عَنْ  عُمَرَ  رَضِيَ اللهُ عَنْهُمَا  "" .","","Al-Mu'jam al-Kabir 309","","سعد بن أبي وقاص عن سعيد بن المسيب عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"309","310  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ السَّرَّاجُ ،  ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  ثَنَا  عَبْدُ الْحَكِيمِ بْنُ مَنْصُورٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ، قَالَ :  هَجَا  رَجُلٌ  مِنَ الْمُسْلِمِينَ سَعْدًا ، فَقَالَ :  آمَتْ  فَبَلَغَ ذَلِكَ  سَعْدًا  - رَضِيَ اللهُ عَنْهُ - فَرَفَعَ يَدَهُ ،  وَقَالَ  :  اللَّهُمَّ اقْطَعْ لِسَانَهُ وَيَدَهُ عَنِّي بِمَا شِئْتَ  فَرُمِيَ يَوْمَ  الْقَادِسِيَّةِ  ، وَقُطِعَ لِسَانُهُ وَقُطِعَتْ يَدُهُ ، وَقُتِلَ  .","","Al-Mu'jam al-Kabir 310","","سعد بن أبي وقاص عن عبد الملك بن عمير القبطي عن عبد الحكيم بن منصور الخزاعي عن محمد بن بكار الرصافي عن محمد بن عبدوس السراج عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"310","311  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  حَدَّثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ الْبَكَّائِيُّ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  قَبِيصَةَ بْنِ جَابِرٍ الْأَسَدِيِّ ، قَالَ :  قَالَ ابْنُ عَمٍّ لَنَا يَوْمَ  الْقَادِسِيَّةِ  :         [1/142]      آمَتْ  فَلَمَّا بَلَغَ سَعْدًا - رَضِيَ اللهُ عَنْهُ - قَوْلُهُ  قَالَ  :  اللَّهُمَّ اقْطَعْ عَنِّي لِسَانَهُ وَيَدَهُ  فَجَاءَتْ نُشَّابَةٌ فَأَصَابَتْ فَاهُ فَخَرِسَ ، ثُمَّ قُطِعَتْ يَدُهُ فِي الْقِتَالِ ، فَقَالَ  سَعْدٌ  : "" احْمِلُونِي عَلَى بَابٍ "" فَخُرِجَ بِهِ مَحْمُولًا ، ثُمَّ كَشَفَ عَنْ ظَهْرِهِ وَبِهِ قُرُوحٌ فِي ظَهْرِهِ ، فَأَخْبَرَ النَّاسَ بِعُذْرِهِ فَعَذَرُوهُ ، وَكَانَ  سَعْدٌ  لَا يَجْبُنُ ، وَقَالَ : "" إِنَّمَا فَعَلْتُ هَذَا لِمَا بَلَغَنِي مِنْ قَوْلِكُمْ  .","","Al-Mu'jam al-Kabir 311","","سعد بن أبي وقاص عن قبيصة بن جابر بن وهب الأسدي عن عبد الملك بن عمير القبطي عن زياد بن عبد الله البكائي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"311","312  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  جَعْفَرِ بْنِ سُلَيْمَانَ ،  عَنْ  عِكْرِمَةَ بْنِ خَالِدٍ ،  أَنَّ  سَعْدًا قَالَ لِابْنِهِ حِينَ حَضَرَهُ الْمَوْتُ :  يَا بُنَيَّ إِنَّكَ لَنْ تَلْقَى أَحَدًا هُوَ أَنْصَحُ لَكَ مِنِّي ، إِذَا أَرَدْتَ أَنْ تُصَلِّيَ فَأَحْسِنْ وُضُوءَكَ  ، ثُمَّ صَلِّ صَلَاةً لَا تَرَى أَنَّكَ تُصَلِّي بَعْدَهَا ، وَإِيَّاكَ وَالطَّمَعَ ، فَإِنَّهُ فَقْرٌ حَاضِرٌ ، وَعَلَيْكَ بِالْيَأْسِ فَإِنَّهُ الْغِنَى ، وَإِيَّاكَ وَمَا يُعْتَذَرُ مِنْهُ مِنَ الْعَمَلِ وَالْقَوْلِ ، وَاعْمَلْ مَا بَدَا لَكَ  ""  .","","Al-Mu'jam al-Kabir 312","","سعد بن أبي وقاص عن عكرمة بن خالد بن العاص عن جعفر بن سليمان الضبعي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"312","313  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  حَدَّثَنِي  هَاشِمُ بْنُ هَاشِمٍ ، قَالَ :  سَمِعْتُ  سَعِيدَ بْنَ الْمُسَيِّبِ يَقُولُ :  قَالَ  سَعْدُ بْنُ أَبِي وَقَّاصٍ :  مَا أَسْلَمَ أَحَدٌ إِلَّا فِي الْيَوْمِ الَّذِي أَسْلَمْتُ فِيهِ  ، وَلَقَدْ مَكَثْتُ سَبْعَةَ أَيَّامٍ وَإِنِّي لَثُلُثُ الْإِسْلَامِ  ""  .","","Al-Mu'jam al-Kabir 313","","سعد بن أبي وقاص عن سعيد بن المسيب عن هاشم بن هاشم بن عتبة الوقاصي عن زائدة بن قدامة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"313","314  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ، قَالَ :  سَمِعْتُ  سَعْدَ بْنَ أَبِي وَقَّاصٍ  ، يَقُولُ :  إِنِّي لَأَوَّلُ رَجُلٍ مُسْلِمٍ رَمَى بِسَهْمٍ فِي  سَبِيلِ  اللهِ عَزَّ وَجَلَّ  ""  .","","Al-Mu'jam al-Kabir 314","","سعد بن أبي وقاص عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"314","315  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،         [1/143]      عَنْ  بُكَيْرِ بْنِ مِسْمَارٍ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَمَعَ لَهُ أَبَوَيْهِ ، قَالَ : كَانَ  رَجُلٌ  مِنَ الْمُشْرِكِينَ قَدْ أَحْرَقَ الْمُسْلِمِينَ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِسَعْدٍ  :  ارْمِ فِدَاكَ أَبِي وَأُمِّي  ، قَالَ : فَنَزَعْتُ بِسَهْمٍ لَيْسَ فِيهِ نَصْلٌ فَأَصَبْتُ جَنْبَهُ ، فَوَقَعَ وَانْكَشَفَتْ  عَوْرَتُهُ  ، فَضَحِكَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى نَظَرْتُ إِلَى  نَوَاجِذِهِ  .","","Al-Mu'jam al-Kabir 315","","سعد بن أبي وقاص عن عامر بن سعد بن أبي وقاص عن بكير بن مسمار الزهري عن حاتم بن إسماعيل الحارثي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"315","316  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  نَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  عُقَيْلٌ ،  عَنِ  ابْنِ شِهَابٍ ،  أَنَّ  سَعْدَ بْنَ أَبِي وَقَّاصٍ لَمَّا حَضَرَهُ الْمَوْتُ دَعَا بِخَلَقِ جُبَّةٍ صُوفٍ ، فَقَالَ :  كَفِّنُونِي فِيهَا ، فَإِنِّي لَقِيتُ فِيهَا الْمُشْرِكِينَ يَوْمَ  بَدْرٍ  ، وَإِنَّمَا كُنْتُ أُخَبِّئُهَا لِهَذَا  ""  .","","Al-Mu'jam al-Kabir 316","","سعد بن أبي وقاص عن الزهري عن عقيل بن خالد الأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"316","317  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  مُوسَى الْجُهَنِيِّ ،  ثَنَا  مُصْعَبُ بْنُ سَعْدٍ ، قَالَ :  كَانَ أَبِي إِذَا صَلَّى فِي الْمَسْجِدِ تَجَوَّزَ وَأَتَمَّ الرُّكُوعَ وَالسُّجُودَ  ، وَإِذَا صَلَّى فِي الْبَيْتِ أَطَالَ الرُّكُوعَ وَالسُّجُودَ وَالصَّلَاةَ "" ، قُلْتُ : يَا أَبَتَاهُ إِذَا صَلَّيْتَ فِي الْمَسْجِدِ جَوَّزْتَ ، وَإِذَا خَلَوْتَ فِي الْبَيْتِ أَطَلْتَ ، قَالَ : "" يَا بُنَيَّ إِنَّنَا أَئِمَّةٌ يُقْتَدَى بِنَا  ""  .","","Al-Mu'jam al-Kabir 317","","سعد بن أبي وقاص عن مصعب بن سعد بن أبي وقاص عن موسى بن عبد الله الجهني عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"317","318  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  حَدَّثَنِي  الْمُجَالِدُ ،  عَنْ  عَامِرٍ ، قَالَ :  قِيلَ لِسَعْدِ بْنِ أَبِي وَقَّاصٍ : مَتَى أَصَبْتَ الدَّعْوَةَ ؟ قَالَ : يَوْمَ  بَدْرٍ  كُنْتُ أَرْمِي بَيْنَ يَدَيِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَضَعُ السَّهْمَ فِي كَبِدِ الْقَوْسِ ، أَقُولُ : اللَّهُمَّ  زَلْزِلْ  أَقْدَامَهُمْ ، وَأَرْعِبْ قُلُوبَهُمْ ، وَافْعَلْ بِهِمْ وَافْعَلْ ، فَيَقُولُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اللَّهُمَّ اسْتَجِبْ  لِسَعْدٍ  .","","Al-Mu'jam al-Kabir 318","","سعد بن أبي وقاص عن عامر بن سعد بن أبي وقاص عن مجالد بن سعيد عن يحيى بن زكريا بن أبي زائدة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"318","319  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الطُّوسِيُّ ،  حَدَّثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ ،  حَدَّثَنِي  يَحْيَى بْنُ مُحَمَّدِ بْنِ الضَّحَّاكِ الْحِزَامِيُّ ،  عَنْ  أَبِيهِ  ، قَالَ :  قَامَ عَلِيُّ بْنُ أَبِي طَالِبٍ - رَضِيَ اللهُ عَنْهُ - عَلَى مِنْبَرِ  الْكُوفَةِ  حِينَ اخْتَلَفَ الْحَكَمَانِ ،  فَقَالَ  :  قَدْ         [1/144]      كُنْتُ نَهَيْتُكُمْ عَنْ هَذِهِ الْحُكُومَةِ فَعَصَيْتُمُونِي  فَقَامَ إِلَيْهِ فَتًى آدَمُ فَقَالَ : إِنَّكَ وَاللهِ مَا نَهَيْتَنَا ، وَلَكِنَّكَ أَمَرْتَنَا وَدَمَّرْتَنَا ، فَلَمَّا كَانَ فِيهَا مَا تَكْرَهُ بَرَّأَتَ نَفْسَكَ ، وَنَحَلْتَنَا ذَنْبَكَ ، فَقَالَ لَهُ  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُ - : "" وَمَا أَنْتَ وَهَذَا الْكَلَامُ قَبَّحَكَ اللهُ ، وَاللهِ لَقَدْ كَانَتِ الْجَمَاعَةُ فَكُنْتَ فِيهَا  خَامِلًا  ، فَلَمَّا ظَهَرَتِ الْفِتْنَةُ نَجَمْتَ فِيهَا نُجُومَ قَرْنِ الْمَاعِزَةِ "" ثُمَّ الْتَفَتَ إِلَى النَّاسِ ، فَقَالَ : "" لِلهِ مَنْزِلٌ نَزَلَهُ  سَعْدُ بْنُ مَالِكٍ  ،  وَعَبْدُ اللهِ بْنُ عُمَرَ  ، وَاللهِ لَئِنْ كَانَ ذَنْبًا إِنَّهُ لَصَغِيرٌ مَغْفُورٌ ، وَلَئِنْ كَانَ حَسَنًا إِنَّهُ لَعَظِيمٌ مَشْكُورٌ  ""  .","","Al-Mu'jam al-Kabir 319","","علي بن أبي طالب عن محمد بن الضحاك الحزامى عن يحيى بن محمد بن الضحاك الحزامي عن الزبير بن بكار عن أبو علي الطوسي كردوش عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"319","320  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  حُصَيْنُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  عَمْرُو بْنُ مَيْمُونٍ ، قَالَ :  لَمَّا أُصِيبَ عُمَرُ - رَضِيَ اللهُ عَنْهُ - أَخَذَ يُوصِي لِأَهْلِ الشُّورَى  : "" إِنْ أَصَابَ  سَعْدًا  فَذَلِكَ ، وَإِلَّا فَلْيَسْتَعِنْ بِهِ الَّذِي اسْتُخْلِفَ ، فَإِنِّي لَمْ أَنْزِعْهُ مِنْ عَجْزٍ وَلَا خِيَانَةٍ  ""  .","","Al-Mu'jam al-Kabir 320","","عمر بن الخطاب عن عمرو بن ميمون الأودي عن حصين بن عبد الرحمن السلمي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"320","321  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  أَبِي حَيَّانَ التَّيْمِيِّ ، قَالَ :  سَمِعْتُ  عَبَايَةَ بْنَ رِفَاعَةَ بْنِ رَافِعٍ ، قَالَ :  بَلَغَ  عُمَرَ أَنَّ  سَعْدًا  اتَّخَذَ بَابًا ، ثُمَّ قَالَ : انْقَطَعَ الصُّوَيْتُ ، فَأَرْسَلَ إِلَيْهِ  عُمَرُ  رَضِيَ اللهُ عَنْهُ ، فَحَرَّقَهُ  ثُمَّ أَخَذَ  مُحَمَّدُ بْنُ مَسْلَمَةَ  بِيَدِهِ فَأَخْرَجَهُ ، وَقَالَ : هَاهُنَا اجْلِسْ لِلنَّاسِ ، فَاعْتَذَرَ إِلَيْهِ  سَعْدٌ  وَحَلَفَ مَا تَكَلَّمَ بِالْكَلِمَةِ الَّتِي بَلَغَتْ أَمِيرَ الْمُؤْمِنِينَ  ""  .","","Al-Mu'jam al-Kabir 321","","عمر بن الخطاب عن عباية بن رفاعة الزرقي عن يحيى بن سعيد التيمي عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"321","322  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَيُّوبَ ،  عَنِ  ابْنِ سِيرِينَ ، قَالَ :  قِيلَ لِسَعْدِ بْنِ أَبِي وَقَّاصٍ : أَلَا تُقَاتِلْ ؟ فَإِنَّكَ مِنْ أَهْلِ الشُّورَى ، وَأَنْتَ أَحَقُّ بِهَذَا الْأَمْرِ مِنْ غَيْرِكَ ، فَقَالَ :  لَا أُقَاتِلُ حَتَّى تَأْتُونِي بِسَيْفٍ لَهُ عَيْنَانِ وَلِسَانٌ وَشَفَتَانِ يَعْرِفُ الْمُؤْمِنَ مِنَ الْكَافِرِ ، فَقَدْ جَاهَدْتُ وَأَنَا أَعْرِفُ  الْجِهَادَ  "" .","","Al-Mu'jam al-Kabir 322","","سعد بن أبي وقاص عن محمد بن سيرين عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"322","323  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ الْجَوْهَرِيُّ ،  حَدَّثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ الْوَاسِطِيُّ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَابِرٍ ، قَالَ :  كُنَّا         [1/145]      عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَقْبَلَ  سَعْدُ بْنُ أَبِي وَقَّاصٍ  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  هَذَا خَالِي فَلْيُرِنِي امْرُؤٌ خَالَهُ  .","","Al-Mu'jam al-Kabir 323","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن مجالد بن سعيد عن حماد بن أسامة القرشي عن سعيد بن سليمان سعدويه عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","سن سعد بن أبي وقاص ووفاته رضي الله عنه"
"323","وَمِمَّا أَسْنَدَ  سَعْدُ بْنُ أَبِي وَقَّاصٍ  رَضِيَ اللهُ عَنْهُ  بَابُ النَّهْيِ وَالتَّغْلِيظِ عَلَى  سِبَابِ  الْمُسْلِمِينَ وَهُجْرَانِهِمْ وَقِتَالِهِمْ وَغَيْرِ ذَلِكَ  324  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عُمَرَ بْنِ سَعْدٍ ، قَالَ :  ثَنَا  سَعْدُ بْنُ أَبِي وَقَّاصٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَتْلُ الْمُسْلِمِ  كُفْرٌ  وَسِبَابُهُ  فُسُوقٌ  ، وَلَا يَحِلُّ لِمُسْلِمٍ أَنْ يَهْجُرَ أَخَاهُ فَوْقَ ثَلَاثَةِ أَيَّامٍ  .","","Al-Mu'jam al-Kabir 324","","سعد بن أبي وقاص عن عمر بن سعد بن أبي وقاص عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب النهي والتغليظ على سباب المسلمين وهجرانهم وقتالهم وغير ذلك"
"324","325  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  رَوْحُ بْنُ مُسَافِرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  سِبَابُ  الْمُسْلِمِ فُسُوقٌ وَقِتَالُهُ  كُفْرٌ  .","","Al-Mu'jam al-Kabir 325","","سعد بن أبي وقاص عن محمد بن سعد بن أبي وقاص عن أبو إسحاق السبيعي عن روح بن مسافر البصري عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","باب النهي والتغليظ على سباب المسلمين وهجرانهم وقتالهم وغير ذلك"
"325","326  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي نُعَيْمٍ الْوَاسِطِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  جَاءَ  أَعْرَابِيٌّ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : إِنَّ أَبِي كَانَ يَصِلُ الرَّحِمَ ، وَكَانَ وَكَانَ ، فَأَيْنَ هُوَ ؟ قَالَ : فِي النَّارِ ، فَكَأَنَّ الْأَعْرَابِيَّ وَجَدَ مِنْ ذَلِكَ ، فَقَالَ : يَا رَسُولَ اللهِ ، فَأَيْنَ أَبُوكَ ؟ قَالَ :  حَيْثُ مَا مَرَرْتَ بِقَبْرِ كَافِرٍ فَبَشِّرْهُ بِالنَّارِ  قَالَ : فَأَسْلَمَ الْأَعْرَابِيُّ بَعْدُ ، فَقَالَ : لَقَدْ  كَلَّفَنِي  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَعَبًا ، مَا مَرَرْتُ بِقَبْرِ كَافِرٍ إِلَّا بَشَّرْتُهُ بِالنَّارِ  .","","Al-Mu'jam al-Kabir 326","","سعد بن أبي وقاص عن عامر بن سعد بن أبي وقاص عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن محمد بن موسى بن أبي نعيم الهذلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب النهي والتغليظ على سباب المسلمين وهجرانهم وقتالهم وغير ذلك"
"326","[1/146]      بَابٌ فِي إِكْرَامِ  قُرَيْشٍ  وَغَيْرِ ذَلِكَ  327  -  حَدَّثَنَا  سَعِيدُ بْنُ مُحَمَّدِ بْنِ الْمُغِيرَةِ الْمِصْرِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ الْوَاسِطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ مُجَبَّرٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَرَادَ هَوَانَ  قُرَيْشٍ  أَهَانَهُ اللهُ  .","","Al-Mu'jam al-Kabir 327","","سعد بن أبي وقاص عن عامر بن سعد بن أبي وقاص عن الزهري عن محمد بن عبد الرحمن بن المجبر عن سعيد بن سليمان سعدويه عن سعيد بن محمد بن المغيرة المصري عن الطبراني","باب في إكرام قريش وغير ذلك"
"327","328  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مَعْمَرُ بْنُ بَكَّارٍ السَّعْدِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِعَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - : "" أَنْتَ مِنِّي بِمَنْزِلَةِ  هَارُونَ  مِنْ  مُوسَى  .","","Al-Mu'jam al-Kabir 328","","سعد بن أبي وقاص عن عامر بن سعد بن أبي وقاص عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن معمر بن بكار السعدي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب في إكرام قريش وغير ذلك"
"328","329  -  حَدَّثَنَا  سَعِيدُ بْنُ الْمُغِيرَةِ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ الْوَاسِطِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ عُثْمَانَ ،  عَنِ  الْعَبَّاسِ بْنِ ذَرِيحٍ ،  عَنْ  مُحَمَّدِ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ مِنَ السَّعَادَةِ : الزَّوْجَةَ الصَّالِحَةَ ، وَالْمَسْكَنَ الصَّالِحَ ، وَالْمَرْكَبَ الصَّالِحَ  ، وَإِنَّ مِنَ الشَّقَاءِ : الزَّوْجَةَ السُّوءَ ، وَالْمَسْكَنَ السُّوءَ ، وَالْمَرْكَبَ السُّوءَ  .","","Al-Mu'jam al-Kabir 329","","سعد بن أبي وقاص عن محمد بن سعد بن أبي وقاص عن عباس بن ذريح الكلبي عن إبراهيم بن عثمان أبو شيبة العبسي عن سعيد بن سليمان سعدويه عن سعيد بن محمد بن المغيرة المصري عن الطبراني","باب في إكرام قريش وغير ذلك"
"329","330  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ كَيْسَانَ الْمِصِّيصِيُّ  ، ثَنَا  حَبَّانُ بْنُ هِلَالٍ ، (  ح  )  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، قَالَا :  ثَنَا  سَلِيمُ بْنُ حَيَّانَ ،  عَنْ  عِكْرِمَةَ بْنِ خَالِدٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  ذُكِرَ الطَّاعُونُ عِنْدَ         [1/147]      رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  رِجْزٌ  أَصَابَ مَنْ قَبْلَكُمْ ، إِذَا كَانَ بِأَرْضٍ وَأَنْتُمْ بِهَا فَلَا تَخْرُجْ مِنْهَا ، وَإِنْ كَانَ بِهَا فَلَا تَدْخُلْهَا  .","","Al-Mu'jam al-Kabir 330","","سعد بن أبي وقاص عن يحيى بن سعد بن أبي وقاص عن عكرمة بن خالد بن العاص عن سليم بن حيان بن بسطام الهذلي عن حبان بن هلال الباهلي عن محمد بن الحسن بن كيسان المصيصي عن الطبراني","باب في إكرام قريش وغير ذلك"
"330","331  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ الرَّازِيُّ ، كَاتِبُ سَلَمَةَ ،  ثَنَا  سَلَمَةُ بْنُ الْفَضْلِ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  أَبِي إِسْحَاقَ الْهَمْدَانِيِّ ،  عَنْ  مُصْعَبِ بْنِ سَعْدٍ ،  عَنْ  سَعْدٍ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  نَزَلَتْ فِيَّ ثَلَاثُ آيَاتٍ مِنْ كِتَابِ اللهِ - عَزَّ وَجَلَّ - : نَزَلَ تَحْرِيمُ الْخَمْرِ ، نَادَمْتُ رَجُلًا فَعَارَضْتُهُ وَعَارَضَنِي ، فَعَرْبَدْتُ عَلَيْهِ  فَشَجَجْتُهُ  ، فَأَنْزَلَ اللهُ تَعَالَى :         {      يَا أَيُّهَا الَّذِينَ آمَنُوا إِنَّمَا الْخَمْرُ وَالْمَيْسِرُ         }      إِلَى قَوْلِهِ :         {      فَهَلْ أَنْتُمْ مُنْتَهُونَ         }      ، وَنَزَلَتْ فِيَّ :         {      وَوَصَّيْنَا الإِنْسَانَ بِوَالِدَيْهِ إِحْسَانًا حَمَلَتْهُ أُمُّهُ كُرْهًا         }      إِلَى آخِرِالْآيَةِ ، وَنَزَلَتْ :         {      يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا نَاجَيْتُمُ الرَّسُولَ فَقَدِّمُوا بَيْنَ يَدَيْ نَجْوَاكُمْ صَدَقَةً         }      فَقَدَّمْتُ شَعِيرَةً ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّكَ لَزَهِيدٌ  فَنَزَلَتِ الْأُخْرَى :         {      أَأَشْفَقْتُمْ أَنْ تُقَدِّمُوا بَيْنَ يَدَيْ نَجْوَاكُمْ صَدَقَاتٍ         }      الْآيَةَ كُلَّهَا  .","","Al-Mu'jam al-Kabir 331","","سعد بن أبي وقاص عن مصعب بن سعد بن أبي وقاص عن أبو إسحاق السبيعي عن محمد بن إسحاق عن سلمة بن الفضل الأبرش عن عبد الرحمن بن سلمة الأزداني عن علي بن سعيد بن بشير عليك عن الطبراني","باب في إكرام قريش وغير ذلك"
"331","332  / 1  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  إِسْحَاقُ بْنُ مُحَمَّدٍ الْفَرْوِيُّ ،  حَدَّثَتْنَا  عُبَيْدَةُ بِنْتُ نَابِلٍ ،  عَنْ  عَائِشَةَ بِنْتِ سَعْدٍ ،  عَنْ  سَعْدِ بْنِ أَبِي وَقَّاصٍ -  رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا بَيْنَ بَيْتِي وَمُصَلَّايَ رَوْضَةٌ مِنْ رِيَاضِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 332","","سعد بن أبي وقاص عن عائشة بنت سعد بن أبي وقاص عن عبيدة بنت نابل حجازية عن إسحاق بن محمد بن إسماعيل الفروي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب في إكرام قريش وغير ذلك"
"332","332  / 2  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  إِسْحَاقُ بْنُ مُحَمَّدٍ الْفَرْوِيُّ ،  ثَنَا  عُبَيْدَةُ بِنْتُ نَابِلٍ ،  عَنْ  عَائِشَةَ بِنْتِ سَعْدٍ ،  عَنْ  سَعْدٍ  "" أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَشْرَبُ قَائِمًا  .","","Al-Mu'jam al-Kabir 332","","سعد بن أبي وقاص عن عائشة بنت سعد بن أبي وقاص عن عبيدة بنت نابل حجازية عن إسحاق بن محمد بن إسماعيل الفروي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب في إكرام قريش وغير ذلك"
"333","[1/148]      333  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَإِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ، قَالَا :  ثَنَا  أُمَيَّةُ بْنُ بِسْطَامٍ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  حَكِيمِ بْنِ جُبَيْرٍ ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ ،  حَدَّثَنِي  سَعِيدُ بْنُ الْمُسَيِّبِ ، أَنَّ سَعْدَ بْنَ أَبِي وَقَّاصٍ  حَدَّثَهُ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِعَلِيٍّ  :  أَنْتَ مِنِّي بِمَنْزِلَةِ  هَارُونَ  مِنْ  مُوسَى  .","","Al-Mu'jam al-Kabir 333","","سعد بن أبي وقاص عن سعيد بن المسيب عن علي بن الحسين زين العابدين عن حكيم بن جبير الأسدي عن إسرائيل بن يونس بن أبي إسحاق عن يزيد بن زريع العيشي عن أمية بن بسطام عن إبراهيم بن هاشم البغوي عن الطبراني","باب في إكرام قريش وغير ذلك"
"334","334  -  حَدَّثَنَا  الْحَسَنُ بْنُ الْعَبَّاسِ الرَّازِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ دَاهِرٍ الرَّازِيُّ ،  ثَنَا  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  أَبِي عَبْدِ اللهِ الْجَدَلِيِّ ، قَالَ :  سَمِعْتُ  سَعْدًا - رَضِيَ اللهُ عَنْهُ - يَقُولُ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِعَلِيٍّ  :  أَنْتَ مِنِّي بِمَنْزِلَةِ  هَارُونَ  مِنْ  مُوسَى  ، إِلَّا أَنَّهُ لَا نَبِيَّ بَعْدِي  .","","Al-Mu'jam al-Kabir 334","","سعد بن أبي وقاص عن عبد بن عبد الجدلي عن سالم بن أبي الجعد الغطفاني عن الأعمش عن داهر بن يحيى الرازي عن الأحمري عبد الله بن داهر الأحمري عن الجمال الحسن بن العباس عن الطبراني","باب في إكرام قريش وغير ذلك"
"335","9 - نِسْبَةُ  سَعِيدِ بْنِ زَيْدٍ  رَضِيَ اللهُ عَنْهُ  335  -  حَدَّثَنَا  مُوسَى بْنُ زَكَرِيَّا التُّسْتَرِيُّ  ،  ثَنَا  شَبَابٌ الْعُصْفُرِيُّ  ، قَالَ : ""  سَعِيدُ بْنُ زَيْدِ بْنِ عَمْرِو بْنِ نُفَيْلِ بْنِ عَبْدِ الْعُزَّى بْنِ رَبَاحِ بْنِ عَبْدِ اللهِ بْنِ قُرْطِ بْنِ رَزَاحِ بْنِ عَدِيِّ بْنِ كَعْبٍ يُكَنَّى أَبَا الْأَعْوَرِ  ، وَأُمُّهُ :  فَاطِمَةُ بِنْتُ نَعْجَةَ بْنِ أُمَيَّةَ بْنِ خُوَيْلِدٍ مِنْ خُزَاعَةَ  ""  .","","Al-Mu'jam al-Kabir 335","","","نسبة سعيد بن زيد رضي الله عنه"
"336","صِفَةُ  سَعِيدِ بْنِ زَيْدٍ  رَضِيَ اللهُ عَنْهُ  336  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَدِينِيُّ فُسْتُقَةُ  ، ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  عَنِ  الْوَاقِدِيِّ ، قَالَ :  كَانَ سَعِيدُ بْنُ زَيْدٍ طُوَالًا آدَمَ أَشْعَرَ  ""  .","","Al-Mu'jam al-Kabir 336","","سعيد بن زيد بن عمرو العدوي عن الواقدي عن إبراهيم بن سعيد الجوهري عن محمد بن علي فستقة البغدادي عن الطبراني","صفة سعيد بن زيد رضي الله عنه"
"337","337  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ صَدَقَةَ ، قَالَ :  سَمِعْتُ  أَبَا حَفْصٍ عَمْرَو بْنَ عَلِيٍّ يَقُولُ :  كَانَ سَعِيدُ بْنُ زَيْدٍ آدَمَ طُوَالًا أَشْعَرَ  "" .","","Al-Mu'jam al-Kabir 337","","سعيد بن زيد بن عمرو العدوي عن الفلاس عن أحمد بن محمد بن عبد الله البغدادي عن الطبراني","صفة سعيد بن زيد رضي الله عنه"
"338","338  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ         [1/149]      لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ ، قَالَ :  سَعِيدُ بْنُ زَيْدِ بْنِ عَمْرِو بْنِ نُفَيْلٍ قَدِمَ مِنَ  الشَّامِ  بَعْدَمَا رَجَعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  بَدْرٍ  ، فَكَلَّمَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَضَرَبَ لَهُ بِسَهْمِهِ  ، قَالَ : وَأَجْرِي يَا رَسُولَ اللهِ زَعَمُوا ؟ قَالَ : "" وَأَجْرُكَ  .","","Al-Mu'jam al-Kabir 338","","سعيد بن زيد بن عمرو العدوي عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","صفة سعيد بن زيد رضي الله عنه"
"339","339  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنِ  ابْنِ شِهَابٍ ، قَالَ :  قَدِمَ سَعِيدُ بْنُ زَيْدٍ مِنَ  الشَّامِ  بَعْدَ مَقْدَمِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  بَدْرٍ  ، فَكَلَّمَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَهْمِهِ فَقَالَ لَهُ : "" سَهْمُكَ  ، قَالَ : فَأَجْرِي يَا رَسُولَ اللهِ ؟ قَالَ : "" وَأَجْرُكَ  .","","Al-Mu'jam al-Kabir 339","","سعيد بن زيد بن عمرو العدوي عن الزهري عن موسى بن عقبة عن محمد بن فليح بن سليمان الأسلمي عن محمد بن إسحاق المسيبي عن الحسن بن هارون بن سليمان الأصبهاني عن الطبراني","صفة سعيد بن زيد رضي الله عنه"
"340","سِنُّ  سَعِيدِ بْنِ زَيْدٍ  وَوَفَاتُهُ رَضِيَ اللهُ عَنْهُ  340  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ، قَالَ : ""  تُوُفِّيَ  سَعِيدُ بْنُ زَيْدِ بْنِ عَمْرِو بْنِ نُفَيْلٍ  سَنَةَ إِحْدَى وَخَمْسِينَ وَسِنُّهُ  بِضْعٌ  وَسَبْعُونَ  ، وَدُفِنَ  بِالْمَدِينَةِ  ، وَمَاتَ  بِالْعَقِيقِ  ، وَنَزَلَ فِي قَبْرِهِ  سَعْدُ بْنُ أَبِي وَقَّاصٍ  ،  وَابْنُ عُمَرَ  ، وَيُكَنَّى  أَبَا الْأَعْوَرِ  ""  .","","Al-Mu'jam al-Kabir 340","","","سن سعيد بن زيد ووفاته رضي الله عنه"
"341","341  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ  ، ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  أَنَا  ابْنُ الْمُبَارَكِ ،  أَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ ،  عَنْ  زَيْدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ سَعِيدِ بْنِ زَيْدٍ  أَنَّ  سَعْدَ بْنَ أَبِي وَقَّاصٍ غَسَّلَ  سَعِيدَ بْنَ زَيْدٍ  بِالسَّجَرَةِ  ""  .","","Al-Mu'jam al-Kabir 341","","سعد بن أبي وقاص عن زيد بن عبد الرحمن بن سعيد بن زيد العدوي عن عبد الله بن جعفر بن عبد الرحمن بن المسور بن مخرمة عن عبد الله بن المبارك عن نعيم بن حماد الخزاعي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","سن سعيد بن زيد ووفاته رضي الله عنه"
"342","342  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  أَرْوَى بِنْتَ أُوَيْسٍ  اسْتَعْدَتْ  مَرْوَانَ  عَلَى  سَعِيدِ بْنِ زَيْدٍ  ، قَالَتْ : سَرَقَ مِنِّي أَرْضِي ، فَأَدْخَلَهَا فِي أَرْضِهِ ، فَقَالَ سَعِيدٌ : مَا كُنْتُ لِأَسْرِقَ مِنْهَا بَعْدَمَا سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ سَرَقَ شِبْرًا مِنَ الْأَرْضِ طُوِّقَ إِلَى سَبْعِ الْأَرَضِينَ  فَقَالَ : لَا أَسْأَلُكَ بَعْدَ هَذَا . فَقَالَ  سَعِيدٌ  :         [1/150]      اللَّهُمَّ إِنْ كَانَتْ كَاذِبَةً فَأَذْهِبْ بَصَرَهَا وَاقْتُلْهَا فِي أَرْضِهَا ، فَذَهَبَ بَصَرُهَا وَوَقَعَتْ فِي حُفْرَةٍ فِي أَرْضِهَا فَمَاتَتْ  .","","Al-Mu'jam al-Kabir 342","","سعيد بن زيد بن عمرو العدوي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سن سعيد بن زيد ووفاته رضي الله عنه"
"343","343  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ نُمَيْرٍ  ، يَقُولُ : ""  مَاتَ  سَعِيدُ بْنُ زَيْدٍ  سَنَةَ إِحْدَى وَخَمْسِينَ  بِالْمَدِينَةِ  ""  .","","Al-Mu'jam al-Kabir 343","","","سن سعيد بن زيد ووفاته رضي الله عنه"
"344","344  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، حَدَّثَنَا  مُصَرِّفُ بْنُ عَمْرٍو الْيَامِيُّ ،  ثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  عُبَيْدِ  اللهِ بْنِ عُمَرَ ،  عَنْ  عَبْدِ الْجَبَّارِ  ،  عَنْ  أَخِيهِ  ،  عَنْ  عَائِشَةَ بِنْتِ سَعْدٍ ، قَالَتْ :  غَسَّلَ  سَعْدٌ  سَعِيدَ بْنَ زَيْدٍ  بِالْعَقِيقِ  ، ثُمَّ حَمَلُوهُ ، فَجَاؤُوا بِهِ ، فَجَاءَ  سَعْدٌ  يَمْشِي حَتَّى إِذَا حَاذَى بِدَارِهِ دَخَلَ فَاغْتَسَلَ ، ثُمَّ خَرَجَ ، فَقَالَ : "" إِنِّي لَمْ أَغْتَسِلْ مِنْ غُسْلِ  سَعِيدٍ  إِنَّمَا اغْتَسَلْتُ مِنَ الْحَرِّ  ""  .  في طبعة مكتبة ابن تيمية : ( عبد الله ) والمثبت من النسخة الخطية ، وينظر مصادر التخريج  كذا في طبعة مكتبة ابن تيمية والنسخة الخطية ، وفي طبقات ابن سعد : ( أبو عبد الجبار ) ، وعند الحاكم ، والبيهقي : ( أبو عبد الغفار ) وليس عندهم : ( عن أخيه ) وفي التاريخ الكبير ، والجرح والتعديل والثقات وغيرهم : ""أبو عبد الجبار سمع عائشة بنت سعد روى عنه عبيد الله بن عمر"" فالله أعلم.","","Al-Mu'jam al-Kabir 344","","سعيد بن زيد بن عمرو العدوي عن عائشة بنت سعد بن أبي وقاص عن أخو أبو عبد الجبار عن أبو عبد الجبار عن عبيد الله بن عمر العمري عن عبدة بن سليمان الكلابي عن مصرف بن عمرو بن السري الهمداني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سن سعيد بن زيد ووفاته رضي الله عنه"
"345","345  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ  ، عَنْ  سَعِيدِ بْنِ زَيْدِ بْنِ عَمْرِو بْنِ نُفَيْلٍ ، قَالَ :  بَعَثَ  مُعَاوِيَةُ  إِلَى  مَرْوَانَ بْنِ الْحَكَمِ  بِالْمَدِينَةِ  لِيُبَايِعَ  لِابْنِهِ  يَزِيدَ  ، فَقَالَ  رَجُلٌ مِنْ أَهْلِ الشَّامِ  : مَا يَحْبِسُكَ ؟ قَالَ : حَتَّى يَجِيءَ  سَعِيدُ بْنُ زَيْدٍ  فَيُبَايِعَ  ، فَإِنَّهُ أَنْبَلُ أَهْلِ الْبَلَدِ ، فَإِذَا بَايَعَ بَايَعَ النَّاسُ  ""  .","","Al-Mu'jam al-Kabir 345","","سعيد بن زيد بن عمرو العدوي عن محارب بن دثار عن عطاء بن السائب عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","سن سعيد بن زيد ووفاته رضي الله عنه"
"346","346  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنْ  عَبْدِ اللهِ بْنِ ظَالِمٍ ،  عَنْ  سَعِيدِ بْنِ زَيْدٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  سَيَكُونُ بَعْدِي فِتَنٌ يَكُونُ فِيهَا وَيَكُونُ  فَقُلْنَا : إِنْ أَدْرَكْنَا ذَلِكَ هَلَكْنَا ؟ قَالَ : "" بِحَسْبِ أَصْحَابِي الْقَتْلُ  .","","Al-Mu'jam al-Kabir 346","","سعيد بن زيد بن عمرو العدوي عن عبد الله بن ظالم المازني عن هلال بن يساف الأشجعي عن منصور بن المعتمر عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","سن سعيد بن زيد ووفاته رضي الله عنه"
"347","347  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  عُبَيْدُ         [1/151]      بْنُ سَعِيدٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنْ  فُلَانِ بْنِ حَيَّانَ ،  عَنْ  عَبْدِ اللهِ بْنِ ظَالِمٍ ،  عَنْ  سَعِيدِ بْنِ زَيْدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 347","","سعيد بن زيد بن عمرو العدوي عن عبد الله بن ظالم المازني عن ابن حيان شيخ لهلال بن يساف عن هلال بن يساف الأشجعي عن منصور بن المعتمر عن سفيان الثوري عن عبيد بن سعيد بن أبان القرشي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سن سعيد بن زيد ووفاته رضي الله عنه"
"348","348  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  فِرْدَوْسٌ الْأَشْعَرِيُّ ،  عَنْ  مَسْعُودِ بْنِ سُلَيْمَانَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنِ  ابْنِ ظَالِمٍ ،  عَنْ  سَعِيدِ بْنِ زَيْدٍ ، قَالَ :  ذَكَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْفِتَنَ  ، فَقُلْنَا : يَا رَسُولَ اللهِ ، كُلُّ مَفْتُونٍ فِيهَا هَالِكٌ ؟ قَالَ : "" حَسْبُكُمُ الْقَتْلُ  .","","Al-Mu'jam al-Kabir 348","","سعيد بن زيد بن عمرو العدوي عن عبد الله بن ظالم المازني عن هلال بن يساف الأشجعي عن حبيب بن أبي ثابت الكاهلي عن مسعود بن سليمان عن فردوس بن الأشعري الكوفي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سن سعيد بن زيد ووفاته رضي الله عنه"
"349","349  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  أَبُو أُسَامَةَ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ مَيْسَرَةَ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنْ  عَبْدِ اللهِ بْنِ ظَالِمٍ ،  عَنْ  سَعِيدِ بْنِ زَيْدٍ ، قَالَ :  ذَكَرَ فِتْنَةً - يَعْنِي - النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَقِطَعِ  اللَّيْلِ الْمُظْلِمِ ، فَقَالَ : "" يَذْهَبُ النَّاسُ فِيهَا أَسْرَعَ ذَهَابٍ "" . فَقِيلَ : كُلُّهُمْ هَالِكٌ ؟ قَالَ :  حَسْبُهُمُ الْقَتْلُ  .","","Al-Mu'jam al-Kabir 349","","سعيد بن زيد بن عمرو العدوي عن عبد الله بن ظالم المازني عن هلال بن يساف الأشجعي عن عبد الملك بن ميسرة الهلالي عن مسعر بن كدام عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سن سعيد بن زيد ووفاته رضي الله عنه"
"350","وَمِمَّا أَسْنَدَ  سَعِيدُ بْنُ زَيْدٍ  رَضِيَ اللهُ عَنْهُ  350  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنْبَأَ  الْمَسْعُودِيُّ ،  عَنْ  نُفَيْلِ بْنِ هِشَامِ بْنِ سَعِيدِ بْنِ زَيْدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ :  خَرَجَ  وَرَقَةُ بْنُ         [1/152]      نَوْفَلٍ  ،  وَزَيْدُ بْنُ عَمْرٍو  يَطْلُبَانِ الدِّينَ ، حَتَّى مَرَّا  بِالشَّامِ  ، فَأَمَّا  وَرَقَةُ  فَتَنَصَّرَ ، وَأَمَّا  زَيْدٌ  فَقِيلَ لَهُ : إِنَّ الَّذِي تَطْلُبُ أَمَامَكَ ، فَانْطَلَقَ حَتَّى أَتَى  الْمَوْصِلَ  ، فَإِذَا هُوَ  بِرَاهِبٍ  ، فَقَالَ : مِنْ أَيْنَ أَقْبَلَ صَاحِبُ الْمَرْحَلَةِ ؟ قَالَ : مِنْ بَيْتِ  إِبْرَاهِيمَ  ، قَالَ : مَا تَطْلُبُ ؟ قَالَ : الدِّينَ ، فَعَرَضَ عَلَيْهِ النَّصْرَانِيَّةَ فَأَبَى أَنْ يَقْبَلَ ، وَقَالَ : لَا حَاجَةَ لِي فِيهِ ، قَالَ : أَمَا إِنَّ الَّذِي تَطْلُبُ سَيَظْهَرُ بِأَرْضِكَ ، فَأَقْبَلَ وَهُوَ يَقُولُ : لَبَّيْكَ  حَقًّا  حَقًّا ،  تَعَبُّدًا وَرِقًّا ،  الْبِرَّ  أَبْغِي لَا الْحَالَ ، وَهَلْ مُهَاجِرٌ كَمَنْ قَالَ ، عُذْتُ بِمَا عَاذَ بِهِ  إِبْرَاهِيمُ  وَهُوَ قَائِمٌ ، وَأَنْفِي لَكَ اللَّهُمَّ عَانٍ رَاغِمٌ  مَهْمَا  تُجَشِّمْنِي  ، فَإِنِّي جَاشِمٌ ، ثُمَّ يَخِرُّ فَيَسْجُدُ  لِلْكَعْبَةِ  ، قَالَ : فَمَرَّ  زَيْدُ بْنُ عَمْرٍو  بِالنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَزَيْدِ بْنِ حَارِثَةَ  وَهُمَا يَأْكُلَانِ مِنْ  سُفْرَةٍ  لَهُمَا ، فَدَعَيَاهُ ، فَقَالَ : "" يَا ابْنَ أَخِي ، لَا آكُلُ مِمَّا ذُبِحَ عَلَى  النُّصُبِ  ، قَالَ : فَمَا رُؤِيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْكُلُ مِمَّا ذُبِحَ عَلَى  النُّصُبِ  مِنْ يَوْمِهِ ذَلِكَ حَتَّى بُعِثَ ، قَالَ : وَجَاءَ  سَعِيدُ بْنُ زَيْدٍ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  يَا رَسُولَ اللهِ إِنَّ  زَيْدًا  كَانَ  كَمَا رَأَيْتَ - أَوْ كَمَا بَلَغَكَ -  فَاسْتَغْفِرْ لَهُ قَالَ : "" نَعَمْ ، فَاسْتَغْفَرَ لَهُ ، فَإِنَّهُ يُبْعَثُ يَوْمَ الْقِيَامَةِ  أُمَّةً  وَحْدَهُ  .","","Al-Mu'jam al-Kabir 350","","سعيد بن زيد بن عمرو العدوي عن هشام بن سعيد بن زيد بن عمرو العدوي عن نفيل بن هشام بن سعيد العدوي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عبد الله بن رجاء الغداني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ومما أسند سعيد بن زيد رضي الله عنه"
"351","351  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  حَدَّثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  يَزِيدَ بْنِ يُحَنَّسَ ،  عَنْ  سَعِيدِ بْنِ زَيْدِ بْنِ نُفَيْلٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - احْتَضَنَ  حَسَنًا  فَقَالَ : "" اللَّهُمَّ إِنِّي قَدْ أَحْبَبْتُهُ فَأَحِبَّهُ  .","","Al-Mu'jam al-Kabir 351","","سعيد بن زيد بن عمرو العدوي عن يزيد بن يحنس عن يزيد بن أبي زياد القرشي عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ومما أسند سعيد بن زيد رضي الله عنه"
"352","352  -  حَدَّثَنَا  الْحَسَنُ بْنُ جَرِيرٍ الصُّورِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ         [1/153]      الدِّمَشْقِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مَسْرُوقٍ الْكُوفِيُّ ،  عَنِ  الْوَلِيدِ بْنِ عَبْدِ اللهِ بْنِ جُمَيْعٍ ،  عَنْ  أَبِي الطُّفَيْلِ ،  عَنْ  سَعِيدِ بْنِ زَيْدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ قُتِلَ دُونَ مَالِهِ فَهُوَ  شَهِيدٌ  .","","Al-Mu'jam al-Kabir 352","","سعيد بن زيد بن عمرو العدوي عن عامر بن واثلة عن الوليد بن عبد الله بن جميع الخزاعي عن محمد بن مسروق الكندي عن سليمان بن عبد الرحمن التميمي عن الحسن بن جرير الزنبقي عن الطبراني","ومما أسند سعيد بن زيد رضي الله عنه"
"353","353  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  هِشَامُ بْنُ سَعْدِ  عَنْ  مُحَمَّدُ بْنُ  زَيْدِ بْنِ الْمُهَاجِرِ ،  أَنَّهُ أَخْبَرَهُ  عَاصِمُ بْنُ عُبَيْدِ اللهِ بْنِ عَاصِمٍ ،  عَنْ  جَدِّهِ عَاصِمِ بْنِ عُمَرَ ،  أَنَّهُ سَمِعَ  سَعِيدَ بْنَ زَيْدِ بْنِ عَمْرِو بْنِ نُفَيْلٍ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ قَاتَلَ دُونَ مَالِهِ حَتَّى يُقْتَلَ فَهُوَ  شَهِيدٌ  .  في طبعة مكتبة ابن تيمية : ( هشام بن سعد بن زيد بن المهاجر ) والمثبت من النسخة الخطية","","Al-Mu'jam al-Kabir 353","","سعيد بن زيد بن عمرو العدوي عن عاصم بن عمر بن الخطاب عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن محمد بن زيد بن المهاجر الجدعاني عن هشام بن سعد المخزومي عن الليث بن سعد عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","ومما أسند سعيد بن زيد رضي الله عنه"
"354","354  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  مُحَمَّدِ بْنِ زَيْدِ بْنِ الْمُهَاجِرِ ،  أَنَّهُ سَمِعَ  أَبَا غَطَفَانَ بْنَ طَرِيفٍ الْمُرِّيَّ  يُخْبِرُ عَنْ  سَعِيدِ بْنِ زَيْدٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ قُتِلَ دُونَ مَالِهِ فَهُوَ  شَهِيدٌ  .","","Al-Mu'jam al-Kabir 354","","سعيد بن زيد بن عمرو العدوي عن أبو غطفان المري عن محمد بن زيد بن المهاجر الجدعاني عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","ومما أسند سعيد بن زيد رضي الله عنه"
"355","355  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  أَخْبَرَنِي  الْعَلَاءُ بْنُ عَبْدِ الرَّحْمَنِ ،  أَخْبَرَنِي  الْعَبَّاسُ بْنُ سَهْلِ بْنِ سَعْدٍ ،  أَنَّهُ سَمِعَ  سَعِيدَ بْنَ زَيْدِ بْنِ عَمْرِو بْنِ نُفَيْلٍ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنِ انْتَقَصَ شِبْرًا مِنَ الْأَرْضِ ظُلْمًا  طَوَّقَهُ  اللهُ يَوْمَ الْقِيَامَةِ مِنْ سَبْعِ أَرَضِينَ  .","","Al-Mu'jam al-Kabir 355","","سعيد بن زيد بن عمرو العدوي عن عباس بن سهل بن سعد الساعدي عن العلاء بن عبد الرحمن الحرقي عن محمد بن جعفر بن أبي كثير الزرقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","ومما أسند سعيد بن زيد رضي الله عنه"
"356","356  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْخُزَاعِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ بُكَيْرٍ الْحَضْرَمِيُّ ،  ثَنَا  ثَابِتُ بْنُ الْوَلِيدِ بْنِ عَبْدِ اللهِ بْنِ جُمَيْعٍ الْقُرَشِيُّ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنِي  أَبُو الطُّفَيْلِ ،  عَنْ  سَعِيدِ بْنِ زَيْدٍ ، قَالَ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ عَلَى  حِرَاءٍ         [1/154]      فَتَحَرَّكَ ، فَضَرَبَ بِرِجْلِهِ ، ثُمَّ قَالَ :  اسْكُنْ  حِرَاءُ  فَإِنَّهُ لَيْسَ عَلَيْكَ إِلَّا نَبِيٌّ أَوْ صِدِّيقٌ أَوْ شَهِيدٌ  "" وَهَؤُلَاءِ  الْقَوْمُ  مَعَهُ  أَبُو بَكْرٍ  ،  وَعُمَرُ  ،  وَعُثْمَانُ  ،  وَعَلِيٌّ  ،  وَطَلْحَةُ  ،  وَالزُّبَيْرُ  ،  وَسَعْدٌ  ،  وَعَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  ، وَأَنَا ""  يَعْنِي نَفْسَهُ  .","","Al-Mu'jam al-Kabir 356","","سعيد بن زيد بن عمرو العدوي عن عامر بن واثلة عن الوليد بن عبد الله بن جميع الخزاعي عن ثابت بن الوليد بن عبد الله بن جميع الزهري عن محمد بن بكير بن واصل الأصبهاني عن أحمد بن محمد بن علي الخزاعي عن الطبراني","ومما أسند سعيد بن زيد رضي الله عنه"
"357","357  -  حَدَّثَنَا  أَبُو زَيْدٍ الْحَوْطِيُّ ، وَأَبُو زُرْعَةَ ، قَالَا :  ثَنَا  أَبُو الْيَمَانِ ،  أَنَا  شُعَيْبُ بْنُ أَبِي حَمْزَةَ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي حُسَيْنٍ ،  ثَنَا  نَوْفَلُ بْنُ مُسَاحِقٍ ،  عَنْ  سَعِيدِ بْنِ زَيْدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مِنْ أَرْبَى الرِّبَا :  اسْتِطَالَةُ  الْمَرْءِ فِي عِرْضِ الْمُسْلِمِ بِغَيْرِ حَقٍّ  ، وَإِنَّ هَذِهِ الرَّحِمَ  شِجْنَةٌ  مِنَ الرَّحْمَنِ ، مَنْ قَطَعَهَا حَرَّمَ اللهُ عَلَيْهِ الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 357","","سعيد بن زيد بن عمرو العدوي عن نوفل بن مساحق العامري عن عبد الله بن عبد الرحمن بن أبي حسين النوفلي عن شعيب بن أبي حمزة الحمصي عن أبو اليمان الحكم بن نافع عن أبو زرعة الدمشقي عن الطبراني","ومما أسند سعيد بن زيد رضي الله عنه"
"358","10 - نِسْبَةُ  أَبِي عُبَيْدَةَ بْنِ الْجَرَّاحِ  رَضِيَ اللهُ عَنْهُ .  358  - حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَدِينِيُّ فُسْتُقَةُ  ، ثَنَا  الْحُسَيْنُ بْنُ عَلِيِّ بْنِ يَزِيدَ الصُّدَائِيُّ  ، ثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ  ، قَالَ : سَمِعْتُ  أَبِي  ، عَنِ ابْنِ إِسْحَاقَ ، قَالَ : ""  أَبُو عُبَيْدَةَ بْنُ الْجَرَّاحِ هُوَ عَامِرُ بْنُ عَبْدِ اللهِ بْنِ الْجَرَّاحِ بْنِ هِلَالِ بْنِ وُهَيْبِ بْنِ ضَبَّةَ بْنِ الْحَارِثِ بْنِ فِهْرٍ  ، لَمْ يُعَقِّبْ ،  وَأُمُّ أَبِي عُبَيْدَةَ : أُمُّ غَنْمٍ بِنْتُ جَابِرِ بْنِ عَبْدِ بْنِ الْعَلَاءِ بْنِ عَامِرِ بْنِ عَمِيرَةَ بْنِ وَدِيعَةَ بْنِ الْحَارِثِ بْنِ فِهْرٍ  "" .","","Al-Mu'jam al-Kabir 358","","","نسبة أبي عبيدة بن الجراح رضي الله عنه"
"359","359  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ  ، قَالَ : ""  أَبُو عُبَيْدٍ عَامِرُ بْنُ عَبْدِ اللهِ بْنِ الْجَرَّاحِ  ""  .","","Al-Mu'jam al-Kabir 359","","","نسبة أبي عبيدة بن الجراح رضي الله عنه"
"360","قَتْلُ  أَبِي عُبَيْدَةَ  رَضِيَ اللهُ عَنْهُ أَبَاهُ  يَوْمَ بَدْرٍ  360  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  ضَمْرَةُ ،  عَنِ         [1/155]      ابْنِ شَوْذَبٍ ، قَالَ :  جَعَلَ  أَبُو أَبِي عُبَيْدَةَ  يَتَصَدَّى  لِأَبِي عُبَيْدَةَ  يَوْمَ بَدْرٍ  ، فَجَعَلَ أَبُو عُبَيْدَةَ يَحِيدُ عَنْهُ ، فَلَمَّا أَكْثَرَ ، قَصَدَهُ  أَبُو عُبَيْدَةَ  فَقَتَلَهُ  ، فَأَنْزَلَ اللهُ - عَزَّ وَجَلَّ - فِيهِ هَذِهِ الْآيَةَ حِينَ قَتَلَ أَبَاهُ :         {      لا تَجِدُ قَوْمًا يُؤْمِنُونَ بِاللهِ وَالْيَوْمِ الآخِرِ         }      إِلَى آخِرِ الْآيَةِ  ""  .","","Al-Mu'jam al-Kabir 360","","أبو عبيدة ابن الجراح أمين الأمة عن عبد الله بن شوذب عن ضمرة بن ربيعة الفلسطيني عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","قتل أبي عبيدة رضي الله عنه أباه يوم بدر"
"361","361  - حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ، حَدَّثَنِي  أَبِي  ، ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ، عَنْ عُرْوَةَ ، قَالَ : ""  شَهِدَ  بَدْرًا  مِنْ  بَنِي الْحَارِثِ بْنِ فِهْرٍ  :  أَبُو عُبَيْدَةَ بْنُ الْجَرَّاحِ  "" .","","Al-Mu'jam al-Kabir 361","","","قتل أبي عبيدة رضي الله عنه أباه يوم بدر"
"362","362  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عِيَاضٍ الْأَشْعَرِيِّ ، قَالَ :  قَالَ  أَبُو عُبَيْدَةَ :  مَنْ يُرَاهِنُنِي ؟  فَقَالَ شَابٌّ : أَنَا ، إِنْ لَمْ تَغْضَبْ ، قَالَ : فَسَبَقَهُ فَلَقَدْ رَأَيْتُ  عَقِيصَتَيْ  أَبِي عُبَيْدَةَ  يَقْفِزَانِ ، وَهُوَ خَلْفَهُ عَلَى فَرَسٍ عَرَبِيٍّ  ""  .","","Al-Mu'jam al-Kabir 362","","أبو عبيدة ابن الجراح أمين الأمة عن عياض بن عمرو الأشعري عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","قتل أبي عبيدة رضي الله عنه أباه يوم بدر"
"363","سِنُّ  أَبِي عُبَيْدَةَ  وَوَفَاتُهُ رَضِيَ اللهُ عَنْهُ  363  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ، قَالَ : ""  مَاتَ  أَبُو عُبَيْدَةَ  - رَضِيَ اللهُ عَنْهُ - فِي طَاعُونِ  عَمْوَاسٍ  ، سَنَةَ ثَمَانِ عَشْرَةَ ، وَهُوَ ابْنُ ثَمَانٍ وَخَمْسِينَ سَنَةً ، وَشَهِدَ  بَدْرًا  وَهُوَ ابْنُ إِحْدَى وَأَرْبَعِينَ سَنَةً ، وَيُقَالُ صَلَّى عَلَيْهِ  مُعَاذُ بْنُ جَبَلٍ  ""  .","","Al-Mu'jam al-Kabir 363","","","سن أبي عبيدة ووفاته رضي الله عنه"
"364","364  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ بَهْرَامَ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ الْأَشْعَرِيِّ ،  عَنِ  الْحَارِثِ بْنِ عَمِيرَةَ الْحَارِثِيِّ ،  أَنَّ  مُعَاذَ بْنَ جَبَلٍ  - رَضِيَ اللهُ عَنْهُ - طُعِنَ ، فَجَعَلَ يُرْسِلُ  الْحَارِثَ بْنَ عَمِيرَةَ  إِلَى  أَبِي عُبَيْدَةَ بْنِ الْجَرَّاحِ  يَسْأَلُهُ كَيْفَ هُوَ ؟  فَأَرَاهُ  أَبُو عُبَيْدَةَ طَعْنَةً خَرَجَتْ فِي كَفِّهِ ، فَتَكَابَرَ شَأْنُهَا فِي نَفْسِ  الْحَارِثِ  ، فَفَرَقَ مِنْهَا حِينَ رَآهَا "" فَأَقْسَمَ لَهُ  أَبُو عُبَيْدَةَ  بِاللهِ مَا يُحِبُّ أَنَّ لَهُ بِهَا حُمْرَ النَّعَمِ  ""  .","","Al-Mu'jam al-Kabir 364","","أبو عبيدة ابن الجراح أمين الأمة عن الحارث بن عميرة الزبيدي عن عبد الرحمن بن غنم الأشعري عن شهر بن حوشب عن عبد الحميد بن بهرام الفزاري عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","سن أبي عبيدة ووفاته رضي الله عنه"
"365","[1/156]      365  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  أَصْبَغُ بْنُ الْفَرَجِ ،  حَدَّثَنَا  ابْنُ وَهْبٍ ،  عَنْ  يُونُسَ ،  عَنِ  ابْنِ شِهَابٍ ، قَالَ :  كَانَتِ  الشَّامُ  عَلَى أَمِيرَيْنِ : عَلَى  أَبِي عُبَيْدَةَ بْنِ الْجَرَّاحِ  ،  وَيَزِيدَ بْنِ أَبِي سُفْيَانَ  ، فَتُوُفِّيَ أَبُو عُبَيْدَةَ  ، وَاسْتَخْلَفَ خَالَهُ  عِيَاضَ بْنَ غَنْمٍ  أَحَدَ  بَنِي الْحَارِثِ بْنِ فِهْرٍ  ، فَأَقَرَّهُ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - ثُمَّ تُوُفِّيَ  عِيَاضٌ  فَأَمَّرَ مَكَانَهَ  سَعِيدَ بْنَ عَامِرِ بْنِ حِذْيَمٍ  ، ثُمَّ تُوُفِّيَ  سَعِيدُ بْنُ عَامِرٍ  فَأَمَّرَ مَكَانَهُ  عُمَيْرَ بْنَ سَعْدٍ  ""  .","","Al-Mu'jam al-Kabir 365","","أبو عبيدة ابن الجراح أمين الأمة عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن وهب المصري عن أصبغ بن الفرج مولى عمر بن عبد العزيز عن يحيى بن عثمان بن صالح عن الطبراني","سن أبي عبيدة ووفاته رضي الله عنه"
"366","وَمَا أَسْنَدَ  أَبُو عُبَيْدَةَ بْنُ الْجَرَّاحِ  رَضِيَ اللهُ عَنْهُ  بَابٌ فِي تَوَقُّعِ الْمَغْفِرَةِ لِمُصَلِّي صَلَاةِ الصُّبْحِ فِي الْجَمَاعَةِ يَوْمَ الْجُمُعَةِ  366  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ ، وَأَحْمَدُ بْنُ حَمَّادِ بْنِ زُغْبَةَ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  حَدَّثَنِي  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ زَحْرٍ ،  عَنْ  عَلِيِّ بْنِ يَزِيدَ ،  عَنِ  الْقَاسِمِ ،  عَنْ  أَبِي أُمَامَةَ ،  عَنْ  أَبِي عُبَيْدَةَ بْنِ الْجَرَّاحِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنَ الصَّلَوَاتِ صَلَاةٌ أَفْضَلُ مِنْ صَلَاةِ الْفَجْرِ يَوْمَ الْجُمُعَةِ فِي الْجَمَاعَةِ  ، وَمَا أَحْسَبُ مَنْ شَهِدَهَا مِنْكُمْ إِلَّا مَغْفُورًا لَهُ  .","","Al-Mu'jam al-Kabir 366","","أبو عبيدة ابن الجراح أمين الأمة عن أبو أمامة الباهلي عن القاسم بن عبد الرحمن الدمشقي عن علي بن يزيد الألهاني عن عبيد الله بن زحر الضمري عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن زغبة ، أحمد بن حماد بن مسلم التجيبي عن الطبراني","باب في توقع المغفرة لمصلي صلاة الصبح في الجماعة يوم الجمعة"
"367","بَابُ مَا جَاءَ فِي فَسَادِ النَّاسِ عِنْدَ إِظْهَارِ الْخُمُورِ وَاسْتِحْلَالِ الْحَرِيرِ  وَالْفُرُوجِ  367  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  الْفُضَيْلُ بْنُ         [1/157]      عِيَاضٍ ،  عَنْ  لَيْثٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ،  عَنْ  أَبِي ثَعْلَبَةَ الْخُشَنِيِّ ،  عَنْ  مُعَاذٍ ، وَأَبِي عُبَيْدَةَ ، قَالَا : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ هَذَا الْأَمْرَ بَدَأَ رَحْمَةً وَنُبُوَّةً ، ثُمَّ يَكُونُ رَحْمَةً وَخِلَافَةً  ، ثُمَّ كَائِنٌ مُلْكًا  عَضُوضًا  ، ثُمَّ كَائِنٌ عُتُوًّا وَجَبْرِيَّةً ، وَفَسَادًا فِي الْأَرْضِ يَسْتَحِلُّونَ الْحَرِيرَ ،  وَالْفُرُوجَ  ، وَالْخُمُورَ ، يُرْزَقُونَ عَلَى ذَلِكَ وَيُنْصَرُونَ حَتَّى يَلْقَوُا اللهَ - عَزَّ وَجَلَّ  - ""  .","","Al-Mu'jam al-Kabir 367","","أبو عبيدة ابن الجراح أمين الأمة عن أبو ثعلبة الخشني عن عبد الرحمن بن سابط الجمحي عن ليث بن أبي سليم عن الفضيل بن عياض عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب ما جاء في فساد الناس عند إظهار الخمور واستحلال الحرير والفروج"
"368","368  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  فِرْدَوْسٌ الْأَشْعَرِيُّ ،  ثَنَا  مَسْعُودُ بْنُ سُلَيْمَانَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  رَجُلٍ ، مِنْ  قُرَيْشٍ  ،  عَنْ  أَبِي ثَعْلَبَةَ ، قَالَ :  لَقِيتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْتُ : يَا رَسُولَ اللهِ ادْفَعْنِي إِلَى رَجُلٍ حَسَنِ التَّعْلِيمِ ، فَدَفَعَنِي إِلَى  أَبِي عُبَيْدَةَ بْنِ الْجَرَّاحِ  ثُمَّ قَالَ : "" قَدْ دَفَعْتُكَ إِلَى رَجُلٍ يُحْسِنُ تَعْلِيمَكَ وَأَدَبَكَ ، فَأَتَيْتُ  أَبَا عُبَيْدَةَ بْنَ الْجَرَّاحِ  وَهُوَ  وَبَشِيرُ بْنُ سَعْدٍ أَبُو النُّعْمَانِ بْنُ بَشِيرٍ  يَتَحَدَّثَانِ ، فَلَمَّا رَأَيَانِي سَكَتَا ، فَقُلْتُ : يَا  أَبَا عُبَيْدَةَ  ، وَاللهِ مَا هَكَذَا حَدَّثَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : إِنَّكَ جِئْتَ وَنَحْنُ نَتَحَدَّثُ حَدِيثًا سَمِعْنَاهُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاجْلِسْ حَتَّى نُحَدِّثَكَ ، فَقَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ فِيكُمُ النُّبُوَّةَ ، ثُمَّ تَكُونُ خِلَافَةٌ عَلَى مِنْهَاجِ النُّبُوَّةِ  ، ثُمَّ يَكُونُ مُلْكًا وَجَبْرِيَّةً  .","","Al-Mu'jam al-Kabir 368","","أبو ثعلبة الخشني عن رجل عن حبيب بن أبي ثابت الكاهلي عن مسعود بن سليمان عن فردوس بن الأشعري الكوفي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب ما جاء في فساد الناس عند إظهار الخمور واستحلال الحرير والفروج"
"369","[1/158]      بَابُ الْأَلِفِ  مَنِ اسْمُهُ  أُسَامَةُ  11 -  أُسَامَةُ بْنُ زَيْدِ بْنِ حَارِثَةَ  حِبُّ  رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُكَنَّى  أَبَا مُحَمَّدٍ  وَيُقَالُ  أَبُو زَيْدٍ  .  369  -  حَدَّثَنَا  خَلَفُ بْنُ عَمْرٍو الْعُكْبَرِيُّ  ، ثَنَا  مُعَلَّى بْنُ مَهْدِيٍّ الْمَوْصِلِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ ،  عَنْ  أَبِيهِ  ،  حَدَّثَنِي  أُسَامَةُ بْنُ زَيْدٍ ، قَالَ :  مَرَرْتُ بِالْمَسْجِدِ ، فَإِذَا  عَلِيٌّ  وَالْعَبَّاسُ  - رَضِيَ اللهُ عَنْهُمَا - قَاعِدَانِ ، فَقَالَا : يَا  أُسَامَةُ  ، اسْتَأْذِنْ لَنَا عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْتُ : يَا رَسُولَ اللهِ ، هَذَا  عَلِيٌّ  وَالْعَبَّاسُ  بِالْبَابِ ، يُرِيدَانِ الدُّخُولَ عَلَيْكَ ، قَالَ : "" تَدْرِي مَا جَاءَ بِهِمَا ؟ "" قُلْتُ : لَا وَاللهِ يَا رَسُولَ اللهِ مَا أَدْرِي مَا جَاءَ بِهِمَا ، قَالَ : "" وَلَكِنِّي قَدْ عَلِمْتُ مَا جَاءَ بِهِمَا ، ائْذَنْ لَهُمَا "" فَدَخَلَا عَلَيْهِ ، فَقَالَ لَهُ  عَلِيٌّ  : يَا رَسُولَ اللهِ جِئْنَا نَسْأَلُكَ : أَيُّ أَهْلِكَ أَحَبُّ إِلَيْكَ ؟ قَالَ : ""  فَاطِمَةُ بِنْتُ مُحَمَّدٍ  "" - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  عَلِيٌّ  : وَاللهِ يَا رَسُولَ اللهِ مَا عَنْ أَهْلِكَ أَسْأَلُكَ ، قَالَ :  فَأَحَبُّ أَهْلِي إِلَيَّ مَنْ أَنْعَمَ اللهُ عَلَيْهِ وَأَنْعَمْتُ عَلَيْهِ :  أُسَامَةُ  ، قَالَ : ثُمَّ مَنْ يَا رَسُولَ اللهِ ؟ قَالَ : "" ثُمَّ أَنْتَ "" ، قَالَ  الْعَبَّاسُ  : أَجَعَلْتَ عَمَّكَ آخِرَهُمْ ؟ قَالَ : "" إِنَّ  عَلِيًّا  سَبَقَكَ بِالْهِجْرَةِ  .","","Al-Mu'jam al-Kabir 369","","أسامة بن زيد بن حارثة ذو البطين عن أبو سلمة بن عبد الرحمن عن عمر بن أبي سلمة الزهري عن الوضاح بن عبد الله اليشكري عن معلى بن مهدي الموصلي عن خلف بن عمرو بن عبد الرحمن العكبري عن الطبراني","أسامة بن زيد حب رسول الله صلى الله عليه وسلم"
"370","370  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  قُرَّةُ بْنُ خَالِدٍ ،  حَدَّثَنِي         [1/159]      مُحَمَّدُ بْنُ سِيرِينَ ، قَالَ :  بَلَغَتِ النَّخْلَةُ عَلَى عَهْدِ  عُثْمَانَ بْنِ عَفَّانَ  - رَضِيَ اللهُ عَنْهُ - أَلْفَ دِرْهَمٍ ، قَالَ : فَعَمَدَ أُسَامَةُ إِلَى نَخْلَةٍ فَنَقَرَهَا وَأَخْرَجَ  جُمَّارَهَا  ، فَأَطْعَمَهَا أُمَّهُ  ، فَقَالُوا لَهُ : مَا حَمَلَكَ عَلَى هَذَا ، وَأَنْتَ تَرَى النَّخْلَةَ قَدْ بَلَغَتْ أَلْفًا ؟  فَقَالَ  : "" إِنَّ أُمِّي سَأَلَتْنِيهِ ، وَلَا تَسْأَلُنِي شَيْئًا أَقْدِرُ عَلَيْهِ إِلَّا أَعْطَيْتُهَا  ""  .","","Al-Mu'jam al-Kabir 370","","أسامة بن زيد بن حارثة ذو البطين عن محمد بن سيرين عن قرة بن خالد السدوسي عن مسلم بن إبراهيم الشحام عن الفضل بن الحباب الجمحي عن الطبراني","أسامة بن زيد حب رسول الله صلى الله عليه وسلم"
"371","371  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، ثَنَا  عَبْدُ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ، قَالَ :  كَانَ  أُسَامَةُ بْنُ زَيْدٍ  يُدْعَى بِالْإِمْرَةِ ، حَتَّى مَاتَ  ، يَقُولُونَ : بَعَثَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ لَمْ يَنْزِعْهُ حَتَّى مَاتَ  .","","Al-Mu'jam al-Kabir 371","","الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أسامة بن زيد حب رسول الله صلى الله عليه وسلم"
"372","372  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أُسَامَةُ  أَحَبُّ النَّاسِ إِلَيَّ  .","","Al-Mu'jam al-Kabir 372","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن حماد بن سلمة عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","أسامة بن زيد حب رسول الله صلى الله عليه وسلم"
"373","نِسْبَةُ  أُسَامَةَ بْنِ زَيْدٍ  وَسِنُّهُ وَوَفَاتُهُ  373  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ، عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ  ، "" بِنَسَبِهِ :  أُسَامَةُ بْنُ زَيْدِ بْنِ حَارِثَةَ بْنِ شَرَاحِيلَ بْنِ كَعْبِ بْنِ عَبْدِ الْعُزَّى بْنِ يَزِيدَ بْنِ امْرِئِ الْقَيْسِ الْكَلْبِيُّ  ، وَأَنْعَمَ اللهُ عَلَيْهِ ، وَرَسُولُهُ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - "" .","","Al-Mu'jam al-Kabir 373","","","نسبة أسامة بن زيد وسنه ووفاته"
"374","374  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  سَعِيدُ بْنُ عَمْرٍو ،  ثَنَا  أَبُو بَكْرِ بْنُ شُعَيْبِ بْنِ الْحَبْحَابِ ، قَالَ :  سَمِعْتُ  أَشْيَاخَنَا ، يَقُولُونَ :  كَانَ نَقْشُ خَاتَمِ أُسَامَةَ بْنِ زَيْدٍ :  حِبُّ  رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - ""  .","","Al-Mu'jam al-Kabir 374","","أسامة بن زيد بن حارثة ذو البطين عن أشياخ أبو بكر بن شعيب بن الحبحاب المعولي عن أبو بكر بن شعيب بن الحبحاب المعولي عن سعيد بن عمرو بن سهل الأشعثي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","نسبة أسامة بن زيد وسنه ووفاته"
"375","375  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ الْحَكَمِ بْنِ         [1/160]      أَبِي زِيَادٍ الْقَطَوَانِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ الرَّازِيُّ ،  عَنْ  أَبِي سِنَانٍ ،  عَنْ  أَبِي إِسْحَاقَ ، قَالَ :  رَأَيْتُ  أُنَاسًا مِنْ أَصْحَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْتَزِرُونَ عَلَى أَنْصَافِ سُوقِهِمْ  ، فَذَكَرَ ابْنَ عُمَرَ ، وَزَيْدَ بْنَ أَرْقَمَ ، وَأُسَامَةَ بْنَ زَيْدٍ ، وَالْبَرَاءَ بْنَ عَازِبٍ - رَضِيَ اللهُ عَنْهُمْ  - ""  .","","Al-Mu'jam al-Kabir 375","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن سعيد بن سنان البرجمي عن إسحاق بن سليمان الرازي عن عبد الله بن الحكم القطواني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","نسبة أسامة بن زيد وسنه ووفاته"
"376","وَمَا أَسْنَدَ  أُسَامَةُ بْنُ زَيْدٍ  رَضِيَ اللهُ عَنْهُ  376  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الرَّقِّيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  مُحَمَّدِ بْنِ أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  أَبِيهِ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَسَاهُ  قُبْطِيَّةً  مِمَّا أَهْدَاهُ لَهُ  دِحْيَةُ الْكَلْبِيُّ  ، فَكَسَوْتُهَا امْرَأَتِي ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا لَكَ لَا تَلْبَسُ  الْقُبْطِيَّةَ  ؟ "" قُلْتُ : كَسَوْتُهَا امْرَأَتِي ، قَالَ : "" مُرْهَا أَنْ تَجْعَلَ تَحْتَهَا غِلَالَةً ، فَإِنِّي أَخَافُ أَنْ تَصِفَ عِظَامَهَا  .","","Al-Mu'jam al-Kabir 376","","أسامة بن زيد بن حارثة ذو البطين عن محمد بن أسامة بن زيد بن حارثة عن عبد الله بن محمد بن عقيل بن أبي طالب عن عبيد الله بن عمرو بن أبي الوليد عن عبد الله بن جعفر بن غيلان عن حفص بن عمر سنجة ألف عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"377","377  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ عُبَيْدِ بْنِ السَّبَّاقِ ،  عَنْ  مُحَمَّدِ بْنِ أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  لَمَّا ثَقُلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - هَبَطْتُ وَهَبَطَ النَّاسُ إِلَى  الْمَدِينَةِ  ، فَدَخَلْتُ عَلَيْهِ وَقَدْ أُصْمِتَ وَهُوَ لَا يَتَكَلَّمُ  فَجَعَلَ "" يَرْفَعُ يَدَهُ إِلَى السَّمَاءِ وَيَصُبُّهَا عَلَيَّ "" فَعَرَفْتُ أَنَّهُ يَدْعُو لِي  .","","Al-Mu'jam al-Kabir 377","","أسامة بن زيد بن حارثة ذو البطين عن محمد بن أسامة بن زيد بن حارثة عن سعيد بن عبيد بن السباق الثقفي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"378","378  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عِقَالٍ  ، ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ قُسَيْطٍ ،  عَنْ  مُحَمَّدِ بْنِ أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِجَعْفَرٍ  : ""  خُلُقُكَ  كَخُلُقِي  ، وَأَنْتَ مِنِّي ، وَأَنْتَ يَا  عَلِيُّ  فَمِنِّي وَأَبُو وَلَدِي  .","","Al-Mu'jam al-Kabir 378","","أسامة بن زيد بن حارثة ذو البطين عن محمد بن أسامة بن زيد بن حارثة عن يزيد بن عبد الله بن قسيط الليثي عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن عبد الله بن محمد النفيلي عن أحمد بن عبد الرحمن بن يزيد الحراني عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"379","379  -  حَدَّثَنَا  خَلَفُ بْنُ عَمْرٍو الْعُكْبَرِيُّ ،  ثَنَا  مُعَلَّى بْنُ مَهْدِيٍّ ،  ثَنَا  أَبُو         [1/161]      عَوَانَةَ ،  عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 379","","أسامة بن زيد بن حارثة ذو البطين عن أبو سلمة بن عبد الرحمن عن عمر بن أبي سلمة الزهري عن الوضاح بن عبد الله اليشكري عن معلى بن مهدي الموصلي عن خلف بن عمرو بن عبد الرحمن العكبري عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"380","380  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سُوَيْدٍ الشِّبَامِيُّ  ، ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  أَخْبَرَنِي  عَطَاءٌ ، مَوْلَى سِبَاعٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمَّا أَتَى  جَمْعًا  صَلَّى بِهَا الْمَغْرِبَ وَالْعِشَاءَ  .","","Al-Mu'jam al-Kabir 380","","أسامة بن زيد بن حارثة ذو البطين عن عطاء بن يعقوب المدني عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إبراهيم بن محمد بن عبد الله الشبامي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"381","381  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبْدُوسٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ،  أَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي ظِبْيَانَ ،  عَنْ  أُسَامَةَ ، قَالَ :  بَعَثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَرِيَّةً إِلَى  الْحُرُقَاتِ  الْحَدِيثَ .","","Al-Mu'jam al-Kabir 381","","أسامة بن زيد بن حارثة ذو البطين عن حصين بن جندب الجنبي عن الأعمش عن يعلى بن عبيد الطنافسي عن عبد الله بن عمر مشكدانة عن محمد بن عبدوس السراج عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"382","382  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِي ،  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ ،  ثَنَا  عَيَّاشُ بْنُ عَبَّاسٍ ، أَنَّ أَبَا النَّضْرِ ،  أَخْبَرَهُ  أَنَّ عَامِرَ بْنَ سَعْدٍ  حَدَّثَهُ  ، أَنَّ أُسَامَةَ بْنَ زَيْدٍ  أَخْبَرَهُ  ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : إِنِّي  أَعْزِلُ  وَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 382","","أسامة بن زيد بن حارثة ذو البطين عن عامر بن سعد بن أبي وقاص عن سالم بن أبي أمية التيمي عن عياش بن عباس القتباني عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"383","383  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ هَذَا  الْوَبَاءَ  رِجْزٌ  فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 383","","أسامة بن زيد بن حارثة ذو البطين عن عامر بن سعد بن أبي وقاص عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"384","384  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ  ، ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  أُسَامَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ هَذَا  الْوَبَاءَ  رِجْزٌ  فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 384","","أسامة بن زيد بن حارثة ذو البطين عن عامر بن سعد بن أبي وقاص عن محمد بن المنكدر عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"385","[1/162]      385  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  عُقَيْلٌ ،  عَنِ  ابْنِ شِهَابٍ ،  أَخْبَرَنِي  عُرْوَةُ بْنُ الزُّبَيْرِ ، أَنَّ أُسَامَةَ بْنَ زَيْدٍ  أَخْبَرَهُ  ، قَالَ :  رَكِبْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى حِمَارٍ عَلَى إِكَافٍ عَلَى قَطِيفَةٍ  فَذَكَرَ الْحَدِيثَ بِطُولِهِ .","","Al-Mu'jam al-Kabir 385","","أسامة بن زيد بن حارثة ذو البطين عن عروة بن الزبير عن الزهري عن عقيل بن خالد الأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"386","386  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  كُرَيْبٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  أَنَّهُ  دَفَعَ  مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَشِيَّةَ  عَرَفَةَ  ، فَصَارَ إِلَى الْمَضِيقِ ، فَأَنَاخَ رَاحِلَتَهُ فَقَضَى حَاجَتَهُ ، ثُمَّ جَاءَ فَجَعَلَ يَتَوَضَّأُ  وَأُسَامَةُ  يَصُبُّ عَلَيْهِ ، فَقَالَ : يَا رَسُولَ اللهِ ، الصَّلَاةَ ، قَالَ :  الْمُصَلَّى أَمَامَكَ  .","","Al-Mu'jam al-Kabir 386","","أسامة بن زيد بن حارثة ذو البطين عن كريب بن أبي مسلم الحجازي عن موسى بن عقبة عن يحيى بن سعيد الأنصاري عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"387","387  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  خَالِدُ بْنُ يَزِيدَ الْعُمَرِيُّ ،  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  كُرَيْبٍ ،  عَنْ  أُسَامَةَ ، قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْكَآبَةُ ، فَقُلْتُ : مَا لَكَ يَا رَسُولَ اللهِ ؟ قَالَ : "" إِنَّ  جِبْرِيلَ  - عَلَيْهِ السَّلَامُ - وَعَدَنِي أَنْ يَأْتِيَنِي وَلَمْ يَأْتِنِي مُنْذُ ثَلَاثٍ "" ، قَالَ : وَإِذَا كَلْبٌ ، قَالَ  أُسَامَةُ  : فَوَضَعْتُ يَدَيَّ عَلَى رَأْسِي فَصِحْتُ ، فَقَالَ : "" مَا لَكَ يَا  أُسَامَةُ  ؟ "" فَقُلْتُ : كَلْبٌ ، فَأَمَرَ بِهِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقُتِلَ ، ثُمَّ أَتَاهُ  جِبْرِيلُ  ، فَقَالَ : "" مَا لَكَ لَمْ تَأْتِنِي ، وَكُنْتَ إِذَا وَعَدْتَنِي لَمْ تُخْلِفْنِي ، فَقَالَ :  إِنَّا لَا نَدْخُلُ بَيْتًا فِيهِ كَلْبٌ وَلَا تَصَاوِيرُ  .","","Al-Mu'jam al-Kabir 387","","أسامة بن زيد بن حارثة ذو البطين عن كريب بن أبي مسلم الحجازي عن الحارث بن عبد الرحمن العامري عن محمد بن عبد الرحمن بن المغيرة عن خالد بن يزيد الحذاء عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"388","388  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،         [1/163]      عَنْ  مُحَمَّدِ بْنِ مُهَاجِرٍ ،  عَنْ  سُلَيْمَانَ بْنِ مُوسَى ،  حَدَّثَنِي  كُرَيْبٌ ، أَنَّ أُسَامَةَ بْنَ زَيْدٍ  أَخْبَرَهُ  ، قَالَ : قَالَ رَسُولُ اللهِ :  أَلَا مُشَمِّرٌ لِلْجَنَّةِ ؟  هِيَ وَرَبِّ الْكَعْبَةِ نُورٌ  يَتَلَأْلَأُ  ، وَرَيْحَانَةٌ تَهْتَزُّ ، وَنَهَرٌ مُطَّرِدٌ ، وَزَوْجَةٌ حَسْنَاءُ جَمِيلَةٌ فِي رَوْضَةٍ وَحَبْرَةٍ فِي إِقَامَةِ الْأَبَدِ  .","","Al-Mu'jam al-Kabir 388","","أسامة بن زيد بن حارثة ذو البطين عن كريب بن أبي مسلم الحجازي عن سليمان بن موسى الأشدق عن محمد بن مهاجر بن أبي مسلم عن الوليد بن مسلم القرشي عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"389","389  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا  أَبُو الْيَمَانِ الْحَكَمُ بْنُ نَافِعٍ ،  أَنَا  شُعَيْبُ بْنُ أَبِي حَمْزَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَصْحَابُهُ يَأْخُذُونَ الْعَفْوَ مِنَ الْمُشْرِكِينَ  ، وَأَهْلِ الْكِتَابِ كَمَا أَمَرَهُمُ اللهُ - عَزَّ وَجَلَّ -  وَيَصْبِرُوا  عَلَى الْأَذَى قَالَ اللهُ - عَزَّ وَجَلَّ - :         {      وَلَتَسْمَعُنَّ مِنَ الَّذِينَ أُوتُوا الْكِتَابَ مِنْ قَبْلِكُمْ وَمِنَ الَّذِينَ أَشْرَكُوا أَذًى كَثِيرًا         }      الْآيَةَ ، وَكَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَتَأَوَّلُ فِي الْعَفْوِ مَا أَمَرَهُ اللهُ بِهِ ، حَتَّى أَذِنَ اللهُ فِيهِمْ ، فَلَمَّا غَزَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بَدْرًا  فَقَتَلَ اللهُ مَنْ قَتَلَ مِنَ الْكُفَّارِ مِنْ  صَنَادِيدِ  قُرَيْشٍ  "" قَالَ  ابْنُ أُبَيٍّ  ، وَمَنْ مَعَهُ مِنَ الْمُشْرِكِينَ : هَذَا أَمْرٌ قَدْ تَوَجَّهَ لَهُ ، فَبَايَعُوا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى الْإِسْلَامِ ، فَأَسْلَمُوا  .","","Al-Mu'jam al-Kabir 389","","أسامة بن زيد بن حارثة ذو البطين عن عروة بن الزبير عن الزهري عن شعيب بن أبي حمزة الحمصي عن أبو اليمان الحكم بن نافع عن أبو زرعة الدمشقي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"390","390  -  حَدَّثَنَا  أَبُو عَقِيلٍ أَنَسُ بْنُ سَلْمٍ الْخَوْلَانِيُّ ،  ثَنَا  أَبُو الْأَصْبَغِ عَبْدُ الْعَزِيزِ بْنُ يَحْيَى الْحَرَّانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَعُودُ  عَبْدَ اللهِ بْنَ أُبَيٍّ  فِي مَرَضِهِ الَّذِي مَاتَ فِيهِ ، وَأَنَا مَعَهُ ، فَعَرَفَ فِيهِ الْمَوْتَ ، فَقَالَ :  كُنْتُ أَنْهَاكَ عَنْ حُبِّ الْيَهُودِ  قَالَ  أَسْعَدُ بْنُ زُرَارَةَ  : مَاتَ فَمَهْ ؟ فَلَمَّا مَاتَ أَتَاهُ ابْنُهُ  عَبْدُ اللهِ  ، فَقَالَ : إِنَّ  عَبْدَ اللهِ  مَاتَ ، فَأَعْطِنِي قَمِيصَكَ أُكَفِّنْهُ فِيهِ ، فَنَزَعَ قَمِيصَهُ فَأَلْبَسَهُ إِيَّاهُ  .","","Al-Mu'jam al-Kabir 390","","أسامة بن زيد بن حارثة ذو البطين عن عروة بن الزبير عن الزهري عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن عبد العزيز بن يحيى البكائي عن أنس بن سلم الأنطرسوسي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"391","391  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  هُشَيْمٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَلِيِّ بْنِ الْحُسَيْنِ ،  عَنْ  عَمْرِو بْنِ عُثْمَانَ ،  عَنْ  أُسَامَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَرِثُ الْكَافِرُ الْمُسْلِمَ  ، وَلَا الْمُسْلِمُ الْكَافِرَ ، وَلَا يَتَوَارَثُ أَهْلُ  مِلَّتَيْنِ  .","","Al-Mu'jam al-Kabir 391","","أسامة بن زيد بن حارثة ذو البطين عن عمرو بن عثمان بن عفان بن أبي العاص الأموي عن علي بن الحسين زين العابدين عن الزهري عن هشيم بن بشير عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"392","[1/164]      392  -  حَدَّثَنَا  أَبُو حَصِينٍ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  خَالِدٌ الْوَاسِطِيُّ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  أُسَامَةَ ، قَالَ :  أَوْجَرْتُ  رَجُلًا  الرُّمْحَ وَهُوَ يَقُولُ : لَا إِلَهَ إِلَّا اللهُ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِأُسَامَةَ  :  كَيْفَ لَكَ بِلَا إِلَهَ إِلَّا اللهُ يَوْمَ الْقِيَامَةِ  ؟ "" قَالَ ذَلِكَ مِرَارًا حَتَّى وَدِدْتُ أَنِّي لَمْ أَكُنْ أَسْلَمْتُ قَبْلَ تِلْكَ السَّاعَةِ  .","","Al-Mu'jam al-Kabir 392","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن حبيب السلمي عن عطاء بن السائب عن خالد بن عبد الله الطحان عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"393","393  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  جَامِعِ بْنِ شَدَّادٍ ،  عَنْ  كُلْثُومٍ الْخُزَاعِيِّ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ :  اسْتَأْذَنْتُ لِأُنَاسٍ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَذِنَ لَهُمْ ، فَإِذَا هُوَ مُقَنِّعٌ رَأْسَهُ بِبُرْدٍ لَهُ مَعَافِرِيٍّ ، فَكَشَفَ الْقِنَاعَ عَنْ رَأْسِهِ ثُمَّ قَالَ :  لَعَنَ اللهُ الْيَهُودَ اتَّخَذُوا  قُبُورَ  أَنْبِيَائِهِمْ مَسَاجِدَ  .","","Al-Mu'jam al-Kabir 393","","أسامة بن زيد بن حارثة ذو البطين عن كلثوم بن المصطلق الخزاعي عن جامع بن شداد عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"394","394  -  حَدَّثَنَا  أَبُو حَصِينٍ  ، ثَنَا  يَحْيَى ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي ظِبْيَانَ ،  عَنْ  أُسَامَةَ ،  بَعَثَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى  الْحُرُقَاتِ  فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 394","","أسامة بن زيد بن حارثة ذو البطين عن حصين بن جندب الجنبي عن الأعمش عن أبو معاوية الضرير عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"395","395  -  حَدَّثَنَا  أَبُو حَصِينٍ ،  حَدَّثَنَا  يَحْيَى ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  أُسَامَةَ ، سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يُؤْتَى بِالرَّجُلِ  فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 395","","أسامة بن زيد بن حارثة ذو البطين عن شقيق بن سلمة عن الأعمش عن أبو معاوية الضرير عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"396","396  -  ثَنَا  أَبُو حَصِينٍ  ، ثَنَا  يَحْيَى ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنْ  أَبِي الشَّعْثَاءِ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  أُسَامَةَ ،  أَنَّهُ  رَأَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ الْبَيْتَ  الْحَدِيثَ .","","Al-Mu'jam al-Kabir 396","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عمر بن الخطاب عن سليم بن أسود المحاربي عن عمارة بن عمير التيمي عن الأعمش عن أبو معاوية الضرير عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"397","397  -  حَدَّثَنَا  أَبُو حَصِينٍ  ، ثَنَا  يَحْيَى ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ  ،  عَنْ  أَبِيهِ  ،  عَنْ         [1/165]      عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أُسَامَةَ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَسَحَ عَلَى الْخُفَّيْنِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : (بن زيد) .","","Al-Mu'jam al-Kabir 397","","أسامة بن زيد بن حارثة ذو البطين عن عطاء بن يسار الهلالي عن زيد بن أسلم عن عبد الرحمن بن زيد بن أسلم عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"398","398  -  حَدَّثَنَا  أَبُو حَصِينٍ  ، ثَنَا  يَحْيَى ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  أُسَامَةَ ، قَالَ :  بَعَثَ بَنَاتُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - "" الْحَدِيثَ .","","Al-Mu'jam al-Kabir 398","","أسامة بن زيد بن حارثة ذو البطين عن أبو عثمان النهدي عن عاصم بن سليمان الأحول عن علي بن مسهر القرشي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"399","399  -  حَدَّثَنَا  أَبُو الْحَصِينِ  ، ثَنَا  يَحْيَى ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  عُثْمَانَ بْنِ حَكِيمٍ ،  عَنِ  ابْنِ أَفْلَحَ ، مَوْلَى أَبِي أَيُّوبَ ،  عَنْ  أُسَامَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  إِنَّ اللهَ - عَزَّ وَجَلَّ - لَا يُحِبُّ  الْفَاحِشَ  الْمُتَفَحِّشَ  .","","Al-Mu'jam al-Kabir 399","","أسامة بن زيد بن حارثة ذو البطين عن محمد بن أفلح الأنصاري عن عثمان بن حكيم الأحلافي عن يحيى بن زكريا بن أبي زائدة عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"400","400  -  حَدَّثَنَا  أَبُو حَصِينٍ  ، ثَنَا  يَحْيَى ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  صَالِحِ بْنِ أَبِي الْأَخْضَرِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  أُسَامَةَ ،  أَمَرَنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ أُغِيرَ عَلَى  أَبْنَاءِ صُبَاحٍ  وَأُحَرِّقَ  .","","Al-Mu'jam al-Kabir 400","","أسامة بن زيد بن حارثة ذو البطين عن عروة بن الزبير عن الزهري عن صالح بن أبي الأخضر اليمامي عن عبد الله بن المبارك عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"401","401  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  حَدَّثَنِي  ابْنُ ضِيرِي  مَوْلَى أُسَامَةَ ،  عَنْ  أُسَامَةَ ،  أَنَّ  رَجُلًا  قَدِمَ مِنْ بَعْضِ  الْأَرْيَافِ  ، فَأَخَذَهُ الْوَجَعُ ، فَرَجَعَ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنِّي لَأَرْجُو أَنْ لَا يَطْلُعَ عَلَيْنَا  نِقَابَهَا  يَعْنِي  نِقَابَ  الْمَدِينَةِ  .  هكذا في طبعة مكتبة ابن تيمية ، وفي مسند أحمد ط الرسالة 36 / 135 : وهو ابن ضبري ، وقيل : ابن ضمري ، وقيل : ابن ضبيرة ، وقيل غير ذلك .","","Al-Mu'jam al-Kabir 401","","أسامة بن زيد بن حارثة ذو البطين عن عياض بن ضبري الكلبي عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"402","402  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  أُسَامَةَ ، قَالَ :  أَمَا إِنِّي لَا أَقُولُ لِرَجُلٍ : أَنْتَ خَيْرُ النَّاسِ ، بَعْدَمَا سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يُجَاءُ بِرَجُلٍ يَوْمَ الْقِيَامَةِ  الْحَدِيثَ .","","Al-Mu'jam al-Kabir 402","","أسامة بن زيد بن حارثة ذو البطين عن شقيق بن سلمة عن الأعمش عن يعلى بن عبيد الطنافسي عن عبد الله بن عمر مشكدانة عن محمد بن عبدوس السراج عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"403","403  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ،         [1/166]      عَنِ  الْأَجْلَحِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ سَعْدٍ ،  عَنْ  أُسَامَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ هَذَا الطَّاعُونَ  رِجْزٌ  وَعَذَابٌ  ، عُذِّبَ بِهِ مَنْ كَانَ قَبْلَكُمْ ، فَإِذَا كَانَ بِأَرْضٍ فَلَا تَخْرُجُوا مِنْهَا ، وَإِذَا وَقَعَ بِأَرْضٍ وَلَسْتُمْ بِهَا فَلَا تَدْخُلُوهَا  .","","Al-Mu'jam al-Kabir 403","","أسامة بن زيد بن حارثة ذو البطين عن إبراهيم بن سعد بن أبي وقاص عن حبيب بن أبي ثابت الكاهلي عن أجلح بن عبد الله الكندي عن يعلى بن عبيد الطنافسي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"404","404  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْبَرْبَهَارِيُّ ،  حَدَّثَنَا  زَكَرِيَّا بْنُ عَدِيٍّ ، (  ح  )  وَحَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  عُثْمَانَ بْنِ حَكِيمٍ ،  عَنْ  مُحَمَّدِ بْنِ أَفْلَحَ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ اللهَ لَا يُحِبُّ  الْفَاحِشَ  الْمُتَفَحِّشَ  .","","Al-Mu'jam al-Kabir 404","","أسامة بن زيد بن حارثة ذو البطين عن محمد بن أفلح الأنصاري عن عثمان بن حكيم الأحلافي عن يحيى بن زكريا بن أبي زائدة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"405","405  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  وَهْبُ بْنُ جَرِيرِ بْنِ حَازِمٍ ،  حَدَّثَنِي  أَبِي  ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ إِسْحَاقَ  يُحَدِّثُ ، عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  قَالَ  :  رَأَيْتُ أُسَامَةَ بْنَ زَيْدٍ عِنْدَ حُجْرَةِ  عَائِشَةَ  يَدْعُو ، فَجَاءَ  مَرْوَانُ  فَأَسْمَعَهُ كَلَامًا ، فَقَالَ  أُسَامَةُ  : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ اللهَ - عَزَّ وَجَلَّ - يُبْغِضُ الْفَاحِشَ الْبَذِيءَ  .","","Al-Mu'jam al-Kabir 405","","أسامة بن زيد الليثي المدني عن عبيد الله بن عبد الله بن عتبة بن مسعود عن صالح بن كيسان الدوسي عن محمد بن إسحاق عن جرير بن حازم عن وهب بن جرير بن حازم عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"406","406  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  مُحَاضِرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنْ  أَبِي الشَّعْثَاءِ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" دَخَلَ الْبَيْتَ فَمَشَى حَتَّى تَوَسَّطَ  ، فَدَنَا إِلَى الْحَائِطِ ، وَدَخَلَ بَيْنَ  أُسَامَةَ  وَبِلَالٍ  الْحَدِيثَ .","","Al-Mu'jam al-Kabir 406","","بلال بن رباح سابق الحبشة عن عبد الله بن عمر بن الخطاب عن سليم بن أسود المحاربي عن عمارة بن عمير التيمي عن الأعمش عن محاضر بن المورع الهمداني عن عبد الله بن عمر مشكدانة عن محمد بن عبدوس السراج عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"407","407  -  حَدَّثَنَا  الْأَسْفَاطِيُّ  ، حَدَّثَنَا  خَالِدُ بْنُ يَزِيدَ الْعُمَرِيُّ ،  ثَنَا  ابْنُ أَبِي         [1/167]      ذِئْبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ مِهْرَانَ ،  عَنْ  عُمَيْرٍ ، مَوْلَى ابْنِ عَبَّاسٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : دَخَلَ الْبَيْتَ فَرَأَى صُوَرًا فَدَعَا بِمَاءٍ ، فَجَعَلَ يَمْحُوهَا وَيَقُولُ :  قَاتَلَ اللهُ قَوْمًا يُصَوِّرُونَ مَا لَا يَخْلُقُونَ  .","","Al-Mu'jam al-Kabir 407","","أسامة بن زيد بن حارثة ذو البطين عن عمير بن عبد الله الهلالي عن عبد الرحمن بن مهران الهاشمى عن محمد بن عبد الرحمن بن المغيرة عن خالد بن يزيد الحذاء عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"408","408  -  وَعَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنْ  زِبْرَقَانَ ،  عَنْ  زُهْرَةَ ،  عَنْ  أُسَامَةَ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى الظُّهْرَ  بِالْهَجِيرِ  .","","Al-Mu'jam al-Kabir 408","","أسامة بن زيد بن حارثة ذو البطين عن زهرة عن الزبرقان بن عمرو الضمري عن خالد بن يزيد الحذاء عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"409","409  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ ،  ثَنَا  أَبِي  ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  عُمَرَ بْنِ الْحَكَمِ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تُعْرَضُ الْأَعْمَالُ عَلَى اللهِ - عَزَّ وَجَلَّ - يَوْمَ الِاثْنَيْنِ وَالْخَمِيسِ  ، فَيَغْفِرُ اللهُ إِلَّا مَا كَانَ مِنْ  مُشَاحِنَيْنِ  ، أَوْ قَاطِعِ رَحِمٍ  .","","Al-Mu'jam al-Kabir 409","","أسامة بن زيد بن حارثة ذو البطين عن عمر بن الحكم بن ثوبان الحجازي عن موسى بن عبيدة بن نشيط الحميري عن مروان بن معاوية الفزاري عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"410","410  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ  ، ثَنَا  أَبُو مَسْعُودٍ ،  حَدَّثَنَا  سَهْلُ بْنُ عَبْدِ رَبِّهِ الرَّازِيُّ ،  عَنْ  عَمْرِو بْنِ أَبِي قَيْسٍ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  أَخِيهِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى  ، عَنْ  أُسَامَةَ بْنِ زَيْدٍ :         {      فَمِنْهُمْ ظَالِمٌ لِنَفْسِهِ وَمِنْهُمْ مُقْتَصِدٌ         }      الْآيَةَ ، قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كُلُّهُمْ مِنْ هَذِهِ الْأُمَّةِ  .","","Al-Mu'jam al-Kabir 410","","أسامة بن زيد بن حارثة ذو البطين عن عبد الرحمن بن أبي ليلى عن محمد بن عبد الرحمن بن أبي ليلى عن عمرو بن أبي قيس عن سهل بن عبد الرحمن المعروف بالسندي بن عبدويه عن أحمد بن الفرات الضبي عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"411","411  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، أَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ غُرَابٍ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  جَامِعِ بْنِ شَدَّادٍ ،  عَنْ  كُلْثُومٍ الْخُزَاعِيِّ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ فِي مَرَضِهِ الَّذِي مَاتَ فِيهِ :  لَعَنَ اللهُ الْيَهُودَ اتَّخَذُوا  قُبُورَ  أَنْبِيَائِهِمْ مَسَاجِدَ  .","","Al-Mu'jam al-Kabir 411","","أسامة بن زيد بن حارثة ذو البطين عن كلثوم بن المصطلق الخزاعي عن جامع بن شداد عن قيس بن الربيع الأسدي عن محمد بن على بن غراب عن يحيى بن عثمان بن صالح عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"412","412  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ، (  ح  )  وَحَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ، (  ح  )         [1/168]      وَحَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ  ، ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي حَفْصَةَ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عِمْرَانَ الْأَصْبَهَانِيُّ ،  ثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  ثَنَا  زَمْعَةُ بْنُ صَالِحٍ ، وَعَبْدُ اللهِ بْنُ بُدَيْلِ بْنِ وَرْقَاءَ الْخُزَاعِيُّ ، (  ح  )  وَحَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  عُقَيْلُ بْنُ خَالِدٍ ، (  ح  )  وَحَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يُونُسُ بْنُ يَزِيدَ ، (  ح  )  وَحَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ بْنُ سَعْدٍ ،  حَدَّثَنِي  يَزِيدُ بْنُ عَبْدِ اللهِ بْنِ الْهَادِ ، (  ح  )  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  عُمَرُ بْنُ عَبْدِ الْوَهَّابِ الثَّقَفِيُّ ،  ثَنَا  أَبِي  ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ الْأَنْصَارِيِّ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ هَاشِمٍ الْبَعْلَبَكِّيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  سُفْيَانَ بْنِ حُسَيْنٍ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ، كُلُّهُمْ  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ ،  عَنْ  عَمْرِو بْنِ عُثْمَانَ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا يَرِثُ الْمُسْلِمُ الْكَافِرَ ، وَلَا الْكَافِرُ الْمُسْلِمَ  زَادَ  مَعْمَرٌ  ،  وَسُفْيَانُ بْنُ حُسَيْنٍ  ،  وَصَالِحُ بْنُ كَيْسَانَ  فِي حَدِيثِهِمْ : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : "" وَهَلْ تَرَكَ لَنَا  عَقِيلٌ  مِنْ  دَارٍ  ؟  .","","Al-Mu'jam al-Kabir 412","","أسامة بن زيد بن حارثة ذو البطين عن عمرو بن عثمان بن عفان بن أبي العاص الأموي عن علي بن الحسين زين العابدين عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"413","413  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سُوَيْدٍ الشِّبَامِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ ،  عَنْ  عَمْرِو بْنِ عُثْمَانَ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، أَيْنَ مَنْزِلُنَا غَدًا ؟ قَالَ : "" وَهَلْ تَرَكَ لَنَا  عَقِيلٌ  مِنْ  دَارٍ  أَوْ رِبَاعٍ ؟  مَنْزِلُنَا  بِخَيْفِ بَنِي كِنَانَةَ  حَيْثُ  تَقَاسَمَتْ  قُرَيْشٌ  عَلَى الْكُفْرِ  .","","Al-Mu'jam al-Kabir 413","","أسامة بن زيد بن حارثة ذو البطين عن عمرو بن عثمان بن عفان بن أبي العاص الأموي عن علي بن الحسين زين العابدين عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إبراهيم بن محمد بن عبد الله الشبامي عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"414","[1/169]      414  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ  ، ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  عَبْدُ الْمَلِكِ بْنُ أَبِي سُلَيْمَانَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ :  لَمْ يَزَلْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسِيرُ عَلَى هَيْأَتِهِ حِينَ  أَفَاضَ  مِنْ  جَمْعٍ  .","","Al-Mu'jam al-Kabir 414","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","وما أسند أسامة بن زيد رضي الله عنه"
"415","بَابُ مَا جَاءَ فِي الْمَرْأَةِ السُّوءِ وَأَنَّهَا فِتْنَةٌ وَمَضَرَّةٌ عَلَى زَوْجِهَا .  415  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  هَوْذَةُ بْنُ خَلِيفَةَ ،  ثَنَا  سُلَيْمَانُ التَّيْمِيُّ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا تَرَكْتُ بَعْدِي فِتْنَةً فِي النَّاسِ أَضَرَّ عَلَى الرِّجَالِ مِنَ النِّسَاءِ  .","","Al-Mu'jam al-Kabir 415","","أسامة بن زيد بن حارثة ذو البطين عن أبو عثمان النهدي عن سليمان بن طرخان عن هوذة بن خليفة البكراوي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب ما جاء في المرأة السوء وأنها فتنة ومضرة على زوجها"
"416","416  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا تَرَكْتُ بَعْدِي فِتْنَةً أَضَرَّ عَلَى الرِّجَالِ مِنَ النِّسَاءِ  .","","Al-Mu'jam al-Kabir 416","","أسامة بن زيد بن حارثة ذو البطين عن أبو عثمان النهدي عن سليمان بن طرخان عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب ما جاء في المرأة السوء وأنها فتنة ومضرة على زوجها"
"417","417  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  ثَنَا  مَعْمَرٌ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا تَرَكْتُ بَعْدِي فِتْنَةً أَضَرَّ عَلَى الرِّجَالِ مِنَ النِّسَاءِ  .","","Al-Mu'jam al-Kabir 417","","أسامة بن زيد بن حارثة ذو البطين عن أبو عثمان النهدي عن سليمان بن طرخان عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب ما جاء في المرأة السوء وأنها فتنة ومضرة على زوجها"
"418","418  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، حَدَّثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  سُلَيْمَانَ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  أُسَامَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنِّي لَمْ أَتْرُكْ بَعْدِي فِتْنَةً أَضَرَّ عَلَى الرِّجَالِ مِنَ النِّسَاءِ  .","","Al-Mu'jam al-Kabir 418","","أسامة بن زيد بن حارثة ذو البطين عن أبو عثمان النهدي عن سليمان بن طرخان عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","باب ما جاء في المرأة السوء وأنها فتنة ومضرة على زوجها"
"419","419  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْمُعَافَى بْنِ سُلَيْمَانَ ،  ثَنَا  أَبِي  ،  ثَنَا  الْقَاسِمُ بْنُ مَعْنٍ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا تَرَكْتُ فِي النَّاسِ بَعْدِي فِتْنَةً أَضَرَّ عَلَى الرِّجَالِ مِنَ النِّسَاءِ  .","","Al-Mu'jam al-Kabir 419","","أسامة بن زيد بن حارثة ذو البطين عن أبو عثمان النهدي عن سليمان بن طرخان عن القاسم بن معن عن المعافى بن سليمان الرسعني عن سليمان بن المعافى الرسعني عن الطبراني","باب ما جاء في المرأة السوء وأنها فتنة ومضرة على زوجها"
"420","420  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنِي         [1/170]      زُهَيْرٌ ،  ثَنَا  سُلَيْمَانُ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا تَرَكْتُ بَعْدِي فِتْنَةً أَضَرَّ مِنَ النِّسَاءِ عَلَى الرِّجَالِ  .","","Al-Mu'jam al-Kabir 420","","أسامة بن زيد بن حارثة ذو البطين عن أبو عثمان النهدي عن سليمان بن طرخان عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","باب ما جاء في المرأة السوء وأنها فتنة ومضرة على زوجها"
"421","421  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الْأَصْبَهَانِيُّ  ، حَدَّثَنَا  أَبُو مَسْعُودٍ أَحْمَدُ بْنُ الْفُرَاتِ ،  ثَنَا  مُحَمَّدُ بْنُ سَعِيدِ بْنِ سَابِقٍ ،  ثَنَا  أَبُو جَعْفَرٍ الرَّازِيُّ ،  عَنْ  سُلَيْمَانَ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  أُسَامَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قُمْتُ عَلَى بَابِ الْجَنَّةِ فَرَأَيْتُ أَكْثَرَ أَهْلِهَا الْمَسَاكِينَ  ، وَرَأَيْتُ أَصْحَابَ  الْجَدِّ  مَحْبُوسِينَ إِلَّا مَنْ كَانَ مِنْ أَهْلِ النَّارِ ، فَإِنَّهُ أُمِرَ بِهِمْ إِلَى النَّارِ  .","","Al-Mu'jam al-Kabir 421","","أسامة بن زيد بن حارثة ذو البطين عن أبو عثمان النهدي عن سليمان بن طرخان عن عيسى بن أبي عيسى الرازي عن محمد بن سعيد القزويني عن أحمد بن الفرات الضبي عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","باب ما جاء في المرأة السوء وأنها فتنة ومضرة على زوجها"
"422","422  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْجَمَّالُ  ، حَدَّثَنَا  أَبُو مَسْعُودٍ ،  ثَنَا  هِشَامُ بْنُ هِلَالٍ ،  عَنْ  مُحَمَّدِ بْنِ مُسْلِمٍ الطَّائِفِيِّ ،  عَنْ  مَعْمَرٍ ،  عَنْ  جَابِرٍ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  أُسَامَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ تَرَكَ ثَلَاثَ جُمُعَاتٍ مِنْ غَيْرِ عُذْرٍ كُتِبَ مِنَ الْمُنَافِقِينَ  .  في طبعة مكتبة ابن تيمية : (الحمال) وينظر مصادر الترجمة .","","Al-Mu'jam al-Kabir 422","","أسامة بن زيد بن حارثة ذو البطين عن أبو عثمان النهدي عن جابر الجعفي عن معمر بن راشد عن محمد بن مسلم بن سوسن الطائفي عن هشام بن هلال عن أحمد بن الفرات الضبي عن أحمد بن محمد بن عبد الله الجمال عن الطبراني","باب ما جاء في المرأة السوء وأنها فتنة ومضرة على زوجها"
"423","بَابٌ  423  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الرَّقَاشِيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  سَمِعْتُ  أَبِي  ،  عَنْ  أَبِي عُثْمَانَ ، يَقُولُ :  نُبِّئْتُ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَتْ عِنْدَهُ  أُمُّ سَلَمَةَ  ، فَجَاءَ  جِبْرِيلُ  - عَلَيْهِ السَّلَامُ - فَتَحَدَّثَ مَا قَضَى لَهُ ، فَلَمَّا قَامَ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  أُمَّ سَلَمَةَ  ، مَنْ هَذَا ؟  قَالَتْ :  دِحْيَةُ  ، قَالَتْ : وَلَأَيْمُ اللهِ مَا حَسِبْتُهُ إِلَّا  دِحْيَةَ  ، حَتَّى سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ بِخَبَرِ  جِبْرِيلَ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - قَالَ  مُعْتَمِرٌ  : قَالَ أَبِي  لِأَبِي عُثْمَانَ  : مِمَّنْ  سَمِعْتَهُ  ؟ قَالَ : مِنْ أُسَامَةَ  .","","Al-Mu'jam al-Kabir 423","","أسامة بن زيد بن حارثة ذو البطين عن أبو عثمان النهدي عن سليمان بن طرخان عن معتمر بن سليمان عن محمد بن عبد الله بن محمد بن عبد الملك الرقاشي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"424","424  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ         [1/171]      لَهِيعَةَ ،  عَنْ  صَالِحِ بْنِ أَبِي عَرِيبٍ ،  عَنْ  خَلَّادِ بْنِ السَّائِبِ ، قَالَ :  دَخَلْتُ عَلَى  أُسَامَةَ بْنِ زَيْدٍ فَمَدَحَنِي فِي وَجْهِي ، فَقَالَ : إِنَّهُ حَمَلَنِي أَنْ أَمْدَحَكَ فِي وَجْهِكَ أَنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا مُدِحَ الْمُؤْمِنُ فِي وَجْهِهِ رَبَا الْإِيمَانُ فِي قَلْبِهِ  .","","Al-Mu'jam al-Kabir 424","","أسامة بن زيد بن حارثة ذو البطين عن خلاد بن السائب الخزرجي عن صالح بن أبي عريب الحضرمي عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","باب"
"425","425  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  الْأَزْرَقُ بْنُ عَلِيٍّ ،  ثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  عَبْدُ الْمُنْعِمِ بْنُ نُعَيْمٍ ،  ثَنَا  الْجُرَيْرِيُّ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَشْكَرُ النَّاسِ لِلهِ أَشْكَرُهُمْ لِلنَّاسِ  .","","Al-Mu'jam al-Kabir 425","","أسامة بن زيد بن حارثة ذو البطين عن أبو عثمان النهدي عن سعيد بن إياس الجريري عن عبد المنعم بن نعيم الأسواري عن حسان بن إبراهيم الكرماني عن الأزرق بن علي بن مسلم الحنفي عن الحسين بن إسحاق التستري عن الطبراني","باب"
"426","426  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ الْأَنْمَاطِيُّ  ، حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ نَافِعٍ دَرَخْتُ ،  ثَنَا  عَلِيُّ بْنُ ثَابِتٍ ،  ثَنَا  الْوَازِعُ بْنُ نَافِعٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ قَالَ عَلَيَّ مَا لَمْ أَقُلْ  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 426","","أسامة بن زيد بن حارثة ذو البطين عن أبو سلمة بن عبد الرحمن عن الوازع بن نافع العقيلي عن علي بن ثابت الجزري عن درخت عبد الرحمن بن نافع البغدادي عن محمد بن الحسين الأنماطي عن الطبراني","باب"
"427","427  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  أَبُو مُصْعَبٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ رَوَاحَةَ ، وَأُسَامَةَ بْنِ زَيْدٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ دَارَ  حَمَلٍ  هُوَ  وَبِلَالٌ  ، فَخَرَجَ إِلَيْهِمَا بِلَالٌ  فَأَخْبَرَهُمَا  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَوَضَّأَ وَمَسَحَ عَلَى الْخُفَّيْنِ  .","","Al-Mu'jam al-Kabir 427","","بلال بن رباح سابق الحبشة عن عبد الله بن رواحة بن ثعلبة الخزرجي عن عطاء بن يسار الهلالي عن زيد بن أسلم عن عبد الرحمن بن زيد بن أسلم عن أحمد بن أبي بكر العوفى عن موسى بن هارون الحمال عن الطبراني","باب"
"428","بَابٌ فِي الصَّرْفِ  428  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  عَامِرٍ         [1/172]      الْأَحْوَلِ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّمَا الرِّبَا فِي  النَّسِيئَةِ  .","","Al-Mu'jam al-Kabir 428","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن عطاء بن أبي رباح عن عامر بن عبد الواحد الأحول عن عبد الوارث بن سعيد بن ذكوان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب في الصرف"
"429","429  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  الْفَضْلُ بْنُ مُوسَى ،  عَنْ  مُغِيرَةَ بْنِ زِيَادٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا رِبَا إِلَّا فِي  النَّسِيئَةِ  .","","Al-Mu'jam al-Kabir 429","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن عطاء بن أبي رباح عن المغيرة بن زياد البجلي عن الفضل بن موسى السيناني عن زكريا بن يحيى زحمويه عن عبد الله بن أحمد بن حنبل عن الطبراني","باب في الصرف"
"430","430  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْحَسَنِ بْنِ أَحْمَدَ بْنِ أَبِي شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابَلُتِّيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  عَطَاءُ بْنُ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُ -  حَدَّثَنِي  أُسَامَةُ بْنُ زَيْدٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّمَا الرِّبَا فِي  النَّسِيئَةِ  .","","Al-Mu'jam al-Kabir 430","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن عطاء بن أبي رباح عن أبو عمرو الأوزاعي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","باب في الصرف"
"431","431  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُعَاذٍ الشَّعِيرِيُّ الْبَغْدَادِيُّ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ ثَابِتٍ الْعَبْدِيُّ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ قُرَيْرٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا رِبَا إِلَّا فِي  النَّسِيئَةِ  .","","Al-Mu'jam al-Kabir 431","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن عطاء بن أبي رباح عن عبد العزيز بن قرير العبدي عن محمد بن ثابت العبدي عن عبيد الله بن عمر القواريري عن محمد بن معاذ الشعيري عن الطبراني","باب في الصرف"
"432","432  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ الْبَحْرَانِيُّ ،  ثَنَا  هَارُونُ بْنُ إِسْمَاعِيلَ الْخَزَّازُ ،  ثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا رِبَا إِلَّا فِي  النَّسِيئَةِ  .","","Al-Mu'jam al-Kabir 432","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن عطاء بن أبي رباح عن يحيى بن أبي كثير عن علي بن المبارك الهنائي عن هارون بن إسماعيل الخزاز عن محمد بن معمر بن ربعي البحراني عن أحمد بن يحيى بن زهير التستري عن الطبراني","باب في الصرف"
"433","433  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ  ، ثَنَا  مُحَمَّدُ بْنُ مَنْصُورٍ الطُّوسِيُّ ،  ثَنَا  أَبُو الْمُنْذِرِ إِسْمَاعِيلُ بْنُ عُمَرَ ،  ثَنَا  سُلَيْمَانُ الْقَافْلَانِيُّ ،  عَنْ  مَنْصُورِ بْنِ زَاذَانَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا رِبَا إِلَّا فِي  النَّسِيئَةِ  .","","Al-Mu'jam al-Kabir 433","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن عطاء بن أبي رباح عن منصور بن زاذان الثقفي عن سليمان بن أبي سليمان القافلاني عن إسماعيل بن عمر الواسطي عن محمد بن منصور الطوسي عن أحمد بن يحيى بن زهير التستري عن الطبراني","باب في الصرف"
"434","434  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ  ، ثَنَا  أَبُو الْخَطَّابِ زِيَادُ بْنُ يَحْيَى ،  ثَنَا  سَهْلُ بْنُ حَمَّادٍ أَبُو عَتَّابٍ الدَّلَّالُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  ثَنَا  كَثِيرُ بْنُ شِنْظِيرٍ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّمَا الرِّبَا فِي  النَّسِيئَةِ  .","","Al-Mu'jam al-Kabir 434","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن عطاء بن أبي رباح عن كثير بن شنظير المازني عن سعيد بن أبي عروبة عن سهل بن حماد الدلال عن زياد بن يحيى الحساني عن أحمد بن يحيى بن زهير التستري عن الطبراني","باب في الصرف"
"435","435  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ، (  ح  )         [1/173]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ ،  ثَنَا  يَحْيَى بْنُ قَيْسٍ الْمَازِنِيُّ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَيْسَ الرِّبَا إِلَّا فِي  النَّسِيئَةِ  أَوِ النَّظِرَةِ  .","","Al-Mu'jam al-Kabir 435","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن عطاء بن أبي رباح عن يحيى بن قيس السبئي عن محمد بن بكر بن عثمان البرساني عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","باب في الصرف"
"436","436  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  أَبُو عَاصِمٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَبْدِ الْمَلِكِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا رِبَا إِلَّا فِي الدَّيْنِ  .","","Al-Mu'jam al-Kabir 436","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن سعيد بن جبير الأسدي عن إسماعيل بن عبد الملك بن أبي الصفير الأسدي عن أبو عاصم النبيل عن أبو مسلم الكجي عن الطبراني","باب في الصرف"
"437","437  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُوسَى بْنُ دَاوُدَ الضَّبِّيُّ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ سَعِيدٍ أَبُو عَمْرٍو الضَّرِيرُ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ ، قَالَا :  ثَنَا  أَبُو إِسْرَائِيلَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ، قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ : إِنَّ أُسَامَةَ بْنَ زَيْدٍ  حَدَّثَنِي  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا رِبَا إِلَّا فِي الدَّيْنِ  .","","Al-Mu'jam al-Kabir 437","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن حبيب بن أبي ثابت الكاهلي عن إسماعيل بن خليفة الملائي عن أحمد بن عبد الله اليربوعي عن محمد بن عثمان بن سعيد الضرير عن الطبراني","باب في الصرف"
"438","438  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  الْقَاسِمُ بْنُ عِيسَى الطَّائِيُّ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  إِسْمَاعِيلَ بْنِ سَالِمٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي صَالِحٍ ذَكْوَانَ ،  أَنَّهُ  سَأَلَ  ابْنَ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - عَنْ بَيْعِ الذَّهَبِ بِالْفِضَّةِ ، فَقَالَ : "" هُوَ حَلَالٌ بِزِيَادَةٍ أَوْ نُقْصَانٍ إِذَا كَانَ يَدًا بِيَدٍ  .  "" قَالَ  أَبُو صَالِحٍ  :  فَسَأَلْتُ  أَبَا سَعِيدٍ الْخُدْرِيَّ عَنْ ذَلِكَ ، فَقَالَ : "" هُوَ حَرَامٌ إِلَّا مِثْلًا بِمِثْلٍ "" فَأَخْبَرْتُ  أَبَا سَعِيدٍ  بِمَا قَالَ  ابْنُ عَبَّاسٍ  ، وَأَخْبَرْتُ  ابْنَ عَبَّاسٍ  بِمَا قَالَ  أَبُو سَعِيدٍ الْخُدْرِيُّ  ، فَالْتَقَيَا وَأَنَا مَعَهُمَا فَابْتَدَأَهُ  أَبُو سَعِيدٍ الْخُدْرِيُّ  ، فَقَالَ :  ابْنَ عَبَّاسٍ  ، مَا هَذِهِ الْفُتْيَا الَّتِي تُفْتِي بِهَا النَّاسَ فِي بَيْعِ الذَّهَبِ بِالْفِضَّةِ ، تَأْمُرَهُمْ أَنْ يَشْتَرُوهُ بِزِيَادَةٍ بِنُقْصَانٍ أَوْ زِيَادَةٍ يَدًا بِيَدٍ ، فَقَالَ ابْنُ عَبَّاسٍ : مَا أَنَا بِأَقْدَمِكُمْ صُحْبَةً لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهَذَا زَيْدُ بْنُ أَرْقَمَ ، وَالْبَرَاءُ بْنُ عَازِبٍ يَقُولَانِ : سَمِعْنَا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  .","","Al-Mu'jam al-Kabir 438","","أبو سعيد الخدري عن ذكوان السمان عن حبيب بن أبي ثابت الكاهلي عن إسماعيل بن سالم الأسدي عن هشيم بن بشير عن القاسم بن عيسى بن إبراهيم الطائي عن الحسن بن علي بن شبيب المعمري عن الطبراني","باب في الصرف"
"439","439  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ ،  ثَنَا  مُحَمَّدُ         [1/174]      بْنُ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  ذَكْوَانَ أَبِي صَالِحٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  حَدَّثَنِي  أُسَامَةُ بْنُ زَيْدٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الرِّبَا فِي  النَّسِيئَةِ  .","","Al-Mu'jam al-Kabir 439","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن ذكوان السمان عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن داود بن عمرو المسيبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب في الصرف"
"440","440  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي  ، ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ، (  ح  )  وَحَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ ، قَالَا :  ثَنَا  سُفْيَانُ ،  ثَنَا  عَمْرُو بْنُ دِينَارٍ ،  عَنْ  أَبِي صَالِحٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُ -  أَخْبَرَنِي  أُسَامَةُ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّمَا الرِّبَا فِي  النَّسِيئَةِ  .","","Al-Mu'jam al-Kabir 440","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن ذكوان السمان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","باب في الصرف"
"441","441  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  أَبِي صَالِحٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  سَمِعْتُ  أُسَامَةَ بْنَ زَيْدٍ ، يَقُولُ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا رِبَا إِلَّا  فِي الدَّيْنِ "" - أَوْ قَالَ : "" فِي  النَّسِيئَةِ  -  .","","Al-Mu'jam al-Kabir 441","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن ذكوان السمان عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","باب في الصرف"
"442","442  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي سَعِيدٍ ، قَالَ :  أَتَيْتُ  ابْنَ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُ - فَقُلْتُ : مَا الَّذِي بُلِّغَ عَنْكَ ؟ أَدْرَكْتَ مَا لَمْ نُدْرِكْ أَوْ سَمِعْتَ مَا لَمْ نَسْمَعْ ؟ قَالَ : قُلْتُ : فَمَا تَقُولُ فِي الدَّرَاهِمِ ؟ فَقَالَ :  حَدَّثَنَا  أُسَامَةُ بْنُ زَيْدٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا رِبَا فِي يَدٍ بِيَدٍ ، إِنَّمَا الرِّبَا فِي الدَّيْنِ  .","","Al-Mu'jam al-Kabir 442","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن أبو سعيد الخدري عن ذكوان السمان عن عبد العزيز بن رفيع الطائفي عن إسرائيل بن يونس بن أبي إسحاق عن يحيى بن آدم عن إسحاق ابن راهويه عن موسى بن هارون الحمال عن الطبراني","باب في الصرف"
"443","443  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، حَدَّثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي سَعِيدٍ ،  أَنَّهُ قَالَ  لِابْنِ عَبَّاسٍ  - رَضِيَ اللهُ تَعَالَى عَنْهُمَا - : أَصَحِبْتَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَا لَمْ أَصْحَبْهُ ؟ أَنَا سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الذَّهَبُ بِالذَّهَبِ مِثْلًا بِمِثْلٍ ، وَالْفِضَّةُ بِالْفِضَّةِ مِثْلًا بِمِثْلٍ  فَقَالَ ابْنُ عَبَّاسٍ ،  حَدَّثَنِي  أُسَامَةُ : "" أَنَّ ذَلِكَ كَانَ نَسَأً  .","","Al-Mu'jam al-Kabir 443","","أبو سعيد الخدري عن ذكوان السمان عن عبد العزيز بن رفيع الطائفي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب في الصرف"
"444","444  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدِ بْنِ حَرْبٍ الْعَبَّادَانِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،         [1/175]      أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا رِبَا إِلَّا فِي  النَّسِيئَةِ  .","","Al-Mu'jam al-Kabir 444","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن حماد بن زيد عن سليمان بن حرب الواشحي عن جعفر بن محمد بن حرب العباداني عن الطبراني","باب في الصرف"
"445","445  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ ، (  ح  )  وَثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ ، وَمُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ، وَنَصْرُ بْنُ عَلِيٍّ ، قَالُوا :  ثَنَا  سُفْيَانُ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ يَزِيدَ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَخْبَرَنِي  أُسَامَةُ بْنُ زَيْدٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّمَا الرِّبَا فِي  النَّسِيئَةِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عبيد الله بن أبي يزيد ) وينظر مصادر التخريج","","Al-Mu'jam al-Kabir 445","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن سفيان بن عيينة عن نصر بن علي بن نصر الجهضمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","باب في الصرف"
"446","446  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ  ، ثَنَا  أَبُو عُبَيْدَةَ بْنُ فُضَيْلِ بْنِ عِيَاضٍ ،  حَدَّثَنِي  مَالِكُ بْنُ سُعَيْرٍ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ  ، ثَنَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ ،  ثَنَا  أَبُو عَاصِمٍ ، جَمِيعًا  عَنْ  عُثْمَانَ بْنِ الْأَسْوَدِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا رِبَا إِلَّا فِي  النَّسِيئَةِ  .","","Al-Mu'jam al-Kabir 446","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن ابن أبي مليكة عن عثمان بن الأسود الجمحي عن أبو عاصم النبيل عن الفلاس عن محمد بن يحيى بن مندة عن الطبراني","باب في الصرف"
"447","447  -  حَدَّثَنَا  الْقَاسِمُ بْنُ عَبْدِ الْوَارِثِ الْبَغْدَادِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا رِبَا إِلَّا فِي  النَّسِيئَةِ  .","","Al-Mu'jam al-Kabir 447","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن قيس بن الربيع الأسدي عن محمد بن بكار الرصافي عن القاسم بن عبد الوارث الوراق عن الطبراني","باب في الصرف"
"448","448  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْحُسَيْنِ الْمِصِّيصِيُّ  ، ثَنَا  يَحْيَى بْنُ إِسْحَاقَ السَّيْلَحِينِيُّ ، (  ح  )  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  سَهْلُ بْنُ بَكَّارٍ ، قَالَا :  ثَنَا  وُهَيْبٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا رِبَا فِيمَا كَانَ يَدًا بِيَدٍ  .","","Al-Mu'jam al-Kabir 448","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن يحيى بن إسحاق السيلحيني عن عبد الله بن الحسين بن جابر المصيصي عن الطبراني","باب في الصرف"
"449","449  -  ثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّمَا الرِّبَا فِي  النَّسِيئَةِ  .","","Al-Mu'jam al-Kabir 449","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن عكرمة مولى ابن عباس عن خالد الحذاء عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن الحسين بن إسحاق التستري عن الطبراني","باب في الصرف"
"450","450  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  أَحْمَدُ بْنُ حَنْبَلٍ ،  ثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  حَدَّثَنِي  أَبِي  ،  عَنِ  ابْنِ إِسْحَاقَ ،  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ عَلِيِّ بْنِ         [1/176]      أَبِي رَافِعٍ ،  عَنْ  سَعِيدٍ الْمُسَيِّبِ ،  حَدَّثَنِي  أُسَامَةُ بْنُ زَيْدٍ ، أَنَّهُ سَمِعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا رِبَا إِلَّا فِي  النَّسِيئَةِ  .","","Al-Mu'jam al-Kabir 450","","أسامة بن زيد بن حارثة ذو البطين عن سعيد بن المسيب عن عبيد الله بن علي بن أبي رافع المدني عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن أحمد بن حنبل عن موسى بن هارون الحمال عن الطبراني","باب في الصرف"
"451","451  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الشَّافِعِيُّ ،  ثَنَا  عَمِّي إِبْرَاهِيمُ بْنُ مُحَمَّدٍ ،  ثَنَا  الْحَارِثُ بْنُ عُمَيْرٍ ،  عَنْ  عُقْبَةَ ،  عَنْ  كُرَيْبٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ :  كُنْتُ رِدْفَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِعَرَفَةَ  .","","Al-Mu'jam al-Kabir 451","","أسامة بن زيد بن حارثة ذو البطين عن كريب بن أبي مسلم الحجازي عن عتبة ، ويقال عن الحارث بن عمير البصري عن إبراهيم بن محمد بن العباس المطلبي عن أحمد بن محمد ابن بنت الشافعى عن الطبراني","باب في الصرف"
"452","452  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ  ، حَدَّثَنَا  الْحُسَيْنُ بْنُ يَزِيدَ الطَّحَّانُ ،  ثَنَا  عَائِذُ بْنُ حَبِيبٍ ،  عَنْ  حَجَّاجِ بْنِ أَرْطَأَةَ ،  عَنِ  الْحَكَمِ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ :  كُنْتُ رِدْفَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِعَرَفَةَ  .","","Al-Mu'jam al-Kabir 452","","أسامة بن زيد بن حارثة ذو البطين عن عبد الله بن عباس عن مقسم بن بجرة عن الحكم بن عتيبة الكندي عن حجاج بن أرطاة عن عائذ بن حبيب الأحول عن الحسين بن يزيد بن يحيى الطحان عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب في الصرف"
"453","بَابُ الْبَيَانِ فِي نَسْخِ ذَلِكَ وَرُجُوعِ  ابْنِ عَبَّاسٍ  عَنِ الصَّرْفِ وَنَهْيِهِ عَنْهُ رَضِيَ اللهُ عَنْهُ  453  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  عَمْرُو بْنُ دِينَارٍ ،  أَنَّهُ سَمِعَ  أَبَا الْمِنْهَالِ يَقُولُ :  بَاعَ شَرِيكٌ لِي  بِالْكُوفَةِ  دَرَاهِمَ بِدَرَاهِمَ بَيْنَهُمَا فَضْلٌ ، فَقُلْتُ : مَا أَرَى هَذَا يَصْلُحُ ، قَالَ : لَقَدْ بِعْتُهَا فِي السُّوقِ فَمَا عَابَ ذَلِكَ عَلَيَّ أَحَدٌ ، فَأَتَيْتُ الْبَرَاءَ بْنَ عَازِبٍ  فَسَأَلْتُهُ  فَقَالَ : قَدِمَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْمَدِينَةَ  وَتِجَارَتُنَا هَكَذَا ، فَقَالَ :  مَا كَانَ يَدًا بِيَدٍ فَلَا بَأْسَ بِهِ ، وَمَا كَانَ نَسِيئًا فَلَا خَيْرَ فِيهِ  وَأَتَيْتُ زَيْدَ بْنَ أَرْقَمَ ؛ فَإِنَّهُ كَانَ أَعْظَمَ تِجَارَةً مِنِّي فَأَتَيْتُهُ ،  فَذَكَرْتُ  ذَلِكَ لَهُ فَقَالَ : صَدَقَ  الْبَرَاءُ .  قَالَ  الْحُمَيْدِيُّ  : "" هَذَا  مَنْسُوخٌ  ، لَا يُؤْخَذُ بِهَذَا ""  .","","Al-Mu'jam al-Kabir 453","","زيد بن أرقم الأنصاري عن عبد الرحمن بن مطعم العنزي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","باب البيان في نسخ ذلك ورجوع ابن عباس عن الصرف ونهيه عنه رضي الله عنه"
"454","454  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  عَنْ  عَبْدِ السَّلَامِ بْنِ حَرْبٍ ،         [1/177]      عَنْ  مُغِيرَةَ يَعْنِي ابْنَ مِقْسَمٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي نُعْمٍ ،  أَنَّ أَبَا سَعِيدٍ الْخُدْرِيَّ ، لَقِيَ  ابْنَ عَبَّاسٍ  فَشَهِدَ  عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  الذَّهَبُ بِالذَّهَبِ ، وَالْفِضَّةُ بِالْفِضَّةِ مِثْلًا بِمِثْلٍ ، فَمَنْ زَادَ فَقَدْ  أَرْبَى  فَقَالَ  ابْنُ عَبَّاسٍ  : "" أَتُوبُ إِلَى اللهِ - عَزَّ وَجَلَّ - مِمَّا كُنْتُ أُفْتِي بِهِ "" ثُمَّ رَجَعَ .","","Al-Mu'jam al-Kabir 454","","أبو سعيد الخدري عن عبد الرحمن بن أبي نعم البجلي عن المغيرة بن مقسم الضبي عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب البيان في نسخ ذلك ورجوع ابن عباس عن الصرف ونهيه عنه رضي الله عنه"
"455","455  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْحَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  الرَّبِيعُ بْنُ صُبَيْحٍ ،  عَنْ  عُقْبَةَ بْنِ أَبِي ثُبَيْتٍ الرَّاسِبِيِّ ، وَغَالِبٍ الْقَطَّانِ ،  عَنْ  أَبِي الْجَوْزَاءِ ، قَالَ :  سَأَلْتُ  ابْنَ عَبَّاسٍ عَنِ الصَّرْفِ  ، عَنِ الدِّرْهَمِ بِالدِّرْهَمَيْنِ يَدًا بِيَدٍ ، قَالَ : "" لَا أَرَى بِمَا كَانَ يَدًا بِيَدٍ بَأْسًا "" ثُمَّ قَدِمْتُ  مَكَّةَ  مِنَ الْعَامِ الْمُقْبِلِ وَقَدْ "" نَهَى عَنْهُ  ""  .","","Al-Mu'jam al-Kabir 455","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن غالب بن خطاف القطان عن الربيع بن صبيح عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب البيان في نسخ ذلك ورجوع ابن عباس عن الصرف ونهيه عنه رضي الله عنه"
"456","456  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  ثَنَا  الْمُثَنَّى بْنُ سَعِيدٍ ،  ثَنَا  أَبُو الشَّعْثَاءِ ، قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ ، يَقُولُ :  اللَّهُمَّ إِنِّي أَتُوبُ إِلَيْكَ مِنَ الصَّرْفِ  ، إِنَّمَا هَذَا مِنْ رَأْيِي وَهَذَا  أَبُو سَعِيدٍ الْخُدْرِيُّ  يَرْوِيهِ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - ""  .","","Al-Mu'jam al-Kabir 456","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن المثنى بن سعد الطائي عن حماد بن زيد عن سليمان بن داود العتكي عن موسى بن هارون الحمال عن الطبراني","باب البيان في نسخ ذلك ورجوع ابن عباس عن الصرف ونهيه عنه رضي الله عنه"
"457","457  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ثَنَا  عِيسَى بْنُ يُونُسَ ،  حَدَّثَنَا  أَبُو غِفَارٍ الْمُثَنَّى بْنُ سَعِيدٍ ، قَالَ :  سَمِعْتُ  أَبَا الشَّعْثَاءِ ، يَقُولُ :  سَمِعْتُ  ابْنَ عَبَّاسٍ ، يَقُولُ :  أَسْتَغْفِرُ اللهَ وَأَتُوبُ إِلَيْهِ مِنَ الصَّرْفِ  ""  .","","Al-Mu'jam al-Kabir 457","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن المثنى بن سعد الطائي عن عيسى بن يونس بن أبي إسحاق عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","باب البيان في نسخ ذلك ورجوع ابن عباس عن الصرف ونهيه عنه رضي الله عنه"
"458","458  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  فُضَيْلُ بْنُ مَرْزُوقٍ ،  عَنْ  عَطِيَّةَ ، قَالَ :  قَالَ أَبُو سَعِيدٍ  لِابْنِ عَبَّاسٍ  رَحِمَهُ اللهُ : تُبْ إِلَى اللهِ - عَزَّ وَجَلَّ - ، فَقَالَ : أَسْتَغْفِرُ اللهَ وَأَتُوبُ إِلَيْهِ ، قَالَ :  أَلَمْ تَعْلَمْ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَهَى عَنِ الذَّهَبِ بِالذَّهَبِ ، وَالْفِضَّةِ بِالْفِضَّةِ  ، وَقَالَ : "" إِنِّي أَخَافُ عَلَيْكُمُ الرِّبَا ؟  قُلْتُ  لِعَطِيَّةَ  : مَا الرِّبَا ؟ قَالَ : "" الزِّيَادَةُ وَالْفَضْلُ بَيْنَهُمَا  ""  .","","Al-Mu'jam al-Kabir 458","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب البيان في نسخ ذلك ورجوع ابن عباس عن الصرف ونهيه عنه رضي الله عنه"
"459","459  -  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  طَالُوتُ بْنُ عَبَّادٍ الصَّيْرَفِيُّ ، قَالَا :  ثَنَا  سَالِمُ بْنُ عَبْدِ اللهِ أَبُو غِيَاثٍ الْعَتَكِيُّ ، قَالَ :  سَمِعْتُ  بَكْرَ بْنَ عَبْدِ اللهِ الْمُزَنِيَّ ، يُحَدِّثُ  أَنَّ  ابْنَ عَبَّاسٍ  جَاءَ مِنَ  الْمَدِينَةِ  إِلَى  مَكَّةَ  وَجِئْتُ مَعَهُ فَحَمِدَ اللهَ - عَزَّ وَجَلَّ - وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ : أَيُّهَا النَّاسُ إِنَّهُ لَا بَأْسَ بِالصَّرْفِ مَا كَانَ مِنْهُ يَدًا بِيَدٍ ، إِنَّمَا الرِّبَا فِي  النَّسِيئَةِ ،  فَطَارَتْ كَلِمَةٌ فِي أَهْلِ الْمَشْرِقِ وَالْمَغْرِبِ ، حَتَّى إِذَا انْقَضَى         [1/178]      الْمَوْسِمُ دَخَلَ عَلَيْهِ أَبُو سَعِيدٍ الْخُدْرِيُّ  فَقَالَ  : يَا  ابْنَ عَبَّاسٍ  ، أَكَلْتَ الرِّبَا وَأَطْعَمْتَهُ ؟ قَالَ : أَوَفَعَلْتُ ؟ قَالَ : نَعَمْ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الذَّهَبُ بِالذَّهَبِ وَزْنًا بِوَزْنٍ مِثْلًا بِمِثْلٍ  تِبْرُهُ  وَعَيْنُهُ ، فَمَنْ زَادَ أَوِ اسْتَزَادَ فَقَدْ أَرْبَا  ، وَالْفِضَّةُ بِالْفِضَّةِ وَزْنًا بِوَزْنٍ مِثْلًا بِمِثْلٍ  تِبْرُهُ  وَعَيْنُهُ ، فَمَنْ زَادَ أَوِ اسْتَزَادَ فَقَدْ أَرْبَا ، وَالشَّعِيرُ بِالشَّعِيرِ ، وَالتَّمْرُ بِالتَّمْرِ ، وَالْمِلْحُ بِالْمِلْحِ مِثْلًا بِمِثْلٍ فَمَنْ زَادَ أَوِ اسْتَزَادَ فَقَدْ أَرْبَا "" حَتَّى إِذَا كَانَ الْعَامُ الْمُقْبِلُ جَاءَ ابْنُ عَبَّاسٍ وَجِئْتُ مَعَهُ ، فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ، ثُمَّ  قَالَ  : يَا أَيُّهَا النَّاسُ إِنِّي تَكَلَّمْتُ عَامَ أَوَّلَ بِكَلِمَةٍ مِنْ رَأْيِي ، وَإِنِّي أَسْتَغْفِرُ اللهَ مِنْهُ وَأَتُوبُ إِلَيْهِ ، إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : "" الذَّهَبُ بِالذَّهَبِ وَزْنًا بِوَزْنٍ مِثْلًا بِمِثْلٍ  تِبْرُهُ  وَعَيْنُهُ فَمَنْ زَادَ وَاسْتَزَادَ فَقَدْ أَرْبَا "" وَأَعَادَ عَلَيْهِمْ هَذِهِ الْأَنْوَاعَ السِّتَّةَ  .","","Al-Mu'jam al-Kabir 459","","عبد الله بن عباس عن بكر بن عبد الله المزني عن سالم بن عبد الله العتكي عن طالوت بن عباد الجحدري عن عبد الله بن أحمد الجواليقي عن الطبراني","باب البيان في نسخ ذلك ورجوع ابن عباس عن الصرف ونهيه عنه رضي الله عنه"
"460","460  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ الْعَبَّاسِ الرَّازِيُّ ،  ثَنَا  عَلِيُّ بْنُ هَاشِمِ بْنِ مَرْزُوقٍ ،  ثَنَا  أَبِي  ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا ظَهَرَ الزِّنَا وَالرِّبَا فِي قَرْيَةٍ ، فَقَدْ أَحَلُّوا بِأَنْفُسِهِمْ كِتَابَ اللهِ - عَزَّ وَجَلَّ  -  .","","Al-Mu'jam al-Kabir 460","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن سماك بن حرب البكري عن عمرو بن أبي قيس عن هاشم بن مرزوق عن علي بن هاشم بن مرزوق الرازي عن الجمال الحسن بن العباس عن الطبراني","باب البيان في نسخ ذلك ورجوع ابن عباس عن الصرف ونهيه عنه رضي الله عنه"
"461","تَمَامُ حَدِيثِ  أُسَامَةَ بْنِ زَيْدٍ  461  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا جَعَلَ اللهُ مَنِيَّةَ عَبْدٍ بِأَرْضٍ إِلَّا جَعَلَ لَهُ فِيهَا حَاجَةً  .","","Al-Mu'jam al-Kabir 461","","أسامة بن زيد بن حارثة ذو البطين عن أبو المليح بن أسامة الهذلي عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","تمام حديث أسامة بن زيد"
"462","462  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  هَمَّامٌ ،         [1/179]      عَنْ  قَتَادَةَ ،  عَنْ  عَزْرَةَ ،  عَنِ  الشَّعْبِيِّ ، عَنْ أُسَامَةَ بْنِ زَيْدٍ  حَدَّثَهُ  ،  أَنَّهُ "" كَانَ رَدِيفَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمْ تَرْفَعْ رَاحِلَتُهُ رِجْلَهَا عَادِيَةً حَتَّى أَتَى  جَمْعًا  .","","Al-Mu'jam al-Kabir 462","","أسامة بن زيد بن حارثة ذو البطين عن الشعبي عن عزرة بن عبد الرحمن بن زرارة عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","تمام حديث أسامة بن زيد"
"463","12 -  وَأُسَامَةُ بْنُ شَرِيكٍ الثَّعْلَبِيُّ  مِنْ بَنِي ثَعْلَبَةَ بْنِ يَرْبُوعٍ - رَحِمَهُ اللهُ -  بَابُ مَا جَاءَ فِي التَّدَاوِي وَتَرْكِ الْغِيبَةِ وَحُسْنِ  الْخُلُقِ  .  463  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، (  ح  )  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِعَرَفَاتٍ  فَسَلَّمْتُ عَلَيْهِ ، وَكَأَنَّ عَلَى رُؤُوسِ أَصْحَابِهِ الطَّيْرَ ، فَجَاءَتْهُ الْأَعْرَابُ مِنْ هَاهُنَا وَهَاهُنَا : يَا رَسُولَ اللهِ عَلَيْنَا حَرَجٌ فِي كَذَا وَكَذَا ؟ عَلَيْنَا حَرَجٌ فِي كَذَا وَكَذَا ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عِبَادَ اللهِ ، رَفَعَ اللهُ الْحَرَجَ إِلَّا مَنِ  اقْتَرَضَ  مِنِ امْرِئٍ مُسْلِمٍ ظُلْمًا فَذَلِكَ الَّذِي حَرِجَ وَهَلَكَ  ، قَالُوا : يَا رَسُولَ اللهِ ، نَتَدَاوَى ؟ قَالَ : "" تَدَاوَوْا فَإِنَّ اللهَ - عَزَّ وَجَلَّ - لَمْ يُنْزِلْ دَاءً إِلَّا وَضَعَ لَهُ دَوَاءً إِلَّا  الْهَرَمَ  ، قَالُوا : يَا رَسُولَ اللهِ ، فَمَا خَيْرُ مَا أُعْطِيَ النَّاسُ ؟ فَقَالَ : "" إِنَّ النَّاسَ لَمْ يُعْطَوْا شَيْئًا خَيْرًا مِنْ  خُلُقٍ  حَسَنٍ  .","","Al-Mu'jam al-Kabir 463","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"464","464  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، حَدَّثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، (  ح  )  وَثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ  ، ثَنَا  سَهْلُ بْنُ بَكَّارٍ ، قَالُوا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  كُنَّا عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَاءَهُ الْأَعْرَابُ : نَاسٌ كَثِيرٌ مِنْ هَاهُنَا وَهَاهُنَا ،  فَأُسْكِتَ  النَّاسُ لَا يَتَكَلَّمُ غَيْرُهُمْ ، فَقَالُوا : يَا رَسُولَ اللهِ ، أَعَلَيْنَا حَرَجٌ فِي كَذَا ؟ فِي أَشْيَاءَ مِنْ أُمُورِ النَّاسِ لَا بَأْسَ بِهَا ،         [1/180]      فَقَالَ :  عِبَادَ اللهِ ، وَضَعَ اللهُ الْحَرَجَ إِلَّا مَنِ  اقْتَرَضَ  امْرَأً ظُلْمًا فَذَلِكَ الَّذِي حَرِجَ وَهَلَكَ  ، فَقَالُوا : يَا رَسُولَ اللهِ ، أَعَلَيْنَا حَرَجٌ أَنْ نَتَدَاوَى ؟ قَالَ : "" تَدَاوَوْا عِبَادَ اللهِ ، فَإِنَّ اللهَ - عَزَّ وَجَلَّ - لَمْ يَضَعْ دَاءً إِلَّا وَضَعَ لَهُ دَوَاءً إِلَّا  الْهَرَمَ  ، قَالُوا : يَا رَسُولَ اللهِ مَا خَيْرُ مَا أُعْطِيَ الْمَرْءُ ؟ قَالَ : ""  الْخُلُقُ  الْحَسَنُ  .","","Al-Mu'jam al-Kabir 464","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن الوضاح بن عبد الله اليشكري عن سهل بن بكار الدارمي عن محمد بن محمد بن حيان التمار عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"465","465  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ، قَالَا :  أَنَا  زَائِدَةُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  كُنْتُ عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَاءَتِ الْأَعْرَابُ فَسَأَلُوهُ :  مَا خَيْرُ مَا أُعْطِيَ النَّاسُ ؟ قَالَ :  خُلُقٌ  حَسَنٌ  ، قَالُوا : يَا رَسُولَ اللهِ أَنَتَدَاوَى ؟ قَالَ : "" نَعَمْ ، عِبَادَ اللهِ ، تَدَاوَوْا فَإِنَّ اللهَ - عَزَّ وَجَلَّ - لَمْ يَضَعْ فِي الْأَرْضِ دَاءً إِلَّا وَضَعَ لَهُ شِفَاءً غَيْرَ دَاءٍ وَاحِدٍ "" قَالُوا : وَمَا هُوَ ؟ قَالَ : ""  الْهَرَمُ  .","","Al-Mu'jam al-Kabir 465","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن زائدة بن قدامة عن عبد الله بن رجاء الغداني عن عثمان بن حفص الضبي عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"466","466  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  شَهِدْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَتَاهُ الْأَعْرَابُ ، فَقَالُوا : عَلَيْنَا حَرَجٌ فِي كَذَا ؟ عَلَيْنَا حَرَجٌ فِي كَذَا ؟ فِي أَشْيَاءَ مِنْ أُمُورِهِمْ لَا بَأْسَ بِهَا ، فَقَالَ :  عِبَادَ اللهِ ، وَضَعَ اللهُ الْحَرَجَ إِلَّا مِنْ رَجُلٍ  اقْتَرَضَ  مِنْ عِرْضِ امْرِئٍ مُسْلِمٍ ، فَذَلِكَ الَّذِي حَرِجَ وَهَلَكَ  ، قَالُوا : يَا رَسُولَ اللهِ ، أَنَتَدَاوَى ؟ قَالَ : "" نَعَمْ ، تَدَاوَوْا فَإِنَّ اللهَ - عَزَّ وَجَلَّ - لَمْ يُنْزِلْ دَاءً إِلَّا وَضَعَ لَهُ شِفَاءً غَيْرَ دَاءٍ وَاحِدٍ ، قَالُوا : يَا رَسُولَ اللهِ ، مَا خَيْرُ مَا أُعْطِيَ الْإِنْسَانُ ؟ قَالَ : ""  خُلُقٌ  حَسَنٌ  .","","Al-Mu'jam al-Kabir 466","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن عثمان بن حفص الضبي عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"467","467  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  زِيَادُ بْنُ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  كُنْتُ جَالِسًا عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَاءَتِ الْأَعْرَابُ مِنْ كُلِّ مَكَانٍ  ، فَقَالُوا : يَا رَسُولَ اللهِ ، عَلَيْنَا حَرَجٌ فِي كَذَا وَكَذَا ؟  الْحَدِيثَ .","","Al-Mu'jam al-Kabir 467","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"468","468  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  سُفْيَانُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  حَضَرْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَسُئِلَ أَيُّ الْأَعْمَالِ أَفْضَلُ ؟         [1/181]      قَالَ : "" حُسْنُ  الْخُلُقِ  .","","Al-Mu'jam al-Kabir 468","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن سفيان بن عيينة عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"469","469  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  شَهِدْتُ الْأَعْرَابَ يَسْأَلُونَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَحَرَجٌ فِي كَذَا وَكَذَا ؟ فَقَالَ لَهُمْ :  عِبَادَ اللهِ ، وَضَعَ اللهُ الْحَرَجَ إِلَّا مَنِ  اقْتَرَضَ  مِنْ عِرْضِ أَخِيهِ شَيْئًا ، فَذَلِكَ الَّذِي حَرِجَ  ، وَقَالَ : "" تَدَاوَوْا عِبَادَ اللهِ ، فَإِنَّ اللهَ لَمْ يَضَعْ دَاءً إِلَّا وَضَعَ مَعَهُ شِفَاءً إِلَّا  الْهَرَمَ  ، قَالُوا : يَا رَسُولَ اللهِ مَا خَيْرُ مَا أُعْطِيَ الْعَبْدُ قَالَ : ""  خُلُقٌ  حَسَنٌ  .","","Al-Mu'jam al-Kabir 469","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن سفيان بن عيينة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"470","470  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  قَالُوا : يَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مَا أَفْضَلُ مَا أُعْطِيَ الْمُسْلِمُ ؟ قَالَ : ""  خُلُقٌ  حَسَنٌ  .","","Al-Mu'jam al-Kabir 470","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن سفيان الثوري عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"471","471  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  عُثْمَانَ بْنِ حَكِيمٍ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  كُنَّا جُلُوسًا عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَأَنَّ عَلَى رُؤُوسِنَا الطَّيْرَ ، مَا يَتَكَلَّمُ مِنَّا مُتَكَلِّمٌ إِذْ جَاءَهُ أُنَاسٌ ، فَقَالُوا : يَا رَسُولَ اللهِ ، أَفْتِنَا فِي كَذَا ، أَفْتِنَا فِي كَذَا ، فَقَالَ :  يَا أَيُّهَا النَّاسُ وَضَعَ اللهَ الْحَرَجَ إِلَّا مَنِ  اقْتَرَضَ  مِنْ أَخِيهِ قَرْضًا فَذَلِكَ الَّذِي حَرِجَ وَهَلَكَ  قَالُوا أَفَنَتَدَاوَى يَا رَسُولَ اللهِ ؟ قَالَ : "" نَعَمْ ، إِنَّ اللهَ - عَزَّ وَجَلَّ - لَمْ يُنْزِلْ دَاءً إِلَّا أَنْزَلَ لَهُ دَوَاءً غَيْرَ دَاءٍ وَاحِدٍ "" ، قَالُوا : يَا رَسُولَ اللهِ ، وَمَا هُوَ ؟ قَالَ : ""  الْهَرَمُ  ، قَالُوا : فَمَنْ أَحَبُّ عِبَادِ اللهِ إِلَى اللهِ ؟ قَالَ : "" أَحْسَنُهُمْ  خُلُقًا  .","","Al-Mu'jam al-Kabir 471","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن عثمان بن حكيم الأحلافي عن عيسى بن يونس بن أبي إسحاق عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"472","472  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَسْبَاطُ بْنُ مُحَمَّدٍ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ، كِلَاهُمَا  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  خَرَجْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَاجًّا ، فَكَانَ النَّاسُ يَأْتُونَهُ ، فَقَالَ قَائِلٌ : يَا رَسُولَ اللهِ ، سَعَيْتُ قَبْلَ أَنْ أَطُوفَ ، أَوْ أَخَّرْتُ شَيْئًا ، فَكَانَ يَقُولُ لَهُمْ :  لَا حَرَجَ إِلَّا عَلَى رَجُلٍ         [1/182]      اقْتَرَضَ  مِنْ عِرْضِ رَجُلٍ مُسْلِمٍ وَهُوَ ظَالِمٌ ، فَذَلِكَ الَّذِي حَرِجَ وَهَلَكَ  .","","Al-Mu'jam al-Kabir 472","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن سليمان بن فيروز الشيباني عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"473","473  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَسْبَاطٌ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  سُئِلَ عَنْ رَجُلٍ حَلَقَ قَبْلَ أَنْ يَذْبَحَ ، قَالَ : "" لَا حَرَجَ فَلْيَحْلِقْ  .","","Al-Mu'jam al-Kabir 473","","أسامة بن زيد بن حارثة ذو البطين عن زياد بن علاقة الثعلبي عن سليمان بن فيروز الشيباني عن أسباط بن محمد بن ميسرة القرشي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"474","474  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ، جَمِيعًا  عَنِ  الْأَعْمَشِ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَتَاهُ نَاسٌ مِنَ الْأَعْرَابِ فَسَأَلُوهُ ، فَقَالُوا :  يَا رَسُولَ اللهِ أَنَتَدَاوَى ؟ قَالَ : "" نَعَمْ ، إِنَّ اللهَ - عَزَّ وَجَلَّ - لَمْ يُنْزِلْ دَاءً إِلَّا أَنْزَلَ لَهُ شِفَاءً  .","","Al-Mu'jam al-Kabir 474","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن الأعمش عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"475","475  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  مِسْعَرٍ ، وَلَيْثٍ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  رَجُلٍ مِنْ قَوْمِهِ يُقَالُ لَهُ : أُسَامَةُ بْنُ شَرِيكٍ قَالَ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فِي حَجَّتِهِ  مَا أَفْضَلُ مَا أُوتِيَ النَّاسُ قَالَ : ""  خُلُقٌ  حَسَنٌ  .","","Al-Mu'jam al-Kabir 475","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن ليث بن أبي سليم عن عبد الله بن إدريس الأودي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"476","476  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ ،  ثَنَا  أَبُو عَاصِمٍ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ الْأَسْلَمِيُّ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  شَهِدْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَالنَّاسُ يَسْأَلُونَهُ ، وَهَذَا يَقُولُ : حَلَقْتُ قَبْلَ أَنْ أَنْحَرَ ، وَهَذَا يَقُولُ : فَعَلْتُ كَذَا وَكَذَا قَبْلُ ، فَجَعَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا حَرَجَ لَا حَرَجَ  .","","Al-Mu'jam al-Kabir 476","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن محمد بن بشر بن بشير الأسلمي عن أبو عاصم النبيل عن الفلاس عن الحسين بن إسحاق التستري عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"477","477  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  عُمَرُ بْنُ يَحْيَى الْأُبُلِّيُّ ،  ثَنَا  حَفْصُ بْنُ جُمَيْعٍ ،  ثَنَا  سِمَاكُ بْنُ حَرْبٍ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  جَاءَتِ الْأَعْرَابُ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسْأَلُونَهُ : عَلَيْنَا حَرَجٌ فِي كَذَا ؟ فَقَالَ :  وَضَعَ اللهُ الْحَرَجَ إِلَّا رَجُلًا  اقْتَرَضَ  مِنْ عِرْضِ أَخِيهِ فَذَلِكَ الَّذِي حَرِجَ وَهَلَكَ  ، وَقَالَ : "" مَا أَنْزَلَ اللهُ مِنْ دَاءٍ إِلَّا أَنْزَلَ لَهُ شِفَاءً إِلَّا  الْهَرَمَ  .","","Al-Mu'jam al-Kabir 477","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن سماك بن حرب البكري عن حفص بن جميع العجلي عن عمر بن يحيى الأبلي عن البزار عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"478","[1/183]      478  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  وَاصِلُ بْنُ عَبْدِ الْأَعْلَى ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنِ  الْأَجْلَحِ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  جَاءَتِ الْأَعْرَابُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالُوا : يَا رَسُولَ اللهِ ،  أَيُّ النَّاسِ خَيْرٌ ؟ قَالَ : "" أَحْسَنُهُمْ  خُلُقًا  ، قَالُوا : يَا رَسُولَ اللهِ ، أَنَتَدَاوَى ؟ قَالَ : "" نَعَمْ ، تَدَاوَوْا فَإِنَّ اللهَ - عَزَّ وَجَلَّ - لَمْ يُنْزِلْ دَاءً إِلَّا أَنْزَلَ لَهُ شِفَاءً  .","","Al-Mu'jam al-Kabir 478","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن أجلح بن عبد الله الكندي عن محمد بن فضيل بن غزوان عن واصل بن عبد الأعلى الأسدي عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"479","479  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَمُحَمَّدُ بْنُ الْعَبَّاسِ الْأَصْبَهَانِيُّ الْأَخْرَمُ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ حَرْبٍ النَّسَائِيُّ  ،  ثَنَا  عُمَرُ بْنُ شَبِيبٍ الْمُسْلِيُّ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ الْمُلَائِيِّ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، فَقَالَ :  أَتَى الْأَعْرَابُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالُوا : يَا رَسُولَ اللهِ ، عَلَيْنَا حَرَجٌ فِي كَذَا ؟ عَلَيْنَا حَرَجٌ فِي كَذَا ؟ قَالَ :  لَا حَرَجَ وَضَعَ اللهُ الْحَرَجَ إِلَّا امْرَأً  اقْتَرَضَ  مِنْ عِرْضِ أَخِيهِ فَذَلِكَ الْحَرَجُ  ، قَالُوا : يَا رَسُولَ اللهِ ، أَنَتَدَاوَى ؟ قَالَ : "" تَدَاوَوْا ، فَإِنَّ اللهَ - عَزَّ وَجَلَّ - لَمْ يُنْزِلْ دَاءً إِلَّا وَقَدْ أَنْزَلَ لَهُ شِفَاءً إِلَّا  الْهَرَمَ  ، قَالُوا : يَا رَسُولَ اللهِ ، مَا خَيْرُ مَا أُعْطِيَ الْإِنْسَانُ ؟ قَالَ : ""  الْخُلُقُ  الْحَسَنُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : (النشائي ) .","","Al-Mu'jam al-Kabir 479","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن علقمة بن مرثد الحضرمي عن عمرو بن قيس الملائي عن عمر بن شبيب بن عمر المذحجي عن محمد بن حرب النشائي عن محمد بن العباس ابن الأخرم عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"480","480  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، وَأَبُو حَنِيفَةَ مُحَمَّدُ بْنُ حَنِيفَةَ الْوَاسِطِيُّ ، قَالَا :  ثَنَا  مَعْمَرُ بْنُ سَهْلٍ الْأَهْوَازِيُّ ،  حَدَّثَنَا  عَامِرُ بْنُ مُدْرِكٍ ،  ثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَوْمٌ مِنَ الْأَعْرَابِ مُتَقَلِّدِي السُّيُوفِ ، فَأَكَبُّوا عَلَيْهِ يَسْأَلُونَهُ ، فَأَشْفَقْنَا عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَدَنَوْنَا مِنْهُمْ ، قَالَ : وَسَمِعْتُهُمْ يَقُولُونَ : هَلْ عَلَيْنَا حَرَجٌ فِي كَذَا ؟ هَلْ عَلَيْنَا حَرَجٌ فِي كَذَا ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا أَيُّهَا النَّاسُ وَضَعَ اللهُ الْحَرَجَ إِلَّا رَجُلٌ  اقْتَرَضَ  مِنْ عِرْضِ أَخِيهِ مُسْلِمًا فَذَلِكَ الَّذِي حَرِجَ وَهَلَكَ  ، قَالُوا : يَا رَسُولَ اللهِ ، نَتَدَاوَى مِنْ كَذَا ؟ نَتَدَاوَى مِنْ كَذَا ؟ قَالَ : "" تَدَاوَوْا فَإِنَّ اللهَ - عَزَّ وَجَلَّ - لَمْ يُنْزِلْ دَاءً إِلَّا أَنْزَلَ لَهُ دَوَاءً إِلَّا  الْهَرَمَ  ، قَالُوا : يَا رَسُولَ اللهِ مَا خَيْرُ مَا أُعْطِيَ الْعَبْدُ الْمُسْلِمُ فِي الدُّنْيَا ؟ قَالَ : ""  الْخُلُقُ  الْحَسَنُ  .","","Al-Mu'jam al-Kabir 480","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن يحيى بن أيوب المقابري عن عامر بن مدرك بن أبي الصفيراء الحارثي عن معمر بن سهل بن معمر الأهوازي عن محمد بن حنيفة القصبى عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"481","[1/184]      481  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  أَشْعَثَ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ الثَّعْلَبِيِّ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  قَالَ  أَعْرَابِيٌّ  : يَا رَسُولَ اللهِ ،  أَخْبِرْنِي مَا لِلْمَرْءِ الْمُسْلِمِ ؟ قَالَ : ""  الْخُلُقُ  الْحَسَنُ  .","","Al-Mu'jam al-Kabir 481","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن أشعث بن سوار عن حفص بن غياث النخعي عن سهل بن عثمان العسكري عن عبد الله بن أحمد الجواليقي عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"482","482  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْجَمَّالُ  الْأَصْبَهَانِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ عَامِرِ بْنِ إِبْرَاهِيمَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  النُّعْمَانُ بْنُ عَبْدِ السَّلَامِ ،  عَنْ  مَالِكِ بْنِ مِغْوَلٍ ، وَغَيْرِ وَاحِدٍ ،  ثَنَا  زِيَادُ بْنُ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  شَهِدْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَتَاهُ نَاسٌ مِنَ الْأَعْرَابِ يَسْأَلُونَهُ عَنْ يَمِينِهِ ، وَعَنْ يَسَارِهِ : يَا رَسُولَ اللهِ ، هَلْ عَلَيْنَا حَرَجٌ فِي كَذَا وَكَذَا ؟ مَرَّتَيْنِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ - عَزَّ وَجَلَّ - وَضَعَ الْحَرَجَ إِلَّا مَنِ  اقْتَرَضَ  امْرَأً مُسْلِمًا  ظُلْمًا "" أَوْ قَالَ : "" بِظُلْمٍ  فَذَلِكَ حَرِجَ وَهَلَكَ  ، قَالُوا : يَا رَسُولَ اللهِ ، أَنَتَدَاوَى مِنْ كَذَا وَكَذَا ؟ مَرَّتَيْنِ ، قَالَ : "" نَعَمْ ، تَدَاوَوْا فَإِنَّ اللهَ - عَزَّ وَجَلَّ - لَمْ يُنْزِلْ دَاءً إِلَّا أَنْزَلَ لَهُ شِفَاءً غَيْرَ دَاءٍ وَاحِدٍ ،  الْهَرَمُ  ، قَالُوا : يَا رَسُولَ اللهِ ، مَا خَيْرُ مَا أُعْطِيَ النَّاسُ ؟ قَالَ : ""  خُلُقٌ  حَسَنٌ  .  في طبعة مكتبة ابن تيمية : (الحمال) وينظر مصادر الترجمة .","","Al-Mu'jam al-Kabir 482","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن غير واحد عن النعمان بن عبد السلام عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن أحمد بن محمد بن عبد الله الجمال عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"483","483  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  شَيْبَانُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  كُنْتُ جَالِسًا عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَاءَ الْأَعْرَابُ مِنْ كُلِّ نَحْوٍ حَتَّى كَثُرُوا عَلَيْهِ ، وَسَكَتَ النَّاسُ ، فَنَادَوْا : يَا رَسُولَ اللهِ ، أَنَتَدَاوَى ؟ قَالَ : "" نَعَمْ ،  فَإِنَّ اللهَ - عَزَّ وَجَلَّ - لَمْ يَضَعْ دَاءً إِلَّا وَضَعَ لَهُ شِفَاءً غَيْرَ وَاحِدٍ  قَالُوا : مَا هُوَ يَا رَسُولَ اللهِ ؟ قَالَ : ""  الْهَرَمُ  ، قَالُوا : يَا رَسُولَ اللهِ ، مَا خَيْرُ مَا أُعْطِيَ لِلْإِنْسَانِ ؟ قَالَ : ""  خُلُقٌ  حَسَنٌ "" ، فَنَادَوْا : يَا رَسُولَ اللهِ عَلَيْنَا حَرَجٌ فِي كَذَا وَكَذَا ؟ مِمَّا يَكُونُ مِنَ النَّاسِ ، قَالَ : "" يَا عِبَادَ اللهِ ، وَضَعَ اللهُ الْحَرَجَ إِلَّا مَنِ  اقْتَرَضَ  مِنْ عِرْضٍ امْرِئٍ فَذَلِكَ الَّذِي حَرِجَ وَهَلَكَ  .","","Al-Mu'jam al-Kabir 483","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"484","484  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  وَحَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى         [1/185]      السَّاجِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  عَمْرُو بْنُ عَاصِمٍ ،  ثَنَا  أَبُو الْعَوَّامِ عِمْرَانُ ،  ثَنَا  مُحَمَّدُ بْنُ جُحَادَةَ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فِي حَجَّةِ الْوَدَاعِ  وَهُوَ يَقُولُ :  أُمَّكَ وَأَبَاكَ ، وَأُخْتَكَ وَأَخَاكَ ، ثُمَّ أَدْنَاكَ  ، قَالَ : فَجَاءَ قَوْمٌ ، فَقَالُوا : يَا رَسُولَ اللهِ قَتَلَنَا  بَنُو يَرْبُوعٍ  ؟ فَقَالَ : "" لَا  تَجْنِي  نَفْسٌ عَلَى أُخْرَى "" ، قَالَ : ثُمَّ سَأَلَهُ  رَجُلٌ  نَسِيَ أَنْ يَرْمِيَ الْجِمَارَ ، قَالَ : "" ارْمِ وَلَا حَرَجَ "" ثُمَّ أَتَاهُ  آخَرُ  ، فَقَالَ : يَا رَسُولَ اللهِ نَسِيتُ الطَّوَافَ ، فَقَالَ : "" طُفْ وَلَا حَرَجَ "" ، ثُمَّ أَتَاهُ  آخَرُ  : حَلَقَ قَبْلَ أَنْ يَذْبَحَ ، قَالَ : "" اذْبَحْ وَلَا حَرَجَ "" ، قَالَ : فَمَا سَأَلُوهُ يَوْمَئِذٍ عَنْ شَيْءٍ إِلَّا قَالَ : "" لَا حَرَجَ وَلَا حَرَجَ "" ، ثُمَّ قَالَ : "" أَذْهَبَ اللهُ - عَزَّ وَجَلَّ - الْحَرَجَ إِلَّا رَجُلٌ  اقْتَرَضَ  مُسْلِمًا فَذَلِكَ الَّذِي حَرِجَ وَهَلَكَ ، وَقَالَ : "" مَا أَنْزَلَ اللهُ - عَزَّ وَجَلَّ - دَاءً إِلَّا أَنْزَلَ لَهُ دَوَاءً إِلَّا  الْهَرَمَ  .","","Al-Mu'jam al-Kabir 484","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن محمد بن جحادة الأودي عن عمران بن داور القطان عن عمرو بن عاصم الكلابي عن أبو موسى الزمن عن عبد الله بن أحمد بن حنبل عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"485","485  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدٍ السُّلَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ الْأَحْمَسِيُّ ،  ثَنَا  وَهْبُ بْنُ إِسْمَاعِيلَ الْأَسَدِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ قَيْسٍ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  قُطْبَةَ ، قَالَ :  كَانَ الْأَعْرَابُ إِذَا جَاؤُوا إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اغْتَنَمْنَاهُمْ لِجَفَائِهِمْ ، فَجَاؤُوا ، فَقَالُوا : يَا رَسُولَ اللهِ ، عَلَيْنَا حَرَجٌ فِي كَذَا ؟ قَالَ :  لَا حَرَجَ ، وُضِعَ الْحَرَجُ عِبَادَ اللهِ ، إِلَّا مَنِ  اقْتَرَضَ  مِنْ عِرْضِ أَخِيهِ بِظُلْمٍ فَذَلِكَ الَّذِي حَرِجَ وَهَلَكَ  ، قَالُوا : يَا رَسُولَ اللهِ ، مَا خَيْرُ مَا أُعْطِيَ الْإِنْسَانُ ؟ قَالَ : ""  خُلُقٌ  حَسَنٌ  ،  هَكَذَا رَوَاهُ  وَهْبُ بْنُ إِسْمَاعِيلَ  ، عَنْ  مُحَمَّدِ بْنِ قَيْسٍ  وَهِمَ  فِيهِ ، وَالصَّوَابُ عَنْ  أُسَامَةَ بْنِ شَرِيكٍ  .","","Al-Mu'jam al-Kabir 485","","قطبة بن مالك الذبيانى عن زياد بن علاقة الثعلبي عن محمد بن قيس الوالبي عن وهب بن إسماعيل بن محمد الأسدي عن محمد بن إسماعيل الأحمسي عن إبراهيم بن محمد السلمي عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"486","486  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنِ  الْمَسْعُودِيِّ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَإِذَا أَصْحَابُهُ كَأَنَّ عَلَى رُؤُوسِهِمُ الطَّيْرَ  .","","Al-Mu'jam al-Kabir 486","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب ما جاء في التداوي وترك الغيبة وحسن الخلق"
"487","[1/186]      بَابُ مَا جَاءَ فِي لُزُومِ الْجَمَاعَةِ وَالنَّهْيِ عَنْ مُفَارَقَتِهَا وَغَيْرِ ذَلِكَ  487  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  زَيْدِ بْنِ عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَيُّمَا رَجُلٍ خَرَجَ يُفَرِّقُ بَيْنَ أُمَّتِي فَاضْرِبُوا عُنُقَهُ  ،  هَكَذَا رَوَاهُ  زَيْدُ بْنُ عَطَاءِ بْنِ السَّائِبِ  ، عَنْ  زِيَادِ بْنِ عِلَاقَةَ  ، عَنْ  أُسَامَةَ  ، وَالصَّوَابُ عَنْ  عَرْفَجَةَ  ، وَكَذَلِكَ رَوَاهُ  مُحَمَّدُ بْنُ بِشْرٍ  ، عَنْ  مُجَالِدٍ  .","","Al-Mu'jam al-Kabir 487","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن زيد بن عطاء بن السائب الكوفي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب ما جاء في لزوم الجماعة والنهي عن مفارقتها وغير ذلك"
"488","488  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  عَنْ  مُجَالِدٍ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ فَرَّقَ بَيْنَ أُمَّتِي وَهُمْ جَمِيعٌ فَاضْرِبُوا رَأْسَهُ كَائِنًا مَنْ كَانَ  .","","Al-Mu'jam al-Kabir 488","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن مجالد بن سعيد عن محمد بن بشر بن الفرافصة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب ما جاء في لزوم الجماعة والنهي عن مفارقتها وغير ذلك"
"489","489  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ أَبِي الْمُسَاوِرِ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَدُ  اللهِ عَلَى الْجَمَاعَةِ  ، فَإِذَا شَذَّ الشَّاذُّ مِنْهُمُ اخْتَطَفَهُ الشَّيْطَانُ كَمَا  يَخْتَطِفُ  الذِّئْبُ الشَّاةَ مِنَ الْغَنَمِ  .","","Al-Mu'jam al-Kabir 489","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن عبد الأعلى بن أبي المساور الجرار عن سعيد بن سليمان سعدويه عن محمد بن الفضل بن جابر السقطى عن الطبراني","باب ما جاء في لزوم الجماعة والنهي عن مفارقتها وغير ذلك"
"490","490  -  ثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  عَبْدُ الْأَعْلَى بْنِ أَبِي الْمُسَاوِرِ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ يَوْمٍ :  وُزِنَ أَصْحَابِي اللَّيْلَةَ فَوُزِنَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - ، ثُمَّ وُزِنَ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - ، ثُمَّ وُزِنَ         [1/187]      عُثْمَانُ  - رَضِيَ اللهُ عَنْهُ  - ""  هَكَذَا رَوَاهُ  يَزِيدُ بْنُ هَارُونَ  ، وَرَوَاهُ  سَعْدَوَيْهِ  ، عَنْ  عَبْدِ الْأَعْلَى بْنِ أَبِي الْمُسَاوِرِ  ، عَنْ  زِيَادِ بْنِ عِلَاقَةَ  ، عَنْ  قُطْبَةَ بْنِ مَالِكٍ  ، عَنْ  عَرْفَجَةَ  .","","Al-Mu'jam al-Kabir 490","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن عبد الأعلى بن أبي المساور الجرار عن يزيد بن هارون عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","باب ما جاء في لزوم الجماعة والنهي عن مفارقتها وغير ذلك"
"491","491  -  ثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  عَنِ  الْمُطَّلِبِ بْنِ زِيَادٍ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  فِي  الْحَبَّةِ  السَّوْدَاءِ  شِفَاءٌ مِنْ كُلِّ دَاءٍ إِلَّا  السَّامَ  .","","Al-Mu'jam al-Kabir 491","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن المطلب بن زياد الثقفي عن سريج بن يونس المروزي عن عبد الله بن أحمد بن حنبل عن الطبراني","باب ما جاء في لزوم الجماعة والنهي عن مفارقتها وغير ذلك"
"492","492  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  سَهْلُ بْنُ زَنْجَلَةَ الرَّازِيُّ ،  ثَنَا  الصَّبَّاحُ بْنُ مُحَارِبٍ ،  عَنْ  عُمَرَ بْنِ عَبْدِ اللهِ بْنِ يَعْلَى بْنِ مُرَّةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  وَعَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ فِي الْمَسْحِ عَلَى الْخُفَّيْنِ :  لِلْمُسَافِرِ ثَلَاثَةٌ ، وَلِلْمُقِيمِ يَوْمٌ وَلَيْلَةٌ  .","","Al-Mu'jam al-Kabir 492","","يعلى بن مرة الثقفي عن عبد الله بن يعلى بن مرة الثقفي عن عمر بن عبد الله بن يعلى الثقفي عن صباح بن محارب التيمي عن سهل بن أبي سهل الأشتر عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب ما جاء في لزوم الجماعة والنهي عن مفارقتها وغير ذلك"
"493","493  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  عَلِيُّ بْنُ عَبْدِ اللهِ بْنِ صَالِحٍ الدَّهَّانُ الْكُوفِيُّ ،  ثَنَا  مُفَضَّلُ بْنُ صَالِحٍ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنْ أَحَدٍ يَدْخُلُ الْجَنَّةَ بِعَمَلٍ  ، قُلْنَا : وَلَا أَنْتَ يَا رَسُولَ اللهِ ؟ قَالَ : "" لَا وَلَا أَنَا إِلَّا أَنْ  يَتَغَمَّدَنِي  اللهُ - عَزَّ وَجَلَّ - بِرَحْمَةٍ مِنْهُ "" ، وَوَضَعَ يَدَهُ عَلَى رَأْسِهِ  .","","Al-Mu'jam al-Kabir 493","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن المفضل بن صالح النخاس عن علي بن عبد الله بن صالح الدهان الكوفي عن الحسين بن إسحاق التستري عن الطبراني","باب ما جاء في لزوم الجماعة والنهي عن مفارقتها وغير ذلك"
"494","494  -  وَبِإِسْنَادِهِ  قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنْكُمْ مِنْ أَحَدٍ إِلَّا وَمَعَهُ شَيْطَانٌ  ، قُلْنَا : وَأَنْتَ يَا رَسُولَ اللهِ ؟ قَالَ : "" وَأَنَا ، إِلَّا أَنَّ اللهَ - عَزَّ وَجَلَّ - أَعَانَنِي عَلَيْهِ  فَأَسْلَمَ  .","","Al-Mu'jam al-Kabir 494","","أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن المفضل بن صالح النخاس عن علي بن عبد الله بن صالح الدهان الكوفي عن الحسين بن إسحاق التستري عن الطبراني","باب ما جاء في لزوم الجماعة والنهي عن مفارقتها وغير ذلك"
"495","495  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مَعْمَرُ بْنُ سَهْلٍ ،  ثَنَا  عَامِرُ بْنُ         [1/188]      مُدْرِكٍ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ اللهِ ،  ثَنَا  عَلِيُّ بْنُ الْأَقْمَرِ ،  حَدَّثَنِي  أُسَامَةُ بْنُ شَرِيكٍ الثَّعْلَبِيُّ ، قَالَ :  إِنِّي لَمَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  إِذْ قُرِّبَتْ إِلَيْهِ جِنَازَةٌ لِيُصَلِّيَ عَلَيْهَا ، فَالْتَفَتَ فَبَصُرَ  بِامْرَأَةٍ  مُقْبِلَةٍ ، فَقَالَ : "" رُدُّوهَا "" فَرَدُّوهَا  مِرَارًا حَتَّى تَوَارَتْ ، فَلَمَّا رَآهَا تَوَارَتْ كَبَّرَ عَلَيْهَا  .","","Al-Mu'jam al-Kabir 495","","أسامة بن شريك الذبياني عن علي بن الأقمر عن محمد بن عبيد الله بن أبي سليمان العرزمي عن عامر بن مدرك بن أبي الصفيراء الحارثي عن معمر بن سهل بن معمر الأهوازي عن أحمد بن يحيى بن زهير التستري عن الطبراني","باب ما جاء في لزوم الجماعة والنهي عن مفارقتها وغير ذلك"
"496","13 -  أُسَامَةُ بْنُ عُمَيْرٍ - الْهُذَلِيُّ - ابْنِ عَامِرِ بْنِ الْأَشْتَرِ مِنْ هُذَيْلِ بْنِ مُدْرِكَةَ بْنِ إِلْيَاسَ بْنِ مُضَرَ ثُمَّ مِنْ بَنِي لِحْيَانَ  .  بَابُ الرُّخْصَةِ فِي إِقَامَةِ الصَّلَاةِ فِي الرَّوَاحِلِ فِي السَّفَرِ فِي الْيَوْمِ الْمَطِرِ  496  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  أَبِي الْمَلِيحِ بْنِ أُسَامَةَ ، قَالَ :  صَلَّيْنَا الْعِشَاءَ  بِالْبَصْرَةِ  وَمُطِرْنَا ، ثُمَّ جِئْتُ أَسْتَفْتِحُ ،  فَقَالَ لِي  أَبِي أُسَامَةُ : رَأَيْتُنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمُطِرْنَا فَلَمْ تَبُلَّ السَّمَاءُ أَسْفَلَ نِعَالِنَا ، فَنَادَى مُنَادِي رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  صَلُّوا فِي رِحَالِكُمْ  .","","Al-Mu'jam al-Kabir 496","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن أبو قلابة الجرمي عن خالد الحذاء عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب الرخصة في إقامة الصلاة في الرواحل في السفر في اليوم المطر"
"497","497  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ، (  ح  )  وَثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ، قَالُوا :  ثَنَا  شُعْبَةُ ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ  ، ثَنَا  أَبُو عُمَرَ الْحَوْضِيُّ ،  ثَنَا  هَمَّامٌ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، (  ح  )  وَحَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ  ، ثَنَا  الْقَاسِمُ بْنُ عِيسَى الطَّائِيُّ ،  ثَنَا  طَلْحَةُ بْنُ عَبْدِ الرَّحْمَنِ ، (  ح  )         [1/189]      وَحَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ، كُلُّهُمْ  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي يَوْمٍ مَطِيرٍ فَأَمَرَ مُنَادِيًا فَنَادَى : "" إِنَّ الصَّلَاةَ فِي  الرِّحَالِ  .","","Al-Mu'jam al-Kabir 497","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب الرخصة في إقامة الصلاة في الرواحل في السفر في اليوم المطر"
"498","498  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  سَعِيدُ بْنُ زَرْبِيٍّ ،  عَنْ  أَبِي الْمَلِيحِ الْهُذَلِيِّ ،  عَنْ  أَبِيهِ  ، قَالَ :  غَزَوْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَخَرَجْنَا إِلَى  حُنَيْنٍ  لِسَبْعَ عَشْرَةَ خَلَتْ مِنْ رَمَضَانَ  ، فَوَافَقَنَا يَوْمُ جُمُعَةٍ يَوْمٌ مَطِيرٌ ، فَأَمَرَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِلَالًا فَنَادَى فِي النَّاسِ :  إِنَّ الصَّلَاةَ فِي  الرِّحَالِ  .","","Al-Mu'jam al-Kabir 498","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن سعيد بن زربى الخزاعي عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب الرخصة في إقامة الصلاة في الرواحل في السفر في اليوم المطر"
"499","499  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ السَّرَّاجُ  ، ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  عَامِرِ بْنِ عُبَيْدَةَ الْبَاهِلِيِّ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ، قَالَ :  شَهِدْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  حُنَيْنًا  ، فَأَصَابَنَا بَغْشٌ -  يَعْنِي مَطَرًا  - فَنَادَى مُنَادِي رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ شَاءَ أَنْ يُصَلِّيَ فِي رَحْلِهِ فَلْيُصَلِّ  .","","Al-Mu'jam al-Kabir 499","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن عامر بن عبيدة الباهلي عن حماد بن أسامة القرشي عن عبد الله بن عمر مشكدانة عن محمد بن عبدوس السراج عن الطبراني","باب الرخصة في إقامة الصلاة في الرواحل في السفر في اليوم المطر"
"500","500  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  أَبِي الْمَلِيحِ  ، قَالَ :  خَرَجْتُ ذَاتَ لَيْلَةٍ مَطِيرَةٍ إِلَى الْمَسْجِدِ ، فَلَمَّا رَجَعْتُ اسْتَفْتَحْتُ ،  فَقَالَ لِي  أَبِي : لَقَدْ رَأَيْتُنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ الْحُدَيْبِيَةِ  فَأَصَابَنَا سَمَاءٌ لَمْ تَبُلَّ أَسَافِلَ نِعَالِنَا ،  فَإِذَا مُنَادِي رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَنْ صَلُّوا فِي رِحَالِكُمْ  .","","Al-Mu'jam al-Kabir 500","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن أبو قلابة الجرمي عن خالد الحذاء عن إسماعيل ابن علية عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب الرخصة في إقامة الصلاة في الرواحل في السفر في اليوم المطر"
"501","501  -  حَدَّثَنَا  عَبْدَانُ بْنُ مُحَمَّدٍ الْمَرْوَزِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ غَالِبٍ الْأَنْطَاكِيُّ ،  حَدَّثَنَا  الْحُسَيْنُ بْنُ السَّكَنِ  ،  ثَنَا  عِمْرَانُ الْقَطَّانُ ،  عَنْ  قَتَادَةَ ،  وَزِيَادِ بْنِ أَبِي الْمَلِيحِ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أُسَامَةَ بْنِ عُمَيْرٍ  ، قَالَ :  شَهِدْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي يَوْمٍ مَطِيرٍ ، يَوْمَ جُمُعَةٍ أَمَرَ مُنَادِيًا فَنَادَى :  أَنْ صَلُّوا فِي رِحَالِكُمْ  .  كذا في طبعة مكتبة ابن تيمية والنسخة الخطية ، ولعل الصواب : ( يحيى بن السكن )","","Al-Mu'jam al-Kabir 501","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن زياد بن أبي المليح الهذلي عن عمران بن داور القطان عن يحيى بن السكن البصري عن محمد بن غالب الأنطاكي عن عبدان بن محمد الجنوجردى عن الطبراني","باب الرخصة في إقامة الصلاة في الرواحل في السفر في اليوم المطر"
"502","[1/190]      بَابٌ فِي تَجَاوُزِ اللهِ لِعَبْدِهِ الْمُؤْمِنِ بِصَلَاةِ الْمُسْلِمِينَ عَلَيْهِ وَعَفْوِهِ عَنْهُ فِيمَا بَيْنَهُ وَبَيْنَهُ  502  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عُمَرَ الْوَكِيعِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  ثَنَا  سَوَادُ بْنُ أَبِي الْأَسْوَدِ ،  ثَنَا  صَالِحُ بْنُ هِلَالٍ ،  عَنْ  أَبِي الْمَلِيحِ بْنِ أُسَامَةَ الْهُذَلِيِّ ،  حَدَّثَنِي  أَبِي  - رَضِيَ اللهُ عَنْهُ - ، عَنْ نَبِيِّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا شَهِدَتْ أُمَّةٌ مِنَ الْأُمَمِ وَهُمْ أَرْبَعُونَ فَصَاعِدًا  أَجَازَ اللهُ شَهَادَتَهُمْ - أَوْ قَالَ : صَدَّقَ شَهَادَتَهُمْ  - "" .","","Al-Mu'jam al-Kabir 502","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن صالح بن هلال عن سوادة بن أبي الأسود القطان عن إبراهيم بن الحجاج السامي عن إبراهيم بن أحمد بن عمر الوكيعي عن الطبراني","باب في تجاوز الله لعبده المؤمن بصلاة المسلمين عليه وعفوه عنه فيما بينه وبينه"
"503","503  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  خَلَفُ بْنُ سَالِمٍ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  ثَنَا  شُعْبَةُ ،  ثَنَا  مُبَشِّرُ بْنُ أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا مِنْ رَجُلٍ يُصَلِّي عَلَيْهِ مِائَةٌ إِلَّا غُفِرَ لَهُ  .","","Al-Mu'jam al-Kabir 503","","عبد الله بن عمر بن الخطاب عن أبو المليح بن أسامة الهذلي عن مبشر بن أبي المليح الهذلي عن شعبة بن الحجاج عن يحيى القطان عن خلف بن سالم المخرمي عن الحسن بن علي بن شبيب المعمري عن الطبراني","باب في تجاوز الله لعبده المؤمن بصلاة المسلمين عليه وعفوه عنه فيما بينه وبينه"
"504","بَابٌ  504  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُبَارَكِ الْعَيْشِيُّ ، (  ح  )  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  مُوسَى بْنُ حَيَّانَ الْبَصْرِيُّ ،  حَدَّثَنَا  أَبُو قُتَيْبَةَ ،  ثَنَا  الْمُفَضَّلُ بْنُ فَضَالَةَ ،  عَنْ  سَالِمِ بْنِ عُبَيْدِ اللهِ بْنِ سَالِمٍ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  صُومُوا مِنْ  وَضَحٍ  إِلَى  وَضَحٍ  .","","Al-Mu'jam al-Kabir 504","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن سالم بن سالم أبو حاتم عن المفضل بن فضالة بن أبي أمية العمري عن سلم بن قتيبة الشعيري عن موسى بن محمد بن سعيد البصري عن إبراهيم بن هاشم البغوي عن الطبراني","باب"
"505","[1/191]      505  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ، (  ح  )  وَحَدَّثَنَا  أَبُو زَيْدٍ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ، (  ح  )  وَحَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَبَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَقْبَلُ اللهُ صَلَاةً بِغَيْرِ  طُهُورٍ ،  وَلَا صَدَقَةً مِنْ غُلُولٍ  .","","Al-Mu'jam al-Kabir 505","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن قتادة بن دعامة عن شعبة بن الحجاج عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","باب"
"506","506  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  أَبُو عُمَرَ الضَّرِيرُ ، (  ح  )  وَثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  خَالِدُ بْنُ خِدَاشٍ ، (  ح  )  وَحَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالُوا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَقْبَلُ اللهُ صَلَاةً بِغَيْرِ  طُهُورٍ ،  وَلَا صَدَقَةً مِنْ غُلُولٍ  .","","Al-Mu'jam al-Kabir 506","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن قتادة بن دعامة عن الوضاح بن عبد الله اليشكري عن قتيبة بن سعيد عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","باب"
"507","507  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ  ، ثَنَا  أَبُو عُمَرَ الْحَوْضِيُّ ، وَهَانِي بْنُ يَحْيَى ، قَالَا :  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ،  أَنَّ  رَجُلًا  أَعْتَقَ  شِقْصًا  مِنْ مَمْلُوكٍ ، فَأَجَازَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِتْقَهُ ، وَقَالَ : "" لَيْسَ لِلهِ شَرِيكٌ  .","","Al-Mu'jam al-Kabir 507","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","باب"
"508","بَابُ مَا جَاءَ فِي النَّهْيِ فِي افْتِرَاشِ جُلُودِ  السِّبَاعِ  508  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  سَعِيدٍ ، (  ح  )  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ، وَعَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  سَعِيدٍ ، (  ح  )         [1/192]      وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ، "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ جُلُودِ  السِّبَاعِ  . زَادَ  يَزِيدُ بْنُ هَارُونَ  : "" أَنْ تُفْتَرَشَ  .","","Al-Mu'jam al-Kabir 508","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب ما جاء في النهي في افتراش جلود السباع"
"509","509  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  شُعْبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ، "" أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ تُفْتَرَشَ جُلُودُ  السِّبَاعِ  .","","Al-Mu'jam al-Kabir 509","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن قتادة بن دعامة عن شعبة بن الحجاج عن عبد الله بن المبارك عن أبو كريب محمد بن العلاء عن عبد الله بن أحمد الجواليقي عن الطبراني","باب ما جاء في النهي في افتراش جلود السباع"
"510","510  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ الْمَكِّيُّ  ، ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  يَزِيدَ الرِّشْكِ ،  عَنْ  أَبِي الْمَلِيحِ ،  أُرَاهُ  عَنْ  أَبِيهِ  ، "" أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ تُفْتَرَشَ جُلُودُ  السِّبَاعِ  .","","Al-Mu'jam al-Kabir 510","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن يزيد بن أبي يزيد الرشك عن معمر بن راشد عن عبد الرزاق الصنعاني عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","باب ما جاء في النهي في افتراش جلود السباع"
"511","511  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ  ، ثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ الصَّفَّارُ ،  ثَنَا  إِسْحَاقُ بْنُ إِدْرِيسَ ،  ثَنَا  أَبَانُ بْنُ يَزِيدَ ،  عَنْ  مَطَرٍ الْوَرَّاقِ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ، "" أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ تُفْتَرَشَ جُلُودُ  السِّبَاعِ  .","","Al-Mu'jam al-Kabir 511","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن مطر بن طهمان الوراق عن أبان بن يزيد العطار عن إسحاق بن إدريس الأسواري عن عبدة بن عبد الله بن عبدة الخزاعي عن محمد بن صالح النرسي عن الطبراني","باب ما جاء في النهي في افتراش جلود السباع"
"512","بَابٌ فِيمَا يُقَالُ عِنْدَ  الْوَسْوَسَةِ  512  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  سَعِيدُ بْنُ أَبِي الرَّبِيعِ السَّمَّانُ ،  ثَنَا  سَعِيدُ بْنُ عَنْبَسَةَ الْقَطَّانُ  ،  ثَنَا  الْمُهَاجِرُ بْنُ الْمُنِيبِ ،  عَنْ  أَبِي الْمَلِيحِ بْنِ أُسَامَةَ ،  عَنْ  أَبِيهِ  ،  أَنَّ  رَجُلًا  ، أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي أَشْكُو إِلَيْكَ  وَسْوَسَةً  أَجِدُهَا فِي صَدْرِي ، إِنِّي أَدْخُلُ فِي صَلَاتِي فَمَا أَدْرِي عَلَى  شَفْعٍ  أَنْفَتِلُ ، أَمْ عَلَى  وِتْرٍ  ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  فَإِذَا وَجَدْتَ ذَلِكَ فَارْفَعْ إِصْبَعَكَ السَّبَّابَةَ الْيُمْنَى فَاطْعَنْهُ فِي فَخِذِكَ الْيُسْرَى ، وَقُلْ : بِسْمِ اللهِ ، فَإِنَّهَا سِكِّينُ الشَّيْطَانِ  .  كذا في طبعة مكتبة ابن تيمية والنسخة الخطية وجاء في بعض الأسانيد كذلك ولعل بعض الرواة قلبه ، ولعل الصواب : ( عنبسة بن سعيد ) وينظر ترجمته في التهذيبين . والله أعلم","","Al-Mu'jam al-Kabir 512","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن مهاجر بن أبي المنيب عن عنبسة بن سعيد الواسطي عن سعيد بن أبى الربيع السمان عن عبد الله بن أحمد الجواليقي عن الطبراني","باب فيما يقال عند الوسوسة"
"513","[1/193]      بَابٌ فِي الدِّيَةِ  513  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ الْمِصْرِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  أَيُّوبَ السَّخْتِيَانِيِّ ، قَالَ :  سَمِعْتُ  أَبَا الْمَلِيحِ ،  عَنْ  أَبِيهِ  ، وَكَانَ قَدْ صَحِبَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  كَانَتْ فِيهَا امْرَأَتَانِ ضَرَبَتْ  إِحْدَاهُمَا  الْأُخْرَى  بِعَمُودٍ فَقَتَلَهَا وَقَتَلَتْ مَا فِي بَطْنِهَا "" ، فَقَضَى النَّبِيُّ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْمَرْأَةِ بِالْعَقْلِ ، وَفِي الْجَنِينِ  بِغُرَّةٍ  : عَبْدٍ ، أَوْ أَمَةٍ ، أَوْ بِفَرَسٍ ، أَوْ بَعِيرَيْنِ مِنَ الْإِبِلِ ، أَوْ كَذَا وَكَذَا مِنَ الْغَنَمِ "" ، فَقَالَ  رَجُلٌ مِنْ رَهْطِ الْقَاتِلَةِ  : كَيْفَ نَعْقِلُ يَا رَسُولَ اللهِ مَنْ لَا أَكَلَ ، وَلَا شَرِبَ ، وَلَا صَاحَ فَاسْتَهَلَّ ؟ فَمِثْلُ ذَلِكَ  يُطَلُّ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَسَجَّاعَةٌ أَنْتَ ؟ "" وَقَضَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَنَّ مِيرَاثَ الْمَرْأَةِ لِزَوْجِهَا وَوَلَدِهَا ، وَأَنَّ الْعَقْلَ عَلَى عَصَبَةِ الْقَاتِلَةِ  .","","Al-Mu'jam al-Kabir 513","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن أيوب السختياني عن سفيان بن عيينة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","باب في الدية"
"514","514  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عُثْمَانُ بْنُ سَعِيدٍ الْمُرِّيُّ ،  ثَنَا  الْمِنْهَالُ بْنُ خَلِيفَةَ ،  عَنْ  سَلَمَةَ بْنِ تَمَّامٍ ،  عَنْ  أَبِي الْمَلِيحِ الْهُذَلِيِّ ،  عَنْ  أَبِيهِ  ، قَالَ :  فِينَا رَجُلٌ يُقَالُ لَهُ :  حَمَلُ بْنُ مَالِكٍ  ، لَهُ امْرَأَتَانِ إِحْدَاهُمَا هُذَلَيَّةٌ ، وَالْأُخْرَى عَامِرَيَّةٌ ، فَضَرَبَتِ  الْهُذَلِيَّةُ  بَطْنَ  الْعَامِرِيَّةِ  بِعَمُودِ خِبَاءٍ - أَوْ  فُسْطَاطٍ  - فَأَلْقَتْ جَنِينًا مَيِّتًا ، فَانْطَلَقَ بِالضَّارِبَةِ إِلَى نَبِيِّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَعَهَا أَخٌ لَهَا يُقَالُ لَهُ :  عِمْرَانُ بْنُ عُوَيْمِرٍ  ، فَلَمَّا  قَصُّوا  عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْقِصَّةَ قَالَ : "" دُوهُ "" ، فَقَالَ  عِمْرَانُ  : يَا نَبِيَّ اللهِ ، أَنَدِي مَنْ لَا أَكَلَ ، وَلَا شَرِبَ ، وَلَا صَاحَ فَاسْتَهَلَّ ؟ مِثْلُ هَذَا  يُطَلُّ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  دَعْنِي مِنْ  رَجَزِ  الْأَعْرَابِ ، فِيهِ  غُرَّةٌ  : عَبْدٌ أَوْ أَمَةٌ ، أَوْ خَمْسُمِائَةٍ أَوْ فَرَسٌ ، أَوْ عِشْرُونَ وَمِائَةُ شَاةٍ  فَقَالَ : يَا نَبِيَّ اللهِ ، إِنَّ لَهَا ابْنَيْنِ هُمَا سَادَةُ الْحَيِّ ، وَهُمْ         [1/194]      أَحَقُّ أَنْ يَعْقِلُوا عَنْ أُمِّهِمْ ، قَالَ : "" أَنْتَ أَحَقُّ أَنْ تَعْقِلَ عَنْ أُخْتِكَ مِنْ وَلَدِهَا "" . قَالَ : مَا لِي شَيْءٌ أَعْقِلُ فِيهِ ، قَالَ : "" يَا  حَمَلُ بْنَ مَالِكٍ  - وَهُوَ يَوْمَئِذٍ عَلَى صَدَقَاتِ  هُذَيْلٍ  ، وَهُوَ زَوْجُ الْمَرْأَتَيْنِ ، وَأَبُو الْجَنِينِ الْمَقْتُولِ - اقْبِضْ مِنْ تَحْتِ يَدِكَ مِنْ صَدَقَاتِ  هُذَيْلٍ  عِشْرِينَ وَمِائَةَ شَاةٍ "" فَفَعَلَ .","","Al-Mu'jam al-Kabir 514","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن سلمة بن تمام الشقري عن المنهال بن خليفة العجلي عن عثمان بن سعيد بن مرة المكفوف عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب في الدية"
"515","515  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ شَبِيبٍ الْعَسَّالُ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  سَلَمَةُ بْنُ صَالِحٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 515","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن أبو بكر الهذلي عن سلمة بن صالح الجعفي عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","باب في الدية"
"516","بَابُ مَا جَاءَ فِي لُبْسِ الْعَمَائِمِ وَالدُّعَاءِ وَغَيْرِ ذَلِكَ  516  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، وَزَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ، وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَعَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالُوا :  ثَنَا  أَحْمَدُ بْنُ عَبْدَةَ ،  ثَنَا  مُحَمَّدُ بْنُ حُمْرَانَ ،  حَدَّثَنَا  خَالِدٌ الْحَذَّاءُ ،  عَنْ  أَبِي تَمِيمَةَ الْهُجَيْمِيِّ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ أُسَامَةَ  قَالَ :  كُنْتُ رَدِيفَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَعَثَرَ بَعِيرُنَا ، فَقُلْتُ : تَعِسَ الشَّيْطَانُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَقُلْ : تَعِسَ الشَّيْطَانُ ، فَإِنَّهُ يَعْظُمُ حَتَّى يَصِيرَ مِثْلَ الْبَيْتِ ، وَيَقُولَ : بِقُوَّتِي ، قُلْ : بِسْمِ اللهِ  ، فَإِنَّهُ يَصِيرُ مِثْلَ  الذُّبَابِ  .","","Al-Mu'jam al-Kabir 516","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن طريف بن مجالد الهجيمي عن خالد الحذاء عن محمد بن حمران القيسي عن أحمد بن عبدة الضبي عن عبد الله بن أحمد بن حنبل عن الطبراني","باب ما جاء في لبس العمائم والدعاء وغير ذلك"
"517","517  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  الْحَسَنُ بْنُ الصَّبَّاحِ الْبَزَّارُ ،  ثَنَا  أَبُو الْمُنْذِرِ إِسْمَاعِيلُ بْنُ عُمَرَ ،  ثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  حَدَّثَنِي  ابْنِي عِيسَى ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي حُمَيْدٍ ،  عَنْ  أَبِي الْمَلِيحِ بْنِ أُسَامَةَ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اعْتَمُّوا تَزْدَادُوا حِلْمًا  .","","Al-Mu'jam al-Kabir 517","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن عبيد الله بن أبي حميد الهذلي عن عيسى بن يونس بن أبي إسحاق عن يونس بن أبي إسحاق عن إسماعيل بن عمر الواسطي عن الحسن بن الصباح البزار عن عبيد العجل عن الطبراني","باب ما جاء في لبس العمائم والدعاء وغير ذلك"
"518","[1/195]      518  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،  ثَنَا  يُوسُفُ بْنُ خَالِدٍ السَّمْتِيُّ ،  ثَنَا  الصَّلْتُ بْنُ دِينَارٍ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ، قَالَ :  نَزَلَتِ الْمَلَائِكَةُ  يَوْمَ بَدْرٍ  وَعَلَيْهَا الْعَمَائِمُ  ،  وَكَانَتْ عَلَى  الزُّبَيْرِ  يَوْمَئِذٍ عِمَامَةٌ صَفْرَاءُ  "" .","","Al-Mu'jam al-Kabir 518","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن الصلت بن دينار الهنائي عن يوسف بن خالد السمتي عن فضيل بن حسين الجحدري عن عبد الله بن أحمد الجواليقي عن الطبراني","باب ما جاء في لبس العمائم والدعاء وغير ذلك"
"519","519  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ أَبِي سَمِينَةَ ،  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ عِيسَى التَّمَّارُ ،  ثَنَا  يَحْيَى بْنُ أَبِي زَكَرِيَّا ،  ثَنَا  عَبَّادُ بْنُ سَعِيدٍ ،  عَنْ  مُبَشِّرِ بْنِ أَبِي الْمَلِيحِ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ أُسَامَةَ ،  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا  يَشْكُرُ  اللهَ مَنْ لَا  يَشْكُرُ  النَّاسَ  .","","Al-Mu'jam al-Kabir 519","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن مبشر بن أبي المليح الهذلي عن عباد بن سعيد البصري عن يحيى بن أبي زكريا الغساني عن عبد الوهاب بن عيسى الواسطي عن محمد بن يحيى بن أبي سمينة التمار عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب ما جاء في لبس العمائم والدعاء وغير ذلك"
"520","520  -  حَدَّثَنَا  إِسْحَاقُ بْنُ دَاوُدَ الصَّوَّافُ التُّسْتَرِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُسْتَمِرِّ الْعُرُوقِيُّ ،  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ عِيسَى ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي زَكَرِيَّا الْغَسَّانِيُّ ،  حَدَّثَنِي  عَبَّادُ بْنُ سَعِيدٍ ،  عَنْ  مُبَشِّرِ بْنِ أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ أُسَامَةَ بْنِ عُمَيْرٍ  أَنَّهُ صَلَّى مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَكْعَتَيِ الْفَجْرِ ، فَصَلَّى قَرِيبًا مِنْهُ ،  فَصَلَّى رَكْعَتَيْنِ خَفِيفَتَيْنِ فَسَمِعْتُهُ يَقُولُ : "" اللَّهُمَّ رَبَّ  جِبْرِيلَ  ،  وَمِيكَائِيلَ  ،  وَإِسْرَافِيلَ  ،  وَمُحَمَّدٍ  أَعُوذُ بِكَ مِنَ النَّارِ  ثَلَاثَ مَرَّاتٍ  .","","Al-Mu'jam al-Kabir 520","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن مبشر بن أبي المليح الهذلي عن عباد بن سعيد البصري عن يحيى بن أبي زكريا الغساني عن عبد الوهاب بن عيسى الواسطي عن إبراهيم بن المستمر العروقي عن إسحاق بن داود الصواف التستري عن الطبراني","باب ما جاء في لبس العمائم والدعاء وغير ذلك"
"521","[1/196]      521  -  حَدَّثَنَا  أَبُو غَسَّانَ أَحْمَدُ بْنُ سَهْلٍ السُّكَّرِيُّ الْأَهْوَازِيُّ  ، ثَنَا  يَزِيدُ بْنُ حَكِيمٍ الْعَسْكَرِيُّ ،  ثَنَا  سَعِيدُ بْنُ مَسْلَمَةَ ،  عَنْ  لَيْثٍ ،  عَنْ  زِيَادِ بْنِ أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ، قَالَ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِصَاحِبِ الْبُقْعَةِ الَّتِي زِيدَتْ فِي  مَسْجِدِ الْمَدِينَةِ  ، وَكَانَ صَاحِبُهَا  رَجُلًا مِنَ الْأَنْصَارِ  ، فَقَالَ لَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَكَ بِهَا بَيْتٌ فِي الْجَنَّةِ  ، فَقَالَ : فَجَاءَ  عُثْمَانُ  فَقَالَ لَهُ : لَكَ بِهَا عَشَرَةُ آلَافٍ فَاشْتَرَاهَا مِنْهُ ، ثُمَّ جَاءَ  عُثْمَانُ  - رَضِيَ اللهُ عَنْهُ - إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، اشْتَرِ مِنِّي الْبُقْعَةَ الَّتِي اشْتَرَيْتُهَا مِنَ الْأَنْصَارِيِّ ، فَاشْتَرَاهَا مِنْهُ بِبَيْتٍ فِي الْجَنَّةِ ، فَقَالَ  عُثْمَانُ  : إِنِّي اشْتَرَيْتُهَا بِعَشَرَةِ آلَافِ دِرْهَمٍ ، فَوَضَعَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَبِنَةً ، ثُمَّ دَعَا  أَبَا بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - فَوَضَعَ لَبِنَةً ، ثُمَّ دَعَا  عُمَرَ  - رَضِيَ اللهُ عَنْهُ - فَوَضَعَ لَبِنَةً ، ثُمَّ جَاءَ  عُثْمَانُ  - رَضِيَ اللهُ عَنْهُ - فَوَضَعَ لَبِنَةً ، ثُمَّ قَالَ لِلنَّاسِ : "" ضَعُوا "" فَوَضَعُوا  .","","Al-Mu'jam al-Kabir 521","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن زياد بن أبي المليح الهذلي عن ليث بن أبي سليم عن سعيد بن مسلمة الأموي عن يزيد بن حكيم العسكري عن أحمد بن سهل بن الوليد الأهوازي عن الطبراني","باب ما جاء في لبس العمائم والدعاء وغير ذلك"
"522","522  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ نُمَيْرٍ  ، يَقُولُ : ""  اسْمُ  أَبِي الْمَلِيحِ عَامِرُ بْنُ أُسَامَةَ  "" .","","Al-Mu'jam al-Kabir 522","","","باب ما جاء في لبس العمائم والدعاء وغير ذلك"
"523","14 -  أُسَامَةُ بْنُ أَخْدَرِيٍّ  523  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مُوسَى الْحَرَشِيُّ ، قَالَا :  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  عَنْ  بَشِيرِ بْنِ مَيْمُونٍ ،  عَنْ  عَمِّهِ أُسَامَةَ بْنِ أَخْدَرِيٍّ :  أَنَّ رَجُلًا مِنْ  بَنِي شَقِرَةَ  يُقَالُ لَهُ :  أَصْرَمُ  كَانَ فِي النَّفَرِ الَّذِينَ أَتَوْا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : فَأَتَاهُ بِغُلَامٍ لَهُ حَبَشِيٍّ اشْتَرَاهُ بِتِلْكَ الْبِلَادِ ، فَقَالَ : يَا رَسُولَ اللهِ ، اشْتَرَيْتُ هَذَا فَأَحْبَبْتُ أَنْ تُسَمِّيَهُ وَتَدْعُوَ لَهُ بِالْبَرَكَةِ ، قَالَ :  مَا اسْمُكَ أَنْتَ ؟ "" قَالَ : قَالَ :  أَصْرَمُ  ، قَالَ : "" بَلْ أَنْتَ  زُرْعَةُ  "" ، قَالَ : "" فَمَا تُرِيدُهُ ؟ "" قَالَ : أُرِيدُهُ رَاعِيًا ، قَالَ : "" فَهُوَ  عَاصِمٌ  وَقَبَضَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَفَّهُ  .","","Al-Mu'jam al-Kabir 523","","أسامة بن أخدري الشقري عن بشير بن ميمون الشقرى عن بشر بن المفضل عن محمد بن موسى الحرشي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","أسامة بن أخدري"
"524","[1/197]      بَابُ مَنِ اسْمُهُ أُبَيٌّ  15 - نِسْبَةُ  أُبَيِّ بْنِ كَعْبٍ  - رَضِيَ اللهُ عَنْهُ -  524  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ،  عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ، ""  فِيمَنْ شَهِدَ  بَدْرًا  ،  أُبَيُّ بْنُ كَعْبِ بْنِ قَيْسِ بْنِ عُبَيْدِ بْنِ زَيْدِ بْنِ مُعَاوِيَةَ بْنِ عَمْرِو بْنِ مَالِكِ بْنِ النَّجَّارِ  "" .","","Al-Mu'jam al-Kabir 524","","","نسبة أبي بن كعب رضي الله عنه"
"525","صِفَةُ  أُبَيِّ بْنِ كَعْبٍ  وَكُنْيَتُهُ رَضِيَ اللهُ عَنْهُ  525  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي ،  ثَنَا  هُشَيْمٌ ،  عَنْ  يُونُسَ ، وَمُبَارَكٍ ،  عَنِ  الْحَسَنِ ،  أَنَا  عُتَيٌّ السَّعْدِيُّ ، قَالَ :  رَأَيْتُ  أُبَيَّ بْنَ كَعْبٍ - رَضِيَ اللهُ عَنْهُ - أَبْيَضَ الرَّأْسِ وَاللِّحْيَةِ مَا يَخْضِبُ  "" .","","Al-Mu'jam al-Kabir 525","","أبي بن كعب عن عتي بن ضمرة التميمي عن الحسن البصري عن مبارك بن فضالة عن هشيم بن بشير عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","صفة أبي بن كعب وكنيته رضي الله عنه"
"526","526  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  الثَّوْرِيُّ ،  عَنْ  سَعِيدٍ الْجُرَيْرِيِّ ،  عَنْ  أَبِي السَّلِيلِ ،  عَنْ  عَبْدِ اللهِ بْنِ رَبَاحٍ ،  عَنْ  أُبَيِّ بْنِ كَعْبٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لِيَهْنِكَ الْعِلْمُ  أَبَا الْمُنْذِرِ  .","","Al-Mu'jam al-Kabir 526","","أبي بن كعب عن عبد الله بن رباح الأنصاري عن ضريب بن نقير القيسي عن سعيد بن إياس الجريري عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","صفة أبي بن كعب وكنيته رضي الله عنه"
"527","527  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ بْنِ إِشْكَابَ ،  ثَنَا  مُحَمَّدُ بْنُ كُنَاسَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ، قَالَ :  كَانَتْ فِي أُبَيٍّ شَرَاسَةٌ  "" .","","Al-Mu'jam al-Kabir 527","","أبي بن كعب عن زر بن حبيش الثعلبي عن إسماعيل بن أبي خالد عن ابن كناسة عن محمد بن الحسين بن إبراهيم العامري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","صفة أبي بن كعب وكنيته رضي الله عنه"
"528","528  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو غَسَّانَ ،  ثَنَا  الْحَسَنُ بْنُ صَالِحٍ ،  عَنْ  مُطَرِّفٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ، قَالَ :  كَانَ أَصْحَابُ الْقَضَاءِ مِنْ أَصْحَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سِتَّةٌ : عُمَرُ ، وَعَلِيٌّ ،  وَعَبْدُ اللهِ ، وَأُبَيٌّ ، وَزَيْدٌ ، وَأَبُو مُوسَى  "" .","","Al-Mu'jam al-Kabir 528","","أبو موسى الأشعري عن مسروق بن الأجدع عن الشعبي عن مطرف بن طريف عن الحسن بن صالح بن صالح بن حي عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","صفة أبي بن كعب وكنيته رضي الله عنه"
"529","[1/198]      سِنُّ  أُبَيِّ بْنِ كَعْبٍ  وَوَفَاتُهُ رَضِيَ اللهُ عَنْهُ  529  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، حَدَّثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ، قَالَ : ""  تُوُفِّيَ  أُبَيُّ بْنُ كَعْبٍ - رَضِيَ اللهُ عَنْهُ - يُكَنَّى أَبَا الْمُنْذِرِ  بِالْمَدِينَةِ  سَنَةَ ثِنْتَيْنِ وَعِشْرِينَ  ، وَقَائِلٌ يَقُولُ : سَنَةَ ثَلَاثِينَ فِي خِلَافَةِ  عُثْمَانَ  - رَضِيَ اللهُ عَنْهُ  - "" .","","Al-Mu'jam al-Kabir 529","","","سن أبي بن كعب ووفاته رضي الله عنه"
"530","530  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامِ بْنِ حَفْصِ بْنِ غِيَاثٍ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ  ، قَالَ : ""  مَاتَ  أُبَيُّ بْنُ كَعْبٍ  - رَضِيَ اللهُ عَنْهُ - فِي خِلَافَةِ  عُمَرَ  سَنَةَ اثْنَتَيْنِ وَعِشْرِينَ  قَالَ  ابْنُ نُمَيْرٍ  : وَيَقُولُ بَعْضُهُمْ : "" فِي خِلَافَةِ  عُثْمَانَ  - رَضِيَ اللهُ عَنْهُمْ  - "" .","","Al-Mu'jam al-Kabir 530","","","سن أبي بن كعب ووفاته رضي الله عنه"
"531","وَمِمَّا  أَسْنَدَ  أُبَيُّ بْنُ كَعْبٍ  رَضِيَ اللهُ عَنْهُ  531  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  عُتَيٍّ ،  عَنْ  أُبَيِّ بْنِ كَعْبٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ مَطْعَمَ ابْنِ آدَمَ قَدْ ضُرِبَ لِلدُّنْيَا مَثَلًا ، فَانْظُرْ مَا يَخْرُجُ مِنَ ابْنِ آدَمَ  وَإِنْ  قَزَّحَهُ  وَمَلَّحَهُ قَدْ عَلِمَ إِلَى مَا يَصِيرُ  .","","Al-Mu'jam al-Kabir 531","","أبي بن كعب عن عتي بن ضمرة التميمي عن الحسن البصري عن يونس بن عبيد عن سفيان الثوري عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ومما أسند أبي بن كعب رضي الله عنه"
"532","532  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عُثْمَانُ بْنُ الْهَيْثَمِ ،  ثَنَا  عَوْفٌ ،  عَنِ  الْحَسَنِ ،  عَنْ  عُتَيٍّ ،  عَنْ  أُبَيِّ بْنِ كَعْبٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         [1/199]      إِذَا رَأَيْتُمُ الرَّجُلَ  يَتَعَزَّى  بِعَزَاءِ الْجَاهِلِيَّةِ  فَأَعِضُّوهُ  وَلَا تَكْنُوا  .","","Al-Mu'jam al-Kabir 532","","أبي بن كعب عن عتي بن ضمرة التميمي عن الحسن البصري عن عوف بن أبي جميلة عن عثمان بن الهيثم بن جهم الأشج عن أبو مسلم الكجي عن الطبراني","ومما أسند أبي بن كعب رضي الله عنه"
"533","533  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ  ، عَنْ  أُبَيِّ بْنِ كَعْبٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  آخِرُ آيَةٍ نَزَلَتْ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         {      لَقَدْ جَاءَكُمْ رَسُولٌ مِنْ أَنْفُسِكُمْ         }      إِلَى آخِرِ الْآيَةِ "" .","","Al-Mu'jam al-Kabir 533","","أبي بن كعب عن عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ومما أسند أبي بن كعب رضي الله عنه"
"534","534  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، حَدَّثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  ثَنَا  أَبُو أُمَيَّةَ بْنُ يَعْلَى الثَّقَفِيُّ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  إِسْحَاقَ بْنِ يَحْيَى الْأَنْصَارِيِّ ،  عَنْ  عُبَادَةَ بْنِ الصَّامِتِ ،  عَنْ  أُبَيِّ بْنِ كَعْبٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ سَرَّهُ أَنْ يُشْرَفَ لَهُ بُنْيَانٌ ، وَأَنْ تُرْفَعَ لَهُ دَرَجَاتٌ ، فَلْيَعْفُ عَمَّنْ ظَلَمَهُ  ، وَيُعْطِ مَنْ حَرَمَهُ ، وَيَصِلْ مَنْ قَطَعَهُ  .","","Al-Mu'jam al-Kabir 534","","أبي بن كعب عن عبادة بن الصامت عن إسحاق بن يحيى بن الوليد بن عبادة بن الصامت عن موسى بن عقبة عن إسماعيل بن يعلى الثقفي عن حجاج بن نصير الفساطيطي عن أبو مسلم الكجي عن الطبراني","ومما أسند أبي بن كعب رضي الله عنه"
"535","535  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  جَعْفَرُ بْنُ مِهْرَانَ السَّبَّاكُ ،  ثَنَا  عَبْدُ الْوَارِثِ بْنُ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنِ  الْحَكَمِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  أُبَيِّ بْنِ كَعْبٍ  أَنَّ  جِبْرِيلَ  - عَلَيْهِ السَّلَامُ - أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : وَهُوَ  بِأَضَاةِ بَنِي غِفَارٍ  فَقَالَ :  يَا  مُحَمَّدُ  ، إِنَّ اللهَ - عَزَّ وَجَلَّ - يَأْمُرُكَ أَنْ تُقْرِئَ أُمَّتَكَ الْقُرْآنَ عَلَى حَرْفٍ وَاحِدٍ  ، ثُمَّ قَالَ : عَلَى حَرْفَيْنِ حَتَّى انْتَهَى إِلَى سَبْعَةِ  أَحْرُفٍ  ، فَمَنْ قَرَأَ حَرْفًا مِنْهَا فَهُوَ كَمَا قَالَ  .","","Al-Mu'jam al-Kabir 535","","أبي بن كعب عن عبد الرحمن بن أبي ليلى عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن محمد بن جحادة الأودي عن عبد الوارث بن سعيد بن ذكوان عن جعفر بن مهران السباك عن عبد الله بن أحمد بن حنبل عن الطبراني","ومما أسند أبي بن كعب رضي الله عنه"
"536","536  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  الْحَسَنُ بْنُ قَزَعَةَ ،  ثَنَا         [1/200]      سُفْيَانُ بْنُ حَبِيبٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ ،  عَنْ  أَبِيهِ ،  عَنِ  الطُّفَيْلِ بْنِ أُبَيٍّ ،  عَنْ  أَبِيهِ  ، أَنَّهُ سَمِعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :         {      وَأَلْزَمَهُمْ كَلِمَةَ التَّقْوَى         }      ، قَالَ : "" لَا إِلَهَ إِلَّا اللهُ  .","","Al-Mu'jam al-Kabir 536","","أبي بن كعب عن الطفيل بن أبي بن كعب عن سعيد بن علاقة الهاشمي عن ثوير بن أبي فاختة مولى أم هانئ عن شعبة بن الحجاج عن سفيان بن حبيب البصري عن الحسن بن قزعة الخلقاني عن عبد الله بن أحمد بن حنبل عن الطبراني","ومما أسند أبي بن كعب رضي الله عنه"
"537","537  -  حَدَّثَنَا  عَمْرُو بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ زِبْرِيقٍ الْحِمْصِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ سَالِمٍ ،  عَنِ  الزُّبَيْدِيِّ ،  عَنِ  الزُّهْرِيِّ ،  أَخْبَرَنِي  إِسْحَاقُ ، مَوْلَى الْمُغِيرَةِ بْنِ نَوْفَلٍ ،  عَنْ  أُبَيِّ بْنِ كَعْبٍ الْأَنْصَارِيِّ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَقُومُ السَّاعَةُ حَتَّى  يَحْسِرَ  الْفُرَاتُ  عَنْ جَبَلٍ مِنْ ذَهَبٍ  ، يَقْتَتِلُ تِسْعَةُ أَعْشَارِهِمْ  .","","Al-Mu'jam al-Kabir 537","","أبي بن كعب عن إسحاق بن سالم النوفلي عن الزهري عن محمد بن الوليد بن عامر الزبيدي عن عبد الله بن سالم الوحاظي عن عمرو بن الحارث الزبيدي عن إسحاق بن إبراهيم بن العلاء عن عمرو بن إسحاق بن إبراهيم الزبيدي عن الطبراني","ومما أسند أبي بن كعب رضي الله عنه"
"538","538  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُسْلِمٍ الرَّازِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مِهْرَانَ الْجَمَّالُ ،  ثَنَا  مُبَشِّرُ بْنُ إِسْمَاعِيلَ ،  عَنْ  مُحَمَّدِ بْنِ مُطَرِّفٍ أَبِي غَسَّانَ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ ،  حَدَّثَنِي  أُبَيُّ بْنُ كَعْبٍ - رَضِيَ اللهُ عَنْهُ -  أَنَّ الْفُتْيَا الَّتِي كَانُوا يُفْتُونَ : أَنَّ الْمَاءَ مِنَ الْمَاءِ كَانَتْ رُخْصَةً تَرَخَّصَهَا رَسُولُ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي أَوَّلِ الزَّمَانِ ، ثُمَّ أُمِرْنَا بِالِاغْتِسَالِ بَعْدُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب ( عبد الرحمن بن سلم الرازي ).","","Al-Mu'jam al-Kabir 538","","أبي بن كعب عن سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن محمد بن مطرف بن داود عن مبشر بن إسماعيل الحلبي عن محمد بن مهران الجمال عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","ومما أسند أبي بن كعب رضي الله عنه"
"539","539  -  حَدَّثَنَا  أَحْمَدُ بْنُ خَلِيلٍ الْحَلَبِيُّ  ، حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ،  ثَنَا  مُعَاذُ بْنُ مُحَمَّدِ بْنِ مُعَاذِ بْنِ أُبَيِّ بْنِ كَعْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  أُبَيِّ بْنِ كَعْبٍ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  أَبَا الْمُنْذِرِ  إِنِّي أُمِرْتُ أَنْ أَعْرِضَ عَلَيْكَ الْقُرْآنَ  فَقَالَ : بِاللهِ آمَنْتُ ، وَعَلَى يَدِكَ أَسْلَمْتُ ، وَمِنْكَ تَعَلَّمْتُ قَالَ : فَرَدَّ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْقَوْلَ : يَا رَسُولَ اللهِ ، وَذُكِرْتُ هُنَاكَ ؟ قَالَ : "" نَعَمْ بِاسْمِكَ وَنَسَبِكَ فِي الْمَلَأِ الْأَعْلَى "" قَالَ : فَاقْرَأْ إِذًا يَا رَسُولَ اللهِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( أحمد بن خليد الحلبي).","","Al-Mu'jam al-Kabir 539","","أبي بن كعب عن معاذ بن أبى بن كعب الأنصاري عن محمد بن معاذ بن محمد بن أبي بن كعب الأنصاري عن معاذ بن محمد بن معاذ بن أبي بن كعب الأنصاري عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن أحمد بن خليد بن يزيد الحلبي عن الطبراني","ومما أسند أبي بن كعب رضي الله عنه"
"540","540  -  حَدَّثَنَا  أَحْمَدُ بْنُ خُلَيْدٍ الْحَلَبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ،  ثَنَا         [1/201]      مُعَاذُ بْنُ مُحَمَّدِ بْنِ مُعَاذِ بْنِ أُبَيِّ بْنِ كَعْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  أُبَيِّ بْنِ كَعْبٍ  - رَضِيَ اللهُ عَنْهُ - أَنَّهُ قَالَ :  يَا رَسُولَ اللهِ مَا جَزَاءُ الْحُمَّى ؟ قَالَ : "" تَجْرِي الْحَسَنَاتُ عَلَى صَاحِبِهَا مَا  اخْتَلَجَ  عَلَيْهِ قَدَمٌ  أَوْ ضَرَبَ عَلَيْهِ  عِرْقٌ  ""  قَالَ  أُبَيٌّ : ""  اللَّهُمَّ إِنِّي أَسْأَلُكَ حُمَّى لَا تَمْنَعُنِي خُرُوجًا فِي سَبِيلِكَ ، وَلَا خُرُوجًا إِلَى بَيْتِكَ  ، وَلَا مَسْجِدِ نَبِيِّكَ "" قَالَ : فَلَمْ يُمَسَّ  أُبَيٌّ  قَطُّ إِلَّا وَبِهِ حُمَّى  .","","Al-Mu'jam al-Kabir 540","","أبي بن كعب عن معاذ بن أبى بن كعب الأنصاري عن محمد بن معاذ بن محمد بن أبي بن كعب الأنصاري عن معاذ بن محمد بن معاذ بن أبي بن كعب الأنصاري عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن أحمد بن خليد بن يزيد الحلبي عن الطبراني","ومما أسند أبي بن كعب رضي الله عنه"
"541","541  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  ثَنَا  أَبَانُ بْنُ يَزِيدَ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنِ  الْحَضْرَمِيِّ بْنِ لَاحِقٍ ،  عَنْ  مُحَمَّدِ بْنِ أُبَيِّ بْنِ كَعْبٍ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ كَانَ لَهُ  جُرْنٌ  مِنْ تَمْرٍ ، فَكَانَ يَنْقُصُ ، فَحَرَسَهُ ذَاتَ لَيْلَةٍ ، فَإِذَا هُوَ بِدَابَّةٍ شِبْهِ الْغُلَامِ الْمُحْتَلِمِ ، فَسَلَّمَ عَلَيْهِ ،  فَرَدَّ عَلَيْهِ السَّلَامَ ، فَقَالَ : مَا أَنْتَ ، جِنِّيٌّ أَمْ إِنْسِيٌّ ؟ قَالَ : لَا ، بَلْ جِنِّيٌّ ، قَالَ : فَنَاوِلْنِي يَدَكَ ، فَنَاوَلَهُ يَدَهُ  ، فَإِذَا يَدُهُ يَدُ كَلْبٍ ، وَشَعَرُهُ شَعَرُ كَلْبٍ ، قَالَ : هَكَذَا خَلْقُ الْجِنِّ ، قَالَ : قَدْ عَلِمَتِ الْجِنُّ أَنَّ مَا فِيهِمْ رَجُلٌ أَشَدُّ مِنِّي ، قَالَ : فَمَا جَاءَ بِكَ ؟ قَالَ : بَلَغَنَا أَنَّكَ تُحِبُّ الصَّدَقَةَ ، فَجِئْنَا نُصِيبُ مِنْ طَعَامِكَ ، قَالَ : فَمَا يُنْجِينَا مِنْكُمْ ؟ قَالَ : هَذِهِ الْآيَةُ الَّتِي فِي سُورَةِ الْبَقَرَةِ :         {      اللهُ لا إِلَهَ إِلا هُوَ الْحَيُّ الْقَيُّومُ         }      . مَنْ قَالَهَا حِينَ يُمْسِي أُجِيرَ مِنَّا حَتَّى يُصْبِحَ ، وَمَنْ قَالَهَا حِينَ يُصْبِحُ أُجِيرَ مِنَّا حَتَّى يُمْسِيَ ، فَلَمَّا أَصْبَحَ أَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرَ ذَلِكَ لَهُ فَقَالَ : "" صَدَقَ الْخَبِيثُ  .","","Al-Mu'jam al-Kabir 541","","أبي بن كعب عن محمد بن أبي بن كعب الأنصاري عن حضرمي بن لاحق الأعرجي عن يحيى بن أبي كثير عن أبان بن يزيد العطار عن موسى بن إسماعيل التبوذكي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","ومما أسند أبي بن كعب رضي الله عنه"
"542","542  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَرْوَزِيُّ  ، ثَنَا  حُسَيْنُ بْنُ سَعْدِ بْنِ عَلِيِّ بْنِ الْحُسَيْنِ بْنِ وَاقِدٍ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي ،  عَنِ  الْحُسَيْنِ بْنِ وَاقِدٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُ -  عَنْ  أُبَيِّ بْنِ كَعْبٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَوْ كَانَ لِلْإِنْسَانِ وَادِيَانِ مِنَ الْمَالِ لَالْتَمَسَ الثَّالِثَ ، وَلَا يَمْلَأُ بَطْنَ الْإِنْسَانِ إِلَّا التُّرَابُ  ، ثُمَّ يَتُوبُ اللهُ - عَزَّ وَجَلَّ - عَلَى مَنْ تَابَ  .","","Al-Mu'jam al-Kabir 542","","أبي بن كعب عن عبد الله بن عباس عن الشعبي عن عطاء بن السائب عن الحسين بن واقد المروزي عن علي بن الحسين بن واقد عن أبي عن حسين بن سعد بن علي بن الحسين بن واقد عن محمد بن علي بن محمد المروزي عن الطبراني","ومما أسند أبي بن كعب رضي الله عنه"
"543","[1/202]      543  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الْعَنْبَرِيُّ ،  ثَنَا  أُمَيَّةُ بْنُ خَالِدٍ ،  ثَنَا  أَبُو الْجَارِيَةِ الْعَبْدِيُّ ،  عَنْ  شُعْبَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُبَيِّ بْنِ كَعْبٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  قَرَأَ :         {      قَدْ بَلَغْتَ مِنْ لَدُنِّي         }      مُثَقَّلَةً  .","","Al-Mu'jam al-Kabir 543","","أبي بن كعب عن عبد الله بن عباس عن سعيد بن جبير الأسدي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن أبو الجارية العبدي عن أمية بن خالد الثوباني عن محمد بن عبد الرحمن زيتونة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ومما أسند أبي بن كعب رضي الله عنه"
"544","16 -  أُبَيُّ بْنُ مَالِكٍ الْقُشَيْرِيُّ  - رَضِيَ اللهُ عَنْهُ - .  544  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ، (  ح  )  وَحَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ، قَالُوا :  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  زُرَارَةَ بْنِ أَوْفَى ،  عَنْ  أُبَيِّ بْنِ مَالِكٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ أَدْرَكَ وَالِدَيْهِ أَوْ أَحَدَهُمَا فَدَخَلَ النَّارَ  فَأَبْعَدَهُ  اللهُ  .","","Al-Mu'jam al-Kabir 544","","أبي بن مالك بن عمرو بن ربيعة الحرشي عن زرارة بن أوفى عن قتادة بن دعامة عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن عثمان بن عمر الضبي عن الطبراني","أبي بن مالك القشيري رضي الله عنه"
"545","17 -  أُبَيُّ بْنُ عُمَارَةَ الْأَنْصَارِيُّ  - رَضِيَ اللهُ عَنْهُ - .  545  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  يَحْيَى بْنُ إِسْحَاقَ السَّيْلَحِينِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ رَزِينٍ ،  عَنْ  مُحَمَّدِ بْنِ يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  أَيُّوبَ بْنِ قَطَنٍ الْكِنْدِيِّ  ، عَنِ  ابْنِ عُمَارَةَ الْأَنْصَارِيِّ ، وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : قَدْ صَلَّى فِي بَيْتِهِ الْقِبْلَتَيْنِ جَمِيعًا ، قَالَ : قُلْتُ :  يَا رَسُولَ اللهِ أَمْسَحُ عَلَى الْخُفَّيْنِ ؟ قَالَ : "" نَعَمْ يَوْمًا "" ، قُلْتُ : يَا رَسُولَ اللهِ وَيَوْمَيْنِ ؟ قَالَ : "" نَعَمْ وَثَلَاثَةً  قُلْتُ : يَا رَسُولَ اللهِ وَثَلَاثَةً ؟ قَالَ : "" نَعَمْ وَمَا شِئْتَ  .         [1/203]","","Al-Mu'jam al-Kabir 545","","أبي بن عمارة العبسى عن أيوب بن قطن الكندي عن محمد بن يزيد بن أبي زياد الفلسطيني عن عبد الرحمن بن رزين الغافقي عن يحيى بن أيوب الغافقي عن يحيى بن إسحاق السيلحيني عن بشر بن موسى بن صالح الأسدي عن الطبراني","أبي بن عمارة الأنصاري رضي الله عنه"
"546","546  -  حَدَّثَنَا  الْحَسَنُ بْنُ غُلَيْبٍ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ عُفَيْرٍ ،  ثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ رَزِينٍ ،  عَنْ  مُحَمَّدِ بْنِ يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  أَيُّوبَ بْنِ قَطَنٍ ،  عَنْ  عُبَادَةَ بْنِ نُسَيٍّ ،  عَنْ  أُبَيِّ بْنِ عُمَارَةَ الْأَنْصَارِيِّ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  صَلَّى فِي بَيْتِهِ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، أَمْسَحُ عَلَى الْخُفَّيْنِ ؟ قَالَ : "" نَعَمْ "" ، قُلْتُ : يَوْمًا ؟ قَالَ : "" نَعَمْ ، وَيَوْمَيْنِ  ، قَالَ : قُلْتُ : وَثَلَاثًا يَا رَسُولَ اللهِ ؟ قَالَ : "" نَعَمْ ، وَمَا بَدَا لَكَ  .","","Al-Mu'jam al-Kabir 546","","أبي بن عمارة العبسى عن عبادة بن نسي الأردني عن أيوب بن قطن الكندي عن محمد بن يزيد بن أبي زياد الفلسطيني عن عبد الرحمن بن رزين الغافقي عن يحيى بن أيوب الغافقي عن سعيد بن كثير بن عفير عن الحسن بن غليب المصري عن الطبراني","أبي بن عمارة الأنصاري رضي الله عنه"
"547","بَابُ مَنِ اسْمُهُ أُسَيْدٌ  18 - نِسْبَةُ  أُسَيْدِ بْنِ حُضَيْرٍ ، عَقَبِيٌّ بَدْرِيٌّ ، يُكَنَّى أَبَا عَتِيكٍ ، وَيُقَالُ : أَبُو يَحْيَى  - رَضِيَ اللهُ عَنْهُ -  547  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ، عَنْ  عُرْوَةَ  ، ""  فِيمَنْ شَهِدَ  الْعَقَبَةَ  :  أُسَيْدُ بْنُ حُضَيْرِ بْنِ سِمَاكِ بْنِ عُبَيْدِ بْنِ رَافِعِ بْنِ امْرِئِ الْقَيْسِ بْنِ زَيْدِ بْنِ عَبْدِ الْأَشْهَلِ  وَهُوَ نَقِيبٌ  ""  .","","Al-Mu'jam al-Kabir 547","","","نسبة أسيد بن حضير"
"548","548  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ، قَالَ :  تُوُفِّيَ  أُسَيْدُ بْنُ حُضَيْرٍ ، وَيُكَنَّى أَبَا يَحْيَى  سَنَةَ عِشْرِينَ ، وَحَمَلَهُ عُمَرُ - رَضِيَ اللهُ عَنْهُ  - بَيْنَ عَمُودَيِ السَّرِيرِ حَتَّى وَضَعَهُ  بِالْبَقِيعِ  وَصَلَّى عَلَيْهِ  "" .","","Al-Mu'jam al-Kabir 548","","عمر بن الخطاب عن يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","نسبة أسيد بن حضير"
"549","549  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَدِينِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ  ، عَنِ  الْوَاقِدِيِّ  ، قَالَ : ""  تُوُفِّيَ  أُسَيْدُ بْنُ حُضَيْرٍ  سَنَةَ عِشْرِينَ فِي شَعْبَانَ  "" .","","Al-Mu'jam al-Kabir 549","","","نسبة أسيد بن حضير"
"550","550  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ، عَنِ  ابْنِ شِهَابٍ  ، ""  فِي تَسْمِيَةِ مَنْ شَهِدَ  الْعَقَبَةَ  مِنَ  الْأَنْصَارِ  ، ثُمَّ مِنْ  بَنِي عَبْدِ الْأَشْهَلِ  :  أُسَيْدُ بْنُ حُضَيْرٍ  وَهُوَ نَقِيبٌ  "" .","","Al-Mu'jam al-Kabir 550","","","نسبة أسيد بن حضير"
"551","[1/204]      وَمِمَّا  أَسْنَدَ  أُسَيْدُ بْنُ حُضَيْرٍ  رَضِيَ اللهُ عَنْهُ  551  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ  ، ثَنَا  يَزِيدُ بْنُ هَارُونَ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ الْجَوْهَرِيُّ  ، ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ، قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  أُسَيْدِ بْنِ حُضَيْرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّكُمْ سَتَرَوْنَ بَعْدِي  أَثَرَةً  قَالُوا : فَمَا تَأْمُرُنَا ؟ قَالَ : "" اصْبِرُوا حَتَّى تَلْقَوْنِي عَلَى الْحَوْضِ  .","","Al-Mu'jam al-Kabir 551","","أسيد بن حضير الأشهلي عن أنس بن مالك عن قتادة بن دعامة عن شعبة بن الحجاج عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"552","552  -  حَدَّثَنَا  أَحْمَدُ بْنُ زَيْدِ بْنِ الْحَرِيشِ الْأَهْوَازِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ الْبَحْرَانِيُّ  نَا  حَرَمِيُّ بْنُ عُمَارَةَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  أُسَيْدِ بْنِ حُضَيْرٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْأَنْصَارُ  كَرِشِي  وَعَيْبَتِي  ، وَإِنَّ النَّاسَ يَكْثُرُونَ وَهُمْ يَقِلُّونَ فَاقْبَلُوا مِنْ مُحْسِنِهِمْ ، وَتَجَاوَزُوا عَنْ مُسِيئِهِمْ  .","","Al-Mu'jam al-Kabir 552","","أسيد بن حضير الأشهلي عن أنس بن مالك عن قتادة بن دعامة عن شعبة بن الحجاج عن حرمي بن عمارة العتكي عن محمد بن معمر بن ربعي البحراني عن أحمد بن زيد بن الحريش الأهوازي عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"553","553  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، (  ح  )  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  أَبُو عُمَرَ الضَّرِيرُ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  عَائِشَةَ - رَضِيَ اللهُ عَنْهَا - قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِذَا قَدِمَ مِنْ سَفَرٍ نَزَلَ  ذَا الْحُلَيْفَةَ  ،  فَخَرَجَ إِلَيْهِمُ الصِّبْيَانُ فَيُخْبِرُونَهُمْ عَنْ أَهْلِهِمْ ، فَأُخْبِرَ أُسَيْدُ بْنُ حُضَيْرٍ بِمَوْتِ امْرَأَتِهِ فَبَكَى ، فَقِيلَ لَهُ : أَتَبْكِي ؟ فَقَالَ : وَمَا لِي لَا أَبْكِي ، وَقَدْ سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ الْعَرْشَ  اهْتَزَّ  أَعْوَادُهُ لِمَوْتِ  سَعْدِ بْنِ مُعَاذٍ  .","","Al-Mu'jam al-Kabir 553","","أسيد بن حضير الأشهلي عن عائشة بنت أبي بكر الصديق عن علقمة بن وقاص العتواري عن عمرو بن علقمة بن وقاص الليثي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن حماد بن سلمة عن حفص بن عمر الضرير البصري عن أبو مسلم الكجي عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"554","553  / 2  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  عَائِشَةَ ،  عَنْ  أُسَيْدِ بْنِ حُضَيْرٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اهْتَزَّ  الْعَرْشُ  لِمَوْتِ  سَعْدِ بْنِ         [1/205]      مُعَاذٍ  .","","Al-Mu'jam al-Kabir 553","","أسيد بن حضير الأشهلي عن عائشة بنت أبي بكر الصديق عن علقمة بن وقاص العتواري عن عمرو بن علقمة بن وقاص الليثي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يزيد بن هارون عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"555","554  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ  ، حَدَّثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  يَحْيَى بْنُ أَيُّوبَ ، وَابْنُ لَهِيعَةَ قَالَا :  ثَنَا  عُمَارَةُ بْنُ غَزِيَّةَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ عَمْرِو بْنِ عُثْمَانَ ،  عَنْ  أُمِّهِ فَاطِمَةَ بِنْتِ حُسَيْنٍ -  رَضِيَ اللهُ عَنْهُ -  عَنْ  عَائِشَةَ -رَضِيَ اللهُ عَنْهَا - أَنَّهَا قَالَتْ :  كَانَ أُسَيْدُ بْنُ حُضَيْرٍ مِنْ أَفَاضِلِ النَّاسِ ، وَكَانَ يَقُولُ : "" لَوْ أَكُونُ كَمَا أَكُونُ عَلَى حَالٍ مِنْ أَحْوَالٍ ثَلَاثٍ لَكُنْتُ مِنْ أَهْلِ الْجَنَّةِ  ، وَمَا شَكَكْتُ فِي ذَلِكَ : حِينَ أَقْرَأُ الْقُرْآنَ ، أَوْ حِينَ أَسْتَمِعُهُ يُقْرَأُ ، وَإِذَا سَمِعْتُ بِخُطْبَةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَإِذَا شَهِدْتُ جِنَازَةً ، وَمَا شَهِدْتُ جِنَازَةً قَطُّ ، فَحَدَّثْتُ نَفْسِي سِوَى مَا هُوَ مَفْعُولٌ بِهَا ، وَمَا هِيَ صَائِرَةٌ إِلَيْهِ  ""  .","","Al-Mu'jam al-Kabir 554","","أسيد بن حضير الأشهلي عن عائشة بنت أبي بكر الصديق عن فاطمة بنت الحسين بن علي بن أبي طالب عن الديباج ، محمد بن عبد الله بن عمرو عن عمارة بن غزية عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"556","555  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  هَوْذَةُ بْنُ خَلِيفَةَ ،  ثَنَا  ابْنُ جُرَيْجٍ ،  حَدَّثَنِي  عِكْرِمَةُ بْنُ خَالِدٍ ، أَنَّ أُسَيْدَ بْنَ حُضَيْرِ بْنِ سِمَاكٍ  حَدَّثَهُ  ، قَالَ :  كَتَبَ  مُعَاوِيَةُ  - رَضِيَ اللهُ عَنْهُ - إِلَى  مَرْوَانَ بْنِ الْحَكَمِ  : إِذَا سُرِقَ الرَّجُلُ فَوَجَدَ سَرِقَتَهُ فَهُوَ أَحَقُّ بِهَا إِذَا وَجَدَهَا ، فَكَتَبَ إِلَيَّ  مَرْوَانُ  بِذَلِكَ ، وَأَنَا عَامِلُهُ عَلَى  الْيَمَامَةِ  ، فَكَتَبْتُ إِلَى  مَرْوَانَ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَضَى أَنْ إِذَا وُجِدَتْ عِنْدَ الرَّجُلِ غَيْرَ الْمُتَّهَمِ ، فَإِنْ شَاءَ سَيِّدُهَا أَخَذَهَا بِالثَّمَنِ ،  وَإِنْ شَاءَ اتَّبَعَ سَارِقَهُ "" ثُمَّ قَضَى بِذَلِكَ بَعْدَهُ  أَبُو بَكْرٍ  ،  وَعُمَرُ  وَعُثْمَانُ  - رَضِيَ اللهُ عَنْهُمْ - فَبَعَثَ  مَرْوَانُ  بِكِتَابِي إِلَى  مُعَاوِيَةَ  ، فَبَعَثَ  مُعَاوِيَةُ  إِلَى  مَرْوَانَ  : إِنَّكَ لَسْتَ أَنْتَ ، وَلَا  أُسَيْدٌ  يَقْضِيَانِ عَلَيَّ فِيمَا وُلِّيتُ ، وَلَكِنِّي أَقْضِي عَلَيْكُمَا ، فَأَنْفِذْ مَا أَمَرْتُكَ بِهِ ، فَبَعَثَ  مَرْوَانُ  بِكِتَابِ  مُعَاوِيَةَ  إِلَيَّ ، فَقُلْتُ : وَاللهِ لَا أَقْضِي بِهِ أَبَدًا  .  كذا في طبعة مكتبة ابن تيمية ، وصوابه : (أسيد بن ظهير) وقد أخطأ الراوي في تسميته وانظر ""التحفة"" 1/72 ، وابن حجر في ""إتحاف المهرة"" 1/370.","","Al-Mu'jam al-Kabir 555","","أسيد بن حضير الأشهلي عن عكرمة بن خالد بن العاص عن ابن جريج عن هوذة بن خليفة البكراوي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"557","556  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَمْرُو بْنُ عَوْنٍ الْوَاسِطِيُّ ،  ثَنَا  خَالِدٌ ،  عَنْ  حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  أُسَيْدِ بْنِ حُضَيْرٍ ، قَالَ :  بَيْنَمَا هُوَ عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَانَ فِيهِ مُزَاحٌ يُحَدِّثُ  الْقَوْمَ  لِيُضْحِكَهُمْ ،  فَطَعَنَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  خَاصِرَتِهِ  ، فَقَالَ :  أَصْبِرْنِي  ، فَقَالَ : "" اصْطَبِرْ  ، فَقَالَ :         [1/206]      إِنَّ عَلَيْكَ قَمِيصًا ، وَلَيْسَ عَلَيَّ قَمِيصٌ ، فَرَفَعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَمِيصَهُ فَاحْتَضَنَهُ ، وَجَعَلَ يُقَبِّلُ كَشْحَهُ ، وَيَقُولُ : إِنَّمَا أَرَدْتُ هَذَا يَا رَسُولَ اللهِ  .","","Al-Mu'jam al-Kabir 556","","أسيد بن حضير الأشهلي عن عبد الرحمن بن أبي ليلى عن حصين بن عبد الرحمن السلمي عن خالد بن عبد الله الطحان عن عمرو بن عون الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"558","557  -  حَدَّثَنَا  الْحَسَنُ بْنُ الْعَبَّاسِ الرَّازِيُّ  ، ثَنَا  حَفْصُ بْنُ عُمَرَ الْمِهْرِقَانِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ الدَّشْتَكِيُّ ،  ثَنَا  أَبُو جَعْفَرٍ الرَّازِيُّ ،  عَنْ  حُصَيْنٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  أُسَيْدِ بْنِ حُضَيْرٍ ،  أَنَّ  رَجُلًا  كَانَ يُضْحِكُ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذْ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِإِصْبَعِهِ فِي  خَاصِرَتِهِ  ، قَالَ : قَتَلْتَنِي يَا رَسُولَ اللهِ ، قَالَ : "" اقْتَصَّ  قَالَ : إِنَّ عَلَيْكَ قَمِيصًا وَلَمْ يَكُنْ عَلَيَّ قَمِيصٌ فَرَفَعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَمِيصَهُ حَتَّى بَدَا كَشْحُهُ فَاحْتَضَنَهُ ، وَجَعَلَ يُقَبِّلُ كَشْحَهُ ، وَيَقُولُ : بِأَبِي وَأُمِّي هَذَا أَرَدْتُ  .","","Al-Mu'jam al-Kabir 557","","أسيد بن حضير الأشهلي عن عبد الرحمن بن أبي ليلى عن حصين بن عبد الرحمن السلمي عن عيسى بن أبي عيسى الرازي عن عبد الرحمن بن عبد الله الدشتكي عن حفص بن عمر المهرقاني عن الجمال الحسن بن العباس عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"559","558  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ  ،  عَنْ  أُسَيْدِ بْنِ حُضَيْرٍ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  تَوَضَّؤُوا مِنْ لُحُومِ الْإِبِلِ  الْحَدِيثَ .","","Al-Mu'jam al-Kabir 558","","أسيد بن حضير الأشهلي عن عبد الرحمن بن أبي ليلى عن عبد الله بن عبد الله الهاشمي عن حجاج بن أرطاة عن حماد بن سلمة عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"560","559  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  أَبُو مَعْمَرٍ الْقَطِيعِيُّ إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ الرَّازِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  أُسَيْدِ بْنِ حُضَيْرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  صَلُّوا فِي  مَرَابِضِ  الْغَنَمِ ، وَلَا تَوَضَّؤُوا مِنْ أَلْبَانِهَا  ، وَلَا تُصَلُّوا فِي مَعَاطِنِ الْإِبِلِ ، وَتَوَضَّؤُوا مِنْ أَلْبَانِهَا  .","","Al-Mu'jam al-Kabir 559","","أسيد بن حضير الأشهلي عن عبد الرحمن بن أبي ليلى عن عبد الله بن عبد الله الهاشمي عن حجاج بن أرطاة عن عباد بن العوام الكلابي عن إسماعيل بن إبراهيم المقعد عن عبد الله بن أحمد بن حنبل عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"561","560  -  حَدَّثَنَا  إِسْحَاقُ بْنُ دَاوُدَ الصَّوَّافُ التُّسْتَرِيُّ ،  ثَنَا  عَبْدُ الْقُدُّوسِ بْنُ مُحَمَّدٍ الْعَطَّارُ ،  ثَنَا  عَمْرُو بْنُ عَاصِمٍ ،  ثَنَا  أَبُو الْعَوَّامِ ،  ثَنَا  الْحَجَّاجُ بْنُ أَرْطَاةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ قَاضِي الرَّيِّ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  أُسَيْدِ بْنِ حُضَيْرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 560","","أسيد بن حضير الأشهلي عن عبد الرحمن بن أبي ليلى عن عبد الله بن عبد الله الهاشمي عن حجاج بن أرطاة عن عمران بن داور القطان عن عمرو بن عاصم الكلابي عن عبد القدوس بن محمد الحبحابي عن إسحاق بن داود الصواف التستري عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"562","561  -  حَدَّثَنَا  أَحْمَدُ بْنُ حَمَّادِ بْنِ زُغْبَةَ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  يَحْيَى         [1/207]      بْنُ أَيُّوبَ ،  عَنِ  ابْنِ الْهَادِ ،  عَنْ  عَبْدِ اللهِ بْنِ خَبَّابٍ ،  عَنْ  أَبِي سَعِيدٍ ،  عَنْ  أُسَيْدِ بْنِ حُضَيْرٍ ،  أَنَّهُ بَيْنَمَا هُوَ يَقْرَأُ سُورَةَ الْبَقَرَةِ وَفَرَسُهُ مَرْبُوطَةٌ  .","","Al-Mu'jam al-Kabir 561","","أسيد بن حضير الأشهلي عن أبو سعيد الخدري عن عبد الله بن خباب النجاري عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن زغبة ، أحمد بن حماد بن مسلم التجيبي عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"563","562  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ التَّيْمِيُّ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  أَنَّ  أُسَيْدَ بْنَ حُضَيْرٍ كَانَ مِنْ أَحْسَنِ النَّاسِ صَوْتًا بِالْقُرْآنِ ، فَقَرَأَ لَيْلَةً ، وَفَرَسُهُ مَرْبُوطَةٌ عِنْدَهُ ، وَابْنُهُ نَائِمٌ إِلَى جَنْبِهِ ، فَأَدَارَ الْفَرَسُ فِي رِبَاطِهِ ، فَقَرَأَ فَأَدَارَ الْفَرَسُ فِي رِبَاطِهِ ، فَقَرَأَ فَأَدَارَ الْفَرَسُ فِي رِبَاطِهِ ، فَانْصَرَفَ ، فَأَخَذَ ابْنَهُ وَخَشِيَ أَنْ يَطَأَهُ الْفَرَسُ ، فَأَصْبَحَ فَذَكَرَ ذَلِكَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اقْرَأْ  أُسَيْدُ  فَإِنَّ الْمَلَائِكَةَ لَمْ تَزَلْ يَسْتَمِعُونَ صَوْتَكَ ، فَلَوْ قَرَأْتَ أَصْبَحَتْ ظُلَّةٌ بَيْنَ السَّمَاءِ وَالْأَرَضِينَ  ، يَتَرَايَاهَا النَّاسُ فِيهَا الْمَلَائِكَةُ  .","","Al-Mu'jam al-Kabir 562","","أسيد بن حضير الأشهلي عن محمود بن لبيد الأشهلي عن محمد بن إبراهيم بن الحارث التيمي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن محمد بن بشر بن الفرافصة عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"564","563  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ، وَيَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  بَيْنَمَا أُسَيْدُ بْنُ حُضَيْرٍ - رَضِيَ اللهُ عَنْهُ - يُصَلِّي بِاللَّيْلِ ، قَالَ : إِذْ غَشِيَتْنِي مِثْلُ السَّحَابَةِ فِيهَا مِثْلُ الْمَصَابِيحِ ، وَالْمَرْأَةُ نَائِمَةٌ إِلَى جَنْبِي وَهِيَ حَامِلٌ ، وَالْفَرَسُ مَرْبُوطٌ فِي الدَّارِ ، فَخَشِيتُ أَنْ يَنْفِرَ الْفَرَسُ ، فَتَفْزَعَ الْمَرْأَةُ ، فَتُلْقِيَ وَلَدَهَا ، فَانْصَرَفْتُ مِنْ صَلَاتِي ، فَذَكَرْتُ ذَلِكَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ أَصْبَحْتُ ، فَقَالَ :  اقْرَأْهُ يَا  أُسَيْدُ  فَإِنَّ ذَلِكَ مَلَكٌ اسْتَمَعَ الْقُرْآنَ  .","","Al-Mu'jam al-Kabir 563","","أسيد بن حضير الأشهلي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"565","[1/208]      564  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  أُسَيْدِ بْنِ حُضَيْرٍ ،  أَنَّهُ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي كُنْتُ أَقْرَأُ الْبَارِحَةَ سُورَةَ الْكَهْفِ ، فَجَاءَ شَيْءٌ حَتَّى غَطَّى فَمِي ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تِلْكَ  السَّكِينَةُ  جَاءَتْ تَسْتَمِعُ الْقُرْآنَ  .","","Al-Mu'jam al-Kabir 564","","أسيد بن حضير الأشهلي عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن أبو بكر بن عياش عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"566","565  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رُزَيْقِ بْنِ جَامِعٍ الْمِصْرِيُّ  ، ثَنَا  هَارُونُ بْنُ سَعِيدٍ الْأَيْلِيُّ ،  ثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أُسَيْدِ بْنِ حُضَيْرٍ ، قَالَ :  كُنْتُ أُصَلِّي فِي لَيْلَةٍ قَمِرَةٍ ، وَقَدْ أَوْثَقْتُ فَرَسِي ،  فَجَالَتْ  جَوْلَةً ، فَفَزِعْتُ ، ثُمَّ  جَالَتْ  أُخْرَى ، فَرَفَعْتُ رَأْسِي ، وَإِذَا ظُلَّةٌ قَدْ غَشِيَتْنِي ، وَإِذَا هِيَ قَدْ حَالَتْ بَيْنِي وَبَيْنَ الْقَمَرِ ، فَفَزِعْتُ ، فَدَخَلْتُ الْبَيْتَ ، فَلَمَّا أَصْبَحْتُ ذَكَرْتُ ذَلِكَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  تِلْكَ الْمَلَائِكَةُ جَاءَتْ تَسْتَمِعُ قُرْآنَكَ آخِرَ اللَّيْلِ سُورَةَ الْبَقَرَةِ  وَكَانَ  أُسَيْدٌ  حَسَنَ الصَّوْتِ  .","","Al-Mu'jam al-Kabir 565","","أسيد بن حضير الأشهلي عن زيد بن أسلم عن عبيد الله بن عمر العمري عن أنس بن عياض الليثي عن هارون بن سعيد بن الهيثم عن محمد بن رزيق بن جامع العدل عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"567","566  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  أُسَيْدِ بْنِ حُضَيْرٍ ،  أَنَّهُ قَالَ : يَا رَسُولَ اللهِ ، بَيْنَمَا أَنَا أَقْرَأُ سُورَةَ الْبَقَرَةِ ، إِذْ سَمِعْتُ  وَجْبَةً  مِنْ خَلْفِي ، فَظَنَنْتُ أَنَّ فَرَسِي أُطْلِقَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" اقْرَأْهُ يَا  أَبَا عَتِيكٍ  "" قَالَ : فَالْتَفَتُّ ، فَإِذَا الْمَصَابِيحُ مُدَلَّاةٌ بَيْنَ السَّمَاءِ وَالْأَرْضِ ، وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : "" اقْرَأْهُ يَا  أَبَا عَتِيكٍ  "" فَقَالَ : يَا رَسُولَ اللهِ ، مَا اسْتَطَعْتُ أَنْ أَمْضِيَ ، قَالَ :  تِلْكَ الْمَلَائِكَةُ نَزَلَتْ لِقِرَاءَةِ سُورَةِ الْبَقَرَةِ ، أَمَا إِنَّكَ لَوْ مَضَيْتَ لَرَأَيْتَ الْعَجَائِبَ .","","Al-Mu'jam al-Kabir 566","","أسيد بن حضير الأشهلي عن عبد الرحمن بن أبي ليلى عن ثابت البناني عن حماد بن سلمة عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"568","567  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  أَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي ،  عَنْ  قَتَادَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  أُسَيْدِ بْنِ حُضَيْرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 567","","أسيد بن حضير الأشهلي عن عبد الرحمن بن أبي ليلى عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن إسحاق ابن راهويه عن موسى بن هارون الحمال عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"569","568  -  حَدَّثَنَا  الْفَضْلُ بْنُ الْعَبَّاسِ الْأَصْبَهَانِيُّ  ، ثَنَا  بَشَّارُ بْنُ مُوسَى         [1/209]      الْخَفَّافُ ، (  ح  )  وَحَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ ، قَالَا :  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَمْرِو بْنِ سَعْدِ بْنِ مُعَاذٍ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنِ  ابْنِ شَفِيعٍ ، وَكَانَ طَبِيبًا ، قَالَ :  قَطَعْتُ مِنْ أُسَيْدِ بْنِ حُضَيْرٍ  عِرْقَ  النَّسَا  ،  فَحَدَّثَنِي  حَدِيثَيْنِ قَالَ : أَتَانِي أَهْلُ بَيْتَيْنِ مِنْ قَوْمِي ، فَقَالُوا : كَلِّمْ لَنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْسِمْ لَنَا مِنْ هَذَا التَّمْرِ ، فَأَتَيْتُهُ فَكَلَّمْتُهُ ، فَقَالَ : "" نَعَمْ نَقْسِمُ لِكُلِّ أَهْلِ بَيْتٍ  شَطْرًا  ، وَإِنْ عَادَ اللهُ عَلَيْنَا عُدْنَا عَلَيْهِمْ "" فَقُلْتُ : جَزَاكَ اللهُ عَنَّا خَيْرًا ، قَالَ : "" وَأَنْتُمْ فَجَزَاكُمُ اللهُ عَنِّي مَعَاشِرَ  الْأَنْصَارِ  خَيْرًا ، فَإِنَّكُمْ - مَا عَلِمْتُ -  أَعِفَّةٌ  صُبُرٌ ،  أَمَا إِنَّكُمْ سَتَلْقَوْنَ بَعْدِي  أَثَرَةً  ، فَاصْبِرُوا حَتَّى تَلْقَوْنِي  .","","Al-Mu'jam al-Kabir 568","","أسيد بن حضير الأشهلي عن ابن شفيع ، الطبيب عن محمود بن لبيد الأشهلي عن حصين بن عبد الرحمن الأشهلي عن محمد بن إسحاق عن يحيى بن زكريا بن أبي زائدة عن بشار بن موسى الشيباني عن الفضل بن العباس بن مهران الأصبهاني عن الطبراني","ومما أسند أسيد بن حضير رضي الله عنه"
"570","19 -  أُسَيْدُ بْنُ ظُهَيْرٍ  - رَضِيَ اللهُ عَنْهُ -  569  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْقِرْمِطِيُّ الْبَغْدَادِيُّ ، مِنْ وَلَدِ عَامِرِ بْنِ رَبِيعَةَ ،  ثَنَا  عُثْمَانُ بْنُ يَعْقُوبَ الْعُثْمَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ طَلْحَةَ التَّيْمِيُّ ،  ثَنَا  بَشِيرُ بْنُ ثَابِتِ بْنِ أُسَيْدِ بْنِ ظُهَيْرٍ ، (  ح  )  وَحَدَّثَنِي  أَيْضًا عَنْ أُخْتِهِ  سُعْدَى بِنْتِ ثَابِتٍ ،  عَنْ  أَبِيهِمَا ثَابِتٍ ،  عَنْ  جَدِّهِمَا أُسَيْدِ بْنِ ظُهَيْرٍ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  اسْتَصْغَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَافِعَ بْنَ خَدِيجٍ  يَوْمَ أُحُدٍ  ، فَقَالَ لَهُ عَمُّهُ  ظُهَيْرٌ  رَحِمَهُ اللهُ : يَا رَسُولَ اللهِ ، إِنَّهُ رَجُلٌ رَامٍ ، فَأَجَازَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَصَابَهُ سَهْمٌ فِي  لَبَّتِهِ  ، فَجَاءَ بِهِ عَمُّهُ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : إِنَّ ابْنَ أَخِي أَصَابَهُ  سَهْمٌ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنْ أَحْبَبْتَ أَنْ تُخْرِجَهُ أَخْرَجْنَاهُ ، وَإِنْ أَحْبَبْتَ أَنْ تَدَعَهُ ، فَإِنَّهُ إِنْ مَاتَ وَهُوَ فِيهِ مَاتَ  شَهِيدًا  .","","Al-Mu'jam al-Kabir 569","","أسيد بن ظهير الحارثي عن ثابت بن أنس بن ظهير الأنصاري عن سعدى بنت ثابت عن محمد بن طلحة بن عبد الرحمن عن عثمان بن يعقوب العثماني عن القرمطي محمد بن عبد الله العدوي عن الطبراني","أسيد بن ظهير رضي الله عنه"
"571","[1/210]      570  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ ،  ثَنَا  أَبُو الْأَبْرَدِ ، مَوْلَى بَنِي خَطْمَةَ ،  أَنَّهُ سَمِعَ  أُسَيْدَ بْنَ ظُهَيْرٍ الْأَنْصَارِيَّ يُحَدِّثُ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  صَلَاةٌ فِي  مَسْجِدِ قُبَاءٍ  كَعُمْرَةٍ  .","","Al-Mu'jam al-Kabir 570","","أسيد بن ظهير الحارثي عن زياد الخطمي عن عبد الحميد بن جعفر الأوسي عن حماد بن أسامة القرشي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","أسيد بن ظهير رضي الله عنه"
"572","571  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  الصَّلْتُ بْنُ مَسْعُودٍ الْجَحْدَرِيُّ ،  ثَنَا  خَالِدُ بْنُ الْحَارِثِ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ ، قَالَ :  أَخْبَرَنِي  أَبِي  ،  عَنْ  رَافِعِ بْنِ أُسَيْدِ بْنِ ظُهَيْرٍ ،  عَنْ  أَبِيهِ ،  "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ كَرْيِ الْأَرْضِ  .","","Al-Mu'jam al-Kabir 571","","أسيد بن ظهير الحارثي عن رافع بن أسيد الخزرجي عن جعفر بن عبد الله بن الحكم الأوسي عن عبد الحميد بن جعفر الأوسي عن خالد الصدق عن الصلت بن مسعود الجحدري عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","أسيد بن ظهير رضي الله عنه"
"573","20 -  أُسَيْدُ بْنُ يَرْبُوعٍ الْأَنْصَارِيُّ  اسْتُشْهِدَ  يَوْمَ الْيَمَامَةِ  - رَضِيَ اللهُ عَنْهُ -  572  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ""  فِي تَسْمِيَةِ مَنْ قُتِلَ  يَوْمَ الْيَمَامَةِ  مِنَ  الْأَنْصَارِ  مِنْ  بَنِي سَاعِدَةَ  :  أُسَيْدُ بْنُ يَرْبُوعٍ  "" .","","Al-Mu'jam al-Kabir 572","","","أسيد بن يربوع الأنصاري"
"574","573  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ""  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ  يَوْمَ الْيَمَامَةِ  مِنَ  الْأَنْصَارِ  مِنْ  بَنِي سَاعِدَةَ  :  أُسَيْدُ بْنُ يَرْبُوعٍ  "" .","","Al-Mu'jam al-Kabir 573","","","أسيد بن يربوع الأنصاري"
"575","[1/211]      21 -  أُسَيْدُ بْنُ مَالِكٍ أَبُو عَمْرَةَ الْأَنْصَارِيُّ وَيُقَالُ : بَشِيرُ بْنُ عَمْرِو بْنِ مِحْصَنٍ - رَضِيَ اللهُ عَنْهُ - وَيُقَالُ : ثَعْلَبَةُ بْنُ عَمْرِو بْنِ مِحْصَنٍ ، وَيُقَالُ : عَمْرُو بْنُ مِحْصَنٍ مِنْ بَنِي مَازِنِ بْنِ النَّجَّارِ  ، وَيُقَالُ :  إِنَّ  أَبَا عَمْرَةَ  أَعْطَى  عَلِيًّا  - رَضِيَ اللهُ عَنْهُ -  يَوْمَ  صِفِّينَ  مِائَةَ أَلْفِ دِرْهَمٍ أَعَانَهُ بِهَا  يَوْمَ الْجَمَلِ  ، وَقُتِلَ  يَوْمَ  صِفِّينَ  .  574  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَدِينِيُّ فُسْتُقَةُ  ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ  ،  عَنِ  الْوَاقِدِيِّ  ، قَالَ : ""  وَفِيهَا تُوُفِّيَ  أَبُو عَمْرَةَ الْمَازِنِيُّ  سَنَةَ سَبْعٍ وَثَلَاثِينَ  "" .","","Al-Mu'jam al-Kabir 574","","","أسيد بن مالك أبو عمرة الأنصاري"
"576","بَابٌ مِنْ دَلَائِلِ نُبُوَّةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  575  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ، (  ح  )  وَحَدَّثَنَا  أَبُو عَبْدِ الْمَلِكِ أَحْمَدُ بْنُ إِبْرَاهِيمَ الْقُرَشِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ الْعَلَاءِ بْنِ زَبْرٍ الْحِمْصِيُّ ،  حَدَّثَنِي  أَبِي عَبْدُ اللهِ بْنُ الْعَلَاءِ ،  عَنِ  الزُّهْرِيِّ ، وَالْأَوْزَاعِيِّ ، قَالَا :  ثَنَا  الْمُطَّلِبُ بْنُ عَبْدِ اللهِ بْنِ حَنْطَبٍ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ أَبِي عَمْرَةَ الْأَنْصَارِيُّ ،  حَدَّثَنِي  أَبِي ،  قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي غَزْوَةٍ غَزَاهَا ، فَأَصَابَ النَّاسَ مَخْمَصَةٌ ، فَاسْتَأْذَنَ النَّاسُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي نَحْرِ بَعْضِ ظُهُورِهِمْ ، فَهَمَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَأْذَنَ لَهُمْ فِي ذَلِكَ ، فَقَالَ  عُمَرُ بْنُ الْخَطَّابِ  - رَضِيَ اللهُ عَنْهُ - : أَرَأَيْتَ يَا رَسُولَ اللهِ إِذَا نَحْنُ نَحَرْنَا  ظَهْرَنَا  ، ثُمَّ لَقِينَا         [1/212]      عَدُوَّنَا غَدًا وَنَحْنُ جِيَاعٌ رِجَالٌ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" فَمَا تَرَى يَا  عُمَرُ  ؟ "" قَالَ : تَدْعُو النَّاسَ بِبَقَايَا أَزْوَادِهِمْ ، ثُمَّ تَدْعُو لَنَا فِيهَا بِالْبَرَكَةِ ، فَإِنَّ اللهَ - عَزَّ وَجَلَّ - سَيُبَلِّغُنَا بِدَعْوَتِكَ إِنْ شَاءَ اللهُ ، قَالَ : فَكَأَنَّمَا كَانَ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غِطَاءٌ ، فَكُشِفَ فَدَعَا بِثَوْبٍ ، فَأَمَرَ بِهِ ، فَبُسِطَ ، ثُمَّ دَعَا النَّاسَ بِبَقَايَا أَزْوَادِهِمْ ، فَجَاؤُوا بِمَا كَانَ عِنْدَهُمْ ، فَمِنَ النَّاسِ مَنْ جَاءَ  بِالْجَفْنَةِ مِنَ الطَّعَامِ - أَوِ الْحَفْنَةِ  - وَمِنْهُمْ مَنْ جَاءَ بِمِثْلِ الْبَيْضَةِ ، فَأَمَرَ بِهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوُضِعَ عَلَى ذَلِكَ الثَّوْبِ ، ثُمَّ دَعَا فِيهِ بِالْبَرَكَةِ ، وَتَكَلَّمَ بِمَا شَاءَ اللهُ أَنْ يَتَكَلَّمَ ، ثُمَّ نَادَى فِي الْجَيْشِ ، فَجَاؤُوا ، ثُمَّ أَمَرَهُمْ فَأَكَلُوا ، وَطَعِمُوا ، وَمَلَأُوا أَوْعِيَتَهُمْ ، وَمَزَاوِدَهُمْ ، ثُمَّ دَعَا  بِرَكْوَةٍ  فَوُضِعَتْ بَيْنَ يَدَيْهِ ، ثُمَّ دَعَا بِمَاءٍ ، فَصَبَّهُ فِيهَا ، ثُمَّ مَجَّ فِيهَا ، فَتَكَلَّمَ بِمَا شَاءَ اللهُ أَنْ يَتَكَلَّمَ ، ثُمَّ أَدْخَلَ خِنْصَرَهُ فِيهَا ، فَأُقْسِمُ بِاللهِ لَقَدْ رَأَيْتُ أَصَابِعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَفَجَّرُ يَنَابِيعَ مِنَ الْمَاءِ ، ثُمَّ أَمَرَ النَّاسَ فَشَرِبُوا ، وَسَقَوْا ، وَمَلَأُوا قِرَبَهُمْ ، وَأَدَاوِيَهُمْ ، ثُمَّ ضَحِكَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى بَدَتْ  نَوَاجِذُهُ  ، ثُمَّ قَالَ :  أَشْهَدُ أَنْ لَا إِلَهَ اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، وَأَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ ، لَا يَلْقَى اللهَ بِهِمَا أَحَدٌ يَوْمَ الْقِيَامَةِ إِلَّا دَخَلَ الْجَنَّةَ عَلَى مَا كَانَ  .","","Al-Mu'jam al-Kabir 575","","أبو عمرة الأنصاري عن عبد الرحمن بن أبي عمرة الخزرجي عن المطلب بن عبد الله بن حنطب المخزومي عن الزهري عن عبد الله بن العلاء بن زبر عن إبراهيم بن عبد الله بن العلاء الدمشقي عن أحمد بن إبراهيم بن محمد البسري عن الطبراني","باب من دلائل نبوة رسول الله صلى الله عليه وسلم"
"577","576  -  حَدَّثَنَا  الْحَسَنُ بْنُ غُلَيْبٍ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ عُفَيْرٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ بْنِ الْأَشَجِّ ،  عَنْ  بَيْهَسٍ الثَّقَفِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي عَمْرَةَ الْأَنْصَارِيِّ ،  عَنْ  أَبِيهِ  ، لَا أَعْلَمُ ذَلِكَ إِلَّا عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ قِيلَ لَهُ : يَا رَسُولَ اللهِ ،  أَرَأَيْتَ مَنْ آمَنَ بِكَ وَلَمْ يَرَكَ ، وَصَدَّقَكَ وَلَمْ يَرَكَ ، مَاذَا لَهُمْ ؟ قَالَ : "" طُوبَى لَهُمْ مَرَّتَيْنِ ، أُولَئِكَ مِنَّا ، أُولَئِكَ مَعَنَا  .","","Al-Mu'jam al-Kabir 576","","أبو عمرة الأنصاري عن عبد الرحمن بن أبي عمرة الخزرجي عن بيهس الثقفي عن بكير بن عبد الله بن الأشج القرشي عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن سعيد بن كثير بن عفير عن الحسن بن غليب المصري عن الطبراني","باب من دلائل نبوة رسول الله صلى الله عليه وسلم"
"578","[1/213]      22 -  أُسَيْرُ بْنُ عَمْرٍو أَبُو سَلِيطٍ الْأَنْصَارِيُّ ، بَدْرِيٌّ وَيُقَالُ : أُسَيْرَةُ بْنُ مَالِكِ بْنِ عَدِيِّ بْنِ عَامِرِ بْنِ غَنْمِ بْنِ عَدِيِّ بْنِ النَّجَّارِ  - رَضِيَ اللهُ عَنْهُ - .  577  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ""  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  :  أَبُو سَلِيطٍ أُسَيْرُ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Kabir 577","","","أسير بن عمرو أبو سليط الأنصاري"
"579","بَابٌ فِي تَحْرِيمِ الْحُمُرِ  الْأَهْلِيَّةِ  578  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ الْبَزَّازُ التُّسْتَرِيُّ  ، ثَنَا  الْحَسَنُ بْنُ يَحْيَى الْأَرُزِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ هَارُونَ بْنِ أَبِي عِيسَى ،  حَدَّثَنِي  أَبِي ،  عَنِ  ابْنِ إِسْحَاقَ ،  ثَنَا  عَبْدُ اللهِ بْنُ حَمْزَةَ  الْفَزَارِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ سُلَيْطٍ ،  عَنْ  أَبِيهِ أَبِي سَلِيطٍ ،  قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ أَكْلِ لُحُومِ الْحُمُرِ  الْإِنْسِيَّةِ  ، وَالْقُدُورُ  تَفُورُ  فَكَفَأْنَاهَا عَلَى وُجُوهِهَا  .  كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب:(بن ضمرة) .","","Al-Mu'jam al-Kabir 578","","أبو سليط البدري عن عبد الله بن سليط الحجازي عن عبد الله بن عمرو بن ضمرة الفزاري عن محمد بن إسحاق عن هارون بن أبي عيسى الشامي عن عبد الله بن هارون بن أبي عيسى الشامي عن الحسن بن يحيى الرزي عن أحمد بن عبد الله البزاز عن الطبراني","باب في تحريم الحمر الأهلية"
"580","579  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الْعَزِيزِ ،  حَدَّثَنَا  هَارُونُ بْنُ عَبْدِ اللهِ ، (  ح  )  وَحَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  أَبِي  ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ الْمَخْزُومِيُّ ،  ثَنَا  يَحْيَى بْنُ مُحَمَّدِ بْنِ مَرْوَانَ بْنِ عَبْدِ اللهِ بْنِ أَبِي سَلِيطٍ الْأَنْصَارِيُّ بْنُ عَمْرٍو ، قَالَ :  أَصَابَ النَّاسَ فِي  غَزْوَةِ خَيْبَرَ  مَخْمَصَةٌ شَدِيدَةٌ ، فَقَامُوا إِلَى حُمُرِهِمْ فِي مَحْضَرٍ مِنَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَزَرُوهَا ، ثُمَّ طَرَحُوهَا فِي الْقُدُورِ ، فَبَيْنَمَا هِيَ  تَفُورُ  نَزَلَ تَحْرِيمُهَا عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  نَزَلَ تَحْرِيمُ الْحُمُرِ الَّتِي تَطْبُخُونَ فَكُبَّتِ الْقُدُورُ عَلَى وُجُوهِهَا  .","","Al-Mu'jam al-Kabir 579","","يحيى بن محمد بن مروان الأنصاري عن محمد بن الحسن بن زبالة المخزومي عن هارون بن عبد الله بن مروان الحمال عن موسى بن هارون الحمال عن الطبراني","باب في تحريم الحمر الأهلية"
"581","[1/214]      580  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَمْرِو بْنِ ضَمْرَةَ الْفَزَارِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي سَلِيطٍ ،  عَنْ  أَبِيهِ أَبِي سَلِيطٍ ، وَكَانَ بَدْرِيًّا ،  قَالَ :  لَقَدْ أَتَانَا نَهْيُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ أَكْلِ لُحُومِ الْحُمُرِ  ، وَإِنَّ الْقُدُورَ  لَتَفُورُ  بِهَا فَكَفَأْنَاهَا عَلَى وُجُوهِهَا  .","","Al-Mu'jam al-Kabir 580","","أبو سليط البدري عن عبد الله بن أبي سليط الأنصاري عن عبد الله بن عمرو بن ضمرة الفزاري عن محمد بن إسحاق عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب في تحريم الحمر الأهلية"
"582","بَابُ مَنِ اسْمُهُ أَوْسٌ  23 - مِمَّا  أَسْنَدَ  أَوْسُ بْنُ أَوْسٍ الثَّقَفِيُّ  - رَضِيَ اللهُ عَنْهُ -  بَابٌ فِي الْغُسْلِ يَوْمَ الْجُمُعَةِ ، وَالتَّبْكِيرِ لِلرَّوَاحِ .  581  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  أَبِي الْأَشْعَثِ الصَّنْعَانِيِّ ،  عَنْ  أَوْسِ بْنِ أَوْسٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ  غَسَّلَ  وَاغْتَسَلَ يَوْمَ الْجُمُعَةِ ،  وَبَكَّرَ  وَابْتَكَرَ  ، وَدَنَا مِنَ الْإِمَامِ  فَأَنْصَتَ  ، كَانَ لَهُ بِكُلِّ خُطْوَةٍ يَخْطُوهَا ، صِيَامُ سَنَةٍ وَقِيَامُهَا ، وَذَلِكَ عَلَى اللهِ يَسِيرٌ  .","","Al-Mu'jam al-Kabir 581","","أوس بن أوس الثقفي عن شراحيل بن آدة الأبناوي عن أبو قلابة الجرمي عن يحيى بن أبي كثير عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب في الغسل يوم الجمعة والتبكير للرواح"
"583","582  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ عِيسَى ،  عَنْ  يَحْيَى بْنِ الْحَارِثِ ،  عَنْ  أَبِي الْأَشْعَثِ ،  عَنْ  أَوْسِ بْنِ أَوْسٍ الثَّقَفِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ  غَسَّلَ  وَغَدَا فَابْتَكَرَ ، ثُمَّ جَلَسَ قَرِيبًا مِنَ الْإِمَامِ فَاسْتَمَعَ  وَأَنْصَتَ  ،  كَانَ لَهُ بِكُلِّ خُطْوَةٍ يَخْطُوهَا أَجْرُ سَنَةٍ ، صِيَامُهَا وَقِيَامُهَا  .","","Al-Mu'jam al-Kabir 582","","أوس بن أوس الثقفي عن شراحيل بن آدة الأبناوي عن يحيى بن الحارث الذماري عن عبد الله بن عيسى بن عبد الرحمن بن أبي ليلى عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب في الغسل يوم الجمعة والتبكير للرواح"
"584","583  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ         [1/215]      ، ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِي الْحَكَمِ الْأَعْرَجِ ،  عَنْ  عَبْدِ اللهِ بْنِ عِيسَى ،  عَنْ  يَحْيَى بْنِ الْحَارِثِ ،  عَنْ  أَبِي الْأَشْعَثِ الصَّنْعَانِيِّ ،  عَنْ  أَوْسِ بْنِ أَوْسٍ الثَّقَفِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ قَالَ فِي يَوْمِ الْجُمُعَةِ :  مَنْ  غَسَّلَ  وَاغْتَسَلَ وَبَكَّرَ ، وَدَنَا فَاسْتَمَعَ  ، كَانَ لَهُ بِكُلِّ خُطْوَةٍ يَخْطُوهَا مِنْ بَيْتِهِ إِلَى الْمَسْجِدِ أَجْرُ سَنَةٍ ، صِيَامُهَا وَقِيَامُهَا  .","","Al-Mu'jam al-Kabir 583","","أوس بن أوس الثقفي عن شراحيل بن آدة الأبناوي عن يحيى بن الحارث الذماري عن عبد الله بن عيسى بن عبد الرحمن بن أبي ليلى عن أبو الحكم الأعرج عن عبد الرحيم بن سليمان الأشل عن عبد الله بن عمر مشكدانة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب في الغسل يوم الجمعة والتبكير للرواح"
"585","584  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنِ  ابْنِ جَابِرٍ ، قَالَ :  سَمِعْتُ  أَبَا الْأَشْعَثِ الصَّنْعَانِيَّ ، يَقُولُ :  سَمِعْتُ  أَوْسَ بْنَ أَوْسٍ الثَّقَفِيَّ يُخْبِرُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  مَنْ  غَسَّلَ  وَاغْتَسَلَ يَوْمَ الْجُمُعَةِ  ، ثُمَّ غَدَا ، وَابْتَكَرَ ، وَمَشَى وَلَمْ يَرْكَبْ ، وَلَمْ يَلْغُ كُتِبَ لَهُ بِهِ عَمَلُ سَنَةٍ "" قَالَ  ابْنُ جَابِرٍ  : فَحَدَّثْتُ بِهَذَا الْحَدِيثِ يَحْيَى بْنَ الْحَارِثِ الذِّمَارِيَّ ، فَقَالَ : أَنَا  سَمِعْتُ  أَبَا الْأَشْعَثِ  يُحَدِّثُ بِهِ ، عَنْ  أَوْسِ بْنِ أَوْسٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قَالَ : "" لَهُ بِكُلِّ قَدَمٍ عَمَلُ سَنَةٍ ، صِيَامُهَا وَقِيَامُهَا  ، قَالَ  ابْنُ جَابِرٍ  : "" فَحَفِظَ  يَحْيَى  وَنَسِيتُ "" قَالَ  الْوَلِيدُ  : فَذَكَرْتُ ذَلِكَ  لِأَبِي عَمْرٍو الْأَوْزَاعِيِّ  ، فَقَالَ : "" ثَبَتَ الْحَدِيثُ أَنَّ لَهُ بِكُلِّ قَدَمٍ عَمَلَ سَنَةٍ "" .","","Al-Mu'jam al-Kabir 584","","أوس بن أوس الثقفي عن شراحيل بن آدة الأبناوي عن عبد الرحمن بن يزيد الداراني عن الوليد بن مسلم القرشي عن علي ابن المديني عن الفضل بن الحباب الجمحي عن الطبراني","باب في الغسل يوم الجمعة والتبكير للرواح"
"586","585  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ، وَعُبَيْدُ بْنُ غَنَّامٍ ، قَالَا :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  ثَنَا  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  حَسَّانُ بْنُ عَطِيَّةَ ،  حَدَّثَنِي  أَبُو الْأَشْعَثِ الصَّنْعَانِيُّ ،  حَدَّثَنِي  أَوْسُ بْنُ أَوْسٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ  غَسَّلَ  وَاغْتَسَلَ يَوْمَ الْجُمُعَةِ ، ثُمَّ  بَكَّرَ  وَابْتَكَرَ ، وَمَشَى وَلَمْ يَرْكَبْ  ، وَدَنَا وَاسْتَمَعَ ، وَلَمْ يَلْغُ ، كَانَ لَهُ بِكُلِّ خُطْوَةٍ يَخْطُوهَا عَمَلُ سَنَةٍ ، صِيَامُهَا وَقِيَامُهَا  .","","Al-Mu'jam al-Kabir 585","","أوس بن أوس الثقفي عن شراحيل بن آدة الأبناوي عن حسان بن عطية المحاربي عن أبو عمرو الأوزاعي عن عبد الله بن المبارك عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب في الغسل يوم الجمعة والتبكير للرواح"
"587","586  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  ثَنَا  يَزِيدُ بْنُ يُوسُفَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ بْنِ جَابِرٍ ،  عَنْ  أَبِي الْأَشْعَثِ الصَّنْعَانِيِّ ،  عَنْ  أَبِي أَسْمَاءَ الرَّحَبِيِّ ،  عَنْ  أَوْسِ بْنِ أَوْسٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ         [1/216]      - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ  غَسَّلَ  وَاغْتَسَلَ وَغَدَا ، وَابْتَكَرَ وَمَشَى وَلَمْ يَرْكَبْ  ، وَدَنَا مِنَ الْإِمَامِ ، وَلَمْ يَلْغُ كَانَ لَهُ أَجْرُ سَنَةٍ ، صِيَامُهَا وَقِيَامُهَا  .","","Al-Mu'jam al-Kabir 586","","أوس بن أوس الثقفي عن عمرو بن مرثد الرحبي عن شراحيل بن آدة الأبناوي عن عبد الرحمن بن يزيد الداراني عن يزيد بن يوسف الرحبي عن منصور بن أبي مزاحم عن موسى بن هارون الحمال عن الطبراني","باب في الغسل يوم الجمعة والتبكير للرواح"
"588","587  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ،  عَنْ  مُحَمَّدِ بْنِ سَعِيدٍ الْأَسَدِيِّ ،  عَنْ  أَوْسِ بْنِ أَوْسٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا كَانَ يَوْمُ الْجُمُعَةِ فَغَسَلَ أَحَدُكُمْ رَأْسَهُ وَاغْتَسَلَ  ، ثُمَّ غَدَا وَابْتَكَرَ ، وَدَنَا وَاسْتَمَعَ  وَأَنْصَتَ  ، كَانَ لَهُ بِكُلِّ خُطْوَةٍ يَخْطُوهَا صِيَامُ سَنَةٍ ، وَقِيَامُ سَنَةٍ  .","","Al-Mu'jam al-Kabir 587","","أوس بن أبي أوس الطائفي عن محمد بن سعيد المصلوب عن سعيد بن أبي هلال الليثي عن عمر بن محمد عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب في الغسل يوم الجمعة والتبكير للرواح"
"589","588  -  حَدَّثَنَا  أَبُو حَبِيبٍ يَحْيَى بْنُ نَافِعٍ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَا :  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ، أَنَّ سَعِيدَ بْنَ أَبِي هِلَالٍ  حَدَّثَهُ  ،  عَنْ  مُحَمَّدِ بْنِ سَعِيدٍ ،  عَنْ  عُبَادَةَ بْنِ نُسَيٍّ ،  عَنْ  أَوْسٍ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ  غَسَّلَ  وَاغْتَسَلَ يَوْمَ الْجُمُعَةِ ، ثُمَّ غَدَا ، أَوْ  رَاحَ  ، أَوِ ابْتَكَرَ ، ثُمَّ دَنَا  وَأَنْصَتَ  وَاسْتَمَعَ  ، كَانَ لَهُ بِقَدْرِ كُلِّ خُطْوَةٍ يَخْطُوهَا كَأَجْرِ قِيَامِ سَنَةٍ ، وَصِيَامِ سَنَةٍ  .","","Al-Mu'jam al-Kabir 588","","أوس بن أوس الثقفي عن عبادة بن نسي الأردني عن محمد بن سعيد المصلوب عن سعيد بن أبي هلال الليثي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","باب في الغسل يوم الجمعة والتبكير للرواح"
"590","بَابٌ فَضْلُ الْجُمُعَةِ  589  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  حَدَّثَنِي  أَبِي  ، (  ح  )         [1/217]      وَحَدَّثَنِي  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَا :  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  حُسَيْنُ بْنُ عَلِيٍّ الْجُعْفِيُّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ بْنِ جَابِرٍ ،  عَنْ  أَبِي الْأَشْعَثِ الصَّنْعَانِيِّ ،  عَنْ  أَوْسِ بْنِ أَوْسٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ أَفْضَلَ أَيَّامِكُمْ يَوْمُ الْجُمُعَةِ ، فِيهِ خُلِقَ  آدَمُ  ، وَفِيهِ النَّفْخَةُ ، وَفِيهِ الصَّعْقَةُ  ، فَأَكْثِرُوا عَلَيَّ فِيهِ مِنَ الصَّلَاةِ ، إِنَّ صَلَاتَكُمْ مَعْرُوضَةٌ عَلَيَّ "" ، فَقَالُوا : يَا رَسُولَ اللهِ كَيْفَ تُعْرَضُ صَلَاتُنَا عَلَيْكَ وَقَدْ  أَرِمْتَ  ؟ قَالَ : يَقُولُ : بَلِيتَ ، قَالَ : "" إِنَّ اللهَ - عَزَّ وَجَلَّ - حَرَّمَ عَلَى الْأَرْضِ أَنْ تَأْكُلَ أَجْسَادَ الْأَنْبِيَاءِ  .","","Al-Mu'jam al-Kabir 589","","أوس بن أوس الثقفي عن شراحيل بن آدة الأبناوي عن عبد الرحمن بن يزيد الداراني عن الحسين بن علي الجعفي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","باب فضل الجمعة"
"591","بَابٌ  590  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ الْقَاضِي  ، ثَنَا  هِشَامُ بْنُ عُمَارَةَ ، (  ح  )  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  هِشَامُ بْنُ خَالِدٍ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  ثَنَا  يَزِيدُ بْنُ عَبِيدَةَ ،  عَنْ  أَبِي الْأَشْعَثِ الصَّنْعَانِيِّ ،  عَنْ  أَوْسِ بْنِ أَوْسٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  يَنْزِلُ  عِيسَى ابْنُ مَرْيَمَ  - عَلَيْهِ السَّلَامُ - عِنْدَ  الْمَنَارَةِ الْبَيْضَاءِ شَرْقِيَّ دِمَشْقَ  .","","Al-Mu'jam al-Kabir 590","","أوس بن أوس الثقفي عن شراحيل بن آدة الأبناوي عن يزيد بن عبيدة بن أبي المهاجر السكوني عن محمد بن شعيب بن شابور القرشي عن هشام بن خالد السلامي عن عبد الله بن أحمد الجواليقي عن الطبراني","باب"
"592","591  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ بْنِ مُحَيْرِيزٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَوْسِ بْنِ أَوْسٍ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ كَذَبَ عَلَى نَبِيِّهِ ، أَوْ عَلَى عَيْنَيْهِ  ، أَوْ عَلَى وَالِدَيْهِ ، لَمْ  يَرَحْ  رَائِحَةَ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 591","","أوس بن أوس الثقفي عن عبد الله بن محيريز الجمحي عن عبد الرحمن بن عبد الله الجمحي عن إسماعيل بن عياش الأحول عن داود بن عمرو المسيبي عن موسى بن هارون الحمال عن الطبراني","باب"
"593","بَابُ تَعْظِيمِ قَوْلِ لَا إِلَهَ إِلَّا اللهُ وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ  592  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ ، وَمُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ ،         [1/218]      قَالَا :  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا  شُعْبَةُ ،  عَنِ  النُّعْمَانِ بْنِ سَالِمٍ ، قَالَ :  سَمِعْتُ  أَوْسَ بْنَ أَوْسٍ الثَّقَفِيَّ يَقُولُ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي وَفْدِ  ثَقِيفٍ  ، قَالَ : وَكُنْتُ فِي أَسْفَلِ الْقِبْلَةِ لَيْسَ فِيهَا أَحَدٌ إِلَّا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَائِمٌ ، إِذْ أَتَاهُ  رَجُلٌ  فَسَارَّهُ ، ثُمَّ قَالَ :  اذْهَبْ فَاقْتُلْهُ "" ، ثُمَّ قَالَ : "" أَلَيْسَ يَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَيَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ؟  قَالَ : بَلَى ، قَالَ : "" إِنِّي أُمِرْتُ أَنْ أُقَاتِلَ النَّاسَ حَتَّى يَقُولُوا : لَا إِلَهَ إِلَّا اللهُ ، فَإِذَا قَالُوهَا حَرُمَتْ عَلَيَّ دِمَاؤُهُمْ ، وَأَمْوَالُهُمْ ، إِلَّا بِحَقِّهَا  .","","Al-Mu'jam al-Kabir 592","","أوس بن أوس الثقفي عن النعمان بن سالم الطائفي عن شعبة بن الحجاج عن علي بن الجعد عن ابن الرازي محمد بن جعفر البغدادى عن الطبراني","باب تعظيم قول لا إله إلا الله وأن محمدا رسول الله"
"594","593  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  سِمَاكُ بْنُ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ سَالِمٍ ،  عَنْ  أَوْسٍ ، قَالَ :  دَخَلَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَنَحْنُ فِي  قُبَّةٍ  فِي  مَسْجِدِ الْمَدِينَةِ  ، فَأَخَذَ بِشَيْءٍ مِنَ  الْقُبَّةِ  ، فَأَتَاهُ  رَجُلٌ  فَسَارَّهُ بِشَيْءٍ لَا يُدْرَى مَا يَقُولُ ، فَقَالَ :  اذْهَبْ ، فَقُلْ لَهُمْ : يَقْتُلُوهُ "" ثُمَّ قَالَ : "" لَعَلَّهُ يَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ؟ "" قَالَ : نَعَمْ ، قَالَ : "" اذْهَبْ فَقُلْ لَهُمْ : يُرْسِلُوهُ  ، فَإِنِّي أُمِرْتُ أَنْ أُقَاتِلَ النَّاسَ حَتَّى يَقُولُوا : لَا إِلَهَ إِلَّا اللهُ ، فَإِذَا قَالُوهَا حُرِّمَتْ عَلَيَّ دِمَاؤُهُمْ ، وَأَمْوَالُهُمْ ، إِلَّا بِأَمْرٍ حَقٍّ ، وَكَانَ حِسَابُهُمْ عَلَى اللهِ - عَزَّ وَجَلَّ -  .","","Al-Mu'jam al-Kabir 593","","أوس بن أبي أوس الطائفي عن النعمان بن سالم الطائفي عن سماك بن حرب البكري عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","باب تعظيم قول لا إله إلا الله وأن محمدا رسول الله"
"595","594  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حَيَّانَ الْمَازِنِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكٍ ،  عَنِ  النُّعْمَانِ بْنِ سَالِمٍ ،  عَنْ  أَوْسٍ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُسَارُّهُ وَأَنَا أَسْمَعُ ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اذْهَبْ إِلَيْهِمْ ، فَقُلْ لَهُمُ : اقْتُلُوهُ ، ثُمَّ دَعَاهُ ، فَرَجَعَ إِلَيْهِ بَعْدَمَا ذَهَبَ "" فَقَالَ : "" لَعَلَّهُ يَقُولُ : لَا إِلَهَ إِلَّا اللهُ ؟  قَالَ : نَعَمْ ، قَالَ : "" فَقُلْ لَهُمْ : يُرْسِلُوهُ فَإِنَّهُ أُوحِيَ إِلَيَّ أَنْ أُقَاتِلَ النَّاسَ حَتَّى يَقُولُوا : لَا إِلَهَ إِلَّا اللهُ ، فَإِذَا قَالُوهَا ، حُرِّمَتْ عَلَيَّ أَمْوَالُهُمْ وَدِمَاؤُهُمْ ، إِلَّا بِحَقِّهَا ، وَحَقُّهُمْ عَلَى اللهِ  .","","Al-Mu'jam al-Kabir 594","","أوس بن أبي أوس الطائفي عن النعمان بن سالم الطائفي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن أبو الوليد الطيالسي عن محمد بن حيان المازني عن الطبراني","باب تعظيم قول لا إله إلا الله وأن محمدا رسول الله"
"596","595  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ بَكْرٍ السَّهْمِيُّ ،  ثَنَا  حَاتِمُ بْنُ أَبِي صَغِيرَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ سَالِمٍ ، أَنَّ  عَمْرَو بْنَ أَوْسٍ  أَخْبَرَهُ  ، أَنَّ أَبَاهُ أَوْسًا  أَخْبَرَهُ  ، قَالَ :  إِنَّا لَقُعُودٌ عِنْدَ رَسُولِ اللهِ         [1/219]      - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَهُوَ يَقُصُّ عَلَيْنَا ، وَيُذَكِّرُنَا إِذْ أَتَاهُ  رَجُلٌ  فَسَارَّهُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اذْهَبُوا فَاقْتُلُوهُ "" فَلَمَّا وَلَّى الرَّجُلُ ، دَعَاهُ ، فَقَالَ : "" يَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ؟  قَالَ : نَعَمْ ، قَالَ : "" اذْهَبُوا بِهِ فَخَلُّوا سَبِيلَهُ ، فَإِنَّمَا أُمِرْتُ أَنْ أُقَاتِلَ النَّاسَ حَتَّى يَقُولُوا : لَا إِلَهَ إِلَّا اللهُ ، فَإِذَا فَعَلُوا ذَلِكَ ، حُرِّمَ عَلَيَّ دِمَاؤُهُمْ ، وَأَمْوَالُهُمْ بِحَقِّهَا ، وَكَانَ حِسَابُهُمْ عَلَى اللهِ  .","","Al-Mu'jam al-Kabir 595","","أوس بن أبي أوس الطائفي عن عمرو بن أوس بن أبي أوس الثقفي عن النعمان بن سالم الطائفي عن سماك بن حرب البكري عن حاتم بن أبي صغيرة القشيري عن عبد الله بن بكر بن حبيب عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب تعظيم قول لا إله إلا الله وأن محمدا رسول الله"
"597","بَابٌ  596  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  عُمَيْرِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ الْمُغِيرَةِ الطَّائِفِيِّ ،  عَنْ  أَوْسِ بْنِ أَوْسٍ الثَّقَفِيِّ ، قَالَ :  أَقَمْنَا عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نِصْفَ شَهْرٍ ، فَرَأَيْتُهُ يَنْفَتِلُ عَنْ يَمِينِهِ  ، وَرَأَيْتُهُ يَنْفَتِلُ عَنْ يَسَارِهِ ، وَرَأَيْتُ نَعْلَيْهِ ، لَهُ  قِبَالَانِ  .","","Al-Mu'jam al-Kabir 596","","أوس بن أوس الثقفي عن عبد الملك بن المغيرة الطائفي عن عمير بن عبد الله بن بشر الخثعمي عن قيس بن الربيع الأسدي عن إسماعيل بن عمرو البجلي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","باب"
"598","597  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَا :  أَخْبَرَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  عُمَيْرِ بْنِ عَبْدِ اللهِ الْخَثْعَمِيِّ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ الْمُغِيرَةِ الطَّائِفِيِّ ،  عَنْ  أَوْسِ بْنِ أَوْسٍ ، قَالَ :  أَقَمْتُ عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نِصْفَ شَهْرٍ ، فَرَأَيْتُهُ يُصَلِّي ، وَعَلَيْهِ نِعَالَانِ مُقَابِلَتَانِ  ، وَرَأَيْتُهُ يَبْزُقُ عَنْ يَمِينِهِ ، وَعَنْ شِمَالِهِ  .","","Al-Mu'jam al-Kabir 597","","أوس بن أوس الثقفي عن عبد الملك بن المغيرة الطائفي عن عمير بن عبد الله بن بشر الخثعمي عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"599","بَابٌ فِيمَا أَعَدَّ اللهُ  لِعُثْمَانَ بْنِ عَفَّانَ  رَضِيَ اللهُ عَنْهُ فِي الْجَنَّةِ  598  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  إِسْحَاقُ بْنُ وَهْبٍ الْعَلَّافُ ،  ثَنَا  الْفَضْلُ بْنُ سَوَّارٍ الْبَصْرِيُّ ،  ثَنَا  لَيْثُ بْنُ سَعْدٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  مَرْثَدِ بْنِ عَبْدِ اللهِ الْيَزَنِيِّ ،  عَنْ  أَوْسِ بْنِ أَوْسٍ الثَّقَفِيِّ ، قَالَ : قَالَ         [1/220]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  بَيْنَا أَنَا جَالِسٌ إِذْ جَاءَنِي  جِبْرِيلُ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَحَمَلَنِي فَأَدْخَلَنِي جَنَّةَ رَبِّي - عَزَّ وَجَلَّ -  فَبَيْنَا أَنَا جَالِسٌ إِذْ جُعِلَتْ فِي يَدِي تُفَّاحَةٌ ، فَانْفَلَقَتِ التُّفَّاحَةُ بِنِصْفَيْنِ ، فَخَرَجَتْ مِنْهَا جَارِيَةٌ لَمْ أَرَ جَارِيَةً أَحْسَنَ مِنْهَا حُسْنًا ، وَلَا أَجْمَلَ مِنْهَا جَمَالًا ، تُسَبِّحُ تَسْبِيحًا لَمْ يَسْمَعِ الْأَوَّلُونَ وَالْآخِرُونَ بِمِثْلِهِ ، فَقُلْتُ : مَنْ أَنْتِ يَا جَارِيَةُ ؟ قَالَتْ : أَنَا مِنَ  الْحُورِ  الْعِينِ  خَلَقَنِي اللهُ - عَزَّ وَجَلَّ - مِنْ نُورِ عَرْشِهِ ، فَقُلْتُ : لِمَنْ أَنْتِ ؟ قَالَتْ : لِلْخَلِيفَةِ الْمَظْلُومِ  عُثْمَانَ بْنِ عَفَّانَ  - رَضِيَ اللهُ عَنْهُ -  .","","Al-Mu'jam al-Kabir 598","","أوس بن أوس الثقفي عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن الفضل بن سوار البصري عن إسحاق بن وهب العلاف عن الحسين بن إسحاق التستري عن الطبراني","باب فيما أعد الله لعثمان بن عفان رضي الله عنه في الجنة"
"600","24 -  أَوْسُ بْنُ حُذَيْفَةَ الثَّقَفِيُّ  - رَضِيَ اللهُ عَنْهُ - .  بَابٌ فِي فَضْلِ قِرَاءَةِ الْقُرْآنِ  599  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ الطَّائِفِيُّ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  حَدَّثَنَا  مُسَدَّدٌ ،  ثَنَا  قُرَّانُ بْنُ تَمَّامٍ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ إِسْحَاقُ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ يَعْلَى الطَّائِفِيُّ ،  عَنْ  عُثْمَانَ بْنِ عَبْدِ اللهِ بْنِ أَوْسٍ الثَّقَفِيِّ ،  عَنْ  جَدِّهِ أَوْسِ بْنِ حُذَيْفَةَ ، قَالَ :  قَدِمْنَا عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَفْدَ  ثَقِيفٍ  ، فَأُنْزِلْنَا عَلَيْهِ فِي  قُبَّةٍ  لَهُ ، فَنَزَلَ إِخْوَانُنَا مِنَ الْأَحْلَافِ عَلَى  الْمُغِيرَةِ بْنِ شُعْبَةَ  ، فَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْتِينَا بَعْدَ الْعِشَاءِ فَيُحَدِّثُنَا ، وَكَانَ أَكْثَرُ حَدِيثِهِ تَشْكِيَةَ  قُرَيْشٍ  ، وَيَقُولُ :  وَلَا سَوَاءٌ كُنَّا  بِمَكَّةَ  مُسْتَذَلِّينَ مُسْتَضْعَفِينَ ، فَلَمَّا أَتَيْنَا  الْمَدِينَةَ  كَانَتِ الْحَرْبُ سِجَالًا عَلَيْنَا وَلَنَا  فَأَبْطَأَ عَلَيْنَا ذَاتَ لَيْلَةٍ ، فَأَطْوَلَ ، فَقُلْنَا : يَا رَسُولَ اللهِ لَقَدْ أَبْطَأْتَ ، فَقَالَ : "" إِنَّهُ  طَرَأَ  عَلَيَّ  حِزْبِي  مِنَ الْقُرْآنِ ، فَكَرِهْتُ أَنْ أَخْرُجَ حَتَّى أَقْضِيَهُ "" فَسَأَلْنَا أَصْحَابَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : كَيْفَ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُحَزِّبُ الْقُرْآنَ ؟ فَقَالُوا : كَانَ يُحَزِّبُهُ ثَلَاثًا ، وَخَمْسًا ، وَسَبْعًا ،         [1/221]      وَتِسْعًا ، وَإِحْدَى عَشْرَةَ ، وَثَلَاثَ عَشْرَةَ ، وَحِزْبَ الْمُفَصَّلِ .","","Al-Mu'jam al-Kabir 599","","أوس بن أبي أوس الطائفي عن عثمان بن عبد الله بن أوس الطائفي عن عبد الله بن عبد الرحمن بن يعلى الطائفي عن قران بن تمام الوالبي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب في فضل قراءة القرآن"
