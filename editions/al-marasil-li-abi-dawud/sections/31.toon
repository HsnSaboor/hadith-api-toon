hadiths[16]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"169","[1/162]      31 - فِي الْمُفْلِسِ  170  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ ثَوْرٍ ،  عَنْ  مَعْمَرٍ .  عَنِ  الزُّهْرِيِّ قَالَ :  كَانَتْ تَكُونُ عَلَى عَهْدِ [رَسُولِ اللهِ]  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دُيُونٌ عَلَى رِجَالٍ  ، مَا عَلِمْنَا حُرًّا بِيعَ فِي دَيْنٍ  ( 19384 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: باب المفلس .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: النبي .","","Al-Marasil li-Abi Dawud 170","","الزهري عن معمر بن راشد عن محمد بن ثور الصنعاني عن محمد بن عبيد بن حساب الغبري عن أبو داود السجستاني","فِي المفلس"
"170","171  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ الْمَهْرِيُّ ،  حَدَّثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  يُونُسُ بْنُ يَزِيدَ ،  عَنِ  ابْنِ شِهَابٍ .  أَخْبَرَنِي  عَبْدُ الرَّحْمَنِ بْنُ كَعْبِ بْنِ مَالِكٍ ،  أَنَّ  مُعَاذَ بْنَ جَبَلٍ  - وَهُوَ أَحَدُ قَوْمِهِ  بَنِي سَلِمَةَ  - كَثُرَ دَيْنُهُ فِي عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَلَمْ يَزِدْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ غُرَمَاءَهُ عَلَى أَنْ خَلَعَ لَهُمْ مَالَهُ  ( 18971 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: أنا .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال أخبرني .","","Al-Marasil li-Abi Dawud 171","","عبد الرحمن بن كعب بن مالك السلمي عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن وهب المصري عن سليمان بن داود المهري عن أبو داود السجستاني","فِي المفلس"
"171","172  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُتَوَكِّلِ الْعَسْقَلَانِيُّ ، [وَمُحَمَّدُ بْنُ دَاوُدَ بْنِ سُفْيَانَ]  ، قَالَا :  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  أَخْبَرَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ .  عَنِ  ابْنِ كَعْبِ بْنِ مَالِكٍ ، وَسَمَّاهُ  ابْنُ دَاوُدَ  :  عَبْدَ الرَّحْمَنِ  ،  أَنَّ  مُعَاذَ بْنَ جَبَلٍ  ، لَمْ يَزَلْ يَدَّانُ حَتَّى أَغْلَقَ مَالَهُ كُلُّهُ  ، فَأَتَى غُرَمَاؤُهُ إِلَى النَّبِيِّ         [1/163]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَطَلَبَ  مُعَاذٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَسْأَلَ غُرَمَاءَهُ أَنْ يَضَعُوا أَوْ يُؤَخِّرُوا ، فَأَبَوْا ، فَلَوْ تَرَكُوا لِأَحَدٍ مِنْ أَجْلِ أَحَدٍ لَتُرِكَ  لِمُعَاذٍ  مِنْ أَجْلِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَبَاعَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَالَهُ كُلَّهُ فِي دَيْنِهِ ، حَتَّى قَامَ  مُعَاذٌ  بِغَيْرِ شَيْءٍ  .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: وابن داود .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: لتركوا .","","Al-Marasil li-Abi Dawud 172","","عبد الرحمن بن كعب بن مالك السلمي عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن محمد بن داود بن سفيان عن أبو داود السجستاني","فِي المفلس"
"172","173  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ ،  [حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ]  ،  أَخْبَرَنِي  يُونُسُ ،  عَنِ  ابْنِ شِهَابٍ .  أَخْبَرَنِي  أَبُو بَكْرِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَضَى بِمَعْنَى حَدِيثِ  الزُّهْرِيِّ  ، زَادَ :  وَإِنْ كَانَ فَضَلَ  مِنْ ثَمَنِهَا شَيْءٌ  فَهُوَ أُسْوَةُ الْغُرَمَاءِ  ، قَالَ  أَبُو بَكْرٍ  :  وَقَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ مَنْ تُوُفِّيَ وَعِنْدَهُ سِلْعَةُ رَجُلٍ بِعَيْنِهَا  لَمْ يَقْضِ مِنْ ثَمَنِهَا شَيْئًا ، فَصَاحِبُ         [1/164]      السِّلْعَةِ أُسْوَةُ الْغُرَمَاءِ فِيهَا  ( 19565 )  .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: أنا عبد الله - يعني ابن وهب .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قضي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: شيئا .  في طبعة دار الصميعي زيادة حديث برقم 162 / 2 : حدثنا القعنبي عن مالك عن ابن شهاب عن أبي بكر بن عبد الرحمن بن الحارث بن هشام أن رسول الله صلى الله عليه وسلم قال : أيما رجل باع متاعا فأفلس الذي ابتاعه ولم يقبض الذي باعه من ثمنه شيئا فوجد متاعه بعينه فهو أحق به ، وإن مات المشتري بعد فصاحب المتاع أسوة الغرماء . سمعت أبا داود يقول : روي مسندا وليس بالقوي ، وروي مسندا قصة الموت وهو لا يصح مسندا ، وقصة الإفلاس مشهور صحيح مسند .","","Al-Marasil li-Abi Dawud 173","","أبو بكر بن عبد الرحمن راهب قريش عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن وهب المصري عن سليمان بن داود المهري عن أبو داود السجستاني","فِي المفلس"
"173","174  -  -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ عَبْدِ الْأَعْلَى ،  عَنْ  بُرْدٍ .  عَنْ  سُلَيْمَانَ بْنِ مُوسَى ، قَالَ :  مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  رَجُلٍ  يَبِيعُ طَعَامًا مَعْلُوثًا  فِيهِ شَعِيرٌ ، فَقَالَ :  اعْزِلْ هَذَا مِنْ هَذَا  ، وَهَذَا مِنْ هَذَا ، ثُمَّ         [1/165]      بِعْ ذَا كَيْفَ شِئْتَ ; فَإِنَّهُ لَيْسَ فِي دِينِنَا غِشٌّ  ( 18788 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي قبل رقم الحديث قوله: باب الغش .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: مغلوثا .","","Al-Marasil li-Abi Dawud 174","","سليمان بن موسى الأشدق عن برد بن سنان عن عبد الأعلى بن عبد الأعلى القرشي عن أبو بكر ابن أبي شيبة عن أبو داود السجستاني","فِي المفلس"
"174","175  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مَسْعَدَةَ التُّنُوخِيُّ ، [حِينَ أَتَى قَوْمَهُ مِنْ  أَهْلِ حَلَبٍ]  ،  حَدَّثَنَا  أَبُو تَوْبَةَ ،  حَدَّثَنَا  مُصْعَبُ [بْنُ مَاهَانَ]  الْعَسْقَلَانِيُّ ،  عَنْ  سُفْيَانَ ،  عَنْ  مُحَمَّدِ بْنِ رَاشِدٍ .  عَنْ  مَكْحُولٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ عَلَى  رَجُلٍ  يَبِيعُ حِنْطَةً يَخْلِطُ الْجَيِّدَ بِالرَّدِيءِ  ، فَنَهَاهُ وَقَالَ :  مَيِّزْ كُلَّ وَاحِدٍ عَلَى  حِدَةٍ  ( 19480 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: ختن أبي توبة من أهل حلب .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: يعني ابن ماهان .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: بالدنيء .","","Al-Marasil li-Abi Dawud 175","","مكحول بن أبي مسلم عن محمد بن راشد المكحولي عن سفيان الثوري عن مصعب بن ماهان العسقلاني عن الربيع بن نافع الحلبي عن إسماعيل بن مسعدة التنوخي عن أبو داود السجستاني","فِي المفلس"
"175","176  -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  عَنْ  خَالِدٍ ،  عَنْ  يُونُسَ .  عَنِ  الْحَسَنِ ، قَالَ :  نَهَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يُشَابَ لَبَنٌ لِبَيْعٍ  ( 18569 ) .         [1/166]      قَالَ أَبُو دَاوُدَ :  وَهَكَذَا  رَوَاهُ  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ  أَيْضًا عَنْ  يُونُسَ  ، وَرَوَاهُ ،  حَمَّادُ بْنُ سَلَمَةَ  عَنْ  يُونُسَ  ، عَنِ  الْحَسَنِ  ، قَالَ : قَالَ  عُمَرُ  .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: هكذا .","","Al-Marasil li-Abi Dawud 176","","الحسن البصري عن يونس بن عبيد عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو داود السجستاني","فِي المفلس"
"176","177  -  حَدَّثَنَا  عَبْدُ السَّلَامِ بْنُ عَتِيقٍ الدِّمَشْقِيُّ ،  حَدَّثَنَا  أَبُو مُسْهِرٍ ،  حَدَّثَنِي  يَحْيَى بْنُ حَمْزَةَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ الْوَلِيدِ الزُّبَيْدِيُّ  عَنِ  الزُّهْرِيِّ .  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ بَيْعِ الْحَيِّ بِالْمَيِّتِ  ( 18736 ) .","","Al-Marasil li-Abi Dawud 177","","سعيد بن المسيب عن الزهري عن محمد بن الوليد بن عامر الزبيدي عن يحيى بن حمزة بن البتلهي عن عبد الأعلى بن مسهر الغساني عن عبد السلام بن عتيق العنسي عن أبو داود السجستاني","فِي المفلس"
"177","178  -  حَدَّثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ .         [1/167]      عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ بَيْعِ اللَّحْمِ بِالْحَيَوَانِ  ( 18704 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: نا .","","Al-Marasil li-Abi Dawud 178","","سعيد بن المسيب عن زيد بن أسلم عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن أبو داود السجستاني","فِي المفلس"
"178","179  -  حَدَّثَنَا  أَحْمَدُ بْنُ سَعِيدٍ الْهَمَذَانِيُّ  ، وَسُلَيْمَانُ بْنُ دَاوُدَ الْمَهْرِيُّ ، قَالَا :  أَخْبَرَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  [أَبُو يُونُسَ]  مُوسَى بْنُ شَيْبَةَ الْحَضْرَمِيُّ  عَنْ  يُونُسَ بْنِ يَزِيدَ ،  عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ الْأَنْصَارِيِّ .  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ خَرَجَ هُوَ  وَأَبُو بَكْرٍ  مِنْ  مَكَّةَ  مُهَاجِرَيْنِ  إِلَى  الْمَدِينَةِ  مَرَّا بِرَاعِي غَنَمٍ فَاشْتَرَيَا  مِنْهُ شَاةً وَشَرَطَ أَنَّ سَلَبَهَا لَهُ  ( 19012 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: الهمداني .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: نا .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: معه من .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: فاشترى .","","Al-Marasil li-Abi Dawud 179","","عروة بن الزبير عن عمارة بن غزية عن يونس بن يزيدالأيلي عن موسى بن شيبة الحضرمي عن عبد الله بن وهب المصري عن سليمان بن داود المهري عن أبو داود السجستاني","فِي المفلس"
"179","180  -  حَدَّثَنَا  أَحْمَدُ بْنُ سَعِيدٍ ، وَسُلَيْمَانُ بْنُ دَاوُدَ ،  أَخْبَرَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  اللَّيْثُ ،  عَنْ  يُونُسَ بْنِ يَزِيدَ ،  عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ....( 19012 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قالا نا .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: بهذا .","","Al-Marasil li-Abi Dawud 180","","عمارة بن غزية عن يونس بن يزيدالأيلي عن الليث بن سعد عن عبد الله بن وهب المصري عن سليمان بن داود المهري عن أبو داود السجستاني","فِي المفلس"
"180","181  -  حَدَّثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ .  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنِ اسْتِئْجَارِ         [1/168]      الْأَجِيرِ وَلَمْ  يُبَيِّنْ  ،  [يَعْنِي حَتَّى يُبَيِّنَ]  لَهُ أَجْرَهُ  ( 3958 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال نا .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: يعني ولم .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .","","Al-Marasil li-Abi Dawud 181","","أبو سعيد الخدري عن إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن موسى بن إسماعيل التبوذكي عن أبو داود السجستاني","فِي المفلس"
"181","182  -  حَدَّثَنَا  أَحْمَدُ بْنُ أَبِي شُعَيْبٍ الْحَرَّانِيُّ ،  حَدَّثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عِكْرِمَةَ .  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَا تَبِعْ أَصْوَافَ الْغَنَمِ عَلَى ظُهُورِهَا  ، وَلَا تَبِعْ أَلْبَانَهَا فِي ضُرُوعِهَا  ( 6174 ) .","","Al-Marasil li-Abi Dawud 182","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن أحمد بن عبد الله بن مسلم عن أبو داود السجستاني","فِي المفلس"
"182","183  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَلَاءِ ،  حَدَّثَنَا  ابْنُ مُبَارَكٍ  ،  عَنْ  عُمَرَ بْنِ فَرُّوخَ .  عَنْ  عِكْرِمَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِمَعْنَاهُ ( 19118 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: المبارك .","","Al-Marasil li-Abi Dawud 183","","عكرمة مولى ابن عباس عن عمر بن فروخ القتاب عن عبد الله بن المبارك عن أبو كريب محمد بن العلاء عن أبو داود السجستاني","فِي المفلس"
"183","[1/169]      184  -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  عُمَرُ بْنُ فَرُّوخَ ،  عَنْ  حَبِيبِ بْنِ الزُّبَيْرِ .  عَنْ  عِكْرِمَةَ ، قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَعْطَى الْحَجَّامَ عُمَالَتَهُ دِينَارًا  ( 19109 )  .  في طبعة دار الصميعي زيادة حديث برقم 173 وهو : حدثنا أبو صالح نا أبو إسحاق عن ابن جريج عن هارون ابن أبي عائشة أن النبي صلى الله عليه وسلم قال : من أقال نادما أقاله الله نفسه يوم القيامة . سمعت أبا داود يقول : روي متصلا ، وليس بصحيح .","","Al-Marasil li-Abi Dawud 184","","عكرمة مولى ابن عباس عن حبيب بن الزبير بن مشكان الهلالي عن عمر بن فروخ القتاب عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو داود السجستاني","فِي المفلس"
"184","185  -  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ ،  حَدَّثَنَا  أَبُو عَاصِمٍ ،  عَنْ  عِكْرِمَةَ بْنِ عَمَّارٍ ،         [1/170]      حَدَّثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         {      فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا         }      قَالَ :  إِنْ عَلِمْتُمْ مِنْهُمْ  حِرْفَةً  ، وَلَا تُرْسِلُوهُمْ  كَلًّا  عَلَى النَّاسِ .  ( 19453 )  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي قبل رقم الحديث قوله: باب في المكاتب .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال نا .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: فيهم .","","Al-Marasil li-Abi Dawud 185","","يحيى بن أبي كثير عن عكرمة بن عمار عن أبو عاصم النبيل عن الحسن بن علي الريحاني عن أبو داود السجستاني","فِي المفلس"
