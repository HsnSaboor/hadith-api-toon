"19010","(۱۹۰۱۰) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ سَعِیدٍ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ قَالَ فِی الْمُخْتَلِعَۃِ الْحَامِلِ : لَہَا النَّفَقَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 19010","","","كتاب الجنة"
"19011","(۱۹۰۱۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ وَجَابِرِ بْنِ عَبْدِ اللہِ قَالُوا : لاَ نَفَقَۃَ لَہَا۔","","Musannaf Ibn Abi Shaybah 19011","","","كتاب الجنة"
"19012","(۱۹۰۱۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الْحُرَّۃِ تَحْتَ الْعَبْدِ وَالأَمَۃِ تَحْتَ الْحُرِّ یُطَلَّقَانِ وَہُمَا حَامِلاَنِ ، لَہُمَا النَّفَقَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 19012","","","كتاب الجنة"
"19013","(۱۹۰۱۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ فِی الْعَبْدِ یُطَلِّقُ امْرَأَتَہُ وَہِیَ حَامِلٌ قَالَ : عَلَیْہِ النَّفَقَۃُ حَتَّی تَضَعَ۔","","Musannaf Ibn Abi Shaybah 19013","","","كتاب الجنة"
"19014","(۱۹۰۱۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ قَالَ : إذَا طَلَّقَ الْعَبْدُ امْرَأَتَہُ وَہِیَ حرۃ أَنْفَقَ عَلَیْہَا حَتَّی تَضَعَ فَإِذَا وَضَعَتْ لَمْ یُنْفِقْ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 19014","","","كتاب الجنة"
"19015","(۱۹۰۱۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ : الْحُرُّ إذَا کَانَتْ تَحْتَہُ الأَمَۃُ فَطَلَّقَہَا ، فَإِنَّ عَلَیْہِ النَّفَقَۃَ حَتَّی تَضَعَ وَلَیْسَ عَلَیْہِ أَجْرُ الرَّضَاعِ۔","No Data Available","Musannaf Ibn Abi Shaybah 19015","","","كتاب الجنة"
"19016","(۱۹۰۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ زَیْدِ بْنِ الْحَارِثِ ، عَنْ شُرَیْحٍ أَنَّ رَجُلاً طَلَّقَ وَلَمْ یَفْرِضْ وَلَمْ یَدْخُلْ فَجَبَرَہُ شُرَیْحٌ عَلَی الْمُتْعَۃِ۔","","Musannaf Ibn Abi Shaybah 19016","","","كتاب الجنة"
"19017","(۱۹۰۱۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ عَمَّنْ حَدَّثَہُ ، عَنِ ابْنِ مغفل قَالَ : إنَّمَا یُجْبَرُ عَلَی الْمُتْعَۃِ مَنْ طَلَّقَ وَلَمْ یَفْرِضْ وَلَمْ یَدْخُلْ۔","Da'if","Musannaf Ibn Abi Shaybah 19017","","","كتاب الجنة"
"19018","(۱۹۰۱۸) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ قَالَ : إذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ وَلَمْ یَفْرِضْ لَہَا وَلَمْ یَدْخُلْ بِہَا جُبِرَ عَلَی أَنْ یُمَتِّعَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 19018","","","كتاب الجنة"
"19019","(۱۹۰۱۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْحَجَّاجِ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ قَالَ : إنَّمَا یُجْبَرُ عَلَی الْمُتْعَۃِ مَنْ طَلَّقَ وَلَمْ یَفْرِضْ وَلَمْ یَدْخُلْ۔","No Data Available","Musannaf Ibn Abi Shaybah 19019","","","كتاب الجنة"
"19020","(۱۹۰۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ قَالَ : یُمَتِّعُہَا بِمِثْلِ نِصْفِ مَہْرِ مِثْلِہَا۔","","Musannaf Ibn Abi Shaybah 19020","","","كتاب الجنة"
"19021","(۱۹۰۲۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ قَالَ : إذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ قَبْلَ أَنْ یَدْخُلَ بِہَا ، وَقَبْلَ أَنْ یَفْرِضَ لَہَا فَلَیْسَ لَہَا إلاَّ الْمَتَاعُ۔","Sahih","Musannaf Ibn Abi Shaybah 19021","","","كتاب الجنة"
"19022","(۱۹۰۲۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ فِیمَنْ طَلَّقَ وَلَمْ یَفْرِضْ قَبْلَ أَنْ یَدْخُلَ قَالَ : لَہَا الْمُتْعَۃُ ، وَقَالَ ابْنُ سِیرِینَ : لَہَا مَعَ الْمُتْعَۃِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 19022","","","كتاب الجنة"
"19023","(۱۹۰۲۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : لِکُلِّ مُطَلَّقَۃٍ مُتْعَۃٌ إلاَّ الَّتِی طُلِّقَتْ قَبْلَ أَنْ یَدْخُلَ بِہَا ، فَإِنَّ لَہَا نِصْفَ الصَّدَاقِ۔","Sahih","Musannaf Ibn Abi Shaybah 19023","","","كتاب الجنة"
"19024","(۱۹۰۲۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : لِکُلِّ مُطَلَّقَۃٍ متعۃ دَخَلَ بِہَا ، أَوْ لَمْ یَدْخُلْ ، فَرَضَ لَہَا ، أَوْ لَمْ یَفْرِضْ لَہَا۔","","Musannaf Ibn Abi Shaybah 19024","","","كتاب الجنة"
"19025","(۱۹۰۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَعْفَرٍ الرَّازِیّ ، عَنْ الربیع عن أَبِی الْعَالِیَۃِ قَالَ : لِکُلِّ مُطَلَّقَۃٍ مَتَاعٌ۔","","Musannaf Ibn Abi Shaybah 19025","","","كتاب الجنة"
"19026","(۱۹۰۲۶) حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ : لِکُلِّ مُطَلَّقَۃٍ مُتْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 19026","","","كتاب الجنة"
"19027","(۱۹۰۲۷) حَدَّثَنَا یَزِیدُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ قَالَ : قُلْتُ لِسَعِیدِ بْنِ الْمُسَیَّبِ : إنَّ الْحَسَنَ وَأَبَا الْعَالِیَۃِ یَجْعَلاَنِ لِلْمُطَلَّقَۃِ الَّتِی قَدْ دُخِلَ بِہَا الْمَتَاعَ وَالَّتِی لَمْ یُدْخَلْ بِہَا الْمَتَاعَ ، فَقَالَ سَعِیدٌ : إنَّمَا کَانَ لَہَا فِی سُورَۃِ الأَحْزَابِ فَلَمَّا نَزَلَتْ سُورَۃُ الْبَقَرَۃِ جُعِلَ لِلَّتِی فُرِضَ لَہَا نِصْفُ الصَّدَاقِ وَلاَ مُتْعَۃَ لَہَا۔","","Musannaf Ibn Abi Shaybah 19027","","","كتاب الجنة"
"19028","(۱۹۰۲۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : لِکُلِّ مُطَلَّقَۃٍ مَتَاعٌ إلاَّ الَّتِی طُلِّقَتْ وَقَدْ فُرِضَ لَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 19028","","","كتاب الجنة"
"19029","(۱۹۰۲۹) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عَطَائٍ قَالَ : سُئِلَ : الرَّجُلُ یُطَلِّقُ امْرَأَتَہُ وَقَدْ فَرَضَ قَبْلَ أَنْ یَدْخُلَ بِہَا ، لَہَا مَتَاعٌ ؟ قَالَ : کَانَ عَطَائٌ یَقُولُ : لاَ مَتَاعَ لَہَا۔","","Musannaf Ibn Abi Shaybah 19029","","","كتاب الجنة"
"19030","(۱۹۰۳۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ قَالَ : إذَا طَلَّقَ الرَّجُلُ الْمَرْأَۃَ وَقَدْ فَرَضَ لَہَا فَلَہَا نِصْفُ الصَّدَاقِ وَلاَ مَتَاعَ لَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 19030","","","كتاب الجنة"
"19031","(۱۹۰۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْمَسْعُودِیِّ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، عَنْ شُرَیْحٍ قَالَ : إنَّ لَہَا فِی النِّصْفِ لَمَتَاعًا یَعْنِی الَّتِی لَمْ یُدْخَلْ بِہَا۔","","Musannaf Ibn Abi Shaybah 19031","","","كتاب الجنة"
"19032","(۱۹۰۳۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ صَالِحِ بْنِ إبْرَاہِیمَ أَنَّ عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ حَمَّم امْرَأَتَہُ الَّتِی طَلَّقَ جَارِیَۃً سَوْدَائَ۔","","Musannaf Ibn Abi Shaybah 19032","","","كتاب الجنة"
"19033","(۱۹۰۳۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ أَنَّہُ بَلَغَہُ أَنَّ أَنَسَ بْنَ مَالِکٍ مَتَّعَ امْرَأَتَہُ بِثَلاَثِ مِئَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 19033","","","كتاب الجنة"
"19034","(۱۹۰۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الْعُمَیْسِ ، عَنِ الْحَسَنِ بْنِ سَعْدٍ ، عَنْ أَبِیہِ أَنَّ الْحَسَنَ بْنَ عَلِیٍّ مَتَّعَ امْرَأَتَہُ بِعَشَرَۃِ آلاَفٍ۔","Da'if","Musannaf Ibn Abi Shaybah 19034","","","كتاب الجنة"
"19035","(۱۹۰۳۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ إیَاسٍ ، عَنْ أَبِی مجلَز قَالَ : سَأَلْتُ ابْنَ عُمَرَ ، عَنِ الْمُتْعَۃِ قَالَ : عَدَّ کَذَا عَدَّ کَذَا حَتَّی عَدَّ ثَلاَثِینَ۔","Hasan","Musannaf Ibn Abi Shaybah 19035","","","كتاب الجنة"
"19036","(۱۹۰۳۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ أَنَّہُ طَلَّقَ امْرَأَتَہُ فَمَتَّعَہَا بِثَلاَثِ مِئَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 19036","","","كتاب الجنة"
"19037","(۱۹۰۳۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ أَنَّہُ طَلَّقَ امْرَأَتَہُ فَمَتَّعَہَا بِثَلاَثِ مِئَۃٍ۔","","Musannaf Ibn Abi Shaybah 19037","","","كتاب الجنة"
"19038","(۱۹۰۳۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاْہِیْمَ ، عَنِ الأَسْوَدِ أَنَّہُ مَتَّعَ بِثَلاَثِ مِئَۃٍ۔","","Musannaf Ibn Abi Shaybah 19038","","","كتاب الجنة"
