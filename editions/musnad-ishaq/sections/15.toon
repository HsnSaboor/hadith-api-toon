hadiths[22]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"484","أَخْبَرَنَا عَبْدَةُ بْنُ سُلَيْمَانَ، نا سَعِيدُ بْنُ أَبِي عَرُوبَةَ، عَنْ قَتَادَةَ، عَنِ النَّضْرِ بْنِ أَنَسٍ، عَنْ بَشِيرِ بْنِ نَهِيكٍ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: الْعُمْرَى مِيرَاثٌ لِأَهْلِهَا أَوْ جَائِزَةٌ لِأَهْلِهَا.","","Musnad Ishaq ibn Rahwayh 484","","","Description of ‘Umra (gift for a lifetime)"
"485","أَخْبَرَنَا مُعَاذُ بْنُ هِشَامٍ، حَدَّثَنِي أَبِي، عَنْ قَتَادَةَ، قَالَ: سَأَلَنِي سُلَيْمَانُ بْنُ هِشَامٍ عَنِ الْعُمْرَى، فَقُلْتُ: حَدَّثَ مُحَمَّدُ بْنُ سِيرِينَ، عَنْ شُرَيْحٍ، قَالَ: قَضَى رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْعُمْرَى أَنَّهَا جَائِزَةٌ.","","Musnad Ishaq ibn Rahwayh 485","","","Description of ‘Umra (gift for a lifetime)"
"486","وَحَدَّثَ النَّضْرُ بْنُ أَنَسٍ، عَنْ بَشِيرِ بْنِ نَهِيكٍ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ أَنَّ رَسُولَ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: الْعُمْرَى جَائِزَةٌ.","","Musnad Ishaq ibn Rahwayh 486","","","Description of ‘Umra (gift for a lifetime)"
"487","قَالَ قَتَادَةُ: وَكَانَ الْحَسَنُ يَقُولُ: الْعُمْرَى جَائِزَةٌ.","","Musnad Ishaq ibn Rahwayh 487","","","Description of ‘Umra (gift for a lifetime)"
"488","قَالَ قَتَادَةُ: قَالَ الزُّهْرِيُّ: إِنَّمَا الْعُمْرَى أَنْ يَقُولَ هِيَ لَهُ وَلِعَقِبِهِ مِنْ بَعْدِهِ فَلِلَّذِي يَجْعَلُ شَرْطُهُ.","","Musnad Ishaq ibn Rahwayh 488","","","Description of ‘Umra (gift for a lifetime)"
"489","قَالَ: فَسُئِلَ عَطَاءُ بْنُ أَبِي رَبَاحٍ، فَقَالَ: حَدَّثَنِي جَابِرُ بْنُ عَبْدِ اللَّهِ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: الْعُمْرَى جَائِزَةٌ.","","Musnad Ishaq ibn Rahwayh 489","","","Description of ‘Umra (gift for a lifetime)"
"490","فَقَالَ: الزُّهْرِيُّ كَانَ الْخُلَفَاءُ يَقْضُونَ بِهِ، قَالَ عَطَاءٌ: قَضَى بِهِ عَبْدُ الْمَلِكِ بْنُ مَرْوَانَ وَغَيْرُهُ.","","Musnad Ishaq ibn Rahwayh 490","","","Description of ‘Umra (gift for a lifetime)"
"491","أَخْبَرَنَا النَّضْرُ، نا شُعْبَةُ، عَنْ قَتَادَةَ، قَالَ: سَمِعْتُ عَطَاءً، يُحَدِّثُ عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: الْعُمْرَى جَائِزَةٌ.","","Musnad Ishaq ibn Rahwayh 491","","","Description of ‘Umra (gift for a lifetime)"
"492","أَخْبَرَنَا أَبُو عَامِرٍ الْعَقَدِيُّ، نا هَمَّامُ بْنُ يَحْيَى، عَنْ قَتَادَةَ، عَنْ عَبْدِ الْمَلِكِ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((مَنْ عُرِضَ عَلَيْهِ شَيْءٌ مِنْ غَيْرِ مَسْأَلَةٍ فَلْيَقْبَلْهُ فَإِنَّمَا هُوَ رِزْقٌ سَاقَهُ اللَّهُ إِلَيْهِ)).","","Musnad Ishaq ibn Rahwayh 492","","","If something is given without asking, accept it"
"493","قَالَ: أنا أَبُو مُحَمَّدٍ هِبَةُ اللَّهِ بْنُ سَعِيدِ بْنِ هِبَةِ اللَّهِ بِقِرَاءَتِي عَلَيْهِ فِي سَنَةِ أَرْبَعٍ وَثَلَاثِينَ وَخَمْسِمِائَةٍ، قَالَ: أَخْبَرَنَا أَبُو عَلِيٍّ الْحَسَنُ بْنُ أَحْمَدَ بْنِ مُحَمَّدِ بْنِ مُحَمَّدٍ الصَّفَّارُ قِرَاءَةً سَنَةَ سِتٍّ وَسِتِّينَ وَأَرْبَعمِائَةٍ، قَالَ: أنا أَبُو سَعِيدٍ عَبْدُ الرَّحْمَنِ بْنُ حَمْدَانَ النَّصْرَوِيُّ، قَالَ: أنا أَبُو مُحَمَّدٍ عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ عَلِيِّ بْنِ زِيَادٍ السِّمِّذِيُّ قَالَ: أنا أَبُو مُحَمَّدٍ عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ شِيرَوَيْهِ قَالَ: حَدَّثَنَا الْإِمَامُ أَبُو يَعْقُوبَ إِسْحَاقُ بْنُ رَاهَوَيْهِ الْحَنْظَلِيُّ، أنا عِيسَى بْنُ يُونُسَ، نا الْأَعْمَشُ، عَنْ أَبِي حَازِمٍ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((لَوْ أُهْدِيَ إِلَيَّ ذِرَاعٌ لَقَبِلْتُ وَلَوْ دُعِيتُ إِلَى كُرَاعٍ لَأَجَبْتُ)).","","Musnad Ishaq ibn Rahwayh 493","","","Description of accepting invitations"
"494","أَخْبَرَنَا أَبُو مُعَاوِيَةَ، نا الْأَعْمَشُ، بِهَذَا الْإِسْنَادِ مِثْلَهُ.","","Musnad Ishaq ibn Rahwayh 494","","","Description of accepting invitations"
"495","أَخْبَرَنَا جَرِيرٌ، عَنِ الْأَعْمَشِ، عَنْ أَبِي حَازِمٍ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((لَوْ أُهْدِيَ إِلَيَّ كُرَاعٌ لَقَبِلْتُ)) ، قَالَ جَرِيرٌ: وَأَرَاهُ قَالَ: ((لَوْ دُعِيتُ إِلَى ذِرَاعٍ لَأَجَبْتُ)).","","Musnad Ishaq ibn Rahwayh 495","","","Description of accepting invitations"
"496","أَخْبَرَنَا النَّضْرُ، نا عَوْفُ بْنُ أَبِي جَمِيلَةَ الْأَعْرَابِيُّ، عَنْ خِلَاسِ بْنِ عَمْرٍو، عَنْ أَبِي هُرَيْرَةَ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((مَثَلُ الَّذِي يُعْطِي الْعَطِيَّةَ، ثُمَّ يَعُودُ فِيهَا كَمَثَلِ الْكَلْبِ يَأْكُلُ حَتَّى إِذَا شَبِعَ قَاءَ، ثُمَّ يَعُودُ فِي قَيْئِهِ فَيَأْكُلُهُ)).","","Musnad Ishaq ibn Rahwayh 496","","","It is not permissible to take back a gift or present"
"497","أَخْبَرَنَا النَّضْرُ، نا حَمَّادُ بْنُ سَلَمَةَ، أنا مُحَمَّدُ بْنُ زِيَادٍ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ قَالَ: "" كَانَ رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا أُتِيَ بِطَعَامٍ مِنْ غَيْرِ أَهْلِهِ سَأَلَ عَنْهُ أَهَدِيَّةٌ أَمْ صَدَقَةٌ؟ فَإِنْ قِيلَ: صَدَقَةٌ لَمْ يَأْكُلْ مِنْهُ، وَأَكَلَ أَصْحَابُهُ، وَإِنْ قِيلَ هَدِيَّةٌ أَكَلَ مِنْهَا "".","","Musnad Ishaq ibn Rahwayh 497","","","The Prophet’s refusal to eat from charity"
"498","اَخْبَرَنَا الْمَخْزُوْمِیُّ، نَا وُهَیْبٌ، نَا عَبْدُاللّٰهِ بْنُ طَاؤُوْسٍ، عَنْ اَبِیْهِ،عَنِ ابْنِ عَبَّاسٍ، عَنْ رَسُوْلِ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ قَالَ: اَلْعَائِدُ فِیْ هِبَتِهٖ کَالْکَلْبِ، یَقِیْئُ ثُمَّ یَعُوْدُ فِیْ قَیْئِهٖ.","","Musnad Ishaq ibn Rahwayh 498","","","Example of one who takes back his gift"
"499","اَخْبَرَنَا عِیْسَی بْنُ یُوْنُسَ، نَا الْاَوْزَاعِیُّ، عَنْ اَبِیْ جَعْفَرٍ۔ مُحَمَّدُ بْنُ عَلِیٍّ۔ عَنْ سَعِیْدِ بْنِ الْمُسَیَّبِ،عَنِ ابْنِ عَبَّاسٍ، عَنْ رَسُوْلِ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ قَالَ: اَلْعَائِدُ فِی هِبَتِهٖ کَالْکَلْبِ یَقِیْئُ ثُمَّ یَعُوْدُ فِیْهِ.","","Musnad Ishaq ibn Rahwayh 499","","","Example of one who takes back his gift"
"500","اَخْبَرَنَا عِیْسَی بْنُ یُوْنُسَ، نَا حُسَیْنُ الْمُعَلَّمِ، عَنْ عَمْرِو بْنِ شُعَیْبٍ، عَنْ طَاؤُوْسٍ، عَنِ ابْنِ عَمْرٍو وَابْنِ عَبَّاسٍ قَالَ: قَالَ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ: لاَ یَحِلُّ لِاَحَدٍ اَنْ یُّعْطِیَ عَطِیَّةً، فَیَعُوْدَ فِیْهَا، اِلَّا الْوَالِدُ فِیْمَا یُعْطِی وَلَدَہٗ، وَمَثَلُ الَّذِیْ یُعْطِی الْعَطِیَّةَ ثُمَّ یَعُوْدُ فِیْهَا، کَمَثَلِ الْکَلْبِ یَقِیْئُ ثُمَّ یَعُوْدُ فِیْ قَیْئِهٖ.","","Musnad Ishaq ibn Rahwayh 500","","","Example of one who takes back his gift"
"501","اَخْبَرَنَا وَکِیْعٌ، نَا اِبْرَاهِیْمَ بْنُ نَافِعٍ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ،عَنْ طَاؤُوْسٍ قَالَ: قَالَ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ: لَا یَحِلُّ لِاَحَدٍ اَنْ یُّعْطِیَ عَطِیَّةً فَیَرْجِعُ فِیْهَا، اِلَّا الْوَالِدُ.","","Musnad Ishaq ibn Rahwayh 501","","","Example of one who takes back his gift"
"502","قَالَ الْحَجَّاجُ: وَقَالَ عَطَاءٌ: قَالَ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ اَلْعَائِدُ فِیْ هِبَتِهٖ، کَالْعَائِدِ فِیْ قَیْئِهٖ.","","Musnad Ishaq ibn Rahwayh 502","","","Example of one who takes back his gift"
"503","اَخْبَرَنَا الْمَلَائِیِّ، نَا مَنْدَلٌ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَمْرِو بْنِ دِیْنَارٍ، عَنِ ابْنِ عَبَّاسٍ، عَنْ رَسُوْلِ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ قَالَ: اِذَا اُهْدِیَ لِاَحْدِکُمْ هَدْیَةً وَعِنْدَہٗ قَوْمٌ، فَهُمْ شُرَکَاءُ فِیْهَا.","","Musnad Ishaq ibn Rahwayh 503","","","Example of one who takes back his gift"
"504","اَخْبَرَنَا الثَّقَفِیُّ، نَا اَیُّوْبُ، عَنْ عِکْرِمَةَ، عَنِ ابْنِ عَبَّاسٍ، عَنْ رَّسُوْلِ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ قَالَ: لَیْسَ لَنَا مَثَلَ السُّوْئِ اَلْعَائِدُ فِیْ هَبِتِهٖ کَالْکَلْبِ یَعُوْدُ فِیْ قَیْئِهٖ.","","Musnad Ishaq ibn Rahwayh 504","","","Example of one who takes back his gift"
"505","اَخْبَرَنَا الثَّقَفِیُّ، نَا خَالِدُ الْحَذَّاءِ، عَنْ عِکْرِمَةَ، عَنِ ابْنِ عَبَّاسٍ، عَنْ رَسُوْلِ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ مِثْلَهٗ سَوَاءٍ.","","Musnad Ishaq ibn Rahwayh 505","","","Example of one who takes back his gift"
