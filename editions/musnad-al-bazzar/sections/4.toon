hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"1801","1788  -  حَدَّثَنَا  يَحْيَى بْنُ مُحَمَّدِ بْنِ السَّكَنِ ، قَالَ:  نَا  يَحْيَى بْنُ كَثِيرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  أَبِي جَعْفَرٍ الْفَرَّاءِ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  أَجِيبُوا الدَّاعِيَ إِذَا دُعِيتُمْ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  . وَقَدْ رَوَاهُ غَيْرُ  يَحْيَى بْنِ كَثِيرٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  أَبِي جَعْفَرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مُرْسَلًا ،  وَوَصَلَهُ  يَحْيَى بْنُ كَثِيرٍ  .","","Musnad al-Bazzar 1788","","عبد الله بن مسعود عن عبد الله بن شداد بن الهاد الليثي عن أبو جعفر الفراء عن شعبة بن الحجاج عن يحيى بن كثير العنبري عن يحيى بن محمد بن السكن البزاز عن البزار","عبد الله بن شداد بن الهادي عن عبد الله"
"1802","[5/192]      أَبُو عَمْرٍو الشَّيْبَانِيُّ  عَنْ  عَبْدِ اللهِ  1789  -  حَدَّثَنَا  أَبُو كُرَيْبٍ ، وَيُوسُفُ بْنُ مُوسَى ، قَالَا:  نَا  أَبُو مُعَاوِيَةَ ، قَالَ:  نَا  الشَّيْبَانِيُّ ،  عَنِ  الْوَلِيدِ بْنِ الْعَيْزَارِ ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  سَأَلْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَيُّ الْعَمَلِ أَفْضَلُ ؟ قَالَ:  الصَّلَاةُ لِمِيقَاتِهَا  قُلْتُ: ثُمَّ أَيُّ ؟ قَالَ: ثُمَّ بِرُّ الْوَالِدَيْنِ قُلْتُ: ثُمَّ أَيُّ ؟ قَالَ:  الْجِهَادُ  فِي  سَبِيلِ  اللهِ ، قَالَ: فَمَا تَرَكْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ أَسْأَلَهُ [ إِلَّا إِرْعَاءً عَلَيْهِ ] .         [5/193]","","Musnad al-Bazzar 1789","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن الوليد بن العيزار بن حريث العبدي عن سليمان بن فيروز الشيباني عن أبو معاوية الضرير عن يوسف بن موسى بن راشد عن البزار","أبو عمرو الشيباني عن عبد الله"
"1803","1790  -  وَحَدَّثَنَا  الْفَضْلُ بْنُ يَعْقُوبَ الرُّخَامِيُّ ، قَالَ:  نَا  سَعِيدُ بْنُ مَسْلَمَةَ ، قَالَ:  نَا  أَبُو يَعْفُورٍ ،  عَنِ  الْوَلِيدِ بْنِ الْعَيْزَارِ ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ.         [5/194]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  أَبِي يَعْفُورٍ ،  إِلَّا  سَعِيدُ بْنُ مَسْلَمَةَ  .","","Musnad al-Bazzar 1790","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن الوليد بن العيزار بن حريث العبدي عن عبد الرحمن بن عبيد بن نسطاس الثعلبي عن سعيد بن مسلمة الأموي عن الفضل بن يعقوب الرخامي عن البزار","أبو عمرو الشيباني عن عبد الله"
"1804","1791  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنِ  الْوَلِيدِ بْنِ الْعَيْزَارِ ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  بِنَحْوِ حَدِيثِ  الشَّيْبَانِيِّ ،  عَنِ  الْوَلِيدِ  .","","Musnad al-Bazzar 1791","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن الوليد بن العيزار بن حريث العبدي عن شعبة بن الحجاج عن غندر ربيب شعبة عن الفلاس عن البزار","أبو عمرو الشيباني عن عبد الله"
"1805","1792  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنِ  الْوَلِيدِ بْنِ الْعَيْزَارِ ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ قَالَ:  حَدَّثَنِي  صَاحِبُ هَذِهِ الدَّارِ ، وَأَشَارَ إِلَى دَارِ عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .","","Musnad al-Bazzar 1792","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن الوليد بن العيزار بن حريث العبدي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","أبو عمرو الشيباني عن عبد الله"
"1806","[5/195]             [5/196]      1793  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  جَرِيرٌ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  أَفْضَلُ الْعَمَلِ الصَّلَاةُ لِوَقْتِهَا وَبِرُّ الْوَالِدَيْنِ  .  هَكَذَا رَوَاهُ  الْحَسَنُ ،  عَنْ  أَبِي عَمْرٍو  .","","Musnad al-Bazzar 1793","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن الحسن بن عبيد الله النخعي عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","أبو عمرو الشيباني عن عبد الله"
"1807","1794  -  وَحَدَّثَنَاهُ  حَفْصُ بْنُ عَمْرٍو الرَّبَالِيُّ ، قَالَ:  نَا  عَمْرُو بْنُ جَرِيرٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  أَفْضَلُ الْعَمَلِ الصَّلَاةُ لِوَقْتِهَا وَبِرُّ الْوَالِدَيْنِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  إِسْمَاعِيلَ ،  عَنْ  أَبِي عَمْرٍو ،  عَنْ  عَبْدِ اللهِ  إِلَّا  عَمْرُو بْنُ جَرِيرٍ ،  وَلَا نَعْلَمُ  أَسْنَدَ  إِسْمَاعِيلُ ،  عَنْ  أَبِي عَمْرٍو ،  عَنْ  عَبْدِ اللهِ  إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 1794","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن إسماعيل بن أبي خالد عن عمرو بن جرير البجلي عن حفص بن عمرو الربالي عن البزار","أبو عمرو الشيباني عن عبد الله"
"1808","1795  -  وَحَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ         [5/197]      أَبِي عَمْرٍو الشَّيْبَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  سِبَابُ  الْمُسْلِمِ فُسُوقٌ ، وَقِتَالُهُ  كُفْرٌ  .","","Musnad al-Bazzar 1795","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن سليمان بن طرخان عن معتمر بن سليمان عن الفلاس عن البزار","أبو عمرو الشيباني عن عبد الله"
"1809","[5/198]      أَبُو مَعْمَرٍ  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  1796  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، وَمُحَمَّدُ بْنُ بَشَّارٍ ، قَالَا:  نَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  شُعْبَةَ ،  عَنِ  الْحَكَمِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  أَنَّ أَمِيرًا صَلَّى فَسَلَّمَ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ ، فَقَالَ  عَبْدُ اللهِ  : أَنَّى  عَلِقَهَا  ،  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُسَلِّمُ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ  .         [5/199]      وَهَذَا الْحَدِيثُ رَوَاهُ غَيْرُ وَاحِدٍ وَلَمْ يُسْنِدْهُ  .","","Musnad al-Bazzar 1796","","عبد الله بن مسعود عن عبد الله بن سخبرة عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن يحيى القطان عن محمد بن بشار بندار عن البزار","أبو معمر عن عبد الله بن مسعود"
"1810","1797  -  حَدَّثَنَا  مُحَمَّدُ  بْنُ خَلَفٍ ، قَالَ:  نَا  أَبُو دَاوُدَ ، قَالَ:  نَا  قَيْسٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  إِنِّي لَمُسْتَتِرٌ بِجِدَارِ  الْكَعْبَةِ  إِذَا أَنَا بِرَجُلَيْنِ كَثِيرِ  شُحُومِ  بُطُونِهِمَا قَلِيلِ فِقْهِ قُلُوبِهِمَا ، فَقَالَ أَحَدُهُمَا لِصَاحِبِهِ: أَتُرَى اللهَ يَسْمَعُ مَا نَقُولُ ؟ قَالَ: فَقَالَ صَاحِبُهُ: إِذَا رَفَعْنَا سَمِعَ ، وَإِذَا خَفَضْنَا لَمْ يَسْمَعْ ، قَالَ: فَقَالَ الْآخَرُ لَهُ: إِنْ كَانَ يَسْمَعُ إِذَا رَفَعْنَا فَإِنَّهُ يَسْمَعُ إِذَا خَفَضْنَا ، قَالَ:  فَذَكَرْتُ ذَلِكَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَنَزَلَتْ هَذِهِ الْآيَةُ         {      وَمَا كُنْتُمْ تَسْتَتِرُونَ أَنْ يَشْهَدَ عَلَيْكُمْ سَمْعُكُمْ وَلا أَبْصَارُكُمْ         }      إِلَى قَوْلِهِ         {      وَلَكِنْ ظَنَنْتُمْ أَنَّ اللهَ لا يَعْلَمُ كَثِيرًا مِمَّا تَعْمَلُونَ         }      .         [5/200]      وَهَذَا الْحَدِيثُ إِنَّمَا نَحْفَظُهُ مِنْ حَدِيثِ  أَبِي مَعْمَرٍ ،  عَنْ  عَبْدِ اللهِ  بِهَذَا اللَّفْظِ.  كذا في طبعة مكتبة العلوم والحكم ، ولعل الصواب يحيى .","","Musnad al-Bazzar 1797","","عبد الله بن مسعود عن عبد الله بن سخبرة عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن قيس بن الربيع الأسدي عن أبو داود الطيالسي عن يحيى بن خلف الجوباري عن البزار","أبو معمر عن عبد الله بن مسعود"
"1811","1798  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابِرِ بْنِ بُجَيْرٍ ، قَالَ:  نَا  أَبُو أُسَامَةَ ، قَالَ:  نَا  سَيْفُ بْنُ سُلَيْمَانَ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ  كَانَ يُعَلِّمُهُمُ  التَّشَهُّدَ  :  التَّحِيَّاتُ  لِلهِ وَالصَّلَوَاتُ  وَالطَّيِّبَاتُ  ،  السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ ، السَّلَامُ عَلَيْنَا وَعَلَى عِبَادِ اللهِ الصَّالِحِينَ ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَشْهَدُ أَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ  .         [5/201]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى مِنْ حَدِيثِ  أَبِي مَعْمَرٍ ،  عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  مُجَاهِدٍ  إِلَّا  سَيْفُ بْنُ سُلَيْمَانَ  .","","Musnad al-Bazzar 1798","","عبد الله بن مسعود عن عبد الله بن سخبرة عن مجاهد بن جبر المخزومي عن سيف بن سليمان المخزومي عن حماد بن أسامة القرشي عن محمد بن جابر بن بجير المحاربي عن البزار","أبو معمر عن عبد الله بن مسعود"
"1812","1799  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدَةَ ، قَالَ:  نَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دَخَلَ  مَكَّةَ  وَحَوْلَ  الْبَيْتِ  كَذَا وَكَذَا مِنْ صَنَمٍ ،  فَجَعَلَ يَضْرِبُهُنَّ ، وَيُشِيرُ إِلَيْهِنَّ  بِقَضِيبٍ  مَعَهُ أَوْ بِعُودٍ  ، وَيَقُولُ:         {      جَاءَ الْحَقُّ وَزَهَقَ الْبَاطِلُ         }      .","","Musnad al-Bazzar 1799","","عبد الله بن مسعود عن عبد الله بن سخبرة عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن أحمد بن عبدة الضبي عن البزار","أبو معمر عن عبد الله بن مسعود"
"1813","[5/202]      1800  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدَةَ ، قَالَ:  نَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  انْشَقَّ الْقَمَرُ وَنَحْنُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: اشْهَدُوا  .  وَهَذَانِ الْحَدِيثَانِ لَا نَعْلَمُ رَوَاهُمَا عَنْ  مُجَاهِدٍ  عَنْ  أَبِي مَعْمَرٍ  إِلَّا  ابْنُ أَبِي نَجِيحٍ  .","","Musnad al-Bazzar 1800","","عبد الله بن مسعود عن عبد الله بن سخبرة عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن أحمد بن عبدة الضبي عن البزار","أبو معمر عن عبد الله بن مسعود"
"1814","[5/203]      1801  -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ ، قَالَ:  أَخْبَرَنِي  أَبِي  ،  عَنْ  شُعْبَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  انْشَقَّ الْقَمَرُ وَنَحْنُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  أَحْسَبُهُ قَالَ:  بِمِنًى  .  هَكَذَا رَوَاهُ  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنْ  عَبْدِ اللهِ  .","","Musnad al-Bazzar 1801","","عبد الله بن مسعود عن عبد الله بن سخبرة عن إبراهيم النخعي عن الأعمش عن شعبة بن الحجاج عن نصر بن علي بن صهبان الجهضمي عن نصر بن علي بن نصر الجهضمي عن البزار","أبو معمر عن عبد الله بن مسعود"
"1815","[5/204]      زِرُّ بْنُ حُبَيْشٍ  عَنْ  عَبْدِ اللهِ  1802  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  يَحْيَى بْنُ سَعِيدٍ ، قَالَ:  نَا  سُفْيَانُ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ.","","Musnad al-Bazzar 1802","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سفيان الثوري عن يحيى القطان عن الفلاس عن البزار","زر بن حبيش عن عبد الله"
"1816","1803  -  وَحَدَّثَنَا  عُبَيْدُ بْنُ أَسْبَاطِ بْنِ مُحَمَّدٍ ، قَالَ:  حَدَّثَنِي  أَبِي  ،  عَنْ  سُفْيَانَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  لَا تَذْهَبُ الدُّنْيَا حَتَّى يَمْلِكَ الْعَرَبَ رَجُلٌ مِنْ أَهْلِ بَيْتِي يُوَاطِئُ اسْمُهُ اسْمِي  .         [5/205]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الثَّوْرِيِّ  بِهَذَا  الْإِسْنَادِ  إِلَّا  يَحْيَى بْنُ سَعِيدٍ  ،  وَأَسْبَاطُ بْنُ مُحَمَّدٍ  .","","Musnad al-Bazzar 1803","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سفيان الثوري عن أسباط بن محمد بن ميسرة القرشي عن عبيد بن أسباط بن محمد الهمداني عن البزار","زر بن حبيش عن عبد الله"
"1817","1804  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُنْذِرِ ، وَالْفَضْلُ بْنُ سَهْلٍ ، قَالَا:  نَا  إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ:  نَا  جَعْفَرٌ الْأَحْمَرُ ،  عَنْ  أَبِي إِسْحَاقَ الشَّيْبَانِيِّ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  لَا تَذْهَبُ الدُّنْيَا حَتَّى يَمْلِكَ رَجُلٌ مِنْ أَهْلِ بَيْتِي يُوَاطِئُ اسْمُهُ اسْمِي  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الشَّيْبَانِيِّ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  إِلَّا  جَعْفَرٌ الْأَحْمَرُ ،  وَلَا عَنْ  جَعْفَرٍ  إِلَّا  إِسْحَاقُ بْنُ مَنْصُورٍ  .         [5/206]","","Musnad al-Bazzar 1804","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سليمان بن فيروز الشيباني عن جعفر بن زياد الأحمر عن إسحاق بن منصور السلولي عن الفضل بن سهل الخراساني عن البزار","زر بن حبيش عن عبد الله"
"1818","1805  -  حَدَّثَنَا  يُوسُفُ بْنُ مُحَمَّدِ بْنِ سَابِقٍ ، قَالَ:  نَا  يَحْيَى بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي غَنِيَّةَ ، قَالَ:  حَدَّثَنِي  أَبِي  ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  بِنَحْوِ حَدِيثِ  الشَّيْبَانِيِّ ،  عَنْ  عَاصِمٍ  .","","Musnad al-Bazzar 1805","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن عبد الملك بن حميد الخزاعي عن يحيى بن عبد الملك بن حميد عن يوسف بن محمد بن سابق القرشي عن البزار","زر بن حبيش عن عبد الله"
"1819","1806  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَارَةَ بْنِ صُبَيْحٍ ، قَالَ:  نَا  إِسْمَاعِيلُ بْنُ أَبَانَ ، قَالَ:  نَا  عَبْدُ اللهِ بْنُ مُسْلِمٍ الْمُلَائِيُّ ،  عَنْ  أَبِي الْجَحَّافِ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  لَا تَذْهَبُ الدُّنْيَا حَتَّى يَمْلِكَ رَجُلٌ مِنْ أَهْلِ بَيْتِي يُوَاطِئُ اسْمُهُ اسْمِي  .  وَهَذَا الْحَدِيثُ  غَرِيبٌ  لَا نَعْلَمُهُ يُرْوَى عَنْ  أَبِي الْجَحَّافِ ،  عَنْ  عَاصِمٍ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ  أَسْنَدَ  أَبُو الْجَحَّافِ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  إِلَّا هَذَا الْحَدِيثَ.         [5/207]","","Musnad al-Bazzar 1806","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن داود بن أبي عوف البرجمي عن عبد الله بن مسلم بن كيسان الملائي عن إسماعيل بن أبان عن محمد بن عمارة الكوفي عن البزار","زر بن حبيش عن عبد الله"
"1820","1807  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُنْذِرِ ، قَالَ:  نَا  مُحَمَّدُ بْنُ فُضَيْلٍ ، قَالَ:  نَا  عُثْمَانُ بْنُ شُبْرُمَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  بِنَحْوٍ مِنْ حَدِيثِ  الثَّوْرِيِّ ،  عَنْ  عَاصِمٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  عُثْمَانَ بْنِ شُبْرُمَةَ  إِلَّا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  وَقَدْ رَوَى هَذَا الْكَلَامَ ، عَنْ  عَاصِمٍ  جَمَاعَةٌ مِنْهُمْ:  فِطْرٌ  ،  وَزَائِدَةُ  ،  وَحَمَّادُ بْنُ سَلَمَةَ  ، وَغَيْرُهُمْ  .","","Musnad al-Bazzar 1807","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن عثمان بن شبرمة الكوفي عن محمد بن فضيل بن غزوان عن علي بن المنذر العلاف عن البزار","زر بن حبيش عن عبد الله"
"1821","1808  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  يَحْيَى بْنُ سَعِيدٍ الْقَطَّانُ ، قَالَ:  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         {      وَلَقَدْ رَآهُ نَـزْلَةً أُخْرَى         }      ، قَالَ:  رَأَى  جِبْرِيلَ  عِنْدَ  سِدْرَةِ  الْمُنْتَهَى  لَهُ سِتُّمِائَةِ جَنَاحٍ  .         [5/208]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا قَالَ فِيهِ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  حَمَّادٍ ،  وَقَدْ رَوَاهُ غَيْرُ  يَحْيَى ،  عَنْ  حَمَّادٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  مَوْقُوفًا  .","","Musnad al-Bazzar 1808","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن يحيى القطان عن الفلاس عن البزار","زر بن حبيش عن عبد الله"
"1822","1809  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  عَفَّانُ ، قَالَ:  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  أَنَّهُمْ قَالُوا: يَا رَسُولَ اللهِ ، كَيْفَ تَعْرِفُ مَنْ لَمْ تَرَ مِنْ أُمَّتِكَ ؟ قَالَ:  غُرًّا  بُلْقًا مِنْ آثَارِ الْوُضُوءِ  .         [5/209]      وَهَذَا الْكَلَامُ قَدْ رُوِيَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ وُجُوهٍ ، وَلَا نَعْلَمُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَى هَذَا الْحَدِيثَ عَنْ  عَاصِمٍ  إِلَّا  حَمَّادُ بْنُ سَلَمَةَ  .","","Musnad al-Bazzar 1809","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن عفان بن مسلم الصفار عن الفلاس عن البزار","زر بن حبيش عن عبد الله"
"1823","1810  -  حَدَّثَنَا  عَبْدُ الْوَارِثِ بْنُ عَبْدِ الصَّمَدِ ، قَالَ:  حَدَّثَنِي  أَبِي  ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  رَفَعَهُ  قَالَ:  مَنْ صَلَّى عَلَى جِنَازَةٍ فَلَهُ قِيرَاطٌ ،  وَمَنِ انْتَظَرَهَا حَتَّى يَقْضِيَ قَضَاءَهَا أَوْ تُدْفَنَ فَلَهُ قِيرَاطَانِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ  .","","Musnad al-Bazzar 1810","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن شعبة بن الحجاج عن عبد الصمد بن عبد الوارث التنوري عن عبد الوارث بن عبد الصمد التنوري عن البزار","زر بن حبيش عن عبد الله"
"1824","1811  -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ، وَالْحَسَنُ بْنُ عَرَفَةَ ، قَالَا:  نَا  أَبُو بَكْرِ بْنُ         [5/210]      عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  لَعَلَّكُمْ سَتُدْرِكُونَ الصَّلَاةَ مَعَ قَوْمٍ يُصَلُّونَهَا لِغَيْرِ وَقْتِهَا ،  فَإِنْ أَدْرَكْتُمُوهَا فَصَلُّوهَا لِوَقْتِهَا الَّذِي تَعْرِفُونَ ، ثُمَّ صَلُّوا مَعَهُمْ ، وَاجْعَلُوا صَلَاتَكُمْ مَعَهُمْ  سُبْحَةً  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  إِلَّا  أَبُو بَكْرِ بْنُ عَيَّاشٍ  .","","Musnad al-Bazzar 1811","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن أبو بكر بن عياش عن الحسن بن عرفة العبدي عن البزار","زر بن حبيش عن عبد الله"
"1825","1812  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ، قَالَ:  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ:  كَانَ زَمِيلَيِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَلِيٌّ ،  وَأَبُو لُبَابَةَ ،  فَكَانَتْ إِذَا جَاءَتْ عُقْبَةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَا: ارْكَبْ حَتَّى نَمْشِيَ ، فَيَقُولَ:  مَا أَنْتُمَا بِأَقْوَى مِنِّي ، وَمَا أَنَا بِأَغْنَى عَنِ الْأَجْرِ مِنْكُمَا  .         [5/211]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  إِلَّا  حَمَّادُ بْنُ سَلَمَةَ  .","","Musnad al-Bazzar 1812","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن عبد الرحمن بن مهدي عن الفلاس عن البزار","زر بن حبيش عن عبد الله"
"1826","1813  -  حَدَّثَنَا  خَالِدُ بْنُ يُوسُفَ ، قَالَ:  نَا  أَبُو عَوَانَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ.","","Musnad al-Bazzar 1813","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن الوضاح بن عبد الله اليشكري عن خالد بن يوسف بن خالد السمتي عن البزار","زر بن حبيش عن عبد الله"
"1827","1814  -  وَحَدَّثَنَاهُ  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  أَبُو دَاوُدَ ، قَالَ:  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .         [5/212]      وَهَذَا الْحَدِيثُ رَوَاهُ  حَمَّادُ بْنُ سَلَمَةَ ،  وَأَبُو عَوَانَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ،  وَغَيْرُهُمَا يَرْوِيهِ عَنْ  عَاصِمٍ  ، عَنْ  أَبِي وَائِلٍ  ، عَنْ  عَبْدِ اللهِ  .","","Musnad al-Bazzar 1814","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن أبو داود الطيالسي عن الفلاس عن البزار","زر بن حبيش عن عبد الله"
"1828","1815  -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ، قَالَ:  نَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ :  إِنَّ اللهَ نَظَرَ فِي قُلُوبِ الْعِبَادِ فَوَجَدَ قَلْبَ  مُحَمَّدٍ  خَيْرَ قُلُوبٍ ،  ثُمَّ نَظَرَ فِي قُلُوبِ الْعِبَادِ فَوَجَدَ قُلُوبَ أَصْحَابِهِ خَيْرَ قُلُوبِ الْعِبَادِ فَجَعَلَهُمْ أَنْصَارَ دِينِهِ ، مَا رَآهُ         [5/213]      الْمُؤْمِنُ حَسَنًا فَهُوَ عِنْدَ اللهِ حَسَنٌ ، وَمَا رَآهُ الْمُؤْمِنُونَ قَبِيحًا فَهُوَ عِنْدَ اللهِ قَبِيحٌ  .  وَهَذَا الْحَدِيثُ عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  لَا نَعْلَمُ رَوَاهُ إِلَّا  أَبُو بَكْرٍ ،  وَرَوَاهُ غَيْرُ  أَبِي بَكْرٍ ،  عَنْ  عَاصِمٍ  ، عَنْ  أَبِي وَائِلٍ  ، عَنْ  عَبْدِ اللهِ  .","","Musnad al-Bazzar 1815","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن أبو بكر بن عياش عن عبد الواحد بن غياث عن البزار","زر بن حبيش عن عبد الله"
"1829","[5/214]      1816  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سُلَيْمَانَ يَعْنِي الْأَعْمَشَ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  حُذَيْفَةَ قَالَ:  لَقَدْ عَلِمَ الْمَحْفُوظُونَ مِنْ أَصْحَابِ  مُحَمَّدٍ  أَنَّ  ابْنَ أُمِّ عَبْدٍ  أَقْرَبُهُمْ إِلَى اللهِ وَسِيلَةً  .  آخِرُ السَّابِعَ عَشَرَ وَأَوَّلُ الثَّامِنَ عَشَرَ وَالْحَمْدُ لِلهِ كَثِيرًا  .","","Musnad al-Bazzar 1816","","حذيفة بن اليمان عن شقيق بن سلمة عن الأعمش عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","زر بن حبيش عن عبد الله"
"1830","[5/215]      بَقِيَّةُ حَدِيثِ  زِرٍّ  1817  -  أَخْبَرَنَا  مُحَمَّدُ بْنُ أَيُّوبَ بْنِ حَبِيبٍ ، قَالَ:  نَا  أَحْمَدُ بْنُ عَمْرِو بْنِ عَبْدِ الْخَالِقِ ، قَالَ:  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  أَبُو دَاوُدَ ، قَالَ:  نَا  شَيْبَانُ يَعْنِي ابْنَ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ يَعْنِي ابْنَ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَصُومُ مِنْ  غُرَّةِ  كُلِّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ ،  وَمَا رَأَيْتُهُ مُفْطِرًا يَوْمَ جُمُعَةٍ قَطُّ  .         [5/216]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَعْلَى مِنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  وَلَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  بِهَذَا اللَّفْظِ إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ ،  وَرَوَاهُ عَنْ  عَاصِمٍ  ،  شَيْبَانُ  ،  وَقَيْسُ بْنُ الرَّبِيعِ  ، وَزَادَ  شَيْبَانُ  :  وَمَا رَأَيْتُهُ مُفْطِرًا يَوْمَ جُمُعَةٍ قَطُّ  .","","Musnad al-Bazzar 1817","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن شيبان بن عبد الرحمن المؤدب عن أبو داود الطيالسي عن الفلاس عن البزار","بقية حديث زر"
"1831","1818  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ زِيَادٍ الصَّائِغُ ، قَالَ:  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ:  نَا  شَيْبَانُ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ:  أَخَّرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاةَ الْعِشَاءِ ، ثُمَّ خَرَجَ إِلَى الْمَسْجِدِ وَإِذَا النَّاسُ         [5/217]      يَنْتَظِرُونَ الصَّلَاةَ فَقَالَ:  إِنَّهُ لَيْسَ أَحَدٌ مِنْ أَهْلِ الْأَدْيَانِ يُصَلِّي فِي هَذِهِ السَّاعَةِ غَيْرُكُمْ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  عَاصِمٍ  بِهَذَا  الْإِسْنَادِ  إِلَّا  شَيْبَانُ  .","","Musnad al-Bazzar 1818","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن إبراهيم بن زياد الصائغ عن البزار","بقية حديث زر"
"1832","1819  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِلْحَسَنِ  ،  وَالْحُسَيْنِ  :  اللَّهُمَّ إِنِّي أُحِبُّهُمَا فَأَحْبِبْهُمَا وَمَنْ أَحَبَّهُمَا فَقَدْ أَحَبَّنِي  .  وَهَذَا الْحَدِيثُ لَمْ نَسْمَعْهُ إِلَّا مِنْ  يُوسُفَ ،  عَنْ  أَبِي بَكْرٍ  .","","Musnad al-Bazzar 1819","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن أبو بكر بن عياش عن يوسف بن موسى بن راشد عن البزار","بقية حديث زر"
"1833","1820  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ:  نَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ، قَالَ:  نَا  أَبُو         [5/218]      بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  رَفَعَهُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  تَسَحَّرُوا فَإِنَّ فِي السَّحُورِ بَرَكَةً  .  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ غَيْرُ وَاحِدٍ ، عَنْ  عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي بَكْرٍ  بِهَذَا  الْإِسْنَادِ  مَوْقُوفًا ،  وَلَا نَعْلَمُ أَحَدًا  أَسْنَدَهُ  عَنْ  عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي بَكْرٍ  إِلَّا  مُحَمَّدُ بْنُ بَشَّارٍ ،  وَقَدْ رَوَاهُ  أَحْمَدُ بْنُ يُونُسَ  ، عَنْ  أَبِي بَكْرٍ  مَرْفُوعًا  .","","Musnad al-Bazzar 1820","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن أبو بكر بن عياش عن عبد الرحمن بن مهدي عن محمد بن بشار بندار عن البزار","بقية حديث زر"
"1834","1821  -  حَدَّثَنَا بِهِ  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ ، قَالَ:  نَا  أَحْمَدُ بْنُ يُونُسَ ،  عَنْ  أَبِي بَكْرِ بْنِ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  رَفَعَهُ  بِنَحْوِهِ.","","Musnad al-Bazzar 1821","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن أبو بكر بن عياش عن أحمد بن عبد الله اليربوعي عن محمد بن عبد الرحيم  صاعقة عن البزار","بقية حديث زر"
"1835","[5/219]      1822  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  الْوَلِيدُ بْنُ صَالِحٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ:  نَهَى عَنِ الصَّلَاةِ بَعْدَ الْعَصْرِ حَتَّى تَغْرُبَ الشَّمْسُ ،  وَبَعْدَ الْفَجْرِ ، أَوْ بَعْدَ صَلَاةِ الصُّبْحِ حَتَّى تَطْلُعَ الشَّمْسُ ، وَبِنِصْفِ النَّهَارِ -  أَحْسَبُهُ قَالَ: فِي شِدَّةِ الْحَرِّ  .","","Musnad al-Bazzar 1822","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن أبو بكر بن عياش عن الوليد بن صالح النخاس عن عباس بن جعفر العباسي عن البزار","بقية حديث زر"
"1836","1823  -  حَدَّثَنَا  خَالِدُ بْنُ يُوسُفَ ، قَالَ:  نَا  أَبُو عَوَانَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ:  مَرَّ بِي النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا غُلَامٌ أَرْعَى غَنَمًا  لِعُقْبَةَ بْنِ أَبِي مُعَيْطٍ  وَذَكَرَ كَلَامًا ، ثُمَّ قَالَ: وَمَسَحَ رَأْسِي ، وَقَالَ:  أَنْتَ غُلَامٌ  مُعَلَّمٌ  .","","Musnad al-Bazzar 1823","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن الوضاح بن عبد الله اليشكري عن خالد بن يوسف بن خالد السمتي عن البزار","بقية حديث زر"
"1837","[5/220]      1824  -  حَدَّثَنَا  الْجَرَّاحُ بْنُ مَخْلَدٍ ، قَالَ:  نَا  إِبْرَاهِيمُ بْنُ سُلَيْمَانَ الدَّبَّاسُ ، قَالَ:  نَا  مُحَمَّدُ بْنُ أَبَانَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  الْوَائِدَةُ  وَالْمَوْءُودَةُ  فِي النَّارِ  .         [5/221]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  إِلَّا  مُحَمَّدُ بْنُ أَبَانَ  .","","Musnad al-Bazzar 1824","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن محمد بن أبان بن صالح عن إبراهيم بن سليمان الدباس عن الجراح بن مخلد عن البزار","بقية حديث زر"
"1838","1825  -  حَدَّثَنَا  أَحْمَدُ بْنُ أَبَانَ الْقُرَشِيُّ ، قَالَ:  نَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ:  كُنْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي غَزْوَةٍ فَنَزَلَتْ عَلَيْهِ         {      وَالْمُرْسَلاتِ عُرْفًا         }      فَتَلَقَّيْتُهَا مِنْ فِيهِ ، وَإِنَّ فَاهُ رَطْبٌ بِهَا ، فَخَرَجَتْ حَيَّةٌ فَدَخَلَتْ جُحْرًا فَاتَّبَعْنَاهَا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  وُقِيتُمْ شَرَّهَا كَمَا وُقِيَتْ شَرَّكُمْ  .  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ غَيْرُ وَاحِدٍ ، عَنْ  عَاصِمٍ  .","","Musnad al-Bazzar 1825","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سفيان بن عيينة عن أحمد بن أبان القرشي عن البزار","بقية حديث زر"
"1839","1826  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  الْحَجَّاجُ بْنُ الْمِنْهَالِ ، قَالَ:  نَا  حَمَّادٌ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّهُ صَعِدَ شَجَرَةً يَجْتَنِي         [5/222]      سِوَاكًا مِنْ أَرَاكٍ ، فَنَظَرَ إِلَيْهِ أَصْحَابُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَعَجِبُوا مِنْ دِقَّةِ سَاقَيْهِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  لَهُمَا فِي الْمِيزَانِ أَثْقَلُ مِنْ  أُحُدٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  إِلَّا  حَمَّادُ بْنُ سَلَمَةَ  .","","Musnad al-Bazzar 1826","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أبو موسى الزمن عن البزار","بقية حديث زر"
"1840","1827  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْحَكَمِ بْنِ ظِبْيَانَ ، قَالَ:  نَا  الْحَجَّاجُ ،  عَنْ  حَمَّادِ بْنِ سَلَمَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [5/223]      قَالَ:  عُرِضَتْ عَلَيَّ أُمَمٌ الْبَارِحَةَ بِأَتْبَاعِهَا  .","","Musnad al-Bazzar 1827","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أحمد بن الحكم بن ظبيان عن البزار","بقية حديث زر"
"1841","1828  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُقْبَةَ السَّدُوسِيُّ ، قَالَ:  نَا  مُعَاوِيَةُ بْنُ هِشَامٍ ، قَالَ:  نَا  عَمْرُو بْنُ غِيَاثٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِنَّ  فَاطِمَةَ  أَحْصَنَتْ فَرْجَهَا فَحَرَّمَ اللهُ ذُرِّيَّتَهَا عَلَى النَّارِ  .         [5/224]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ رَوَاهُ عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  إِلَّا  عَمْرُو بْنُ غِيَاثٍ ،  وَعَمْرٌو  هَذَا كُوفِيٌّ لَمْ يُتَابَعْ عَلَى هَذَا الْحَدِيثِ .  وَقَدْ رَوَاهُ غَيْرُ  مُعَاوِيَةَ بْنِ هِشَامٍ ،  عَنْ  عَمْرِو بْنِ غِيَاثٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ  مُرْسَلًا  .","","Musnad al-Bazzar 1828","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن عمر بن غياث الحضرمي عن معاوية بن هشام القصار عن محمد بن عقبة بن هرم السدوسي عن البزار","بقية حديث زر"
"1842","1829  -  حَدَّثَنَا  بِشْرُ بْنُ خَالِدٍ الْعَسْكَرِيُّ ، قَالَ:  نَا  الْحُسَيْنُ بْنُ عَلِيٍّ الْجُعْفِيُّ ، قَالَ:  نَا  زَائِدَةُ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ:  أَخَذْتُ مِنْ فِي رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَبْعِينَ سُورَةً  .","","Musnad al-Bazzar 1829","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن زائدة بن قدامة عن الحسين بن علي الجعفي عن بشر بن خالد الفرائضي عن البزار","بقية حديث زر"
"1843","[5/225]      1830  -  حَدَّثَنَا  بِشْرُ بْنُ خَالِدٍ الْعَسْكَرِيُّ ، قَالَ:  أَنَا  الْحُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ:  قَالَ لِي النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: اقْرَأْ عَلَيَّ ، فَقَرَأْتُ عَلَيْهِ سُورَةَ النِّسَاءِ ، حَتَّى بَلَغْتُ         {      فَكَيْفَ إِذَا جِئْنَا مِنْ كُلِّ أُمَّةٍ بِشَهِيدٍ وَجِئْنَا بِكَ عَلَى هَؤُلاءِ شَهِيدًا         }      قَالَ: فَفَاضَتْ عَيْنَاهُ وَقَالَ:  مَنْ أَحَبَّ أَنْ يَقْرَأَ الْقُرْآنَ  غَضًّا  كَمَا أُنْزِلَ فَلْيَقْرَأْهُ عَلَى قِرَاءَةِ  ابْنِ أُمِّ عَبْدٍ  .","","Musnad al-Bazzar 1830","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن زائدة بن قدامة عن الحسين بن علي الجعفي عن بشر بن خالد الفرائضي عن البزار","بقية حديث زر"
"1844","1831  -  حَدَّثَنَا  الْفَضْلُ بْنُ سَهْلٍ ، قَالَ:  نَا  عَبْدُ اللهِ بْنُ دَاهِرٍ ، قَالَ:  نَا  عَبْدُ اللهِ بْنُ عَبْدِ الْقُدُّوسِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  لَا تَقُومُ السَّاعَةُ حَتَّى         [5/226]      يَمْلِكَ رَجُلٌ مِنْ أَهْلِ بَيْتِي  يُوَاطِئُ اسْمُهُ اسْمِي فَيَمْلَأُ الْأَرْضَ قِسْطًا وَعَدْلًا كَمَا مُلِئَتْ جَوْرًا وَظُلْمًا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الْأَعْمَشِ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  إِلَّا  عَبْدُ اللهِ بْنُ عَبْدِ الْقُدُّوسِ  .","","Musnad al-Bazzar 1831","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن الأعمش عن عبد الله بن عبد القدوس الرازي عن الأحمري عبد الله بن داهر الأحمري عن الفضل بن سهل الخراساني عن البزار","بقية حديث زر"
"1845","1832  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ:  نَا  عَلِيُّ بْنُ صَالِحٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ .","","Musnad al-Bazzar 1832","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن علي بن صالح بن حي عن عبيد الله بن موسى عن يوسف بن موسى بن راشد عن البزار","بقية حديث زر"
"1846","1833  -  وَحَدَّثَنَاهُ  أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ ، قَالَ:  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ:  نَا  عَلِيُّ بْنُ صَالِحٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  كَانَ  الْحَسَنُ  ،  وَالْحُسَيْنُ  يَأْتِيَانِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُصَلِّي فَيَثِبَانِ عَلَيْهِ وَيَرْكَبَانِهِ ، فَإِذَا نُهِيَا عَنْ ذَلِكَ أَشَارَ بِيَدِهِ أَنْ دَعُوهُمَا ، فَإِذَا قَضَى الصَّلَاةَ ضَمَّهُمَا إِلَيْهِ وَقَالَ:  مَنْ أَحَبَّنِي فَلْيُحِبَّ هَذَيْنِ  .         [5/227]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ بِهَذَا اللَّفْظِ عَنْ  عَاصِمٍ  إِلَّا  عَلِيُّ بْنُ صَالِحٍ  .","","Musnad al-Bazzar 1833","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن علي بن صالح بن حي عن عبيد الله بن موسى عن أحمد بن عثمان بن حكيم عن البزار","بقية حديث زر"
"1847","1834  -  حَدَّثَنَا  الْفَضْلُ بْنُ يَعْقُوبَ ، قَالَ:  نَا  الْهَيْثَمُ بْنُ جَمِيلٍ ، قَالَ:  نَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنْ  عَاصِمٍ ،  أَحْسَبُهُ ،  عَنْ  زِرٍّ  ،  عَنْ  عَبْدِ اللهِ قَالَ:         [5/228]      كُنَّا نُعَلَّمُ  الِاسْتِخَارَةَ  كَمَا نُعَلَّمُ السُّورَةَ مِنَ الْقُرْآنِ فَإِذَا أَرَادَ أَحَدُكُمْ أَمْرًا فَلْيَقُلِ:  اللَّهُمَّ إِنِّي أَسْتَخِيرُكَ بِعِلْمِكَ ،  وَأَسْتَقْدِرُكَ  بِقُدْرَتِكَ ، وَأَسْأَلُكَ مِنْ فَضْلِكَ الْوَاسِعِ ،  إِنَّكَ تَقْدِرُ وَلَا أَقْدِرُ ، وَتَعْلَمُ وَلَا أَعْلَمُ ، وَأَنْتَ عَلَّامُ الْغُيُوبِ ، اللَّهُمَّ إِنْ كَانَ هَذَا الْأَمْرُ الَّذِي أُرِيدُ ، وَتُسَمِّيهِ خَيْرًا فِي دِينِي ، وَخَيْرًا لِي فِي أَمْرِ دُنْيَايَ ، وَخَيْرًا لِي فِي عَاقِبَةِ أَمْرِي ، فَيَسِّرْهُ لِي -  أَحْسَبُهُ قَالَ: فَبَارِكْ لِي  فِيهِ ، وَإِنْ كَانَ شَرًّا لِي فِي أَمْرِ دِينِي ، وَشَرًّا لِي فِي أَمْرِ دُنْيَايَ ، وَشَرًّا لِي فِي عَاقِبَةِ -  أَحْسَبُهُ قَالَ: أَمْرِي ،  فَاصْرِفْهُ عَنِّي ، وَيَسِّرْ لِي الْخَيْرَ ، وَاقْضِ لِي بِهِ ، وَرَضِّنِي بِهِ  .","","Musnad al-Bazzar 1834","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن مبارك بن فضالة عن الهيثم بن جميل الأنطاكي عن الفضل بن يعقوب الرخامي عن البزار","بقية حديث زر"
"1848","1835  -  وَحَدَّثَنَاهُ  الْمُنْذِرُ بْنُ الْوَلِيدِ ، قَالَ:  حَدَّثَنِي  أَبِي  ،  عَنْ  سَعِيدِ بْنِ زَيْدٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ.  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى مِنْ حَدِيثِ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1835","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سعيد بن زيد الجهضمي عن الوليد بن عبد الرحمن بن حبيب الجارودي عن المنذر بن الوليد بن عبد الرحمن الجارودي عن البزار","بقية حديث زر"
"1849","1836  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي رَزِينٍ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ .","","Musnad al-Bazzar 1836","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن مسعود بن مالك الأسدي عن الأعمش عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","بقية حديث زر"
"1850","1837  -  وَحَدَّثَنَاهُ  سَلْمُ بْنُ جُنَادَةَ ، قَالَ:  نَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي رَزِينٍ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  كُنْتُ         [5/229]      مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي غَزْوَةٍ فَنَزَلَتْ         {      وَالْمُرْسَلاتِ عُرْفًا         }      فَتَلَقَّيْتُهَا مِنْ فِيهِ  وَإِنَّ فَاهُ رَطْبٌ بِهَا  .  وَزَادَ  ابْنُ أَبِي عُبَيْدَةَ  ، عَنْ أَبِيهِ ، عَنِ  الْأَعْمَشِ  ، عَنْ  أَبِي رَزِينٍ  ، عَنْ  زِرِّ بْنِ حُبَيْشِ  ، عَنْ  عَبْدِ اللهِ  قَالَ:  وَأَخَذْتُ مِنْ فِي رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَبْعِينَ سُورَةً  .  وَلَا نَعْلَمُ رَوَى  أَبُو رَزِينٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  حَدِيثًا  مُسْنَدًا  إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 1837","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن مسعود بن مالك الأسدي عن الأعمش عن عبد الله بن إدريس الأودي عن سلم بن جنادة السوائي عن البزار","بقية حديث زر"
"1851","1838  -  حَدَّثَنَا بِهِ  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ مُحَمَّدٍ أَبُو شَيْبَةَ ، قَالَ:  نَا  مُحَمَّدُ بْنُ أَبِي عُبَيْدَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي رَزِينٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ .","","Musnad al-Bazzar 1838","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن مسعود بن مالك الأسدي عن الأعمش عن عبد الملك بن معن المسعودي عن محمد بن أبي عبيدة المسعودي عن إبراهيم بن عبد الله أبو شيبة العبسي عن البزار","بقية حديث زر"
"1852","[5/230]      1839  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  يَحْيَى بْنُ سَعِيدٍ ، قَالَ:  نَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  عِيسَى الْأَسَدِيِّ وَهُوَ عِيسَى بْنُ عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  الطِّيَرَةُ  مِنَ  الشِّرْكِ  ،  وَمَا مِنَّا إِلَّا أَنَّ اللهَ تَبَارَكَ وَتَعَالَى يُذْهِبُهُ بِالتَّوَكُّلِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1839","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عيسى بن عاصم الأسدي عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن يحيى القطان عن الفلاس عن البزار","بقية حديث زر"
"1853","1840  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ الْجُنَيْدِ ، قَالَ:  نَا  سَعِيدُ بْنُ مَنْصُورٍ ، قَالَ:  نَا  أَبُو شَيْبَةَ يَزِيدُ بْنُ مُعَاوِيَةَ ، قَالَ:  نَا  عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ ،  عَنْ         [5/231]      زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ سُئِلَ أَيُّ الذَّنْبِ أَعْظَمُ ؟ قَالَ:  أَنْ تَجْعَلَ لِلهِ  نِدًّا  وَهُوَ خَلَقَكَ  ، قَالَ: ثُمَّ أَيٌّ ؟ قَالَ: ثُمَّ أَنْ تَقْتُلَ وَلَدَكَ خَشْيَةَ أَنْ يَطْعَمَ طَعَامَكَ ، قَالَ: ثُمَّ أَيٌّ ؟ قَالَ: ثُمَّ أَنْ تُزَانِيَ بِحَلِيلَةِ جَارِكَ  .  وَلَا نَعْلَمُ رَوَى  عَبْدُ الْمَلِكِ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ  إِلَّا هَذَا الْحَدِيثَ.","","Musnad al-Bazzar 1840","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عبد الملك بن عمير القبطي عن يزيد بن معاوية الخراساني عن سعيد بن منصور عن إبراهيم بن عبد الله بن الجنيد الختلي عن البزار","بقية حديث زر"
"1854","1841  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ ، قَالَ:  نَا  يُونُسُ بْنُ مُحَمَّدٍ ، قَالَ:  نَا  عَبْدُ الْمَلِكِ بْنُ الْوَلِيدِ بْنِ مَعْدَانَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ، وَأَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقْرَأُ فِي غَدَاةِ يَوْمِ الْجُمُعَةِ         {      الم             *          تَنْـزِيلُ         }      وَ         {      هَلْ أَتَى عَلَى الإِنْسَانِ         }      .","","Musnad al-Bazzar 1841","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن عبد الملك بن الوليد بن معدان الضبعي عن يونس بن محمد بن مسلم البغدادي عن محمد بن عبد الرحيم  صاعقة عن البزار","بقية حديث زر"
"1855","1842  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَعَمْرُو بْنُ عَلِيٍّ ، قَالَا:  نَا  بَدَلُ بْنُ الْمُحَبَّرِ ، قَالَ:  نَا  عَبْدُ الْمَلِكِ بْنُ الْوَلِيدِ بْنِ مَعْدَانَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ، وَزِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقْرَأُ فِي الرَّكْعَتَيْنِ اللَّتَيْنِ قَبْلَ الْفَجْرِ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ، وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .","","Musnad al-Bazzar 1842","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن عبد الملك بن الوليد بن معدان الضبعي عن بدل بن المحبر عن الفلاس عن البزار","بقية حديث زر"
"1856","[5/232]      1843  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  سَعِيدُ بْنُ أَشْعَثَ ، قَالَ:  نَا  عَبْدُ الْمَلِكِ بْنُ الْوَلِيدِ بْنِ مَعْدَانَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ، وَزِرٍّ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُسَلِّمُ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ  ،  يَعْنِي فِي الصَّلَاةِ  .         [5/233]      وَهَذِهِ الْأَحَادِيثُ لَا نَعْلَمُ رَوَاهَا عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ،  وَزِرٍّ  فَجَمَعَهُمَا إِلَّا  عَبْدُ الْمَلِكِ بْنُ الْوَلِيدِ  .","","Musnad al-Bazzar 1843","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن عبد الملك بن الوليد بن معدان الضبعي عن سعيد بن الأشعث السجستاني عن عباس بن جعفر العباسي عن البزار","بقية حديث زر"
"1857","1844  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ، قَالَ:  نَا  زَائِدَةُ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ:  أَوَّلُ مَنْ أَظْهَرَ إِسْلَامَهُ سَبْعَةٌ :  النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  وَأَبُو بَكْرٍ ،  وَبِلَالٌ ،  وَذَكَرَ جَمَاعَةً ، فَأَمَّا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَمَنَعَهُ اللهُ بِعَمِّهِ ،  وَأَمَّا  أَبُو بَكْرٍ  فَمَنَعَهُ اللهُ بِقَوْمِهِ ، وَأَمَّا سَائِرُهُمْ فَكَانُوا يُعَذَّبُونَ وَيُصْهَرُونَ فِي الشَّمْسِ  .         [5/234]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  زَائِدَةَ  مَوْصُولًا  إِلَّا  يَحْيَى بْنُ أَبِي بُكَيْرٍ  .","","Musnad al-Bazzar 1844","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن زائدة بن قدامة عن يحيى بن أبي بكير عن أبو موسى الزمن عن البزار","بقية حديث زر"
"1858","1845  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ الْأَهْوَازِيُّ ، قَالَ:  نَا  أَبُو أَحْمَدَ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ         {      وَإِذْ صَرَفْنَا إِلَيْكَ نَفَرًا مِنَ الْجِنِّ يَسْتَمِعُونَ الْقُرْآنَ فَلَمَّا حَضَرُوهُ قَالُوا أَنْصِتُوا         }      قَالَ:  صَهٍ ، قَالَ: فَكَانُوا سَبْعَةً أَكْبَرُهُمْ  زَوْبَعَةُ  .  وَهَذَا الْحَدِيثُ قَدْ  رَفَعَهُ  بَعْضُ أَصْحَابِ  أَبِي أَحْمَدَ  إِلَى  عَبْدِ اللهِ ،  وَبَعْضُهُمْ لَمْ يَقُلْ عَنْ  عَبْدِ اللهِ  .","","Musnad al-Bazzar 1845","","زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سفيان الثوري عن محمد بن عبد الله بن الزبير عن أحمد بن إسحاق بن عيسى الأهوازي عن البزار","بقية حديث زر"
"1859","1846  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ ، قَالَ:  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  عَبْدَةَ يَعْنِي ابْنَ أَبِي لُبَابَةَ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  مَنْ قَتَلَ حَيَّةً أَوْ عَقْرَبًا  فَقَدْ قَتَلَ كَافِرًا أَوْ كَأَنَّمَا قَتَلَ كَافِرًا  .","","Musnad al-Bazzar 1846","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عبدة بن أبي لبابة عن حبيب بن أبي ثابت الكاهلي عن منصور بن المعتمر عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن إبراهيم بن سعيد الجوهري عن البزار","بقية حديث زر"
"1860","[5/235]      1847  -  حَدَّثَنَا  إِسْحَاقُ بْنُ عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ يَعْقُوبَ ، قَالَ:  نَا  يَحْيَى بْنُ أَبِي زَكَرِيَّا ، قَالَ:  نَا  زَكَرِيَّا بْنُ عَبْدِ اللهِ بْنِ يَزِيدَ الْأَصْبَهَانِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ:  لَقَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُثْنِي عَلَى  النَّخَعِ  حَتَّى تَمَنَّيْتُ أَنْ يَكُونَ قَوْمِي مِنَ  النَّخَعِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  عَبْدِ اللهِ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1847","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عبد الله بن يزيد الصهباني عن زكريا بن عبد الله بن يزيد الصهباني عن يحيى بن أبي زكريا الغساني عن إسحاق بن عبد الله بن محمد بن يعقوب عن البزار","بقية حديث زر"
"1861","1848  -  حَدَّثَنَا  يَحْيَى بْنُ مُحَمَّدِ بْنِ السَّكَنِ ، قَالَ:  نَا  رَيْحَانُ بْنُ سَعِيدٍ ،         [5/236]      قَالَ:  نَا  عَرْعَرَةُ بْنُ الْبِرِنْدِ ،  عَنْ  رَوْحِ بْنِ الْقَاسِمِ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  إِذَا كَانُوا ثَلَاثَةً فَلَا  يَتَنَاجَى  اثْنَانِ دُونَ الثَّالِثِ  .","","Musnad al-Bazzar 1848","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن روح بن القاسم العنبري عن عرعرة بن البرند عن ريحان بن سعيد الناجي عن يحيى بن محمد بن السكن البزاز عن البزار","بقية حديث زر"
"1862","[5/237]      عَمْرُو بْنُ مَيْمُونٍ  عَنْ  عَبْدِ اللهِ  1849  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوًا مِنْ أَرْبَعِينَ رَجُلًا فَقَالَ:  أَتَرْضَوْنَ أَنْ تَكُونُوا رُبُعَ أَهْلِ الْجَنَّةِ ؟  قُلْنَا: نَعَمْ ، قَالَ: أَتَرْضَوْنَ أَنْ تَكُونُوا ثُلُثَ أَهْلِ الْجَنَّةِ ؟ قُلْنَا: نَعَمْ ، قَالَ: فَوَالَّذِي نَفْسِي بِيَدِهِ إِنِّي لَأَرْجُو أَنْ تَكُونُوا نِصْفَ أَهْلِ الْجَنَّةِ ، وَإِنَّ الْجَنَّةَ لَا يَدْخُلُهَا إِلَّا نَفْسٌ مُسْلِمَةٌ ، وَمَا أَنْتُمْ فِي أَهْلِ  الشِّرْكِ  إِلَّا كَالشَّعْرَةِ الْبَيْضَاءِ فِي جِلْدِ الثَّوْرِ الْأَسْوَدِ ، وَالشَّعْرَةِ السَّوْدَاءِ فِي جِلْدِ الثَّوْرِ الْأَحْمَرِ  .","","Musnad al-Bazzar 1849","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","عمرو بن ميمون عن عبد الله"
"1863","1850  -  وَحَدَّثَنَا  إِسْمَاعِيلُ بْنُ أَبِي الْحَارِثِ ، قَالَ:  نَا  جَعْفَرُ بْنُ عَوْنٍ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بِنَحْوِهِ.","","Musnad al-Bazzar 1850","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن سفيان الثوري عن جعفر بن عون المخزومي عن إسماعيل بن أسد بن شاهين البغدادي عن البزار","عمرو بن ميمون عن عبد الله"
"1864","[5/238]      1851  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَبْدِ اللهِ أَنَّهُ قَالَ:  بَيْنَمَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَاجِدٌ وَحَوْلَهُ نَاسٌ مِنْ  قُرَيْشٍ  إِذْ جَاءَ  عُقْبَةُ بْنُ أَبِي مُعَيْطٍ  بِسَلَا جَزُورٍ فَقَذَفَهُ عَلَى ظَهْرِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمْ يَرْفَعْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأْسَهُ ، فَجَاءَتْ  فَاطِمَةُ  فَأَخَذَتْهُ مِنْ ظَهْرِهِ وَدَعَتْ عَلَى مَنْ فَعَلَ ذَلِكَ ، قَالَ: فَلَمَّا رَفَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأْسَهُ قَالَ:  اللَّهُمَّ عَلَيْكَ الْمَلَأَ مِنْ  قُرَيْشٍ  :  أَبُو جَهْلٍ ،  وَعُتْبَةُ بْنُ رَبِيعَةَ ،         [5/239]      وَشَيْبَةُ بْنُ رَبِيعَةَ ،  وَعُقْبَةُ بْنُ أَبِي مُعَيْطٍ ،  وَأُمَيَّةُ بْنُ خَلَفٍ ، أَوِ ابْنُ أَبِي خَلَفٍ  -  شُعْبَةُ  الشَّاكُّ  ، قَالَ: فَلَقَدْ رَأَيْتُهُمْ قُتِلُوا  يَوْمَ بَدْرٍ  فَأُلْقُوا فِي  الْقَلِيبِ  إِلَّا  أُمَيَّةَ  أَوْ  أُبَيًّ  تَقَطَّعَتْ أَوْصَالُهُ فَلَمْ يُلْقَ فِي الْبِئْرِ  .","","Musnad al-Bazzar 1851","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","عمرو بن ميمون عن عبد الله"
"1865","[5/240]      1852  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ الْجُنَيْدِ ، قَالَ:  نَا  دَاوُدُ بْنُ عَمْرٍو ، قَالَ:  نَا  الْمُثَنَّى بْنُ زُرْعَةَ أَبُو رَاشِدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ:  حَدَّثَنِي  الْأَجْلَحُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ الْأَوْدِيِّ ،  عَنْ  عَبْدِ اللهِ قَالَ:  بَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْمَسْجِدِ  وَأَبُو جَهْلِ بْنُ هِشَامٍ ،  وَشَيْبَةُ ،  وَعُتْبَةُ ، ابْنَا رَبِيعَةَ ،  وَعُقْبَةُ بْنُ أَبِي مُعَيْطٍ ،  وَأُمَيَّةُ بْنُ خَلَفٍ ،  قَالَ  أَبُو إِسْحَاقَ  : وَرَجُلَانِ آخَرَانِ لَا أَحْفَظُ أَسْمَاءَهُمَا كَانُوا سَبْعَةً وَهُمْ فِي  الْحِجْرِ ،  وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي ، فَلَمَّا سَجَدَ أَطَالَ السُّجُودَ فَقَالَ  أَبُو جَهْلٍ  : أَيُّكُمْ يَأْتِي جَزُورَ بَنِي فُلَانٍ فَيَأْتِيَنَا بِفَرْثِهَا فَيُلْقِيَهُ عَلَى  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَانْطَلَقَ أَشْقَاهُمْ  عُقْبَةُ بْنُ أَبِي مُعَيْطٍ ،  فَأَتَى بِهِ ، فَأَلْقَاهُ عَلَى كَتِفَيْهِ ، وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَاجِدٌ ، قَالَ  ابْنُ مَسْعُودٍ  : وَأَنَا قَائِمٌ لَا أَسْتَطِيعُ أَنْ أَتَكَلَّمَ لَيْسَ عِنْدِي عَشِيرَةٌ تَمْنَعُنِي فَأَنَا أَرْهَبُ ،         [5/241]      إِذْ سَمِعْتُ  فَاطِمَةَ بِنْتَ رَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَقْبَلَتْ حَتَّى أَلْقَتْ ذَلِكَ عَنْ عَاتِقِهِ ، ثُمَّ اسْتَقْبَلَتْ  قُرَيْشًا  فَسَبَّتْهُمْ فَلَمْ يَرْجِعُوا إِلَيْهَا شَيْئًا ، وَرَفَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأْسَهُ كَمَا كَانَ يَرْفَعُهُ عِنْدَ تَمَامِ سُجُودِهِ ، فَلَمَّا قَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاتَهُ قَالَ:  اللَّهُمَّ عَلَيْكَ  بِقُرَيْشٍ  ثَلَاثًا ، عَلَيْكَ  بِعُتْبَةَ ،  وَعُقْبَةَ ،  وَأَبِي جَهْلٍ ،  وَشَيْبَةَ  ، ثُمَّ خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ الْمَسْجِدِ فَلَقِيَهُ  أَبُو الْبَخْتَرِيِّ ،  وَمَعَ  أَبِي الْبَخْتَرِيِّ  سَوْطٌ يَتَخَصَّرُ بِهِ ، فَلَمَّا رَأَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْكَرَ وَجْهَهُ فَقَالَ: مَا لَكَ ؟ فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: خَلِّ عَنِّي ، قَالَ: عَلِمَ اللهُ لَا أُخَلِّي عَنْكَ ، أَوْ تُخْبِرُنِي مَا شَأْنُكَ فَلَقَدْ أَصَابَكَ شَيْءٌ ، فَلَمَّا عَلِمَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ غَيْرُ مُخَلٍّ عَنْهُ أَخْبَرَهُ فَقَالَ: إِنَّ  أَبَا جَهْلٍ  أَمَرَ فَطُرِحَ عَلَيَّ فَرْثٌ ، فَقَالَ  أَبُو الْبَخْتَرِيِّ  : هَلُمَّ إِلَى الْمَسْجِدِ ، فَأَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَأَبُو الْبَخْتَرِيِّ  فَدَخَلَا الْمَسْجِدَ ، ثُمَّ أَقْبَلَ  أَبُو الْبَخْتَرِيِّ  إِلَى  أَبِي جَهْلٍ  فَقَالَ: يَا  أَبَا الْحَكَمِ ،  أَنْتَ الَّذِي أَمَرْتَ  بِمُحَمَّدٍ  فَطُرِحَ عَلَيْهِ الْفَرْثُ ؟ قَالَ: نَعَمْ ، قَالَ: فَرَفَعَ السَّوْطَ فَضَرَبَ بِهِ رَأْسَهُ ، قَالَ: فَثَارَتِ الرِّجَالُ بَعْضُهَا إِلَى بَعْضٍ ، قَالَ: وَصَاحَ  أَبُو جَهْلٍ  : وَيْحَكُمْ هِيَ لَهُ إِنَّمَا أَرَادَ  مُحَمَّدٌ  أَنْ يُلْقِيَ بَيْنَنَا الْعَدَاوَةَ وَيَنْجُوَ هُوَ وَأَصْحَابُهُ  .         [5/242]      وَهَذَا الْحَدِيثُ بِهَذَا اللَّفْظِ لَا نَعْلَمُ رَوَاهُ إِلَّا  الْأَجْلَحُ  ، وَقَدْ رَوَاهُ  إِسْرَائِيلُ  ،  وَشُعْبَةُ  ،  وَزَيْدُ بْنُ أَبِي أُنَيْسَةَ  ، وَغَيْرُهُمْ ، عَنْ  أَبِي إِسْحَاقَ  ، عَنْ  عَمْرِو بْنِ مَيْمُونٍ  ، عَنْ  عَبْدِ اللهِ  .","","Musnad al-Bazzar 1852","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن أجلح بن عبد الله الكندي عن محمد بن إسحاق عن مثنى بن زرعة عن داود بن عمرو المسيبي عن إبراهيم بن عبد الله بن الجنيد الختلي عن البزار","عمرو بن ميمون عن عبد الله"
"1866","1853  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مِسْكِينٍ ، قَالَ:  نَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ:  نَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  بَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَاجِدٌ عِنْدَ  الْكَعْبَةِ  وَحَوْلَهُ نَاسٌ مِنْ  قُرَيْشٍ ،  ثُمَّ ذَكَرَ نَحْوَ حَدِيثِ  شُعْبَةَ  وَزَادَ فِيهِ: فَلَمَّا رَفَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأْسَهُ حَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ثُمَّ قَالَ:  أَمَّا بَعْدُ ، اللَّهُمَّ عَلَيْكَ الْمَلَأَ مِنْ  قُرَيْشٍ  ، ثُمَّ قَصَّ الْقِصَّةَ  .  وَلَا نَعْلَمُ أَحَدًا زَادَ فِي هَذَا الْحَدِيثِ أَنَّهُ قَالَ: أَمَّا بَعْدُ إِلَّا  زَيْدَ بْنَ أَبِي أُنَيْسَةَ  .","","Musnad al-Bazzar 1853","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن علي بن معبد العبدي عن محمد بن مسكين بن نميلة اليمامي عن البزار","عمرو بن ميمون عن عبد الله"
"1867","[5/243]      1854  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عِيسَى بْنِ سَاسَانَ ، وَأَحْمَدُ بْنُ إِسْحَاقَ الْأَهْوَازِيُّ ، قَالَا:  نَا  مُوسَى بْنُ دَاوُدَ ، قَالَ:  نَا  الْفُضَيْلُ بْنُ مَرْزُوقٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  أَوَّلُ زُمْرَةٍ تَدْخُلُ الْجَنَّةَ مِنْ أُمَّتِي وُجُوهُهُمْ كَالْقَمَرِ لَيْلَةَ الْبَدْرِ ،  وَالزُّمْرَةُ الثَّانِيَةُ كَأَحْسَنِ كَوْكَبٍ  دُرِّيٍّ  فِي السَّمَاءِ ، لِكُلِّ امْرِئٍ مِنْهُمْ زَوْجَتَانِ ، عَلَى كُلِّ زَوْجَةٍ سَبْعُونَ  حُلَّةً  يُرَى مُخُّ سُوقِهِنَّ مِنْ وَرَاءِ الْحُلَلِ كَمَا يُرَى الشَّرَابُ الْأَحْمَرُ فِي الزُّجَاجَةِ الْبَيْضَاءِ  .  وَهَذَا الْحَدِيثُ إِنَّمَا نَحْفَظُهُ مِنْ حَدِيثِ  فُضَيْلٍ ،  عَنْ  أَبِي إِسْحَاقَ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1854","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن فضيل بن مرزوق الأغر عن موسى بن داود الخلقاني عن أحمد بن إسحاق بن عيسى الأهوازي عن البزار","عمرو بن ميمون عن عبد الله"
"1868","1855  -  حَدَّثَنَا  حَمْدَانُ بْنُ عَلِيٍّ ، وَإِبْرَاهِيمُ بْنُ عَبْدِ اللهِ ، قَالَا:  نَا  عَلِيُّ بْنُ حَكِيمٍ ، قَالَ:  نَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،         [5/244]      عَنْ  عَبْدِ اللهِ قَالَ:  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِأَصْحَابِهِ:  أَمَا يَسْتَطِيعُ أَحَدُكُمْ أَنْ يَقْرَأَ  ثُلُثَ  الْقُرْآنِ فِي لَيْلَةٍ ؟  ، قَالُوا: يَا رَسُولَ اللهِ ، وَمَنْ يُطِيقُ هَذَا ؟ قَالَ: أَمَا يَسْتَطِيعُ أَحَدٌ أَنْ يَقْرَأَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      فَإِنَّهَا تَعْدِلُ  ثُلُثَ  الْقُرْآنِ  .  هَكَذَا رَوَاهُ  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَبْدِ اللهِ  .","","Musnad al-Bazzar 1855","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن علي بن حكيم بن ذبيان عن إبراهيم بن عبد الله بن الجنيد الختلي عن البزار","عمرو بن ميمون عن عبد الله"
"1869","1856  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ:  نَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ ، قَالَ:  نَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ:  كَانَ  عُتْبَةُ بْنُ رَبِيعَةَ  صَدِيقًا  لِسَعْدِ بْنِ مُعَاذٍ  فِي الْجَاهِلِيَّةِ ، فَكَانَ إِذَا قَدِمَ  عُتْبَةُ  الْمَدِينَةَ  نَزَلَ عَلَى  سَعْدِ بْنِ مُعَاذٍ ،  وَكَانَ إِذَا قَدِمَ  سَعْدٌ  مَكَّةَ         [5/245]      نَزَلَ عَلَى  عُتْبَةَ ،  وَكَانَ  عُتْبَةُ  يُسَمِّيهِ أَخِي الْيَثْرِبِيَّ قَالَ: فَلَمَّا قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْمَدِينَةَ  قَدِمَ  سَعْدُ بْنُ مُعَاذٍ  مَكَّةَ  كَمَا كَانَ يَقْدَمُ ، فَنَزَلَ عَلَى  عُتْبَةَ  فَقَالَ: إِنِّي أُرِيدُ أَنْ أَطُوفَ  بِالْبَيْتِ ،  فَقَالَ لَهُ  عُتْبَةُ  : أَمْهِلْ حَتَّى يَتَفَرَّقَ الْمَلَأُ مِنْ  قُرَيْشٍ  مِنَ  الْمَسْجِدِ أَوْ مِنْ حَوْلِ  الْبَيْتِ  قَالَ: فَأَمْهَلَ قَلِيلًا ، ثُمَّ قَالَ لَهُ: انْطَلِقْ مَعِي ، فَلَمَّا أَتَيَا  الْبَيْتَ  تَلَقَّى  أَبُو جَهْلٍ  سَعْدًا  فَقَالَ: يَا  سَعْدُ ،  آوَيْتُمْ  مُحَمَّدًا  ثُمَّ تَطُوفُ  بِالْبَيْتِ  آمِنًا ؟ فَقَالَ لَهُ  سَعْدٌ  : لَئِنْ مَنَعْتَنِي  لَأَقْطَعَنَّ عَلَيْكَ أَوْ لَأَمْنَعَنَّكَ  مِنْ تِجَارَتِكَ إِلَى مَوْضِعِ كَذَا لِمَوْضِعٍ ذَكَرَهُ ، قَالَ: وَارْتَفَعَتْ أَصْوَاتُهُمَا ، فَقَالَ  عُتْبَةُ  لِسَعْدٍ  : أَتَرْفَعُ صَوْتَكَ عَلَى  أَبِي الْحَكَمِ ؟  قَالَ: فَقَالَ لَهُ  سَعْدٌ  : وَأَنْتَ تَقُولُ ذَلِكَ لَقَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ:  إِنَّهُ قَاتِلُكَ  ، قَالَ: فَنَفَضَ يَدَهُ مِنْ يَدِهِ ، وَقَالَ: إِنَّ  مُحَمَّدًا  لَا يَكْذِبُ ، قَالَ: فَطَافَ  سَعْدٌ  ، ثُمَّ انْصَرَفَ ، وَأَتَى  عُتْبَةَ  امْرَأَتَهُ فَقَالَ: أَلَمْ تَسْمَعِي مَا قَالَ أَخِي الْيَثْرِبِيُّ ؟ قَالَتْ: وَمَا قَالَ ؟ قَالَ: زَعَمَ أَنَّ  مُحَمَّدًا  قَاتِلِي ، وَإِنَّ  مُحَمَّدًا  لَا يَكْذِبُ ، قَالَ: فَمَا كَانَ إِلَّا قَلِيلًا حَتَّى كَانَ مِنْ أَمْرِ  بَدْرٍ  قَالَ: فَجَعَلَ  أَبُو جَهْلٍ  يَطُوفُ عَلَى النَّاسِ ،  وَذَكَرَ الْحَدِيثَ بِطُولِهِ .","","Musnad al-Bazzar 1856","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن عبد المجيد الحنفي عن محمد بن معمر بن ربعي البحراني عن البزار","عمرو بن ميمون عن عبد الله"
"1870","[5/246]      1857  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَدْعُو بِهَذَا الدُّعَاءِ: اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْجُبْنِ وَالْبُخْلِ ،  وَسُوءِ الْعُمُرِ ، وَفِتْنَةِ الصَّدْرِ ، وَعَذَابِ الْقَبْرِ .","","Musnad al-Bazzar 1857","","عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","عمرو بن ميمون عن عبد الله"
"1871","1858  - وَأَحْسَبُ أَنَّ عَبْدَةَ بْنَ عَبْدِ اللهِ  حَدَّثَنَاهُ ،  عَنْ  عُبَيْدِ اللهِ بْنِ مُوسَى ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ.  وَقَدْ رَوَى هَذَا الْحَدِيثَ  يُونُسُ بْنُ أَبِي إِسْحَاقَ  ، عَنْ أَبِيهِ ، عَنْ  عَمْرِو بْنِ مَيْمُونٍ  ، عَنْ  عُمَرَ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ.","","Musnad al-Bazzar 1858","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن عبيد الله بن موسى عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","عمرو بن ميمون عن عبد الله"
"1872","1859  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عَقِيلٍ ، قَالَ:  نَا  سَهْلُ بْنُ حَمَّادٍ أَبُو عَتَّابٍ ، قَالَ:  نَا  جَرِيرُ بْنُ أَيُّوبَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فِي قَوْلِ اللهِ تَبَارَكَ وَتَعَالَى:         {      يَوْمَ تُبَدَّلُ الأَرْضُ غَيْرَ الأَرْضِ         }      قَالَ:  أَرْضٌ         [5/247]      بَيْضَاءُ لَمْ  يُسْفَكْ  عَلَيْهَا دَمٌ ، أَوْ لَمْ يُعْمَلْ عَلَيْهَا خَطِيئَةٌ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرٍو ،  عَنْ  عَبْدِ اللهِ  مَرْفُوعًا  إِلَّا  جَرِيرُ بْنُ أَيُّوبَ ،  وَجَرِيرٌ  فَلَيْسَ بِالْقَوِيِّ  .","","Musnad al-Bazzar 1859","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن جرير بن أيوب بن أبي زرعة البجلي عن سهل بن حماد الدلال عن محمد بن عبد الله بن عبيد بن عقيل الهلالي عن البزار","عمرو بن ميمون عن عبد الله"
"1873","1860  -  حَدَّثَنَا  أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ ، قَالَ:  نَا  خَالِدُ بْنُ مَخْلَدٍ ، قَالَ:  نَا  عَلِيُّ بْنُ صَالِحٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ قَالَ:  نَا  عَبْدُ اللهِ فِي بَيْتِ الْمَالِ قَالَ:  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي عِنْدَ  الْبَيْتِ  وَمَلَأٌ مِنْ  قُرَيْشٍ  جُلُوسٌ وَقَدْ نَحَرُوا جَزُورًا ، فَقَالَ: -  أَظُنُّهُ  أَبُو جَهْلٍ  - : أَيُّكُمْ يَأْخُذُ هَذَا الْفَرْثَ بِدَمِهِ ثُمَّ يُمْهِلُ حَتَّى يَضَعَ         [5/248]      مُحَمَّدٌ  وَجْهَهُ سَاجِدًا فَيَضَعُهُ عَلَى ظَهْرِهِ ؟ قَالَ  عَبْدُ اللهِ  : إِذِ انْبَعَثَ أَشْقَاهَا فَأَخَذَ الْفَرْثَ ، فَلَمَّا خَرَّ سَاجِدًا وَضَعَهُ عَلَى ظَهْرِهِ ، فَأُخْبِرَتْ  فَاطِمَةُ بِنْتُ رَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهِيَ جَارِيَةٌ فَجَاءَتْ تَسْعَى ، فَأَخَذَتْهُ مِنْ ظَهْرِهِ ، فَلَمَّا فَرَغَ مِنْ صَلَاتِهِ قَالَ:  اللَّهُمَّ عَلَيْكَ  بِقُرَيْشٍ ،  اللَّهُمَّ عَلَيْكَ  بِأَبِي جَهْلِ بْنِ هِشَامٍ ،  وَشَيْبَةَ بْنِ رَبِيعَةَ ،  وَعُتْبَةَ بْنِ رَبِيعَةَ ،  وَعُقْبَةَ بْنِ أَبِي مُعَيْطٍ  ، حَتَّى عَدَّ سَبْعَةً مِنْ  قُرَيْشٍ ،  قَالَ  عَبْدُ اللهِ  : فَوَالَّذِي أَنْزَلَ عَلَيْهِ الْكِتَابَ لَقَدْ رَأَيْتُهُمْ  يَوْمَ بَدْرٍ  فِي  قَلِيبٍ  وَاحِدٍ  .","","Musnad al-Bazzar 1860","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن علي بن صالح بن حي عن خالد بن مخلد القطواني عن أحمد بن عثمان بن حكيم عن البزار","عمرو بن ميمون عن عبد الله"
"1874","1861  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقُطَعِيُّ ، قَالَ:  نَا  أَبُو دَاوُدَ ، قَالَ:  نَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  لَمَّا قَتَلْتُ  أَبَا جَهْلِ  أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ:  هَذَا فِرْعَوْنُ هَذِهِ الْأُمَّةِ  .","","Musnad al-Bazzar 1861","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن أبو داود الطيالسي عن محمد بن يحيى بن أبي حزم القطعي عن البزار","عمرو بن ميمون عن عبد الله"
"1875","1862  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  يَحْيَى بْنُ كَثِيرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  سُنَّةَ بْنِ مُسْلِمٍ الْبَطِينِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ، قَالَ:         [5/249]      جَلَسْتُ إِلَى عَبْدِ اللهِ سَنَةً فَلَمْ يُحَدِّثْ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَدِيثًا ،  فَقَالَ  يَوْمًا:  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَتَغَيَّرَ وَجْهُهُ وَقَالَ نَحْوَ هَذَا أَوْ فَوْقَ هَذَا أَوْ دُونَ هَذَا  .","","Musnad al-Bazzar 1862","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن مسلم بن عمران البطين عن سنة بن مسلم عن شعبة بن الحجاج عن يحيى بن كثير العنبري عن أبو موسى الزمن عن البزار","عمرو بن ميمون عن عبد الله"
"1876","1863  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  عَبْدُ الصَّمَدِ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  عُتْبَةَ ،  عَنْ  مُسْلِمٍ الْبَطِينِ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَبْدِ اللهِ ، نَحْوَهُ.","","Musnad al-Bazzar 1863","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن مسلم بن عمران البطين عن عتبة بن عبد الله بن عتبة المسعودي عن شعبة بن الحجاج عن عبد الصمد بن عبد الوارث التنوري عن أبو موسى الزمن عن البزار","عمرو بن ميمون عن عبد الله"
"1877","[5/250]      1864  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ ، قَالَ:  نَا  عُبَيْدُ بْنُ إِسْحَاقَ الْعَطَّارُ ، قَالَ:  نَا  زُهَيْرٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  الرُّؤْيَا الصَّالِحَةُ بُشْرَى وَهِيَ  جُزْءٌ  مِنْ سَبْعِينَ  جُزْءًا  مِنَ النُّبُوَّةِ ،  وَإِنَّ نَارَكُمْ يَعْنِي هَذِهِ جُزْءٌ مِنْ سَبْعِينَ جُزْءًا مِنْ  سَمُومِ  جَهَنَّمَ ،  وَمَا دَامَ الْعَبْدُ يَنْتَظِرُ الصَّلَاةَ فَهُوَ فِي صَلَاةٍ مَا لَمْ يُحْدِثْ  .  هَكَذَا رَوَاهُ  زُهَيْرٌ  وَلَا نَعْلَمُ رَوَاهُ عَنْ  زُهَيْرٍ  إِلَّا  عُبَيْدُ بْنُ إِسْحَاقَ ،  وَرَوَاهُ  عَمْرُو بْنُ ثَابِتٍ  ، عَنْ  أَبِي إِسْحَاقَ  ، عَنْ  عَمْرٍو الْأَصَمِّ  ، عَنْ  عَبْدِ اللهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ ، وَرَوَاهُ غَيْرُ  عَمْرِو بْنِ ثَابِتٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرٍو الْأَصَمِّ ،  عَنْ  عَبْدِ اللهِ  مَوْقُوفًا  .","","Musnad al-Bazzar 1864","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن عبيد بن إسحاق عطار المطلقات عن محمد بن عبد الرحيم  صاعقة عن البزار","عمرو بن ميمون عن عبد الله"
"1878","[5/251]      الرَّبِيعُ بْنُ خُثَيْمٍ  عَنْ  عَبْدِ اللهِ  1865  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  يَحْيَى بْنُ سَعِيدٍ ، قَالَ:  نَا  سُفْيَانُ ،  عَنْ  أَبِيهِ ،  عَنْ  مُنْذِرٍ الثَّوْرِيِّ ،  عَنِ  الرَّبِيعِ بْنِ خُثَيْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ:  خَطَّ لَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا خَطًّا ، وَخَطَّ عَنْ يَمِينِهِ خَطًّا ، وَخَطَّ عَنْ يَسَارِهِ خَطًّا ، ثُمَّ قَالَ:  هَذَا  سَبِيلُ  اللهِ ، ثُمَّ خَطَّ خُطُوطًا فَقَالَ: هَذِهِ سُبُلٌ ،  عَلَى كُلِّ سَبِيلٍ مِنْهَا شَيْطَانٌ يَدْعُو إِلَيْهِ ، وَقَرَأَ         {      وَأَنَّ هَذَا صِرَاطِي مُسْتَقِيمًا فَاتَّبِعُوهُ وَلا تَتَّبِعُوا السُّبُلَ فَتَفَرَّقَ بِكُمْ         }      .  وَهَذَا الْكَلَامُ قَدْ رُوِيَ ، عَنْ  عَبْدِ اللهِ  مِنْ غَيْرِ وَجْهٍ نَحْوَهُ أَوْ قَرِيبًا مِنْهُ.","","Musnad al-Bazzar 1865","","عبد الله بن مسعود عن الربيع بن خثيم الثوري عن المنذر بن يعلى الثوري عن سعيد بن مسروق الثوري عن سفيان الثوري عن يحيى القطان عن الفلاس عن البزار","الربيع بن خثيم عن عبد الله"
"1879","1866  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَزِيعٍ ، قَالَ:  نَا  أَبُو بَكْرٍ الْبَكْرَاوِيُّ عَبْدُ الرَّحْمَنِ بْنُ عُثْمَانَ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  عَلِيِّ بْنِ مُدْرِكٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الرَّبِيعِ بْنِ خُثَيْمٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:         {      قُلْ هُوَ اللهُ أَحَدٌ         }      تَعْدِلُ  ثُلُثَ  الْقُرْآنِ  .         [5/252]      وَهَذَا الْحَدِيثُ رَوَاهُ عَنْ  شُعْبَةَ  مُعَاذُ بْنُ مُعَاذٍ  ،  وَأَبُو بَحْرٍ الْبَكْرَاوِيُّ  .","","Musnad al-Bazzar 1866","","عبد الله بن مسعود عن الربيع بن خثيم الثوري عن إبراهيم النخعي عن علي بن مدرك الوهبيلي عن شعبة بن الحجاج عن أبو بحر البكراوي عن محمد بن عبد الله بن بزيع البصري عن البزار","الربيع بن خثيم عن عبد الله"
"1880","1867  -  حَدَّثَنَا  الْفَضْلُ بْنُ سَهْلٍ ، قَالَ:  نَا  غَسَّانُ بْنُ الرَّبِيعِ ،  عَنْ  هِلَالِ بْنِ أَبِي ضِيَاءٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنِ  الرَّبِيعِ بْنِ خُثَيْمٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  قَرْضُ مَرَّتَيْنِ تَعْدِلُ صَدَقَةَ مَرَّةٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ يُرْوَى عَنِ  الرَّبِيعِ بْنِ خُثَيْمٍ ،  عَنْ  عَبْدِ اللهِ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1867","","عبد الله بن مسعود عن الربيع بن خثيم الثوري عن هلال بن يساف الأشجعي عن هلال بن أبي ضياء عن غسان بن الربيع الأزدي عن الفضل بن سهل الخراساني عن البزار","الربيع بن خثيم عن عبد الله"
"1881","1868  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ، قَالَ:  نَا  أَبُو الْيَمَانِ ، قَالَ:  نَا  سَعِيدُ بْنُ سِنَانٍ ،  عَنْ  أَبِي الزَّاهِرِيَّةِ ،  عَنْ  كَثِيرِ بْنِ مُرَّةَ ،  عَنِ  الرَّبِيعِ بْنِ خُثَيْمٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 1868","","عبد الله بن مسعود عن الربيع بن خثيم الثوري عن كثير بن مرة الرهاوي عن أبو الزاهرية حدير بن كريب عن سعيد بن سنان الحمصي عن أبو اليمان الحكم بن نافع عن إبراهيم بن سعيد الجوهري عن البزار","الربيع بن خثيم عن عبد الله"
"1882","[5/253]      عَمْرُو بْنُ سَلِمَةَ  عَنْ  عَبْدِ اللهِ  1869  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُكْرَمٍ ، قَالَ:  نَا  الْحُسَيْنُ بْنُ عَلِيٍّ ، قَالَ:  نَا  زَائِدَةُ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَمْرِو بْنِ سَلِمَةَ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  مَا مِنْ مُسْلِمَيْنِ إِلَّا وَبَيْنَهُمَا سِتْرٌ مِنَ اللهِ ،  فَإِذَا قَالَ أَحَدُهُمَا لِصَاحِبِهِ كَلِمَةَ مُجْرٍ خَرَقَ سِتْرَ اللهِ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُ رَوَاهُ بِهَذَا اللَّفْظِ عَنْ  عَبْدِ اللهِ  إِلَّا  عَمْرُو بْنُ سَلِمَةَ  .","","Musnad al-Bazzar 1869","","عبد الله بن مسعود عن عمرو بن سلمة بن الحارث الهمداني عن يزيد بن أبي زياد القرشي عن زائدة بن قدامة عن الحسين بن علي الجعفي عن جعفر بن مكرم الدوري عن البزار","عمرو بن سلمة عن عبد الله"
"1883","[5/254]      أَبُو الْجَعْدِ  عَنْ  عَبْدِ اللهِ  1870  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ.","","Musnad al-Bazzar 1870","","عبد الله بن مسعود عن رافع الغطفاني عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","أبو الجعد عن عبد الله"
"1884","1871  -  وَحَدَّثَنَا  يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ ، قَالَ:  نَا  الْمُعْتَمِرُ ، قَالَ:  سَمِعْتُ  أَبِي  يُحَدِّثُ ، عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  مَا مِنْكُمْ مِنْ أَحَدٍ إِلَّا وَقَدْ وُكِّلَ بِهِ قَرِينٌ مِنَ الْجِنِّ  ، قَالُوا: وَبِكَ ؟ قَالَ: وَبِي ، إِلَّا أَنَّ اللهَ أَعَانَنِي عَلَيْهِ  فَأَسْلَمَ  .         [5/255]      وَهَذَا الْحَدِيثُ بِهَذَا اللَّفْظِ لَا نَحْفَظُهُ عَنْ  عَبْدِ اللهِ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1871","","عبد الله بن مسعود عن رافع الغطفاني عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن سليمان بن طرخان عن معتمر بن سليمان عن يحيى بن حبيب الحارثي عن البزار","أبو الجعد عن عبد الله"
"1885","[5/256]      هُبَيْرَةُ بْنُ يَرِيمَ  عَنْ  عَبْدِ اللهِ  1872  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ، قَالَ:  نَا  أَبُو أُسَامَةَ ، قَالَ:  نَا  الْأَعْمَشُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ ،  عَنْ  عَبْدِ اللهِ قَالَ :  لَوْ أَعْلَمُ أَنَّ أَحَدًا أَعْلَمُ بِكِتَابِ اللهِ مِنِّي تَبْلُغُنِي إِلَيْهِ رَاحِلَةٌ لَأَتَيْتُهُ ،  لَقَدْ أَخَذْتُ مِنْ فِي رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَبْعِينَ سُورَةً  .","","Musnad al-Bazzar 1872","","عبد الله بن مسعود عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن الأعمش عن حماد بن أسامة القرشي عن إبراهيم بن سعيد الجوهري عن البزار","هبيرة بن يريم عن عبد الله"
"1886","1873  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَعِيدٍ ، قَالَ:  نَا  أَبُو خَالِدٍ يَعْنِي سُلَيْمَانَ بْنَ حَيَّانَ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ ،  عَنْ  عَبْدِ اللهِ قَالَ:  مَنْ أَتَى  كَاهِنًا  أَوْ سَاحِرًا فَصَدَّقَهُ بِمَا يَقُولُ فَقَدْ كَفَرَ بِمَا أُنْزِلَ عَلَى  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .         [5/257]      وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ غَيْرُ وَاحِدٍ ، عَنْ  أَبِي إِسْحَاقَ  ، عَنْ  هُبَيْرَةَ  ، عَنْ  عَبْدِ اللهِ  ، وَأَمَّا حَدِيثُ  أَخَذْتُ مِنْ فِي رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَبْعِينَ سُورَةً  فَلَا نَعْلَمُ رَوَاهُ عَنْ  أَبِي إِسْحَاقَ  ، عَنْ  هُبَيْرَةَ  إِلَّا  الْأَعْمَشُ  ، وَلَا رَوَاهُ عَنِ  الْأَعْمَشِ  إِلَّا  أَبُو أُسَامَةَ  ،  وَعَبْدَةُ بْنُ سُلَيْمَانَ  .","","Musnad al-Bazzar 1873","","عبد الله بن مسعود عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن عمرو بن قيس الملائي عن سليمان بن حيان الأحمر عن عبد الله بن سعيد الأشج عن البزار","هبيرة بن يريم عن عبد الله"
"1887","1874  -  حَدَّثَنَا  الْجَرَّاحُ بْنُ مَخْلَدٍ ، قَالَ:  نَا  عُمَيْرُ بْنُ عَبْدِ الْمَجِيدِ ، قَالَ:  نَا         [5/258]      شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ ،  عَنْ  عَبْدِ اللهِ  رَفَعَهُ  قَالَ:  الصَّوْمُ  جُنَّةٌ ،  وَلَخُلُوفُ  فَمِ الصَّائِمِ أَطْيَبُ عِنْدَ اللهِ مِنْ رِيحِ الْمِسْكِ  .  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ غَيْرُ  عُمَيْرٍ  مَوْقُوفًا  .","","Musnad al-Bazzar 1874","","عبد الله بن مسعود عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن عمير بن عبد المجيد الحنفي عن الجراح بن مخلد عن البزار","هبيرة بن يريم عن عبد الله"
"1888","[5/259]      عَمْرُو بْنُ شُرَحْبِيلَ  عَنْ  عَبْدِ اللهِ  1875  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ:  نَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ، قَالَ:  نَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ، وَمَنْصُورٍ ، وَوَاصِلٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَمْرِو بْنِ شُرَحْبِيلَ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  سُئِلَ أَيُّ الذَّنْبِ أَعْظَمُ ؟ قَالَ:  أَنْ تَجْعَلَ لِلهِ  نِدًّا  وَهُوَ خَلَقَكَ  ، قَالَ: ثُمَّ أَيُّ ؟ قَالَ: ثُمَّ أَنْ تَقْتُلَ وَلَدَكَ أَنْ يَطْعَمَ طَعَامَكَ ، قَالَ: ثُمَّ أَيُّ ؟ قَالَ: ثُمَّ أَنْ تُزَانِيَ بِحَلِيلَةِ جَارِكَ ، ثُمَّ قَرَأَ         {      وَالَّذِينَ لا يَدْعُونَ مَعَ اللهِ إِلَهًا آخَرَ         }      .         [5/260]             [5/261]      وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ غَيْرُ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ  وَلَمْ يُذْكَرْ وَاحِدٌ مِنْهُمْ.","","Musnad al-Bazzar 1875","","عبد الله بن مسعود عن عمرو بن شرحبيل الهمداني عن شقيق بن سلمة عن واصل بن حيان الأحدب عن سفيان الثوري عن عبد الرحمن بن مهدي عن محمد بن بشار بندار عن البزار","عمرو بن شرحبيل عن عبد الله"
"1889","[5/262]      1876  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَعِيدٍ ، قَالَ:  نَا  يُونُسُ بْنُ بُكَيْرٍ ، قَالَ:  نَا  الْأَعْمَشُ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  عَمْرِو بْنِ شُرَحْبِيلَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا لِيُضِلَّ بِهِ  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .         [5/263]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ  أَسْنَدَهُ  عَنِ  الْأَعْمَشِ ،  عَنْ  طَلْحَةَ  إِلَّا  يُونُسُ بْنُ بُكَيْرٍ ،  وَقَدْ رَوَاهُ غَيْرُ  يُونُسَ ،  عَنِ  الْأَعْمَشِ  مُرْسَلًا  .","","Musnad al-Bazzar 1876","","عبد الله بن مسعود عن عمرو بن شرحبيل الهمداني عن طلحة بن مصرف الهمداني عن الأعمش عن يونس بن بكير عن عبد الله بن سعيد الأشج عن البزار","عمرو بن شرحبيل عن عبد الله"
"1890","[5/264]      الْأَحْنَفُ بْنُ قَيْسٍ  عَنْ  عَبْدِ اللهِ  1877  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  يَحْيَى ،  عَنِ  ابْنِ جُرَيْجٍ .  1878  -  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ سَعِيدٍ ، قَالَ:  نَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  سُلَيْمَانَ بْنِ عَتِيقٍ ،  عَنْ  طَلْقِ بْنِ حَبِيبٍ ،  عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  أَلَا هَلَكَ  الْمُتَنَطِّعُونَ ،  أَلَا هَلَكَ  الْمُتَنَطِّعُونَ  قَالَهَا ثَلَاثًا  .  وَلَا نَعْلَمُ رَوَى  الْأَحْنَفُ ،  عَنْ  عَبْدِ اللهِ  إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 1877","","عبد الله بن مسعود عن الأحنف بن قيس السعدي عن طلق بن حبيب العنزي عن سليمان بن عتيق المحاربي عن ابن جريج عن حفص بن غياث النخعي عن عبد الله بن سعيد الأشج عن البزار","الأحنف بن قيس عن عبد الله"
"1891","[5/265]      أَبُو عُثْمَانَ النَّهْدِيُّ  عَنْ  عَبْدِ اللهِ  1879  -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ، قَالَ:  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  التَّيْمِيِّ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  لَا يَمْنَعَنَّكُمْ مِنَ السَّحُورِ أَذَانُ  بِلَالٍ  فَكُلُوا وَاشْرَبُوا حَتَّى يُؤَذِّنَ  ابْنُ أُمِّ مَكْتُومٍ  .         [5/266]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى ، عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ ،  وَقَدْ رَوَاهُ غَيْرُ وَاحِدٍ عَنِ  التَّيْمِيِّ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ  .","","Musnad al-Bazzar 1879","","عبد الله بن مسعود عن أبو عثمان النهدي عن سليمان بن طرخان عن حماد بن سلمة عن عبد الواحد بن غياث عن البزار","أبو عثمان النهدي عن عبد الله"
"1892","1880  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ ، قَالَ:  نَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّهُ نَظَرَ إِلَى نَاسٍ مِنَ         [5/267]      الزُّطِّ  فَقَالَ:  هَؤُلَاءِ أَشْبَهُ مَنْ رَأَيْتُ بِالْجِنِّ  ،  يَعْنِي لَيْلَةَ الْجِنِّ  .  وَهَذَا اللَّفْظُ لَا نَعْلَمُهُ يُرْوَى إِلَّا عَنْ  أَبِي عُثْمَانَ ،  عَنْ  عَبْدِ اللهِ  .","","Musnad al-Bazzar 1880","","عبد الله بن مسعود عن أبو عثمان النهدي عن سليمان بن طرخان عن يزيد بن زريع العيشي عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","أبو عثمان النهدي عن عبد الله"
"1893","1881  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ ، قَالَ:  نَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّ  رَجُلًا  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ أَنَّهُ لَقِيَ  امْرَأَةً  فَذَكَرَ أَنَّهُ أَصَابَ مِنْهَا  قُبْلَةً أَوْ شَيْئًا ذَكَرَهُ ،  فَكَأَنَّهُ سُئِلَ عَنْ كَفَّارَتِهِ ،  فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ:         {      وَأَقِمِ الصَّلاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا         }      الْآيَةَ  .","","Musnad al-Bazzar 1881","","عبد الله بن مسعود عن أبو عثمان النهدي عن سليمان بن طرخان عن يزيد بن زريع العيشي عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","أبو عثمان النهدي عن عبد الله"
"1894","[5/268]      1882  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى ، قَالَ:  نَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ  حَدَّثَنِي  أَبِي  ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنِ  التَّلَقِّي  .","","Musnad al-Bazzar 1882","","عبد الله بن مسعود عن أبو عثمان النهدي عن سليمان بن طرخان عن معتمر بن سليمان عن محمد بن عبد الأعلى القيسي عن البزار","أبو عثمان النهدي عن عبد الله"
"1895","1883  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ سَمُرَةَ ، قَالَ:  نَا  مُحَمَّدُ بْنُ فُضَيْلٍ ، قَالَ:  نَا  عَاصِمٌ يَعْنِي الْأَحْوَلَ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  عَبْدِ اللهِ قَالَ:         [5/269]      أُمِرْنَا إِذَا رَأَيْنَا مِنْ  يَنْشُدُ  ضَالَّةً فِي الْمَسْجِدِ أَنْ نَقُولَ لَهُ: لَا وَجَدْتَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1883","","عبد الله بن مسعود عن أبو عثمان النهدي عن عاصم بن سليمان الأحول عن محمد بن فضيل بن غزوان عن محمد بن إسماعيل الأحمسي عن البزار","أبو عثمان النهدي عن عبد الله"
"1896","1884  -  حَدَّثَنَا  زَيْدُ بْنُ أَخْزَمَ الطَّائِيُّ ، قَالَ:  نَا  أَبُو دَاوُدَ ، قَالَ:  نَا  أَبُو عَوَانَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  مَنْ جَرَّ ثَوْبَهُ مِنَ  الْخُيَلَاءِ  -  أَوْ قَالَ فِي الصَّلَاةِ ،  لَمْ يَكُنْ مِنَ اللهِ فِي حِلٍّ وَلَا حَرَامٍ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  عَبْدِ اللهِ ،  وَقَدْ رَوَاهُ غَيْرُ وَاحِدٍ ، عَنْ  عَاصِمٍ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  عَبْدِ اللهِ  مَوْقُوفًا ،  وَأَسْنَدَهُ  أَبُو عَوَانَةَ  .","","Musnad al-Bazzar 1884","","عبد الله بن مسعود عن أبو عثمان النهدي عن عاصم بن سليمان الأحول عن الوضاح بن عبد الله اليشكري عن أبو داود الطيالسي عن زيد بن أخزم الطائي عن البزار","أبو عثمان النهدي عن عبد الله"
"1897","1885  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الضُّبَعِيُّ ، قَالَ:  نَا  مُحَمَّدُ بْنُ يَزِيدَ         [5/270]      الْوَاسِطِيُّ ، قَالَ:  نَا  الْحَجَّاجُ بْنُ أَبِي زَيْنَبَ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  عَبْدِ اللهِ قَالَ:  مَرَّ بِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَدْ وَضَعْتُ شِمَالِي عَلَى يَمِينِي  فَأَخَذَ يَمِينِي فَوَضَعَهَا عَلَى شِمَالِي  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  أَبِي عُثْمَانَ ،  عَنْ  عَبْدِ اللهِ  إِلَّا  الْحَجَّاجُ بْنُ أَبِي زَيْنَبَ ،  وَهُوَ رَجُلٌ وَاسِطِيُّ ، رَوَى عَنْهُ  هُشَيْمٌ  ،  وَيَزِيدُ بْنُ هَارُونَ ،  وَمُحَمَّدُ بْنُ يَزِيدَ  .","","Musnad al-Bazzar 1885","","عبد الله بن مسعود عن أبو عثمان النهدي عن حجاج  بن أبي زينب الصيقل عن محمد بن يزيد الكلاعي عن محمد بن العباس الضبعي عن البزار","أبو عثمان النهدي عن عبد الله"
"1898","[5/271]      1886  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ:  نَا  مُحَمَّدُ بْنُ أَبِي عَدِيٍّ ،  عَنْ  جَعْفَرِ بْنِ مَيْمُونٍ ،  عَنْ  أَبِي تَمِيمَةَ السَّلُولِيِّ ، قَالَ  بُنْدَارٌ ،  وَيُقَالَ :  السَّلِّيُّ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنِ  ابْنِ مَسْعُودٍ قَالَ:  صَلَّى بِنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاةَ الْعِشَاءِ ثُمَّ انْصَرَفَ فَأَخَذَ بِيَدِي ، وَخَرَجَ إِلَى  الْبَطْحَاءِ ،  بَطْحَاءِ مَكَّةَ ،  ثُمَّ خَطَّ عَلَيْهِ خَطًّا - يَعْنِي عَلَى  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  ثُمَّ قَالَ:  لَا تَبْرَحَنَّ خَطَّكَ ، فَإِنِ انْتَهَى إِلَيْكَ أَحَدٌ فَلَا تُكَلِّمْهُ  ، ثُمَّ مَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَيْثُ أَرَادَ ، فَبَيْنَا أَنَا جَالِسٌ فِي خَطِّي إِذْ أَتَانِي رِجَالٌ كَأَنَّهُمُ  الزُّطُّ ،  أَشْعَارُهُمْ وَأَجْسَادُهُمْ لَا يُجَاوِزُونَ  الْخَطَّ  ، ثُمَّ يَصِيرُونَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، حَتَّى إِذَا كَانَ مِنْ آخِرِ اللَّيْلِ جَاءَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا جَالِسٌ ، فَقَالَ: لَقَدْ آذَانِي هَؤُلَاءِ اللَّيْلَةَ ، ثُمَّ دَخَلَ عَلَيَّ فِي خَطِّي فَتَوَسَّدَ فَخِذِي فَرَقَدَ ، وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا رَقَدَ نَفَخَ النَّوْمَ نَفْخًا ، فَبَيْنَمَا أَنَا قَاعِدٌ وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُتَوَسِّدٌ         [5/272]      فَخِذِي ، إِذَا أَنَا بِرِجَالٍ كَأَنَّهُمْ  رِجَالُ الْحِجَازِ ،  عَلَيْهِمْ ثِيَابٌ بِيضٌ ، اللهُ أَعْلَمُ مَا بِهِمْ مِنَ الْجَمَالِ ، فَجَلَسَ طَائِفَةٌ مِنْهُمْ عِنْدَ رَأْسِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَطَائِفَةٌ عِنْدَ رِجْلَيْهِ ، ثُمَّ قَالُوا بَيْنَهُمْ: مَا رَأَيْنَا أَحَدًا قَطُّ أُوتِيَ مَا أُوتِيَ هَذَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِنَّ عَيْنَيْهِ نَائِمَةٌ وَقَلْبَهُ يَقْظَانُ فَاضْرِبُوا لَهُ مَثَلًا - أَحْسَبُهُ قَالَ: بِرَجُلٍ بَنَى قَصْرًا ثُمَّ جَعَلَ مَأْدُبَةً وَدَعَا النَّاسَ إِلَى طَعَامِهِ ، فَمَنْ أَجَابَهُ أَكَلَ مِنْ طَعَامِهِ وَشَرِبَ مِنْ شَرَابِهِ ، وَمَنْ لَمْ يُجِبْهُ عَاقَبَهُ أَوْ عُوقِبَ ، ثُمَّ ارْتَفَعُوا ، فَاسْتَيْقَظَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ لِي: سَمِعْتَ مَا قَالَ هَؤُلَاءِ ، وَهَلْ تَدْرِي مَنْ هُمْ ؟ ، قُلْتُ: اللهُ وَرَسُولُهُ أَعْلَمُ ، قَالَ: هُمُ الْمَلَائِكَةُ ، قَالَ: فَتَدْرِي مَا الْمَثَلُ الَّذِي ضَرَبُوهُ ؟ ، قُلْتُ: اللهُ وَرَسُولُهُ أَعْلَمُ ، قَالَ: مَثَلُ الَّذِي ضَرَبُوا الرَّبُّ تَبَارَكَ وَتَعَالَى بَنَى الْجَنَّةَ وَدَعَا إِلَيْهَا عِبَادَهُ فَمَنْ أَجَابَهُ دَخَلَ الْجَنَّةَ ، وَمَنْ لَمْ يُجِبْهُ عَاقَبَهُ أَوْ عَذَّبَهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا         [5/273]      الْوَجْهِ ، وَقَدْ رَوَاهُ  التَّيْمِيُّ  فَخَالَفَ  جَعْفَرَ بْنَ مَيْمُونٍ  فِي  إِسْنَادِهِ ،  وَقَالَ: عَنْ  عَمْرٍو الْبِكَالِيِّ ،  عَنْ  أَبِي عُثْمَانَ  .","","Musnad al-Bazzar 1886","","عبد الله بن مسعود عن أبو عثمان النهدي عن طريف بن مجالد الهجيمي عن جعفر بن ميمون الأنماطي عن محمد بن إبراهيم بن أبي عدي القسملي عن محمد بن بشار بندار عن البزار","أبو عثمان النهدي عن عبد الله"
"1899","[5/274]      قَيْسُ بْنُ أَبِي حَازِمٍ  عَنْ  عَبْدِ اللهِ  1887  -  حَدَّثَنَا  أَبُو كُرَيْبٍ ، قَالَ:  نَا  أَبُو مُعَاوِيَةَ  .  1888  -  وَحَدَّثَنَاهُ  بِشْرُ بْنُ خَالِدٍ ، قَالَ:  نَا  أَبُو أُسَامَةَ ، جَمِيعًا ذَكَرَا ذَلِكَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ يَعْنِي ابْنَ أَبِي حَازِمٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  مَا زِلْنَا أَعِزَّةً مُنْذُ أَسْلَمَ عُمَرُ  .  في طبعة مكتبة العلوم والحكم : (معاوية) والمثبت من نسخة الرباط .","","Musnad al-Bazzar 1887","","عمر بن الخطاب عن عبد الله بن مسعود عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن أبو معاوية الضرير عن أبو كريب محمد بن العلاء عن البزار","قيس بن أبي حازم عن عبد الله"
"1900","1889  -  حَدَّثَنَا  أَحْمَدُ بْنُ ثَابِتٍ الْجَحْدَرِيُّ ، وَمُحَمَّدُ بْنُ يَحْيَى الْقُطَعِيُّ ، قَالَا:  نَا  عُمَرُ بْنُ عَلِيٍّ ، قَالَ:  نَا  إِسْمَاعِيلُ ،  عَنْ  قَيْسٍ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ         [5/275]      رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِذَا أَرَادَ اللهُ قَبْضَ عَبْدٍ بِأَرْضٍ جَعَلَ لَهُ إِلَيْهَا حَاجَةً  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا  يَرْفَعُهُ  إِلَّا  عُمَرُ بْنُ عَلِيٍّ الْمُقَدَّمِيُّ  .","","Musnad al-Bazzar 1889","","عبد الله بن مسعود عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عمر بن علي بن عطاء عن محمد بن يحيى بن أبي حزم القطعي عن البزار","قيس بن أبي حازم عن عبد الله"
"1901","1890  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  يَحْيَى بْنُ سَعِيدٍ ، قَالَ:  نَا  إِسْمَاعِيلُ ،  عَنْ  قَيْسٍ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  لَا  حَسَدَ  إِلَّا فِي اثْنَتَيْنِ  : رَجُلٌ آتَاهُ اللهُ الْقُرْآنَ فَهُوَ يَقُومُ بِهِ آنَاءَ اللَّيْلِ وَآنَاءَ النَّهَارِ ، وَرَجُلٌ آتَاهُ اللهُ مَالًا وَسَلَّطَهُ عَلَى تَلَفِهِ بِالْحَقِّ  .         [5/276]             [5/277]      وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنْ غَيْرِ وَاحِدٍ ، وَلَا نَعْلَمُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ.","","Musnad al-Bazzar 1890","","عبد الله بن مسعود عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى القطان عن الفلاس عن البزار","قيس بن أبي حازم عن عبد الله"
"1902","1891  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  كُنَّا نَغْزُو مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَلَيْسَ مَعَنَا نِسَاءٌ  فَاسْتَأْذَنَهُ بَعْضُنَا أَنْ يَسْتَخْصِيَ أَوْ قَالَ: لَوْ أَذِنْتَ لَنَا لَاخْتَصَيْنَا  فَلَمْ يُرَخِّصْ لَنَا ، وَرَخَّصَ لَنَا فِي الِاسْتِمْتَاعِ بِالثَّوْبِ  .","","Musnad al-Bazzar 1891","","عبد الله بن مسعود عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى القطان عن الفلاس عن البزار","قيس بن أبي حازم عن عبد الله"
"1903","[5/278]      1892  -  حَدَّثَنَا  يَحْيَى بْنُ مُعَلَّى بْنِ مَنْصُورٍ ، قَالَ:  نَا  أَصْبَغُ بْنُ الْفَرَجِ ، قَالَ:  نَا  عَلِيُّ بْنُ عَابِسٍ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  كَانَ عَلَى  عَائِشَةَ  مُحَرَّرٌ  مِنْ وَلَدِ إِسْمَاعِيلَ فَقَدِمَ سَبْيٌ مِنْ  بَلْعَنْبَرِ  فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِنْ سَرَّكِ أَنْ تَفِيَ نَذْرَكِ فَاعْتِقِي مِنْ هَذَا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  إِسْمَاعِيلَ  إِلَّا  عَلِيُّ بْنُ عَابِسٍ  .","","Musnad al-Bazzar 1892","","عبد الله بن مسعود عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن علي بن عابس الملائي عن أصبغ بن الفرج مولى عمر بن عبد العزيز عن يحيى بن معلى عن البزار","قيس بن أبي حازم عن عبد الله"
"1904","1893  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ الْأَهْوَازِيُّ ، قَالَ:  نَا  عَبْدُ الْمَلِكِ بْنُ مَرْوَانَ ، قَالَ:  نَا  الضَّحَّاكُ بْنُ زَيْدٍ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ         [5/279]      عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  مَا لِي لَا إِيهَمُ  وَرُفْغُ  أَحَدِكُمْ بَيْنَ أُنْمُلَتِهِ وَظُفْرِهِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا  أَسْنَدَهُ  عَنْ  عَبْدِ اللهِ  إِلَّا  الضَّحَّاكُ ،  وَغَيْرُ  الضَّحَّاكِ  يَرْوِيهِ عَنْ  إِسْمَاعِيلَ  ، عَنْ  قَيْسٍ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مُرْسَلًا  .","","Musnad al-Bazzar 1893","","عبد الله بن مسعود عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن الضحاك بن زيد الأهوازي عن عبد الملك بن مروان بن قارظ الأهوازي عن أحمد بن إسحاق بن عيسى الأهوازي عن البزار","قيس بن أبي حازم عن عبد الله"
"1905","1894  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  مُحَمَّدُ بْنُ الصَّلْتِ ، قَالَ:  نَا  أَبُو شِهَابٍ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  عَبْدِ اللهِ  يَرْفَعُهُ  قَالَ:  لَا يَحِلُّ لِمُسْلِمٍ أَنْ يَهْجُرَ أَخَاهُ فَوْقَ ثَلَاثٍ  .         [5/280]      وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنْ  عَبْدِ اللهِ  مِنْ غَيْرِ وَجْهٍ.","","Musnad al-Bazzar 1894","","عبد الله بن مسعود عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عبد ربه بن نافع الحناط عن محمد بن الصلت الأصم عن عباس بن جعفر العباسي عن البزار","قيس بن أبي حازم عن عبد الله"
"1906","1895  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ ، وَعَبْدُ اللهِ بْنُ سَعِيدٍ ، قَالَا:  نَا  أَبُو أُسَامَةَ ، قَالَ:  أَنَا  إِسْمَاعِيلُ ،  عَنْ  قَيْسٍ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّهُ أَتَى  أَبَا جَهْلٍ  وَبِهِ رَمَقٌ فَقَالَ:  أَخْزَاكَ اللهُ  ، فَقَالَ: هَلْ  أَعْمَدُ  مِنْ رَجُلٍ قَتَلْتُمُوهُ  .","","Musnad al-Bazzar 1895","","عبد الله بن مسعود عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن حماد بن أسامة القرشي عن عبد الله بن سعيد الأشج عن البزار","قيس بن أبي حازم عن عبد الله"
"1907","[5/281]      عَطَاءُ بْنُ يَسَارٍ  عَنْ  عَبْدِ اللهِ  1896  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ قَالَ:  نَا  الْحَسَنُ بْنُ عَمْرٍو الْفُقَيْمِيُّ ،  عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  إِنَّهَا سَتَكُونُ أُمَرَاءُ بَعْدِي يَقُولُونَ مَا لَا يَفْعَلُونَ ،  وَيَفْعَلُونَ مَا لَا يُؤْمَرُونَ ، فَمَنْ جَاهَدَهُمْ بِيَدِهِ فَهُوَ مُؤْمِنٌ ، وَمَنْ جَاهَدَهُمْ بِلِسَانِهِ فَهُوَ مُؤْمِنٌ ، وَمَنْ جَاهَدَهُمْ بِقَلْبِهِ فَهُوَ مُؤْمِنٌ لَا إِيمَانَ بَعْدَهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ عَنْ  عَبْدِ اللهِ  إِلَّا بِهَذَا  الْإِسْنَادِ ،  وَلَا نَعْلَمُ رَوَى  عَطَاءُ بْنُ يَسَارٍ  عَنْ  عَبْدِ اللهِ  غَيْرَ هَذَا الْحَدِيثِ ، وَلَا نَعْلَمُهُ سَمِعَ مِنْهُ وَإِنْ كَانَ قَدِيمًا ، وَلَا نَعْلَمُ  أَسْنَدَ  الْحَسَنُ بْنُ عَمْرٍو ،  عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ  إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 1896","","عبد الله بن مسعود عن عطاء بن يسار الهلالي عن معاوية بن إسحاق بن طلحة التيمي عن الحسن بن عمرو الفقيمي عن عبد الرحمن بن مغراء الدوسي عن يوسف بن موسى بن راشد عن البزار","عطاء بن يسار عن عبد الله"
"1908","[5/282]      عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ  عَنْ  عَبْدِ اللهِ  1897  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ الْأَهْوَازِيُّ ، قَالَ:  نَا  أَبُو أَحْمَدَ ، قَالَ:  نَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ قَالَ:  أَقْرَأَنِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         {      إِنَّ اللهَ هُوَ الرَّزَّاقُ ذُو الْقُوَّةِ الْمَتِينُ         }      .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ رِوَايَةِ  أَبِي إِسْحَاقَ  عَنْهُ.","","Musnad al-Bazzar 1897","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن عبد الله بن الزبير عن أحمد بن إسحاق بن عيسى الأهوازي عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1909","[5/283]      1898  -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ يَزِيدَ ، قَالَ:  نَا  خَلَّادُ بْنُ يَحْيَى ، قَالَ:  نَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى  بِمِنًى  رَكْعَتَيْنِ  .  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ غَيْرُ وَاحِدٍ عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ  .","","Musnad al-Bazzar 1898","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن خلاد بن يحيى الأرحبي عن عبد الأعلى بن يزيد عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1910","1899  -  وَحَدَّثَنَا  إِسْمَاعِيلُ بْنُ يَعْقُوبَ ، قَالَ:  نَا  مُحَمَّدُ بْنُ مُوسَى بْنِ أَعْيَنَ ، قَالَ:  حَدَّثَنِي  أَبِي  ، قَالَ:  سَمِعْتُ  إِدْرِيسَ الْكُوفِيَّ يَعْنِي الْأَوْدِيَّ يَقُولُ:  حَدَّثَنِي  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَحْوَهُ.         [5/284]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  إِدْرِيسَ  إِلَّا  مُوسَى بْنُ أَعْيَنَ  .","","Musnad al-Bazzar 1899","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن إدريس بن يزيد الزعافري عن موسى بن أعين الجزري عن محمد بن موسى بن أعين الجزري عن إسماعيل بن يعقوب الصبيحي عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1911","1900  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّهُ اسْتَبْطَنَ الْوَادِيَ يَوْمَ النَّحْرِ فَرَمَى الْجَمْرَةَ جَمْرَةَ الْعَقَبَةِ ، وَقَالَ:  هَذَا مَقَامُ الَّذِي أُنْزِلَتْ عَلَيْهِ سُورَةُ الْبَقَرَةِ  .","","Musnad al-Bazzar 1900","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن الفلاس عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1912","[5/285]      1901  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدَةَ ، وَعَمْرُو بْنُ يَحْيَى بْنِ غُفْرَةَ الْبَجَلِيُّ ، وَاللَّفْظُ  لِأَحْمَدَ ،  قَالَا:  أَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَبَانَ بْنِ تَغْلِبَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ قَالَ:  كَانَتْ تَلْبِيَةُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  لَبَّيْكَ  اللَّهُمَّ  لَبَّيْكَ ،  لَبَّيْكَ  لَا شَرِيكَ لَكَ  لَبَّيْكَ  ، إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ وَالْمُلْكَ ، لَا شَرِيكَ لَكَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  أَبِي إِسْحَاقَ  إِلَّا مِنْ حَدِيثِ  أَبَانَ بْنِ تَغْلِبَ  .","","Musnad al-Bazzar 1901","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن أبان بن تغلب بن رياح عن حماد بن زيد عن عمرو بن يحيى بن غفرة البجلي عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1913","1902  -  حَدَّثَنَا  الْحَسَنُ بْنُ مُحَمَّدِ بْنِ الصَّبَّاحِ ، قَالَ:  نَا  ابْنُ أَبِي عَدِيٍّ ،         [5/286]      قَالَ:  نَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ، وَمَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ .","","Musnad al-Bazzar 1902","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم النخعي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن محمد بن إبراهيم بن أبي عدي القسملي عن الحسن بن محمد الزعفراني عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1914","1903  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّهُ رَمَى الْجَمْرَةَ بِسَبْعِ حَصَيَاتٍ ، فَجَعَلَ  الْبَيْتَ  عَنْ يَسَارِهِ ،  وَمِنًى  عَنْ يَمِينِهِ ، وَقَالَ:  هَذَا مَقَامُ الَّذِي أُنْزِلَتْ عَلَيْهِ سُورَةُ الْبَقَرَةِ  .","","Musnad al-Bazzar 1903","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم النخعي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1915","[5/287]      1904  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  أَنَّهُ صَلَّى  بِمِنًى  رَكْعَتَيْنِ  .","","Musnad al-Bazzar 1904","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن الفلاس عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1916","1905  -  حَدَّثَنَاهُ  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ:  نَا  رَوْحُ بْنُ عُبَادَةَ ، قَالَ:  نَا  شُعْبَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  أَنَّهُ صَلَّى  بِمِنًى  رَكْعَتَيْنِ  .","","Musnad al-Bazzar 1905","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن شعبة بن الحجاج عن روح بن عبادة القيسي عن محمد بن معمر بن ربعي البحراني عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1917","1906  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ:  نَا  قَبِيصَةُ بْنُ عُقْبَةَ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ         [5/288]      عَبْدِ اللهِ قَالَ:  مَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى صَلَاةً لِغَيْرِ مِيقَاتِهَا  إِلَّا أَنَّهُ جَمَعَ بَيْنَ الصَّلَاتَيْنِ  بِجَمْعٍ ،  وَصَلَّى الْفَجْرَ يَوْمَئِذٍ بِغَيْرِ مِيقَاتِهَا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِهَذَا اللَّفْظِ إِلَّا  عَبْدُ اللهِ بْنُ مَسْعُودٍ  مِنْ رِوَايَةِ  عُمَارَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ  .         [5/289]      وَمَعْنَى قَوْلِهِ: أَنَّهُ صَلَّى الْفَجْرَ لِغَيْرِ مِيقَاتِهَا ، أَنَّهُ صَلَّاهَا فِي غَيْرِ وَقْتِهَا الَّذِي كَانَ يُصَلِّيهَا فِي كُلِّ يَوْمٍ ، لِأَنَّهُ كَانَ يُصَلِّي فِي كُلِّ يَوْمٍ إِذَا  أَسْفَرَ  الْفَجْرُ وَصَلَّى فِي ذَلِكَ الْيَوْمِ حَيْثُ بَرَقَ الْفَجْرُ فَكَانَ قَبْلَ مِيقَاتِهَا الَّذِي كَانَ يُصَلِّيهَا فِي كُلِّ يَوْمٍ لَا أَنَّهُ صَلَّاهَا قَبْلَ أَنْ يَجِبَ وَقْتُهَا.","","Musnad al-Bazzar 1906","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن سفيان الثوري عن قبيصة بن عقبة السوائي عن محمد بن معمر بن ربعي البحراني عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1918","1907  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ قَالَ:  مَا رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى صَلَاةً إِلَّا لِوَقْتِهَا  إِلَّا أَنَّهُ جَمَعَ بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ  بِالْمُزْدَلِفَةِ  ، وَصَلَّى صَلَاةَ الْغَدَاةِ فِي غَيْرِ وَقْتِهَا .","","Musnad al-Bazzar 1907","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن أبو معاوية الضرير عن الفلاس عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1919","1908  -  وَحَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ:  نَا  يَحْيَى بْنُ آدَمَ ، قَالَ:  نَا         [5/290]      قَيْسٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  إِنَّ قِصَرَ الْخُطْبَةِ ، وَطُولَ الصَّلَاةِ  مَئِنَّةٌ  مِنْ فِقْهِ الرَّجُلِ ،  فَأَطِيلُوا الصَّلَاةَ ، وَاقْصُرُوا الْخُطَبَ ، وَإِنَّ مِنَ  الْبَيَانِ  لَسِحْرًا ،  وَإِنَّهُ سَيَأْتِي بَعْدَكُمْ قَوْمٌ يُطِيلُونَ الْخُطَبَ وَيَقْصُرُونَ الصَّلَاةَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ  إِلَّا  يَحْيَى بْنُ آدَمَ ،  عَنْ  قَيْسٍ  .","","Musnad al-Bazzar 1908","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن قيس بن الربيع الأسدي عن يحيى بن آدم عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1920","1909  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ هِشَامٍ ، قَالَ:  نَا  الْحَسَنُ بْنُ بِشْرِ بْنِ سَلْمٍ ، قَالَ:  نَا  قَيْسٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مَالِكِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بِنَحْوِهِ.  وَلَا نَعْلَمُ رَوَى حَدِيثَ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  وَلَا حَدِيثَ  الْأَعْمَشِ ،  عَنْ  مَالِكِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ  إِلَّا  قَيْسٌ  .","","Musnad al-Bazzar 1909","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن مالك بن الحارث السلمي عن الأعمش عن قيس بن الربيع الأسدي عن الحسن بن بشر الكاهلي عن محمد بن هشام بن شبيب السدوسي عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1921","1910  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مَالِكِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  لَا أَحَدٌ أَغْيَرَ مِنَ اللهِ ، وَلِذَلِكَ حَرَّمَ الْفَوَاحِشَ  مَا ظَهَرَ مِنْهَا وَمَا بَطَنَ ، وَلَا أَحَدَ أَحَبُّ إِلَيْهِ الْمَدْحُ مِنَ اللهِ  .         [5/291]      وَلَا نَعْلَمُ رَوَى  مَالِكُ بْنُ الْحَارِثِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ  إِلَّا هَذَيْنِ الْحَدِيثَيْنِ  .","","Musnad al-Bazzar 1910","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن مالك بن الحارث السلمي عن الأعمش عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1922","1911  -  حَدَّثَنَا  بِشْرُ بْنُ آدَمَ ، قَالَ:  نَا  الْحُسَيْنُ بْنُ عَلِيٍّ الْجُعْفِيُّ ، قَالَ:  نَا  زَائِدَةُ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا أَصْبَحَ قَالَ: أَصْبَحْنَا عَلَى  فِطْرَةِ  الْإِسْلَامِ ،  وَكَلِمَةِ الْإِخْلَاصِ ، وَمِلَّةِ أَبِينَا إِبْرَاهِيمَ مُخْلِصِينَ لَهُ الدِّينَ ، وَإِذَا أَمْسَى قَالَ مِثْلَ ذَلِكَ  .         [5/292]      وَقَالَ  الْحَسَنُ بْنُ عُبَيْدِ اللهِ :  وَحَدَّثَنِي  زُبَيْدٌ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ.","","Musnad al-Bazzar 1911","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم النخعي عن الحسن بن عبيد الله النخعي عن زائدة بن قدامة عن الحسين بن علي الجعفي عن بشر بن آدم بن يزيد عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1923","1912  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَزِيدَ بْنِ الرَّوَّاسِ ، قَالَ:  نَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ قَالَ:  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِذْنُكَ عَلَيَّ أَنْ تَرْفَعَ الْحِجَابَ ، وَأَنْ تَرَى  سِوَادِي  حَتَّى أَنْهَاكَ  .         [5/293]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا بِهَذَا  الْإِسْنَادِ ،  وَهُوَ  إِبْرَاهِيمُ بْنُ سُوَيْدٍ  ، وَلَيْسَ  بِالنَّخَعِيِّ  .  وَحَدَّثَ  إِبْرَاهِيمُ النَّخَعِيُّ  ،  وَإِبْرَاهِيمُ بْنُ سُوَيْدٍ  جَمِيعًا ، عَنْ         [5/294]      عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  وَأَمَّا مَا رَوَاهُ  مَنْصُورُ ،  وَالْحَكَمُ ،  وَالْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  فَهُوَ  إِبْرَاهِيمُ النَّخَعِيُّ ،  وَأَمَّا مَا رَوَاهُ  الْحَسَنُ بْنُ عُبَيْدِ اللهِ ،  فَهُوَ  إِبْرَاهِيمُ بْنُ سُوَيْدٍ  .","","Musnad al-Bazzar 1912","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم النخعي عن الحسن بن عبيد الله النخعي عن عبد الله بن إدريس الأودي عن محمد بن يزيد بن الرواس عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1924","1913  -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ وَاصِلٍ الْكُوفِيُّ ، قَالَ:  نَا  يَحْيَى بْنُ آدَمَ ، قَالَ:  نَا  سُفْيَانُ ،  عَنْ  حَكِيمِ بْنِ جُبَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  مَنْ سَأَلَ وَلَهُ مَا يُغْنِيهِ جَاءَ يَوْمَ الْقِيَامَةِ وَفِي وَجْهِهِ  خُدُوشٌ  ، أَوْ  كُدُوحٌ  ،  قِيلَ: يَا رَسُولَ اللهِ ، وَمَا غِنَاهُ ؟ قَالَ: خَمْسُونَ دِرْهَمًا أَوْ عِدْلُهَا مِنَ الذَّهَبِ  .         [5/295]      قَالَ  يَحْيَى بْنُ آدَمَ  : فَعَلِمْتُ  أَنَّ  شُعْبَةَ لَا يَرْضَى  حَكِيمَ بْنَ جُبَيْرٍ ،  فَقُلْتُ لَهُ:  حَدَّثَنِيهِ  سُفْيَانُ ،  عَنْ  زُبَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  أَبِيهِ  هَكَذَا ،  وَلَمْ يَقُلْ عَنْ  عَبْدِ اللهِ ،         [5/296]      وَحَكِيمُ بْنُ جُبَيْرٍ  هَذَا رَجُلٌ مِنْ  أَهْلِ الْكُوفَةِ  ضَعِيفُ الْحَدِيثِ ،  وَزُبَيْدٌ  فَلَمْ يُسْنِدْ  هَذَا الْحَدِيثَ عَنْ  عَبْدِ اللهِ  .","","Musnad al-Bazzar 1913","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن محمد بن عبد الرحمن بن يزيد النخعي عن حكيم بن جبير الأسدي عن سفيان الثوري عن يحيى بن آدم عن عبد الأعلى بن واصل الأسدي عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1925","1914  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ ، قَالَ:  نَا  الْحَسَنُ بْنُ عَمْرٍو ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  لَيْسَ الْمُؤْمِنُ  بِالطَّعَّانِ  ، وَلَا اللَّعَّانِ ،  وَلَا الْفَاحِشِ وَلَا الْبَذِيءِ  .         [5/297]      وَهَذَا الْحَدِيثُ رَوَاهُ عَنِ  الْحَسَنِ بْنِ عَمْرٍو  بِهَذَا  الْإِسْنَادِ  أَبُو بَكْرِ بْنُ عَيَّاشٍ  ،  وَعَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ  .","","Musnad al-Bazzar 1914","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن محمد بن عبد الرحمن بن يزيد النخعي عن الحسن بن عمرو الفقيمي عن عبد الرحمن بن مغراء الدوسي عن يوسف بن موسى بن راشد عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1926","1915  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ أَبِي الْحَارِثِ ، قَالَ:  نَا  زَكَرِيَّا بْنُ عَدِيٍّ ، قَالَ:  نَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ أَنَّهُ حَدَّثَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا ، فَقَالَ هَذَا ، أَوْ نَحْوَهُ.  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ  إِلَّا  حَفْصُ بْنُ غِيَاثٍ  .","","Musnad al-Bazzar 1915","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن حفص بن غياث النخعي عن زكريا بن عدي بن رزيق عن إسماعيل بن أسد بن شاهين البغدادي عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1927","1916  -  حَدَّثَنَا  سَعِيدُ بْنُ بَحْرٍ الْقَرَاطِيسِيُّ ، قَالَ:  نَا  الْحُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فِي  التَّشَهُّدِ  :  التَّحِيَّاتُ  لِلهِ ، الصَّلَوَاتُ  وَالطَّيِّبَاتُ  ،  السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ  وَذَكَرَ الْحَدِيثَ فِي  التَّشَهُّدِ  بِطُولِهِ.  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ  بِهَذَا  الْإِسْنَادِ  إِلَّا  زَائِدَةُ  .","","Musnad al-Bazzar 1916","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن زائدة بن قدامة عن الحسين بن علي الجعفي عن سعيد بن بحر القراطيسي عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1928","1917  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ         [5/298]      عُمَارَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّهُ دَخَلَ عَلَيْهِ  الْأَشْعَثُ بْنُ قَيْسٍ  فِي يَوْمِ عَاشُورَاءَ وَهُوَ يَتَغَدَّى ، فَقَالَ: ادْنُ إِلَى الْغَدَاءِ ، فَقَالَ: أَلَيْسَ الْيَوْمُ يَوْمَ عَاشُورَاءَ ؟ فَقَالَ: هَلْ تَدْرِي مَا يَوْمُ عَاشُورَاءَ ؟ إِنَّمَا يَوْمُ عَاشُورَاءَ يَوْمٌ  كَانَ يَصُومُهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَبْلَ أَنْ يَنْزِلَ رَمَضَانُ فَلَمَّا نَزَلَ رَمَضَانُ تُرِكَ  .","","Musnad al-Bazzar 1917","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن أبو معاوية الضرير عن أبو موسى الزمن عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1929","1918  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الْمَسْرُوقِيُّ ، قَالَ:  نَا  أَبُو الْمُحَيَّاةِ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ قَالَ:  قُلْتُ  لِعَبْدِ اللهِ  أَوْ قِيلَ  لِعَبْدِ اللهِ  : إِنَّ أُنَاسًا يَرْمُونَ الْجَمْرَةَ مِنْ فَوْقِ  الْعَقَبَةِ ،  قَالَ: فَرَمَى         [5/299]      عَبْدُ اللهِ مِنْ  بَطْنِ الْوَادِي ،  وَقَالَ :  هَكَذَا وَالَّذِي لَا إِلَهَ غَيْرُهُ رَمَاهَا الَّذِي أُنْزِلَتْ عَلَيْهِ سُورَةُ الْبَقَرَةِ  .","","Musnad al-Bazzar 1918","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن سلمة بن كهيل الحضرمي عن يحيى بن يعلى بن حرملة التيمي عن علي بن سعيد بن مسروق الكندي عن البزار","عبد الرحمن بن يزيد عن عبد الله"
"1930","[5/300]      الْمَعْرُورُ بْنُ سُوَيْدٍ  عَنْ  عَبْدِ اللهِ  1919  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  جَعْفَرُ بْنُ عَوْنٍ ، قَالَ:  نَا  مِسْعَرٌ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنِ  الْمُغِيرَةِ بْنِ عَبْدِ اللهِ الْيَشْكُرِيِّ ،  عَنِ  الْمَعْرُورِ بْنِ سُوَيْدٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  قَالَتْ  أُمُّ حَبِيبَةَ  : اللَّهُمَّ بَارِكْ لِي فِي زَوْجِي رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَفِي أَبِي  أَبِي سُفْيَانَ ،  وَفِي أَخِي  مُعَاوِيَةَ ،  فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  لَقَدْ سَأَلْتِ اللهَ لِآجَالٍ مَضْرُوبَةٍ ، وَأَرْزَاقٍ مَقْسُومَةٍ ،  لَا يُعَجَّلُ مِنْهَا شَيْءٌ قَبْلَ أَجَلِهِ ، فَلَوْ سَأَلْتِ اللهَ عَزَّ وَجَلَّ أَنْ  يُعَافِيَكِ ، أَوْ يُعِيذَكِ  مِنْ عَذَابٍ فِي النَّارِ وَعَذَابٍ فِي الْقَبْرِ كَانَ  خَيْرًا ، أَوْ أَفْضَلَ  قَالَ: وَذُكِرَتِ الْقِرَدَةُ وَالْخَنَازِيرُ ، فَقُلْتُ: أَكَانَ مِمَّا مُسِخَ مِنْ  بَنِي إِسْرَائِيلَ  ؟ قَالَ: إِنَّ اللهَ تَبَارَكَ وَتَعَالَى لَمْ يُهْلِكْ قَوْمًا فَتَرَكَ لَهُمْ  نَسْلًا أَوْ عَاقِبَةً ،  وَقَدْ كَانَتِ الْقِرَدَةُ وَالْخَنَازِيرُ  أُرَاهُ قَبْلَ ذَلِكَ  .         [5/301]      وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى ، عَنْ  عَبْدِ اللهِ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1919","","عبد الله بن مسعود عن معرور بن سويد الأسدي عن المغيرة بن عبد الله بن أبي عقيل اليشكري عن علقمة بن مرثد الحضرمي عن مسعر بن كدام عن جعفر بن عون المخزومي عن يوسف بن موسى بن راشد عن البزار","المعرور بن سويد عن عبد الله"
"1931","[5/302]      صِلَةُ بْنُ زُفَرَ  عَنْ  عَبْدِ اللهِ  1920  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ:  نَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  صِلَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  أَنَّ  الْعَاقِبَ ،  وَالسَّيِّدَ  أَتَيَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَرَادَ أَنْ يُلَاعِنَهُمَا ، فَقَالَ أَحَدُهُمَا لِصَاحِبِهِ: لَا نُلَاعِنُهُ ، فَلَئِنْ كَانَ نَبِيًّا فَلَاعَنَّا لَا نُفْلِحُ نَحْنُ وَلَا عَقِبُنَا مِنْ بَعْدِنَا ، قَالُوا لَهُ: نُعْطِيكَ مَا سَأَلْتَ ، فَابْعَثْ مَعَنَا رَجُلًا أَمِينًا وَلَا تَبْعَثْ مَعَنَا إِلَّا أَمِينًا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  لَأَبْعَثَنَّ مَعَكُمْ رَجُلًا أَمِينًا  حَقَّ  أَمِينٍ  ، قَالَ: قُمْ يَا  أَبَا عُبَيْدَةَ بْنَ الْجَرَّاحِ  ، فَلَمَّا قَامَ قَالَ: هَذَا أَمِينُ هَذِهِ الْأُمَّةِ  .         [5/303]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1920","","عبد الله بن مسعود عن صلة بن زفر العبسي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن يوسف بن موسى بن راشد عن البزار","صلة بن زفر عن عبد الله"
"1932","[5/304]      خِشْفُ بْنُ مَالِكٍ  عَنْ  عَبْدِ اللهِ  1921  -  حَدَّثَنَا  أَبُو كُرَيْبٍ ، وَعَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَا:  نَا  مُعَاوِيَةُ بْنُ هِشَامٍ ، قَالَ:  نَا  سُفْيَانُ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  خِشْفِ بْنِ مَالِكٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  شَكَوْنَا  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ شِدَّةَ الرَّمْضَاءِ فَلَمْ يُشْكِنَا  .         [5/305]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ بِهَذَا  الْإِسْنَادِ  إِلَّا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  سُفْيَانَ  .  كذا في طبعة مكتبة العلوم والحكم ونسخة الرباط ، وكشف الأستار ، ويدل عليه تبويب المصنف ، والذي عند ابن ماجه : (زيد بن جبير عن خشف بن مالك عن أبيه عن عبد الله) وفي هذا الإسناد اختلافات أخرى ولعل ذلك من جملتها ، والله أعلم .","","Musnad al-Bazzar 1921","","عبد الله بن مسعود عن مالك الطائي عن خشف بن مالك الطائي عن زيد بن جبير الطائي عن سفيان الثوري عن معاوية بن هشام القصار عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","خشف بن مالك عن عبد الله"
"1933","1922  -  حَدَّثَنَا  طَلِيقُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ، قَالَ:  نَا  أَبُو مُعَاوِيَةَ ، قَالَ:  نَا  الْحَجَّاجُ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ ،  عَنْ  خِشْفِ بْنِ مَالِكٍ ،  عَنْ  عَبْدِ اللهِ  رَفَعَهُ  أَنَّهُ جَعَلَ فِي دِيَةِ  الْخَطَإِ  أَخْمَاسًا  .         [5/306]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  مَرْفُوعًا  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1922","","عبد الله بن مسعود عن خشف بن مالك الطائي عن زيد بن جبير الطائي عن حجاج بن أرطاة عن أبو معاوية الضرير عن طليق بن محمد بن السكن الواسطي عن البزار","خشف بن مالك عن عبد الله"
"1934","[5/307]      زَاذَانُ  عَنْ  عَبْدِ اللهِ  1923  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ السَّائِبِ ،  عَنْ  زَاذَانَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ.","","Musnad al-Bazzar 1923","","عبد الله بن مسعود عن زاذان الكندي عن عبد الله بن السائب الكندي عن سفيان الثوري عن يحيى القطان عن الفلاس عن البزار","زاذان عن عبد الله"
"1935","1924  -  وَحَدَّثَنَاهُ  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  جَرِيرٌ ،  عَنْ  حُسَيْنٍ الْخُلْقَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ السَّائِبِ ،  عَنْ  زَاذَانَ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِنَّ لِلهِ مَلَائِكَةً سَيَّاحِينَ يُبَلِّغُونِي عَنْ أُمَّتِي السَّلَامَ  . قَالَ  حُسَيْنٌ  فِي حَدِيثِهِ:  إِنَّ لِلهِ مَلَائِكَةً يَطُوفُونَ فِي         [5/308]      الطُّرُقِ يُبَلِّغُونَ عَنْ أُمَّتِي السَّلَامَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1924","","عبد الله بن مسعود عن زاذان الكندي عن عبد الله بن السائب الكندي عن حسين الخلقاني عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","زاذان عن عبد الله"
"1936","1925  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  عَبْدُ الْمَجِيدِ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ السَّائِبِ ،  عَنْ  زَاذَانَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  إِنَّ لِلهِ مَلَائِكَةً سَيَّاحِينَ يُبَلِّغُونِي عَنْ أُمَّتِي السَّلَامَ  .  قَالَ: وَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  حَيَاتِي خَيْرٌ لَكُمْ تُحَدِّثُونَ وَنُحَدِّثُ لَكُمْ ،  وَوَفَاتِي خَيْرٌ لَكُمْ تُعْرَضُ عَلَيَّ أَعْمَالُكُمْ ،         [5/309]      فَمَا رَأَيْتُ مِنْ خَيْرٍ حَمِدْتُ اللهَ عَلَيْهِ ، وَمَا رَأَيْتُ مِنْ شَرٍّ اسْتَغْفَرْتُ اللهَ لَكُمْ  .  وَهَذَا الْحَدِيثُ آخِرُهُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1925","","عبد الله بن مسعود عن زاذان الكندي عن عبد الله بن السائب الكندي عن سفيان الثوري عن عبد المجيد بن عبد العزيز بن أبي رواد عن يوسف بن موسى بن راشد عن البزار","زاذان عن عبد الله"
"1937","[5/310]      عَبْدُ اللهِ بْنُ مَعْقِلِ بْنِ مُقَرِّنٍ  عَنْ  عَبْدِ اللهِ  1926  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدَةَ ، قَالَ:  نَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَبْدِ الْكَرِيمِ بْنِ الْجَزَرِيِّ ،  عَنْ  زِيَادِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَعْقِلٍ  قَالَ:  دَخَلْتُ أَنَا وَأَبِي عَلَى عَبْدِ اللهِ ، فَقَالَ لَهُ أَبِي: يَا  أَبَا عَبْدِ الرَّحْمَنِ ،  أَسَمِعْتَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ:  النَّدَمُ تَوْبَةٌ  ؟ ،  قَالَ  : نَعَمْ  .         [5/311]             [5/312]      وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ غَيْرُ وَاحِدٍ عَنْ  عَبْدِ الْكَرِيمِ  ، وَلَا نَعْلَمُ رَوَى  عَبْدُ اللهِ بْنُ مَعْقِلٍ  إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 1926","","عبد الله بن مسعود عن عبد الله بن معقل بن مقرن المزني عن زياد بن أبي مريم الجزري عن عبد الكريم الاصطخري عن سفيان بن عيينة عن أحمد بن عبدة الضبي عن البزار","عبد الله بن معقل بن مقرن عن عبد الله"
"1938","1927  -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ، قَالَ:  نَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَعْقِلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  النَّدَمُ تَوْبَةٌ  .  وَهَذَا الْحَدِيثُ لَمْ نَسْمَعْهُ إِلَّا مِنْ  عَبْدِ الْوَاحِدِ ،  عَنْ  أَبِي عَوَانَةَ  .","","Musnad al-Bazzar 1927","","عبد الله بن مسعود عن عبد الله بن معقل بن مقرن المزني عن الأعمش عن الوضاح بن عبد الله اليشكري عن عبد الواحد بن غياث عن البزار","عبد الله بن معقل بن مقرن عن عبد الله"
"1939","[5/313]      أَبُو فَاخِتَةَ  عَنْ  عَبْدِ اللهِ  1928  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ مَسْعُودٍ قَالَ:  أَوَّلُ مَنْ نَقَصَ التَّكْبِيرَ  الْوَلِيدُ بْنُ عُقْبَةَ ،  فَقَالَ  عَبْدُ اللهِ  : نَقَصُوهَا نَقَصَهُمُ اللهُ ،  لَقَدْ رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُكَبِّرُ كُلَّمَا رَكَعَ ،  وَكُلَّمَا سَجَدَ ، وَكُلَّمَا رَفَعَ  .","","Musnad al-Bazzar 1928","","عبد الله بن مسعود عن سعيد بن علاقة الهاشمي عن ثوير بن أبي فاختة مولى أم هانئ عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن يوسف بن موسى بن راشد عن البزار","أبو فاختة عن عبد الله"
"1940","1929  -  حَدَّثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ ، قَالَ:  حَدَّثَنِي  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ .","","Musnad al-Bazzar 1929","","عبد الله بن مسعود عن سعيد بن علاقة الهاشمي عن ثوير بن أبي فاختة مولى أم هانئ عن الأعمش عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن البزار","أبو فاختة عن عبد الله"
"1941","1930  -  وَحَدَّثَنَاهُ  إِبْرَاهِيمُ بْنُ سَعِيدٍ ، فَقَالَ:  نَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ         [5/314]      الْأَعْمَشِ ،  عَنْ  ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ قَالَ:  أَخَذْتُ مِنْ فِي رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَبْعِينَ سُورَةً  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الْأَعْمَشِ ،  عَنْ  ثُوَيْرٍ  إِلَّا  يَحْيَى بْنُ سَعِيدٍ الْأُمَوِيُّ  .","","Musnad al-Bazzar 1930","","عبد الله بن مسعود عن سعيد بن علاقة الهاشمي عن ثوير بن أبي فاختة مولى أم هانئ عن الأعمش عن يحيى بن سعيد بن أبان عن إبراهيم بن سعيد الجوهري عن البزار","أبو فاختة عن عبد الله"
"1942","[5/315]      هَمَّامُ بْنُ الْحَارِثِ  عَنْ  عَبْدِ اللهِ  1931  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  مَنْ أَتَى  كَاهِنًا  أَوْ سَاحِرًا فَصَدَّقَهُ بِمَا يَقُولُ فَقَدْ كَفَرَ  بِمَا أُنْزِلَ عَلَى  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad al-Bazzar 1931","","عبد الله بن مسعود عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن أبو موسى الزمن عن البزار","همام بن الحارث عن عبد الله"
"1943","1932  -  حَدَّثَنَا  مُحَمَّدُ بْنُ سَعِيدِ بْنِ يَزِيدَ بْنِ إِبْرَاهِيمَ التُّسْتَرِيُّ ، قَالَ:  نَا  أَبُو زَيْدٍ سَعِيدُ بْنُ الرَّبِيعِ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  مِسْعَرٍ ، وَالْمَسْعُودِيِّ ،  عَنْ  وَبَرَةَ ،  عَنْ  هَمَّامٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  إِنَّ مِنَ السُّنَّةِ الْغُسْلَ يَوْمَ الْجُمُعَةِ  .  وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنِ  الْمَسْعُودِيِّ ،  وَعَنْ  مِسْعَرٍ  مِنْ وُجُوهٍ وَلَكِنْ ذَكَرْنَاهُ مِنْ حَدِيثِ  شُعْبَةَ  .","","Musnad al-Bazzar 1932","","عبد الله بن مسعود عن همام بن الحارث بن قيس النخعي عن وبرة بن عبد الرحمن المسلي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن شعبة بن الحجاج عن سعيد بن الربيع الحرشي عن محمد بن سعيد بن يزيد التستري عن البزار","همام بن الحارث عن عبد الله"
"1944","1933  -  حَدَّثَنَا  أَحْمَدُ بْنُ سِنَانٍ ، وَمُحَمَّدُ بْنُ عُثْمَانَ بْنِ مَخْلَدٍ ، قَالَا:  نَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ :  أَنَا  شَرِيكٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ         [5/316]      عُمَيْرٍ ،  عَنِ  الْأَسْوَدِ ، وَهَمَّامِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ:  دَخَلْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُحَمُّ فَوَضَعْتُ يَدِي عَلَيْهِ فَقُلْتُ: يَا رَسُولِ اللهِ ، مَا أَشَدَّ حُمَّاكَ ، وَإِنَّكَ لَتُوعَكُ وَعْكًا شَدِيدًا ، فَقَالَ:  أَجَلْ إِنِّي أُوعَكُ كَمَا يُوعَكُ رَجُلَانِ مِنْكُمْ ،  إِنَّهُ لَيْسَ مِنْ عَبْدٍ مُؤْمِنٍ وَلَا أَمَةٍ مُؤْمِنَةٍ يَمْرَضُ مَرَضًا إِلَّا حَطَّ اللهُ عَنْهُ كَمَا  يُحَتُّ أَوْ تُحَتُّ  عَنِ الشَّجَرَةِ وَرَقُهَا  .  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ غَيْرُ  شَرِيكٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَبْدِ اللهِ  وَزَادَ  شَرِيكٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ ،  عَنِ  الْأَسْوَدِ ،  وَهَمَّامٍ  .","","Musnad al-Bazzar 1933","","عبد الله بن مسعود عن همام بن الحارث بن قيس النخعي عن عمارة بن عمير التيمي عن الأعمش عن شريك بن عبد الله النخعي عن يزيد بن هارون عن محمد بن عثمان بن مخلد الواسطي عن البزار","همام بن الحارث عن عبد الله"
"1945","[5/317]      إِبْرَاهِيمُ  عَنْ  مَسْرُوقٍ  مَسْرُوقٌ  عَنْ  عَبْدِ اللهِ  إِبْرَاهِيمُ  عَنْ  مَسْرُوقٍ  1934  -  حَدَّثَنَا  بِشْرُ بْنُ خَالِدٍ الْعَسْكَرِيُّ ، قَالَ:  أَنَا  إِسْحَاقُ بْنُ يُوسُفَ ، قَالَ:  نَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  زُبَيْدٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  لَيْسَ مِنَّا مَنْ ضَرَبَ الْوُجُوهَ ، وَشَقَّ الْجُيُوبَ ،  وَدَعَا بِدَعْوَى جَاهِلِيَّةِ  .         [5/318]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  إِبْرَاهِيمَ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ  إِلَّا  زُبَيْدٌ  .","","Musnad al-Bazzar 1934","","عبد الله بن مسعود عن مسروق بن الأجدع عن إبراهيم النخعي عن زبيد بن الحارث اليامي عن سفيان الثوري عن إسحاق بن يوسف الأزرق عن بشر بن خالد الفرائضي عن البزار","مسروق عن عبد الله"
"1946","1935  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  ابْنُ أَبِي عَدِيٍّ ،  عَنْ  شُعْبَةَ ،  عَنْ  زُبَيْدٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  الرِّبَا  بِضْعٌ  وَسَبْعُونَ بَابًا  وَالشِّرْكُ  مِثْلُ ذَلِكَ  .  وَهَذَا الْحَدِيثُ لَمْ نَسْمَعْ أَحَدًا  أَسْنَدَهُ  بِهَذَا  الْإِسْنَادِ  إِلَّا  عَمْرُو بْنُ عَلِيٍّ  .","","Musnad al-Bazzar 1935","","عبد الله بن مسعود عن مسروق بن الأجدع عن إبراهيم النخعي عن زبيد بن الحارث اليامي عن شعبة بن الحجاج عن محمد بن إبراهيم بن أبي عدي القسملي عن الفلاس عن البزار","مسروق عن عبد الله"
"1947","1936  -  حَدَّثَنَا  الْفَضْلُ بْنُ يَعْقُوبَ الرُّخَامِيُّ ، قَالَ:  نَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  عَمْرِو بْنِ         [5/319]      مُرَّةَ ،  عَنْ  إِبْرَاهِيمَ النَّخَعِيِّ ، قَالَ:  كَانَ  مَسْرُوقُ بْنُ الْأَجْدَعِ  جَالِسًا عِنْدَ  الضَّحَّاكِ بْنِ قَيْسٍ  وَعِنْدَهُ  عُمَارَةُ بْنُ عُقْبَةَ بْنِ أَبِي مُعَيْطٍ  ، فَأَرَادَ  الضَّحَّاكُ  أَنْ يَسْتَعْمِلَ  مَسْرُوقًا  عَلَى شَيْءٍ مِنْ أَعْمَالِهِ ، فَقَالَ لَهُ  عُمَارَةُ بْنُ عُقْبَةَ  : تَسْتَعْمِلُ رَجُلًا مِنْ بَقَايَا قَتَلَةِ  عُثْمَانَ  ؟  فَقَالَ  مَسْرُوقٌ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مَسْعُودٍ ، وَكَانَ عِنْدَنَا مَوْثُوقَ الْحَدِيثِ غَيْرَ كَذُوبٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمَّا أُتِيَ بِأَبِيكَ أَمَرَ بِضَرْبِ عُنُقِهِ ،  قَالَ: فَمَنْ لِلصِّبْيَةِ بَعْدِي ؟ قَالَ: النَّارُ فَحَسْبُكَ بِمَا أَمَرَ لَكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1936","","عبد الله بن مسعود عن مسروق بن الأجدع عن إبراهيم النخعي عن عمرو بن مرة المرادي عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن عبد الله بن جعفر بن غيلان عن الفضل بن يعقوب الرخامي عن البزار","مسروق عن عبد الله"
"1948","[5/320]      الشَّعْبِيُّ  عَنْ  مَسْرُوقٍ  عَنْ  عَبْدِ اللهِ  1937  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدَةَ ، قَالَ:  أَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  يَكُونُ بَعْدِي اثْنَا عَشَرَ  خَلِيفَةً  ،  أَحْسَبُهُ قَالَ: عِدَّةَ نُقَبَاءِ  بَنِي إِسْرَائِيلَ  .","","Musnad al-Bazzar 1937","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن حماد بن زيد عن أحمد بن عبدة الضبي عن البزار","الشعبي عن مسروق عن عبد الله"
"1949","1938  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ، وَبِشْرُ بْنُ خَالِدٍ الْعَسْكَرِيُّ ، قَالَا:  نَا  أَبُو أُسَامَةَ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بِنَحْوِهِ.         [5/321]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ لَهُ  إِسْنَادًا ،  عَنْ  عَبْدِ اللهِ  أَحْسَنَ مِنْ هَذَا  الْإِسْنَادِ ،  عَلَى أَنَّ  مُجَالِدًا  قَدْ تَكَلَّمَ فِيهِ أَهْلُ الْعِلْمِ  .","","Musnad al-Bazzar 1938","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن حماد بن أسامة القرشي عن بشر بن خالد الفرائضي عن البزار","الشعبي عن مسروق عن عبد الله"
"1950","1939  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي صَفْوَانَ الثَّقَفِيُّ ، قَالَ:  نَا  يَحْيَى بْنُ سَعِيدٍ ، قَالَ:  نَا  مُجَالِدٌ ،  عَنْ  عَامِرٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ  يَرْفَعُهُ  قَالَ:  يُؤْتَى بِالْقَاضِي يَوْمَ الْقِيَامَةِ فَيُوقَفُ عَلَى  شَفِيرِ  جَهَنَّمَ ،  فَإِنْ أُمِرَ بِهِ وَدُفِعَ فَهَوَى فِيهَا سَبْعِينَ  خَرِيفًا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ  أَسْنَدَهُ ،  عَنْ  مُجَالِدٍ  إِلَّا  يَحْيَى بْنُ سَعِيدٍ .","","Musnad al-Bazzar 1939","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن يحيى القطان عن محمد بن عثمان بن أبي صفوان الثقفي عن البزار","الشعبي عن مسروق عن عبد الله"
"1951","قَالَ :  وَسَمِعْتُ  عَمْرَو بْنَ عَلِيٍّ يَذْكُرُ هَذَا الْحَدِيثَ ،  عَنْ         [5/322]      يَحْيَى بْنِ سَعِيدٍ ، وَمُحَمَّدِ بْنِ فُضَيْلٍ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  وَأَظُنُّ أَنَّ  عَمْرَو بْنَ عَلِيٍّ  حَمَلَ حَدِيثَ  ابْنِ فُضَيْلٍ  عَلَى حَدِيثِ  يَحْيَى  فِي  الرَّفْعِ ،  لِأَنِّي لَمْ أَسْمَعْ أَحَدًا  رَفَعَهُ  عَنِ  ابْنِ فُضَيْلٍ  إِلَّا  عَمْرُو بْنُ عَلِيٍّ ،  فَجَمَعَ فِيهِ  يَحْيَى  وَابْنَ فُضَيْلٍ  .","","Musnad al-Bazzar 1951","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن محمد بن فضيل بن غزوان عن الفلاس عن البزار","الشعبي عن مسروق عن عبد الله"
"1952","1940  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَإِبْرَاهِيمُ بْنُ الْمُسْتَمِرِّ ، قَالَا:  نَا  بَكْرُ بْنُ يَحْيَى بْنِ زَبَّانَ الْعَنَزِيُّ ، قَالَ:  نَا  حِبَّانُ بْنُ عَلِيٍّ ،  عَنْ  مُجَالِدٍ ،  عَنْ  عَامِرٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  لَمَّا جِيءَ  بِأَبِي جَهْلٍ  يُجَرُّ إِلَى الْقَلِيبِ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ كَانَ  أَبُو طَالِبٍ  حَيًّا  لَعَرَفَ أَوْ لَعَلِمَ  أَنَّ أَسْيَافَنَا قَدِ أُلْبِسَتْ بِالْأَمَاثِلِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  مُجَالِدٍ  إِلَّا  حَبَّانُ بْنُ عَلِيٍّ ،  وَلَا نَعْلَمُ رَوَى عَنْهُ إِلَّا  بَكْرُ بْنُ يَحْيَى بْنِ زَبَّانَ  .","","Musnad al-Bazzar 1940","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن حبان بن علي العنزي عن بكر بن يحيى العنزي عن إبراهيم بن المستمر العروقي عن البزار","الشعبي عن مسروق عن عبد الله"
"1953","[5/323]      1941  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْقَطَّانُ الْوَاسِطِيُّ ، وَإِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ الْجُنَيْدِ ، قَالَا:  نَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ أَبِي مُوَاتِيَةَ ، قَالَ:  نَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  نَظَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى الْجُوعِ فِي وُجُوهِ أَصْحَابِهِ فَقَالَ:  أَبْشِرُوا ، فَإِنَّهُ سَيَأْتِي عَلَيْكُمْ زَمَانٌ يُغْدَى عَلَى أَحَدِكُمْ بِالْقَصْعَةِ مِنَ الثَّرِيدِ  وَيُرَاحُ عَلَيْهِ بِمِثْلِهَا ، قَالُوا: يَا رَسُولَ اللهِ ، نَحْنُ يَوْمَئِذٍ خَيْرٌ ، قَالَ: بَلْ أَنْتُمُ الْيَوْمَ خَيْرٌ مِنْكُمْ يَوْمَئِذٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  مُجَالِدٍ  إِلَّا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  وَلَا عَنِ  ابْنِ فُضَيْلِ  إِلَّا  مُحَمَّدُ بْنُ جَعْفَرٍ  هَذَا وَلَمْ يُتَابِعْ عَلَيْهِ  .","","Musnad al-Bazzar 1941","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن محمد بن فضيل بن غزوان عن محمد بن جعفر الفيدي عن إبراهيم بن عبد الله بن الجنيد الختلي عن البزار","الشعبي عن مسروق عن عبد الله"
"1954","1942  -  حَدَّثَنَا  الْفَضْلُ بْنُ سَهْلٍ ، قَالَ:  نَا  أَسْوَدُ بْنُ عَامِرٍ ، قَالَ:  نَا  شَرِيكٌ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  تَدُورُ رَحَى الْإِسْلَامِ يَعْنِي عَلَى رَأْسِ خَمْسٍ وَثَلَاثِينَ سَنَةً ،  فَإِنْ يَهْلِكُوا فَسَبِيلُ مَنْ هَلَكَ ، وَإِنْ يَبْقُوا يَبْقَى لَهُمْ أَمْرُهُمْ سَبْعِينَ سَنَةً  .","","Musnad al-Bazzar 1942","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن شريك بن عبد الله النخعي عن الأسود بن عامر شاذان عن الفضل بن سهل الخراساني عن البزار","الشعبي عن مسروق عن عبد الله"
"1955","[5/324]      1943  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ ، قَالَ:  نَا  يَحْيَى بْنُ غَيْلَانَ ، قَالَ:  نَا  أَبُو عَوَانَةَ ،  عَنْ  فِرَاسٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  رُبَّمَا حَدَّثَنَا عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَيَتَلَوَّنُ وَجْهُهُ ،  وَيَتَغَيَّرُ لَوْنُهُ ، وَيَقُولُ نَحْوَ هَذَا أَوْ قَرِيبًا مِنْ هَذَا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  فِرَاسٍ  إِلَّا  أَبُو عَوَانَةَ ،  وَلَا عَنْ  أَبِي عَوَانَةَ  إِلَّا  يَحْيَى بْنُ غَيْلَانَ  .","","Musnad al-Bazzar 1943","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن فراس بن يحيى الخارفي عن الوضاح بن عبد الله اليشكري عن يحيى بن غيلان عن محمد بن عبد الرحيم  صاعقة عن البزار","الشعبي عن مسروق عن عبد الله"
"1956","1944  -  حَدَّثَنَا  مَحْمُودُ بْنُ بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ:  نَا  أَبِي  ، قَالَ:  نَا  عِيسَى بْنُ الْمُخْتَارِ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  الْيَدُ  الْعُلْيَا  خَيْرٌ مِنَ  الْيَدِ  السُّفْلَى ،  وَابْدَأْ بِمَنْ  تَعُولُ  أُمَّكَ وَأَبَاكَ ، وَأُخْتَكَ وَأَخَاكَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى مِنْ حَدِيثِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ  إِلَّا مِنْ حَدِيثِ  ابْنِ أَبِي لَيْلَى ،  وَالسَّرِيِّ بْنِ إِسْمَاعِيلَ  .","","Musnad al-Bazzar 1944","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن محمد بن عبد الرحمن بن أبي ليلى عن عيسى بن المختار الأنصاري عن بكر بن عبد الرحمن الأنصاري عن محمود بن بكر بن عبد الرحمن عن البزار","الشعبي عن مسروق عن عبد الله"
"1957","1945  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ، قَالَ:  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ:         [5/325]      نَا  إِسْرَائِيلُ ،  عَنْ  أَبِي حُصَيْنٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  حَدَّثَ يَوْمًا فَقَالَ: إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخَذَتْهُ الرِّعْدَةُ  وَرَعَدَتْ ثِيَابُهُ ثُمَّ قَالَ نَحْوَ هَذَا أَوْ هَكَذَا  .","","Musnad al-Bazzar 1945","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن عثمان بن عاصم بن حصين عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","الشعبي عن مسروق عن عبد الله"
"1958","1946  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ زِيَادٍ الصَّايِغُ ، قَالَ:  نَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ:  أَنَا  مُحَمَّدُ بْنُ سَالِمٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  أَوَّلُ جَدَّةٍ وَرِثَتْ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَدَّةٌ وَابْنُهَا حَيُّ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ إِلَّا  مُحَمَّدُ بْنُ سَالِمٍ  وَلَمْ يُتَابِعْ عَلَيْهِ ،  وَمُحَمَّدُ بْنُ سَالِمٍ  هَذَا فَهُوَ  لَيِّنُ الْحَدِيثِ  .","","Musnad al-Bazzar 1946","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن محمد بن سالم الهمداني عن يزيد بن هارون عن إبراهيم بن زياد الصائغ عن البزار","الشعبي عن مسروق عن عبد الله"
"1959","1947  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ ثَعْلَبَةَ ، قَالَ:  نَا  أَبُو يَحْيَى الْحِمَّانِيُّ ،  عَنِ  السَّرِيِّ بْنِ إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  إِنَّ مِنَ السُّنَّةِ أَنْ يَقُولَ الرَّجُلُ فِي رُكُوعِهِ: سُبْحَانَ رَبِّيَ         [5/326]      الْعَظِيمِ ثَلَاثًا ،  وَفِي سُجُودِهِ: سُبْحَانَ رَبِّيَ الْأَعْلَى ثَلَاثًا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ ،  وَالسَّرِيُّ بْنُ إِسْمَاعِيلَ  هَذَا  فَلَيْسَ بِالْقَوِيِّ  .","","Musnad al-Bazzar 1947","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن السري بن إسماعيل الهمداني عن عبد الحميد بن عبد الرحمن بشمين عن الجرب ، محمد بن عبيد بن محمد بن ثعلبة عن البزار","الشعبي عن مسروق عن عبد الله"
"1960","1948  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ ، قَالَ:  نَا  السَّرِيُّ بْنُ إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَعْرَابِيٌّ  فَقَالَ: يَا رَسُولَ اللهِ ، إِنِّي رَجُلٌ مِنْ  أَهْلِ الْبَادِيَةِ ،  وَإِنِّي مُوسِرٌ ، وَلِي أُمٌّ وَأَبٌ ، وَأَخٌ وَأُخْتٌ ، وَعَمٌّ وَعَمَّةٌ ، وَخَالٌ وَخَالَةٌ ، فَأَيُّهُمْ أَوْلَى بِصِلَتِي ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  أُمَّكَ وَأَبَاكَ ، وَأُخْتَكَ وَأَخَاكَ ، وَأَدْنَاكَ أَدْنَاكَ  .","","Musnad al-Bazzar 1948","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن السري بن إسماعيل الهمداني عن مكي بن إبراهيم عن يوسف بن موسى بن راشد عن البزار","الشعبي عن مسروق عن عبد الله"
"1961","1949  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ الْأَهْوَازِيُّ ، قَالَ:  نَا  عَامِرُ بْنُ مُدْرِكٍ ،         [5/327]      قَالَ:  نَا  السَّرِيُّ بْنُ إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  أَقْبَلْتُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ عَلَى  نَشَزٍ  مِنَ الْأَرْضِ حَتَّى جَلَسْتُ مُسْتَقْبِلَ  وَجْهِهِ أَوْ وَجْهِي  عِنْدَ رُكْبَتَيْهِ ، فَاغْتَنَمْتُ خَلْوَةَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقُلْتُ: يَا رَسُولَ اللهِ ، أَيُّ الذُّنُوبِ أَكْبَرُ ؟ فَأَعْرَضَ عَنِّي حَتَّى قُلْتُهَا ثَلَاثَ مَرَّاتٍ ، ثُمَّ أَقْبَلْ بِوَجْهِهِ فَقَالَ:  أَنْ تَجْعَلَ لِلهِ  نِدًّا  وَهُوَ خَلَقَكَ  ، قَالَ: ثُمَّ قُلْتُ: ثُمَّ مَاذَا ؟ قَالَ: أَنْ تَقْتُلَ وَلَدَكَ مِنْ أَجْلِ أَنْ  يَأْكُلَ أَوْ يَطْعَمَ  مَعَكَ ، قُلْتُ: يَا رَسُولِ اللهِ ، ثُمَّ  مَهْ  ؟ أَوْ ثُمَّ مَاذَا ؟ قَالَ: تُزَانِيَ  حَلِيلَةَ  جَارِكَ ، ثُمَّ أَخْرَجَ يَدَهُ وَقَرَأَ         {      وَالَّذِينَ لا يَدْعُونَ مَعَ اللهِ إِلَهًا آخَرَ         }      الْآيَةَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الشَّعْبِيِّ  بِهَذَا  الْإِسْنَادِ  إِلَّا  السَّرِيُّ بْنُ إِسْمَاعِيلَ ،  وَالسَّرِيُّ  فَلَيْسَ بِالْقَوِيِّ ،  وَقَدْ حَدَّثَ عَنْهُ  الزُّهْرِيُّ  وَجَمَاعَةٌ كَثِيرَةٌ مِنْ أَهْلِ الْعِلْمِ  .","","Musnad al-Bazzar 1949","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن السري بن إسماعيل الهمداني عن عامر بن مدرك بن أبي الصفيراء الحارثي عن أحمد بن إسحاق بن عيسى الأهوازي عن البزار","الشعبي عن مسروق عن عبد الله"
"1962","[5/328]      1950  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ ، قَالَ:  نَا  عَامِرُ بْنُ مُدْرِكٍ ، قَالَ:  نَا  السَّرِيُّ بْنُ إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَعْرَابِيٌّ ،  فَقَالَ: يَا  مُحَمَّدُ ،  إِنِّي لَأُحِبُّكَ -  أَحْسَبُهُ - قَالَ: وَاللهِ إِنِّي لَأُحِبُّكَ ،  قَالَهَا ثَلَاثَ مَرَّاتٍ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: مَنْ هَذَا الْحَالِفُ عَلَى مَا حَلَفَ ؟ فَقَالَ الرَّجُلُ: أَنَا يَا رَسُولَ اللهِ ، فَقَالَ:  انْطَلِقْ فَأَنْتَ مَعَ مَنْ أَحْبَبْتَ ،  وَعَلَيْكَ مَا اكْتَسَبْتَ ، وَعَلَى اللهِ مَا  احْتَسَبْتَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ  إِلَّا  السَّرِيُّ بْنُ إِسْمَاعِيلَ ،  وَقَدْ تَقَدَّمَ ذِكْرُنَا فِي  السَّرِيِّ بْنِ إِسْمَاعِيلَ  .","","Musnad al-Bazzar 1950","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن السري بن إسماعيل الهمداني عن عامر بن مدرك بن أبي الصفيراء الحارثي عن أحمد بن إسحاق بن عيسى الأهوازي عن البزار","الشعبي عن مسروق عن عبد الله"
"1963","[5/329]      عَبْدُ اللهِ بْنُ مُرَّةَ  وَغَيْرُهُ مِنْ أَصْحَابِ  مَسْرُوقٍ  عَنْ  مَسْرُوقٍ  1951  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَعَمْرُو بْنُ عَلِيٍّ ، قَالَا:  نَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  لَا يَحِلُّ دَمُ رَجُلٍ يَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ إِلَّا بِإِحْدَى ثَلَاثٍ  : النَّفْسُ بِالنَّفْسِ ،  وَالثَّيِّبُ  الزَّانِي ، وَالتَّارِكُ لِدِينِهِ الْمُفَارِقُ لِلْجَمَاعَةِ  .","","Musnad al-Bazzar 1951","","عبد الله بن مسعود عن مسروق بن الأجدع عن عبد الله بن مرة الخارفي عن الأعمش عن أبو معاوية الضرير عن الفلاس عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1964","1952  -  وَحَدَّثَنَاهُ  الْفَضْلُ بْنُ سَهْلٍ ، قَالَ:  نَا  يَعْلَى بْنُ عُبَيْدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بِنَحْوِهِ.         [5/330]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ ،  إِلَّا مِنْ هَذَا الْوَجْهِ إِلَّا حَدِيثًا  .         [5/331]","","Musnad al-Bazzar 1952","","عبد الله بن مسعود عن مسروق بن الأجدع عن عبد الله بن مرة الخارفي عن الأعمش عن يعلى بن عبيد الطنافسي عن الفضل بن سهل الخراساني عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1965","1953  -  حَدَّثَنَاهُ  الْفَضْلُ ،  عَنْ  أَسْوَدِ بْنِ عَامِرٍ ،  عَنْ  زُهَيْرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُسْلِمٍ وَهُوَ أَبُو الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بِنَحْوِهِ ،  وَحَدِيثُ  مُسْلِمٍ  غَيْرُ مَحْفُوظٍ ،  وَإِنَّمَا يُحْفَظُ مِنْ حَدِيثِ  عَبْدِ اللهِ بْنِ مُرَّةَ  .","","Musnad al-Bazzar 1953","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن زهير بن معاوية بن حديج عن الأسود بن عامر شاذان عن الفضل بن سهل الخراساني عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1966","1954  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  لَيْسَ مِنَّا مَنْ ضَرَبَ الْخُدُودَ ، وَشَقَّ الْجُيُوبَ ،  وَدَعَا بِدَعْوَى الْجَاهِلِيَّةِ  .","","Musnad al-Bazzar 1954","","عبد الله بن مسعود عن مسروق بن الأجدع عن عبد الله بن مرة الخارفي عن الأعمش عن أبو معاوية الضرير عن الفلاس عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1967","[5/332]      1955  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَعِيدٍ ، قَالَ:  نَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ، قَالَ:  سَمِعْتُ  الْأَعْمَشَ  يَرْوِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  كُنْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي نَخْلٍ ، فَعَرَضَ لَهُ يَهُودُ فَسَأَلُوهُ عَنِ الرُّوحِ ،  فَوَقَفَ سَاعَةً فَظَنَنَّا أَنَّهُ يُوحَى إِلَيْهِ ، ثُمَّ قَالَ:         {      وَيَسْأَلُونَكَ عَنِ الرُّوحِ قُلِ الرُّوحُ مِنْ أَمْرِ رَبِّي وَمَا أُوتِيتُمْ مِنَ الْعِلْمِ إِلا قَلِيلا         }      .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ أَحَدٌ عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ  إِلَّا  ابْنُ إِدْرِيسَ ،  وَغَيْرُ  ابْنِ إِدْرِيسَ  يَرْوِيهِ عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ  .","","Musnad al-Bazzar 1955","","عبد الله بن مسعود عن مسروق بن الأجدع عن عبد الله بن مرة الخارفي عن الأعمش عن عبد الله بن إدريس الأودي عن عبد الله بن سعيد الأشج عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1968","1956  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، وَإِبْرَاهِيمُ بْنُ عَبْدِ اللهِ ، قَالَا:  نَا  مُحَمَّدُ بْنُ كَثِيرٍ         [5/333]      ، قَالَ:  نَا  هَمَّامٌ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  الْعَيْنَانِ تَزْنِيَانِ ، وَالْيَدَانِ تَزْنِيَانِ ،  وَالرِّجْلَانِ تَزْنِيَانِ ، وَالْفَرْجُ يَزْنِي  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  عَاصِمٍ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ  مَرْفُوعًا  إِلَّا  هَمَّامٌ  .","","Musnad al-Bazzar 1956","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن عاصم بن بهدلة عن همام بن يحيى بن دينار عن محمد بن كثير العبدي عن إبراهيم بن عبد الله بن الجنيد الختلي عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1969","1957  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ، وَأَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ ، وَمُحَمَّدُ بْنُ اللَّيْثِ ، قَالُوا:  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ:  نَا  شَيْبَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  أَخَذْتُ مِنْ فِي رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَبْعِينَ سُورَةً  .         [5/334]","","Musnad al-Bazzar 1957","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن محمد بن الليث السرخسي عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1970","1958  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  أَبُو الْمُسَاوِرِ الْفَضْلُ بْنُ مُسَاوِرٍ ، قَالَ:  نَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بِنَحْوِهِ.  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ،  إِلَّا  أَبُو عَوَانَةَ  وَشَيْبَانُ  .","","Musnad al-Bazzar 1958","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن الوضاح بن عبد الله اليشكري عن الفضل بن مساور البصري عن أبو موسى الزمن عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1971","1959  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  أَحْمَدُ بْنُ عَبْدِ اللهِ ، قَالَ:  نَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  لَا تَرْجِعُوا بَعْدِي  كُفَّارًا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ ،  وَلَا يُؤْخَذُ الرَّجُلُ  بِجَرِيرَةِ  أَبِيهِ ، وَلَا  بِجَرِيرَةِ  أَخِيهِ  .","","Musnad al-Bazzar 1959","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن أبو بكر بن عياش عن أحمد بن عبد الله اليربوعي عن يوسف بن موسى بن راشد عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1972","1960  -  وَحَدَّثَنَاهُ  عِيسَى بْنُ مُوسَى السَّامِيُّ ، قَالَ:  نَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ، قَالَ:  نَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،         [5/335]      عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بِنَحْوِهِ .  وَهَذَا الْكَلَامُ قَدْ رُوِيَ بَعْضُهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ وُجُوهٍ بِأَلْفَاظٍ مُخْتَلِفَةٍ ، وَرُوِيَ عَنْ  عَبْدِ اللهِ  مِنْ وَجْهٍ آخَرَ بَعْضُ كَلَامِهِ ، وَلَا نَعْلَمُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا مِنْ هَذَا الْوَجْهِ  .","","Musnad al-Bazzar 1960","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن أبو بكر بن عياش عن يحيى بن أبي بكير عن عيسى بن موسى بن أبي حرب الصفار عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1973","1961  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  مُوسَى بْنُ مَسْعُودٍ ، قَالَ:  نَا  سُفْيَانُ ،  عَنْ  سُلَيْمَانَ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُسَلِّمُ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ فِي الصَّلَاةِ  .         [5/336]      وَهَذَا الْحَدِيثُ يُرْوَى غَيْرَ  مُوسَى ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  جَابِرٍ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ  .","","Musnad al-Bazzar 1961","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن سفيان الثوري عن موسى بن مسعود النهدي عن أبو موسى الزمن عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1974","1962  -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ ، وَمُحَمَّدُ بْنُ مِرْدَاسٍ ، وَالْفَضْلُ بْنُ يَعْقُوبَ الْجَزَرِيُّ ، قَالَ  نَصْرٌ  :  أَنَا  سَهْلُ بْنُ يُوسُفَ ، وَقَالَا:  نَا  سَهْلُ بْنُ يُوسُفَ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُسَلِّمُ فِي الصَّلَاةِ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ  : السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ ، السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ  .  وَهَذَا الْحَدِيثُ  لَا نَحْفَظُ  مِنْ حَدِيثِ  الْحَجَّاجِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ  إِلَّا مِنْ حَدِيثِ  سَهْلٍ  عَنْهُ  .","","Musnad al-Bazzar 1962","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن حجاج بن أرطاة عن سهل بن يوسف الأنماطي عن محمد بن مرداس الأنصاري عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1975","1963  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقُطَعِيُّ ، قَالَ:  نَا  أَبُو دَاوُدَ ، قَالَ:  نَا         [5/337]      الْمَسْعُودِيُّ ،  عَنْ  جَابِرٍ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ الصَّادِقُ الْمَصْدُوقُ :  إِنَّ بَيْعَ الْمُحَفَّلَاتِ  خِلَابَةٌ ،  وَلَا تَحِلُّ  الْخِلَابَةُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  أَبِي الضُّحَى  إِلَّا مِنْ حَدِيثِ  جَابِرٍ  .","","Musnad al-Bazzar 1963","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن جابر الجعفي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن أبو داود الطيالسي عن محمد بن يحيى بن أبي حزم القطعي عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1976","1964  -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ ، وَمُحَمَّدُ بْنُ يَحْيَى الْقُطَعِيُّ ، قَالَ  نَصْرٌ  :  أَنَا         [5/338]      عَبْدُ الْعَزِيزُ بْنُ عَبْدِ الصَّمَدِ ، وَقَالَ  مُحَمَّدُ بْنُ يَحْيَى  :  نَا  أَبُو عَبْدِ الصَّمَدِ عَبْدُ الْعَزِيزِ بْنُ عَبْدِ الصَّمَدِ ، قَالَ:  نَا  مَنْصُورُ بْنُ الْمُعْتَمِرِ ،  عَنْ  مُسْلِمٍ يَعْنِي أَبَا الضُّحَى قَالَ:  كُنْتُ مَعَ  مَسْرُوقٍ  فِي بَيْتٍ فِيهِ تِمْثَالُ  مَرْيَمَ  فَقَالَ  مَسْرُوقٌ  : هَذَا تِمْثَالُ  كِسْرَى؟  قُلْتُ: لَا ، وَلَكِنْ تِمْثَالُ  مَرْيَمَ ،  فَقَالَ  مَسْرُوقٌ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ مَسْعُودٍ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِنَّ أَشَدَّ النَّاسِ عَذَابًا يَوْمَ الْقِيَامَةِ الْمُصَوِّرُونَ  .  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ  الْأَعْمَشُ ،  وَمَنْصُورٌ ،  وَحُصَيْنٌ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad al-Bazzar 1964","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن منصور بن المعتمر عن عبد العزيز بن عبد الصمد العمي عن محمد بن يحيى بن أبي حزم القطعي عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1977","[5/339]      1965  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ .  1966  -  وَحَدَّثَنَاهُ  الْفَضْلُ بْنُ سَهْلٍ ، قَالَ:  نَا  مُعَاوِيَةُ بْنُ عَمْرٍو ، قَالَ:  نَا  زَائِدَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُسْلِمٍ ، قَالَ:  قَالَ  مَسْرُوقٌ :  كُنَّا عِنْدَ  عَبْدِ اللهِ  فَدَخَلَ عَلَيْنَا رَجُلٌ  وَعَبْدُ اللهِ  مُضْطَجِعٌ ، فَقَالَ: جِئْتُكَ مِنَ الْمَسْجِدِ فَتَلَقَّانِي نَاسٌ عِنْدَ أَبْوَابِ  كِنْدَةَ  وَهُمْ يَقُولُونَ  الدُّخَانُ أَوْ تَجِيءُ آيَةُ الدُّخَانِ  فَيَأْخُذُ بِأَنْفَاسِ الْكُفَّارِ فَيَأْخُذُ الْمُؤْمِنُ كَهَيْئَةِ الزُّكَامِ ، فَغَضِبَ عَبْدُ اللهِ فَجَلَسَ  فَقَالَ  : أَيُّهَا النَّاسُ مَنْ عَلِمَ مِنْكُمْ شَيْئًا فَلْيَقُلْ مَا عَلِمَ ، وَمَنْ لَمْ يَعْلَمْ فَلْيَقُلِ : اللهُ أَعْلَمُ ، فَإِنَّ عِلْمَ أَحَدِكُمْ إِذَا سُئِلَ عَمَّا لَا يَعْلَمُ أَنْ يَقُولَ: اللهُ أَعْلَمُ ، فَإِنَّ اللهَ تَبَارَكَ وَتَعَالَى قَالَ لِنَبِيِّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:         {      قُلْ مَا أَسْأَلُكُمْ عَلَيْهِ مِنْ أَجْرٍ وَمَا أَنَا مِنَ الْمُتَكَلِّفِينَ         }      ، وَآيَةُ الدُّخَانَ قَدْ مَضَتْ ، إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمَّا رَأَى إِدْبَارًا مِنَ النَّاسِ قَالَ:  اللَّهُمَّ سَبْعٌ كَسَبْعِ يُوسُفَ  ، فَأَخَذَتِ النَّاسَ سَنَةٌ  حَصَّتْ  كُلَّ شَيْءٍ ، حَتَّى جَعَلُوا يَأْكُلُونَ الْمَيْتَةَ وَالْجُلُودَ ، فَجَاءَ  أَبُو سُفْيَانَ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ: يَا  مُحَمَّدُ ،  إِنَّكَ جِئْتَ تَأْمُرُ         [5/340]      بِطَاعَةِ اللهِ ، وَصِلَةِ الرَّحِمِ ، وَإِنَّ قَوْمَكَ قَدْ هَلَكُوا ، فَادْعُ اللهَ لَهُمْ ، ثُمَّ قَرَأَ  عَبْدُ اللهِ  هَذِهِ الْآيَةَ:         {      فَارْتَقِبْ يَوْمَ تَأْتِي السَّمَاءُ         }      حَتَّى بَلَغَ         {      إِنَّكُمْ عَائِدُونَ         }      ، قَالَ: فَكُشِفَ ،  قَالَ  عَبْدُ اللهِ  : فَكُشِفَ عَذَابُ الْآخِرَةِ ، وَإِنَّ آيَةَ الدُّخَانِ مَضَتْ ، وَالْبَطْشَةُ وَاللِّزَامُ كَانَتَا  يَوْمَ بَدْرٍ  وَقَدْ مَضَتْ آيَةُ الرُّومِ  .         [5/341]      قَالَ: وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  مُسْلِمٌ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ  .","","Musnad al-Bazzar 1965","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن منصور بن المعتمر عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن الفضل بن سهل الخراساني عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1978","1967  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  مُحَمَّدُ بْنُ عُبَيْدٍ الطَّنَافِسِيُّ ، قَالَ:  نَا  فِطْرٌ ،  عَنْ  مُسْلِمِ بْنِ صُبَيْحٍ ،  عَنْ  مَسْرُوقٍ قَالَ:  سَمِعْتُ  ابْنَ مَسْعُودٍ يَقُولُ:  خَمْسٌ قَدْ مَضَيْنَ : انْشِقَاقُ الْقَمَرِ ،  و         {      الم             *          غُلِبَتِ الرُّومُ         }      ،         [5/342]      و         {      يَوْمَ تَأْتِي السَّمَاءُ بِدُخَانٍ مُبِينٍ         }      ، و         {      يَوْمَ نَبْطِشُ الْبَطْشَةَ الْكُبْرَى         }      ،  وَيَوْمَ بَدْرٍ  .","","Musnad al-Bazzar 1967","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن فطر بن خليفة عن محمد بن عبيد بن أبي أمية عن يوسف بن موسى بن راشد عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1979","1968  -  حَدَّثَنَا  عِيسَى بْنُ مُوسَى السَّامِيُّ ، قَالَ:  نَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  سُلَيْمَانَ ، وَحُصَيْنٍ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِنَّ أَشَدَّ النَّاسِ عَذَابًا يَوْمَ الْقِيَامَةِ الْمُصَوِّرُونَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  شُعْبَةَ  بِهَذَا  الْإِسْنَادِ  إِلَّا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  وَقَدْ رَوَاهُ غَيْرُ وَاحِدٍ عَنِ  الْأَعْمَشِ  ، وَرُوِيَ عَنْ  حُصَيْنٍ  أَيْضًا مِنْ غَيْرِ حَدِيثِ  شُعْبَةَ  .","","Musnad al-Bazzar 1968","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن حصين بن عبد الرحمن السلمي عن شعبة بن الحجاج عن يحيى بن أبي بكير عن عيسى بن موسى بن أبي حرب الصفار عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1980","[5/343]      1969  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْجُنَيْدِ ، قَالَ:  نَا  يَحْيَى بْنُ غَيْلَانَ ، قَالَ:  نَا  أَبُو عَوَانَةَ ،  عَنِ  الْمُغِيرَةِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ قَالَ:  دَخَلْتُ عَلَى  ابْنِ مَسْعُودٍ  وَهُوَ عِنْدَ  أَبِي مُوسَى  وَعِنْدَهُ  حُذَيْفَةُ ،  فَقَالَ  حُذَيْفَةُ  : يَا  عَبْدَ اللهِ بْنَ قَيْسٍ ،  أَمَّا أَنْتَ بُعِثْتَ إِلَى  أَهْلِ الْبَصْرَةِ  أَمِيرًا وَمُعَلِّمًا فَأَخَذُوا مِنْ أَدَبِكَ وَمِنْ قِرَاءَتِكَ ،  قَالَ  ابْنُ مَسْعُودٍ :  مَا مِنَ الْقُرْآنِ آيَةٌ إِلَّا أَعْلَمُ حِينَ نَزَلَتْ وَفِيمَا نَزَلَتْ ،  وَلَوْ أَعْلَمُ أَحَدًا أَعْلَمَ بِكِتَابِ اللهِ مِنِّي تَبْلُغُهُ الْإِبِلُ رَحَلْتُ إِلَيْهِ  .","","Musnad al-Bazzar 1969","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن يحيى بن غيلان عن محمد بن أحمد بن الجنيد الدقاق عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1981","1970  -  حَدَّثَنَا  الْفَضْلُ بْنُ يَعْقُوبَ الرُّخَامِيُّ ، قَالَ:  نَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الرَّقِّيُّ ، قَالَ:  نَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  حَمَّادِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ         [5/344]      عَبْدِ اللهِ قَالَ:  كَانَ نَبِيُّكُمْ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا كَانَ رَاكِعًا أَوْ سَاجِدًا قَالَ: سُبْحَانَكَ  وَبِحَمْدِكَ  ،  أَسْتَغْفِرُكَ وَأَتُوبُ إِلَيْكَ  .  وَلَا نَعْلَمُ رَوَى  حَمَّادٌ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ  إِلَّا هَذَا الْحَدِيثَ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1970","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن حماد بن أبي سليمان عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن عبد الله بن جعفر بن غيلان عن الفضل بن يعقوب الرخامي عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1982","1971  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  يَحْيَى بْنُ حَمَّادٍ ، قَالَ:  نَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  انْشَقَّ الْقَمَرُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَقَالَ الْمُشْرِكُونَ: هَذَا سِحْرٌ وَلَكِنِ انْظُرُوا فَسَلُوهُمْ فَسَأَلُوا  مُحَمَّدًا  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .         [5/345]      قَالَ أَبُو بَكْرٍ الْبَزَّارُ :  لَيْسَ عِنْدِي فِيهِ أَكْثَرُ مِنْ هَذَا  .","","Musnad al-Bazzar 1971","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن يحيى بن حماد بن أبي زياد الشيباني عن يوسف بن موسى بن راشد عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1983","1972  -  حَدَّثَنَا  عَمْرُو بْنُ يَحْيَى الْأُبُلِّيُّ  ، قَالَ:  نَا  حَفْصُ بْنُ جُمَيْعٍ ،  عَنِ  الْمُغِيرَةِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُسَلِّمُ فِي الصَّلَاةِ عَنْ يَمِينِهِ السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ حَتَّى يُرَى بَيَاضُ خَدِّهِ ،  وَعَنْ يَسَارِهِ السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ  .  وَلَا نَعْلَمُ رَوَى  الْمُغِيرَةُ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ  إِلَّا ثَلَاثَةَ أَحَادِيثَ  .  كذا في طبعة مكتبة العلوم والحكم ، والصواب : ( عمرو بن يحيى )","","Musnad al-Bazzar 1972","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن المغيرة بن مقسم الضبي عن حفص بن جميع العجلي عن عمر بن يحيى الأبلي عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1984","1973  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَعَمْرُو بْنُ عَلِيٍّ ، وَأَحْمَدُ بْنُ سِنَانٍ ، قَالُوا:  نَا  أَبُو أَحْمَدَ ، قَالَ:  نَا  سُفْيَانُ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِنَّ لِكُلِّ نَبِيٍّ وُلَاةً مِنَ النَّبِيِّينَ ،  وَإِنَّ وَلِيَّ مِنْهُمْ أَبِي  وَخَلِيلَ  رَبِّي ، ثُمَّ قَالَ:         {      إِنَّ أَوْلَى النَّاسِ بِإِبْرَاهِيمَ لَلَّذِينَ اتَّبَعُوهُ وَهَذَا النَّبِيُّ وَالَّذِينَ آمَنُوا         }      الْآيَةَ.         [5/346]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا  وَصَلَهُ  إِلَّا  أَبُو أَحْمَدَ ،  عَنِ  الثَّوْرِيِّ ،  وَرَوَاهُ غَيْرُ  أَبِي أَحْمَدَ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ أَبِيهِ ، عَنْ  أَبِي الضُّحَى ،  عَنْ  عَبْدِ اللهِ  .","","Musnad al-Bazzar 1973","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن سعيد بن مسروق الثوري عن سفيان الثوري عن محمد بن عبد الله بن الزبير عن أحمد بن سنان القطان عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1985","1974  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقُطَعِيُّ ، قَالَ:  نَا  مُحَمَّدُ بْنُ بُكَيْرٍ  ، قَالَ:  نَا  الْمَسْعُودِيُّ ،  عَنْ  جَابِرٍ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  أَمَّنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَلَّمَ عَنْ يَمِينِهِ حَتَّى يُرَى بَيَاضُ خَدِّهِ الْأَيْسَرِ  السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ  ، قَالَ: فَقَالَ  عَبْدُ اللهِ  : فَمَا نَسِيتُ بَعْدُ فِيمَا نَسِيتُ .  كذا في طبعة مكتبة العلوم والحكم ، ولعل الصواب بكر .","","Musnad al-Bazzar 1974","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن جابر الجعفي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن محمد بن بكر بن عثمان البرساني عن محمد بن يحيى بن أبي حزم القطعي عن البزار","عبد الله بن مرة وغيره من أصحاب مسروق عن مسروق"
"1986","[5/347]      يَحْيَى بْنُ وَثَّابٍ  عَنْ  مَسْرُوقٍ  عَنْ  عَبْدِ اللهِ  1975  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ عَلِيِّ بْنِ جَعْفَرِ الْأَحْمَرِ ، وَأَحْمَدُ بْنُ يَحْيَى بْنُ الْمُنْذِرِ ، قَالَا:  نَا  يَحْيَى بْنُ الْمُنْذِرِ ، قَالَ:  نَا  إِسْرَائِيلُ ،  عَنْ  أَبِي حُصَيْنٍ ،  عَنْ  يَحْيَى بْنِ وَثَّابٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  ذُكِرَ النَّوْمُ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ:  نَامُوا ، فَإِذَا انْتَبَهْتُمْ فَأَحْسِنُوا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  إِسْرَائِيلَ  بِهَذَا  الْإِسْنَادِ  فَأَسْنَدُوهُ  إِلَى النَّبِيِّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا  يَحْيَى بْنُ الْمُنْذِرِ  .","","Musnad al-Bazzar 1975","","عبد الله بن مسعود عن مسروق بن الأجدع عن يحيى بن وثاب الأصبهاني عن عثمان بن عاصم بن حصين عن إسرائيل بن يونس بن أبي إسحاق عن يحيى بن المنذر الكوفي عن الحسين بن علي بن جعفر عن البزار","يحيى بن وثاب عن مسروق عن عبد الله"
"1987","1976  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ بِسْطَامٍ ، قَالَ:  نَا  أَبُو دَاوُدَ ، قَالَ:  نَا  قَيْسٌ .         [5/348]      1977  -  وَحَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ الْأَهْوَازِيُّ ، قَالَ:  نَا  مُحَمَّدُ بْنُ الصَّلْتِ ، قَالَ:  نَا  قَيْسٌ ،  عَنْ  أَبِي حُصَيْنٍ ،  عَنْ  يَحْيَى بْنِ وَثَّابٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ  رَفَعَهُ  قَالَ:  إِنَّ الْخَبِيثَ لَا يُكَفِّرُ الْخَبِيثَ ،  وَلَكِنَّ الطَّيِّبَ يُكَفِّرُ الْخَبِيثَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ الْأَعْلَى  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1976","","عبد الله بن مسعود عن مسروق بن الأجدع عن يحيى بن وثاب الأصبهاني عن عثمان بن عاصم بن حصين عن قيس بن الربيع الأسدي عن أبو داود الطيالسي عن إبراهيم بن بسطام الأبلى عن البزار","يحيى بن وثاب عن مسروق عن عبد الله"
"1988","1978  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ زِيَادٍ الصَّائِغُ ، قَالَ:  نَا  عَاصِمُ بْنُ عَلِيٍّ ، قَالَ:  نَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  أَبِي حُصَيْنٍ ،  عَنْ  يَحْيَى بْنِ وَثَّابٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ:  دَخَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  بِلَالٍ  وَعِنْدَهُ صُبْرٌ مِنْ تَمْرٍ فَقَالَ: مَا هَذَا يَا  بِلَالُ  ؟ قَالَ: أَعُدُّ ذَلِكَ لِأَضْيَافِكَ ،         [5/349]      قَالَ: أَمَا تَخْشَى أَنْ يَكُونَ لَهُ  دُخَانٌ  فِي نَارِ  جَهَنَّمَ ،  أَنْفِقْ يَا  بِلَالُ  وَلَا تَخْشَ مِنْ ذِي الْعَرْشِ إِقْلَالًا  .  وَهَذَا الْحَدِيثُ هَكَذَا رَوَاهُ  قَيْسٌ  ، عَنْ  أَبِي حُصَيْنٍ  ، عَنْ  يَحْيَى  ، عَنْ  مَسْرُوقٍ  ، عَنْ  عَبْدِ اللهِ  ، رَوَاهُ عَنْهُ  أَبُو غَسَّانَ  ،  وَعَاصِمٌ  ، وَرَوَاهُ  يَحْيَى بْنُ أَبِي بُكَيْرٍ  ، عَنْ  قَيْسٍ  ، عَنْ  أَبِي حُصَيْنٍ  ، عَنْ  يَحْيَى  ، عَنْ  مَسْرُوقٍ  ، عَنْ  عَائِشَةَ  .  1979  -  حَدَّثَنَا  بِهِ  عِيسَى بْنُ مُوسَى السَّامِيُّ  ، قَالَ: نَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ  .","","Musnad al-Bazzar 1978","","عبد الله بن مسعود عن مسروق بن الأجدع عن يحيى بن وثاب الأصبهاني عن عثمان بن عاصم بن حصين عن قيس بن الربيع الأسدي عن عاصم بن علي الواسطي عن إبراهيم بن زياد الصائغ عن البزار","يحيى بن وثاب عن مسروق عن عبد الله"
"1989","1980  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ إِسْحَاقَ الْعَطَّارُ ، قَالَ:  نَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ، قَالَ:  نَا  إِسْرَائِيلُ ،  عَنْ  أَبِي حُصَيْنٍ ،  عَنْ  يَحْيَى بْنِ وَثَّابٍ ،  عَنْ  مَسْرُوقٍ ،         [5/350]      عَنْ  عَبْدِ اللهِ قَالَ:  إِنِّي لَأَعْلَمُ  النَّظَائِرَ  الَّتِي كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ بِهِنَّ  .  وَهَذَا الْحَدِيثُ رَوَاهُ  ابْنُ رَجَاءٍ ،  وَلَمْ أَرَهُ عِنْدِي مِنْ حَدِيثِ  عُبَيْدِ اللهِ بْنِ مُوسَى ،  وَلَا سَمِعْتُ أَحَدًا يَذْكُرُهُ إِلَّا عَنِ  ابْنِ رَجَاءٍ  وَبِهِ يُعْرَفُ  .  آخِرُ الْجُزْءِ الثَّامِنَ عَشَرَ وَأَوَّلُ التَّاسِعَ عَشَرَ ، وَالْحَمْدُ لِلهِ.","","Musnad al-Bazzar 1980","","عبد الله بن مسعود عن مسروق بن الأجدع عن يحيى بن وثاب الأصبهاني عن عثمان بن عاصم بن حصين عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن عبد الله بن إسحاق الجوهري عن البزار","يحيى بن وثاب عن مسروق عن عبد الله"
"1990","[5/351]      بَقِيَّةُ حَدِيثِ  مَسْرُوقٍ  1981  -  أَخْبَرَنَا  أَبُو الْحَسَنِ مُحَمَّدُ بْنُ أَيُّوبَ قَالَ:  نَا  أَحْمَدُ بْنُ عَمْرِو بْنِ عَبْدِ الْخَالِقِ ، قَالَ:  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، وَأَحْمَدُ بْنُ سِنَانٍ الْقَطَّانُ ، قَالَا:  نَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ، قَالَ:  نَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِنَّ لِكُلِّ نَبِيٍّ وُلَاةً مِنَ النَّبِيِّينَ  وَوَلِيَّ مِنْهُمْ أَبِي  وَخَلِيلِ  رَبِّي ، يَعْنِي  إِبْرَاهِيمَ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ قَرَأَ:         {      إِنَّ أَوْلَى النَّاسِ بِإِبْرَاهِيمَ لَلَّذِينَ اتَّبَعُوهُ وَهَذَا النَّبِيُّ وَالَّذِينَ آمَنُوا وَاللهُ وَلِيُّ الْمُؤْمِنِينَ         }      .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا بِهَذَا  الْإِسْنَادِ  مُتَّصِلًا  .","","Musnad al-Bazzar 1981","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن سعيد بن مسروق الثوري عن سفيان الثوري عن محمد بن عبد الله بن الزبير عن أحمد بن سنان القطان عن البزار","بقية حديث مسروق"
"1991","1982  -  حَدَّثَنَا  عِيسَى بْنُ مُوسَى السَّامِيُّ ، قَالَ:  نَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  حُصَيْنٍ يَعْنِي ابْنَ عَبْدِ الرَّحْمَنِ ، وَسُلَيْمَانَ يَعْنِي الْأَعْمَشَ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  إِنَّ أَشَدَّ النَّاسِ عَذَابًا يَوْمَ الْقِيَامَةِ الْمُصَوِّرُونَ  .  وَهَذَا الْحَدِيثُ رَوَاهُ عَنِ  الْأَعْمَشِ  جَمَاعَةٌ ، وَلَا نَعْلَمُ أَحَدًا         [5/352]      جَمَعَ بَيْنَ  حُصَيْنٍ  وَسُلَيْمَانَ  إِلَّا  شُعْبَةُ ،  وَلَا نَعْلَمُ حَدَّثَ بِهِ عَنْ  شُعْبَةَ  إِلَّا  يَحْيَى بْنُ أَبِي بُكَيْرٍ  .","","Musnad al-Bazzar 1982","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن حصين بن عبد الرحمن السلمي عن شعبة بن الحجاج عن يحيى بن أبي بكير عن عيسى بن موسى بن أبي حرب الصفار عن البزار","بقية حديث مسروق"
"1992","1983  -  وَحَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ:  نَا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ الصَّمَدِ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَحْوَهُ .","","Musnad al-Bazzar 1983","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن منصور بن المعتمر عن عبد العزيز بن عبد الصمد العمي عن الفلاس عن البزار","بقية حديث مسروق"
"1993","1984  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ، قَالَ:  نَا  أَبُو أُسَامَةَ ، قَالَ:  نَا  مِسْعَرٌ ،  عَنْ  مَعْنِ يَعْنِي ابْنَ عَبْدِ الرَّحْمَنِ ، قَالَ:  سَمِعْتُ  أَبِي  قَالَ:  سَأَلْتُ  مَسْرُوقًا  مَنْ آذَنَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْجِنِّ لَيْلَةَ اسْتَمَعُوا الْقُرْآنَ ؟  قَالَ: حَدَّثَنِي أَبُوكَ يَعْنِي ابْنَ مَسْعُودٍ إِنَّمَا آذَنَتْهُ بِهِمْ شَجَرَةٌ .  وَهَذَا الْحَدِيثُ رَوَاهُ  أَبُو أُسَامَةَ  ، عَنْ  مِسْعَرٍ  ، عَنْ  مَعْنٍ  ، وَخَالَفَهُ  ابْنُ عُيَيْنَةَ ،  فَرَوَاهُ عَنْ  مِسْعَرٍ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ  .","","Musnad al-Bazzar 1984","","عبد الله بن مسعود عن مسروق بن الأجدع عن عبد الرحمن بن عبد الله بن مسعود عن معن بن عبد الرحمن المسعودي عن مسعر بن كدام عن حماد بن أسامة القرشي عن محمد بن عثمان بن كرامة الوراق عن البزار","بقية حديث مسروق"
"1994","[5/353]      عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ بْنِ مَسْعُودٍ  عَنْ أَبِيهِ  الْقَاسِمِ  عَنْ أَبِيهِ عَنْ جَدِّهِ  أَبُو إِسْحَاقَ  عَنْهُ  1985  -  حَدَّثَنَا  أَحْمَدُ بْنُ سِنَانٍ ، وَمُحَمَّدُ بْنُ مُوسَى الْقَطَّانُ ، وَمُحَمَّدُ بْنُ عُبَادَةَ الْوَاسِطِيُّ ، قَالُوا:  نَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ:  أَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ  ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  مَنْ قَتَلَ حَيَّةً فَكَأَنَّمَا قَتَلَ كَافِرًا  .  وَلَا نَعْلَمُ رَوَى  أَبُو إِسْحَاقَ ،  عَنِ  الْقَاسِمِ ،  عَنْ أَبِيهِ ، عَنْ  عَبْدِ اللهِ  إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 1985","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن يزيد بن هارون عن محمد بن عبادة بن البخترى الأسدي عن البزار","أبو إسحاق عنه"
"1995","[5/354]      مَنْصُورُ بْنُ الْمُعْتَمِرِ  عَنِ  الْقَاسِمِ  1986  -  كَتَبَ إِلَيَّ  مُحَمَّدُ بْنُ حُمَيْدٍ يُخْبِرُنِي فِي كِتَابِهِ ،  أَنَّ هَارُونَ بْنَ الْمُغِيرَةِ  حَدَّثَهُ  قَالَ:  نَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  مَنْصُورٍ يَعْنِي ابْنَ الْمُعْتَمِرِ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ  قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  رَضِيتُ لِأُمَّتِي مَا رَضِيَ لَهَا  ابْنُ أُمِّ عَبْدٍ ،  وَكَرِهْتُ لِأُمَّتِي مَا كَرِهَ لَهَا  ابْنُ أُمِّ عَبْدٍ  .  وَلَا نَعْلَمُ  أَسْنَدَ  مَنْصُورٌ ،  عَنِ  الْقَاسِمِ ،  عَنْ أَبِيهِ ، عَنْ  عَبْدِ اللهِ  إِلَّا هَذَا الْحَدِيثَ ، وَلَا نَعْلَمُ رَوَاهُ  مُسْنَدًا  إِلَّا  عَمْرُو بْنُ أَبِي قَيْسٍ  مِنْ         [5/355]      حَدِيثِ  مُحَمَّدِ بْنِ حُمَيْدٍ ،  عَنْ  هَارُونَ  ، وَقَدْ رُوِيَ عَنْ  مَنْصُورٍ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ  مُرْسَلًا  .","","Musnad al-Bazzar 1986","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن منصور بن المعتمر عن عمرو بن أبي قيس عن هارون بن المغيرة المروزي عن محمد بن حميد الرازي عن البزار","منصور بن المعتمر عن القاسم"
"1996","[5/356]      الْأَعْمَشُ  عَنِ  الْقَاسِمِ  1987  -  حَدَّثَنَا  عَلِيُّ بْنُ مُسْلِمٍ الطُّوسِيُّ ، قَالَ:  نَا  مُحَمَّدُ بْنُ أَبِي عُبَيْدَةَ ، قَالَ:  حَدَّثَنِي  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ قَالَ:  لَقَدْ رَأَيْتُنِي وَإِنِّي لَسَادِسُ سِتَّةٍ مَا عَلَى ظَهْرِ الْأَرْضِ مُسْلِمٌ غَيْرُنَا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الْأَعْمَشِ  بِهَذَا  الْإِسْنَادِ  إِلَّا  أَبُو عُبَيْدَةَ بْنُ مَعْنٍ  وَلَا عَنْهُ إِلَّا ابْنُهُ.","","Musnad al-Bazzar 1987","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن الأعمش عن عبد الملك بن معن المسعودي عن محمد بن أبي عبيدة المسعودي عن علي بن مسلم الطوسي عن البزار","الأعمش عن القاسم"
"1997","1988  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْحَرَشِيُّ ، قَالَ:  نَا  فُضَيْلُ بْنُ سُلَيْمَانَ النُّمَيْرِيُّ ، قَالَ:  نَا  عَبْدُ اللهِ بْنُ عُثْمَانَ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  يَا  عَبْدَ اللهِ ،  سَيَأْتِي بَعْدِي قَوْمٌ يُؤَخِّرُونَ الصَّلَاةَ         [5/357]      عَنْ مَوَاقِيتِهَا  ، قَالَ  عَبْدُ اللهِ  فَقُلْتُ: كَيْفَ تَأْمُرُنِي يَا رَسُولَ اللهِ؟ قَالَ: يَا  ابْنَ أُمِّ عَبْدٍ  إِنْ أَدْرَكْتَهُمْ فَلَا  طَاعَةَ  لِمَخْلُوقٍ فِي مَعْصِيَةِ الْخَالِقِ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى ، عَنْ  عَبْدِ اللهِ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1988","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن عبد الله بن عثمان بن خثيم عن فضيل بن سليمان النميري عن محمد بن موسى الحرشي عن البزار","الأعمش عن القاسم"
"1998","[5/358]      سِمَاكٌ  عَنِ  الْقَاسِمِ  1989  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، وَعَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَا:  نَا  الْحُسَيْنُ بْنُ عَلِيٍّ الْجُعْفِيُّ ،  عَنْ  زَائِدَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ  قَالَ:  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي غَزَاةٍ فَأَدْلَجْنَا ذَاتَ لَيْلَةٍ ، فَقُلْتُ: لَوْ نَزَلْتَ اسْتَرَحْنَا ، قَالَ: وَمَنْ يَحْرُسُنَا ؟ قَالَ: أَنَا أَحْرُسُكُمُ  فَنُوِّمُوا ،  وَنِمْتُ كَمَا نَامُوا حَتَّى طَلَعَتِ الشَّمْسُ  فَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَتَوَضَّأَ ، وَتَوَضَّأْنَا لِصَلَاةِ الصُّبْحِ ثُمَّ صَلَّيْنَا الصُّبْحَ ضُحًى  .  وَهَذَا الْحَدِيثُ رَوَاهُ  سِمَاكٌ ،  عَنِ  الْقَاسِمِ ،  وَرَوَاهُ عَنْ  سِمَاكٍ  زَائِدَةُ  ،  وَيَزِيدُ بْنُ عَطَاءٍ  .","","Musnad al-Bazzar 1989","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن سماك بن حرب البكري عن زائدة بن قدامة عن الحسين بن علي الجعفي عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","سماك عن القاسم"
"1999","1990  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ سَعِيدٍ الْأَنْمَاطِيُّ ، قَالَ:  نَا  مُحَمَّدُ بْنُ         [5/359]      سَعِيدِ بْنِ سَابِقٍ ، قَالَ:  نَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  سِمَاكٍ يَعْنِي ابْنَ حَرْبٍ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  أَنَّ  بَنِي إِسْرَائِيلَ  اسْتَخْلَفُوا  خَلِيفَةً  عَلَيْهِمْ بَعْدَ  مُوسَى  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَقَامَ يُصَلِّي لَيْلَةً فِي الْقَمَرِ فَوْقَ  بَيْتِ الْمَقْدِسِ ،  فَذَكَرَ أُمُورًا كَانَ صَنَعَهَا ، فَخَرَجَ فَتَدَلَّى بِسَبَبٍ ، فَأَصْبَحَ السَّبَبُ مُتَعَلِّقًا فِي الْمَسْجِدِ وَقَدْ ذَهَبَ ، قَالَ: فَانْطَلَقَ حَتَّى أَتَى قَوْمًا عَلَى شَطِّ الْبَحْرِ فَوَجَدَهُمْ  يَضْرِبُونَ لَبِنًا أَوْ يَصْنَعُونَ لَبِنًا ،  فَسَأَلَهُمْ كَيْفَ تَأْخُذُونَ عَلَى هَذَا اللَّبِنِ ؟ قَالَ: فَأَخْبَرُوهُ ، فَلَبَّنَ مَعَهُمْ ، فَكَانَ يَأْكُلُ مِنْ عَمَلِ يَدِهِ ، فَإِذَا كَانَ حِينُ الصَّلَاةِ قَامَ يُصَلِّي ، فَرَفَعَ ذَلِكَ الْعُمَّالُ إِلَى  دِهْقَانِهِمْ  أَنَّ فِينَا رَجُلًا يَفْعَلُ كَذَا وَكَذَا ، فَأَرْسَلَ إِلَيْهِ فَأَبَى أَنْ يَأْتِيَهُ ثَلَاثَ مَرَّاتٍ ، ثُمَّ إِنَّهُ جَاءَهُ يَسِيرُ عَلَى دَابَّتِهِ ، فَلَمَّا رَآهُ فَرَّ ، فَاتَّبَعَهُ فَسَبَقَهُ فَقَالَ: أَنْظِرْنِي أُكَلِّمْكَ ، قَالَ: فَقَامَ حَتَّى كَلَّمَهُ فَأَخْبَرَهُ خَبَرَهُ ، فَلَمَّا أَخْبَرَهُ أَنَّهُ كَانَ مَلِكًا وَأَنَّهُ فَرَّ مِنْ رَهْبَةِ اللهِ قَالَ: إِنِّي لَأَظُنَّنِي لَاحِقٌ بِكَ ، قَالَ: فَاتَّبَعَهُ فَعَبَدَ اللهَ حَتَّى مَاتَا  بِرُمَيْلَةَ مِصْرَ  ، قَالَ  عَبْدُ اللهِ  : لَوْ أَنِّي كُنْتُ ثَمَّ لَاهْتَدَيْتُ إِلَى قَبْرَيْهِمَا مِنْ صِفَةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الَّتِي وَصَفَ لَنَا  .         [5/360]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنْ  سِمَاكٍ ،  عَنِ  الْقَاسِمِ ،  عَنْ أَبِيهِ ، عَنْ  عَبْدِ اللهِ  إِلَّا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  وَقَدْ رَوَاهُ  الْمَسْعُودِيُّ  ، عَنْ  سِمَاكٍ  ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ  ، عَنْ أَبِيهِ ، وَلَمْ يَذْكُرِ  الْقَاسِمَ  .","","Musnad al-Bazzar 1990","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن سماك بن حرب البكري عن عمرو بن أبي قيس عن محمد بن سعيد القزويني عن أحمد بن محمد بن سعيد الأنماطي عن البزار","سماك عن القاسم"
"2000","[5/361]      عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ  عَنِ  الْقَاسِمِ  1991  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْمُخَرِّمِيُّ ، قَالَ:  نَا  مُحَمَّدُ أَبُو إِسْمَاعِيلَ ، قَالَ:  نَا  عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  .","","Musnad al-Bazzar 1991","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن محمد أبو إسماعيل عن محمد بن عبد الله بن المبارك المخرمي عن البزار","عبد الرحمن بن إسحاق عن القاسم"
"2001","1992  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ الْحَارِثِ بْنِ إِسْمَاعِيلَ الْخَزَّازُ ، قَالَ:  نَا  سَيَّارُ بْنُ حَاتِمٍ ، قَالَ:  نَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ، قَالَ:  نَا  عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  لَمَّا كَانَ لَيْلَةَ أُسْرِيَ بِي لَقِيتُ  إِبْرَاهِيمَ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي السَّمَاءِ السَّابِعَةِ ،  فَقَالَ: يَا  مُحَمَّدُ ،  اقْرَأْ عَلَى أُمَّتِكَ السَّلَامَ ، وَأَخْبِرْهُمْ أَنَّ الْجَنَّةَ عِذْبٌ مَاؤُهَا ، طَيِّبٌ شَرَابُهَا ،         [5/362]      وَأَنَّ فِيهَا  قِيعَانًا  ، وَأَنَّ غَرْسَ شَجَرِهَا سُبْحَانَ اللهِ ، وَالْحَمْدُ لِلهِ ، وَلَا إِلَهَ إِلَّا اللهُ ، وَاللهُ أَكْبَرُ  .","","Musnad al-Bazzar 1992","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن عبد الواحد بن زياد عن سيار بن حاتم العنزي عن محمد بن الحارث بن إسماعيل الخزاز عن البزار","عبد الرحمن بن إسحاق عن القاسم"
"2002","1993  -  وَحَدَّثَنَاهُ  أَبُو كَامِلٍ ، قَالَ:  نَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بِنَحْوِهِ ،  وَلَمْ يَقُلْ عَنِ  الْقَاسِمِ ،  عَنْ أَبِيهِ ، عَنْ  عَبْدِ اللهِ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1993","","عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن عبد الواحد بن زياد عن فضيل بن حسين الجحدري عن البزار","عبد الرحمن بن إسحاق عن القاسم"
"2003","[5/363]      1994  -  حَدَّثَنَا  إِسْحَاقُ بْنُ بُهْلُولٍ ، قَالَ:  نَا  إِسْحَاقُ بْنُ عِيسَى ، قَالَ:  نَا  مُحَمَّدُ بْنُ صَالِحٍ الثَّقَفِيُّ ، قَالَ:  نَا  عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  قَالَ:  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُعَلِّمُنَا هَذَا الدُّعَاءَ: اللَّهُمَّ إِنِّي عَبْدُكَ ، ابْنُ عَبْدِكَ ، ابْنُ أَمَتِكَ ،  نَاصِيَتِي بِيَدِكَ ، مَاضٍ فِيَّ حُكْمُكَ ، نَافِذٌ فِيَّ قَضَاؤُكَ ، أَسْأَلُكَ بِكُلِّ اسْمٍ سَمَّيْتَ بِهِ نَفْسَكَ ، أَوْ أَنْزَلْتَهُ فِي كِتَابِكَ ، أَوْ عَلَّمْتَهُ أَحَدًا مِنْ خَلْقِكَ ، أَوِ  اسْتَأْثَرْتَ  بِهِ فِي عِلْمِ الْغَيْبِ عِنْدَكَ ، أَنْ تَجْعَلَ الْقُرْآنَ  رَبِيعَ  قَلْبِي ، وَنُورَ صَدْرِي ، وَجِلَاءَ حُزْنِي ، وَذَهَابَ غَمِّي ، إِلَّا أَذْهَبَ اللهُ غَمَّهُ وَأَبْدَلَهُ بِحُزْنِهِ فَرَحًا ، قَالُوا: يَا رَسُولَ اللهِ ، يَنْبَغِي لَنَا أَنْ نَتَعَلَّمَ هَؤُلَاءِ الْكَلِمَاتِ ، قَالَ: أَجَلْ يَنْبَغِي لِمَنْ سَمِعَهُنَّ أَنْ يَتَعَلَّمَهُنَّ  .","","Musnad al-Bazzar 1994","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن محمد بن صالح الثقفي عن إسحاق بن عيسى بن نجيح عن إسحاق بن بهلول الأنباري عن البزار","عبد الرحمن بن إسحاق عن القاسم"
"2004","[5/364]      عُمَرُ بْنُ قَيْسٍ  عَنِ  الْقَاسِمِ  1995  -  حَدَّثَنَا  عَلِيُّ بْنُ حَرْبٍ الْجُنْدَيْسَابُورِيُّ ، قَالَ:  نَا  سُلَيْمَانُ بْنُ أَبِي هَوْذَةَ الرَّازِيُّ ، قَالَ:  نَا  عَمْرُو بْنُ أَبِي قَيْسٍ ، قَالَ:  نَا  عُمَرُ بْنُ قَيْسٍ يَعْنِي الْمَاصِرَ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  إِذَا اخْتَلَفَ  الْبَيِّعَانِ  وَلَيْسَ بَيْنَهُمَا بَيِّنَةٌ ، فَالْقَوْلُ مَا قَالَ الْبَائِعُ ،  أَوْ يَتَرَادَّانِ الْبَيْعَ  .         [5/365]      وَهَذَا الْحَدِيثُ لَمْ نَسْمَعْهُ إِلَّا مِنْ  عَلِيِّ بْنِ حَرْبِ  بِهَذَا  الْإِسْنَادِ ،  وَلَا نَعْلَمُ رَوَاهُ عَنْ  عُمَرَ بْنِ قَيْسٍ  إِلَّا  عَمْرُو بْنُ أَبِي قَيْسٍ  .","","Musnad al-Bazzar 1995","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن عمر بن قيس الماصر عن عمرو بن أبي قيس عن سليمان بن أبى هوذة عن علي بن حرب الجند يسابوري عن البزار","عمر بن قيس عن القاسم"
"2005","[5/366]      سُلَيْمَانُ بْنُ أَبِي سُلَيْمَانَ  عَنِ  الْقَاسِمِ  1996  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ:  نَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ:  أَنَا  الْعَوَّامُ بْنُ حَوْشَبٍ ،  عَنْ  سُلَيْمَانَ بْنِ أَبِي سُلَيْمَانَ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ  قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  تَدُورُ رَحَى الْإِسْلَامِ عَلَى خَمْسٍ وَثَلَاثِينَ ، أَوْ سِتَّةٍ وَثَلَاثِينَ ، أَوْ سَبْعَةٍ وَثَلَاثِينَ ،  فَإِنْ يَهْلِكُوا فَسَبِيلُ مَنْ هَلَكَ ، وَإِنْ بَقُوا أَوْ بَقِيَ بَقِيَ لَهُمْ دِينُهُمْ سَبْعِينَ سَنَةً  .","","Musnad al-Bazzar 1996","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن سليمان بن فيروز الشيباني عن العوام بن حوشب عن يزيد بن هارون عن محمد بن معمر بن ربعي البحراني عن البزار","سليمان بن أبي سليمان ومجالد عن القاسم"
"2006","[5/367]      مُجَالِدٌ  عَنِ  الْقَاسِمِ  1997  -  وَحَدَّثَنَاهُ  الْفَضْلُ بْنُ سَهْلٍ قَالَ:  نَا  الْأَسْوَدُ بْنُ عَامِرٍ ، قَالَ:  نَا  شَرِيكٌ ،  عَنْ  مُجَالِدٍ ، قَالَ:  فَحَدَّثَنِي  الْقَاسِمُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ.","","Musnad al-Bazzar 1997","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن مجالد بن سعيد عن شريك بن عبد الله النخعي عن الأسود بن عامر شاذان عن الفضل بن سهل الخراساني عن البزار","سليمان بن أبي سليمان ومجالد عن القاسم"
"2007","وَإِنَّمَا  حَدَّثَنَا  بِهِ الْفَضْلُ ،  عَنِ  الْأَسْوَدِ بْنِ عَامِرٍ ،  عَنْ  شَرِيكٍ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِهَذَا الْكَلَامِ.  قَالَ شَرِيكٌ : فَحَدَّثَنِي مُجَالِدٌ ، قَالَ:  فَحَدَّثَنِي  الْقَاسِمُ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .  وَلَا نَعْلَمُ رَوَى  مُجَالِدٌ ،  عَنِ  الْقَاسِمِ ،  حَدِيثًا  مُسْنَدًا  إِلَّا هَذَا الْحَدِيثَ وَلَا رَوَاهُ عَنْهُ إِلَّا  شَرِيكٌ  .","","Musnad al-Bazzar 2007","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن شريك بن عبد الله النخعي عن الأسود بن عامر شاذان عن الفضل بن سهل الخراساني عن البزار","سليمان بن أبي سليمان ومجالد عن القاسم"
"2008","[5/368]      الْحَارِثُ بْنُ حَصِيرَةَ  عَنِ  الْقَاسِمِ  1998  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ ، قَالَ:  نَا  عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ:  نَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنِ  الْحَارِثِ بْنِ حَصِيرَةَ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  قَالَ:  كُنْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَعْنِي  يَوْمَ حُنَيْنٍ  فَتَفَرَّقَ النَّاسُ وَبَقِيتُ مَعَهُ فِي ثَمَانِينَ رَجُلًا مِنَ  الْمُهَاجِرِينَ  وَالْأَنْصَارِ  وَهُمُ الَّذِينَ أَنْزَلَ اللهُ عَلَيْهِمُ  السَّكِينَةَ  ، وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى بَغْلَتِهِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  نَاوِلْنِي كَفًّا مِنْ تُرَابٍ  ، فَرَمَى بِهِ وُجُوهَهُمْ ، فَامْتَلَأَتْ أَعْيُنُهُمْ تُرَابًا ، وَأَقْبَلَ  الْمُهَاجِرُونَ  وَالْأَنْصَارُ  وَسُيُوفُهُمْ بِأَيْمَانِهِمْ كَأَنَّهَا الشُّهُبُ وَوَلَّى الْمُشْرِكُونَ مُدْبِرِينَ  .","","Musnad al-Bazzar 1998","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن الحارث بن حصيرة الأزدي عن عبد الواحد بن زياد عن عفان بن مسلم الصفار عن محمد بن عبد الرحيم  صاعقة عن البزار","الحارث بن حصيرة عن القاسم"
"2009","1999  -  حَدَّثَنَا  عَمْرُو بْنُ بِشْرٍ النَّاجِيُّ ، قَالَ:  نَا  عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ:  نَا         [5/369]      عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنِ  الْحَارِثِ بْنِ حَصِيرَةَ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ  قَالَ:  قَالَ لَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  كَيْفَ أَنْتُمْ وَرُبُعُ أَهْلِ الْجَنَّةِ لَكُمْ وَلِسَائِرِ النَّاسِ ثَلَاثَةُ أَرْبَاعِهَا ؟  قَالُوا: اللهُ وَرَسُولُهُ أَعْلَمُ ، قَالَ: كَيْفَ أَنْتُمْ وَثُلُثُهَا ؟ قَالُوا: ذَاكَ أَكْثَرُ ، قَالَ: كَيْفَ أَنْتُمْ  وَالشَّطْرُ  ؟ قَالُوا: ذَاكَ أَكْثَرُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: أَهْلُ الْجَنَّةِ عِشْرُونَ وَمِائَةُ صَفٍّ ، أُمَّتِي مِنْهَا ثَمَانُونَ صَفًّا  .  وَهَذَانِ الْحَدِيثَانِ لَا نَعْلَمُهُمَا يُرْوَيَانَ ، عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 1999","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن الحارث بن حصيرة الأزدي عن عبد الواحد بن زياد عن عفان بن مسلم الصفار عن عمرو بن بشر الناجي عن البزار","الحارث بن حصيرة عن القاسم"
"2010","[5/370]      عَطَاءُ بْنُ السَّائِبِ  عَنِ  الْقَاسِمِ  2000  -  حَدَّثَنَا  الْفَضْلُ بْنُ سَهْلٍ ، قَالَ:  نَا  مُحَمَّدُ بْنُ الصَّلْتِ ، قَالَ:  نَا  أَبُو كُدَيْنَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  قَالَ:  جَاءَ  رَجُلٌ مِنْ أَهْلِ الْكِتَابِ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَأَلَهُ عَنِ الشَّبَهِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِذَا عَلَا مَاءُ الرَّجُلِ غَلَبَ الشَّبَهُ ، وَإِذَا عَلَا مَاءُ الْمَرْأَةِ غَلَبَ الشَّبَهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الْقَاسِمِ ،  عَنْ أَبِيهِ ، عَنْ  عَبْدِ اللهِ  إِلَّا  عَطَاءُ بْنُ السَّائِبِ ،  وَلَا نَحْفَظُ أَنَّ أَحَدًا رَوَاهُ عَنْ  عَطَاءٍ  إِلَّا  أَبُو كُدَيْنَةَ  .","","Musnad al-Bazzar 2000","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن عطاء بن السائب عن يحيى بن المهلب البجلي عن محمد بن الصلت الأصم عن الفضل بن سهل الخراساني عن البزار","عطاء بن السائب عن القاسم"
"2011","[5/371]      مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ  عَنِ  الْقَاسِمِ  2001  -  حَدَّثَنَا  عَلِيُّ بْنُ سَهْلٍ الْمَدَائِنِيُّ ، قَالَ:  نَا  يَحْيَى بْنُ آدَمَ ، قَالَ:  نَا  مِنْدَلٌ ،  عَنِ  ابْنِ أَبِي لَيْلَى وَهُوَ مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ  .","","Musnad al-Bazzar 2001","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن محمد بن عبد الرحمن بن أبي ليلى عن مندل بن علي عن يحيى بن آدم عن علي بن سهل المدائني عن البزار","محمد بن عبد الرحمن عن القاسم"
"2012","2002  -  وَحَدَّثَنَاهُ  أَحْمَدُ بْنُ سِنَانٍ الْقَطَّانُ ، قَالَ:  نَا  إِسْمَاعِيلُ بْنُ أَبَانَ ، قَالَ:  نَا  مِنْدَلٌ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ  - وَاللَّفْظُ لَفْظُ  يَحْيَى بْنِ آدَمَ  - قَالَ:  رَآنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَاضِعَ شِمَالِي عَلَى يَمِينِي فِي الصَّلَاةِ ، فَقَالَ:  ضَعْ يَمِينَكَ عَلَى شِمَالِكَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الْقَاسِمِ ،  عَنْ أَبِيهِ ، عَنْ  عَبْدِ اللهِ  إِلَّا  ابْنُ أَبِي لَيْلَى  .","","Musnad al-Bazzar 2002","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن محمد بن عبد الرحمن بن أبي ليلى عن مندل بن علي عن إسماعيل بن أبان عن أحمد بن سنان القطان عن البزار","محمد بن عبد الرحمن عن القاسم"
"2013","[5/372]      2003  -  حَدَّثَنَا  مَحْمُودُ بْنُ بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ:  حَدَّثَنِي  أَبِي  ،  عَنْ  عِيسَى بْنِ الْمُخْتَارِ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  إِذَا اخْتَلَفَ  الْبَيِّعَانِ  لَيْسَ بَيْنَهُمَا بَيِّنَةٌ ، فَالْقَوْلُ مَا قَالَ الْبَائِعُ ،  أَوْ يَتَرَادَّانِ الْبَيْعَ  .  وَهَذَا الْحَدِيثُ إِنَّمَا يُعْرَفُ مِنْ حَدِيثِ  ابْنِ أَبِي لَيْلَى ،  عَنِ  الْقَاسِمِ  إِلَّا مَا رَوَاهُ  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  عُمَرَ بْنِ قَيْسٍ         [5/373]      الْمَاصِرِ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  وَقَدْ رَوَى هَذَا الْحَدِيثَ غَيْرُ وَاحِدٍ عَنِ  ابْنِ أَبِي لَيْلَى  .","","Musnad al-Bazzar 2003","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن محمد بن عبد الرحمن بن أبي ليلى عن عيسى بن المختار الأنصاري عن بكر بن عبد الرحمن الأنصاري عن محمود بن بكر بن عبد الرحمن عن البزار","محمد بن عبد الرحمن عن القاسم"
"2014","[5/374]      الْمَسْعُودِيُّ  عَنِ  الْقَاسِمِ  2004  -  حَدَّثَنَا  عُبَيْدُ اللهِ ، رَجُلٌ مِنْ وَلَدِ الْمُغِيرَةِ بْنِ مُسْلِمٍ جَلِيسًا كَانَ لِإِبْرَاهِيمَ بْنِ مُحَمَّدٍ التَّيْمِيِّ ، وَكَانَ رَجُلًا لَهُ سِتْرٌ وَأَمَانَةٌ قَالَ:  نَا  مُوسَى بْنُ دَاوُدَ ، قَالَ:  نَا  الْمَسْعُودِيُّ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ  قَالَ:  كُنْتُ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقُلْتُ: لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: تَدْرِي مَا تَفْسِيرُهَا ؟ قُلْتُ: اللهُ وَرَسُولُهُ أَعْلَمُ ، قَالَ:  لَا حَوْلَ عَنْ مَعْصِيَةِ اللهِ إِلَّا بِعِصْمَةِ اللهِ ،  وَلَا قُوَّةَ عَلَى طَاعَةِ اللهِ إِلَّا بِعَوْنِ اللهِ  .  وَهَذَا الْحَدِيثُ لَمْ نَسْمَعْ  مَوْصُولًا  عَنِ  الْقَاسِمِ ،  عَنْ أَبِيهِ ، عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ .","","Musnad al-Bazzar 2004","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن موسى بن داود الخلقاني عن عبيد الله رجل من ولد المغيرة بن مسلم جليسا كان لإبراهيم بن محمد التيمي عن البزار","المسعودي عن القاسم"
"2015","2005  - وَقَدْ  حَدَّثَنَاهُ  الْحَسَنُ بْنُ قَزَعَةَ ، قَالَ:  نَا  عَبْدُ اللهِ بْنُ خِرَاشِ بْنِ         [5/375]      حَوْشَبٍ ،  عَنِ  الْمَسْعُودِيِّ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  ،  وَلَمْ يَقُلْ عَنِ  الْقَاسِمِ ،  عَنْ أَبِيهِ ، إِنَّمَا  أَرْسَلَهُ  .","","Musnad al-Bazzar 2005","","عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عبد الله بن خراش بن حوشب الحوشبي عن الحسن بن قزعة الخلقاني عن البزار","المسعودي عن القاسم"
"2016","2006  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ الْجُنَيْدِ ، قَالَ:  نَا  سَعِيدُ بْنُ سُلَيْمَانَ ، قَالَ:  نَا  مُصْعَبُ بْنُ سَلَّامٍ ،  عَنِ  الْحَجَّاجِ يَعْنِي ابْنَ أَرْطَاةَ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  رَفَعَهُ  قَالَ:  إِذَا أَكْرَمَ الرَّجُلُ أَخَاهُ فَإِنَّمَا يُكْرِمُ رَبَّهُ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا بِهَذَا  الْإِسْنَادِ ،  وَمُصْعَبُ بْنُ سَلَّامٍ  لَيْسَ بِالْقَوِيِّ ،  وَقَدْ رَوَى عَنْهُ غَيْرُ وَاحِدٍ ، وَهُوَ رَجُلٌ مِنْ  أَهْلِ الْكُوفَةِ  .","","Musnad al-Bazzar 2006","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن حجاج بن أرطاة عن مصعب بن سلام التميمي عن سعيد بن سليمان سعدويه عن إبراهيم بن عبد الله بن الجنيد الختلي عن البزار","المسعودي عن القاسم"
"2017","[5/376]      جَابِرٌ  عَنِ  الْقَاسِمِ  2007  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَارَةَ بْنِ صُبَيْحٍ الْكُوفِيُّ ، قَالَ:  نَا  قَبِيصَةُ بْنُ عُقْبَةَ ، قَالَ:  نَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  جَابِرٍ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ  قَالَ:  أُتِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِسَبْيٍ فَجَعَلَ يُعْطِي أَهْلَ الْبَيْتِ ،  وَكَرِهَ أَنْ يُفَرِّقَ بَيْنَهُمْ  .  وَلَا نَعْلَمُ رَوَى هَذَا الْحَدِيثَ عَنِ  الْقَاسِمِ  إِلَّا  جَابِرٌ ،  وَرَوَاهُ غَيْرُ وَاحِدٍ ، عَنْ  جَابِرٍ  .","","Musnad al-Bazzar 2007","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن جابر الجعفي عن سفيان الثوري عن قبيصة بن عقبة السوائي عن محمد بن عمارة بن صبيح الكوفي عن البزار","جابر عن القاسم"
"2018","[5/377]      أَبُو الْمَلِيحِ  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ  عَنْ أَبِيهِ  2008  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ ، وَالْفَضْلُ بْنُ سَهْلٍ ، قَالَا:  نَا  شَبَابَةُ بْنُ سَوَّارٍ ، قَالَ:  نَا  أَبُو بَكْرٍ الْهُذَلِيُّ ، قَالَ:  نَا  أَبُو الْمَلِيحِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  قَالَ:  دَفَعْتُ  يَوْمَ بَدْرٍ  إِلَى  أَبِي جَهْلٍ  وَقَدْ تَظَاهَرَ عَلَيْهِ الْحَدِيدُ كَأَنَّهُ بَصَلَةٌ ،  وَقَدْ أُقْعِدَ ، فَأَخَذْتُ سَيْفَهُ ، فَرَفَعَ رَأْسَهُ فَقَالَ: أَرُوَيْعِينَا  بِمَكَّةَ  ؟ قَالَ: فَضَرَبْتُهُ بِسَيْفِي حَتَّى  بَرَدَ  ، ثُمَّ أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْتُ: قَتَلْتُ  أَبَا جَهْلٍ ،  فَقَالَ  عَقِيلٌ  وَهُوَ أَسِيرٌ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: كَذَبْتَ مَا قَتَلْتَهُ ، فَقُلْتُ: بَلْ أَنْتَ الْكَذَّابُ الْأَشَمُّ يَا عَدُوَّ اللهِ ، قَدْ وَاللهِ قَتَلْتُهُ ، قَالَ: فَمَا عَلَامَتُهُ ؟ قُلْتُ: بِفَخِذِهِ حَلْقَةٌ كَحَلْقَةِ كَذَا لِشَيْءٍ ذَكَرَهُ يَعْنِي أَثَرًا فِي فَخِذِهِ ، قَالَ: صَدَقْتَ .  وَلَا نَعْلَمُ رَوَى  أَبُو الْمَلِيحِ ،  عَنْ  عَبْدِ الرَّحْمَنِ ،  عَنْ أَبِيهِ إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 2008","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن أبو المليح بن أسامة الهذلي عن أبو بكر الهذلي عن شبابة بن سوار المدائني عن الفضل بن سهل الخراساني عن البزار","أبو المليح عن عبد الرحمن بن عبد الله عن أبيه"
"2019","[5/378]      الْحَسَنُ بْنُ سَعْدٍ  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ  عَنْ أَبِيهِ  2009  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَلَاءِ أَبُو كُرَيْبٍ ، وَعَمْرُو بْنُ عَلِيٍّ ، قَالَا:  نَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنِ  الْحَسَنِ بْنِ سَعْدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  لَا يُعَذِّبُ بِالنَّارِ إِلَّا رَبُّ النَّارِ  .","","Musnad al-Bazzar 2009","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن الحسن بن سعد مولى علي بن أبي طالب عن سليمان بن فيروز الشيباني عن أبو معاوية الضرير عن الفلاس عن البزار","الحسن بن سعد عن عبد الرحمن بن عبد الله عن أبيه"
"2020","2010  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، وَمُحَمَّدُ بْنُ يَحْيَى الْقُطَعِيُّ ، قَالَا:  نَا  أَبُو دَاوُدَ ،  عَنِ  الْمَسْعُودِيِّ ،  عَنِ  الْحَسَنِ بْنِ سَعْدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ فِي سَفَرٍ ، فَدَخَلَ غَيْضَةً ، فَأَخَذَ رَجُلٌ بَيْضَ حُمَّرَةٍ ، فَجَاءَتِ الْحُمَّرَةُ فَجَعَلَتْ تَرِفُّ عَلَى         [5/379]      رَأْسِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابِهِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  أَيُّكُمْ فَجَّعَ هَذِهِ بَيْضَهَا ؟  ، فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، أَنَا أَخَذْتُ بَيْضَهَا ، قَالَ: ارْدُدْهُ رَحْمَةً لَهَا  .  وَهَذَا الْحَدِيثُ إِنَّمَا  نَحْفَظُهُ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2010","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن الحسن بن سعد مولى علي بن أبي طالب عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن أبو داود الطيالسي عن محمد بن يحيى بن أبي حزم القطعي عن البزار","الحسن بن سعد عن عبد الرحمن بن عبد الله عن أبيه"
"2021","[5/380]      سِمَاكُ بْنُ حَرْبٍ  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ  عَنْ أَبِيهِ  2011  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  إِنَّكُمْ مَنْصُورُونَ وَمَفْتُوحٌ عَلَيْكُمْ ،  فَمَنْ أَدْرَكَ ذَلِكَ فَلْيَتَّقِ وَلْيَأْمُرْ بِالْمَعْرُوفِ وَلْيَنْهَ عَنِ الْمُنْكَرِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2011","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","سماك بن حرب عن عبد الرحمن بن عبد الله عن أبيه"
"2022","2012  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، عَنِ         [5/381]      النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  لَعَنَ  آكِلَ  الرِّبَا وَمُوكِلَهُ ، وَكَاتِبَهُ وَشَاهِدَيْهِ  .  وَهَذَا الْكَلَامُ قَدْ رُوِيَ عَنْ  عَبْدِ اللهِ  مِنْ غَيْرِ وَجْهٍ .","","Musnad al-Bazzar 2012","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","سماك بن حرب عن عبد الرحمن بن عبد الله عن أبيه"
"2023","2013  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  مَثَلُ الَّذِي يُعِينُ قَوْمَهُ عَلَى غَيْرِ الْحَقِّ كَمَثَلِ بَعِيرٍ أَرْدَى فِي بِئْرٍ  فَهُوَ يَنْزِعُ مِنْهَا بِذَنَبِهِ  .         [5/382]      وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ  .","","Musnad al-Bazzar 2013","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","سماك بن حرب عن عبد الرحمن بن عبد الله عن أبيه"
"2024","2014  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  نَضَّرَ  اللهُ امْرَأً سَمِعَ مِنَّا حَدِيثًا فَبَلَّغَهُ كَمَا سَمِعَهُ ،  فَرُبَّ مُبَلَّغٍ أَوْعَى مِنْ سَامِعٍ  .","","Musnad al-Bazzar 2014","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","سماك بن حرب عن عبد الرحمن بن عبد الله عن أبيه"
"2025","[5/383]      2015  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ:  نَا  مُؤَمَّلُ ، قَالَ:  نَا  سُفْيَانُ ،  عَنْ  سِمَاكٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  قَالَ:  أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ فِي  قُبَّةٍ  حَمْرَاءَ فِي نَحْوٍ مِنْ أَرْبَعِينَ رَجُلًا ، فَقَالَ:  إِنَّكُمْ مَنْصُورُونَ وَمَفْتُوحٌ عَلَيْكُمْ ، فَمَنْ أَدْرَكَ ذَلِكَ فَلْيَتَّقِ اللهَ  وَلْيَأْمُرْ بِالْمَعْرُوفِ وَلْيَنْهَ عَنِ الْمُنْكَرِ ، وَمَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Musnad al-Bazzar 2015","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن سماك بن حرب البكري عن سفيان الثوري عن مؤمل بن إسماعيل العدوي عن محمد بن معمر بن ربعي البحراني عن البزار","سماك بن حرب عن عبد الرحمن بن عبد الله عن أبيه"
"2026","2016  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي صَفْوَانَ الثَّقَفِيُّ ، قَالَ:  نَا  أَبِي  ، قَالَ:  نَا  سُفْيَانُ يَعْنِي الثَّوْرِيَّ ،  عَنْ  سِمَاكٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ         [5/384]      عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  أَنَّهُ قَالَ:  لَا يَصْلُحُ  صَفْقَتَانِ  فِي  صَفْقَةٍ  قَالَ: وَأَمَرَنَا رَسُولُ اللهِ بِإِسْبَاغِ الْوُضُوءِ  .  وَهَذَا الْحَدِيثُ لَمْ نَسْمَعُهُ إِلَّا مِنْ  مُحَمَّدِ بْنِ عُثْمَانَ ،  عَنْ أَبِيهِ ، وَأَخْرَجَ إِلَيْنَا  مُحَمَّدُ بْنُ عُثْمَانَ  كِتَابًا ذَكَرَ أَنَّهُ كِتَابُ أَبِيهِ فِيهِ هَذَا الْحَدِيثُ  .","","Musnad al-Bazzar 2016","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن سماك بن حرب البكري عن سفيان الثوري عن والد محمد بن عثمان بن أبي صفوان الثقفي عن محمد بن عثمان بن أبي صفوان الثقفي عن البزار","سماك بن حرب عن عبد الرحمن بن عبد الله عن أبيه"
"2027","2017  -  حَدَّثَنَا  الْفَضْلُ بْنُ سَهْلٍ ، قَالَ:  نَا  أَسْوَدُ بْنُ عَامِرٍ ،  عَنْ  شَرِيكٍ ،  عَنْ  سِمَاكٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  قَالَ:  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ  صَفْقَتَيْنِ  فِي  صَفْقَةٍ  .  وَهَذَا الْحَدِيثُ  أَسْنَدَهُ  شَرِيكٌ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2017","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن الأسود بن عامر شاذان عن الفضل بن سهل الخراساني عن البزار","سماك بن حرب عن عبد الرحمن بن عبد الله عن أبيه"
"2028","[5/385]      عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ  عَنْ أَبِيهِ  2018  -  حَدَّثَنَا  أَحْمَدُ بْنُ أَبَانَ الْقُرَشِيُّ ، قَالَ:  نَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ.","","Musnad al-Bazzar 2018","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن عبد الملك بن عمير القبطي عن سفيان بن عيينة عن أحمد بن أبان القرشي عن البزار","عبد الملك بن عمير عن عبد الرحمن بن عبد الله عن أبيه"
"2029","2019  -  وَحَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  مِهْرَانُ بْنُ أَبِي عُمَرَ ، قَالَ:  نَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ قَالَ: أُرَاهُ  عَنْ  أَبِيهِ  رَفَعَهُ  قَالَ:  نَضَّرَ  اللهُ امْرَأً سَمِعَ مِنَّا حَدِيثًا فَبَلَّغَهُ كَمَا سَمِعَهُ ،  فَرُبَّ مُبَلَّغٍ أَوْعَى مِنْ سَامِعٍ  .         [5/386]      وَحَدِيثُ  إِسْمَاعِيلَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَيْرٍ  لَا نَعْلَمُ أَحَدًا  أَسْنَدَهُ  إِلَّا  مِهْرَانُ  عَنْهُ .","","Musnad al-Bazzar 2019","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن عبد الملك بن عمير القبطي عن إسماعيل بن أبي خالد عن مهران بن أبي عمر العطار عن يوسف بن موسى بن راشد عن البزار","عبد الملك بن عمير عن عبد الرحمن بن عبد الله عن أبيه"
"2030","2020  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  وَهْبُ بْنُ جَرِيرٍ ، قَالَ:  نَا  أَبِي  ، قَالَ:  سَمِعْتُ  عَبْدَ الْمَلِكِ بْنَ عُمَيْرٍ  يُحَدِّثُ ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  لَا تَرْجِعُوا بَعْدِي  كُفَّارًا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  .  وَهَذَا الْحَدِيثُ  لَا نَحْفَظُهُ  عَنْ  عَبْدِ اللهِ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2020","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن عبد الملك بن عمير القبطي عن جرير بن حازم عن وهب بن جرير بن حازم عن أبو موسى الزمن عن البزار","عبد الملك بن عمير عن عبد الرحمن بن عبد الله عن أبيه"
"2031","2021  -  حَدَّثَنَا  عَلِيُّ بْنُ نَصْرٍ ، قَالَ:  نَا  وَهْبُ بْنُ جَرِيرٍ ، قَالَ:  نَا  أَبِي  ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  سِبَابُ  الْمُسْلِمِ فُسُوقٌ ، وَقِتَالُهُ  كُفْرٌ  .         [5/387]      وَهَذَا الْكَلَامُ قَدْ رُوِيَ عَنْ  عَبْدِ اللهِ  مِنْ غَيْرِ وَجْهٍ .","","Musnad al-Bazzar 2021","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن عبد الملك بن عمير القبطي عن جرير بن حازم عن وهب بن جرير بن حازم عن علي بن نصر الجهضمي الصغير عن البزار","عبد الملك بن عمير عن عبد الرحمن بن عبد الله عن أبيه"
"2032","[5/388]      مُرَّةُ الْهَمْدَانِيُّ  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  2022  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ:  أَنَا  مُحَمَّدُ بْنُ طَلْحَةَ ،  عَنْ  زُبَيْدٍ ،  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  شَغَلُونَا عَنِ الصَّلَاةِ الْوُسْطَى حَتَّى غَابَتِ الشَّمْسُ ،  مَلَأَ اللهُ قُبُورَهُمْ وَبُيُوتَهُمْ نَارًا  .         [5/389]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2022","","عبد الله بن مسعود عن مرة بن شراحيل عن زبيد بن الحارث اليامي عن محمد بن طلحة بن مصرف الهمداني عن يزيد بن هارون عن أبو موسى الزمن عن البزار","مرة الهمداني عن عبد الله بن مسعود"
"2033","2023  -  حَدَّثَنَا  عُمَرُ بْنُ شَبَّةَ ، قَالَ:  نَا  الْحُسَيْنُ بْنُ حَفْصٍ ، قَالَ:  نَا  سُفْيَانُ يَعْنِي الثَّوْرِيَّ ،  عَنْ  زُبَيْدٍ ،  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِنَّكُمْ مَحْشُورُونَ حُفَاةً عُرَاةً  غُرْلًا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ ،  وَأَحْسَبُ أَنَّ  عُمَرَ بْنَ شَبَّةَ  أَخْطَأَ فِيهِ ؛ لِأَنَّهُ  لَمْ يُتَابِعْهُ عَلَيْهِ  أَحَدٌ ،         [5/390]      وَإِنَّمَا عِنْدَ  الثَّوْرِيِّ  هَذَا الْكَلَامُ ، عَنِ  الْمُغِيرَةِ بْنِ النُّعْمَانِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ  ، عَنِ  ابْنِ عَبَّاسٍ  .  وَأَحْسَبُ أَنْ يَكُونَ دَخَلَ لَهُ  مَتْنُ  حَدِيثٍ فِي  إِسْنَادِ  حَدِيثٍ ، وَلَيْسَ عِنْدَ  الثَّوْرِيِّ ،  عَنْ  زُبَيْدٍ ،  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ  حَدِيثٌ  مُسْنَدٌ  .","","Musnad al-Bazzar 2023","","عبد الله بن مسعود عن مرة بن شراحيل عن زبيد بن الحارث اليامي عن سفيان الثوري عن الحسين بن حفص الهمداني عن عمر بن شبة عن البزار","مرة الهمداني عن عبد الله بن مسعود"
"2034","2024  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، وَالْفَضْلُ بْنُ سَهْلٍ ، قَالَا:  نَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ:  أَنَا  شُعْبَةُ ،  عَنِ  السُّدِّيِّ ،  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ - قَالَ         [5/391]      شُعْبَةُ  :  رَفَعَهُ ،  وَأَنَا  لَا أَرْفَعُهُ  -:  لَوْ أَنَّ رَجُلًا  بِعَدَنِ  أَبْيَنَ أَرَادَهُ بِسُوءٍ أَذَاقَهُ اللهُ مِنْ عَذَابٍ أَلِيمٍ  ، يَعْنِي فِي قَوْلِ اللهِ عَزَّ وَجَلَّ:         {      وَمَنْ يُرِدْ فِيهِ بِإِلْحَادٍ بِظُلْمٍ نُذِقْهُ مِنْ عَذَابٍ أَلِيمٍ         }      .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنْ  شُعْبَةَ  بِهَذَا اللَّفْظِ إِلَّا  يَزِيدُ بْنُ هَارُونَ  .","","Musnad al-Bazzar 2024","","عبد الله بن مسعود عن مرة بن شراحيل عن السدي الكبير عن شعبة بن الحجاج عن يزيد بن هارون عن الفضل بن سهل الخراساني عن البزار","مرة الهمداني عن عبد الله بن مسعود"
"2035","2025  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ:  نَا  مُحَمَّدُ بْنُ عُبَيْدٍ ، قَالَ:  أَنَا  أَبَانُ بْنُ إِسْحَاقَ ،  عَنِ  الصَّبَّاحِ بْنِ مُحَمَّدٍ ،  عَنْ  مُرَّةَ الْهَمْدَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  اسْتَحْيُوا مِنَ اللهِ         [5/392]      حَقَّ الْحَيَاءِ  ، قَالَ: إِنَّا نَسْتَحِي وَالْحَمْدُ لِلهِ ، قَالَ: لَيْسَ ذَاكَ ، وَلَكِنْ مَنِ اسْتَحْيَا مِنَ اللهِ حَقَّ الْحَيَاءِ فَلْيَحْفَظِ الرَّأْسَ وَمَا  وَعَى  ، وَلْيَحْفَظِ الْبَطْنَ وَمَا حَوَى ، وَلْيَذْكُرِ الْمَوْتَ وَالْبَلَاءَ ، فَمَنْ فَعَلَ ذَلِكَ فَقَدِ اسْتَحْيَا مِنَ اللهِ حَقَّ الْحَيَاءِ  .","","Musnad al-Bazzar 2025","","عبد الله بن مسعود عن مرة بن شراحيل عن صباح بن محمد الأحمسي عن أبان بن إسحاق عن محمد بن عبيد بن أبي أمية عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مرة الهمداني عن عبد الله بن مسعود"
"2036","2026  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ:  أَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ، قَالَ:  أَنَا  أَبَانُ بْنُ إِسْحَاقَ ،  عَنِ  الصَّبَّاحِ بْنِ مُحَمَّدٍ ،  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِنَّ اللهَ تَبَارَكَ وَتَعَالَى يُعْطِي الدُّنْيَا مَنْ يُحِبُّ وَمَنْ لَا يُحِبُّ ،  وَلَا يُعْطِي الدِّينَ إِلَّا مَنْ أَحَبَّ ، وَالَّذِي نَفْسِي بِيَدِهِ ، مَا يُسْلِمُ عَبْدٌ حَتَّى يُسْلِمَ قَلْبُهُ ، وَلَا يُؤْمِنُ عَبْدٌ حَتَّى يَأْمَنَ جَارُهُ  بَوَائِقَهُ  ، قَالُوا: وَمَا  بَوَائِقُهُ  ؟ قَالَ: غَشْمُهُ وَظُلْمُهُ ، وَلَا اكْتَسَبَ عَبْدٌ مَالًا حَرَامًا فَتَصَدَّقَ بِهِ فَيُقْبَلُ مِنْهُ ، وَلَا يُنْفِقُهُ فَيُبَارَكُ لَهُ فِيهِ ، وَلَا يَدَعُهُ خَلْفَ ظَهْرِهِ إِلَّا كَانَ زَادَهُ إِلَى النَّارِ ، إِنَّ اللهَ تَبَارَكَ وَتَعَالَى لَا يَمْحُو السَّيِّئَ بِالسَّيِّئِ ، وَلَكِنْ يَمْحُو السَّيِّئَ بِالْحَسَنِ ، إِنَّ الْخَبِيثَ لَا         [5/393]      يَمْحُو الْخَبِيثَ ، وَمَنِ اكْتَسَبَ مَالًا مِنْ غَيْرِ حِلِّهِ فَوَضَعَهُ فِي حَقَّهِ فَإِنَّهُ أَبَرُّ مِنْ ذَلِكَ أَنْ لَا يَسْلُبَ الْيَتِيمَ وَيَكْسُوَ الْأَرْمَلَةَ ، وَمَنِ اكْتَسَبَ مَالًا مِنْ غَيْرِ حِلِّهِ فَوَضَعَهُ فِي غَيْرِ حَقِّهِ فَذَلِكَ الدَّاءُ  الْعُضَالُ  ، وَمَنِ اكْتَسَبَ مَالًا مِنْ حِلِّهِ فَوَضَعَهُ فِي حَقِّهِ ، فَمِثْلُ ذَلِكَ مِثْلُ الْغَيْثِ يَنْزِلُ  ، وَذَكَرَ كَلِمَةً ذَهَبَتْ عَنِّي .  وَأَبَانُ بْنُ إِسْحَاقَ  هَذَا فَرَجُلٌ كُوفِيُّ ،  وَالصَّبَاحُ بْنُ مُحَمَّدٍ         [5/394]      فَلَيْسَ بِالْمَشْهُورِ ،  وَإِنَّمَا ذَكَرْنَاهُ عَلَى مَا فِيهِ مِنَ  الْعِلَّةِ  ؛ لَأَنَّا  لَمْ نَحْفَظْ  كَلَامَهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ ،  وَأَبَانُ بْنُ إِسْحَاقَ  وَقَدْ رَوَى عَنْهُ  عَبْدُ اللهِ بْنُ نُمَيْرٍ  ،  وَمُحَمَّدُ بْنُ عُبَيْدٍ ،  وَيَعْلَى بْنُ عُبَيْدٍ  .","","Musnad al-Bazzar 2026","","عبد الله بن مسعود عن مرة بن شراحيل عن صباح بن محمد الأحمسي عن أبان بن إسحاق عن محمد بن عبيد بن أبي أمية عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مرة الهمداني عن عبد الله بن مسعود"
"2037","2027  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  الْحَسَنُ بْنُ الرَّبِيعِ ، قَالَ:  نَا  أَبُو الْأَحْوَصِ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِنَّ لِلْمَلَكِ  لَمَّةً  ، وَلِلشَّيْطَانِ  لَمَّةً  ،  فَلَمَّةُ  الْمَلَكِ إِيعَادُ الْخَيْرِ وَتَحْذِيرٌ مِنَ الشَّرِّ ،  وَلَمَّةُ  الشَّيْطَانِ إِيعَادُ الشَّرِّ ،  أَحْسَبُهُ قَالَ: وَتَحْذِيرٌ مِنَ الْخَيْرِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ ،  وَقَدْ رَوَاهُ غَيْرُ  أَبِي الْأَحْوَصِ  مَوْقُوفًا  .","","Musnad al-Bazzar 2027","","عبد الله بن مسعود عن مرة بن شراحيل عن عطاء بن السائب عن سلام بن سليم الحنفي عن الحسن بن الربيع البوراني عن يوسف بن موسى بن راشد عن البزار","مرة الهمداني عن عبد الله بن مسعود"
"2038","2028  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ الْأَحْمَسِيُّ ، قَالَ:  نَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِيُّ ،  عَنِ  ابْنِ الْأَصْبَهَانِيِّ أَنَّهُ أَخْبَرَهُ ،  عَنْ  مُرَّةَ ،  عَنْ         [5/395]      عَبْدِ اللهِ قَالَ:  نُعِيَ إِلَيْنَا حَبِيبُنَا وَنَبِيُّنَا بِأَبِي هُوَ وَنَفْسِي لَهُ الْفِدَاءُ قَبْلَ مَوْتِهِ بِسِتٍّ ، فَلَمَّا دَنَا الْفِرَاقَ جَمَعَنَا فِي بَيْتِ أُمِّنَا  عَائِشَةَ  فَنَظَرَ إِلَيْنَا فَدَمَعَتْ عَيْنَاهُ ، ثُمَّ قَالَ:  مَرْحَبًا بِكُمْ وَحَيَّاكُمُ اللهُ ، حَفِظَكُمُ اللهُ ، آوَاكُمُ اللهُ ، نَصَرَكُمُ اللهُ ،  رَفَعَكُمُ اللهُ ، هَدَاكُمُ اللهُ ، رَزَقَكُمُ اللهُ ، وَفَّقَكُمُ اللهُ ، سَلَّمَكُمُ اللهُ ، قَبِلَكُمُ اللهُ ، أُوصِيكُمْ بِتَقْوَى اللهِ ، وَأُوصِي اللهَ بِكُمْ وَأَسْتَخْلِفُهُ عَلَيْكُمْ إِنِّي لَكُمْ نَذِيرٌ مُبِينٌ ، أَنْ لَا تَعْلُوا عَلَى اللهِ فِي عِبَادِهِ وَبِلَادِهِ ، فَإِنَّ اللهَ قَالَ لِي وَلَكُمْ:         {      تِلْكَ الدَّارُ الآخِرَةُ نَجْعَلُهَا لِلَّذِينَ لا يُرِيدُونَ عُلُوًّا فِي الأَرْضِ وَلا فَسَادًا وَالْعَاقِبَةُ لِلْمُتَّقِينَ         }      ، ثُمَّ قَالَ:         {      أَلَيْسَ فِي جَهَنَّمَ مَثْوًى لِلْمُتَكَبِّرِينَ         }      ، ثُمَّ قَالَ: قَدْ دَنَا الْأَجَلُ وَالْمُنْقَلَبُ إِلَى اللهِ ، وَإِلَى  سِدْرَةِ  الْمُنْتَهَى ،  وَإِلَى جَنَّةِ الْمَأْوَى ، وَالْكَأْسِ الْأَوْفَى وَالرَّفِيقِ الْأَعْلَى -  أَحْسَبُهُ - فَقُلْنَا: يَا نَبِيَّ اللهِ ،  فَمَنْ يُغَسِّلُكَ إِذَنْ ؟ قَالَ: رِجَالُ أَهْلِ بَيْتِي الْأَدْنَى فَالْأَدْنَى ، قُلْنَا: فَفِيمَ نُكَفِّنُكَ ؟ قَالَ: فِي ثِيَابِي هَذِهِ إِنْ شِئْتُمْ ، أَوْ فِي  حُلَّةٍ  يَمَنِيَّةٍ ، أَوْ فِي بَيَاضِ  مِصْرَ  ، قَالَ: قُلْنَا: فَمَنْ يُصَلِّي عَلَيْكَ مِنَّا ؟ فَبَكَيْنَا وَبَكَى ، وَقَالَ: مَهْلًا غَفَرَ اللهُ لَكُمْ وَجَزَاكُمْ عَنْ نَبِيِّكُمْ خَيْرًا ، إِذَا غَسَّلْتُمُونِي ثُمَّ وَضَعْتُمُونِي عَلَى سَرِيرِي فِي بَيْتِي هَذَا عَلَى شَفِيرِ قَبْرِي فَاخْرُجُوا عَنِّي سَاعَةً ، فَإِنَّ أَوَّلَ مَنْ يُصَلِّي عَلَيَّ  خَلِيلِي  وَجَلِيسِي  جِبْرِيلُ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ  مِيكَائِيلُ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ  إِسْرَافِيلُ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ  مَلَكُ الْمَوْتِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَعَ جُنُودِهِ ، ثُمَّ الْمَلَائِكَةُ صَلَّى         [5/396]      اللهُ عَلَيْهِمْ بِأَجْمَعِهَا ، ثُمَّ ادْخُلُوا عَلَيَّ  فَوْجًا  فَوْجًا  فَصَلُّوا عَلَيَّ وَسَلِّمُوا تَسْلِيمًا ، وَلَا تُؤْذُونِي بِبَاكِيَةٍ -  أَحْسَبُهُ قَالَ - : وَلَا صَارِخَةٍ  ، وَلَا رَانَّةٍ ، وَلْيَبْدَأْ بِالصَّلَاةِ عَلَيَّ رِجَالُ أَهْلِ بَيْتِي ، ثُمَّ أَنْتُمْ بَعْدُ ، وَأَقْرِئُوا أَنْفُسَكُمْ مِنِّي السَّلَامَ ، وَمَنْ غَابَ مِنْ إِخْوَانِي فَأَبْلِغُوهُ مِنِّي السَّلَامَ ، وَمَنْ دَخَلَ مَعَكُمْ فِي دِينِكُمْ بَعْدِي فَإِنِّي أُشْهِدُكُمْ أَنِّي أَقْرَأُ السَّلَامَ -  أَحْسَبُهُ قَالَ - عَلَيَّ  وَعَلَى كُلِّ مَنْ تَابَعَنِي عَلَى دِينِي مِنْ يَوْمِي إِلَى يَوْمِ الْقِيَامَةِ قُلْنَا: يَا رَسُولِ اللهِ ، فَمَنْ يُدْخِلُكَ قَبْرَكَ مِنَّا ؟ قَالَ: رِجَالُ أَهْلِ بَيْتِي مَعَ مَلَائِكَةٍ كَثِيرَةٍ يَرَوْنَكُمْ مِنْ حَيْثُ لَا تَرَوْنَهُمْ  .  وَهَذَا الْكَلَامُ قَدْ رُوِيَ عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ  مِنْ غَيْرِ وَجْهٍ ،  وَأَسَانِيدُهَا  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ  مُتَقَارِبَةٌ ،  وَعَبْدُ الرَّحْمَنِ بْنُ الْأَصْبَهَانِيِّ  لَمْ يَسْمَعْ هَذَا مِنْ  مُرَّةَ  وَإِنَّمَا هُوَ عَنْ مَنْ أَخْبَرَهُ عَنْ  مُرَّةَ ،  وَلَا أَعْلَمُ أَحَدًا رَوَاهُ عَنْ  عَبْدِ اللهِ  غَيْرُ  مُرَّةَ  .","","Musnad al-Bazzar 2028","","عبد الله بن مسعود عن مرة بن شراحيل عن عبد الرحمن بن عبد الله بن الأصبهاني عن عبد الرحمن بن محمد المحاربي عن محمد بن إسماعيل الأحمسي عن البزار","مرة الهمداني عن عبد الله بن مسعود"
"2039","[5/397]      عَبْدُ الرَّحْمَنِ بْنُ أَبِي عَلْقَمَةَ الثَّقَفِيُّ  عَنْ  عَبْدِ اللهِ  2029  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  جَامِعِ بْنِ شَدَّادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي عَلْقَمَةَ قَالَ:  سَمِعْتُ  عَبْدَ اللهِ بْنَ مَسْعُودٍ قَالَ:  أَقْبَلْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ  الْحُدَيْبِيَةِ  فَذَكَرَ أَنَّهُمْ نَزَلُوا  دَهَاسًا  مِنَ الْأَرْضِ  -  وَالدَّهَاسُ  الرَّمْلُ  - فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: مَنْ يَكْلَؤُنَا اللَّيْلَةَ ؟ فَقَالَ  بِلَالٌ  : أَنَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: إِذًا تَنَمْ أَوْ نَنَمْ ، قَالَ: فَنَامُوا حَتَّى طَلَعَتِ الشَّمْسُ فَاسْتَيْقَظَ نَاسٌ فِيهِمْ  فُلَانٌ  وَفُلَانٌ ،  وَفِيهِمْ  عُمَرُ  قَالَ: فَقُلْنَا: اهْضِبُوا -  يَعْنِي تَكَلَّمُوا  - فَاسْتَيْقَظَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ: افْعَلُوا كَمَا كُنْتُمْ تَفْعَلُونَ ، قَالَ: فَفَعَلْنَا ، قَالَ: فَكَذَلِكَ افْعَلُوا بِمَنْ نَامَ أَوْ نَسِيَ ، قَالَ: وَضَلَّتْ نَاقَةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَطَلَبْتُهَا ، فَوَجَدْتُ حَبْلَهَا قَدْ تَعَلَّقَ بِشَجَرَةٍ ، فَجِئْتُ بِهَا إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَرَكِبَ فَسِرْنَا ، قَالَ: وَكَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا نَزَلَ عَلَيْهِ الْوَحْيُ اشْتَدَّ ذَلِكَ عَلَيْهِ وَعَرَفْنَا ذَاكَ فِيهِ ، قَالَ: فَتَنَحَّى مُنْتَبِذًا خَلْفَنَا ، قَالَ: وَجَعَلَ يُغَطِّي         [5/398]      رَأْسَهُ وَيَشْتَدُّ ذَلِكَ عَلَيْهِ حَتَّى عَرَفْنَا أَنَّهُ قَدْ أُنْزِلَ عَلَيْهِ ، فَأَتَانَا فَأَخْبَرَنَا: أَنَّهُ قَدْ أُنْزِلَ عَلَيْهِ         {      إِنَّا فَتَحْنَا لَكَ فَتْحًا مُبِينًا         }      .  وَهَذَا الْحَدِيثُ بِهَذَا الْحَرْفِ  لَا نَحْفَظُهُ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2029","","عبد الله بن مسعود عن عبد الرحمن بن علقمة الثقفي عن جامع بن شداد عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","عبد الرحمن بن أبي علقمة الثقفي عن عبد الله"
"2040","2030  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ:  أَنَا  يَحْيَى بْنُ آدَمَ ، قَالَ:  نَا  الْحَسَنُ بْنُ         [5/399]      ثَابِتٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْوَلِيدِ ،  عَنْ  جَامِعِ بْنِ شَدَّادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ:  كَانَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيْلَةَ نَامَ عَنِ الصَّلَاةِ  حَتَّى طَلَعَتِ الشَّمْسُ حَادِيَانَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2030","","عبد الله بن مسعود عن عبد الرحمن بن علقمة الثقفي عن جامع بن شداد عن عبد الله بن الوليد بن عبد الله المزني عن الحسن بن ثابت الأحول عن يحيى بن آدم عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","عبد الرحمن بن أبي علقمة الثقفي عن عبد الله"
"2041","[5/400]      عَبْدُ اللهِ بْنُ الْحَارِثِ  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  2031  -  حَدَّثَنَا  بِشْرُ بْنُ مُعَاذٍ الْعَقَدِيُّ ، وَالْحَسَنُ بْنُ عَرَفَةَ ، قَالَا:  نَا  خَلَفُ بْنُ خَلِيفَةَ ، قَالَ:  نَا  حُمَيْدٌ الْأَعْرَجُ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  يَوْمَ كَلَّمَ اللهُ  مُوسَى  كَانَتْ عَلَيْهِ جُبَّةُ صُوفٍ ،  وَكِسَاءُ صُوفٍ ، وَسَرَاوِيلُ صُوفٍ ، وَكُمَّةُ صُوفٍ ، وَنِعَالٌ مِنْ جِلْدِ حِمَارٍ غَيْرِ ذَكِيٍّ  .         [5/401]      قَالَ أَبُو بَكْرٍ :  وَاللَّفْظُ لَفْظُ  بِشْرِ بْنِ مُعَاذٍ  ، وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  إِلَّا بِهَذَا  الْإِسْنَادِ ،  وَلَا نَعْلَمُ رَوَاهُ إِلَّا  خَلَفُ بْنُ خَلِيفَةَ  .","","Musnad al-Bazzar 2031","","عبد الله بن مسعود عن عبد الله بن الحارث النجراني عن حميد الأعرج الملائي عن خلف بن خليفة الأشجعي عن الحسن بن عرفة العبدي عن البزار","عبد الله بن الحارث عن عبد الله بن مسعود"
"2042","2032  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَرَفَةَ ، قَالَ:  نَا  خَلَفُ بْنُ خَلِيفَةَ ، قَالَ:  نَا  حُمَيْدٌ الْأَعْرَجُ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِنَّكَ لَتَنْظُرُ إِلَى الطَّيْرِ فِي الْجَنَّةِ فَتَشْتَهِيهِ  فَيَجِيءُ مَشْوِيًّا بَيْنَ يَدَيْكَ  .         [5/402]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى إِلَّا عَنْ  عَبْدِ اللهِ ،  وَلَا نَعْلَمُ لَهُ طَرِيقًا عَنْ  عَبْدِ اللهِ  إِلَّا هَذَا الطَّرِيقَ ،  وَحُمَيْدٌ الْأَعْرَجُ  هَذَا رَجُلٌ كُوفِيُّ ، لَيْسَ  بِحُمَيْدٍ الْمَكِّيِّ  الَّذِي رَوَى عَنْ  مُجَاهِدٍ ،  وَلَا نَعْلَمُهُ يَرْوِي إِلَّا عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ  وَهُوَ  حُمَيْدُ بْنُ عَطَاءٍ  .","","Musnad al-Bazzar 2032","","عبد الله بن مسعود عن عبد الله بن الحارث النجراني عن حميد الأعرج الملائي عن خلف بن خليفة الأشجعي عن الحسن بن عرفة العبدي عن البزار","عبد الله بن الحارث عن عبد الله بن مسعود"
"2043","2033  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُعَاوِيَةَ بْنِ مَالِجٍ ، قَالَ:  نَا  خَلَفُ بْنُ خَلِيفَةَ ،  عَنْ  حُمَيْدٍ الْأَعْرَجِ وَهُوَ ابْنُ عَطَاءٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ:  لَمَّا نَزَلَتْ         {      مَنْ ذَا الَّذِي يُقْرِضُ اللهَ قَرْضًا حَسَنًا         }      قَالَ  أَبُو الدَّحْدَاحِ  : يَا رَسُولَ اللهِ ، وَإِنَّ اللهَ يُرِيدُ مِنَّا الْقَرْضَ ؟ قَالَ:  نَعَمْ يَا  أَبَا الدَّحْدَاحِ  ، قَالَ: فَإِنِّي قَدْ أَقْرَضْتُ رَبِّي حَائِطِي ، حَائِطًا فِيهِ سِتُّمِائَةِ نَخْلَةٍ ، ثُمَّ جَاءَ يَمْشِي حَتَّى أَتَى الْحَائِطَ وَفِيهِ  أُمُّ الدَّحْدَاحِ  فِي عِيَالِهَا فَنَادَاهَا: يَا  أُمَّ الدَّحْدَاحِ ،  قَالَتْ: لَبَّيْكَ ، قَالَ: اخْرُجِي ، فَإِنِّي أَقْرَضْتُ رَبِّي حَائِطًا فِيهِ سِتُّمِائَةِ نَخْلَةٍ  .         [5/403]      وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنْ عَبْدِ اللهِ إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ ،  وَلَا نَعْلَمُ رَوَاهُ عَنْ  حُمَيْدٍ  إِلَّا  خَلَفُ بْنُ خَلِيفَةَ  .","","Musnad al-Bazzar 2033","","عبد الله بن مسعود عن عبد الله بن الحارث النجراني عن حميد الأعرج الملائي عن خلف بن خليفة الأشجعي عن محمد بن معاوية بن يزيد بن مالج الأنماطي عن البزار","عبد الله بن الحارث عن عبد الله بن مسعود"
"2044","2034  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، وَإِبْرَاهِيمُ بْنُ زِيَادٍ ، قَالَا:  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ:  نَا  حُمَيْدٌ الْأَعْرَجُ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ:  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ فِي سُجُودِهِ: سَجَدَ لَكَ سَوَادِي وَخَيَالِي ،  وَآمَنَ بِكَ فُؤَادِي ،  أَبُوءُ  بِنِعْمَتِكَ عَلَيَّ ، هَذِهِ يَدَايَ  وَمَا جَنَيْتُ عَلَى نَفْسِي أَوْ بِمَا جَنَيْتُ عَلَى نَفْسِي  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَقَدْ رُوِيَ نَحْوٌ مِنْ هَذَا الْكَلَامِ بِغَيْرِ هَذَا اللَّفْظِ عَنْ غَيْرِ  عَبْدِ اللهِ  .","","Musnad al-Bazzar 2034","","عبد الله بن مسعود عن عبد الله بن الحارث النجراني عن حميد الأعرج الملائي عن عبيد الله بن موسى عن إبراهيم بن زياد الصائغ عن البزار","عبد الله بن الحارث عن عبد الله بن مسعود"
"2045","2035  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الصَّبَّاحِ الْعَطَّارُ ، قَالَ:  نَا  جَارِيَةُ بْنُ هَرِمٍ ، قَالَ:         [5/404]      نَا  حُمَيْدٌ الْأَعْرَجُ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  رَفَعَهُ  قَالَ:  رُبَّ ذِي  طِمْرَيْنِ  لَا  يُؤْبَهُ  ،  لَوْ أَقْسَمَ عَلَى اللهِ  لَأَبَرَّهُ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2035","","عبد الله بن مسعود عن عبد الله بن الحارث النجراني عن حميد الأعرج الملائي عن جارية بن هرم الفقيمي عن عبد الله بن الصباح المربدي عن البزار","عبد الله بن الحارث عن عبد الله بن مسعود"
"2046","2036  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الصَّبَّاحِ ، قَالَ:  نَا  جَارِيَةُ بْنُ هَرِمٍ ، قَالَ:  نَا  حُمَيْدٌ الْأَعْرَجُ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَعِدَ الْمِنْبَرَ فَقَالَ: آمِينَ ، آمِينَ ، آمِينَ  ثُمَّ ذَكَرَ الْحَدِيثَ.","","Musnad al-Bazzar 2036","","عبد الله بن مسعود عن عبد الله بن الحارث النجراني عن حميد الأعرج الملائي عن جارية بن هرم الفقيمي عن عبد الله بن الصباح المربدي عن البزار","عبد الله بن الحارث عن عبد الله بن مسعود"
"2047","[5/405]      عُمَيْرُ بْنُ سَعِيدٍ  عَنْ  عَبْدِ اللهِ  2037  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ بْنِ الْوَلِيدِ الْكِنْدِيُّ ، قَالَ:  نَا  عَبْدُ اللهِ بْنُ زِيَادٍ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عُمَيْرِ بْنِ سَعِيدٍ  عَنْ  عَبْدِ اللهِ قَالَ:  كُنَّا نَقُولُ فِي الصَّلَاةِ: السَّلَامُ عَلَى اللهِ ، السَّلَامُ عَلَى فُلَانٍ وَفُلَانٍ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِنَّ اللهَ هُوَ السَّلَامُ فَقُولُوا:  التَّحِيَّاتُ  لِلهِ وَالصَّلَوَاتُ  وَالطَّيِّبَاتُ  ،  السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ ، السَّلَامُ عَلَيْنَا وَعَلَى عِبَادِ اللهِ الصَّالِحِينَ ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ  .  وَلَا نَعْلَمُ رَوَى  عُمَيْرُ بْنُ سَعِيدٍ ،  عَنْ  عَبْدِ اللهِ  إِلَّا هَذَا الْحَدِيثَ ،  وَرَوَاهُ غَيْرُ وَاحِدٍ ، عَنِ  الْحَجَّاجِ ،  عَنْ  عُمَيْرِ بْنِ سَعِيدٍ ،  عَنْ  عَبْدِ اللهِ  مَوْقُوفًا  .","","Musnad al-Bazzar 2037","","عبد الله بن مسعود عن عمير بن سعيد الصهباني عن حجاج بن أرطاة عن عبد الله بن زياد عن محمد بن عمر بن الوليد الكندي عن البزار","عمير بن سعيد عن عبد الله"
"2048","[5/406]      زَيْدُ بْنُ زَائِدٍ  عَنْ  عَبْدِ اللهِ  2038  -  حَدَّثَنَا  إِسْحَاقُ بْنُ مُحَمَّدِ بْنِ سَلَمَةَ السُّكَّرِيُّ ، وَمُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ، قَالَا:  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ:  نَا  إِسْرَائِيلُ ،  عَنْ  إِسْمَاعِيلَ السُّدِّيِّ ،  عَنِ  الْوَلِيدِ بْنِ أَبِي هِشَامٍ ،  عَنْ  زَيْدِ بْنِ زَائِدٍ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  لَا يُبَلِّغُنِي أَحَدٌ مِنْكُمْ عَنْ أَحَدٍ مِنْ أَصْحَابِي شَيْئًا ،  فَإِنِّي أُحِبُّ أَنْ أَخْرُجَ إِلَيْكُمْ وَأَنَا سَلِيمُ الصَّدْرِ  .         [5/407]      وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا  عَبْدُ اللهِ بْنُ مَسْعُودٍ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2038","","عبد الله بن مسعود عن زيد بن زائدة عن الوليد بن هشام الهمداني عن السدي الكبير عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن إسحاق بن محمد بن سلمة السكري عن البزار","زيد بن زائد عن عبد الله"
"2049","[5/408]      أَبُو حَيَّانَ  عَنْ  عَبْدِ اللهِ  2039  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  جَرِيرٌ ،  عَنْ  حُصَيْنٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنْ  أَبِي حَيَّانَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ.","","Musnad al-Bazzar 2039","","عبد الله بن مسعود عن منذر الأشجعي ختن هلال بن يساف عن هلال بن يساف الأشجعي عن حصين بن عبد الرحمن السلمي عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","أبو حيان عن عبد الله"
"2050","2040  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ يَزِيدَ بْنِ الرَّوَّاسِ ، قَالَ:  نَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  حُصَيْنٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنْ  أَبِي حَيَّانَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ:  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: اقْرَأْ عَلَيَّ  قُلْتُ: أَقْرَأُ عَلَيْكَ وَعَلَيْكَ أُنْزِلَ  ثُمَّ ذَكَرَ الْحَدِيثَ.","","Musnad al-Bazzar 2040","","عبد الله بن مسعود عن منذر الأشجعي ختن هلال بن يساف عن هلال بن يساف الأشجعي عن حصين بن عبد الرحمن السلمي عن عبد الله بن إدريس الأودي عن محمد بن يزيد بن الرواس عن البزار","أبو حيان عن عبد الله"
"2051","[5/409]      كُرْدُوسُ بْنُ عَبَّاسٍ  عَنْ  عَبْدِ اللهِ  2041  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  كُرْدُوسٍ الثَّعْلَبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ:  مَرَّ الْمَلَأُ مِنْ  قُرَيْشٍ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعِنْدَهُ  صُهَيْبٌ ،  وَبِلَالٌ ،  وَعَمَّارٌ ،  وَخَبَّابٌ  وَنَحْوُهُمْ مِنْ ضُعَفَاءِ الْمُسْلِمِينَ ،  فَقَالُوا: يَا  مُحَمَّدُ ،  اطْرُدْهُمْ ، أَرَضِيتَ هَؤُلَاءِ مِنْ قَوْمِكَ ، أَفَنَحْنُ نَكُونُ تَبَعًا لِهَؤُلَاءِ الَّذِينَ مَنَّ اللهُ عَلَيْهِمْ مِنْ بَيْنِنَا ، فَلَعَلَّ إِنْ طَرَدْتَهُمْ أَنْ نَأْتِيَكَ ، قَالَ: فَنَزَلَتْ هَذِهِ الْآيَةُ:         {      وَأَنْذِرْ بِهِ الَّذِينَ يَخَافُونَ أَنْ يُحْشَرُوا إِلَى رَبِّهِمْ لَيْسَ لَهُمْ مِنْ دُونِهِ وَلِيٌّ وَلا شَفِيعٌ لَعَلَّهُمْ يَتَّقُونَ             *          وَلا تَطْرُدِ الَّذِينَ يَدْعُونَ رَبَّهُمْ بِالْغَدَاةِ وَالْعَشِيِّ يُرِيدُونَ وَجْهَهُ مَا عَلَيْكَ مِنْ حِسَابِهِمْ مِنْ شَيْءٍ وَمَا مِنْ حِسَابِكَ عَلَيْهِمْ مِنْ شَيْءٍ فَتَطْرُدَهُمْ فَتَكُونَ مِنَ الظَّالِمِينَ         }      .         [5/410]      وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2041","","عبد الله بن مسعود عن كردوس بن العباس الغطفاني عن أشعث بن سوار عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","كردوس بن عباس عن عبد الله"
"2052","[5/411]      الرَّبِيعُ بْنُ عَمِيلَةَ  عَنْ  عَبْدِ اللهِ  2042  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ الْأَهْوَازِيُّ ، قَالَ:  نَا  أَبُو أَحْمَدَ ، قَالَ:  نَا  شَرِيكٌ ،  عَنِ  الرُّكَيْنِ بْنِ الرَّبِيعِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ  رَفَعَهُ  قَالَ:  إِنَّ الرِّبَا وَإِنْ كَثُرَ فَإِنَّهُ يَرْجِعُ إِلَى  قُلٍّ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُ رَوَاهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا  عَبْدُ اللهِ بْنُ مَسْعُودٍ  .","","Musnad al-Bazzar 2042","","عبد الله بن مسعود عن الربيع بن عميلة الفزاري عن ركين بن الربيع الفزاري عن شريك بن عبد الله النخعي عن محمد بن عبد الله بن الزبير عن أحمد بن إسحاق بن عيسى الأهوازي عن البزار","الربيع بن عميلة عن عبد الله"
"2053","[5/412]      الْهُزَيْلُ بْنُ شُرَحْبِيلَ  عَنْ  عَبْدِ اللهِ  2043  -  حَدَّثَنَا  مُوسَى بْنُ عَبْدِ اللهِ الْخُزَاعِيُّ ، قَالَ:  نَا  يَعْقُوبُ بْنُ إِسْحَاقَ ، قَالَ:  نَا  شُعْبَةُ ، وَسُفْيَانُ الثَّوْرِيُّ ،  عَنْ  أَبِي قَيْسٍ ،  عَنِ  الْهُزَيْلِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فِي ابْنَةٍ ، وَابْنَةِ ابْنٍ ، وَأُخْتٍ لِأَبٍ وَأُمٍّ ، لِلِابْنَةِ النِّصْفُ ،  وَلِابْنَةِ الِابْنِ السُّدُسُ تَكْمِلَةُ الثُّلُثَيْنِ ، وَمَا بَقِيَ فَلِلْأُخْتِ لِلْأَبِ وَالْأُمِّ  .","","Musnad al-Bazzar 2043","","عبد الله بن مسعود عن هزيل بن شرحبيل الأودي عن عبد الرحمن بن ثروان الأودي عن سفيان الثوري عن يعقوب بن إسحاق بن زيد الحضرمي عن موسى بن عبد الله بن موسى الطلحي عن البزار","الهزيل بن شرحبيل عن عبد الله"
"2054","2044  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ، قَالَ:  نَا  مِنْجَابٌ ،  عَنْ  عَلِيِّ بْنِ مُسْهِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي قَيْسٍ ،  عَنِ  الْهُزَيْلِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بِنَحْوِهِ.         [5/413]      وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا بِهَذَا  الْإِسْنَادِ ،  عَنْ  عَبْدِ اللهِ  عَنْهُ  .","","Musnad al-Bazzar 2044","","عبد الله بن مسعود عن هزيل بن شرحبيل الأودي عن عبد الرحمن بن ثروان الأودي عن الأعمش عن علي بن مسهر القرشي عن منجاب بن الحارث التميمي عن محمد بن عثمان بن كرامة الوراق عن البزار","الهزيل بن شرحبيل عن عبد الله"
"2055","2045  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ:  نَا  قَبِيصَةُ بْنُ عُقْبَةَ ، قَالَ:  نَا  سُفْيَانُ ،         [5/414]      عَنْ  أَبِي قَيْسٍ ،  عَنِ  الْهُزَيْلِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: أَنَّهُ  لَعَنَ  الْوَاشِمَةَ  وَالْمُسْتَوْشِمَةَ ،  وَالْوَاصِلَةَ  وَالْمُسْتَوْصِلَةَ  .","","Musnad al-Bazzar 2045","","عبد الله بن مسعود عن هزيل بن شرحبيل الأودي عن عبد الرحمن بن ثروان الأودي عن سفيان الثوري عن قبيصة بن عقبة السوائي عن محمد بن معمر بن ربعي البحراني عن البزار","الهزيل بن شرحبيل عن عبد الله"
"2056","2046  -  حَدَّثَنَا  أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ ، قَالَ:  نَا  بَكْرُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ:  نَا  عِيسَى بْنُ الْمُخْتَارِ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  أَبِي قَيْسٍ ،  عَنِ  الْهُزَيْلِ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَمَعَ بَيْنَ الصَّلَاتَيْنِ فِي السَّفَرِ  .         [5/415]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2046","","عبد الله بن مسعود عن هزيل بن شرحبيل الأودي عن عبد الرحمن بن ثروان الأودي عن محمد بن عبد الرحمن بن أبي ليلى عن عيسى بن المختار الأنصاري عن بكر بن عبد الرحمن الأنصاري عن أحمد بن عثمان بن حكيم عن البزار","الهزيل بن شرحبيل عن عبد الله"
"2057","2047  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ:  نَا  أَبُو بَكْرٍ الْحَنَفِيُّ ، قَالَ:  نَا  مُحَمَّدُ بْنُ عُبَيْدِ اللهِ ،  عَنْ  أَبِي قَيْسٍ ،  عَنِ  الْهُزَيْلِ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّ رَجُلًا أَوْصَى لِرَجُلٍ بِسَهْمٍ مِنْ مَالِهِ  فَجَعَلَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ السُّدُسَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ يُرْوَى كَلَامُهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ ،  وَأَبُو قَيْسٍ  فَلَيْسَ بِالْقَوِيِّ ،  وَقَدْ رَوَى عَنْهُ  شُعْبَةُ  وَالثَّوْرِيُّ ،  وَالْأَعْمَشُ  وَغَيْرُهُمْ  .","","Musnad al-Bazzar 2047","","عبد الله بن مسعود عن هزيل بن شرحبيل الأودي عن عبد الرحمن بن ثروان الأودي عن محمد بن عبيد الله بن أبي سليمان العرزمي عن عبد الكبير بن عبد المجيد الحنفي عن إسماعيل بن مسعود الجحدري عن البزار","الهزيل بن شرحبيل عن عبد الله"
"2058","2048  -  حَدَّثَنَا  بِشْرُ بْنُ آدَمَ ، وَإِبْرَاهِيمُ بْنُ الْمُسْتَمِرِّ ، قَالَا:  نَا  عَمْرُو بْنُ عَاصِمٍ ، قَالَ:  نَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ:  حَدَّثَنِي  أَبِي  ،  عَنْ         [5/416]      لَيْثٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ ثَرْوَانَ ،  عَنْ  هُزَيْلٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  أَنْتُمْ أَشْبَهُ الْأُمَمِ  بِبَنِي إِسْرَائِيلَ  سَمْتًا  وَسِمَةً  وَهَدْيًا  .  وَلَا نَعْلَمُ رَوَى  أَبُو قَيْسٍ ،  عَنْ  هُزَيْلٍ ،  عَنْ  عَبْدِ اللهِ  إِلَّا هَذِهِ الْأَحَادِيثَ  مَرْفُوعَةً  .","","Musnad al-Bazzar 2048","","عبد الله بن مسعود عن هزيل بن شرحبيل الأودي عن عبد الرحمن بن ثروان الأودي عن ليث بن أبي سليم عن سليمان بن طرخان عن معتمر بن سليمان عن عمرو بن عاصم الكلابي عن إبراهيم بن المستمر العروقي عن البزار","الهزيل بن شرحبيل عن عبد الله"
"2059","[5/417]      أَبُو الْأَحْوَصِ  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  سَلَمَةُ بْنُ كُهَيْلٍ  عَنْهُ  2049  -  حَدَّثَنَا  عَلِيُّ بْنُ حَرْبٍ الْمَوْصِلِيُّ ، قَالَ:  نَا  الْقَاسِمُ بْنُ يَزِيدَ الْجَرْمِيُّ ،  عَنْ  سُفْيَانَ يَعْنِي الثَّوْرِيَّ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  وَعَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  قَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، نَامَ  فُلَانٌ  الْبَارِحَةَ حَتَّى أَصْبَحَ ، قَالَ:  ذَاكَ رَجُلٌ  بَالَ  الشَّيْطَانُ فِي أُذُنَيْهِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الثَّوْرِيِّ ،  عَنْ  سَلَمَةَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ  إِلَّا  الْقَاسِمُ بْنُ يَزِيدَ ،  وَرَجُلٌ آخَرُ.","","Musnad al-Bazzar 2049","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن القاسم بن يزيد الجرمي عن علي بن حرب الطائي عن البزار","سلمة بن كهيل عنه"
"2060","2050  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ بْنِ يَحْيَى بْنِ سَلَمَةَ بْنِ كُهَيْلٍ ، قَالَ:  حَدَّثَنِي  أَبِي إِسْمَاعِيلُ بْنُ يَحْيَى بْنِ سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ:  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُعَلِّمُنَا  التَّشَهُّدَ  فِي الصَّلَاةِ  كَمَا يُعَلِّمُنَا         [5/418]      السُّورَةَ مِنَ الْقُرْآنِ :  التَّحِيَّاتُ  لِلهِ وَالصَّلَوَاتُ  وَالطَّيِّبَاتُ  ، السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ ، السَّلَامُ عَلَيْنَا وَعَلَى عِبَادِ اللهِ الصَّالِحِينَ ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَشْهَدُ أَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى مِنْ حَدِيثِ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ.","","Musnad al-Bazzar 2050","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن سلمة بن كهيل الحضرمي عن يحيى بن سلمة بن كهيل عن إسماعيل بن يحيى بن سلمة بن كهيل الحضرمي عن إبراهيم بن إسماعيل الكهيلى عن البزار","سلمة بن كهيل عنه"
"2061","2051  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ ، قَالَ:  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ  ،  عَنْ  سَلَمَةَ ،  عَنْ  أَبِي الْأَحْوَصِ قَالَ:  قَالَ  عَبْدُ اللهِ :  إِنَّمَا هُمَا اثْنَتَانِ: الْهَدْيُ وَالْكَلَامُ ، فَأَحْسَنُ الْكَلَامِ كَلَامُ اللهِ ،  وَأَحْسَنُ  الْهَدْيِ  هَدْيُ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَشَرُّ الْأُمُورِ  مُحْدَثَاتُهَا  ، وَكُلُّ مَا هُوَ آتٍ قَرِيبٌ  .","","Musnad al-Bazzar 2051","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن سلمة بن كهيل الحضرمي عن يحيى بن سلمة بن كهيل عن إسماعيل بن يحيى بن سلمة بن كهيل الحضرمي عن إبراهيم بن إسماعيل الكهيلى عن البزار","سلمة بن كهيل عنه"
"2062","[5/419]      ابْنُ أَبِي الْهُذَيْلِ  عَنْ  أَبِي الْأَحْوَصِ  عَنْ  عَبْدِ اللهِ  2052  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  جَرِيرٌ ،  عَنِ  الْمُغِيرَةِ ،  عَنْ  إِسْمَاعِيلَ بْنِ رَجَاءٍ ،  عَنِ  ابْنِ أَبِي الْهُذَيْلِ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِنِّي أَبْرَأُ إِلَى كُلِّ  خِلٍّ  مِنْ خِلِّهِ ،  وَلَوْ كُنْتُ مُتَّخِذًا  خَلِيلًا  لَاتَّخَذْتُ  أَبَا بَكْرٍ  خَلِيلًا  .  وَلَا نَعْلَمُ رَوَى  ابْنُ أَبِي الْهُذَيْلِ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ  إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 2052","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن عبد الله بن أبي الهذيل الغنوي عن إسماعيل بن رجاء الزبيدي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","ابن أبي الهذيل عن أبي الأحوص عن عبد الله"
"2063","[5/420]      عَبْدُ اللهِ بْنُ مُرَّةَ  عَنْ  أَبِي الْأَحْوَصِ  عَنْ  عَبْدِ اللهِ  2053  -  حَدَّثَنَا  عَمْرُو بْنُ عَبْدِ اللهِ الْأَوْدِيُّ ، قَالَ:  نَا  وَكِيعٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  أَلَا إِنِّي أَبْرَأُ إِلَى كُلِّ  خَلِيلٍ  مِنْ خِلِّهِ ،  وَلَوْ كُنْتُ مُتَّخِذًا  خَلِيلًا  لَاتَّخَذْتُ  أَبَا بَكْرٍ  خَلِيلًا ،  وَلَكِنَّ صَاحِبَكُمْ  خَلِيلُ  اللهِ ، يَعْنِي نَفْسَهُ  .         [5/421]      وَلَا نَعْلَمُ رَوَى  عَبْدُ اللهِ بْنُ مُرَّةَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ  إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 2053","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن عبد الله بن مرة الخارفي عن الأعمش عن وكيع بن الجراح عن عمرو بن عبد الله بن حنش عن البزار","عبد الله بن مرة عن أبي الأحوص عن عبد الله"
"2064","[5/422]      عَلِيُّ بْنُ الْأَقْمَرِ  عَنْ  أَبِي الْأَحْوَصِ  عَنْ  عَبْدِ اللهِ  2054  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  عَلِيِّ بْنِ الْأَقْمَرِ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  لَا تَقُومُ السَّاعَةُ إِلَّا عَلَى شِرَارِ النَّاسِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2054","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن علي بن الأقمر عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","علي بن الأقمر عن أبي الأحوص عن عبد الله"
"2065","[5/423]      2055  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حَرْبٍ الْوَاسِطِيُّ ، قَالَ:  نَا  عَبِيدَةُ بْنُ حُمَيْدٍ ، قَالَ:  نَا  أَبُو الزَّعْرَاءِ ،  عَنْ  أَبِي الْأَحْوَصِ قَالَ:  سَمِعْتُ  عَبْدَ اللهِ بْنَ مَسْعُودٍ يَقُولُ:  إِنَّ أَصْدَقَ الْحَدِيثِ كِتَابُ اللهِ ،  وَأَحْسَنَ  الْهَدْيِ  هَدْيُ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَشَرَّ الْأُمُورِ  مُحْدَثَاتُهَا  ، وَكُلَّ  مُحْدَثَةٍ  ضَلَالَةٌ ، فَعَلَيْكُمْ بِهَذَا الْقُرْآنِ ، فَإِنَّهَا  مَأْدُبَةُ  اللهِ ، فَمَنِ اسْتَطَاعَ مِنْكُمْ أَنْ يَأْخُذَ مِنْ  مَأْدُبَةِ  اللهِ فَلْيَفْعَلْ ، فَإِنَّمَا الْعِلْمُ بِالتَّعَلُّمِ  .","","Musnad al-Bazzar 2055","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن عمرو بن عمرو الجشمي عن عبيدة بن حميد بن صهيب التيمي عن محمد بن حرب النشائي عن البزار","علي بن الأقمر عن أبي الأحوص عن عبد الله"
"2066","2056  -  وَحَدَّثَنَاهُ  إِسْحَاقُ بْنُ بُهْلُولٍ قَالَ:  نَا  الْوَلِيدُ بْنُ الْقَاسِمِ قَالَ:  نَا  زَكَرِيَّا بْنُ أَبِي زَائِدَةَ ،  عَنْ  عَلِيِّ بْنِ الْأَقْمَرِ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ بِنَحْوِهِ.","","Musnad al-Bazzar 2056","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن علي بن الأقمر عن زكريا بن أبي زائدة الوادعي عن الوليد بن القاسم الخبذعي عن إسحاق بن بهلول الأنباري عن البزار","علي بن الأقمر عن أبي الأحوص عن عبد الله"
"2067","[5/424]      عُقْبَةُ بْنُ وَسَّاجٍ  عَنِ  الْأَحْوَصِ  عَنْ  عَبْدِ اللهِ  2057  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَعَمْرُو بْنُ عَلِيٍّ ، قَالَا:  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  عُقْبَةَ بْنِ وَسَّاجٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  فَضْلُ صَلَاةِ الرَّجُلِ فِي الْجَمِيعِ عَلَى صَلَاتِهِ - يَعْنِي وَحْدَهُ - خَمْسَةٌ وَعِشْرُونَ  يَعْنِي خَمْسًا وَعِشْرِينَ صَلَاةً  .  هَكَذَا رَوَاهُ  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  عُقْبَةَ بْنِ وَسَّاجٍ ،  عَنْ  أَبِي الْأَحْوَصِ  ، وَرَوَاهُ  ابْنُ أَبِي عَرُوبَةَ  ، عَنْ  قَتَادَةَ  ، عَنْ  أَبِي الْأَحْوَصِ  ، عَنْ         [5/425]      عَبْدِ اللهِ  ، أَنَّ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  صَلَاةُ الْجَمْعِ تَفْضُلُ عَلَى صَلَاةِ الرَّجُلِ وَحْدَهُ خَمْسَةً وَعِشْرِينَ ضِعْفًا  .","","Musnad al-Bazzar 2057","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن عقبة بن وساج البرساني عن قتادة بن دعامة عن شعبة بن الحجاج عن غندر ربيب شعبة عن الفلاس عن البزار","عقبة بن وساج عن الأحوص عن عبد الله"
"2068","2058  -  حَدَّثَنَا  بِهِ مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  ابْنُ أَبِي عَدِيٍّ ،  عَنْ  سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ .  وَرَوَاهُ  هَمَّامٌ  ، عَنْ  قَتَادَةَ  ، عَنْ  مُوَرِّقٍ  ، عَنْ  أَبِي الْأَحْوَصِ  ، عَنْ  عَبْدِ اللهِ  .","","Musnad al-Bazzar 2058","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن إبراهيم بن أبي عدي القسملي عن أبو موسى الزمن عن البزار","عقبة بن وساج عن الأحوص عن عبد الله"
"2069","[5/426]      مُوَرِّقٌ الْعِجْلِيُّ  عَنْ  أَبِي الْأَحْوَصِ  عَنْ  عَبْدِ اللهِ  2059  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَعَمْرُو بْنُ عَلِيٍّ ، قَالَا:  نَا  أَبُو دَاوُدَ ، قَالَ:  نَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُوَرِّقٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  صَلَاةُ الْجَمِيعِ تَفْضُلُ عَلَى صَلَاةِ الرَّجُلِ وَحْدَهُ أَرْبَعَةً وَعِشْرِينَ ضِعْفًا ،  وَهِيَ الْخَامِسَةُ كُلُّهَا مِثْلُ صَلَاتِهِ  .","","Musnad al-Bazzar 2059","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن مورق العجلي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن أبو داود الطيالسي عن الفلاس عن البزار","مورق العجلي عن أبي الأحوص عن عبد الله"
"2070","2060  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  عَمْرُو بْنُ عَاصِمٍ ، قَالَ:  نَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُوَرِّقٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  صَلَاةُ الْمَرْأَةِ فِي  مَخْدَعِهَا  أَفْضَلُ مِنْ صَلَاتِهَا فِي         [5/427]      بَيْتِهَا ،  وَصَلَاتُهَا فِي بَيْتِهَا أَفْضَلُ مِنْ صَلَاتِهَا فِي حُجْرَتِهَا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى مِنْ حَدِيثِ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2060","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن مورق العجلي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عمرو بن عاصم الكلابي عن أبو موسى الزمن عن البزار","مورق العجلي عن أبي الأحوص عن عبد الله"
"2071","2061  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  عَمْرُو بْنُ عَاصِمٍ ، قَالَ:  نَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُوَرِّقٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  إِنَّ الْمَرْأَةَ  عَوْرَةٌ ،  فَإِذَا خَرَجَتِ اسْتَشْرَفَهَا الشَّيْطَانُ ، وَأَقْرَبُ مَا تَكُونُ مِنْ وَجْهِ رَبِّهَا وَهِيَ فِي قَعْرِ بَيْتِهَا  .         [5/428]","","Musnad al-Bazzar 2061","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن مورق العجلي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عمرو بن عاصم الكلابي عن أبو موسى الزمن عن البزار","مورق العجلي عن أبي الأحوص عن عبد الله"
"2072","2062  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  عَمْرُو بْنُ عَاصِمٍ ، قَالَ:  نَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  ابْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ .  وَحَدِيثُ  مُوَرِّقٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّ الْمَرْأَةَ  عَوْرَةٌ ،  لَا نَعْلَمُ رَوَاهُ عَنْ  قَتَادَةَ  إِلَّا  هَمَّامٌ  .","","Musnad al-Bazzar 2062","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن قتادة بن دعامة عن سليمان بن طرخان عن معتمر بن سليمان عن عمرو بن عاصم الكلابي عن أبو موسى الزمن عن البزار","مورق العجلي عن أبي الأحوص عن عبد الله"
"2073","2063  -  حَدَّثَنَا  الْجَرَّاحُ بْنُ مَخْلَدٍ ، قَالَ:  نَا  عَمْرُو بْنُ عَاصِمٍ ، قَالَ:  نَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُوَرِّقٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  صَلَاةُ الْمَرْأَةِ فِي  مَخْدَعِهَا  أَفْضَلُ مِنْ صَلَاتِهَا فِي بَيْتِهَا ،  وَصَلَاتُهَا فِي بَيْتِهَا أَفْضَلُ مِنْ صَلَاتِهَا فِي حُجْرَتِهَا  .","","Musnad al-Bazzar 2063","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن مورق العجلي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عمرو بن عاصم الكلابي عن الجراح بن مخلد عن البزار","مورق العجلي عن أبي الأحوص عن عبد الله"
"2074","2064  -  وَقَالَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  صَلَاةُ الْوُسْطَى صَلَاةُ الْعَصْرِ  .","","Musnad al-Bazzar 2064","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن مورق العجلي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عمرو بن عاصم الكلابي عن الجراح بن مخلد عن البزار","مورق العجلي عن أبي الأحوص عن عبد الله"
"2075","2065  -  وَقَالَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِنَّ الْمَرْأَةَ  عَوْرَةٌ ،  فَإِذَا خَرَجَتْ مِنْ بَيْتِهَا اسْتَشْرَفَهَا الشَّيْطَانُ  .  وَهَذِهِ الْأَحَادِيثُ أَخْرَجَهَا لَنَا  الْجَرَّاحُ بْنُ مَخْلَدٍ  مِنْ كِتَابٍ         [5/429]      ذَكَرَ أَنَّهُ أَصْلُهُ ، عَنْ  عَمْرِو بْنِ عَاصِمٍ ،  مُدْرَجَةً  بِإِسْنَادٍ  وَاحِدٍ ، فَأَنْكَرْنَا عَلَيْهِ حَدِيثَ صَلَاةُ الْوُسْطَى صَلَاةُ الْعَصْرِ ، وَكَانَ هَذَا الْكَلَامُ فِي وَسَطِ الْأَحَادِيثِ ، وَلَمْ أَرَ أَحَدًا  تَابَعَ  الْجَرَّاحَ  عَلَى هَذِهِ  الرِّوَايَةِ  .","","Musnad al-Bazzar 2065","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن مورق العجلي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عمرو بن عاصم الكلابي عن الجراح بن مخلد عن البزار","مورق العجلي عن أبي الأحوص عن عبد الله"
"2076","[5/430]      أَبُو فَرْوَةَ  عَنْ  أَبِي الْأَحْوَصِ  عَنْ  عَبْدِ اللهِ  2066  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى الصَّنْعَانِيُّ ، وَإِبْرَاهِيمُ بْنُ يُوسُفَ الصَّيْرَفِيُّ ، قَالَا:  نَا  عِمْرَانُ بْنُ عُيَيْنَةَ ، قَالَ:  نَا  أَبُو فَرْوَةَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ قَالَ:  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي يَوْمِ الْجُمُعَةِ:         {      الم             *          تَنْـزِيلُ         }      ، وَ         {      هَلْ أَتَى         }      .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى مِنْ حَدِيثِ  أَبِي فَرْوَةَ ،  عَنْ         [5/431]      أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2066","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن مسلم بن سالم الجهني عن عمران بن عيينة الهلالي عن محمد بن عبد الأعلى القيسي عن البزار","أبو فروة عن أبي الأحوص عن عبد الله"
"2077","2067  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْأَعْلَى الْهَاشِمِيُّ ، قَالَ:  نَا  أَبُو نُعَيْمٍ عَبْدُ الرَّحْمَنِ بْنُ هَانِئٍ ، قَالَ:  نَا  عَبْدُ الْمَلِكِ بْنُ حُسَيْنٍ ،  عَنْ  أَبِي فَرْوَةَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُسَلِّمُ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ  ،  يَعْنِي فِي الصَّلَاةِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى مِنْ حَدِيثِ  أَبِي فَرْوَةَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ هَذَا الْوَجْهِ ،  وَعَبْدُ الْمَلِكِ بْنُ حُسَيْنٍ  هَذَا  فَلَيْسَ بِالْقَوِيِّ ،  وَقَدْ رَوَى عَنْهُ جَمَاعَةٌ وَاخْتَلَفُوا فِي حَدِيثِهِ  .","","Musnad al-Bazzar 2067","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن مسلم بن سالم الجهني عن ابن ذر ، عبد الملك بن الحسين النخعي عن عبد الرحمن بن هانئ الحارثي عن عبد الله بن عبد الأعلى الهاشمي عن البزار","أبو فروة عن أبي الأحوص عن عبد الله"
"2078","[5/432]      عَطَاءُ بْنُ السَّائِبِ  عَنْ  أَبِي الْأَحْوَصِ  عَنْ  عَبْدِ اللهِ  2068  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ حَبِيبٍ ، قَالَ:  نَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ  رَفَعَهُ  قَالَ:  تَفْضُلُ صَلَاةُ الْجَمِيعِ عَلَى صَلَاةِ الرَّجُلِ وَحْدَهُ  بِضْعًا  وَعِشْرِينَ دَرَجَةً  .  وَلَا  نَعْلَمُ  أَسْنَدَ  عَطَاءُ بْنُ السَّائِبِ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ  إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 2068","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن عطاء بن السائب عن محمد بن فضيل بن غزوان عن إسحاق بن إبراهيم الشهيدي عن البزار","عطاء بن السائب عن أبي الأحوص عن عبد الله"
"2079","[5/433]      أَبُو إِسْحَاقَ الْهَمْدَانِيُّ  عَنْ  أَبِي الْأَحْوَصِ  عَنْ  عَبْدِ اللهِ  2069  -  حَدَّثَنَا  أَبُو كُرَيْبٍ ، وَإِبْرَاهِيمُ بْنُ يُوسُفَ ، قَالَا:  نَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  إِنَّ الْإِسْلَامَ بَدَأَ  غَرِيبًا  وَسَيَعُودُ  غَرِيبًا  كَمَا بَدَأَ  فَطُوبَى  لِلْغُرَبَاءِ ، قِيلَ: وَمَنِ الْغُرَبَاءُ ؟ قَالَ:  النُّزَّاعُ  مِنَ الْقَبَائِلِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي         [5/434]      الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ  مُسْنَدًا  إِلَّا  الْأَعْمَشُ ،  وَرَوَاهُ عَنِ  الْأَعْمَشِ  ،  أَبُو خَالِدٍ  ،  وَيُوسُفُ بْنُ خَالِدٍ  وَغَيْرُهُمَا.","","Musnad al-Bazzar 2069","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن الأعمش عن حفص بن غياث النخعي عن إبراهيم بن يوسف الصيرفي عن البزار","أبو إسحاق الهمداني عن أبي الأحوص عن عبد الله"
"2080","2070  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ مُحَمَّدٍ الْعَبْسِيُّ أَبُو شَيْبَةَ ، قَالَ:  نَا  سَعِيدُ بْنُ عَمْرٍو الْأَشْعَثِيُّ ، قَالَ:  نَا  عَبْثَرُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ قَالَ:  عَلَّمَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خُطْبَةَ  التَّشَهُّدِ  ،  وَخُطْبَةَ الْحَاجَةِ  .         [5/435]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الْأَعْمَشِ  إِلَّا  عَبْثَرُ  .","","Musnad al-Bazzar 2070","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن الأعمش عن عبثر بن القاسم الزبيدي عن سعيد بن عمرو بن سهل الأشعثي عن إبراهيم بن عبد الله أبو شيبة العبسي عن البزار","أبو إسحاق الهمداني عن أبي الأحوص عن عبد الله"
"2081","2071  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَزْدَادَ الْخَيَّاطُ الْكُوفِيُّ ، قَالَ:  نَا  عَمْرُو بْنُ عَبْدِ الْغَفَّارِ ، قَالَ:  نَا  الْأَعْمَشُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ قَالَ:  كُنَّا نَعُدُّ فِي الْجَاهِلِيَّةِ أَنَّ الْإِمَّعَةَ هُوَ الرَّجُلُ يُدْعَى  فَيَأْتِي مَعَهُ بِمَنْ لَمْ يُدْعَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي إِسْحَاقَ  بِهَذَا  الْإِسْنَادِ  إِلَّا  عَمْرُو بْنُ عَبْدِ الْغَفَّارِ  .","","Musnad al-Bazzar 2071","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن الأعمش عن عمرو بن عبد الغفار الفقيمي عن أحمد بن يزداد الخياط عن البزار","أبو إسحاق الهمداني عن أبي الأحوص عن عبد الله"
"2082","2072  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  لَوْ كُنْتُ مُتَّخِذًا مِنْ أُمَّتِي  خَلِيلًا  لَاتَّخَذْتُ  أَبَا بَكْرٍ  .  وَهَذَا الْحَدِيثُ قَدْ رُوِيَ مِنْ غَيْرِ وَجْهٍ عَنْ  أَبِي الْأَحْوَصِ  .","","Musnad al-Bazzar 2072","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","أبو إسحاق الهمداني عن أبي الأحوص عن عبد الله"
"2083","[5/436]      2073  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ:  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ:  نَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ:  اللَّهُمَّ أَسْأَلُكَ الْهُدَى وَالتُّقَى وَالْعَفَافَ وَالْغِنَى  .  وَهَذَا الْحَدِيثُ  لَا نَحْفَظُهُ  عَنْ  عَبْدِ اللهِ  إِلَّا مِنْ حَدِيثِ  أَبِي الْأَحْوَصِ  عَنْهُ  .","","Musnad al-Bazzar 2073","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","أبو إسحاق الهمداني عن أبي الأحوص عن عبد الله"
"2084","[5/437]      2074  -  حَدَّثَنَا  زَيْدُ بْنُ أَخْزَمَ الطَّائِيُّ ، قَالَ:  نَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ، قَالَ:  نَا  سُفْيَانُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  مَنْ رَآنِي فِي الْمَنَامِ فَقَدْ رَآنِي  فَإِنَّ الشَّيْطَانَ لَا  يَتَكَوَّنُ  فِي صُورَتِي  .","","Musnad al-Bazzar 2074","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زيد بن أخزم الطائي عن البزار","أبو إسحاق الهمداني عن أبي الأحوص عن عبد الله"
"2085","[5/438]      2075  -  حَدَّثَنَا  عَمْرُو بْنُ عَبْدِ اللهِ الْأَوْدِيُّ ، قَالَ:  نَا  وَكِيعٌ ،  عَنْ  إِسْرَائِيلَ ، وَأَبِيهِ  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ:  اللَّهُمَّ أَعِنِّي عَلَى ذِكْرِكَ وَشُكْرِكَ وَحُسْنِ عِبَادَتِكَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ  بِهَذَا اللَّفْظِ إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2075","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن الجراح بن مليح الرؤاسي والد وكيع عن وكيع بن الجراح عن عمرو بن عبد الله بن حنش عن البزار","أبو إسحاق الهمداني عن أبي الأحوص عن عبد الله"
"2086","2076  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ:  نَا  جَرِيرٌ ، قَالَ:  نَا  إِدْرِيسُ الْأَوْدِيُّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ  رَفَعَهُ  قَالَ:  إِنَّ أَحْسَنَ  الْهَدْيِ  هَدْيُ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَحْسَنَ الْقَصَصِ كِتَابُ اللهِ ،  وَشَرَّ الْأُمُورِ  مُحْدَثَاتُهَا  ، وَكُلَّ  مُحْدَثَةٍ  بِدْعَةٌ ،  وَسِبَابَ  الْمُسْلِمِ فُسُوقٌ ، وَقِتَالَهُ  كُفْرٌ  .         [5/439]      وَلَا نَعْلَمُ رَوَى  إِدْرِيسُ الْأَوْدِيُّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ  حَدِيثًا  مُسْنَدًا  إِلَّا هَذَا الْحَدِيثَ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  إِدْرِيسَ  إِلَّا  جَرِيرٌ ،  وَقَدْ رَوَاهُ  مُحَمَّدُ بْنُ جَعْفَرٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ، عَنْ  أَبِي إِسْحَاقَ  ، عَنْ  أَبِي الْأَحْوَصِ  ، عَنْ  عَبْدِ اللهِ  مُسْنَدًا  .","","Musnad al-Bazzar 2076","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن إدريس بن يزيد الزعافري عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","أبو إسحاق الهمداني عن أبي الأحوص عن عبد الله"
"2087","2077  -  حَدَّثَنَا  سَلْمُ بْنُ جُنَادَةَ ، قَالَ:  نَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ،  فِي قَوْلِ اللهِ عَزَّ وَجَلَّ:         {      لَوْ أَنْفَقْتَ مَا فِي الأَرْضِ جَمِيعًا مَا أَلَّفْتَ بَيْنَ قُلُوبِهِمْ وَلَكِنَّ اللهَ أَلَّفَ بَيْنَهُمْ         }      قَالَ:  نَزَلَتْ فِي الْمُتَحَابِّينَ فِي اللهِ  .         [5/440]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ  إِلَّا  فُضَيْلُ بْنُ غَزْوَانَ  .","","Musnad al-Bazzar 2077","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن فضيل بن غزوان عن محمد بن فضيل بن غزوان عن سلم بن جنادة السوائي عن البزار","أبو إسحاق الهمداني عن أبي الأحوص عن عبد الله"
"2088","2078  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ:  نَا  أَبُو أَحْمَدَ .  2079  -  وَحَدَّثَنَاهُ  خَلَّادُ بْنُ أَسْلَمَ ، قَالَ:  نَا  النَّضْرُ بْنُ شُمَيْلٍ جَمِيعًا ذَكَرَا ذَلِكَ ،  عَنْ  يُونُسَ بْنِ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ قَالَ:  كَانُوا يَقْرَءُونَ خَلْفَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ:  خَلَطْتُمْ عَلَيَّ الْقُرْآنَ  .         [5/441]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ  إِلَّا  يُونُسُ بْنُ أَبِي إِسْحَاقَ  .","","Musnad al-Bazzar 2078","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن النضر بن شميل عن خلاد بن أسلم الصفار عن البزار","أبو إسحاق الهمداني عن أبي الأحوص عن عبد الله"
"2089","2080  -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ سَعْدٍ ، قَالَ:  حَدَّثَنَا  عَمِّي يَعْقُوبُ بْنُ إِبْرَاهِيمَ ، قَالَ:  نَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ،  وَعَنْ  أَبِي إِسْحَاقَ الْهَجَرِيِّ ،  عَنْ  عَبْدِ اللهِ  رَفَعَا الْحَدِيثَ  قَالَ:  إِذَا جَاءَ أَحَدَكُمْ خَادِمُهُ بِطَعَامٍ  فَلْيُطْعِمْهُ مِنْهُ أَوْ فَلْيُنَاوِلْهُ مِنْهُ  .  وَهَذَا الْحَدِيثُ إِنَّمَا يُعْرَفُ مِنْ حَدِيثِ  الْهَجَرِيِّ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ  . وَجَمَعَ  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  عَنْ  شَرِيكٍ ،  عَنْ  أَبِي إِسْحَاقَ الْهَمْدَانِيِّ ،  وَأَبِي إِسْحَاقَ الْهَجَرِيِّ  .","","Musnad al-Bazzar 2080","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن إبراهيم بن مسلم الهجري عن شريك بن عبد الله النخعي عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن عبيد الله بن سعد بن إبراهيم الزهري عن البزار","أبو إسحاق الهمداني عن أبي الأحوص عن عبد الله"
"2090","2081  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ الْبُخَارِيُّ ، قَالَ:  نَا  أَيُّوبُ بْنُ سُلَيْمَانَ بْنِ بِلَالٍ ، قَالَ:  نَا  ابْنُ أَبِي أُوَيْسٍ يَعْنِي أَبَا بَكْرِ بْنَ أَبِي أُوَيْسٍ ،  عَنْ         [5/442]      سُلَيْمَانَ بْنِ بِلَالٍ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ:  أُنْزِلَ الْقُرْآنُ عَلَى سَبْعَةِ  أَحْرُفٍ  ،  لِكُلِّ آيَةٍ مِنْهَا  ظَهْرٌ  وَبَطْنٌ ،  وَنَهَى أَنْ يَسْتَلْقِيَ الرَّجُلُ -  أَحْسَبُهُ قَالَ: فِي الْمَسْجِدِ  - وَيَضَعَ إِحْدَى رِجْلَيْهِ عَلَى الْأُخْرَى  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى إِلَّا مِنْ حَدِيثِ  الْهَجَرِيِّ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ،  وَلَا نَعْلَمُ أَنَّ  ابْنَ عَجْلَانَ  رَوَى عَنِ  الْهَجَرِيِّ  غَيْرَ هَذَا الْحَدِيثِ ، وَلَا نَعْلَمُ أَنَّ هَذَا الْحَدِيثَ يُرْوَى مِنْ حَدِيثِ  ابْنِ عَجْلَانَ ،  عَنْ  أَبِي إِسْحَاقَ  إِلَّا مِنْ هَذَا الْوَجْهِ.","","Musnad al-Bazzar 2081","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن محمد بن عجلان عن سليمان بن بلال القرشي عن عبد الحميد بن أبي أويس الأعشى عن أيوب بن سليمان الخزاعي عن البخاري عن البزار","أبو إسحاق الهمداني عن أبي الأحوص عن عبد الله"
"2091","2082  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى الصَّنْعَانِيُّ ، قَالَ:  نَا  عَبْدُ الرَّزَّاقِ ، قَالَ:  أَنَا  مَعْمَرٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ قَالَ: قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  مَا بَالُ أَقْوَامٍ يَتَخَلَّفُونَ عَنِ الْجُمُعَةِ ،  لَقَدْ هَمَمْتُ         [5/443]      أَنْ آمُرَ رَجُلًا يُصَلِّي بِالنَّاسِ ثُمَّ  أَتَخَلَّفَ  فَأُحَرِّقَ عَلَى قَوْمٍ بُيُوتَهُمْ يَتَخَلَّفُونَ عَنِ الْجُمُعَةِ  .         [5/444]      وَهَذَا الْحَدِيثُ رَوَاهُ عَنْ  أَبِي إِسْحَاقَ  ، عَنْ  أَبِي الْأَحْوَصِ  ، عَنْ  عَبْدِ اللهِ  ،  مَعْمَرٌ  ،  وَزُهَيْرُ بْنُ مُعَاوِيَةَ  .  كَمُلَ السِّفْرُ الْأَوَّلُ مِنْ كِتَابِ الْبَزَّارِ الْمُسْنَدِ ، وَالْحَمْدُ لِلهِ حَقَّ حَمْدِهِ ، وَصَلَّى اللهُ عَلَى  مُحَمَّدٍ  نَبِيِّهِ وَعَبْدِهِ وَسَلَّمَ تَسْلِيمًا.  يَتْلُوهُ فِي أَوَّلِ الثَّانِي بِحَوْلِ اللهِ مُسْنَدُ صُهَيْبِ بْنِ سِنَانٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2082","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن محمد بن عبد الأعلى القيسي عن البزار","أبو إسحاق الهمداني عن أبي الأحوص عن عبد الله"
"2092","[6/5]      مُسْنَدُ  صُهَيْبِ بْنِ سِنَانٍ  رَضِيَ اللهُ عَنْهُ         [6/6]             [6/7]      مُسْنَدُ  صُهَيْبِ بْنِ سِنَانٍ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ابْنُ عُمَرَ  عَنْ  صُهَيْبٍ  2083  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  أَبُو الْوَلِيدِ هِشَامُ بْنُ عَبْدِ الْمَلِكِ قَالَ :  نَا  اللَّيْثُ بْنُ سَعْدٍ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ بْنِ الْأَشَجِّ ،  عَنْ  نَابِلٍ ، صَاحِبِ الْعَبَاءِ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  صُهَيْبٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" خَرَجَ إِلَى  قُبَا  فَأَتَاهُ نَاسٌ فَجَعَلُوا يُسَلِّمُونَ عَلَيْهِ وَهُوَ يُصَلِّي فَيَرُدُّ عَلَيْهِمْ إِشَارَةً  .         [6/8]      وَهَذَا الْحَدِيثُ رَوَاهُ غَيْرُ  نَابِلٍ  ، عَنِ  ابْنِ عُمَرَ  عَنْ  بِلَالٍ ،  وَقَالَ  نَابِلٌ  : عَنِ  ابْنِ عُمَرَ  ، عَنْ  صُهَيْبٍ  ،  وَنَابِلٌ  لَمْ يَرْوِ عَنْهُ إِلَّا  بُكَيْرٌ  .","","Musnad al-Bazzar 2083","","صهيب بن سنان الرومي عن عبد الله بن عمر بن الخطاب عن نابل الحجازي عن بكير بن عبد الله بن الأشج القرشي عن الليث بن سعد عن أبو الوليد الطيالسي عن أبو موسى الزمن عن البزار","ابن عمر عن صهيب"
"2093","[6/9]      سَعِيدُ بْنُ الْمُسَيِّبِ  عَنْ  صُهَيْبٍ  2084  -  حَدَّثَنَا  هَاشِمُ بْنُ الْقَاسِمِ الْحَرَّانِيُّ ، وَإِبْرَاهِيمُ بْنُ هَانِي قَالَا :  نَا  مُحَمَّدُ بْنُ يَزِيدَ بْنِ سِنَانٍ قَالَ :  سَمِعْتُ  أَبِي يَزِيدَ بْنَ سِنَانٍ ،  يُحَدِّثُ ، عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ قَالَ :  سَمِعْتُ  مُجَاهِدًا يَقُولُ :  سَمِعْتُ  سَعِيدَ بْنَ الْمُسَيِّبِ يَقُولُ :  سَمِعْتُ  صُهَيْبًا يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : ""  مَا آمَنَ بِالْقُرْآنِ مَنِ اسْتَحَلَّ مَحَارِمَهُ  .         [6/10]      وَهَذَا الْكَلَامُ لَا نَعْلَمُ رَوَاهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا  صُهَيْبٌ  ، وَلَا نَعْلَمُ يُرْوَى عَنْ  صُهَيْبٍ  إِلَّا مِنْ هَذَيْنِ الْوَجْهَيْنِ اللَّذَيْنِ ذَكَرْنَاهُمَا .","","Musnad al-Bazzar 2084","","صهيب بن سنان الرومي عن سعيد بن المسيب عن مجاهد بن جبر المخزومي عن عطاء بن أبي رباح عن يزيد بن سنان الرهاوي عن محمد بن يزيد بن سنان بن يزيد الرهاوي عن إبراهيم بن هانئ الأغياني عن البزار","سعيد بن المسيب عن صهيب"
"2094","2085  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ قَالَ :  نَا  يَعْقُوبُ بْنُ مُحَمَّدٍ قَالَ :  حَدَّثَنِي  حُصَيْنُ بْنُ حُذَيْفَةَ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  صُهَيْبٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  أُرِيتُ دَارَ هِجْرَتِكُمْ  سَبِخَةً  بَيْنَ ظَهْرَانَيْ  حَرَّةٍ  ، فَإِمَّا أَنْ تَكُونَ  هَجَرَ  وَإِمَّا أَنْ تَكُونَ  يَثْرِبَ  "" . فَخَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  الْمَدِينَةِ  وَخَرَجَ مَعَهُ  أَبُو         [6/11]      بَكْرٍ  ، وَكُنْتُ قَدْ هَمَمْتُ بِالْخُرُوجِ مَعَهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ لَهُ طَرِيقًا عَنْ  صُهَيْبٍ  إِلَّا هَذَا الطَّرِيقَ .","","Musnad al-Bazzar 2085","","صهيب بن سنان الرومي عن سعيد بن المسيب عن والد حصين بن حذيفة بن صيفي عن حصين بن حذيفة بن صيفي عن يعقوب بن محمد بن عيسى عن محمد بن معمر بن ربعي البحراني عن البزار","سعيد بن المسيب عن صهيب"
"2095","[6/12]      أَسْلَمُ مَوْلَى عُمَرَ  عَنْ  صُهَيْبٍ  2086  -  حَدَّثَنَا  الْحَسَنُ بْنُ يَحْيَى الْأَرُزِّيُّ قَالَ :  نَا  عَمْرُو بْنُ عَاصِمٍ الْكِلَابِيُّ قَالَ :  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِيهِ  ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ قَالَ  لِصُهَيْبٍ  :  إِنِّي لَأُحِبُّكَ لَوْلَا خِصَالٌ فِيكَ قَالَ : فَقَالَ : وَمَا هِيَ ؟ قَالَ : اكْتِنَاؤُكَ  بِأَبِي يَحْيَى  وَلَيْسَ لَكَ وَلَدٌ ، وَادِّعَاؤُكَ إِلَى  النَّمِرِ بْنِ قَاسِطٍ  وَلَسْتَ مِنْهُمْ قَالَ : فَقَالَ صُهَيْبٌ : "" إِنَّمَا اكْتِنَائِي  بِأَبِي يَحْيَى  فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَنَّانِي  بِأَبِي يَحْيَى  فَمَا كُنْتُ لِأَدَعَهَا  ، وَأَمَّا قَوْلُكَ انْتِمَائِي إِلَى  النَّمِرِ بْنِ قَاسِطٍ  وَلَسْتُ مِنْهُمْ ، فَأَنَا مِنَ  النَّمِرِ بْنِ قَاسِطٍ  ، وَلَوْ لَمْ أَكُنْ مِنْهُمْ مَا ادَّعَيْتُ إِلَيْهِمْ ، وَأَمَّا عُجْمَتِي فَإِنِّي اسْتُرْضِعْتُ  بِالْأُبُلَّةِ  فَالْعُجْمَةُ فِي لِسَانِي مِنْهُ  .  وَقَدْ رَوَى  حَمَّادُ بْنُ سَلَمَةَ  ، عَنْ  زَيْدِ بْنِ أَسْلَمَ  حَدِيثَيْنِ هَذَا أَحَدُهُمَا وَالْآخَرُ حَدِيثٌ غَيْرُ  مُسْنَدٍ  ، عَنْ  عُمَرَ  فِي قِصَّةِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  ، وَلَا نَعْلَمُ رَوَى  أَسْلَمُ  عَنْ  صُهَيْبٍ  غَيْرَ هَذَا الْحَدِيثِ .","","Musnad al-Bazzar 2086","","صهيب بن سنان الرومي عن أسلم العدوي مولى عمر بن الخطاب عن زيد بن أسلم عن حماد بن سلمة عن عمرو بن عاصم الكلابي عن الحسن بن يحيى الرزي عن البزار","أسلم مولى عمر عن صهيب"
"2096","[6/13]      عَبْدُ الرَّحْمَنِ بْنُ أَبِي لَيْلَى  عَنْ  صُهَيْبٍ  2087  -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ قَالَ :  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  صُهَيْبٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ قَرَأَ :         {      لِلَّذِينَ أَحْسَنُوا الْحُسْنَى وَزِيَادَةٌ         }      قَالَ :  إِذَا دَخَلَ أَهْلُ الْجَنَّةِ الْجَنَّةَ نُودُوا : يَا أَهْلَ الْجَنَّةِ إِنَّ لَكُمْ مَوْعِدًا لَمْ تُعْطَوْهُ  فَيَقُولُونَ : أَلَمْ يُبَيِّضْ وُجُوهَنَا وَيُدْخِلْنَا الْجَنَّةَ ؟ فَيُقَالُ لَهُمْ : إِنَّ لَكُمْ مَوْعِدًا لَمْ تُعْطَوْهُ ، فَيَقُولُونَ مِثْلَ ذَلِكَ ، فَيَتَجَلَّى لَهُمْ رَبُّهُمْ تَبَارَكَ وَتَعَالَى ، فَذَلِكَ قَوْلُهُ :         {      وَلا يَرْهَقُ وُجُوهَهُمْ قَتَرٌ وَلا ذِلَّةٌ         }      قَالَ : يَعِدُ النَّظَرَ إِلَى وَجْهِ رَبِّهِمْ تَبَارَكَ وَتَعَالَى  .         [6/14]      وَهَذَا الْحَدِيثُ رَوَاهُ  سُلَيْمَانُ بْنُ الْمُغِيرَةِ  ،  وَحَمَّادُ بْنُ زَيْدٍ  ،         [6/15]      وَمَعْمَرٌ  ، عَنْ  ثَابِتٍ  ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى  ، وَقَالَ  حَمَّادٌ  : عَنْ  ثَابِتٍ  ، عَنْ  عَبْدِ الرَّحْمَنِ  ، عَنْ  صُهَيْبٍ  ، وَالْحَدِيثُ إِذَا رَوَاهُ  الثِّقَةُ  كَانَ الْحَدِيثُ لَهُ إِذَا زَادَ ، وَكَانَ  حَمَّادُ بْنُ سَلَمَةَ  رَضِيَ اللهُ عَنْهُ [مِنْ] خِيَارِ النَّاسِ وَأُمَنَائِهِمْ .","","Musnad al-Bazzar 2087","","صهيب بن سنان الرومي عن عبد الرحمن بن أبي ليلى عن ثابت البناني عن حماد بن سلمة عن هدبة بن خالد عن البزار","عبد الرحمن بن أبي ليلى عن صهيب"
"2097","2088  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حَرْبٍ الْوَاسِطِيُّ قَالَ :  نَا  عَبْدُ الْحَكِيمِ بْنُ مَنْصُورٍ قَالَ :  نَا  يُونُسُ بْنُ عُبَيْدٍ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  صُهَيْبٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى بِنَا إِحْدَى صَلَاتَيِ  الْعَشِيِّ  ،  إِمَّا الظُّهْرَ وَإِمَّا الْعَصْرَ  ، فَلَمَّا سَلَّمَ الْتَفَتَ إِلَيْنَا بِوَجْهِهِ ضَاحِكًا ، فَقَالَ : "" أَلَا تَسْأَلُونِي مِمَّ ضَحِكْتُ ؟ "" فَقَالَ  الْقَوْمُ  : اللهُ وَرَسُولُهُ أَعْلَمُ ، فَقَالَ :  عَجِبْتُ مِنْ قَضَاءِ اللهِ لِلْعَبْدِ الْمُسْلِمِ  ، إِنَّ كُلَّ قَضَاءِ اللهِ لَهُ خَيْرٌ ، وَلَيْسَ كُلُّ أَحَدٍ قَضَى اللهُ لَهُ خَيْرًا لَهُ إِلَّا الْعَبْدَ الْمُسْلِمَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  يُونُسَ  ، إِلَّا  عَبْدُ الْحَكِيمِ بْنُ مَنْصُورٍ الْوَاسِطِيُّ  . وَقَدْ رَوَاهُ  سُلَيْمَانُ بْنُ الْمُغِيرَةِ  ، عَنْ  ثَابِتٍ  ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى  ، عَنْ  صُهَيْبٍ  .","","Musnad al-Bazzar 2088","","صهيب بن سنان الرومي عن عبد الرحمن بن أبي ليلى عن ثابت البناني عن يونس بن عبيد عن عبد الحكيم بن منصور الخزاعي عن محمد بن حرب النشائي عن البزار","عبد الرحمن بن أبي ليلى عن صهيب"
"2098","[6/16]      2089  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ قَالَ :  نَا  أَبُو دَاوُدَ قَالَ :  نَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  عَنْ  ثَابِتٍ -يَعْنِي الْبُنَانِيَّ- وَهُوَ ثَابِتُ بْنُ أَسْلَمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  صُهَيْبٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا صَلَّى جَلَسَ فَهَمَسَ  ، وَلَمْ يَكُنْ يَفْعَلُهُ قَبْلَ ذَلِكَ ، فَقَالَ لَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَفَطِنْتُمْ لِمَا أَصْنَعُ ؟ "" قُلْنَا : نَعَمْ ، قَالَ : "" إِنِّي ذَكَرْتُ نَبِيًّا أَعْجَبَهُ كَثْرَةُ قَوْمِهِ ، فَقَالَ :  لَنْ يَغْلِبَ هَؤُلَاءِ شَيْءٌ ، أَوْ قَالَ : لَنْ يُغْلَبُوا هَؤُلَاءِ  ، فَقِيلَ لَهُ : خَيِّرْ قَوْمَكَ إِحْدَى ثَلَاثٍ : إِمَّا أَنْ أُسَلِّطَ عَلَيْهِمْ عَدُوًّا مِنْ غَيْرِهِمْ  فَيَسْتَبِيحَهُمْ  ، وَإِمَّا أَنْ أُسَلِّطَ عَلَيْهِمُ الْجُوعَ ، وَإِمَّا أَنْ أُسَلِّطَ عَلَيْهِمُ الْمَوْتَ ، فَأَخْبَرَ بِذَلِكَ قَوْمَهُ ، قَالُوا : فَاخْتَرْ لَنَا فَقَدْ وَكَّلَنَا رَبُّكَ إِلَيْكَ قَالَ : فَتَوَضَّأَ وَصَلَّى "" - قَالَ  سُلَيْمَانُ  وَكَانُوا يَفْزَعُونَ إِلَى الصَّلَاةِ - فَقَالَ : يَا رَبِّ ، أَمَّا أَنْ تُسَلِّطَ عَلَيْهِمْ عَدُوَّهُمْ  فَيَسْتَبِيحَهُمْ  فَلَا ، وَأَمَّا أَنْ تُسَلِّطَ عَلَيْهِمُ الْجُوعَ فَلَا ، وَلَكِنِ الْمَوْتَ ، فَمَاتَ فِي ثَلَاثَةِ أَيَّامٍ سَبْعُونَ أَلْفًا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" فَهَمْسِي الَّذِي تَرَوْنَ أَنْ أَقُولَ : اللَّهُمَّ بِكَ  أَحُولُ  ، اللَّهُمَّ بِكَ  أَصُولُ  ، اللَّهُمَّ بِكَ أُقَاتِلُ "" . قَالَ  سُلَيْمَانُ بْنُ         [6/17]      الْمُغِيرَةِ  : وَلَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ  .  وَهَذَا الْحَدِيثُ بِهَذَا الْكَلَامِ لَا نَعْلَمُ رَوَاهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِلَّا  صُهَيْبٌ  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا ، عَنْ  صُهَيْبٍ  إِلَّا هَذَا الطَّرِيقَ .","","Musnad al-Bazzar 2089","","صهيب بن سنان الرومي عن عبد الرحمن بن أبي ليلى عن ثابت البناني عن سليمان بن المغيرة القيسي عن أبو داود الطيالسي عن الفلاس عن البزار","عبد الرحمن بن أبي ليلى عن صهيب"
"2099","[6/18]      2090  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ قَالَ :  حَدَّثَنِي عَفَّانُ قَالَ :  وَكَتَبَ لِي بِيَدِهِ وَقَرَأَهُ عَلَيَّ  قَالَ :  نَا  حَمَّادُ بْنُ سَلَمَةَ قَالَ :  أَنَا  ثَابِتٌ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  صُهَيْبٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  كَانَ  مَلِكٌ  مِمَّنْ كَانَ قَبْلَكُمْ فَدَفَعَ غُلَامًا لَهُ إِلَى سَاحِرٍ فَعَلَّمَهُ السِّحْرَ  ، وَكَانَ بَيْنَ السَّاحِرِ وَالْمَلِكِ رَاهِبٌ ، فَأَتَى الْغُلَامُ عَلَى الرَّاهِبِ فَسَمِعَ مِنْ كَلَامِهِ فَأَعْجَبَهُ نَحْوُهُ وَكَلَامُهُ ، فَكَانَ إِذَا أَتَى السَّاحِرَ قَالَ : مَا حَبَسَكَ ؟ قَالَ : حَبَسَنِي أَهْلِي ، فَإِذَا أَتَى أَهْلَهُ جَلَسَ عِنْدَ الرَّاهِبِ فَيَبْطَأُ ، فَإِذَا أَتَى أَهْلَهُ ضَرَبُوهُ ، فَشَكَى إِلَى الرَّاهِبِ ، فَقَالَ : إِذَا أَرَادَ السَّاحِرُ أَنْ يَضْرِبَكَ فَقُلْ حَبَسَنِي أَهْلِي ، وَإِذَا أَرَادَ أَهْلُكَ أَنْ يَضْرِبُوكَ فَقُلْ : حَبَسَنِي السَّاحِرُ ، فَبَيْنَمَا هُوَ كَذَلِكَ إِذْ أَتَى ذَاتَ يَوْمٍ عَلَى دَابَّةٍ فَضِيعَةٍ عَظِيمَةٍ قَدْ حَبَسَتِ النَّاسَ فَلَا يَسْتَطِيعُونَ أَنْ يُجَاوِزُوا ، فَقَالَ : الْيَوْمَ أَعْلَمُ الرَّاهِبُ أَحَبُّ إِلَى اللهِ أَمِ السَّاحِرُ ؟ فَقَالَ : اللَّهُمَّ إِنْ كَانَ أَمْرُ الرَّاهِبِ أَحَبَّ إِلَيْكَ - أَرْضَى - مِنْ أَمْرِ السَّاحِرِ فَاقْتُلْ هَذِهِ الدَّابَّةَ حَتَّى يَجُوزَ النَّاسُ ، فَرَمَاهَا فَقَتَلَهَا ، وَمَضَى النَّاسُ ، فَأَخْبَرَ الرَّاهِبَ بِذَلِكَ ، فَقَالَ : إِنَّكَ أَفْضَلُ مِنِّي ، وَإِنَّكَ سَتُبْتَلَى ، فَإِنِ ابْتُلِيتَ فَلَا تَدُلَّ عَلَيَّ ، فَكَانَ الْغُلَامُ يُبْرِئُ الْأَكْمَهَ وَالْأَبْرَصَ قَالَ : وَكَانَ جَلِيسٌ لِلْمَلِكِ  يَعْنِي رَجُلًا كَانَ يُجَالِسُهُ  ، فَعَمِيَ فَسَمِعَ بِهِ -  يَعْنِي فَسَمِعَ بِالْغُلَامِ  - وَأَتَاهُ بِهَدَايَا كَثِيرَةٍ ، فَقَالَ لَهُ : اشْفِنِي ، فَقَالَ : مَا أَشْفِي أَنَا أَحَدًا ، فَإِنْ آمَنْتَ بِاللهِ دَعَوْتُ اللهَ فَشَفَاكَ ، فَآمَنَ فَدَعَا اللهَ فَشَفَاهُ ، ثُمَّ أَتَى الْمَلِكَ -  يَعْنِي الرَّجُلَ الَّذِي كَانَ يَأْتِيهِ  - فَجَلَسَ كَمَا كَانَ يَجْلِسُ ،         [6/19]      فَقَالَ لَهُ فُلَانٌ : مَنْ رَدَّ عَلَيْكَ بَصَرَكَ ؟ قَالَ : رَبِّي ، قَالَ : أَنَا رَبُّكَ ، قَالَ : لَا ، وَلَكِنْ رَبِّيَ اللهُ؛ قَالَ : وَلَكَ رَبٌّ غَيْرِي ؟ قَالَ : نَعَمْ . قَالَ : فَلَمْ يَزَلْ يُعَذِّبُهُ حَتَّى دَلَّ عَلَى الْغُلَامِ ، فَبَعَثَ إِلَيْهِ فَقَالَ : قَدْ بَلَغَ مِنْ سِحْرِكَ أَنْ تُبْرِئَ الْأَكْمَهَ وَالْأَبْرَصَ ؟ قَالَ : مَا أَشْفِي أَحَدًا ، مَا يَشْفِي غَيْرُ اللهِ . قَالَ : وَلَكَ رَبٌّ غَيْرِي ؟ قَالَ : نَعَمْ ، رَبِّي وَرَبُّكَ اللهُ ، فَأَخَذَهُ أَيْضًا بِالْعَذَابِ ، فَلَمْ يَزَلْ بِهِ حَتَّى دَلَّ عَلَى الرَّاهِبِ ، فَأُتِيَ بِالرَّاهِبِ ، فَقَالَ : ارْجِعْ عَنْ دِينِكَ فَأَبَى ، فَوُضِعَ الْمِنْشَارُ فِي مَفْرِقِ رَأْسِهِ حَتَّى وَقَعَ شِقَّاهُ إِلَى الْأَرْضِ ، وَقَالَ لِلْأَعْمَى : ارْجِعْ عَنْ دِينِكَ فَأَبَى ، قَالَ : فَوُضِعَ الْمِنْشَارُ فِي مَفْرِقِ رَأْسِهِ حَتَّى وَقَعَ شِقَّاهُ إِلَى الْأَرْضِ ، وَقَالَ لِلْغُلَامِ : ارْجِعْ عَنْ دِينِكَ فَأَبَى فَبَعَثَ بِهِ مَعَ نَفَرٍ إِلَى جَبَلِ كَذَا وَكَذَا ، فَقَالَ : إِذَا بَلَغْتُمْ بِهِ فَإِنْ رَجَعَ عَنْ دِينِهِ وَإِلَّا فَدَهْدِهُوهُ مِنْ فَوْقِهِ ، فَذَهَبُوا بِهِ فَلَمَّا عَلَوْا بِهِ الْجَبَلَ قَالَ : اللَّهُمَّ اكْفِنِيهِمْ بِمَا شِئْتَ فَرَجَفَ بِهِمُ الْجَبَلُ ، وَجَاءَ الْغُلَامُ يَمْشِي إِلَى الْمَلِكِ ، فَقَالَ : مَا فَعَلَ أَصْحَابُكَ ؟ قَالَ : كَفَانِيهِمُ اللهُ ، فَبَعَثَ بِهِ مَعَ آخَرِينَ إِلَى الْبَحْرِ ، وَقَالَ : إِنْ رَجَعَ عَنْ دِينِهِ وَلَا فَغَرِّقُوهُ فَلَحَجُوا بِهِ ، فَقَالَ الْغُلَامُ : اللَّهُمَّ اكْفِنِيهِمْ بِمَا شِئْتَ ، فَغَرِقُوا أَجْمَعُونَ ، وَجَاءَ الْغُلَامُ يَمْشِي حَتَّى دَخَلَ عَلَى الْمَلِكِ ، فَقَالَ : مَا فَعَلَ أَصْحَابُكَ ؟ فَقَالَ : كَفَانِيهِمُ اللهُ ، ثُمَّ قَالَ لِلْمَلِكِ : إِنَّكَ لَا تَسْتَطِيعُ أَنْ تَقْتُلَنِي ، حَتَّى تَفْعَلَ مَا آمُرُكَ بِهِ ، فَإِنْ أَنْتَ فَعَلْتَ مَا آمُرُكَ بِهِ قَتَلْتَنِي ، وَإِلَّا فَإِنَّكَ لَا تَسْتَطِيعُ قَتْلِي قَالَ : وَمَا هُوَ ؟ قَالَ : تَجْمَعُ النَّاسَ فِي صَعِيدٍ وَاحِدٍ ، ثُمَّ تَصْلُبُنِي عَلَى جِذْعٍ ، فَتَأْخُذُ سَهْمًا مِنْ كِنَانَتِي ، ثُمَّ تَقُولُ : بِاسْمِ اللهِ رَبِّ الْغُلَامِ ،         [6/20]      فَإِنَّكَ إِذَا فَعَلْتَ ذَلِكَ قَتَلْتَنِي قَالَ : فَوَضَعَ السَّهْمَ فِي كَبِدِ قَوْسِهِ ، ثُمَّ رَمَاهُ ثُمَّ قَالَ : بِاسْمِ اللهِ رَبِّ الْغُلَامِ ، فَوَقَعَ السَّهْمُ فِي صُدْغِهِ ، فَوَضَعَ الْغُلَامُ يَدَهُ عَلَى مَوْضِعِ السَّهْمِ ، فَمَاتَ ، فَقَالَ النَّاسُ : آمَنَّا بِرَبِّ الْغُلَامِ ، فَقِيلَ لِلْمَلِكِ : أَرَأَيْتَ مَا كُنْتَ تَحْذَرُ ، فَقَدْ وَاللهِ نَزَلَ بِكَ ، قَدْ آمَنَ النَّاسُ كُلُّهُمْ ، فَأَمَرَ بِأَفْوَاهِ السِّكَكِ فَخُدَّتْ فِيهَا الْأُخْدُودُ وَأُضْرِمَتْ فِيهَا النِّيرَانُ ، وَقَالَ : مَنْ رَجَعَ عَنْ دِينِهِ فَدَعُوهُ وَإِلَّا فَأَقْحِمُوهُ فِيهَا ، فَكَانُوا يَتَقَادَعُونَ فِيهَا ، فَجَاءَتِ امْرَأَةٌ بِابْنٍ لَهَا تُرْضِعُهُ فَكَأَنَّهَا  تَقَاعَسَتْ  أَنْ تَقَعَ فِيهَا ، فَقَالَ لَهَا الصَّبِيُّ : يَا أُمِّهِ اصْبِرِي فَإِنَّكِ عَلَى الْحَقِّ  .","","Musnad al-Bazzar 2090","","صهيب بن سنان الرومي عن عبد الرحمن بن أبي ليلى عن ثابت البناني عن حماد بن سلمة عن عفان بن مسلم الصفار عن الفلاس عن البزار","عبد الرحمن بن أبي ليلى عن صهيب"
"2100","2091  -  وَنَاهُ  مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى الصَّنْعَانِيُّ قَالَ :  نَا  عَبْدُ الرَّزَّاقِ قَالَ :  أَنَا  مَعْمَرٌ ،  عَنْ  ثَابِتٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  صُهَيْبٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .         [6/21]      وَهَذَا الْكَلَامُ لَا نَعْلَمُ يَرْوِيهِ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا  صُهَيْبٌ ،  وَلَا نَعْلَمُ رَوَاهُ إِلَّا  ثَابِتٌ  ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى  ، عَنْ  صُهَيْبٍ  .","","Musnad al-Bazzar 2091","","صهيب بن سنان الرومي عن عبد الرحمن بن أبي ليلى عن ثابت البناني عن معمر بن راشد عن عبد الرزاق الصنعاني عن محمد بن عبد الأعلى القيسي عن البزار","عبد الرحمن بن أبي ليلى عن صهيب"
"2101","[6/22]      كَعْبُ الْأَحْبَارِ  عَنْ  صُهَيْبٍ  2092  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ سَلَمَةَ قَالَ :  نَا  سَعْدُ بْنُ عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ قَالَ :  نَا  ابْنُ أَبِي الزِّنَادِ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  عَطَاءِ بْنِ أَبِي مَرْوَانَ ،  عَنْ  أَبِيهِ  ، أَنَّ عَبْدَ الرَّحْمَنِ بْنَ مُغِيثٍ الْأَسْلَمِيَّ  حَدَّثَهُ  قَالَ :  قَالَ  كَعْبٌ :  إِنَّا لَنَجِدُ فِي التَّوْرَاةِ أَنَّ نَبِيَّ اللهِ  دَاوُدَ  كَانَ إِذَا انْصَرَفَ مِنْ صَلَاتِهِ قَالَ : "" اللَّهُمَّ أَصْلِحْ لِي دِينِي  الَّذِي جَعَلْتَهُ عِصْمَةَ أَمْرِي ، وَأَصْلِحْ لِي دُنْيَايَ الَّتِي         [6/23]      جَعَلْتَ فِيهَا مَعَاشِي ، اللَّهُمَّ أَعُوذُ  بِرِضَاكَ  مِنْ سَخَطِكَ ، وَأَعُوذُ بِمُعَافَاتِكَ مِنْ نِقْمَتِكَ ، وَأَعُوذُ بِكَ مِنْكَ ، لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .  قَالَ  كَعْبُ الْأَحْبَارِ : إِنَّ صُهَيْبًا الْخَيْرَ ،  أَخْبَرَ  أَنَّ  مُحَمَّدًا  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَنْصَرِفُ بِهَذِهِ الْكَلِمَاتِ مِنْ صَلَاتِهِ  ، فَذَلِكَ هَاجَ  كَعْبًا  عَلَى الْحَدِيثِ .","","Musnad al-Bazzar 2092","","صهيب بن سنان الرومي عن كعب الأحبار عن عبد الرحمن بن مغيث الأسلمي عن أبو مروان الأسلمي والد عطاء بن أبي مروان عن عطاء بن أبي مروان الأسلمي عن موسى بن عقبة عن عبد الرحمن بن أبي الزناد عن سعد بن عبد الحميد الأنصاري عن إبراهيم بن محمد بن سلمة المرادي عن البزار","كعب الأحبار عن صهيب"
"2102","2093  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ سَلَمَةَ قَالَ :  نَا  سَعْدُ بْنُ عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  عَطَاءِ بْنِ أَبِي مَرْوَانَ ،  عَنْ  أَبِيهِ  قَالَ :         [6/24]      قَالَ  كَعْبُ الْأَحْبَارِ :  مَا أَتَى  مُحَمَّدٌ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَرْيَةً يُرِيدُ دُخُولَهَا إِلَّا قَالَ حِينَ يَرَاهَا : "" اللَّهُمَّ رَبَّ السَّمَاوَاتِ وَمَا أَظَلَّتْ  ، وَرَبَّ الْأَرَضِينَ السَّبْعِ وَمَا أَقَلَّتْ ، وَرَبَّ الشَّيَاطِينِ وَمَا أَضَلَّتْ ، وَرَبَّ الرِّيَاحِ وَمَا ذَرَيْنَ ، فَإِنَّا نَسْأَلُكَ خَيْرَ هَذِهِ الْقَرْيَةِ وَخَيْرَ أَهْلِهَا ، وَنَعُوذُ بِكَ مِنْ شَرِّهَا وَشَرِّ أَهْلِهَا ، أَوْ مِنْ شَرِّهَا وَشَرِّ مَا فِيهَا .  وَقَالَ  كَعْبٌ  : إِنَّ صُهَيْبًا حَدَّثَهُ بِهَذَا الْحَدِيثِ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .         [6/25]      وَهَذَانِ الْحَدِيثَانِ لَا نَعْلَمُهُمَا يُرْوَيَانِ عَنْ  صُهَيْبٍ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2093","","صهيب بن سنان الرومي عن كعب الأحبار عن أبو مروان الأسلمي والد عطاء بن أبي مروان عن عطاء بن أبي مروان الأسلمي عن موسى بن عقبة عن عبد الرحمن بن أبي الزناد عن سعد بن عبد الحميد الأنصاري عن إبراهيم بن محمد بن سلمة المرادي عن البزار","كعب الأحبار عن صهيب"
"2103","[6/26]      حَمْزَةُ بْنُ صُهَيْبٍ  عَنْ أَبِيهِ  2094  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  أَبُو عَامِرٍ قَالَ :  نَا  زُهَيْرٌ - يَعْنِي ابْنَ مُحَمَّدٍ - ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  حَمْزَةَ بْنِ صُهَيْبٍ ،  عَنْ  أَبِيهِ  قَالَ : ""  كَنَّانِي  النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِأَبِي يَحْيَى  .         [6/27]      وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنْ  صُهَيْبٍ  مِنْ غَيْرِ وَجْهٍ ، وَلَا نَعْلَمُ رَوَى  حَمْزَةُ بْنُ صُهَيْبٍ  ، عَنْ أَبِيهِ إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 2094","","صهيب بن سنان الرومي عن حمزة بن صهيب القرشي عن عبد الله بن محمد بن عقيل بن أبي طالب عن زهير بن محمد التميمي عن أبو عامر العقدي عن أبو موسى الزمن عن البزار","حمزة بن صهيب عن أبيه"
"2104","[6/28]      صَيْفِيُّ بْنُ صُهَيْبٍ  عَنْ أَبِيهِ  2095  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ قَالَ :  نَا  يَعْقُوبُ بْنُ مُحَمَّدٍ قَالَ :  نَا  عَاصِمُ بْنُ سُوَيْدٍ ،  عَنْ  دَاوُدَ بْنِ إِسْمَاعِيلَ بْنِ مُجَمِّعٍ ،  عَنْ  عَبْدِ الْحَمِيدِ بْنِ زِيَادِ بْنِ صُهَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  صُهَيْبٍ  قَالَ :  قَدِمْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَدَخَلْتُ عَلَيْهِ ، وَهُوَ فِي مَنْزِلِ  كُلْثُومِ بْنِ الْهَدْمِ  ، وَبَيْنَ أَيْدِيهِمْ تَمْرٌ يَأْكُلُونَهُ ، وَكُنْتُ رَمِدًا مِنْ إِحْدَى الْعَيْنَيْنِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَأْكُلِ التَّمْرَ عَلَى عَيْنِكَ  ، فَقُلْتُ : أَنَا آكُلُ         [6/29]      مِنْ شِقِّ عَيْنِيَ الصَّحِيحَةِ ، فَضَحِكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى بَدَتْ  نَوَاجِذُهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا  صُهَيْبٌ  .","","Musnad al-Bazzar 2095","","صهيب بن سنان الرومي عن زياد بن صيفي الرومي عن عبد الحميد بن زياد الجدعاني عن داود بن إسماعيل بن مجمع عن عاصم بن سويد بن عامر بن يزيد الأنصاري عن يعقوب بن محمد بن عيسى عن محمد بن معمر بن ربعي البحراني عن البزار","صيفي بن صهيب عن أبيه"
"2105","2096  -  وَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ الْمُفَضَّلِ الْحَرَّانِيُّ  قَالَ :  نَا  مُحَمَّدُ بْنُ سُلَيْمَانَ بْنِ سَالِمٍ قَالَ :  حَدَّثَنِي  أَبُو قُدَامَةَ قَالَ :  حَدَّثَنِي  عَبْدُ الْحَمِيدِ بْنُ صَيْفِيِّ بْنِ صُهَيْبٍ ، أَنَّ أَبَاهُ ،  أَخْبَرَهُ  ،  عَنْ         [6/30]      جَدِّهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  عَلَيْكُمْ  بِالْحَبَّةِ  السَّوْدَاءِ  ، فَإِنَّ فِيهَا شِفَاءً مِنْ كُلِّ دَاءٍ إِلَّا  السَّامَ  "" قَالُوا : وَمَا  السَّامُ  ؟ قَالَ : "" الْمَوْتُ ، عَلَيْكُمْ  بِالْعَجْوَةِ  فَإِنَّهَا دَوَاءٌ مِنْ كُلِّ سُمٍّ ، عَلَيْكُمْ بِأَلْبَانِ الْإِبِلِ الْبَرِّيَّةِ فَإِنَّهَا دَوَاءٌ مِنْ كُلِّ دَاءٍ  .  وَهَذَا الْحَدِيثُ لَا نَحْفَظُهُ عَنْ  صُهَيْبٍ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .  كذا في طبعة مكتبة العلوم والحكم ، ونسخة الرباط وتكرر في عدة مواضع عند المصنف كذلك ، وكذا في كشف الأستار وهو شيخ المصنف ، إلا أنه وقع في كتب التراجم والأنساب : (أحمد) فالله أعلم .","","Musnad al-Bazzar 2096","","صهيب بن سنان الرومي عن صيفي بن صهيب بن سنان الرومي عن عبد الحميد بن صيفي الجدعانى عن أبو قدامة عن محمد بن سليمان بن أبي داود بومة عن الكزبراني أحمد بن عبد الرحمن عن البزار","صيفي بن صهيب عن أبيه"
"2106","2097  -  وَنَا  زِيَادُ بْنُ عُبَيْدِ اللهِ قَالَ :  نَا  زِيَادُ بْنُ عَبْدِ اللهِ الْقُرَشِيُّ قَالَ :  حَدَّثَنِي  عَبْدُ الْحَمِيدِ بْنُ صَيْفِيِّ بْنِ صُهَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  عَلَيْكُمْ بِخِضَابِ السَّوَادِ  ، فَإِنَّهُ أَرْهَبُ لَكُمْ فِي صُدُورِ عَدُوِّكُمْ ، وَأَرْغَبُ نِسَائِكُمْ فِيكُمْ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مِنْ هَذَا الْوَجْهِ  .","","Musnad al-Bazzar 2097","","صهيب بن سنان الرومي عن صيفي بن صهيب بن سنان الرومي عن عبد الحميد بن صيفي الجدعانى عن زياد بن عبد الله القرشي عن زياد بن عبيد الله عن البزار","صيفي بن صهيب عن أبيه"
"2107","2098  -  وَحَدَّثَنِيهِ  أَبِي  قَالَ :  نَا  زِيَادُ بْنُ عَبْدِ اللهِ الْقُرَشِيُّ قَالَ :  حَدَّثَنِي  الدَّفَّاعُ بْنُ دَغْفَلٍ السَّدُوسِيُّ قَالَ :  حَدَّثَنِي  عَبْدُ الْحَمِيدِ بْنُ صَيْفِيِّ بْنِ صُهَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .         [6/31]","","Musnad al-Bazzar 2098","","صهيب بن سنان الرومي عن صيفي بن صهيب بن سنان الرومي عن عبد الحميد بن صيفي الجدعانى عن دفاع بن دغفل القيسي عن زياد بن عبد الله القرشي عن أبي عن البزار","صيفي بن صهيب عن أبيه"
"2108","2099  -  وَنَاهُ  الْحَسَنُ بْنُ يَحْيَى الْأَرُزِّيُّ قَالَ :  نَا  عَاصِمُ بْنُ مِهْجَعٍ قَالَ :  نَا  الدَّفَّاعُ بْنُ دَغْفَلٍ قَالَ :  حَدَّثَنِي  عَبْدُ الْحَمِيدِ بْنُ صَيْفِيِّ بْنِ صُهَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .  وَزِيَادُ بْنُ عُبَيْدِ اللهِ  تَرَكَ فِي  الْإِسْنَادِ  الدَّفَّاعَ بْنَ دَغْفَلٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  الدَّفَّاعُ  ،  وَإِسْنَادُهُ لَيْسَ بِالْقَوِيِّ  .","","Musnad al-Bazzar 2099","","صهيب بن سنان الرومي عن صيفي بن صهيب بن سنان الرومي عن عبد الحميد بن صيفي الجدعانى عن دفاع بن دغفل القيسي عن عاصم بن مهجع الأسدي عن الحسن بن يحيى الرزي عن البزار","صيفي بن صهيب عن أبيه"
"2109","2100  -  وَنَا  مُحَمَّدُ بْنُ مُوسَى الْحَرَشِيُّ قَالَ :  نَا  جَعْفَرُ بْنُ سُلَيْمَانَ الضُّبَعِيُّ قَالَ :  نَا  عَمْرُو بْنُ دِينَارٍ ، يَعْنِي مَوْلَى آلِ الزُّبَيْرِ ،  عَنْ  صَيْفِيِّ بْنِ صُهَيْبٍ ،  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  مَنْ قَالَ عَلَيَّ مَا لَمْ أَقُلْ  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .         [6/32]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  صُهَيْبٍ  إِلَّا مِنْ هَذَا الْوَجْهِ  .","","Musnad al-Bazzar 2100","","صهيب بن سنان الرومي عن صيفي بن صهيب بن سنان الرومي عن عمرو بن دينار قهرمان آل الزبير عن جعفر بن سليمان الضبعي عن محمد بن موسى الحرشي عن البزار","صيفي بن صهيب عن أبيه"
"2110","2101  -  وَنَاهُ  مُحَمَّدُ بْنُ مَعْمَرٍ قَالَ :  نَا  سَيَّارٌ يَعْنِي ابْنَ حَاتِمٍ ،  عَنْ  جَعْفَرِ بْنِ سُلَيْمَانَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ صُهَيْبٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .","","Musnad al-Bazzar 2101","","صهيب بن سنان الرومي عن صيفي بن صهيب بن سنان الرومي عن عمرو بن دينار قهرمان آل الزبير عن جعفر بن سليمان الضبعي عن سيار بن حاتم العنزي عن محمد بن معمر بن ربعي البحراني عن البزار","صيفي بن صهيب عن أبيه"
"2111","2102  -  وَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ قَالَ :  نَا  يُوسُفُ بْنُ عَدِيٍّ قَالَ :  نَا  يُوسُفُ بْنُ مُحَمَّدِ بْنِ يَزِيدَ بْنِ صَيْفِيِّ بْنِ صُهَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ         [6/33]      جَدِّهِ ،  عَنْ  أَبِي جَدِّهِ ،  عَنْ  صُهَيْبٍ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  مَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلْيُحِبَّ  صُهَيْبًا  حُبَّ الْوَالِدَةِ لِوَلَدِهَا  .","","Musnad al-Bazzar 2102","","صهيب بن سنان الرومي عن صيفي بن صهيب بن سنان الرومي عن زياد بن صيفي الرومي عن محمد بن يزيد بن صيفى الجدعاني عن يوسف بن محمد بن صيفي الجدعاني عن يوسف بن عدي بن رزق الكوفي عن إبراهيم بن عبد الله بن الجنيد الختلي عن البزار","صيفي بن صهيب عن أبيه"
"2112","2103  -  وَبِإِسْنَادِهِ  قَالَ :  صَحِبْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَبْلَ أَنْ يَدْخُلَ  الْمَدِينَةَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى إِلَّا عَنْ  صُهَيْبٍ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2103","","صهيب بن سنان الرومي عن صيفي بن صهيب بن سنان الرومي عن زياد بن صيفي الرومي عن محمد بن يزيد بن صيفى الجدعاني عن يوسف بن محمد بن صيفي الجدعاني عن يوسف بن عدي بن رزق الكوفي عن إبراهيم بن عبد الله بن الجنيد الختلي عن البزار","صيفي بن صهيب عن أبيه"
"2113","2104  -  وَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ قَالَ :  نَا  يَحْيَى بْنُ صَالِحٍ قَالَ :  نَا  جَابِرُ بْنُ غَانِمٍ ،  عَنِ  ابْنِ صُهَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :         [6/34]      قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  صَلَاةُ الرَّجُلِ فِي جَمَاعَةٍ تَعْدِلُ صَلَاتَهُ وَحْدَهُ خَمْسَةً وَعِشْرِينَ  -  يَعْنِي خَمْسًا وَعِشْرِينَ صَلَاةً  .","","Musnad al-Bazzar 2104","","صهيب بن سنان الرومي عن صيفي بن صهيب بن سنان الرومي عن زياد بن صيفي الرومي عن جابر بن غانم السلفي الخشني عن يحيى بن صالح الوحاظي عن إبراهيم بن سعيد الجوهري عن البزار","صيفي بن صهيب عن أبيه"
"2114","[6/35]      مُسْنَدُ  الْمِقْدَادِ بْنِ عَمْرِو بْنِ الْأَسْوَدِ  رَضِيَ اللهُ عَنْهُ         [6/36]             [6/37]      مُسْنَدُ  الْمِقْدَادِ بْنِ عَمْرِو بْنِ الْأَسْوَدِ يُكَنَّى أَبَا مَعْبَدٍ  ابْنُ عَبَّاسٍ عَنِ الْمِقْدَادِ  2105  -  حَدَّثَنَا  إِسْحَاقُ بْنُ شَاهِينَ الْوَاسِطِيُّ قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ قَالَ :  نَا  يَزِيدُ بْنُ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْمِقْدَادِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2105","","المقداد بن عمرو بن ثعلبة البهراني عن عبد الله بن عباس عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن خالد بن عبد الله الطحان عن إسحاق بن شاهين الدهقاني عن البزار","ابن عباس عن المقداد"
"2115","2106  -  وَنَاهُ  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ قَالَ :  نَا  أَبُو أُسَامَةَ قَالَ :  نَا  زَائِدَةُ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْمِقْدَادِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  إِذَا رَأَيْتُمُ الْمَدَّاحِينَ  فَاحْثُوا  فِي وُجُوهِهِمُ  التُّرَابَ  .  وَلَا نَعْلَمُ رَوَى  ابْنُ عَبَّاسٍ  ، عَنِ  الْمِقْدَادِ  إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 2106","","المقداد بن عمرو بن ثعلبة البهراني عن عبد الله بن عباس عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن زائدة بن قدامة عن حماد بن أسامة القرشي عن إبراهيم بن سعيد الجوهري عن البزار","ابن عباس عن المقداد"
"2116","[6/38]      هَمَّامُ بْنُ الْحَارِثِ  عَنِ  الْمِقْدَادِ  2107  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ قَالَ :  نَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامٍ ،  عَنِ  الْمِقْدَادِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  إِذَا رَأَيْتُمُ الْمَدَّاحِينَ  فَاحْثُوا  فِي وُجُوهِهِمُ  التُّرَابَ  .  وَلَا نَعْلَمُ رَوَى  هَمَّامٌ  عَنِ  الْمِقْدَادِ  إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 2107","","المقداد بن عمرو بن ثعلبة البهراني عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن سفيان الثوري عن عبد الرحمن بن مهدي عن محمد بن بشار بندار عن البزار","همام بن الحارث عن المقداد"
"2117","[6/39]      يَزِيدُ بْنُ شَرِيكٍ  عَنِ  الْمِقْدَادِ  2108  -  حَدَّثَنَا  هِشَامُ بْنُ يُونُسَ الْكُوفِيُّ قَالَ :  نَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنْ  أَبِيهِ  قَالَ :  كُنَّا عِنْدَ  عُثْمَانَ بْنِ عَفَّانَ  رَضِيَ اللهُ عَنْهُ ، فَجَعَلَ رَجُلٌ يُثْنِي عَلَيْهِ ، فَجَعَلَ الْمِقْدَادُ يَحْثُو فِي وَجْهِهِ -  يَعْنِي  التُّرَابَ  - وَقَالَ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا رَأَيْتُمُ الْمَدَّاحِينَ  فَاحْثُوا  فِي وُجُوهِهِمُ  التُّرَابَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الْأَعْمَشِ  بِهَذَا  الْإِسْنَادِ  إِلَّا  حَفْصُ بْنُ غِيَاثٍ  .","","Musnad al-Bazzar 2108","","المقداد بن عمرو بن ثعلبة البهراني عن يزيد بن شريك بن طارق التيمي عن إبراهيم بن يزيد بن شريك التيمي عن الأعمش عن حفص بن غياث النخعي عن هشام بن يونس بن وابل النهشلي عن البزار","يزيد بن شريك عن المقداد"
"2118","[6/40]      مَيْمُونُ بْنُ أَبِي شَبِيبٍ  عَنِ  الْمِقْدَادِ  2109  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ قَالَ :  نَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  مَيْمُونِ بْنِ أَبِي شَبِيبٍ ،  عَنِ  الْمِقْدَادِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  إِذَا رَأَيْتُمُ الْمَدَّاحِينَ  فَاحْثُوا  فِي وُجُوهِهِمُ  التُّرَابَ  .  وَلَا نَعْلَمُ رَوَى  مَيْمُونُ بْنُ أَبِي شَبِيبٍ  عَنِ  الْمِقْدَادِ  إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 2109","","المقداد بن عمرو بن ثعلبة البهراني عن ميمون بن أبي شبيب عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","ميمون بن أبي شبيب عن المقداد"
"2119","[6/41]      عَبْدُ الرَّحْمَنِ بْنُ أَبِي لَيْلَى  عَنِ  الْمِقْدَادِ  2110  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  أَبُو عَامِرٍ عَبْدُ الْمَلِكِ بْنُ عَمْرٍو قَالَ :  نَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  عَنْ  ثَابِتٍ - يَعْنِي الْبُنَانِيَّ - ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  الْمِقْدَادِ قَالَ :  أَقْبَلْتُ أَنَا وَصَاحِبَانِ لِي قَدْ ذَهَبَتْ أَبْصَارُنَا وَأَسْمَاعُنَا مِنَ الْجُوعِ ، فَجَعَلْنَا نَعْرِضُ أَنْفُسَنَا عَلَى أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَيْسَ مِنْهُمْ أَحَدٌ يَقْبَلُنَا ، فَأَتَيْنَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَانْطَلَقَ بِنَا ، فَإِذَا ثَلَاثَةُ أَعْنُزٍ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" احْتَلِبُوا هَذَا اللَّبَنَ فَاقْسِمُوهُ بَيْنَنَا "" فَكُنَّا نَفْعَلُ ذَلِكَ وَنَرْفَعُ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَيَجِيءُ مِنَ اللَّيْلِ فَيُسَلِّمُ تَسْلِيمًا ، لَا يُوقِظُ نَائِمًا وَيُسْمِعُ الْيَقْظَانَ ، ثُمَّ يَأْتِي الْمَسْجِدَ فَيُصَلِّي ، ثُمَّ يَأْتِي شَرَابَهُ فَيَشْرَبُ ، فَأَتَانِي الشَّيْطَانُ ذَاتَ لَيْلَةٍ ، فَقَالَ :  مُحَمَّدٌ  يَأْتِي  الْأَنْصَارَ  فَيُتْحِفُونَهُ وَيُصِيبُ عِنْدَهُمْ ، مَا بِهِ حَاجَةٌ إِلَى هَذِهِ  الْجَرْعَةِ  . فَمَا زَالَ عَنِّي حَتَّى شَرِبْتُهَا ، فَلَمَّا عَرَفَ أَنِّي قَدْ وَارَيْتُهَا فِي بَطْنِي وَعَرَفَ أَنْ لَيْسَ إِلَيْهَا سَبِيلٌ نَدَّمَنِي ، وَقَالَ : وَيْحَكَ مَا صَنَعْتَ ؟ شَرِبْتَ شَرَابَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَيَجِيءُ  مُحَمَّدٌ  فَيَدْعُو عَلَيْكَ فَتَهْلِكُ فَتَذْهَبُ دُنْيَاكَ وَآخِرَتُكَ . وَعَلَيَّ شَمْلَةٌ ، إِذَا رَفَعْتُهَا عَلَى رَأْسِي خَرَجَتْ قَدَمَايَ ، وَإِذَا أَرْسَلْتُهَا عَلَى قَدَمَيَّ خَرَجَ رَأْسِي ، فَجَعَلَ لَا يَجِيئُنِي النَّوْمُ ، وَأَمَّا صَاحِبَيَّ فَنَامَا وَلَمْ يَصْنَعَا مَا صَنَعْتُ ، وَجَاءَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَلَّمَ وَأَتَى الْمَسْجِدَ فَصَلَّى وَأَتَى شَرَابَهُ فَكَشَفَ عَنْهُ فَلَمْ يَجِدْ فِيهِ شَيْئًا فَرَفَعَ رَأْسَهُ ،         [6/42]      فَقُلْتُ : الْآنَ يَدْعُو عَلَيَّ فَأَهْلِكُ ، فَقَالَ :  اللَّهُمَّ أَطْعِمْ مَنْ أَطْعَمَنِي وَاسْقِ مَنْ سَقَانِي  ، فَلَمَّا سَمِعْتُ ذَلِكَ شَدَدْتُ عَلَيَّ الشَّمْلَةَ وَأَخَذْتُ الشَّفْرَةَ فَعَمَدْتُ إِلَى الْأَعْنُزِ أَنْظُرُ وَأَخْتَارُ أَيَّتَهُنَّ أَسْمَنُ كَيْمَا أَذْبَحَهَا لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَسَسْتُهُنَّ فَإِذَا هُنَّ حُفَّلٌ كُلُّهُنَّ ، فَعَمَدْتُ إِلَى إِنَاءٍ  لِآلِ مُحَمَّدٍ  مَا كَانُوا يَطْمَعُونَ أَنْ يَحْلِبُوا فِيهِ ، فَحَلَبْتُ فِيهِ حَتَّى عَلَتْهُ الرَّغْوَةُ ، فَجِئْتُ بِهِ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : "" أَمَا شَرِبْتُمْ شَرَابَكُمْ ؟ "" فَقُلْتُ : يَا رَسُولَ اللهِ اشْرَبْ ، فَشَرِبَ ، ثُمَّ نَاوَلَنِي ، فَقُلْتُ : اشْرَبْ ، فَشَرِبَ ، ثُمَّ نَاوَلَنِي ، فَأَخَذْتُ مَا بَقِيَ ، فَلَمَّا عَرَفْتُ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ شَرِبَ ، وَأَمِنْتُ دَعْوَتَهُ ، ضَحِكْتُ حَتَّى أُلْقِيتُ إِلَى الْأَرْضِ ، فَقَالَ : "" إِحْدَى سَوْآتِكَ يَا  مِقْدَادُ  ؟ "" ، فَقُلْتُ : يَا رَسُولَ اللهِ كَانَ مِنْ أَمْرِي كَذَا وَكَذَا فَحَدَّثْتُهُ بِالَّذِي صَنَعْتُهُ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا كَانَ هَذَا إِلَّا رَحْمَةً مِنَ اللهِ ، أَلَا كُنْتَ آذَنْتَنِي فَنُوقِظَ صَاحِبَيْنَا ؟ "" فَقُلْتُ : وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا  أُبَالِي  إِذَا أَصَبْتَ مِنْهَا ، وَأَصَبْتُ مِنْهَا مَنْ أَصَابَ مِنَ النَّاسِ  .         [6/43]      وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنِ  الْمِقْدَادِ  وَحْدَهُ ، وَلَا نَعْلَمُ لَهُ  إِسْنَادًا  عَنِ  الْمِقْدَادِ  إِلَّا هَذَا  الْإِسْنَادَ  .","","Musnad al-Bazzar 2110","","المقداد بن عمرو بن ثعلبة البهراني عن عبد الرحمن بن أبي ليلى عن ثابت البناني عن سليمان بن المغيرة القيسي عن أبو عامر العقدي عن أبو موسى الزمن عن البزار","عبد الرحمن بن أبي ليلى عن المقداد"
"2120","[6/44]      عُبَيْدُ اللهِ بْنُ عَدِيِّ بْنِ الْخِيَارِ  عَنِ  الْمِقْدَادِ  2111  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ الْمِنْقَرِيُّ قَالَ :  نَا  عَبْدُ الْكَبِيرِ بْنُ عَبْدِ الْمَجِيدِ قَالَ :  نَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ قَالَ :  نَا  الزُّهْرِيُّ ،  عَنْ  عَطَاءِ بْنِ يَزِيدَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَدِيِّ بْنِ الْخِيَارِ ،  عَنِ  الْمِقْدَادِ بْنِ عَمْرٍو الْكِنْدِيِّ - وَكَانَ مِمَّنْ شَهِدَ  بَدْرًا  - أَنَّهُ أَخْبَرَهُ أَنَّهُ قَالَ :  يَا رَسُولَ اللهِ ، أَرَأَيْتَ رَجُلًا لَقِيتُهُ فَقَاتَلَنِي ، فَقَطَعَ إِحْدَى يَدَيَّ ، ثُمَّ لَاذَ مِنِّي بِشَجَرَةٍ فَقَالَ : أَسْلَمْتُ لِلهِ أَفَأَقْتُلُهُ يَا رَسُولَ اللهِ ؟ قَالَ :  إِنْ قَتَلْتَهُ فَهُوَ بِمَنْزِلَتِكَ قَبْلَ أَنْ تُقَاتِلَهُ  ، وَأَنْتَ بِمَنْزِلَتِهِ قَبْلَ أَنْ يَقُولَ كَلِمَتَهُ الَّتِي قَالَ  .         [6/45]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنِ  الْمِقْدَادِ  إِلَّا بِهَذَا  الْإِسْنَادِ  ، وَقَدْ رَوَاهُ عَنِ  الزُّهْرِيِّ  غَيْرُ وَاحِدٍ فَاجْتَزَيْنَا  بِعَبْدِ الْحَمِيدِ  .","","Musnad al-Bazzar 2111","","المقداد بن عمرو بن ثعلبة البهراني عن عبيد الله بن عدي بن الخيار النوفلي عن عطاء بن يزيد الجندعي عن الزهري عن عبد الحميد بن جعفر الأوسي عن عبد الكبير بن عبد المجيد الحنفي عن عبد الله بن محمد المنقري عن البزار","عبيد الله بن عدي بن الخيار عن المقداد"
"2121","[6/46]      جُبَيْرُ بْنُ نُفَيْرٍ  عَنِ  الْمِقْدَادِ  2112  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مِسْكِينٍ قَالَ :  نَا  عَبْدُ اللهِ بْنُ صَالِحٍ قَالَ :  نَا  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرِ بْنِ نُفَيْرٍ ،  عَنْ  أَبِيهِ  قَالَ :  جَاءَ الْمِقْدَادُ بْنُ الْأَسْوَدِ فِي حَاجَةٍ ،  فَقُلْنَا  : اجْلِسْ حَتَّى نَطْلُبَ لَكَ حَاجَتَكَ فَجَلَسَ ، فَقَالَ : عَجِبْتُ لِقَوْمٍ مَرَرْتُ بِهِمْ يَتَمَنَّوْنَ الْفِتَنَ يَزْعُمُونَ لَيُبْلِيَنَّهُمُ اللهُ فِيهَا مَا أَبْلَى رَسُولَهُ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَصْحَابَهُ رَضِيَ اللهُ عَنْهُمْ ، وَلَقَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ السَّعِيدَ لَمَنْ جُنِّبَ الْفِتَنَ  ، إِنَّ السَّعِيدَ لَمَنْ جُنِّبَ الْفِتَنَ - يُرَدِّدُهَا ثَلَاثَ مَرَّاتٍ - إِلَّا مَنِ ابْتُلِيَ فَصَبَرَ "" وَايْمُ اللهِ لَا أَشْهَدُ لِأَحَدٍ أَنَّهُ مِنْ أَهْلِ الْجَنَّةِ حَتَّى أَعْلَمَ مَا يَمُوتُ عَلَيْهِ بَعْدَ حَدِيثٍ سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : "" لَقَلْبُ ابْنِ آدَمَ أَشَدُّ انْقِلَابًا مِنَ الْقِدْرِ إِذَا غَلِيَتْ  .         [6/47]      وَهَذَا الْكَلَامُ لَا نَحْفَظُهُ إِلَّا عَنِ  الْمِقْدَادِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِلَّا رَجُلٌ قَلَبَهُ فَجَعَلَهُ عَنِ  الْمِقْدَامِ  ، وَالصَّوَابُ عِنْدَنَا هُوَ  الْمِقْدَادُ  ،  وَإِسْنَادُهُ  إِسْنَادٌ حَسَنٌ  .","","Musnad al-Bazzar 2112","","المقداد بن عمرو بن ثعلبة البهراني عن جبير بن نفير بن مالك الحضرمي عن عبد الرحمن بن جبير الحضرمي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن محمد بن مسكين بن نميلة اليمامي عن البزار","جبير بن نفير عن المقداد"
"2122","[6/48]      أَبُو مَعْمَرٍ  عَنِ  الْمِقْدَادِ  2113  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ قَالَ :  نَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  سُفْيَانَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنِ  الْمِقْدَادِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  إِذَا رَأَيْتُمُ الْمَدَّاحِينَ  فَاحْثُوا  فِي وُجُوهِهِمُ  التُّرَابَ  .  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ  الثَّوْرِيُّ  ،  وَقَيْسٌ  ، عَنْ  حَبِيبٍ  ، عَنْ         [6/49]      مُجَاهِدٍ  ، عَنْ  أَبِي مَعْمَرٍ  ، عَنِ  الْمِقْدَادِ  .","","Musnad al-Bazzar 2113","","المقداد بن عمرو بن ثعلبة البهراني عن عبد الله بن سخبرة عن مجاهد بن جبر المخزومي عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن عبد الرحمن بن مهدي عن محمد بن بشار بندار عن البزار","أبو معمر عن المقداد"
"2123","2114  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْكُوفِيُّ قَالَ :  نَا  مُخَوَّلُ بْنُ إِبْرَاهِيمَ قَالَ :  نَا  قَيْسٌ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنِ  الْمِقْدَادِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2114","","المقداد بن عمرو بن ثعلبة البهراني عن عبد الله بن سخبرة عن مجاهد بن جبر المخزومي عن حبيب بن أبي ثابت الكاهلي عن قيس بن الربيع الأسدي عن مخول بن إبراهيم الكوفي عن أحمد بن يحيى بن زكريا عن البزار","أبو معمر عن المقداد"
"2124","[6/50]      أَبُو طَيْبَةَ الْكَلَاعِيُّ  عَنِ  الْمِقْدَادِ  2115  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ حَبِيبِ بْنِ الشَّهِيدِ قَالَ :  نَا  مُحَمَّدُ بْنُ فُضَيْلٍ قَالَ :  نَا  مُحَمَّدُ بْنُ سَعْدٍ الْأَنْصَارِيُّ قَالَ :  سَمِعْتُ  أَبَا طَيْبَةَ الْكَلَاعِيَّ يَقُولُ :  سَمِعْتُ  الْمِقْدَادَ بْنَ عَمْرِو بْنِ الْأَسْوَدِ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِأَصْحَابِهِ : ""  مَا تَقُولُونَ فِي الزِّنَا ؟  ، قَالُوا : حَرَامٌ حَرَّمَهُ اللهُ وَرَسُولُهُ ، فَهُوَ حَرَامٌ إِلَى يَوْمِ الْقِيَامَةِ قَالَ : "" لَأَنْ يَزْنِيَ الرَّجُلُ بِعَشَرَةِ نِسْوَةٍ أَيْسَرُ عَلَيْهِ مِنْ أَنْ يَزْنِيَ بِامْرَأَةِ جَارِهِ ، مَا تَقُولُونَ فِي السَّرِقَةِ ؟ "" قَالُوا : حَرَامٌ حَرَّمَهُ اللهُ وَرَسُولُهُ ، فَهُوَ حَرَامٌ إِلَى يَوْمِ الْقِيَامَةِ قَالَ : "" لَأَنْ يَسْرِقَ الرَّجُلُ مِنْ عَشَرَةِ أَبْيَاتٍ أَيْسَرُ عَلَيْهِ مِنْ أَنْ يَسْرِقَ مِنْ بَيْتِ جَارِهِ  .         [6/51]      وَهَذَا الْحَدِيثُ لَا نَحْفَظُ أَحَدًا رَوَاهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا  الْمِقْدَادُ  .","","Musnad al-Bazzar 2115","","المقداد بن عمرو بن ثعلبة البهراني عن أبو ظبية السلفي عن محمد بن سعد الأنصاري عن محمد بن فضيل بن غزوان عن إسحاق بن إبراهيم الشهيدي عن البزار","أبو طيبة الكلاعي عن المقداد"
"2125","[6/52]      ضُبَاعَةُ بِنْتُ الزُّبَيْرِ  عَنِ  الْمِقْدَادِ  2116  -  حَدَّثَنَا  أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ قَالَ :  نَا  خَالِدُ بْنُ مَخْلَدٍ قَالَ :  نَا  مُوسَى بْنُ يَعْقُوبَ قَالَ :  حَدَّثَتْنِي  عَمَّتِي ،  قَرِيبَةُ بِنْتُ عَبْدِ اللهِ ،  عَنْ  أُمِّهَا كَرِيمَةَ بِنْتِ الْمِقْدَادِ بْنِ عَمْرٍو  ،  عَنْ  ضُبَاعَةَ بِنْتِ الزُّبَيْرِ ، وَكَانَتْ تَحْتَ  الْمِقْدَادِ بْنِ عَمْرٍو  ، قَالَتْ :  كَانَ النَّاسُ إِنَّمَا يَذْهَبُونَ فِي الْيَوْمَيْنِ وَالثَّلَاثَةِ فَيَبْعَرُونَ كَمَا تَبْعَرُ الْإِبِلُ ، فَلَمَّا كَانَ ذَاتَ يَوْمٍ خَرَجَ  الْمِقْدَادُ  لِحَاجَتِهِ حَتَّى أَتَى  الْبَقِيعَ - وَهُوَ بَقِيعُ الْغَرْقَدِ  - فَدَخَلَ خَرِبَةً لِحَاجَتِهِ ، فَبَيْنَمَا هُوَ جَالِسٌ إِذْ خَرَجَ جُرَذٌ مِنْ جُحْرٍ فَأَخْرَجَ دِينَارًا فَلَمْ يَزَلْ يُخْرِجُ دِينَارًا دِينَارًا حَتَّى أَخْرَجَ سَبْعَةَ عَشَرَ دِينَارًا ، ثُمَّ أَخْرَجَ طَرَفَ خِرْقَةٍ ،  قَالَ  الْمِقْدَادُ : فَقُمْتُ فَأَخَذْتُهَا فَوَجَدْتُ فِيهَا دِينَارًا فَتَمَّتْ ثَمَانِيَةَ عَشَرَ دِينَارًا ، فَخَرَجْتُ بِهَا حَتَّى أَتَيْتُ بِهَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرْتُهُ خَبَرَهَا ، فَقَالَ :  هَلْ أَتْبَعْتَ يَدَكَ الْجُحْرَ ؟  فَقُلْتُ : لَا ، وَالَّذِي بَعَثَكَ بِالْحَقِّ ، قَالَ : "" لَا صَدَقَةَ فِيهَا         [6/53]      بَارَكَ اللهُ لَكَ فِيهَا "" ، فَمَا فَرَغَ آخِرُهَا حَتَّى رَأَيْتُ غَرَائِرَ الْوَرِقِ فِي بَيْتِ  الْمِقْدَادِ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُ رَوَاهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا  الْمِقْدَادُ  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا عَنِ  الْمِقْدَادِ  إِلَّا هَذَا الطَّرِيقَ ،  وَمُوسَى بْنُ يَعْقُوبَ  هَذَا رَجُلٌ مَشْهُورٌ مِنْ  أَهْلِ الْمَدِينَةِ  ،  وَقُرَيْبَةُ هَذِهِ بِنْتُ عَبْدِ اللهِ بْنِ وَهْبِ بْنِ زَمْعَةَ  ،  وَكَرِيمَةُ بِنْتُ الْمِقْدَادِ  لَا نَعْلَمُ رَوَى عَنْهَا إِلَّا  قَرِيبَةُ بِنْتُ عَبْدِ اللهِ  .","","Musnad al-Bazzar 2116","","المقداد بن عمرو بن ثعلبة البهراني عن ضباعة بنت الزبير الهاشمية عن كريمة بنت المقداد الكندية عن قريبة بنت عبد الله بن وهب الأسدية عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن خالد بن مخلد القطواني عن أحمد بن عثمان بن حكيم عن البزار","ضباعة بنت الزبير عن المقداد"
"2126","2117  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  مُحَمَّدُ بْنُ خَالِدِ بْنِ عَثْمَةَ قَالَ :  نَا  مُوسَى بْنُ يَعْقُوبَ قَالَ :  حَدَّثَتْنِي  عَمَّتِي  قَرِيبَةُ بِنْتُ عَبْدِ اللهِ ،  عَنْ  أُمِّهَا كَرِيمَةَ بِنْتِ الْمِقْدَادِ  ،  عَنْ  ضُبَاعَةَ بِنْتِ الزُّبَيْرِ ،  عَنِ  الْمِقْدَادِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنِّي لَأَرْجُو لَهُمْ -  يَعْنِي لِأَزْوَاجِهِ  - الصِّدِّيقِينَ  ، قُلْنَا : يَا رَسُولَ اللهِ ، مَنِ الصِّدِّيقُونَ ، أَهُمْ أَوْلَادُ         [6/54]      الَّذِينَ يَهْلِكُونَ ، وَهُمْ صِغَارٌ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" الصِّدِّيقُونَ هُمُ الْمُتَصَدِّقُونَ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِهَذَا اللَّفْظِ إِلَّا  الْمِقْدَادُ  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا عَنْهُ إِلَّا هَذَا الطَّرِيقَ .","","Musnad al-Bazzar 2117","","المقداد بن عمرو بن ثعلبة البهراني عن ضباعة بنت الزبير الهاشمية عن كريمة بنت المقداد الكندية عن قريبة بنت عبد الله بن وهب الأسدية عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن محمد بن خالد بن عثمة الهاشمى عن أبو موسى الزمن عن البزار","ضباعة بنت الزبير عن المقداد"
"2127","2118  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ شَبِيبٍ قَالَ :  نَا  عَبْدُ الْجَبَّارِ بْنُ سَعِيدٍ الْمُسَاحِقِيُّ قَالَ :  نَا  يَحْيَى بْنُ مُحَمَّدِ بْنِ هَانِئٍ قَالَ :  حَدَّثَنِي  مُوسَى بْنُ يَعْقُوبَ قَالَ :  حَدَّثَتْنِي  عَمَّتِي  قَرِيبَةُ بِنْتُ عَبْدِ اللهِ ،  عَنْ  أُمِّهَا كَرِيمَةَ  ،  عَنْ  ضُبَاعَةَ بِنْتِ الزُّبَيْرِ ،  عَنِ  الْمِقْدَادِ ، "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ""  أَعْطَى لِلْفَرَسِ سَهْمَيْنِ وَلِصَاحِبِهِ سَهْمًا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنِ  الْمِقْدَادِ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2118","","المقداد بن عمرو بن ثعلبة البهراني عن ضباعة بنت الزبير الهاشمية عن كريمة بنت المقداد الكندية عن قريبة بنت عبد الله بن وهب الأسدية عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن يحيى بن محمد بن عباد الشجري عن عبد الجبار بن سعيد المساحقي عن عبد الله بن شبيب الربعي عن البزار","ضباعة بنت الزبير عن المقداد"
"2128","[6/55]      مُسْنَدُ  خَبَّابِ بْنِ الْأَرَتِّ  رَضِيَ اللهُ عَنْهُ         [6/56]             [6/57]      مُسْنَدُ  خَبَّابِ بْنِ الْأَرَتِّ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَسُ بْنُ مَالِكٍ  عَنْ  خَبَّابٍ  2119  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الْبَرْمَكِيُّ قَالَ :  نَا  إِسْحَاقُ بْنُ يُوسُفَ قَالَ :  نَا  الْقَاسِمُ بْنُ عُثْمَانَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  عَنْ  خَبَّابِ بْنِ الْأَرَتِّ قَالَ سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : ""  اللَّهُمَّ أَعِزَّ الْإِسْلَامَ بِأَحَبِّ الرَّجُلَيْنِ إِلَيْكَ  بِعُمَرَ بْنِ الْخَطَّابِ  أَوْ  بِأَبِي جَهْلِ بْنِ هِشَامٍ  .  وَلَا نَعْلَمُ رَوَى  أَنَسُ بْنُ مَالِكٍ  عَنْ  خَبَّابٍ  إِلَّا هَذَا الْحَدِيثَ ، وَلَا لَهُ  إِسْنَادًا  عَنْ  أَنَسٍ  إِلَّا هَذَا  الْإِسْنَادَ  .","","Musnad al-Bazzar 2119","","خباب بن الأرت التميمي عن أنس بن مالك عن قاسم بن عثمان الرحال عن إسحاق بن يوسف الأزرق عن عبد الله بن جعفر بن يحيى البرمكي عن البزار","أنس بن مالك عن خباب"
"2129","[6/58]      أَبُو أُمَامَةَ  عَنْ  خَبَّابٍ  2120  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ الشَّيْبَانِيُّ قَالَ :  نَا  عَبْدُ اللهِ بْنُ وَهْبٍ قَالَ :  نَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ زُحْرٍ ،  عَنْ  عَلِيِّ بْنِ يَزِيدَ ،  عَنِ  الْقَاسِمِ ،  عَنْ  أَبِي أُمَامَةَ ،  عَنْ  خَبَّابٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَدْخُلُ الْجَنَّةَ مِنْ أُمَّتِي سَبْعُونَ أَلْفًا بِغَيْرِ حِسَابٍ  ، هُمُ الَّذِينَ لَا  يَكْتَوُونَ  وَلَا  يَسْتَرْقُونَ  -  وَأَحْسَبُهُ قَالَ - وَلَا يَتَطَيَّرُونَ  ، وَعَلَى رَبِّهِمْ يَتَوَكَّلُونَ "" .","","Musnad al-Bazzar 2120","","خباب بن الأرت التميمي عن أبو أمامة الباهلي عن القاسم بن عبد الرحمن الدمشقي عن علي بن يزيد الألهاني عن عبيد الله بن زحر الضمري عن يحيى بن أيوب الغافقي عن عبد الله بن وهب المصري عن عمر بن حفص بن صبيح الشيباني عن البزار","أبو أمامة عن خباب"
"2130","2121  -  وَنَا  عُمَرُ بْنُ حَفْصٍ قَالَ :  نَا  عَبْدُ اللهِ بْنُ وَهْبٍ قَالَ :  نَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ زَحْرٍ ،  عَنْ  عَلِيِّ بْنِ يَزِيدَ ،  عَنِ         [6/59]      الْقَاسِمِ ،  عَنْ  أَبِي أُمَامَةَ ،  عَنْ  خَبَّابٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ الْمُؤْمِنَ يُؤْجَرُ فِي كُلِّ شَيْءٍ إِلَّا الْبِنَاءَ فِي هَذَا التُّرَابِ  .","","Musnad al-Bazzar 2121","","خباب بن الأرت التميمي عن أبو أمامة الباهلي عن القاسم بن عبد الرحمن الدمشقي عن علي بن يزيد الألهاني عن عبيد الله بن زحر الضمري عن يحيى بن أيوب الغافقي عن عبد الله بن وهب المصري عن عمر بن حفص بن صبيح الشيباني عن البزار","أبو أمامة عن خباب"
"2131","[6/60]      عَبْدُ اللهِ بْنُ خَبَّابٍ  عَنْ أَبِيهِ  خَبَّابٍ  2122  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورِ بْنِ سَيَّارٍ قَالَ :  نَا  عَبْدُ الرَّزَّاقِ قَالَ :  أَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ خَبَّابٍ ،  عَنْ  أَبِيهِ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى صَلَاةً فَأَطَالَهَا ، فَقِيلَ لَهُ : لَقَدْ أَطَلْتَهَا قَالَ :  إِنِّي صَلَّيْتُ صَلَاةَ رَغْبَةٍ  وَرَهْبَةٍ  ، سَأَلْتُ رَبِّي فِيهَا ثَلَاثًا فَأَعْطَانِي اثْنَتَيْنِ وَمَنَعَنِي وَاحِدَةً  : سَأَلْتُهُ أَنْ لَا يُعَذِّبَهُمْ بِعَذَابٍ أَهْلَكَ بِهِ مَنْ كَانَ قَبْلَهُمْ فَأَعْطَانِيهَا ، وَسَأَلْتُهُ أَنْ لَا يُسَلِّطَ عَلَيْهِمْ عَدُوًّا  فَيَسْتَبِيحَهُمْ  فَأَعْطَانِيهَا ، وَسَأَلْتُهُ أَنْ لَا يَلْبِسَهُمْ  شِيَعًا  وَيُذِيقَ بَعْضَهُمْ بَأْسَ بَعْضٍ فَمَنَعَنِيهَا  .         [6/61]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى ، عَنْ  خَبَّابٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2122","","خباب بن الأرت التميمي عن عبد الله بن خباب بن الأرت التميمي عن عبد الله بن عبد الله بن الحارث بن نوفل الهاشمي عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن أحمد بن منصور الرمادي عن البزار","عبد الله بن خباب عن أبيه خباب"
"2132","2123  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ قَالَ :  نَا  رَوْحُ بْنُ عُبَادَةَ قَالَ :  نَا  أَبُو يُونُسَ وَاسْمُهُ حَاتِمُ بْنُ أَبِي صَغِيرَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ خَبَّابٍ ،  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  تَكُونُ عَلَيْكُمْ أُمَرَاءُ يَكْذِبُونَ وَيَظْلِمُونَ  فَمَنْ أَنْكَرَ فَقَدْ بَرِئَ ، وَمَنْ كَرِهَ فَقَدْ سَلِمَ ، وَلَكِنْ مَنْ رَضِيَ وَتَابَعَ "" ، قَالُوا : أَفَلَا نَقْتُلُهُمْ ؟ قَالَ : "" لَا ، مَا أَقَامُوا الصَّلَاةَ "" .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ لَهُ طَرِيقًا عَنْ  خَبَّابٍ  إِلَّا هَذَا الطَّرِيقَ .","","Musnad al-Bazzar 2123","","خباب بن الأرت التميمي عن عبد الله بن خباب بن الأرت التميمي عن سماك بن حرب البكري عن حاتم بن أبي صغيرة القشيري عن روح بن عبادة القيسي عن محمد بن معمر بن ربعي البحراني عن البزار","عبد الله بن خباب عن أبيه خباب"
"2133","[6/62]      مَسْرُوقُ بْنُ الْأَجْدَعِ  عَنْ  خَبَّابٍ  2124  -  حَدَّثَنَا  رِزْقُ اللهِ بْنُ مُوسَى قَالَ :  نَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ قَالَ :  نَا  الْأَعْمَشُ قَالَ :  نَا  أَبُو الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  خَبَّابٍ قَالَ :  كُنْتُ امْرَءًا  قَيْنًا  وَكَانَ لِي عَلَى  الْعَاصِ بْنِ وَائِلٍ  دَيْنٌ فَأَتَيْتُهُ أَتَقَاضَاهُ ، فَقَالَ : لَا أَقْضِيكَ حَتَّى تَكْفُرَ  بِمُحَمَّدٍ  ، قُلْتُ : لَا أَكْفُرُ بِهِ حَتَّى تَمُوتَ ثُمَّ تَحْيَى ثُمَّ تَمُوتَ قَالَ : فَأَنْتَ تَزْعُمُ أَنِّي أَحْيَا فَهُنَاكَ يَكُونُ لِي مَالٌ وَوَلَدٌ فَأَقْضِيكَ قَالَ : فَأَنْزَلَ اللهُ تَبَارَكَ وَتَعَالَى :         {      أَفَرَأَيْتَ الَّذِي كَفَرَ بِآيَاتِنَا وَقَالَ لأُوتَيَنَّ مَالا وَوَلَدًا             *          أَطَّلَعَ الْغَيْبَ أَمِ اتَّخَذَ عِنْدَ الرَّحْمَنِ عَهْدًا             *          كَلا سَنَكْتُبُ مَا يَقُولُ وَنَمُدُّ لَهُ مِنَ الْعَذَابِ مَدًّا             *          وَنَرِثُهُ مَا يَقُولُ وَيَأْتِينَا فَرْدًا         }      .         [6/63]      وَلَا نَعْلَمُ رَوَى  مَسْرُوقٌ  ، عَنْ  خَبَّابٍ  إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 2124","","خباب بن الأرت التميمي عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن عبد الله بن نمير عن رزق الله بن موسى الناجي عن البزار","مسروق بن الأجدع عن خباب"
"2134","[6/64]      قَيْسُ بْنُ أَبِي حَازِمٍ  عَنْ  خَبَّابٍ  2125  -  حَدَّثَنَا  أَبُو كُرَيْبٍ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ قَالَ :  دَخَلْنَا عَلَى خَبَّابٍ وَقَدِ اكْتَوَى ، فَقَالَ :  لَوْلَا أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَانَا أَنْ نَدْعُوَ بِالْمَوْتِ لَدَعَوْتُ بِهِ  .  قَالَ : وَسَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : ""  إِنَّ الْمُؤْمِنَ يُؤْجَرُ فِي كُلِّ شَيْءٍ إِلَّا الْبِنَاءَ فِي هَذَا التُّرَابِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا  رَفَعَهُ  عَنْ  إِسْمَاعِيلَ  عَنْ  قَيْسٍ  مِنْ أَوَّلِهِ إِلَى آخِرِهِ إِلَّا  أَبُو مُعَاوِيَةَ  ، وَقَدْ رَوَى غَيْرُ وَاحِدٍ صَدْرَ الْحَدِيثِ ، عَنْ  إِسْمَاعِيلَ  ، عَنْ  قَيْسٍ  ، عَنْ  خَبَّابٍ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَانَا أَنْ نَدْعُوَ بِالْمَوْتِ ، وَأَمَّا أَنَّ "" الْمُؤْمِنَ يُؤْجَرُ فِي كُلِّ شَيْءٍ إِلَّا         [6/65]      الْبِنَاءَ فِي هَذَا التُّرَابِ "" فَلَا نَعْلَمُ أَحَدًا جَمَعَهَا إِلَّا  أَبُو مُعَاوِيَةَ  .","","Musnad al-Bazzar 2125","","خباب بن الأرت التميمي عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن أبو معاوية الضرير عن أبو كريب محمد بن العلاء عن البزار","قيس بن أبي حازم عن خباب"
"2135","2126  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ الْعُقَيْلِيُّ ، وَأَحْمَدُ بْنُ عَبْدَةَ ، وَعَبْدُ الْأَعْلَى بْنُ زَيْدٍ ، كُلُّهُمْ  حَدَّثُونَا  ،  عَنْ  سُفْيَانَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي         [6/66]      خَالِدٍ ، وَبَيَانٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  خَبَّابٍ قَالَ :  أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ قَاعِدٌ عِنْدَ  الْكَعْبَةِ  مُتَوَسِّدٌ رِدَاءَهُ ، فَقَالَ :  إِنَّكُمْ مَنْصُورُونَ  وَقَالَ : "" إِنْ كَانَ مَنْ كَانَ قَبْلَكُمْ لَيُمْشَطُ بِأَمْشَاطِ الْحَدِيدِ مَا دُونَ الْعَظْمِ مِنَ اللَّحْمِ مَا يَصْرِفُهُ ذَلِكَ عَنْ دِينِهِ "" .         [6/67]","","Musnad al-Bazzar 2126","","خباب بن الأرت التميمي عن قيس بن أبي حازم عن بيان بن بشر الأحمسي عن سفيان بن عيينة عن عبد الأعلى بن زيد عن البزار","قيس بن أبي حازم عن خباب"
"2136","2127  -  وَنَاهُ  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  يَحْيَى بْنِ سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُغِيرَةِ بْنِ عَبْدِ اللهِ الْيَشْكُرِيِّ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  خَبَّابٍ قَالَ :  أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ قَاعِدٌ عِنْدَ  الْكَعْبَةِ  مُتَوَسِّدٌ رِدَاءَهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ كَانَ مَنْ كَانَ قَبْلَكُمْ لَيُمْشَطُ بِأَمْشَاطِ الْحَدِيدِ  مَا دُونَ الْعَظْمِ مِنَ اللَّحْمِ مَا يَصْرِفُهُ ذَلِكَ عَنْ دِينِهِ  .  وَهَذَا الْحَدِيثُ عَنْ  خَبَّابٍ  لَا نَعْلَمُ لَهُ طَرِيقًا إِلَّا هَذَيْنِ الطَّرِيقَيْنِ .  وَحَدِيثُ  الْمُغِيرَةِ بْنِ عَبْدِ اللهِ  ، فَلَا نَعْلَمُ رَوَاهُ إِلَّا  مُحَمَّدُ بْنُ الْحَسَنِ الْأَسَدِيُّ  ، عَنْ  يَحْيَى بْنِ سَلَمَةَ  ، عَنْ أَبِيهِ وَلَا نَعْلَمُ رَوَى  سَلَمَةُ  عَنِ  الْمُغِيرَةِ بْنِ عَبْدِ اللهِ  إِلَّا هَذَا الْحَدِيثَ ، وَلَا رَوَى حَدِيثَ  بَيَانٍ  ، عَنْ  قَيْسٍ  ، عَنْ  خَبَّابٍ  إِلَّا  سُفْيَانُ بْنُ عُيَيْنَةَ  فَإِنَّهُ جَمَعَ بَيْنَ  إِسْمَاعِيلَ  وَبَيَانٍ  .","","Musnad al-Bazzar 2127","","خباب بن الأرت التميمي عن قيس بن أبي حازم عن المغيرة بن عبد الله بن أبي عقيل اليشكري عن سلمة بن كهيل الحضرمي عن يحيى بن سلمة بن كهيل عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن البزار","قيس بن أبي حازم عن خباب"
"2137","2128  -  وَنَا  الْوَلِيدُ بْنُ عَمْرِو بْنِ سُكَيْنٍ قَالَ :  نَا  عَمْرُو بْنُ النَّضْرِ ، قَالَ :  نَا  إِسْمَاعِيلُ ،  عَنْ  قَيْسٍ ،  عَنْ  خَبَّابٍ قَالَ :  كُنْتُ أَصْنَعُ الْعَنَزَ         [6/68]      لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  قَالَ أَبُو بَكْرٍ :  قَوْلُ  خَبَّابٍ  : كُنْتُ أَصْنَعُ الْعَنَزَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَعْنِي  الْعَنَزَةَ  مِنْهَا الَّتِي قَدْ رَوَى فِيهَا أَنَّهُ كَانَ يُصَلِّي إِلَيْهَا شَبِيهًا بِالْعُكَّازِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  إِسْمَاعِيلَ  ، عَنْ  قَيْسٍ  ، عَنْ  خَبَّابٍ  إِلَّا  يَزِيدُ بْنُ عَطَاءٍ  ،  وَعَمْرُو بْنُ النَّضْرِ  .","","Musnad al-Bazzar 2128","","خباب بن الأرت التميمي عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عمرو بن النضر البصري عن الوليد بن عمرو بن السكين الضبعي عن البزار","قيس بن أبي حازم عن خباب"
"2138","[6/69]      أَبُو الْكَنُودِ  عَنْ  خَبَّابٍ  2129  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ عَمْرٍو الْعَنْقَزِيُّ قَالَ :  نَا  أَبِي  قَالَ :  نَا  أَسْبَاطُ بْنُ نَصْرٍ ،  عَنِ  السُّدِّيِّ ،  عَنْ  أَبِي سَعْدٍ ،  عَنْ  أَبِي الْكَنُودِ ،  عَنْ  خَبَّابٍ .","","Musnad al-Bazzar 2129","","خباب بن الأرت التميمي عن أبو الكنود الأزدي عن أبو سعد الأزدي عن السدي الكبير عن أسباط بن نصر الهمداني عن عمرو بن محمد الأحمر عن الحسين بن عمرو بن محمد العنقزي عن البزار","أبو الكنود عن خباب"
"2139","2130  -  وَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  نَا  أَحْمَدُ بْنُ الْمُفَضَّلِ قَالَ :  نَا  أَسْبَاطُ بْنُ نَصْرٍ ،  عَنِ  السُّدِّيِّ ،  عَنْ  أَبِي سَعْدٍ الْأَزْدِيِّ ،  عَنْ  أَبِي الْكَنُودِ ،  عَنْ  خَبَّابِ بْنِ الْأَرَتِّ ،  فِي قَوْلِ اللهِ تَبَارَكَ وَتَعَالَى :         {      وَلا تَطْرُدِ الَّذِينَ يَدْعُونَ رَبَّهُمْ بِالْغَدَاةِ وَالْعَشِيِّ يُرِيدُونَ وَجْهَهُ         }      .         [6/70]      قَالَ : جَاءَ  عُيَيْنَةُ بْنُ حِصْنٍ  ،  وَالْأَقْرَعُ بْنُ حَابِسٍ  ، فَوَجَدُوا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَاعِدًا مَعَ  بِلَالٍ  وَعَمَّارٍ  وَصُهَيْبٍ  وَخَبَّابِ بْنِ الْأَرَتِّ  فِي نَاسٍ مِنَ الضُّعَفَاءِ مِنَ الْمُؤْمِنِينَ ، فَلَمَّا رَأَوْهُمْ حَوْلَهُ حَقَرُوهُمْ ، فَأَتَوْهُ فَخَلَوْا بِهِ ، فَقَالُوا : إِنَّا نُحِبُّ أَنْ تَجْعَلَ لَنَا مِنْكَ نَصِيبًا تَعْرِفُ لَنَا بِهِ الْعَرَبُ ، فَإِنَّ وُفُودَ الْعَرَبِ تَأْتِيكَ ، وَنَسْتَحِي أَنْ تَرَانَا الْعَرَبُ مَعَ هَذِهِ الْأَعْبُدِ ، فَإِذَا نَحْنُ جِئْنَاكَ فَأَقِمْهُمْ ، فَإِذَا نَحْنُ فَرَغْنَا فَأَقْعِدْهُمْ إِنْ شِئْتَ ، فَقَالَ : نَعَمْ ، فَقَالُوا : اكْتُبْ لَنَا كِتَابًا ، فَدَعَا بِالصَّحِيفَةِ لِيَكْتُبَ لَهُمْ ، وَدَعَا  عَلِيًّا  لِيَكْتُبَ لَهُمْ ، وَنَحْنُ قُعُودٌ فِي نَاحِيَةٍ إِذْ نَزَلَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ بِهَذِهِ الْآيَةِ :         {      وَلا تَطْرُدِ الَّذِينَ يَدْعُونَ رَبَّهُمْ بِالْغَدَاةِ وَالْعَشِيِّ يُرِيدُونَ وَجْهَهُ مَا عَلَيْكَ مِنْ حِسَابِهِمْ مِنْ شَيْءٍ وَمَا مِنْ حِسَابِكَ عَلَيْهِمْ مِنْ شَيْءٍ فَتَطْرُدَهُمْ فَتَكُونَ مِنَ الظَّالِمِينَ         }      ؛ ثُمَّ ذَكَرَ  الْأَقْرَعَ  وَصَاحِبَهُ فَقَالَ :         {      وَكَذَلِكَ فَتَنَّا بَعْضَهُمْ بِبَعْضٍ لِيَقُولُوا أَهَؤُلاءِ مَنَّ اللهُ عَلَيْهِمْ مِنْ بَيْنِنَا أَلَيْسَ اللهُ بِأَعْلَمَ بِالشَّاكِرِينَ         }      ؛ ثُمَّ ذَكَرَ فَقَالَ :         {      وَإِذَا جَاءَكَ الَّذِينَ يُؤْمِنُونَ بِآيَاتِنَا فَقُلْ سَلامٌ عَلَيْكُمْ كَتَبَ رَبُّكُمْ عَلَى نَفْسِهِ الرَّحْمَةَ أَنَّهُ مَنْ عَمِلَ مِنْكُمْ سُوءًا         }      ، فَرَمَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالصَّحِيفَةِ جَانِبًا فَمَا أَنْسَى وَهُوَ يَقُولُ : "" سَلَامٌ عَلَيْكُمْ "" فَدَنَوْنَا يَوْمَئِذٍ مِنْهُ حَتَّى وَضَعْنَا رُكَبَنَا عَلَى رُكْبَتِهِ ، وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَجْلِسُ مَعَنَا قَبْلَ ذَلِكَ فَإِذَا أَرَادَ أَنْ يَقُومَ قَامَ وَتَرَكَنَا ، فَأَنْزَلَ اللهُ تَعَالَى         {      وَاصْبِرْ نَفْسَكَ مَعَ الَّذِينَ يَدْعُونَ رَبَّهُمْ بِالْغَدَاةِ وَالْعَشِيِّ يُرِيدُونَ وَجْهَهُ وَلا تَعْدُ عَيْنَاكَ عَنْهُمْ تُرِيدُ زِينَةَ الْحَيَاةِ الدُّنْيَا         }             [6/71]      يَقُولُ : مَجَالِسُ الْأَشْرَافِ ؛         {      وَلا تُطِعْ مَنْ أَغْفَلْنَا قَلْبَهُ عَنْ ذِكْرِنَا وَاتَّبَعَ هَوَاهُ وَكَانَ أَمْرُهُ فُرُطًا         }      ، وَأَمَّا مَنْ أَغْفَلْنَا قَلْبَهُ فَهُوَ  عُيَيْنَةُ  وَالْأَقْرَعُ بْنُ حَابِسٍ  ، وَأَمَّا فُرُطًا فَهَلَاكًا ، ثُمَّ ضَرَبَ لَهُمْ مَثَلًا رَجُلَيْنِ وَمَثَلَ الْحَيَاةِ الدُّنْيَا قَالَ : فَكُنَّا نَقْعُدُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَإِذَا بَلَغْنَا السَّاعَةَ الَّتِي كَانَ يَقُومُ فِيهَا أَقَمْنَا وَتَرَكْنَاهُ حَتَّى يَقُومَ مَتَى قَامَ  .         [6/72]      وَهَذَا الْحَدِيثُ بِهَذَا الْكَلَامِ لَا نَعْلَمُ رَوَاهُ إِلَّا  خَبَّابٌ  وَلَا نَعْلَمُ لَهُ طَرِيقًا عَنْ  خَبَّابٍ  إِلَّا هَذَا الطَّرِيقَ  .","","Musnad al-Bazzar 2130","","خباب بن الأرت التميمي عن أبو الكنود الأزدي عن أبو سعد الأزدي عن السدي الكبير عن أسباط بن نصر الهمداني عن أحمد بن المفضل الحفري عن يوسف بن موسى بن راشد عن البزار","أبو الكنود عن خباب"
"2140","[6/73]      أَبُو مَعْمَرٍ  عَنْ  خَبَّابٍ  2131  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  نَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنْ  أَبِي مَعْمَرٍ ، قَالَ :  قُلْنَا  لِخَبَّابٍ :  هَلْ كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ بِشَيْءٍ فِي صَلَاةِ النَّهَارِ ؟ قَالَ : "" نَعَمْ  ، قُلْنَا : فَبِمَ كُنْتُمْ تَعْرِفُونَ ذَلِكَ ؟ قَالَ : "" بِاضْطِرَابِ  لِحْيَتِهِ أَوْ لَحْيَيْهِ  .         [6/74]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ لَهُ طَرِيقًا عَنْ  خَبَّابٍ  إِلَّا هَذَا الطَّرِيقَ ، وَلَا نَعْلَمُ رَوَى  أَبُو مَعْمَرٍ  عَنْ  خَبَّابٍ  إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 2131","","خباب بن الأرت التميمي عن عبد الله بن سخبرة عن عمارة بن عمير التيمي عن الأعمش عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","أبو معمر عن خباب"
"2141","[6/75]      أَبُو وَائِلٍ  عَنْ  خَبَّابٍ  2132  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  خَبَّابٍ قَالَ : ""  هَاجَرْنَا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَوَقَعَ أَجْرُنَا عَلَى اللهِ  ، فَمِنَّا مَنْ تَعَجَّلَ ، وَمِنَّا مَنْ  أَيْنَعَتْ  لَهُ  ثَمَرَتُهُ  فَهُوَ  يَهْدِبُهَا  .         [6/76]      وَلَا نَعْلَمُ رَوَى  أَبُو وَائِلٍ  ، عَنْ  خَبَّابٍ  إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 2132","","خباب بن الأرت التميمي عن شقيق بن سلمة عن الأعمش عن أبو معاوية الضرير عن أبو موسى الزمن عن البزار","أبو وائل عن خباب"
"2142","[6/77]      عَمْرُو بْنُ شُرَحْبِيلَ  عَنْ  خَبَّابٍ  2133  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  نَا  ثَابِتُ بْنُ مُحَمَّدٍ قَالَ :  نَا  فِطْرٌ - يَعْنِي ابْنَ خَلِيفَةَ - ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ شُرَحْبِيلَ ،  قَالَ  :  دَخَلْتُ عَلَى خَبَّابٍ فِي مَرَضِهِ ، فَقَالَ : لَوْلَا أَنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا يَتَمَنَّى أَحَدُكُمُ الْمَوْتَ  - لَتَمَنَّيْتُهُ "" .  وَلَا نَعْلَمُ رَوَى  عَمْرُو بْنُ شُرَحْبِيلَ  عَنْ  خَبَّابٍ  إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 2133","","خباب بن الأرت التميمي عن عمرو بن شرحبيل الهمداني عن أبو إسحاق السبيعي عن فطر بن خليفة عن ثابت بن محمد الشيباني عن يوسف بن موسى بن راشد عن البزار","عمرو بن شرحبيل عن خباب"
"2143","[6/78]      سَعِيدُ بْنُ وَهْبٍ  عَنْ  خَبَّابٍ  2134  -  حَدَّثَنَا  الْجَرَّاحُ بْنُ مَخْلَدٍ قَالَ :  نَا  أَبُو بَكْرٍ الْحَنَفِيُّ عَبْدُ الْكَبِيرِ بْنُ عَبْدِ الْمَجِيدِ قَالَ :  نَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ وَهْبٍ ،  عَنْ  خَبَّابٍ قَالَ :  ""  شَكَوْنَا  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الرَّمْضَاءَ فَلَمْ يُشْكِنَا ،  وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي الظُّهْرَ  بِالْهَجِيرِ  .         [6/79]      وَلَا نَعْلَمُ رَوَى  سَعِيدُ بْنُ وَهْبٍ  عَنْ  خَبَّابٍ  إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 2134","","خباب بن الأرت التميمي عن سعيد بن وهب القراد عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن عبد الكبير بن عبد المجيد الحنفي عن الجراح بن مخلد عن البزار","سعيد بن وهب عن خباب"
"2144","[6/80]      حَارِثَةُ بْنُ مُضَرِّبٍ  عَنْ  خَبَّابٍ  2135  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ مُحَمَّدٍ أَبُو شَيْبَةَ قَالَ :  نَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ يُونُسَ قَالَ :  نَا  أَبُو شِهَابٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  حَارِثَةَ بْنِ مُضَرِّبٍ ،  عَنْ  خَبَّابٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَتَمَنَّى أَحَدُكُمُ الْمَوْتَ  .         [6/81]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى مِنْ حَدِيثِ  الْأَعْمَشِ  إِلَّا عَنْ  أَبِي شِهَابٍ  .","","Musnad al-Bazzar 2135","","خباب بن الأرت التميمي عن حارثة بن مضرب العبدي عن أبو إسحاق السبيعي عن الأعمش عن عبد ربه بن نافع الحناط عن أحمد بن عبد الله اليربوعي عن إبراهيم بن عبد الله أبو شيبة العبسي عن البزار","حارثة بن مضرب عن خباب"
"2145","2136  -  وَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  حَارِثَةَ بْنِ مُضَرِّبٍ ،  عَنْ  بَعْضِ أَصْحَابِهِ ،  عَنْ  خَبَّابٍ قَالَ :  شَكَوْنَا  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الرَّمْضَاءَ فَلَمْ يُشْكِنَا  .","","Musnad al-Bazzar 2136","","خباب بن الأرت التميمي عن بعض أصحاب حارثة بن مضرب العبدي عن حارثة بن مضرب العبدي عن أبو إسحاق السبيعي عن الأعمش عن عبد الرحمن بن مغراء الدوسي عن يوسف بن موسى بن راشد عن البزار","حارثة بن مضرب عن خباب"
"2146","[6/82]      الشُّيُوخُ عَنْ  خَبَّابٍ  2137  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ قَالَ :  نَا  عَبْدُ الصَّمَدِ بْنُ النُّعْمَانِ قَالَ :  نَا  كَيْسَانُ أَبُو عُمَرَ ،  عَنْ  يَزِيدَ بْنِ بِلَالٍ ،  عَنْ  عَلِيٍّ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا صُمْتُمْ فَاسْتَاكُوا بِالْغَدَاةِ وَلَا تَسْتَاكُوا بِالْعَشِيِّ  فَإِنَّ الصَّائِمَ إِذَا يَبِسَتْ شَفَتَاهُ كَانَ لَهُ نُورٌ يَوْمَ الْقِيَامَةِ "" .         [6/83]","","Musnad al-Bazzar 2137","","علي بن أبي طالب عن يزيد بن بلال بن الحارث الفزاري عن كيسان القصار عن عبد الصمد بن النعمان البغدادي عن إبراهيم بن سعيد الجوهري عن البزار","الشيوخ عن خباب"
"2147","2138  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ قَالَ :  نَا  عَبْدُ الصَّمَدِ بْنُ النُّعْمَانِ قَالَ :  نَا  كَيْسَانُ أَبُو عُمَرَ ،  عَنْ  يَزِيدَ بْنِ بِلَالٍ ،  عَنْ  خَبَّابٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ .  وَلَا نَعْلَمُ يُرْوَى هَذَا الْكَلَامُ عَنْ  خَبَّابٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2138","","خباب بن الأرت التميمي عن يزيد بن بلال بن الحارث الفزاري عن كيسان القصار عن عبد الصمد بن النعمان البغدادي عن إبراهيم بن سعيد الجوهري عن البزار","الشيوخ عن خباب"
"2148","2139  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مِسْكِينٍ قَالَ :  نَا  عَمْرُو بْنُ الرَّبِيعِ بْنِ طَارِقٍ قَالَ :  نَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ زَحْرٍ ،  عَنْ  عَلِيِّ بْنِ يَزِيدَ ،  عَنِ  الْقَاسِمِ ،  عَنْ  أَبِي أُمَامَةَ ،  عَنْ  خَبَّابٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  يَدْخُلُ الْجَنَّةَ مِنْ أُمَّتِي سَبْعُونَ أَلْفًا بِغَيْرِ حِسَابٍ  ، هُمُ الَّذِينَ لَا  يَكْتَوُونَ  وَلَا  يَسْتَرْقُونَ  - أَحْسَبُهُ قَالَ - وَلَا يَتَطَيَّرُونَ ، وَعَلَى رَبِّهِمْ يَتَوَكَّلُونَ  .  قَالَ : وَسَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : ""  الْمُؤْمِنُ يُؤْجَرُ فِي كُلِّ شَيْءٍ إِلَّا الْبِنَاءَ فِي هَذَا التُّرَابِ  .  وَلَا نَعْلَمُ رَوَى  أَبُو أُمَامَةَ  عَنْ  خَبَّابٍ  إِلَّا هَذَيْنِ الْحَدِيثَيْنِ .","","Musnad al-Bazzar 2139","","خباب بن الأرت التميمي عن أبو أمامة الباهلي عن القاسم بن عبد الرحمن الدمشقي عن علي بن يزيد الألهاني عن عبيد الله بن زحر الضمري عن يحيى بن أيوب الغافقي عن عمرو بن الربيع بن طارق الهلالي عن محمد بن مسكين بن نميلة اليمامي عن البزار","الشيوخ عن خباب"
"2149","[6/84]      بِنْتُ خَبَّابٍ  عَنْ أَبِيهَا  2140  -  حَدَّثَنَا  أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ قَالَ :  نَا  مُخَوَّلُ بْنُ إِبْرَاهِيمَ قَالَ :  نَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ ،  عَنِ  ابْنَةِ خَبَّابٍ  ،  قَالَتْ  :  خَرَجَ أَبِي فِي غَزَاةٍ وَلَمْ يَتْرُكْ لَنَا إِلَّا شَاةً فَقَالَ لَنَا : إِذَا أَرَدْتُمْ أَنْ تَحْلِبُوهَا فَإِيتُوا بِهَا  أَهْلَ الصُّفَّةِ  ، فَانْطَلَقْتُ بِهَا فَإِذَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَخَذَهَا  فَاعْتَنَقَهَا - أَوْ  فَاعْتَقَلَهَا  - فَحَلَبَ مِلْءَ الْقَدَحِ ، ثُمَّ قَالَ :  اذْهَبِي فَائْتِنِي بِأَعْظَمِ إِنَاءٍ عِنْدَكُمْ  فَمَا وَجَدْتُ إِلَّا الْجَفْنَةَ الَّتِي يُعْجَنُ فِيهَا -  أَحْسَبُ قَالَتْ : فَحَلَبَ حَتَّى مَلَأَهَا  - ثُمَّ قَالَ : "" اذْهَبُوا اشْرَبُوا وَاسْقُوا جِيرَانَكُمْ ، وَإِذَا أَرَدْتَ أَنْ تَحْلُبَهَا         [6/85]      ائْتِنِي بِهَا "" ، فَأَخْصَبْنَا حَتَّى قَدِمَ أَبِي فَأَخَذَهَا أَبِي فَاعْتَنَقَهَا  وَاعْتَقَلَهَا  فَعَادَتْ إِلَى لَبَنِهَا الْأَوَّلِ ، فَقَالَتْ لَهُ أُمِّي : أَفْسَدْتَ عَلَيْنَا شَاتَنَا إِنْ كَانَتْ لَتَحْلُبُ مِلْءَ هَذِهِ الْجَفْنَةِ قَالَ : وَمَنْ كَانَ يَحْلُبُهَا ؟ قَالَتْ : رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : وَتُرِيدِينَ مِنِّي بَرَكَةَ يَدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، لَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَعْظَمُ بَرَكَةً مِنْ يَدَيَّ .","","Musnad al-Bazzar 2140","","خباب بن الأرت التميمي عن ابنة الخباب بن الأرت عن عبد الرحمن بن مدرك عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن مخول بن إبراهيم الكوفي عن أحمد بن عثمان بن حكيم عن البزار","بنت خباب عن أبيها"
"2150","2141  -  حَدَّثَنَا  أَبُو كُرَيْبٍ قَالَ :  نَا  إِبْرَاهِيمُ بْنُ يُوسُفَ بْنِ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي إِسْحَاقَ  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ مُدْرِكٍ الْأَخْمَسِيِّ ،  عَنْ  بِنْتِ خَبَّابٍ ،  عَنْ  خَبَّابٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .         [6/86]","","Musnad al-Bazzar 2141","","خباب بن الأرت التميمي عن ابنة الخباب بن الأرت عن عبد الرحمن بن مدرك عن أبو إسحاق السبيعي عن يوسف بن إسحاق بن أبي إسحاق السبيعي عن إبراهيم بن يوسف بن إسحاق بن أبي إسحاق السبيعي عن أبو كريب محمد بن العلاء عن البزار","بنت خباب عن أبيها"
"2151","[6/87]      مُسْنَدُ  الْفَضْلِ بْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُ         [6/88]             [6/89]      مُسْنَدُ  الْفَضْلِ بْنِ عَبَّاسٍ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ابْنُ عَبَّاسٍ  عَنِ  الْفَضْلِ  عَلِيُّ بْنُ الْحُسَيْنِ  عَنِ  ابْنِ عَبَّاسٍ  2142  -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ نَافِعٍ قَالَ :  نَا  حَفْصُ بْنُ غِيَاثٍ قَالَ :  نَا  جَعْفَرُ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَلِيِّ بْنِ الْحُسَيْنِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  قَالَ :  كُنْتُ رِدْفَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" فَلَمْ يَزَلْ يُلَبِّي حَتَّى رَمَى جَمْرَةَ الْعَقَبَةِ  وَرَمَاهَا بِسَبْعِ حَصَيَاتٍ يُكَبِّرُ مَعَ كُلِّ حَصَاةٍ  .         [6/90]      وَهَذَا الْحَدِيثُ عَنِ  الْفَضْلِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ رَمَى الْجَمْرَةَ بِسَبْعِ حَصَيَاتٍ يُكَبِّرُ مَعَ كُلِّ حَصَاةٍ  ، لَا نَعْلَمُ رَوَاهُ إِلَّا  عَلِيُّ بْنُ الْحُسَيْنِ  ، عَنِ  ابْنِ عَبَّاسٍ  ، عَنِ  الْفَضْلِ  . وَلَا نَعْلَمُ حَدَّثَ بِهِ عَنْ  جَعْفَرٍ  إِلَّا  حَفْصُ بْنُ غِيَاثٍ  .","","Musnad al-Bazzar 2142","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جعفر الصادق عن حفص بن غياث النخعي عن محمد بن أحمد بن نافع القيسي عن البزار","علي بن الحسين عن ابن عباس"
"2152","[6/91]      سَعِيدُ بْنُ جُبَيْرٍ  عَنِ  ابْنِ عَبَّاسٍ  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  2143  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى قَالَ :  نَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  ، أَنَّهُ قَالَ :  كُنْتُ رَدِيفَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ  الْمُزْدَلِفَةِ  وَأَعْرَابِيٌّ يُسَايِرُهُ وَمَعَهُ ابْنَةٌ لَهُ حَسْنَاءُ قَدْ أَرْدَفَهَا خَلْفَهُ ، فَجَعَلْتُ أَنْظُرُ إِلَيْهَا ، فَجَعَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَلْوِي وَجْهِي وَيَصْرِفُهُ عَنْهَا ، فَلَمْ يَقْطَعِ التَّلْبِيَةَ حَتَّى رَمَى جَمْرَةَ الْعَقَبَةِ  .  وَلَا نَعْلَمُ رَوَى  أَبُو إِسْحَاقَ  ، عَنْ  سَعِيدِ بْنِ جُبَيْرٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ، عَنِ  الْفَضْلِ  إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 2143","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن سعيد بن جبير الأسدي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن يوسف بن موسى بن راشد عن البزار","سعيد بن جبير عن ابن عباس عن الفضل بن عباس"
"2153","[6/92]      2144  -  وَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ قَالَ :  نَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ الْجُنَيْدِ قَالَ :  نَا  زُهَيْرٌ ،  عَنْ  عَبْدِ الْكَرِيمِ وَخُصَيْفٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ""  لَمْ يَزَلْ يُلَبِّي حَتَّى رَمَى جَمْرَةَ الْعَقَبَةِ  .","","Musnad al-Bazzar 2144","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن سعيد بن جبير الأسدي عن خصيف الجزري عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن إبراهيم بن عبد الله بن الجنيد الختلي عن البزار","سعيد بن جبير عن ابن عباس عن الفضل بن عباس"
"2154","[6/93]      عَطَاءُ بْنُ أَبِي رَبَاحٍ  عَنِ  ابْنِ عَبَّاسٍ  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  2145  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ""  لَمْ يَزَلْ يُلَبِّي حَتَّى رَمَى جَمْرَةَ الْعَقَبَةِ  .","","Musnad al-Bazzar 2145","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن ابن جريج عن يحيى القطان عن أبو موسى الزمن عن البزار","عطاء بن أبي رباح عن ابن عباس عن الفضل بن عباس"
"2155","[6/94]      2146  -  وَنَا  جَمِيلُ بْنُ الْحَسَنِ قَالَ :  نَا  مُحَمَّدُ بْنُ الزِّبْرِقَانِ قَالَ :  نَا  سَعِيدٌ يَعْنِي ابْنَ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  قَالَ :  كُنْتُ رِدْفَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ النَّحْرِ مِنْ  جَمْعٍ  فَلَمْ يَزَلْ يُلَبِّي حَتَّى رَمَى  جَمْرَةَ الْقُصْوَى  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ  بِهَذَا  الْإِسْنَادِ  إِلَّا  مُحَمَّدُ بْنُ الزِّبْرِقَانِ  ،  وَتَابَعَهُ  إِبْرَاهِيمُ بْنُ طَهْمَانَ  ،  وَالْمَحْفُوظُ  عَنْ  مُحَمَّدِ بْنِ الزِّبْرِقَانِ  .","","Musnad al-Bazzar 2146","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن الزبرقان الأهوازي عن جميل بن الحسن الجهضمي عن البزار","عطاء بن أبي رباح عن ابن عباس عن الفضل بن عباس"
"2156","2147  -  وَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ قَالَ :  نَا  شُعْبَةُ ،  عَنْ  جَابِرٍ وَعَامِرٍ الْأَحْوَلِ وَابْنِ عَطَاءٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،         [6/95]      عَنِ  الْفَضْلِ  ،  أَنَّهُ كَانَ رَدِيفَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَكَانَ "" يُلَبِّي يَوْمَ النَّحْرِ حَتَّى رَمَى جَمْرَةَ الْعَقَبَةِ  .  وَلَا نَعْلَمُ أَحَدًا جَمَعَ  جَابِرًا  ،  وَعَامِرًا  ،  وَابْنَ عَطَاءٍ  ، عَنْ  عَطَاءٍ  ، عَنِ  ابْنِ عَبَّاسٍ  فِي هَذَا الْحَدِيثِ إِلَّا  شُعْبَةُ  .","","Musnad al-Bazzar 2147","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن يعقوب بن عطاء بن أبي رباح المكي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","عطاء بن أبي رباح عن ابن عباس عن الفضل بن عباس"
"2157","2148  -  وَنَا  بِشْرُ بْنُ خَالِدٍ الْعَسْكَرِيُّ قَالَ :  أَنَا  سَعِيدُ بْنُ مَسْلَمَةَ قَالَ :  نَا  عَبْدُ الْمَلِكِ بْنُ أَبِي سُلَيْمَانَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" لَمْ يَزَلْ يُلَبِّي حَتَّى رَمَى جَمْرَةَ الْعَقَبَةِ  .  وَهَذَا الْحَدِيثُ فِيهِ كَلَامٌ عَنْ  أُسَامَةَ بْنِ زَيْدٍ  فِي دُخُولِ         [6/96]      الْبَيْتِ فَاخْتَصَرْنَا مِنْهُ مَا كَانَ عَنِ  الْفَضْلِ  .","","Musnad al-Bazzar 2148","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن سعيد بن مسلمة الأموي عن بشر بن خالد الفرائضي عن البزار","عطاء بن أبي رباح عن ابن عباس عن الفضل بن عباس"
"2158","2149  -  وَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  نَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنِ  الْحَجَّاجِ - يَعْنِي ابْنَ أَرْطَاةَ - ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ "" لَمْ يَزَلْ يُلَبِّي يَوْمَ النَّحْرِ حَتَّى رَمَى جَمْرَةَ الْعَقَبَةِ  .","","Musnad al-Bazzar 2149","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن حجاج بن أرطاة عن عبد الله بن نمير عن يوسف بن موسى بن راشد عن البزار","عطاء بن أبي رباح عن ابن عباس عن الفضل بن عباس"
"2159","2150  -  وَنَا  عَلِيُّ بْنُ شُعَيْبٍ قَالَ :  نَا  عَبْدُ الْوَهَّابِ بْنُ عَطَاءٍ قَالَ :  نَا  سَعِيدٌ يَعْنِي ابْنَ أَبِي عَرُوبَةَ ،  عَنْ  كَثِيرِ بْنِ شِنْظِيرٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  قَالَ :  كُنْتُ رَدِيفَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ النَّحْرِ مِنْ  جَمْعٍ  فَلَمْ يَزَلْ يُلَبِّي حَتَّى رَمَى جَمْرَةَ الْعَقَبَةِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  كَثِيرِ بْنِ شِنْظِيرٍ  ، عَنْ  عَطَاءٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ، عَنِ  الْفَضْلِ  إِلَّا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ  .","","Musnad al-Bazzar 2150","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن كثير بن شنظير المازني عن سعيد بن أبي عروبة عن عبد الوهاب بن عطاء الخفاف عن علي بن شعيب السمسار عن البزار","عطاء بن أبي رباح عن ابن عباس عن الفضل بن عباس"
"2160","2151  -  وَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَعَمْرُو بْنُ عَلِيٍّ قَالَا :  نَا  مُحَمَّدُ بْنُ أَبِي         [6/97]      عَدِيٍّ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ، وَأَبَانَ بْنِ صَالِحٍ ،  عَنْ  مُجَاهِدٍ وَعَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  حَدَّثَنِي  أَخِي الْفَضْلُ بْنُ عَبَّاسٍ  ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" لَبَّى حَتَّى انْتَهَى إِلَى  جَمْرَةِ الْعَقَبَةِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ ، عَنِ  ابْنِ أَبِي نَجِيحٍ  ، وَلَا عَنْ  أَبَانَ بْنِ صَالِحٍ  إِلَّا  مُحَمَّدُ بْنُ إِسْحَاقَ  .","","Musnad al-Bazzar 2151","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن مجاهد بن جبر المخزومي عن أبان بن صالح بن عمير عن محمد بن إسحاق عن محمد بن إبراهيم بن أبي عدي القسملي عن أبو موسى الزمن عن البزار","عطاء بن أبي رباح عن ابن عباس عن الفضل بن عباس"
"2161","2152  -  حَدَّثَنَا  أَحْمَدُ بْنُ ثَابِتٍ قَالَ :  نَا  أَبُو عَامِرٍ قَالَ :  نَا  رَبَاحُ بْنُ أَبِي مَعْرُوفٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ  ، ""  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَبَّى حَتَّى رَمَى جَمْرَةَ الْعَقَبَةِ  .","","Musnad al-Bazzar 2152","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن رباح بن أبي معروف المكي عن أبو عامر العقدي عن أحمد بن ثابت الجحدري عن البزار","عطاء بن أبي رباح عن ابن عباس عن الفضل بن عباس"
"2162","2153  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ قَالَ :  نَا  أَبُو عَاصِمٍ قَالَ :  نَا  شُعْبَةُ ،  عَنْ  مُشَاشٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ ضَعَفَةَ  بَنِي هَاشِمٍ  وَصِبْيَانَهُمْ أَنْ يَرْتَحِلُوا مِنْ  جَمْعٍ  بِلَيْلٍ ، فَيَقُولُ :  أَبْنَى أَوْ أُبَيْنَى لَا تَرْمُوا الْجَمْرَةَ حَتَّى تَطْلُعَ الشَّمْسُ  .         [6/98]      وَهَذَا الْحَدِيثُ لَا نَحْفَظُهُ ، عَنْ  مُشَاشٍ أَبِي الْأَزْهَرِ  ، إِلَّا عَنْ  شُعْبَةَ  عَنْهُ .","","Musnad al-Bazzar 2153","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن مشاش السليمي عن شعبة بن الحجاج عن أبو عاصم النبيل عن الفلاس عن البزار","عطاء بن أبي رباح عن ابن عباس عن الفضل بن عباس"
"2163","2154  -  حَدَّثَنَا  حُمَيْدُ بْنُ الرَّبِيعِ قَالَ :  نَا  مَعْنُ بْنُ عِيسَى قَالَ :  نَا  الْحَارِثُ بْنُ عَبْدِ الْمَلِكِ ،  عَنِ  الْقَاسِمِ بْنِ يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ قُسَيْطٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَطَبَهُمْ فِي شَكْوَاهُ الَّذِي تُوُفِّيَ فِيهِ ، فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ :  أَمَّا بَعْدُ فَإِنَّهُ قَدْ دَنَا مِنِّي خُفُوقٌ مِنْ بَيْنِ أَظْهُرِكُمْ فَمَنْ شَتَمْتُ لَهُ عِرْضًا فَهَذَا عِرْضِي  ، وَمَنْ ضَرَبْتُ لَهُ ظَهْرًا فَهَذَا ظَهْرِي ، فَلْيَسْتَقِدْ مِنْهُ "" ، ثُمَّ قَالَ : ""  الْحَقُّ  بَعْدِي مَعَ  عُمَرَ  حَيْثُ كَانَ  .         [6/99]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنِ  الْفَضْلِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2154","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن يزيد بن عبد الله بن قسيط الليثي عن القاسم بن يزيد بن عبد الله الليثي عن الحارث بن عبد الملك الليثي عن معن بن عيسى عن حميد بن الربيع الجلاد عن البزار","عطاء بن أبي رباح عن ابن عباس عن الفضل بن عباس"
"2164","2155  -  وَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ قَالَ :  نَا  عَبْدُ الصَّمَدِ بْنُ النُّعْمَانِ قَالَ :  نَا  قَيْسٌ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" كُفِّنَ فِي ثَلَاثَةِ أَثْوَابٍ  .  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ عَنْ  عَطَاءٍ ابْنُ أَبِي لَيْلَى  ،  وَيَعْقُوبُ بْنُ عَطَاءٍ  . وَلَا نَعْلَمُ لَهُ عَنِ  الْفَضْلِ  طَرِيقًا إِلَّا مَنْ سَمَّيْنَاهُ  .","","Musnad al-Bazzar 2155","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن قيس بن الربيع الأسدي عن عبد الصمد بن النعمان البغدادي عن إبراهيم بن سعيد الجوهري عن البزار","عطاء بن أبي رباح عن ابن عباس عن الفضل بن عباس"
"2165","[6/100]      مُجَاهِدٌ  عَنِ  ابْنِ عَبَّاسٍ  عَنِ  الْفَضْلِ  2156  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَعَمْرُو بْنُ عَلِيٍّ قَالَا :  نَا  مُحَمَّدُ بْنُ أَبِي عَدِيٍّ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي نَجِيحٍ ، وَأَبَانَ بْنِ صَالِحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  حَدَّثَنِي  أَخِي الْفَضْلُ  ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" لَبَّى حَتَّى انْتَهَى إِلَى جَمْرَةِ  الْعَقَبَةِ  فَلَمَّا رَمَاهَا أَمْسَكَ  .","","Musnad al-Bazzar 2156","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن مجاهد بن جبر المخزومي عن أبان بن صالح بن عمير عن محمد بن إسحاق عن محمد بن إبراهيم بن أبي عدي القسملي عن أبو موسى الزمن عن البزار","مجاهد عن ابن عباس عن الفضل"
"2166","2157  -  وَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ قَالَ :  نَا  أَحْمَدُ بْنُ عَبْدِ اللهِ قَالَ :  نَا  زُهَيْرٌ ،  عَنْ  عَبْدِ الْكَرِيمِ وَخُصَيْفٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ ""  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَبَّى حَتَّى رَمَى جَمْرَةَ  الْعَقَبَةِ  .","","Musnad al-Bazzar 2157","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن مجاهد بن جبر المخزومي عن خصيف الجزري عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن إبراهيم بن عبد الله أبو شيبة العبسي عن البزار","مجاهد عن ابن عباس عن الفضل"
"2167","[6/101]      2158  -  وَنَا  عَمْرُو بْنُ عَلِيٍّ قَالَ :  نَا  صَفْوَانُ بْنُ عِيسَى قَالَ :  نَا  الْحَارِثُ بْنُ عَبْدِ الرَّحْمَنِ ، وَهُوَ ابْنُ أَبِي ذُبَابٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ  ، ""  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يَزَلْ يُلَبِّي حَتَّى رَمَى جَمْرَةَ  الْعَقَبَةِ  يَوْمَ النَّحْرِ  .  وَلَا نَعْلَمُ رَوَى  الْحَارِثُ بْنُ عَبْدِ الرَّحْمَنِ  ، عَنْ  مُجَاهِدٍ  ، عَنِ  ابْنِ عَبَّاسٍ  ، عَنِ  الْفَضْلِ  إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 2158","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الحارث بن عبد الرحمن الدوسي عن صفوان بن عيسى عباية عن الفلاس عن البزار","مجاهد عن ابن عباس عن الفضل"
"2168","2159  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ حَبِيبٍ قَالَ :  نَا  عَتَّابُ بْنُ بَشِيرٍ ،  عَنْ  خُصَيْفٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ  ، بِنَحْوِهِ .","","Musnad al-Bazzar 2159","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن مجاهد بن جبر المخزومي عن خصيف الجزري عن عتاب بن بشير عن إسحاق بن إبراهيم الشهيدي عن البزار","مجاهد عن ابن عباس عن الفضل"
"2169","[6/102]      عِكْرِمَةُ  عَنِ  ابْنِ عَبَّاسٍ  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  2160  -  حَدَّثَنَا  يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ قَالَ :  نَا  رَوْحُ بْنُ عُبَادَةَ قَالَ :  نَا  ابْنُ جُرَيْجٍ ،  عَنْ  حُسَيْنِ بْنِ عَبْدِ اللهِ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  ""  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعَظَ النَّاسَ فِي الرَّكْعَتَيْنِ اللَّتَيْنِ بَعْدَ الْفَجْرِ وَقَبْلَ صَلَاةِ الصُّبْحِ ، فَوَعَظَهُمْ ، ثُمَّ رَفَعَ صَوْتَهُ ، فَقَالَ :  صَلُّوا قَبْلَ الصُّبْحِ وَلَوْ رَكْعَةً  ، فَلَمَّا كَانَ بَعْدَ ذَلِكَ رَآهُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلُّونَهُمَا مَعَ إِقَامَةِ الصَّلَاةِ ، فَقَالَ أَيْضًا : "" هَلْ أَنْتُمْ مُنْتَهُونَ ، أَصَلَاتَانِ مَعًا ؟  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ يُرْوَى عَنِ  الْفَضْلِ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2160","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عكرمة مولى ابن عباس عن الحسين بن عبد الله بن عبيد الله بن عباس الهاشمي عن ابن جريج عن روح بن عبادة القيسي عن يحيى بن حبيب الحارثي عن البزار","عكرمة عن ابن عباس عن الفضل بن عباس"
"2170","2161  -  وَأَخْبَرَنَا  يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ قَالَ :  نَا  رَوْحٌ قَالَ :  نَا  ابْنُ جُرَيْجٍ ،  عَنِ  الْحُسَيْنِ بْنِ عَبْدِ اللهِ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَاقِفًا  بِعَرَفَةَ  مَادًّا يَدَيْهِ كَالْمُسْتَطْعِمِ  أَوْ كَلِمَةً نَحْوَهَا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ لَهُ طَرِيقًا عَنِ  الْفَضْلِ  إِلَّا هَذَا الطَّرِيقَ  .","","Musnad al-Bazzar 2161","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عكرمة مولى ابن عباس عن الحسين بن عبد الله بن عبيد الله بن عباس الهاشمي عن ابن جريج عن روح بن عبادة القيسي عن يحيى بن حبيب الحارثي عن البزار","عكرمة عن ابن عباس عن الفضل بن عباس"
"2171","[6/103]      أَبُو مَعْبَدٍ  عَنِ  ابْنِ عَبَّاسٍ  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  2162  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ قَالَ :  نَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ  ابْنِ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  أَبُو الزُّبَيْرِ ،  عَنْ  أَبِي مَعْبَدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لِلنَّاسِ فِي  عَشِيَّةِ عَرَفَةَ  وَغَدَاةِ جَمْعٍ حِينَ  دَفَعُوا  وَهُوَ كَافٌّ نَاقَتَهُ :  عَلَيْكُمْ  بِالسَّكِينَةِ  حَتَّى دَخَلَ  مِنًى  حِينَ هَبَطَ  مُحَسِّرًا  ، فَقَالَ : "" عَلَيْكُمْ بِحَصَى  الْخَذْفِ  الَّتِي تُرْمَى بِهِ الْجَمْرَةُ "" ، وَجَعَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُشِيرُ بِيَدِهِ كَمَا يَخْذِفُ الْإِنْسَانُ  .","","Musnad al-Bazzar 2162","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن نافذ المكي عن أبو الزبير المكي عن ابن جريج عن يحيى القطان عن الفلاس عن البزار","أبو معبد عن ابن عباس عن الفضل بن عباس"
"2172","[6/104]      2163  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ شَبِيبٍ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  عَنْ  أَخِيهِ  ،  عَنْ  سُلَيْمَانَ بْنِ بِلَالٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ الْأَنْصَارِيِّ ، أَنَّ         [6/105]      أَبَا الزُّبَيْرِ ،  أَخْبَرَهُ  ، أَنَّ أَبَا مَعْبَدٍ  حَدَّثَ  ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  ، أَنَّهُ  حَدَّثَهُ  قَالَ :  لَمَّا كَانَ  يَوْمُ عَرَفَةَ  وَكَانَ رِدْفَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  ابْنُ الْعَبَّاسِ  وَالنَّاسُ كَثِيرٌ حَوْلَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا كَثُرَ النَّاسُ عَلَيْهِ ، قُلْتُ : سَيُخْبِرُنِي  الْفَضْلُ  عَمَّا صَنَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ  الْفَضْلُ  : دَفَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَعَ النَّاسِ ، فَجَعَلَ يَشُدُّ بِرَأْسِ بَعِيرِهِ وَيَكُفُّ مِنْهُ ، وَجَعَلَ يُنَادِي :  أَيُّهَا النَّاسُ  السَّكِينَةَ  حَتَّى أَتَى  الْمُزْدَلِفَةَ  فَصَلَّى الْمَغْرِبَ وَالْعِشَاءَ ، ثُمَّ بَاتَ  بِالْمُزْدَلِفَةِ  ، حَتَّى طَلَعَ الْفَجْرُ فَصَلَّى بِهَا الصُّبْحَ ، ثُمَّ وَقَفَ عِنْدَ  الْمَشْعَرِ الْحَرَامِ  وَدَفَعَ النَّاسُ مَعَهُ حَتَّى أَتَى  مُحَسِّرًا  فَأَوْضَعَ فِيهِ سَاعَةً وَجَعَلَ يَقُولُ : "" عَلَيْكُمْ بِمِثْلِ حَصَى  الْخَذْفِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  يَحْيَى بْنِ سَعِيدٍ الْأَنْصَارِيِّ  إِلَّا  سُلَيْمَانُ بْنُ بِلَالٍ  .","","Musnad al-Bazzar 2163","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن نافذ المكي عن أبو الزبير المكي عن يحيى بن سعيد الأنصاري عن سليمان بن بلال القرشي عن عبد الحميد بن أبي أويس الأعشى عن إسماعيل بن أبي أويس عن عبد الله بن شبيب الربعي عن البزار","أبو معبد عن ابن عباس عن الفضل بن عباس"
"2173","2164  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدَةَ قَالَ :  أَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  أَبِي مَعْبَدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَحْسَبُهُ  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  ،  وَوَجَدْتُهُ فِي كِتَابِي  فِي مَوْضِعٍ آخَرَ ،  عَنْ  سُفْيَانَ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  أَبِي مَعْبَدٍ ،  عَنِ  ابْنِ عَبَّاسٍ وَلَمْ أَرَ فِيهِ ، عَنِ  الْفَضْلِ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  ارْتَفِعُوا عَنْ  مُحَسِّرٍ  .","","Musnad al-Bazzar 2164","","عبد الله بن عباس عن نافذ المكي عن أبو الزبير المكي عن زياد بن سعد الخراساني عن سفيان بن عيينة عن أحمد بن عبدة الضبي عن البزار","أبو معبد عن ابن عباس عن الفضل بن عباس"
"2174","[6/106]      يُوسُفُ بْنُ مِهْرَانَ  عَنِ  ابْنِ عَبَّاسٍ  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  2165  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ قَالَ :  نَا  شُعْبَةُ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ  ""  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَبَّى حَتَّى رَمَى جَمْرَةَ  الْعَقَبَةِ  .  وَلَا نَعْلَمُ رَوَى  يُوسُفُ بْنُ مِهْرَانَ  ، عَنِ  ابْنِ عَبَّاسٍ  ، عَنِ  الْفَضْلِ  إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 2165","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن البزار","يوسف بن مهران عن ابن عباس عن الفضل بن عباس"
"2175","[6/107]      أَبُو هُرَيْرَةَ  عَنِ  الْفَضْلِ  2166  -  حَدَّثَنَا  سَلَمَةُ بْنُ شَبِيبٍ قَالَ :  نَا  عَبْدُ الرَّزَّاقِ قَالَ :  أَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ،  أَنَّ  أَبَا هُرَيْرَةَ ، كَانَ يَقُولُ :  مَنْ أَصْبَحَ  جُنُبًا  فِي رَمَضَانَ فَلَا صِيَامَ لَهُ  ، فَأَرْسَلَ مَرْوَانُ ، إِلَى أُمِّ سَلَمَةَ يَسْأَلُهَا عَنْ ذَلِكَ ، فَقَالَتْ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصْبِحُ  جُنُبًا  فِي رَمَضَانَ ، ثُمَّ يَغْتَسِلُ وَيَصُومُ  فَأَرْسَلَ إِلَى  أَبِي هُرَيْرَةَ  ، بِذَلِكَ فَقَالَ : إِنَّمَا  حَدَّثَنِي  الْفَضْلُ بْنُ عَبَّاسٍ  .  وَلَا نَعْلَمُ رَوَى  أَبُو هُرَيْرَةَ  ، عَنِ  الْفَضْلِ  إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 2166","","الفضل بن العباس بن عبد المطلب الهاشمي عن أبو هريرة الدوسي عن أبو بكر بن عبد الرحمن راهب قريش عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن سلمة بن شبيب المسمعي عن البزار","أبو هريرة عن الفضل"
"2176","[6/108]      أَبُو الطُّفَيْلِ  عَنِ  الْفَضْلِ  2167  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ قَالَ :  نَا  سَهْلُ بْنُ بَكَّارٍ قَالَ :  نَا  وُهَيْبٌ ،  عَنِ  ابْنِ خُثَيْمٍ ،  عَنْ  أَبِي الطُّفَيْلِ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ ، ""  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَبَّى يَوْمَ النَّحْرِ حَتَّى رَمَى جَمْرَةَ الْعَقَبَةِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  وُهَيْبٌ  ، عَنِ  ابْنِ خُثَيْمٍ  .","","Musnad al-Bazzar 2167","","الفضل بن العباس بن عبد المطلب الهاشمي عن عامر بن واثلة عن عبد الله بن عثمان بن خثيم عن وهيب بن خالد الكرابيسي عن سهل بن بكار الدارمي عن محمد بن معمر بن ربعي البحراني عن البزار","أبو الطفيل عن الفضل"
"2177","[6/109]      عَبْدُ الرَّحْمَنِ بْنُ عُثْمَانَ  عَنِ  الْفَضْلِ  2168  -  حَدَّثَنَا  صَفْوَانُ بْنُ الْمُغَلِّسِ قَالَ :  نَا  مُحَمَّدُ بْنُ عُمَرَ بْنِ وَاقِدٍ قَالَ :  نَا  سَعِيدُ بْنُ مُحَمَّدِ بْنِ أَبِي زَيْدٍ ،  عَنْ  عُثْمَانَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عُثْمَانَ ،  عَنْ  أَبِيهِ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ ، "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا صَلَّى رَكْعَتَيِ الْفَجْرِ اضْطَجَعَ عَلَى شِقِّهِ الْأَيْمَنِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنِ  الْفَضْلِ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَى  عَبْدُ الرَّحْمَنِ بْنُ عُثْمَانَ  عَنِ  الْفَضْلِ  إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 2168","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الرحمن بن عثمان القرشي شارب الذهب عن عثمان بن عبد الرحمن بن عثمان التيمي عن سعيد بن محمد بن أبي زيد الزرقي عن الواقدي عن صفوان بن المغلس عن البزار","عبد الرحمن بن عثمان عن الفضل"
"2178","[6/110]      رَبِيعَةُ بْنُ الْحَارِثِ  عَنِ  الْفَضْلِ  2169  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ الْجُنَيْدِ قَالَ :  نَا  يَحْيَى بْنُ عَبْدِ اللهِ بْنِ بُكَيْرٍ قَالَ :  نَا  اللَّيْثُ بْنُ سَعْدٍ ،  عَنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ،  عَنْ  عِمْرَانَ بْنِ أَبِي أَنَسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ نَافِعِ بْنِ الْعَمْيَاءِ ،  عَنْ  رَبِيعَةَ بْنِ الْحَارِثِ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  الصَّلَاةُ مَثْنَى مَثْنَى تَشَهَّدُ فِي كُلِّ رَكْعَةٍ  ، ثُمَّ تَضَرَّعُ وَتَخَشَّعُ  وَتَمَسْكَنُ  ، ثُمَّ تَرْفَعُ يَدَيْكَ إِلَى أُذُنَيْكَ ، ثُمَّ تَسْتَقْبِلُ بِهِمَا وَجْهَكَ ، وَتَقُولُ : يَا رَبِّ يَا رَبِّ ، فَمَنْ لَمْ يَفْعَلْ ذَلِكَ فَهِيَ  خِدَاجٌ  .  هَكَذَا قَالَ  إِبْرَاهِيمُ  ،  وَإِنَّمَا هُوَ تَرْفَعُ يَدَيْكَ إِلَى ثَنْدُوَتَيْكَ  .         [6/111]      وَلَا نَعْلَمُ رَوَى  رَبِيعَةُ بْنُ الْحَارِثِ  عَنِ  الْفَضْلِ  إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 2169","","الفضل بن العباس بن عبد المطلب الهاشمي عن ربيعة بن الحارث الهاشمي عن عبد الله بن نافع بن العمياء عن عمران بن أبي أنس العامري عن عبد ربه بن سعيد النجاري عن الليث بن سعد عن يحيى بن عبد الله بن بكير المخزومي عن إبراهيم بن عبد الله بن الجنيد الختلي عن البزار","ربيعة بن الحارث عن الفضل"
"2179","[6/112]             [6/113]      مُسْنَدُ  عَقِيلِ بْنِ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ         [6/114]             [6/115]      مُسْنَدُ  عَقِيلِ بْنِ أَبِي طَالِبٍ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مُوسَى بْنُ طَلْحَةَ  عَنْ  عَقِيلٍ  2170  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْجَبَّارِ قَالَ :  نَا  يُونُسُ بْنُ بُكَيْرٍ قَالَ :  نَا  طَلْحَةُ بْنُ يَحْيَى ،  عَنْ  مُوسَى بْنِ طَلْحَةَ قَالَ :  حَدَّثَنِي  عَقِيلُ بْنُ أَبِي طَالِبٍ قَالَ :  جَاءَتْ  قُرَيْشٌ  إِلَى  أَبِي طَالِبٍ  ، فَقَالَتْ : إِنَّ ابْنَ أَخِيكَ يُؤْذِينَا فِي نَادِينَا وَمَسْجِدِنَا فَانْهَهُ عَنْ إِيذَائِنَا قَالَ : يَا  عَقِيلُ  ائْتِ  مُحَمَّدًا  فَادْعُهُ ، فَذَهَبْتُ فَأَتَيْتُهُ بِهِ ، فَجَاءَ فِي نِصْفِ النَّهَارِ يَتَخَلَّلُ الْفَيْءَ ، فَجَلَسَ عِنْدَ أُسْكُفَّةِ الْبَابِ  وَقُرَيْشٌ  عِنْدَ  أَبِي طَالِبٍ  ، فَقَالَ : يَا ابْنَ أَخِي إِنَّ بَنِي عَمِّكَ يَزْعُمُونَ أَنَّكَ تُؤْذِيهِمْ فِي نَادِيهِمْ وَمَسْجِدِهِمْ فَانْتَهِ عَنْ ذَلِكَ قَالَ :  فَحَلَّقَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَصَرَهُ إِلَى السَّمَاءِ ، ثُمَّ قَالَ :  هَلْ تَرَوْنَ هَذِهِ الشَّمْسَ  ؟ "" قَالُوا : نَعَمْ ، قَالَ : "" مَا أَنَا بِأَقْدَرَ أَنْ أَدَعَ ذَلِكَ مِنْكُمْ عَلَى أَنْ تَسْتَشْعِلُوا لِي مِنْهَا شُعْلَةً "" قَالَ : فَقَالَ  أَبُو طَالِبٍ  : مَا كَذَبَنَا ابْنُ أَخِي فَارْجِعُوا قَالَ : فَرَجَعُوا  .         [6/116]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَقِيلٍ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2170","","عقيل بن أبي طالب ابن عم رسول الله عن موسى بن طلحة بن عبيد الله التيمي عن طلحة بن يحيى بن طلحة التيمي عن يونس بن بكير عن أحمد بن عبد الجبار العطاردي عن البزار","موسى بن طلحة عن عقيل"
"2180","[6/117]      مُحَمَّدُ بْنُ عَقِيلٍ  عَنْ أَبِيهِ  2171  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْمُسْتَمِرِّ الْعُرُوقِيُّ قَالَ :  نَا  بُكَيْرُ بْنُ يَحْيَى بْنِ زَبَّانَ الْعَنَزِيُّ قَالَ :  نَا  مِنْدَلٌ يَعْنِي ابْنَ عَلِيٍّ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ عَقِيلِ بْنِ أَبِي طَالِبٍ  ، "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَتَوَضَّأُ بِالْمُدِّ وَيَغْتَسِلُ بِالصَّاعِ  .         [6/118]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى ، عَنْ  عَقِيلٍ  إِلَّا مِنْ هَذَا الْوَجْهِ .  وَهَذَا الْحَدِيثُ أَخْطَأَ فِيهِ  مِنْدَلٌ  إِذْ جَعَلَهُ بِهَذَا  الْإِسْنَادِ  ، وَإِنَّمَا رَوَاهُ  يَزِيدُ بْنُ أَبِي زِيَادٍ  ، عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ  ، عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ  .","","Musnad al-Bazzar 2171","","عقيل بن أبي طالب ابن عم رسول الله عن محمد بن عقيل بن أبي طالب عن عبد الله بن محمد بن عقيل بن أبي طالب عن يزيد بن أبي زياد القرشي عن مندل بن علي عن بكر بن يحيى العنزي عن إبراهيم بن المستمر العروقي عن البزار","محمد بن عقيل عن أبيه"
"2181","[6/119]      الْحَسَنُ  عَنْ  عَقِيلٍ  2172  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ قَالَ :  نَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  يُونُسَ يَعْنِي ابْنَ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  أَنَّ  عَقِيلَ بْنَ أَبِي طَالِبٍ ، تَزَوَّجَ امْرَأَةً مِنْ  بَنِي هَاشِمٍ  ، فَدَخَلَ عَلَيْهِ  الْقَوْمُ  ، فَقَالَ : "" أَلَا تُرَفِّئُونَنِي "" ، فَجَعَلُوا يَقُولُونَ :  بِالرِّفَاءِ  وَالْبَنِينَ .  فَقَالَ : لَا تَقُولُوا هَكَذَا ، وَلَكِنْ قُولُوا :  بَارَكَ اللهُ لَكُمْ ، بَارَكَ عَلَيْكُمْ  إِنَّا كُنَّا نُؤْمَرُ بِذَلِكَ .  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ غَيْرُ وَاحِدٍ عَنِ  الْحَسَنِ  ، عَنْ  عَقِيلٍ  ، وَلَا أَحْسِبُ سَمِعَ  الْحَسَنُ  مِنْ  عَقِيلٍ  .","","Musnad al-Bazzar 2172","","عقيل بن أبي طالب ابن عم رسول الله عن الحسن البصري عن يونس بن عبيد عن يزيد بن زريع العيشي عن الفلاس عن البزار","الحسن عن عقيل"
"2182","[6/120]             [6/121]      مُسْنَدُ  نَوْفَلِ بْنِ الْحَارِثِ  رَضِيَ اللهُ عَنْهُ         [6/122]             [6/123]      مُسْنَدُ  نَوْفَلِ بْنِ الْحَارِثِ بْنِ عَبْدِ الْمُطَّلِبِ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  2173  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ شَبِيبٍ قَالَ :  نَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ عَبْدِ الْعَزِيزِ قَالَ :  وَجَدْتُ فِي كِتَابِ أَبِي بِخَطِّهِ  ،  عَنْ  سَعِيدِ بْنِ سُلَيْمَانَ بْنِ سَعِيدِ بْنِ نَوْفَلِ بْنِ الْحَارِثِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  نَوْفَلِ بْنِ الْحَارِثِ  قَالَ :  سُئِلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الصَّلَاةِ فِي مُرَاحِ الْغَنَمِ قَالَ :  صَلُّوا فِي مُرَاحِهَا وَامْسَحُوا  رُغَامَهَا  فَإِنَّهَا مِنْ دَوَابِّ الْجَنَّةِ  .  وَلَا نَعْلَمُ رَوَى  نَوْفَلُ بْنُ الْحَارِثِ  إِلَّا هَذَا الْحَدِيثَ ، وَلَا نَعْلَمُ لَهُ طَرِيقًا إِلَّا هَذَا الطَّرِيقَ .","","Musnad al-Bazzar 2173","","نوفل بن الحارث ، ابن عم رسول الله صلى الله عليه وسلم عن سعيد بن نوفل بن الحارث عن أبيه عن سعيد بن سليمان بن سعيد بن نوفل بن الحارث عن والد أحمد بن محمد بن عبد العزيز الوشاء عن أحمد بن محمد بن عبد العزيز الوشاء عن عبد الله بن شبيب الربعي عن البزار","مسند نوفل بن الحارث بن عبد المطلب عن النبي صلى الله عليه وسلم"
"2183","[6/124]             [6/125]      ]  مُسْنَدُ  عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ عَبْدِ الْمُطَّلِبِ  رَضِيَ اللهُ عَنْهُ         [6/126]             [6/127]      مُسْنَدُ  عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ عَبْدِ الْمُطَّلِبِ  عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  2174  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الصَّبَّاحِ الْعَطَّارُ قَالَ :  نَا  الْحَجَّاجُ بْنُ نُصَيْرٍ قَالَ :  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ ابْنُ أَخِي الزُّهْرِيِّ قَالَ :  حَدَّثَنِي  الزُّهْرِيُّ  بِالرُّصَافَةِ  ،  عَنْ  عَبْدِ الرَّحْمَنِ الْأَعْرَجِ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ عَبْدِ الْمُطَّلِبِ قَالَ : ""  آخِرُ صَلَاةٍ صَلَّاهَا بِنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمَغْرِبُ  ، فَقَرَأَ فِي الرَّكْعَةِ الْأُولَى         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      ، وَفِي الثَّانِيَةِ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِهَذَا اللَّفْظِ إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنِ  ابْنِ أَخِي الزُّهْرِيِّ  ، إِلَّا  الْحَجَّاجُ بْنُ نُصَيْرٍ  .","","Musnad al-Bazzar 2174","","عبد الله بن الحارث بن نوفل عن عبد الرحمن بن هرمز الأعرج عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن حجاج بن نصير الفساطيطي عن عبد الله بن الصباح المربدي عن البزار","مسند عبد الله بن الحارث بن عبد المطلب عن رسول الله صلى الله عليه وسلم"
"2184","[6/128]             [6/129]      مُسْنَدُ الْمُطَّلِبِ بْنِ رَبِيعَةَ رَضِيَ اللهُ عَنْهُ         [6/130]             [6/131]      مُسْنَدُ  الْمُطَّلِبِ بْنِ رَبِيعَةَ  2175  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  نَا  جَرِيرٌ - يَعْنِي ابْنَ عَبْدِ الْحَمِيدِ - ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنِ  الْمُطَّلِبِ بْنِ رَبِيعَةَ قَالَ :  جَاءَ  الْعَبَّاسُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُغْضَبٌ ، فَقَالَ : "" مَا شَأْنُكَ ؟ "" فَقَالَ : يَا رَسُولَ اللهِ إِنَّا لَنَخْرُجُ فَنَرَى  قُرَيْشًا  تَتَحَدَّثُ فَإِذَا رَأَوْنَا سَكَتُوا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  وَالَّذِي نَفْسِي بِيَدِهِ لَا يَدْخُلُ قَلْبَ امْرِئٍ الْإِيمَانُ حَتَّى يُحِبَّكُمْ لِلهِ وَلِقَرَابَتِي  .","","Musnad al-Bazzar 2175","","عبد المطلب بن ربيعة ابن ابن عم رسول الله عن عبد الله بن الحارث بن نوفل عن يزيد بن أبي زياد القرشي عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","مسند المطلب بن ربيعة"
"2185","2176  -  وَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  نَا  جَرِيرٌ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنِ  الْمُطَّلِبِ بْنِ رَبِيعَةَ قَالَ :  قَامَ  الْعَبَّاسُ  ، إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُغْضَبٌ فَقَالَ : "" مَا شَأْنُكَ ؟ "" قَالَ : يَا رَسُولَ اللهِ ، مَا لَنَا  وَلِقُرَيْشٍ  ؟ قَالَ : "" مَا لَكَ وَلَهُمْ ؟ "" قَالَ : يَلْقَى بَعْضُهُمْ بَعْضًا بِوُجُوهٍ مُشْرِقَةٍ ، فَإِذَا لَقُونَا لَقُونَا بِغَيْرِ ذَلِكَ ، فَغَضِبَ حَتَّى دَرَّ  عِرْقٌ  بَيْنَ عَيْنَيْهِ ، ثُمَّ قَالَ :  وَالَّذِي نَفْسِي بِيَدِهِ لَا يَدْخُلُ قَلْبَ امْرِئٍ الْإِيمَانُ حَتَّى يُحِبَّكُمْ لِلهِ وَلِرَسُولِهِ  ثُمَّ قَالَ : "" مَا بَالُ رِجَالٍ يُؤْذُونِي فِي  الْعَبَّاسِ  ، عَمُّ الرَّجُلِ  صِنْوُ  أَبِيهِ  .         [6/132]      وَلَا نَعْلَمُ رَوَى  ابْنُ رَبِيعَةَ  هَذَا إِلَّا هَذَيْنِ الْحَدِيثَيْنِ ، رَوَاهُمَا غَيْرُ وَاحِدٍ عَنْ  يَزِيدَ  ، وَخَالَفَ  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ  ، عَنْ  يَزِيدَ  فِي الْأَوَّلِ ، فَقَالَ : عَنْ  يَزِيدَ  ، عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ  ، عَنِ  الْعَبَّاسِ  ، وَيَرْوِيهِ  يَزِيدُ  ، عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ  ، عَنِ  الْمُطَّلِبِ بْنِ رَبِيعَةَ  . هَكَذَا رَوَاهُ  جَرِيرٌ  وَغَيْرُهُ ، وَرَوَاهُ  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ  ، عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ  ، عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ  ، عَنِ  الْعَبَّاسِ  ، وَلَا نَحْكُمُ لِوَاحِدٍ مِنْهُمَا أَنَّهُ أَثْبَتُ وَأَصَحُّ حَدِيثًا مِنْ صَاحِبِهِ إِلَّا أَنَّ  يَزِيدَ بْنَ أَبِي زِيَادٍ  لَيْسَ بِالْقَوِيِّ فِي الْحَدِيثِ  ، وَلَا بِالثَّابِتِ الَّذِي يُحْتَجُّ بِهِ إِذَا انْفَرَدَ بِحَدِيثٍ عِنْدَ أَهْلِ الْعِلْمِ بِالنَّقْلِ .  تَمَّ الْجُزْءُ الْمُوَفَّى عِشْرِينَ وَالْحَمْدُ لِلهِ كَثِيرًا كَمَا هُوَ أَهْلُهُ .","","Musnad al-Bazzar 2176","","عبد المطلب بن ربيعة ابن ابن عم رسول الله عن عبد الله بن الحارث بن نوفل عن يزيد بن أبي زياد القرشي عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","مسند المطلب بن ربيعة"
"2186","[6/133]      مُسْنَدُ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  رَضِيَ اللهُ عَنْهُمَا         [6/134]             [6/135]      أَوَّلُ  مُسْنَدِ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَبِيدَةُ بْنُ عَمْرٍو السَّلْمَانِيُّ  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  2177  -  أَخْبَرَنَا  أَبُو الْحَسَنِ مُحَمَّدُ بْنُ أَيُّوبَ بْنِ حَبِيبِ بْنِ يَحْيَى الرَّقِّيُّ الصُّمُوتُ ، قَالَ :  نَا  أَبُو بَكْرٍ أَحْمَدُ بْنُ عَمْرِو بْنِ عَبْدِ الْخَالِقِ الْبَزَّارُ قَالَ :  نَا  يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ قَالَ :  نَا  خَالِدُ بْنُ الْحَارِثِ قَالَ :  نَا  شُعْبَةُ  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي الْبَخْتَرِيِّ ،  عَنْ  عَبِيدَةَ بْنِ عَمْرٍو السَّلْمَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  أَنَّ رَجُلَيْنِ تَدَاعَيَا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَحَلَفَ الْمُدَّعَى عَلَيْهِ بِاللهِ الَّذِي لَا إِلَهَ إِلَّا هُوَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  إِنَّ اللهَ قَدْ غَفَرَ لَكَ بِإِخْلَاصِكَ  .","","Musnad al-Bazzar 2177","","عبد الله بن الزبير عن عبيدة بن عمرو السلماني عن سعيد بن فيروز الطائي عن عطاء بن السائب عن شعبة بن الحجاج عن خالد الصدق عن يحيى بن حبيب الحارثي عن البزار","عبيدة بن عمرو السلماني عن عبد الله بن الزبير"
"2187","2178  -  وَنَاهُ  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ الْحُسَيْنِ بْنِ كُرْدِيٍّ  قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ قَالَ :  نَا  شُعْبَةُ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي الْبَخْتَرِيِّ ،  عَنْ  عَبِيدَةَ ،  عَنِ  ابْنِ الزُّبَيْرِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .         [6/136]      وَهَذَا الْحَدِيثُ لَمْ يُتَابِعْ  شُعْبَةَ  عَلَى رِوَايَتِهِ هَذِهِ عَنْ  عَطَاءِ بْنِ السَّائِبِ  أَحَدٌ ، وَقَدْ خَالَفُوهُ فِيهَا ، فَقَالَ  حَمَّادُ بْنُ سَلَمَةَ  ،  وَجَرِيرُ بْنُ عَبْدِ الْحَمِيدِ  : عَنْ  عَطَاءِ بْنِ السَّائِبِ  ، عَنْ  أَبِي يَحْيَى  ، عَنِ  ابْنِ عَبَّاسٍ  ،  أَنَّ رَجُلَيْنِ اخْتَصَمَا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  وَلَا أَحْسَبُ أَتَى هَذَا الِاخْتِلَافُ إِلَّا مِنْ  عَطَاءِ بْنِ السَّائِبِ  ؛ لِأَنَّهُ قَدْ كَانَ  اضْطَرَبَ فِي حَدِيثِهِ  ، وَلَمْ يَرْوِ  عَبِيدَةُ  عَنِ  ابْنِ         [6/137]      الزُّبَيْرِ  حَدِيثًا  مُسْنَدًا  غَيْرَ هَذَا الْحَدِيثِ مِنْ وَجْهٍ صَحِيحٍ .  قَالَ : وَسَمِعْتُ  أَبَا مُوسَى مُحَمَّدَ بْنَ الْمُثَنَّى  يَقُولُ : نَسَخْتُ هَذَا الْحَدِيثَ مِنْ كِتَابِ  غُنْدَرٍ  ، عَنْ  شُعْبَةَ  ، عَنْ  عَطَاءٍ  ، عَنْ  أَبِي الْبَخْتَرِيِّ  ، عَنْ  عَبِيدَةَ  ، عَنِ  ابْنِ الزُّبَيْرِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَلَمْ أَسْمَعْهُ مِنْهُ  .  كذا ، ولعل الصواب: (أحمد بن عبد الله أبو الحسين بن الكردي).","","Musnad al-Bazzar 2178","","عبد الله بن الزبير عن عبيدة بن عمرو السلماني عن سعيد بن فيروز الطائي عن عطاء بن السائب عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن عبد الله بن الحكم بن فروة البصري عن البزار","عبيدة بن عمرو السلماني عن عبد الله بن الزبير"
"2188","[6/138]      عُرْوَةُ بْنُ الزُّبَيْرِ  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  2179  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدَةَ قَالَ :  أَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِكُلِّ نَبِيٍّ  حَوَارِيٌّ  وَحَوَارِيَّ  الزُّبَيْرُ  .  وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنْ  هِشَامٍ  مِنْ وُجُوهٍ ، فَاخْتَلَفُوا عَلَى  هِشَامٍ  ، فَقَالَ  أَبُو مُعَاوِيَةَ  : عَنْ  هِشَامٍ  ، عَنْ  وَهْبِ بْنِ كَيْسَانَ  ، عَنِ  ابْنِ الزُّبَيْرِ  .  وَقَالَ غَيْرُ وَاحِدٍ : عَنْ  هِشَامٍ  ، عَنِ  ابْنِ الْمُنْكَدِرِ  ، عَنْ  جَابِرٍ  .         [6/139]      وَلَا نَعْلَمُ أَحَدًا قَالَ : عَنْ  هِشَامٍ  ، عَنْ أَبِيهِ ، إِلَّا  حَمَّادُ بْنُ زَيْدٍ  .","","Musnad al-Bazzar 2179","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن أحمد بن عبدة الضبي عن البزار","عروة بن الزبير عن عبد الله بن الزبير"
"2189","2180  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ قَالَ :  نَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ الزُّبَيْرِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  لَا تُحَرِّمُ الْمَصَّةُ وَلَا الْمَصَّتَانِ  .  وَهَذَا الْحَدِيثُ رَوَاهُ الْحُفَّاظُ عَنْ  هِشَامٍ  ، عَنْ أَبِيهِ ، عَنِ  ابْنِ الزُّبَيْرِ  ، وَرَوَاهُ  الزُّهْرِيُّ  ، عَنْ  عُرْوَةَ  ، عَنْ  عَائِشَةَ  ،  وَابْنِ الزُّبَيْرِ  .         [6/140]      وَرَوَاهُ رَجُلٌ  لَيْسَ بِالْحَافِظِ  ، يُقَالُ لَهُ  مُحَمَّدُ بْنُ دِينَارٍ  ، عَنْ  هِشَامِ بْنِ عُرْوَةَ  ، عَنْ أَبِيهِ ، عَنِ  ابْنِ الزُّبَيْرِ  ، عَنْ أَبِيهِ .","","Musnad al-Bazzar 2180","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يحيى القطان عن الفلاس عن البزار","عروة بن الزبير عن عبد الله بن الزبير"
"2190","2181  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ الْعُقَيْلِيُّ قَالَ :  نَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الطُّفَاوِيُّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ الزُّبَيْرِ  قَالَ : ""  لَمَّا نَزَلَتْ هَذِهِ الْآيَةُ         {      خُذِ الْعَفْوَ         }      أُمِرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَأْخُذَ  الْعَفْوَ  مِنْ  أَخْلَاقِ  النَّاسِ  .         [6/141]      وَهَذَا الْحَدِيثُ إِنَّمَا يُرْوَى عَنْ  هِشَامِ بْنِ عُرْوَةَ  ، عَنْ أَبِيهِ ، وَلَا نَعْلَمُ أَحَدًا قَالَ : عَنِ  ابْنِ الزُّبَيْرِ  ، إِلَّا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ  .","","Musnad al-Bazzar 2181","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن عبد الرحمن الطفاوي عن محمد بن عثمان بن بحر العقيلي عن البزار","عروة بن الزبير عن عبد الله بن الزبير"
"2191","2182  -  وَنَاهُ  عَمْرُو بْنُ عَلِيٍّ قَالَ :  نَا  عُمَرُ بْنُ عَلِيٍّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ، وَهُوَ الصَّوَابُ .","","Musnad al-Bazzar 2182","","عروة بن الزبير عن هشام بن عروة بن الزبير عن عمر بن علي بن عطاء عن الفلاس عن البزار","عروة بن الزبير عن عبد الله بن الزبير"
"2192","[6/142]      2183  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ قَالَ :  نَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الطُّفَاوِيُّ ، أَوْ عُمَرُ بْنُ عَلِيٍّ  ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ الزُّبَيْرِ  قَالَ :  نَزَلَتْ هَذِهِ الْآيَةُ :         {      وَإِذَا سَمِعُوا مَا أُنْـزِلَ إِلَى الرَّسُولِ تَرَى أَعْيُنَهُمْ تَفِيضُ مِنَ الدَّمْعِ         }      قَالَ :  نَزَلَتْ فِي  النَّجَاشِيِّ  وَأَصْحَابِهِ  .  وَهَذَا الْحَدِيثُ وَإِنْ لَمْ يَذْكُرْ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيهِ كَلَامًا ، فَقَدْ قَالَ : نَزَلَتْ ، وَإِنَّمَا نَزَلَتْ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2183","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن عبد الرحمن الطفاوي عن محمد بن عثمان بن بحر العقيلي عن البزار","عروة بن الزبير عن عبد الله بن الزبير"
"2193","2184  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ قَالَ :  نَا  الرَّبِيعُ بْنُ نَافِعٍ قَالَ :  نَا  حَفْصُ بْنُ مَيْسَرَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  الْعُمْرَى  جَائِزَةٌ لِأَهْلِهَا  .         [6/143]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنْ  هِشَامٍ  ، عَنْ أَبِيهِ ، عَنِ  ابْنِ الزُّبَيْرِ  غَيْرَ  حَفْصِ بْنِ مَيْسَرَةَ  ، وَغَيْرَ  حَفْصٍ  يَرْوِيهِ عَنْ  هِشَامٍ  ، عَنْ أَبِيهِ  مُرْسَلًا  .","","Musnad al-Bazzar 2184","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حفص بن ميسرة العقيلي عن الربيع بن نافع الحلبي عن إبراهيم بن سعيد الجوهري عن البزار","عروة بن الزبير عن عبد الله بن الزبير"
"2194","2185  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ حَنَانٍ قَالَ :  نَا  بَقِيَّةُ بْنُ الْوَلِيدِ قَالَ :  نَا  أَبُو سُفْيَانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  قَالَ : ""  نَدَرَتْ  ثَنِيَّتِي ، فَأَمَرَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ أَتَّخِذَ ثَنِيَّةً مِنْ ذَهَبٍ  .  وَهَذَا الْحَدِيثُ رَوَاهُ بَعْضُ أَصْحَابِ  هِشَامٍ  ، عَنْ  هِشَامٍ  ، عَنْ أَبِيهِ ، عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ أُبَيٍّ  ، وَلَا نَعْلَمُ أَحَدًا قَالَ : عَنِ  ابْنِ الزُّبَيْرِ  إِلَّا مِنْ هَذَا الْوَجْهِ .","","Musnad al-Bazzar 2185","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن زياد الألهاني عن بقية بن الوليد عن محمد بن عمرو بن حنان الكلبي عن البزار","عروة بن الزبير عن عبد الله بن الزبير"
"2195","[6/144]      الْبَهِيُّ  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  2186  -  حَدَّثَنَا  الْحَسَنُ بْنُ قَزَعَةَ قَالَ :  نَا  عَلِيُّ بْنُ عَابِسٍ قَالَ :  نَا  يَزِيدُ بْنُ أَبِي زِيَادٍ ،  عَنِ  الْبَهِيِّ ، قَالَ :  قُلْتُ  لِعَبْدِ اللهِ بْنِ الزُّبَيْرِ : أَخْبِرْنِي  بِأَقْرَبِ  النَّاسِ شَبَهًا بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : ""  الْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ ، كَانَ  أَقْرَبَ  النَّاسِ شَبَهًا بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَحَبَّهُمْ إِلَيْهِ ،  كَانَ يَجِيءُ وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَاجِدٌ فَيَقَعُ عَلَى ظَهْرِهِ فَلَا يَقُومُ حَتَّى يَتَنَحَّى  ، وَيَجِيءُ فَيَدْخُلُ تَحْتَ بَطْنِهِ فَيُفْرِجُ لَهُ رِجْلَيْهِ حَتَّى يَخْرُجَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنِ  ابْنِ الزُّبَيْرِ  ، وَلَا نَعْلَمُ رَوَى هَذَا الْحَدِيثَ إِلَّا  عَلِيُّ بْنُ عَابِسٍ  ، عَنْ  يَزِيدَ  ، عَنِ  الْبَهِيِّ  .","","Musnad al-Bazzar 2186","","عبد الله بن الزبير عن عبد الله البهي مولى مصعب بن الزبير عن يزيد بن أبي زياد القرشي عن علي بن عابس الملائي عن الحسن بن قزعة الخلقاني عن البزار","البهي عن عبد الله بن الزبير"
"2196","[6/145]      عَبْدُ اللهِ بْنُ أَبِي مُلَيْكَةَ  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  2187  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ، وَمُحَمَّدُ بْنُ حَسَنِ بْنِ الصَّبَّاحِ قَالَا :  نَا  حَجَّاجُ بْنُ مُحَمَّدٍ قَالَ :  نَا  ابْنُ جُرَيْجٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ، أَنَّ ابْنَ الزُّبَيْرِ ،  حَدَّثَهُمْ  قَالَ :  قَدِمَ رَكْبٌ مِنْ  بَنِي تَمِيمٍ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ : أَمِّرِ  الْقَعْقَاعَ بْنَ مَعْبَدٍ  ، وَقَالَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ : أَمِّرِ  الْأَقْرَعَ بْنَ حَابِسٍ  ، فَقَالَ  أَبُو بَكْرٍ  : مَا أَرَدْتَ إِلَّا خِلَافِي ، فَقَالَ  عُمَرُ  : مَا أَرَدْتُ خِلَافَكَ ، فَتَمَارَيَا ، فَنَزَلَتْ :         {      لا تَرْفَعُوا أَصْوَاتَكُمْ فَوْقَ صَوْتِ النَّبِيِّ         }      .         [6/146]      وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى إِلَّا عَنِ  ابْنِ الزُّبَيْرِ  ، وَرَوَاهُ عَنِ  ابْنِ أَبِي مُلَيْكَةَ  عَنِ  ابْنِ الزُّبَيْرِ ،  ابْنُ جُرَيْجٍ  وَنَافِعُ بْنُ عُمَرَ  ، وَأَمَّا حَدِيثُ  ابْنِ جُرَيْجٍ  فَلَا نَعْلَمُ رَوَاهُ إِلَّا  الْحَجَّاجُ بْنُ مُحَمَّدٍ  .","","Musnad al-Bazzar 2187","","عبد الله بن الزبير عن ابن أبي مليكة عن ابن جريج عن حجاج بن محمد الأعور عن محمد بن حسن بن الصباح عن البزار","عبد الله بن أبي مليكة عن عبد الله بن الزبير"
"2197","2188  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُؤَمَّلٌ قَالَ :  نَا  نَافِعُ بْنُ عُمَرَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ الزُّبَيْرِ ،  أَنَّ  أَبَا بَكْرٍ  ،  وَعُمَرَ  رَضِيَ اللهُ عَنْهُمَا ، لَمَّا قَدِمَ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَفَرٌ مِنْ  بَنِي تَمِيمٍ  ، أَشَارَ أَحَدُهُمَا  بِالْأَقْرَعِ بْنِ حَابِسٍ  ، وَأَشَارَ الْآخَرُ بِغَيْرِهِ ، وَقَالَ  أَبُو بَكْرٍ  لِعُمَرَ  رَضِيَ اللهُ عَنْهُمَا : إِنَّمَا أَرَدْتَ خِلَافِي ، فَقَالَ  عُمَرُ  : مَا أَرَدْتُ خِلَافَكَ ، فَارْتَفَعَتْ أَصْوَاتُهُمَا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَنَزَلَتْ :         {      يَا أَيُّهَا الَّذِينَ آمَنُوا لا تَرْفَعُوا أَصْوَاتَكُمْ فَوْقَ صَوْتِ النَّبِيِّ         }      .  قَالَ  ابْنُ أَبِي مُلَيْكَةَ :  قَالَ  ابْنُ الزُّبَيْرِ :  فَكَانَ عُمَرُ رَضِيَ اللهُ عَنْهُ بَعْدَ ذَلِكَ : إِذَا حَدَّثَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَدَّثَهُ كَأَخِي  السِّرَارِ  .         [6/147]","","Musnad al-Bazzar 2188","","عبد الله بن الزبير عن ابن أبي مليكة عن نافع بن عمر بن عبد الله بن جميل الجمحي عن مؤمل بن إسماعيل العدوي عن أبو موسى الزمن عن البزار","عبد الله بن أبي مليكة عن عبد الله بن الزبير"
"2198","2189  -  وَنَاهُ  يُوسُفُ بْنُ مُوسَى قَالَ :  نَا  وَكِيعُ بْنُ الْجَرَّاحِ قَالَ :  نَا  نَافِعُ بْنُ عُمَرَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ، فَذَكَرَ الْقِصَّةَ ، قَالَ  ابْنُ أَبِي مُلَيْكَةَ  قَالَ  ابْنُ الزُّبَيْرِ ،  فَكَانَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ بَعْدَ ذَلِكَ إِذَا حَدَّثَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَدَّثَهُ كَأَخِي  السِّرَارِ  ، لَمْ يُسْمِعْهُ حَتَّى يَسْتَفْهِمَهُ .","","Musnad al-Bazzar 2189","","عبد الله بن الزبير عن ابن أبي مليكة عن نافع بن عمر بن عبد الله بن جميل الجمحي عن وكيع بن الجراح عن يوسف بن موسى بن راشد عن البزار","عبد الله بن أبي مليكة عن عبد الله بن الزبير"
"2199","2190  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ قَالَ :  نَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ قَالَ :  قَالَ  ابْنُ الزُّبَيْرِ :  أَمَّا الَّذِي قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ كُنْتُ مُتَّخِذًا  خَلِيلًا  لَاتَّخَذْتُهُ  خَلِيلًا  - يَعْنِي أَبَا بَكْرٍ رَضِيَ اللهُ عَنْهُ -  قَضَى أَنَّ الْجَدَّ أَبًا  .         [6/148]      وَهَذَا الْكَلَامُ قَدْ رُوِيَ ، عَنِ  ابْنِ الزُّبَيْرِ  ، مِنْ غَيْرِ وَجْهٍ  .","","Musnad al-Bazzar 2190","","أبو  بكر الصديق عن عبد الله بن الزبير عن ابن أبي مليكة عن ابن جريج عن أبو عاصم النبيل عن الفلاس عن البزار","عبد الله بن أبي مليكة عن عبد الله بن الزبير"
"2200","2191  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ شَبِيبٍ قَالَ :  نَا  الْوَلِيدُ بْنُ عَطَاءِ بْنِ الْأَغَرِّ ، وَمُحَمَّدُ بْنُ الْحَسَنِ الْجُبَيْرِيُّ قَالَا :  نَا  نَافِعُ بْنُ عُمَرَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  مَنْ قَرَأَ الْقُرْآنَ ظَاهِرًا أَوْ نَظَرًا أَعْطَاهُ اللهُ  شَجَرَةً  فِي الْجَنَّةِ  ، لَوْ أَنَّ غُرَابًا أَفْرَخَ فِي غُصْنٍ مِنْ أَغْصَانِهَا ثُمَّ طَارَ لَأَدْرَكَهُ  الْهَرَمُ  قَبْلَ أَنْ يَقْطَعَ وَرَقَهَا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى إِلَّا عَنِ  ابْنِ الزُّبَيْرِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَرَوَاهُ  عَبْدُ الْمَجِيدِ بْنُ عَبْدِ الْعَزِيزِ  ، عَنِ  ابْنِ جُرَيْجٍ  ، عَنِ  ابْنِ أَبِي مُلَيْكَةَ  ، عَنِ  ابْنِ الزُّبَيْرِ  ،  فَتَابَعَ  نَافِعَ بْنَ عُمَرَ  .","","Musnad al-Bazzar 2191","","عبد الله بن الزبير عن ابن أبي مليكة عن نافع بن عمر بن عبد الله بن جميل الجمحي عن محمد بن الحسن الجبيري عن عبد الله بن شبيب الربعي عن البزار","عبد الله بن أبي مليكة عن عبد الله بن الزبير"
"2201","2192  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ الْوَاسِطِيُّ قَالَ :  نَا  مُحَمَّدُ بْنُ مَاهَانَ الْوَاسِطِيُّ ، قَالَ :  نَا  نَافِعُ بْنُ عُمَرَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ         [6/149]      عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  لَيْسَ مِنَّا مَنْ لَمْ  يَتَغَنَّ  بِالْقُرْآنِ  .  وَهَذَا الْحَدِيثُ اخْتُلِفَ فِيهِ عَنِ  ابْنِ أَبِي مُلَيْكَةَ  ، فَقَالَ  عَمْرُو بْنُ دِينَارٍ  ،  وَاللَّيْثُ  : عَنِ  ابْنِ أَبِي مُلَيْكَةَ  ، عَنِ  ابْنِ أَبِي نَهِيكٍ  ، عَنْ  سَعْدٍ  .  وَقَالَ  عَبْدُ الْجَبَّارِ بْنُ الْوَرْدِ  : عَنِ  ابْنِ أَبِي مُلَيْكَةَ  ، عَنِ  ابْنِ أَبِي يَزِيدَ  ، عَنْ  أَبِي لُبَابَةَ .  وَقَالَ  عِسْلُ بْنُ سُفْيَانَ  : عَنِ  ابْنِ أَبِي مُلَيْكَةَ  ، عَنْ  عَائِشَةَ  .         [6/150]      وَقَالَ  عُبَيْدُ اللهِ بْنُ الْأَخْنَسِ  : عَنِ  ابْنِ أَبِي مُلَيْكَةَ  ، عَنِ  ابْنِ عَبَّاسٍ  .","","Musnad al-Bazzar 2192","","عبد الله بن الزبير عن ابن أبي مليكة عن نافع بن عمر بن عبد الله بن جميل الجمحي عن محمد بن أبي حنيفة الواسطي عن محمد بن عبد الملك الدقيقي عن البزار","عبد الله بن أبي مليكة عن عبد الله بن الزبير"
"2202","2193  -  حَدَّثَنَا  مُؤَمَّلُ بْنُ هِشَامٍ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  أَيُّوبَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ الزُّبَيْرِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  إِنَّمَا  فَاطِمَةُ  رَضِيَ اللهُ عَنْهَا ،  بَضْعَةٌ  مِنِّي  ، يَغِيظُنِي مَا يَغِيظُهَا  ، وَقَالَ مَرَّةً أُخْرَى : ""  وَيُؤْذِينِي مَا آذَاهَا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  أَيُّوبَ  بِهَذَا  الْإِسْنَادِ  إِلَّا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ  .  وَقَدْ رَوَاهُ  اللَّيْثُ بْنُ سَعْدٍ  ، فَقَالَ : عَنِ  ابْنِ أَبِي مُلَيْكَةَ  ، عَنِ  الْمِسْوَرِ بْنِ مَخْرَمَةَ  .","","Musnad al-Bazzar 2193","","عبد الله بن الزبير عن ابن أبي مليكة عن أيوب السختياني عن إسماعيل ابن علية عن مؤمل بن هشام اليشكري عن البزار","عبد الله بن أبي مليكة عن عبد الله بن الزبير"
"2203","[6/151]             [6/152]      سَعِيدُ بْنُ جُبَيْرٍ  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  2194  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ قَالَ :  نَا  الْحَجَّاجُ بْنُ أَرْطَاةَ ،  عَنْ  فُرَاتٍ الْقَزَّازِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ  قَالَ  : كُنْتُ عِنْدَ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  فَأَتَاهُ كِتَابٌ عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  لَوْ كُنْتُ مُتَّخِذًا  خَلِيلًا  أَوْ وَزِيرًا لَاتَّخَذْتُ  ابْنَ أَبِي قُحَافَةَ  خَلِيلًا  ، وَلَكِنَّهُ أَخِي فِي الدِّينِ وَصَاحِبِي فِي الْغَارِ  .  وَقَدْ رَوَى هَذَا الْحَدِيثَ غَيْرُ وَاحِدٍ ، عَنِ  الْحَجَّاجِ  بِهَذَا  الْإِسْنَادِ  ، وَلَا نَعْلَمُ رَوَى  سَعِيدُ بْنُ جُبَيْرٍ  ، عَنِ  ابْنِ الزُّبَيْرِ  إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 2194","","عبد الله بن الزبير عن عبد الله بن عتبة بن مسعود عن سعيد بن جبير الأسدي عن فرات بن أبي عبد الرحمن القزاز عن حجاج بن أرطاة عن عبد الرحمن بن مغراء الدوسي عن يوسف بن موسى بن راشد عن البزار","سعيد بن جبير عن عبد الله بن الزبير"
"2204","[6/153]      أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  2195  -  حَدَّثَنَا  زُرَيْقُ بْنُ السَّخْتِ قَالَ :  نَا  أَحْمَدُ بْنُ إِسْحَاقَ الْحَضْرَمِيُّ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  الْمُسْتَشَارُ مُؤْتَمَنٌ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا  تَابَعَ  ابْنَ إِسْحَاقَ  عَلَى هَذِهِ الرِّوَايَةِ ،  وَقَدِ اخْتَلَفُوا عَلَى  عَبْدِ الْمَلِكِ  ، فَرَوَاهُ غَيْرُ وَاحِدٍ ، عَنْ  أَبِي عَوَانَةَ  ، عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ  ، عَنْ  أَبِي سَلَمَةَ  ،  مُرْسَلًا  .  وَرَوَاهُ  شَيْبَانُ  ، عَنْ  عَبْدِ الْمَلِكِ  ، عَنْ  أَبِي سَلَمَةَ  ، عَنْ  أَبِي هُرَيْرَةَ  .         [6/154]      وَرَوَاهُ  عَبْدُ الْحَكِيمِ بْنُ مَنْصُورٍ  ، عَنْ  عَبْدِ الْمَلِكِ  ، عَنْ  أَبِي سَلَمَةَ  ، عَنْ  أَبِي الْهَيْثَمِ بْنِ التَّيِّهَانِ .  وَرَوَاهُ  شَرِيكٌ  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ  ، عَنْ  أَبِي سَلَمَةَ  ،         [6/155]      عَنْ  أُمِّ سَلَمَةَ  .  وَقَدْ كَانَ  أَحْمَدُ بْنُ إِسْحَاقَ  ، رَوَاهُ فِيمَا أَحْسَبُ مَرَّةً عَنْ  أَبِي عَوَانَةَ  ، عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ  ، عَنْ أَبِيهِ ، عَنِ  ابْنِ الزُّبَيْرِ  ؛ لِأَنِّي رَأَيْتُهُ عِنْدِي فِي مَوْضِعٍ آخَرَ هَكَذَا  .","","Musnad al-Bazzar 2195","","عبد الله بن الزبير عن أبو سلمة بن عبد الرحمن عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن أحمد بن إسحاق الحضرمي عن زريق بن السخت البصري عن البزار","أبو سلمة بن عبد الرحمن عن عبد الله بن الزبير"
"2205","[6/156]      عَطَاءُ بْنُ أَبِي رَبَاحٍ  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  2196  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدَةَ قَالَ :  أَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  حَبِيبٍ الْمُعَلِّمِ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ الزُّبَيْرِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  صَلَاةٌ فِي مَسْجِدِي هَذَا أَفْضَلُ مِنْ أَلْفِ صَلَاةٍ فِيمَا سِوَاهُ إِلَّا  الْمَسْجِدَ الْحَرَامَ  فَإِنَّهُ يَزِيدُ عَلَيْهِ مِائَةً  .         [6/157]      وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنْ  عَطَاءٍ  ، وَاخْتُلِفَ عَلَى  عَطَاءٍ  فِيهِ ، وَلَا نَعْلَمُ أَحَدًا قَالَ : ""  فَإِنَّهُ يَزِيدُ عَلَيْهِ مِائَةً  "" إِلَّا  ابْنُ الزُّبَيْرِ  .  وَقَدْ  تَابَعَ  حَبِيبٌ الْمُعَلِّمُ  الرَّبِيعَ بْنَ صُبَيْحٍ  ، فَرَوَاهُ عَنْ  عَطَاءٍ  ، عَنِ  ابْنِ الزُّبَيْرِ  .  وَرَوَى هَذَا الْحَدِيثَ  عَبْدُ الْمَلِكِ بْنُ أَبِي سُلَيْمَانَ  ، عَنْ  عَطَاءٍ  ، عَنِ  ابْنِ عُمَرَ  .  وَرَوَاهُ  ابْنُ جُرَيْجٍ  ، عَنْ  عَطَاءٍ  ، عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ  ، أَوْ  عَائِشَةَ  .         [6/158]      وَرَوَاهُ  ابْنُ أَبِي لَيْلَى  ، عَنْ  عَطَاءٍ  ، عَنْ  أَبِي هُرَيْرَةَ  .","","Musnad al-Bazzar 2196","","عبد الله بن الزبير عن عطاء بن أبي رباح عن حبيب المعلم مولى معقل بن يسار عن حماد بن زيد عن أحمد بن عبدة الضبي عن البزار","عطاء بن أبي رباح عن عبد الله بن الزبير"
"2206","[6/159]      الشَّعْبِيُّ  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  2197  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورِ بْنِ سَيَّارٍ قَالَ :  نَا  عَبْدُ الرَّزَّاقِ قَالَ :  أَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ يَقُولُ وَهُوَ مُسْتَنِدٌ إِلَى  الْكَعْبَةِ  : ""  وَرَبِّ هَذَا  الْبَيْتِ  لَقَدْ لَعَنَ اللهُ  الْحَكَمَ  وَمَا وَلَدَ عَلَى لِسَانِ نَبِيِّهِ  .  وَهَذَا الْكَلَامُ لَا نَحْفَظُهُ عَنِ  ابْنِ الزُّبَيْرِ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .  وَرَوَاهُ مُحَمَّدُ بْنُ فُضَيْلٍ أَيْضًا  عَنْ  إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ الزُّبَيْرِ ،  نَا  بِهِ عَلِيُّ بْنُ الْمُنْذِرِ .","","Musnad al-Bazzar 2197","","عبد الله بن الزبير عن الشعبي عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن أحمد بن منصور الرمادي عن البزار","الشعبي عن عبد الله بن الزبير"
"2207","[6/160]      عَمْرُو بْنُ دِينَارٍ  عَنِ  ابْنِ الزُّبَيْرِ  2198  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، وَأَحْمَدُ بْنُ ثَابِتٍ قَالَا :  نَا  عَبْدُ الْمَلِكِ بْنُ عَمْرٍو قَالَ :  نَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ الزُّبَيْرِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ  نُوقِشَ  الْحِسَابَ هَلَكَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنِ  ابْنِ الزُّبَيْرِ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  عَمْرٍو  إِلَّا  مُحَمَّدُ بْنُ مُسْلِمٍ  .","","Musnad al-Bazzar 2198","","عبد الله بن الزبير عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن أبو عامر العقدي عن أحمد بن ثابت الجحدري عن البزار","عمرو بن دينار عن ابن الزبير"
"2208","2199  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَرْزُوقِ بْنِ بُكَيْرٍ ، وَعُمَرُ بْنُ الْخَطَّابِ قَالَا :  نَا         [6/161]      مُوسَى بْنُ مَسْعُودٍ قَالَ :  نَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ الزُّبَيْرِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا مِنْ صَاحِبِ إِبِلٍ لَا يُؤَدِّي حَقَّهَا فِي رِسْلِهَا  وَنَجْدَتِهَا  إِلَّا جِيءَ بِهِ يَوْمَ الْقِيَامَةِ حَتَّى يُبْطَحَ  لَهَا بِقَاعٍ  قَرْقَرٍ  تَطَأُهُ  بِأَظْلَافِهَا  ، كُلَّمَا بُقِرَتْ أُولَاهَا أُعِيدَتْ عَلَيْهِ أُخْرَاهَا حَتَّى يُقْضَى بَيْنَ النَّاسِ أَوْ يُرَى سَبِيلَهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى مِنْ حَدِيثِ  ابْنِ الزُّبَيْرِ  إِلَّا بِهَذَا  الْإِسْنَادِ  ، وَلَمْ نَسْمَعْهُ إِلَّا مِنْ حَدِيثِ  أَبِي حُذَيْفَةَ  ، عَنْ  مُحَمَّدِ بْنِ مُسْلِمٍ  .","","Musnad al-Bazzar 2199","","عبد الله بن الزبير عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن موسى بن مسعود النهدي عن عمر بن الخطاب السجستاني عن البزار","عمرو بن دينار عن ابن الزبير"
"2209","[6/162]      وَهْبُ بْنُ كَيْسَانَ  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  2200  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  نَا  سَلَمَةُ بْنُ الْفَضْلِ قَالَ :  نَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  وَهْبِ بْنِ كَيْسَانَ قَالَ :  كَتَبَ  عَبْدُ اللهِ بْنُ عُتْبَةَ  ، إِلَى  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  - وَكَانَ اسْتَعْمَلَهُ عَلَى قَضَاءِ  الْعِرَاقِ  - يَسْأَلُهُ عَنِ الْجَدِّ  فَكَتَبَ إِلَيْهِ  ابْنُ الزُّبَيْرِ ،  أَنَّ  الَّذِيَ قَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَوْ كُنْتُ مُتَّخِذًا  خَلِيلًا  لَاتَّخَذْتُهُ  خَلِيلًا  ،  جَعَلَ الْجَدَّ أَبًا  "" .  وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنِ  ابْنِ الزُّبَيْرِ  ، مِنْ غَيْرِ وَجْهٍ .","","Musnad al-Bazzar 2200","","أبو  بكر الصديق عن عبد الله بن الزبير عن وهب بن كيسان القرشي عن محمد بن إسحاق عن سلمة بن الفضل الأبرش عن يوسف بن موسى بن راشد عن البزار","وهب بن كيسان عن عبد الله بن الزبير"
"2210","2201  -  حَدَّثَنَا  أَبُو كُرَيْبٍ مُحَمَّدُ بْنُ الْعَلَاءِ قَالَ :  نَا  أَبُو مُعَاوِيَةَ قَالَ :  نَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  وَهْبِ بْنِ كَيْسَانَ ،  عَنِ  ابْنِ الزُّبَيْرِ ،  أَنَّهُ  كَانَ يَقُولُ فِي دُبُرِ صَلَاتِهِ حِينَ يُسَلِّمُ : "" لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ  ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، وَلَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ ، وَلَا نَعْبُدُ إِلَّا إِيَّاهُ ، لَهُ النِّعْمَةُ وَالْفَضْلُ وَالثَّنَاءُ الْحَسَنُ ، لَا         [6/163]      إِلَهَ إِلَّا هُوَ مُخْلِصِينَ لَهُ الدِّينَ وَلَوْ كَرِهَ الْمُشْرِكُونَ "" قَالَ : وَكَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُهَلِّلُ بِهِنَّ فِي دُبُرِ كُلِّ صَلَاةٍ  .  وَهَذَا الْحَدِيثُ إِنَّمَا يُرْوَى عَنْ  هِشَامٍ  ، عَنْ  أَبِي الزُّبَيْرِ  ،  مَوْلًى لِابْنِ الزُّبَيْرِ  ، عَنِ  ابْنِ الزُّبَيْرِ  .  وَلَا نَعْلَمُ أَحَدًا رَوَاهُ عَنْ  هِشَامٍ  ، عَنْ  وَهْبٍ  ، عَنِ  ابْنِ الزُّبَيْرِ  إِلَّا  أَبُو مُعَاوِيَةَ  .","","Musnad al-Bazzar 2201","","عبد الله بن الزبير عن وهب بن كيسان القرشي عن هشام بن عروة بن الزبير عن أبو معاوية الضرير عن أبو كريب محمد بن العلاء عن البزار","وهب بن كيسان عن عبد الله بن الزبير"
"2211","2202  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ قَالَ :  نَا  أَبُو مُعَاوِيَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  وَهْبِ بْنِ كَيْسَانَ ،  عَنِ  ابْنِ الزُّبَيْرِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لِكُلِّ نَبِيٍّ  حَوَارِيٌّ  وَحَوَارِيَّ  الزُّبَيْرُ  .  هَكَذَا رَوَاهُ  أَبُو مُعَاوِيَةَ  ، عَنْ  هِشَامِ  ، عَنْ  وَهْبٍ  ، عَنِ  ابْنِ الزُّبَيْرِ  .","","Musnad al-Bazzar 2202","","عبد الله بن الزبير عن وهب بن كيسان القرشي عن هشام بن عروة بن الزبير عن أبو معاوية الضرير عن إبراهيم بن سعيد الجوهري عن البزار","وهب بن كيسان عن عبد الله بن الزبير"
"2212","2203  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ قَالَ :  نَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  وَهْبِ بْنِ كَيْسَانَ ،  أَنَّ  ابْنَ الزُّبَيْرِ خَرَجَ عَلَيْهِمْ فِي يَوْمِ عِيدٍ فَصَلَّى ، ثُمَّ خَطَبَ  ، ثُمَّ قَالَ : "" إِنَّ هَذِهِ سُنَّةُ اللهِ وَسُنَّةُ رَسُولِهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  وَهَذَا الْكَلَامُ قَدْ رُوِيَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ غَيْرِ وَجْهٍ ،  وَهَذَا  الْإِسْنَادُ  مِنْ أَحْسَنِ  إِسْنَادٍ  يُرْوَى عَنِ  ابْنِ الزُّبَيْرِ  .","","Musnad al-Bazzar 2203","","عبد الله بن الزبير عن وهب بن كيسان القرشي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعيد الجوهري عن البزار","وهب بن كيسان عن عبد الله بن الزبير"
"2213","[6/164]      عَامِرُ بْنُ عَبْدِ اللهِ بْنِ الزُّبَيْرِ  عَنْ أَبِيهِ  2204  -  حَدَّثَنَا  الْفَضْلُ بْنُ يَعْقُوبَ الرُّخَامِيُّ قَالَ :  نَا  الْحَجَّاجُ بْنُ مُحَمَّدٍ قَالَ :  نَا  ابْنُ جُرَيْجٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" أَنَّهُ  كَانَ إِذَا جَلَسَ  لِلتَّشَهُّدِ  ثَنَى رِجْلَهُ الْيُسْرَى وَنَصَبَ الْيُمْنَى  ، وَجَعَلَ يَدَهُ الْيُمْنَى عَلَى فَخِذِهِ الْيُمْنَى ، وَأَشَارَ بِالسَّبَّابَةِ وَحَلَّقَ حَلْقَةً  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ ، عَنْ  عَمْرٍو  ، عَنْ  عَامِرٍ  ، عَنْ أَبِيهِ إِلَّا  الْحَجَّاجُ  ، عَنِ  ابْنِ جَرِيحٍ  .","","Musnad al-Bazzar 2204","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن عمرو بن دينار الأثرم عن ابن جريج عن حجاج بن محمد الأعور عن الفضل بن يعقوب الرخامي عن البزار","عامر بن عبد الله بن الزبير عن أبيه"
"2214","2205  -  وَنَاهُ  الْفَضْلُ بْنُ يَعْقُوبَ قَالَ :  نَا  الْحَجَّاجُ بْنُ مُحَمَّدٍ ،  عَنِ  ابْنِ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  زِيَادٌ - يَعْنِي ابْنَ سَعْدٍ - ،  عَنِ  ابْنِ عَجْلَانَ ،  عَنْ         [6/165]      عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .","","Musnad al-Bazzar 2205","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن محمد بن عجلان عن زياد بن سعد الخراساني عن ابن جريج عن حجاج بن محمد الأعور عن الفضل بن يعقوب الرخامي عن البزار","عامر بن عبد الله بن الزبير عن أبيه"
"2215","2206  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ  ابْنِ عَجْلَانَ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ "" إِذَا جَلَسَ  لِلتَّشَهُّدِ  ثَنَى رِجْلَهُ الْيُسْرَى وَنَصَبَ الْيُمْنَى  وَأَشَارَ بِالسَّبَّابَةِ وَحَلَّقَ حَلْقَةً  .         [6/166]      وَهَذَا الْحَدِيثُ رَوَاهُ غَيْرُ وَاحِدٍ ، عَنِ  ابْنِ عَجْلَانَ  ، وَرَوَاهُ  ابْنُ جُرَيْحٍ  ، عَنْ  زِيَادِ بْنِ سَعْدٍ  ، عَنِ  ابْنِ عَجْلَانَ  ، عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، عَنْ أَبِيهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  وَلَا نَعْلَمُ رَوَى  عَمْرُو بْنُ دِينَارٍ  ، عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، عَنْ أَبِيهِ إِلَّا هَذَا الْحَدِيثَ ، وَلَا رَوَاهُ عَنْ  عَمْرٍو  ، إِلَّا  ابْنُ جُرَيْجٍ  ، وَلَا عَنِ  ابْنِ جُرَيْجٍ  ، إِلَّا  الْحَجَّاجُ ،  وَلَا رَوَى حَدِيثَ  ابْنِ جُرَيْجٍ  ، عَنْ  زِيَادِ بْنِ سَعْدٍ  إِلَّا  الْحَجَّاجُ بْنُ مُحَمَّدٍ  عَنْهُ  .","","Musnad al-Bazzar 2206","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن محمد بن عجلان عن يحيى القطان عن أبو موسى الزمن عن البزار","عامر بن عبد الله بن الزبير عن أبيه"
"2216","2207  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ قَالَ :  نَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ قَالَ :  نَا  عُثْمَانُ بْنُ حَكِيمٍ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوٍ مِنْ حَدِيثِ  ابْنِ عَجْلَانَ  .         [6/167]      وَلَا نَعْلَمُ رَوَى هَذَا الْحَدِيثَ عَنْ  عُثْمَانَ بْنِ حَكِيمٍ  ، إِلَّا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ  .","","Musnad al-Bazzar 2207","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن عثمان بن حكيم الأحلافي عن عبد الواحد بن زياد عن العباس بن الوليد النرسي عن البزار","عامر بن عبد الله بن الزبير عن أبيه"
"2217","2208  -  حَدَّثَنَا  حَمَّادُ بْنُ الْحَسَنِ بْنِ عَنْبَسَةَ الْوَرَّاقُ قَالَ :  نَا  أَبُو دَاوُدَ قَالَ :  نَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  مُصْعَبِ بْنِ ثَابِتٍ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ ،  أَنَّ  قَيْلَةَ بِنْتَ الْعُزَّى  ، أَرْسَلَتْ إِلَى ابْنَتِهَا  أَسْمَاءَ بِنْتِ أَبِي بَكْرٍ  ، وَكَانَ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ طَلَّقَهَا فِي الْجَاهِلِيَّةِ ، فَأَرْسَلَتْ إِلَيْهَا بِهَدَايَا فِيهَا أَقِطٌ وَسَمْنٌ ، فَأَبَتْ أَنْ تَقْبَلَ هَدِيَّتَهَا وَتُدْخِلَهَا بَيْتَهَا ، فَأَرْسَلَتْ إِلَى  عَائِشَةَ  لِتَسْأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِتُدْخِلْهَا بَيْتَهَا وَلْتَقْبَلْ هَدِيَّتَهَا  ، وَأَنْزَلَ اللهُ تَبَارَكَ وَتَعَالَى :         {      لا يَنْهَاكُمُ اللهُ عَنِ الَّذِينَ لَمْ يُقَاتِلُوكُمْ فِي الدِّينِ         }      الْآيَةَ .         [6/168]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ لَهُ طَرِيقًا عَنِ  ابْنِ الزُّبَيْرِ  إِلَّا هَذَا الطَّرِيقَ .","","Musnad al-Bazzar 2208","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن عبد الله بن المبارك عن أبو داود الطيالسي عن حماد بن الحسن بن عنبسة النهشلي عن البزار","عامر بن عبد الله بن الزبير عن أبيه"
"2218","2209  -  حَدَّثَنَا  بَعْضُ أَصْحَابِنَا ،  عَنْ  بِشْرِ بْنِ السَّرِيِّ قَالَ :  نَا  مُصْعَبُ بْنُ ثَابِتٍ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  قَالَ : ""  نَزَلَتْ هَذِهِ الْآيَةُ :         {      وَمَا لأَحَدٍ عِنْدَهُ مِنْ نِعْمَةٍ تُجْزَى             *          إِلا ابْتِغَاءَ وَجْهِ رَبِّهِ الْأَعْلَى             *          وَلَسَوْفَ يَرْضَى         }      فِي  أَبِي بَكْرٍ الصِّدِّيقِ  رَضِيَ اللهُ عَنْهُ  "" .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ لَهُ طَرِيقًا ، عَنِ  ابْنِ الزُّبَيْرِ  إِلَّا هَذَا الطَّرِيقَ ، وَلَا نَعْلَمُ رَوَاهُ إِلَّا  بِشْرٌ  ، عَنْ  مُصْعَبِ بْنِ ثَابِتٍ  .","","Musnad al-Bazzar 2209","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن بشر بن السري عن بعض أصحابنا عن البزار","عامر بن عبد الله بن الزبير عن أبيه"
"2219","[6/169]      2210  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  مُوسَى بْنُ إِسْمَاعِيلَ قَالَ :  نَا  هُنَيْدُ بْنُ الْقَاسِمِ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَعْطَانِي الدَّمَ  ، فَقَالَ : "" اذْهَبْ فَغَيِّبْهُ "" فَذَهَبْتُ فَشَرِبْتُهُ ، ثُمَّ أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ لِي : "" مَا صَنَعْتَ بِهِ ؟ "" قُلْتُ غَيَّبْتُهُ قَالَ : "" لَعَلَّكَ شَرِبْتَهُ ؟ "" قُلْتُ : شَرِبْتُهُ  .  وَهَذَا الْكَلَامُ قَدْ رُوِيَ عَنِ  ابْنِ الزُّبَيْرِ  مِنْ وَجْهٍ آخَرَ  .","","Musnad al-Bazzar 2210","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن هنيد بن القاسم عن موسى بن إسماعيل التبوذكي عن أبو موسى الزمن عن البزار","عامر بن عبد الله بن الزبير عن أبيه"
"2220","2211  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مِسْكِينٍ قَالَ :  نَا  ابْنُ أَبِي مَرْيَمَ قَالَ :  نَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ ""  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُشِيرُ بِمِخْصَرِهِ إِذَا خَطَبَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى إِلَّا عَنِ  ابْنِ الزُّبَيْرِ  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا عَنِ  ابْنِ الزُّبَيْرِ  إِلَّا هَذَا الطَّرِيقَ .","","Musnad al-Bazzar 2211","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن محمد بن مسكين بن نميلة اليمامي عن البزار","عامر بن عبد الله بن الزبير عن أبيه"
"2221","2212  -  حَدَّثَنَا  يَحْيَى بْنُ مُعَلَّى بْنِ مَنْصُورٍ قَالَ :  نَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،         [6/170]      قَالَ :  نَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ ،  أَنَّ  قُرَيْشًا  ، قَالَتْ : "" إِنَّ مَثَلَ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَثَلُ نَخْلَةٍ فِي  كَبْوَةٍ  ""  .","","Musnad al-Bazzar 2212","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن يحيى بن معلى عن البزار","عامر بن عبد الله بن الزبير عن أبيه"
"2222","2213  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْوَلِيدِ الْكَرْخِيُّ  قَالَ :  نَا  حَامِدُ بْنُ يَحْيَى الْبَلْخِيُّ قَالَ :  نَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَظَرَ إِلَى  أَبِي بَكْرٍ  رَضِيَ اللهُ عَنْهُ ، فَقَالَ :  هَذَا عَتِيقُ اللهِ مِنَ النَّارِ  فَيَوْمَئِذٍ سُمِّيَ  عَتِيقٌ  ،  وَكَانَ اسْمُهُ قَبْلَ ذَلِكَ  عَبْدَ اللهِ بْنَ عُثْمَانَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ بِهَذَا  الْإِسْنَادِ  إِلَّا  حَامِدٌ  ، عَنِ  ابْنِ عُيَيْنَةَ  .  قال محقق طبعة مكتبة العلوم والحكم هكذا في الأصل ، وفي كشف الأستار: (أحمد بن الوليد الكرخي).  كذا في طبعة مكتبة العلوم والحكم ، وقال المحقق : هكذا بالأصل ، والصواب ( عتيقا )","","Musnad al-Bazzar 2213","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن زياد بن سعد الخراساني عن سفيان بن عيينة عن حامد بن يحيى البلخي عن أحمد بن الوليد السامري عن البزار","عامر بن عبد الله بن الزبير عن أبيه"
"2223","2214  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَبِي رَجَاءٍ قَالَ :  نَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ الْأَسْوَدِ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،         [6/171]      عَنْ  أَبِيهِ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  أَعْلِنُوا النِّكَاحَ وَاضْرِبُوا عَلَيْهِ بِالْغِرْبَالِ  -  يَعْنِي الدُّفَّ  - "" .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنِ  ابْنِ الزُّبَيْرِ  إِلَّا مِنْ هَذَا الْوَجْهِ ، بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2214","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن عبد الله بن الأسود القرشي عن عبد الله بن وهب المصري عن عبد الله بن أبي رجاء عن البزار","عامر بن عبد الله بن الزبير عن أبيه"
"2224","[6/172]      عَبْدُ اللهِ بْنُ عُرْوَةَ  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  2215  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورٍ قَالَ :  نَا  عَبْدُ اللهِ بْنُ صَالِحٍ قَالَ :  نَا  اللَّيْثُ بْنُ سَعْدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ خَالِدِ بْنِ مُسَافِرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عُرْوَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  إِنَّمَا سُمِّيَ  الْبَيْتَ الْعَتِيقَ  ؛ لِأَنَّهُ  أُعْتِقَ  مِنَ الْجَبَابِرَةِ  ، فَلَمْ يَنَلْهُ جَبَّارٌ قَطُّ ، أَوْ لَمْ يَقْدِرْ عَلَيْهِ جَبَّارٌ  .         [6/173]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِلَّا عَنِ  ابْنِ الزُّبَيْرِ  عَنْهُ ، وَلَا نَعْلَمُ لَهُ طَرِيقًا ، عَنِ  ابْنِ الزُّبَيْرِ  إِلَّا هَذَا الطَّرِيقَ .","","Musnad al-Bazzar 2215","","عبد الله بن الزبير عن عبد الله بن عروة بن الزبير بن العوام عن الزهري عن عبد الرحمن بن خالد بن مسافر الفهمي عن الليث بن سعد عن عبد الله بن صالح المصري عن أحمد بن منصور الرمادي عن البزار","عبد الله بن عروة عن عبد الله بن الزبير"
"2225","[6/174]      مُصْعَبُ بْنُ ثَابِتٍ  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  2216  -  حَدَّثَنَا  الْوَلِيدُ بْنُ عَمْرِو بْنِ سُكَيْنٍ قَالَ :  نَا  مُحَمَّدُ بْنُ الزِّبْرِقَانِ قَالَ :  نَا  مُوسَى بْنُ عُبَيْدَةَ ،  عَنْ  مُصْعَبِ بْنِ ثَابِتٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ بِقَوْمٍ يَضْحَكُونَ فَقَالَ :  أَتَضْحَكُونَ وَذِكْرُ الْجَنَّةِ وَالنَّارِ بَيْنَ أَظْهُرِكُمْ  ؟ "" قَالَ : فَمَا رُئِيَ أَحَدٌ مِنْهُمْ ضَاحِكًا حَتَّى مَاتَ ، قَالَ : وَنَزَلَتْ فِيهِمْ :         {      نَبِّئْ عِبَادِي أَنِّي أَنَا الْغَفُورُ الرَّحِيمُ             *          وَأَنَّ عَذَابِي هُوَ الْعَذَابُ الأَلِيمُ         }      .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ بِهَذَا اللَّفْظِ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا  ابْنُ الزُّبَيْرِ  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا إِلَّا هَذَا الطَّرِيقَ ، وَلَا نَعْلَمُ أَنَّ  مُصْعَبَ بْنَ ثَابِتٍ  سَمِعَ مِنِ  ابْنِ الزُّبَيْرِ  .","","Musnad al-Bazzar 2216","","عبد الله بن الزبير عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن موسى بن عبيدة بن نشيط الحميري عن محمد بن الزبرقان الأهوازي عن الوليد بن عمرو بن السكين الضبعي عن البزار","مصعب بن ثابت عن عبد الله بن الزبير"
"2226","2217  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مِرْدَاسٍ الْأَنْصَارِيُّ قَالَ :  نَا  عَبْدُ الْوَهَّابِ بْنُ         [6/175]      عَبْدِ الْمَجِيدِ قَالَ :  نَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  مُصْعَبِ بْنِ ثَابِتٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا أَفْطَرَ عِنْدَ قَوْمٍ قَالَ : "" أَفْطَرَ عِنْدَكُمُ الصَّائِمُونَ  ، وَأَكَلَ طَعَامَكُمُ الْأَبْرَارُ ، وَصَلَّتْ عَلَيْكُمُ الْمَلَائِكَةُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنِ  ابْنِ الزُّبَيْرِ  إِلَّا مِنْ رِوَايَةِ  مُصْعَبِ بْنِ ثَابِتٍ  عَنْهُ ، وَلَمْ نَسْمَعْ هَذَا الْحَدِيثَ إِلَّا مِنْ  مُحَمَّدِ بْنِ مِرْدَاسٍ  ، عَنْ  عَبْدِ الْوَهَّابِ  .","","Musnad al-Bazzar 2217","","عبد الله بن الزبير عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الوهاب بن عبد المجيد الثقفي عن محمد بن مرداس الأنصاري عن البزار","مصعب بن ثابت عن عبد الله بن الزبير"
"2227","2218  -  وَغَيْرُ  مُحَمَّدٍ  يَرْوِيهِ  عَنْ  عَبْدِ الْوَهَّابِ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  مُصْعَبِ بْنِ ثَابِتٍ ،  عَنِ  ابْنِ الزُّبَيْرِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، كَمَا رَوَاهُ  ابْنُ مِرْدَاسٍ  ، عَنْ  عَبْدِ الْوَهَّابِ  .  نَا  بِهِ مُحَمَّدُ بْنُ عَلِيٍّ الْأَهْوَازِيُّ قَالَ :  نَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ قَالَ :  نَا  سَعِيدُ بْنُ يَحْيَى .","","Musnad al-Bazzar 2218","","عبد الله بن الزبير عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الوهاب بن عبد المجيد الثقفي عن سعيد بن يحيى سعدان عن سليمان بن عبد الرحمن التميمي عن محمد بن علي الأهوازي عن البزار","مصعب بن ثابت عن عبد الله بن الزبير"
"2228","[6/176]      نَافِعُ بْنُ ثَابِتٍ  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  2219  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ أَبِي الْحَارِثِ قَالَ :  نَا  مَنْصُورُ بْنُ سَلَمَةَ الْخُزَاعِيُّ قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الْمَوَالِ قَالَ :  حَدَّثَنِي  نَافِعُ بْنُ ثَابِتٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ قَالَ : ""  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا صَلَّى الْعِشَاءَ صَلَّى أَرْبَعَ رَكَعَاتٍ وَأَوْتَرَ بِسَجْدَةٍ  ، ثُمَّ نَامَ حَتَّى يُصَلِّيَ بَعْدُ صَلَاتَهُ مِنَ اللَّيْلِ  .         [6/177]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ بِهَذَا اللَّفْظِ إِلَّا  ابْنُ الزُّبَيْرِ  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا عَنِ  ابْنِ الزُّبَيْرِ  أَحْسَنَ مِنْ هَذَا الطَّرِيقِ  .","","Musnad al-Bazzar 2219","","عبد الله بن الزبير عن نافع بن ثابت بن عبد الله بن الزبير بن العوام عن عبد الرحمن بن أبي الموال مولى علي بن أبي طالب عن منصور بن سلمة بن عبد العزيز عن إسماعيل بن أسد بن شاهين البغدادي عن البزار","نافع بن ثابت عن عبد الله بن الزبير"
"2229","[6/178]      حَنْظَلَةُ بْنُ قَيْسٍ  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  2220  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورِ بْنِ سَيَّارٍ قَالَ :  نَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  مُصْعَبِ بْنِ ثَابِتٍ ،  عَنْ  حَنْظَلَةَ بْنِ قَيْسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  مَنْ قُتِلَ دُونَ مَالِهِ فَهُوَ  شَهِيدٌ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنِ  ابْنِ الزُّبَيْرِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2220","","عبد الله بن الزبير عن حنظلة بن قيس بن عمرو الزرقي عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن عبد الله بن مصعب بن ثابت الزبيري عن مصعب بن عبد الله بن مصعب الزبيري عن أحمد بن منصور الرمادي عن البزار","حنظلة بن قيس عن عبد الله بن الزبير"
"2230","[6/179]      ثَابِتٌ الْبُنَانِيُّ  عَنِ  ابْنِ الزُّبَيْرِ  2221  -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ قَالَ :  أَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنِ  ابْنِ الزُّبَيْرِ قَالَ : ""  نَهَى  أَبُو الْقَاسِمِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، عَنِ الْحَرِيرِ  .  وَهَذَا الْكَلَامُ قَدْ رُوِيَ نَحْوُهُ عَنِ  ابْنِ الزُّبَيْرِ  ، عَنْ  عُمَرَ  رَضِيَ اللهُ عَنْهُ .         [6/180]      وَلَا نَعْلَمُ رَوَى  ثَابِتٌ  ، عَنِ  ابْنِ الزُّبَيْرِ  ، إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 2221","","عبد الله بن الزبير عن ثابت البناني عن حماد بن زيد عن عبد الواحد بن غياث عن البزار","ثابت البناني عن ابن الزبير"
"2231","[6/181]      الْعَبَّاسُ بْنُ سَهْلٍ  عَنِ  ابْنِ الزُّبَيْرِ  2222  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ قَالَ :  أَنَا  الْفَضْلُ بْنُ دُكَيْنٍ قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ الْغَسِيلِ قَالَ :  حَدَّثَنِي  الْعَبَّاسُ بْنُ سَهْلٍ قَالَ :  سَمِعْتُ  ابْنَ الزُّبَيْرِ ، يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  لَوْ أَنَّ لِابْنِ آدَمَ وَادِيًا مِنْ مَالٍ لَتَمَنَّى إِلَيْهِ وَادِيًا ثَانِيًا  ، وَلَوْ أَنَّ لَهُ ثَانِيًا لَتَمَنَّى إِلَيْهِ ثَالِثًا ، وَلَا يَمْلَأُ جَوْفَ ابْنِ آدَمَ إِلَّا التُّرَابُ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى ، عَنِ  ابْنِ الزُّبَيْرِ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2222","","عبد الله بن الزبير عن عباس بن سهل بن سعد الساعدي عن عبد الرحمن بن سليمان الأوسي عن الفضل بن دكين عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","العباس بن سهل عن ابن الزبير"
"2232","[6/182]      ثُوَيْرُ بْنُ أَبِي فَاخِتَةَ  عَنِ  ابْنِ الزُّبَيْرِ  2223  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَرْزُوقِ بْنِ بُكَيْرٍ قَالَ :  نَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ قَالَ :  نَا  إِسْرَائِيلُ ،  عَنْ  ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ قَالَ :  سَمِعْتُ  ابْنَ الزُّبَيْرِ يَقُولُ : ""  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ بِصَوْمِ يَوْمِ عَاشُورَاءَ  .","","Musnad al-Bazzar 2223","","عبد الله بن الزبير عن ثوير بن أبي فاختة مولى أم هانئ عن إسرائيل بن يونس بن أبي إسحاق عن مؤمل بن إسماعيل العدوي عن محمد بن محمد بن مرزوق الباهلي عن البزار","ثوير بن أبي فاختة عن ابن الزبير"
"2233","2224  -  وَنَاهُ  مَعْمَرُ بْنُ سَهْلٍ قَالَ :  نَا  مُصْعَبُ بْنُ الْمِقْدَامِ قَالَ :  نَا  إِسْرَائِيلُ ،  عَنْ  ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ ،  عَنِ  ابْنِ الزُّبَيْرِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .  وَهَذَا الْكَلَامُ لَا نَعْلَمُ يُرْوَى عَنِ  ابْنِ الزُّبَيْرِ  ، إِلَّا مِنْ هَذَا الْوَجْهِ ،  وَثُوَيْرٌ  قَدْ حَدَّثَ عَنْهُ  شُعْبَةُ  وَإِسْرَائِيلُ  وَغَيْرُهُمَا وَاحْتَمَلُوا حَدِيثَهُ .","","Musnad al-Bazzar 2224","","عبد الله بن الزبير عن ثوير بن أبي فاختة مولى أم هانئ عن إسرائيل بن يونس بن أبي إسحاق عن مصعب بن المقدام الخثعمي عن معمر بن سهل بن معمر الأهوازي عن البزار","ثوير بن أبي فاختة عن ابن الزبير"
"2234","[6/183]      سُبَيْعٌ  وَلَمْ يُنْسَبْ عَنِ  ابْنِ الزُّبَيْرِ  2225  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْكُوفِيُّ قَالَ :  نَا  مُخَوَّلُ بْنُ إِبْرَاهِيمَ قَالَ :  نَا  قَيْسٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سُبَيْعٍ ،  عَنِ  ابْنِ الزُّبَيْرِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2225","","عبد الله بن الزبير عن سبيع السلولي عن أبو إسحاق السبيعي عن قيس بن الربيع الأسدي عن مخول بن إبراهيم الكوفي عن أحمد بن يحيى بن زكريا عن البزار","سبيع ولم ينسب عن ابن الزبير"
"2235","2226  -  وَنَاهُ  مُحَمَّدُ بْنُ مَرْزُوقٍ قَالَ :  نَا  عَبْدُ الْعَزِيزِ بْنُ الْخَطَّابِ قَالَ :  نَا  قَيْسٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سُبَيْعٍ ،  عَنِ  ابْنِ الزُّبَيْرِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ ثَلَاثِينَ  دَجَّالًا  كَذَّابًا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا جَوَّدَهُ إِلَّا  قَيْسٌ  ، وَرَوَاهُ غَيْرُ وَاحِدٍ عَنْ  أَبِي إِسْحَاقَ  عَمَّنْ سَمِعَ  ابْنَ الزُّبَيْرِ  .","","Musnad al-Bazzar 2226","","عبد الله بن الزبير عن سبيع السلولي عن أبو إسحاق السبيعي عن قيس بن الربيع الأسدي عن عبد العزيز بن الخطاب الكوفي عن محمد بن محمد بن مرزوق الباهلي عن البزار","سبيع ولم ينسب عن ابن الزبير"
"2236","[6/184]      عَبْدُ الْعَزِيزِ بْنُ أُسَيْدٍ  عَنِ  ابْنِ الزُّبَيْرِ  2227  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ قَالَ :  نَا  شُعْبَةُ ،  عَنْ  أَبِي مَسْلَمَةَ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ أُسَيْدٍ ،  عَنِ  ابْنِ الزُّبَيْرِ ، "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ نَبِيذِ  الْجَرِّ  .  وَعَبْدُ الْعَزِيزِ بْنُ أُسَيْدٍ  هَذَا لَا نَعْلَمُ رَوَى عَنْهُ إِلَّا  أَبُو مَسْلَمَةَ  ، وَقَدْ رُوِيَ فِي النَّهْيِ عَنْ نَبِيذِ  الْجَرِّ  ، مِنْ وَجْهٍ آخَرَ .         [6/185]","","Musnad al-Bazzar 2227","","عبد الله بن الزبير عن عبد العزيز بن أسيد الطاحي عن سعيد بن يزيد الطاحي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","عبد العزيز بن أسيد عن ابن الزبير"
"2237","[6/186]      أَبُو الْحَكَمِ الْبَجَلِيُّ  عَنْهُ  2228  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  وَهْبُ بْنُ جَرِيرٍ قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي الْحَكَمِ قَالَ :  سَأَلْتُ  ابْنَ الزُّبَيْرِ ، فَقَالَ : ""  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ نَبِيذِ  الْجَرِّ  وَالدُّبَّاءِ  .  قَالَ :  وَسَأَلْتُ  ابْنَ عُمَرَ ، فَقَالَ : ""  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْجَرِّ  وَالدُّبَّاءِ  وَالْمُزَفَّتِ  .  قَالَ :  وَحَدَّثَنِي  أَخِي  ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنِ  الْجَرِّ  وَالدُّبَّاءِ  وَالْمُزَفَّتِ  ، وَعَنِ الْبُسْرِ وَالتَّمْرِ  .         [6/187]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  أَبِي الْحَكَمِ  إِلَّا  سَلَمَةُ بْنُ كُهَيْلٍ  .","","Musnad al-Bazzar 2228","","عبد الله بن الزبير عن عمران بن الحارث السلمي عن سلمة بن كهيل الحضرمي عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن أبو موسى الزمن عن البزار","أبو الحكم البجلي عنه"
"2238","[6/188]      أَبُو الْوَرْدِ  عَنِ  ابْنِ الزُّبَيْرِ  2229  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مِسْكِينٍ قَالَ :  نَا  سَعِيدُ بْنُ الْحَكَمِ قَالَ :  أَنَا  ابْنُ لَهِيعَةَ قَالَ :  حَدَّثَنِي  الْحَارِثُ بْنُ يَزِيدَ ، أَنَّ أَبَا الْوَرْدِ ،  حَدَّثَهُ  أَنَّهُ ، سَمِعَ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ ، يَقُولُ :  إِنَّ  تَشَهُّدَ  رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الَّذِي كَانَ يَتَشَهَّدُ بِهِ : "" بِاسْمِ اللهِ ، وَبِاللهِ خَيْرِ الْأَسْمَاءِ  ،  التَّحِيَّاتُ  الطَّيِّبَاتُ الصَّلَوَاتُ لِلهِ ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَشْهَدُ أَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ ، أَرْسَلَهُ بِالْحَقِّ بَشِيرًا وَنَذِيرًا ، وَأَنَّ السَّاعَةَ آتِيَةٌ لَا رَيْبَ فِيهَا ، السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ ، السَّلَامُ عَلَيْنَا وَعَلَى عِبَادِ اللهِ الصَّالِحِينَ ، اللَّهُمَّ اغْفِرْ لِي وَاهْدِنِي  .         [6/189]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ فِي  تَشَهُّدِ  النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِلَّا عَنِ  ابْنِ الزُّبَيْرِ  بِهَذَا  الْإِسْنَادِ  وَأَبُو الْوَرْدِ  ، فَلَا نَعْلَمُ رَوَى عَنْهُ إِلَّا  الْحَارِثُ بْنُ يَزِيدَ  ،  وَالْحَارِثُ بْنُ يَزِيدَ  قَدْ رَوَى عَنْهُ  ابْنُ لَهِيعَةَ  وَغَيْرُهُ .","","Musnad al-Bazzar 2229","","عبد الله بن الزبير عن أبو الورد عن الحارث بن يزيد الحضرمي عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن محمد بن مسكين بن نميلة اليمامي عن البزار","أبو الورد عن ابن الزبير"
"2239","[6/190]      أَبُو الزُّبَيْرِ  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  2230  -  حَدَّثَنَا  عَلِيُّ بْنُ شُعَيْبٍ قَالَ :  نَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ قَالَ :  نَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِي الزُّبَيْرِ مَوْلًى لِعَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنِ  ابْنِ الزُّبَيْرِ .","","Musnad al-Bazzar 2230","","عبد الله بن الزبير عن أبو الزبير المكي عن هشام بن عروة بن الزبير عن عبد الله بن نمير عن علي بن شعيب السمسار عن البزار","أبو الزبير عن عبد الله بن الزبير"
"2240","2231  -  وَنَاهُ  إِسْمَاعِيلُ بْنُ حَفْصٍ قَالَ :  نَا  عَبْدَةُ بْنُ سُلَيْمَانَ قَالَ :  نَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنِ  ابْنِ الزُّبَيْرِ ،  أَنَّهُ كَانَ يَقُولُ فِي دُبُرِ صَلَاتِهِ حِينَ يُسَلِّمُ : "" لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ  ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، وَلَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ ، وَلَا نَعْبُدُ إِلَّا إِيَّاهُ ، لَهُ النِّعْمَةُ وَالْفَضْلُ وَالثَّنَاءُ الْحَسَنُ ، مُخْلِصِينَ لَهُ الدِّينَ وَلَوْ كَرِهَ الْكَافِرُونَ "" .  قَالَ : "" وَكَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُهَلِّلُ بِهِنَّ فِي دُبُرِ كُلِّ صَلَاةٍ  .         [6/191]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى ، إِلَّا عَنِ  ابْنِ الزُّبَيْرِ  ، بِهَذَا اللَّفْظِ .","","Musnad al-Bazzar 2231","","عبد الله بن الزبير عن أبو الزبير المكي عن هشام بن عروة بن الزبير عن عبدة بن سليمان الكلابي عن إسماعيل بن حفص بن عمر بن دينار الأبلي عن البزار","أبو الزبير عن عبد الله بن الزبير"
"2241","[6/192]      يَعِيشُ بْنُ الْوَلِيدِ مَوْلَى ابْنِ الزُّبَيْرِ  عَنْهُ  2232  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورِ بْنِ سَيَّارٍ قَالَ :  نَا  خَلَفُ بْنُ مُوسَى بْنِ خَلَفٍ قَالَ :  نَا  أَبِي  ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  يَعِيشَ بْنِ الْوَلِيدِ ، مَوْلًى لِابْنِ الزُّبَيْرِ ،  عَنِ  ابْنِ الزُّبَيْرِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  دَبَّ إِلَيْكُمْ دَاءُ الْأُمَمِ قَبْلَكُمُ الْبَغْضَاءُ  وَالْحَسَدُ  ، وَالْبَغْضَاءُ وَهِيَ  الْحَالِقَةُ ،  لَيْسَ حَالِقَةَ الشَّعَرِ لَكِنْ حَالِقَةَ الدِّينِ ، وَالَّذِي نَفْسِي بِيَدِهِ لَا تَدْخُلُوا الْجَنَّةَ حَتَّى تُؤْمِنُوا ، وَلَا تُؤْمِنُوا حَتَّى تَحَابُّوا ، أَفَلَا أُنَبِّئُكُمْ - أَظُنُّهُ بِمَا يَثْبُتُ لَكُمْ - أَفْشُوا السَّلَامَ بَيْنَكُمْ  .         [6/193]      وَهَذَا الْحَدِيثُ خَالَفَ  مُوسَى بْنَ خَلَفٍ  فِي  إِسْنَادِهِ  هِشَامٌ صَاحِبُ الدَّسْتُوَائِيِّ  ، فَرَوَاهُ  هِشَامٌ  ، عَنْ  يَحْيَى  ، عَنْ  يَعِيشَ بْنِ الْوَلِيدِ  ، عَنْ  مَوْلَى الزُّبَيْرِ  ، عَنِ  الزُّبَيْرِ  .  وَقَالَ  مُوسَى  : عَنْ  يَحْيَى  ، عَنْ  يَعِيشَ مَوْلَى ابْنِ الزُّبَيْرِ  ، عَنِ  ابْنِ الزُّبَيْرِ  ،  وَهِشَامٌ  أَحْفَظُ  .","","Musnad al-Bazzar 2232","","عبد الله بن الزبير عن يعيش بن الوليد بن هشام القرشي عن يحيى بن أبي كثير عن موسى بن خلف العمي عن خلف بن موسى بن خلف العمي عن أحمد بن منصور الرمادي عن البزار","يعيش بن الوليد مولى ابن الزبير عنه"
"2242","[6/194]      رَجُلٌ عَنِ  ابْنِ الزُّبَيْرِ  2233  -  حَدَّثَنَا  خَالِدُ بْنُ يُوسُفَ قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  سِنَانِ بْنِ حَبِيبٍ ،  عَنْ  رَجُلٍ ،  عَنِ  ابْنِ الزُّبَيْرِ ، ""  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَأْمُرُ بِالسِّوَاكِ  .  وَلَا نَعْلَمُ يُرْوَى عَنِ  ابْنِ الزُّبَيْرِ  هَذَا الْكَلَامُ إِلَّا مِنْ هَذَا الْوَجْهِ .","","Musnad al-Bazzar 2233","","عبد الله بن الزبير عن رجل عن سنان بن حبيب السلمي عن الوضاح بن عبد الله اليشكري عن خالد بن يوسف بن خالد السمتي عن البزار","رجل عن ابن الزبير"
"2243","[6/195]      مُسْنَدُ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  رَضِيَ اللهُ عَنْهُ         [6/196]             [6/197]      مُسْنَدُ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْقَاسِمُ بْنُ مُحَمَّدٍ  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  2234  -  حَدَّثَنَا  مُوسَى بْنُ عَبْدِ اللهِ أَبُو طَلْحَةَ الْخُزَاعِيُّ قَالَ :  نَا  بَكْرُ بْنُ سُلَيْمَانَ قَالَ :  نَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي حَكِيمٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  لَا يَنْبَغِي لِعَبْدٍ أَنْ يَقُولَ : أَنَا خَيْرٌ مِنْ  يُونُسَ بْنِ مَتَّى  .","","Musnad al-Bazzar 2234","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن القاسم بن محمد بن أبي بكر الصديق عن إسماعيل بن أبي حكيم القرشي عن محمد بن إسحاق عن بكر بن سليمان الأسواري عن موسى بن عبد الله بن موسى الطلحي عن البزار","القاسم بن محمد عن عبد الله بن جعفر"
"2244","2235  -  وَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ قَالَ :  نَا  يَحْيَى بْنُ سَعِيدٍ الْأُمَوِيُّ ،  عَنِ  ابْنِ إِسْحَاقَ .  2236  -  وَنَاهُ  سَعِيدُ بْنُ نُوحٍ قَالَ :  نَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ إِسْحَاقَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي حَكِيمٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .         [6/198]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  ، إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2235","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن القاسم بن محمد بن أبي بكر الصديق عن إسماعيل بن أبي حكيم القرشي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن سعيد بن نوح الضبعي عن البزار","القاسم بن محمد عن عبد الله بن جعفر"
"2245","2237  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  عُثْمَانُ بْنُ الْهَيْثَمِ قَالَ :  نَا  حَنْظَلَةُ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ : ""  نَهَى عَنْ قَتْلِ  الْجِنَّانِ  -  أَحْسِبُهُ قَالَ - : الَّتِي فِي الْبُيُوتِ  .","","Musnad al-Bazzar 2237","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن القاسم بن محمد بن أبي بكر الصديق عن حنظلة الجمحي عن عثمان بن الهيثم بن جهم الأشج عن أبو موسى الزمن عن البزار","القاسم بن محمد عن عبد الله بن جعفر"
"2246","2238  -  وَحَدَّثَنِي  الْقَاسِمُ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، بِنَحْوِهِ .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  ، إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2238","","عبد الله بن عمر بن الخطاب عن القاسم بن محمد بن أبي بكر الصديق عن حنظلة الجمحي عن عثمان بن الهيثم بن جهم الأشج عن أبو موسى الزمن عن البزار","القاسم بن محمد عن عبد الله بن جعفر"
"2247","2239  -  وَنَاهُ  أَزْهَرُ بْنُ جَمِيلٍ قَالَ :  نَا  أَبُو عَاصِمٍ ،  عَنْ  حَنْظَلَةَ ،  عَنِ  الْقَاسِمِ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ : ""  نُهِيَ عَنْ قَتْلِهِنَّ ، يَعْنِي  الْجِنَّانَ  الَّتِي فِي الْبُيُوتِ  .","","Musnad al-Bazzar 2239","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن القاسم بن محمد بن أبي بكر الصديق عن حنظلة الجمحي عن أبو عاصم النبيل عن أزهر بن جميل الشطي عن البزار","القاسم بن محمد عن عبد الله بن جعفر"
"2248","[6/199]      عُرْوَةُ بْنُ الزُّبَيْرِ  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  2240  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَالِكٍ الْبَغْدَادِيُّ قَالَ :  نَا  عَمْرُو بْنُ عَبْدِ الْغَفَّارِ قَالَ :  نَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ : ""  رَأَيْتُ النَّبِيَّ يَأْكُلُ الْقِثَّاءَ بِالرُّطَبِ  .  وَهَذَا الْحَدِيثُ عَنْ  هِشَامِ بْنِ عُرْوَةَ  لَا نَعْلَمُ رَوَى عَنْهُ إِلَّا  عَمْرُو بْنُ عَبْدِ الْغَفَّارِ  ، وَهُوَ رَجُلٌ مِنْ  أَهْلِ الْكُوفَةِ  لَا بَأْسَ بِهِ  ، وَلَمْ نَسْمَعْهُ إِلَّا مِنْ  إِبْرَاهِيمَ بْنِ مَالِكٍ  عَنْهُ .","","Musnad al-Bazzar 2240","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عمرو بن عبد الغفار الفقيمي عن إبراهيم بن مالك بن بهبوذ البزاز عن البزار","عروة بن الزبير عن عبد الله بن جعفر"
"2249","[6/200]      الشَّعْبِيُّ  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  2241  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ قَالَ :  نَا  أَبُو أُسَامَةَ قَالَ :  نَا  جُنَيْدُ بْنُ الْعَلَاءِ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ قَالَ :  سَأَلْتُ  عَبْدَ اللهِ بْنَ جَعْفَرٍ ، عَنِ الْوَصَى - يَعْنِي هَلْ أَوْصَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ :  مَا سَمِعْتُ بِهِ حَتَّى قَدِمْتُ بَلَدَكُمْ هَذَا  "" .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ إِلَّا  أَبُو أُسَامَةَ  عَنْ  جُنَيْدٍ  .","","Musnad al-Bazzar 2241","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن الشعبي عن مجالد بن سعيد عن جنيد بن العلاء التيمي عن حماد بن أسامة القرشي عن إبراهيم بن سعيد الجوهري عن البزار","الشعبي عن عبد الله بن جعفر"
"2250","[6/201]      مُوَرِّقٌ الْعِجْلِيُّ  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  2242  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ قَالَ :  نَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ قَالَ :  نَا  عَاصِمٌ الْأَحْوَلُ ،  عَنْ  مُوَرِّقٍ الْعِجْلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ : ""  أَرْدَفَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  وَابْنَيْ فَاطِمَةَ  أَوْ  أَحَدَ ابْنَيْ فَاطِمَةَ  رَضِيَ اللهُ عَنْهَا عَلَى دَابَّةٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  بِأَحْسَنَ مِنْ هَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2242","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن مورق العجلي عن عاصم بن سليمان الأحول عن عبد الواحد بن زياد عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","مورق العجلي عن عبد الله بن جعفر"
"2251","[6/202]      مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحُسَيْنِ  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  2243  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ الْمَعْرُوفُ بِابْنِ أَبِي عَلِيٍّ الْكَرْمَانِيِّ قَالَ :  نَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي فُدَيْكٍ قَالَ :  نَا  سَعِيدُ بْنُ سُفْيَانَ الْأَسْلَمِيُّ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  إِنَّ يَدَ اللهِ مَعَ الدَّائِنِ حَتَّى يَقْضِيَ دَيْنَهُ  ، مَا لَمْ يَكُنْ فِيمَا يَكْرَهُ اللهُ  .         [6/203]      وَهَذَا الْكَلَامُ لَا نَعْلَمُ رَوَاهُ بِهَذَا اللَّفْظِ إِلَّا  عَبْدُ اللهِ بْنُ جَعْفَرٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2243","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن أبو جعفر الباقر عن جعفر الصادق عن سعيد بن سفيان الأسلمي عن محمد بن إسماعيل بن مسلم الديلي عن محمد بن الحسن المعروف بابن أبي علي الكرماني عن البزار","محمد بن علي بن الحسين عن عبد الله بن جعفر"
"2252","2244  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ قَالَ :  نَا  أَبُو دَاوُدَ قَالَ :  نَا  شَيْبَانُ يَعْنِي ابْنَ عَبْدِ الرَّحْمَنِ ،  عَنْ  جَابِرِ بْنِ يَزِيدَ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، ""  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ احْتَجَمَ عَلَى قَرْنِ رَأْسِهِ وَهُوَ مُحْرِمٌ  .  وَلَا نَعْلَمُ يُرْوَى هَذَا اللَّفْظُ إِلَّا عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2244","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن أبو جعفر الباقر عن جابر الجعفي عن شيبان بن عبد الرحمن المؤدب عن أبو داود الطيالسي عن الفلاس عن البزار","محمد بن علي بن الحسين عن عبد الله بن جعفر"
"2253","[6/204]      خَالِدُ بْنُ سَارَةَ  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  2245  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدَةَ قَالَ :  أَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ قَالَ :  نَا  جَعْفَرُ بْنُ خَالِدِ بْنِ سَارَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  اصْنَعُوا  لِآلِ جَعْفَرٍ  طَعَامًا فَقَدْ أَتَاهُمْ  مَا يَشْغَلُهُمْ "" أَوْ أَمْرٌ يَشْغَلُهُمْ  ،  يَعْنِي يَوْمَ جَاءَ نَعْيُ  جَعْفَرٍ  رَضِيَ اللهُ عَنْهُ  .","","Musnad al-Bazzar 2245","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن خالد بن سارة المخزومي عن جعفر بن خالد بن سارة المخزومي عن سفيان بن عيينة عن أحمد بن عبدة الضبي عن البزار","خالد بن سارة عن عبد الله بن جعفر"
"2254","[6/205]      2246  -  وَنَاهُ  أَحْمَدُ بْنُ عَبْدَةَ قَالَ :  أَنَا  سُفْيَانُ ،  عَنْ  جَعْفَرِ بْنِ خَالِدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ""  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَمَلَ غُلَامَيْنِ مِنْ  بَنِي عَبْدِ الْمُطَّلِبِ  عَلَى دَابَّةٍ  .  وَجَعْفَرُ بْنُ خَالِدٍ  هَذَا رَوَى عَنْهُ  ابْنُ جُرَيْجٍ  وَابْنُ عُيَيْنَةَ  .","","Musnad al-Bazzar 2246","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن خالد بن سارة المخزومي عن جعفر بن خالد بن سارة المخزومي عن سفيان بن عيينة عن أحمد بن عبدة الضبي عن البزار","خالد بن سارة عن عبد الله بن جعفر"
"2255","[6/206]      سَعْدُ بْنُ إِبْرَاهِيمَ  عَنْهُ  2247  -  حَدَّثَنَا  أَحْمَدُ بْنُ أَبَانَ الْقُرَشِيُّ قَالَ :  نَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ : ""  رَأَيْتُ النَّبِيَّ يَأْكُلُ الْقِثَّاءَ بِالرُّطَبِ  .  وَلَا نَعْلَمُ رَوَى  سَعْدُ بْنُ إِبْرَاهِيمَ  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  إِلَّا هَذَا الْحَدِيثَ  .         [6/207]","","Musnad al-Bazzar 2247","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن أحمد بن أبان القرشي عن البزار","سعد بن إبراهيم عنه"
"2256","[6/208]      إِسْحَاقُ بْنُ عَبْدِ اللهِ بْنِ جَعْفَرٍ  عَنْ أَبِيهِ  2248  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ قَالَ :  نَا  أَبُو عَامِرٍ قَالَ :  نَا  كَثِيرُ بْنُ زَيْدٍ ،  عَنْ  إِسْحَاقَ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  لَقِّنُوا مَوْتَاكُمْ لَا إِلَهَ إِلَّا اللهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  إِلَّا مِنْ هَذَا الْوَجْهِ  .","","Musnad al-Bazzar 2248","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن إسحاق بن عبد الله بن جعفر بن أبي طالب عن كثير بن زيد السهمي عن أبو عامر العقدي عن محمد بن بشار بندار عن البزار","إسحاق بن عبد الله بن جعفر عن أبيه"
"2257","[6/209]      إِسْمَاعِيلُ بْنُ عَبْدِ اللهِ بْنِ جَعْفَرٍ  عَنْ أَبِيهِ  2249  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ شَبِيبٍ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ قَالَ :  نَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي فُدَيْكٍ قَالَ :  نَا  ابْنُ أَبِي مُلَيْكَةَ يَعْنِي عَبْدَ الرَّحْمَنِ بْنَ أَبِي مُلَيْكَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  أَبِيهِ  قَالَ :  لَمَّا قَدِمَ  جَعْفَرٌ  مِنَ  الْحَبَشَةِ  أَتَاهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَبَّلَ بَيْنَ عَيْنَيْهِ ، وَقَالَ :  مَا أَنَا بِفَتْحِ  خَيْبَرَ  أَشَدُّ مِنِّي فَرَحًا بِقُدُومِ  جَعْفَرٍ  رَضِيَ اللهُ عَنْهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مِنْ هَذَا الْوَجْهِ ؛ وَقَدْ رَوَاهُ  الشَّعْبِيُّ  ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  ، عَنْ أَبِيهِ  .","","Musnad al-Bazzar 2249","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن إسماعيل بن عبد الله بن جعفر بن أبي طالب الهاشمي عن عبد الرحمن بن أبي بكر الجدعاني عن محمد بن إسماعيل بن مسلم الديلي عن إسماعيل بن أبي أويس عن عبد الله بن شبيب الربعي عن البزار","إسماعيل بن عبد الله بن جعفر عن أبيه"
"2258","2250  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ شَبِيبٍ قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ شَيْبَةَ ،         [6/210]      قَالَ :  نَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ قَالَ :  حَدَّثَنِي  ابْنُ أَبِي مُلَيْكَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  أَيُّهَا النَّاسُ تُوبُوا إِلَى اللهِ تَبَارَكَ وَتَعَالَى ، فَإِنِّي أَتُوبُ فِي كُلِّ يَوْمٍ سَبْعِينَ مَرَّةً  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2250","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن إسماعيل بن عبد الله بن جعفر بن أبي طالب الهاشمي عن ابن أبي مليكة عن محمد بن إسماعيل بن مسلم الديلي عن عبد الرحمن بن عبد الملك الحزامي عن عبد الله بن شبيب الربعي عن البزار","إسماعيل بن عبد الله بن جعفر عن أبيه"
"2259","2251  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ شَبِيبٍ قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ شَيْبَةَ قَالَ :  نَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي فُدَيْكٍ قَالَ :  حَدَّثَنِي  ابْنُ أَبِي مُلَيْكَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  أَبِيهِ  قَالَ :  لَمَّا نَظَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى الرَّحْمَةِ هَابِطَةً قَالَ :  مَنْ يَدْعُو لِي ؟  فَقَالَتِ ابْنَتُهُ : أَنَا يَا رَسُولَ اللهِ ، فَقَالَ : "" ادْعِي  عَلِيًّا  رَضِيَ اللهُ عَنْهُ ، فَدُعِيَ  وَفَاطِمَةُ  وَالْحَسَنُ  وَالْحُسَيْنُ  رَضِيَ اللهُ عَنْهُمْ ، فَجَعَلَ  الْحَسَنَ  عَنْ يَمِينِهِ ،  وَالْحُسَيْنَ  عَنْ يَسَارِهِ ،  وَفَاطِمَةَ  تُجَاهَهُ ، ثُمَّ غَشَاهُمْ كِسَاءً ، ثُمَّ قَالَ : "" هَؤُلَاءِ أَهْلِي "" ، فَأَنْزَلَ اللهُ تَبَارَكَ وَتَعَالَى :         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      .         [6/211]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  إِلَّا مِنْ هَذَا الْوَجْهِ  .","","Musnad al-Bazzar 2251","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن إسماعيل بن عبد الله بن جعفر بن أبي طالب الهاشمي عن عبد الرحمن بن أبي بكر الجدعاني عن محمد بن إسماعيل بن مسلم الديلي عن عبد الرحمن بن عبد الملك الحزامي عن عبد الله بن شبيب الربعي عن البزار","إسماعيل بن عبد الله بن جعفر عن أبيه"
"2260","2252  -  حَدَّثَنَا  نَجِيحُ بْنُ إِبْرَاهِيمَ الْكُوفِيُّ قَالَ :  نَا  ضِرَارُ بْنُ صُرَدٍ قَالَ :  نَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي فُدَيْكٍ قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي مُلَيْكَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  أَبِيهِ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِعَلِيٍّ  رَضِيَ اللهُ عَنْهُ :  إِنَّ اللهَ تَبَارَكَ وَتَعَالَى أَمَرَنِي أَنْ أُدْنِيَكَ وَلَا أُقْصِيَكَ ، وَأَنْ أُعَلِّمَكَ وَلَا أَجْفُوَكَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2252","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن إسماعيل بن عبد الله بن جعفر بن أبي طالب الهاشمي عن عبد الرحمن بن أبي بكر الجدعاني عن محمد بن إسماعيل بن مسلم الديلي عن ضرار بن صرد التيمي عن نجيح بن إبراهيم الزماني عن البزار","إسماعيل بن عبد الله بن جعفر عن أبيه"
"2261","2253  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورِ بْنِ سَيَّارٍ قَالَ :  نَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  إِسْمَاعِيلَ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  أَبِيهِ  قَالَ : ""  رَأَيْتُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَوْبَيْنِ أَصْفَرَيْنِ  .         [6/212]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2253","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن إسماعيل بن عبد الله بن جعفر بن أبي طالب الهاشمي عن عبد الله بن مصعب بن ثابت الزبيري عن مصعب بن عبد الله بن مصعب الزبيري عن أحمد بن منصور الرمادي عن البزار","إسماعيل بن عبد الله بن جعفر عن أبيه"
"2262","[6/213]      مُعَاوِيَةُ بْنُ عَبْدِ اللهِ بْنِ جَعْفَرٍ  عَنْ أَبِيهِ  2254  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  نَا  يَعْقُوبُ بْنُ مُحَمَّدٍ قَالَ :  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  يَزِيدَ بْنِ الْهَادِ ،  عَنْ  مُعَاوِيَةَ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  لَا تَتَّخِذُوا أَشْيَاءَ فِيهِ الرُّوحُ غَرَضًا  .  وَهَذَا الْكَلَامُ قَدْ رُوِيَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ غَيْرِ وَجْهٍ .         [6/214]      وَلَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2254","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن معاوية بن عبد الله بن جعفر بن أبي طالب عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن محمد الدراوردي عن يعقوب بن محمد بن عيسى عن يوسف بن موسى بن راشد عن البزار","معاوية بن عبد الله بن جعفر عن أبيه"
"2263","2255  -  حَدَّثَنَا  أَحْمَدُ بْنُ أَبَانَ الْقُرَشِيُّ قَالَ :  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  عَمْرِو بْنِ أَبِي عَمْرٍو ،  عَنْ  مُعَاوِيَةَ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  أَحْسَبُهُ  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  يَوْمَ أُحُدٍ  - وَهُوَ يَدْفِنُ  حَمْزَةَ بْنَ عَبْدِ الْمُطَّلِبِ  رَضِيَ اللهُ عَنْهُ - فَأَتَى  بِنَمِرَةٍ  يُكَفَّنُ فِيهَا ، فَبَدَتْ قَدَمَاهُ حَتَّى  خَمَّرَ  رَأْسَهُ وَجَعَلَ عَلَى قَدَمَيْهِ -  أَحْسَبُهُ قَالَ  إِذْخَرٌ  - ثُمَّ دَفَنَهُ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْلَا أَنْ يَحْزَنَ لِذَلِكَ نِسَاؤُنَا لَتَرَكْتُكَ بِالْعَرَاءِ لِعَامَّةِ الطَّيْرِ وَالسِّبَاعِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2255","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن معاوية بن عبد الله بن جعفر بن أبي طالب عن عمرو بن أبي عمرو المخزومي عن عبد العزيز بن محمد الدراوردي عن أحمد بن أبان القرشي عن البزار","معاوية بن عبد الله بن جعفر عن أبيه"
"2264","[6/215]      ابْنُ عَقِيلٍ  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  2256  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ مَهْدِيٍّ قَالَ :  نَا  عَبْدُ الرَّزَّاقِ قَالَ :  نَا  يَحْيَى بْنُ الْعَلَاءِ ،  عَنِ  ابْنِ عَقِيلٍ - يَعْنِي عَبْدَ اللهِ بْنَ مُحَمَّدِ بْنِ عَقِيلٍ - ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَتَخَتَّمُ فِي يَمِينِهِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  ابْنِ عَقِيلٍ  إِلَّا  يَحْيَى بْنُ الْعَلَاءِ  .","","Musnad al-Bazzar 2256","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عبد الله بن محمد بن عقيل بن أبي طالب عن يحيى بن العلاء الفوراردي عن عبد الرزاق الصنعاني عن الحسين بن مهدي الأبلي عن البزار","ابن عقيل عن عبد الله بن جعفر"
"2265","[6/216]      الْحَسَنُ بْنُ سَعْدٍ  عَنْهُ  2257  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  وَهْبُ بْنُ جَرِيرٍ قَالَ :  نَا  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ أَبِي يَعْقُوبَ ،  عَنِ  الْحَسَنِ بْنِ سَعْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَكَرَ جَيْشَ الْأُمَرَاءِ قَالَ : "" ثُمَّ أَخَذَ  الرَّايَةَ  جَعْفَرٌ  فَأُصِيبَ  ، ثُمَّ أَخَذَهَا  زَيْدُ بْنُ حَارِثَةَ  فَأُصِيبَ ، ثُمَّ أَخَذَهَا  عَبْدُ اللهِ بْنُ رَوَاحَةَ  فَأُصِيبَ ، ثُمَّ أَخَذَهَا سَيْفٌ مِنْ سُيُوفِ اللهِ تَبَارَكَ وَتَعَالَى  خَالِدُ بْنُ الْوَلِيدِ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُ رَوَاهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا  عَبْدُ اللهِ بْنُ جَعْفَرٍ  .","","Musnad al-Bazzar 2257","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن الحسن بن سعد مولى علي بن أبي طالب عن محمد بن عبد الله بن أبي يعقوب عن جرير بن حازم عن وهب بن جرير بن حازم عن أبو موسى الزمن عن البزار","الحسن بن سعد عنه"
"2266","2258  -  حَدَّثَنَا  فِطْرُ بْنُ حَمَّادِ بْنِ وَاقِدٍ قَالَ :  نَا  مَهْدِيُّ بْنُ مَيْمُونٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ أَبِي يَعْقُوبَ ،  عَنِ  الْحَسَنِ بْنِ سَعْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ : ""  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا أَرَادَ حَاجَةً         [6/217]      أَحَبَّ أَنْ يَسْتَهْدِفَ بِحَائِطٍ أَوْ  حَائِشِ  نَخْلٍ فَأَرْدَفَنِي خَلْفَهُ ، ثُمَّ انْطَلَقَ إِلَى أَصْلِ حَائِطٍ فَاسْتَهْدَفَ  .         [6/218]      وَهَذَا الْكَلَامُ قَدْ رُوِيَ نَحْوُهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ غَيْرِ وَجْهٍ ، وَلَا نَعْلَمُهُ يُرْوَى ، عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2258","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن الحسن بن سعد مولى علي بن أبي طالب عن محمد بن عبد الله بن أبي يعقوب عن مهدي بن ميمون المعولي عن فطر بن حماد عن البزار","الحسن بن سعد عنه"
"2267","[6/219]      ابْنُ أَبِي رَافِعٍ  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  2259  -  حَدَّثَنَا  طَالُوتُ بْنُ عَبَّادٍ قَالَ :  نَا  حَمَّادُ بْنُ سَلَمَةَ قَالَ :  حَدَّثَنِي  ابْنُ أَبِي رَافِعٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَتَخَتَّمُ فِي يَمِينِهِ  .         [6/220]      وَابْنُ أَبِي رَافِعٍ  هَذَا رَوَى عَنْهُ  حَمَّادُ بْنُ سَلَمَةَ  غَيْرَ حَدِيثٍ .  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  ابْنُ أَبِي رَافِعٍ  ،  وَابْنُ عَقِيلٍ  .","","Musnad al-Bazzar 2259","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عبد الرحمن بن أبي رافع عن حماد بن سلمة عن طالوت بن عباد الجحدري عن البزار","ابن أبي رافع عن عبد الله بن جعفر"
"2268","[6/221]      بُدَيْحٌ مَوْلَى عَبْدِ اللهِ بْنِ جَعْفَرٍ  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  2260  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ قَالَ :  نَا  عُمَرُ بْنُ عَبْدِ الْوَهَّابِ قَالَ :  نَا  جُوَيْرِيَةُ بْنُ أَسْمَاءَ ،  عَنْ  عِيسَى بْنِ عُمَرَ ،  عَنْ  بُدَيْحٍ ، مَوْلَى عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ""  سَمَّى  الْمَدِينَةَ  طَابَةَ  .  وَهَذَا الْحَدِيثُ فِيهِ كَلَامٌ آخَرُ ، فَاخْتَصَرْنَا مِنْهُ مَوْضِعَ الرَّفْعِ ، وَلَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2260","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن بديح مولى عبد الله بن جعفر عن عيسى بن عمر بن موسى الحجازي عن جويرية بن أسماء الضبعي عن عمر بن عبد الوهاب الرياحي عن الفلاس عن البزار","بديح مولى عبد الله بن جعفر عن عبد الله بن جعفر"
"2269","[6/222]      شَيْخٌ مِنْ  فَهْمٍ  يُقَالُ لَهُ  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  2261  -  حَدَّثَنَا  عَمْرٌو قَالَ :  نَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  مِسْعَرٍ قَالَ :  حَدَّثَنِي  شَيْخٌ مِنْ  فَهْمٍ  قَالَ  يَحْيَى  : اسْمُهُ مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  أَطْيَبُ اللَّحْمِ لَحْمُ الظَّهْرِ  .         [6/223]      وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ غَيْرُ وَاحِدٍ ، عَنْ  مِسْعَرٍ  ، عَنْ شَيْخٍ مِنْ  فَهْمٍ  ، وَلَا نَعْلَمُ أَحَدًا سَمَّاهُ إِلَّا  يَحْيَى بْنُ سَعِيدٍ  .","","Musnad al-Bazzar 2261","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن محمد بن عبد الله بن أبي رافع الفهمي عن مسعر بن كدام عن يحيى القطان عن الفلاس عن البزار","شيخ من فهم يقال له محمد بن عبد الرحمن عن عبد الله بن جعفر"
"2270","2262  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  نَا  جَرِيرٌ ،  عَنْ  رَقَبَةَ بْنِ مَسْقَلَةَ ،  عَنْ  شَيْخٍ مِنْ فَهْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  أَطْيَبُ اللَّحْمِ لَحْمُ الظَّهْرِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  رَقَبَةَ  إِلَّا  جَرِيرٌ  .         [6/224]","","Musnad al-Bazzar 2262","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن محمد بن عبد الله بن أبي رافع الفهمي عن رقبة بن مصقلة عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","شيخ من فهم يقال له محمد بن عبد الرحمن عن عبد الله بن جعفر"
"2271","[6/225]      مُسْنَدُ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  رَضِيَ اللهُ عَنْهُمَا         [6/226]             [6/227]      مُسْنَدُ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ الصِّدِّيقِ  رَضِيَ اللهُ عَنْهُ  أَبُو عُثْمَانَ النَّهْدِيُّ  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  2263  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ حَبِيبٍ قَالَ :  نَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ قَالَ :  حَدَّثَنِي  أَبِي  عَنْ  أَبِي  عُثْمَانَ النَّهْدِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ ،  أَنَّ  أَصْحَابَ الصُّفَّةِ  ، كَانُوا نَاسًا فُقَرَاءَ وَأَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ كَانَ عِنْدَهُ طَعَامُ اثْنَيْنِ فَلْيَذْهَبْ بِثَلَاثَةٍ ، وَمَنْ كَانَ عِنْدَهُ طَعَامُ أَرْبَعَةٍ فَلْيَذْهَبْ بِخَمْسَةٍ  أَوْ كَمَا قَالَ ، وَإِنَّ  أَبَا بَكْرٍ الصِّدِّيقَ  رَضِيَ اللهُ عَنْهُ ، جَاءَ بِثَلَاثَةٍ ، وَانْطَلَقَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِعَشَرَةٍ ،  وَأَبُو بَكْرٍ  بِثَلَاثَةٍ قَالَ : فَهُوَ أَنَا وَأَبِي وَأُمِّي ، قَالَ : وَلَا أَدْرِي قَالَ : وَخَادِمُ بَيْتِنَا وَبَيْتِ  أَبِي بَكْرٍ  ، وَأَنَّ  أَبَا بَكْرٍ  تَعَشَّى عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ لَبِثَ حَتَّى صَلَّى الْعِشَاءَ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ رَجَعَ فَجَاءَ بَعْدَمَا مَضَى مِنَ اللَّيْلِ مَا شَاءَ اللهُ ، فَقَالَتِ امْرَأَتُهُ : مَا حَبَسَكَ عَنْ  أَضْيَافِكَ ؟ أَوْ قَالَتْ : ضَيْفِكَ ؟ قَالَ : أَوَمَا عَشَّيْتُمُوهُمْ  ؟ قَالَتْ : أَبَوْا حَتَّى تَجِيءَ ، قَدْ عَرَضُوا عَلَيْهِمْ ، قَالَ : فَذَهَبْتُ أَنَا فَاخْتَبَأْتُ ، فَقَالَ : يَا  غُنْثَرُ ،  قَالَ : فَجَزَّعَ وَسَبَّ ، وَقَالَ : كُلُوا وَاللهِ لَا أَطْعَمُهُ أَبَدًا ،         [6/228]      قَالُوا : فَايْمُ اللهِ مَا كُنَّا لِنَأْكُلَ حَتَّى تَأْكُلَ ، قَالَ : فَأَخَذَ ، فَايْمُ اللهِ مَا كُنَّا لِنَأْخُذَ مِنْ لُقْمَةٍ إِلَّا رَبَا مِنْ أَسْفَلِهَا قَالَ : فَشَبِعْنَا وَصَارَ أَكْثَرَ مِمَّا كَانَ قَبْلَ ذَلِكَ ، فَنَظَرَ إِلَيْهَا  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ ، فَإِذَا هِيَ كَمَا هِيَ أَوْ أَكْثَرُ ، فَقَالَ لِأُمِّهِ : يَا أُخْتَ  بَنِي فِرَاسٍ  ، مَا هَذَا ؟ قَالَتْ : لَا وَقُرَّةِ عَيْنِي لَهِيَ أَكْثَرُ مِنْهَا قَبْلَ ذَلِكَ بِثَلَاثِ مَرَّاتٍ ، وَأَكَلَ مِنْهَا  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ ، وَقَالَ : كَانَ ذَلِكَ مِنَ الشَّيْطَانِ -  يَعْنِي يَمِينَهُ  - ثُمَّ أَكَلَ مِنْهَا لُقْمَةً ، ثُمَّ حَمَلَهَا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَصْبَحَتْ عِنْدَهُ ، قَالَ : وَكَانَ بَيْنَنَا وَبَيْنَ قَوْمٍ عَقْدٌ فَمَضَى الْأَجَلُ فَفَرَّقَنَا اثْنَا عَشَرَ رَجُلًا مَعَ كُلِّ رَجُلٍ مِنْهُمُ اللهُ أَعْلَمُ كَمْ تَبِعَ كُلُّ رَجُلٍ مِنْهُمْ غَيْرَ أَنَّهُ يُعَدُّ فَأَكَلُوا أَجْمَعِينَ  .         [6/229]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ إِلَّا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي بَكْرٍ  .  وَهَذَا  الْإِسْنَادُ  مِنْ أَحْسَنِ  إِسْنَادٍ  يُرْوَى فِي ذَلِكَ عَنْ  عَبْدِ الرَّحْمَنِ  .  سقط من طبعة مكتبة العلوم والحكم والمثبت من نسخة الرباط ، وينظر ترجمته في التهذيبين وغيرهما","","Musnad al-Bazzar 2263","","عبد الرحمن بن أبي بكر الصديق عن أبو عثمان النهدي عن سليمان بن طرخان عن معتمر بن سليمان عن إسحاق بن إبراهيم الشهيدي عن البزار","أبو عثمان النهدي عن عبد الرحمن بن أبي بكر"
"2272","2264  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ :  نَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَلَاثِينَ وَمِائَةَ رَجُلٍ ، فَقَالَ :  هَلْ مَعَ أَحَدٍ مِنْكُمْ طَعَامٌ  ؟ "" قَالَ : فَعُجِنَ ، ثُمَّ جَاءَ  رَجُلٌ  مُشْرِكٌ طَوِيلٌ بِغَنَمٍ فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَبَيْعٌ أَمْ عَطِيَّةٌ ؟ أَمْ قَالَ : هِبَةٌ ؟ "" قَالَ : لَا ، بَلْ بَيْعٌ ، قَالَ : "" فَاشْتَرَى مِنْهَا شَاةً "" ، وَأَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِسَوَادِ  الْبَطْنِ فَأُمْلِخَ ،         [6/230]      وَايْمُ اللهِ مَا مِنَ الثَّلَاثِينَ وَمِائَةٍ إِلَّا وَقَدِ  احْتَزَّ  لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  حُزَّةً  مِنْ سَوَادِ بَطْنِهَا ، إِنْ كَانَ شَاهِدًا أَعْطَاهُ ، وَإِنْ كَانَ غَائِبًا خَبَأَ لَهُ ، قَالَ : وَجَعَلَ مِنْهَا قَصْعَتَيْنِ فَأَكَلْنَا أَجْمَعُونَ وَشَبِعْنَا وَفَضَلَ فِي الْقَصْعَةِ ، فَحَمَلَهُ عَلَى الْبَعِيرِ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا بِهَذَا  الْإِسْنَادِ  ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  .","","Musnad al-Bazzar 2264","","عبد الرحمن بن أبي بكر الصديق عن أبو عثمان النهدي عن سليمان بن طرخان عن معتمر بن سليمان عن إسحاق ابن راهويه عن البزار","أبو عثمان النهدي عن عبد الرحمن بن أبي بكر"
"2273","2265  -  وَنَاهُ  عَبْدَةُ بْنُ عَبْدِ اللهِ قَالَ :  أَنَا  عَمْرُو بْنُ مُحَمَّدِ بْنِ أَبِي رَزِينٍ قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  شُعْبَةَ  إِلَّا  عَمْرُو بْنُ مُحَمَّدٍ  .","","Musnad al-Bazzar 2265","","عبد الرحمن بن أبي بكر الصديق عن أبو عثمان النهدي عن سليمان بن طرخان عن شعبة بن الحجاج عن عمرو بن محمد بن أبي رزين الخزاعي عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","أبو عثمان النهدي عن عبد الرحمن بن أبي بكر"
"2274","[6/231]      عَمْرُو بْنُ أَوْسٍ  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  2266  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَمْرِو بْنِ أَوْسٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ رَضِيَ اللهُ عَنْهُ ، ""  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَهُ أَنْ يُعْمِرَ  عَائِشَةَ  مِنَ  التَّنْعِيمِ  .  وَلَا نَعْلَمُ رَوَى  عَمْرُو بْنُ أَوْسٍ  عَنْ  عَبْدِ الرَّحْمَنِ  حَدِيثًا  مُسْنَدًا  إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 2266","","عبد الرحمن بن أبي بكر الصديق عن عمرو بن أوس بن أبي أوس الثقفي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن أبو موسى الزمن عن البزار","عمرو بن أوس عن عبد الرحمن بن أبي بكر"
"2275","[6/232]      عَبْدُ الرَّحْمَنِ بْنُ أَبِي لَيْلَى  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  2267  -  حَدَّثَنَا  بِشْرُ بْنُ آدَمَ قَالَ :  نَا  عَبْدُ اللهِ بْنُ بَكْرٍ قَالَ :  نَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ يَوْمٍ :  مَنْ أَصْبَحَ الْيَوْمَ مِنْكُمْ صَائِمًا  ؟ "" فَقَالَ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ : أَنَا نَوَيْتُ مِنَ الْبَارِحَةِ فَأَصْبَحْتُ صَائِمًا ، فَقَالَ : "" مَنْ  تَصَدَّقَ  الْيَوْمَ بِصَدَقَةٍ ؟ "" فَقَالَ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ : أَنَا ، تَطَرَّقَ مِسْكِينٌ فَدَخَلْتُ فَإِذَا كِسْرَةٌ فِي يَدِ  عَبْدِ الرَّحْمَنِ  فَأَخَذْتُهَا فَأَعْطَيْتُهُ ، فَقَالَ : "" أَيُّكُمُ الْيَوْمَ عَادَ مَرِيضًا ؟ "" فَقَالَ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ : أَنَا ، قِيلَ لِي : إِنَّ  عَبْدَ الرَّحْمَنِ - يَعْنِي ابْنَ عَوْفٍ  - مَرِيضٌ فَذَهَبْتُ فَعُدْتُهُ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا اجْتَمَعَتْ فِي رَجُلٍ هَذِهِ الْخِصَالُ فِي يَوْمٍ إِلَّا دَخَلَ الْجَنَّةَ  .         [6/233]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ، وَإِنَّمَا يَرْوِيهِ غَيْرُ  عَبْدِ اللهِ بْنِ بَكْرٍ  ، عَنْ  مُبَارَكٍ  ، عَنْ  ثَابِتٍ  ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى  مُرْسَلًا  ، وَلَمْ نَسْمَعْهُ  مُتَّصِلًا  إِلَّا مِنْ  بِشْرِ بْنِ آدَمَ  ، عَنْ  عَبْدِ اللهِ بْنِ بَكْرٍ  .","","Musnad al-Bazzar 2267","","عبد الرحمن بن أبي بكر الصديق عن عبد الرحمن بن أبي ليلى عن ثابت البناني عن مبارك بن فضالة عن عبد الله بن بكر بن حبيب عن بشر بن آدم بن يزيد عن البزار","عبد الرحمن بن أبي ليلى عن عبد الرحمن بن أبي بكر"
"2276","[6/234]      مَيْمُونُ بْنُ مِهْرَانَ  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  2268  -  حَدَّثَنَا  بِشْرُ بْنُ آدَمَ قَالَ :  نَا  عَبْدُ اللهِ بْنُ بَكْرٍ السَّهْمِيُّ قَالَ :  نَا  هِشَامُ بْنُ حَسَّانَ ،  عَنِ  الْقَاسِمِ بْنِ مِهْرَانَ ،  عَنْ  مُوسَى بْنِ عُبَيْدٍ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  إِنَّ رَبِّي تَبَارَكَ وَتَعَالَى أَعْطَانِي سَبْعِينَ أَلْفًا مِنْ أُمَّتِي يَدْخُلُونَ الْجَنَّةَ بِغَيْرِ حِسَابٍ  ، فَقَالَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ : فَهَلَّا اسْتَزَدْتَهُ ؟ قَالَ : قَدِ اسْتَزَدْتُهُ ، فَأَعْطَانِي مَعَ كُلٍّ - يَعْنِي أَلْفًا - سَبْعِينَ أَلْفًا ، فَقَالَ : فَهَلَّا اسْتَزَدْتَهُ ؟ قَالَ : "" قَدِ اسْتَزَدْتُهُ فَأَعْطَانِي مَعَ كُلِّ رَجُلٍ سَبْعِينَ أَلْفًا "" فَقَالَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ : فَهَلَّا اسْتَزَدْتَهُ ، فَقَالَ : "" أَعْطَانِي هَكَذَا "" وَبَسَطَ بَاعَهُ ، فَقَالَ : "" هَذَا مِنَ اللهِ تَبَارَكَ وَتَعَالَى لَا يُدْرَى مَا عَدَدُهُ  .         [6/235]      وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2268","","عبد الرحمن بن أبي بكر الصديق عن ميمون بن مهران الرقي عن موسى بن عبيد عن القاسم بن مهران عن هشام بن حسان العتكي عن عبد الله بن بكر بن حبيب عن بشر بن آدم بن يزيد عن البزار","ميمون بن مهران عن عبد الرحمن بن أبي بكر"
"2277","[6/236]      حَفْصَةُ بِنْتُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  عَنْ أَبِيهَا  2269  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورٍ قَالَ :  نَا  ابْنُ أَبِي مَرْيَمَ ، وَدَاوُدُ بْنُ مِهْرَانَ ، وَاللَّفْظُ  لِابْنِ أَبِي مَرْيَمَ  قَالَا :  أَنَا  دَاوُدُ وَهُوَ ابْنُ عَبْدِ الرَّحْمَنِ الْعَطَّارُ قَالَ :  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عُثْمَانَ يَعْنِي ابْنَ خُثَيْمٍ ،  عَنْ  يُوسُفَ بْنِ مَاهَكَ ،  عَنْ  حَفْصَةَ بِنْتِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهَا  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِعَبْدِ الرَّحْمَنِ  :  أَرْدِفْ أُخْتَكَ فَأَعْمِرْهَا مِنَ  التَّنْعِيمِ  فَإِذَا أُهْبِطَتْ مِنَ الْأَكَمَةِ فَمُرْهَا فَلْتُحْرِمْ فَإِنَّهَا عُمْرَةٌ مُتَقَبَّلَةٌ  .         [6/237]","","Musnad al-Bazzar 2269","","عبد الرحمن بن أبي بكر الصديق عن حفصة بنت عبد الرحمن بن أبي بكر الصديق عن يوسف بن ماهك الفارسي عن عبد الله بن عثمان بن خثيم عن داود ابن النصراني عن داود بن مهران الدباغ عن أحمد بن منصور الرمادي عن البزار","حفصة بنت عبد الرحمن بن أبي بكر عن أبيها"
"2278","2270  -  وَنَاهُ  يُوسُفُ بْنُ مُوسَى قَالَ :  نَا  أَبُو إِسْحَاقَ الطَّالْقَانِيُّ ، قَالَ أَبُو بَكْرٍ - وَاسْمُهُ  إِبْرَاهِيمُ بْنُ عِيسَى  - قَالَ :  نَا  دَاوُدُ بْنُ عَبْدِ الرَّحْمَنِ الْعَطَّارُ ،  عَنِ  ابْنِ خُثَيْمٍ ،  عَنْ  يُوسُفَ بْنِ مَاهَكَ ،  عَنْ  حَفْصَةَ بِنْتِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهَا  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَ نَحْوَهُ .  وَلَا نَعْلَمُ رَوَتْ  حَفْصَةُ  عَنْ أَبِيهَا إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 2270","","عبد الرحمن بن أبي بكر الصديق عن حفصة بنت عبد الرحمن بن أبي بكر الصديق عن يوسف بن ماهك الفارسي عن عبد الله بن عثمان بن خثيم عن داود ابن النصراني عن إبراهيم بن إسحاق الطالقاني عن يوسف بن موسى بن راشد عن البزار","حفصة بنت عبد الرحمن بن أبي بكر عن أبيها"
"2279","[6/238]      أَبُو ثَوْرٍ  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  2271  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورِ بْنِ سَيَّارٍ قَالَ :  نَا  عَمْرُو بْنُ خَالِدٍ قَالَ :  نَا  ابْنُ لَهِيعَةَ ،  أَحْسِبُهُ  عَنْ  بُكَيْرٍ  ،  عَنْ  بَكْرِ بْنِ سَوَادَةَ ،  عَنْ  أَبِي ثَوْرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  لَا تَحِلُّ الصَّدَقَةُ لِغَنِيٍّ  ، وَلَا لِذِي  مِرَّةٍ  سَوِيٍّ أَوْ قَوِيٍّ  .  وَهَذَا الْحَدِيثُ عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  قَدْ رُوِيَ مِنْ هَذَا الْوَجْهِ وَمِنْ وَجْهٍ آخَرَ  .","","Musnad al-Bazzar 2271","","عبد الرحمن بن أبي بكر الصديق عن أبو ثور الفهمي عن بكر بن سوادة عن بكير بن عبد الله بن الأشج القرشي عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن أحمد بن منصور الرمادي عن البزار","أبو ثور عن عبد الرحمن بن أبي بكر"
"2280","[6/239]      قَاضِي الْمِصْرَيْنِ عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  وَأَحْسَبُهُ  شُرَيْحَ ... بْنَ قَيْسٍ  2272  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ زِيَادٍ الصَّائِغُ ، وَأَحْمَدُ بْنُ مَنْصُورٍ قَالَا :  نَا  يَزِيدُ بْنُ هَارُونَ قَالَ :  أَنَا  صَدَقَةُ بْنُ مُوسَى ،  عَنْ  أَبِي عِمْرَانَ الْجَوْنِيِّ ،  عَنْ  قَيْسِ بْنِ زَيْدٍ قَالَ :  حَدَّثَنِي  قَاضِي الْمِصْرَيْنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  إِنَّ اللهَ تَبَارَكَ وَتَعَالَى يَدْعُو بِصَاحِبِ الدَّيْنِ يَوْمَ الْقِيَامَةِ فَيُقِيمُهُ بَيْنَ يَدَيْهِ  ، فَيَقُولُ تَبَارَكَ وَتَعَالَى : أَيْ عَبْدُ فِيمَا أَذْهَبْتَ مَالَ النَّاسِ ؟ فَيَقُولُ : أَيْ رَبِّ قَدْ عَلِمْتَ أَنِّي لَمْ أُفْسِدْهُ إِنَّمَا ذَهَبَ فِي  غَرَقٍ  أَوْ  حَرَقٍ  أَوْ  سَرَقٍ  ، فَيَدْعُو اللهَ تَبَارَكَ وَتَعَالَى بِشَيْءٍ فَيَضَعُهُ فِي مِيزَانِهِ فَتَرْجَحُ حَسَنَاتُهُ  .         [6/240]      وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى إِلَّا عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2272","","عبد الرحمن بن أبي بكر الصديق عن شريح بن الحارث الكندي عن قيس بن زيد البصري عن عبد الملك بن حبيب الجوني عن صدقة بن موسى الدقيقي عن يزيد بن هارون عن أحمد بن منصور الرمادي عن البزار","قاضي المصرين عن عبد الرحمن بن أبي بكر"
"2281","[6/241]      عَبْدُ اللهِ الْبَهِيُّ مَوْلَى ابْنِ الزُّبَيْرِ  عَنْ  عَبْدِ الرَّحْمَنِ  2273  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ قَالَ :  نَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  عَبْدِ اللهِ الْبَهِيِّ ، مَوْلَى الزُّبَيْرِ قَالَ :  كُنْتُ فِي الْمَسْجِدِ  وَمَرْوَانُ  يَخْطُبُ ،  فَقَالَ  عَبْدُ الرَّحْمَنِ بْنُ أَبِي بَكْرٍ : وَاللهِ مَا اسْتَخْلَفَ أَحَدًا مِنْ أَهْلِهِ ، فَقَالَ  مَرْوَانُ  : أَنْتَ الَّذِي نَزَلَتْ فِيكَ :         {      وَالَّذِي قَالَ لِوَالِدَيْهِ أُفٍّ لَكُمَا         }      ؛ فَقَالَ  عَبْدُ الرَّحْمَنِ  :  كَذَبْتَ ، وَلَكِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَعَنَ أَبَاكَ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مِنْ هَذَا الْوَجْهِ  .  آخِرُ  مُسْنَدِ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  ، وَهُوَ آخِرُ الْحَادِي وَالْعِشْرِينَ ، وَالْحَمْدُ لِلهِ كَثِيرًا .         [6/242]","","Musnad al-Bazzar 2273","","عبد الرحمن بن أبي بكر الصديق عن عبد الله البهي مولى مصعب بن الزبير عن إسماعيل بن أبي خالد عن عبد الرحمن بن مغراء الدوسي عن يوسف بن موسى بن راشد عن البزار","عبد الله البهي مولى ابن الزبير عن عبد الرحمن"
"2282","[6/243]      مُسْنَدُ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ  رَضِيَ اللهُ عَنْهُ         [6/244]             [6/245]      مُسْنَدُ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ  2274  -  حَدَّثَنَا  أَبُو الْحَسَنِ مُحَمَّدُ بْنُ أَيُّوبَ قَالَ :  حَدَّثَنِي  أَبُو بَكْرٍ أَحْمَدُ بْنُ عَمْرِو بْنِ عَبْدِ الْخَالِقِ الْبَزَّارُ قَالَ :  نَا  نَصْرُ بْنُ عَلِيٍّ قَالَ :  أَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ قَالَ :  نَا  أَبِي  قَالَ :  سَمِعْتُ  الْحَسَنَ  يُحَدِّثُ عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2274","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن سليمان بن طرخان عن معتمر بن سليمان عن نصر بن علي بن نصر الجهضمي عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2283","2275  -  وَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  الْحَسَنُ بْنُ عَبْدِ الرَّحْمَنِ يَعْنِي ابْنَ الْعُرْيَانِ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنِ  الْحَسَنِ  قَالَ  : قَالَ عَبْدُ الرَّحْمَنِ بْنُ سَمُرَةَ : عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .         [6/246]","","Musnad al-Bazzar 2275","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن عبد الله بن عون بن أرطبان عن الحسن بن عبد الرحمن بن العريان الحارثي عن أبو موسى الزمن عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2284","2276  -  وَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  عَبْدُ الْأَعْلَى بْنُ عَبْدِ الْأَعْلَى ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2276","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن هشام بن حسان العتكي عن عبد الأعلى بن عبد الأعلى القرشي عن أبو موسى الزمن عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2285","2277  -  وَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  نَا  جَرِيرٌ - يَعْنِي ابْنَ عَبْدِ الْحَمِيدِ - ،  عَنْ  مَنْصُورِ بْنِ الْمُعْتَمِرِ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .         [6/247]","","Musnad al-Bazzar 2277","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن منصور بن المعتمر عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2286","2278  -  وَنَا  عَلِيُّ بْنُ مُسْلِمٍ الطُّوسِيُّ قَالَ :  نَا  هُشَيْمٌ قَالَ :  أَنَا  يُونُسُ بْنُ عُبَيْدٍ ، وَمَنْصُورُ بْنُ زَاذَانَ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .         [6/248]","","Musnad al-Bazzar 2278","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن علي بن مسلم الطوسي عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2287","2279  -  وَنَا  تَمِيمُ بْنُ الْمُنْتَصِرِ الْوَاسِطِيُّ ،  نَا  إِسْحَاقُ بْنُ يُوسُفَ ، قَالَ :  نَا  شَرِيكٌ  عَنْ  سِمَاكٍ ، يَعْنِي ابْنَ حَرْبٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2279","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن إسحاق بن يوسف الأزرق عن تميم بن المنتصر مولى ابن عباس عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2288","2280  -  وَنَا  أَبُو كَامِلٍ قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ وَسِمَاكِ بْنِ عَطِيَّةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2280","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن سماك بن عطية المربدي عن حماد بن زيد عن فضيل بن حسين الجحدري عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2289","2281  -  وَنَا  الْحَسَنُ بْنُ يَحْيَى قَالَ :  نَا  الْمِنْهَالُ  قَالَ :  نَا  حَمَّادٌ ،  عَنْ  حُمَيْدٍ وَحَبِيبٍ ، يَعْنِي ابْنَ الشَّهِيدِ ، وَثَابِتٍ الْبُنَانِيِّ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .         [6/249]      كذا في طبعة مكتبة العلوم والحكم في هذا الموضع وفي نسخة الرباط كذلك ، وقال المحقق أنه ( المنهال بن بحر ) ، والذي أراه أنه ( حجاج بن المنهال ) فقد روى الحسن بن يحيى عنه في غير ما موضع من الكتاب عن حماد بن سلمة ، فالله أعلم بالصواب.","","Musnad al-Bazzar 2281","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن ثابت البناني عن حماد بن زيد عن حجاج بن المنهال الأنماطي عن الحسن بن يحيى الرزي عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2290","2282  -  وَنَاهُ  إِبْرَاهِيمُ بْنُ بِسْطَامٍ الزَّعْفَرَانِيُّ قَالَ :  نَا  أَبُو عَاصِمٍ قَالَ :  نَا  سَهْلٌ السَّرَّاجُ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2282","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن سهل بن أبي الصلت العبسي عن أبو عاصم النبيل عن إبراهيم بن بسطام الزعفراني عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2291","2283  -  وَنَا  يَحْيَى بْنُ خَلَفٍ أَبُو سَلَمَةَ قَالَ :  نَا  عَبْدُ الْأَعْلَى ،  عَنْ  سَعِيدٍ - يَعْنِي ابْنَ أَبِي عَرُوبَةَ - ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2283","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الأعلى بن عبد الأعلى القرشي عن يحيى بن خلف الجوباري عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2292","2284  -  وَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ ابْنُ أَخِي وَكِيعِ بْنِ الْجَرَّاحِ قَالَ :  نَا  مُحَمَّدُ بْنُ بَشِيرٍ قَالَ :  نَا  مِسْعَرٌ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .         [6/250]","","Musnad al-Bazzar 2284","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن علي بن زيد بن جدعان عن مسعر بن كدام عن محمد بن بشر بن الفرافصة عن جعفر بن محمد ابن أخي وكيع بن الجراح عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2293","2285  -  وَنَا  أَبُو بُجَيْرٍ مُحَمَّدُ بْنُ جَابِرِ بْنِ بُجَيْرٍ قَالَ :  نَا  أَبُو أُسَامَةَ قَالَ :  نَا  عَوْفٌ ، وَإِسْمَاعِيلُ بْنُ مُسْلِمٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2285","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن إسماعيل بن مسلم الكيشي عن حماد بن أسامة القرشي عن محمد بن جابر بن بجير المحاربي عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2294","2286  -  وَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ قَالَ :  نَا  بَكْرُ بْنُ بَكَّارٍ قَالَ :  نَا  أَبُو حُرَّةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2286","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن واصل بن عبد الرحمن البصري عن بكر بن بكار القيسي عن محمد بن عبد الملك بن زنجويه الغزال عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2295","2287  -  وَنَا  مُحَمَّدُ بْنُ الْمُؤَمَّلِ الْهَدَادِيُّ قَالَ :  نَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ قَالَ :         [6/251]      نَا  قُرَّةُ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2287","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن قرة بن خالد السدوسي عن مسلم بن إبراهيم الشحام عن محمد بن المؤمل الهدادي عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2296","2288  -  وَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  وَهْبُ بْنُ جَرِيرٍ قَالَ :  حَدَّثَنِي  أَبِي ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2288","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن جرير بن حازم عن وهب بن جرير بن حازم عن أبو موسى الزمن عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2297","2289  -  وَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  نَا  حَجَّاجُ بْنُ الْمِنْهَالِ قَالَ :  نَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .         [6/252]","","Musnad al-Bazzar 2289","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن مبارك بن فضالة عن حجاج بن المنهال الأنماطي عن أبو موسى الزمن عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2298","2290  -  وَنَا  أَحْمَدُ بْنُ سِنَانٍ قَالَ :  نَا  يَزِيدُ بْنُ هَارُونَ قَالَ :  أَنَا  زِيَادٌ الْجَصَّاصُ - وَهُوَ زِيَادُ بْنُ أَبِي زِيَادٍ - ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2290","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن زياد بن أبي زياد الجصاص عن يزيد بن هارون عن أحمد بن سنان القطان عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2299","2291  -  وَنَا  مَعْمَرُ بْنُ سَهْلٍ قَالَ :  نَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ الْكُوفِيُّ قَالَ :  نَا  يَزِيدُ بْنُ إِبْرَاهِيمَ التُّسْتَرِيُّ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2291","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن يزيد بن إبراهيم التستري عن محمد بن إسماعيل بن رجاء الزبيدي عن معمر بن سهل بن معمر الأهوازي عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2300","2292  -  وَنَا  عَلِيُّ بْنُ قُرَّةَ بْنِ حَبِيبٍ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنِ  السَّرِيِّ بْنِ يَحْيَى ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَلْفَاظُهُمْ مُتَقَارِبَةٌ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لَهُ : ""  يَا  عَبْدَ الرَّحْمَنِ  لَا تَسْأَلِ الْإِمَارَةَ  ، فَإِنَّكَ إِنْ أُوتِيتَهَا عَنْ مَسْأَلَةٍ وُكِلْتَ إِلَيْهَا ، وَإِنْ أُوتِيتَهَا مِنْ غَيْرِ مَسْأَلَةٍ أُعِنْتَ عَلَيْهَا ، وَإِذَا حَلَفْتَ عَلَى يَمِينٍ فَرَأَيْتَ غَيْرَهَا خَيْرًا مِنْهَا فَائْتِ الَّذِي هُوَ خَيْرٌ ، وَكَفِّرْ عَنْ يَمِينِكَ  .  قَالَ أَبُو بَكْرٍ :  وَقَدْ رَوَاهُ غَيْرُ مَنْ  سَمَّيْنَا  عَنِ  الْحَسَنِ  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ  .         [6/253]      فَأَمَّا حَدِيثُ  التَّيْمِيِّ  ، عَنِ  الْحَسَنِ  ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ  فَلَا نَعْلَمُ رَوَاهُ إِلَّا  الْمُعْتَمِرُ  عَنْ أَبِيهِ .  وَأَمَّا حَدِيثُ  ابْنِ عَوْنٍ  فَوَصَلَهُ  الْحَسَنُ بْنُ عَبْدِ الرَّحْمَنِ  .  وَرَوَاهُ  ابْنُ أَبِي عَدِيٍّ  ، عَنِ  ابْنِ عَوْنٍ  ، عَنِ  الْحَسَنِ  :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِعَبْدِ الرَّحْمَنِ  .  وَأَمَّا حَدِيثُ  هِشَامٍ  فَرَوَاهُ جَمَاعَةٌ ، عَنْ  هِشَامٍ  ، عَنِ  الْحَسَنِ  .  وَأَمَّا حَدِيثُ  مَنْصُورِ بْنِ الْمُعْتَمِرِ  ، عَنِ  الْحَسَنِ  فَإِنَّ  مَنْصُورَ بْنَ الْمُعْتَمِرِ  لَمْ يُسْنِدْ عَنِ  الْحَسَنِ  غَيْرَ هَذَا الْحَدِيثِ .  وَأَمَّا حَدِيثُ  مَنْصُورِ بْنِ زَاذَانَ  فَمَا رَوَاهُ عَنْهُ إِلَّا  هُشَيْمٌ  .  وَأَمَّا حَدِيثُ  يُونُسَ  ، عَنِ  الْحَسَنِ  فَقَدْ رَوَاهُ غَيْرُ وَاحِدٍ ، عَنْ  يُونُسَ  ، فَاقْتَصَرْنَا عَلَى  هُشَيْمٍ  .         [6/254]      وَأَمَّا حَدِيثُ  حُمَيْدٍ  وَثَابِتٍ  وَحَبِيبٍ  عَنِ  الْحَسَنِ  فَلَمْ يَرْوِهِ إِلَّا  حَمَّادُ بْنُ سَلَمَةَ  .  وَأَمَّا حَدِيثُ  سِمَاكٍ  ، عَنِ  الْحَسَنِ  ، فَلَمْ يَرْوِهِ إِلَّا  شَرِيكٌ  ، عَنْ  سِمَاكٍ  .  وَأَمَّا حَدِيثُ  سِمَاكِ بْنِ عَطِيَّةَ  ، فَلَا نَعْلَمُ رَوَاهُ إِلَّا  حَمَّادُ بْنُ زَيْدٍ  .  وَلَا  أَسْنَدَ  سِمَاكُ بْنُ عَطِيَّةَ  عَنِ  الْحَسَنِ  إِلَّا هَذَا الْحَدِيثَ .  وَأَمَّا حَدِيثُ  سَهْلٍ السَّرَّاجِ  عَنِ  الْحَسَنِ ،  فَإِنَّ  سَهْلَ السَّرَّاجَ  ، لَمْ  يُسْنِدْ  عَنِ  الْحَسَنِ  غَيْرَ هَذَا الْحَدِيثِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  سَهْلٍ  إِلَّا  أَبُو عَاصِمٍ  .  وَأَمَّا حَدِيثُ  عَلِيِّ بْنِ زَيْدٍ  ، عَنِ  الْحَسَنِ  فَرَوَاهُ عَنْ  عَلِيِّ بْنِ زَيْدٍ  مِسْعَرٌ  وَزُهَيْرُ بْنُ مُعَاوِيَةَ  ، فَذَكَرْنَاهُ عَنْ  مِسْعَرٍ  وَاقْتَصَرْنَا ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  مِسْعَرٍ  ، عَنْ  عَلِيِّ بْنِ زَيْدٍ  إِلَّا  مُحَمَّدُ بْنُ بِشْرٍ  ،  وَأَبُو دَاوُدَ الْحَفَرِيُّ  .  وَأَمَّا حَدِيثُ  قَتَادَةَ  عَنِ  الْحَسَنِ  ، فَإِنَّمَا يُحْفَظُ مِنْ حَدِيثِ  سَعِيدٍ  ، عَنْ  قَتَادَةَ  .  وَأَمَّا حَدِيثُ  قُرَّةَ  عَنِ  الْحَسَنِ  ، فَلَا نَعْلَمُ أَحَدًا رَوَاهُ إِلَّا  مُسْلِمٌ  عَنْ  قُرَّةَ  .  وَأَمَّا حَدِيثُ  عَوْفٍ  وَإِسْمَاعِيلَ بْنِ مُسْلِمٍ  ، فَإِنَّمَا يُحْفَظُ ذَلِكَ مِنْ حَدِيثِ  أَبِي أُسَامَةَ  .         [6/255]      وَأَمَّا حَدِيثُ  السَّرِيِّ بْنِ يَحْيَى  ، فَلَا نَحْفَظُهُ إِلَّا مِنْ حَدِيثِ  قُرَّةَ بْنِ حَبِيبٍ  .  وَأَمَّا حَدِيثُ  يَزِيدَ بْنِ إِبْرَاهِيمَ التُّسْتَرِيِّ  ، فَلَا نَحْفَظُهُ إِلَّا مِنْ حَدِيثِ  مُحَمَّدِ بْنِ إِسْمَاعِيلَ الْكُوفِيِّ  عَنْ  يَزِيدَ بْنِ إِبْرَاهِيمَ  .  وَأَمَّا حَدِيثُ  زِيَادٍ الْجَصَّاصِ  عَنِ  الْحَسَنِ  ، فَلَا نَحْفَظُهُ إِلَّا مِنْ حَدِيثِ  يَزِيدَ بْنِ هَارُونَ  عَنْ  زِيَادٍ  .  وَأَمَّا حَدِيثُ  جَرِيرِ بْنِ حَازِمٍ  ، فَإِنَّمَا نَحْفَظُهُ مِنْ حَدِيثِ  وَهْبٍ  ، عَنْ أَبِيهِ ، وَحَدِيثُ  مُبَارَكٍ  عَنِ  الْحَسَنِ  قَدْ رَوَاهُ غَيْرُ وَاحِدٍ عَنِ  الْمُبَارَكِ  .","","Musnad al-Bazzar 2292","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن السري بن يحيى الشيباني عن قرة بن حبيب القنوي عن علي بن قرة بن حبيب عن البزار","مسند عبد الرحمن بن سمرة رضي الله عنه"
"2301","[6/256]             [6/257]      مُسْنَدُ  عَبْدِ اللهِ بْنِ الشِّخِّيرِ  رَضِيَ اللهُ عَنْهُ         [6/258]             [6/259]      عَبْدُ اللهِ بْنُ الشِّخِّيرِ  2293  -  حَدَّثَنَا  أَبُو كُرَيْبٍ قَالَ :  نَا  زَيْدُ بْنُ الْحُبَابِ قَالَ :  نَا  شَدَّادُ بْنُ سَعِيدٍ ،  عَنْ  غَيْلَانَ بْنِ جَرِيرٍ ،  عَنْ  مُطَرِّفِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  قَالَ : ""  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي قَائِمًا وَقَاعِدًا  "" .","","Musnad al-Bazzar 2293","","عبد الله بن الشخير الحرشي عن مطرف بن عبد الله بن الشخير الحرشي عن غيلان بن جرير المعولي عن شداد بن سعيد الراسبي عن زيد بن الحباب العكلي عن أبو كريب محمد بن العلاء عن البزار","عبد الله بن الشخير"
"2302","2294  -  وَنَا  أَبُو بُرَيْدٍ عَمْرُو بْنُ يَزِيدَ الْجَرْمِيُّ قَالَ :  نَا  الْحَسَنُ بْنُ الْحَكَمِ بْنِ طَهْمَانَ قَالَ :  نَا  سَيَّارٌ أَبُو الْحَكَمِ قَالَ :  سَمِعْتُ         [6/260]      مُطَرِّفَ بْنَ عَبْدِ اللهِ بْنِ الشِّخِّيرِ  يُحَدِّثُ عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَدْعُو يَقُولُ : "" اللَّهُمَّ مَتِّعْنِي بِسَمْعِي وَبَصَرِي وَاجْعَلْهُ الْوَارِثَ مِنِّي  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ بْنِ الشِّخِّيرِ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2294","","عبد الله بن الشخير الحرشي عن مطرف بن عبد الله بن الشخير الحرشي عن سيار بن أبي سيار العنزي عن الحسن بن الحكم بن طهمان الدباغ عن عمرو بن يزيد الجرمي عن البزار","عبد الله بن الشخير"
"2303","2295  -  وَنَا  أَحْمَدُ بْنُ عَبْدَةَ قَالَ :  أَنَا  يَزِيدُ بْنُ زُرَيْعٍ قَالَ :  نَا  الْجُرَيْرِيُّ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ الشِّخِّيرِ ،  عَنْ  أَبِيهِ  قَالَ : ""  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى فِي نَعْلَيْهِ ، ثُمَّ بَزَقَ  ، ثُمَّ دَلَكَهَا بِنَعْلِهِ  .         [6/261]      وَهَذَا الْحَدِيثُ هَكَذَا رَوَاهُ  يَزِيدُ  ، عَنِ  الْجُرَيْرِيِّ  ، وَرَوَاهُ جَمَاعَةٌ عَنِ  الْجُرَيْرِيِّ  ، عَنْ  يَزِيدَ  ، عَنْ  مُطَرِّفٍ  ، عَنْ أَبِيهِ  .","","Musnad al-Bazzar 2295","","عبد الله بن الشخير الحرشي عن يزيد بن عبد الله بن الشخير العامري عن سعيد بن إياس الجريري عن يزيد بن زريع العيشي عن أحمد بن عبدة الضبي عن البزار","عبد الله بن الشخير"
"2304","[6/262]             [6/263]      مُسْنَدُ  أَبِي أُسَيْدٍ  رَضِيَ اللهُ عَنْهُ         [6/264]             [6/265]      مِنْ حَدِيثِ  أَبِي أُسَيْدٍ  2296  -  حَدَّثَنَا  عَمْرُو بْنُ مَالِكٍ قَالَ :  نَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنْ  عِرَاكِ بْنِ مَالِكٍ .  2297  -  وَنَا  عَمْرٌو قَالَ :  نَا  مُحَمَّدُ بْنُ عُمَرَ الْوَاقِدِيُّ قَالَ :  حَدَّثَنِي  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنِ  الزُّبَيْرِ بْنِ الْمُنْذِرِ بْنِ أَبِي أُسَيْدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  لَمَّا قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَكَّةَ  جَاءَهُ  أَبُو مَحْذُورَةَ  ،  فَقَالَ : يَا رَسُولَ اللهِ ، ائْذَنْ لِي أَنْ أُؤَذِّنَ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَذِّنْ "" فَكَانَ يُؤَذِّنُ  بِلَالٌ  ، فَلَمَّا رَجَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَخَلَّفَ  أَبُو مَحْذُورَةَ  .         [6/266]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ بِهَذَا اللَّفْظِ غَيْرَ  أَبِي أُسَيْدٍ  ، وَلَا نَعْلَمُ أَحَدًا وَصَلَهُ غَيْرَ  الْوَاقِدِيِّ  ، وَقَدْ رَوَى النَّاسُ عَنِ الْوَاقِدِيِّ  وَتَكَلَّمُوا فِيهِ  ، وَلَمْ يُثْبِتُوا عَلَيْهِ حُجَّةً إِلَّا ظَنًّا ، وَفِي حَدِيثِهِ  نُكْرَةٌ  .","","Musnad al-Bazzar 2296","","مالك بن ربيعة أبو أسيد الساعدي عن المنذر بن أبي أسيد الساعدي عن الزبير بن المنذر الساعدي عن خالد بن عبد الله الطحان عن الواقدي عن عمرو بن مالك بن عمر الراسبي عن البزار","من حديث أبي أسيد"
"2305","2298  -  حَدَّثَنَا  عَمْرٌو قَالَ :  نَا  الْوَاقِدِيُّ قَالَ :  نَا  أُبَيُّ بْنُ عَبَّاسِ بْنِ سَهْلِ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ  قَالَ :  سَمِعْتُ  أَبَا أُسَيْدٍ يَقُولُ :  غَزَوْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِشْرِينَ غَزْوَةً  ، غَزْوَةً بَعْدَ غَزْوَةٍ  "" .  وَهَذِهِ الْحِكَايَةُ لَا نَعْلَمُهَا تُرْوَى إِلَّا عَنْ  أَبِي أُسَيْدٍ  ، وَلَا نَعْلَمُ  لِأَبِي أُسَيْدٍ  طَرِيقًا غَيْرَ هَذَا الطَّرِيقِ ، وَقَدْ تَقَدَّمَ ذِكْرُنَا  لِلْوَاقِدِيِّ  .","","Musnad al-Bazzar 2298","","مالك بن ربيعة أبو أسيد الساعدي عن عباس بن سهل بن سعد الساعدي عن أبي بن العباس الساعدي عن الواقدي عن عمرو بن مالك بن عمر الراسبي عن البزار","من حديث أبي أسيد"
"2306","2299  -  حَدَّثَنَا  خَالِدُ بْنُ يُوسُفَ قَالَ :  نَا  أَبِي  ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  أَنَّهُ سَمِعَ  أَبَا أُسَيْدٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  خَيْرُ  الْأَنْصَارِ  بَنُو النَّجَّارِ  "" .","","Musnad al-Bazzar 2299","","مالك بن ربيعة أبو أسيد الساعدي عن أبو سلمة بن عبد الرحمن عن موسى بن عقبة عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","من حديث أبي أسيد"
"2307","[6/267]             [6/268]             [6/269]      مُسْنَدُ  أَبِي الْيَسَرِ  رَضِيَ اللهُ عَنْهُ         [6/270]             [6/271]      بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ  صَلَّى اللهُ عَلَى  مُحَمَّدٍ  رَسُولِهِ الْكَرِيمِ  وَعَلَى آلِهِ وَسَلَّمَ تَسْلِيمًا كَثِيرًا كَثِيرًا .  مِنْ حَدِيثِ  أَبِي الْيَسَرِ  2300  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ قَالَ :  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ عُثْمَانَ بْنِ جَبَلَةَ قَالَ :  أَخْبَرَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  شَرِيكٍ ،  عَنْ  عُثْمَانَ بْنِ مَوْهَبٍ ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  أَبِي الْيَسَرِ قَالَ :  لَقِيتُ  امْرَأَةً  فَالْتَزَمْتُهَا غَيْرَ أَنِّي لَمْ أَنْكِحْهَا ، فَأَتَيْتُ  عُمَرَ  فَسَأَلْتُهُ فَقَالَ :  اتَّقِ اللهَ وَاسْتُرْ عَلَى نَفْسِكَ وَلَا تُخْبِرَنَّ أَحَدًا  قَالَ : فَلَمْ أَصْبِرْ حَتَّى أَتَيْتُ  أَبَا بَكْرٍ  فَسَأَلْتُهُ ، فَقَالَ : اتَّقِ اللهَ وَاسْتُرْ عَلَى نَفْسِكَ وَلَا تُخْبِرَنَّ أَحَدًا ، فَلَمْ أَصْبِرْ حَتَّى أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرْتُهُ فَقَالَ :  هَلْ  جَهَّزْتَ  غَازِيًا  ؟ "" قُلْتُ : لَا ، قَالَ : ""  فَخَلَفْتَ  غَازِيًا فِي أَهْلِهِ ؟ "" قُلْتُ : لَا ، فَقَالَ لِي حَتَّى تَمَنَّيْتُ أَنِّي كُنْتُ دَخَلْتُ فِي الْإِسْلَامِ تِلْكَ السَّاعَةَ ، فَلَمَّا وَلَّيْتُ دَعَانِي فَقَرَأَ عَلَيَّ :         {      وَأَقِمِ  الصَّلاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ         }      ، فَقَالَ أَصْحَابُهُ : أَلِهَذَا خَاصَّةً أَمْ لِلنَّاسِ عَامَّةً قَالَ : "" بَلْ لِلنَّاسِ عَامَّةً  .         [6/272]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  أَبِي الْيَسَرِ  ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  أَبِي الْيَسَرِ  إِلَّا  مُوسَى بْنُ طَلْحَةَ  ، وَلَا عَنْ  مُوسَى  إِلَّا  عُثْمَانُ بْنُ عَبْدِ اللهِ بْنِ مَوْهَبٍ  ، وَرَوَاهُ عَنْ  عُثْمَانَ  شَرِيكٌ  وَقَيْسٌ  ، فَذَكَرْنَا حَدِيثَ  شَرِيكٍ  ؛ لِأَنَّهُ كَانَ أَجَلَّ مِنْ  قَيْسٍ  ، وَاقْتَصَرْنَا عَلَيْهِ .  وَلَا نَعْلَمُ هَذَا الْكَلَامَ يُرْوَى إِلَّا عَنْهُ ، وَقَدْ رُوِيَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوٍ مِنْهُ بِخِلَافِ اللَّفْظِ ، نَذْكُرُهُ فِي مَوْضِعِهِ إِنْ شَاءَ اللهُ .  في طبعة مكتبة العلوم والحكم ( أقم ) بدون الواو .","","Musnad al-Bazzar 2300","","كعب بن عمرو بن عباد البدري عن موسى بن طلحة بن عبيد الله التيمي عن عثمان بن عبد الله بن موهب الأعرج عن شريك بن عبد الله النخعي عن عبد الله بن المبارك عن عبد الله بن عثمان بن جبلة عن البخاري عن البزار","من حديث أبي اليسر"
"2308","2301  -  حَدَّثَنَا  عَمْرٌو قَالَ :  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنْ  عِرَاكِ بْنِ مَالِكٍ ،  عَنْ  أَبِي الْيَسَرِ رَضِيَ اللهُ عَنْهُ ، ""  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنْ يُنْبَذَ التَّمْرُ وَالزَّبِيبُ جَمِيعًا  .  وَهَذَا الْحَدِيثُ قَالَ فِيهِ  ابْنُ لَهِيعَةَ  : عَنْ  جَعْفَرٍ  ، عَنْ  عِرَاكٍ  ، عَنْ  أَبِي الْيَسَرِ  ، وَقَالَ غَيْرُ  ابْنِ لَهِيعَةَ  عَنْ  عِرَاكٍ  ، عَنْ  أَبِي هُرَيْرَةَ  ، فَذَكَرْنَا         [6/273]      حَدِيثَ  أَبِي الْيَسَرِ  إِذْ هُوَ أَعَزُّ حَدِيثًا ، وَلَعَلَّ حَدِيثَ  أَبِي هُرَيْرَةَ  فِيهِ زِيَادَةٌ نَذْكُرُهُ فِي مَوْضِعِهِ بِزِيَادَتِهِ إِنْ شَاءَ اللهُ  .","","Musnad al-Bazzar 2301","","كعب بن عمرو بن عباد البدري عن عراك بن مالك الغفاري عن جعفر بن ربيعة الكندي عن عبد الله بن لهيعة عن عبد الله بن وهب المصري عن عمرو بن سواد السرحي عن البزار","من حديث أبي اليسر"
"2309","2302  -  حَدَّثَنَا  عَمْرٌو قَالَ :  أَخْبَرَنَا  فُضَيْلُ بْنُ سُلَيْمَانَ قَالَ :  أَخْبَرَنَا  يَزِيدُ بْنُ عَامِرِ بْنِ أَبِي الْيَسَرِ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي الْيَسَرِ  رَضِيَ اللهُ عَنْهُ ،  أَنَّ  رَجُلًا  قَالَ : يَا رَسُولَ اللهِ ، دُلَّنِي عَلَى عَمَلٍ يُدْخِلُنِي الْجَنَّةَ قَالَ : "" أَمْسِكْ هَذَا ؛ وَأَشَارَ إِلَى لِسَانِهِ "" فَأَعَادَهَا عَلَيْهِ ، فَقَالَ :  ثَكِلَتْكَ  أُمُّكَ ، هَلْ يَكُبُّ النَّاسَ عَلَى مَنَاخِرِهِمْ فِي النَّارِ إِلَّا  حَصَائِدُ  أَلْسِنَتِهِمْ  .  قَالَ أَبُو بَكْرٍ :  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  أَبِي الْيَسَرِ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ إِلَّا  عَمْرُو بْنُ مَالِكٍ  ، عَنْ  فُضَيْلِ بْنِ سُلَيْمَانَ  ، وَلَمْ نَسْمَعْ أَحَدًا  تَابَعَهُ  عَلَى هَذَا الْحَدِيثِ ، وَلَا         [6/274]      رَأَيْنَاهُ عِنْدَ غَيْرِهِ  بِإِسْنَادٍ  خِلَافَ هَذَا  الْإِسْنَادِ  فَنَعْلَمُ أَنَّهُ قَدْ  أَوْهَمَ فِيهِ  ، أَوْ يَكُونُ الْمُصِيبَ ، فَلَمَّا لَمْ نَعْلَمْ لَهُ عِلَّةً  ذَكَرْنَاهُ إِذْ كَانَ  إِسْنَادُهُ  حَسَنًا  وَمَتْنُهُ  غَرِيبٌ  .","","Musnad al-Bazzar 2302","","كعب بن عمرو بن عباد البدري عن أبيه عن يزيد بن عامر بن أبي اليسر عن فضيل بن سليمان النميري عن عمرو بن مالك بن عمر الراسبي عن البزار","من حديث أبي اليسر"
"2310","2303  -  حَدَّثَنَا  عَمْرُو بْنُ مَالِكٍ قَالَ :  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ قَالَ :  أَخْبَرَنَا  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ،  عَنْ  عُمَرَ بْنِ الْحَكَمِ ،  عَنْ  أَبِي الْيَسَرِ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  إِنَّ الرَّجُلَ لَيُصَلِّي الصَّلَاةَ لَهُ نِصْفُهَا  ، ثُلُثُهَا ، رُبُعُهَا ، خُمُسُهَا ، سُدُسُهَا ، سُبُعُهَا ، ثُمُنُهَا ، تُسْعُهَا ، عُشْرُهَا  .  قَالَ أَبُو بَكْرٍ :  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا حَدَّثَ بِهِ ، فَقَالَ : عَنْ  أَبِي الْيَسَرِ  إِلَّا  ابْنُ وَهْبٍ  ، عَنْ  عَمْرِو بْنِ الْحَارِثِ  ، عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ  ، عَنْ  عُمَرَ بْنِ الْحَكَمِ  ، وَقَدْ رَوَاهُ غَيْرُ وَاحِدٍ ، فَقَالَ : عَنْ  عُمَرَ بْنِ الْحَكَمِ  ، عَنْ  عَمَّارِ بْنِ يَاسِرٍ  ، فَذَكَرْنَا هَذَا الْحَدِيثَ ، عَنْ  أَبِي الْيَسَرِ  ، وَعَنْ  عَمَّارٍ  ، كَانَ فِي حَدِيثِ  عَمَّارٍ  زِيَادَةٌ ، وَحَدِيثُ  أَبِي الْيَسَرِ  قَلِيلٌ فَذَكَرْنَاهُ ؛ لِيُعْلَمَ أَنَّ  أَبَا الْيَسَرِ  رَوَاهُ ، وَبَيَّنَّا  الْعِلَّةَ  فِيهِ  .","","Musnad al-Bazzar 2303","","كعب بن عمرو بن عباد البدري عن عمر بن الحكم بن رافع الأوسي عن سعيد بن أبي هلال الليثي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن عمرو بن مالك بن عمر الراسبي عن البزار","من حديث أبي اليسر"
"2311","2304  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ قَالَ :  أَخْبَرَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،         [6/275]      قَالَ :  أَخْبَرَنَا  ابْنُ وَهْبٍ قَالَ :  حَدَّثَنِي  مَخْرَمَةُ بْنُ بُكَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  سَعِيدِ بْنِ نَافِعٍ  قَالَ  :  رَآنِي أَبُو الْيَسَرِ وَأَنَا أُصَلِّي صَلَاةَ الضُّحَى حِينَ طَلَعَتِ الشَّمْسُ ، فَنَهَانِي ، ثُمَّ قَالَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تُصَلُّوا حَتَّى تَرْتَفِعَ الشَّمْسُ ، فَإِنَّهَا تَطْلُعُ بَيْنَ  قَرْنَيِ  الشَّيْطَانِ  .  قَالَ أَبُو بَكْرٍ :  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ يُرْوَى عَنْ  أَبِي الْيَسَرِ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَقَدْ يُرْوَى نَحْوٌ مِنْهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِغَيْرِ هَذَا اللَّفْظِ ، فَذَكَرْنَا حَدِيثَ  أَبِي الْيَسَرِ  لِهَذِهِ  الْعِلَّةِ  وَسَعِيدُ بْنُ نَافِعٍ  لَا نَعْلَمُ حَدَّثَ عَنْهُ إِلَّا  بُكَيْرُ بْنُ عَبْدِ اللهِ  .","","Musnad al-Bazzar 2304","","كعب بن عمرو بن عباد البدري عن سعيد بن نافع الأنصاري عن بكير بن عبد الله بن الأشج القرشي عن مخرمة بن بكير المخزومي عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن محمد بن عبد الرحيم  صاعقة عن البزار","من حديث أبي اليسر"
"2312","[6/276]             [6/277]      مُسْنَدُ  سَهْلِ بْنِ أَبِي حَثْمَةَ  رَضِيَ اللهُ عَنْهُ         [6/278]             [6/279]      سَهْلُ بْنُ أَبِي حَثْمَةَ  2305  -  أَخْبَرَنَا  عَمْرٌو قَالَ :  أَخْبَرَنَا  أَبُو دَاوُدَ قَالَ :  أَخْبَرَنَا  شُعْبَةُ قَالَ :  أَخْبَرَنِي  خُبَيْبٌ يَعْنِي ابْنَ عَبْدِ الرَّحْمَنِ قَالَ :  سَمِعْتُ  عَبْدَ الرَّحْمَنِ بْنَ مَسْعُودِ بْنِ نِيَارٍ قَالَ : جَاءَنَا سَهْلُ بْنُ أَبِي حَثْمَةَ ، فَقَالَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  إِذَا خَرَصْتُمْ فَخُذُوا  وَدَعُوا  الثُّلُثَ  ، فَإِنْ لَمْ تَدَعُوا الثُّلُثَ فَدَعُوا الرُّبُعَ  .         [6/280]      قَالَ أَبُو بَكْرٍ :  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا  سَهْلُ بْنُ أَبِي حَثْمَةَ  ، وَلَا نَعْلَمُ يَرْوِي هَذَا الْحَدِيثَ عَنْ  سَهْلٍ  إِلَّا  عَبْدُ الرَّحْمَنِ بْنُ نِيَارٍ  ، وَهُوَ  مَعْرُوفٌ  ، وَلَا نَعْلَمُ رَوَاهُ إِلَّا  شُعْبَةُ  .","","Musnad al-Bazzar 2305","","سهل بن أبي حثمة الخزرجي عن عبد الرحمن بن مسعود بن نيار الأنصاري عن خبيب بن عبد الرحمن الخزرجي عن شعبة بن الحجاج عن أبو داود الطيالسي عن الفلاس عن البزار","سهل بن أبي حثمة"
"2313","[6/281]      مُسْنَدُ  عَمْرِو بْنِ الْحَمِقِ  رَضِيَ اللهُ عَنْهُ         [6/282]             [6/283]      مِنْ حَدِيثِ  عَمْرِو بْنِ الْحَمِقِ  2306  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ قَالَ :  أَخْبَرَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  رِفَاعَةَ بْنِ شَدَّادٍ قَالَ :  سَمِعْتُ  عَمْرَو بْنَ الْحَمِقِ الْخُزَاعِيَّ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : ""  مَنْ أَمَّنَ رَجُلًا عَلَى نَفْسِهِ فَقَتَلَهُ فَإِنَّهُ يَحْمِلُ لِوَاءَ غَدْرٍ يَوْمَ الْقِيَامَةِ  .         [6/284]      وَهَذَا الْحَدِيثُ رَوَاهُ  عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ  ، عَنْ  رِفَاعَةَ بْنِ شَدَّادٍ  ، وَهُوَ  رِفَاعَةُ الْقِتْبَانِيُّ  الَّذِي رَوَى عَنْهُ  السُّدِّيُّ  .  وَأَمَّا حَدِيثُ  قُرَّةَ  فَأَخْطَأَ فِيهِ  قُرَّةُ  لِأَنَّهُ قَالَ : عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ  ، عَنْ  عَامِرِ بْنِ شَدَّادٍ ،  وَالصَّوَابُ مَا قَالَ  أَبُو عَوَانَةَ  ، وَقَدْ  تَابَعَ  أَبَا عَوَانَةَ  عَلَى مِثْلِ رِوَايَتِهِ غَيْرُ وَاحِدٍ فَاجْتَزَيْنَا  بِأَبِي عَوَانَةَ  وَحْدَهُ  .","","Musnad al-Bazzar 2306","","عمرو بن الحمق بن الكاهن الخزاعي عن رفاعة بن شداد القتباني عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","عمرو بن الحمق"
"2314","2307  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  أَخْبَرَنَا  وَهْبُ بْنُ جَرِيرٍ ، وَأَبُو عَامِرٍ ،  عَنْ  قُرَّةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  عَامِرِ بْنِ شَدَّادٍ ،  عَنْ  عَمْرِو بْنِ الْحَمِقِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .","","Musnad al-Bazzar 2307","","عمرو بن الحمق بن الكاهن الخزاعي عن رفاعة بن شداد القتباني عن عبد الملك بن عمير القبطي عن قرة بن خالد السدوسي عن أبو عامر العقدي عن أبو موسى الزمن عن البزار","عمرو بن الحمق"
"2315","[6/285]      2308  -  حَدَّثَنَا  بِشْرُ بْنُ خَالِدٍ ، وَأَحْمَدُ بْنُ عُثْمَانَ قَالَا :  أَخْبَرَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى قَالَ :  أَخْبَرَنَا  عِيسَى بْنُ عُمَرَ ،  عَنِ  السُّدِّيِّ ،  عَنْ  رِفَاعَةَ الْقِتْبَانِيِّ ،  عَنْ  عَمْرِو بْنِ الْحَمِقِ قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : ""  مَنْ أَمَّنَ رَجُلًا عَلَى نَفْسِهِ فَقَتَلَهُ فَأَنَا مِنَ الْقَاتِلِ بَرِيءٌ  ، وَإِنْ كَانَ الْمَقْتُولُ كَافِرًا  .         [6/286]      قَالَ أَبُو بَكْرٍ :  وَهَذَا الْحَدِيثُ إِنَّمَا ذَكَرْنَاهُ ، عَنْ  عَمْرِو بْنِ الْحَمِقِ  لِأَنَّهُ بِخِلَافِ لَفْظِ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ  ؛ لِأَنَّ  عَبْدَ الْمَلِكِ بْنَ عُمَيْرٍ  قَالَ : ""  مَنْ أَمَّنَ رَجُلًا عَلَى نَفْسِهِ فَقَتَلَهُ فَإِنَّهُ يَحْمِلُ لِوَاءَ غَدْرٍ  "" .  وَقَالَ  عِيسَى  : "" فَأَنَا مِنَ الْقَاتِلِ بَرِيءٌ "" فَصَارَ حَدِيثًا آخَرَ .  قَالَ أَبُو بَكْرٍ : وَقَدْ رَوَى  سُلَيْمَانُ التَّيْمِيُّ  ، عَنِ  السُّدِّيِّ  ، عَنْ  رِفَاعَةَ  ، عَنْ  عَمْرِو بْنِ الْحَمِقِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوٍ مِنْ حَدِيثِ  عِيسَى بْنِ عُمَرَ  ، عَنْ  رِفَاعَةَ  ، عَنْ  عَمْرٍو  .","","Musnad al-Bazzar 2308","","عمرو بن الحمق بن الكاهن الخزاعي عن رفاعة بن شداد القتباني عن السدي الكبير عن عيسى بن عمر الهمداني عن عبيد الله بن موسى عن أحمد بن عثمان بن حكيم عن البزار","عمرو بن الحمق"
"2316","2309  -  فَحَدَّثَنَا  بِحَدِيثِ سُلَيْمَانَ التَّيْمِيِّ ، إِبْرَاهِيمُ بْنُ الْمُسْتَمِرِّ قَالَ :  أَخْبَرَنَا  عَمْرُو بْنُ عَاصِمٍ قَالَ :  أَخْبَرَنَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ  ،  عَنِ  السُّدِّيِّ ،  عَنْ  رِفَاعَةَ ،  عَنْ  عَمْرِو بْنِ الْحَمِقِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2309","","عمرو بن الحمق بن الكاهن الخزاعي عن رفاعة بن شداد القتباني عن السدي الكبير عن سليمان بن طرخان عن معتمر بن سليمان عن عمرو بن عاصم الكلابي عن إبراهيم بن المستمر العروقي عن البزار","عمرو بن الحمق"
"2317","2310  -  حَدَّثَنَا  بِشْرُ بْنُ آدَمَ قَالَ :  أَخْبَرَنَا  زَيْدُ بْنُ الْحُبَابِ قَالَ :  أَخْبَرَنَا  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَمْرِو بْنِ الْحَمِقِ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  إِذَا أَرَادَ اللهُ بِعَبْدٍ خَيْرًا  عَسَلَهُ  قَالُوا : يَا رَسُولَ اللهِ ، وَمَا  عَسَلَهُ  ؟         [6/287]      قَالَ : "" يُوَفِّقُهُ لِعَمَلٍ صَالِحٍ ، ثُمَّ يَقْبِضُهُ عَلَيْهِ  .","","Musnad al-Bazzar 2310","","عمرو بن الحمق بن الكاهن الخزاعي عن جبير بن نفير بن مالك الحضرمي عن عبد الرحمن بن جبير الحضرمي عن معاوية بن صالح بن حدير الحضرمي عن زيد بن الحباب العكلي عن بشر بن آدم بن يزيد عن البزار","عمرو بن الحمق"
"2318","2311  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مِسْكِينٍ قَالَ :  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ قَالَ :  أَخْبَرَنَا  أَبُو شُرَيْحٍ عَبْدُ الرَّحْمَنِ بْنُ شُرَيْحٍ ،  أَنَّهُ سَمِعَ  عَمِيرَةَ بْنَ عَبْدِ اللهِ الْمَعَافِرِيَّ يَقُولُ :  حَدَّثَنِي  أَبِي  ،  أَنَّهُ سَمِعَ  ابْنَ الْحَمِقِ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  تَكُونُ فِتْنَةٌ  أَسْلَمُ النَّاسِ فِيهَا - أَوْ قَالَ : خَيْرُ النَّاسِ فِيهَا  - الْجُنْدُ الْغَرْبِيُّ  ، قَالَ  ابْنُ الْحَمِقِ  : فَلِذَلِكَ قَدِمْتُ عَلَيْكُمْ  مِصْرَ  .         [6/288]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ بِهَذَا اللَّفْظِ إِلَّا  عَمْرُو بْنُ الْحَمِقِ  وَحْدَهُ .  وَلَا نَعْلَمُ لَهُ طَرِيقًا إِلَّا هَذَا الطَّرِيقَ ، وَلَا نَعْلَمُ رَوَاهُ عَنِ  ابْنِ شُرَيْحٍ  إِلَّا  عَبْدُ اللهِ بْنُ صَالِحٍ  .","","Musnad al-Bazzar 2311","","عمرو بن الحمق بن الكاهن الخزاعي عن والد عميرة بن عبد الله المعافري عن عميرة بن عبد الله المعافري عن عبد الرحمن بن شريح المعافري عن عبد الله بن صالح المصري عن محمد بن مسكين بن نميلة اليمامي عن البزار","عمرو بن الحمق"
"2319","[6/289]      مُسْنَدُ  عَبْدِ اللهِ بْنِ بُحَيْنَةَ  رَضِيَ اللهُ عَنْهُ         [6/290]             [6/291]      مُسْنَدُ  عَبْدِ اللهِ بْنِ بُحَيْنَةَ  2312  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ رُوَيْنٍ قَالَ :  أَخْبَرَنَا  عَطَّافُ بْنُ خَالِدٍ ، قَالَ :  حَدَّثَنِي  مَالِكُ بْنُ عَبْدِ اللهِ بْنِ بُحَيْنَةَ ،  عَنْ  أَبِيهِ  رَضِيَ اللهُ عَنْهُ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ اسْتَغْفَرَ وَصَلَّى عَلَى أَهْلِ مَقْبَرَةٍ  بِعَسْقَلَانَ  .         [6/292]      وَمُحَمَّدُ بْنُ رُوَيْنٍ بَصْرِيٌّ  ، لَا نَعْرِفُهُ يُحَدِّثُ بِكَثِيرٍ ،  وَعَطَّافٌ  ضَعِيفٌ  .","","Musnad al-Bazzar 2312","","عبد الله بن مالك بن سعد بن القشب الأزدي عن مالك بن عبد الله بن بحينة عن عطاف بن خالد المخزومي عن محمد بن روين بن عبد الرحمن بن لاحق عن أبو موسى الزمن عن البزار","مسند عبد الله بن بحينة"
"2320","2313  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ قَالَ :  أَخْبَرَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ قَالَ :  حَدَّثَنِي  ابْنُ أَخِي ابْنِ شِهَابٍ ،  عَنْ  عَمِّهِ ،  عَنِ  الْأَعْرَجِ ،  عَنِ  ابْنِ بُحَيْنَةَ رَضِيَ اللهُ عَنْهُ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى صَلَاةً يَجْهَرُ فِيهَا ، فَلَمَّا انْصَرَفَ قَالَ : "" تَقْرَأُونَ خَلْفِي ؟ "" فَقَالَ بَعْضُهُمْ : إِنَّا لَنَفْعَلُ قَالَ :  لَا تَفْعَلُوا ، إِنِّي أَقُولُ مَا لِي  أُنَازَعُ  الْقُرْآنَ  ، قَالَ : فَانْتَهَى النَّاسُ عَنِ الْقِرَاءَةِ فِيمَا جَهَرَ فِيهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا قَالَ فِيهِ عَنِ  الزُّهْرِيِّ  ، عَنِ  الْأَعْرَجِ  إِلَّا  ابْنُ أَخِي الزُّهْرِيِّ  ، وَأَخْطَأَ فِيهِ ، وَإِنَّمَا هُوَ عَنِ  الزُّهْرِيِّ  ، عَنِ  ابْنِ أُكَيْمَةَ  .  هَكَذَا رَوَاهُ  ابْنُ عُيَيْنَةَ  ،  وَمَعْمَرٌ  ، عَنِ  الزُّهْرِيِّ  ، عَنِ         [6/293]      ابْنِ أُكَيْمَةَ  ، عَنْ  أَبِي هُرَيْرَةَ  .  وَلَكِنْ ذَكَرْنَا حَدِيثَ  ابْنِ بُحَيْنَةَ  لِيَعْرِفَ مَنْ سَمِعَ ذَلِكَ أَنَّهُ خَطَأٌ  .","","Musnad al-Bazzar 2313","","عبد الله بن مالك بن سعد بن القشب الأزدي عن عبد الرحمن بن هرمز الأعرج عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعيد الجوهري عن البزار","مسند عبد الله بن بحينة"
"2321","[6/294]             [6/295]      مُسْنَدُ  رُوَيْفِعِ بْنِ ثَابِتٍ  رَضِيَ اللهُ عَنْهُ         [6/296]             [6/297]      رُوَيْفِعُ بْنُ ثَابِتٍ  2314  -  حَدَّثَنَا  يَحْيَى بْنُ خَلَفٍ أَبُو سَلَمَةَ قَالَ :  أَخْبَرَنَا  عَبْدُ الْأَعْلَى بْنُ عَبْدِ الْأَعْلَى قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَبِي الْحَسَنِ ،  عَنْ  رُوَيْفِعِ بْنِ ثَابِتٍ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  مَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ ، فَلَا يَسْقِيَنَّ مَا يَزْرَعُ غَيْرُهُ  .         [6/298]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ إِلَّا  رُوَيْفِعُ بْنُ ثَابِتٍ  وَحْدَهُ  فَإِسْنَادُهُ حَسَنٌ  .","","Musnad al-Bazzar 2314","","رويفع بن ثابت الأنصاري عن أبو الحسن الأنصاري عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن يحيى بن خلف الجوباري عن البزار","رويفع بن ثابت"
"2322","[6/299]      2315  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ الْجُنَيْدِ قَالَ :  أَخْبَرَنَا  أَبُو صَالِحٍ عَبْدُ الْغَفَّارِ بْنُ دَاوُدَ ، وَعَمْرُو بْنُ خَالِدٍ ، وَيَحْيَى بْنُ بُكَيْرٍ ، قَالُوا :  أَخْبَرَنَا  ابْنُ لَهِيعَةَ قَالَ :  حَدَّثَنِي  بَكْرُ بْنُ سَوَادَةَ ،  عَنْ  زِيَادِ بْنِ نُعَيْمٍ ،  عَنْ  وَفَاءِ بْنِ شُرَيْحٍ الْحَضْرَمِيِّ ،  عَنْ  رُوَيْفِعِ بْنِ ثَابِتٍ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  مَنْ صَلَّى عَلَى  مُحَمَّدٍ  ، وَقَالَ : اللَّهُمَّ أَنْزِلْهُ الْمَقْعَدَ الْمُقَرَّبَ عِنْدَكَ يَوْمَ الْقِيَامَةِ وَجَبَتْ لَهُ شَفَاعَتِي  .         [6/300]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِهَذَا اللَّفْظِ إِلَّا  رُوَيْفِعُ بْنُ ثَابِتٍ  وَحْدَهُ  .","","Musnad al-Bazzar 2315","","رويفع بن ثابت الأنصاري عن وفاء بن شريح الخولاني عن زياد بن ربيعة الحضرمي عن بكر بن سوادة عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن إبراهيم بن عبد الله بن الجنيد الختلي عن البزار","رويفع بن ثابت"
"2323","2316  -  حَدَّثَنَا  إِبْرَاهِيمُ قَالَ :  أَخْبَرَنَا  سَعِيدُ بْنُ أَسَدِ بْنِ مُوسَى قَالَ :  أَخْبَرَنَا  إِدْرِيسُ بْنُ يَحْيَى الْخَوْلَانِيُّ قَالَ :  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ عَيَّاشٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  شِيَيْمِ بْنِ بَيْتَانَ ،  عَنْ  شَيْبَانَ بْنِ أُمَيَّةَ ،  عَنْ  رُوَيْفِعِ بْنِ ثَابِتٍ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  مَنْ رَدَّتْهُ  الطِّيَرَةُ  عَنْ شَيْءٍ فَقَدْ قَارَفَ  الشِّرْكَ  .         [6/301]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ بِهَذَا اللَّفْظِ إِلَّا  رُوَيْفِعُ بْنُ ثَابِتٍ  وَحْدَهُ ،  وَشِيَيْمُ بْنُ بَيْتَانَ  غَيْرُ مَشْهُورٍ  ، وَإِنَّمَا ذَكَرْنَا حَدِيثَهُ إِذْ كَانَ لَا يُرْوَى عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ هَذَا الْكَلَامُ إِلَّا عَنْهُ وَقَدْ رَوَى غَيْرَ هَذَا الْحَدِيثِ أَيْضًا  .","","Musnad al-Bazzar 2316","","رويفع بن ثابت الأنصاري عن شيبان بن أمية القتباني عن شييم بن بيتان القتباني عن عياش بن عباس القتباني عن عبد الله بن عياش القتباني عن إدريس بن يحيى الخولاني عن سعيد بن أسد بن موسى المصري عن إبراهيم بن عبد الله بن الجنيد الختلي عن البزار","رويفع بن ثابت"
"2324","2317  -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ قَالَ :  أَخْبَرَنَا  الْمُفَضَّلُ بْنُ فَضَالَةَ قَالَ :  أَخْبَرَنَا  عَيَّاشُ بْنُ عَبَّاسٍ ،  عَنْ  شِيَيْمِ بْنِ بَيْتَانَ ،  عَنْ  شَيْبَانَ  قَالَ  : كُنَّا مَعَ رُوَيْفِعِ بْنِ ثَابِتٍ ، فَقَالَ : ""  لَا أُخْبَرَنَّ أَنَّ أَحَدًا عَقَدَ  وَتَرًا  أَوِ اسْتَنْجَى بِعَظْمٍ أَوْ  رَجِيعٍ  ، فَمَنْ فَعَلَ ذَلِكَ فَإِنَّهُ قَدْ  بَرِئَ مِنْ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَوْ مِمَّا أُنْزِلَ عَلَى  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .         [6/302]      وَهَذَا الْحَدِيثُ قَدْ رَوَى نَحْوَ كَلَامِهِ غَيْرُ وَاحِدٍ ، وَأَمَّا هَذَا اللَّفْظُ فَلَا يُحْفَظُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَلَا عَنْ أَحَدٍ غَيْرِ  رُوَيْفِعٍ  ، وَقَدْ أُدْخِلَ فِي  الْمُسْنَدِ  لِأَنَّهُ قَالَ : فَقَدْ بَرِئَ مِمَّا أُنْزِلَ عَلَى  مُحَمَّدٍ  ،  وَإِسْنَادُهُ حَسَنٌ ،  غَيْرَ  شَيْبَانَ  فَإِنَّهُ لَا نَعْلَمُ رَوَى عَنْهُ غَيْرُ  شِيَيْمِ بْنِ بَيْتَانَ  ،  وَعَيَّاشُ بْنُ عَبَّاسٍ  مَشْهُورٌ  .","","Musnad al-Bazzar 2317","","رويفع بن ثابت الأنصاري عن شيبان بن أمية القتباني عن شييم بن بيتان القتباني عن عياش بن عباس القتباني عن المفضل بن فضالة عن عبد الأعلى بن حماد النرسي عن البزار","رويفع بن ثابت"
"2325","[6/303]      مُسْنَدُ  عُثْمَانَ بْنِ أَبِي الْعَاصِ  رَضِيَ اللهُ عَنْهُ         [6/304]             [6/305]      مِنْ حَدِيثِ  عُثْمَانَ بْنِ أَبِي الْعَاصِ  2318  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ قَالَ :  أَخْبَرَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عُثْمَانَ بْنِ أَبِي الْعَاصِ رَضِيَ اللهُ عَنْهُ قَالَ : ""  كَانَ آخِرُ مَا عَهِدَ إِلَيَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا أَمَمْتُ بِقَوْمٍ أَنْ أُخَفِّفَ بِهِمُ الصَّلَاةَ  .  وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنْ  عُثْمَانَ بْنِ أَبِي الْعَاصِ  مِنْ وُجُوهٍ ، وَأَعْلَاهَا  إِسْنَادًا  يُرْوَى فِي ذَلِكَ هَذَا  الْإِسْنَادُ  ، وَلَا نَعْلَمُ         [6/306]      رَوَى  سَعِيدُ بْنُ الْمُسَيِّبِ  ، عَنْ  عُثْمَانَ بْنِ أَبِي الْعَاصِ  غَيْرَ هَذَا الْحَدِيثِ ، وَلَا رَوَاهُ عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ  إِلَّا  عَمْرُو بْنُ مُرَّةَ  ، وَلَا عَنْ  عَمْرٍو  إِلَّا  شُعْبَةُ  ، فَذَكَرْنَا هَذَا  الْإِسْنَادَ  عَنْ  عُثْمَانَ  دُونَ سَائِرِ  الْأَسَانِيدِ  الَّتِي تُرْوَى فِي ذَلِكَ عَنْهُ إِلَّا أَنَّ يَزِيدَ زَائِدٌ فَيُكْتَبُ مِنْ أَجْلِ الزِّيَادَةِ  .","","Musnad al-Bazzar 2318","","عثمان بن أبي العاصي فارس السرح عن سعيد بن المسيب عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","من حديث عثمان بن أبي العاص"
"2326","2319  -  حَدَّثَنِي  يَحْيَى بْنُ خَلَفٍ أَبُو سَلَمَةَ قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ أَبِي عَدِيٍّ قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِنْدٍ ،  عَنْ  مُطَرِّفِ بْنِ عَبْدِ اللهِ ،  عَنْ  عُثْمَانَ بْنِ أَبِي الْعَاصِ رَضِيَ اللهُ عَنْهُ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : ""  الصَّوْمُ  جُنَّةٌ  كَجُنَّةِ  أَحَدِكُمْ  لِلْقِتَالِ - أَوْ مِنَ الْقِتَالِ  .  قَالَ :  وَكَانَ آخِرُ مَا عَهِدَ إِلَيَّ         [6/307]      النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ بَعَثَنِي عَلَى  الطَّائِفِ  أَنَّهُ قَالَ :  يَا  عُثْمَانُ  إِذَا أَمَمْتَ قَوْمًا فَتَجَوَّزْ بِهِمْ فِي الصَّلَاةِ  ، وَاقْدُرْهُمْ بِأَضْعَفِهِمْ  .         [6/308]      وَهَذَا الْحَدِيثُ إِنَّمَا كَتَبْنَاهُ لِأَنَّ لَفْظَهُ مُخَالِفٌ لِلَفْظِ  سَعِيدِ بْنِ الْمُسَيِّبِ  ، عَنْ  عُثْمَانَ  ، فَمِنْ أَجْلِ ذَلِكَ ذَكَرْنَاهُ ، وَلَوْ كَانَ مِثْلَهُ كَانَ فِي حَدِيثِ  سَعِيدٍ  عَنْ  عُثْمَانَ  كِفَايَةٌ .  وَفِي هَذَا الْحَدِيثِ أَيْضًا "" الصَّوْمُ  جُنَّةٌ  "" وَلَيْسَ فِي حَدِيثِ  سَعِيدِ بْنِ الْمُسَيِّبِ  عَنْ  عُثْمَانَ ،  فَذَكَرْنَاهُ مِنْ أَجْلِ الزِّيَادَةِ الَّتِي فِيهِ وَلِاخْتِلَافِ لَفْظِهِ .","","Musnad al-Bazzar 2319","","عثمان بن أبي العاصي فارس السرح عن مطرف بن عبد الله بن الشخير الحرشي عن سعيد بن أبي هند الفزاري عن محمد بن إسحاق عن محمد بن إبراهيم بن أبي عدي القسملي عن يحيى بن خلف الجوباري عن البزار","من حديث عثمان بن أبي العاص"
"2327","2320  -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ قَالَ :  أَخْبَرَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  عُثْمَانَ بْنِ أَبِي الْعَاصِ ، رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  إِنَّ فِي اللَّيْلِ سَاعَةً يُنَادِي مُنَادٍ هَلْ مِنْ دَاعٍ فَأَسْتَجِيبَ لَهُ  : هَلْ مِنْ سَائِلٍ فَأُعْطِيَهُ ؟ هَلْ مِنْ مُسْتَغْفِرٍ فَأَغْفِرَ لَهُ  ؟ "" .         [6/309]      وَهَذَا الْحَدِيثُ قَدْ رُوِيَ نَحْوُ كَلَامِهِ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِأَلْفَاظٍ مُخْتَلِفَةٍ نَذْكُرُ كُلَّ حَدِيثٍ مِنْهَا بِلَفْظِهِ فِي مَوْضِعِهِ إِنْ شَاءَ اللهُ ، وَلَا نَعْلَمُ أَنَّ أَحَدًا يُحَدِّثُهُ بِهَذَا الْحَدِيثِ ، عَنْ  عُثْمَانَ بْنِ أَبِي الْعَاصِ  ، إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2320","","عثمان بن أبي العاصي فارس السرح عن الحسن البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن هدبة بن خالد عن البزار","من حديث عثمان بن أبي العاص"
"2328","2321  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  أَخْبَرَنَا  عَبْدُ الْوَهَّابِ بْنُ عَبْدِ الْمَجِيدِ قَالَ :  أَخْبَرَنَا  عَنْبَسَةُ بْنُ أَبِي رَائِطَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  عُثْمَانَ بْنِ أَبِي الْعَاصِ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  الصِّيَامُ  جُنَّةٌ  يَسْتَجِنُّ بِهَا الْعَبْدُ مِنَ النَّارِ  .  وَهَذَا الْحَدِيثُ قَدْ ذَكَرْنَا نَحْوَ كَلَامِهِ عَنْ  عُثْمَانَ  ، وَلَكِنْ حَدِيثُ  عُثْمَانَ  الْأَوَّلُ ""  الصَّوْمُ  جُنَّةٌ  كَجُنَّةِ  أَحَدِكُمْ مِنَ الْقِتَالِ  "" ، وَفِي هَذَا الْحَدِيثِ : "" يَسْتَجِنُّ بِهَا الْعَبْدُ مِنَ النَّارِ "" فَذَكَرْنَا ذَلِكَ لِاخْتِلَافِ اللَّفْظِ فِيهِ .","","Musnad al-Bazzar 2321","","عثمان بن أبي العاصي فارس السرح عن الحسن البصري عن عنبسة بن أبي رائطة الغنوي عن عبد الوهاب بن عبد المجيد الثقفي عن أبو موسى الزمن عن البزار","من حديث عثمان بن أبي العاص"
"2329","2322  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مِرْدَاسٍ ، وَأَزْهَرُ بْنُ جَمِيلٍ قَالَا :  أَخْبَرَنَا  سَالِمُ بْنُ نُوحٍ قَالَ :  أَخْبَرَنَا  الْجُرَيْرِيُّ ،  عَنْ  أَبِي الْعَلَاءِ ،  عَنْ  عُثْمَانَ بْنِ أَبِي الْعَاصِ ،  أَنَّ  مَوْلًى لَهُ  اشْتَرَى خَمْرًا فَرَبِحَ فِيهِ ، فَقَالَ         [6/310]      لَهُ  عُثْمَانُ  :  ارْدُدْهُ ، فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنِ الْخَمْرِ وَحَرَّمَ ثَمَنَهَا  .  قَالَ  سَالِمٌ  :  وَحَدَّثَنِي  يُونُسُ ،  عَنِ  الْحَسَنِ ،  عَنْ  عُثْمَانَ بْنِ أَبِي الْعَاصِ بِمِثْلِهِ .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ لَهُ طَرِيقًا عَنْ  عُثْمَانَ  إِلَّا مَا ذَكَرْنَاهُ ، فَقَدْ رُوِيَ نَحْوُ كَلَامِهِ عَنْ غَيْرِ  عُثْمَانَ  بِغَيْرِ هَذَا اللَّفْظِ ، نَذْكُرُهُ فِي مَوْضِعِهِ بِلَفْظِهِ إِنْ شَاءَ اللهُ .","","Musnad al-Bazzar 2322","","عثمان بن أبي العاصي فارس السرح عن الحسن البصري عن يونس بن عبيد عن سالم بن نوح العطار عن أزهر بن جميل الشطي عن البزار","من حديث عثمان بن أبي العاص"
"2330","2323  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْبَغْدَادِيُّ قَالَ :  أَخْبَرَنَا  ابْنُ أَبِي كَرِيمَةَ قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ سَلَمَةَ قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُلَاثَةَ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنِ  الْحَسَنِ ،  عَنْ         [6/311]      عُثْمَانَ بْنِ أَبِي الْعَاصِ رَضِيَ اللهُ عَنْهُ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  إِنِّي لَأَسْمَعُ بُكَاءَ الصَّبِيِّ فَأَخِفُّ الصَّلَاةَ كَرَاهِيَةَ أَنْ تُفْتَتَنَ أُمُّهُ  .  وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنْ  أَبِي هُرَيْرَةَ  وَأَنَسٍ  بِأَسَانِيدَ  أَحْسَنَ مِنْ هَذَا  الْإِسْنَادِ  ، وَلَكِنْ ذَكَرْنَاهُ عَنْ  عُثْمَانَ  لِعِزَّةِ حَدِيثِ  عُثْمَانَ  ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَلَا نَعْلَمُ يُرْوَى عَنْ  عُثْمَانَ  هَذَا الْكَلَامُ إِلَّا مِنْ هَذَا الْوَجْهِ ،  وَمُحَمَّدُ بْنُ عَبْدِ اللهِ  لَيِّنُ الْحَدِيثِ  ، وَالْبَاقُونَ مَشَاهِيرُ  .","","Musnad al-Bazzar 2323","","عثمان بن أبي العاصي فارس السرح عن الحسن البصري عن هشام بن حسان العتكي عن قاضي الجن محمد بن عبد الله بن علاثة عن محمد بن سلمة الباهلي عن إسماعيل بن عبيد بن عمر مولى عثمان بن عفان عن محمد بن إسحاق الخراساني عن البزار","من حديث عثمان بن أبي العاص"
"2331","2324  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ شَبُّوَيْهِ الْمَرْوَزِيُّ ، وَإِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ الْجُنَيْدِ قَالَا :  أَخْبَرَنَا  عُمَرُ بْنُ حَفْصِ بْنِ غِيَاثٍ قَالَ :         [6/312]      أَخْبَرَنَا  أَبِي  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ الْحَكَمِ ، وَهُوَ ابْنُ أَخِي عُثْمَانَ بْنِ أَبِي الْعَاصِ ،  عَنْ  عُثْمَانَ بْنِ أَبِي الْعَاصِ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  لَقَدِ اسْتَجَنَّ  بِجُنَّةٍ  كَثِيفَةٍ مِنَ النَّارِ مَنْ سَلَفَ بَيْنَ يَدَيْهِ ثَلَاثَةٌ مِنَ الْوَلَدِ فِي الْإِسْلَامِ  .  وَهَذَا الْحَدِيثُ لَا نَحْفَظُ لَهُ طَرِيقًا عَنْ  عُثْمَانَ  إِلَّا هَذَا ، وَلَا يُحْفَظُ هَذَا اللَّفْظُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  ، وَإِنْ كَانَ قَدْ رُوِيَ نَحْوُ مَعْنَاهُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ وُجُوهٍ .  وَعَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ  كُوفِيٌّ يُقَالُ لَهُ  أَبُو شَيْبَةَ  ، حَدَّثَ عَنْهُ  مَرْوَانُ بْنُ مُعَاوِيَةَ  ،  وَمُحَمَّدُ بْنُ فُضَيْلٍ  ،  وَالْقَاسِمُ بْنُ مَالِكٍ  ،  وَعَبْدُ الْوَاحِدِ بْنُ زِيَادٍ  ،  وَحَفْصُ بْنُ غِيَاثٍ  وَغَيْرُهُمْ ،  وَلَيْسَ حَدِيثُهُ حَدِيثَ حَافِظٍ  ، وَقَدِ احْتُمِلَ حَدِيثُهُ  .","","Musnad al-Bazzar 2324","","عثمان بن أبي العاصي فارس السرح عن يزيد بن الحكم بن أبي العاص الثقفي عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن حفص بن غياث النخعي عن عمر بن حفص بن غياث عن إبراهيم بن عبد الله بن الجنيد الختلي عن البزار","من حديث عثمان بن أبي العاص"
"2332","[6/313]      2325  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ الْمَرْوَزِيُّ قَالَ :  أَخْبَرَنَا  عُمَرُ بْنُ حَفْصٍ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ  ،  عَنْ  يَزِيدَ بْنِ الْحَكَمِ ،  عَنْ  عُثْمَانَ بْنِ أَبِي الْعَاصِ رَضِيَ اللهُ عَنْهُ قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَذَكَرَ الْحَيَّاتِ ، فَقَالَ :  مَنْ خَشِيَ  إِرْبَهُنَّ  فَلَيْسَ مِنَّا  .  وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنْ غَيْرِ وَاحِدٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ : ""  مَنْ تَرَكَهُنَّ خَشْيَةَ ثَأْرِهِنَّ فَلَيْسَ مِنَّا  "" . قَالَ: وَفِي هَذَا الْحَدِيثِ "" مَنْ خَشِيَ  إِرْبَهُنَّ  فَلَيْسَ مِنَّا "" فَكَتَبْنَاهُ لِاخْتِلَافِ اللَّفْظِ وَلِأَنَّهُ لَا يُرْوَى عَنْ  عُثْمَانَ  إِلَّا مِنْ هَذَا الْمَوْضِعِ  .  [زاد بعده في طبعة مكتبة العلوم والحكم : ( نا ) وهو خطأ ، وينظر كشف الأستار 1231  كذا في طبعة مكتبة العلوم والحكم ، والصواب : (عبد الرحمن بن إسحاق) هو على الصواب في كشف الأستار .","","Musnad al-Bazzar 2325","","عثمان بن أبي العاصي فارس السرح عن يزيد بن الحكم بن أبي العاص الثقفي عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن حفص بن غياث النخعي عن عمر بن حفص بن غياث عن عبد الله بن أحمد بن شبوية المروزي عن البزار","من حديث عثمان بن أبي العاص"
"2333","2326  -  أَخْبَرَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ الْجُنَيْدِ أَبُو شَيْبَةَ قَالَ :  أَخْبَرَنَا  فَرْوَةُ بْنُ أَبِي الْمَغْرَاءِ قَالَ :  أَخْبَرَنَا  الْقَاسِمُ بْنُ مَالِكٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ الْحَكَمِ ،  عَنْ  عُثْمَانَ بْنِ أَبِي الْعَاصِ رَضِيَ اللهُ عَنْهُ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا اشْتَدَّ         [6/314]      الرِّيحُ قَالَ :  اللَّهُمَّ أَعُوذُ بِكَ مِنْ شَرِّ مَا أُرْسِلَ فِيهَا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ عَنْ  عُثْمَانَ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  ، وَقَدْ رُوِيَ عَنْ غَيْرِ  عُثْمَانَ  نَحْوُ كَلَامِهِ بِغَيْرِ لَفْظِهِ  .","","Musnad al-Bazzar 2326","","عثمان بن أبي العاصي فارس السرح عن يزيد بن الحكم بن أبي العاص الثقفي عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن القاسم بن مالك المزني عن فروة بن أبي المغراء الكندي عن إبراهيم بن عبد الله بن الجنيد الختلي عن البزار","من حديث عثمان بن أبي العاص"
"2334","2327  -  حَدَّثَنَا  بِشْرُ بْنُ مُعَاذٍ الْعَقَدِيُّ قَالَ :  أَخْبَرَنَا  أَبُو هَمَّامٍ قَالَ :  أَخْبَرَنَا  سَعِيدُ بْنُ السَّائِبِ الطَّائِفِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ عِيَاضٍ ،  عَنْ  عُثْمَانَ بْنِ أَبِي الْعَاصِي رَضِيَ اللهُ عَنْهُ ، ""  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَهُ أَنْ يَجْعَلَ  مَسْجِدَ الطَّائِفِ  حَيْثُ كَانَتْ طَاغِيَتُهُمْ  .         [6/315]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى إِلَّا عَنْ  عُثْمَانَ بْنِ أَبِي الْعَاصِ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2327","","عثمان بن أبي العاصي فارس السرح عن محمد بن عبد الله بن عياض الطائفي عن سعيد بن السائب الطائفي عن محمد بن محبب الدلال عن بشر بن معاذ عن البزار","من حديث عثمان بن أبي العاص"
"2335","[6/316]             [6/317]      مُسْنَدُ  أُسَامَةَ بْنِ عُمَيْرٍ  وَالِدِ  أَبِي الْمَلِيحِ  رَضِيَ اللهُ عَنْهُ         [6/318]             [6/319]      حَدِيثُ  أَبِي الْمَلِيحِ  عَنْ أَبِيهِ  2328  -  حَدَّثَنَا  أَبُو كَامِلٍ قَالَ :  أَخْبَرَنَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  .","","Musnad al-Bazzar 2328","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن قتادة بن دعامة عن الوضاح بن عبد الله اليشكري عن فضيل بن حسين الجحدري عن البزار","حديث أبي المليح عن أبيه"
"2336","2329  -  وَأَخْبَرَنَاهُ  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ قَالَ :  أَخْبَرَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  لَا يَقْبَلُ اللهُ صَلَاةً بِغَيْرِ  طُهُورٍ  وَلَا صَدَقَةً مِنْ غُلُولٍ  .         [6/320]      وَهَذَا الْحَدِيثُ قَدْ رُوِيَ نَحْوُ كَلَامِهِ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ وُجُوهٍ رَوَاهُ  ابْنُ عُمَرَ  وَأَنَسٌ  ، فَذَكَرْنَا حَدِيثَ  أَبِي مَلِيحٍ  عَنْ         [6/321]      أَبِيهِ دُونَ غَيْرِهِ  فَإِنَّ  إِسْنَادَهُ  كَانَ أَحْسَنَ  إِسْنَادًا  مِنْ غَيْرِهِ  .","","Musnad al-Bazzar 2329","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن قتادة بن دعامة عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","حديث أبي المليح عن أبيه"
"2337","2330  -  أَخْبَرَنَا  مُؤَمَّلُ بْنُ هِشَامٍ قَالَ :  أَخْبَرَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ قَالَ :  أَخْبَرَنَا  يَزِيدُ الرِّشْكُ ،  عَنْ  أَبِي الْمَلِيحِ رَضِيَ اللهُ عَنْهُ قَالَ : ""  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ جُلُودِ  السِّبَاعِ  .","","Musnad al-Bazzar 2330","","أبو المليح بن أسامة الهذلي عن يزيد بن أبي يزيد الرشك عن إسماعيل ابن علية عن مؤمل بن هشام اليشكري عن البزار","حديث أبي المليح عن أبيه"
"2338","2331  -  حَدَّثَنَا  أَحْمَدُ بْنُ السَّخْتِ قَالَ :  أَخْبَرَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ قَالَ :  أَخْبَرَنَا  يَزِيدُ الرِّشْكُ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  .         [6/322]      قَالَ أَحْمَدُ :  وَلَمْ يُتَابِعْهُ غَيْرُهُ عَلَى  رَفْعِهِ  عَنْ أَبِيهِ .  وَأَمَّا حَدِيثُ  مَطَرٍ  ، عَنْ  أَبِي الْمَلِيحِ  ، عَنْ أَبِيهِ ، فَلَمْ يَرْوِهِ إِلَّا  أَبَانُ  ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  أَبَانَ  إِلَّا  إِسْحَاقُ بْنُ إِدْرِيسَ  .","","Musnad al-Bazzar 2331","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن يزيد بن أبي يزيد الرشك عن إسماعيل ابن علية عن أحمد بن السخت الدوري عن البزار","حديث أبي المليح عن أبيه"
"2339","2332  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ قَالَ :  أَخْبَرَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2332","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن قتادة بن دعامة عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","حديث أبي المليح عن أبيه"
"2340","2333  -  وَأَخْبَرَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  أَخْبَرَنَا  مُعَاذُ بْنُ هِشَامٍ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2333","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن أبو موسى الزمن عن البزار","حديث أبي المليح عن أبيه"
"2341","2334  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ :  أَخْبَرَنَا  مُعَاذُ بْنُ هِشَامٍ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  رَضِيَ اللهُ عَنْهُ قَالَ : ""  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي يَوْمٍ مَطِيرٍ فَأَمَرَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَنَادَى أَنِ الصَّلَاةُ فِي الرِّحَالِ  .         [6/323]      وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ وُجُوهٍ فَذَكَرْنَا         [6/324]      هَذَا الطَّرِيقَ مِنْ طُرُقِ مَا رُوِيَ فِي ذَلِكَ  .","","Musnad al-Bazzar 2334","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن أبو موسى الزمن عن البزار","حديث أبي المليح عن أبيه"
"2342","2335  -  حَدَّثَنَا  عَمْرُو بْنُ مَالِكٍ قَالَ :  أَخْبَرَنَا  أَبُو قُتَيْبَةَ قَالَ :  أَخْبَرَنَا  الْمُفَضَّلُ بْنُ فَضَالَةَ ، أَخُو مُبَارَكِ بْنِ فَضَالَةَ قَالَ :  أَخْبَرَنَا  سَالِمٌ أَبُو عُبَيْدِ اللهِ بْنِ سَالِمٍ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  رَضِيَ اللهُ عَنْهُ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  صُومُوا مِنْ  وَضَحٍ  إِلَى  وَضَحٍ  .         [6/325]      وَلَا نَعْلَمُ رَوَاهُ بِهَذَا اللَّفْظِ إِلَّا مِنْ هَذَا الْوَجْهِ ، وَإِنْ كَانَ يُرْوَى نَحْوُ كَلَامِهِ .  وَلَا نَعْلَمُ رَوَى هَذَا الْحَدِيثَ إِلَّا  أَبُو قُتَيْبَةَ  .","","Musnad al-Bazzar 2335","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن سالم بن سالم أبو حاتم عن المفضل بن فضالة بن أبي أمية العمري عن سلم بن قتيبة الشعيري عن عمرو بن مالك بن عمر الراسبي عن البزار","حديث أبي المليح عن أبيه"
"2343","2336  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ الْوَاسِطِيُّ ، وَمُحَمَّدُ بْنُ مُوسَى قَالَا :  أَخْبَرَنَا  عَبْدُ الْوَهَّابِ بْنُ عِيسَى قَالَ :  أَخْبَرَنَا  يَحْيَى بْنُ أَبِي زَكَرِيَّا الْغَسَّانِيُّ ،  عَنْ  عَبَّادِ بْنِ سَعِيدٍ ، رَجُلٍ مِنْ وَلَدِ أَبِي الْمَلِيحِ ،  عَنْ  مُبَشِّرٍ ، مَوْلَى أَبِي الْمَلِيحِ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ         [6/326]      رَضِيَ اللهُ عَنْهُ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى صَلَاةً قَالَ : فَسَمِعْتُهُ يَقُولُ :  رَبَّ  جِبْرِيلَ  وَمِيكَائِيلَ  وَمُحَمَّدٍ  أَجِرْنِي مِنَ النَّارِ  .  لَا نَحْفَظُ بِهَذَا اللَّفْظِ إِلَّا بِهَذَا  الْإِسْنَادِ  مِنْ هَذَا الْوَجْهِ ،  وَيَحْيَى بْنُ أَبِي زَكَرِيَّا  لَيْسَ بِهِ بَأْسٌ  قَدْ رَوَى عَنْهُ النَّاسُ ،  وَعَبَّادُ بْنُ سَعِيدٍ  وَمُبَشِّرٌ  قَدْ حُدِّثَ عَنْهُمْ  .","","Musnad al-Bazzar 2336","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن مبشر بن أبي المليح الهذلي عن عباد بن سعيد البصري عن يحيى بن أبي زكريا الغساني عن عبد الوهاب بن عيسى الواسطي عن محمد بن موسى بن عمران المنقري عن البزار","حديث أبي المليح عن أبيه"
"2344","[6/327]      2337  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْعَوَّامِ قَالَ :  أَخْبَرَنَا  إِبْرَاهِيمُ بْنُ سُلَيْمَانَ الدَّبَّاسُ قَالَ :  أَخْبَرَنَا  أَبُو سَعِيدٍ ،  عَنْ  مُهَاجِرٍ أَبِي حَبِيبٍ  ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  رَضِيَ اللهُ عَنْهُ ،  أَنَّ  رَجُلًا  قَالَ : يَا رَسُولَ اللهِ ، إِنِّي لَأَدْخُلُ الصَّلَاةَ فَمَا أَدْرِي عَلَى  شَفْعٍ  أَنْفَتِلُ ، أَمْ عَلَى  وِتْرٍ  لِسُوءِ حِفْظِي ؟ فَقَالَ :  إِذَا وَجَدْتَ ذَلِكَ فَضَعْ إِصْبَعَكَ السَّبَّابَةَ عَلَى فَخِذِكَ الْيُسْرَى فَإِنَّهَا مِنَ الشَّيْطَانِ  .         [6/328]      لَا نَعْلَمُ يُرْوَى عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .  وَأَبُو سَعِيدٍ هُوَ الْحَسَنُ بْنُ دِينَارٍ  ،  وَمُهَاجِرٌ أَبُو حَبِيبٍ بَصْرِيٌّ  ،  وَلَيْسَا بِالْقَوِيَّيْنِ فِي الْحَدِيثِ  ، وَلَكِنْ ذَكَرْنَا هَذَا ؛ لِأَنَّا لَمْ نَحْفَظْهُ إِلَّا مِنْ هَذَا الْوَجْهِ .  نص عليه المصنف بعد الحديث وقال : مهاجر بن أبي حبيب بصري ، وقال محقق طبعة مكتبة العلوم والحكم: هكذا في الأصل وهو : (مهاجر بن المنيب) وأعاد الذهبي ترجمته ، وقال لا يعرف ، وعلق عليه ابن حجر بأنه هو ابن المنيب ، وذكر الدولابي كنيته أبو المنيب .","","Musnad al-Bazzar 2337","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن مهاجر بن أبي المنيب عن الحسن بن دينار التميمي عن إبراهيم بن سليمان الدباس عن محمد بن صالح بن العوام عن البزار","حديث أبي المليح عن أبيه"
"2345","2338  -  أَخْبَرَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَزِيعٍ قَالَ :  أَخْبَرَنَا  عَبْدُ الرَّحْمَنِ بْنُ عُثْمَانَ الْبَكْرَاوِيُّ قَالَ :  أَخْبَرَنَا  الصَّلْتُ بْنُ دِينَارٍ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  رَضِيَ اللهُ عَنْهُ قَالَ : ""  نَزَلَتِ الْمَلَائِكَةُ  يَوْمَ بَدْرٍ  عَلَى سِيمَاءِ  الزُّبَيْرِ  عَلَيْهَا عَمَائِمُ صُفْرٌ  "" .  وَهَذَا الْكَلَامُ قَدْ رُوِيَ عَنْ غَيْرِ  أُسَامَةَ بْنِ عُمَيْرٍ  ، فَذَكَرْنَاهُ عَنْ  أُسَامَةَ بْنِ عُمَيْرٍ  إِذْ كَانَ لَا يُرْوَى عَنْ  أُسَامَةَ  إِلَّا مِنْ هَذَا الطَّرِيقِ ، وَإِنْ كَانَ  الصَّلْتُ  لَيِّنَ الْحَدِيثِ  بَصْرِيٌّ ، وَإِنَّمَا أَدْخَلْنَاهُ فِي  الْمُسْنَدِ  وَإِنْ لَمْ يُذْكَرْ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِأَنَّهُ كَانَ فُعِلَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2338","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن الصلت بن دينار الهنائي عن أبو بحر البكراوي عن محمد بن عبد الله بن بزيع البصري عن البزار","حديث أبي المليح عن أبيه"
"2346","[6/329]      2339  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ بْنِ هَيَّاجٍ قَالَ :  أَخْبَرَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى قَالَ :  أَخْبَرَنَا  الْمِنْهَالُ بْنُ خَلِيفَةَ ،  عَنْ  سَلَمَةَ بْنِ تَمَّامٍ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  أَبِيهِ  ، ""  أَنَّ امْرَأَةً رَمَتِ امْرَأَةً بِحَجَرٍ ، فَأَلْقَتْ جَنِينًا مَيِّتًا ، فَقَضَى فِيهِ النَّبِيُّ - عَلَيْهِ السَّلَامُ -  بِغُرَّةِ  عَبْدٍ أَوْ أَمَةٍ  .  وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ وُجُوهٍ وَلَا نَعْلَمُ يُرْوَى ، عَنْ  أَبِي الْمَلِيحِ  ، عَنْ أَبِيهِ إِلَّا مِنْ هَذَا الْوَجْهِ ، وَقَدْ رَوَاهُ  أَبُو الْمَلِيحِ  ، عَنْ  حَمَلِ بْنِ مَالِكِ  .  وَحَدِيثُ  أَبِي الْمَلِيحِ  ، عَنْ أَبِيهِ  إِسْنَادٌ حَسَنٌ  ؛ لِأَنَّ  الْمِنْهَالَ  مَشْهُورٌ ،  وَسَلَمَةُ بْنُ تَمَامٍ أَبُو عَبْدِ اللهِ الشَّقَرِيُّ  ، فَذَكَرْنَاهُ لِعِزَّةِ حَدِيثِ  أَبِي الْمَلِيحِ  عَنْ أَبِيهِ  .  آخِرُ الْجُزْءِ الثُّانِي وَالْعِشْرِينَ ، وَالْحَمْدُ لِلهِ كَثِيرًا ، كَمَا هُوَ أَهْلُهُ .","","Musnad al-Bazzar 2339","","أسامة بن عمير بن الأقيشر الهذلي عن أبو المليح بن أسامة الهذلي عن سلمة بن تمام الشقري عن المنهال بن خليفة العجلي عن عبيد الله بن موسى عن محمد بن عمر بن هياج الصائدي عن البزار","حديث أبي المليح عن أبيه"
"2347","[6/330]             [6/331]      مُسْنَدُ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ  رَضِيَ اللهُ عَنْهُمَا         [6/332]             [6/333]      حَدِيثُ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ  2340  -  أَخْبَرَنَا  أَبُو الْحَسَنِ مُحَمَّدُ بْنُ أَيُّوبَ بْنِ حَبِيبِ بْنِ يَحْيَى الرَّقِّيُّ قَالَ :  أَخْبَرَنَا  أَحْمَدُ بْنُ عَمْرِو بْنِ عَبْدِ الْخَالِقِ قَالَ :  أَخْبَرَنَا  نَصْرُ بْنُ عَلِيٍّ قَالَ :  أَنْبَأَنَا  عَبْدُ الْأَعْلَى بْنُ عَبْدِ الْأَعْلَى قَالَ :  أَخْبَرَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  الْمُقْسِطُونَ عَلَى مَنَابِرَ مِنْ نُورٍ يَوْمَ الْقِيَامَةِ  بَيْنَ يَدَيِ الرَّحْمَنِ عَزَّ وَجَلَّ بِمَا  أَقْسَطُوا  فِي الدُّنْيَا  .         [6/334]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا  عَبْدُ اللهِ بْنُ عَمْرٍو  .","","Musnad al-Bazzar 2340","","عبد الله بن عمرو بن العاص عن سعيد بن المسيب عن الزهري عن معمر بن راشد عن عبد الأعلى بن عبد الأعلى القرشي عن نصر بن علي بن نصر الجهضمي عن البزار","مسند عبد الله بن عمرو بن العاص"
"2348","2341  -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ ، وَمُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ  نَصْرٌ  :  أَنْبَأَنَا  عَبْدُ الْأَعْلَى ، وَقَالَ  أَبُو مُوسَى  :  أَخْبَرَنَا  عَبْدُ الْأَعْلَى قَالَ :  أَخْبَرَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، وَأَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ :  قُلْتُ لَأَصُومَنَّ النَّهَارَ ، وَلَأَقُومَنَّ اللَّيْلَ ، فَلَقِيتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" أَنْتَ الَّذِي قُلْتَ لَأَصُومَنَّ النَّهَارَ ، وَلَأَقُومَنَّ اللَّيْلَ ؟ "" قَالَ : قُلْتُ : قَدْ قُلْتُ ذَاكَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّكَ لَا تُطِيقُ ذَاكَ فَقُمْ وَنَمْ ، وَصُمْ وَأَفْطِرْ ، صُمْ مِنْ كُلِّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ  ، فَذَلِكَ مِثْلُ صِيَامِ الدَّهْرِ "" ، قَالَ : قُلْتُ : إِنِّي أُطِيقُ أَفْضَلَ مِنْ ذَلِكَ قَالَ : "" صُمْ يَوْمًا وَأَفْطِرْ يَوْمَيْنِ "" ، قُلْتُ : إِنِّي أُطِيقُ أَفْضَلَ مِنْ ذَلِكَ ، قَالَ : "" صُمْ يَوْمًا وَأَفْطِرْ يَوْمًا ، وَذَلِكَ أَعْدَلُ الصِّيَامِ ، وَهُوَ صَوْمُ  دَاوُدَ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" ، قُلْتُ : إِنِّي أُطِيقُ أَفْضَلَ مِنْ ذَلِكَ قَالَ : "" لَا أَفْضَلَ مِنْ ذَلِكَ  .         [6/335]","","Musnad al-Bazzar 2341","","عبد الله بن عمرو بن العاص عن سعيد بن المسيب عن الزهري عن معمر بن راشد عن عبد الأعلى بن عبد الأعلى القرشي عن نصر بن علي بن نصر الجهضمي عن البزار","مسند عبد الله بن عمرو بن العاص"
"2349","2342  -  وَحَدَّثَنَاهُ  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ قَالَ :  أَنْبَأَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .","","Musnad al-Bazzar 2342","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن حماد بن سلمة عن عبد الواحد بن غياث عن البزار","مسند عبد الله بن عمرو بن العاص"
"2350","2343  -  وَأَخْبَرَنَاهُ  خَالِدُ بْنُ يُوسُفَ قَالَ :  أَخْبَرَنَا  أَبُو عَوَانَةَ ،  عَنْ  عُمَرَ بْنِ         [6/336]      أَبِي سَلَمَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو .","","Musnad al-Bazzar 2343","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن عمر بن أبي سلمة الزهري عن الوضاح بن عبد الله اليشكري عن خالد بن يوسف بن خالد السمتي عن البزار","مسند عبد الله بن عمرو بن العاص"
"2351","2344  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ قَالَ :  أَخْبَرَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى قَالَ :  أَخْبَرَنَا  شَيْبَانُ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  صُمْ وَأَفْطِرْ ، وَنَمْ وَقُمْ ، صُمْ مِنْ كُلِّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ  ، قُلْتُ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : "" صُمْ يَوْمًا وَأَفْطِرْ يَوْمًا ، صُمْ صَوْمَ  دَاوُدَ  .","","Musnad al-Bazzar 2344","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","مسند عبد الله بن عمرو بن العاص"
"2352","[6/337]      2345  -  وَأَخْبَرَنَاهُ  يُوسُفُ بْنُ مُوسَى قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ قَالَ :  أَخْبَرَنَا  حُصَيْنُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ :  كُنْتُ رَجُلًا مُجْتَهِدًا فَتَزَوَّجْتُ فَجَاءَ أَبِي إِلَى  الْمَرْأَةِ  فَقَالَ لَهَا : كَيْفَ تَجِدِي  بَعْلَكِ  ؟ فَقَالَتْ : نِعْمَ الرَّجُلُ مِنْ رَجُلٍ ، مَا يَنَامُ وَمَا يُفْطِرُ ،  فَوَقَعَ  بَيْنِي وَبَيْنَ أَبِي ، فَقَالَ : زَوَّجْتُكَ امْرَأَةً مِنَ الْمُسْلِمِينَ فَفَعَلْتَ بِهَا مَا فَعَلْتَ ؟ فَلَمْ  أُبَالِ  مَا قَالَ ، لِمَا أَجِدُ مِنَ الْقُوَّةِ إِلَى أَنْ بَلَغَ ذَلِكَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  لَكِنِّي أَنَامُ وَأُصَلِّي وَأَصُومُ وَأُفْطِرُ ، فَصُمْ وَصَلِّ وَنَمْ وَقُمْ  ، صُمْ مِنْ كُلِّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ "" قُلْتُ : إِنِّي أَقْوَى مِنْ ذَلِكَ قَالَ : "" فَصُمْ صَوْمَ  دَاوُدَ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، صُمْ يَوْمًا وَأَفْطِرْ يَوْمًا ، وَاقْرَأِ الْقُرْآنَ فِي كُلِّ شَهْرٍ "" فَقُلْتُ : يَا رَسُولَ اللهِ ، أَنَا أَقْوَى مِنْ ذَلِكَ ، قَالَ : "" اقْرَأْهُ فِي خَمْسَ عَشْرَةَ "" ، فَقُلْتُ : يَا رَسُولَ اللهِ ، أَنَا أَقْوَى مِنْ ذَلِكَ ، فَمَا زَالَ حَتَّى بَلَغَ سَبْعًا ، ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ لِكُلِّ عَمَلٍ  شِرَّةً  ،         [6/338]      وَلِكُلِّ  شِرَّةٍ  فَتْرَةً  ، فَمَنْ كَانَتْ فَتْرَتُهُ إِلَى سُنَّتِي فَقَدِ اهْتَدَى ، وَمَنْ كَانَتْ فَتْرَتُهُ إِلَى غَيْرِ ذَلِكَ فَقَدْ هَلَكَ ""  فَقَالَ  عَبْدُ اللهِ بْنُ عَمْرٍو : لَمَّا كَبِرَ وَضَعُفَ :  لَأَنْ أَكُونَ قَبِلْتُ رُخْصَةَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحَبُّ إِلَيَّ مِنْ أَهْلِي وَمَالِي  .","","Musnad al-Bazzar 2345","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن حصين بن عبد الرحمن السلمي عن محمد بن فضيل بن غزوان عن يوسف بن موسى بن راشد عن البزار","مسند عبد الله بن عمرو بن العاص"
"2353","2346  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَرَفَةَ قَالَ :  أَخْبَرَنَا  هُشَيْمٌ ،  عَنْ  حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ ، وَالْمُغِيرَةِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ :  زَوَّجَنِي أَبِي  امْرَأَةً مِنْ قُرَيْشٍ  فَلَمَّا دَخَلَتْ عَلَيَّ ،  أَحْسَبُهُ قَالَ : لَا أَلْتَفِتُ إِلَيْهَا ، أَوْ لَا أَعْبَأُ بِهَا  مِمَّا لِي مِنَ الْعِبَادَةِ مِنَ الصَّوْمِ وَالصَّلَاةِ ، فَدَخَلَ  عَمْرُو بْنُ الْعَاصِ  عَلَيْهَا ، فَقَالَ لَهَا : كَيْفَ وَجَدْتِ  بَعْلَكِ  ؟ قَالَتْ : كَخَيْرِ الرِّجَالِ وَكَخَيْرِ  الْبُعُولَةِ  مِنْ رَجُلٍ ، لَمْ         [6/339]      يَكْشِفْ لَنَا  كَنَفًا  ، وَلَمْ يَقْرَبْ لَنَا فِرَاشًا ، فَأَقْبَلَ عَلَيَّ فَعَضَّنِي بِلِسَانِهِ ، وَقَالَ : أَنْكَحْتُكَ امْرَأَةً ذَاتَ  حَسَبٍ  فَفَعَلْتَ وَفَعَلْتَ ، ثُمَّ انْطَلَقَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَشَكَانِي إِلَيْهِ ، قَالَ : فَأَرْسَلَ إِلَيَّ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ لِي : "" أَتَصُومُ النَّهَارَ ؟ "" قُلْتُ : نَعَمْ ، قَالَ : "" وَتَقُومُ اللَّيْلَ ؟ "" قُلْتُ : نَعَمْ ، قَالَ :  فَإِنِّي أَصُومُ وَأُفْطِرُ وَأُصَلِّي وَأَنَامُ  ثُمَّ قَالَ لِيَ : "" اقْرَأِ الْقُرْآنَ فِي شَهْرٍ "" ، قَالَ قُلْتُ : إِنِّي أَجِدُنِي أَقْوَى مِنْ ذَلِكَ قَالَ : "" فَاقْرَأْهُ فِي خَمْسَ عَشْرَةَ "" قُلْتُ : إِنِّي أَجِدُنِي أَقْوَى مِنْ ذَلِكَ  قَالَ أَحَدُهُمَا إِمَّا  حُصَيْنٌ  وَإِمَّا  مُغِيرَةُ  قَالَ : "" فَاقْرَأْهُ فِي كُلِّ ثَلَاثٍ ، ثُمَّ قَالَ : "" وَصُمْ مِنْ كُلِّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ "" قُلْتُ : إِنِّي أَقْوَى مِنْ ذَلِكَ قَالَ : فَلَمْ يَزَلْ بِي حَتَّى قَالَ : "" صُمْ يَوْمًا وَأَفْطِرْ يَوْمًا فَذَلِكَ أَفْضَلُ الصِّيَامِ وَهُوَ صَوْمُ  دَاوُدَ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  قَالَ  هُشَيْمٌ  : قَالَ  حُصَيْنُ بْنُ عَبْدِ الرَّحْمَنِ  فِي حَدِيثِهِ : ثُمَّ قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  إِنَّ لِكُلِّ عَمَلٍ  شِرَّةً  وَلِكُلِّ  شِرَّةٍ  فَتْرَةً  ، فَإِمَّا إِلَى سُنَّةٍ ، وَإِمَّا إِلَى بِدْعَةٍ ، فَمَنْ كَانَتْ فَتْرَتُهُ إِلَى سُنَّتِي فَقَدِ اهْتَدَى ، وَمَنْ كَانَتْ فَتْرَتُهُ إِلَى غَيْرِ ذَلِكَ فَقَدْ هَلَكَ  "" .         [6/340]","","Musnad al-Bazzar 2346","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن الحسن بن عرفة العبدي عن البزار","مسند عبد الله بن عمرو بن العاص"
"2354","2347  -  وَأَخْبَرَنَاهُ  مُحَمَّدُ بْنُ الْوَلِيدِ قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ قَالَ :  أَخْبَرَنَا  شُعْبَةُ ،  عَنْ  حُصَيْنٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِ حَدِيثِ  حُصَيْنٍ  .","","Musnad al-Bazzar 2347","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن حصين بن عبد الرحمن السلمي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن الوليد البسري عن البزار","مسند عبد الله بن عمرو بن العاص"
"2355","2348  -  حَدَّثَنَا  بِشْرُ بْنُ خَالِدٍ الْعَسْكَرِيُّ قَالَ :  أَخْبَرَنَا  يَعْمَرُ بْنُ بِشْرٍ قَالَ :  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  شُعْبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2348","","عبد الله بن عمرو بن العاص عن سعيد بن المسيب عن قتادة بن دعامة عن شعبة بن الحجاج عن عبد الله بن المبارك عن يعمر بن بشر الخراساني عن بشر بن خالد الفرائضي عن البزار","مسند عبد الله بن عمرو بن العاص"
"2356","2349  -  وَأَخْبَرَنَاهُ  عَمْرُو بْنُ عَلِيٍّ قَالَ :  أَخْبَرَنَا  دَاوُدُ  قَالَ :  أَخْبَرَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  لَا يَنْظُرُ اللهُ تَبَارَكَ وَتَعَالَى إِلَى امْرَأَةٍ لَا تَشْكُرُ لِزَوْجِهَا وَهِيَ لَا تَسْتَغْنِي عَنْهُ  .         [6/341]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  عَبْدُ اللهِ بْنُ عَمْرٍو  ، وَلَا نَعْلَمُ أَحَدًا  أَسْنَدَهُ  عَنْ  شُعْبَةَ  إِلَّا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ  .  كذا في طبعة مكتبة العلوم والحكم ، والذي في كشف الأستار : ( أبو داود ) وهو الطيالسي وهو أقرب للصواب ؛ فعمرو بن علي لم نقف له على رواية عن داود بن المحبر أو داود بن شبيب . والله أعلم","","Musnad al-Bazzar 2349","","عبد الله بن عمرو بن العاص عن سعيد بن المسيب عن قتادة بن دعامة عن همام بن يحيى بن دينار عن أبو داود الطيالسي عن الفلاس عن البزار","مسند عبد الله بن عمرو بن العاص"
"2357","2350  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ قَالَ :  أَخْبَرَنَا  ابْنُ أَبِي عَدِيٍّ قَالَ :  أَخْبَرَنَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دَخَلَ عَلَى  جُوَيْرِيَةَ  فِي يَوْمِ جُمُعَةٍ وَهِيَ صَائِمَةٌ ، فَقَالَ لَهَا :  أَصُمْتِ أَمْسِ ؟ "" قَالَتْ : لَا ، قَالَ : "" فَتَصُومِينَ غَدًا ؟ "" قَالَتْ : لَا ، قَالَ : "" فَأَفْطِرِي  .         [6/342]      وَهَذَا الْحَدِيثُ خَالَفَ فِيهِ  سَعِيدٌ  شُعْبَةَ  ، فَقَالَ  شُعْبَةُ  : حَدَّثَنَاهُ  قَتَادَةُ  ، عَنْ  أَبِي أَيُّوبَ  ، عَنْ  جُوَيْرِيَةَ  ، وَقَالَ  سَعِيدٌ  : أَمَّا         [6/343]      مَا حَفِظْتُ أَنَا  وَمَطَرٌ  ، فَعَنْ  قَتَادَةَ  ، عَنِ  ابْنِ الْمُسَيِّبِ  ، عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad al-Bazzar 2350","","عبد الله بن عمرو بن العاص عن سعيد بن المسيب عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن إبراهيم بن أبي عدي القسملي عن الفلاس عن البزار","مسند عبد الله بن عمرو بن العاص"
"2358","[6/344]      2351  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْوَلِيدِ قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ جَهْضَمٍ قَالَ :  أَخْبَرَنَا  سُفْيَانُ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَنْبَغِي لِأَحَدٍ أَنْ يَقُولَ أَنَا خَيْرٌ مِنْ  يَحْيَى بْنِ زَكَرِيَّا  ، مَا هَمَّ بِخَطِيئَةٍ -  أَحْسَبُهُ قَالَ - وَلَا عَمِلَهَا  .  في طبعة مكتبة العلوم والحكم : ( عملهما ) ، والصواب المثبت وينظر كشف الأستار ومجمع الزوائد","","Musnad al-Bazzar 2351","","عبد الله بن عمرو بن العاص عن سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن سفيان بن عيينة عن محمد بن جهضم اليمامي عن محمد بن الوليد الفحام عن البزار","مسند عبد الله بن عمرو بن العاص"
"2359","2352  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ سَعِيدٍ قَالَ :  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ قَالَ :  أَخْبَرَنَا  عُثْمَانُ بْنُ حَكِيمٍ ،  عَنْ  أَبِي أُمَامَةَ بْنِ سَهْلِ بْنِ حُنَيْفٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ :  كُنْتُ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَبَيْنَا نَحْنُ عِنْدَهُ إِذْ قَالَ :  لَيَدْخُلَنَّ عَلَيْكُمْ رَجُلٌ لَعِينٌ  ، وَكُنْتُ تَرَكْتُ  عَمْرَو بْنَ الْعَاصِ  يَلْبَسُ ثِيَابَهُ لِيَلْحَقَنِي ، فَمَا زِلْتُ أَنْظُرُ وَأَخَافُ ، حَتَّى دَخَلَ  الْحَكَمُ بْنُ أَبِي الْعَاصِ  .         [6/345]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2352","","عبد الله بن عمرو بن العاص عن أسعد بن سهل بن حنيف عن عثمان بن حكيم الأحلافي عن عبد الله بن نمير عن أحمد بن محمد بن يحيى القطان عن البزار","مسند عبد الله بن عمرو بن العاص"
"2360","2353  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ قَالَ :  أَخْبَرَنَا  عَفَّانُ ، قَالَ :  أَخْبَرَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ قَالَ :  أَخْبَرَنَا  عُثْمَانُ بْنُ حَكِيمٍ قَالَ :  سَمِعْتُ  أَبَا أُمَامَةَ بْنَ سَهْلِ بْنِ حُنَيْفٍ يَقُولُ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو ، يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  لَا تَقُومُ السَّاعَةُ حَتَّى تَتَسَافَدُوا فِي الطُّرُقِ تَسَافُدَ الْحَمِيرِ  .","","Musnad al-Bazzar 2353","","عبد الله بن عمرو بن العاص عن أسعد بن سهل بن حنيف عن عثمان بن حكيم الأحلافي عن عبد الواحد بن زياد عن عفان بن مسلم الصفار عن محمد بن عبد الرحيم  صاعقة عن البزار","مسند عبد الله بن عمرو بن العاص"
"2361","2354  -  وَأَخْبَرَنَاهُ  الْفَهْمُ بْنُ عَبْدِ الرَّحْمَنِ قَالَ :  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ قَالَ :  أَخْبَرَنَا  عُثْمَانُ بْنُ حَكِيمٍ ،  عَنْ  أَبِي أُمَامَةَ بْنِ سَهْلِ بْنِ حُنَيْفٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، مِثْلَهُ ،  وَلَمْ يَرْفَعْهُ  إِلَّا أَنَّهُ قَالَ : ""  لَا تَقُومُ السَّاعَةُ حَتَّى يَتَسَافَدَ النَّاسُ فِي الطُّرُقِ تَسَافُدَ الْحَمِيرِ  "" .         [6/346]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى مِنْ وَجْهٍ صَحِيحٍ إِلَّا عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2354","","عبد الله بن عمرو بن العاص عن أسعد بن سهل بن حنيف عن عثمان بن حكيم الأحلافي عن عبد الله بن نمير عن الفهم بن عبد الرحمن عن البزار","مسند عبد الله بن عمرو بن العاص"
"2362","2355  -  حَدَّثَنَا  الْقَاسِمُ بْنُ بِشْرِ بْنِ مَعْرُوفٍ قَالَ :  أَخْبَرَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ قَالَ :  أَخْبَرَنَا  زُهَيْرُ بْنُ مُحَمَّدٍ ،  عَنْ  مُوسَى بْنِ جُبَيْرٍ ،  عَنْ  أَبِي أُمَامَةَ بْنِ سَهْلِ بْنِ حُنَيْفٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  اتْرُكُوا الْحَبَشَةَ مَا تَرَكُوكُمْ  ، فَإِنَّهُ لَا يَسْتَخْرِجُ كَنْزَ  الْكَعْبَةِ  ، إِلَّا  ذُو السُّوَيْقَتَيْنِ  مِنَ  الْحَبَشَةَ  .         [6/347]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  بِهَذَا  الْإِسْنَادِ  ، وَلَا نَعْلَمُ أَحَدًا قَالَ عَنْ  أَبِي أُمَامَةَ  ، عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  إِلَّا  الْقَاسِمُ بْنُ بِشْرٍ  ، عَنْ  أَبِي عَامِرٍ  ، وَقَالَ غَيْرُهُ ، عَنْ  أَبِي أُمَامَةَ  ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad al-Bazzar 2355","","عبد الله بن عمرو بن العاص عن أسعد بن سهل بن حنيف عن موسى بن جبير الأنصاري عن زهير بن محمد التميمي عن أبو عامر العقدي عن القاسم بن أحمد بن بشر البغدادي عن البزار","مسند عبد الله بن عمرو بن العاص"
"2363","2356  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ، وَيُوسُفُ بْنُ مُوسَى ، وَاللَّفْظُ  لِيُوسُفَ  قَالَا :  أَخْبَرَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى قَالَ :  أَخْبَرَنَا  شَيْبَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ : ""  كَسَفَتِ الشَّمْسُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَنُودِيَ أَنِ الصَّلَاةُ جَامِعَةٌ فَرَكَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَكْعَتَيْنِ فِي سَجْدَةٍ  ، ثُمَّ قَامَ فَرَكَعَ رَكْعَتَيْنِ فِي سَجْدَةٍ -  يَعْنِي سَجَدَ فِي كُلِّ رَكْعَتَيْنِ مَرَّةً  - ثُمَّ  تَجَلَّتِ  الشَّمْسُ "" ، قَالَتْ  عَائِشَةُ  : مَا سَجَدْتُ سُجُودًا قَطُّ ، وَلَا رَكَعْتُ رُكُوعًا قَطُّ أَطْوَلَ مِنْهُ  .","","Musnad al-Bazzar 2356","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","مسند عبد الله بن عمرو بن العاص"
"2364","[6/348]      2357  -  حَدَّثَنَا  عُمَرُ بْنُ الْخَطَّابِ قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  يُلْحِدُ رَجُلٌ  بِمَكَّةَ  يُقَالُ لَهُ  عَبْدُ اللهِ  عَلَيْهِ نِصْفُ عَذَابِ الْعَالَمِ  .  وَهَذَا الْحَدِيثُ قَدِ اخْتُلِفَ فِيهِ ، عَنِ  الْأَوْزَاعِيِّ  ، فَقَالَ  مُحَمَّدُ بْنُ كَثِيرٍ  ، عَنِ  الْأَوْزَاعِيِّ  ، عَنْ  يَحْيَى  ، عَنْ  أَبِي سَلَمَةَ  ، عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  ، وَلَمْ يُتَابَعْ عَلَى هَذَا  الْإِسْنَادِ  ، وَقَالَ غَيْرُهُ ، عَنِ  الْأَوْزَاعِيِّ  ، عَنْ  مُحَمَّدٍ  رَجُلٍ مِنْ  آلِ الْمُغِيرَةِ بْنِ شُعْبَةَ  ، عَنِ  الْمُغِيرَةِ بْنِ         [6/349]      شُعْبَةَ  عَنْ  عُثْمَانَ بْنِ عَفَّانَ  .","","Musnad al-Bazzar 2357","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن محمد بن كثير بن أبي عطاء عن عمر بن الخطاب السجستاني عن البزار","مسند عبد الله بن عمرو بن العاص"
"2365","2358  -  حَدَّثَنَا  عُمَرُ بْنُ الْخَطَّابِ قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ كَثِيرٍ الْمِصِّيصِيُّ قَالَ :  أَخْبَرَنَا  الْأَوْزَاعِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَكُنْ مِثْلَ فُلَانٍ كَانَ يَقُومُ اللَّيْلَ فَتَرَكَ قِيَامَ اللَّيْلِ  .         [6/350]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  عَبْدُ اللهِ بْنُ عَمْرٍو  ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  يَحْيَى  إِلَّا  الْأَوْزَاعِيُّ  .","","Musnad al-Bazzar 2358","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن محمد بن كثير بن أبي عطاء عن عمر بن الخطاب السجستاني عن البزار","مسند عبد الله بن عمرو بن العاص"
"2366","2359  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  أَخْبَرَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى قَالَ :         [6/351]      أَخْبَرَنَا  شَيْبَانُ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ، وَمُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اقْرَأِ الْقُرْآنَ فِي شَهْرٍ  .","","Musnad al-Bazzar 2359","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن يوسف بن موسى بن راشد عن البزار","مسند عبد الله بن عمرو بن العاص"
"2367","2360  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الصَّبَّاحِ الْعَطَّارُ قَالَ :  أَخْبَرَنَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، وَمِرْدَاسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأَى  رَجُلًا  يُصَلِّي رَكْعَتَيِ الْفَجْرِ ، وَقَدْ أُقِيمَتِ الصَّلَاةُ ، صَلَاةُ الْفَجْرِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الصُّبْحُ أَرْبَعًا  ؟ ""  .         [6/352]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى ، عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  مُحَمَّدِ بْنِ عَمْرٍو  إِلَّا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ  .","","Musnad al-Bazzar 2360","","عبد الله بن عمرو بن العاص عن مرداس بن عبد الرحمن الجندعي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن معتمر بن سليمان عن عبد الله بن الصباح المربدي عن البزار","مسند عبد الله بن عمرو بن العاص"
"2368","2361  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  أَخْبَرَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  مَنْصُورٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنْ  أَبِي يَحْيَى ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، أَنَّهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  صَلَاةُ الْقَاعِدِ عَلَى النِّصْفِ مِنْ صَلَاةِ الْقَائِمِ  قَالَ : فَأَتَيْتُهُ فَوَجَدْتُهُ يُصَلِّي جَالِسًا ، فَقَالَ : "" مَا لَكَ يَا  عَبْدَ اللهِ بْنَ عَمْرٍو  ؟ "" قُلْتُ : حَدَّثْتَنَا أَنَّ صَلَاةَ الرَّجُلِ قَاعِدًا نِصْفُ الصَّلَاةِ ، وَأَنْتَ تُصَلِّي قَاعِدًا ؟ قَالَ : "" نَعَمْ ، وَلَكِنِّي لَسْتُ كَأَحَدٍ مِنْكُمْ  .","","Musnad al-Bazzar 2361","","عبد الله بن عمرو بن العاص عن مصدع المعرقب عن هلال بن يساف الأشجعي عن منصور بن المعتمر عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","مسند عبد الله بن عمرو بن العاص"
"2369","[6/353]      2362  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  أَخْبَرَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنْ  أَبِي يَحْيَى ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ         [6/354]      اللهُ عَنْهُمَا قَالَ :  رَجَعْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ  مَكَّةَ  إِلَى  الْمَدِينَةِ  حَتَّى إِذَا كُنَّا بِالطَّرِيقِ انْتَهَيْنَا إِلَى قَوْمٍ قَدْ تَوَضَّؤُوا وَأَقْدَامُهُمْ بِيضٌ تَلُوحُ لَمْ يَمَسَّهَا الْمَاءُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَسْبِغُوا الْوُضُوءَ ، وَيْلٌ  لِلْأَعْقَابِ  مِنَ النَّارِ  .","","Musnad al-Bazzar 2362","","عبد الله بن عمرو بن العاص عن مصدع المعرقب عن هلال بن يساف الأشجعي عن منصور بن المعتمر عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","مسند عبد الله بن عمرو بن العاص"
"2370","[6/355]      2363  -  وَأَخْبَرَنَاهُ  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ قَالَ :  أَخْبَرَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  يُوسُفَ بْنِ مَاهَكَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ : ""  وَيْلٌ  لِلْأَعْقَابِ  مِنَ النَّارِ  .","","Musnad al-Bazzar 2363","","عبد الله بن عمرو بن العاص عن يوسف بن ماهك الفارسي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","مسند عبد الله بن عمرو بن العاص"
"2371","[6/356]      2364  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  أَخْبَرَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَمْرِو بْنِ أَوْسٍ ،  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا يَقُولُ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَحَبُّ الصِّيَامِ إِلَى اللهِ عَزَّ وَجَلَّ صِيَامُ  دَاوُدَ  كَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا  ، وَأَحَبُّ الصَّلَاةِ إِلَى اللهِ عَزَّ وَجَلَّ صَلَاةُ  دَاوُدَ  كَانَ يَنَامُ نِصْفَ اللَّيْلِ وَيَقُومُ ثُلُثَهُ ، وَيَنَامُ سُدُسَهُ  .         [6/357]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2364","","عبد الله بن عمرو بن العاص عن عمرو بن أوس بن أبي أوس الثقفي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن يوسف بن موسى بن راشد عن البزار","مسند عبد الله بن عمرو بن العاص"
"2372","2365  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ قَالَ :  أَخْبَرَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ قَالَ :  أَخْبَرَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  مُطَرِّفِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ :  صَلَّيْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ لَيْلَةٍ ، فَرَجَعَ مَنْ رَجَعَ ، وَعَقَّبَ مَنْ عَقَّبَ ، فَجَاءَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَبْلَ أَنْ  يُثَوِّبَ  النَّاسُ بِصَلَاةِ الْعِشَاءِ ، فَقَالَ :  أَبْشِرُوا أَبْشِرُوا هَذَا رَبُّكُمْ تَبَارَكَ وَتَعَالَى قَدْ فَتَحَ بَابًا مِنْ أَبْوَابِ السَّمَاءِ  يُبَاهِي  بِكُمُ الْمَلَائِكَةَ  يَقُولُ : انْظُرُوا إِلَى عِبَادِي قَضَوْا فَرِيضَةً وَهُمْ يَنْتَظِرُونَ أُخْرَى  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى إِلَّا عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  رَضِيَ اللهُ عَنْهُ ، وَلَا نَعْلَمُ لَهُ طَرِيقًا ، عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  إِلَّا هَذَا الطَّرِيقَ  .","","Musnad al-Bazzar 2365","","عبد الله بن عمرو بن العاص عن مطرف بن عبد الله بن الشخير الحرشي عن علي بن زيد بن جدعان عن حماد بن سلمة عن عبد الرحمن بن مهدي عن الفلاس عن البزار","مسند عبد الله بن عمرو بن العاص"
"2373","2366  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  أَخْبَرَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .         [6/358]","","Musnad al-Bazzar 2366","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","مسند عبد الله بن عمرو بن العاص"
"2374","2367  -  وَأَخْبَرَنَاهُ  مُحَمَّدُ بْنُ بَشَّارٍ قَالَ :  أَخْبَرَنَا  أَبُو عَامِرٍ عَبْدُ الْمَلِكِ بْنُ عَمْرٍو قَالَ :  أَخْبَرَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ : ""  اسْتَقِيمُوا وَلَنْ  تُحْصُوا ،  وَاعْلَمُوا أَنَّ خَيْرَ أَعْمَالِكُمُ الصَّلَاةُ ،  وَلَا يُحَافِظُ عَلَى الْوُضُوءِ إِلَّا مُؤْمِنٌ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2367","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن إبراهيم بن طهمان عن أبو عامر العقدي عن محمد بن بشار بندار عن البزار","مسند عبد الله بن عمرو بن العاص"
"2375","2368  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، وَمُحَمَّدُ بْنُ خَلَفٍ قَالَا :  أَخْبَرَنَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  تَقْتُلُ  عَمَّارًا  الْفِئَةُ  الْبَاغِيَةُ  .","","Musnad al-Bazzar 2368","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن معتمر بن سليمان عن محمد بن خلف عن البزار","مسند عبد الله بن عمرو بن العاص"
"2376","2369  -  حَدَّثَنَا  عَبَّادُ بْنُ يَعْقُوبَ الْكُوفِيُّ قَالَ :  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ         [6/359]      عَبْدِ الْقُدُّوسِ ،  عَنْ  يُونُسَ بْنِ خَبَّابٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2369","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن يونس بن خباب الأسيدي عن عبد الله بن عبد القدوس الرازي عن عباد بن يعقوب الرواجني عن البزار","مسند عبد الله بن عمرو بن العاص"
"2377","2370  -  وَأَخْبَرَنَا  عَبَّادُ بْنُ يَعْقُوبَ قَالَ :  أَخْبَرَنَا  أَبُو يَحْيَى التَّيْمِيُّ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  يُوشِكُ  أَنْ يَمْلَأَ اللهُ أَيْدِيَكُمْ مِنَ  الْعَجَمِ  ، ثُمَّ يَجْعَلَهُمْ أُسْدًا لَا يَفِرُّونَ ، يُقَاتِلُونَ مُقَاتِلِيكُمْ وَيَأْكُلُونَ فَيْئَكُمْ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2370","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن يحيى بن يعلى بن حرملة التيمي عن عباد بن يعقوب الرواجني عن البزار","مسند عبد الله بن عمرو بن العاص"
"2378","2371  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  أَخْبَرَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ ،         [6/360]      قَالَ :  أَخْبَرَنَا  الْحَسَنُ بْنُ عَمْرٍو ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  لَيْسَ الْوَاصِلُ بِالْمُكَافِئِ  ، وَلَكِنَّ الْوَاصِلَ الَّذِي إِذَا انْقَطَعَتْ رَحِمُهُ وَصَلَهَا  .","","Musnad al-Bazzar 2371","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن الحسن بن عمرو الفقيمي عن عبد الرحمن بن مغراء الدوسي عن يوسف بن موسى بن راشد عن البزار","مسند عبد الله بن عمرو بن العاص"
"2379","2372  -  وَأَخْبَرَنَاهُ  أَحْمَدُ بْنُ عَبْدَةَ قَالَ :  أَخْبَرَنَا  عُمَرُ بْنُ عَلِيٍّ قَالَ :  أَخْبَرَنَا  فِطْرٌ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  لَيْسَ الْوَاصِلُ بِالْمُكَافِئِ  ، وَلَكِنَّ الْوَاصِلَ مَنْ إِذَا انْقَطَعَتْ رَحِمُهُ وَصَلَهَا  .         [6/361]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 2372","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن فطر بن خليفة عن عمر بن علي بن عطاء عن أحمد بن عبدة الضبي عن البزار","مسند عبد الله بن عمرو بن العاص"
"2380","2373  -  أَخْبَرَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  أَخْبَرَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ قَالَ :  أَخْبَرَنَا  الْحَسَنُ بْنُ عَمْرٍو ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  مَنْ قَتَلَ قَتِيلًا مِنْ أَهْلِ الذِّمَّةِ لَمْ  يَرَحْ  رَائِحَةَ الْجَنَّةِ  ، وَإِنَّ رِيحَهَا لَيُوجَدُ مِنْ  مَسِيرَةِ  أَرْبَعِينَ عَامًا  .","","Musnad al-Bazzar 2373","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن الحسن بن عمرو الفقيمي عن عبد الرحمن بن مغراء الدوسي عن يوسف بن موسى بن راشد عن البزار","مسند عبد الله بن عمرو بن العاص"
"2381","[6/362]      2374  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى أَبُو مُوسَى قَالَ :  أَخْبَرَنَا  عُبَيْدُ اللهِ بْنُ         [6/363]      عَبْدِ اللهِ الرَّبَعِيُّ قَالَ :  أَخْبَرَنَا  الْحَسَنُ بْنُ عَمْرٍو ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  إِذَا رَأَيْتُمْ أُمَّتِي تَهَابُ الظَّالِمَ  أَنْ تَقُولَ : أَنْتَ ظَالِمٌ ، فَقَدْ  تُوُدِّعَ  مِنْهُمْ  .","","Musnad al-Bazzar 2374","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن الحسن بن عمرو الفقيمي عن عبيد الله بن عبد الله الربعي عن أبو موسى الزمن عن البزار","مسند عبد الله بن عمرو بن العاص"
"2382","2375  -  وَأَخْبَرَنَاهُ  يُوسُفُ بْنُ مُوسَى قَالَ :  أَخْبَرَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِيُّ ،  عَنِ  ابْنِ عَمْرٍو الْفُقَيْمِيِّ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  إِذَا رَأَيْتُمْ أُمَّتِي تَهَابُ الظَّالِمَ  أَنْ تَقُولَ : إِنَّكَ ظَالِمٌ ، فَقَدْ  تُوُدِّعَ  مِنْهُمْ  .         [6/364]      وَهَذَا الْحَدِيثُ عَنِ  الْحَسَنِ بْنِ عَمْرٍو  ، عَنْ  أَبِي الزُّبَيْرِ  هُوَ الصَّوَابُ عِنْدِي .","","Musnad al-Bazzar 2375","","عبد الله بن عمرو بن العاص عن أبو الزبير المكي عن الحسن بن عمرو الفقيمي عن عبد الرحمن بن محمد المحاربي عن يوسف بن موسى بن راشد عن البزار","مسند عبد الله بن عمرو بن العاص"
"2383","2376  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  أَخْبَرَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ الدَّوْسِيُّ قَالَ :  أَخْبَرَنَا  الْحَسَنُ بْنُ عَمْرٍو ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ : ""  إِنَّ فِي أُمَّتِي لَخَسْفٌ وَمَسْخٌ وَقَذْفٌ  .  وَلَا نَعْلَمُ  أَسْنَدَ  أَبُو         [6/365]      الزُّبَيْرِ  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  إِلَّا هَذَيْنِ الْحَدِيثَيْنِ  .","","Musnad al-Bazzar 2376","","عبد الله بن عمرو بن العاص عن أبو الزبير المكي عن الحسن بن عمرو الفقيمي عن عبد الرحمن بن مغراء الدوسي عن يوسف بن موسى بن راشد عن البزار","مسند عبد الله بن عمرو بن العاص"
"2384","2377  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2377","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن محمد بن فضيل بن غزوان عن يوسف بن موسى بن راشد عن البزار","مسند عبد الله بن عمرو بن العاص"
"2385","2378  -  وَأَخْبَرَنَا  عَلِيُّ بْنُ سَعِيدٍ الْمَسْرُوقِيُّ قَالَ :  أَخْبَرَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  مَنْ  شَرِبَ  الْخَمْرَ فَجَعَلَهَا فِي بَطْنِهِ لَمْ تُقْبَلْ لَهُ صَلَاةٌ سَبْعًا  ، فَإِنْ مَاتَ فِيهَا مَاتَ كَافِرًا ، فَإِنْ أَذْهَبَتْ عَقْلَهُ عَنْ شَيْءٍ مِنَ الْفَرَائِضِ لَمْ تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ يَوْمًا ، فَإِنْ مَاتَ فِيهَا مَاتَ كَافِرًا  .         [6/366]","","Musnad al-Bazzar 2378","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن عبد الرحيم بن سليمان الأشل عن علي بن سعيد بن مسروق الكندي عن البزار","مسند عبد الله بن عمرو بن العاص"
"2386","2379  -  وَأَخْبَرَنَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ قَالَ :  أَخْبَرَنَا  أَبِي  قَالَ :  أَخْبَرَنَا  فِطْرُ بْنُ خَلِيفَةَ ،  عَنْ  يُونُسَ بْنِ خَبَّابٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .","","Musnad al-Bazzar 2379","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن يونس بن خباب الأسيدي عن فطر بن خليفة عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن البزار","مسند عبد الله بن عمرو بن العاص"
"2387","2380  -  وَأَخْبَرَنَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ الْأَسَدِيُّ قَالَ :  أَخْبَرَنَا  أَبِي  قَالَ :  أَخْبَرَنَا  فِطْرُ بْنُ خَلِيفَةَ ،  عَنْ  يُونُسَ بْنِ خَبَّابٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  مَنْ سَكِرَ مِنَ الْخَمْرِ لَمْ تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ يَوْمًا  ، فَإِنْ مَاتَ فِيهَا مَاتَ كَعَابِدِ  وَثَنٍ  .","","Musnad al-Bazzar 2380","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن يونس بن خباب الأسيدي عن فطر بن خليفة عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن البزار","مسند عبد الله بن عمرو بن العاص"
"2388","2381  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ جَعْفَرٍ الْبَغْدَادِيُّ قَالَ :  أَخْبَرَنَا  إِسْحَاقُ بْنُ مَنْصُورٍ قَالَ :  أَخْبَرَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي يَحْيَى الْقَتَّاتِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ : ""  مَرَّ  رَجُلٌ  عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعَلَيْهِ ثَوْبَانِ أَحْمَرَانِ  ، فَسَلَّمَ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمْ يَرُدَّ         [6/367]      عَلَيْهِ السَّلَامَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا إِلَّا هَذَا الطَّرِيقَ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  إِسْرَائِيلَ  إِلَّا  إِسْحَاقُ بْنُ مَنْصُورٍ  .","","Musnad al-Bazzar 2381","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن أبويحيى القتات عن إسرائيل بن يونس بن أبي إسحاق عن إسحاق بن منصور السلولي عن عباس بن جعفر العباسي عن البزار","مسند عبد الله بن عمرو بن العاص"
"2389","2382  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى قَالَ :  أَخْبَرَنَا  ثَابِتُ بْنُ مُحَمَّدٍ قَالَ :  أَخْبَرَنَا  فِطْرُ بْنُ خَلِيفَةَ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  شَارِبُ الْخَمْرِ كَعَابِدِ  وَثَنٍ  .  وَلَمْ يُدْخِلْ  ثَابِتُ بْنُ مُحَمَّدٍ  بَيْنَ  فِطْرٍ  وَبَيْنَ  مُجَاهِدٍ  أَحَدًا .","","Musnad al-Bazzar 2382","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن فطر بن خليفة عن ثابت بن محمد الشيباني عن يوسف بن موسى بن راشد عن البزار","مسند عبد الله بن عمرو بن العاص"
"2390","[6/368]      2383  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَزْدَادَ الْكُوفِيُّ قَالَ :  أَخْبَرَنَا  عَمْرُو بْنُ عَبْدِ الْغَفَّارِ الْفُقَيْمِيُّ قَالَ :  أَخْبَرَنَا  الْأَعْمَشُ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  مَنْ قَتَلَ  مُعَاهَدًا  لَمْ  يَرَحْ  رَائِحَةَ الْجَنَّةِ  ، وَمَنِ  ادَّعَى  إِلَى غَيْرِ أَبِيهِ -  أَحْسَبُهُ قَالَ - لَمْ  يَرَحْ  رَائِحَةَ الْجَنَّةِ  ، وَإِنَّ رِيحَهَا لَيُوجَدُ مِنْ  مَسِيرَةِ  أَرْبَعِينَ عَامًا  .","","Musnad al-Bazzar 2383","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن الأعمش عن عمرو بن عبد الغفار الفقيمي عن أحمد بن يزداد الخياط عن البزار","مسند عبد الله بن عمرو بن العاص"
"2391","[6/369]      2384  -  حَدَّثَنَا  تَمِيمُ بْنُ الْمُنْتَصِرِ قَالَ :  أَخْبَرَنَا  إِسْحَاقُ بْنُ يُوسُفَ ،  عَنْ  شَرِيكٍ قَالَ :  أَخْبَرَنَا  مُسْلِمٌ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ : ""  خَرَجْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَّا الصَّائِمُ وَمِنَّا الْمُفْطِرُ  ، فَلَمْ يَعِبِ الصَّائِمُ عَلَى الْمُفْطِرِ ، وَلَا الْمُفْطِرُ عَلَى الصَّائِمِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  إِلَّا مِنْ هَذَا الْوَجْهِ .  وَمُسْلِمٌ  الَّذِي رَوَى عَنْهُ  شَرِيكٌ  هَذَا هُوَ  مُسْلِمٌ أَبُو عَبْدِ اللهِ الْأَعْوَرُ  ، رَوَى عَنْهُ  شُعْبَةُ  ،  وَالثَّوْرِيُّ  ،  وَإِسْرَائِيلُ  وَغَيْرُهُمْ  .","","Musnad al-Bazzar 2384","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن مسلم بن كيسان البراد عن شريك بن عبد الله النخعي عن إسحاق بن يوسف الأزرق عن تميم بن المنتصر مولى ابن عباس عن البزار","مسند عبد الله بن عمرو بن العاص"
"2392","2385  -  حَدَّثَنَا  الْجَرَّاحُ بْنُ مَخْلَدٍ قَالَ :  أَخْبَرَنَا  بَكْرُ بْنُ يَحْيَى بْنِ زَبَّانَ الْعَنَزِيُّ قَالَ :  أَخْبَرَنَا  مِنْدَلُ بْنُ عَلِيٍّ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، ""  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ مَرَّةً مَرَّةً  .         [6/370]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  إِلَّا  مُجَاهِدٌ  ، وَلَا عَنْ  مُجَاهِدٍ  إِلَّا  ابْنُ أَبِي نَجِيحٍ  .","","Musnad al-Bazzar 2385","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن مندل بن علي عن بكر بن يحيى العنزي عن الجراح بن مخلد عن البزار","مسند عبد الله بن عمرو بن العاص"
"2393","2386  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ مَعْمَرٍ قَالَا :  أَخْبَرَنَا  وَهْبُ بْنُ جَرِيرٍ قَالَ :  أَخْبَرَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 2386","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن محمد بن معمر بن ربعي البحراني عن البزار","مسند عبد الله بن عمرو بن العاص"
"2394","2387  -  وَأَخْبَرَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ قَالَ :  أَخْبَرَنَا  سَعِيدُ بْنُ سُلَيْمَانَ قَالَ :  أَخْبَرَنَا  إِسْحَاقُ بْنُ يَحْيَى بْنِ طَلْحَةَ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Musnad al-Bazzar 2387","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن إسحاق بن يحيى بن طلحة التيمي عن سعيد بن سليمان سعدويه عن محمد بن عبد الرحيم  صاعقة عن البزار","مسند عبد الله بن عمرو بن العاص"
"2395","[6/371]      2388  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ قَالَ :  أَخْبَرَنَا  أَبُو قُتَيْبَةَ قَالَ :  أَخْبَرَنَا  بَشِيرٌ أَبُو إِسْمَاعِيلَ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  مَازَالَ  جِبْرِيلُ  يُوصِينِي بِالْجَارِ حَتَّى ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُ  .         [6/372]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  مُجَاهِدٍ  إِلَّا  بَشِيرٌ  .  وَقَدِ اخْتَلَفُوا عَنْ  مُجَاهِدٍ  فِي هَذَا الْحَدِيثِ ، فَقَالَ  زُبَيْدٌ الْأَيَامِيُّ  : عَنْ  مُجَاهِدٍ  ، عَنْ  عَائِشَةَ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقَالَ  يُونُسُ بْنُ أَبِي إِسْحَاقَ  : عَنْ  مُجَاهِدٍ  ، عَنْ  أَبِي هُرَيْرَةَ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقَالَ         [6/373]      بَشِيرٌ  : عَنْ  مُجَاهِدٍ  ، عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  .","","Musnad al-Bazzar 2388","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن بشير بن سلمان عن سلم بن قتيبة الشعيري عن الفلاس عن البزار","مسند عبد الله بن عمرو بن العاص"
"2396","2389  -  حَدَّثَنَا  عُمَرُ بْنُ الْخَطَّابِ السِّجِسْتَانِيُّ قَالَ :  أَخْبَرَنَا  سَعِيدُ بْنُ سُلَيْمَانَ قَالَ :  أَخْبَرَنَا  يَمَانُ بْنُ الْمُغِيرَةِ ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  مَنْ تَوَضَّأَ فَأَحْسَنَ الْوُضُوءَ ثُمَّ صَلَّى أَرْبَعَ رَكَعَاتٍ لَمْ يَسْهُ فِيهِنَّ غُفِرَ لَهُ  .","","Musnad al-Bazzar 2389","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن عبد الكريم بن أبي المخارق عن يمان بن المغيرة العنبري عن سعيد بن سليمان سعدويه عن عمر بن الخطاب السجستاني عن البزار","مسند عبد الله بن عمرو بن العاص"
"2397","2390  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ قَالَ :  أَخْبَرَنَا  عَمْرُو بْنُ خَالِدٍ قَالَ :  أَخْبَرَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأَى عَلَى رَجُلٍ ثَوْبًا مَصْبُوغًا بِالْعُصْفُرِ ، فَقَالَ : "" مَا هَذَا ؟ "" فَانْطَلَقَ  عَبْدُ اللهِ  فَأَحْرَقَهُ بِالنَّارِ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا صَنَعْتَ بِثَوْبِكَ ؟ "" قَالَ : أَحْرَقْتُهُ ، قَالَ : "" أَفَلَا كَسَوْتَهُ  ؟ "" .","","Musnad al-Bazzar 2390","","عبد الله بن عمرو بن العاص عن سعيد بن المسيب عن عمرو بن شعيب عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن إبراهيم بن عبد الله بن الجنيد الختلي عن البزار","مسند عبد الله بن عمرو بن العاص"
"2398","[6/374]      2391  -  حَدَّثَنَا  أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ قَالَ :  أَخْبَرَنَا  مُحَمَّدُ بْنُ الصَّلْتِ قَالَ :  أَخْبَرَنَا  شَرِيكٌ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو .","","Musnad al-Bazzar 2391","","عبد الله بن عمرو بن العاص عن طاوس بن كيسان عن ليث بن أبي سليم عن شريك بن عبد الله النخعي عن محمد بن الصلت الأصم عن أحمد بن عثمان بن حكيم عن البزار","مسند عبد الله بن عمرو بن العاص"
"2399","2392  -  وَأَخْبَرَنَاهُ  أَحْمَدُ بْنُ عَمْرِو بْنِ عُبَيْدَةَ الْعُصْفُرِيُّ قَالَ :  أَخْبَرَنَا  فُضَيْلُ بْنُ عَبْدِ الْوَهَّابِ قَالَ :  أَخْبَرَنَا  شَرِيكٌ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا قَالَ : ""  الَّذِي لَا يُحَبِّبُ إِلَيَّ الْمَوْتَ : الصَّادِقَةُ  ، قَالُوا : وَمَا الصَّادِقَةُ ؟ قَالَ : "" صَحِيفَةٌ سَمِعْتُهَا مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ""  .  وَمَعْنَى هَذَا الْحَدِيثِ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَبَاحَ لَهُ أَنْ يَكْتُبَ عَنْهُ  .","","Musnad al-Bazzar 2392","","عبد الله بن عمرو بن العاص عن طاوس بن كيسان عن ليث بن أبي سليم عن شريك بن عبد الله النخعي عن فضيل بن عبد الوهاب القناد عن محمد بن عمرو بن العباس القلوري عن البزار","مسند عبد الله بن عمرو بن العاص"
"2400","[6/375]      2393  -  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ، وَأَبُو بُرَيْدٍ الْجَرْمِيُّ قَالَا :  أَخْبَرَنَا  ابْنُ أَبِي عَدِيٍّ قَالَ :  أَخْبَرَنَا  شُعْبَةُ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  لَزَوَالُ الدُّنْيَا جَمِيعًا أَهْوَنُ عَلَى اللهِ تَبَارَكَ وَتَعَالَى مِنْ دَمِ امْرِئٍ مُسْلِمٍ  يُسْفَكُ  بِغَيْرِ حَقٍّ - أَوْ قَالَ - يُقْتَلُ بِغَيْرِ حَقٍّ  .         [6/376]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ  أَسْنَدَهُ  عَنْ  شُعْبَةَ  إِلَّا  ابْنُ أَبِي عَدِيٍّ  .","","Musnad al-Bazzar 2393","","عبد الله بن عمرو بن العاص عن عطاء الطائفي عن يعلى بن عطاء الطائفي عن شعبة بن الحجاج عن محمد بن إبراهيم بن أبي عدي القسملي عن عمرو بن يزيد الجرمي عن البزار","مسند عبد الله بن عمرو بن العاص"
