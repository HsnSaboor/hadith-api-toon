hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"6500","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدِ بْنِ جَمِيلِ بْنِ طَرِيفٍ الثَّقَفِيُّ ، وَزُهَيْرُ بْنُ حَرْبٍ ، قَالَا: حَدَّثَنَا جَرِيرٌ ، عَنْ عُمَارَةَ بْنِ الْقَعْقَاعِ ، عَنْ أَبِي زُرْعَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: جَاءَ رَجُلٌ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: \"\" مَنْ أَحَقُّ النَّاسِ بِحُسْنِ صَحَابَتِي؟ قَالَ: أُمُّكَ، قَالَ: ثُمَّ مَنْ؟ قَالَ: ثُمَّ أُمُّكَ، قَالَ: ثُمَّ مَنْ؟ قَالَ: ثُمَّ أُمُّكَ؟ قَالَ: ثُمَّ مَنْ؟ قَالَ: ثُمَّ أَبُوكَ \"\"، وَفِي حَدِيثِ قُتَيْبَةَ: مَنْ أَحَقُّ بِحُسْنِ صَحَابَتِي، وَلَمْ يَذْكُرِ النَّاسَ.nصحیح مسلم حدیث: 6500 عربی حدیث: 2548",": Sahih","Sahih Muslim 6500","","","1. باب: والدین کے ساتھ اچھا سلوک کرنا اور ان دونوں سے کون زیادہ حقدار ہے۔باب: والدین سے حسن سلوک اور یہ کہ ان دونوں میں سے اس کا زیادہ حقدار کون ہےChapter: Being Dutiful To One's Parents, And Which Of Them Is More Entitled To It"
"6501","حَدَّثَنَا أَبُو كُرَيْبٍ مُحَمَّدُ بْنُ الْعَلَاءِ الْهَمْدَانِيُّ ، حَدَّثَنَا ابْنُ فُضَيْلٍ ، عَنْ أَبِيهِ ، عَنْ عُمَارَةَ بْنِ الْقَعْقَاعِ ، عَنْ أَبِي زُرْعَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَجُلٌ: \"\" يَا رَسُولَ اللَّهِ، مَنْ أَحَقُّ النَّاسِ بِحُسْنِ الصُّحْبَةِ؟ قَالَ: أُمُّكَ، ثُمَّ أُمُّكَ، ثُمَّ أُمُّكَ، ثُمَّ أَبُوكَ، ثُمَّ أَدْنَاكَ أَدْنَاكَ \"\".nصحیح مسلم حدیث: 6501 عربی حدیث: 2548",": Sahih","Sahih Muslim 6501","","","1. باب: والدین کے ساتھ اچھا سلوک کرنا اور ان دونوں سے کون زیادہ حقدار ہے۔باب: والدین سے حسن سلوک اور یہ کہ ان دونوں میں سے اس کا زیادہ حقدار کون ہےChapter: Being Dutiful To One's Parents, And Which Of Them Is More Entitled To It"
"6502","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا شَرِيكٌ ، عَنْ عُمَارَةَ ، وَابْنِ شُبْرُمَةَ ، عَنْ أَبِي زُرْعَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: جَاءَ رَجُلٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَذَكَرَ بِمِثْلِ حَدِيثِ جَرِيرٍ وَزَادَ، فَقَالَ: نَعَمْ، وَأَبِيكَ لَتُنَبَّأَنَّ.nصحیح مسلم حدیث: 6502 عربی حدیث: 2548",": Sahih","Sahih Muslim 6502","","","1. باب: والدین کے ساتھ اچھا سلوک کرنا اور ان دونوں سے کون زیادہ حقدار ہے۔باب: والدین سے حسن سلوک اور یہ کہ ان دونوں میں سے اس کا زیادہ حقدار کون ہےChapter: Being Dutiful To One's Parents, And Which Of Them Is More Entitled To It"
"6503","حَدَّثَنِي مُحَمَّدُ بْنُ حَاتِمٍ ، حَدَّثَنَا شَبَابَةُ ، حَدَّثَنَا مُحَمَّدُ بْنُ طَلْحَةَ . ح وحَدَّثَنِي أَحْمَدُ بْنُ خِرَاشٍ ، حَدَّثَنَا حَبَّانُ ، حَدَّثَنَا وُهَيْبٌ كِلَاهُمَا، عَنْ ابْنِ شُبْرُمَةَ ، بِهَذَا الْإِسْنَادِ فِي حَدِيثِ وُهَيْبٍ: مَنْ أَبَرُّ، وَفِي حَدِيثِ مُحَمَّدِ بْنِ طَلْحَةَ: أَيُّ النَّاسِ أَحَقُّ مِنِّي بِحُسْنِ الصُّحْبَةِ، ثُمَّ ذَكَرَ بِمِثْلِ حَدِيثِ جَرِيرٍ.nصحیح مسلم حدیث: 6503 عربی حدیث: 2548",": Sahih","Sahih Muslim 6503","","","1. باب: والدین کے ساتھ اچھا سلوک کرنا اور ان دونوں سے کون زیادہ حقدار ہے۔باب: والدین سے حسن سلوک اور یہ کہ ان دونوں میں سے اس کا زیادہ حقدار کون ہےChapter: Being Dutiful To One's Parents, And Which Of Them Is More Entitled To It"
"6504","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَزُهَيْرُ بْنُ حَرْبٍ ، قَالَا: حَدَّثَنَا وَكِيعٌ ، عَنْ سُفْيَانَ ، عَنْ حَبِيبٍ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا يَحْيَي يَعْنِي ابْنَ سَعِيدٍ الْقَطَّانَ ، عَنْ سُفْيَانَ ، وَشُعْبَةَ ، قَالَا: حَدَّثَنَا حَبِيبٌ ، عَنْ أَبِي الْعَبَّاسِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، قَالَ: \"\" جَاءَ رَجُلٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَسْتَأْذِنُهُ فِي الْجِهَادِ، فَقَالَ: أَحَيٌّ وَالِدَاكَ، قَالَ: نَعَمْ، قَالَ: فَفِيهِمَا فَجَاهِدْ \"\".nصحیح مسلم حدیث: 6504 عربی حدیث: 2549",": Sahih","Sahih Muslim 6504","","","1. باب: والدین کے ساتھ اچھا سلوک کرنا اور ان دونوں سے کون زیادہ حقدار ہے۔باب: والدین سے حسن سلوک اور یہ کہ ان دونوں میں سے اس کا زیادہ حقدار کون ہےChapter: Being Dutiful To One's Parents, And Which Of Them Is More Entitled To It"
"6505","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا شُعْبَةُ ، عَنْ حَبِيبٍ ، سَمِعْتُ أَبَا الْعَبَّاسِ ، سَمِعْتُ عَبْدَ اللَّهِ بْنَ عَمْرِو بْنِ الْعَاصِ ، يَقُولُ: جَاءَ رَجُلٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَذَكَرَ بِمِثْلِهِ، قَالَ مُسْلِم: أَبُو الْعَبَّاسِ اسْمُهُ: السَّائِبُ بْنُ فَرُّوخَ الْمَكِّيُّ.nصحیح مسلم حدیث: 6505 عربی حدیث: 2549",": Sahih","Sahih Muslim 6505","","","1. باب: والدین کے ساتھ اچھا سلوک کرنا اور ان دونوں سے کون زیادہ حقدار ہے۔باب: والدین سے حسن سلوک اور یہ کہ ان دونوں میں سے اس کا زیادہ حقدار کون ہےChapter: Being Dutiful To One's Parents, And Which Of Them Is More Entitled To It"
"6506","حَدَّثَنَا أَبُو كُرَيْبٍ ، أَخْبَرَنَا ابْنُ بِشْرٍ ، عَنْ مِسْعَرٍ . ح وحَدَّثَنِي مُحَمَّدُ بْنُ حَاتِمٍ ، حَدَّثَنَا مُعَاوِيَةُ بْنُ عَمْرٍو ، عَنْ أَبِي إِسْحَاقَ . ح وحَدَّثَنِي الْقَاسِمُ بْنُ زَكَرِيَّاءَ ، حَدَّثَنَا حُسَيْنُ بْنُ عَلِيٍّ الْجُعْفِيُّ ، عَنْ زَائِدَةَ كِلَاهُمَا، عَنْ الْأَعْمَشِ جَمِيعًا، عَنْ حَبِيبٍ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ.nصحیح مسلم حدیث: 6506 عربی حدیث: 2549",": Sahih","Sahih Muslim 6506","","","1. باب: والدین کے ساتھ اچھا سلوک کرنا اور ان دونوں سے کون زیادہ حقدار ہے۔باب: والدین سے حسن سلوک اور یہ کہ ان دونوں میں سے اس کا زیادہ حقدار کون ہےChapter: Being Dutiful To One's Parents, And Which Of Them Is More Entitled To It"
"6507","حَدَّثَنَا سَعِيدُ بْنُ مَنْصُورٍ ، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، أَخْبَرَنِي عَمْرُو بْنُ الْحَارِثِ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، أَنَّ نَاعِمًا مَوْلَى أُمِّ سَلَمَةَ حَدَّثَهُ، أَنَّ عَبْدَ اللَّهِ بْنَ عَمْرِو بْنِ الْعَاصِ ، قَالَ: \"\" أَقْبَلَ رَجُلٌ إِلَى نَبِيِّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: أُبَايِعُكَ عَلَى الْهِجْرَةِ وَالْجِهَادِ أَبْتَغِي الْأَجْرَ مِنَ اللَّهِ، قَالَ: فَهَلْ مِنْ وَالِدَيْكَ أَحَدٌ حَيٌّ؟ قَالَ: نَعَمْ، بَلْ كِلَاهُمَا، قَالَ: فَتَبْتَغِي الْأَجْرَ مِنَ اللَّهِ؟ قَالَ: نَعَمْ، قَالَ: فَارْجِعْ إِلَى وَالِدَيْكَ فَأَحْسِنْ صُحْبَتَهُمَا \"\".nصحیح مسلم حدیث: 6507 عربی حدیث: 2549",": Sahih","Sahih Muslim 6507","","","1. باب: والدین کے ساتھ اچھا سلوک کرنا اور ان دونوں سے کون زیادہ حقدار ہے۔باب: والدین سے حسن سلوک اور یہ کہ ان دونوں میں سے اس کا زیادہ حقدار کون ہےChapter: Being Dutiful To One's Parents, And Which Of Them Is More Entitled To It"
"6508","حَدَّثَنَا شَيْبَانُ بْنُ فَرُّوخَ ، حَدَّثَنَا سُلَيْمَانُ بْنُ الْمُغِيرَةِ ، حَدَّثَنَا حُمَيْدُ بْنُ هِلَالٍ ، عَنْ أَبِي رَافِعٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّهُ قَالَ: \"\" كَانَ جُرَيْجٌ يَتَعَبَّدُ فِي صَوْمَعَةٍ، فَجَاءَتْ أُمُّهُ، قَالَ حُمَيْدٌ: فَوَصَفَ لَنَا أَبُو رَافِعٍ صِفَةَ أَبِي هُرَيْرَةَ، لِصِفَةِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أُمَّهُ حِينَ دَعَتْهُ كَيْفَ جَعَلَتْ كَفَّهَا فَوْقَ حَاجِبِهَا، ثُمَّ رَفَعَتْ رَأْسَهَا إِلَيْهِ تَدْعُوهُ، فَقَالَتْ يَا جُرَيْجُ: أَنَا أُمُّكَ كَلِّمْنِي، فَصَادَفَتْهُ يُصَلِّي، فَقَالَ: اللَّهُمَّ أُمِّي وَصَلَاتِي، فَاخْتَارَ صَلَاتَهُ، فَرَجَعَتْ، ثُمَّ عَادَتْ فِي الثَّانِيَةِ، فَقَالَتْ يَا جُرَيْجُ: أَنَا أُمُّكَ فَكَلِّمْنِي، قَالَ: اللَّهُمَّ أُمِّي وَصَلَاتِي، فَاخْتَارَ صَلَاتَهُ، فَقَالَتْ: اللَّهُمَّ إِنَّ هَذَا جُرَيْجٌ وَهُوَ ابْنِي وَإِنِّي كَلَّمْتُهُ، فَأَبَى أَنْ يُكَلِّمَنِي اللَّهُمَّ فَلَا تُمِتْهُ حَتَّى تُرِيَهُ الْمُومِسَاتِ، قَالَ: وَلَوْ دَعَتْ عَلَيْهِ أَنْ يُفْتَنَ لَفُتِنَ، قَالَ: وَكَانَ رَاعِي ضَأْنٍ يَأْوِي إِلَى دَيْرِهِ، قَالَ: فَخَرَجَتِ امْرَأَةٌ مِنَ الْقَرْيَةِ فَوَقَعَ عَلَيْهَا الرَّاعِي، فَحَمَلَتْ فَوَلَدَتْ غُلَامًا، فَقِيلَ لَهَا: مَا هَذَا؟ قَالَتْ: مِنْ صَاحِبِ هَذَا الدَّيْرِ، قَالَ: فَجَاءُوا بِفُؤُوسِهِمْ وَمَسَاحِيهِمْ فَنَادَوْهُ فَصَادَفُوهُ يُصَلِّي، فَلَمْ يُكَلِّمْهُمْ، قَالَ: فَأَخَذُوا يَهْدِمُونَ دَيْرَهُ، فَلَمَّا رَأَى ذَلِكَ نَزَلَ إِلَيْهِمْ، فَقَالُوا لَهُ: سَلْ هَذِهِ، قَالَ: فَتَبَسَّمَ ثُمَّ مَسَحَ رَأْسَ الصَّبِيِّ، فَقَالَ: مَنْ أَبُوكَ؟ قَالَ: أَبِي رَاعِي الضَّأْنِ، فَلَمَّا سَمِعُوا ذَلِكَ مِنْهُ، قَالُوا: نَبْنِي مَا هَدَمْنَا مِنْ دَيْرِكَ بِالذَّهَبِ وَالْفِضَّةِ، قَالَ: لَا، وَلَكِنْ أَعِيدُوهُ تُرَابًا كَمَا كَانَ ثُمَّ عَلَاهُ \"\".nصحیح مسلم حدیث: 6508 عربی حدیث: 2550",": Sahih","Sahih Muslim 6508","","","2. باب: نفل نماز پر والدین کی اطاعت مقدم ہے۔والدین کے ساتھ حسن سلوک نفلی نماز اور دوسرے نفلی اعمال پر مقدم ہےChapter: Being Dutiful To One's Parents Takes Precedence Over Voluntary Prayer, Etc."
"6509","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ ، أَخْبَرَنَا جَرِيرُ بْنُ حَازِمٍ ، حَدَّثَنَا مُحَمَّدُ بْنُ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَمْ يَتَكَلَّمْ فِي الْمَهْدِ إِلَّا ثَلَاثَةٌ، عِيسَى ابْنُ مَرْيَمَ، وَصَاحِبُ جُرَيْجٍ، وَكَانَ جُرَيْجٌ رَجُلًا عَابِدًا فَاتَّخَذَ صَوْمَعَةً، فَكَانَ فِيهَا فَأَتَتْهُ أُمُّهُ وَهُوَ يُصَلِّي، فَقَالَتْ: يَا جُرَيْجُ، فَقَالَ: يَا رَبِّ أُمِّي وَصَلَاتِي، فَأَقْبَلَ عَلَى صَلَاتِهِ، فَانْصَرَفَتْ، فَلَمَّا كَانَ مِنَ الْغَدِ أَتَتْهُ وَهُوَ يُصَلِّي، فَقَالَتْ: يَا جُرَيْجُ، فَقَالَ: يَا رَبِّ أُمِّي وَصَلَاتِي، فَأَقْبَلَ عَلَى صَلَاتِهِ، فَانْصَرَفَتْ، فَلَمَّا كَانَ مِنَ الْغَدِ أَتَتْهُ وَهُوَ يُصَلِّي، فَقَالَتْ: يَا جُرَيْجُ، فَقَالَ: أَيْ رَبِّ أُمِّي وَصَلَاتِي، فَأَقْبَلَ عَلَى صَلَاتِهِ، فَقَالَتْ: اللَّهُمَّ لَا تُمِتْهُ حَتَّى يَنْظُرَ إِلَى وُجُوهِ الْمُومِسَاتِ، فَتَذَاكَرَ بَنُو إِسْرَائِيلَ جُرَيْجًا وَعِبَادَتَهُ، وَكَانَتِ امْرَأَةٌ بَغِيٌّ يُتَمَثَّلُ بِحُسْنِهَا، فَقَالَتْ: إِنْ شِئْتُمْ لَأَفْتِنَنَّهُ لَكُمْ، قَالَ: فَتَعَرَّضَتْ لَهُ، فَلَمْ يَلْتَفِتْ إِلَيْهَا، فَأَتَتْ رَاعِيًا كَانَ يَأْوِي إِلَى صَوْمَعَتِهِ، فَأَمْكَنَتْهُ مِنْ نَفْسِهَا فَوَقَعَ عَلَيْهَا فَحَمَلَتْ، فَلَمَّا وَلَدَتْ، قَالَتْ: هُوَ مِنْ جُرَيْجٍ، فَأَتَوْهُ فَاسْتَنْزَلُوهُ وَهَدَمُوا صَوْمَعَتَهُ، وَجَعَلُوا يَضْرِبُونَهُ، فَقَالَ: مَا شَأْنُكُمْ؟ قَالُوا: زَنَيْتَ بِهَذِهِ الْبَغِيِّ فَوَلَدَتْ مِنْكَ، فَقَالَ: أَيْنَ الصَّبِيُّ فَجَاءُوا بِهِ، فَقَالَ: دَعُونِي حَتَّى أُصَلِّيَ، فَصَلَّى فَلَمَّا انْصَرَفَ أَتَى الصَّبِيَّ فَطَعَنَ فِي بَطْنِهِ، وَقَالَ يَا غُلَامُ: مَنْ أَبُوكَ، قَالَ: فُلَانٌ الرَّاعِي، قَالَ: فَأَقْبَلُوا عَلَى جُرَيْجٍ يُقَبِّلُونَهُ وَيَتَمَسَّحُونَ بِهِ، وَقَالُوا: نَبْنِي لَكَ صَوْمَعَتَكَ مِنْ ذَهَبٍ، قَالَ: لَا، أَعِيدُوهَا مِنْ طِينٍ كَمَا كَانَتْ، فَفَعَلُوا، وَبَيْنَا صَبِيٌّ يَرْضَعُ مِنْ أُمِّهِ، فَمَرَّ رَجُلٌ رَاكِبٌ عَلَى دَابَّةٍ فَارِهَةٍ وَشَارَةٍ حَسَنَةٍ، فَقَالَتْ أُمُّهُ: اللَّهُمَّ اجْعَلِ ابْنِي مِثْلَ هَذَا، فَتَرَكَ الثَّدْيَ وَأَقْبَلَ إِلَيْهِ فَنَظَرَ إِلَيْهِ، فَقَالَ: اللَّهُمَّ لَا تَجْعَلْنِي مِثْلَهُ، ثُمَّ أَقْبَلَ عَلَى ثَدْيِهِ فَجَعَلَ يَرْتَضِعُ، قَالَ: فَكَأَنِّي أَنْظُرُ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَحْكِي ارْتِضَاعَهُ بِإِصْبَعِهِ السَّبَّابَةِ فِي فَمِهِ، فَجَعَلَ يَمُصُّهَا، قَالَ: وَمَرُّوا بِجَارِيَةٍ وَهُمْ يَضْرِبُونَهَا وَيَقُولُونَ زَنَيْتِ سَرَقْتِ وَهِيَ، تَقُولُ: حَسْبِيَ اللَّهُ وَنِعْمَ الْوَكِيلُ، فَقَالَتْ أُمُّهُ: اللَّهُمَّ لَا تَجْعَلِ ابْنِي مِثْلَهَا، فَتَرَكَ الرَّضَاعَ وَنَظَرَ إِلَيْهَا، فَقَالَ: اللَّهُمَّ اجْعَلْنِي مِثْلَهَا، فَهُنَاكَ تَرَاجَعَا الْحَدِيثَ، فَقَالَتْ حَلْقَى مَرَّ رَجُلٌ حَسَنُ الْهَيْئَةِ، فَقُلْتُ: اللَّهُمَّ اجْعَلِ ابْنِي مِثْلَهُ، فَقُلْتَ: اللَّهُمَّ لَا تَجْعَلْنِي مِثْلَهُ، وَمَرُّوا بِهَذِهِ الْأَمَةِ وَهُمْ يَضْرِبُونَهَا، وَيَقُولُونَ: زَنَيْتِ سَرَقْتِ، فَقُلْتُ: اللَّهُمَّ لَا تَجْعَلِ ابْنِي مِثْلَهَا، فَقُلْت: اللَّهُمَّ اجْعَلْنِي مِثْلَهَا، قَالَ: إِنَّ ذَاكَ الرَّجُلَ كَانَ جَبَّارًا، فَقُلْتُ: اللَّهُمَّ لَا تَجْعَلْنِي مِثْلَهُ، وَإِنَّ هَذِهِ يَقُولُونَ لَهَا زَنَيْتِ، وَلَمْ تَزْنِ، وَسَرَقْتِ، وَلَمْ تَسْرِقْ، فَقُلْتُ: اللَّهُمَّ اجْعَلْنِي مِثْلَهَا \"\".nصحیح مسلم حدیث: 6509 عربی حدیث: 2550",": Sahih","Sahih Muslim 6509","","","2. باب: نفل نماز پر والدین کی اطاعت مقدم ہے۔والدین کے ساتھ حسن سلوک نفلی نماز اور دوسرے نفلی اعمال پر مقدم ہےChapter: Being Dutiful To One's Parents Takes Precedence Over Voluntary Prayer, Etc."
"6510","حَدَّثَنَا شَيْبَانُ بْنُ فَرُّوخَ ، حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ سُهَيْلٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: رَغِمَ أَنْفُ، ثُمَّ رَغِمَ أَنْفُ، ثُمَّ رَغِمَ أَنْفُ، قِيلَ: مَنْ يَا رَسُولَ اللَّهِ؟، قَالَ: \"\" مَنْ أَدْرَكَ أَبَوَيْهِ عِنْدَ الْكِبَرِ أَحَدَهُمَا أَوْ كِلَيْهِمَا فَلَمْ يَدْخُلِ الْجَنَّةَ \"\".nصحیح مسلم حدیث: 6510 عربی حدیث: 2551",": Sahih","Sahih Muslim 6510","","","3. باب: بدبخت ہے وہ انسان جو بڑھاپے میں والدین کی خدمت کر کے جنت حاصل نہ کرے۔باب: اس شخص کی ذلت جس نے اپنے والدین یا دونوں میں سے کسی ایک کو بڑھاپے میں پایا تو (ان کے ذریعے سے) جنت میں داخل نہ ہواChapter: The Disgrace Of One Whose Parents, One Or Both Of Them, Reach Old Age During His Lifetime, And He Does Not Enter Paradise"
"6511","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا جَرِيرٌ ، عَنْ سُهَيْلٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: رَغِمَ أَنْفُهُ، ثُمَّ رَغِمَ أَنْفُهُ، ثُمَّ رَغِمَ أَنْفُهُ، قِيلَ: مَنْ يَا رَسُولَ اللَّهِ؟ قَالَ: \"\" مَنْ أَدْرَكَ وَالِدَيْهِ عِنْدَ الْكِبَرِ أَحَدَهُمَا أَوْ كِلَيْهِمَا، ثُمَّ لَمْ يَدْخُلِ الْجَنَّةَ \"\".nصحیح مسلم حدیث: 6511 عربی حدیث: 2551",": Sahih","Sahih Muslim 6511","","","3. باب: بدبخت ہے وہ انسان جو بڑھاپے میں والدین کی خدمت کر کے جنت حاصل نہ کرے۔باب: اس شخص کی ذلت جس نے اپنے والدین یا دونوں میں سے کسی ایک کو بڑھاپے میں پایا تو (ان کے ذریعے سے) جنت میں داخل نہ ہواChapter: The Disgrace Of One Whose Parents, One Or Both Of Them, Reach Old Age During His Lifetime, And He Does Not Enter Paradise"
"6512","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ سُلَيْمَانَ بْنِ بِلَالٍ ، حَدَّثَنِي سُهَيْلٌ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: رَغِمَ أَنْفُهُ، ثَلَاثًا، ثُمَّ ذَكَرَ مِثْلَهُ.nصحیح مسلم حدیث: 6512 عربی حدیث: 2551",": Sahih","Sahih Muslim 6512","","","3. باب: بدبخت ہے وہ انسان جو بڑھاپے میں والدین کی خدمت کر کے جنت حاصل نہ کرے۔باب: اس شخص کی ذلت جس نے اپنے والدین یا دونوں میں سے کسی ایک کو بڑھاپے میں پایا تو (ان کے ذریعے سے) جنت میں داخل نہ ہواChapter: The Disgrace Of One Whose Parents, One Or Both Of Them, Reach Old Age During His Lifetime, And He Does Not Enter Paradise"
"6513","حَدَّثَنِي أَبُو الطَّاهِرِ أَحْمَدُ بْنُ عَمْرِو بْنِ سَرْحٍ ، أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، أَخْبَرَنِي سَعِيدُ بْنُ أَبِي أَيُّوبَ ، عَنْ الْوَلِيدِ بْنِ أَبِي الْوَلِيدِ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ : أَنَّ رَجُلًا مِنَ الْأَعْرَابِ لَقِيَهُ بِطَرِيقِ مَكَّةَ، فَسَلَّمَ عَلَيْهِ عَبْدُ اللَّهِ وَحَمَلَهُ عَلَى حِمَارٍ كَانَ يَرْكَبُهُ وَأَعْطَاهُ عِمَامَةً، كَانَتْ عَلَى رَأْسِهِ، فَقَالَ ابْنُ دِينَارٍ: فَقُلْنَا لَهُ: أَصْلَحَكَ اللَّهُ إِنَّهُمُ الْأَعْرَابُ، وَإِنَّهُمْ يَرْضَوْنَ بِالْيَسِيرِ، فَقَالَ عَبْدُ اللَّهِ: إِنَّ أَبَا هَذَا كَانَ وُدًّا لِعُمَرَ بْنِ الْخَطَّابِ، وَإِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \"\" إِنَّ أَبَرَّ الْبِرِّ صِلَةُ الْوَلَدِ أَهْلَ وُدِّ أَبِيهِ \"\".nصحیح مسلم حدیث: 6513 عربی حدیث: 2552",": Sahih","Sahih Muslim 6513","","","4. باب: ماں باپ کے دوستوں کے ساتھ سلوک کر نے کی فضیلت۔باب: ماں باپ کے دوستوں اور ان جیسی حیثیت رکھنے والوں کے ساتھ نیک سلوک کی فضیلتChapter: The Virtue Of Maintaining Ties With The Friends Of One's Father And Mother, Etc."
"6514","حَدَّثَنِي أَبُو الطَّاهِرِ ، أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، أَخْبَرَنِي حَيْوَةُ بْنُ شُرَيْحٍ ، عَنْ ابْنِ الْهَادِ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" أَبَرُّ الْبِرِّ أَنْ يَصِلَ الرَّجُلُ وُدَّ أَبِيهِ \"\".nصحیح مسلم حدیث: 6514 عربی حدیث: 2552",": Sahih","Sahih Muslim 6514","","","4. باب: ماں باپ کے دوستوں کے ساتھ سلوک کر نے کی فضیلت۔باب: ماں باپ کے دوستوں اور ان جیسی حیثیت رکھنے والوں کے ساتھ نیک سلوک کی فضیلتChapter: The Virtue Of Maintaining Ties With The Friends Of One's Father And Mother, Etc."
"6515","حَدَّثَنَا حَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ، حَدَّثَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ، حَدَّثَنَا أَبِي ، وَاللَّيْثُ بْنُ سَعْدٍ جَمِيعًا، عَنْ يَزِيدَ بْنِ عَبْدِ اللَّهِ بْنِ أُسَامَةَ بْنِ الْهَادِ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، عَنْ ابْنِ عُمَرَ ، أَنَّهُ كَانَ إِذَا خَرَجَ إِلَى مَكَّةَ كَانَ لَهُ حِمَارٌ يَتَرَوَّحُ عَلَيْهِ إِذَا مَلَّ رُكُوبَ الرَّاحِلَةِ، وَعِمَامَةٌ يَشُدُّ بِهَا رَأْسَهُ، فَبَيْنَا هُوَ يَوْمًا عَلَى ذَلِكَ الْحِمَارِ إِذْ مَرَّ بِهِ أَعْرَابِيٌّ، فَقَالَ: أَلَسْتَ ابْنَ فُلَانِ بْنِ فُلَانٍ؟ قَالَ: بَلَى، فَأَعْطَاهُ الْحِمَارَ، وَقَالَ: ارْكَبْ هَذَا وَالْعِمَامَةَ، قَالَ: اشْدُدْ بِهَا رَأْسَكَ، فَقَالَ لَهُ بَعْضُ أَصْحَابِهِ: غَفَرَ اللَّهُ لَكَ أَعْطَيْتَ هَذَا الْأَعْرَابِيَّ حِمَارًا، كُنْتَ تَرَوَّحُ عَلَيْهِ وَعِمَامَةً كُنْتَ تَشُدُّ بِهَا رَأْسَكَ، فَقَالَ إِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \"\" إِنَّ مِنْ أَبَرِّ الْبِرِّ صِلَةَ الرَّجُلِ أَهْلَ وُدِّ أَبِيهِ بَعْدَ أَنْ يُوَلِّيَ \"\"، وَإِنَّ أَبَاهُ كَانَ صَدِيقًا لِعُمَرَ.nصحیح مسلم حدیث: 6515 عربی حدیث: 2552",": Sahih","Sahih Muslim 6515","","","4. باب: ماں باپ کے دوستوں کے ساتھ سلوک کر نے کی فضیلت۔باب: ماں باپ کے دوستوں اور ان جیسی حیثیت رکھنے والوں کے ساتھ نیک سلوک کی فضیلتChapter: The Virtue Of Maintaining Ties With The Friends Of One's Father And Mother, Etc."
"6516","حَدَّثَنِي مُحَمَّدُ بْنُ حَاتِمِ بْنِ مَيْمُونٍ ، حَدَّثَنَا ابْنُ مَهْدِيٍّ ، عَنْ مُعَاوِيَةَ بْنِ صَالِحٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرِ بْنِ نُفَيْرٍ ، عَنْ أَبِيهِ ، عَنْ النَّوَّاسِ بْنِ سِمْعَانَ الْأَنْصَارِيِّ ، قَالَ: \"\" سَأَلْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الْبِرِّ وَالْإِثْمِ؟ فَقَالَ: الْبِرُّ حُسْنُ الْخُلُقِ، وَالْإِثْمُ مَا حَاكَ فِي صَدْرِكَ، وَكَرِهْتَ أَنْ يَطَّلِعَ عَلَيْهِ النَّاسُ \"\".nصحیح مسلم حدیث: 6516 عربی حدیث: 2553",": Sahih","Sahih Muslim 6516","","","5. باب: بھلائی اور برائی کے معنی۔باب: نیکی اور گناہ کی وضاحتChapter: Meaning Of Righteousness And Sin"
"6517","حَدَّثَنِي هَارُونُ بْنُ سَعِيدٍ الْأَيْلِيُّ ، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، حَدَّثَنِي مُعَاوِيَةُ يَعْنِي ابْنَ صَالِحٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرِ بْنِ نُفَيْرٍ ، عَنْ أَبِيهِ ، عَنْ نَوَّاسِ بْنِ سِمْعَانَ ، قَالَ: أَقَمْتُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالْمَدِينَةِ سَنَةً مَا يَمْنَعُنِي مِنَ الْهِجْرَةِ، إِلَّا الْمَسْأَلَةُ كَانَ أَحَدُنَا إِذَا هَاجَرَ لَمْ يَسْأَلْ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ شَيْءٍ، قَالَ: فَسَأَلْتُهُ عَنِ الْبِرِّ وَالْإِثْمِ؟ فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" الْبِرُّ حُسْنُ الْخُلُقِ، وَالْإِثْمُ مَا حَاكَ فِي نَفْسِكَ، وَكَرِهْتَ أَنْ يَطَّلِعَ عَلَيْهِ النَّاسُ \"\".nصحیح مسلم حدیث: 6517 عربی حدیث: 2553",": Sahih","Sahih Muslim 6517","","","5. باب: بھلائی اور برائی کے معنی۔باب: نیکی اور گناہ کی وضاحتChapter: Meaning Of Righteousness And Sin"
"6518","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدِ بْنِ جَمِيلِ بْنِ طَرِيفِ بْنِ عَبْدِ اللَّهِ الثَّقَفِيُّ ، وَمُحَمَّدُ بْنُ عَبَّادٍ ، قَالَا: حَدَّثَنَا حَاتِمٌ وَهُوَ ابْنُ إِسْمَاعِيلَ ، عَنْ مُعَاوِيَةَ وَهُوَ ابْنُ أَبِي مُزَرِّدٍ مَوْلَى بَنِي هَاشِمٍ، حَدَّثَنِي عَمِّي أَبُو الْحُبَابِ سَعِيدُ بْنُ يَسَارٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" إِنَّ اللَّهَ خَلَقَ الْخَلْقَ، حَتَّى إِذَا فَرَغَ مِنْهُمْ قَامَتِ الرَّحِمُ، فَقَالَتْ: هَذَا مَقَامُ الْعَائِذِ مِنَ الْقَطِيعَةِ؟ قَالَ: نَعَمْ، أَمَا تَرْضَيْنَ أَنْ أَصِلَ مَنْ وَصَلَكِ، وَأَقْطَعَ مَنْ قَطَعَكِ؟ قَالَت: بَلَى، قَالَ: فَذَاكِ لَكِ، ثُمَّ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: اقْرَءُوا إِنْ شِئْتُمْ: فَهَلْ عَسَيْتُمْ إِنْ تَوَلَّيْتُمْ أَنْ تُفْسِدُوا فِي الأَرْضِ وَتُقَطِّعُوا أَرْحَامَكُمْ {22} أُولَئِكَ الَّذِينَ لَعَنَهُمُ اللَّهُ فَأَصَمَّهُمْ وَأَعْمَى أَبْصَارَهُمْ {23} أَفَلا يَتَدَبَّرُونَ الْقُرْءَانَ أَمْ عَلَى قُلُوبٍ أَقْفَالُهَا {24} سورة محمد آية 22-24 \"\".nصحیح مسلم حدیث: 6518 عربی حدیث: 2554",": Sahih","Sahih Muslim 6518","","","6. باب: ناتا توڑنا حرام ہے۔باب: صلہ رحمی (کا حکم) اور قطع رحمی کی ممانعتChapter: Upholding Ties Of Kinship, And The Prohibition Of Severing Them"
"6519","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَزُهَيْرُ بْنُ حَرْبٍ وَاللَّفْظُ لِأَبِي بَكْرٍ، قَالَا: حَدَّثَنَا وَكِيعٌ ، عَنْ مُعَاوِيَةَ بْنِ أَبِي مُزَرِّدٍ ، عَنْ يَزِيدَ بْنِ رُومَانَ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" الرَّحِمُ مُعَلَّقَةٌ بِالْعَرْشِ، تَقُولُ: مَنْ وَصَلَنِي وَصَلَهُ اللَّهُ، وَمَنْ قَطَعَنِي قَطَعَهُ اللَّهُ \"\".nصحیح مسلم حدیث: 6519 عربی حدیث: 2555",": Sahih","Sahih Muslim 6519","","","6. باب: ناتا توڑنا حرام ہے۔باب: صلہ رحمی (کا حکم) اور قطع رحمی کی ممانعتChapter: Upholding Ties Of Kinship, And The Prohibition Of Severing Them"
"6520","حَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، وَابْنُ أَبِي عُمَرَ ، قَالَا: حَدَّثَنَا سُفْيَانُ ، عَنْ الزُّهْرِيِّ ، عَنْ مُحَمَّدِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ، عَنْ أَبِيهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَا يَدْخُلُ الْجَنَّةَ قَاطِعٌ \"\"، قَالَ ابْنُ أَبِي عُمَرَ: قَالَ سُفْيَانُ: يَعْنِي قَاطِعَ رَحِمٍ.nصحیح مسلم حدیث: 6520 عربی حدیث: 2556",": Sahih","Sahih Muslim 6520","","","6. باب: ناتا توڑنا حرام ہے۔باب: صلہ رحمی (کا حکم) اور قطع رحمی کی ممانعتChapter: Upholding Ties Of Kinship, And The Prohibition Of Severing Them"
"6521","حَدَّثَنِي عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ الضُّبَعِيُّ ، حَدَّثَنَا جُوَيْرِيَةُ ، عَنْ مَالِكٍ ، عَنْ الزُّهْرِيِّ ، أَنَّ مُحَمَّدَ بْنَ جُبَيْرِ بْنِ مُطْعِمٍ أَخْبَرَهُ، أَنَّ أَبَاهُ أَخْبَرَهُ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَا يَدْخُلُ الْجَنَّةَ قَاطِعُ رَحِمٍ \"\".nصحیح مسلم حدیث: 6521 عربی حدیث: 2556",": Sahih","Sahih Muslim 6521","","","6. باب: ناتا توڑنا حرام ہے۔باب: صلہ رحمی (کا حکم) اور قطع رحمی کی ممانعتChapter: Upholding Ties Of Kinship, And The Prohibition Of Severing Them"
"6522","حَدَّثَنَا مُحَمَّدُ بْنُ رَافِعٍ، وَعَبْدُ بْنُ حميد ، عَنْ عَبْدِ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنْ الزُّهْرِيِّ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ، وَقَالَ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.nصحیح مسلم حدیث: 6522 عربی حدیث: 2556",": Sahih","Sahih Muslim 6522","","","6. باب: ناتا توڑنا حرام ہے۔باب: صلہ رحمی (کا حکم) اور قطع رحمی کی ممانعتChapter: Upholding Ties Of Kinship, And The Prohibition Of Severing Them"
"6523","حَدَّثَنِي حَرْمَلَةُ بْنُ يَحْيَي التُّجِيبِيُّ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، قَالَ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \"\" مَنْ سَرَّهُ أَنْ يُبْسَطَ عَلَيْهِ رِزْقُهُ، أَوْ يُنْسَأَ فِي أَثَرِهِ فَلْيَصِلْ رَحِمَهُ \"\".nصحیح مسلم حدیث: 6523 عربی حدیث: 2557",": Sahih","Sahih Muslim 6523","","","6. باب: ناتا توڑنا حرام ہے۔باب: صلہ رحمی (کا حکم) اور قطع رحمی کی ممانعتChapter: Upholding Ties Of Kinship, And The Prohibition Of Severing Them"
"6524","وحَدَّثَنِي عَبْدُ الْمَلِكِ بْنُ شُعَيْبِ بْنِ اللَّيْثِ ، حَدَّثَنِي أَبِي ، عَنْ جَدِّي ، حَدَّثَنِي عُقَيْلُ بْنُ خَالِدٍ ، قَالَ: قَالَ ابْنُ شِهَابٍ : أَخْبَرَنِي أَنَسُ بْنُ مَالِكٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" مَنْ أَحَبَّ أَنْ يُبْسَطَ لَهُ فِي رِزْقِهِ، وَيُنْسَأَ لَهُ فِي أَثَرِهِ، فَلْيَصِلْ رَحِمَهُ \"\".nصحیح مسلم حدیث: 6524 عربی حدیث: 2557",": Sahih","Sahih Muslim 6524","","","6. باب: ناتا توڑنا حرام ہے۔باب: صلہ رحمی (کا حکم) اور قطع رحمی کی ممانعتChapter: Upholding Ties Of Kinship, And The Prohibition Of Severing Them"
"6525","حَدَّثَنِي مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ بَشَّارٍ ، وَاللَّفْظُ لِابْنِ الْمُثَنَّى، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، قَالَ: سَمِعْتُ الْعَلَاءَ بْنَ عَبْدِ الرَّحْمَنِ يُحَدِّثُ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ : أَنَّ رَجُلًا، قَالَ: \"\" يَا رَسُولَ اللَّهِ، إِنَّ لِي قَرَابَةً أَصِلُهُمْ وَيَقْطَعُونِي، وَأُحْسِنُ إِلَيْهِمْ وَيُسِيئُونَ إِلَيَّ، وَأَحْلُمُ عَنْهُمْ وَيَجْهَلُونَ عَلَيَّ، فَقَالَ: لَئِنْ كُنْتَ كَمَا قُلْتَ، فَكَأَنَّمَا تُسِفُّهُمُ الْمَلَّ، وَلَا يَزَالُ مَعَكَ مِنَ اللَّهِ ظَهِيرٌ عَلَيْهِمْ مَا دُمْتَ عَلَى ذَلِكَ \"\".nصحیح مسلم حدیث: 6525 عربی حدیث: 2558",": Sahih","Sahih Muslim 6525","","","6. باب: ناتا توڑنا حرام ہے۔باب: صلہ رحمی (کا حکم) اور قطع رحمی کی ممانعتChapter: Upholding Ties Of Kinship, And The Prohibition Of Severing Them"
"6526","حَدَّثَنِي يَحْيَي بْنُ يَحْيَي ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ ابْنِ شِهَابِ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَا تَبَاغَضُوا، وَلَا تَحَاسَدُوا، وَلَا تَدَابَرُوا وَكُونُوا عِبَادَ اللَّهِ إِخْوَانًا، وَلَا يَحِلُّ لِمُسْلِمٍ أَنْ يَهْجُرَ أَخَاهُ فَوْقَ ثَلَاثٍ \"\".nصحیح مسلم حدیث: 6526 عربی حدیث: 2558",": Sahih","Sahih Muslim 6526","","","7. باب: حسد اور بغض اور دشمنی کا حرام ہونا۔باب: ایک دوسرے سے حسد، بغض اور روگردانی کرنے کی حرمتChapter: The Prohibition Of Mutual Jealousy And Hatred, And Turning Away From One Another"
"6527","حَدَّثَنَا حَاجِبُ بْنُ الْوَلِيدِ ، حَدَّثَنَا مُحَمَّدُ بْنُ حَرْبٍ ، حَدَّثَنَا مُحَمَّدُ بْنُ الْوَلِيدِ الزُّبَيْدِيُّ ، عَنْ الزُّهْرِيِّ ، أَخْبَرَنِي أَنَسُ بْنُ مَالِكٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ. ح وحَدَّثَنِيهِ حَرْمَلَةُ بْنُ يَحْيَي ، أَخْبَرَنِي ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، عَنْ أَنَسٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِمِثْلِ حَدِيثِ مَالِكٍ.nصحیح مسلم حدیث: 6527 عربی حدیث: 2558",": Sahih","Sahih Muslim 6527","","","7. باب: حسد اور بغض اور دشمنی کا حرام ہونا۔باب: ایک دوسرے سے حسد، بغض اور روگردانی کرنے کی حرمتChapter: The Prohibition Of Mutual Jealousy And Hatred, And Turning Away From One Another"
"6528","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، وَابْنُ أَبِي عُمَرَ ، وَعَمْرٌو النَّاقِدُ جميعا، عَنْ ابْنِ عُيَيْنَةَ ، عَنْ الزُّهْرِيِّ ، بِهَذَا الْإِسْنَادِ، وَزَادَ ابْنُ عُيَيْنَةَ: وَلَا تَقَاطَعُوا.nصحیح مسلم حدیث: 6528 عربی حدیث: 2558",": Sahih","Sahih Muslim 6528","","","7. باب: حسد اور بغض اور دشمنی کا حرام ہونا۔باب: ایک دوسرے سے حسد، بغض اور روگردانی کرنے کی حرمتChapter: The Prohibition Of Mutual Jealousy And Hatred, And Turning Away From One Another"
"6529","حَدَّثَنَا أَبُو كَامِلٍ ، حَدَّثَنَا يَزِيدُ يَعْنِي ابْنَ زُرَيْعٍ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ رَافِعٍ ، وَعَبْدُ بْنُ حميد كلاهما، عَنْ عَبْدِ الرَّزَّاقِ جَمِيعًا، عَنْ مَعْمَرٍ ، عَنْ الزُّهْرِيِّ بِهَذَا الْإِسْنَادِ، أَمَّا رِوَايَةُ يَزِيدَ عَنْهُ، فَكَرِوَايَةِ سُفْيَانَ، عَنْ الزُّهْرِيِّ، يَذْكُرُ الْخِصَالَ الْأَرْبَعَةَ جَمِيعًا، وَأَمَّا حَدِيثُ عَبْدِ الرَّزَّاقِ: وَلَا تَحَاسَدُوا، وَلَا تَقَاطَعُوا، وَلَا تَدَابَرُوا.nصحیح مسلم حدیث: 6529 عربی حدیث: 2558",": Sahih","Sahih Muslim 6529","","","7. باب: حسد اور بغض اور دشمنی کا حرام ہونا۔باب: ایک دوسرے سے حسد، بغض اور روگردانی کرنے کی حرمتChapter: The Prohibition Of Mutual Jealousy And Hatred, And Turning Away From One Another"
"6530","وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا أَبُو دَاوُدَ ، حَدَّثَنَا شُعْبَةُ ، عَنْ قَتَادَةَ ، عَنْ أَنَسٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَا تَحَاسَدُوا، وَلَا تَبَاغَضُوا، وَلَا تَقَاطَعُوا وَكُونُوا عِبَادَ اللَّهِ إِخْوَانًا \"\".nصحیح مسلم حدیث: 6530 عربی حدیث: 2559",": Sahih","Sahih Muslim 6530","","","7. باب: حسد اور بغض اور دشمنی کا حرام ہونا۔باب: ایک دوسرے سے حسد، بغض اور روگردانی کرنے کی حرمتChapter: The Prohibition Of Mutual Jealousy And Hatred, And Turning Away From One Another"
"6531","حَدَّثَنِيهِ عَلِيُّ بْنُ نَصْرٍ الْجَهْضَمِيُّ ، حَدَّثَنَا وَهْبُ بْنُ جَرِيرٍ ، حَدَّثَنَا شُعْبَةُ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ، وَزَادَ كَمَا أَمَرَكُمُ اللَّهُ.nصحیح مسلم حدیث: 6531 عربی حدیث: 2559",": Sahih","Sahih Muslim 6531","","","7. باب: حسد اور بغض اور دشمنی کا حرام ہونا۔باب: ایک دوسرے سے حسد، بغض اور روگردانی کرنے کی حرمتChapter: The Prohibition Of Mutual Jealousy And Hatred, And Turning Away From One Another"
"6532","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ ابْنِ شِهَابٍ ، عَنْ عَطَاءِ بْنِ يَزِيدَ اللَّيْثِيِّ ، عَنْ أَبِي أَيُّوبَ الْأَنْصَارِيِّ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَا يَحِلُّ لِمُسْلِمٍ أَنْ يَهْجُرَ أَخَاهُ فَوْقَ ثَلَاثِ لَيَالٍ يَلْتَقِيَانِ، فَيُعْرِضُ هَذَا وَيُعْرِضُ هَذَا، وَخَيْرُهُمَا الَّذِي يَبْدَأُ بِالسَّلَامِ \"\".nصحیح مسلم حدیث: 6532 عربی حدیث: 2560",": Sahih","Sahih Muslim 6532","","","8. باب: بغیر عذر شرعی کے تین دن سے زیادہ کسی مسلمان سے خفا رہنا حرام ہے۔باب: شرعی عذر کے بغیر تین دن سے زیادہ تعلق قطع کرنے کی حرمتChapter: The Prohibition Of Forsaking Someone For More Than Three Days For No Legitimate Reason"
"6533","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، وَأَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَزُهَيْرُ بْنُ حَرْبٍ ، قَالُوا: حَدَّثَنَا سُفْيَانُ . ح وحَدَّثَنِي حَرْمَلَةُ بْنُ يَحْيَي ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ . ح وحَدَّثَنَا حَاجِبُ بْنُ الْوَلِيدِ ، حَدَّثَنَا مُحَمَّدُ بْنُ حَرْبٍ ، عَنْ الزُّبَيْدِيِّ . ح وحَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْحَنْظَلِيُّ ، وَمُحَمَّدُ بْنُ رَافِعٍ ، وَعَبْدُ بْنُ حُمَيْدٍ ، عَنْ عَبْدِ الرَّزَّاقِ ، عَنْ مَعْمَرٍ كُلُّهُمْ، عَنْ الزُّهْرِيِّ ، بِإِسْنَادِ مَالِكٍ، وَمِثْلِ حَدِيثِهِ إِلَّا قَوْلَهُ، فَيُعْرِضُ هَذَا وَيُعْرِضُ هَذَا، فَإِنَّهُمْ جَمِيعًا قَالُوا فِي حَدِيثِهِمْ غَيْرَ مَالِكٍ، فَيَصُدُّ هَذَا وَيَصُدُّ هَذَا.nصحیح مسلم حدیث: 6533 عربی حدیث: 2560",": Sahih","Sahih Muslim 6533","","","8. باب: بغیر عذر شرعی کے تین دن سے زیادہ کسی مسلمان سے خفا رہنا حرام ہے۔باب: شرعی عذر کے بغیر تین دن سے زیادہ تعلق قطع کرنے کی حرمتChapter: The Prohibition Of Forsaking Someone For More Than Three Days For No Legitimate Reason"
"6534","حَدَّثَنَا مُحَمَّدُ بْنُ رَافِعٍ ، حَدَّثَنَا مُحَمَّدُ بْنُ أَبِي فُدَيْكٍ ، أَخْبَرَنَا الضَّحَّاكُ وَهُوَ ابْنُ عُثْمَانَ ، عَنْ نَافِعٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَا يَحِلُّ لِلْمُؤْمِنِ أَنْ يَهْجُرَ أَخَاهُ فَوْقَ ثَلَاثَةِ أَيَّامٍ \"\".nصحیح مسلم حدیث: 6534 عربی حدیث: 2561",": Sahih","Sahih Muslim 6534","","","8. باب: بغیر عذر شرعی کے تین دن سے زیادہ کسی مسلمان سے خفا رہنا حرام ہے۔باب: شرعی عذر کے بغیر تین دن سے زیادہ تعلق قطع کرنے کی حرمتChapter: The Prohibition Of Forsaking Someone For More Than Three Days For No Legitimate Reason"
"6535","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا عَبْدُ الْعَزِيزِ يَعْنِي ابْنَ مُحَمَّدٍ ، عَنْ الْعَلَاءِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَا هِجْرَةَ بَعْدَ ثَلَاثٍ \"\".nصحیح مسلم حدیث: 6535 عربی حدیث: 2562",": Sahih","Sahih Muslim 6535","","","8. باب: بغیر عذر شرعی کے تین دن سے زیادہ کسی مسلمان سے خفا رہنا حرام ہے۔باب: شرعی عذر کے بغیر تین دن سے زیادہ تعلق قطع کرنے کی حرمتChapter: The Prohibition Of Forsaking Someone For More Than Three Days For No Legitimate Reason"
"6536","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ أَبِي الزِّنَادِ ، عَنْ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" إِيَّاكُمْ وَالظَّنَّ، فَإِنَّ الظَّنَّ أَكْذَبُ الْحَدِيثِ، وَلَا تَحَسَّسُوا، وَلَا تَجَسَّسُوا، وَلَا تَنَافَسُوا، وَلَا تَحَاسَدُوا، وَلَا تَبَاغَضُوا، وَلَا تَدَابَرُوا، وَكُونُوا عِبَادَ اللَّهِ إِخْوَانًا \"\".nصحیح مسلم حدیث: 6536 عربی حدیث: 2563",": Sahih","Sahih Muslim 6536","","","9. باب: بدگمانی اور ٹوہ لگانا اور رشک کر نا اور دھوکے بازی حرام ہے۔باب: بدگمانی، تجسس، دنیاوی معاملات میں مقابلہ بازی اور دھوکے سے ایک دوسرے کے لیے قیمتیں بڑھانے وغیرہ کی ممانعتChapter: The Prohibition Of Suspicion, Spying, Competition, Artificial Inflation Of Prices, And So On"
"6537","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا عَبْدُ الْعَزِيزِ يَعْنِي ابْنَ مُحَمَّدٍ ، عَنْ الْعَلَاءِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَا تَهَجَّرُوا، وَلَا تَدَابَرُوا، وَلَا تَحَسَّسُوا، وَلَا يَبِعْ بَعْضُكُمْ عَلَى بَيْعِ بَعْضٍ، وَكُونُوا عِبَادَ اللَّهِ إِخْوَانًا \"\".nصحیح مسلم حدیث: 6537 عربی حدیث: 2563",": Sahih","Sahih Muslim 6537","","","9. باب: بدگمانی اور ٹوہ لگانا اور رشک کر نا اور دھوکے بازی حرام ہے۔باب: بدگمانی، تجسس، دنیاوی معاملات میں مقابلہ بازی اور دھوکے سے ایک دوسرے کے لیے قیمتیں بڑھانے وغیرہ کی ممانعتChapter: The Prohibition Of Suspicion, Spying, Competition, Artificial Inflation Of Prices, And So On"
"6538","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا جَرِيرٌ ، عَنْ الْأَعْمَشِ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" لَا تَحَاسَدُوا، وَلَا تَبَاغَضُوا، وَلَا تَجَسَّسُوا، وَلَا تَحَسَّسُوا، وَلَا تَنَاجَشُوا وَكُونُوا عِبَادَ اللَّهِ إِخْوَانًا \"\".nصحیح مسلم حدیث: 6538 عربی حدیث: 2563",": Sahih","Sahih Muslim 6538","","","9. باب: بدگمانی اور ٹوہ لگانا اور رشک کر نا اور دھوکے بازی حرام ہے۔باب: بدگمانی، تجسس، دنیاوی معاملات میں مقابلہ بازی اور دھوکے سے ایک دوسرے کے لیے قیمتیں بڑھانے وغیرہ کی ممانعتChapter: The Prohibition Of Suspicion, Spying, Competition, Artificial Inflation Of Prices, And So On"
"6539","حَدَّثَنَا الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ، وَعَلِيُّ بْنُ نَصْرٍ الْجَهْضَمِيُّ ، قَالَا: حَدَّثَنَا وَهْبُ بْنُ جَرِيرٍ ، حَدَّثَنَا شُعْبَةُ ، عَنْ الْأَعْمَشِ ، بِهَذَا الْإِسْنَادِ: لَا تَقَاطَعُوا، وَلَا تَدَابَرُوا، وَلَا تَبَاغَضُوا، وَلَا تَحَاسَدُوا، وَكُونُوا إِخْوَانًا كَمَا أَمَرَكُمُ اللَّهُ.nصحیح مسلم حدیث: 6539 عربی حدیث: 2563",": Sahih","Sahih Muslim 6539","","","9. باب: بدگمانی اور ٹوہ لگانا اور رشک کر نا اور دھوکے بازی حرام ہے۔باب: بدگمانی، تجسس، دنیاوی معاملات میں مقابلہ بازی اور دھوکے سے ایک دوسرے کے لیے قیمتیں بڑھانے وغیرہ کی ممانعتChapter: The Prohibition Of Suspicion, Spying, Competition, Artificial Inflation Of Prices, And So On"
"6540","وحَدَّثَنِي أَحْمَدُ بْنُ سَعِيدٍ الدَّارِمِيُّ ، حَدَّثَنَا حَبَّانُ ، حَدَّثَنَا وُهَيْبٌ ، حَدَّثَنَا سُهَيْلٌ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَا تَبَاغَضُوا، وَلَا تَدَابَرُوا، وَلَا تَنَافَسُوا، وَكُونُوا عِبَادَ اللَّهِ إِخْوَانًا \"\".nصحیح مسلم حدیث: 6540 عربی حدیث: 2563",": Sahih","Sahih Muslim 6540","","","9. باب: بدگمانی اور ٹوہ لگانا اور رشک کر نا اور دھوکے بازی حرام ہے۔باب: بدگمانی، تجسس، دنیاوی معاملات میں مقابلہ بازی اور دھوکے سے ایک دوسرے کے لیے قیمتیں بڑھانے وغیرہ کی ممانعتChapter: The Prohibition Of Suspicion, Spying, Competition, Artificial Inflation Of Prices, And So On"
"6541","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ بْنِ قَعْنَبٍ ، حَدَّثَنَا دَاوُدُ يَعْنِي ابْنَ قَيْسٍ ، عَنْ أَبِي سَعِيدٍ مَوْلَى عَامِرِ بْنِ كُرَيْزٍ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" لَا تَحَاسَدُوا، وَلَا تَنَاجَشُوا، وَلَا تَبَاغَضُوا، وَلَا تَدَابَرُوا، وَلَا يَبِعْ بَعْضُكُمْ عَلَى بَيْعِ بَعْضٍ، وَكُونُوا عِبَادَ اللَّهِ إِخْوَانًا الْمُسْلِمُ أَخُو الْمُسْلِمِ لَا يَظْلِمُهُ، وَلَا يَخْذُلُهُ، وَلَا يَحْقِرُهُ التَّقْوَى هَاهُنَا، وَيُشِيرُ إِلَى صَدْرِهِ ثَلَاثَ مَرَّاتٍ، بِحَسْبِ امْرِئٍ مِنَ الشَّرِّ أَنْ يَحْقِرَ أَخَاهُ الْمُسْلِمَ كُلُّ الْمُسْلِمِ عَلَى الْمُسْلِمِ، حَرَامٌ دَمُهُ، وَمَالُهُ، وَعِرْضُهُ \"\".nصحیح مسلم حدیث: 6541 عربی حدیث: 2564",": Sahih","Sahih Muslim 6541","","","10. باب: مسلمان پر ظلم کرنا یا اس کو ذلیل کرنا حرام ہے۔باب: مسلمان پر ظلم کرنے، اس کو رسوا کرنے، اس کی تحقیر کرنے اور اس کے خون، اس کی عزت اور اس کے مال کی حرمتChapter: The Prohibition Of Wronging, Forsaking, Or Despising A Muslim And The Inviolability Of His Blood, Honor And Wealth"
"6542","حَدَّثَنِي أَبُو الطَّاهِرِ أَحْمَدُ بْنُ عَمْرِو بْنِ سَرْحٍ ، حَدَّثَنَا ابْنُ وَهْبٍ ، عَنْ أُسَامَةَ وَهُوَ ابْنُ زَيْدٍ ، أَنَّهُ سَمِعَ أَبَا سَعِيدٍ مَوْلَى عَبْدِ اللَّهِ بْنِ عَامِرِ بْنِ كُرَيْزٍ، يَقُولُ: سَمِعْتُ أَبَا هُرَيْرَةَ ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَذَكَرَ نَحْوَ حَدِيثِ دَاوُدَ، وَزَادَ وَنَقَصَ، وَمِمَّا زَادَ فِيهِ: إِنَّ اللَّهَ لَا يَنْظُرُ إِلَى أَجْسَادِكُمْ وَلَا إِلَى صُوَرِكُمْ، وَلَكِنْ يَنْظُرُ إِلَى قُلُوبِكُمْ، وَأَشَارَ بِأَصَابِعِهِ إِلَى صَدْرِهِ.nصحیح مسلم حدیث: 6542 عربی حدیث: 2564",": Sahih","Sahih Muslim 6542","","","10. باب: مسلمان پر ظلم کرنا یا اس کو ذلیل کرنا حرام ہے۔باب: مسلمان پر ظلم کرنے، اس کو رسوا کرنے، اس کی تحقیر کرنے اور اس کے خون، اس کی عزت اور اس کے مال کی حرمتChapter: The Prohibition Of Wronging, Forsaking, Or Despising A Muslim And The Inviolability Of His Blood, Honor And Wealth"
"6543","حَدَّثَنَا عَمْرٌو النَّاقِدُ ، حَدَّثَنَا كَثِيرُ بْنُ هِشَامٍ ، حَدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ ، عَنْ يَزِيدَ بْنِ الْأَصَمِّ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" إِنَّ اللَّهَ لَا يَنْظُرُ إِلَى صُوَرِكُمْ، وَأَمْوَالِكُمْ، وَلَكِنْ يَنْظُرُ إِلَى قُلُوبِكُمْ، وَأَعْمَالِكُمْ \"\".nصحیح مسلم حدیث: 6543 عربی حدیث: 2564",": Sahih","Sahih Muslim 6543","","","10. باب: مسلمان پر ظلم کرنا یا اس کو ذلیل کرنا حرام ہے۔باب: مسلمان پر ظلم کرنے، اس کو رسوا کرنے، اس کی تحقیر کرنے اور اس کے خون، اس کی عزت اور اس کے مال کی حرمتChapter: The Prohibition Of Wronging, Forsaking, Or Despising A Muslim And The Inviolability Of His Blood, Honor And Wealth"
"6544","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، عَنْ مَالِكِ بْنِ أَنَسٍ فِيمَا قُرِئَ عَلَيْهِ، عَنْ سُهَيْلٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" تُفْتَحُ أَبْوَابُ الْجَنَّةِ يَوْمَ الِاثْنَيْنِ، وَيَوْمَ الْخَمِيسِ، فَيُغْفَرُ لِكُلِّ عَبْدٍ لَا يُشْرِكُ بِاللَّهِ شَيْئًا، إِلَّا رَجُلًا كَانَتْ بَيْنَهُ وَبَيْنَ أَخِيهِ شَحْنَاءُ، فَيُقَالُ: أَنْظِرُوا هَذَيْنِ حَتَّى يَصْطَلِحَا، أَنْظِرُوا هَذَيْنِ حَتَّى يَصْطَلِحَا، أَنْظِرُوا هَذَيْنِ حَتَّى يَصْطَلِحَا \"\".nصحیح مسلم حدیث: 6544 عربی حدیث: 2565",": Sahih","Sahih Muslim 6544","","","11. باب: کینہ رکھنے کی ممانعت۔باہمی بغض و عداوت کی ممانعتChapter: The Prohibition Of Holding Grudges"
"6545","حَدَّثَنِيهِ زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا جَرِيرٌ . ح وحَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، وَأَحْمَدُ بْنُ عَبْدَةَ الضَّبِّيُّ ، عَنْ عَبْدِ الْعَزِيزِ الدَّرَاوَرْدِيِّ كِلَاهُمَا، عَنْ سُهَيْلٍ ، عَنْ أَبِيهِ ، بِإِسْنَادِ مَالِكٍ نَحْوَ حَدِيثِهِ، غَيْرَ أَنَّ فِي حَدِيثِ الدَّرَاوَرْدِيِّ: إِلَّا الْمُتَهَاجِرَيْنِ مِنْ رِوَايَةِ ابْنِ عَبْدَةَ، وقَالَ قُتَيْبَةُ: إِلَّا الْمُهْتَجِرَيْنِ.nصحیح مسلم حدیث: 6545 عربی حدیث: 2565",": Sahih","Sahih Muslim 6545","","","11. باب: کینہ رکھنے کی ممانعت۔باہمی بغض و عداوت کی ممانعتChapter: The Prohibition Of Holding Grudges"
"6546","حَدَّثَنَا ابْنُ أَبِي عُمَرَ ، حَدَّثَنَا سُفْيَانُ ، عَنْ مُسْلِمِ بْنِ أَبِي مَرْيَمَ ، عَنْ أَبِي صَالِحٍ ، سَمِعَ أَبَا هُرَيْرَةَ ، رَفَعَهُ مَرَّةً، قَالَ: \"\" تُعْرَضُ الْأَعْمَالُ فِي كُلِّ يَوْمِ خَمِيسٍ، وَاثْنَيْنِ، فَيَغْفِرُ اللَّهُ عَزَّ وَجَلَّ فِي ذَلِكَ الْيَوْمِ لِكُلِّ امْرِئٍ لَا يُشْرِكُ بِاللَّهِ شَيْئًا، إِلَّا امْرَأً كَانَتْ بَيْنَهُ وَبَيْنَ أَخِيهِ شَحْنَاءُ، فَيُقَالُ: ارْكُوا هَذَيْنِ حَتَّى يَصْطَلِحَا، ارْكُوا هَذَيْنِ حَتَّى يَصْطَلِحَا \"\".nصحیح مسلم حدیث: 6546 عربی حدیث: 2565",": Sahih","Sahih Muslim 6546","","","11. باب: کینہ رکھنے کی ممانعت۔باہمی بغض و عداوت کی ممانعتChapter: The Prohibition Of Holding Grudges"
"6547","حَدَّثَنَا أَبُو الطَّاهِرِ ، وَعَمْرُو بْنُ سَوَّادٍ ، قَالَا: أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنَا مَالِكُ بْنُ أَنَسٍ ، عَنْ مُسْلِمِ بْنِ أَبِي مَرْيَمَ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" تُعْرَضُ أَعْمَالُ النَّاسِ فِي كُلِّ جُمُعَةٍ مَرَّتَيْنِ: يَوْمَ الِاثْنَيْنِ، وَيَوْمَ الْخَمِيسِ، فَيُغْفَرُ لِكُلِّ عَبْدٍ مُؤْمِنٍ، إِلَّا عَبْدًا بَيْنَهُ وَبَيْنَ أَخِيهِ شَحْنَاءُ، فَيُقَالُ: اتْرُكُوا، أَوِ ارْكُوا هَذَيْنِ حَتَّى يَفِيئَا \"\".nصحیح مسلم حدیث: 6547 عربی حدیث: 2565",": Sahih","Sahih Muslim 6547","","","11. باب: کینہ رکھنے کی ممانعت۔باہمی بغض و عداوت کی ممانعتChapter: The Prohibition Of Holding Grudges"
"6548","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، عَنْ مَالِكِ بْنِ أَنَسٍ فِيمَا قُرِئَ عَلَيْهِ، عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ مَعْمَرٍ ، عَنْ أَبِي الْحُبَابِ سَعِيدِ بْنِ يَسَارٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" إِنَّ اللَّهَ يَقُولُ يَوْمَ الْقِيَامَةِ: أَيْنَ الْمُتَحَابُّونَ بِجَلَالِي الْيَوْمَ، أُظِلُّهُمْ فِي ظِلِّي يَوْمَ لَا ظِلَّ إِلَّا ظِلِّي \"\".nصحیح مسلم حدیث: 6548 عربی حدیث: 2566",": Sahih","Sahih Muslim 6548","","","12. باب: اللہ تعالیٰ کے واسطے محبت کی فضیلت۔اللہ کی خاطر محبت کرنے کی فضیلتChapter: The Virtue Of Love For The Sake Of Allah, May He Be Exalted"
"6549","حَدَّثَنِي عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ ، عَنْ ثَابِتٍ ، عَنْ أَبِي رَافِعٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" أَنَّ رَجُلًا زَارَ أَخًا لَهُ فِي قَرْيَةٍ أُخْرَى، فَأَرْصَدَ اللَّهُ لَهُ عَلَى مَدْرَجَتِهِ مَلَكًا، فَلَمَّا أَتَى عَلَيْهِ، قَالَ: أَيْنَ تُرِيدُ؟ قَالَ: أُرِيدُ أَخًا لِي فِي هَذِهِ الْقَرْيَةِ، قَالَ: هَلْ لَكَ عَلَيْهِ مِنْ نِعْمَةٍ تَرُبُّهَا؟ قَالَ: لَا، غَيْرَ أَنِّي أَحْبَبْتُهُ فِي اللَّهِ عَزَّ وَجَلَّ، قَالَ: فَإِنِّي رَسُولُ اللَّهِ إِلَيْكَ بِأَنَّ اللَّهَ قَدْ أَحَبَّكَ كَمَا أَحْبَبْتَهُ فِيهِ \"\".nصحیح مسلم حدیث: 6549 عربی حدیث: 2567",": Sahih","Sahih Muslim 6549","","","12. باب: اللہ تعالیٰ کے واسطے محبت کی فضیلت۔اللہ کی خاطر محبت کرنے کی فضیلتChapter: The Virtue Of Love For The Sake Of Allah, May He Be Exalted"
"6550","قَالَ الشَّيْخُ أَبُو أَحْمَدَ، أَخْبَرَنِي أَبُو بَكْرٍ مُحَمَّدُ بْنُ زَنْجُويَةَ الْقُشَيْرِيُّ، حَدَّثَنَا عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، بِهَذَا الْإِسْنَادِ نَحْوَهُ.nصحیح مسلم حدیث: 6550 عربی حدیث: 2567",": Sahih","Sahih Muslim 6550","","","12. باب: اللہ تعالیٰ کے واسطے محبت کی فضیلت۔اللہ کی خاطر محبت کرنے کی فضیلتChapter: The Virtue Of Love For The Sake Of Allah, May He Be Exalted"
"6551","حَدَّثَنَا سَعِيدُ بْنُ مَنْصُورٍ ، وَأَبُو الرَّبِيعِ الزَّهْرَانِيُّ ، قَالَا: حَدَّثَنَا حَمَّادٌ يَعْنِيَانِ ابْنَ زَيْدٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلَابَةَ ، عَنْ أَبِي أَسْمَاءَ ، عَنْ ثَوْبَانَ ، قَالَ أَبُو الرَّبِيعِ: رَفَعَهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَفِي حَدِيثِ سَعِيدٍ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" عَائِدُ الْمَرِيضِ فِي مَخْرَفَةِ الْجَنَّةِ حَتَّى يَرْجِعَ \"\".nصحیح مسلم حدیث: 6551 عربی حدیث: 2568",": Sahih","Sahih Muslim 6551","","","13. باب: بیمار پرستی کا ثواب۔بیمار پرسی کی فضیلتChapter: The Virtue Of Visiting The Sick"
"6552","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي التَّمِيمِيُّ ، أَخْبَرَنَا هُشَيْمٌ ، عَنْ خَالِدٍ ، عَنْ أَبِي قِلَابَةَ ، عَنْ أَبِي أَسْمَاءَ ، عَنْ ثَوْبَانَ مَوْلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" مَنْ عَادَ مَرِيضًا لَمْ يَزَلْ فِي خُرْفَةِ الْجَنَّةِ حَتَّى يَرْجِعَ \"\".nصحیح مسلم حدیث: 6552 عربی حدیث: 2568",": Sahih","Sahih Muslim 6552","","","13. باب: بیمار پرستی کا ثواب۔بیمار پرسی کی فضیلتChapter: The Virtue Of Visiting The Sick"
"6553","حَدَّثَنَا يَحْيَي بْنُ حَبِيبٍ الْحَارِثِيُّ ، حَدَّثَنَا يَزِيدُ بْنُ زُرَيْعٍ ، حَدَّثَنَا خَالِدٌ ، عَنْ أَبِي قِلَابَةَ ، عَنْ أَبِي أَسْمَاءَ الرَّحَبِيِّ ، عَنْ ثَوْبَانَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" إِنَّ الْمُسْلِمَ إِذَا عَادَ أَخَاهُ الْمُسْلِمَ لَمْ يَزَلْ فِي خُرْفَةِ الْجَنَّةِ حَتَّى يَرْجِعَ \"\".nصحیح مسلم حدیث: 6553 عربی حدیث: 2568",": Sahih","Sahih Muslim 6553","","","13. باب: بیمار پرستی کا ثواب۔بیمار پرسی کی فضیلتChapter: The Virtue Of Visiting The Sick"
"6554","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَزُهَيْرُ بْنُ حَرْبٍ جَمِيعًا، عَنْ يَزِيدَ ، وَاللَّفْظُ لِزُهَيْرٍ، حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ، أَخْبَرَنَا عَاصِمٌ الْأَحْوَلُ ، عَنْ عَبْدِ اللَّهِ بْنِ زَيْدٍ وَهُوَ أَبُو قِلَابَةَ ، عَنْ أَبِي الْأَشْعَثِ الصَّنْعَانِيِّ ، عَنْ أَبِي أَسْمَاءَ الرَّحَبِيِّ ، عَنْ ثَوْبَانَمَوْلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، عَنِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" مَنْ عَادَ مَرِيضًا لَمْ يَزَلْ فِي خُرْفَةِ الْجَنَّةِ \"\"، قِيلَ: يَا رَسُولَ اللَّهِ، وَمَا خُرْفَةُ الْجَنَّةِ؟ قَالَ: جَنَاهَا.nصحیح مسلم حدیث: 6554 عربی حدیث: 2568",": Sahih","Sahih Muslim 6554","","","13. باب: بیمار پرستی کا ثواب۔بیمار پرسی کی فضیلتChapter: The Virtue Of Visiting The Sick"
"6555","حَدَّثَنِي سُوَيْدُ بْنُ سَعِيدٍ ، حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِيَةَ ، عَنْ عَاصِمٍ الْأَحْوَلِ ، بِهَذَا الْإِسْنَادِ.nصحیح مسلم حدیث: 6555 عربی حدیث: 2568",": Sahih","Sahih Muslim 6555","","","13. باب: بیمار پرستی کا ثواب۔بیمار پرسی کی فضیلتChapter: The Virtue Of Visiting The Sick"
"6556","حَدَّثَنِي مُحَمَّدُ بْنُ حَاتِمِ بْنِ مَيْمُونٍ ، حَدَّثَنَا بَهْزٌ ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ ، عَنْ ثَابِتٍ ، عَنْ أَبِي رَافِعٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" إِنَّ اللَّهَ عَزَّ وَجَلَّ يَقُولُ يَوْمَ الْقِيَامَةِ: يَا ابْنَ آدَمَ، مَرِضْتُ فَلَمْ تَعُدْنِي، قَالَ يَا رَبِّ: كَيْفَ أَعُودُكَ وَأَنْتَ رَبُّ الْعَالَمِينَ؟ قَالَ: أَمَا عَلِمْتَ أَنَّ عَبْدِي فُلَانًا مَرِضَ فَلَمْ تَعُدْهُ؟ أَمَا عَلِمْتَ أَنَّكَ لَوْ عُدْتَهُ لَوَجَدْتَنِي عِنْدَهُ؟ يَا ابْنَ آدَمَ، اسْتَطْعَمْتُكَ فَلَمْ تُطْعِمْنِي، قَالَ يَا رَبِّ: وَكَيْفَ أُطْعِمُكَ وَأَنْتَ رَبُّ الْعَالَمِينَ؟ قَالَ: أَمَا عَلِمْتَ أَنَّهُ اسْتَطْعَمَكَ عَبْدِي فُلَانٌ؟ فَلَمْ تُطْعِمْهُ، أَمَا عَلِمْتَ أَنَّكَ لَوْ أَطْعَمْتَهُ لَوَجَدْتَ ذَلِكَ عِنْدِي؟ يَا ابْنَ آدَمَ، اسْتَسْقَيْتُكَ فَلَمْ تَسْقِنِي، قَالَ يَا رَبِّ: كَيْفَ أَسْقِيكَ وَأَنْتَ رَبُّ الْعَالَمِينَ؟ قَالَ: اسْتَسْقَاكَ عَبْدِي فُلَانٌ، فَلَمْ تَسْقِهِ، أَمَا إِنَّكَ لَوْ سَقَيْتَهُ وَجَدْتَ ذَلِكَ عِنْدِي؟ \"\".nصحیح مسلم حدیث: 6556 عربی حدیث: 2569",": Sahih","Sahih Muslim 6556","","","13. باب: بیمار پرستی کا ثواب۔بیمار پرسی کی فضیلتChapter: The Virtue Of Visiting The Sick"
"6557","حَدَّثَنَا عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ إِسْحَاقُ: أَخْبَرَنَا، وقَالَ عُثْمَانُ: حَدَّثَنَا جَرِيرٌ ، عَنْ الْأَعْمَشِ ، عَنْ أَبِي وَائِلٍ ، عَنْ مَسْرُوقٍ ، قَالَ: قَالَتْ عَائِشَةُ : \"\" مَا رَأَيْتُ رَجُلًا أَشَدَّ عَلَيْهِ الْوَجَعُ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \"\"، وَفِي رِوَايَةِ عُثْمَانَ مَكَانَ الْوَجَعِ وَجَعًا.nصحیح مسلم حدیث: 6557 عربی حدیث: 2570",": Sahih","Sahih Muslim 6557","","","14. باب: مومن کو کوئی بیماری یا تکلیف پہنچے تو اس کا ثواب۔مومن کو جو بیماری یا غم وغیرہ لاحق ہوتا ہے حتی کہ جو کانٹا چبھتا ہے اس پر (بھی) ثواب ملتا ہےChapter: The Reward Of The Believer For Whatever Befalls Him Of Sickness, Grief And The Like, Even A Thorn That Pricks Him"
"6558","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ ، أَخْبَرَنِي أَبِي . ح وحَدَّثَنَا ابْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا ابْنُ أَبِي عَدِيٍّ . ح وحَدَّثَنِي بِشْرُ بْنُ خَالِدٍ ، أَخْبَرَنَا مُحَمَّدٌ يَعْنِي ابْنَ جَعْفَرٍ كُلُّهُمْ، عَنْ شُعْبَةَ ، عَنْ الْأَعْمَشِ . ح وحَدَّثَنِي أَبُو بَكْرِ بْنُ نَافِعٍ ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ . ح وحَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا مُصْعَبُ بْنُ الْمِقْدَامِ كِلَاهُمَا، عَنْ سُفْيَانَ ، عَنْ الْأَعْمَشِ ، بِإِسْنَادِ جَرِيرٍ مِثْلَ حَدِيثِهِ.nصحیح مسلم حدیث: 6558 عربی حدیث: 2570",": Sahih","Sahih Muslim 6558","","","14. باب: مومن کو کوئی بیماری یا تکلیف پہنچے تو اس کا ثواب۔مومن کو جو بیماری یا غم وغیرہ لاحق ہوتا ہے حتی کہ جو کانٹا چبھتا ہے اس پر (بھی) ثواب ملتا ہےChapter: The Reward Of The Believer For Whatever Befalls Him Of Sickness, Grief And The Like, Even A Thorn That Pricks Him"
"6559","حَدَّثَنَا عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، وَزُهَيْرُ بْنُ حَرْبٍ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ إِسْحَاقُ: أَخْبَرَنَا، وقَالَ الْآخَرَانِ: حَدَّثَنَا جَرِيرٌ ، عَنْ الْأَعْمَشِ ، عَنْ إِبْرَاهِيمَ التَّيْمِيِّ ، عَنْ الْحَارِثِ بْنِ سُوَيْدٍ ، عَنْ عَبْدِ اللَّهِ ، قَالَ: دَخَلْتُ عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُوعَكُ فَمَسِسْتُهُ بِيَدِي، فَقُلْتُ: يَا رَسُولَ اللَّهِ، إِنَّكَ لَتُوعَكُ وَعْكًا شَدِيدًا؟ فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: أَجَلْ، إِنِّي أُوعَكُ كَمَا يُوعَكُ رَجُلَانِ مِنْكُمْ، قَالَ: فَقُلْتُ: ذَلِكَ أَنَّ لَكَ أَجْرَيْنِ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: أَجَلْ، ثُمَّ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" مَا مِنْ مُسْلِمٍ يُصِيبُهُ أَذًى مِنْ مَرَضٍ فَمَا سِوَاهُ، إِلَّا حَطَّ اللَّهُ بِهِ سَيِّئَاتِهِ كَمَا تَحُطُّ الشَّجَرَةُ وَرَقَهَا \"\"، وَلَيْسَ فِي حَدِيثِ زُهَيْرٍ: فَمَسِسْتُهُ بِيَدِي.nصحیح مسلم حدیث: 6559 عربی حدیث: 2571",": Sahih","Sahih Muslim 6559","","","14. باب: مومن کو کوئی بیماری یا تکلیف پہنچے تو اس کا ثواب۔مومن کو جو بیماری یا غم وغیرہ لاحق ہوتا ہے حتی کہ جو کانٹا چبھتا ہے اس پر (بھی) ثواب ملتا ہےChapter: The Reward Of The Believer For Whatever Befalls Him Of Sickness, Grief And The Like, Even A Thorn That Pricks Him"
"6560","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، قَالَا: حَدَّثَنَا أَبُو مُعَاوِيَةَ . ح وحَدَّثَنِي مُحَمَّدُ بْنُ رَافِعٍ ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، حَدَّثَنَا سُفْيَانُ . ح وحَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا عِيسَى بْنُ يُونُسَ ، وَيَحْيَي بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي غَنِيَّةَ كُلُّهُمْ، عَنْ الْأَعْمَشِ ، بِإِسْنَادِ جَرِيرٍ نَحْوَ حَدِيثِهِ، وَزَادَ فِي حَدِيثِ أَبِي مُعَاوِيَةَ، قَالَ: نَعَمْ، وَالَّذِي نَفْسِي بِيَدِهِ مَا عَلَى الْأَرْضِ مُسْلِمٌ.nصحیح مسلم حدیث: 6560 عربی حدیث: 2571",": Sahih","Sahih Muslim 6560","","","14. باب: مومن کو کوئی بیماری یا تکلیف پہنچے تو اس کا ثواب۔مومن کو جو بیماری یا غم وغیرہ لاحق ہوتا ہے حتی کہ جو کانٹا چبھتا ہے اس پر (بھی) ثواب ملتا ہےChapter: The Reward Of The Believer For Whatever Befalls Him Of Sickness, Grief And The Like, Even A Thorn That Pricks Him"
"6561","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ جميعا، عَنْ جَرِيرٍ ، قَالَ زُهَيْرٌ: حَدَّثَنَا جَرِيرٌ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ الْأَسْوَدِ ، قَالَ: دَخَلَ شَبَابٌ مِنْ قُرَيْشٍ عَلَى عَائِشَةَ وَهِيَ بِمِنًى وَهُمْ يَضْحَكُونَ، فَقَالَتْ: مَا يُضْحِكُكُمْ؟ قَالُوا: فُلَانٌ خَرَّ عَلَى طُنُبِ فُسْطَاطٍ فَكَادَتْ عُنُقُهُ، أَوْ عَيْنُهُ أَنْ تَذْهَبَ، فَقَالَتْ: لَا تَضْحَكُوا، فَإِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" مَا مِنْ مُسْلِمٍ يُشَاكُ شَوْكَةً فَمَا فَوْقَهَا إِلَّا كُتِبَتْ لَهُ بِهَا دَرَجَةٌ وَمُحِيَتْ عَنْهُ بِهَا خَطِيئَةٌ \"\".nصحیح مسلم حدیث: 6561 عربی حدیث: 2572",": Sahih","Sahih Muslim 6561","","","14. باب: مومن کو کوئی بیماری یا تکلیف پہنچے تو اس کا ثواب۔مومن کو جو بیماری یا غم وغیرہ لاحق ہوتا ہے حتی کہ جو کانٹا چبھتا ہے اس پر (بھی) ثواب ملتا ہےChapter: The Reward Of The Believer For Whatever Befalls Him Of Sickness, Grief And The Like, Even A Thorn That Pricks Him"
"6562","وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ وَاللَّفْظُ لَهُمَا، وحَدَّثَنَا إِسْحَاقُ الْحَنْظَلِيُّ ، قَالَ إِسْحَاقُ: أَخْبَرَنَا، وقَالَ الْآخَرَانِ: حَدَّثَنَا أَبُو مُعَاوِيَةَ ، عَنْ الْأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ الْأَسْوَدِ ، عَنْ عَائِشَةَ ، قَالَتْ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" مَا يُصِيبُ الْمُؤْمِنَ مِنْ شَوْكَةٍ فَمَا فَوْقَهَا إِلَّا رَفَعَهُ اللَّهُ بِهَا دَرَجَةً، أَوْ حَطَّ عَنْهُ بِهَا خَطِيئَةً \"\".nصحیح مسلم حدیث: 6562 عربی حدیث: 2572",": Sahih","Sahih Muslim 6562","","","14. باب: مومن کو کوئی بیماری یا تکلیف پہنچے تو اس کا ثواب۔مومن کو جو بیماری یا غم وغیرہ لاحق ہوتا ہے حتی کہ جو کانٹا چبھتا ہے اس پر (بھی) ثواب ملتا ہےChapter: The Reward Of The Believer For Whatever Befalls Him Of Sickness, Grief And The Like, Even A Thorn That Pricks Him"
"6563","حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا هِشَامٌ ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ ، قَالَتْ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" لَا تُصِيبُ الْمُؤْمِنَ شَوْكَةٌ فَمَا فَوْقَهَا إِلَّا قَصَّ اللَّهُ بِهَا مِنْ خَطِيئَتِهِ \"\".nصحیح مسلم حدیث: 6563 عربی حدیث: 2572",": Sahih","Sahih Muslim 6563","","","14. باب: مومن کو کوئی بیماری یا تکلیف پہنچے تو اس کا ثواب۔مومن کو جو بیماری یا غم وغیرہ لاحق ہوتا ہے حتی کہ جو کانٹا چبھتا ہے اس پر (بھی) ثواب ملتا ہےChapter: The Reward Of The Believer For Whatever Befalls Him Of Sickness, Grief And The Like, Even A Thorn That Pricks Him"
"6564","حَدَّثَنَا أَبُو كُرَيْبٍ ، حَدَّثَنَا أَبُو مُعَاوِيَةَ ، حَدَّثَنَا هِشَامٌ ، بِهَذَا الْإِسْنَادِ.nصحیح مسلم حدیث: 6564 عربی حدیث: 2572",": Sahih","Sahih Muslim 6564","","","14. باب: مومن کو کوئی بیماری یا تکلیف پہنچے تو اس کا ثواب۔مومن کو جو بیماری یا غم وغیرہ لاحق ہوتا ہے حتی کہ جو کانٹا چبھتا ہے اس پر (بھی) ثواب ملتا ہےChapter: The Reward Of The Believer For Whatever Befalls Him Of Sickness, Grief And The Like, Even A Thorn That Pricks Him"
"6565","حَدَّثَنِي أَبُو الطَّاهِرِ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي مَالِكُ بْنُ أَنَسٍ ، وَيُونُسُ بْنُ يَزِيدَ ، عَنْ ابْنِ شِهَابٍ ، عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ ، عَنْ عَائِشَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" مَا مِنْ مُصِيبَةٍ يُصَابُ بِهَا الْمُسْلِمُ إِلَّا كُفِّرَ بِهَا عَنْهُ حَتَّى الشَّوْكَةِ يُشَاكُهَا \"\".nصحیح مسلم حدیث: 6565 عربی حدیث: 2572",": Sahih","Sahih Muslim 6565","","","14. باب: مومن کو کوئی بیماری یا تکلیف پہنچے تو اس کا ثواب۔مومن کو جو بیماری یا غم وغیرہ لاحق ہوتا ہے حتی کہ جو کانٹا چبھتا ہے اس پر (بھی) ثواب ملتا ہےChapter: The Reward Of The Believer For Whatever Befalls Him Of Sickness, Grief And The Like, Even A Thorn That Pricks Him"
"6566","حَدَّثَنَا أَبُو الطَّاهِرِ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي مَالِكُ بْنُ أَنَسٍ ، عَنْ يَزِيدَ بْنِ خُصَيْفَةَ ، عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ ، عَنْ عَائِشَةَ زَوْجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَا يُصِيبُ الْمُؤْمِنَ مِنْ مُصِيبَةٍ حَتَّى الشَّوْكَةِ، إِلَّا قُصَّ بِهَا مِنْ خَطَايَاهُ أَوْ كُفِّرَ بِهَا مِنْ خَطَايَاهُ، لَا يَدْرِي يَزِيدُ أَيَّتُهُمَا \"\"، قَالَ: عُرْوَةُ.nصحیح مسلم حدیث: 6566 عربی حدیث: 2572",": Sahih","Sahih Muslim 6566","","","14. باب: مومن کو کوئی بیماری یا تکلیف پہنچے تو اس کا ثواب۔مومن کو جو بیماری یا غم وغیرہ لاحق ہوتا ہے حتی کہ جو کانٹا چبھتا ہے اس پر (بھی) ثواب ملتا ہےChapter: The Reward Of The Believer For Whatever Befalls Him Of Sickness, Grief And The Like, Even A Thorn That Pricks Him"
"6567","حَدَّثَنِي حَرْمَلَةُ بْنُ يَحْيَي ، أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، أَخْبَرَنَا حَيْوَةُ ، حَدَّثَنَا ابْنُ الْهَادِ ، عَنْ أَبِي بَكْرِ بْنِ حَزْمٍ ، عَنْ عَمْرَةَ ، عَنْ عَائِشَةَ ، قَالَتْ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \"\" مَا مِنْ شَيْءٍ يُصِيبُ الْمُؤْمِنَ حَتَّى الشَّوْكَةِ تُصِيبُهُ إِلَّا كَتَبَ اللَّهُ لَهُ بِهَا حَسَنَةً، أَوْ حُطَّتْ عَنْهُ بِهَا خَطِيئَةٌ \"\".nصحیح مسلم حدیث: 6567 عربی حدیث: 2572",": Sahih","Sahih Muslim 6567","","","14. باب: مومن کو کوئی بیماری یا تکلیف پہنچے تو اس کا ثواب۔مومن کو جو بیماری یا غم وغیرہ لاحق ہوتا ہے حتی کہ جو کانٹا چبھتا ہے اس پر (بھی) ثواب ملتا ہےChapter: The Reward Of The Believer For Whatever Befalls Him Of Sickness, Grief And The Like, Even A Thorn That Pricks Him"
"6568","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، قَالَا: حَدَّثَنَا أَبُو أُسَامَةَ ، عَنْ الْوَلِيدِ بْنِ كَثِيرٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، عَنْ أَبِي سَعِيدٍ ، وَأَبِى هُرَيْرَةَ ، أَنَّهُمَا سَمِعَا رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \"\" مَا يُصِيبُ الْمُؤْمِنَ مِنْ وَصَبٍ وَلَا نَصَبٍ وَلَا سَقَمٍ وَلَا حَزَنٍ، حَتَّى الْهَمِّ يُهَمُّهُ إِلَّا كُفِّرَ بِهِ مِنْ سَيِّئَاتِهِ \"\".nصحیح مسلم حدیث: 6568 عربی حدیث: 2573",": Sahih","Sahih Muslim 6568","","","14. باب: مومن کو کوئی بیماری یا تکلیف پہنچے تو اس کا ثواب۔مومن کو جو بیماری یا غم وغیرہ لاحق ہوتا ہے حتی کہ جو کانٹا چبھتا ہے اس پر (بھی) ثواب ملتا ہےChapter: The Reward Of The Believer For Whatever Befalls Him Of Sickness, Grief And The Like, Even A Thorn That Pricks Him"
"6569","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، وَأَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ كِلَاهُمَا، عَنْ ابْنِ عُيَيْنَةَ وَاللَّفْظُ لِقُتَيْبَةَ، حَدَّثَنَا سُفْيَانُ، عَنْ ابْنِ مُحَيْصِنٍ ، شَيْخٍ مِنْ قُرَيْشٍ، سَمِعَ مُحَمَّدَ بْنَ قَيْسِ بْنِ مَخْرَمَةَ يُحَدِّثُ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: لَمَّا نَزَلَتْ: مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ سورة النساء آية 123، بَلَغَتْ مِنَ الْمُسْلِمِينَ مَبْلَغًا شَدِيدًا، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" قَارِبُوا وَسَدِّدُوا، فَفِي كُلِّ مَا يُصَابُ بِهِ الْمُسْلِمُ كَفَّارَةٌ حَتَّى النَّكْبَةِ يُنْكَبُهَا، أَوِ الشَّوْكَةِ يُشَاكُهَا \"\"، قَالَ مُسْلِم: هُوَ عُمَرُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ مُحَيْصِنٍ مِنْ أَهْلِ مَكَّةَ.nصحیح مسلم حدیث: 6569 عربی حدیث: 2574",": Sahih","Sahih Muslim 6569","","","14. باب: مومن کو کوئی بیماری یا تکلیف پہنچے تو اس کا ثواب۔مومن کو جو بیماری یا غم وغیرہ لاحق ہوتا ہے حتی کہ جو کانٹا چبھتا ہے اس پر (بھی) ثواب ملتا ہےChapter: The Reward Of The Believer For Whatever Befalls Him Of Sickness, Grief And The Like, Even A Thorn That Pricks Him"
"6570","حَدَّثَنِي عُبَيْدُ اللَّهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ، حَدَّثَنَا يَزِيدُ بْنُ زُرَيْعٍ ، حَدَّثَنَا الْحَجَّاجُ الصَّوَّافُ ، حَدَّثَنِي أَبُو الزُّبَيْرِ ، حَدَّثَنَا جَابِرُ بْنُ عَبْدِ اللَّهِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ دَخَلَ عَلَى أُمِّ السَّائِبِ، أَوْ أُمِّ الْمُسَيَّبِ، فَقَالَ: مَا لَكِ يَا أُمَّ السَّائِبِ، أَوْ يَا أُمَّ الْمُسَيَّبِ تُزَفْزِفِينَ؟ قَالَتْ: الْحُمَّى لَا بَارَكَ اللَّهُ فِيهَا، فَقَالَ: \"\" لَا تَسُبِّي الْحُمَّى، فَإِنَّهَا تُذْهِبُ خَطَايَا بَنِي آدَمَ كَمَا يُذْهِبُ الْكِيرُ خَبَثَ الْحَدِيدِ \"\".nصحیح مسلم حدیث: 6570 عربی حدیث: 2575",": Sahih","Sahih Muslim 6570","","","14. باب: مومن کو کوئی بیماری یا تکلیف پہنچے تو اس کا ثواب۔مومن کو جو بیماری یا غم وغیرہ لاحق ہوتا ہے حتی کہ جو کانٹا چبھتا ہے اس پر (بھی) ثواب ملتا ہےChapter: The Reward Of The Believer For Whatever Befalls Him Of Sickness, Grief And The Like, Even A Thorn That Pricks Him"
"6571","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ، حَدَّثَنَا يَحْيَي بْنُ سَعِيدٍ ، وَبِشْرُ بْنُ الْمُفَضَّلِ ، قَالَا: حَدَّثَنَا عِمْرَانُ أَبُو بَكَرٍ ، حَدَّثَنِي عَطَاءُ بْنُ أَبِي رَبَاحٍ ، قَالَ: قَالَ لِي ابْنُ عَبَّاسٍ : \"\" أَلَا أُرِيكَ امْرَأَةً مِنْ أَهْلِ الْجَنَّةِ؟ قُلْتُ: بَلَى، قَالَ: هَذِهِ الْمَرْأَةُ السَّوْدَاءُ أَتَتِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَتْ: إِنِّي أُصْرَعُ وَإِنِّي أَتَكَشَّفُ، فَادْعُ اللَّهَ لِي، قَالَ: إِنْ شِئْتِ صَبَرْتِ وَلَكِ الْجَنَّةُ، وَإِنْ شِئْتِ دَعَوْتُ اللَّهَ أَنْ يُعَافِيَكِ، قَالَتْ: أَصْبِرُ، قَالَتْ: فَإِنِّي أَتَكَشَّفُ فَادْعُ اللَّهَ أَنْ لَا أَتَكَشَّفَ، فَدَعَا لَهَا \"\".nصحیح مسلم حدیث: 6571 عربی حدیث: 2576",": Sahih","Sahih Muslim 6571","","","14. باب: مومن کو کوئی بیماری یا تکلیف پہنچے تو اس کا ثواب۔مومن کو جو بیماری یا غم وغیرہ لاحق ہوتا ہے حتی کہ جو کانٹا چبھتا ہے اس پر (بھی) ثواب ملتا ہےChapter: The Reward Of The Believer For Whatever Befalls Him Of Sickness, Grief And The Like, Even A Thorn That Pricks Him"
"6572","حَدَّثَنَا حَدَّثَنَا عَبْدُ اللَّهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ بَهْرَامَ الدَّارِمِيُّ ، حَدَّثَنَا مَرْوَانُ يَعْنِي ابْنَ مُحَمَّدٍ الدِّمَشْقِيَّ ، حَدَّثَنَا سَعِيدُ بْنُ عَبْدِ الْعَزِيزِ ، عَنْ رَبِيعَةَ بْنِ يَزِيدَ ، عَنْ أَبِي إِدْرِيسَ الْخَوْلَانِيِّ ، عَنْ أَبِي ذَرٍّ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيمَا رَوَى، عَنِ اللَّهِ تَبَارَكَ وَتَعَالَى، أَنَّهُ قَالَ: \"\" يَا عِبَادِي: إِنِّي حَرَّمْتُ الظُّلْمَ عَلَى نَفْسِي وَجَعَلْتُهُ بَيْنَكُمْ مُحَرَّمًا، فَلَا تَظَالَمُوا، يَا عِبَادِي: كُلُّكُمْ ضَالٌّ إِلَّا مَنْ هَدَيْتُهُ، فَاسْتَهْدُونِي أَهْدِكُمْ، يَا عِبَادِي: كُلُّكُمْ جَائِعٌ إِلَّا مَنْ أَطْعَمْتُهُ، فَاسْتَطْعِمُونِي أُطْعِمْكُمْ، يَا عِبَادِي: كُلُّكُمْ عَارٍ إِلَّا مَنْ كَسَوْتُهُ، فَاسْتَكْسُونِي أَكْسُكُمْ، يَا عِبَادِي: إِنَّكُمْ تُخْطِئُونَ بِاللَّيْلِ وَالنَّهَارِ وَأَنَا أَغْفِرُ الذُّنُوبَ جَمِيعًا، فَاسْتَغْفِرُونِي أَغْفِرْ لَكُمْ، يَا عِبَادِي: إِنَّكُمْ لَنْ تَبْلُغُوا ضَرِّي، فَتَضُرُّونِي وَلَنْ تَبْلُغُوا نَفْعِي، فَتَنْفَعُونِي، يَا عِبَادِي: لَوْ أَنَّ أَوَّلَكُمْ وَآخِرَكُمْ، وَإِنْسَكُمْ وَجِنَّكُمْ، كَانُوا عَلَى أَتْقَى قَلْبِ رَجُلٍ وَاحِدٍ مِنْكُمْ، مَا زَادَ ذَلِكَ فِي مُلْكِي شَيْئًا، يَا عِبَادِي: لَوْ أَنَّ أَوَّلَكُمْ وَآخِرَكُمْ، وَإِنْسَكُمْ وَجِنَّكُمْ، كَانُوا عَلَى أَفْجَرِ قَلْبِ رَجُلٍ وَاحِدٍ، مَا نَقَصَ ذَلِكَ مِنْ مُلْكِي شَيْئًا، يَا عِبَادِي: لَوْ أَنَّ أَوَّلَكُمْ وَآخِرَكُمْ، وَإِنْسَكُمْ وَجِنَّكُمْ، قَامُوا فِي صَعِيدٍ وَاحِدٍ، فَسَأَلُونِي فَأَعْطَيْتُ كُلَّ إِنْسَانٍ مَسْأَلَتَهُ مَا نَقَصَ ذَلِكَ مِمَّا عِنْدِي، إِلَّا كَمَا يَنْقُصُ الْمِخْيَطُ إِذَا أُدْخِلَ الْبَحْرَ، يَا عِبَادِي: إِنَّمَا هِيَ أَعْمَالُكُمْ أُحْصِيهَا لَكُمْ، ثُمَّ أُوَفِّيكُمْ إِيَّاهَا فَمَنْ وَجَدَ خَيْرًا فَلْيَحْمَدِ اللَّهَ، وَمَنْ وَجَدَ غَيْرَ ذَلِكَ فَلَا يَلُومَنَّ إِلَّا نَفْسَهُ \"\"، قَالَ سَعِيدٌ: كَانَ أَبُو إِدْرِيسَ الْخَوْلَانِيُّ إِذَا حَدَّثَ بِهَذَا الْحَدِيثِ جَثَا عَلَى رُكْبَتَيْهِ.nصحیح مسلم حدیث: 6572 عربی حدیث: 2577",": Sahih","Sahih Muslim 6572","","","15. باب: ظلم کرنا حرام ہے۔ظلم کرنے کی حرمتChapter: The Prohibition Of Oppression"
"6573","حَدَّثَنِيهِ أَبُو بَكْرِ بْنُ إِسْحَاقَ ، حَدَّثَنَا أَبُو مُسْهِرٍ ، حَدَّثَنَا سَعِيدُ بْنُ عَبْدِ الْعَزِيزِ ، بِهَذَا الْإِسْنَادِ، غَيْرَ أَنَّ مَرْوَانَ أَتَمُّهُمَا حَدِيثًا،nصحیح مسلم حدیث: 6573 عربی حدیث: 2577",": Sahih","Sahih Muslim 6573","","","15. باب: ظلم کرنا حرام ہے۔ظلم کرنے کی حرمتChapter: The Prohibition Of Oppression"
"6574","قَالَ أَبُو إِسْحَاقَ حَدَّثَنَا بِهَذَا الْحَدِيثِ الْحَسَنُ، وَالْحُسَيْنُ ابْنَا بِشْرٍ، وَمُحَمَّدُ بْنُ يَحْيَي، قَالُوا: حَدَّثَنَا أَبُو مُسْهِرٍ، فَذَكَرُوا الْحَدِيثَ بِطُولِهِ.nصحیح مسلم حدیث: 6574 عربی حدیث: 2577",": Sahih","Sahih Muslim 6574","","","15. باب: ظلم کرنا حرام ہے۔ظلم کرنے کی حرمتChapter: The Prohibition Of Oppression"
"6575","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، وَمُحَمَّدُ بْنُ الْمُثَنَّى كلاهما، عَنْ عَبْدِ الصَّمَدِ بْنِ عَبْدِ الْوَارِثِ ، حَدَّثَنَا هَمَّامٌ ، حَدَّثَنَا قَتَادَةُ ، عَنْ أَبِي قِلَابَةَ ، عَنْ أَبِي أَسْمَاءَ ، عَنْ أَبِي ذَرٍّ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيمَا يَرْوِي عَنْ رَبِّهِ تَبَارَكَ وَتَعَالَى: إِنِّي حَرَّمْتُ عَلَى نَفْسِي الظُّلْمَ، وَعَلَى عِبَادِي فَلَا تَظَالَمُوا، وَسَاقَ الْحَدِيثَ بِنَحْوِهِ، وَحَدِيثُ أَبِي إِدْرِيسَ الَّذِي ذَكَرْنَاهُ أَتَمُّ مِنْ هَذَا.nصحیح مسلم حدیث: 6575 عربی حدیث: 2577",": Sahih","Sahih Muslim 6575","","","15. باب: ظلم کرنا حرام ہے۔ظلم کرنے کی حرمتChapter: The Prohibition Of Oppression"
"6576","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ بْنِ قَعْنَبٍ ، حَدَّثَنَا دَاوُدُ يَعْنِي ابْنَ قَيْسٍ ، عَنْ عُبَيْدِ اللَّهِ بْنِ مِقْسَمٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" اتَّقُوا الظُّلْمَ، فَإِنَّ الظُّلْمَ ظُلُمَاتٌ يَوْمَ الْقِيَامَةِ، وَاتَّقُوا الشُّحَّ، فَإِنَّ الشُّحَّ أَهْلَكَ مَنْ كَانَ قَبْلَكُمْ حَمَلَهُمْ عَلَى أَنْ سَفَكُوا دِمَاءَهُمْ وَاسْتَحَلُّوا مَحَارِمَهُمْ \"\".nصحیح مسلم حدیث: 6576 عربی حدیث: 2578",": Sahih","Sahih Muslim 6576","","","15. باب: ظلم کرنا حرام ہے۔ظلم کرنے کی حرمتChapter: The Prohibition Of Oppression"
"6577","حَدَّثَنِي مُحَمَّدُ بْنُ حَاتِمٍ ، حَدَّثَنَا شَبَابَةُ ، حَدَّثَنَا عَبْدُ الْعَزِيزِ الْمَاجِشُونُ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، عَنْ ابْنِ عُمَرَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" إِنَّ الظُّلْمَ ظُلُمَاتٌ يَوْمَ الْقِيَامَةِ \"\".nصحیح مسلم حدیث: 6577 عربی حدیث: 2579",": Sahih","Sahih Muslim 6577","","","15. باب: ظلم کرنا حرام ہے۔ظلم کرنے کی حرمتChapter: The Prohibition Of Oppression"
"6578","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ ، عَنْ عُقَيْلٍ ، عَنْ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنْ أَبِيهِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" الْمُسْلِمُ أَخُو الْمُسْلِمِ لَا يَظْلِمُهُ، وَلَا يُسْلِمُهُ مَنْ كَانَ فِي حَاجَةِ أَخِيهِ كَانَ اللَّهُ فِي حَاجَتِهِ، وَمَنْ فَرَّجَ عَنْ مُسْلِمٍ كُرْبَةً فَرَّجَ اللَّهُ عَنْهُ بِهَا كُرْبَةً مِنْ كُرَبِ يَوْمِ الْقِيَامَةِ، وَمَنْ سَتَرَ مُسْلِمًا سَتَرَهُ اللَّهُ يَوْمَ الْقِيَامَةِ \"\".nصحیح مسلم حدیث: 6578 عربی حدیث: 2580",": Sahih","Sahih Muslim 6578","","","15. باب: ظلم کرنا حرام ہے۔ظلم کرنے کی حرمتChapter: The Prohibition Of Oppression"
"6579","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، وَعَلِيُّ بْنُ حُجْرٍ ، قَالَا: حَدَّثَنَا إِسْمَاعِيلُ وَهُوَ ابْنُ جَعْفَرٍ ، عَنْ الْعَلَاءِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: أَتَدْرُونَ مَا الْمُفْلِسُ؟ قَالُوا: الْمُفْلِسُ فِينَا مَنْ لَا دِرْهَمَ لَهُ وَلَا مَتَاعَ، فَقَالَ: \"\" إِنَّ الْمُفْلِسَ مِنْ أُمَّتِي يَأْتِي يَوْمَ الْقِيَامَةِ بِصَلَاةٍ، وَصِيَامٍ، وَزَكَاةٍ، وَيَأْتِي قَدْ شَتَمَ هَذَا، وَقَذَفَ هَذَا، وَأَكَلَ مَالَ هَذَا، وَسَفَكَ دَمَ هَذَا، وَضَرَبَ هَذَا، فَيُعْطَى هَذَا مِنْ حَسَنَاتِهِ، وَهَذَا مِنْ حَسَنَاتِهِ، فَإِنْ فَنِيَتْ حَسَنَاتُهُ قَبْلَ أَنْ يُقْضَى مَا عَلَيْهِ أُخِذَ مِنْ خَطَايَاهُمْ، فَطُرِحَتْ عَلَيْهِ ثُمَّ طُرِحَ فِي النَّارِ \"\".nصحیح مسلم حدیث: 6579 عربی حدیث: 2581",": Sahih","Sahih Muslim 6579","","","15. باب: ظلم کرنا حرام ہے۔ظلم کرنے کی حرمتChapter: The Prohibition Of Oppression"
"6580","حَدَّثَنَا يَحْيَي بْنُ أَيُّوبَ ، وَقُتَيْبَةُ ، وَابْنُ حُجْرٍ ، قَالُوا: حَدَّثَنَا إِسْمَاعِيلُ يَعْنُونَ ابْنَ جَعْفَرٍ ، عَنْ الْعَلَاءِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَتُؤَدُّنَّ الْحُقُوقَ إِلَى أَهْلِهَا يَوْمَ الْقِيَامَةِ حَتَّى يُقَادَ لِلشَّاةِ الْجَلْحَاءِ مِنَ الشَّاةِ الْقَرْنَاءِ \"\".nصحیح مسلم حدیث: 6580 عربی حدیث: 2582",": Sahih","Sahih Muslim 6580","","","15. باب: ظلم کرنا حرام ہے۔ظلم کرنے کی حرمتChapter: The Prohibition Of Oppression"
"6581","حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، حَدَّثَنَا أَبُو مُعَاوِيَةَ ، حَدَّثَنَا بُرَيْدُ بْنُ أَبِي بُرْدَةَ ، عَنْ أَبِيهِ ، عَنْ أَبِي مُوسَى ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" إِنَّ اللَّهَ عَزَّ وَجَلَّ يُمْلِي لِلظَّالِمِ، فَإِذَا أَخَذَهُ لَمْ يُفْلِتْهُ، ثُمَّ قَرَأَ، وَكَذَلِكَ أَخْذُ رَبِّكَ إِذَا أَخَذَ الْقُرَى وَهِيَ ظَالِمَةٌ إِنَّ أَخْذَهُ أَلِيمٌ شَدِيدٌ \"\".nصحیح مسلم حدیث: 6581 عربی حدیث: 2583",": Sahih","Sahih Muslim 6581","","","15. باب: ظلم کرنا حرام ہے۔ظلم کرنے کی حرمتChapter: The Prohibition Of Oppression"
"6582","حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ بْنِ يُونُسَ ، حَدَّثَنَا زُهَيْرٌ ، حَدَّثَنَا أَبُو الزُّبَيْرِ ، عَنْ جَابِرٍ ، قَالَ: اقْتَتَلَ غُلَامَانِ غُلَامٌ مِنْ الْمُهَاجِرِينَ، وَغُلَامٌ مِنْ الْأَنْصَارِ، فَنَادَى الْمُهَاجِرُ أَوْ الْمُهَاجِرُونَ: يَا لَلْمُهَاجِرِينَ، وَنَادَى الْأَنْصَارِيُّ: يَا لَلْأَنْصَارِ، فَخَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: مَا هَذَا دَعْوَى أَهْلِ الْجَاهِلِيَّةِ؟ قَالُوا: لَا يَا رَسُولَ اللَّهِ، إِلَّا أَنَّ غُلَامَيْنِ اقْتَتَلَا فَكَسَعَ أَحَدُهُمَا الْآخَرَ، قَالَ: \"\" فَلَا بَأْسَ وَلْيَنْصُرِ الرَّجُلُ أَخَاهُ ظَالِمًا أَوْ مَظْلُومًا، إِنْ كَانَ ظَالِمًا فَلْيَنْهَهُ فَإِنَّهُ لَهُ نَصْرٌ، وَإِنْ كَانَ مَظْلُومًا فَلْيَنْصُرْهُ \"\".nصحیح مسلم حدیث: 6582 عربی حدیث: 2584",": Sahih","Sahih Muslim 6582","","","16. باب: اپنے بھائی کی مدد کر ظالم ہو یا مظلوم ہر حال میں کرنے سے کیا مراد ہے۔بھائی کی مدد کرنا وہ ظالم ہو یا مظلومChapter: Supporting One's Brother Whether He Is Doing Wrong Or Being Wronged"
"6583","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَزُهَيْرُ بْنُ حَرْبٍ ، وَأَحْمَدُ بْنُ عَبْدَةَ الضَّبِّيُّ ، وَابْنُ أَبِي عُمَرَ وَاللَّفْظُ لِابْنِ أَبِي شَيْبَةَ، قَالَ ابْنُ عَبْدَةَ: أَخْبَرَنَا، وقَالَ الْآخَرُونَ: حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، قَالَ: سَمِعَ عَمْرٌو جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: \"\" كُنَّا مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي غَزَاةٍ، فَكَسَعَ رَجُلٌ مِنْ الْمُهَاجِرِينَ رَجُلًا مِنْ الْأَنْصَارِ، فَقَالَ الْأَنْصَارِيُّ: يَا لَلْأَنْصَارِ، وَقَالَ الْمُهَاجِرِيُّ: يَا لَلْمُهَاجِرِينَ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: مَا بَالُ دَعْوَى الْجَاهِلِيَّةِ؟ قَالُوا: يَا رَسُولَ اللَّهِ، كَسَعَ رَجُلٌ مِنْ الْمُهَاجِرِينَ رَجُلًا مِنْ الْأَنْصَارِ، فَقَالَ: دَعُوهَا فَإِنَّهَا مُنْتِنَةٌ، فَسَمِعَهَا عَبْدُ اللَّهِ بْنُ أُبَيٍّ، فَقَالَ: قَدْ فَعَلُوهَا وَاللَّهِ لَئِنْ رَجَعْنَا إِلَى الْمَدِينَةِ لَيُخْرِجَنَّ الْأَعَزُّ مِنْهَا الْأَذَلَّ، قَالَ عُمَرُ: دَعْنِي أَضْرِبُ عُنُقَ هَذَا الْمُنَافِقِ، فَقَالَ: دَعْهُ لَا يَتَحَدَّثُ النَّاسُ أَنَّ مُحَمَّدًا يَقْتُلُ أَصْحَابَهُ \"\".nصحیح مسلم حدیث: 6583 عربی حدیث: 2584",": Sahih","Sahih Muslim 6583","","","16. باب: اپنے بھائی کی مدد کر ظالم ہو یا مظلوم ہر حال میں کرنے سے کیا مراد ہے۔بھائی کی مدد کرنا وہ ظالم ہو یا مظلومChapter: Supporting One's Brother Whether He Is Doing Wrong Or Being Wronged"
"6584","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، وَإِسْحَاقُ بْنُ مَنْصُورٍ ، وَمُحَمَّدُ بْنُ رَافِعٍ ، قَالَ ابْنُ رَافِعٍ: حَدَّثَنَا، وقَالَ الْآخَرَانِ: أَخْبَرَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ: \"\" كَسَعَ رَجُلٌ مِنْ الْمُهَاجِرِينَ رَجُلًا مِنْ الْأَنْصَارِ، فَأَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَسَأَلَهُ الْقَوَدَ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: دَعُوهَا فَإِنَّهَا مُنْتِنَةٌ \"\"، قَالَ ابْنُ مَنْصُورٍ فِي رِوَايَتِهِ: عَمْرٌو، قَالَ: سَمِعْتُ جَابِرًا.nصحیح مسلم حدیث: 6584 عربی حدیث: 2584",": Sahih","Sahih Muslim 6584","","","16. باب: اپنے بھائی کی مدد کر ظالم ہو یا مظلوم ہر حال میں کرنے سے کیا مراد ہے۔بھائی کی مدد کرنا وہ ظالم ہو یا مظلومChapter: Supporting One's Brother Whether He Is Doing Wrong Or Being Wronged"
"6585","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو عَامِرٍ الْأَشْعَرِيُّ ، قَالَا: حَدَّثَنَا عَبْدُ اللَّهِ بْنُ إِدْرِيسَ ، وَأَبُو أُسَامَةَ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ الْعَلَاءِ أَبُو كُرَيْبٍ ، حَدَّثَنَا ابْنُ الْمُبَارَكِ ، وَابْنُ إِدْرِيسَ ، وَأَبُو أُسَامَةَ كُلُّهُمْ، عَنْ بُرَيْدٍ ، عَنْ أَبِي بُرْدَةَ ، عَنْ أَبِي مُوسَى ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" الْمُؤْمِنُ لِلْمُؤْمِنِ كَالْبُنْيَانِ يَشُدُّ بَعْضُهُ بَعْضًا \"\".nصحیح مسلم حدیث: 6585 عربی حدیث: 2585",": Sahih","Sahih Muslim 6585","","","17. باب: مومنوں کا آپس میں اتحاد اور ایک دوسرے کا مددگار ہونا۔اہل ایمان کی ایک دوسرے کے ساتھ رحم دلی، باہمی محبت اور ایک دوسرے کی مددChapter: The Mutual Mercy, Compassion And Support Of The Believers"
"6586","حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا زَكَرِيَّاءُ ، عَنْ الشَّعْبِيِّ ، عَنْ النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" مَثَلُ الْمُؤْمِنِينَ فِي تَوَادِّهِمْ وَتَرَاحُمِهِمْ وَتَعَاطُفِهِمْ، مَثَلُ الْجَسَدِ إِذَا اشْتَكَى مِنْهُ عُضْوٌ تَدَاعَى لَهُ سَائِرُ الْجَسَدِ بِالسَّهَرِ وَالْحُمَّى \"\".nصحیح مسلم حدیث: 6586 عربی حدیث: 2586",": Sahih","Sahih Muslim 6586","","","17. باب: مومنوں کا آپس میں اتحاد اور ایک دوسرے کا مددگار ہونا۔اہل ایمان کی ایک دوسرے کے ساتھ رحم دلی، باہمی محبت اور ایک دوسرے کی مددChapter: The Mutual Mercy, Compassion And Support Of The Believers"
"6587","حَدَّثَنَا إِسْحَاقُ الْحَنْظَلِيُّ ، أَخْبَرَنَا جَرِيرٌ ، عَنْ مُطَرِّفٍ ، عَنْ الشَّعْبِيِّ ، عَنْ النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِنَحْوِهِ.nصحیح مسلم حدیث: 6587 عربی حدیث: 2586",": Sahih","Sahih Muslim 6587","","","17. باب: مومنوں کا آپس میں اتحاد اور ایک دوسرے کا مددگار ہونا۔اہل ایمان کی ایک دوسرے کے ساتھ رحم دلی، باہمی محبت اور ایک دوسرے کی مددChapter: The Mutual Mercy, Compassion And Support Of The Believers"
"6588","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو سَعِيدٍ الْأَشَجُّ ، قَالَا: حَدَّثَنَا وَكِيعٌ ، عَنْ الْأَعْمَشِ ، عَنْ الشَّعْبِيِّ ، عَنْ النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" الْمُؤْمِنُونَ كَرَجُلٍ وَاحِدٍ إِنِ اشْتَكَى رَأْسُهُ تَدَاعَى لَهُ سَائِرُ الْجَسَدِ بِالْحُمَّى وَالسَّهَرِ \"\".nصحیح مسلم حدیث: 6588 عربی حدیث: 2586",": Sahih","Sahih Muslim 6588","","","17. باب: مومنوں کا آپس میں اتحاد اور ایک دوسرے کا مددگار ہونا۔اہل ایمان کی ایک دوسرے کے ساتھ رحم دلی، باہمی محبت اور ایک دوسرے کی مددChapter: The Mutual Mercy, Compassion And Support Of The Believers"
"6589","حَدَّثَنِي مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، حَدَّثَنَا حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ الْأَعْمَشِ ، عَنْ خَيْثَمَةَ ، عَنْ النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" الْمُسْلِمُونَ كَرَجُلٍ وَاحِدٍ إِنِ اشْتَكَى عَيْنُهُ اشْتَكَى كُلُّهُ، وَإِنِ اشْتَكَى رَأْسُهُ اشْتَكَى كُلُّهُ \"\".nصحیح مسلم حدیث: 6589 عربی حدیث: 2586",": Sahih","Sahih Muslim 6589","","","17. باب: مومنوں کا آپس میں اتحاد اور ایک دوسرے کا مددگار ہونا۔اہل ایمان کی ایک دوسرے کے ساتھ رحم دلی، باہمی محبت اور ایک دوسرے کی مددChapter: The Mutual Mercy, Compassion And Support Of The Believers"
"6590","حَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ الْأَعْمَشِ ، عَنْ الشَّعْبِيِّ ، عَنْ النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، نَحْوَهُ.nصحیح مسلم حدیث: 6590 عربی حدیث: 2586",": Sahih","Sahih Muslim 6590","","","17. باب: مومنوں کا آپس میں اتحاد اور ایک دوسرے کا مددگار ہونا۔اہل ایمان کی ایک دوسرے کے ساتھ رحم دلی، باہمی محبت اور ایک دوسرے کی مددChapter: The Mutual Mercy, Compassion And Support Of The Believers"
"6591","حَدَّثَنَا يَحْيَي بْنُ أَيُّوبَ ، وَقُتَيْبَةُ ، وَابْنُ حُجْرٍ ، قَالُوا: حَدَّثَنَا إِسْمَاعِيلُ يَعْنُونَ ابْنَ جَعْفَرٍ ، عَنْ الْعَلَاءِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" الْمُسْتَبَّانِ مَا قَالَا فَعَلَى الْبَادِئِ مَا لَمْ يَعْتَدِ الْمَظْلُومُ \"\".nصحیح مسلم حدیث: 6591 عربی حدیث: 2587",": Sahih","Sahih Muslim 6591","","","18. باب: گالی دینے کی ممانعت۔ایک دوسرے کو گالی دینے کی ممانعتChapter: The Prohibition Of Reviling"
"6592","حَدَّثَنَا يَحْيَي بْنُ أَيُّوبَ ، وَقُتَيْبَةُ ، وَابْنُ حُجْرٍ ، قَالُوا: حَدَّثَنَا إِسْمَاعِيلُ وَهُوَ ابْنُ جَعْفَرٍ ، عَنْ الْعَلَاءِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" مَا نَقَصَتْ صَدَقَةٌ مِنْ مَالٍ، وَمَا زَادَ اللَّهُ عَبْدًا بِعَفْوٍ إِلَّا عِزًّا، وَمَا تَوَاضَعَ أَحَدٌ لِلَّهِ إِلَّا رَفَعَهُ اللَّهُ \"\".nصحیح مسلم حدیث: 6592 عربی حدیث: 2588",": Sahih","Sahih Muslim 6592","","","19. باب: عفو اور عاجزی کی فضیلت۔درگزر کرنا اور انکسار مستحب ہےChapter: It Is Recommended To Forgive And Be Humble"
"6593","حَدَّثَنَا يَحْيَي بْنُ أَيُّوبَ ، وَقُتَيْبَةُ ، وَابْنُ حُجْرٍ ، قَالُوا: حَدَّثَنَا إِسْمَاعِيلُ ، عَنْ الْعَلَاءِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" أَتَدْرُونَ مَا الْغِيبَةُ؟ قَالُوا: اللَّهُ وَرَسُولُهُ أَعْلَمُ، قَالَ: ذِكْرُكَ أَخَاكَ بِمَا يَكْرَهُ، قِيلَ: أَفَرَأَيْتَ إِنْ كَانَ فِي أَخِي مَا أَقُولُ؟ قَالَ: \"\" إِنْ كَانَ فِيهِ مَا تَقُولُ فَقَدِ اغْتَبْتَهُ، وَإِنْ لَمْ يَكُنْ فِيهِ فَقَدْ بَهَتَّهُ \"\".nصحیح مسلم حدیث: 6593 عربی حدیث: 2589",": Sahih","Sahih Muslim 6593","","","20. باب: غیبت حرام ہے۔غیبت کی حرمتChapter: The Prohibition Of Backbiting"
"6594","حَدَّثَنِي أُمَيَّةُ بْنُ بِسْطَامٍ الْعَيْشِيُّ ، حَدَّثَنَا يَزِيدُ يَعْنِي ابْنَ زُرَيْعٍ ، حَدَّثَنَا رَوْحٌ ، عَنْ سُهَيْلٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَا يَسْتُرُ اللَّهُ عَلَى عَبْدٍ فِي الدُّنْيَا إِلَّا سَتَرَهُ اللَّهُ يَوْمَ الْقِيَامَةِ \"\".nصحیح مسلم حدیث: 6594 عربی حدیث: 2590",": Sahih","Sahih Muslim 6594","","","21. باب: اللہ نے جس کی دنیا میں پردہ پوشی کی آخرت میں بھی کرے گا۔جس کی اللہ تعالیٰ نے دنیا میں پردہ پوشی کی اس کے لیے بشارت ہے کہ وہ آخرت میں بھی اس کی پردہ پوشی فرمائے گاChapter: Glad Tidings That Whomever Allah Conceals In This World He Will Conceal Him In The Hereafter"
"6595","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا وُهَيْبٌ ، حَدَّثَنَا سُهَيْلٌ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَا يَسْتُرُ عَبْدٌ عَبْدًا فِي الدُّنْيَا إِلَّا سَتَرَهُ اللَّهُ يَوْمَ الْقِيَامَةِ \"\".nصحیح مسلم حدیث: 6595 عربی حدیث: 2590",": Sahih","Sahih Muslim 6595","","","21. باب: اللہ نے جس کی دنیا میں پردہ پوشی کی آخرت میں بھی کرے گا۔جس کی اللہ تعالیٰ نے دنیا میں پردہ پوشی کی اس کے لیے بشارت ہے کہ وہ آخرت میں بھی اس کی پردہ پوشی فرمائے گاChapter: Glad Tidings That Whomever Allah Conceals In This World He Will Conceal Him In The Hereafter"
"6596","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، وَأَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَعَمْرٌو النَّاقِدُ ، وَزُهَيْرُ بْنُ حَرْبٍ ، وَابْنُ نُمَيْرٍ كُلُّهُمْ، عَنْ ابْنِ عُيَيْنَةَ وَاللَّفْظُ لِزُهَيْرٍ، قَالَ: حَدَّثَنَا سُفْيَانُ وَهُوَ ابْنُ عُيَيْنَةَ، عَنْ ابْنِ الْمُنْكَدِرِ ، سَمِعَ عُرْوَةَ بْنَ الزُّبَيْرِ ، يَقُولُ: حَدَّثَتْنِي عَائِشَةُ : أَنَّ رَجُلًا اسْتَأْذَنَ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: ائْذَنُوا لَهُ، فَلَبِئْسَ ابْنُ الْعَشِيرَةِ، أَوْ بِئْسَ رَجُلُ الْعَشِيرَةِ، فَلَمَّا دَخَلَ عَلَيْهِ أَلَانَ لَهُ الْقَوْلَ، قَالَتْ عَائِشَةُ: فَقُلْتُ: يَا رَسُولَ اللَّهِ، قُلْتَ لَهُ الَّذِي قُلْتَ، ثُمَّ أَلَنْتَ لَهُ الْقَوْلَ، قَالَ: يَا عَائِشَةُ: \"\" إِنَّ شَرَّ النَّاسِ مَنْزِلَةً عِنْدَ اللَّهِ يَوْمَ الْقِيَامَةِ مَنْ وَدَعَهُ، أَوْ تَرَكَهُ النَّاسُ اتِّقَاءَ فُحْشِهِ \"\".nصحیح مسلم حدیث: 6596 عربی حدیث: 2591",": Sahih","Sahih Muslim 6596","","","22. باب: جس کی برائی کا ڈر ہو اس کی ظاہر میں خاطرداری کرنا۔جس شخص کی بدکلامی کا ڈر ہو اس سے نرم گفتگو کرناChapter: Being Kind To Protect Oneself From Another's Vile Behavior"
"6597","حَدَّثَنِي مُحَمَّدُ بْنُ رَافِعٍ ، وَعَبْدُ بْنُ حُمَيْدٍ كِلَاهُمَا، عَنْ عَبْدِ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ ابْنِ الْمُنْكَدِرِ ، فِي هَذَا الْإِسْنَادِ مِثْلَ مَعْنَاهُ غَيْرَ أَنَّهُ، قَالَ: بِئْسَ أَخُو الْقَوْمِ، وَابْنُ الْعَشِيرَةِ.nصحیح مسلم حدیث: 6597 عربی حدیث: 2591",": Sahih","Sahih Muslim 6597","","","22. باب: جس کی برائی کا ڈر ہو اس کی ظاہر میں خاطرداری کرنا۔جس شخص کی بدکلامی کا ڈر ہو اس سے نرم گفتگو کرناChapter: Being Kind To Protect Oneself From Another's Vile Behavior"
"6598","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنِي يَحْيَي بْنُ سَعِيدٍ ، عَنْ سُفْيَانَ ، حَدَّثَنَا مَنْصُورٌ ، عَنْ تَمِيمِ بْنِ سَلَمَةَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ ، عَنْ جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" مَنْ يُحْرَمْ الرِّفْقَ يُحْرَمْ الْخَيْرَ \"\".nصحیح مسلم حدیث: 6598 عربی حدیث: 2592",": Sahih","Sahih Muslim 6598","","","23. باب: نرمی کی فضیلت۔نرمی کی فضیلتChapter: The Virtue Of Gentleness"
"6599","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو سَعِيدٍ الْأَشَجُّ ، وَمُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْر ، قَالُوا: حَدَّثَنَا وَكِيعٌ . ح وحَدَّثَنَا أَبُو كُرَيْبٍ ، حَدَّثَنَا أَبُو مُعَاوِيَةَ . ح وحَدَّثَنَا أَبُو سَعِيدٍ الْأَشَجُّ ، حَدَّثَنَا حَفْصٌ يَعْنِي ابْنَ غِيَاثٍ كُلُّهُمْ، عَنْ الْأَعْمَشِ ، وحَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ وَاللَّفْظُ لَهُمَا، قَالَ زُهَيْرٌ: حَدَّثَنَا، وقَالَ إِسْحَاقُ: أَخْبَرَنَا جَرِيرٌ ، عَنْ الْأَعْمَشِ ، عَنْ تَمِيمِ بْنِ سَلَمَةَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ الْعَبْسِيِّ ، قَالَ: سَمِعْتُ جَرِيرًا ، يَقُولُ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \"\" مَنْ يُحْرَمْ الرِّفْقَ يُحْرَمْ الْخَيْرَ \"\".nصحیح مسلم حدیث: 6599 عربی حدیث: 2592",": Sahih","Sahih Muslim 6599","","","23. باب: نرمی کی فضیلت۔نرمی کی فضیلتChapter: The Virtue Of Gentleness"
"6600","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، أَخْبَرَنَا عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ، عَنْ مُحَمَّدِ بْنِ أَبِي إِسْمَاعِيلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ ، قَالَ: سَمِعْتُ جَرِيرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" مَنْ حُرِمَ الرِّفْقَ حُرِمَ الْخَيْرَ، أَوْ مَنْ يُحْرَمْ الرِّفْقَ يُحْرَمْ الْخَيْرَ \"\".nصحیح مسلم حدیث: 6600 عربی حدیث: 2592",": Sahih","Sahih Muslim 6600","","","23. باب: نرمی کی فضیلت۔نرمی کی فضیلتChapter: The Virtue Of Gentleness"
"6601","حَدَّثَنَا حَرْمَلَةُ بْنُ يَحْيَي التُّجِيبِيُّ ، أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، أَخْبَرَنِي حَيْوَةُ ، حَدَّثَنِي ابْنُ الْهَادِ ، عَنْ أَبِي بَكْرِ بْنِ حَزْمٍ ، عَنْ عَمْرَةَ يَعْنِي بِنْتَ عَبْدِ الرَّحْمَنِ ، عَنْ عَائِشَةَ زَوْجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: يَا عَائِشَةُ: \"\" إِنَّ اللَّهَ رَفِيقٌ يُحِبُّ الرِّفْقَ، وَيُعْطِي عَلَى الرِّفْقِ مَا لَا يُعْطِي عَلَى الْعُنْفِ، وَمَا لَا يُعْطِي عَلَى مَا سِوَاهُ \"\".nصحیح مسلم حدیث: 6601 عربی حدیث: 2593",": Sahih","Sahih Muslim 6601","","","23. باب: نرمی کی فضیلت۔نرمی کی فضیلتChapter: The Virtue Of Gentleness"
"6602","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ الْعَنْبَرِيُّ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا شُعْبَةُ ، عَنْ الْمِقْدَامِ وَهُوَ ابْنُ شُرَيْحِ بْنِ هَانِئٍ ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ زَوْجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" إِنَّ الرِّفْقَ لَا يَكُونُ فِي شَيْءٍ إِلَّا زَانَهُ، وَلَا يُنْزَعُ مِنْ شَيْءٍ إِلَّا شَانَهُ \"\".nصحیح مسلم حدیث: 6602 عربی حدیث: 2594",": Sahih","Sahih Muslim 6602","","","23. باب: نرمی کی فضیلت۔نرمی کی فضیلتChapter: The Virtue Of Gentleness"
"6603","حَدَّثَنَاه مُحَمَّدُ بْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، سَمِعْتُ الْمِقْدَامَ بْنَ شُرَيْحِ بْنِ هَانِئٍ ، بِهَذَا الْإِسْنَادِ، وَزَادَ فِي الْحَدِيثِ، رَكِبَتْ عَائِشَةُ بَعِيرًا، فَكَانَتْ فِيهِ صُعُوبَةٌ فَجَعَلَتْ تُرَدِّدُهُ، فَقَالَ لَهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: عَلَيْكِ بِالرِّفْقِ، ثُمَّ ذَكَرَ بِمِثْلِهِ.nصحیح مسلم حدیث: 6603 عربی حدیث: 2594",": Sahih","Sahih Muslim 6603","","","23. باب: نرمی کی فضیلت۔نرمی کی فضیلتChapter: The Virtue Of Gentleness"
"6604","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَزُهَيْرُ بْنُ حَرْبٍ جَمِيعًا، عَنْ ابْنِ عُلَيَّةَ ، قَالَ زُهَيْرٌ: حَدَّثَنَا إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ، حَدَّثَنَا أَيُّوبُ ، عَنْ أَبِي قِلَابَةَ ، عَنْ أَبِي الْمُهَلَّبِ ، عَنْ عِمْرَانَ بْنِ حُصَيْنٍ ، قَالَ: \"\" بَيْنَمَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي بَعْضِ أَسْفَارِهِ، وَامْرَأَةٌ مِنْ الْأَنْصَارِ عَلَى نَاقَةٍ، فَضَجِرَتْ، فَلَعَنَتْهَا، فَسَمِعَ ذَلِكَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: خُذُوا مَا عَلَيْهَا وَدَعُوهَا فَإِنَّهَا مَلْعُونَةٌ \"\"، قَالَ عِمْرَانُ: فَكَأَنِّي أَرَاهَا الْآنَ تَمْشِي فِي النَّاسِ مَا يَعْرِضُ لَهَا أَحَدٌ.nصحیح مسلم حدیث: 6604 عربی حدیث: 2595",": Sahih","Sahih Muslim 6604","","","24. باب: جانوروں اور ان کے علاوہ کو لعنت نہ کرنے کابیان۔سواری وغیرہ کے جانوروں پر لعنت کرنے کی ممانعتChapter: The Prohibition Of Cursing Animals Etc."
"6605","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، وَأَبُو الرَّبِيعِ ، قَالَا: حَدَّثَنَا حَمَّادٌ وَهُوَ ابْنُ زَيْدٍ . ح وحَدَّثَنَا ابْنُ أَبِي عُمَرَ ، حَدَّثَنَا الثَّقَفِيُّ كِلَاهُمَا، عَنْ أَيُّوبَ ، بِإِسْنَادِ إِسْمَاعِيلَ نَحْوَ حَدِيثِهِ، إِلَّا أَنَّ فِي حَدِيثِ حَمَّادٍ، قَالَ عِمْرَانُ: فَكَأَنِّي أَنْظُرُ إِلَيْهَا نَاقَةً وَرْقَاءَ، وَفِي حَدِيثِ الثَّقَفِيِّ، فَقَالَ: خُذُوا مَا عَلَيْهَا وَأَعْرُوهَا فَإِنَّهَا مَلْعُونَةٌ.nصحیح مسلم حدیث: 6605 عربی حدیث: 2595",": Sahih","Sahih Muslim 6605","","","24. باب: جانوروں اور ان کے علاوہ کو لعنت نہ کرنے کابیان۔سواری وغیرہ کے جانوروں پر لعنت کرنے کی ممانعتChapter: The Prohibition Of Cursing Animals Etc."
"6606","حَدَّثَنَا أَبُو كَامِلٍ الْجَحْدَرِيُّ فُضَيْلُ بْنُ حُسَيْنٍ ، حَدَّثَنَا يَزِيدُ يَعْنِي ابْنَ زُرَيْعٍ ، حَدَّثَنَا التَّيْمِيُّ ، عَنْ أَبِي عُثْمَانَ ، عَنْ أَبِي بَرْزَةَ الْأَسْلَمِيِّ ، قَالَ: \"\" بَيْنَمَا جَارِيَةٌ عَلَى نَاقَةٍ عَلَيْهَا بَعْضُ مَتَاعِ الْقَوْمِ، إِذْ بَصُرَتْ بِالنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَتَضَايَقَ بِهِمُ الْجَبَلُ، فَقَالَتْ: حَلِ اللَّهُمَّ الْعَنْهَا، قَالَ: فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: لَا تُصَاحِبْنَا نَاقَةٌ عَلَيْهَا لَعْنَةٌ \"\".nصحیح مسلم حدیث: 6606 عربی حدیث: 2596",": Sahih","Sahih Muslim 6606","","","24. باب: جانوروں اور ان کے علاوہ کو لعنت نہ کرنے کابیان۔سواری وغیرہ کے جانوروں پر لعنت کرنے کی ممانعتChapter: The Prohibition Of Cursing Animals Etc."
"6607","حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى ، حَدَّثَنَا الْمُعْتَمِرُ . ح وحَدَّثَنِي عُبَيْدُ اللَّهِ بْنُ سَعِيدٍ ، حَدَّثَنَا يَحْيَي يَعْنِي ابْنَ سَعِيدٍ جَمِيعًا، عَنْ سُلَيْمَانَ التَّيْمِيِّ ، بِهَذَا الْإِسْنَادِ، وَزَادَ فِي حَدِيثِ الْمُعْتَمِرِ: لَا أَيْمُ اللَّهِ لَا تُصَاحِبْنَا رَاحِلَةٌ عَلَيْهَا لَعْنَةٌ مِنَ اللَّهِ، أَوْ كَمَا قَالَ.nصحیح مسلم حدیث: 6607 عربی حدیث: 2596",": Sahih","Sahih Muslim 6607","","","24. باب: جانوروں اور ان کے علاوہ کو لعنت نہ کرنے کابیان۔سواری وغیرہ کے جانوروں پر لعنت کرنے کی ممانعتChapter: The Prohibition Of Cursing Animals Etc."
"6608","حَدَّثَنَا هَارُونُ بْنُ سَعِيدٍ الْأَيْلِيُّ ، حَدَّثَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي سُلَيْمَانُ وَهُوَ ابْنُ بِلَالٍ ، عَنْ الْعَلَاءِ بْنِ عَبْدِ الرَّحْمَنِ حَدَّثَهُ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَا يَنْبَغِي لِصِدِّيقٍ أَنْ يَكُونَ لَعَّانًا \"\".nصحیح مسلم حدیث: 6608 عربی حدیث: 2597",": Sahih","Sahih Muslim 6608","","","24. باب: جانوروں اور ان کے علاوہ کو لعنت نہ کرنے کابیان۔سواری وغیرہ کے جانوروں پر لعنت کرنے کی ممانعتChapter: The Prohibition Of Cursing Animals Etc."
"6609","حَدَّثَنِيهِ أَبُو كُرَيْبٍ ، حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ مُحَمَّدِ بْنِ جَعْفَرٍ ، عَنْ الْعَلَاءِ بْنِ عَبْدِ الرَّحْمَنِ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ.nصحیح مسلم حدیث: 6609 عربی حدیث: 2597",": Sahih","Sahih Muslim 6609","","","24. باب: جانوروں اور ان کے علاوہ کو لعنت نہ کرنے کابیان۔سواری وغیرہ کے جانوروں پر لعنت کرنے کی ممانعتChapter: The Prohibition Of Cursing Animals Etc."
"6610","حَدَّثَنِي سُوَيْدُ بْنُ سَعِيدٍ ، حَدَّثَنِي حَفْصُ بْنُ مَيْسَرَةَ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، أَنَّ عَبْدَ الْمَلِكِ بْنَ مَرْوَانَ بَعَثَ إِلَى أُمِّ الدَّرْدَاءِ بِأَنْجَادٍ مِنْ عِنْدِهِ، فَلَمَّا أَنْ كَانَ ذَاتَ لَيْلَةٍ قَامَ عَبْدُ الْمَلِكِ مِنَ اللَّيْلِ، فَدَعَا خَادِمَهُ فَكَأَنَّهُ أَبْطَأَ عَلَيْهِ فَلَعَنَهُ، فَلَمَّا أَصْبَحَ، قَالَتْ لَهُ أُمُّ الدَّرْدَاءِ: سَمِعْتُكَ اللَّيْلَةَ لَعَنْتَ خَادِمَكَ حِينَ دَعَوْتَهُ، فَقَالَتْ: سَمِعْتُ أَبَا الدَّرْدَاءِ ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" لَا يَكُونُ اللَّعَّانُونَ شُفَعَاءَ وَلَا شُهَدَاءَ يَوْمَ الْقِيَامَةِ \"\".nصحیح مسلم حدیث: 6610 عربی حدیث: 2598",": Sahih","Sahih Muslim 6610","","","24. باب: جانوروں اور ان کے علاوہ کو لعنت نہ کرنے کابیان۔سواری وغیرہ کے جانوروں پر لعنت کرنے کی ممانعتChapter: The Prohibition Of Cursing Animals Etc."
"6611","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو غَسَّانَ الْمِسْمَعِيُّ ، وَعَاصِمُ بْنُ النَّضْرِ التَّيْمِيُّ ، قَالُوا: حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَيْمَانَ . ح وحَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا عَبْدُ الرَّزَّاقِ كِلَاهُمَا، عَنْ مَعْمَرٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، فِي هَذَا الْإِسْنَادِ بِمِثْلِ مَعْنَى حَدِيثِ حَفْصِ بْنِ مَيْسَرَةَ.nصحیح مسلم حدیث: 6611 عربی حدیث: 2598",": Sahih","Sahih Muslim 6611","","","24. باب: جانوروں اور ان کے علاوہ کو لعنت نہ کرنے کابیان۔سواری وغیرہ کے جانوروں پر لعنت کرنے کی ممانعتChapter: The Prohibition Of Cursing Animals Etc."
"6612","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا مُعَاوِيَةُ بْنُ هِشَامٍ ، عَنْ هِشَامِ بْنِ سَعْدٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ أُمِّ الدَّرْدَاءِ ، عَنْ أَبِي الدَّرْدَاءِ ، سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \"\" إِنَّ اللَّعَّانِينَ لَا يَكُونُونَ شُهَدَاءَ وَلَا شُفَعَاءَ يَوْمَ الْقِيَامَةِ \"\".nصحیح مسلم حدیث: 6612 عربی حدیث: 2598",": Sahih","Sahih Muslim 6612","","","24. باب: جانوروں اور ان کے علاوہ کو لعنت نہ کرنے کابیان۔سواری وغیرہ کے جانوروں پر لعنت کرنے کی ممانعتChapter: The Prohibition Of Cursing Animals Etc."
"6613","حَدَّثَنَا مُحَمَّدُ بْنُ عَبَّادٍ ، وَابْنُ أَبِي عُمَرَ ، قَالَا: حَدَّثَنَا مَرْوَانُ يَعْنِيَانِ الْفَزَارِيَّ ، عَنْ يَزِيدَ وَهُوَ ابْنُ كَيْسَانَ ، عَنْ أَبِي حَازِمٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قِيلَ: يَا رَسُولَ اللَّهِ، ادْعُ عَلَى الْمُشْرِكِينَ، قَالَ: \"\" إِنِّي لَمْ أُبْعَثْ لَعَّانًا، وَإِنَّمَا بُعِثْتُ رَحْمَةً \"\".nصحیح مسلم حدیث: 6613 عربی حدیث: 2599",": Sahih","Sahih Muslim 6613","","","24. باب: جانوروں اور ان کے علاوہ کو لعنت نہ کرنے کابیان۔سواری وغیرہ کے جانوروں پر لعنت کرنے کی ممانعتChapter: The Prohibition Of Cursing Animals Etc."
"6614","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا جَرِيرٌ ، عَنْ الْأَعْمَشِ ، عَنْ أَبِي الضُّحَى ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَةَ ، قَالَتْ: \"\" دَخَلَ عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَجُلَانِ، فَكَلَّمَاهُ بِشَيْءٍ لَا أَدْرِي مَا هُوَ، فَأَغْضَبَاهُ فَلَعَنَهُمَا وَسَبَّهُمَا، فَلَمَّا خَرَجَا، قُلْتُ: يَا رَسُولَ اللَّهِ، مَنْ أَصَابَ مِنَ الْخَيْرِ شَيْئًا مَا أَصَابَهُ هَذَانِ، قَالَ: وَمَا ذَاكِ، قَالَتْ: قُلْتُ: لَعَنْتَهُمَا وَسَبَبْتَهُمَا، قَالَ: أَوَ مَا عَلِمْتِ مَا شَارَطْتُ عَلَيْهِ رَبِّي، قُلْتُ: اللَّهُمَّ إِنَّمَا أَنَا بَشَرٌ، فَأَيُّ الْمُسْلِمِينَ لَعَنْتُهُ أَوْ سَبَبْتُهُ فَاجْعَلْهُ لَهُ زَكَاةً وَأَجْرًا \"\".nصحیح مسلم حدیث: 6614 عربی حدیث: 2600",": Sahih","Sahih Muslim 6614","","","25. باب: جس پر آپ صلی اللہ علیہ وسلم نے لعنت کی اور وہ لعنت کے لائق نہ تھا تو اس پر رحمت ہو گی۔نبی صلی اللہ علیہ وسلم نے کسی شخص پر لعنت کی ہو، برا کہا ہو یا اس کے خلاف بددعا کی ہو اور وہ اس کا مستحق نہ ہو تو وہ اس کے لیے تزکیہ (برائی سے پاکیزگی)، اجر اور رحمت کا باعث بن جائے گیChapter: Whomever Is Cursed, Reviled Or Prayed Against By The Prophet (SAW) When He Does Not Deserve That, It Will Be Purification, Reward And Mercy For Him"
"6615","حَدَّثَنَاه أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، قَالَا: حَدَّثَنَا أَبُو مُعَاوِيَةَ . ح وحَدَّثَنَاه عَلِيُّ بْنُ حُجْرٍ السَّعْدِيُّ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، وَعَلِيُّ بْنُ خَشْرَمٍ جَمِيعًا، عَنْ عِيسَى بْنِ يُونُسَ كِلَاهُمَا، عَنْ الْأَعْمَشِ ، بِهَذَا الْإِسْنَادِ نَحْوَ حَدِيثِ جَرِيرٍ، وقَالَ فِي حَدِيثِ عِيسَى: فَخَلَوَا بِهِ، فَسَبَّهُمَا، وَلَعَنَهُمَا، وَأَخْرَجَهُمَا.nصحیح مسلم حدیث: 6615 عربی حدیث: 2600",": Sahih","Sahih Muslim 6615","","","25. باب: جس پر آپ صلی اللہ علیہ وسلم نے لعنت کی اور وہ لعنت کے لائق نہ تھا تو اس پر رحمت ہو گی۔نبی صلی اللہ علیہ وسلم نے کسی شخص پر لعنت کی ہو، برا کہا ہو یا اس کے خلاف بددعا کی ہو اور وہ اس کا مستحق نہ ہو تو وہ اس کے لیے تزکیہ (برائی سے پاکیزگی)، اجر اور رحمت کا باعث بن جائے گیChapter: Whomever Is Cursed, Reviled Or Prayed Against By The Prophet (SAW) When He Does Not Deserve That, It Will Be Purification, Reward And Mercy For Him"
"6616","حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا الْأَعْمَشُ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" اللَّهُمَّ إِنَّمَا أَنَا بَشَرٌ، فَأَيُّمَا رَجُلٍ مِنَ الْمُسْلِمِينَ سَبَبْتُهُ، أَوْ لَعَنْتُهُ، أَوْ جَلَدْتُهُ، فَاجْعَلْهَا لَهُ زَكَاةً وَرَحْمَةً \"\".nصحیح مسلم حدیث: 6616 عربی حدیث: 2601",": Sahih","Sahih Muslim 6616","","","25. باب: جس پر آپ صلی اللہ علیہ وسلم نے لعنت کی اور وہ لعنت کے لائق نہ تھا تو اس پر رحمت ہو گی۔نبی صلی اللہ علیہ وسلم نے کسی شخص پر لعنت کی ہو، برا کہا ہو یا اس کے خلاف بددعا کی ہو اور وہ اس کا مستحق نہ ہو تو وہ اس کے لیے تزکیہ (برائی سے پاکیزگی)، اجر اور رحمت کا باعث بن جائے گیChapter: Whomever Is Cursed, Reviled Or Prayed Against By The Prophet (SAW) When He Does Not Deserve That, It Will Be Purification, Reward And Mercy For Him"
"6617","وحَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا الْأَعْمَشُ ، عَنْ أَبِي سُفْيَانَ ، عَنْ جَابِرٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، مِثْلَهُ، إِلَّا أَنَّ فِيهِ زَكَاةً وَأَجْرًا.nصحیح مسلم حدیث: 6617 عربی حدیث: 2602",": Sahih","Sahih Muslim 6617","","","25. باب: جس پر آپ صلی اللہ علیہ وسلم نے لعنت کی اور وہ لعنت کے لائق نہ تھا تو اس پر رحمت ہو گی۔نبی صلی اللہ علیہ وسلم نے کسی شخص پر لعنت کی ہو، برا کہا ہو یا اس کے خلاف بددعا کی ہو اور وہ اس کا مستحق نہ ہو تو وہ اس کے لیے تزکیہ (برائی سے پاکیزگی)، اجر اور رحمت کا باعث بن جائے گیChapter: Whomever Is Cursed, Reviled Or Prayed Against By The Prophet (SAW) When He Does Not Deserve That, It Will Be Purification, Reward And Mercy For Him"
"6618","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، قَالَا: حَدَّثَنَا أَبُو مُعَاوِيَةَ . ح وحَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا عِيسَى بْنُ يُونُسَ كِلَاهُمَا، عَنْ الْأَعْمَشِ بِإِسْنَادِ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ مِثْلَ حَدِيثِهِ، غَيْرَ أَنَّ فِي حَدِيثِ عِيسَى جَعَلَ وَأَجْرًا فِي حَدِيثِ أَبِي هُرَيْرَةَ، وَجَعَلَ وَرَحْمَةً فِي حَدِيثِ جَابِرٍ.nصحیح مسلم حدیث: 6618 عربی حدیث: 2602",": Sahih","Sahih Muslim 6618","","","25. باب: جس پر آپ صلی اللہ علیہ وسلم نے لعنت کی اور وہ لعنت کے لائق نہ تھا تو اس پر رحمت ہو گی۔نبی صلی اللہ علیہ وسلم نے کسی شخص پر لعنت کی ہو، برا کہا ہو یا اس کے خلاف بددعا کی ہو اور وہ اس کا مستحق نہ ہو تو وہ اس کے لیے تزکیہ (برائی سے پاکیزگی)، اجر اور رحمت کا باعث بن جائے گیChapter: Whomever Is Cursed, Reviled Or Prayed Against By The Prophet (SAW) When He Does Not Deserve That, It Will Be Purification, Reward And Mercy For Him"
"6619","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا الْمُغِيرَةُ يَعْنِي ابْنَ عَبْدِ الرَّحْمَنِ الْحِزَامِيَّ ، عَنْ أَبِي الزِّنَادِ ، عَنْ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" اللَّهُمَّ إِنِّي أَتَّخِذُ عِنْدَكَ عَهْدًا لَنْ تُخْلِفَنِيهِ، فَإِنَّمَا أَنَا بَشَرٌ فَأَيُّ الْمُؤْمِنِينَ آذَيْتُهُ شَتَمْتُهُ لَعَنْتُهُ جَلَدْتُهُ، فَاجْعَلْهَا لَهُ صَلَاةً وَزَكَاةً، وَقُرْبَةً تُقَرِّبُهُ بِهَا إِلَيْكَ يَوْمَ الْقِيَامَةِ \"\".nصحیح مسلم حدیث: 6619 عربی حدیث: 2601",": Sahih","Sahih Muslim 6619","","","25. باب: جس پر آپ صلی اللہ علیہ وسلم نے لعنت کی اور وہ لعنت کے لائق نہ تھا تو اس پر رحمت ہو گی۔نبی صلی اللہ علیہ وسلم نے کسی شخص پر لعنت کی ہو، برا کہا ہو یا اس کے خلاف بددعا کی ہو اور وہ اس کا مستحق نہ ہو تو وہ اس کے لیے تزکیہ (برائی سے پاکیزگی)، اجر اور رحمت کا باعث بن جائے گیChapter: Whomever Is Cursed, Reviled Or Prayed Against By The Prophet (SAW) When He Does Not Deserve That, It Will Be Purification, Reward And Mercy For Him"
"6620","حَدَّثَنَاه ابْنُ أَبِي عُمَرَ ، حَدَّثَنَا سُفْيَانُ ، حَدَّثَنَا أَبُو الزِّنَادِ ، بِهَذَا الْإِسْنَادِ نَحْوَهُ، إِلَّا أَنَّهُ قَالَ: أَوْ جَلَدُّهُ، قَالَ أَبُو الزِّنَادِ: وَهِيَ لُغَةُ أَبِي هُرَيْرَةَ، وَإِنَّمَا هِيَ جَلَدْتُهُ.nصحیح مسلم حدیث: 6620 عربی حدیث: 2601",": Sahih","Sahih Muslim 6620","","","25. باب: جس پر آپ صلی اللہ علیہ وسلم نے لعنت کی اور وہ لعنت کے لائق نہ تھا تو اس پر رحمت ہو گی۔نبی صلی اللہ علیہ وسلم نے کسی شخص پر لعنت کی ہو، برا کہا ہو یا اس کے خلاف بددعا کی ہو اور وہ اس کا مستحق نہ ہو تو وہ اس کے لیے تزکیہ (برائی سے پاکیزگی)، اجر اور رحمت کا باعث بن جائے گیChapter: Whomever Is Cursed, Reviled Or Prayed Against By The Prophet (SAW) When He Does Not Deserve That, It Will Be Purification, Reward And Mercy For Him"
"6621","حَدَّثَنِي سُلَيْمَانُ بْنُ مَعْبَدٍ ، حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ ، عَنْ أَيُّوبَ ، عَنْ عَبْدِ الرَّحْمَنِ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِنَحْوِهِ.nصحیح مسلم حدیث: 6621 عربی حدیث: 2601",": Sahih","Sahih Muslim 6621","","","25. باب: جس پر آپ صلی اللہ علیہ وسلم نے لعنت کی اور وہ لعنت کے لائق نہ تھا تو اس پر رحمت ہو گی۔نبی صلی اللہ علیہ وسلم نے کسی شخص پر لعنت کی ہو، برا کہا ہو یا اس کے خلاف بددعا کی ہو اور وہ اس کا مستحق نہ ہو تو وہ اس کے لیے تزکیہ (برائی سے پاکیزگی)، اجر اور رحمت کا باعث بن جائے گیChapter: Whomever Is Cursed, Reviled Or Prayed Against By The Prophet (SAW) When He Does Not Deserve That, It Will Be Purification, Reward And Mercy For Him"
"6622","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ ، عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ ، عَنْ سَالِمٍ مَوْلَى النَّصْرِيِّينَ، قَالَ: سَمِعْتُ أَبَا هُرَيْرَةَ ، يَقُولُ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ: \"\" اللَّهُمَّ إِنَّمَا مُحَمَّدٌ بَشَرٌ يَغْضَبُ كَمَا يَغْضَبُ الْبَشَرُ، وَإِنِّي قَدِ اتَّخَذْتُ عِنْدَكَ عَهْدًا لَنْ تُخْلِفَنِيهِ، فَأَيُّمَا مُؤْمِنٍ آذَيْتُهُ، أَوْ سَبَبْتُهُ، أَوْ جَلَدْتُهُ، فَاجْعَلْهَا لَهُ كَفَّارَةً وَقُرْبَةً تُقَرِّبُهُ بِهَا إِلَيْكَ يَوْمَ الْقِيَامَةِ \"\".nصحیح مسلم حدیث: 6622 عربی حدیث: 2601",": Sahih","Sahih Muslim 6622","","","25. باب: جس پر آپ صلی اللہ علیہ وسلم نے لعنت کی اور وہ لعنت کے لائق نہ تھا تو اس پر رحمت ہو گی۔نبی صلی اللہ علیہ وسلم نے کسی شخص پر لعنت کی ہو، برا کہا ہو یا اس کے خلاف بددعا کی ہو اور وہ اس کا مستحق نہ ہو تو وہ اس کے لیے تزکیہ (برائی سے پاکیزگی)، اجر اور رحمت کا باعث بن جائے گیChapter: Whomever Is Cursed, Reviled Or Prayed Against By The Prophet (SAW) When He Does Not Deserve That, It Will Be Purification, Reward And Mercy For Him"
"6623","حَدَّثَنِي حَرْمَلَةُ بْنُ يَحْيَي ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، أَخْبَرَنِي سَعِيدُ بْنُ الْمُسَيِّبِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّهُ سَمِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \"\" اللَّهُمَّ فَأَيُّمَا عَبْدٍ مُؤْمِنٍ سَبَبْتُهُ، فَاجْعَلْ ذَلِكَ لَهُ قُرْبَةً إِلَيْكَ يَوْمَ الْقِيَامَةِ \"\".nصحیح مسلم حدیث: 6623 عربی حدیث: 2601",": Sahih","Sahih Muslim 6623","","","25. باب: جس پر آپ صلی اللہ علیہ وسلم نے لعنت کی اور وہ لعنت کے لائق نہ تھا تو اس پر رحمت ہو گی۔نبی صلی اللہ علیہ وسلم نے کسی شخص پر لعنت کی ہو، برا کہا ہو یا اس کے خلاف بددعا کی ہو اور وہ اس کا مستحق نہ ہو تو وہ اس کے لیے تزکیہ (برائی سے پاکیزگی)، اجر اور رحمت کا باعث بن جائے گیChapter: Whomever Is Cursed, Reviled Or Prayed Against By The Prophet (SAW) When He Does Not Deserve That, It Will Be Purification, Reward And Mercy For Him"
"6624","حَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، وَعَبْدُ بْنُ حميد ، قَالَ زُهَيْرٌ: حَدَّثَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ ، حَدَّثَنَا ابْنُ أَخِي ابْنِ شِهَابٍ ، عَنْ عَمِّهِ ، حَدَّثَنِي سَعِيدُ بْنُ الْمُسَيِّبِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّهُ قَالَ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \"\" اللَّهُمَّ إِنِّي اتَّخَذْتُ عِنْدَكَ عَهْدًا لَنْ تُخْلِفَنِيهِ، فَأَيُّمَا مُؤْمِنٍ سَبَبْتُهُ أَوْ جَلَدْتُهُ، فَاجْعَلْ ذَلِكَ كَفَّارَةً لَهُ يَوْمَ الْقِيَامَةِ \"\".nصحیح مسلم حدیث: 6624 عربی حدیث: 2601",": Sahih","Sahih Muslim 6624","","","25. باب: جس پر آپ صلی اللہ علیہ وسلم نے لعنت کی اور وہ لعنت کے لائق نہ تھا تو اس پر رحمت ہو گی۔نبی صلی اللہ علیہ وسلم نے کسی شخص پر لعنت کی ہو، برا کہا ہو یا اس کے خلاف بددعا کی ہو اور وہ اس کا مستحق نہ ہو تو وہ اس کے لیے تزکیہ (برائی سے پاکیزگی)، اجر اور رحمت کا باعث بن جائے گیChapter: Whomever Is Cursed, Reviled Or Prayed Against By The Prophet (SAW) When He Does Not Deserve That, It Will Be Purification, Reward And Mercy For Him"
"6625","حَدَّثَنِي هَارُونُ بْنُ عَبْدِ اللَّهِ ، وَحَجَّاجُ بْنُ الشَّاعِرِ ، قَالَا: حَدَّثَنَا حَجَّاجُ بْنُ مُحَمَّدٍ ، قَالَ: قَالَ ابْنُ جُرَيْجٍ : أَخْبَرَنِي أَبُو الزُّبَيْرِ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \"\" إِنَّمَا أَنَا بَشَرٌ، وَإِنِّي اشْتَرَطْتُ عَلَى رَبِّي عَزَّ وَجَلَّ، أَيُّ عَبْدٍ مِنَ الْمُسْلِمِينَ سَبَبْتُهُ أَوْ شَتَمْتُهُ أَنْ يَكُونَ ذَلِكَ لَهُ زَكَاةً وَأَجْرًا \"\".nصحیح مسلم حدیث: 6625 عربی حدیث: 2602",": Sahih","Sahih Muslim 6625","","","25. باب: جس پر آپ صلی اللہ علیہ وسلم نے لعنت کی اور وہ لعنت کے لائق نہ تھا تو اس پر رحمت ہو گی۔نبی صلی اللہ علیہ وسلم نے کسی شخص پر لعنت کی ہو، برا کہا ہو یا اس کے خلاف بددعا کی ہو اور وہ اس کا مستحق نہ ہو تو وہ اس کے لیے تزکیہ (برائی سے پاکیزگی)، اجر اور رحمت کا باعث بن جائے گیChapter: Whomever Is Cursed, Reviled Or Prayed Against By The Prophet (SAW) When He Does Not Deserve That, It Will Be Purification, Reward And Mercy For Him"
"6626","حَدَّثَنِيهِ ابْنُ أَبِي خَلَفٍ ، حَدَّثَنَا رَوْحٌ . ح وحَدَّثَنَاه عَبْدُ بْنُ حُمَيْدٍ ، حَدَّثَنَا أَبُو عَاصِمٍ جَمِيعًا، عَنْ ابْنِ جُرَيْجٍ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ.nصحیح مسلم حدیث: 6626 عربی حدیث: 2602",": Sahih","Sahih Muslim 6626","","","25. باب: جس پر آپ صلی اللہ علیہ وسلم نے لعنت کی اور وہ لعنت کے لائق نہ تھا تو اس پر رحمت ہو گی۔نبی صلی اللہ علیہ وسلم نے کسی شخص پر لعنت کی ہو، برا کہا ہو یا اس کے خلاف بددعا کی ہو اور وہ اس کا مستحق نہ ہو تو وہ اس کے لیے تزکیہ (برائی سے پاکیزگی)، اجر اور رحمت کا باعث بن جائے گیChapter: Whomever Is Cursed, Reviled Or Prayed Against By The Prophet (SAW) When He Does Not Deserve That, It Will Be Purification, Reward And Mercy For Him"
"6627","حَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، وَأَبُو مَعْنٍ الرَّقَاشِيُّ ، وَاللَّفْظُ لِزُهَيْرٍ، قَالَا: حَدَّثَنَا عُمَرُ بْنُ يُونُسَ ، حَدَّثَنَا عِكْرِمَةُ بْنُ عَمَّارٍ ، حَدَّثَنَا إِسْحَاقُ بْنُ أَبِي طَلْحَةَ ، حَدَّثَنِي أَنَسُ بْنُ مَالِكٍ ، قَالَ: \"\" كَانَتْ عِنْدَ أُمِّ سُلَيْمٍ يَتِيمَةٌ وَهِيَ أُمُّ أَنَسٍ، فَرَأَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْيَتِيمَةَ، فَقَالَ: آنْتِ هِيَهْ لَقَدْ كَبِرْتِ لَا كَبِرَ سِنُّكِ، فَرَجَعَتِ الْيَتِيمَةُ إِلَى أُمِّ سُلَيْمٍ تَبْكِي، فَقَالَتْ أُمُّ سُلَيْمٍ: مَا لَكِ يَا بُنَيَّةُ؟ قَالَتْ: الْجَارِيَةُ دَعَا عَلَيَّ نَبِيُّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ لَا يَكْبَرَ سِنِّي، فَالْآنَ لَا يَكْبَرُ سِنِّي أَبَدًا، أَوْ قَالَتْ: قَرْنِي فَخَرَجَتْ أُمُّ سُلَيْمٍ مُسْتَعْجِلَةً تَلُوثُ خِمَارَهَا حَتَّى لَقِيَتْ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ لَهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: مَا لَكِ يَا أُمَّ سُلَيْمٍ؟ فَقَالَتْ: يَا نَبِيَّ اللَّهِ، أَدَعَوْتَ عَلَى يَتِيمَتِي، قَالَ: وَمَا ذَاكِ يَا أُمَّ سُلَيْمٍ، قَالَتْ: زَعَمَتْ أَنَّكَ دَعَوْتَ أَنْ لَا يَكْبَرَ سِنُّهَا وَلَا يَكْبَرَ قَرْنُهَا، قَالَ: فَضَحِكَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، ثُمَّ قَالَ: يَا أُمَّ سُلَيْمٍ أَمَا تَعْلَمِينَ أَنَّ شَرْطِي عَلَى رَبِّي أَنِّي اشْتَرَطْتُ عَلَى رَبِّي، فَقُلْتُ: إِنَّمَا أَنَا بَشَرٌ أَرْضَى كَمَا يَرْضَى الْبَشَرُ، وَأَغْضَبُ كَمَا يَغْضَبُ الْبَشَرُ، فَأَيُّمَا أَحَدٍ دَعَوْتُ عَلَيْهِ مِنْ أُمَّتِي بِدَعْوَةٍ لَيْسَ لَهَا بِأَهْلٍ أَنْ يَجْعَلَهَا لَهُ طَهُورًا، وَزَكَاةً، وَقُرْبَةً يُقَرِّبُهُ بِهَا مِنْهُ يَوْمَ الْقِيَامَةِ \"\"، وقَالَ أَبُو مَعْنٍ: يُتَيِّمَةٌ بِالتَّصْغِيرِ فِي الْمَوَاضِعِ الثَّلَاثَةِ مِنَ الْحَدِيثِ.nصحیح مسلم حدیث: 6627 عربی حدیث: 2603",": Sahih","Sahih Muslim 6627","","","25. باب: جس پر آپ صلی اللہ علیہ وسلم نے لعنت کی اور وہ لعنت کے لائق نہ تھا تو اس پر رحمت ہو گی۔نبی صلی اللہ علیہ وسلم نے کسی شخص پر لعنت کی ہو، برا کہا ہو یا اس کے خلاف بددعا کی ہو اور وہ اس کا مستحق نہ ہو تو وہ اس کے لیے تزکیہ (برائی سے پاکیزگی)، اجر اور رحمت کا باعث بن جائے گیChapter: Whomever Is Cursed, Reviled Or Prayed Against By The Prophet (SAW) When He Does Not Deserve That, It Will Be Purification, Reward And Mercy For Him"
"6628","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى الْعَنَزِيُّ . ح وحَدَّثَنَا ابْنُ بَشَّارٍ ، وَاللَّفْظُ لِابْنِ الْمُثَنَّى، قَالَا: حَدَّثَنَا أُمَيَّةُ بْنُ خَالِدٍ ، حَدَّثَنَا شُعْبَةُ ، عَنْ أَبِي حَمْزَةَ الْقَصَّابِ ، عَنْ ابْنِ عَبَّاسٍ ، قَالَ: \"\" كُنْتُ أَلْعَبُ مَعَ الصِّبْيَانِ، فَجَاءَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَتَوَارَيْتُ خَلْفَ بَابٍ، قَالَ: فَجَاءَ فَحَطَأَنِي حَطْأَةً، وَقَالَ: اذْهَبْ وَادْعُ لِي مُعَاوِيَةَ، قَالَ: فَجِئْتُ، فَقُلْتُ: هُوَ يَأْكُلُ، قَالَ، ثُمَّ قَالَ لِيَ: اذْهَبْ فَادْعُ لِي مُعَاوِيَةَ، قَالَ: فَجِئْتُ، فَقُلْتُ: هُوَ يَأْكُلُ، فَقَالَ: لَا أَشْبَعَ اللَّهُ بَطْنَهُ، قَالَ ابْنُ الْمُثَنَّى: قُلْتُ لِأُمَيَّةَ: مَا حَطَأَنِي؟ قَالَ: قَفَدَنِي قَفْدَةً \"\".nصحیح مسلم حدیث: 6628 عربی حدیث: 2604",": Sahih","Sahih Muslim 6628","","","25. باب: جس پر آپ صلی اللہ علیہ وسلم نے لعنت کی اور وہ لعنت کے لائق نہ تھا تو اس پر رحمت ہو گی۔نبی صلی اللہ علیہ وسلم نے کسی شخص پر لعنت کی ہو، برا کہا ہو یا اس کے خلاف بددعا کی ہو اور وہ اس کا مستحق نہ ہو تو وہ اس کے لیے تزکیہ (برائی سے پاکیزگی)، اجر اور رحمت کا باعث بن جائے گیChapter: Whomever Is Cursed, Reviled Or Prayed Against By The Prophet (SAW) When He Does Not Deserve That, It Will Be Purification, Reward And Mercy For Him"
"6629","حَدَّثَنِي إِسْحَاقُ بْنُ مَنْصُورٍ ، أَخْبَرَنَا النَّضْرُ بْنُ شُمَيْلٍ ، حَدَّثَنَا شُعْبَةُ ، أَخْبَرَنَا أَبُو حَمْزَةَ ، سَمِعْتُ ابْنَ عَبَّاسٍ ، يَقُولُ: كُنْتُ أَلْعَبُ مَعَ الصِّبْيَانِ، فَجَاءَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَاخْتَبَأْتُ مِنْهُ فَذَكَرَ بِمِثْلِهِ.nصحیح مسلم حدیث: 6629 عربی حدیث: 2604",": Sahih","Sahih Muslim 6629","","","25. باب: جس پر آپ صلی اللہ علیہ وسلم نے لعنت کی اور وہ لعنت کے لائق نہ تھا تو اس پر رحمت ہو گی۔نبی صلی اللہ علیہ وسلم نے کسی شخص پر لعنت کی ہو، برا کہا ہو یا اس کے خلاف بددعا کی ہو اور وہ اس کا مستحق نہ ہو تو وہ اس کے لیے تزکیہ (برائی سے پاکیزگی)، اجر اور رحمت کا باعث بن جائے گیChapter: Whomever Is Cursed, Reviled Or Prayed Against By The Prophet (SAW) When He Does Not Deserve That, It Will Be Purification, Reward And Mercy For Him"
"6630","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ أَبِي الزِّنَادِ ، عَنْ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" إِنَّ مِنْ شَرِّ النَّاسِ ذَا الْوَجْهَيْنِ الَّذِي يَأْتِي هَؤُلَاءِ بِوَجْهٍ وَهَؤُلَاءِ بِوَجْهٍ \"\".nصحیح مسلم حدیث: 6630 عربی حدیث: 2526",": Sahih","Sahih Muslim 6630","","","26. باب: دو منہ والے منافق کی مذمت۔دورُخے انسان کی مذمتChapter: Criticism Of The One Who Is Two-Faced, And The Prohibition Of Doing That"
"6631","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ رُمْحٍ ، أَخْبَرَنَا اللَّيْثُ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، عَنْ عِرَاكِ بْنِ مَالِكٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّهُ سَمِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \"\" إِنَّ شَرَّ النَّاسِ ذُو الْوَجْهَيْنِ الَّذِي يَأْتِي هَؤُلَاءِ بِوَجْهٍ وَهَؤُلَاءِ بِوَجْهٍ \"\".nصحیح مسلم حدیث: 6631 عربی حدیث: 2526",": Sahih","Sahih Muslim 6631","","","26. باب: دو منہ والے منافق کی مذمت۔دورُخے انسان کی مذمتChapter: Criticism Of The One Who Is Two-Faced, And The Prohibition Of Doing That"
"6632","حَدَّثَنِي حَرْمَلَةُ بْنُ يَحْيَي ، أَخْبَرَنِي ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، حَدَّثَنِي سَعِيدُ بْنُ الْمُسَيِّبِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ. ح وحَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا جَرِيرٌ ، عَنْ عُمَارَةَ ، عَنْ أَبِي زُرْعَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" تَجِدُونَ مِنْ شَرِّ النَّاسِ ذَا الْوَجْهَيْنِ الَّذِي يَأْتِي هَؤُلَاءِ بِوَجْهٍ وَهَؤُلَاءِ بِوَجْهٍ \"\".nصحیح مسلم حدیث: 6632 عربی حدیث: 2526",": Sahih","Sahih Muslim 6632","","","26. باب: دو منہ والے منافق کی مذمت۔دورُخے انسان کی مذمتChapter: Criticism Of The One Who Is Two-Faced, And The Prohibition Of Doing That"
"6633","حَدَّثَنِي حَرْمَلَةُ بْنُ يَحْيَي ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، أَخْبَرَنِي حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ : أَنَّ أُمَّهُ أُمَّ كُلْثُومٍ بِنْتَ عُقْبَةَ بْنِ أَبِي مُعَيْطٍ ، وَكَانَتْ مِنَ الْمُهَاجِرَاتِ الْأُوَلِ اللَّاتِي بَايَعْنَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَخْبَرَتْهُ أَنَّهَا سَمِعَتْ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَهُوَ يَقُولُ: \"\" لَيْسَ الْكَذَّابُ الَّذِي يُصْلِحُ بَيْنَ النَّاسِ وَيَقُولُ خَيْرًا وَيَنْمِي خَيْرًا \"\"، قَالَ ابْنُ شِهَابٍ: وَلَمْ أَسْمَعْ يُرَخَّصُ فِي شَيْءٍ، مِمَّا يَقُولُ: النَّاسُ كَذِبٌ إِلَّا فِي ثَلَاثٍ: الْحَرْبُ، وَالْإِصْلَاحُ بَيْنَ النَّاسِ، وَحَدِيثُ الرَّجُلِ امْرَأَتَهُ، وَحَدِيثُ الْمَرْأَةِ زَوْجَهَا.nصحیح مسلم حدیث: 6633 عربی حدیث: 2605",": Sahih","Sahih Muslim 6633","","","27. باب: جھوٹ حرام ہے لیکن کسی حد تک درست ہے اس کا بیان۔باب: جھوٹ کی حرمت اور اس کی جائز صورتوں کا بیانChapter: The Prohibition Of Lying, And What Is Permitted Thereof"
"6634","حَدَّثَنَا عَمْرٌو النَّاقِدُ ، حَدَّثَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ، حَدَّثَنَا أَبِي ، عَنْ صَالِحٍ ، حَدَّثَنَا مُحَمَّدُ بْنُ مُسْلِمِ بْنِ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ شِهَابٍ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ، غَيْرَ أَنَّ فِي حَدِيثِ صَالِحٍ، وَقَالَتْ: وَلَمْ أَسْمَعْهُ يُرَخِّصُ فِي شَيْءٍ مِمَّا يَقُولُ النَّاسُ إِلَّا فِي ثَلَاثٍ، بِمِثْلِ مَا جَعَلَهُ يُونُسُ مِنْ قَوْلِ ابْنِ شِهَابٍ.nصحیح مسلم حدیث: 6634 عربی حدیث: 2605",": Sahih","Sahih Muslim 6634","","","27. باب: جھوٹ حرام ہے لیکن کسی حد تک درست ہے اس کا بیان۔باب: جھوٹ کی حرمت اور اس کی جائز صورتوں کا بیانChapter: The Prohibition Of Lying, And What Is Permitted Thereof"
"6635","وحَدَّثَنَاه عَمْرٌو النَّاقِدُ ، حَدَّثَنَا إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ الزُّهْرِيِّ ، بِهَذَا الْإِسْنَادِ، إِلَى قَوْلِهِ: وَنَمَى خَيْرًا، وَلَمْ يَذْكُرْ مَا بَعْدَهُ.nصحیح مسلم حدیث: 6635 عربی حدیث: 2605",": Sahih","Sahih Muslim 6635","","","27. باب: جھوٹ حرام ہے لیکن کسی حد تک درست ہے اس کا بیان۔باب: جھوٹ کی حرمت اور اس کی جائز صورتوں کا بیانChapter: The Prohibition Of Lying, And What Is Permitted Thereof"
"6636","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، سَمِعْتُ أَبَا إِسْحَاقَ يُحَدِّثُ، عَنْ أَبِي الْأَحْوَصِ ، عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ ، قَالَ: إِنَّ مُحَمَّدًا صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" أَلَا أُنَبِّئُكُمْ مَا الْعَضْهُ هِيَ النَّمِيمَةُ الْقَالَةُ بَيْنَ النَّاسِ، وَإِنَّ مُحَمَّدًا صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" إِنَّ الرَّجُلَ يَصْدُقُ حَتَّى يُكْتَبَ صِدِّيقًا، وَيَكْذِبُ حَتَّى يُكْتَبَ كَذَّابًا \"\".nصحیح مسلم حدیث: 6636 عربی حدیث: 2606",": Sahih","Sahih Muslim 6636","","","28. باب: چغل خوری حرام ہے۔چغلی کی حرمتChapter: The Prohibition Of Malicious Gossip (Namimah)"
"6637","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، وَعُثْمَانُ بْنُ أَبِي شَيْبَةَ ، وإسحاق بن إبراهيم ، قَالَ إِسْحَاقُ: أَخْبَرَنَا، وقَالَ الْآخَرَانِ: حَدَّثَنَا جَرِيرٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِي وَائِلٍ ، عَنْ عَبْدِ اللَّهِ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" إِنَّ الصِّدْقَ يَهْدِي إِلَى الْبِرِّ، وَإِنَّ الْبِرَّ يَهْدِي إِلَى الْجَنَّةِ، وَإِنَّ الرَّجُلَ لَيَصْدُقُ حَتَّى يُكْتَبَ صِدِّيقًا، وَإِنَّ الْكَذِبَ يَهْدِي إِلَى الْفُجُورِ، وَإِنَّ الْفُجُورَ يَهْدِي إِلَى النَّارِ، وَإِنَّ الرَّجُلَ لَيَكْذِبُ حَتَّى يُكْتَبَ كَذَّابًا \"\".nصحیح مسلم حدیث: 6637 عربی حدیث: 2607",": Sahih","Sahih Muslim 6637","","","29. باب:جھوٹ بولنا برا ہے اور سچ بولنا اچھا ہے، سچائی کی فضیلت جھوٹ کی مذمت۔باب: جھوٹ کی قباحت اور سچ کی خوبصورتی اور فضیلتChapter: The Abhorrence Of Lying, And The Goodness And Virtue Of Honesty"
"6638","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَهَنَّادُ بْنُ السَّرِيِّ ، قَالَا: حَدَّثَنَا أَبُو الْأَحْوَصِ ، عَنْ مَنْصُورٍ ، عَنْ أَبِي وَائِلٍ ، عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" إِنَّ الصِّدْقَ بِرٌّ، وَإِنَّ الْبِرَّ يَهْدِي إِلَى الْجَنَّةِ، وَإِنَّ الْعَبْدَ لَيَتَحَرَّى الصِّدْقَ حَتَّى يُكْتَبَ عِنْدَ اللَّهِ صِدِّيقًا، وَإِنَّ الْكَذِبَ فُجُورٌ، وَإِنَّ الْفُجُورَ يَهْدِي إِلَى النَّارِ، وَإِنَّ الْعَبْدَ لَيَتَحَرَّى الْكَذِبَ حَتَّى يُكْتَبَ كَذَّابًا \"\"، قَالَ ابْنُ أَبِي شَيْبَةَ فِي رِوَايَتِهِ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.nصحیح مسلم حدیث: 6638 عربی حدیث: 2607",": Sahih","Sahih Muslim 6638","","","29. باب:جھوٹ بولنا برا ہے اور سچ بولنا اچھا ہے، سچائی کی فضیلت جھوٹ کی مذمت۔باب: جھوٹ کی قباحت اور سچ کی خوبصورتی اور فضیلتChapter: The Abhorrence Of Lying, And The Goodness And Virtue Of Honesty"
"6639","حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، حَدَّثَنَا أَبُو مُعَاوِيَةَ ، وَوَكِيعٌ ، قَالَا: حَدَّثَنَا الْأَعْمَشُ . ح وحَدَّثَنَا أَبُو كُرَيْبٍ ، حَدَّثَنَا أَبُو مُعَاوِيَةَ ، حَدَّثَنَا الْأَعْمَشُ ، عَنْ شَقِيقٍ ، عَنْ عَبْدِ اللَّهِ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" عَلَيْكُمْ بِالصِّدْقِ، فَإِنَّ الصِّدْقَ يَهْدِي إِلَى الْبِرِّ، وَإِنَّ الْبِرَّ يَهْدِي إِلَى الْجَنَّةِ، وَمَا يَزَالُ الرَّجُلُ يَصْدُقُ وَيَتَحَرَّى الصِّدْقَ حَتَّى يُكْتَبَ عِنْدَ اللَّهِ صِدِّيقًا، وَإِيَّاكُمْ وَالْكَذِبَ، فَإِنَّ الْكَذِبَ يَهْدِي إِلَى الْفُجُورِ، وَإِنَّ الْفُجُورَ يَهْدِي إِلَى النَّارِ، وَمَا يَزَالُ الرَّجُلُ يَكْذِبُ وَيَتَحَرَّى الْكَذِبَ حَتَّى يُكْتَبَ عِنْدَ اللَّهِ كَذَّابًا \"\".nصحیح مسلم حدیث: 6639 عربی حدیث: 2607",": Sahih","Sahih Muslim 6639","","","29. باب:جھوٹ بولنا برا ہے اور سچ بولنا اچھا ہے، سچائی کی فضیلت جھوٹ کی مذمت۔باب: جھوٹ کی قباحت اور سچ کی خوبصورتی اور فضیلتChapter: The Abhorrence Of Lying, And The Goodness And Virtue Of Honesty"
"6640","حَدَّثَنَا مِنْجَابُ بْنُ الْحَارِثِ التَّمِيمِيُّ ، أَخْبَرَنَا ابْنُ مُسْهِرٍ . ح وحَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْحَنْظَلِيُّ ، أَخْبَرَنَا عِيسَى بْنُ يُونُسَ كِلَاهُمَا، عَنْ الْأَعْمَشِ ، بِهَذَا الْإِسْنَادِ، وَلَمْ يَذْكُرْ فِي حَدِيثِ عِيسَى: وَيَتَحَرَّى الصِّدْقَ وَيَتَحَرَّى الْكَذِبَ، وَفِي حَدِيثِ ابْنِ مُسْهِرٍ: حَتَّى يَكْتُبَهُ اللَّهُ.nصحیح مسلم حدیث: 6640 عربی حدیث: 2607",": Sahih","Sahih Muslim 6640","","","29. باب:جھوٹ بولنا برا ہے اور سچ بولنا اچھا ہے، سچائی کی فضیلت جھوٹ کی مذمت۔باب: جھوٹ کی قباحت اور سچ کی خوبصورتی اور فضیلتChapter: The Abhorrence Of Lying, And The Goodness And Virtue Of Honesty"
"6641","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، وَعُثْمَانُ بْنُ أَبِي شَيْبَةَ ، واللفظ لقتيبة، قَالَا: حَدَّثَنَا جَرِيرٌ ، عَنْ الْأَعْمَشِ ، عَنْ إِبْرَاهِيمَ التَّيْمِيِّ ، عَنْ الْحَارِثِ بْنِ سُوَيْدٍ ، عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" مَا تَعُدُّونَ الرَّقُوبَ فِيكُمْ؟ قَالَ: قُلْنَا: الَّذِي لَا يُولَدُ لَهُ، قَالَ: لَيْسَ ذَاكَ بِالرَّقُوبِ، وَلَكِنَّهُ الرَّجُلُ الَّذِي لَمْ يُقَدِّمْ مِنْ وَلَدِهِ شَيْئًا، قَالَ: فَمَا تَعُدُّونَ الصُّرَعَةَ فِيكُمْ؟ قَالَ: قُلْنَا: الَّذِي لَا يَصْرَعُهُ الرِّجَالُ، قَالَ: لَيْسَ بِذَلِكَ، وَلَكِنَّهُ الَّذِي يَمْلِكُ نَفْسَهُ عِنْدَ الْغَضَبِ \"\".nصحیح مسلم حدیث: 6641 عربی حدیث: 2608",": Sahih","Sahih Muslim 6641","","","30. باب: غصہ کے وقت اپنے آپ پر قابو پانے کی فضیلت اور اس بات کے بیان میں کہ کس چیز سے غصہ جاتا رہتا ہے۔اس شخص کی فضیلت جو غصے کے وقت اپنے نفس پر قابو رکھتا ہے اور غصہ کس چیز سے رخصت ہوتا ہےChapter: The Virtue Of One Who Controls Himself At Times Of Anger, And What Takes Away Anger"
"6642","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، قَالَا: حَدَّثَنَا أَبُو مُعَاوِيَةَ . ح وحَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا عِيسَى بْنُ يُونُسَ كِلَاهُمَا، عَنْ الْأَعْمَشِ ، بِهَذَا الْإِسْنَادِ مِثْلَ مَعْنَاهُ.nصحیح مسلم حدیث: 6642 عربی حدیث: 2608",": Sahih","Sahih Muslim 6642","","","30. باب: غصہ کے وقت اپنے آپ پر قابو پانے کی فضیلت اور اس بات کے بیان میں کہ کس چیز سے غصہ جاتا رہتا ہے۔اس شخص کی فضیلت جو غصے کے وقت اپنے نفس پر قابو رکھتا ہے اور غصہ کس چیز سے رخصت ہوتا ہےChapter: The Virtue Of One Who Controls Himself At Times Of Anger, And What Takes Away Anger"
"6643","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، وَعَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ، قَالَا كِلَاهُمَا: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ ابْنِ شِهَابٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَيْسَ الشَّدِيدُ بِالصُّرَعَةِ، إِنَّمَا الشَّدِيدُ الَّذِي يَمْلِكُ نَفْسَهُ عِنْدَ الْغَضَبِ \"\".nصحیح مسلم حدیث: 6643 عربی حدیث: 2609",": Sahih","Sahih Muslim 6643","","","30. باب: غصہ کے وقت اپنے آپ پر قابو پانے کی فضیلت اور اس بات کے بیان میں کہ کس چیز سے غصہ جاتا رہتا ہے۔اس شخص کی فضیلت جو غصے کے وقت اپنے نفس پر قابو رکھتا ہے اور غصہ کس چیز سے رخصت ہوتا ہےChapter: The Virtue Of One Who Controls Himself At Times Of Anger, And What Takes Away Anger"
"6644","حَدَّثَنَا حَاجِبُ بْنُ الْوَلِيدِ ، حَدَّثَنَا مُحَمَّدُ بْنُ حَرْبٍ ، عَنْ الزُّبَيْدِيِّ ، عَنْ الزُّهْرِيِّ ، أَخْبَرَنِي حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ ، أَنَّ أَبَا هُرَيْرَةَ ، قَالَ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \"\" لَيْسَ الشَّدِيدُ بِالصُّرَعَةِ، قَالُوا: فَالشَّدِيدُ أَيُّمَ هُوَ يَا رَسُولَ اللَّهِ، قَالَ: الَّذِي يَمْلِكُ نَفْسَهُ عِنْدَ الْغَضَبِ \"\".nصحیح مسلم حدیث: 6644 عربی حدیث: 2609",": Sahih","Sahih Muslim 6644","","","30. باب: غصہ کے وقت اپنے آپ پر قابو پانے کی فضیلت اور اس بات کے بیان میں کہ کس چیز سے غصہ جاتا رہتا ہے۔اس شخص کی فضیلت جو غصے کے وقت اپنے نفس پر قابو رکھتا ہے اور غصہ کس چیز سے رخصت ہوتا ہےChapter: The Virtue Of One Who Controls Himself At Times Of Anger, And What Takes Away Anger"
"6645","وحَدَّثَنَاه مُحَمَّدُ بْنُ رَافِعٍ ، وَعَبْدُ بْنُ حُمَيْدٍ جَمِيعًا، عَنْ عَبْدِ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ . ح وحَدَّثَنَا عَبْدُ اللَّهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ بِهْرَامَ ، أَخْبَرَنَا أَبُو الْيَمَانِ ، أَخْبَرَنَا شُعَيْبٌ كِلَاهُمَا، عَنْ الزُّهْرِيِّ ، عَنْ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِمِثْلِهِ.nصحیح مسلم حدیث: 6645 عربی حدیث: 2609",": Sahih","Sahih Muslim 6645","","","30. باب: غصہ کے وقت اپنے آپ پر قابو پانے کی فضیلت اور اس بات کے بیان میں کہ کس چیز سے غصہ جاتا رہتا ہے۔اس شخص کی فضیلت جو غصے کے وقت اپنے نفس پر قابو رکھتا ہے اور غصہ کس چیز سے رخصت ہوتا ہےChapter: The Virtue Of One Who Controls Himself At Times Of Anger, And What Takes Away Anger"
"6646","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، وَمُحَمَّدُ بْنُ الْعَلَاءِ ، قَالَ يَحْيَي: أَخْبَرَنَا، وقَالَ ابْنُ الْعَلَاءِ: حَدَّثَنَا أَبُو مُعَاوِيَةَ ، عَنْ الْأَعْمَشِ ، عَنْ عَدِيِّ بْنِ ثَابِتٍ ، عَنْ سُلَيْمَانَ بْنِ صُرَدٍ ، قَالَ: \"\" اسْتَبَّ رَجُلَانِ عِنْدَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَجَعَلَ أَحَدُهُمَا تَحْمَرُّ عَيْنَاهُ وَتَنْتَفِخُ أَوْدَاجُهُ، قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: إِنِّي لَأَعْرِفُ كَلِمَةً لَوْ قَالَهَا لَذَهَبَ عَنْهُ الَّذِي يَجِدُ: أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ، فَقَالَ الرَّجُلُ: وَهَلْ تَرَى بِي مِنْ جُنُونٍ؟ قَالَ ابْنُ الْعَلَاءِ: فَقَالَ: وَهَلْ تَرَى، وَلَمْ يَذْكُرِ الرَّجُلَ.nصحیح مسلم حدیث: 6646 عربی حدیث: 2610",": Sahih","Sahih Muslim 6646","","","30. باب: غصہ کے وقت اپنے آپ پر قابو پانے کی فضیلت اور اس بات کے بیان میں کہ کس چیز سے غصہ جاتا رہتا ہے۔اس شخص کی فضیلت جو غصے کے وقت اپنے نفس پر قابو رکھتا ہے اور غصہ کس چیز سے رخصت ہوتا ہےChapter: The Virtue Of One Who Controls Himself At Times Of Anger, And What Takes Away Anger"
"6647","حَدَّثَنَا نَصْرُ بْنُ عَلِيٍّ الْجَهْضَمِيُّ ، حَدَّثَنَا أَبُو أُسَامَةَ ، سَمِعْتُ الْأَعْمَشَ ، يَقُولُ: سَمِعْتُ عَدِيَّ بْنَ ثَابِتٍ ، يَقُولُ: حَدَّثَنَا سُلَيْمَانُ بْنُ صُرَدٍ ، قَالَ: اسْتَبَّ رَجُلَانِ عِنْدَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَجَعَلَ أَحَدُهُمَا يَغْضَبُ وَيَحْمَرُّ وَجْهُهُ، فَنَظَرَ إِلَيْهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: \"\" إِنِّي لَأَعْلَمُ كَلِمَةً لَوْ قَالَهَا لَذَهَبَ ذَا عَنْهُ: أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ \"\"، فَقَامَ إِلَى الرَّجُلِ رَجُلٌ مِمَّنْ سَمِعَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: أَتَدْرِي مَا قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ آنِفًا؟ قَالَ: إِنِّي لَأَعْلَمُ كَلِمَةً لَوْ قَالَهَا لَذَهَبَ ذَا عَنْهُ: أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ، فَقَالَ لَهُ الرَّجُلُ: أَمَجْنُونًا تَرَانِي؟.nصحیح مسلم حدیث: 6647 عربی حدیث: 2610",": Sahih","Sahih Muslim 6647","","","30. باب: غصہ کے وقت اپنے آپ پر قابو پانے کی فضیلت اور اس بات کے بیان میں کہ کس چیز سے غصہ جاتا رہتا ہے۔اس شخص کی فضیلت جو غصے کے وقت اپنے نفس پر قابو رکھتا ہے اور غصہ کس چیز سے رخصت ہوتا ہےChapter: The Virtue Of One Who Controls Himself At Times Of Anger, And What Takes Away Anger"
"6648","وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا حَفْصُ بْنُ غِيَاثٍ ، عَنْ الْأَعْمَشِ ، بِهَذَا الْإِسْنَادِ.nصحیح مسلم حدیث: 6648 عربی حدیث: 2610",": Sahih","Sahih Muslim 6648","","","30. باب: غصہ کے وقت اپنے آپ پر قابو پانے کی فضیلت اور اس بات کے بیان میں کہ کس چیز سے غصہ جاتا رہتا ہے۔اس شخص کی فضیلت جو غصے کے وقت اپنے نفس پر قابو رکھتا ہے اور غصہ کس چیز سے رخصت ہوتا ہےChapter: The Virtue Of One Who Controls Himself At Times Of Anger, And What Takes Away Anger"
"6649","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا يُونُسُ بْنُ مُحَمَّدٍ ، عَنْ حَمَّادِ بْنِ سَلَمَةَ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَمَّا صَوَّرَ اللَّهُ آدَمَ فِي الْجَنَّةِ تَرَكَهُ مَا شَاءَ اللَّهُ أَنْ يَتْرُكَهُ، فَجَعَلَ إِبْلِيسُ يُطِيفُ بِهِ يَنْظُرُ مَا هُوَ، فَلَمَّا رَآهُ أَجْوَفَ عَرَفَ أَنَّهُ خُلِقَ خَلْقًا لَا يَتَمَالَكُ \"\".nصحیح مسلم حدیث: 6649 عربی حدیث: 2611",": Sahih","Sahih Muslim 6649","","","31. باب: انسان اس طرح پیدا ہوا کہ اختیار نہیں رکھ سکتا۔انسان کی پیدائش ایسی ہے کہ وہ (عموما) خود پر قابو نہیں رکھ سکتاChapter: 'Man Is Created In Such A Way That He Is Not Steadfast'"
"6650","حَدَّثَنَا أَبُو بَكْرِ بْنُ نَافِعٍ ، حَدَّثَنَا بَهْزٌ ، حَدَّثَنَا حَمَّادٌ ، بِهَذَا الْإِسْنَادِ نَحْوَهُ.nصحیح مسلم حدیث: 6650 عربی حدیث: 2611",": Sahih","Sahih Muslim 6650","","","31. باب: انسان اس طرح پیدا ہوا کہ اختیار نہیں رکھ سکتا۔انسان کی پیدائش ایسی ہے کہ وہ (عموما) خود پر قابو نہیں رکھ سکتاChapter: 'Man Is Created In Such A Way That He Is Not Steadfast'"
"6651","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ بْنِ قَعْنَبٍ ، حَدَّثَنَا الْمُغِيرَةُ يَعْنِي الْحِزَامِيَّ ، عَنْ أَبِي الزِّنَادِ ، عَنْ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" إِذَا قَاتَلَ أَحَدُكُمْ أَخَاهُ فَلْيَجْتَنِبْ الْوَجْهَ \"\".nصحیح مسلم حدیث: 6651 عربی حدیث: 2612",": Sahih","Sahih Muslim 6651","","","32. باب: منہ پر مارنے کی ممانعت۔چہرے پر مارنے کی ممانعتChapter: The Prohibition Of Striking The Face"
"6652","حَدَّثَنَاه عَمْرٌو النَّاقِدُ ، وَزُهَيْرُ بْنُ حَرْبٍ ، قَالَا: حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ أَبِي الزِّنَادِ ، بِهَذَا الْإِسْنَادِ، وَقَالَ: إِذَا ضَرَبَ أَحَدُكُمْ.nصحیح مسلم حدیث: 6652 عربی حدیث: 2612",": Sahih","Sahih Muslim 6652","","","32. باب: منہ پر مارنے کی ممانعت۔چہرے پر مارنے کی ممانعتChapter: The Prohibition Of Striking The Face"
"6653","حَدَّثَنَا شَيْبَانُ بْنُ فَرُّوخَ ، حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ سُهَيْلٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" إِذَا قَاتَلَ أَحَدُكُمْ أَخَاهُ فَلْيَتَّقِ الْوَجْهَ \"\".nصحیح مسلم حدیث: 6653 عربی حدیث: 2612",": Sahih","Sahih Muslim 6653","","","32. باب: منہ پر مارنے کی ممانعت۔چہرے پر مارنے کی ممانعتChapter: The Prohibition Of Striking The Face"
"6654","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ الْعَنْبَرِيُّ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا شُعْبَةُ ، عَنْ قَتَادَةَ ، سَمِعَ أَبَا أَيُّوبَ يُحَدِّثُ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" إِذَا قَاتَلَ أَحَدُكُمْ أَخَاهُ فَلَا يَلْطِمَنَّ الْوَجْهَ \"\".nصحیح مسلم حدیث: 6654 عربی حدیث: 2612",": Sahih","Sahih Muslim 6654","","","32. باب: منہ پر مارنے کی ممانعت۔چہرے پر مارنے کی ممانعتChapter: The Prohibition Of Striking The Face"
"6655","حَدَّثَنَا نَصْرُ بْنُ عَلِيٍّ الْجَهْضَمِيُّ ، حَدَّثَنِي أَبِي ، حَدَّثَنَا الْمُثَنَّى . ح وحَدَّثَنِي مُحَمَّدُ بْنُ حَاتِمٍ ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ، عَنْ الْمُثَنَّى بْنِ سَعِيدٍ ، عَنْ قَتَادَةَ ، عَنْ أَبِي أَيُّوبَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَفِي حَدِيثِ ابْنِ حَاتِمٍ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" إِذَا قَاتَلَ أَحَدُكُمْ أَخَاهُ، فَلْيَجْتَنِبْ الْوَجْهَ، فَإِنَّ اللَّهَ خَلَقَ آدَمَ عَلَى صُورَتِهِ \"\".nصحیح مسلم حدیث: 6655 عربی حدیث: 2612",": Sahih","Sahih Muslim 6655","","","32. باب: منہ پر مارنے کی ممانعت۔چہرے پر مارنے کی ممانعتChapter: The Prohibition Of Striking The Face"
"6656","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنِي عَبْدُ الصَّمَدِ ، حَدَّثَنَا هَمَّامٌ ، حَدَّثَنَا قَتَادَةُ ، عَنْ يَحْيَى بْنِ مَالِكٍ الْمَرَاغِيِّ وَهُوَ أَبُو أَيُّوبَ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" إِذَا قَاتَلَ أَحَدُكُمْ أَخَاهُ فَلْيَجْتَنِبْ الْوَجْهَ \"\".nصحیح مسلم حدیث: 6656 عربی حدیث: 2612",": Sahih","Sahih Muslim 6656","","","32. باب: منہ پر مارنے کی ممانعت۔چہرے پر مارنے کی ممانعتChapter: The Prohibition Of Striking The Face"
"6657","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا حَفْصُ بْنُ غِيَاثٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ هِشَامِ بْنِ حَكِيمِ بْنِ حِزَامٍ ، قَالَ: مَرَّ بِالشَّامِ عَلَى أُنَاسٍ وَقَدْ أُقِيمُوا فِي الشَّمْسِ، وَصُبَّ عَلَى رُءُوسِهِمُ الزَّيْتُ، فَقَالَ: مَا هَذَا؟ قِيلَ: يُعَذَّبُونَ فِي الْخَرَاجِ، فَقَالَ: أَمَا إِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \"\" إِنَّ اللَّهَ يُعَذِّبُ الَّذِينَ يُعَذِّبُونَ فِي الدُّنْيَا \"\".nصحیح مسلم حدیث: 6657 عربی حدیث: 2613",": Sahih","Sahih Muslim 6657","","","33. باب: جو شخص لوگوں کو ناحق ستائے اس کا عذاب۔اس شخص کے لیے سخت وعید جو لوگوں کو ناحق سزا دےChapter: Stern Warning To One Who Torments People Unlawfully"
"6658","حَدَّثَنَا أَبُو كُرَيْبٍ ، حَدَّثَنَا أَبُو أُسَامَةَ ، عَنْ هِشَامٍ ، عَنْ أَبِيهِ ، قَالَ: مَرَّ هِشَامُ بْنُ حَكِيمِ بْنِ حِزَامٍ عَلَى أُنَاسٍ مِنَ الْأَنْبَاطِ بِالشَّامِ، قَدْ أُقِيمُوا فِي الشَّمْسِ، فَقَالَ: مَا شَأْنُهُمْ؟ قَالُوا: حُبِسُوا فِي الْجِزْيَةِ، فَقَالَ هِشَامٌ: أَشْهَدُ لَسَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \"\" إِنَّ اللَّهَ يُعَذِّبُ الَّذِينَ يُعَذِّبُونَ النَّاسَ فِي الدُّنْيَا \"\".nصحیح مسلم حدیث: 6658 عربی حدیث: 2613",": Sahih","Sahih Muslim 6658","","","33. باب: جو شخص لوگوں کو ناحق ستائے اس کا عذاب۔اس شخص کے لیے سخت وعید جو لوگوں کو ناحق سزا دےChapter: Stern Warning To One Who Torments People Unlawfully"
"6659","حَدَّثَنَا أَبُو كُرَيْبٍ ، حَدَّثَنَا وَكِيعٌ ، وَأَبُو مُعَاوِيَةَ . ح وحَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا جَرِيرٌ كُلُّهُمْ، عَنْ هِشَامٍ بِهَذَا الْإِسْنَادِ، وَزَادَ فِي حَدِيثِ جَرِيرٍ، قَالَ: وَأَمِيرُهُمْ يَوْمَئِذٍ عُمَيْرُ بْنُ سَعْدٍ عَلَى فِلَسْطِينَ، فَدَخَلَ عَلَيْهِ فَحَدَّثَهُ، فَأَمَرَ بِهِمْ فَخُلُّوا.nصحیح مسلم حدیث: 6659 عربی حدیث: 2613",": Sahih","Sahih Muslim 6659","","","33. باب: جو شخص لوگوں کو ناحق ستائے اس کا عذاب۔اس شخص کے لیے سخت وعید جو لوگوں کو ناحق سزا دےChapter: Stern Warning To One Who Torments People Unlawfully"
"6660","حَدَّثَنِي أَبُو الطَّاهِرِ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ ، أَنَّ هِشَامَ بْنَ حَكِيمٍ وَجَدَ رَجُلًا، وَهُوَ عَلَى حِمْصَ يُشَمِّسُ نَاسًا مِنَ النَّبْطِ فِي أَدَاءِ الْجِزْيَةِ، فَقَالَ: مَا هَذَا؟ إِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \"\" إِنَّ اللَّهَ يُعَذِّبُ الَّذِينَ يُعَذِّبُونَ النَّاسَ فِي الدُّنْيَا \"\".nصحیح مسلم حدیث: 6660 عربی حدیث: 2613",": Sahih","Sahih Muslim 6660","","","33. باب: جو شخص لوگوں کو ناحق ستائے اس کا عذاب۔اس شخص کے لیے سخت وعید جو لوگوں کو ناحق سزا دےChapter: Stern Warning To One Who Torments People Unlawfully"
"6661","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ إِسْحَاقُ: أَخْبَرَنَا، وقَالَ أَبُو بَكْرٍ: حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ عَمْرٍو ، سَمِعَ جَابِرًا ، يَقُولُ: مَرَّ رَجُلٌ فِي الْمَسْجِدِ بِسِهَامٍ، فَقَالَ لَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" أَمْسِكْ بِنِصَالِهَا \"\".nصحیح مسلم حدیث: 6661 عربی حدیث: 2614",": Sahih","Sahih Muslim 6661","","","34. باب: مجمع یا بازار میں ہتھیار لے جائے تو اس کی احتیاط رکھے۔جو شخص مسجد یا بازار میں اور لوگوں کے جمع ہونے کی جگہ پر ہتھیار لے کر چلے تو وہ انہیں ان کی نوکوں اور انیوں (کی طرف) سے پکڑےChapter: Telling The One Who Carries A Weapon In The Masjid, Marketplace Or Other Place Where People Gather, To Hold It By Its Point"
"6662","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، وَأَبُو الرَّبِيعِ ، قَالَ أَبُو الرَّبِيعِ: حَدَّثَنَا، وقَالَ يَحْيَي، وَاللَّفْظُ لَهُ، أَخْبَرَنَا حَمَّادُ بْنُ زَيْدٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ : أَنَّ رَجُلًا مَرَّ بِأَسْهُمٍ فِي الْمَسْجِدِ قَدْ أَبْدَى نُصُولَهَا، \"\" فَأُمِرَ أَنْ يَأْخُذَ بِنُصُولِهَا كَيْ لَا يَخْدِشَ مُسْلِمًا \"\".nصحیح مسلم حدیث: 6662 عربی حدیث: 2614",": Sahih","Sahih Muslim 6662","","","34. باب: مجمع یا بازار میں ہتھیار لے جائے تو اس کی احتیاط رکھے۔جو شخص مسجد یا بازار میں اور لوگوں کے جمع ہونے کی جگہ پر ہتھیار لے کر چلے تو وہ انہیں ان کی نوکوں اور انیوں (کی طرف) سے پکڑےChapter: Telling The One Who Carries A Weapon In The Masjid, Marketplace Or Other Place Where People Gather, To Hold It By Its Point"
"6663","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ رُمْحٍ ، أَخْبَرَنَا اللَّيْثُ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ ، عَنِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" أَنَّهُ أَمَرَ رَجُلًا كَانَ يَتَصَدَّقُ بِالنَّبْلِ فِي الْمَسْجِدِ أَنْ لَا يَمُرَّ بِهَا إِلَّا وَهُوَ آخِذٌ بِنُصُولِهَا \"\"، وقَالَ ابْنُ رُمْحٍ: كَانَ يَصَّدَّقُ بِالنَّبْلِ.nصحیح مسلم حدیث: 6663 عربی حدیث: 2614",": Sahih","Sahih Muslim 6663","","","34. باب: مجمع یا بازار میں ہتھیار لے جائے تو اس کی احتیاط رکھے۔جو شخص مسجد یا بازار میں اور لوگوں کے جمع ہونے کی جگہ پر ہتھیار لے کر چلے تو وہ انہیں ان کی نوکوں اور انیوں (کی طرف) سے پکڑےChapter: Telling The One Who Carries A Weapon In The Masjid, Marketplace Or Other Place Where People Gather, To Hold It By Its Point"
"6664","حَدَّثَنَا هَدَّابُ بْنُ خَالِدٍ ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ ، عَنْ ثَابِتٍ ، عَنْ أَبِي بُرْدَةَ ، عَنْ أَبِي مُوسَى ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" إِذَا مَرَّ أَحَدُكُمْ فِي مَجْلِسٍ، أَوْ سُوقٍ وَبِيَدِهِ نَبْلٌ، فَلْيَأْخُذْ بِنِصَالِهَا، ثُمَّ لِيَأْخُذْ بِنِصَالِهَا، ثُمَّ لِيَأْخُذْ بِنِصَالِهَا \"\"، قَالَ: فَقَالَ أَبُو مُوسَى: وَاللَّهِ مَا مُتْنَا حَتَّى سَدَّدْنَاهَا بَعْضُنَا فِي وُجُوهِ بَعْضٍ.nصحیح مسلم حدیث: 6664 عربی حدیث: 2615",": Sahih","Sahih Muslim 6664","","","34. باب: مجمع یا بازار میں ہتھیار لے جائے تو اس کی احتیاط رکھے۔جو شخص مسجد یا بازار میں اور لوگوں کے جمع ہونے کی جگہ پر ہتھیار لے کر چلے تو وہ انہیں ان کی نوکوں اور انیوں (کی طرف) سے پکڑےChapter: Telling The One Who Carries A Weapon In The Masjid, Marketplace Or Other Place Where People Gather, To Hold It By Its Point"
"6665","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ بَرَّادٍ الْأَشْعَرِيُّ ، وَمُحَمَّدُ بْنُ الْعَلَاءِ ، وَاللَّفْظُ لِعَبْدِ اللَّهِ، قَالَا: حَدَّثَنَا أَبُو أُسَامَةَ ، عَنْ بُرَيْدٍ ، عَنْ أَبِي بُرْدَةَ ، عَنْ أَبِي مُوسَى ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" إِذَا مَرَّ أَحَدُكُمْ فِي مَسْجِدِنَا، أَوْ فِي سُوقِنَا وَمَعَهُ نَبْلٌ، فَلْيُمْسِكْ عَلَى نِصَالِهَا بِكَفِّهِ أَنْ يُصِيبَ أَحَدًا مِنَ الْمُسْلِمِينَ مِنْهَا بِشَيْءٍ، أَوَ قَالَ: لِيَقْبِضَ عَلَى نِصَالِهَا \"\".nصحیح مسلم حدیث: 6665 عربی حدیث: 2615",": Sahih","Sahih Muslim 6665","","","34. باب: مجمع یا بازار میں ہتھیار لے جائے تو اس کی احتیاط رکھے۔جو شخص مسجد یا بازار میں اور لوگوں کے جمع ہونے کی جگہ پر ہتھیار لے کر چلے تو وہ انہیں ان کی نوکوں اور انیوں (کی طرف) سے پکڑےChapter: Telling The One Who Carries A Weapon In The Masjid, Marketplace Or Other Place Where People Gather, To Hold It By Its Point"
"6666","حَدَّثَنِي عَمْرٌو النَّاقِدُ ، وَابْنُ أَبِي عُمَرَ ، قَالَ عَمْرٌو حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ أَيُّوبَ ، عَنْ ابْنِ سِيرِينَ ، سَمِعْتُ أَبَا هُرَيْرَةَ ، يَقُولُ: قَالَ أَبُو الْقَاسِمِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" مَنْ أَشَارَ إِلَى أَخِيهِ بِحَدِيدَةٍ، فَإِنَّ الْمَلَائِكَةَ تَلْعَنُهُ حَتَّى يَدَعَهُ، وَإِنْ كَانَ أَخَاهُ لِأَبِيهِ وَأُمِّهِ \"\".nصحیح مسلم حدیث: 6666 عربی حدیث: 2616",": Sahih","Sahih Muslim 6666","","","35. باب: کسی مسلمان کو ہتھیار سے ڈرا نے کی ممانعت۔کسی ہتھیار سے کسی مسلمان کی طرف اشارہ کرنے کی ممانعتChapter: The Prohibition Of Pointing At A Muslim With A Weapon"
"6667","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ ، عَنْ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِمِثْلِهِ.nصحیح مسلم حدیث: 6667 عربی حدیث: 2616",": Sahih","Sahih Muslim 6667","","","35. باب: کسی مسلمان کو ہتھیار سے ڈرا نے کی ممانعت۔کسی ہتھیار سے کسی مسلمان کی طرف اشارہ کرنے کی ممانعتChapter: The Prohibition Of Pointing At A Muslim With A Weapon"
"6668","حَدَّثَنَا مُحَمَّدُ بْنُ رَافِعٍ ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ هَمَّامِ بْنِ مُنَبِّهٍ ، قَالَ: هَذَا مَا حَدَّثَنَا أَبُو هُرَيْرَةَ ، عَنِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَذَكَرَ أَحَادِيثَ مِنْهَا، وَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" لَا يُشِيرُ أَحَدُكُمْ إِلَى أَخِيهِ بِالسِّلَاحِ، فَإِنَّهُ لَا يَدْرِي أَحَدُكُمْ لَعَلَّ الشَّيْطَانَ يَنْزِعُ فِي يَدِهِ، فَيَقَعُ فِي حُفْرَةٍ مِنَ النَّارِ \"\".nصحیح مسلم حدیث: 6668 عربی حدیث: 2617",": Sahih","Sahih Muslim 6668","","","35. باب: کسی مسلمان کو ہتھیار سے ڈرا نے کی ممانعت۔کسی ہتھیار سے کسی مسلمان کی طرف اشارہ کرنے کی ممانعتChapter: The Prohibition Of Pointing At A Muslim With A Weapon"
"6669","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ سُمَيٍّ مَوْلَى أَبِي بَكْرٍ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" بَيْنَمَا رَجُلٌ يَمْشِي بِطَرِيقٍ، وَجَدَ غُصْنَ شَوْكٍ عَلَى الطَّرِيقِ، فَأَخَّرَهُ فَشَكَرَ اللَّهُ لَهُ فَغَفَرَ لَهُ \"\".nصحیح مسلم حدیث: 6669 عربی حدیث: 1914",": Sahih","Sahih Muslim 6669","","","36. باب: راہ میں سے موذی چیز ہٹانے کا ثواب۔راستے سے تکلیف دہ چیز ہٹا دینے کی فضیلتChapter: The Virtue Of Removing A Harmful Thing From The Road"
"6670","حَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا جَرِيرٌ ، عَنْ سُهَيْلٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" مَرَّ رَجُلٌ بِغُصْنِ شَجَرَةٍ عَلَى ظَهْرِ طَرِيقٍ، فَقَالَ: وَاللَّهِ لَأُنَحِّيَنَّ هَذَا عَنِ الْمُسْلِمِينَ لَا يُؤْذِيهِمْ فَأُدْخِلَ الْجَنَّةَ \"\".nصحیح مسلم حدیث: 6670 عربی حدیث: 1914",": Sahih","Sahih Muslim 6670","","","36. باب: راہ میں سے موذی چیز ہٹانے کا ثواب۔راستے سے تکلیف دہ چیز ہٹا دینے کی فضیلتChapter: The Virtue Of Removing A Harmful Thing From The Road"
"6671","حَدَّثَنَاه أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا عُبَيْدُ اللَّهِ ، حَدَّثَنَا شَيْبَانُ ، عَنْ الْأَعْمَشِ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَقَدْ رَأَيْتُ رَجُلًا يَتَقَلَّبُ فِي الْجَنَّةِ فِي شَجَرَةٍ قَطَعَهَا مِنْ ظَهْرِ الطَّرِيقِ كَانَتْ تُؤْذِي النَّاسَ \"\".nصحیح مسلم حدیث: 6671 عربی حدیث: 1914",": Sahih","Sahih Muslim 6671","","","36. باب: راہ میں سے موذی چیز ہٹانے کا ثواب۔راستے سے تکلیف دہ چیز ہٹا دینے کی فضیلتChapter: The Virtue Of Removing A Harmful Thing From The Road"
"6672","حَدَّثَنِي مُحَمَّدُ بْنُ حَاتِمٍ ، حَدَّثَنَا بَهْزٌ ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ ، عَنْ ثَابِتٍ ، عَنْ أَبِي رَافِعٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" إِنَّ شَجَرَةً كَانَتْ تُؤْذِي الْمُسْلِمِينَ، فَجَاءَ رَجُلٌ فَقَطَعَهَا فَدَخَلَ الْجَنَّةَ \"\".nصحیح مسلم حدیث: 6672 عربی حدیث: 1914",": Sahih","Sahih Muslim 6672","","","36. باب: راہ میں سے موذی چیز ہٹانے کا ثواب۔راستے سے تکلیف دہ چیز ہٹا دینے کی فضیلتChapter: The Virtue Of Removing A Harmful Thing From The Road"
"6673","حَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا يَحْيَي بْنُ سَعِيدٍ ، عَنْ أَبَانَ بْنِ صَمْعَةَ ، حَدَّثَنِي أَبُو الْوَازِعِ ، حَدَّثَنِي أَبُو بَرْزَةَ ، قَالَ: قُلْتُ: يَا نَبِيَّ اللَّهِ، عَلِّمْنِي شَيْئًا أَنْتَفِعُ بِهِ، قَالَ: \"\" اعْزِلِ الْأَذَى عَنْ طَرِيقِ الْمُسْلِمِينَ \"\".nصحیح مسلم حدیث: 6673 عربی حدیث: 2618",": Sahih","Sahih Muslim 6673","","","36. باب: راہ میں سے موذی چیز ہٹانے کا ثواب۔راستے سے تکلیف دہ چیز ہٹا دینے کی فضیلتChapter: The Virtue Of Removing A Harmful Thing From The Road"
"6674","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، أَخْبَرَنَا أَبُو بَكْرِ بْنُ شُعَيْبِ بْنِ الْحَبْحَابِ ، عَنْ أَبِي الْوَازِعِ الرَّاسِبِيِّ ، عَنْ أَبِي بَرْزَةَ الْأَسْلَمِيِّ ، أَنَّ أَبَا بَرْزَةَ، قَالَ: قُلْتُ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: يَا رَسُولَ اللَّهِ، إِنِّي لَا أَدْرِي لَعَسَى أَنْ تَمْضِيَ وَأَبْقَى بَعْدَكَ، فَزَوِّدْنِي شَيْئًا يَنْفَعُنِي اللَّهُ بِهِ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" افْعَلْ كَذَا، افْعَلْ كَذَا، أَبُو بَكْرٍ نَسِيَهُ، \"\" وَأَمِرَّ الْأَذَى عَنِ الطَّرِيقِ \"\".nصحیح مسلم حدیث: 6674 عربی حدیث: 2618",": Sahih","Sahih Muslim 6674","","","36. باب: راہ میں سے موذی چیز ہٹانے کا ثواب۔راستے سے تکلیف دہ چیز ہٹا دینے کی فضیلتChapter: The Virtue Of Removing A Harmful Thing From The Road"
"6675","حَدَّثَنِي عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ بْنِ عُبَيْدٍ الضُّبَعِيُّ ، حَدَّثَنَا جُوَيْرِيَةُ يَعْنِي ابْنَ أَسْمَاءَ ، عَنْ نَافِعٍ ، عَنْ عَبْدِ اللَّهِ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" عُذِّبَتِ امْرَأَةٌ فِي هِرَّةٍ سَجَنَتْهَا حَتَّى مَاتَتْ، فَدَخَلَتْ فِيهَا النَّارَ لَا هِيَ أَطْعَمَتْهَا وَسَقَتْهَا إِذْ هِيَ حَبَسَتْهَا وَلَا هِيَ تَرَكَتْهَا تَأْكُلُ مِنْ خَشَاشِ الْأَرْضِ \"\".nصحیح مسلم حدیث: 6675 عربی حدیث: 2242",": Sahih","Sahih Muslim 6675","","","37. باب: جو جانور ستاتا نہ ہو اس کو تکلیف دینا حرام ہے جیسے بلی کو۔بلی اور اس جیسے غیر موذی جانوروں کو ایذا دینے کی حرمتChapter: The Prohibition Of Tormenting Cats And Other Animals That Are Not Harmful"
"6676","حَدَّثَنِي هَارُونُ بْنُ عَبْدِ اللَّهِ ، وَعَبْدُ اللَّهِ بْنُ جَعْفَرِ بْنِ يَحْيَي بْنِ خَالِدٍ جَمِيعًا، عَنْ مَعْنِ بْنِ عِيسَى ، عَنْ مَالِكِ بْنِ أَنَسٍ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، عَن النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِمَعْنَى حَدِيثِ جُوَيْرِيَةَ.nصحیح مسلم حدیث: 6676 عربی حدیث: 2242",": Sahih","Sahih Muslim 6676","","","37. باب: جو جانور ستاتا نہ ہو اس کو تکلیف دینا حرام ہے جیسے بلی کو۔بلی اور اس جیسے غیر موذی جانوروں کو ایذا دینے کی حرمتChapter: The Prohibition Of Tormenting Cats And Other Animals That Are Not Harmful"
"6677","وحَدَّثَنِيهِ نَصْرُ بْنُ عَلِيٍّ الْجَهْضَمِيُّ ، حَدَّثَنَا عَبْدُ الْأَعْلَى ، عَنْ عُبَيْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" عُذِّبَتِ امْرَأَةٌ فِي هِرَّةٍ أَوْثَقَتْهَا، فَلَمْ تُطْعِمْهَا وَلَمْ تَسْقِهَا وَلَمْ تَدَعْهَا تَأْكُلُ مِنْ خَشَاشِ الْأَرْضِ \"\".nصحیح مسلم حدیث: 6677 عربی حدیث: 2242",": Sahih","Sahih Muslim 6677","","","37. باب: جو جانور ستاتا نہ ہو اس کو تکلیف دینا حرام ہے جیسے بلی کو۔بلی اور اس جیسے غیر موذی جانوروں کو ایذا دینے کی حرمتChapter: The Prohibition Of Tormenting Cats And Other Animals That Are Not Harmful"
"6678","حَدَّثَنَا نَصْرُ بْنُ عَلِيٍّ الْجَهْضَمِيُّ ، حَدَّثَنَا عَبْدُ الْأَعْلَى ، عَنْ عُبَيْدِ اللَّهِ ، عَنْ سَعِيدٍ الْمَقْبُرِيِّ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِمِثْلِهِ.nصحیح مسلم حدیث: 6678 عربی حدیث: 2242",": Sahih","Sahih Muslim 6678","","","37. باب: جو جانور ستاتا نہ ہو اس کو تکلیف دینا حرام ہے جیسے بلی کو۔بلی اور اس جیسے غیر موذی جانوروں کو ایذا دینے کی حرمتChapter: The Prohibition Of Tormenting Cats And Other Animals That Are Not Harmful"
"6679","حَدَّثَنَا مُحَمَّدُ بْنُ رَافِعٍ ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، حَدَّثَنَا مَعْمَرٌ ، عَنْ هَمَّامِ بْنِ مُنَبِّهٍ ، قَالَ: هَذَا مَا حَدَّثَنَا أَبُو هُرَيْرَةَ ، عَنِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَذَكَرَ أَحَادِيثَ مِنْهَا، وَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" دَخَلَتِ امْرَأَةٌ النَّارَ مِنْ جَرَّاءِ هِرَّةٍ لَهَا، أَوْ هِرٍّ رَبَطَتْهَا، فَلَا هِيَ أَطْعَمَتْهَا وَلَا هِيَ أَرْسَلَتْهَا تُرَمْرِمُ مِنْ خَشَاشِ الْأَرْضِ، حَتَّى مَاتَتْ هَزْلًا \"\".nصحیح مسلم حدیث: 6679 عربی حدیث: 2619",": Sahih","Sahih Muslim 6679","","","37. باب: جو جانور ستاتا نہ ہو اس کو تکلیف دینا حرام ہے جیسے بلی کو۔بلی اور اس جیسے غیر موذی جانوروں کو ایذا دینے کی حرمتChapter: The Prohibition Of Tormenting Cats And Other Animals That Are Not Harmful"
"6680","حَدَّثَنَا أَحْمَدُ بْنُ يُوسُفَ الْأَزْدِيُّ ، حَدَّثَنَا عُمَرُ بْنُ حَفْصِ بْنِ غِيَاثٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا الْأَعْمَشُ ، حَدَّثَنَا أَبُو إِسْحَاقَ ، عَنْ أَبِي مُسْلِمٍ الْأَغَرِّ ، أَنَّهُ حَدَّثَهُ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، وَأَبِي هُرَيْرَةَ ، قَالَا: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" الْعِزُّ إِزَارُهُ، وَالْكِبْرِيَاءُ رِدَاؤُهُ، فَمَنْ يُنَازِعُنِي عَذَّبْتُهُ \"\".nصحیح مسلم حدیث: 6680 عربی حدیث: 2620",": Sahih","Sahih Muslim 6680","","","38. باب: غرور کرنا حرام ہے۔تکبر کی حرمتChapter: The Prohibition Of Arrogance"
"6681","حَدَّثَنَا حَدَّثَنَا سُوَيْدُ بْنُ سَعِيدٍ ، عَنْ مُعْتَمِرِ بْنِ سُلَيْمَانَ ، عَنْ أَبِيهِ ، حَدَّثَنَا أَبُو عِمْرَانَ الْجَوْنِيُّ ، عَنْ جُنْدَبٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَدَّثَ: \"\" أَنَّ رَجُلًا، قَالَ: وَاللَّهِ لَا يَغْفِرُ اللَّهُ لِفُلَانٍ، وَإِنَّ اللَّهَ تَعَالَى، قَالَ: مَنْ ذَا الَّذِي يَتَأَلَّى عَلَيَّ أَنْ لَا أَغْفِرَ لِفُلَانٍ، فَإِنِّي قَدْ غَفَرْتُ لِفُلَانٍ، وَأَحْبَطْتُ عَمَلَكَ \"\" أَوْ كَمَا قَالَ.nصحیح مسلم حدیث: 6681 عربی حدیث: 2621",": Sahih","Sahih Muslim 6681","","","39. باب: اللہ کی رحمت سے کسی کو ناامید کرنا حرام ہے۔کسی انسان کو اللہ تعالیٰ کی رحمت سے نااُمید کرنے کی ممانعتChapter: The Prohibition Of Making Others Despair Of The Mercy Of Allah"
"6682","حَدَّثَنِي سُوَيْدُ بْنُ سَعِيدٍ ، حَدَّثَنِي حَفْصُ بْنُ مَيْسَرَةَ ، عَنْ الْعَلَاءِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" رُبَّ أَشْعَثَ مَدْفُوعٍ بِالْأَبْوَابِ لَوْ أَقْسَمَ عَلَى اللَّهِ لَأَبَرَّهُ \"\".nصحیح مسلم حدیث: 6682 عربی حدیث: 2622",": Sahih","Sahih Muslim 6682","","","40. باب: ناتوانوں اور گمنام شخصوں کی فضیلت۔کمزوروں اور گم نام خاک نشینوں کی فضیلتChapter: The Virtue Of The Weak And Downtrodden"
"6683","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ بْنِ قَعْنَبٍ ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ. ح وحَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" إِذَا قَالَ الرَّجُلُ: هَلَكَ النَّاسُ فَهُوَ أَهْلَكُهُمْ \"\"، قَالَ أَبُو إِسْحَاقَ: لَا أَدْرِي أَهْلَكَهُمْ بِالنَّصْبِ أَوْ أَهْلَكُهُمْ بِالرَّفْعِ.nصحیح مسلم حدیث: 6683 عربی حدیث: 2623",": Sahih","Sahih Muslim 6683","","","41. باب: یہ کہنا منع ہے کہ لوگ تباہ ہوئے۔یہ کہنے کی ممانعت: لوگ ہلاک ہو گئےChapter: The Prohibition Of Saying The People Are Doomed"
"6684","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، أَخْبَرَنَا يَزِيدُ بْنُ زُرَيْعٍ ، عَنْ رَوْحِ بْنِ الْقَاسِمِ . ح وحَدَّثَنِي أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ ، حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ سُلَيْمَانَ بْنِ بِلَالٍ جَمِيعًا، عَنْ سُهَيْلٍ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ.nصحیح مسلم حدیث: 6684 عربی حدیث: 2623",": Sahih","Sahih Muslim 6684","","","41. باب: یہ کہنا منع ہے کہ لوگ تباہ ہوئے۔یہ کہنے کی ممانعت: لوگ ہلاک ہو گئےChapter: The Prohibition Of Saying The People Are Doomed"
"6685","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، عَنْ مَالِكِ بْنِ أَنَسٍ . ح وحَدَّثَنَا قُتَيْبَةُ ، وَمُحَمَّدُ بْنُ رُمْحٍ ، عَنْ اللَّيْثِ بْنِ سَعْدٍ . ح وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا عَبْدَةُ ، وَيَزِيدُ بْنُ هَارُونَ كلهم، عَنْ يَحْيَي بْنِ سَعِيدٍ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى وَاللَّفْظُ لَهُ، حَدَّثَنَا عَبْدُ الْوَهَّابِ يَعْنِي الثَّقَفِيَّ ، سَمِعْتُ يَحْيَي بْنَ سَعِيدٍ ، أَخْبَرَنِي أَبُو بَكْرٍ وَهُوَ ابْنُ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، أَنَّ عَمْرَةَ حَدَّثَتْهُ، أَنَّهَا سَمِعَتْ عَائِشَةَ ، تَقُولُ سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \"\" مَا زَالَ جِبْرِيلُ يُوصِينِي بِالْجَارِ حَتَّى ظَنَنْتُ أَنَّهُ لَيُوَرِّثَنَّهُ \"\".nصحیح مسلم حدیث: 6685 عربی حدیث: 2624",": Sahih","Sahih Muslim 6685","","","42. باب: ہمسائے کا حق اور اس کے ساتھ حسن سلوک۔ہمسائے کے حق میں (اچھائی کی) تلقین اور حسن سلوکChapter: Advice To Treat One's Neighbor Well"
"6686","حَدَّثَنِي عَمْرٌو النَّاقِدُ ، حَدَّثَنَا عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ ، حَدَّثَنِي هِشَامُ بْنُ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِمِثْلِهِ.nصحیح مسلم حدیث: 6686 عربی حدیث: 2624",": Sahih","Sahih Muslim 6686","","","42. باب: ہمسائے کا حق اور اس کے ساتھ حسن سلوک۔ہمسائے کے حق میں (اچھائی کی) تلقین اور حسن سلوکChapter: Advice To Treat One's Neighbor Well"
"6687","حَدَّثَنِي عُبَيْدُ اللَّهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ، حَدَّثَنَا يَزِيدُ بْنُ زُرَيْعٍ ، عَنْ عُمَرَ بْنِ مُحَمَّدٍ ، عَنْ أَبِيهِ ، قَالَ: سَمِعْتُ ابْنَ عُمَرَ ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" مَا زَالَ جِبْرِيلُ يُوصِينِي بِالْجَارِ حَتَّى ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُ \"\".nصحیح مسلم حدیث: 6687 عربی حدیث: 2625",": Sahih","Sahih Muslim 6687","","","42. باب: ہمسائے کا حق اور اس کے ساتھ حسن سلوک۔ہمسائے کے حق میں (اچھائی کی) تلقین اور حسن سلوکChapter: Advice To Treat One's Neighbor Well"
"6688","حَدَّثَنَا أَبُو كَامِلٍ الْجَحْدَرِيُّ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، وَاللَّفْظُ لِإِسْحَاقَ، قَالَ أَبُو كَامِلٍ: حَدَّثَنَا، وقَالَ إِسْحَاقُ: أَخْبَرَنَا عَبْدُ الْعَزِيزِ بْنُ عَبْدِ الصَّمَدِ الْعَمِّيُّ ، حَدَّثَنَا أَبُو عِمْرَانَ الْجَوْنِيُّ ، عَنْ عَبْدِ اللَّهِ بْنِ الصَّامِتِ ، عَنْ أَبِي ذَرٍّ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: يَا أَبَا ذَرٍّ: \"\" إِذَا طَبَخْتَ مَرَقَةً فَأَكْثِرْ مَاءَهَا وَتَعَاهَدْ جِيرَانَكَ \"\".nصحیح مسلم حدیث: 6688 عربی حدیث: 2625",": Sahih","Sahih Muslim 6688","","","42. باب: ہمسائے کا حق اور اس کے ساتھ حسن سلوک۔ہمسائے کے حق میں (اچھائی کی) تلقین اور حسن سلوکChapter: Advice To Treat One's Neighbor Well"
"6689","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا ابْنُ إِدْرِيسَ ، أَخْبَرَنَا شُعْبَةُ . ح وحَدَّثَنَا أَبُو كُرَيْبٍ ، حَدَّثَنَا ابْنُ إِدْرِيسَ ، أَخْبَرَنَا شُعْبَةُ ، عَنْ أَبِي عِمْرَانَ الْجَوْنِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ الصَّامِتِ ، عَنْ أَبِي ذَرٍّ ، قَالَ: \"\" إِنَّ خَلِيلِي صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَوْصَانِي إِذَا طَبَخْتَ مَرَقًا فَأَكْثِرْ مَاءَهُ، ثُمَّ انْظُرْ أَهْلَ بَيْتٍ مِنْ جِيرَانِكَ، فَأَصِبْهُمْ مِنْهَا بِمَعْرُوفٍ \"\".nصحیح مسلم حدیث: 6689 عربی حدیث: 2625",": Sahih","Sahih Muslim 6689","","","42. باب: ہمسائے کا حق اور اس کے ساتھ حسن سلوک۔ہمسائے کے حق میں (اچھائی کی) تلقین اور حسن سلوکChapter: Advice To Treat One's Neighbor Well"
"6690","حَدَّثَنِي أَبُو غَسَّانَ الْمِسْمَعِيُّ ، حَدَّثَنَا عُثْمَانُ بْنُ عُمَرَ ، حَدَّثَنَا أَبُو عَامِرٍ يَعْنِي الْخَزَّازَ ، عَنْ أَبِي عِمْرَانَ الْجَوْنِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ الصَّامِتِ ، عَنْ أَبِي ذَرٍّ ، قَالَ: قَالَ لِيَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" لَا تَحْقِرَنَّ مِنَ الْمَعْرُوفِ شَيْئًا وَلَوْ أَنْ تَلْقَى أَخَاكَ بِوَجْهٍ طَلْقٍ \"\".nصحیح مسلم حدیث: 6690 عربی حدیث: 2626",": Sahih","Sahih Muslim 6690","","","43. باب: ملاقات کے وقت کشادہ پیشانی سے ملنا۔ملاقات کے وقت کشادہ چہرے سے ملنا مستحب ہےChapter: It Is Recommend To Show A Cheerful Countenance When Meeting Others"
"6691","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا عَلِيُّ بْنُ مُسْهِرٍ ، وَحَفْصُ بْنُ غِيَاثٍ ، عَنْ بُرَيْدِ بْنِ عَبْدِ اللَّهِ ، عَنْ أَبِي بُرْدَةَ ، عَنْ أَبِي مُوسَى ، قَالَ: \"\" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا أَتَاهُ طَالِبُ حَاجَةٍ أَقْبَلَ عَلَى جُلَسَائِهِ، فَقَالَ: \"\" اشْفَعُوا فَلْتُؤْجَرُوا وَلْيَقْضِ اللَّهُ عَلَى لِسَانِ نَبِيِّهِ مَا أَحَبَّ \"\".nصحیح مسلم حدیث: 6691 عربی حدیث: 2627",": Sahih","Sahih Muslim 6691","","","44. باب: اچھے کام میں سفارش کرنا مستجب ہے۔جو کام حرام نہ ہوں ان میں سفارش کرنا مستحب ہےChapter: It Is Recommend To Intercede With Regard To That Which Is Not Unlawful"
"6692","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ بُرَيْدِ بْنِ عَبْدِ اللَّهِ ، عَنْ جَدِّهِ ، عَنْ أَبِي مُوسَى ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ. ح وحَدَّثَنَا مُحَمَّدُ بْنُ الْعَلَاءِ الْهَمْدَانِيُّ ، وَاللَّفْظُ لَهُ، حَدَّثَنَا أَبُو أُسَامَةَ ، عَنْ بُرَيْدٍ ، عَنْ أَبِي بُرْدَةَ ، عَنْ أَبِي مُوسَى ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" إِنَّمَا مَثَلُ الْجَلِيسِ الصَّالِحِ وَالْجَلِيسِ السَّوْءِ، كَحَامِلِ الْمِسْكِ وَنَافِخِ الْكِيرِ، فَحَامِلُ الْمِسْكِ إِمَّا أَنْ يُحْذِيَكَ، وَإِمَّا أَنْ تَبْتَاعَ مِنْهُ، وَإِمَّا أَنْ تَجِدَ مِنْهُ رِيحًا طَيِّبَةً، وَنَافِخُ الْكِيرِ، إِمَّا أَنْ يُحْرِقَ ثِيَابَكَ، وَإِمَّا أَنْ تَجِدَ رِيحًا خَبِيثَةً \"\".nصحیح مسلم حدیث: 6692 عربی حدیث: 2628",": Sahih","Sahih Muslim 6692","","","45. باب: نیک صحبت کا حکم اور بری مجلس سے بچنے کے بیان میں۔نیکوں کے ساتھ اٹھنا بیٹھنا اور بُروں کی صحبت سے اجتناب کرنا مستحب ہےChapter: It Is Recommend To Keep Company With Righteous People And Avoid Bad Company"
"6693","حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ قُهْزَاذَ ، حَدَّثَنَا سَلَمَةُ بْنُ سُلَيْمَانَ ، أَخْبَرَنَا عَبْدُ اللَّهِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ ابْنِ شِهَابٍ ، حَدَّثَنِي عَبْدُ اللَّهِ بْنُ أَبِي بَكْرِ بْنِ حَزْمٍ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ . ح وحَدَّثَنِي عَبْدُ اللَّهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ بِهْرَامَ ، وَأَبُو بَكْرِ بْنُ إِسْحَاقَ ، وَاللَّفْظُ لَهُمَا، قَالَا: أَخْبَرَنَا أَبُو الْيَمَانِ ، أَخْبَرَنَا شُعَيْبٌ ، عَنْ الزُّهْرِيِّ ، حَدَّثَنِي عَبْدُ اللَّهِ بْنُ أَبِي بَكْرٍ ، أَنَّ عُرْوَةَ بْنَ الزُّبَيْرِ أَخْبَرَهُ، أَنَّ عَائِشَةَ زَوْجَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَتْ: جَاءَتْنِي امْرَأَةٌ وَمَعَهَا ابْنَتَانِ لَهَا، فَسَأَلَتْنِي فَلَمْ تَجِدْ عِنْدِي شَيْئًا غَيْرَ تَمْرَةٍ وَاحِدَةٍ، فَأَعْطَيْتُهَا إِيَّاهَا، فَأَخَذَتْهَا فَقَسَمَتْهَا بَيْنَ ابْنَتَيْهَا، وَلَمْ تَأْكُلْ مِنْهَا شَيْئًا، ثُمَّ قَامَتْ فَخَرَجَتْ وَابْنَتَاهَا، فَدَخَلَ عَلَيَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَحَدَّثْتُهُ حَدِيثَهَا، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" مَنِ ابْتُلِيَ مِنَ الْبَنَاتِ بِشَيْءٍ، فَأَحْسَنَ إِلَيْهِنَّ كُنَّ لَهُ سِتْرًا مِنَ النَّارِ \"\".nصحیح مسلم حدیث: 6693 عربی حدیث: 2629",": Sahih","Sahih Muslim 6693","","","46. باب: بیٹیوں کے پالنے کی فضیلت۔نیکوں کے ساتھ اٹھنا بیٹھنا اور بُروں کی صحبت سے اجتناب کرنا مستحب ہےChapter: It Is Recommend To Keep Company With Righteous People And Avoid Bad Company"
"6694","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا بَكْرٌ يَعْنِي ابْنَ مُضَرَ ، عَنْ ابْنِ الْهَادِ ، أَنَّ زِيَادَ بْنَ أَبِي زِيَادٍ مَوْلَى ابْنِ عَيَّاشٍ حَدَّثَهُ، عَنْ عِرَاكِ بْنِ مَالِكٍ ، سَمِعْتُهُ يُحَدِّثُ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ، عَنْ عَائِشَةَ ، أَنَّهَا قَالَتْ: \"\" جَاءَتْنِي مِسْكِينَةٌ تَحْمِلُ ابْنَتَيْنِ لَهَا، فَأَطْعَمْتُهَا ثَلَاثَ تَمَرَاتٍ، فَأَعْطَتْ كُلَّ وَاحِدَةٍ مِنْهُمَا تَمْرَةً، وَرَفَعَتْ إِلَى فِيهَا تَمْرَةً لِتَأْكُلَهَا، فَاسْتَطْعَمَتْهَا ابْنَتَاهَا، فَشَقَّتِ التَّمْرَةَ الَّتِي كَانَتْ تُرِيدُ أَنْ تَأْكُلَهَا بَيْنَهُمَا، فَأَعْجَبَنِي شَأْنُهَا فَذَكَرْتُ الَّذِي صَنَعَتْ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: إِنَّ اللَّهَ قَدْ أَوْجَبَ لَهَا بِهَا الْجَنَّةَ، أَوْ أَعْتَقَهَا بِهَا مِنَ النَّارِ \"\".nصحیح مسلم حدیث: 6694 عربی حدیث: 2630",": Sahih","Sahih Muslim 6694","","","46. باب: بیٹیوں کے پالنے کی فضیلت۔نیکوں کے ساتھ اٹھنا بیٹھنا اور بُروں کی صحبت سے اجتناب کرنا مستحب ہےChapter: It Is Recommend To Keep Company With Righteous People And Avoid Bad Company"
"6695","حَدَّثَنِي عَمْرٌو النَّاقِدُ ، حَدَّثَنَا أَبُو أَحْمَدَ الزُّبَيْرِيُّ ، حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ الْعَزِيزِ ، عَنْ عُبَيْدِ اللَّهِ بْنِ أَبِي بَكْرِ بْنِ أَنَسٍ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" مَنْ عَالَ جَارِيَتَيْنِ حَتَّى تَبْلُغَا جَاءَ يَوْمَ الْقِيَامَةِ أَنَا وَهُوَ، وَضَمَّ أَصَابِعَهُ \"\".nصحیح مسلم حدیث: 6695 عربی حدیث: 2631",": Sahih","Sahih Muslim 6695","","","46. باب: بیٹیوں کے پالنے کی فضیلت۔نیکوں کے ساتھ اٹھنا بیٹھنا اور بُروں کی صحبت سے اجتناب کرنا مستحب ہےChapter: It Is Recommend To Keep Company With Righteous People And Avoid Bad Company"
"6696","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ ابْنِ شِهَابٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" لَا يَمُوتُ لِأَحَدٍ مِنَ الْمُسْلِمِينَ ثَلَاثَةٌ مِنَ الْوَلَدِ، فَتَمَسَّهُ النَّارُ إِلَّا تَحِلَّةَ الْقَسَمِ \"\".nصحیح مسلم حدیث: 6696 عربی حدیث: 2632",": Sahih","Sahih Muslim 6696","","","47. باب: جس شخص کا بچہ مرے اور وہ صبر کرے۔اس شخص کی فضیلت جس کا بچہ فوت ہو جائے تو وہ اس کے بارے ثواب کی امید رکھےChapter: The Virtue Of One Whose Child Dies And He Seeks Reward"
"6697","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَعَمْرٌو النَّاقِدُ ، وَزُهَيْرُ بْنُ حَرْبٍ ، قَالُوا: حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ . ح وحَدَّثَنَا عَبْدُ بْنُ حُمَيْدٍ وَابْنُ رَافِعٍ ، عَنْ عَبْدِ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ كِلَاهُمَا، عَنْ الزُّهْرِيِّ بِإِسْنَادِ مَالِكٍ، وَبِمَعْنَى حَدِيثِهِ، إِلَّا أَنَّ فِي حَدِيثِ سُفْيَانَ: فَيَلِجَ النَّارَ إِلَّا تَحِلَّةَ الْقَسَمِ.nصحیح مسلم حدیث: 6697 عربی حدیث: 2632",": Sahih","Sahih Muslim 6697","","","47. باب: جس شخص کا بچہ مرے اور وہ صبر کرے۔اس شخص کی فضیلت جس کا بچہ فوت ہو جائے تو وہ اس کے بارے ثواب کی امید رکھےChapter: The Virtue Of One Whose Child Dies And He Seeks Reward"
"6698","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا عَبْدُ الْعَزِيزِ يَعْنِي ابْنَ مُحَمَّدٍ ، عَنْ سُهَيْلٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ لِنِسْوَةٍ مِنْ الْأَنْصَارِ: \"\" لَا يَمُوتُ لِإِحْدَاكُنَّ ثَلَاثَةٌ مِنَ الْوَلَدِ، فَتَحْتَسِبَهُ إِلَّا دَخَلَتِ الْجَنَّةَ \"\"، فَقَالَتِ امْرَأَةٌ مِنْهُنَّ: أَوِ اثْنَيْنِ يَا رَسُولَ اللَّهِ، قَالَ: أَوِ اثْنَيْنِ.nصحیح مسلم حدیث: 6698 عربی حدیث: 2632",": Sahih","Sahih Muslim 6698","","","47. باب: جس شخص کا بچہ مرے اور وہ صبر کرے۔اس شخص کی فضیلت جس کا بچہ فوت ہو جائے تو وہ اس کے بارے ثواب کی امید رکھےChapter: The Virtue Of One Whose Child Dies And He Seeks Reward"
"6699","حَدَّثَنَا أَبُو كَامِلٍ الْجَحْدَرِيُّ فُضَيْلُ بْنُ حُسَيْنٍ ، حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْأَصْبَهَانِيِّ ، عَنْ أَبِي صَالِحٍ ذَكْوَانَ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ: جَاءَتِ امْرَأَةٌ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَتْ: يَا رَسُولَ اللَّهِ، ذَهَبَ الرِّجَالُ بِحَدِيثِكَ، فَاجْعَلْ لَنَا مِنْ نَفْسِكَ يَوْمًا نَأْتِيكَ فِيهِ تُعَلِّمُنَا مِمَّا عَلَّمَكَ اللَّهُ، قَالَ: اجْتَمِعْنَ يَوْمَ كَذَا وَكَذَا، فَاجْتَمَعْنَ فَأَتَاهُنَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَعَلَّمَهُنَّ مِمَّا عَلَّمَهُ اللَّهُ، ثُمَّ قَالَ: \"\" مَا مِنْكُنَّ مِنَ امْرَأَةٍ تُقَدِّمُ بَيْنَ يَدَيْهَا مِنْ وَلَدِهَا ثَلَاثَةً إِلَّا كَانُوا لَهَا حِجَابًا مِنَ النَّارِ \"\"، فَقَالَتِ امْرَأَةٌ: وَاثْنَيْنِ، وَاثْنَيْنِ، وَاثْنَيْنِ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" وَاثْنَيْنِ، وَاثْنَيْنِ، وَاثْنَيْنِ.nصحیح مسلم حدیث: 6699 عربی حدیث: 2633",": Sahih","Sahih Muslim 6699","","","47. باب: جس شخص کا بچہ مرے اور وہ صبر کرے۔اس شخص کی فضیلت جس کا بچہ فوت ہو جائے تو وہ اس کے بارے ثواب کی امید رکھےChapter: The Virtue Of One Whose Child Dies And He Seeks Reward"
"6700","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ . ح وحَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا شُعْبَةُ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْأَصْبَهَانِيِّ ، فِي هَذَا الْإِسْنَادِ بِمِثْلِ مَعْنَاهُ وَزَادَا جَمِيعًا، عَنْ شُعْبَةَ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْأَصْبَهَانِيِّ، قَالَ: سَمِعْتُ أَبَا حَازِمٍ يُحَدِّثُ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: ثَلَاثَةً لَمْ يَبْلُغُوا الْحِنْثَ.nصحیح مسلم حدیث: 6700 عربی حدیث: 2634",": Sahih","Sahih Muslim 6700","","","47. باب: جس شخص کا بچہ مرے اور وہ صبر کرے۔اس شخص کی فضیلت جس کا بچہ فوت ہو جائے تو وہ اس کے بارے ثواب کی امید رکھےChapter: The Virtue Of One Whose Child Dies And He Seeks Reward"
"6701","حَدَّثَنَا سُوَيْدُ بْنُ سَعِيدٍ ، وَمُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى وَتَقَارَبَا فِي اللَّفْظِ، قَالَا: حَدَّثَنَا الْمُعْتَمِرُ ، عَنْ أَبِيهِ ، عَنْ أَبِي السَّلِيلِ ، عَنْ أَبِي حَسَّانَ ، قَالَ: قُلْتُ لِأَبِي هُرَيْرَةَ : \"\" إِنَّهُ قَدْ مَاتَ لِيَ ابْنَانِ، فَمَا أَنْتَ مُحَدِّثِي عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِحَدِيثٍ تُطَيِّبُ بِهِ أَنْفُسَنَا عَنْ مَوْتَانَا؟ قَالَ: قَالَ: نَعَمْ، صِغَارُهُمْ دَعَامِيصُ الْجَنَّةِ يَتَلَقَّى أَحَدُهُمْ أَبَاهُ، أَوَ قَالَ: أَبَوَيْهِ فَيَأْخُذُ بِثَوْبِهِ، أَوَ قَالَ: بِيَدِهِ كَمَا آخُذُ أَنَا بِصَنِفَةِ ثَوْبِكَ هَذَا فَلَا يَتَنَاهَى، أَوَ قَالَ: فَلَا يَنْتَهِي حَتَّى يُدْخِلَهُ اللَّهُ وَأَبَاهُ الْجَنَّةَ \"\". وَفِي رِوَايَةِ سُوَيْدٍ، قَالَ: حَدَّثَنَا أَبُو السَّلِيلِ،nصحیح مسلم حدیث: 6701 عربی حدیث: 2635",": Sahih","Sahih Muslim 6701","","","47. باب: جس شخص کا بچہ مرے اور وہ صبر کرے۔اس شخص کی فضیلت جس کا بچہ فوت ہو جائے تو وہ اس کے بارے ثواب کی امید رکھےChapter: The Virtue Of One Whose Child Dies And He Seeks Reward"
"6702","وحَدَّثَنِيهِ عُبَيْدُ اللَّهِ بْنُ سَعِيدٍ ، حَدَّثَنَا يَحْيَي يَعْنِي ابْنَ سَعِيدٍ ، عَنْ التَّيْمِيِّ ، بِهَذَا الْإِسْنَادِ، وَقَالَ: فَهَلْ سَمِعْتَ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ شَيْئًا تُطَيِّبُ بِهِ أَنْفُسَنَا عَنْ مَوْتَانَا؟ قَالَ: نَعَمْ.nصحیح مسلم حدیث: 6702 عربی حدیث: 2635",": Sahih","Sahih Muslim 6702","","","47. باب: جس شخص کا بچہ مرے اور وہ صبر کرے۔اس شخص کی فضیلت جس کا بچہ فوت ہو جائے تو وہ اس کے بارے ثواب کی امید رکھےChapter: The Virtue Of One Whose Child Dies And He Seeks Reward"
"6703","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَمُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، وَأَبُو سَعِيدٍ الْأَشَجُّ ، وَاللَّفْظُ لِأَبِي بَكْرٍ، قَالُوا: حَدَّثَنَا حَفْصٌ يَعْنُونَ ابْنَ غِيَاثٍ . ح وحَدَّثَنَا عُمَرُ بْنُ حَفْصِ بْنِ غِيَاثٍ ، حَدَّثَنَا أَبِي ، عَنْ جَدِّهِ طَلْقِ بْنِ مُعَاوِيَةَ ، عَنْ أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: \"\" أَتَتِ امْرَأَةٌ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِصَبِيٍّ لَهَا، فَقَالَتْ: يَا نَبِيَّ اللَّهِ، ادْعُ اللَّهَ لَهُ فَلَقَدْ دَفَنْتُ ثَلَاثَةً، قَالَ: دَفَنْتِ ثَلَاثَةً؟ قَالَتْ: نَعَمْ، قَالَ: لَقَدِ احْتَظَرْتِ بِحِظَارٍ شَدِيدٍ مِنَ النَّارِ \"\". قَالَ عُمَرُ مِنْ بَيْنِهِمْ: عَنْ جَدِّهِ، وقَالَ الْبَاقُونَ: عَنْ طَلْقٍ، وَلَمْ يَذْكُرُوا الْجَدَّ.nصحیح مسلم حدیث: 6703 عربی حدیث: 2636",": Sahih","Sahih Muslim 6703","","","47. باب: جس شخص کا بچہ مرے اور وہ صبر کرے۔اس شخص کی فضیلت جس کا بچہ فوت ہو جائے تو وہ اس کے بارے ثواب کی امید رکھےChapter: The Virtue Of One Whose Child Dies And He Seeks Reward"
"6704","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، وَزُهَيْرُ بْنُ حَرْبٍ ، قَالَا: حَدَّثَنَا جَرِيرٌ ، عَنْ طَلْقِ بْنِ مُعَاوِيَةَ النَّخَعِيِّ أَبِي غِيَاثٍ ، عَنْ أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: \"\" جَاءَتِ امْرَأَةٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِابْنٍ لَهَا، فَقَالَتْ: يَا رَسُولَ اللَّهِ، إِنَّهُ يَشْتَكِي، وَإِنِّي أَخَافُ عَلَيْهِ قَدْ دَفَنْتُ ثَلَاثَةً، قَالَ: لَقَدِ احْتَظَرْتِ بِحِظَارٍ شَدِيدٍ مِنَ النَّارِ \"\"، قَالَ زُهَيْرٌ: عَنْ طَلْقٍ وَلَمْ يَذْكُرِ الْكُنْيَةَ.nصحیح مسلم حدیث: 6704 عربی حدیث: 2636",": Sahih","Sahih Muslim 6704","","","47. باب: جس شخص کا بچہ مرے اور وہ صبر کرے۔اس شخص کی فضیلت جس کا بچہ فوت ہو جائے تو وہ اس کے بارے ثواب کی امید رکھےChapter: The Virtue Of One Whose Child Dies And He Seeks Reward"
"6705","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا جَرِيرٌ ، عَنْ سُهَيْلٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" إِنَّ اللَّهَ إِذَا أَحَبَّ عَبْدًا دَعَا جِبْرِيلَ، فَقَالَ: إِنِّي أُحِبُّ فُلَانًا فَأَحِبَّهُ، قَالَ: فَيُحِبُّهُ جِبْرِيلُ، ثُمَّ يُنَادِي فِي السَّمَاءِ، فَيَقُولُ: إِنَّ اللَّهَ يُحِبُّ فُلَانًا فَأَحِبُّوهُ فَيُحِبُّهُ أَهْلُ السَّمَاءِ، قَالَ: ثُمَّ يُوضَعُ لَهُ الْقَبُولُ فِي الْأَرْضِ، وَإِذَا أَبْغَضَ عَبْدًا دَعَا جِبْرِيلَ، فَيَقُولُ: إِنِّي أُبْغِضُ فُلَانًا فَأَبْغِضْهُ، قَالَ: فَيُبْغِضُهُ جِبْرِيلُ، ثُمَّ يُنَادِي فِي أَهْلِ السَّمَاءِ إِنَّ اللَّهَ يُبْغِضُ فُلَانًا فَأَبْغِضُوهُ، قَالَ: فَيُبْغِضُونَهُ ثُمَّ تُوضَعُ لَهُ الْبَغْضَاءُ فِي الْأَرْضِ \"\".nصحیح مسلم حدیث: 6705 عربی حدیث: 2637",": Sahih","Sahih Muslim 6705","","","48. باب: جب اللہ کریم کسی بندے سے محبت کرتا ہے تو جبرئیل علیہ السلام کو بھی اس سے محبت رکھنے کا حکم کرتے ہیں اور آسمان کے فرشتے بھی اس سے محبت کر تے ہیں۔جب اللہ تعالیٰ کسی سے محبت کرتا ہے تو جبرائیل کو حکم دیتا ہے تو وہ اس سے محبت کرتے ہیں اور آسمان والے اس سے محبت کرتے ہیں، پھر زمین میں اس کے لیے مقبولیت رکھ دی جاتی ہےChapter: When Allah Loves A Person. He Commands Jibril To Love Him, And He Loves Him, And The People Of Heaven Love Him, Then He Finds Acceptance On Earth"
"6706","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا يَعْقُوبُ يَعْنِي ابْنَ عَبْدِ الرَّحْمَنِ الْقَارِيَّ ، وَقَالَ قُتَيْبَةُ : حَدَّثَنَا عَبْدُ الْعَزِيزِ يَعْنِي الدَّرَاوَرْدِيَّ . ح وحَدَّثَنَاه سَعِيدُ بْنُ عَمْرٍو الْأَشْعَثِيُّ ، أَخْبَرَنَا عَبْثَرٌ ، عَنْ الْعَلَاءِ بْنِ الْمُسَيَّبِ . ح وحَدَّثَنِي هَارُونُ بْنُ سَعِيدٍ الْأَيْلِيُّ ، حَدَّثَنَا ابْنُ وَهْبٍ، حَدَّثَنِي مَالِكٌ وَهُوَ ابْنُ أَنَسٍ كُلُّهُمْ، عَنْ سُهَيْلٍ ، بِهَذَا الْإِسْنَادِ، غَيْرَ أَنَّ حَدِيثَ الْعَلَاءِ بْنِ الْمُسَيَّبِ لَيْسَ فِيهِ ذِكْرُ الْبُغْضِ.nصحیح مسلم حدیث: 6706 عربی حدیث: 2637",": Sahih","Sahih Muslim 6706","","","48. باب: جب اللہ کریم کسی بندے سے محبت کرتا ہے تو جبرئیل علیہ السلام کو بھی اس سے محبت رکھنے کا حکم کرتے ہیں اور آسمان کے فرشتے بھی اس سے محبت کر تے ہیں۔جب اللہ تعالیٰ کسی سے محبت کرتا ہے تو جبرائیل کو حکم دیتا ہے تو وہ اس سے محبت کرتے ہیں اور آسمان والے اس سے محبت کرتے ہیں، پھر زمین میں اس کے لیے مقبولیت رکھ دی جاتی ہےChapter: When Allah Loves A Person. He Commands Jibril To Love Him, And He Loves Him, And The People Of Heaven Love Him, Then He Finds Acceptance On Earth"
"6707","حَدَّثَنِي عَمْرٌو النَّاقِدُ ، حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ ، أَخْبَرَنَا عَبْدُ الْعَزِيزِ بْنُ عَبْدِ اللَّهِ بْنِ أَبِي سَلَمَةَ الْمَاجِشُونُ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، قَالَ: كُنَّا بِعَرَفَةَ، فَمَرَّ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ وَهُوَ عَلَى الْمَوْسِمِ، فَقَامَ النَّاسُ يَنْظُرُونَ إِلَيْهِ، فَقُلْتُ لِأَبِي: يَا أَبَتِ، إِنِّي أَرَى اللَّهَ يُحِبُّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ، قَالَ: وَمَا ذَاكَ؟ قُلْتُ: لِمَا لَهُ مِنَ الْحُبِّ فِي قُلُوبِ النَّاسِ، فَقَالَ: بِأَبِيكَ أَنْتَ سَمِعْتُ أَبَا هُرَيْرَةَ يُحَدِّثُ عَنِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، ثُمَّ ذَكَرَ بِمِثْلِ حَدِيثِ جَرِيرٍ، عَنْ سُهَيْلٍ.nصحیح مسلم حدیث: 6707 عربی حدیث: 2637",": Sahih","Sahih Muslim 6707","","","48. باب: جب اللہ کریم کسی بندے سے محبت کرتا ہے تو جبرئیل علیہ السلام کو بھی اس سے محبت رکھنے کا حکم کرتے ہیں اور آسمان کے فرشتے بھی اس سے محبت کر تے ہیں۔جب اللہ تعالیٰ کسی سے محبت کرتا ہے تو جبرائیل کو حکم دیتا ہے تو وہ اس سے محبت کرتے ہیں اور آسمان والے اس سے محبت کرتے ہیں، پھر زمین میں اس کے لیے مقبولیت رکھ دی جاتی ہےChapter: When Allah Loves A Person. He Commands Jibril To Love Him, And He Loves Him, And The People Of Heaven Love Him, Then He Finds Acceptance On Earth"
"6708","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا عَبْدُ الْعَزِيزِ يَعْنِي ابْنَ مُحَمَّدٍ ، عَنْ سُهَيْلٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \"\" الْأَرْوَاحُ جُنُودٌ مُجَنَّدَةٌ، فَمَا تَعَارَفَ مِنْهَا ائْتَلَفَ، وَمَا تَنَاكَرَ مِنْهَا اخْتَلَفَ \"\".nصحیح مسلم حدیث: 6708 عربی حدیث: 2638",": Sahih","Sahih Muslim 6708","","","49. باب: روحوں کے جھنڈ کے جھنڈ ہیں۔روحیں (عالم ارواح میں) ایسی جماعتیں ہیں جو ایک دوسرے کے ساتھ رہتی ہیںChapter: Souls Are Like Conscripted Soldiers"
"6709","حَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا كَثِيرُ بْنُ هِشَامٍ ، حَدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ ، حَدَّثَنَا يَزِيدُ بْنُ الْأَصَمِّ ، عَنْ أَبِي هُرَيْرَةَ ، بِحَدِيثٍ يَرْفَعُهُ، قَالَ: \"\" النَّاسُ مَعَادِنُ كَمَعَادِنِ الْفِضَّةِ وَالذَّهَبِ، خِيَارُهُمْ فِي الْجَاهِلِيَّةِ خِيَارُهُمْ فِي الْإِسْلَامِ، إِذَا فَقُهُوا وَالْأَرْوَاحُ جُنُودٌ مُجَنَّدَةٌ، فَمَا تَعَارَفَ مِنْهَا ائْتَلَفَ، وَمَا تَنَاكَرَ مِنْهَا اخْتَلَفَ \"\".nصحیح مسلم حدیث: 6709 عربی حدیث: 2638",": Sahih","Sahih Muslim 6709","","","49. باب: روحوں کے جھنڈ کے جھنڈ ہیں۔روحیں (عالم ارواح میں) ایسی جماعتیں ہیں جو ایک دوسرے کے ساتھ رہتی ہیںChapter: Souls Are Like Conscripted Soldiers"
"6710","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ بْنِ قَعْنَبٍ ، حَدَّثَنَا مَالِكٌ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي طَلْحَةَ ، عَنْ أَنَسِ بْنِ مَالِكٍ : أَنَّ أَعْرَابِيًّا، قَالَ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"\" مَتَى السَّاعَةُ؟ قَالَ لَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: مَا أَعْدَدْتَ لَهَا؟ قَالَ: حُبَّ اللَّهِ وَرَسُولِهِ، قَالَ: أَنْتَ مَعَ مَنْ أَحْبَبْتَ \"\".nصحیح مسلم حدیث: 6710 عربی حدیث: 2639",": Sahih","Sahih Muslim 6710","","","50. باب: آدمی اسی کے ساتھ ہو گا جس سے دو ستی رکھے۔آدمی اسی کے ساتھ ہو گا جس سے وہ محبت کرتا ہےChapter: A Man Will Be With Those Whom He Loves"
"6711","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَعَمْرٌو النَّاقِدُ ، وَزُهَيْرُ بْنُ حَرْبٍ ، وَمُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، وَابْنُ أَبِي عُمَرَ ، وَاللَّفْظُ لِزُهَيْرٍ، قَالُوا: حَدَّثَنَا سُفْيَانُ ، عَنْ الزُّهْرِيِّ ، عَنْ أَنَسٍ ، قَالَ: قَالَ رَجُلٌ: يَا رَسُولَ اللَّهِ، \"\" مَتَى السَّاعَةُ؟ قَالَ: وَمَا أَعْدَدْتَ لَهَا؟ فَلَمْ يَذْكُرْ كَبِيرًا، قَالَ: وَلَكِنِّي أُحِبُّ اللَّهَ وَرَسُولَهُ، قَالَ: فَأَنْتَ مَعَ مَنْ أَحْبَبْتَ \"\".nصحیح مسلم حدیث: 6711 عربی حدیث: 2639",": Sahih","Sahih Muslim 6711","","","50. باب: آدمی اسی کے ساتھ ہو گا جس سے دو ستی رکھے۔آدمی اسی کے ساتھ ہو گا جس سے وہ محبت کرتا ہےChapter: A Man Will Be With Those Whom He Loves"
"6712","حَدَّثَنِيهِ مُحَمَّدُ بْنُ رَافِعٍ ، وَعَبْدُ بْنُ حُمَيْدٍ ، قَالَ عَبْدٌ: أَخْبَرَنَا، وَقَالَ ابْنُ رَافِعٍ: حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ الزُّهْرِيِّ ، حَدَّثَنِي أَنَسُ بْنُ مَالِكٍ : أَنَّ رَجُلًا مِنَ الْأَعْرَابِ أَتَى رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِمِثْلِهِ، غَيْرَ أَنَّهُ قَالَ: مَا أَعْدَدْتُ لَهَا مِنْ كَثِيرٍ أَحْمَدُ عَلَيْهِ نَفْسِي.nصحیح مسلم حدیث: 6712 عربی حدیث: 2639",": Sahih","Sahih Muslim 6712","","","50. باب: آدمی اسی کے ساتھ ہو گا جس سے دو ستی رکھے۔آدمی اسی کے ساتھ ہو گا جس سے وہ محبت کرتا ہےChapter: A Man Will Be With Those Whom He Loves"
"6713","حَدَّثَنِي أَبُو الرَّبِيعِ الْعَتَكِيُّ ، حَدَّثَنَا حَمَّادٌ يَعْنِي ابْنَ زَيْدٍ ، حَدَّثَنَا ثَابِتٌ الْبُنَانِيُّ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، قَالَ: \"\" جَاءَ رَجُلٌ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: يَا رَسُولَ اللَّهِ، مَتَى السَّاعَةُ؟ قَالَ: وَمَا أَعْدَدْتَ لِلسَّاعَةِ؟ قَالَ: حُبَّ اللَّهِ وَرَسُولِهِ، قَالَ: فَإِنَّكَ مَعَ مَنْ أَحْبَبْتَ \"\"، قَالَ أَنَسٌ: فَمَا فَرِحْنَا بَعْدَ الْإِسْلَامِ فَرَحًا أَشَدَّ مِنْ قَوْلِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: فَإِنَّكَ مَعَ مَنْ أَحْبَبْتَ، قَالَ أَنَسٌ: فَأَنَا أُحِبُّ اللَّهَ وَرَسُولَهُ، وَأَبَا بَكْرٍ، وَعُمَرَ، فَأَرْجُو أَنْ أَكُونَ مَعَهُمْ، وَإِنْ لَمْ أَعْمَلْ بِأَعْمَالِهِمْ.nصحیح مسلم حدیث: 6713 عربی حدیث: 2639",": Sahih","Sahih Muslim 6713","","","50. باب: آدمی اسی کے ساتھ ہو گا جس سے دو ستی رکھے۔آدمی اسی کے ساتھ ہو گا جس سے وہ محبت کرتا ہےChapter: A Man Will Be With Those Whom He Loves"
"6714","حَدَّثَنَاه مُحَمَّدُ بْنُ عُبَيْدٍ الْغُبَرِيُّ ، حَدَّثَنَا جَعْفَرُ بْنُ سُلَيْمَانَ ، حَدَّثَنَا ثَابِتٌ الْبُنَانِيُّ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَلَمْ يَذْكُرْ قَوْلَ أَنَسٍ: فَأَنَا أُحِبُّ وَمَا بَعْدَهُ.nصحیح مسلم حدیث: 6714 عربی حدیث: 2639",": Sahih","Sahih Muslim 6714","","","50. باب: آدمی اسی کے ساتھ ہو گا جس سے دو ستی رکھے۔آدمی اسی کے ساتھ ہو گا جس سے وہ محبت کرتا ہےChapter: A Man Will Be With Those Whom He Loves"
"6715","حَدَّثَنَا عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ إِسْحَاقُ: أَخْبَرَنَا، وقَالَ عُثْمَانُ: حَدَّثَنَا جَرِيرٌ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمِ بْنِ أَبِي الْجَعْدِ ، حَدَّثَنَا أَنَسُ بْنُ مَالِكٍ ، قَالَ: بَيْنَمَا أَنَا وَرَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَارِجَيْنِ مِنَ الْمَسْجِدِ، فَلَقِينَا رَجُلًا عِنْدَ سُدَّةِ الْمَسْجِدِ، فَقَالَ: يَا رَسُولَ اللَّهِ، \"\" مَتَى السَّاعَةُ؟ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: مَا أَعْدَدْتَ لَهَا؟ قَالَ: فَكَأَنَّ الرَّجُلَ اسْتَكَانَ، ثُمَّ قَالَ: يَا رَسُولَ اللَّهِ، مَا أَعْدَدْتُ لَهَا كَبِيرَ صَلَاةٍ، وَلَا صِيَامٍ، وَلَا صَدَقَةٍ، وَلَكِنِّي أُحِبُّ اللَّهَ وَرَسُولَهُ، قَالَ: فَأَنْتَ مَعَ مَنْ أَحْبَبْتَ \"\".nصحیح مسلم حدیث: 6715 عربی حدیث: 2639",": Sahih","Sahih Muslim 6715","","","50. باب: آدمی اسی کے ساتھ ہو گا جس سے دو ستی رکھے۔آدمی اسی کے ساتھ ہو گا جس سے وہ محبت کرتا ہےChapter: A Man Will Be With Those Whom He Loves"
"6716","حَدَّثَنِي مُحَمَّدُ بْنُ يَحْيَي بْنِ عَبْدِ الْعَزِيزِ الْيَشْكُرِيُّ ، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ عُثْمَانَ بْنِ جَبَلَةَ ، أَخْبَرَنِي أَبِي ، عَنْ شُعْبَةَ ، عَنْ عَمْرِو بْنِ مُرَّةَ ، عَنْ سَالِمِ بْنِ أَبِي الْجَعْدِ ، عَنْ أَنَسٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِنَحْوِهِ.nصحیح مسلم حدیث: 6716 عربی حدیث: 2639",": Sahih","Sahih Muslim 6716","","","50. باب: آدمی اسی کے ساتھ ہو گا جس سے دو ستی رکھے۔آدمی اسی کے ساتھ ہو گا جس سے وہ محبت کرتا ہےChapter: A Man Will Be With Those Whom He Loves"
"6717","حَدَّثَنَا قُتَيْبَةُ ، حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ قَتَادَةَ ، عَنْ أَنَسٍ . ح وحَدَّثَنَا ابْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، عَنْ قَتَادَةَ ، سَمِعْتُ أَنَسًا . ح وحَدَّثَنَا أَبُو غَسَّانَ الْمِسْمَعِيُّ ، وَمُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَا: حَدَّثَنَا مُعَاذٌ يَعْنِي ابْنَ هِشَامٍ ، حَدَّثَنِي أَبِي ، عَنْ قَتَادَةَ ، عَنْ أَنَسٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِهَذَا الْحَدِيثِ.nصحیح مسلم حدیث: 6717 عربی حدیث: 2639",": Sahih","Sahih Muslim 6717","","","50. باب: آدمی اسی کے ساتھ ہو گا جس سے دو ستی رکھے۔آدمی اسی کے ساتھ ہو گا جس سے وہ محبت کرتا ہےChapter: A Man Will Be With Those Whom He Loves"
"6718","حَدَّثَنَا عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ إِسْحَاقُ: أَخْبَرَنَا، وقَالَ عُثْمَانُ: حَدَّثَنَا جَرِيرٌ ، عَنْ الْأَعْمَشِ ، عَنْ أَبِي وَائِلٍ ، عَنْ عَبْدِ اللَّهِ ، قَالَ: جَاءَ رَجُلٌ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: \"\" يَا رَسُولَ اللَّهِ، كَيْفَ تَرَى فِي رَجُلٍ أَحَبَّ قَوْمًا وَلَمَّا يَلْحَقْ بِهِمْ؟ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: الْمَرْءُ مَعَ مَنْ أَحَبَّ \"\".nصحیح مسلم حدیث: 6718 عربی حدیث: 2640",": Sahih","Sahih Muslim 6718","","","50. باب: آدمی اسی کے ساتھ ہو گا جس سے دو ستی رکھے۔آدمی اسی کے ساتھ ہو گا جس سے وہ محبت کرتا ہےChapter: A Man Will Be With Those Whom He Loves"
"6719","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا ابْنُ أَبِي عَدِيٍّ . ح وحَدَّثَنِيهِ بِشْرُ بْنُ خَالِدٍ ، أَخْبَرَنَا مُحَمَّدٌ يَعْنِي ابْنَ جَعْفَرٍ كِلَاهُمَا، عَنْ شُعْبَةَ . ح وحَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا أَبُو الْجَوَّابِ ، حَدَّثَنَا سُلَيْمَانُ بْنُ قَرْمٍ جَمِيعًا، عَنْ سُلَيْمَانَ ، عَنْ أَبِي وَائِلٍ ، عَنْ عَبْدِ اللَّهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِمِثْلِهِ.nصحیح مسلم حدیث: 6719 عربی حدیث: 2640",": Sahih","Sahih Muslim 6719","","","50. باب: آدمی اسی کے ساتھ ہو گا جس سے دو ستی رکھے۔آدمی اسی کے ساتھ ہو گا جس سے وہ محبت کرتا ہےChapter: A Man Will Be With Those Whom He Loves"
"6720","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، قَالَا: حَدَّثَنَا أَبُو مُعَاوِيَةَ . ح وحَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا أَبُو مُعَاوِيَةَ ، وَمُحَمَّدُ بْنُ عُبَيْدٍ ، عَنْ الْأَعْمَشِ ، عَنْ شَقِيقٍ ، عَنْ أَبِي مُوسَى ، قَالَ: أَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَجُلٌ، فَذَكَرَ بِمِثْلِ حَدِيثِ جَرِيرٍ، عَنْ الْأَعْمَشِ.nصحیح مسلم حدیث: 6720 عربی حدیث: 2641",": Sahih","Sahih Muslim 6720","","","50. باب: آدمی اسی کے ساتھ ہو گا جس سے دو ستی رکھے۔آدمی اسی کے ساتھ ہو گا جس سے وہ محبت کرتا ہےChapter: A Man Will Be With Those Whom He Loves"
"6721","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي التَّمِيمِيُّ ، وَأَبُو الرَّبِيعِ ، وَأَبُو كَامِلٍ فُضَيْلُ بْنُ حُسَيْنٍ ، وَاللَّفْظُ لِيَحْيَي، قَالَ يَحْيَي: أَخْبَرَنَا، وقَالَ الْآخَرَانِ: حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ ، عَنْ أَبِي عِمْرَانَ الْجَوْنِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ الصَّامِتِ ، عَنْ أَبِي ذَرٍّ ، قَالَ: قِيلَ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ:\"\" أَرَأَيْتَ الرَّجُلَ يَعْمَلُ الْعَمَلَ مِنَ الْخَيْرِ وَيَحْمَدُهُ النَّاسُ عَلَيْهِ؟ قَالَ: تِلْكَ عَاجِلُ بُشْرَى الْمُؤْمِنِ\"\". حnصحیح مسلم حدیث: 6721 عربی حدیث: 2642",": Sahih","Sahih Muslim 6721","","","51. باب: نیک آدمی کی تعریف دنیا میں اس کو خوشی ہے۔جب کسی نیک آدمی کی تعریف کی جائے تو یہ اس کے لیے بشارت ہے اور اس کے لیے نقصان دہ نہیں ہےChapter: If A Righteous Man Is Praised, It Is Glad Tidings For Him And Will Not Harm Him"
"6722","َدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، عَنْ وَكِيعٍ ح وحَدَّثَنَا مُحَمَّدُ بْنُ بَشَّارٍ ، حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنِي عَبْدُ الصَّمَدِ . ح وحَدَّثَنَا إِسْحَاقُ ، أَخْبَرَنَا النَّضْرُ كُلُّهُمْ، عَنْ شُعْبَةَ ، عَنْ أَبِي عِمْرَانَ الْجَوْنِيِّ ، بِإِسْنَادِ حَمَّادِ بْنِ زَيْدٍ بِمِثْلِ حَدِيثِهِ، غَيْرَ أَنَّ فِي حَدِيثِهِمْ، عَنْ شُعْبَةَ غَيْرَ عَبْدِ الصَّمَد، وَيُحِبُّهُ النَّاسُ عَلَيْهِ، وَفِي حَدِيثِ عَبْدِ الصَّمَدِ: وَيَحْمَدُهُ النَّاسُ، كَمَا قَالَ حَمَّادٌ.nصحیح مسلم حدیث: 6722 عربی حدیث: 2642",": Sahih","Sahih Muslim 6722","","","51. باب: نیک آدمی کی تعریف دنیا میں اس کو خوشی ہے۔جب کسی نیک آدمی کی تعریف کی جائے تو یہ اس کے لیے بشارت ہے اور اس کے لیے نقصان دہ نہیں ہےChapter: If A Righteous Man Is Praised, It Is Glad Tidings For Him And Will Not Harm Him"
