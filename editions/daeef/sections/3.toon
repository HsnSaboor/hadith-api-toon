hadiths[300]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"309","الإسلام نظيف، فتنظفوا فإنه لا يدخل الجنة إلانظيف","","Majmu'a Da'eef Ahadith 309","","","Chapter"
"310","ان من كرامة المؤمن على الله عزوجل نقاء ثوبه","","Majmu'a Da'eef Ahadith 310","","","Chapter"
"311","بنى الاسلام على النظافة","","Majmu'a Da'eef Ahadith 311","","","Chapter"
"312","لابأس ببول الحمار وما اكل لحمه","","Majmu'a Da'eef Ahadith 312","","","Chapter"
"313","زكاة الارض يبسها","","Majmu'a Da'eef Ahadith 313","","","Chapter"
"314","ماء ان لا يجزيان عن غسل الجنابة؛ ماء البحر وماء الحمام","","Majmu'a Da'eef Ahadith 314","","","Chapter"
"315","اذابلغ الماء أربعين قلة لم يحمل الخبث","","Majmu'a Da'eef Ahadith 315","","","Chapter"
"316","لا تنجس الأرض من بول إلابعد أربعين يوما","","Majmu'a Da'eef Ahadith 316","","","Chapter"
"317","احفروا مكانه ثم صبوا عليه","","Majmu'a Da'eef Ahadith 317","","","Chapter"
"318","انما حرمت دخول الحمام بغير مئزر","","Majmu'a Da'eef Ahadith 318","","","Chapter"
"319","اذا ولغ السنور فى الإناء غسل سبع مرات","","Majmu'a Da'eef Ahadith 319","","","Chapter"
"320","لا تبل قائما","","Majmu'a Da'eef Ahadith 320","","","Chapter"
"321","اذا لم يجد أحدكم ماء ووجد النبيذ فليتوضأ به","","Majmu'a Da'eef Ahadith 321","","","Chapter"
"322","لا تتوضؤوا فى الكنيف الذى تبولون فيه فإن وضوء المؤمن يوزن معه حسناته","","Majmu'a Da'eef Ahadith 322","","","Chapter"
"323","من صافح يهوديا و نصرانيا فليتوضا و ليغسل يده","","Majmu'a Da'eef Ahadith 323","","","Chapter"
"324","الوضوء على الوضوء نور على نور","","Majmu'a Da'eef Ahadith 324","","","Chapter"
"325","من توضأ على كل طهر كتب الله له عشرحسنات","","Majmu'a Da'eef Ahadith 325","","","Chapter"
"326","من قدم لأخيه إبريقا يتوضأ به فكأنما قدم جوادا","","Majmu'a Da'eef Ahadith 326","","","Chapter"
"327","الوضوء مفتاح الصلاة","","Majmu'a Da'eef Ahadith 327","","","Chapter"
"328","السواك يزيد الرجل فصاحة","","Majmu'a Da'eef Ahadith 328","","","Chapter"
"329","صلاة بسواك افضل من سبعين صلاة بغير سواك","","Majmu'a Da'eef Ahadith 329","","","Chapter"
"330","من سمي فى وضوئه لم يزل ملكان يكتبان له الحسنات حتي يحدث من ذالك الوضوء","","Majmu'a Da'eef Ahadith 330","","","Chapter"
"331","خللوا اصابعكم لا تتخللها النار يوم القيامة","","Majmu'a Da'eef Ahadith 331","","","Chapter"
"332","ان النبى صلى الله عليه وسلم كان اذا توضا حرك خاتمه","","Majmu'a Da'eef Ahadith 332","","","Chapter"
"333","المضمضة والاستنشاق سنة","","Majmu'a Da'eef Ahadith 333","","","Chapter"
"334","من نسي مسح الراس وذكر وهو يصلي ووجد فى لحيته بللا فلياخذ منه ويمسح راسه فان ذالك يجزيه فان لم يجد فيها بللا فليعد الصلاة والوضوء","","Majmu'a Da'eef Ahadith 334","","","Chapter"
"335","ومسح رقبته","","Majmu'a Da'eef Ahadith 335","","","Chapter"
"336","مسح الرقبة امان من الغل","","Majmu'a Da'eef Ahadith 336","","","Chapter"
"337","فلما ان غسل يديه قال بسم الله والحمد لله .. . فلما ان غسل وجهه قال اللهم بيض وجهي","","Majmu'a Da'eef Ahadith 337","","","Chapter"
"338","الوضوء من البول مرة ومن الغائط مرتين ومن الجنابة ثلاثا ثلاثا","","Majmu'a Da'eef Ahadith 338","","","Chapter"
"339","لان اقطع رجلي احب الي من ان امسح على الخفين","","Majmu'a Da'eef Ahadith 339","","","Chapter"
"340","يمسح على ظهور الخف خطوطا بالأصابع","","Majmu'a Da'eef Ahadith 340","","","Chapter"
"341","امسح على الخفين قال نعم قال يوما و يومين حتي بلغ سبعا قال له ما بدالك","","Majmu'a Da'eef Ahadith 341","","","Chapter"
"342","كان يمسح على الجبائر","","Majmu'a Da'eef Ahadith 342","","","Chapter"
"343","اذا توضات فانتضح","","Majmu'a Da'eef Ahadith 343","","","Chapter"
"344","فاحسن الوضوء ثم رفع بصره الي السماء","","Majmu'a Da'eef Ahadith 344","","","Chapter"
"345","كان لرسول الله صلى الله عليه وسلم خرقة ينشف بها بعد الوضوء","","Majmu'a Da'eef Ahadith 345","","","Chapter"
"346","من اصابه قيء او رعاف او قلس او مذي فلينصرف فليتوضا","","Majmu'a Da'eef Ahadith 346","","","Chapter"
"347","ان النبى صلى الله عليه وسلم قاء فلم يتوضا","","Majmu'a Da'eef Ahadith 347","","","Chapter"
"348","من مس صنما فليتوضا","","Majmu'a Da'eef Ahadith 348","","","Chapter"
"349","فامر من ضحك ان يعيد الوضوء والصلاة","","Majmu'a Da'eef Ahadith 349","","","Chapter"
"350","اذا قهقه الرجل اعاد الوضوء والصلاة","","Majmu'a Da'eef Ahadith 350","","","Chapter"
"351","بينما رجل يصلي مسبلا ازاره از قال له رسول الله صلى الله عليه وسلم اذهب فتوضا","","Majmu'a Da'eef Ahadith 351","","","Chapter"
"352","الوضوء مما يخرج وليس مما يدخل","","Majmu'a Da'eef Ahadith 352","","","Chapter"
"353","الوضوء من كل دم سائل","","Majmu'a Da'eef Ahadith 353","","","Chapter"
"354","ان للوضوء شيطانا يقال له ولهان فاتقو وسواس الماء","","Majmu'a Da'eef Ahadith 354","","","Chapter"
"355","التيمم ضربتان : ضربة للوجه وضربة لليدين الي المرفقين","","Majmu'a Da'eef Ahadith 355","","","Chapter"
"356","من السنة ان لا يصلي الرجل بالتيمم الا صلاة واحدة ثم يتيمم للصلاة الاخري","","Majmu'a Da'eef Ahadith 356","","","Chapter"
"357","لا يوم المتيمم المتوضئين","","Majmu'a Da'eef Ahadith 357","","","Chapter"
"358","من اغتسل من الجنابة حلالا اعطاه الله مائة قصر من درة بيضاء","","Majmu'a Da'eef Ahadith 358","","","Chapter"
"359","لا تغتسلوا بالماء الذى يسخن فى الشمس فانه يعدى من البرص","","Majmu'a Da'eef Ahadith 359","","","Chapter"
"360","من غسل ميتا فستر عليه و ادي الامانة غفر الله له اربعين كبيرة","","Majmu'a Da'eef Ahadith 360","","","Chapter"
"361","من ترك موضع شعرة من جنابة لم يغسلها فعل به كذا وكذا فى النار","","Majmu'a Da'eef Ahadith 361","","","Chapter"
"362","تحت كل شعرة جنابة فاغسلو الشعر وانقو البشر","","Majmu'a Da'eef Ahadith 362","","","Chapter"
"363","كان يغتسل يوم الجمعة و يوم الفطر و يوم النحر و يوم عرفة","","Majmu'a Da'eef Ahadith 363","","","Chapter"
"364","كان يغتسل من اربع؛ من الجنابة و يوم الجمعة و من الحجامة و غسل الميت","","Majmu'a Da'eef Ahadith 364","","","Chapter"
"365","اغتسل فى كل جمعة ولو ان تشترى الماء بقوت يومك","","Majmu'a Da'eef Ahadith 365","","","Chapter"
"366","من توضا بعد الغسل فليس منا","","Majmu'a Da'eef Ahadith 366","","","Chapter"
"367","لا تقرا الحائض ولا الجنب شيئا من القرآن","","Majmu'a Da'eef Ahadith 367","","","Chapter"
"368","انه لم يكن يحجزه عن القرآن شىء سوى الجنابة","","Majmu'a Da'eef Ahadith 368","","","Chapter"
"369","اقل الحيض ثلاث اكثره عشر","","Majmu'a Da'eef Ahadith 369","","","Chapter"
"370","وقت للنفساء اربعين يوما الا ان تري الطهر قبل ذالك","","Majmu'a Da'eef Ahadith 370","","","Chapter"
"371","اذا اخذ المؤذن فى اذانه وضع الرب يده فوق راسه فلا يزال كذالك حتي يفرغ من اذانه","","Majmu'a Da'eef Ahadith 371","","","Chapter"
"372","لا يوذن الا متوضي","","Majmu'a Da'eef Ahadith 372","","","Chapter"
"373","لا يوذن غلام حتي يحتلم","","Majmu'a Da'eef Ahadith 373","","","Chapter"
"374","لا يوذن لكم الا فصيح","","Majmu'a Da'eef Ahadith 374","","","Chapter"
"375","مسح العينين بباطن انملتي السبابتين بعد تقبيلهما عند قول المؤذن اشهد ان محمد ا رسول الله وان من فعل ذالك حلت له شفاعته","","Majmu'a Da'eef Ahadith 375","","","Chapter"
"376","ما من مدينة بكثر اذانها الا قل بردها","","Majmu'a Da'eef Ahadith 376","","","Chapter"
"377","موذن اهل السموات جبريل و امامهم ميكائيل","","Majmu'a Da'eef Ahadith 377","","","Chapter"
"378","كان اذان رسول الله صلى الله عليه وسلم شفعا شفعا فى الاذان والاقامة","","Majmu'a Da'eef Ahadith 378","","","Chapter"
"379","من اذن فليقم","","Majmu'a Da'eef Ahadith 379","","","Chapter"
"380","المؤذن املك بالاذان و الامام املك بالاقامة","","Majmu'a Da'eef Ahadith 380","","","Chapter"
"381","من افرد الاقامة فليس منا","","Majmu'a Da'eef Ahadith 381","","","Chapter"
"382","ان بلالا اخذ فى الاقامة فلما بلغ قد قامت الصلاة قال النبى صلى الله عليه وسلم اقامها الله وادامها","","Majmu'a Da'eef Ahadith 382","","","Chapter"
"383","بين كل اذانين صلاة الا المغرب","","Majmu'a Da'eef Ahadith 383","","","Chapter"
"384","اجعل بين اذانك و اقامتك قدر ما يفرغ الاكل من اكله و الشارب من شربه","","Majmu'a Da'eef Ahadith 384","","","Chapter"
"385","من ولد له مولود فاذن فى اذنه اليمني واقام فى اذنه اليسري لم تضره ام الصبيان","","Majmu'a Da'eef Ahadith 385","","","Chapter"
"386","لا سهم فى الاسلام لمن لا صلاة له","","Majmu'a Da'eef Ahadith 386","","","Chapter"
"387","ان اول ما افترض الله على الناس من دينهم الصلاة","","Majmu'a Da'eef Ahadith 387","","","Chapter"
"388","ثلاث من حفظهن فهو ولي حقا و من ضيعهن فهو عدو حقا الصلاة والصيام والجنابة","","Majmu'a Da'eef Ahadith 388","","","Chapter"
"389","اني نهيت عن قتل المصلين","","Majmu'a Da'eef Ahadith 389","","","Chapter"
"390","من صلى العشاء فى جماعة فقد اخذ بحظه من ليلة القدر","","Majmu'a Da'eef Ahadith 390","","","Chapter"
"391","لا توخر الصلاة لطعام ولا لغيره","","Majmu'a Da'eef Ahadith 391","","","Chapter"
"392","الوقت الاول من الصلاة رضوان الله والآخر عفو الله","","Majmu'a Da'eef Ahadith 392","","","Chapter"
"393","من نور بالفجر نور الله له قلبه و قبره و قبلت صلاته","","Majmu'a Da'eef Ahadith 393","","","Chapter"
"394","اسفرو بالفجر يغفر لكم","","Majmu'a Da'eef Ahadith 394","","","Chapter"
"395","يصلي الفجر حين يتغشى النور السماء","","Majmu'a Da'eef Ahadith 395","","","Chapter"
"396","فكان يؤخر العصر ما دامت الشمس بيضاء نقية","","Majmu'a Da'eef Ahadith 396","","","Chapter"
"397","من تكلم بكلام الدنيا فى المسجد احبط الله اعماله","","Majmu'a Da'eef Ahadith 397","","","Chapter"
"398","ما من ليلة الا ينادى مناد يا اهل القبور من تغبطون؟ فيقولون : اهل المساجد","","Majmu'a Da'eef Ahadith 398","","","Chapter"
"399","جنبوا مساجد كم صبيانكم","","Majmu'a Da'eef Ahadith 399","","","Chapter"
"400","رهبانية امتي القعود فى المساجد","","Majmu'a Da'eef Ahadith 400","","","Chapter"
"401","من اسرج فى مسجد سراجا لم تزل الملائكة وحملة العرش يستغفرون له ما دام فى ذالك المسجد ضوء من ذالك السراج","","Majmu'a Da'eef Ahadith 401","","","Chapter"
"402","تعاهدوا هذه المساجد بالتجصيص والقناديل والسرج والريح الطيبه","","Majmu'a Da'eef Ahadith 402","","","Chapter"
"403","تذهب الارضون يوم القيامة كلها الا المساجد فانه ينضم بعضها الي بعض","","Majmu'a Da'eef Ahadith 403","","","Chapter"
"404","من كسح بيتا من بيوت الله فكانما حج اربعمائة حجة","","Majmu'a Da'eef Ahadith 404","","","Chapter"
"405","كنس المساجد مهور الحور العين","","Majmu'a Da'eef Ahadith 405","","","Chapter"
"406","عرضت على اجور امتي حتي القذاة يخرجها الرجل من المسجد","","Majmu'a Da'eef Ahadith 406","","","Chapter"
"407","اذا وجد احدكم القملة فى المسجد فليدفنها","","Majmu'a Da'eef Ahadith 407","","","Chapter"
"408","فان لم يكن معه عصا فليخط خطا","","Majmu'a Da'eef Ahadith 408","","","Chapter"
"409","لا يقطع الصلاة شيئ و ادرؤواما استطعتم","","Majmu'a Da'eef Ahadith 409","","","Chapter"
"410","ان الذى يمر بين يدي الرجل وهو يصلي عمدا يتمني يوم القيامة انه شجرة يابسة","","Majmu'a Da'eef Ahadith 410","","","Chapter"
"411","راي رجلا يصلي الي رجل فامره ان يعيد الصلاة","","Majmu'a Da'eef Ahadith 411","","","Chapter"
"412","الا لا يصلين احد الي احد ولا الي قبر","","Majmu'a Da'eef Ahadith 412","","","Chapter"
"413","قال ابوبكر : ان آخر صلاة صلاها رسول الله صلى الله عليه وسلم خلفي فى ثوب واحد","","Majmu'a Da'eef Ahadith 413","","","Chapter"
"414","الصلاة فى الثوب الواحد سنة","","Majmu'a Da'eef Ahadith 414","","","Chapter"
"415","رايت النبى صلى الله عليه وسلم وعائشة يصليان فى ثوب واحد؛ نصفه على النبى صلى الله عليه وسلم ونصفه على عائشة","","Majmu'a Da'eef Ahadith 415","","","Chapter"
"416","نهي صلى الله عليه وسلم عن الصلاة فى السراويل","","Majmu'a Da'eef Ahadith 416","","","Chapter"
"417","اذا صليتم فارفعو سبلكم فكل شيئ اصاب الارض من سبلكم ففي النار","","Majmu'a Da'eef Ahadith 417","","","Chapter"
"418","اذا قمتم الي الصلاة فانتعلوا","","Majmu'a Da'eef Ahadith 418","","","Chapter"
"419","من تمام الصلاة الصلاة فى النعلين","","Majmu'a Da'eef Ahadith 419","","","Chapter"
"420","اتاني جبرايل فقرا بسم الله الرحمان الرحيم فجهربها","","Majmu'a Da'eef Ahadith 420","","","Chapter"
"421","كان يرفع يديه فى ابتداء الصلاة ثم لا يعود","","Majmu'a Da'eef Ahadith 421","","","Chapter"
"422","كان رسول الله صلى الله عليه وسلم يرفع يديه كلما ركع وكلما رفع ثم صار الي افتتاح الصلاة وترك ما سوي ذالك","","Majmu'a Da'eef Ahadith 422","","","Chapter"
"423","من رفع يديه فى الصلاة فلا صلاة له","","Majmu'a Da'eef Ahadith 423","","","Chapter"
"424","من السنة وضع الكف على الكف فى الصلاة تحت السرة","","Majmu'a Da'eef Ahadith 424","","","Chapter"
"425","من كان له امام فقراءة الامام له قراءة","","Majmu'a Da'eef Ahadith 425","","","Chapter"
"426","يكفيك قراءة الامام خافت او جهر","","Majmu'a Da'eef Ahadith 426","","","Chapter"
"427","لا قراءة خلف الامام","","Majmu'a Da'eef Ahadith 427","","","Chapter"
"428","من قرا خلف الامام فلا صلاة له","","Majmu'a Da'eef Ahadith 428","","","Chapter"
"429","حفظت سكتتين فى الصلاة سكتة اذا كبر الامام حتي يقرا وسكتة اذا فرغ من فاتحة الكتاب وسورة عند الركوع","","Majmu'a Da'eef Ahadith 429","","","Chapter"
"430","للامام سكتتان فاغتنمو فيهما بفاتحة الكتاب","","Majmu'a Da'eef Ahadith 430","","","Chapter"
"431","ان النبى صلى الله عليه وسلم قرا غير المغضوب عليهم ولاالضالين فقال آمين وخفض بها صوته","","Majmu'a Da'eef Ahadith 431","","","Chapter"
"432","رايت النبى صلى الله عليه وسلم اذا سجد وضع ركبتيه قبل يديه","","Majmu'a Da'eef Ahadith 432","","","Chapter"
"433","اذا ركع احدكم فليقل فى ركوعه سبحان ربي العظيم ثلاثا . . . واذا سجد احدكم فليقل فى سجوده سبحان ربي الاعلي ثلاثا","","Majmu'a Da'eef Ahadith 433","","","Chapter"
"434","السجود على الجبهة فريضة وعلي الانف تطوع","","Majmu'a Da'eef Ahadith 434","","","Chapter"
"435","اذا جلست المراة فى الصلاة وضعت فخذها على فخذها الاخر و اذا سجدت الصقت بطنها فى فخذيها","","Majmu'a Da'eef Ahadith 435","","","Chapter"
"436","كان النبى صلى الله عليه وسلم ينهض فى الصلاة على صدور قدميه","","Majmu'a Da'eef Ahadith 436","","","Chapter"
"437","لا صلاة لمن لم يصل على النبى صلى الله عليه وسلم","","Majmu'a Da'eef Ahadith 437","","","Chapter"
"438","اذا قضي الامام الصلاة وقعد فاحدث قبل ان يتكلم فقد تمت صلاته","","Majmu'a Da'eef Ahadith 438","","","Chapter"
"439","من صلى الصبح ثم قرا قل هو الله احد مائة مرة قبل ان يتكلم فكلما قرا قل هو الله احد غفر له ذنب سنة","","Majmu'a Da'eef Ahadith 439","","","Chapter"
"440","من جمع بين صلاتين من غير عذر فقد اتي بابا من ابواب الكبائر","","Majmu'a Da'eef Ahadith 440","","","Chapter"
"441","ان الله لا يقبل صلاة مسبل ازاره","","Majmu'a Da'eef Ahadith 441","","","Chapter"
"442","لا صلاة لملتفت","","Majmu'a Da'eef Ahadith 442","","","Chapter"
"443","من قام فى الصلاة فالتفت رد الله عليه صلاته","","Majmu'a Da'eef Ahadith 443","","","Chapter"
"444","الاختصار فى الصلاة راحة اهل النار","","Majmu'a Da'eef Ahadith 444","","","Chapter"
"445","يمس لحيته فى الصلاة","","Majmu'a Da'eef Ahadith 445","","","Chapter"
"446","نهي عن النفخ فى السجود","","Majmu'a Da'eef Ahadith 446","","","Chapter"
"447","لان يمسك احدكم يده عن الحصي خير له من مائة ناقة","","Majmu'a Da'eef Ahadith 447","","","Chapter"
"448","كان يمسح العرق عن وجهه فى الصلاة","","Majmu'a Da'eef Ahadith 448","","","Chapter"
"449","العطاس والنعاس والتثاوب فى الصلاة من الشيطان","","Majmu'a Da'eef Ahadith 449","","","Chapter"
"450","كان يكره التثاوب فى الصلاة","","Majmu'a Da'eef Ahadith 450","","","Chapter"
"451","يوم القوم احسنهم وجها","","Majmu'a Da'eef Ahadith 451","","","Chapter"
"452","ان سركم ان تقبل صلاتكم فليومكم خياركم","","Majmu'a Da'eef Ahadith 452","","","Chapter"
"453","من صلى خلف عالم تقي فكانما صلى خلف نبى","","Majmu'a Da'eef Ahadith 453","","","Chapter"
"454","صلو خلف كل برو فاجر","","Majmu'a Da'eef Ahadith 454","","","Chapter"
"455","من ام قوما ثم ظهر انه كان محدثا او جنبا اعاد صلاته و اعادوا","","Majmu'a Da'eef Ahadith 455","","","Chapter"
"456","لا يومن احد بعدي جالسا","","Majmu'a Da'eef Ahadith 456","","","Chapter"
"457","وسطوا الامام","","Majmu'a Da'eef Ahadith 457","","","Chapter"
"458","من صلى الفجر فى جماعة فكانما حج خمسين حجة مع آدم","","Majmu'a Da'eef Ahadith 458","","","Chapter"
"459","من لم تفته ركعة من صلاة الغداة اربعين ليلة لم يمت حتي يرى مقعده من الجنة","","Majmu'a Da'eef Ahadith 459","","","Chapter"
"460","ما زال رسول الله صلى الله عليه وسلم يقنت فى صلاة الغداة حتي فارق الدنيا","","Majmu'a Da'eef Ahadith 460","","","Chapter"
"461","ان المومن اذا صلى الفريضة فى جماعة تناثرت عنه الذنوب كما تتناثر هذه الورق","","Majmu'a Da'eef Ahadith 461","","","Chapter"
"462","الاثنان فما فوقهما جماعة","","Majmu'a Da'eef Ahadith 462","","","Chapter"
"463","اذا اقيمت الصلاة فلا صلاة الا المكتوبة الا ركعتي الصبح","","Majmu'a Da'eef Ahadith 463","","","Chapter"
"464","لا تسبقوا امامكم بالركوع فانكم تدركون بما سبقكم","","Majmu'a Da'eef Ahadith 464","","","Chapter"
"465","حضرت الصلاة صلاة المكتوبة ونحن مع رسول الله صلى الله عليه وسلم على ركابنا فتقدم بنا ثم امنا فصلينا على ركابنا","","Majmu'a Da'eef Ahadith 465","","","Chapter"
"466","يا على ! لا تفتح على الامام فى الصلاة","","Majmu'a Da'eef Ahadith 466","","","Chapter"
"467","المراة وحدها صف","","Majmu'a Da'eef Ahadith 467","","","Chapter"
"468","كان لا يدع ركعتي الفجر فى السفر ولا فى الحضر","","Majmu'a Da'eef Ahadith 468","","","Chapter"
"469","من صلى قبل الظهر اربعا غفر له ذنوبه يومه ذالك","","Majmu'a Da'eef Ahadith 469","","","Chapter"
"470","من لم يداوم على اربع قبل الظهر لم تنله شفاعتي","","Majmu'a Da'eef Ahadith 470","","","Chapter"
"471","من صلى اربع ركعات قبل العصر حرم الله بدنه على النار","","Majmu'a Da'eef Ahadith 471","","","Chapter"
"472","من صلى بعد المغرب ست ركعات لم يتكلم بينهن بسوء عدلن له بعبادة ثنتي عشرة سنة","","Majmu'a Da'eef Ahadith 472","","","Chapter"
"473","من صلى بين المغرب والعشاء عشرين ركعة بني الله له بيتا فى الجنة","","Majmu'a Da'eef Ahadith 473","","","Chapter"
"474","كان صلى الله عليه وسلم يصلي بعد المغرب ركعتين يطيل فيهما القراءة حتي يتصدع اهل المسجد","","Majmu'a Da'eef Ahadith 474","","","Chapter"
"475","قال على كان لي من رسول الله صلى الله عليه وسلم مدخلان ، مدخل بالليل و مدخل بالنهار فكنت اذا دخلت بالليل تنحنح لي","","Majmu'a Da'eef Ahadith 475","","","Chapter"
"476","شرف المومن قيامه بالليل","","Majmu'a Da'eef Ahadith 476","","","Chapter"
"477","ركعتان فى جوف الليل يكفران الخطايا","","Majmu'a Da'eef Ahadith 477","","","Chapter"
"478","ركعتان يركعهما ابن آدم فى جوف الليل الاخر خير له من الدنيا وما فيها ولو لا ان اشق على امتي لفرضتهما عليهم","","Majmu'a Da'eef Ahadith 478","","","Chapter"
"479","لا تدعن صلاة الليل ولو حلب شاة","","Majmu'a Da'eef Ahadith 479","","","Chapter"
"480","يا اهل القرآن لا توسدوا القرآن واتلوه حق تلاوته فى آناء الليل و النهار","","Majmu'a Da'eef Ahadith 480","","","Chapter"
"481","من كثرت صلاته بالليل حسن وجهه بالنهار","","Majmu'a Da'eef Ahadith 481","","","Chapter"
"482","اذا نام احدكم وفي نفسه ان يصلي من الليل فليضع قبضة من تراب","","Majmu'a Da'eef Ahadith 482","","","Chapter"
"483","ان الله زادكم صلاة الي صلاتكم وهو الوتر","","Majmu'a Da'eef Ahadith 483","","","Chapter"
"484","من لم يوتر فليس منا","","Majmu'a Da'eef Ahadith 484","","","Chapter"
"485","من لم يوتر فلا صلاة له","","Majmu'a Da'eef Ahadith 485","","","Chapter"
"486","الوتر على اهل القرآن","","Majmu'a Da'eef Ahadith 486","","","Chapter"
"487","الوتر واجب على كل مسلم","","Majmu'a Da'eef Ahadith 487","","","Chapter"
"488","الوتر ثلاث ركعات كصلاة المغرب","","Majmu'a Da'eef Ahadith 488","","","Chapter"
"489","من فاته الوتر من الليل فليقضه من الغد","","Majmu'a Da'eef Ahadith 489","","","Chapter"
"490","كان النبى صلى الله عليه وسلم يصلي فى رمضان عشرين ركعة","","Majmu'a Da'eef Ahadith 490","","","Chapter"
"491","كان الناس فى زمن عمر يقومون فى رمضان بثلاث وعشرين ركعة","","Majmu'a Da'eef Ahadith 491","","","Chapter"
"492","امر رجلا ان يصلي بالناس . . . عشرين ركعة","","Majmu'a Da'eef Ahadith 492","","","Chapter"
"493","كان ابي يصلي بالناس فى رمضان بالمدينه عشرين ركعة","","Majmu'a Da'eef Ahadith 493","","","Chapter"
"494","ان فى الجنة بابا يقال له ضحي فمن صلى صلاة الضحي حنث اليه صلاة الضحي كما يحن الفصيل الي امه حتي انها لتستقبله حتي يدخل الجنة","","Majmu'a Da'eef Ahadith 494","","","Chapter"
"495","ان فى الجنة بابا يقال له ضحي لا يدخل منه الا من حافظ على صلاة الضحيٰ","","Majmu'a Da'eef Ahadith 495","","","Chapter"
"496","من داوم على صلاة الضحي ولم يقطعها الا من علة كنت انا وهو فى الجنة فى زورق من نور فى بحر من نور حتي نزور رب العالمين","","Majmu'a Da'eef Ahadith 496","","","Chapter"
"497","المنافق لا يصلي الضحي","","Majmu'a Da'eef Ahadith 497","","","Chapter"
"498","صلوا ركعتي الضحي بسورتيها : والشمس وضحاها والضحي","","Majmu'a Da'eef Ahadith 498","","","Chapter"
"499","من صلى ركعتي الضحي كتب الله له الف الف حسنة","","Majmu'a Da'eef Ahadith 499","","","Chapter"
"500","لا يترك الضحي فى السفر ولا غيره","","Majmu'a Da'eef Ahadith 500","","","Chapter"
"501","يصلي الضحي حتي نقول لا يدعها و يدعها حتي نقول لا يصليها","","Majmu'a Da'eef Ahadith 501","","","Chapter"
"502","من كان له حاجة الي الله او الي احد من بني آدم فليتوضا وليحسن الوضوء ثم ليصل ركعتين ثم ليثنين على الله وليصل على النبى صلى الله عليه وسلم ثم ليقل لا اله الا لله الحليم . . . الا قضيتها يا ارحم الراحمين","","Majmu'a Da'eef Ahadith 502","","","Chapter"
"503","يا رسول الله كيف ينبغي للمذنب ان يتوب من الذنوب قال يغتسل ليلة الاثنين بعد الوتر ويصلي ثنتي عشرة ركعة","","Majmu'a Da'eef Ahadith 503","","","Chapter"
"504","من احيا ليلة عاشوراء فكانما عبدالله بمثل عبادة اهل السمٰوات","","Majmu'a Da'eef Ahadith 504","","","Chapter"
"505","ما من احد يصوم يوم الخمسين اول خمسين من رجب ثم يصلي ليلة الجمعة ثنتي عشرة ركعة","","Majmu'a Da'eef Ahadith 505","","","Chapter"
"506","من صلى المغرب اول ليلة من رجب ثم صلى بعدها عشرين ركعة","","Majmu'a Da'eef Ahadith 506","","","Chapter"
"507","من صلى ليلة النصف من رجب اربع عشرة ركعة . . . بعث الله اليه الف ملك","","Majmu'a Da'eef Ahadith 507","","","Chapter"
"508","من صلى مائة ركعة ليلة النصف من شعبان . . . قضي الله له كل حاجة","","Majmu'a Da'eef Ahadith 508","","","Chapter"
"509","من صلى ركعتين فى ليلة الجمعة قرا فيها بفاتحة الكتاب وخمس عشرة مرة اذا زلزلت امنه الله من عذاب القبر ومن اهوال يوم القيامة","","Majmu'a Da'eef Ahadith 509","","","Chapter"
"510","من صلى يوم الجمعة ما بين الظهر والعصر ركعتين . . . فلا يخرج من الدنيا حتي يرى ربه عزوجل فى المنام ويري مكانه فى الجنة","","Majmu'a Da'eef Ahadith 510","","","Chapter"
"511","من صلى يوم السبت عند الضحي اربع ركعات . . . طوبي لهم","","Majmu'a Da'eef Ahadith 511","","","Chapter"
"512","من صلى ليلة الاحد اربع ركعات . . .","","Majmu'a Da'eef Ahadith 512","","","Chapter"
"513","من صلى يوم الاثنين اربع ركعات . . . اعطاه الله قصرا فى الجنة","","Majmu'a Da'eef Ahadith 513","","","Chapter"
"514","افضل الايام يوم الجمعة","","Majmu'a Da'eef Ahadith 514","","","Chapter"
"515","لجمعة حج المساكين","","Majmu'a Da'eef Ahadith 515","","","Chapter"
"516","اذا سلمت الجمعة سلمت الايام","","Majmu'a Da'eef Ahadith 516","","","Chapter"
"517","فضل الجمعة فى رمضان على سائر ايامه كفضل رمضان على سائز الشهور","","Majmu'a Da'eef Ahadith 517","","","Chapter"
"518","من فاتته صلاة الجمعة فليتصدق بدينار","","Majmu'a Da'eef Ahadith 518","","","Chapter"
"519","الغسل يوم الجمعة سنة","","Majmu'a Da'eef Ahadith 519","","","Chapter"
"520","اغتسلوا يوم الجمعة ولو كاسا بدينار","","Majmu'a Da'eef Ahadith 520","","","Chapter"
"521","من قص اظفاره واخذ من شاربه كل يوم جمعة ادخل الله فيه شفاء واخرج منه داء","","Majmu'a Da'eef Ahadith 521","","","Chapter"
"522","مثل المؤمن يوم الجمعة كمثل المحرم لا ياخذ من شعره ولا من اظفاره حتي يقضي الصلاة","","Majmu'a Da'eef Ahadith 522","","","Chapter"
"523","جمعة بعمامة افضل من سبعين بلا عمامة","","Majmu'a Da'eef Ahadith 523","","","Chapter"
"524","ان لله ملائكة يوم الجمعة يستغرون لاصحاب العمائم البيض","","Majmu'a Da'eef Ahadith 524","","","Chapter"
"525","الجمعة على من آواه الليل الي اهله","","Majmu'a Da'eef Ahadith 525","","","Chapter"
"526","الجمعة على من كان بمدي الصوت","","Majmu'a Da'eef Ahadith 526","","","Chapter"
"527","مضت السنة ان فى كل اربعين فما فوقها جمعة","","Majmu'a Da'eef Ahadith 527","","","Chapter"
"528","اذا راح منا سبعون رجلا الي الجمعة كانو كسبعين لموسيٰ الذين وفدوا الى ربهم او افضل","","Majmu'a Da'eef Ahadith 528","","","Chapter"
"529","لا جمعة ولا تشريق الا فى مصر جامع","","Majmu'a Da'eef Ahadith 529","","","Chapter"
"530","لو لا المنابر لا حترق اهل القري","","Majmu'a Da'eef Ahadith 530","","","Chapter"
"531","كان اذا صعد المنبر سلم","","Majmu'a Da'eef Ahadith 531","","","Chapter"
"532","اذا صعد الخطيب المنبر فلا صلاة ولا كلام","","Majmu'a Da'eef Ahadith 532","","","Chapter"
"533","كان النبى صلى الله عليه وسلم يركع قبل الجمعة اربعا لا يفصل فى شيء منهن","","Majmu'a Da'eef Ahadith 533","","","Chapter"
"534","من تكلم يوم الجمعة والامام يخطب فهو كالحمار يحمل اسفارا والذي يقول له انصت ليس له جمعة","","Majmu'a Da'eef Ahadith 534","","","Chapter"
"535","الذى يتخطي رقاب الناس ويفرق بين الاثنين بعد خروج الامام كالجار قصبه فى النار","","Majmu'a Da'eef Ahadith 535","","","Chapter"
"536","تضاعف الحسنات يوم الجمعة","","Majmu'a Da'eef Ahadith 536","","","Chapter"
"537","من قال قبل صلاة الغداة يوم الجمعة استغفر الله الذى لا اله الا هو الحي القيوم واتوب اليه ثلاث مرات غفر له ذنوبه ان كانت مثل زبد البحر","","Majmu'a Da'eef Ahadith 537","","","Chapter"
"538","من قراحم الدخان فى ليلة الجمعة غفر له","","Majmu'a Da'eef Ahadith 538","","","Chapter"
"539","من قراحم الدخان فى ليلة الجمعة او يوم الجمعة بنى الله له بيتا فى الجنة","","Majmu'a Da'eef Ahadith 539","","","Chapter"
"540","من قام ليلتي العيد محتسبا لله تعالي لم يمت قلبه يوم تموت القلوب","","Majmu'a Da'eef Ahadith 540","","","Chapter"
"541","من صلى ليلة الفطر مائة ركعة . . .","","Majmu'a Da'eef Ahadith 541","","","Chapter"
"542","كنا ناكل ونشرب و نغتسل ثم نخرج الي المصلي","","Majmu'a Da'eef Ahadith 542","","","Chapter"
"543","ان النبى صلى الله عليه وسلم كان يلبس البرد الاحمر فى العيدين وفي الجمعة","","Majmu'a Da'eef Ahadith 543","","","Chapter"
"544","زينوا اعيادكم بالتكبير","","Majmu'a Da'eef Ahadith 544","","","Chapter"
"545","زينوا العيدين بالتهليل والتقديس والتحميد و التكبير","","Majmu'a Da'eef Ahadith 545","","","Chapter"
"546","انه كان يكبر حتي يسمع اهل الطريق","","Majmu'a Da'eef Ahadith 546","","","Chapter"
"547","كان يكبر فى العيدين اربعا تكبيره على الجنائز","","Majmu'a Da'eef Ahadith 547","","","Chapter"
"548","صلى العيد ركعتين لا يقرا فيهما الا بام الكتاب","","Majmu'a Da'eef Ahadith 548","","","Chapter"
"549","كان يقرا فى صلاة العيدين ب عم يتسائلون والشمس وضهاها","","Majmu'a Da'eef Ahadith 549","","","Chapter"
"550","نهي ان يلبس السلاح فى بلاد الاسلام فى العيدين الا ان يكونوا بحضرة العدو","","Majmu'a Da'eef Ahadith 550","","","Chapter"
"551","رايت رسول الله صلى الله عليه وسلم يوما العيدين يديه بالحراب","","Majmu'a Da'eef Ahadith 551","","","Chapter"
"552","انهم اصابهم مطر فى يوم عيد فصلي بهم النبى صلى الله عليه وسلم صلاة العيد فى المسجد","","Majmu'a Da'eef Ahadith 552","","","Chapter"
"553","خير امتي الذى . . . اذا سافروا قصروا","","Majmu'a Da'eef Ahadith 553","","","Chapter"
"554","يا اهل مكة الا تقصروا فى اقل من اربع برد من مكة الي عسفان","","Majmu'a Da'eef Ahadith 554","","","Chapter"
"555","كان يقصر فى السفر و يتم","","Majmu'a Da'eef Ahadith 555","","","Chapter"
"556","قالت عائشة : خرجت معي النبى صلى الله عليه وسلم فى عمرة فى رمضان ف . . . قصر و اتممت فقلت . . . قصرت واتممت ، قال احسنت يا عائشة !","","Majmu'a Da'eef Ahadith 556","","","Chapter"
"557","المتم للصلاة فى السفر كالقصر فى الحضر","","Majmu'a Da'eef Ahadith 557","","","Chapter"
"558","من صلى فى السفر اربع ركعات كمن صلى فى الحضر ركعتين","","Majmu'a Da'eef Ahadith 558","","","Chapter"
"559","من صلى فى السفر اربعا اعاد الصلاة","","Majmu'a Da'eef Ahadith 559","","","Chapter"
"560","لا تقصر الصلاة الا فى حج او جهاد","","Majmu'a Da'eef Ahadith 560","","","Chapter"
"561","من نسي صلاة فوقتها اذا ذكرها","","Majmu'a Da'eef Ahadith 561","","","Chapter"
"562","سئل عن رجل سها فى صلاته فلم يدركم صلى قال ليعد صلاته و ليسجد سجدتين","","Majmu'a Da'eef Ahadith 562","","","Chapter"
"563","ليس فى صلاة الخوف سهو","","Majmu'a Da'eef Ahadith 563","","","Chapter"
"564","ليس على من خلف الامام سهو فان سها الامام فعليه وعلي من خلفه السهو","","Majmu'a Da'eef Ahadith 564","","","Chapter"
"565","اذا خلع احدكم نعليه فى الصلاة فلا يجعلهما بين يديه فياتم بهما ولا من خلفه فياتم بهما اخوه المسلم ولكن يجعلهما بين رجليه","","Majmu'a Da'eef Ahadith 565","","","Chapter"
"566","فى كل ركعة ركوع","","Majmu'a Da'eef Ahadith 566","","","Chapter"
"567","فضلت سورة الحج بان فيها سجدتين؟ قال نعم ومن لم يسجدهما فلا يقراهما","","Majmu'a Da'eef Ahadith 567","","","Chapter"
"568","صلاة الاسير ركعتان حتي يموت او يفك الله اسره","","Majmu'a Da'eef Ahadith 568","","","Chapter"
"569","ان النبى صلى الله عليه وسلم امره ان يصلي فى السفينة قائما الا ان يخشي الغرق","","Majmu'a Da'eef Ahadith 569","","","Chapter"
"570","ثلاثه لا يقبل الله لهم صلاة ولا ترفع لهم الي السماء حسنة : العبد الابق حتي يرجع الي مواليه والمراة الساخط عليها زوجها حتي يرضي والسكران حتي يصحو","","Majmu'a Da'eef Ahadith 570","","","Chapter"
"571","من ولي يتيما فليتجر له ولا يتركه تاكله الصدقة","","Majmu'a Da'eef Ahadith 571","","","Chapter"
"572","سالت او سئل النبى صلى الله عليه وسلم عن الزكاة فقال : ان فى المال لحقا سوي الزكاة ثم تلا هذه الآية التى فى البقرة ” ليس البر ان تولوا وجوهكم “ الآية","","Majmu'a Da'eef Ahadith 572","","","Chapter"
"573","فى الخيل السائمة فى كل فرس دينار","","Majmu'a Da'eef Ahadith 573","","","Chapter"
"574","ان الاوقاص لا فريضة فيها","","Majmu'a Da'eef Ahadith 574","","","Chapter"
"575","كان رسول الله صلى الله عليه وسلم يامرنا ان نخرج الصدقة من الذى نعده للبيع","","Majmu'a Da'eef Ahadith 575","","","Chapter"
"576","واما القثاء والبطيغ والرمان والقصب والخضروات فعفو عفا عنه رسول الله صلى الله عليه وسلم","","Majmu'a Da'eef Ahadith 576","","","Chapter"
"577","ليس فى الخضروات صدقة","","Majmu'a Da'eef Ahadith 577","","","Chapter"
"578","امر رسول الله صلى الله عليه وسلم ان يخرص العنب كما يخرص النخل و توخذ زكاته زبيبا كما تؤخذ صدقة النخل تمرا","","Majmu'a Da'eef Ahadith 578","","","Chapter"
"579","ليس فى الحلي زكاة","","Majmu'a Da'eef Ahadith 579","","","Chapter"
"580","اذا خرصتم فخذوا و دعوا الثلث فان لم تدعوا الثلث فدعوا الربع","","Majmu'a Da'eef Ahadith 580","","","Chapter"
"581","ليس فى العسل زكاة","","Majmu'a Da'eef Ahadith 581","","","Chapter"
"582","ان رسول الله صلى الله عليه وسلم اقطع بلال بن الحارث المزني معادن القبلية و هي من ناحية الفرع فتلك المعادن ” لا يؤخذ منها الا الزكاة الي اليوم “","","Majmu'a Da'eef Ahadith 582","","","Chapter"
"583","ما خالطت الصدقة مالا قط الا اهلكته","","Majmu'a Da'eef Ahadith 583","","","Chapter"
"584","ادوا الزكاة و تحروا بها اهل العلم فانه ابر و اتقي","","Majmu'a Da'eef Ahadith 584","","","Chapter"
"585","سياتيكم ركيب مبغضون ، فاذا جاء وكم فرحبوا بهم ، وخلوا بينهم و بين ما يبتغون فان عدلوا فلا نفسكم ، وان ظلموا فعليهم ، و ارضوهم فان تمام زكاتكم رضاهم وليدعوا لكم","","Majmu'a Da'eef Ahadith 585","","","Chapter"
"586","خذ الحب من الحب ، والشاة من الغنم ، والبعير من الابل ، والبقرة من البقر","","Majmu'a Da'eef Ahadith 586","","","Chapter"
"587","قلنا : ان اهل الصدقة يعتدون علينا ، افنكتم من اموالنا بقدر ما يعتدون؟ قال : لا","","Majmu'a Da'eef Ahadith 587","","","Chapter"
"588","ان الله لم يرض بحكم نبي ولا غيره فى الصدقات حتي حكم فيها هو فجزاها ثمانية اجزاء","","Majmu'a Da'eef Ahadith 588","","","Chapter"
"589","صدقة الفطر صاع من براو قمح عن كل اثنين","","Majmu'a Da'eef Ahadith 589","","","Chapter"
"590","اغنوهم عن الطواف فى هذا اليوم","","Majmu'a Da'eef Ahadith 590","","","Chapter"
"591","افضل الصدقة ان يتعلم المرء المسلم علما ثم يعلمه اخاه المسلم","","Majmu'a Da'eef Ahadith 591","","","Chapter"
"592","الا ادلكم على افضل الصدقة؟ ابنتك مردودة اليك ، ليس لها كاسب غيرك","","Majmu'a Da'eef Ahadith 592","","","Chapter"
"593","فاي الصدقة افضل؟ قال : الصدقة فى رمضان","","Majmu'a Da'eef Ahadith 593","","","Chapter"
"594","بادروا بالصدقة فان البلاء لا يتخطاها","","Majmu'a Da'eef Ahadith 594","","","Chapter"
"595","صدقة القليل تدفع البلاء الكثير","","Majmu'a Da'eef Ahadith 595","","","Chapter"
"596","السخي قريب من الله ، قريب من الجنة ، قريب من الناس ، بعيد من النار ، والبخيل بعيد من الله ، بعيد من الجنة ، بعيد من الناس ، قريب من النار ، ولجاهل سخي احب الي الله من عابد بخيل","","Majmu'a Da'eef Ahadith 596","","","Chapter"
"597","الجنه دار الاسخياء","","Majmu'a Da'eef Ahadith 597","","","Chapter"
"598","لا يدخل الجنة خب ولا بخيل ولا منان","","Majmu'a Da'eef Ahadith 598","","","Chapter"
"599","ان الصدقة تدفع ميتة السوء","","Majmu'a Da'eef Ahadith 599","","","Chapter"
"600","الفقراء مناديل الاغنياء يمسحون بها ذنوبهم","","Majmu'a Da'eef Ahadith 600","","","Chapter"
"601","من بان عذره وجبت الصدقة عليه","","Majmu'a Da'eef Ahadith 601","","","Chapter"
"602","اعطوا السائل وان جاء على فرس","","Majmu'a Da'eef Ahadith 602","","","Chapter"
"603","وان كنت لا بد ، فسل الصالحين","","Majmu'a Da'eef Ahadith 603","","","Chapter"
"604","لا يسال بوجه الله الا الجنة","","Majmu'a Da'eef Ahadith 604","","","Chapter"
"605","اذا بكى اليتيم وقعت دموعه فى كف الرحمٰن","","Majmu'a Da'eef Ahadith 605","","","Chapter"
"606","من سقي الماء فى موضع يقدر على الماء فله بكل شربة يشربها برا كان او فاجرا عشر حسنات","","Majmu'a Da'eef Ahadith 606","","","Chapter"
"607","مداراة الناس صدقة","","Majmu'a Da'eef Ahadith 607","","","Chapter"
"608","من لم يكن عنده صدقة فليلعن اليهود","","Majmu'a Da'eef Ahadith 608","","","Chapter"
