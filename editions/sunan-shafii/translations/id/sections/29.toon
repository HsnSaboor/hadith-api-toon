hadiths[7]{hadithnumber,text}:
"353","[AI-translation] Dari Abu Sa'id Al-Khudri radhiyallahu 'anhu: Bahwasanya Rasulullah shallallahu 'alaihi wasallam bersabda: ""Tidak ada zakat pada kurang dari lima ekor unta [lima dzawd]""."
"354","[AI-translation] Dari Abu Sa'id Al-Khudri radhiyallahu 'anhu, ia berkata: Rasulullah shallallahu 'alaihi wasallam bersabda: ""Tidak ada zakat pada kurang dari lima ekor unta""."
"355","[AI-translation] Dari Abu Sa'id Al-Khudri radhiyallahu 'anhu, ia berkata: Rasulullah shallallahu 'alaihi wasallam bersabda: ""Dan tidak ada zakat pada kurang dari lima wasaq [hasil bumi]""."
"356","[AI-translation] Dari Abu Sa'id Al-Khudri radhiyallahu 'anhu: Bahwasanya Rasulullah shallallahu 'alaihi wasallam bersabda: ""Tidak ada zakat pada kurang dari lima wasaq kurma""."
"357","[AI-translation] Dari Abu Sa'id Al-Khudri radhiyallahu 'anhu: Bahwasanya Rasulullah shallallahu 'alaihi wasallam bersabda: ""Tidak ada zakat pada kurang dari lima uqiyah [perak]""."
"358","[AI-translation] Dari Abu Sa'id Al-Khudri radhiyallahu 'anhu, ia berkata: Rasulullah shallallahu 'alaihi wasallam bersabda: ""Dan tidak ada zakat pada kurang dari lima uqiyah""."
"359","[AI-translation] Dari Abu Sa'id Al-Khudri radhiyallahu 'anhu: Bahwasanya Rasulullah shallallahu 'alaihi wasallam bersabda: ""Dan tidak ada zakat pada kurang dari lima uqiyah perak [wariq]""."
