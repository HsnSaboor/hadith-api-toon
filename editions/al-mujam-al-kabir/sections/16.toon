hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"9001","8974  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  مَنْ أَقَامَ الصَّلَاةَ ، وَلَمْ         [9/200]      يُؤْتِ الزَّكَاةَ فَلَا صَلَاةَ لَهُ  "" .","","Al-Mu'jam al-Kabir 8974","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","باب"
"9002","8975  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  مُحَمَّدِ بْنِ زَيْدِ بْنِ خُلَيْدَةَ ،  أَنَّ عَبْدَ اللهِ دَخَلَ عَلَيْهِ ، وَقَدْ نَصَبَ مَتَاعًا فِي بَيْتِهِ ،  فَقَالَ  عَبْدُ اللهِ  :  اسْتَخِفَّ مِنْ  شُوَارِ  بَيْتِكَ فَإِنَّ النَّاسَ  يُوشِكُوا  أَنْ يَكُونُوا أَهْلَ قَتَبٍ  "" .","","Al-Mu'jam al-Kabir 8975","","عبد الله بن مسعود عن محمد بن زيد بن خليدة اليشكري عن عمرو بن مرة المرادي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9003","8976  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  عَوْنِ بْنِ عَبْدِ اللهِ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  إِنَّ الْمُؤْمِنَ مَأْلَفٌ وَلَا خَيْرَ فِيمَنْ لَا يَأْلَفُ ، وَلَا يُؤْلَفُ  "" .","","Al-Mu'jam al-Kabir 8976","","عبد الله بن مسعود عن عون بن عبد الله بن عتبة عن سلمة بن دينار الأعرج عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9004","8977  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  ثَنَا  الْمَسْعُودِيُّ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَوْنِ بْنِ عَبْدِ اللهِ ،  أَنَّ  عَبْدَ اللهِ كَانَ يَسْتَعِيذُ مِنْ أَرْبَعٍ ، يَقُولُ :  اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ غِنًى يُطْغِينِي  ، وَمِنْ فَقْرٍ يُنْسِينِي ، وَمِنْ هَوًى يُرْدِينِي ، وَمِنْ عَمَلٍ يُحْزِنُنِي  "" .","","Al-Mu'jam al-Kabir 8977","","عبد الله بن مسعود عن عون بن عبد الله بن عتبة عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عبد الله بن رجاء الغداني عن أبو مسلم الكجي عن الطبراني","باب"
"9005","8978  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَوْنٍ ،  أَنَّ  عَبْدَ اللهِ كَانَ يَقُولُ :  إِيَّاكُمْ وِصِعَابَ الْقَوْلِ  "" .","","Al-Mu'jam al-Kabir 8978","","عبد الله بن مسعود عن عون بن عبد الله بن عتبة عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9006","8979  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  ثَنَا  الْمَسْعُودِيُّ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَوْنٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ لِأَصْحَابِهِ حِينَ قَدِمُوا عَلَيْهِ : "" هَلْ تَجَالَسُونَ ؟ "" قَالُوا : لَيْسَ نَتْرُكُ ذَلِكَ ، قَالَ : "" فَهَلْ تَزَاوَرُونَ ؟ "" قَالُوا : نَعَمْ يَا  أَبَا عَبْدِ الرَّحْمَنِ  ،  إِنَّ الرَّجُلَ مِنَّا لَيَفْقِدُ أَخَاهُ فَيَمْشِي فِي طَلَبِهِ إِلَى آخِرِ  الْكُوفَةِ  حَتَّى يَلْقَاهُ  . قَالَ : "" فَإِنَّكُمْ لَنْ         [9/201]      تَزَالُوا بِخَيْرٍ مَا فَعَلْتُمْ ذَلِكَ ""  .","","Al-Mu'jam al-Kabir 8979","","عبد الله بن مسعود عن عون بن عبد الله بن عتبة عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عبد الله بن رجاء الغداني عن أبو مسلم الكجي عن الطبراني","باب"
"9007","8980  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  يَزِيدُ بْنُ زِيَادِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  عُبَيْدِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  قَيْسِ بْنِ سَكَنٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  لَا تَأْكُلُوا مِنَ الْجُبْنِ إِلَّا مَا صَنَعَ الْمُسْلِمُونَ ، وَأَهْلُ الْكِتَابِ  "" .","","Al-Mu'jam al-Kabir 8980","","عبد الله بن مسعود عن قيس بن السكن السوائى عن عبيد بن أبي الجعد الغطفاني عن يزيد بن زياد بن أبي الجعد الغطفاني عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9008","8981  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي مِجْلَزٍ ،  عَنْ  أَبِي عُبَيْدَةَ ،  أَنَّ  عَبْدَ اللهِ كَانَ إِذَا قَامَ فِي الصَّلَاةِ خَفَضَ فِيهَا صَوْتَهُ ، وَيَدَهُ ، وَبَصَرَهُ  "" .","","Al-Mu'jam al-Kabir 8981","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن لاحق بن حميد عن قتادة بن دعامة عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9009","8982  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  عَنِ  الْمَسْعُودِيِّ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ مَيْسَرَةَ ،  عَنِ  النَّزَّالِ بْنِ سَبْرَةَ ، قَالَ :  مَا خَطَبَ عَبْدُ اللهِ  بِالْكُوفَةِ  خُطْبَةً إِلَّا شَهِدْتُهَا  فَسَمِعْتُهُ  يَوْمًا ، وَسُئِلَ عَنِ الرَّجُلِ يُطَلِّقُ ثَمَانِيًا وَأَشْبَاهَ ذَلِكَ ، فَقَالَ : هُوَ كَمَا قَالَ ، ثُمَّ قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ أَنْزَلَ كِتَابَهُ وَبَيَّنَ بَيَانَهُ  ، فَمَنْ أَتَى الْأَمْرَ مِنْ قِبَلِ وَجْهِهِ فَقَدْ بُيِّنَ لَهُ ، وَمَنْ خَالَفَ فَوَاللهِ مَا نُطِيقُ كُلَّ خِلَافِكُمْ  "" .","","Al-Mu'jam al-Kabir 8982","","عبد الله بن مسعود عن النزال بن سبرة الهلالي عن عبد الملك بن ميسرة الهلالي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9010","8983  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ، قَالَ  يَحْيَى بْنُ عَمْرِو بْنِ سَلِمَةَ :  أَخْبَرَنِي  عَنْ  أَبِيهِ  ، قَالَ :  سُئِلَ ابْنُ مَسْعُودٍ ، عَنْ صَوْمِ الدَّهْرِ فَكَرِهَهُ ،  وَقَالَ  :  صَوْمُ ثَلَاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ  "" .","","Al-Mu'jam al-Kabir 8983","","عبد الله بن مسعود عن عمرو بن سلمة بن الحارث الهمداني عن يحيى بن عمرو بن سلمة بن الحارث الهمداني عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","باب"
"9011","8984  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  يَحْيَى بْنِ عَمْرِو بْنِ سَلِمَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  صَوْمُ ثَلَاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ يُذْهِبْنَ  وَحَرَ  الصَّدْرِ  "" .","","Al-Mu'jam al-Kabir 8984","","عبد الله بن مسعود عن عمرو بن سلمة بن الحارث الهمداني عن يحيى بن عمرو بن سلمة بن الحارث الهمداني عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9012","8985  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنِ         [9/202]      الْحَكَمِ ،  عَنْ  أَبِي عُبَيْدَةَ ، قَالَ :  كَانَ عَبْدُ اللهِ يَقُولُ بَعْدَ الرُّكُوعِ :  اللَّهُمَّ لَكَ الْحَمْدُ  مِلْءَ  السَّمَاوَاتِ وَمِلْءَ الْأَرْضِ وَمِلْءَ مَا شِئْتَ مِنْ شَيْءٍ بَعْدُ  ، أَهْلَ الثَّنَاءِ وَالْمَجْدِ ، لَا مَانِعَ لِمَا أَعْطَيْتَ وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  "" .","","Al-Mu'jam al-Kabir 8985","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن الحكم بن عتيبة الكندي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9013","8986  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  وَائِلِ بْنِ رَبِيعَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  مَا بَيْنَ السَّمَاءِ وَالْأَرْضِ  مَسِيرَةُ  خَمْسِمِائَةِ عَامٍ  "" .","","Al-Mu'jam al-Kabir 8986","","عبد الله بن مسعود عن وائل بن ربيعة الكوفي عن المسيب بن رافع الكاهلي عن عاصم بن بهدلة عن حماد بن سلمة عن هدبة بن خالد عن الساجي عن الطبراني","باب"
"9014","8987  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّهُ قَالَ :  مَا بَيْنَ السَّمَاءِ الدُّنْيَا وَالَّتِي تَلِيهَا  مَسِيرَةُ  خَمْسِمِائَةِ عَامٍ ،  وَمَا بَيْنَ كُلِّ سَمَاءٍ  مَسِيرَةُ  خَمْسِمِائَةِ عَامٍ ، وَمَا بَيْنَ السَّمَاءِ السَّابِعَةِ وَالْكُرْسِيِّ  مَسِيرَةُ  خَمْسِمِائَةِ عَامٍ ، وَمَا بَيْنَ الْكُرْسِيِّ وَالْمَاءِ  مَسِيرَةُ  خَمْسِمِائَةِ عَامٍ ، وَالْعَرْشُ عَلَى الْمَاءِ ، وَاللهُ عَزَّ وَجَلَّ عَلَى الْعَرْشِ يَعْلَمُ مَا أَنْتُمْ عَلَيْهِ  "" .","","Al-Mu'jam al-Kabir 8987","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن هدبة بن خالد عن الساجي عن الطبراني","باب"
"9015","8988  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ :  تَطْلُعُ الشَّمْسُ مِنْ  جَهَنَّمَ  فِي  قَرْنِ  شَيْطَانٍ  ، وَبَيْنَ  قَرْنِ  شَيْطَانٍ  ، فَمَا تَرْتَفِعُ فِي السَّمَاءِ قَضْمَةً إِلَّا فُتِحَ بَابٌ مِنْ أَبْوَابِ النَّارِ ، فَإِذَا  اشْتَدَّ  الْحَرُّ فُتِحَتْ أَبْوَابُهَا كُلُّهَا  "" .","","Al-Mu'jam al-Kabir 8988","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن هدبة بن خالد عن الساجي عن الطبراني","باب"
"9016","8989  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي عَمَّارٍ ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ ، قَالَ :  رَأَى عَبْدُ اللهِ مَعَ رَجُلٍ دَرَاهِمَ ، فَقَالَ : "" مَا تَصْنَعُ بِهَا ؟ "" قَالَ : أَشْتَرِي بِهَا  فِرْقَ  سَمْنٍ ،  فَقَالَ  :  أَعْطِهَا امْرَأَتَكَ تَضَعْهَا تَحْتَ فِرَاشِهَا ثُمَّ اشْتَرِ كُلَّ يَوْمٍ         [9/203]      لَحْمًا بِدِرْهَمٍ  "" .","","Al-Mu'jam al-Kabir 8989","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن عريب بن حميد الدهني عن الأعمش عن أبو بكر بن عياش عن أبو كريب محمد بن العلاء عن محمد بن عثمان بن أبي شيبة عن الطبراني","باب"
"9017","8990  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  مُحَمَّدُ بْنُ طَلْحَةَ ،  عَنْ  زُبَيْدٍ ،  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ قَسَمَ بَيْنَكُمْ  أَخْلَاقَكُمْ  كَمَا قَسَمَ بَيْنَكُمْ أَرْزَاقَكُمْ  ، وَإِنَّ اللهَ يُعْطِي الْمَالَ مَنْ يُحِبُّ وَمَنْ لَا يُحِبُّ ، وَلَا يُعْطِي الْإِيمَانَ إِلَّا مَنْ يُحِبُّ ، فَإِذَا أَحَبَّ اللهُ عَبْدًا أَعْطَاهُ الْإِيمَانَ ، فَمَنْ ضَنَّ بِالْمَالِ أَنْ يُنْفِقَهُ ، وَهَابَ الْعَدُوَّ أَنْ يُجَاهِدَهُ ، وَاللَّيْلَ أَنْ يُكَابِدَهُ ، فَلْيُكْثِرْ مِنْ قَوْلِ لَا إِلَهَ إِلَّا اللهُ ، وَاللهُ أَكْبَرُ ، وَالْحَمْدُ لِلهِ ، وَسُبْحَانَ اللهِ  "" .","","Al-Mu'jam al-Kabir 8990","","عبد الله بن مسعود عن مرة بن شراحيل عن زبيد بن الحارث اليامي عن محمد بن طلحة بن مصرف الهمداني عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9018","8991  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ قَالَ :  قَالَ  عَبْدُ اللهِ :  تَدْرُونَ كَيْفَ يُنْقَصُ الْإِسْلَامُ  ؟ "" قَالُوا : كَمَا يُنْقَصُ صِبْغُ الثَّوْبِ ، وَكَمَا يُنْقَصُ مِنَ الدَّابَّةِ ، وَكَمَا  يَقْسُو  الدِّرْهَمُ عَنْ طُولِ الْحَبْيِ ، قَالَ : "" إِنَّ ذَلِكَ لَمِنْهُ ، وَأَكْثَرُ مِنْ ذَلِكَ  مَوْتُ أَوْ ذَهَابُ  الْعُلَمَاءِ  "" .","","Al-Mu'jam al-Kabir 8991","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9019","8992  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  يُوضَعُ الصِّرَاطُ عَلَى  سَوَاءِ  جَهَنَّمَ  مِثْلَ حَدِّ السَّيْفِ الْمُرْهَفِ ، مَدْحَضَةٌ  مَزِلَّةٌ ،  عَلَيْهِ كَلَالِيبُ مِنْ نَارٍ يُخْتَطَفُ بِهَا ، فَمُمْسَكٌ يَهْوِي فِيهَا ، وَمَصْرُوعٌ ، وَمِنْهُمْ مَنْ يَمُرُّ كَالْبَرْقِ ، فَلَا  يَنْشَبُ  ذَاكَ أَنْ يَنْجُوَ ، ثُمَّ كَالرِّيحِ وَلَا  يَنْشَبُ  ذَاكَ أَنْ يَنْجُوَ ، ثُمَّ كَجَرْيِ الْفَرَسِ ، ثُمَّ كَسَعْيِ الرَّجُلِ ، ثُمَّ كَرَمَلِ الرَّجُلِ ، ثُمَّ كَمَشْيِ الرَّجُلِ ، حَتَّى يَكُونَ آخِرَهُمْ إِنْسَانًا رَجُلٌ قَدْ لَوَّحَتْهُ النَّارُ وَلَقِيَ فِيهَا شَرًّا ، حَتَّى يُدْخِلَهُ اللهُ الْجَنَّةَ بِفَضْلِ رَحْمَتِهِ ، فَيُقَالُ لَهُ : تَمَنَّ وَسَلْ ، فَيَقُولُ : أَيْ رَبِّ أَتَهْزَأُ مِنِّي ، وَأَنْتَ رَبُّ الْعِزَّةِ ، فَيُقَالُ لَهُ : تَمَنَّ وَسَلْ ، قَالَ : حَتَّى إِذَا انْقَطَعَتِ الْأَمَانِيُّ قَالَ : لَكَ مَا سَأَلْتَ وَمِثْلُهُ مَعَهُ ""         [9/204]      قَالَ :  وَحَدَّثَنِي  أَبُو صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : وَعَشَرَةُ أَمْثَالِهِ مَعَهُ  .","","Al-Mu'jam al-Kabir 8992","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9020","8993  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ، وَمَعْمَرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ، قَالَ :  جَاءَ رَجُلٌ مِنْ  بَجِيلَةَ  إِلَى عَبْدِ اللهِ ، فَقَالَ : إِنِّي تَزَوَّجْتُ جَارِيَةً بِكْرًا ، وَإِنِّي قَدْ خَشِيتُ أَنْ  تَفْرَكَنِي  ، فَقَالَ  عَبْدُ اللهِ  :  إِنَّ الْإِلْفَ مِنَ اللهِ ، وَإِنَّ الْفَرْكَ مِنَ الشَّيْطَانِ  ، لِيُكَرِّهَ إِلَيْهِ مَا أَحَلَّ اللهُ لَهُ ، فَإِذَا دَخَلْتَ عَلَيْهَا فَمُرْهَا فَلْتُصَلِّ خَلْفَكَ رَكْعَتَيْنِ "" قَالَ  الْأَعْمَشُ  : فَذَكَرْتُهُ لِإِبْرَاهِيمَ ،  فَقَالَ  :  قَالَ  عَبْدُ اللهِ : "" وَقُلِ :  اللَّهُمَّ بَارِكْ لِي فِي أَهْلِي ، وَبَارِكْ لَهُمْ فِيَّ  ، اللَّهُمَّ ارْزُقْنِي مِنْهُمْ وَارْزُقْهُمْ مِنِّي ، اللَّهُمَّ اجْمَعْ بَيْنَنَا مَا جَمَعْتَ إِلَى خَيْرٍ ، وَفَرِّقْ بَيْنَنَا إِذَا فَرَّقْتَ إِلَى خَيْرٍ  "" .","","Al-Mu'jam al-Kabir 8993","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9021","8994  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ،  أَنَّ  رَجُلًا أَتَى ابْنَ مَسْعُودٍ ، فَقَالَ : إِنِّي تَزَوَّجْتُ امْرَأَةً ، وَإِنِّي أَخَافُ الْفَرْكَ ، قَالَ :  إِذَا أَتَيْتَ بِهَا فَصَلِّ رَكْعَتَيْنِ وَقُلِ : اللَّهُمَّ بَارِكْ لِي فِي أَهْلِي  ، وَبَارِكْ لَهُمْ فِيَّ ، اللَّهُمَّ اجْمَعْ بَيْنَنَا مَا جَمَعْتَ بِخَيْرٍ ، وَفَرِّقْ بَيْنَنَا إِذَا فَرَّقْتَ إِلَى خَيْرٍ  "" .","","Al-Mu'jam al-Kabir 8994","","عبد الله بن مسعود عن عبد الله بن حبيب السلمي عن عطاء بن السائب عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9022","8995  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  غَيْرِ وَاحِدٍ مِنْ أَصْحَابِهِ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  عَسَى رَجُلٌ أَنْ يَقُولَ :  إِنَّ اللهَ أَمَرَ بِكَذَا وَنَهَى عَنْ كَذَا ، فَيَقُولُ اللهُ عَزَّ وَجَلَّ لَهُ : كَذَبْتَ  ، أَوْ يَقُولُ : إِنَّ اللهَ حَرَّمَ كَذَا وَأَحَلَّ كَذَا ، فَيَقُولُ اللهُ لَهُ : كَذَبْتَ  "" .","","Al-Mu'jam al-Kabir 8995","","عبد الله بن مسعود عن غير واحد من أصحاب عطاء بن السائب عن عطاء بن السائب عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9023","8996  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  زُبَيْدٍ ،  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  مَثَلُ الَّذِي يُدِيمُ الصَّلَاةَ مَثَلُ الَّذِي يَقْرَعُ الْبَابَ  ، وَمَنْ يُدِيمُ قَرْعَ الْبَابِ  يُوشِكُ  أَنْ يُفْتَحَ لَهُ  "" .","","Al-Mu'jam al-Kabir 8996","","عبد الله بن مسعود عن مرة بن شراحيل عن زبيد بن الحارث اليامي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن الفضل بن الحباب الجمحي عن الطبراني","باب"
"9024","[9/205]      8997  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  زُبَيْدٍ ،  عَنْ  مُرَّةَ قَالَ :  قَالَ  عَبْدُ اللهِ :  إِنَّكَ مَا كُنْتَ فِي صَلَاةٍ فَإِنَّكَ تَقْرَعُ بَابَ الْمَلِكِ  ، وَمَنْ يُكْثِرُ قَرْعَ بَابِ الْمَلِكِ  يُوشِكُ  أَنْ يُفْتَحَ لَهُ  "" .","","Al-Mu'jam al-Kabir 8997","","عبد الله بن مسعود عن مرة بن شراحيل عن زبيد بن الحارث اليامي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9025","8998  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  زُبَيْدٍ ،  عَنْ  مُرَّةَ بْنِ شُرَحْبِيلَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  فَضْلُ صَلَاةِ اللَّيْلِ عَلَى صَلَاةِ النَّهَارِ  كَفَضْلِ صَدَقَةِ السِّرِّ عَلَى الْعَلَانِيَةِ  "" .","","Al-Mu'jam al-Kabir 8998","","عبد الله بن مسعود عن مرة بن شراحيل عن زبيد بن الحارث اليامي عن منصور بن المعتمر عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9026","8999  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  زُبَيْدٍ ،  عَنْ  مُرَّةَ قَالَ :  قَالَ  عَبْدُ اللهِ :  فَضْلُ صَلَاةِ اللَّيْلِ عَلَى صَلَاةِ النَّهَارِ  كَفَضْلِ صَدَقَةِ السِّرِّ عَلَى الْعَلَانِيَةِ  "" .","","Al-Mu'jam al-Kabir 8999","","عبد الله بن مسعود عن مرة بن شراحيل عن زبيد بن الحارث اليامي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9027","9000  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  سَيِّدُ الشُّهُورِ رَمَضَانُ ، وَسَيِّدُ الْأَيَّامِ يَوْمُ الْجُمُعَةِ  "" .","","Al-Mu'jam al-Kabir 9000","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9028","9001  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ، قَالَ :  تَلَا عَبْدُ اللهِ هَذِهِ الْآيَةَ :         {      يَوْمَ تُبَدَّلُ الأَرْضُ غَيْرَ الأَرْضِ وَالسَّمَاوَاتُ وَبَرَزُوا لِلهِ الْوَاحِدِ الْقَهَّارِ         }      قَالَ  :  يُجَاءُ بِأَرْضٍ كَأَنَّهَا سَبِيكَةُ فِضَّةٍ لَمْ  يُسْفَكْ  عَلَيْهَا دَمٌ  ، وَلَمْ تُعْمَلْ عَلَيْهَا خَطِيئَةٌ ، فَأَوَّلُ مَا يُحْكَمُ بَيْنَ النَّاسِ فِيهِ فِي الدِّمَاءِ  "" .","","Al-Mu'jam al-Kabir 9001","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9029","9002  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  مُسْلِمٍ الْبَطِينِ ،  عَنْ  أَبِي الْعُبَيْدَيْنِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  الْأَوَّاهُ الرَّحِيمُ  "" .","","Al-Mu'jam al-Kabir 9002","","عبد الله بن مسعود عن معاوية بن سبرة بن حصين السوائي عن مسلم بن عمران البطين عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9030","9003  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ         [9/206]      بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ،  فِي قَوْلِهِ :         {      إِنَّ إِبْرَاهِيمَ لأَوَّاهٌ حَلِيمٌ         }      قَالَ :  الْأَوَّاهُ الرَّحِيمُ  "" .","","Al-Mu'jam al-Kabir 9003","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عبد الكريم الاصطخري عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9031","9004  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ قَالَ :  سُئِلَ ابْنُ مَسْعُودٍ عَنِ الْأَوَّاهِ ؟  قَالَ  : "" هُوَ الدَّعَّاءُ  "" .","","Al-Mu'jam al-Kabir 9004","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9032","9005  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  يَحْيَى بْنُ إِسْحَاقَ السَّيْلَحِينِيُّ ،  ثَنَا  الرَّبِيعُ بْنُ مُسْلِمٍ ،  عَنْ  يُوسُفَ بْنِ سَعْدٍ قَالَ :  كَانَ عَبْدُ اللهِ بْنُ مَسْعُودٍ يُحَدِّثُ كُلَّ يَوْمٍ فِي الْمَسْجِدِ ، فَإِذَا كَانَ يَوْمُ الْخَمِيسِ انْتَابَهُ أَهْلُ الرَّسَاتِيقِ وَالْقُرَى ، فَجَاءَ رَجُلٌ أَعْمَى فَقَالَ :  يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، "" مَا الْأَوَّاهُ ؟  قَالَ  : الرَّحِيمُ ،  قَالَ : فَمَا التَّبْذِيرُ ؟ قَالَ : "" مَا أُنْفِقَ فِي غَيْرِ حَقٍّ "" ، قَالَ : فَمَا الْمَاعُونُ ؟ قَالَ : "" مَا يَتَعَاوَنُ النَّاسُ بَيْنَهُمْ ،  يَعْنِي الْعَوَارِيَ  "" .","","Al-Mu'jam al-Kabir 9005","","عبد الله بن مسعود عن يوسف بن سعد الراسبي عن الربيع بن مسلم الجمحي عن يحيى بن إسحاق السيلحيني عن بشر بن موسى بن صالح الأسدي عن الطبراني","باب"
"9033","9006  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  يَحْيَى بْنِ الْجَزَّارِ ،  أَنَّ  رَجُلًا يُقَالُ لَهُ :  أَبُو الْعُبَيْدَيْنِ  - وَكَانَ رَجُلًا ضَرِيرًا - وَكَانَ عَبْدُ اللهِ بْنُ مَسْعُودٍ يُعَرَّفُ لَهُ ،  فَسَأَلَهُ عَنِ  الْمَاعُونِ  فَقَالَ : ""  الْفَأْسُ ، وَالدَّلْوُ "" - أَوْ قَالَ : "" الْفَأْسُ ، وَالْقِدْرُ  - وَسَأَلَهُ عَنِ التَّبْذِيرِ ، فَقَالَ : "" إِنْفَاقُ الْمَالِ فِي غَيْرِ حِلِّهِ "" ، وَسَأَلَهُ عَنِ الْأَوَّاهِ ، قَالَ : "" الرَّحِيمُ  ""  .","","Al-Mu'jam al-Kabir 9006","","عبد الله بن مسعود عن يحيى بن الجزار العرني عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","باب"
"9034","9007  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ  ، ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْحَكَمِ ،  عَنْ  أَبِي الْعُبَيْدَيْنِ الْعَامِرِيِّ ، - وَكَانَ ضَرِيرَ الْبَصَرِ ، وَكَانَ عَبْدُ اللهِ بْنُ مَسْعُودٍ يَدِينُهُ ، فَقَالَ  لِعَبْدِ اللهِ  : مَنْ نَسْأَلُ إِنْ لَمْ نَسْأَلْكَ ؟ فَرَقَّ لَهُ  عَبْدُ اللهِ  ، فَقَالَ :  مَا الْأَوَّاهُ ؟  قَالَ  : "" الرَّحِيمُ  ، قَالَ : فَمَا الْأُمَّةُ ؟ قَالَ : "" الَّذِي يُعَلِّمُ الْخَيْرَ "" ، قَالَ : فَمَا  الْقَانِتُ  ؟ قَالَ : "" الْمُطِيعُ "" ، قَالَ : فَمَا الْمَاعُونُ ؟ قَالَ : "" مَا يَتَعَاوَنُ النَّاسُ بَيْنَهُمْ "" ، قَالَ : فَمَا التَّبْذِيرُ ؟ قَالَ :         [9/207]      "" إِنْفَاقُ الْمَالِ فِي غَيْرِ حَقِّهِ  "" .","","Al-Mu'jam al-Kabir 9007","","عبد الله بن مسعود عن معاوية بن سبرة بن حصين السوائي عن الحكم بن عتيبة الكندي عن الأعمش عن علي بن مسهر القرشي عن منجاب بن الحارث التميمي عن الحسين بن جعفر القتات عن الطبراني","باب"
"9035","9008  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ ،  عَنْ  مُسْلِمٍ الْبَطِينِ ،  عَنْ  أَبِي الْعُبَيْدَيْنِ قَالَ :  سُئِلَ عَبْدُ اللهِ عَنِ التَّبْذِيرِ ؟  فَقَالَ  : "" الْإِنْفَاقُ فِي غَيْرِ حَقٍّ  "" .","","Al-Mu'jam al-Kabir 9008","","عبد الله بن مسعود عن معاوية بن سبرة بن حصين السوائي عن مسلم بن عمران البطين عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9036","9009  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  أَبُو وَكِيعٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْعُبَيْدَيْنِ ، قَالَ :  سَأَلْتُ  عَبْدَ اللهِ عَنْ قَوْلِهِ :         {      وَلا تُبَذِّرْ تَبْذِيرًا         }      قَالَ : "" هُوَ النَّفَقَةُ فِي غَيْرِ حَقٍّ  "" .","","Al-Mu'jam al-Kabir 9009","","عبد الله بن مسعود عن معاوية بن سبرة بن حصين السوائي عن أبو إسحاق السبيعي عن الجراح بن مليح الرؤاسي والد وكيع عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9037","9010  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْعُبَيْدَيْنِ ، وَسَعْدِ بْنِ عِيَاضٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كُنَّا أَصْحَابَ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَتَحَدَّثُ أَنَّ  الْمَاعُونَ  : الدَّلْوُ ، وَالْقِدْرُ ، وَالْفَأْسُ ، لَا يُسْتَغْنَى عَنْهُمْ  ""  .","","Al-Mu'jam al-Kabir 9010","","عبد الله بن مسعود عن سعد بن عياض الثمالي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","باب"
"9038","9011  -  حَدَّثَنَا عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ اللهِ ،  فِي قَوْلِهِ :         {      الْمَاعُونَ         }      قَالَ : "" الْفَأْسُ ، وَالْقِدْرُ ، وَالدَّلْوُ  "" .","","Al-Mu'jam al-Kabir 9011","","عبد الله بن مسعود عن إبراهيم النخعي عن الأعمش عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9039","9012  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  حَدَّثَنِي  أَبُو الْمُغِيرَةِ ،  عَنِ  ابْنِ عُمَرَ ،  فِي قَوْلِهِ :         {      وَيَمْنَعُونَ الْمَاعُونَ         }      قَالَ : "" هُوَ الْمَالُ الَّذِي لَا يُعْطَى حَقُّهُ  ، قُلْتُ : إِنَّ ابْنَ مَسْعُودٍ ، يَقُولُ : "" هُوَ مَا يَتَعَاطَى النَّاسُ بَيْنَهُمْ مِنَ الْخَيْرِ "" قَالَ : ذَاكَ مَا أَقُولُ لَكَ  .","","Al-Mu'jam al-Kabir 9012","","عبد الله بن عمر بن الخطاب عن علي بن ربيعة بن نضلة الوالبي عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9040","9013  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُعَلَّى بْنُ مَهْدِيٍّ الْمَوْصِلِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَاصِمِ ابْنِ بَهْدَلَةَ ،  عَنْ  أَبِي وَائِلٍ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  كُلُّ مَعْرُوفٍ صَدَقَةٌ  ، وَكُنَّا نَعُدُّ الْمَاعُونَ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَارِيَةَ  الدَّلْوِ ،         [9/208]      وَالْقِدْرِ ، وَأَشْبَاهِ ذَلِكَ ""  .","","Al-Mu'jam al-Kabir 9013","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن الوضاح بن عبد الله اليشكري عن معلى بن مهدي الموصلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9041","9014  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  شَيْبَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كُنَّا نَعُدُّ  الْمَاعُونَ  الْفَأْسَ ، وَالْقِدْرَ ، وَالدَّلْوَ  "" .","","Al-Mu'jam al-Kabir 9014","","عبد الله بن مسعود عن شقيق بن سلمة عن منصور بن المعتمر عن شيبان بن عبد الرحمن المؤدب عن الوليد بن مسلم القرشي عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","باب"
"9042","9015  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  خَيْثَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      إِنَّ الْمُنَافِقِينَ فِي الدَّرْكِ الأَسْفَلِ مِنَ النَّارِ         }      قَالَ :  تَوَابِيتُ مِنْ حَدِيدٍ تُطْبَقُ عَلَيْهِمْ  "" .","","Al-Mu'jam al-Kabir 9015","","عبد الله بن مسعود عن خيثمة بن عبد الرحمن الجعفي عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9043","9016  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  ابْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      فَمُسْتَقَرٌّ وَمُسْتَوْدَعٌ         }      قَالَ :  الْمُسْتَقَرُّ : الرَّحِمُ  ، وَالْمُسْتَوْدَعُ : الْأَرْضُ الَّتِي يَمُوتُ فِيهَا  ""  .","","Al-Mu'jam al-Kabir 9016","","عبد الله بن مسعود عن إبراهيم النخعي عن إسماعيل بن أبي خالد عن قيس بن الربيع الأسدي عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9044","9017  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  مُسْتَوْدَعُهَا فِي الدُّنْيَا ، وَمُسْتَقَرُّهَا فِي الرَّحِمِ  ""  .","","Al-Mu'jam al-Kabir 9017","","عبد الله بن مسعود عن إبراهيم النخعي عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9045","9018  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      وَمِنَ الأَنْعَامِ حَمُولَةً وَفَرْشًا         }      قَالَ :  الْحَمُولَةُ  مَا حَمَلَ مِنَ الْإِبِلِ ،  وَالْفَرْشُ  الصِّغَارُ  ""  .","","Al-Mu'jam al-Kabir 9018","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9046","[9/209]      9019  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  عَنْ  سُفْيَانَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      هَلْ يَنْظُرُونَ إِلا أَنْ تَأْتِيَهُمُ الْمَلائِكَةُ أَوْ يَأْتِيَ رَبُّكَ أَوْ يَأْتِيَ بَعْضُ آيَاتِ رَبِّكَ يَوْمَ يَأْتِي بَعْضُ آيَاتِ رَبِّكَ لا يَنْفَعُ نَفْسًا إِيمَانُهَا لَمْ تَكُنْ آمَنَتْ مِنْ قَبْلُ         }      قَالَ :  طُلُوعُ الشَّمْسِ مَعَ الْقَمَرِ مِنْ مَغْرِبِهَا كَالْبَعِيرَيْنِ  الْقَرِينَيْنِ  ""  .","","Al-Mu'jam al-Kabir 9019","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن منصور بن المعتمر عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9047","9020  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  زُرَارَةَ بْنِ أَوْفَى ،  عَنِ  ابْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      يَوْمَ يَأْتِي بَعْضُ آيَاتِ رَبِّكَ لا يَنْفَعُ نَفْسًا إِيمَانُهَا         }      قَالَ :  طُلُوعُ الشَّمْسِ مِنْ مَغْرِبِهَا  ""  .","","Al-Mu'jam al-Kabir 9020","","عبد الله بن مسعود عن زرارة بن أوفى عن قتادة بن دعامة عن شعبة بن الحجاج عن عبد الرحمن بن زياد العراقي عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9048","9021  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  عَنْ  شَرِيكٍ ، قَالَ :  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  سَعْدِ بْنِ عِيَاضٍ ،  عَنِ  ابْنِ مَسْعُودٍ ،  قَوْلُهُ :         {      وَلا تُبَذِّرْ تَبْذِيرًا         }      قَالَ :  النَّفَقَةُ فِي غَيْرِ حَقِّهِ  ""  .","","Al-Mu'jam al-Kabir 9021","","عبد الله بن مسعود عن سعد بن عياض الثمالي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9049","9022  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ، قَالَ :  ثَنَا  الْفِرْيَابِيُّ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  زِرٍّ ،  عَنْ  أَبِي وَائِلٍ ،  عَنِ  ابْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      فَلَيْسَ عَلَيْهِنَّ جُنَاحٌ أَنْ يَضَعْنَ ثِيَابَهُنَّ غَيْرَ مُتَبَرِّجَاتٍ بِزِينَةٍ         }      قَالَ "" الرِّدَاءُ  ""  .","","Al-Mu'jam al-Kabir 9022","","عبد الله بن مسعود عن شقيق بن سلمة عن زر بن حبيش الثعلبي عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9050","9023  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنْ  مَسْرُوقٍ ، قَالَ :  سَأَلْنَا  عَبْدَ اللهِ         [9/210]      عَنْ هَذِهِ الْآيَةِ :         {      وَلا تَحْسَبَنَّ الَّذِينَ قُتِلُوا فِي سَبِيلِ اللهِ         }      إِلَى         {      يُرْزَقُونَ         }      قَالَ :  أَرْوَاحُ الشُّهَدَاءِ عِنْدَ اللهِ عَزَّ وَجَلَّ كَطَيْرٍ خُضْرٍ لَهَا قَنَادِيلُ مُعَلَّقَةٌ  بِالْعَرْشِ  ، تَسْرَحُ فِي الْجَنَّةِ حَيْثُ شَاءَتْ "" ، قَالَ : "" فَاطَّلَعَ عَلَيْهِمْ رَبُّكَ اطِّلَاعَةً فَقَالَ : هَلْ تَشْتَهُونَ مِنْ شَيْءٍ فَأَزِيدُكُمُوهُ ؟ قَالُوا : رَبَّنَا أَلَسْنَا نَسْرَحُ فِي الْجَنَّةِ فِي أَيِّهَا حَيْثُ شِئْنَا ؟ "" قَالَ : "" ثُمَّ اطَّلَعَ عَلَيْهِمُ الثَّانِيَةَ فَقَالَ : هَلْ تَشْتَهُونَ مِنْ شَيْءٍ فَأَزِيدُكُمُوهُ ؟ قَالُوا : رَبَّنَا أَلَسْنَا نَسْرَحُ فِي الْجَنَّةِ فِي أَيِّهَا حَيْثُ شِئْنَا ؟ ثُمَّ اطَّلَعَ إِلَيْهِمُ الثَّالِثَةَ فَقَالَ : هَلْ تَشْتَهُونَ مِنْ شَيْءٍ فَأَزِيدُكُمُوهُ ؟ قَالُوا : تُعِيدُ أَرْوَاحَنَا فِي أَجْسَادِنَا فَنُقَاتِلُ فِي سَبِيلِكَ فَنُقْتَلُ مَرَّةً أُخْرَى "" ، قَالَ : "" فَسَكَتَ عَنْهُمْ  "" .","","Al-Mu'jam al-Kabir 9023","","عبد الله بن مسعود عن مسروق بن الأجدع عن عبد الله بن مرة الخارفي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9051","9024  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنْ  مَسْرُوقٍ ، قَالَ :  سَأَلْنَا  عَبْدَ اللهِ بْنَ مَسْعُودٍ ، عَنْ هَذِهِ الْآيَةِ :         {      وَلا تَحْسَبَنَّ الَّذِينَ قُتِلُوا فِي سَبِيلِ اللهِ أَمْوَاتًا بَلْ أَحْيَاءٌ عِنْدَ رَبِّهِمْ يُرْزَقُونَ         }      قَالَ : قَدْ سَأَلْنَا عَنْهَا قَالَ :  أَرْوَاحُ الشُّهَدَاءِ كَطَيْرٍ خُضْرٍ  "" ،  ثُمَّ ذَكَرَ مِثْلَ حَدِيثِ  الثَّوْرِيِّ","","Al-Mu'jam al-Kabir 9024","","عبد الله بن مسعود عن مسروق بن الأجدع عن عبد الله بن مرة الخارفي عن الأعمش عن قيس بن الربيع الأسدي عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9052","9025  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ،  قَالَ فِي الثَّالِثَةِ قَالَ :  هَلْ تَشْتَهُونَ مِنْ شَيْءٍ فَأَزِيدُكُمُوهُ  ؟ قَالُوا :  تُقْرِئُ  نَبِيَّنَا السَّلَامَ عَنَّا ، وَتُخْبِرُهُ أَنَّا قَدْ رَضِينَا وَرُضِيَ عَنَّا  "" .","","Al-Mu'jam al-Kabir 9025","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عطاء بن السائب عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9053","9026  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  مِسْعَرُ بْنُ كِدَامٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ مَيْسَرَةَ ،  عَنِ  ابْنِ         [9/211]      سَابِطٍ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنِ  ابْنِ مَسْعُودٍ  فِي قَوْلِهِ :         {      وَقُودُهَا النَّاسُ وَالْحِجَارَةُ         }      قَالَ :  حِجَارَةٌ مِنْ كِبْرِيتٍ يَجْعَلُهَا اللهُ عَزَّ وَجَلَّ عِنْدَهُ كَيْفَ شَاءَ ، وَكَمَا شَاءَ  ""  .","","Al-Mu'jam al-Kabir 9026","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن عبد الرحمن بن سابط الجمحي عن عبد الملك بن ميسرة الهلالي عن مسعر بن كدام عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9054","9027  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنِ  السُّدِّيِّ ،  حَدَّثَنِي  أَبُو سَعْدٍ الْأَزْدِيُّ ،  عَنْ  أَبِي الْكَنُودِ ،  عَنِ  ابْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      وَقُولُوا حِطَّةٌ         }      قَالَ : "" قَالُوا :  حِنْطَةٌ  حَبَّةٌ  حَمْرَاءُ فِيهَا شَعِيرَةٌ  ، فَذَلِكَ قَوْلُهُ :         {      فَبَدَّلَ الَّذِينَ ظَلَمُوا قَوْلا غَيْرَ الَّذِي قِيلَ لَهُمْ         }      ""  .","","Al-Mu'jam al-Kabir 9027","","عبد الله بن مسعود عن أبو الكنود الأزدي عن أبو سعد الأزدي عن السدي الكبير عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9055","9028  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      فَمَنْ تَعَجَّلَ فِي يَوْمَيْنِ فَلا إِثْمَ عَلَيْهِ وَمَنْ تَأَخَّرَ فَلا إِثْمَ عَلَيْهِ         }      قَالَ : "" مَغْفُورٌ لَهُ  ""  .","","Al-Mu'jam al-Kabir 9028","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9056","9029  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  زُبَيْدٍ ،  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  أُنْزِلَتْ هَؤُلَاءِ الْآيَاتِ مِنْ آخِرِ الْبَقَرَةِ :         {      آمَنَ الرَّسُولُ         }      مِنْ كَنْزٍ تَحْتَ الْعَرْشِ  ""  .","","Al-Mu'jam al-Kabir 9029","","عبد الله بن مسعود عن مرة بن شراحيل عن زبيد بن الحارث اليامي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9057","9030  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  هُشَيْمٌ ،  أَنَا  جُوَيْبِرٌ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ مَسْعُودٍ ،         {      وَإِنْ تُبْدُوا مَا فِي أَنْفُسِكُمْ أَوْ تُخْفُوهُ         }      قَالَ : "" نَسَخَتْهَا الْآيَةُ الَّتِي بَعْدَهَا  :         {      لَهَا مَا كَسَبَتْ وَعَلَيْهَا مَا اكْتَسَبَتْ         }      ""  .","","Al-Mu'jam al-Kabir 9030","","عبد الله بن مسعود عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن هشيم بن بشير عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9058","[9/212]      9031  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  قَالَ :  إِنَّ هَذَا الصِّرَاطَ مُحْتَضَرٌ تَحْضُرُهُ الشَّيَاطِينُ  يَقُولُونَ : يَا عِبَادَ اللهِ هَذَا الطَّرِيقُ فَاعْتَصِمُوا بِحَبْلِ اللهِ فَإِنَّ الصِّرَاطَ الْمُسْتَقِيمَ كِتَابُ اللهِ  "" .","","Al-Mu'jam al-Kabir 9031","","عبد الله بن مسعود عن شقيق بن سلمة عن منصور بن المعتمر عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9059","9032  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  جَامِعِ بْنِ أَبِي رَاشِدٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ  فِي قَوْلِهِ :         {      وَاعْتَصِمُوا بِحَبْلِ اللهِ جَمِيعًا         }      قَالَ  عَبْدُ اللهِ  : "" الْقُرْآنُ  ""  .","","Al-Mu'jam al-Kabir 9032","","عبد الله بن مسعود عن شقيق بن سلمة عن جامع بن أبي راشد الكاهلي عن سفيان بن عيينة عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9060","9033  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  هُشَيْمٌ ،  أَنَا  الْعَوَّامُ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  حَبْلُ اللهِ عَزَّ وَجَلَّ هُوَ الْجَمَاعَةُ  "" .","","Al-Mu'jam al-Kabir 9033","","عبد الله بن مسعود عن الشعبي عن العوام بن حوشب عن هشيم بن بشير عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9061","9034  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  جُوَيْبِرٍ ،  عَنِ  الضَّحَّاكِ ،  عَنِ  ابْنِ مَسْعُودٍ  فِي قَوْلِهِ :         {      الَّذِينَ يَذْكُرُونَ اللهَ قِيَامًا وَقُعُودًا وَعَلَى جُنُوبِهِمْ         }      قَالَ : "" إِنْ لَمْ تَسْتَطِعْ أَنْ تُصَلِّيَ قَائِمًا فَقَاعِدًا  ، وَإِلَّا فَمُضْطَجِعٌ  "" .","","Al-Mu'jam al-Kabir 9034","","عبد الله بن مسعود عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9062","9035  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَلْقَمَةَ ، وَالْأَسْوَدِ ، قَالَا :  قَالَ  عَبْدُ اللهِ :  إِنَّ فِي كِتَابِ اللهِ لَآيَتَيْنِ مَا أَذْنَبَ عَبْدٌ ذَنْبًا فَقَرَأَهُمَا فَاسْتَغْفَرَ اللهَ إِلَّا غَفَرَ اللهُ لَهُ  :         {      وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللهَ فَاسْتَغْفَرُوا لِذُنُوبِهِمْ وَمَنْ يَغْفِرُ الذُّنُوبَ إِلا اللهُ         }      وَقَوْلُهُ :         {      وَمَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللهَ يَجِدِ اللهَ غَفُورًا رَحِيمًا         }      "" .","","Al-Mu'jam al-Kabir 9035","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9063","[9/213]      9036  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلِيٍّ ، وَابْنِ مَسْعُودٍ  فِي قَوْلِهِ :         {      وَالْمُحْصَنَاتُ مِنَ النِّسَاءِ إِلا مَا مَلَكَتْ أَيْمَانُكُمْ         }      قَالَ  عَلِيٌّ  : "" الْمُشْرِكَاتُ إِذَا سُبِينَ حَلَّتْ لَهُ  ، وَقَالَ  ابْنُ مَسْعُودٍ  : "" الْمُشْرِكَاتُ ، وَالْمُسْلِمَاتُ  "" .","","Al-Mu'jam al-Kabir 9036","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9064","9037  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  عَنْ  سُفْيَانَ ،  عَنْ  جَابِرٍ ،  عَنِ  الْقَاسِمِ ، أَوِ الشَّعْبِيِّ  ،  عَنِ  ابْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      وَالصَّاحِبِ بِالْجَنْبِ         }      قَالَ : "" الْمَرْأَةُ  ""  .","","Al-Mu'jam al-Kabir 9037","","عبد الله بن مسعود عن الشعبي عن جابر الجعفي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9065","9038  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنِ  السُّدِّيِّ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ،  فِي قَوْلِهِ :         {      وَلَنُذِيقَنَّهُمْ مِنَ الْعَذَابِ الأَدْنَى         }      قَالَ : ""  يَوْمُ بَدْرٍ  ، وَالْعَذَابِ الْأَكْبَرِ لَعَلَّهُمْ يَرْجِعُونَ قَالَ : "" مَنْ بَقِيَ مِنْهُمْ أَنْ يَتُوبَ فَيَرْجِعَ  "" .","","Al-Mu'jam al-Kabir 9038","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن السدي الكبير عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9066","9039  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  عَنْ  قَيْسِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  ، قَالَ :  إِنَّهُ لَمَكْتُوبٌ فِي التَّوْرَاةِ : لِلَّذِينَ تَتَجَافَى جُنُوبُهُمْ عَنِ الْمَضَاجِعِ مَا لَمْ تَرَ عَيْنٌ  ، وَلَمْ تَسْمَعْ أُذُنٌ ، وَلَمْ يَخْطُرْ عَلَى قَلْبِ بَشَرٍ ، وَإِنَّهُ لَفِي الْقُرْآنِ :         {      فَلا تَعْلَمُ نَفْسٌ مَا أُخْفِيَ لَهُمْ مِنْ قُرَّةِ أَعْيُنٍ         }      "" .","","Al-Mu'jam al-Kabir 9039","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن قيس بن الربيع الأسدي عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9067","9040  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  إِنْ كَانَ  الْجُعَلُ  لَيُعَذَّبُ فِي جُحْرِهِ بِذُنُوبِ بَنِي آدَمِ  ، ثُمَّ قَرَأَ :         {      وَلَوْ يُؤَاخِذُ اللهُ النَّاسَ بِمَا كَسَبُوا مَا تَرَكَ عَلَى ظَهْرِهَا مِنْ دَابَّةٍ         }      .","","Al-Mu'jam al-Kabir 9040","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9068","[9/214]      9041  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  عَنْ  سُفْيَانَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنِ  ابْنِ مَسْعُودٍ  فِي قَوْلِهِ :         {      وَالصَّافَّاتِ صَفًّا         }      قَالَ : "" الْمَلَائِكَةُ         {      فَالزَّاجِرَاتِ زَجْرًا         }      قَالَ : "" الْمَلَائِكَةُ         {      فَالتَّالِيَاتِ ذِكْرًا         }      قَالَ : "" الْمَلَائِكَةُ ""  .","","Al-Mu'jam al-Kabir 9041","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9069","9042  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  عَنْ  قَيْسِ بْنِ الرَّبِيعِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  إِنَّ فِي السَّمَاوَاتِ السَّبْعِ سَمَاءً مَا فِيهَا مَوْضِعُ شِبْرٍ  إِلَّا عَلَيْهِ جَبْهَةُ مَلَكٍ أَوْ قَدَمَاهُ قَائِمًا "" ، ثُمَّ قَرَأَ :         {      وَإِنَّا لَنَحْنُ الصَّافُّونَ             *          وَإِنَّا لَنَحْنُ الْمُسَبِّحُونَ         }      .","","Al-Mu'jam al-Kabir 9042","","عبد الله بن مسعود عن مسلم بن صبيح الهمداني عن الأعمش عن قيس بن الربيع الأسدي عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9070","9043  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  الْفِرْيَابِيُّ ،  عَنْ  سُفْيَانَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ :         {      وَعَزَّنِي فِي الْخِطَابِ         }      قَالَ : "" مَا زَادَ  دَاوُدُ  عَلَى أَنْ قَالَ  :         {      أَكْفِلْنِيهَا         }      ""  .","","Al-Mu'jam al-Kabir 9043","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9071","9044  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ  ،  عَنِ  ابْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      رَبَّنَا أَمَتَّنَا اثْنَتَيْنِ وَأَحْيَيْتَنَا اثْنَتَيْنِ         }      ، قَالَ : "" هِي مِثْلُ الَّتِي فِي الْبَقَرَةِ :         {      وَكُنْتُمْ أَمْوَاتًا فَأَحْيَاكُمْ ثُمَّ يُمِيتُكُمْ ثُمَّ يُحْيِيكُمْ ثُمَّ إِلَيْهِ تُرْجَعُونَ         }      "" .  في طبعة مكتبة ابن تيمية : ( أبي الضحى ) والمثبت من نسخة الظاهرية ( 1 )","","Al-Mu'jam al-Kabir 9044","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9072","9045  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  عَنْ  قَيْسِ بْنِ الرَّبِيعِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، مِثْلَ حَدِيثِ  إِسْرَائِيلَ  .","","Al-Mu'jam al-Kabir 9045","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن قيس بن الربيع الأسدي عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9073","9046  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا         [9/215]      الْفِرْيَابِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  قَالَ  :  كُنَّا جُلُوسًا فِي الْمَسْجِدِ إِذْ دَخَلَ عَلَيْنَا رَجُلٌ يُحَدِّثُ ، قَالَ : يَجِيءُ يَوْمَ الْقِيَامَةِ دُخَانٌ فَيَأْخُذُ بِأَسْمَاعِ الْمُنَافِقِينَ ، وَيَأْخُذُ الْمُؤْمِنِينَ كَهَيْئَةِ الزُّكَامِ ، فَدَخَلْنَا عَلَى عَبْدِ اللهِ بْنِ مَسْعُودٍ فَحَدَّثْنَاهُ وَهُوَ مُتَّكِئٌ فَجَلَسَ فَقَالَ : يَا أَيُّهَا النَّاسُ ، مَنْ عَلِمَ عِلْمًا فَلْيَتَكَلَّمْ بِهِ ، وَمَنْ لَمْ يَعْلَمْ فَلْيَقُلِ : اللهُ أَعْلَمُ ، فَإِنَّهُ مِنْ عِلْمِ الرَّجُلِ أَنْ يَقُولَ لِمَا لَا يَعْلَمُ : اللهُ أَعْلَمُ ، وَقَدْ قَالَ اللهُ لِنَبِيِّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         {      قُلْ مَا أَسْأَلُكُمْ عَلَيْهِ مِنْ أَجْرٍ وَمَا أَنَا مِنَ الْمُتَكَلِّفِينَ         }      وَسَأُحَدِّثُكُمْ عَنِ الدُّخَانِ : إِنَّ  قُرَيْشًا  لَمَّا اسْتَعْصَوْا وَأَبْطَئُوا عَنِ الْإِسْلَامِ دَعَا عَلَيْهِمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  اللَّهُمَّ أَعِنِّي عَلَيْهِمْ بِسَبْعٍ كَسَبْعِ  يُوسُفَ  ، فَأَصَابَتْهُمْ سَنَةٌ حَتَّى  حَصَّتْ  كُلَّ شَيْءٍ حَتَّى أَكَلُوا الْمَيْتَةَ وَالْعِظَامَ ، حَتَّى جَعَلَ الرَّجُلُ يَرَى مَا بَيْنَهُ وَبَيْنَ السَّمَاءِ دُخَانًا ، فَذَلِكَ قَوْلُهُ :         {      فَارْتَقِبْ يَوْمَ تَأْتِي السَّمَاءُ بِدُخَانٍ مُبِينٍ             *          يَغْشَى النَّاسَ هَذَا عَذَابٌ أَلِيمٌ             *          رَبَّنَا اكْشِفْ عَنَّا الْعَذَابَ إِنَّا مُؤْمِنُونَ         }      فَكَشَفَ عَنْهُمْ فَعَادُوا فِي كُفْرِهِمْ ، فَأَخَذَهُمْ  يَوْمَ بَدْرٍ  فَذَلِكَ قَوْلُهُ :         {      يَوْمَ نَبْطِشُ الْبَطْشَةَ الْكُبْرَى إِنَّا مُنْتَقِمُونَ         }      قَالَ : الْبَطْشَةُ الْكُبْرَى  يَوْمُ بَدْرٍ .","","Al-Mu'jam al-Kabir 9046","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن قيس بن الربيع الأسدي عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9074","9047  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، مِثْلَهُ","","Al-Mu'jam al-Kabir 9047","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9075","9048  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ، وَأَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ، وَمَنْصُورٍ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  قَالَ  :  بَيْنَمَا رَجُلٌ يُحَدِّثُ فِي  كِنْدَةَ  قَالَ : يَجِيءُ دُخَانٌ  يَوْمَ الْقِيَامَةِ فَيَأْخُذُ بِأَسْمَاعِ الْمُنَافِقِينَ  ، فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 9048","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن منصور بن المعتمر عن سفيان الثوري عن محمد بن كثير العبدي عن الفضل بن الحباب الجمحي عن الطبراني","باب"
"9076","9049  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ         [9/216]      بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  فِطْرُ بْنُ خَلِيفَةَ ،  ثَنَا  مُسْلِمُ بْنُ صُبَيْحٍ ، قَالَ :  سَمِعْتُ  مَسْرُوقًا ، يَقُولُ :  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ :  خَمْسٌ قَدْ مَضَيْنَ : الدُّخَانُ ، وَالْقَمَرُ  ،  وَالرُّومُ  ، وَالْبَطْشَةُ ، وَاللِّزَامُ  "" .","","Al-Mu'jam al-Kabir 9049","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن فطر بن خليفة عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9077","9050  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  عَنْ  إِسْرَائِيلَ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنِ  ابْنِ مَسْعُودٍ  فِي قَوْلِهِ :         {      لَقَدْ رَأَى مِنْ آيَاتِ رَبِّهِ الْكُبْرَى         }      ، قَالَ : "" أَيْ  جِبْرِيلَ  عَلَيْهِ السَّلَامُ فِي  حُلَّةٍ  رَفْرَفٍ  ، قَدْ مَلَأَ مَا بَيْنَ السَّمَاءِ ، وَالْأَرْضِ  "" .","","Al-Mu'jam al-Kabir 9050","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9078","9051  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  عَنْ  سُفْيَانَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ،  فِي قَوْلِهِ :         {      لَقَدْ رَأَى مِنْ آيَاتِ رَبِّهِ الْكُبْرَى         }      قَالَ : "" رَأَى  رَفْرَفًا  أَخْضَرَ قَدْ سَدَّ الْأُفُقَ  ""  .","","Al-Mu'jam al-Kabir 9051","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9079","9052  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، وَسَهْلُ بْنُ بَكَّارٍ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ  ، ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ، (  ح  )  وَحَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، قَالُوا :  أَنَا  شُعْبَةُ ،  عَنْ  سُلَيْمَانَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ،  فِي قَوْلِهِ :         {      لَقَدْ رَأَى مِنْ آيَاتِ رَبِّهِ الْكُبْرَى         }      قَالَ :  رَأَى  رَفْرَفًا  أَخْضَرَ قَدْ سَدَّ أُفُقَ السَّمَاءِ  "" .","","Al-Mu'jam al-Kabir 9052","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","باب"
"9080","9053  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  أَبُو         [9/217]      مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ،  فِي قَوْلِهِ :         {      لَقَدْ رَأَى مِنْ آيَاتِ رَبِّهِ الْكُبْرَى         }      قَالَ :  رَفْرَفًا  خُضْرًا مِنَ الْجَنَّةِ قَدْ سَدَّ الْأُفُقَ  "" .","","Al-Mu'jam al-Kabir 9053","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9081","9054  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  عَنْ  قَيْسِ بْنِ الرَّبِيعِ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  فِي قَوْلِهِ :         {      لَقَدْ رَأَى مِنْ آيَاتِ رَبِّهِ الْكُبْرَى         }      قَالَ :  رَأَى  مُحَمَّدٌ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  جِبْرِيلَ  فِي صُورَتِهِ لَهُ سِتُّمِائَةِ جَنَاحٍ  مَا مِنْهَا جَنَاحٌ إِلَّا قَدْ سَدَّ مَا بَيْنَ الْمَشْرِقِ ، وَالْمَغْرِبِ  "" .","","Al-Mu'jam al-Kabir 9054","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن قيس بن الربيع الأسدي عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9082","9055  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  زُهَيْرٌ ، (  ح  )  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  أَبُو مُعَاوِيَةَ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  يَحْيَى بْنُ يَمَانٍ ،  ثَنَا  سُفْيَانُ ، كُلُّهُمْ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ  فِي قَوْلِهِ :         {      لَقَدْ رَأَى مِنْ آيَاتِ رَبِّهِ الْكُبْرَى         }      ،  قَالَ : "" لَهُ سِتُّمِائَةِ جَنَاحٍ  "" .","","Al-Mu'jam al-Kabir 9055","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن سليمان بن فيروز الشيباني عن سفيان الثوري عن يحيى بن يمان العجلي عن عبد الله بن أحمد بن حنبل عن الطبراني","باب"
"9083","9056  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنِ  الْحَسَنِ الْعُرَنِيِّ ،  عَنْ  هُزَيْلٍ ،  عَنِ  ابْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      عِنْدَ سِدْرَةِ الْمُنْتَهَى         }      قَالَ :  صُبْرُ  الْجَنَّةِ جُعِلَ عِنْدَهَا قُصُورُ  السُّنْدُسِ  وَالْإِسْتَبْرَقِ  "" .","","Al-Mu'jam al-Kabir 9056","","عبد الله بن مسعود عن هزيل بن شرحبيل الأودي عن الحسن بن عبد الله العرني عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9084","9057  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَبْدِ اللهِ بْنِ         [9/218]      مَسْعُودٍ قَالَ :  الرُّؤْيَا الصَّالِحَةُ  جُزْءٌ  مِنْ سَبْعِينَ  جُزْءًا  مِنَ النُّبُوَّةِ  ، وَإِنَّ  السَّمُومَ  الَّتِي خُلِقَ مِنْهَا الْجَانُّ جُزْءٌ مِنْ سَبْعِينَ جُزْءًا مِنْ نَارِ  جَهَنَّمَ ،  وَإِنَّ نَارَكُمْ هَذِهِ جُزْءٌ مِنْ سَبْعِينَ جُزْءًا مِنْ نَارِ  جَهَنَّمَ  "" .","","Al-Mu'jam al-Kabir 9057","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9085","9058  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  عَنْ  إِسْرَائِيلَ ،  عَنِ  السُّدِّيِّ ،  عَنْ  أَبِي مَالِكٍ ،  عَنْ  مَسْرُوقٍ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  الْمَرْجَانُ الْخَرَزُ الْأَحْمَرُ  "" .","","Al-Mu'jam al-Kabir 9058","","عبد الله بن مسعود عن مسروق بن الأجدع عن غزوان الغفاري عن السدي الكبير عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9086","9059  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  عَنْ  قَيْسِ بْنِ الرَّبِيعِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      يَا أَيُّهَا الَّذِينَ آمَنُوا لا تَتَوَلَّوْا قَوْمًا غَضِبَ اللهُ عَلَيْهِمْ قَدْ يَئِسُوا مِنَ الآخِرَةِ         }      فَلَا يُؤْمِنُوا بِهَا وَلَا يُؤْجَرُوا ، هَذَا الْكَافِرُ إِذَا مَاتَ وَعَايَنَ ثَوَابَهُ ، وَاطَّلَعَ عَلَيْهِ  "" .","","Al-Mu'jam al-Kabir 9059","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن قيس بن الربيع الأسدي عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9087","9060  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  عَنْ  سُفْيَانَ ،  عَنْ  جَامِعِ بْنِ شَدَّادٍ ،  عَنِ  الْأَسْوَدِ بْنِ هِلَالٍ ،  قَالَ  :  جَاءَ رَجُلٌ إِلَى عَبْدِ اللهِ بْنِ مَسْعُودٍ ، فَسَأَلَهُ عَنْ هَذِهِ الْآيَةِ  :         {      وَمَنْ يُوقَ شُحَّ نَفْسِهِ فَأُولَئِكَ هُمُ الْمُفْلِحُونَ         }      وَإِنِّي امْرُؤٌ مَا قَدَرْتُ أَنْ لَا يَخْرُجَ مِنِّي شَيْءٌ ، وَقَدْ خَشِيتُ أَنْ أَكُونَ قَدْ أَصَابَتْنِي هَذِهِ الْآيَةُ ، فَقَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ  : "" ذَكَرْتَ الْبُخْلَ ، وَبِئْسَ الشَّيْءُ الْبُخْلُ ، وَأَمَّا مَا ذَكَرَ اللهُ فَلَيْسَ مَا قُلْتَ ، ذَاكَ أَنْ تَعْمِدَ إِلَى مَالِ غَيْرِكَ أَوْ مَالِ أَخِيكَ فَتَأْكُلَهُ  "" .","","Al-Mu'jam al-Kabir 9060","","عبد الله بن مسعود عن الأسود بن هلال المحاربي عن جامع بن شداد عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9088","9061  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا         [9/219]      الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنِ  ابْنِ مَسْعُودٍ  فِي قَوْلِهِ :         {      حُسُومًا         }      قَالَ : "" مُتَتَابِعَاتٌ  "" .","","Al-Mu'jam al-Kabir 9061","","عبد الله بن مسعود عن عبد الله بن سخبرة عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9089","9062  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ،  عَنْ  زَيْدِ بْنِ مُعَاوِيَةَ ،  عَنْ  عَلْقَمَةَ بْنِ قَيْسٍ ،  قَالَ  مُرَّةُ :  عَنِ  ابْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      خِتَامُهُ مِسْكٌ         }      قَالَ : "" لَيْسَ بِخَاتَمٍ يُخْتَمُ بِهِ وَلَكِنْ خَلَطَهُ مِسْكٌ  ، أَلَمْ تَرَ إِلَى الْمَرْأَةِ مِنْ نِسَائِكُمْ تَقُولُ : خَلَطَهُ مِنَ الطِّيبِ كَذَا وَكَذَا ؟  "" .","","Al-Mu'jam al-Kabir 9062","","عبد الله بن مسعود عن مرة بن شراحيل عن علقمة بن قيس النخعي عن زيد بن معاوية العبسي عن أشعث بن أبي الشعثاء عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9090","9063  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي مَيْسَرَةَ ،  عَنْ  عَبْدِ اللهِ ،  الْخُنَّسِ         {      الْجَوَارِ الْكُنَّسِ         }      مَا هِي يَا  عَمْرُو  ؟  قَالَ : قُلْتُ : الْبَقَرُ ، قَالَ : "" وَأَنَا أَرَى ذَلِكَ  "" .","","Al-Mu'jam al-Kabir 9063","","عبد الله بن مسعود عن عمرو بن شرحبيل الهمداني عن أبو إسحاق السبيعي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9091","9064  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ،         {      وَاتْلُ عَلَيْهِمْ نَبَأَ الَّذِي آتَيْنَاهُ آيَاتِنَا         }      قَالَ : "" هُوَ  بَلْعَمُ  وَيُقَالُ  بَلْعَامُ  "" .","","Al-Mu'jam al-Kabir 9064","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن منصور بن المعتمر عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9092","9065  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي فَرْوَةَ ،  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ ،         {      لَتَرْكَبُنَّ طَبَقًا عَنْ طَبَقٍ         }      قَالَ : "" السَّمَاءُ  "" .","","Al-Mu'jam al-Kabir 9065","","عبد الله بن مسعود عن مرة بن شراحيل عن عروة بن الحارث الهمداني عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9093","9066  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ كِلَاهُمَا ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  أَبِي رَبَاحٍ ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ ،  قَالَ  :  أَتَيْتُ ابْنَ مَسْعُودٍ بِأُبَّاقٍ مِنْ عَبِيدِ  الْيَمَنِ  ، فَقَالَ : "" الْأَجْرُ وَالْغَنِيمَةُ  قَالَ : قُلْتُ : أَمَّا الْأَجْرُ فَقَدْ عَرَفْنَاهُ فَمَا الْغَنِيمَةُ ؟ قَالَ : "" أَرْبَعِينَ دِرْهَمًا مِنْ كُلِّ إِنْسَانٍ  "" .","","Al-Mu'jam al-Kabir 9066","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن عبد الله بن رباح القيسي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9094","[9/220]      9067  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي الْأَحْوَصِ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ  الْهَرْجُ  "" قَالَ  أَبُو الْأَحْوَصِ  : ""  الْهَرْجُ  : الْقَتْلُ  "" .","","Al-Mu'jam al-Kabir 9067","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن سلمة بن كهيل الحضرمي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","باب"
"9095","9068  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ  قَالَ :  كَانَ مَا اشْتُرِيَ بِهِ  يُوسُفُ  عِشْرُونَ دِرْهَمًا  ، وَكَانَ أَهْلُهُ حِينَ أَرْسَلَ إِلَيْهِمْ وَهُمْ  بِمِصْرَ  ثَلَاثَةً وَتِسْعِينَ إِنْسَانًا ، رِجَالُهُمْ أَنْبِيَاءُ ، وَنِسَاؤُهُمْ صِدِّيقَاتٌ ، وَاللهِ مَا خَرَجُوا بِهِ مَعَ  مُوسَى  حَتَّى بَلَغُوا سِتَّمِائَةِ أَلْفٍ وَسَبْعِينَ أَلْفًا  "" .","","Al-Mu'jam al-Kabir 9068","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9096","9069  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مِسْعَرٍ ،  عَنْ  مَعْنِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  إِنَّ فِي النِّسَاءِ لَخَمْسُ آيَاتٍ مَا يَسُرُّنِي بِهِنَّ الدُّنْيَا  وَمَا فِيهَا ، وَقَدْ عَلِمْتُ أَنَّ الْعُلَمَاءَ إِذَا مَرُّوا بِهَا يَعْرِفُونَهَا         {      إِنْ تَجْتَنِبُوا كَبَائِرَ مَا تُنْهَوْنَ عَنْهُ نُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَنُدْخِلْكُمْ مُدْخَلا كَرِيمًا         }      وَقَوْلُهُ :         {      إِنَّ اللهَ لا يَظْلِمُ مِثْقَالَ ذَرَّةٍ وَإِنْ تَكُ حَسَنَةً يُضَاعِفْهَا وَيُؤْتِ مِنْ لَدُنْهُ أَجْرًا عَظِيمًا         }      وَ         {      إِنَّ اللهَ لا يَغْفِرُ أَنْ يُشْرَكَ بِهِ وَيَغْفِرُ مَا دُونَ ذَلِكَ لِمَنْ يَشَاءُ         }             {      وَلَوْ أَنَّهُمْ إِذْ ظَلَمُوا أَنْفُسَهُمْ جَاءُوكَ فَاسْتَغْفَرُوا اللهَ وَاسْتَغْفَرَ لَهُمُ الرَّسُولُ لَوَجَدُوا اللهَ تَوَّابًا رَحِيمًا         }             {      وَمَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللهَ يَجِدِ اللهَ غَفُورًا رَحِيمًا         }      "" .","","Al-Mu'jam al-Kabir 9069","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن معن بن عبد الرحمن المسعودي عن مسعر بن كدام عن سفيان بن عيينة عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9097","9070  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  جَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  أَبِي هُبَيْرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  إِنَّ فِي الْقُرْآنِ لَآيَتَيْنِ مَا أَذْنَبَ عَبْدٌ ذَنْبًا ، ثُمَّ تَلَاهُمَا وَاسْتَغْفَرَ اللهَ إِلَّا غَفَرَ لَهُ  ، فَسَأَلُوهُ عَنْهُمَا ، فَلَمْ يُخْبِرْهُمْ ، فَقَالَ  عَلْقَمَةُ  وَالْأَسْوَدُ  أَحَدُهُمَا لِصَاحِبِهِ : قُمْ بِنَا ، فَقَامَا إِلَى الْمَنْزِلِ فَأَخَذَا الْمُصْحَفَ فَتَصَفَّحَا الْبَقَرَةَ فَقَالَا : مَا رَأَيْنَاهُمَا ، ثُمَّ أَخَذَا فِي النِّسَاءِ حَتَّى انْتَهَيَا إِلَى هَذِهِ الْآيَةِ :         {      وَمَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللهَ يَجِدِ اللهَ غَفُورًا رَحِيمًا         }             [9/221]      فَقَالَ : هَذِهِ وَاحِدَةٌ ، ثُمَّ تَصَفَّحَا آلَ عِمْرَانَ حَتَّى انْتَهَيَا إِلَى قَوْلِهِ :         {      وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللهَ فَاسْتَغْفَرُوا لِذُنُوبِهِمْ وَمَنْ يَغْفِرُ الذُّنُوبَ إِلا اللهُ وَلَمْ يُصِرُّوا عَلَى مَا فَعَلُوا         }      قَالَا : هَذِهِ أُخْرَى ، ثُمَّ طَبَّقَا الْمُصْحَفَ ، ثُمَّ أَتَيَا  عَبْدَ اللهِ  فَقَالَا : هُمَا هَاتَانِ الْآيَتَانِ ؟ قَالَ : نَعَمْ  .","","Al-Mu'jam al-Kabir 9070","","عبد الله بن مسعود عن إبراهيم النخعي عن يحيى بن عباد بن شيبان الأنصاري عن ليث بن أبي سليم عن جرير بن عبد الحميد عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9098","9071  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  لَا يَزَالُ الرَّجُلُ فِي فُسْحَةٍ مِنْ دِينِهِ مَا لَمْ يُصِبْ دَمًا حَرَامًا  ، فَإِذَا أَصَابَ دَمًا حَرَامًا نُزِعَ مِنْهُ الْحَيَاءُ  "" .","","Al-Mu'jam al-Kabir 9071","","عبد الله بن مسعود عن إبراهيم النخعي عن الأعمش عن جرير بن عبد الحميد عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9099","9072  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  خَالِدٌ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  فِي قَوْلِهِ عَزَّ وَجَلَّ :         {      عَلَيْكُمْ أَنْفُسَكُمْ         }      قَالَ :  لَيْسَ هَذَا أَوَانَهَا ، فَقُولُوهَا مَا قُبِلَتْ مِنْكُمْ  ، فَإِذَا رُدَّتْ عَلَيْكُمْ فَعَلَيْكُمْ أَنْفُسَكُمْ لَا يَضُرُّكُمْ مَنْ ضَلَّ  ""  .","","Al-Mu'jam al-Kabir 9072","","عبد الله بن مسعود عن الحسن البصري عن يونس بن عبيد عن خالد بن عبد الله الطحان عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9100","9073  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  حُصَيْنٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  ابْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      يَوْمَ الْفُرْقَانِ يَوْمَ الْتَقَى الْجَمْعَانِ         }      قَالَ :  كَانَتْ  بَدْرٌ  لِسَبْعَ عَشْرَةَ مَضَتْ مِنْ رَمَضَانَ  ""  .","","Al-Mu'jam al-Kabir 9073","","عبد الله بن مسعود عن إبراهيم النخعي عن حصين بن عبد الرحمن السلمي عن سويد بن عبد العزيز السلمي عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9101","9074  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْأَسْوَدِ بْنِ يَزِيدَ ،  عَنِ  ابْنِ مَسْعُودٍ رَضِيَ اللهُ عَنْهُ قَالَ :  الْتَمِسُوا لَيْلَةَ الْقَدْرِ لِسَبْعَ عَشْرَةَ خَلَتْ مِنْ رَمَضَانَ  ، صَبِيحَةَ  يَوْمِ بَدْرٍ  :         [9/222]             {      يَوْمَ الْفُرْقَانِ يَوْمَ الْتَقَى الْجَمْعَانِ         }      وَفِي إِحْدَى وَعِشْرِينَ وَفِي ثَلَاثٍ وَعِشْرِينَ ، فَإِنَّهَا لَا تَكُونُ إِلَّا فِي  وِتْرٍ  "" .","","Al-Mu'jam al-Kabir 9074","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9102","9075  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  اعْتَبِرُوا الْمُنَافِقِينَ بِثَلَاثٍ : إِذَا حَدَّثَ كَذَبَ ، وَإِذَا وَعَدَ  أَخْلَفَ  ، وَإِذَا عَاهَدَ غَدَرَ ، وَأَنْزَلَ اللهُ تَصْدِيقَ ذَلِكَ فِي كِتَابِهِ :         {      وَمِنْهُمْ مَنْ عَاهَدَ اللهَ لَئِنْ آتَانَا مِنْ فَضْلِهِ         }      إِلَى آخِرِ الْآيَةِ  ""  .","","Al-Mu'jam al-Kabir 9075","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9103","9076  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  الْقُرْآنُ وَالْعَسَلُ هُمَا شِفَاءَانِ  ""  .","","Al-Mu'jam al-Kabir 9076","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9104","9077  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  هُشَيْمٌ ،  أَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ اللهِ ،  فِي قَوْلِهِ :         {      أُولَئِكَ الَّذِينَ يَدْعُونَ يَبْتَغُونَ إِلَى رَبِّهِمُ الْوَسِيلَةَ         }      قَالَ :  كَانَ نَاسٌ يَعْبُدُونَهُمْ فَأَسْلَمَ الَّذِينَ كَانُوا يَعْبُدُونَهُمْ  وَلَا يَعْلَمُ الَّذِينَ كَانُوا يَعْبُدُونَهُمْ فَعَيَّرَهُمُ اللهُ عَزَّ وَجَلَّ بِذَلِكَ "" فَقَالَ :         {      أُولَئِكَ الَّذِينَ يَدْعُونَ يَبْتَغُونَ إِلَى رَبِّهِمُ الْوَسِيلَةَ         }      .","","Al-Mu'jam al-Kabir 9077","","عبد الله بن مسعود عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9105","9078  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  الْحَكَمُ بْنُ ظُهَيْرٍ ،  عَنِ  السُّدِّيِّ ،  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      وَمَنْ يُرِدْ فِيهِ بِإِلْحَادٍ بِظُلْمٍ نُذِقْهُ مِنْ عَذَابٍ أَلِيمٍ         }      قَالَ :  مَنْ هَمَّ بِخَطِيئَةٍ فَعَمِلَهَا فِي سِوَى الْبَيْتِ لَمْ يُكْتَبْ عَلَيْهِ حَتَّى يَعْمَلَهَا  ، وَمَنْ هَمَّ بِخَطِيئَةٍ فَعَمِلَهَا فِي الْبَيْتِ لَمْ يُمِتْهُ اللهُ مِنَ الدُّنْيَا حَتَّى يُذِيقَهُ مِنْ عَذَابٍ أَلِيمٍ  ""  .","","Al-Mu'jam al-Kabir 9078","","عبد الله بن مسعود عن مرة بن شراحيل عن السدي الكبير عن الحكم بن ظهير الفزاري عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9106","9079  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  هُشَيْمٌ ،  أَنَا  سَيَّارٌ ، عَمَّنْ  حَدَّثَهُ  أَنَّ  ابْنَ مَسْعُودٍ رَأَى نَاسًا مِنْ أَهْلِ السُّوقِ سَمِعُوا         [9/223]      الْأَذَانَ  ، فَتَرَكُوا أَمْتِعَتَهُمْ وَقَامُوا إِلَى الصَّلَاةِ ، فَقَالَ : "" هَؤُلَاءِ الَّذِينَ قَالَ اللهُ عَزَّ وَجَلَّ :         {      رِجَالٌ لا تُلْهِيهِمْ تِجَارَةٌ وَلا بَيْعٌ عَنْ ذِكْرِ اللهِ         }      "" .","","Al-Mu'jam al-Kabir 9079","","عبد الله بن مسعود عن عمن عن سيار بن أبي سيار العنزي عن هشيم بن بشير عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9107","9080  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  الْمُحَارِبِيُّ ، وَأَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  قَيْسِ بْنِ السَّكَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،         {      وَأَرْسَلْنَا الرِّيَاحَ لَوَاقِحَ         }      قَالَ :  يُرْسِلُ اللهُ الرِّيحَ فَتَحْمِلُ الْمَاءَ  ، فَيَمُرُّ سَحَابٌ فَيَدِرُّ كَمَا تَدِرُّ اللِّقْحَةُ ثُمَّ يُمْطِرُ  "" .","","Al-Mu'jam al-Kabir 9080","","عبد الله بن مسعود عن قيس بن السكن السوائى عن المنهال بن عمرو الأسدي عن الأعمش عن الوضاح بن عبد الله اليشكري عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9108","9081  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسٌ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  لَا أَقِيسُ شَيْئًا بِشَيْءٍ  ، لَا تَزَلُّ قَدَمٌ بَعْدَ ثُبُوتِهَا  ""  .","","Al-Mu'jam al-Kabir 9081","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن جابر الجعفي عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9109","9082  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  وَكِيعٌ ،  عَنْ  سَلَمَةَ بْنِ نُبَيْطٍ ،  عَنِ  الضَّحَّاكِ ،  أَنَّ  عَبْدَ اللهِ بْنَ مَسْعُودٍ رَضِيَ اللهُ عَنْهُ أَذَابَ فِضَّةً مِنْ بَيْتِ الْمَالِ ، ثُمَّ أَرْسَلَ إِلَى أَهْلِ الْمَسْجِدِ فَقَالَ :  مَنْ أَرَادَ أَنْ يَنْظُرَ إِلَى الْمُهْلِ فَلْيَنْظُرْ إِلَى هَذَهِ  ""  .","","Al-Mu'jam al-Kabir 9082","","عبد الله بن مسعود عن الضحاك بن مزاحم الهلالي عن سلمة بن نبيط الأشجعي عن وكيع بن الجراح عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9110","9083  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونِ بْنِ مِهْرَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  أَنَّهُ : دَخَلَ بَيْتَ الْمَالِ فَدَعَا بِنُفَايَةٍ كَانَتْ فِيهِ ، فَأَوْقَدَ عَلَيْهَا حَتَّى إِذَا هِي ذَابَتْ ، قَالَ :  أَيْنَ السَّائِلُ عَنِ الْمُهْلِ ؟ هَذَا الْمُهْلُ  .","","Al-Mu'jam al-Kabir 9083","","عبد الله بن مسعود عن ميمون بن مهران الرقي عن عمرو بن ميمون بن مهران عن أبو معاوية الضرير عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9111","9084  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  وَكِيعٌ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ،         {      وَإِنْ مِنْكُمْ إِلا وَارِدُهَا         }      قَالَ : "" وُرُودُهَا الصِّرَاطُ  ""  .","","Al-Mu'jam al-Kabir 9084","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن وكيع بن الجراح عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9112","9085  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  وَكِيعٌ ،  عَنْ  أَبِي سِنَانٍ سَعِيدِ بْنِ سِنَانٍ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  قَالَ  :  بَلَغَ ابْنَ مَسْعُودٍ         [9/224]      أَنَّ  مَرْوَانَ  ، يَقُولُ :         {      وَآتَيْنَاهُ أَهْلَهُ وَمِثْلَهُمْ مَعَهُمْ         }      قَالَ : أُتِيَ أَهْلًا غَيْرَ أَهْلِهِ ، فَقَالَ  ابْنُ مَسْعُودٍ  :  بَلْ أُتِيَ بِأَهْلِهِ بِأَعْيَانِهِمْ وَمِثْلِهِمْ مَعَهُمْ  ""  .","","Al-Mu'jam al-Kabir 9085","","عبد الله بن مسعود عن الضحاك بن مزاحم الهلالي عن سعيد بن سنان البرجمي عن وكيع بن الجراح عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9113","9086  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ :         {      وَذَا النُّونِ إِذْ ذَهَبَ مُغَاضِبًا         }      ، قَالَ :  هُوَ عَبْدٌ  أَبَقَ  مِنْ سَيِّدِهِ  "" .","","Al-Mu'jam al-Kabir 9086","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن جرير بن عبد الحميد عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9114","9087  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  يُونُسَ بْنِ خَبَّابٍ ، عَمَّنْ  حَدَّثَهُ  :  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  إِذَا بَقِيَ فِي النَّارِ مَنْ يُخَلَّدُ فِيهَا جُعِلُوا فِي تَوَابِيتَ مِنْ نَارٍ فِيهَا مَسَامِيرُ مِنْ نَارٍ  -  قَالَ : ذَلِكَ مَرَّتَيْنِ أَوْ ثَلَاثًا  - فَلَا يَرَوْنَ أَحَدًا فِي النَّارِ يُعَذَّبُ غَيْرُهُمْ "" ، ثُمَّ قَرَأَ  عَبْدُ اللهِ  :         {      لَهُمْ فِيهَا زَفِيرٌ وَهُمْ فِيهَا لا يَسْمَعُونَ         }      .","","Al-Mu'jam al-Kabir 9087","","عبد الله بن مسعود عن عمن عن يونس بن خباب الأسيدي عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9115","9088  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  أَبَانَ بْنِ تَغْلِبَ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ :         {      بَنِينَ وَحَفَدَةً         }      قَالَ : "" هُمُ الْأَخْتَانُ  ""  .","","Al-Mu'jam al-Kabir 9088","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن المنهال بن عمرو الأسدي عن أبان بن تغلب بن رياح عن أبو معاوية الضرير عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9116","9089  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ بُكَيْرٍ الطَّيَالِسِيُّ الْبَصْرِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ :  الْحَفَدَةُ الْأَخْتَانُ  "" .","","Al-Mu'jam al-Kabir 9089","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن شريك بن عبد الله النخعي عن أبو الوليد الطيالسي عن محمد بن إبراهيم بن بكير الطيالسي عن الطبراني","باب"
"9117","9090  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ،         {      بَنِينَ وَحَفَدَةً         }      قَالَ : "" هُمُ الْأَخْتَانُ  "" .","","Al-Mu'jam al-Kabir 9090","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن أبو بكر بن عياش عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9118","9091  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  قَالَ  :  قَالَ لِي عَبْدُ اللهِ : "" هَلْ تَدْرِي مَا حَفَدَةٌ ؟ "" قُلْتُ : نَعَمْ ،  هُمْ حُفَّادُ الرَّجُلِ مِنْ وَلَدِهِ وَوَلَدِ وَلَدِهِ ، قَالَ : "" لَا هُمُ         [9/225]      الْأَصْهَارُ  "" .","","Al-Mu'jam al-Kabir 9091","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سفيان بن عيينة عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9119","9092  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرِّ ،  قَالَ  :  كُنْتُ آخُذُ عَلَى عَبْدِ اللهِ الْمُصْحَفَ ، فَأُتِيَ عَلَى هَذِهِ الْآيَةِ  :         {      وَجَعَلَ لَكُمْ مِنْ أَزْوَاجِكُمْ بَنِينَ وَحَفَدَةً         }      ، فَقَالَ لِي  عَبْدُ اللهِ  : "" أَتَدْرِي مَا الْحَفَدَةُ ؟ "" قُلْتُ : حَشَمُ الرَّجُلِ ، قَالَ : "" لَا ، هُمُ الْأَخْتَانُ  ""  .","","Al-Mu'jam al-Kabir 9092","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9120","9093  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      بَنِينَ وَحَفَدَةً         }      قَالَ : "" الْحَفَدَةُ الْأَخْتَانُ  ""  .","","Al-Mu'jam al-Kabir 9093","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9121","9094  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَيُؤَيِّدُ الدِّينَ بِالرَّجُلِ الْفَاجِرِ  ""  .","","Al-Mu'jam al-Kabir 9094","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9122","9095  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :         {      السَّائِحُونَ         }      الصَّائِمُونَ  .","","Al-Mu'jam al-Kabir 9095","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9123","9096  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ،         {      وَكَأَيِّنْ مِنْ نَبِيٍّ قَاتَلَ مَعَهُ رِبِّيُّونَ كَثِيرٌ         }      ، قَالَ : "" أُلُوفٌ  ""  .","","Al-Mu'jam al-Kabir 9096","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9124","9097  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ :         {      وَهَدَيْنَاهُ النَّجْدَيْنِ         }      قَالَ : ""  سَبِيلُ  الْخَيْرِ وَالشَّرِّ  ""  .","","Al-Mu'jam al-Kabir 9097","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9125","9098  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  شَرِيكٌ ،  عَنِ  السُّدِّيِّ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّهُ : سُئِلَ عَنِ  السُّحْتِ  ؟         [9/226]      قَالَ : "" الرِّشَا  ، قِيلَ : فِي الْحُكْمِ ، قَالَ : "" ذَاكَ الْكُفْرُ ""  .","","Al-Mu'jam al-Kabir 9098","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن السدي الكبير عن شريك بن عبد الله بن أبي نمر الكناني عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9126","9099  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  السُّحْتُ  الرِّشْوَةُ فِي الدِّينِ  ""  .","","Al-Mu'jam al-Kabir 9099","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9127","9100  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  حَمَّادُ بْنُ يَحْيَى الْأَبَحُّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  الرِّشْوَةُ فِي الْحُكْمِ كُفْرٌ  ، وَهِيَ بَيْنَ النَّاسِ  سُحْتٌ  ""  .","","Al-Mu'jam al-Kabir 9100","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن حماد الأبح عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9128","9101  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  حَكِيمِ بْنِ جُبَيْرٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  مَسْرُوقٍ ، قَالَ :  سَأَلْتُ  ابْنَ مَسْعُودٍ ، عَنِ الرِّشَا فِي الْحُكْمِ ؟ قَالَ : "" ذَلِكَ الْكُفْرُ  ""  .","","Al-Mu'jam al-Kabir 9101","","عبد الله بن مسعود عن مسروق بن الأجدع عن سالم بن أبي الجعد الغطفاني عن حكيم بن جبير الأسدي عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9129","9102  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنِ  السُّدِّيِّ ،  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ ، قَالُوا :         {      رَبَّنَا مَنْ قَدَّمَ لَنَا هَذَا فَزِدْهُ عَذَابًا ضِعْفًا فِي النَّارِ         }      قَالَ : "" أَفَاعِي وَحَيَّاتٌ  "" .","","Al-Mu'jam al-Kabir 9102","","عبد الله بن مسعود عن مرة بن شراحيل عن السدي الكبير عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9130","9103  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      زِدْنَاهُمْ عَذَابًا فَوْقَ الْعَذَابِ         }      قَالَ :  زِيدُوا عَقَارِبَ ،أَنْيَابُهَا كَالنَّخْلِ الطِّوَالِ  "" .","","Al-Mu'jam al-Kabir 9103","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9131","9104  -  حَدَّثَنَا  أَبُو يَزِيدَ الطَّيَالِسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ عِيسَى ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  فِي قَوْلِهِ :         {      زِدْنَاهُمْ عَذَابًا فَوْقَ الْعَذَابِ         }      ، قَالَ :  عَقَارِبُ أَنْيَابُهَا كَالنَّخْلِ         [9/227]      الطِّوَالِ  "" .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( أبو يزيد القراطيسي )","","Al-Mu'jam al-Kabir 9104","","عبد الله بن مسعود عن مسروق بن الأجدع عن عبد الله بن مرة الخارفي عن الأعمش عن يحيى بن عيسى النهشلي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","باب"
"9132","9105  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ ،  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ، أَوْ مُسْلِمٍ -  شَكَّ  سُفْيَانُ  -  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 9105","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن سفيان بن عيينة عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9133","9106  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  فِي قَوْلِهِ تَبَارَكَ وَتَعَالَى :         {      فَسَوْفَ يَلْقَوْنَ غَيًّا         }      ، قَالَ : "" وَادٍ فِي  جَهَنَّمَ  "" .","","Al-Mu'jam al-Kabir 9106","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","باب"
"9134","9107  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ  ،         {      فَسَوْفَ يَلْقَوْنَ غَيًّا         }      . قَالَ : "" نَهَرٌ فِي  جَهَنَّمَ  "" .","","Al-Mu'jam al-Kabir 9107","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن قيس بن الربيع الأسدي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","باب"
"9135","9108  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  الْغَيُّ نَهَرٌ فِي  جَهَنَّمَ  يُقْذَفُ فِيهِ الَّذِينَ اتَّبَعُوا الشَّهَوَاتِ  "" .","","Al-Mu'jam al-Kabir 9108","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","باب"
"9136","9109  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ  ،         {      فَسَوْفَ يَلْقَوْنَ غَيًّا         }      ، قَالَ : "" وَادٍ فِي  جَهَنَّمَ  مِنْ  قَيْحٍ  ""  .","","Al-Mu'jam al-Kabir 9109","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9137","9110  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ  ،         {      فَسَوْفَ يَلْقَوْنَ غَيًّا         }      ، قَالَ : "" نَهَرٌ فِي  جَهَنَّمَ  وَوَادٍ فِي  جَهَنَّمَ  "" .","","Al-Mu'jam al-Kabir 9110","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن سفيان الثوري عن محمد بن كثير العبدي عن الفضل بن الحباب الجمحي عن الطبراني","باب"
"9138","9111  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ  ، ثَنَا  سَعِيدُ بْنُ عَامِرٍ الضُّبَعِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ  ،  فِي قَوْلِهِ :         {      فَسَوْفَ يَلْقَوْنَ غَيًّا         }      ، قَالَ : "" وَادٍ فِي  جَهَنَّمَ  بَعِيدُ الْقَعْرِ ، خَبِيثُ الْمَطْعَمِ  "" .","","Al-Mu'jam al-Kabir 9111","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن سعيد بن عامر الضبعي عن محمد بن يحيى بن المنذر القزاز عن الطبراني","باب"
"9139","9112  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  مَرْوَانُ بْنُ         [9/228]      مُعَاوِيَةَ ،  عَنِ  الْعَلَاءِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ  ، قَالَ :  هُوَ نَهَرٌ فِي النَّارِ يُقَالُ لَهُ : غَيٌّ  "" .","","Al-Mu'jam al-Kabir 9112","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن علاء بن المسيب عن مروان بن معاوية الفزاري عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","باب"
"9140","9113  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  خَلَفُ بْنُ خَلِيفَةَ ،  عَنِ  الْعَلَاءِ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ  ،  فِي قَوْلِهِ :         {      فَسَوْفَ يَلْقَوْنَ غَيًّا         }      قَالَ : "" نَهَرٌ فِي  جَهَنَّمَ  ، يُقَالُ لَهُ : غَيٌّ  "" .","","Al-Mu'jam al-Kabir 9113","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن المسيب بن رافع الكاهلي عن علاء بن المسيب عن خلف بن خليفة الأشجعي عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9141","9114  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  ذَرٍّ ،  عَنْ  وَائِلِ بْنِ مَهَانَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  وَيْلٌ وَادٍ فِي  جَهَنَّمَ  مِنْ  قَيْحٍ  "" .","","Al-Mu'jam al-Kabir 9114","","عبد الله بن مسعود عن وائل بن مهانة الحضرمي عن ذر بن عبد الله المرهبي عن الأعمش عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9142","9115  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ،         {      وَلا يُبْدِينَ زِينَتَهُنَّ إِلا مَا ظَهَرَ مِنْهَا         }      قَالَ : "" الثِّيَابُ  .","","Al-Mu'jam al-Kabir 9115","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9143","9116  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ،         {      وَلا يُبْدِينَ زِينَتَهُنَّ إِلا مَا ظَهَرَ مِنْهَا         }      قَالَ :  الزِّينَةُ  الْقُرْطُ  ،  وَالدُّمْلُجُ  ، وَالْخَلْخَالُ ، وَالْقِلَادَةُ  .","","Al-Mu'jam al-Kabir 9116","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9144","9117  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  حُدَيْجُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ،  فِي قَوْلِهِ :         {      وَلا يُبْدِينَ زِينَتَهُنَّ         }      قَالَ :  الزِّينَةُ السِّوَارُ ،  وَالدُّمْلُجُ  ، وَالْخَلْخَالُ ، وَالْأَدَبُ ،  وَالْقُرْطُ  ، وَالْقِلَادَةُ  وَمَا ظَهَرَ هِيَ الثِّيَابُ ، وَالْجِلْبَابُ  ""  .","","Al-Mu'jam al-Kabir 9117","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن حديج بن معاوية بن حديج  الجعفي عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9145","9118  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ،         {      فَرَدُّوا أَيْدِيَهُمْ فِي أَفْوَاهِهِمْ         }      قَالَ : "" عَضُّوهَا  .","","Al-Mu'jam al-Kabir 9118","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9146","[9/229]      9119  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ،  فِي قَوْلِهِ :         {      فَرَدُّوا أَيْدِيَهُمْ فِي أَفْوَاهِهِمْ         }      قَالَ : "" عَضُّوا أَصَابِعَهُمْ  غَيْظًا  ""  .","","Al-Mu'jam al-Kabir 9119","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9147","9120  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  وَكِيعٌ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ،  فِي قَوْلِهِ :         {      وَإِنْ مِنْكُمْ إِلا وَارِدُهَا         }      قَالَ : "" الصِّرَاطُ  ""  .","","Al-Mu'jam al-Kabir 9120","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن وكيع بن الجراح عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","باب"
"9148","9121  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ  ، ثَنَا  سَعِيدُ بْنُ عَامِرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ،  فِي قَوْلِهِ :         {      تَلْفَحُ وُجُوهَهُمُ النَّارُ وَهُمْ فِيهَا كَالِحُونَ         }      قَالَ :  أَلَمْ تَنْظُرْ إِلَى الرُّءُوسِ مُتَشَيِّطَةً قَدْ بَدَتْ أَسْنَانُهُمْ ، وَقَلَصَتْ شِفَاهُهُمْ  ""  .","","Al-Mu'jam al-Kabir 9121","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن سعيد بن عامر الضبعي عن محمد بن يحيى بن المنذر القزاز عن الطبراني","باب"
"9149","9122  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  يَزِيدُ بْنُ عَطَاءٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  شَقِيقِ بْنِ سَلَمَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ،  أَنَّهُ : سُئِلَ عَنْ هَذِهِ الْآيَةِ :         {      سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ         }      قَالَ :  يُطَوَّقُ  شُجَاعًا  أَقْرَعَ  يَنْقُرُ رَأْسَهُ  ""  .","","Al-Mu'jam al-Kabir 9122","","عبد الله بن مسعود عن شقيق بن سلمة عن أبو إسحاق السبيعي عن يزيد بن عطاء بن يزيد اليشكري عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","باب"
"9150","9123  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  مَنْ كَانَ لَهُ مَالٌ لَمْ يُؤَدِّ زَكَاتَهُ طُوِّقَهُ يَوْمَ الْقِيَامَةِ  شُجَاعًا  أَقْرَعَ  يَنْقُرُ رَأْسَهُ يَقُولُ : أَنَا مَالُكَ الَّذِي كُنْتَ تَبْخَلُ بِهِ         {      سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ         }      .","","Al-Mu'jam al-Kabir 9123","","عبد الله بن مسعود عن شقيق بن سلمة عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","باب"
"9151","9124  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي وَائِلٍ ،  عَنِ  ابْنِ مَسْعُودٍ :         {      سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ         }      ، قَالَ :  يَجِيءُ مَالُهُ ثُعْبَانًا يَنْقُرُ رَأْسَهُ  ،         [9/230]      فَيَقُولُ : أَنَا مَالُكَ الَّذِي بَخِلْتَ بِهِ فَيُطَوَّقُ بِهِ  ""  .","","Al-Mu'jam al-Kabir 9124","","عبد الله بن مسعود عن شقيق بن سلمة عن أبو إسحاق السبيعي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9152","9125  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  الْحَسَنُ بْنُ الرَّبِيعِ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ،  فِي قَوْلِ اللهِ عَزَّ وَجَلَّ :         {      سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ         }      قَالَ :  يُطَوَّقُ  شُجَاعًا  أَقْرَعَ  بِفِيهِ  زَبِيبَتَانِ  يَنْقُرُ رَأْسَهُ  فَيَقُولُ : مَا لِي وَلَكَ فَيَقُولُ : أَنَا مَالُكَ الَّذِي بَخِلْتَ بِهِ  "" .","","Al-Mu'jam al-Kabir 9125","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن سلام بن سليم الحنفي عن الحسن بن الربيع البوراني عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9153","9126  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  حَكِيمِ بْنِ جُبَيْرٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  مَسْرُوقٍ ، قَالَ :  سَأَلْنَا  عَبْدَ اللهِ بْنَ مَسْعُودٍ عَنْ قَوْلِهِ :         {      سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ         }      قَالَ :  شُجَاعٌ يَنْهَشُ لِهْزِمَتَهُ  "" .","","Al-Mu'jam al-Kabir 9126","","عبد الله بن مسعود عن مسروق بن الأجدع عن سالم بن أبي الجعد الغطفاني عن حكيم بن جبير الأسدي عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"9154","9127  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، قَالَ :  سَمِعْتُ  أَبَا عُبَيْدَةَ بْنَ عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  يَقُولُ  :  كَانَ عَبْدُ اللهِ بْنُ مَسْعُودٍ يُصَلِّي الْمَغْرِبَ حِينَ تَغْرُبُ حَاجِبُ الشَّمْسِ  ، ثُمَّ يَحْلِفُ أَنَّهُ الْوَقْتُ الَّذِي قَالَ اللهُ عَزَّ وَجَلَّ :         {      أَقِمِ الصَّلاةَ لِدُلُوكِ الشَّمْسِ         }      ""  .","","Al-Mu'jam al-Kabir 9127","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9155","9128  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  دُلُوكُ  الشَّمْسِ غُرُوبُهَا  ، تَقُولُ الْعَرَبُ : إِذَا غَرَبَتِ الشَّمْسُ ، إِذَا دَلَكَتِ الشَّمْسُ  بَرَاحٌ  "" .","","Al-Mu'jam al-Kabir 9128","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9156","9129  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسٌ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  دُلُوكُهَا  غُرُوبُهَا  ""  .","","Al-Mu'jam al-Kabir 9129","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9157","9130  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  شَقِيقِ بْنِ سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  دُلُوكُ  الشَّمْسِ غُرُوبُهَا  ""  .","","Al-Mu'jam al-Kabir 9130","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9158","[9/231]      9131  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ  قَالَ  :  صَلَّى عَبْدُ اللهِ الْمَغْرِبَ ، فَلَمَّا انْصَرَفَ جَعَلْنَا نَلْتَفِتُ ، فَقَالَ : "" مَا لَكُمْ تَلْتَفِتُونَ ؟ "" قُلْنَا : نَرَى أَنَّ الشَّمْسَ طَالِعَةٌ ، فَقَالَ :  هَذَا وَاللهِ الَّذِي لَا إِلَهَ إِلَّا هُوَ مِيقَاتُ هَذِهِ الصَّلَاةِ  ، ثُمَّ قَرَأَ :         {      أَقِمِ الصَّلاةَ لِدُلُوكِ الشَّمْسِ إِلَى غَسَقِ اللَّيْلِ         }      ، فَهَذَا  دُلُوكُ  الشَّمْسِ ، وَهَذَا غَسَقُ اللَّيْلِ  ""  .","","Al-Mu'jam al-Kabir 9131","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9159","9132  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  قَالَ  :  صَلَّى عَبْدُ اللهِ ذَاتَ يَوْمٍ ، وَجَعَلَ رَجُلٌ يَنْظُرُ هَلْ غَابَتِ الشَّمْسُ ، فَقَالَ  عَبْدُ اللهِ  :  مَا تَنْظُرُونَ ؟ هَذَا وَاللهِ الَّذِي لَا إِلَهَ غَيْرُهُ مِيقَاتُ هَذِهِ الصَّلَاةِ  يَقُولُ اللهُ عَزَّ وَجَلَّ :         {      أَقِمِ الصَّلاةَ لِدُلُوكِ الشَّمْسِ إِلَى غَسَقِ اللَّيْلِ         }      ، فَهَذَا  دُلُوكُ  الشَّمْسِ ، وَهَذَا غَسَقُ اللَّيْلِ  ""  .","","Al-Mu'jam al-Kabir 9132","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن أبو معاوية الضرير عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9160","9133  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  هُشَيْمٌ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  عَمِّهِ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  قَالَ  :  كُنَّا مَعَ عَبْدِ اللهِ حِينَ سَلَّمَ ، فَقَالَ :  هَذَا وَالَّذِي لَا إِلَهَ غَيْرُهُ حَيْثُ دَلَكَتِ الشَّمْسُ ،  وَحَلَّ وَقْتُ هَذِهِ الصَّلَاةِ  ""  .","","Al-Mu'jam al-Kabir 9133","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن سليمان بن فيروز الشيباني عن هشيم بن بشير عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9161","9134  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  قَالَ  :  كُنَّا مَعَ عَبْدِ اللهِ بْنِ مَسْعُودٍ ، فَلَمَّا غَرَبَتِ الشَّمْسُ ، قَالَ :  هَذَا وَاللهِ الَّذِي لَا إِلَهَ غَيْرُهُ حَيْثُ دَلَكَتِ الشَّمْسُ  ، وَحَلَّ وَقْتُ الصَّلَاةِ  ""  .","","Al-Mu'jam al-Kabir 9134","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9162","9135  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَلْقَمَةَ ، وَالْأَسْوَدِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  دُلُوكُ  الشَّمْسِ غُرُوبُهَا  ""  .","","Al-Mu'jam al-Kabir 9135","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9163","[9/232]      9136  -  حَدَّثَنَا  الْحُسَيْنُ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  جَابِرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  دُلُوكُ  الشَّمْسِ حِينَ تَغِيبُ .  ""","","Al-Mu'jam al-Kabir 9136","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن جابر الجعفي عن الوضاح بن عبد الله اليشكري عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9164","9137  -  حَدَّثَنَا  الْحُسَيْنُ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  هُشَيْمُ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  غُرُوبُهَا  .","","Al-Mu'jam al-Kabir 9137","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9165","9138  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ :  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  وَكِيعٌ ،  عَنْ  مِسْعَرٍ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ  ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 9138","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن مسعر بن كدام عن وكيع بن الجراح عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9166","9139  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  قَالَ  : كَانَ عَبْدُ اللهِ  يَقُولُ :  يَتَدَارَكُ الْحَرَسَانِ مِنْ مَلَائِكَةِ اللهِ ، حَارِسُ اللَّيْلِ ، وَحَارِسُ النَّهَارِ  ، عِنْدَ طُلُوعِ الْفَجْرِ ، وَاقْرَءُوا إِنْ شِئْتُمْ :         {      وَقُرْآنَ الْفَجْرِ إِنَّ قُرْآنَ الْفَجْرِ كَانَ مَشْهُودًا         }      "" .","","Al-Mu'jam al-Kabir 9139","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9167","9140  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  قَالَ  :  كُنَّا مَعَ عَبْدِ اللهِ فِي طَرِيقِ  مَكَّةَ  ، فَلَمَّا غَرَبَتِ الشَّمْسُ قَالَ :  هَذَا غَسَقُ اللَّيْلِ  ، ثُمَّ أُذِّنَ ، ثُمَّ قَالَ : "" هَذَا وَاللهِ الَّذِي لَا إِلَهَ إِلَّا هُوَ وَقْتُ هَذِهِ الصَّلَاةِ  ""  .","","Al-Mu'jam al-Kabir 9140","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم بن مهاجر بن جابر البجلي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9168","9141  -  حَدَّثَنَا  الْحُسَيْنُ  ، ثَنَا  يَحْيَى ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  جَابِرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ،         {      إِلَى غَسَقِ اللَّيْلِ         }      قَالَ : "" الْعِشَاءُ الْآخِرَةُ  .","","Al-Mu'jam al-Kabir 9141","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن جابر الجعفي عن الوضاح بن عبد الله اليشكري عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9169","[9/233]      9142  -  حَدَّثَنَا  الْحُسَيْنُ  ، ثَنَا  يَحْيَى ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  جَابِرٍ ،  عَنْ  عَامِرٍ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  الْعِشَاءُ الْآخِرَةُ  ""  .","","Al-Mu'jam al-Kabir 9142","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن الشعبي عن جابر الجعفي عن الوضاح بن عبد الله اليشكري عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9170","9143  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ الْمُخَارِقِ ،  عَنْ  أَبِيهِ الْمُخَارِقِ بْنِ سُلَيْمٍ ،  عَنْ  عَبْدِ اللهِ ،         {      فَإِنَّ لَهُ مَعِيشَةً ضَنْكًا         }      قَالَ : "" عَذَابُ الْقَبْرِ  .","","Al-Mu'jam al-Kabir 9143","","عبد الله بن مسعود عن مخارق بن سليم الشيباني عن عبد الله بن مخارق بن سليم عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9171","9144  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ الْمُخَارِقِ ،  عَنْ  أَبِيهِ مُخَارِقِ بْنِ سُلَيْمٍ  : أَنَّ عَبْدَ اللهِ ، كَانَ  يَقُولُ  :  إِذَا حَدَّثْتُكُمْ بِحَدِيثٍ أَتَيْتُكُمْ بِتَصْدِيقِ ذَلِكَ مِنْ كِتَابِ اللهِ  ، إِنَّ الْعَبْدَ الْمُسْلِمَ إِذَا قَالَ : الْحَمْدُ لِلهِ ، وَسُبْحَانَ اللهِ ، وَلَا إِلَهَ إِلَّا اللهُ ، وَاللهُ أَكْبَرُ ، وَتَبَارَكَ اللهُ ، قَبَضَ عَلَيْهِنَّ مَلَكٌ ، فَجَعَلَهُنَّ تَحْتَ جَنَاحِهِ ، ثُمَّ صَعِدَ بِهِنَّ ، فَلَا يَمُرُّ عَلَى جَمْعٍ مِنَ الْمَلَائِكَةِ إِلَّا اسْتَغْفَرُوا لِقَائِلِهِنَّ ، حَتَّى يَجِيءَ بِهِنَّ وَجْهَ الرَّحْمَنِ تَعَالَى "" ، ثُمَّ قَرَأَ  عَبْدُ اللهِ :         {      إِلَيْهِ يَصْعَدُ الْكَلِمُ الطَّيِّبُ وَالْعَمَلُ الصَّالِحُ يَرْفَعُهُ         }      .","","Al-Mu'jam al-Kabir 9144","","عبد الله بن مسعود عن مخارق بن سليم الشيباني عن عبد الله بن مخارق بن سليم عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9172","9145  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ مُخَارِقِ بْنِ سُلَيْمٍ ،  عَنْ  أَبِيهِ  ،  قَالَ  عَبْدُ اللهِ :  إِذَا حَدَّثْتُكُمْ بِحَدِيثٍ أَنْبَأْتُكُمْ بِتَصْدِيقِ ذَلِكَ  ، إِنَّ الْعَبْدَ الْمُسْلِمَ إِذَا مَاتَ أُجْلِسَ فِي قَبْرِهِ ، فَيُقَالُ لَهُ : مَنْ رَبُّكَ ؟ مَا دِينُكَ ؟ مَنْ نَبِيُّكَ ؟ فَيُثَبِّتُهُ اللهُ فَيَقُولُ : رَبِّيَ اللهُ ، وَدِينِيَ الْإِسْلَامُ ، وَنَبِيِّي مُحَمَّدٌ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَيُوَسَّعُ لَهُ فِي قَبْرِهِ ، وَيُفْرَجُ لَهُ فِيهِ "" ، ثُمَّ قَرَأَ  عَبْدُ اللهِ  :         {      يُثَبِّتُ اللهُ الَّذِينَ آمَنُوا بِالْقَوْلِ الثَّابِتِ فِي الْحَيَاةِ الدُّنْيَا وَفِي الآخِرَةِ وَيُضِلُّ اللهُ الظَّالِمِينَ         }      .","","Al-Mu'jam al-Kabir 9145","","عبد الله بن مسعود عن مخارق بن سليم الشيباني عن عبد الله بن مخارق بن سليم عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","باب"
"9173","9146  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ الْمُخَارِقِ ،  عَنْ  أَبِيهِ ،  قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ :         [9/234]      إِذَا حَدَّثْنَاكُمْ بِحَدِيثٍ ، أَتَيْنَاكُمْ بِتَصْدِيقِ ذَلِكَ مِنْ كِتَابِ اللهِ  : إِنَّ  النُّطْفَةَ  تَكُونُ فِي الرَّحِمِ أَرْبَعِينَ ، ثُمَّ تَكُونُ  عَلَقَةً  أَرْبَعِينَ ، ثُمَّ تَكُونُ مُضْغَةً أَرْبَعِينَ ، فَإِذَا أَرَادَ اللهُ عَزَّ وَجَلَّ أَنْ يَخْلُقَ الْخَلْقَ نَزَلَ مَلَكٌ فَقَالَ لَهُ : اكْتُبْ ، فَيَقُولُ : يَا رَبِّ مَا أَكْتُبُ ؟ فَيَقُولُ : اكْتُبْ أَشَقِيٌّ أَمْ سَعِيدٌ ، أَذَكَرٌ أَمْ أُنْثَى ، مَا رِزْقُهُ ، مَا أَثَرُهُ ، مَا أَجَلُهُ ؟ فَيُوحِي اللهُ عَزَّ وَجَلَّ إِلَيْهِ مَا يَشَاءُ ، وَيَكْتُبُ الْمَلَكُ "" ، ثُمَّ قَرَأَ  عَبْدُ اللهِ  :         {      إِنَّا خَلَقْنَا الإِنْسَانَ مِنْ نُطْفَةٍ أَمْشَاجٍ نَبْتَلِيهِ         }      قَالَ : وَقَالَ  عَبْدُ اللهِ  : "" الْأَمْشَاجُ الْعُرُوقُ  "" .","","Al-Mu'jam al-Kabir 9146","","عبد الله بن مسعود عن مخارق بن سليم الشيباني عن عبد الله بن مخارق بن سليم عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","باب"
"9174","9147  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  عَرْفَجَةَ ،  عَنْ  عَبْدِ اللهِ  قَرَأَ هَذِهِ الْآيَةَ :         {      بَلْ تُؤْثِرُونَ الْحَيَاةَ الدُّنْيَا         }      فَقَالَ :  هَلْ تَدْرِي بِأَيِّ شَيْءٍ ابْتَدَأَ الْحَيَاةَ الدُّنْيَا ؟ لِأَيِّ شَيْءٍ آثَرَ بِالْحَيَاةِ الدُّنْيَا ؟  عُجِّلَتْ لَنَا الدُّنْيَا ، وَأُوتِينَا لَذَّتَهَا ،  وَبَهْجَتَهَا  ، وَغُيِّبَتْ عَنَّا الْآخِرَةُ ،  وَزُوِيَتْ  عَنَّا ، فَأَجَبْنَا الْعَاجِلَ ، وَتَرَكْنَا الْآجِلَ  ""  .","","Al-Mu'jam al-Kabir 9147","","عبد الله بن مسعود عن عرفجة بن عبد الله الثقفي عن عطاء بن السائب عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9175","بَابٌ  9148  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  قَالَ  :  رَأَيْتُ عَبْدَ اللهِ يَحُكُّ الْمُعَوِّذَتَيْنِ  ، وَيَقُولُ : "" لِمَ تَزِيدُونَ مَا لَيْسَ فِيهِ ؟ ""  .","","Al-Mu'jam al-Kabir 9148","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9176","9149  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  أَبُو عُمَرَ حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ  ، ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ، قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ ، أَنَّهُ :  كَانَ يَحُكُّ الْمُعَوِّذَتَيْنِ مِنْ مُصْحَفِهِ  ، فَيَقُولُ : "" أَلَا خَلَطُوا فِيهِ مَا لَيْسَ فِيهِ  "" .","","Al-Mu'jam al-Kabir 9149","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن محمد بن كثير العبدي عن محمد بن محمد بن حيان التمار عن الطبراني","باب"
"9177","[9/235]      9150  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عَلِيُّ بْنُ الْحُسَيْنِ بْنِ إِشْكَابَ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي عُبَيْدَةَ بْنِ مَعْنٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ، أَنَّهُ :  كَانَ يَحُكُّ الْمُعَوِّذَتَيْنِ مِنَ الْمُصْحَفِ  يَقُولُ : "" لَيْسَتَا مِنْ كِتَابِ اللهِ  "" .","","Al-Mu'jam al-Kabir 9150","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن الأعمش عن عبد الملك بن معن المسعودي عن محمد بن أبي عبيدة المسعودي عن علي بن الحسين بن إبراهيم العامري عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9178","9151  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مُوسَى الْحَرَشِيُّ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ الْحَسَنِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّهُ : كَانَ يَقُولُ :  لَا تَخْلِطُوا بِالْقُرْآنِ مَا لَيْسَ فِيهِ ، فَإِنَّمَا هُمَا مُعَوِّذَتَانِ  تَعَوَّذَ بِهِمَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         {      قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ         }      وَ         {      قُلْ أَعُوذُ بِرَبِّ النَّاسِ         }      ، وَكَانَ  عَبْدُ اللهِ  يَمْحُوهُمَا مِنَ الْمُصْحَفِ .","","Al-Mu'jam al-Kabir 9151","","عبد الله بن مسعود عن عبد الله بن حبيب السلمي عن أبو إسحاق السبيعي عن عبد الحميد بن الحسن الهلالي عن محمد بن موسى الحرشي عن سعيد بن عبد الرحمن التستري عن الطبراني","باب"
"9179","9152  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  الْأَزْرَقُ بْنُ عَلِيٍّ ،  ثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  عَنِ  الصَّلْتِ بْنِ بَهْرَامٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّهُ : كَانَ يَحُكُّ الْمُعَوِّذَتَيْنِ مِنَ الْمَصَاحِفِ  ، وَيَقُولُ : "" إِنَّمَا أَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يُتَعَوَّذَ بِهِمَا ، وَلَمْ يَكُنْ يَقْرَأُ بِهِمَا  .","","Al-Mu'jam al-Kabir 9152","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الصلت بن بهرام التيمي عن حسان بن إبراهيم الكرماني عن الأزرق بن علي بن مسلم الحنفي عن عبد الله بن أحمد بن حنبل عن الطبراني","باب"
"9180","9153  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  الْمَسْعُودِيُّ ،  ثَنَا  قَيْسُ بْنُ مُسْلِمٍ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ،  أَنَّ  رَجُلًا لَقِيَ رَجُلًا بِهِ خَنَازِيرُ  ، فَقَالَ : لَوْلَا أَنَّهُ قَدْ أُخِذَ عَلَيَّ لَحَدَّثْتُكَ ، فَبَلَغَ ذَلِكَ عَبْدَ اللهِ بْنَ مَسْعُودٍ ، فَلَقِيَهُ فَقَالَ : "" حَدِّثْ "" ، فَقَالَ : إِنَّهُ قَدْ أُخِذَ عَلَيَّ أَنْ لَا أُحَدِّثَ بِهِ أَحَدًا ، فَقَالَ لَهُ  عَبْدُ اللهِ  : "" إِنَّهُ لَمْ يَكُنْ يَنْبَغِي أَنْ يُأْخَذَ عَلَيْكَ ، كَفِّرْ مِنْ يَمِينِكَ وَحَدِّثْ بِهِ "" ، قَالَ : اعْمِدْ إِلَى أَبْوَالِ إِبِلِ أَرَاكٍ -  يَعْنِي تَأْكُلُ الْأَرَاكَ  - فَاطْبُخْهُ حَتَّى يَنْعَقِدَ ، ثُمَّ اشْرَبْهُ وَخُذْ وَرَقَ الْأَرَاكِ فَدُقَّهُ وَذُرَّهُ عَلَيْهِ ، قَالَ : فَفَعَلَ فَبَرَأَ  .","","Al-Mu'jam al-Kabir 9153","","عبد الله بن مسعود عن طارق بن شهاب الأحمسي عن قيس بن مسلم الجدلي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","باب"
"9181","[9/236]      9154  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  أَبُو الْعُمَيْسِ ،  عَنِ  الْقَاسِمِ ،  قَالَ  : قَالَ عَبْدُ اللهِ :  أَهْلُ الشُّرْبِ أُمَرَاءُ عَلَى أَهْلِ أَعْلَاهُ  "" .","","Al-Mu'jam al-Kabir 9154","","عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن عتبة بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","باب"
"9182","9155  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَلِيِّ بْنِ الْأَقْمَرِ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  حَافِظُوا عَلَى أَبْنَائِكُمْ فِي الصَّلَاةِ  ، وَعَوِّدُوهُمُ الْخَيْرَ فَإِنَّ الْخَيْرَ عَادَةٌ  "" .","","Al-Mu'jam al-Kabir 9155","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن علي بن الأقمر عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9183","9156  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  تَعَوَّدُوا الْخَيْرَ فَإِنَّمَا الْخَيْرُ بِالْعَادَةِ  "" .","","Al-Mu'jam al-Kabir 9156","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن عمارة بن عمير التيمي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9184","9157  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  أَبُو الْعُمَيْسِ ،  عَنْ  عِمْرَانَ بْنِ عُمَيْرٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ  عَبْدَ اللهِ ، أَعْتَقَ غُلَامًا لَهُ  ، فَقَالَ : "" أَمَا إِنَّ مَالَكَ لِي ، وَلَكِنْ قَدْ تَرَكْتُهُ لَكَ  "" .","","Al-Mu'jam al-Kabir 9157","","عبد الله بن مسعود عن عمير مولى عبد الله بن مسعود عن عمران بن عمير المسعودي عن عتبة بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","باب"
"9185","9158  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  أَخْبَرَنِي  يَحْيَى بْنُ عَمْرِو بْنِ سَلِمَةَ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ سَمِعَ  عَبْدَ اللهِ ، يَقُولُ :  لَأَنْ  أُجَهِّزَ  سَوْطًا فِي  سَبِيلِ  اللهِ أَحَبُّ إِلَيَّ مِنْ حَجَّةٍ  بَعْدَ حَجَّةِ الْإِسْلَامِ  "" .","","Al-Mu'jam al-Kabir 9158","","عبد الله بن مسعود عن عمرو بن سلمة بن الحارث الهمداني عن يحيى بن عمرو بن سلمة بن الحارث الهمداني عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","باب"
"9186","9159  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْعَيْزَارِ بْنِ حُرَيْثٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  تَدُورُ رَحَى الْإِسْلَامِ عَلَى رَأْسِ خَمْسٍ وَثَلَاثِينَ ،  ثُمَّ يَحْدُثُ حَدَثٌ عَظِيمٌ ، فَإِنْ كَانَ فِيهِ هَلَكَتُهُمْ  فَبِالْحَرِيِّ  ، وَإِلَّا تَرَاخَى عَلَيْهِمْ سَبْعِينَ         [9/237]      سَنَةً ، فَمَنْ أَدْرَكَ ذَلِكَ رَأَى مَا يُنْكِرُهُ ""  .  هَكَذَا رَوَاهُ  أَبُو الْأَحْوَصِ  مَوْقُوفًا  ،  وَرَفَعَهُ  مَسْرُوقٌ  ،  وَعَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ  ،  وَالْبَرَاءُ بْنُ نَاجِيَةَ  .","","Al-Mu'jam al-Kabir 9159","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن العيزار بن حريث العبدي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن عثمان بن عمر الضبي عن الطبراني","باب"
"9187","9160  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ، أَوِ ابْنِ يَزِيدَ  ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِنَّ الرَّجُلَ لَيَتَكَلَّمُ بِالْكَلِمَةِ يُضْحِكُ بِهَا جُلَسَاءَهُ مَا يَنْقَلِبُ إِلَى أَهْلِهِ مِنْهَا بِشَيْءٍ  ، نَزَلَ بِهَا أَبْعَدَ مِنَ السَّمَاءِ إِلَى الْأَرْضِ  "" .","","Al-Mu'jam al-Kabir 9160","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن عثمان بن عمر الضبي عن الطبراني","باب"
"9188","9161  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  أَبِي عَوْنٍ ،  عَنِ  الْقَاسِمِ ،  أَنَّ  رَجُلًا اسْتَأْذَنَ وَرَثَتَهُ أَنْ يُوصِيَ بِأَكْثَرَ مِنِ الثُّلُثِ  ، فَأَذِنُوا لَهُ ، ثُمَّ رَجَعُوا فِيهِ بَعْدَ مَا مَاتَ ، فَسُئِلَ عَبْدُ اللهِ عَنْ ذَلِكَ ، فَقَالَ : "" ذَاكَ النُّكْرَةُ ، لَا يَجُوزُ ""  .","","Al-Mu'jam al-Kabir 9161","","عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن عبد الله بن عون بن أرطبان عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9189","9162  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  أَبُو الْعُمَيْسِ ،  عَنْ  أَبِي عَوْنٍ ،  عَنِ  الْقَاسِمِ ،  عَنْ  عَبْدِ اللهِ ،  فِي الرَّجُلِ يُوصِي بِالْوَصِيَّةِ فَيَطِيبُ الْوَرَثَةُ  ، ثُمَّ يَرْجِعُونَ ، قَالَ  عَبْدُ اللهِ  : "" ذَاكَ النُّكْرَةُ ، لَا يَجُوزُ  "" .","","Al-Mu'jam al-Kabir 9162","","عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن عبد الله بن عون بن أرطبان عن عتبة بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","باب"
"9190","9163  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  الثَّوْرِيُّ ،  عَنْ  قَيْسِ بْنِ مُسْلِمٍ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَمْ يُنْزِلْ دَاءً إِلَّا وَقَدْ أَنْزَلَ مَعَهُ دَوَاءً  ، فَعَلَيْكُمْ بِأَلْبَانِ الْبَقَرِ فَإِنَّهَا  تَرُمُّ  مِنَ الشَّجَرِ كُلِّهِ  "" .","","Al-Mu'jam al-Kabir 9163","","عبد الله بن مسعود عن طارق بن شهاب الأحمسي عن قيس بن مسلم الجدلي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9191","[9/238]      9164  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  قَيْسِ بْنِ مُسْلِمٍ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ،  قَالَ  : قَالَ عَبْدُ اللهِ :  لَمْ يُنْزِلِ اللهُ دَاءً إِلَّا أَنْزَلَ لَهُ شِفَاءً إِلَّا  الْهَرَمَ  ، فَعَلَيْكُمْ بِأَلْبَانِ الْبَقَرِ فَإِنَّهَا  تَرُمُّ  مِنَ الشَّجَرِ كُلِّهِ  "" .","","Al-Mu'jam al-Kabir 9164","","عبد الله بن مسعود عن طارق بن شهاب الأحمسي عن قيس بن مسلم الجدلي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9192","9165  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ،  قَالَ  :  كَانَ عَبْدُ اللهِ لَا يَقْنُتُ فِي شَيْءٍ مِنَ الصَّلَوَاتِ  إِلَّا فِي  الْوِتْرِ  قَبْلَ الرَّكْعَةِ  "" .","","Al-Mu'jam al-Kabir 9165","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9193","9166  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  أَبُو الْعُمَيْسِ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ،  قَالَ  :  كَانَ عَبْدُ اللهِ ، لَا يَقْنُتُ فِي صَلَاةِ الْغَدَاةِ  ، وَإِذَا قَنَتَ فِي  الْوِتْرِ  قَنَتَ قَبْلَ الرَّكْعَةِ  "" .","","Al-Mu'jam al-Kabir 9166","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن عتبة بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","باب"
"9194","9167  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَلِيِّ بْنِ الْأَقْمَرِ ،  عَنْ  رَجُلَيْنِ مِنْ أَصْحَابِ عَبْدِ اللهِ ،  أَنَّهُمَا كَانَا يُدْنِيَانِ رُءُوسَهُمَا مِنْ عَبْدِ اللهِ لِيَسْمَعَانِ مَا يَقُولُ فِي سُجُودِهِ  ، قَالَ أَحَدُهُمَا :  سَمِعْتُهُ  يَقُولُ : "" سُبْحَانَكَ لَا إِلَهَ غَيْرُكَ "" ، وَقَالَ الْآخَرُ : سَمِعْتُهُ يَقُولُ : "" سُبْحَانَكَ لَا رَبَّ غَيْرُكَ ""  .","","Al-Mu'jam al-Kabir 9167","","عبد الله بن مسعود عن رجلان من أصحاب عبد الله عن علي بن الأقمر عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9195","9168  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  مَالِكِ بْنِ  أَسْمَاءَ بْنِ خَارِجَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ ، يَقُولُ :  إِنَّ ذَا اللِّسَانَيْنِ فِي الدُّنْيَا لَهُ لِسَانَانِ مِنْ نَارٍ يَوْمَ الْقِيَامَةِ  "" .  في طبعة مكتبة ابن تيمية : ( مالك عن أسماء بن خارجة ) والمثبت من الظاهرية ( 1 )","","Al-Mu'jam al-Kabir 9168","","عبد الله بن مسعود عن أسماء بن خارجة بن حصن عن مالك بن أسماء بن خارجة عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9196","9169  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  أَبِي عُبَيْدَةَ ، قَالَ :  قَالَ  عَبْدُ اللهِ  :  سَارِعُوا إِلَى الْجُمَعِ فَإِنَّ اللهَ عَزَّ وَجَلَّ يَبْرُزُ إِلَى أَهْلِ الْجَنَّةِ فِي كُلِّ جُمُعَةٍ فِي كَثِيبٍ مِنْ كَافُورٍ  ، فَيَكُونُوا مِنَ الْقُرْبِ عَلَى قَدْرِ تَسَارُعِهِمْ إِلَى الْجُمُعَةِ ، فَيُحْدِثُ اللهُ عَزَّ وَجَلَّ         [9/239]      لَهُمْ مِنَ الْكَرَامَةِ شَيْئًا لَمْ يَكُونُوا رَأَوْهُ قَبْلَ ذَلِكَ ، ثُمَّ يَرْجِعُونَ إِلَى أَهْلِيهِمْ فَيُحَدِّثُونَهُمْ بِمَا أَحْدَثَ اللهُ لَهُمْ "" قَالَ : ثُمَّ دَخَلَ عَبْدُ اللهِ الْمَسْجِدَ فَإِذَا هُوَ بِرَجُلَيْنِ يَوْمَ الْجُمُعَةِ قَدْ سَبَقَاهُ ، فَقَالَ  عَبْدُ اللهِ  : "" رَجُلَانِ وَأَنَا الثَّالِثُ ، إِنْ شَاءَ اللهُ أَنْ يُبَارِكَ فِي الثَّالِثِ ""  .","","Al-Mu'jam al-Kabir 9169","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن المنهال بن عمرو الأسدي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9197","9170  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  نا  أَبُو نُعَيْمٍ  ، ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  أَبِي حَصِينٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بَابَاهُ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  مَا يَهْزَأُ امْرُؤٌ مُسْلِمٌ عَلَى أَيِّ حَالٍ أَصْبَحَ عَلَيْهَا مِنَ الدُّنْيَا وَأَمْسَى  ، أَنْ لَا يَكُونَ حَزَازَةٌ فِي نَفْسِهِ  "" .  سقط من طبعة مكتبة ابن تيمية والمثبت من نسخة الظاهرية ( 1 ).","","Al-Mu'jam al-Kabir 9170","","عبد الله بن مسعود عن عبد الله بن باباه البصري عن عثمان بن عاصم بن حصين عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9198","9171  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  أَبِي حَصِينٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بَابَاهُ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  لَأَنْ  يَعَضَّ  أَحَدُكُمْ عَلَى جَمْرَةٍ حَتَّى تَبْرُدَ  ، أَوْ يُمْسِكَ عَلَيْهَا حَتَّى تَبْرُدَ ، خَيْرٌ مِنْ أَنْ يَقُولَ لِأَمْرٍ قَضَاهُ اللهُ لَيْتَهُ لَمْ يَكُنْ  "" .","","Al-Mu'jam al-Kabir 9171","","عبد الله بن مسعود عن عبد الله بن باباه البصري عن عثمان بن عاصم بن حصين عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9199","9172  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  أَبِي حَصِينٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بَابَاهُ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  لَوْ عَلِمْتُ أَنَّهُ لَمْ يَبْقَ مِنْ أَجَلِي إِلَّا عَشْرُ لَيَالٍ  لَأَحْبَبْتُ أَنْ لَا يُفَارِقَنِي فِيهِنَّ امْرَأَةٌ  "" .","","Al-Mu'jam al-Kabir 9172","","عبد الله بن مسعود عن عبد الله بن باباه البصري عن عثمان بن عاصم بن حصين عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9200","9173  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  أَبِي الْحُسَيْنِ يَعْنِي زِيَادَ بْنَ فَيَّاضٍ ،  عَنْ  تَمِيمِ بْنِ سَلَمَةَ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  مَا يَأْمَنُ الَّذِي يَرْفَعُ رَأْسَهُ قَبْلَ أَنْ يَرْفَعَ الْإِمَامُ رَأْسَهُ أَنْ يَعُودَ رَأْسُهُ رَأْسَ كَلْبٍ  ، وَلَيَنْتَهِيَنَّ أَقْوَامٌ يَرْفَعُونَ أَبْصَارَهُمْ إِلَى السَّمَاءِ أَوْ  لَيُخْطَفَنَّ  أَبْصَارُهُمْ  "" .","","Al-Mu'jam al-Kabir 9173","","عبد الله بن مسعود عن تميم بن سلمة السلمي عن زياد بن فياض الخزاعي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9201","9174  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٍ ،  عَنْ  زِيَادِ بْنِ فَيَّاضٍ ،  عَنْ  تَمِيمِ بْنِ سَلَمَةَ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  مَا يَأْمَنُ أَحَدُكُمْ أَنْ يَرْفَعَ رَأْسَهُ         [9/240]      فِي الصَّلَاةِ قَبْلَ الْإِمَامِ  أَنْ يَعُودَ رَأْسُهُ رَأْسَ كَلْبٍ ، وَلَيَنْتَهِيَنَّ أَقْوَامٌ يَرْفَعُونَ أَبْصَارَهُمْ فِي الصَّلَاةِ أَوْ لَا تَرْجِعُ إِلَيْهِمْ  "" .","","Al-Mu'jam al-Kabir 9174","","عبد الله بن مسعود عن تميم بن سلمة السلمي عن زياد بن فياض الخزاعي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9202","9175  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  زِيَادِ بْنِ فَيَّاضٍ ،  عَنْ  تَمِيمِ بْنِ سَلَمَةَ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  مَا يُؤَمِّنُ الرَّجُلَ إِذَا رَفَعَ رَأْسَهُ قَبْلَ الْإِمَامِ  أَنْ يَعُودَ رَأْسُهُ رَأْسَ كَلْبٍ ، لَيَنْتَهِيَنَّ أَقْوَامٌ يَرْفَعُونَ أَبْصَارَهُمْ إِلَى السَّمَاءِ أَوْ لَا تَرْجِعُ إِلَيْهِمْ  "" .","","Al-Mu'jam al-Kabir 9175","","عبد الله بن مسعود عن تميم بن سلمة السلمي عن زياد بن فياض الخزاعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9203","9176  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  سُلَيْمَانَ بْنِ مِينَا ،  عَنْ  نُفَيْعٍ مَوْلَى عَبْدِ اللهِ ،  قَالَ  :  كَانَ عَبْدُ اللهِ مِنْ أَجْوَدِ النَّاسِ ثَوْبًا أَبْيَضَ ،  وَمِنْ أَطْيَبِ النَّاسِ رِيحًا  "" .","","Al-Mu'jam al-Kabir 9176","","عبد الله بن مسعود عن نفيع مولى عبد الله بن مسعود عن سليمان بن مينا الكوفي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9204","9177  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  حُمَيْدُ بْنُ عَبْدِ اللهِ بْنِ الْأَصَمِّ ، قَالَ :  سَمِعْتُ  أَبَا قَيْسٍ الْأَوْدِيَّ ،  قَالَ  :  كَانَ عَبْدُ اللهِ يُعْجِبُهُ الطِّيبُ  "" .","","Al-Mu'jam al-Kabir 9177","","عبد الله بن مسعود عن عبد الرحمن بن ثروان الأودي عن حميد بن عبد الله الأصم عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9205","9178  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  حُمَيْدُ بْنُ عَبْدِ اللهِ بْنِ الْأَصَمِّ ،  عَنْ  أَبِي قَيْسٍ ،  قَالَ  :  دَخَلَ عَبْدُ اللهِ يَوْمَ الْجُمُعَةِ الْمَسْجِدَ وَعَلَيْهِ ثِيَابٌ بِيضٌ نَقَاءٌ حِسَانٌ  ، فَنَظَرَ إِلَى مَكَانٍ فِيهِ سَعَةٌ فَجَلَسَ ، وَلَمْ  يَتَخَطَّ  أَحَدًا ، قَالَ : وَخَرَجَ الْإِمَامُ فَإِذَا رَجُلَانِ يَتَكَلَّمَانِ ، فَأَخَذَ مِنَ الْحَصَا فَرَمَاهُمَا ، فَنَظَرَا إِلَيْهِ فَسَكَتَا ، فَلَمَّا نَزَلَ الْإِمَامُ قَالَ : "" أَلَمْ تَعَلْمَا أَنَّكُمَا فِي صَلَاةٍ ""  .","","Al-Mu'jam al-Kabir 9178","","عبد الله بن مسعود عن عبد الرحمن بن ثروان الأودي عن حميد بن عبد الله الأصم عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9206","9179  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي حَصِينٍ ،  عَنِ  الْقَاسِمِ ،  عَنْ  مَسْرُوقٍ ،  قَالَ  :  كَرِهَ عَبْدُ اللهِ لِقَاضِي الْمُسْلِمِينَ أَنْ يَأْخُذَ عَلَيْهِ رِزْقًا  وَلِصَاحِبِ مَغَانِمِهِمْ  "" .","","Al-Mu'jam al-Kabir 9179","","عبد الله بن مسعود عن مسروق بن الأجدع عن القاسم بن عبد الرحمن المسعودي عن عثمان بن عاصم بن حصين عن شريك بن عبد الله النخعي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9207","9180  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  دَلْهَمُ بْنُ صَالِحٍ ،         [9/241]      حَدَّثَنِي  حُمَيْدُ بْنُ عَبْدِ اللهِ الثَّقَفِيُّ :  أَنَّ  عَلْقَمَةَ بْنَ قَيْسٍ  اسْتَقْرَضَ مِنْ عَبْدِ اللهِ أَلْفَ دِرْهَمٍ فَأَقْرَضَهُ إِيَّاهَا ، فَلَمَّا خَرَجَ الْعَطَاءُ جَاءَهُ بِأَلْفِ دِرْهَمٍ ، فَقَالَ : هَذَا مَالُكَ ، قَالَ : "" هَاتِهِ "" ، فَأَخَذَهُ فَقَالَ لَهُ  عَبْدُ اللهِ  : "" لَوْلَا كَرَاهِيَةُ أَنْ أُخَالِفَكَ لَأَمْسَكْتُ الْمَالَ "" ، فَقَالَ  عَبْدُ اللهِ  : "" نَحْنُ أَحَقُّ بِهِ "" فَجَلَسَ يَتَحَدَّثُ سَاعَةً ، ثُمَّ قَامَ فَانْطَلَقَ  عَلْقَمَةُ  فَلَمَّا بَلَغَ أَصْحَابَ التَّوَابِيتِ أَرْسَلَ عَلَى أَثَرِهِ فَرَدَّهُ ، فَقَالَ : "" مُحْتَاجٌ أَنْتَ ؟ "" قَالَ : نَعَمْ ، قَالَ : "" خُذِ الْمَالَ "" ، فَلَمَّا أَخَذَهُ قَالَ  عَبْدُ اللهِ  :  لَأَنْ أُقْرِضَ مَالًا مَرَّتَيْنِ أَحَبُّ إِلَيَّ مِنْ أَنْ أَتَصَدَّقَ بِهِ مَرَّةً  "" .","","Al-Mu'jam al-Kabir 9180","","عبد الله بن مسعود عن حميد بن عبد الله الثقفي عن دلهم بن صالح الكندي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9208","9181  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عُمَرُ بْنُ ذَرٍّ ،  حَدَّثَنِي  مُجَاهِدٌ ،  أَنَّ  عَبْدَ اللهِ بْنَ مَسْعُودٍ ، بَعَثَ مَعَ رَجُلٍ بِبَدَنَةٍ  ، فَقَالَ : كَيْفَ أَصْنَعُ بِهَا ؟ قَالَ : "" كُلْ أَنْتَ ، وَأَصْحَابُكَ ثُلُثًا ، وَابْعَثْ إِلَى أَعْرَابِنَا ثُلُثًا ، وَتَصَدَّقْ بِثُلُثٍ  "" .","","Al-Mu'jam al-Kabir 9181","","عبد الله بن مسعود عن مجاهد بن جبر المخزومي عن عمر بن ذر عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9209","9182  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مُطِيعٌ الْغَزَّالُ ،  عَنِ  الْحَكَمِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِذَا وَهِمَ أَحَدُكُمْ فِي صَلَاتِهِ  فَلْيَتَحَرَّ  الصَّوَابَ فِي نَفْسِهِ ،  فَلْيُتِمَّ عَلَيْهِ ، ثُمَّ يَسْجُدْ سَجْدَتَيْنِ بَعْدَ التَّسْلِيمِ ، وَهُوَ جَالِسٌ ""  .","","Al-Mu'jam al-Kabir 9182","","عبد الله بن مسعود عن شقيق بن سلمة عن الحكم بن عتيبة الكندي عن مطيع بن عبد الله الغزال عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9210","9183  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنِ  الْحَكَمِ ،  عَنْ  أَبِي وَائِلٍ ،  قَالَ  : قَالَ عَبْدُ اللهِ :  مَنْ شَكَّ أَوْ وَهِمَ فِي صَلَاتِهِ  فَلْيَتَحَرَّ  ثُمَّ يَسْجُدْ سَجْدَتَيْنِ  "" .","","Al-Mu'jam al-Kabir 9183","","عبد الله بن مسعود عن شقيق بن سلمة عن الحكم بن عتيبة الكندي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9211","9184  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عِيسَى بْنُ عَبْدِ الرَّحْمَنِ السُّلَمِيُّ ، قَالَ :  سَمِعْتُ  مَالِكًا ،  سَأَلَ  الشَّعْبِيَّ عَنِ  التَّشَهُّدِ  ؟  فَقَالَ  :  كَانَ ابْنُ مَسْعُودٍ يَقُولُ بَعْدَ السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ  ، وَرَحْمَةُ اللهِ : "" السَّلَامُ عَلَيْنَا مِنْ رَبِّنَا  "" .","","Al-Mu'jam al-Kabir 9184","","عبد الله بن مسعود عن الشعبي عن مالك بن أنس عن عيسى بن عبد الرحمن السلمي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9212","9185  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عِيسَى بْنُ         [9/242]      عَبْدِ الرَّحْمَنِ السُّلَمِيُّ ،  قَالَ  :  سَأَلْتُ  الْحَسَنَ ، عَنِ النَّبِيذِ ؟ فَقَالَ : لَا أَشْرَبُ إِلَّا فِي شَيْءٍ مُوَكًّا  ، فَقَالَ ابْنُهُ :  أَلَيْسَ قَدْ "" كَانَ ابْنُ مَسْعُودٍ يَشْرَبُ عِنْدَكُمْ فِي  الْجَرِّ  الْأَخْضَرِ  ؟ "" قَالَ : بَلَى  .","","Al-Mu'jam al-Kabir 9185","","عبد الله بن مسعود عن الحسن البصري عن عيسى بن عبد الرحمن السلمي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9213","9186  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عُقْبَةُ بْنُ وَهْبِ بْنِ عُقْبَةَ الْعَامِرِيُّ الْبَكَّائِيُّ ، قَالَ :  سَمِعْتُ  أَبِي وَهْبَ بْنَ عُقْبَةَ  ،  يُحَدِّثُ : عَنْ  يَزِيدَ بْنِ مُعَاوِيَةَ الْعَامِرِيِّ ،  أَنَّهُ : سَمِعَ  عَبْدَ اللهِ بْنَ مَسْعُودٍ ، يَقُولُ :  كَيْفَ أَنْتُمْ إِذَا رَأَيْتُمْ قَوْمًا أَوْ أَتَاكُمْ قَوْمٌ لُطَخُ الْوُجُوهِ ؟  "" .","","Al-Mu'jam al-Kabir 9186","","عبد الله بن مسعود عن يزيد بن معاوية البكائي عن وهب بن عقبة البكائي عن عقبة بن وهب البكائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9214","9187  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عُقْبَةُ بْنُ وَهْبٍ ،  سَمِعْتُ  أَبِي  يُحَدِّثُ ، عَنْ  يَزِيدَ بْنِ مُعَاوِيَةَ ،  أَنَّ  عَبْدَ اللهِ بْنَ مَسْعُودٍ خَرَجَ إِلَى السُّوقِ ، فَإِذَا رَجُلٌ ، وَهُوَ يَقُولُ : قَوْمٌ يَقْتَتِلُونَ فِي السُّوقِ ، فَلَمْ أَرَ كَالْيَوْمِ قَطُّ كَالْفِتْنَةِ الْمُضِلَّةِ ، قَالَ :  لَيْسَ هَذَا بِالْفِتْنَةِ الْمُضِلَّةِ ، وَلَكِنْ هَذَا قَرْنٌ مِنَ الشَّيْطَانِ .  ""","","Al-Mu'jam al-Kabir 9187","","عبد الله بن مسعود عن يزيد بن معاوية البكائي عن وهب بن عقبة البكائي عن عقبة بن وهب البكائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9215","9188  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ عَطَاءٍ الْعَامِرِيُّ الْبَكَّائِيُّ ، قَالَ :  سَمِعْتُ  وَهْبَ بْنَ عُقْبَةَ  يُحَدِّثُ ، عَنْ  يَزِيدَ بْنِ مُعَاوِيَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 9188","","عبد الله بن مسعود عن يزيد بن معاوية البكائي عن وهب بن عقبة البكائي عن عبد الملك بن عطاء البكائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9216","9189  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِي إِسْحَاقَ ،  حَدَّثَنِي  هُبَيْرَةُ بْنُ يَرِيمَ ،  أَنَّهُ : سَمِعَ  ابْنَ مَسْعُودٍ ، يَقُولُ :  إِنَّ مِنْ آخِرِ أَهْلِ الْجَنَّةِ دُخُولًا رَجُلًا  مَرَّ بِهِ رَبُّهُ عَزَّ وَجَلَّ فَقَالَ لَهُ : قُمْ فَادْخُلِ الْجَنَّةَ ، فَأَقْبَلَ عَلَيْهِ  عَابِسًا  فَقَالَ : وَهَلْ أَبْقَيْتَ لِي شَيْئًا ؟ قَالَ : نَعَمْ ، لَكَ مِثْلُ مَا طَلَعَتْ عَلَيْهَا الشَّمْسُ أَوْ غَرَبَتْ  "" .","","Al-Mu'jam al-Kabir 9189","","عبد الله بن مسعود عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9217","9190  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ، قَالَ :  صَلَّى         [9/243]      عَبْدُ اللهِ بْنُ مَسْعُودٍ فِي بَعْضِ مَسَاجِدِ  بَنِي أَسَدٍ  الْفَجْرَ ، فَصَلَّى بِهِمْ إِمَامُهُمْ أَطْوَلَ سُورَتَيْنِ فِي الْمُفَصَّلِ عَلَى تَأْلِيفِ  عَبْدِ اللهِ  ، فَلَمَّا قَضَى الصَّلَاةَ  قَالَ  :  أَلَا أَرَاكَ شَابًّا تَقْرَأُ بِهَاتَيْنِ السُّورَتَيْنِ فِي هَذِهِ الصَّلَاةِ وَأَنْتَ شَابٌّ  "" .","","Al-Mu'jam al-Kabir 9190","","عبد الله بن مسعود عن عبد الله بن حبيب السلمي عن عطاء بن السائب عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9218","9191  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  جَاءَ رَجُلٌ إِلَى  عَبْدِ اللهِ مُتَحَنِّطًا ، فَلَمَّا رَآهُ وَوَجَدَ رِيحَ الْحَنُوطِ قَالَ :  اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ شَرِّهِ  ، قَالَ : فَجَاءَهُ فَذَكَرَ لَهُ أَنَّهُ وَقَعَ عَلَى جَارِيَةِ امْرَأَتِهِ فَأَقِمْ عَلَيَّ  الْحَدَّ  ، قَالَ : "" اسْتَغْفِرِ اللهَ وَتُبْ إِلَيْهِ ، وَاسْتُرْ عَلَى نَفْسِكَ ، وَإِنِ اسْتَطَعْتَ أَنْ  تَعْتِقَهَا  فَأَعْتِقْهَا  "" .","","Al-Mu'jam al-Kabir 9191","","عبد الله بن مسعود عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9219","9192  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  لَيْثٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ،  أَنَّ  عَبْدَ اللهِ كَانَ يُكَبِّرُ حِينَ يَفْرَغُ مِنَ الْقِرَاءَةِ  ، ثُمَّ إِذَا فَرَغَ مِنَ  الْقُنُوتِ  كَبَّرَ وَرَكَعَ  "" .","","Al-Mu'jam al-Kabir 9192","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن ليث بن أبي سليم عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9220","9193  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  لَيْثٍ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنْ  عَلْقَمَةَ ،  أَنَّ  رَجُلًا سَأَلَ عَبْدَ اللهِ عَنْ وَقْتِ الظُّهْرِ ؟ قَالَ :  أَنْ يَنْتَعِلَ الرَّجُلُ ظِلَّهُ إِلَى أَنْ يَصِيرَ ظِلُّ كُلِّ شَيْءٍ مِثْلَهُ  ، وَسَأَلَهُ عَنْ وَقْتِ الْعَصْرِ ؟ فَقَالَ : "" صَلِّهَا ، وَالشَّمْسُ بَيْضَاءُ  حَيَّةٌ  "" ، وَسَأَلَ عَنْ وَقْتِ الْمَغْرِبِ ؟ فَقَالَ : "" إِذَا وَقَعَتِ الشَّمْسُ  "" .","","Al-Mu'jam al-Kabir 9193","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن ميمون بن مهران الرقي عن ليث بن أبي سليم عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9221","9194  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  لَيْثٍ ،  عَنِ  الْحَكَمِ ،  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ :  إِنِّي لَأَسْتَدْفِئُ بِهَا فِي الشِّتَاءِ  ، وَأَتَبَرَّدُ بِهَا فِي الصَّيْفِ  "" .","","Al-Mu'jam al-Kabir 9194","","عبد الله بن مسعود عن الحكم بن عتيبة الكندي عن ليث بن أبي سليم عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9222","[9/244]      9195  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :  أُخْبِرْتُ  أَنَّ  ابْنَ مَسْعُودٍ : "" كَانَ يَسْتَدْفِئُ بِامْرَأَتِهِ فِي الشِّتَاءِ  ، وَهُوَ  جُنُبٌ  ، وَقَدِ اغْتَسَلَ ، وَيَتَبَرَّدُ بِهَا فِي الصَّيْفِ وَهُمَا كَذَلِكَ  "" .","","Al-Mu'jam al-Kabir 9195","","عبد الله بن مسعود عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9223","9196  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  لَيْثٍ ،  عَنْ  وَبَرَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  أَنَّ  ابْنَ عَمٍّ لَهُ آلَى مِنِ امْرَأَتِهِ عَشَرَةَ أَيَّامٍ ، ثُمَّ خَرَجَ فَقَدِمَ ،  وَقَدْ مَضَتْ أَرْبَعَةُ أَشْهُرٍ فَوَقَعَ بِأَهْلِهِ ، فَلَقِيَ رَجُلًا فَذَكَّرَهُ يَمِينَهُ ، فَأَتَى ابْنَ مَسْعُودٍ ، "" فَسَأَلَهُ فَأَحْلَفَهُ بِاللهِ مَا عَلِمْتُ ، ثُمَّ أَرْسَلَ إِلَى امْرَأَتِهِ فَأَحْلَفَهَا بِاللهِ عَزَّ وَجَلَّ مَا عَلِمْتُ ، ثُمَّ أَمَرَهُ فَخَطَبَهَا إِلَى نَفْسِهَا  "" .","","Al-Mu'jam al-Kabir 9196","","عبد الله بن مسعود عن وبرة بن عبد الرحمن المسلي عن ليث بن أبي سليم عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9224","9197  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  لَيْثٍ ،  عَنِ  الْحَكَمِ ، وَطَلْحَةَ بْنِ مُصَرِّفٍ ،  قَالَا  :  جَاءَ  مَعْقِلُ بْنُ سِنَانٍ  إِلَى عَبْدِ اللهِ فَسَأَلَهُ عَنْ رَجُلٍ نَذَرَ نَذْرًا  ، وَلَمْ يُسَمِّ شَيْئًا ؟ قَالَ : ""  يَعْتِقُ  نَسَمَةً  ""  .","","Al-Mu'jam al-Kabir 9197","","عبد الله بن مسعود عن الحكم بن عتيبة الكندي عن ليث بن أبي سليم عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9225","9198  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنِ  الْقَاسِمِ ،  قَالَ  :  أُتِيَ عَبْدُ اللهِ ، بِجَارِيَةٍ سَرَقَتْ وَلَمْ تَحِضْ فَلَمْ يَقْطَعْهَا  "" .","","Al-Mu'jam al-Kabir 9198","","عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9226","9199  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنِ  الْقَاسِمِ ،  قَالَ  عَبْدُ اللهِ :  مَنْ حَلَفَ عَلَى يَمِينٍ فَقَالَ : إِنْ شَاءَ اللهُ فَقَدِ اسْتَثْنَى  "" .","","Al-Mu'jam al-Kabir 9199","","عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9227","9200  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنِ  الْقَاسِمِ ،  قَالَ  :  اشْتَرَى  عَبْدُ اللهِ  ،  مِنِ امْرَأَتِهِ - أَوْ مِنِ امْرَأَةٍ لَهُ -  وَلِيدَةً وَشَرَطَ لَهَا ، وَاشْتَرَطَتْ خِدْمَتَهَا  ، فَقَالَ عُمَرُ رَضِيَ اللهُ عَنْهُ : "" لَيْسَ مِنْ مَالِكَ مَا كَانَ فِيهِ         [9/245]      ثَنَوِيَّةٌ لِغَيْرِكَ ""  .","","Al-Mu'jam al-Kabir 9200","","عمر بن الخطاب عن القاسم بن عبد الرحمن المسعودي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9228","9201  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  أَبِي مَعْشَرٍ ،  عَنْ  إِبْرَاهِيمَ ،  قَالَ  :  كَبَّرَ عَبْدُ اللهِ ، حِينَ افْتَتَحَ الصَّلَاةَ  ، فَقَالَ هَكَذَا "" وَرَفَعَ  مِسْعَرٌ  يَدَيْهِ فَوْقَ صَدْرِهِ  .","","Al-Mu'jam al-Kabir 9201","","عبد الله بن مسعود عن إبراهيم النخعي عن زياد بن كليب عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9229","9202  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ قَالَ :  سَمِعْتُ  الْعَلَاءَ الْعَنْبَرِيَّ يَذْكُرُ ،  عَنْ  رَجُلٍ ،  أَنَّ  عَبْدَ اللهِ قَامَ فِي الرَّكْعَتَيْنِ فَلَمْ يَجْلِسْ  "" .","","Al-Mu'jam al-Kabir 9202","","عبد الله بن مسعود عن رجل عن العلاء العنبري عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9230","9203  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  الثَّوْرِيُّ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  مُسْتَوْرِدِ بْنِ الْأَحْنَفِ ،  قَالَ  :  جَاءَ رَجُلٌ إِلَى ابْنِ مَسْعُودٍ ، فَقَالَ : إِنَّ عَمِّي أَنْكَحَنِي وَلِيدَتَهُ  ، وَإِنَّهَا وَلَدَتْ لِي ، وَإِنَّهُ يُرِيدُ أَنْ يَسْتَرِقَّهُمْ ، قَالَ : "" لَيْسَ ذَلِكَ لَهُ  "" .","","Al-Mu'jam al-Kabir 9203","","عبد الله بن مسعود عن المستورد بن الأحنف الفهري عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9231","9204  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنِ  الْمُسْتَوْرِدِ ،  قَالَ  :  جَاءَ رَجُلٌ إِلَى عَبْدِ اللهِ فَقَالَ : إِنَّ عَمَّهُ زَوَّجَهُ وَلِيدَتَهُ  ، وَأَنَّهُ يُرِيدُ أَنْ يَسْتَرِقَّ وَلَدَهُ ، قَالَ : "" لَيْسَ ذَلِكَ لَهُ ""  .","","Al-Mu'jam al-Kabir 9204","","عبد الله بن مسعود عن المستورد بن الأحنف الفهري عن سلمة بن كهيل الحضرمي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9232","9205  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  عَامِرِ بْنِ شَقِيقٍ ،  عَنْ  شَقِيقِ بْنِ سَلَمَةَ ،  قَالَ  :  لَبَّى عَبْدُ اللهِ ، حَتَّى رَمَى الْجَمْرَةَ  "" .","","Al-Mu'jam al-Kabir 9205","","عبد الله بن مسعود عن شقيق بن سلمة عن عامر بن شقيق الأسدي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9233","9206  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ،  عَنْ  عَبْدِ اللهِ بْنِ زِيَادٍ الْأَسَدِيِّ ،  أَنَّهُ سَمِعَ  عَبْدَ اللهِ ،         [9/246]      يَقُولُ وَهُوَ رَاكِعٌ : لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ  "" .","","Al-Mu'jam al-Kabir 9206","","عبد الله بن مسعود عن عبد الله بن زياد الأسدي عن أشعث بن أبي الشعثاء عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9234","9207  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  مَعْنِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  رَجُلٍ ،  قَالَ  :  قَالَ عَبْدُ اللهِ لِرَجُلٍ :  إِذَا سَأَلْتَ رَبَّكَ الْخَيْرَ فَلَا تَسْأَلْ وَبِيَدِكَ حَجَرٌ  "" .","","Al-Mu'jam al-Kabir 9207","","عبد الله بن مسعود عن رجل عن معن بن عبد الرحمن المسعودي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9235","9208  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  أَبِي حَصِينٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  أَصْبِحُوا مُتَدَهِّنِينَ صِيَامًا  ""  .","","Al-Mu'jam al-Kabir 9208","","عبد الله بن مسعود عن عثمان بن عاصم بن حصين عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9236","9209  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  أَبُو الْعُمَيْسِ ،  عَنْ  قَيْسِ بْنِ مُسْلِمٍ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ،  قَالَ  :  أَرَادَتِ امْرَأَةٌ مِنَّا  الْحَجَّ  وَأَرَادَتْ أَنْ تَضُمَّ مَعَ حَجَّتِهَا عُمْرَةً  ، فَسَأَلَتْ عَبْدَ اللهِ ، فَقَالَ : "" مَا أَجِدُ هَذِهِ إِلَّا أَشْهُرُ  الْحَجِّ  ، قَالَ اللهُ عَزَّ وَجَلَّ :         {      أَشْهُرٌ مَعْلُومَاتٌ         }      ""  .","","Al-Mu'jam al-Kabir 9209","","عبد الله بن مسعود عن طارق بن شهاب الأحمسي عن قيس بن مسلم الجدلي عن عتبة بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","باب"
"9237","9210  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  قَتَادَةَ ،  أَنَّ  ابْنَ مَسْعُودٍ ، قَالَ :  رَجَعَ قَوْلُهُ إِلَى غَسْلِ الْقَدَمَيْنِ فِي قَوْلِهِ :         {      وَأَرْجُلَكُمْ إِلَى الْكَعْبَيْنِ         }      ""  .","","Al-Mu'jam al-Kabir 9210","","عبد الله بن مسعود عن قتادة بن دعامة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9238","9211  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِي مِسْكِينٍ ،  عَنْ  هُزَيْلِ بْنِ شُرَحْبِيلَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  لَيَنْتَهِكَنَّ رَجُلٌ بَيْنَ أَصَابِعِهِ فِي الْوُضُوءِ أَوْ لَتَنْتَهِكُهُ النَّارُ  ""  .","","Al-Mu'jam al-Kabir 9211","","عبد الله بن مسعود عن هزيل بن شرحبيل الأودي عن حر بن مسكين الأودي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9239","9212  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  أَبُو مِسْكِينٍ ،  عَنْ  هُزَيْلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  لَيَنْتَهِكَنَّ رَجُلٌ بَيْنَ أَصَابِعِهِ بِالطَّهُورِ أَوْ لَتَنْتَهِكُهُ النَّارُ  ""  .","","Al-Mu'jam al-Kabir 9212","","عبد الله بن مسعود عن هزيل بن شرحبيل الأودي عن حر بن مسكين الأودي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9240","[9/247]      9213  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ، قَالَ :  حُدِّثْتُ عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، أَنَّهُ قَالَ :  خَلِّلُوا  الْأَصَابِعَ الْخَمْسَ لَا يَحْشُوهَا اللهُ نَارًا  ""  .","","Al-Mu'jam al-Kabir 9213","","عبد الله بن مسعود عن طلحة بن مصرف الهمداني عن منصور بن المعتمر عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9241","9214  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ، وَالثَّوْرِيِّ ، وَإِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَرْقَمَ بْنِ شُرَحْبِيلَ ، قَالَ :  حَكَكْتُ جَسَدِي ، وَأَنَا فِي الصَّلَاةِ ، فَأَفْضَيْتُ إِلَى ذَكَرِي  ، فَقُلْتُ لِعَبْدِ اللهِ بْنِ مَسْعُودٍ ،  فَقَالَ لِي  : "" اقْطَعْهُ - وَهُوَ يَضْحَكُ - أَيْنَ تَعْزِلُهُ مِنْكَ إِنَّمَا هُوَ بَضْعَةٌ مِنْكَ  ""  .","","Al-Mu'jam al-Kabir 9214","","عبد الله بن مسعود عن أرقم بن شرحبيل حطام الصفوف عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9242","9215  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ ،  عَنْ  عَلْقَمَةَ ، قَالَ :  سُئِلَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ ، وَأَنَا أَسْمَعُ عَنْ مَسِّ الذَّكَرِ فَقَالَ : "" هَلْ هُوَ إِلَّا كَطَرَفِ أَنْفِكَ  ؟ ""  .","","Al-Mu'jam al-Kabir 9215","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن عبد الرحمن بن يزيد النخعي عن إبراهيم بن مهاجر بن جابر البجلي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9243","9216  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  أَنَّ  ابْنَ مَسْعُودٍ ، قَالَ :  مَا  أُبَالِي  إِيَّاهُ مَسِسْتُ أَوْ أَرْنَبَتِي  ""  .","","Al-Mu'jam al-Kabir 9216","","عبد الله بن مسعود عن سعيد بن جبير الأسدي عن قتادة بن دعامة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9244","9217  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّهُ قَالَ :  مَا  أُبَالِي  إِيَّاهُ مَسِسْتُ أَوْ رُكْبَتِي  ""  .","","Al-Mu'jam al-Kabir 9217","","عبد الله بن مسعود عن سعيد بن جبير الأسدي عن قتادة بن دعامة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9245","9218  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  هِشَامٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  خَمْسَةٍ مِنْ أَصْحَابِ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : عَلِيِّ بْنِ         [9/248]      أَبِي طَالِبٍ ، وَابْنِ مَسْعُودٍ ، وَحُذَيْفَةَ ، وَعِمْرَانَ بْنِ حُصَيْنٍ ، وَرَجُلٍ آخَرَ قَالَ بَعْضُهُمْ :  مَا  أُبَالِي  ذَكَرِي مَسِسْتُ أَوْ أَرْنَبَتِي  ، وَقَالَ الْآخَرُ : "" أُذُنِي "" ، وَقَالَ الْآخَرُ : "" فَخِذِي "" ، وَقَالَ الْآخَرُ : "" رُكْبَتِي ""  .","","Al-Mu'jam al-Kabir 9218","","عبد الله بن مسعود عن الحسن البصري عن هشام بن حسان العتكي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9246","9219  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  يَحْيَى بْنِ الْجَزَّارِ ،  قَالَ  :  صَلَّى ابْنُ مَسْعُودٍ وَعَلَى بَطْنِهِ فَرْثٌ وَدَمٌ مِنْ جَزُورٍ نَحَرَهَا ، وَلَمْ يَتَوَضَّأْ  ""  .","","Al-Mu'jam al-Kabir 9219","","عبد الله بن مسعود عن يحيى بن الجزار العرني عن محمد بن سيرين عن قتادة بن دعامة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9247","9220  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَاصِمِ بْنِ سُلَيْمَانَ ،  عَنِ  ابْنِ سِيرِينَ ، قَالَ :  نَحَرَ ابْنُ مَسْعُودٍ جَزُورًا فَتَلَطَّخَ بِدَمِهَا ، وَفَرْثِهَا ، وَأُقِيمَتِ الصَّلَاةُ فَصَلَّى ، وَلَمْ يَتَوَضَّأْ  ""  .","","Al-Mu'jam al-Kabir 9220","","عبد الله بن مسعود عن محمد بن سيرين عن عاصم بن سليمان الأحول عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9248","9221  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  صَدَقَةَ بْنِ الْمُثَنَّى ،  حَدَّثَنِي  رَبَاحُ بْنُ الْحَارِثِ ،  أَنَّ  ابْنَ مَسْعُودٍ ، قَالَ  فِي الْمَيْتَةِ : دِبَاغُهَا ذَكَاتُهَا  ""  .","","Al-Mu'jam al-Kabir 9221","","عبد الله بن مسعود عن رياح بن الحارث النخعي عن صدقة بن المثنى النخعي عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب"
"9249","9222  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  لَأَنْ أَتَوَضَّأَ مِنَ الْكَلِمَةِ الْخَبِيثَةِ أَحَبُّ إِلَيَّ مِنْ أَنْ أَتَوَضَّأَ مِنَ الطَّعَامِ الطَّيِّبِ  ""  .","","Al-Mu'jam al-Kabir 9222","","عبد الله بن مسعود عن يزيد بن شريك بن طارق التيمي عن إبراهيم بن يزيد بن شريك التيمي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9250","9223  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الْحَجَّاجِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  لَأَنْ أَتَوَضَّأَ مِنَ الْكَلِمَةِ الْخَبِيثَةِ أَحَبُّ إِلَيَّ مِنْ أَنْ أَتَوَضَّأَ مِنَ اللُّقْمَةِ الطَّيِّبَةِ  ""  .","","Al-Mu'jam al-Kabir 9223","","عبد الله بن مسعود عن يزيد بن شريك بن طارق التيمي عن إبراهيم بن يزيد بن شريك التيمي عن الأعمش عن حجاج بن أرطاة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9251","9224  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  أَتَوَضَّأُ مِنْ كَلِمَةٍ خَبِيثَةٍ أَحَبُّ إِلَيَّ مِنْ أَنْ أَتَوَضَّأَ مِنْ طَعَامٍ طَيِّبٍ  ""  .","","Al-Mu'jam al-Kabir 9224","","عبد الله بن مسعود عن يزيد بن شريك بن طارق التيمي عن إبراهيم بن يزيد بن شريك التيمي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9252","[9/249]      9225  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ التَّيْمِيِّ ،  عَنْ  مَنْصُورٍ ،  عَنْ  عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ ،  أَنَّ  عَلِيًّا ، وَابْنَ مَسْعُودٍ ، وَالشَّعْبِيَّ ، قَالُوا  فِي الرَّجُلِ يَنَامُ وَهُوَ جَالِسٌ : "" لَيْسَ عَلَيْهِ وُضُوءٌ  ""  .","","Al-Mu'jam al-Kabir 9225","","الشعبي عن عبد الكريم بن أبي المخارق عن منصور بن المعتمر عن معتمر بن سليمان عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9253","9226  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  أَنَّ  ابْنَ مَسْعُودٍ  ، قَالَ :  يَتَوَضَّأُ الرَّجُلُ مِنَ الْمُبَاشَرَةِ  ، وَمِنَ اللَّمْسِ بِيَدِهِ ، وَمِنَ الْقُبْلَةِ إِذَا قَبَّلَ امْرَأَتَهُ ، وَكَانَ يَقُولُ فِي هَذِهِ الْآيَةِ :         {      أَوْ لامَسْتُمُ النِّسَاءَ         }      هُوَ الْغَمْزُ ""  .","","Al-Mu'jam al-Kabir 9226","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن إبراهيم النخعي عن الأعمش عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9254","9227  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  سَمِعْتُ  أَبَا عُبَيْدَةَ بْنَ عَبْدِ اللهِ ، يَقُولُ :  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ  :  الْقُبْلَةُ مِنَ اللَّمْسِ ، وَمِنْهَا الْوُضُوءُ  ""  .","","Al-Mu'jam al-Kabir 9227","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن إبراهيم النخعي عن الأعمش عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9255","9228  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  بَيَانٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  الْمُلَامَسَةُ مَا دُونَ الْجِمَاعِ  ""  .","","Al-Mu'jam al-Kabir 9228","","عبد الله بن مسعود عن الشعبي عن بيان بن بشر الأحمسي عن خالد بن عبد الله الطحان عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9256","9229  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  الْمُلَامَسَةُ مَا دُونَ الْجِمَاعِ  ، أَنْ يَمَسَّ الرَّجُلُ جَسَدَ امْرَأَتِهِ بِشَهْوَةٍ ، فَفِيهِ الْوُضُوءُ  "" .","","Al-Mu'jam al-Kabir 9229","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9257","9230  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  حَمَّادٍ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  إِنَّ الشَّيْطَانَ يَأْتِي أَحَدَكُمْ فِي صَلَاتِهِ فَيَأْخُذُ بِشَعْرَةٍ مِنْ دُبُرِهِ  ، فَيَرَى أَنَّهُ قَدْ أَحْدَثَ فَلَا يَنْصَرِفْ حَتَّى يَسْمَعَ صَوْتًا أَوْ يَجِدَ رِيحًا  ""  .","","Al-Mu'jam al-Kabir 9230","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن المنهال بن عمرو الأسدي عن حماد بن أبي سليمان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9258","9231  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،         [9/250]      عَنِ  الْأَعْمَشِ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  قَيْسِ بْنِ السَّكَنِ ، قَالَ :  قَالَ  ابْنُ مَسْعُودٍ :  إِنَّ الشَّيْطَانَ لَيُطِيفُ بِالرَّجُلِ فِي صَلَاتِهِ لِيَقْطَعَ عَلَيْهِ صَلَاتَهُ  ، فَإِذَا أَعْيَاهُ نَفَخَ فِي دُبُرِهِ ، فَإِذَا  أَحَسَّ  أَحَدُكُمْ مِنْ ذَلِكَ شَيْئًا فَلَا يَنْصَرِفَنَّ حَتَّى يَجِدَ رِيحًا أَوْ يَسْمَعَ صَوْتًا  ""  .","","Al-Mu'jam al-Kabir 9231","","عبد الله بن مسعود عن قيس بن السكن السوائى عن المنهال بن عمرو الأسدي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9259","9232  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  قَيْسِ بْنِ السَّكَنِ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  إِنَّ الشَّيْطَانَ لَيُطِيفُ بِالرَّجُلِ فِي الصَّلَاةِ لِيَقْطَعَ عَلَيْهِ صَلَاتَهُ  ، فَإِذَا أَعْيَا نَفَخَ فِي دُبُرِهِ لِيُرِيَهُ أَنَّهُ قَدْ أَحْدَثَ ، فَإِذَا وَجَدَ مِنْ ذَلِكَ شَيْئًا فَلَا يَنْصَرِفَنَّ حَتَّى يَسْمَعَ صَوْتًا أَوْ يَجِدَ رِيحًا ""  .","","Al-Mu'jam al-Kabir 9232","","عبد الله بن مسعود عن قيس بن السكن السوائى عن المنهال بن عمرو الأسدي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9260","9233  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ :  إِنَّ الشَّيْطَانَ يَنْفُخُ فِي دُبُرِ الرَّجُلِ  ، إِذَا  أَحَسَّ  أَحَدُكُمْ ذَلِكَ فَلَا يَنْصَرِفْ حَتَّى يَسْمَعَ صَوْتًا أَوْ يَجِدَ رِيحًا  ""  .","","Al-Mu'jam al-Kabir 9233","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9261","9234  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ، قَالَ :  أُتِينَا بِجَفْنَةٍ ، وَنَحْنُ مَعَ ابْنِ مَسْعُودٍ ، فَأَمَرَ بِهَا فَوُضِعَتْ فِي الطَّرِيقِ فَأَكَلَ مِنْهَا فَأَكَلْنَا  ، وَجَعَلَ يَدْعُو مَنْ مَرَّ بِهِ ، ثُمَّ مَضَيْنَا إِلَى الصَّلَاةِ ، فَمَا زَادَ عَلَى أَنْ غَسَلَ أَطْرَافَ أَصَابِعِهِ ، وَمَضْمَضَ فَاهُ ثُمَّ صَلَّى  ""  .","","Al-Mu'jam al-Kabir 9234","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن حماد بن أبي سليمان عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9262","9235  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ، قَالَ :  أُتِينَا بِقَصْعَةٍ مِنْ بَيْتِ  ابْنِ مَسْعُودٍ  ، فِيهَا خُبْزٌ وَلَحْمٌ فَأَكَلْنَا ، وَمَعَنَا ابْنُ مَسْعُودٍ ، فَمَضْمَضَ ، وَغَسَلَ أَصَابِعَهُ عِنْدَ الْمَغْرِبِ  ""  .","","Al-Mu'jam al-Kabir 9235","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9263","[9/251]      9236  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ، قَالَ :  أُتِينَا بِقَصْعَةٍ فَأَكَلْنَا وَمَعَنَا  عَبْدُ اللهِ  ، ثُمَّ تَمَضْمَضَ عَبْدُ اللهِ ، وَغَسَلَ أَصَابِعَهُ ، ثُمَّ انْطَلَقْنَا إِلَى صَلَاةِ الْمَغْرِبِ  ""  .","","Al-Mu'jam al-Kabir 9236","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9264","9237  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  وَائِلِ بْنِ دَاوُدَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  إِنَّمَا الْوُضُوءُ مِمَّا خَرَجَ ، وَلَيْسَ مِمَّا دَخَلَ  ، وَالصَّوْمُ مِمَّا دَخَلَ ، وَلَيْسَ مِمَّا خَرَجَ  ""  .","","Al-Mu'jam al-Kabir 9237","","عبد الله بن مسعود عن إبراهيم النخعي عن وائل بن داود التيمي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9265","9238  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  الْحَسَنُ بْنُ الرَّبِيعِ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  عَبْدِ الْأَعْلَى ،  عَنْ  أَبِي عُبَيْدَةَ بْنِ عَبْدِ اللهِ ،  حَدَّثَتْنِي  أُمِّي  ،  أَنَّ  عَبْدَ اللهِ :  كَانَ يَلْبَسُ خُفَّيْهِ عِنْدَ صَلَاةِ الْفَجْرِ  ، ثُمَّ لَا يَنْزِعُهُمَا حَتَّى يَأْوِيَ إِلَى فِرَاشِهِ  "" .","","Al-Mu'jam al-Kabir 9238","","عبد الله بن مسعود عن زينب بنت معاوية رائطة عن أبو عبيدة بن عبد الله بن مسعود عن عبد الأعلى بن عامر الثعلبي عن سلام بن سليم الحنفي عن الحسن بن الربيع البوراني عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9266","9239  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ،  عَنِ  ابْنِ مَسْعُودٍ ،  أَنَّهُ : "" كَانَ يَمْسَحُ عَلَى الْجَوْرَبَيْنِ ، وَالنَّعْلَيْنِ  "" .","","Al-Mu'jam al-Kabir 9239","","عبد الله بن مسعود عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9267","9240  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنِ  الْحَارِثِ بْنِ سُوَيْدٍ ، قَالَ :  جَعَلَ عَبْدُ اللهِ الْمَسْحَ ثَلَاثَةَ أَيَّامٍ لِلْمُسَافِرِ ، وَيَوْمًا لِلْمُقِيمِ  ""  .","","Al-Mu'jam al-Kabir 9240","","عبد الله بن مسعود عن الحارث بن سويد الأعور عن إبراهيم بن يزيد بن شريك التيمي عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9268","9241  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ بْنِ الْمُصْطَلِقِ ، قَالَ :  سَافَرْتُ مَعَ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، ثَلَاثًا إِلَى الْمَدِينَةِ فَلَمْ يَنْزِعْ خُفَّيْهِ  ""  .","","Al-Mu'jam al-Kabir 9241","","عبد الله بن مسعود عن عمرو بن الحارث بن أبي ضرار المصطلقي عن شقيق بن سلمة عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9269","9242  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا         [9/252]      زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقٍ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ بْنِ الْمُصْطَلِقِ ، قَالَ :  سَافَرْتُ مَعَ  عَبْدِ اللهِ إِلَى الْمَدِينَةِ فَلَمْ يَنْزِعْ خُفَّيْهِ ثَلَاثَةَ أَيَّامٍ وَلَيَالِيَهُنَّ  ""  ،  وَقَالَ  سُلَيْمَانُ  : فَحَدَّثْتُ  إِبْرَاهِيمَ  حَدِيثَ  شَقِيقٍ  هَذَا ، فَقَالَ : وَأَنَا حَدَّثَنِي  أَبُو عُبَيْدَةَ  ، عَنْ  عَمْرِو بْنِ الْحَارِثِ  هَذَا الْحَدِيثَ  .","","Al-Mu'jam al-Kabir 9242","","عبد الله بن مسعود عن عمرو بن الحارث بن أبي ضرار المصطلقي عن شقيق بن سلمة عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9270","9243  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ بْنِ الْمُصْطَلِقِ ، قَالَ :  سَافَرْتُ مَعَ  عَبْدِ اللهِ بْنِ مَسْعُودٍ فَكَانَ يَمْسَحُ عَلَى خُفَّيْهِ ثَلَاثًا  ""  .","","Al-Mu'jam al-Kabir 9243","","عبد الله بن مسعود عن عمرو بن الحارث بن أبي ضرار المصطلقي عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9271","9244  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  عَامِرٍ ،  عَنْ  شَقِيقِ بْنِ سَلَمَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  لِلْمُسَافِرِ ثَلَاثَةُ أَيَّامٍ يَمْسَحُ عَلَى الْخُفَّيْنِ ، وَلِلْمُقِيمِ يَوْمٌ وَلَيْلَةٌ  ، وَسَافَرْتُ مَعَ  عَبْدِ اللهِ  "" فَمَكَثَ ثَلَاثًا يَمْسَحُ عَلَى الْخُفَّيْنِ  "" .","","Al-Mu'jam al-Kabir 9244","","عبد الله بن مسعود عن شقيق بن سلمة عن عامر بن شقيق الأسدي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9272","9245  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  حَجَّاجٍ ،  عَنِ  الْحَكَمِ بْنِ عُتَيْبَةَ ،  عَنْ  عَلِيٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  لِلْمُسَافِرِ ثَلَاثَةُ أَيَّامٍ وَلَيَالِيهِنَّ ، وَلِلْمُقِيمِ يَوْمٌ وَلَيْلَةٌ  ""  .","","Al-Mu'jam al-Kabir 9245","","عبد الله بن مسعود عن علي بن الحسين زين العابدين عن الحكم بن عتيبة الكندي عن حجاج بن أرطاة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9273","9246  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجٌ ،  ثَنَا  حَمَّادٌ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  يَمْسَحُ الْمُسَافِرُ عَلَى الْخُفَّيْنِ ثَلَاثَةَ أَيَّامٍ وَلَيَالِيَهُنَّ ، وَالْمُقِيمُ يَوْمًا وَلَيْلَةً  "" .","","Al-Mu'jam al-Kabir 9246","","عبد الله بن مسعود عن سلمة بن كهيل الحضرمي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9274","9247  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  يَمْسَحُ الْمُسَافِرُ ثَلَاثَةَ أَيَّامٍ وَلَيَالِيَهُنَّ ، وَالْمُقِيمُ يَوْمًا وَلَيْلَةً  "" .","","Al-Mu'jam al-Kabir 9247","","عبد الله بن مسعود عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9275","[9/253]      9248  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  أَبَانُ ،  عَنِ  النَّخَعِيِّ ،  عَنْ  عَلْقَمَةَ ،  أَنَّ  رَجُلًا كَانَ بِهِ  جُدَرِيٌّ  ، "" فَأَمَرَ ابْنُ مَسْعُودٍ فَقُرِّبَ تُرَابٌ فِي  طَسْتٍ - أَوْ  تَوْرٍ  -  فَتَمَسَّحَ  بِالتُّرَابِ  "" .","","Al-Mu'jam al-Kabir 9248","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن أبان بن صالح بن عمير عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9276","9249  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  يَحْيَى بْنِ الْأَعْرَجِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  لَوْ أَجْنَبْتُ ، ثُمَّ لَمْ أَجِدِ الْمَاءَ شَهْرًا مَا صَلَّيْتُ  "" .  قَالَ سُفْيَانُ : ""  لَا يُؤْخَذُ بِهِ  "" .","","Al-Mu'jam al-Kabir 9249","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن سفيان الثوري عن يحيى بن الأعرج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9277","9250  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  أَبِي سِنَانٍ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  أَنَّ  ابْنَ مَسْعُودٍ نَزَلَ عَنْ قَوْلِهِ فِي  الْجُنُبِ  أَنَّهُ لَا يَغْتَسِلُ  "" .","","Al-Mu'jam al-Kabir 9250","","عبد الله بن مسعود عن الضحاك بن مزاحم الهلالي عن ضرار بن مرة الشيباني عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9278","9251  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ، فَقَالَ :  حَدَّثَنِي  الْحَارِثُ ،  عَنْ  عَلِيٍّ ،  وَعَلْقَمَةَ  ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  وَمَسْرُوقٍ  ،  عَنْ  عَائِشَةَ ، قَالُوا :  إِذَا جَاوَزَ الْخِتَانُ الْخِتَانَ وَجَبَ الْغُسْلُ  "" قَالَ  مَسْرُوقٌ  : وَكَانَتْ أَعْلَمَهُمْ بِذَلِكَ  .","","Al-Mu'jam al-Kabir 9251","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن جابر الجعفي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9279","9252  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  أَنَّ ابْنَ مَسْعُودٍ ،  سُئِلَ  عَنْ ذَلِكَ ؟ فَقَالَ : "" إِذَا بَلَغْتَ ذَلِكَ اغْتَسَلْتَ  "" .  قَالَ سُفْيَانُ : ""  وَالْجَمَاعَةُ عَلَى الْغُسْلِ  "" .","","Al-Mu'jam al-Kabir 9252","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9280","9253  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  سُئِلَ  عَبْدُ اللهِ عَنِ الرَّجُلِ يُجَامِعُ امْرَأَتَهُ         [9/254]      فَلَا يُمْنِي ؟  فَقَالَ : "" أَمَا أَنَا فَإِذَا بَلَغْتُ ذَلِكَ مِنَ الْمَرْأَةِ اغْتَسَلْتُ  "" .","","Al-Mu'jam al-Kabir 9253","","عبد الله بن مسعود عن إبراهيم النخعي عن منصور بن المعتمر عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9281","9254  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ، قَالَ :  أَخْبَرَنِي  الْحَارِثُ بْنُ الْأَزْمَعِ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ ، يَقُولُ :  أَيُّمَا  جُنُبٍ  اغْتَسَلَ بِخِطْمِيٍّ فَقَدْ أَبْلَغَ  "" .","","Al-Mu'jam al-Kabir 9254","","عبد الله بن مسعود عن الحارث بن الأزمع الوادعي عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9282","9255  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضْرِ  ، ثَنَا  مُعَاوِيَةُ ،  ثَنَا  زُهَيْرٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ بْنِ الْأَزْمَعِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  إِنْ غَسَلَ رَأْسَهُ وَهُوَ  جُنُبٌ  بِخِطْمِيٍّ فَقَدْ أَبْلَغَ  ، وَلَا يَضُرُّهُ أَنْ لَا يَصُبَّ عَلَيْهِ الْمَاءَ  "" .","","Al-Mu'jam al-Kabir 9255","","عبد الله بن مسعود عن الحارث بن الأزمع الوادعي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9283","9256  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ بْنِ الْأَزْمَعِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِذَا غَسَلَ أَحَدُكُمْ رَأْسَهُ ، وَهُوَ  جُنُبٌ  بِالْخِطْمِيِّ  ، ثُمَّ اغْتَسَلَ بَعْدَ ذَلِكَ ، فَلْيَغْسِلْ رَأْسَهُ إِنْ شَاءَ بِالْمَاءِ  "" .","","Al-Mu'jam al-Kabir 9256","","عبد الله بن مسعود عن الحارث بن الأزمع الوادعي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن محمد بن كثير العبدي عن الفضل بن الحباب الجمحي عن الطبراني","باب"
"9284","9257  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ بْنِ الْأَزْمَعِ ، ""  أَنَّ  ابْنَ مَسْعُودٍ  كَانَ يَغْسِلُ رَأْسَهُ  بِالْخِطْمِيِّ  وَهُوَ  جُنُبٌ  ، فَيَغْتَسِلُ ، وَلَا يَغْسِلُ رَأْسَهُ  ""  .","","Al-Mu'jam al-Kabir 9257","","عبد الله بن مسعود عن الحارث بن الأزمع الوادعي عن أبو إسحاق السبيعي عن حجاج بن أرطاة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9285","9258  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ اللهِ قَالَ :  إِذَا غَسَلَ  الْجُنُبُ  رَأْسَهُ  بِالْخِطْمِيِّ  ، أَجْزَأَهُ ذَلِكَ مِنْ أَنْ يَغْسِلَهُ بِالْمَاءِ  "" .","","Al-Mu'jam al-Kabir 9258","","عبد الله بن مسعود عن إبراهيم النخعي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9286","9259  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  رَجُلٍ ، مِنْ طَيٍّ ،  عَنْ  أَبِيهِ  ،  أَنَّ  ابْنَ مَسْعُودٍ ، خَرَجَ إِلَى الْمَسْجِدِ ، فَجَعَلَ يُهَرْوِلُ  ، فَقِيلَ لَهُ : أَتَفْعَلُ هَذَا وَأَنْتَ تَنْهَى عَنْهُ ؟ قَالَ : "" إِنَّمَا بَادَرْتُ ، حَدُّ الصَّلَاةِ التَّكْبِيرَةُ الْأُولَى  "" .","","Al-Mu'jam al-Kabir 9259","","عبد الله بن مسعود عن أبيه عن رجل من طي عن ليث بن أبي سليم عن الوضاح بن عبد الله اليشكري عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9287","[9/255]      9260  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  لَيْثٍ ،  عَنْ  رَجُلٍ ، مِنْ طَيِّئٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  اسْتَقْبَلْتُ  عَبْدَ اللهِ بْنَ مَسْعُودٍ خَارِجًا مِنْ دَارِهِ يُهَرْوِلُ  ، فَهَرْوَلْتُ مَعَهُ ، وَقُلْتُ : لَقَدْ فَعَلْتَ شَيْئًا كُنْتَ تَنْهَانَا عَنْهُ ، فَقَالَ : "" بَادَرْتُ حَدَّ الصَّلَاةِ ""  .","","Al-Mu'jam al-Kabir 9260","","عبد الله بن مسعود عن أبيه عن رجل من طيئ عن ليث بن أبي سليم عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9288","9261  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  ابْنِ مَسْعُودٍ ،  أَنَّ  أَبَا مُوسَى الْأَشْعَرِيَّ  أَمَّهُمْ فَخَلَعَ نَعْلَيْهِ  ، فَقَالَ لَهُ  عَبْدُ اللهِ  : "" لِمَ خَلَعْتَ نَعْلَيْكَ  أَبِالْوَادِ الْمُقَدَّسِ  أَنْتَ ؟ ""  .","","Al-Mu'jam al-Kabir 9261","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9289","9262  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  عَلْقَمَةَ ، وَلَمْ يَسْمَعْهُ  أَنَّ عَبْدَ اللهِ بْنَ مَسْعُودٍ ، أَتَى  أَبَا مُوسَى الْأَشْعَرِيَّ  ، فِي مَنْزِلِهِ فَحَضَرَتِ الصَّلَاةُ ، فَقَالَ لَهُ  أَبُو مُوسَى  : تَقَدَّمْ يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، فَإِنَّكَ أَقْدَمُ سِنًّا وَأَعْلَمُ ، قَالَ : لَا بَلْ تَقَدَّمْ أَنْتَ فَإِنَّمَا أَتَيْنَاكَ فِي مَنْزِلِكَ ، وَمَسْجِدِكَ ، فَتَقَدَّمَ  أَبُو مُوسَى  فَخَلَعَ نَعْلَيْهِ ، فَلَمَّا صَلَّى قَالَ : مَا أَرَدْتَ إِلَى خَلْعِهَا ؟  أَبِالْوَادِ الْمُقَدَّسِ  طُوًى أَنْتَ ؟  لَقَدْ "" رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يُصَلِّي فِي الْخُفَّيْنِ ، وَالنَّعْلَيْنِ  .","","Al-Mu'jam al-Kabir 9262","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9290","9263  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ،  عَنْ  أَبِي عُبَيْدَةَ ، قَالَ :  كَانَ ابْنُ مَسْعُودٍ  لَا يُصَلِّي - أَوْ قَالَ : - وَلَا يَسْجُدُ  إِلَّا عَلَى الْأَرْضِ  "" .","","Al-Mu'jam al-Kabir 9263","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عبد الكريم الاصطخري عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9291","9264  -  قَالَ  الثَّوْرِيُّ :  وَأَخْبَرَنِي  مُحَمَّدٌ ،  عَنْ  إِبْرَاهِيمَ ، أَنَّهُ :  كَانَ يَقُومُ عَلَى الْبَرْدِيِّ ، وَيَسْجُدُ عَلَى الْأَرْضِ  فَقُلْنَا : مَا الْبَرْدِيُّ ؟ قَالَ : "" الْحَصِيرُ  "" .","","Al-Mu'jam al-Kabir 9264","","إبراهيم النخعي عن محمد بن خالد الضبي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9292","9265  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،         [9/256]      عَنْ  أَبِي وَائِلٍ ،  أَنَّ  ابْنَ مَسْعُودٍ : صَلَّى عَلَى مِسْحٍ  "" .","","Al-Mu'jam al-Kabir 9265","","عبد الله بن مسعود عن شقيق بن سلمة عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9293","9266  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، قَالَ :  سَمِعْتُ  أَبَا عَمْرٍو الشَّيْبَانِيَّ ، قَالَ :  كَانَ ابْنُ مَسْعُودٍ : ""  يَعُسُّ  الْمَسْجِدَ فَلَا يَدَعُ فِيهِ  سَوَادًا  إِلَّا أَخْرَجَهُ إِلَّا رَجُلًا مُصَلِّيًا  "" .","","Al-Mu'jam al-Kabir 9266","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9294","9267  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ :  كُنَّا مَعَ عَبْدِ اللهِ بْنِ مَسْعُودٍ ، فَأَرَادَ أَنْ يَبْصُقَ ، وَمَا عَنْ يَمِينِهِ فَارِغٌ "" فَكَرِهَ أَنْ يَبْصُقَ ، عَنْ يَمِينِهِ ، وَلَيْسَ فِي صَلَاةٍ  .","","Al-Mu'jam al-Kabir 9267","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9295","9268  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  عَاصِمٍ ،  عَنِ  ابْنِ سِيرِينَ ، أَوْ غَيْرِهِ  ، قَالَ :  سَمِعَ ابْنُ مَسْعُودٍ رَجُلًا ""  يَنْشُدُ  ضَالَّةً فِي الْمَسْجِدِ ، فَأَسْكَتَهُ وَانْتَهَرَهُ  وَقَالَ  : "" قَدْ نُهِينَا عَنْ هَذَا  ""  .","","Al-Mu'jam al-Kabir 9268","","عبد الله بن مسعود عن غيره عن عاصم بن سليمان الأحول عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9296","9269  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  وَاصِلٍ الْأَحْدَبِ ،  عَنْ  قَبِيصَةَ بْنِ بُرْمَةَ الْأَسَدِيِّ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  مَا أُحِبُّ أَنْ يَكُونَ مُؤَذِّنُوكُمْ عُمْيَانَكُمْ  - قَالَ :  وَأَحْسِبُهُ ، قَالَ : - وَلَا قُرَّاؤُكُمْ .  ""","","Al-Mu'jam al-Kabir 9269","","عبد الله بن مسعود عن قبيصة بن برمة الأسدي عن واصل بن حيان الأحدب عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9297","9270  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  سُفْيَانَ ،  عَنْ  وَاصِلٍ ،  عَنْ  قَبِيصَةَ بْنِ بُرْمَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 9270","","عبد الله بن مسعود عن قبيصة بن برمة الأسدي عن واصل بن حيان الأحدب عن سفيان الثوري عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9298","[9/257]      9271  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  تَحْرِيمُ  الصَّلَاةِ التَّكْبِيرُ ،  وَتَحْلِيلُهَا  التَّسْلِيمُ  ، وَإِذَا سَلَّمْتَ فَعَجَلَتْ بِكَ حَاجَةٌ فَانْطَلِقْ قَبْلَ أَنْ يُقْبِلَ بِوَجْهِهِ ""  .","","Al-Mu'jam al-Kabir 9271","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9299","9272  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  أَبِي حَنِيفَةَ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  ابْنِ مَسْعُودٍ ،  أَنَّهُ : صَلَّى بِأَصْحَابِهِ فِي دَارِهِ بِغَيْرِ إِقَامَةٍ  ، وَقَالَ : "" إِقَامَةُ الْمِصْرِيِّ تَكْفِي  ""  .","","Al-Mu'jam al-Kabir 9272","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن أبو حنيفة النعمان عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9300","9273  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  ابْنَ مَسْعُودٍ ، وَعَلْقَمَةَ ، وَالْأَسْوَدَ : "" صَلَّوْا بِغَيْرِ أَذَانٍ ، وَلَا إِقَامَةٍ  "" .  قَالَ  سُفْيَانُ  : ""  كَفَتْهُمْ إِقَامَةُ الْمِصْرِ  "" .","","Al-Mu'jam al-Kabir 9273","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9301","9274  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  حُصَيْنٍ ،  عَنْ  إِبْرَاهِيمَ قَالَ :  رَأَى عَبْدُ اللهِ بْنُ مَسْعُودٍ رَجُلًا رَافِعًا يَدَيْهِ إِلَى السَّمَاءِ يَدْعُو ، وَهُوَ فِي صَلَاتِهِ ،  فَقَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ  :  مَا يَدْرِي لَعَلَّ بَصَرَهُ  يُلْتَمَعُ  قَبْلَ أَنْ يَرْجِعَ إِلَيْهِ  .","","Al-Mu'jam al-Kabir 9274","","عبد الله بن مسعود عن إبراهيم النخعي عن حصين بن عبد الرحمن السلمي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9302","9275  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ،  عَنْ  زِيَادِ بْنِ أَبِي مَرْيَمَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  إِذَا فُرِضَتِ الصَّلَاةُ فَلَا تَخْرُجْ مِنْهَا إِلَى غَيْرِهَا  "" .","","Al-Mu'jam al-Kabir 9275","","عبد الله بن مسعود عن زياد بن أبي مريم الجزري عن عبد الكريم الاصطخري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9303","9276  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ         [9/258]      أَيُّوبَ ،  عَنِ  ابْنِ سِيرِينَ ، قَالَ :  قَالَ  ابْنُ مَسْعُودٍ لِأَصْحَابِهِ :  إِنِّي لَا آلُوكُمْ عَنِ الْوَقْتِ ، فَصَلَّى بِهِمُ الظُّهْرَ  حَسِبْتُهُ قَالَ : حِينَ زَالَتِ الشَّمْسُ  .","","Al-Mu'jam al-Kabir 9276","","عبد الله بن مسعود عن محمد بن سيرين عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9304","9277  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنْ  مَسْرُوقٍ ، قَالَ :  صَلَّى عَبْدُ اللهِ ، حِينَ زَالَتِ الشَّمْسُ  ، فَقُلْتُ  لِسُلَيْمَانَ  : الظُّهْرَ ؟ قَالَ : نَعَمْ ، ثُمَّ  قَالَ  عَبْدُ اللهِ  : "" هَذَا وَالَّذِي لَا إِلَهَ إِلَّا هُوَ مِيقَاتُ هَذِهِ الصَّلَاةِ  "" .","","Al-Mu'jam al-Kabir 9277","","عبد الله بن مسعود عن مسروق بن الأجدع عن عبد الله بن مرة الخارفي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9305","9278  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ ،  عَنْ  خِشْفِ بْنِ مَالِكٍ ، قَالَ :  كَانَ عَبْدُ اللهِ "" يُصَلِّي الظُّهْرَ  وَالْجَنَادِبُ  تُنَاقِزُكُمْ حَرَّ الرَّمْضَاءِ  "" .","","Al-Mu'jam al-Kabir 9278","","عبد الله بن مسعود عن خشف بن مالك الطائي عن زيد بن جبير الطائي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9306","9279  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  أَنَّ  ابْنَ مَسْعُودٍ ، كَانَ يُؤَخِّرُ الْعَصْرَ  "" .","","Al-Mu'jam al-Kabir 9279","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9307","9280  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِنَّ "" الشَّمْسَ تَطْلُعُ بَيْنَ  قَرْنَيْ  شَيْطَانٍ  فَلَا تَرْتَفِعُ قَصَبَةً إِلَّا فُتِحَ لَهَا بَابٌ مِنْ أَبْوَابِ  جَهَنَّمَ  ، وَإِذَا انْتَصَفَ النَّهَارُ فُتِحَتْ لَهَا أَبْوَابُ  جَهَنَّمَ  "" ، قَالَ : فَكَانَ  عَبْدُ اللهِ  "" يَنْهَانَا عَنْ صَلَاتَيْنِ فِي هَاتَيْنِ السَّاعَتَيْنِ : حِينَ تَطْلُعُ حَتَّى تَرْتَفِعَ ، وَنِصْفَ النَّهَارِ  ""  .","","Al-Mu'jam al-Kabir 9280","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9308","9281  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ :  كَانَ عَبْدُ اللهِ بْنُ مَسْعُودٍ ، "" يُسْفِرُ بِصَلَاةِ الْغَدَاةِ  "" .","","Al-Mu'jam al-Kabir 9281","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9309","9282  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا         [9/259]      زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنِ  الْحَارِثِ بْنِ سُوَيْدٍ ،  قَالَ  : كَانَ عَبْدُ اللهِ ، يَقُولُ :  تَجَوَّزُوا  فِي الصَّلَاةِ ، فَإِنَّ خَلْفَكُمُ الْكَبِيرَ ، وَالضَّعِيفَ ، وَذَا الْحَاجَةِ  وَكُنَّا نُصَلِّي مَعَ إِمَامِنَا وَعَلَيْنَا ثِيَابُنَا ، فَيَقْرَأُ السُّورَةَ مِنَ الْمِئِينَ ، ثُمَّ نَنْطَلِقُ إِلَى  عَبْدِ اللهِ  فَنَجِدُهُ فِي الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 9282","","عبد الله بن مسعود عن الحارث بن سويد الأعور عن إبراهيم بن يزيد بن شريك التيمي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9310","9283  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ دِينَارٍ ، أَنَّهُ :  سَمِعَ  ابْنَ عَبْدِ اللهِ بْنِ مَسْعُودٍ ، يَقُولُ :  كَانَ عَبْدُ اللهِ بْنُ مَسْعُودٍ ، "" يُغَلِّسُ بِالصُّبْحِ كَمَا يُغَلِّسُ بِهَا  ابْنُ الزُّبَيْرِ  ، وَيُصَلِّي الْمَغْرِبَ حِينَ تَغْرُبُ الشَّمْسُ ،  وَيَقُولُ  : "" وَاللهِ إِنَّهُ لَكَمَا قَالَ اللهُ تَعَالَى :         {      إِلَى غَسَقِ اللَّيْلِ وَقُرْآنَ الْفَجْرِ إِنَّ قُرْآنَ الْفَجْرِ كَانَ مَشْهُودًا         }      .","","Al-Mu'jam al-Kabir 9283","","عبد الله بن مسعود عن ابن عبد الله بن مسعود عن عمرو بن دينار الأثرم عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9311","9284  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  حَدَّثَنِي  مَنْ  رَأَى  ابْنَ مَسْعُودٍ : صَلَّى الْفَجْرَ ، ثُمَّ قَعَدَ فَلَمْ يَقُمْ لِصَلَاةٍ حَتَّى نُودِيَ بِالظُّهْرِ فَقَامَ فَصَلَّى أَرْبَعًا  "" .","","Al-Mu'jam al-Kabir 9284","","عبد الله بن مسعود عن من عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9312","9285  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  لَيْثٍ ،  عَنِ  الْمُغِيرَةِ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  لَا يُصَلِّيَنَّ أَحَدُكُمْ وَبَيْنَهُ وَبَيْنَ الْقِبْلَةِ  فَجْوَةٌ  ""  يَعْنِي فُرْجَةً  .","","Al-Mu'jam al-Kabir 9285","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن المغيرة بن حكيم الأبناوي عن ليث بن أبي سليم عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9313","9286  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  لَيْثٍ ،  عَنِ  الْمُغِيرَةِ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  لَا تُصَلِّ وَبَيْنَكَ وَبَيْنَ الْقِبْلَةِ  فَجْوَةٌ  "" .","","Al-Mu'jam al-Kabir 9286","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن المغيرة بن حكيم الأبناوي عن ليث بن أبي سليم عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9314","9287  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنِ  الْأَسْوَدِ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  مَنِ اسْتَطَاعَ مِنْكُمْ أَنْ لَا يُمَرَّ بَيْنَ يَدَيْهِ ، وَهُوَ يُصَلِّي فَلْيَفْعَلْ  ، فَإِنَّ الْمَارَّ بَيْنَ يَدَيِ الْمُصَلِّي أَنْقَصُ أَجْرًا مِنَ الْمُمَرِّ عَلَيْهِ  "" .","","Al-Mu'jam al-Kabir 9287","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9315","[9/260]      9288  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِنِ اسْتَطَاعَ أَحَدُكُمْ أَنْ لَا يَمُرَّ بَيْنَ يَدَيْهِ أَحَدٌ فَلْيَفْعَلْ  ، فَإِنَّ الْمَارَّ عَلَى الْمُصَلِّي أَنْقَصُ أَجْرًا مِنَ الْمُمَرِّ عَلَيْهِ ""  .","","Al-Mu'jam al-Kabir 9288","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9316","9289  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنِ  الْأَسْوَدِ بْنِ يَزِيدَ ، قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ :  مَنِ اسْتَطَاعَ مِنْكُمْ أَنْ لَا يُمَرَّ بَيْنَ يَدَيْهِ ، وَهُوَ يُصَلِّي فَلْيَفْعَلْ  ، فَإِنَّ الْمَارَّ بَيْنَ يَدَيِ الْمُصَلِّي أَنْقَصُ مِنَ الْمُمَرِّ عَلَيْهِ  "" .","","Al-Mu'jam al-Kabir 9289","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن الوضاح بن عبد الله اليشكري عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9317","9290  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  رَجُلٍ ، مِنْ أَهْلِ الْمَدِينَةِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  إِذَا أَرَادَ أَحَدٌ أَنْ يَمُرَّ بَيْنَ يَدَيْكَ ، وَأَنْتَ تُصَلِّي ، فَلَا تَدَعْهُ  ، فَإِنَّهُ يَطْرَحُ  شَطْرَ  صَلَاتِكَ  "" .","","Al-Mu'jam al-Kabir 9290","","عبد الله بن مسعود عن عبد الرحمن بن الأسود النخعي عن رجل من أهل المدينة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9318","9291  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ :  كَانَ عَبْدُ اللهِ بْنُ مَسْعُودٍ "" يُسَوِّي الْحَصَى بِيَدِهِ مَرَّةً وَاحِدَةً إِذَا أَرَادَ أَنْ يَسْجُدَ  ، وَهُوَ يَقُولُ فِي سُجُودِهِ :  لَبَّيْكَ  ،  وَسَعْدَيْكَ  "" .","","Al-Mu'jam al-Kabir 9291","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9319","9292  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  عِكْرِمَةَ بْنِ عَمَّارٍ أَوْ عُمَرَ بْنِ رَاشِدٍ  ، عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  رَجُلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادِ بْنِ الْهَادِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  إِنَّ اللهَ وَمَلَائِكَتَهُ يُصَلُّونَ عَلَى الَّذِينَ يَتَقَدَّمُونَ الصُّفُوفَ بِصَلَاتِهِمْ  ""  يَعْنِي الصَّفَّ الْمُقَدَّمَ  .","","Al-Mu'jam al-Kabir 9292","","عبد الله بن مسعود عن عبد الله بن شداد بن الهاد الليثي عن رجل عن يحيى بن أبي كثير عن عمر بن راشد بن شجرة اليمامي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9320","9293  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبِي         [9/261]      إِسْحَاقَ ،  عَنْ  مَعْدِي كَرِبَ ، قَالَ :  قَالَ  ابْنُ مَسْعُودٍ :  لَا تَصْطَفُّوا بَيْنَ  السَّوَارِي  وَلَا تَأْتَمُّوا بِالْقَوْمِ ، وَهُمْ يَتَحَدَّثُونَ  "" .","","Al-Mu'jam al-Kabir 9293","","عبد الله بن مسعود عن معدي كرب المشرقي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9321","9294  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  مَعْدِي كَرِبَ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  لَا تَأْتَمُّوا بِقَوْمٍ يَمْتَرُونَ ، وَلَا تُصَلُّوا بَيْنَ  السَّوَارِي  ""  .","","Al-Mu'jam al-Kabir 9294","","عبد الله بن مسعود عن معدي كرب المشرقي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن محمد بن كثير العبدي عن الفضل بن الحباب الجمحي عن الطبراني","باب"
"9322","9295  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ، وَابْنِ عُيَيْنَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  مَعْدِي كَرِبَ الْهَمْدَانِيِّ ، قَالَ :  سَمِعْتُ  ابْنَ مَسْعُودٍ ، يَقُولُ :  لَا تَصْطَفُّوا بَيْنَ الْأَسَاطِينِ  ، وَلَا تُصَلِّ وَبَيْنَ يَدَيْكَ قَوْمٌ يَمُرُّونَ  "" .","","Al-Mu'jam al-Kabir 9295","","عبد الله بن مسعود عن معدي كرب المشرقي عن أبو إسحاق السبيعي عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9323","9296  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الطُّفَيْلِ النَّخَعِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  مَعْدِي كَرِبَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِنَّمَا كَرِهْتُ الصَّلَاةَ بَيْنَ الْأَسَاطِينِ الْوَاحِدِ وَالِاثْنَيْنِ  ""  .","","Al-Mu'jam al-Kabir 9296","","عبد الله بن مسعود عن معدي كرب المشرقي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن محمد بن الطفيل بن مالك النخعي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","باب"
"9324","9297  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  شَقِيقِ بْنِ سَلَمَةَ ،  أَنَّ  ابْنَ مَسْعُودٍ كَانَ يُكَبِّرُ كُلَّمَا خَفَضَ وَرَفَعَ  "" .","","Al-Mu'jam al-Kabir 9297","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9325","9298  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  حُصَيْنٍ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  ابْنَ مَسْعُودٍ كَانَ "" يَرْفَعُ يَدَيْهِ فِي أَوَّلِ شَيْءٍ ، ثُمَّ لَا يَرْفَعُ بَعْدُ  "" .","","Al-Mu'jam al-Kabir 9298","","عبد الله بن مسعود عن إبراهيم النخعي عن حصين بن عبد الرحمن السلمي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9326","9299  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  حُصَيْنٍ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  كَانَ عَبْدُ اللهِ ، لَا يَرْفَعُ يَدَيْهِ فِي شَيْءٍ مِنَ الصَّلَاةِ إِلَّا فِي التَّكْبِيرَةِ الْأُولَى  "" .","","Al-Mu'jam al-Kabir 9299","","عبد الله بن مسعود عن إبراهيم النخعي عن حصين بن عبد الرحمن السلمي عن سلام بن سليم الحنفي عن أحمد بن عبد الله اليربوعي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"9327","9300  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  أَنَّهُ : "" كَانَ إِذَا دَخَلَ         [9/262]      الصَّلَاةَ رَفَعَ يَدَيْهِ ، ثُمَّ لَا يَرْفَعُ بَعْدَ ذَلِكَ  ""  .","","Al-Mu'jam al-Kabir 9300","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9328","9301  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  حَدَّثَنِي  مَنْ أُصَدِّقُ ،  عَنْ  أَبِي بَكْرٍ  ، عَنْ  عُمَرَ  ، وَعَنْ  عُثْمَانَ ،  وَعَنِ  ابْنِ مَسْعُودٍ رَضِيَ اللهُ عَنْهُمْ  أَنَّهُمْ كَانُوا إِذَا اسْتَفْتَحُوا قَالُوا : "" سُبْحَانَكَ اللَّهُمَّ  وَبِحَمْدِكَ ،  وَتَبَارَكَ اسْمُكَ ، وَتَعَالَى  جَدُّكَ ،  وَلَا إِلَهَ غَيْرُكَ ، قَبْلَ الْقِرَاءَةِ  "" .  في طبعة مكتبة ابن تيمية : ( أبي بكرة ) والمثبت من نسخة الظاهرية ( 1 ) ومصنف عبد الرزاق  كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب: (وعن عمر) .","","Al-Mu'jam al-Kabir 9301","","عبد الله بن مسعود عن من يصدقه ابن جريج عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9329","9302  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّهُ كَانَ يَقُولُ :  اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الشَّيْطَانِ الرَّجِيمِ مِنْ  هَمْزِهِ  ،  وَنَفْخِهِ  ، وَنَفْثِهِ  "" .","","Al-Mu'jam al-Kabir 9302","","عبد الله بن مسعود عن عبد الله بن حبيب السلمي عن عطاء بن السائب عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9330","9303  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  هَمْزُهُ  : يَعْنِي الشَّيْطَانَ  ، الْمُؤْتَةَ : يَعْنِي الْجُنُونَ ،  وَنَفْخُهُ  : الْكِبْرُ ،  وَنَفْثُهُ  : الشِّعْرُ  ""  .","","Al-Mu'jam al-Kabir 9303","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9331","9304  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،         [9/263]      ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  أَبِي سَعْدٍ الْبَقَّالِ ،  عَنْ  أَبِي وَائِلٍ ، قَالَ :  كَانَ عَلِيٌّ وَابْنُ مَسْعُودٍ لَا يَجْهَرَانِ بِبِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ ، وَلَا بِالتَّعَوُّذِ ، وَلَا بِآمِينَ  "" .","","Al-Mu'jam al-Kabir 9304","","عبد الله بن مسعود عن شقيق بن سلمة عن سعيد بن المرزبان عن أبو بكر بن عياش عن أحمد بن عبد الله اليربوعي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"9332","9305  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  عُثْمَانَ بْنِ مَطَرٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ،  أَنَّ  ابْنَ مَسْعُودٍ كَانَ يَفْتَتِحُ صَلَاتَهُ بِـ         {      الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ         }      "" .","","Al-Mu'jam al-Kabir 9305","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن سعيد بن أبي عروبة عن عثمان بن مطر الشيباني عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9333","9306  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ عَبْدِ الْمَجِيدِ ،  عَنْ  أَيُّوبَ ،  عَنِ  ابْنِ سِيرِينَ ،  أَنَّ  ابْنَ مَسْعُودٍ كَانَ  يَقْرَأُ  فِي الظُّهْرِ وَالْعَصْرِ ، فِي الرَّكْعَتَيْنِ الْأُولَيَيْنِ ، بِفَاتِحَةِ الْكِتَابِ وَسُورَةٍ فِي كُلِّ رَكْعَةٍ  ، وَفِي الْأُخْرَيَيْنِ بِفَاتِحَةِ الْكِتَابِ  "" .","","Al-Mu'jam al-Kabir 9306","","عبد الله بن مسعود عن محمد بن سيرين عن أيوب السختياني عن عبد الوهاب بن عبد المجيد الثقفي عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9334","9307  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  أَنَّ  ابْنَ مَسْعُودٍ صَلَّى بِهِمُ الْعِشَاءَ فَقَرَأَ بِأَرْبَعِينَ مِنَ الْأَنْفَالِ  ، ثُمَّ قَرَأَ فِي الثَّانِيَةِ بِسُورَةٍ مِنَ الْمُفَصَّلِ  "" .","","Al-Mu'jam al-Kabir 9307","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9335","9308  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْحَاقَ بْنِ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ :  صَلَّى بِنَا ابْنُ مَسْعُودٍ صَلَاةَ الْعِشَاءِ ، فَاسْتَفْتَحَ بِسُورَةِ الْأَنْفَالِ حَتَّى إِذَا بَلَغَ :         {      نِعْمَ الْمَوْلَى وَنِعْمَ النَّصِيرُ         }      رَكَعَ  ، ثُمَّ قَرَأَ فِي الرَّكْعَةِ الثَّانِيَةِ بِسُورَتَيْنِ مِنَ الْمُفَصَّلِ  ""  .","","Al-Mu'jam al-Kabir 9308","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9336","9309  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ، قَالَ :  سُئِلَ  أَبُو إِسْحَاقَ :  أَذَكَرْتَ عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  أَنَّ  عَبْدَ اللهِ ، قَرَأَ فِي الْعِشَاءِ الْآخِرَةِ فِي أَوَّلِ رَكْعَةٍ :         {      يَسْأَلُونَكَ عَنِ الأَنْفَالِ         }      حَتَّى بَلَغَ :         {      نِعْمَ الْمَوْلَى وَنِعْمَ النَّصِيرُ         }      ثُمَّ رَكَعَ  ، ثُمَّ قَرَأَ فِي الثَّانِيَةِ بِسُورَةٍ مِنَ الْمُفَصَّلِ ؟ قَالَ : نَعَمْ  ""  .","","Al-Mu'jam al-Kabir 9309","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9337","9310  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ :         [9/264]      أَمَّنَا عَبْدُ اللهِ بْنُ مَسْعُودٍ ، فِي صَلَاةِ الْعِشَاءِ الْآخِرَةِ ، فَافْتَتَحَ الْأَنْفَالَ ، فَقَرَأَ : حَتَّى إِذَا بَلَغَ :         {      نِعْمَ الْمَوْلَى وَنِعْمَ النَّصِيرُ         }      رَكَعَ  ، ثُمَّ قَامَ فَقَرَأَ فِي الرَّكْعَةِ الثَّانِيَةِ بِسُورَةٍ  ""  .","","Al-Mu'jam al-Kabir 9310","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"9338","9311  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي وَائِلٍ ، قَالَ :  جَاءَ رَجُلٌ إِلَى  عَبْدِ اللهِ ، فَقَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  أَقْرَأُ خَلْفَ الْإِمَامِ ؟  قَالَ : ""  أَنْصِتْ  لِلْقُرْآنِ فَإِنَّ فِي الصَّلَاةِ شُغْلًا ، وَسَيَكْفِيكَ ذَلِكَ الْإِمَامُ  ""  .","","Al-Mu'jam al-Kabir 9311","","عبد الله بن مسعود عن شقيق بن سلمة عن منصور بن المعتمر عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9339","9312  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي حَمْزَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّهُ قَالَ :  لَا تَقْرَأْ خَلْفَ الْإِمَامِ إِلَّا أَنْ يَكُونَ إِمَامًا لَا يَقْرَأُ  .","","Al-Mu'jam al-Kabir 9312","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن ميمون القصاب عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9340","9313  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ، ""  أَنَّ  ابْنَ مَسْعُودٍ كَانَ لَا يَقْرَأُ خَلْفَ الْإِمَامِ  وَكَانَ  إِبْرَاهِيمُ  يَأْخُذُ بِهِ  .  وَكَانَ ابْنُ مَسْعُودٍ إِذَا كَانَ إِمَامًا قَرَأَ فِي الرَّكْعَتَيْنِ الْأُولَيَيْنِ  ، وَلَا يَقْرَأُ فِي الْأُخْرَيَيْنِ بِشَيْءٍ  "" .","","Al-Mu'jam al-Kabir 9313","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9341","9314  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  إِذَا تَعَايَا الْإِمَامُ فَلَا تَرُدَّ عَلَيْهِ فَإِنَّهُ كَلَامٌ  "" .","","Al-Mu'jam al-Kabir 9314","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9342","9315  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادٌ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  ابْنَ مَسْعُودٍ كَانَ يَكْرَهُ تَلْقِينَ الْإِمَامِ  ، وَقَالَ : "" إِنَّهُ كَلَامٌ  "" .","","Al-Mu'jam al-Kabir 9315","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9343","[9/265]      9316  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَلْقَمَةَ ، وَالْأَسْوَدِ ، قَالَا :  صَلَّيْنَا مَعَ عَبْدِ اللهِ ، فَلَمَّا رَكَعَ طَبَّقَ كَفَّيْهِ  ، وَوَضَعَهُمَا بَيْنَ رُكْبَتَيْهِ ، وَضَرَبَ أَيْدِيَنَا "" فَفَعَلْنَا ذَلِكَ  .","","Al-Mu'jam al-Kabir 9316","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9344","9317  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَلْقَمَةَ ، وَالْأَسْوَدِ ،  أَنَّ  ابْنَ مَسْعُودٍ ، رَكَعَ فَطَبَّقَ يَدَيْهِ ، وَجَعَلَهُمَا بَيْنَ رُكْبَتَيْهِ  "" .","","Al-Mu'jam al-Kabir 9317","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9345","9318  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  كَانَ عَبْدُ اللهِ ""  يُطَبِّقُ  إِذَا رَكَعَ يَجْعَلُ يَدَيْهِ بَيْنَ رُكْبَتَيْهِ  ، وَيَفْرِشُ ذِرَاعَيْهِ عَلَى فَخِذَيْهِ  "" .","","Al-Mu'jam al-Kabir 9318","","عبد الله بن مسعود عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9346","9319  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  يَحْيَى بْنِ الْجَزَّارِ ،  أَنَّ  عَبْدَ اللهِ كَانَ "" يَقُولُ فِي رُكُوعِهِ : رَبِّ اغْفِرْ لِي  "" .","","Al-Mu'jam al-Kabir 9319","","عبد الله بن مسعود عن يحيى بن الجزار العرني عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","باب"
"9347","9320  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  سُلَيْمَانَ ،  عَنْ  شَقِيقٍ ، قَالَ :  كَانَ عَبْدُ اللهِ مِمَّا يُكْثِرُ أَنْ يَقُولَ فِي رُكُوعِهِ وَسُجُودِهِ :  سُبْحَانَكَ اللَّهُمَّ  وَبِحَمْدِكَ ،  لَا إِلَهَ غَيْرُكَ  "" .","","Al-Mu'jam al-Kabir 9320","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9348","9321  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَلِيِّ بْنِ الْأَقْمَرِ ،  عَنْ  أَبِي الْأَسْوَدِ ، وَشَدَّادِ بْنِ الْأَزْمَعِ ،  عَنِ  ابْنِ مَسْعُودٍ - قَالَ :  اخْتَلَفَا ، فَقَالَ  أَبُو الْأَسْوَدِ  : - "" كَانَ  عَبْدُ اللهِ  يَقُولُ فِي سُجُودِهِ :  سُبْحَانَكَ لَا رَبَّ غَيْرُكَ  قَالَ  شَدَّادٌ  : كَانَ يَقُولُ : "" سُبْحَانَكَ لَا إِلَهَ غَيْرُكَ  "" .","","Al-Mu'jam al-Kabir 9321","","عبد الله بن مسعود عن أبو الأسود الدؤلي عن علي بن الأقمر عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9349","9322  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  يَحْيَى بْنِ الْعَلَاءِ ،  عَنْ  شُعَيْبٍ عَمِّهِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَلْقَمَةَ ، قَالَ :  دَخَلْتُ الْمَسْجِدَ  فَوَجَدْتُ  عَبْدَ اللهِ يُصَلِّي فَرَكَعَ ، وَافْتَتَحْتُ سُورَةَ الْأَعْرَافِ  فَفَرَغْتُ مِنْهَا قَبْلَ         [9/266]      أَنْ يَسْجُدَ  "" .","","Al-Mu'jam al-Kabir 9322","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن أبو إسحاق السبيعي عن شعيب بن خالد البجلي عن يحيى بن العلاء الفوراردي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9350","9323  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ، (  ح  )  وَحَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِذَا قَالَ الْإِمَامُ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، فَلْيَقُلْ مَنْ خَلْفَهُ : رَبَّنَا لَكَ الْحَمْدُ  "" .","","Al-Mu'jam al-Kabir 9323","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9351","9324  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعَيْبٌ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِذَا قَالَ الْإِمَامُ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، فَلْيَقُلْ مَنْ خَلْفَهُ : رَبَّنَا لَكَ الْحَمْدُ  "" .","","Al-Mu'jam al-Kabir 9324","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن سلمة بن كهيل الحضرمي عن شعيب بن خالد البجلي عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","باب"
"9352","9325  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  إِذَا سَجَدَ أَحَدُكُمْ فَلَا يَسْجُدْ  مُتَوَرِّكًا  ، وَلَا مُضْطَجِعًا فَإِنَّهُ إِذَا أَحْسَنَ السُّجُودَ سَجَدَتْ عِظَامُهُ كُلُّهَا  "" .","","Al-Mu'jam al-Kabir 9325","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9353","9326  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِذَا سَجَدَ أَحَدُكُمْ فَلَا يَسْجُدُ مُضْطَجِعًا  ، وَلَا  مُتَوَرِّكًا  ، فَإِنَّهُ إِذَا أَحْسَنَ السُّجُودَ سَجَدَ كُلُّ عُضْوٍ مِنْهُ  "" .","","Al-Mu'jam al-Kabir 9326","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9354","9327  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  عَبْدَةَ بْنِ أَبِي لُبَابَةَ ، قَالَ :  سَمِعْتُ  عَبْدَ الرَّحْمَنِ بْنَ يَزِيدَ ، يَقُولُ :  رَمَقْتُ  عَبْدَ اللهِ بْنَ مَسْعُودٍ فِي الصَّلَاةِ فَرَأَيْتُهُ يَنْهَضُ ، وَلَا يَجْلِسُ  ،  قَالَ  : "" يَنْهَضُ عَلَى صُدُورِ قَدَمَيْهِ فِي الرَّكْعَةِ الْأُولَى ، وَالثَّانِيَةِ  "" .","","Al-Mu'jam al-Kabir 9327","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عبدة بن أبي لبابة عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9355","9328  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا         [9/267]      زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  قَالَ  :  كَانَ عَبْدُ اللهِ "" يَنْهَضُ عَلَى صُدُورِ قَدَمَيْهِ  "" .","","Al-Mu'jam al-Kabir 9328","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9356","9329  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ ،  أَنَّ ابْنَ مَسْعُودٍ كَانَ "" يَنْهَضُ عَلَى صُدُورِ قَدَمَيْهِ  فَذَكَرْتُ ذَلِكَ لِإِبْرَاهِيمَ ، فَقَالَ :  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ ، أَنَّ  ابْنَ مَسْعُودٍ  كَانَ يَفْعَلُهُ  .","","Al-Mu'jam al-Kabir 9329","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن الوضاح بن عبد الله اليشكري عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9357","9330  -  حَدَّثَنِي  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  حُصَيْنٍ ،  عَنْ  إِبْرَاهِيمَ ،  قَالَ  :  كَانَ عَبْدُ اللهِ "" إِذَا كَبَّرَ حِينَ يَرْفَعُ رَأْسَهُ مِنَ السَّجْدَةِ قَامَ بِهَا  "" .","","Al-Mu'jam al-Kabir 9330","","عبد الله بن مسعود عن إبراهيم النخعي عن حصين بن عبد الرحمن السلمي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9358","9331  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ، وَالثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ، قَالَ :  مَرَّ عَبْدُ اللهِ بْنُ مَسْعُودٍ عَلَى رَجُلٍ سَاجِدٍ ، وَرَأْسُهُ  مَعْقُوصٌ  فَحَلَّهُ ، فَلَمَّا انْصَرَفَ  قَالَ لَهُ  عَبْدُ اللهِ  :  لَا تَعْقِصْ فَإِنَّ شَعَرَكَ يَسْجُدُ  ، وَإِنَّ لَكَ بِكُلِّ شَعَرَةٍ أَجْرًا "" ، قَالَ : إِنَّمَا  عَقَصْتُهُ  لِكَيْ لَا يَتَتَرَّبَ ، قَالَ : "" إِنْ يَتَتَرَّبْ خَيْرٌ لَكَ  "" .","","Al-Mu'jam al-Kabir 9331","","عبد الله بن مسعود عن زيد بن وهب الجهني عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9359","9332  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدٍ ، قَالَ :  مَرَّ عَبْدُ اللهِ عَلَى رَجُلٍ سَاجِدٍ قَدْ  عَقَصَ  رَأْسَهُ ، فَحَلَّ  عَقِيصَتَهُ  فَأَرْسَلَهَا ، ثُمَّ انْتَظَرَ حَتَّى صَلَّى ،  فَقَالَ  عَبْدُ اللهِ  :  إِنَّ "" شَعَرَكَ يَسْجُدُ مَعَكَ فَلَا تَعْقِصْهُ  ، فَإِنَّ لَكَ بِكُلِّ شَعَرَةٍ مِنْهُ أَجْرًا "" ، فَقَالَ الرَّجُلُ : إِنِّي خِفْتُ أَنْ يَتَتَرَّبَ ، فَقَالَ  عَبْدُ اللهِ  : "" إِنْ يَتَتَرَّبْ خَيْرٌ لَكَ .  ""","","Al-Mu'jam al-Kabir 9332","","عبد الله بن مسعود عن زيد بن وهب الجهني عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9360","9333  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  عَنْ  عَبْدِ اللهِ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 9333","","عبد الله بن مسعود عن زيد بن وهب الجهني عن الأعمش عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","باب"
"9361","9334  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  قَالَ  :  كَانَ عَبْدُ اللهِ "" لَا يَسْتَدِيرُ فِي صَلَاةٍ  ، إِنْ كَانَتْ حَاجَتُهُ عَنْ يَمِينِهِ ، انْفَتَلَ عَنْ يَمِينِهِ ، وَإِنْ كَانَتْ حَاجَتُهُ عَنْ يَسَارِهِ ،         [9/268]      انْفَتَلَ عَنْ يَسَارِهِ  "" .","","Al-Mu'jam al-Kabir 9334","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن عتبة بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9362","9335  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ، وَالثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّهُ كَانَ يَقُولُ :  إِذَا سَلَّمَ الْإِمَامُ فَانْصَرِفْ حَيْثُ كَانَتْ حَاجَتُكَ يَمِينًا وَشِمَالًا  ، وَلَا تَسْتَدِرِ اسْتِدَارَةَ الْحِمَارِ  "" .","","Al-Mu'jam al-Kabir 9335","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9363","9336  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  قَتَادَةَ ،  قَالَ  :  كَانَ ابْنُ مَسْعُودٍ إِذَا كَانَتْ حَاجَتُهُ عَنْ يَسَارِهِ ، انْصَرَفَ عَنْ يَسَارِهِ  ، وَإِذَا كَانَتْ حَاجَتُهُ عَنْ يَمِينِهِ ، انْصَرَفَ عَنْ يَمِينِهِ  "" .","","Al-Mu'jam al-Kabir 9336","","عبد الله بن مسعود عن قتادة بن دعامة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9364","9337  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  إِذَا سَلَّمَ الْإِمَامُ فَلْيَقُمْ أَوْ لِيَنْحَرِفْ عَنْ مَجْلِسِهِ  ، فَقُلْتُ : يُجْزِئُهُ يَنْحَرِفُ عَنْ مَجْلِسِهِ وَيَسْتَقْبِلُ الْقِبْلَةَ ؟ قَالَ : "" الِانْحِرَافُ يُغَرِّبُ أَوْ يُشَرِّقُ عَنْ غَيْرِ وَاحِدٍ  "" .","","Al-Mu'jam al-Kabir 9337","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9365","9338  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّهُ :  كَانَ إِذَا سَلَّمَ قَامَ عَنْ مَجْلِسِهِ ، أَوِ انْحَرَفَ مُشَرِّقًا أَوْ مُغَرِّبًا  "" .","","Al-Mu'jam al-Kabir 9338","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9366","9339  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِذَا سَلَّمَ الْإِمَامُ ، وَلِلرَّجُلِ حَاجَةٌ فَلَا يَنْتَظِرْهُ إِذَا سَلَّمَ أَنْ يَسْتَقْبِلَهُ بِوَجْهِهِ  ، فَإِنَّ فَصْلَ الصَّلَاةِ التَّسْلِيمُ "" ، فَكَانَ  عَبْدُ اللهِ  إِذَا سَلَّمَ لَمْ يَلْبَثْ أَنْ يَقُومَ أَوْ يَتَحَوَّلَ مِنْ مَكَانِهِ ، وَيَسْتَقْبِلُهُمْ بِوَجْهِهِ  .","","Al-Mu'jam al-Kabir 9339","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9367","9340  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ         [9/269]      أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  أَنَّ  ابْنَ مَسْعُودٍ ، قَالَ :  إِذَا كُنْتَ خَلْفَ الْإِمَامِ فَلَا تَرْكَعْ حَتَّى يَرْكَعَ ، وَلَا تَسْجُدْ حَتَّى يَسْجُدَ  ، وَلَا تَرْفَعْ رَأْسَكَ قَبْلَهُ ، فَإِذَا فَرَغَ الْإِمَامُ ، وَلَمْ يَقُمْ ، وَلَمْ يَنْحَرِفْ ، وَكَانَتْ لَكَ حَاجَةٌ فَاذْهَبْ ، وَدَعْهُ ، فَقَدْ تَمَّتْ صَلَاتُكَ  "" .","","Al-Mu'jam al-Kabir 9340","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9368","9341  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مَالِكِ بْنِ الْحَارِثِ ،  عَنْ  أَبِي خَالِدٍ - مِنْ أَصْحَابِ  عَبْدِ اللهِ  - قَالَ :  جَاءَ  رَجُلٌ  إِلَى عَبْدِ اللهِ فَقَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، فُلَانٌ يَقْرَأُ الْقُرْآنَ وَهُوَ رَاكِعٌ وَيَقْرَأُ وَهُوَ سَاجِدٌ ،  فَقَالَ  عَبْدُ اللهِ  :  إِنَّ رِجَالًا يَقْرَءُونَ الْقُرْآنَ لَا يُجَاوِزُ  تَرَاقِيَهُمْ  ، فَإِذَا دَخَلَ فِي الْقَلْبِ فَرَسَخَ فِيهِ نَفَعَ  "" .","","Al-Mu'jam al-Kabir 9341","","عبد الله بن مسعود عن أبو خالد الوالبي عن مالك بن الحارث السلمي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9369","9342  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  قَالَ  :  كَانَ عَبْدُ اللهِ "" إِذَا صَلَّى كَأَنَّهُ ثَوْبٌ مُلْقًى  "" .","","Al-Mu'jam al-Kabir 9342","","عبد الله بن مسعود عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9370","9343  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  قَارُّوا  الصَّلَاةَ  ""  فَسُئِلَ  مَنْصُورٌ  : مَا يَعْنِي بِذَلِكَ ؟ فَقَالَ : "" لِيَتَمَكَّنْ فِي صَلَاتِهِ إِذَا رَكَعَ وَإِذَا سَجَدَ  ""  .","","Al-Mu'jam al-Kabir 9343","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن منصور بن المعتمر عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9371","9344  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  قَارُّوا  فِي الصَّلَاةِ  ""  يَقُولُ : اسْكُنُوا ، اطْمَئِنُّوا  .","","Al-Mu'jam al-Kabir 9344","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9372","9345  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  لَا يَزَالُ اللهُ مُقْبِلًا عَلَى الْعَبْدِ بِوَجْهِهِ مَا لَمْ يَلْتَفِتْ أَوْ يُحْدِثْ  "" .","","Al-Mu'jam al-Kabir 9345","","عبد الله بن مسعود عن أبو قلابة الجرمي عن خالد الحذاء عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9373","[9/270]      9346  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  رَجُلٍ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  أَبِي عُبَيْدَةَ ، قَالَ :  مَرَّ ابْنُ مَسْعُودٍ بِرَجُلٍ صَافَّ بَيْنَ قَدَمَيْهِ ،  فَقَالَ  : "" أَمَّا هَذَا فَقَدْ أَخْطَأَ السُّنَّةَ  ، لَوْ  رَاوَحَ  بَيْنَهُمَا كَانَ أَحَبَّ إِلَيَّ . ""","","Al-Mu'jam al-Kabir 9346","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن المنهال بن عمرو الأسدي عن رجل عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9374","9347  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ ،  ثَنَا  قَبِيصَةُ بْنُ عُقْبَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مَيْسَرَةَ بْنِ حَبِيبٍ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 9347","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن المنهال بن عمرو الأسدي عن ميسرة بن حبيب النهدي عن سفيان الثوري عن قبيصة بن عقبة السوائي عن حفص بن عمر سنجة ألف عن الطبراني","باب"
"9375","9348  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ، وَمُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيَّانِ ، قَالَا :  ثَنَا  عُمَرُ بْنُ مَرْزُوقٍ  ،  أَنَا  شُعْبَةُ ،  عَنْ  مَيْسَرَةَ بْنِ حَبِيبٍ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ، نَحْوَهُ .  كذا في طبعة مكتبة ابن تيمية ، والصواب: (عمرو بن مرزوق ) .","","Al-Mu'jam al-Kabir 9348","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن المنهال بن عمرو الأسدي عن ميسرة بن حبيب النهدي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن محمد بن محمد بن حيان التمار عن الطبراني","باب"
"9376","9349  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  ابْنِ مَسْعُودٍ قَالَ :  مَنْ أَدْرَكَ الرَّكْعَةَ فَقَدْ أَدْرَكَ الصَّلَاةَ  "" .","","Al-Mu'jam al-Kabir 9349","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9377","9350  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  مَنْ أَدْرَكَ الرَّكْعَةَ فَقَدْ أَدْرَكَ  "" .","","Al-Mu'jam al-Kabir 9350","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن سلمة بن كهيل الحضرمي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","باب"
"9378","9351  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ، أَنَّ هُبَيْرَةَ بْنَ يَرِيمَ  أَخْبَرَهُ  ،  عَنْ  عَلِيٍّ ، وَابْنِ مَسْعُودٍ ، قَالَا :  مَنْ لَمْ يُدْرِكِ الرَّكْعَةَ فَلَا يَعْتَدَّ بِالسَّجْدَةِ  "" .","","Al-Mu'jam al-Kabir 9351","","علي بن أبي طالب عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9379","9352  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ         [9/271]      أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  مَنْ فَاتَهُ الرُّكُوعُ فَلَا يَعْتَدَّ بِالسُّجُودِ  "" .","","Al-Mu'jam al-Kabir 9352","","عبد الله بن مسعود عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9380","9353  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  قَالَ  :  دَخَلْتُ أَنَا وَعَبْدُ اللهِ الْمَسْجِدَ ، وَالْقَوْمُ رُكُوعٌ فَرَكَعْنَا  ، ثُمَّ مَشَيْنَا حَتَّى دَخَلْنَا فِي  الْقَوْمِ  فَرَفَعُوا رُءُوسَهُمْ وَرَفَعْنَا مَعَهُمْ ، فَلَمَّا أَنْ فَرَغْنَا مِنَ الصَّلَاةِ قُمْتُ لِأَقْضِيَ ، فَحَدَّثَنِي  عَبْدُ اللهِ  ، فَقَالَ : "" قَدْ أَتْمَمْتَ الصَّلَاةَ  "" .","","Al-Mu'jam al-Kabir 9353","","عبد الله بن مسعود عن زيد بن وهب الجهني عن منصور بن المعتمر عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9381","9354  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مَنْصُورٍ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ، قَالَ :  دَخَلْتُ  أَنَا وَابْنُ مَسْعُودٍ الْمَسْجِدَ ، وَالْإِمَامُ رَاكِعٌ فَرَكَعْنَا ، ثُمَّ مَضَيْنَا حَتَّى اسْتَوَيْنَا بِالصَّفِّ  ، فَلَمَّا فَرَغَ الْإِمَامُ قُمْتُ أَقْضِي ، فَقَالَ : "" قَدْ أَدْرَكْتَهُ  "" .","","Al-Mu'jam al-Kabir 9354","","عبد الله بن مسعود عن زيد بن وهب الجهني عن منصور بن المعتمر عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9382","9355  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  قَالَ  :  دَخَلْتُ الْمَسْجِدَ مَعَ ابْنِ مَسْعُودٍ ، وَالنَّاسُ رُكُوعٌ فَرَكَعَ ، وَرَكَعْتُ مَعَهُ ، وَمَشَيْنَا رَاكِعَيْنِ فَانْتَهَيْنَا إِلَى الصَّفِّ  ، فَرَفَعُوا رُءُوسَهُمْ فَصَلَّيْنَا صَلَاتَنَا ، فَلَمَّا سَلَّمَ الْإِمَامُ ظَنَنْتُ أَنْ قَدْ فَاتَتْنِي ، فَقُمْتُ لِأَقْضِيَ ، فَجَذَبَنِي  ابْنُ مَسْعُودٍ  ، وَقَالَ : "" إِنَّكَ قَدْ أَدْرَكْتَ  "" .","","Al-Mu'jam al-Kabir 9355","","عبد الله بن مسعود عن زيد بن وهب الجهني عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9383","9356  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  قَتَادَةَ ،  أَنَّ  ابْنَ مَسْعُودٍ ، قَالَ :  لَا بَأْسَ أَنْ تَرْكَعَ دُونَ الصَّفِّ  "" .","","Al-Mu'jam al-Kabir 9356","","عبد الله بن مسعود عن قتادة بن دعامة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9384","9357  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ النَّخَعِيِّ ،  عَنْ  زَيْدِ بْنِ أَحْمَرَ ،  عَنِ         [9/272]      ابْنِ مَسْعُودٍ ، قَالَ :  إِذَا رَكَعَ أَحَدُكُمْ فَمَشَى إِلَى الصَّفِّ قَبْلَ أَنْ يَرْفَعُوا رُءُوسَهُمْ ، فَإِنَّهُ يَعْتَدُّ بِهَا  ، وَإِنْ رَفَعُوا رُءُوسَهُمْ قَبْلَ أَنْ يَصِلَ إِلَى الصَّفِّ فَلَا يَعْتَدُّ بِهَا  "" .","","Al-Mu'jam al-Kabir 9357","","عبد الله بن مسعود عن زيد بن أحمر عن عبد الله بن يزيد الصهباني عن حجاج بن أرطاة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9385","9358  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  قَتَادَةَ ،  أَنَّ  ابْنَ مَسْعُودٍ أَدْرَكَ قَوْمًا جُلُوسًا فِي آخِرِ صَلَاتِهِمْ ، فَقَالَ : "" قَدْ أَدْرَكْتُمْ إِنْ شَاءَ اللهُ  "" .","","Al-Mu'jam al-Kabir 9358","","عبد الله بن مسعود عن قتادة بن دعامة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9386","9359  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  قَالَ  :  دَخَلَ عَبْدُ اللهِ الْمَسْجِدَ ، وَدَخَلَ مَعَهُ ، فَرَكَعَ الْإِمَامُ فَرَكَعْنَا قَبْلَ أَنِ انْتَهَيْنَا إِلَى الصَّفِّ ، ثُمَّ انْتَهَيْنَا إِلَى الصَّفِّ حِينَ قَالَ الْإِمَامُ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، فَلَمَّا سَلَّمَ الْإِمَامُ قَامَ صَاحِبُ  عَبْدِ اللهِ  لِيَقْضِيَ ، فَأَخَذَ  عَبْدُ اللهِ  بِثَوْبِهِ ، فَقَالَ :  اجْلِسْ فَقَدْ أَدْرَكْتَ الصَّلَاةَ  "" .","","Al-Mu'jam al-Kabir 9359","","عبد الله بن مسعود عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9387","9360  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ الْمُلَائِيِّ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  أَنَّ  ابْنَ مَسْعُودٍ سَعَى إِلَى الصَّلَاةِ فَقِيلَ لَهُ فَقَالَ :  أَوَلَيْسَ أَحَقَّ مَا سَعَيْتُ إِلَيْهِ الصَّلَاةُ  ؟  "" .","","Al-Mu'jam al-Kabir 9360","","عبد الله بن مسعود عن سلمة بن كهيل الحضرمي عن عمرو بن قيس الملائي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9388","9361  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  إِذَا شَكَّ الرَّجُلُ فِي صَلَاتِهِ فَلَمْ يَدْرِ أَثَلَاثًا صَلَّى أَمِ اثْنَتَيْنِ ؟  فَلْيَبْنِ عَلَى أَوْثَقِ ذَلِكَ ، ثُمَّ يَسْجُدْ سَجْدَتَيِ السَّهْوِ  "" .","","Al-Mu'jam al-Kabir 9361","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9389","9362  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادٌ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبِيدَةَ السَّلْمَانِيِّ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّهُ قَالَ :  يَتَحَرَّى  أَصَوْبَ ذَلِكَ ، وَيَسْجُدُ سَجْدَتَيِ السَّهْوِ  ""  .","","Al-Mu'jam al-Kabir 9362","","عبد الله بن مسعود عن عبيدة بن عمرو السلماني عن إبراهيم النخعي عن طلحة بن مصرف الهمداني عن حجاج بن أرطاة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9390","9363  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا         [9/273]      زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنِ  الْأَسْوَدِ ، وَعَلْقَمَةَ ، وَأَصْحَابِ عَبْدِ اللهِ ،  أَنَّ  عَبْدَ اللهِ ، كَانَ يَقُولُ فِي السَّهْوِ :  يَتَحَرَّى  الصَّوَابَ  ، وَيَسْجُدُ سَجْدَتَيْنِ ، وَهُوَ جَالِسٌ بَعْدَ التَّسْلِيمِ  "" .","","Al-Mu'jam al-Kabir 9363","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9391","9364  -  حَدَّثَنَا  إِسْحَاقُ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  خُصَيْفٍ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  السَّهْوُ إِذَا قَامَ فِيمَا يُجْلَسُ فِيهِ  ، أَوْ قَعَدَ فِيمَا يُقَامُ فِيهِ ، أَوْ سَلَّمَ فِي رَكْعَتَيْنِ ، فَإِنَّهُ يَفْرَغُ مِنْ صَلَاتِهِ ، وَيَسْجُدُ سَجْدَتَيْنِ ، وَهُوَ جَالِسٌ يَتَشَهَّدُ فِيهِمَا  ""  .","","Al-Mu'jam al-Kabir 9364","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن خصيف الجزري عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9392","9365  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  سُفْيَانَ ،  عَنْ  خُصَيْفٍ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  إِذَا قُمْتَ أَوْ جَلَسْتَ أَوْ سَلَّمْتَ فَاسْجُدْ سَجْدَتَيِ السَّهْوِ  ، ثُمَّ تَشَهَّدْ ، ثُمَّ سَلِّمْ  ""  .","","Al-Mu'jam al-Kabir 9365","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن خصيف الجزري عن سفيان الثوري عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9393","9366  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  قَتَادَةَ ، أَوْ غَيْرِهِ  :  أَنَّ  ابْنَ مَسْعُودٍ رَأَى رَجُلَيْنِ يُصَلِّيَانِ ، أَحَدُهُمَا  مُسْبِلٌ  إِزَارَهُ ، وَالْآخَرُ لَا يُتِمُّ رُكُوعَهُ ، وَلَا سُجُودَهُ ، فَضَحِكَ ، فَقَالُوا : مَا يُضْحِكُكَ يَا  أَبَا عَبْدِ الرَّحْمَنِ  ؟ قَالَ :  عَجِبْتُ لِهَذَيْنِ الرَّجُلَيْنِ ، أَمَّا  الْمُسْبِلُ  إِزَارَهُ فَلَا يَنْظُرُ اللهُ إِلَيْهِ  ، وَأَمَّا الْآخَرُ فَلَا يَقْبَلُ اللهُ صَلَاتَهُ  ""  .","","Al-Mu'jam al-Kabir 9366","","عبد الله بن مسعود عن قتادة بن دعامة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9394","9367  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْحَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادٌ ،  أَنَا  حَمَّادٌ ،  عَنْ  إِبْرَاهِيمَ ،  قَالَ  :  بَيْنَا ابْنُ مَسْعُودٍ جَالِسٌ مَعَ أَصْحَابِهِ فِي الْمَسْجِدِ ، إِذْ دَخَلَ رَجُلَانِ فَقَامَا خَلْفَ سَارِيَتَيْنِ ، فَصَلَّى أَحَدُهُمَا قَدْ أَسْبَلَ إِزَارَهُ ، وَالْآخَرُ لَا يُتِمُّ رُكُوعَهُ وَلَا سُجُودَهُ ، فَجَعَلَ  ابْنُ مَسْعُودٍ  يَنْظُرُ إِلَيْهِمَا ، فَقَالَ جُلَسَاؤُهُ : لَقَدْ شَغَلَكَ هَذَانِ عَنَّا ، قَالَ : "" أَجَلْ ،  أَمَّا هَذَا فَلَا يَنْظُرُ اللهُ إِلَيْهِ -  يَعْنِي  الْمُسْبِلَ  إِزَارَهُ  - وَأَمَّا هَذَا فَلَا يَقْبَلُ اللهُ مِنْهُ  -  يَعْنِي الَّذِي لَا يُتِمُّ         [9/274]      رُكُوعَهُ وَلَا سُجُودَهُ  - ""  .","","Al-Mu'jam al-Kabir 9367","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9395","9368  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجٌ ،  ثَنَا  حَمَّادٌ ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنِ  ابْنِ مَسْعُودٍ ،  أَنَّهُ رَأَى أَعْرَابِيًّا يُصَلِّي قَدْ أَسْبَلَ إِزَارَهُ ، فَقَالَ :  الْمُسْبِلُ  إِزَارَهُ فِي الصَّلَاةِ لَيْسَ مِنَ اللهِ عَزَّ وَجَلَّ فِي حِلٍّ ، وَلَا حَرَامٍ  ""  .","","Al-Mu'jam al-Kabir 9368","","عبد الله بن مسعود عن أبو عثمان النهدي عن عاصم بن سليمان الأحول عن حماد بن زيد عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9396","9369  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  ابْنِ سِيرِينَ ،  عَنِ  ابْنِ مَسْعُودٍ ،  فِي الرَّجُلِ يَفُوتُهُ بَعْضُ الصَّلَاةِ مَعَ الْإِمَامِ  ، قَالَ : "" يَجْعَلُ مَا يُدْرِكُ مَعَ الْإِمَامِ آخِرَ صَلَاتِهِ  "" .","","Al-Mu'jam al-Kabir 9369","","عبد الله بن مسعود عن محمد بن سيرين عن قتادة بن دعامة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9397","9370  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّ  جُنْدُبًا  وَمَسْرُوقًا  ، أَدْرَكَا رَكْعَةً مِنَ الْمَغْرِبِ فَقَرَأَ  جُنْدُبٌ  ، وَلَمْ يَقْرَأْ  مَسْرُوقٌ  خَلْفَ الْإِمَامِ ، فَلَمَّا سَلَّمَ الْإِمَامُ قَامَا يَقْضِيَانِ ، فَجَلَسَ  مَسْرُوقٌ  فِي الثَّانِيَةِ وَالثَّالِثَةِ ، وَقَامَ  جُنْدُبٌ  فِي الثَّانِيَةِ فَلَمْ يَجْلِسْ ، فَلَمَّا انْصَرَفَا تَذَاكَرَا ذَلِكَ ،  فَأَتَيَا  ابْنَ مَسْعُودٍ فَقَالَ : ""  كُلٌّ قَدْ أَصَابَ - أَوْ قَالَ : كُلٌّ قَدْ أَحْسَنَ  -  وَنَفْعَلُ كَمَا فَعَلَ  مَسْرُوقٌ  ""  .","","Al-Mu'jam al-Kabir 9370","","عبد الله بن مسعود عن الشعبي عن جابر الجعفي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9398","9371  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  جَعْفَرٍ الْجَزَرِيِّ ،  عَنِ  الْحَكَمِ ،  أَنَّ  جُنْدُبًا  ،  وَمَسْرُوقًا  أَدْرَكَا رَكْعَةً مِنَ الْمَغْرِبِ  فَقَرَأَ أَحَدُهُمَا فِي الرَّكْعَتَيْنِ الْأَخِيرَتَيْنِ مَا فَاتَهُ مِنَ الْقِرَاءَةِ ، وَلَمْ يَقْرَأِ الْآخَرُ فِي رَكْعَةٍ ،  فَسُئِلَ  ابْنُ مَسْعُودٍ ، فَقَالَ : "" كِلَاهُمَا مُحْسِنٌ ، وَإِنِّي أَصْنَعُ كَمَا صَنَعَ هَذَا الَّذِي قَرَأَ فِي الرَّكْعَتَيْنِ  ""  .","","Al-Mu'jam al-Kabir 9371","","عبد الله بن مسعود عن الحكم بن عتيبة الكندي عن جعفر بن برقان الكلابي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9399","9372  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  جُنْدُبًا  وَمَسْرُوقًا  "" أَدْرَكَا مِنْ صَلَاةِ الْمَغْرِبِ رَكْعَةً  ، فَلَمَّا سَلَّمَ الْإِمَامُ قَامَا يَقْضِيَانِ ، فَقَامَ  جُنْدُبٌ  فِي الرَّكْعَةِ         [9/275]      الثَّانِيَةِ ، وَقَعَدَ  مَسْرُوقٌ  فِيهِمَا جَمِيعًا ، فَقَالَا لِابْنِ مَسْعُودٍ ،  فَقَالَ  : "" كِلَاكُمَا قَدْ أَحْسَنَ ، وَأَصْنَعُ كَمَا صَنَعَ  مَسْرُوقٌ  ""  .","","Al-Mu'jam al-Kabir 9372","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9400","9373  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  قَالَ  :  صَلَّى  جُنْدُبٌ  وَمَسْرُوقٌ  فِي مَسْجِدٍ الْمَغْرِبَ ، وَلَمْ يُدْرِكَا مَعَ الْإِمَامِ إِلَّا رَكْعَةً  ، فَقَامَا يَقْضِيَانِ ، فَقَعَدَ  مَسْرُوقٌ  فِي الثَّانِيَةِ ، وَقَامَ  جُنْدُبٌ  فِي أَوَّلِ رَكْعَةٍ مِنَ الْقَضَاءِ ، فَأَتَيَا عَبْدَ اللهِ ، فَذَكَرَا ذَلِكَ لَهُ فَقَالَ : "" كِلَاكُمَا قَدْ أَحْسَنَ ، وَافْعَلُوا كَمَا فَعَلَ  مَسْرُوقٌ  ""  .","","Al-Mu'jam al-Kabir 9373","","عبد الله بن مسعود عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9401","9374  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سُلَيْمَانَ الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  مَسْرُوقًا  ،  وَجُنْدُبًا  انْتَهَيَا إِلَى الْإِمَامِ وَقَدْ سُبِقَا بِرَكْعَةٍ  ، فَلَمْ يَقْرَأْ  مَسْرُوقٌ  وَقَرَأَ  جُنْدُبٌ  ،  فَذَكَرُوا  ذَلِكَ لِعَبْدِ اللهِ ، فَقَالَ : كِلَاكُمَا لَمْ يَأْلُ عَنِ الْأَمْرِ ، وَالْقَوْلُ مَا صَنَعَ  مَسْرُوقٌ  ""  .","","Al-Mu'jam al-Kabir 9374","","عبد الله بن مسعود عن إبراهيم النخعي عن الأعمش عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","باب"
"9402","9375  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  قَتَادَةَ ،  أَنَّ  ابْنَ مَسْعُودٍ ، قَالَ :  إِنَّ لِلصَّلَاةِ وَقْتًا كَوَقْتِ  الْحَجِّ  ""  .","","Al-Mu'jam al-Kabir 9375","","عبد الله بن مسعود عن قتادة بن دعامة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9403","9376  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  سَوُّوا صُفُوفَكُمْ فَإِنَّ الشَّيْطَانَ يَتَخَلَّلُهَا  كَالْخَذْفِ - أَوْ كَأَوْلَادِ الْخَذْفِ -  ""  .","","Al-Mu'jam al-Kabir 9376","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن سلمة بن كهيل الحضرمي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","باب"
"9404","9377  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  لَا يُرْكَعُ قَبْلَ الْإِمَامِ ، وَلَا يُرْفَعُ قَبْلَهُ  ، وَلَا يُسْجَدُ قَبْلَهُ ، وَلَا يُرْفَعُ قَبْلَهُ  ""  .","","Al-Mu'jam al-Kabir 9377","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9405","9378  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِنَّمَا جُعِلَ الْإِمَامُ لِيُؤْتَمَّ بِهِ  ، فَإِذَا رَكَعَ فَارْكَعُوا ، وَإِذَا رَفَعَ فَارْفَعُوا ، وَلَا تَسْبِقُوهُ إِذَا رَكَعَ ، وَلَا إِذَا رَفَعَ ،         [9/276]      وَلَا إِذَا سَجَدَ ، فَإِنْ كُنْتُمْ إِنَّمَا بِكُمْ أَنْ تُدْرِكُوا مَا سَبَقَكُمْ بِهِ ، فَإِنَّهُ يَسْجُدُ قَبْلَكُمْ ، وَيَرْفَعُ قَبْلَكُمْ ، فَتُدْرِكُوا ذَلِكَ  ""  .","","Al-Mu'jam al-Kabir 9378","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9406","9379  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  شَيْخٍ مِنْ طَيِّئٍ ،  قَالَ  :  مَرَّ ابْنُ مَسْعُودٍ عَلَى مَسْجِدٍ لَنَا ، فَتَقَدَّمَ  رَجُلٌ  مِنْهُمْ فَقَرَأَ بِفَاتِحَةِ الْكِتَابِ  ، ثُمَّ قَالَ : نَحُجُّ بَيْتَ رَبِّنَا ، وَنَقْضِي الدَّيْنَ ، وَهُوَ مِثْلُ الْقَطَوَاتِ يَهْوِينَ ، فَقَالَ  عَبْدُ اللهِ  : ""مَا سَمِعْنَا بِهَذَا فِي الْمِلَّةِ الْآخِرَةِ إِنْ هَذَا إِلَّا  اخْتِلَاقٌ  "" فَانْصَرَفَ  عَبْدُ اللهِ  .","","Al-Mu'jam al-Kabir 9379","","عبد الله بن مسعود عن شيخ من طيئ عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9407","9380  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  عَلْقَمَةَ  ،  وَالْأَسْوَدَ  ، ""  أَقْبَلَا مَعَ  ابْنِ مَسْعُودٍ إِلَى الْمَسْجِدِ "" فَاسْتَقْبَلَهُمُ النَّاسُ قَدْ صَلَّوْا  ، فَرَجَعَ بِهِمَا إِلَى الْبَيْتِ ، فَجَعَلَ أَحَدَهُمَا عَنْ يَمِينِهِ ، وَالْآخَرَ عَنْ شِمَالِهِ ، ثُمَّ صَلَّى بِهِمَا  ""  .","","Al-Mu'jam al-Kabir 9380","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9408","9381  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  أَنَّ  عَبْدَ اللهِ صَلَّى  بِعَلْقَمَةَ  وَالْأَسْوَدِ  ، فَقَامَ هَذَا عَنْ يَمِينِهِ  وَهَذَا عَنْ يَسَارِهِ ، ثُمَّ قَامَ بَيْنَهُمَا  "" .","","Al-Mu'jam al-Kabir 9381","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9409","9382  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادٌ ،  عَنْ  دَاوُدَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَلْقَمَةَ ،  أَنَّ  ابْنَ مَسْعُودٍ صَلَّى بِهِ  وَبِالْأَسْوَدِ  فَقَامَ بَيْنَهُمَا .  ""","","Al-Mu'jam al-Kabir 9382","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن الشعبي عن داود بن أبي هند عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9410","9383  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجٌ ،  ثَنَا  حَمَّادٌ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  ابْنِ مَسْعُودٍ ، مِثْلَ ذَلِكَ .","","Al-Mu'jam al-Kabir 9383","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9411","9384  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ         [9/277]      الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  إِذَا كَانُوا ثَلَاثَةً فَلْيَصُفُّوا جَمِيعًا  ، وَإِذَا كَانُوا أَكْثَرَ مِنْ ذَلِكَ فَلْيَتَقَدَّمْهُمْ أَحَدُهُمْ  ""  .","","Al-Mu'jam al-Kabir 9384","","عبد الله بن مسعود عن إبراهيم النخعي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9412","9385  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي مُوسَى ، قَالَ :  جَاءَ ابْنُ مَسْعُودٍ ، وَالْإِمَامُ يُصَلِّي الصُّبْحَ ، فَصَلَّى رَكْعَتَيْنِ  إِلَى سَارِيَةٍ ، وَلَمْ يَكُنْ صَلَّى رَكْعَتَيِ الْفَجْرِ .  ""","","Al-Mu'jam al-Kabir 9385","","عبد الله بن مسعود عن عبد الله بن أبي موسى الأشعري عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9413","9386  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي مُوسَى ،  عَنِ  ابْنِ مَسْعُودٍ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 9386","","عبد الله بن مسعود عن عبد الله بن أبي موسى الأشعري عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9414","9387  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي مُوسَى ،  عَنْ  أَبِيهِ  ، قَالَ :  أُقِيمَتِ الصَّلَاةُ فَتَقَدَّمَ عَبْدُ اللهِ إِلَى الْمَسْجِدِ فَصَلَّى رَكْعَتَيْنِ ، ثُمَّ دَخَلَ الْمَسْجِدَ  ""  .","","Al-Mu'jam al-Kabir 9387","","عبد الله بن مسعود عن أبو موسى الأشعري عن عبد الله بن أبي موسى الأشعري عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9415","9388  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ دِينَارٍ ،  أَنَّ  ابْنَ مَسْعُودٍ ، كَانَ يَقُولُ :  احْمِلُوا حَوَائِجَكُمْ عَلَى الْمَكْتُوبَةِ  ""  .","","Al-Mu'jam al-Kabir 9388","","عبد الله بن مسعود عن عمرو بن دينار الأثرم عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9416","9389  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ،  عَنْ  عَبْدِ اللهِ بْنِ زِيَادٍ الْأَسَدِيِّ ، قَالَ :  سَمِعْتُ  قِرَاءَةَ عَبْدِ اللهِ ، فِي إِحْدَى صَلَاتَيِ النَّهَارِ  ""  .","","Al-Mu'jam al-Kabir 9389","","عبد الله بن مسعود عن عبد الله بن زياد الأسدي عن أشعث بن أبي الشعثاء عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9417","9390  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  قَالَ  :  صَلَّيْتُ إِلَى جَنْبِ عَبْدِ اللهِ ، فَمَا عَلِمْتُ أَنَّهُ يَقْرَأُ شَيْئًا حَتَّى سَمِعْتُهُ  ، يَقُولُ :         {      رَبِّ زِدْنِي عِلْمًا         }      فَعَرَفْتُ أَنَّهُ         [9/278]      فِي طه  ""  .","","Al-Mu'jam al-Kabir 9390","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9418","9391  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  حُصَيْنٍ ،  عَنِ  الْهَيْثَمِ بْنِ شِهَابٍ ، قَالَ :  سَمِعْتُ  ابْنَ مَسْعُودٍ ، يَقُولُ :  لَأَنْ يَقْعُدَ أَحَدُكُمْ عَلَى رَضْفَتَيْنِ خَيْرٌ لَهُ مِنْ أَنْ يَقْعُدَ فِي الصَّلَاةِ مُتَرَبِّعًا  ""  .","","Al-Mu'jam al-Kabir 9391","","عبد الله بن مسعود عن الهيثم بن شهاب السلمي عن حصين بن عبد الرحمن السلمي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9419","9392  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  هَيْثَمِ بْنِ شِهَابٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  لَأَنْ يَجْلِسَ الرَّجُلُ عَلَى رَضِيفَتَيْنِ خَيْرٌ لَهُ مِنْ أَنْ يَجْلِسَ فِي الصَّلَاةِ مُتَرَبِّعًا  ""  قَالَ  عَبْدُ الرَّزَّاقِ  : يَقُولُ : ""  إِذَا كَانَ صَلَّى قَائِمًا فَلَا يَجْلِسْ يَتَشَهَّدُ مُتَرَبِّعًا  ، وَإِذَا صَلَّى قَاعِدًا فَلْيَتَرَبَّعْ  ""  .","","Al-Mu'jam al-Kabir 9392","","عبد الله بن مسعود عن الهيثم بن شهاب السلمي عن حصين بن عبد الرحمن السلمي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9420","9393  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي حَمْزَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  ابْنِ مَسْعُودٍ ،  أَنَّهُ قَالَ فِي الْمَرِيضِ إِذَا صَلَّى :  إِنْ لَمْ يَقْدِرْ عَلَى الْأَرْضِ فَلْيُومِئْ إِيمَاءً ،  وَلْيَجْعَلْ سُجُودَهُ أَخْفَضَ مِنْ رُكُوعِهِ  ""  .","","Al-Mu'jam al-Kabir 9393","","عبد الله بن مسعود عن إبراهيم النخعي عن ميمون القصاب عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9421","9394  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  زَيْدِ بْنِ مُعَاوِيَةَ ،  عَنْ  عَلْقَمَةَ ، وَالْأَسْوَدِ ،  أَنَّ  ابْنَ مَسْعُودٍ ، دَخَلَ عَلَى  عُتْبَةَ  أَخِيهِ وَهُوَ يُصَلِّي عَلَى سِوَاكٍ يَرْفَعُهُ إِلَى وَجْهِهِ ، فَأَخَذَهُ فَرَمَاهُ  ، ثُمَّ قَالَ : "" أَوْمِئْ إِيمَاءً ، وَلْيَكُنْ رَكْعَتُكَ أَرْفَعَ مِنْ سَجْدَتِكَ  ""  .","","Al-Mu'jam al-Kabir 9394","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن زيد بن معاوية العبسي عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9422","9395  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  قَالَ  :  دَخَلَ  عَلْقَمَةُ  وَالْأَسْوَدُ  عَلَى عَبْدِ اللهِ ، فَقَالَا : إِنَّ  أُمَّ الْأَسْوَدِ  أُقْعِدَتْ ، وَإِنَّهُ يَرْكُزُ لَهَا عُودَ الْمِرْوَحَةِ تُصَلِّي عَلَيْهِ فَمَا تَرَى ؟ قَالَ :  إِنِّي لَأَرَى الشَّيْطَانَ يَعْرِضُ بِالْعُودِ ، لِتَسْجُدْ عَلَى الْأَرْضِ  إِنِ اسْتَطَاعَتْ ،         [9/279]      وَإِلَّا تُومِئْ إِيمَاءً  "" .","","Al-Mu'jam al-Kabir 9395","","عبد الله بن مسعود عن إبراهيم النخعي عن منصور بن المعتمر عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9423","9396  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضْرِ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  قُلْتُ  لِعَلْقَمَةَ : كَيْفَ كَانَتْ قِرَاءَةُ عَبْدِ اللهِ ؟ قَالَ :  كَانَ يَسْمَعُ صَوْتَهُ أَهْلُ الدَّارِ  ""  .","","Al-Mu'jam al-Kabir 9396","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9424","9397  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ،  عَنِ  الْأَسْوَدِ بْنِ هِلَالٍ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  لَمْ يُخَافِتْ مَنْ أَسْمَعَ نَفْسَهُ  ""  .","","Al-Mu'jam al-Kabir 9397","","عبد الله بن مسعود عن الأسود بن هلال المحاربي عن أشعث بن أبي الشعثاء عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9425","9398  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ،  عَنِ  الْأَسْوَدِ بْنِ هِلَالٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  لَمْ يُخَافِتْ مَنْ أَسْمَعَ أُذُنَيْهِ .  ""","","Al-Mu'jam al-Kabir 9398","","عبد الله بن مسعود عن الأسود بن هلال المحاربي عن أشعث بن أبي الشعثاء عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9426","9399  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ، وَأَبُو الْأَحْوَصِ ، وَيَعْلَى بْنُ الْحَارِثِ ، وَأَبُو عَوَانَةَ ،  عَنْ  أَشْعَثَ ،  عَنِ  الْأَسْوَدِ بْنِ هِلَالٍ ،  عَنْ  عَبْدِ اللهِ مِثْلَهُ","","Al-Mu'jam al-Kabir 9399","","عبد الله بن مسعود عن الأسود بن هلال المحاربي عن أشعث بن أبي الشعثاء عن الوضاح بن عبد الله اليشكري عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9427","9400  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  الْأَعْمَشِ ، وَالْحَسَنِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  جَامِعِ بْنِ شَدَّادٍ ،  عَنِ  الْأَسْوَدِ بْنِ هِلَالٍ ،  عَنْ  عَبْدِ اللهِ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 9400","","عبد الله بن مسعود عن الأسود بن هلال المحاربي عن جامع بن شداد عن الحسن بن عبيد الله النخعي عن حفص بن غياث النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9428","9401  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  سَأَلْنَا  عَلْقَمَةَ : كَيْفَ كَانَتْ قِرَاءَةُ عَبْدِ اللهِ مِنَ اللَّيْلِ ؟  وَكَانَ يَبِيتُ عِنْدَهُ ،  قَالَ  : "" كَانَ يُسْمِعُ  آلَ عُتْبَةَ  أَخِيهِ ، وَهُمْ فِي حُجْرَةٍ بَيْنَ يَدَيْهِ  ""  .","","Al-Mu'jam al-Kabir 9401","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9429","9402  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ قَالَ : كَانَ عَلْقَمَةُ يَبِيتُ عِنْدَ  عَبْدِ اللهِ         [9/280]      فَسَأَلْنَاهُ  :  كَيْفَ كَانَ عَبْدُ اللهِ يَقْرَأُ ؟  قَالَ : "" كَانَ يُسْمِعُ  آلَ عُتْبَةَ  ، وَهُمْ فِي حُجْرَةٍ بَيْنَ يَدَيْهِ  ""  .","","Al-Mu'jam al-Kabir 9402","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9430","9403  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ ، قَالَ :  سَأَلْتُهُ  ، وَكَانَ يَبِيتُ عِنْدَ عَبْدِ اللهِ بْنِ مَسْعُودٍ :  مَتَى كَانَ  عَبْدُ اللهِ  يُوتِرُ ؟  قَالَ : "" كَانَ يُوتِرُ حِينَ يَبْقَى عَلَيْهِ مِنَ اللَّيْلِ مِثْلُ مَا ذَهَبَ مِنَ اللَّيْلِ حِينَ صَلَاةِ الْمَغْرِبِ  ""  .","","Al-Mu'jam al-Kabir 9403","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9431","9404  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  عَلْقَمَةَ بْنِ قَيْسٍ ، قَالَ :  بِتُّ مَعَ  عَبْدِ اللهِ بْنِ مَسْعُودٍ لَيْلَةً ، فَقَامَ أَوَّلَ اللَّيْلِ ، ثُمَّ قَامَ يُصَلِّي  ، فَكَانَ يَقْرَأُ قِرَاءَةَ الْإِمَامِ فِي مَسْجِدِ حَيِّهِ ،  يُرَتِّلُ  ، وَلَا  يُرَجِّعُ  ، يُسْمِعُ مَنْ حَوْلَهُ ، وَلَا يَرْفَعُ صَوْتَهُ ، حَتَّى لَمْ يَبْقَ عَلَيْهِ مِنَ  الْغَلَسِ  إِلَّا كَمَا بَيْنَ الْأَذَانِ لِلْمَغْرِبِ إِلَى انْصِرَافٍ مِنْهَا ، ثُمَّ أَوْتَرَ  ""  .","","Al-Mu'jam al-Kabir 9404","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9432","9405  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  ثَنَا  عَلْقَمَةُ ،  أَنَّ  عَبْدَ اللهِ كَانَ يُوتِرُ إِذَا بَقِيَ مِنَ اللَّيْلِ نَحْوُ مَا ذَهَبَ إِلَى صَلَاةِ الْمَغْرِبِ  ""  .","","Al-Mu'jam al-Kabir 9405","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9433","9406  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ،  عَنِ  الْأَسْوَدِ بْنِ هِلَالٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  الْوِتْرُ  مَا بَيْنَ الصَّلَاتَيْنِ  ""  .","","Al-Mu'jam al-Kabir 9406","","عبد الله بن مسعود عن الأسود بن هلال المحاربي عن أشعث بن أبي الشعثاء عن الوضاح بن عبد الله اليشكري عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9434","9407  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ، وَأَبِي حَصِينٍ ،  عَنِ  الْأَسْوَدِ بْنِ هِلَالٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  الْوِتْرُ  مَا بَيْنَ الصَّلَاتَيْنِ  ""  .","","Al-Mu'jam al-Kabir 9407","","عبد الله بن مسعود عن الأسود بن هلال المحاربي عن أشعث بن أبي الشعثاء عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9435","9408  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  شَرِيكٌ ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ، وَأَبِي حَصِينٍ ، وَعَيَّاشٍ الْعَامِرِيِّ ،  عَنِ  الْأَسْوَدِ بْنِ هِلَالٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  الْوِتْرُ  مَا بَيْنَ الصَّلَاتَيْنِ  صَلَاةِ الْعِشَاءِ ، وَصَلَاةِ         [9/281]      الْفَجْرِ  ""  .","","Al-Mu'jam al-Kabir 9408","","عبد الله بن مسعود عن الأسود بن هلال المحاربي عن عياش بن عمرو العامري عن شريك بن عبد الله النخعي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9436","9409  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  أَبُو حَصِينٍ الْأَسَدِيُّ ،  عَنِ  الْأَسْوَدِ بْنِ هِلَالٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  مَا بَيْنَ الصَّلَاتَيْنِ  وِتْرٌ  ، مَا بَيْنَ صَلَاةِ الْعِشَاءِ ، وَصَلَاةِ الْفَجْرِ .  ""","","Al-Mu'jam al-Kabir 9409","","عبد الله بن مسعود عن الأسود بن هلال المحاربي عن عثمان بن عاصم بن حصين عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9437","9410  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ بْنِ هِلَالٍ ،  عَنْ  عَبْدِ اللهِ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 9410","","عبد الله بن مسعود عن الأسود بن هلال المحاربي عن إبراهيم النخعي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9438","9411  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  أَنَّ  ابْنَ مَسْعُودٍ ، قَالَ :  الْوِتْرُ  مَا بَيْنَ الصَّلَاتَيْنِ  ""  .","","Al-Mu'jam al-Kabir 9411","","عبد الله بن مسعود عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9439","9412  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنِ  الْأَسْوَدِ بْنِ هِلَالٍ ، قَالَ :  أَشْهَدُ عَلَى عَبْدِ اللهِ بْنِ مَسْعُودٍ لَقَدْ  سَمِعْتُهُ  يُنَادِي بِهَا  نِدَاءً  :  الْوِتْرُ  مَا بَيْنَ الصَّلَاتَيْنِ  ؛ صَلَاةِ الْعِشَاءِ الْآخِرَةِ الَّتِي تُسَمُّونَ  الْعَتَمَةَ  ، وَصَلَاةِ الْفَجْرِ ، مَتَى أَوْتَرْتَ فَحَسَنٌ  ""  .","","Al-Mu'jam al-Kabir 9412","","عبد الله بن مسعود عن الأسود بن هلال المحاربي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9440","9413  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  أَبِي بَكْرِ بْنِ مُحَمَّدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ، قَالَ : ""  كَانَ ابْنُ مَسْعُودٍ "" يُوتِرُ بَعْدَ الْفَجْرِ  "" ،  وَكَانَ أَبِي يُوتِرُ قَبْلَ الْفَجْرِ  ""  .","","Al-Mu'jam al-Kabir 9413","","عبد الله بن مسعود عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أبو بكر بن عبد الله بن محمد بن أبي سبرة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9441","9414  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  مَا بَالَيْتُ أَنَّ صَلَاةَ الْفَجْرِ أُقِيمَتْ وَأَنَا أُوتِرُ  ""  .","","Al-Mu'jam al-Kabir 9414","","عبد الله بن مسعود عن هشام بن عروة بن الزبير عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9442","9415  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ         [9/282]      بْنُ سَلَمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّهُ قَالَ :  مَا  أُبَالِي  أَنْ  يُثَوَّبَ  لِصَلَاةِ الْفَجْرِ وَأَنَا فِي وِرْدِي لَمْ أُوتِرْ بَعْدُ  ""  .","","Al-Mu'jam al-Kabir 9415","","عبد الله بن مسعود عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9443","9416  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْقَاسِمُ بْنُ مَعْنٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ،  عَنْ  أَبِي مَيْسَرَةَ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى  عَبْدِ اللهِ ، فَقَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  : هَلْ بَعْدَ الْأَذَانِ  وِتْرٌ  ؟  قَالَ : "" نَعَمْ ، وَبَعْدَ الْإِقَامَةِ  ""  .","","Al-Mu'jam al-Kabir 9416","","عبد الله بن مسعود عن عمرو بن شرحبيل الهمداني عن إبراهيم بن محمد بن المنتشر الهمداني عن القاسم بن معن عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9444","9417  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ  ،  أَنَّ  عَبْدَ اللهِ كَانَ يُوتِرُ بِثَلَاثٍ فَأَعْلَى  ""  .","","Al-Mu'jam al-Kabir 9417","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9445","9418  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ  ، قَالَ :  كَانَ عَبْدُ اللهِ يُوتِرُ بِثَلَاثٍ فَأَعْلَى  ""  .","","Al-Mu'jam al-Kabir 9418","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9446","9419  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مَالِكِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ :  قَالَ  ابْنُ مَسْعُودٍ :  وِتْرُ  اللَّيْلِ  كَوِتْرِ  النَّهَارِ صَلَاةِ الْمَغْرِبِ ثَلَاثًا  ""  .","","Al-Mu'jam al-Kabir 9419","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن مالك بن الحارث السلمي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9447","9420  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مَالِكِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  الْوِتْرُ  ثَلَاثٌ  كَوِتْرِ  النَّهَارِ ؛ صَلَاةِ الْمَغْرِبِ  ""  .","","Al-Mu'jam al-Kabir 9420","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن مالك بن الحارث السلمي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9448","9421  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الْحَجَّاجِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  الْوِتْرُ  ثَلَاثُ رَكَعَاتٍ كَصَلَاةِ الْمَغْرِبِ  ""  .","","Al-Mu'jam al-Kabir 9421","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن حجاج بن أرطاة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9449","[9/283]      9422  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْقَاسِمُ بْنُ مَعْنٍ ،  عَنْ  حُصَيْنٍ ،  قَالَ  :  بَلَغَ ابْنَ مَسْعُودٍ أَنَّ  سَعْدًا  يُوتِرُ بِرَكْعَةٍ  ، قَالَ : "" مَا أَجْزَأَتْ رَكْعَةٌ قَطُّ  ""  .","","Al-Mu'jam al-Kabir 9422","","عبد الله بن مسعود عن حصين بن عبد الرحمن السلمي عن القاسم بن معن عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9450","9423  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ لِسَعْدِ بْنِ أَبِي وَقَّاصٍ : "" تُوتِرُ بِوَاحِدَةٍ ؟  فَقَالَ  سَعْدٌ  : أَوَلَيْسَ إِنَّمَا  الْوِتْرُ  وَاحِدَةٌ ؟ قَالَ  عَبْدُ اللهِ  : "" بَلَى ، وَلَكِنْ ثَلَاثٌ أَفْضَلُ "" ، فَقَالَ  سَعْدٌ  : فَإِنِّي لَا أَزِيدُ عَلَيْهَا ، فَغَضِبَ  عَبْدُ اللهِ  ، فَقَالَ  سَعْدٌ  : "" أَتَغْضَبُ عَلَيَّ أَنْ أُوتِرَ بِرَكْعَةٍ ، وَأَنْتَ تُوَرِّثُ ثَلَاثَ جَدَّاتٍ ، أَفَلَا تُوَرِّثُ  لِحَوَّاءَ  امْرَأَةِ  آدَمَ  ؟  ""  أَخْبَرَنِيهِ  يَحْيَى ،  عَنِ  الثَّوْرِيِّ  .","","Al-Mu'jam al-Kabir 9423","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9451","9424  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنِ  ابْنِ سِيرِينَ ، قَالَ :  سَمَرَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ وَحُذَيْفَةُ بْنُ الْيَمَانِ عِنْدَ  الْوَلِيدِ بْنِ عُقْبَةَ بْنِ أَبِي مُعَيْطٍ  ، ثُمَّ خَرَجَا مِنْ عِنْدِهِ فَقَامَا يَتَحَدَّثَانِ حَتَّى رَأَيَا تَبَاشِيرَ الْفَجْرِ "" فَأَوْتَرَ كُلُّ وَاحِدٍ مِنْهُمَا بِرَكْعَةٍ  ""  .","","Al-Mu'jam al-Kabir 9424","","حذيفة بن اليمان عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن إسماعيل بن عبد الله بن الحارث الأزدي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9452","9425  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  لَيْثٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ عَبْدُ اللهِ يَقْرَأُ فِي آخِرِ رَكْعَةٍ مِنَ  الْوِتْرِ  :         {      قُلْ هُوَ اللهُ أَحَدٌ         }      ، ثُمَّ يَرْفَعُ يَدَيْهِ فَيَقْنُتُ قَبْلَ الرَّكْعَةِ  ""  .","","Al-Mu'jam al-Kabir 9425","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن ليث بن أبي سليم عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9453","9426  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبَانَ ،  عَنِ  النَّخَعِيِّ ،  أَنَّ  ابْنَ مَسْعُودٍ كَانَ يَقْنُتُ السَّنَةَ كُلَّهَا فِي  الْوِتْرِ  ""  .","","Al-Mu'jam al-Kabir 9426","","عبد الله بن مسعود عن إبراهيم النخعي عن أبان بن أبي عياش عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9454","[9/284]      9427  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  غَيْرِ وَاحِدٍ مِنْ أَصْحَابِ عَبْدِ اللهِ :  أَنَّ  ابْنَ مَسْعُودٍ ، كَانَ يَقُولُ :  إِذَا أَوْتَرَ أَحَدُكُمْ ثُمَّ نَامَ فَقَامَ ، فَلْيَنْقُضْ  وِتْرَهُ  ، وَلْيُصَلِّ إِلَيْهَا رَكْعَةً أُخْرَى ، ثُمَّ لْيُوتِرْ بَعْدَ ذَلِكَ  ""  .","","Al-Mu'jam al-Kabir 9427","","عبد الله بن مسعود عن غير واحد من أصحاب عبد الله عن عطاء بن السائب عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9455","9428  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَلْقَمَةَ بْنِ قَيْسٍ ،  أَنَّ  ابْنَ مَسْعُودٍ كَانَ لَا يَقْنُتُ فِي صَلَاةِ الْفَجْرِ  ""  .","","Al-Mu'jam al-Kabir 9428","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9456","9429  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَلْقَمَةَ ، وَالْأَسْوَدِ ،  أَنَّ  ابْنَ مَسْعُودٍ كَانَ لَا يَقْنُتُ فِي صَلَاةِ الْغَدَاةِ  ""  .","","Al-Mu'jam al-Kabir 9429","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9457","9430  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  أَبُو الْعُمَيْسِ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ الْأَسْوَدِ ، قَالَ :  كَانَ عَبْدُ اللهِ لَا يَقْنُتُ فِي صَلَاةِ الْغَدَاةِ  ، وَإِذَا قَنَتَ فِي  الْوِتْرِ  قَنَتَ قَبْلَ الرَّكْعَةِ  ""  .","","Al-Mu'jam al-Kabir 9430","","عبد الله بن مسعود عن عبد الرحمن بن الأسود النخعي عن عتبة بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","باب"
"9458","9431  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  حُصَيْنُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  لَمْ يَكُنْ عَبْدُ اللهِ بْنُ مَسْعُودٍ يَقْنُتُ فِي صَلَاةِ الْغَدَاةِ  ""  .","","Al-Mu'jam al-Kabir 9431","","عبد الله بن مسعود عن إبراهيم النخعي عن حصين بن عبد الرحمن السلمي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9459","9432  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادٌ ،  عَنْ  أَبِي حَمْزَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّهُ :  كَانَ يَقْنُتُ فِي  الْوِتْرِ  قَبْلَ الرُّكُوعِ  ، وَلَا يَقْنُتُ فِي صَلَاةِ الْفَجْرِ  ""  .","","Al-Mu'jam al-Kabir 9432","","عبد الله بن مسعود عن ميمون القصاب عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9460","9433  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَنَا  الْحَجَّاجُ ،  عَنْ  أَبِي إِسْحَاقَ ،  أَنَّ  الْوَلِيدَ بْنَ عُقْبَةَ  بَعَثَ إِلَى حُذَيْفَةَ ،         [9/285]      وَابْنِ مَسْعُودٍ  يَسْأَلُهُمَا  عَنِ الصَّلَاةِ يَوْمَ الْعِيدِ  ، فَأُقِيمَتْ صَلَاةُ الْفَجْرِ فَقَامَ  ابْنُ مَسْعُودٍ  خَلْفَ سَارِيَةٍ فَصَلَّى رَكْعَتَيْنِ ، ثُمَّ دَخَلَ مَعَهُمْ  ""  .","","Al-Mu'jam al-Kabir 9433","","عبد الله بن مسعود عن أبو إسحاق السبيعي عن حجاج بن أرطاة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9461","9434  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ  ،  أَنَّهُ : "" كَانَ يَعِزُّ عَلَيْهِ أَنْ يَسْمَعَ مُتَكَلِّمًا بَعْدَ طُلُوعِ الْفَجْرِ إِلَى أَنْ يُصَلَّى الصُّبْحَ  ""  .","","Al-Mu'jam al-Kabir 9434","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9462","9435  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ  ، أَنَّهُ :  كَانَ يَكْرَهُ إِذَا صَلَّى الرَّكْعَتَيْنِ قَبْلَ الْفَجْرِ أَنْ يَتَكَلَّمَ  ""  .","","Al-Mu'jam al-Kabir 9435","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","باب"
"9463","9436  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ بْنِ عَبْدِ اللهِ ،  قَالَ  :  كَانَ عَزِيزًا عَلَى عَبْدِ اللهِ بْنِ مَسْعُودٍ ، أَنْ يَتَكَلَّمَ بَعْدَ الْفَجْرِ إِلَّا بِذِكْرِ اللهِ  ""  .","","Al-Mu'jam al-Kabir 9436","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9464","9437  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ  ، قَالَ :  لَمْ تَكُنْ سَاعَةٌ مِنَ السَّاعَاتِ أَشَدُّ عَلَى ابْنِ مَسْعُودٍ  ، أَنْ يَسْمَعَ فِيهَا مُتَكَلِّمًا مِنْ لَدُنِ انْشِقَاقِ الْفَجْرِ إِلَى طُلُوعِ الشَّمْسِ  ""  .","","Al-Mu'jam al-Kabir 9437","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن حجاج بن أرطاة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9465","9438  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  قَالَ  :  خَرَجَ ابْنُ مَسْعُودٍ عَلَى قَوْمٍ يَتَحَدَّثُونَ بَعْدَ الْفَجْرِ ، فَنَهَاهُمْ         [9/286]      عَنِ الْحَدِيثِ  ، فَقَالَ : "" إِنَّمَا جِئْتُمْ لِلصَّلَاةِ ، فَإِمَّا أَنْ تُصَلُّوا ، وَإِمَّا أَنْ تَسْكُتُوا  ""  .","","Al-Mu'jam al-Kabir 9438","","عبد الله بن مسعود عن عطاء بن أبي رباح عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9466","9439  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ التَّيْمِيِّ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  قَالَ  :  مَرَّ ابْنُ مَسْعُودٍ بِرَجُلَيْنِ يَتَكَلَّمَانِ بَعْدَ طُلُوعِ الْفَجْرِ ، فَقَالَ :  يَا هَذَانِ ، إِمَّا أَنْ تُصَلِّيَا ، وَإِمَّا أَنْ تَسْكُتَا  ""  .","","Al-Mu'jam al-Kabir 9439","","عبد الله بن مسعود عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن معتمر بن سليمان عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9467","9440  -  حَدَّثَنَا  إِسْحَاقُ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  قَتَادَةَ ،  أَنَّ  ابْنَ مَسْعُودٍ كَانَ يَكْرَهُ الْكَلَامَ إِذَا صَلَّى رَكْعَتَيِ الْفَجْرِ  ""  .","","Al-Mu'jam al-Kabir 9440","","عبد الله بن مسعود عن قتادة بن دعامة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9468","9441  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ  ،  قَالَ  :  كَانَتْ صَلَاةُ عَبْدِ اللهِ مِنَ النَّهَارِ أَرْبَعًا قَبْلَ الظُّهْرِ  ، وَرَكْعَتَيْنِ بَعْدَهَا ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَرَكْعَتَيْنِ بَعْدَ الْعِشَاءِ ، وَرَكْعَتَيْنِ قَبْلَ الْفَجْرِ ، وَلَا يُصَلِّي قَبْلَ الْعَصْرِ ، وَلَا بَعْدَهَا  ""  .","","Al-Mu'jam al-Kabir 9441","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9469","9442  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ  قَالَ  :  كَانَ تَطَوُّعُ عَبْدِ اللهِ الَّذِي لَا يَدَعُ : أَرْبَعًا قَبْلَ الظُّهْرِ  وَاثْنَتَانِ بَعْدَهَا ، وَاثْنَتَانِ بَعْدَ الْمَغْرِبِ ، وَاثْنَتَانِ بَعْدَ الْعِشَاءِ ، وَاثْنَتَانِ قَبْلَ الصُّبْحِ  ""  .","","Al-Mu'jam al-Kabir 9442","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9470","9443  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ  ،  قَالَ  :  كَانَ تَطَوُّعُ عَبْدِ اللهِ الَّذِي لَا يَنْقُصُ مِنْهُ  أَرْبَعًا قَبْلَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَهَا ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَرَكْعَتَيْنِ بَعْدَ الْعِشَاءِ ، وَرَكْعَتَيْنِ قَبْلَ صَلَاةِ الْغَدَاةِ  ""  .","","Al-Mu'jam al-Kabir 9443","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9471","9444  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا         [9/287]      زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ  ، قَالَ :  كَانَتْ صَلَاةُ عَبْدِ اللهِ الَّذِي لَا يَتْرُكُ  أَرْبَعًا قَبْلَ الظُّهْرِ ، وَاثْنَتَيْنِ بَعْدَهَا ، وَاثْنَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَاثْنَتَيْنِ بَعْدَ الْعِشَاءِ ، وَاثْنَتَيْنِ قَبْلَ الْفَجْرِ  ""  .","","Al-Mu'jam al-Kabir 9444","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9472","9445  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  يَحْيَى بْنِ الْعَلَاءِ ،  عَنْ  شُعَيْبِ بْنِ خَالِدٍ ،  عَنْ  أَبِي إِسْحَاقَ عَبْدِ اللهِ بْنِ بُدَيْلٍ ،  حَدَّثَنِي  أَبْطَنُ النَّاسِ ، بِعَبْدِ اللهِ بْنِ مَسْعُودٍ ، أَنَّهُ كَانَ  يَقُولُ  :  إِذَا زَالَتِ الشَّمْسُ قَامَ فَرَكَعَ أَرْبَعَ رَكَعَاتٍ يَقْرَأُ فِيهِنَّ سُورَتَيْنِ مِنَ الْمِئِينَ  ، فَإِذَا تَجَاوَبَ الْمُؤَذِّنُونَ شَدَّ عَلَيْهِ ثِيَابَهُ ، ثُمَّ خَرَجَ إِلَى الصَّلَاةِ  ""  .","","Al-Mu'jam al-Kabir 9445","","عبد الله بن مسعود عن أبطن الناس عن عبد الله بن بديل عن أبو إسحاق السبيعي عن شعيب بن خالد البجلي عن يحيى بن العلاء الفوراردي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9473","9446  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  بِشْرُ بْنُ الْوَلِيدِ الْكِنْدِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ  ، عَنِ  الْأَسْوَدِ ، وَمُرَّةَ ، وَمَسْرُوقٍ قَالُوا :  قَالَ  عَبْدُ اللهِ :  لَيْسَ شَيْءٌ يَعْدِلُ صَلَاةَ اللَّيْلِ مِنْ صَلَاةِ النَّهَارِ إِلَّا أَرْبَعًا قَبْلَ الظُّهْرِ  ، وَفَضْلُهُنَّ عَلَى صَلَاةِ النَّهَارِ كَفَضْلِ صَلَاةِ الْجَمَاعَةِ عَلَى صَلَاةِ الْوَاحِدِ  ""  .","","Al-Mu'jam al-Kabir 9446","","عبد الله بن مسعود عن مسروق بن الأجدع عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"9474","9447  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  أَنَّ  أَبَاهُ ، "" لَمْ يَكُنْ يُصَلِّي صَلَاةَ الضُّحَى  ""  .","","Al-Mu'jam al-Kabir 9447","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9475","9448  -  حَدَّثَنِي  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  لَيْثٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  قَالَ  :  سَاعَةٌ مَا أَتَيْتُهُ فِيهَا إِلَّا وَجَدْتُهُ قَائِمًا يُصَلِّي مَا بَيْنَ الْمَغْرِبِ ، وَالْعِشَاءِ  ،  يَعْنِي عَبْدَ اللهِ بْنَ مَسْعُودٍ  .","","Al-Mu'jam al-Kabir 9448","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن ليث بن أبي سليم عن الوضاح بن عبد الله اليشكري عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9476","9449  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ ،  ثَنَا  زَائِدَةُ ،  عَنْ         [9/288]      لَيْثٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  قَالَ  :  سَاعَةٌ مَا أَتَيْتُ عَبْدَ اللهِ بْنَ مَسْعُودٍ فِيهَا إِلَّا وَجَدْتُهُ فِيهَا يُصَلِّي ، مَا بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ ، فَسَأَلْتُ  عَبْدَ اللهِ  فَقُلْتُ : سَاعَةٌ مَا أَتَيْتُكَ فِيهَا قَطُّ إِلَّا وَجَدْتُكَ تُصَلِّي ، فَقَالَ :  إِنَّهَا سَاعَةُ غَفْلَةٍ  ""  .","","Al-Mu'jam al-Kabir 9449","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن ليث بن أبي سليم عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9477","9450  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  جَابِرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ الْأَسْوَدِ بْنِ يَزِيدَ  ، قَالَ :  قَالَ  عَبْدُ اللهِ :  نِعْمَ سَاعَةُ الْغَفْلَةِ  ،  يَعْنِي الصَّلَاةَ مَا بَيْنَ الْمَغْرِبِ ، وَالْعِشَاءِ  .","","Al-Mu'jam al-Kabir 9450","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن جابر الجعفي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9478","9451  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضْرِ  ، ثَنَا  أَبُو غَسَّانَ النَّهْدِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  النُّعَاسُ عِنْدَ الْقِتَالِ أَمَنَةٌ مِنَ اللهِ  ، وَالنُّعَاسُ فِي الصَّلَاةِ مِنَ الشَّيْطَانِ  ""  .","","Al-Mu'jam al-Kabir 9451","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن قيس بن الربيع الأسدي عن مالك بن إسماعيل النهدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9479","9452  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي رَزِينٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  النُّعَاسُ فِي الصَّلَاةِ مِنَ الشَّيْطَانِ  ، وَالنُّعَاسُ فِي الْقِتَالِ أَمَنَةٌ مِنَ اللهِ  ""  .","","Al-Mu'jam al-Kabir 9452","","عبد الله بن مسعود عن مسعود بن مالك الأسدي عن عاصم بن بهدلة عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9480","9453  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  أَبِي ظِبْيَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  التَّثَاؤُبُ  وَالْعُطَاسُ  فِي الصَّلَاةِ مِنَ الشَّيْطَانِ  ""  .","","Al-Mu'jam al-Kabir 9453","","عبد الله بن مسعود عن حصين بن جندب الجنبي عن يزيد بن أبي زياد القرشي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9481","9454  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  أَنَّ  ابْنَ مَسْعُودٍ ، قَالَ :  لَا تُقْصَرُ الصَّلَاةُ إِلَّا فِي حَجٍّ أَوْ  جِهَادٍ  ""  .","","Al-Mu'jam al-Kabir 9454","","عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9482","[9/289]      9455  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  خُصَيْفٌ الْجَزَرِيُّ ،  حَدَّثَنِي  زِيَادُ بْنُ أَبِي مَرْيَمَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، أَنَّهُ قَالَ :  لَا تَنْقُصُنَّ مِنْ صَلَاتِكُمْ فِي مَبَادِيكُمْ ، وَلَا  أَجْشَارِكُمْ  ، وَلَا تَسِيرُوا فِي قُرَى السَّوَادِ فِي حَوَائِجِكُمْ فَتَقُولُوا : إِنَّا  سَفْرٌ  ، إِنَّمَا الْمُسَافِرُ مِنَ الْأُفُقِ إِلَى الْأُفُقِ  ""  .","","Al-Mu'jam al-Kabir 9455","","عبد الله بن مسعود عن زياد بن أبي مريم الجزري عن خصيف الجزري عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9483","9456  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  خُصَيْفٍ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنِ  ابْنِ مَسْعُودٍ  ، أَنَّهُ قَالَ :  لَا تَغْتَرُّوا بِتِجَارَاتِكُمْ ، وَأَجْشَارِكُمْ  ، وَتُسَافِرُوا إِلَى قُرَى السَّوَادِ ، وَتَقُولُوا : إِنَّا قَوْمٌ  سَفْرٌ  ، إِنَّمَا الْمُسَافِرُ مِنْ أُفُقٍ إِلَى أُفُقٍ  ""  .","","Al-Mu'jam al-Kabir 9456","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن خصيف الجزري عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9484","9457  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  لَا تَغْتَرُّوا بِسَوَادِكُمْ  ، فَإِنَّمَا مَجْشَرُ أَحَدِكُمْ وَأَهْلُهُ شَيْءٌ وَاحِدٌ ، إِلَّا أَنْ يَكُونَ مُخْتَارًا .  ""","","Al-Mu'jam al-Kabir 9457","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9485","9458  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ اللهِ ، مِثْلَ ذَلِكَ .","","Al-Mu'jam al-Kabir 9458","","عبد الله بن مسعود عن إبراهيم النخعي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9486","9459  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  غَالِبِ بْنِ عُبَيْدِ اللهِ ،  أَخْبَرَنِي  حَمَّادٌ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  ابْنَ مَسْعُودٍ ، قَالَ :  مَنْ صَلَّى فِي السَّفَرِ أَرْبَعًا أَعَادَ الصَّلَاةَ  ""  .","","Al-Mu'jam al-Kabir 9459","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن غالب بن عبيد الله القرقساني عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9487","9460  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  سُئِلَ  عَبْدُ اللهِ عَنْ رَجُلٍ يَضَعُ جَنْبَهُ عِنْدَ         [9/290]      رَكْعَتَيِ الضُّحَى ؟ قَالَ :  مَا بَالُ أَحَدِكُمْ يَتَمَرَّغُ ، كَتَمَرُّغِ الْحِمَارِ  ""  .","","Al-Mu'jam al-Kabir 9460","","عبد الله بن مسعود عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9488","9461  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  يَحْيَى بْنِ الْعَلَاءِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُسْلِمِ بْنِ صُبَيْحٍ ،  عَنْ  مَسْرُوقٍ ،  قَالَ  :  كُنَّا نَقْعُدُ فِي الْمَسْجِدِ بَعْدَ قِيَامِ عَبْدِ اللهِ بْنِ مَسْعُودٍ نُثَبِّتُ النَّاسَ عَلَى الْقِرَاءَةِ  ، فَإِذَا أَرَدْنَا أَنْ نَرْجِعَ صَلَّيْنَا رَكْعَتَيْنِ ، فَبَلَغَ ذَلِكَ  عَبْدَ اللهِ بْنَ مَسْعُودٍ  ، فَقَالَ : "" أَتُحَمِّلُونَ النَّاسَ مَا لَا يُحَمِّلُهُمُ اللهُ ، يَرَوْنَكُمْ تُصَلُّونَ فَيَرَوْنَ ذَلِكَ وَاجِبًا عَلَيْهِمْ ، إِنْ كُنْتُمْ لَا بُدَّ فَاعِلِينَ فَفِي الْبُيُوتِ  ""  .","","Al-Mu'jam al-Kabir 9461","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن يحيى بن العلاء الفوراردي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9489","9462  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مَسْرُوقٍ ،  قَالَ  :  كُنَّا إِذَا قَامَ عَبْدُ اللهِ نَجْلِسُ بَعْدَهُ ، فَنُثَبِّتُ النَّاسَ فِي الْقِرَاءَةِ ، فَإِذَا قُمْنَا صَلَّيْنَا ، فَبَلَغَهُ ذَلِكَ ، فَدَخَلْنَا عَلَيْهِ ، فَقَالَ :  أَتُحَمِّلُونَ النَّاسَ مَا لَا يُحَمَّلُونَ  ، يَرَوْنَكُمْ فَيَحْسَبُونَ أَنَّهَا سُنَّةٌ ، إِنْ كُنْتُمْ لَا بُدَّ فَاعِلِينَ فَفِي بُيُوتِكُمْ  "" .  قَالَ  سُلَيْمَانُ  :  حَدَّثَنَا  أَيْضًا عَمْرُو بْنُ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ  .","","Al-Mu'jam al-Kabir 9462","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9490","9463  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  أَنَّ  ابْنَ مَسْعُودٍ ، قَالَ :  إِذَا رَأَى الشَّيْطَانُ ابْنَ آدَمَ سَاجِدًا صَاحَ ، وَقَالَ : يَا  وَيْلَهُ  ، وَيْلٌ لِلشَّيْطَانِ  ، أَمَرَ اللهُ ابْنَ آدَمَ أَنْ يَسْجُدَ وَلَهُ الْجَنَّةُ فَأَطَاعَ ، وَأَمَرَنِي أَنْ أَسْجُدَ فَعَصَيْتُ وَلِيَ النَّارُ "" .","","Al-Mu'jam al-Kabir 9463","","عبد الله بن مسعود عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9491","9464  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنِ  ابْنِ مَسْعُودٍ ،  أَنَّ  رَجُلًا  بَيْنَا هُوَ يَسْقِي زَرْعًا لَهُ         [9/291]      إِذْ رَأَى غَيَابَةً تَرَّهْيَا فَسَمِعَ فِيهَا صَوْتًا : أَنِ اسْقِ أَرْضَ فُلَانٍ  ، فَاتَّبَعَ الصَّوْتَ حَتَّى انْتَهَى إِلَى الْأَرْضِ الَّتِي سُمِّيَتْ ، فَسَأَلَ صَاحِبَهَا مَا عَمَلُكَ فِيهَا ؟ قَالَ : إِنِّي أُعِيدُ فِيهَا ثُلُثًا ، وَأَتَصَدَّقُ بِثُلُثٍ ، وَأَحْبِسُ لِأَهْلِي ثُلُثًا . ""","","Al-Mu'jam al-Kabir 9464","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9492","9465  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنِ  النَّخَعِيِّ ،  عَنْ  مَسْرُوقٍ ،  أَنَّ  ابْنَ مَسْعُودٍ ، كَانَ يَبْعَثُهُ إِلَى أَرْضِهِ أَنْ يَفْعَلَ فِيهَا ذَلِكَ  .","","Al-Mu'jam al-Kabir 9465","","عبد الله بن مسعود عن مسروق بن الأجدع عن إبراهيم النخعي عن إبراهيم بن مهاجر بن جابر البجلي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9493","بَابٌ  9466  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  لَعَنَ اللهُ  الْوَاشِمَاتِ  ، وَالْمُسْتَوْشِمَاتِ  ،  وَالْمُتَفَلِّجَاتِ  لِلْحُسْنِ الْمُغَيِّرَاتِ خَلْقَ اللهِ "" فَبَلَغَ ذَلِكَ امْرَأَةً مِنْ  بَنِي أَسَدٍ  يُقَالُ لَهَا :  أُمُّ يَعْقُوبَ  ، فَقَالَتْ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  بَلَغَنِي أَنَّكَ لَعَنْتَ  كَيْتَ  وَكَيْتَ  ، قَالَ : مَا لِي لَا أَلْعَنُ مَنْ لَعَنَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَمَنْ هُوَ فِي كِتَابِ اللهِ ، قَالَتْ : إِنِّي لَأَقْرَأُ مَا بَيْنَ اللَّوْحَيْنِ مَا أَجِدُهُ ، قَالَ : إِنْ كُنْتِ قَارِئَةً لَقَدْ وَجَدْتِيهِ ، أَمَا قَرَأْتِ :         {      وَمَا آتَاكُمُ الرَّسُولُ فَخُذُوهُ وَمَا نَهَاكُمْ عَنْهُ فَانْتَهُوا         }      قَالَتْ : بَلَى ، قَالَ : فَإِنَّهُ قَدْ "" نَهَى عَنْهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" قَالَتْ : إِنِّي لَأَظُنُّ أَهْلَكَ يَفْعَلُونَ بَعْضَ ذَلِكَ ، قَالَ : "" فَاذْهَبِي فَانْظُرِي "" ، فَدَخَلَتْ فَلَمْ تَرَ مِنْ حَاجَتِهَا شَيْئًا ، فَقَالَ  عَبْدُ اللهِ  : "" لَوْ كَانَتْ كَذَلِكَ لَمْ تُجَامِعْنَا  .  قَالَ  الدَّبَرِيُّ  : قُلْنَا  لِأَبِي بَكْرٍ  : مَا  النَّامِصَةُ  ؟ قَالَ : "" الَّتِي تَنْتِفُ شَعَرَهَا ""  .","","Al-Mu'jam al-Kabir 9466","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9494","9467  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  جَرِيرُ         [9/292]      بْنُ حَازِمٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  لُعِنَ الْمُنَمِّصَاتُ ، وَالْمُفَلِّجَاتُ ، وَالْمُتَوَشِّمَاتُ  ، أَلَا أَلْعَنُ مَنْ لَعَنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَتْ لَهُ  امْرَأَةٌ مِنْ بَنِي أَسَدٍ  : أَظُنُّهُ فِي أَهْلِكَ ، قَالَ : "" اذْهَبِي فَانْظُرِي "" ، فَذَهَبَتْ ثُمَّ جَاءَتْ فَقَالَتْ : مَا رَأَيْتُ فِيهِنَّ شَيْئًا وَمَا رَأَيْتُهُ فِي الْمُصْحَفِ ، فَقَالَ لَهَا  عَبْدُ اللهِ  : "" بَلَى قَالَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 9467","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن جرير بن حازم عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9495","9468  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  خَلَفُ بْنُ مُوسَى بْنِ خَلَفٍ الْعَمِّيِّ ،  ثَنَا  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنْ  عَزْرَةَ ،  عَنِ  الْحَسَنِ الْعُرَنِيِّ ،  عَنْ  يَحْيَى بْنِ الْجَزَّارِ ،  عَنْ  مَسْرُوقِ بْنِ الْأَجْدَعِ ،  أَنَّ  امْرَأَةً  أَتَتِ ابْنَ مَسْعُودٍ فَقَالَتْ :  إِنِّي امْرَأَةٌ  زَعْرَاءُ ،  أَيَصْلُحُ أَنْ أَصِلَ فِي شَعَرِي ؟  ، قَالَ : "" لَا "" ، قَالَتْ : شَيْئًا سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَوْ تَجِدُهُ فِي كِتَابِ اللهِ ؟ قَالَ : بَلْ سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَجِدُهُ فِي كِتَابِ اللهِ ، قَالَتْ : فَوَاللهِ لَقَدْ قَرَأْتُ مَا بَيْنَ دَفَّتَيِ الْمُصْحَفِ فَمَا وَجَدْتُهُ ، قَالَ : أَمَا تَجِدِينَ فِيهِ         {      وَمَا آتَاكُمُ الرَّسُولُ فَخُذُوهُ وَمَا نَهَاكُمْ عَنْهُ فَانْتَهُوا         }      قَالَتْ : بَلَى قَالَتْ : وَاللهِ إِنِّي أَرَى الَّتِي فِي بَيْتِكَ تَفْعَلُهُ ، قَالَ : "" مَا حَفِظْتُ وَصِيَّةَ أَخِي  شُعَيْبٍ  إِذًا "" ، قَالَ : "" فَأَقْسَمَتُ عَلَيْكِ لَمَا دَخَلْتِ إِلَيْهَا فَنَظَرْتِ إِلَى شَعَرِهَا "" ، فَدَخَلَتْ فَنَظَرَتْ إِلَى امْرَأَةٍ قَرْعَاءَ ، وَلَمْ تَرَ فِي شَعَرِهَا شَيْئًا ، فَخَرَجَتْ فَقَالَتْ : مَا وَجَدْتُ شَيْئًا ، فَقَالَ : "" مَا حَفِظْتُ وَصِيَّةَ  شُعَيْبٍ  إِذًا  .","","Al-Mu'jam al-Kabir 9468","","عبد الله بن مسعود عن مسروق بن الأجدع عن يحيى بن الجزار العرني عن الحسن بن عبد الله العرني عن عزرة بن عبد الرحمن بن زرارة عن قتادة بن دعامة عن موسى بن خلف العمي عن خلف بن موسى بن خلف العمي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9496","9469  -  حَدَّثَنَا  الطَّبَرِيُّ الْفَقِيهُ مُحَمَّدُ بْنُ جَرِيرٍ  ، ثَنَا  يَحْيَى بْنُ إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ أَبِي عُبَيْدَةَ بْنِ مَعْنٍ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  أَبِي عُبَيْدَةَ ، قَالَ :  قَالَ  عَبْدُ اللهِ  :  لَعَنَ اللهُ  الْمُتَفَلِّجَاتِ  ، وَالْمُتَنَمِّصَاتِ ، وَالْمُتَوَحِّشَاتِ ، الْمُغَيِّرَاتِ خَلْقَ اللهِ  ، فَأَتَتْهُ امْرَأَةٌ مِنْ  بَنِي أَسَدٍ  يُقَالُ لَهَا  أُمُّ الْمُسْتَوْرِدِ  ، فَقَالَتْ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، بَلَغَنِي أَنَّكَ لَعَنْتَ  الْمُتَفَلِّجَاتِ  ، وَالْمُتَنَمِّصَاتِ ، وَالْمُتَوَشِّمَاتِ ، فَقَالَ : أَلَا أَلْعَنُ مَنْ لَعَنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَفِي كِتَابِ اللهِ ، قَالَتْ : لَقَدْ قَرَأْتُ مَا بَيْنَ اللَّوْحَيْنِ فَمَا وَجَدْتُهُ فِيهِ ، قَالَ : لَئِنْ كُنْتِ قَرَأْتِ مَا بَيْنَ اللَّوْحَيْنِ إِنَّهُ لَفِي كِتَابِ اللهِ :         [9/293]             {      وَمَا آتَاكُمُ الرَّسُولُ فَخُذُوهُ وَمَا نَهَاكُمْ عَنْهُ فَانْتَهُوا         }      قَالَتْ : وَاللهِ إِنِّي لَأَحْسِبُ أَهْلَكَ يَصْنَعُونَهُ ، قَالَ : "" فَادْخُلِي فَانْظُرِي فَإِنْ كَانُوا يَفْعَلُونَ لَا يَبِيتُونَ عِنْدِي لَيْلَةً "" ، فَدَخَلَتْ فَنَظَرَتْ ، ثُمَّ خَرَجَتْ وَهِيَ تَقُولُ : مَا رَأَيْتُ شَيْئًا ، مَا رَأَيْتُ شَيْئًا  .","","Al-Mu'jam al-Kabir 9469","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن إبراهيم النخعي عن الأعمش عن عبد الملك بن معن المسعودي عن محمد بن أبي عبيدة المسعودي عن والد يحيى بن إبراهيم بن محمد المسعودي عن يحيى بن إبراهيم بن محمد المسعودي عن الطبرى عن الطبراني","باب"
"9497","9470  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي الْأَسْوَدِ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ، قَالَ :  سَمِعْتُ  عَزْرَةَ ، يَقُولُ :  إِنَّ  أَبَا الْعَالِيَةِ ، قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ :  لُعِنَتِ  الْوَاصِلَةُ  ،  وَالْوَاشِمَةُ  ،  وَالْفَالِجَةُ  ، وَالْمُنَمِّصَةُ  قَالَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 9470","","عبد الله بن مسعود عن رفيع بن مهران عن عزرة بن عبد الرحمن بن زرارة عن عاصم بن سليمان الأحول عن عبد الواحد بن زياد عن عبد الله بن محمد بن أبي الأسود عن ابن الرازي محمد بن جعفر البغدادى عن الطبراني","باب"
"9498","9471  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ ،  أَنَّ  عَبْدَ اللهِ بْنَ مَسْعُودٍ ، قَالَ :  وَالَّذِي لَا إِلَهَ غَيْرُهُ ، مَا صَلَّتِ امْرَأَةٌ صَلَاةً قَطُّ خَيْرًا لَهَا مِنْ صَلَاةٍ تُصَلِّيهَا فِي بَيْتِهَا ، إِلَّا أَنْ يَكُونَ  الْمَسْجِدَ الْحَرَامَ  ، أَوْ  مَسْجِدَ الرَّسُولِ  إِلَّا عَجُوزًا فِي مَنْقَلَيْهَا "" .","","Al-Mu'jam al-Kabir 9471","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن سلمة بن كهيل الحضرمي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9499","9472  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  مَا صَلَّتِ الْمَرْأَةُ فِي مَكَانٍ خَيْرٌ لَهَا مِنْ بَيْتِهَا إِلَّا أَنْ يَكُونَ  الْمَسْجِدَ الْحَرَامَ  ، أَوْ  مَسْجِدَ النَّبِيِّ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  إِلَّا امْرَأَةً تَخْرُجُ فِي مَنْقَلَيْهَا ""  يَعْنِي خُفَّيْهَا  .","","Al-Mu'jam al-Kabir 9472","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن سلمة بن كهيل الحضرمي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9500","9473  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ ، قَالَ :  سَمِعْتُ  رَبَّ هَذِهِ الدَّارِ يَحْلِفُ فَيَبْلُغُ بِالْيَمِينِ :  مَا مِنْ مُصَلَّى الْمَرْأَةِ خَيْرٌ لَهَا مِنْ بَيْتِهَا إِلَّا فِي حَجٍّ أَوْ         [9/294]      عُمْرَةٍ إِلَّا امْرَأَةً يَئِسَتْ مِنَ  الْبُعُولَةِ  فَهِيَ فِي  مَنْقَلَيْهَا  ، قُلْتُ : مَا مَنْقَلَيْهَا ؟ قَالَ : ""  امْرَأَةٌ عَجُوزٌ قَدْ تَقَارَبَ خَطْوُهَا  ""  .","","Al-Mu'jam al-Kabir 9473","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن سعيد بن مسروق الثوري عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9501","9474  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  سَعِيدُ بْنُ مَسْرُوقٍ ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ ،  قَالَ  :  حَلَفَ عَبْدُ اللهِ فَبَالَغَ فِي الْيَمِينِ :  مَا مِنْ مُصَلًّى لِامْرَأَةٍ خَيْرٌ مِنْ بَيْتِهَا إِلَّا فِي حَجٍّ أَوْ عُمْرَةٍ إِلَّا امْرَأَةً قَدْ يَئِسَتْ مِنَ  الْبُعُولَةِ  فَهِيَ فِي  مَنْقَلَيْهَا  ""  .","","Al-Mu'jam al-Kabir 9474","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن سعيد بن مسروق الثوري عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9502","9475  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ ،  أَنَّهُ :  رَأَى  ابْنَ مَسْعُودٍ ، يُخْرِجُ النِّسَاءَ مِنَ الْمَسْجِدِ يَوْمَ الْجُمُعَةِ  ، وَيَقُولُ : "" اخْرُجْنَ إِلَى بُيُوتِكُنَّ خَيْرٌ لَكُنَّ  ""  .","","Al-Mu'jam al-Kabir 9475","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9503","9476  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  شُعْبَةُ ،  أَخْبَرَنِي  أَبُو إِسْحَاقَ ،  أَخْبَرَنِي  أَبُو عَمْرٍو الشَّيْبَانِيُّ ، قَالَ :  رَأَيْتُ  ابْنَ مَسْعُودٍ يَطْرُدُ النِّسَاءَ مِنَ الْمَسْجِدِ يَوْمَ الْجُمُعَةِ  ""  .","","Al-Mu'jam al-Kabir 9476","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9504","9477  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّهُ :  كَانَ يَطْرُدُ النِّسَاءَ مِنَ الْمَسْجِدِ يَوْمَ الْجُمُعَةِ ، وَيَقُولُ :  صَلِّينَ فِي بُيُوتِكُنَّ  ""  .","","Al-Mu'jam al-Kabir 9477","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن أبو إسحاق السبيعي عن حجاج بن أرطاة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9505","9478  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  إِبْرَاهِيمُ الْهَجَرِيُّ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  مَا صَنَعَتِ امْرَأَةٌ خَيْرًا مِنْ أَنْ تَقْعُدَ فِي قَعْرِ بَيْتِهَا تَعْبُدُ رَبَّهَا  ، تَقُولُ : إِحْدَاهُنَّ أَذْهَبُ إِلَى أَهْلِي  فَيَسْتَشْرِفُهَا  الشَّيْطَانُ حَتَّى تَقُولَ : مَا رَآنِي أَحَدٌ إِلَّا أَعْجَبْتُهُ  ""  .","","Al-Mu'jam al-Kabir 9478","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن إبراهيم بن مسلم الهجري عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9506","9479  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حَيَّانَ الْمَازِنِيُّ  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِنَّمَا النِّسَاءُ         [9/295]      عَوْرَةٌ  ، وَإِنَّ الْمَرْأَةَ لَتَخْرُجُ مِنْ بَيْتِهَا ، وَمَا بِهَا مِنْ بَأْسٍ ،  فَيَسْتَشْرِفُ  لَهَا الشَّيْطَانُ فَيَقُولُ : إِنَّكِ لَا تَمُرِّينَ بِأَحَدٍ إِلَّا أَعْجَبْتِيهِ ، وَإِنَّ الْمَرْأَةَ لَتَلْبَسُ ثِيَابَهَا ، فَيُقَالُ : أَيْنَ تُرِيدِينَ ؟ فَتَقُولُ : أَعُودُ مَرِيضًا ، أَشْهَدُ جِنَازَةً أَوْ أَصَلِّي فِي مَسْجِدٍ ، وَمَا عَبَدَتِ امْرَأَةٌ رَبَّهَا بِمِثْلِ أَنْ تَعْبُدَهُ فِي بَيْتِهَا "" .","","Al-Mu'jam al-Kabir 9479","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن محمد بن حيان المازني عن الطبراني","باب"
"9507","9480  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  أَبُو هِلَالٍ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  إِنَّ الْمَرْأَةَ  عَوْرَةٌ  ، وَإِنَّهَا إِذَا خَرَجَتْ مِنْ بَيْتِهَا اسْتَشْرَفَهَا الشَّيْطَانُ فَتَقُولُ : مَا رَآنِي أَحَدٌ إِلَّا أَعْجَبْتُهُ ، وَأَقْرَبُ مَا تَكُونُ إِلَى اللهِ إِذَا كَانَتْ فِي قَعْرِ بَيْتِهَا "" .","","Al-Mu'jam al-Kabir 9480","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن حميد بن هلال العدوي عن محمد بن سليم الراسبي عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9508","9481  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  صَلَاةُ الْمَرْأَةِ فِي بَيْتِهَا أَفْضَلُ مِنْ صَلَاتِهَا فِي حُجْرَتِهَا  ، وَصَلَاتُهَا فِي حُجْرَتِهَا أَفْضَلُ مِنْ صَلَاتِهَا فِي دَارِهَا ، وَصَلَاتُهَا فِي دَارِهَا أَفْضَلُ مِنْ صَلَاتِهَا فِيمَا سِوَاهُ "" ، ثُمَّ قَالَ : "" إِنَّ الْمَرْأَةَ إِذَا خَرَجَتْ تَشَرَّفَ لَهَا الشَّيْطَانُ ""  .","","Al-Mu'jam al-Kabir 9481","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن حميد بن هلال العدوي عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9509","9482  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  صَلَاةُ الْمَرْأَةِ فِي الْبَيْتِ خَيْرٌ مِنْ صَلَاتِهَا فِي الدَّارِ  ، وَصَلَاتُهَا فِي الدَّارِ خَيْرٌ مِنْ صَلَاتِهَا خَارِجَهُ "" .","","Al-Mu'jam al-Kabir 9482","","عبد الله بن مسعود عن إبراهيم النخعي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9510","9483  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  كَانَ الرِّجَالُ ، وَالنِّسَاءُ فِي  بَنِي إِسْرَائِيلَ  يُصَلُّونَ جَمِيعًا  ، فَكَانَتِ الْمَرْأَةُ إِذَا كَانَ لَهَا  الْخَلِيلُ  تَلْبَسُ  الْقَالَبَيْنِ  تَطَوَّلُ بِهِمَا  لِخَلِيلِهَا  ، فَأَلْقَى اللهُ عَلَيْهِنَّ الْحَيْضَ ، فَكَانَ  ابْنُ مَسْعُودٍ  يَقُولُ : أَخِّرُوهُنَّ حَيْثُ أَخَّرَهُنَّ اللهُ "" قُلْنَا  لِأَبِي بَكْرٍ  : مَا  الْقَالَبَيْنِ  ؟ قَالَ :  "" رَقِيصَتَيْنِ مِنْ خَشَبٍ  "" .","","Al-Mu'jam al-Kabir 9483","","عبد الله بن مسعود عن عبد الله بن سخبرة عن إبراهيم النخعي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9511","[9/296]      9484  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كَانَتِ الْمَرْأَةُ مِنْ  بَنِي إِسْرَائِيلَ  تَلْبَسُ  الْقَالَبَيْنِ  فَتَقُومُ عَلَيْهِمَا  ، فَتُوَاعِدُ  خَلِيلَهَا  فَأُلْقِيَ عَلَيْهِنَّ الْحَيْضُ "" ، وَكَانَ  عَبْدُ اللهِ  ، يَقُولُ : "" أَخِّرُوهُنَّ حَيْثُ أَخَّرَهُنَّ اللهُ "" .","","Al-Mu'jam al-Kabir 9484","","عبد الله بن مسعود عن إبراهيم النخعي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9512","بَابٌ  9485  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  حُصَيْنٍ ،  عَنْ  عَبْدِ الْأَعْلَى ،  قَالَ  :  دَخَلْتُ الْمَسْجِدَ مَعَ ابْنِ مَسْعُودٍ فَرَكَعَ ، فَمَرَّ عَلَيْهِ  رَجُلٌ  وَهُوَ رَاكِعٌ ، فَسَلَّمَ عَلَيْهِ ، فَقَالَ : "" صَدَقَ اللهُ وَرَسُولُهُ "" ، فَلَمَّا انْصَرَفَ ، قَالَ : كَانَ يُقَالُ :  مِنْ أَشْرَاطِ السَّاعَةِ أَنْ يُسَلِّمَ الرَّجُلُ عَلَى الرَّجُلِ لِلْمَعْرِفَةِ  ، وَتُتَّخَذَ الْمَسَاجِدُ طُرُقًا ، وَأَنْ تَغْلُوَ النِّسَاءُ ، وَالْخَيْلُ ، ثُمَّ تَرْخُصَ فَلَا تَغْلُو إِلَى يَوْمِ الْقِيَامَةِ ، وَأَنْ يَتَّجِرَ الرَّجُلُ وَالْمَرْأَةُ جَمِيعًا "" .","","Al-Mu'jam al-Kabir 9485","","عبد الله بن مسعود عن عبد الأعلى بن الحكم الكلبي عن حصين بن عبد الرحمن السلمي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9513","9486  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  حُصَيْنٌ ،  عَنْ  عَبْدِ الْأَعْلَى بْنِ الْحَكَمِ الْكَلْبِيِّ ،  عَنْ  خَارِجَةَ بْنِ الصَّلْتِ الْبُرْجُمِيِّ ،  قَالَ  :  أَتَيْنَا الْمَسْجِدَ مَعَ عَبْدِ اللهِ بْنِ مَسْعُودٍ ، فَقَالَ  عَبْدُ اللهِ  : كَانَ يُقَالُ :  إِنَّ مِنِ اقْتِرَابِ السَّاعَةِ أَنْ تُتَّخَذَ الْمَسَاجِدُ طُرُقًا  .","","Al-Mu'jam al-Kabir 9486","","عبد الله بن مسعود عن خارجة بن الصلت البرجمي عن عبد الأعلى بن الحكم الكلبي عن حصين بن عبد الرحمن السلمي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9514","9487  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  قَالَ  :  دَخَلَ ابْنُ مَسْعُودٍ الْمَسْجِدَ ، فَقَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ مِنْ أَشْرَاطِ السَّاعَةِ أَنْ يَمُرَّ الرَّجُلُ فِي طُولِ الْمَسْجِدِ وَعَرْضِهِ ، لَا يُصَلِّي فِيهِ رَكْعَتَيْنِ  .  هَكَذَا رَوَاهُ  مَنْصُورٌ  ،  وَوَصَلَهُ  قَتَادَةُ  .","","Al-Mu'jam al-Kabir 9487","","عبد الله بن مسعود عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9515","9488  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ  ، ثَنَا  الْحَسَنُ بْنُ         [9/297]      بِشْرٍ الْبَجَلِيُّ ،  ثَنَا  الْحَكَمُ بْنُ عَبْدِ الْمَلِكِ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  أَبِيهِ  ،  قَالَ  :  لَقِيَ ابْنُ مَسْعُودٍ  رَجُلًا  فَقَالَ : السَّلَامُ عَلَيْكَ يَا  ابْنَ مَسْعُودٍ  ، فَقَالَ  ابْنُ مَسْعُودٍ  : صَدَقَ اللهُ وَرَسُولُهُ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مِنْ أَشْرَاطِ السَّاعَةِ أَنْ يَمُرَّ الرَّجُلُ فِي الْمَسْجِدِ لَا يُصَلِّي فِيهِ رَكْعَتَيْنِ  ، وَأَنْ لَا يُسَلِّمَ الرَّجُلُ إِلَّا عَلَى مَنْ يَعْرِفُ ، وَأَنْ يُبْرِدَ الصَّبِيُّ الشَّيْخَ  .","","Al-Mu'jam al-Kabir 9488","","عبد الله بن مسعود عن رافع الغطفاني عن سالم بن أبي الجعد الغطفاني عن قتادة بن دعامة عن الحكم بن عبد الملك القرشي عن الحسن بن بشر الكاهلي عن محمد بن علي بن شعيب السمسار عن الطبراني","باب"
"9516","9489  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  عُمَرُ بْنُ الْمُغِيرَةِ ،  عَنْ  مَيْمُونٍ أَبِي حَمْزَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  قَالَ  :  لَقِيَ عَبْدَ اللهِ بْنَ مَسْعُودٍ  أَعْرَابِيٌّ  وَنَحْنُ مَعَهُ ، فَقَالَ : السَّلَامُ عَلَيْكَ يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، فَضَحِكَ فَقَالَ : صَدَقَ اللهُ وَرَسُولُهُ ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا تَقُومُ السَّاعَةُ حَتَّى يَكُونَ السَّلَامُ عَلَى الْمَعْرِفَةِ  ، وَإِنَّ هَذَا عَرَفَنِي مِنْ بَيْنِكُمْ فَسَلَّمَ عَلَيَّ ، وَحَتَّى تُتَّخَذَ الْمَسَاجِدُ طُرُقًا فَلَا يُسْجَدُ لِلهِ فِيهَا ، وَحَتَّى يَبْعَثَ الْغُلَامُ الشَّيْخَ بَرِيدًا بَيْنَ الْأُفُقَيْنِ ، وَحَتَّى يَبْلُغَ التَّاجِرُ بَيْنَ الْأُفُقَيْنِ فَلَا يَجِدُ رِبْحًا  .","","Al-Mu'jam al-Kabir 9489","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن ميمون القصاب عن مغني المساكين عمر بن المغيرة عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","باب"
"9517","9490  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  ثَنَا  مُجَالِدٌ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  الْأَسْوَدِ بْنِ يَزِيدَ ، قَالَ :  أُقِيمَتِ الصَّلَاةُ فِي الْمَسْجِدِ فَجِئْنَا نَمْشِي مَعَ عَبْدِ اللهِ ، فَلَمَّا رَكَعَ النَّاسُ رَكَعَ  عَبْدُ اللهِ  ، وَرَكَعْنَا مَعَهُ ، وَنَحْنُ نَمْشِي ، فَمَرَّ  رَجُلٌ  بَيْنَ يَدَيْهِ فَقَالَ : السَّلَامُ عَلَيْكَ يَا  أَبَا عَبْدِ الرَّحْمَنِ  ،  فَقَالَ  عَبْدُ اللهِ  ، وَهُوَ رَاكِعٌ : صَدَقَ اللهُ وَرَسُولُهُ ، فَلَمَّا انْصَرَفَ سَأَلَهُ بَعْضُ  الْقَوْمِ  : لِمَ قُلْتَ حِينَ سَلَّمَ عَلَيْكَ الرَّجُلُ صَدَقَ اللهُ وَرَسُولُهُ ؟ فَقَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مِنْ أَشْرَاطِ السَّاعَةِ إِذَا كَانَتِ التَّحِيَّةُ عَلَى الْمَعْرِفَةِ  .","","Al-Mu'jam al-Kabir 9490","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن الشعبي عن مجالد بن سعيد عن عبد الله بن نمير عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","باب"
"9518","[9/298]      9491  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  قَالَ  : كَانَ عَبْدُ اللهِ يَقُولُ :  أَحْسِنُوا هَذِهِ الصَّلَاةَ  ، وَاقْصُرُوا هَذِهِ الْخُطَبَ  "" .","","Al-Mu'jam al-Kabir 9491","","عبد الله بن مسعود عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9519","9492  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَمْرِو بْنِ شُرَحْبِيلَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  طُولُ الصَّلَاةِ وَقِصَرُ الْخُطْبَةِ  مَئِنَّةٌ  مِنْ فِقْهِ الرَّجُلِ  "" .","","Al-Mu'jam al-Kabir 9492","","عبد الله بن مسعود عن عمرو بن شرحبيل الهمداني عن شقيق بن سلمة عن الأعمش عن سفيان الثوري عن محمد بن كثير العبدي عن الفضل بن الحباب الجمحي عن الطبراني","باب"
"9520","9493  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقٍ ،  عَنْ  عَمْرِو بْنِ شُرَحْبِيلَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  طُولُ الصَّلَاةِ وَقِصَرُ الْخُطْبَةِ  مَئِنَّةٌ  مِنْ فِقْهِ الرَّجُلِ  "" .","","Al-Mu'jam al-Kabir 9493","","عبد الله بن مسعود عن عمرو بن شرحبيل الهمداني عن شقيق بن سلمة عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9521","9494  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  عَاصِمٍ ،  عَنْ  شَقِيقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِنَّهَا سَتَكُونُ عَلَيْكُمْ أَئِمَّةٌ يُمِيتُونَ الصَّلَاةَ  ، فَمَنْ أَدْرَكَ ذَلِكَ مِنْكُمْ فَلْيُصَلِّهَا لِوَقْتِهَا ، وَلْيَجْعَلْ صَلَاتَهُ مَعَهُمْ  سُبْحَةً  "" .","","Al-Mu'jam al-Kabir 9494","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9522","9495  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  إِنَّكُمْ فِي زَمَانٍ قَلِيلٌ خُطَبَاؤُهُ كَثِيرٌ عُلَمَاؤُهُ ، يُطِيلُونَ الصَّلَاةَ  ، وَيَقْصُرُونَ الْخُطْبَةَ ، وَإِنَّهُ سَيَأْتِي عَلَيْكُمْ زَمَانٌ كَثِيرٌ خُطَبَاؤُهُ قَلِيلٌ عُلَمَاؤُهُ ، يُطِيلُونَ الْخُطْبَةَ ، وَيُؤَخِّرُونَ الصَّلَاةَ ، حَتَّى يُقَالَ هَذَا  شَرَقُ  الْمَوْتَى "" قُلْتُ لَهُ : مَا  شَرَقُ  الْمَوْتَى ؟ قَالَ : "" إِذَا اصْفَرَّتِ الشَّمْسُ جِدًّا ، فَمَنْ أَدْرَكَ ذَلِكَ مِنْكُمْ فَلْيُصَلِّ الصَّلَاةَ لِوَقْتِهَا ، فَإِنِ احْتَبَسَ فَلْيُصَلِّ مَعَهُمْ ، وَلْيَجْعَلْ صَلَاتَهُ وَحْدَهُ الْفَرِيضَةَ وَصَلَاتَهُ مَعَهُمْ تَطَوُّعًا  "" .","","Al-Mu'jam al-Kabir 9495","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9523","9496  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ  ، ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،         [9/299]      ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي عَمَّارٍ ،  عَنْ  صِلَةَ بْنِ زُفَرَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِنَّهُ سَيَكُونُ أُمَرَاءُ يَدَعُونَ مِنَ السُّنَّةِ مِثْلَ هَذِهِ ،  فَإِنْ تَرَكْتُمُوهَا جَعَلُوهَا مِثْلَ هَذِهِ ، فَإِنْ تَرَكْتُمُوهَا جَاؤُوا بِالطَّامَّةِ الْكُبْرَى  "" .","","Al-Mu'jam al-Kabir 9496","","عبد الله بن مسعود عن صلة بن زفر العبسي عن عريب بن حميد الدهني عن الأعمش عن علي بن مسهر القرشي عن منجاب بن الحارث التميمي عن الحسين بن جعفر القتات عن الطبراني","باب"
"9524","9497  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِي حَصِينٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَهْدِيٍّ ، قَالَ :  قَالَ  ابْنُ مَسْعُودٍ :  كَيْفَ أَنْتَ يَا  مَهْدِيُّ  إِذَا ظُهِرَ لِخِيَارِكُمْ  وَاسْتُعْمِلَ عَلَيْكُمْ أَحْدَاثُكُمْ ، أَوْ أَشْرَارُكُمْ ، وَصُلِّيَتِ الصَّلَاةُ لِغَيْرِ مِيقَاتِهَا ؟ "" قُلْتُ : لَا أَدْرِي ، قَالَ : "" لَا تَكُنْ جَابِيًا ، وَلَا عَرِيفًا ، وَلَا شُرْطِيًّا ، وَلَا بَرِيدًا ، وَصَلِّ الصَّلَاةَ لِمِيقَاتِهَا  "" .","","Al-Mu'jam al-Kabir 9497","","عبد الله بن مسعود عن مهدي عن الشعبي عن عثمان بن عاصم بن حصين عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9525","9498  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  قَالَ  :  كَانَ عَبْدُ اللهِ يُصَلِّي مَعَهُمْ إِذَا أَخَّرُوهَا قَلِيلًا  ، وَيَرَى أَنَّهُمْ يَتَحَمَّلُونَ إِثْمَ ذَلِكَ  "" .","","Al-Mu'jam al-Kabir 9498","","عبد الله بن مسعود عن إبراهيم النخعي عن منصور بن المعتمر عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9526","9499  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  قَالَ  :  أَخَّرَ  الْوَلِيدُ بْنُ عُقْبَةَ  الصَّلَاةَ ، فَأَمَرَ ابْنُ مَسْعُودٍ الْمُؤَذِّنَ فَثَوَّبَ بِالصَّلَاةِ ،  ثُمَّ تَقَدَّمَ فَصَلَّى بِالنَّاسِ ، فَأَرْسَلَ إِلَيْهِ  الْوَلِيدُ  : مَا صَنَعْتَ ؟ أَجَاءَكَ مِنْ أَمِيرِ الْمُؤْمِنِينَ حَدَثٌ أَمِ ابْتَدَعْتَ ؟ فَقَالَ  ابْنُ مَسْعُودٍ  : "" كُلُّ ذَلِكَ لَمْ يَكُنْ ، وَلَمْ يَأْمُرِ اللهُ عَلَيْنَا وَرَسُولُهُ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنْ نَنْتَظِرَكَ بِصَلَاتِنَا ، وَأَنْتَ فِي حَاجَتِكَ  ""  .","","Al-Mu'jam al-Kabir 9499","","عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9527","9500  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمِ ابْنِ بَهْدَلَةَ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنِ  ابْنِ مَسْعُودٍ أَنَّهُ قَالَ :  إِنَّ مِنَ الْجَفَاءِ أَرْبَعَةً  : أَنْ يَسْمَعَ الْمُؤَذِّنَ يَقُولُ : اللهُ أَكْبَرُ اللهُ أَكْبَرُ ، أَشْهَدُ أَنْ         [9/300]      لَا إِلَهَ إِلَّا اللهُ ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، فَلَا يَقُولُ مِثْلَ مَا يَقُولُ ، وَأَنْ يَمْسَحَ وَجْهَهُ قَبْلَ أَنْ يَقْضِيَ صَلَاتَهُ ، وَأَنْ يَبُولَ قَائِمًا ، وَأَنْ يُصَلِّيَ وَلَيْسَ بَيْنَهُ وَبَيْنَ الْقِبْلَةِ شَيْءٌ يَسْتُرُهُ  "" .","","Al-Mu'jam al-Kabir 9500","","عبد الله بن مسعود عن المسيب بن رافع الكاهلي عن عاصم بن بهدلة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9528","9501  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  عَاصِمٍ ،  عَنِ  الْمُسَيِّبِ ،  رَفَعَ الْحَدِيثَ  إِلَى  عَبْدِ اللهِ ، قَالَ :  أَرْبَعٌ مِنَ الْجَفَاءِ  : أَنْ يَسْمَعَ الرَّجُلُ الْمُؤَذِّنَ يُكَبِّرُ فَلَا يُكَبِّرُ ، وَيَتَشَهَّدُ فَلَا يَتَشَهَّدُ ، وَيَمْسَحَ جَبْهَتَهُ مِنَ التُّرَابِ وَهُوَ يُصَلِّي ، وَأَنْ يُصَلِّيَ فِي الْأَرْضِ الْفَضَاءِ لَيْسَ بَيْنَهُ وَبَيْنَ الْقِبْلَةِ سُتْرَةٌ  "" .","","Al-Mu'jam al-Kabir 9501","","عبد الله بن مسعود عن المسيب بن رافع الكاهلي عن عاصم بن بهدلة عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9529","9502  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَاصِمٍ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  أَرْبَعٌ مِنَ الْجَفَاءِ  : أَنْ تَمْسَحَ وَجْهَكَ وَأَنْتَ فِي الصَّلَاةِ ، وَأَنْ تُصَلِّيَ إِلَى غَيْرِ سُتْرَةٍ ، وَأَنْ تَبُولَ قَائِمًا ، وَأَنْ تَسْمَعَ الْمُؤَذِّنَ وَلَا تَقُولَ كَمَا يَقُولُ  "" .","","Al-Mu'jam al-Kabir 9502","","عبد الله بن مسعود عن المسيب بن رافع الكاهلي عن عاصم بن بهدلة عن شريك بن عبد الله النخعي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9530","9503  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  قَالَ  :  جَاءَ رَجُلٌ إِلَى عَبْدِ اللهِ ، فَقَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، إِنِّي نِمْتُ عَنْ صَلَاةِ الْفَجْرِ حَتَّى طَلَعَتِ الشَّمْسُ ، فَقَالَ لَهُ  عَبْدُ اللهِ  :  تَوَضَّأْ أَحْسَنَ مَا كُنْتَ مُتَوَضِّئًا ، وَصَلِّ أَحْسَنَ مَا كُنْتَ مُصَلِّيًا  ، قَالَ : فَرَأَى أَنَّ  عَبْدَ اللهِ  لَمْ يَفْهَمْ مِنْ كِبَرِ مَا أَتَى ، قَالَ : فَعَادَ فَقَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  إِنِّي نِمْتُ عَنْ صَلَاةِ الْفَجْرِ حَتَّى طَلَعَتِ الشَّمْسُ ، فَقَالَ لَهُ  عَبْدُ اللهِ  : "" تَوَضَّأْ أَحْسَنَ مَا كُنْتَ مُتَوَضِّئًا ، وَصَلِّ أَحْسَنَ مَا كُنْتَ مُصَلِّيًا "" ، فَسَكَتَ حَتَّى إِذَا خَفَّ مَنْ عِنْدَهُ قَالَ لَهُ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، إِنِّي نِمْتُ عَنْ صَلَاةِ الْفَجْرِ حَتَّى طَلَعَتِ الشَّمْسُ ، قَالَ : فَأَخَذَ  عَبْدُ اللهِ  بِأُصْبُعِهِ فَعَصَرَهَا ، ثُمَّ قَالَ : "" إِنَّمَا قِيلَ لَكَ لِتَعْقِلَ تَوَضَّأْ أَحْسَنَ مَا كُنْتَ مُتَوَضِّئًا وَصَلِّ أَحْسَنَ مَا كُنْتَ مُصَلِّيًا .  ""","","Al-Mu'jam al-Kabir 9503","","عبد الله بن مسعود عن زيد بن وهب الجهني عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9531","9504  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،         [9/301]      وَيَحْيَى بْنُ الْعَلَاءِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ  قَالَ  :  أَتَى رَجُلٌ ابْنَ مَسْعُودٍ  ثُمَّ ذَكَرَ مِثْلَ حَدِيثِ  زَائِدَةَ  .","","Al-Mu'jam al-Kabir 9504","","عبد الله بن مسعود عن زيد بن وهب الجهني عن الأعمش عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9532","9505  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  يُصَلِّي الرَّجُلُ فِي ثَوْبَيْنِ  ، فَلَقِيتُ أُبَيَّ بْنَ كَعْبٍ ، فَأَخْبَرْتُهُ فَقَالَ : "" كُلُّكُمْ يَجِدُ ثَوْبَيْنِ ؟ يُصَلِّي فِي ثَوْبٍ وَاحِدٍ ""  .","","Al-Mu'jam al-Kabir 9505","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9533","9506  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  قَتَادَةَ ،  أَنَّ  ابْنَ مَسْعُودٍ وَعَائِشَةَ كَانَا يَتَطَوَّعَانِ فِي السَّفَرِ  قَبْلَ الصَّلَاةِ وَبَعْدَهَا  "" .","","Al-Mu'jam al-Kabir 9506","","عائشة بنت أبي بكر الصديق عن قتادة بن دعامة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9534","9507  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  عَبْدِ الْمَلِكِ الْأَعْوَرِ ،  عَنْ  إِبْرَاهِيمَ النَّخَعِيِّ ،  أَنَّ  حُذَيْفَةَ  قَالَ لِابْنِ مَسْعُودٍ : أَلَا تَعْجَبُ مِنْ قَوْمٍ بَيْنَ دَارِكَ  وَدَارِ  أَبِي مُوسَى  يَزْعُمُونَ أَنَّهُمْ مُعْتَكِفُونَ ، فَقَالَ : "" لَعَلَّهُمْ أَصَابُوا وَأَخْطَأْتَ  "" .","","Al-Mu'jam al-Kabir 9507","","عبد الله بن مسعود عن إبراهيم النخعي عن عبد الملك بن إياس الشيباني عن حجاج بن أرطاة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9535","9508  -  حَدَّثَنَا  عَلِيٌّ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  حُذَيْفَةَ قَالَ لِابْنِ مَسْعُودٍ : أَلَا تَعْجَبُ مِنْ قَوْمٍ بَيْنَ دَارِكَ ، وَدَارِ  أَبِي مُوسَى  يَزْعُمُونَ أَنَّهُمْ مُعْتَكِفُونَ ، قَالَ : "" فَلَعَلَّهُمْ  أَصَابُوا وَأَخْطَأْتَ ، أَوْ حَفِظُوا ، وَنَسِيتَ  "" ، قَالَ :  أَمَّا أَنَا فَقَدْ عَلِمْتُ أَنَّهُ لَا اعْتِكَافَ إِلَّا فِي مَسْجِدِ جَمَاعَةٍ  .","","Al-Mu'jam al-Kabir 9508","","عبد الله بن مسعود عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9536","9509  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ، (  ح  )  وَحَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  وَاصِلٍ الْأَحْدَبِ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  جَاءَ  حُذَيْفَةُ  إِلَى عَبْدِ اللهِ ، فَقَالَ : أَلَا أُعَجِّبُكَ مِنْ         [9/302]      نَاسٍ عُكُوفٍ بَيْنَ دَارِكَ وَبَيْنَ دَارِ  الْأَشْعَرِيِّ  ؟  فَقَالَ  عَبْدُ اللهِ  :  فَلَعَلَّهُمْ أَصَابُوا وَأَخْطَأْتَ  ،  قَالَ  حُذَيْفَةُ :  مَا  أُبَالِي  أَفِيهِ أَعْتَكِفُ أَمْ فِي سُوقِكُمْ هَذِهِ  ، وَإِنَّمَا الِاعْتِكَافُ فِي هَذِهِ الْمَسَاجِدِ الثَّلَاثَةِ :  مَسْجِدِ الْحَرَامِ  ،  وَمَسْجِدِ الْمَدِينَةِ  ،  وَمَسْجِدِ الْأَقْصَى  "" ، وَكَانَ الَّذِينَ اعْتَكَفُوا - فَعَابَ عَلَيْهِمْ  حُذَيْفَةُ  - فِي  مَسْجِدِ الْكُوفَةِ الْأَكْبَرِ  .","","Al-Mu'jam al-Kabir 9509","","حذيفة بن اليمان عن إبراهيم النخعي عن واصل بن حيان الأحدب عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9537","9510  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  جَامِعِ بْنِ أَبِي رَاشِدٍ ، قَالَ :  سَمِعْتُ  أَبَا وَائِلٍ ، يَقُولُ :  قَالَ  حُذَيْفَةُ  لِعَبْدِ اللهِ : قَوْمٌ عُكُوفٌ بَيْنَ دَارِكَ وَدَارِ  أَبِي مُوسَى ،  أَلَا تَنْهَاهُمْ ؟  فَقَالَ  لَهُ  عَبْدُ اللهِ  :  فَلَعَلَّهُمْ أَصَابُوا وَأَخْطَأْتَ  ، وَحَفِظُوا وَنَسِيتَ "" ، فَقَالَ حُذَيْفَةُ :  لَا اعْتِكَافَ إِلَّا فِي هَذِهِ الْمَسَاجِدِ الثَّلَاثَةِ :  مَسْجِدِ الْمَدِينَةِ  ،  وَمَسْجِدِ مَكَّةَ  ،  وَمَسْجِدِ إِيلِيَا  ""  .","","Al-Mu'jam al-Kabir 9510","","حذيفة بن اليمان عن شقيق بن سلمة عن جامع بن أبي راشد الكاهلي عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9538","9511  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ، (  ح  )  وَحَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَلِيِّ بْنِ الْأَقْمَرِ ،  عَنْ  شَدَّادِ بْنِ الْأَزْمَعِ ،  قَالَ  :  اعْتَكَفَ  رَجُلٌ  فِي خَيْمَةٍ لَهُ فَحَصَبَهُ النَّاسُ  ، فَأَرْسَلَ الرَّجُلُ إِلَى عَبْدِ اللهِ بْنِ مَسْعُودٍ ، فَجَاءَ  عَبْدُ اللهِ  "" فَطَرَدَ النَّاسَ وَحَسَّنَ ذَلِكَ ""  .","","Al-Mu'jam al-Kabir 9511","","عبد الله بن مسعود عن شداد بن الأزمع الوادعي عن علي بن الأقمر عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9539","9512  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  كُرْدُوسٍ ،  قَالَ  :  كَانَ عَبْدُ اللهِ بْنُ مَسْعُودٍ يُكَبِّرُ فِي الْأَضْحَى وَالْفِطْرِ تِسْعًا تِسْعًا  ، يَبْدَأُ فَيُكَبِّرُ أَرْبَعًا ، ثُمَّ يَقْرَأُ ثُمَّ يُكَبِّرُ وَاحِدَةً فَيَرْكَعُ بِهَا ، ثُمَّ يَقُومُ فِي الرَّكْعَةِ الْآخِرَةِ فَيَبْدَأُ فَيَقْرَأُ ، ثُمَّ يُكَبِّرُ أَرْبَعًا يَرْكَعُ بِإِحْدَاهُنَّ  "" .","","Al-Mu'jam al-Kabir 9512","","عبد الله بن مسعود عن كردوس بن العباس الغطفاني عن عبد الملك بن عمير القبطي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9540","9513  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ ،  ثَنَا  ابْنُ أَبِي زَائِدَةَ ،  عَنْ  أَشْعَثَ ،  عَنْ  كُرْدُوسٍ ، قَالَ :  أَرْسَلَ  الْوَلِيدُ  إِلَى         [9/303]      عَبْدِ اللهِ بْنِ مَسْعُودٍ ، وَحُذَيْفَةَ ، وَأَبِي مَسْعُودٍ ، وَأَبِي مُوسَى الْأَشْعَرِيِّ بَعْدَ  الْعَتَمَةِ  فَقَالَ : إِنَّ هَذَا عِيدُ الْمُسْلِمِينَ فَكَيْفَ الصَّلَاةُ ؟  فَقَالُوا  : سَلْ  أَبَا عَبْدِ الرَّحْمَنِ  فَسَأَلَهُ فَقَالَ :  يَقُومُ فَيُكَبِّرُ أَرْبَعًا ، ثُمَّ يَقْرَأُ بِفَاتِحَةِ الْكِتَابِ  ، وَسُورَةٍ مِنَ الْمُفَصَّلِ ، ثُمَّ يُكَبِّرُ وَيَرْكَعُ ، فَتِلْكَ خَمْسٌ ، ثُمَّ يَقُومُ فَيَقْرَأُ بِفَاتِحَةِ الْكِتَابِ ، وَسُورَةٍ مِنَ الْمُفَصَّلِ ، ثُمَّ يُكَبِّرُ أَرْبَعًا يَرْكَعُ فِي آخِرِهِنَّ ، فَتِلْكَ تِسْعٌ فِي الْعِيدَيْنِ "" ، فَمَا أَنْكَرَهُ وَاحِدٌ مِنْهُمْ  .","","Al-Mu'jam al-Kabir 9513","","أبو موسى الأشعري عن كردوس بن العباس الغطفاني عن أشعث بن سوار عن يحيى بن زكريا بن أبي زائدة عن مسروق بن المرزبان الكندي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"9541","9514  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  الْوَلِيدَ بْنَ عُقْبَةَ  ، دَخَلَ الْمَسْجِدَ  وَابْنُ مَسْعُودٍ  ،  وَحُذَيْفَةُ  ،  وَأَبُو مُوسَى  فِي عَرْصَةِ الْمَسْجِدِ ، فَقَالَ  الْوَلِيدُ  : إِنَّ الْعِيدَ قَدْ حَضَرَ فَكَيْفَ أَصْنَعُ ؟  فَقَالَ  ابْنُ مَسْعُودٍ :  تَقُولُ اللهُ أَكْبَرُ ، وَتَحْمَدُ اللهَ ، وَتُثْنِي عَلَيْهِ ، وَتُصَلِّي عَلَى النَّبِيِّ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَتَدْعُو اللهَ ، ثُمَّ تُكَبِّرُ ، وَتَحْمَدُ اللهَ ، وَتُثْنِي عَلَيْهِ ، وَتُصَلِّي عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثُمَّ تُكَبِّرُ ، وَتَحْمَدُ اللهِ ، وَتُثْنِي عَلَيْهِ ، وَتُصَلِّي عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَتَدْعُو اللهَ ، ثُمَّ تُكَبِّرُ ، وَتَحْمَدُ اللهَ ، وَتُثْنِي عَلَيْهِ ، وَتُصَلِّي عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَتَدْعُو ، ثُمَّ كَبِّرْ ، وَاقْرَأْ بِفَاتِحَةِ الْكِتَابِ ، وَسُورَةٍ ، ثُمَّ كَبِّرْ وَارْكَعْ وَاسْجُدْ ، ثُمَّ قُمْ فَاقْرَأْ بِفَاتِحَةِ الْكِتَابِ ، وَسُورَةٍ ، ثُمَّ كَبِّرْ ، وَاحْمَدِ اللهَ ، وَأَثْنِ عَلَيْهِ ، وَصَلِّ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَادْعُ ثُمَّ كَبِّرْ ، وَاحْمَدِ اللهَ ، وَأَثْنِ عَلَيْهِ ، وَصَلِّ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَارْكَعْ وَاسْجُدْ "" قَالَ : فَقَالَ حُذَيْفَةُ ، وَأَبُو مُوسَى : أَصَابَ  .","","Al-Mu'jam al-Kabir 9514","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9542","9515  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَلْقَمَةَ وَالْأَسْوَدِ بْنِ يَزِيدَ ، قَالَا :  كَانَ  ابْنُ مَسْعُودٍ  جَالِسًا ، وَعِنْدَهُ  حُذَيْفَةُ  ،  وَأَبُو مُوسَى  ، فَسَأَلَهُمْ  سَعِيدُ بْنُ الْعَاصِ  عَنِ التَّكْبِيرِ فِي الصَّلَاةِ يَوْمَ الْفِطْرِ ، وَالْأَضْحَى فَجَعَلَ هَذَا يَقُولُ : سَلْ هَذَا ، وَهَذَا         [9/304]      يَقُولُ : سَلْ هَذَا ، حَتَّى قَالَ لَهُ  حُذَيْفَةُ  : سَلْ هَذَا -  لِعَبْدِ اللهِ بْنِ مَسْعُودٍ  - فَسَأَلَهُ ،  فَقَالَ  ابْنُ مَسْعُودٍ :  يُكَبِّرُ أَرْبَعًا ، ثُمَّ يَقْرَأُ ، ثُمَّ يُكَبِّرُ ، فَيَرْكَعُ ، ثُمَّ يُكَبِّرُ فِي الثَّانِيَةِ فَيَقْرَأُ  ، ثُمَّ يُكَبِّرُ أَرْبَعًا بَعْدَ الْقِرَاءَةِ  ""  .","","Al-Mu'jam al-Kabir 9515","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9543","9516  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَلْقَمَةَ ، وَالْأَسْوَدِ بْنِ يَزِيدَ ،  أَنَّ  ابْنَ مَسْعُودٍ كَانَ يُكَبِّرُ فِي الْعِيدَيْنِ تِسْعًا  ، أَرْبَعًا قَبْلَ الْقِرَاءَةِ ، ثُمَّ يُكَبِّرُ فَيَرْكَعُ ، وَفِي الثَّانِيَةِ يَقْرَأُ فَإِذَا فَرَغَ كَبَّرَ أَرْبَعًا ، ثُمَّ رَكَعَ  "" .","","Al-Mu'jam al-Kabir 9516","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9544","9517  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنِ  الْأَسْوَدِ ، وَعَلْقَمَةَ ، وَمَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، أَنَّهُ :  كَانَ يُكَبِّرُ بِتِسْعٍ فِي الْأَضْحَى وَالْفِطْرِ  ، يَقُومُ فَيُكَبِّرُ أَرْبَعًا ، ثُمَّ يَقْرَأُ ، ثُمَّ يُكَبِّرُ وَاحِدَةً فَيَرْكَعُ بِهَا ، ثُمَّ يَقُومُ فَيَقْرَأُ ، وَيُكَبِّرُ أَرْبَعًا يَرْكَعُ بِوَاحِدَةٍ  "" .","","Al-Mu'jam al-Kabir 9517","","عبد الله بن مسعود عن مسروق بن الأجدع عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9545","9518  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَبْدِ الْكَرِيمِ بْنِ أَبِي الْمُخَارِقِ ،  عَنْ  إِبْرَاهِيمَ النَّخَعِيِّ ،  عَنْ  عَلْقَمَةَ بْنِ قَيْسٍ ،  وَعَنِ  الْأَسْوَدِ بْنِ يَزِيدَ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّهُ :  كَانَ يُكَبِّرُ فِي الْأُولَى خَمْسًا بِتَكْبِيرَةِ الرَّكْعَةِ  ، وَبِتَكْبِيرَةِ الِاسْتِفْتَاحِ ، وَفِي الْأُخْرَى أَرْبَعًا بِتَكْبِيرَةِ الرَّكْعَةِ  "" .","","Al-Mu'jam al-Kabir 9518","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن عبد الكريم بن أبي المخارق عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9546","9519  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  ثَنَا  عَبْدُ اللهِ بْنُ أَبِي مُوسَى ،  عَنْ  أَبِيهِ  ،  حِينَ دَعَا بِهِمْ  سَعِيدُ بْنُ الْعَاصِ  دَعَى  أَبَا مُوسَى  ،  وَحُذَيْفَةَ  ،  وَعَبْدَ اللهِ بْنَ مَسْعُودٍ  عِنْدَ الْفَجْرِ قَبْلَ أَنْ يُصَلِّيَ الْغَدَاةَ ، فَسَأَلَهُمْ عَنِ التَّكْبِيرِ يَوْمَ الْعِيدِ فَقَالَ  حُذَيْفَةُ  : سَلِ  الْأَشْعَرِيَّ  ، فَقَالَ  الْأَشْعَرِيُّ  : سَلْ عَبْدَ اللهِ فَإِنَّهُ أَعْلَمُنَا وَأَقْدَمُنَا ، فَسَأَلَهُ  فَقَالَ  :  تَفْتَحُ بِأَرْبَعٍ ، وَتَخْتِمُ بِأَرْبَعٍ ، وَتُكَبِّرُ وَاحِدَةً ، ثُمَّ تُضِيفُ إِلَيْهَا ثَلَاثًا  ، ثُمَّ         [9/305]      تُكَبِّرُ فَتَرْكَعُ ، فَإِذَا رَفَعْتَ مِنَ السَّجْدَةِ قَرَأْتَ ، ثُمَّ كَبَّرْتَ أَرْبَعًا ، ثُمَّ تَرْكَعُ  "" .","","Al-Mu'jam al-Kabir 9519","","عبد الله بن مسعود عن أبو موسى الأشعري عن عبد الله بن أبي موسى الأشعري عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9547","9520  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَلِيِّ بْنِ الْأَقْمَرِ ،  عَنْ  أَبِي عَطِيَّةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  التَّكْبِيرُ فِي الْعِيدَيْنِ أَرْبَعًا كَالصَّلَاةِ عَلَى الْمَيِّتِ  "" .","","Al-Mu'jam al-Kabir 9520","","عبد الله بن مسعود عن مالك بن عامر الهمداني عن علي بن الأقمر عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9548","9521  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  عَبْدُ الْكَرِيمِ  عَنِ  النَّخَعِيِّ ،  عَنْ  عَلْقَمَةَ ، وَالْأَسْوَدِ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  إِنَّ بَيْنَ كُلِّ تَكْبِيرَتَيْنِ قَدْرُ كَلِمَةٍ  "" .","","Al-Mu'jam al-Kabir 9521","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن عبد الكريم بن أبي المخارق عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9549","9522  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَيُّوبَ ،  عَنِ  ابْنِ سِيرِينَ ،  أَنَّ  ابْنَ مَسْعُودٍ ، وَحُذَيْفَةَ ، كَانَا ""  يَنْهَيَانِ النَّاسَ - أَوْ قَالَ : يُجْلِسَانِ -  مَنْ يَرَيَاهُ  يُصَلِّي قَبْلَ خُرُوجِ الْإِمَامِ فِي الْعِيدِ ""  .","","Al-Mu'jam al-Kabir 9522","","عبد الله بن مسعود عن محمد بن سيرين عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9550","9523  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَيُّوبَ ، وَهِشَامٍ ،  عَنْ  مُحَمَّدٍ ،  أَنَّ  ابْنَ مَسْعُودٍ وَحُذَيْفَةَ كَانَا يَنْهَيَانِ النَّاسَ يَوْمَ الْعِيدِ  عَنِ الصَّلَاةِ قَبْلَ خُرُوجِ الْإِمَامِ  "" .","","Al-Mu'jam al-Kabir 9523","","حذيفة بن اليمان عن محمد بن سيرين عن هشام بن حسان العتكي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9551","9524  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  هِشَامٍ ،  عَنْ  مُحَمَّدٍ قَالَ :  أُنْبِئْتُ  أَنَّ ابْنَ مَسْعُودٍ وَحُذَيْفَةَ كَانَا يَقُومَانِ فِي النَّحْرِ  وَالْفِطْرِ ، فَيَنْهَيَانِ أَنْ يُصَلِّيَ أَحَدٌ قَبْلَ الْإِمَامِ  "" .","","Al-Mu'jam al-Kabir 9524","","حذيفة بن اليمان عن محمد بن سيرين عن هشام بن حسان العتكي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9552","9525  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  يَزِيدُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  مُحَمَّدُ بْنُ سِيرِينَ ،  نُبِّئْتُ  أَنَّ  ابْنَ مَسْعُودٍ وَحُذَيْفَةَ ، أَحَدَهُمَا أَوْ كِلَيْهِمَا ""  قَامَ قَائِمًا  ، فَنَهَى النَّاسَ عَنِ الصَّلَاةِ يَوْمَ الْعِيدِ قَبْلَ خُرُوجِ الْإِمَامِ  "" .","","Al-Mu'jam al-Kabir 9525","","حذيفة بن اليمان عن محمد بن سيرين عن يزيد بن إبراهيم التستري عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9553","[9/306]      9526  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادٌ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  أَنَّ  ابْنَ مَسْعُودٍ كَانَ لَا يُصَلِّي قَبْلَهَا  وَيُصَلِّي بَعْدَهَا أَرْبَعَ رَكَعَاتٍ  "" .","","Al-Mu'jam al-Kabir 9526","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9554","9527  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَيُّوبَ ،  عَنِ  ابْنِ سِيرِينَ ، وَقَتَادَةَ ،  أَنَّ  ابْنَ مَسْعُودٍ : "" كَانَ يُصَلِّي بَعْدَهَا  أَرْبَعَ رَكَعَاتٍ أَوْ ثَمَانٍ  ،  وَكَانَ لَا يُصَلِّي قَبْلَهَا  ""  .","","Al-Mu'jam al-Kabir 9527","","عبد الله بن مسعود عن محمد بن سيرين عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9555","9528  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  صَالِحٍ ،  عَنِ  الشَّعْبِيِّ ،  قَالَ  :  كَانَ ابْنُ مَسْعُودٍ يُصَلِّي بَعْدَ الْعِيدَيْنِ أَرْبَعًا  ""  .","","Al-Mu'jam al-Kabir 9528","","عبد الله بن مسعود عن الشعبي عن صالح بن صالح بن حي الثوري عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9556","9529  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ  ، ثَنَا  خَالِدُ بْنُ خِدَاشِ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  حُرَيْثٍ ،  عَنِ  الْحَكَمِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، أَنَّهُ :  كَانَ يُصَلِّي بَعْدَ الْعِيدِ أَرْبَعًا  ""  .","","Al-Mu'jam al-Kabir 9529","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الحكم بن عتيبة الكندي عن حريث بن أبي مطر الفزاري عن عيسى بن يونس بن أبي إسحاق عن خالد المهلبي عن محمد بن علي بن شعيب السمسار عن الطبراني","باب"
"9557","9530  -  حَدَّثَنَا  إِسْحَاقُ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مُطَرِّفٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ :  مَنْ فَاتَهُ الْعِيدُ فَلْيُصَلِّ أَرْبَعًا  "" .","","Al-Mu'jam al-Kabir 9530","","عبد الله بن مسعود عن الشعبي عن مطرف بن طريف عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9558","9531  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  سُفْيَانَ ،  عَنْ  مُطَرِّفٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ :  مَنْ فَاتَهُ الْعِيدُ فَلْيُصَلِّ أَرْبَعًا  "" .","","Al-Mu'jam al-Kabir 9531","","عبد الله بن مسعود عن الشعبي عن مطرف بن طريف عن سفيان الثوري عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9559","9532  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ بَرَّةَ الصَّنْعَانِيُّ  ، ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  الثَّوْرِيُّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْأَسْوَدِ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّهُ :  كَانَ يُكَبِّرُ مِنْ صَلَاةِ الْغَدَاةِ يَوْمَ عَرَفَةَ  إِلَى صَلَاةِ الْعَصْرِ مِنْ يَوْمِ النَّحْرِ  "" .","","Al-Mu'jam al-Kabir 9532","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إبراهيم بن محمد بن برة الصنعاني عن الطبراني","باب"
"9560","[9/307]      9533  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  عَبْدُ الْكَرِيمِ أَبُو أُمَيَّةَ ،  عَنْ  إِبْرَاهِيمَ النَّخَعِيِّ ،  عَنْ  عَلْقَمَةَ ، وَالْأَسْوَدِ ،  عَنِ  ابْنِ مَسْعُودٍ ،  فِي زَكَاةِ الْفِطْرِ قَالَ : "" مُدٌّ مِنْ  قَمْحٍ  ، أَوْ صَاعٌ مِنْ تَمْرٍ أَوْ شَعِيرٍ ""  .","","Al-Mu'jam al-Kabir 9533","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن عبد الكريم بن أبي المخارق عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9561","9534  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الْحَجَّاجِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ التَّيْمِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ :  اغْتَسَلَتُ مَعَ ابْنِ مَسْعُودٍ يَوْمَ عَرَفَةَ تَحْتَ الْأَرَاكِ  "" .","","Al-Mu'jam al-Kabir 9534","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن حجاج بن أرطاة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9562","9535  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  شُعْبَةُ ،  أَخْبَرَنِي  الْحَكَمُ ، وَحَمَّادٌ ،  عَنْ  إِبْرَاهِيمَ ،  قَالَ  : كَانَ عَبْدُ اللهِ يَقُولُ :  التَّكْبِيرُ أَيَّامَ  التَّشْرِيقِ  بَعْدَ صَلَاةِ الصُّبْحِ  مِنْ يَوْمِ عَرَفَةَ إِلَى بَعْدِ الْعَصْرِ مِنْ يَوْمِ النَّحْرِ ""  .","","Al-Mu'jam al-Kabir 9535","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن شعبة بن الحجاج عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9563","9536  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  أَصْحَابِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ ، أَنَّهُ :  كَانَ يُكَبِّرُ صَلَاةَ الْغَدَاةِ مِنْ يَوْمِ عَرَفَةَ ،  وَيَقْطَعُ صَلَاةَ الْعَصْرِ مِنْ يَوْمِ النَّحْرِ ، يُكَبِّرُ إِذَا صَلَّى الْعَصْرَ "" ، قَالَ : "" وَكَانَ يُكَبِّرُ : اللهُ أَكْبَرُ اللهُ أَكْبَرُ ، لَا إِلَهَ إِلَّا اللهُ ، وَاللهُ أَكْبَرُ اللهُ أَكْبَرُ وَلِلَّهِ الْحَمْدُ ""  .","","Al-Mu'jam al-Kabir 9536","","عبد الله بن مسعود عن أصحاب عبد الله عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9564","9537  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ :         {      إِذَا نُودِيَ لِلصَّلاةِ مِنْ يَوْمِ الْجُمُعَةِ فَاسْعَوْا إِلَى ذِكْرِ اللهِ         }      قَالَ  عَبْدُ اللهِ  :  لَوْ قَرَأْتُهَا فَاسْعَوْا لَسَعَيْتُ حَتَّى يَسْقُطَ رِدَائِي  ، وَكَانَ يَقْرَؤُهَا فَامْضُوا  ""  .","","Al-Mu'jam al-Kabir 9537","","عبد الله بن مسعود عن إبراهيم النخعي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9565","9538  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  قَتَادَةَ ،  قَالَ  :  فِي حَرْفِ ابْنِ مَسْعُودٍ : فَامْضُوا إِلَى ذِكْرِ اللهِ  ، وَهِيَ كَقَوْلِهِ :         [9/308]             {      إِنَّ سَعْيَكُمْ لَشَتَّى         }      "" .","","Al-Mu'jam al-Kabir 9538","","عبد الله بن مسعود عن قتادة بن دعامة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9566","9539  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَنَا  حَمَّادٌ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّهُ :  سَأَلَ  أُبَيَّ بْنَ كَعْبٍ  - وَنَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ - عَنْ آيَةٍ مِنْ كِتَابِ اللهِ فَأَعْرَضَ عَنْهُ ، وَلَمْ يَرُدَّ عَلَيْهِ ، فَلَمَّا قَضَى صَلَاتَهُ قَالَ : إِنَّكَ لَمْ تُجَمِّعْ ، فَسَأَلَ  ابْنُ مَسْعُودٍ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  صَدَقَ  أُبَيٌّ  .","","Al-Mu'jam al-Kabir 9539","","عبد الله بن مسعود عن إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9567","9540  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُهَاجِرِ الْبَجَلِيُّ ،  عَنْ  إِبْرَاهِيمَ  قَالَ  :  اسْتَقْرَأَ رَجُلٌ عَبْدَ اللهِ بْنَ مَسْعُودٍ ، وَالْإِمَامُ يَخْطُبُ يَوْمَ الْجُمُعَةِ فَلَمْ يُكَلِّمْهُ  عَبْدُ اللهِ  ، فَلَمَّا قَضَى الصَّلَاةَ ، قَالَ لَهُ  عَبْدُ اللهِ  :  الَّذِي سَأَلْتَ عَنْهُ نَصِيبُكَ مِنَ الْجُمُعَةِ  .","","Al-Mu'jam al-Kabir 9540","","عبد الله بن مسعود عن إبراهيم النخعي عن إبراهيم بن مهاجر بن جابر البجلي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9568","9541  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  الرُّكَيْنُ بْنُ الرَّبِيعِ الْفَزَارِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كَفَى لَغْوًا أَنْ تَقُولَ لِصَاحِبِكَ :  أَنْصِتْ  ، إِذَا خَرَجَ الْإِمَامُ فِي الْجُمُعَةِ  "" .","","Al-Mu'jam al-Kabir 9541","","عبد الله بن مسعود عن الربيع بن عميلة الفزاري عن ركين بن الربيع الفزاري عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9569","9542  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ ، قَالَ :  صَلَّيْتُ أَنَا  وَزِرٌّ  ، فَأَمَّنِي وَفَاتَتْنَا الْجُمُعَةُ  ،  فَسَأَلْتُ  إِبْرَاهِيمَ فَقَالَ : "" فَعَلَ ذَلِكَ عَبْدُ اللهِ  بِعَلْقَمَةَ  وَالْأَسْوَدِ  "" قَالَ سُفْيَانُ : ""  وَرُبَّمَا فَعَلْتُهُ أَنَا وَالْأَعْمَشُ  "" .","","Al-Mu'jam al-Kabir 9542","","عبد الله بن مسعود عن إبراهيم النخعي عن الحسن بن عبيد الله النخعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9570","9543  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ الْكُوفِيُّ  ، ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  مَنْ أَدْرَكَ مِنَ الْجُمُعَةِ رَكْعَةً فَلْيُضِفْ إِلَيْهَا أُخْرَى  ، وَمَنْ فَاتَتْهُ الرَّكْعَتَانِ فَلْيُصَلِّ أَرْبَعًا  "" .","","Al-Mu'jam al-Kabir 9543","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن الأعمش عن علي بن مسهر القرشي عن منجاب بن الحارث التميمي عن الحسين بن جعفر القتات عن الطبراني","باب"
"9571","[9/309]      9544  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  مَنْ أَدْرَكَ الرَّكْعَةَ فَقَدْ أَدْرَكَ الْجُمُعَةَ  ، وَمَنْ لَمْ يُدْرِكِ الرَّكْعَةَ فَلْيُصَلِّ أَرْبَعًا  "" .","","Al-Mu'jam al-Kabir 9544","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9572","9545  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضْرِ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ، قَالَ :  سُئِلَ  أَبُو إِسْحَاقَ السَّبِيعِيُّ  : أَذَكَرْتَ عَنْ  أَبِي الْأَحْوَصِ ،  أَنَّ  عَبْدَ اللهِ ، قَالَ :  مَنْ أَدْرَكَ الرَّكْعَتَيْنِ أَوْ أَحَدَهُمَا فَقَدْ أَدْرَكَ الْجُمُعَةَ  ، وَمَنْ فَاتَتْهُ الرَّكْعَتَانِ فَلْيُصَلِّ أَرْبَعًا ؟ قَالَ : "" نَعَمْ  "" .","","Al-Mu'jam al-Kabir 9545","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9573","9546  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  مَنْ أَدْرَكَ الْخُطْبَةَ فَالْجُمُعَةُ رَكْعَتَانِ  ، وَمَنْ لَمْ يُدْرِكْهَا فَلْيُصَلِّ أَرْبَعًا ، وَمَنْ لَمْ يُدْرِكِ الرَّكْعَةَ فَلَا يَعْتَمِدْ بِالسَّجْدَةِ حَتَّى يُدْرِكَ الرَّكْعَةَ  "" .","","Al-Mu'jam al-Kabir 9546","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9574","9547  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  مَنْ فَاتَتْهُ الرَّكْعَةُ الْأُخْرَى فَلْيُصَلِّ أَرْبَعًا  .  قَالَ  مَعْمَرٌ  : قَالَ  قَتَادَةُ  : يُصَلِّي أَرْبَعًا ، فَقِيلَ  لِقَتَادَةَ  : إِنَّ  ابْنَ مَسْعُودٍ  جَاءَ وَهُمْ جُلُوسٌ فِي آخِرِ الصَّلَاةِ ، فَقَالَ لِأَصْحَابِهِ : "" اجْلِسُوا أَدْرَكْتُمْ إِنْ شَاءَ اللهُ "" ، قَالَ  قَتَادَةُ  : إِنَّمَا يَقُولُ : "" أَدْرَكْتُمُ الْأَجْرَ ""  .","","Al-Mu'jam al-Kabir 9547","","عبد الله بن مسعود عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9575","9548  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضْرِ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  عَطَاءُ بْنُ السَّائِبِ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  قَالَ  :  كَانَ عَبْدُ اللهِ بْنُ مَسْعُودٍ يُعَلِّمُنَا أَنْ نُصَلِّيَ أَرْبَعَ رَكَعَاتٍ بَعْدَ الْجُمُعَةِ  حَتَّى سَمِعْنَا قَوْلَ عَلِيٍّ : "" صَلُّوا         [9/310]      سِتًّا "" ، قَالَ  أَبُو عَبْدِ الرَّحْمَنِ  : "" فَنَحْنُ نُصَلِّي سِتًّا "" ، قَالَ  عَطَاءٌ  : ""  أَبُو عَبْدِ الرَّحْمَنِ  يُصَلِّي رَكْعَتَيْنِ ، ثُمَّ أَرْبَعًا  "" .","","Al-Mu'jam al-Kabir 9548","","علي بن أبي طالب عن عبد الله بن حبيب السلمي عن عطاء بن السائب عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9576","9549  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ،  قَالَ  :  كَانَ ابْنُ مَسْعُودٍ يَأْمُرُنَا أَنْ نُصَلِّيَ قَبْلَ الْجُمُعَةِ أَرْبَعًا وَبَعْدَهَا أَرْبَعًا  حَتَّى جَاءَ عَلِيٌّ رَضِيَ اللهُ عَنْهُ "" فَأَمَرَنَا أَنْ نُصَلِّيَ بَعْدَهَا رَكْعَتَيْنِ ، ثُمَّ أَرْبَعًا  "" .","","Al-Mu'jam al-Kabir 9549","","علي بن أبي طالب عن عبد الله بن حبيب السلمي عن عطاء بن السائب عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9577","9550  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجٌ ،  ثَنَا  هَمَّامٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  قَالَ  :  كَانَ ابْنُ مَسْعُودٍ يَأْمُرُنَا أَنْ نُصَلِّيَ قَبْلَ الْجُمُعَةِ أَرْبَعًا  ، وَبَعْدَهَا أَرْبَعًا "" حَتَّى جَاءَ عَلِيٌّ "" فَأَمَرَنَا أَنْ نُصَلِّيَ بَعْدَهَا رَكْعَتَيْنِ ، ثُمَّ أَرْبَعًا  "" .","","Al-Mu'jam al-Kabir 9550","","علي بن أبي طالب عن عبد الله بن حبيب السلمي عن عطاء بن السائب عن همام بن يحيى بن دينار عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9578","9551  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجٌ ،  ثَنَا  هَمَّامٌ ،  عَنْ  عَطَاءٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  قَالَ  :  أَمَرَنَا ابْنُ مَسْعُودٍ أَنْ نُصَلِّيَ بَعْدَ الْجُمُعَةِ أَرْبَعًا  قَالَ : فَلَمَّا جَاءَ عَلِيٌّ قَالَ : "" اجْعَلُوهَا سِتًّا ""  .","","Al-Mu'jam al-Kabir 9551","","علي بن أبي طالب عن عبد الله بن حبيب السلمي عن عطاء بن السائب عن همام بن يحيى بن دينار عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9579","9552  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضْرِ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  عَلْقَمَةَ بْنِ قَيْسٍ ،  أَنَّ  ابْنَ مَسْعُودٍ صَلَّى يَوْمَ الْجُمُعَةِ بَعْدَمَا سَلَّمَ الْإِمَامُ أَرْبَعَ رَكَعَاتٍ  ""  .","","Al-Mu'jam al-Kabir 9552","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9580","9553  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  أَنَّ  ابْنَ مَسْعُودٍ كَانَ يُصَلِّي قَبْلَ الْجُمُعَةِ أَرْبَعَ رَكَعَاتٍ  ، وَبَعْدَهَا أَرْبَعَ رَكَعَاتٍ  "" قَالَ أَبُو إِسْحَاقَ :  وَكَانَ عَلِيٌّ يُصَلِّي بَعْدَ الْجُمُعَةِ سِتَّ رَكَعَاتٍ  "" .","","Al-Mu'jam al-Kabir 9553","","علي بن أبي طالب عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9581","[9/311]      9554  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  قَتَادَةَ ،  أَنَّ  ابْنَ مَسْعُودٍ كَانَ يُصَلِّي بَعْدَ الْجُمُعَةِ أَرْبَعًا  "" .","","Al-Mu'jam al-Kabir 9554","","عبد الله بن مسعود عن قتادة بن دعامة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9582","9555  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  ثَنَا  زَيْدُ بْنُ وَهْبٍ ،  قَالَ  :  كُنَّا نُصَلِّي الْجُمُعَةَ مَعَ عَبْدِ اللهِ ، ثُمَّ نَرْجِعُ فَنَقِيلُ  "" .","","Al-Mu'jam al-Kabir 9555","","عبد الله بن مسعود عن زيد بن وهب الجهني عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9583","9556  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  يَحْيَى بْنِ الْعَلَاءِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  قَالَ  :  كُنَّا نُجَمِّعُ مَعَ ابْنِ مَسْعُودٍ ، ثُمَّ نَرْجِعُ فَنَقِيلُ  "" .","","Al-Mu'jam al-Kabir 9556","","عبد الله بن مسعود عن زيد بن وهب الجهني عن الأعمش عن يحيى بن العلاء الفوراردي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9584","9557  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ السَّرَّاجُ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا  شُعْبَةُ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ ،  قَالَ  :  رَأَيْتُ عَبْدَ اللهِ بْنَ مَسْعُودٍ ،  يَعُسُّ  الْمَسْجِدَ بِاللَّيْلِ  فَلَا يَرَى فِيهِ  سَوَادًا  إِلَّا أَخَّرَهُ إِلَّا رَجُلًا قَائِمًا يُصَلِّي  "" .","","Al-Mu'jam al-Kabir 9557","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن إسماعيل بن أبي خالد عن شعبة بن الحجاج عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","باب"
"9585","9558  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي قَيْسٍ ، قَالَ :  سَمِعْتُ  هُزَيْلَ بْنَ شُرَحْبِيلَ ،  قَالَ  :  جَاءَ ابْنُ مَسْعُودٍ إِلَى مَسْجِدِنَا ، وَأُقِيمَتِ الصَّلَاةُ ، فَقِيلَ لَهُ تَقَدَّمْ : فَقَالَ :  يَتَقَدَّمُ إِمَامُكُمْ  ، قُلْنَا : إِمَامُنَا لَيْسَ هَاهُنَا ، قَالَ : "" لِيَتَقَدَّمْ رَجُلٌ مِنْكُمْ "" ، فَتَقَدَّمَ رَجُلٌ فَقَامَ عَلَى  دُكَّانٍ  فِي قِبْلَةِ الْمَسْجِدِ ، فَنَهَاهُ  عَبْدُ اللهِ  .","","Al-Mu'jam al-Kabir 9558","","عبد الله بن مسعود عن هزيل بن شرحبيل الأودي عن عبد الرحمن بن ثروان الأودي عن شعبة بن الحجاج عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","باب"
"9586","9559  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي قَيْسٍ ،  عَنْ  هُزَيْلِ بْنِ شُرَحْبِيلَ ،  عَنْ  عَبْدِ اللهِ ، أَنَّهُ :  كَرِهَ أَنْ يَؤُمَّهُمْ عَلَى الْمَكَانِ الْمُرْتَفِعِ  "" .","","Al-Mu'jam al-Kabir 9559","","عبد الله بن مسعود عن هزيل بن شرحبيل الأودي عن عبد الرحمن بن ثروان الأودي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9587","9560  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ         [9/312]      عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنْ  شَدَّادِ بْنِ مَعْقِلٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  أَوَّلُ مَا تَفْقِدُونَ مِنْ دِينِكُمُ الْأَمَانَةُ  ، وَآخِرُ مَا يَبْقَى الصَّلَاةُ ، وَلَيُصَلِّيَنَّ قَوْمٌ لَا دِينَ لَهُمْ  "" .","","Al-Mu'jam al-Kabir 9560","","عبد الله بن مسعود عن شداد بن معقل الأسدي عن عبد العزيز بن رفيع الطائفي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9588","9561  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنِ  الْأَسْوَدِ بْنِ يَزِيدَ ، وَعَلْقَمَةَ ، وَمَسْرُوقٍ ،  أَنَّ  عَبْدَ اللهِ ، قَالَ :  الصِّيَامُ مِنْ رُؤْيَةِ الْهِلَالِ إِلَى رُؤْيَتِهِ ،  فَإِنْ خَفِيَ عَلَيْكُمْ فَثَلَاثُونَ يَوْمًا  "" .","","Al-Mu'jam al-Kabir 9561","","عبد الله بن مسعود عن مسروق بن الأجدع عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9589","9562  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضْرِ  ، ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  أَنَا  عُتْبَةُ بْنُ عَمَّارٍ ،  عَنِ  ابْنِ عَيَّاشٍ  ،  عَنْ  أَبِيهِ  ،  قَالَ  :  أَتَيْتُ عَبْدَ اللهِ بْنَ مَسْعُودٍ ، فَقُلْتُ : صَامَ نَاسٌ مِنَ الْحَيِّ وَنَاسٌ مِنْ جِيرَانِنَا الْيَوْمَ ، قَالَ : "" عَنْ رُؤْيَةِ الْهِلَالِ ؟ "" قَالَ : لَا ، قَالَ :  لَأَنْ أُفْطِرَ يَوْمًا مِنْ رَمَضَانَ ، ثُمَّ أَقْضِيَهُ  ، أَحَبُّ إِلَيَّ مِنْ أَنْ أَصُومَ يَوْمًا مِنْ شَعْبَانَ ""  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : (ابن عابس) ، كما جاء عند البيهقي وابن أبي شيبة.","","Al-Mu'jam al-Kabir 9562","","عبد الله بن مسعود عن عابس بن ربيعة الغطيفي عن عبد الرحمن بن عابس النخعي عن عقبة بن عمار العبسي عن قيس بن الربيع الأسدي عن مالك بن إسماعيل النهدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9590","9563  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  جَامِعِ بْنِ شَدَّادٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ مِرْدَاسٍ ، قَالَ :  جَاءَنِي رَجُلٌ مِنَ الْحَيِّ ، فَقَالَ : إِنِّي مَرَرْتُ بِامْرَأَتِي فِي الْقَمَرِ فَأَعْجَبَتْنِي فَجَامَعْتُهَا فِي شَهْرِ رَمَضَانَ فَنِمْتُ حَتَّى أَصْبَحْتُ ، فَقُلْتُ : عَلَيْكَ  بِعَبْدِ اللهِ بْنِ مَسْعُودٍ  أَوْ  بِأَبِي حَكِيمٍ الْمُزَنِيِّ  ، فَإِذَا عَبْدُ اللهِ بْنُ مَسْعُودٍ ، فَسَأَلْتُهُ  فَقُلْتُ  : إِنِّي كُنْتُ  جُنُبًا  ، فَقَالَ :  كُنْتَ  جُنُبًا  لَا يَحِلُّ لَكَ الصَّلَاةُ ، فَاغْتَسَلْتَ فَحَلَّتْ لَكَ الصَّلَاةُ  ، وَحَلَّ لَكَ الصِّيَامُ فَصُمْ ""  .","","Al-Mu'jam al-Kabir 9563","","عبد الله بن مسعود عن عبد الله بن مرداس المحاربي عن جامع بن شداد عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9591","9564  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  يَعْلَى بْنُ الْحَارِثِ الْمُحَارِبِيُّ ، قَالَ :  سَمِعْتُ  جَامِعَ بْنَ شَدَّادٍ أَبَا صَخْرَةَ  يُحَدِّثُ ، عَنْ  عَبْدِ اللهِ بْنِ مِرْدَاسٍ ،  أَنَّهُ جَاءَ إِلَى مَسْجِدِ الْحَيِّ بَعْدَمَا صَلَّوُا الْفَجْرَ ، فَقَالَ لَهُمْ - وَذَاكَ فِي رَمَضَانَ - : إِنِّي أَصَبْتُ مِنْ أَهْلِي ، ثُمَّ غَلَبَتْنِي         [9/313]      عَيْنِي فَأَصْبَحَتُ وَلَمْ أَغْتَسِلْ فَمَا تَرَوْنَ ؟ فَقَالَ لَهُ  الْقَوْمُ  : مَا نَرَاكَ إِلَّا قَدْ أَفْطَرْتَ ،  فَانْطَلَقَ إِلَى  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، فَقَالَ لَهُمْ : أَتَيْتُ مَنْ هُوَ خَيْرٌ مِنْكُمْ أَوْ أَفْقَهُ فَقَالَ :  إِنَّمَا الْإِفْطَارُ مِنَ الطَّعَامِ ، وَالشَّرَابِ فَأَتِمَّ صَوْمَكَ  .","","Al-Mu'jam al-Kabir 9564","","عبد الله بن مسعود عن عبد الله بن مرداس المحاربي عن جامع بن شداد عن يعلى بن الحارث بن حرب المحاربي عن أحمد بن عبد الله اليربوعي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"9592","9565  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  الْمَسْعُودِيُّ ،  ثَنَا  جَامِعُ بْنُ شَدَّادٍ ،  عَنِ  الْأَسْوَدِ بْنِ هِلَالٍ ، قَالَ :  أَتَى عَبْدَ اللهِ بْنَ مَسْعُودٍ رَجُلٌ ، فَقَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، إِنِّي كُنْتُ  جُنُبًا  فَلَمْ أَغْتَسِلْ حَتَّى أَصْبَحْتُ ،  فَقَالَ  عَبْدُ اللهِ  :  كُنْتَ  جُنُبًا  لَا تَحِلُّ لَكَ الصَّلَاةُ ، فَاغْتَسَلْتَ فَحَلَّتْ لَكَ الصَّلَاةُ  ، وَحَلَّ لَكَ الصِّيَامُ ""  ، وَذَلِكَ فِي رَمَضَانَ .","","Al-Mu'jam al-Kabir 9565","","عبد الله بن مسعود عن الأسود بن هلال المحاربي عن جامع بن شداد عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","باب"
"9593","9566  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  هِشَامٍ ، قَالَ :  قَالَ  مُحَمَّدُ بْنُ سِيرِينَ :  حَدَّثَنِي  يَحْيَى بْنُ الْجَزَّارِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  لَوْ أَتَيْتُ امْرَأَةً مِنَ اللَّيْلِ ثُمَّ تَرَكْتُ الْغُسْلَ عَمْدًا  حَتَّى أُصْبِحَ لَمْ يَمْنَعْنِي مِنَ الصَّوْمِ ، إِنَّمَا أَتَيْتُهَا وَهِيَ تَحِلُّ لِي  "" .","","Al-Mu'jam al-Kabir 9566","","عبد الله بن مسعود عن يحيى بن الجزار العرني عن محمد بن سيرين عن هشام بن حسان العتكي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9594","9567  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ، وَهِشَامٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  يَحْيَى بْنِ الْجَزَّارِ ،  أَنَّ  ابْنَ مَسْعُودٍ ، قَالَ :  لَوْ أَتَيْتُ امْرَأَةً مِنَ اللَّيْلِ ، ثُمَّ تَرَكْتُ الْغُسْلَ عَمْدًا حَتَّى أُصْبِحَ  لَمْ يَمْنَعْنِي ذَلِكَ مِنَ الصَّوْمِ لِأَنِّي إِنَّمَا أَتَيْتُهَا وَهِيَ تَحِلُّ لِي  "" .","","Al-Mu'jam al-Kabir 9567","","عبد الله بن مسعود عن يحيى بن الجزار العرني عن محمد بن سيرين عن هشام بن حسان العتكي عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9595","9568  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادٌ ،  أَنَا  أَيُّوبُ ، وَهِشَامٌ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  أَنَّ  ابْنَ مَسْعُودٍ قَالَ :  لَوْ أَتَيْتُ أَهْلِي أَوَّلَ اللَّيْلِ ، ثُمَّ أَصْبَحْتُ  جُنُبًا  لَصُمْتُ  لِأَنِّي أَتَيْتُهَا وَهِيَ تَحِلُّ لِي  "" .","","Al-Mu'jam al-Kabir 9568","","عبد الله بن مسعود عن محمد بن سيرين عن هشام بن حسان العتكي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"9596","9569  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  لَوْ كُنْتُ  جُنُبًا  ، فَمَكَثْتُ شَهْرًا         [9/314]      لَا أَجِدُ الْمَاءَ مَا صَلَّيْتُ  حَتَّى أَجِدَ الْمَاءَ  "" .","","Al-Mu'jam al-Kabir 9569","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"9597","9570  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مَنْصُورٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنِ  الْهُرْمُزَانِ ،  عَنِ  ابْنِ مَسْعُودٍ ،  فِي الرَّجُلِ يُقَبِّلُ وَهُوَ صَائِمٌ ، قَالَ : "" يَقْضِي  يَوْمًا مَكَانَهُ ""  .  قَالَ  سُفْيَانُ  : ""  لَا يُؤْخَذُ بِهَذَا  "" .","","Al-Mu'jam al-Kabir 9570","","عبد الله بن مسعود عن الهرمزان الفارسي عن هلال بن يساف الأشجعي عن منصور بن المعتمر عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9598","9571  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  زَكَرِيَّا ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَمْرِو بْنِ شُرَحْبِيلَ ،  أَنَّ  ابْنَ مَسْعُودٍ كَانَ يُبَاشِرُ امْرَأَتَهُ نِصْفَ النَّهَارِ  ، وَهُوَ صَائِمٌ  "" .","","Al-Mu'jam al-Kabir 9571","","عبد الله بن مسعود عن عمرو بن شرحبيل الهمداني عن الشعبي عن زكريا بن أبي زائدة الوادعي عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9599","9572  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  وَاصِلٍ الْأَحْدَبِ ،  عَنْ  مُغِيرَةَ بْنِ عَبْدِ اللهِ الْيَشْكُرِيِّ ،  عَنْ  رَجُلٍ ، قَالَ :  قَالَ  ابْنُ مَسْعُودٍ :  مَنْ أَفْطَرَ يَوْمًا مِنْ رَمَضَانَ مِنْ غَيْرِ رُخْصَةٍ لَقِيَ اللهَ بِهِ  ، وَإِنْ صَامَ الدَّهْرَ كُلَّهُ ، إِنْ شَاءَ غَفَرَ لَهُ ، وَإِنْ شَاءَ عَذَّبَهُ . ""","","Al-Mu'jam al-Kabir 9572","","عبد الله بن مسعود عن رجل عن المغيرة بن عبد الله بن أبي عقيل اليشكري عن واصل بن حيان الأحدب عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"9600","9573  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  وَاصِلٍ الْأَحْدَبِ ،  عَنْ  مُغِيرَةَ بْنِ عَبْدِ اللهِ الْيَشْكُرِيِّ ،  عَنْ  بِلَالِ بْنِ الْحَارِثِ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  مَنْ أَفْطَرَ يَوْمًا مِنْ رَمَضَانَ ...  فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 9573","","عبد الله بن مسعود عن بلال بن الحارث بن عكيم المزني عن المغيرة بن عبد الله بن أبي عقيل اليشكري عن واصل بن حيان الأحدب عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
