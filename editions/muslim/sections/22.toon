hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3962","حَدَّثَنَا أَحْمَدُ بْنُ حَنْبَلٍ ، وَزُهَيْرُ بْنُ حَرْبٍ ، وَاللَّفْظُ لِزُهَيْرٍ، قَالَا: حَدَّثَنَا يَحْيَى وَهُوَ الْقَطَّانُ ، عَنْ عُبَيْدِ اللَّهِ ، أَخْبَرَنِي نَافِعٌ ، عَنْ ابْنِ عُمَرَ : \\"" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَامَلَ أَهْلَ خَيْبَرَ بِشَطْرِ مَا يَخْرُجُ مِنْهَا مِنْ ثَمَرٍ، أَوْ زَرْعٍ \""\"".nصحیح مسلم حدیث: 3962 عربی حدیث: 1551""","Sahih","Sahih Muslim 3962","","","1. باب: مساقات اور پھل اور کھیتی پر معاملہ کا بیان۔کسی کو زمین عاریتاًدینا"
"3963","وحَدَّثَنِي عَلِيُّ بْنُ حُجْرٍ السَّعْدِيُّ ، حَدَّثَنَا عَلِيٌّ وَهُوَ ابْنُ مُسْهِرٍ ، أَخْبَرَنَا عُبَيْدُ اللَّهِ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، قَالَ: \\"" أَعْطَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَيْبَرَ بِشَطْرِ مَا يَخْرُجُ مِنْ ثَمَرٍ، أَوْ زَرْعٍ، فَكَانَ يُعْطِي أَزْوَاجَهُ كُلَّ سَنَةٍ مِائَةَ وَسْقٍ: ثَمَانِينَ وَسْقًا مِنْ تَمْرٍ، وَعِشْرِينَ وَسْقًا مِنْ شَعِيرٍ \""\""، فَلَمَّا وَلِيَ عُمَرُ قَسَمَ خَيْبَرَ خَيَّرَ أَزْوَاجَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَنْ يُقْطِعَ لَهُنَّ الْأَرْضَ وَالْمَاءَ، أَوْ يَضْمَنَ لَهُنَّ الْأَوْسَاقَ كُلَّ عَامٍ، فَاخْتَلَفْنَ، فَمِنْهُنَّ مَنِ اخْتَارَ: الْأَرْضَ وَالْمَاءَ، وَمِنْهُنَّ مَنِ اخْتَارَ: الْأَوْسَاقَ كُلَّ عَامٍ، فَكَانَتْ عَائِشَةُ، وَحَفْصَةُ، مِمَّنْ اخْتَارَتَا الْأَرْضَ وَالْمَاءَ.nصحیح مسلم حدیث: 3963 عربی حدیث: 1551""","Sahih","Sahih Muslim 3963","","","1. باب: مساقات اور پھل اور کھیتی پر معاملہ کا بیان۔کسی کو زمین عاریتاًدیناChapter: Musaqah And Mu'amalah in return for a share of the fruit and crops"
"3964","وحَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا عُبَيْدُ اللَّهِ ، حَدَّثَنِي نَافِعٌ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَامَلَ أَهْلَ خَيْبَرَ بِشَطْرِ مَا خَرَجَ مِنْهَا مِنْ زَرْعٍ، أَوْ ثَمَرٍ، وَاقْتَصَّ الْحَدِيثَ بِنَحْوِ حَدِيثِ عَلِيِّ بْنِ مُسْهِرٍ، وَلَمْ يَذْكُرْ: فَكَانَتْ عَائِشَةُ، وَحَفْصَةُ: مِمَّنْ اخْتَارَتَا الْأَرْضَ وَالْمَاءَ، وَقَالَ: خَيَّرَ أَزْوَاجَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يُقْطِعَ لَهُنَّ الْأَرْضَ، وَلَمْ يَذْكُرِ الْمَاءَ.nصحیح مسلم حدیث: 3964 عربی حدیث: 1551","Sahih","Sahih Muslim 3964","","","1. باب: مساقات اور پھل اور کھیتی پر معاملہ کا بیان۔کسی کو زمین عاریتاًدیناChapter: Musaqah And Mu'amalah in return for a share of the fruit and crops"
"3965","وحَدَّثَنِي أَبُو الطَّاهِرِ ، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، أَخْبَرَنِي أُسَامَةُ بْنُ زَيْدٍ اللَّيْثِيُّ ، عَنْ نَافِعٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، قَالَ: لَمَّا افْتُتِحَتْ خَيْبَرُ، سَأَلَتْ يَهُودُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: أَنْ يُقِرَّهُمْ فِيهَا عَلَى أَنْ يَعْمَلُوا عَلَى نِصْفِ مَا خَرَجَ مِنْهَا مِنَ الثَّمَرِ، وَالزَّرْعِ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" أُقِرُّكُمْ فِيهَا عَلَى ذَلِكَ مَا شِئْنَا \""\""، ثُمَّ سَاقَ الْحَدِيثَ بِنَحْوِ حَدِيثِ ابْنِ نُمَيْرٍ، وَابْنِ مُسْهِرٍ، عَنْ عُبَيْدِ اللَّهِ، وَزَادَ فِيهِ: وَكَانَ الثَّمَرُ يُقْسَمُ عَلَى السُّهْمَانِ مِنْ نِصْفِ خَيْبَرَ، فَيَأْخُذُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْخُمْسَ.nصحیح مسلم حدیث: 3965 عربی حدیث: 1551""","Sahih","Sahih Muslim 3965","","","1. باب: مساقات اور پھل اور کھیتی پر معاملہ کا بیان۔پھل ارو کھیتی کے کسی حصے پر پانی دینے اور کھیتی کے کام کا معاہدہ کرناChapter: Musaqah And Mu'amalah in return for a share of the fruit and crops"
"3966","وحَدَّثَنَا ابْنُ رُمْحٍ ، أَخْبَرَنَا اللَّيْثُ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ نَافِعٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" أَنَّهُ دَفَعَ إِلَى يَهُودِ خَيْبَرَ نَخْلَ خَيْبَرَ وَأَرْضَهَا، عَلَى أَنْ يَعْتَمِلُوهَا مِنْ أَمْوَالِهِمْ، وَلِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ شَطْرُ ثَمَرِهَا \""\"".nصحیح مسلم حدیث: 3966 عربی حدیث: 1551""","Sahih","Sahih Muslim 3966","","","1. باب: مساقات اور پھل اور کھیتی پر معاملہ کا بیان۔پھل ارو کھیتی کے کسی حصے پر پانی دینے اور کھیتی کے کام کا معاہدہ کرناChapter: Musaqah And Mu'amalah in return for a share of the fruit and crops"
"3967","وحَدَّثَنِي مُحَمَّدُ بْنُ رَافِعٍ ، وَإِسْحَاقُ بْنُ مَنْصُورٍ ، وَاللَّفْظُ لِابْنِ رَافِعٍ، قَالَا: حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا ابْنُ جُرَيْجٍ ، حَدَّثَنِي مُوسَى بْنُ عُقْبَةَ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَجْلَى الْيَهُودَ، وَالنَّصَارَى مِنْ أَرْضِ الْحِجَازِ، وَأَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمَّا ظَهَرَ عَلَى خَيْبَرَ أَرَادَ إِخْرَاجَ الْيَهُودِ مِنْهَا، وَكَانَتِ الْأَرْضُ حِينَ ظُهِرَ عَلَيْهَا لِلَّهِ وَلِرَسُولِهِ وَلِلْمُسْلِمِينَ، فَأَرَادَ إِخْرَاجَ الْيَهُودِ مِنْهَا، فَسَأَلَتْ الْيَهُودُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يُقِرَّهُمْ بِهَا عَلَى أَنْ يَكْفُوا عَمَلَهَا، وَلَهُمْ نِصْفُ الثَّمَرِ، فَقَالَ لَهُمْ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" نُقِرُّكُمْ بِهَا عَلَى ذَلِكَ مَا شِئْنَا \""\""، فَقَرُّوا بِهَا حَتَّى أَجْلَاهُمْ عُمَرُ إِلَى تَيْمَاءَ، وَأَرِيحَاءَ.nصحیح مسلم حدیث: 3967 عربی حدیث: 1551""","Sahih","Sahih Muslim 3967","","","1. باب: مساقات اور پھل اور کھیتی پر معاملہ کا بیان۔پھل ارو کھیتی کے کسی حصے پر پانی دینے اور کھیتی کے کام کا معاہدہ کرناChapter: Musaqah And Mu'amalah in return for a share of the fruit and crops"
"3968","حَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا عَبْدُ الْمَلِكِ ، عَنْ عَطَاءٍ ، عَنْ جَابِرٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَا مِنْ مُسْلِمٍ يَغْرِسُ غَرْسًا، إِلَّا كَانَ مَا أُكِلَ مِنْهُ لَهُ صَدَقَةً، وَمَا سُرِقَ مِنْهُ لَهُ صَدَقَةٌ، وَمَا أَكَلَ السَّبُعُ مِنْهُ فَهُوَ لَهُ صَدَقَةٌ، وَمَا أَكَلَتِ الطَّيْرُ فَهُوَ لَهُ صَدَقَةٌ، وَلَا يَرْزَؤُهُ أَحَدٌ، إِلَّا كَانَ لَهُ صَدَقَةٌ \""\"".nصحیح مسلم حدیث: 3968 عربی حدیث: 1552""","Sahih","Sahih Muslim 3968","","","2. باب: درخت لگانے کی اور کھیتی کی فضیلت۔پھل ارو کھیتی کے کسی حصے پر پانی دینے اور کھیتی کے کام کا معاہدہ کرناChapter: Musaqah And Mu'amalah in return for a share of the fruit and crops"
"3969","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ رُمْحٍ ، أَخْبَرَنَا اللَّيْثُ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ : أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ دَخَلَ عَلَى أُمِّ مُبَشِّرٍ الْأَنْصَارِيَّةِ فِي نَخْلٍ لَهَا، فَقَالَ لَهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنْ غَرَسَ هَذَا النَّخْلَ أَمُسْلِمٌ أَمْ كَافِرٌ؟ \""\""، فَقَالَتْ: بَلْ مُسْلِمٌ، فَقَالَ: \""\"" لَا يَغْرِسُ مُسْلِمٌ غَرْسًا وَلَا يَزْرَعُ زَرْعًا، فَيَأْكُلَ مِنْهُ إِنْسَانٌ، وَلَا دَابَّةٌ، وَلَا شَيْءٌ، إِلَّا كَانَتْ لَهُ صَدَقَةٌ \""\"".nصحیح مسلم حدیث: 3969 عربی حدیث: 1552""","Sahih","Sahih Muslim 3969","","","2. باب: درخت لگانے کی اور کھیتی کی فضیلت۔پھل ارو کھیتی کے کسی حصے پر پانی دینے اور کھیتی کے کام کا معاہدہ کرناChapter: Musaqah And Mu'amalah in return for a share of the fruit and crops"
"3970","وحَدَّثَنِي مُحَمَّدُ بْنُ حَاتِمٍ ، وَابْنُ أَبِي خَلَفٍ ، قَالَا: حَدَّثَنَا رَوْحٌ ، حَدَّثَنَا ابْنُ جُرَيْجٍ ، أَخْبَرَنِي أَبُو الزُّبَيْرِ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" لَا يَغْرِسُ رَجُلٌ مُسْلِمٌ غَرْسًا، وَلَا زَرْعًا، فَيَأْكُلَ مِنْهُ سَبُعٌ، أَوْ طَائِرٌ، أَوْ شَيْءٌ، إِلَّا كَانَ لَهُ فِيهِ أَجْرٌ \""\""، وَقَالَ ابْنُ أَبِي خَلَفٍ: طَائِرٌ شَيْءٌ.nصحیح مسلم حدیث: 3970 عربی حدیث: 1552""","Sahih","Sahih Muslim 3970","","","2. باب: درخت لگانے کی اور کھیتی کی فضیلت۔پھل ارو کھیتی کے کسی حصے پر پانی دینے اور کھیتی کے کام کا معاہدہ کرناChapter: Musaqah And Mu'amalah in return for a share of the fruit and crops"
"3971","حَدَّثَنَا أَحْمَدُ بْنُ سَعِيدِ بْنِ إِبْرَاهِيمَ ، حَدَّثَنَا رَوْحُ بْنُ عُبَادَةَ ، حَدَّثَنَا زَكَرِيَّاءُ بْنُ إِسْحَاقَ ، أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: دَخَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى أُمِّ مَعْبَدٍ حَائِطًا، فَقَالَ: \\"" يَا أُمَّ مَعْبَدٍ، مَنْ غَرَسَ هَذَا النَّخْلَ أَمُسْلِمٌ أَمْ كَافِرٌ؟ \""\""، فَقَالَتْ: بَلْ مُسْلِمٌ، قَالَ: \""\"" فَلَا يَغْرِسُ الْمُسْلِمُ غَرْسًا، فَيَأْكُلَ مِنْهُ إِنْسَانٌ، وَلَا دَابَّةٌ، وَلَا طَيْرٌ، إِلَّا كَانَ لَهُ صَدَقَةً إِلَى يَوْمِ الْقِيَامَة \""\"".nصحیح مسلم حدیث: 3971 عربی حدیث: 1552""","Sahih","Sahih Muslim 3971","","","2. باب: درخت لگانے کی اور کھیتی کی فضیلت۔شجر کاری اور کاشت کاری کی فضیلتChapter: The Virtue of Planting and Cultivating"
"3972","وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا حَفْصُ بْنُ غِيَاثٍ . ح وحَدَّثَنَا أَبُو كُرَيْبٍ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، جميعا عَنْ أَبِي مُعَاوِيَةَ . ح وحَدَّثَنَا عَمْرٌو النَّاقِدُ ، حَدَّثَنَا عَمَّارُ بْنُ مُحَمَّدٍ . ح وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا ابْنُ فُضَيْلٍ ، كُلُّ هَؤُلَاءِ عَنْ الْأَعْمَشِ ، عَنْ أَبِي سُفْيَانَ ، عَنْ جَابِرٍ ، زَادَ عَمْرٌو فِي رِوَايَتِهِ، عَنْ عَمَّارٍ . ح وَأَبُو كُرَيْبٍ فِي رِوَايَتِهِ، عَنْ أَبِي مُعَاوِيَةَ ، فَقَالَا: عَنْ أُمِّ مُبَشِّرٍ ، وَفِي رِوَايَةِ ابْنِ فُضَيْلٍ: عَنْ امْرَأَةِ زَيْدِ بْنِ حَارِثَةَ، وَفِي رِوَايَةِ إِسْحَاقَ: عَنْ أَبِي مُعَاوِيَةَ، قَالَ: رُبَّمَا قَالَ: عَنْ أُمِّ مُبَشِّرٍ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَرُبَّمَا لَمْ يَقُلْ، وَكُلُّهُمْ قَالُوا: عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِنَحْوِ حَدِيثِ عَطَاءٍ، وَأَبِي الزُّبَيْرِ، وَعَمْرِو بْنِ دِينَارٍ.nصحیح مسلم حدیث: 3972 عربی حدیث: 1552","Sahih","Sahih Muslim 3972","","","2. باب: درخت لگانے کی اور کھیتی کی فضیلت۔شجر کاری اور کاشت کاری کی فضیلتChapter: The Virtue of Planting and Cultivating"
"3973","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، وَقُتَيْبَةُ بْنُ سَعِيدٍ ، وَمُحَمَّدُ بْنُ عُبَيْدٍ الْغُبَرِيُّ ، وَاللَّفْظُ لِيَحْيَى، قَالَ يَحْيَى: أَخْبَرَنَا، وقَالَ الْآخَرَانِ: حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ قَتَادَةَ ، عَنْ أَنَسٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَا مِنْ مُسْلِمٍ يَغْرِسُ غَرْسًا، أَوْ يَزْرَعُ زَرْعًا، فَيَأْكُلُ مِنْهُ طَيْرٌ، أَوْ إِنْسَانٌ، أَوْ بَهِيمَةٌ، إِلَّا كَانَ لَهُ بِهِ صَدَقَةٌ \""\"".nصحیح مسلم حدیث: 3973 عربی حدیث: 1553""","Sahih","Sahih Muslim 3973","","","2. باب: درخت لگانے کی اور کھیتی کی فضیلت۔شجر کاری اور کاشت کاری کی فضیلتChapter: The Virtue of Planting and Cultivating"
"3974","وحَدَّثَنَا عَبْدُ بْنُ حُمَيْدٍ ، حَدَّثَنَا مُسْلِمُ بْنُ إِبْرَاهِيمَ ، حَدَّثَنَا أَبَانُ بْنُ يَزِيدَ ، حَدَّثَنَا قَتَادَةُ ، حَدَّثَنَا أَنَسُ بْنُ مَالِكٍ : أَنَّ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ دَخَلَ نَخْلًا لِأُمِّ مُبَشِّرٍ امْرَأَةٍ مِنْ الْأَنْصَارِ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنْ غَرَسَ هَذَا النَّخْلَ، أَمُسْلِمٌ أَمْ كَافِرٌ؟ \""\""، قَالُوا: مُسْلِمٌ، بِنَحْوِ حَدِيثِهِمْ.nصحیح مسلم حدیث: 3974 عربی حدیث: 1553""","Sahih","Sahih Muslim 3974","","","2. باب: درخت لگانے کی اور کھیتی کی فضیلت۔شجر کاری اور کاشت کاری کی فضیلتChapter: The Virtue of Planting and Cultivating"
"3975","حَدَّثَنِي أَبُو الطَّاهِرِ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، عَنْ ابْنِ جُرَيْجٍ ، أَنَّ أَبَا الزُّبَيْرِ ، أَخْبَرَهُ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" إِنْ بِعْتَ مِنْ أَخِيكَ ثَمَرًا \""\"". ح وحَدَّثَنَا مُحَمَّدُ بْنُ عَبَّادٍ ، حَدَّثَنَا أَبُو ضَمْرَةَ ، عَنْ ابْنِ جُرَيْجٍ ، عَنْ أَبِي الزُّبَيْرِ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \""\"" لَوْ بِعْتَ مِنْ أَخِيكَ ثَمَرًا، فَأَصَابَتْهُ جَائِحَةٌ، فَلَا يَحِلُّ لَكَ أَنْ تَأْخُذَ مِنْهُ شَيْئًا، بِمَ تَأْخُذُ مَالَ أَخِيكَ بِغَيْرِ حَقٍّ \""\"".nصحیح مسلم حدیث: 3975 عربی حدیث: 1554""","Sahih","Sahih Muslim 3975","","","3. باب: آفت سے جو نقصان ہو اس کو مجرا دینا۔شجر کاری اور کاشت کاری کی فضیلتChapter: The Virtue of Planting and Cultivating"
"3976","وحَدَّثَنَا حَسَنٌ الْحُلْوَانِيُّ ، حَدَّثَنَا أَبُو عَاصِمٍ ، عَنْ ابْنِ جُرَيْجٍ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ.nصحیح مسلم حدیث: 3976 عربی حدیث: 1554","Sahih","Sahih Muslim 3976","","","3. باب: آفت سے جو نقصان ہو اس کو مجرا دینا۔شجر کاری اور کاشت کاری کی فضیلتChapter: The Virtue of Planting and Cultivating"
"3977","حَدَّثَنَا يَحْيَى بْنُ أَيُّوبَ ، وَقُتَيْبَةُ ، وَعَلِيُّ بْنُ حُجْرٍ ، قَالُوا: حَدَّثَنَا إِسْمَاعِيلُ بْنُ جَعْفَرٍ ، عَنْ حُمَيْدٍ ، عَنْ أَنَسٍ : أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" نَهَى عَنْ بَيْعِ ثَمَرِ النَّخْلِ حَتَّى تَزْهُوَ \""\""، فَقُلْنَا لِأَنَسٍ: مَا زَهْوُهَا؟ قَالَ: تَحْمَرُّ، وَتَصْفَرُّ، أَرَأَيْتَكَ إِنْ مَنَعَ اللَّهُ الثَّمَرَةَ، بِمَ تَسْتَحِلُّ مَالَ أَخِيكَ؟.nصحیح مسلم حدیث: 3977 عربی حدیث: 1555""","Sahih","Sahih Muslim 3977","","","3. باب: آفت سے جو نقصان ہو اس کو مجرا دینا۔شجر کاری اور کاشت کاری کی فضیلتChapter: The Virtue of Planting and Cultivating"
"3978","حَدَّثَنِي أَبُو الطَّاهِرِ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي مَالِكٌ ، عَنْ حُمَيْدٍ الطَّوِيلِ ، عَنْ أَنَسِ بْنِ مَالِكٍ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" نَهَى عَنْ بَيْعِ الثَّمَرَةِ حَتَّى تُزْهِيَ \""\""، قَالُوا: وَمَا تُزْهِيَ؟ قَالَ: تَحْمَرُّ، فَقَالَ: إِذَا مَنَعَ اللَّهُ الثَّمَرَةَ، فَبِمَ تَسْتَحِلُّ مَالَ أَخِيكَ؟.nصحیح مسلم حدیث: 3978 عربی حدیث: 1555""","Sahih","Sahih Muslim 3978","","","3. باب: آفت سے جو نقصان ہو اس کو مجرا دینا۔قدرتی آفات سے ہونے والے نقصان کی تلافی کرناChapter: Waiving Payment in the case of Blight"
"3979","حَدَّثَنِي مُحَمَّدُ بْنُ عَبَّادٍ ، حَدَّثَنَا عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ، عَنْ حُمَيْدٍ ، عَنْ أَنَسٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" إِنْ لَمْ يُثْمِرْهَا اللَّهُ، فَبِمَ يَسْتَحِلُّ أَحَدُكُمْ مَالَ أَخِيهِ؟ \""\"".nصحیح مسلم حدیث: 3979 عربی حدیث: 1555""","Sahih","Sahih Muslim 3979","","","3. باب: آفت سے جو نقصان ہو اس کو مجرا دینا۔قدرتی آفات سے ہونے والے نقصان کی تلافی کرناChapter: Waiving Payment in the case of Blight"
"3980","حَدَّثَنَا بِشْرُ بْنُ الْحَكَمِ ، وَإِبْرَاهِيمُ بْنُ دِينَارٍ ، وَعَبْدُ الْجَبَّارِ بْنُ الْعَلَاءِ ، وَاللَّفْظُ لِبِشْرٍ، قَالُوا: حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ حُمَيْدٍ الْأَعْرَجِ ، عَنْ سُلَيْمَانَ بْنِ عَتِيقٍ ، عَنْ جَابِرٍ : أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" أَمَرَ بِوَضْعِ الْجَوَائِحِ \""\"". قَالَ أَبُو إِسْحَاقَ، وَهُوَ صَاحِبُ مُسْلِمٍ: حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ بِشْرٍ، عَنْ سُفْيَانَ، بِهَذَا.nصحیح مسلم حدیث: 3980 عربی حدیث: 1554""","Sahih","Sahih Muslim 3980","","","3. باب: آفت سے جو نقصان ہو اس کو مجرا دینا۔قدرتی آفات سے ہونے والے نقصان کی تلافی کرناChapter: Waiving Payment in the case of Blight"
"3981","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ ، عَنْ بُكَيْرٍ ، عَنْ عِيَاضِ بْنِ عَبْدِ اللَّهِ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ: أُصِيبَ رَجُلٌ فِي عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي ثِمَارٍ ابْتَاعَهَا، فَكَثُرَ دَيْنُهُ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" تَصَدَّقُوا عَلَيْهِ \""\""، فَتَصَدَّقَ النَّاسُ عَلَيْهِ، فَلَمْ يَبْلُغْ ذَلِكَ وَفَاءَ دَيْنِهِ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِغُرَمَائِهِ: \""\"" خُذُوا مَا وَجَدْتُمْ وَلَيْسَ لَكُمْ إِلَّا ذَلِكَ \""\"".nصحیح مسلم حدیث: 3981 عربی حدیث: 1556""","Sahih","Sahih Muslim 3981","","","4. باب: قرض میں سے کچھ معاف کر دینا مستحب ہے (اگر قرضدار کو تکلیف ہو)۔قدرتی آفات سے ہونے والے نقصان کی تلافی کرناChapter: Waiving Payment in the case of Blight"
"3982","حَدَّثَنِي يُونُسُ بْنُ عَبْدِ الْأَعْلَى ، أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، أَخْبَرَنِي عَمْرُو بْنُ الْحَارِثِ ، عَنْ بُكَيْرِ بْنِ الْأَشَجِّ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ.nصحیح مسلم حدیث: 3982 عربی حدیث: 1556","Sahih","Sahih Muslim 3982","","","4. باب: قرض میں سے کچھ معاف کر دینا مستحب ہے (اگر قرضدار کو تکلیف ہو)۔قدرتی آفات سے ہونے والے نقصان کی تلافی کرناChapter: Waiving Payment in the case of Blight"
"3983","وحَدَّثَنِي غَيْرُ وَاحِدٍ مِنْ أَصْحَابِنَا، قَالُوا: حَدَّثَنَا إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ، حَدَّثَنِي أَخِي ، عَنْ سُلَيْمَانَ وَهُوَ ابْنُ بِلَالٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ أَبِي الرِّجَالِ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ أُمَّهُ عَمْرَةَ بِنْتَ عَبْدِ الرَّحْمَنِ ، قَالَتْ: سَمِعْتُ عَائِشَةَ ، تَقُولُ: سَمِعَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، صَوْتَ خُصُومٍ بِالْبَابِ عَالِيَةٍ أَصْوَاتُهُمَا، وَإِذَا أَحَدُهُمَا يَسْتَوْضِعُ الْآخَرَ، وَيَسْتَرْفِقُهُ فِي شَيْءٍ، وَهُوَ يَقُولُ: وَاللَّهِ لَا أَفْعَلُ، فَخَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَيْهِمَا، فَقَالَ: \\"" أَيْنَ الْمُتَأَلِّي عَلَى اللَّهِ لَا يَفْعَلُ الْمَعْرُوفَ؟ قَالَ: أَنَا يَا رَسُولَ اللَّهِ، فَلَهُ أَيُّ ذَلِكَ أَحَبَّ \""\"".nصحیح مسلم حدیث: 3983 عربی حدیث: 1557""","Sahih","Sahih Muslim 3983","","","4. باب: قرض میں سے کچھ معاف کر دینا مستحب ہے (اگر قرضدار کو تکلیف ہو)۔قدرتی آفات سے ہونے والے نقصان کی تلافی کرناChapter: Waiving Payment in the case of Blight"
"3984","حَدَّثَنَا حَرْمَلَةُ بْنُ يَحْيَى ، أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، حَدَّثَنِي عَبْدُ اللَّهِ بْنُ كَعْبِ بْنِ مَالِكٍ ، أَخْبَرَهُ عَنْ أَبِيهِ ، أَنَّهُ تَقَاضَى ابْنَ أَبِي حَدْرَدٍ دَيْنًا كَانَ لَهُ عَلَيْهِ فِي عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْمَسْجِدِ، فَارْتَفَعَتْ أَصْوَاتُهُمَا حَتَّى سَمِعَهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ فِي بَيْتِهِ، فَخَرَجَ إِلَيْهِمَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَتَّى كَشَفَ سِجْفَ حُجْرَتِهِ وَنَادَى كَعْبَ بْنَ مَالِكٍ، فَقَالَ: يَا كَعْبُ، فَقَالَ: لَبَّيْكَ يَا رَسُولَ اللَّهِ، \\"" فَأَشَارَ إِلَيْهِ بِيَدِهِ أَنْ ضَعِ الشَّطْرَ مِنْ دَيْنِكَ، قَالَ كَعْبٌ: قَدْ فَعَلْتُ يَا رَسُولَ اللَّهِ، قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \""\"" قُمْ فَاقْضِهِ \""\"".nصحیح مسلم حدیث: 3984 عربی حدیث: 1558""","Sahih","Sahih Muslim 3984","","","4. باب: قرض میں سے کچھ معاف کر دینا مستحب ہے (اگر قرضدار کو تکلیف ہو)۔قرض میں سے کچھ معاف کر دینا (اللہ کے نزدیک )پسندیدہ ہےChapter: It is recommended to waive debts"
"3985","وحَدَّثَنَاه إِسْحَاق بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا عُثْمَانُ بْنُ عُمَرَ ، أَخْبَرَنَا يُونُسُ ، عَنْ الزُّهْرِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ كَعْبِ بْنِ مَالِكٍ ، أَنَّ كَعْبَ بْنَ مَالِكٍ ، أَخْبَرَهُ، أَنَّهُ تَقَاضَى دَيْنًا لَهُ عَلَى ابْنِ أَبِي حَدْرَدٍ، بِمِثْلِ حَدِيثِ ابْنِ وَهْبٍ،nصحیح مسلم حدیث: 3985 عربی حدیث: 1558","Sahih","Sahih Muslim 3985","","","4. باب: قرض میں سے کچھ معاف کر دینا مستحب ہے (اگر قرضدار کو تکلیف ہو)۔قرض میں سے کچھ معاف کر دینا (اللہ کے نزدیک )پسندیدہ ہےChapter: It is recommended to waive debts"
"3986","قَالَ مُسْلِم: وَرَوَى اللَّيْثُ بْنُ سَعْدٍ ، حَدَّثَنِي جَعْفَرُ بْنُ رَبِيعَةَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ هُرْمُزَ ، عَنْ عَبْدِ اللَّهِ بْنِ كَعْبِ بْنِ مَالِكٍ ، عَنْ كَعْبِ بْنِ مَالِكٍ ، أَنَّهُ كَانَ لَهُ مَالٌ عَلَى عَبْدِ اللَّهِ بْنِ أَبِي حَدْرَدٍ الْأَسْلَمِيِّ، فَلَقِيَهُ فَلَزِمَهُ، فَتَكَلَّمَا حَتَّى ارْتَفَعَتْ أَصْوَاتُهُمَا، فَمَرَّ بِهِمَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: \\"" يَا كَعْبُ \""\""، فَأَشَارَ بِيَدِهِ كَأَنَّهُ يَقُولُ: النِّصْفَ، فَأَخَذَ نِصْفًا مِمَّا عَلَيْهِ وَتَرَكَ نِصْفًا.nصحیح مسلم حدیث: 3986 عربی حدیث: 1558""","Sahih","Sahih Muslim 3986","","","4. باب: قرض میں سے کچھ معاف کر دینا مستحب ہے (اگر قرضدار کو تکلیف ہو)۔قرض میں سے کچھ معاف کر دینا (اللہ کے نزدیک )پسندیدہ ہےChapter: It is recommended to waive debts"
"3987","حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ بْنِ يُونُسَ ، حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ ، أَخْبَرَنِي أَبُو بَكْرِ بْنُ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ ، أَخْبَرَهُ، أَنَّ أَبَا بَكْرِ بْنَ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ، أَخْبَرَهُ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَوْ سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" مَنْ أَدْرَكَ مَالَهُ بِعَيْنِهِ عِنْدَ رَجُلٍ قَدْ أَفْلَسَ، أَوْ إِنْسَانٍ قَدْ أَفْلَسَ، فَهُوَ أَحَقُّ بِهِ مِنْ غَيْرِهِ \""\""،nصحیح مسلم حدیث: 3987 عربی حدیث: 1559""","Sahih","Sahih Muslim 3987","","","5. باب: اگر خریدار مفلس ہو جائے اور بائع مشتری کے پاس اپنی چیز بجنسہ پائے تو واپس لے سکتا ہے۔قرض میں سے کچھ معاف کر دینا (اللہ کے نزدیک )پسندیدہ ہےChapter: It is recommended to waive debts"
"3988","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، أَخْبَرَنَا هُشَيْمٌ . ح وحَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، وَمُحَمَّدُ بْنُ رُمْحٍ ، جميعا عَنْ اللَّيْثِ بْنِ سَعْدٍ . ح وحَدَّثَنَا أَبُو الرَّبِيعِ ، وَيَحْيَى بْنُ حَبِيبٍ الْحَارِثِيُّ ، قَالَا: حَدَّثَنَا حَمَّادٌ يَعْنِي ابْنَ زَيْدٍ . ح وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا عَبْدُ الْوَهَّابِ ، وَيَحْيَى بْنُ سَعِيدٍ ، وَحَفْصُ بْنُ غِيَاثٍ ، كل هؤلاء عَنْ يَحْيَى بْنِ سَعِيدٍ ، فِي هَذَا الْإِسْنَادِ بِمَعْنَى حَدِيثِ زُهَيْرٍ، وقَالَ ابْنُ رُمْحٍ: مِنْ بَيْنِهِمْ فِي رِوَايَتِهِ: أَيُّمَا امْرِئٍ فُلِّسَ.nصحیح مسلم حدیث: 3988 عربی حدیث: 1559","Sahih","Sahih Muslim 3988","","","5. باب: اگر خریدار مفلس ہو جائے اور بائع مشتری کے پاس اپنی چیز بجنسہ پائے تو واپس لے سکتا ہے۔قرض میں سے کچھ معاف کر دینا (اللہ کے نزدیک )پسندیدہ ہےChapter: It is recommended to waive debts"
"3989","حَدَّثَنَا ابْنُ أَبِي عُمَرَ ، حَدَّثَنَا هِشَامُ بْنُ سُلَيْمَانَ وَهُوَ ابْنُ عِكْرِمَةَ بْنِ خَالِدٍ الْمَخْزُومِيُّ ، عَنْ ابْنِ جُرَيْجٍ ، حَدَّثَنِي ابْنُ أَبِي حُسَيْنٍ ، أَنَّ أَبَا بَكْرِ بْنَ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، أَخْبَرَهُ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ ، حَدَّثَهُ، عَنْ حَدِيثِ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ حَدِيثِ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" فِي الرَّجُلِ الَّذِي يُعْدِمُ، إِذَا وُجِدَ عِنْدَهُ الْمَتَاعُ، وَلَمْ يُفَرِّقْهُ أَنَّهُ لِصَاحِبِهِ الَّذِي بَاعَهُ \""\"".nصحیح مسلم حدیث: 3989 عربی حدیث: 1559""","Sahih","Sahih Muslim 3989","","","5. باب: اگر خریدار مفلس ہو جائے اور بائع مشتری کے پاس اپنی چیز بجنسہ پائے تو واپس لے سکتا ہے۔قرض میں سے کچھ معاف کر دینا (اللہ کے نزدیک )پسندیدہ ہےChapter: It is recommended to waive debts"
"3990","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، وَعَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ، قَالَا: حَدَّثَنَا شُعْبَةُ ، عَنْ قَتَادَةَ ، عَنْ النَّضْرِ بْنِ أَنَسٍ ، عَنْ بَشِيرِ بْنِ نَهِيكٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" إِذَا أَفْلَسَ الرَّجُلُ، فَوَجَدَ الرَّجُلُ مَتَاعَهُ بِعَيْنِهِ، فَهُوَ أَحَقُّ بِهِ \""\"".nصحیح مسلم حدیث: 3990 عربی حدیث: 1559""","Sahih","Sahih Muslim 3990","","","5. باب: اگر خریدار مفلس ہو جائے اور بائع مشتری کے پاس اپنی چیز بجنسہ پائے تو واپس لے سکتا ہے۔جس نے اپنا فروخت کیا ہوا ما ل خریدار کے پاس پایا اور وہ (خریدار )مفلس ہو چکا ہے تو اس چیز کو واپس لینے کا حق اسی کا ہےChapter: If a man finds what he sold with the purchaser, who has become bankrupt, then he has the right to take it back"
"3991","وحَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا إِسْمَاعِيل بْنُ إِبْرَاهِيمَ ، حَدَّثَنَا سَعِيدٌ . ح وحَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ أَيْضًا، حَدَّثَنَا مُعَاذُ بْنُ هِشَامٍ ، حَدَّثَنِي أَبِي ، كِلَاهُمَا عَنْ قَتَادَةَ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ، وَقَالَا: فَهُوَ أَحَقُّ بِهِ مِنَ الْغُرَمَاءِ.nصحیح مسلم حدیث: 3991 عربی حدیث: 1559","Sahih","Sahih Muslim 3991","","","5. باب: اگر خریدار مفلس ہو جائے اور بائع مشتری کے پاس اپنی چیز بجنسہ پائے تو واپس لے سکتا ہے۔جس نے اپنا فروخت کیا ہوا ما ل خریدار کے پاس پایا اور وہ (خریدار )مفلس ہو چکا ہے تو اس چیز کو واپس لینے کا حق اسی کا ہےChapter: If a man finds what he sold with the purchaser, who has become bankrupt, then he has the right to take it back"
"3992","وحَدَّثَنِي مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَلَفٍ ، وَحَجَّاجُ بْنُ الشَّاعِرِ ، قَالَا: حَدَّثَنَا أَبُو سَلَمَةَ الْخُزَاعِيُّ ، قَالَ حَجَّاجٌ مَنْصُورُ بْنُ سَلَمَةَ، أَخْبَرَنَا سُلَيْمَانُ بْنُ بِلَالٍ ، عَنْ خُثَيْمِ بْنِ عِرَاكٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" إِذَا أَفْلَسَ الرَّجُلُ، فَوَجَدَ الرَّجُلُ عِنْدَهُ سِلْعَتَهُ بِعَيْنِهَا، فَهُوَ أَحَقُّ بِهَا \""\"".nصحیح مسلم حدیث: 3992 عربی حدیث: 1559""","Sahih","Sahih Muslim 3992","","","5. باب: اگر خریدار مفلس ہو جائے اور بائع مشتری کے پاس اپنی چیز بجنسہ پائے تو واپس لے سکتا ہے۔جس نے اپنا فروخت کیا ہوا ما ل خریدار کے پاس پایا اور وہ (خریدار )مفلس ہو چکا ہے تو اس چیز کو واپس لینے کا حق اسی کا ہےChapter: If a man finds what he sold with the purchaser, who has become bankrupt, then he has the right to take it back"
"3993","حَدَّثَنَا حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ بْنِ يُونُسَ ، حَدَّثَنَا زُهَيْرٌ ، حَدَّثَنَا مَنْصُورٌ ، عَنْ رِبْعِيِّ بْنِ حِرَاشٍ ، أَنَّ حُذَيْفَةَ ، حَدَّثَهُمْ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" تَلَقَّتِ الْمَلَائِكَةُ رُوحَ رَجُلٍ مِمَّنْ كَانَ قَبْلَكُمْ، فَقَالُوا: أَعَمِلْتَ مِنَ الْخَيْرِ شَيْئًا؟ قَالَ: لَا، قَالُوا: تَذَكَّرْ، قَالَ: كُنْتُ أُدَايِنُ النَّاسَ، فَآمُرُ فِتْيَانِي: أَنْ يُنْظِرُوا الْمُعْسِرَ، وَيَتَجَوَّزُوا عَنِ الْمُوسِرِ، قَالَ: قَالَ اللَّهُ عَزَّ وَجَلَّ: تَجَوَّزُوا عَنْهُ \""\"".nصحیح مسلم حدیث: 3993 عربی حدیث: 1560""","Sahih","Sahih Muslim 3993","","","6. باب: مفلس کو مہلت دینے کی اور قرض وصول کرنے میں آسانی کرنے کی فضیلت۔جس نے اپنا فروخت کیا ہوا ما ل خریدار کے پاس پایا اور وہ (خریدار )مفلس ہو چکا ہے تو اس چیز کو واپس لینے کا حق اسی کا ہےChapter: If a man finds what he sold with the purchaser, who has become bankrupt, then he has the right to take it back"
"3994","حَدَّثَنَا حَدَّثَنَا عَلِيُّ بْنُ حُجْرٍ ، وَإِسْحَاق بْنُ إِبْرَاهِيمَ ، وَاللَّفْظُ لِابْنِ حُجْرٍ، قَالَا: حَدَّثَنَا جَرِيرٌ ، عَنْ الْمُغِيرَةِ ، عَنْ نُعَيْمِ بْنِ أَبِي هِنْدٍ ، عَنْ رِبْعِيِّ بْنِ حِرَاشٍ ، قَالَ: اجْتَمَعَ حُذَيْفَةُ، وَأَبُو مَسْعُودٍ، فَقَالَ حُذَيْفَةُ : \\"" رَجُلٌ لَقِيَ رَبَّهُ، فَقَالَ: مَا عَمِلْتَ؟ قَالَ: مَا عَمِلْتُ مِنَ الْخَيْرِ، إِلَّا أَنِّي كُنْتُ رَجُلًا ذَا مَالٍ، فَكُنْتُ أُطَالِبُ بِهِ النَّاسَ، فَكُنْتُ أَقْبَلُ الْمَيْسُورَ، وَأَتَجَاوَزُ عَنِ الْمَعْسُورِ، فَقَالَ: تَجَاوَزُوا عَنْ عَبْدِي \""\""، قَالَ أَبُو مَسْعُودٍ : هَكَذَا سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ.nصحیح مسلم حدیث: 3994 عربی حدیث: 1560""","Sahih","Sahih Muslim 3994","","","6. باب: مفلس کو مہلت دینے کی اور قرض وصول کرنے میں آسانی کرنے کی فضیلت۔جس نے اپنا فروخت کیا ہوا ما ل خریدار کے پاس پایا اور وہ (خریدار )مفلس ہو چکا ہے تو اس چیز کو واپس لینے کا حق اسی کا ہےChapter: If a man finds what he sold with the purchaser, who has become bankrupt, then he has the right to take it back"
"3995","حَدَّثَنَا حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، عَنْ عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ، عَنْ رِبْعِيِّ بْنِ حِرَاشٍ ، عَنْ حُذَيْفَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، \\"" أَنَّ رَجُلًا مَاتَ، فَدَخَلَ الْجَنَّةَ، فَقِيلَ لَهُ: مَا كُنْتَ تَعْمَلُ؟ قَالَ: فَإِمَّا ذَكَرَ، وَإِمَّا ذُكِّرَ، فَقَالَ: إِنِّي كُنْتُ أُبَايِعُ النَّاسَ، فَكُنْتُ أُنْظِرُ الْمُعْسِرَ، وَأَتَجَوَّزُ فِي السِّكَّةِ، أَوْ فِي النَّقْدِ، فَغُفِرَ لَهُ \""\""، فَقَالَ أَبُو مَسْعُودٍ : وَأَنَا سَمِعْتُهُ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.nصحیح مسلم حدیث: 3995 عربی حدیث: 1560""","Sahih","Sahih Muslim 3995","","","6. باب: مفلس کو مہلت دینے کی اور قرض وصول کرنے میں آسانی کرنے کی فضیلت۔جس نے اپنا فروخت کیا ہوا ما ل خریدار کے پاس پایا اور وہ (خریدار )مفلس ہو چکا ہے تو اس چیز کو واپس لینے کا حق اسی کا ہےChapter: If a man finds what he sold with the purchaser, who has become bankrupt, then he has the right to take it back"
"3996","حَدَّثَنَا حَدَّثَنَا أَبُو سَعِيدٍ الْأَشَجُّ ، حَدَّثَنَا أَبُو خَالِدٍ الْأَحْمَرُ ، عَنْ سَعْدِ بْنِ طَارِقٍ ، عَنْ رِبْعِيِّ بْنِ حِرَاشٍ ، عَنْ حُذَيْفَةَ ، قَالَ: \\"" أُتِيَ اللَّهُ بِعَبْدٍ مِنْ عِبَادِهِ، آتَاهُ اللَّهُ مَالًا، فَقَالَ لَهُ: مَاذَا عَمِلْتَ فِي الدُّنْيَا؟ قَالَ: وَلَا يَكْتُمُونَ اللَّهَ حَدِيثًا، قَالَ: يَا رَبِّ، آتَيْتَنِي مَالَكَ، فَكُنْتُ أُبَايِعُ النَّاسَ وَكَانَ مِنْ خُلُقِي الْجَوَازُ، فَكُنْتُ أَتَيَسَّرُ عَلَى الْمُوسِرِ وَأُنْظِرُ الْمُعْسِرَ، فَقَالَ اللَّهُ: أَنَا أَحَقُّ بِذَا مِنْكَ، تَجَاوَزُوا عَنْ عَبْدِي \""\""، فَقَالَ عُقْبَةُ بْنُ عَامِرٍ الْجُهَنِيُّ ، وَأَبُو مَسْعُودٍ الْأَنْصَارِيُّ : هَكَذَا سَمِعْنَاهُ مِنْ فِي رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.nصحیح مسلم حدیث: 3996 عربی حدیث: 1560""","Sahih","Sahih Muslim 3996","","","6. باب: مفلس کو مہلت دینے کی اور قرض وصول کرنے میں آسانی کرنے کی فضیلت۔تنگ دست کو مہلت دینے ئاور خوشحال اور نادار (دونوں )سے تقاضے میں رعایت کی فضیلتChapter: The virute of giving more time to one who is suffering difficulty, and letting those go who are suffering difficulty and those who are well off"
"3997","حَدَّثَنَا حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، وَأَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، وَإِسْحَاق بْنُ إِبْرَاهِيمَ ، وَاللَّفْظُ لِيَحْيَى، قَالَ يَحْيَى: أَخْبَرَنَا، وَقَالَ الْآخَرُونَ: حَدَّثَنَا أَبُو مُعَاوِيَةَ ، عَنْ الْأَعْمَشِ ، عَنْ شَقِيقٍ ، عَنْ أَبِي مَسْعُودٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" حُوسِبَ رَجُلٌ مِمَّنْ كَانَ قَبْلَكُمْ، فَلَمْ يُوجَدْ لَهُ مِنَ الْخَيْرِ شَيْءٌ، إِلَّا أَنَّهُ كَانَ يُخَالِطُ النَّاسَ وَكَانَ مُوسِرًا، فَكَانَ يَأْمُرُ غِلْمَانَهُ أَنْ يَتَجَاوَزُوا عَنِ الْمُعْسِرِ، قَالَ: قَالَ اللَّهُ عَزَّ وَجَلَّ: نَحْنُ أَحَقُّ بِذَلِكَ مِنْهُ، تَجَاوَزُوا عَنْهُ \""\"".nصحیح مسلم حدیث: 3997 عربی حدیث: 1561""","Sahih","Sahih Muslim 3997","","","6. باب: مفلس کو مہلت دینے کی اور قرض وصول کرنے میں آسانی کرنے کی فضیلت۔تنگ دست کو مہلت دینے ئاور خوشحال اور نادار (دونوں )سے تقاضے میں رعایت کی فضیلتChapter: The virute of giving more time to one who is suffering difficulty, and letting those go who are suffering difficulty and those who are well off"
"3998","حَدَّثَنَا مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ، وَمُحَمَّدُ بْنُ جَعْفَرِ بْنِ زِيَادٍ ، قَالَ مَنْصُورٌ: حَدَّثَنَا إِبْرَاهِيمُ بْنُ سَعْدٍ ، عَنْ الزُّهْرِيِّ، قَالَ ابْنُ جَعْفَرٍ: أَخْبَرَنَا إِبْرَاهِيمُ وَهُوَ ابْنُ سَعْدٍ، عَنْ ابْنِ شِهَابٍ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، عَنْ أَبِي هُرَيْرَةَ : أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" كَانَ رَجُلٌ يُدَايِنُ النَّاسَ، فَكَانَ يَقُولُ لِفَتَاهُ: إِذَا أَتَيْتَ مُعْسِرًا، فَتَجَاوَزْ عَنْهُ لَعَلَّ اللَّهَ يَتَجَاوَزُ عَنَّا، فَلَقِيَ اللَّهَ فَتَجَاوَزَ عَنْهُ \""\"".nصحیح مسلم حدیث: 3998 عربی حدیث: 1562""","Sahih","Sahih Muslim 3998","","","6. باب: مفلس کو مہلت دینے کی اور قرض وصول کرنے میں آسانی کرنے کی فضیلت۔تنگ دست کو مہلت دینے ئاور خوشحال اور نادار (دونوں )سے تقاضے میں رعایت کی فضیلتChapter: The virute of giving more time to one who is suffering difficulty, and letting those go who are suffering difficulty and those who are well off"
"3999","حَدَّثَنِي حَرْمَلَةُ بْنُ يَحْيَى ، أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، أَنَّ عُبَيْدَ اللَّهِ بْنَ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، حَدَّثَهُ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ ، يَقُول: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ بِمِثْلِهِ.nصحیح مسلم حدیث: 3999 عربی حدیث: 1562","Sahih","Sahih Muslim 3999","","","6. باب: مفلس کو مہلت دینے کی اور قرض وصول کرنے میں آسانی کرنے کی فضیلت۔تنگ دست کو مہلت دینے ئاور خوشحال اور نادار (دونوں )سے تقاضے میں رعایت کی فضیلتChapter: The virute of giving more time to one who is suffering difficulty, and letting those go who are suffering difficulty and those who are well off"
"4000","حَدَّثَنَا أَبُو الْهَيْثَمِ خَالِدُ بْنُ خِدَاشِ بْنِ عَجْلَانَ ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ ، عَنْ أَيُّوبَ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي قَتَادَةَ ، أَنَّ أَبَا قَتَادَةَ : طَلَبَ غَرِيمًا لَهُ فَتَوَارَى عَنْهُ، ثُمَّ وَجَدَهُ، فَقَالَ: إِنِّي مُعْسِرٌ، فَقَالَ: آللَّهِ، قَالَ: آللَّهِ، قَالَ: فَإِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" مَنْ سَرَّهُ أَنْ يُنْجِيَهُ اللَّهُ مِنْ كُرَبِ يَوْمِ الْقِيَامَةِ، فَلْيُنَفِّسْ عَنْ مُعْسِرٍ، أَوْ يَضَعْ عَنْهُ \""\"".nصحیح مسلم حدیث: 4000 عربی حدیث: 1563""","Sahih","Sahih Muslim 4000","","","6. باب: مفلس کو مہلت دینے کی اور قرض وصول کرنے میں آسانی کرنے کی فضیلت۔تنگ دست کو مہلت دینے ئاور خوشحال اور نادار (دونوں )سے تقاضے میں رعایت کی فضیلتChapter: The virute of giving more time to one who is suffering difficulty, and letting those go who are suffering difficulty and those who are well off"
"4001","وحَدَّثَنِيهِ أَبُو الطَّاهِرِ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي جَرِيرُ بْنُ حَازِمٍ ، عَنْ أَيُّوبَ ، بِهَذَا الْإِسْنَادِ نَحْوَهُ.nصحیح مسلم حدیث: 4001 عربی حدیث: 1563","Sahih","Sahih Muslim 4001","","","6. باب: مفلس کو مہلت دینے کی اور قرض وصول کرنے میں آسانی کرنے کی فضیلت۔تنگ دست کو مہلت دینے ئاور خوشحال اور نادار (دونوں )سے تقاضے میں رعایت کی فضیلتChapter: The virute of giving more time to one who is suffering difficulty, and letting those go who are suffering difficulty and those who are well off"
"4002","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ أَبِي الزِّنَادِ ، عَنْ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ : أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" مَطْلُ الْغَنِيِّ ظُلْمٌ، وَإِذَا أُتْبِعَ أَحَدُكُمْ عَلَى مَلِيءٍ، فَلْيَتْبَعْ \""\""،nصحیح مسلم حدیث: 4002 عربی حدیث: 1564""","Sahih","Sahih Muslim 4002","","","7. باب: جو شخص مالدار ہو اس کو قرض ادا کرنے میں دیر کرنا حرام ہے اور جب قرض اتارا جائے مالدار پر تو اس کا قبول کر لینا مستحب ہے۔تنگ دست کو مہلت دینے ئاور خوشحال اور نادار (دونوں )سے تقاضے میں رعایت کی فضیلتChapter: The virute of giving more time to one who is suffering difficulty, and letting those go who are suffering difficulty and those who are well off"
"4003","حَدَّثَنَا إِسْحَاق بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا عِيسَى بْنُ يُونُسَ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ رَافِعٍ ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، قَالَا جَمِيعًا، حَدَّثَنَا مَعْمَرٌ ، عَنْ هَمَّامِ بْنِ مُنَبِّهٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ.nصحیح مسلم حدیث: 4003 عربی حدیث: 1564","Sahih","Sahih Muslim 4003","","","7. باب: جو شخص مالدار ہو اس کو قرض ادا کرنے میں دیر کرنا حرام ہے اور جب قرض اتارا جائے مالدار پر تو اس کا قبول کر لینا مستحب ہے۔تنگ دست کو مہلت دینے ئاور خوشحال اور نادار (دونوں )سے تقاضے میں رعایت کی فضیلتChapter: The virute of giving more time to one who is suffering difficulty, and letting those go who are suffering difficulty and those who are well off"
"4004","وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، أَخْبَرَنَا وَكِيعٌ . ح وحَدَّثَنِي مُحَمَّدُ بْنُ حَاتِمٍ ، حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ ، جَمِيعًا عَنْ ابْنِ جُرَيْجٍ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ: \\"" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ فَضْلِ الْمَاءِ \""\"".nصحیح مسلم حدیث: 4004 عربی حدیث: 1565""","Sahih","Sahih Muslim 4004","","","8. باب: جو پانی جنگل میں ضرورت سے زیادہ ہو اس کا بیچنا حرام ہے جب لوگوں کو اس کو احتیاج ہو گھاس چرانے میں اور اس کا روکنا منع ہے اور نر کدانے کی اجرت لینا منع ہے۔تنگ دست کو مہلت دینے ئاور خوشحال اور نادار (دونوں )سے تقاضے میں رعایت کی فضیلتChapter: The virute of giving more time to one who is suffering difficulty, and letting those go who are suffering difficulty and those who are well off"
"4005","وحَدَّثَنَا إِسْحَاق بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا رَوْحُ بْنُ عُبَادَةَ ، حَدَّثَنَا ابْنُ جُرَيْجٍ ، أَخْبَرَنِي أَبُو الزُّبَيْرِ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: \\"" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ ضِرَابِ الْجَمَلِ، وَعَنْ بَيْعِ الْمَاءِ، وَالْأَرْضِ لِتُحْرَثَ \""\""، فَعَنْ ذَلِكَ نَهَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.nصحیح مسلم حدیث: 4005 عربی حدیث: 1565""","Sahih","Sahih Muslim 4005","","","8. باب: جو پانی جنگل میں ضرورت سے زیادہ ہو اس کا بیچنا حرام ہے جب لوگوں کو اس کو احتیاج ہو گھاس چرانے میں اور اس کا روکنا منع ہے اور نر کدانے کی اجرت لینا منع ہے۔مالدار کا ٹال مٹول کرنا حرام ہے ‘ِحوالہ (مقروض کی طرف سے اپنے ذمے قرض کو دوسرے کے ذمے )کرنا درست ہے جب (قرض )کسی (مالدار شخص )کے حوالے کیا جائے تو اسے قبول کرنا مستحب ہےChapter: The prohibition of a rich man delaying repayment. The validity of Hawalah (Transferal of Debts) and it is recommended to accept transferal of a debt if it is transferred to a rich man"
"4006","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ . ح وحَدَّثَنَا قُتَيْبَةُ ، حَدَّثَنَا لَيْثٌ ، كِلَاهُمَا عَنْ أَبِي الزِّنَادِ ، عَنْ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لَا يُمْنَعُ فَضْلُ الْمَاءِ لِيُمْنَعَ بِهِ الْكَلَأُ \""\"".nصحیح مسلم حدیث: 4006 عربی حدیث: 1566""","Sahih","Sahih Muslim 4006","","","8. باب: جو پانی جنگل میں ضرورت سے زیادہ ہو اس کا بیچنا حرام ہے جب لوگوں کو اس کو احتیاج ہو گھاس چرانے میں اور اس کا روکنا منع ہے اور نر کدانے کی اجرت لینا منع ہے۔ایسا زائد پانی بیچنا حرام ہے جو بیابان میں ہو اور گھاس چرانے کے لیے اس کی ضرورت ہو‘اسے استعمال کرنے سے روکنا (بھی)حرام ہے ‘اور نرکی جفتی کی اجرت لینا حرام ہےChapter: The prohibition of selling surplus water which is in the wilderness and is needed to take care of the pasture. The prohibition of not allowing others to use it. The prohibition of Stud fees"
"4007","وحَدَّثَنِي أَبُو الطَّاهِرِ ، وَحَرْمَلَةُ ، وَاللَّفْظُ لِحَرْمَلَةَ: أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، حَدَّثَنِي سَعِيدُ بْنُ الْمُسَيِّبِ ، وَأَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ ، أن أبا هريرة ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" لَا تَمْنَعُوا فَضْلَ الْمَاءِ لِتَمْنَعُوا بِهِ الْكَلَأَ \""\"".nصحیح مسلم حدیث: 4007 عربی حدیث: 1566""","Sahih","Sahih Muslim 4007","","","8. باب: جو پانی جنگل میں ضرورت سے زیادہ ہو اس کا بیچنا حرام ہے جب لوگوں کو اس کو احتیاج ہو گھاس چرانے میں اور اس کا روکنا منع ہے اور نر کدانے کی اجرت لینا منع ہے۔ایسا زائد پانی بیچنا حرام ہے جو بیابان میں ہو اور گھاس چرانے کے لیے اس کی ضرورت ہو‘اسے استعمال کرنے سے روکنا (بھی)حرام ہے ‘اور نرکی جفتی کی اجرت لینا حرام ہےChapter: The prohibition of selling surplus water which is in the wilderness and is needed to take care of the pasture. The prohibition of not allowing others to use it. The prohibition of Stud fees"
"4008","وحَدَّثَنَا أَحْمَدُ بْنُ عُثْمَانَ النَّوْفَلِيُّ ، حَدَّثَنَا أَبُو عَاصِمٍ الضَّحَّاكُ بْنُ مَخْلَدٍ ، حَدَّثَنَا ابْنُ جُرَيْجٍ ، أَخْبَرَنِي زِيَادُ بْنُ سَعْدٍ ، أَنَّ هِلَالَ بْنَ أُسَامَةَ ، أَخْبَرَهُ: أَنَّ أَبَا سَلَمَةَ بْنَ عَبْدِ الرَّحْمَنِ ، أَخْبَرَهُ: أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" لَا يُبَاعُ فَضْلُ الْمَاءِ لِيُبَاعَ بِهِ الْكَلَأُ \""\"".nصحیح مسلم حدیث: 4008 عربی حدیث: 1566""","Sahih","Sahih Muslim 4008","","","8. باب: جو پانی جنگل میں ضرورت سے زیادہ ہو اس کا بیچنا حرام ہے جب لوگوں کو اس کو احتیاج ہو گھاس چرانے میں اور اس کا روکنا منع ہے اور نر کدانے کی اجرت لینا منع ہے۔ایسا زائد پانی بیچنا حرام ہے جو بیابان میں ہو اور گھاس چرانے کے لیے اس کی ضرورت ہو‘اسے استعمال کرنے سے روکنا (بھی)حرام ہے ‘اور نرکی جفتی کی اجرت لینا حرام ہےChapter: The prohibition of selling surplus water which is in the wilderness and is needed to take care of the pasture. The prohibition of not allowing others to use it. The prohibition of Stud fees"
"4009","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ ابْنِ شِهَابٍ ، عَنْ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي مَسْعُودٍ الْأَنْصَارِيِّ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" نَهَى عَنْ: ثَمَنِ الْكَلْبِ، وَمَهْرِ الْبَغِيِّ، وَحُلْوَانِ الْكَاهِنِ \""\"".nصحیح مسلم حدیث: 4009 عربی حدیث: 1567""","Sahih","Sahih Muslim 4009","","","9. باب: کتے کی قیمت اور نجومی کی مٹھائی اور رنڈی کی خرچی اور بلی کی بیع حرام ہے۔ایسا زائد پانی بیچنا حرام ہے جو بیابان میں ہو اور گھاس چرانے کے لیے اس کی ضرورت ہو‘اسے استعمال کرنے سے روکنا (بھی)حرام ہے ‘اور نرکی جفتی کی اجرت لینا حرام ہےChapter: The prohibition of selling surplus water which is in the wilderness and is needed to take care of the pasture. The prohibition of not allowing others to use it. The prohibition of Stud fees"
"4010","وحَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، وَمُحَمَّدُ بْنُ رُمْحٍ ، عَنْ اللَّيْثِ بْنِ سَعْدٍ . ح وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، كِلَاهُمَا عَنْ الزُّهْرِيِّ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ، وَفِي حَدِيثِ اللَّيْثِ مِنْ رِوَايَةِ ابْنِ رُمْحٍ: أَنَّهُ سَمِعَ أَبَا مَسْعُودٍ.nصحیح مسلم حدیث: 4010 عربی حدیث: 1567","Sahih","Sahih Muslim 4010","","","9. باب: کتے کی قیمت اور نجومی کی مٹھائی اور رنڈی کی خرچی اور بلی کی بیع حرام ہے۔ایسا زائد پانی بیچنا حرام ہے جو بیابان میں ہو اور گھاس چرانے کے لیے اس کی ضرورت ہو‘اسے استعمال کرنے سے روکنا (بھی)حرام ہے ‘اور نرکی جفتی کی اجرت لینا حرام ہےChapter: The prohibition of selling surplus water which is in the wilderness and is needed to take care of the pasture. The prohibition of not allowing others to use it. The prohibition of Stud fees"
"4011","وحَدَّثَنِي مُحَمَّدُ بْنُ حَاتِمٍ ، حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ الْقَطَّانُ ، عَنْ مُحَمَّدِ بْنِ يُوسُفَ ، قَالَ: سَمِعْتُ السَّائِبَ بْنَ يَزِيدَ ، يُحَدِّثُ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، قَالَ: سَمِعْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" شَرُّ الْكَسْبِ: مَهْرُ الْبَغِيِّ، وَثَمَنُ الْكَلْبِ، وَكَسْبُ الْحَجَّامِ \""\"".nصحیح مسلم حدیث: 4011 عربی حدیث: 1568""","Sahih","Sahih Muslim 4011","","","9. باب: کتے کی قیمت اور نجومی کی مٹھائی اور رنڈی کی خرچی اور بلی کی بیع حرام ہے۔ایسا زائد پانی بیچنا حرام ہے جو بیابان میں ہو اور گھاس چرانے کے لیے اس کی ضرورت ہو‘اسے استعمال کرنے سے روکنا (بھی)حرام ہے ‘اور نرکی جفتی کی اجرت لینا حرام ہےChapter: The prohibition of selling surplus water which is in the wilderness and is needed to take care of the pasture. The prohibition of not allowing others to use it. The prohibition of Stud fees"
"4012","حَدَّثَنَا إِسْحَاق بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا الْوَلِيدُ بْنُ مُسْلِمٍ ، عَنْ الْأَوْزَاعِيِّ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، حَدَّثَنِي إِبْرَاهِيمُ بْنُ قَارِظٍ ، عَنْ السَّائِبِ بْنِ يَزِيدَ ، حَدَّثَنِي رَافِعُ بْنُ خَدِيجٍ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" ثَمَنُ الْكَلْبِ خَبِيثٌ، وَمَهْرُ الْبَغِيِّ خَبِيثٌ، وَكَسْبُ الْحَجَّامِ خَبِيثٌ \""\""،nصحیح مسلم حدیث: 4012 عربی حدیث: 1568""","Sahih","Sahih Muslim 4012","","","9. باب: کتے کی قیمت اور نجومی کی مٹھائی اور رنڈی کی خرچی اور بلی کی بیع حرام ہے۔کتے کی قیمت ‘کاہن کا نذرانہ اور زانیہ کا معاوضہ حرام ہے اور بلّے کی بیع (بھی )ممنوع ہےChapter: The prohibition of the price of a dog, the fee of a fortuneteller and the payment of a prostitute, and the prohibition of selling cats"
"4013","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ.nصحیح مسلم حدیث: 4013 عربی حدیث: 1568","Sahih","Sahih Muslim 4013","","","9. باب: کتے کی قیمت اور نجومی کی مٹھائی اور رنڈی کی خرچی اور بلی کی بیع حرام ہے۔کتے کی قیمت ‘کاہن کا نذرانہ اور زانیہ کا معاوضہ حرام ہے اور بلّے کی بیع (بھی )ممنوع ہےChapter: The prohibition of the price of a dog, the fee of a fortuneteller and the payment of a prostitute, and the prohibition of selling cats"
"4014","وحَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا النَّضْرُ بْنُ شُمَيْلٍ ، حَدَّثَنَا هِشَامٌ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، حَدَّثَنِي إِبْرَاهِيمُ بْنُ عَبْدِ اللَّهِ ، عَنْ السَّائِبِ بْنِ يَزِيدَ ، حَدَّثَنَا رَافِعُ بْنُ خَدِيجٍ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ.nصحیح مسلم حدیث: 4014 عربی حدیث: 1568","Sahih","Sahih Muslim 4014","","","9. باب: کتے کی قیمت اور نجومی کی مٹھائی اور رنڈی کی خرچی اور بلی کی بیع حرام ہے۔کتے کی قیمت ‘کاہن کا نذرانہ اور زانیہ کا معاوضہ حرام ہے اور بلّے کی بیع (بھی )ممنوع ہےChapter: The prohibition of the price of a dog, the fee of a fortuneteller and the payment of a prostitute, and the prohibition of selling cats"
"4015","حَدَّثَنِي سَلَمَةُ بْنُ شَبِيبٍ ، حَدَّثَنَا الْحَسَنُ بْنُ أَعْيَنَ ، حَدَّثَنَا مَعْقِلٌ ، عَنْ أَبِي الزُّبَيْرِ ، قَالَ: سَأَلْتُ جَابِرًا :\\"" عَنْ ثَمَنِ الْكَلْبِ وَالسِّنَّوْرِ؟ قَالَ: زَجَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ\""\"".nصحیح مسلم حدیث: 4015 عربی حدیث: 1569""","Sahih","Sahih Muslim 4015","","","9. باب: کتے کی قیمت اور نجومی کی مٹھائی اور رنڈی کی خرچی اور بلی کی بیع حرام ہے۔کتے کی قیمت ‘کاہن کا نذرانہ اور زانیہ کا معاوضہ حرام ہے اور بلّے کی بیع (بھی )ممنوع ہےChapter: The prohibition of the price of a dog, the fee of a fortuneteller and the payment of a prostitute, and the prohibition of selling cats"
"4016","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" أَمَرَ بِقَتْلِ الْكِلَابِ \""\"".nصحیح مسلم حدیث: 4016 عربی حدیث: 1570""","Sahih","Sahih Muslim 4016","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتے کی قیمت ‘کاہن کا نذرانہ اور زانیہ کا معاوضہ حرام ہے اور بلّے کی بیع (بھی )ممنوع ہےChapter: The prohibition of the price of a dog, the fee of a fortuneteller and the payment of a prostitute, and the prohibition of selling cats"
"4017","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا أَبُو أُسَامَةَ ، حَدَّثَنَا عُبَيْدُ اللَّهِ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، قَالَ: \\"" أَمَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِقَتْلِ الْكِلَابِ \""\""، فَأَرْسَلَ فِي أَقْطَارِ الْمَدِينَةِ: أَنْ تُقْتَلَ.nصحیح مسلم حدیث: 4017 عربی حدیث: 1570""","Sahih","Sahih Muslim 4017","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتے کی قیمت ‘کاہن کا نذرانہ اور زانیہ کا معاوضہ حرام ہے اور بلّے کی بیع (بھی )ممنوع ہےChapter: The prohibition of the price of a dog, the fee of a fortuneteller and the payment of a prostitute, and the prohibition of selling cats"
"4018","وحَدَّثَنِي حُمَيْدُ بْنُ مَسْعَدَةَ ، حَدَّثَنَا بِشْرٌ يَعْنِي ابْنَ الْمُفَضَّلِ ، حَدَّثَنَا إِسْمَاعِيل وَهُوَ ابْنُ أُمَيَّةَ ، عَنْ نَافِعٍ ، عَنْ عَبْدِ اللَّهِ ، قَالَ: كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" يَأْمُرُ بِقَتْلِ الْكِلَابِ \""\""، فَنَنْبَعِثُ فِي الْمَدِينَةِ، وَأَطْرَافِهَا، فَلَا نَدَعُ كَلْبًا، إِلَّا قَتَلْنَاهُ، حَتَّى إِنَّا لَنَقْتُلُ كَلْبَ الْمُرَيَّةِ مِنْ أَهْلِ الْبَادِيَةِ يَتْبَعُهَا.nصحیح مسلم حدیث: 4018 عربی حدیث: 1570""","Sahih","Sahih Muslim 4018","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتے کی قیمت ‘کاہن کا نذرانہ اور زانیہ کا معاوضہ حرام ہے اور بلّے کی بیع (بھی )ممنوع ہےChapter: The prohibition of the price of a dog, the fee of a fortuneteller and the payment of a prostitute, and the prohibition of selling cats"
"4019","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، أَخْبَرَنَا حَمَّادُ بْنُ زَيْدٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ ابْنِ عُمَرَ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" أَمَرَ بِقَتْلِ الْكِلَابِ، إِلَّا كَلْبَ صَيْدٍ، أَوْ كَلْبَ غَنَمٍ، أَوْ مَاشِيَةٍ \""\""، فَقِيلَ لِابْنِ عُمَرَ: إِنَّ أَبَا هُرَيْرَةَ، يَقُولُ: أَوْ كَلْبَ زَرْعٍ، فَقَالَ ابْنُ عُمَرَ: إِنَّ لِأَبِي هُرَيْرَةَ زَرْعًا.nصحیح مسلم حدیث: 4019 عربی حدیث: 1571""","Sahih","Sahih Muslim 4019","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4020","حَدَّثَنَا مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَلَفٍ ، حَدَّثَنَا رَوْحٌ . ح وحَدَّثَنِي إِسْحَاقُ بْنُ مَنْصُورٍ ، أَخْبَرَنَا رَوْحُ بْنُ عُبَادَةَ ، حَدَّثَنَا ابْنُ جُرَيْجٍ ، أَخْبَرَنِي أَبُو الزُّبَيْرِ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: \\"" أَمَرَنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِقَتْلِ الْكِلَابِ، حَتَّى إِنَّ الْمَرْأَةَ تَقْدَمُ مِنَ الْبَادِيَةِ بِكَلْبِهَا فَنَقْتُلُهُ، ثُمَّ نَهَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ قَتْلِهَا \""\""، وَقَالَ: \""\"" عَلَيْكُمْ بِالْأَسْوَدِ الْبَهِيمِ ذِي النُّقْطَتَيْنِ، فَإِنَّهُ شَيْطَانٌ \""\"".nصحیح مسلم حدیث: 4020 عربی حدیث: 1572""","Sahih","Sahih Muslim 4020","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4021","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا شُعْبَةُ ، عَنْ أَبِي التَّيَّاحِ ، سَمِعَ مُطَرِّفَ بْنَ عَبْدِ اللَّهِ ، عَنْ ابْنِ الْمُغَفَّلِ ، قَالَ: \\"" أَمَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِقَتْلِ الْكِلَابِ \""\""، ثُمَّ قَالَ: \""\"" مَا بَالُهُمْ وَبَالُ الْكِلَابِ \""\""، ثُمَّ \""\"" رَخَّصَ فِي كَلْبِ الصَّيْدِ، وَكَلْبِ الْغَنَمِ \""\"".nصحیح مسلم حدیث: 4021 عربی حدیث: 1573""","Sahih","Sahih Muslim 4021","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4022","وحَدَّثَنِيهِ يَحْيَى بْنُ حَبِيبٍ ، حَدَّثَنَا خَالِدٌ يَعْنِي ابْنَ الْحَارِثِ . ح وحَدَّثَنِي مُحَمَّدُ بْنُ حَاتِمٍ ، حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ . ح وحَدَّثَنِي مُحَمَّدُ بْنُ الْوَلِيدِ ، حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ . ح وحَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا النَّضْرُ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا وَهْبُ بْنُ جَرِيرٍ ، كُلُّهُمْ عَنْ شُعْبَةَ ، بِهَذَا الْإِسْنَادِ، وقَالَ ابْنُ حَاتِمٍ فِي حَدِيثِهِ، عَنْ يَحْيَى: وَرَخَّصَ فِي كَلْبِ الْغَنَمِ، وَالصَّيْدِ، وَالزَّرْعِ.nصحیح مسلم حدیث: 4022 عربی حدیث: 1573","Sahih","Sahih Muslim 4022","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4023","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنِ اقْتَنَى كَلْبًا، إِلَّا كَلْبَ مَاشِيَةٍ، أَوْ ضَارِي، نَقَصَ مِنْ عَمَلِهِ كُلَّ يَوْمٍ قِيرَاطَانِ \""\"".nصحیح مسلم حدیث: 4023 عربی حدیث: 1574""","Sahih","Sahih Muslim 4023","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4024","وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَزُهَيْرُ بْنُ حَرْبٍ ، وَابْنُ نُمَيْرٍ ، قَالُوا: حَدَّثَنَا سُفْيَانُ ، عَنْ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنْ أَبِيهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" مَنِ اقْتَنَى كَلْبًا، إِلَّا كَلْبَ صَيْدٍ، أَوْ مَاشِيَةٍ، نَقَصَ مِنْ أَجْرِهِ كُلَّ يَوْمٍ قِيرَاطَانِ \""\"".nصحیح مسلم حدیث: 4024 عربی حدیث: 1574""","Sahih","Sahih Muslim 4024","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4025","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، وَيَحْيَى بْنُ أَيُّوبَ ، وَقُتَيْبَةُ ، وَابْنُ حُجْرٍ ، قَالَ يَحْيَى بْنُ يَحْيَى: أَخْبَرَنَا، وَقَالَ الْآخَرُونَ: حَدَّثَنَا إِسْمَاعِيلُ وَهُوَ ابْنُ جَعْفَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، أَنَّهُ سَمِعَ ابْنَ عُمَرَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنِ اقْتَنَى كَلْبًا، إِلَّا كَلْبَ ضَارِيَةٍ، أَوْ مَاشِيَةٍ، نَقَصَ مِنْ عَمَلِهِ كُلَّ يَوْمٍ قِيرَاطَانِ \""\"".nصحیح مسلم حدیث: 4025 عربی حدیث: 1574""","Sahih","Sahih Muslim 4025","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4026","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، وَيَحْيَى بْنُ أَيُّوبَ ، وَقُتَيْبَةُ ، وَابْنُ حُجْرٍ ، قَالَ يَحْيَى: أَخْبَرَنَا، وَقَالَ الْآخَرُونَ: حَدَّثَنَا إِسْمَاعِيلُ ، عَنْ مُحَمَّدٍ وَهُوَ ابْنُ أَبِي حَرْمَلَةَ ، عَنْ سَالِمِ بْنِ عَبْدِ اللَّهِ ، عَنْ أَبِيهِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" مَنِ اقْتَنَى كَلْبًا، إِلَّا كَلْبَ مَاشِيَةٍ، أَوْ كَلْبَ صَيْدٍ، نَقَصَ مِنْ عَمَلِهِ كُلَّ يَوْمٍ قِيرَاطٌ \""\""، قَالَ عَبْدُ اللَّهِ ، وَقَالَ أَبُو هُرَيْرَةَ : أَوْ كَلْبَ حَرْثٍ.nصحیح مسلم حدیث: 4026 عربی حدیث: 1574""","Sahih","Sahih Muslim 4026","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4027","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا وَكِيعٌ ، حَدَّثَنَا حَنْظَلَةُ بْنُ أَبِي سُفْيَانَ ، عَنْ سَالِمٍ ، عَنْ أَبِيهِ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" مَنِ اقْتَنَى كَلْبًا، إِلَّا كَلْبَ ضَارٍ، أَوْ مَاشِيَةٍ، نَقَصَ مِنْ عَمَلِهِ كُلَّ يَوْمٍ قِيرَاطَانِ \""\""، قَالَ سَالِمٌ: وَكَانَ أَبُو هُرَيْرَةَ ، يَقُولُ: أَوْ كَلْبَ حَرْثٍ، وَكَانَ صَاحِبَ حَرْثٍ.nصحیح مسلم حدیث: 4027 عربی حدیث: 1574""","Sahih","Sahih Muslim 4027","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4028","حَدَّثَنَا دَاوُدُ بْنُ رُشَيْدٍ ، حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِيَةَ ، أَخْبَرَنَا عُمَرُ بْنُ حَمْزَةَ بْنِ عَبْدِ اللَّهِ بْنِ عُمَرَ ، حَدَّثَنَا سَالِمُ بْنُ عَبْدِ اللَّهِ ، عَنْ أَبِيهِ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" أَيُّمَا أَهْلِ دَارٍ اتَّخَذُوا كَلْبًا، إِلَّا كَلْبَ مَاشِيَةٍ، أَوْ كَلْبَ صَائِدٍ، نَقَصَ مِنْ عَمَلِهِمْ كُلَّ يَوْمٍ قِيرَاطَانِ \""\"".nصحیح مسلم حدیث: 4028 عربی حدیث: 1574""","Sahih","Sahih Muslim 4028","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4029","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، وَاللَّفْظُ لِابْنِ الْمُثَنَّى، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، عَنْ قَتَادَةَ ، عَنْ أَبِي الْحَكَمِ ، قَالَ: سَمِعْتُ ابْنَ عُمَرَ ، يُحَدِّثُ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" مَنِ اتَّخَذَ كَلْبًا، إِلَّا كَلْبَ زَرْعٍ، أَوْ غَنَمٍ، أَوْ صَيْدٍ، يَنْقُصُ مِنْ أَجْرِهِ كُلَّ يَوْمٍ قِيرَاطٌ \""\"".nصحیح مسلم حدیث: 4029 عربی حدیث: 1574""","Sahih","Sahih Muslim 4029","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4030","وحَدَّثَنِي أَبُو الطَّاهِرِ ، وَحَرْمَلَةُ ، قَالَا: أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" مَنِ اقْتَنَى كَلْبًا لَيْسَ بِكَلْبِ صَيْدٍ، وَلَا مَاشِيَةٍ، وَلَا أَرْضٍ، فَإِنَّهُ يَنْقُصُ مِنْ أَجْرِهِ قِيرَاطَانِ كُلَّ يَوْمٍ \""\"". وَلَيْسَ فِي حَدِيثِ أَبِي الطَّاهِرِ: وَلَا أَرْضٍ.nصحیح مسلم حدیث: 4030 عربی حدیث: 1575""","Sahih","Sahih Muslim 4030","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4031","حَدَّثَنَا عَبْدُ بْنُ حُمَيْدٍ ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ الزُّهْرِيِّ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنِ اتَّخَذَ كَلْبًا، إِلَّا كَلْبَ مَاشِيَةٍ، أَوْ صَيْدٍ، أَوْ زَرْعٍ، انْتَقَصَ مِنْ أَجْرِهِ كُلَّ يَوْمٍ قِيرَاطٌ \""\"". قَالَ الزُّهْرِيُّ: فَذُكِرَ لِابْنِ عُمَرَ، قَوْلُ أَبِي هُرَيْرَةَ، فَقَالَ: يَرْحَمُ اللَّهُ أَبَا هُرَيْرَةَ كَانَ صَاحِبَ زَرْعٍ.nصحیح مسلم حدیث: 4031 عربی حدیث: 1575""","Sahih","Sahih Muslim 4031","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4032","حَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، حَدَّثَنَا هِشَامٌ الدَّسْتَوَائِيُّ ، حَدَّثَنَا يَحْيَى بْنُ أَبِي كَثِيرٍ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنْ أَمْسَكَ كَلْبًا، فَإِنَّهُ يَنْقُصُ مِنْ عَمَلِهِ كُلَّ يَوْمٍ قِيرَاطٌ، إِلَّا كَلْبَ حَرْثٍ، أَوْ مَاشِيَةٍ \""\""،nصحیح مسلم حدیث: 4032 عربی حدیث: 1575""","Sahih","Sahih Muslim 4032","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4033","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا شُعَيْبُ بْنُ إِسْحَاقَ ، حَدَّثَنَا الْأَوْزَاعِيُّ ، حَدَّثَنِي يَحْيَى بْنُ أَبِي كَثِيرٍ ، حَدَّثَنِي أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ ، حَدَّثَنِي أَبُو هُرَيْرَةَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ،nصحیح مسلم حدیث: 4033 عربی حدیث: 1575","Sahih","Sahih Muslim 4033","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4034","حَدَّثَنَا أَحْمَدُ بْنُ الْمُنْذِرِ ، حَدَّثَنَا عَبْدُ الصَّمَدِ ، حَدَّثَنَا حَرْبٌ ، حَدَّثَنَا يَحْيَى بْنُ أَبِي كَثِيرٍ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ.nصحیح مسلم حدیث: 4034 عربی حدیث: 1575","Sahih","Sahih Muslim 4034","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4035","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا عَبْدُ الْوَاحِدِ يَعْنِي ابْنَ زِيَادٍ ، عَنْ إِسْمَاعِيلَ بْنِ سُمَيْعٍ ، حَدَّثَنَا أَبُو رَزِينٍ ، قَالَ: سَمِعْتُ أَبَا هُرَيْرَةَ ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنِ اتَّخَذَ كَلْبًا، لَيْسَ بِكَلْبِ صَيْدٍ، وَلَا غَنَمٍ، نَقَصَ مِنْ عَمَلِهِ كُلَّ يَوْمٍ قِيرَاطٌ \""\"".nصحیح مسلم حدیث: 4035 عربی حدیث: 1575""","Sahih","Sahih Muslim 4035","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4036","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ يَزِيدَ بْنِ خُصَيْفَةَ ، أَنَّ السَّائِبَ بْنَ يَزِيدَ ، أَخْبَرَهُ، أَنَّهُ سَمِعَ سُفْيَانَ بْنَ أَبِي زُهَيْرٍ وَهُوَ رَجُلٌ مِنْ شَنُوءَةَ مِنْ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" مَنِ اقْتَنَى كَلْبًا لَا يُغْنِي عَنْهُ زَرْعًا، وَلَا ضَرْعًا، نَقَصَ مِنْ عَمَلِهِ كُلَّ يَوْمٍ قِيرَاطٌ \""\""، قَالَ: آنْتَ سَمِعْتَ هَذَا مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ؟ قَالَ: إِي وَرَبِّ هَذَا الْمَسْجِدِ.nصحیح مسلم حدیث: 4036 عربی حدیث: 1576""","Sahih","Sahih Muslim 4036","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4037","حَدَّثَنَا يَحْيَى بْنُ أَيُّوبَ ، وَقُتَيْبَةُ ، وَابْنُ حُجْرٍ ، قَالُوا: حَدَّثَنَا إِسْمَاعِيلُ ، عَنْ يَزِيدَ بْنِ خُصَيْفَةَ ، أَخْبَرَنِي السَّائِبُ بْنُ يَزِيدَ ، أَنَّهُ وَفَدَ عَلَيْهِمْ سُفْيَانُ بْنُ أَبِي زُهَيْرٍ الشَّنَئِيُّ ، فَقَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ.nصحیح مسلم حدیث: 4037 عربی حدیث: 1576","Sahih","Sahih Muslim 4037","","","10. باب: کتوں کے قتل کا حکم پھر اس حکم کا منسوخ ہونا اور اس امر کا بیان کہ کتے کا پالنا حرام ہے مگر شکار یا کھیتی یا جانوروں کی حفاظت کے لیے یا ایسے ہی اور کسی کام کے واسطے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4038","حَدَّثَنَا يَحْيَى بْنُ أَيُّوبَ ، وَقُتَيْبَةُ بْنُ سَعِيدٍ ، وَعَلِيُّ بْنُ حُجْرٍ ، قَالُوا: حَدَّثَنَا إِسْمَاعِيلُ يَعْنُونَ ابْنَ جَعْفَرٍ ، عَنْ حُمَيْدٍ ، قَالَ: سُئِلَ أَنَسُ بْنُ مَالِكٍ : عَنْ كَسْبِ الْحَجَّامِ، فَقَالَ: \\"" احْتَجَمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَجَمَهُ أَبُو طَيْبَةَ، فَأَمَرَ لَهُ بِصَاعَيْنِ مِنْ طَعَامٍ وَكَلَّمَ أَهْلَهُ، فَوَضَعُوا عَنْهُ مِنْ خَرَاجِهِ، وَقَالَ: إِنَّ أَفْضَلَ مَا تَدَاوَيْتُمْ بِهِ الْحِجَامَةُ أَوْ هُوَ مِنْ أَمْثَلِ دَوَائِكُمْ \""\"".nصحیح مسلم حدیث: 4038 عربی حدیث: 1577""","Sahih","Sahih Muslim 4038","","","11. باب: پچھنے لگانے کی اجرت حلال ہے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4039","حَدَّثَنَا ابْنُ أَبِي عُمَرَ ، حَدَّثَنَا مَرْوَانُ يَعْنِي الْفَزَارِيَّ ، عَنْ حُمَيْدٍ ، قَالَ: سُئِلَ أَنَسٌ ، عَنْ كَسْبِ الْحَجَّامِ، فَذَكَرَ بِمِثْلِهِ، غَيْرَ أَنَّهُ قَالَ: إِنَّ أَفْضَلَ مَا تَدَاوَيْتُمْ بِهِ الْحِجَامَةُ، وَالْقُسْطُ الْبَحْرِيُّ، وَلَا تُعَذِّبُوا صِبْيَانَكُمْ بِالْغَمْزِ.nصحیح مسلم حدیث: 4039 عربی حدیث: 1577","Sahih","Sahih Muslim 4039","","","11. باب: پچھنے لگانے کی اجرت حلال ہے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4040","حَدَّثَنَا أَحْمَدُ بْنُ الْحَسَنِ بْنِ خِرَاشٍ ، حَدَّثَنَا شَبَابَةُ ، حَدَّثَنَا شُعْبَةُ ، عَنْ حُمَيْدٍ ، قَالَ: سَمِعْتُ أَنَسًا ، يَقُولُ: \\"" دَعَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ غُلَامًا لَنَا حَجَّامًا، فَحَجَمَهُ، فَأَمَرَ لَهُ بِصَاعٍ أَوْ مُدٍّ أَوْ مُدَّيْنِ وَكَلَّمَ فِيهِ، فَخُفِّفَ عَنْ ضَرِيبَتِهِ \""\"".nصحیح مسلم حدیث: 4040 عربی حدیث: 1577""","Sahih","Sahih Muslim 4040","","","11. باب: پچھنے لگانے کی اجرت حلال ہے۔کتوں کو مارڈالنے کا حکم (پھر )اس کے منسوخ ہونے کی وضاحت اور اس بات کی وضاحت کہ شکار کےلیے اور کھیتی یا جانور وں کی حفاظت اور اسی طرح کے کسی کام کے سوا انھیں پالنا حرام ہےChapter: The command to kill dogs, and its abrogation. The prohibition of keeping dogs, except for hunting, farming, (herding) livestock and the like"
"4041","وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ . ح وحَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا الْمَخْزُومِيُّ ، كِلَاهُمَا عَنْ وُهَيْبٍ ، حَدَّثَنَا ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ ، عَنْ ابْنِ عَبَّاسٍ : أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \\"" احْتَجَمَ، وَأَعْطَى الْحَجَّامَ أَجْرَهُ، وَاسْتَعَطَ \""\"".nصحیح مسلم حدیث: 4041 عربی حدیث: 1202""","Sahih","Sahih Muslim 4041","","","11. باب: پچھنے لگانے کی اجرت حلال ہے۔پچھنے لگانے کی اجرت کا جوازChapter: The permissibility of a cupper's earnings"
"4042","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، وَعَبْدُ بْنُ حميد ، واللفظ لعبد، قَالَا: أَخْبَرَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ عَاصِمٍ ، عَنْ الشَّعْبِيِّ ، عَنْ ابْنِ عَبَّاسٍ ، قَالَ: \\"" حَجَمَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَبْدٌ لِبَنِي بَيَاضَةَ، فَأَعْطَاهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَجْرَهُ، وَكَلَّمَ سَيِّدَهُ، فَخَفَّفَ عَنْهُ مِنْ ضَرِيبَتِهِ وَلَوْ كَانَ سُحْتًا، لَمْ يُعْطِهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \""\"".nصحیح مسلم حدیث: 4042 عربی حدیث: 1202""","Sahih","Sahih Muslim 4042","","","11. باب: پچھنے لگانے کی اجرت حلال ہے۔پچھنے لگانے کی اجرت کا جوازChapter: The permissibility of a cupper's earnings"
"4043","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ، حَدَّثَنَا عَبْدُ الْأَعْلَى بْنُ عَبْدِ الْأَعْلَى أَبُو هَمَّامٍ ، حَدَّثَنَا سَعِيدٌ الْجُرَيْرِيُّ ، عَنْ أَبِي نَضْرَةَ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ بِالْمَدِينَةِ قَالَ: \\"" يَا أَيُّهَا النَّاسُ إِنَّ اللَّهَ تَعَالَى يُعَرِّضُ بِالْخَمْرِ وَلَعَلَّ اللَّهَ سَيُنْزِلُ فِيهَا أَمْرًا، فَمَنْ كَانَ عِنْدَهُ مِنْهَا شَيْءٌ فَلْيَبِعْهُ وَلْيَنْتَفِعْ بِهِ، قَالَ: فَمَا لَبِثْنَا إِلَّا يَسِيرًا حَتَّى، قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: إِنَّ اللَّهَ تَعَالَى حَرَّمَ الْخَمْرَ، فَمَنْ أَدْرَكَتْهُ هَذِهِ الْآيَةُ وَعِنْدَهُ مِنْهَا شَيْءٌ، فَلَا يَشْرَبْ وَلَا يَبِعْ \""\"". قَالَ: فَاسْتَقْبَلَ النَّاسُ بِمَا كَانَ عِنْدَهُ مِنْهَا فِي طَرِيقِ الْمَدِينَةِ، فَسَفَكُوهَا.nصحیح مسلم حدیث: 4043 عربی حدیث: 1578""","Sahih","Sahih Muslim 4043","","","12. باب: شراب بیچنا حرام ہے۔پچھنے لگانے کی اجرت کا جوازChapter: The permissibility of a cupper's earnings"
"4044","حَدَّثَنَا سُوَيْدُ بْنُ سَعِيدٍ ، حَدَّثَنَا حَفْصُ بْنُ مَيْسَرَةَ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ وَعْلَةَ رَجُلٌ مِنْ أَهْلِ مِصْرَ، أَنَّهُ جَاءَ عَبْدَ اللَّهِ بْنَ عَبَّاسٍ . ح وحَدَّثَنَا أَبُو الطَّاهِرِ وَاللَّفْظُ لَهُ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي مَالِكُ بْنُ أَنَسٍ ، وَغَيْرُهُ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ وَعْلَةَ السَّبَإِيِّ مِنْ أَهْلِ مِصْرَ، أَنَّهُ سَأَلَ عَبْدَ اللَّهِ بْنَ عَبَّاسٍ عَمَّا يُعْصَرُ مِنَ الْعِنَبِ؟، فَقَالَ ابْنُ عَبَّاسٍ : \\"" إِنَّ رَجُلًا أَهْدَى لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَاوِيَةَ خَمْرٍ، فَقَالَ لَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: هَلْ عَلِمْتَ أَنَّ اللَّهَ قَدْ حَرَّمَهَا؟، قَالَ: لَا فَسَارَّ إِنْسَانًا، فَقَالَ لَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: بِمَ سَارَرْتَهُ؟، فَقَالَ: أَمَرْتُهُ بِبَيْعِهَا، فَقَالَ: إِنَّ الَّذِي حَرَّمَ شُرْبَهَا حَرَّمَ بَيْعَهَا، قَالَ: فَفَتَحَ الْمَزَادَةَ حَتَّى ذَهَبَ مَا فِيهَا \""\""،nصحیح مسلم حدیث: 4044 عربی حدیث: 1579""","Sahih","Sahih Muslim 4044","","","12. باب: شراب بیچنا حرام ہے۔پچھنے لگانے کی اجرت کا جوازChapter: The permissibility of a cupper's earnings"
"4045","حَدَّثَنِي أَبُو الطَّاهِرِ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي سُلَيْمَانُ بْنُ بِلَالٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ وَعْلَةَ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ.nصحیح مسلم حدیث: 4045 عربی حدیث: 1579","Sahih","Sahih Muslim 4045","","","12. باب: شراب بیچنا حرام ہے۔پچھنے لگانے کی اجرت کا جوازChapter: The permissibility of a cupper's earnings"
"4046","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ زُهَيْرٌ، حَدَّثَنَا إِسْحَاق، أَخْبَرَنَا جَرِيرٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِي الضُّحَى ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَةَ ، قَالَتْ: \\"" لَمَّا نَزَلَتِ الْآيَاتُ مِنْ آخِرِ سُورَةِ الْبَقَرَةِ، خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَاقْتَرَأَهُنَّ عَلَى النَّاسِ، ثُمَّ نَهَى عَنِ التِّجَارَةِ فِي الْخَمْرِ \""\"".nصحیح مسلم حدیث: 4046 عربی حدیث: 1580""","Sahih","Sahih Muslim 4046","","","12. باب: شراب بیچنا حرام ہے۔شراب بیچنے خریدنے کی حرمتChapter: The prohibition of selling wine"
"4047","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، وَإِسْحَاق بْنُ إِبْرَاهِيمَ وَاللَّفْظُ لِأَبِي كُرَيْبٍ، قَالَ إِسْحَاق: أَخْبَرَنَا، وَقَالَ الْآخَرَانِ: حَدَّثَنَا أَبُو مُعَاوِيَةَ ، عَنْ الْأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَةَ ، قَالَتْ: \\"" لَمَّا أُنْزِلَتِ الْآيَاتُ مِنْ آخِرِ سُورَةِ الْبَقَرَةِ فِي الرِّبَا، قَالَتْ: خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى الْمَسْجِدِ فَحَرَّمَ التِّجَارَةَ فِي الْخَمْرِ \""\"".nصحیح مسلم حدیث: 4047 عربی حدیث: 1580""","Sahih","Sahih Muslim 4047","","","12. باب: شراب بیچنا حرام ہے۔شراب بیچنے خریدنے کی حرمتChapter: The prohibition of selling wine"
"4048","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، أَنَّهُ سَمِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" عَامَ الْفَتْحِ وَهُوَ بِمَكَّةَ إِنَّ اللَّهَ وَرَسُولَهُ حَرَّمَ بَيْعَ الْخَمْرِ، وَالْمَيْتَةِ، وَالْخِنْزِيرِ، وَالْأَصْنَامِ، فَقِيلَ: يَا رَسُولَ اللَّهِ، أَرَأَيْتَ شُحُومَ الْمَيْتَةِ فَإِنَّهُ يُطْلَى بِهَا السُّفُنُ وَيُدْهَنُ بِهَا الْجُلُودُ وَيَسْتَصْبِحُ بِهَا النَّاسُ؟، فَقَالَ: لَا هُوَ حَرَامٌ، ثُمَّ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: عِنْدَ ذَلِكَ قَاتَلَ اللَّهُ الْيَهُودَ، إِنَّ اللَّهَ عَزَّ وَجَلَّ لَمَّا حَرَّمَ عَلَيْهِمْ شُحُومَهَا أَجْمَلُوهُ، ثُمَّ بَاعُوهُ فَأَكَلُوا ثَمَنَهُ \""\""،nصحیح مسلم حدیث: 4048 عربی حدیث: 1581""","Sahih","Sahih Muslim 4048","","","13. باب: شراب اور مردار اور سور اور بتوں کی بیع حرام ہے۔شراب بیچنے خریدنے کی حرمتChapter: The prohibition of selling wine"
"4049","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَابْنُ نُمَيْرٍ ، قَالَا: حَدَّثَنَا أَبُو أُسَامَةَ ، عَنْ عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، عَنْ عَطَاءٍ ، عَنْ جَابِرٍ ، قَالَ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَامَ الْفَتْحِ. ح وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا الضَّحَّاكُ يَعْنِي أَبَا عَاصِمٍ ، عَنْ عَبْدِ الْحَمِيدِ ، حَدَّثَنِي يَزِيدُ بْنُ أَبِي حَبِيبٍ ، قَالَ: كَتَبَ إِلَيَّ عَطَاءٌ أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَامَ الْفَتْحِ بِمِثْلِ حَدِيثِ اللَّيْثِ.nصحیح مسلم حدیث: 4049 عربی حدیث: 1581","Sahih","Sahih Muslim 4049","","","13. باب: شراب اور مردار اور سور اور بتوں کی بیع حرام ہے۔شراب بیچنے خریدنے کی حرمتChapter: The prohibition of selling wine"
"4050","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَزُهَيْرُ بْنُ حَرْبٍ ، وَإِسْحَاق بْنُ إِبْرَاهِيمَ وَاللَّفْظُ لِأَبِي بَكْرٍ، قَالُوا: حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ عَمْرٍو ، عَنْ طَاوُسٍ ، عَنْ ابْنِ عَبَّاسٍ ، قَالَ: بَلَغَ عُمَرَ : أَنَّ سَمُرَةَ بَاعَ خَمْرًا، فَقَالَ: قَاتَلَ اللَّهُ سَمُرَةَ، أَلَمْ يَعْلَمْ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لَعَنَ اللَّهُ الْيَهُودَ حُرِّمَتْ عَلَيْهِمُ الشُّحُومُ، فَجَمَلُوهَا فَبَاعُوهَا \""\""،nصحیح مسلم حدیث: 4050 عربی حدیث: 1582""","Sahih","Sahih Muslim 4050","","","13. باب: شراب اور مردار اور سور اور بتوں کی بیع حرام ہے۔شراب بیچنے خریدنے کی حرمتChapter: The prohibition of selling wine"
"4051","حَدَّثَنَا أُمَيَّةُ بْنُ بِسْطَامَ ، حَدَّثَنَا يَزِيدُ بْنُ زُرَيْعٍ ، حَدَّثَنَا رَوْحٌ يَعْنِي ابْنَ الْقَاسِمِ ، عَنْ عَمْرِو بْنِ دِينَارٍ بِهَذَا الْإِسْنَادِ مِثْلَهُ.nصحیح مسلم حدیث: 4051 عربی حدیث: 1582","Sahih","Sahih Muslim 4051","","","13. باب: شراب اور مردار اور سور اور بتوں کی بیع حرام ہے۔شراب ‘مردار ‘خنزیر اور بتوں کی خریدو فروخت حرام ہےChapter: The prohibition of selling wine, dead meat, pork and idols"
"4052","حَدَّثَنَا إِسْحَاق بْنُ إِبْرَاهِيمَ الْحَنْظَلِيُّ ، أَخْبَرَنَا رَوْحُ بْنُ عُبَادَةَ ، حَدَّثَنَا ابْنُ جُرَيْجٍ ، أَخْبَرَنِي ابْنُ شِهَابٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ : أَنَّهُ حَدَّثَهُ، عَنْ أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" قَاتَلَ اللَّهُ الْيَهُودَ حَرَّمَ اللَّهُ عَلَيْهِمُ الشُّحُومَ، فَبَاعُوهَا وَأَكَلُوا أَثْمَانَهَا \""\"".nصحیح مسلم حدیث: 4052 عربی حدیث: 1583""","Sahih","Sahih Muslim 4052","","","13. باب: شراب اور مردار اور سور اور بتوں کی بیع حرام ہے۔شراب ‘مردار ‘خنزیر اور بتوں کی خریدو فروخت حرام ہےChapter: The prohibition of selling wine, dead meat, pork and idols"
"4053","حَدَّثَنِي حَرْمَلَةُ بْنُ يَحْيَى ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" قَاتَلَ اللَّهُ الْيَهُودَ حُرِّمَ عَلَيْهِمُ الشَّحْمُ، فَبَاعُوهُ وَأَكَلُوا ثَمَنَهُ \""\"".nصحیح مسلم حدیث: 4053 عربی حدیث: 1583""","Sahih","Sahih Muslim 4053","","","13. باب: شراب اور مردار اور سور اور بتوں کی بیع حرام ہے۔شراب ‘مردار ‘خنزیر اور بتوں کی خریدو فروخت حرام ہےChapter: The prohibition of selling wine, dead meat, pork and idols"
"4054","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ نَافِعٍ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ : أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لَا تَبِيعُوا الذَّهَبَ بِالذَّهَبِ إِلَّا مِثْلًا بِمِثْلٍ، وَلَا تُشِفُّوا بَعْضَهَا عَلَى بَعْضٍ، وَلَا تَبِيعُوا الْوَرِقَ بِالْوَرِقِ إِلَّا مِثْلًا بِمِثْلٍ، وَلَا تُشِفُّوا بَعْضَهَا عَلَى بَعْضٍ، وَلَا تَبِيعُوا مِنْهَا غَائِبًا بِنَاجِزٍ \""\"".nصحیح مسلم حدیث: 4054 عربی حدیث: 1584""","Sahih","Sahih Muslim 4054","","","14. باب: سود کا بیان۔شراب ‘مردار ‘خنزیر اور بتوں کی خریدو فروخت حرام ہےChapter: The prohibition of selling wine, dead meat, pork and idols"
"4055","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ رُمْحٍ ، أَخْبَرَنَا اللَّيْثُ ، عَنْ نَافِعٍ : أَنَّ ابْنَ عُمَرَ قَالَ لَهُ: رَجُلٌ مِنْ بَنِي لَيْثٍ إِنَّ أَبَا سَعِيدٍ الْخُدْرِيَّ يَأْثُرُ هَذَا، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي رِوَايَةِ قُتَيْبَةَ، فَذَهَبَ عَبْدُ اللَّهِ، وَنَافِعٌ مَعَهُ وَفِي حَدِيثِ ابْنِ رُمْحٍ، قَالَ نَافِعٌ: فَذَهَبَ عَبْدُ اللَّهِ وَأَنَا مَعَهُ وَاللَّيْثِيُّ حَتَّى دَخَلَ عَلَى أَبِي سَعِيدٍ الْخُدْرِيِّ، فَقَالَ: إِنَّ هَذَا أَخْبَرَنِي أَنَّكَ تُخْبِرُ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" نَهَى عَنْ بَيْعِ الْوَرِقِ بِالْوَرِقِ إِلَّا مِثْلًا بِمِثْلٍ، وَعَنْ بَيْعِ الذَّهَبِ بِالذَّهَبِ إِلَّا مِثْلًا بِمِثْلٍ، فَأَشَارَ أَبُو سَعِيدٍ بِإِصْبَعَيْهِ إِلَى عَيْنَيْهِ وَأُذُنَيْهِ، فَقَالَ: أَبْصَرَتْ عَيْنَايَ وَسَمِعَتْ أُذُنَايَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: لَا تَبِيعُوا الذَّهَبَ بِالذَّهَبِ، وَلَا تَبِيعُوا الْوَرِقَ بِالْوَرِقِ إِلَّا مِثْلًا بِمِثْلٍ، وَلَا تُشِفُّوا بَعْضَهُ عَلَى بَعْضٍ، وَلَا تَبِيعُوا شَيْئًا غَائِبًا مِنْهُ بِنَاجِزٍ إِلَّا يَدًا بِيَدٍ \""\""nصحیح مسلم حدیث: 4055 عربی حدیث: 1584""","Sahih","Sahih Muslim 4055","","","14. باب: سود کا بیان۔شراب ‘مردار ‘خنزیر اور بتوں کی خریدو فروخت حرام ہےChapter: The prohibition of selling wine, dead meat, pork and idols"
"4056","حَدَّثَنَا شَيْبَانُ بْنُ فَرُّوخَ ، حَدَّثَنَا جَرِيرٌ يَعْنِي ابْنَ حَازِمٍ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا عَبْدُ الْوَهَّابِ ، قَالَ: سَمِعْتُ يَحْيَى بْنَ سَعِيدٍ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا ابْنُ أَبِي عَدِيٍّ ، عَنْ ابْنِ عَوْنٍ كُلُّهُمْ، عَنْ نَافِعٍ بِنَحْوِ حَدِيثِ اللَّيْثِ، عَنْ نَافِعٍ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.nصحیح مسلم حدیث: 4056 عربی حدیث: 1584","Sahih","Sahih Muslim 4056","","","14. باب: سود کا بیان۔شراب ‘مردار ‘خنزیر اور بتوں کی خریدو فروخت حرام ہےChapter: The prohibition of selling wine, dead meat, pork and idols"
"4057","وحَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا يَعْقُوبُ يَعْنِي ابْنَ عَبْدِ الرَّحْمَنِ الْقَارِيَّ ، عَنْ سُهَيْلٍ ، عَنْ أَبِيهِ عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لَا تَبِيعُوا الذَّهَبَ بِالذَّهَبِ، وَلَا الْوَرِقَ بِالْوَرِقِ، إِلَّا وَزْنًا بِوَزْنٍ مِثْلًا بِمِثْلٍ سَوَاءً بِسَوَاءٍ \""\"".nصحیح مسلم حدیث: 4057 عربی حدیث: 1584""","Sahih","Sahih Muslim 4057","","","14. باب: سود کا بیان۔سود کا بیانChapter: Riba (Usury, Interest)"
"4058","حَدَّثَنَا أَبُو الطَّاهِرِ ، وَهَارُونُ بْنُ سَعِيدٍ الْأَيْلِيُّ ، وأحمد بن عيسى ، قَالُوا: حَدَّثَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي مَخْرَمَةُ ، عَنْ أَبِيهِ ، قَالَ: سَمِعْتُ سُلَيْمَانَ بْنَ يَسَارٍ ، يَقُولُ: إِنَّهُ سَمِعَ مَالِكَ بْنَ أَبِي عَامِرٍ يُحَدِّثُ عَنْ عُثْمَانَ بْنِ عَفَّانَ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ: \\"" لَا تَبِيعُوا الدِّينَارَ بِالدِّينَارَيْنِ، وَلَا الدِّرْهَمَ بِالدِّرْهَمَيْنِ \""\"".nصحیح مسلم حدیث: 4058 عربی حدیث: 1585""","Sahih","Sahih Muslim 4058","","","14. باب: سود کا بیان۔سود کا بیانChapter: Riba (Usury, Interest)"
"4059","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ حَدَّثَنَا لَيْثٌ ح وَحَدَّثَنَا مُحَمَّدُ بْنُ رُمْحٍ أَخْبَرَنَا اللَّيْثُ عَنِ ابْنِ شِهَابٍ عَنْ مَالِكِ بْنِ أَوْسِ بْنِ الْحَدَثَانِ أَنَّهُ قَالَ أَقْبَلْتُ أَقُولُ مَنْ يَصْطَرِفُ الدَّرَاهِمَ فَقَالَ طَلْحَةُ بْنُ عُبَيْدِ اللَّهِ وَهُوَ عِنْدَ عُمَرَ بْنِ الْخَطَّابِ أَرِنَا ذَهَبَكَ ثُمَّ ائْتِنَا إِذَا جَاءَ خَادِمُنَا نُعْطِكَ وَرِقَكَ. فَقَالَ عُمَرُ بْنُ الْخَطَّابِ كَلاَّ وَاللَّهِ لَتُعْطِيَنَّهُ وَرِقَهُ أَوْ لَتَرُدَّنَّ إِلَيْهِ ذَهَبَهُ فَإِنَّ رَسُولَ اللَّهِ -صلى الله عليه وسلم- قَالَ «الْوَرِقُ بِالذَّهَبِ رِبًا إِلاَّ هَاءَ وَهَاءَ وَالْبُرُّ بِالْبُرِّ رِبًا إِلاَّ هَاءَ وَهَاءَ وَالشَّعِيرُ بِالشَّعِيرِ رِبًا إِلاَّ هَاءَ وَهَاءَ وَالتَّمْرُ بِالتَّمْرِ رِبًا إِلاَّ هَاءَ وَهَاءَ» .nصحیح مسلم حدیث: 4059 عربی حدیث: 1586","Sahih","Sahih Muslim 4059","","","15. باب: بیع صرف اور سونے کی چاندی کے ساتھ نقد بیع۔سود کا بیانChapter: Riba (Usury, Interest)"
"4060","وَحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِى شَيْبَةَ وَزُهَيْرُ بْنُ حَرْبٍ وَإِسْحَاقُ عَنِ ابْنِ عُيَيْنَةَ عَنِ الزُّهْرِىِّ بِهَذَا الإِسْنَادِ.nصحیح مسلم حدیث: 4060 عربی حدیث: 1586","Sahih","Sahih Muslim 4060","","","15. باب: بیع صرف اور سونے کی چاندی کے ساتھ نقد بیع۔سود کا بیانChapter: Riba (Usury, Interest)"
"4061","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلَابَةَ ، قَالَ: كُنْتُ بِالشَّامِ فِي حَلْقَةٍ فِيهَا مُسْلِمُ بْنُ يَسَارٍ، فَجَاءَ أَبُو الْأَشْعَثِ ، قَالَ: قَالُوا: أَبُو الْأَشْعَثِ، أَبُو الْأَشْعَثِ، فَجَلَسَ فَقُلْتُ لَهُ: حَدِّثْ أَخَانَا حَدِيثَ عُبَادَةَ بْنِ الصَّامِتِ، قَالَ: \\"" نَعَمْ غَزَوْنَا غَزَاةً وَعَلَى النَّاسِ مُعَاوِيَةُ، فَغَنِمْنَا غَنَائِمَ كَثِيرَةً، فَكَانَ فِيمَا غَنِمْنَا آنِيَةٌ مِنْ فِضَّةٍ فَأَمَرَ مُعَاوِيَةُ رَجُلًا أَنْ يَبِيعَهَا فِي أَعْطِيَاتِ النَّاسِ، فَتَسَارَعَ النَّاسُ فِي ذَلِكَ، فَبَلَغَ عُبَادَةَ بْنَ الصَّامِتِ فَقَامَ، فَقَالَ: إِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: يَنْهَى عَنْ بَيْعِ الذَّهَبِ بِالذَّهَبِ، وَالْفِضَّةِ بِالْفِضَّةِ، وَالْبُرِّ بِالْبُرِّ، وَالشَّعِيرِ بِالشَّعِيرِ، وَالتَّمْرِ بِالتَّمْرِ، وَالْمِلْحِ بِالْمِلْحِ إِلَّا سَوَاءً بِسَوَاءٍ، عَيْنًا بِعَيْنٍ، فَمَنْ زَادَ أَوِ ازْدَادَ، فَقَدْ أَرْبَى فَرَدَّ النَّاسُ مَا أَخَذُوا، فَبَلَغَ ذَلِكَ مُعَاوِيَةَ فَقَامَ خَطِيبًا، فَقَالَ: أَلَا مَا بَالُ رِجَالٍ يَتَحَدَّثُونَ عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَحَادِيثَ قَدْ كُنَّا نَشْهَدُهُ وَنَصْحَبُهُ، فَلَمْ نَسْمَعْهَا مِنْهُ، فَقَامَ عُبَادَةُ بْنُ الصَّامِتِ فَأَعَادَ الْقِصَّةَ، ثُمَّ قَالَ: لَنُحَدِّثَنَّ بِمَا سَمِعْنَا مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَإِنْ كَرِهَ مُعَاوِيَةُ أَوَ قَالَ: وَإِنْ رَغِمَ مَا أُبَالِي أَنْ لَا أَصْحَبَهُ فِي جُنْدِهِ لَيْلَةً سَوْدَاءَ \""\""، قَالَ حَمَّادٌ: هَذَا أَوْ نَحْوَهُ،nصحیح مسلم حدیث: 4061 عربی حدیث: 1587""","Sahih","Sahih Muslim 4061","","","15. باب: بیع صرف اور سونے کی چاندی کے ساتھ نقد بیع۔سود کا بیانChapter: Riba (Usury, Interest)"
"4062","حَدَّثَنَا إِسْحَاق بْنُ إِبْرَاهِيمَ ، وَابْنُ أَبِي عُمَرَ جَمِيعًا، عَنْ عَبْدِ الْوَهَّابِ الثَّقَفِيِّ ، عَنْ أَيُّوبَ بِهَذَا الْإِسْنَادِ نَحْوَهُ.nصحیح مسلم حدیث: 4062 عربی حدیث: 1587","Sahih","Sahih Muslim 4062","","","15. باب: بیع صرف اور سونے کی چاندی کے ساتھ نقد بیع۔رقمکا تبادلہ اور سونے کی چاندی کے عوض نقد بیعChapter: Exchange and Selling Gold for Silver on the spot"
"4063","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَعَمْرٌو النَّاقِدُ ، وَإِسْحَاق بْنُ إِبْرَاهِيمَ وَاللَّفْظُ لِابْنِ أَبِي شَيْبَةَ، قَالَ إِسْحَاق: أَخْبَرَنَا، وَقَالَ الْآخَرَانِ، حَدَّثَنَا وَكِيعٌ ، حَدَّثَنَا سُفْيَانُ ، عَنْ خَالِدٍ الْحَذَّاءِ ، عَنْ أَبِي قِلَابَةَ ، عَنْ أَبِي الْأَشْعَثِ ، عَنْ عُبَادَةَ بْنِ الصَّامِتِ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" الذَّهَبُ بِالذَّهَبِ، وَالْفِضَّةُ بِالْفِضَّةِ، وَالْبُرُّ بِالْبُرِّ، وَالشَّعِيرُ بِالشَّعِيرِ، وَالتَّمْرُ بِالتَّمْرِ، وَالْمِلْحُ بِالْمِلْحِ مِثْلًا بِمِثْلٍ سَوَاءً بِسَوَاءٍ يَدًا بِيَدٍ، فَإِذَا اخْتَلَفَتْ هَذِهِ الْأَصْنَافُ، فَبِيعُوا كَيْفَ شِئْتُمْ إِذَا كَانَ يَدًا بِيَدٍ \""\"".nصحیح مسلم حدیث: 4063 عربی حدیث: 1587""","Sahih","Sahih Muslim 4063","","","15. باب: بیع صرف اور سونے کی چاندی کے ساتھ نقد بیع۔رقمکا تبادلہ اور سونے کی چاندی کے عوض نقد بیعChapter: Exchange and Selling Gold for Silver on the spot"
"4064","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ حَدَّثَنَا وَكِيعٌ ، حَدَّثَنَا إِسْمَاعِيل بْنُ مُسْلِمٍ الْعَبْدِيُّ ، حَدَّثَنَا أَبُو الْمُتَوَكِّلِ النَّاجِيُّ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" الذَّهَبُ بِالذَّهَب، وَالْفِضَّةُ بِالْفِضَّةِ، وَالْبُرُّ بِالْبُرِّ، وَالشَّعِيرُ بِالشَّعِيرِ، وَالتَّمْرُ بِالتَّمْرِ، وَالْمِلْحُ بِالْمِلْحِ مِثْلًا بِمِثْلٍ يَدًا بِيَدٍ، فَمَنْ زَادَ أَوِ اسْتَزَادَ، فَقَدْ أَرْبَى الْآخِذُ وَالْمُعْطِي فِيهِ سَوَاءٌ \""\""،nصحیح مسلم حدیث: 4064 عربی حدیث: 1584""","Sahih","Sahih Muslim 4064","","","15. باب: بیع صرف اور سونے کی چاندی کے ساتھ نقد بیع۔رقمکا تبادلہ اور سونے کی چاندی کے عوض نقد بیعChapter: Exchange and Selling Gold for Silver on the spot"
"4065","حَدَّثَنَا عَمْرٌو النَّاقِدُ ، حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ ، أَخْبَرَنَا سُلَيْمَانُ الرَّبَعِيُّ ، حَدَّثَنَا أَبُو الْمُتَوَكِّلِ النَّاجِيُّ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" الذَّهَبُ بِالذَّهَبِ مِثْلًا بِمِثْلٍ \""\"" فَذَكَرَ بِمِثْلِهِ.nصحیح مسلم حدیث: 4065 عربی حدیث: 1584""","Sahih","Sahih Muslim 4065","","","15. باب: بیع صرف اور سونے کی چاندی کے ساتھ نقد بیع۔رقمکا تبادلہ اور سونے کی چاندی کے عوض نقد بیعChapter: Exchange and Selling Gold for Silver on the spot"
"4066","حَدَّثَنَا أَبُو كُرَيْبٍ مُحَمَّدُ بْنُ الْعَلَاءِ ، وَوَاصِلُ بْنُ عَبْدِ الْأَعْلَى ، قَالَا: حَدَّثَنَا ابْنُ فُضَيْلٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي زُرْعَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" التَّمْرُ بِالتَّمْرِ، وَالْحِنْطَةُ بِالْحِنْطَةِ، وَالشَّعِيرُ بِالشَّعِيرِ، وَالْمِلْحُ بِالْمِلْحِ مِثْلًا بِمِثْلٍ يَدًا بِيَدٍ، فَمَنْ زَادَ أَوِ اسْتَزَادَ، فَقَدْ أَرْبَى إِلَّا مَا اخْتَلَفَتْ أَلْوَانُهُ \""\""،nصحیح مسلم حدیث: 4066 عربی حدیث: 1588""","Sahih","Sahih Muslim 4066","","","15. باب: بیع صرف اور سونے کی چاندی کے ساتھ نقد بیع۔رقمکا تبادلہ اور سونے کی چاندی کے عوض نقد بیعChapter: Exchange and Selling Gold for Silver on the spot"
"4067","وحَدَّثَنِيهِ أَبُو سَعِيدٍ الْأَشَجُّ ، حَدَّثَنَا الْمُحَارِبِيُّ ، عَنْ فُضَيْلِ بْنِ غَزْوَانَ بِهَذَا الْإِسْنَادِ وَلَمْ يَذْكُرْ يَدًا بِيَدٍ.nصحیح مسلم حدیث: 4067 عربی حدیث: 1588","Sahih","Sahih Muslim 4067","","","15. باب: بیع صرف اور سونے کی چاندی کے ساتھ نقد بیع۔رقمکا تبادلہ اور سونے کی چاندی کے عوض نقد بیعChapter: Exchange and Selling Gold for Silver on the spot"
"4068","حَدَّثَنَا أَبُو كُرَيْبٍ ، وَوَاصِلُ بْنُ عَبْدِ الْأَعْلَى ، قَالَا: حَدَّثَنَا ابْنُ فُضَيْلٍ ، عَنْ أَبِيهِ عَنْ ابْنِ أَبِي نُعْمٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" بِالذَّهَبِ وَزْنًا بِوَزْنٍ مِثْلًا بِمِثْلٍ، وَالْفِضَّةُ بِالْفِضَّةِ وَزْنًا بِوَزْنٍ مِثْلًا بِمِثْلٍ، فَمَنْ زَادَ أَوِ اسْتَزَادَ فَهُوَ رِبًا \""\"".nصحیح مسلم حدیث: 4068 عربی حدیث: 1588""","Sahih","Sahih Muslim 4068","","","15. باب: بیع صرف اور سونے کی چاندی کے ساتھ نقد بیع۔رقمکا تبادلہ اور سونے کی چاندی کے عوض نقد بیعChapter: Exchange and Selling Gold for Silver on the spot"
"4069","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ الْقَعْنَبِيُّ ، حَدَّثَنَا سُلَيْمَانُ يَعْنِي ابْنَ بِلَالٍ ، عَنْ مُوسَى بْنِ أَبِي تَمِيمٍ ، عَنْ سَعِيدِ بْنِ يَسَارٍ ، عَنْ أَبِي هُرَيْرَةَ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" الدِّينَارُ بِالدِّينَارِ لَا فَضْلَ بَيْنَهُمَا، وَالدِّرْهَمُ بِالدِّرْهَمِ لَا فَضْلَ بَيْنَهُمَا \""\""،nصحیح مسلم حدیث: 4069 عربی حدیث: 1588""","Sahih","Sahih Muslim 4069","","","15. باب: بیع صرف اور سونے کی چاندی کے ساتھ نقد بیع۔رقمکا تبادلہ اور سونے کی چاندی کے عوض نقد بیعChapter: Exchange and Selling Gold for Silver on the spot"
"4070","وحَدَّثَنِيهِ أَبُو الطَّاهِرِ ، أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، قَالَ: سَمِعْتُ مَالِكَ بْنَ أَنَسٍ ، يَقُولُ: حَدَّثَنِي مُوسَى بْنُ أَبِي تَمِيمٍ بِهَذَا الْإِسْنَادِ مِثْلَهُ.nصحیح مسلم حدیث: 4070 عربی حدیث: 1588","Sahih","Sahih Muslim 4070","","","15. باب: بیع صرف اور سونے کی چاندی کے ساتھ نقد بیع۔رقمکا تبادلہ اور سونے کی چاندی کے عوض نقد بیعChapter: Exchange and Selling Gold for Silver on the spot"
"4071","حَدَّثَنَا مُحَمَّدُ بْنُ حَاتِمِ بْنِ مَيْمُونٍ ، حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ عَمْرٍو ، عَنْ أَبِي الْمِنْهَالِ ، قَالَ: \\"" بَاعَ شَرِيكٌ لِي وَرِقًا بِنَسِيئَةٍ إِلَى الْمَوْسِمِ أَوْ إِلَى الْحَجِّ، فَجَاءَ إِلَيَّ فَأَخْبَرَنِي، فَقُلْتُ: هَذَا أَمْرٌ لَا يَصْلُحُ، قَالَ: قَدْ بِعْتُهُ فِي السُّوقِ، فَلَمْ يُنْكِرْ ذَلِكَ عَلَيَّ أَحَدٌ، فَأَتَيْتُ الْبَرَاءَ بْنَ عَازِبٍ فَسَأَلْتُهُ، فَقَالَ: قَدِمَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْمَدِينَةَ وَنَحْنُ نَبِيعُ هَذَا الْبَيْعَ، فَقَالَ: مَا كَانَ يَدًا بِيَدٍ فَلَا بَأْسَ بِهِ، وَمَا كَانَ نَسِيئَةً فَهُوَ رِبًا \""\""، وَائْتِ زَيْدَ بْنَ أَرْقَمَ فَإِنَّهُ أَعْظَمُ تِجَارَةً مِنِّي، فَأَتَيْتُهُ فَسَأَلْتُهُ، فَقَالَ: مِثْلَ ذَلِكَ.nصحیح مسلم حدیث: 4071 عربی حدیث: 1589""","Sahih","Sahih Muslim 4071","","","16. باب: چاندی کو بیع سونے کے بدلے بطور قرض ممنوع ہونے کا بیان۔رقمکا تبادلہ اور سونے کی چاندی کے عوض نقد بیعChapter: Exchange and Selling Gold for Silver on the spot"
"4072","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ الْعَنْبَرِيُّ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا شُعْبَةُ ، عَنْ حَبِيبٍ : أَنَّهُ سَمِعَ أَبَا الْمِنْهَالِ يَقُولُ: سَأَلْتُ الْبَرَاءَ بْنَ عَازِبٍ، عَنِ الصَّرْفِ، فَقَالَ: سَلْ زَيْدَ بْنَ أَرْقَمَ فَهُوَ أَعْلَمُ، فَسَأَلْتُ زَيْدًا ، فَقَالَ: سَلْ الْبَرَاءَ فَإِنَّهُ أَعْلَمُ، ثُمَّ قَالَا: \\"" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الْوَرِقِ بِالذَّهَبِ دَيْنًا \""\"".nصحیح مسلم حدیث: 4072 عربی حدیث: 1589""","Sahih","Sahih Muslim 4072","","","16. باب: چاندی کو بیع سونے کے بدلے بطور قرض ممنوع ہونے کا بیان۔رقمکا تبادلہ اور سونے کی چاندی کے عوض نقد بیعChapter: Exchange and Selling Gold for Silver on the spot"
"4073","حَدَّثَنَا أَبُو الرَّبِيعِ الْعَتَكِيُّ ، حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، أَخْبَرَنَا يَحْيَى بْنُ أَبِي إِسْحَاق ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ أَبِي بَكْرَةَ ، عَنْ أَبِيه ، قَالَ: \\"" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الْفِضَّةِ بِالْفِضَّةِ، وَالذَّهَبِ بِالذَّهَبِ إِلَّا سَوَاءً بِسَوَاءٍ، وَأَمَرَنَا أَنْ نَشْتَرِيَ الْفِضَّةَ بِالذَّهَبِ كَيْفَ شِئْنَا وَنَشْتَرِيَ الذَّهَبَ بِالْفِضَّةِ كَيْفَ شِئْنَا، قَالَ: فَسَأَلَهُ رَجُلٌ، فَقَالَ: يَدًا بِيَدٍ، فَقَالَ: هَكَذَا سَمِعْتُ \""\""،nصحیح مسلم حدیث: 4073 عربی حدیث: 1590""","Sahih","Sahih Muslim 4073","","","16. باب: چاندی کو بیع سونے کے بدلے بطور قرض ممنوع ہونے کا بیان۔سونے کے عوض چاندی کی ادھار بیع منع ہےChapter: The Prohibition of selling silver for gold to be paid at a later date"
"4074","حَدَّثَنِي إِسْحَاق بْنُ مَنْصُورٍ ، أَخْبَرَنَا يَحْيَى بْنُ صَالِحٍ ، حَدَّثَنَا مُعَاوِيَةُ ، عَنْ يَحْيَى وَهُوَ ابْنُ أَبِي كَثِيرٍ ، عَنْ يَحْيَى بْنِ أَبِي إِسْحَاق ، أَنَّ عَبْدَ الرَّحْمَنِ بْنَ أَبِي بَكْرَةَ ، أَخْبَرَهُ أَنَّ أَبَا بَكْرَةَ ، قَالَ: نَهَانَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ.nصحیح مسلم حدیث: 4074 عربی حدیث: 1590","Sahih","Sahih Muslim 4074","","","16. باب: چاندی کو بیع سونے کے بدلے بطور قرض ممنوع ہونے کا بیان۔سونے کے عوض چاندی کی ادھار بیع منع ہےChapter: The Prohibition of selling silver for gold to be paid at a later date"
"4075","حَدَّثَنِي أَبُو الطَّاهِرِ أَحْمَدُ بْنُ عَمْرِو بْنِ سَرْحٍ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي أَبُو هَانِئٍ الْخَوْلَانِيُّ : أَنَّهُ سَمِعَ عُلَيَّ بْنَ رَبَاحٍ اللَّخْمِيَّ ، يَقُولُ: سَمِعْتُ فَضَالَةَ بْنَ عُبَيْدٍ الْأَنْصَارِيَّ ، يَقُولُ: \\"" أُتِيَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ بِخَيْبَرَ بِقِلَادَةٍ فِيهَا خَرَزٌ وَذَهَبٌ وَهِيَ مِنَ الْمَغَانِمِ تُبَاعُ، فَأَمَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالذَّهَبِ الَّذِي فِي الْقِلَادَةِ، فَنُزِعَ وَحْدَهُ، ثُمَّ قَالَ لَهُمْ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: الذَّهَبُ بِالذَّهَبِ وَزْنًا بِوَزْنٍ \""\"".nصحیح مسلم حدیث: 4075 عربی حدیث: 1591""","Sahih","Sahih Muslim 4075","","","17. باب: سونے اور نگینوں والے ہار کی بیع۔سونے کے عوض چاندی کی ادھار بیع منع ہےChapter: The Prohibition of selling silver for gold to be paid at a later date"
"4076","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ ، عَنْ أَبِي شُجَاعٍ سَعِيدِ بْنِ يَزِيدَ ، عَنْ خَالِدِ بْنِ أَبِي عِمْرَانَ ، عَنْ حَنَشٍ الصَّنْعَانِيِّ ، عَنْ فَضَالَةَ بْنِ عُبَيْدٍ قَالَ: \\"" اشْتَرَيْتُ يَوْمَ خَيْبَرَ قِلَادَةً بِاثْنَيْ عَشَرَ دِينَارًا فِيهَا ذَهَبٌ وَخَرَزٌ، فَفَصَّلْتُهَا، فَوَجَدْتُ فِيهَا أَكْثَرَ مِنَ اثْنَيْ عَشَرَ دِينَارًا، فَذَكَرْتُ ذَلِكَ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: لَا تُبَاعُ حَتَّى تُفَصَّلَ \""\""،nصحیح مسلم حدیث: 4076 عربی حدیث: 1591""","Sahih","Sahih Muslim 4076","","","17. باب: سونے اور نگینوں والے ہار کی بیع۔سونے کے عوض چاندی کی ادھار بیع منع ہےChapter: The Prohibition of selling silver for gold to be paid at a later date"
"4077","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، قَالَا: حَدَّثَنَا ابْنُ مُبَارَكٍ ، عَنْ سَعِيدِ بْنِ يَزِيدَ بِهَذَا الْإِسْنَادِ نَحْوَهُ.nصحیح مسلم حدیث: 4077 عربی حدیث: 1591","Sahih","Sahih Muslim 4077","","","17. باب: سونے اور نگینوں والے ہار کی بیع۔سونے کے عوض چاندی کی ادھار بیع منع ہےChapter: The Prohibition of selling silver for gold to be paid at a later date"
"4078","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ ، عَنْ ابْنِ أَبِي جَعْفَرٍ ، عَنْ الْجُلَاحِ أَبِي كَثِيرٍ ، حَدَّثَنِي حَنَشٌ الصَّنْعَانِيُّ ، عَنْ فَضَالَةَ بْنِ عُبَيْدٍ ، قَالَ: \\"" كُنَّا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمَ خَيْبَرَ نُبَايِعُ الْيَهُودَ الْوُقِيَّةَ الذَّهَبَ بِالدِّينَارَيْنِ وَالثَّلَاثَةِ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: لَا تَبِيعُوا الذَّهَبَ بِالذَّهَبِ إِلَّا وَزْنًا بِوَزْنٍ \""\"".nصحیح مسلم حدیث: 4078 عربی حدیث: 1591""","Sahih","Sahih Muslim 4078","","","17. باب: سونے اور نگینوں والے ہار کی بیع۔اس ہار کی بیع جس میں جواہر (یا موتی )اور سونا ہوChapter: Selling a necklace in which there are pearls and gold"
"4079","حَدَّثَنِي أَبُو الطَّاهِرِ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، عَنْ قُرَّةَ بْنِ عَبْدِ الرَّحْمَنِ الْمُعَافِرِيِّ وَعَمْرِو بْنِ الْحَارِثِ ، وَغَيْرِهِمَا، أَنَّ عَامِرَ بْنَ يَحْيَى الْمُعَافِرِيَّ ، أَخْبَرَهُمْ، عَنْ حَنَشٍ : أَنَّهُ قَالَ: \\"" كُنَّا مَعَ فَضَالَةَ بْنِ عُبَيْدٍ فِي غَزْوَةٍ فَطَارَتْ لِي وَلِأَصْحَابِي قِلَادَةٌ فِيهَا ذَهَبٌ وَوَرِقٌ وَجَوْهَرٌ، فَأَرَدْتُ أَنْ أَشْتَرِيَهَا، فَسَأَلْتُ فَضَالَةَ بْنَ عُبَيْدٍ ، فَقَالَ: انْزِعْ ذَهَبَهَا فَاجْعَلْهُ فِي كِفَّةٍ وَاجْعَلْ ذَهَبَكَ فِي كِفَّةٍ ثُمَّ لَا تَأْخُذَنَّ إِلَّا مِثْلًا بِمِثْلٍ، فَإِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: مَنْ كَانَ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ فَلَا يَأْخُذَنَّ إِلَّا مِثْلًا بِمِثْلٍ \""\"".nصحیح مسلم حدیث: 4079 عربی حدیث: 1591""","Sahih","Sahih Muslim 4079","","","17. باب: سونے اور نگینوں والے ہار کی بیع۔اس ہار کی بیع جس میں جواہر (یا موتی )اور سونا ہوChapter: Selling a necklace in which there are pearls and gold"
"4080","حَدَّثَنَا هَارُونُ بْنُ مَعْرُوفٍ ، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، أَخْبَرَنِي عَمْرٌو . ح وحَدَّثَنِي أَبُو الطَّاهِرِ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، عَنْ عَمْرِو بْنِ الْحَارِثِ ، أَنَّ أَبَا النَّضْرِ حَدَّثَهُ، أَنَّ بُسْرَ بْنَ سَعِيدٍ حَدَّثَهُ، عَنْ مَعْمَرِ بْنِ عَبْدِ اللَّهِ \\"" أَنَّهُ أَرْسَلَ غُلَامَهُ بِصَاعِ قَمْحٍ، فَقَالَ: بِعْهُ ثُمَّ اشْتَرِ بِهِ شَعِيرًا، فَذَهَبَ الْغُلَامُ، فَأَخَذَ صَاعًا وَزِيَادَةَ بَعْضِ صَاعٍ، فَلَمَّا جَاءَ مَعْمَرًا أَخْبَرَهُ بِذَلِكَ، فَقَالَ لَهُ مَعْمَرٌ: لِمَ فَعَلْتَ ذَلِكَ انْطَلِقْ فَرُدَّهُ وَلَا تَأْخُذَنَّ إِلَّا مِثْلًا بِمِثْلٍ، فَإِنِّي كُنْتُ أَسْمَعُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: الطَّعَامُ بِالطَّعَامِ مِثْلًا بِمِثْلٍ، قَالَ: وَكَانَ طَعَامُنَا يَوْمَئِذٍ الشَّعِيرَ، قِيلَ لَهُ: فَإِنَّهُ لَيْسَ بِمِثْلِهِ، قَالَ: إِنِّي أَخَافُ أَنْ يُضَارِعَ \""\"".nصحیح مسلم حدیث: 4080 عربی حدیث: 1592""","Sahih","Sahih Muslim 4080","","","18. باب: برابر برابر اناج کی بیع۔اس ہار کی بیع جس میں جواہر (یا موتی )اور سونا ہوChapter: Selling a necklace in which there are pearls and gold"
"4081","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ بْنِ قَعْنَبٍ ، حَدَّثَنَا سُلَيْمَانُ يَعْنِي ابْنَ بِلَالٍ ، عَنْ عَبْدِ الْمَجِيدِ بْنِ سُهَيْلِ بْنِ عَبْدِ الرَّحْمَنِ : أَنَّهُ سَمِعَ سَعِيدَ بْنَ الْمُسَيِّبِ ، يُحَدِّثُ أَنَّ أَبَا هُرَيْرَةَ ، وَأَبَا سَعِيدٍ حَدَّثَاهُ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَعَثَ أَخَا بَنِي عَدِيٍّ الْأَنْصَارِيَّ، فَاسْتَعْمَلَهُ عَلَى خَيْبَرَ، فَقَدِمَ بِتَمْرٍ جَنِيبٍ، فَقَالَ لَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" أَكُلُّ تَمْرِ خَيْبَرَ هَكَذَا، قَالَ: لَا وَاللَّهِ يَا رَسُولَ اللَّهِ، إِنَّا لَنَشْتَرِي الصَّاعَ بِالصَّاعَيْنِ مِنَ الْجَمْعِ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: لَا تَفْعَلُوا وَلَكِنْ مِثْلًا بِمِثْلٍ أَوْ بِيعُوا هَذَا وَاشْتَرُوا بِثَمَنِهِ مِنْ هَذَا وَكَذَلِكَ الْمِيزَانُ \""\"".nصحیح مسلم حدیث: 4081 عربی حدیث: 1593""","Sahih","Sahih Muslim 4081","","","18. باب: برابر برابر اناج کی بیع۔خوردنی اجناس کی مثال بمثل فروختChapter: Selling Food Like for Like"
"4082","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ عَبْدِ الْمَجِيدِ بْنِ سُهَيْلِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، وَعَنْ أَبِي هُرَيْرَةَ : أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، اسْتَعْمَلَ رَجُلًا عَلَى خَيْبَرَ، فَجَاءَهُ بِتَمْرٍ جَنِيبٍ، فَقَالَ لَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" أَكُلُّ تَمْرِ خَيْبَرَ هَكَذَا، فَقَالَ: لَا وَاللَّهِ يَا رَسُولَ اللَّهِ إِنَّا لَنَأْخُذُ الصَّاعَ مِنْ هَذَا بِالصَّاعَيْنِ وَالصَّاعَيْنِ بِالثَّلَاثَةِ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: فَلَا تَفْعَلْ بِعِ الْجَمْعَ بِالدَّرَاهِمِ ثُمَّ ابْتَعْ بِالدَّرَاهِمِ جَنِيبًا \""\"".nصحیح مسلم حدیث: 4082 عربی حدیث: 1593""","Sahih","Sahih Muslim 4082","","","18. باب: برابر برابر اناج کی بیع۔خوردنی اجناس کی مثال بمثل فروختChapter: Selling Food Like for Like"
"4083","حَدَّثَنَا إِسْحَاق بْنُ مَنْصُورٍ ، أَخْبَرَنَا يَحْيَى بْنُ صَالِحٍ الْوُحَاظِيُّ ، حَدَّثَنَا مُعَاوِيَةُ ح، وحَدَّثَنِي مُحَمَّدُ بْنُ سَهْلٍ التَّمِيمِيُّ ، وَعَبْدُ اللَّهِ بْنُ عَبْدِ الرَّحْمَنِ الدَّارِمِيُّ وَاللَّفْظُ لَهُمَا جَمِيعًا، عَنْ يَحْيَى بْنِ حَسَّانَ ، حَدَّثَنَا مُعَاوِيَةُ وَهُوَ ابْنُ سَلَّامٍ ، أَخْبَرَنِي يَحْيَى وَهُوَ ابْنُ أَبِي كَثِيرٍ ، قَالَ: سَمِعْتُ عُقْبَةَ بْنَ عَبْدِ الْغَافِرِ ، يَقُولُ: سَمِعْتُ أَبَا سَعِيدٍ ، يَقُولُ: \\"" جَاءَ بِلَالٌ بِتَمْرٍ بَرْنِيٍّ، فَقَالَ لَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: مِنْ أَيْنَ هَذَا؟ فَقَالَ بِلَالٌ: تَمْرٌ كَانَ عِنْدَنَا رَدِيءٌ، فَبِعْتُ مِنْهُ صَاعَيْنِ بِصَاعٍ لِمَطْعَمِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ رَسُولُ اللَّهِ عِنْدَ ذَلِكَ: أَوَّهْ عَيْنُ الرِّبَا لَا تَفْعَلْ وَلَكِنْ إِذَا أَرَدْتَ أَنْ تَشْتَرِيَ التَّمْرَ، فَبِعْهُ بِبَيْعٍ آخَرَ ثُمَّ اشْتَرِ بِهِ \""\""، لَمْ يَذْكُرْ ابْنُ سَهْلٍ فِي حَدِيثِهِ عِنْدَ ذَلِكَ.nصحیح مسلم حدیث: 4083 عربی حدیث: 1594""","Sahih","Sahih Muslim 4083","","","18. باب: برابر برابر اناج کی بیع۔خوردنی اجناس کی مثال بمثل فروختChapter: Selling Food Like for Like"
"4084","وحَدَّثَنَا سَلَمَةُ بْنُ شَبِيبٍ ، حَدَّثَنَا الْحَسَنُ بْنُ أَعْيَنَ ، حَدَّثَنَا مَعْقِلٌ ، عَنْ أَبِي قَزَعَةَ الْبَاهِلِيِّ ، عَنْ أَبِي نَضْرَةَ ، عَنْ أَبِي سَعِيدٍ ، قَالَ: \\"" أُتِيَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِتَمْرٍ، فَقَالَ: مَا هَذَا التَّمْرُ مِنْ تَمْرِنَا؟، فَقَالَ الرَّجُلُ: يَا رَسُولَ اللَّهِ، بِعْنَا تَمْرَنَا صَاعَيْنِ بِصَاعٍ مِنْ هَذَا، فَقَالَ رَسُولُ اللَّهِ: هَذَا الرِّبَا فَرُدُّوهُ ثُمَّ بِيعُوا تَمْرَنَا وَاشْتَرُوا لَنَا مِنْ هَذَا \""\"".nصحیح مسلم حدیث: 4084 عربی حدیث: 1594""","Sahih","Sahih Muslim 4084","","","18. باب: برابر برابر اناج کی بیع۔خوردنی اجناس کی مثال بمثل فروختChapter: Selling Food Like for Like"
"4085","حَدَّثَنِي إِسْحَاق بْنُ مَنْصُورٍ ، حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُوسَى ، عَنْ شَيْبَانَ ، عَنْ يَحْيَى ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي سَعِيدٍ ، قَالَ: \\"" كُنَّا نُرْزَقُ تَمْرَ الْجَمْعِ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ الْخِلْطُ مِنَ التَّمْرِ، فَكُنَّا نَبِيعُ صَاعَيْنِ بِصَاعٍ، فَبَلَغَ ذَلِكَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: لَا صَاعَيْ تَمْرٍ بِصَاعٍ، وَلَا صَاعَيْ حِنْطَةٍ بِصَاعٍ وَلَا دِرْهَمَ بِدِرْهَمَيْنِ \""\"".nصحیح مسلم حدیث: 4085 عربی حدیث: 1595""","Sahih","Sahih Muslim 4085","","","18. باب: برابر برابر اناج کی بیع۔خوردنی اجناس کی مثال بمثل فروختChapter: Selling Food Like for Like"
"4086","حَدَّثَنِي عَمْرٌو النَّاقِدُ ، حَدَّثَنَا إِسْمَاعِيل بْنُ إِبْرَاهِيمَ ، عَنْ سَعِيدٍ الْجُرَيْرِيِّ ، عَنْ أَبِي نَضْرَةَ ، قَالَ: \\"" سَأَلْتُ ابْنَ عَبَّاسٍ عَنِ الصَّرْفِ، فَقَالَ: أَيَدًا بِيَدٍ، قُلْتُ: نَعَمْ، قَالَ: فَلَا بَأْسَ بِهِ، فَأَخْبَرْتُ أَبَا سَعِيدٍ، فَقُلْتُ: إِنِّي سَأَلْتُ ابْنَ عَبَّاسٍ ، عَنِ الصَّرْفِ، فَقَالَ: أَيَدًا بِيَدٍ، قُلْتُ: نَعَمْ، قَالَ: فَلَا بَأْسَ بِهِ، قَالَ: أَوَ قَالَ ذَلِكَ: إِنَّا سَنَكْتُبُ إِلَيْهِ، فَلَا يُفْتِيكُمُوهُ، قَالَ: فَوَاللَّهِ لَقَدْ جَاءَ بَعْضُ فِتْيَانِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِتَمْرٍ، فَأَنْكَرَهُ، فَقَالَ: كَأَنَّ هَذَا لَيْسَ مِنْ تَمْرِ أَرْضِنَا، قَالَ: كَانَ فِي تَمْرِ أَرْضِنَا أَوْ فِي تَمْرِنَا الْعَامَ بَعْضُ الشَّيْءِ، فَأَخَذْتُ هَذَا وَزِدْتُ بَعْضَ الزِّيَادَةِ، فَقَالَ: أَضْعَفْتَ أَرْبَيْتَ لَا تَقْرَبَنَّ هَذَا إِذَا رَابَكَ مِنْ تَمْرِكَ شَيْءٌ، فَبِعْهُ ثُمَّ اشْتَرِ الَّذِي تُرِيدُ مِنَ التَّمْرِ \""\"".nصحیح مسلم حدیث: 4086 عربی حدیث: 1594""","Sahih","Sahih Muslim 4086","","","18. باب: برابر برابر اناج کی بیع۔خوردنی اجناس کی مثال بمثل فروختChapter: Selling Food Like for Like"
"4087","حَدَّثَنَا إِسْحَاق بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا عَبْدُ الْأَعْلَى ، أَخْبَرَنَا دَاوُدُ ، عَنْ أَبِي نَضْرَةَ ، قَالَ: \\"" سَأَلْتُ ابْنَ عُمَرَ، وَابْنَ عَبَّاسٍ، عَنِ الصَّرْفِ، فَلَمْ يَرَيَا بِهِ بَأْسًا، فَإِنِّي لَقَاعِدٌ عِنْدَ أَبِي سَعِيدٍ الْخُدْرِيِّ ، فَسَأَلْتُهُ عَنِ الصَّرْفِ، فَقَالَ: مَا زَادَ فَهُوَ رِبًا، فَأَنْكَرْتُ ذَلِكَ لِقَوْلِهِمَا، فَقَالَ: لَا أُحَدِّثُكَ إِلَّا مَا سَمِعْتُ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، جَاءَهُ صَاحِبُ نَخْلِهِ بِصَاعٍ مِنْ تَمْرٍ طَيِّبٍ وَكَانَ تَمْرُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ هَذَا اللَّوْنَ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: أَنَّى لَكَ هَذَا، قَالَ: انْطَلَقْتُ بِصَاعَيْنِ فَاشْتَرَيْتُ بِهِ هَذَا الصَّاعَ، فَإِنَّ سِعْرَ هَذَا فِي السُّوقِ كَذَا وَسِعْرَ هَذَا كَذَا، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: وَيْلَكَ أَرْبَيْتَ إِذَا أَرَدْتَ ذَلِكَ، فَبِعْ تَمْرَكَ بِسِلْعَةٍ ثُمَّ اشْتَرِ بِسِلْعَتِكَ أَيَّ تَمْرٍ شِئْتَ \""\""، قَالَ أَبُو سَعِيدٍ: فَالتَّمْرُ بِالتَّمْرِ أَحَقُّ أَنْ يَكُونَ رِبًا، أَمْ الْفِضَّةُ بِالْفِضَّةِ، قَالَ: فَأَتَيْتُ ابْنَ عُمَرَ بَعْدُ، فَنَهَانِي وَلَمْ آتِ ابْنَ عَبَّاسٍ، قَالَ: فَحَدَّثَنِي أَبُو الصَّهْبَاءِ أَنَّهُ سَأَلَ ابْنَ عَبَّاسٍ عَنْهُ بِمَكَّةَ فَكَرِهَهُ.nصحیح مسلم حدیث: 4087 عربی حدیث: 1594""","Sahih","Sahih Muslim 4087","","","18. باب: برابر برابر اناج کی بیع۔خوردنی اجناس کی مثال بمثل فروختChapter: Selling Food Like for Like"
"4088","حَدَّثَنِي مُحَمَّدُ بْنُ عَبَّادٍ ، وَمُحَمَّدُ بْنُ حَاتِمٍ وَابْنُ أَبِي عُمَرَ جَمِيعًا، عَنْ سُفْيَانَ بْنِ عُيَيْنَةَ وَاللَّفْظُ لِابْنِ عَبَّادٍ، قَالَ: حَدَّثَنَا سُفْيَانُ، عَنْ عَمْرٍو ، عَنْ أَبِي صَالِحٍ ، قَالَ: سَمِعْتُ أَبَا سَعِيدٍ الْخُدْرِيَّ ، يَقُولُ: \\"" الدِّينَارُ بِالدِّينَارِ وَالدِّرْهَمُ بِالدِّرْهَمِ مِثْلًا بِمِثْلٍ مَنْ زَادَ أَوِ ازْدَادَ، فَقَدْ أَرْبَى، فَقُلْتُ لَهُ: إِنَّ ابْنَ عَبَّاسٍ يَقُولُ غَيْرَ هَذَا، فَقَالَ: لَقَدْ لَقِيتُ ابْنَ عَبَّاسٍ ، فَقُلْتُ: أَرَأَيْتَ هَذَا الَّذِي تَقُولُ أَشَيْءٌ سَمِعْتَهُ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَوْ وَجَدْتَهُ فِي كِتَابِ اللَّهِ عَزَّ وَجَلَّ، فَقَالَ: لَمْ أَسْمَعْهُ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَلَمْ أَجِدْهُ فِي كِتَابِ اللَّهِ، وَلَكِنْ حَدَّثَنِي أُسَامَةُ بْنُ زَيْدٍ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: الرِّبَا فِي النَّسِيئَةِ \""\"".nصحیح مسلم حدیث: 4088 عربی حدیث: 1596""","Sahih","Sahih Muslim 4088","","","18. باب: برابر برابر اناج کی بیع۔خوردنی اجناس کی مثال بمثل فروختChapter: Selling Food Like for Like"
"4089","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَعَمْرٌو النَّاقِدُ ، وَإِسْحَاق بْنُ إِبْرَاهِيمَ ، وَابْنُ أَبِي عُمَرَ وَاللَّفْظُ لِعَمْرٍو، قَالَ إِسْحَاق أَخْبَرَنَا، وَقَالَ الْآخَرُونَ: حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ عُبَيْدِ اللَّهِ بْنِ أَبِي يَزِيدَ : أَنَّهُ سَمِعَ ابْنَ عَبَّاسٍ ، يَقُولُ: أَخْبَرَنِي أُسَامَةُ بْنُ زَيْدٍ : أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" إِنَّمَا الرِّبَا فِي النَّسِيئَةِ \""\"".nصحیح مسلم حدیث: 4089 عربی حدیث: 1596""","Sahih","Sahih Muslim 4089","","","18. باب: برابر برابر اناج کی بیع۔خوردنی اجناس کی مثال بمثل فروختChapter: Selling Food Like for Like"
"4090","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا عَفَّانُ ح، وحَدَّثَنِي مُحَمَّدُ بْنُ حَاتِمٍ ، حَدَّثَنَا بَهْزٌ ، قَالَا: حَدَّثَنَا وُهَيْبٌ ، حَدَّثَنَا ابْنُ طَاوُسٍ عَنْ أَبِيهِ ، عَنْ ابْنِ عَبَّاسٍ ، عَنْ أُسَامَةَ بْنِ زَيْدٍ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لَا رِبًا فِيمَا كَانَ يَدًا بِيَدٍ \""\"".nصحیح مسلم حدیث: 4090 عربی حدیث: 1596""","Sahih","Sahih Muslim 4090","","","18. باب: برابر برابر اناج کی بیع۔خوردنی اجناس کی مثال بمثل فروختChapter: Selling Food Like for Like"
"4091","حَدَّثَنَا الْحَكَمُ بْنُ مُوسَى ، حَدَّثَنَا هِقْلٌ ، عَنْ الْأَوْزَاعِيِّ ، قَالَ: حَدَّثَنِي عَطَاءُ بْنُ أَبِي رَبَاحٍ : أَنَّ أَبَا سَعِيدٍ الْخُدْرِيَّ لَقِيَ ابْنَ عَبَّاسٍ ، فَقَالَ لَهُ: أَرَأَيْتَ قَوْلَكَ فِي الصَّرْفِ أَشَيْئًا سَمِعْتَهُ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَمْ شَيْئًا وَجَدْتَهُ فِي كِتَابِ اللَّهِ عَزَّ وَجَلَّ، فَقَالَ ابْنُ عَبَّاسٍ: كَلَّا لَا أَقُولُ أَمَّا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَأَنْتُمْ أَعْلَمُ بِهِ وَأَمَّا كِتَابُ اللَّهِ فَلَا أَعْلَمُهُ، وَلَكِنْ حَدَّثَنِي أُسَامَةُ بْنُ زَيْدٍ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" أَلَا إِنَّمَا الرِّبَا فِي النَّسِيئَةِ \""\"".nصحیح مسلم حدیث: 4091 عربی حدیث: 1596""","Sahih","Sahih Muslim 4091","","","18. باب: برابر برابر اناج کی بیع۔خوردنی اجناس کی مثال بمثل فروختChapter: Selling Food Like for Like"
"4092","حَدَّثَنَا عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، وَإِسْحَاق بْنُ إِبْرَاهِيمَ وَاللَّفْظُ لِعُثْمَانَ، قَالَ إِسْحَاق: أَخْبَرَنَا، وَقَالَ عُثْمَانُ، حَدَّثَنَا جَرِيرٌ ، عَنْ مُغِيرَةَ ، قَالَ: سَأَلَ شِبَاكٌ إِبْرَاهِيمَ فَحَدَّثَنَا، عَنْ عَلْقَمَةَ ، عَنْ عَبْدِ اللَّهِ ، قَالَ: \\"" لَعَنَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ آكِلَ الرِّبَا وَمُؤْكِلَهُ \""\""، قَالَ: قُلْتُ: وَكَاتِبَهُ وَشَاهِدَيْهِ، قَالَ: إِنَّمَا نُحَدِّثُ بِمَا سَمِعْنَا.nصحیح مسلم حدیث: 4092 عربی حدیث: 1597""","Sahih","Sahih Muslim 4092","","","19. باب: سود کھانے اور کھلانے والے پر لعنت۔خوردنی اجناس کی مثال بمثل فروختChapter: Selling Food Like for Like"
"4093","حَدَّثَنَا مُحَمَّدُ بْنُ الصَّبَّاحِ ، وَزُهَيْرُ بْنُ حَرْبٍ ، وَعُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالُوا: حَدَّثَنَا هُشَيْمٌ ، أَخْبَرَنَا أَبُو الزُّبَيْرِ ، عَنْ جَابِرٍ ، قَالَ: \\"" لَعَنَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ آكِلَ الرِّبَا وَمُؤْكِلَهُ وَكَاتِبَهُ وَشَاهِدَيْهِ وَقَالَ: هُمْ سَوَاءٌ \""\"".nصحیح مسلم حدیث: 4093 عربی حدیث: 1598""","Sahih","Sahih Muslim 4093","","","19. باب: سود کھانے اور کھلانے والے پر لعنت۔سود کھنے اور کھلانے والے پرلعنتChapter: Cursing the one who consumes Riba and the one who pays it"
"4094","حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ الْهَمْدَانِيُّ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا زَكَرِيَّاءُ ، عَنْ الشَّعْبِيِّ ، عَنْ النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ: سَمِعْتُهُ يَقُولُ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" وَأَهْوَى النُّعْمَانُ بِإِصْبَعَيْهِ إِلَى أُذُنَيْهِ، إِنَّ الْحَلَالَ بَيِّنٌ وَإِنَّ الْحَرَامَ بَيِّنٌ، وَبَيْنَهُمَا مُشْتَبِهَاتٌ لَا يَعْلَمُهُنَّ كَثِيرٌ مِنَ النَّاسِ، فَمَنِ اتَّقَى الشُّبُهَاتِ اسْتَبْرَأَ لِدِينِهِ وَعِرْضِهِ، وَمَنْ وَقَعَ فِي الشُّبُهَاتِ وَقَعَ فِي الْحَرَامِ كَالرَّاعِي يَرْعَى حَوْلَ الْحِمَى يُوشِكُ أَنْ يَرْتَعَ فِيهِ، أَلَا وَإِنَّ لِكُلِّ مَلِكٍ حِمًى، أَلَا وَإِنَّ حِمَى اللَّهِ مَحَارِمُهُ، أَلَا وَإِنَّ فِي الْجَسَدِ مُضْغَةً إِذَا صَلَحَتْ صَلَحَ الْجَسَدُ كُلُّهُ، وَإِذَا فَسَدَتْ فَسَدَ الْجَسَدُ كُلُّهُ أَلَا وَهِيَ الْقَلْبُ \""\""،nصحیح مسلم حدیث: 4094 عربی حدیث: 1599""","Sahih","Sahih Muslim 4094","","","20. باب: حلال کو حاصل کرنے اور شبہ والی اشیاء کو چھوڑنے کا بیان۔سود کھنے اور کھلانے والے پرلعنتChapter: Cursing the one who consumes Riba and the one who pays it"
"4095","وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ، حَدَّثَنَا وَكِيعٌ . ح وحَدَّثَنَا إِسْحَاق بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا عِيسَى بْنُ يُونُسَ ، قَالَا: حَدَّثَنَا زَكَرِيَّاءُ بِهَذَا الْإِسْنَادِ مِثْلَهُ،nصحیح مسلم حدیث: 4095 عربی حدیث: 1599","Sahih","Sahih Muslim 4095","","","20. باب: حلال کو حاصل کرنے اور شبہ والی اشیاء کو چھوڑنے کا بیان۔حلال (مال )حاصل کرنا اور شبہات سےبچناChapter: Taking that which is lawful and leaving that which is unclear"
"4096","وحَدَّثَنَا إِسْحَاق بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا جَرِيرٌ ، عَنْ مُطَرِّفٍ ، وَأَبِى فَرْوَةَ الهمداني . ح وحَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا يَعْقُوبُ يَعْنِي ابْنَ عَبْدِ الرَّحْمَنِ الْقَارِيَّ ، عَنْ ابْنِ عَجْلَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَعِيدٍ كُلُّهُمْ، عَنْ الشَّعْبِيِّ ، عَنْ النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِهَذَا الْحَدِيثِ غَيْرَ أَنَّ حَدِيثَ زَكَرِيَّاءَ أَتَمُّ مِنْ حَدِيثِهِمْ وَأَكْثَرُ،nصحیح مسلم حدیث: 4096 عربی حدیث: 1599","Sahih","Sahih Muslim 4096","","","20. باب: حلال کو حاصل کرنے اور شبہ والی اشیاء کو چھوڑنے کا بیان۔حلال (مال )حاصل کرنا اور شبہات سےبچناChapter: Taking that which is lawful and leaving that which is unclear"
"4097","حَدَّثَنَا عَبْدُ الْمَلِكِ بْنُ شُعَيْبِ بْنِ اللَّيْثِ بْنِ سَعْدٍ ، حَدَّثَنِي أَبِي ، عَنْ جَدِّي ، حَدَّثَنِي خَالِدُ بْنُ يَزِيدَ ، حَدَّثَنِي سَعِيدُ بْنُ أَبِي هِلَالٍ ، عَنْ عَوْنِ بْنِ عَبْدِ اللَّهِ ، عَنْ عَامِرٍ الشَّعْبِيِّ : أَنَّهُ سَمِعَ نُعْمَانَ بْنَ بَشِيرِ بْنِ سَعْدٍ صَاحِبَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَخْطُبُ النَّاسَ بِحِمْصَ وَهُوَ يَقُولُ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" الْحَلَالُ بَيِّنٌ، وَالْحَرَامُ بَيِّنٌ \""\"" فَذَكَرَ بِمِثْلِ حَدِيثِ زَكَرِيَّاءَ عَنْ الشَّعْبِيِّ إِلَى قَوْلِهِ يُوشِكُ أَنْ يَقَعَ فِيهِ.nصحیح مسلم حدیث: 4097 عربی حدیث: 1599""","Sahih","Sahih Muslim 4097","","","20. باب: حلال کو حاصل کرنے اور شبہ والی اشیاء کو چھوڑنے کا بیان۔حلال (مال )حاصل کرنا اور شبہات سےبچناChapter: Taking that which is lawful and leaving that which is unclear"
"4098","حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا زَكَرِيَّاءُ ، عَنْ عَامِرٍ ، حَدَّثَنِي جَابِرُ بْنُ عَبْدِ اللَّهِ \\"" أَنَّهُ كَانَ يَسِيرُ عَلَى جَمَلٍ لَهُ قَدْ أَعْيَا، فَأَرَادَ أَنْ يُسَيِّبَهُ، قَالَ: فَلَحِقَنِي النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَدَعَا لِي وَضَرَبَهُ، فَسَارَ سَيْرًا لَمْ يَسِرْ مِثْلَهُ، قَالَ: بِعْنِيهِ بِوُقِيَّةٍ، قُلْتُ: لَا، ثُمَّ قَالَ: بِعْنِيهِ فَبِعْتُهُ بِوُقِيَّةٍ وَاسْتَثْنَيْتُ عَلَيْهِ حُمْلَانَهُ إِلَى أَهْلِي، فَلَمَّا بَلَغْتُ أَتَيْتُهُ بِالْجَمَلِ، فَنَقَدَنِي ثَمَنَهُ ثُمَّ رَجَعْتُ، فَأَرْسَلَ فِي أَثَرِي، فَقَالَ: أَتُرَانِي مَاكَسْتُكَ لِآخُذَ جَمَلَكَ، خُذْ جَمَلَكَ وَدَرَاهِمَكَ فَهُوَ لَكَ \""\""،nصحیح مسلم حدیث: 4098 عربی حدیث: 715""","Sahih","Sahih Muslim 4098","","","21. باب: اونٹ کا بیچنا اور سواری کی شرط کر لینا۔حلال (مال )حاصل کرنا اور شبہات سےبچناChapter: Taking that which is lawful and leaving that which is unclear"
"4099","وحَدَّثَنَاه عَلِيُّ بْنُ خَشْرَمٍ ، أَخْبَرَنَا عِيسَى يَعْنِي ابْنَ يُونُسَ ، عَنْ زَكَرِيَّاءَ ، عَنْ عَامِرٍ ، حَدَّثَنِي جَابِرُ بْنُ عَبْدِ اللَّهِ بِمِثْلِ حَدِيثِ ابْنِ نُمَيْرٍ.nصحیح مسلم حدیث: 4099 عربی حدیث: 715","Sahih","Sahih Muslim 4099","","","21. باب: اونٹ کا بیچنا اور سواری کی شرط کر لینا۔حلال (مال )حاصل کرنا اور شبہات سےبچناChapter: Taking that which is lawful and leaving that which is unclear"
"4100","حَدَّثَنَا عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، وَإِسْحَاق بْنُ إِبْرَاهِيمَ وَاللَّفْظُ لِعُثْمَانَ، قَالَ إِسْحَاق، أَخْبَرَنَا، وَقَالَ عُثْمَانُ، حَدَّثَنَا جَرِيرٌ ، عَنْ مُغِيرَةَ ، عَنْ الشَّعْبِيِّ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ: \\"" غَزَوْتُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَتَلَاحَقَ بِي وَتَحْتِي نَاضِحٌ لِي قَدْ أَعْيَا وَلَا يَكَادُ يَسِيرُ، قَالَ: فَقَالَ لِي: مَا لِبَعِيرِكَ؟ قَالَ: قُلْتُ: عَلِيلٌ، قَالَ: فَتَخَلَّفَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَزَجَرَهُ وَدَعَا لَهُ، فَمَا زَالَ بَيْنَ يَدَيِ الْإِبِلِ قُدَّامَهَا يَسِيرُ، قَالَ: فَقَالَ لِي: كَيْفَ تَرَى بَعِيرَكَ؟، قَالَ: قُلْتُ: بِخَيْرٍ قَدْ أَصَابَتْهُ بَرَكَتُكَ، قَالَ: أَفَتَبِيعُنِيهِ؟ فَاسْتَحْيَيْتُ وَلَمْ يَكُنْ لَنَا نَاضِحٌ غَيْرُهُ، قَالَ: فَقُلْتُ: نَعَمْ، فَبِعْتُهُ إِيَّاهُ عَلَى أَنَّ لِي فَقَارَ ظَهْرِهِ حَتَّى أَبْلُغَ الْمَدِينَةَ، قَالَ: فَقُلْتُ لَهُ: يَا رَسُولَ اللَّهِ، إِنِّي عَرُوسٌ، فَاسْتَأْذَنْتُهُ فَأَذِنَ لِي، فَتَقَدَّمْتُ النَّاسَ إِلَى الْمَدِينَةِ حَتَّى انْتَهَيْتُ، فَلَقِيَنِي خَالِي فَسَأَلَنِي عَنِ الْبَعِيرِ، فَأَخْبَرْتُهُ بِمَا صَنَعْتُ فِيهِ فَلَامَنِي فِيهِ قَالَ: وَقَدْ كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ لِي حِينَ اسْتَأْذَنْتُهُ: مَا تَزَوَّجْتَ أَبِكْرًا أَمْ ثَيِّبًا؟، فَقُلْتُ لَهُ: تَزَوَّجْتُ ثَيِّبًا، قَالَ: أَفَلَا تَزَوَّجْتَ بِكْرًا تُلَاعِبُكَ وَتُلَاعِبُهَا؟، فَقُلْتُ لَهُ: يَا رَسُولَ اللَّهِ، تُوُفِّيَ وَالِدِي أَوِ اسْتُشْهِدَ وَلِي أَخَوَاتٌ صِغَارٌ، فَكَرِهْتُ أَنْ أَتَزَوَّجَ إِلَيْهِنَّ مِثْلَهُنَّ، فَلَا تُؤَدِّبُهُنَّ وَلَا تَقُومُ عَلَيْهِنَّ، فَتَزَوَّجْتُ ثَيِّبًا لِتَقُومَ عَلَيْهِنَّ وَتُؤَدِّبَهُنَّ، قَالَ: فَلَمَّا قَدِمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْمَدِينَةَ غَدَوْتُ إِلَيْهِ بِالْبَعِيرِ، فَأَعْطَانِي ثَمَنَهُ وَرَدَّهُ عَلَيَّ \""\""،nصحیح مسلم حدیث: 4100 عربی حدیث: 715""","Sahih","Sahih Muslim 4100","","","21. باب: اونٹ کا بیچنا اور سواری کی شرط کر لینا۔حلال (مال )حاصل کرنا اور شبہات سےبچناChapter: Taking that which is lawful and leaving that which is unclear"
"4101","حَدَّثَنَا عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا جَرِيرٌ ، عَنْ الْأَعْمَشِ ، عَنْ سَالِمِ بْنِ أَبِي الْجَعْدِ ، عَنْ جَابِرٍ ، قَالَ: أَقْبَلْنَا مِنْ مَكَّةَ إِلَى الْمَدِينَةِ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَاعْتَلَّ جَمَلِي وَسَاقَ الْحَدِيثَ بِقِصَّتِهِ وَفِيهِ، ثُمَّ قَالَ: \\"" لِي بِعْنِي جَمَلَكَ هَذَا، قَالَ: قُلْتُ: لَا بَلْ هُوَ لَكَ، قَالَ: لَا بَلْ بِعْنِيهِ، قَالَ: قُلْتُ: لَا بَلْ هُوَ لَكَ يَا رَسُولَ اللَّهِ، قَالَ: لَا بَلْ بِعْنِيهِ، قَالَ: قُلْتُ: فَإِنَّ لِرَجُلٍ عَلَيَّ أُوقِيَّةَ ذَهَبٍ فَهُوَ لَكَ بِهَا، قَالَ: قَدْ أَخَذْتُهُ، فَتَبَلَّغْ عَلَيْهِ إِلَى الْمَدِينَةِ، قَالَ: فَلَمَّا قَدِمْتُ الْمَدِينَةَ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِبِلَالٍ: \""\"" أَعْطِهِ أُوقِيَّةً مِنْ ذَهَبٍ وَزِدْهُ \""\"" قَالَ: فَأَعْطَانِي أُوقِيَّةً مِنْ ذَهَبٍ وَزَادَنِي قِيرَاطًا، قَالَ: فَقُلْتُ: لَا تُفَارِقُنِي زِيَادَةُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: فَكَانَ فِي كِيسٍ لِي فَأَخَذَهُ أَهْلُ الشَّامِ يَوْمَ الْحَرَّةِ،nصحیح مسلم حدیث: 4101 عربی حدیث: 715""","Sahih","Sahih Muslim 4101","","","21. باب: اونٹ کا بیچنا اور سواری کی شرط کر لینا۔حلال (مال )حاصل کرنا اور شبہات سےبچناChapter: Taking that which is lawful and leaving that which is unclear"
"4102","حَدَّثَنَا أَبُو كَامِلٍ الْجَحْدَرِيُّ ، حَدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ، حَدَّثَنَا الْجُرَيْرِيُّ ، عَنْ أَبِي نَضْرَةَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ: كُنَّا مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ، فَتَخَلَّفَ نَاضِحِي وَسَاقَ الْحَدِيثَ وَقَالَ: فِيهِ فَنَخَسَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، ثُمَّ قَالَ لِي: \\"" ارْكَبْ بِاسْمِ اللَّهِ \""\"" وَزَادَ أَيْضًا قَالَ: فَمَا زَالَ يَزِيدُنِي وَيَقُولُ: \""\"" وَاللَّهُ يَغْفِرُ لَكَ \""\"".nصحیح مسلم حدیث: 4102 عربی حدیث: 715""","Sahih","Sahih Muslim 4102","","","21. باب: اونٹ کا بیچنا اور سواری کی شرط کر لینا۔اونٹ فروخت کرنا اور (ایک خاص مقام تک)اس پر سوار ی کرمنے کو مستثنی ٰ کرناChapter: Selling Camels and Stipulating that one may ride them"
"4103","وحَدَّثَنِي أَبُو الرَّبِيعِ الْعَتَكِيُّ ، حَدَّثَنَا حَمَّادٌ ، حَدَّثَنَا أَيُّوبُ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ ، قَالَ: \\"" لَمَّا أَتَى عَلَيَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَقَدْ أَعْيَا بَعِيرِي، قَالَ: فَنَخَسَهُ، فَوَثَبَ فَكُنْتُ بَعْدَ ذَلِكَ أَحْبِسُ خِطَامَهُ لِأَسْمَعَ حَدِيثَهُ، فَمَا أَقْدِرُ عَلَيْهِ، فَلَحِقَنِي النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: بِعْنِيهِ، فَبِعْتُهُ مِنْهُ بِخَمْسِ أَوَاقٍ، قَالَ: قُلْتُ: عَلَى أَنَّ لِي ظَهْرَهُ إِلَى الْمَدِينَةِ، قَالَ: وَلَكَ ظَهْرُهُ إِلَى الْمَدِينَةِ، قَالَ: فَلَمَّا قَدِمْتُ الْمَدِينَةَ أَتَيْتُهُ بِهِ، فَزَادَنِي وُقِيَّةً ثُمَّ وَهَبَهُ لِي \""\""،nصحیح مسلم حدیث: 4103 عربی حدیث: 715""","Sahih","Sahih Muslim 4103","","","21. باب: اونٹ کا بیچنا اور سواری کی شرط کر لینا۔اونٹ فروخت کرنا اور (ایک خاص مقام تک)اس پر سوار ی کرمنے کو مستثنی ٰ کرناChapter: Selling Camels and Stipulating that one may ride them"
"4104","حَدَّثَنَا عُقْبَةُ بْنُ مُكْرَمٍ الْعَمِّيُّ ، حَدَّثَنَا يَعْقُوبُ بْنُ إِسْحَاق ، حَدَّثَنَا بَشِيرُ بْنُ عُقْبَةَ ، عَنْ أَبِي الْمُتَوَكِّلِ النَّاجِيِّ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ: سَافَرْتُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي بَعْضِ أَسْفَارِهِ أَظُنُّهُ، قَالَ: غَازِيًا وَاقْتَصَّ الْحَدِيثَ وَزَادَ فِيهِ، قَالَ: \\"" يَا جَابِرُ أَتَوَفَّيْتَ الثَّمَنَ؟ \""\"" قُلْتُ: نَعَمْ قَالَ: \""\"" لَكَ الثَّمَنُ وَلَكَ الْجَمَلُ لَكَ الثَّمَنُ وَلَكَ الْجَمَلُ \""\"".nصحیح مسلم حدیث: 4104 عربی حدیث: 715""","Sahih","Sahih Muslim 4104","","","21. باب: اونٹ کا بیچنا اور سواری کی شرط کر لینا۔اونٹ فروخت کرنا اور (ایک خاص مقام تک)اس پر سوار ی کرمنے کو مستثنی ٰ کرناChapter: Selling Camels and Stipulating that one may ride them"
"4105","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ الْعَنْبَرِيُّ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا شُعْبَةُ ، عَنْ مُحَارِبٍ : أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: \\"" اشْتَرَى مِنِّي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَعِيرًا بِوُقِيَّتَيْنِ وَدِرْهَمٍ أَوْ دِرْهَمَيْنِ، قَالَ: فَلَمَّا قَدِمَ صِرَارًا أَمَرَ بِبَقَرَةٍ، فَذُبِحَتْ فَأَكَلُوا مِنْهَا، فَلَمَّا قَدِمَ الْمَدِينَةَ أَمَرَنِي أَنْ آتِيَ الْمَسْجِدَ فَأُصَلِّيَ رَكْعَتَيْنِ وَوَزَنَ لِي ثَمَنَ الْبَعِيرِ، فَأَرْجَحَ لِي \""\""،nصحیح مسلم حدیث: 4105 عربی حدیث: 715""","Sahih","Sahih Muslim 4105","","","21. باب: اونٹ کا بیچنا اور سواری کی شرط کر لینا۔اونٹ فروخت کرنا اور (ایک خاص مقام تک)اس پر سوار ی کرمنے کو مستثنی ٰ کرناChapter: Selling Camels and Stipulating that one may ride them"
"4106","حَدَّثَنِي يَحْيَى بْنُ حَبِيبٍ الْحَارِثِيُّ ، حَدَّثَنَا خَالِدُ بْنُ الْحَارِثِ ، حَدَّثَنَا شُعْبَةُ ، أَخْبَرَنَا مُحَارِبٌ ، عَنْ جَابِرٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِهَذِهِ الْقِصَّةِ غَيْرَ أَنَّهُ، قَالَ: فَاشْتَرَاهُ مِنِّي بِثَمَنٍ قَدْ سَمَّاهُ وَلَمْ يَذْكُرِ الْوُقِيَّتَيْنِ وَالدِّرْهَمَ وَالدِّرْهَمَيْنِ، وَقَالَ: أَمَرَ بِبَقَرَةٍ، فَنُحِرَتْ ثُمَّ قَسَمَ لَحْمَهَا.nصحیح مسلم حدیث: 4106 عربی حدیث: 715","Sahih","Sahih Muslim 4106","","","21. باب: اونٹ کا بیچنا اور سواری کی شرط کر لینا۔اونٹ فروخت کرنا اور (ایک خاص مقام تک)اس پر سوار ی کرمنے کو مستثنی ٰ کرناChapter: Selling Camels and Stipulating that one may ride them"
"4107","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ حَدَّثَنَا ابْنُ أَبِي زَائِدَةَ ، عَنْ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، عَنْ جَابِرٍ : أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ لَهُ: \\"" قَدْ أَخَذْتُ جَمَلَكَ بِأَرْبَعَةِ دَنَانِيرَ وَلَكَ ظَهْرُهُ إِلَى الْمَدِينَةِ \""\"".nصحیح مسلم حدیث: 4107 عربی حدیث: 715""","Sahih","Sahih Muslim 4107","","","21. باب: اونٹ کا بیچنا اور سواری کی شرط کر لینا۔اونٹ فروخت کرنا اور (ایک خاص مقام تک)اس پر سوار ی کرمنے کو مستثنی ٰ کرناChapter: Selling Camels and Stipulating that one may ride them"
"4108","حَدَّثَنَا أَبُو الطَّاهِرِ أَحْمَدُ بْنُ عَمْرِو بْنِ سَرْحٍ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، عَنْ مَالِكِ بْنِ أَنَسٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، عَنْ أَبِي رَافِعٍ \\"" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اسْتَسْلَفَ مِنْ رَجُلٍ بَكْرًا، فَقَدِمَتْ عَلَيْهِ إِبِلٌ مِنْ إِبِلِ الصَّدَقَةِ، فَأَمَرَ أَبَا رَافِعٍ أَنْ يَقْضِيَ الرَّجُلَ بَكْرَهُ فَرَجَعَ إِلَيْهِ أَبُو رَافِعٍ، فَقَالَ: لَمْ أَجِدْ فِيهَا إِلَّا خِيَارًا رَبَاعِيًا، فَقَالَ: أَعْطِهِ إِيَّاهُ إِنَّ خِيَارَ النَّاسِ أَحْسَنُهُمْ قَضَاءً \""\""،nصحیح مسلم حدیث: 4108 عربی حدیث: 1600""","Sahih","Sahih Muslim 4108","","","22. باب: جانوروں کا قرض لینا درست ہے اور اس سے بہتر دینا مستحب ہے۔اونٹ فروخت کرنا اور (ایک خاص مقام تک)اس پر سوار ی کرمنے کو مستثنی ٰ کرناChapter: Selling Camels and Stipulating that one may ride them"
"4109","حَدَّثَنَا أَبُو كُرَيْبٍ ، حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ مُحَمَّدِ بْنِ جَعْفَرٍ ، سَمِعْتُ زَيْدَ بْنَ أَسْلَمَ ، أَخْبَرَنَا عَطَاءُ بْنُ يَسَارٍ ، عَنْ أَبِي رَافِعٍمَوْلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: اسْتَسْلَفَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَكْرًا بِمِثْلِهِ غَيْرَ أَنَّهُ، قَالَ: \\"" فَإِنَّ خَيْرَ عِبَادِ اللَّهِ أَحْسَنُهُمْ قَضَاءً \""\"".nصحیح مسلم حدیث: 4109 عربی حدیث: 1600""","Sahih","Sahih Muslim 4109","","","22. باب: جانوروں کا قرض لینا درست ہے اور اس سے بہتر دینا مستحب ہے۔نور ادھار لینا جائز ہے اور جو کسی کے ذمے ہے اس سے بہتر (جانور )دینا مستحب ہےChapter: It is permissible to lend animals and it is recommended to pay in full, giving something better than that which ts owed"
"4110","حَدَّثَنَا مُحَمَّدُ بْنُ بَشَّارِ بْنِ عُثْمَانَ الْعَبْدِيُّ ، حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: \\"" كَانَ لِرَجُلٍ عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَقٌّ فَأَغْلَظَ لَهُ، فَهَمَّ بِهِ أَصْحَابُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: إِنَّ لِصَاحِبِ الْحَقِّ مَقَالًا، فَقَالَ لَهُمْ: اشْتَرُوا لَهُ سِنًّا، فَأَعْطُوهُ إِيَّاهُ، فَقَالُوا: إِنَّا لَا نَجِدُ إِلَّا سِنًّا هُوَ خَيْرٌ مِنْ سِنِّهِ، قَالَ: فَاشْتَرُوهُ فَأَعْطُوهُ إِيَّاهُ، فَإِنَّ مِنْ خَيْرِكُمْ أَوْ خَيْرَكُمْ أَحْسَنُكُمْ قَضَاءً \""\"".nصحیح مسلم حدیث: 4110 عربی حدیث: 1601""","Sahih","Sahih Muslim 4110","","","22. باب: جانوروں کا قرض لینا درست ہے اور اس سے بہتر دینا مستحب ہے۔نور ادھار لینا جائز ہے اور جو کسی کے ذمے ہے اس سے بہتر (جانور )دینا مستحب ہےChapter: It is permissible to lend animals and it is recommended to pay in full, giving something better than that which ts owed"
"4111","حَدَّثَنَا أَبُو كُرَيْبٍ ، حَدَّثَنَا وَكِيعٌ ، عَنْ عَلِيِّ بْنِ صَالِحٍ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: \\"" اسْتَقْرَضَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سِنًّا، فَأَعْطَى سِنًّا فَوْقَهُ، وَقَالَ: خِيَارُكُمْ مَحَاسِنُكُمْ قَضَاءً \""\"".nصحیح مسلم حدیث: 4111 عربی حدیث: 1601""","Sahih","Sahih Muslim 4111","","","22. باب: جانوروں کا قرض لینا درست ہے اور اس سے بہتر دینا مستحب ہے۔نور ادھار لینا جائز ہے اور جو کسی کے ذمے ہے اس سے بہتر (جانور )دینا مستحب ہےChapter: It is permissible to lend animals and it is recommended to pay in full, giving something better than that which ts owed"
"4112","حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا سُفْيَانُ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: \\"" جَاءَ رَجُلٌ يَتَقَاضَى رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَعِيرًا، فَقَالَ: أَعْطُوهُ سِنًّا فَوْقَ سِنِّهِ، وَقَالَ: خَيْرُكُمْ أَحْسَنُكُمْ قَضَاءً \""\"".nصحیح مسلم حدیث: 4112 عربی حدیث: 1601""","Sahih","Sahih Muslim 4112","","","22. باب: جانوروں کا قرض لینا درست ہے اور اس سے بہتر دینا مستحب ہے۔نور ادھار لینا جائز ہے اور جو کسی کے ذمے ہے اس سے بہتر (جانور )دینا مستحب ہےChapter: It is permissible to lend animals and it is recommended to pay in full, giving something better than that which ts owed"
"4113","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى التَّمِيمِيُّ ، وَابْنُ رُمْحٍ ، قَالَا: أَخْبَرَنَا اللَّيْثُ ح، وحَدَّثَنِيهِ قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ ، قَالَ: \\"" جَاءَ عَبْدٌ فَبَايَعَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى الْهِجْرَةِ وَلَمْ يَشْعُرْ أَنَّهُ عَبْدٌ، فَجَاءَ سَيِّدُهُ يُرِيدُهُ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: بِعْنِيهِ فَاشْتَرَاهُ بِعَبْدَيْنِ أَسْوَدَيْنِ، ثُمَّ لَمْ يُبَايِعْ أَحَدًا بَعْدُ حَتَّى يَسْأَلَهُ أَعَبْدٌ هُوَ \""\"".nصحیح مسلم حدیث: 4113 عربی حدیث: 1602""","Sahih","Sahih Muslim 4113","","","23. باب: جانور کو جانور کے بدل کم زیادہ بیچنا درست ہے۔نور ادھار لینا جائز ہے اور جو کسی کے ذمے ہے اس سے بہتر (جانور )دینا مستحب ہےChapter: It is permissible to lend animals and it is recommended to pay in full, giving something better than that which ts owed"
"4114","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، وَأَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَمُحَمَّدُ بْنُ الْعَلَاءِ وَاللَّفْظُ لِيَحْيَى، قَالَ يَحْيَى: أَخْبَرَنَا، وَقَالَ الْآخَرَانِ، حَدَّثَنَا أَبُو مُعَاوِيَةَ ، عَنْ الْأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ الْأَسْوَدِ ، عَنْ عَائِشَةَ ، قَالَتْ: \\"" اشْتَرَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ يَهُودِيٍّ طَعَامًا بِنَسِيئَةٍ، فَأَعْطَاهُ دِرْعًا لَهُ رَهْنًا \""\"".nصحیح مسلم حدیث: 4114 عربی حدیث: 1603""","Sahih","Sahih Muslim 4114","","","24. باب: گروی رکھنا سفر اور حضر دونوں میں جائز ہے۔ایک جاندار کی اسی جنس کے جانور کے عوض کمی بیشی کےساتھ بیع جائز ہےChapter: The permissibility of selling animals for animals of the same kind and of different quality"
"4115","حَدَّثَنَا إِسْحَاق بْنُ إِبْرَاهِيمَ الْحَنْظَلِيُّ ، وَعَلِيُّ بْنُ خَشْرَمٍ ، قَالَا: أَخْبَرَنَا عِيسَى بْنُ يُونُسَ ، عَنْ الْأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ الْأَسْوَدِ ، عَنْ عَائِشَةَ ، قَالَتْ: \\"" اشْتَرَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ يَهُودِيٍّ طَعَامًا وَرَهَنَهُ دِرْعًا مِنْ حَدِيدٍ \""\"".nصحیح مسلم حدیث: 4115 عربی حدیث: 1603""","Sahih","Sahih Muslim 4115","","","24. باب: گروی رکھنا سفر اور حضر دونوں میں جائز ہے۔گردی رکھنا اور سفر کی طرح حضر میں بھی اس کا جوازChapter: Pawning (Rahn) and its permissibility whether one is travelling or not"
"4116","حَدَّثَنَا إِسْحَاق بْنُ إِبْرَاهِيمَ الْحَنْظَلِيُّ ، أَخْبَرَنَا الْمَخْزُومِيُّ ، حَدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ، عَنْ الْأَعْمَشِ ، قَالَ: ذَكَرْنَا الرَّهْنَ فِي السَّلَمِ عِنْدَ إِبْرَاهِيمَ النَّخَعِيِّ ، فَقَالَ: حَدَّثَنَا الْأَسْوَدُ بْنُ يَزِيدَ ، عَنْ عَائِشَةَ \\"" أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اشْتَرَى مِنْ يَهُودِيٍّ طَعَامًا إِلَى أَجَلٍ، وَرَهَنَهُ دِرْعًا لَهُ مِنْ حَدِيدٍ \""\""،nصحیح مسلم حدیث: 4116 عربی حدیث: 1603""","Sahih","Sahih Muslim 4116","","","24. باب: گروی رکھنا سفر اور حضر دونوں میں جائز ہے۔گردی رکھنا اور سفر کی طرح حضر میں بھی اس کا جوازChapter: Pawning (Rahn) and its permissibility whether one is travelling or not"
"4117","وحَدَّثَنَاه أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا حَفْصُ بْنُ غِيَاثٍ ، عَنْ الْأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، قَالَ: حَدَّثَنِي الْأَسْوَدُ ، عَنْ عَائِشَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ وَلَمْ يَذْكُرْ مِنْ حَدِيدٍ.nصحیح مسلم حدیث: 4117 عربی حدیث: 1603","Sahih","Sahih Muslim 4117","","","24. باب: گروی رکھنا سفر اور حضر دونوں میں جائز ہے۔گردی رکھنا اور سفر کی طرح حضر میں بھی اس کا جوازChapter: Pawning (Rahn) and its permissibility whether one is travelling or not"
"4118","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى وَاللَّفْظُ لِيَحْيَى، وَعَمْرٌو النَّاقِدُ ، قَالَ عَمْرٌو، حَدَّثَنَا، وَقَالَ يَحْيَى: أَخْبَرَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ ابْنِ أَبِي نَجِيحٍ ، عَنْ عَبْدِ اللَّهِ بْنِ كَثِيرٍ ، عَنْ أَبِي الْمِنْهَالِ ، عَنْ ابْنِ عَبَّاسٍ ، قَالَ: \\"" قَدِمَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْمَدِينَةَ وَهُمْ يُسْلِفُونَ فِي الثِّمَارِ السَّنَةَ وَالسَّنَتَيْنِ، فَقَالَ: مَنْ أَسْلَفَ فِي تَمْرٍ، فَلْيُسْلِفْ فِي كَيْلٍ مَعْلُومٍ وَوَزْنٍ مَعْلُومٍ إِلَى أَجَلٍ مَعْلُومٍ \""\"".nصحیح مسلم حدیث: 4118 عربی حدیث: 1604""","Sahih","Sahih Muslim 4118","","","25. باب: بیع سلم کا بیان۔گردی رکھنا اور سفر کی طرح حضر میں بھی اس کا جوازChapter: Pawning (Rahn) and its permissibility whether one is travelling or not"
"4119","حَدَّثَنَا شَيْبَانُ بْنُ فَرُّوخَ ، حَدَّثَنَا عَبْدُ الْوَارِثِ ، عَنْ ابْنِ أَبِي نَجِيحٍ ، حَدَّثَنِي عَبْدُ اللَّهِ بْنُ كَثِيرٍ ، عَنْ أَبِي الْمِنْهَالِ ، عَنْ ابْنِ عَبَّاسٍ ، قَالَ: قَدِمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَالنَّاسُ يُسْلِفُونَ، فَقَالَ لَهُمْ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنْ أَسْلَفَ فَلَا يُسْلِفْ إِلَّا فِي كَيْلٍ مَعْلُومٍ وَوَزْنٍ مَعْلُومٍ \""\""،nصحیح مسلم حدیث: 4119 عربی حدیث: 1604""","Sahih","Sahih Muslim 4119","","","25. باب: بیع سلم کا بیان۔بیع سلمChapter: Salam (Payment in Advance)"
"4120","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، وَأَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَإِسْمَاعِيل بْنُ سَالِمٍ جَمِيعًا، عَنْ ابْنِ عُيَيْنَةَ ، عَنْ ابْنِ أَبِي نَجِيحٍ بِهَذَا الْإِسْنَادِ مِثْلَ حَدِيثِ عَبْدِ الْوَارِثِ وَلَمْ يَذْكُرْ إِلَى أَجَلٍ مَعْلُومٍ،nصحیح مسلم حدیث: 4120 عربی حدیث: 1604","Sahih","Sahih Muslim 4120","","","25. باب: بیع سلم کا بیان۔بیع سلمChapter: Salam (Payment in Advance)"
"4121","وحدثنا أَبُو كُرَيْبٍ ، وَابْنُ أَبِي عُمَرَ ، قَالَا: حَدَّثَنَا وَكِيعٌ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ بَشَّارٍ ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ كِلَاهُمَا، عَنْ سُفْيَانَ ، عَنْ ابْنِ أَبِي نَجِيحٍ بِإِسْنَادِهِمْ مِثْلَ حَدِيثِ ابْنِ عُيَيْنَةَ يَذْكُرُ فِيهِ إِلَى أَجَلٍ مَعْلُومٍ.nصحیح مسلم حدیث: 4121 عربی حدیث: 1604","Sahih","Sahih Muslim 4121","","","25. باب: بیع سلم کا بیان۔بیع سلمChapter: Salam (Payment in Advance)"
"4122","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ بْنِ قَعْنَبٍ ، حَدَّثَنَا سُلَيْمَانُ يَعْنِي ابْنَ بِلَالٍ ، عَنْ يَحْيَى وَهُوَ ابْنُ سَعِيدٍ ، قَالَ: كَانَ سَعِيدُ بْنُ الْمُسَيِّبِ يُحَدِّثُ: أَنَّ مَعْمَرًا قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنِ احْتَكَرَ، فَهُوَ خَاطِئٌ \""\"" فَقِيلَ لِسَعِيدٍ: فَإِنَّكَ تَحْتَكِرُ، قَالَ سَعِيدٌ: إِنَّ مَعْمَرًا الَّذِي كَانَ يُحَدِّثُ هَذَا الْحَدِيثَ كَانَ يَحْتَكِرُ.nصحیح مسلم حدیث: 4122 عربی حدیث: 1605""","Sahih","Sahih Muslim 4122","","","26. باب: احتکار انسان اور حیوان کی خورک میں حرام ہے۔بیع سلمChapter: Salam (Payment in Advance)"
"4123","حَدَّثَنَا سَعِيدُ بْنُ عَمْرٍو الْأَشْعَثِيُّ ، حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِيل ، عَنْ مُحَمَّدِ بْنِ عَجْلَانَ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، عَنْ مَعْمَرِ بْنِ عَبْدِ اللَّهِ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لَا يَحْتَكِرُ إِلَّا خَاطِئٌ \""\""،nصحیح مسلم حدیث: 4123 عربی حدیث: 1605""","Sahih","Sahih Muslim 4123","","","26. باب: احتکار انسان اور حیوان کی خورک میں حرام ہے۔غذائی اشیاء میں ذخیرہ اندوزی حرام ہےChapter: The prohibition of hoarding staple foods"
"4124","قَالَ إِبْرَاهِيمُ: قَالَ مُسْلِم: وحَدَّثَنِي بَعْضُ أَصْحَابِنَا عَنْ عَمْرِو بْنِ عَوْنٍ ، أَخْبَرَنَا خَالِدُ بْنُ عَبْدِ اللَّهِ ، عَنْ عَمْرِو بْنِ يَحْيَى ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، عَنْ مَعْمَرِ بْنِ أَبِي مَعْمَرٍ أَحَدِ بَنِي عَدِيِّ بْنِ كَعْبٍ قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَذَكَرَ بِمِثْلِ حَدِيثِ سُلَيْمَانَ بْنِ بِلَالٍ عَنْ يَحْيَى.nصحیح مسلم حدیث: 4124 عربی حدیث: 1605","Sahih","Sahih Muslim 4124","","","26. باب: احتکار انسان اور حیوان کی خورک میں حرام ہے۔غذائی اشیاء میں ذخیرہ اندوزی حرام ہےChapter: The prohibition of hoarding staple foods"
"4125","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا أَبُو صَفْوَانَ الْأُمَوِيُّ . ح وحَدَّثَنِي أَبُو الطَّاهِرِ ، وَحَرْمَلَةُ بْنُ يَحْيَى ، قَالَا: أَخْبَرَنَا ابْنُ وَهْبٍ كِلَاهُمَا، عَنْ يُونُسَ ، عَنْ ابْنِ شِهَابٍ ، عَنْ ابْنِ الْمُسَيَّبِ : أَنَّ أَبَا هُرَيْرَةَ ، قَالَ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" الْحَلِفُ مَنْفَقَةٌ لِلسِّلْعَةِ مَمْحَقَةٌ لِلرِّبْحِ \""\"".nصحیح مسلم حدیث: 4125 عربی حدیث: 1606""","Sahih","Sahih Muslim 4125","","","27. باب: بیع میں قسم کھانے کی ممانعت۔غذائی اشیاء میں ذخیرہ اندوزی حرام ہےChapter: The prohibition of hoarding staple foods"
"4126","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، وَإِسْحَاق بْنُ إِبْرَاهِيمَ ، وَاللَّفْظُ لِابْنِ أَبِي شَيْبَةَ، قَالَ إِسْحَاق: أَخْبَرَنَا، وَقَالَ الْآخَرَانِ، حَدَّثَنَا أَبُو أُسَامَةَ ، عَنْ الْوَلِيدِ بْنِ كَثِيرٍ ، عَنْ مَعْبَدِ بْنِ كَعْبِ بْنِ مَالِكٍ ، عَنْ أَبِي قَتَادَةَ الْأَنْصَارِيِّ : أَنَّهُ سَمِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" إِيَّاكُمْ وَكَثْرَةَ الْحَلِفِ فِي الْبَيْعِ، فَإِنَّهُ يُنَفِّقُ ثُمَّ يَمْحَقُ \""\"".nصحیح مسلم حدیث: 4126 عربی حدیث: 1607""","Sahih","Sahih Muslim 4126","","","27. باب: بیع میں قسم کھانے کی ممانعت۔بیع میں قسم اٹھانے کی ممانعتChapter: The prohibition of swearing oaths when selling"
"4127","حَدَّثَنَا أَحْمَدُ بْنُ يُونُسَ ، حَدَّثَنَا زُهَيْرٌ ، حَدَّثَنَا أَبُو الزُّبَيْرِ ، عَنْ جَابِرٍ . ح وحَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، أَخْبَرَنَا أَبُو خَيْثَمَةَ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" مَنْ كَانَ لَهُ شَرِيكٌ فِي رَبْعَةٍ أَوْ نَخْلٍ، فَلَيْسَ لَهُ أَنْ يَبِيعَ حَتَّى يُؤْذِنَ شَرِيكَهُ، فَإِنْ رَضِيَ أَخَذَ وَإِنْ كَرِهَ تَرَكَ \""\"".nصحیح مسلم حدیث: 4127 عربی حدیث: 1608""","Sahih","Sahih Muslim 4127","","","28. باب: شفعہ کا بیان۔بیع میں قسم اٹھانے کی ممانعتChapter: The prohibition of swearing oaths when selling"
"4128","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَمُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، وَإِسْحَاق بْنُ إِبْرَاهِيمَ وَاللَّفْظُ لِابْنِ نُمَيْرٍ، قَالَ إِسْحَاق: أَخْبَرَنَا، وَقَالَ الْآخَرَانِ، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ إِدْرِيسَ ، حَدَّثَنَا ابْنُ جُرَيْجٍ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ ، قَالَ: \\"" قَضَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالشُّفْعَةِ فِي كُلِّ شِرْكَةٍ لَمْ تُقْسَمْ رَبْعَةٍ أَوْ حَائِطٍ لَا يَحِلُّ لَهُ أَنْ يَبِيعَ حَتَّى يُؤْذِنَ شَرِيكَهُ، فَإِنْ شَاءَ أَخَذَ وَإِنْ شَاءَ تَرَكَ، فَإِذَا بَاعَ وَلَمْ يُؤْذِنْهُ فَهُوَ أَحَقُّ بِهِ \""\"".nصحیح مسلم حدیث: 4128 عربی حدیث: 1608""","Sahih","Sahih Muslim 4128","","","28. باب: شفعہ کا بیان۔شفعہChapter: Pre-emption"
"4129","وحَدَّثَنِي أَبُو الطَّاهِرِ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، عَنْ ابْنِ جُرَيْجٍ : أَنَّ أَبَا الزُّبَيْرِ أَخْبَرَهُ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" الشُّفْعَةُ فِي كُلِّ شِرْكٍ فِي أَرْضٍ أَوْ رَبْعٍ أَوْ حَائِطٍ لَا يَصْلُحُ أَنْ يَبِيعَ حَتَّى يَعْرِضَ عَلَى شَرِيكِهِ، فَيَأْخُذَ أَوْ يَدَعَ، فَإِنْ أَبَى فَشَرِيكُهُ أَحَقُّ بِهِ حَتَّى يُؤْذِنَهُ \""\"".nصحیح مسلم حدیث: 4129 عربی حدیث: 1608""","Sahih","Sahih Muslim 4129","","","28. باب: شفعہ کا بیان۔شفعہChapter: Pre-emption"
"4130","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ ابْنِ شِهَابٍ ، عَنْ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ : أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لَا يَمْنَعْ أَحَدُكُمْ جَارَهُ أَنْ يَغْرِزَ خَشَبَةً فِي جِدَارِهِ \""\""، قَالَ ثُمَّ يَقُولُ أَبُو هُرَيْرَةَ: مَا لِي أَرَاكُمْ عَنْهَا مُعْرِضِينَ، وَاللَّهِ لَأَرْمِيَنَّ بِهَا بَيْنَ أَكْتَافِكُمْ،nصحیح مسلم حدیث: 4130 عربی حدیث: 1609""","Sahih","Sahih Muslim 4130","","","29. باب: ہمسایہ کی دیوار میں لکڑی گاڑنا۔شفعہChapter: Pre-emption"
"4131","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ . ح وحَدَّثَنِي أَبُو الطَّاهِرِ ، وَحَرْمَلَةُ بْنُ يَحْيَى ، قَالَا: أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ . ح وحَدَّثَنَا عَبْدُ بْنُ حُمَيْدٍ ، أَخْبَرَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ كُلُّهُمْ، عَنْ الزُّهْرِيِّ بِهَذَا الْإِسْنَادِ نَحْوَهُ.nصحیح مسلم حدیث: 4131 عربی حدیث: 1609","Sahih","Sahih Muslim 4131","","","29. باب: ہمسایہ کی دیوار میں لکڑی گاڑنا۔پڑوسی کی دیوار میں شہتیر رکھناChapter: Fixing a piece of wood to a neighbor's wall"
"4132","حَدَّثَنَا يَحْيَى بْنُ أَيُّوبَ ، وَقُتَيْبَةُ بْنُ سَعِيدٍ ، وَعَلِيُّ بْنُ حُجْرٍ ، قَالُوا: حَدَّثَنَا إِسْمَاعِيل وَهُوَ ابْنُ جَعْفَرٍ ، عَنْ الْعَلَاءِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبَّاسِ بْنِ سَهْلِ بْنِ سَعْدٍ السَّاعِدِيِّ ، عَنْ سَعِيدِ بْنِ زَيْدِ بْنِ عَمْرِو بْنِ نُفَيْلٍ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" مَنِ اقْتَطَعَ شِبْرًا مِنَ الْأَرْضِ ظُلْمًا، طَوَّقَهُ اللَّهُ إِيَّاهُ يَوْمَ الْقِيَامَةِ مِنْ سَبْعِ أَرَضِينَ \""\"".nصحیح مسلم حدیث: 4132 عربی حدیث: 1610""","Sahih","Sahih Muslim 4132","","","30. باب: ظلم کرنا اور دوسرے کی زمین چھیننا حرام ہے۔پڑوسی کی دیوار میں شہتیر رکھناChapter: Fixing a piece of wood to a neighbor's wall"
"4133","حَدَّثَنِي حَرْمَلَةُ بْنُ يَحْيَى ، أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، حَدَّثَنِي عُمَرُ بْنُ مُحَمَّدٍ : أَنَّ أَبَاهُ حَدَّثَهُ، عَنْ سَعِيدِ بْنِ زَيْدِ بْنِ عَمْرِو بْنِ نُفَيْلٍ ، أَنَّ أَرْوَى خَاصَمَتْهُ فِي بَعْضِ دَارِهِ فَقَالَ: دَعُوهَا وَإِيَّاهَا فَإِنِّي، سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" مَنْ أَخَذَ شِبْرًا مِنَ الْأَرْضِ بِغَيْرِ حَقِّهِ، طُوِّقَهُ فِي سَبْعِ أَرَضِينَ يَوْمَ الْقِيَامَةِ \""\"" اللَّهُمَّ إِنْ كَانَتْ كَاذِبَةً فَأَعْمِ بَصَرَهَا وَاجْعَلْ قَبْرَهَا فِي دَارِهَا، قَالَ: فَرَأَيْتُهَا عَمْيَاءَ تَلْتَمِسُ الْجُدُرَ، تَقُولُ: أَصَابَتْنِي دَعْوَةُ سَعِيدِ بْنِ زَيْدٍ، فَبَيْنَمَا هِيَ تَمْشِي فِي الدَّارِ مَرَّتْ عَلَى بِئْرٍ فِي الدَّارِ، فَوَقَعَتْ فِيهَا فَكَانَتْ قَبْرَهَا.nصحیح مسلم حدیث: 4133 عربی حدیث: 1610""","Sahih","Sahih Muslim 4133","","","30. باب: ظلم کرنا اور دوسرے کی زمین چھیننا حرام ہے۔ظلم کرنے اور زمین وغیرہ کو غصب کرنے کی حرمتChapter: The prohibition of wrongdoing, seizing land unlawfully etc"
"4134","حَدَّثَنَا أَبُو الرَّبِيعِ الْعَتَكِيُّ ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ : \\"" أَنَّ أَرْوَى بِنْتَ أُوَيْسٍ ادَّعَتْ عَلَى سَعِيدِ بْنِ زَيْدٍ أَنَّهُ أَخَذَ شَيْئًا مِنْ أَرْضِهَا، فَخَاصَمَتْهُ إِلَى مَرْوَانَ بْنِ الْحَكَمِ فَقَالَ سَعِيدٌ : أَنَا كُنْتُ آخُذُ مِنْ أَرْضِهَا شَيْئًا بَعْدَ الَّذِي سَمِعْتُ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: وَمَا سَمِعْتَ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: مَنْ أَخَذَ شِبْرًا مِنَ الْأَرْضِ ظُلْمًا، طُوِّقَهُ إِلَى سَبْعِ أَرَضِينَ، فَقَالَ لَهُ مَرْوَانُ: لَا أَسْأَلُكَ بَيِّنَةً بَعْدَ هَذَا، فَقَالَ: اللَّهُمَّ إِنْ كَانَتْ كَاذِبَةً فَعَمِّ بَصَرَهَا وَاقْتُلْهَا فِي أَرْضِهَا، قَالَ: فَمَا مَاتَتْ حَتَّى ذَهَبَ بَصَرُهَا، ثُمَّ بَيْنَا هِيَ تَمْشِي فِي أَرْضِهَا إِذْ وَقَعَتْ فِي حُفْرَةٍ فَمَاتَتْ \""\"".nصحیح مسلم حدیث: 4134 عربی حدیث: 1610""","Sahih","Sahih Muslim 4134","","","30. باب: ظلم کرنا اور دوسرے کی زمین چھیننا حرام ہے۔ظلم کرنے اور زمین وغیرہ کو غصب کرنے کی حرمتChapter: The prohibition of wrongdoing, seizing land unlawfully etc"
"4135","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ حَدَّثَنَا يَحْيَى بْنُ زَكَرِيَّاءَ بْنِ أَبِي زَائِدَةَ ، عَنْ هِشَامٍ ، عَنْ أَبِيهِ ، عَنْ سَعِيدِ بْنِ زَيْدٍ ، قَالَ: سَمِعْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" مَنْ أَخَذَ شِبْرًا مِنَ الْأَرْضِ ظُلْمًا، فَإِنَّهُ يُطَوَّقُهُ يَوْمَ الْقِيَامَةِ مِنْ سَبْعِ أَرَضِينَ \""\"".nصحیح مسلم حدیث: 4135 عربی حدیث: 1610""","Sahih","Sahih Muslim 4135","","","30. باب: ظلم کرنا اور دوسرے کی زمین چھیننا حرام ہے۔ظلم کرنے اور زمین وغیرہ کو غصب کرنے کی حرمتChapter: The prohibition of wrongdoing, seizing land unlawfully etc"
"4136","وحَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا جَرِيرٌ ، عَنْ سُهَيْلٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" لَا يَأْخُذُ أَحَدٌ شِبْرًا مِنَ الْأَرْضِ بِغَيْرِ حَقِّهِ، إِلَّا طَوَّقَهُ اللَّهُ إِلَى سَبْعِ أَرَضِينَ يَوْمَ الْقِيَامَةِ \""\"".nصحیح مسلم حدیث: 4136 عربی حدیث: 1611""","Sahih","Sahih Muslim 4136","","","30. باب: ظلم کرنا اور دوسرے کی زمین چھیننا حرام ہے۔ظلم کرنے اور زمین وغیرہ کو غصب کرنے کی حرمتChapter: The prohibition of wrongdoing, seizing land unlawfully etc"
"4137","حَدَّثَنَا أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ، حَدَّثَنَا عَبْدُ الصَّمَدِ يَعْنِي ابْنَ عَبْدِ الْوَارِثِ ، حَدَّثَنَا حَرْبٌ وَهُوَ ابْنُ شَدَّادٍ ، حَدَّثَنَا يَحْيَى وَهُوَ ابْنُ أَبِي كَثِيرٍ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ : أَنَّ أَبَا سَلَمَةَ حَدَّثَهُ \\"" وَكَانَ بَيْنَهُ وَبَيْنَ قَوْمِهِ خُصُومَةٌ فِي أَرْضٍ، وَأَنَّهُ دَخَلَ عَلَى عَائِشَةَ فَذَكَرَ ذَلِكَ لَهَا، فَقَالَتْ: يَا أَبَا سَلَمَةَ اجْتَنِبْ الْأَرْضَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \""\"" مَنْ ظَلَمَ قِيدَ شِبْرٍ مِنَ الْأَرْضِ، طُوِّقَهُ مِنْ سَبْعِ أَرَضِينَ \""\""،nصحیح مسلم حدیث: 4137 عربی حدیث: 1612""","Sahih","Sahih Muslim 4137","","","30. باب: ظلم کرنا اور دوسرے کی زمین چھیننا حرام ہے۔ظلم کرنے اور زمین وغیرہ کو غصب کرنے کی حرمتChapter: The prohibition of wrongdoing, seizing land unlawfully etc"
"4138","وحَدَّثَنِي إِسْحَاق بْنُ مَنْصُورٍ ، أَخْبَرَنَا حَبَّانُ بْنُ هِلَالٍ ، أَخْبَرَنَا أَبَانُ ، حَدَّثَنَا يَحْيَى : أَنَّ مُحَمَّدَ بْنَ إِبْرَاهِيمَ حَدَّثَهُ: أَنَّ أَبَا سَلَمَةَ حَدَّثَهُ: أَنَّهُ دَخَلَ عَلَى عَائِشَةَ فَذَكَرَ مِثْلَهُ.nصحیح مسلم حدیث: 4138 عربی حدیث: 1612","Sahih","Sahih Muslim 4138","","","30. باب: ظلم کرنا اور دوسرے کی زمین چھیننا حرام ہے۔ظلم کرنے اور زمین وغیرہ کو غصب کرنے کی حرمتChapter: The prohibition of wrongdoing, seizing land unlawfully etc"
"4139","حَدَّثَنِي أَبُو كَامِلٍ فُضَيْلُ بْنُ حُسَيْنٍ الْجَحْدَرِيُّ ، حَدَّثَنَا عَبْدُ الْعَزِيزِ بْنُ الْمُخْتَارِ ، حَدَّثَنَا خَالِدٌ الْحَذَّاءُ ، عَنْ يُوسُفَ بْنِ عَبْدِ اللَّهِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" إِذَا اخْتَلَفْتُمْ فِي الطَّرِيقِ جُعِلَ عَرْضُهُ سَبْعَ أَذْرُعٍ \""\"".nصحیح مسلم حدیث: 4139 عربی حدیث: 1613""","Sahih","Sahih Muslim 4139","","","31. باب: جب راہ میں اختلاف ہو تو کتنی راہ رکھنا چاہیئے۔ظلم کرنے اور زمین وغیرہ کو غصب کرنے کی حرمتChapter: The prohibition of wrongdoing, seizing land unlawfully etc"
