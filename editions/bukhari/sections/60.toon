hadiths[55]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3429","حَدَّثَنِي إِسْحَاقُ ، أَخْبَرَنَا عِيسَى بْنُ يُونُسَ ، حَدَّثَنَا الْأَعْمَشُ ، عَنْ إِبْرَاهِيمَ","Default: Sahih","Book 60"," Hadith 100","3429",""
"3430","حَدَّثَنَا هُدْبَةُ بْنُ خَالِدٍ ، حَدَّثَنَا هَمَّامُ بْنُ يَحْيَى ، حَدَّثَنَا قَتَادَةُ ، عَنْ أَ","Default: Sahih","takhreej: ‏ {‏ واضرب لهم مثلا أصحاب القرية‏}‏ الآية ‏ {‏ فعززنا‏}‏ قال مجاهد شددنا‏.‏ وقال ابن عباس ‏ {‏ طائركم‏}‏ مصائبكم‏.‏ قول الله تعالى ‏ {‏ ذكر رحمة ربك عبده زكرياء * إذ نادى ربه نداء خفيا * قال رب إني وهن العظم مني واشتعل الرأس شيبا‏}‏ إلى قوله ‏ {‏ لم نجعل له من قبل سميا‏}‏ إلى قوله ‏ {‏ لم نجعل له من قبل سميا‏}‏ قال ابن عباس مثلا‏.‏ يقال رضيا مرضيا عتيا عصيا يعتو ‏ {‏ قال رب أنى يكون لي غلام‏}‏ إلى قوله ‏ {‏ ثلاث ليال سويا‏}‏ ويقال صحيحا ،‏‏‏‏ ‏‏‏‏ ‏ {‏ فخرج على قومه من المحراب فأوحى إليهم أن سبحوا بكرة وعشيا‏}‏ ‏ {‏ فأوحى‏}‏ فأشار ‏ {‏ يا يحيى خذ الكتاب بقوة‏}‏ إلى قوله ‏ {‏ ويوم يبعث حيا‏}‏ ‏ {‏ حفيا‏}‏ لطيفا ‏ {‏ عاقرا‏}‏ الذكر والأنثى سواء‏.","3430","","Prophets"
"3431","حَدَّثَنَا أَبُو الْيَمَانِ ، أَخْبَرَنَا شُعَيْبٌ عَنْ الزُّهْرِيِّ ، قَالَ : حَدَّثَنِي سَعِيدُ بْ","Default: Sahih","takhreej: قول الله تعالى ‏ {‏ واذكر في الكتاب مريم إذ انتبذت من أهلها مكانا شرقيا‏}‏ ‏ {‏ إذ قالت الملائكة يا مريم إن الله يبشرك بكلمة‏}‏‏.‏ ‏ {‏ إن الله اصطفى آدم ونوحا وآل إبراهيم وآل عمران على العالمين‏}‏ إلى قوله ‏ {‏ يرزق من يشاء بغير حساب‏} قال ابن عباس وآل عمران المؤمنون من آل إبراهيم ،‏‏‏‏ ‏‏‏‏ وآل عمران ،‏‏‏‏ ‏‏‏‏ وآل ياسين ،‏‏‏‏ ‏‏‏‏ وآل محمد صلى الله عليه وسلم يقول ‏ {‏ إن أولى الناس بإبراهيم للذين اتبعوه‏}‏ وهم المؤمنون ،‏‏‏‏ ‏‏‏‏ ويقال آل يعقوب ،‏‏‏‏ ‏‏‏‏ أهل يعقوب‏.‏ فإذا صغروا ‏ {‏ آل‏}‏ ثم ردوه إلى الأصل قالوا أهيل‏.","3431","","Prophets"
"3432","حَدَّثَنِي أَحْمَدُ بْنُ أَبِي رَجَاءٍ ، حَدَّثَنَا النَّضْرُ ، عَنْ هِشَامٍ ، قَالَ : أَخْبَرَنِي أ","Default: Sahih","takhreej: {‏ وإذ قالت الملائكة يا مريم إن الله اصطفاك وطهرك واصطفاك على نساء العالمين‏}‏ ‏ {‏ يا مريم اقنتي لربك واسجدي واركعي مع الراكعين * ذلك من أنباء الغيب نوحيه إليك وما كنت لديهم إذ يلقون أقلامهم أيهم يكفل مريم وما كنت لديهم إذ يختصمون‏}‏ يقال يكفل يضم ،‏‏‏‏ ‏‏‏‏ كفلها ضمها ،‏‏‏‏ ‏‏‏‏ مخففة ليس من كفالة الديون وشبهها","3432","","Prophets"
"3433","حَدَّثَنَا آدَمُ ، حَدَّثَنَا شُعْبَةُ ، عَنْ عَمْرِو بْنِ مُرَّةَ ، قَالَ : سَمِعْتُ مُرَّةَ الْهَم","Default: Sahih","takhreej: ‏ {‏ فإنما يقول له كن فيكون‏}‏ {‏ يبشرك‏}‏ ويبشرك واحد ‏ {‏ وجيها‏}‏ شريفا‏.‏ وقال إبراهيم المسيح الصديق‏.‏ وقال مجاهد الكهل الحليم ،‏‏‏‏ ‏‏‏‏ والأكمه من يبصر بالنهار ولا يبصر بالليل‏.‏ وقال غيره من يولد أعمى‏.‏","3433","","Prophets"
"3434","وَقَالَ ابْنُ وَهْبٍ : أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، قَالَ : حَدَّثَنِي سَعِيدُ بْنُ ال","Default: Sahih","Book 60"," Hadith 105","3434",""
"3435","حَدَّثَنَا صَدَقَةُ بْنُ الْفَضْلِ ، حَدَّثَنَا الْوَلِيدُ ، عَنْ الْأَوْزَاعِيِّ ، قَالَ : حَدَّثَن","Default: Sahih","takhreej: { ولا تقولوا على الله إلا الحق إنما المسيح عيسى ابن مريم رسول الله وكلمته ألقاها إلى مريم روح منه فآمنوا بالله ورسله ولا تقولوا ثلاثة انتهوا خيرا لكم إنما الله إله واحد سبحانه أن يكون له ولد له ما في السماوات وما في الأرض وكفى بالله وكيلا} النساء: 171 . قال أبو عبيد: {كلمته} كن فكان. وقال غيره: {وروح منه} أحياه فجعله روحا. {ولا تقولوا ثلاثة}.","3435","","Prophets"
"3436","حَدَّثَنَا مُسْلِمُ بْنُ إِبْرَاهِيمَ ، حَدَّثَنَا جَرِيرُ بْنُ حَازِمٍ ، عَنْ مُحَمَّدِ بْنِ سِيرِي","Default: Sahih","takhreej: ‏ {‏ واذكر في الكتاب مريم إذ انتبذت من أهلها‏}‏ نبذناه ألقيناه‏.‏ اعتزلت ‏ {‏ شرقيا‏}‏ مما يلي الشرق ‏ {‏ فأجاءها‏}‏ أفعلت من جئت ،‏‏‏‏ ‏‏‏‏ ويقال ألجأها اضطرها‏.‏ ‏ {‏ تساقط‏}‏ تسقط ‏ {‏ قصيا‏}‏ قاصيا ‏ {‏ فريا‏}‏ عظيما‏.‏ قال ابن عباس ‏ {‏ نسيا‏}‏ لم أكن شيئا‏.‏ وقال غيره النسى الحقير‏.‏ وقال أبو وائل علمت مريم أن التقي ذو نهية حين قالت ‏ {‏ إن كنت تقيا‏}‏‏.‏ قال وكيع عن إسرائيل ،‏‏‏‏ ‏‏‏‏ عن أبي إسحاق ،‏‏‏‏ ‏‏‏‏ عن البراء ،‏‏‏‏ ‏‏‏‏ ‏ {‏ سريا‏}‏ نهر صغير بالسريانية‏.","3436","","Prophets"
"3437","حَدَّثَنِي إِبْرَاهِيمُ بْنُ مُوسَى ، أَخْبَرَنَا هِشَامٌ ، عَنْ مَعْمَرٍ وَحَدَّثَنِي مَحْمُودٌ ، ح","Default: Sahih","Book 60"," Hadith 108","3437",""
"3438","حَدَّثَنَا مُحَمَّدُ بْنُ كَثِيرٍ ، أَخْبَرَنَا إِسْرَائِيلُ ، أَخْبَرَنَا عُثْمَانُ بْنُ الْمُغِيرَ","Default: Sahih","Book 60"," Hadith 109","3438",""
"3440","وَأَرَانِي اللَّيْلَةَ عِنْدَ الْكَعْبَةِ فِي الْمَنَامِ فَإِذَا رَجُلٌ آدَمُ كَأَحْسَنِ مَا يُرَى م","Default: Sahih","Book 60"," Hadith 110","3440",""
"3441","حَدَّثَنَا أَحْمَدُ بْنُ مُحَمَّدٍ الْمَكِّيُّ ، قَالَ : سَمِعْتُ إِبْرَاهِيمَ بْنَ سَعْدٍ ، قَالَ :","Default: Sahih","Book 60"," Hadith 111","3441",""
"3442","حَدَّثَنَا أَبُو الْيَمَانِ ، أَخْبَرَنَا شُعَيْبٌ ، عَنْ الزُّهْرِيِّ ، قَالَ : أَخْبَرَنِي أَبُو س","Default: Sahih","Book 60"," Hadith 112","3442",""
"3443","حَدَّثَنَا مُحَمَّدُ بْنُ سِنَانٍ ، حَدَّثَنَا فُلَيْحُ بْنُ سُلَيْمَانَ ، حَدَّثَنَا هِلَالُ بْنُ ع","Default: Sahih","Book 60"," Hadith 113","3443",""
"3444","وحَدَّثَنَا عَبْدُ اللَّهِ بْنُ مُحَمَّدٍ ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، ع","Default: Sahih","Book 60"," Hadith 114","3444",""
"3445","حَدَّثَنَا الْحُمَيْدِيُّ ، حَدَّثَنَا سُفْيَانُ ، قَالَ : سَمِعْتُ الزُّهْرِيَّ ، يَقُولُ : أَخْبَر","Default: Sahih","Book 60"," Hadith 115","3445",""
"3446","حَدَّثَنَا مُحَمَّدُ بْنُ مُقَاتِلٍ ، أَخْبَرَنَا عَبْدُ اللَّهِ ، أَخْبَرَنَا صَالِحُ بْنُ حَيٍّ ،","Default: Sahih","Book 60"," Hadith 116","3446",""
"3447","حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ ، حَدَّثَنَا سُفْيَانُ ، عَنْ الْمُغِيرَةِ بْنِ النُّعْمَانِ ، عَن","Default: Sahih","Book 60"," Hadith 117","3447",""
"3448","حَدَّثَنَا إِسْحَاقُ ، أَخْبَرَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ ، حَدَّثَنَا أَبِي ، عَنْ صَالِحٍ ، ع","Default: Sahih","Book 60"," Hadith 118","3448",""
"3449","حَدَّثَنَا ابْنُ بُكَيْرٍ ، حَدَّثَنَا اللَّيْثُ ، عَنْ يُونُسَ ، عَنْ ابْنِ شِهَابٍ ، عَنْ نَافِعٍ","Default: Sahih","Book 60"," Hadith 119","3449",""
"3452","فَقَالَ : وَسَمِعْتُهُ ، يَقُولُ : إِنَّ رَجُلًا حَضَرَهُ الْمَوْتُ فَلَمَّا يَئِسَ مِنَ الْحَيَاةِ","Default: Sahih","Book 60"," Hadith 120","3452",""
"3454","حَدَّثَنِي بِشْرُ بْنُ مُحَمَّدٍ ، أَخْبَرَنَا عَبْدُ اللَّهِ ، أَخْبَرَنِي مَعْمَرٌ وَيُونُسُ ، عَن","Default: Sahih","Book 60"," Hadith 121","3454",""
"3455","حَدَّثَنِي مُحَمَّدُ بْنُ بَشَّارٍ ، حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، عَنْ","Default: Sahih","Book 60"," Hadith 122","3455",""
"3456","حَدَّثَنَا سَعِيدُ بْنُ أَبِي مَرْيَمَ ، حَدَّثَنَا أَبُو غَسَّانَ ، قَالَ : حَدَّثَنِي زَيْدُ بْنُ","Default: Sahih","Book 60"," Hadith 123","3456",""
"3457","حَدَّثَنَا عِمْرَانُ بْنُ مَيْسَرَةَ ، حَدَّثَنَا عَبْدُ الْوَارِثِ ، حَدَّثَنَا خَالِدٌ ، عَنْ أَبِ","Default: Sahih","Book 60"," Hadith 124","3457",""
"3458","حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ ، حَدَّثَنَا سُفْيَانُ ، عَنْ الْأَعْمَشِ ، عَنْ أَبِي الضُّحَى ،","Default: Sahih","Book 60"," Hadith 125","3458",""
"3459","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ رَضِيَ الل","Default: Sahih","Book 60"," Hadith 126","3459",""
"3460","حَدَّثَنَا عَلِيُّ بْنُ عَبْدِ اللَّهِ ، حَدَّثَنَا سُفْيَانُ ، عَنْ عَمْرٍو ، عَنْ طَاوُسٍ ، عَنْ ا","Default: Sahih","Book 60"," Hadith 127","3460",""
"3461","حَدَّثَنَا أَبُو عَاصِمٍ الضَّحَّاكُ بْنُ مَخْلَدٍ ، أَخْبَرَنَا الْأَوْزَاعِيُّ ، حَدَّثَنَا حَسَّا","Default: Sahih","Book 60"," Hadith 128","3461",""
"3462","حَدَّثَنَا عَبْدُ الْعَزِيزِ بْنُ عَبْدِ اللَّهِ ، قَالَ : حَدَّثَنِي إِبْرَاهِيمُ بْنُ سَعْدٍ ، عَن","Default: Sahih","Book 60"," Hadith 129","3462",""
"3463","حَدَّثَنِي مُحَمَّدٌ ، قَالَ : حَدَّثَنِي حَجَّاجٌ ، حَدَّثَنَا جَرِيرٌ ، عَنْ الْحَسَنِ ، حَدَّثَنَ","Default: Sahih","Book 60"," Hadith 130","3463",""
"3464","حَدَّثَنِي أَحْمَدُ بْنُ إِسْحَاقَ ، حَدَّثَنَا عَمْرُو بْنُ عَاصِمٍ ، حَدَّثَنَا هَمَّامٌ ، حَدَّثَ","Default: Sahih","Book 60"," Hadith 131","3464",""
"3465","حَدَّثَنَا إِسْمَاعِيلُ بْنُ خَلِيلٍ ، أَخْبَرَنَا عَلِيُّ بْنُ مُسْهِرٍ ، عَنْ عُبَيْدِ اللَّهِ بْن","Default: Sahih","takhreej: ‏ {‏ أم حسبت أن أصحاب الكهف والرقيم‏}‏ الكهف الفتح في الجبل ،‏‏‏‏ والرقيم الكتاب‏.‏ مرقوم مكتوب من الرقم ‏ {‏ ربطنا على قلوبهم‏}‏ ألهمناهم صبرا ‏ {‏ شططا‏}‏ إفراطا ،‏‏‏‏ الوصيد الفناء وجمعه وصائد ووصد ،‏‏‏‏ ويقال الوصيد الباب ‏ {‏ مؤصدة‏}‏ مطبقة ،‏‏‏‏ آصد الباب وأوصد ‏ {‏ بعثناهم‏}‏ أحييناهم ‏ {‏ أزكى‏}‏ أكثر ريعا‏.‏ فضرب الله على آذانهم ،‏‏‏‏ فناموا ‏ {‏ رجما بالغيب‏}‏ لم يستبن‏.‏ وقال مجاهد ‏ {‏ تقرضهم‏}‏ تتركهم‏.‏","3465","","Prophets"
"3466","حَدَّثَنَا أَبُو الْيَمَانِ ، أَخْبَرَنَا شُعَيْبٌ ، حَدَّثَنَا أَبُو الزِّنَادِ ، عَنْ عَبْدِ الرَّ","Default: Sahih","Book 60"," Hadith 133","3466",""
"3467","حَدَّثَنَا سَعِيدُ بْنُ تَلِيدٍ ، حَدَّثَنَا ابْنُ وَهْبٍ ، قَالَ : أَخْبَرَنِي جَرِيرُ بْنُ حَازِمٍ","Default: Sahih","Book 60"," Hadith 134","3467",""
"3468","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ ، عَنْ مَالِكٍ ، عَنْ ابْنِ شِهَابٍ ، عَنْ حُمَيْدِ بْنِ ع","Default: Sahih","Book 60"," Hadith 135","3468",""
"3469","حَدَّثَنَا عَبْدُ الْعَزِيزِ بْنُ عَبْدِ اللَّهِ ، حَدَّثَنَا إِبْرَاهِيمُ بْنُ سَعْدٍ ، عَنْ أَبِيه","Default: Sahih","Book 60"," Hadith 136","3469",""
"3470","حَدَّثَنَا مُحَمَّدُ بْنُ بَشَّارٍ ، حَدَّثَنَا مُحَمَّدُ بْنُ أَبِي عَدِيٍّ ، عَنْ شُعْبَةَ ، عَنْ","Default: Sahih","Book 60"," Hadith 137","3470",""
"3471","حَدَّثَنَا عَلِيُّ بْنُ عَبْدِ اللَّهِ ، حَدَّثَنَا سُفْيَانُ ، حَدَّثَنَا أَبُو الزِّنَادِ ، عَنْ ا","Default: Sahih","Book 60"," Hadith 138","3471",""
"3472","حَدَّثَنَا إِسْحَاقُ بْنُ نَصْرٍ ، أَخْبَرَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنْ هَمَّامٍ ،","Default: Sahih","Book 60"," Hadith 139","3472",""
"3473","حَدَّثَنَا عَبْدُ الْعَزِيزِ بْنُ عَبْدِ اللَّهِ ، قَالَ : حَدَّثَنِي مَالِكٌ ، عَنْ مُحَمَّدِ بْنِ","Default: Sahih","Book 60"," Hadith 140","3473",""
"3474","حَدَّثَنَا مُوسَى بْنُ إِسْمَاعِيلَ ، حَدَّثَنَا دَاوُدُ بْنُ أَبِي الْفُرَاتِ ، حَدَّثَنَا عَبْدُ ا","Default: Sahih","Book 60"," Hadith 141","3474",""
"3475","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ ، عَنْ ابْنِ شِهَابٍ ، عَنْ عُرْوَةَ ، عَنْ ع","Default: Sahih","Book 60"," Hadith 142","3475",""
"3476","حَدَّثَنَا آدَمُ ، حَدَّثَنَا شُعْبَةُ ، حَدَّثَنَا عَبْدُ الْمَلِكِ بْنُ مَيْسَرَةَ ، قَالَ : سَمِع","Default: Sahih","Book 60"," Hadith 143","3476",""
"3477","حَدَّثَنَا عُمَرُ بْنُ حَفْصٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا الْأَعْمَشُ ، قَالَ : حَدَّثَنِي شَقِي","Default: Sahih","Book 60"," Hadith 144","3477",""
"3478","حَدَّثَنَا أَبُو الْوَلِيدِ ، حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ قَتَادَةَ ، عَنْ عُقْبَةَ بْنِ عَبْد","Default: Sahih","Book 60"," Hadith 145","3478",""
"3479","حَدَّثَنَا مُسَدَّدٌ ، حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ، عَنْ رِبْع","Default: Sahih","Book 60"," Hadith 146","3479",""
"3480","حَدَّثَنَا عَبْدُ الْعَزِيزِ بْنُ عَبْدِ اللَّهِ ، حَدَّثَنَا إِبْرَاهِيمُ بْنُ سَعْدٍ ، عَنْ ابْنِ","Default: Sahih","Book 60"," Hadith 147","3480",""
"3481","حَدَّثَنِي عَبْدُ اللَّهِ بْنُ مُحَمَّدٍ ، حَدَّثَنَا هِشَامٌ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ الزُّهْر","Default: Sahih","Book 60"," Hadith 148","3481",""
"3482","حَدَّثَنِي عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ، حَدَّثَنَا جُوَيْرِيَةُ بْنُ أَسْمَاءَ ، ع","Default: Sahih","Book 60"," Hadith 149","3482",""
"3483","حَدَّثَنَا أَحْمَدُ بْنُ يُونُسَ ، عَنْ زُهَيْرٍ ، حَدَّثَنَا مَنْصُورٌ ، عَنْ رِبْعِيِّ بْنِ حِرَاش","Default: Sahih","Book 60"," Hadith 150","3483",""
"3484","حَدَّثَنَا آدَمُ ، حَدَّثَنَا شُعْبَةُ ، عَنْ مَنْصُورٍ ، قَالَ : سَمِعْتُ رِبْعِيَّ بْنَ حِرَاشٍ يُ","Default: Sahih","Book 60"," Hadith 151","3484",""
"3485","حَدَّثَنَا بِشْرُ بْنُ مُحَمَّدٍ ، أَخْبَرَنَا عُبَيْدُ اللَّهِ ، أَخْبَرَنَا يُونُسُ ، عَنْ الزُّهْ","Default: Sahih","Book 60"," Hadith 152","3485",""
"3487","«عَلَى كُلِّ مُسْلِمٍ فِي كُلِّ سَبْعَةِ أَيَّامٍ يَوْمٌ يَغْسِلُ رَأْسَهُ وَجَسَدَهُ».","Default: Sahih","Book 60"," Hadith 153","3487",""
"3488","حَدَّثَنَا آدَمُ حَدَّثَنَا شُعْبَةُ حَدَّثَنَا عَمْرُو بْنُ مُرَّةَ سَمِعْتُ سَعِيدَ بْنَ الْمُسَيّ","Default: Sahih","Book 60"," Hadith 154","3488",""
