hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"4009","(۴۰۰۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، قَالَ: أَخْبَرَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ أَشْیَاخُنَا لاَ یُمَایلُونَ ، یَعْنِی إذَا رَفَعَ أَحَدُہُمْ رَأْسَہُ مِنَ السَّجْدَۃِ الثَّانِیَۃِ فِی الرَّکْعَۃِ الأُولَی وَالثَّالِثَۃِ یَنْہَضُ کَمَا ہُوَ ، وَلَمْ یَجْلِسْ۔","","Musannaf Ibn Abi Shaybah 4009","","","كتاب الصلوات"
"4010","(۴۰۱۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یُسْرِعُ فِی الْقِیَامِ فِی الرَّکْعَۃِ الأُولَی مِنْ آخِرِ سَجْدَۃٍ۔","","Musannaf Ibn Abi Shaybah 4010","","","كتاب الصلوات"
"4011","(۴۰۱۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنِ النُّعْمَانِ بْنِ أَبِی عَیَّاشٍ ، قَالَ : أَدْرَکْت غَیْرَ وَاحِدٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَکَانَ إذَا رَفَعَ رَأْسَہُ مِنَ السَّجْدَۃِ فِی أَوَّلِ رَکْعَۃٍ وَالثَّالِثَۃِ ، قَامَ کَمَا ہُوَ وَلَمْ یَجْلِسْ۔","Hasan","Musannaf Ibn Abi Shaybah 4011","","","كتاب الصلوات"
"4012","(۴۰۱۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ خَالِدٍ ، قَالَ : رَأَیْتُ أَبَا قِلاَبَۃَ وَالْحَسَنَ یَعْتَمِدَانِ عَلَی أَیْدِیہِمَا فِی الصَّلاَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4012","","","كتاب الصلوات"
"4013","(۴۰۱۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَعْتَمِدَ الرَّجُلُ عَلَی یَدَیْہِ إذَا نَہَضَ فِی الصَّلاَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4013","","","كتاب الصلوات"
"4014","(۴۰۱۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4014","","","كتاب الصلوات"
"4015","(۴۰۱۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُحَمَّدِ بْنِ جُحَادَۃَ ، عَنِ الْحَارِثِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ ذَلِکَ ، إِلاَّ أَنْ یَکُونَ شَیْخًا کَبِیرًا ، أَوْ مَرِیضًا۔","","Musannaf Ibn Abi Shaybah 4015","","","كتاب الصلوات"
"4016","(۴۰۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی الأَسْوَدَ وَشُرَیْحًا وَمَسْرُوقًا یَعْتَمِدُونَ عَلَی أَیْدِیہِمْ إذَا نَہَضُوا۔","No Data Available","Musannaf Ibn Abi Shaybah 4016","","","كتاب الصلوات"
"4017","(۴۰۱۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ إسْمَاعِیلَ ، قَالَ : رَأَیْتُ قَیْسًا یَعْتَمِدُ عَلَی یَدَیْہِ إذَا نَہَضَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4017","","","كتاب الصلوات"
"4018","(۴۰۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنِ الأَزْرَقِ بْنِ قَیْسٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یَنْہَضُ فِی الصَّلاَۃِ وَیَعْتَمِدُ عَلَی یَدَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4018","","","كتاب الصلوات"
"4019","(۴۰۱۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَعْتَمِدُ عَلَی یَدَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 4019","","","كتاب الصلوات"
"4020","(۴۰۲۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنْ زِیَادِ بْنِ زَیْدٍ السُّوَائِیِّ ، عَنْ أَبِی جُحَیْفَۃَ ، عَنْ عَلِیٍّ ، قَالَ : إنَّ مِنَ السُّنَّۃِ فِی الصَّلاَۃِ الْمَکْتُوبَۃِ إذَا نَہَضَ الرَّجُلُ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ أَنْ لاَ یَعْتَمِدَ بِیَدَیْہِ عَلَی الأَرْضِ ، إِلاَّ أَنْ یَکُونَ شَیْخًا کَبِیرًا لاَ یَسْتَطِیعُ۔ (بیہقی ۱۳۶)","Da'if","Musannaf Ibn Abi Shaybah 4020","","","كتاب الصلوات"
"4021","(۴۰۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مَہْدِیِّ بْنِ مَیْمُونٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَرِہَ أَنْ یَعْتَمِدَ ، وَکَانَ الْحَسَنُ یَعْتَمِدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4021","","","كتاب الصلوات"
"4022","(۴۰۲۲) حَدَّثَنَا أَبُو دَاوُدَ ، عَنِ الْہُذَیْلِ بْنِ بِلاَلٍ ، قَالَ : رَأَیْتُ عَطَائً یَعْتَمِدُ إذَا نَہَضَ۔","","Musannaf Ibn Abi Shaybah 4022","","","كتاب الصلوات"
"4023","(۴۰۲۳) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : کَانَ مَالِکُ بْنُ الْحُوَیْرِثِ یَأْتِینَا فَیَقُولُ : أَلاَّ أُحَدِّثُکُمْ عَنْ صَلاَۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَیُصَلِّی فِی غَیْرِ وَقْتِ صَلاَۃٍ ، فَإِذَا رَفَعَ رَأْسَہُ مِنَ السَّجْدَۃِ الثَّانِیَۃِ فِی أَوَّلِ رَکْعَۃٍ اسْتَوَی قَاعِدًا ، ثُمَّ قَامَ وَاعْتَمَدَ۔ (بخاری ۸۲۳۔ ابوداؤد ۸۴۰)","Sahih","Musannaf Ibn Abi Shaybah 4023","","","كتاب الصلوات"
"4024","(۴۰۲۴) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ سُئِلَ عَنْ رَجُلٍ لَمْ یَقْرَأْ بِفَاتِحَۃِ الْکِتَابِ ؟ قَالَ : إِنْ کَانَ قَرَأَ غَیْرَہَا أَجْزَأَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 4024","","","كتاب الصلوات"
"4025","(۴۰۲۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ عَنِ الرَّجُلِ یَنْسَی فَاتِحَۃَ الْکِتَابِ ، فَیَقْرَأُ سُورَۃً ، أَوْ یَقْرَأُ فَاتِحَۃَ الْکِتَابِ ، وَلاَ یَقْرَأُ مَعَہَا شَیْئًا ؟ قَالَ : یُجْزئہ۔","No Data Available","Musannaf Ibn Abi Shaybah 4025","","","كتاب الصلوات"
"4026","(۴۰۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، وَالْحَکَمِ ؛ فِی رَجُلٍ نَسِیَ فَاتِحَۃَ الْکِتَابِ ، قَالَ الشَّعْبِیُّ : یَسْجُدُ سَجْدَتَیِ السَّہْوِ ، وَقَالَ الْحَکَمُ : یَقْرَؤُہَا إذَا ذُکر۔","","Musannaf Ibn Abi Shaybah 4026","","","كتاب الصلوات"
"4027","(۴۰۲۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ قَرَأَ ، {قُلْ ہُوَ اللَّہُ أَحَدٌ} ، وَنَسِیَ فَاتِحَۃَ الْکِتَابِ ، قَالَ : تُجْزئہ۔","No Data Available","Musannaf Ibn Abi Shaybah 4027","","","كتاب الصلوات"
"4028","(۴۰۲۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی سَلَمَۃَ ، قَالَ : صَلَّی عُمَرُ الْمَغْرِبَ فَلَمْ یَقْرَأْ ، فَلَمَّا انْصَرَفَ ، قَالَ لَہُ النَّاسُ : إنَّک لَمْ تَقْرَأْ ، قَالَ : فَکَیْفَ کَانَ الرُّکُوعُ وَالسُّجُودُ تَامٌّ ہُوَ ؟ قَالُوا : نَعَمْ ، فَقَالَ : لاَ بَأْسَ ، إنِّی حَدَّثْت نَفْسِی بِعِیرٍ جَہَّزْتہَا بِأَقْتَابِہَا وَحَقَائِبِہَا۔","","Musannaf Ibn Abi Shaybah 4028","","","كتاب الصلوات"
"4029","(۴۰۲۹) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : إذَا صَلَّی الرَّجُلُ فَنَسِیَ أَنْ یَقْرَأَ حَتَّی فَرَغَ مِنْ صَلاَتِہِ ، قَالَ : تُجْزئہ مَا کُلُّ النَّاسِ تَقْرَأُ۔","","Musannaf Ibn Abi Shaybah 4029","","","كتاب الصلوات"
"4030","(۴۰۳۰) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ (ح) وَعَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ؛ فِی رَجُلٍ نَسِیَ الْقِرَائَۃَ فِی الظُّہْرِ وَالْعَصْرِ حَتَّی فَرَغَ مِنْ صَلاَتِہِ ، قَالاَ : أَجْزَأَتْ عَنْہُ إذَا أَتَمَّ الرُّکُوعَ وَالسُّجُودَ۔","","Musannaf Ibn Abi Shaybah 4030","","","كتاب الصلوات"
"4031","(۴۰۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، قَالَ : جَائَ رَجُلٌ إلَی عَلِیٍّ ، فَقَالَ : إنِّی صَلَّیْت وَنَسِیت أَنْ أَقْرَأَ ؟ فَقَالَ لَہُ : أَتْمَمْتَ الرُّکُوعَ وَالسُّجُودَ ؟ قَالَ : نَعَمْ ، قَالَ : یُجْزِئُکَ۔","Da'if","Musannaf Ibn Abi Shaybah 4031","","","كتاب الصلوات"
"4032","(۴۰۳۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا نَسِیَ الْقِرَائَۃَ ، فَإِنَّہُ لاَ یَعْتَدُّ بِتِلْکَ الرَّکْعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4032","","","كتاب الصلوات"
"4033","(۴۰۳۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ صَلاَۃَ إِلاَّ بِقِرَائَۃٍ۔","","Musannaf Ibn Abi Shaybah 4033","","","كتاب الصلوات"
"4034","(۴۰۳۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن ہَمَّامٍ ، قَالَ : صَلَّی عُمَرُ الْمَغْرِبَ فَلَمْ یَقْرَأْ فِیہَا ، فَلَمَّا انْصَرَفَ ، قَالُوا لَہُ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إنَّک لَمْ تَقْرَأْ ، فَقَالَ : إنِّی حَدَّثْت نَفْسِی وَأَنَا فِی الصَّلاَۃِ بِعِیرٍ وَجَّہْتہَا مِنَ الْمَدِینَۃِ ، فَلَمْ أَزَلْ أُجَہِّزُہَا حَتَّی دَخَلَتِ الشَّامَ ، قَالَ : ثُمَّ أَعَادَ الصَّلاَۃَ وَالْقِرَائَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 4034","","","كتاب الصلوات"
"4035","(۴۰۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، قَالَ : کَانَ إذَا کَبَّرَ سَکَتَ سَاعَۃً لاَ یَقْرَأُ ، فَکَبَّرَ ، فَرَکَعَ قَبْلَ أَنْ یَقْرَأَ ، فَرَفَعَ رَأْسَہُ فَقَرَأَ ، وَأَوْمَأَ أَنْ لاَّ تَرْکَعُوا ، وَافْتَتَحَ الْقِرَائَۃَ بِـ (الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ)۔","","Musannaf Ibn Abi Shaybah 4035","","","كتاب الصلوات"
"4036","(۴۰۳۶) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا رَکَعْتَ فَرَفَعْتَ رَأْسَک ، فَاقْرَأْ إِنْ شِئْتَ بَعْدَ مَا تَرْفَعُ رَأْسَک ، ثُمَّ ارْکَعْ ، وَإنْ شِئْت فَاسْجُدْ کَمَا أَنْتَ۔","","Musannaf Ibn Abi Shaybah 4036","","","كتاب الصلوات"
"4037","(۴۰۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : کَانَ الْمَسْجِدُ یُرَشُّ وَیُقَمُّ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبِی بَکْرٍ۔ (بخاری ۴۵۸۔ ابوداؤد ۳۱۹۵)","","Musannaf Ibn Abi Shaybah 4037","","","كتاب الصلوات"
"4038","(۴۰۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا کَثِیرُ بْنُ زَیْدٍ ، عَنِ الْمُطَّلِبِ بْنِ عَبْدِ اللہِ بْنِ حَنْطَبٍ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَتَی مَسْجِدَ قُبَائَ عَلَی فَرَسٍ لَہُ فَصَلَّی فِیہِ ، ثُمَّ قَالَ : یَا یَرْفَأُ ، ائتنی بِجَرِیدَۃٍ ، قَالَ : فَأَتَاہُ بِجَرِیدَۃٍ ، فَاحْتَجَزَ عُمَرُ بِثَوْبِہِ ، ثُمَّ کَنَسَہُ۔","","Musannaf Ibn Abi Shaybah 4038","","","كتاب الصلوات"
"4039","(۴۰۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو عَاصِمٍ الثَّقَفِیُّ ، قَالَ : کُنْتُ مَعَ الشَّعْبِیِّ فِی الْمَسْجِدِ ، فَجَعَلَ یَتَطَأْطَأُ ، فَقُلْتُ : مَا تَصْنَعُ یَا أَبَا عَمْرٍو ؟ قَالَ : أَلْتَقِطُ الْقَصَبَۃَ وَالْخَشَاشَۃَ وَالشَّیْئَ مِنَ الْمَسْجِدِ ، قَالَ : وَکَانَ أَبُو عَاصِمٍ مَکْفُوفًا۔","","Musannaf Ibn Abi Shaybah 4039","","","كتاب الصلوات"
"4040","(۴۰۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، قَالَ : رَأَیْتُ سَالِمًا کَنَسَ مَکَانًا ، ثُمَّ صَلَّی فِیہِ۔","","Musannaf Ibn Abi Shaybah 4040","","","كتاب الصلوات"
"4041","(۴۰۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ یَعْقُوبَ بْنِ زَیْدٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَتْبَعُ غُبَارَ الْمَسْجِدِ بِجَرِیدَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 4041","","","كتاب الصلوات"
"4042","(۴۰۴۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی عَلَی خُمْرَۃٍ۔ (ترمذی ۳۳۱۔ احمد ۱/۳۵۸)","","Musannaf Ibn Abi Shaybah 4042","","","كتاب الصلوات"
"4043","(۴۰۴۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، وَعَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، قَالَ : أَخْبَرَتْنِی مَیْمُونَۃُ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی عَلَی الْخُمْرَۃِ۔ (بخاری ۳۳۳۔ ابوداؤد ۶۵۶)","Sahih","Musannaf Ibn Abi Shaybah 4043","","","كتاب الصلوات"
"4044","(۴۰۴۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ أَبِی سَعِیدٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی عَلَی حَصِیرٍ۔ (مسلم ۲۷۱۔ احمد ۳/۱۰)","Hasan","Musannaf Ibn Abi Shaybah 4044","","","كتاب الصلوات"
"4045","(۴۰۴۵) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، عَنْ أُمِّ سُلَیْمٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی فِی بَیْتِہَا عَلَی الْخُمْرَۃِ۔ (نسائی ۸۱۶۔ احمد ۶/۳۷۷)","","Musannaf Ibn Abi Shaybah 4045","","","كتاب الصلوات"
"4046","(۴۰۴۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أُمِّ کُلْثُومٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی عَلَی الْخُمْرَۃِ۔ (احمد ۶/۳۰۲۔ ابو یعلی ۶۸۸۴)","","Musannaf Ibn Abi Shaybah 4046","","","كتاب الصلوات"
"4047","(۴۰۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنِ الأَزْرَقِ بْنِ قَیْسٍ ، عَنْ ذَکْوَانَ ، عَنْ عَائِشَۃَ ؛أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی عَلَی الْخُمْرَۃِ۔ (احمد ۶/۲۰۹۔ طیالسی ۱۵۴۴)","Sahih","Musannaf Ibn Abi Shaybah 4047","","","كتاب الصلوات"
"4048","(۴۰۴۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ الْمُنْذِرِ بْنِ الْجَارُودِ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : صَنَعَ بَعْضُ عُمُومَتِی لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ طَعَامًا ، فَقَالَ : إنِّی أُحِبُّ أَنْ تَأْکُلَ فِی بَیْتِی وَتُصَلِّیَ فِیہِ ، قَالَ : فَأَتَاہُ وَفِی الْبَیْتِ فَحْلٌ مِنْ تِلْکَ الْفُحُولِ ، فَأَمَرَ بِجَانِبٍ مِنْہُ فَکُنِسَ وَرُشَّ ، فَصَلَّی وَصَلَّیْنَا مَعَہُ۔ (احمد ۳/۱۱۲۔ ابو یعلی ۴۲۲۷)","Sahih","Musannaf Ibn Abi Shaybah 4048","","","كتاب الصلوات"
"4049","(۴۰۴۹) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ یُصَلِّی عَلَی الْخُمْرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 4049","","","كتاب الصلوات"
"4050","(۴۰۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُمَرُ بْنُ ذَرٍّ ، عَنْ یَزِیدَ الْفَقِیرِ ، قَالَ : رَأَیْتُ جَابِرَ بْنَ عَبْدِ اللہِ یُصَلِّی عَلَی حَصِیرٍ مِنْ بَرْدِیٍّ۔","Sahih","Musannaf Ibn Abi Shaybah 4050","","","كتاب الصلوات"
"4051","(۴۰۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعُمَرِیُّ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللہِ بْنِ أَبِی طَلْحَۃَ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی عَلَی حَصِیرٍ۔ (بخاری ۳۸۰۔ ابوداؤد ۶۱۲)","Da'if","Musannaf Ibn Abi Shaybah 4051","","","كتاب الصلوات"
"4052","(۴۰۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ الْغَازِ ، عَنْ مَکْحُولٍ ، قَالَ : رَأَیْتُہُ یُصَلِّی عَلَی الْحَصِیرِ ، وَیَسْجُدُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4052","","","كتاب الصلوات"
"4053","(۴۰۵۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ صَفْوَانَ ، عَنْ عَطَائِ بْنِ أَبِی مَرْوَانَ ، عَنْ أَبِیہِ ، عَنْ أَبِی ذَرٍّ ؛ أَنَّہُ کَانَ یُصَلِّی عَلَی الْخُمْرَۃِ۔","","Musannaf Ibn Abi Shaybah 4053","","","كتاب الصلوات"
"4054","(۴۰۵۴) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ ثَابِتِ بْنِ عُبَیْدِ اللہِ ، قَالَ : رَأَیْتُ زَیْدَ بْنَ ثَابِتٍ یُصَلِّی عَلَی حَصِیرٍ یَسْجُدُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4054","","","كتاب الصلوات"
"4055","(۴۰۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی زَیْدَ بْنَ ثَابِتٍ یُصَلِّی عَلَی حَصِیرٍ۔","Majhul","Musannaf Ibn Abi Shaybah 4055","","","كتاب الصلوات"
"4056","(۴۰۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ تَوْبَۃَ الْعَنْبَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُصَلِّی عَلَی حَصِیرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 4056","","","كتاب الصلوات"
"4057","(۴۰۵۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : الصَّلاَۃُ عَلَی الْخُمْرَۃِ سُنَّۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 4057","","","كتاب الصلوات"
"4058","(۴۰۵۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِد ، عَنْ عَامِرٍ ، قَالَ : صَلَّیْت مَعَ ابْنِ عَبَّاسٍ فِی بَیْتِہِ عَلَی مِسْحٍ یَسْجُدُ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 4058","","","كتاب الصلوات"
"4059","(۴۰۵۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عِیسَی بْنِ سِنَانٍ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یُصَلِّی عَلَی مِسْحٍ۔","","Musannaf Ibn Abi Shaybah 4059","","","كتاب الصلوات"
"4060","(۴۰۶۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُجَالِد ، عَنْ عَامِرٍ ، عَنْ جَابِرٍ ؛ أَنَّہُ صَلَّی عَلَی مِسْحٍ۔","Da'if","Musannaf Ibn Abi Shaybah 4060","","","كتاب الصلوات"
"4061","(۴۰۶۱) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ أَبِیہِ ، عَنْ رَجُلٍ مِنْ بَکْرِ بْنِ وَائِلٍ ، قَالَ : رَأَیْتُ عَلِیًّا یُصَلِّی عَلَی مُصَلًّی مِنْ مُسُوحٍ ، یَرْکَعُ عَلَیْہِ وَیَسْجُدُ۔","Majhul","Musannaf Ibn Abi Shaybah 4061","","","كتاب الصلوات"
"4062","(۴۰۶۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَحْوَصِ بْنِ حَکِیمٍ ، عَنْ أَبِی الزَّاہِرِیَّۃِ ، عَنْ جُبَیْرِ بْنِ نُفَیْرٍ ؛ أَنَّ أَبَا الدَّرْدَائِ کَانَ یُصَلِّی عَلَی مِسْحٍ یَسْجُدُ عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4062","","","كتاب الصلوات"
"4063","(۴۰۶۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ وَأَصْحَابِہِ ؛ أَنَّہُمْ کَانُوا یَکْرَہُونَ أَنْ یُصَلُّوا عَلَی الطَّنَافِسِ وَالْفِرَائِ وَالْمُسُوحِ۔","","Musannaf Ibn Abi Shaybah 4063","","","كتاب الصلوات"
"4064","(۴۰۶۴) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ صَالِحِ بْنِ حَیَّانَ ، عَنْ شَقِیقِ بْنِ سَلَمَۃَ ، قَالَ : صَلَّیْت مَعَ ابْنِ مَسْعُودٍ عَلَی مِسْحٍ ، فَکَانَ یَسْجُدُ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 4064","","","كتاب الصلوات"
"4065","(۴۰۶۵) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی التَّیَّاحِ الضُّبَعِیِّ ، قَالَ : سَمِعْتُ أَنَسَ بْنَ مَالِکٍ ، یَقُولُ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُخَالِطُنَا ، فَیَقُولُ لإِخٍ لِی : یَا أَبَا عُمَیْرٍ ، مَا فَعَلَ النُّغَیْرُ ، قَالَ : وَنَضَحَ بِسَاطًا لَنَا فَصَلَّی عَلَیْہِ۔ (بخاری ۶۱۲۹۔ مسلم ۱۶۹۲)","Sahih","Musannaf Ibn Abi Shaybah 4065","","","كتاب الصلوات"
"4066","(۴۰۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ زَمْعَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، وَسَلَمَۃَ بْنِ وَہْرَام ، قَالَ أَحَدُہُمَا : عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی عَلَی بِسَاطٍ۔ (احمد ۲۳۲۔ حاکم ۲۵۹)","Da'if","Musannaf Ibn Abi Shaybah 4066","","","كتاب الصلوات"
"4067","(۴۰۶۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، وَعِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عُثْمَانَ بْنِ أَبِی سَوْدَۃَ ، عَنْ خُلَیْدٍ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : مَا أُبَالِی لَوْ صَلَّیْت عَلَی سِتِّ طَنَافِسَ بَعْضُہَا فَوْقَ بَعْضٍ۔","Sahih","Musannaf Ibn Abi Shaybah 4067","","","كتاب الصلوات"
"4068","(۴۰۶۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الأَعْمَش ، عَنْ سَعِیدِ بْنِ جُبَرٍن ، قَالَ : صَلَّی بِنَا ابْنُ عَبَّاسٍ عَلَی طُنْفُسَۃٍ قَدْ طَبَقَتِ الْبَیْتَ صَلاَۃَ الْمَغْرِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 4068","","","كتاب الصلوات"
"4069","(۴۰۶۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، قَالَ : شَہِدْت مُحِلاًّ یَقُولُ لإِبْرَاہِیمَ : إنِّی رَأَیْت أَبَا وَائِلٍ یُصَلِّی عَلَی طُنْفُسَۃٍ ، فَقَالَ إبْرَاہِیمُ : کَانَ أَبُو وَائِلٍ خَیْرًا مِنِّی۔","","Musannaf Ibn Abi Shaybah 4069","","","كتاب الصلوات"
"4070","(۴۰۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ تَوْبَۃَ الْعَنْبَرِیِّ ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ الْمَخْزُومِیِّ ، عَنْ عَبْدِ اللہِ بْنِ عَمَّارٍ، قَالَ : رَأَیْتُ عُمَرَ یُصَلِّی عَلَی عَبْقَرِیٍّ۔","Majhul","Musannaf Ibn Abi Shaybah 4070","","","كتاب الصلوات"
"4071","(۴۰۷۱) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : رَأَیْتُ عَطَائً یُصَلِّی عَلَی بِسَاطٍ أَبْیَضَ فِی الْمَسْجِدِ الْحَرَامِ ، وَلَیْسَ بَیْنَہُ وَبَیْنَ الطَّوَافِ أَحَدٌ۔","","Musannaf Ibn Abi Shaybah 4071","","","كتاب الصلوات"
"4072","(۴۰۷۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِالصَّلاَۃِ عَلَی الطُّنْفُسَۃِ۔","","Musannaf Ibn Abi Shaybah 4072","","","كتاب الصلوات"
"4073","(۴۰۷۳) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ الرَّبِیعِ بْنِ الْمُنْذِرِ ، عَنْ عَبْدِ الْمَلِکِ بْنِ سَعِیدٍ ، قَالَ : رَأَیْتُ أَبِی سَعِیدَ بْنَ جُبَیْرٍ یُصَلِّی عَلَی بِسَاطٍ یَسْجُدُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4073","","","كتاب الصلوات"
"4074","(۴۰۷۴) حَدَّثَنَا بِشْرُ بْنُ مُفَضَّلٍ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ إذَا صَلَّی عَلَی شَیْئٍ سَجَد عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4074","","","كتاب الصلوات"
"4075","(۴۰۷۵) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، عَنْ شُعْبَۃَ ، عَنْ تَوْبَۃَ الْعَنْبَرِیِّ ، قَالَ : سَمِعْتُ بَکْرَ بْنَ عَبْدِ اللہِ الْمُزَنِیّ یَقُولُ : إنَّ قَیْسَ بْنَ عُبَادٍ الْقَیْسِیَّ صَلَّی عَلَی لِبْدِ دَابَّتِہِ۔","","Musannaf Ibn Abi Shaybah 4075","","","كتاب الصلوات"
"4076","(۴۰۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، قَالَ ، رَأَیْت مُرَّۃً الْہَمْدَانِیَّ یُصَلِّی عَلَی لِبْدٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 4076","","","كتاب الصلوات"
"4077","(۴۰۷۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُصَلِّی عَلَی طُنْفُسَۃٍ قَدَمَاہُ وَرُکْبَتَاہُ عَلَیْہَا ، وَیَدَاہُ وَوَجْہُہُ عَلَی الأَرْضِ ، أَوْ عَلَی بُورِیٍّ۔","","Musannaf Ibn Abi Shaybah 4077","","","كتاب الصلوات"
"4078","(۴۰۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، قَالَ : أَخْبَرَنَا مَنْ رَأَی إبْرَاہِیمَ وَالْحَسَنَ یُصَلِّیَانِ عَلَی بِسَاطٍ فِیہِ تَصَاوِیرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4078","","","كتاب الصلوات"
"4079","(۴۰۷۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : الصَّلاَۃُ عَلَی الطُّنْفُسَۃِ مُحْدَثٌ۔","","Musannaf Ibn Abi Shaybah 4079","","","كتاب الصلوات"
"4080","(۴۰۸۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : الصَّلاَۃُ عَلَی الطُّنْفُسَۃِ مُحْدَثٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 4080","","","كتاب الصلوات"
"4081","(۴۰۸۱) حَدَّثَنَا زِیَادُ بْنُ الرَّبِیعِ ، عَنْ صَالِحٍ الدَّہَان ؛ أَنَّ جَابِرَ بْنَ زَیْدٍ کَانَ یَکْرَہُ الصَّلاَۃَ عَلَی کُلِّ شَیْئٍ مِنَ الْحَیَوَانِ ، وَیَسْتَحِبُّ الصَّلاَۃَ عَلَی کُلِّ شَیْئٍ مِنْ نَبَاتِ الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 4081","","","كتاب الصلوات"
"4082","(۴۰۸۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : کَانَ عَبْدُ اللہِ لاَ یُصَلِّی ، وَلاَ یَسْجُدُ إِلاَّ عَلَی الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 4082","","","كتاب الصلوات"
"4083","(۴۰۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْقِلِ بْنِ عُبَیْدِ اللہِ ، عَنْ عَبْدِ الْکَرِیمِ الْجَزَرِیِّ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ بِالصَّلاَۃِ عَلَی الأَرْضِ وَعَلَی مَا أَنْبَتَتْ۔","","Musannaf Ibn Abi Shaybah 4083","","","كتاب الصلوات"
"4084","(۴۰۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ وَحُصَیْنٍ ، قَالَ سُفْیَانُ : أَوْ أَحَدُہُمَا ، عَنْ أَبِی حَازِمٍ الأَشْجَعِیِّ، عَنْ مَوْلاَتِہِ عَزَّۃَ ، قَالَتْ : سَمِعْت أَبَا بَکْرٍ یَنْہَی عَنِ الصَّلاَۃِ عَلَی الْبَرَادِعِ۔","Majhul","Musannaf Ibn Abi Shaybah 4084","","","كتاب الصلوات"
"4085","(۴۰۸۵) حَدَّثَنَا حَاتِمٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُسْجَدَ عَلَی شَیْئٍ دُونَ الأَرْضِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4085","","","كتاب الصلوات"
"4086","(۴۰۸۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ جَابِرٍ ، قَالَ : خَرَجَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ لَیْلَۃٍ وَأَصْحَابُہُ یَنْتَظِرُونَہُ لِصَلاَۃِ الْعِشَائِ الآخِرَۃِ ، فَقَالَ : نَامَ النَّاسُ وَرَقَدُوا ، وَأَنْتُمْ تَنْتَظِرُونَ الصَّلاَۃَ ، أَمَا إنَّکُمْ فِی صَلاَۃٍ مَا انْتَظَرْتُمُوہَا ، وَلَوْلاَ ضَعْفُ الضَّعِیفِ وَکِبَرُ الْکَبِیرِ ، لَأَخَّرْتُ ہَذِہِ الصَّلاَۃَ إلَی شَطْرِ اللَّیْلِ۔ (ابو یعلی ۱۹۳۵۔ ابن حبان ۱۵۲۹)","Sahih","Musannaf Ibn Abi Shaybah 4086","","","كتاب الصلوات"
"4087","(۴۰۸۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : مَنْ دَخَلَ الْمَسْجِدَ وَہُوَ عَلَی طُہُورٍ ، لَمْ یَزَلْ عَاکِفًا فِیہِ مَا دَامَ فِیہِ حَتَّی یَخْرُجَ مِنْہُ ، أَوْ یُحْدِثَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4087","","","كتاب الصلوات"
"4088","(۴۰۸۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ ، إذَا صَلَّی الرَّجُلُ ثُمَّ جَلَسَ فِی مُصَلاَّہُ فَہُوَ فِی صَلاَۃٍ ، وَالْمَلاَئِکَۃُ تُصَلِّی عَلَیْہِ مَا لَمْ یُحْدِثْ فِیہِ ، وَإِذَا جَلَسَ فِی الْمَسْجِدِ فَہُوَ فِی صَلاَۃٍ مَا لَمْ یُحْدِثْ، وَمَا لَمْ یُؤْذِ فِیہِ۔","","Musannaf Ibn Abi Shaybah 4088","","","كتاب الصلوات"
"4089","(۴۰۸۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنِ الْحَکَمِ بْنِ أَبَانَ ، عَنْ عِکْرِمَۃَ ، قَالَ : مَا مِنْ رَجُلٍ صَلَّی صَلاَۃً وَیَنْتَظِرُ أُخْرَی ، إِلاَّ قَالَتِ الْمَلاَئِکَۃُ : عَبْدُک فُلاَنٌ اللَّہُمَّ ارْحَمْہُ حَتَّی یُصَلِّیَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 4089","","","كتاب الصلوات"
"4090","(۴۰۹۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زَائِدَۃَ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : إذَا کَانَ الرَّجُلُ جَالِسًا فِی الْمَسْجِدِ یَنْتَظِرُ الصَّلاَۃَ ، فَہُوَ مُعْتَکِفٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 4090","","","كتاب الصلوات"
"4091","(۴۰۹۱) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ عَیَّاشٍ الْحَضْرَمِیِّ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ مَیْمُونٍ قَاضِی مِصْرَ ، قَالَ : حَدَّثَنِی سَہْلُ بْنُ سَعْدٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنِ انْتَظَرَ الصَّلاَۃَ ، فَہُوَ فِی صَلاَۃٍ مَا لَمْ یُحْدِثْ۔ (احمد ۵/۳۳۱۔ ابو یعلی ۷۵۴۶)","Hasan","Musannaf Ibn Abi Shaybah 4091","","","كتاب الصلوات"
"4092","(۴۰۹۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : جَہَّزَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَیْشًا حَتَّی انْتَصَفَ اللَّیْلُ ، أَوْ بَلَغَ ذَلِکَ ، ثُمَّ خَرَجَ إلَیْنَا ، فَقَالَ : صَلَّی النَّاسُ وَرَقَدُوا وَأَنْتُمْ تَنْتَظِرُونَ الصَّلاَۃَ ، أَمَا إنَّکُمْ لَمْ تَزَالُوا فِی صَلاَۃٍ مَا انْتَظَرْتُمُوہَا۔ (احمد ۳/۳۶۷۔ ابو یعلی ۱۹۳۶)","Hasan","Musannaf Ibn Abi Shaybah 4092","","","كتاب الصلوات"
"4093","(۴۰۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا دَخَلَ أَحَدُکُمُ الْمَسْجِدَ کَانَ فِی صَلاَۃٍ مَا کَانَتِ الصَّلاَۃُ تَحْبِسُہُ ، وَالْمَلاَئِکَۃُ یُصَلُّونَ عَلَی أَحَدِکُمْ مَا دَامَ فِی مَجْلِسِہِ الَّذِی صَلَّی فِیہِ ، یَقُولُونَ : اللَّہُمَّ اغْفِرْ لَہُ ، اللَّہُمَّ ارْحَمْہُ ، اللَّہُمَّ تُبْ عَلَیْہِ ، مَا لَمْ یُؤْذِ فِیہِ ، مَا لَمْ یُحْدِثْ فِیہِ۔ (بخاری ۴۷۷۔ ابوداؤد ۵۶۰)","Sahih","Musannaf Ibn Abi Shaybah 4093","","","كتاب الصلوات"
"4094","(۴۰۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : حدَّثَنَا رَجُلٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا صَلَّی أَحَدُکُمْ فَقَضَی صَلاَتَہُ ، ثُمَّ قَعَدَ فِی مُصَلاَّہُ یَذْکُرُ اللَّہَ فَہُوَ فِی صَلاَۃٍ ، وَإِنَّ الْمَلاَئِکَۃَ یُصَلُّونَ عَلَیْہِ ، یَقُولُونَ : اللَّہُمَّ ارْحَمْہُ وَاغْفِرْ لَہُ ، وَإِنْ ہُوَ دَخَلَ مُصَلاَّہُ یَنْتَظِرُ کَانَ مِثْلَ ذَلِکَ۔ (ابن سعد ۱۷۴)","Da'if","Musannaf Ibn Abi Shaybah 4094","","","كتاب الصلوات"
"4095","(۴۰۹۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : احْتَبَسَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ أَصْحَابِہِ فِی صَلاَۃِ الْعِشَائِ ، حَتَّی بَقِیَ ثُلُثُ اللَّیْلِ ، فَأَتَاہُمْ وَبَعْضُہُمْ قَائِمٌ ، وَبَعْضُہُمْ قَاعِدٌ ، وَبَعْضُہُمْ مُضْطَجِعٌ ، فَقَالَ : مَا زِلْتُمْ فِی صَلاَۃٍ مُنْذُ انْتَظَرْتُمُوہَا ، قَائِمُکُمْ وَقَاعِدُکُمْ وَمُضْطَجِعُکُمْ۔","","Musannaf Ibn Abi Shaybah 4095","","","كتاب الصلوات"
"4096","(۴۰۹۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : لاَ یَزَالُ أَحَدُکُمْ فِی صَلاَۃٍ مَا دَامَتِ الصَّلاَۃُ تَحْبِسُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4096","","","كتاب الصلوات"
"4097","(۴۰۹۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ ، عَنْ أَنَسٍ ، قَالَ : أَخَّرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ لَیْلَۃٍ الصَّلاَۃَ إلَی شَطْرِ اللَّیْلِ ، فَجَعَلَ النَّاسُ یُصَلُّونَ وَیَنْکَفِئُونَ ، فَخَرَجَ وَقَدْ بَقِیَتْ عِصَابَۃٌ فَصَلَّی بِہِمْ ، فَلَمَّا سَلَّمَ أَقْبَلَ عَلَیْہِم بِوَجْہِہِ ، فَقَالَ : إنَّ النَّاسَ قَدْ صَلَّوْا وَرَقَدُوا ، وَإِنَّکُمْ لَمْ تَزَالُوا فِی صَلاَۃٍ مُنْذُ انْتَظَرْتُمُ الصَّلاَۃَ ، قَالَ : فَکَأَنِّی أَنْظُرُ إلَی وَبِیصِ خَاتَمِہِ فِی یَدِہِ۔ (بخاری ۸۴۷۔ مسلم ۲۲۲)","Sahih","Musannaf Ibn Abi Shaybah 4097","","","كتاب الصلوات"
"4098","(۴۰۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ صَدَقَۃَ بْنِ یَسَارٍ ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : کَانُوا یُشَبِّہُونَ صَلاَۃَ الْہَجِیرِ بِصَلاَۃٍ فِی جَوْفِ اللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 4098","","","كتاب الصلوات"
"4099","(۴۰۹۹) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، عَنْ أَنَسٍ ، قَالَ : صَلُّوا صَلاَۃَ الْہَجِیرِ ، فَإِنَّا کُنَّا نَسْتَحِبّہَا۔","Sahih","Musannaf Ibn Abi Shaybah 4099","","","كتاب الصلوات"
"4100","(۴۱۰۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ : صَلُّوا صَلاَۃَ الأَصَالِ حِینَ یَفِیئَ الْفَیئُ عِنْدَ النِّدَائِ بِالظُّہْرِ ، مَنْ صَلاَّہَا فَکَأَنَّمَا تَہَجَّدَ بِاللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 4100","","","كتاب الصلوات"
"4101","(۴۱۰۱) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ ہَارُونَ بْنِ عَنْتَرَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِہِم ، قَالَ : أَصَبْت أَنَا وَعَلْقَمَۃُ صَحِیفَۃً ، فَانْطَلَقْنَا بِہَا إلَی عَبْدِ اللہِ ، فَجَلَسْنَا بِالْبَابِ وَقَدْ زَالَتِ الشَّمْسُ ، أَوْ کَادَتْ تَزُولُ ، فَاسْتَیْقَظَ وَأَرْسَلَ الْجَارِیَۃَ ، فَقَالَ : اُنْظُرِی مَنْ بِالْبَابِ ، فَرَجَعَتْ إلَیْہِ ، فَقَالَتْ : عَلْقَمَۃُ وَالأَسْوَدُ ، فَقَالاَ : ائْذَنِی لَہُمَا ، فَدَخَلْنَا ، فَقَالَ : کَأَنَّکُمَا قَدْ أَطَلْتُمَا الْجُلُوسَ بِالْبَابِ ؟ قَالاَ : أَجَلْ ، قَالَ : فَمَا مَنَعَکُمَا أَنْ تَسْتَأْذِنَا ؟ قَالاَ: خَشِینَا أَنْ تَکُونَ نَائِمًا ، قَالَ : مَا کُنْت أُحِبُّ أَنْ تَظُنُّوا بِی ہَذَا ، إنَّ ہَذِہِ سَاعَۃٌ کُنَّا نُشَبِّہُہَا بِصَلاَۃِ اللَّیْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 4101","","","كتاب الصلوات"
"4102","(۴۱۰۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : صَلاَۃُ الأَوَّابِینَ بَعْدَ زَوَالِ الشَّمْسِ۔","","Musannaf Ibn Abi Shaybah 4102","","","كتاب الصلوات"
"4103","(۴۱۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ بْنِ الْحَارِثِ ، عَنْ أَبِی عَوْنٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی عَلَی فَرْوَۃٍ مَدْبُوغَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 4103","","","كتاب الصلوات"
"4104","(۴۱۰۴) حَدَّثَنَا حَفْصٌ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ؛ أَنَّہُ کَانَ یَدْبُغُ جِلْدَ أُضْحِیَّتِہِ ، فَیَتَّخِذَہُ مُصَلًّی یُصَلِّی عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4104","","","كتاب الصلوات"
"4105","(۴۱۰۵) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامِ بْنِ یَزِیدَ ، عَنْ إسْمَاعِیلَ بْنِ رَجَائٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ أَنَّہُ کَانَ یَدْبُغُ جِلْدَ أُضْحِیَّتِہِ ، فَیَتَّخِذُہُ مُصَلًّی یُصَلِّی عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4105","","","كتاب الصلوات"
"4106","(۴۱۰۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ وَأَصْحَابِہِ ؛ أَنَّہُمَا کَانُوا یَکْرَہُونَ أَنْ یُصَلُّوا عَلَی الْفِرَائِ۔","","Musannaf Ibn Abi Shaybah 4106","","","كتاب الصلوات"
"4107","(۴۱۰۷) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِلاَلِ بْنِ خَبَّابٍ ، قَالَ : دَخَلْتُ عَلَی عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ بِالْمَدَائِنِ وَہُوَ یُصَلِّی فِی بَیْتِہِ عَلَی جِلْدِ فَرْوِ ضَأْنٍ ، الصُّوفُ ظَاہِرٌ یَلِی قَدَمَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4107","","","كتاب الصلوات"
"4108","(۴۱۰۸) حَدَّثَنَا شَرِیکٌ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، قَالَ : کَانَ سُوَیْد بْنُ غَفَلَۃَ یُکَبِّرُ إذَا قَالَ الْمُؤَذِّنُ قَدْ قَامَتِ الصَّلاَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4108","","","كتاب الصلوات"
"4109","(۴۱۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ قَیْسٍ ؛ أَنَّہُ کَانَ یُکَبِّرُ إذَا قَالَ الْمُؤَذِّنُ قَدْ قَامَتِ الصَّلاَۃُ ، یَعْنِی فِی الأُولَی۔","","Musannaf Ibn Abi Shaybah 4109","","","كتاب الصلوات"
"4110","(۴۱۱۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إِنْ کُنْت لأَسْمَعُ الْمُؤَذِّنَ یُصَوِّتُ بَعْدَ مَا یُکَبِّرُ إبْرَاہِیمُ لِلصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 4110","","","كتاب الصلوات"
"4111","(۴۱۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إِنْ شَائَ کَبَّرَ إذَا قَالَ قَدْ قَامَتِ الصَّلاَۃُ ، وَإِنْ شَائَ انْتَظَرَ حَتَّی یَفْرُغَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4111","","","كتاب الصلوات"
"4112","(۴۱۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحِلٍّ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُکَبِّرُ إذَا قَالَ الْمُؤَذِّنُ قَدْ قَامَتِ الصَّلاَۃُ فِی الثَّانِیَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4112","","","كتاب الصلوات"
"4113","(۴۱۱۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ?? کَرِہَ أَنْ یَقُومَ الإِمَامُ حَتَّی یَقُولَ الْمُؤَذِّنُ قَدْ قَامَتِ الصَّلاَۃُ، وَکَرِہَ أَنْ یُکَبِّرَ حَتَّی یَفْرُغَ الْمُؤَذِّنُ مِنْ إقَامَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4113","","","كتاب الصلوات"
"4114","(۴۱۱۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ إذَا قَالَ الْمُؤَذِّنُ حَیَّ عَلَی الصَّلاَۃِ قامَ ، فَإذَا قَالَ قَدْ قَامَتِ الصَّلاَۃُ کَبَّرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4114","","","كتاب الصلوات"
"4115","(۴۱۱۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ یَحْیَی بْنِ وَثَّابٍ ، قَالَ : کَانَ یَسْکُتُ حَتَّی یَفْرُغَ الْمُؤَذِّنُ ، ثُمَّ یُکَبِّرَ ۔ وَکَانَ إبْرَاہِیمُ یَقُولُ إذَا قَامَتِ الصَّلاَۃُ کَبَّرَ۔","","Musannaf Ibn Abi Shaybah 4115","","","كتاب الصلوات"
"4116","(۴۱۱۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ مَعْمَرٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی قَتَادَۃَ ، عَنْ أَبِیہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا أُقِیمَتِ الصَّلاَۃُ فَلاَ تَقُومُوا حَتَّی تَرَوْنِی۔ (بخاری ۶۳۷۔ مسلم ۱۵۶)","Sahih","Musannaf Ibn Abi Shaybah 4116","","","كتاب الصلوات"
"4117","(۴۱۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، عَنْ زَائِدَۃَ بْنِ نَشِیطٍ ، عَنْ أَبِی خَالِدٍ الْوَالِبِیِّ ، قَالَ : خَرَجَ عَلِیٌّ وَقَدْ أُقِیمَتِ الصَّلاَۃُ وَہُمْ قِیَامٌ یَنْتَظِرُونَہُ ، فَقَالَ : مَا لِی أَرَاکُمْ سَامِدِینَ ؟۔","Hasan","Musannaf Ibn Abi Shaybah 4117","","","كتاب الصلوات"
"4118","(۴۱۱۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَقُومَ الرَّجُلُ إذَا قَالَ الْمُؤَذِّنُ قَدْ قَامَتِ الصَّلاَۃُ ، وَلَیْسَ عِنْدَہُمُ الإِمَامُ ، وَکَانُوا یَکْرَہُونَ أَنْ یَنْتَظِرُوا الإِمَامَ قِیَامًا، وَکَانَ یُقَالُ: ہُوَ السَّمُودُ۔","","Musannaf Ibn Abi Shaybah 4118","","","كتاب الصلوات"
"4119","(۴۱۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : الْقَوْمُ یَنْتَظِرُونَ الإِمَامَ قِیَامًا ، أَوْ قُعُودًا ؟ قَالَ : لاَ ، بَلْ قُعُودًا۔","","Musannaf Ibn Abi Shaybah 4119","","","كتاب الصلوات"
"4120","(۴۱۲۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الْقَوْمِ یَنْتَظِرُونَ الإِمَامَ قِیَامًا ، قَالَ : ذَلِکَ السَّمُودُ۔","","Musannaf Ibn Abi Shaybah 4120","","","كتاب الصلوات"
"4121","(۴۱۲۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ أَبِی عُبَیْدٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : سَمِعْت عُمَرَ بْنَ عَبْدِ الْعَزِیزِ بِخَنَاصِرَۃَ یَقُولُ حِینَ یَقُولُ الْمُؤَذِّنُ قَدْ قَامَتِ الصَّلاَۃُ : قُومُوا ، قَدْ قَامَتِ الصَّلاَۃُ۔","","Musannaf Ibn Abi Shaybah 4121","","","كتاب الصلوات"
"4122","(۴۱۲۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَ أَنْ یَقُومَ الإِمَامُ حَتَّی یَقُولَ الْمُؤَذِّنُ قَدْ قَامَتِ الصَّلاَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4122","","","كتاب الصلوات"
"4123","(۴۱۲۳) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، قَالَ : رَأَی عُبَیْدُ اللہِ بْنُ أَبِی یَزِیدَ حُسَیْنَ بْنَ عَلِیٍّ فِی حَوْضِ زَمْزَمَ ، وَقَدْ أُقِیمَتِ الصَّلاَۃُ ، فَشَجر بَیْنَ الإِمَامِ وَبَعْضِ النَّاسِ شَیْئٌ ، وَنَادَی الْمُنَادِی : قَدْ قَامَتِ الصَّلاَۃُ ، فَجَعَلُوا یَقُولُونَ لَہُ : اجْلِسْ ، فَیَقُولُ : قَدْ قَامَتِ الصَّلاَۃُ ۔","","Musannaf Ibn Abi Shaybah 4123","","","كتاب الصلوات"
"4124","(۴۱۲۴) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ جَابِرِ بْنِ یَزِیدَ بْنِ مُرَّۃَ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : إذَا دَخَلَ الرَّجُلُ وَالْمُؤَذِّنُ یُقِیمُ الصَّلاَۃَ ، قَالَ : لِیَقُمْ کَمَا ہُوَ إِنْ شَائَ ، فَإِنَّ ذَلِکَ یُرْفِقُ بِالرَّجُلِ الْکَبِیرِ ، وَقَالَ عَامِرٌ: لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 4124","","","كتاب الصلوات"
"4125","(۴۱۲۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : بَلَغَنِی أَنَّ إبْرَاہِیمَ انْتَہَی إلَی الْمَسْجِدِ وَقَدْ أَخَذَ الْمُؤَذِّنُ فِی الإِقَامَۃِ ، فَوَضَعَ رِجْلَہُ بَیْنَ الظُّلَّۃِ وَالصَّحْنِ حَتَّی فَرَغَ مِنَ الإِقَامَۃِ۔","","Musannaf Ibn Abi Shaybah 4125","","","كتاب الصلوات"
"4126","(۴۱۲۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، قَالَ : قَالَ سُوَیْد : لَوِ اسْتَطَعْتُ لَکُنْت أُؤَذِّنُ لَہُمْ وَأَؤُمُّہُمْ ، قَالَ : فَذَکَرْت ذَلِکَ لِمُصْعَبِ بْنِ سَعْدٍ ، فَقَالَ : أَمَا إنَّ ذَلِکَ لَیْسَ مِنَ السُّنَّۃِ أَنْ یَکُونَ مُؤَذِّنًا وَإِمَامًا۔","","Musannaf Ibn Abi Shaybah 4126","","","كتاب الصلوات"
"4127","(۴۱۲۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی رَوَّادٍ ، عَنْ أَصْبَغَ ، قَالَ : کَانَ ابْنُ عُمَرَ یُؤَذِّنُ لَنَا وَیَؤُمُّنَا فِی السَّفَرِ۔","Sahih","Musannaf Ibn Abi Shaybah 4127","","","كتاب الصلوات"
"4128","(۴۱۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ ضِرَارِ بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْہُذَیْلِ الْعَنَزِیِّ ، قَالَ : قَالَ عُمَرُ: لَوْلاَ أَنْ یَکُونَ سُنَّۃً لأَذَّنْتُ۔","Sahih","Musannaf Ibn Abi Shaybah 4128","","","كتاب الصلوات"
"4129","(۴۱۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، قَالَ : قیلَ لِلأَسْوَدِ بْنِ ہِلاَلٍ : تَقَدَّمْ ، فَقَالَ : أَرَاضُونَ أَنْتُمْ ؟","No Data Available","Musannaf Ibn Abi Shaybah 4129","","","كتاب الصلوات"
"4130","(۴۱۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ قَیْسٍ الْحَضْرَمِیُّ ، عَنِ الْعَیْزَارِ بْنِ جَرْوَلٍ ؛ أَنَّ قَوْمًا شَکَوْا إمَامًا لَہُمْ إلَی عَلِیٍّ ، فَقَالَ لَہُ عَلِیٌّ : إنَّک لَخَرُوطٌ ، تَؤُمُّ قَوْمًا وَہُمْ کَارِہُونَ۔","Hasan","Musannaf Ibn Abi Shaybah 4130","","","كتاب الصلوات"
"4131","(۴۱۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو عُبَیْدَۃَ النَّاجِی ، عَنِ الْحَسَنِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ أَمَّ قَوْمًا وَہُمْ لَہُ کَارِہُونَ ، لَمْ تَجُزْ صَلاَتُہُ تَرْقُوَتَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 4131","","","كتاب الصلوات"
"4132","(۴۱۳۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنِ الْمِنْہَالِ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : ثَلاَثَۃٌ لاَ تُجَاوِزُ صَلاَۃُ أَحَدِہِمْ رَأْسَہُ ؛ إمَامُ قَوْمٍ وَہُمْ لَہُ کَارِہُونَ ، وَامْرَأَۃٌ تَعْصِی زَوْجَہَا ، وَعَبْدٌ أَبَقَ مِنْ سَیِّدِہِ۔","","Musannaf Ibn Abi Shaybah 4132","","","كتاب الصلوات"
"4133","(۴۱۳۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ زِیَادِ بْنِ أَبِی الْجَعْدِ ، عَنْ عَمْرِو بْنِ الْحَارِثِ بْنِ الْمُصْطَلِقِ، قَالَ: کَانَ یُقَالُ: أَشَدُّ النَّاسِ عَذَابًا؛ امْرَأَۃٌ تَعْصِی زَوْجَہَا، وَإِمَامُ قَوْمٍ وَہُمْ لَہُ کَارِہُونَ۔(ترمذی ۳۵۹)","Majhul","Musannaf Ibn Abi Shaybah 4133","","","كتاب الصلوات"
"4134","(۴۱۳۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ہِشَامُ بْنُ حَسَّانَ ، قَالَ : حَدَّثَنَا الْحَسَنُ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : ثَلاَثَۃٌ لاَ تُقْبَلُ لَہُمْ صَلاَۃٌ ؛ رَجُلٌ أَمَّ قَوْمًا وَہُمْ لَہُ کَارِہُونَ ، وَالْعَبْدُ إذَا أَبَقَ حَتَّی یَرْجِعَ إلَی مَوْلاَہُ ، وَامْرَأَۃٌ إذَا بَاتَتْ مُہَاجِرَۃً لِزَوْجِہَا ، عَاصِیَۃً لَہُ۔ (ابن ماجہ ۹۷۱)","","Musannaf Ibn Abi Shaybah 4134","","","كتاب الصلوات"
"4135","(۴۱۳۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، قَالَ : سَمِعْتُ الْقَاسِمَ بْنَ مُخَیْمِرَۃَ یَذْکُرُ ؛ أَنَّ سَلْمَانَ قَدَّمَہُ قَوْمٌ یُصَلِّی بِہِمْ ، فَأَبَی حَتَّی دَفَعُوہُ ، فَلَمَّا صَلَّی بِہِمْ قَالَ : کُلّکُمْ رَاضٍ ؟ قَالُوا : نَعَمْ ، قَالَ : الْحَمْدُ لِلَّہِ ، إنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : ثَلاَثَۃٌ لاَ تُقْبَلُ صَلاَتُہُمُ ؛ الْمَرْأَۃُ تَخْرُجُ مِنْ بَیْتِہَا بِیْرِ ، إذْنِہِ ، وَالْعَبْدُ الآبِقُ ، وَالرَّجُلُ یَؤُمُّ الْقَوْمَ وَہُمْ لَہُ کَارِہُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 4135","","","كتاب الصلوات"
"4136","(۴۱۳۶) حَدَّثَنَا عَلِیُّ بْنُ حَسَنِ بْنِ شَقِیقٍ ، عَنْ حُسَیْنِ بْنِ وَاقِدٍ ، عَنْ أَبِی غَالِبٍ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ثَلاَثَۃٌ لاَ تُجَاوِزُ صَلاَتُہُمْ رُؤُوسَہُمْ حَتَّی یَرْجِعُوا ؛ الْعَبْدُ الآبِقُ ، وَامْرَأَۃٌ بَاتَتْ وَزَوْجُہَا عَلَیْہَا سَاخِطٌ ، وَإِمَامُ قَوْمٍ وَہُمْ لَہُ کَارِہُونَ۔ (ترمذی ۳۶۰۔ طبرانی ۸۰۹۸)","Da'if","Musannaf Ibn Abi Shaybah 4136","","","كتاب الصلوات"
"4137","(۴۱۳۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، عَنْ حُذَیْفَۃَ ، قَالَ : خَرَجَ فِی سَفَرٍ فَتَقَدَّمَ فَأَمَّہُمْ ، ثُمَّ قَالَ : لَتَلْتَمِسُنَّ إمَامًا غَیْرِی ، أَوْ لَتُصَلُّنَّ وُحْدَانًا۔","","Musannaf Ibn Abi Shaybah 4137","","","كتاب الصلوات"
"4138","(۴۱۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَشْیَاخِ مُحَارِبٍ ، قَالَ : قَالَ حُذَیْفَۃُ : لَتَبْتَغُنَّ إمَامًا غَیْرِی ، أَوْ لَتُصَلُّنَّ وُحْدَانًا۔","Majhul","Musannaf Ibn Abi Shaybah 4138","","","كتاب الصلوات"
"4139","(۴۱۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ابْتَدِرُوا الأَذَانَ ، وَلاَ تَبْتَدِرُوا الإِمَامَۃَ۔","","Musannaf Ibn Abi Shaybah 4139","","","كتاب الصلوات"
"4140","(۴۱۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ عُقْبَۃَ أبِی کِبْرَانَ ، أَنَّہُ قَالَ : کُنَّا مَعَ الضَّحَّاکِ فَقَالَ : إِنْ کَانَ مِنْکُمْ مَنْ یَتَقَدَّمُ فَلْیُؤَذِّنْ وَلْیُصَلِّ ، قَالَ : فَأَبَوْا ، فَصَلَّیْنَا وُحْدَانًا۔","","Musannaf Ibn Abi Shaybah 4140","","","كتاب الصلوات"
"4141","(۴۱۴۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَاصِمٍ ، قَالَ : أَمَّ أَبُو عُبَیْدَۃَ قَوْمًا مَرَّۃً ، فَلَمَّا انْصَرَفَ قَالَ : مَا زَالَ عَلَیَّ الشَّیْطَانُ آنِفًا حَتَّی رَأَیْت أَنَّ الْفَضْلَ لِی عَلَی مَنْ خَلْفِی ، لاَ أَؤُمّ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 4141","","","كتاب الصلوات"
"4142","(۴۱۴۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ حُذَیْفَۃُ یَتَخَلَّفُ عَنِ الإِمَامَۃِ ، قَالَ : فَأُقِیمَتِ الصَّلاَۃُ ذَاتَ یَوْمٍ ، قَالَ : فَتَخَلَّفَ عَبْدُ اللہِ ، قَالَ : فَتَقَدَّمَ حُذَیْفَۃُ ، فَلَمَّا قَضَی صَلاَتَہُ ، قَالَ لَہُم : لَتَبْتَغُنَّ، أَوْ کَلِمَۃً غَیْرَہَا ، إمَامًا غَیْرِی ، أَوْ لَتُصَلُّنَّ فُرَادَی ۔ قَالَ : فَقَالَ مُجَاہِدٌ : قَالَ أَبُو مَعْمَرٍ ، عَنْ حُذَیْفَۃَ أَنَّہُ قَالَ : أَوْ لَتُصَلُّنَّ وُحْدَانًا ، قَالَ : فَقَالَ إبْرَاہِیمُ : أَوْ قَالَ : لَتُصَلُّنَّ وُحْدَانًا۔","Sahih","Musannaf Ibn Abi Shaybah 4142","","","كتاب الصلوات"
"4143","(۴۱۴۳) حَدَّثَنَا ہُشَیْمٌ، قَالَ: أَخْبَرَنَا الْعَوَّامُ، قَالَ: حَدَّثَنَا عَبْدُاللہِ بْنُ أَبِی الْہُذَیْلِ، قَالَ: کَانَ شَیْخٌ مِنْ تِلْکَ الشُّیُوخِ یَؤُمُّ قَوْمَہُ ثُمَّ تَرَکَ ذَلِکَ ، قَالَ : فَلَقِیَہُ بَعْضُ إِخْوَانِہِ ، فَقَالَ لَہُ : لِمَ تَرَکْت إمَامَۃَ قَوْمِکَ ؟ قَالَ : کَرِہْتُ أَنْ یَمُرَّ الْمَارُّ فَیَرَانِی أُصَلِّی فَیَقُولُ : مَا قَدَّمَ ہَؤُلاَء ہَذَا الرَّجُلَ إِلاَّ وَہُوَ خَیْرُہُمْ ، وَاللَّہِ لاَ أَؤُمُّہُمْ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 4143","","","كتاب الصلوات"
"4144","(۴۱۴۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، قَالَ : کُنْتُ مَعَ ابْنِ سِیرِینَ فِی جِنَازَۃٍ ، فَلَمَّا انْصَرَفْنَا حضَرَتِ الصَّلاَۃُ ، قَالَ : فَلَمَّا أُقِیمَتْ قِیلَ لابْنِ سِیرِینَ : تَقَدَّمْ ، قَالَ : فَقَالَ : لِیَتَقَدَّمْ بَعْضُکُمْ ، وَلاَ یَتَقَدَّمْ إِلاَّ مَنْ قَرَأَ الْقُرْآنَ ، قَالَ ، ثُمَّ قَالَ لِی : تَقَدَّمْ ، فَتَقَدَّمْتُ فَصَلَّیْتُ بِہِمْ ، فَلَمَّا فَرَغْت قُلْتُ فِی نَفْسِی : مَاذَا صَنَعْت ؟ شَیْئًا کَرِہَہُ ابْنُ سِیرِینَ لِنَفْسِہِ تَقَدَّمْت عَلَیْہِ ، فَقُلْتُ لَہُ : یَرْحَمُکَ اللَّہُ ، أَمَرْتَنِی بِشَیْئٍ کَرِہْتَہُ لِنَفْسِکَ ؟ فَقَالَ : إنِّی کَرِہْتُ أَنْ یَمُرَّ الْمَارُّ فَیَقُولَ : ہَذَا ابْنُ سِیرِینَ یَؤُمّ النَّاسَ۔","","Musannaf Ibn Abi Shaybah 4144","","","كتاب الصلوات"
"4145","(۴۱۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : أَخْبَرَنَا عِکْرِمَۃُ بْنُ عَمَّارٍ الْیَمَامِیُّ ، عَنْ ضَمْضَمِ بْنِ جَوْسٍ الْہِفَّانِیِّ ، عَنْ عَبْدِ اللہِ بْنِ حَنْظَلَۃَ بْنِ الرَّاہِبِ ، قَالَ : صَلَّی بِنَا عُمَرُ بْنُ الْخَطَّابِ فَنَسِیَ أَنْ یَقْرَأَ فِی الرَّکْعَۃِ الأُولَی ، فَلَمَّا قَامَ فِی الرَّکْعَۃِ الثَّانِیَۃِ قَرَأَ بِفَاتِحَۃِ الْکِتَابِ مَرَّتَیْنِ وَسُورَتَیْنِ ، فَلَمَّا قَضَی الصَّلاَۃَ سَجَدَ سَجْدَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 4145","","","كتاب الصلوات"
"4146","(۴۱۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ أَنَّہُ نَسِیَ أَنْ یَقْرَأَ فِی الأُولَیَیْنِ ، فَقَرَأَ فِی الأُخْرَیَیْنِ۔","","Musannaf Ibn Abi Shaybah 4146","","","كتاب الصلوات"
"4147","(۴۱۴۷) حَدَّثَنَا أَسْبَاطٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا نَسِیَ أَنْ یَقْرَأَ فِی الأُولَیَیْنِ ، قَرَأَ فِی الأُخْرَیَیْنِ۔","","Musannaf Ibn Abi Shaybah 4147","","","كتاب الصلوات"
"4148","(۴۱۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، وَالْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کُنْتُ أَقُومُ خَلْفَ الأَسْوَدِ حَتَّی یَنْزِلَ الْمُؤَذِّنُ۔","","Musannaf Ibn Abi Shaybah 4148","","","كتاب الصلوات"
"4149","(۴۱۴۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَقُومُ خَلْفَ الإِمَامِ مَا بَیْنَہُ وَبَیْنَ الرَّکْعَۃِ ، فَإِنْ جَائَ أَحَدٌ ، وَإِلاَّ قَامَ عَنْ یَمِینِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4149","","","كتاب الصلوات"
"4150","(۴۱۵۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَقَدْ رَأَیْتُنِی أَقُومُ خَلْفَ عَلْقَمَۃَ حَتَّی یَدْخُلَ دَاخِلٌ ، أَوْ یَنْزِلَ مُؤَذِّنٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 4150","","","كتاب الصلوات"
"4151","(۴۱۵۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ قَیْسِ بْنِ عَبَایَۃَ ، قَالَ : حدَّثَنِی ابْنُ عَبْدِ اللہِ بْنِ مُغَفَّلٍ ، عَنْ أَبِیہِ ، قَالَ ، وَلَمْ أَرَ رَجُلاً مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ أَشَدَّ عَلَیْہِ حَدَثٌ فِی الإِسْلاَمِ مِنْہُ ، قَالَ : سَمِعَنِی أَبِی وَأَنَا أَقْرَأُ : {بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیم} قَالَ : یَا بُنَیَّ ، إیَّاکَ وَالْحَدَثَ ، فَإِنِّی قَدْ صَلَّیْت خَلْفَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبِی بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ فَلَمْ أَسْمَعْ أَحَدًا مِنْہُمْ یَقُولُ ذَلِکَ ، إذَا قَرَأْت فَقُلِ : {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔ (ترمذی ۲۴۴۔ احمد ۵۵)","Hasan","Musannaf Ibn Abi Shaybah 4151","","","كتاب الصلوات"
"4152","(۴۱۵۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ ، عَنْ أَنَسٍ ، أَنَّ أَبَا بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ کَانُوا یَسْتَفْتِحُونَ الْقِرَائَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ} ۔ قَالَ حُمَیْدٌ : وَأَحْسَبُہُ ذَکَرَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (عبدالرزاق ۲۵۹۲۔ ابو یعلی ۳۵۰۹)","Sahih","Musannaf Ibn Abi Shaybah 4152","","","كتاب الصلوات"
"4153","(۴۱۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، قَالَ : حَدَّثَنَا قَتَادَۃُ ، عَنْ أَنَسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَبَا بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ کَانُوا یَسْتَفْتِحُونَ الْقِرَائَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔ (بخاری ۷۴۳۔ مسلم ۲۹۹)","Sahih","Musannaf Ibn Abi Shaybah 4153","","","كتاب الصلوات"
"4154","(۴۱۵۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حُسَیْنٌ الْمُعَلِّمُ ، عَنْ بُدَیْلٍ ، عَنْ أَبِی الْجَوْزَائِ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَفْتَتِحُ الصَّلاَۃَ بِالتَّکْبِیرِ ، وَالْقِرَائَۃِ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","Sahih","Musannaf Ibn Abi Shaybah 4154","","","كتاب الصلوات"
"4155","(۴۱۵۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یَفْتَتِحُ الْقِرَائَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","Da'if","Musannaf Ibn Abi Shaybah 4155","","","كتاب الصلوات"
"4156","(۴۱۵۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ؛ أَنَّہُ کَانَ یَسْتَفْتِحُ الْقِرَائَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","Hasan","Musannaf Ibn Abi Shaybah 4156","","","كتاب الصلوات"
"4157","(۴۱۵۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ یُخْفِی {بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیم}۔","","Musannaf Ibn Abi Shaybah 4157","","","كتاب الصلوات"
"4158","(۴۱۵۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَفْتَتِحُ الْقِرَائَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","No Data Available","Musannaf Ibn Abi Shaybah 4158","","","كتاب الصلوات"
"4159","(۴۱۵۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، وَمُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُخْفِی الإِمَامُ بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیم وَالاسْتِعَاذَۃَ ، وَآمِینَ ، وَرَبَّنَا لَکَ الْحَمْدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4159","","","كتاب الصلوات"
"4160","(۴۱۶۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ سَعِیدِ بْنِ الْمَرْزُبَانِ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یُخْفِی {بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیم} وَالاسْتِعَاذَۃَ ، وَرَبَّنَا لَکَ الْحَمْدُ۔","Da'if","Musannaf Ibn Abi Shaybah 4160","","","كتاب الصلوات"
"4161","(۴۱۶۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : جَہْرُ الإِمَامِ بـ {بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیم} بِدْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 4161","","","كتاب الصلوات"
"4162","(۴۱۶۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، وَابْنِ الزُّبَیْرِ ؛ أَنَّہُمَا کَانَا لاَ یَجْہَرَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 4162","","","كتاب الصلوات"
"4163","(۴۱۶۳) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ؛ أَنْ أَبَا بَکْرٍ کَانَ یَفْتَتِحُ الْقِرَائَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","","Musannaf Ibn Abi Shaybah 4163","","","كتاب الصلوات"
"4164","(۴۱۶۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَاصِمٍ ، قَالَ ، سَمِعْت أَبَا وَائِلٍ یَسْتَفْتِحُ الْقِرَائَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","No Data Available","Musannaf Ibn Abi Shaybah 4164","","","كتاب الصلوات"
"4165","(۴۱۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا وَأَبَا إِسْحَاقَ عَنِ الْجَہْرِ ؟ قالوا : اقْرَأْ : (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیم) فِی نَفْسِک۔","","Musannaf Ibn Abi Shaybah 4165","","","كتاب الصلوات"
"4166","(۴۱۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی بَشِیرٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الْجَہْرُ بـ (بسم اللہِ الرَّحْمَنِ الرَّحِیمِ) قِرَائَۃُ الأَعْرَابِ۔","Sahih","Musannaf Ibn Abi Shaybah 4166","","","كتاب الصلوات"
"4167","(۴۱۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : صَلَّیْت خَلْفَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبِی بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ فَلَمْ یَجْہَرُوا بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔ (بخاری ۷۴۳۔ مسلم ۲۹۹)","Sahih","Musannaf Ibn Abi Shaybah 4167","","","كتاب الصلوات"
"4168","(۴۱۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبَا بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ کَانُوا یَسْتَفْتِحُونَ الصَّلاَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","Sahih","Musannaf Ibn Abi Shaybah 4168","","","كتاب الصلوات"
"4169","(۴۱۶۹) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ ، عَنْ ثُوَیْرٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا کَانَ لاَ یَجْہَرُ بِـ (بسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","Da'if","Musannaf Ibn Abi Shaybah 4169","","","كتاب الصلوات"
"4170","(۴۱۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لاَ یُجْہَرُ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","","Musannaf Ibn Abi Shaybah 4170","","","كتاب الصلوات"
"4171","(۴۱۷۱) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ الرَّازِیّ ، عَنْ أَبِی سِنَانٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : صَلَّیْت خَلْفَ عُمَرَ سَبْعِینَ صَلاَۃً ، فَلَمْ یَجْہَرْ فِیہَا بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","Hasan","Musannaf Ibn Abi Shaybah 4171","","","كتاب الصلوات"
"4172","(۴۱۷۲) حَدَّثَنَا شَاذَانُ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی وَائِلٍ ؛ أَنَّ عَلِیًّا وَعَمَّارًا کَانَا لاَ یَجْہَرَانِ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","Hasan","Musannaf Ibn Abi Shaybah 4172","","","كتاب الصلوات"
"4173","(۴۱۷۳) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، قَالَ : أَخْبَرَنَا مَالِکُ بْنُ زِیَادٍ ، قَالَ : صَلَّی بِنَا عُمَرُ بْنُ عَبْدِ الْعَزِیزِ فَافْتَتَحَ الصَّلاَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","No Data Available","Musannaf Ibn Abi Shaybah 4173","","","كتاب الصلوات"
"4174","(۴۱۷۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو مَعْشَرٍ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّہُ کَانَ یَجْہَرُ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","Da'if","Musannaf Ibn Abi Shaybah 4174","","","كتاب الصلوات"
"4175","(۴۱۷۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ وِقَائٍ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ یَجْہَرُ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","","Musannaf Ibn Abi Shaybah 4175","","","كتاب الصلوات"
"4176","(۴۱۷۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، وَمُجَاہِدٍ ؛ أَنَّہُمْ کَانُوا یَجْہَرُونَ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","No Data Available","Musannaf Ibn Abi Shaybah 4176","","","كتاب الصلوات"
"4177","(۴۱۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الأَزْرَقِ بْنِ قَیْسٍ ، قَالَ : سَمِعْتُ ابْنَ الزُّبَیْرِ قَرَأَ : (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ) ، ثُمَّ قَرَأَ : (الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ) ثُمَّ قَرَأَ : (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","Sahih","Musannaf Ibn Abi Shaybah 4177","","","كتاب الصلوات"
"4178","(۴۱۷۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا افْتَتَحَ ألصَّلاَۃَ قَرَأَ : (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ) فَإِذَا فَرَغَ مِنَ الْحَمْدِ قَرَأَ : (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","Sahih","Musannaf Ibn Abi Shaybah 4178","","","كتاب الصلوات"
"4179","(۴۱۷۹) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، وَمُعَاذُ بْنُ مُعَاذٍ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ؛ أَنَّ ابْنَ الزُّبَیْرِ کَانَ یَجْہَرُ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ) وَیَقُولُ : مَا یَمْنَعُہُمْ مِنْہَا إِلاَّ الْکِبْرُ۔","Sahih","Musannaf Ibn Abi Shaybah 4179","","","كتاب الصلوات"
"4180","(۴۱۸۰) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ أَبِیہِ ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ ؛ أَنَّ عُمَرَ جَہَرَ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","Hasan","Musannaf Ibn Abi Shaybah 4180","","","كتاب الصلوات"
"4181","(۴۱۸۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَقُولُ : إذَا قَرَأَ الرَّجُلُ فِی صَلاَتِہِ مَرَّۃً وَاحِدَۃً (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ) أَجْزَأَہُ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4181","","","كتاب الصلوات"
"4182","(۴۱۸۲) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : إذَا تَعَوَّذَ مَرَّۃً ، وَقَرَأَ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ) أَجْزَأَہُ لِبَقِیَّۃِ صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 4182","","","كتاب الصلوات"
"4183","(۴۱۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یَقْرَأُ : (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ) فِی کُلِّ رَکْعَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 4183","","","كتاب الصلوات"
"4184","(۴۱۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا ، وَأَبَا إِسْحَاقَ فَقَالُوا : اقْرَأْ فِی کُلِّ رَکْعَۃٍ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ) ۔","No Data Available","Musannaf Ibn Abi Shaybah 4184","","","كتاب الصلوات"
"4185","(۴۱۸۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، وَأَبِی إِسْحَاقَ؛ فِی الرَّجُلِ یَقْرَأُ فِی الرَّکْعَۃِ بِالسُّورَتَیْنِ، کُلَّمَا قَرَأَ سُورَۃً اسْتَفْتَحَ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","No Data Available","Musannaf Ibn Abi Shaybah 4185","","","كتاب الصلوات"
"4186","(۴۱۸۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ طَلْحَۃَ ؛ أَنَّہُ کَانَ یَقْرَأُ فِی الْمُصْحَفِ ، فَکَانَ کُلَّمَا خَتَمَ سُورَۃً قَرَأَ : (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","No Data Available","Musannaf Ibn Abi Shaybah 4186","","","كتاب الصلوات"
"4187","(۴۱۸۷) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ کَثِیرِ بْنِ شِنْظِیرٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إذَا انْتَہَی الرَّجُلُ إلَی الْقَوْمِ وَہُمْ قُعُودٌ فِی آخِرِ الصَّلاَۃِ ، فَقَدْ دَخَلَ فِی التَّضْعِیفِ ، وَإِذَا انْتَہَی إلَیْہِمْ وَقَدْ سَلَّمَ الإِمَامُ ، وَلَمْ یَتَفَرَّقُوا ، فَقَدْ دَخَلَ فِی التَّضْعِیفِ۔nوَقَالَ عَطَائٌ : کَانَ یُقَالُ : إذَا خَرَجَ مِنْ بَہِتِگ وَہُوَ یَنْوِیہِمْ فَأَدْرَکَہُمْ ، أَوْ لَمْ یُدْرِکْہُمْ ، فَقَدْ دَخَلَ فِی التَّضْعِیفِ۔","Sahih","Musannaf Ibn Abi Shaybah 4187","","","كتاب الصلوات"
"4188","(۴۱۸۸) حَدَّثَنَا شَرِیکٌ ، عَنْ عَامِرِ بْنِ شَقِیقٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ أَدْرَکَ التَّشَہُّدَ ، فَقَدْ أَدْرَکَ الصَّلاَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 4188","","","كتاب الصلوات"
"4189","(۴۱۸۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی سَلَمَۃَ ، قَالَ : مَنْ خَرَجَ مِنْ بَیْتِہِ قَبْلَ أَنْ یُسَلِّمَ الإِمَامُ ، فَقَدْ أَدْرَکَ۔","","Musannaf Ibn Abi Shaybah 4189","","","كتاب الصلوات"
"4190","(۴۱۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنِ ابْنِ صُہَیْبٍ ، قَالَ : کَانَ زَرٌّ ، وَأَبُو وَائِلٍ إذَا رَأَوْنَا فِی الصَّفِّ ، وَنَحْنُ صِبْیَانٌ أَخْرَجُونَا۔","","Musannaf Ibn Abi Shaybah 4190","","","كتاب الصلوات"
"4191","(۴۱۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِیہِ ، عَنْ ہِلاَلٍ ، عَنْ عَبْدِ اللہ بْنِ عُکَیْمٍ ؛ أَنَّہُ کَانَ إذَا رَأَی صَبِیًّا فِی الصَّفِّ أَخْرَجَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4191","","","كتاب الصلوات"
"4192","(۴۱۹۲) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ أَبَانَ الْعَطَّارِ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ کَانَ إذَا رَأَی غُلاَمًا فِی الصَّفِّ أَخْرَجَہُ۔","","Musannaf Ibn Abi Shaybah 4192","","","كتاب الصلوات"
"4193","(۴۱۹۳) حَدَّثَنَا شَرِیکُ بْنُ عَبْدِ اللہِ ، عَنْ یَحْیَی بْنِ ہَانِیئٍ الْمُرَادِیِّ ، عَنْ رَجُلٍ مِنْ قَوْمِہِ ؛ أَنَّ حُذَیْفَۃَ کَانَ یُفَرِّقُ بَیْنَ الصِّبْیَانِ فِی الصَّفِّ ، أَوَ قَالَ : فِی الصَّلاَۃِ۔","Majhul","Musannaf Ibn Abi Shaybah 4193","","","كتاب الصلوات"
"4194","(۴۱۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، أَوْ ہِلاَلٍ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ عَلِیٌّ : الْمُؤَذِّنُ أَمْلَکُ بِالأَذَانِ ، وَالإِمَامُ أَمْلَکُ بِالإِقَامَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 4194","","","كتاب الصلوات"
"4195","(۴۱۹۵) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنِ الْحَسَنِ بْنِ عُبَیْدِاللہِ، قَالَ: کَانُوا یَنْتَظِرُونَ الأَسْوَدَ، وَکَانَ إمَامَہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 4195","","","كتاب الصلوات"
"4196","(۴۱۹۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : کَانُوا یَنْتَظِرُونَ الإِمَامَ حَتَّی یَنْزِلَ الْمُؤَذِّنُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4196","","","كتاب الصلوات"
"4197","(۴۱۹۷) حَدَّثَنَا وَکِیعٌ ، قَالَ :حَدَّثَنَا مِسْعَرٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ مَعْقِلِ بْنِ أَبِی بَکْرٍ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ انْتُظِرَ بَعْدَ مَا أُقِیمَتِ الصَّلاَۃُ۔","Majhul","Musannaf Ibn Abi Shaybah 4197","","","كتاب الصلوات"
"4198","(۴۱۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، عَنْ أَنَسٍ ، قَالَ : أُقِیمَتِ الصَّلاَۃُ وَرَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَجِیٌّ لِرَجُلٍ فِی جَانِبِ الْمَسْجِدِ ، فَمَا قَامَ إلَی الصَّلاَۃِ حَتَّی نَامَ الْقَوْمُ۔ (بخاری ۶۴۲۔ مسلم ۲۸۴)","Sahih","Musannaf Ibn Abi Shaybah 4198","","","كتاب الصلوات"
"4199","(۴۱۹۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : إِنْ کَانَ عُمَرُ لَیُقَاوِمُ الرَّجُلَ بَعْدَ مَا تُقَامُ الصَّلاَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 4199","","","كتاب الصلوات"
"4200","(۴۲۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : أُقِیمَتِ الصَّلاَۃُ وَصُفَّتِ الصُّفُوفُ فَانْدَرَأَ رَجُلٌ لِعُمَرَ فَکَلَّمَہُ ، فَأَطَالاَ الْقِیَامَ حَتَّی أَلْقَیَا إلَی الأَرْضِ وَالْقَوْمُ صُفُوفٌ۔","","Musannaf Ibn Abi Shaybah 4200","","","كتاب الصلوات"
"4201","(۴۲۰۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، وَابْنِ سِیرِینَ ؛ أَنَّہُمَا کَانَا إذَا قَرَآ السَّجْدَۃَ سَلَّمَا۔","","Musannaf Ibn Abi Shaybah 4201","","","كتاب الصلوات"
"4202","(۴۲۰۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ کَانَ یُسَلِّمُ یَقُولُ : السَّلاَمُ عَلَیْکُمْ، إذَا قَرَأَ السَّجْدَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4202","","","كتاب الصلوات"
"4203","(۴۲۰۳) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنِ الْحَکَمِ، قَالَ: رَأَیْتُ أَبَا الأَحْوَص وَقَرَأَ السَّجْدَۃَ فَسَلَّمَ عَنْ یَمِینِہِ تَسْلِیمَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 4203","","","كتاب الصلوات"
"4204","(۴۲۰۴) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ إبْرَاہِیمُ ، وَأَبُو صَالِحٍ ، وَیَحْیَی بْنُ وَثَّابٍ لاَ یُسَلِّمُونَ فِی السَّجْدَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4204","","","كتاب الصلوات"
"4205","(۴۲۰۵) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ إذَا قَرَأَ السَّجْدَۃَ لَمْ یُسَلِّمْ فِیہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 4205","","","كتاب الصلوات"
"4206","(۴۲۰۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، قَالَ : کَانَ الْحَسَنُ یَقْرَأُ بِنَا سُجُودَ الْقُرْآنِ وَلاَ یُسَلِّمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4206","","","كتاب الصلوات"
"4207","(۴۲۰۷) حَدَّثَنَا عَبَّادٌ ، عَنْ وِقَائِ بْنِ إیَاسٍ الأَسَدِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یَقْرَأُ السَّجْدَۃَ ، فَیَرْفَعُ رَأْسَہُ ، وَلاَ یُسَلِّمُ۔","","Musannaf Ibn Abi Shaybah 4207","","","كتاب الصلوات"
"4208","(۴۲۰۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَأَبُو الأَشْہَبِ ، عَنِ الْحَسَنِ ، أَنَّہُمَا قَالاَ : إذَا قَرَأَ الرَّجُلُ السَّجْدَۃَ ، فَلْیُکَبِّرْ إذَا رَفَعَ رَأْسَہُ ، وَإِذَا سَجَدَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4208","","","كتاب الصلوات"
"4209","(۴۲۰۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، وَابْنِ سِیرِینَ ، أَنَّہُمَا قَالاَ : إذَا قَرَأَ الرَّجُلُ السَّجْدَۃَ فِی غَیْرِ صَلاَۃٍ قَالَ : اللَّہُ أَکْبَرُ۔","","Musannaf Ibn Abi Shaybah 4209","","","كتاب الصلوات"
"4210","(۴۲۱۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، قَالَ : کَانَ أَبِی إذَا قَرَأَ السَّجْدَۃَ ، قَالَ : اللَّہُ أَکْبَرُ ، ثُمَّ سَجَدَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4210","","","كتاب الصلوات"
"4211","(۴۲۱۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ کَانَ یَقْرَأُ السَّجْدَۃَ وَہُوَ یَمْشِی ، فَیُکَبِّرُ وَیُومِیئُ حَیْثُ کَانَ وَجْہُہُ ، وَیُکَبِّرُ إذَا رَفَعَ۔","","Musannaf Ibn Abi Shaybah 4211","","","كتاب الصلوات"
"4212","(۴۲۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : إذَا قَرَأْتَ السَّجْدَۃَ فَکَبِّرْ۔","No Data Available","Musannaf Ibn Abi Shaybah 4212","","","كتاب الصلوات"
"4213","(۴۲۱۳) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنْ أَبِی عَبْدِالرَّحْمَنِ السُّلَمِیِّ، قَالَ: کُنَّا نَقْرَأُ عَلَی أَبِی عَبْدِ الرَّحْمَنِ وَنَحْنُ نَمْشِی ، فَإِذَا مَرَّ بِالسَّجْدَۃِ کَبَّرَ وَأَوْمَأَ وَسَلَّمَ ، وَزَعَمَ أَنَّ ابْنَ مَسْعُودٍ کَانَ یَصْنَعُ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 4213","","","كتاب الصلوات"
"4214","(۴۲۱۴) حَدَّثَنَا شَرِیکٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّ أَصْحَابَ عَبْدِ اللہِ کَانُوا یَقْرَؤُونَ السَّجْدَۃَ وَہُمْ یَمْشُونَ ، فَیُومِئُونَ إیمَائً۔","No Data Available","Musannaf Ibn Abi Shaybah 4214","","","كتاب الصلوات"
"4215","(۴۲۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ؛ أَنَّہُ کَانَ یَقْرَؤُہَا وَہُوَ یَمْشِی ، فَیُومِیئُ إِیمَائً۔","","Musannaf Ibn Abi Shaybah 4215","","","كتاب الصلوات"
"4216","(۴۲۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ أَنَّہُ کَانَ یُومِیئُ۔","","Musannaf Ibn Abi Shaybah 4216","","","كتاب الصلوات"
"4217","(۴۲۱۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، قَالَ : سَأَلْتُ کُرْدُوسًا عَنِ السَّجْدَۃِ یَقْرَؤُہَا الرَّجُلُ وَہُوَ یَمْشِی؟ قَالَ : یُومِیئُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4217","","","كتاب الصلوات"
"4218","(۴۲۱۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ زِیَادٍ ، قَالَ : حدَّثَنِی عُمَارَۃُ بْنُ الْقَعْقَاعِ ، عَنْ أَبِی زُرْعَۃَ بْنِ عَمْرِو بْنِ جَرِیرٍ ؛ أَنَّہُ ذَکَرَ الإِیمَائَ ، وَذَکَرْتُ لَہُ : أَنَّ إبْرَاہِیمَ قَرَأَہَا فِی مَسِیرٍ لَہُ فَأَوْمَأَ۔","","Musannaf Ibn Abi Shaybah 4218","","","كتاب الصلوات"
"4219","(۴۲۱۹) حَدَّثَنَا عَبْدَۃُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : کُنْتُ أَعْرِضُ عَلَی أُبَیٍّ وَیَعْرِضُ عَلَیَّ فِی الطَّرِیقِ ، فَیَمُرُّ بِالسَّجْدَۃِ فَیَسْجُدُ ، فَقُلْتُ لَہُ : أَتَسْجُدُ فِی الطَّرِیقِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 4219","","","كتاب الصلوات"
"4220","(۴۲۲۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبِی جَعْفَرٍ الرَّازِیّ ، عَنِ الرَّبِیعِ بْنِ أَنَسٍ ، قَالَ : قُلْتُ لأَبِی الْعَالِیَۃِ : إنِّی آخُذ فِی سِکَّۃٍ ضَیِّقَۃٍ ، فَأَسْمَعُ الْقَارِیئَ یَقْرَأُ السَّجْدَۃَ ، فَأَسْجُدُ عَلَی الطَّرِیقِ ؟ قَالَ : نَعَمْ ، اُسْجُدْ عَلَی الطَّرِیقِ۔","Sahih","Musannaf Ibn Abi Shaybah 4220","","","كتاب الصلوات"
"4221","(۴۲۲۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّ ابْنَ مَسْعُودٍ کَانَ یَقْرَأُ وَہُوَ یَمْشِی ، فتَأْتِی السَّجْدَۃَ فَیَتَنَحَّی فَیَسْجُدُ۔","","Musannaf Ibn Abi Shaybah 4221","","","كتاب الصلوات"
"4222","(۴۲۲۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، قَالَ : إذَا قَرَأْتَ السَّجْدَۃَ وَأَنْتَ تَمْشِی ، فَضَعْ جَبْہَتَکَ عَیَح أَوَّلِ حَائِطٍ تَلْقَی۔","","Musannaf Ibn Abi Shaybah 4222","","","كتاب الصلوات"
"4223","(۴۲۲۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ (ح) وَأَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَقْرَأُ السَّجْدَۃَ ، ثُمَّ یُعِیدُ قِرَائَتَہَا ، قَالاَ : تُجْزِئُہُ السَّجْدَۃُ الأُولَی۔","No Data Available","Musannaf Ibn Abi Shaybah 4223","","","كتاب الصلوات"
"4224","(۴۲۲۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا قَرَأْتَ السَّجْدَۃَ أَجْزَأَک أَنْ تَسْجُدَ بِہَا مَرَّۃً۔","","Musannaf Ibn Abi Shaybah 4224","","","كتاب الصلوات"
"4225","(۴۲۲۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ کَانَ یَقْرَأُ السَّجْدَۃَ فَیَسْجُدُ ، ثُمَّ یُعِیدُہَا فِی مَجْلِسِہِ ذَلِکَ مِرَارًا ، لاَ یَسْجُدُ۔","","Musannaf Ibn Abi Shaybah 4225","","","كتاب الصلوات"
"4226","(۴۲۲۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : کَانُوا یَکْرَہُونَ اخْتِصَارَ السُّجُودِ۔","","Musannaf Ibn Abi Shaybah 4226","","","كتاب الصلوات"
"4227","(۴۲۲۷) حَدَّثَنَا ہُشَیْمٌ ، وَعَلِیُّ بْنُ مُسْہِرٍ ، وَابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانُوا یَکْرَہُونَ اخْتِصَارَ السُّجُودِ ، وَکَانُوا یَکْرَہُونَ إذَا أَتَوْا عَلَی السَّجْدَۃِ أَنْ یُجَاوِزُوہَا حَتَّی یَسْجُدُوا۔","No Data Available","Musannaf Ibn Abi Shaybah 4227","","","كتاب الصلوات"
"4228","(۴۲۲۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : ثَلاَثٌ مِمَّا أَحْدَثَ النَّاسُ : اخْتِصَارُ السُّجُودِ ، وَرَفْعُ الأَیْدِی فِی الدُّعَائِ ، قَالَ ہُشَیْمٌ : وَنَسِیتُ الثَّالِثَۃَ۔","","Musannaf Ibn Abi Shaybah 4228","","","كتاب الصلوات"
"4229","(۴۲۲۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ قُرَیْرٍ ، قَالَ : سَأَلْتُ ابْنَ سِیرِینَ عَنِ اخْتِصَارِ السُّجُودِ ؟ فَکَرِہَہُ وَعَبَسَ وَجْہُہُ ، وَقَالَ : لاَ أَدْرِی مَا ہَذَا۔","","Musannaf Ibn Abi Shaybah 4229","","","كتاب الصلوات"
"4230","(۴۲۳۰) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : ہُوَ مِمَّا أَحْدَثَ النَّاسُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4230","","","كتاب الصلوات"
"4231","(۴۲۳۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ تُخْتَصَرَ السَّجْدَۃُ۔","","Musannaf Ibn Abi Shaybah 4231","","","كتاب الصلوات"
"4232","(۴۲۳۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یُکْرَہُ أَنْ یُخْتَصَرَ سُجُودُ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 4232","","","كتاب الصلوات"
"4233","(۴۲۳۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنِ أَبِی الْمُعْتَمِرِ، عَنْ قَتَادَۃَ، عَنْ شَہْرِ بْنِ حَوْشَبٍ، قَالَ: ہُوَ مِمَّا أَحْدَثَ النَّاسُ۔","","Musannaf Ibn Abi Shaybah 4233","","","كتاب الصلوات"
"4234","(۴۲۳۴) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ مِسْعَرٍ ، عَنْ وَبَرَۃَ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ ، وَأَنَا مُقْبِلٌ مِنَ الْمَدِینَۃِ عَنِ الرَّجُلِ یَقْرَأُ السَّجْدَۃَ وَہُوَ عَلَی الدَّابَّۃِ ؟ قَالَ : یُومِیئُ۔","Sahih","Musannaf Ibn Abi Shaybah 4234","","","كتاب الصلوات"
"4235","(۴۲۳۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَقْرَأُ السَّجْدَۃَ وَہُوَ عَلَی دَابَّۃٍ ، قَالَ : یُومِیئُ بِرَأْسِہِ إیمَائً حَیْثُ کَانَ وَجْہُہُ۔","","Musannaf Ibn Abi Shaybah 4235","","","كتاب الصلوات"
"4236","(۴۲۳۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : کُنْتُ أَسِیرُ مَعَ أَبِی عُبَیْدَۃَ بَیْنَ الْکُوفَۃِ وَالْحِیرَۃِ ، فَقَرَأَ السَّجْدَۃَ ، فَذَہَبْت أَنْزِلُ لأَسْجُدَ ، فَقَالَ : یُجْزِیک أَنْ تُومِیئَ بِرَأْسِکَ ، قَالَ : وَأَوْمَأَ بِرَأْسِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4236","","","كتاب الصلوات"
"4237","(۴۲۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ ثُوَیْرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یَقْرَأُ السَّجْدَۃَ وَہُوَ عَلَی رَاحِلَتِہِ فَیُومِیئُ۔","Da'if","Musannaf Ibn Abi Shaybah 4237","","","كتاب الصلوات"
"4238","(۴۲۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ سَعِیدِ بْنِ زَیْدٍ ، قَالَ : کَانَ یَقْرَأُ السَّجْدَۃَ عَلَی رَاحِلَتِہِ فَیُومِیئُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4238","","","كتاب الصلوات"
"4239","(۴۲۳۹) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ ثُوَیْرٍ، قَالَ: رَأَیْتُ ابْنَ الزُّبَیْرِ یَقْرَأُ السَّجْدَۃَ وَہُوَ عَلَی رَاحِلَتِہِ، فَیُومِیئُ۔","Da'if","Musannaf Ibn Abi Shaybah 4239","","","كتاب الصلوات"
"4240","(۴۲۴۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَقْرَأُ السَّجْدَۃَ وَہُوَ عَلَی دَابَّتِہِ ، قَالَ: یُومِیئُ۔","","Musannaf Ibn Abi Shaybah 4240","","","كتاب الصلوات"
"4241","(۴۲۴۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ شِبَاکٍ ، عَنْ إِبْرَاہِیمَ ؛ قَالَ : إِذَا قَرَأَ السَّجْدَۃَ وَہُوَ عَلَی دَابَّتِہِ أَوْمَأَ بِرَأْسِہِ إِیمَائً۔","","Musannaf Ibn Abi Shaybah 4241","","","كتاب الصلوات"
"4242","(۴۲۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حَدَّثَنَا مِسْعَرٌ ، قَالَ : حدَّثَنَا حَمَّادٌ ؛ أَنَّ إبْرَاہِیمَ سَأَلَ عَلْقَمَۃَ : أَیَنْزِلُ عَنْ دَابَّتِہِ لِلسَّجْدَۃِ ؟ فَأَمَرَہُ أَنْ لاَ یَنْزِلَ۔","","Musannaf Ibn Abi Shaybah 4242","","","كتاب الصلوات"
"4243","(۴۲۴۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إنَّمَا السَّجْدَۃُ عَلَی مَنْ جَلَسَ لَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 4243","","","كتاب الصلوات"
"4244","(۴۲۴۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : قَالَ عُمَرُ : إنَّمَا السَّجْدَۃُ فِی الْمَسْجِدِ ، وَعِنْدَ الذِّکْرِ۔","","Musannaf Ibn Abi Shaybah 4244","","","كتاب الصلوات"
"4245","(۴۲۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعَوَّامِ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إنَّمَا السَّجْدَۃُ عَلَی مَنْ جَلَسَ لَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 4245","","","كتاب الصلوات"
"4246","(۴۲۴۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ، قَالَ : إنَّمَا السُّجُودُ عَلَی مَنْ جَلَسَ لَہُ ، وَأَنْصَتَ۔","","Musannaf Ibn Abi Shaybah 4246","","","كتاب الصلوات"
"4247","(۴۲۴۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عُثْمَانَ ، قَالَ : إنَّمَا السَّجْدَۃُ عَلَی مَنْ جَلَسَ لَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 4247","","","كتاب الصلوات"
"4248","(۴۲۴۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ قَاصًّا کَانَ یَجْلِسُ قَرِیبًا مِنْ مَجْلِسِہِ ، فَیَقْرَأُ السَّجْدَۃَ ، فَلاَ یَسْجُدُ سَعِیدٌ وَقَدْ سَمِعَہَا ، قَالَ : فَقِیلَ لَہُ : فَمَا یَمْنَعُک مِنَ السُّجُودِ ؟ قَالَ : لَیْسَ إلَیْہِ جَلَسْتُ۔","","Musannaf Ibn Abi Shaybah 4248","","","كتاب الصلوات"
"4249","(۴۲۴۹) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، وَنَافِعٍ ، وَسَعِید بْنِ جُبَیْرٍ ، قَالُوا : مَنْ سَمِعَ السَّجْدَۃَ ، فَعَلَیْہِ أَنْ یَسْجُدَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4249","","","كتاب الصلوات"
"4250","(۴۲۵۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : دَخَلَ سَلْمَانُ الْفَارِسِیُّ الْمَسْجِدَ وَفِیہِ قَوْمٌ یَقْرَؤُونَ ، فَقَرَؤُوا السَّجْدَۃَ فَسَجَدُوا ، فَقَالَ لَہُ صَاحِبُہُ : یَا أَبَا عَبْدِ اللہِ ، لَوْلاَ أَتَیْنَا ہَؤُلاَئِ الْقَوْمَ ، فَقَالَ : مَا لِہَذَا غَدَوْنَا۔","Da'if","Musannaf Ibn Abi Shaybah 4250","","","كتاب الصلوات"
"4251","(۴۲۵۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ مُطَرِّفٍ ، قَالَ : سَأَلْتُہُ عَنِ الرَّجُلِ یَتَمَارَی فِی السَّجْدَۃِ ، أَسَمِعَہَا أَمْ لَمْ یَسْمَعْہَا ؟ قَالَ : وَسَمِعَہَا ، فَمَاذَا ؟ ثُمَّ قَالَ مُطَرِّفٌ : سَأَلْتُ عِمْرَانَ بْنَ حُصَیْنٍ عَنْ الرَّجُلِ لاَ یَدْرِی أَسَمِعَ السَّجْدَۃَ ، أَمْ لاَ ؟ قَالَ : وَسَمِعَہَا ، فَمَاذَا ؟۔","Sahih","Musannaf Ibn Abi Shaybah 4251","","","كتاب الصلوات"
"4252","(۴۲۵۲) حَدَّثَنَا وَکِیعٌ ، وَمُحَمَّدُ بْنُ بِشْرٍ ، عَنْ مِسْعَرٍ ، عَنْ عَطِیَّۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إنَّمَا السَّجْدَۃُ عَلَی مَنْ سَمِعَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 4252","","","كتاب الصلوات"
"4253","(۴۲۵۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، وَالْحَسَنِ ، قَالاَ : قَالَ عُمَرُ : لَیْسَ فِی الْمُفَصَّلِ سُجُودٌ۔","Hasan","Musannaf Ibn Abi Shaybah 4253","","","كتاب الصلوات"
"4254","(۴۲۵۴) حَدَّثَنَا ہُشَیْمٌ، أَخْبَرَنَا خَالِدٌ، عَنِ أَبِی الْعُرْیَان الْمُجَاشِعِیِّ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لَیْسَ فِی الْمُفَصَّلِ سُجُود۔","Sahih","Musannaf Ibn Abi Shaybah 4254","","","كتاب الصلوات"
"4255","(۴۲۵۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَسَنِ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ یَقُولُ : لَیْسَ فِی الْمُفَصَّلِ سُجُود۔","Sahih","Musannaf Ibn Abi Shaybah 4255","","","كتاب الصلوات"
"4256","(۴۲۵۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لَیْسَ فِی الْمُفَصَّلِ سُجُود۔","","Musannaf Ibn Abi Shaybah 4256","","","كتاب الصلوات"
"4257","(۴۲۵۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنِ الْحَسَنِ ، کَانَ یَقُولُ : لَیْسَ فِی الْعَرَبِیِّ سُجُودٌ ، یَعْنِی الْمُفَصَّلَ۔","","Musannaf Ibn Abi Shaybah 4257","","","كتاب الصلوات"
"4258","(۴۲۵۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، وَعِکْرِمَۃَ ، وَالْحَسَنِ ، قَالُوا : لَیْسَ فِی الْمُفَصَّلِ سُجُودٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 4258","","","كتاب الصلوات"
"4259","(۴۲۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَیْمَنِ بْنِ نَابِلٍ ، قَالَ : سَمِعْتُ طَاوُوسًا یَقُولُ : لَیْسَ فِی الْمُفَصَّلِ سُجُودُ۔","","Musannaf Ibn Abi Shaybah 4259","","","كتاب الصلوات"
"4260","(۴۲۶۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْطٍ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : قرَأْتُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ النَّجْمَ ، فَلَمْ یَسْجُدْ۔ (بخاری ۱۰۷۳۔ ابوداؤد ۱۳۹۹)","Sahih","Musannaf Ibn Abi Shaybah 4260","","","كتاب الصلوات"
"4261","(۴۲۶۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَطَائِ بْنِ یَسَارٍ ، قَالَ : سَأَلْتُ أُبَیَّ بْنَ کَعْبٍ : فِی الْمُفَصَّلِ سُجُودٌ ؟ قَالَ : لاَ۔","Sahih","Musannaf Ibn Abi Shaybah 4261","","","كتاب الصلوات"
"4262","(۴۲۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لَیْسَ فِی الْمُفَصَّلِ سُجُودٌ۔","","Musannaf Ibn Abi Shaybah 4262","","","كتاب الصلوات"
"4263","(۴۲۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَطَائِ بْنِ یَسَارٍ ، عَنْ أُبَیِّ بْنِ کَعْبٍ ، قَالَ : لَیْسَ فِی الْمُفَصَّلِ سُجُودٌ۔","Sahih","Musannaf Ibn Abi Shaybah 4263","","","كتاب الصلوات"
"4264","(۴۲۶۴) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ بْنِ مُوسَی ، عَنْ عَطَائِ بْنِ مِینَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : سَجَدْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی {إذَا السَّمَائُ انْشَقَّتْ} ، وَ {اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ}۔ (مسلم ۱۰۸۔ احمد ۲/۴۶۱)","Sahih","Musannaf Ibn Abi Shaybah 4264","","","كتاب الصلوات"
"4265","(۴۲۶۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ حَزْمٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَجَدَ فِی : {إذَا السَّمَائُ انْشَقَّتْ} ۔(ابن ماجہ ۱۰۵۹۔ احمد ۲/۲۴۷)","Sahih","Musannaf Ibn Abi Shaybah 4265","","","كتاب الصلوات"
"4266","(۴۲۶۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَلِیُّ بْنُ زَیْدِ بْنِ جُدْعَانَ ، عَنْ أَبِی رَافِعٍ ، قَالَ : صَلَّیْتُ خَلْفَ أَبِی ہُرَیْرَۃَ بِالْمَدِینَۃِ الْعِشَائَ الآخِرَۃَ ، قَالَ : فَقَرَأَ فِیہَا {إذَا السَّمَائُ انْشَقَّتْ} فَسَجَدَ فِیہَا ، فَقُلْتُ لَہُ : تَسْجُدُ فِیہَا ؟ فَقَالَ: رَأَیْت خَلِیلِی أَبَا الْقَاسِمِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَجَدَ فِیہَا ، فَلاَ أَدَعُ ذَلِکَ۔ (طحاوی ۳۵۷)","Da'if","Musannaf Ibn Abi Shaybah 4266","","","كتاب الصلوات"
"4267","(۴۲۶۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، عَنْ عَبْدِ اللہِ ، قَالَ : سَجَدَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی النَّجْمِ ، فَمَا بَقِیَ أَحَدٌ إِلاَّ سَجَدَ مَعَہُ ، إِلاَّ شَیْخًا أَخَذَ کَفًّا مِنْ تُرَابٍ ، فَرَفَعَہُ إلَی جَبْہَتِہِ ، قَالَ : فَلَقَدْ رَأَیْتُہُ قُتِلَ کَافِرًا۔ (بخاری ۳۹۷۲۔ ابوداؤد ۱۴۰۱)","Sahih","Musannaf Ibn Abi Shaybah 4267","","","كتاب الصلوات"
"4268","(۴۲۶۸) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ عَلِیِّ بْنِ سُوَیْد بْنِ مَنْجُوفٍ ، قَالَ : حَدَّثَنَا أَبُو رَافِعٍ الصَّائِغُ ، قَالَ : صَلَّی بِنَا عُمَرُ صَلاَۃَ الْعِشَائِ الآخِرَۃِ ، فَقَرَأَ فِی إحْدَی الرَّکْعَتَیْنِ الأُولَیَیْنِ: {إذَا السَّمَائُ انْشَقَّتْ} فَسَجَدَ ، وَسَجَدْنَا مَعَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4268","","","كتاب الصلوات"
"4269","(۴۲۶۹) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : رَأَیْتُ عُمَرَ ، وَعَبْدَ اللہِ یَسْجُدَانِ فِی {إذَا السَّمَائُ انْشَقَّتْ} ، أَوْ أَحَدَہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 4269","","","كتاب الصلوات"
"4270","(۴۲۷۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْمَسْعُودِیِّ ، عَنِ ابْنِ الأَصْبَہَانِیِّ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ، عَنِ ابْنِ مَسْعُودٍ؛ أَنَّہُ کَانَ یَسْجُدُ فِی {إذَا السَّمَائُ انْشَقَّتْ}۔","Da'if","Musannaf Ibn Abi Shaybah 4270","","","كتاب الصلوات"
"4271","(۴۲۷۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ دَاوُدَ ، عَنْ أَبِی الْعَالِیَۃِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَجَدَ فِی النَّجْمِ ، وَالْمُسْلِمُونَ۔","","Musannaf Ibn Abi Shaybah 4271","","","كتاب الصلوات"
"4272","(۴۲۷۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ بْنِ مَسْعُودٍ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی الأَعْرَافِ ، وَبَنِی إسْرَائِیلَ ، وَالنَّجْمِ وَ : {اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ}۔","","Musannaf Ibn Abi Shaybah 4272","","","كتاب الصلوات"
"4273","(۴۲۷۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ سَجَدَ فِی النَّجْمِ وَ{اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ}۔","","Musannaf Ibn Abi Shaybah 4273","","","كتاب الصلوات"
"4274","(۴۲۷۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ شُعْبَۃَ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، قَالَ : عَزَائِمُ السُّجُودِ ؛ (الم تَنْزِیلُ) وَ(حم تَنْزِیلُ) وَ(النَّجْمُ) وَ{اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ}۔","","Musannaf Ibn Abi Shaybah 4274","","","كتاب الصلوات"
"4275","(۴۲۷۵) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ (وَالنَّجْمِ) فَسَجَدَ فِیہَا الْمُسْلِمُونَ ، وَالْمُشْرِکُونَ ، وَالْجِنُّ ، وَالإِنْسُ۔","","Musannaf Ibn Abi Shaybah 4275","","","كتاب الصلوات"
"4276","(۴۲۷۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَاصِمٍ ، عَنْ قَسَامَۃَ بْنِ زُہَیْرٍ ، قَالَ : کَانَ یَسْجُدُ فِی النَّجْمِ ، وَ {إذَا السَّمَائُ انْشَقَّتْ}۔","No Data Available","Musannaf Ibn Abi Shaybah 4276","","","كتاب الصلوات"
"4277","(۴۲۷۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، عَنْ سُلَیْمَانَ بْنِ حَبِیبٍ ، قَالَ : سَجَدْت مَعَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فِی {إذَا السَّمَائُ انْشَقَّتْ}۔","","Musannaf Ibn Abi Shaybah 4277","","","كتاب الصلوات"
"4278","(۴۲۷۸) حَدَّثَنَا حَفْصٌ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ یَسْجُدُ فِی {إذَا السَّمَائُ انْشَقَّتْ}۔","","Musannaf Ibn Abi Shaybah 4278","","","كتاب الصلوات"
"4279","(۴۲۷۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ یَسْجُدُ فِی النَّجْمِ ، وَفِی {اقْرَأْ بِاسْمِ رَبِّک} إِلاَّ أَنْ یَقْرَأَ بِہِمَا فِی صَلاَۃٍ مَکْتُوبَۃٍ ، فَإِنَّہُ کَانَ لاَ یَسْجُدُ بِہِمَا وَیَرْکَعُ۔","Sahih","Musannaf Ibn Abi Shaybah 4279","","","كتاب الصلوات"
"4280","(۴۲۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قَرَأَ مُحَمَّدٌ : {إذَا السَّمَائُ انْشَقَّتْ} وَأَنَا جَالِسٌ فَسَجَدَ فِیہَا۔","","Musannaf Ibn Abi Shaybah 4280","","","كتاب الصلوات"
"4281","(۴۲۸۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، قَالَ : قَرَأَ عَمَّارٌ عَلَی الْمِنْبَرِ : {إذَا السَّمَائُ انْشَقَّتْ} ، ثُمَّ نَزَلَ إلَی الْقَرَارِ ، فَسَجَدَ بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 4281","","","كتاب الصلوات"
"4282","(۴۲۸۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ مَسْرُوقِ بْنِ الأَجْدَعِ ؛ أَنَّ عُثْمَانَ قَرَأَ فِی الْعِشَائِ بِالنَّجْمِ ، فَسَجَدَ۔","Da'if","Musannaf Ibn Abi Shaybah 4282","","","كتاب الصلوات"
"4283","(۴۲۸۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی سَلَمَۃَ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: سَجَدَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالْمُسْلِمُونَ فِی (النَّجْمِ) إِلاَّ رَجُلَیْنِ مِنْ قُرَیْشٍ أَرَادَا بِذَلِکَ الشُّہْرَۃَ۔ (احمد ۲/۳۰۴)","Hasan","Musannaf Ibn Abi Shaybah 4283","","","كتاب الصلوات"
"4284","(۴۲۸۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : رَأَیْتُ عَبْدَ اللہِ یَسْجُدُ فِی {إذَا السَّمَائُ انْشَقَّتْ}۔","Sahih","Musannaf Ibn Abi Shaybah 4284","","","كتاب الصلوات"
"4285","(۴۲۸۵) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، سَمِعَ ابْنَ عَبَّاسٍ یَقُولُ : فِی (ص) سَجْدَۃٌ ، وَتَلاَ: (أُولَئِکَ الَّذِینَ ہَدَی اللَّہُ فَبِہُدَاہُمُ اقْتَدِہِ)۔","Sahih","Musannaf Ibn Abi Shaybah 4285","","","كتاب الصلوات"
"4286","(۴۲۸۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَبْدَۃَ ، وَصَدَقَۃَ ، سَمِعَا ابْنَ عُمَرَ یَقُولُ : فِی (ص) سَجْدَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 4286","","","كتاب الصلوات"
"4287","(۴۲۸۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : کُنْتُ لاَ أَسْجُدُ فِی (ص) حَتَّی حَدَّثَنِی السَّائِبُ أَنَّ عُثْمَانَ سَجَدَ فِیہَا۔","Sahih","Musannaf Ibn Abi Shaybah 4287","","","كتاب الصلوات"
"4288","(۴۲۸۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّ عُمَرَ کَانَ یسْجُدُ فِی (ص)۔","","Musannaf Ibn Abi Shaybah 4288","","","كتاب الصلوات"
"4289","(۴۲۸۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، وَالْعَوَّامُ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی (ص) وَتَلاَ ہَذِہِ الآیَۃَ : {أُولَئِکَ الَّذِینَ ہَدَی اللَّہُ فَبِہُدَاہُمُ اقْتَدِہِ}۔ (بخاری ۳۴۲۲۔ ابوداؤد ۱۴۰۴)","Sahih","Musannaf Ibn Abi Shaybah 4289","","","كتاب الصلوات"
"4290","(۴۲۹۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْجُدُ فِی (ص)۔","Da'if","Musannaf Ibn Abi Shaybah 4290","","","كتاب الصلوات"
"4291","(۴۲۹۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ سُورَۃَ (ص) وَہُوَ عَلَی الْمِنْبَرِ ، فَلَمَّا أَتَی عَلَی السَّجْدَۃِ قَرَأَہَا ، ثُمَّ نَزَلَ فَسَجَدَ۔","","Musannaf Ibn Abi Shaybah 4291","","","كتاب الصلوات"
"4292","(۴۲۹۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : ہِیَ مُوجَبَۃٌ، سَجْدَۃُ (ص)۔","Sahih","Musannaf Ibn Abi Shaybah 4292","","","كتاب الصلوات"
"4293","(۴۲۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، قَالَ : ذُکِرت عِنْدَ ابْنِ عَبَّاسٍ ، فَقَالَ : {أُولَئِکَ الَّذِینَ ہَدَی اللَّہُ فَبِہُدَاہُمُ اقْتَدِہِ}۔","Sahih","Musannaf Ibn Abi Shaybah 4293","","","كتاب الصلوات"
"4294","(۴۲۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : کَانَ طَاوُوس یَسْجُدُ فِی (ص)۔","","Musannaf Ibn Abi Shaybah 4294","","","كتاب الصلوات"
"4295","(۴۲۹۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، قَالَ : شَہِدْتُ الْحَسَنَ وَقَرَأَ السَّجْدَۃَ الَّتِی فِی (ص) فَسَجَدَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4295","","","كتاب الصلوات"
"4296","(۴۲۹۶) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی (ص)۔","No Data Available","Musannaf Ibn Abi Shaybah 4296","","","كتاب الصلوات"
"4297","(۴۲۹۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ بْنِ عَمْرو ، عَنْ زَائِدَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : کَانَ أَبُو عَبْدِ الرَّحْمَنِ یَسْجُدُ فِی (ص)۔","","Musannaf Ibn Abi Shaybah 4297","","","كتاب الصلوات"
"4298","(۴۲۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ مُصْعَبِ بْنِ شَیْبَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : رَأَیْتُ الضَّحَّاکَ بْنَ قَیْسٍ یَسْجُدُ فِی (ص) ، قَالَ : فَذَکَرْتُہُ لابْنِ عَبَّاسٍ ، فَقَالَ : إِنَّہُ رَأَی عُمَرَ بْنَ الْخَطَّابِ یَسْجُدُ فِیہَا۔","Hasan","Musannaf Ibn Abi Shaybah 4298","","","كتاب الصلوات"
"4299","(۴۲۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ قَالَ : فِیہَا سَجْدَۃٌ ، ثُمَّ قَرَأَ : {أُولَئِکَ الَّذِینَ ہَدَی اللَّہُ فَبِہُدَاہُمُ اقْتَدِہِ}۔","Sahih","Musannaf Ibn Abi Shaybah 4299","","","كتاب الصلوات"
"4300","(۴۳۰۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ لاَ یَسْجُدُ فِی (ص) وَیَقُولُ : تَوْبَۃُ نَبِیٍّ۔","Da'if","Musannaf Ibn Abi Shaybah 4300","","","كتاب الصلوات"
"4301","(۴۳۰۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، قَالَ : ذُکِرَتْ (ص) عِنْدَ عَبْدِ اللہِ ، فَقَالَ: تَوْبَۃُ نَبِیٍّ۔","Sahih","Musannaf Ibn Abi Shaybah 4301","","","كتاب الصلوات"
"4302","(۴۳۰۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ (ح) وَأَخْبَرَنَا دَاوُد ، عَنِ الشَّعْبِیِّ ، قَالاَ : کَانَ عَبْدُ اللہِ لاَ یَسْجُدُ فِی (ص) وَیَقُولُ : تَوْبَۃُ نَبِیٍّ۔","","Musannaf Ibn Abi Shaybah 4302","","","كتاب الصلوات"
"4303","(۴۳۰۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی مَعَنْ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : کَانَ بَعْضُ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْجُدُ فِی (ص) ، وَبَعْضُہُمْ لاَ یَسْجُدُ ، فَأَیَّ ذَلِکَ شِئْتَ فَافْعَلْ۔","Majhul","Musannaf Ibn Abi Shaybah 4303","","","كتاب الصلوات"
"4304","(۴۳۰۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدِ ، عَنْ ثَابِتِ بْنِ قَیْسٍ ، قَالَ : کَانَ أَبُو الْمَلِیحِ لاَ یَسْجُدُ فِی (ص)۔","","Musannaf Ibn Abi Shaybah 4304","","","كتاب الصلوات"
"4305","(۴۳۰۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : سَمِعْتُہُ یُحَدِّثُ عَنِ الضَّحَّاکِ بْنِ قَیْسٍ ؛ أَنَّہُ خَطَبَ فَقَرَأَ : (ص) فَسَجَدَ فِیہَا ، وَعَلْقَمَۃُ وَأَصْحَابُ عَبْدِ اللہِ وَرَائَہُ ، فَلَمْ یَسْجُدُوا۔","No Data Available","Musannaf Ibn Abi Shaybah 4305","","","كتاب الصلوات"
"4306","(۴۳۰۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ؛ أَنَّ أَصْحَابَ عَبْدِ اللہِ کَانُوا لاَ یَسْجُدُونَ فِی (ص)۔","","Musannaf Ibn Abi Shaybah 4306","","","كتاب الصلوات"
"4307","(۴۳۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی آخِرِ الآَیَتَیْنِ مِنْ (حم) السَّجْدَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 4307","","","كتاب الصلوات"
"4308","(۴۳۰۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ أَبِی وَائِلٍ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی الآخِرَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4308","","","كتاب الصلوات"
"4309","(۴۳۰۹) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی الآخِرَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4309","","","كتاب الصلوات"
